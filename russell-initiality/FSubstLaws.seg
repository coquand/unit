-- Reindexing equations used to recover the types of equation endpoints.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ;

sub-p-sec {G A a : FA} (w : W G) (hA : Ty G A) (ha : Tm' G a A) :
    TE G (ftsb G (fext G A) (ftsb (fext G A) G A (fp G A)) (fsec G A a)) A =
  ty-trans (sb-comp-ty hA p s)
    (ty-trans (sb-same-ty hA (comp-sub p s) (id-sub w) (fq-p-sec G A a hA ha)) (fe-sb-id G A hA))
 where {
  p : Sb (fext G A) (fp G A) G = p-sub hA ;
  s : Sb G (fsec G A a) (fext G A) = sec-sub hA ha ;
 } ;

sub-p-lift {D G A s : FA} (hA : Ty G A) (hs : Sb D s G) :
    TE (fext D (ftsb D G A s))
      (ftsb (fext D (ftsb D G A s)) (fext G A) (ftsb (fext G A) G A (fp G A)) (flift D G A s))
      (ftsb (fext D (ftsb D G A s)) D (ftsb D G A s) (fp D (ftsb D G A s))) =
  ty-trans (sb-comp-ty hA p t)
    (ty-trans (sb-same-ty hA (comp-sub p t) (comp-sub hs p') (fq-p-lift D G A s hA hs))
      (ty-sym (sb-comp-ty hA hs p')))
 where {
  p : Sb (fext G A) (fp G A) G = p-sub hA ;
  p' : Sb (fext D (ftsb D G A s)) (fp D (ftsb D G A s)) D = p-sub (ty-sub hA hs) ;
  t : Sb (fext D (ftsb D G A s)) (flift D G A s) (fext G A) = lift-sub hA hs ;
 } ;

sub-id-from {D G A s d : FA} (w : W D) (hA : Ty D A) (hs : Sb G s D) (hd : Sb D d G)
    (e : SE D (fcomp D G D s d) (fid D) D) :
    TE D (ftsb D G (ftsb G D A s) d) A =
  ty-trans (sb-comp-ty hA hs hd)
    (ty-trans (sb-same-ty hA (comp-sub hs hd) (id-sub w) e) (fe-sb-id D A hA)) ;

sub-sec-comp {D G A B a s : FA} (hA : Ty G A) (hB : Ty (fext G A) B) (ha : Tm' G a A) (hs : Sb D s G) :
    TE D (ftsb D G (ftsb G (fext G A) B (fsec G A a)) s)
      (ftsb D (fext D (ftsb D G A s)) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fsec D (ftsb D G A s) (fmsb D G A a s))) =
  ty-trans (sb-comp-ty hB (sec-sub hA ha) hs)
    (ty-trans (sb-same-ty hB (comp-sub (sec-sub hA ha) hs) (comp-sub t u) (fq-sec-comp D G A a s hA ha hs))
      (ty-sym (sb-comp-ty hB t u)))
 where {
  t : Sb (fext D (ftsb D G A s)) (flift D G A s) (fext G A) = lift-sub hA hs ;
  u : Sb D (fsec D (ftsb D G A s) (fmsb D G A a s)) (fext D (ftsb D G A s)) =
    sec-sub (ty-sub hA hs) (tm-sub hA ha hs) ;
 } ;

sub-universe {D G a s : FA} (n : Nat) (hU : Ty G (fuu n G)) (ha : Tm' G a (fuu n G))
    (hs : Sb D s G) : Tm' D (fmsb D G (fuu n G) a s) (fuu n D) =
  tm-conv (tm-sub hU ha hs) (fe-uu-sb D G n s hs (f-universe-bound G G n hU)) ;

move-universe {G H a : FA} (n : Nat) (wH : W H) (e : CE G H) (nb : LeN n N)
    (h : Tm' G a (fuu n G)) : Tm' H a (fuu n H) =
  tm-conv (tm-cx wH e h) (te-cx wH e (fe-uu-cx G H n e nb)) ;

-- Compare two actions after moving their source and target coordinates.
sub-frame-eq {D E G H A B s t : FA} (wD : W D) (wH : W H) (d : CE D E) (g : CE G H)
    (hA : Ty G A) (hB : Ty G B) (eA : TE G A B) (hs : Sb D s G) (ht : Sb D t G) (e : SE D s t G) :
    TE D (ftsb D G A s) (ftsb E H B t) =
  ty-trans (sb-ty-cong hA eA hs ht e)
    (ty-trans {D} {ftsb D G B t} {ftsb D H B t} {ftsb E H B t} (fe-sb-target D G B t hB ht H g)
      (fe-sb-source D H B t (ty-cx wH g hB) (sub-cx wD wH (cx-refl wD) g ht) E d)) ;
