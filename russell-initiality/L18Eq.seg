-- L18Eq.seg: Lemma 18, the equality rules: the relational statement
-- QT / QM (related environments give equal values).
--   c-eqty-*, c-eqtm-*  one lemma per rule; beta and eta use ty-sec, rel-sec

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18Bind[l] ; open L18Pi[l] ;
open L18App[l] ; open L18U[l] ;

------------------------------------------------------------------------
-- types

c-eqty-refl (G : Cx) (A : Tm) (r : L18J (jty G A)) : L18J (jeqty G A A) = (r.1, r.2.2.2.1) ;

c-eqty-sym (G : Cx) (A B : Tm) (r : L18J (jeqty G A B)) : L18J (jeqty G B A) =
  (r.1, \ D e1 e2 wD rl -> ge-sym D (ev A e2) (ev B e1) (r.2 D e2 e1 wD (rel-sym D wD G (cs-ci G r.1) e1 e2 rl))) ;

c-eqty-trans (G : Cx) (A B C : Tm) (r1 : L18J (jeqty G A B)) (r2 : L18J (jeqty G B C)) : L18J (jeqty G A C) =
  (r1.1, \ D e1 e2 wD rl -> ge-trans D (ev A e1) (ev B e1) (ev C e2) (r1.2 D e1 e1 wD (rel-refl D G e1 rl.1)) (r2.2 D e1 e2 wD rl)) ;


c-eqty-pi (G : Cx) (A A' B B' : Tm) (r0 : L18J (jty G A)) (r1 : L18J (jeqty G A A')) (r2 : L18J (jeqty (csnoc G A) B B')) :
    L18J (jeqty G (pi A B) (pi A' B')) =
  (r0.1, \ D e1 e2 wD rl ->
     ge-pi D (ev A e1) (ev A' e2) (ev B (up e1)) (ev B' (up e2)) (r0.2.1 D e1 wD rl.1) (r1.2 D e1 e2 wD rl)
       (r2.2 (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (r0.2.1 D e1 wD rl.1)) (rel-up D wD G A (cs-ci (csnoc G A) r2.1) e1 e2 rl))) ;

c-eqty-el (G : Cx) (n : Nat) (a a' : Tm) (r : L18J (jeqtm G a a' (uu n))) : L18J (jeqty G (el n a) (el n a')) =
  (r.1, \ D e1 e2 wD rl -> ge-el D n (ev a e1) (ev a' e2) (r.2 D e1 e2 wD rl)) ;

c-eqty-el-lf (G : Cx) (m n : Nat) (a : Tm) (le : LeN (suc m) n) (nb : LeN n N) (r : L18J (jtm G a (uu m))) : L18J (jeqty G (el n (lf m n a)) (el m a)) =
  (r.1, \ D e1 e2 wD rl ->
     ge-trans D (gel n (glf m n (ev a e1))) (gel m (ev a e1)) (gel m (ev a e2))
       (ge-el-lf D m n (ev a e1) (r.2.1 D e1 wD rl.1) le nb) (ge-el D m (ev a e1) (ev a e2) (r.2.2.2.1 D e1 e2 wD rl))) ;


c-eqty-el-pic (G : Cx) (n : Nat) (a b : Tm) (r1 : L18J (jtm G a (uu n))) (r2 : L18J (jtm (csnoc G (el n a)) b (uu n))) :
    L18J (jeqty G (el n (pic n a b)) (pi (el n a) (el n b))) =
  (r1.1, \ D e1 e2 wD rl ->
     ge-trans D (gel n (gpic n (ev a e1) (ev b (up e1)))) (gpi (gel n (ev a e1)) (gel n (ev b (up e1)))) (gpi (gel n (ev a e2)) (gel n (ev b (up e2))))
       (ge-el-pic D n (ev a e1) (ev b (up e1)) (r1.2.1 D e1 wD rl.1)
          (r2.2.1 (gext D (gel n (ev a e1))) (up e1) (g-ext D (gel n (ev a e1)) (gt-el D n (ev a e1) (r1.2.1 D e1 wD rl.1))) (env-up D e1 wD G (el n a) (cs-ci (csnoc G (el n a)) r2.1) rl.1)))
       (ge-pi D (gel n (ev a e1)) (gel n (ev a e2)) (gel n (ev b (up e1))) (gel n (ev b (up e2))) (gt-el D n (ev a e1) (r1.2.1 D e1 wD rl.1))
          (ge-el D n (ev a e1) (ev a e2) (r1.2.2.2.1 D e1 e2 wD rl))
          (ge-el (gext D (gel n (ev a e1))) n (ev b (up e1)) (ev b (up e2))
             (r2.2.2.2.1 (gext D (gel n (ev a e1))) (up e1) (up e2) (g-ext D (gel n (ev a e1)) (gt-el D n (ev a e1) (r1.2.1 D e1 wD rl.1))) (rel-up D wD G (el n a) (cs-ci (csnoc G (el n a)) r2.1) e1 e2 rl))))) ;

c-eqty-el-uc (G : Cx) (m n : Nat) (lt : LeN (suc m) n) (nb : LeN n N) (r : L18J (jwf G)) : L18J (jeqty G (el n (uc m n)) (uu m)) =
  (r, \ D e1 e2 wD rl -> ge-el-uc D m n wD lt nb) ;

------------------------------------------------------------------------
-- terms

c-eqtm-refl (G : Cx) (a A : Tm) (r : L18J (jtm G a A)) : L18J (jeqtm G a a A) = (r.1, r.2.2.2.1) ;

c-eqtm-sym (G : Cx) (a b A : Tm) (rA : L18J (jty G A)) (r : L18J (jeqtm G a b A)) : L18J (jeqtm G b a A) =
  (r.1, \ D e1 e2 wD rl ->
     gm-eqconv D (ev b e1) (ev a e2) (ev A e2) (ev A e1)
       (gm-sym D (ev a e2) (ev b e1) (ev A e2) (rA.2.1 D e2 wD rl.2.1)
          (r.2 D e2 e1 wD (rel-sym D wD G (cs-ci G r.1) e1 e2 rl)))
       (ge-sym D (ev A e1) (ev A e2) (rA.2.2.2.1 D e1 e2 wD rl))) ;

c-eqtm-trans (G : Cx) (a b c A : Tm) (r1 : L18J (jeqtm G a b A)) (r2 : L18J (jeqtm G b c A)) : L18J (jeqtm G a c A) =
  (r1.1, \ D e1 e2 wD rl ->
     gm-trans D (ev a e1) (ev b e1) (ev c e2) (ev A e1) (r1.2 D e1 e1 wD (rel-refl D G e1 rl.1)) (r2.2 D e1 e2 wD rl)) ;

c-eqtm-conv (G : Cx) (a b A B : Tm) (r1 : L18J (jeqtm G a b A)) (r2 : L18J (jeqty G A B)) : L18J (jeqtm G a b B) =
  (r1.1, \ D e1 e2 wD rl ->
     gm-eqconv D (ev a e1) (ev b e2) (ev A e1) (ev B e1) (r1.2 D e1 e2 wD rl) (r2.2 D e1 e1 wD (rel-refl D G e1 rl.1))) ;


c-eqtm-lam (G : Cx) (A A' B B' b b' : Tm) (r0 : L18J (jty G A)) (r1 : L18J (jeqty G A A')) (r2 : L18J (jeqty (csnoc G A) B B'))
    (r3 : L18J (jeqtm (csnoc G A) b b' B)) : L18J (jeqtm G (lam A B b) (lam A' B' b') (pi A B)) =
  (r0.1, \ D e1 e2 wD rl ->
     gm-elam D (ev A e1) (ev A' e2) (ev B (up e1)) (ev B' (up e2)) (ev b (up e1)) (ev b' (up e2)) (r0.2.1 D e1 wD rl.1) (r1.2 D e1 e2 wD rl)
       (r2.2 (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (r0.2.1 D e1 wD rl.1)) (rel-up D wD G A (cs-ci (csnoc G A) r2.1) e1 e2 rl))
       (r3.2 (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (r0.2.1 D e1 wD rl.1)) (rel-up D wD G A (cs-ci (csnoc G A) r2.1) e1 e2 rl))) ;


c-eqtm-app (G : Cx) (A A' B B' c c' a a' : Tm) (r0 : L18J (jty G A)) (rB : L18J (jty (csnoc G A) B)) (ra : L18J (jtm G a A))
    (r1 : L18J (jeqty G A A')) (r2 : L18J (jeqty (csnoc G A) B B')) (r3 : L18J (jeqtm G c c' (pi A B)))
    (r4 : L18J (jeqtm G a a' A)) : L18J (jeqtm G (app A B c a) (app A' B' c' a') (subst1 B a)) =
  (r0.1, \ D e1 e2 wD rl ->
     gm-eqconv D (gapp (ev A e1) (ev B (up e1)) (ev c e1) (ev a e1)) (gapp (ev A' e2) (ev B' (up e2)) (ev c' e2) (ev a' e2))
       (gsb (ev B (up e1)) (gsec (ev A e1) (ev a e1))) (ev (subst1 B a) e1)
       (gm-eapp D (ev A e1) (ev A' e2) (ev B (up e1)) (ev B' (up e2)) (ev c e1) (ev c' e2) (ev a e1) (ev a' e2) (r0.2.1 D e1 wD rl.1) (rB.2.1 (gext D (ev A e1)) (up e1) (g-ext D (ev A e1) (r0.2.1 D e1 wD rl.1)) (env-up D e1 wD G A (cs-ci (csnoc G A) rB.1) rl.1))
          (ra.2.1 D e1 wD rl.1) (r1.2 D e1 e2 wD rl)
          (r2.2 (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (r0.2.1 D e1 wD rl.1)) (rel-up D wD G A (cs-ci (csnoc G A) rB.1) e1 e2 rl))
          (r3.2 D e1 e2 wD rl) (r4.2 D e1 e2 wD rl))
       (tyapp G A B a r0.1 (cs-ci (csnoc G A) rB.1) rB.1 ra.2.1 ra.2.2.1 ra.2.2.2.1 rB.2.2.1 rB.2.2.2.1 rB.2.2.2.2
          D (ev A e1) e1 wD (r0.2.1 D e1 wD rl.1) (ge-refl D (ev A e1) (r0.2.1 D e1 wD rl.1)) rl.1 (ra.2.1 D e1 wD rl.1))) ;


c-eqtm-pic (G : Cx) (n : Nat) (a a' b b' : Tm) (r0 : L18J (jtm G a (uu n))) (r1 : L18J (jeqtm G a a' (uu n)))
    (r2 : L18J (jeqtm (csnoc G (el n a)) b b' (uu n))) : L18J (jeqtm G (pic n a b) (pic n a' b') (uu n)) =
  (r0.1, \ D e1 e2 wD rl ->
     gm-epic D n (ev a e1) (ev a' e2) (ev b (up e1)) (ev b' (up e2)) (r0.2.1 D e1 wD rl.1) (r1.2 D e1 e2 wD rl)
       (r2.2 (gext D (gel n (ev a e1))) (up e1) (up e2) (g-ext D (gel n (ev a e1)) (gt-el D n (ev a e1) (r0.2.1 D e1 wD rl.1)))
          (rel-up D wD G (el n a) (cs-ci (csnoc G (el n a)) r2.1) e1 e2 rl))) ;

c-eqtm-lf (G : Cx) (m n : Nat) (a a' : Tm) (le : LeN (suc m) n) (nb : LeN n N) (r : L18J (jeqtm G a a' (uu m))) :
    L18J (jeqtm G (lf m n a) (lf m n a') (uu n)) =
  (r.1, \ D e1 e2 wD rl -> gm-elf D m n (ev a e1) (ev a' e2) (r.2 D e1 e2 wD rl) le nb) ;

c-eqtm-lf-uc (G : Cx) (m n p : Nat) (lt : LeN (suc m) n) (le : LeN (suc n) p) (nb : LeN p N) (r : L18J (jwf G)) :
    L18J (jeqtm G (lf n p (uc m n)) (uc m p) (uu p)) =
  (r, \ D e1 e2 wD rl -> gm-lf-uc D m n p wD lt le nb) ;

c-eqtm-lf-lf (G : Cx) (m n p : Nat) (a : Tm) (le1 : LeN (suc m) n) (le2 : LeN (suc n) p) (nb : LeN p N) (r : L18J (jtm G a (uu m))) :
    L18J (jeqtm G (lf n p (lf m n a)) (lf m p a) (uu p)) =
  (r.1, \ D e1 e2 wD rl ->
     gm-trans D (glf n p (glf m n (ev a e1))) (glf m p (ev a e1)) (glf m p (ev a e2)) (guu p)
       (gm-lf-lf D m n p (ev a e1) (r.2.1 D e1 wD rl.1) le1 le2 nb)
       (gm-elf D m p (ev a e1) (ev a e2) (r.2.2.2.1 D e1 e2 wD rl) (leN-trans (suc m) n p le1 (lt-le n p le2)) nb)) ;


c-eqtm-lf-pic (G : Cx) (n p : Nat) (a b : Tm) (le : LeN (suc n) p) (nb : LeN p N) (r1 : L18J (jtm G a (uu n)))
    (r2 : L18J (jtm (csnoc G (el n a)) b (uu n))) :
    L18J (jeqtm G (lf n p (pic n a b)) (pic p (lf n p a) (lf n p b)) (uu p)) =
  (r1.1, \ D e1 e2 wD rl ->
     gm-trans D (glf n p (gpic n (ev a e1) (ev b (up e1)))) (gpic p (glf n p (ev a e1)) (glf n p (ev b (up e1)))) (gpic p (glf n p (ev a e2)) (glf n p (ev b (up e2)))) (guu p)
       (gm-lf-pic D n p (ev a e1) (ev b (up e1)) (r1.2.1 D e1 wD rl.1) (r2.2.1 (gext D (gel n (ev a e1))) (up e1) (g-ext D (gel n (ev a e1)) (gt-el D n (ev a e1) (r1.2.1 D e1 wD rl.1))) (env-up D e1 wD G (el n a) (cs-ci (csnoc G (el n a)) r2.1) rl.1)) le nb)
       (gm-epic D p (glf n p (ev a e1)) (glf n p (ev a e2)) (glf n p (ev b (up e1))) (glf n p (ev b (up e2))) (gm-lf D n p (ev a e1) (r1.2.1 D e1 wD rl.1) le nb)
          (gm-elf D n p (ev a e1) (ev a e2) (r1.2.2.2.1 D e1 e2 wD rl) le nb)
          (gm-ecx (gext D (gel n (ev a e1))) (gext D (gel p (glf n p (ev a e1)))) (glf n p (ev b (up e1))) (glf n p (ev b (up e2))) (guu p) (g-ext D (gel p (glf n p (ev a e1))) (gt-el D p (glf n p (ev a e1)) (gm-lf D n p (ev a e1) (r1.2.1 D e1 wD rl.1) le nb)))
             (gc-ext D D (gel n (ev a e1)) (gel p (glf n p (ev a e1))) (gc-refl D wD)
                (ge-sym D (gel p (glf n p (ev a e1))) (gel n (ev a e1)) (ge-el-lf D n p (ev a e1) (r1.2.1 D e1 wD rl.1) le nb)))
             (gm-elf (gext D (gel n (ev a e1))) n p (ev b (up e1)) (ev b (up e2))
                (r2.2.2.2.1 (gext D (gel n (ev a e1))) (up e1) (up e2) (g-ext D (gel n (ev a e1)) (gt-el D n (ev a e1) (r1.2.1 D e1 wD rl.1))) (rel-up D wD G (el n a) (cs-ci (csnoc G (el n a)) r2.1) e1 e2 rl)) le nb)))) ;
