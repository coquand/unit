-- InitHomRelA: relational form of the laws of a morphism, for the
-- structural operations (nil, ext, id, o, eps, p, q, sec, subT, lift, subt).
-- Segment of InitHom.Morphism (l, N, M, M').
--
-- rel-op H (arguments of op in M) (arguments of op' in M')
--   (proofs that each argument of M is related by H to the one of M')
--   : the result of op is related by H to the result of op'.
-- The arguments of op' are arbitrary (not the H-images), so for two
-- morphisms H, H' one instantiates them with the H'-images and obtains
-- Agree H H' on op from Agree on the arguments (uniqueness, Part U).
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
open InitHomBase ;
open InitHomLaws ;

rel-nil (H : Hom) : RCtx H C.nil C'.nil = H.ctx-nil ;

rel-ext (H : Hom) (G : C.Ctx) (A : C.Ty G) (X : C'.Ctx) (A' : C'.Ty X) (e : RTy H G A (X, A'))
  : RCtx H (C.ext G A) (C'.ext X A') =
  trans C'.Ctx (H.ctx (C.ext G A)) (H.ext' G A) (C'.ext X A') (H.ctx-ext G A)
    (ap TyT' C'.Ctx (\ w -> C'.ext w.1 w.2) (H.ctx G, H.ty G A) (X, A') e) ;

rel-id (H : Hom) (G : C.Ctx) (X : C'.Ctx) (e : RCtx H G X)
  : RSub H G G (C.id G) (X, (X, C'.id X)) =
  idJ C'.Ctx (H.ctx G) (\ Z e1 -> RSub H G G (C.id G) (Z, (Z, C'.id Z)))
    (ap (C'.Sub (H.ctx G) (H.ctx G)) SubT' (\ t -> (H.ctx G, (H.ctx G, t)))
        (H.sub G G (C.id G)) (C'.id (H.ctx G)) (H.sub-id G))
    X e ;

-- composition: first the inner argument at the H-image of the outer one
rel-o-base (H : Hom) (T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D)
    (X : C'.Ctx) (t' : C'.Sub X (H.ctx D)) (e' : RSub H T D s' (X, (H.ctx D, t')))
  : RSub H T G (C.o T D G s s') (X, (H.ctx G, C'.o X (H.ctx D) (H.ctx G) (H.sub D G s) t')) =
  idJ (DomT' (H.ctx D)) (H.ctx T, H.sub T D s')
    (\ u e1 -> RSub H T G (C.o T D G s s')
                 (u.1, (H.ctx G, C'.o u.1 (H.ctx D) (H.ctx G) (H.sub D G s) u.2)))
    (ap (C'.Sub (H.ctx T) (H.ctx G)) SubT' (\ x -> (H.ctx T, (H.ctx G, x)))
        (H.sub T G (C.o T D G s s'))
        (C'.o (H.ctx T) (H.ctx D) (H.ctx G) (H.sub D G s) (H.sub T D s')) (H.sub-o T D G s s'))
    (X, t') (domPath (H.ctx T) X (H.ctx D) (H.sub T D s') t' e') ;

rel-o (H : Hom) (T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D)
    (X Y Z : C'.Ctx) (t : C'.Sub Y Z) (t' : C'.Sub X Y)
    (e : RSub H D G s (Y, (Z, t))) (e' : RSub H T D s' (X, (Y, t')))
  : RSub H T G (C.o T D G s s') (X, (Z, C'.o X Y Z t t')) =
  idJ SubT' (H.ctx D, (H.ctx G, H.sub D G s))
    (\ v e1 -> (X1 : C'.Ctx) (t1 : C'.Sub X1 v.1) -> RSub H T D s' (X1, (v.1, t1))
               -> RSub H T G (C.o T D G s s') (X1, (v.2.1, C'.o X1 v.1 v.2.1 v.2.2 t1)))
    (rel-o-base H T D G s s')
    (Y, (Z, t)) e X t' e' ;

rel-eps (H : Hom) (G : C.Ctx) (X : C'.Ctx) (e : RCtx H G X)
  : RSub H G C.nil (C.eps G) (X, (C'.nil, C'.eps X)) =
  idJ C'.Ctx (H.ctx G) (\ Z e1 -> RSub H G C.nil (C.eps G) (Z, (C'.nil, C'.eps Z)))
    (H.sub-eps G) X e ;

rel-p (H : Hom) (G : C.Ctx) (A : C.Ty G) (X : C'.Ctx) (A' : C'.Ty X) (e : RTy H G A (X, A'))
  : RSub H (C.ext G A) G (C.p G A) (C'.ext X A', (X, C'.p X A')) =
  idJ TyT' (H.ctx G, H.ty G A)
    (\ w e1 -> RSub H (C.ext G A) G (C.p G A) (C'.ext w.1 w.2, (w.1, C'.p w.1 w.2)))
    (H.sub-p G A) (X, A') e ;

rel-q (H : Hom) (G : C.Ctx) (A : C.Ty G) (X : C'.Ctx) (A' : C'.Ty X) (e : RTy H G A (X, A'))
  : RTm H (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A)
      (C'.ext X A', (C'.subT (C'.ext X A') X A' (C'.p X A'), C'.q X A')) =
  idJ TyT' (H.ctx G, H.ty G A)
    (\ w e1 -> RTm H (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A)
      (C'.ext w.1 w.2, (C'.subT (C'.ext w.1 w.2) w.1 w.2 (C'.p w.1 w.2), C'.q w.1 w.2)))
    (H.tm-q G A) (X, A') e ;

rel-sec (H : Hom) (G : C.Ctx) (A : C.Ty G) (a : C.El G A)
    (X : C'.Ctx) (A' : C'.Ty X) (a' : C'.El X A') (e : RTm H G A a (X, (A', a')))
  : RSub H G (C.ext G A) (C.sec G A a) (X, (C'.ext X A', C'.sec X A' a')) =
  idJ TmT' (H.ctx G, (H.ty G A, H.tm G A a))
    (\ w e1 -> RSub H G (C.ext G A) (C.sec G A a) (w.1, (C'.ext w.1 w.2.1, C'.sec w.1 w.2.1 w.2.2)))
    (H.sub-sec G A a) (X, (A', a')) e ;

------------------------------------------------------------------------
-- subT and lift: argument A over G and s : D -> G

rel-subT-base (H : Hom) (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G)
    (A' : C'.Ty (H.ctx G)) (eA : RTy H G A (H.ctx G, A'))
  : RTy H D (C.subT D G A s) (H.ctx D, C'.subT (H.ctx D) (H.ctx G) A' (H.sub D G s)) =
  idJ (C'.Ty (H.ctx G)) (H.ty G A)
    (\ A2 e2 -> RTy H D (C.subT D G A s) (H.ctx D, C'.subT (H.ctx D) (H.ctx G) A2 (H.sub D G s)))
    (ap (C'.Ty (H.ctx D)) TyT' (\ T -> (H.ctx D, T))
        (H.ty D (C.subT D G A s)) (C'.subT (H.ctx D) (H.ctx G) (H.ty G A) (H.sub D G s))
        (H.ty-subT D G A s))
    A' (fibTy (H.ctx G) (H.ty G A) A' eA) ;

rel-subT (H : Hom) (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G)
    (X Y : C'.Ctx) (A' : C'.Ty Y) (t : C'.Sub X Y)
    (eA : RTy H G A (Y, A')) (es : RSub H D G s (X, (Y, t)))
  : RTy H D (C.subT D G A s) (X, C'.subT X Y A' t) =
  idJ SubT' (H.ctx D, (H.ctx G, H.sub D G s))
    (\ v e1 -> (A1 : C'.Ty v.2.1) -> RTy H G A (v.2.1, A1)
               -> RTy H D (C.subT D G A s) (v.1, C'.subT v.1 v.2.1 A1 v.2.2))
    (rel-subT-base H D G A s)
    (X, (Y, t)) es A' eA ;

rel-lift-base (H : Hom) (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G)
    (A' : C'.Ty (H.ctx G)) (eA : RTy H G A (H.ctx G, A'))
  : RSub H (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s)
      (C'.ext (H.ctx D) (C'.subT (H.ctx D) (H.ctx G) A' (H.sub D G s)),
       (C'.ext (H.ctx G) A', C'.lift (H.ctx D) (H.ctx G) A' (H.sub D G s))) =
  idJ (C'.Ty (H.ctx G)) (H.ty G A)
    (\ A2 e2 -> RSub H (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s)
      (C'.ext (H.ctx D) (C'.subT (H.ctx D) (H.ctx G) A2 (H.sub D G s)),
       (C'.ext (H.ctx G) A2, C'.lift (H.ctx D) (H.ctx G) A2 (H.sub D G s))))
    (H.sub-lift D G A s)
    A' (fibTy (H.ctx G) (H.ty G A) A' eA) ;

rel-lift (H : Hom) (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G)
    (X Y : C'.Ctx) (A' : C'.Ty Y) (t : C'.Sub X Y)
    (eA : RTy H G A (Y, A')) (es : RSub H D G s (X, (Y, t)))
  : RSub H (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s)
      (C'.ext X (C'.subT X Y A' t), (C'.ext Y A', C'.lift X Y A' t)) =
  idJ SubT' (H.ctx D, (H.ctx G, H.sub D G s))
    (\ v e1 -> (A1 : C'.Ty v.2.1) -> RTy H G A (v.2.1, A1)
               -> RSub H (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s)
                    (C'.ext v.1 (C'.subT v.1 v.2.1 A1 v.2.2), (C'.ext v.2.1 A1, C'.lift v.1 v.2.1 A1 v.2.2)))
    (rel-lift-base H D G A s)
    (X, (Y, t)) es A' eA ;

------------------------------------------------------------------------
-- subt: argument a : El G A and s : D -> G

rel-subt-base (H : Hom) (D G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G)
    (u : Term' (H.ctx G)) (ea : RTm H G A a (H.ctx G, u))
  : RTm H D (C.subT D G A s) (C.subt D G A a s)
      (H.ctx D, (C'.subT (H.ctx D) (H.ctx G) u.1 (H.sub D G s), C'.subt (H.ctx D) (H.ctx G) u.1 u.2 (H.sub D G s))) =
  idJ (Term' (H.ctx G)) (H.ty G A, H.tm G A a)
    (\ u2 e2 -> RTm H D (C.subT D G A s) (C.subt D G A a s)
      (H.ctx D, (C'.subT (H.ctx D) (H.ctx G) u2.1 (H.sub D G s), C'.subt (H.ctx D) (H.ctx G) u2.1 u2.2 (H.sub D G s))))
    (ap (Term' (H.ctx D)) TmT' (\ v -> (H.ctx D, v))
        (H.ty D (C.subT D G A s), H.tm D (C.subT D G A s) (C.subt D G A a s))
        (C'.subT (H.ctx D) (H.ctx G) (H.ty G A) (H.sub D G s),
         C'.subt (H.ctx D) (H.ctx G) (H.ty G A) (H.tm G A a) (H.sub D G s))
        (H.tm-subt D G A a s))
    u (fibTm (H.ctx G) (H.ty G A, H.tm G A a) u ea) ;

rel-subt (H : Hom) (D G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G)
    (X Y : C'.Ctx) (A' : C'.Ty Y) (a' : C'.El Y A') (t : C'.Sub X Y)
    (ea : RTm H G A a (Y, (A', a'))) (es : RSub H D G s (X, (Y, t)))
  : RTm H D (C.subT D G A s) (C.subt D G A a s) (X, (C'.subT X Y A' t, C'.subt X Y A' a' t)) =
  idJ SubT' (H.ctx D, (H.ctx G, H.sub D G s))
    (\ v e1 -> (u : Term' v.2.1) -> RTm H G A a (v.2.1, u)
               -> RTm H D (C.subT D G A s) (C.subt D G A a s)
                    (v.1, (C'.subT v.1 v.2.1 u.1 v.2.2, C'.subt v.1 v.2.1 u.1 u.2 v.2.2)))
    (rel-subt-base H D G A a s)
    (X, (Y, t)) es (A', a') ea ;
