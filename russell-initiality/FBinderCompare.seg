-- Coherence for products, abstractions and applications.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FSubstLaws[l] ; open FCtx[l] ; open FGen[l] ; open FCompareBase[l] ;
open FSubCompare[l] ; open FActionCompare[l] ;

binder-back (G H A : FA) (e : CE G H) (h : Ty H A) : CE (fext H A) (fext G A) =
  ext-eq (f-cx-sym G H e) (ty-refl h) ;

pi-frame-compare (G A B H A' B' : FA) (ca : TyCompare A A') (cb : TyCompare B B') :
    TyFrameCompare (fpi G A B) (fpi H A' B') =
  \ e p q -> compare e p.1 p.2 q.1 q.2
 where {
  compare (e : CE G H) (ha : Ty G A) (hb : Ty (fext G A) B) (ha' : Ty H A') (hb' : Ty (fext H A') B') :
      TE G (fpi G A B) (fpi H A' B') =
    fe-trans G (fpi G A B) (fpi G A' B') (fpi H A' B')
      (fe-pi G A A' B B' ha types bodies) (fe-pi-context G A' B' left-a left-b H e)
   where {
    types : TE G A A' = ca G H e ha ha' ;
    bodies : TE (fext G A) B B' = cb (fext G A) (fext H A') (ext-eq e types) hb hb' ;
    left-a : Ty G A' = move-ty H G A' (f-cx-sym G H e) ha' ;
    left-b : Ty (fext G A') B' = move-ty (fext H A') (fext G A') B' (binder-back G H A' e ha') hb' ;
   } ;
 } ;

lam-frame-compare (G A B b H A' B' b' : FA) (ca : TyCompare A A') (cb : TyCompare B B') (cc : TmCompare b b') :
    TmFrameCompare (flam G A B b) (flam H A' B' b') =
  \ e p q -> compare e p.1 p.2.1 p.2.2 q.1 q.2.1 q.2.2
 where {
  compare (e : CE G H) (ha : Ty G A) (hb : Ty (fext G A) B) (t : Tm' (fext G A) b B)
      (ha' : Ty H A') (hb' : Ty (fext H A') B') (t' : Tm' (fext H A') b' B') :
      TE G (fpi G A B) (fpi H A' B') * ME G (flam G A B b) (flam H A' B' b') (fpi G A B) =
    (ty-trans mid-pi (fe-pi-context G A' B' left-a left-b H e),
     fm-trans G (flam G A B b) (flam G A' B' b') (flam H A' B' b') (fpi G A B)
       (fm-elam G A A' B B' b b' ha types bodies terms)
       (fm-eqconv G (flam G A' B' b') (flam H A' B' b') (fpi G A' B') (fpi G A B)
         (fm-lam-context G A' B' b' left-a left-b left-t H e) (ty-sym mid-pi)))
   where {
    types : TE G A A' = ca G H e ha ha' ;
    ext : CE (fext G A) (fext H A') = ext-eq e types ;
    bodies : TE (fext G A) B B' = cb (fext G A) (fext H A') ext hb hb' ;
    terms : ME (fext G A) b b' B = (cc (fext G A) (fext H A') B B' ext t t').2 ;
    mid-pi : TE G (fpi G A B) (fpi G A' B') = fe-pi G A A' B B' ha types bodies ;
    back : CE (fext H A') (fext G A') = binder-back G H A' e ha' ;
    left-a : Ty G A' = move-ty H G A' (f-cx-sym G H e) ha' ;
    left-b : Ty (fext G A') B' = move-ty (fext H A') (fext G A') B' back hb' ;
    left-t : Tm' (fext G A') b' B' = move-tm (fext H A') (fext G A') b' B' back t' ;
   } ;
 } ;

app-type-compare (G A B a H A' B' a' : FA) (ca : TyCompare A A') (cb : TyCompare B B')
    (ct : TmCompare a a') (e : CE G H) (ha : Ty G A) (hb : Ty (fext G A) B) (t : Tm' G a A)
    (ha' : Ty H A') (hb' : Ty (fext H A') B') (t' : Tm' H a' A') :
    TE G (ftsb G (fext G A) B (fsec G A a)) (ftsb H (fext H A') B' (fsec H A' a')) =
  ty-action-frame G (fext G A) B (fsec G A a) H (fext H A') B' (fsec H A' a') cb
    (sub-frames (fsec G A a) (fsec H A' a') (sec-frame-compare G A a H A' a' ca ct))
    e (hb,sec-sub ha t) (hb',sec-sub ha' t') ;

app-frame-compare (G A B c a H A' B' c' a' : FA)
    (ca : TyCompare A A') (cb : TyCompare B B') (cc : TmCompare c c') (ct : TmCompare a a') :
    TmFrameCompare (fapp G A B c a) (fapp H A' B' c' a') =
  \ e p q -> compare e p.1 p.2.1 p.2.2.1 p.2.2.2 q.1 q.2.1 q.2.2.1 q.2.2.2
 where {
  compare (e : CE G H) (ha : Ty G A) (hb : Ty (fext G A) B)
      (hc : Tm' G c (fpi G A B)) (t : Tm' G a A)
      (ha' : Ty H A') (hb' : Ty (fext H A') B') (hc' : Tm' H c' (fpi H A' B')) (t' : Tm' H a' A') :
      TE G (ftsb G (fext G A) B (fsec G A a)) (ftsb H (fext H A') B' (fsec H A' a')) *
      ME G (fapp G A B c a) (fapp H A' B' c' a') (ftsb G (fext G A) B (fsec G A a)) =
    (app-type-compare G A B a H A' B' a' ca cb ct e ha hb t ha' hb' t',
     fm-trans G (fapp G A B c a) (fapp G A' B' c' a') (fapp H A' B' c' a') (ftsb G (fext G A) B (fsec G A a))
       (fm-eapp G A A' B B' c c' a a' ha hb t types bodies functions terms)
       (fm-eqconv G (fapp G A' B' c' a') (fapp H A' B' c' a')
         (ftsb G (fext G A') B' (fsec G A' a')) (ftsb G (fext G A) B (fsec G A a))
         (fm-app-context G A' B' c' a' left-a left-b left-c left-t H e)
         (ty-sym (app-type-compare G A B a G A' B' a' ca cb ct (cx-refl (wf-left G H e)) ha hb t left-a left-b left-t))))
   where {
    types : TE G A A' = ca G H e ha ha' ;
    ext : CE (fext G A) (fext H A') = ext-eq e types ;
    bodies : TE (fext G A) B B' = cb (fext G A) (fext H A') ext hb hb' ;
    functions : ME G c c' (fpi G A B) = (cc G H (fpi G A B) (fpi H A' B') e hc hc').2 ;
    terms : ME G a a' A = (ct G H A A' e t t').2 ;
    back : CE H G = f-cx-sym G H e ;
    left-a : Ty G A' = move-ty H G A' back ha' ;
    left-b : Ty (fext G A') B' = move-ty (fext H A') (fext G A') B' (binder-back G H A' e ha') hb' ;
    left-t : Tm' G a' A' = move-tm H G a' A' back t' ;
    left-c : Tm' G c' (fpi G A' B') =
      tm-conv (move-tm H G c' (fpi H A' B') back hc') (ty-sym (fe-pi-context G A' B' left-a left-b H e)) ;
   } ;
 } ;
