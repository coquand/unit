-- L18.seg: sterbac4, Lemma 18 for Ehrhard-GAT: the lifting by evaluation
-- preserves derivations, and commutes with substitution (the components
-- NT/NM and ST/SMt of the motive L18J).
--   lemma18      one eliminator for Der, dispatching to the case lemmas
--   ceil-ok      |- ceil G  and  idv is an environment for G over ceil G
--   lift-ty ..   G |-T J  gives  ceil G |-G ceil J

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18Bind[l] ; open L18Pi[l] ;
open L18App[l] ; open L18U[l] ; open L18Eq[l] ; open L18BE[l] ;

lemma18 : (J : Jf) -> Der J -> L18J J = split {
  wf-nil -> tt ;
  wf-snoc G A h | r -> r ;
  tm-v0 G A h | r -> c-v0 G A r ;
  tm-vs G B n A h1 h2 | r1 r2 -> c-vs G B n A r1 r2 ;
  ty-pi G A B h1 h2 | r1 r2 -> c-pi G A B r1 r2 ;
  ty-uu G n h nb | r -> c-uu G n nb r ;
  ty-el G n a h | r -> c-el G n a r ;
  tm-lam G A B b h1 h2 h3 | r1 r2 r3 -> c-lam G A B b r1 r2 r3 ;
  tm-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> c-app G A B c a r1 r2 r3 r4 ;
  tm-pic G n a b h1 h2 | r1 r2 -> c-pic G n a b h1 r1 r2 ;
  tm-uc G m n h lt nb | r -> c-uc G m n lt nb r ;
  tm-lf G m n a h le nb | r -> c-lf G m n a le nb r ;
  tm-conv G a A B h1 h2 | r1 r2 -> c-conv G a A B r1 r2 ;
  eqty-refl G A h | r -> c-eqty-refl G A r ;
  eqty-sym G A B h | r -> c-eqty-sym G A B r ;
  eqty-trans G A B C h1 h2 | r1 r2 -> c-eqty-trans G A B C r1 r2 ;
  eqty-pi G A A' B B' h0 h1 h2 | r0 r1 r2 -> c-eqty-pi G A A' B B' r0 r1 r2 ;
  eqty-el G n a a' h | r -> c-eqty-el G n a a' r ;
  eqty-el-lf G m n a h le nb | r -> c-eqty-el-lf G m n a le nb r ;
  eqty-el-pic G n a b h1 h2 | r1 r2 -> c-eqty-el-pic G n a b r1 r2 ;
  eqty-el-uc G m n h lt nb | r -> c-eqty-el-uc G m n lt nb r ;
  eqtm-refl G a A h | r -> c-eqtm-refl G a A r ;
  eqtm-sym G a b A hA h | rA r -> c-eqtm-sym G a b A rA r ;
  eqtm-trans G a b c A h1 h2 | r1 r2 -> c-eqtm-trans G a b c A r1 r2 ;
  eqtm-conv G a b A B h1 h2 | r1 r2 -> c-eqtm-conv G a b A B r1 r2 ;
  eqtm-lam G A A' B B' b b' h0 h1 h2 h3 | r0 r1 r2 r3 -> c-eqtm-lam G A A' B B' b b' r0 r1 r2 r3 ;
  eqtm-app G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | r0 rB ra r1 r2 r3 r4 ->
    c-eqtm-app G A A' B B' c c' a a' r0 rB ra r1 r2 r3 r4 ;
  eqtm-pic G n a a' b b' h0 h1 h2 | r0 r1 r2 -> c-eqtm-pic G n a a' b b' r0 r1 r2 ;
  eqtm-lf G m n a a' h le nb | r -> c-eqtm-lf G m n a a' le nb r ;
  eqtm-beta G A B b a hA hB h1 h2 | rA rB r1 r2 -> c-eqtm-beta G A B b a rA rB r1 r2 ;
  eqtm-eta G A B f hA hB h | rA rB r -> c-eqtm-eta G A B f rA rB r ;
  eqtm-lf-pic G n p a b h1 h2 le nb | r1 r2 -> c-eqtm-lf-pic G n p a b le nb r1 r2 ;
  eqtm-lf-uc G m n p h lt le nb | r -> c-eqtm-lf-uc G m n p lt le nb r ;
  eqtm-lf-lf G m n p a h le1 le2 nb | r -> c-eqtm-lf-lf G m n p a le1 le2 nb r } ;

------------------------------------------------------------------------
-- the lifted context and its identity environment

ceil-ok : (G : Cx) -> CtxS G -> GDer (gjwf (ceilC G)) * EnvOk (ceilC G) G idv = split {
  cnil -> \ c -> (g-nil, tt) ;
  csnoc G A | r -> \ c ->
    (g-ext (ceilC G) (ceil A) (c.2.1 (ceilC G) idv (r c.1).1 (r c.1).2),
     env-up (ceilC G) idv (r c.1).1 G A (cs-ci (csnoc G A) c) (r c.1).2) } ;

------------------------------------------------------------------------
-- Lemma 18 (preservation): G |-T J gives ceil G |-G ceil J

lift-wf (G : Cx) (d : Der (jwf G)) : GDer (gjwf (ceilC G)) = (ceil-ok G (lemma18 (jwf G) d)).1 ;

lift-ty (G : Cx) (A : Tm) (d : Der (jty G A)) : GDer (gjty (ceilC G) (ceil A)) =
  (lemma18 (jty G A) d).2.1 (ceilC G) idv (ceil-ok G (lemma18 (jty G A) d).1).1 (ceil-ok G (lemma18 (jty G A) d).1).2 ;

lift-tm (G : Cx) (a A : Tm) (d : Der (jtm G a A)) : GDer (gjtm (ceilC G) (ceil a) (ceil A)) =
  (lemma18 (jtm G a A) d).2.1 (ceilC G) idv (ceil-ok G (lemma18 (jtm G a A) d).1).1 (ceil-ok G (lemma18 (jtm G a A) d).1).2 ;

lift-eqty (G : Cx) (A B : Tm) (d : Der (jeqty G A B)) : GDer (gjeqty (ceilC G) (ceil A) (ceil B)) =
  (lemma18 (jeqty G A B) d).2 (ceilC G) idv idv (ceil-ok G (lemma18 (jeqty G A B) d).1).1
    (rel-refl (ceilC G) G idv (ceil-ok G (lemma18 (jeqty G A B) d).1).2) ;

lift-eqtm (G : Cx) (a b A : Tm) (d : Der (jeqtm G a b A)) : GDer (gjeqtm (ceilC G) (ceil a) (ceil b) (ceil A)) =
  (lemma18 (jeqtm G a b A) d).2 (ceilC G) idv idv (ceil-ok G (lemma18 (jeqtm G a b A) d).1).1
    (rel-refl (ceilC G) G idv (ceil-ok G (lemma18 (jeqtm G a b A) d).1).2) ;
