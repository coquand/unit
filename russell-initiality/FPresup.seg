-- Presuppositions and context symmetry for all full judgements.
level l ;
open Base ; open Lib[l] ; open TTyping[l] ; open FGAT[l] ; open FTyping[l] ; open FSubstLaws[l] ;
open FEquationFrames[l] ; open FSubEquationFrames[l] ; open FAnnotationFrames[l] ;

fpresup : (J : FAJ) -> FADer J -> FPJ J = split {
  f-nil -> tt ;
  f-ext G A h -> tt ;
  fc-nil -> (f-nil,(f-nil,fc-nil)) ;
  fc-refl G h -> (h,(h,cx-refl h)) ;
  fc-ext G D A B h1 h2 | r1 r2 ->
    (ext-wf r2.2.1,(ext-wf (ty-cx r1.2.1 h1 r2.2.2),ext-eq r1.2.2 (te-cx {G} {D} {B} {A} r1.2.1 h1 (ty-sym h2)))) ;
  fs-id G h -> (h,h) ;
  fs-comp T D G s d h1 h2 | r1 r2 -> (r2.1,r1.2) ;
  fs-eps G h -> (h,f-nil) ;
  fs-p G A h | r -> (ext-wf h,r) ;
  fs-lift D G A s h1 h2 | r1 r2 -> (ext-wf (ty-sub h2 h1),ext-wf h2) ;
  fs-sec G A a h1 h2 | r1 r2 -> (r1,ext-wf h1) ;
  fs-cx D D' G G' s h0 h0' h1 h2 h -> (h0,h0') ;
  ft-pi G A B h1 h2 | r1 r2 -> r1 ;
  ft-uu G n h nb -> h ;
  ft-el G n a h | r -> r.1 ;
  ft-sb D G A s h1 h2 | r1 r2 -> r2.1 ;
  ft-cx G D A h0 h1 h2 -> h0 ;
  fm-lam G A B b h1 h2 h3 | r1 r2 r3 -> (r1,pi-ty h1 h2) ;
  fm-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> (r1,ty-sub h2 (sec-sub h1 h4)) ;
  fm-pic G n a b h1 h2 | r1 r2 -> r1 ;
  fm-uc G m n h lt nb -> (h,ft-uu G n h nb) ;
  fm-lf G m n a h le nb | r -> (r.1,ft-uu G n r.1 nb) ;
  fm-q G A h | r -> (ext-wf h,ty-sub h (p-sub h)) ;
  fm-sb D G a A s hA h1 h2 | rA r1 r2 -> (r2.1,ty-sub hA h2) ;
  fm-conv G a A B h1 h2 | r1 r2 -> (r1.1,r2.2.2) ;
  fm-cx G D a A h0 h1 h2 | r0 r1 r2 -> (h0,ty-cx h0 h1 r2.2) ;
  fe-refl G A h | r -> (r,(h,h)) ;
  fe-sym G A B h | r -> (r.1,(r.2.2,r.2.1)) ;
  fe-trans G A B C h1 h2 | r1 r2 -> (r1.1,(r1.2.1,r2.2.2)) ;
  fe-pi G A A' B B' h0 h1 h2 | r0 r1 r2 -> pi-eq-frame r0 h1 h0 r1.2.2 r2.2.1 r2.2.2 ;
  fe-el G n a a' h | r -> (r.1,(ft-el G n a r.2.2.1,ft-el G n a' r.2.2.2)) ;
  fe-sb D G A A' s s' h0 h1 h2 h3 h4 | r0 r1 r2 r3 r4 -> (r2.1,(ty-sub h0 h2,ty-sub r1.2.2 h3)) ;
  fe-el-lf G m n a h le nb | r -> (r.1,(ft-el G n (flf m n G a) (fm-lf G m n a h le nb),ft-el G m a h)) ;
  fe-el-pic G n a b h1 h2 | r1 r2 ->
    (r1.1,(ft-el G n (fpic n G a b) (fm-pic G n a b h1 h2),
      pi-ty (ft-el G n a h1) (ft-el (fext G (fel n G a)) n b h2))) ;
  fe-el-uc G m n h lt nb -> (h,(ft-el G n (fuc m n G) (fm-uc G m n h lt nb),ft-uu G m h (leN-trans m n N (lt-le m n lt) nb))) ;
  fe-sb-id G A h | r -> (r,(ty-sub h (id-sub r),h)) ;
  fe-sb-comp T D G A s d h0 h1 h2 | r0 r1 r2 -> (r2.1,(ty-sub (ty-sub h0 h1) h2,ty-sub h0 (comp-sub h1 h2))) ;
  fe-pi-sb D G A B s h1 h2 h3 | r1 r2 r3 ->
    (r3.1,(ty-sub (pi-ty h1 h2) h3,pi-ty (ty-sub h1 h3) (ty-sub h2 (lift-sub h1 h3)))) ;
  fe-uu-sb D G n s h nb | r -> (r.1,(ty-sub (ft-uu G n r.2 nb) h,ft-uu D n r.1 nb)) ;
  fe-el-sb D G n a s h1 h2 | r1 r2 ->
    (r2.1,(ty-sub (ft-el G n a h1) h2,ft-el D n (fmsb D G (fuu n G) a s) (sub-universe n r1.2 h1 h2))) ;
  fe-cx G D A B h0 h1 h2 | r0 r1 r2 -> (h0,(ty-cx h0 h1 r2.2.1,ty-cx h0 h1 r2.2.2)) ;
  fm-refl G a A h | r -> (r.1,(r.2,(h,h))) ;
  fm-sym G a b A hA h | rA r -> (r.1,(r.2.1,(r.2.2.2,r.2.2.1))) ;
  fm-trans G a b c A h1 h2 | r1 r2 -> (r1.1,(r1.2.1,(r1.2.2.1,r2.2.2.2))) ;
  fm-eqconv G a b A B h1 h2 | r1 r2 -> (r1.1,(r2.2.2,(tm-conv r1.2.2.1 h2,tm-conv r1.2.2.2 h2))) ;
  fm-elam G A A' B B' b b' h0 h1 h2 h3 | r0 r1 r2 r3 ->
    lam-eq-frame r0 h1 h2 h0 r1.2.2 r3.2.1 r2.2.2 r3.2.2.1 r3.2.2.2 ;
  fm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | r0 rB ra r1 r2 r3 r4 ->
    app-eq-frame r0 h1 h2 h4 h0 r1.2.2 hB r2.2.2 r3.2.2.1 r3.2.2.2 ha r4.2.2.2 ;
  fm-epic G n a a' b b' h0 h1 h2 | r0 r1 r2 -> pic-eq-frame n r0.1 r0.2 h1 h0 r1.2.2.2 r2.2.2.1 r2.2.2.2 ;
  fm-elf G m n a a' h le nb | r ->
    (r.1,(ft-uu G n r.1 nb,(fm-lf G m n a r.2.2.1 le nb,fm-lf G m n a' r.2.2.2 le nb))) ;
  fm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 | rA r0 r1 r2 r3 r4 ->
    (r2.1,(ty-sub hA h2,(tm-sub hA h0 h2,
      fm-conv D (fmsb D G A a' s') (ftsb D G A s') (ftsb D G A s)
        (tm-sub hA r1.2.2.2 h3) (ty-sym (sb-same-ty hA h2 h3 h4))))) ;
  fm-beta G A B b a hA hB h1 h2 | rA rB r1 r2 ->
    (rA,(ty-sub hB (sec-sub hA h2),(app-tm hA hB (lam-tm hA hB h1) h2,tm-sub hB h1 (sec-sub hA h2)))) ;
  fm-eta G A B f hA hB h | rA rB r -> eta-frame rA hA hB h ;
  fm-lf-pic G n p a b h1 h2 le nb | r1 r2 -> lift-pic-frame n p r1.1 h1 h2 le nb ;
  fm-lf-uc G m n p h lt le nb ->
    (h,(ft-uu G p h nb,(fm-lf G n p (fuc m n G) (fm-uc G m n h lt (leN-trans n p N (lt-le n p le) nb)) le nb,
      fm-uc G m p h (leN-trans (suc m) n p lt (lt-le n p le)) nb))) ;
  fm-lf-lf G m n p a h le1 le2 nb | r ->
    (r.1,(ft-uu G p r.1 nb,(fm-lf G n p (flf m n G a) (fm-lf G m n a h le1 (leN-trans n p N (lt-le n p le2) nb)) le2 nb,
      fm-lf G m p a h (leN-trans (suc m) n p le1 (lt-le n p le2)) nb))) ;
  fm-sb-id G a A h | r ->
    (r.1,(r.2,(fm-conv G (fmsb G G A a (fid G)) (ftsb G G A (fid G)) A
      (tm-sub r.2 h (id-sub r.1)) (fe-sb-id G A r.2),h))) ;
  fm-sb-comp T D G a A s d h0 h1 h2 | r0 r1 r2 ->
    (r2.1,(ty-sub r0.2 (comp-sub h1 h2),
      (fm-conv T (fmsb T D (ftsb D G A s) (fmsb D G A a s) d) (ftsb T D (ftsb D G A s) d)
        (ftsb T G A (fcomp T D G s d)) (tm-sub (ty-sub r0.2 h1) (tm-sub r0.2 h0 h1) h2) (sb-comp-ty r0.2 h1 h2),
        tm-sub r0.2 h0 (comp-sub h1 h2)))) ;
  fm-lam-sb D G A B b s h1 h2 h3 h4 | r1 r2 r3 r4 -> lam-sub-frame r4.1 h1 h2 h3 h4 ;
  fm-app-sb D G A B c a s h1 h2 h3 h4 h5 | r1 r2 r3 r4 r5 -> app-sub-frame r5.1 h1 h2 h3 h4 h5 ;
  fm-pic-sb D G n a b s h1 h2 h3 | r1 r2 r3 -> pic-sub-frame n r3.1 r1.2 r2.2 h1 h2 h3 ;
  fm-uc-sb D G m n s h lt nb | r ->
    (r.1,(ft-uu D n r.1 nb,(sub-universe n (ft-uu G n r.2 nb) (fm-uc G m n r.2 lt nb) h,fm-uc D m n r.1 lt nb))) ;
  fm-lf-sb D G m n a s h1 h2 le nb | r1 r2 ->
    (r2.1,(ft-uu D n r2.1 nb,(sub-universe n (ft-uu G n r2.2 nb) (fm-lf G m n a h1 le nb) h2,
      fm-lf D m n (fmsb D G (fuu m G) a s) (sub-universe m r1.2 h1 h2) le nb))) ;
  fm-q-lift D G A s h1 h2 | r1 r2 ->
    (ext-wf (ty-sub h1 h2),(ty-sub (ty-sub h1 h2) (p-sub (ty-sub h1 h2)),
      (fm-conv (fext D (ftsb D G A s))
        (fmsb (fext D (ftsb D G A s)) (fext G A) (ftsb (fext G A) G A (fp G A)) (fq G A) (flift D G A s))
        (ftsb (fext D (ftsb D G A s)) (fext G A) (ftsb (fext G A) G A (fp G A)) (flift D G A s))
        (ftsb (fext D (ftsb D G A s)) D (ftsb D G A s) (fp D (ftsb D G A s)))
        (tm-sub (ty-sub h1 (p-sub h1)) (q-tm h1) (lift-sub h1 h2)) (sub-p-lift h1 h2),
       q-tm (ty-sub h1 h2)))) ;
  fm-q-sec G A a h1 h2 | r1 r2 ->
    (r1,(h1,(fm-conv G (fmsb G (fext G A) (ftsb (fext G A) G A (fp G A)) (fq G A) (fsec G A a))
      (ftsb G (fext G A) (ftsb (fext G A) G A (fp G A)) (fsec G A a)) A
      (tm-sub (ty-sub h1 (p-sub h1)) (q-tm h1) (sec-sub h1 h2)) (sub-p-sec r1 h1 h2),h2))) ;
  fm-ecx G D a b A h0 h1 h2 | r0 r1 r2 ->
    (h0,(ty-cx h0 h1 r2.2.1,(tm-cx h0 h1 r2.2.2.1,tm-cx h0 h1 r2.2.2.2))) ;
  fq-refl D s G h | r -> (r.1,(r.2,(h,h))) ;
  fq-sym D s t G h | r -> (r.1,(r.2.1,(r.2.2.2,r.2.2.1))) ;
  fq-trans D s t u G h1 h2 | r1 r2 -> (r1.1,(r1.2.1,(r1.2.2.1,r2.2.2.2))) ;
  fq-comp T D G s s' d d' h1 h2 | r1 r2 ->
    (r2.1,(r1.2.1,(comp-sub r1.2.2.1 r2.2.2.1,comp-sub r1.2.2.2 r2.2.2.2))) ;
  fq-lift D G A A' s s' h0 h1 h2 h3 | r0 r1 r2 r3 -> lift-eq-frame r2.1 r2.2 h0 r1.2.2 h1 h2 r3.2.2.2 h3 ;
  fq-sec G A A' a a' hA ha ha' h1 h2 | rA ra ra' r1 r2 ->
    (rA,(ext-wf hA,(sec-sub hA ha,sec-align rA hA r1.2.2 h1 ha'))) ;
  fq-idl D G s h | r -> (r.1,(r.2,(comp-sub (id-sub r.2) h,h))) ;
  fq-idr D G s h | r -> (r.1,(r.2,(comp-sub h (id-sub r.1),h))) ;
  fq-assoc Q T D G s d e h1 h2 h3 | r1 r2 r3 ->
    (r3.1,(r1.2,(comp-sub (comp-sub h1 h2) h3,comp-sub h1 (comp-sub h2 h3)))) ;
  fq-eps G s h | r -> (r.1,(f-nil,(h,fs-eps G r.1))) ;
  fq-lift-id G A h | r -> lift-id-frame r h ;
  fq-lift-comp T D G A s d h0 h1 h2 | r0 r1 r2 -> lift-comp-frame r2.1 h0 h1 h2 ;
  fq-p-lift D G A s h1 h2 | r1 r2 ->
    (ext-wf (ty-sub h1 h2),(r1,(comp-sub (p-sub h1) (lift-sub h1 h2),comp-sub h2 (p-sub (ty-sub h1 h2))))) ;
  fq-p-sec G A a h1 h2 | r1 r2 -> (r1,(r1,(comp-sub (p-sub h1) (sec-sub h1 h2),id-sub r1))) ;
  fq-sec-comp D G A a s h1 h2 h3 | r1 r2 r3 ->
    (r3.1,(ext-wf h1,(comp-sub (sec-sub h1 h2) h3,comp-sub (lift-sub h1 h3)
      (sec-sub (ty-sub h1 h3) (tm-sub h1 h2 h3))))) ;
  fq-lift-p-sec-q G A h | r ->
    (ext-wf h,(ext-wf h,(comp-sub (lift-sub h (p-sub h)) (sec-sub (ty-sub h (p-sub h)) (q-tm h)),id-sub (ext-wf h)))) ;
  fe-uu-cx G H n e nb | r -> (r.1,(ft-uu G n r.1 nb,ty-cx r.1 r.2.2 (ft-uu H n r.2.1 nb))) ;
  fm-uc-cx G H m n e lt nb | r ->
    (r.1,(ft-uu G n r.1 nb,(fm-uc G m n r.1 lt nb,move-universe n r.1 r.2.2 nb (fm-uc H m n r.2.1 lt nb)))) ;
  fq-id-cx G H e | r -> (r.1,(r.1,(id-sub r.1,sub-cx r.1 r.1 r.2.2 r.2.2 (id-sub r.2.1)))) ;
  fq-eps-cx G H e | r ->
    (r.1,(f-nil,(fs-eps G r.1,fs-cx H G fnil fnil (feps H) r.1 f-nil r.2.2 fc-nil (fs-eps H r.2.1)))) ;
  fq-p-cx G H A B e p | r t -> p-cx-frame r.1 r.2.1 e r.2.2 p t.2.1 t.2.2 ;
  fm-q-cx G H A B e p | r t -> q-cx-frame r.1 r.2.1 e r.2.2 p t.2.1 t.2.2 ;
  fe-pi-context G A B h1 h2 G' e | r1 r2 r -> pi-context-frame e r h1 h2 ;
  fe-el-context G n a h G' e | r1 r -> el-context-frame n e r r1.2 h ;
  fe-sb-source D G A s h1 h2 D' e | r1 r2 r ->
    (r.1,(ty-sub h1 h2,ty-cx r.1 r.2.2 (ty-sub h1 (fs-cx D D' G G s r.2.1 r2.2 e (cx-refl r2.2) h2)))) ;
  fe-sb-target D G A s h1 h2 G' e | r1 r2 r ->
    (r2.1,(ty-sub h1 h2,ty-sub (ft-cx G G' A r.2.1 e h1) (fs-cx D D G G' s r2.1 r.2.1 (cx-refl r2.1) e h2))) ;
  fm-lam-context G A B b h1 h2 h3 G' e | r1 r2 r3 r -> lam-context-frame e r h1 h2 h3 ;
  fm-app-context G A B c a h1 h2 h3 h4 G' e | r1 r2 r3 r4 r -> app-context-frame e r h1 h2 h3 h4 ;
  fm-pic-context G n a b h1 h2 G' e | r1 r2 r -> pic-context-frame n e r r1.2 h1 h2 ;
  fm-lf-context G m n a h le nb G' e | r1 r ->
    (r.1,(ft-uu G n r.1 nb,(fm-lf G m n a h le nb,move-universe n r.1 r.2.2 nb
      (fm-lf G' m n a (move-universe {G} {G'} {a} m r.2.1 e (f-universe-bound G G m r1.2) h) le nb)))) ;
  fm-sb-source D G a A s hA h1 h2 D' e | rA r1 r2 r -> tm-source-frame e r r2.2 hA h1 h2 ;
  fm-sb-target D G a A s hA h1 h2 G' e | rA r1 r2 r -> tm-target-frame e r r2.1 hA h1 h2 ;
  fm-sb-type D G a A s hA h1 h2 A' e | rA r1 r2 r ->
    (r2.1,(ty-sub hA h2,(tm-sub hA h1 h2,
      fm-conv D (fmsb D G A' a s) (ftsb D G A' s) (ftsb D G A s)
        (tm-sub r.2.2 (fm-conv G a A A' h1 e) h2) (ty-sym (sb-same-sub hA e h2))))) ;
  fq-comp-source T D G s d h1 h2 T' e | r1 r2 r ->
    (r.1,(r1.2,(comp-sub h1 h2,sub-cx r.1 r1.2 r.2.2 (cx-refl r1.2)
      (comp-sub h1 (fs-cx T T' D D d r.2.1 r2.2 e (cx-refl r2.2) h2))))) ;
  fq-comp-middle T D G s d h1 h2 D' e | r1 r2 r ->
    (r2.1,(r1.2,(comp-sub h1 h2,comp-sub (fs-cx D D' G G s r.2.1 r1.2 e (cx-refl r1.2) h1)
      (fs-cx T T D D' d r2.1 r.2.1 (cx-refl r2.1) e h2)))) ;
  fq-comp-target T D G s d h1 h2 G' e | r1 r2 r ->
    (r2.1,(r.1,(comp-sub h1 h2,sub-cx r2.1 r.1 (cx-refl r2.1) r.2.2
      (comp-sub (fs-cx D D G G' s r1.1 r.2.1 (cx-refl r1.1) e h1) h2)))) ;
  fq-lift-source D G A s h1 h2 D' e | r1 r2 r -> lift-source-frame e r r1.2 h2 h1 ;
  fq-lift-target D G A s h1 h2 G' e | r1 r2 r -> lift-target-frame e r r1.1 h2 h1 ;
  fq-sec-context G A a h1 h2 G' e | r1 r2 r ->
    (r.1,(ext-wf h1,(sec-sub h1 h2,
      fs-cx G' G (fext G' A) (fext G A) (fsec G' A a) r.1 (ext-wf h1) r.2.2
        (ext-eq r.2.2 (ty-refl (ft-cx G G' A r.2.1 e h1))) (sec-sub (ft-cx G G' A r.2.1 e h1) (fm-cx G G' a A r.2.1 e h2))))) } ;

f-cx-sym (G H : FA) (e : CE G H) : CE H G = (fpresup (fjeqcx G H) e).2.2 ;

f-universe-tm-bound (G a : FA) (n : Nat) (h : Tm' G a (fuu n G)) : LeN n N =
  f-universe-bound G G n (fpresup (fjtm G a (fuu n G)) h).2 ;
