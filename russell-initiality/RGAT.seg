-- RGAT.seg: sterbac4, T_Russell and Ehrhard-GAT T_E, by composing
-- Theorem 28 (T_Russell -> T_Tarski, TSection) with Theorem 20
-- (T_Tarski -> T_E, Thm20), and Lemma 21 (ErR) with Theorem 16 (GSound).
--   r2g-*    every T_Russell judgement J has a T_E judgement over a T_E
--            context whose double erasure |(|-|_T)|_R is J
--   g2r-*    every T_E judgement erases to a T_Russell judgement
--   gu-*     two T_E judgements over the same T_E context with the same
--            double erasure are convertible (types, terms, both kinds of
--            equality judgement); gu-cx1: two T_E contexts with the same
--            double erasure are equal
--   cx-sym, cx-trans   symmetry and transitivity of T_E context equality
--            (by induction on GDer)
level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open TPresup[l] ; open RTyping[l] ; open ErR[l] ; open TUniq[l] ; open TSection[l] ;
open GAT[l] ; open GPresup[l] ; open GSound[l] ; open Ev[l] ; open L18[l] ; open L19[l] ; open Thm20[l] ;

------------------------------------------------------------------------
-- symmetry of context equality in T_E

CxSym : GJ -> U l = split {
  gjwf X -> Top ; gjty G A -> Top ; gjtm G a A -> Top ; gjsub D s G -> Top ;
  gjeqcx G D -> GDer (gjeqcx D G) ;
  gjeqty G A B -> Top ; gjeqtm G a b A -> Top ; gjeqsub D s t G -> Top } ;

cx-sym-J : (J : GJ) -> GDer J -> CxSym J = split {
  g-nil -> tt ;
  g-ext G A h -> tt ;
  gc-nil -> gc-nil ;
  gc-refl G h -> gc-refl G h ;
  gc-ext G D A B h1 h2 | r1 r2 ->
    gc-ext D G B A r1 (ge-cx G D B A (gpresup (gjeqcx G D) h1).2 h1 (ge-sym G A B h2)) ;
  gs-id G h -> tt ;
  gs-comp T D G s d h1 h2 -> tt ;
  gs-eps G h -> tt ;
  gs-p G A h -> tt ;
  gs-lift D G A s h1 h2 -> tt ;
  gs-sec G A a h1 h2 -> tt ;
  gs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  gt-pi G A B h1 h2 -> tt ;
  gt-uu G n h nb -> tt ;
  gt-el G n a h -> tt ;
  gt-sb D G A s h1 h2 -> tt ;
  gt-cx G D A h0 h1 h2 -> tt ;
  gm-lam G A B b h1 h2 h3 -> tt ;
  gm-app G A B c a h1 h2 h3 h4 -> tt ;
  gm-pic G n a b h1 h2 -> tt ;
  gm-uc G m n h lt nb -> tt ;
  gm-lf G m n a h le nb -> tt ;
  gm-q G A h -> tt ;
  gm-sb D G a A s hA h1 h2 -> tt ;
  gm-conv G a A B h1 h2 -> tt ;
  gm-cx G D a A h0 h1 h2 -> tt ;
  ge-refl G A h -> tt ;
  ge-sym G A B h -> tt ;
  ge-trans G A B C h1 h2 -> tt ;
  ge-pi G A A' B B' h0 h1 h2 -> tt ;
  ge-el G n a a' h -> tt ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ge-el-lf G m n a h le nb -> tt ;
  ge-el-pic G n a b h1 h2 -> tt ;
  ge-el-uc G m n h lt nb -> tt ;
  ge-sb-id G A h -> tt ;
  ge-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ge-pi-sb D G A B s h1 h2 h3 -> tt ;
  ge-uu-sb D G n s h nb -> tt ;
  ge-el-sb D G n a s h1 h2 -> tt ;
  ge-cx G D A B h0 h1 h2 -> tt ;
  gm-refl G a A h -> tt ;
  gm-sym G a b A hA h -> tt ;
  gm-trans G a b c A h1 h2 -> tt ;
  gm-eqconv G a b A B h1 h2 -> tt ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  gm-epic G n a a' b b' h0 h1 h2 -> tt ;
  gm-elf G m n a a' h le nb -> tt ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  gm-beta G A B b a hA hB h1 h2 -> tt ;
  gm-eta G A B f hA hB h -> tt ;
  gm-lf-pic G n p a b h1 h2 le nb -> tt ;
  gm-lf-uc G m n p h lt le nb -> tt ;
  gm-lf-lf G m n p a h le1 le2 nb -> tt ;
  gm-sb-id G a A h -> tt ;
  gm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  gm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  gm-uc-sb D G m n s h lt nb -> tt ;
  gm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  gm-q-lift D G A s h1 h2 -> tt ;
  gm-q-sec G A a h1 h2 -> tt ;
  gm-ecx G D a b A h0 h1 h2 -> tt ;
  gq-refl D s G h -> tt ;
  gq-sym D s t G h -> tt ;
  gq-trans D s t u G h1 h2 -> tt ;
  gq-comp T D G s s' d d' h1 h2 -> tt ;
  gq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  gq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  gq-idl D G s h -> tt ;
  gq-idr D G s h -> tt ;
  gq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  gq-eps G s h -> tt ;
  gq-lift-id G A h -> tt ;
  gq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  gq-p-lift D G A s h1 h2 -> tt ;
  gq-p-sec G A a h1 h2 -> tt ;
  gq-sec-comp D G A a s h1 h2 h3 -> tt ;
  gq-lift-p-sec-q G A h -> tt } ;

cx-sym (G D : GE) (h : GDer (gjeqcx G D)) : GDer (gjeqcx D G) = cx-sym-J (gjeqcx G D) h ;

------------------------------------------------------------------------
-- transitivity of context equality in T_E
-- (induction on the first derivation, inversion of the second; only
--  gc-nil, gc-refl and gc-ext conclude a context equality)

-- the continuation for a second equation  |- D.B = E
TrK (G A D B E : GE) : U l =
  GDer (gjeqcx G D) -> GDer (gjeqty G A B) -> ((E' : GE) -> GDer (gjeqcx D E') -> GDer (gjeqcx G E')) ->
  GDer (gjeqcx (gext G A) E) ;

TrM (E : GE) : GE -> U l = split {
  gnil -> Top ;
  gext D B -> (G A : GE) -> TrK G A D B E ;
  gpi A B -> Top ;
  guu n -> Top ;
  gel n a -> Top ;
  gsb t s -> Top ;
  glam A B b -> Top ;
  gapp A B c a -> Top ;
  gpic n a b -> Top ;
  guc m n -> Top ;
  glf m n a -> Top ;
  gq -> Top ;
  gid -> Top ;
  gcomp s d -> Top ;
  geps -> Top ;
  gp -> Top ;
  glift A s -> Top ;
  gsec A a -> Top} ;

tr-refl (E : GE) : (X : GE) -> Id GE X E -> TrM E X = split {
  gnil -> \ p -> tt ;
  gext D B -> \ p G A h1 h2 r -> subst GE (\ Y -> GDer (gjeqcx (gext G A) Y)) (gext D B) E p (gc-ext G D A B h1 h2) ;
  gpi A B -> \ p -> tt ;
  guu n -> \ p -> tt ;
  gel n a -> \ p -> tt ;
  gsb t s -> \ p -> tt ;
  glam A B b -> \ p -> tt ;
  gapp A B c a -> \ p -> tt ;
  gpic n a b -> \ p -> tt ;
  guc m n -> \ p -> tt ;
  glf m n a -> \ p -> tt ;
  gq -> \ p -> tt ;
  gid -> \ p -> tt ;
  gcomp s d -> \ p -> tt ;
  geps -> \ p -> tt ;
  gp -> \ p -> tt ;
  glift A s -> \ p -> tt ;
  gsec A a -> \ p -> tt} ;

TrInv : GJ -> U l = split {
  gjwf X -> Top ; gjty G A -> Top ; gjtm G a A -> Top ; gjsub D s G -> Top ;
  gjeqcx X E -> TrM E X ;
  gjeqty G A B -> Top ; gjeqtm G a b A -> Top ; gjeqsub D s t G -> Top } ;

tr-inv : (J : GJ) -> GDer J -> TrInv J = split {
  g-nil -> tt ;
  g-ext G A h -> tt ;
  gc-nil -> tt ;
  gc-refl X h -> tr-refl X X (refl X) ;
  gc-ext D E A B h1 h2 -> \ G A0 k1 k2 r ->
    gc-ext G E A0 B (r E h1) (ge-trans G A0 A B k2 (ge-cx D G A B (gpresup (gjeqcx G D) k1).1 (cx-sym G D k1) h2)) ;
  gs-id G h -> tt ;
  gs-comp T D G s d h1 h2 -> tt ;
  gs-eps G h -> tt ;
  gs-p G A h -> tt ;
  gs-lift D G A s h1 h2 -> tt ;
  gs-sec G A a h1 h2 -> tt ;
  gs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  gt-pi G A B h1 h2 -> tt ;
  gt-uu G n h nb -> tt ;
  gt-el G n a h -> tt ;
  gt-sb D G A s h1 h2 -> tt ;
  gt-cx G D A h0 h1 h2 -> tt ;
  gm-lam G A B b h1 h2 h3 -> tt ;
  gm-app G A B c a h1 h2 h3 h4 -> tt ;
  gm-pic G n a b h1 h2 -> tt ;
  gm-uc G m n h lt nb -> tt ;
  gm-lf G m n a h le nb -> tt ;
  gm-q G A h -> tt ;
  gm-sb D G a A s hA h1 h2 -> tt ;
  gm-conv G a A B h1 h2 -> tt ;
  gm-cx G D a A h0 h1 h2 -> tt ;
  ge-refl G A h -> tt ;
  ge-sym G A B h -> tt ;
  ge-trans G A B C h1 h2 -> tt ;
  ge-pi G A A' B B' h0 h1 h2 -> tt ;
  ge-el G n a a' h -> tt ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ge-el-lf G m n a h le nb -> tt ;
  ge-el-pic G n a b h1 h2 -> tt ;
  ge-el-uc G m n h lt nb -> tt ;
  ge-sb-id G A h -> tt ;
  ge-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ge-pi-sb D G A B s h1 h2 h3 -> tt ;
  ge-uu-sb D G n s h nb -> tt ;
  ge-el-sb D G n a s h1 h2 -> tt ;
  ge-cx G D A B h0 h1 h2 -> tt ;
  gm-refl G a A h -> tt ;
  gm-sym G a b A hA h -> tt ;
  gm-trans G a b c A h1 h2 -> tt ;
  gm-eqconv G a b A B h1 h2 -> tt ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  gm-epic G n a a' b b' h0 h1 h2 -> tt ;
  gm-elf G m n a a' h le nb -> tt ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  gm-beta G A B b a hA hB h1 h2 -> tt ;
  gm-eta G A B f hA hB h -> tt ;
  gm-lf-pic G n p a b h1 h2 le nb -> tt ;
  gm-lf-uc G m n p h lt le nb -> tt ;
  gm-lf-lf G m n p a h le1 le2 nb -> tt ;
  gm-sb-id G a A h -> tt ;
  gm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  gm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  gm-uc-sb D G m n s h lt nb -> tt ;
  gm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  gm-q-lift D G A s h1 h2 -> tt ;
  gm-q-sec G A a h1 h2 -> tt ;
  gm-ecx G D a b A h0 h1 h2 -> tt ;
  gq-refl D s G h -> tt ;
  gq-sym D s t G h -> tt ;
  gq-trans D s t u G h1 h2 -> tt ;
  gq-comp T D G s s' d d' h1 h2 -> tt ;
  gq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  gq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  gq-idl D G s h -> tt ;
  gq-idr D G s h -> tt ;
  gq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  gq-eps G s h -> tt ;
  gq-lift-id G A h -> tt ;
  gq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  gq-p-lift D G A s h1 h2 -> tt ;
  gq-p-sec G A a h1 h2 -> tt ;
  gq-sec-comp D G A a s h1 h2 h3 -> tt ;
  gq-lift-p-sec-q G A h -> tt } ;

TrC : GJ -> U l = split {
  gjwf X -> Top ; gjty G A -> Top ; gjtm G a A -> Top ; gjsub D s G -> Top ;
  gjeqcx G D -> (E : GE) -> GDer (gjeqcx D E) -> GDer (gjeqcx G E) ;
  gjeqty G A B -> Top ; gjeqtm G a b A -> Top ; gjeqsub D s t G -> Top } ;

cx-trans-J : (J : GJ) -> GDer J -> TrC J = split {
  g-nil -> tt ;
  g-ext G A h -> tt ;
  gc-nil -> \ E k -> k ;
  gc-refl G h -> \ E k -> k ;
  gc-ext G D A B h1 h2 | r1 r2 -> \ E k -> tr-inv (gjeqcx (gext D B) E) k G A h1 h2 r1 ;
  gs-id G h -> tt ;
  gs-comp T D G s d h1 h2 -> tt ;
  gs-eps G h -> tt ;
  gs-p G A h -> tt ;
  gs-lift D G A s h1 h2 -> tt ;
  gs-sec G A a h1 h2 -> tt ;
  gs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  gt-pi G A B h1 h2 -> tt ;
  gt-uu G n h nb -> tt ;
  gt-el G n a h -> tt ;
  gt-sb D G A s h1 h2 -> tt ;
  gt-cx G D A h0 h1 h2 -> tt ;
  gm-lam G A B b h1 h2 h3 -> tt ;
  gm-app G A B c a h1 h2 h3 h4 -> tt ;
  gm-pic G n a b h1 h2 -> tt ;
  gm-uc G m n h lt nb -> tt ;
  gm-lf G m n a h le nb -> tt ;
  gm-q G A h -> tt ;
  gm-sb D G a A s hA h1 h2 -> tt ;
  gm-conv G a A B h1 h2 -> tt ;
  gm-cx G D a A h0 h1 h2 -> tt ;
  ge-refl G A h -> tt ;
  ge-sym G A B h -> tt ;
  ge-trans G A B C h1 h2 -> tt ;
  ge-pi G A A' B B' h0 h1 h2 -> tt ;
  ge-el G n a a' h -> tt ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ge-el-lf G m n a h le nb -> tt ;
  ge-el-pic G n a b h1 h2 -> tt ;
  ge-el-uc G m n h lt nb -> tt ;
  ge-sb-id G A h -> tt ;
  ge-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ge-pi-sb D G A B s h1 h2 h3 -> tt ;
  ge-uu-sb D G n s h nb -> tt ;
  ge-el-sb D G n a s h1 h2 -> tt ;
  ge-cx G D A B h0 h1 h2 -> tt ;
  gm-refl G a A h -> tt ;
  gm-sym G a b A hA h -> tt ;
  gm-trans G a b c A h1 h2 -> tt ;
  gm-eqconv G a b A B h1 h2 -> tt ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  gm-epic G n a a' b b' h0 h1 h2 -> tt ;
  gm-elf G m n a a' h le nb -> tt ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  gm-beta G A B b a hA hB h1 h2 -> tt ;
  gm-eta G A B f hA hB h -> tt ;
  gm-lf-pic G n p a b h1 h2 le nb -> tt ;
  gm-lf-uc G m n p h lt le nb -> tt ;
  gm-lf-lf G m n p a h le1 le2 nb -> tt ;
  gm-sb-id G a A h -> tt ;
  gm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  gm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  gm-uc-sb D G m n s h lt nb -> tt ;
  gm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  gm-q-lift D G A s h1 h2 -> tt ;
  gm-q-sec G A a h1 h2 -> tt ;
  gm-ecx G D a b A h0 h1 h2 -> tt ;
  gq-refl D s G h -> tt ;
  gq-sym D s t G h -> tt ;
  gq-trans D s t u G h1 h2 -> tt ;
  gq-comp T D G s s' d d' h1 h2 -> tt ;
  gq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  gq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  gq-idl D G s h -> tt ;
  gq-idr D G s h -> tt ;
  gq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  gq-eps G s h -> tt ;
  gq-lift-id G A h -> tt ;
  gq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  gq-p-lift D G A s h1 h2 -> tt ;
  gq-p-sec G A a h1 h2 -> tt ;
  gq-sec-comp D G A a s h1 h2 h3 -> tt ;
  gq-lift-p-sec-q G A h -> tt } ;

cx-trans (G D E : GE) (h1 : GDer (gjeqcx G D)) (h2 : GDer (gjeqcx D E)) : GDer (gjeqcx G E) =
  cx-trans-J (gjeqcx G D) h1 E h2 ;

------------------------------------------------------------------------
-- double erasure  T_E -> T_Tarski -> T_Russell

dC (G : GE) : Cx = erC (ec G) ;
dT (A : GE) : Tm = er (et A) ;

eqC (D G : Cx) (e : Id Cx (erC D) G) : Id Cx (dC (ceilC D)) G =
  trans Cx (erC (ec (ceilC D))) (erC D) G (ap Cx Cx erC (ec (ceilC D)) D (er-ceilC D)) e ;
eqT (T A : Tm) (e : Id Tm (er T) A) : Id Tm (dT (ceil T)) A =
  trans Tm (er (et (ceil T))) (er T) A (ap Tm Tm er (et (ceil T)) T (er-ceil T)) e ;

------------------------------------------------------------------------
-- existence: T_Russell -> T_E  (Theorem 28, then Theorem 20)

GWf (G : Cx) : U l = (X : GE) * (GDer (gjwf X) * Id Cx (dC X) G) ;
GTy (G : Cx) (A : Tm) : U l = (X : GE) * ((Y : GE) * (GDer (gjty X Y) * (Id Cx (dC X) G * Id Tm (dT Y) A))) ;
GTm (G : Cx) (a A : Tm) : U l = (X : GE) * ((y : GE) * ((Y : GE) *
  (GDer (gjtm X y Y) * (Id Cx (dC X) G * (Id Tm (dT y) a * Id Tm (dT Y) A))))) ;
GEqTy (G : Cx) (A B : Tm) : U l = (X : GE) * ((Y : GE) * ((Z : GE) *
  (GDer (gjeqty X Y Z) * (Id Cx (dC X) G * (Id Tm (dT Y) A * Id Tm (dT Z) B))))) ;
GEqTm (G : Cx) (a b A : Tm) : U l = (X : GE) * ((y : GE) * ((z : GE) * ((Y : GE) *
  (GDer (gjeqtm X y z Y) * (Id Cx (dC X) G * (Id Tm (dT y) a * (Id Tm (dT z) b * Id Tm (dT Y) A))))))) ;

r2g-wf' (G : Cx) (c : LCx[G]) : GWf G = (ceilC c.D, (lift-wf c.D c.wD, eqC c.D G c.eD)) ;
r2g-ty' (G : Cx) (A : Tm) (c : LCx[G]) (t : LTy[c.D, A]) : GTy G A =
  (ceilC c.D, (ceil t.T, ((section-ty c.D t.T t.dT).1, (eqC c.D G c.eD, eqT t.T A t.eT)))) ;
r2g-tm' (G : Cx) (a A : Tm) (c : LCx[G]) (t : LTm[c.D, a, A]) : GTm G a A =
  (ceilC c.D, (ceil t.t, (ceil t.T, ((section-tm c.D t.t t.T t.dt).1,
    (eqC c.D G c.eD, (eqT t.t a t.et, eqT t.T A t.eT)))))) ;
r2g-eqty' (G : Cx) (A B : Tm) (c : LCx[G]) (q : LEqTy[c.D, A, B]) : GEqTy G A B =
  (ceilC c.D, (ceil q.T, (ceil q.S, (section-eqty c.D q.T q.S q.d,
    (eqC c.D G c.eD, (eqT q.T A q.eT, eqT q.S B q.eS)))))) ;
r2g-eqtm' (G : Cx) (a b A : Tm) (c : LCx[G]) (p : LEqTm[c.D, a, b, A]) : GEqTm G a b A =
  (ceilC c.D, (ceil p.t, (ceil p.s, (ceil p.T, (section-eqtm c.D p.t p.s p.T p.d,
    (eqC c.D G c.eD, (eqT p.t a p.et, (eqT p.s b p.es, eqT p.T A p.eT)))))))) ;

r2g-tyS (G : Cx) (A : Tm) (s : SecJ (jty G A)) : GTy G A = r2g-ty' G A s.1 (s.2 s.1.D (okw s.1.D s.1.wD) s.1.eD) ;
r2g-tmS (G : Cx) (a A : Tm) (s : SecJ (jtm G a A)) : GTm G a A = r2g-tm' G a A s.1 (s.2 s.1.D (okw s.1.D s.1.wD) s.1.eD) ;
r2g-eqtyS (G : Cx) (A B : Tm) (s : SecJ (jeqty G A B)) : GEqTy G A B =
  r2g-eqty' G A B s.1 (s.2 s.1.D (okw s.1.D s.1.wD) s.1.eD) ;
r2g-eqtmS (G : Cx) (a b A : Tm) (s : SecJ (jeqtm G a b A)) : GEqTm G a b A =
  r2g-eqtm' G a b A s.1 (s.2 s.1.D (okw s.1.D s.1.wD) s.1.eD) ;

r2g-wf (G : Cx) (h : RDer (jwf G)) : GWf G = r2g-wf' G (sec (jwf G) h).1 ;
r2g-ty (G : Cx) (A : Tm) (h : RDer (jty G A)) : GTy G A = r2g-tyS G A (sec (jty G A) h) ;
r2g-tm (G : Cx) (a A : Tm) (h : RDer (jtm G a A)) : GTm G a A = r2g-tmS G a A (sec (jtm G a A) h) ;
r2g-eqty (G : Cx) (A B : Tm) (h : RDer (jeqty G A B)) : GEqTy G A B = r2g-eqtyS G A B (sec (jeqty G A B) h) ;
r2g-eqtm (G : Cx) (a b A : Tm) (h : RDer (jeqtm G a b A)) : GEqTm G a b A = r2g-eqtmS G a b A (sec (jeqtm G a b A) h) ;

------------------------------------------------------------------------
-- converse: T_E -> T_Russell  (Theorem 16, then Lemma 21)

g2r-wf (G : GE) (h : GDer (gjwf G)) : RDer (jwf (dC G)) = er-der (jwf (ec G)) (wfc G (sound (gjwf G) h)) ;
g2r-ty (G A : GE) (h : GDer (gjty G A)) : RDer (jty (dC G) (dT A)) = er-der (jty (ec G) (et A)) (sound-ty G A h) ;
g2r-tm (G a A : GE) (h : GDer (gjtm G a A)) : RDer (jtm (dC G) (dT a) (dT A)) =
  er-der (jtm (ec G) (et a) (et A)) (sound-tm G a A h) ;
g2r-eqty (G A B : GE) (h : GDer (gjeqty G A B)) : RDer (jeqty (dC G) (dT A) (dT B)) =
  er-der (jeqty (ec G) (et A) (et B)) (sound-eqty G A B h) ;
g2r-eqtm (G a b A : GE) (h : GDer (gjeqtm G a b A)) : RDer (jeqtm (dC G) (dT a) (dT b) (dT A)) =
  er-der (jeqtm (ec G) (et a) (et b) (et A)) (sound-eqtm G a b A h) ;

------------------------------------------------------------------------
-- uniqueness: same T_E context, same double erasure => convertible
-- (Lemma 25.1 / Corollary 27 in T_Tarski, lifted by Theorem 20 and
--  moved back along  ceil |G| = G  by Lemma 19)

-- a T_Tarski equation over |G| gives one over G between the lifts
up-eqty (G : GE) (w : GDer (gjwf G)) (T S : Tm) (q : Der (jeqty (ec G) T S)) : GDer (gjeqty G (ceil T) (ceil S)) =
  ge-cx (ceilC (ec G)) G (ceil T) (ceil S) w (cx-sym G (ceilC (ec G)) (unique-cx G w)) (section-eqty (ec G) T S q) ;
up-eqtm (G : GE) (w : GDer (gjwf G)) (t s T : Tm) (q : Der (jeqtm (ec G) t s T)) :
    GDer (gjeqtm G (ceil t) (ceil s) (ceil T)) =
  gm-ecx (ceilC (ec G)) G (ceil t) (ceil s) (ceil T) w (cx-sym G (ceilC (ec G)) (unique-cx G w))
    (section-eqtm (ec G) t s T q) ;

gu-ty (G A1 A2 : GE) (h1 : GDer (gjty G A1)) (h2 : GDer (gjty G A2)) (e : Id Tm (dT A1) (dT A2)) :
    GDer (gjeqty G A1 A2) =
  ge-trans G A1 (ceil (et A1)) A2 (lemma19 (gjty G A1) h1).2
    (ge-trans G (ceil (et A1)) (ceil (et A2)) A2
       (up-eqty G (gpresup (gjty G A1) h1) (et A1) (et A2)
          (ty-uniq (ec G) (et A1) (et A2) (sound-ty G A1 h1) (sound-ty G A2 h2) e))
       (ge-sym G A2 (ceil (et A2)) (lemma19 (gjty G A2) h2).2)) ;

gu-tm' (G a1 A1 a2 A2 : GE) (h1 : GDer (gjtm G a1 A1)) (h2 : GDer (gjtm G a2 A2))
    (hA1 : GDer (gjty G A1)) (eA : GDer (gjeqty G A1 A2))
    (p : Der (jeqtm (ec G) (et a1) (et a2) (et A1))) : GDer (gjeqtm G a1 a2 A1) =
  gm-trans G a1 (ceil (et a1)) a2 A1 (lemma19 (gjtm G a1 A1) h1).2
    (gm-trans G (ceil (et a1)) (ceil (et a2)) a2 A1
       (gm-eqconv G (ceil (et a1)) (ceil (et a2)) (ceil (et A1)) A1
          (up-eqtm G (gpresup (gjtm G a1 A1) h1).1 (et a1) (et a2) (et A1) p)
          (ge-sym G A1 (ceil (et A1)) (lemma19 (gjty G A1) hA1).2))
       (gm-sym G a2 (ceil (et a2)) A1 hA1
          (gm-eqconv G a2 (ceil (et a2)) A2 A1 (lemma19 (gjtm G a2 A2) h2).2 (ge-sym G A1 A2 eA)))) ;

gu-tm (G a1 A1 a2 A2 : GE) (h1 : GDer (gjtm G a1 A1)) (h2 : GDer (gjtm G a2 A2))
    (ea : Id Tm (dT a1) (dT a2)) (eA : Id Tm (dT A1) (dT A2)) :
    GDer (gjeqty G A1 A2) * GDer (gjeqtm G a1 a2 A1) =
  (gu-ty G A1 A2 (gpresup (gjtm G a1 A1) h1).2 (gpresup (gjtm G a2 A2) h2).2 eA,
   gu-tm' G a1 A1 a2 A2 h1 h2 (gpresup (gjtm G a1 A1) h1).2
     (gu-ty G A1 A2 (gpresup (gjtm G a1 A1) h1).2 (gpresup (gjtm G a2 A2) h2).2 eA)
     (er-inj (ec G) (et a1) (et a2) (et A1) (et A2) (sound-tm G a1 A1 h1) (sound-tm G a2 A2 h2) ea eA).2) ;

-- contexts: T_Tarski context equality lifts along ceil, so two T_E contexts
-- with the same double erasure are linked by the chain
--   G1 = ceil |G1| = ceil |G2| = G2   (each step a T_E context equality)
cxeq-up : (G D : Cx) -> CxEq G D -> GDer (gjeqcx (ceilC G) (ceilC D)) = split {
  cnil -> split { cnil -> \ e -> gc-nil ; csnoc D B -> \ e -> efq e } ;
  csnoc G A | r -> split {
    cnil -> \ e -> efq e ;
    csnoc D B -> \ e -> gc-ext (ceilC G) (ceilC D) (ceil A) (ceil B) (r D e.1) (section-eqty G A B e.2) } } ;

gu-cx (G1 G2 : GE) (w1 : GDer (gjwf G1)) (w2 : GDer (gjwf G2)) (e : Id Cx (dC G1) (dC G2)) :
    GDer (gjeqcx G1 (ceilC (ec G1))) * (GDer (gjeqcx (ceilC (ec G1)) (ceilC (ec G2))) * GDer (gjeqcx (ceilC (ec G2)) G2)) =
  (unique-cx G1 w1,
   (cxeq-up (ec G1) (ec G2) (cxer (ec G1) (ec G2) (sound (gjwf G1) w1) (sound (gjwf G2) w2) e),
    cx-sym G2 (ceilC (ec G2)) (unique-cx G2 w2))) ;

-- the same, as one equation
gu-cx1 (G1 G2 : GE) (w1 : GDer (gjwf G1)) (w2 : GDer (gjwf G2)) (e : Id Cx (dC G1) (dC G2)) : GDer (gjeqcx G1 G2) =
  cx-trans G1 (ceilC (ec G1)) G2 (gu-cx G1 G2 w1 w2 e).1
    (cx-trans (ceilC (ec G1)) (ceilC (ec G2)) G2 (gu-cx G1 G2 w1 w2 e).2.1 (gu-cx G1 G2 w1 w2 e).2.2) ;

-- equality judgements: their sides are convertible
gu-eqty (G A1 B1 A2 B2 : GE) (h1 : GDer (gjeqty G A1 B1)) (h2 : GDer (gjeqty G A2 B2))
    (eA : Id Tm (dT A1) (dT A2)) (eB : Id Tm (dT B1) (dT B2)) :
    GDer (gjeqty G A1 A2) * GDer (gjeqty G B1 B2) =
  (gu-ty G A1 A2 (gpresup (gjeqty G A1 B1) h1).2.1 (gpresup (gjeqty G A2 B2) h2).2.1 eA,
   gu-ty G B1 B2 (gpresup (gjeqty G A1 B1) h1).2.2 (gpresup (gjeqty G A2 B2) h2).2.2 eB) ;

gu-eqtm (G a1 b1 A1 a2 b2 A2 : GE) (h1 : GDer (gjeqtm G a1 b1 A1)) (h2 : GDer (gjeqtm G a2 b2 A2))
    (ea : Id Tm (dT a1) (dT a2)) (eb : Id Tm (dT b1) (dT b2)) (eA : Id Tm (dT A1) (dT A2)) :
    GDer (gjeqty G A1 A2) * (GDer (gjeqtm G a1 a2 A1) * GDer (gjeqtm G b1 b2 A1)) =
  ((gu-tm G a1 A1 a2 A2 (gpresup (gjeqtm G a1 b1 A1) h1).2.2.1 (gpresup (gjeqtm G a2 b2 A2) h2).2.2.1 ea eA).1,
   ((gu-tm G a1 A1 a2 A2 (gpresup (gjeqtm G a1 b1 A1) h1).2.2.1 (gpresup (gjeqtm G a2 b2 A2) h2).2.2.1 ea eA).2,
    (gu-tm G b1 A1 b2 A2 (gpresup (gjeqtm G a1 b1 A1) h1).2.2.2 (gpresup (gjeqtm G a2 b2 A2) h2).2.2.2 eb eA).2)) ;
