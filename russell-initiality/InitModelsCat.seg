-- InitModelsCat: the precategory of Ehrhard models of level N (at
-- universe level l), as an instance of Category.Precategory (PLAN-INIT,
-- Part C).  Segment of InitHomS.ModelsCat (l, N, fe).
--   objects   TEModel[N]
--   arrows    morphisms in Sigma form (InitHomSig.HomS), a set (set-HomS)
--   identity  toS of the identity morphism (InitHomId.idHom)
--   compose   compS (InitHomComp); laws from InitHomCat
-- comp x y z g f is "f then g", as in Category.seg.
open Base ;
module K = Category[l+,l] ;
module EM = EhrhardTEModel[l] ;

pre : K.Precategory = new K.Precategory[
  ob := EM.TEModel[N],
  hom := \ x y -> MorphismS[l,N,x,y,fe].InitHomSig.HomS,
  hom-set := \ x y -> MorphismS[l,N,x,y,fe].InitHomExt.set-HomS,
  idn := \ x -> MorphismS[l,N,x,x,fe].InitHomSig.toS InitHomIdentity.Identity[l,N,x].InitHomId.idHom,
  comp := \ x y z g f -> Composition[l,N,x,y,z,fe].InitHomComp.compS f g,
  unit-l := \ x y f -> CatLaws[l,N,x,y,y,y,fe].InitHomCat.right-unit f,
  unit-r := \ x y f -> CatLaws[l,N,x,y,y,y,fe].InitHomCat.left-unit f,
  assoc := \ w x y z f g h -> CatLaws[l,N,w,x,y,z,fe].InitHomCat.assoc f g h] ;

-- an initial object: exactly one arrow to every object
isContr (A : U l) : U l = (c : A) * ((x : A) -> Id A c x) ;
isInitial (I : pre.ob) : U l+ = (X : pre.ob) -> isContr (pre.hom I X) ;
