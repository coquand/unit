-- Judgement abbreviations and typed constructors used in the proof ports.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ;

W (G : FA) : U l = FADer (fjwf G) ;
Ty (G A : FA) : U l = FADer (fjty G A) ;
Tm' (G a A : FA) : U l = FADer (fjtm G a A) ;
Sb (D s G : FA) : U l = FADer (fjsub D s G) ;
CE (G H : FA) : U l = FADer (fjeqcx G H) ;
TE (G A B : FA) : U l = FADer (fjeqty G A B) ;
ME (G a b A : FA) : U l = FADer (fjeqtm G a b A) ;
SE (D s t G : FA) : U l = FADer (fjeqsub D s t G) ;

ext-wf {G A : FA} (h : Ty G A) : W (fext G A) = f-ext G A h ;
ext-eq {G H A B : FA} (e : CE G H) (t : TE G A B) : CE (fext G A) (fext H B) =
  fc-ext G H A B e t ;
cx-refl {G : FA} (w : W G) : CE G G = fc-refl G w ;
ty-refl {G A : FA} (h : Ty G A) : TE G A A = fe-refl G A h ;
ty-sym {G A B : FA} (e : TE G A B) : TE G B A = fe-sym G A B e ;
ty-trans {G A B C : FA} (p : TE G A B) (q : TE G B C) : TE G A C = fe-trans G A B C p q ;
ty-cx {G H A : FA} (w : W H) (e : CE G H) (h : Ty G A) : Ty H A = ft-cx G H A w e h ;
tm-cx {G H a A : FA} (w : W H) (e : CE G H) (h : Tm' G a A) : Tm' H a A =
  fm-cx G H a A w e h ;
te-cx {G H A B : FA} (w : W H) (e : CE G H) (h : TE G A B) : TE H A B =
  fe-cx G H A B w e h ;
sub-cx {D E s G H : FA} (wD : W E) (wG : W H) (eD : CE D E) (eG : CE G H) (h : Sb D s G) : Sb E s H =
  fs-cx D E G H s wD wG eD eG h ;

ty-sub {D G A s : FA} (hA : Ty G A) (hs : Sb D s G) : Ty D (ftsb D G A s) =
  ft-sb D G A s hA hs ;
tm-sub {D G a A s : FA} (hA : Ty G A) (ha : Tm' G a A) (hs : Sb D s G) : Tm' D (fmsb D G A a s) (ftsb D G A s) =
  fm-sb D G a A s hA ha hs ;
tm-conv {G a A B : FA} (ha : Tm' G a A) (e : TE G A B) : Tm' G a B =
  fm-conv G a A B ha e ;
id-sub {G : FA} (w : W G) : Sb G (fid G) G = fs-id G w ;
p-sub {G A : FA} (hA : Ty G A) : Sb (fext G A) (fp G A) G = fs-p G A hA ;
q-tm {G A : FA} (hA : Ty G A) : Tm' (fext G A) (fq G A) (ftsb (fext G A) G A (fp G A)) =
  fm-q G A hA ;
comp-sub {T D G s d : FA} (hs : Sb D s G) (hd : Sb T d D) : Sb T (fcomp T D G s d) G =
  fs-comp T D G s d hs hd ;
lift-sub {D G A s : FA} (hA : Ty G A) (hs : Sb D s G) : Sb (fext D (ftsb D G A s)) (flift D G A s) (fext G A) =
  fs-lift D G A s hs hA ;
sec-sub {G A a : FA} (hA : Ty G A) (ha : Tm' G a A) : Sb G (fsec G A a) (fext G A) =
  fs-sec G A a hA ha ;

pi-ty {G A B : FA} (hA : Ty G A) (hB : Ty (fext G A) B) : Ty G (fpi G A B) =
  ft-pi G A B hA hB ;
lam-tm {G A B b : FA} (hA : Ty G A) (hB : Ty (fext G A) B) (hb : Tm' (fext G A) b B) :
    Tm' G (flam G A B b) (fpi G A B) = fm-lam G A B b hA hB hb ;
app-tm {G A B c a : FA} (hA : Ty G A) (hB : Ty (fext G A) B) (hc : Tm' G c (fpi G A B))
    (ha : Tm' G a A) : Tm' G (fapp G A B c a) (ftsb G (fext G A) B (fsec G A a)) =
  fm-app G A B c a hA hB hc ha ;

sb-ty-cong {D G A B s t : FA} (hA : Ty G A) (eA : TE G A B) (hs : Sb D s G) (ht : Sb D t G)
    (e : SE D s t G) : TE D (ftsb D G A s) (ftsb D G B t) =
  fe-sb D G A B s t hA eA hs ht e ;
sb-same-sub {D G A B s : FA} (hA : Ty G A) (e : TE G A B) (hs : Sb D s G) :
    TE D (ftsb D G A s) (ftsb D G B s) =
  sb-ty-cong hA e hs hs (fq-refl D s G hs) ;
sb-same-ty {D G A s t : FA} (hA : Ty G A) (hs : Sb D s G) (ht : Sb D t G) (e : SE D s t G) :
    TE D (ftsb D G A s) (ftsb D G A t) =
  sb-ty-cong hA (ty-refl hA) hs ht e ;
sb-comp-ty {T D G A s d : FA} (hA : Ty G A) (hs : Sb D s G) (hd : Sb T d D) :
    TE T (ftsb T D (ftsb D G A s) d) (ftsb T G A (fcomp T D G s d)) =
  fe-sb-comp T D G A s d hA hs hd ;

FPJ : FAJ -> U l = split {
  fjwf G -> Top ;
  fjty G A -> W G ;
  fjtm G a A -> W G * Ty G A ;
  fjsub D s G -> W D * W G ;
  fjeqcx G H -> W G * (W H * CE H G) ;
  fjeqty G A B -> W G * (Ty G A * Ty G B) ;
  fjeqtm G a b A -> W G * (Ty G A * (Tm' G a A * Tm' G b A)) ;
  fjeqsub D s t G -> W D * (W G * (Sb D s G * Sb D t G)) } ;
