-- InitHomExt: extensionality of morphisms in Sigma form (PLAN-INIT,
-- Part C).  Segment of InitHomS.MorphismS (l, N, M, M', fe), after
-- InitHomSig.
--   prop-Laws  : the laws of a datum form a proposition (every law is a
--                Pi of paths in a set of M')
--   data-ext   : pointwise agreement (in the total spaces of M') of two
--                data gives a path of data
--   hom-ext    : Agree (fromS h) (fromS h') -> Id HomS h h'
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
module Mo = InitHom.Morphism[l,N,M,M'] ;
open Mo.InitHomBase ;
open Mo.InitHomLaws ;
module FE = Axioms[l].FunExtLemmas[fe] ;
open InitHomSig ;

pp (A : U l) (B : A -> U l) (pB : (x : A) -> isProp (B x)) : isProp ((x : A) -> B x) =
  FE.isProp-Pi A B pB ;

------------------------------------------------------------------------
-- Pi over the telescopes of the laws

piG (F : C.Ctx -> U l) (h : (G : C.Ctx) -> isProp (F G)) : isProp ((G : C.Ctx) -> F G) =
  pp C.Ctx F h ;

piGA (F : (G : C.Ctx) -> C.Ty G -> U l) (h : (G : C.Ctx) (A : C.Ty G) -> isProp (F G A))
  : isProp ((G : C.Ctx) (A : C.Ty G) -> F G A) =
  pp C.Ctx (\ G -> (A : C.Ty G) -> F G A) (\ G -> pp (C.Ty G) (F G) (h G)) ;

piGAa (F : (G : C.Ctx) (A : C.Ty G) -> C.El G A -> U l)
    (h : (G : C.Ctx) (A : C.Ty G) (a : C.El G A) -> isProp (F G A a))
  : isProp ((G : C.Ctx) (A : C.Ty G) (a : C.El G A) -> F G A a) =
  piGA (\ G A -> (a : C.El G A) -> F G A a) (\ G A -> pp (C.El G A) (F G A) (h G A)) ;

piGAB (F : (G : C.Ctx) (A : C.Ty G) -> C.Ty (C.ext G A) -> U l)
    (h : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) -> isProp (F G A B))
  : isProp ((G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) -> F G A B) =
  piGA (\ G A -> (B : C.Ty (C.ext G A)) -> F G A B) (\ G A -> pp (C.Ty (C.ext G A)) (F G A) (h G A)) ;

piGABb (F : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) -> C.El (C.ext G A) B -> U l)
    (h : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B) -> isProp (F G A B b))
  : isProp ((G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B) -> F G A B b) =
  piGAB (\ G A B -> (b : C.El (C.ext G A) B) -> F G A B b)
        (\ G A B -> pp (C.El (C.ext G A) B) (F G A B) (h G A B)) ;

piDGAs (F : (D G : C.Ctx) (A : C.Ty G) -> C.Sub D G -> U l)
    (h : (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) -> isProp (F D G A s))
  : isProp ((D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) -> F D G A s) =
  pp C.Ctx (\ D -> (G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) -> F D G A s)
    (\ D -> piGA (\ G A -> (s : C.Sub D G) -> F D G A s) (\ G A -> pp (C.Sub D G) (F D G A) (h D G A))) ;

piDGAas (F : (D G : C.Ctx) (A : C.Ty G) (a : C.El G A) -> C.Sub D G -> U l)
    (h : (D G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G) -> isProp (F D G A a s))
  : isProp ((D G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G) -> F D G A a s) =
  pp C.Ctx (\ D -> (G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G) -> F D G A a s)
    (\ D -> piGAa (\ G A a -> (s : C.Sub D G) -> F D G A a s) (\ G A a -> pp (C.Sub D G) (F D G A a) (h D G A a))) ;

piTDGss (F : (T D G : C.Ctx) (s : C.Sub D G) -> C.Sub T D -> U l)
    (h : (T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D) -> isProp (F T D G s s'))
  : isProp ((T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D) -> F T D G s s') =
  pp C.Ctx (\ T -> (D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D) -> F T D G s s')
   (\ T -> pp C.Ctx (\ D -> (G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D) -> F T D G s s')
    (\ D -> pp C.Ctx (\ G -> (s : C.Sub D G) (s' : C.Sub T D) -> F T D G s s')
     (\ G -> pp (C.Sub D G) (\ s -> (s' : C.Sub T D) -> F T D G s s')
      (\ s -> pp (C.Sub T D) (F T D G s) (h T D G s))))) ;

piNG (F : LevelAt N -> C.Ctx -> U l) (h : (n : LevelAt N) (G : C.Ctx) -> isProp (F n G))
  : isProp ((n : LevelAt N) (G : C.Ctx) -> F n G) =
  pp (LevelAt N) (\ n -> (G : C.Ctx) -> F n G) (\ n -> pp C.Ctx (F n) (h n)) ;

piNGa (F : (n : LevelAt N) (G : C.Ctx) -> C.El G (M.univ n G) -> U l)
    (h : (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G)) -> isProp (F n G a))
  : isProp ((n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G)) -> F n G a) =
  piNG (\ n G -> (a : C.El G (M.univ n G)) -> F n G a) (\ n G -> pp (C.El G (M.univ n G)) (F n G) (h n G)) ;

piNGab (F : (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
            -> C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) -> U l)
    (h : (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
         (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a)))) -> isProp (F n G a b))
  : isProp ((n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
            (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a)))) -> F n G a b) =
  piNGa (\ n G a -> (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a)))) -> F n G a b)
        (\ n G a -> pp (C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a)))) (F n G a) (h n G a)) ;

piMNG (F : (m n : LevelAt N) -> StrictAt N m n -> C.Ctx -> U l)
    (h : (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) -> isProp (F m n lt G))
  : isProp ((m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) -> F m n lt G) =
  pp (LevelAt N) (\ m -> (n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) -> F m n lt G)
   (\ m -> pp (LevelAt N) (\ n -> (lt : StrictAt N m n) (G : C.Ctx) -> F m n lt G)
    (\ n -> pp (StrictAt N m n) (\ lt -> (G : C.Ctx) -> F m n lt G)
     (\ lt -> pp C.Ctx (F m n lt) (h m n lt)))) ;

piMNGa (F : (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) -> C.El G (M.univ m G) -> U l)
    (h : (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (a : C.El G (M.univ m G)) -> isProp (F m n lt G a))
  : isProp ((m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (a : C.El G (M.univ m G)) -> F m n lt G a) =
  piMNG (\ m n lt G -> (a : C.El G (M.univ m G)) -> F m n lt G a)
        (\ m n lt G -> pp (C.El G (M.univ m G)) (F m n lt G) (h m n lt G)) ;

------------------------------------------------------------------------
-- every law is a proposition

setCode (n : LevelAt N) (X : C'.Ctx) : isSet (CodeF' n X) = C'.isSetEl X (M'.univ n X) ;

prop-LctxNil (ctx : CtxM) : isProp (LctxNil ctx) = set-Ctx' (ctx C.nil) C'.nil ;

prop-CtxExt (ctx : CtxM) (ty : TyM ctx) : isProp (CtxExt ctx ty) =
  piGA (CtxExtAt ctx ty) (\ G A -> set-Ctx' (ctx (C.ext G A)) (C'.ext (ctx G) (ty G A))) ;

prop-LsubId (ctx : CtxM) (sub : SubM ctx) : isProp (LsubId ctx sub) =
  piG (LsubIdAt ctx sub) (\ G -> C'.isSetSub (ctx G) (ctx G) (sub G G (C.id G)) (C'.id (ctx G))) ;

prop-LsubO (ctx : CtxM) (sub : SubM ctx) : isProp (LsubO ctx sub) =
  piTDGss (LsubOAt ctx sub) (\ T D G s s' ->
    C'.isSetSub (ctx T) (ctx G) (sub T G (C.o T D G s s'))
      (C'.o (ctx T) (ctx D) (ctx G) (sub D G s) (sub T D s'))) ;

prop-LsubEps (ctx : CtxM) (sub : SubM ctx) : isProp (LsubEps ctx sub) =
  piG (LsubEpsAt ctx sub) (\ G ->
    set-SubT' (ctx G, (ctx C.nil, sub G C.nil (C.eps G))) (ctx G, (C'.nil, C'.eps (ctx G)))) ;

prop-LsubP (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) : isProp (LsubP ctx sub ty) =
  piGA (LsubPAt ctx sub ty) (\ G A ->
    set-SubT' (ctx (C.ext G A), (ctx G, sub (C.ext G A) G (C.p G A)))
              (extS ctx ty G A, (ctx G, C'.p (ctx G) (ty G A)))) ;

prop-LsubLift (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) : isProp (LsubLift ctx sub ty) =
  piDGAs (LsubLiftAt ctx sub ty) (\ D G A s ->
    set-SubT' (ctx (C.ext D (C.subT D G A s)),
               (ctx (C.ext G A), sub (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s)))
              (C'.ext (ctx D) (C'.subT (ctx D) (ctx G) (ty G A) (sub D G s)),
               (extS ctx ty G A, C'.lift (ctx D) (ctx G) (ty G A) (sub D G s)))) ;

prop-LsubSec (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) : isProp (LsubSec ctx sub ty tm) =
  piGAa (LsubSecAt ctx sub ty tm) (\ G A a ->
    set-SubT' (ctx G, (ctx (C.ext G A), sub G (C.ext G A) (C.sec G A a)))
              (ctx G, (extS ctx ty G A, C'.sec (ctx G) (ty G A) (tm G A a)))) ;

prop-LtySubT (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) : isProp (LtySubT ctx sub ty) =
  piDGAs (LtySubTAt ctx sub ty) (\ D G A s ->
    C'.isSetTy (ctx D) (ty D (C.subT D G A s)) (C'.subT (ctx D) (ctx G) (ty G A) (sub D G s))) ;

prop-LtyPi (ctx : CtxM) (ty : TyM ctx) (ce : CtxExt ctx ty) : isProp (LtyPi ctx ty ce) =
  piGAB (LtyPiAt ctx ty ce) (\ G A B ->
    C'.isSetTy (ctx G) (ty G (P.Pi G A B)) (P'.Pi (ctx G) (ty G A) (mvTyS ctx ty ce G A B))) ;

prop-TyUniv (ctx : CtxM) (ty : TyM ctx) : isProp (TyUniv ctx ty) =
  piNG (TyUnivAt ctx ty) (\ n G -> C'.isSetTy (ctx G) (ty G (M.univ n G)) (M'.univ n (ctx G))) ;

prop-TyDecode (ctx : CtxM) (ty : TyM ctx) (tm : TmM ctx ty) (tu : TyUniv ctx ty)
  : isProp (TyDecode ctx ty tm tu) =
  piNGa (TyDecodeAt ctx ty tm tu) (\ n G a ->
    C'.isSetTy (ctx G) (ty G (M.decode n G a)) (M'.decode n (ctx G) (codeS ctx ty tm tu n G a))) ;

prop-LtmSubt (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) : isProp (LtmSubt ctx sub ty tm) =
  piDGAas (LtmSubtAt ctx sub ty tm) (\ D G A a s ->
    set-Term' (ctx D) (ty D (C.subT D G A s), tm D (C.subT D G A s) (C.subt D G A a s))
      (C'.subT (ctx D) (ctx G) (ty G A) (sub D G s), C'.subt (ctx D) (ctx G) (ty G A) (tm G A a) (sub D G s))) ;

prop-LtmQ (ctx : CtxM) (ty : TyM ctx) (tm : TmM ctx ty) : isProp (LtmQ ctx ty tm) =
  piGA (LtmQAt ctx ty tm) (\ G A ->
    set-TmT' (ctx (C.ext G A), (ty (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)),
                                tm (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A)))
             (extS ctx ty G A, (C'.subT (extS ctx ty G A) (ctx G) (ty G A) (C'.p (ctx G) (ty G A)),
                                C'.q (ctx G) (ty G A)))) ;

prop-LtmLam (ctx : CtxM) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty) : isProp (LtmLam ctx ty tm ce) =
  piGABb (LtmLamAt ctx ty tm ce) (\ G A B b ->
    set-Term' (ctx G) (ty G (P.Pi G A B), tm G (P.Pi G A B) ((P.Pi-iso G A B).inv b))
      (P'.Pi (ctx G) (ty G A) (mvTyS ctx ty ce G A B),
       (P'.Pi-iso (ctx G) (ty G A) (mvTyS ctx ty ce G A B)).inv (mvElS ctx ty tm ce G A B b))) ;

prop-LtmPic (ctx : CtxM) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (LtmPic ctx ty tm ce tu td) =
  piNGab (LtmPicAt ctx ty tm ce tu td) (\ n G a b ->
    setCode n (ctx G) (codeS ctx ty tm tu n G (M.pic n G a b))
      (M'.pic n (ctx G) (codeS ctx ty tm tu n G a) (mvCodeS ctx ty tm ce tu td n G a b))) ;

prop-LtmUc (ctx : CtxM) (ty : TyM ctx) (tm : TmM ctx ty) (tu : TyUniv ctx ty) : isProp (LtmUc ctx ty tm tu) =
  piMNG (LtmUcAt ctx ty tm tu) (\ m n lt G ->
    setCode n (ctx G) (codeS ctx ty tm tu n G (M.uc m n lt G)) (M'.uc m n lt (ctx G))) ;

prop-LtmLf (ctx : CtxM) (ty : TyM ctx) (tm : TmM ctx ty) (tu : TyUniv ctx ty) : isProp (LtmLf ctx ty tm tu) =
  piMNGa (LtmLfAt ctx ty tm tu) (\ m n lt G a ->
    setCode n (ctx G) (codeS ctx ty tm tu n G (M.lf m n lt G a))
      (M'.lf m n lt (ctx G) (codeS ctx ty tm tu m G a))) ;

------------------------------------------------------------------------
-- the tails, hence the laws, are propositions

prod-prop (A B : U l) (pA : isProp A) (pB : isProp B) : isProp (A * B) =
  isProp-Sigma A (\ x -> B) pA (\ x -> pB) ;

prop-T18 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (T18 ctx sub ty tm ce tu td) =
  prop-LtmLf ctx ty tm tu ;
prop-T17 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (T17 ctx sub ty tm ce tu td) =
  prod-prop (LtmUc ctx ty tm tu) (T18 ctx sub ty tm ce tu td)
    (prop-LtmUc ctx ty tm tu) (prop-T18 ctx sub ty tm ce tu td) ;
prop-T16 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (T16 ctx sub ty tm ce tu td) =
  prod-prop (LtmPic ctx ty tm ce tu td) (T17 ctx sub ty tm ce tu td)
    (prop-LtmPic ctx ty tm ce tu td) (prop-T17 ctx sub ty tm ce tu td) ;
prop-T15 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (T15 ctx sub ty tm ce tu td) =
  prod-prop (LtmLam ctx ty tm ce) (T16 ctx sub ty tm ce tu td)
    (prop-LtmLam ctx ty tm ce) (prop-T16 ctx sub ty tm ce tu td) ;
prop-T14 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (T14 ctx sub ty tm ce tu td) =
  prod-prop (LtmQ ctx ty tm) (T15 ctx sub ty tm ce tu td)
    (prop-LtmQ ctx ty tm) (prop-T15 ctx sub ty tm ce tu td) ;
prop-T13 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) (td : TyDecode ctx ty tm tu) : isProp (T13 ctx sub ty tm ce tu td) =
  prod-prop (LtmSubt ctx sub ty tm) (T14 ctx sub ty tm ce tu td)
    (prop-LtmSubt ctx sub ty tm) (prop-T14 ctx sub ty tm ce tu td) ;
prop-T12 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
    (tu : TyUniv ctx ty) : isProp (T12 ctx sub ty tm ce tu) =
  isProp-Sigma (TyDecode ctx ty tm tu) (\ td -> T13 ctx sub ty tm ce tu td)
    (prop-TyDecode ctx ty tm tu) (\ td -> prop-T13 ctx sub ty tm ce tu td) ;
prop-T11 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T11 ctx sub ty tm ce) =
  isProp-Sigma (TyUniv ctx ty) (\ tu -> T12 ctx sub ty tm ce tu)
    (prop-TyUniv ctx ty) (\ tu -> prop-T12 ctx sub ty tm ce tu) ;
prop-T10 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T10 ctx sub ty tm ce) =
  prod-prop (LtyPi ctx ty ce) (T11 ctx sub ty tm ce) (prop-LtyPi ctx ty ce) (prop-T11 ctx sub ty tm ce) ;
prop-T9 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T9 ctx sub ty tm ce) =
  prod-prop (LtySubT ctx sub ty) (T10 ctx sub ty tm ce) (prop-LtySubT ctx sub ty) (prop-T10 ctx sub ty tm ce) ;
prop-T8 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T8 ctx sub ty tm ce) =
  prod-prop (LsubSec ctx sub ty tm) (T9 ctx sub ty tm ce) (prop-LsubSec ctx sub ty tm) (prop-T9 ctx sub ty tm ce) ;
prop-T7 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T7 ctx sub ty tm ce) =
  prod-prop (LsubLift ctx sub ty) (T8 ctx sub ty tm ce) (prop-LsubLift ctx sub ty) (prop-T8 ctx sub ty tm ce) ;
prop-T6 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T6 ctx sub ty tm ce) =
  prod-prop (LsubP ctx sub ty) (T7 ctx sub ty tm ce) (prop-LsubP ctx sub ty) (prop-T7 ctx sub ty tm ce) ;
prop-T5 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T5 ctx sub ty tm ce) =
  prod-prop (LsubEps ctx sub) (T6 ctx sub ty tm ce) (prop-LsubEps ctx sub) (prop-T6 ctx sub ty tm ce) ;
prop-T4 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T4 ctx sub ty tm ce) =
  prod-prop (LsubO ctx sub) (T5 ctx sub ty tm ce) (prop-LsubO ctx sub) (prop-T5 ctx sub ty tm ce) ;
prop-T3 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) (ce : CtxExt ctx ty)
  : isProp (T3 ctx sub ty tm ce) =
  prod-prop (LsubId ctx sub) (T4 ctx sub ty tm ce) (prop-LsubId ctx sub) (prop-T4 ctx sub ty tm ce) ;
prop-T2 (ctx : CtxM) (sub : SubM ctx) (ty : TyM ctx) (tm : TmM ctx ty) : isProp (T2 ctx sub ty tm) =
  isProp-Sigma (CtxExt ctx ty) (\ ce -> T3 ctx sub ty tm ce)
    (prop-CtxExt ctx ty) (\ ce -> prop-T3 ctx sub ty tm ce) ;

prop-Laws (d : Data) : isProp (Laws d) =
  prod-prop (LctxNil d.1) (T2 d.1 d.2.1 d.2.2.1 d.2.2.2)
    (prop-LctxNil d.1) (prop-T2 d.1 d.2.1 d.2.2.1 d.2.2.2) ;

------------------------------------------------------------------------
-- pointwise agreement of data

-- agreement of the last three maps over the same ctx (the form of Agree)
TyAg (c c' : CtxM) (ty : TyM c) (ty' : TyM c') : U l =
  (G : C.Ctx) (A : C.Ty G) -> Id TyT' (c G, ty G A) (c' G, ty' G A) ;
TmAg (c c' : CtxM) (ty : TyM c) (tm : TmM c ty) (ty' : TyM c') (tm' : TmM c' ty') : U l =
  (G : C.Ctx) (A : C.Ty G) (a : C.El G A) -> Id TmT' (c G, (ty G A, tm G A a)) (c' G, (ty' G A, tm' G A a)) ;
SubAg (c c' : CtxM) (sub : SubM c) (sub' : SubM c') : U l =
  (D G : C.Ctx) (s : C.Sub D G) -> Id SubT' (c D, (c G, sub D G s)) (c' D, (c' G, sub' D G s)) ;

Rest (c : CtxM) : U l = (sub : SubM c) * (ty : TyM c) * TmM c ty ;
TT (c : CtxM) : U l = (ty : TyM c) * TmM c ty ;

-- substitutions over one ctx
sub-ext (c : CtxM) (sub sub' : SubM c) (h : SubAg c c sub sub') : Id (SubM c) sub sub' =
  FE.funext C.Ctx (\ D -> (G : C.Ctx) (s : C.Sub D G) -> C'.Sub (c D) (c G)) sub sub' (\ D ->
   FE.funext C.Ctx (\ G -> (s : C.Sub D G) -> C'.Sub (c D) (c G)) (sub D) (sub' D) (\ G ->
    FE.funext (C.Sub D G) (\ s -> C'.Sub (c D) (c G)) (sub D G) (sub' D G) (\ s ->
     fib C'.Ctx set-Ctx' (C'.Sub (c D)) (c G) (sub D G s) (sub' D G s)
       (codPath (c D) (c G) (c G) (sub D G s) (sub' D G s) (h D G s))))) ;

-- types over one ctx
ty-ext (c : CtxM) (ty ty' : TyM c) (h : TyAg c c ty ty') : Id (TyM c) ty ty' =
  FE.funext C.Ctx (\ G -> (A : C.Ty G) -> C'.Ty (c G)) ty ty' (\ G ->
   FE.funext (C.Ty G) (\ A -> C'.Ty (c G)) (ty G) (ty' G) (\ A ->
    fibTy (c G) (ty G A) (ty' G A) (h G A))) ;

-- terms over one ctx and one ty
tm-ext (c : CtxM) (ty : TyM c) (tm tm' : TmM c ty) (h : TmAg c c ty tm ty tm') : Id (TmM c ty) tm tm' =
  FE.funext C.Ctx (\ G -> (A : C.Ty G) (a : C.El G A) -> C'.El (c G) (ty G A)) tm tm' (\ G ->
   FE.funext (C.Ty G) (\ A -> (a : C.El G A) -> C'.El (c G) (ty G A)) (tm G) (tm' G) (\ A ->
    FE.funext (C.El G A) (\ a -> C'.El (c G) (ty G A)) (tm G A) (tm' G A) (\ a ->
     fibEl (c G) (ty G A) (tm G A a) (tm' G A a)
       (fibTm (c G) (ty G A, tm G A a) (ty G A, tm' G A a) (h G A a))))) ;

tt-ext (c : CtxM) (ty ty' : TyM c) (tm : TmM c ty) (tm' : TmM c ty')
    (ht : TyAg c c ty ty') (hm : TmAg c c ty tm ty' tm') : Id (TT c) (ty, tm) (ty', tm') =
  idJ (TyM c) ty
    (\ t1 p1 -> (m1 : TmM c t1) -> TmAg c c ty tm t1 m1 -> Id (TT c) (ty, tm) (t1, m1))
    (\ m1 h1 -> ap (TmM c ty) (TT c) (\ u -> (ty, u)) tm m1 (tm-ext c ty tm m1 h1))
    ty' (ty-ext c ty ty' ht) tm' hm ;

rest-ext (c : CtxM) (r r' : Rest c)
    (hs : SubAg c c r.1 r'.1) (ht : TyAg c c r.2.1 r'.2.1) (hm : TmAg c c r.2.1 r.2.2 r'.2.1 r'.2.2)
  : Id (Rest c) r r' =
  idJ (SubM c) r.1 (\ s1 p1 -> Id (Rest c) r (s1, r'.2))
    (ap (TT c) (Rest c) (\ u -> (r.1, u)) r.2 r'.2 (tt-ext c r.2.1 r'.2.1 r.2.2 r'.2.2 ht hm))
    r'.1 (sub-ext c r.1 r'.1 hs) ;

data-ext (d d' : Data)
    (hc : (G : C.Ctx) -> Id C'.Ctx (d.1 G) (d'.1 G))
    (ht : TyAg d.1 d'.1 d.2.2.1 d'.2.2.1)
    (hm : TmAg d.1 d'.1 d.2.2.1 d.2.2.2 d'.2.2.1 d'.2.2.2)
    (hs : SubAg d.1 d'.1 d.2.1 d'.2.1)
  : Id Data d d' =
  idJ CtxM d.1
    (\ c1 e1 -> (r1 : Rest c1) -> TyAg d.1 c1 d.2.2.1 r1.2.1 -> TmAg d.1 c1 d.2.2.1 d.2.2.2 r1.2.1 r1.2.2
                -> SubAg d.1 c1 d.2.1 r1.1 -> Id Data d (c1, r1))
    (\ r1 ht1 hm1 hs1 -> ap (Rest d.1) Data (\ u -> (d.1, u)) d.2 r1 (rest-ext d.1 d.2 r1 hs1 ht1 hm1))
    d'.1 (FE.funext C.Ctx (\ G -> C'.Ctx) d.1 d'.1 hc) d'.2 ht hm hs ;

------------------------------------------------------------------------
-- extensionality of morphisms in Sigma form

hom-ext (h h' : HomS) (ag : Agree[fromS h, fromS h']) : Id HomS h h' =
  Sigma-eq Data Laws h.1 h'.1 h.2 h'.2
    (data-ext h.1 h'.1 ag.ctx-ag ag.ty-ag ag.tm-ag ag.sub-ag)
    (prop-Laws h'.1) ;

-- and conversely, a path gives agreement
agree-refl (H : Hom) : Agree[H,H] = new Agree[H, H,
  ctx-ag := \ G -> refl (H.ctx G),
  ty-ag := \ G A -> refl (H.ctx G, H.ty G A),
  tm-ag := \ G A a -> refl (H.ctx G, (H.ty G A, H.tm G A a)),
  sub-ag := \ D G s -> refl (H.ctx D, (H.ctx G, H.sub D G s))] ;

hom-agree (h h' : HomS) (p : Id HomS h h') : Agree[fromS h, fromS h'] =
  idJ HomS h (\ h1 p1 -> Agree[fromS h, fromS h1]) (agree-refl (fromS h)) h' p ;

------------------------------------------------------------------------
-- HomS is a set

set-CtxM : isSet CtxM = FE.isSet-Pi C.Ctx (\ G -> C'.Ctx) (\ G -> set-Ctx') ;

set-SubM (c : CtxM) : isSet (SubM c) =
  FE.isSet-Pi C.Ctx (\ D -> (G : C.Ctx) (s : C.Sub D G) -> C'.Sub (c D) (c G)) (\ D ->
   FE.isSet-Pi C.Ctx (\ G -> (s : C.Sub D G) -> C'.Sub (c D) (c G)) (\ G ->
    FE.isSet-Pi (C.Sub D G) (\ s -> C'.Sub (c D) (c G)) (\ s -> C'.isSetSub (c D) (c G)))) ;

set-TyM (c : CtxM) : isSet (TyM c) =
  FE.isSet-Pi C.Ctx (\ G -> (A : C.Ty G) -> C'.Ty (c G)) (\ G ->
   FE.isSet-Pi (C.Ty G) (\ A -> C'.Ty (c G)) (\ A -> C'.isSetTy (c G))) ;

set-TmM (c : CtxM) (ty : TyM c) : isSet (TmM c ty) =
  FE.isSet-Pi C.Ctx (\ G -> (A : C.Ty G) (a : C.El G A) -> C'.El (c G) (ty G A)) (\ G ->
   FE.isSet-Pi (C.Ty G) (\ A -> (a : C.El G A) -> C'.El (c G) (ty G A)) (\ A ->
    FE.isSet-Pi (C.El G A) (\ a -> C'.El (c G) (ty G A)) (\ a -> C'.isSetEl (c G) (ty G A)))) ;

set-Data : isSet Data =
  isSet-Sigma CtxM Rest set-CtxM (\ c ->
    isSet-Sigma (SubM c) (\ s -> TT c) (set-SubM c) (\ s ->
      isSet-Sigma (TyM c) (TmM c) (set-TyM c) (set-TmM c))) ;

set-HomS : isSet HomS =
  isSet-Sigma Data Laws set-Data (\ d -> prop-to-set (Laws d) (prop-Laws d)) ;
