-- Dependent-product formation, congruence, and beta soundness.
open Base ; open Prelude[l] ; open Paths[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpFormers ;
open TEInterpJudgement ; open B.GAT[l] ;

record ProductValue (g : Tel) (A B' : GE) {
  dom : C.Ty (ctx g) ;
  dom-down : TyDown A g dom ;
  cod : C.Ty (ctx (extend g dom)) ;
  cod-down : TyDown B' (extend g dom) cod ;
  pi : C.Ty (ctx g) = pi-at g dom cod ;
  pi-down-at : TyDown (gpi A B') g pi = pi-down A B' g dom cod dom-down cod-down ;
} ;

product-value (G A B' : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (g : Tel) (hg : CtxDown G g) : ProductValue[g,A,B'] =
  new ProductValue[g,A,B',dom := a.1,dom-down := a.2,cod := b.1,cod-down := b.2]
 where {
  a : TypeValue g A = r.2 g hg ;
  b : TypeValue (extend g a.1) B' = p.2 (extend g a.1) (ext-down G A g a.1 hg a.2) ;
 } ;

case-gt-pi (G A B' : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B')) : SoundJ (gjty G (gpi A B')) =
  (r.1,\ g hg -> build g (product-value G A B' r p g hg))
 where {
  build (g : Tel) (v : ProductValue[g,A,B']) : TypeValue g (gpi A B') = (v.pi,v.pi-down-at) ;
 } ;

case-ge-pi (G A A' B' B'' : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjeqty G A A'))
    (p : SoundJ (gjeqty (gext G A) B' B'')) : SoundJ (gjeqty G (gpi A B') (gpi A' B'')) =
  (r.1,\ g hg -> build g hg (r.2 g hg))
 where {
  build (g : Tel) (hg : CtxDown G g) (a : TypeEquality g A A') : TypeEquality g (gpi A B') (gpi A' B'') =
    (pi-at g a.1 b.1,(pi-down A B' g a.1 b.1 a.2.1 b.2.1,pi-down A' B'' g a.1 b.1 a.2.2 b.2.2))
   where { b : TypeEquality (extend g a.1) B' B'' = p.2 (extend g a.1) (ext-down G A g a.1 hg a.2.1) ; } ;
 } ;

case-gm-lam (G A B' b : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (t : SoundJ (gjtm (gext G A) b B')) : SoundJ (gjtm G (glam A B' b) (gpi A B')) =
  (r.1,\ g hg -> build g hg (product-value G A B' r p g hg))
 where {
  build (g : Tel) (hg : CtxDown G g) (v : ProductValue[g,A,B']) : TermValue g (gpi A B') (glam A B' b) =
    (v.pi,(v.pi-down-at,(lam-at g v.dom v.cod u.1,lam-down A B' b g v.dom v.cod u.1 v.dom-down v.cod-down u.2)))
   where {
    x : Tel = extend g v.dom ;
    u : TermAt x v.cod b = at-type x B' b v.cod v.cod-down
      (t.2 x (ext-down G A g v.dom hg v.dom-down)) ;
   } ;
 } ;

case-gm-app (G A B' f a : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (ft : SoundJ (gjtm G f (gpi A B'))) (at : SoundJ (gjtm G a A)) :
    SoundJ (gjtm G (gapp A B' f a) (gsb B' (gsec A a))) =
  (r.1,\ g hg -> build g (product-value G A B' r p g hg) (ft.2 g hg) (at.2 g hg))
 where {
  build (g : Tel) (v : ProductValue[g,A,B']) (fr : TermValue g (gpi A B') f) (ar : TermValue g A a) :
      TermValue g (gsb B' (gsec A a)) (gapp A B' f a) =
    (u.1,(ty-sub-down B' (gsec A a) g (extend g v.dom) v.cod (C.sec (ctx g) v.dom x.1) v.cod-down
      (sec-down A a g v.dom x.1 v.dom-down x.2),
      (u.2,app-down A B' f a g v.dom v.cod fn.1 x.1 v.dom-down v.cod-down fn.2 x.2)))
   where {
    x : TermAt g v.dom a = at-type g A a v.dom v.dom-down ar ;
    fn : TermAt g v.pi f = at-type g (gpi A B') f v.pi v.pi-down-at fr ;
    u : Term g = app-at g v.dom v.cod fn.1 x.1 ;
   } ;
 } ;

case-gm-elam (G A A' B' B'' b b' : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjeqty G A A'))
    (p : SoundJ (gjeqty (gext G A) B' B'')) (t : SoundJ (gjeqtm (gext G A) b b' B')) :
    SoundJ (gjeqtm G (glam A B' b) (glam A' B'' b') (gpi A B')) =
  (r.1,\ g hg -> build g hg (r.2 g hg))
 where {
  build (g : Tel) (hg : CtxDown G g) (a : TypeEquality g A A') : TermEquality g (gpi A B') (glam A B' b) (glam A' B'' b') =
    (pi-at g a.1 c.1,(pi-down A B' g a.1 c.1 a.2.1 c.2.1,
      (lam-at g a.1 c.1 u.1,(lam-down A B' b g a.1 c.1 u.1 a.2.1 c.2.1 u.2.1,
                             lam-down A' B'' b' g a.1 c.1 u.1 a.2.2 c.2.2 u.2.2))))
   where {
    x : Tel = extend g a.1 ;
    hx : CtxDown (gext G A) x = ext-down G A g a.1 hg a.2.1 ;
    c : TypeEquality x B' B'' = p.2 x hx ;
    u : (v : C.El (ctx x) c.1) * (TmDown b x c.1 v * TmDown b' x c.1 v) =
      equal-at-type x B' b b' c.1 c.2.1 (t.2 x hx) ;
   } ;
 } ;

case-gm-eapp (G A A' B' B'' f f' a a' : GE)
    (w : SoundJ (gjty G A)) (wb : SoundJ (gjty (gext G A) B')) (wa : SoundJ (gjtm G a A))
    (r : SoundJ (gjeqty G A A')) (p : SoundJ (gjeqty (gext G A) B' B''))
    (ef : SoundJ (gjeqtm G f f' (gpi A B'))) (ea : SoundJ (gjeqtm G a a' A)) :
    SoundJ (gjeqtm G (gapp A B' f a) (gapp A' B'' f' a') (gsb B' (gsec A a))) =
  (r.1,\ g hg -> build g hg (r.2 g hg) (ef.2 g hg) (ea.2 g hg))
 where {
  build (g : Tel) (hg : CtxDown G g) (d : TypeEquality g A A')
      (fr : TermEquality g (gpi A B') f f') (ar : TermEquality g A a a') :
      TermEquality g (gsb B' (gsec A a)) (gapp A B' f a) (gapp A' B'' f' a') =
    (u.1,(ty-sub-down B' (gsec A a) g x b.1 (C.sec (ctx g) d.1 v.1) b.2.1
      (sec-down A a g d.1 v.1 d.2.1 v.2.1),
      (u.2,(app-down A B' f a g d.1 b.1 fn.1 v.1 d.2.1 b.2.1 fn.2.1 v.2.1,
             app-down A' B'' f' a' g d.1 b.1 fn.1 v.1 d.2.2 b.2.2 fn.2.2 v.2.2))))
   where {
    x : Tel = extend g d.1 ;
    b : TypeEquality x B' B'' = p.2 x (ext-down G A g d.1 hg d.2.1) ;
    z : C.Ty (ctx g) = pi-at g d.1 b.1 ;
    fn : (u : C.El (ctx g) z) * (TmDown f g z u * TmDown f' g z u) =
      equal-at-type g (gpi A B') f f' z (pi-down A B' g d.1 b.1 d.2.1 b.2.1) fr ;
    v : (u : C.El (ctx g) d.1) * (TmDown a g d.1 u * TmDown a' g d.1 u) =
      equal-at-type g A a a' d.1 d.2.1 ar ;
    u : Term g = app-at g d.1 b.1 fn.1 v.1 ;
   } ;
 } ;

case-gm-beta (G A B' b a : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (bt : SoundJ (gjtm (gext G A) b B')) (at : SoundJ (gjtm G a A)) :
    SoundJ (gjeqtm G (gapp A B' (glam A B' b) a) (gsb b (gsec A a)) (gsb B' (gsec A a))) =
  (r.1,\ g hg -> build g hg (product-value G A B' r p g hg) (at.2 g hg))
 where {
  build (g : Tel) (hg : CtxDown G g) (v : ProductValue[g,A,B']) (ar : TermValue g A a) :
      TermEquality g (gsb B' (gsec A a)) (gapp A B' (glam A B' b) a) (gsb b (gsec A a)) =
    same-term g (gsb B' (gsec A a)) (gapp A B' (glam A B' b) a) (gsb b (gsec A a)) lhs
      (T,C.subt (ctx g) (ctx x) v.cod u.1 s)
      (ty-sub-down B' (gsec A a) g x v.cod s v.cod-down hs)
      (app-down A B' (glam A B' b) a g v.dom v.cod f z.1 v.dom-down v.cod-down
        (lam-down A B' b g v.dom v.cod u.1 v.dom-down v.cod-down u.2) z.2)
      (tm-sub-down b (gsec A a) g x v.cod u.1 s u.2 hs)
      (apH (\ t -> (T,t)) (M.products.beta (ctx g) v.dom v.cod u.1 z.1))
   where {
    x : Tel = extend g v.dom ;
    u : TermAt x v.cod b = at-type x B' b v.cod v.cod-down (bt.2 x (ext-down G A g v.dom hg v.dom-down)) ;
    z : TermAt g v.dom a = at-type g A a v.dom v.dom-down ar ;
    s : C.Sub (ctx g) (ctx x) = C.sec (ctx g) v.dom z.1 ;
    hs : SubDown (gsec A a) g x s = sec-down A a g v.dom z.1 v.dom-down z.2 ;
    f : C.El (ctx g) v.pi = lam-at g v.dom v.cod u.1 ;
    T : C.Ty (ctx g) = app-type g v.dom v.cod z.1 ;
    lhs : Term g = app-at g v.dom v.cod f z.1 ;
   } ;
 } ;
