-- InitExistHom.seg (PLAN-INIT, Part E): existence.  For every
-- e : InitModelShape.Eqs (the equations of the term model; Part A
-- supplies eqs) the interpretation of TEInterp is a morphism
--   exHom e : InitHom.Morphism[l,N,mk e,M].InitHomLaws.Hom
-- from the term model mk e to M.  The four maps are those of
-- InitExistMaps (on contexts ctx (tel c)); every law is the
-- corresponding ex-* lemma of InitExistLawsA/B, whose statement is
-- definitionally the field type, since mk e has F's operations and the
-- derived members of Hom (mv-ty, mv-el, code, dec-ext, mv-code) are
-- computed from the fields ctx-ext, ty-univ, ty-decode given here.
-- Segment of InitCheckE.InitE.Exist (l, M).
open Base ; open Prelude[l] ; open Paths[l] ;
open InitSorts[l] ;
open InitModelShape[l] ;
open InitExistMaps ;
open InitExistLawsA ;
open InitExistLawsB ;

module ExistHom (e : Eqs) {
  module Mo = InitHom.Morphism[l,N,mk e,M] ;
  exHom : Mo.InitHomLaws.Hom = new Mo.InitHomLaws.Hom[
    ctx := \ c -> hctx c,
    sub := \ d c s -> hsub d c s,
    ty := \ c A -> hty c A,
    tm := \ c A a -> htm c A a,
    ctx-nil := ex-ctx-nil,
    ctx-ext := \ c A -> ex-ctx-ext c A,
    sub-id := \ c -> ex-sub-id c,
    sub-o := \ t d c s s' -> ex-sub-o t d c s s',
    sub-eps := \ c -> ex-sub-eps c,
    sub-p := \ c A -> ex-sub-p c A,
    sub-lift := \ d c A s -> ex-sub-lift d c A s,
    sub-sec := \ c A a -> ex-sub-sec c A a,
    ty-subT := \ d c A s -> ex-ty-subT d c A s,
    ty-Pi := \ c A B -> ex-ty-Pi c A B,
    ty-univ := \ n c -> ex-ty-univ n c,
    ty-decode := \ n c a -> ex-ty-decode n c a,
    tm-subt := \ d c A a s -> ex-tm-subt d c A a s,
    tm-q := \ c A -> ex-tm-q c A,
    tm-lam := \ c A B b -> ex-tm-lam c A B b,
    tm-pic := \ n c a b -> ex-tm-pic n c a b,
    tm-uc := \ m n lt c -> ex-tm-uc m n lt c,
    tm-lf := \ m n lt c a -> ex-tm-lf m n lt c a] ;
} ;

-- the result, as a function of the equations of the term model
exist (e : Eqs) : InitHom.Morphism[l,N,mk e,M].InitHomLaws.Hom = ExistHom[e].exHom ;
