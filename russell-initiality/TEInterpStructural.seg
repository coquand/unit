-- Context formation, conversion, and the structural equality rules.
open Base ; open Prelude[l] ; open Paths[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpJudgement ; open B.GAT[l] ;

case-g-nil : SoundJ (gjwf gnil) = (empty-tel,empty-down) ;

case-g-ext (G A : GE) (r : SoundJ (gjty G A)) : SoundJ (gjwf (gext G A)) = extension-value G A r ;

case-gc-nil : SoundJ (gjeqcx gnil gnil) = (empty-tel,(empty-down,empty-down)) ;

case-gc-refl (G : GE) (r : SoundJ (gjwf G)) : SoundJ (gjeqcx G G) = (r.1,(r.2,r.2)) ;

case-gc-ext (G D A B' : GE) (r : SoundJ (gjeqcx G D)) (s : SoundJ (gjeqty G A B')) :
    SoundJ (gjeqcx (gext G A) (gext D B')) =
  (extend r.1 a.1,(ext-down G A r.1 a.1 r.2.1 a.2.1,ext-down D B' r.1 a.1 r.2.2 a.2.2))
 where { a : TypeEquality r.1 A B' = s.2 r.1 r.2.1 ; } ;

case-gt-cx (G D A : GE) (w : SoundJ (gjwf D)) (e : SoundJ (gjeqcx G D)) (r : SoundJ (gjty G A)) :
    SoundJ (gjty D A) =
  (w,\ g h -> r.2 g (ctx-convert-back G D e g h)) ;

case-gm-cx (G D a A : GE) (w : SoundJ (gjwf D)) (e : SoundJ (gjeqcx G D)) (r : SoundJ (gjtm G a A)) :
    SoundJ (gjtm D a A) =
  (w,\ g h -> r.2 g (ctx-convert-back G D e g h)) ;

case-ge-cx (G D A B' : GE) (w : SoundJ (gjwf D)) (e : SoundJ (gjeqcx G D)) (r : SoundJ (gjeqty G A B')) :
    SoundJ (gjeqty D A B') =
  (w,\ g h -> r.2 g (ctx-convert-back G D e g h)) ;

case-gm-ecx (G D a b A : GE) (w : SoundJ (gjwf D)) (e : SoundJ (gjeqcx G D)) (r : SoundJ (gjeqtm G a b A)) :
    SoundJ (gjeqtm D a b A) =
  (w,\ g h -> r.2 g (ctx-convert-back G D e g h)) ;

case-gs-cx (D D' G G' s : GE) (wd : SoundJ (gjwf D')) (wg : SoundJ (gjwf G'))
    (ed : SoundJ (gjeqcx D D')) (eg : SoundJ (gjeqcx G G')) (r : SoundJ (gjsub D s G)) :
    SoundJ (gjsub D' s G') =
  (wd,(wg,\ d g hd hg -> r.2.2 d g (ctx-convert-back D D' ed d hd) (ctx-convert-back G G' eg g hg))) ;

case-ge-refl (G A : GE) (r : SoundJ (gjty G A)) : SoundJ (gjeqty G A A) =
  (r.1,\ g hg -> same g (r.2 g hg))
 where {
  same (g : Tel) (a : TypeValue g A) : TypeEquality g A A = (a.1,(a.2,a.2)) ;
 } ;

case-ge-sym (G A B' : GE) (r : SoundJ (gjeqty G A B')) : SoundJ (gjeqty G B' A) =
  (r.1,\ g hg -> flip g (r.2 g hg))
 where {
  flip (g : Tel) (a : TypeEquality g A B') : TypeEquality g B' A = (a.1,(a.2.2,a.2.1)) ;
 } ;

case-ge-trans (G A B' D : GE) (r : SoundJ (gjeqty G A B')) (s : SoundJ (gjeqty G B' D)) : SoundJ (gjeqty G A D) =
  (r.1,\ g hg -> join g (r.2 g hg) (s.2 g hg))
 where {
  join (g : Tel) (a : TypeEquality g A B') (b : TypeEquality g B' D) : TypeEquality g A D =
    (a.1,(a.2.1,ty-move D g b.1 a.1 (ty-functional B' g b.1 a.1 b.2.1 a.2.2) b.2.2)) ;
 } ;

case-gm-refl (G a A : GE) (r : SoundJ (gjtm G a A)) : SoundJ (gjeqtm G a a A) =
  (r.1,\ g hg -> same g (r.2 g hg))
 where {
  same (g : Tel) (t : TermValue g A a) : TermEquality g A a a =
    (t.1,(t.2.1,(t.2.2.1,(t.2.2.2,t.2.2.2)))) ;
 } ;

case-gm-sym (G a b A : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjeqtm G a b A)) :
    SoundJ (gjeqtm G b a A) =
  (r.1,\ g hg -> flip g (r.2 g hg))
 where {
  flip (g : Tel) (t : TermEquality g A a b) : TermEquality g A b a =
    (t.1,(t.2.1,(t.2.2.1,(t.2.2.2.2,t.2.2.2.1)))) ;
 } ;

case-gm-trans (G a b c A : GE) (r : SoundJ (gjeqtm G a b A)) (s : SoundJ (gjeqtm G b c A)) :
    SoundJ (gjeqtm G a c A) =
  (r.1,\ g hg -> join g (r.2 g hg) (s.2 g hg))
 where {
  join (g : Tel) (u : TermEquality g A a b) (v : TermEquality g A b c) : TermEquality g A a c =
    (u.1,(u.2.1,(u.2.2.1,(u.2.2.2.1,
      tm-move c g (v.1,v.2.2.1) (u.1,u.2.2.1)
        (tm-functional b g (v.1,v.2.2.1) (u.1,u.2.2.1) v.2.2.2.1 u.2.2.2.2) v.2.2.2.2)))) ;
 } ;

case-gm-conv (G a A B' : GE) (r : SoundJ (gjtm G a A)) (s : SoundJ (gjeqty G A B')) : SoundJ (gjtm G a B') =
  (r.1,\ g hg -> convert g (r.2 g hg) (s.2 g hg))
 where {
  convert (g : Tel) (t : TermValue g A a) (e : TypeEquality g A B') : TermValue g B' a =
    (e.1,(e.2.2,at-type g A a e.1 e.2.1 t)) ;
 } ;

case-gm-eqconv (G a b A B' : GE) (r : SoundJ (gjeqtm G a b A)) (s : SoundJ (gjeqty G A B')) :
    SoundJ (gjeqtm G a b B') =
  (r.1,\ g hg -> convert g (r.2 g hg) (s.2 g hg))
 where {
  convert (g : Tel) (t : TermEquality g A a b) (e : TypeEquality g A B') : TermEquality g B' a b =
    (e.1,(e.2.2,equal-at-type g A a b e.1 e.2.1 t)) ;
 } ;

case-gq-refl (D s G : GE) (r : SoundJ (gjsub D s G)) : SoundJ (gjeqsub D s s G) =
  (r.1,(r.2.1,\ d g hd hg -> same d g (r.2.2 d g hd hg)))
 where {
  same (d g : Tel) (u : SubValue d g s) : SubEquality d g s s = (u.1,(u.2,u.2)) ;
 } ;

case-gq-sym (D s t G : GE) (r : SoundJ (gjeqsub D s t G)) : SoundJ (gjeqsub D t s G) =
  (r.1,(r.2.1,\ d g hd hg -> flip d g (r.2.2 d g hd hg)))
 where {
  flip (d g : Tel) (u : SubEquality d g s t) : SubEquality d g t s = (u.1,(u.2.2,u.2.1)) ;
 } ;

case-gq-trans (D s t u G : GE) (r : SoundJ (gjeqsub D s t G)) (p : SoundJ (gjeqsub D t u G)) :
    SoundJ (gjeqsub D s u G) =
  (r.1,(r.2.1,\ d g hd hg -> join d g (r.2.2 d g hd hg) (p.2.2 d g hd hg)))
 where {
  join (d g : Tel) (s' : SubEquality d g s t) (t' : SubEquality d g t u) : SubEquality d g s u =
    (s'.1,(s'.2.1, sub-move u d (g,t'.1) (g,s'.1)
      (sub-functional t d (g,t'.1) (g,s'.1) t'.2.1 s'.2.2) t'.2.2)) ;
 } ;
