-- InitModelPi.seg (PLAN-INIT, Part A): the laws of dependent products of
-- the term model (fields Pi-nat, Pi-iso-nat of PiStr; fun-inv, inv-fun of
-- the Iso Pi-iso c A B = (pi-fun, pi-inv)).  Pi-iso-nat is proved for an
-- ARBITRARY path of types (-gen).
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitModelRep[l] ;
open InitModelRepOps[l] ;

module PiNat (d c : Ctx) (A : Ty c) (T : Ty (ext c A)) (s : Sub d c) {
  E1 : Ctx = ext d (subT d c A s) ;
  rhs : Ty d = Pi d (subT d c A s) (subT E1 (ext c A) T (lift d c A s)) ;
  P : U l = Id (Ty d) (subT d c (Pi c A T) s) rhs ;
  pP : isProp P = isSetTy d (subT d c (Pi c A T) s) rhs ;
  at (cd : CP d) (cc : CP c) (x : NT c cc A) (z : NT (ext c A) (ext-cp c cc A x) T) (u : NS d c cd cc s) : P =
    nt-eq d cd cd (subT d c (Pi c A T) s) rhs
      (subT-n d c cd cc (Pi c A T) s (Pi-n c cc A x T z) u)
      (Pi-n d cd (subT d c A s) xS (subT E1 (ext c A) T (lift d c A s))
        (subT-n E1 (ext c A) (ext-cp d cd (subT d c A s) xS) (ext-cp c cc A x) T (lift d c A s) z
          (lift-n d c cd cc A s x u)))
      (ge-pi-sb cd.1 cc.1 x.1 z.1 u.1 x.2.1 z.2.1 u.2.1)
   where { xS : NT d cd (subT d c A s) = subT-n d c cd cc A s x u ; } ;
  proof : P =
    with-cp d P pP (\ cd -> with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x ->
    with-nt (ext c A) (ext-cp c cc A x) T P pP (\ z -> with-ns d c cd cc s P pP (\ u -> at cd cc x z u))))) ;
} ;

Pi-nat (d c : Ctx) (A : Ty c) (T : Ty (ext c A)) (s : Sub d c) :
  Id (Ty d) (subT d c (Pi c A T) s) (Pi d (subT d c A s) (subT (ext d (subT d c A s)) (ext c A) T (lift d c A s))) =
  PiNat[d,c,A,T,s].proof ;

------------------------------------------------------------------------
-- the two laws of the isomorphism

-- raw beta for the application to the variable:  app-q A B (lam A B b) = b
app-q-beta (G A B b : GE) (hA : GDer (gjty G A)) (hB : GDer (gjty (gext G A) B)) (hb : GDer (gjtm (gext G A) b B)) :
  GDer (gjeqtm (gext G A) (app-q A B (glam A B b)) b B) =
  gm-trans E (app-q A B (glam A B b)) (gapp Ap Bl (glam Ap Bl (gsb b l)) gq) b B
    (gm-eqconv E (app-q A B (glam A B b)) (gapp Ap Bl (glam Ap Bl (gsb b l)) gq) (gsb Bl sc) B s1 tA)
    (gm-trans E (gapp Ap Bl (glam Ap Bl (gsb b l)) gq) (gsb (gsb b l) sc) b B
      (gm-eqconv E (gapp Ap Bl (glam Ap Bl (gsb b l)) gq) (gsb (gsb b l) sc) (gsb Bl sc) B s2 tA)
      (gm-trans E (gsb (gsb b l) sc) (gsb b (gcomp l sc)) b B
        (gm-eqconv E (gsb (gsb b l) sc) (gsb b (gcomp l sc)) (gsb B (gcomp l sc)) B s3 tB)
        (gm-trans E (gsb b (gcomp l sc)) (gsb b gid) b B
          (gm-eqconv E (gsb b (gcomp l sc)) (gsb b gid) (gsb B (gcomp l sc)) B s4 tB)
          s5)))
 where {
  E : GE = gext G A ;
  Ap : GE = gsb A gp ;
  l : GE = glift A gp ;
  Bl : GE = gsb B l ;
  sc : GE = gsec Ap gq ;
  E2 : GE = gext E Ap ;
  wE : GDer (gjwf E) = g-ext G A hA ;
  hp : GDer (gjsub E gp G) = gs-p G A hA ;
  hAp : GDer (gjty E Ap) = gt-sb E G A gp hA hp ;
  hl : GDer (gjsub E2 l E) = gs-lift E G A gp hp hA ;
  hBl : GDer (gjty E2 Bl) = gt-sb E2 E B l hB hl ;
  hbl : GDer (gjtm E2 (gsb b l) Bl) = gm-sb E2 E b B l hB hb hl ;
  hq : GDer (gjtm E gq Ap) = gm-q G A hA ;
  hsc : GDer (gjsub E sc E2) = gs-sec E Ap gq hAp hq ;
  hls : GDer (gjsub E (gcomp l sc) E) = gs-comp E E2 E l sc hl hsc ;
  e1 : GDer (gjeqtm E (gsb (glam A B b) gp) (glam Ap Bl (gsb b l)) (gpi Ap Bl)) = gm-lam-sb E G A B b gp hA hB hb hp ;
  s1 : GDer (gjeqtm E (gapp Ap Bl (gsb (glam A B b) gp) gq) (gapp Ap Bl (glam Ap Bl (gsb b l)) gq) (gsb Bl sc)) =
    gm-eapp E Ap Ap Bl Bl (gsb (glam A B b) gp) (glam Ap Bl (gsb b l)) gq gq hAp hBl hq
      (ge-refl E Ap hAp) (ge-refl E2 Bl hBl) e1 (gm-refl E gq Ap hq) ;
  s2 : GDer (gjeqtm E (gapp Ap Bl (glam Ap Bl (gsb b l)) gq) (gsb (gsb b l) sc) (gsb Bl sc)) =
    gm-beta E Ap Bl (gsb b l) gq hAp hBl hbl hq ;
  s3 : GDer (gjeqtm E (gsb (gsb b l) sc) (gsb b (gcomp l sc)) (gsb B (gcomp l sc))) = gm-sb-comp E E2 E b B l sc hb hl hsc ;
  s4 : GDer (gjeqtm E (gsb b (gcomp l sc)) (gsb b gid) (gsb B (gcomp l sc))) =
    gm-esb E E b b B (gcomp l sc) gid hB hb (gm-refl E b B hb) hls (gs-id E wE) (gq-lift-p-sec-q G A hA) ;
  s5 : GDer (gjeqtm E (gsb b gid) b B) = gm-sb-id E b B hb ;
  tA : GDer (gjeqty E (gsb Bl sc) B) = GP.sb-eta G A B hA hB ;
  tB : GDer (gjeqty E (gsb B (gcomp l sc)) B) =
    ge-trans E (gsb B (gcomp l sc)) (gsb B gid) B
      (ge-sb E E B B (gcomp l sc) gid hB (ge-refl E B hB) hls (gs-id E wE) (gq-lift-p-sec-q G A hA))
      (ge-sb-id E B hB) ;
 } ;

Pi-fun-inv (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) :
  Id (El (ext c A) T) (pi-fun c A T (pi-inv c A T b)) b =
  with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x ->
  with-nt (ext c A) (ext-cp c cc A x) T P pP (\ z -> with-ne (ext c A) (ext-cp c cc A x) T z b P pP (\ y ->
    ne-eq (ext c A) (ext-cp c cc A x) (ext-cp c cc A x) T z z (pi-fun c A T (pi-inv c A T b)) b
      (pi-fun-n c cc A x T z (pi-inv c A T b) (pi-inv-n c cc A x T z b y)) y
      (app-q-beta cc.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1)))))
 where {
  P : U l = Id (El (ext c A) T) (pi-fun c A T (pi-inv c A T b)) b ;
  pP : isProp P = isSetEl (ext c A) T (pi-fun c A T (pi-inv c A T b)) b ;
 } ;

Pi-inv-fun (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (f : El c (Pi c A T)) :
  Id (El c (Pi c A T)) (pi-inv c A T (pi-fun c A T f)) f =
  with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x ->
  with-nt (ext c A) (ext-cp c cc A x) T P pP (\ z -> with-ne c cc (Pi c A T) (Pi-n c cc A x T z) f P pP (\ y ->
    ne-eq c cc cc (Pi c A T) (Pi-n c cc A x T z) (Pi-n c cc A x T z) (pi-inv c A T (pi-fun c A T f)) f
      (pi-inv-n c cc A x T z (pi-fun c A T f) (pi-fun-n c cc A x T z f y)) y
      (gm-sym cc.1 y.1 (glam x.1 z.1 (app-q x.1 z.1 y.1)) (gpi x.1 z.1) (gt-pi cc.1 x.1 z.1 x.2.1 z.2.1)
        (gm-eta cc.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1))))))
 where {
  P : U l = Id (El c (Pi c A T)) (pi-inv c A T (pi-fun c A T f)) f ;
  pP : isProp P = isSetEl c (Pi c A T) (pi-inv c A T (pi-fun c A T f)) f ;
 } ;

------------------------------------------------------------------------
-- naturality of abstraction

module PiIsoNat (d c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) (s : Sub d c) {
  E1 : Ctx = ext d (subT d c A s) ;
  T1 : Ty E1 = subT E1 (ext c A) T (lift d c A s) ;
  X : Ty d = subT d c (Pi c A T) s ;
  Y : Ty d = Pi d (subT d c A s) T1 ;
  module Gen (e : Id (Ty d) X Y) {
    lhs : El d Y = subst (Ty d) (El d) X Y e (subt d c (Pi c A T) (pi-inv c A T b) s) ;
    rhs : El d Y = pi-inv d (subT d c A s) T1 (subt E1 (ext c A) T b (lift d c A s)) ;
    P : U l = Id (El d Y) lhs rhs ;
    pP : isProp P = isSetEl d Y lhs rhs ;
    at (cd : CP d) (cc : CP c) (x : NT c cc A) (z : NT (ext c A) (ext-cp c cc A x) T)
      (y : NE (ext c A) (ext-cp c cc A x) T z b) (u : NS d c cd cc s) : P =
      ne-eq d cd cd Y (nt-tr d cd X Y xX e) (Pi-n d cd (subT d c A s) xS T1 zl) lhs rhs
        (ne-subst d cd X Y e xX (subt d c (Pi c A T) (pi-inv c A T b) s)
          (subt-n d c cd cc (Pi c A T) s (Pi-n c cc A x T z) (pi-inv c A T b) (pi-inv-n c cc A x T z b y) u))
        (pi-inv-n d cd (subT d c A s) xS T1 zl (subt E1 (ext c A) T b (lift d c A s))
          (subt-n E1 (ext c A) cE1 (ext-cp c cc A x) T (lift d c A s) z b y ul))
        (gm-eqconv cd.1 (gsb (glam x.1 z.1 y.1) u.1) (glam (gsb x.1 u.1) (gsb z.1 (glift x.1 u.1)) (gsb y.1 (glift x.1 u.1)))
          (gpi (gsb x.1 u.1) (gsb z.1 (glift x.1 u.1))) (gsb (gpi x.1 z.1) u.1)
          (gm-lam-sb cd.1 cc.1 x.1 z.1 y.1 u.1 x.2.1 z.2.1 y.2.1 u.2.1)
          (ge-sym cd.1 (gsb (gpi x.1 z.1) u.1) (gpi (gsb x.1 u.1) (gsb z.1 (glift x.1 u.1)))
            (ge-pi-sb cd.1 cc.1 x.1 z.1 u.1 x.2.1 z.2.1 u.2.1)))
     where {
      xS : NT d cd (subT d c A s) = subT-n d c cd cc A s x u ;
      cE1 : CP E1 = ext-cp d cd (subT d c A s) xS ;
      ul : NS E1 (ext c A) cE1 (ext-cp c cc A x) (lift d c A s) = lift-n d c cd cc A s x u ;
      zl : NT E1 cE1 T1 = subT-n E1 (ext c A) cE1 (ext-cp c cc A x) T (lift d c A s) z ul ;
      xX : NT d cd X = subT-n d c cd cc (Pi c A T) s (Pi-n c cc A x T z) u ;
     } ;
    proof : P =
      with-cp d P pP (\ cd -> with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x ->
      with-nt (ext c A) (ext-cp c cc A x) T P pP (\ z -> with-ne (ext c A) (ext-cp c cc A x) T z b P pP (\ y ->
      with-ns d c cd cc s P pP (\ u -> at cd cc x z y u)))))) ;
  } ;
} ;

Pi-iso-nat-gen (d c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) (s : Sub d c)
  (e : Id (Ty d) (subT d c (Pi c A T) s) (Pi d (subT d c A s) (subT (ext d (subT d c A s)) (ext c A) T (lift d c A s)))) :
  Id (El d (Pi d (subT d c A s) (subT (ext d (subT d c A s)) (ext c A) T (lift d c A s))))
     (subst (Ty d) (El d) (subT d c (Pi c A T) s)
            (Pi d (subT d c A s) (subT (ext d (subT d c A s)) (ext c A) T (lift d c A s)))
            e (subt d c (Pi c A T) (pi-inv c A T b) s))
     (pi-inv d (subT d c A s) (subT (ext d (subT d c A s)) (ext c A) T (lift d c A s))
        (subt (ext d (subT d c A s)) (ext c A) T b (lift d c A s))) =
  PiIsoNat[d,c,A,T,b,s].Gen[e].proof ;
