-- InitUniqBase.seg (PLAN-INIT, Part U): the statement of the induction.
-- For a model M' and two morphisms H, H' : Hom (mk e) M' (Part H, with
-- the term model shape of Part A), the predicate QJ on judgements:
--   QC G     = every class cls G w:            AgC H H' (cls G w)
--   QT G A   = every canonical class tT G A:    AgT at it
--   QE G a A = every canonical class tE G A a:  AgE at it
--   QS D s G = every canonical class tS D s G:  AgS at it
--   equality judgements: Top.
-- Helpers: AgTt/AgEt/AgSt (agreement at a point of the total space),
-- moves along paths of the total spaces (mvC mvT mvE mvS), propositions
-- (propC ...), and the IH at an arbitrary context/type (ihT-at ...).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitModelShape[l] ;
open InitUniqTot[l] ;

module Uq (e : Eqs) (M' : EM.TEModel[N]) {
  module Mo = InitHom.Morphism[l, N, mk e, M'] ;
  module HB = Mo.InitHomBase ;
  module HL = Mo.InitHomLaws ;
  module HS = Mo.InitHomStep ;

  module V (H H' : HL.Hom) {
    AgC (c : Ctx) : U l = HS.AgC H H' c ;
    AgTt (u : TotTy) : U l = HS.AgT H H' u.1 u.2 ;
    AgEt (u : TotTm) : U l = HS.AgE H H' u.1 u.2.1 u.2.2 ;
    AgSt (u : TotSub) : U l = HS.AgS H H' u.1 u.2.1 u.2.2 ;

    propC (c : Ctx) : isProp (AgC c) = HB.set-Ctx' (H.ctx c) (H'.ctx c) ;
    propT (u : TotTy) : isProp (AgTt u) =
      HB.set-TyT' (H.ctx u.1, H.ty u.1 u.2) (H'.ctx u.1, H'.ty u.1 u.2) ;
    propE (u : TotTm) : isProp (AgEt u) =
      HB.set-TmT' (H.ctx u.1, (H.ty u.1 u.2.1, H.tm u.1 u.2.1 u.2.2)) (H'.ctx u.1, (H'.ty u.1 u.2.1, H'.tm u.1 u.2.1 u.2.2)) ;
    propS (u : TotSub) : isProp (AgSt u) =
      HB.set-SubT' (H.ctx u.1, (H.ctx u.2.1, H.sub u.1 u.2.1 u.2.2)) (H'.ctx u.1, (H'.ctx u.2.1, H'.sub u.1 u.2.1 u.2.2)) ;

    mvC (c c' : Ctx) (p : Id Ctx c c') (x : AgC c) : AgC c' = subst Ctx AgC c c' p x ;
    mvT (u v : TotTy) (p : Id TotTy u v) (x : AgTt u) : AgTt v = subst TotTy AgTt u v p x ;
    mvE (u v : TotTm) (p : Id TotTm u v) (x : AgEt u) : AgEt v = subst TotTm AgEt u v p x ;
    mvS (u v : TotSub) (p : Id TotSub u v) (x : AgSt u) : AgSt v = subst TotSub AgSt u v p x ;

    QC (G : GE) : U l = (w : Pf (gjwf G)) -> AgC (cls G w) ;
    QT (G A : GE) : U l = (h : Pf (gjty G A)) (w : Pf (gjwf G)) -> AgTt (tT G A h w) ;
    QE (G a A : GE) : U l = (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) -> AgEt (tE G A a h hA w) ;
    QS (D s G : GE) : U l = (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) -> AgSt (tS D s G h wD wG) ;

    QJ : GJ -> U l = split {
      gjwf G -> QC G ;
      gjty G A -> QT G A ;
      gjtm G a A -> QE G a A ;
      gjsub D s G -> QS D s G ;
      gjeqcx G D -> Top ;
      gjeqty G A B -> Top ;
      gjeqtm G a b A -> Top ;
      gjeqsub D s t G -> Top } ;

    -- the induction hypotheses at any context (and type) with paths
    ihT-at (G A : GE) (ih : QT G A) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (c : Ctx) (pc : Id Ctx (cls G w) c) :
      HS.AgT H H' c (clsTy c G A h w pc) =
      mvT (tT G A h w) (c, clsTy c G A h w pc) (tT-gen G A h w c pc) (ih h w) ;
    ihE-at (G a A : GE) (ih : QE G a A) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
      (c : Ctx) (pc : Id Ctx (cls G w) c) (T : Ty c) (pT : Id (Ty c) (clsTy c G A hA w pc) T) :
      HS.AgE H H' c T (clsEl c T G A a h hA w pc pT) =
      mvE (tE G A a h hA w) (c, (T, clsEl c T G A a h hA w pc pT)) (tE-gen G A a h hA w c pc T pT) (ih h hA w) ;
    ihS-at (D s G : GE) (ih : QS D s G) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
      (d c : Ctx) (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c) :
      HS.AgS H H' d c (clsSub d c D s G h wD wG pd pc) =
      mvS (tS D s G h wD wG) (d, (c, clsSub d c D s G h wD wG pd pc)) (tS-gen D s G h wD wG d c pd pc) (ih h wD wG) ;
  } ;
} ;
