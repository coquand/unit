-- Action of the level lift on indices, members, and basic codes.
level k l ;
constraint k <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module S = IterativeSets[k] ;
module W = IterativeSets[l] ;
module L = IterativeSetLift[k,l] ;
module P = Prelude[l] ;
open IterativeSetPaths[l] ;

lift-index-M : (x : S.M) -> Id (U l) (S.Idx x) (W.Idx (L.liftM x)) = split {
  sup A f -> refl A } ;

lift-index (x : S.V) : Id (U l) (S.Ix x) (W.Ix (L.liftV x)) =
  lift-index-M x.1 ;

raise (x : S.V) (a : S.Ix x) : W.Ix (L.liftV x) =
  P.coe (S.Ix x) (W.Ix (L.liftV x)) (lift-index x) a ;

lower (x : S.V) (a : W.Ix (L.liftV x)) : S.Ix x =
  P.coe (W.Ix (L.liftV x)) (S.Ix x) (P.symU (S.Ix x) (W.Ix (L.liftV x)) (lift-index x)) a ;

raise-lower (x : S.V) (a : W.Ix (L.liftV x)) : Id (W.Ix (L.liftV x)) (raise x (lower x a)) a =
  P.coe-sym (S.Ix x) (W.Ix (L.liftV x)) (lift-index x) a ;

lift-member-M : (m : S.M) -> (h : S.isIt m) -> (a : S.Idx m) ->
    Id W.V (L.liftV (S.ev (m,h) a)) (W.ev (L.liftV (m,h)) (raise (m,h) a)) = split {
  sup A f -> \ h a ->
    code-path (L.liftV (S.ev (sup A f,h) a)) (W.ev (L.liftV (sup A f,h)) a)
      (refl (L.liftM (f a))) } ;

lift-member (x : S.V) (a : S.Ix x) : Id W.V (L.liftV (S.ev x a)) (W.ev (L.liftV x) (raise x a)) =
  lift-member-M x.1 x.2 a ;

lift-member-lower (x : S.V) (a : W.Ix (L.liftV x)) :
    Id W.V (L.liftV (S.ev x (lower x a))) (W.ev (L.liftV x) a) =
  transH (lift-member x (lower x a)) (apH (W.ev (L.liftV x)) (raise-lower x a)) ;

-- The root index of mkV and the member function of its lift are explicit.
lift-mkV (A : U k) (f : A -> S.V) (i : S.Inj A f)
    (j : W.Inj A (\ a -> L.liftV (f a))) :
    Id W.V (L.liftV (S.mkV A f i)) (W.mkV A (\ a -> L.liftV (f a)) j) =
  code-path (L.liftV (S.mkV A f i)) (W.mkV A (\ a -> L.liftV (f a)) j)
    (refl (sup A (\ a -> L.liftM (f a).1))) ;

lift-empty : Id W.V (L.liftV S.emptyV) W.emptyV =
  code-path (L.liftV S.emptyV) W.emptyV
    (apH (\ f -> sup Empty f)
      (funext Empty (\ e -> W.M) (\ e -> L.liftM (Prelude[k+].absurd S.V e).1)
        (\ e -> (absurd W.V e).1) (\ e -> absurd (Id W.M (L.liftM (Prelude[k+].absurd S.V e).1) (absurd W.V e).1) e))) ;

lift-sing (x : S.V) : Id W.V (L.liftV (S.sing x)) (W.sing (L.liftV x)) =
  code-path (L.liftV (S.sing x)) (W.sing (L.liftV x)) (refl (sup Top (\ t -> L.liftM x.1))) ;

lift-two-members (x : S.V) : (b : Bool) -> Id W.M (L.liftM (S.twoF x b).1) (W.twoF (L.liftV x) b).1 = split {
  true -> apH (\ v -> v.1) lift-empty ;
  false -> apH (\ v -> v.1) (lift-sing x) } ;

lift-two (x : S.V) : Id W.V (L.liftV (S.two x)) (W.two (L.liftV x)) =
  code-path (L.liftV (S.two x)) (W.two (L.liftV x))
    (apH (\ f -> sup Bool f)
      (funext Bool (\ b -> W.M) (\ b -> L.liftM (S.twoF x b).1) (\ b -> (W.twoF (L.liftV x) b).1) (lift-two-members x))) ;

lift-pair-members (x y : S.V) : (b : Bool) ->
    Id W.M (L.liftM (S.pairF x y b).1) (W.pairF (L.liftV x) (L.liftV y) b).1 = split {
  true -> apH (\ v -> v.1) (lift-sing x) ;
  false -> apH (\ v -> v.1) (lift-two y) } ;

lift-pair (x y : S.V) : Id W.V (L.liftV (S.pairV x y)) (W.pairV (L.liftV x) (L.liftV y)) =
  code-path (L.liftV (S.pairV x y)) (W.pairV (L.liftV x) (L.liftV y))
    (apH (\ f -> sup Bool f)
      (funext Bool (\ b -> W.M) (\ b -> L.liftM (S.pairF x y b).1)
        (\ b -> (W.pairF (L.liftV x) (L.liftV y) b).1) (lift-pair-members x y))) ;
