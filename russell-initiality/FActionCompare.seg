-- Action coherence, including the operand type erased from term action.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FSubstLaws[l] ; open FCtx[l] ; open FGen[l] ; open FSubTransport[l] ; open FCompareBase[l] ;

ty-action-frame (D G A s E H B t : FA) (ca : TyCompare A B) (cs : SubCompare s t) :
    TyFrameCompare (ftsb D G A s) (ftsb E H B t) =
  \ e p q -> compare e p.1 p.2 q.1 q.2
 where {
  compare (e : CE D E) (hA : Ty G A) (hs : Sb D s G) (hB : Ty H B) (ht : Sb E t H) :
      TE D (ftsb D G A s) (ftsb E H B t) =
    sub-frame-eq (wf-left D E e) (wf-right G H ss.1) e ss.1 hA (fpresup (fjeqty G A B) types).2.2
      types hs (fpresup (fjeqsub D s t G) ss.2).2.2.2 ss.2
   where {
    ss : CE G H * SE D s t G = cs D E G H e hs ht ;
    types : TE G A B = ca G H ss.1 hA hB ;
   } ;
 } ;

term-action-frame (D G A a s E H B b t : FA) (ca : TmCompare a b) (cs : SubCompare s t) :
    TmFrameCompare (fmsb D G A a s) (fmsb E H B b t) =
  \ e p q -> compare e p.1 p.2.1 p.2.2 q.2.1 q.2.2
 where {
  compare (e : CE D E) (hA : Ty G A) (ha : Tm' G a A) (hs : Sb D s G) (hb : Tm' H b B) (ht : Sb E t H) :
      TE D (ftsb D G A s) (ftsb E H B t) * ME D (fmsb D G A a s) (fmsb E H B b t) (ftsb D G A s) =
    (sub-frame-eq wD wH e ss.1 hA hB-left aa.1 hs ht-left ss.2,
      me-trans payload (me-trans at-type (me-trans at-target at-source)))
   where {
    ss : CE G H * SE D s t G = cs D E G H e hs ht ;
    aa : TE G A B * ME G a b A = ca G H A B ss.1 ha hb ;
    wD : W D = wf-left D E e ;
    wH : W H = wf-right G H ss.1 ;
    ht-left : Sb D t G = (fpresup (fjeqsub D s t G) ss.2).2.2.2 ;
    hb-A : Tm' G b A = (fpresup (fjeqtm G a b A) aa.2).2.2.2 ;
    hB-left : Ty G B = (fpresup (fjeqty G A B) aa.1).2.2 ;
    hb-left : Tm' G b B = tm-conv hb-A aa.1 ;
    hB-right : Ty H B = move-ty G H B ss.1 hB-left ;
    ht-target : Sb D t H = move-target D G H t ss.1 ht-left ;
    payload : ME D (fmsb D G A a s) (fmsb D G A b t) (ftsb D G A s) =
      fm-esb D G a b A s t hA ha aa.2 hs ht-left ss.2 ;
    at-type : ME D (fmsb D G A b t) (fmsb D G B b t) (ftsb D G A s) =
      me-conv (fm-sb-type D G b A t hA hb-A ht-left B aa.1) (ty-sym (sb-same-ty hA hs ht-left ss.2)) ;
    left-type : TE D (ftsb D G A s) (ftsb D G B t) = sb-ty-cong hA aa.1 hs ht-left ss.2 ;
    at-target : ME D (fmsb D G B b t) (fmsb D H B b t) (ftsb D G A s) =
      me-conv (fm-sb-target D G b B t hB-left hb-left ht-left H ss.1) (ty-sym left-type) ;
    at-source : ME D (fmsb D H B b t) (fmsb E H B b t) (ftsb D G A s) =
      fm-eqconv D (fmsb D H B b t) (fmsb E H B b t) (ftsb D H B t) (ftsb D G A s)
        (fm-sb-source D H b B t hB-right (move-tm G H b B ss.1 hb-left) ht-target E e)
        (ty-sym (ty-trans {D} {ftsb D G A s} {ftsb D G B t} {ftsb D H B t}
          left-type (fe-sb-target D G B t hB-left ht-left H ss.1))) ;
   } ;
 } ;

q-frame-compare (G A H B : FA) : TmFrameCompare (fq G A) (fq H B) =
  \ e hA hB -> compare e hA (cx-ext-inv G A H B e)
 where {
  compare (e : CE (fext G A) (fext H B)) (hA : Ty G A) (p : CE G H * TE G A B) :
      TE (fext G A) (ftsb (fext G A) G A (fp G A)) (ftsb (fext H B) H B (fp H B)) *
      ME (fext G A) (fq G A) (fq H B) (ftsb (fext G A) G A (fp G A)) =
    (sub-frame-eq (wf-left (fext G A) (fext H B) e) (wf-right G H p.1) e p.1
      hA (fpresup (fjeqty G A B) p.2).2.2 p.2 (p-sub hA)
      (fpresup (fjeqsub (fext G A) (fp G A) (fp H B) G) projections).2.2.2 projections,
     fm-q-cx G H A B p.1 p.2)
   where { projections : SE (fext G A) (fp G A) (fp H B) G = fq-p-cx G H A B p.1 p.2 ; } ;
 } ;
