-- Formation and conversion derived from the closed Cartmell rules.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open CGAT[l] ; open CPresup[l] ;

W (G : FA) : U l = CDer (fjwf G) ;
Ty (G A : FA) : U l = CDer (fjty G A) ;
Tm' (G a A : FA) : U l = CDer (fjtm G a A) ;
Sb (D s G : FA) : U l = CDer (fjsub D s G) ;
CE (G H : FA) : U l = CDer (fjeqcx G H) ;
TE (G A B : FA) : U l = CDer (fjeqty G A B) ;
SE (D s t G : FA) : U l = CDer (fjeqsub D s t G) ;

ty-wf {G A : FA} (h : Ty G A) : W G = cpresup (fjty G A) h ;
tm-ty {G a A : FA} (h : Tm' G a A) : Ty G A = (cpresup (fjtm G a A) h).2 ;
sub-source-wf {D s G : FA} (h : Sb D s G) : W D = (cpresup (fjsub D s G) h).1 ;
sub-target-wf {D s G : FA} (h : Sb D s G) : W G = (cpresup (fjsub D s G) h).2 ;

cx-refl {G : FA} (w : W G) : CE G G = c-refl-ctx G w ;
ty-refl {G A : FA} (h : Ty G A) : TE G A A = c-refl-ty G A h ;
ty-sym {G A B : FA} (h : TE G A B) : TE G B A = c-sym-ty G A B h ;
ty-trans {G A B C : FA} (h : TE G A B) (k : TE G B C) : TE G A C = c-trans-ty G A B C h k ;
ext-wf {G A : FA} (h : Ty G A) : W (fext G A) = c-fext G A (ty-wf h) h ;
ext-eq {G H A B : FA} (p : CE G H) (q : TE G A B) : CE (fext G A) (fext H B) = c-eq-fext G A H B p q ;
tm-conv {G a A B : FA} (h : Tm' G a A) (e : TE G A B) : Tm' G a B =
  c-conv-tm G A G B a (cx-refl (ty-wf (tm-ty h))) e h ;

id-sub {G : FA} (w : W G) : Sb G (fid G) G = c-fid G w ;
comp-sub {T D G s d : FA} (hs : Sb D s G) (hd : Sb T d D) : Sb T (fcomp T D G s d) G =
  c-fcomp T D G s d (sub-source-wf hd) (sub-source-wf hs) (sub-target-wf hs) hs hd ;
ty-sub {D G A s : FA} (hA : Ty G A) (hs : Sb D s G) : Ty D (ftsb D G A s) =
  c-ftsb D G A s (sub-source-wf hs) (ty-wf hA) hA hs ;
tm-sub {D G A a s : FA} (hA : Ty G A) (ha : Tm' G a A) (hs : Sb D s G) :
    Tm' D (fmsb D G A a s) (ftsb D G A s) = c-fmsb D G A a s (sub-source-wf hs) (ty-wf hA) hA ha hs ;
p-sub {G A : FA} (hA : Ty G A) : Sb (fext G A) (fp G A) G = c-fp G A (ty-wf hA) hA ;
q-tm {G A : FA} (hA : Ty G A) : Tm' (fext G A) (fq G A) (ftsb (fext G A) G A (fp G A)) =
  c-fq G A (ty-wf hA) hA ;
lift-sub {D G A s : FA} (hA : Ty G A) (hs : Sb D s G) : Sb (fext D (ftsb D G A s)) (flift D G A s) (fext G A) =
  c-flift D G A s (sub-source-wf hs) (ty-wf hA) hA hs ;
sec-sub {G A a : FA} (hA : Ty G A) (ha : Tm' G a A) : Sb G (fsec G A a) (fext G A) =
  c-fsec G A a (ty-wf hA) hA ha ;
pi-ty {G A B : FA} (hA : Ty G A) (hB : Ty (fext G A) B) : Ty G (fpi G A B) = c-fpi G A B (ty-wf hA) hA hB ;
lam-tm {G A B b : FA} (hA : Ty G A) (hB : Ty (fext G A) B) (hb : Tm' (fext G A) b B) :
    Tm' G (flam G A B b) (fpi G A B) = c-flam G A B b (ty-wf hA) hA hB hb ;
app-tm {G A B c a : FA} (hA : Ty G A) (hB : Ty (fext G A) B) (hc : Tm' G c (fpi G A B)) (ha : Tm' G a A) :
    Tm' G (fapp G A B c a) (ftsb G (fext G A) B (fsec G A a)) = c-fapp G A B c a (ty-wf hA) hA hB hc ha ;

sb-same-ty {D G A s t : FA} (hA : Ty G A) (e : SE D s t G) : TE D (ftsb D G A s) (ftsb D G A t) =
  c-eq-ftsb D G A s D G A t (cx-refl (cpresup (fjeqsub D s t G) e).1) (cx-refl (ty-wf hA)) (ty-refl hA) e ;

move-universe (n : Nat) {G H a : FA} (e : CE G H) (nb : LeN n N) (h : Tm' G a (fuu n G)) : Tm' H a (fuu n H) =
  c-conv-tm G (fuu n G) H (fuu n H) a e (c-eq-fuu n G H e nb) h ;
