-- InitHomRelB: relational form of the laws for products (Pi, lam = Pi-iso.inv,
-- and the DERIVED law for Pi-iso.fun) and universes (univ, decode, pic,
-- uc, lf); canonical images of data over extended contexts.
-- Segment of InitHom.Morphism (l, N, M, M').  Conventions as InitHomRelA;
-- a code a : El G (univ n G) is related to a code a' : El' X (univ' n X)
-- by RTm H G (univ n G) a (iota n (X, a')).
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
open InitHomBase ;
open InitHomLaws ;

------------------------------------------------------------------------
-- canonical images: data of M over ext G A, moved along ctx-ext

canon-ty-ext (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A))
  : RTy H (C.ext G A) B (H.ext' G A, H.mv-ty G A B) =
  tot-mvTy (H.ctx (C.ext G A)) (H.ext' G A) (H.ctx-ext G A) (H.ty (C.ext G A) B) ;

canon-tm-ext (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B)
  : RTm H (C.ext G A) B b (H.ext' G A, (H.mv-ty G A B, H.mv-el G A B b)) =
  tot-mvEl (H.ctx (C.ext G A)) (H.ext' G A) (H.ctx-ext G A) (H.ty (C.ext G A) B) (H.tm (C.ext G A) B b) ;

-- the image of a code is related to its code
code-rel (H : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
  : RTm H G (M.univ n G) a (iota n (H.ctx G, H.code n G a)) =
  ap (Term' (H.ctx G)) TmT' (\ v -> (H.ctx G, v))
    (H.ty G (M.univ n G), H.tm G (M.univ n G) a) (M'.univ n (H.ctx G), H.code n G a)
    (tot-subst (C'.Ty (H.ctx G)) (C'.El (H.ctx G)) (H.ty G (M.univ n G)) (M'.univ n (H.ctx G))
       (H.ty-univ n G) (H.tm G (M.univ n G) a)) ;

-- a code related to a' gives a path of codes
code-path (H : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (X : C'.Ctx) (a' : CodeF' n X) (ea : RTm H G (M.univ n G) a (iota n (X, a')))
  : Id (CodeT' n) (H.ctx G, H.code n G a) (X, a') =
  iota-inj n (H.ctx G) X (H.code n G a) a'
    (trans TmT' (iota n (H.ctx G, H.code n G a)) (H.ctx G, (H.ty G (M.univ n G), H.tm G (M.univ n G) a))
       (iota n (X, a'))
       (sym TmT' (H.ctx G, (H.ty G (M.univ n G), H.tm G (M.univ n G) a)) (iota n (H.ctx G, H.code n G a))
          (code-rel H n G a))
       ea) ;

canon-code-ext (H : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))))
  : RTm H (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) b
      (iota n (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a)), H.mv-code n G a b)) =
  trans TmT' (H.ctx (C.ext G (M.decode n G a)),
              (H.ty (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))),
               H.tm (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) b))
    (iota n (H.ctx (C.ext G (M.decode n G a)), H.code n (C.ext G (M.decode n G a)) b))
    (iota n (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a)), H.mv-code n G a b))
    (code-rel H n (C.ext G (M.decode n G a)) b)
    (ap (CodeT' n) TmT' (iota n)
       (H.ctx (C.ext G (M.decode n G a)), H.code n (C.ext G (M.decode n G a)) b)
       (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a)), H.mv-code n G a b)
       (tot-mvCode n (H.ctx (C.ext G (M.decode n G a))) (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a)))
          (H.dec-ext n G a) (H.code n (C.ext G (M.decode n G a)) b))) ;

------------------------------------------------------------------------
-- products

rel-Pi-base (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A))
    (B' : C'.Ty (H.ext' G A)) (eB : RTy H (C.ext G A) B (H.ext' G A, B'))
  : RTy H G (P.Pi G A B) (H.ctx G, P'.Pi (H.ctx G) (H.ty G A) B') =
  idJ (C'.Ty (H.ext' G A)) (H.mv-ty G A B)
    (\ B2 e2 -> RTy H G (P.Pi G A B) (H.ctx G, P'.Pi (H.ctx G) (H.ty G A) B2))
    (ap (C'.Ty (H.ctx G)) TyT' (\ T -> (H.ctx G, T))
        (H.ty G (P.Pi G A B)) (P'.Pi (H.ctx G) (H.ty G A) (H.mv-ty G A B)) (H.ty-Pi G A B))
    B' (fibe C'.Ctx set-Ctx' C'.Ty (H.ctx (C.ext G A)) (H.ext' G A) (H.ctx-ext G A)
          (H.ty (C.ext G A) B) B' eB) ;

rel-Pi (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A))
    (X : C'.Ctx) (A' : C'.Ty X) (B' : C'.Ty (C'.ext X A'))
    (eA : RTy H G A (X, A')) (eB : RTy H (C.ext G A) B (C'.ext X A', B'))
  : RTy H G (P.Pi G A B) (X, P'.Pi X A' B') =
  idJ TyT' (H.ctx G, H.ty G A)
    (\ w e1 -> (B1 : C'.Ty (C'.ext w.1 w.2)) -> RTy H (C.ext G A) B (C'.ext w.1 w.2, B1)
               -> RTy H G (P.Pi G A B) (w.1, P'.Pi w.1 w.2 B1))
    (rel-Pi-base H G A B)
    (X, A') eA B' eB ;

rel-lam-base (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B)
    (u : Term' (H.ext' G A)) (eb : RTm H (C.ext G A) B b (H.ext' G A, u))
  : RTm H G (P.Pi G A B) ((P.Pi-iso G A B).inv b)
      (H.ctx G, (P'.Pi (H.ctx G) (H.ty G A) u.1, (P'.Pi-iso (H.ctx G) (H.ty G A) u.1).inv u.2)) =
  idJ (Term' (H.ext' G A)) (H.mv-ty G A B, H.mv-el G A B b)
    (\ u2 e2 -> RTm H G (P.Pi G A B) ((P.Pi-iso G A B).inv b)
      (H.ctx G, (P'.Pi (H.ctx G) (H.ty G A) u2.1, (P'.Pi-iso (H.ctx G) (H.ty G A) u2.1).inv u2.2)))
    (ap (Term' (H.ctx G)) TmT' (\ v -> (H.ctx G, v))
        (H.ty G (P.Pi G A B), H.tm G (P.Pi G A B) ((P.Pi-iso G A B).inv b))
        (P'.Pi (H.ctx G) (H.ty G A) (H.mv-ty G A B),
         (P'.Pi-iso (H.ctx G) (H.ty G A) (H.mv-ty G A B)).inv (H.mv-el G A B b))
        (H.tm-lam G A B b))
    u (fibTm (H.ext' G A) (H.mv-ty G A B, H.mv-el G A B b) u
         (trans TmT' (H.ext' G A, (H.mv-ty G A B, H.mv-el G A B b))
            (H.ctx (C.ext G A), (H.ty (C.ext G A) B, H.tm (C.ext G A) B b)) (H.ext' G A, u)
            (sym TmT' (H.ctx (C.ext G A), (H.ty (C.ext G A) B, H.tm (C.ext G A) B b))
                 (H.ext' G A, (H.mv-ty G A B, H.mv-el G A B b)) (canon-tm-ext H G A B b))
            eb)) ;

rel-lam (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B)
    (X : C'.Ctx) (A' : C'.Ty X) (B' : C'.Ty (C'.ext X A')) (b' : C'.El (C'.ext X A') B')
    (eA : RTy H G A (X, A')) (eb : RTm H (C.ext G A) B b (C'.ext X A', (B', b')))
  : RTm H G (P.Pi G A B) ((P.Pi-iso G A B).inv b) (X, (P'.Pi X A' B', (P'.Pi-iso X A' B').inv b')) =
  idJ TyT' (H.ctx G, H.ty G A)
    (\ w e1 -> (u : Term' (C'.ext w.1 w.2)) -> RTm H (C.ext G A) B b (C'.ext w.1 w.2, u)
               -> RTm H G (P.Pi G A B) ((P.Pi-iso G A B).inv b)
                    (w.1, (P'.Pi w.1 w.2 u.1, (P'.Pi-iso w.1 w.2 u.1).inv u.2)))
    (rel-lam-base H G A B b)
    (X, A') eA (B', b') eb ;

-- the law for Pi-iso.fun is derived from the law for Pi-iso.inv
rel-fun (H : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f : C.El G (P.Pi G A B))
    (X : C'.Ctx) (A' : C'.Ty X) (B' : C'.Ty (C'.ext X A')) (f' : C'.El X (P'.Pi X A' B'))
    (eA : RTy H G A (X, A')) (eB : RTy H (C.ext G A) B (C'.ext X A', B'))
    (ef : RTm H G (P.Pi G A B) f (X, (P'.Pi X A' B', f')))
  : RTm H (C.ext G A) B ((P.Pi-iso G A B).fun f) (C'.ext X A', (B', (P'.Pi-iso X A' B').fun f')) =
  trans TmT' (H.ctx (C.ext G A), (H.ty (C.ext G A) B, H.tm (C.ext G A) B g))
    (C'.ext X A', (B', le.1)) (C'.ext X A', (B', (P'.Pi-iso X A' B').fun f'))
    le.2
    (ap (C'.El (C'.ext X A') B') TmT' (\ y -> (C'.ext X A', (B', y)))
        le.1 ((P'.Pi-iso X A' B').fun f')
        (sym (C'.El (C'.ext X A') B') ((P'.Pi-iso X A' B').fun f') le.1 r5))
  where {
    g : C.El (C.ext G A) B = (P.Pi-iso G A B).fun f ;
    le : (b' : C'.El (C'.ext X A') B') * RTm H (C.ext G A) B g (C'.ext X A', (B', b')) =
      lift-el (H.ctx (C.ext G A)) (H.ty (C.ext G A) B) (H.tm (C.ext G A) B g) (C'.ext X A', B') eB ;
    w0 : TmT' = (X, (P'.Pi X A' B', (P'.Pi-iso X A' B').inv le.1)) ;
    r1 : RTm H G (P.Pi G A B) ((P.Pi-iso G A B).inv g) w0 =
      rel-lam H G A B g X A' B' le.1 eA le.2 ;
    r2 : RTm H G (P.Pi G A B) f w0 =
      subst (C.El G (P.Pi G A B)) (\ c -> RTm H G (P.Pi G A B) c w0)
        ((P.Pi-iso G A B).inv g) f ((P.Pi-iso G A B).inv-fun f) r1 ;
    r3 : Id TmT' (X, (P'.Pi X A' B', f')) w0 =
      trans TmT' (X, (P'.Pi X A' B', f')) (H.ctx G, (H.ty G (P.Pi G A B), H.tm G (P.Pi G A B) f)) w0
        (sym TmT' (H.ctx G, (H.ty G (P.Pi G A B), H.tm G (P.Pi G A B) f)) (X, (P'.Pi X A' B', f')) ef)
        r2 ;
    r4 : Id (C'.El X (P'.Pi X A' B')) f' ((P'.Pi-iso X A' B').inv le.1) =
      fibEl X (P'.Pi X A' B') f' ((P'.Pi-iso X A' B').inv le.1)
        (fibTm X (P'.Pi X A' B', f') (P'.Pi X A' B', (P'.Pi-iso X A' B').inv le.1) r3) ;
    r5 : Id (C'.El (C'.ext X A') B') ((P'.Pi-iso X A' B').fun f') le.1 =
      trans (C'.El (C'.ext X A') B') ((P'.Pi-iso X A' B').fun f')
        ((P'.Pi-iso X A' B').fun ((P'.Pi-iso X A' B').inv le.1)) le.1
        (ap (C'.El X (P'.Pi X A' B')) (C'.El (C'.ext X A') B') (P'.Pi-iso X A' B').fun
            f' ((P'.Pi-iso X A' B').inv le.1) r4)
        ((P'.Pi-iso X A' B').fun-inv le.1) ;
  } ;

------------------------------------------------------------------------
-- universes

rel-univ (H : Hom) (n : LevelAt N) (G : C.Ctx) (X : C'.Ctx) (e : RCtx H G X)
  : RTy H G (M.univ n G) (X, M'.univ n X) =
  idJ C'.Ctx (H.ctx G) (\ Z e1 -> RTy H G (M.univ n G) (Z, M'.univ n Z))
    (ap (C'.Ty (H.ctx G)) TyT' (\ T -> (H.ctx G, T))
        (H.ty G (M.univ n G)) (M'.univ n (H.ctx G)) (H.ty-univ n G))
    X e ;

rel-decode (H : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (X : C'.Ctx) (a' : CodeF' n X) (ea : RTm H G (M.univ n G) a (iota n (X, a')))
  : RTy H G (M.decode n G a) (X, M'.decode n X a') =
  idJ (CodeT' n) (H.ctx G, H.code n G a)
    (\ v e1 -> RTy H G (M.decode n G a) (v.1, M'.decode n v.1 v.2))
    (ap (C'.Ty (H.ctx G)) TyT' (\ T -> (H.ctx G, T))
        (H.ty G (M.decode n G a)) (M'.decode n (H.ctx G) (H.code n G a)) (H.ty-decode n G a))
    (X, a') (code-path H n G a X a' ea) ;

rel-pic-base (H : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))))
    (b' : CodeF' n (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a))))
    (eb : RTm H (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) b
            (iota n (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a)), b')))
  : RTm H G (M.univ n G) (M.pic n G a b) (iota n (H.ctx G, M'.pic n (H.ctx G) (H.code n G a) b')) =
  idJ (CodeF' n (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a)))) (H.mv-code n G a b)
    (\ b2 e2 -> RTm H G (M.univ n G) (M.pic n G a b) (iota n (H.ctx G, M'.pic n (H.ctx G) (H.code n G a) b2)))
    (trans TmT' (H.ctx G, (H.ty G (M.univ n G), H.tm G (M.univ n G) (M.pic n G a b)))
       (iota n (H.ctx G, H.code n G (M.pic n G a b)))
       (iota n (H.ctx G, M'.pic n (H.ctx G) (H.code n G a) (H.mv-code n G a b)))
       (code-rel H n G (M.pic n G a b))
       (ap (CodeF' n (H.ctx G)) TmT' (\ c -> iota n (H.ctx G, c))
           (H.code n G (M.pic n G a b)) (M'.pic n (H.ctx G) (H.code n G a) (H.mv-code n G a b))
           (H.tm-pic n G a b)))
    b' (fibe C'.Ctx set-Ctx' (CodeF' n) (H.ctx (C.ext G (M.decode n G a)))
          (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a))) (H.dec-ext n G a)
          (H.code n (C.ext G (M.decode n G a)) b) b'
          (code-path H n (C.ext G (M.decode n G a)) b
             (C'.ext (H.ctx G) (M'.decode n (H.ctx G) (H.code n G a))) b' eb)) ;

rel-pic (H : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))))
    (X : C'.Ctx) (a' : CodeF' n X) (b' : CodeF' n (C'.ext X (M'.decode n X a')))
    (ea : RTm H G (M.univ n G) a (iota n (X, a')))
    (eb : RTm H (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) b
            (iota n (C'.ext X (M'.decode n X a'), b')))
  : RTm H G (M.univ n G) (M.pic n G a b) (iota n (X, M'.pic n X a' b')) =
  idJ (CodeT' n) (H.ctx G, H.code n G a)
    (\ v e1 -> (b1 : CodeF' n (C'.ext v.1 (M'.decode n v.1 v.2)))
               -> RTm H (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) b
                    (iota n (C'.ext v.1 (M'.decode n v.1 v.2), b1))
               -> RTm H G (M.univ n G) (M.pic n G a b) (iota n (v.1, M'.pic n v.1 v.2 b1)))
    (rel-pic-base H n G a b)
    (X, a') (code-path H n G a X a' ea) b' eb ;

rel-uc (H : Hom) (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (X : C'.Ctx) (e : RCtx H G X)
  : RTm H G (M.univ n G) (M.uc m n lt G) (iota n (X, M'.uc m n lt X)) =
  idJ C'.Ctx (H.ctx G) (\ Z e1 -> RTm H G (M.univ n G) (M.uc m n lt G) (iota n (Z, M'.uc m n lt Z)))
    (trans TmT' (H.ctx G, (H.ty G (M.univ n G), H.tm G (M.univ n G) (M.uc m n lt G)))
       (iota n (H.ctx G, H.code n G (M.uc m n lt G)))
       (iota n (H.ctx G, M'.uc m n lt (H.ctx G)))
       (code-rel H n G (M.uc m n lt G))
       (ap (CodeF' n (H.ctx G)) TmT' (\ c -> iota n (H.ctx G, c))
           (H.code n G (M.uc m n lt G)) (M'.uc m n lt (H.ctx G)) (H.tm-uc m n lt G)))
    X e ;

rel-lf (H : Hom) (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (a : C.El G (M.univ m G))
    (X : C'.Ctx) (a' : CodeF' m X) (ea : RTm H G (M.univ m G) a (iota m (X, a')))
  : RTm H G (M.univ n G) (M.lf m n lt G a) (iota n (X, M'.lf m n lt X a')) =
  idJ (CodeT' m) (H.ctx G, H.code m G a)
    (\ v e1 -> RTm H G (M.univ n G) (M.lf m n lt G a) (iota n (v.1, M'.lf m n lt v.1 v.2)))
    (trans TmT' (H.ctx G, (H.ty G (M.univ n G), H.tm G (M.univ n G) (M.lf m n lt G a)))
       (iota n (H.ctx G, H.code n G (M.lf m n lt G a)))
       (iota n (H.ctx G, M'.lf m n lt (H.ctx G) (H.code m G a)))
       (code-rel H n G (M.lf m n lt G a))
       (ap (CodeF' n (H.ctx G)) TmT' (\ c -> iota n (H.ctx G, c))
           (H.code n G (M.lf m n lt G a)) (M'.lf m n lt (H.ctx G) (H.code m G a)) (H.tm-lf m n lt G a)))
    (X, a') (code-path H m G a X a' ea) ;
