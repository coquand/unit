-- Witnesses for the eight bare judgement shapes and transport to fixed contexts.
level l ;
open Base ; open Lib[l] ; open GAT[l] ; open AGAT[l] ; open AForget[l] ;
open APresup[l] ; open ACtx[l] ; open AUniq[l] ; open AShape[l] ; open ALiftExpr[l] ;

record LiftCx { G : GE ; e : LiftExpr[G] ; ok : W e.t } ;
record LiftTy { G : GE ; A : GE ; c : LiftCx[G] ; a : LiftExpr[A] ; d : Ty c.e.t a.t } ;
record LiftTm { G : GE ; a : GE ; A : GE ; c : LiftCx[G] ; x : LiftExpr[a] ; t : LiftExpr[A] ; d : Tm' c.e.t x.t t.t } ;
record LiftSub { D : GE ; s : GE ; G : GE ; c : LiftCx[D] ; k : LiftCx[G] ; x : LiftExpr[s] ; d : Sb c.e.t x.t k.e.t } ;
record LiftCE { G : GE ; H : GE ; c : LiftCx[G] ; k : LiftCx[H] ; d : CE c.e.t k.e.t } ;
record LiftTE { G : GE ; A : GE ; B : GE ; c : LiftCx[G] ; a : LiftExpr[A] ; b : LiftExpr[B] ; d : TE c.e.t a.t b.t } ;
record LiftME { G : GE ; a : GE ; b : GE ; A : GE ; c : LiftCx[G] ; x : LiftExpr[a] ; y : LiftExpr[b] ;
    t : LiftExpr[A] ; d : ME c.e.t x.t y.t t.t } ;
record LiftSE { D : GE ; s : GE ; t : GE ; G : GE ; c : LiftCx[D] ; k : LiftCx[G] ;
    x : LiftExpr[s] ; y : LiftExpr[t] ; d : SE c.e.t x.t y.t k.e.t } ;

LiftJ : GJ -> U l = split {
  gjwf G -> LiftCx[G] ;
  gjty G A -> LiftTy[G,A] ;
  gjtm G a A -> LiftTm[G,a,A] ;
  gjsub D s G -> LiftSub[D,s,G] ;
  gjeqcx G H -> LiftCE[G,H] ;
  gjeqty G A B -> LiftTE[G,A,B] ;
  gjeqtm G a b A -> LiftME[G,a,b,A] ;
  gjeqsub D s t G -> LiftSE[D,s,t,G] } ;

put-wf (G : GE) (e : LiftExpr[G]) (h : W e.t) : LiftCx[G] = new LiftCx[G,e := e,ok := h] ;
put-ty (G A : GE) (e : LiftExpr[G]) (a : LiftExpr[A]) (h : Ty e.t a.t) : LiftTy[G,A] =
  new LiftTy[G,A,c := put-wf G e (apresup (ajty e.t a.t) h),a := a,d := h] ;
put-tm (G a A : GE) (e : LiftExpr[G]) (x : LiftExpr[a]) (t : LiftExpr[A]) (h : Tm' e.t x.t t.t) : LiftTm[G,a,A] =
  new LiftTm[G,a,A,c := put-wf G e (apresup (ajtm e.t x.t t.t) h).1,x := x,t := t,d := h] ;
put-sub (D s G : GE) (e : LiftExpr[D]) (x : LiftExpr[s]) (g : LiftExpr[G]) (h : Sb e.t x.t g.t) : LiftSub[D,s,G] =
  new LiftSub[D,s,G,c := put-wf D e p.1,k := put-wf G g p.2,x := x,d := h]
  where { p : APJ (ajsub e.t x.t g.t) = apresup (ajsub e.t x.t g.t) h ; } ;
put-ce (G H : GE) (e : LiftExpr[G]) (g : LiftExpr[H]) (h : CE e.t g.t) : LiftCE[G,H] =
  new LiftCE[G,H,c := put-wf G e (wf-left e.t g.t h),k := put-wf H g (wf-right e.t g.t h),d := h] ;
put-te (G A B : GE) (e : LiftExpr[G]) (a : LiftExpr[A]) (b : LiftExpr[B]) (h : TE e.t a.t b.t) : LiftTE[G,A,B] =
  new LiftTE[G,A,B,c := put-wf G e (apresup (ajeqty e.t a.t b.t) h).1,a := a,b := b,d := h] ;
put-me (G a b A : GE) (e : LiftExpr[G]) (x : LiftExpr[a]) (y : LiftExpr[b]) (t : LiftExpr[A]) (h : ME e.t x.t y.t t.t) :
    LiftME[G,a,b,A] =
  new LiftME[G,a,b,A,c := put-wf G e (apresup (ajeqtm e.t x.t y.t t.t) h).1,x := x,y := y,t := t,d := h] ;
put-se (D s t G : GE) (e : LiftExpr[D]) (x : LiftExpr[s]) (y : LiftExpr[t]) (g : LiftExpr[G]) (h : SE e.t x.t y.t g.t) :
    LiftSE[D,s,t,G] =
  new LiftSE[D,s,t,G,c := put-wf D e p.1,k := put-wf G g p.2.1,x := x,y := y,d := h]
  where { p : APJ (ajeqsub e.t x.t y.t g.t) = apresup (ajeqsub e.t x.t y.t g.t) h ; } ;

at-ext (G A : GE) (c : LiftCx[G]) (a : LiftExpr[A]) (h : Ty c.e.t a.t) : LiftCx[gext G A] =
  put-wf (gext G A) (e-ext G A c.e a) (a-ext c.e.t a.t h) ;

same-image (raw : GE) (x y : LiftExpr[raw]) : Id GE (fg x.t) (fg y.t) =
  Prelude[l].trans GE (fg x.t) raw (fg y.t) x.image (Prelude[l].sym GE (fg y.t) raw y.image) ;

cx-align (G : GE) (p q : LiftCx[G]) : CE p.e.t q.e.t =
  same-cx p.e.t q.e.t (same-image G p.e q.e) p.ok q.ok ;

ty-align (G A : GE) (c : LiftCx[G]) (p q : LiftExpr[A]) (hp : Ty c.e.t p.t) (hq : Ty c.e.t q.t) : TE c.e.t p.t q.t =
  same-ty p.t q.t (same-image A p q) c.e.t c.e.t (ac-refl c.e.t c.ok) hp hq ;

tm-align (G a A : GE) (c : LiftCx[G]) (p q : LiftExpr[a]) (T : LiftExpr[A])
    (hp : Tm' c.e.t p.t T.t) (hq : Tm' c.e.t q.t T.t) : ME c.e.t p.t q.t T.t =
  (same-tm p.t q.t (same-image a p q) c.e.t c.e.t T.t T.t (ac-refl c.e.t c.ok) hp hq).2 ;

sub-align (D s G : GE) (c : LiftCx[D]) (k : LiftCx[G]) (p q : LiftExpr[s]) (hp : Sb c.e.t p.t k.e.t) (hq : Sb c.e.t q.t k.e.t) :
    SE c.e.t p.t q.t k.e.t =
  (same-sub p.t q.t (same-image s p q) c.e.t c.e.t k.e.t k.e.t (ac-refl c.e.t c.ok) hp hq).2 ;

at-ty (G A : GE) (r : LiftTy[G,A]) (c : LiftCx[G]) : Ty c.e.t r.a.t =
  move-ty r.c.e.t c.e.t r.a.t (cx-align G r.c c) r.d ;

at-tm (G a A : GE) (r : LiftTm[G,a,A]) (c : LiftCx[G]) : Tm' c.e.t r.x.t r.t.t =
  move-tm r.c.e.t c.e.t r.x.t r.t.t (cx-align G r.c c) r.d ;

at-sub (D s G : GE) (r : LiftSub[D,s,G]) (c : LiftCx[D]) (k : LiftCx[G]) : Sb c.e.t r.x.t k.e.t =
  move-sub r.c.e.t c.e.t r.k.e.t k.e.t r.x.t (cx-align D r.c c) (cx-align G r.k k) r.d ;

at-ce (G H : GE) (r : LiftCE[G,H]) (c : LiftCx[G]) (k : LiftCx[H]) : CE c.e.t k.e.t =
  a-cx-trans c.e.t r.c.e.t k.e.t (cx-align G c r.c)
    (a-cx-trans r.c.e.t r.k.e.t k.e.t r.d (cx-align H r.k k)) ;

at-te (G A B : GE) (r : LiftTE[G,A,B]) (c : LiftCx[G]) : TE c.e.t r.a.t r.b.t =
  move-te r.c.e.t c.e.t r.a.t r.b.t (cx-align G r.c c) r.d ;

at-me (G a b A : GE) (r : LiftME[G,a,b,A]) (c : LiftCx[G]) : ME c.e.t r.x.t r.y.t r.t.t =
  move-me r.c.e.t c.e.t r.x.t r.y.t r.t.t (cx-align G r.c c) r.d ;

at-se (D s t G : GE) (r : LiftSE[D,s,t,G]) (c : LiftCx[D]) (k : LiftCx[G]) : SE c.e.t r.x.t r.y.t k.e.t =
  move-se r.c.e.t c.e.t r.k.e.t k.e.t r.x.t r.y.t (cx-align D r.c c) (cx-align G r.k k) r.d ;

tm-at-type (G a A : GE) (r : LiftTm[G,a,A]) (c : LiftCx[G]) (A' : LiftExpr[A]) (h : Ty c.e.t A'.t) :
    Tm' c.e.t r.x.t A'.t =
  am-conv c.e.t r.x.t r.t.t A'.t r' (ty-align G A c r.t A' (apresup (ajtm c.e.t r.x.t r.t.t) r').2 h)
  where { r' : Tm' c.e.t r.x.t r.t.t = at-tm G a A r c ; } ;

me-at-type (G a b A : GE) (r : LiftME[G,a,b,A]) (c : LiftCx[G]) (A' : LiftExpr[A]) (h : Ty c.e.t A'.t) :
    ME c.e.t r.x.t r.y.t A'.t =
  am-eqconv c.e.t r.x.t r.y.t r.t.t A'.t r' (ty-align G A c r.t A' (apresup (ajeqtm c.e.t r.x.t r.y.t r.t.t) r').2.1 h)
  where { r' : ME c.e.t r.x.t r.y.t r.t.t = at-me G a b A r c ; } ;

lift-uu-bound (G : GA) (n : Nat) (A : LiftExpr[guu n]) (h : Ty G A.t) : LeN n N =
  a-universe-bound G v.1 n (Prelude[l].subst GA (\ X -> Ty G X) A.t (auu n v.1)
    (Prelude[l].sym GA (auu n v.1) A.t v.2) h)
  where { v : Repr (guu n) A.t = shape-view (guu n) A.t A.image ; } ;

tm-bound (G a : GE) (n : Nat) (r : LiftTm[G,a,guu n]) : LeN n N =
  lift-uu-bound r.c.e.t n r.t (apresup (ajtm r.c.e.t r.x.t r.t.t) r.d).2 ;

me-bound (G a b : GE) (n : Nat) (r : LiftME[G,a,b,guu n]) : LeN n N =
  lift-uu-bound r.c.e.t n r.t (apresup (ajeqtm r.c.e.t r.x.t r.y.t r.t.t) r.d).2.1 ;

tm-at-uu (G a : GE) (n : Nat) (r : LiftTm[G,a,guu n]) (c : LiftCx[G]) : Tm' c.e.t r.x.t (auu n c.e.t) =
  tm-at-type G a (guu n) r c (e-uu n G c.e) (at-uu c.e.t n c.ok (tm-bound G a n r)) ;

me-at-uu (G a b : GE) (n : Nat) (r : LiftME[G,a,b,guu n]) (c : LiftCx[G]) : ME c.e.t r.x.t r.y.t (auu n c.e.t) =
  me-at-type G a b (guu n) r c (e-uu n G c.e) (at-uu c.e.t n c.ok (me-bound G a b n r)) ;

-- A fixed-context witness keeps the caller's representatives in the index.
LiftAt : GJ -> U l = split {
  gjwf G -> LiftCx[G] ;
  gjty G A -> (c : LiftCx[G]) -> LiftTy[G,A,c] ;
  gjtm G a A -> (c : LiftCx[G]) -> LiftTm[G,a,A,c] ;
  gjsub D s G -> (c : LiftCx[D]) -> (k : LiftCx[G]) -> LiftSub[D,s,G,c,k] ;
  gjeqcx G H -> (c : LiftCx[G]) -> (k : LiftCx[H]) -> LiftCE[G,H,c,k] ;
  gjeqty G A B -> (c : LiftCx[G]) -> LiftTE[G,A,B,c] ;
  gjeqtm G a b A -> (c : LiftCx[G]) -> LiftME[G,a,b,A,c] ;
  gjeqsub D s t G -> (c : LiftCx[D]) -> (k : LiftCx[G]) -> LiftSE[D,s,t,G,c,k] } ;

fix-lift : (J : GJ) -> LiftJ J -> LiftAt J = split {
  gjwf G -> \ r -> r ;
  gjty G A -> \ r c -> new LiftTy[G,A,c,a := r.a,d := at-ty G A r c] ;
  gjtm G a A -> \ r c -> new LiftTm[G,a,A,c,x := r.x,t := r.t,d := at-tm G a A r c] ;
  gjsub D s G -> \ r c k -> new LiftSub[D,s,G,c,k,x := r.x,d := at-sub D s G r c k] ;
  gjeqcx G H -> \ r c k -> new LiftCE[G,H,c,k,d := at-ce G H r c k] ;
  gjeqty G A B -> \ r c -> new LiftTE[G,A,B,c,a := r.a,b := r.b,d := at-te G A B r c] ;
  gjeqtm G a b A -> \ r c -> new LiftME[G,a,b,A,c,x := r.x,y := r.y,t := r.t,d := at-me G a b A r c] ;
  gjeqsub D s t G -> \ r c k -> new LiftSE[D,s,t,G,c,k,x := r.x,y := r.y,d := at-se D s t G r c k] } ;

record Annotation {
  J : GJ ; j : GAJ ; image : Id GJ (fgJ j) J ; der : GADer j
} ;

image-J2 (f : GE -> GE -> GJ) (X Y : GE) (x : LiftExpr[X]) (y : LiftExpr[Y]) :
    Id GJ (f (fg x.t) (fg y.t)) (f X Y) =
  TSyntax[l].cong2 GE GE GJ f (fg x.t) X (fg y.t) Y x.image y.image ;

image-J3 (f : GE -> GE -> GE -> GJ) (X Y Z : GE) (x : LiftExpr[X]) (y : LiftExpr[Y]) (z : LiftExpr[Z]) :
    Id GJ (f (fg x.t) (fg y.t) (fg z.t)) (f X Y Z) =
  Prelude[l].trans GJ (f (fg x.t) (fg y.t) (fg z.t)) (f (fg x.t) Y Z) (f X Y Z)
    (image-J2 (f (fg x.t)) Y Z y z)
    (Prelude[l].ap GE GJ (\ A -> f A Y Z) (fg x.t) X x.image) ;

image-J4 (f : GE -> GE -> GE -> GE -> GJ) (X Y Z K : GE)
    (x : LiftExpr[X]) (y : LiftExpr[Y]) (z : LiftExpr[Z]) (k : LiftExpr[K]) :
    Id GJ (f (fg x.t) (fg y.t) (fg z.t) (fg k.t)) (f X Y Z K) =
  Prelude[l].trans GJ (f (fg x.t) (fg y.t) (fg z.t) (fg k.t)) (f (fg x.t) Y Z K) (f X Y Z K)
    (image-J3 (f (fg x.t)) Y Z K y z k)
    (Prelude[l].ap GE GJ (\ A -> f A Y Z K) (fg x.t) X x.image) ;

pack-lift : (J : GJ) -> LiftJ J -> Annotation[J] = split {
  gjwf G -> \ r -> new Annotation[gjwf G,j := ajwf r.e.t,
    image := Prelude[l].ap GE GJ (\ X -> gjwf X) (fg r.e.t) G r.e.image,der := r.ok] ;
  gjty G A -> \ r -> new Annotation[gjty G A,j := ajty r.c.e.t r.a.t,
    image := image-J2 (\ X Y -> gjty X Y) G A r.c.e r.a,der := r.d] ;
  gjtm G a A -> \ r -> new Annotation[gjtm G a A,j := ajtm r.c.e.t r.x.t r.t.t,
    image := image-J3 (\ X x Y -> gjtm X x Y) G a A r.c.e r.x r.t,der := r.d] ;
  gjsub D s G -> \ r -> new Annotation[gjsub D s G,j := ajsub r.c.e.t r.x.t r.k.e.t,
    image := image-J3 (\ X x Y -> gjsub X x Y) D s G r.c.e r.x r.k.e,der := r.d] ;
  gjeqcx G H -> \ r -> new Annotation[gjeqcx G H,j := ajeqcx r.c.e.t r.k.e.t,
    image := image-J2 (\ X Y -> gjeqcx X Y) G H r.c.e r.k.e,der := r.d] ;
  gjeqty G A B -> \ r -> new Annotation[gjeqty G A B,j := ajeqty r.c.e.t r.a.t r.b.t,
    image := image-J3 (\ X Y Z -> gjeqty X Y Z) G A B r.c.e r.a r.b,der := r.d] ;
  gjeqtm G a b A -> \ r -> new Annotation[gjeqtm G a b A,j := ajeqtm r.c.e.t r.x.t r.y.t r.t.t,
    image := image-J4 (\ X x y Y -> gjeqtm X x y Y) G a b A r.c.e r.x r.y r.t,der := r.d] ;
  gjeqsub D s t G -> \ r -> new Annotation[gjeqsub D s t G,j := ajeqsub r.c.e.t r.x.t r.y.t r.k.e.t,
    image := image-J4 (\ X x y Y -> gjeqsub X x y Y) D s t G r.c.e r.x r.y r.k.e,der := r.d] } ;
