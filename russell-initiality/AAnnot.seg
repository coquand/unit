lift-gm-elam (G : GE) (A : GE) (A' : GE) (B : GE) (B' : GE) (b : GE) (b' : GE) (r1 : LiftTE[G,A,A']) (r2 : LiftTE[(gext G A),B,B']) (r3 : LiftME[(gext G A),b,b',B]) : LiftME[G,(glam A B b),(glam A' B' b'),(gpi A B)] =
