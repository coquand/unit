    p0 : Ty r1.k.e.t r0.a.t = (at-ty G A r0 r1.k) ;
    p1 : Sb r2.k.e.t r1.x.t r1.k.e.t = (at-sub D s G r1 r2.k r1.k) ;
    p2 : Sb r2.c.e.t r2.x.t r2.k.e.t = r2.d ;
  } ;

lift-gq-p-lift (D : GE) (G : GE) (A : GE) (s : GE) (r1 : LiftTy[G,A]) (r2 : LiftSub[D,s,G]) : LiftSE[(gext D (gsb A s)),(gcomp gp (glift A s)),(gcomp s gp),G] =
  put-se (gext D (gsb A s)) (gcomp gp (glift A s)) (gcomp s gp) G (e-ext D (gsb A s) r2.c.e (e-sb A s r1.a r2.x)) (e-comp gp (glift A s) (e-p G A r2.k.e r1.a) (e-lift A s r1.a r2.x)) (e-comp s gp r2.x (e-p D (gsb A s) r2.c.e (e-sb A s r1.a r2.x))) r2.k.e (aq-p-lift r2.c.e.t r2.k.e.t r1.a.t r2.x.t p1 p2)
  where {
    p1 : Ty r2.k.e.t r1.a.t = (at-ty G A r1 r2.k) ;
    p2 : Sb r2.c.e.t r2.x.t r2.k.e.t = r2.d ;
  } ;

lift-gq-p-sec (G : GE) (A : GE) (a : GE) (r1 : LiftTy[G,A]) (r2 : LiftTm[G,a,A]) : LiftSE[G,(gcomp gp (gsec A a)),gid,G] =
  put-se G (gcomp gp (gsec A a)) gid G r1.c.e (e-comp gp (gsec A a) (e-p G A r1.c.e r1.a) (e-sec A a r1.a r2.x)) (e-id G r1.c.e) r1.c.e (aq-p-sec r1.c.e.t r1.a.t r2.x.t p1 p2)
  where {
    p1 : Ty r1.c.e.t r1.a.t = r1.d ;
    p2 : Tm' r1.c.e.t r2.x.t r1.a.t = (tm-at-type G a A r2 r1.c r1.a p1) ;
  } ;

lift-gq-sec-comp (D : GE) (G : GE) (A : GE) (a : GE) (s : GE) (r1 : LiftTy[G,A]) (r2 : LiftTm[G,a,A]) (r3 : LiftSub[D,s,G]) : LiftSE[D,(gcomp (gsec A a) s),(gcomp (glift A s) (gsec (gsb A s) (gsb a s))),(gext G A)] =
  put-se D (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))) (gext G A) r3.c.e (e-comp (gsec A a) s (e-sec A a r1.a r2.x) r3.x) (e-comp (glift A s) (gsec (gsb A s) (gsb a s)) (e-lift A s r1.a r3.x) (e-sec (gsb A s) (gsb a s) (e-sb A s r1.a r3.x) (e-sb a s r2.x r3.x))) (e-ext G A r3.k.e r1.a) (aq-sec-comp r3.c.e.t r3.k.e.t r1.a.t r2.x.t r3.x.t p1 p2 p3)
  where {
    p1 : Ty r3.k.e.t r1.a.t = (at-ty G A r1 r3.k) ;
    p2 : Tm' r3.k.e.t r2.x.t r1.a.t = (tm-at-type G a A r2 r3.k r1.a p1) ;
    p3 : Sb r3.c.e.t r3.x.t r3.k.e.t = r3.d ;
  } ;

lift-gq-lift-p-sec-q (G : GE) (A : GE) (r : LiftTy[G,A]) : LiftSE[(gext G A),(gcomp (glift A gp) (gsec (gsb A gp) gq)),gid,(gext G A)] =
  put-se (gext G A) (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid (gext G A) (e-ext G A r.c.e r.a) (e-comp (glift A gp) (gsec (gsb A gp) gq) (e-lift A gp r.a (e-p G A r.c.e r.a)) (e-sec (gsb A gp) gq (e-sb A gp r.a (e-p G A r.c.e r.a)) (e-q G A r.c.e r.a))) (e-id (gext G A) (e-ext G A r.c.e r.a)) (e-ext G A r.c.e r.a) (aq-lift-p-sec-q r.c.e.t r.a.t p)
  where {
    p : Ty r.c.e.t r.a.t = r.d ;
  } ;

annotate : (J : GJ) -> GDer J -> LiftJ J = split {
  g-nil -> lift-g-nil ;
  g-ext G A h | r -> lift-g-ext G A r ;
  gc-nil -> lift-gc-nil ;
  gc-refl G h | r -> lift-gc-refl G r ;
  gc-ext G D A B h1 h2 | r1 r2 -> lift-gc-ext G D A B r1 r2 ;
  gs-id G h | r -> lift-gs-id G r ;
  gs-comp T D G s d h1 h2 | r1 r2 -> lift-gs-comp T D G s d r1 r2 ;
  gs-eps G h | r -> lift-gs-eps G r ;
  gs-p G A h | r -> lift-gs-p G A r ;
  gs-lift D G A s h1 h2 | r1 r2 -> lift-gs-lift D G A s r1 r2 ;
  gs-sec G A a h1 h2 | r1 r2 -> lift-gs-sec G A a r1 r2 ;
  gs-cx D D' G G' s h0 h0' h1 h2 h | r0 r0' r1 r2 r -> lift-gs-cx D D' G G' s r0 r0' r1 r2 r ;
  gt-pi G A B h1 h2 | r1 r2 -> lift-gt-pi G A B r1 r2 ;
  gt-uu G n h nb | r -> lift-gt-uu G n r nb ;
  gt-el G n a h | r -> lift-gt-el G n a r ;
  gt-sb D G A s h1 h2 | r1 r2 -> lift-gt-sb D G A s r1 r2 ;
  gt-cx G D A h0 h1 h2 | r0 r1 r2 -> lift-gt-cx G D A r0 r1 r2 ;
  gm-lam G A B b h1 h2 h3 | r1 r2 r3 -> lift-gm-lam G A B b r1 r2 r3 ;
  gm-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> lift-gm-app G A B c a r1 r2 r3 r4 ;
  gm-pic G n a b h1 h2 | r1 r2 -> lift-gm-pic G n a b r1 r2 ;
  gm-uc G m n h lt nb | r -> lift-gm-uc G m n r lt nb ;
  gm-lf G m n a h le nb | r -> lift-gm-lf G m n a r le nb ;
  gm-q G A h | r -> lift-gm-q G A r ;
  gm-sb D G a A s hA h1 h2 | rA r1 r2 -> lift-gm-sb D G a A s rA r1 r2 ;
  gm-conv G a A B h1 h2 | r1 r2 -> lift-gm-conv G a A B r1 r2 ;
  gm-cx G D a A h0 h1 h2 | r0 r1 r2 -> lift-gm-cx G D a A r0 r1 r2 ;
  ge-refl G A h | r -> lift-ge-refl G A r ;
  ge-sym G A B h | r -> lift-ge-sym G A B r ;
  ge-trans G A B C h1 h2 | r1 r2 -> lift-ge-trans G A B C r1 r2 ;
  ge-pi G A A' B B' h0 h1 h2 | r0 r1 r2 -> lift-ge-pi G A A' B B' r1 r2 ;
  ge-el G n a a' h | r -> lift-ge-el G n a a' r ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 | r0 r1 r2 r3 r4 -> lift-ge-sb D G A A' s s' r1 r4 ;
  ge-el-lf G m n a h le nb | r -> lift-ge-el-lf G m n a r le nb ;
  ge-el-pic G n a b h1 h2 | r1 r2 -> lift-ge-el-pic G n a b r1 r2 ;
  ge-el-uc G m n h lt nb | r -> lift-ge-el-uc G m n r lt nb ;
  ge-sb-id G A h | r -> lift-ge-sb-id G A r ;
  ge-sb-comp T D G A s d h0 h1 h2 | r0 r1 r2 -> lift-ge-sb-comp T D G A s d r0 r1 r2 ;
  ge-pi-sb D G A B s h1 h2 h3 | r1 r2 r3 -> lift-ge-pi-sb D G A B s r1 r2 r3 ;
  ge-uu-sb D G n s h nb | r -> lift-ge-uu-sb D G n s r nb ;
  ge-el-sb D G n a s h1 h2 | r1 r2 -> lift-ge-el-sb D G n a s r1 r2 ;
  ge-cx G D A B h0 h1 h2 | r0 r1 r2 -> lift-ge-cx G D A B r0 r1 r2 ;
  gm-refl G a A h | r -> lift-gm-refl G a A r ;
  gm-sym G a b A hA h | rA r -> lift-gm-sym G a b A r ;
  gm-trans G a b c A h1 h2 | r1 r2 -> lift-gm-trans G a b c A r1 r2 ;
  gm-eqconv G a b A B h1 h2 | r1 r2 -> lift-gm-eqconv G a b A B r1 r2 ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 | r0 r1 r2 r3 -> lift-gm-elam G A A' B B' b b' r1 r2 r3 ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | r0 rB ra r1 r2 r3 r4 -> lift-gm-eapp G A A' B B' c c' a a' r1 r2 r3 r4 ;
  gm-epic G n a a' b b' h0 h1 h2 | r0 r1 r2 -> lift-gm-epic G n a a' b b' r1 r2 ;
  gm-elf G m n a a' h le nb | r -> lift-gm-elf G m n a a' r le nb ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 | rA r0 r1 r2 r3 r4 -> lift-gm-esb D G a a' A s s' rA r1 r4 ;
  gm-beta G A B b a hA hB h1 h2 | rA rB r1 r2 -> lift-gm-beta G A B b a rA rB r1 r2 ;
  gm-eta G A B f hA hB h | rA rB r -> lift-gm-eta G A B f rA rB r ;
  gm-lf-pic G n p a b h1 h2 le nb | r1 r2 -> lift-gm-lf-pic G n p a b r1 r2 le nb ;
  gm-lf-uc G m n p h lt le nb | r -> lift-gm-lf-uc G m n p r lt le nb ;
  gm-lf-lf G m n p a h le1 le2 nb | r -> lift-gm-lf-lf G m n p a r le1 le2 nb ;
  gm-sb-id G a A h | r -> lift-gm-sb-id G a A r ;
  gm-sb-comp T D G a A s d h0 h1 h2 | r0 r1 r2 -> lift-gm-sb-comp T D G a A s d r0 r1 r2 ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 | r1 r2 r3 r4 -> lift-gm-lam-sb D G A B b s r1 r2 r3 r4 ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 | r1 r2 r3 r4 r5 -> lift-gm-app-sb D G A B c a s r1 r2 r3 r4 r5 ;
  gm-pic-sb D G n a b s h1 h2 h3 | r1 r2 r3 -> lift-gm-pic-sb D G n a b s r1 r2 r3 ;
  gm-uc-sb D G m n s h lt nb | r -> lift-gm-uc-sb D G m n s r lt nb ;
  gm-lf-sb D G m n a s h1 h2 le nb | r1 r2 -> lift-gm-lf-sb D G m n a s r1 r2 le nb ;
  gm-q-lift D G A s h1 h2 | r1 r2 -> lift-gm-q-lift D G A s r1 r2 ;
  gm-q-sec G A a h1 h2 | r1 r2 -> lift-gm-q-sec G A a r1 r2 ;
  gm-ecx G D a b A h0 h1 h2 | r0 r1 r2 -> lift-gm-ecx G D a b A r0 r1 r2 ;
  gq-refl D s G h | r -> lift-gq-refl D s G r ;
  gq-sym D s t G h | r -> lift-gq-sym D s t G r ;
  gq-trans D s t u G h1 h2 | r1 r2 -> lift-gq-trans D s t u G r1 r2 ;
  gq-comp T D G s s' d d' h1 h2 | r1 r2 -> lift-gq-comp T D G s s' d d' r1 r2 ;
  gq-lift D G A A' s s' h0 h1 h2 h3 | r0 r1 r2 r3 -> lift-gq-lift D G A A' s s' r1 r3 ;
  gq-sec G A A' a a' hA ha ha' h1 h2 | rA ra ra' r1 r2 -> lift-gq-sec G A A' a a' r1 r2 ;
  gq-idl D G s h | r -> lift-gq-idl D G s r ;
  gq-idr D G s h | r -> lift-gq-idr D G s r ;
  gq-assoc Q T D G s d e h1 h2 h3 | r1 r2 r3 -> lift-gq-assoc Q T D G s d e r1 r2 r3 ;
  gq-eps G s h | r -> lift-gq-eps G s r ;
  gq-lift-id G A h | r -> lift-gq-lift-id G A r ;
  gq-lift-comp T D G A s d h0 h1 h2 | r0 r1 r2 -> lift-gq-lift-comp T D G A s d r0 r1 r2 ;
  gq-p-lift D G A s h1 h2 | r1 r2 -> lift-gq-p-lift D G A s r1 r2 ;
  gq-p-sec G A a h1 h2 | r1 r2 -> lift-gq-p-sec G A a r1 r2 ;
  gq-sec-comp D G A a s h1 h2 h3 | r1 r2 r3 -> lift-gq-sec-comp D G A a s r1 r2 r3 ;
  gq-lift-p-sec-q G A h | r -> lift-gq-lift-p-sec-q G A r } ;

annotate-at (J : GJ) (h : GDer J) : LiftAt J = fix-lift J (annotate J h) ;

annotation-section (J : GJ) (h : GDer J) : Annotation[J] = pack-lift J (annotate J h) ;
