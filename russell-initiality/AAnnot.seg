lift-ge-el-sb (D : GE) (G : GE) (n : Nat) (a : GE) (s : GE) (r1 : LiftTm[G,a,(guu n)]) (r2 : LiftSub[D,s,G]) : LiftTE[D,(gsb (gel n a) s),(gel n (gsb a s))] =
