    p2 : Tm' (aext r1.c.e.t (ael n r1.x.t)) r2.x.t (auu n (aext r1.c.e.t (ael n r1.x.t))) = (tm-at-uu (gext G (gel n a)) b n r2 ext) ;
  } ;

lift-gm-lf-uc (G : GE) (m : Nat) (n : Nat) (p : Nat) (r : LiftCx[G]) (lt : LeN (suc m) n) (le : LeN (suc n) p) (nb : LeN p N) : LiftME[G,(glf n p (guc m n)),(guc m p),(guu p)] =
