    ext : LiftCx[gext G A] = at-ext G A rA.c rA.a pA ;
    pB : Ty (aext rA.c.e.t rA.a.t) rB.a.t = (at-ty (gext G A) B rB ext) ;
    p : Tm' rA.c.e.t r.x.t (api rA.a.t rB.a.t) = (tm-at-type G f (gpi A B) r rA.c (e-pi A B rA.a rB.a) (at-pi rA.c.e.t rA.a.t rB.a.t pA pB)) ;
  } ;

lift-gm-lf-pic (G : GE) (n : Nat) (p : Nat) (a : GE) (b : GE) (r1 : LiftTm[G,a,(guu n)]) (r2 : LiftTm[(gext G (gel n a)),b,(guu n)]) (le : LeN (suc n) p) (nb : LeN p N) : LiftME[G,(glf n p (gpic n a b)),(gpic p (glf n p a) (glf n p b)),(guu p)] =
