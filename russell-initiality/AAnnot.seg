lift-gm-sb-id (G : GE) (a : GE) (A : GE) (r : LiftTm[G,a,A]) : LiftME[G,(gsb a gid),a,A] =
  put-me G (gsb a gid) a A r.c.e (e-sb a gid r.x (e-id G r.c.e)) r.x r.t (am-sb-id r.c.e.t r.x.t r.t.t p)
  where {
