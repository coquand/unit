    middle : ME r1.c.e.t r1.y.t r2.x.t r1.t.t = tm-align G b A r1.c r1.y r2.x r1.t (apresup (ajeqtm r1.c.e.t r1.x.t r1.y.t r1.t.t) p1).2.2.2 (apresup (ajeqtm r1.c.e.t r2.x.t r2.y.t r1.t.t) right).2.2.1 ;
    p2 : ME r1.c.e.t r1.y.t r2.y.t r1.t.t = am-trans r1.c.e.t r1.y.t r2.x.t r2.y.t r1.t.t middle right ;
  } ;

lift-gm-eqconv (G : GE) (a : GE) (b : GE) (A : GE) (B : GE) (r1 : LiftME[G,a,b,A]) (r2 : LiftTE[G,A,B]) : LiftME[G,a,b,B] =
