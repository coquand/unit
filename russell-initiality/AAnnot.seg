lift-gm-trans (G : GE) (a : GE) (b : GE) (c : GE) (A : GE) (r1 : LiftME[G,a,b,A]) (r2 : LiftME[G,b,c,A]) : LiftME[G,a,c,A] =
  put-me G a c A r1.c.e r1.x r2.y r1.t (am-trans r1.c.e.t r1.x.t r1.y.t r2.y.t r1.t.t p1 p2)
