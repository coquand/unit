lift-ge-sb-comp (T : GE) (D : GE) (G : GE) (A : GE) (s : GE) (d : GE) (r0 : LiftTy[G,A]) (r1 : LiftSub[D,s,G]) (r2 : LiftSub[T,d,D]) : LiftTE[T,(gsb (gsb A s) d),(gsb A (gcomp s d))] =
  put-te T (gsb (gsb A s) d) (gsb A (gcomp s d)) r2.c.e (e-sb (gsb A s) d (e-sb A s r0.a r1.x) r2.x) (e-sb A (gcomp s d) r0.a (e-comp s d r1.x r2.x)) (ae-sb-comp r2.c.e.t r2.k.e.t r1.k.e.t r0.a.t r1.x.t r2.x.t p0 p1 p2)
  where {
    p0 : Ty r1.k.e.t r0.a.t = (at-ty G A r0 r1.k) ;
    p1 : Sb r2.k.e.t r1.x.t r1.k.e.t = (at-sub D s G r1 r2.k r1.k) ;
    p2 : Sb r2.c.e.t r2.x.t r2.k.e.t = r2.d ;
  } ;

lift-ge-pi-sb (D : GE) (G : GE) (A : GE) (B : GE) (s : GE) (r1 : LiftTy[G,A]) (r2 : LiftTy[(gext G A),B]) (r3 : LiftSub[D,s,G]) : LiftTE[D,(gsb (gpi A B) s),(gpi (gsb A s) (gsb B (glift A s)))] =
  put-te D (gsb (gpi A B) s) (gpi (gsb A s) (gsb B (glift A s))) r3.c.e (e-sb (gpi A B) s (e-pi A B r1.a r2.a) r3.x) (e-pi (gsb A s) (gsb B (glift A s)) (e-sb A s r1.a r3.x) (e-sb B (glift A s) r2.a (e-lift A s r1.a r3.x))) (ae-pi-sb r3.c.e.t r3.k.e.t r1.a.t r2.a.t r3.x.t p1 p2 p3)
  where {
