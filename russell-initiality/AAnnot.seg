  } ;

lift-gm-elf (G : GE) (m : Nat) (n : Nat) (a : GE) (a' : GE) (r : LiftME[G,a,a',(guu m)]) (le : LeN (suc m) n) (nb : LeN n N) : LiftME[G,(glf m n a),(glf m n a'),(guu n)] =
