lift-gm-epic (G : GE) (n : Nat) (a : GE) (a' : GE) (b : GE) (b' : GE) (r1 : LiftME[G,a,a',(guu n)]) (r2 : LiftME[(gext G (gel n a)),b,b',(guu n)]) : LiftME[G,(gpic n a b),(gpic n a' b'),(guu n)] =
