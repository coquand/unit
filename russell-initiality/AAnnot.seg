lift-ge-sb-id (G : GE) (A : GE) (r : LiftTy[G,A]) : LiftTE[G,(gsb A gid),A] =
  put-te G (gsb A gid) A r.c.e (e-sb A gid r.a (e-id G r.c.e)) r.a (ae-sb-id r.c.e.t r.a.t p)
  where {
