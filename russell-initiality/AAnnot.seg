  where {
    p-proof : W r.e.t = r.ok ;
  } ;

lift-gm-lf-lf (G : GE) (m : Nat) (n : Nat) (p : Nat) (a : GE) (r : LiftTm[G,a,(guu m)]) (le1 : LeN (suc m) n) (le2 : LeN (suc n) p) (nb : LeN p N) : LiftME[G,(glf n p (glf m n a)),(glf m p a),(guu p)] =
  put-me G (glf n p (glf m n a)) (glf m p a) (guu p) r.c.e (e-lf n p (glf m n a) (e-lf m n a r.x)) (e-lf m p a r.x) (e-uu p G r.c.e) (am-lf-lf r.c.e.t m n p r.x.t p-proof le1 le2 nb)
