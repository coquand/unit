lift-gm-esb (D : GE) (G : GE) (a : GE) (a' : GE) (A : GE) (s : GE) (s' : GE) (rA : LiftTy[G,A]) (r1 : LiftME[G,a,a',A]) (r4 : LiftSE[D,s,s',G]) : LiftME[D,(gsb a s),(gsb a' s'),(gsb A s)] =
  put-me D (gsb a s) (gsb a' s') (gsb A s) r4.c.e (e-sb a s r1.x r4.x) (e-sb a' s' r1.y r4.y) (e-sb A s rA.a r4.x) (am-esb r4.c.e.t r4.k.e.t r1.x.t r1.y.t rA.a.t r4.x.t r4.y.t pA p0 p1 p2 p3 p4)
  where {
    pA : Ty r4.k.e.t rA.a.t = (at-ty G A rA r4.k) ;
    p1 : ME r4.k.e.t r1.x.t r1.y.t rA.a.t = (me-at-type G a a' A r1 r4.k rA.a pA) ;
    p0 : Tm' r4.k.e.t r1.x.t rA.a.t = (apresup (ajeqtm r4.k.e.t r1.x.t r1.y.t rA.a.t) p1).2.2.1 ;
    p4 : SE r4.c.e.t r4.x.t r4.y.t r4.k.e.t = r4.d ;
    p2 : Sb r4.c.e.t r4.x.t r4.k.e.t = (apresup (ajeqsub r4.c.e.t r4.x.t r4.y.t r4.k.e.t) p4).2.2.1 ;
    p3 : Sb r4.c.e.t r4.y.t r4.k.e.t = (apresup (ajeqsub r4.c.e.t r4.x.t r4.y.t r4.k.e.t) p4).2.2.2 ;
  } ;

lift-gm-beta (G : GE) (A : GE) (B : GE) (b : GE) (a : GE) (rA : LiftTy[G,A]) (rB : LiftTy[(gext G A),B]) (r1 : LiftTm[(gext G A),b,B]) (r2 : LiftTm[G,a,A]) : LiftME[G,(gapp A B (glam A B b) a),(gsb b (gsec A a)),(gsb B (gsec A a))] =
  put-me G (gapp A B (glam A B b) a) (gsb b (gsec A a)) (gsb B (gsec A a)) rA.c.e (e-app A B (glam A B b) a rA.a rB.a (e-lam A B b rA.a rB.a r1.x) r2.x) (e-sb b (gsec A a) r1.x (e-sec A a rA.a r2.x)) (e-sb B (gsec A a) rB.a (e-sec A a rA.a r2.x)) (am-beta rA.c.e.t rA.a.t rB.a.t r1.x.t r2.x.t pA pB p1 p2)
  where {
    pA : Ty rA.c.e.t rA.a.t = rA.d ;
    ext : LiftCx[gext G A] = at-ext G A rA.c rA.a pA ;
    pB : Ty (aext rA.c.e.t rA.a.t) rB.a.t = (at-ty (gext G A) B rB ext) ;
    p1 : Tm' (aext rA.c.e.t rA.a.t) r1.x.t rB.a.t = (tm-at-type (gext G A) b B r1 ext rB.a pB) ;
    p2 : Tm' rA.c.e.t r2.x.t rA.a.t = (tm-at-type G a A r2 rA.c rA.a pA) ;
  } ;

lift-gm-eta (G : GE) (A : GE) (B : GE) (f : GE) (rA : LiftTy[G,A]) (rB : LiftTy[(gext G A),B]) (r : LiftTm[G,f,(gpi A B)]) : LiftME[G,f,(glam A B (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq)),(gpi A B)] =
  put-me G f (glam A B (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq)) (gpi A B) rA.c.e r.x (e-lam A B (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq) rA.a rB.a (e-app (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq (e-sb A gp rA.a (e-p G A rA.c.e rA.a)) (e-sb B (glift A gp) rB.a (e-lift A gp rA.a (e-p G A rA.c.e rA.a))) (e-sb f gp r.x (e-p G A rA.c.e rA.a)) (e-q G A rA.c.e rA.a))) (e-pi A B rA.a rB.a) (am-eta rA.c.e.t rA.a.t rB.a.t r.x.t pA pB p)
  where {
