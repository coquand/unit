  } ;

lift-gm-eapp (G : GE) (A : GE) (A' : GE) (B : GE) (B' : GE) (c : GE) (c' : GE) (a : GE) (a' : GE) (r1 : LiftTE[G,A,A']) (r2 : LiftTE[(gext G A),B,B']) (r3 : LiftME[G,c,c',(gpi A B)]) (r4 : LiftME[G,a,a',A]) : LiftME[G,(gapp A B c a),(gapp A' B' c' a'),(gsb B (gsec A a))] =
  put-me G (gapp A B c a) (gapp A' B' c' a') (gsb B (gsec A a)) r1.c.e (e-app A B c a r1.a r2.a r3.x r4.x) (e-app A' B' c' a' r1.b r2.b r3.y r4.y) (e-sb B (gsec A a) r2.a (e-sec A a r1.a r4.x)) (am-eapp r1.c.e.t r1.a.t r1.b.t r2.a.t r2.b.t r3.x.t r3.y.t r4.x.t r4.y.t p0 pB pa p1 p2 p3 p4)
  where {
    p1 : TE r1.c.e.t r1.a.t r1.b.t = r1.d ;
    p0 : Ty r1.c.e.t r1.a.t = (apresup (ajeqty r1.c.e.t r1.a.t r1.b.t) p1).2.1 ;
    ext : LiftCx[gext G A] = at-ext G A r1.c r1.a p0 ;
    p2 : TE (aext r1.c.e.t r1.a.t) r2.a.t r2.b.t = (at-te (gext G A) B B' r2 ext) ;
    pB : Ty (aext r1.c.e.t r1.a.t) r2.a.t = (apresup (ajeqty (aext r1.c.e.t r1.a.t) r2.a.t r2.b.t) p2).2.1 ;
    p3 : ME r1.c.e.t r3.x.t r3.y.t (api r1.a.t r2.a.t) = (me-at-type G c c' (gpi A B) r3 r1.c (e-pi A B r1.a r2.a) (at-pi r1.c.e.t r1.a.t r2.a.t p0 pB)) ;
    p4 : ME r1.c.e.t r4.x.t r4.y.t r1.a.t = (me-at-type G a a' A r4 r1.c r1.a p0) ;
