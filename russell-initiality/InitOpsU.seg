-- InitOpsU.seg (PLAN-INIT, Part F): the universes of the term model.
--   univ n c          raw  guu n
--   decode n c a      raw  gel n a
--   pic n c a b       raw  gpic n a b
--   uc m n lt c       raw  guc m n
--   lf m n lt c a     raw  glf m n a
-- Levels are EhrhardTEModel.LevelAt N / StrictAt N, as in TEModel[N].
-- univ-beta and uc-beta need no representative.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
module TM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;

------------------------------------------------------------------------
-- universes  univ n c

module OpUniv (n : TM.LevelAt N) (c : Ctx) {
  W : U l = RepCtx c ;
  der (r : W) : Pf (gjty r.1 (guu n.1)) =
    pf-map (gjwf r.1) (gjty r.1 (guu n.1)) (\ k -> gt-uu r.1 n.1 k n.2) r.2.1 ;
  f (r : W) : Ty c = clsTy c r.1 (guu n.1) (der r) r.2.1 r.2.2 ;
  const (r r' : W) : Id (Ty c) (f r) (f r') =
    clsTy-eq c r.1 (guu n.1) (der r) r.2.1 r.2.2 r'.1 (guu n.1) (der r') r'.2.1 r'.2.2
      (pf-map (gjty r.1 (guu n.1)) (gjeqty r.1 (guu n.1) (guu n.1)) (\ k -> ge-refl r.1 (guu n.1) k) (der r)) ;
  module Ch = Choice[W, Ty c, isSetTy c, f, const] ;
  value : Ty c = Ch.elim (rep-ctx c) ;
  beta (r : W) : Id (Ty c) value (f r) = Ch.beta (rep-ctx c) r ;
} ;

univ (n : TM.LevelAt N) (c : Ctx) : Ty c = OpUniv[n,c].value ;
univ-beta (n : TM.LevelAt N) (c : Ctx) (G1 : GE) (h : Pf (gjty G1 (guu n.1))) (w : Pf (gjwf G1))
  (pc : Id Ctx (cls G1 w) c) : Id (Ty c) (univ n c) (clsTy c G1 (guu n.1) h w pc) =
  sq-rec (RepCtx c) (Id (Ty c) (univ n c) (clsTy c G1 (guu n.1) h w pc))
    (isSetTy c (univ n c) (clsTy c G1 (guu n.1) h w pc))
    (\ r -> trans (Ty c) (univ n c) (OpUniv[n,c].f r) (clsTy c G1 (guu n.1) h w pc) (OpUniv[n,c].beta r)
      (clsTy-move c r.1 (guu n.1) (OpUniv[n,c].der r) r.2.1 r.2.2 G1 h w pc))
    (rep-ctx c) ;
-- the representative of univ n c over a representative of c
univ-rep (n : TM.LevelAt N) (c : Ctx) (r : RepCtx c) : RepTy c (univ n c) =
  mkRepTy c (univ n c) r.1 (guu n.1) (OpUniv[n,c].der r) r.2.1 r.2.2
    (sym (Ty c) (univ n c) (clsTy c r.1 (guu n.1) (OpUniv[n,c].der r) r.2.1 r.2.2)
      (univ-beta n c r.1 (OpUniv[n,c].der r) r.2.1 r.2.2)) ;
-- the representative context of an element representative
re-ctx (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : RepCtx c = (reG c T t r, (reW c T t r, reP c T t r)) ;

------------------------------------------------------------------------
-- decoding  decode n c a,  a : U_n over G

module OpDecode (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) {
  W : U l = RepEl c (univ n c) a ;
  G (r : W) : GE = reG c (univ n c) a r ;
  a0 (r : W) : GE = rea c (univ n c) a r ;
  ru (r : W) : RepTy c (univ n c) = univ-rep n c (re-ctx c (univ n c) a r) ;
  ha (r : W) : Pf (gjtm (G r) (a0 r) (guu n.1)) = re-move c (univ n c) a r (ru r) ;
  der (r : W) : Pf (gjty (G r) (gel n.1 (a0 r))) =
    pf-map (gjtm (G r) (a0 r) (guu n.1)) (gjty (G r) (gel n.1 (a0 r))) (\ k -> gt-el (G r) n.1 (a0 r) k) (ha r) ;
  f (r : W) : Ty c = clsTy c (G r) (gel n.1 (a0 r)) (der r) (reW c (univ n c) a r) (reP c (univ n c) a r) ;
  const (r r' : W) : Id (Ty c) (f r) (f r') =
    clsTy-eq c (G r) (gel n.1 (a0 r)) (der r) (reW c (univ n c) a r) (reP c (univ n c) a r)
      (G r') (gel n.1 (a0 r')) (der r') (reW c (univ n c) a r') (reP c (univ n c) a r')
      (pf-map (gjeqtm (G r) (a0 r) (a0 r') (guu n.1)) (gjeqty (G r) (gel n.1 (a0 r)) (gel n.1 (a0 r')))
        (\ e -> ge-el (G r) n.1 (a0 r) (a0 r') e) (re-eq c (univ n c) a r r' (ru r))) ;
  module Ch = Choice[W, Ty c, isSetTy c, f, const] ;
  value : Ty c = Ch.elim (rep-el c (univ n c) a) ;
  beta (r : W) : Id (Ty c) value (f r) = Ch.beta (rep-el c (univ n c) a) r ;
} ;

decode (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) : Ty c = OpDecode[n,c,a].value ;
decode-beta (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) (r : RepEl c (univ n c) a)
  (G1 : GE) (h : Pf (gjty G1 (gel n.1 (rea c (univ n c) a r)))) (w : Pf (gjwf G1)) (pc : Id Ctx (cls G1 w) c) :
  Id (Ty c) (decode n c a) (clsTy c G1 (gel n.1 (rea c (univ n c) a r)) h w pc) =
  trans (Ty c) (decode n c a) (OpDecode[n,c,a].f r) (clsTy c G1 (gel n.1 (rea c (univ n c) a r)) h w pc)
    (OpDecode[n,c,a].beta r)
    (clsTy-move c (reG c (univ n c) a r) (gel n.1 (rea c (univ n c) a r)) (OpDecode[n,c,a].der r)
      (reW c (univ n c) a r) (reP c (univ n c) a r) G1 h w pc) ;
decode-rep (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) (r : RepEl c (univ n c) a) : RepTy c (decode n c a) =
  mkRepTy c (decode n c a) (reG c (univ n c) a r) (gel n.1 (rea c (univ n c) a r)) (OpDecode[n,c,a].der r)
    (reW c (univ n c) a r) (reP c (univ n c) a r)
    (sym (Ty c) (decode n c a)
      (clsTy c (reG c (univ n c) a r) (gel n.1 (rea c (univ n c) a r)) (OpDecode[n,c,a].der r)
        (reW c (univ n c) a r) (reP c (univ n c) a r))
      (decode-beta n c a r (reG c (univ n c) a r) (OpDecode[n,c,a].der r) (reW c (univ n c) a r) (reP c (univ n c) a r))) ;

------------------------------------------------------------------------
-- product codes  pic n c a b,  a : U_n over G,  b : U_n over G.El_n(a)

module OpPic (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c))
  (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) {
  E : Ctx = ext c (decode n c a) ;
  W : U l = RepEl c (univ n c) a * RepEl E (univ n E) b ;
  G (x : W) : GE = reG c (univ n c) a x.1 ;
  a0 (x : W) : GE = rea c (univ n c) a x.1 ;
  b0 (x : W) : GE = rea E (univ n E) b x.2 ;
  rc (x : W) : RepCtx c = re-ctx c (univ n c) a x.1 ;
  ru (x : W) : RepTy c (univ n c) = univ-rep n c (rc x) ;
  ha (x : W) : Pf (gjtm (G x) (a0 x) (guu n.1)) = re-move c (univ n c) a x.1 (ru x) ;
  rD (x : W) : RepTy c (decode n c a) = decode-rep n c a x.1 ;
  wE (x : W) : Pf (gjwf (gext (G x) (gel n.1 (a0 x)))) = ext-der c (decode n c a) (rD x) ;
  rE (x : W) : RepCtx E = (gext (G x) (gel n.1 (a0 x)), (wE x, ext-beta' c (decode n c a) (rD x) (wE x))) ;
  rU (x : W) : RepTy E (univ n E) = univ-rep n E (rE x) ;
  hb (x : W) : Pf (gjtm (gext (G x) (gel n.1 (a0 x))) (b0 x) (guu n.1)) = re-move E (univ n E) b x.2 (rU x) ;
  der (x : W) : Pf (gjtm (G x) (gpic n.1 (a0 x) (b0 x)) (guu n.1)) =
    pf-map2 (gjtm (G x) (a0 x) (guu n.1)) (gjtm (gext (G x) (gel n.1 (a0 x))) (b0 x) (guu n.1))
      (gjtm (G x) (gpic n.1 (a0 x) (b0 x)) (guu n.1))
      (\ h1 h2 -> gm-pic (G x) n.1 (a0 x) (b0 x) h1 h2) (ha x) (hb x) ;
  f (x : W) : El c (univ n c) =
    clsEl c (univ n c) (G x) (guu n.1) (gpic n.1 (a0 x) (b0 x)) (der x)
      (rtH c (univ n c) (ru x)) (rtW c (univ n c) (ru x)) (rtP c (univ n c) (ru x)) (rtE c (univ n c) (ru x)) ;
  rel (x y : W) : Pf (gjeqtm (G x) (gpic n.1 (a0 x) (b0 x)) (gpic n.1 (a0 y) (b0 y)) (guu n.1)) =
    pf-map3 (gjtm (G x) (a0 x) (guu n.1)) (gjeqtm (G x) (a0 x) (a0 y) (guu n.1))
      (gjeqtm (gext (G x) (gel n.1 (a0 x))) (b0 x) (b0 y) (guu n.1))
      (gjeqtm (G x) (gpic n.1 (a0 x) (b0 x)) (gpic n.1 (a0 y) (b0 y)) (guu n.1))
      (\ h0 e1 e2 -> gm-epic (G x) n.1 (a0 x) (a0 y) (b0 x) (b0 y) h0 e1 e2)
      (ha x) (re-eq c (univ n c) a x.1 y.1 (ru x)) (re-eq E (univ n E) b x.2 y.2 (rU x)) ;
  const (x y : W) : Id (El c (univ n c)) (f x) (f y) =
    clsEl-eq c (univ n c) (G x) (guu n.1) (gpic n.1 (a0 x) (b0 x)) (der x)
      (rtH c (univ n c) (ru x)) (rtW c (univ n c) (ru x)) (rtP c (univ n c) (ru x)) (rtE c (univ n c) (ru x))
      (G y) (guu n.1) (gpic n.1 (a0 y) (b0 y)) (der y)
      (rtH c (univ n c) (ru y)) (rtW c (univ n c) (ru y)) (rtP c (univ n c) (ru y)) (rtE c (univ n c) (ru y))
      (rel x y) ;
  module Ch = Choice[W, El c (univ n c), isSetEl c (univ n c), f, const] ;
  reps : Sq W = sq-pair (RepEl c (univ n c) a) (RepEl E (univ n E) b) (rep-el c (univ n c) a) (rep-el E (univ n E) b) ;
  value : El c (univ n c) = Ch.elim reps ;
  beta (x : W) : Id (El c (univ n c)) value (f x) = Ch.beta reps x ;
} ;

pic (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c))
  (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) : El c (univ n c) = OpPic[n,c,a,b].value ;
pic-beta (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c))
  (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a))))
  (r : RepEl c (univ n c) a) (r' : RepEl (ext c (decode n c a)) (univ n (ext c (decode n c a))) b)
  (G1 A1 : GE)
  (h : Pf (gjtm G1 (gpic n.1 (rea c (univ n c) a r) (rea (ext c (decode n c a)) (univ n (ext c (decode n c a))) b r')) A1))
  (hA : Pf (gjty G1 A1)) (w : Pf (gjwf G1)) (pc : Id Ctx (cls G1 w) c)
  (pT : Id (Ty c) (clsTy c G1 A1 hA w pc) (univ n c)) :
  Id (El c (univ n c)) (pic n c a b)
    (clsEl c (univ n c) G1 A1
      (gpic n.1 (rea c (univ n c) a r) (rea (ext c (decode n c a)) (univ n (ext c (decode n c a))) b r')) h hA w pc pT) =
  trans (El c (univ n c)) (pic n c a b) (OpPic[n,c,a,b].f (r, r'))
    (clsEl c (univ n c) G1 A1
      (gpic n.1 (rea c (univ n c) a r) (rea (ext c (decode n c a)) (univ n (ext c (decode n c a))) b r')) h hA w pc pT)
    (OpPic[n,c,a,b].beta (r, r'))
    (clsEl-irr c (univ n c) (reG c (univ n c) a r) (guu n.1)
      (gpic n.1 (rea c (univ n c) a r) (rea (ext c (decode n c a)) (univ n (ext c (decode n c a))) b r'))
      (OpPic[n,c,a,b].der (r, r'))
      (rtH c (univ n c) (OpPic[n,c,a,b].ru (r, r'))) (rtW c (univ n c) (OpPic[n,c,a,b].ru (r, r')))
      (rtP c (univ n c) (OpPic[n,c,a,b].ru (r, r'))) (rtE c (univ n c) (OpPic[n,c,a,b].ru (r, r')))
      G1 A1 h hA w pc pT) ;

------------------------------------------------------------------------
-- universe codes  uc m n lt c : El c (univ n c)

module OpUc (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) {
  W : U l = RepCtx c ;
  der (r : W) : Pf (gjtm r.1 (guc m.1 n.1) (guu n.1)) =
    pf-map (gjwf r.1) (gjtm r.1 (guc m.1 n.1) (guu n.1)) (\ k -> gm-uc r.1 m.1 n.1 k lt n.2) r.2.1 ;
  ru (r : W) : RepTy c (univ n c) = univ-rep n c r ;
  f (r : W) : El c (univ n c) =
    clsEl c (univ n c) r.1 (guu n.1) (guc m.1 n.1) (der r)
      (rtH c (univ n c) (ru r)) (rtW c (univ n c) (ru r)) (rtP c (univ n c) (ru r)) (rtE c (univ n c) (ru r)) ;
  const (r r' : W) : Id (El c (univ n c)) (f r) (f r') =
    clsEl-eq c (univ n c) r.1 (guu n.1) (guc m.1 n.1) (der r)
      (rtH c (univ n c) (ru r)) (rtW c (univ n c) (ru r)) (rtP c (univ n c) (ru r)) (rtE c (univ n c) (ru r))
      r'.1 (guu n.1) (guc m.1 n.1) (der r')
      (rtH c (univ n c) (ru r')) (rtW c (univ n c) (ru r')) (rtP c (univ n c) (ru r')) (rtE c (univ n c) (ru r'))
      (pf-map (gjtm r.1 (guc m.1 n.1) (guu n.1)) (gjeqtm r.1 (guc m.1 n.1) (guc m.1 n.1) (guu n.1))
        (\ k -> gm-refl r.1 (guc m.1 n.1) (guu n.1) k) (der r)) ;
  module Ch = Choice[W, El c (univ n c), isSetEl c (univ n c), f, const] ;
  value : El c (univ n c) = Ch.elim (rep-ctx c) ;
  beta (r : W) : Id (El c (univ n c)) value (f r) = Ch.beta (rep-ctx c) r ;
} ;

uc (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) : El c (univ n c) = OpUc[m,n,lt,c].value ;
uc-beta (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx)
  (G1 A1 : GE) (h : Pf (gjtm G1 (guc m.1 n.1) A1)) (hA : Pf (gjty G1 A1)) (w : Pf (gjwf G1))
  (pc : Id Ctx (cls G1 w) c) (pT : Id (Ty c) (clsTy c G1 A1 hA w pc) (univ n c)) :
  Id (El c (univ n c)) (uc m n lt c) (clsEl c (univ n c) G1 A1 (guc m.1 n.1) h hA w pc pT) =
  sq-rec (RepCtx c) (Id (El c (univ n c)) (uc m n lt c) (clsEl c (univ n c) G1 A1 (guc m.1 n.1) h hA w pc pT))
    (isSetEl c (univ n c) (uc m n lt c) (clsEl c (univ n c) G1 A1 (guc m.1 n.1) h hA w pc pT))
    (\ r -> trans (El c (univ n c)) (uc m n lt c) (OpUc[m,n,lt,c].f r)
      (clsEl c (univ n c) G1 A1 (guc m.1 n.1) h hA w pc pT) (OpUc[m,n,lt,c].beta r)
      (clsEl-irr c (univ n c) r.1 (guu n.1) (guc m.1 n.1) (OpUc[m,n,lt,c].der r)
        (rtH c (univ n c) (univ-rep n c r)) (rtW c (univ n c) (univ-rep n c r))
        (rtP c (univ n c) (univ-rep n c r)) (rtE c (univ n c) (univ-rep n c r))
        G1 A1 h hA w pc pT))
    (rep-ctx c) ;

------------------------------------------------------------------------
-- lifting of codes  lf m n lt c a : El c (univ n c),  a : U_m over G

module OpLf (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) (a : El c (univ m c)) {
  W : U l = RepEl c (univ m c) a ;
  G (r : W) : GE = reG c (univ m c) a r ;
  a0 (r : W) : GE = rea c (univ m c) a r ;
  rc (r : W) : RepCtx c = re-ctx c (univ m c) a r ;
  rum (r : W) : RepTy c (univ m c) = univ-rep m c (rc r) ;
  run (r : W) : RepTy c (univ n c) = univ-rep n c (rc r) ;
  ha (r : W) : Pf (gjtm (G r) (a0 r) (guu m.1)) = re-move c (univ m c) a r (rum r) ;
  der (r : W) : Pf (gjtm (G r) (glf m.1 n.1 (a0 r)) (guu n.1)) =
    pf-map (gjtm (G r) (a0 r) (guu m.1)) (gjtm (G r) (glf m.1 n.1 (a0 r)) (guu n.1))
      (\ k -> gm-lf (G r) m.1 n.1 (a0 r) k lt n.2) (ha r) ;
  f (r : W) : El c (univ n c) =
    clsEl c (univ n c) (G r) (guu n.1) (glf m.1 n.1 (a0 r)) (der r)
      (rtH c (univ n c) (run r)) (rtW c (univ n c) (run r)) (rtP c (univ n c) (run r)) (rtE c (univ n c) (run r)) ;
  const (r r' : W) : Id (El c (univ n c)) (f r) (f r') =
    clsEl-eq c (univ n c) (G r) (guu n.1) (glf m.1 n.1 (a0 r)) (der r)
      (rtH c (univ n c) (run r)) (rtW c (univ n c) (run r)) (rtP c (univ n c) (run r)) (rtE c (univ n c) (run r))
      (G r') (guu n.1) (glf m.1 n.1 (a0 r')) (der r')
      (rtH c (univ n c) (run r')) (rtW c (univ n c) (run r')) (rtP c (univ n c) (run r')) (rtE c (univ n c) (run r'))
      (pf-map (gjeqtm (G r) (a0 r) (a0 r') (guu m.1)) (gjeqtm (G r) (glf m.1 n.1 (a0 r)) (glf m.1 n.1 (a0 r')) (guu n.1))
        (\ e -> gm-elf (G r) m.1 n.1 (a0 r) (a0 r') e lt n.2) (re-eq c (univ m c) a r r' (rum r))) ;
  module Ch = Choice[W, El c (univ n c), isSetEl c (univ n c), f, const] ;
  value : El c (univ n c) = Ch.elim (rep-el c (univ m c) a) ;
  beta (r : W) : Id (El c (univ n c)) value (f r) = Ch.beta (rep-el c (univ m c) a) r ;
} ;

lf (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) (a : El c (univ m c)) : El c (univ n c) = OpLf[m,n,lt,c,a].value ;
lf-beta (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) (a : El c (univ m c)) (r : RepEl c (univ m c) a)
  (G1 A1 : GE) (h : Pf (gjtm G1 (glf m.1 n.1 (rea c (univ m c) a r)) A1)) (hA : Pf (gjty G1 A1)) (w : Pf (gjwf G1))
  (pc : Id Ctx (cls G1 w) c) (pT : Id (Ty c) (clsTy c G1 A1 hA w pc) (univ n c)) :
  Id (El c (univ n c)) (lf m n lt c a) (clsEl c (univ n c) G1 A1 (glf m.1 n.1 (rea c (univ m c) a r)) h hA w pc pT) =
  trans (El c (univ n c)) (lf m n lt c a) (OpLf[m,n,lt,c,a].f r)
    (clsEl c (univ n c) G1 A1 (glf m.1 n.1 (rea c (univ m c) a r)) h hA w pc pT)
    (OpLf[m,n,lt,c,a].beta r)
    (clsEl-irr c (univ n c) (reG c (univ m c) a r) (guu n.1) (glf m.1 n.1 (rea c (univ m c) a r))
      (OpLf[m,n,lt,c,a].der r)
      (rtH c (univ n c) (OpLf[m,n,lt,c,a].run r)) (rtW c (univ n c) (OpLf[m,n,lt,c,a].run r))
      (rtP c (univ n c) (OpLf[m,n,lt,c,a].run r)) (rtE c (univ n c) (OpLf[m,n,lt,c,a].run r))
      G1 A1 h hA w pc pT) ;
