gen-ty (G A : FA) (h : Ty G A) : TyGen G A = gen-typing (fjty G A) h ;
gen-tm (G a A : FA) (h : Tm' G a A) : TmGen G a A = gen-typing (fjtm G a A) h ;
gen-sub (D s G : FA) (h : Sb D s G) : SubGen D s G = gen-typing (fjsub D s G) h ;
