-- TPresup.seg: presuppositions of T_Tarski (sterbac4, Lemmas 22-24).
--   G |- a : A       gives  G |- A
--   G |- A = B       gives  G |- A  and  G |- B
--   G |- a = b : A   gives  G |- A,  G |- a : A  and  G |- b : A
-- One induction on derivations (the motive PJ); the binder cases use
-- context conversion (TSubLib.cxconv-*), application and beta use the
-- substitution lemma (TSubst.subst1-*, TSubCong.sub-cong).

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ; open TSubCong[l] ;
open TSubLib[l] ;

PJ : Jf -> U l = split {
  jwf G -> Top ;
  jty G A -> Top ;
  jtm G a A -> Der (jty G A) ;
  jeqty G A B -> Der (jty G A) * Der (jty G B) ;
  jeqtm G a b A -> Der (jty G A) * Der (jtm G a A) * Der (jtm G b A) } ;

------------------------------------------------------------------------
-- raw equation for eta: (B p+)[0] = B

wkl-sub1-pt : SL.PtEq (\ i -> sub1 (var zero) (Ren.lift (\ j -> suc j) i)) idS = split {
  zero -> refl (var zero) ;
  suc i -> refl (var (suc i)) } ;

wkl-sub1 (B : Tm) : Id Tm (subst1 (wkl B) (var zero)) B =
  trans Tm (subst1 (wkl B) (var zero)) (Sub.trav B (\ i -> sub1 (var zero) (Ren.lift (\ j -> suc j) i))) B
    (SL.trav-ren B (Ren.lift (\ j -> suc j)) (sub1 (var zero)))
    (sub-id-pt B (\ i -> sub1 (var zero) (Ren.lift (\ j -> suc j) i)) wkl-sub1-pt) ;

-- G.A |- B  gives  G.A.(wk A) |- wkl B
wkl-ty (G : Cx) (A B : Tm) (hA : Der (jty G A)) (hB : Der (jty (csnoc G A) B)) :
    Der (jty (csnoc (csnoc G A) (wk A)) (wkl B)) =
  RenD.trav-der (jty (csnoc G A) B) hB (csnoc (csnoc G A) (wk A)) (Ren.lift (\ i -> suc i))
    (RenD.subok-lift (csnoc G A) G (\ i -> suc i) A (wk-ok G (ok-of (jty G A) hA) A hA) (wk-ty G A A hA hA))
    (wf-snoc (csnoc G A) (wk A) (wk-ty G A A hA hA)) ;

-- the eta-expansion is well typed
eta-tm (G : Cx) (A B f : Tm) (hA : Der (jty G A)) (hB : Der (jty (csnoc G A) B)) (h : Der (jtm G f (pi A B))) :
    Der (jtm G (lam A B (app (wk A) (wkl B) (wk f) (var zero))) (pi A B)) =
  tm-lam G A B (app (wk A) (wkl B) (wk f) (var zero)) hA hB
    (der-tm-ty (csnoc G A) (app (wk A) (wkl B) (wk f) (var zero)) (subst1 (wkl B) (var zero)) B (wkl-sub1 B)
       (tm-app (csnoc G A) (wk A) (wkl B) (wk f) (var zero) (wk-ty G A A hA hA) (wkl-ty G A B hA hB)
          (wk-tm G A f (pi A B) hA h) (tm-v0 G A hA))) ;

------------------------------------------------------------------------
-- context conversion along one convertible last type

cx1 (G : Cx) (hG : CtxOk G) (A A' : Tm) (hA' : Der (jty G A')) (e : Der (jeqty G A A')) :
    CxEq (csnoc G A) (csnoc G A') * CtxOk (csnoc G A') =
  ((cxeq-refl G hG, e), (hG, hA')) ;

cx1-ty (G : Cx) (hG : CtxOk G) (A A' : Tm) (hA' : Der (jty G A')) (e : Der (jeqty G A A')) (B : Tm)
    (h : Der (jty (csnoc G A) B)) : Der (jty (csnoc G A') B) =
  cxconv-ty (csnoc G A) (csnoc G A') (cx1 G hG A A' hA' e).1 (cx1 G hG A A' hA' e).2 B h ;

cx1-tm (G : Cx) (hG : CtxOk G) (A A' : Tm) (hA' : Der (jty G A')) (e : Der (jeqty G A A')) (b B : Tm)
    (h : Der (jtm (csnoc G A) b B)) : Der (jtm (csnoc G A') b B) =
  cxconv-tm (csnoc G A) (csnoc G A') (cx1 G hG A A' hA' e).1 (cx1 G hG A A' hA' e).2 b B h ;

------------------------------------------------------------------------
-- the binder cases

c-eqty-pi (G : Cx) (A A' B B' : Tm) (h0 : Der (jty G A)) (h1 : Der (jeqty G A A')) (h2 : Der (jeqty (csnoc G A) B B'))
    (r1 : PJ (jeqty G A A')) (r2 : PJ (jeqty (csnoc G A) B B')) : PJ (jeqty G (pi A B) (pi A' B')) =
  (ty-pi G A B h0 r2.1,
   ty-pi G A' B' r1.2 (cx1-ty G (ok-of (jty G A) h0) A A' r1.2 h1 B' r2.2)) ;

c-eqtm-lam (G : Cx) (A A' B B' b b' : Tm) (h0 : Der (jty G A)) (h1 : Der (jeqty G A A')) (h2 : Der (jeqty (csnoc G A) B B'))
    (h3 : Der (jeqtm (csnoc G A) b b' B)) (r1 : PJ (jeqty G A A')) (r2 : PJ (jeqty (csnoc G A) B B'))
    (r3 : PJ (jeqtm (csnoc G A) b b' B)) : PJ (jeqtm G (lam A B b) (lam A' B' b') (pi A B)) =
  (ty-pi G A B h0 r3.1,
   tm-lam G A B b h0 r3.1 r3.2.1,
   tm-conv G (lam A' B' b') (pi A' B') (pi A B)
     (tm-lam G A' B' b' r1.2 (cx1-ty G (ok-of (jty G A) h0) A A' r1.2 h1 B' r2.2)
        (cx1-tm G (ok-of (jty G A) h0) A A' r1.2 h1 b' B' (tm-conv (csnoc G A) b' B B' r3.2.2 h2)))
     (eqty-sym G (pi A B) (pi A' B') (eqty-pi G A A' B B' h0 h1 h2))) ;

-- G |- subst1 B' a' = subst1 B a
app-ty-eq (G : Cx) (hG : CtxOk G) (A B B' a a' : Tm) (hB : Der (jty (csnoc G A) B)) (ha : Der (jtm G a A))
    (ha' : Der (jtm G a' A)) (h2 : Der (jeqty (csnoc G A) B B')) (h4 : Der (jeqtm G a a' A)) :
    Der (jeqty G (subst1 B' a') (subst1 B a)) =
  eqty-trans G (subst1 B' a') (subst1 B a') (subst1 B a)
    (eqty-sym G (subst1 B a') (subst1 B' a')
       (SubD.trav-der (jeqty (csnoc G A) B B') h2 G (sub1 a') (sub1-ok G hG A a' ha') (wf-from-ok G hG)))
    (eqty-sym G (subst1 B a) (subst1 B a')
       (sub-cong (jty (csnoc G A) B) hB G (sub1 a) (sub1 a') (sub1-ok G hG A a ha) (sub1-ok G hG A a' ha')
          (subeq-refl G G idS (sid-ok G hG), der-eqtm-ty G a a' A (Sub.trav A idS) (sym Tm (Sub.trav A idS) A (sub-id A)) h4)
          (wf-from-ok G hG))) ;

c-eqtm-app (G : Cx) (A A' B B' c c' a a' : Tm) (h0 : Der (jty G A)) (hB : Der (jty (csnoc G A) B)) (ha : Der (jtm G a A))
    (h1 : Der (jeqty G A A')) (h2 : Der (jeqty (csnoc G A) B B')) (h3 : Der (jeqtm G c c' (pi A B)))
    (h4 : Der (jeqtm G a a' A)) (r1 : PJ (jeqty G A A')) (r2 : PJ (jeqty (csnoc G A) B B'))
    (r3 : PJ (jeqtm G c c' (pi A B))) (r4 : PJ (jeqtm G a a' A)) :
    PJ (jeqtm G (app A B c a) (app A' B' c' a') (subst1 B a)) =
  (subst1-ty G A a B ha hB,
   tm-app G A B c a h0 hB r3.2.1 ha,
   tm-conv G (app A' B' c' a') (subst1 B' a') (subst1 B a)
     (tm-app G A' B' c' a' r1.2 (cx1-ty G (ok-of (jty G A) h0) A A' r1.2 h1 B' r2.2)
        (tm-conv G c' (pi A B) (pi A' B') r3.2.2 (eqty-pi G A A' B B' h0 h1 h2))
        (tm-conv G a' A A' r4.2.2 h1))
     (app-ty-eq G (ok-of (jty G A) h0) A B B' a a' hB ha r4.2.2 h2 h4)) ;

c-eqtm-pic (G : Cx) (n : Nat) (a a' b b' : Tm) (h0 : Der (jtm G a (uu n))) (h1 : Der (jeqtm G a a' (uu n)))
    (r0 : PJ (jtm G a (uu n))) (r1 : PJ (jeqtm G a a' (uu n))) (r2 : PJ (jeqtm (csnoc G (el n a)) b b' (uu n))) :
    PJ (jeqtm G (pic n a b) (pic n a' b') (uu n)) =
  (r0,
   tm-pic G n a b h0 r2.2.1,
   tm-pic G n a' b' r1.2.2
     (cx1-tm G (ok-of (jtm G a (uu n)) h0) (el n a) (el n a') (ty-el G n a' r1.2.2) (eqty-el G n a a' h1) b' (uu n) r2.2.2)) ;

c-eqtm-lf-pic (G : Cx) (n p : Nat) (a b : Tm) (h1 : Der (jtm G a (uu n))) (h2 : Der (jtm (csnoc G (el n a)) b (uu n)))
    (le : LeN (suc n) p) (nb : LeN p N) : PJ (jeqtm G (lf n p (pic n a b)) (pic p (lf n p a) (lf n p b)) (uu p)) =
  (ty-uu G p (wf-from-ok G (ok-of (jtm G a (uu n)) h1)) nb,
   tm-lf G n p (pic n a b) (tm-pic G n a b h1 h2) le nb,
   tm-pic G p (lf n p a) (lf n p b) (tm-lf G n p a h1 le nb)
     (tm-lf (csnoc G (el p (lf n p a))) n p b
        (cx1-tm G (ok-of (jtm G a (uu n)) h1) (el n a) (el p (lf n p a)) (ty-el G p (lf n p a) (tm-lf G n p a h1 le nb))
           (eqty-sym G (el p (lf n p a)) (el n a) (eqty-el-lf G n p a h1 le nb)) b (uu n) h2) le nb)) ;

------------------------------------------------------------------------
-- the presupposition lemma

presup : (J : Jf) -> Der J -> PJ J = split {
  wf-nil -> tt ;
  wf-snoc G A h -> tt ;
  tm-v0 G A h -> wk-ty G A A h h ;
  tm-vs G B n A h1 h2 | r1 r2 -> wk-ty G B A h2 r1 ;
  ty-pi G A B h1 h2 -> tt ;
  ty-uu G n h nb -> tt ;
  ty-el G n a h -> tt ;
  tm-lam G A B b h1 h2 h3 -> ty-pi G A B h1 h2 ;
  tm-app G A B c a h1 h2 h3 h4 -> subst1-ty G A a B h4 h2 ;
  tm-pic G n a b h1 h2 | r1 r2 -> r1 ;
  tm-uc G m n h lt nb -> ty-uu G n h nb ;
  tm-lf G m n a h le nb -> ty-uu G n (wf-from-ok G (ok-of (jtm G a (uu m)) h)) nb ;
  tm-conv G a A B h1 h2 | r1 r2 -> r2.2 ;
  eqty-refl G A h -> (h, h) ;
  eqty-sym G A B h | r -> (r.2, r.1) ;
  eqty-trans G A B C h1 h2 | r1 r2 -> (r1.1, r2.2) ;
  eqty-pi G A A' B B' h0 h1 h2 | r0 r1 r2 -> c-eqty-pi G A A' B B' h0 h1 h2 r1 r2 ;
  eqty-el G n a a' h | r -> (ty-el G n a r.2.1, ty-el G n a' r.2.2) ;
  eqty-el-lf G m n a h le nb -> (ty-el G n (lf m n a) (tm-lf G m n a h le nb), ty-el G m a h) ;
  eqty-el-pic G n a b h1 h2 ->
    (ty-el G n (pic n a b) (tm-pic G n a b h1 h2),
     ty-pi G (el n a) (el n b) (ty-el G n a h1) (ty-el (csnoc G (el n a)) n b h2)) ;
  eqty-el-uc G m n h lt nb -> (ty-el G n (uc m n) (tm-uc G m n h lt nb), ty-uu G m h (leN-trans m n N (lt-le m n lt) nb)) ;
  eqtm-refl G a A h | r -> (r, h, h) ;
  eqtm-sym G a b A hA h | rA r -> (r.1, r.2.2, r.2.1) ;
  eqtm-trans G a b c A h1 h2 | r1 r2 -> (r1.1, r1.2.1, r2.2.2) ;
  eqtm-conv G a b A B h1 h2 | r1 r2 -> (r2.2, tm-conv G a A B r1.2.1 h2, tm-conv G b A B r1.2.2 h2) ;
  eqtm-lam G A A' B B' b b' h0 h1 h2 h3 | r0 r1 r2 r3 -> c-eqtm-lam G A A' B B' b b' h0 h1 h2 h3 r1 r2 r3 ;
  eqtm-app G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | r0 rB ra r1 r2 r3 r4 ->
    c-eqtm-app G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 r1 r2 r3 r4 ;
  eqtm-pic G n a a' b b' h0 h1 h2 | r0 r1 r2 -> c-eqtm-pic G n a a' b b' h0 h1 r0 r1 r2 ;
  eqtm-lf G m n a a' h le nb | r ->
    (ty-uu G n (wf-from-ok G (ok-of (jeqtm G a a' (uu m)) h)) nb, tm-lf G m n a r.2.1 le nb, tm-lf G m n a' r.2.2 le nb) ;
  eqtm-beta G A B b a hA hB h1 h2 ->
    (subst1-ty G A a B h2 hB, tm-app G A B (lam A B b) a hA hB (tm-lam G A B b hA hB h1) h2, subst1-tm G A a b B h2 h1) ;
  eqtm-eta G A B f hA hB h -> (ty-pi G A B hA hB, h, eta-tm G A B f hA hB h) ;
  eqtm-lf-pic G n p a b h1 h2 le nb -> c-eqtm-lf-pic G n p a b h1 h2 le nb ;
  eqtm-lf-uc G m n p h lt le nb ->
    (ty-uu G p h nb,
     tm-lf G n p (uc m n) (tm-uc G m n h lt (leN-trans n p N (lt-le n p le) nb)) le nb,
     tm-uc G m p h (leN-trans (suc m) n p lt (lt-le n p le)) nb) ;
  eqtm-lf-lf G m n p a h le1 le2 nb ->
    (ty-uu G p (wf-from-ok G (ok-of (jtm G a (uu m)) h)) nb,
     tm-lf G n p (lf m n a) (tm-lf G m n a h le1 (leN-trans n p N (lt-le n p le2) nb)) le2 nb,
     tm-lf G m p a h (leN-trans (suc m) n p le1 (lt-le n p le2)) nb) } ;

-- the three lemmas, as the paper states them
presup-tm (G : Cx) (a A : Tm) (h : Der (jtm G a A)) : Der (jty G A) = presup (jtm G a A) h ;
presup-eqty (G : Cx) (A B : Tm) (h : Der (jeqty G A B)) : Der (jty G A) * Der (jty G B) = presup (jeqty G A B) h ;
presup-eqtm (G : Cx) (a b A : Tm) (h : Der (jeqtm G a b A)) : Der (jty G A) * Der (jtm G a A) * Der (jtm G b A) =
  presup (jeqtm G a b A) h ;

t-universe-tm-bound (G : Cx) (a : Tm) (n : Nat) (h : Der (jtm G a (uu n))) : LeN n N =
  t-universe-bound G n (presup-tm G a (uu n) h) ;

t-universe-eqtm-bound (G : Cx) (a b : Tm) (n : Nat) (h : Der (jeqtm G a b (uu n))) : LeN n N =
  t-universe-bound G n (presup-eqtm G a b (uu n) h).1 ;
