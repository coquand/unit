-- InitCheck.seg (PLAN-INIT): initiality of the term model of T_E among
-- Ehrhard models of level N.  Parts F (quotients, sorts, operations),
-- A (equations: TM : TEModel[N]), H (morphisms), E (existence: the
-- interpretation is a morphism), U (uniqueness), T (InitTheorem).
-- The axioms (univalence, replacement: images and their surjectivity) are
-- module parameters; quotients are effective small quotients.
import GATCheck ; open GATCheck ;
import Replacement ;
import Paths ;
import InitHom ;
module Init
 (ua : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j)
 (N : Base.Nat) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[ua @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[ua @l].prop-univ ;
 import Truncation ; import TruncationCombinators ;
 import InitQuot ; import InitSorts ; import InitOpsCtx ; import InitOpsSub ; import InitOpsExt ; import InitOpsPi ; import InitOpsU ;
 import InitModelShape ;
 import InitModelRep ; import InitModelRepOps ; import InitModelCat ; import InitModelExt ; import InitModelPi ; import InitModelU ; import InitModel ;
 import InitUniqTot ; import InitUniqCls ; import InitUniqClsTm ; import InitUniqBase ; import InitUniqCaseA ; import InitUniqCaseB ; import InitUniqInd ; import InitUniq ;
 module Exist (l : Level) (M : EhrhardTEModel[l].TEModel[N]) {
  import InitExistBase ; import InitExistMaps ; import InitExistLawsA ; import InitExistLawsB ; import InitExistHom ;
 } ;
 module Initial (l : Level) (M : EhrhardTEModel[l].TEModel[N]) {
  import InitTheorem ;
 } ;
} ;
