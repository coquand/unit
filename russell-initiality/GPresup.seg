-- GPresup.seg: presuppositions of Ehrhard-GAT, by one induction on GDer.
--   G |- A           gives  |- G
--   G |- a : A       gives  |- G,  G |- A
--   s : D -> G       gives  |- D,  |- G
--   |- G = D         gives  |- G,  |- D
--   G |- A = B       gives  |- G,  G |- A,  G |- B
--   G |- a = b : A   gives  |- G,  G |- A,  G |- a : A,  G |- b : A
--   s = t : D -> G   gives  |- D,  |- G,  s, t : D -> G
-- The substitution rules are explicit, so no meta-level substitution lemma
-- is needed; the Ehrhard axioms with a lift (gq-lift, gq-lift-id,
-- gq-lift-comp) and the annotated sections (gq-sec, gm-eapp) need the
-- context conversion of substitutions gs-cx.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open GAT[l] ;

W (G : GE) : U l = GDer (gjwf G) ;
Ty (G A : GE) : U l = GDer (gjty G A) ;
Tm' (G a A : GE) : U l = GDer (gjtm G a A) ;
Sb (D s G : GE) : U l = GDer (gjsub D s G) ;

GPJ : GJ -> U l = split {
  gjwf G -> Top ;
  gjty G A -> W G ;
  gjtm G a A -> W G * Ty G A ;
  gjsub D s G -> W D * W G ;
  gjeqcx G D -> W G * W D ;
  gjeqty G A B -> W G * (Ty G A * Ty G B) ;
  gjeqtm G a b A -> W G * (Ty G A * (Tm' G a A * Tm' G b A)) ;
  gjeqsub D s t G -> W D * (W G * (Sb D s G * Sb D t G)) } ;

------------------------------------------------------------------------
-- derived equations of the substitution calculus

-- context conversion along the last type
cxl (G A A' : GE) (wG : W G) (e : GDer (gjeqty G A A')) : GDer (gjeqcx (gext G A) (gext G A')) =
  gc-ext G G A A' (gc-refl G wG) e ;

-- (A p) sec(A, a) = A
sb-p-sec (G A a : GE) (wG : W G) (hA : Ty G A) (ha : Tm' G a A) : GDer (gjeqty G (gsb (gsb A gp) (gsec A a)) A) =
  ge-trans G (gsb (gsb A gp) (gsec A a)) (gsb A (gcomp gp (gsec A a))) A
    (ge-sb-comp G (gext G A) G A gp (gsec A a) hA (gs-p G A hA) (gs-sec G A a hA ha))
    (ge-trans G (gsb A (gcomp gp (gsec A a))) (gsb A gid) A
       (ge-sb G G A A (gcomp gp (gsec A a)) gid hA (ge-refl G A hA)
          (gs-comp G (gext G A) G gp (gsec A a) (gs-p G A hA) (gs-sec G A a hA ha)) (gs-id G wG) (gq-p-sec G A a hA ha))
       (ge-sb-id G A hA)) ;

-- (A p) lift_A(s) = (A s) p   over D.(A s)
sb-p-lift (D G A s : GE) (hA : Ty G A) (hs : Sb D s G) :
    GDer (gjeqty (gext D (gsb A s)) (gsb (gsb A gp) (glift A s)) (gsb (gsb A s) gp)) =
  ge-trans (gext D (gsb A s)) (gsb (gsb A gp) (glift A s)) (gsb A (gcomp gp (glift A s))) (gsb (gsb A s) gp)
    (ge-sb-comp (gext D (gsb A s)) (gext G A) G A gp (glift A s) hA (gs-p G A hA) (gs-lift D G A s hs hA))
    (ge-trans (gext D (gsb A s)) (gsb A (gcomp gp (glift A s))) (gsb A (gcomp s gp)) (gsb (gsb A s) gp)
       (ge-sb (gext D (gsb A s)) G A A (gcomp gp (glift A s)) (gcomp s gp) hA (ge-refl G A hA)
          (gs-comp (gext D (gsb A s)) (gext G A) G gp (glift A s) (gs-p G A hA) (gs-lift D G A s hs hA))
          (gs-comp (gext D (gsb A s)) D G s gp hs (gs-p D (gsb A s) (gt-sb D G A s hA hs)))
          (gq-p-lift D G A s hA hs))
       (ge-sym (gext D (gsb A s)) (gsb (gsb A s) gp) (gsb A (gcomp s gp))
          (ge-sb-comp (gext D (gsb A s)) D G A s gp hA hs (gs-p D (gsb A s) (gt-sb D G A s hA hs))))) ;

-- (B lift_A(p)) sec(A p, q) = B   over G.A
sb-eta (G A B : GE) (hA : Ty G A) (hB : Ty (gext G A) B) :
    GDer (gjeqty (gext G A) (gsb (gsb B (glift A gp)) (gsec (gsb A gp) gq)) B) =
  ge-trans (gext G A) (gsb (gsb B (glift A gp)) (gsec (gsb A gp) gq)) (gsb B (gcomp (glift A gp) (gsec (gsb A gp) gq))) B
    (ge-sb-comp (gext G A) (gext (gext G A) (gsb A gp)) (gext G A) B (glift A gp) (gsec (gsb A gp) gq) hB
       (gs-lift (gext G A) G A gp (gs-p G A hA) hA)
       (gs-sec (gext G A) (gsb A gp) gq (gt-sb (gext G A) G A gp hA (gs-p G A hA)) (gm-q G A hA)))
    (ge-trans (gext G A) (gsb B (gcomp (glift A gp) (gsec (gsb A gp) gq))) (gsb B gid) B
       (ge-sb (gext G A) (gext G A) B B (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid hB (ge-refl (gext G A) B hB)
          (gs-comp (gext G A) (gext (gext G A) (gsb A gp)) (gext G A) (glift A gp) (gsec (gsb A gp) gq)
             (gs-lift (gext G A) G A gp (gs-p G A hA) hA)
             (gs-sec (gext G A) (gsb A gp) gq (gt-sb (gext G A) G A gp hA (gs-p G A hA)) (gm-q G A hA)))
          (gs-id (gext G A) (g-ext G A hA)) (gq-lift-p-sec-q G A hA))
       (ge-sb-id (gext G A) B hB)) ;

-- (B sec(A,a)) s = (B lift_A(s)) sec(A s, a s)
sb-sec-comp (D G A B a s : GE) (hA : Ty G A) (hB : Ty (gext G A) B) (ha : Tm' G a A) (hs : Sb D s G) :
    GDer (gjeqty D (gsb (gsb B (gsec A a)) s) (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s)))) =
  ge-trans D (gsb (gsb B (gsec A a)) s) (gsb B (gcomp (gsec A a) s)) (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s)))
    (ge-sb-comp D G (gext G A) B (gsec A a) s hB (gs-sec G A a hA ha) hs)
    (ge-trans D (gsb B (gcomp (gsec A a) s)) (gsb B (gcomp (glift A s) (gsec (gsb A s) (gsb a s))))
       (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s)))
       (ge-sb D (gext G A) B B (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))) hB (ge-refl (gext G A) B hB)
          (gs-comp D G (gext G A) (gsec A a) s (gs-sec G A a hA ha) hs)
          (gs-comp D (gext D (gsb A s)) (gext G A) (glift A s) (gsec (gsb A s) (gsb a s)) (gs-lift D G A s hs hA)
             (gs-sec D (gsb A s) (gsb a s) (gt-sb D G A s hA hs) (gm-sb D G a A s hA ha hs)))
          (gq-sec-comp D G A a s hA ha hs))
       (ge-sym D (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s))) (gsb B (gcomp (glift A s) (gsec (gsb A s) (gsb a s))))
          (ge-sb-comp D (gext D (gsb A s)) (gext G A) B (glift A s) (gsec (gsb A s) (gsb a s)) hB (gs-lift D G A s hs hA)
             (gs-sec D (gsb A s) (gsb a s) (gt-sb D G A s hA hs) (gm-sb D G a A s hA ha hs))))) ;

-- a : U_n gives a s : U_n
sb-uu (D G a s : GE) (n : Nat) (hU : Ty G (guu n)) (ha : Tm' G a (guu n)) (hs : Sb D s G) : Tm' D (gsb a s) (guu n) =
  gm-conv D (gsb a s) (gsb (guu n) s) (guu n) (gm-sb D G a (guu n) s hU ha hs) (ge-uu-sb D G n s hs (g-universe-bound G n hU)) ;

------------------------------------------------------------------------
-- the binder cases

c-ge-pi (G A A' B B' : GE) (h0 : Ty G A) (h1 : GDer (gjeqty G A A')) (h2 : GDer (gjeqty (gext G A) B B'))
    (r0 : GPJ (gjty G A)) (r1 : GPJ (gjeqty G A A')) (r2 : GPJ (gjeqty (gext G A) B B')) :
    GPJ (gjeqty G (gpi A B) (gpi A' B')) =
  (r0, (gt-pi G A B h0 r2.2.1,
        gt-pi G A' B' r1.2.2 (gt-cx (gext G A) (gext G A') B' (g-ext G A' r1.2.2) (cxl G A A' r0 h1) r2.2.2))) ;

c-gm-elam (G A A' B B' b b' : GE) (h0 : Ty G A) (h1 : GDer (gjeqty G A A')) (h2 : GDer (gjeqty (gext G A) B B'))
    (r0 : GPJ (gjty G A)) (r1 : GPJ (gjeqty G A A')) (r2 : GPJ (gjeqty (gext G A) B B'))
    (r3 : GPJ (gjeqtm (gext G A) b b' B)) : GPJ (gjeqtm G (glam A B b) (glam A' B' b') (gpi A B)) =
  (r0, (gt-pi G A B h0 r3.2.1, (gm-lam G A B b h0 r3.2.1 r3.2.2.1,
   gm-conv G (glam A' B' b') (gpi A' B') (gpi A B)
     (gm-lam G A' B' b' r1.2.2 (gt-cx (gext G A) (gext G A') B' (g-ext G A' r1.2.2) (cxl G A A' r0 h1) r2.2.2)
        (gm-cx (gext G A) (gext G A') b' B' (g-ext G A' r1.2.2) (cxl G A A' r0 h1)
           (gm-conv (gext G A) b' B B' r3.2.2.2 h2)))
     (ge-sym G (gpi A B) (gpi A' B') (ge-pi G A A' B B' h0 h1 h2))))) ;

-- sec(A', a') : G -> G.A
sec-cx (G A A' a' : GE) (wG : W G) (hA : Ty G A) (hA' : Ty G A') (h1 : GDer (gjeqty G A A')) (ha' : Tm' G a' A) :
    Sb G (gsec A' a') (gext G A) =
  gs-cx G G (gext G A') (gext G A) (gsec A' a') wG (g-ext G A hA) (gc-refl G wG) (cxl G A' A wG (ge-sym G A A' h1))
    (gs-sec G A' a' hA' (gm-conv G a' A A' ha' h1)) ;

c-gm-eapp (G A A' B B' c c' a a' : GE) (h0 : Ty G A) (hB : Ty (gext G A) B) (ha : Tm' G a A)
    (h1 : GDer (gjeqty G A A')) (h2 : GDer (gjeqty (gext G A) B B')) (h4 : GDer (gjeqtm G a a' A))
    (r0 : GPJ (gjty G A)) (r1 : GPJ (gjeqty G A A')) (r2 : GPJ (gjeqty (gext G A) B B'))
    (r3 : GPJ (gjeqtm G c c' (gpi A B))) (r4 : GPJ (gjeqtm G a a' A)) :
    GPJ (gjeqtm G (gapp A B c a) (gapp A' B' c' a') (gsb B (gsec A a))) =
  (r0, (gt-sb G (gext G A) B (gsec A a) hB (gs-sec G A a h0 ha), (gm-app G A B c a h0 hB r3.2.2.1 ha,
   gm-conv G (gapp A' B' c' a') (gsb B' (gsec A' a')) (gsb B (gsec A a))
     (gm-app G A' B' c' a' r1.2.2 (gt-cx (gext G A) (gext G A') B' (g-ext G A' r1.2.2) (cxl G A A' r0 h1) r2.2.2)
        (gm-conv G c' (gpi A B) (gpi A' B') r3.2.2.2 (ge-pi G A A' B B' h0 h1 h2))
        (gm-conv G a' A A' r4.2.2.2 h1))
     (ge-sym G (gsb B (gsec A a)) (gsb B' (gsec A' a'))
        (ge-sb G (gext G A) B B' (gsec A a) (gsec A' a') hB h2 (gs-sec G A a h0 ha)
           (sec-cx G A A' a' r0 h0 r1.2.2 h1 r4.2.2.2) (gq-sec G A A' a a' h0 ha r4.2.2.2 h1 h4)))))) ;

c-gm-epic (G : GE) (n : Nat) (a a' b b' : GE) (h0 : Tm' G a (guu n)) (h1 : GDer (gjeqtm G a a' (guu n)))
    (r0 : GPJ (gjtm G a (guu n))) (r1 : GPJ (gjeqtm G a a' (guu n))) (r2 : GPJ (gjeqtm (gext G (gel n a)) b b' (guu n))) :
    GPJ (gjeqtm G (gpic n a b) (gpic n a' b') (guu n)) =
  (r0.1, (r0.2, (gm-pic G n a b h0 r2.2.2.1,
   gm-pic G n a' b' r1.2.2.2
     (gm-cx (gext G (gel n a)) (gext G (gel n a')) b' (guu n) (g-ext G (gel n a') (gt-el G n a' r1.2.2.2))
        (cxl G (gel n a) (gel n a') r0.1 (ge-el G n a a' h1)) r2.2.2.2)))) ;

c-gm-eta (G A B f : GE) (hA : Ty G A) (hB : Ty (gext G A) B) (h : Tm' G f (gpi A B)) (wG : W G) :
    GPJ (gjeqtm G f (glam A B (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq)) (gpi A B)) =
  (wG, (gt-pi G A B hA hB, (h,
   gm-lam G A B (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq) hA hB
     (gm-conv (gext G A) (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq)
        (gsb (gsb B (glift A gp)) (gsec (gsb A gp) gq)) B
        (gm-app (gext G A) (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq
           (gt-sb (gext G A) G A gp hA (gs-p G A hA))
           (gt-sb (gext (gext G A) (gsb A gp)) (gext G A) B (glift A gp) hB (gs-lift (gext G A) G A gp (gs-p G A hA) hA))
           (gm-conv (gext G A) (gsb f gp) (gsb (gpi A B) gp) (gpi (gsb A gp) (gsb B (glift A gp)))
              (gm-sb (gext G A) G f (gpi A B) gp (gt-pi G A B hA hB) h (gs-p G A hA))
              (ge-pi-sb (gext G A) G A B gp hA hB (gs-p G A hA)))
           (gm-q G A hA))
        (sb-eta G A B hA hB))))) ;

c-gm-lf-pic (G : GE) (n p : Nat) (a b : GE) (h1 : Tm' G a (guu n)) (h2 : Tm' (gext G (gel n a)) b (guu n))
    (le : LeN (suc n) p) (nb : LeN p N) (wG : W G) : GPJ (gjeqtm G (glf n p (gpic n a b)) (gpic p (glf n p a) (glf n p b)) (guu p)) =
  (wG, (gt-uu G p wG nb, (gm-lf G n p (gpic n a b) (gm-pic G n a b h1 h2) le nb,
   gm-pic G p (glf n p a) (glf n p b) (gm-lf G n p a h1 le nb)
     (gm-lf (gext G (gel p (glf n p a))) n p b
        (gm-cx (gext G (gel n a)) (gext G (gel p (glf n p a))) b (guu n)
           (g-ext G (gel p (glf n p a)) (gt-el G p (glf n p a) (gm-lf G n p a h1 le nb)))
           (cxl G (gel n a) (gel p (glf n p a)) wG (ge-sym G (gel p (glf n p a)) (gel n a) (ge-el-lf G n p a h1 le nb))) h2)
        le nb)))) ;

------------------------------------------------------------------------
-- substitution cases

c-gm-sb-comp (T D G a A s d : GE) (h0 : Tm' G a A) (h1 : Sb D s G) (h2 : Sb T d D) (hA : Ty G A) (wT : W T) :
    GPJ (gjeqtm T (gsb (gsb a s) d) (gsb a (gcomp s d)) (gsb A (gcomp s d))) =
  (wT, (gt-sb T G A (gcomp s d) hA (gs-comp T D G s d h1 h2),
   (gm-conv T (gsb (gsb a s) d) (gsb (gsb A s) d) (gsb A (gcomp s d))
      (gm-sb T D (gsb a s) (gsb A s) d (gt-sb D G A s hA h1) (gm-sb D G a A s hA h0 h1) h2)
      (ge-sb-comp T D G A s d hA h1 h2),
    gm-sb T G a A (gcomp s d) hA h0 (gs-comp T D G s d h1 h2)))) ;

c-gm-lam-sb (D G A B b s : GE) (h1 : Ty G A) (h2 : Ty (gext G A) B) (h3 : Tm' (gext G A) b B) (h4 : Sb D s G) (wD : W D) :
    GPJ (gjeqtm D (gsb (glam A B b) s) (glam (gsb A s) (gsb B (glift A s)) (gsb b (glift A s)))
                 (gpi (gsb A s) (gsb B (glift A s)))) =
  (wD, (gt-pi D (gsb A s) (gsb B (glift A s)) (gt-sb D G A s h1 h4)
          (gt-sb (gext D (gsb A s)) (gext G A) B (glift A s) h2 (gs-lift D G A s h4 h1)),
   (gm-conv D (gsb (glam A B b) s) (gsb (gpi A B) s) (gpi (gsb A s) (gsb B (glift A s)))
      (gm-sb D G (glam A B b) (gpi A B) s (gt-pi G A B h1 h2) (gm-lam G A B b h1 h2 h3) h4)
      (ge-pi-sb D G A B s h1 h2 h4),
    gm-lam D (gsb A s) (gsb B (glift A s)) (gsb b (glift A s)) (gt-sb D G A s h1 h4)
      (gt-sb (gext D (gsb A s)) (gext G A) B (glift A s) h2 (gs-lift D G A s h4 h1))
      (gm-sb (gext D (gsb A s)) (gext G A) b B (glift A s) h2 h3 (gs-lift D G A s h4 h1))))) ;

c-gm-app-sb (D G A B c a s : GE) (h1 : Ty G A) (h2 : Ty (gext G A) B) (h3 : Tm' G c (gpi A B)) (h4 : Tm' G a A)
    (h5 : Sb D s G) (wD : W D) :
    GPJ (gjeqtm D (gsb (gapp A B c a) s) (gapp (gsb A s) (gsb B (glift A s)) (gsb c s) (gsb a s))
                 (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s)))) =
  (wD, (gt-sb D (gext D (gsb A s)) (gsb B (glift A s)) (gsec (gsb A s) (gsb a s))
          (gt-sb (gext D (gsb A s)) (gext G A) B (glift A s) h2 (gs-lift D G A s h5 h1))
          (gs-sec D (gsb A s) (gsb a s) (gt-sb D G A s h1 h5) (gm-sb D G a A s h1 h4 h5)),
   (gm-conv D (gsb (gapp A B c a) s) (gsb (gsb B (gsec A a)) s) (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s)))
      (gm-sb D G (gapp A B c a) (gsb B (gsec A a)) s (gt-sb G (gext G A) B (gsec A a) h2 (gs-sec G A a h1 h4))
         (gm-app G A B c a h1 h2 h3 h4) h5)
      (sb-sec-comp D G A B a s h1 h2 h4 h5),
    gm-app D (gsb A s) (gsb B (glift A s)) (gsb c s) (gsb a s) (gt-sb D G A s h1 h5)
      (gt-sb (gext D (gsb A s)) (gext G A) B (glift A s) h2 (gs-lift D G A s h5 h1))
      (gm-conv D (gsb c s) (gsb (gpi A B) s) (gpi (gsb A s) (gsb B (glift A s)))
         (gm-sb D G c (gpi A B) s (gt-pi G A B h1 h2) h3 h5) (ge-pi-sb D G A B s h1 h2 h5))
      (gm-sb D G a A s h1 h4 h5)))) ;

c-gm-pic-sb (D G : GE) (n : Nat) (a b s : GE) (h1 : Tm' G a (guu n)) (h2 : Tm' (gext G (gel n a)) b (guu n))
    (h3 : Sb D s G) (wD : W D) (hU : Ty G (guu n)) (hUext : Ty (gext G (gel n a)) (guu n)) :
    GPJ (gjeqtm D (gsb (gpic n a b) s) (gpic n (gsb a s) (gsb b (glift (gel n a) s))) (guu n)) =
  (wD, (gt-uu D n wD (g-universe-bound G n hU),
   (sb-uu D G (gpic n a b) s n hU (gm-pic G n a b h1 h2) h3,
    gm-pic D n (gsb a s) (gsb b (glift (gel n a) s)) (sb-uu D G a s n hU h1 h3)
      (gm-cx (gext D (gsb (gel n a) s)) (gext D (gel n (gsb a s))) (gsb b (glift (gel n a) s)) (guu n)
         (g-ext D (gel n (gsb a s)) (gt-el D n (gsb a s) (sb-uu D G a s n hU h1 h3)))
         (cxl D (gsb (gel n a) s) (gel n (gsb a s)) wD (ge-el-sb D G n a s h1 h3))
         (sb-uu (gext D (gsb (gel n a) s)) (gext G (gel n a)) b (glift (gel n a) s) n
            hUext h2 (gs-lift D G (gel n a) s h3 (gt-el G n a h1))))))) ;

c-gm-q-lift (D G A s : GE) (h1 : Ty G A) (h2 : Sb D s G) :
    GPJ (gjeqtm (gext D (gsb A s)) (gsb gq (glift A s)) gq (gsb (gsb A s) gp)) =
  (g-ext D (gsb A s) (gt-sb D G A s h1 h2),
   (gt-sb (gext D (gsb A s)) D (gsb A s) gp (gt-sb D G A s h1 h2) (gs-p D (gsb A s) (gt-sb D G A s h1 h2)),
    (gm-conv (gext D (gsb A s)) (gsb gq (glift A s)) (gsb (gsb A gp) (glift A s)) (gsb (gsb A s) gp)
       (gm-sb (gext D (gsb A s)) (gext G A) gq (gsb A gp) (glift A s) (gt-sb (gext G A) G A gp h1 (gs-p G A h1))
          (gm-q G A h1) (gs-lift D G A s h2 h1))
       (sb-p-lift D G A s h1 h2),
     gm-q D (gsb A s) (gt-sb D G A s h1 h2)))) ;

c-gm-q-sec (G A a : GE) (h1 : Ty G A) (h2 : Tm' G a A) (wG : W G) : GPJ (gjeqtm G (gsb gq (gsec A a)) a A) =
  (wG, (h1,
   (gm-conv G (gsb gq (gsec A a)) (gsb (gsb A gp) (gsec A a)) A
      (gm-sb G (gext G A) gq (gsb A gp) (gsec A a) (gt-sb (gext G A) G A gp h1 (gs-p G A h1)) (gm-q G A h1)
         (gs-sec G A a h1 h2))
      (sb-p-sec G A a wG h1 h2),
    h2))) ;

------------------------------------------------------------------------
-- substitution equality cases

c-gq-lift (D G A A' s s' : GE) (h0 : Ty G A) (h1 : GDer (gjeqty G A A')) (h2 : Sb D s G)
    (h3 : GDer (gjeqsub D s s' G)) (r1 : GPJ (gjeqty G A A')) (r2 : GPJ (gjsub D s G)) (r3 : GPJ (gjeqsub D s s' G)) :
    GPJ (gjeqsub (gext D (gsb A s)) (glift A s) (glift A' s') (gext G A)) =
  (g-ext D (gsb A s) (gt-sb D G A s h0 h2), (g-ext G A h0, (gs-lift D G A s h2 h0,
   gs-cx (gext D (gsb A' s')) (gext D (gsb A s)) (gext G A') (gext G A) (glift A' s')
     (g-ext D (gsb A s) (gt-sb D G A s h0 h2)) (g-ext G A h0)
     (cxl D (gsb A' s') (gsb A s) r2.1 (ge-sym D (gsb A s) (gsb A' s') (ge-sb D G A A' s s' h0 h1 h2 r3.2.2.2 h3)))
     (cxl G A' A r2.2 (ge-sym G A A' h1))
     (gs-lift D G A' s' r3.2.2.2 r1.2.2)))) ;

c-gq-lift-id (G A : GE) (h : Ty G A) (wG : W G) :
    GPJ (gjeqsub (gext G (gsb A gid)) (glift A gid) gid (gext G A)) =
  (g-ext G (gsb A gid) (gt-sb G G A gid h (gs-id G wG)), (g-ext G A h, (gs-lift G G A gid (gs-id G wG) h,
   gs-cx (gext G A) (gext G (gsb A gid)) (gext G A) (gext G A) gid
     (g-ext G (gsb A gid) (gt-sb G G A gid h (gs-id G wG))) (g-ext G A h)
     (cxl G A (gsb A gid) wG (ge-sym G (gsb A gid) A (ge-sb-id G A h)))
     (gc-refl (gext G A) (g-ext G A h)) (gs-id (gext G A) (g-ext G A h))))) ;

c-gq-lift-comp (T D G A s d : GE) (h0 : Ty G A) (h1 : Sb D s G) (h2 : Sb T d D) (wT : W T) :
    GPJ (gjeqsub (gext T (gsb A (gcomp s d))) (glift A (gcomp s d)) (gcomp (glift A s) (glift (gsb A s) d)) (gext G A)) =
  (g-ext T (gsb A (gcomp s d)) (gt-sb T G A (gcomp s d) h0 (gs-comp T D G s d h1 h2)), (g-ext G A h0,
   (gs-lift T G A (gcomp s d) (gs-comp T D G s d h1 h2) h0,
    gs-cx (gext T (gsb (gsb A s) d)) (gext T (gsb A (gcomp s d))) (gext G A) (gext G A) (gcomp (glift A s) (glift (gsb A s) d))
      (g-ext T (gsb A (gcomp s d)) (gt-sb T G A (gcomp s d) h0 (gs-comp T D G s d h1 h2))) (g-ext G A h0)
      (cxl T (gsb (gsb A s) d) (gsb A (gcomp s d)) wT (ge-sb-comp T D G A s d h0 h1 h2))
      (gc-refl (gext G A) (g-ext G A h0))
      (gs-comp (gext T (gsb (gsb A s) d)) (gext D (gsb A s)) (gext G A) (glift A s) (glift (gsb A s) d)
         (gs-lift D G A s h1 h0) (gs-lift T D (gsb A s) d h2 (gt-sb D G A s h0 h1)))))) ;

c-gq-sec-comp (D G A a s : GE) (h1 : Ty G A) (h2 : Tm' G a A) (h3 : Sb D s G) (wD : W D) :
    GPJ (gjeqsub D (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))) (gext G A)) =
  (wD, (g-ext G A h1, (gs-comp D G (gext G A) (gsec A a) s (gs-sec G A a h1 h2) h3,
   gs-comp D (gext D (gsb A s)) (gext G A) (glift A s) (gsec (gsb A s) (gsb a s)) (gs-lift D G A s h3 h1)
     (gs-sec D (gsb A s) (gsb a s) (gt-sb D G A s h1 h3) (gm-sb D G a A s h1 h2 h3))))) ;

c-gq-lift-p-sec-q (G A : GE) (h : Ty G A) :
    GPJ (gjeqsub (gext G A) (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid (gext G A)) =
  (g-ext G A h, (g-ext G A h,
   (gs-comp (gext G A) (gext (gext G A) (gsb A gp)) (gext G A) (glift A gp) (gsec (gsb A gp) gq)
      (gs-lift (gext G A) G A gp (gs-p G A h) h)
      (gs-sec (gext G A) (gsb A gp) gq (gt-sb (gext G A) G A gp h (gs-p G A h)) (gm-q G A h)),
    gs-id (gext G A) (g-ext G A h)))) ;

------------------------------------------------------------------------
-- the presupposition lemma

gpresup : (J : GJ) -> GDer J -> GPJ J = split {
  g-nil -> tt ;
  g-ext G A h -> tt ;
  gc-nil -> (g-nil, g-nil) ;
  gc-refl G h -> (h, h) ;
  gc-ext G D A B h1 h2 | r1 r2 -> (g-ext G A r2.2.1, g-ext D B (gt-cx G D B r1.2 h1 r2.2.2)) ;
  gs-id G h -> (h, h) ;
  gs-comp T D G s d h1 h2 | r1 r2 -> (r2.1, r1.2) ;
  gs-eps G h -> (h, g-nil) ;
  gs-p G A h | r -> (g-ext G A h, r) ;
  gs-lift D G A s h1 h2 | r1 r2 -> (g-ext D (gsb A s) (gt-sb D G A s h2 h1), g-ext G A h2) ;
  gs-sec G A a h1 h2 | r1 r2 -> (r1, g-ext G A h1) ;
  gs-cx D D' G G' s h0 h0' h1 h2 h -> (h0, h0') ;
  gt-pi G A B h1 h2 | r1 r2 -> r1 ;
  gt-uu G n h nb -> h ;
  gt-el G n a h | r -> r.1 ;
  gt-sb D G A s h1 h2 | r1 r2 -> r2.1 ;
  gt-cx G D A h0 h1 h2 -> h0 ;
  gm-lam G A B b h1 h2 h3 | r1 r2 r3 -> (r1, gt-pi G A B h1 h2) ;
  gm-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> (r1, gt-sb G (gext G A) B (gsec A a) h2 (gs-sec G A a h1 h4)) ;
  gm-pic G n a b h1 h2 | r1 r2 -> r1 ;
  gm-uc G m n h lt nb -> (h, gt-uu G n h nb) ;
  gm-lf G m n a h le nb | r -> (r.1, gt-uu G n r.1 nb) ;
  gm-q G A h | r -> (g-ext G A h, gt-sb (gext G A) G A gp h (gs-p G A h)) ;
  gm-sb D G a A s hA h1 h2 | rA r1 r2 -> (r2.1, gt-sb D G A s hA h2) ;
  gm-conv G a A B h1 h2 | r1 r2 -> (r1.1, r2.2.2) ;
  gm-cx G D a A h0 h1 h2 | r0 r1 r2 -> (h0, gt-cx G D A h0 h1 r2.2) ;
  ge-refl G A h | r -> (r, (h, h)) ;
  ge-sym G A B h | r -> (r.1, (r.2.2, r.2.1)) ;
  ge-trans G A B C h1 h2 | r1 r2 -> (r1.1, (r1.2.1, r2.2.2)) ;
  ge-pi G A A' B B' h0 h1 h2 | r0 r1 r2 -> c-ge-pi G A A' B B' h0 h1 h2 r0 r1 r2 ;
  ge-el G n a a' h | r -> (r.1, (gt-el G n a r.2.2.1, gt-el G n a' r.2.2.2)) ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 | r0 r1 r2 r3 r4 -> (r2.1, (gt-sb D G A s h0 h2, gt-sb D G A' s' r1.2.2 h3)) ;
  ge-el-lf G m n a h le nb | r -> (r.1, (gt-el G n (glf m n a) (gm-lf G m n a h le nb), gt-el G m a h)) ;
  ge-el-pic G n a b h1 h2 | r1 r2 ->
    (r1.1, (gt-el G n (gpic n a b) (gm-pic G n a b h1 h2),
            gt-pi G (gel n a) (gel n b) (gt-el G n a h1) (gt-el (gext G (gel n a)) n b h2))) ;
  ge-el-uc G m n h lt nb -> (h, (gt-el G n (guc m n) (gm-uc G m n h lt nb), gt-uu G m h (leN-trans m n N (lt-le m n lt) nb))) ;
  ge-sb-id G A h | r -> (r, (gt-sb G G A gid h (gs-id G r), h)) ;
  ge-sb-comp T D G A s d h0 h1 h2 | r0 r1 r2 ->
    (r2.1, (gt-sb T D (gsb A s) d (gt-sb D G A s h0 h1) h2, gt-sb T G A (gcomp s d) h0 (gs-comp T D G s d h1 h2))) ;
  ge-pi-sb D G A B s h1 h2 h3 | r1 r2 r3 ->
    (r3.1, (gt-sb D G (gpi A B) s (gt-pi G A B h1 h2) h3,
            gt-pi D (gsb A s) (gsb B (glift A s)) (gt-sb D G A s h1 h3)
              (gt-sb (gext D (gsb A s)) (gext G A) B (glift A s) h2 (gs-lift D G A s h3 h1)))) ;
  ge-uu-sb D G n s h nb | r -> (r.1, (gt-sb D G (guu n) s (gt-uu G n r.2 nb) h, gt-uu D n r.1 nb)) ;
  ge-el-sb D G n a s h1 h2 | r1 r2 ->
    (r2.1, (gt-sb D G (gel n a) s (gt-el G n a h1) h2, gt-el D n (gsb a s) (sb-uu D G a s n r1.2 h1 h2))) ;
  ge-cx G D A B h0 h1 h2 | r0 r1 r2 -> (h0, (gt-cx G D A h0 h1 r2.2.1, gt-cx G D B h0 h1 r2.2.2)) ;
  gm-refl G a A h | r -> (r.1, (r.2, (h, h))) ;
  gm-sym G a b A hA h | rA r -> (r.1, (r.2.1, (r.2.2.2, r.2.2.1))) ;
  gm-trans G a b c A h1 h2 | r1 r2 -> (r1.1, (r1.2.1, (r1.2.2.1, r2.2.2.2))) ;
  gm-eqconv G a b A B h1 h2 | r1 r2 ->
    (r1.1, (r2.2.2, (gm-conv G a A B r1.2.2.1 h2, gm-conv G b A B r1.2.2.2 h2))) ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 | r0 r1 r2 r3 -> c-gm-elam G A A' B B' b b' h0 h1 h2 r0 r1 r2 r3 ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | r0 rB ra r1 r2 r3 r4 ->
    c-gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h4 r0 r1 r2 r3 r4 ;
  gm-epic G n a a' b b' h0 h1 h2 | r0 r1 r2 -> c-gm-epic G n a a' b b' h0 h1 r0 r1 r2 ;
  gm-elf G m n a a' h le nb | r -> (r.1, (gt-uu G n r.1 nb, (gm-lf G m n a r.2.2.1 le nb, gm-lf G m n a' r.2.2.2 le nb))) ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 | rA r0 r1 r2 r3 r4 ->
    (r2.1, (gt-sb D G A s hA h2, (gm-sb D G a A s hA h0 h2,
     gm-conv D (gsb a' s') (gsb A s') (gsb A s) (gm-sb D G a' A s' hA r1.2.2.2 h3)
       (ge-sym D (gsb A s) (gsb A s') (ge-sb D G A A s s' hA (ge-refl G A hA) h2 h3 h4))))) ;
  gm-beta G A B b a hA hB h1 h2 | rA rB r1 r2 ->
    (rA, (gt-sb G (gext G A) B (gsec A a) hB (gs-sec G A a hA h2),
     (gm-app G A B (glam A B b) a hA hB (gm-lam G A B b hA hB h1) h2,
      gm-sb G (gext G A) b B (gsec A a) hB h1 (gs-sec G A a hA h2)))) ;
  gm-eta G A B f hA hB h | rA rB r -> c-gm-eta G A B f hA hB h rA ;
  gm-lf-pic G n p a b h1 h2 le nb | r1 r2 -> c-gm-lf-pic G n p a b h1 h2 le nb r1.1 ;
  gm-lf-uc G m n p h lt le nb ->
    (h, (gt-uu G p h nb,
      (gm-lf G n p (guc m n) (gm-uc G m n h lt (leN-trans n p N (lt-le n p le) nb)) le nb,
       gm-uc G m p h (leN-trans (suc m) n p lt (lt-le n p le)) nb))) ;
  gm-lf-lf G m n p a h le1 le2 nb | r ->
    (r.1, (gt-uu G p r.1 nb,
       (gm-lf G n p (glf m n a) (gm-lf G m n a h le1 (leN-trans n p N (lt-le n p le2) nb)) le2 nb,
        gm-lf G m p a h (leN-trans (suc m) n p le1 (lt-le n p le2)) nb))) ;
  gm-sb-id G a A h | r ->
    (r.1, (r.2, (gm-conv G (gsb a gid) (gsb A gid) A (gm-sb G G a A gid r.2 h (gs-id G r.1)) (ge-sb-id G A r.2), h))) ;
  gm-sb-comp T D G a A s d h0 h1 h2 | r0 r1 r2 -> c-gm-sb-comp T D G a A s d h0 h1 h2 r0.2 r2.1 ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 | r1 r2 r3 r4 -> c-gm-lam-sb D G A B b s h1 h2 h3 h4 r4.1 ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 | r1 r2 r3 r4 r5 -> c-gm-app-sb D G A B c a s h1 h2 h3 h4 h5 r5.1 ;
  gm-pic-sb D G n a b s h1 h2 h3 | r1 r2 r3 -> c-gm-pic-sb D G n a b s h1 h2 h3 r3.1 r1.2 r2.2 ;
  gm-uc-sb D G m n s h lt nb | r ->
    (r.1, (gt-uu D n r.1 nb, (sb-uu D G (guc m n) s n (gt-uu G n r.2 nb) (gm-uc G m n r.2 lt nb) h, gm-uc D m n r.1 lt nb))) ;
  gm-lf-sb D G m n a s h1 h2 le nb | r1 r2 ->
    (r2.1, (gt-uu D n r2.1 nb, (sb-uu D G (glf m n a) s n (gt-uu G n r2.2 nb) (gm-lf G m n a h1 le nb) h2,
     gm-lf D m n (gsb a s) (sb-uu D G a s m r1.2 h1 h2) le nb))) ;
  gm-q-lift D G A s h1 h2 | r1 r2 -> c-gm-q-lift D G A s h1 h2 ;
  gm-q-sec G A a h1 h2 | r1 r2 -> c-gm-q-sec G A a h1 h2 r1 ;
  gm-ecx G D a b A h0 h1 h2 | r0 r1 r2 ->
    (h0, (gt-cx G D A h0 h1 r2.2.1, (gm-cx G D a A h0 h1 r2.2.2.1, gm-cx G D b A h0 h1 r2.2.2.2))) ;
  gq-refl D s G h | r -> (r.1, (r.2, (h, h))) ;
  gq-sym D s t G h | r -> (r.1, (r.2.1, (r.2.2.2, r.2.2.1))) ;
  gq-trans D s t u G h1 h2 | r1 r2 -> (r1.1, (r1.2.1, (r1.2.2.1, r2.2.2.2))) ;
  gq-comp T D G s s' d d' h1 h2 | r1 r2 ->
    (r2.1, (r1.2.1, (gs-comp T D G s d r1.2.2.1 r2.2.2.1, gs-comp T D G s' d' r1.2.2.2 r2.2.2.2))) ;
  gq-lift D G A A' s s' h0 h1 h2 h3 | r0 r1 r2 r3 -> c-gq-lift D G A A' s s' h0 h1 h2 h3 r1 r2 r3 ;
  gq-sec G A A' a a' hA ha ha' h1 h2 | rA ra ra' r1 r2 ->
    (rA, (g-ext G A hA, (gs-sec G A a hA ha, sec-cx G A A' a' rA hA r1.2.2 h1 ha'))) ;
  gq-idl D G s h | r -> (r.1, (r.2, (gs-comp D G G gid s (gs-id G r.2) h, h))) ;
  gq-idr D G s h | r -> (r.1, (r.2, (gs-comp D D G s gid h (gs-id D r.1), h))) ;
  gq-assoc Q T D G s d e h1 h2 h3 | r1 r2 r3 ->
    (r3.1, (r1.2, (gs-comp Q T G (gcomp s d) e (gs-comp T D G s d h1 h2) h3,
                   gs-comp Q D G s (gcomp d e) h1 (gs-comp Q T D d e h2 h3)))) ;
  gq-eps G s h | r -> (r.1, (g-nil, (h, gs-eps G r.1))) ;
  gq-lift-id G A h | r -> c-gq-lift-id G A h r ;
  gq-lift-comp T D G A s d h0 h1 h2 | r0 r1 r2 -> c-gq-lift-comp T D G A s d h0 h1 h2 r2.1 ;
  gq-p-lift D G A s h1 h2 | r1 r2 ->
    (g-ext D (gsb A s) (gt-sb D G A s h1 h2), (r1,
     (gs-comp (gext D (gsb A s)) (gext G A) G gp (glift A s) (gs-p G A h1) (gs-lift D G A s h2 h1),
      gs-comp (gext D (gsb A s)) D G s gp h2 (gs-p D (gsb A s) (gt-sb D G A s h1 h2))))) ;
  gq-p-sec G A a h1 h2 | r1 r2 ->
    (r1, (r1, (gs-comp G (gext G A) G gp (gsec A a) (gs-p G A h1) (gs-sec G A a h1 h2), gs-id G r1))) ;
  gq-sec-comp D G A a s h1 h2 h3 | r1 r2 r3 -> c-gq-sec-comp D G A a s h1 h2 h3 r3.1 ;
  gq-lift-p-sec-q G A h | r -> c-gq-lift-p-sec-q G A h } ;

g-universe-tm-bound (G a : GE) (n : Nat) (h : Tm' G a (guu n)) : LeN n N =
  g-universe-bound G n (gpresup (gjtm G a (guu n)) h).2 ;
