-- L18Var.seg: Lemma 18, the motive and the cases of contexts and variables.
--   good-lift   Good G0 G s  gives  Good (G0.A[s]) (G.A) (lift s)
--   L18J        the motive of the induction on T_Tarski derivations
--   c-v0, c-vs  the two variable rules

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ;

L18J : Jf -> U l = split {
  jwf G -> CtxS G ;
  jty G A -> CtxS G * (PT G A * (NT G A * (ET G A * ST G A))) ;
  jtm G a A -> CtxS G * (PM G a A * (NM G a A * (EM G a A * SMt G a A))) ;
  jeqty G A B -> CtxS G * QT G A B ;
  jeqtm G a b A -> CtxS G * QM G a b A } ;

evT (T : Tm) (e : Nat -> GE) (T' : Tm) (q : Id Tm T T') : Id GE (ev T e) (ev T' e) = ap Tm GE (\ X -> ev X e) T T' q ;

------------------------------------------------------------------------
-- weakening a term of a Good substitution

pm-wk (G0 : Cx) (B t T T' : Tm) (q : Id Tm (wk T) T') (pm : PM G0 t T) : PM (csnoc G0 B) (wk t) T' =
  \ D e wD o ->
    gtm-a D (ev t (\ i -> e (suc i))) (ev (wk t) e) (ev T' e) (symG (ev (wk t) e) (ev t (\ i -> e (suc i))) (ev-wk t e))
      (gtm-T D (ev t (\ i -> e (suc i))) (ev T (\ i -> e (suc i))) (ev T' e)
         (trans GE (ev T (\ i -> e (suc i))) (ev (wk T) e) (ev T' e)
            (symG (ev (wk T) e) (ev T (\ i -> e (suc i))) (ev-wk T e)) (evT (wk T) e T' q))
         (pm D (\ i -> e (suc i)) wD o.1)) ;

nm-wk (G0 : Cx) (B t T T' : Tm) (q : Id Tm (wk T) T') (nm : NM G0 t T) : NM (csnoc G0 B) (wk t) T' =
  \ D e Tc s wD wT o hs ->
    geqm-l Tc (gsb (ev t (\ i -> e (suc i))) s) (gsb (ev (wk t) e) s) (ev (wk t) (esb e s)) (ev T' (esb e s))
      (ap GE GE (\ X -> gsb X s) (ev t (\ i -> e (suc i))) (ev (wk t) e) (symG (ev (wk t) e) (ev t (\ i -> e (suc i))) (ev-wk t e)))
      (geqm-r Tc (gsb (ev t (\ i -> e (suc i))) s) (ev t (esb (\ i -> e (suc i)) s)) (ev (wk t) (esb e s)) (ev T' (esb e s))
         (symG (ev (wk t) (esb e s)) (ev t (esb (\ i -> e (suc i)) s)) (ev-wk t (esb e s)))
         (geqm-T Tc (gsb (ev t (\ i -> e (suc i))) s) (ev t (esb (\ i -> e (suc i)) s)) (ev T (esb (\ i -> e (suc i)) s))
            (ev T' (esb e s))
            (trans GE (ev T (esb (\ i -> e (suc i)) s)) (ev (wk T) (esb e s)) (ev T' (esb e s))
               (symG (ev (wk T) (esb e s)) (ev T (esb (\ i -> e (suc i)) s)) (ev-wk T (esb e s))) (evT (wk T) (esb e s) T' q))
            (nm D (\ i -> e (suc i)) Tc s wD wT o.1 hs))) ;

em-wk (G0 : Cx) (B t T T' : Tm) (q : Id Tm (wk T) T') (em : EM G0 t T) : EM (csnoc G0 B) (wk t) T' =
  \ D e1 e2 wD r ->
    geqm-l D (ev t (\ i -> e1 (suc i))) (ev (wk t) e1) (ev (wk t) e2) (ev T' e1)
      (symG (ev (wk t) e1) (ev t (\ i -> e1 (suc i))) (ev-wk t e1))
      (geqm-r D (ev t (\ i -> e1 (suc i))) (ev t (\ i -> e2 (suc i))) (ev (wk t) e2) (ev T' e1)
         (symG (ev (wk t) e2) (ev t (\ i -> e2 (suc i))) (ev-wk t e2))
         (geqm-T D (ev t (\ i -> e1 (suc i))) (ev t (\ i -> e2 (suc i))) (ev T (\ i -> e1 (suc i))) (ev T' e1)
            (trans GE (ev T (\ i -> e1 (suc i))) (ev (wk T) e1) (ev T' e1)
               (symG (ev (wk T) e1) (ev T (\ i -> e1 (suc i))) (ev-wk T e1)) (evT (wk T) e1 T' q))
            (em D (\ i -> e1 (suc i)) (\ i -> e2 (suc i)) wD (r.1.1, (r.2.1.1, r.2.2.1))))) ;

good-wk (G0 : Cx) (B : Tm) : (G : Cx) -> (s : Nat -> Tm) -> Good G0 G s -> Good (csnoc G0 B) G (\ i -> wk (s i)) = split {
  cnil -> \ s g -> tt ;
  csnoc G A | r -> \ s g ->
    (r (\ i -> s (suc i)) g.1,
     (pm-wk G0 B (s zero) (Sub.trav A (\ i -> s (suc i))) (Sub.trav A (\ i -> wk (s (suc i))))
        (sub-wk-trav A (\ i -> s (suc i))) g.2.1,
      (nm-wk G0 B (s zero) (Sub.trav A (\ i -> s (suc i))) (Sub.trav A (\ i -> wk (s (suc i))))
         (sub-wk-trav A (\ i -> s (suc i))) g.2.2.1,
       em-wk G0 B (s zero) (Sub.trav A (\ i -> s (suc i))) (Sub.trav A (\ i -> wk (s (suc i))))
         (sub-wk-trav A (\ i -> s (suc i))) g.2.2.2))) } ;

-- the variable 0 of G0.X, at the type T' = wk X
pm-v0 (G0 : Cx) (X T' : Tm) (q : Id Tm (wk X) T') : PM (csnoc G0 X) (var zero) T' =
  \ D e wD o ->
    gtm-T D (e zero) (ev X (\ i -> e (suc i))) (ev T' e)
      (trans GE (ev X (\ i -> e (suc i))) (ev (wk X) e) (ev T' e)
         (symG (ev (wk X) e) (ev X (\ i -> e (suc i))) (ev-wk X e)) (evT (wk X) e T' q)) o.2 ;

nm-v0 (G0 : Cx) (X T' : Tm) (q : Id Tm (wk X) T') (pX : PT G0 X) (nX : NT G0 X) : NM (csnoc G0 X) (var zero) T' =
  \ D e Tc s wD wT o hs ->
    gm-refl Tc (gsb (e zero) s) (ev T' (esb e s))
      (gm-conv Tc (gsb (e zero) s) (gsb (ev X (\ i -> e (suc i))) s) (ev T' (esb e s))
         (gm-sb Tc D (e zero) (ev X (\ i -> e (suc i))) s (pX D (\ i -> e (suc i)) wD o.1) o.2 hs)
         (geqt-r Tc (gsb (ev X (\ i -> e (suc i))) s) (ev X (esb (\ i -> e (suc i)) s)) (ev T' (esb e s))
            (trans GE (ev X (esb (\ i -> e (suc i)) s)) (ev (wk X) (esb e s)) (ev T' (esb e s))
               (symG (ev (wk X) (esb e s)) (ev X (esb (\ i -> e (suc i)) s)) (ev-wk X (esb e s))) (evT (wk X) (esb e s) T' q))
            (nX D (\ i -> e (suc i)) Tc s wD wT o.1 hs))) ;

em-v0 (G0 : Cx) (X T' : Tm) (q : Id Tm (wk X) T') : EM (csnoc G0 X) (var zero) T' =
  \ D e1 e2 wD r ->
    geqm-T D (e1 zero) (e2 zero) (ev X (\ i -> e1 (suc i))) (ev T' e1)
      (trans GE (ev X (\ i -> e1 (suc i))) (ev (wk X) e1) (ev T' e1)
         (symG (ev (wk X) e1) (ev X (\ i -> e1 (suc i))) (ev-wk X e1)) (evT (wk X) e1 T' q)) r.2.2.2 ;

good-lift (G0 G : Cx) (A : Tm) (s : Nat -> Tm) (g : Good G0 G s) (pX : PT G0 (Sub.trav A s)) (nX : NT G0 (Sub.trav A s)) :
    Good (csnoc G0 (Sub.trav A s)) (csnoc G A) (Sub.lift s) =
  (good-wk G0 (Sub.trav A s) G s g,
   (pm-v0 G0 (Sub.trav A s) (Sub.trav A (\ i -> wk (s i))) (sub-wk-trav A s),
    (nm-v0 G0 (Sub.trav A s) (Sub.trav A (\ i -> wk (s i))) (sub-wk-trav A s) pX nX,
     em-v0 G0 (Sub.trav A s) (Sub.trav A (\ i -> wk (s i))) (sub-wk-trav A s)))) ;

------------------------------------------------------------------------
-- the variable rules

c-v0 (G : Cx) (A : Tm) (r : L18J (jty G A)) : L18J (jtm (csnoc G A) (var zero) (wk A)) =
  (r,
   (pm-v0 G A (wk A) (refl (wk A)),
    (nm-v0 G A (wk A) (refl (wk A)) r.2.1 r.2.2.1,
     (em-v0 G A (wk A) (refl (wk A)),
      \ G0 s c0 g D e wD o ->
        (gm-conv D (ev (s zero) e) (ev (Sub.trav A (\ i -> s (suc i))) e) (ev (wk A) (evs s e)) (g.2.1 D e wD o)
           (geqt-r D (ev (Sub.trav A (\ i -> s (suc i))) e) (ev A (evs (\ i -> s (suc i)) e)) (ev (wk A) (evs s e))
              (symG (ev (wk A) (evs s e)) (ev A (evs (\ i -> s (suc i)) e)) (ev-wk A (evs s e)))
              (r.2.2.2.2 G0 (\ i -> s (suc i)) c0 g.1 D e wD o).2),
         gm-refl D (ev (s zero) e) (ev (wk A) (evs s e))
           (gm-conv D (ev (s zero) e) (ev (Sub.trav A (\ i -> s (suc i))) e) (ev (wk A) (evs s e)) (g.2.1 D e wD o)
              (geqt-r D (ev (Sub.trav A (\ i -> s (suc i))) e) (ev A (evs (\ i -> s (suc i)) e)) (ev (wk A) (evs s e))
                 (symG (ev (wk A) (evs s e)) (ev A (evs (\ i -> s (suc i)) e)) (ev-wk A (evs s e)))
                 (r.2.2.2.2 G0 (\ i -> s (suc i)) c0 g.1 D e wD o).2))))))) ;

c-vs (G : Cx) (B : Tm) (n : Nat) (A : Tm) (r1 : L18J (jtm G (var n) A)) (r2 : L18J (jty G B)) :
    L18J (jtm (csnoc G B) (var (suc n)) (wk A)) =
  (r2,
   (\ D e wD o ->
      gtm-T D (e (suc n)) (ev A (\ i -> e (suc i))) (ev (wk A) e) (symG (ev (wk A) e) (ev A (\ i -> e (suc i))) (ev-wk A e))
        (r1.2.1 D (\ i -> e (suc i)) wD o.1),
    (\ D e Tc s wD wT o hs ->
       geqm-T Tc (gsb (e (suc n)) s) (gsb (e (suc n)) s) (ev A (esb (\ i -> e (suc i)) s)) (ev (wk A) (esb e s))
         (symG (ev (wk A) (esb e s)) (ev A (esb (\ i -> e (suc i)) s)) (ev-wk A (esb e s)))
         (r1.2.2.1 D (\ i -> e (suc i)) Tc s wD wT o.1 hs),
     (\ D e1 e2 wD r ->
        geqm-T D (e1 (suc n)) (e2 (suc n)) (ev A (\ i -> e1 (suc i))) (ev (wk A) e1)
          (symG (ev (wk A) e1) (ev A (\ i -> e1 (suc i))) (ev-wk A e1))
          (r1.2.2.2.1 D (\ i -> e1 (suc i)) (\ i -> e2 (suc i)) wD (r.1.1, (r.2.1.1, r.2.2.1))),
      \ G0 s c0 g D e wD o ->
        (gtm-T D (ev (s (suc n)) e) (ev A (evs (\ i -> s (suc i)) e)) (ev (wk A) (evs s e))
           (symG (ev (wk A) (evs s e)) (ev A (evs (\ i -> s (suc i)) e)) (ev-wk A (evs s e)))
           (r1.2.2.2.2 G0 (\ i -> s (suc i)) c0 g.1 D e wD o).1,
         geqm-T D (ev (s (suc n)) e) (ev (s (suc n)) e) (ev A (evs (\ i -> s (suc i)) e)) (ev (wk A) (evs s e))
           (symG (ev (wk A) (evs s e)) (ev A (evs (\ i -> s (suc i)) e)) (ev-wk A (evs s e)))
           (r1.2.2.2.2 G0 (\ i -> s (suc i)) c0 g.1 D e wD o).2))))) ;
