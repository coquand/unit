-- InitUniqTot.seg (PLAN-INIT, Part U): canonical classes of derivable
-- judgements, in the total spaces of the term model (Part F sorts).
--   TotTy  = (c : Ctx) * Ty c                      tT G A h w
--   TotTm  = (c : Ctx) * (T : Ty c) * El c T       tE G A a h hA w
--   TotSub = (d : Ctx) * (c : Ctx) * Sub d c       tS D s G h wD wG
-- The canonical class sits over cls G w with refl paths.  -gen: the class
-- over ANY context class c (and type T) with paths is the same point of
-- the total space; -from: an element equal (in its fibre) to a class is
-- that point.  Conversion lemmas (-cx, -conv, -eq): judgementally equal
-- data give the same point.  GDer lemma app-sec-eq: application in terms
-- of app-q (the raw form of Pi-iso.fun) and gsec, by eta and beta.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lib[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsPi[l] ;

TotTy : U l = (c : Ctx) * Ty c ;
TotTm : U l = (c : Ctx) * ((T : Ty c) * El c T) ;
TotSub : U l = (d : Ctx) * ((c : Ctx) * Sub d c) ;

------------------------------------------------------------------------
-- canonical classes and representatives

cTy (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) : Ty (cls G w) =
  clsTy (cls G w) G A h w (refl (cls G w)) ;
cEl (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) : El (cls G w) (cTy G A hA w) =
  clsEl (cls G w) (cTy G A hA w) G A a h hA w (refl (cls G w)) (refl (cTy G A hA w)) ;
cSub (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) : Sub (cls D wD) (cls G wG) =
  clsSub (cls D wD) (cls G wG) D s G h wD wG (refl (cls D wD)) (refl (cls G wG)) ;

tT (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) : TotTy = (cls G w, cTy G A h w) ;
tE (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) : TotTm =
  (cls G w, (cTy G A hA w, cEl G A a h hA w)) ;
tS (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) : TotSub =
  (cls D wD, (cls G wG, cSub D s G h wD wG)) ;

-- representatives of classes given by raw data (accessors reduce)
rT (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) :
  RepTy c (clsTy c G A h w pc) =
  mkRepTy c (clsTy c G A h w pc) G A h w pc (refl (clsTy c G A h w pc)) ;
rE (c : Ctx) (T : Ty c) (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T) :
  RepEl c T (clsEl c T G A a h hA w pc pT) =
  mkRepEl c T (clsEl c T G A a h hA w pc pT) G A a h hA w pc pT (refl (clsEl c T G A a h hA w pc pT)) ;
rS (d c : Ctx) (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c) :
  RepSub d c (clsSub d c D s G h wD wG pd pc) =
  mkRepSub d c (clsSub d c D s G h wD wG pd pc) D s G h wD wG pd pc (refl (clsSub d c D s G h wD wG pd pc)) ;

------------------------------------------------------------------------
-- the class over any context (and type) with paths

tT-gen (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (c : Ctx) (pc : Id Ctx (cls G w) c) :
  Id TotTy (tT G A h w) (c, clsTy c G A h w pc) =
  idJ Ctx (cls G w) (\ z q -> Id TotTy (tT G A h w) (z, clsTy z G A h w q)) (refl (tT G A h w)) c pc ;

tE-gen (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (c : Ctx) (pc : Id Ctx (cls G w) c) (T : Ty c) (pT : Id (Ty c) (clsTy c G A hA w pc) T) :
  Id TotTm (tE G A a h hA w) (c, (T, clsEl c T G A a h hA w pc pT)) =
  idJ Ctx (cls G w)
    (\ z q -> (T1 : Ty z) (p1 : Id (Ty z) (clsTy z G A hA w q) T1) ->
       Id TotTm (tE G A a h hA w) (z, (T1, clsEl z T1 G A a h hA w q p1)))
    (\ T1 p1 -> idJ (Ty (cls G w)) (cTy G A hA w)
       (\ T2 p2 -> Id TotTm (tE G A a h hA w) (cls G w, (T2, clsEl (cls G w) T2 G A a h hA w (refl (cls G w)) p2)))
       (refl (tE G A a h hA w)) T1 p1)
    c pc T pT ;

tS-gen (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (d c : Ctx) (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c) :
  Id TotSub (tS D s G h wD wG) (d, (c, clsSub d c D s G h wD wG pd pc)) =
  idJ Ctx (cls D wD)
    (\ z q -> (c1 : Ctx) (q1 : Id Ctx (cls G wG) c1) ->
       Id TotSub (tS D s G h wD wG) (z, (c1, clsSub z c1 D s G h wD wG q q1)))
    (\ c1 q1 -> idJ Ctx (cls G wG)
       (\ z2 q2 -> Id TotSub (tS D s G h wD wG) (cls D wD, (z2, clsSub (cls D wD) z2 D s G h wD wG (refl (cls D wD)) q2)))
       (refl (tS D s G h wD wG)) c1 q1)
    d pd c pc ;

------------------------------------------------------------------------
-- an element of a fibre equal to a class is the canonical point

tT-from (c : Ctx) (T : Ty c) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (b : Id (Ty c) T (clsTy c G A h w pc)) : Id TotTy (c, T) (tT G A h w) =
  transH (ap (Ty c) TotTy (\ u -> (c, u)) T (clsTy c G A h w pc) b) (symH (tT-gen G A h w c pc)) ;

tE-from (c : Ctx) (T : Ty c) (t : El c T) (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A))
  (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T)
  (b : Id (El c T) t (clsEl c T G A a h hA w pc pT)) : Id TotTm (c, (T, t)) (tE G A a h hA w) =
  transH (ap (El c T) TotTm (\ u -> (c, (T, u))) t (clsEl c T G A a h hA w pc pT) b)
    (symH (tE-gen G A a h hA w c pc T pT)) ;

tS-from (d c : Ctx) (s0 : Sub d c) (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c)
  (b : Id (Sub d c) s0 (clsSub d c D s G h wD wG pd pc)) : Id TotSub (d, (c, s0)) (tS D s G h wD wG) =
  transH (ap (Sub d c) TotSub (\ u -> (d, (c, u))) s0 (clsSub d c D s G h wD wG pd pc) b)
    (symH (tS-gen D s G h wD wG d c pd pc)) ;

------------------------------------------------------------------------
-- conversion: judgementally equal data give the same point

tT-cx (G D A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (h' : Pf (gjty D A)) (w' : Pf (gjwf D))
  (e : Pf (gjeqcx G D)) : Id TotTy (tT G A h w) (tT D A h' w') =
  transH (tT-gen G A h w (cls D w') (cls-eq G D w w' e))
    (ap (Ty (cls D w')) TotTy (\ u -> (cls D w', u))
       (clsTy (cls D w') G A h w (cls-eq G D w w' e)) (cTy D A h' w')
       (clsTy-move (cls D w') G A h w (cls-eq G D w w' e) D h' w' (refl (cls D w')))) ;

tE-cx (G D a A : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (h' : Pf (gjtm D a A)) (hA' : Pf (gjty D A)) (w' : Pf (gjwf D))
  (e : Pf (gjeqcx G D)) : Id TotTm (tE G A a h hA w) (tE D A a h' hA' w') =
  transH (tE-gen G A a h hA w (cls D w') (cls-eq G D w w' e) (cTy D A hA' w')
            (clsTy-move (cls D w') G A hA w (cls-eq G D w w' e) D hA' w' (refl (cls D w'))))
    (ap (El (cls D w') (cTy D A hA' w')) TotTm (\ u -> (cls D w', (cTy D A hA' w', u)))
       (clsEl (cls D w') (cTy D A hA' w') G A a h hA w (cls-eq G D w w' e)
          (clsTy-move (cls D w') G A hA w (cls-eq G D w w' e) D hA' w' (refl (cls D w'))))
       (cEl D A a h' hA' w')
       (clsEl-irr (cls D w') (cTy D A hA' w') G A a h hA w (cls-eq G D w w' e)
          (clsTy-move (cls D w') G A hA w (cls-eq G D w w' e) D hA' w' (refl (cls D w')))
          D A h' hA' w' (refl (cls D w')) (refl (cTy D A hA' w')))) ;

tE-conv (G A B a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (h' : Pf (gjtm G a B)) (hB : Pf (gjty G B))
  (w : Pf (gjwf G)) (e : Pf (gjeqty G A B)) : Id TotTm (tE G A a h hA w) (tE G B a h' hB w) =
  transH (tE-gen G A a h hA w (cls G w) (refl (cls G w)) (cTy G B hB w)
            (clsTy-eq (cls G w) G A hA w (refl (cls G w)) G B hB w (refl (cls G w)) e))
    (ap (El (cls G w) (cTy G B hB w)) TotTm (\ u -> (cls G w, (cTy G B hB w, u)))
       (clsEl (cls G w) (cTy G B hB w) G A a h hA w (refl (cls G w))
          (clsTy-eq (cls G w) G A hA w (refl (cls G w)) G B hB w (refl (cls G w)) e))
       (cEl G B a h' hB w)
       (clsEl-irr (cls G w) (cTy G B hB w) G A a h hA w (refl (cls G w))
          (clsTy-eq (cls G w) G A hA w (refl (cls G w)) G B hB w (refl (cls G w)) e)
          G B h' hB w (refl (cls G w)) (refl (cTy G B hB w)))) ;

tE-eq (G A a a' : GE) (h : Pf (gjtm G a A)) (h' : Pf (gjtm G a' A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (e : Pf (gjeqtm G a a' A)) : Id TotTm (tE G A a h hA w) (tE G A a' h' hA w) =
  ap (El (cls G w) (cTy G A hA w)) TotTm (\ u -> (cls G w, (cTy G A hA w, u)))
    (cEl G A a h hA w) (cEl G A a' h' hA w)
    (clsEl-eq (cls G w) (cTy G A hA w) G A a h hA w (refl (cls G w)) (refl (cTy G A hA w))
       G A a' h' hA w (refl (cls G w)) (refl (cTy G A hA w)) e) ;

tS-cx (D D' G G' s : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (h' : Pf (gjsub D' s G')) (wD' : Pf (gjwf D')) (wG' : Pf (gjwf G'))
  (eD : Pf (gjeqcx D D')) (eG : Pf (gjeqcx G G')) : Id TotSub (tS D s G h wD wG) (tS D' s G' h' wD' wG') =
  transH (tS-gen D s G h wD wG (cls D' wD') (cls G' wG') (cls-eq D D' wD wD' eD) (cls-eq G G' wG wG' eG))
    (ap (Sub (cls D' wD') (cls G' wG')) TotSub (\ u -> (cls D' wD', (cls G' wG', u)))
       (clsSub (cls D' wD') (cls G' wG') D s G h wD wG (cls-eq D D' wD wD' eD) (cls-eq G G' wG wG' eG))
       (cSub D' s G' h' wD' wG')
       (clsSub-irr (cls D' wD') (cls G' wG') D s G h wD wG (cls-eq D D' wD wD' eD) (cls-eq G G' wG wG' eG)
          D' G' h' wD' wG' (refl (cls D' wD')) (refl (cls G' wG')))) ;

------------------------------------------------------------------------
-- GDer: application through app-q (Pi-iso.fun) and gsec, by eta and beta

app-sec-eq (G A B f a : GE) (hA : GDer (gjty G A)) (hB : GDer (gjty (gext G A) B))
  (hf : GDer (gjtm G f (gpi A B))) (ha : GDer (gjtm G a A)) :
  GDer (gjeqtm G (gsb (app-q A B f) (gsec A a)) (gapp A B f a) (gsb B (gsec A a))) =
  gm-sym G (gapp A B f a) (gsb (app-q A B f) (gsec A a)) (gsb B (gsec A a))
    (gt-sb G (gext G A) B (gsec A a) hB (gs-sec G A a hA ha))
    (gm-trans G (gapp A B f a) (gapp A B (glam A B (app-q A B f)) a) (gsb (app-q A B f) (gsec A a))
       (gsb B (gsec A a))
       (gm-eapp G A A B B f (glam A B (app-q A B f)) a a hA hB ha (ge-refl G A hA) (ge-refl (gext G A) B hB)
          (gm-eta G A B f hA hB hf) (gm-refl G a A ha))
       (gm-beta G A B (app-q A B f) a hA hB (app-q-der G A B f hA hB hf) ha)) ;

-- the lower level of a strict pair of levels (copied from TEInterpUniverses)
lower-bound (m n : Nat) (lt : LeN (suc m) n) (nb : LeN n N) : LeN m N =
  leN-trans m n N (B.TTyping[l].lt-le m n lt) nb ;
