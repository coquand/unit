-- Interpret Cartmell rule instances in the fully annotated Ehrhard system.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open CGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FCtx[l] ; open FSubTransport[l] ; open CFullSub[l] ; open CFullTerm[l] ;

c-to-full : (J : FAJ) -> CDer J -> FADer J = split {
  c-fnil -> f-nil ;
  c-fext G A pG pA | _ rpA -> f-ext G A rpA ;
  c-fid G pG | rpG -> fs-id G rpG ;
  c-fcomp T D G s d pT pD pG ps pd | _ _ _ rps rpd -> fs-comp T D G s d rps rpd ;
  c-feps G pG | rpG -> fs-eps G rpG ;
  c-fp G A pG pA | _ rpA -> fs-p G A rpA ;
  c-flift D G A s pD pG pA ps | _ _ rpA rps -> fs-lift D G A s rps rpA ;
  c-fsec G A a pG pA pa | _ rpA rpa -> fs-sec G A a rpA rpa ;
  c-ftsb D G A s pD pG pA ps | _ _ rpA rps -> ft-sb D G A s rpA rps ;
  c-fmsb D G A a s pD pG pA pa ps | _ _ rpA rpa rps -> fm-sb D G a A s rpA rpa rps ;
  c-fq G A pG pA | _ rpA -> fm-q G A rpA ;
  c-fpi G A B pG pA pB | _ rpA rpB -> ft-pi G A B rpA rpB ;
  c-flam G A B b pG pA pB pb | _ rpA rpB rpb -> fm-lam G A B b rpA rpB rpb ;
  c-fapp G A B c a pG pA pB pc pa | _ rpA rpB rpc rpa -> fm-app G A B c a rpA rpB rpc rpa ;
  c-fuu n G pG bound1 | rpG -> ft-uu G n rpG bound1 ;
  c-fel n G a pG pa bound1 | _ rpa -> ft-el G n a rpa ;
  c-fpic n G a b pG pa pb bound1 | _ rpa rpb -> fm-pic G n a b rpa rpb ;
  c-fuc m n G pG bound1 bound2 | rpG -> fm-uc G m n rpG bound1 bound2 ;
  c-flf m n G a pG pa bound1 bound2 | _ rpa -> fm-lf G m n a rpa bound1 bound2 ;
  c-fq-idl D G s pD pG ps left right | _ _ rps _ _ -> fq-idl D G s rps ;
  c-fq-idr D G s pD pG ps left right | _ _ rps _ _ -> fq-idr D G s rps ;
  c-fq-assoc Q T D G s d e pQ pT pD pG ps pd pe left right | _ _ _ _ rps rpd rpe _ _ -> fq-assoc Q T D G s d e rps
    rpd rpe ;
  c-fq-eps G s pG ps left right | _ rps _ _ -> fq-eps G s rps ;
  c-fe-sb-id G A pG pA left right | _ rpA _ _ -> fe-sb-id G A rpA ;
  c-fe-sb-comp T D G A s d pT pD pG pA ps pd left right | _ _ _ rpA rps rpd _ _ -> fe-sb-comp T D G A s d rpA rps
    rpd ;
  c-fm-sb-id G A a pG pA pa left right | _ _ rpa _ _ -> fm-sb-id G a A rpa ;
  c-fm-sb-comp T D G A a s d pT pD pG pA pa ps pd left right | _ _ _ _ rpa rps rpd _ _ -> fm-sb-comp T D G a A s d
    rpa rps rpd ;
  c-fq-lift-id G A pG pA left right | _ rpA _ _ -> fq-lift-id G A rpA ;
  c-fq-lift-comp T D G A s d pT pD pG pA ps pd left right | _ _ _ rpA rps rpd _ _ -> fq-lift-comp T D G A s d rpA
    rps rpd ;
  c-fq-p-lift D G A s pD pG pA ps left right | _ _ rpA rps _ _ -> fq-p-lift D G A s rpA rps ;
  c-fq-p-sec G A a pG pA pa left right | _ rpA rpa _ _ -> fq-p-sec G A a rpA rpa ;
  c-fq-sec-comp D G A a s pD pG pA pa ps left right | _ _ rpA rpa rps _ _ -> fq-sec-comp D G A a s rpA rpa rps ;
  c-fq-lift-p-sec-q G A pG pA left right | _ rpA _ _ -> fq-lift-p-sec-q G A rpA ;
  c-fm-q-lift D G A s pD pG pA ps left right | _ _ rpA rps _ _ -> fm-q-lift D G A s rpA rps ;
  c-fm-q-sec G A a pG pA pa left right | _ rpA rpa _ _ -> fm-q-sec G A a rpA rpa ;
  c-fe-pi-sb D G A B s pD pG pA pB ps left right | _ _ rpA rpB rps _ _ -> fe-pi-sb D G A B s rpA rpB rps ;
  c-fm-lam-sb D G A B b s pD pG pA pB pb ps left right | _ _ rpA rpB rpb rps _ _ -> fm-lam-sb D G A B b s rpA rpB
    rpb rps ;
  c-fm-app-sb D G A B c a s pD pG pA pB pc pa ps left right | _ _ rpA rpB rpc rpa rps _ _ -> fm-app-sb D G A B c a
    s rpA rpB rpc rpa rps ;
  c-fm-beta G A B b a pG pA pB pb pa left right | _ rpA rpB rpb rpa _ _ -> fm-beta G A B b a rpA rpB rpb rpa ;
  c-fm-eta G A B f pG pA pB pf left right | _ rpA rpB rpf _ _ -> fm-eta G A B f rpA rpB rpf ;
  c-fe-uu-sb n D G s pD pG ps bound1 left right | _ _ rps _ _ -> fe-uu-sb D G n s rps bound1 ;
  c-fe-el-sb n D G a s pD pG pa ps bound1 left right | _ _ rpa rps _ _ -> fe-el-sb D G n a s rpa rps ;
  c-fm-pic-sb n D G a b s pD pG pa pb ps bound1 left right | _ _ rpa rpb rps _ _ -> fm-pic-sb D G n a b s rpa rpb
    rps ;
  c-fm-uc-sb m n D G s pD pG ps bound1 bound2 left right | _ _ rps _ _ -> fm-uc-sb D G m n s rps bound1 bound2 ;
  c-fm-lf-sb m n D G a s pD pG pa ps bound1 bound2 left right | _ _ rpa rps _ _ -> fm-lf-sb D G m n a s rpa rps
    bound1 bound2 ;
  c-fe-el-pic n G a b pG pa pb bound1 left right | _ rpa rpb _ _ -> fe-el-pic G n a b rpa rpb ;
  c-fe-el-uc m n G pG bound1 bound2 left right | rpG _ _ -> fe-el-uc G m n rpG bound1 bound2 ;
  c-fe-el-lf m n G a pG pa bound1 bound2 left right | _ rpa _ _ -> fe-el-lf G m n a rpa bound1 bound2 ;
  c-fm-lf-pic n p G a b pG pa pb bound1 bound2 left right | _ rpa rpb _ _ -> fm-lf-pic G n p a b rpa rpb bound1
    bound2 ;
  c-fm-lf-uc m n p G pG bound1 bound2 bound3 left right | rpG _ _ -> fm-lf-uc G m n p rpG bound1 bound2 bound3 ;
  c-fm-lf-lf m n p G a pG pa bound1 bound2 bound3 left right | _ rpa _ _ -> fm-lf-lf G m n p a rpa bound1 bound2
    bound3 ;
  c-refl-ctx x h | rh -> fc-refl x rh ;
  c-sym-ctx x y h | rh -> f-cx-sym x y rh ;
  c-trans-ctx x y z h k | rh rk -> f-cx-trans x y z rh rk ;
  c-refl-sub D G x h | rh -> fq-refl D x G rh ;
  c-sym-sub D G x y h | rh -> fq-sym D x y G rh ;
  c-trans-sub D G x y z h k | rh rk -> fq-trans D x y z G rh rk ;
  c-refl-ty G x h | rh -> fe-refl G x rh ;
  c-sym-ty G x y h | rh -> fe-sym G x y rh ;
  c-trans-ty G x y z h k | rh rk -> fe-trans G x y z rh rk ;
  c-refl-tm G A x h | rh -> fm-refl G x A rh ;
  c-sym-tm G A x y h | rh -> fm-sym G x y A (fpresup (fjeqtm G x y A) rh).2.1 rh ;
  c-trans-tm G A x y z h k | rh rk -> fm-trans G x y z A rh rk ;
  c-eq-fext G A G' A' pG pA | rpG rpA -> fc-ext G G' A A' rpG rpA ;
  c-eq-fid G G' pG | rpG -> fq-id-cx G G' rpG ;
  c-eq-fcomp T D G s d T' D' G' s' d' pT pD pG ps pd | rpT rpD rpG rps rpd -> c-full-comp T D G s d T' D' G' s' d'
    rpT rpD rpG rps rpd ;
  c-eq-feps G G' pG | rpG -> fq-eps-cx G G' rpG ;
  c-eq-fp G A G' A' pG pA | rpG rpA -> fq-p-cx G G' A A' rpG rpA ;
  c-eq-flift D G A s D' G' A' s' pD pG pA ps | rpD rpG rpA rps -> c-full-lift D G A s D' G' A' s' rpD rpG rpA rps ;
  c-eq-fsec G A a G' A' a' pG pA pa | rpG rpA rpa -> c-full-sec G A a G' A' a' rpG rpA rpa ;
  c-eq-ftsb D G A s D' G' A' s' pD pG pA ps | rpD rpG rpA rps -> c-full-tsb D G A s D' G' A' s' rpD rpG rpA rps ;
  c-eq-fmsb D G A a s D' G' A' a' s' pD pG pA pa ps | rpD rpG rpA rpa rps -> c-full-msb D G A a s D' G' A' a' s'
    rpD rpG rpA rpa rps ;
  c-eq-fq G A G' A' pG pA | rpG rpA -> fm-q-cx G G' A A' rpG rpA ;
  c-eq-fpi G A B G' A' B' pG pA pB | rpG rpA rpB -> c-full-pi G A B G' A' B' rpG rpA rpB ;
  c-eq-flam G A B b G' A' B' b' pG pA pB pb | rpG rpA rpB rpb -> c-full-lam G A B b G' A' B' b' rpG rpA rpB rpb ;
  c-eq-fapp G A B c a G' A' B' c' a' pG pA pB pc pa | rpG rpA rpB rpc rpa -> c-full-app G A B c a G' A' B' c' a'
    rpG rpA rpB rpc rpa ;
  c-eq-fuu n G G' pG bound1 | rpG -> fe-uu-cx G G' n rpG bound1 ;
  c-eq-fel n G a G' a' pG pa bound1 | rpG rpa -> c-full-el n G a G' a' rpG rpa ;
  c-eq-fpic n G a b G' a' b' pG pa pb bound1 | rpG rpa rpb -> c-full-pic n G a b G' a' b' rpG rpa rpb bound1 ;
  c-eq-fuc m n G G' pG bound1 bound2 | rpG -> fm-uc-cx G G' m n rpG bound1 bound2 ;
  c-eq-flf m n G a G' a' pG pa bound1 bound2 | rpG rpa -> c-full-lf m n G a G' a' rpG rpa bound1 bound2 ;
  c-conv-ty G H x eG h | reG rh -> move-ty G H x reG rh ;
  c-eqconv-ty G H x y eG h | reG rh -> move-te G H x y reG rh ;
  c-conv-sub D G E H x eD eG h | reD reG rh -> move-sub D E G H x reD reG rh ;
  c-eqconv-sub D G E H x y eD eG h | reD reG rh -> move-se D E G H x y reD reG rh ;
  c-conv-tm G A H B x eG eA h | reG reA rh -> move-tm G H x B reG (fm-conv G x A B rh reA) ;
  c-eqconv-tm G A H B x y eG eA h | reG reA rh -> move-me G H x y B reG (fm-eqconv G x y A B rh reA) } ;
