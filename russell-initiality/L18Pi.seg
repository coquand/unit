-- L18Pi.seg: Lemma 18, the cases of Pi and lambda.
--   h2-sub, h3-sub    a binder body under lift_X(s)
--   st-bind, sm-bind  a binder body under lift s (substitution)
--   c-pi, c-lam

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18Bind[l] ;

h2-sub (G : Cx) (A B : Tm) (cI : CI G A) (nB : NT (csnoc G A) B) (eB : ET (csnoc G A) B) (D T s : GE) (e : Nat -> GE)
    (wD : GDer (gjwf D)) (wT : GDer (gjwf T)) (hs : GDer (gjsub T s D)) (o : EnvOk D G e) :
    GDer (gjeqty (gext T (gsb (ev A e) s)) (gsb (ev B (up e)) (glift (ev A e) s)) (ev B (up (esb e s)))) =
  ge-trans (gext T (gsb (ev A e) s)) (gsb (ev B (up e)) (glift (ev A e) s)) (ev B (esb (up e) (glift (ev A e) s)))
    (ev B (up (esb e s)))
    (nB (gext D (ev A e)) (up e) (gext T (gsb (ev A e) s)) (glift (ev A e) s) (g-ext D (ev A e) (cI.2.1 D e wD o))
       (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (env-up D e wD G A cI o)
       (gs-lift T D (ev A e) s hs (cI.2.1 D e wD o)))
    (eB (gext T (gsb (ev A e) s)) (esb (up e) (glift (ev A e) s)) (up (esb e s))
       (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (rel-up-sub G A cI D T s e wD wT hs o)) ;

h3-sub (G : Cx) (A b B : Tm) (cI : CI G A) (nB : NT (csnoc G A) B) (nb : NM (csnoc G A) b B) (eb : EM (csnoc G A) b B)
    (D T s : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (wT : GDer (gjwf T)) (hs : GDer (gjsub T s D)) (o : EnvOk D G e) :
    GDer (gjeqtm (gext T (gsb (ev A e) s)) (gsb (ev b (up e)) (glift (ev A e) s)) (ev b (up (esb e s))) (gsb (ev B (up e)) (glift (ev A e) s))) =
  gm-eqconv (gext T (gsb (ev A e) s)) (gsb (ev b (up e)) (glift (ev A e) s)) (ev b (up (esb e s))) (ev B (esb (up e) (glift (ev A e) s))) (gsb (ev B (up e)) (glift (ev A e) s))
    (gm-trans (gext T (gsb (ev A e) s)) (gsb (ev b (up e)) (glift (ev A e) s)) (ev b (esb (up e) (glift (ev A e) s))) (ev b (up (esb e s))) (ev B (esb (up e) (glift (ev A e) s)))
       (nb (gext D (ev A e)) (up e) (gext T (gsb (ev A e) s)) (glift (ev A e) s) (g-ext D (ev A e) (cI.2.1 D e wD o)) (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (env-up D e wD G A cI o) (gs-lift T D (ev A e) s hs (cI.2.1 D e wD o)))
       (eb (gext T (gsb (ev A e) s)) (esb (up e) (glift (ev A e) s)) (up (esb e s)) (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (rel-up-sub G A cI D T s e wD wT hs o)))
    (ge-sym (gext T (gsb (ev A e) s)) (gsb (ev B (up e)) (glift (ev A e) s)) (ev B (esb (up e) (glift (ev A e) s))) (nB (gext D (ev A e)) (up e) (gext T (gsb (ev A e) s)) (glift (ev A e) s) (g-ext D (ev A e) (cI.2.1 D e wD o)) (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (env-up D e wD G A cI o) (gs-lift T D (ev A e) s hs (cI.2.1 D e wD o)))) ;

ci-up (G0 G : Cx) (A : Tm) (c0 : CtxI G0) (cG : CtxS G) (s : Nat -> Tm) (g : Good G0 G s)
    (pA : PT G A) (nA : NT G A) (eA : ET G A) (sA : ST G A) : CtxI (csnoc G0 (Sub.trav A s)) =
  (c0, ci-sub G0 G A c0 cG s g pA nA eA sA) ;

st-bind (G0 G : Cx) (A B : Tm) (c0 : CtxI G0) (cG : CtxS G) (cI : CI G A) (cGA : CtxS (csnoc G A))
    (s : Nat -> Tm) (g : Good G0 G s) (pA : PT G A) (nA : NT G A) (eA : ET G A) (sA : ST G A)
    (sB : ST (csnoc G A) B) (eB : ET (csnoc G A) B) (D : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (o : EnvOk D G0 e) :
    GDer (gjty (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e))) *
    GDer (gjeqty (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (up (evs s e)))) =
  ((sB (csnoc G0 (Sub.trav A s)) (Sub.lift s) (ci-up G0 G A c0 cG s g pA nA eA sA) (good-lift G0 G A s g (ci-up G0 G A c0 cG s g pA nA eA sA).2.1 (ci-up G0 G A c0 cG s g pA nA eA sA).2.2.1)
       (gext D (ev (Sub.trav A s) e)) (up e) (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
       (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)).1,
   ge-trans (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (evs (Sub.lift s) (up e)))
     (ev B (up (evs s e)))
     (sB (csnoc G0 (Sub.trav A s)) (Sub.lift s) (ci-up G0 G A c0 cG s g pA nA eA sA) (good-lift G0 G A s g (ci-up G0 G A c0 cG s g pA nA eA sA).2.1 (ci-up G0 G A c0 cG s g pA nA eA sA).2.2.1)
        (gext D (ev (Sub.trav A s) e)) (up e) (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
        (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)).2
     (eB (gext D (ev (Sub.trav A s) e)) (evs (Sub.lift s) (up e)) (up (evs s e))
        (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
        (rel-up-evs G0 G A c0 cG cI cGA s g (ci-up G0 G A c0 cG s g pA nA eA sA) D (ev (Sub.trav A s) e) e wD
           (sA G0 s c0 g D e wD o).1 o (sA G0 s c0 g D e wD o).2
           (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)))) ;

sm-bind (G0 G : Cx) (A B b : Tm) (c0 : CtxI G0) (cG : CtxS G) (cI : CI G A) (cGA : CtxS (csnoc G A))
    (s : Nat -> Tm) (g : Good G0 G s) (pA : PT G A) (nA : NT G A) (eA : ET G A) (sA : ST G A)
    (sB : ST (csnoc G A) B) (eB : ET (csnoc G A) B) (sb : SMt (csnoc G A) b B) (eb : EM (csnoc G A) b B)
    (D : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (o : EnvOk D G0 e) :
    GDer (gjtm (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav b (Sub.lift s)) (up e)) (ev (Sub.trav B (Sub.lift s)) (up e))) *
    GDer (gjeqtm (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav b (Sub.lift s)) (up e)) (ev b (up (evs s e)))
                 (ev (Sub.trav B (Sub.lift s)) (up e))) =
  (gm-conv (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav b (Sub.lift s)) (up e)) (ev B (evs (Sub.lift s) (up e)))
     (ev (Sub.trav B (Sub.lift s)) (up e))
     (sb (csnoc G0 (Sub.trav A s)) (Sub.lift s) (ci-up G0 G A c0 cG s g pA nA eA sA) (good-lift G0 G A s g (ci-up G0 G A c0 cG s g pA nA eA sA).2.1 (ci-up G0 G A c0 cG s g pA nA eA sA).2.2.1)
        (gext D (ev (Sub.trav A s) e)) (up e) (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
        (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)).1
     (ge-sym (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (evs (Sub.lift s) (up e)))
        (sB (csnoc G0 (Sub.trav A s)) (Sub.lift s) (ci-up G0 G A c0 cG s g pA nA eA sA) (good-lift G0 G A s g (ci-up G0 G A c0 cG s g pA nA eA sA).2.1 (ci-up G0 G A c0 cG s g pA nA eA sA).2.2.1)
           (gext D (ev (Sub.trav A s) e)) (up e) (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
           (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)).2),
   gm-eqconv (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav b (Sub.lift s)) (up e)) (ev b (up (evs s e)))
     (ev B (evs (Sub.lift s) (up e))) (ev (Sub.trav B (Sub.lift s)) (up e))
     (gm-trans (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav b (Sub.lift s)) (up e)) (ev b (evs (Sub.lift s) (up e)))
        (ev b (up (evs s e))) (ev B (evs (Sub.lift s) (up e)))
        (sb (csnoc G0 (Sub.trav A s)) (Sub.lift s) (ci-up G0 G A c0 cG s g pA nA eA sA) (good-lift G0 G A s g (ci-up G0 G A c0 cG s g pA nA eA sA).2.1 (ci-up G0 G A c0 cG s g pA nA eA sA).2.2.1)
           (gext D (ev (Sub.trav A s) e)) (up e) (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
           (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)).2
        (eb (gext D (ev (Sub.trav A s) e)) (evs (Sub.lift s) (up e)) (up (evs s e))
           (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
           (rel-up-evs G0 G A c0 cG cI cGA s g (ci-up G0 G A c0 cG s g pA nA eA sA) D (ev (Sub.trav A s) e) e wD
              (sA G0 s c0 g D e wD o).1 o (sA G0 s c0 g D e wD o).2
              (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o))))
     (ge-sym (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (evs (Sub.lift s) (up e)))
        (sB (csnoc G0 (Sub.trav A s)) (Sub.lift s) (ci-up G0 G A c0 cG s g pA nA eA sA) (good-lift G0 G A s g (ci-up G0 G A c0 cG s g pA nA eA sA).2.1 (ci-up G0 G A c0 cG s g pA nA eA sA).2.2.1)
           (gext D (ev (Sub.trav A s) e)) (up e) (g-ext D (ev (Sub.trav A s) e) (sA G0 s c0 g D e wD o).1)
           (env-up D e wD G0 (Sub.trav A s) (ci-up G0 G A c0 cG s g pA nA eA sA) o)).2)) ;

------------------------------------------------------------------------
-- Pi

-- the four properties of Pi(A, B), from those of A and B
pi-props (G : Cx) (A B : Tm) (cG : CtxS G) (pA : PT G A) (nA : NT G A) (eA : ET G A) (sA : ST G A)
    (cGA : CtxS (csnoc G A)) (pB : PT (csnoc G A) B) (nB : NT (csnoc G A) B) (eB : ET (csnoc G A) B) (sB : ST (csnoc G A) B) :
    PT G (pi A B) * (NT G (pi A B) * (ET G (pi A B) * ST G (pi A B))) =
  (\ D e wD o ->
     gt-pi D (ev A e) (ev B (up e)) (pA D e wD o)
       (pB (gext D (ev A e)) (up e) (g-ext D (ev A e) (pA D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) cGA) o)),
   (\ D e T s wD wT o hs ->
      ge-trans T (gsb (gpi (ev A e) (ev B (up e))) s) (gpi (gsb (ev A e) s) (gsb (ev B (up e)) (glift (ev A e) s)))
        (gpi (ev A (esb e s)) (ev B (up (esb e s))))
        (ge-pi-sb T D (ev A e) (ev B (up e)) s (pA D e wD o)
           (pB (gext D (ev A e)) (up e) (g-ext D (ev A e) (pA D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) cGA) o)) hs)
        (ge-pi T (gsb (ev A e) s) (ev A (esb e s)) (gsb (ev B (up e)) (glift (ev A e) s)) (ev B (up (esb e s)))
           (gt-sb T D (ev A e) s (pA D e wD o) hs) (nA D e T s wD wT o hs)
           (h2-sub G A B (cs-ci (csnoc G A) cGA) nB eB D T s e wD wT hs o)),
    (\ D e1 e2 wD r ->
       ge-pi D (ev A e1) (ev A e2) (ev B (up e1)) (ev B (up e2)) (pA D e1 wD r.1) (eA D e1 e2 wD r)
         (eB (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (pA D e1 wD r.1)) (rel-up D wD G A (cs-ci (csnoc G A) cGA) e1 e2 r)),
     \ G0 s c0 g D e wD o ->
       (gt-pi D (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e)) (sA G0 s c0 g D e wD o).1
          (st-bind G0 G A B c0 cG (cs-ci (csnoc G A) cGA) cGA s g pA nA eA sA sB eB D e wD o).1,
        ge-pi D (ev (Sub.trav A s) e) (ev A (evs s e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (up (evs s e)))
          (sA G0 s c0 g D e wD o).1 (sA G0 s c0 g D e wD o).2
          (st-bind G0 G A B c0 cG (cs-ci (csnoc G A) cGA) cGA s g pA nA eA sA sB eB D e wD o).2)))) ;

c-pi (G : Cx) (A B : Tm) (rA : L18J (jty G A)) (rB : L18J (jty (csnoc G A) B)) : L18J (jty G (pi A B)) =
  (rA.1, pi-props G A B rA.1 rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.1 rB.2.1 rB.2.2.1 rB.2.2.2.1 rB.2.2.2.2) ;

------------------------------------------------------------------------
-- lambda

c-lam (G : Cx) (A B b : Tm) (rA : L18J (jty G A)) (rB : L18J (jty (csnoc G A) B)) (rb : L18J (jtm (csnoc G A) b B)) :
    L18J (jtm G (lam A B b) (pi A B)) =
  (rA.1,
   (\ D e wD o ->
      gm-lam D (ev A e) (ev B (up e)) (ev b (up e)) (rA.2.1 D e wD o)
        (rB.2.1 (gext D (ev A e)) (up e) (g-ext D (ev A e) (rA.2.1 D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) rB.1) o))
        (rb.2.1 (gext D (ev A e)) (up e) (g-ext D (ev A e) (rA.2.1 D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) rB.1) o)),
    (\ D e T s wD wT o hs ->
       gm-eqconv T (gsb (glam (ev A e) (ev B (up e)) (ev b (up e))) s) (glam (ev A (esb e s)) (ev B (up (esb e s))) (ev b (up (esb e s))))
         (gpi (gsb (ev A e) s) (gsb (ev B (up e)) (glift (ev A e) s))) (gpi (ev A (esb e s)) (ev B (up (esb e s))))
         (gm-trans T (gsb (glam (ev A e) (ev B (up e)) (ev b (up e))) s)
            (glam (gsb (ev A e) s) (gsb (ev B (up e)) (glift (ev A e) s)) (gsb (ev b (up e)) (glift (ev A e) s)))
            (glam (ev A (esb e s)) (ev B (up (esb e s))) (ev b (up (esb e s))))
            (gpi (gsb (ev A e) s) (gsb (ev B (up e)) (glift (ev A e) s)))
            (gm-lam-sb T D (ev A e) (ev B (up e)) (ev b (up e)) s (rA.2.1 D e wD o)
               (rB.2.1 (gext D (ev A e)) (up e) (g-ext D (ev A e) (rA.2.1 D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) rB.1) o))
               (rb.2.1 (gext D (ev A e)) (up e) (g-ext D (ev A e) (rA.2.1 D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) rB.1) o))
               hs)
            (gm-elam T (gsb (ev A e) s) (ev A (esb e s)) (gsb (ev B (up e)) (glift (ev A e) s)) (ev B (up (esb e s)))
               (gsb (ev b (up e)) (glift (ev A e) s)) (ev b (up (esb e s)))
               (gt-sb T D (ev A e) s (rA.2.1 D e wD o) hs) (rA.2.2.1 D e T s wD wT o hs)
               (h2-sub G A B (cs-ci (csnoc G A) rB.1) rB.2.2.1 rB.2.2.2.1 D T s e wD wT hs o)
               (h3-sub G A b B (cs-ci (csnoc G A) rB.1) rB.2.2.1 rb.2.2.1 rb.2.2.2.1 D T s e wD wT hs o)))
         (ge-pi T (gsb (ev A e) s) (ev A (esb e s)) (gsb (ev B (up e)) (glift (ev A e) s)) (ev B (up (esb e s)))
            (gt-sb T D (ev A e) s (rA.2.1 D e wD o) hs) (rA.2.2.1 D e T s wD wT o hs)
            (h2-sub G A B (cs-ci (csnoc G A) rB.1) rB.2.2.1 rB.2.2.2.1 D T s e wD wT hs o)),
     (\ D e1 e2 wD r ->
        gm-elam D (ev A e1) (ev A e2) (ev B (up e1)) (ev B (up e2)) (ev b (up e1)) (ev b (up e2)) (rA.2.1 D e1 wD r.1)
          (rA.2.2.2.1 D e1 e2 wD r)
          (rB.2.2.2.1 (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (rA.2.1 D e1 wD r.1))
             (rel-up D wD G A (cs-ci (csnoc G A) rB.1) e1 e2 r))
          (rb.2.2.2.1 (gext D (ev A e1)) (up e1) (up e2) (g-ext D (ev A e1) (rA.2.1 D e1 wD r.1))
             (rel-up D wD G A (cs-ci (csnoc G A) rB.1) e1 e2 r)),
      \ G0 s c0 g D e wD o ->
        (gm-conv D (ev (Sub.trav (lam A B b) s) e)
           (gpi (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e))) (ev (pi A B) (evs s e))
           (gm-lam D (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev (Sub.trav b (Sub.lift s)) (up e))
              (rA.2.2.2.2 G0 s c0 g D e wD o).1
              (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2
                 rB.2.2.2.2 rB.2.2.2.1 D e wD o).1
              (sm-bind G0 G A B b c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2
                 rB.2.2.2.2 rB.2.2.2.1 rb.2.2.2.2 rb.2.2.2.1 D e wD o).1)
           ((pi-props G A B rA.1 rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.1 rB.2.1 rB.2.2.1 rB.2.2.2.1 rB.2.2.2.2).2.2.2
              G0 s c0 g D e wD o).2,
         gm-eqconv D (ev (Sub.trav (lam A B b) s) e) (ev (lam A B b) (evs s e))
           (gpi (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e))) (ev (pi A B) (evs s e))
           (gm-elam D (ev (Sub.trav A s) e) (ev A (evs s e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (up (evs s e)))
              (ev (Sub.trav b (Sub.lift s)) (up e)) (ev b (up (evs s e)))
              (rA.2.2.2.2 G0 s c0 g D e wD o).1 (rA.2.2.2.2 G0 s c0 g D e wD o).2
              (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2
                 rB.2.2.2.2 rB.2.2.2.1 D e wD o).2
              (sm-bind G0 G A B b c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2
