-- InitOpsExt.seg (PLAN-INIT, Part F): the comprehension operations of the
-- term model, Ehrhard style: p (raw gp), q (raw gq), lift (raw glift A s),
-- sec (raw gsec A a), with beta lemmas.  p-beta and q-beta need no
-- representative (the raw result does not depend on the arguments).
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;

------------------------------------------------------------------------
-- projection  p c A : ext c A -> c

module OpP (c : Ctx) (A : Ty c) {
  W : U l = RepTy c A ;
  der (r : W) : Pf (gjsub (gext (rtG c A r) (rtA c A r)) gp (rtG c A r)) =
    pf-map (gjty (rtG c A r) (rtA c A r)) (gjsub (gext (rtG c A r) (rtA c A r)) gp (rtG c A r))
      (\ k -> gs-p (rtG c A r) (rtA c A r) k) (rtH c A r) ;
  f (r : W) : Sub (ext c A) c =
    clsSub (ext c A) c (gext (rtG c A r) (rtA c A r)) gp (rtG c A r) (der r) (ext-der c A r) (rtW c A r)
      (ext-beta' c A r (ext-der c A r)) (rtP c A r) ;
  const (r r' : W) : Id (Sub (ext c A) c) (f r) (f r') =
    clsSub-eq (ext c A) c (gext (rtG c A r) (rtA c A r)) gp (rtG c A r) (der r) (ext-der c A r) (rtW c A r)
      (ext-beta' c A r (ext-der c A r)) (rtP c A r)
      (gext (rtG c A r') (rtA c A r')) gp (rtG c A r') (der r') (ext-der c A r') (rtW c A r')
      (ext-beta' c A r' (ext-der c A r')) (rtP c A r')
      (pf-map (gjty (rtG c A r) (rtA c A r)) (gjeqsub (gext (rtG c A r) (rtA c A r)) gp gp (rtG c A r))
        (\ k -> gq-refl (gext (rtG c A r) (rtA c A r)) gp (rtG c A r) (gs-p (rtG c A r) (rtA c A r) k)) (rtH c A r)) ;
  module Ch = Choice[W, Sub (ext c A) c, isSetSub (ext c A) c, f, const] ;
  value : Sub (ext c A) c = Ch.elim (rep-ty c A) ;
  beta (r : W) : Id (Sub (ext c A) c) value (f r) = Ch.beta (rep-ty c A) r ;
} ;

p (c : Ctx) (A : Ty c) : Sub (ext c A) c = OpP[c,A].value ;
p-beta (c : Ctx) (A : Ty c) (E1 G1 : GE) (h : Pf (gjsub E1 gp G1)) (wE : Pf (gjwf E1)) (wG : Pf (gjwf G1))
  (pe : Id Ctx (cls E1 wE) (ext c A)) (pc : Id Ctx (cls G1 wG) c) :
  Id (Sub (ext c A) c) (p c A) (clsSub (ext c A) c E1 gp G1 h wE wG pe pc) =
  sq-rec (RepTy c A) (Id (Sub (ext c A) c) (p c A) (clsSub (ext c A) c E1 gp G1 h wE wG pe pc))
    (isSetSub (ext c A) c (p c A) (clsSub (ext c A) c E1 gp G1 h wE wG pe pc))
    (\ r -> trans (Sub (ext c A) c) (p c A) (OpP[c,A].f r) (clsSub (ext c A) c E1 gp G1 h wE wG pe pc)
      (OpP[c,A].beta r)
      (clsSub-irr (ext c A) c (gext (rtG c A r) (rtA c A r)) gp (rtG c A r) (OpP[c,A].der r) (ext-der c A r)
        (rtW c A r) (ext-beta' c A r (ext-der c A r)) (rtP c A r) E1 G1 h wE wG pe pc))
    (rep-ty c A) ;
-- the representative of p c A given by a representative of A
p-rep (c : Ctx) (A : Ty c) (r : RepTy c A) : RepSub (ext c A) c (p c A) =
  mkRepSub (ext c A) c (p c A) (gext (rtG c A r) (rtA c A r)) gp (rtG c A r) (OpP[c,A].der r) (ext-der c A r)
    (rtW c A r) (ext-beta' c A r (ext-der c A r)) (rtP c A r)
    (sym (Sub (ext c A) c) (p c A) (OpP[c,A].f r)
      (p-beta c A (gext (rtG c A r) (rtA c A r)) (rtG c A r) (OpP[c,A].der r) (ext-der c A r)
        (rtW c A r) (ext-beta' c A r (ext-der c A r)) (rtP c A r))) ;

------------------------------------------------------------------------
-- variable  q c A : El (ext c A) (subT (ext c A) c A (p c A))

module OpQ (c : Ctx) (A : Ty c) {
  W : U l = RepTy c A ;
  E : Ctx = ext c A ;
  T : Ty E = subT E c A (p c A) ;
  G (r : W) : GE = rtG c A r ;
  A0 (r : W) : GE = rtA c A r ;
  derT (r : W) : Pf (gjty (gext (G r) (A0 r)) (gsb (A0 r) gp)) =
    pf-map (gjty (G r) (A0 r)) (gjty (gext (G r) (A0 r)) (gsb (A0 r) gp))
      (\ k -> gt-sb (gext (G r) (A0 r)) (G r) (A0 r) gp k (gs-p (G r) (A0 r) k)) (rtH c A r) ;
  der (r : W) : Pf (gjtm (gext (G r) (A0 r)) gq (gsb (A0 r) gp)) =
    pf-map (gjty (G r) (A0 r)) (gjtm (gext (G r) (A0 r)) gq (gsb (A0 r) gp))
      (\ k -> gm-q (G r) (A0 r) k) (rtH c A r) ;
  pT (r : W) : Id (Ty E) (clsTy E (gext (G r) (A0 r)) (gsb (A0 r) gp) (derT r) (ext-der c A r)
      (ext-beta' c A r (ext-der c A r))) T =
    subT-beta' E c A (p c A) r (p-rep c A r) (gext (G r) (A0 r)) (derT r) (ext-der c A r)
      (ext-beta' c A r (ext-der c A r)) ;
  f (r : W) : El E T =
    clsEl E T (gext (G r) (A0 r)) (gsb (A0 r) gp) gq (der r) (derT r) (ext-der c A r)
      (ext-beta' c A r (ext-der c A r)) (pT r) ;
  const (r r' : W) : Id (El E T) (f r) (f r') =
    clsEl-eq E T (gext (G r) (A0 r)) (gsb (A0 r) gp) gq (der r) (derT r) (ext-der c A r)
      (ext-beta' c A r (ext-der c A r)) (pT r)
      (gext (G r') (A0 r')) (gsb (A0 r') gp) gq (der r') (derT r') (ext-der c A r')
      (ext-beta' c A r' (ext-der c A r')) (pT r')
      (pf-map (gjtm (gext (G r) (A0 r)) gq (gsb (A0 r) gp)) (gjeqtm (gext (G r) (A0 r)) gq gq (gsb (A0 r) gp))
        (\ k -> gm-refl (gext (G r) (A0 r)) gq (gsb (A0 r) gp) k) (der r)) ;
  module Ch = Choice[W, El E T, isSetEl E T, f, const] ;
  value : El E T = Ch.elim (rep-ty c A) ;
  beta (r : W) : Id (El E T) value (f r) = Ch.beta (rep-ty c A) r ;
} ;

q (c : Ctx) (A : Ty c) : El (ext c A) (subT (ext c A) c A (p c A)) = OpQ[c,A].value ;
q-beta (c : Ctx) (A : Ty c) (E1 A1 : GE) (h : Pf (gjtm E1 gq A1)) (hA : Pf (gjty E1 A1)) (w : Pf (gjwf E1))
  (pe : Id Ctx (cls E1 w) (ext c A))
  (pT : Id (Ty (ext c A)) (clsTy (ext c A) E1 A1 hA w pe) (subT (ext c A) c A (p c A))) :
  Id (El (ext c A) (subT (ext c A) c A (p c A))) (q c A)
    (clsEl (ext c A) (subT (ext c A) c A (p c A)) E1 A1 gq h hA w pe pT) =
  sq-rec (RepTy c A)
    (Id (El (ext c A) (subT (ext c A) c A (p c A))) (q c A)
      (clsEl (ext c A) (subT (ext c A) c A (p c A)) E1 A1 gq h hA w pe pT))
    (isSetEl (ext c A) (subT (ext c A) c A (p c A)) (q c A)
      (clsEl (ext c A) (subT (ext c A) c A (p c A)) E1 A1 gq h hA w pe pT))
    (\ r -> trans (El (ext c A) (subT (ext c A) c A (p c A))) (q c A) (OpQ[c,A].f r)
      (clsEl (ext c A) (subT (ext c A) c A (p c A)) E1 A1 gq h hA w pe pT)
      (OpQ[c,A].beta r)
      (clsEl-irr (ext c A) (subT (ext c A) c A (p c A)) (gext (rtG c A r) (rtA c A r)) (gsb (rtA c A r) gp) gq
        (OpQ[c,A].der r) (OpQ[c,A].derT r) (ext-der c A r) (ext-beta' c A r (ext-der c A r)) (OpQ[c,A].pT r)
        E1 A1 h hA w pe pT))
    (rep-ty c A) ;

------------------------------------------------------------------------
-- lift  lift d c A s : ext d (subT d c A s) -> ext c A,
-- A over G, s : D -> G'; raw  glift A s : D.(A s) -> G'.A

module OpLift (d c : Ctx) (A : Ty c) (s : Sub d c) {
  W : U l = RepTy c A * RepSub d c s ;
  G (x : W) : GE = rtG c A x.1 ;
  A0 (x : W) : GE = rtA c A x.1 ;
  D (x : W) : GE = rsD d c s x.2 ;
  G' (x : W) : GE = rsG d c s x.2 ;
  s0 (x : W) : GE = rss d c s x.2 ;
  cx (x : W) : Pf (gjeqcx (G x) (G' x)) =
    same-cx c (G x) (G' x) (rtW c A x.1) (rsWG d c s x.2) (rtP c A x.1) (rsPG d c s x.2) ;
  hA' (x : W) : Pf (gjty (G' x) (A0 x)) =
    ty-move c (G x) (A0 x) (rtH c A x.1) (rtW c A x.1) (rtP c A x.1) (G' x) (rsWG d c s x.2) (rsPG d c s x.2) ;
  -- A, represented over the codomain of s
  rA' (x : W) : RepTy c A =
    mkRepTy c A (G' x) (A0 x) (hA' x) (rsWG d c s x.2) (rsPG d c s x.2)
      (trans (Ty c) (clsTy c (G' x) (A0 x) (hA' x) (rsWG d c s x.2) (rsPG d c s x.2))
        (clsTy c (G x) (A0 x) (rtH c A x.1) (rtW c A x.1) (rtP c A x.1)) A
        (sym (Ty c) (clsTy c (G x) (A0 x) (rtH c A x.1) (rtW c A x.1) (rtP c A x.1))
          (clsTy c (G' x) (A0 x) (hA' x) (rsWG d c s x.2) (rsPG d c s x.2))
          (clsTy-move c (G x) (A0 x) (rtH c A x.1) (rtW c A x.1) (rtP c A x.1) (G' x) (hA' x)
            (rsWG d c s x.2) (rsPG d c s x.2)))
        (rtE c A x.1)) ;
  rS (x : W) : RepTy d (subT d c A s) = subT-rep d c A s x.1 x.2 ;
  der (x : W) : Pf (gjsub (gext (D x) (gsb (A0 x) (s0 x))) (glift (A0 x) (s0 x)) (gext (G' x) (A0 x))) =
    pf-map2 (gjsub (D x) (s0 x) (G' x)) (gjty (G' x) (A0 x))
      (gjsub (gext (D x) (gsb (A0 x) (s0 x))) (glift (A0 x) (s0 x)) (gext (G' x) (A0 x)))
      (\ hs ha -> gs-lift (D x) (G' x) (A0 x) (s0 x) hs ha) (rsH d c s x.2) (hA' x) ;
  f (x : W) : Sub (ext d (subT d c A s)) (ext c A) =
    clsSub (ext d (subT d c A s)) (ext c A) (gext (D x) (gsb (A0 x) (s0 x))) (glift (A0 x) (s0 x)) (gext (G' x) (A0 x))
      (der x) (ext-der d (subT d c A s) (rS x)) (ext-der c A (rA' x))
      (ext-beta' d (subT d c A s) (rS x) (ext-der d (subT d c A s) (rS x)))
      (ext-beta' c A (rA' x) (ext-der c A (rA' x))) ;
  rel (x y : W) : Pf (gjeqsub (gext (D x) (gsb (A0 x) (s0 x))) (glift (A0 x) (s0 x)) (glift (A0 y) (s0 y)) (gext (G' x) (A0 x))) =
    pf-map5 (gjty (G' x) (A0 x)) (gjeqcx (G x) (G' x)) (gjwf (G' x)) (gjeqty (G x) (A0 x) (A0 y))
      (gjeqsub (D x) (s0 x) (s0 y) (G' x))
      (gjeqsub (gext (D x) (gsb (A0 x) (s0 x))) (glift (A0 x) (s0 x)) (glift (A0 y) (s0 y)) (gext (G' x) (A0 x)))
      (\ ha k w eA es -> gq-lift (D x) (G' x) (A0 x) (A0 y) (s0 x) (s0 y) ha (ge-cx (G x) (G' x) (A0 x) (A0 y) w k eA)
        (GP.gpresup (gjeqsub (D x) (s0 x) (s0 y) (G' x)) es).2.2.1 es)
      (hA' x) (cx x) (rsWG d c s x.2) (same-rt c A x.1 y.1) (same-rs d c s x.2 y.2) ;
  const (x y : W) : Id (Sub (ext d (subT d c A s)) (ext c A)) (f x) (f y) =
    clsSub-eq (ext d (subT d c A s)) (ext c A) (gext (D x) (gsb (A0 x) (s0 x))) (glift (A0 x) (s0 x)) (gext (G' x) (A0 x))
      (der x) (ext-der d (subT d c A s) (rS x)) (ext-der c A (rA' x))
      (ext-beta' d (subT d c A s) (rS x) (ext-der d (subT d c A s) (rS x)))
      (ext-beta' c A (rA' x) (ext-der c A (rA' x)))
      (gext (D y) (gsb (A0 y) (s0 y))) (glift (A0 y) (s0 y)) (gext (G' y) (A0 y))
      (der y) (ext-der d (subT d c A s) (rS y)) (ext-der c A (rA' y))
      (ext-beta' d (subT d c A s) (rS y) (ext-der d (subT d c A s) (rS y)))
      (ext-beta' c A (rA' y) (ext-der c A (rA' y)))
      (rel x y) ;
  module Ch = Choice[W, Sub (ext d (subT d c A s)) (ext c A), isSetSub (ext d (subT d c A s)) (ext c A), f, const] ;
  reps : Sq W = sq-pair (RepTy c A) (RepSub d c s) (rep-ty c A) (rep-sub d c s) ;
  value : Sub (ext d (subT d c A s)) (ext c A) = Ch.elim reps ;
  beta (x : W) : Id (Sub (ext d (subT d c A s)) (ext c A)) value (f x) = Ch.beta reps x ;
} ;

lift (d c : Ctx) (A : Ty c) (s : Sub d c) : Sub (ext d (subT d c A s)) (ext c A) = OpLift[d,c,A,s].value ;
lift-beta (d c : Ctx) (A : Ty c) (s : Sub d c) (r : RepTy c A) (r' : RepSub d c s)
  (E1 F1 : GE) (h : Pf (gjsub E1 (glift (rtA c A r) (rss d c s r')) F1)) (wE : Pf (gjwf E1)) (wF : Pf (gjwf F1))
  (pe : Id Ctx (cls E1 wE) (ext d (subT d c A s))) (pf' : Id Ctx (cls F1 wF) (ext c A)) :
  Id (Sub (ext d (subT d c A s)) (ext c A)) (lift d c A s)
    (clsSub (ext d (subT d c A s)) (ext c A) E1 (glift (rtA c A r) (rss d c s r')) F1 h wE wF pe pf') =
  trans (Sub (ext d (subT d c A s)) (ext c A)) (lift d c A s) (OpLift[d,c,A,s].f (r, r'))
    (clsSub (ext d (subT d c A s)) (ext c A) E1 (glift (rtA c A r) (rss d c s r')) F1 h wE wF pe pf')
    (OpLift[d,c,A,s].beta (r, r'))
    (clsSub-irr (ext d (subT d c A s)) (ext c A)
      (gext (rsD d c s r') (gsb (rtA c A r) (rss d c s r'))) (glift (rtA c A r) (rss d c s r'))
      (gext (rsG d c s r') (rtA c A r)) (OpLift[d,c,A,s].der (r, r'))
      (ext-der d (subT d c A s) (OpLift[d,c,A,s].rS (r, r'))) (ext-der c A (OpLift[d,c,A,s].rA' (r, r')))
      (ext-beta' d (subT d c A s) (OpLift[d,c,A,s].rS (r, r')) (ext-der d (subT d c A s) (OpLift[d,c,A,s].rS (r, r'))))
      (ext-beta' c A (OpLift[d,c,A,s].rA' (r, r')) (ext-der c A (OpLift[d,c,A,s].rA' (r, r'))))
      E1 F1 h wE wF pe pf') ;

------------------------------------------------------------------------
-- section  sec c A a : c -> ext c A,  a : A0 over G;  raw  gsec A a

module OpSec (c : Ctx) (A : Ty c) (a : El c A) {
  W : U l = RepEl c A a ;
  G (r : W) : GE = reG c A a r ;
  A0 (r : W) : GE = reA c A a r ;
  a0 (r : W) : GE = rea c A a r ;
  rA (r : W) : RepTy c A = re-ty c A a r ;
  der (r : W) : Pf (gjsub (G r) (gsec (A0 r) (a0 r)) (gext (G r) (A0 r))) =
    pf-map2 (gjty (G r) (A0 r)) (gjtm (G r) (a0 r) (A0 r)) (gjsub (G r) (gsec (A0 r) (a0 r)) (gext (G r) (A0 r)))
      (\ hA ha -> gs-sec (G r) (A0 r) (a0 r) hA ha) (reHA c A a r) (reH c A a r) ;
  f (r : W) : Sub c (ext c A) =
    clsSub c (ext c A) (G r) (gsec (A0 r) (a0 r)) (gext (G r) (A0 r)) (der r) (reW c A a r) (ext-der c A (rA r))
      (reP c A a r) (ext-beta' c A (rA r) (ext-der c A (rA r))) ;
  rel (r r' : W) : Pf (gjeqsub (G r) (gsec (A0 r) (a0 r)) (gsec (A0 r') (a0 r')) (gext (G r) (A0 r))) =
    pf-map4 (gjty (G r) (A0 r)) (gjtm (G r) (a0 r) (A0 r)) (gjeqty (G r) (A0 r) (A0 r'))
      (gjeqtm (G r) (a0 r) (a0 r') (A0 r))
      (gjeqsub (G r) (gsec (A0 r) (a0 r)) (gsec (A0 r') (a0 r')) (gext (G r) (A0 r)))
      (\ hA ha eA ea -> gq-sec (G r) (A0 r) (A0 r') (a0 r) (a0 r') hA ha
        (GP.gpresup (gjeqtm (G r) (a0 r) (a0 r') (A0 r)) ea).2.2.2 eA ea)
      (reHA c A a r) (reH c A a r) (same-rt c A (rA r) (rA r')) (same-re c A a r r') ;
  const (r r' : W) : Id (Sub c (ext c A)) (f r) (f r') =
    clsSub-eq c (ext c A) (G r) (gsec (A0 r) (a0 r)) (gext (G r) (A0 r)) (der r) (reW c A a r) (ext-der c A (rA r))
      (reP c A a r) (ext-beta' c A (rA r) (ext-der c A (rA r)))
      (G r') (gsec (A0 r') (a0 r')) (gext (G r') (A0 r')) (der r') (reW c A a r') (ext-der c A (rA r'))
      (reP c A a r') (ext-beta' c A (rA r') (ext-der c A (rA r')))
      (rel r r') ;
  module Ch = Choice[W, Sub c (ext c A), isSetSub c (ext c A), f, const] ;
  value : Sub c (ext c A) = Ch.elim (rep-el c A a) ;
  beta (r : W) : Id (Sub c (ext c A)) value (f r) = Ch.beta (rep-el c A a) r ;
} ;

sec (c : Ctx) (A : Ty c) (a : El c A) : Sub c (ext c A) = OpSec[c,A,a].value ;
sec-beta (c : Ctx) (A : Ty c) (a : El c A) (r : RepEl c A a)
  (G1 E1 : GE) (h : Pf (gjsub G1 (gsec (reA c A a r) (rea c A a r)) E1)) (wG : Pf (gjwf G1)) (wE : Pf (gjwf E1))
  (pc : Id Ctx (cls G1 wG) c) (pe : Id Ctx (cls E1 wE) (ext c A)) :
  Id (Sub c (ext c A)) (sec c A a) (clsSub c (ext c A) G1 (gsec (reA c A a r) (rea c A a r)) E1 h wG wE pc pe) =
  trans (Sub c (ext c A)) (sec c A a) (OpSec[c,A,a].f r)
    (clsSub c (ext c A) G1 (gsec (reA c A a r) (rea c A a r)) E1 h wG wE pc pe)
    (OpSec[c,A,a].beta r)
    (clsSub-irr c (ext c A) (reG c A a r) (gsec (reA c A a r) (rea c A a r)) (gext (reG c A a r) (reA c A a r))
      (OpSec[c,A,a].der r) (reW c A a r) (ext-der c A (re-ty c A a r)) (reP c A a r)
      (ext-beta' c A (re-ty c A a r) (ext-der c A (re-ty c A a r)))
      G1 E1 h wG wE pc pe) ;
