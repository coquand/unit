-- Product naturality and the exact eta rule of T_E.
open Base ; open Prelude[l] ; open Paths[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpFormers ;
open TEInterpJudgement ; open TEInterpProducts ; open TEInterpPiLaws ; open B.GAT[l] ;

module ReindexedProduct (A B' s : GE) (d g : Tel) (v : ProductValue[g,A,B']) (f : SubValue d g s) {
  module S = PiSubstitution[d,g,v.dom,v.cod,f.1] ;

  dom-down : TyDown (gsb A s) d S.as = ty-sub-down A s d g v.dom f.1 v.dom-down f.2 ;
  cod-down : TyDown (gsb B' (glift A s)) S.y S.bs =
    ty-sub-down B' (glift A s) S.y S.x v.cod S.L v.cod-down (lift-down A s d g v.dom f.1 v.dom-down f.2) ;

  pi-down-sub : TyDown (gpi (gsb A s) (gsb B' (glift A s))) d S.Q =
    pi-down (gsb A s) (gsb B' (glift A s)) d S.as S.bs dom-down cod-down ;

  pi-down-reindex : TyDown (gsb (gpi A B') s) d S.Ps =
    ty-sub-down (gpi A B') s d g v.pi f.1 v.pi-down-at f.2 ;

  fn-down (c : GE) (u : C.El (ctx g) S.P) (h : TmDown c g S.P u) : TmDown (gsb c s) d S.Q (S.subst-fun u) =
    tm-cast-down (gsb c s) d S.Ps S.Q S.pn (C.subt (ctx d) (ctx g) S.P u f.1)
      (tm-sub-down c s d g S.P u f.1 h f.2) ;

  eq-type : TypeEquality d (gsb (gpi A B') s) (gpi (gsb A s) (gsb B' (glift A s))) =
    same-type d (gsb (gpi A B') s) (gpi (gsb A s) (gsb B' (glift A s))) S.Ps S.Q pi-down-reindex pi-down-sub S.pn ;

  eq-lam (b : GE) (u : TermAt S.x v.cod b) :
      TermEquality d (gpi (gsb A s) (gsb B' (glift A s))) (gsb (glam A B' b) s)
        (glam (gsb A s) (gsb B' (glift A s)) (gsb b (glift A s))) =
    same-term d (gpi (gsb A s) (gsb B' (glift A s))) (gsb (glam A B' b) s)
      (glam (gsb A s) (gsb B' (glift A s)) (gsb b (glift A s))) (reindex-term d g f.1 (v.pi,b0))
      (S.Q,lam-at d S.as S.bs b1) pi-down-sub
      (tm-sub-down (glam A B' b) s d g v.pi b0 f.1 hb0 f.2)
      (lam-down (gsb A s) (gsb B' (glift A s)) (gsb b (glift A s)) d S.as S.bs b1
        dom-down cod-down (tm-sub-down b (glift A s) S.y S.x v.cod u.1 S.L u.2
          (lift-down A s d g v.dom f.1 v.dom-down f.2)))
      (S.abstract-nat u.1)
   where {
    b0 : C.El (ctx g) v.pi = lam-at g v.dom v.cod u.1 ;
    hb0 : TmDown (glam A B' b) g v.pi b0 = lam-down A B' b g v.dom v.cod u.1 v.dom-down v.cod-down u.2 ;
    b1 : C.El (ctx S.y) S.bs = C.subt (ctx S.y) (ctx S.x) v.cod u.1 S.L ;
   } ;

  eq-app (fun arg : GE) (fn : TermAt g v.pi fun) (a0 : TermAt g v.dom arg) :
      TermEquality d (gsb (gsb B' (glift A s)) (gsec (gsb A s) (gsb arg s))) (gsb (gapp A B' fun arg) s)
        (gapp (gsb A s) (gsb B' (glift A s)) (gsb fun s) (gsb arg s)) =
    same-term d (gsb (gsb B' (glift A s)) (gsec (gsb A s) (gsb arg s))) (gsb (gapp A B' fun arg) s)
      (gapp (gsb A s) (gsb B' (glift A s)) (gsb fun s) (gsb arg s)) (reindex-term d g f.1 src) dst
      (ty-sub-down (gsb B' (glift A s)) (gsec (gsb A s) (gsb arg s)) d S.y S.bs (C.sec (ctx d) S.as a1)
        cod-down (sec-down (gsb A s) (gsb arg s) d S.as a1 dom-down ha1))
      (tm-sub-down (gapp A B' fun arg) s d g src.1 src.2 f.1 hsrc f.2)
      (app-down (gsb A s) (gsb B' (glift A s)) (gsb fun s) (gsb arg s) d S.as S.bs (S.subst-fun fn.1) a1
        dom-down cod-down (fn-down fun fn.1 fn.2) ha1)
      (S.application-nat fn.1 a0.1)
   where {
    src : Term g = app-at g v.dom v.cod fn.1 a0.1 ;
    hsrc : Denotes ((meaning (gapp A B' fun arg)).term-at g) src =
      app-down A B' fun arg g v.dom v.cod fn.1 a0.1 v.dom-down v.cod-down fn.2 a0.2 ;
    a1 : C.El (ctx d) S.as = C.subt (ctx d) (ctx g) v.dom a0.1 f.1 ;
    ha1 : TmDown (gsb arg s) d S.as a1 = tm-sub-down arg s d g v.dom a0.1 f.1 a0.2 f.2 ;
    dst : Term d = app-at d S.as S.bs (S.subst-fun fn.1) a1 ;
   } ;
} ;

module EtaRule (A B' f : GE) (g : Tel) (v : ProductValue[g,A,B']) (fn : TermAt g v.pi f) {
  body-expr : GE = gapp (gsb A gp) (gsb B' (glift A gp)) (gsb f gp) gq ;
  module E = PiEta[g,v.dom,v.cod,fn.1] ;
  proj : SubValue E.x g gp = (E.p,p-down g v.dom) ;
  module P = ReindexedProduct[A,B',gp,E.x,g,v,proj] ;
  body-down : Denotes ((meaning body-expr).term-at E.x) E.body =
    app-down (gsb A gp) (gsb B' (glift A gp)) (gsb f gp) gq E.x E.S.as E.S.bs (E.S.subst-fun fn.1) E.q
      P.dom-down P.cod-down (P.fn-down f fn.1 fn.2) (q-down g v.dom) ;

  down :
      TermEquality g (gpi A B') f (glam A B' body-expr) =
    same-term g (gpi A B') f (glam A B' body-expr) (v.pi,fn.1) (v.pi,lam-at g v.dom v.cod (E.S.uncurry fn.1))
      v.pi-down-at fn.2
      (lam-down A B' body-expr g v.dom v.cod (E.S.uncurry fn.1) v.dom-down v.cod-down
        (tm-move body-expr E.x E.body (v.cod,E.S.uncurry fn.1) E.body-path body-down))
      (apH (\ u -> (v.pi,u)) (symH ((M.products.Pi-iso (ctx g) v.dom v.cod).inv-fun fn.1)))
} ;

case-ge-pi-sb (D G A B' s : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (q : SoundJ (gjsub D s G)) : SoundJ (gjeqty D (gsb (gpi A B') s) (gpi (gsb A s) (gsb B' (glift A s)))) =
  (q.1,\ d hd -> ReindexedProduct[A,B',s,d,g,v,q.2.2 d g hd r.1.2].eq-type)
 where {
  g : Tel = r.1.1 ;
  v : ProductValue[g,A,B'] = product-value G A B' r p g r.1.2 ;

 } ;

case-gm-lam-sb (D G A B' b s : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (bt : SoundJ (gjtm (gext G A) b B')) (q : SoundJ (gjsub D s G)) :
    SoundJ (gjeqtm D (gsb (glam A B' b) s) (glam (gsb A s) (gsb B' (glift A s)) (gsb b (glift A s)))
      (gpi (gsb A s) (gsb B' (glift A s)))) =
  (q.1,\ d hd -> ReindexedProduct[A,B',s,d,g,v,q.2.2 d g hd r.1.2].eq-lam b u)
 where {
  g : Tel = r.1.1 ;
  v : ProductValue[g,A,B'] = product-value G A B' r p g r.1.2 ;
  x : Tel = extend g v.dom ;
  u : TermAt x v.cod b = at-type x B' b v.cod v.cod-down (bt.2 x (ext-down G A g v.dom r.1.2 v.dom-down)) ;

 } ;

case-gm-app-sb (D G A B' f a s : GE)
    (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (ft : SoundJ (gjtm G f (gpi A B'))) (at : SoundJ (gjtm G a A)) (q : SoundJ (gjsub D s G)) :
    SoundJ (gjeqtm D (gsb (gapp A B' f a) s) (gapp (gsb A s) (gsb B' (glift A s)) (gsb f s) (gsb a s))
      (gsb (gsb B' (glift A s)) (gsec (gsb A s) (gsb a s)))) =
  (q.1,\ d hd -> ReindexedProduct[A,B',s,d,g,v,q.2.2 d g hd r.1.2].eq-app f a fn a0)
 where {
  g : Tel = r.1.1 ;
  v : ProductValue[g,A,B'] = product-value G A B' r p g r.1.2 ;
  fn : TermAt g v.pi f = at-type g (gpi A B') f v.pi v.pi-down-at (ft.2 g r.1.2) ;
  a0 : TermAt g v.dom a = at-type g A a v.dom v.dom-down (at.2 g r.1.2) ;

 } ;

case-gm-eta (G A B' f : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjty (gext G A) B'))
    (ft : SoundJ (gjtm G f (gpi A B'))) :
    SoundJ (gjeqtm G f (glam A B' (gapp (gsb A gp) (gsb B' (glift A gp)) (gsb f gp) gq)) (gpi A B')) =
  (r.1,\ g hg -> build g (product-value G A B' r p g hg) (ft.2 g hg))
 where {
  build (g : Tel) (v : ProductValue[g,A,B']) (fr : TermValue g (gpi A B') f) :
      TermEquality g (gpi A B') f (glam A B' (gapp (gsb A gp) (gsb B' (glift A gp)) (gsb f gp) gq)) =
    EtaRule[A,B',f,g,v,at-type g (gpi A B') f v.pi v.pi-down-at fr].down ;
 } ;
