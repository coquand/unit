-- InitModel.seg (PLAN-INIT, Part A): the term model of T_E is a
-- TEModel[N].  eqs : Eqs collects the equations proved in InitModelCat,
-- InitModelExt, InitModelPi, InitModelU (the -gen lemmas are applied to
-- the paths that the fields require), and TM = mk eqs (InitModelShape).
level l ;
open Base ; open Prelude[l] ;
module EM = EhrhardTEModel[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitModelShape[l] ;
open InitModelCat[l] ;
open InitModelExt[l] ;
open InitModelPi[l] ;
open InitModelU[l] ;

-- the derived members p-lift-T and p-sec-T of CwF, for these proofs
plT (D G : Ctx) (A B : Ty G) (s : Sub D G)
  : Id (Ty (ext D (subT D G A s)))
       (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
       (subT (ext D (subT D G A s)) D (subT D G B s) (p D (subT D G A s))) =
  trans (Ty E)
    (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
    (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
    (subT E D (subT D G B s) (p D (subT D G A s)))
    (sym (Ty E) (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
                (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
                (subT-o E (ext G A) G B (p G A) (lift D G A s)))
    (trans (Ty E)
       (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
       (subT E G B (o E D G s (p D (subT D G A s))))
       (subT E D (subT D G B s) (p D (subT D G A s)))
       (ap (Sub E G) (Ty E) (\ s' -> subT E G B s')
           (o E (ext G A) G (p G A) (lift D G A s)) (o E D G s (p D (subT D G A s)))
           (p-lift D G A s))
       (subT-o E D G B s (p D (subT D G A s))))
 where { E : Ctx = ext D (subT D G A s) ; } ;

psT (G : Ctx) (A B : Ty G) (a : El G A)
  : Id (Ty G) (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a)) B =
  trans (Ty G)
    (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
    (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
    B
    (sym (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
                (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
                (subT-o G (ext G A) G B (p G A) (sec G A a)))
    (trans (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a))) (subT G G B (id G)) B
       (ap (Sub G G) (Ty G) (\ s' -> subT G G B s')
           (o G (ext G A) G (p G A) (sec G A a)) (id G) (p-sec G A a))
       (subT-id G B)) ;

eqs : Eqs =
  new Eqs[
    o-idl := o-idl, o-idr := o-idr, o-assoc := o-assoc, eps-uniq := eps-uniq,
    subT-id := subT-id, subT-o := subT-o, subt-id := subt-id, subt-o := subt-o,
    lift-id := \ G A -> lift-id-gen G A (subT-id G A),
    lift-o := \ T D G A s s' -> lift-o-gen T D G A s s' (subT-o T D G A s s'),
    p-lift := p-lift, p-sec := p-sec, sec-o := sec-o, lift-p-sec-q := lift-p-sec-q,
    q-lift := \ D G A s -> q-lift-gen D G A s (plT D G A A s),
    q-sec := \ G A a -> q-sec-gen G A a (psT G A A a),
    Pi-nat := Pi-nat, Pi-fun-inv := Pi-fun-inv, Pi-inv-fun := Pi-inv-fun,
    Pi-iso-nat := \ D G A B f s -> Pi-iso-nat-gen D G A B f s (Pi-nat D G A B s),
    univ-nat := univ-nat,
    decode-nat := decode-nat-u univ-nat,
    el-lf := el-lf, el-pic := el-pic, el-uc := el-uc,
    lf-pic := \ m n lt G a b -> lf-pic-u univ-nat m n lt G a b (el-lf m n lt G a),
    lf-uc := lf-uc, lf-lf := lf-lf,
    pic-nat := pic-nat-u univ-nat (decode-nat-u univ-nat),
    uc-nat := uc-nat-u univ-nat,
    lf-nat := lf-nat-u univ-nat] ;

-- the term model of T_E
TM : EM.TEModel[N] = mk eqs ;

-- its operations are those of Part F, definitionally
TM-subT : Id ((d c : Ctx) (A : Ty c) (s : Sub d c) -> Ty d) TM.cwf.subT subT = refl subT ;
TM-pi-inv (G : Ctx) (A : Ty G) (B : Ty (ext G A)) :
  Id (El (ext G A) B -> El G (Pi G A B)) (TM.products.Pi-iso G A B).inv (pi-inv G A B) = refl (pi-inv G A B) ;
TM-decode : Id ((n : EM.LevelAt N) (c : Ctx) (a : El c (univ n c)) -> Ty c) TM.decode decode = refl decode ;
