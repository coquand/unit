-- Product equations with endpoints converted by naturality and the lift laws.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open CGAT[l] ;
open CTyping[l] ; open CAxiomBase[l] ; open CAxiomAction[l] ;

use-c-fm-lam-sb (D G A B b s : FA) (wD : W D) (wG : W G)
    (hA : Ty G A) (hB : Ty (fext G A) B) (hb : Tm' (fext G A) b B) (hs : Sb D s G) :
    CDer (fjeqtm D (fmsb D G (fpi G A B) (flam G A B b) s)
      (flam D (ftsb D G A s) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fmsb (fext D (ftsb D G A s)) (fext G A) B b (flift D G A s)))
      (fpi D (ftsb D G A s) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s)))) =
  c-fm-lam-sb D G A B b s wD wG hA hB hb hs
    (c-conv-tm D (ftsb D G (fpi G A B) s) D (fpi D A' B') (fmsb D G (fpi G A B) (flam G A B b) s)
      (cx-refl wD) (use-c-fe-pi-sb D G A B s wD wG hA hB hs) (tm-sub (pi-ty hA hB) (lam-tm hA hB hb) hs))
    (lam-tm (ty-sub hA hs) (ty-sub hB lift) (tm-sub hB hb lift))
 where {
  A' : FA = ftsb D G A s ;
  B' : FA = ftsb (fext D A') (fext G A) B (flift D G A s) ;
  lift : Sb (fext D A') (flift D G A s) (fext G A) = lift-sub hA hs ;
 } ;

use-c-fm-app-sb (D G A B c a s : FA) (wD : W D) (wG : W G) (hA : Ty G A) (hB : Ty (fext G A) B)
    (hc : Tm' G c (fpi G A B)) (ha : Tm' G a A) (hs : Sb D s G) :
    CDer (fjeqtm D (fmsb D G (ftsb G (fext G A) B (fsec G A a)) (fapp G A B c a) s)
      (fapp D (ftsb D G A s) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fmsb D G (fpi G A B) c s) (fmsb D G A a s))
      (ftsb D (fext D (ftsb D G A s)) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fsec D (ftsb D G A s) (fmsb D G A a s)))) =
  c-fm-app-sb D G A B c a s wD wG hA hB hc ha hs
    (c-conv-tm D L D R (fmsb D G S (fapp G A B c a) s) (cx-refl wD) type-eq
      (tm-sub (ty-sub hB sec) (app-tm hA hB hc ha) hs))
    (app-tm hA' hB' hc' ha')
 where {
  A' : FA = ftsb D G A s ;
  B' : FA = ftsb (fext D A') (fext G A) B (flift D G A s) ;
  a' : FA = fmsb D G A a s ;
  S : FA = ftsb G (fext G A) B (fsec G A a) ;
  L : FA = ftsb D G S s ;
  R : FA = ftsb D (fext D A') B' (fsec D A' a') ;
  left-comp : FA = fcomp D G (fext G A) (fsec G A a) s ;
  right-comp : FA = fcomp D (fext D A') (fext G A) (flift D G A s) (fsec D A' a') ;
  M : FA = ftsb D (fext G A) B left-comp ;
  M' : FA = ftsb D (fext G A) B right-comp ;
  sec : Sb G (fsec G A a) (fext G A) = sec-sub hA ha ;
  lift : Sb (fext D A') (flift D G A s) (fext G A) = lift-sub hA hs ;
  hA' : Ty D A' = ty-sub hA hs ;
  hB' : Ty (fext D A') B' = ty-sub hB lift ;
  ha' : Tm' D a' A' = tm-sub hA ha hs ;
  hc' : Tm' D (fmsb D G (fpi G A B) c s) (fpi D A' B') =
    c-conv-tm D (ftsb D G (fpi G A B) s) D (fpi D A' B') (fmsb D G (fpi G A B) c s)
      (cx-refl wD) (use-c-fe-pi-sb D G A B s wD wG hA hB hs) (tm-sub (pi-ty hA hB) hc hs) ;
  type-eq : TE D L R = c-trans-ty D L M R (sb-comp-ty hB sec hs)
    (c-trans-ty D M M' R (sb-same-ty {D} {fext G A} {B} {left-comp} {right-comp} hB
      (use-c-fq-sec-comp D G A a s wD wG hA ha hs)) (ty-sym (sb-comp-ty hB lift (sec-sub hA' ha')))) ;
 } ;

use-c-fm-eta (G A B f : FA) (wG : W G) (hA : Ty G A) (hB : Ty (fext G A) B) (hf : Tm' G f (fpi G A B)) :
    CDer (fjeqtm G f (flam G A B (fapp (fext G A) (ftsb (fext G A) G A (fp G A))
      (ftsb (fext (fext G A) (ftsb (fext G A) G A (fp G A))) (fext G A) B (flift (fext G A) G A (fp G A)))
      (fmsb (fext G A) G (fpi G A B) f (fp G A)) (fq G A))) (fpi G A B)) =
  c-fm-eta G A B f wG hA hB hf hf (lam-tm hA hB body-typed)
 where {
  E : FA = fext G A ;
  wE : W E = ext-wf hA ;
  p : Sb E (fp G A) G = p-sub hA ;
  A' : FA = ftsb E G A (fp G A) ;
  F : FA = fext E A' ;
  B' : FA = ftsb F E B (flift E G A (fp G A)) ;
  f' : FA = fmsb E G (fpi G A B) f (fp G A) ;
  body : FA = fapp E A' B' f' (fq G A) ;
  lift : Sb F (flift E G A (fp G A)) E = lift-sub hA p ;
  hA' : Ty E A' = ty-sub hA p ;
  weakened : Tm' E f' (fpi E A' B') = c-conv-tm E (ftsb E G (fpi G A B) (fp G A)) E (fpi E A' B') f'
    (cx-refl wE) (use-c-fe-pi-sb E G A B (fp G A) wE wG hA hB p) (tm-sub (pi-ty hA hB) hf p) ;
  body-typed : Tm' E body B = c-conv-tm E (ftsb E F B' (fsec E A' (fq G A))) E B body (cx-refl wE)
    (sub-id-from wE hB lift (sec-sub hA' (q-tm hA)) (use-c-fq-lift-p-sec-q G A wG hA))
    (app-tm hA' (ty-sub hB lift) weakened (q-tm hA)) ;
 } ;
