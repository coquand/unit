-- Generation, inversion, and transport for full contexts.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;

wf-left (G D : FA) (e : CE G D) : W G = (fpresup (fjeqcx G D) e).1 ;
wf-right (G D : FA) (e : CE G D) : W D = (fpresup (fjeqcx G D) e).2.1 ;

WfHead : FA -> U l = split {
  fnil -> Top ;
  fext G A -> Ty G A ;
  fpi G A B -> Empty ;
  fuu n G -> Empty ;
  fel n G a -> Empty ;
  ftsb D G A s -> Empty ;
  fmsb D G A a s -> Empty ;
  flam G A B b -> Empty ;
  fapp G A B c a -> Empty ;
  fpic n G a b -> Empty ;
  fuc m n G -> Empty ;
  flf m n G a -> Empty ;
  fq G A -> Empty ;
  fid G -> Empty ;
  fcomp T D G s d -> Empty ;
  feps G -> Empty ;
  fp G A -> Empty ;
  flift D G A s -> Empty ;
  fsec G A a -> Empty } ;

CxView : FA -> FA -> U l = split {
  fnil -> \ E -> Id FA E fnil ;
  fext G A -> \ E -> (D B : FA) * (Id FA E (fext D B) * (CE G D * TE G A B)) ;
  fpi G A B -> \ E -> Empty ;
  fuu n G -> \ E -> Empty ;
  fel n G a -> \ E -> Empty ;
  ftsb D G A s -> \ E -> Empty ;
  fmsb D G A a s -> \ E -> Empty ;
  flam G A B b -> \ E -> Empty ;
  fapp G A B c a -> \ E -> Empty ;
  fpic n G a b -> \ E -> Empty ;
  fuc m n G -> \ E -> Empty ;
  flf m n G a -> \ E -> Empty ;
  fq G A -> \ E -> Empty ;
  fid G -> \ E -> Empty ;
  fcomp T D G s d -> \ E -> Empty ;
  feps G -> \ E -> Empty ;
  fp G A -> \ E -> Empty ;
  flift D G A s -> \ E -> Empty ;
  fsec G A a -> \ E -> Empty } ;

cx-view-refl : (G : FA) -> W G -> WfHead G -> CxView G G = split {
  fnil -> \ w t -> refl fnil ;
  fext G A -> \ w t -> (G, (A, (refl (fext G A), (fc-refl G (fpresup (fjty G A) t), fe-refl G A t)))) ;
  fpi G A B -> \ w t -> t ;
  fuu n G -> \ w t -> t ;
  fel n G a -> \ w t -> t ;
  ftsb D G A s -> \ w t -> t ;
  fmsb D G A a s -> \ w t -> t ;
  flam G A B b -> \ w t -> t ;
  fapp G A B c a -> \ w t -> t ;
  fpic n G a b -> \ w t -> t ;
  fuc m n G -> \ w t -> t ;
  flf m n G a -> \ w t -> t ;
  fq G A -> \ w t -> t ;
  fid G -> \ w t -> t ;
  fcomp T D G s d -> \ w t -> t ;
  feps G -> \ w t -> t ;
  fp G A -> \ w t -> t ;
  flift D G A s -> \ w t -> t ;
  fsec G A a -> \ w t -> t } ;

CtxGen : FAJ -> U l = split {
  fjwf G -> WfHead G ; fjeqcx G D -> CxView G D ;
  fjty G A -> Top ; fjtm G a A -> Top ; fjsub D s G -> Top ;
  fjeqty G A B -> Top ; fjeqtm G a b A -> Top ; fjeqsub D s t G -> Top } ;

ctx-gen : (J : FAJ) -> FADer J -> CtxGen J = split {
  f-nil -> tt ;
  f-ext G A h -> h ;
  fc-nil -> refl fnil ;
  fc-refl G h | r -> cx-view-refl G h r ;
  fc-ext G D A B h1 h2 -> (D, (B, (refl (fext D B), (h1, h2)))) ;
  fs-id G h -> tt ;
  fs-comp T D G s d h1 h2 -> tt ;
  fs-eps G h -> tt ;
  fs-p G A h -> tt ;
  fs-lift D G A s h1 h2 -> tt ;
  fs-sec G A a h1 h2 -> tt ;
  fs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  ft-pi G A B h1 h2 -> tt ;
  ft-uu G n h nb -> tt ;
  ft-el G n a h -> tt ;
  ft-sb D G A s h1 h2 -> tt ;
  ft-cx G D A h0 h1 h2 -> tt ;
  fm-lam G A B b h1 h2 h3 -> tt ;
  fm-app G A B c a h1 h2 h3 h4 -> tt ;
  fm-pic G n a b h1 h2 -> tt ;
  fm-uc G m n h lt nb -> tt ;
  fm-lf G m n a h le nb -> tt ;
  fm-q G A h -> tt ;
  fm-sb D G a A s hA h1 h2 -> tt ;
  fm-conv G a A B h1 h2 -> tt ;
  fm-cx G D a A h0 h1 h2 -> tt ;
  fe-refl G A h -> tt ;
  fe-sym G A B h -> tt ;
  fe-trans G A B C h1 h2 -> tt ;
  fe-pi G A A' B B' h0 h1 h2 -> tt ;
  fe-el G n a a' h -> tt ;
  fe-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  fe-el-lf G m n a h le nb -> tt ;
  fe-el-pic G n a b h1 h2 -> tt ;
  fe-el-uc G m n h lt nb -> tt ;
  fe-sb-id G A h -> tt ;
  fe-sb-comp T D G A s d h0 h1 h2 -> tt ;
  fe-pi-sb D G A B s h1 h2 h3 -> tt ;
  fe-uu-sb D G n s h nb -> tt ;
  fe-el-sb D G n a s h1 h2 -> tt ;
  fe-cx G D A B h0 h1 h2 -> tt ;
  fm-refl G a A h -> tt ;
  fm-sym G a b A hA h -> tt ;
  fm-trans G a b c A h1 h2 -> tt ;
  fm-eqconv G a b A B h1 h2 -> tt ;
  fm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  fm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  fm-epic G n a a' b b' h0 h1 h2 -> tt ;
  fm-elf G m n a a' h le nb -> tt ;
  fm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  fm-beta G A B b a hA hB h1 h2 -> tt ;
  fm-eta G A B f hA hB h -> tt ;
  fm-lf-pic G n p a b h1 h2 le nb -> tt ;
  fm-lf-uc G m n p h lt le nb -> tt ;
  fm-lf-lf G m n p a h le1 le2 nb -> tt ;
  fm-sb-id G a A h -> tt ;
  fm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  fm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  fm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  fm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  fm-uc-sb D G m n s h lt nb -> tt ;
  fm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  fm-q-lift D G A s h1 h2 -> tt ;
  fm-q-sec G A a h1 h2 -> tt ;
  fm-ecx G D a b A h0 h1 h2 -> tt ;
  fq-refl D s G h -> tt ;
  fq-sym D s t G h -> tt ;
  fq-trans D s t u G h1 h2 -> tt ;
  fq-comp T D G s s' d d' h1 h2 -> tt ;
  fq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  fq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  fq-idl D G s h -> tt ;
  fq-idr D G s h -> tt ;
  fq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  fq-eps G s h -> tt ;
  fq-lift-id G A h -> tt ;
  fq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  fq-p-lift D G A s h1 h2 -> tt ;
  fq-p-sec G A a h1 h2 -> tt ;
  fq-sec-comp D G A a s h1 h2 h3 -> tt ;
  fq-lift-p-sec-q G A h -> tt ;
  fe-uu-cx G H n e nb -> tt ;
  fm-uc-cx G H m n e lt nb -> tt ;
  fq-id-cx G H e -> tt ;
  fq-eps-cx G H e -> tt ;
  fq-p-cx G H A B e p -> tt ;
  fm-q-cx G H A B e p -> tt ;
  fe-pi-context G A B h1 h2 G' e -> tt ;
  fe-el-context G n a h G' e -> tt ;
  fe-sb-source D G A s h1 h2 D' e -> tt ;
  fe-sb-target D G A s h1 h2 G' e -> tt ;
  fm-lam-context G A B b h1 h2 h3 G' e -> tt ;
  fm-app-context G A B c a h1 h2 h3 h4 G' e -> tt ;
  fm-pic-context G n a b h1 h2 G' e -> tt ;
  fm-lf-context G m n a h le nb G' e -> tt ;
  fm-sb-source D G a A s hA h1 h2 D' e -> tt ;
  fm-sb-target D G a A s hA h1 h2 G' e -> tt ;
  fm-sb-type D G a A s hA h1 h2 A' e -> tt ;
  fq-comp-source T D G s d h1 h2 T' e -> tt ;
  fq-comp-middle T D G s d h1 h2 D' e -> tt ;
  fq-comp-target T D G s d h1 h2 G' e -> tt ;
  fq-lift-source D G A s h1 h2 D' e -> tt ;
  fq-lift-target D G A s h1 h2 G' e -> tt ;
  fq-sec-context G A a h1 h2 G' e -> tt } ;

wf-ext-inv (G A : FA) (w : W (fext G A)) : Ty G A =
  ctx-gen (fjwf (fext G A)) w ;

context-view (G D : FA) (e : CE G D) : CxView G D =
  ctx-gen (fjeqcx G D) e ;

f-prefix : FA -> FA = split {
  fnil -> fnil ;
  fext G A -> G ;
  fpi G A B -> fnil ;
  fuu n G -> fnil ;
  fel n G a -> fnil ;
  ftsb D G A s -> fnil ;
  fmsb D G A a s -> fnil ;
  flam G A B b -> fnil ;
  fapp G A B c a -> fnil ;
  fpic n G a b -> fnil ;
  fuc m n G -> fnil ;
  flf m n G a -> fnil ;
  fq G A -> fnil ;
  fid G -> fnil ;
  fcomp T D G s d -> fnil ;
  feps G -> fnil ;
  fp G A -> fnil ;
  flift D G A s -> fnil ;
  fsec G A a -> fnil } ;

f-last : FA -> FA = split {
  fnil -> fnil ;
  fext G A -> A ;
  fpi G A B -> fnil ;
  fuu n G -> fnil ;
  fel n G a -> fnil ;
  ftsb D G A s -> fnil ;
  fmsb D G A a s -> fnil ;
  flam G A B b -> fnil ;
  fapp G A B c a -> fnil ;
  fpic n G a b -> fnil ;
  fuc m n G -> fnil ;
  flf m n G a -> fnil ;
  fq G A -> fnil ;
  fid G -> fnil ;
  fcomp T D G s d -> fnil ;
  feps G -> fnil ;
  fp G A -> fnil ;
  flift D G A s -> fnil ;
  fsec G A a -> fnil } ;

cx-ext-inv (G A D B : FA) (e : CE (fext G A) (fext D B)) : CE G D * TE G A B =
  Prelude[l].subst FA (\ X -> CE G (f-prefix X) * TE G A (f-last X)) (fext h.1 h.2.1) (fext D B)
    (Prelude[l].sym FA (fext D B) (fext h.1 h.2.1) h.2.2.1) h.2.2.2
  where { h : CxView (fext G A) (fext D B) = context-view (fext G A) (fext D B) e ; } ;

cx-trans-finish (G A D B E : FA) (r : (X Y : FA) -> CE G X -> CE X Y -> CE G Y)
    (e : CE G D) (t : TE G A B) (v : CxView (fext D B) E) : CE (fext G A) E =
  Prelude[l].subst FA (\ X -> CE (fext G A) X) (fext v.1 v.2.1) E
    (Prelude[l].sym FA E (fext v.1 v.2.1) v.2.2.1)
    (fc-ext G v.1 A v.2.1 (r D v.1 e v.2.2.2.1)
      (fe-trans G A B v.2.1 t
        (fe-cx D G B v.2.1 (wf-left G D e) (f-cx-sym G D e) v.2.2.2.2))) ;

cx-trans-ext (G A D E : FA) (r : (X Y : FA) -> CE G X -> CE X Y -> CE G Y)
    (v : CxView (fext G A) D) (f : CE D E) : CE (fext G A) E =
  cx-trans-finish G A v.1 v.2.1 E r v.2.2.2.1 v.2.2.2.2
    (context-view (fext v.1 v.2.1) E
      (Prelude[l].subst FA (\ X -> CE X E) D (fext v.1 v.2.1) v.2.2.1 f)) ;

f-cx-trans : (G D E : FA) -> CE G D -> CE D E -> CE G E = split {
  fnil -> \ D E e f -> Prelude[l].subst FA (\ X -> CE X E) D fnil (context-view fnil D e) f ;
  fext G A | rG rA -> \ D E e f -> cx-trans-ext G A D E rG (context-view (fext G A) D e) f ;
  fpi G A B -> \ X Y e f -> efq (context-view (fpi G A B) X e) ;
  fuu n G -> \ X Y e f -> efq (context-view (fuu n G) X e) ;
  fel n G a -> \ X Y e f -> efq (context-view (fel n G a) X e) ;
  ftsb D G A s -> \ X Y e f -> efq (context-view (ftsb D G A s) X e) ;
  fmsb D G A a s -> \ X Y e f -> efq (context-view (fmsb D G A a s) X e) ;
  flam G A B b -> \ X Y e f -> efq (context-view (flam G A B b) X e) ;
  fapp G A B c a -> \ X Y e f -> efq (context-view (fapp G A B c a) X e) ;
  fpic n G a b -> \ X Y e f -> efq (context-view (fpic n G a b) X e) ;
  fuc m n G -> \ X Y e f -> efq (context-view (fuc m n G) X e) ;
  flf m n G a -> \ X Y e f -> efq (context-view (flf m n G a) X e) ;
  fq G A -> \ X Y e f -> efq (context-view (fq G A) X e) ;
  fid G -> \ X Y e f -> efq (context-view (fid G) X e) ;
  fcomp T D G s d -> \ X Y e f -> efq (context-view (fcomp T D G s d) X e) ;
  feps G -> \ X Y e f -> efq (context-view (feps G) X e) ;
  fp G A -> \ X Y e f -> efq (context-view (fp G A) X e) ;
  flift D G A s -> \ X Y e f -> efq (context-view (flift D G A s) X e) ;
  fsec G A a -> \ X Y e f -> efq (context-view (fsec G A a) X e) } ;

-- Transport to the right endpoints of the given context equalities.
move-ty (G H A : FA) (e : CE G H) (h : Ty G A) : Ty H A =
  ft-cx G H A (wf-right G H e) e h ;

move-tm (G H a A : FA) (e : CE G H) (h : Tm' G a A) : Tm' H a A =
  fm-cx G H a A (wf-right G H e) e h ;

move-te (G H A B : FA) (e : CE G H) (h : TE G A B) : TE H A B =
  fe-cx G H A B (wf-right G H e) e h ;

move-me (G H a b A : FA) (e : CE G H) (h : ME G a b A) : ME H a b A =
  fm-ecx G H a b A (wf-right G H e) e h ;

move-sub (D E G H s : FA) (d : CE D E) (g : CE G H) (h : Sb D s G) : Sb E s H =
  fs-cx D E G H s (wf-right D E d) (wf-right G H g) d g h ;
