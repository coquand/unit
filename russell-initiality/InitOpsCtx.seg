-- InitOpsCtx.seg (PLAN-INIT, Part F): operations on contexts and the
-- category of substitutions of the term model: nil, ext, id, eps, o.
-- Each operation is InitQuot.Choice on the representatives of all its
-- arguments (module Op*); its beta lemma says that on ANY representatives
-- (Rep* with paths) it is the class of the evident raw expression, with
-- arbitrary proofs and paths for the result.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
open InitQuot[l] ;
open InitSorts[l] ;

------------------------------------------------------------------------
-- empty context

nil-w : Pf (gjwf gnil) = pf (gjwf gnil) g-nil ;
nil : Ctx = cls gnil nil-w ;

------------------------------------------------------------------------
-- context extension

module OpExt (c : Ctx) (A : Ty c) {
  W : U l = RepTy c A ;
  der (r : W) : Pf (gjwf (gext (rtG c A r) (rtA c A r))) =
    pf-map (gjty (rtG c A r) (rtA c A r)) (gjwf (gext (rtG c A r) (rtA c A r)))
      (\ k -> g-ext (rtG c A r) (rtA c A r) k) (rtH c A r) ;
  f (r : W) : Ctx = cls (gext (rtG c A r) (rtA c A r)) (der r) ;
  const (r r' : W) : Id Ctx (f r) (f r') =
    cls-eq (gext (rtG c A r) (rtA c A r)) (gext (rtG c A r') (rtA c A r')) (der r) (der r')
      (pf-map2 (gjeqcx (rtG c A r) (rtG c A r')) (gjeqty (rtG c A r) (rtA c A r) (rtA c A r'))
        (gjeqcx (gext (rtG c A r) (rtA c A r)) (gext (rtG c A r') (rtA c A r')))
        (\ k e -> gc-ext (rtG c A r) (rtG c A r') (rtA c A r) (rtA c A r') k e)
        (same-cx c (rtG c A r) (rtG c A r') (rtW c A r) (rtW c A r') (rtP c A r) (rtP c A r'))
        (same-rt c A r r')) ;
  module Ch = Choice[W, Ctx, isSetCtx, f, const] ;
  value : Ctx = Ch.elim (rep-ty c A) ;
  beta (r : W) : Id Ctx value (f r) = Ch.beta (rep-ty c A) r ;
} ;

ext (c : Ctx) (A : Ty c) : Ctx = OpExt[c,A].value ;
ext-der (c : Ctx) (A : Ty c) (r : RepTy c A) : Pf (gjwf (gext (rtG c A r) (rtA c A r))) = OpExt[c,A].der r ;
ext-beta (c : Ctx) (A : Ty c) (r : RepTy c A) (w : Pf (gjwf (gext (rtG c A r) (rtA c A r)))) :
  Id Ctx (ext c A) (cls (gext (rtG c A r) (rtA c A r)) w) =
  trans Ctx (ext c A) (OpExt[c,A].f r) (cls (gext (rtG c A r) (rtA c A r)) w)
    (OpExt[c,A].beta r) (cls-irr (gext (rtG c A r) (rtA c A r)) (OpExt[c,A].der r) w) ;
-- the same, the other way round (the form needed for path components)
ext-beta' (c : Ctx) (A : Ty c) (r : RepTy c A) (w : Pf (gjwf (gext (rtG c A r) (rtA c A r)))) :
  Id Ctx (cls (gext (rtG c A r) (rtA c A r)) w) (ext c A) =
  sym Ctx (ext c A) (cls (gext (rtG c A r) (rtA c A r)) w) (ext-beta c A r w) ;

------------------------------------------------------------------------
-- identity

module OpId (c : Ctx) {
  W : U l = RepCtx c ;
  der (r : W) : Pf (gjsub r.1 gid r.1) = pf-map (gjwf r.1) (gjsub r.1 gid r.1) (\ k -> gs-id r.1 k) r.2.1 ;
  f (r : W) : Sub c c = clsSub c c r.1 gid r.1 (der r) r.2.1 r.2.1 r.2.2 r.2.2 ;
  const (r r' : W) : Id (Sub c c) (f r) (f r') =
    clsSub-eq c c r.1 gid r.1 (der r) r.2.1 r.2.1 r.2.2 r.2.2 r'.1 gid r'.1 (der r') r'.2.1 r'.2.1 r'.2.2 r'.2.2
      (pf-map (gjwf r.1) (gjeqsub r.1 gid gid r.1) (\ k -> gq-refl r.1 gid r.1 (gs-id r.1 k)) r.2.1) ;
  module Ch = Choice[W, Sub c c, isSetSub c c, f, const] ;
  value : Sub c c = Ch.elim (rep-ctx c) ;
  beta (r : W) : Id (Sub c c) value (f r) = Ch.beta (rep-ctx c) r ;
} ;

id (c : Ctx) : Sub c c = OpId[c].value ;
-- for ANY raw contexts D1, G1 in the class c (no representative needed)
id-beta (c : Ctx) (D1 G1 : GE) (h : Pf (gjsub D1 gid G1)) (wD : Pf (gjwf D1)) (wG : Pf (gjwf G1))
  (pd : Id Ctx (cls D1 wD) c) (pc : Id Ctx (cls G1 wG) c) :
  Id (Sub c c) (id c) (clsSub c c D1 gid G1 h wD wG pd pc) =
  sq-rec (RepCtx c) (Id (Sub c c) (id c) (clsSub c c D1 gid G1 h wD wG pd pc))
    (isSetSub c c (id c) (clsSub c c D1 gid G1 h wD wG pd pc))
    (\ r -> trans (Sub c c) (id c) (OpId[c].f r) (clsSub c c D1 gid G1 h wD wG pd pc) (OpId[c].beta r)
      (clsSub-irr c c r.1 gid r.1 (OpId[c].der r) r.2.1 r.2.1 r.2.2 r.2.2 D1 G1 h wD wG pd pc))
    (rep-ctx c) ;

------------------------------------------------------------------------
-- terminal substitution

module OpEps (c : Ctx) {
  W : U l = RepCtx c ;
  der (r : W) : Pf (gjsub r.1 geps gnil) = pf-map (gjwf r.1) (gjsub r.1 geps gnil) (\ k -> gs-eps r.1 k) r.2.1 ;
  f (r : W) : Sub c nil = clsSub c nil r.1 geps gnil (der r) r.2.1 nil-w r.2.2 (refl nil) ;
  const (r r' : W) : Id (Sub c nil) (f r) (f r') =
    clsSub-eq c nil r.1 geps gnil (der r) r.2.1 nil-w r.2.2 (refl nil)
      r'.1 geps gnil (der r') r'.2.1 nil-w r'.2.2 (refl nil)
      (pf-map (gjwf r.1) (gjeqsub r.1 geps geps gnil) (\ k -> gq-refl r.1 geps gnil (gs-eps r.1 k)) r.2.1) ;
  module Ch = Choice[W, Sub c nil, isSetSub c nil, f, const] ;
  value : Sub c nil = Ch.elim (rep-ctx c) ;
  beta (r : W) : Id (Sub c nil) value (f r) = Ch.beta (rep-ctx c) r ;
} ;

eps (c : Ctx) : Sub c nil = OpEps[c].value ;
eps-beta (c : Ctx) (D1 G1 : GE) (h : Pf (gjsub D1 geps G1)) (wD : Pf (gjwf D1)) (wG : Pf (gjwf G1))
  (pd : Id Ctx (cls D1 wD) c) (pc : Id Ctx (cls G1 wG) nil) :
  Id (Sub c nil) (eps c) (clsSub c nil D1 geps G1 h wD wG pd pc) =
  sq-rec (RepCtx c) (Id (Sub c nil) (eps c) (clsSub c nil D1 geps G1 h wD wG pd pc))
    (isSetSub c nil (eps c) (clsSub c nil D1 geps G1 h wD wG pd pc))
    (\ r -> trans (Sub c nil) (eps c) (OpEps[c].f r) (clsSub c nil D1 geps G1 h wD wG pd pc) (OpEps[c].beta r)
      (clsSub-irr c nil r.1 geps gnil (OpEps[c].der r) r.2.1 nil-w r.2.2 (refl nil) D1 G1 h wD wG pd pc))
    (rep-ctx c) ;

------------------------------------------------------------------------
-- composition  o t d c s s' = s o s' : t -> c,  raw  gcomp s s'

module OpComp (t d c : Ctx) (s : Sub d c) (s' : Sub t d) {
  W : U l = RepSub d c s * RepSub t d s' ;
  -- s : D -> G,  s' : T -> D'
  D (x : W) : GE = rsD d c s x.1 ;
  G (x : W) : GE = rsG d c s x.1 ;
  T (x : W) : GE = rsD t d s' x.2 ;
  D' (x : W) : GE = rsG t d s' x.2 ;
  s0 (x : W) : GE = rss d c s x.1 ;
  s1 (x : W) : GE = rss t d s' x.2 ;
  cxD (x : W) : Pf (gjeqcx (D' x) (D x)) =
    same-cx d (D' x) (D x) (rsWG t d s' x.2) (rsWD d c s x.1) (rsPG t d s' x.2) (rsPD d c s x.1) ;
  der (x : W) : Pf (gjsub (T x) (gcomp (s0 x) (s1 x)) (G x)) =
    pf-map5 (gjsub (D x) (s0 x) (G x)) (gjsub (T x) (s1 x) (D' x)) (gjeqcx (D' x) (D x)) (gjwf (T x)) (gjwf (D x))
      (gjsub (T x) (gcomp (s0 x) (s1 x)) (G x))
      (\ h1 h2 k wT wD -> gs-comp (T x) (D x) (G x) (s0 x) (s1 x) h1
        (gs-cx (T x) (T x) (D' x) (D x) (s1 x) wT wD (gc-refl (T x) wT) k h2))
      (rsH d c s x.1) (rsH t d s' x.2) (cxD x) (rsWD t d s' x.2) (rsWD d c s x.1) ;
  f (x : W) : Sub t c =
    clsSub t c (T x) (gcomp (s0 x) (s1 x)) (G x) (der x) (rsWD t d s' x.2) (rsWG d c s x.1)
      (rsPD t d s' x.2) (rsPG d c s x.1) ;
  const (x y : W) : Id (Sub t c) (f x) (f y) =
    clsSub-eq t c (T x) (gcomp (s0 x) (s1 x)) (G x) (der x) (rsWD t d s' x.2) (rsWG d c s x.1)
      (rsPD t d s' x.2) (rsPG d c s x.1)
      (T y) (gcomp (s0 y) (s1 y)) (G y) (der y) (rsWD t d s' y.2) (rsWG d c s y.1)
      (rsPD t d s' y.2) (rsPG d c s y.1)
      (pf-map5 (gjeqsub (D x) (s0 x) (s0 y) (G x)) (gjeqsub (T x) (s1 x) (s1 y) (D' x)) (gjeqcx (D' x) (D x))
        (gjwf (T x)) (gjwf (D x)) (gjeqsub (T x) (gcomp (s0 x) (s1 x)) (gcomp (s0 y) (s1 y)) (G x))
        (\ e1 e2 k wT wD -> gq-comp (T x) (D x) (G x) (s0 x) (s0 y) (s1 x) (s1 y) e1
          (eqsub-cx (T x) (T x) (D' x) (D x) (s1 x) (s1 y) wT wD (gc-refl (T x) wT) k e2))
        (same-rs d c s x.1 y.1) (same-rs t d s' x.2 y.2) (cxD x) (rsWD t d s' x.2) (rsWD d c s x.1)) ;
  module Ch = Choice[W, Sub t c, isSetSub t c, f, const] ;
  reps : Sq W = sq-pair (RepSub d c s) (RepSub t d s') (rep-sub d c s) (rep-sub t d s') ;
  value : Sub t c = Ch.elim reps ;
  beta (x : W) : Id (Sub t c) value (f x) = Ch.beta reps x ;
} ;

o (t d c : Ctx) (s : Sub d c) (s' : Sub t d) : Sub t c = OpComp[t,d,c,s,s'].value ;
-- for any raw contexts T1, G1 of the result
o-beta (t d c : Ctx) (s : Sub d c) (s' : Sub t d) (r : RepSub d c s) (r' : RepSub t d s')
  (T1 G1 : GE) (h : Pf (gjsub T1 (gcomp (rss d c s r) (rss t d s' r')) G1))
  (wT : Pf (gjwf T1)) (wG : Pf (gjwf G1)) (pt : Id Ctx (cls T1 wT) t) (pc : Id Ctx (cls G1 wG) c) :
  Id (Sub t c) (o t d c s s') (clsSub t c T1 (gcomp (rss d c s r) (rss t d s' r')) G1 h wT wG pt pc) =
  trans (Sub t c) (o t d c s s') (OpComp[t,d,c,s,s'].f (r, r'))
    (clsSub t c T1 (gcomp (rss d c s r) (rss t d s' r')) G1 h wT wG pt pc)
    (OpComp[t,d,c,s,s'].beta (r, r'))
    (clsSub-irr t c (rsD t d s' r') (gcomp (rss d c s r) (rss t d s' r')) (rsG d c s r)
      (OpComp[t,d,c,s,s'].der (r, r')) (rsWD t d s' r') (rsWG d c s r) (rsPD t d s' r') (rsPG d c s r)
      T1 G1 h wT wG pt pc) ;
