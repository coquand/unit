    (c-eqconv-ty G G' (fuu n G') (fuu n G) pG (c-sym-ty G (fuu n G) (fuu n G') (c-eq-fuu n G G' pG bound2)))
    (c-flf m n G' a' r-pG.2 (c-conv-tm G (fuu m G) G' (fuu m G') a' pG (c-eq-fuu m G G' pG (leN-trans m n N (lt-le
    m n bound1) bound2)) r-pa.2.2.2) bound1 bound2))))) ;
  c-conv-ty G H x eG h | r-eG _ -> r-eG.2 ;
  c-eqconv-ty G H x y eG h | r-eG r-h -> (r-eG.2, ((c-conv-ty G H x eG r-h.2.1), (c-conv-ty G H y eG r-h.2.2))) ;
  c-conv-sub D G E H x eD eG h | r-eD r-eG _ -> (r-eD.2, r-eG.2) ;
  c-eqconv-sub D G E H x y eD eG h | r-eD r-eG r-h -> (r-eD.2, (r-eG.2, ((c-conv-sub D G E H x eD eG r-h.2.2.1),
    (c-conv-sub D G E H y eD eG r-h.2.2.2)))) ;
  c-conv-tm G A H B x eG eA h | r-eG r-eA _ -> (r-eG.2, (c-conv-ty G H B eG r-eA.2.2)) ;
  c-eqconv-tm G A H B x y eG eA h | r-eG r-eA r-h -> (r-eG.2, ((c-conv-ty G H B eG r-eA.2.2), ((c-conv-tm G A H B
    x eG eA r-h.2.2.1), (c-conv-tm G A H B y eG eA r-h.2.2.2)))) } ;

c-universe-level : FA -> U l = split {
  fnil -> Top ;
  fext G A -> Top ;
  fid G -> Top ;
  fcomp T D G s d -> Top ;
  feps G -> Top ;
  fp G A -> Top ;
  flift D G A s -> Top ;
  fsec G A a -> Top ;
  ftsb D G A s -> Top ;
  fmsb D G A a s -> Top ;
  fq G A -> Top ;
  fpi G A B -> Top ;
  flam G A B b -> Top ;
  fapp G A B c a -> Top ;
  fuu n G -> LeN n N ;
  fel n G a -> Top ;
  fpic n G a b -> Top ;
  fuc m n G -> Top ;
  flf m n G a -> Top } ;

c-universe-bound-at : FAJ -> U l = split {
  fjty G A -> c-universe-level A ;
  fjwf G -> Top ; fjtm G a A -> Top ; fjsub D s G -> Top ;
  fjeqcx G H -> Top ; fjeqty G A B -> Top ; fjeqtm G a b A -> Top ; fjeqsub D s t G -> Top } ;

c-universe-bound-J : (J : FAJ) -> CDer J -> c-universe-bound-at J = split {
  c-fnil -> tt ;
  c-fext G A pG pA -> tt ;
  c-fid G pG -> tt ;
  c-fcomp T D G s d pT pD pG ps pd -> tt ;
  c-feps G pG -> tt ;
  c-fp G A pG pA -> tt ;
  c-flift D G A s pD pG pA ps -> tt ;
  c-fsec G A a pG pA pa -> tt ;
  c-ftsb D G A s pD pG pA ps -> tt ;
  c-fmsb D G A a s pD pG pA pa ps -> tt ;
  c-fq G A pG pA -> tt ;
  c-fpi G A B pG pA pB -> tt ;
  c-flam G A B b pG pA pB pb -> tt ;
  c-fapp G A B c a pG pA pB pc pa -> tt ;
  c-fuu n G pG bound1 -> bound1 ;
  c-fel n G a pG pa bound1 -> tt ;
  c-fpic n G a b pG pa pb bound1 -> tt ;
  c-fuc m n G pG bound1 bound2 -> tt ;
  c-flf m n G a pG pa bound1 bound2 -> tt ;
  c-fq-idl D G s pD pG ps left right -> tt ;
  c-fq-idr D G s pD pG ps left right -> tt ;
  c-fq-assoc Q T D G s d e pQ pT pD pG ps pd pe left right -> tt ;
  c-fq-eps G s pG ps left right -> tt ;
  c-fe-sb-id G A pG pA left right -> tt ;
  c-fe-sb-comp T D G A s d pT pD pG pA ps pd left right -> tt ;
  c-fm-sb-id G A a pG pA pa left right -> tt ;
  c-fm-sb-comp T D G A a s d pT pD pG pA pa ps pd left right -> tt ;
  c-fq-lift-id G A pG pA left right -> tt ;
  c-fq-lift-comp T D G A s d pT pD pG pA ps pd left right -> tt ;
  c-fq-p-lift D G A s pD pG pA ps left right -> tt ;
  c-fq-p-sec G A a pG pA pa left right -> tt ;
  c-fq-sec-comp D G A a s pD pG pA pa ps left right -> tt ;
  c-fq-lift-p-sec-q G A pG pA left right -> tt ;
  c-fm-q-lift D G A s pD pG pA ps left right -> tt ;
  c-fm-q-sec G A a pG pA pa left right -> tt ;
  c-fe-pi-sb D G A B s pD pG pA pB ps left right -> tt ;
  c-fm-lam-sb D G A B b s pD pG pA pB pb ps left right -> tt ;
  c-fm-app-sb D G A B c a s pD pG pA pB pc pa ps left right -> tt ;
  c-fm-beta G A B b a pG pA pB pb pa left right -> tt ;
  c-fm-eta G A B f pG pA pB pf left right -> tt ;
  c-fe-uu-sb n D G s pD pG ps bound1 left right -> tt ;
  c-fe-el-sb n D G a s pD pG pa ps bound1 left right -> tt ;
  c-fm-pic-sb n D G a b s pD pG pa pb ps bound1 left right -> tt ;
  c-fm-uc-sb m n D G s pD pG ps bound1 bound2 left right -> tt ;
  c-fm-lf-sb m n D G a s pD pG pa ps bound1 bound2 left right -> tt ;
  c-fe-el-pic n G a b pG pa pb bound1 left right -> tt ;
  c-fe-el-uc m n G pG bound1 bound2 left right -> tt ;
  c-fe-el-lf m n G a pG pa bound1 bound2 left right -> tt ;
  c-fm-lf-pic n p G a b pG pa pb bound1 bound2 left right -> tt ;
  c-fm-lf-uc m n p G pG bound1 bound2 bound3 left right -> tt ;
  c-fm-lf-lf m n p G a pG pa bound1 bound2 bound3 left right -> tt ;
  c-refl-ctx x h -> tt ;
  c-sym-ctx x y h -> tt ;
  c-trans-ctx x y z h k -> tt ;
  c-refl-sub D G x h -> tt ;
  c-sym-sub D G x y h -> tt ;
  c-trans-sub D G x y z h k -> tt ;
  c-refl-ty G x h -> tt ;
  c-sym-ty G x y h -> tt ;
  c-trans-ty G x y z h k -> tt ;
  c-refl-tm G A x h -> tt ;
  c-sym-tm G A x y h -> tt ;
  c-trans-tm G A x y z h k -> tt ;
  c-eq-fext G A G' A' pG pA -> tt ;
  c-eq-fid G G' pG -> tt ;
  c-eq-fcomp T D G s d T' D' G' s' d' pT pD pG ps pd -> tt ;
  c-eq-feps G G' pG -> tt ;
  c-eq-fp G A G' A' pG pA -> tt ;
  c-eq-flift D G A s D' G' A' s' pD pG pA ps -> tt ;
  c-eq-fsec G A a G' A' a' pG pA pa -> tt ;
  c-eq-ftsb D G A s D' G' A' s' pD pG pA ps -> tt ;
  c-eq-fmsb D G A a s D' G' A' a' s' pD pG pA pa ps -> tt ;
  c-eq-fq G A G' A' pG pA -> tt ;
  c-eq-fpi G A B G' A' B' pG pA pB -> tt ;
  c-eq-flam G A B b G' A' B' b' pG pA pB pb -> tt ;
  c-eq-fapp G A B c a G' A' B' c' a' pG pA pB pc pa -> tt ;
  c-eq-fuu n G G' pG bound1 -> tt ;
  c-eq-fel n G a G' a' pG pa bound1 -> tt ;
  c-eq-fpic n G a b G' a' b' pG pa pb bound1 -> tt ;
  c-eq-fuc m n G G' pG bound1 bound2 -> tt ;
  c-eq-flf m n G a G' a' pG pa bound1 bound2 -> tt ;
  c-conv-ty G H x eG h | _ r-h -> r-h ;
  c-eqconv-ty G H x y eG h -> tt ;
  c-conv-sub D G E H x eD eG h -> tt ;
  c-eqconv-sub D G E H x y eD eG h -> tt ;
  c-conv-tm G A H B x eG eA h -> tt ;
  c-eqconv-tm G A H B x y eG eA h -> tt } ;
