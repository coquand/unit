-- Recover the bound even when the annotation has been transported.
a-universe-level : GA -> U l = split {
  anil -> Top ;
  aext G A -> Top ;
  api A B -> Top ;
  auu n G -> LeN n N ;
  ael n a -> Top ;
  asb t s -> Top ;
  alam A B b -> Top ;
  aapp A B c a -> Top ;
  apic n a b -> Top ;
  auc m n G -> Top ;
  alf m n a -> Top ;
  aq G A -> Top ;
  aid G -> Top ;
  acomp s d -> Top ;
  aeps G -> Top ;
  ap G A -> Top ;
  alift A s -> Top ;
  asec A a -> Top } ;
a-universe-bound-at : GAJ -> U l = split {
  ajwf G -> Top ;
  ajty G A -> a-universe-level A ;
  ajtm G a A -> Top ;
  ajsub D s G -> Top ;
  ajeqcx G D -> Top ;
  ajeqty G A B -> Top ;
  ajeqtm G a b A -> Top ;
  ajeqsub D s t G -> Top } ;
a-universe-bound-J : (J : GAJ) -> GADer J -> a-universe-bound-at J = split {
  a-nil -> tt ;
  a-ext G A h -> tt ;
  ac-nil -> tt ;
  ac-refl G h -> tt ;
  ac-ext G D A B h1 h2 -> tt ;
  as-id G h -> tt ;
  as-comp T D G s d h1 h2 -> tt ;
  as-eps G h -> tt ;
  as-p G A h -> tt ;
  as-lift D G A s h1 h2 -> tt ;
  as-sec G A a h1 h2 -> tt ;
  as-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  at-pi G A B h1 h2 -> tt ;
  at-uu G n h nb -> nb ;
  at-el G n a h -> tt ;
  at-sb D G A s h1 h2 -> tt ;
  at-cx G D A h0 h1 h2 | r0 r1 r2 -> r2 ;
  am-lam G A B b h1 h2 h3 -> tt ;
  am-app G A B c a h1 h2 h3 h4 -> tt ;
  am-pic G n a b h1 h2 -> tt ;
  am-uc G m n h lt nb -> tt ;
  am-lf G m n a h le nb -> tt ;
  am-q G A h -> tt ;
