-- Lifting the code of a dependent product. Splitting the domain code
-- identifies its index type on both sides. The fibre indices are matched
-- by raise and lower, and the functions are compared by their graphs.
level k l ;
constraint k <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module S = IterativeSets[k] ;
module W = IterativeSets[l] ;
module L = IterativeSetLift[k,l] ;
open IterativeSetPaths[l] ;
open IterativeLiftLaws[k,l] ;

module Product (A : U k) (f : A -> S.M) (h : S.isIt (sup A f)) (B : A -> S.V) {
  x : S.V = (sup A f,h) ;
  y : W.V = L.liftV x ;
  liftB (a : A) : W.V = L.liftV (B a) ;

  SmallFunctions : U k = (a : A) -> S.Ix (B a) ;
  LargeFunctions : U l = (a : A) -> W.Ix (liftB a) ;

  up (phi : SmallFunctions) : LargeFunctions = \ a -> raise (B a) (phi a) ;
  down (psi : LargeFunctions) : SmallFunctions = \ a -> lower (B a) (psi a) ;

  graph-lift (phi : SmallFunctions) (psi : LargeFunctions)
      (p : (a : A) -> Id W.V (L.liftV (S.ev (B a) (phi a))) (W.ev (liftB a) (psi a))) :
      Id W.V (L.liftV (S.graph x B phi)) (W.graph y liftB psi) =
    code-path (L.liftV (S.graph x B phi)) (W.graph y liftB psi)
      (apH (\ g -> sup A g)
        (funext A (\ a -> W.M)
          (\ a -> (L.liftV (S.pairV (S.ev x a) (S.ev (B a) (phi a)))).1)
          (\ a -> (W.pairV (W.ev y a) (W.ev (liftB a) (psi a))).1) member-path))
   where {
    member-path (a : A) :
        Id W.M (L.liftV (S.pairV (S.ev x a) (S.ev (B a) (phi a)))).1
          (W.pairV (W.ev y a) (W.ev (liftB a) (psi a))).1 =
      apH (\ z -> z.1)
        (transH (lift-pair (S.ev x a) (S.ev (B a) (phi a)))
          (transH (apH (\ z -> W.pairV z (L.liftV (S.ev (B a) (phi a)))) (lift-member x a))
            (apH (W.pairV (W.ev y a)) (p a)))) ;
   } ;

  product-path : Id W.V (L.liftV (S.PiV x B)) (W.PiV y liftB) =
    reindex-code (L.liftV (S.PiV x B)) (W.PiV y liftB) up down
      (\ phi -> transH (symH (lift-member (S.PiV x B) phi))
        (graph-lift phi (up phi) (\ a -> lift-member (B a) (phi a))))
      (\ psi -> transH (symH (lift-member (S.PiV x B) (down psi)))
        (graph-lift (down psi) psi (\ a -> lift-member-lower (B a) (psi a)))) ;
} ;

lift-pi-M : (x : S.M) -> (h : S.isIt x) -> (B : W.Idx (L.liftM x) -> S.V) ->
    Id W.V (L.liftV (S.PiV (x,h) (\ a -> B (raise (x,h) a))))
      (W.PiV (L.liftV (x,h)) (\ a -> L.liftV (B a))) = split {
  sup A f -> \ h B -> Product[A,f,h,B].product-path } ;

lift-pi (x : S.V) (B : W.Ix (L.liftV x) -> S.V) :
    Id W.V (L.liftV (S.PiV x (\ a -> B (raise x a))))
      (W.PiV (L.liftV x) (\ a -> L.liftV (B a))) =
  lift-pi-M x.1 x.2 B ;
