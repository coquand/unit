-- InitHomId: the identity morphism M -> M.  Every law holds by refl:
-- with ctx the identity, ctx-ext and ty-univ are refl, so the transports
-- mv-ty, mv-el, code, dec-ext and mv-code compute to their arguments.
-- Segment of InitHomIdentity.Identity (l, N, M).
open Base ;
open Prelude[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
module Mo = InitHom.Morphism[l,N,M,M] ;
open Mo.InitHomBase ;
open Mo.InitHomLaws ;

idHom : Hom = new Hom[
  ctx := \ G -> G,
  sub := \ D G s -> s,
  ty := \ G A -> A,
  tm := \ G A a -> a,
  ctx-nil := refl C.nil,
  ctx-ext := \ G A -> refl (C.ext G A),
  sub-id := \ G -> refl (C.id G),
  sub-o := \ T D G s s' -> refl (C.o T D G s s'),
  sub-eps := \ G -> refl (G, (C.nil, C.eps G)),
  sub-p := \ G A -> refl (C.ext G A, (G, C.p G A)),
  sub-lift := \ D G A s -> refl (C.ext D (C.subT D G A s), (C.ext G A, C.lift D G A s)),
  sub-sec := \ G A a -> refl (G, (C.ext G A, C.sec G A a)),
  ty-subT := \ D G A s -> refl (C.subT D G A s),
  ty-Pi := \ G A B -> refl (P.Pi G A B),
  ty-univ := \ n G -> refl (M.univ n G),
  ty-decode := \ n G a -> refl (M.decode n G a),
  tm-subt := \ D G A a s -> refl (C.subT D G A s, C.subt D G A a s),
  tm-q := \ G A -> refl (C.ext G A, (C.subT (C.ext G A) G A (C.p G A), C.q G A)),
  tm-lam := \ G A B b -> refl (P.Pi G A B, (P.Pi-iso G A B).inv b),
  tm-pic := \ n G a b -> refl (M.pic n G a b),
  tm-uc := \ m n lt G -> refl (M.uc m n lt G),
  tm-lf := \ m n lt G a -> refl (M.lf m n lt G a)] ;

-- every morphism agrees with itself
agree-refl (H : Hom) : Agree[H,H] = new Agree[H, H,
  ctx-ag := \ G -> refl (H.ctx G),
  ty-ag := \ G A -> refl (H.ctx G, H.ty G A),
  tm-ag := \ G A a -> refl (H.ctx G, (H.ty G A, H.tm G A a)),
  sub-ag := \ D G s -> refl (H.ctx D, (H.ctx G, H.sub D G s))] ;
