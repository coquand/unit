-- Universe equations with endpoints converted by earlier universe equations.
level l ;
open Base ; open Lib[l] ; open TTyping[l] ; open FGAT[l] ; open CGAT[l] ;
open CTyping[l] ; open CAxiomBase[l] ; open CAxiomAction[l] ;

use-c-fe-el-sb (n : Nat) (D G a s : FA) (wD : W D) (wG : W G)
    (ha : Tm' G a (fuu n G)) (hs : Sb D s G) (nb : LeN n N) :
    TE D (ftsb D G (fel n G a) s) (fel n D (fmsb D G (fuu n G) a s)) =
  c-fe-el-sb n D G a s wD wG ha hs nb (ty-sub (c-fel n G a wG ha nb) hs)
    (c-fel n D (fmsb D G (fuu n G) a s) wD (sub-universe n nb ha hs) nb) ;

use-c-fm-uc-sb (m n : Nat) (D G s : FA) (wD : W D) (wG : W G) (hs : Sb D s G)
    (lt : LeN (suc m) n) (nb : LeN n N) :
    CDer (fjeqtm D (fmsb D G (fuu n G) (fuc m n G) s) (fuc m n D) (fuu n D)) =
  c-fm-uc-sb m n D G s wD wG hs lt nb
    (sub-universe n {D} {G} {fuc m n G} {s} nb (c-fuc m n G wG lt nb) hs) (c-fuc m n D wD lt nb) ;

use-c-fm-lf-sb (m n : Nat) (D G a s : FA) (wD : W D) (wG : W G) (ha : Tm' G a (fuu m G)) (hs : Sb D s G)
    (lt : LeN (suc m) n) (nb : LeN n N) :
    CDer (fjeqtm D (fmsb D G (fuu n G) (flf m n G a) s) (flf m n D (fmsb D G (fuu m G) a s)) (fuu n D)) =
  c-fm-lf-sb m n D G a s wD wG ha hs lt nb
    (sub-universe n {D} {G} {flf m n G a} {s} nb (c-flf m n G a wG ha lt nb) hs)
    (c-flf m n D (fmsb D G (fuu m G) a s) wD (sub-universe m mb ha hs) lt nb)
 where { mb : LeN m N = leN-trans m n N (lt-le m n lt) nb ; } ;

use-c-fm-pic-sb (n : Nat) (D G a b s : FA) (wD : W D) (wG : W G)
    (ha : Tm' G a (fuu n G)) (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a))))
    (hs : Sb D s G) (nb : LeN n N) :
    CDer (fjeqtm D (fmsb D G (fuu n G) (fpic n G a b) s)
      (fpic n D (fmsb D G (fuu n G) a s)
        (fmsb (fext D (ftsb D G (fel n G a) s)) (fext G (fel n G a)) (fuu n (fext G (fel n G a))) b
          (flift D G (fel n G a) s))) (fuu n D)) =
  c-fm-pic-sb n D G a b s wD wG ha hb hs nb
    (sub-universe n {D} {G} {fpic n G a b} {s} nb (c-fpic n G a b wG ha hb nb) hs)
    (c-fpic n D a' b' wD ha' (move-universe n {E} {E'} {b'} contexts nb hb') nb)
 where {
  L : FA = fext G (fel n G a) ;
  E : FA = fext D (ftsb D G (fel n G a) s) ;
  a' : FA = fmsb D G (fuu n G) a s ;
  E' : FA = fext D (fel n D a') ;
  lift : Sb E (flift D G (fel n G a) s) L = lift-sub (c-fel n G a wG ha nb) hs ;
  b' : FA = fmsb E L (fuu n L) b (flift D G (fel n G a) s) ;
  ha' : Tm' D a' (fuu n D) = sub-universe n nb ha hs ;
  hb' : Tm' E b' (fuu n E) = sub-universe n nb hb lift ;
  contexts : CE E E' = c-eq-fext D (ftsb D G (fel n G a) s) D (fel n D a')
    (cx-refl wD) (use-c-fe-el-sb n D G a s wD wG ha hs nb) ;
 } ;

use-c-fm-lf-pic (n p : Nat) (G a b : FA) (wG : W G)
    (ha : Tm' G a (fuu n G)) (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a))))
    (lt : LeN (suc n) p) (pb : LeN p N) :
    CDer (fjeqtm G (flf n p G (fpic n G a b))
      (fpic p G (flf n p G a) (flf n p (fext G (fel n G a)) b)) (fuu p G)) =
  c-fm-lf-pic n p G a b wG ha hb lt pb
    (c-flf n p G (fpic n G a b) wG (c-fpic n G a b wG ha hb nb) lt pb)
    (c-fpic p G a' b' wG ha' (move-universe p {E} {E'} {b'} contexts pb hb') pb)
 where {
  nb : LeN n N = leN-trans n p N (lt-le n p lt) pb ;
  E : FA = fext G (fel n G a) ;
  a' : FA = flf n p G a ;
  E' : FA = fext G (fel p G a') ;
  b' : FA = flf n p E b ;
  ha' : Tm' G a' (fuu p G) = c-flf n p G a wG ha lt pb ;
  hb' : Tm' E b' (fuu p E) = c-flf n p E b (c-fext G (fel n G a) wG (c-fel n G a wG ha nb)) hb lt pb ;
  contexts : CE E E' = c-eq-fext G (fel n G a) G (fel p G a') (cx-refl wG)
    (c-sym-ty G (fel p G a') (fel n G a) (use-c-fe-el-lf n p G a wG ha lt pb)) ;
 } ;
