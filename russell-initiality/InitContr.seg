-- InitContr.seg (PLAN-INIT, Part C): initiality of the term model in
-- the strong form.  For the Sigma form HomS of morphisms (InitHomSig),
-- the type of morphisms TM -> M is contractible: its centre is the
-- interpretation (InitTheorem.existence), and every morphism equals it
-- (InitTheorem.uniqueness2 and extensionality InitHomExt.hom-ext).
-- Used inside module Contr (l) (M) of InitCheckInitial.seg (free names
-- l, N, M, fe, I).
open Base ; open Prelude[l] ;
module Th = I.Initial[l,M].InitTheorem ;
module MS = InitHomS.MorphismS[l,N,Th.TM,M,fe @l] ;

isContr (A : U l) : U l = (c : A) * ((x : A) -> Id A c x) ;

HomS : U l = MS.InitHomSig.HomS ;

centre : HomS = MS.InitHomSig.toS Th.existence ;

contraction (h : HomS) : Id HomS centre h =
  MS.InitHomExt.hom-ext centre h
    (Th.uniqueness2 (MS.InitHomSig.fromS centre) (MS.InitHomSig.fromS h)) ;

-- the term model is initial: exactly one morphism TM -> M
initiality : isContr HomS = (centre, contraction) ;

-- any two morphisms TM -> M are equal
unique (h h' : HomS) : Id HomS h h' =
  trans HomS h centre h' (sym HomS centre h (contraction h)) (contraction h') ;
