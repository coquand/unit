-- InitExistLawsA.seg (PLAN-INIT, Part E): the structural laws of a
-- morphism (InitHomLaws.Hom) for the interpretation of InitExistMaps,
-- stated over the operations of InitOpsCtx/Sub/Ext (the term model):
--   ex-ctx-nil, tel-ext, ex-ctx-ext, ex-sub-id, ex-sub-o, ex-sub-eps,
--   ex-sub-p, ex-ty-subT, ex-sub-lift, ex-sub-sec, ex-tm-subt, ex-tm-q.
-- Method: pick representatives (the target is a path in a set), turn the
-- operation into the class of its raw expression (the Op*.beta of F),
-- read off the denotation of that raw expression from the *-down lemmas
-- of InitExistMaps, compare with the denotation of the operation of M
-- (TEInterpIntro), and conclude by functionality.
-- Segment of InitCheckE.InitE.Exist (l, M).
open Base ; open Prelude[l] ; open Paths[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
module S = TEInterp.Interpret[l,N,M] ;
open S.TEInterpBase ;
open S.TEDenote ;
open S.TEInterpIntro ;
module J = S.TEInterpJudgement ;
open InitExistBase ;
open InitExistMaps ;

set-SubT0 : isSet SubT0 =
  isSet-Sigma C.Ctx (\ X -> (Y : C.Ctx) * C.Sub X Y) M.isSetCtx
    (\ X -> isSet-Sigma C.Ctx (C.Sub X) M.isSetCtx (C.isSetSub X)) ;
set-TmT0 : isSet TmT0 =
  isSet-Sigma C.Ctx (\ X -> (A : C.Ty X) * C.El X A) M.isSetCtx
    (\ X -> isSet-Sigma (C.Ty X) (C.El X) (C.isSetTy X) (C.isSetEl X)) ;

-- abbreviations: the image of a context class
hctx (c : Ctx) : C.Ctx = ctx (tel c) ;

------------------------------------------------------------------------
-- contexts

ex-ctx-nil : Id C.Ctx (hctx nil) C.nil =
  ap Tel C.Ctx (\ g -> ctx g) (tel nil) empty-tel
    (J.ctx-functional gnil (tel nil) empty-tel (tel-down nil gnil nil-w (refl nil)) empty-down) ;

tel-ext (c : Ctx) (A : Ty c) : Id Tel (tel (ext c A)) (extend (tel c) (hty c A)) =
  sq-rec (RepTy c A) (Id Tel (tel (ext c A)) (extend (tel c) (hty c A)))
    (tel-set (tel (ext c A)) (extend (tel c) (hty c A)))
    (\ r -> J.ctx-functional (gext (rtG c A r) (rtA c A r)) (tel (ext c A)) (extend (tel c) (hty c A))
      (tel-down (ext c A) (gext (rtG c A r) (rtA c A r)) (ext-der c A r) (ext-beta' c A r (ext-der c A r)))
      (ext-down (rtG c A r) (rtA c A r) (tel c) (hty c A) (tel-down c (rtG c A r) (rtW c A r) (rtP c A r))
        (hty-down-r c A r)))
    (rep-ty c A) ;

ex-ctx-ext (c : Ctx) (A : Ty c) : Id C.Ctx (hctx (ext c A)) (C.ext (hctx c) (hty c A)) =
  ap Tel C.Ctx (\ g -> ctx g) (tel (ext c A)) (extend (tel c) (hty c A)) (tel-ext c A) ;

------------------------------------------------------------------------
-- substitutions

ex-sub-id (c : Ctx) : Id (C.Sub (hctx c) (hctx c)) (hsub c c (id c)) (C.id (hctx c)) =
  sq-rec (RepCtx c) (Id (C.Sub (hctx c) (hctx c)) (hsub c c (id c)) (C.id (hctx c)))
    (C.isSetSub (hctx c) (hctx c) (hsub c c (id c)) (C.id (hctx c)))
    (\ r -> sub-fn gid (tel c) (tel c) (hsub c c (id c)) (C.id (hctx c))
      (hsub-down c c (id c) r.1 gid r.1 (OpId[c].der r) r.2.1 r.2.1 r.2.2 r.2.2
        (sym (Sub c c) (id c) (OpId[c].f r) (OpId[c].beta r)))
      (id-down (tel c)))
    (rep-ctx c) ;

ex-sub-o (t d c : Ctx) (s : Sub d c) (s' : Sub t d) :
  Id (C.Sub (hctx t) (hctx c)) (hsub t c (o t d c s s'))
    (C.o (hctx t) (hctx d) (hctx c) (hsub d c s) (hsub t d s')) =
  sq-rec (RepSub d c s * RepSub t d s')
    (Id (C.Sub (hctx t) (hctx c)) (hsub t c (o t d c s s')) (C.o (hctx t) (hctx d) (hctx c) (hsub d c s) (hsub t d s')))
    (C.isSetSub (hctx t) (hctx c) (hsub t c (o t d c s s')) (C.o (hctx t) (hctx d) (hctx c) (hsub d c s) (hsub t d s')))
    (\ x -> sub-fn (gcomp (rss d c s x.1) (rss t d s' x.2)) (tel t) (tel c) (hsub t c (o t d c s s'))
      (C.o (hctx t) (hctx d) (hctx c) (hsub d c s) (hsub t d s'))
      (hsub-down t c (o t d c s s') (rsD t d s' x.2) (gcomp (rss d c s x.1) (rss t d s' x.2)) (rsG d c s x.1)
        (OpComp[t,d,c,s,s'].der x) (rsWD t d s' x.2) (rsWG d c s x.1) (rsPD t d s' x.2) (rsPG d c s x.1)
        (sym (Sub t c) (o t d c s s') (OpComp[t,d,c,s,s'].f x) (OpComp[t,d,c,s,s'].beta x)))
      (comp-down (rss d c s x.1) (rss t d s' x.2) (tel t) (tel d) (tel c) (hsub d c s) (hsub t d s')
        (hsub-down-r d c s x.1) (hsub-down-r t d s' x.2)))
    (OpComp[t,d,c,s,s'].reps) ;

ex-sub-eps (c : Ctx) :
  Id SubT0 (hctx c, (hctx nil, hsub c nil (eps c))) (hctx c, (C.nil, C.eps (hctx c))) =
  sq-rec (RepCtx c) (Id SubT0 (hctx c, (hctx nil, hsub c nil (eps c))) (hctx c, (C.nil, C.eps (hctx c))))
    (set-SubT0 (hctx c, (hctx nil, hsub c nil (eps c))) (hctx c, (C.nil, C.eps (hctx c))))
    (\ r -> sub-tot geps (tel c) (tel c) (refl (tel c)) (tel nil) empty-tel (hsub c nil (eps c)) (C.eps (hctx c))
      (hsub-down c nil (eps c) r.1 geps gnil (OpEps[c].der r) r.2.1 nil-w r.2.2 (refl nil)
        (sym (Sub c nil) (eps c) (OpEps[c].f r) (OpEps[c].beta r)))
      (eps-down (tel c)))
    (rep-ctx c) ;

ex-sub-p (c : Ctx) (A : Ty c) :
  Id SubT0 (hctx (ext c A), (hctx c, hsub (ext c A) c (p c A)))
    (C.ext (hctx c) (hty c A), (hctx c, C.p (hctx c) (hty c A))) =
  sq-rec (RepTy c A)
    (Id SubT0 (hctx (ext c A), (hctx c, hsub (ext c A) c (p c A))) (C.ext (hctx c) (hty c A), (hctx c, C.p (hctx c) (hty c A))))
    (set-SubT0 (hctx (ext c A), (hctx c, hsub (ext c A) c (p c A))) (C.ext (hctx c) (hty c A), (hctx c, C.p (hctx c) (hty c A))))
    (\ r -> sub-tot gp (tel (ext c A)) (extend (tel c) (hty c A)) (tel-ext c A) (tel c) (tel c)
      (hsub (ext c A) c (p c A)) (C.p (hctx c) (hty c A))
      (hsub-down-r (ext c A) c (p c A) (p-rep c A r)) (p-down (tel c) (hty c A)))
    (rep-ty c A) ;

------------------------------------------------------------------------
-- substitution in types

ex-ty-subT (d c : Ctx) (A : Ty c) (s : Sub d c) :
  Id (C.Ty (hctx d)) (hty d (subT d c A s)) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)) =
  sq-rec (RepTy c A * RepSub d c s)
    (Id (C.Ty (hctx d)) (hty d (subT d c A s)) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)))
    (C.isSetTy (hctx d) (hty d (subT d c A s)) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)))
    (\ x -> ty-fn (gsb (rtA c A x.1) (rss d c s x.2)) (tel d) (hty d (subT d c A s))
      (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s))
      (hty-down-r d (subT d c A s) (subT-rep d c A s x.1 x.2))
      (ty-sub-down (rtA c A x.1) (rss d c s x.2) (tel d) (tel c) (hty c A) (hsub d c s)
        (hty-down-r c A x.1) (hsub-down-r d c s x.2)))
    (OpSubT[d,c,A,s].reps) ;

------------------------------------------------------------------------
-- lift and section

-- the telescope of ext d (subT d c A s)
tel-ext-sub (d c : Ctx) (A : Ty c) (s : Sub d c) :
  Id Tel (tel (ext d (subT d c A s))) (extend (tel d) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s))) =
  trans Tel (tel (ext d (subT d c A s))) (extend (tel d) (hty d (subT d c A s)))
    (extend (tel d) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)))
    (tel-ext d (subT d c A s))
    (ap (C.Ty (hctx d)) Tel (\ T -> extend (tel d) T) (hty d (subT d c A s))
      (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)) (ex-ty-subT d c A s)) ;

module ExLift (d c : Ctx) (A : Ty c) (s : Sub d c) {
  E : Ctx = ext d (subT d c A s) ;
  lhs : SubT0 = (hctx E, (hctx (ext c A), hsub E (ext c A) (lift d c A s))) ;
  rhs : SubT0 = (C.ext (hctx d) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)),
                 (C.ext (hctx c) (hty c A), C.lift (hctx d) (hctx c) (hty c A) (hsub d c s))) ;
  step (x : RepTy c A * RepSub d c s) : Id SubT0 lhs rhs =
    sub-tot (glift (rtA c A x.1) (rss d c s x.2)) (tel E)
      (extend (tel d) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s))) (tel-ext-sub d c A s)
      (tel (ext c A)) (extend (tel c) (hty c A))
      (hsub E (ext c A) (lift d c A s)) (C.lift (hctx d) (hctx c) (hty c A) (hsub d c s))
      (hsub-down E (ext c A) (lift d c A s)
        (gext (rsD d c s x.2) (gsb (rtA c A x.1) (rss d c s x.2))) (glift (rtA c A x.1) (rss d c s x.2))
        (gext (rsG d c s x.2) (rtA c A x.1)) (OpLift[d,c,A,s].der x)
        (ext-der d (subT d c A s) (OpLift[d,c,A,s].rS x)) (ext-der c A (OpLift[d,c,A,s].rA' x))
        (ext-beta' d (subT d c A s) (OpLift[d,c,A,s].rS x) (ext-der d (subT d c A s) (OpLift[d,c,A,s].rS x)))
        (ext-beta' c A (OpLift[d,c,A,s].rA' x) (ext-der c A (OpLift[d,c,A,s].rA' x)))
        (sym (Sub E (ext c A)) (lift d c A s) (OpLift[d,c,A,s].f x) (OpLift[d,c,A,s].beta x)))
      (lift-down (rtA c A x.1) (rss d c s x.2) (tel d) (tel c) (hty c A) (hsub d c s)
        (hty-down-r c A x.1) (hsub-down-r d c s x.2)) ;
  result : Id SubT0 lhs rhs =
    sq-rec (RepTy c A * RepSub d c s) (Id SubT0 lhs rhs) (set-SubT0 lhs rhs) step (OpLift[d,c,A,s].reps) ;
} ;

ex-sub-lift (d c : Ctx) (A : Ty c) (s : Sub d c) :
  Id SubT0 (hctx (ext d (subT d c A s)), (hctx (ext c A), hsub (ext d (subT d c A s)) (ext c A) (lift d c A s)))
    (C.ext (hctx d) (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s)),
     (C.ext (hctx c) (hty c A), C.lift (hctx d) (hctx c) (hty c A) (hsub d c s))) =
  ExLift[d,c,A,s].result ;

module ExSec (c : Ctx) (A : Ty c) (a : El c A) {
  lhs : SubT0 = (hctx c, (hctx (ext c A), hsub c (ext c A) (sec c A a))) ;
  rhs : SubT0 = (hctx c, (C.ext (hctx c) (hty c A), C.sec (hctx c) (hty c A) (htm c A a))) ;
  step (r : RepEl c A a) : Id SubT0 lhs rhs =
    sub-tot (gsec (reA c A a r) (rea c A a r)) (tel c) (tel c) (refl (tel c))
      (tel (ext c A)) (extend (tel c) (hty c A))
      (hsub c (ext c A) (sec c A a)) (C.sec (hctx c) (hty c A) (htm c A a))
      (hsub-down c (ext c A) (sec c A a) (reG c A a r) (gsec (reA c A a r) (rea c A a r))
        (gext (reG c A a r) (reA c A a r)) (OpSec[c,A,a].der r) (reW c A a r) (ext-der c A (re-ty c A a r))
        (reP c A a r) (ext-beta' c A (re-ty c A a r) (ext-der c A (re-ty c A a r)))
        (sym (Sub c (ext c A)) (sec c A a) (OpSec[c,A,a].f r) (OpSec[c,A,a].beta r)))
      (sec-down (reA c A a r) (rea c A a r) (tel c) (hty c A) (htm c A a)
        (hty-down-r c A (re-ty c A a r)) (htm-down-r c A a r)) ;
  result : Id SubT0 lhs rhs = sq-rec (RepEl c A a) (Id SubT0 lhs rhs) (set-SubT0 lhs rhs) step (rep-el c A a) ;
} ;

ex-sub-sec (c : Ctx) (A : Ty c) (a : El c A) :
  Id SubT0 (hctx c, (hctx (ext c A), hsub c (ext c A) (sec c A a)))
    (hctx c, (C.ext (hctx c) (hty c A), C.sec (hctx c) (hty c A) (htm c A a))) =
  ExSec[c,A,a].result ;

------------------------------------------------------------------------
-- terms: substitution and the variable

module ExSubt (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) {
  lhs : Term (tel d) = (hty d (subT d c A s), htm d (subT d c A s) (subt d c A a s)) ;
  rhs : Term (tel d) = (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s),
                        C.subt (hctx d) (hctx c) (hty c A) (htm c A a) (hsub d c s)) ;
  step (x : RepEl c A a * RepSub d c s) : Id (Term (tel d)) lhs rhs =
    J.tm-functional (gsb (rea c A a x.1) (rss d c s x.2)) (tel d) lhs rhs
      (htm-down d (subT d c A s) (subt d c A a s) (rsD d c s x.2) (gsb (reA c A a x.1) (rss d c s x.2))
        (gsb (rea c A a x.1) (rss d c s x.2)) (OpSubt[d,c,A,a,s].der x) (OpSubt[d,c,A,a,s].derT x)
        (rsWD d c s x.2) (rsPD d c s x.2) (OpSubt[d,c,A,a,s].pT x)
        (sym (El d (subT d c A s)) (subt d c A a s) (OpSubt[d,c,A,a,s].f x) (OpSubt[d,c,A,a,s].beta x)))
      (tm-sub-down (rea c A a x.1) (rss d c s x.2) (tel d) (tel c) (hty c A) (htm c A a) (hsub d c s)
        (htm-down-r c A a x.1) (hsub-down-r d c s x.2)) ;
  result : Id (Term (tel d)) lhs rhs =
    sq-rec (RepEl c A a * RepSub d c s) (Id (Term (tel d)) lhs rhs) (term-set (tel d) lhs rhs) step
      (OpSubt[d,c,A,a,s].reps) ;
} ;

ex-tm-subt (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) :
  Id (Term (tel d)) (hty d (subT d c A s), htm d (subT d c A s) (subt d c A a s))
    (C.subT (hctx d) (hctx c) (hty c A) (hsub d c s), C.subt (hctx d) (hctx c) (hty c A) (htm c A a) (hsub d c s)) =
  ExSubt[d,c,A,a,s].result ;

module ExQ (c : Ctx) (A : Ty c) {
  E : Ctx = ext c A ;
  T : Ty E = subT E c A (p c A) ;
  lhs : TmT0 = (hctx E, (hty E T, htm E T (q c A))) ;
  rhs : TmT0 = (C.ext (hctx c) (hty c A),
                (C.subT (C.ext (hctx c) (hty c A)) (hctx c) (hty c A) (C.p (hctx c) (hty c A)), C.q (hctx c) (hty c A))) ;
  step (r : RepTy c A) : Id TmT0 lhs rhs =
    tm-tot gq (tel E) (extend (tel c) (hty c A)) (tel-ext c A) (hty E T) (htm E T (q c A))
      (q-type (tel c) (hty c A)) (C.q (hctx c) (hty c A))
      (htm-down E T (q c A) (gext (rtG c A r) (rtA c A r)) (gsb (rtA c A r) gp) gq (OpQ[c,A].der r) (OpQ[c,A].derT r)
        (ext-der c A r) (ext-beta' c A r (ext-der c A r)) (OpQ[c,A].pT r)
        (sym (El E T) (q c A) (OpQ[c,A].f r) (OpQ[c,A].beta r)))
      (q-down (tel c) (hty c A)) ;
  result : Id TmT0 lhs rhs = sq-rec (RepTy c A) (Id TmT0 lhs rhs) (set-TmT0 lhs rhs) step (rep-ty c A) ;
} ;

ex-tm-q (c : Ctx) (A : Ty c) :
  Id TmT0 (hctx (ext c A), (hty (ext c A) (subT (ext c A) c A (p c A)), htm (ext c A) (subT (ext c A) c A (p c A)) (q c A)))
    (C.ext (hctx c) (hty c A),
     (C.subT (C.ext (hctx c) (hty c A)) (hctx c) (hty c A) (C.p (hctx c) (hty c A)), C.q (hctx c) (hty c A))) =
  ExQ[c,A].result ;
