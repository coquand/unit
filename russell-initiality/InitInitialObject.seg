-- InitInitialObject (PLAN-INIT, Part C): the term model TM is an initial
-- object of the precategory of models of level N (InitModelsCat.pre).
-- Used inside module Initial2 (l) of InitCheckInitial.seg (free names
-- l, N, fe, I, Contr).
module MC = InitHomS.ModelsCat[l,N,fe @l].InitModelsCat ;

TM : MC.pre.ob = I.InitModel[l].TM ;

tm-initial : MC.isInitial TM = \ M -> Contr[l,M].InitContr.initiality ;
