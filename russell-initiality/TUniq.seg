-- Lemma 25.1

qstep (N : Nat) (ih : Hyp N) (G : Cx) : (A B : Tm) -> LeN (add (sz A) (sz B)) (suc N) ->
    Der (jty G A) -> Der (jty G B) -> Id Tm (er A) (er B) -> Der (jeqty G A B) = split {
  var i0 -> \ B h dA dB e -> efq (genty-ty G (var i0) dA) ;
  pi A0 B0 -> split {
    var i1 -> \ h dA dB e -> efq (genty-ty G (var i1) dB) ;
    pi A1 B1 -> \ h dA dB e -> q-pi G A0 B0 A1 B1 (genty-ty G (pi A0 B0) dA) (genty-ty G (pi A1 B1) dB)
      (ih.1 G A0 A1 (mLR (sz (pi A0 B0)) (sz (pi A1 B1)) (sz A0) (sz A1) N (add-le-l (sz A0) (sz B0)) (le-suc-r (sz A1) (add (sz A1) (sz B1)) (add-le-l (sz A1) (sz B1))) h) (genty-ty G (pi A0 B0) dA).1 (genty-ty G (pi A1 B1) dB).1 (inj p1 (er (pi A0 B0)) (er (pi A1 B1)) e))
      (\ x y -> ih.1 (csnoc G A0) B0 B1 (mLR (sz (pi A0 B0)) (sz (pi A1 B1)) (sz B0) (sz B1) N (add-le-r (sz A0) (sz B0)) (le-suc-r (sz B1) (add (sz A1) (sz B1)) (add-le-r (sz A1) (sz B1))) h) x y (inj p2 (er (pi A0 B0)) (er (pi A1 B1)) e)) ;
    lam A1 B1 b1 -> \ h dA dB e -> efq (genty-ty G (lam A1 B1 b1) dB) ;
    app A1 B1 c1 a1 -> \ h dA dB e -> efq (genty-ty G (app A1 B1 c1 a1) dB) ;
    uu n1 -> \ h dA dB e -> efq (noconf (er (pi A0 B0)) (er (uu n1)) e tt) ;
    el n1 a1 -> \ h dA dB e -> ih.2.1 G (pi A0 B0) a1 n1 (mRL (sz (pi A0 B0)) (sz (el n1 a1)) (sz (pi A0 B0)) (sz a1) N (leN-refl (sz (pi A0 B0))) (leN-refl (sz a1)) h) dA (genty-ty G (el n1 a1) dB) e ;
    pic n1 a1 b1 -> \ h dA dB e -> efq (genty-ty G (pic n1 a1 b1) dB) ;
    uc m1 n1 -> \ h dA dB e -> efq (genty-ty G (uc m1 n1) dB) ;
    lf m1 n1 a1 -> \ h dA dB e -> efq (genty-ty G (lf m1 n1 a1) dB) } ;
  lam A0 B0 b0 -> \ B h dA dB e -> efq (genty-ty G (lam A0 B0 b0) dA) ;
  app A0 B0 c0 a0 -> \ B h dA dB e -> efq (genty-ty G (app A0 B0 c0 a0) dA) ;
  uu n0 -> split {
    var i1 -> \ h dA dB e -> efq (genty-ty G (var i1) dB) ;
    pi A1 B1 -> \ h dA dB e -> efq (noconf (er (uu n0)) (er (pi A1 B1)) e tt) ;
    lam A1 B1 b1 -> \ h dA dB e -> efq (genty-ty G (lam A1 B1 b1) dB) ;
    app A1 B1 c1 a1 -> \ h dA dB e -> efq (genty-ty G (app A1 B1 c1 a1) dB) ;
    uu n1 -> \ h dA dB e -> q-uu G n0 n1 dA (injN (er (uu n0)) (er (uu n1)) e) ;
    el n1 a1 -> \ h dA dB e -> ih.2.1 G (uu n0) a1 n1 (mRL (sz (uu n0)) (sz (el n1 a1)) (sz (uu n0)) (sz a1) N (leN-refl (sz (uu n0))) (leN-refl (sz a1)) h) dA (genty-ty G (el n1 a1) dB) e ;
    pic n1 a1 b1 -> \ h dA dB e -> efq (genty-ty G (pic n1 a1 b1) dB) ;
    uc m1 n1 -> \ h dA dB e -> efq (genty-ty G (uc m1 n1) dB) ;
    lf m1 n1 a1 -> \ h dA dB e -> efq (genty-ty G (lf m1 n1 a1) dB) } ;
  el n0 a0 -> split {
    var i1 -> \ h dA dB e -> efq (genty-ty G (var i1) dB) ;
    pi A1 B1 -> \ h dA dB e -> eqty-sym G (pi A1 B1) (el n0 a0) (ih.2.1 G (pi A1 B1) a0 n0 (le-comm (sz a0) (sz (pi A1 B1)) N h) dB (genty-ty G (el n0 a0) dA) (sym Tm (er a0) (er (pi A1 B1)) e)) ;
    lam A1 B1 b1 -> \ h dA dB e -> efq (genty-ty G (lam A1 B1 b1) dB) ;
    app A1 B1 c1 a1 -> \ h dA dB e -> efq (genty-ty G (app A1 B1 c1 a1) dB) ;
    uu n1 -> \ h dA dB e -> eqty-sym G (uu n1) (el n0 a0) (ih.2.1 G (uu n1) a0 n0 (le-comm (sz a0) (sz (uu n1)) N h) dB (genty-ty G (el n0 a0) dA) (sym Tm (er a0) (er (uu n1)) e)) ;
    el n1 a1 -> \ h dA dB e -> ih.2.1 G (el n0 a0) a1 n1 (mRL (sz (el n0 a0)) (sz (el n1 a1)) (sz (el n0 a0)) (sz a1) N (leN-refl (sz (el n0 a0))) (leN-refl (sz a1)) h) dA (genty-ty G (el n1 a1) dB) e ;
    pic n1 a1 b1 -> \ h dA dB e -> efq (genty-ty G (pic n1 a1 b1) dB) ;
    uc m1 n1 -> \ h dA dB e -> efq (genty-ty G (uc m1 n1) dB) ;
    lf m1 n1 a1 -> \ h dA dB e -> efq (genty-ty G (lf m1 n1 a1) dB) } ;
  pic n0 a0 b0 -> \ B h dA dB e -> efq (genty-ty G (pic n0 a0 b0) dA) ;
  uc m0 n0 -> \ B h dA dB e -> efq (genty-ty G (uc m0 n0) dA) ;
  lf m0 n0 a0 -> \ B h dA dB e -> efq (genty-ty G (lf m0 n0 a0) dA) } ;

------------------------------------------------------------------------
-- the induction on N

hyp0 : Hyp zero =
  (\ G A B h dA dB e -> efq (sz-nz A B h),
   (\ G B a n h dB da e -> efq (sz-nz B a h),
    \ G u0 u1 A0 A1 h d0 d1 e -> efq (sz-nz u0 u1 h))) ;

uniq : (N : Nat) -> Hyp N = split {
  zero -> hyp0 ;
  suc N | r -> (qstep N r, (estep N r, tstep N r)) } ;

------------------------------------------------------------------------
-- Lemma 25

ty-uniq (G : Cx) (A B : Tm) (hA : Der (jty G A)) (hB : Der (jty G B)) (e : Id Tm (er A) (er B)) : Der (jeqty G A B) =
  (uniq (add (sz A) (sz B))).1 G A B (leN-refl (add (sz A) (sz B))) hA hB e ;

el-uniq (G : Cx) (B a : Tm) (n : Nat) (hB : Der (jty G B)) (ha : Der (jtm G a (uu n))) (e : Id Tm (er B) (er a)) :
    Der (jeqty G B (el n a)) =
  (uniq (add (sz B) (sz a))).2.1 G B a n (leN-refl (add (sz B) (sz a))) hB ha e ;

tm-uniq (G : Cx) (u0 u1 A0 A1 : Tm) (d0 : Der (jtm G u0 A0)) (d1 : Der (jtm G u1 A1)) (e : Id Tm (er u0) (er u1)) :
    TRes G u0 u1 A0 A1 =
  (uniq (add (sz u0) (sz u1))).2.2 G u0 u1 A0 A1 (leN-refl (add (sz u0) (sz u1))) d0 d1 e ;

------------------------------------------------------------------------
-- Corollary 27 (judgemental injectivity of erasure)

er-inj' (G : Cx) (u0 u1 A0 A1 : Tm) (d0 : Der (jtm G u0 A0)) (d1 : Der (jtm G u1 A1)) (e : Id Tm (er u0) (er u1))
    (eA : Der (jeqty G A0 A1)) : Der (jeqty G A0 A1) * Der (jeqtm G u0 u1 A0) =
  (eA, res-same G u0 u1 A0 (tm-uniq G u0 u1 A0 A0 d0 (tm-conv G u1 A1 A0 d1 (eqty-sym G A0 A1 eA)) e)) ;

er-inj (G : Cx) (u0 u1 A0 A1 : Tm) (d0 : Der (jtm G u0 A0)) (d1 : Der (jtm G u1 A1)) (e : Id Tm (er u0) (er u1))
    (eA : Id Tm (er A0) (er A1)) : Der (jeqty G A0 A1) * Der (jeqtm G u0 u1 A0) =
  er-inj' G u0 u1 A0 A1 d0 d1 e (ty-uniq G A0 A1 (presup-tm G u0 A0 d0) (presup-tm G u1 A1 d1) eA) ;
