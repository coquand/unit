------------------------------------------------------------------------
-- Lemma 25.2

estep (N : Nat) (ih : Hyp N) (G : Cx) : (B a : Tm) -> (n : Nat) -> LeN (add (sz B) (sz a)) (suc N) ->
    Der (jty G B) -> Der (jtm G a (uu n)) -> Id Tm (er B) (er a) -> Der (jeqty G B (el n a)) = split {
  var i0 -> \ a n h dB da e -> efq (genty-ty G (var i0) dB) ;
  pi A0 B0 -> split {
    var i1 -> \ n h dB da e -> efq (noconf (er (pi A0 B0)) (er (var i1)) e tt) ;
    pi A1 B1 -> \ n h dB da e -> efq (gen-tm G (pi A1 B1) (uu n) da) ;
    lam A1 B1 b1 -> \ n h dB da e -> efq (noconf (er (pi A0 B0)) (er (lam A1 B1 b1)) e tt) ;
    app A1 B1 c1 a1 -> \ n h dB da e -> efq (noconf (er (pi A0 B0)) (er (app A1 B1 c1 a1)) e tt) ;
    uu n1 -> \ n h dB da e -> efq (gen-tm G (uu n1) (uu n) da) ;
    el n1 a1 -> \ n h dB da e -> efq (gen-tm G (el n1 a1) (uu n) da) ;
    pic n1 a1 b1 -> \ n h dB da e -> e-pi G A0 B0 n1 n a1 b1 (genty-ty G (pi A0 B0) dB) (gen-tm G (pic n1 a1 b1) (uu n) da)
      (ih.2.1 G A0 a1 n1 (mLR (sz (pi A0 B0)) (sz (pic n1 a1 b1)) (sz A0) (sz a1) N (add-le-l (sz A0) (sz B0)) (le-suc-r (sz a1) (add (sz a1) (sz b1)) (add-le-l (sz a1) (sz b1))) h) (genty-ty G (pi A0 B0) dB).1 (gen-tm G (pic n1 a1 b1) (uu n) da).1 (inj p1 (er (pi A0 B0)) (er (pic n1 a1 b1)) e))
      (\ x y -> ih.2.1 (csnoc G A0) B0 b1 n1 (mLR (sz (pi A0 B0)) (sz (pic n1 a1 b1)) (sz B0) (sz b1) N (add-le-r (sz A0) (sz B0)) (le-suc-r (sz b1) (add (sz a1) (sz b1)) (add-le-r (sz a1) (sz b1))) h) x y (inj p2 (er (pi A0 B0)) (er (pic n1 a1 b1)) e)) ;
    uc m1 n1 -> \ n h dB da e -> efq (noconf (er (pi A0 B0)) (er (uc m1 n1)) e tt) ;
    lf m1 n1 a1 -> \ n h dB da e -> e-lf G (pi A0 B0) m1 n1 n a1 (gen-tm G (lf m1 n1 a1) (uu n) da) (ih.2.1 G (pi A0 B0) a1 m1 (mRL (sz (pi A0 B0)) (sz (lf m1 n1 a1)) (sz (pi A0 B0)) (sz a1) N (leN-refl (sz (pi A0 B0))) (leN-refl (sz a1)) h) dB (gen-tm G (lf m1 n1 a1) (uu n) da).1 e) } ;
  lam A0 B0 b0 -> \ a n h dB da e -> efq (genty-ty G (lam A0 B0 b0) dB) ;
  app A0 B0 c0 a0 -> \ a n h dB da e -> efq (genty-ty G (app A0 B0 c0 a0) dB) ;
  uu n0 -> split {
    var i1 -> \ n h dB da e -> efq (noconf (er (uu n0)) (er (var i1)) e tt) ;
    pi A1 B1 -> \ n h dB da e -> efq (gen-tm G (pi A1 B1) (uu n) da) ;
    lam A1 B1 b1 -> \ n h dB da e -> efq (noconf (er (uu n0)) (er (lam A1 B1 b1)) e tt) ;
    app A1 B1 c1 a1 -> \ n h dB da e -> efq (noconf (er (uu n0)) (er (app A1 B1 c1 a1)) e tt) ;
    uu n1 -> \ n h dB da e -> efq (gen-tm G (uu n1) (uu n) da) ;
    el n1 a1 -> \ n h dB da e -> efq (gen-tm G (el n1 a1) (uu n) da) ;
    pic n1 a1 b1 -> \ n h dB da e -> efq (noconf (er (uu n0)) (er (pic n1 a1 b1)) e tt) ;
    uc m1 n1 -> \ n h dB da e -> e-uc G n0 m1 n1 n (gen-tm G (uc m1 n1) (uu n) da) (injN (er (uu n0)) (er (uc m1 n1)) e) ;
    lf m1 n1 a1 -> \ n h dB da e -> e-lf G (uu n0) m1 n1 n a1 (gen-tm G (lf m1 n1 a1) (uu n) da) (ih.2.1 G (uu n0) a1 m1 (mRL (sz (uu n0)) (sz (lf m1 n1 a1)) (sz (uu n0)) (sz a1) N (leN-refl (sz (uu n0))) (leN-refl (sz a1)) h) dB (gen-tm G (lf m1 n1 a1) (uu n) da).1 e) } ;
  el n0 a0 -> \ a n h dB da e ->
    e-el G n0 n a0 a (genty-ty G (el n0 a0) dB) (ih.2.2 G a0 a (uu n0) (uu n) h (genty-ty G (el n0 a0) dB) da e) ;
  pic n0 a0 b0 -> \ a n h dB da e -> efq (genty-ty G (pic n0 a0 b0) dB) ;
  uc m0 n0 -> \ a n h dB da e -> efq (genty-ty G (uc m0 n0) dB) ;
  lf m0 n0 a0 -> \ a n h dB da e -> efq (genty-ty G (lf m0 n0 a0) dB) } ;

