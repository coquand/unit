-- TUniq.seg: the uniqueness lemma of T_Tarski (sterbac4 Lemma 25), its
-- Lemma 26 (TUniqBase.res-same) and Corollary 27 (injectivity of erasure).
--   QS, ES, TS   Lemma 25.1, 25.2, 25.3 for |left| + |right| <= N
--   qstep, estep, tstep   one step of the induction on N: dispatch on the raw
--                shapes, generation lemmas (TGen) instead of recursion on
--                derivations, the cases in TUniqComb
--   ty-uniq, el-uniq, tm-uniq   Lemma 25;  er-inj   Corollary 27
-- (generated by a script; the measure proofs use mLR / mRL / le-comm)

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open TPresup[l] ; open TGen[l] ; open ErR[l] ; open TUniqBase[l] ; open TUniqComb[l] ;

QS (N : Nat) : U l = (G : Cx) -> (A B : Tm) -> LeN (add (sz A) (sz B)) N -> Der (jty G A) -> Der (jty G B) ->
  Id Tm (er A) (er B) -> Der (jeqty G A B) ;
ES (N : Nat) : U l = (G : Cx) -> (B a : Tm) -> (n : Nat) -> LeN (add (sz B) (sz a)) N -> Der (jty G B) -> Der (jtm G a (uu n)) ->
  Id Tm (er B) (er a) -> Der (jeqty G B (el n a)) ;
TS (N : Nat) : U l = (G : Cx) -> (u0 u1 A0 A1 : Tm) -> LeN (add (sz u0) (sz u1)) N -> Der (jtm G u0 A0) -> Der (jtm G u1 A1) ->
  Id Tm (er u0) (er u1) -> TRes G u0 u1 A0 A1 ;
Hyp (N : Nat) : U l = QS N * (ES N * TS N) ;

