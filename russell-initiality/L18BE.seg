wkl-pt (e : Nat -> GE) : GPt (\ i -> up (up e) (Ren.lift (\ j -> suc j) i)) (up (esb e gp)) = split {
  zero -> refl gq ;
  suc j -> refl (gsb (gsb (e j) gp) gp) } ;

ev-wkl (B : Tm) (e : Nat -> GE) : Id GE (ev (wkl B) (up (up e))) (ev B (up (esb e gp))) =
  trans GE (ev (wkl B) (up (up e))) (ev B (\ i -> up (up e) (Ren.lift (\ j -> suc j) i))) (ev B (up (esb e gp)))
    (ev-ren B (up (up e)) (Ren.lift (\ j -> suc j)))
    (ev-ext B (\ i -> up (up e) (Ren.lift (\ j -> suc j) i)) (up (esb e gp)) (wkl-pt e)) ;


