-- InitUniq.seg (PLAN-INIT, Part U): uniqueness of morphisms out of the
-- term model.  For every e : Eqs (Part A: mk e : TEModel[N] has F's
-- operations), every model M' : TEModel[N] and any two morphisms
-- H, H' : Hom (mk e) M' (Part H), Agree[H, H'].
-- Proof: every context, type, term, substitution of the term model is
-- (by quotient induction ctx-ind/ty-ind/el-ind/sub-ind) a class of raw
-- data with a MERE derivation; the goal is a proposition (a path in a set
-- of M'), so the derivation can be taken out of the truncation (sq-rec),
-- and uniq (InitUniqInd, by induction on GDer) gives agreement at the
-- canonical class, moved to the given one by ihT-at/ihE-at/ihS-at.
--   Uq[e,M'].V[H,H'].agree : Agree[H,H']
--   init-uniq e M' H H'   : the same, as a function
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitModelShape[l] ;

module Uq (e : Eqs) (M' : EM.TEModel[N]) {
  module Mo = InitHom.Morphism[l, N, mk e, M'] ;
  module HL = Mo.InitHomLaws ;
  module HS = Mo.InitHomStep ;

  module V (H H' : HL.Hom) {
    module Bs = InitUniqBase[l].Uq[e, M'].V[H, H'] ;
    open Bs ;
    module I = InitUniqInd[l].Uq[e, M'].V[H, H'] ;

    ag-ctx (c : Ctx) : HS.AgC H H' c =
      ctx-ind (\ c0 -> HS.AgC H H' c0) propC
        (\ G w -> sq-rec (GDer (gjwf G)) (HS.AgC H H' (cls G w)) (propC (cls G w))
           (\ d -> I.uniq (gjwf G) d w) w)
        c ;

    ag-ty (c : Ctx) (T : Ty c) : HS.AgT H H' c T =
      ty-ind c (\ T0 -> HS.AgT H H' c T0) (\ T0 -> propT (c, T0))
        (\ G A h w pc -> sq-rec (GDer (gjty G A)) (HS.AgT H H' c (clsTy c G A h w pc)) (propT (c, clsTy c G A h w pc))
           (\ d -> ihT-at G A (I.uniq (gjty G A) d) h w c pc) h)
        T ;

    ag-el (c : Ctx) (T : Ty c) (t : El c T) : HS.AgE H H' c T t =
      el-ind c T (\ t0 -> HS.AgE H H' c T t0) (\ t0 -> propE (c, (T, t0)))
        (\ G A a h hA w pc pT ->
           sq-rec (GDer (gjtm G a A)) (HS.AgE H H' c T (clsEl c T G A a h hA w pc pT))
             (propE (c, (T, clsEl c T G A a h hA w pc pT)))
             (\ d -> ihE-at G a A (I.uniq (gjtm G a A) d) h hA w c pc T pT) h)
        t ;

    ag-sub (d c : Ctx) (s : Sub d c) : HS.AgS H H' d c s =
      sub-ind d c (\ s0 -> HS.AgS H H' d c s0) (\ s0 -> propS (d, (c, s0)))
        (\ D s0 G h wD wG pd pc ->
           sq-rec (GDer (gjsub D s0 G)) (HS.AgS H H' d c (clsSub d c D s0 G h wD wG pd pc))
             (propS (d, (c, clsSub d c D s0 G h wD wG pd pc)))
             (\ k -> ihS-at D s0 G (I.uniq (gjsub D s0 G) k) h wD wG d c pd pc) h)
        s ;

    agree : HL.Agree[H, H'] = HS.mkAgree H H' ag-ctx ag-ty ag-el ag-sub ;
  } ;
} ;

init-uniq (e : Eqs) (M' : EM.TEModel[N])
  (H H' : InitHom.Morphism[l, N, mk e, M'].InitHomLaws.Hom) :
  InitHom.Morphism[l, N, mk e, M'].InitHomLaws.Agree[H, H'] =
  Uq[e, M'].V[H, H'].agree ;
