-- Russell correspondence through the completely annotated Ehrhard GAT.
level l ;
open Base ; open TSyntax[l] ; open TTyping[l] ; open RTyping[l] ;
open AGAT[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ; open FCtx[l] ;
open FForget[l] ; open FLiftExpr[l] ; open FAnnotBase[l] ; open FAnnot[l] ;
module Annotated = ARGAT[l] ;

fC (G : FA) : Cx = Annotated.aC (ff G) ;
fT (A : FA) : Tm = Annotated.aT (ff A) ;

FWf (G : Cx) : U l = (X : FA) * (W X * Id Cx (fC X) G) ;
FTy (G : Cx) (A : Tm) : U l =
  (X Y : FA) * (Ty X Y * (Id Cx (fC X) G * Id Tm (fT Y) A)) ;
FTm (G : Cx) (a A : Tm) : U l =
  (X y Y : FA) * (Tm' X y Y * (Id Cx (fC X) G * (Id Tm (fT y) a * Id Tm (fT Y) A))) ;
FEqTy (G : Cx) (A B : Tm) : U l =
  (X Y Z : FA) * (TE X Y Z * (Id Cx (fC X) G * (Id Tm (fT Y) A * Id Tm (fT Z) B))) ;
FEqTm (G : Cx) (a b A : Tm) : U l =
  (X y z Y : FA) * (ME X y z Y * (Id Cx (fC X) G * (Id Tm (fT y) a * (Id Tm (fT z) b * Id Tm (fT Y) A)))) ;

-- Existence through ARGAT and full annotation.
lift-cx-image (G : Cx) (X : GA) (c : LiftExpr[X]) (e : Id Cx (Annotated.aC X) G) : Id Cx (fC c.t) G =
  Prelude[l].trans Cx (fC c.t) (Annotated.aC X) G (Prelude[l].ap GA Cx Annotated.aC (ff c.t) X c.image) e ;

lift-tm-image (A : Tm) (X : GA) (t : LiftExpr[X]) (e : Id Tm (Annotated.aT X) A) : Id Tm (fT t.t) A =
  Prelude[l].trans Tm (fT t.t) (Annotated.aT X) A (Prelude[l].ap GA Tm Annotated.aT (ff t.t) X t.image) e ;

r2f-wf (G : Cx) (h : RDer (jwf G)) : FWf G =
  (q.e.t, (q.ok, lift-cx-image G r.1 q.e r.2.2))
  where {
    r : Annotated.AWf G = Annotated.r2a-wf G h ;
    q : LiftCx[r.1] = annotate (ajwf r.1) r.2.1 ;
  } ;

r2f-ty (G : Cx) (A : Tm) (h : RDer (jty G A)) : FTy G A =
  (q.c.e.t, (q.a.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.1, lift-tm-image A r.2.1 q.a r.2.2.2.2))))
  where {
    r : Annotated.ATy G A = Annotated.r2a-ty G A h ;
    q : LiftTy[r.1,r.2.1] = annotate (ajty r.1 r.2.1) r.2.2.1 ;
  } ;

r2f-tm (G : Cx) (a A : Tm) (h : RDer (jtm G a A)) : FTm G a A =
  (q.c.e.t, (q.x.t, (q.t.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.2.1,
    (lift-tm-image a r.2.1 q.x r.2.2.2.2.2.1, lift-tm-image A r.2.2.1 q.t r.2.2.2.2.2.2))))))
  where {
    r : Annotated.ATm G a A = Annotated.r2a-tm G a A h ;
    q : LiftTm[r.1,r.2.1,r.2.2.1] = annotate (ajtm r.1 r.2.1 r.2.2.1) r.2.2.2.1 ;
  } ;

r2f-eqty (G : Cx) (A B : Tm) (h : RDer (jeqty G A B)) : FEqTy G A B =
  (q.c.e.t, (q.a.t, (q.b.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.2.1,
    (lift-tm-image A r.2.1 q.a r.2.2.2.2.2.1, lift-tm-image B r.2.2.1 q.b r.2.2.2.2.2.2))))))
  where {
    r : Annotated.AEqTy G A B = Annotated.r2a-eqty G A B h ;
    q : LiftTE[r.1,r.2.1,r.2.2.1] = annotate (ajeqty r.1 r.2.1 r.2.2.1) r.2.2.2.1 ;
  } ;

r2f-eqtm (G : Cx) (a b A : Tm) (h : RDer (jeqtm G a b A)) : FEqTm G a b A =
  (q.c.e.t, (q.x.t, (q.y.t, (q.t.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.2.2.1,
    (lift-tm-image a r.2.1 q.x r.2.2.2.2.2.2.1,
      (lift-tm-image b r.2.2.1 q.y r.2.2.2.2.2.2.2.1, lift-tm-image A r.2.2.2.1 q.t r.2.2.2.2.2.2.2.2))))))))
  where {
    r : Annotated.AEqTm G a b A = Annotated.r2a-eqtm G a b A h ;
    q : LiftME[r.1,r.2.1,r.2.2.1,r.2.2.2.1] = annotate (ajeqtm r.1 r.2.1 r.2.2.1 r.2.2.2.1) r.2.2.2.2.1 ;
  } ;

-- Erase a full derivation through ARGAT.
f2r-wf (G : FA) (h : W G) : RDer (jwf (fC G)) =
  Annotated.a2r-wf (ff G) (forget-full (fjwf G) h) ;
f2r-ty (G A : FA) (h : Ty G A) : RDer (jty (fC G) (fT A)) =
  Annotated.a2r-ty (ff G) (ff A) (forget-full (fjty G A) h) ;
f2r-tm (G a A : FA) (h : Tm' G a A) : RDer (jtm (fC G) (fT a) (fT A)) =
  Annotated.a2r-tm (ff G) (ff a) (ff A) (forget-full (fjtm G a A) h) ;
f2r-eqty (G A B : FA) (h : TE G A B) : RDer (jeqty (fC G) (fT A) (fT B)) =
  Annotated.a2r-eqty (ff G) (ff A) (ff B) (forget-full (fjeqty G A B) h) ;
f2r-eqtm (G a b A : FA) (h : ME G a b A) : RDer (jeqtm (fC G) (fT a) (fT b) (fT A)) =
  Annotated.a2r-eqtm (ff G) (ff a) (ff b) (ff A) (forget-full (fjeqtm G a b A) h) ;

given-expr (A : FA) : LiftExpr[ff A] = new LiftExpr[ff A,t := A,image := refl (ff A)] ;
given-cx (G : FA) (w : W G) : LiftCx[ff G] = put-wf (ff G) (given-expr G) w ;

reflect-eqty (G A B : FA) (hA : Ty G A) (hB : Ty G B) (d : GADer (ajeqty (ff G) (ff A) (ff B))) : TE G A B =
  fe-trans G A q.a.t B
    (ty-align (ff G) (ff A) c (given-expr A) q.a hA p.2.1)
    (fe-trans G q.a.t q.b.t B q.d (ty-align (ff G) (ff B) c q.b (given-expr B) p.2.2 hB))
  where {
    c : LiftCx[ff G] = given-cx G (fpresup (fjty G A) hA) ;
    q : LiftTE[ff G,ff A,ff B,c] = annotate-at (ajeqty (ff G) (ff A) (ff B)) d c ;
    p : FPJ (fjeqty G q.a.t q.b.t) = fpresup (fjeqty G q.a.t q.b.t) q.d ;
  } ;

reflect-eqtm (G a b A : FA) (ha : Tm' G a A) (hb : Tm' G b A)
    (d : GADer (ajeqtm (ff G) (ff a) (ff b) (ff A))) : ME G a b A =
  fm-trans G a q.x.t b A (tm-align (ff G) (ff a) (ff A) c (given-expr a) q.x (given-expr A) ha p.2.2.1)
    (fm-trans G q.x.t q.y.t b A at-A
      (tm-align (ff G) (ff b) (ff A) c q.y (given-expr b) (given-expr A) p.2.2.2 hb))
  where {
    pr : FPJ (fjtm G a A) = fpresup (fjtm G a A) ha ;
    c : LiftCx[ff G] = given-cx G pr.1 ;
    q : LiftME[ff G,ff a,ff b,ff A,c] = annotate-at (ajeqtm (ff G) (ff a) (ff b) (ff A)) d c ;
    qt : Ty G q.t.t = (fpresup (fjeqtm G q.x.t q.y.t q.t.t) q.d).2.1 ;
    at-A : ME G q.x.t q.y.t A =
      fm-eqconv G q.x.t q.y.t q.t.t A q.d (ty-align (ff G) (ff A) c q.t (given-expr A) qt pr.2) ;
    p : FPJ (fjeqtm G q.x.t q.y.t A) = fpresup (fjeqtm G q.x.t q.y.t A) at-A ;
  } ;

-- Reflect the equations given by ARGAT and align their full representatives.
fu-ty (G A B : FA) (hA : Ty G A) (hB : Ty G B) (e : Id Tm (fT A) (fT B)) : TE G A B =
  reflect-eqty G A B hA hB
    (Annotated.au-ty (ff G) (ff A) (ff B) (forget-full (fjty G A) hA) (forget-full (fjty G B) hB) e) ;

fu-tm (G a A b B : FA) (ha : Tm' G a A) (hb : Tm' G b B)
    (e : Id Tm (fT a) (fT b)) (eT : Id Tm (fT A) (fT B)) : TE G A B * ME G a b A =
  (types,reflect-eqtm G a b A ha (tm-conv hb (ty-sym types)) q.2)
 where {
  q : GADer (ajeqty (ff G) (ff A) (ff B)) * GADer (ajeqtm (ff G) (ff a) (ff b) (ff A)) =
    Annotated.au-tm (ff G) (ff a) (ff A) (ff b) (ff B) (forget-full (fjtm G a A) ha) (forget-full (fjtm G b B) hb) e eT ;
  types : TE G A B =
    reflect-eqty G A B (fpresup (fjtm G a A) ha).2 (fpresup (fjtm G b B) hb).2 q.1 ;
 } ;

fu-cx1 (G H : FA) (wG : W G) (wH : W H) (e : Id Cx (fC G) (fC H)) : CE G H =
  (annotate-at (ajeqcx (ff G) (ff H))
    (Annotated.au-cx1 (ff G) (ff H) (forget-full (fjwf G) wG) (forget-full (fjwf H) wH) e)
    (given-cx G wG) (given-cx H wH)).d ;

fu-eqty (G A B A' B' : FA) (h : TE G A B) (k : TE G A' B')
    (eA : Id Tm (fT A) (fT A')) (eB : Id Tm (fT B) (fT B')) : TE G A A' * TE G B B' =
  (fu-ty G A A' p.2.1 q.2.1 eA,fu-ty G B B' p.2.2 q.2.2 eB)
 where {
  p : FPJ (fjeqty G A B) = fpresup (fjeqty G A B) h ;
  q : FPJ (fjeqty G A' B') = fpresup (fjeqty G A' B') k ;
 } ;

fu-eqtm (G a b A a' b' B : FA) (h : ME G a b A) (k : ME G a' b' B)
    (ea : Id Tm (fT a) (fT a')) (eb : Id Tm (fT b) (fT b')) (eA : Id Tm (fT A) (fT B)) :
    TE G A B * (ME G a a' A * ME G b b' A) =
  (left.1,(left.2,(fu-tm G b A b' B p.2.2.2 q.2.2.2 eb eA).2))
 where {
  p : FPJ (fjeqtm G a b A) = fpresup (fjeqtm G a b A) h ;
  q : FPJ (fjeqtm G a' b' B) = fpresup (fjeqtm G a' b' B) k ;
  left : TE G A B * ME G a a' A = fu-tm G a A a' B p.2.2.1 q.2.2.1 ea eA ;
 } ;
