-- L19Base.seg: preliminaries for Lemma 19 (left inverse modulo conversion).
--   Ctx19 G         |- G, idv an environment for |G| over G, |- G = ceil |G|
--   ctx19-ext       extending a context
--   good-of-sok     a typed T_Tarski substitution is Good (by Lemma 18)
--   enveq-smt       ev (s[d]) e  ~  ev s (ev d e)  (pointwise)

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ; open TSubLib[l] ;
open GAT[l] ; open GSound[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18[l] ;

idv-up : GPt idv (up idv) = split {
  zero -> refl gq ;
  suc i -> refl (gsb (idv i) gp) } ;

bd19 (B : Tm) : Id GE (ceil B) (ev B (up idv)) = ev-ext B idv (up idv) idv-up ;

csG (G : GE) (w : GDer (gjwf G)) : CtxS (ec G) = lemma18 (jwf (ec G)) (wf-from-ok (ec G) (sound (gjwf G) w)) ;
ciG (G : GE) (w : GDer (gjwf G)) : CtxI (ec G) = cs-ci (ec G) (csG G w) ;

l18ty (G A : GE) (h : GDer (gjty G A)) : L18J (jty (ec G) (et A)) = lemma18 (jty (ec G) (et A)) (sound (gjty G A) h) ;
l18tm (G a A : GE) (h : GDer (gjtm G a A)) : L18J (jtm (ec G) (et a) (et A)) =
  lemma18 (jtm (ec G) (et a) (et A)) (sound (gjtm G a A) h) ;

Ctx19 (G : GE) : U l = GDer (gjwf G) * (EnvOk G (ec G) idv * GDer (gjeqcx G (ceilC (ec G)))) ;

ctx19-ext (G X : GE) (c : Ctx19 G) (hX : GDer (gjty G X)) (eX : GDer (gjeqty G X (ceil (et X)))) : Ctx19 (gext G X) =
  (g-ext G X hX,
   ((env-sub G (gext G X) gp c.1 (g-ext G X hX) (gs-p G X hX) (ec G) (ciG G c.1) idv c.2.1,
     gm-conv (gext G X) gq (gsb X gp) (ev (et X) (esb idv gp)) (gm-q G X hX)
       (ge-trans (gext G X) (gsb X gp) (gsb (ceil (et X)) gp) (ev (et X) (esb idv gp))
          (ge-sb (gext G X) G X (ceil (et X)) gp gp hX eX (gs-p G X hX) (gs-p G X hX) (gq-refl (gext G X) gp G (gs-p G X hX)))
          ((l18ty G X hX).2.2.1 G idv (gext G X) gp c.1 (g-ext G X hX) c.2.1 (gs-p G X hX)))),
    gc-ext G (ceilC (ec G)) X (ceil (et X)) c.2.2 eX)) ;

good-of-sok (D : Cx) : (G : Cx) -> (s : Nat -> Tm) -> SOk D G s -> Good D G s = split {
  cnil -> \ s o -> tt ;
  csnoc G A | r -> \ s o ->
    (r (\ i -> s (suc i)) o.1,
     ((lemma18 (jtm D (s zero) (Sub.trav A (\ i -> s (suc i)))) o.2).2.1,
      ((lemma18 (jtm D (s zero) (Sub.trav A (\ i -> s (suc i)))) o.2).2.2.1,
       (lemma18 (jtm D (s zero) (Sub.trav A (\ i -> s (suc i)))) o.2).2.2.2.1))) } ;


enveq-smt (D0 : Cx) (c0 : CtxI D0) (wD0 : Der (jwf D0)) (T : GE) (wT : GDer (gjwf T)) (e : Nat -> GE) (oT : EnvOk T D0 e)
    (D : Cx) (cD : CtxS D) (d : Nat -> Tm) (od : SOk D0 D d) (gd : Good D0 D d) :
    (G : Cx) -> CtxS G -> (s : Nat -> Tm) -> SOk D G s -> EnvEq T G (evs (cmp s d) e) (evs s (evs d e)) = split {
  cnil -> \ c s o -> tt ;
  csnoc G A | r -> \ c s o ->
    (r c.1 (\ i -> s (suc i)) o.1,
     gm-eqconv T (ev (Sub.trav (s zero) d) e) (ev (s zero) (evs d e)) (ev (Sub.trav A (\ i -> s (suc i))) (evs d e)) (ev A (evs (cmp (\ i -> s (suc i)) d) e))
       ((lemma18 (jtm D (s zero) (Sub.trav A (\ i -> s (suc i)))) o.2).2.2.2.2 D0 d c0 gd T e wT oT).2
       (ge-trans T (ev (Sub.trav A (\ i -> s (suc i))) (evs d e)) (ev A (evs (\ i -> s (suc i)) (evs d e))) (ev A (evs (cmp (\ i -> s (suc i)) d) e))
          (c.2.2.2.2 D (\ i -> s (suc i)) (cs-ci D cD) (good-of-sok D G (\ i -> s (suc i)) o.1) T (evs d e) wT (evs-ok D0 c0 T wT e oT D cD d gd)).2
          (c.2.2.2.1 T (evs (\ i -> s (suc i)) (evs d e)) (evs (cmp (\ i -> s (suc i)) d) e) wT
             ((evs-ok D (cs-ci D cD) T wT (evs d e) (evs-ok D0 c0 T wT e oT D cD d gd) G c.1 (\ i -> s (suc i)) (good-of-sok D G (\ i -> s (suc i)) o.1)), ((evs-ok D0 c0 T wT e oT G c.1 (cmp (\ i -> s (suc i)) d) (good-of-sok D0 G (cmp (\ i -> s (suc i)) d) (comp-ok D0 D d od wD0 G (\ i -> s (suc i)) o.1))),
              enveq-sym T wT G (cs-ci G c.1) (evs (cmp (\ i -> s (suc i)) d) e) (evs (\ i -> s (suc i)) (evs d e)) (evs-ok D0 c0 T wT e oT G c.1 (cmp (\ i -> s (suc i)) d) (good-of-sok D0 G (cmp (\ i -> s (suc i)) d) (comp-ok D0 D d od wD0 G (\ i -> s (suc i)) o.1))) (evs-ok D (cs-ci D cD) T wT (evs d e) (evs-ok D0 c0 T wT e oT D cD d gd) G c.1 (\ i -> s (suc i)) (good-of-sok D G (\ i -> s (suc i)) o.1)) (r c.1 (\ i -> s (suc i)) o.1)))))) } ;

------------------------------------------------------------------------
-- environments along context conversion (for gs-cx)

envok-dom (D D' : GE) (wD' : GDer (gjwf D')) (c : GDer (gjeqcx D D')) :
    (X : Cx) -> (e : Nat -> GE) -> EnvOk D X e -> EnvOk D' X e = split {
  cnil -> \ e o -> tt ;
  csnoc X A | r -> \ e o ->
    (r (\ i -> e (suc i)) o.1, gm-cx D D' (e zero) (ev A (\ i -> e (suc i))) wD' c o.2) } ;

enveq-dom (D D' : GE) (wD' : GDer (gjwf D')) (c : GDer (gjeqcx D D')) :
    (X : Cx) -> (e1 e2 : Nat -> GE) -> EnvEq D X e1 e2 -> EnvEq D' X e1 e2 = split {
  cnil -> \ e1 e2 q -> tt ;
  csnoc X A | r -> \ e1 e2 q ->
    (r (\ i -> e1 (suc i)) (\ i -> e2 (suc i)) q.1,
     gm-ecx D D' (e1 zero) (e2 zero) (ev A (\ i -> e1 (suc i))) wD' c q.2) } ;

enveq-cod (D : GE) (wD : GDer (gjwf D)) :
    (X Y : Cx) -> CxEq X Y -> (e1 e2 : Nat -> GE) -> EnvOk D X e1 -> EnvEq D X e1 e2 -> EnvEq D Y e1 e2 = split {
  cnil -> split { cnil -> \ ce e1 e2 o q -> tt ; csnoc Y B -> \ ce e1 e2 o q -> efq ce } ;
  csnoc X A | r -> split {
    cnil -> \ ce e1 e2 o q -> efq ce ;
    csnoc Y B -> \ ce e1 e2 o q ->
      (r Y ce.1 (\ i -> e1 (suc i)) (\ i -> e2 (suc i)) o.1 q.1,
       gm-eqconv D (e1 zero) (e2 zero) (ev A (\ i -> e1 (suc i))) (ev B (\ i -> e1 (suc i))) q.2
         ((lemma18 (jeqty X A B) ce.2).2 D (\ i -> e1 (suc i)) (\ i -> e1 (suc i)) wD
            (o.1, (o.1, enveq-refl D X (\ i -> e1 (suc i)) o.1)))) } } ;
