-- Russell correspondence for the annotated Ehrhard GAT.
-- r2a-* lifts Russell judgements with exact erasure, a2r-* erases them,
-- and au-* proves uniqueness up to conversion.
level l ;
open Base ; open TSyntax[l] ; open TTyping[l] ; open RTyping[l] ;
open GAT[l] ; open RGAT[l] ; open AGAT[l] ; open AForget[l] ;
open APresup[l] ; open ACtx[l] ; open ALiftExpr[l] ; open AAnnotBase[l] ; open AAnnot[l] ;

aC (G : GA) : Cx = dC (fg G) ;
aT (A : GA) : Tm = dT (fg A) ;

AWf (G : Cx) : U l = (X : GA) * (W X * Id Cx (aC X) G) ;
ATy (G : Cx) (A : Tm) : U l =
  (X Y : GA) * (Ty X Y * (Id Cx (aC X) G * Id Tm (aT Y) A)) ;
ATm (G : Cx) (a A : Tm) : U l =
  (X y Y : GA) * (Tm' X y Y * (Id Cx (aC X) G * (Id Tm (aT y) a * Id Tm (aT Y) A))) ;
AEqTy (G : Cx) (A B : Tm) : U l =
  (X Y Z : GA) * (TE X Y Z * (Id Cx (aC X) G * (Id Tm (aT Y) A * Id Tm (aT Z) B))) ;
AEqTm (G : Cx) (a b A : Tm) : U l =
  (X y z Y : GA) * (ME X y z Y * (Id Cx (aC X) G * (Id Tm (aT y) a * (Id Tm (aT z) b * Id Tm (aT Y) A)))) ;

-- Existence factors through the bare Russell lift and A3.
lift-cx-image (G : Cx) (X : GE) (c : LiftExpr[X]) (e : Id Cx (dC X) G) : Id Cx (aC c.t) G =
  Prelude[l].trans Cx (aC c.t) (dC X) G (Prelude[l].ap GE Cx dC (fg c.t) X c.image) e ;

lift-tm-image (A : Tm) (X : GE) (t : LiftExpr[X]) (e : Id Tm (dT X) A) : Id Tm (aT t.t) A =
  Prelude[l].trans Tm (aT t.t) (dT X) A (Prelude[l].ap GE Tm dT (fg t.t) X t.image) e ;

r2a-wf (G : Cx) (h : RDer (jwf G)) : AWf G =
  (q.e.t, (q.ok, lift-cx-image G r.1 q.e r.2.2))
  where {
    r : GWf G = r2g-wf G h ;
    q : LiftCx[r.1] = annotate (gjwf r.1) r.2.1 ;
  } ;

r2a-ty (G : Cx) (A : Tm) (h : RDer (jty G A)) : ATy G A =
  (q.c.e.t, (q.a.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.1, lift-tm-image A r.2.1 q.a r.2.2.2.2))))
  where {
    r : GTy G A = r2g-ty G A h ;
    q : LiftTy[r.1,r.2.1] = annotate (gjty r.1 r.2.1) r.2.2.1 ;
  } ;

r2a-tm (G : Cx) (a A : Tm) (h : RDer (jtm G a A)) : ATm G a A =
  (q.c.e.t, (q.x.t, (q.t.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.2.1,
    (lift-tm-image a r.2.1 q.x r.2.2.2.2.2.1, lift-tm-image A r.2.2.1 q.t r.2.2.2.2.2.2))))))
  where {
    r : GTm G a A = r2g-tm G a A h ;
    q : LiftTm[r.1,r.2.1,r.2.2.1] = annotate (gjtm r.1 r.2.1 r.2.2.1) r.2.2.2.1 ;
  } ;

r2a-eqty (G : Cx) (A B : Tm) (h : RDer (jeqty G A B)) : AEqTy G A B =
  (q.c.e.t, (q.a.t, (q.b.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.2.1,
    (lift-tm-image A r.2.1 q.a r.2.2.2.2.2.1, lift-tm-image B r.2.2.1 q.b r.2.2.2.2.2.2))))))
  where {
    r : GEqTy G A B = r2g-eqty G A B h ;
    q : LiftTE[r.1,r.2.1,r.2.2.1] = annotate (gjeqty r.1 r.2.1 r.2.2.1) r.2.2.2.1 ;
  } ;

r2a-eqtm (G : Cx) (a b A : Tm) (h : RDer (jeqtm G a b A)) : AEqTm G a b A =
  (q.c.e.t, (q.x.t, (q.y.t, (q.t.t, (q.d, (lift-cx-image G r.1 q.c.e r.2.2.2.2.2.1,
    (lift-tm-image a r.2.1 q.x r.2.2.2.2.2.2.1,
      (lift-tm-image b r.2.2.1 q.y r.2.2.2.2.2.2.2.1, lift-tm-image A r.2.2.2.1 q.t r.2.2.2.2.2.2.2.2))))))))
  where {
    r : GEqTm G a b A = r2g-eqtm G a b A h ;
    q : LiftME[r.1,r.2.1,r.2.2.1,r.2.2.2.1] = annotate (gjeqtm r.1 r.2.1 r.2.2.1 r.2.2.2.1) r.2.2.2.2.1 ;
  } ;

-- Erasure factors through A2.
a2r-wf (G : GA) (h : W G) : RDer (jwf (aC G)) =
  g2r-wf (fg G) (forget (ajwf G) h) ;
a2r-ty (G A : GA) (h : Ty G A) : RDer (jty (aC G) (aT A)) =
  g2r-ty (fg G) (fg A) (forget (ajty G A) h) ;
a2r-tm (G a A : GA) (h : Tm' G a A) : RDer (jtm (aC G) (aT a) (aT A)) =
  g2r-tm (fg G) (fg a) (fg A) (forget (ajtm G a A) h) ;
a2r-eqty (G A B : GA) (h : TE G A B) : RDer (jeqty (aC G) (aT A) (aT B)) =
  g2r-eqty (fg G) (fg A) (fg B) (forget (ajeqty G A B) h) ;
a2r-eqtm (G a b A : GA) (h : ME G a b A) : RDer (jeqtm (aC G) (aT a) (aT b) (aT A)) =
  g2r-eqtm (fg G) (fg a) (fg b) (fg A) (forget (ajeqtm G a b A) h) ;

-- Lift bare equations between given annotated endpoints and align their sides.
given-expr (A : GA) : LiftExpr[fg A] = new LiftExpr[fg A,t := A,image := refl (fg A)] ;
given-cx (G : GA) (w : W G) : LiftCx[fg G] = put-wf (fg G) (given-expr G) w ;

reflect-eqty (G A B : GA) (hA : Ty G A) (hB : Ty G B) (d : GDer (gjeqty (fg G) (fg A) (fg B))) : TE G A B =
  ae-trans G A q.a.t B
    (ty-align (fg G) (fg A) c (given-expr A) q.a hA p.2.1)
    (ae-trans G q.a.t q.b.t B q.d (ty-align (fg G) (fg B) c q.b (given-expr B) p.2.2 hB))
  where {
    c : LiftCx[fg G] = given-cx G (apresup (ajty G A) hA) ;
    q : LiftTE[fg G,fg A,fg B,c] = annotate-at (gjeqty (fg G) (fg A) (fg B)) d c ;
    p : APJ (ajeqty G q.a.t q.b.t) = apresup (ajeqty G q.a.t q.b.t) q.d ;
  } ;

reflect-eqtm (G a b A : GA) (ha : Tm' G a A) (hb : Tm' G b A)
    (d : GDer (gjeqtm (fg G) (fg a) (fg b) (fg A))) : ME G a b A =
  am-trans G a q.x.t b A (tm-align (fg G) (fg a) (fg A) c (given-expr a) q.x (given-expr A) ha p.2.2.1)
    (am-trans G q.x.t q.y.t b A at-A
      (tm-align (fg G) (fg b) (fg A) c q.y (given-expr b) (given-expr A) p.2.2.2 hb))
  where {
    pr : APJ (ajtm G a A) = apresup (ajtm G a A) ha ;
    c : LiftCx[fg G] = given-cx G pr.1 ;
    q : LiftME[fg G,fg a,fg b,fg A,c] = annotate-at (gjeqtm (fg G) (fg a) (fg b) (fg A)) d c ;
    qt : Ty G q.t.t = (apresup (ajeqtm G q.x.t q.y.t q.t.t) q.d).2.1 ;
    at-A : ME G q.x.t q.y.t A =
      am-eqconv G q.x.t q.y.t q.t.t A q.d (ty-align (fg G) (fg A) c q.t (given-expr A) qt pr.2) ;
    p : APJ (ajeqtm G q.x.t q.y.t A) = apresup (ajeqtm G q.x.t q.y.t A) at-A ;
  } ;

-- Uniqueness at the Russell image uses the existing bare uniqueness theorem.
au-ty (G A B : GA) (hA : Ty G A) (hB : Ty G B) (e : Id Tm (aT A) (aT B)) : TE G A B =
  reflect-eqty G A B hA hB (gu-ty (fg G) (fg A) (fg B) (forget (ajty G A) hA) (forget (ajty G B) hB) e) ;

au-tm (G a A b B : GA) (ha : Tm' G a A) (hb : Tm' G b B)
    (e : Id Tm (aT a) (aT b)) (eT : Id Tm (aT A) (aT B)) : TE G A B * ME G a b A =
  (types, reflect-eqtm G a b A ha (am-conv G b B A hb (ae-sym G A B types)) q.2)
  where {
    q : GDer (gjeqty (fg G) (fg A) (fg B)) * GDer (gjeqtm (fg G) (fg a) (fg b) (fg A)) =
      gu-tm (fg G) (fg a) (fg A) (fg b) (fg B) (forget (ajtm G a A) ha) (forget (ajtm G b B) hb) e eT ;
    types : TE G A B =
      reflect-eqty G A B (apresup (ajtm G a A) ha).2 (apresup (ajtm G b B) hb).2 q.1 ;
  } ;

au-cx1 (G H : GA) (wG : W G) (wH : W H) (e : Id Cx (aC G) (aC H)) : CE G H =
  (annotate-at (gjeqcx (fg G) (fg H))
    (gu-cx1 (fg G) (fg H) (forget (ajwf G) wG) (forget (ajwf H) wH) e) (given-cx G wG) (given-cx H wH)).d ;

au-eqty (G A B A' B' : GA) (h : TE G A B) (k : TE G A' B')
    (eA : Id Tm (aT A) (aT A')) (eB : Id Tm (aT B) (aT B')) : TE G A A' * TE G B B' =
  (au-ty G A A' p.2.1 q.2.1 eA, au-ty G B B' p.2.2 q.2.2 eB)
  where {
    p : APJ (ajeqty G A B) = apresup (ajeqty G A B) h ;
    q : APJ (ajeqty G A' B') = apresup (ajeqty G A' B') k ;
  } ;

au-eqtm (G a b A a' b' B : GA) (h : ME G a b A) (k : ME G a' b' B)
    (ea : Id Tm (aT a) (aT a')) (eb : Id Tm (aT b) (aT b')) (eA : Id Tm (aT A) (aT B)) :
    TE G A B * (ME G a a' A * ME G b b' A) =
  (left.1, (left.2, (au-tm G b A b' B p.2.2.2 q.2.2.2 eb eA).2))
  where {
    p : APJ (ajeqtm G a b A) = apresup (ajeqtm G a b A) h ;
    q : APJ (ajeqtm G a' b' B) = apresup (ajeqtm G a' b' B) k ;
    left : TE G A B * ME G a a' A = au-tm G a A a' B p.2.2.1 q.2.2.1 ea eA ;
  } ;
