-- InitUniqCls.seg (PLAN-INIT, Part U): for every formation rule of GDer,
-- the operation of the term model applied to the canonical classes of the
-- premises is the canonical class of the conclusion (a path in the total
-- space TotCtx/TotTy/TotTm/TotSub, InitUniqTot).  Each lemma cl-<op> is a
-- beta lemma of Part F (with the representatives rT/rE/rS of the argument
-- classes) followed by tT-/tE-/tS-from; cl-app also uses app-sec-eq.
-- The argument classes (eC, tyB, elB, codeC, codeg, ...) are named here
-- so that the uniqueness cases (InitUniqCase*) use the same terms.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitUniqTot[l] ;

------------------------------------------------------------------------
-- argument classes and their representatives

rA (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) : RepTy (cls G w) (cTy G A hA w) =
  rT (cls G w) G A hA w (refl (cls G w)) ;
rEc (G A a : GE) (ha : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) :
  RepEl (cls G w) (cTy G A hA w) (cEl G A a ha hA w) =
  rE (cls G w) (cTy G A hA w) G A a ha hA w (refl (cls G w)) (refl (cTy G A hA w)) ;
rSc (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) :
  RepSub (cls D wD) (cls G wG) (cSub D s G h wD wG) =
  rS (cls D wD) (cls G wG) D s G h wD wG (refl (cls D wD)) (refl (cls G wG)) ;

-- the extended context and data over it
eC (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) : Ctx = ext (cls G w) (cTy G A hA w) ;
eP (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  Id Ctx (cls (gext G A) wE) (eC G A hA w) =
  ext-beta' (cls G w) (cTy G A hA w) (rA G A hA w) wE ;
tyB (G A B : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  Ty (eC G A hA w) = clsTy (eC G A hA w) (gext G A) B hB wE (eP G A hA w wE) ;
rB (G A B : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  RepTy (eC G A hA w) (tyB G A B hA hB w wE) = rT (eC G A hA w) (gext G A) B hB wE (eP G A hA w wE) ;
elB (G A B b : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hb : Pf (gjtm (gext G A) b B))
  (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) : El (eC G A hA w) (tyB G A B hA hB w wE) =
  clsEl (eC G A hA w) (tyB G A B hA hB w wE) (gext G A) B b hb hB wE (eP G A hA w wE) (refl (tyB G A B hA hB w wE)) ;
rb (G A B b : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hb : Pf (gjtm (gext G A) b B))
  (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) : RepEl (eC G A hA w) (tyB G A B hA hB w wE) (elB G A B b hA hB hb w wE) =
  rE (eC G A hA w) (tyB G A B hA hB w wE) (gext G A) B b hb hB wE (eP G A hA w wE) (refl (tyB G A B hA hB w wE)) ;

-- codes
pUg (n : EM.LevelAt N) (c : Ctx) (G : GE) (hU : Pf (gjty G (guu n.1))) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) :
  Id (Ty c) (clsTy c G (guu n.1) hU w pc) (univ n c) = symH (univ-beta n c G hU w pc) ;
codeg (n : EM.LevelAt N) (c : Ctx) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1)))
  (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) : El c (univ n c) =
  clsEl c (univ n c) G (guu n.1) a ha hU w pc (pUg n c G hU w pc) ;
rcodeg (n : EM.LevelAt N) (c : Ctx) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1)))
  (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) : RepEl c (univ n c) (codeg n c G a ha hU w pc) =
  rE c (univ n c) G (guu n.1) a ha hU w pc (pUg n c G hU w pc) ;
codeC (n : EM.LevelAt N) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1))) (w : Pf (gjwf G)) :
  El (cls G w) (univ n (cls G w)) = codeg n (cls G w) G a ha hU w (refl (cls G w)) ;

------------------------------------------------------------------------
-- contexts

cl-nil (w : Pf (gjwf gnil)) : Id Ctx nil (cls gnil w) = cls-irr gnil nil-w w ;

cl-ext (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  Id Ctx (eC G A hA w) (cls (gext G A) wE) = ext-beta (cls G w) (cTy G A hA w) (rA G A hA w) wE ;

------------------------------------------------------------------------
-- substitutions

cl-id (G : GE) (w w2 : Pf (gjwf G)) (h : Pf (gjsub G gid G)) :
  Id TotSub (cls G w, (cls G w, id (cls G w))) (tS G gid G h w w2) =
  tS-from (cls G w) (cls G w) (id (cls G w)) G gid G h w w2 (refl (cls G w)) (cls-irr G w2 w)
    (id-beta (cls G w) G G h w w2 (refl (cls G w)) (cls-irr G w2 w)) ;

cl-comp (T D G s d : GE) (hs : Pf (gjsub D s G)) (hd : Pf (gjsub T d D))
  (wT : Pf (gjwf T)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) (h : Pf (gjsub T (gcomp s d) G)) :
  Id TotSub (cls T wT, (cls G wG, o (cls T wT) (cls D wD) (cls G wG) (cSub D s G hs wD wG) (cSub T d D hd wT wD)))
    (tS T (gcomp s d) G h wT wG) =
  tS-from (cls T wT) (cls G wG) (o (cls T wT) (cls D wD) (cls G wG) (cSub D s G hs wD wG) (cSub T d D hd wT wD))
    T (gcomp s d) G h wT wG (refl (cls T wT)) (refl (cls G wG))
    (o-beta (cls T wT) (cls D wD) (cls G wG) (cSub D s G hs wD wG) (cSub T d D hd wT wD)
       (rSc D s G hs wD wG) (rSc T d D hd wT wD) T G h wT wG (refl (cls T wT)) (refl (cls G wG))) ;

cl-eps (G : GE) (w : Pf (gjwf G)) (wn : Pf (gjwf gnil)) (h : Pf (gjsub G geps gnil)) :
  Id TotSub (cls G w, (nil, eps (cls G w))) (tS G geps gnil h w wn) =
  tS-from (cls G w) nil (eps (cls G w)) G geps gnil h w wn (refl (cls G w)) (cls-irr gnil wn nil-w)
    (eps-beta (cls G w) G gnil h w wn (refl (cls G w)) (cls-irr gnil wn nil-w)) ;

cl-p (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) (h : Pf (gjsub (gext G A) gp G)) :
  Id TotSub (eC G A hA w, (cls G w, p (cls G w) (cTy G A hA w))) (tS (gext G A) gp G h wE w) =
  tS-from (eC G A hA w) (cls G w) (p (cls G w) (cTy G A hA w)) (gext G A) gp G h wE w
    (eP G A hA w wE) (refl (cls G w))
    (p-beta (cls G w) (cTy G A hA w) (gext G A) G h wE w (eP G A hA w wE) (refl (cls G w))) ;

-- lift: the substituted type and its extension
sT (D G A s : GE) (hA : Pf (gjty G A)) (hs : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) : Ty (cls D wD) =
  subT (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG) ;
sE (D G A s : GE) (hA : Pf (gjty G A)) (hs : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) : Ctx =
  ext (cls D wD) (sT D G A s hA hs wD wG) ;
sP (D G A s : GE) (hA : Pf (gjty G A)) (hs : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (wE : Pf (gjwf (gext D (gsb A s)))) : Id Ctx (cls (gext D (gsb A s)) wE) (sE D G A s hA hs wD wG) =
  ext-beta' (cls D wD) (sT D G A s hA hs wD wG)
    (subT-rep (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG) (rA G A hA wG) (rSc D s G hs wD wG)) wE ;

cl-lift (D G A s : GE) (hA : Pf (gjty G A)) (hs : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (wE1 : Pf (gjwf (gext D (gsb A s)))) (wE2 : Pf (gjwf (gext G A)))
  (h : Pf (gjsub (gext D (gsb A s)) (glift A s) (gext G A))) :
  Id TotSub (sE D G A s hA hs wD wG, (eC G A hA wG, lift (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG)))
    (tS (gext D (gsb A s)) (glift A s) (gext G A) h wE1 wE2) =
  tS-from (sE D G A s hA hs wD wG) (eC G A hA wG) (lift (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG))
    (gext D (gsb A s)) (glift A s) (gext G A) h wE1 wE2 (sP D G A s hA hs wD wG wE1) (eP G A hA wG wE2)
    (lift-beta (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG) (rA G A hA wG) (rSc D s G hs wD wG)
       (gext D (gsb A s)) (gext G A) h wE1 wE2 (sP D G A s hA hs wD wG wE1) (eP G A hA wG wE2)) ;

cl-sec (G A a : GE) (hA : Pf (gjty G A)) (ha : Pf (gjtm G a A)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A)))
  (h : Pf (gjsub G (gsec A a) (gext G A))) :
  Id TotSub (cls G w, (eC G A hA w, sec (cls G w) (cTy G A hA w) (cEl G A a ha hA w))) (tS G (gsec A a) (gext G A) h w wE) =
  tS-from (cls G w) (eC G A hA w) (sec (cls G w) (cTy G A hA w) (cEl G A a ha hA w)) G (gsec A a) (gext G A) h w wE
    (refl (cls G w)) (eP G A hA w wE)
    (sec-beta (cls G w) (cTy G A hA w) (cEl G A a ha hA w) (rEc G A a ha hA w) G (gext G A) h w wE
       (refl (cls G w)) (eP G A hA w wE)) ;

------------------------------------------------------------------------
-- types

cl-subT (D G A s : GE) (hA : Pf (gjty G A)) (hs : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (h : Pf (gjty D (gsb A s))) : Id TotTy (cls D wD, sT D G A s hA hs wD wG) (tT D (gsb A s) h wD) =
  tT-from (cls D wD) (sT D G A s hA hs wD wG) D (gsb A s) h wD (refl (cls D wD))
    (subT-beta (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG) (rA G A hA wG) (rSc D s G hs wD wG)
       D h wD (refl (cls D wD))) ;

cl-Pi (G A B : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A)))
  (h : Pf (gjty G (gpi A B))) :
  Id TotTy (cls G w, Pi (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE)) (tT G (gpi A B) h w) =
  tT-from (cls G w) (Pi (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE)) G (gpi A B) h w (refl (cls G w))
    (Pi-beta (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (rA G A hA w) (rB G A B hA hB w wE) G h w (refl (cls G w))) ;

cl-univ (n : EM.LevelAt N) (G : GE) (w : Pf (gjwf G)) (h : Pf (gjty G (guu n.1))) :
  Id TotTy (cls G w, univ n (cls G w)) (tT G (guu n.1) h w) =
  tT-from (cls G w) (univ n (cls G w)) G (guu n.1) h w (refl (cls G w)) (univ-beta n (cls G w) G h w (refl (cls G w))) ;

cl-decode (n : EM.LevelAt N) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1))) (w : Pf (gjwf G))
  (h : Pf (gjty G (gel n.1 a))) :
  Id TotTy (cls G w, decode n (cls G w) (codeC n G a ha hU w)) (tT G (gel n.1 a) h w) =
  tT-from (cls G w) (decode n (cls G w) (codeC n G a ha hU w)) G (gel n.1 a) h w (refl (cls G w))
    (decode-beta n (cls G w) (codeC n G a ha hU w) (rcodeg n (cls G w) G a ha hU w (refl (cls G w)))
       G h w (refl (cls G w))) ;
