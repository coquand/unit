-- Models of bounded T_E. Context extension and substitutions are in
-- Ehrhard's presentation. Universe equations are paths in the relevant
-- set of types or terms.
level l ;
open Base ;
open Prelude[l] ;
open Lib[l] ;
open EhrhardCwF ;

LevelAt (N : Nat) : U l = (n : Nat) * LeN n N ;
StrictAt (N : Nat) (m n : LevelAt N) : U l = LeN (suc m.1) n.1 ;

-- Reindex a context extension along an equality of its last type.
ext-eq-sub (C : CwF[l]) (G : C.Ctx) (A B : C.Ty G) (e : Id (C.Ty G) A B) :
    C.Sub (C.ext G A) (C.ext G B) =
  idJ (C.Ty G) A (\ B' e' -> C.Sub (C.ext G A) (C.ext G B'))
    (C.id (C.ext G A)) B e ;

record TEModel (N : Nat) {
  cwf : CwF[l] ;
  open cwf ;
  isSetCtx : isSet Ctx ;
  products : PiStr[l,cwf] ;

  univ (n : LevelAt N) (G : Ctx) : Ty G ;
  univ-nat (n : LevelAt N) (D G : Ctx) (s : Sub D G) :
      Id (Ty D) (subT D G (univ n G) s) (univ n D) ;

  code-sub (n : LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s : Sub D G) : El D (univ n D) =
    subst (Ty D) (El D) (subT D G (univ n G) s) (univ n D) (univ-nat n D G s)
      (subt D G (univ n G) a s) ;

  decode (n : LevelAt N) (G : Ctx) (a : El G (univ n G)) : Ty G ;
  decode-nat (n : LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s : Sub D G) :
      Id (Ty D) (subT D G (decode n G a) s) (decode n D (code-sub n D G a s)) ;

  up-code (n : LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s : Sub D G) :
      Sub (ext D (decode n D (code-sub n D G a s))) (ext G (decode n G a)) =
    subst (Ty D) (\ B -> Sub (ext D B) (ext G (decode n G a)))
      (subT D G (decode n G a) s) (decode n D (code-sub n D G a s)) (decode-nat n D G a s)
      (lift D G (decode n G a) s) ;

  pic (n : LevelAt N) (G : Ctx) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) : El G (univ n G) ;
  uc (m n : LevelAt N) (lt : StrictAt N m n) (G : Ctx) : El G (univ n G) ;
  lf (m n : LevelAt N) (lt : StrictAt N m n) (G : Ctx) (a : El G (univ m G)) : El G (univ n G) ;

  el-lf (m n : LevelAt N) (lt : StrictAt N m n) (G : Ctx) (a : El G (univ m G)) :
      Id (Ty G) (decode n G (lf m n lt G a)) (decode m G a) ;
  el-pic (n : LevelAt N) (G : Ctx) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) :
      Id (Ty G) (decode n G (pic n G a b)) (products.Pi G (decode n G a) (decode n (ext G (decode n G a)) b)) ;
  el-uc (m n : LevelAt N) (lt : StrictAt N m n) (G : Ctx) :
      Id (Ty G) (decode n G (uc m n lt G)) (univ m G) ;

  lift-binder (m n : LevelAt N) (lt : StrictAt N m n) (G : Ctx) (a : El G (univ m G)) :
      Sub (ext G (decode n G (lf m n lt G a))) (ext G (decode m G a)) =
    ext-eq-sub cwf G (decode n G (lf m n lt G a)) (decode m G a) (el-lf m n lt G a) ;

  lf-pic (m n : LevelAt N) (lt : StrictAt N m n) (G : Ctx) (a : El G (univ m G))
      (b : El (ext G (decode m G a)) (univ m (ext G (decode m G a)))) :
      Id (El G (univ n G)) (lf m n lt G (pic m G a b))
        (pic n G (lf m n lt G a)
          (lf m n lt (ext G (decode n G (lf m n lt G a)))
            (code-sub m (ext G (decode n G (lf m n lt G a))) (ext G (decode m G a)) b (lift-binder m n lt G a)))) ;
  lf-uc (m n p : LevelAt N) (mn : StrictAt N m n) (np : StrictAt N n p) (mp : StrictAt N m p) (G : Ctx) :
      Id (El G (univ p G)) (lf n p np G (uc m n mn G)) (uc m p mp G) ;
  lf-lf (m n p : LevelAt N) (mn : StrictAt N m n) (np : StrictAt N n p) (mp : StrictAt N m p) (G : Ctx)
      (a : El G (univ m G)) :
      Id (El G (univ p G)) (lf n p np G (lf m n mn G a)) (lf m p mp G a) ;

  pic-nat (n : LevelAt N) (D G : Ctx) (s : Sub D G) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) :
      Id (El D (univ n D)) (code-sub n D G (pic n G a b) s)
        (pic n D (code-sub n D G a s)
          (code-sub n (ext D (decode n D (code-sub n D G a s))) (ext G (decode n G a)) b (up-code n D G a s))) ;
  uc-nat (m n : LevelAt N) (lt : StrictAt N m n) (D G : Ctx) (s : Sub D G) :
      Id (El D (univ n D)) (code-sub n D G (uc m n lt G) s) (uc m n lt D) ;
  lf-nat (m n : LevelAt N) (lt : StrictAt N m n) (D G : Ctx) (s : Sub D G) (a : El G (univ m G)) :
      Id (El D (univ n D)) (code-sub n D G (lf m n lt G a) s) (lf m n lt D (code-sub m D G a s)) ;
} ;
