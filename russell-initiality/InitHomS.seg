-- PLAN-INIT Part C: morphisms of TEModel[N] as a Sigma type, their
-- extensionality, composition and the category laws.
module MorphismS (l : Level) (N : Base.Nat) (M : EhrhardTEModel[l].TEModel[N]) (M' : EhrhardTEModel[l].TEModel[N])
  (fe : Axioms[l].FunExt) {
  import InitHomSig ; import InitHomExt ;
} ;

-- composition M1 -> M2 -> M3
module Composition (l : Level) (N : Base.Nat)
  (M1 : EhrhardTEModel[l].TEModel[N]) (M2 : EhrhardTEModel[l].TEModel[N]) (M3 : EhrhardTEModel[l].TEModel[N])
  (fe : Axioms[l].FunExt) {
  import InitHomComp ;
} ;

-- the category laws, M1 -> M2 -> M3 -> M4
module CatLaws (l : Level) (N : Base.Nat)
  (M1 : EhrhardTEModel[l].TEModel[N]) (M2 : EhrhardTEModel[l].TEModel[N])
  (M3 : EhrhardTEModel[l].TEModel[N]) (M4 : EhrhardTEModel[l].TEModel[N])
  (fe : Axioms[l].FunExt) {
  import InitHomCat ;
} ;

-- the precategory of models of level N
module ModelsCat (l : Level) (N : Base.Nat) (fe : Axioms[l].FunExt) {
  import InitModelsCat ;
} ;
