-- InitHomBase: total spaces of the TARGET model M' and the path lemmas
-- used to state and to use the laws of a morphism M -> M' (PLAN-INIT,
-- Part H).  Segment of InitHom.Morphism (l, N, M, M').
--
-- Total spaces (right-nested pairs):
--   TyT'  = (X : Ctx') * Ty' X                     elements (X, A)
--   Term' X = (A : Ty' X) * El' X A                elements (A, a)
--   TmT'  = (X : Ctx') * Term' X                   elements (X, (A, a))
--   CodT' X = (Y : Ctx') * Sub' X Y,  DomT' Y = (X : Ctx') * Sub' X Y
--   SubT' = (X : Ctx') * CodT' X                   elements (X, (Y, s))
--   CodeT' n = (X : Ctx') * El' X (univ' n X)      elements (X, a)
-- All of them are sets (Ctx' is a set by isSetCtx).
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;

C : CwF[l] = M.cwf ;
C' : CwF[l] = M'.cwf ;

------------------------------------------------------------------------
-- generic lemmas on Sigma types over a set

-- a transport gives a path in the total space
tot-subst (A : U l) (F : A -> U l) (x y : A) (e : Id A x y) (b : F x)
  : Id ((z : A) * F z) (x, b) (y, subst A F x y e b) =
  idJ A x (\ z e1 -> Id ((z1 : A) * F z1) (x, b) (z, subst A F x z e1 b)) (refl (x, b)) y e ;

-- a path in a fibre gives a path in the total space
tot-fib (A : U l) (F : A -> U l) (x : A) (b b' : F x) (p : Id (F x) b b')
  : Id ((z : A) * F z) (x, b) (x, b') =
  ap (F x) ((z : A) * F z) (\ u -> (x, u)) b b' p ;

-- over a set, a path in the total space with the same first components
-- gives a path in the fibre
fib (A : U l) (sA : isSet A) (F : A -> U l) (x : A) (b b' : F x)
    (f : Id ((z : A) * F z) (x, b) (x, b')) : Id (F x) b b' =
  trans (F x) b (subst A F x x (ap ((z : A) * F z) A (\ w -> w.1) (x, b) (x, b') f) b) b'
    (ap (Id A x x) (F x) (\ e -> subst A F x x e b)
        (refl x) (ap ((z : A) * F z) A (\ w -> w.1) (x, b) (x, b') f)
        (sym (Id A x x) (ap ((z : A) * F z) A (\ w -> w.1) (x, b) (x, b') f) (refl x)
             (loop-refl A sA x (ap ((z : A) * F z) A (\ w -> w.1) (x, b) (x, b') f))))
    (Sigma-snd A F x x b b' f) ;

-- the same along a given path of first components
fibe (A : U l) (sA : isSet A) (F : A -> U l) (x y : A) (e : Id A x y) (b : F x) (b' : F y)
    (f : Id ((z : A) * F z) (x, b) (y, b')) : Id (F y) (subst A F x y e b) b' =
  idJ A x (\ z e1 -> (b2 : F z) -> Id ((z1 : A) * F z1) (x, b) (z, b2) -> Id (F z) (subst A F x z e1 b) b2)
    (\ b2 f1 -> fib A sA F x b b2 f1) y e b' f ;

------------------------------------------------------------------------
-- total spaces of M'

Term' (X : C'.Ctx) : U l = (A : C'.Ty X) * C'.El X A ;
TyT' : U l = (X : C'.Ctx) * C'.Ty X ;
TmT' : U l = (X : C'.Ctx) * Term' X ;
CodT' (X : C'.Ctx) : U l = (Y : C'.Ctx) * C'.Sub X Y ;
DomT' (Y : C'.Ctx) : U l = (X : C'.Ctx) * C'.Sub X Y ;
SubT' : U l = (X : C'.Ctx) * CodT' X ;
CodeT' (n : LevelAt N) : U l = (X : C'.Ctx) * C'.El X (M'.univ n X) ;

set-Ctx' : isSet C'.Ctx = M'.isSetCtx ;
set-Term' (X : C'.Ctx) : isSet (Term' X) =
  isSet-Sigma (C'.Ty X) (C'.El X) (C'.isSetTy X) (C'.isSetEl X) ;
set-CodT' (X : C'.Ctx) : isSet (CodT' X) =
  isSet-Sigma C'.Ctx (C'.Sub X) set-Ctx' (C'.isSetSub X) ;
set-DomT' (Y : C'.Ctx) : isSet (DomT' Y) =
  isSet-Sigma C'.Ctx (\ X -> C'.Sub X Y) set-Ctx' (\ X -> C'.isSetSub X Y) ;
set-TyT' : isSet TyT' = isSet-Sigma C'.Ctx C'.Ty set-Ctx' C'.isSetTy ;
set-TmT' : isSet TmT' = isSet-Sigma C'.Ctx Term' set-Ctx' set-Term' ;
set-SubT' : isSet SubT' = isSet-Sigma C'.Ctx CodT' set-Ctx' set-CodT' ;

-- the family of codes of level n over Ctx'
CodeF' (n : LevelAt N) (X : C'.Ctx) : U l = C'.El X (M'.univ n X) ;

-- a code as a term
iota (n : LevelAt N) (w : CodeT' n) : TmT' = (w.1, (M'.univ n w.1, w.2)) ;

------------------------------------------------------------------------
-- moving along a path of contexts of M'

mvTy (X Y : C'.Ctx) (e : Id C'.Ctx X Y) (A : C'.Ty X) : C'.Ty Y =
  subst C'.Ctx C'.Ty X Y e A ;

mvEl (X Y : C'.Ctx) (e : Id C'.Ctx X Y) (A : C'.Ty X) (a : C'.El X A) : C'.El Y (mvTy X Y e A) =
  idJ C'.Ctx X (\ Z e1 -> C'.El Z (mvTy X Z e1 A)) a Y e ;

mvCode (n : LevelAt N) (X Y : C'.Ctx) (e : Id C'.Ctx X Y) (a : CodeF' n X) : CodeF' n Y =
  subst C'.Ctx (CodeF' n) X Y e a ;

-- the moved type / term / code is related to the original in the total space
tot-mvTy (X Y : C'.Ctx) (e : Id C'.Ctx X Y) (A : C'.Ty X)
  : Id TyT' (X, A) (Y, mvTy X Y e A) = tot-subst C'.Ctx C'.Ty X Y e A ;

tot-mvEl (X Y : C'.Ctx) (e : Id C'.Ctx X Y) (A : C'.Ty X) (a : C'.El X A)
  : Id TmT' (X, (A, a)) (Y, (mvTy X Y e A, mvEl X Y e A a)) =
  idJ C'.Ctx X (\ Z e1 -> Id TmT' (X, (A, a)) (Z, (mvTy X Z e1 A, mvEl X Z e1 A a))) (refl (X, (A, a))) Y e ;

tot-mvCode (n : LevelAt N) (X Y : C'.Ctx) (e : Id C'.Ctx X Y) (a : CodeF' n X)
  : Id (CodeT' n) (X, a) (Y, mvCode n X Y e a) = tot-subst C'.Ctx (CodeF' n) X Y e a ;

------------------------------------------------------------------------
-- fibres of the total spaces

fibTy (X : C'.Ctx) (A A' : C'.Ty X) (f : Id TyT' (X, A) (X, A')) : Id (C'.Ty X) A A' =
  fib C'.Ctx set-Ctx' C'.Ty X A A' f ;

fibTm (X : C'.Ctx) (u v : Term' X) (f : Id TmT' (X, u) (X, v)) : Id (Term' X) u v =
  fib C'.Ctx set-Ctx' Term' X u v f ;

fibEl (X : C'.Ctx) (A : C'.Ty X) (a a' : C'.El X A) (f : Id (Term' X) (A, a) (A, a'))
  : Id (C'.El X A) a a' = fib (C'.Ty X) (C'.isSetTy X) (C'.El X) A a a' f ;

-- substitutions: fixed domain, fixed codomain
codPath (X Y1 Y2 : C'.Ctx) (s1 : C'.Sub X Y1) (s2 : C'.Sub X Y2)
    (f : Id SubT' (X, (Y1, s1)) (X, (Y2, s2))) : Id (CodT' X) (Y1, s1) (Y2, s2) =
  fib C'.Ctx set-Ctx' CodT' X (Y1, s1) (Y2, s2) f ;

swapS (u : SubT') : (Y : C'.Ctx) * DomT' Y = (u.2.1, (u.1, u.2.2)) ;

domPath (X1 X2 Y : C'.Ctx) (s1 : C'.Sub X1 Y) (s2 : C'.Sub X2 Y)
    (f : Id SubT' (X1, (Y, s1)) (X2, (Y, s2))) : Id (DomT' Y) (X1, s1) (X2, s2) =
  fib C'.Ctx set-Ctx' DomT' Y (X1, s1) (X2, s2)
    (ap SubT' ((Y1 : C'.Ctx) * DomT' Y1) swapS (X1, (Y, s1)) (X2, (Y, s2)) f) ;

-- codes: iota is injective on paths
iota-inj (n : LevelAt N) (X1 X2 : C'.Ctx) (a1 : CodeF' n X1) (a2 : CodeF' n X2)
    (f : Id TmT' (iota n (X1, a1)) (iota n (X2, a2))) : Id (CodeT' n) (X1, a1) (X2, a2) =
  idJ C'.Ctx X1
    (\ Z e1 -> (a3 : CodeF' n Z) -> Id TmT' (iota n (X1, a1)) (iota n (Z, a3)) -> Id (CodeT' n) (X1, a1) (Z, a3))
    (\ a3 f1 -> tot-fib C'.Ctx (CodeF' n) X1 a1 a3
       (fibEl X1 (M'.univ n X1) a1 a3
          (fibTm X1 (M'.univ n X1, a1) (M'.univ n X1, a3) f1)))
    X2 (ap TmT' C'.Ctx (\ w -> w.1) (iota n (X1, a1)) (iota n (X2, a2)) f) a2 f ;

-- every element over a related type has a related image (used for the
-- derived law of Pi-iso.fun)
lift-el (X : C'.Ctx) (A : C'.Ty X) (a : C'.El X A) (w : TyT') (e : Id TyT' (X, A) w)
  : (a' : C'.El w.1 w.2) * Id TmT' (X, (A, a)) (w.1, (w.2, a')) =
  idJ TyT' (X, A) (\ w1 e1 -> (a' : C'.El w1.1 w1.2) * Id TmT' (X, (A, a)) (w1.1, (w1.2, a')))
    (a, refl (X, (A, a))) w e ;

P : PiStr[l,C] = M.products ;
P' : PiStr[l,C'] = M'.products ;
