-- Soundness of substitution formation and congruence.
open Base ; open Prelude[l] ; open Paths[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpJudgement ; open B.GAT[l] ;

case-gs-id (G : GE) (r : SoundJ (gjwf G)) : SoundJ (gjsub G gid G) =
  (r,(r,\ d g hd hg -> at-context G (\ v -> SubValue d v gid) (d,hd) (C.id (ctx d),id-down d) g hg)) ;

case-gs-eps (G : GE) (r : SoundJ (gjwf G)) : SoundJ (gjsub G geps gnil) =
  (r,((empty-tel,empty-down),\ d g hd hg -> at-context gnil (\ v -> SubValue d v geps)
    (empty-tel,empty-down) (C.eps (ctx d),eps-down d) g hg)) ;

case-gs-comp (T D G s t : GE) (r : SoundJ (gjsub D s G)) (p : SoundJ (gjsub T t D)) :
    SoundJ (gjsub T (gcomp s t) G) =
  (p.1,(r.2.1,\ e g he hg -> build e g (r.2.2 r.1.1 g r.1.2 hg) (p.2.2 e r.1.1 he r.1.2)))
 where {
  build (e g : Tel) (u : SubValue r.1.1 g s) (v : SubValue e r.1.1 t) : SubValue e g (gcomp s t) =
    (C.o (ctx e) (ctx r.1.1) (ctx g) u.1 v.1, comp-down s t e r.1.1 g u.1 v.1 u.2 v.2) ;
 } ;

case-gs-p (G A : GE) (r : SoundJ (gjty G A)) : SoundJ (gjsub (gext G A) gp G) =
  (extension-value G A r,(r.1,\ d g hd hg -> build d g hd hg (r.2 g hg)))
 where {
  build (d g : Tel) (hd : CtxDown (gext G A) d) (hg : CtxDown G g) (a : TypeValue g A) : SubValue d g gp =
    at-context (gext G A) (\ v -> SubValue v g gp)
      (extension-witness G A g hg a.1 a.2) (C.p (ctx g) a.1,p-down g a.1) d hd ;
 } ;

case-gm-q (G A : GE) (r : SoundJ (gjty G A)) : SoundJ (gjtm (gext G A) gq (gsb A gp)) =
  (w,at-context (gext G A) (\ g -> TermValue g (gsb A gp) gq) w
    (q-type r.1.1 v.1,
      (ty-sub-down A gp w.1 r.1.1 v.1 (C.p (ctx r.1.1) v.1) v.2 (p-down r.1.1 v.1),
       (C.q (ctx r.1.1) v.1,q-down r.1.1 v.1))))
 where {
  v : TypeValue r.1.1 A = r.2 r.1.1 r.1.2 ;
  w : CtxValue (gext G A) = extension-witness G A r.1.1 r.1.2 v.1 v.2 ;
 } ;

case-gs-sec (G A a : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjtm G a A)) :
    SoundJ (gjsub G (gsec A a) (gext G A)) =
  (r.1,(extension-value G A r,\ d g hd hg -> build d g hd hg (r.2 d hd) (p.2 d hd)))
 where {
  build (d g : Tel) (hd : CtxDown G d) (hg : CtxDown (gext G A) g)
      (a' : TypeValue d A) (v : TermValue d A a) : SubValue d g (gsec A a) =
    at-context (gext G A) (\ z -> SubValue d z (gsec A a))
      (extension-witness G A d hd a'.1 a'.2)
      (C.sec (ctx d) a'.1 k.1,sec-down A a d a'.1 k.1 a'.2 k.2) g hg
   where { k : TermAt d a'.1 a = at-type d A a a'.1 a'.2 v ; } ;
 } ;

case-gs-lift (D G A s : GE) (r : SoundJ (gjsub D s G)) (p : SoundJ (gjty G A)) :
    SoundJ (gjsub (gext D (gsb A s)) (glift A s) (gext G A)) =
  (wd,(wg,at-contexts (gext D (gsb A s)) (gext G A) (\ d' g' -> SubValue d' g' (glift A s)) wd wg
    (C.lift (ctx d) (ctx g) a.1 f.1, lift-down A s d g a.1 f.1 a.2 f.2)))
 where {
  d : Tel = r.1.1 ;
  g : Tel = r.2.1.1 ;
  f : SubValue d g s = r.2.2 d g r.1.2 r.2.1.2 ;
  a : TypeValue g A = p.2 g r.2.1.2 ;
  wd : CtxValue (gext D (gsb A s)) = extension-witness D (gsb A s) d r.1.2 (C.subT (ctx d) (ctx g) a.1 f.1)
    (ty-sub-down A s d g a.1 f.1 a.2 f.2) ;
  wg : CtxValue (gext G A) = extension-witness G A g r.2.1.2 a.1 a.2 ;
 } ;

case-gt-sb (D G A s : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjsub D s G)) : SoundJ (gjty D (gsb A s)) =
  (p.1,\ d hd -> build d (p.2.2 d g hd r.1.2))
 where {
  g : Tel = r.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  build (d : Tel) (f : SubValue d g s) : TypeValue d (gsb A s) =
    (C.subT (ctx d) (ctx g) a.1 f.1,ty-sub-down A s d g a.1 f.1 a.2 f.2) ;
 } ;

case-gm-sb (D G a A s : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjtm G a A)) (p : SoundJ (gjsub D s G)) :
    SoundJ (gjtm D (gsb a s) (gsb A s)) =
  (p.1,\ d hd -> build d (p.2.2 d g hd r.1.2))
 where {
  g : Tel = r.1.1 ;
  v : TermValue g A a = r.2 g r.1.2 ;
  build (d : Tel) (f : SubValue d g s) : TermValue d (gsb A s) (gsb a s) =
    (C.subT (ctx d) (ctx g) v.1 f.1,(ty-sub-down A s d g v.1 f.1 v.2.1 f.2,
      (C.subt (ctx d) (ctx g) v.1 v.2.2.1 f.1,tm-sub-down a s d g v.1 v.2.2.1 f.1 v.2.2.2 f.2))) ;
 } ;

case-ge-sb (D G A A' s s' : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjeqty G A A'))
    (sd : SoundJ (gjsub D s G)) (td : SoundJ (gjsub D s' G)) (e : SoundJ (gjeqsub D s s' G)) :
    SoundJ (gjeqty D (gsb A s) (gsb A' s')) =
  (e.1,\ d hd -> build d (e.2.2 d g hd r.1.2))
 where {
  g : Tel = r.1.1 ;
  a : TypeEquality g A A' = r.2 g r.1.2 ;
  build (d : Tel) (f : SubEquality d g s s') : TypeEquality d (gsb A s) (gsb A' s') =
    (C.subT (ctx d) (ctx g) a.1 f.1,(ty-sub-down A s d g a.1 f.1 a.2.1 f.2.1,
      ty-sub-down A' s' d g a.1 f.1 a.2.2 f.2.2)) ;
 } ;

case-gm-esb (D G a a' A s s' : GE) (w : SoundJ (gjty G A)) (v : SoundJ (gjtm G a A))
    (r : SoundJ (gjeqtm G a a' A)) (sd : SoundJ (gjsub D s G)) (td : SoundJ (gjsub D s' G))
    (e : SoundJ (gjeqsub D s s' G)) : SoundJ (gjeqtm D (gsb a s) (gsb a' s') (gsb A s)) =
  (e.1,\ d hd -> build d (e.2.2 d g hd r.1.2))
 where {
  g : Tel = r.1.1 ;
  u : TermEquality g A a a' = r.2 g r.1.2 ;
  build (d : Tel) (f : SubEquality d g s s') : TermEquality d (gsb A s) (gsb a s) (gsb a' s') =
    (C.subT (ctx d) (ctx g) u.1 f.1,(ty-sub-down A s d g u.1 f.1 u.2.1 f.2.1,
      (C.subt (ctx d) (ctx g) u.1 u.2.2.1 f.1,
       (tm-sub-down a s d g u.1 u.2.2.1 f.1 u.2.2.2.1 f.2.1,
        tm-sub-down a' s' d g u.1 u.2.2.1 f.1 u.2.2.2.2 f.2.2)))) ;
 } ;

case-gq-comp (T D G s s' t t' : GE) (r : SoundJ (gjeqsub D s s' G)) (p : SoundJ (gjeqsub T t t' D)) :
    SoundJ (gjeqsub T (gcomp s t) (gcomp s' t') G) =
  (p.1,(r.2.1,\ e g he hg -> build e g (r.2.2 d g r.1.2 hg) (p.2.2 e d he r.1.2)))
 where {
  d : Tel = r.1.1 ;
  build (e g : Tel) (u : SubEquality d g s s') (v : SubEquality e d t t') :
      SubEquality e g (gcomp s t) (gcomp s' t') =
    (C.o (ctx e) (ctx d) (ctx g) u.1 v.1,(comp-down s t e d g u.1 v.1 u.2.1 v.2.1,
      comp-down s' t' e d g u.1 v.1 u.2.2 v.2.2)) ;
 } ;

case-gq-sec (G A A' a a' : GE) (w : SoundJ (gjty G A)) (h : SoundJ (gjtm G a A)) (h' : SoundJ (gjtm G a' A))
    (r : SoundJ (gjeqty G A A')) (p : SoundJ (gjeqtm G a a' A)) :
    SoundJ (gjeqsub G (gsec A a) (gsec A' a') (gext G A)) =
  (r.1,(extension-value G A w,\ d g hd hg -> build d g hd hg (r.2 d hd) (p.2 d hd)))
 where {
  build (d g : Tel) (hd : CtxDown G d) (hg : CtxDown (gext G A) g)
      (aEq : TypeEquality d A A') (t : TermEquality d A a a') :
      SubEquality d g (gsec A a) (gsec A' a') =
    at-context (gext G A) (\ z -> SubEquality d z (gsec A a) (gsec A' a'))
      (extension-witness G A d hd aEq.1 aEq.2.1)
      (C.sec (ctx d) aEq.1 v.1,(sec-down A a d aEq.1 v.1 aEq.2.1 v.2.1,sec-down A' a' d aEq.1 v.1 aEq.2.2 v.2.2)) g hg
   where { v : (u : C.El (ctx d) aEq.1) * (TmDown a d aEq.1 u * TmDown a' d aEq.1 u) =
     equal-at-type d A a a' aEq.1 aEq.2.1 t ; } ;
 } ;

case-gq-lift (D G A A' s s' : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjeqty G A A'))
    (sd : SoundJ (gjsub D s G)) (e : SoundJ (gjeqsub D s s' G)) :
    SoundJ (gjeqsub (gext D (gsb A s)) (glift A s) (glift A' s') (gext G A)) =
  (wd,(wg,at-contexts (gext D (gsb A s)) (gext G A)
    (\ d' g' -> SubEquality d' g' (glift A s) (glift A' s')) wd wg
    (C.lift (ctx d) (ctx g) a.1 f.1,(lift-down A s d g a.1 f.1 a.2.1 f.2.1,lift-down A' s' d g a.1 f.1 a.2.2 f.2.2))))
 where {
  d : Tel = e.1.1 ;
  g : Tel = e.2.1.1 ;
  f : SubEquality d g s s' = e.2.2 d g e.1.2 e.2.1.2 ;
  a : TypeEquality g A A' = r.2 g e.2.1.2 ;
  wd : CtxValue (gext D (gsb A s)) = extension-witness D (gsb A s) d e.1.2 (C.subT (ctx d) (ctx g) a.1 f.1)
    (ty-sub-down A s d g a.1 f.1 a.2.1 f.2.1) ;
  wg : CtxValue (gext G A) = extension-witness G A g e.2.1.2 a.1 a.2.1 ;
 } ;
