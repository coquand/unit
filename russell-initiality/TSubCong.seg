-- TSubCong.seg: sterbac4, Lemma 15, second part: convertible substitutions
-- give convertible results.
--   SubEq D G s s'   pointwise conversion, by recursion on G
--   sub-cong         G |- A  gives  D |- A[s] = A[s'];  G |- a : T gives
--                    D |- a[s] = a[s'] : T[s]

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;

SubEq (D : Cx) : Cx -> (Nat -> Tm) -> (Nat -> Tm) -> U l = split {
  cnil -> \ s s' -> Top ;
  csnoc G A | r -> \ s s' -> r (\ i -> s (suc i)) (\ i -> s' (suc i)) *
                             Der (jeqtm D (s zero) (s' zero) (Sub.trav A (\ i -> s (suc i)))) } ;

subeq-wk (D : Cx) (B : Tm) (hB : Der (jty D B)) : (G : Cx) -> (s s' : Nat -> Tm) -> SubEq D G s s' ->
    SubEq (csnoc D B) G (\ i -> wk (s i)) (\ i -> wk (s' i)) = split {
  cnil -> \ s s' e -> tt ;
  csnoc G A | r -> \ s s' e ->
    (r (\ i -> s (suc i)) (\ i -> s' (suc i)) e.1,
     der-eqtm-ty (csnoc D B) (wk (s zero)) (wk (s' zero)) (wk (Sub.trav A (\ i -> s (suc i))))
       (Sub.trav A (\ i -> wk (s (suc i)))) (sub-wk-trav A (\ i -> s (suc i)))
       (wk-eqtm D B (s zero) (s' zero) (Sub.trav A (\ i -> s (suc i))) hB e.2)) } ;

subeq-lift (D G : Cx) (s s' : Nat -> Tm) (A : Tm) (e : SubEq D G s s') (hA : Der (jty D (Sub.trav A s))) :
    SubEq (csnoc D (Sub.trav A s)) (csnoc G A) (Sub.lift s) (Sub.lift s') =
  (subeq-wk D (Sub.trav A s) hA G s s' e,
   eqtm-refl (csnoc D (Sub.trav A s)) (var zero) (Sub.trav A (\ i -> wk (s i)))
     (der-tm-ty (csnoc D (Sub.trav A s)) (var zero) (wk (Sub.trav A s)) (Sub.trav A (\ i -> wk (s i)))
        (sub-wk-trav A s) (tm-v0 D (Sub.trav A s) hA))) ;

-- lift s' typed into the context extended by A[s], using A[s] = A[s']
subok-lift' (D G : Cx) (s' : Nat -> Tm) (A A1 : Tm) (so : SubD.SubOk D G s') (hA1 : Der (jty D A1))
    (e : Der (jeqty D A1 (Sub.trav A s'))) : SubD.SubOk (csnoc D A1) (csnoc G A) (Sub.lift s') =
  (SubD.subok-wk D A1 hA1 G s' so,
   tm-conv (csnoc D A1) (var zero) (wk A1) (Sub.trav A (\ i -> wk (s' i))) (tm-v0 D A1 hA1)
     (der-eqty-r (csnoc D A1) (wk A1) (wk (Sub.trav A s')) (Sub.trav A (\ i -> wk (s' i))) (sub-wk-trav A s')
        (wk-eqty D A1 A1 (Sub.trav A s') hA1 e))) ;

CongJ : Jf -> U l = split {
  jwf G -> Top ;
  jty G A -> (D : Cx) -> (s s' : Nat -> Tm) -> SubD.SubOk D G s -> SubD.SubOk D G s' -> SubEq D G s s' ->
    Der (jwf D) -> Der (jeqty D (Sub.trav A s) (Sub.trav A s')) ;
  jtm G a A -> (D : Cx) -> (s s' : Nat -> Tm) -> SubD.SubOk D G s -> SubD.SubOk D G s' -> SubEq D G s s' ->
    Der (jwf D) -> Der (jeqtm D (Sub.trav a s) (Sub.trav a s') (Sub.trav A s)) ;
  jeqty G A B -> Top ;
  jeqtm G a b A -> Top } ;

sub-cong : (J : Jf) -> Der J -> CongJ J = split {
  wf-nil -> tt ;
  wf-snoc G A h -> tt ;
  tm-v0 G A h -> \ D s s' so so' e wD ->
    der-eqtm-ty D (s zero) (s' zero) (Sub.trav A (\ i -> s (suc i))) (Sub.trav (wk A) s)
      (sym Tm (Sub.trav (wk A) s) (Sub.trav A (\ i -> s (suc i))) (SL.trav-ren A (\ i -> suc i) s)) e.2 ;
  tm-vs G B n A h1 h2 | r1 r2 -> \ D s s' so so' e wD ->
    der-eqtm-ty D (s (suc n)) (s' (suc n)) (Sub.trav A (\ i -> s (suc i))) (Sub.trav (wk A) s)
      (sym Tm (Sub.trav (wk A) s) (Sub.trav A (\ i -> s (suc i))) (SL.trav-ren A (\ i -> suc i) s))
      (r1 D (\ i -> s (suc i)) (\ i -> s' (suc i)) so.1 so'.1 e.1 wD) ;
  ty-pi G A B h1 h2 | r1 r2 -> \ D s s' so so' e wD ->
    eqty-pi D (Sub.trav A s) (Sub.trav A s') (Sub.trav B (Sub.lift s)) (Sub.trav B (Sub.lift s'))
      (SubD.trav-der (jty G A) h1 D s so wD)
      (r1 D s s' so so' e wD)
      (r2 (csnoc D (Sub.trav A s)) (Sub.lift s) (Sub.lift s')
         (SubD.subok-lift D G s A so (SubD.trav-der (jty G A) h1 D s so wD))
         (subok-lift' D G s' A (Sub.trav A s) so' (SubD.trav-der (jty G A) h1 D s so wD) (r1 D s s' so so' e wD))
         (subeq-lift D G s s' A e (SubD.trav-der (jty G A) h1 D s so wD))
         (wf-snoc D (Sub.trav A s) (SubD.trav-der (jty G A) h1 D s so wD))) ;
  ty-uu G n h nb -> \ D s s' so so' e wD -> eqty-refl D (uu n) (ty-uu D n wD nb) ;
  ty-el G n a h | r -> \ D s s' so so' e wD -> eqty-el D n (Sub.trav a s) (Sub.trav a s') (r D s s' so so' e wD) ;
  tm-lam G A B b h1 h2 h3 | r1 r2 r3 -> \ D s s' so so' e wD ->
    eqtm-lam D (Sub.trav A s) (Sub.trav A s') (Sub.trav B (Sub.lift s)) (Sub.trav B (Sub.lift s'))
      (Sub.trav b (Sub.lift s)) (Sub.trav b (Sub.lift s'))
      (SubD.trav-der (jty G A) h1 D s so wD)
      (r1 D s s' so so' e wD)
      (r2 (csnoc D (Sub.trav A s)) (Sub.lift s) (Sub.lift s')
         (SubD.subok-lift D G s A so (SubD.trav-der (jty G A) h1 D s so wD))
         (subok-lift' D G s' A (Sub.trav A s) so' (SubD.trav-der (jty G A) h1 D s so wD) (r1 D s s' so so' e wD))
         (subeq-lift D G s s' A e (SubD.trav-der (jty G A) h1 D s so wD))
         (wf-snoc D (Sub.trav A s) (SubD.trav-der (jty G A) h1 D s so wD)))
      (r3 (csnoc D (Sub.trav A s)) (Sub.lift s) (Sub.lift s')
         (SubD.subok-lift D G s A so (SubD.trav-der (jty G A) h1 D s so wD))
         (subok-lift' D G s' A (Sub.trav A s) so' (SubD.trav-der (jty G A) h1 D s so wD) (r1 D s s' so so' e wD))
         (subeq-lift D G s s' A e (SubD.trav-der (jty G A) h1 D s so wD))
         (wf-snoc D (Sub.trav A s) (SubD.trav-der (jty G A) h1 D s so wD))) ;
  tm-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> \ D s s' so so' e wD ->
    der-eqtm-ty D (app (Sub.trav A s) (Sub.trav B (Sub.lift s)) (Sub.trav c s) (Sub.trav a s))
      (app (Sub.trav A s') (Sub.trav B (Sub.lift s')) (Sub.trav c s') (Sub.trav a s'))
      (subst1 (Sub.trav B (Sub.lift s)) (Sub.trav a s)) (Sub.trav (subst1 B a) s)
      (sym Tm (Sub.trav (subst1 B a) s) (subst1 (Sub.trav B (Sub.lift s)) (Sub.trav a s)) (sub-subst1 s B a))
      (eqtm-app D (Sub.trav A s) (Sub.trav A s') (Sub.trav B (Sub.lift s)) (Sub.trav B (Sub.lift s'))
         (Sub.trav c s) (Sub.trav c s') (Sub.trav a s) (Sub.trav a s')
         (SubD.trav-der (jty G A) h1 D s so wD)
         (SubD.trav-der (jty (csnoc G A) B) h2 (csnoc D (Sub.trav A s)) (Sub.lift s)
            (SubD.subok-lift D G s A so (SubD.trav-der (jty G A) h1 D s so wD))
            (wf-snoc D (Sub.trav A s) (SubD.trav-der (jty G A) h1 D s so wD)))
         (SubD.trav-der (jtm G a A) h4 D s so wD)
         (r1 D s s' so so' e wD)
         (r2 (csnoc D (Sub.trav A s)) (Sub.lift s) (Sub.lift s')
            (SubD.subok-lift D G s A so (SubD.trav-der (jty G A) h1 D s so wD))
            (subok-lift' D G s' A (Sub.trav A s) so' (SubD.trav-der (jty G A) h1 D s so wD) (r1 D s s' so so' e wD))
            (subeq-lift D G s s' A e (SubD.trav-der (jty G A) h1 D s so wD))
            (wf-snoc D (Sub.trav A s) (SubD.trav-der (jty G A) h1 D s so wD)))
         (r3 D s s' so so' e wD) (r4 D s s' so so' e wD)) ;
  tm-pic G n a b h1 h2 | r1 r2 -> \ D s s' so so' e wD ->
    eqtm-pic D n (Sub.trav a s) (Sub.trav a s') (Sub.trav b (Sub.lift s)) (Sub.trav b (Sub.lift s'))
      (SubD.trav-der (jtm G a (uu n)) h1 D s so wD)
      (r1 D s s' so so' e wD)
      (r2 (csnoc D (el n (Sub.trav a s))) (Sub.lift s) (Sub.lift s')
         (SubD.subok-lift D G s (el n a) so (ty-el D n (Sub.trav a s) (SubD.trav-der (jtm G a (uu n)) h1 D s so wD)))
         (subok-lift' D G s' (el n a) (el n (Sub.trav a s)) so'
            (ty-el D n (Sub.trav a s) (SubD.trav-der (jtm G a (uu n)) h1 D s so wD))
            (eqty-el D n (Sub.trav a s) (Sub.trav a s') (r1 D s s' so so' e wD)))
         (subeq-lift D G s s' (el n a) e (ty-el D n (Sub.trav a s) (SubD.trav-der (jtm G a (uu n)) h1 D s so wD)))
         (wf-snoc D (el n (Sub.trav a s)) (ty-el D n (Sub.trav a s) (SubD.trav-der (jtm G a (uu n)) h1 D s so wD)))) ;
  tm-uc G m n h lt nb -> \ D s s' so so' e wD -> eqtm-refl D (uc m n) (uu n) (tm-uc D m n wD lt nb) ;
  tm-lf G m n a h le nb | r -> \ D s s' so so' e wD -> eqtm-lf D m n (Sub.trav a s) (Sub.trav a s') (r D s s' so so' e wD) le nb ;
  tm-conv G a A B h1 h2 | r1 r2 -> \ D s s' so so' e wD ->
    eqtm-conv D (Sub.trav a s) (Sub.trav a s') (Sub.trav A s) (Sub.trav B s) (r1 D s s' so so' e wD)
      (SubD.trav-der (jeqty G A B) h2 D s so wD) ;
  eqty-refl G A h -> tt ;
  eqty-sym G A B h -> tt ;
  eqty-trans G A B C h1 h2 -> tt ;
  eqty-pi G A A' B B' h0 h1 h2 -> tt ;
  eqty-el G n a a' h -> tt ;
  eqty-el-lf G m n a h le nb -> tt ;
  eqty-el-pic G n a b h1 h2 -> tt ;
  eqty-el-uc G m n h lt nb -> tt ;
  eqtm-refl G a A h -> tt ;
  eqtm-sym G a b A hA h -> tt ;
  eqtm-trans G a b c A h1 h2 -> tt ;
  eqtm-conv G a b A B h1 h2 -> tt ;
  eqtm-lam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  eqtm-app G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  eqtm-pic G n a a' b b' h0 h1 h2 -> tt ;
  eqtm-lf G m n a a' h le nb -> tt ;
  eqtm-beta G A B b a hA hB h1 h2 -> tt ;
  eqtm-eta G A B f hA hB h -> tt ;
  eqtm-lf-pic G n p a b h1 h2 le nb -> tt ;
  eqtm-lf-uc G m n p h lt le nb -> tt ;
  eqtm-lf-lf G m n p a h le1 le2 nb -> tt } ;
