-- Move substitution equations to convertible endpoints.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ; open FCtx[l] ;

se-refl {D G s : FA} (h : Sb D s G) : SE D s s G = fq-refl D s G h ;
se-sym {D G s t : FA} (h : SE D s t G) : SE D t s G = fq-sym D s t G h ;
se-trans {D G s t u : FA} (p : SE D s t G) (q : SE D t u G) : SE D s u G = fq-trans D s t u G p q ;
comp-eq {T D G s s' d d' : FA} (p : SE D s s' G) (q : SE T d d' D) :
    SE T (fcomp T D G s d) (fcomp T D G s' d') G = fq-comp T D G s s' d d' p q ;

move-source (D E G s : FA) (e : CE D E) (h : Sb D s G) : Sb E s G =
  move-sub D E G G s e (cx-refl (fpresup (fjsub D s G) h).2) h ;

move-target (D G H s : FA) (e : CE G H) (h : Sb D s G) : Sb D s H =
  move-sub D D G H s (cx-refl (fpresup (fjsub D s G) h).1) e h ;

cancel-pre-id (D E G s : FA) (e : CE D E) (h : Sb D s G) :
    SE E (fcomp E D G s (fid E)) s G =
  fq-trans E (fcomp E D G s (fid E)) (fcomp E E G s (fid E)) s G
    (fq-comp-middle E D G s (fid E) h (move-target E E D (fid E) (f-cx-sym D E e) ident) E e)
    (fq-idr E G s (move-source D E G s e h))
 where { ident : Sb E (fid E) E = id-sub (wf-right D E e) ; } ;

cancel-post-id (D G H s : FA) (e : CE G H) (h : Sb D s G) :
    SE D (fcomp D G H (fid H) s) s H =
  fq-trans D (fcomp D G H (fid H) s) (fcomp D H H (fid H) s) s H
    (fq-comp-middle D G H (fid H) s (move-source H G H (fid H) (f-cx-sym G H e) ident) h H e)
    (fq-idl D H s (move-target D G H s e h))
 where { ident : Sb H (fid H) H = id-sub (wf-right G H e) ; } ;

se-source (D E G s t : FA) (e : CE D E) (p : SE D s t G) : SE E s t G =
  se-trans (se-sym (cancel-pre-id D E G s e ep.2.2.1))
    (se-trans (comp-eq p (se-refl ident)) (cancel-pre-id D E G t e ep.2.2.2))
 where {
  ep : FPJ (fjeqsub D s t G) = fpresup (fjeqsub D s t G) p ;
  ident : Sb E (fid E) D = move-target E E D (fid E) (f-cx-sym D E e) (id-sub (wf-right D E e)) ;
 } ;

se-target (D G H s t : FA) (e : CE G H) (p : SE D s t G) : SE D s t H =
  se-trans (se-sym (cancel-post-id D G H s e ep.2.2.1))
    (se-trans (comp-eq (se-refl ident) p) (cancel-post-id D G H t e ep.2.2.2))
 where {
  ep : FPJ (fjeqsub D s t G) = fpresup (fjeqsub D s t G) p ;
  ident : Sb G (fid H) H = move-source H G H (fid H) (f-cx-sym G H e) (id-sub (wf-right G H e)) ;
 } ;

move-se (D E G H s t : FA) (d : CE D E) (g : CE G H) (p : SE D s t G) : SE E s t H =
  se-target E G H s t g (se-source D E G s t d p) ;
