-- InitUniqCaseB.seg (PLAN-INIT, Part U): the induction cases of
-- uniqueness for terms (lam, app, pic, uc, lf, q, sb) and the term
-- conversions (gm-conv, gm-cx).  Same scheme as InitUniqCaseA; app is
-- ag-subt of ag-fun (Pi-iso.fun) and ag-sec, moved along cl-app.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lib[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitModelShape[l] ;
open InitUniqTot[l] ;
open InitUniqCls[l] ;
open InitUniqClsTm[l] ;

module Uq (e : Eqs) (M' : EM.TEModel[N]) {
  module Mo = InitHom.Morphism[l, N, mk e, M'] ;
  module HL = Mo.InitHomLaws ;
  module HS = Mo.InitHomStep ;

  module V (H H' : HL.Hom) {
    module Bs = InitUniqBase[l].Uq[e, M'].V[H, H'] ;
    open Bs ;

    case-gm-lam (G A B b : GE) (h1 : GDer (gjty G A)) (h2 : GDer (gjty (gext G A) B)) (h3 : GDer (gjtm (gext G A) b B))
      (ih1 : QT G A) (ih2 : QT (gext G A) B) (ih3 : QE (gext G A) b B)
      (h : Pf (gjtm G (glam A B b) (gpi A B))) (hP : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) :
      AgEt (tE G (gpi A B) (glam A B b) h hP w) =
      mvE _ _ (cl-lam G A B b hA hB hb w wE h hP)
        (HS.ag-lam H H' (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (elB G A B b hA hB hb w wE) (ih1 hA w)
           (ihE-at (gext G A) b B ih3 hb hB wE (eC G A hA w) (eP G A hA w wE) (tyB G A B hA hB w wE)
              (refl (tyB G A B hA hB w wE))))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h1 ;
      hB : Pf (gjty (gext G A) B) = pf (gjty (gext G A) B) h2 ;
      hb : Pf (gjtm (gext G A) b B) = pf (gjtm (gext G A) b B) h3 ;
      wE : Pf (gjwf (gext G A)) = wf-ty (gext G A) B hB ;
     } ;

    case-gm-app (G A B c a : GE) (h1 : GDer (gjty G A)) (h2 : GDer (gjty (gext G A) B)) (h3 : GDer (gjtm G c (gpi A B)))
      (h4 : GDer (gjtm G a A)) (ih1 : QT G A) (ih2 : QT (gext G A) B) (ih3 : QE G c (gpi A B)) (ih4 : QE G a A)
      (h : Pf (gjtm G (gapp A B c a) (gsb B (gsec A a)))) (hT : Pf (gjty G (gsb B (gsec A a)))) (w : Pf (gjwf G)) :
      AgEt (tE G (gsb B (gsec A a)) (gapp A B c a) h hT w) =
      mvE _ _ (cl-app G A B c a hA hB hf ha hP w wE h hT)
        (HS.ag-subt H H' (cls G w) (eC G A hA w) (tyB G A B hA hB w wE) (funC G A B c hA hB hf hP w wE)
           (secC G A a hA ha w)
           (HS.ag-fun H H' (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (fC G A B c hA hB hf hP w wE)
              (ih1 hA w) (ihT-at (gext G A) B ih2 hB wE (eC G A hA w) (eP G A hA w wE))
              (ihE-at G c (gpi A B) ih3 hf hP w (cls G w) (refl (cls G w)) (piT G A B hA hB w wE)
                 (pP G A B hA hB w wE hP)))
           (HS.ag-sec H H' (cls G w) (cTy G A hA w) (cEl G A a ha hA w) (ih4 ha hA w)))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h1 ;
      hB : Pf (gjty (gext G A) B) = pf (gjty (gext G A) B) h2 ;
      hf : Pf (gjtm G c (gpi A B)) = pf (gjtm G c (gpi A B)) h3 ;
      ha : Pf (gjtm G a A) = pf (gjtm G a A) h4 ;
      hP : Pf (gjty G (gpi A B)) = ty-tm G c (gpi A B) hf ;
      wE : Pf (gjwf (gext G A)) = wf-ty (gext G A) B hB ;
     } ;

    case-gm-pic (G : GE) (n : Nat) (a b : GE) (h1 : GDer (gjtm G a (guu n)))
      (h2 : GDer (gjtm (gext G (gel n a)) b (guu n))) (ih1 : QE G a (guu n)) (ih2 : QE (gext G (gel n a)) b (guu n))
      (h : Pf (gjtm G (gpic n a b) (guu n))) (hU : Pf (gjty G (guu n))) (w : Pf (gjwf G)) :
      AgEt (tE G (guu n) (gpic n a b) h hU w) =
      mvE _ _ (cl-pic n' G a b ha hU hb hUE w wE h)
        (HS.ag-pic H H' n' (cls G w) (codeC n' G a ha hU w) (bC n' G a b ha hU hb hUE w wE)
           (ihE-at G a (guu n) ih1 ha hU w (cls G w) (refl (cls G w)) (univ n' (cls G w))
              (pUg n' (cls G w) G hU w (refl (cls G w))))
           (ihE-at (gext G (gel n a)) b (guu n) ih2 hb hUE wE (dE n' G a ha hU w) (dP n' G a ha hU w wE)
              (univ n' (dE n' G a ha hU w)) (pUg n' (dE n' G a ha hU w) (gext G (gel n a)) hUE wE (dP n' G a ha hU w wE))))
     where {
      n' : EM.LevelAt N = (n, g-universe-bound G n (GP.gpresup (gjtm G a (guu n)) h1).2) ;
      ha : Pf (gjtm G a (guu n)) = pf (gjtm G a (guu n)) h1 ;
      hb : Pf (gjtm (gext G (gel n a)) b (guu n)) = pf (gjtm (gext G (gel n a)) b (guu n)) h2 ;
      hUE : Pf (gjty (gext G (gel n a)) (guu n)) = ty-tm (gext G (gel n a)) b (guu n) hb ;
      wE : Pf (gjwf (gext G (gel n a))) = wf-tm (gext G (gel n a)) b (guu n) hb ;
     } ;

    case-gm-uc (G : GE) (m n : Nat) (h : GDer (gjwf G)) (lt : LeN (suc m) n) (nb : LeN n N) (ih1 : QC G)
      (h' : Pf (gjtm G (guc m n) (guu n))) (hU : Pf (gjty G (guu n))) (w : Pf (gjwf G)) :
      AgEt (tE G (guu n) (guc m n) h' hU w) =
      mvE _ _ (cl-uc m' n' lt G w h' hU) (HS.ag-uc H H' m' n' lt (cls G w) (ih1 w))
     where {
      m' : EM.LevelAt N = (m, lower-bound m n lt nb) ;
      n' : EM.LevelAt N = (n, nb) ;
     } ;

    case-gm-lf (G : GE) (m n : Nat) (a : GE) (h : GDer (gjtm G a (guu m))) (le : LeN (suc m) n) (nb : LeN n N)
      (ih1 : QE G a (guu m))
      (h' : Pf (gjtm G (glf m n a) (guu n))) (hU : Pf (gjty G (guu n))) (w : Pf (gjwf G)) :
      AgEt (tE G (guu n) (glf m n a) h' hU w) =
      mvE _ _ (cl-lf m' n' le G a ha hUm w h' hU)
        (HS.ag-lf H H' m' n' le (cls G w) (codeC m' G a ha hUm w)
           (ihE-at G a (guu m) ih1 ha hUm w (cls G w) (refl (cls G w)) (univ m' (cls G w))
              (pUg m' (cls G w) G hUm w (refl (cls G w)))))
     where {
      m' : EM.LevelAt N = (m, lower-bound m n le nb) ;
      n' : EM.LevelAt N = (n, nb) ;
      ha : Pf (gjtm G a (guu m)) = pf (gjtm G a (guu m)) h ;
      hUm : Pf (gjty G (guu m)) = ty-tm G a (guu m) ha ;
     } ;

    case-gm-q (G A : GE) (h : GDer (gjty G A)) (ih1 : QT G A)
      (h' : Pf (gjtm (gext G A) gq (gsb A gp))) (hT : Pf (gjty (gext G A) (gsb A gp))) (wE : Pf (gjwf (gext G A))) :
      AgEt (tE (gext G A) (gsb A gp) gq h' hT wE) =
      mvE _ _ (cl-q G A hA w wE h' hT) (HS.ag-q H H' (cls G w) (cTy G A hA w) (ih1 hA w))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h ;
      w : Pf (gjwf G) = wf-ty G A hA ;
     } ;

    case-gm-sb (D G a A s : GE) (hA0 : GDer (gjty G A)) (h1 : GDer (gjtm G a A)) (h2 : GDer (gjsub D s G))
      (ih1 : QT G A) (ih2 : QE G a A) (ih3 : QS D s G)
      (h : Pf (gjtm D (gsb a s) (gsb A s))) (hT : Pf (gjty D (gsb A s))) (wD : Pf (gjwf D)) :
      AgEt (tE D (gsb A s) (gsb a s) h hT wD) =
      mvE _ _ (cl-sb D G a A s ha hA hs wD wG h hT)
        (HS.ag-subt H H' (cls D wD) (cls G wG) (cTy G A hA wG) (cEl G A a ha hA wG) (cSub D s G hs wD wG)
           (ih2 ha hA wG) (ih3 hs wD wG))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) hA0 ;
      ha : Pf (gjtm G a A) = pf (gjtm G a A) h1 ;
      hs : Pf (gjsub D s G) = pf (gjsub D s G) h2 ;
      wG : Pf (gjwf G) = wf-cod D s G hs ;
     } ;

    case-gm-conv (G a A B : GE) (h1 : GDer (gjtm G a A)) (h2 : GDer (gjeqty G A B)) (ih1 : QE G a A) (ih2 : Top)
      (h : Pf (gjtm G a B)) (hB : Pf (gjty G B)) (w : Pf (gjwf G)) : AgEt (tE G B a h hB w) =
      mvE _ _ (tE-conv G A B a ha hA h hB w (pf (gjeqty G A B) h2)) (ih1 ha hA w)
     where {
      ha : Pf (gjtm G a A) = pf (gjtm G a A) h1 ;
      hA : Pf (gjty G A) = ty-tm G a A ha ;
     } ;

    case-gm-cx (G D a A : GE) (h0 : GDer (gjwf D)) (h1 : GDer (gjeqcx G D)) (h2 : GDer (gjtm G a A))
      (ih1 : QC D) (ih2 : Top) (ih3 : QE G a A)
      (h : Pf (gjtm D a A)) (hA' : Pf (gjty D A)) (w' : Pf (gjwf D)) : AgEt (tE D A a h hA' w') =
      mvE _ _ (tE-cx G D a A ha hA w h hA' w' (pf (gjeqcx G D) h1)) (ih3 ha hA w)
     where {
      ha : Pf (gjtm G a A) = pf (gjtm G a A) h2 ;
      hA : Pf (gjty G A) = ty-tm G a A ha ;
      w : Pf (gjwf G) = wf-tm G a A ha ;
     } ;
  } ;
} ;
