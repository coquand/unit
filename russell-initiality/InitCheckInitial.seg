-- InitCheckInitial: initiality of the term model of T_E in the strong
-- form (PLAN-INIT, Part C): for every model M of level N, the type of
-- morphisms TM -> M (Sigma form, InitHomSig) is contractible.
-- The axioms are the module parameters of InitCheck.Init.
import GATCheck ; open GATCheck ;
import Replacement ;
import Paths ;
import InitHom ;
import EquivalenceLemmas ; import Category ;
import InitHomIdentity ;
import InitHomS ;
import InitCheck ;
module InitialC
 (ua : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j)
 (N : Base.Nat) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[ua @l].fe ;
 module I = InitCheck.Init[ua, images, surjections, N] ;
 module Contr (l : Level) (M : EhrhardTEModel[l].TEModel[N]) {
  import InitContr ;
 } ;
 module Initial2 (l : Level) {
  import InitInitialObject ;
 } ;
} ;
