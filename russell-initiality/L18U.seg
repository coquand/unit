-- L18U.seg: Lemma 18, the cases of the universes, decoding, codes, lifts
-- and the conversion rule.
--   uu-props, el-props   the four properties of U_n and T_n(a)
--   c-uu, c-el, c-pic, c-uc, c-lf, c-conv

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ; open TPresup[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18Bind[l] ; open L18Pi[l] ;

uu-props (G : Cx) (n : Nat) (nb : LeN n N) : PT G (uu n) * (NT G (uu n) * (ET G (uu n) * ST G (uu n))) =
  (\ D e wD o -> gt-uu D n wD nb,
   (\ D e T s wD wT o hs -> ge-uu-sb T D n s hs nb,
    (\ D e1 e2 wD r -> ge-refl D (guu n) (gt-uu D n wD nb),
     \ G0 s c0 g D e wD o -> (gt-uu D n wD nb, ge-refl D (guu n) (gt-uu D n wD nb))))) ;

c-uu (G : Cx) (n : Nat) (nb : LeN n N) (r : L18J (jwf G)) : L18J (jty G (uu n)) = (r, uu-props G n nb) ;

el-props (G : Cx) (n : Nat) (a : Tm) (pa : PM G a (uu n)) (na : NM G a (uu n)) (ea : EM G a (uu n)) (sa : SMt G a (uu n)) :
    PT G (el n a) * (NT G (el n a) * (ET G (el n a) * ST G (el n a))) =
  (\ D e wD o -> gt-el D n (ev a e) (pa D e wD o),
   (\ D e T s wD wT o hs ->
      ge-trans T (gsb (gel n (ev a e)) s) (gel n (gsb (ev a e) s)) (gel n (ev a (esb e s)))
        (ge-el-sb T D n (ev a e) s (pa D e wD o) hs)
        (ge-el T n (gsb (ev a e) s) (ev a (esb e s)) (na D e T s wD wT o hs)),
    (\ D e1 e2 wD r -> ge-el D n (ev a e1) (ev a e2) (ea D e1 e2 wD r),
     \ G0 s c0 g D e wD o ->
       (gt-el D n (ev (Sub.trav a s) e) (sa G0 s c0 g D e wD o).1,
        ge-el D n (ev (Sub.trav a s) e) (ev a (evs s e)) (sa G0 s c0 g D e wD o).2)))) ;

c-el (G : Cx) (n : Nat) (a : Tm) (r : L18J (jtm G a (uu n))) : L18J (jty G (el n a)) =
  (r.1, el-props G n a r.2.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2) ;

c-pic (G : Cx) (n : Nat) (a b : Tm) (ha : Der (jtm G a (uu n))) (ra : L18J (jtm G a (uu n))) (rb : L18J (jtm (csnoc G (el n a)) b (uu n))) :
    L18J (jtm G (pic n a b) (uu n)) =
  (ra.1,
   (\ D e wD o ->
      gm-pic D n (ev a e) (ev b (up e)) (ra.2.1 D e wD o)
        (rb.2.1 (gext D (gel n (ev a e))) (up e) (g-ext D (gel n (ev a e)) (gt-el D n (ev a e) (ra.2.1 D e wD o)))
           (env-up D e wD G (el n a) (cs-ci (csnoc G (el n a)) rb.1) o)),
    (\ D e T s wD wT o hs ->
       gm-trans T (gsb (gpic n (ev a e) (ev b (up e))) s)
         (gpic n (gsb (ev a e) s) (gsb (ev b (up e)) (glift (gel n (ev a e)) s)))
         (gpic n (ev a (esb e s)) (ev b (up (esb e s)))) (guu n)
         (gm-pic-sb T D n (ev a e) (ev b (up e)) s (ra.2.1 D e wD o)
            (rb.2.1 (gext D (gel n (ev a e))) (up e) (g-ext D (gel n (ev a e)) (gt-el D n (ev a e) (ra.2.1 D e wD o)))
               (env-up D e wD G (el n a) (cs-ci (csnoc G (el n a)) rb.1) o)) hs)
         (gm-epic T n (gsb (ev a e) s) (ev a (esb e s)) (gsb (ev b (up e)) (glift (gel n (ev a e)) s)) (ev b (up (esb e s)))
            (gm-conv T (gsb (ev a e) s) (gsb (guu n) s) (guu n) (gm-sb T D (ev a e) (guu n) s (gt-uu D n wD nb) (ra.2.1 D e wD o) hs)
               (ge-uu-sb T D n s hs nb))
            (ra.2.2.1 D e T s wD wT o hs)
            (gm-ecx (gext T (gsb (gel n (ev a e)) s)) (gext T (gel n (gsb (ev a e) s)))
               (gsb (ev b (up e)) (glift (gel n (ev a e)) s)) (ev b (up (esb e s))) (guu n)
               (g-ext T (gel n (gsb (ev a e) s))
                  (gt-el T n (gsb (ev a e) s)
                     (gm-conv T (gsb (ev a e) s) (gsb (guu n) s) (guu n) (gm-sb T D (ev a e) (guu n) s (gt-uu D n wD nb) (ra.2.1 D e wD o) hs)
                        (ge-uu-sb T D n s hs nb))))
               (gc-ext T T (gsb (gel n (ev a e)) s) (gel n (gsb (ev a e) s)) (gc-refl T wT)
                  (ge-el-sb T D n (ev a e) s (ra.2.1 D e wD o) hs))
               (gm-eqconv (gext T (gsb (gel n (ev a e)) s)) (gsb (ev b (up e)) (glift (gel n (ev a e)) s)) (ev b (up (esb e s)))
                  (gsb (guu n) (glift (gel n (ev a e)) s)) (guu n)
                  (h3-sub G (el n a) b (uu n) (cs-ci (csnoc G (el n a)) rb.1) (uu-props (csnoc G (el n a)) n nb).2.1
                     rb.2.2.1 rb.2.2.2.1 D T s e wD wT hs o)
                  (ge-uu-sb (gext T (gsb (gel n (ev a e)) s)) (gext D (gel n (ev a e))) n (glift (gel n (ev a e)) s)
                     (gs-lift T D (gel n (ev a e)) s hs (gt-el D n (ev a e) (ra.2.1 D e wD o))) nb)))),
     (\ D e1 e2 wD r ->
        gm-epic D n (ev a e1) (ev a e2) (ev b (up e1)) (ev b (up e2)) (ra.2.1 D e1 wD r.1) (ra.2.2.2.1 D e1 e2 wD r)
          (rb.2.2.2.1 (gext D (gel n (ev a e1))) (up e1) (up e2)
             (g-ext D (gel n (ev a e1)) (gt-el D n (ev a e1) (ra.2.1 D e1 wD r.1)))
             (rel-up D wD G (el n a) (cs-ci (csnoc G (el n a)) rb.1) e1 e2 r)),
      \ G0 s c0 g D e wD o ->
        (gm-pic D n (ev (Sub.trav a s) e) (ev (Sub.trav b (Sub.lift s)) (up e)) (ra.2.2.2.2 G0 s c0 g D e wD o).1
           (sm-bind G0 G (el n a) (uu n) b c0 ra.1 (cs-ci (csnoc G (el n a)) rb.1) rb.1 s g
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).1
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).2.1
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).2.2.1
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).2.2.2
              (uu-props (csnoc G (el n a)) n nb).2.2.2 (uu-props (csnoc G (el n a)) n nb).2.2.1
              rb.2.2.2.2 rb.2.2.2.1 D e wD o).1,
         gm-epic D n (ev (Sub.trav a s) e) (ev a (evs s e)) (ev (Sub.trav b (Sub.lift s)) (up e)) (ev b (up (evs s e)))
           (ra.2.2.2.2 G0 s c0 g D e wD o).1 (ra.2.2.2.2 G0 s c0 g D e wD o).2
           (sm-bind G0 G (el n a) (uu n) b c0 ra.1 (cs-ci (csnoc G (el n a)) rb.1) rb.1 s g
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).1
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).2.1
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).2.2.1
              (el-props G n a ra.2.1 ra.2.2.1 ra.2.2.2.1 ra.2.2.2.2).2.2.2
              (uu-props (csnoc G (el n a)) n nb).2.2.2 (uu-props (csnoc G (el n a)) n nb).2.2.1
              rb.2.2.2.2 rb.2.2.2.1 D e wD o).2)))))
 where { nb : LeN n N = t-universe-tm-bound G a n ha ; } ;

c-uc (G : Cx) (m n : Nat) (lt : LeN (suc m) n) (nb : LeN n N) (r : L18J (jwf G)) : L18J (jtm G (uc m n) (uu n)) =
  (r,
   (\ D e wD o -> gm-uc D m n wD lt nb,
    (\ D e T s wD wT o hs -> gm-uc-sb T D m n s hs lt nb,
     (\ D e1 e2 wD r' -> gm-refl D (guc m n) (guu n) (gm-uc D m n wD lt nb),
      \ G0 s c0 g D e wD o -> (gm-uc D m n wD lt nb, gm-refl D (guc m n) (guu n) (gm-uc D m n wD lt nb)))))) ;

c-lf (G : Cx) (m n : Nat) (a : Tm) (le : LeN (suc m) n) (nb : LeN n N) (r : L18J (jtm G a (uu m))) : L18J (jtm G (lf m n a) (uu n)) =
  (r.1,
   (\ D e wD o -> gm-lf D m n (ev a e) (r.2.1 D e wD o) le nb,
    (\ D e T s wD wT o hs ->
       gm-trans T (gsb (glf m n (ev a e)) s) (glf m n (gsb (ev a e) s)) (glf m n (ev a (esb e s))) (guu n)
         (gm-lf-sb T D m n (ev a e) s (r.2.1 D e wD o) hs le nb)
         (gm-elf T m n (gsb (ev a e) s) (ev a (esb e s)) (r.2.2.1 D e T s wD wT o hs) le nb),
     (\ D e1 e2 wD r' -> gm-elf D m n (ev a e1) (ev a e2) (r.2.2.2.1 D e1 e2 wD r') le nb,
      \ G0 s c0 g D e wD o ->
        (gm-lf D m n (ev (Sub.trav a s) e) (r.2.2.2.2 G0 s c0 g D e wD o).1 le nb,
         gm-elf D m n (ev (Sub.trav a s) e) (ev a (evs s e)) (r.2.2.2.2 G0 s c0 g D e wD o).2 le nb))))) ;

c-conv (G : Cx) (a A B : Tm) (r1 : L18J (jtm G a A)) (r2 : L18J (jeqty G A B)) : L18J (jtm G a B) =
  (r1.1,
   (\ D e wD o -> gm-conv D (ev a e) (ev A e) (ev B e) (r1.2.1 D e wD o) (r2.2 D e e wD (rel-refl D G e o)),
    (\ D e T s wD wT o hs ->
       gm-eqconv T (gsb (ev a e) s) (ev a (esb e s)) (ev A (esb e s)) (ev B (esb e s)) (r1.2.2.1 D e T s wD wT o hs)
         (r2.2 T (esb e s) (esb e s) wT (rel-refl T G (esb e s) (env-sub D T s wD wT hs G (cs-ci G r1.1) e o))),
     (\ D e1 e2 wD r ->
        gm-eqconv D (ev a e1) (ev a e2) (ev A e1) (ev B e1) (r1.2.2.2.1 D e1 e2 wD r) (r2.2 D e1 e1 wD (rel-refl D G e1 r.1)),
      \ G0 s c0 g D e wD o ->
        (gm-conv D (ev (Sub.trav a s) e) (ev A (evs s e)) (ev B (evs s e)) (r1.2.2.2.2 G0 s c0 g D e wD o).1
           (r2.2 D (evs s e) (evs s e) wD (rel-refl D G (evs s e) (evs-ok G0 c0 D wD e o G r1.1 s g))),
         gm-eqconv D (ev (Sub.trav a s) e) (ev a (evs s e)) (ev A (evs s e)) (ev B (evs s e)) (r1.2.2.2.2 G0 s c0 g D e wD o).2
           (r2.2 D (evs s e) (evs s e) wD (rel-refl D G (evs s e) (evs-ok G0 c0 D wD e o G r1.1 s g)))))))) ;
