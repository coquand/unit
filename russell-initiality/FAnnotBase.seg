-- Witnesses for the eight annotated judgement shapes and transport to fixed contexts.
level l ;
open Base ; open Lib[l] ; open AGAT[l] ; open FGAT[l] ; open FForget[l] ;
open FTyping[l] ; open FPresup[l] ; open FSubTransport[l] ; open FCtx[l] ; open FCoherence[l] ; open FShape[l] ; open FLiftExpr[l] ;

record LiftCx { G : GA ; e : LiftExpr[G] ; ok : W e.t } ;
record LiftTy { G : GA ; A : GA ; c : LiftCx[G] ; a : LiftExpr[A] ; d : Ty c.e.t a.t } ;
record LiftTm { G : GA ; a : GA ; A : GA ; c : LiftCx[G] ; x : LiftExpr[a] ; t : LiftExpr[A] ; d : Tm' c.e.t x.t t.t } ;
record LiftSub { D : GA ; s : GA ; G : GA ; c : LiftCx[D] ; k : LiftCx[G] ; x : LiftExpr[s] ; d : Sb c.e.t x.t k.e.t } ;
record LiftCE { G : GA ; H : GA ; c : LiftCx[G] ; k : LiftCx[H] ; d : CE c.e.t k.e.t } ;
record LiftTE { G : GA ; A : GA ; B : GA ; c : LiftCx[G] ; a : LiftExpr[A] ; b : LiftExpr[B] ; d : TE c.e.t a.t b.t } ;
record LiftME { G : GA ; a : GA ; b : GA ; A : GA ; c : LiftCx[G] ; x : LiftExpr[a] ; y : LiftExpr[b] ;
    t : LiftExpr[A] ; d : ME c.e.t x.t y.t t.t } ;
record LiftSE { D : GA ; s : GA ; t : GA ; G : GA ; c : LiftCx[D] ; k : LiftCx[G] ;
    x : LiftExpr[s] ; y : LiftExpr[t] ; d : SE c.e.t x.t y.t k.e.t } ;

LiftJ : GAJ -> U l = split {
  ajwf G -> LiftCx[G] ;
  ajty G A -> LiftTy[G,A] ;
  ajtm G a A -> LiftTm[G,a,A] ;
  ajsub D s G -> LiftSub[D,s,G] ;
  ajeqcx G H -> LiftCE[G,H] ;
  ajeqty G A B -> LiftTE[G,A,B] ;
  ajeqtm G a b A -> LiftME[G,a,b,A] ;
  ajeqsub D s t G -> LiftSE[D,s,t,G] } ;

put-wf (G : GA) (e : LiftExpr[G]) (h : W e.t) : LiftCx[G] = new LiftCx[G,e := e,ok := h] ;
put-ty (G A : GA) (e : LiftExpr[G]) (a : LiftExpr[A]) (h : Ty e.t a.t) : LiftTy[G,A] =
  new LiftTy[G,A,c := put-wf G e (fpresup (fjty e.t a.t) h),a := a,d := h] ;
put-tm (G a A : GA) (e : LiftExpr[G]) (x : LiftExpr[a]) (t : LiftExpr[A]) (h : Tm' e.t x.t t.t) : LiftTm[G,a,A] =
  new LiftTm[G,a,A,c := put-wf G e (fpresup (fjtm e.t x.t t.t) h).1,x := x,t := t,d := h] ;
put-sub (D s G : GA) (e : LiftExpr[D]) (x : LiftExpr[s]) (g : LiftExpr[G]) (h : Sb e.t x.t g.t) : LiftSub[D,s,G] =
  new LiftSub[D,s,G,c := put-wf D e p.1,k := put-wf G g p.2,x := x,d := h]
  where { p : FPJ (fjsub e.t x.t g.t) = fpresup (fjsub e.t x.t g.t) h ; } ;
put-ce (G H : GA) (e : LiftExpr[G]) (g : LiftExpr[H]) (h : CE e.t g.t) : LiftCE[G,H] =
  new LiftCE[G,H,c := put-wf G e (wf-left e.t g.t h),k := put-wf H g (wf-right e.t g.t h),d := h] ;
put-te (G A B : GA) (e : LiftExpr[G]) (a : LiftExpr[A]) (b : LiftExpr[B]) (h : TE e.t a.t b.t) : LiftTE[G,A,B] =
  new LiftTE[G,A,B,c := put-wf G e (fpresup (fjeqty e.t a.t b.t) h).1,a := a,b := b,d := h] ;
put-me (G a b A : GA) (e : LiftExpr[G]) (x : LiftExpr[a]) (y : LiftExpr[b]) (t : LiftExpr[A]) (h : ME e.t x.t y.t t.t) :
    LiftME[G,a,b,A] =
  new LiftME[G,a,b,A,c := put-wf G e (fpresup (fjeqtm e.t x.t y.t t.t) h).1,x := x,y := y,t := t,d := h] ;
put-se (D s t G : GA) (e : LiftExpr[D]) (x : LiftExpr[s]) (y : LiftExpr[t]) (g : LiftExpr[G]) (h : SE e.t x.t y.t g.t) :
    LiftSE[D,s,t,G] =
  new LiftSE[D,s,t,G,c := put-wf D e p.1,k := put-wf G g p.2.1,x := x,y := y,d := h]
  where { p : FPJ (fjeqsub e.t x.t y.t g.t) = fpresup (fjeqsub e.t x.t y.t g.t) h ; } ;

at-ext (G A : GA) (c : LiftCx[G]) (a : LiftExpr[A]) (h : Ty c.e.t a.t) : LiftCx[aext G A] =
  put-wf (aext G A) (e-ext G c.e A a) (f-ext c.e.t a.t h) ;

same-image (raw : GA) (x y : LiftExpr[raw]) : Id GA (ff x.t) (ff y.t) =
  Prelude[l].trans GA (ff x.t) raw (ff y.t) x.image (Prelude[l].sym GA (ff y.t) raw y.image) ;

cx-align (G : GA) (p q : LiftCx[G]) : CE p.e.t q.e.t =
  same-cx p.e.t q.e.t (same-image G p.e q.e) p.ok q.ok ;

ty-align (G A : GA) (c : LiftCx[G]) (p q : LiftExpr[A]) (hp : Ty c.e.t p.t) (hq : Ty c.e.t q.t) : TE c.e.t p.t q.t =
  same-ty p.t q.t (same-image A p q) c.e.t c.e.t (fc-refl c.e.t c.ok) hp hq ;

tm-align (G a A : GA) (c : LiftCx[G]) (p q : LiftExpr[a]) (T : LiftExpr[A])
    (hp : Tm' c.e.t p.t T.t) (hq : Tm' c.e.t q.t T.t) : ME c.e.t p.t q.t T.t =
  (same-tm p.t q.t (same-image a p q) c.e.t c.e.t T.t T.t (fc-refl c.e.t c.ok) hp hq).2 ;

sub-align (D s G : GA) (c : LiftCx[D]) (k : LiftCx[G]) (p q : LiftExpr[s]) (hp : Sb c.e.t p.t k.e.t) (hq : Sb c.e.t q.t k.e.t) :
    SE c.e.t p.t q.t k.e.t =
  (same-sub p.t q.t (same-image s p q) c.e.t c.e.t k.e.t k.e.t (fc-refl c.e.t c.ok) hp hq).2 ;

at-ty (G A : GA) (r : LiftTy[G,A]) (c : LiftCx[G]) : Ty c.e.t r.a.t =
  move-ty r.c.e.t c.e.t r.a.t (cx-align G r.c c) r.d ;

at-tm (G a A : GA) (r : LiftTm[G,a,A]) (c : LiftCx[G]) : Tm' c.e.t r.x.t r.t.t =
  move-tm r.c.e.t c.e.t r.x.t r.t.t (cx-align G r.c c) r.d ;

at-sub (D s G : GA) (r : LiftSub[D,s,G]) (c : LiftCx[D]) (k : LiftCx[G]) : Sb c.e.t r.x.t k.e.t =
  move-sub r.c.e.t c.e.t r.k.e.t k.e.t r.x.t (cx-align D r.c c) (cx-align G r.k k) r.d ;

at-ce (G H : GA) (r : LiftCE[G,H]) (c : LiftCx[G]) (k : LiftCx[H]) : CE c.e.t k.e.t =
  f-cx-trans c.e.t r.c.e.t k.e.t (cx-align G c r.c)
    (f-cx-trans r.c.e.t r.k.e.t k.e.t r.d (cx-align H r.k k)) ;

at-te (G A B : GA) (r : LiftTE[G,A,B]) (c : LiftCx[G]) : TE c.e.t r.a.t r.b.t =
  move-te r.c.e.t c.e.t r.a.t r.b.t (cx-align G r.c c) r.d ;

at-me (G a b A : GA) (r : LiftME[G,a,b,A]) (c : LiftCx[G]) : ME c.e.t r.x.t r.y.t r.t.t =
  move-me r.c.e.t c.e.t r.x.t r.y.t r.t.t (cx-align G r.c c) r.d ;

at-se (D s t G : GA) (r : LiftSE[D,s,t,G]) (c : LiftCx[D]) (k : LiftCx[G]) : SE c.e.t r.x.t r.y.t k.e.t =
  move-se r.c.e.t c.e.t r.k.e.t k.e.t r.x.t r.y.t (cx-align D r.c c) (cx-align G r.k k) r.d ;

tm-at-type (G a A : GA) (r : LiftTm[G,a,A]) (c : LiftCx[G]) (A' : LiftExpr[A]) (h : Ty c.e.t A'.t) :
    Tm' c.e.t r.x.t A'.t =
  fm-conv c.e.t r.x.t r.t.t A'.t r' (ty-align G A c r.t A' (fpresup (fjtm c.e.t r.x.t r.t.t) r').2 h)
  where { r' : Tm' c.e.t r.x.t r.t.t = at-tm G a A r c ; } ;

me-at-type (G a b A : GA) (r : LiftME[G,a,b,A]) (c : LiftCx[G]) (A' : LiftExpr[A]) (h : Ty c.e.t A'.t) :
    ME c.e.t r.x.t r.y.t A'.t =
  fm-eqconv c.e.t r.x.t r.y.t r.t.t A'.t r' (ty-align G A c r.t A' (fpresup (fjeqtm c.e.t r.x.t r.y.t r.t.t) r').2.1 h)
  where { r' : ME c.e.t r.x.t r.y.t r.t.t = at-me G a b A r c ; } ;

lift-uu-bound (G : FA) (X : GA) (n : Nat) (A : LiftExpr[auu n X]) (h : Ty G A.t) : LeN n N =
  f-universe-bound G v.1.1 n (Prelude[l].subst FA (\ Y -> Ty G Y) A.t (fuu n v.1.1)
    (Prelude[l].sym FA (fuu n v.1.1) A.t v.2) h)
 where { v : Repr (auu n X) A.t = shape-view (auu n X) A.t A.image ; } ;

tm-bound (G a : GA) (n : Nat) (r : LiftTm[G,a,auu n G]) : LeN n N =
  lift-uu-bound r.c.e.t G n r.t (fpresup (fjtm r.c.e.t r.x.t r.t.t) r.d).2 ;

me-bound (G a b : GA) (n : Nat) (r : LiftME[G,a,b,auu n G]) : LeN n N =
  lift-uu-bound r.c.e.t G n r.t (fpresup (fjeqtm r.c.e.t r.x.t r.y.t r.t.t) r.d).2.1 ;

tm-at-uu (G a : GA) (n : Nat) (r : LiftTm[G,a,auu n G]) (c : LiftCx[G]) : Tm' c.e.t r.x.t (fuu n c.e.t) =
  tm-at-type G a (auu n G) r c (e-uu n G c.e) (ft-uu c.e.t n c.ok (tm-bound G a n r)) ;

me-at-uu (G a b : GA) (n : Nat) (r : LiftME[G,a,b,auu n G]) (c : LiftCx[G]) : ME c.e.t r.x.t r.y.t (fuu n c.e.t) =
  me-at-type G a b (auu n G) r c (e-uu n G c.e) (ft-uu c.e.t n c.ok (me-bound G a b n r)) ;

-- A fixed-context witness keeps the caller's representatives in the index.
LiftAt : GAJ -> U l = split {
  ajwf G -> LiftCx[G] ;
  ajty G A -> (c : LiftCx[G]) -> LiftTy[G,A,c] ;
  ajtm G a A -> (c : LiftCx[G]) -> LiftTm[G,a,A,c] ;
  ajsub D s G -> (c : LiftCx[D]) -> (k : LiftCx[G]) -> LiftSub[D,s,G,c,k] ;
  ajeqcx G H -> (c : LiftCx[G]) -> (k : LiftCx[H]) -> LiftCE[G,H,c,k] ;
  ajeqty G A B -> (c : LiftCx[G]) -> LiftTE[G,A,B,c] ;
  ajeqtm G a b A -> (c : LiftCx[G]) -> LiftME[G,a,b,A,c] ;
  ajeqsub D s t G -> (c : LiftCx[D]) -> (k : LiftCx[G]) -> LiftSE[D,s,t,G,c,k] } ;

fix-lift : (J : GAJ) -> LiftJ J -> LiftAt J = split {
  ajwf G -> \ r -> r ;
  ajty G A -> \ r c -> new LiftTy[G,A,c,a := r.a,d := at-ty G A r c] ;
  ajtm G a A -> \ r c -> new LiftTm[G,a,A,c,x := r.x,t := r.t,d := at-tm G a A r c] ;
  ajsub D s G -> \ r c k -> new LiftSub[D,s,G,c,k,x := r.x,d := at-sub D s G r c k] ;
  ajeqcx G H -> \ r c k -> new LiftCE[G,H,c,k,d := at-ce G H r c k] ;
  ajeqty G A B -> \ r c -> new LiftTE[G,A,B,c,a := r.a,b := r.b,d := at-te G A B r c] ;
  ajeqtm G a b A -> \ r c -> new LiftME[G,a,b,A,c,x := r.x,y := r.y,t := r.t,d := at-me G a b A r c] ;
  ajeqsub D s t G -> \ r c k -> new LiftSE[D,s,t,G,c,k,x := r.x,y := r.y,d := at-se D s t G r c k] } ;

record Annotation {
  J : GAJ ; j : FAJ ; image : Id GAJ (ffJ j) J ; der : FADer j
} ;

image-J2 (f : GA -> GA -> GAJ) (X Y : GA) (x : LiftExpr[X]) (y : LiftExpr[Y]) :
    Id GAJ (f (ff x.t) (ff y.t)) (f X Y) =
  TSyntax[l].cong2 GA GA GAJ f (ff x.t) X (ff y.t) Y x.image y.image ;

image-J3 (f : GA -> GA -> GA -> GAJ) (X Y Z : GA) (x : LiftExpr[X]) (y : LiftExpr[Y]) (z : LiftExpr[Z]) :
    Id GAJ (f (ff x.t) (ff y.t) (ff z.t)) (f X Y Z) =
  Prelude[l].trans GAJ (f (ff x.t) (ff y.t) (ff z.t)) (f (ff x.t) Y Z) (f X Y Z)
    (image-J2 (f (ff x.t)) Y Z y z)
    (Prelude[l].ap GA GAJ (\ A -> f A Y Z) (ff x.t) X x.image) ;

image-J4 (f : GA -> GA -> GA -> GA -> GAJ) (X Y Z K : GA)
    (x : LiftExpr[X]) (y : LiftExpr[Y]) (z : LiftExpr[Z]) (k : LiftExpr[K]) :
    Id GAJ (f (ff x.t) (ff y.t) (ff z.t) (ff k.t)) (f X Y Z K) =
  Prelude[l].trans GAJ (f (ff x.t) (ff y.t) (ff z.t) (ff k.t)) (f (ff x.t) Y Z K) (f X Y Z K)
    (image-J3 (f (ff x.t)) Y Z K y z k)
    (Prelude[l].ap GA GAJ (\ A -> f A Y Z K) (ff x.t) X x.image) ;

pack-lift : (J : GAJ) -> LiftJ J -> Annotation[J] = split {
  ajwf G -> \ r -> new Annotation[ajwf G,j := fjwf r.e.t,
    image := Prelude[l].ap GA GAJ (\ X -> ajwf X) (ff r.e.t) G r.e.image,der := r.ok] ;
  ajty G A -> \ r -> new Annotation[ajty G A,j := fjty r.c.e.t r.a.t,
    image := image-J2 (\ X Y -> ajty X Y) G A r.c.e r.a,der := r.d] ;
  ajtm G a A -> \ r -> new Annotation[ajtm G a A,j := fjtm r.c.e.t r.x.t r.t.t,
    image := image-J3 (\ X x Y -> ajtm X x Y) G a A r.c.e r.x r.t,der := r.d] ;
  ajsub D s G -> \ r -> new Annotation[ajsub D s G,j := fjsub r.c.e.t r.x.t r.k.e.t,
    image := image-J3 (\ X x Y -> ajsub X x Y) D s G r.c.e r.x r.k.e,der := r.d] ;
  ajeqcx G H -> \ r -> new Annotation[ajeqcx G H,j := fjeqcx r.c.e.t r.k.e.t,
    image := image-J2 (\ X Y -> ajeqcx X Y) G H r.c.e r.k.e,der := r.d] ;
  ajeqty G A B -> \ r -> new Annotation[ajeqty G A B,j := fjeqty r.c.e.t r.a.t r.b.t,
    image := image-J3 (\ X Y Z -> ajeqty X Y Z) G A B r.c.e r.a r.b,der := r.d] ;
  ajeqtm G a b A -> \ r -> new Annotation[ajeqtm G a b A,j := fjeqtm r.c.e.t r.x.t r.y.t r.t.t,
    image := image-J4 (\ X x y Y -> ajeqtm X x y Y) G a b A r.c.e r.x r.y r.t,der := r.d] ;
  ajeqsub D s t G -> \ r -> new Annotation[ajeqsub D s t G,j := fjeqsub r.c.e.t r.x.t r.y.t r.k.e.t,
    image := image-J4 (\ X x y Y -> ajeqsub X x y Y) D s t G r.c.e r.x r.y r.k.e,der := r.d] } ;
