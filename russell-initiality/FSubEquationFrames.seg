-- Endpoints of the substitution equations, with their introduced frames.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FSubstLaws[l] ;

lift-eq-frame {D G A B s t : FA} (wD : W D) (wG : W G)
    (hA : Ty G A) (hB : Ty G B) (eA : TE G A B) (hs : Sb D s G) (ht : Sb D t G) (e : SE D s t G) :
    FPJ (fjeqsub (fext D (ftsb D G A s)) (flift D G A s) (flift D G B t) (fext G A)) =
  (ext-wf ha,(ext-wf hA,(lift-sub hA hs,
    sub-cx (ext-wf ha) (ext-wf hA)
      (ext-eq (cx-refl wD) (ty-sym (sb-ty-cong hA eA hs ht e)))
      (ext-eq (cx-refl wG) (ty-sym eA)) (lift-sub hB ht))))
 where {
  ha : Ty D (ftsb D G A s) = ty-sub hA hs ;
 } ;

lift-id-frame {G A : FA} (w : W G) (h : Ty G A) :
    FPJ (fjeqsub (fext G (ftsb G G A (fid G))) (flift G G A (fid G)) (fid (fext G A)) (fext G A)) =
  (source,(target,(lift-sub h (id-sub w),
    sub-cx source target (ext-eq (cx-refl w) (ty-sym (fe-sb-id G A h))) (cx-refl target) (id-sub target))))
 where {
  source : W (fext G (ftsb G G A (fid G))) = ext-wf (ty-sub h (id-sub w)) ;
  target : W (fext G A) = ext-wf h ;
 } ;

lift-comp-frame {T D G A s d : FA} (w : W T) (hA : Ty G A) (hs : Sb D s G) (hd : Sb T d D) :
    FPJ (fjeqsub (fext T (ftsb T G A (fcomp T D G s d))) (flift T G A (fcomp T D G s d))
      (fcomp (fext T (ftsb T D (ftsb D G A s) d)) (fext D (ftsb D G A s)) (fext G A)
        (flift D G A s) (flift T D (ftsb D G A s) d)) (fext G A)) =
  (source,(target,(lift-sub hA (comp-sub hs hd),
    sub-cx source target (ext-eq (cx-refl w) (sb-comp-ty hA hs hd)) (cx-refl target)
      (comp-sub (lift-sub hA hs) (lift-sub (ty-sub hA hs) hd)))))
 where {
  source : W (fext T (ftsb T G A (fcomp T D G s d))) = ext-wf (ty-sub hA (comp-sub hs hd)) ;
  target : W (fext G A) = ext-wf hA ;
 } ;

p-cx-frame {G H A B : FA} (wG : W G) (wH : W H) (e : CE G H) (back : CE H G) (eA : TE G A B)
    (hA : Ty G A) (hB : Ty G B) : FPJ (fjeqsub (fext G A) (fp G A) (fp H B) G) =
  (ext-wf hA,(wG,(p-sub hA,
    sub-cx (ext-wf hA) wG (ext-eq back (te-cx wH e (ty-sym eA))) back (p-sub (ty-cx wH e hB))))) ;

q-cx-frame {G H A B : FA} (wG : W G) (wH : W H) (e : CE G H) (back : CE H G) (eA : TE G A B)
    (hA : Ty G A) (hB : Ty G B) :
    FPJ (fjeqtm (fext G A) (fq G A) (fq H B) (ftsb (fext G A) G A (fp G A))) =
  (ext-wf hA,(ty-sub hA (p-sub hA),(q-tm hA,
    tm-conv {fext G A} {fq H B} {ftsb (fext H B) H B (fp H B)} {ftsb (fext G A) G A (fp G A)}
      (tm-cx (ext-wf hA) (ext-eq back (te-cx wH e (ty-sym eA))) (q-tm hB'))
      (ty-sym (sub-frame-eq (ext-wf hA) wH (ext-eq e eA) e hA hB eA (p-sub hA) frame.2.2.2
        (fq-p-cx G H A B e eA))))))
 where {
  hB' : Ty H B = ty-cx wH e hB ;
  frame : FPJ (fjeqsub (fext G A) (fp G A) (fp H B) G) = p-cx-frame wG wH e back eA hA hB ;
 } ;
