-- L18Bind.seg: Lemma 18, the environments met under binders and at [a].
--   rel-up-sub   (up e) lift(s) ~ up (e s)          (naturality under a binder)
--   rel-up-evs   ev (lift s) (up e) ~ up (ev s e)    (substitution under a binder)
--   good-id, good-sub1
--   rel-sec      (up e) sec(a) ~ ev [a] e ;  ty-sec  (B under up e) sec(a) = ev B (ev [a] e)

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ;

rel-up-sub (G : Cx) (A : Tm) (cI : CI G A) (D T s : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (wT : GDer (gjwf T))
    (hs : GDer (gjsub T s D)) (o : EnvOk D G e) :
    Rel (gext T (gsb (ev A e) s)) (csnoc G A) (esb (up e) (glift (ev A e) s)) (up (esb e s)) =
  (env-sub (gext D (ev A e)) (gext T (gsb (ev A e) s)) (glift (ev A e) s) (g-ext D (ev A e) (cI.2.1 D e wD o))
     (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (gs-lift T D (ev A e) s hs (cI.2.1 D e wD o))
     (csnoc G A) cI (up e) (env-up D e wD G A cI o),
   (env-up' T (gsb (ev A e) s) (esb e s) wT (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs) G A cI
      (env-sub D T s wD wT hs G cI.1 e o) (cI.2.2.1 D e T s wD wT o hs),
    (enveq-plift D T (ev A e) s wD wT (cI.2.1 D e wD o) hs G cI.1 e o,
     gm-eqconv (gext T (gsb (ev A e) s)) (gsb gq (glift (ev A e) s)) gq (gsb (gsb (ev A e) s) gp)
       (ev A (esb (esb e gp) (glift (ev A e) s)))
       (gm-q-lift T D (ev A e) s (cI.2.1 D e wD o) hs)
       (ge-trans (gext T (gsb (ev A e) s)) (gsb (gsb (ev A e) s) gp) (ev A (esb (esb e s) gp))
          (ev A (esb (esb e gp) (glift (ev A e) s)))
          (ge-trans (gext T (gsb (ev A e) s)) (gsb (gsb (ev A e) s) gp) (gsb (ev A (esb e s)) gp) (ev A (esb (esb e s) gp))
             (ge-sb (gext T (gsb (ev A e) s)) T (gsb (ev A e) s) (ev A (esb e s)) gp gp
                (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs) (cI.2.2.1 D e T s wD wT o hs)
                (gs-p T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs))
                (gs-p T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs))
                (gq-refl (gext T (gsb (ev A e) s)) gp T (gs-p T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs))))
             (cI.2.2.1 T (esb e s) (gext T (gsb (ev A e) s)) gp wT
                (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs))
                (env-sub D T s wD wT hs G cI.1 e o) (gs-p T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs))))
          (ge-sym (gext T (gsb (ev A e) s)) (ev A (esb (esb e gp) (glift (ev A e) s))) (ev A (esb (esb e s) gp))
             (cI.2.2.2 (gext T (gsb (ev A e) s)) (esb (esb e gp) (glift (ev A e) s)) (esb (esb e s) gp)
                (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs))
                ((env-sub (gext D (ev A e)) (gext T (gsb (ev A e) s)) (glift (ev A e) s) (g-ext D (ev A e) (cI.2.1 D e wD o))
                    (g-ext T (gsb (ev A e) s) (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs)) (gs-lift T D (ev A e) s hs (cI.2.1 D e wD o))
                    (csnoc G A) cI (up e) (env-up D e wD G A cI o)).1,
                 ((env-up' T (gsb (ev A e) s) (esb e s) wT (gt-sb T D (ev A e) s (cI.2.1 D e wD o) hs) G A cI
                     (env-sub D T s wD wT hs G cI.1 e o) (cI.2.2.1 D e T s wD wT o hs)).1,
                  enveq-plift D T (ev A e) s wD wT (cI.2.1 D e wD o) hs G cI.1 e o)))))))) ;

rel-up-evs (G0 G : Cx) (A : Tm) (c0 : CtxI G0) (cG : CtxS G) (cI : CI G A) (cGA : CtxS (csnoc G A))
    (s : Nat -> Tm) (g : Good G0 G s) (c0' : CtxI (csnoc G0 (Sub.trav A s)))
    (D X : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (hX : GDer (gjty D X)) (o : EnvOk D G0 e)
    (eqX : GDer (gjeqty D X (ev A (evs s e)))) (oU : EnvOk (gext D X) (csnoc G0 (Sub.trav A s)) (up e)) :
    Rel (gext D X) (csnoc G A) (evs (Sub.lift s) (up e)) (up (evs s e)) =
  (evs-ok (csnoc G0 (Sub.trav A s)) c0' (gext D X) (g-ext D X hX) (up e) oU (csnoc G A) cGA (Sub.lift s)
     (good-lift G0 G A s g c0'.2.1 c0'.2.2.1),
   (env-up' D X (evs s e) wD hX G A cI (evs-ok G0 c0 D wD e o G cG s g) eqX,
    (enveq-ptl (gext D X) G (evs s (esb e gp)) (\ i -> ev (wk (s i)) (up e)) (esb (evs s e) gp)
       (\ i -> symG (ev (wk (s i)) (up e)) (ev (s i) (esb e gp)) (ev-wk (s i) (up e)))
       (enveq-sym (gext D X) (g-ext D X hX) G (cs-ci G cG) (esb (evs s e) gp) (evs s (esb e gp))
          (env-sub D (gext D X) gp wD (g-ext D X hX) (gs-p D X hX) G (cs-ci G cG) (evs s e) (evs-ok G0 c0 D wD e o G cG s g))
          (evs-ok G0 c0 (gext D X) (g-ext D X hX) (esb e gp) (env-sub D (gext D X) gp wD (g-ext D X hX) (gs-p D X hX) G0 c0 e o)
             G cG s g)
          (enveq-good-sub G0 c0 D (gext D X) gp wD (g-ext D X hX) (gs-p D X hX) e o G cG s g)),
     gm-refl (gext D X) gq (ev A (\ i -> evs (Sub.lift s) (up e) (suc i)))
       (evs-ok (csnoc G0 (Sub.trav A s)) c0' (gext D X) (g-ext D X hX) (up e) oU (csnoc G A) cGA (Sub.lift s)
          (good-lift G0 G A s g c0'.2.1 c0'.2.2.1)).2))) ;

------------------------------------------------------------------------
-- the identity and [a] as Good substitutions

good-id : (G : Cx) -> CtxI G -> Good G G idS = split {
  cnil -> \ c -> tt ;
  csnoc G A | r -> \ c ->
    (good-wk G A G idS (r c.1),
     (pm-v0 G A (Sub.trav A (\ i -> var (suc i))) (ren-as-sub A (\ i -> suc i)),
      (nm-v0 G A (Sub.trav A (\ i -> var (suc i))) (ren-as-sub A (\ i -> suc i)) c.2.1 c.2.2.1,
       em-v0 G A (Sub.trav A (\ i -> var (suc i))) (ren-as-sub A (\ i -> suc i))))) } ;

good-sub1 (G : Cx) (c : CtxI G) (A a : Tm) (pa : PM G a A) (na : NM G a A) (ea : EM G a A) : Good G (csnoc G A) (sub1 a) =
  (good-id G c,
   (subst Tm (\ X -> PM G a X) A (Sub.trav A idS) (sym Tm (Sub.trav A idS) A (sub-id A)) pa,
    (subst Tm (\ X -> NM G a X) A (Sub.trav A idS) (sym Tm (Sub.trav A idS) A (sub-id A)) na,
     subst Tm (\ X -> EM G a X) A (Sub.trav A idS) (sym Tm (Sub.trav A idS) A (sub-id A)) ea))) ;

rel-sec (G : Cx) (A a : Tm) (cG : CtxS G) (cI : CI G A) (cGA : CtxS (csnoc G A))
    (pa : PM G a A) (na : NM G a A) (ea : EM G a A)
    (D X : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (hX : GDer (gjty D X)) (eX : GDer (gjeqty D X (ev A e)))
    (o : EnvOk D G e) (ha : GDer (gjtm D (ev a e) X)) :
    Rel D (csnoc G A) (esb (up e) (gsec X (ev a e))) (evs (sub1 a) e) =
  (env-sub (gext D X) D (gsec X (ev a e)) (g-ext D X hX) wD (gs-sec D X (ev a e) hX ha) (csnoc G A) cI (up e)
     (env-up' D X e wD hX G A cI o eX),
   (evs-ok G (cs-ci G cG) D wD e o (csnoc G A) cGA (sub1 a) (good-sub1 G (cs-ci G cG) A a pa na ea),
    (enveq-psec D X (ev a e) wD hX ha G cI.1 e o,
     gm-eqconv D (gsb gq (gsec X (ev a e))) (ev a e) X (ev A (esb (esb e gp) (gsec X (ev a e))))
       (gm-q-sec D X (ev a e) hX ha)
       (ge-trans D X (ev A e) (ev A (esb (esb e gp) (gsec X (ev a e)))) eX
          (ge-sym D (ev A (esb (esb e gp) (gsec X (ev a e)))) (ev A e)
             (cI.2.2.2 D (esb (esb e gp) (gsec X (ev a e))) e wD
                ((env-sub (gext D X) D (gsec X (ev a e)) (g-ext D X hX) wD (gs-sec D X (ev a e) hX ha) (csnoc G A) cI (up e)
                    (env-up' D X e wD hX G A cI o eX)).1,
                 (o, enveq-psec D X (ev a e) wD hX ha G cI.1 e o)))))))) ;

ty-sec (G : Cx) (A a B : Tm) (cG : CtxS G) (cI : CI G A) (cGA : CtxS (csnoc G A))
    (pa : PM G a A) (na : NM G a A) (ea : EM G a A) (nB : NT (csnoc G A) B) (eB : ET (csnoc G A) B)
    (D X : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (hX : GDer (gjty D X)) (eX : GDer (gjeqty D X (ev A e)))
    (o : EnvOk D G e) (ha : GDer (gjtm D (ev a e) X)) :
    GDer (gjeqty D (gsb (ev B (up e)) (gsec X (ev a e))) (ev B (evs (sub1 a) e))) =
  ge-trans D (gsb (ev B (up e)) (gsec X (ev a e))) (ev B (esb (up e) (gsec X (ev a e)))) (ev B (evs (sub1 a) e))
    (nB (gext D X) (up e) D (gsec X (ev a e)) (g-ext D X hX) wD (env-up' D X e wD hX G A cI o eX) (gs-sec D X (ev a e) hX ha))
    (eB D (esb (up e) (gsec X (ev a e))) (evs (sub1 a) e) wD (rel-sec G A a cG cI cGA pa na ea D X e wD hX eX o ha)) ;
