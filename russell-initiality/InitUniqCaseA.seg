-- InitUniqCaseA.seg (PLAN-INIT, Part U): the induction cases of
-- uniqueness for contexts, substitutions and types.  Formation case:
-- the step lemma ag-<op> of Part H at the canonical argument classes
-- (from the IHs, moved by ihT-at/ihE-at/ihS-at where the argument lives
-- over an extended context), moved along the class lemma cl-<op>.
-- Conversion case (gs-cx, gt-cx): the IH moved along tS-cx / tT-cx.
-- Arguments: the binders of the GDer constructor, its IHs (QJ of the
-- premises, in order), then the data of the target class.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lib[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitModelShape[l] ;
open InitUniqTot[l] ;
open InitUniqCls[l] ;
open InitUniqClsTm[l] ;

module Uq (e : Eqs) (M' : EM.TEModel[N]) {
  module Mo = InitHom.Morphism[l, N, mk e, M'] ;
  module HL = Mo.InitHomLaws ;
  module HS = Mo.InitHomStep ;

  module V (H H' : HL.Hom) {
    module Bs = InitUniqBase[l].Uq[e, M'].V[H, H'] ;
    open Bs ;

    ----------------------------------------------------------------------
    -- contexts

    case-g-nil (w : Pf (gjwf gnil)) : AgC (cls gnil w) =
      mvC nil (cls gnil w) (cl-nil w) (HS.ag-nil H H') ;

    case-g-ext (G A : GE) (h : GDer (gjty G A)) (ih1 : QT G A) (w : Pf (gjwf (gext G A))) : AgC (cls (gext G A) w) =
      mvC (eC G A hA wG) (cls (gext G A) w) (cl-ext G A hA wG w)
        (HS.ag-ext H H' (cls G wG) (cTy G A hA wG) (ih1 hA wG))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h ;
      wG : Pf (gjwf G) = wf-ty G A hA ;
     } ;

    ----------------------------------------------------------------------
    -- substitutions

    case-gs-id (G : GE) (h : GDer (gjwf G)) (ih1 : QC G) (h' : Pf (gjsub G gid G)) (w w2 : Pf (gjwf G)) :
      AgSt (tS G gid G h' w w2) =
      mvS _ _ (cl-id G w w2 h') (HS.ag-id H H' (cls G w) (ih1 w)) ;

    case-gs-comp (T D G s d : GE) (h1 : GDer (gjsub D s G)) (h2 : GDer (gjsub T d D)) (ih1 : QS D s G) (ih2 : QS T d D)
      (h : Pf (gjsub T (gcomp s d) G)) (wT : Pf (gjwf T)) (wG : Pf (gjwf G)) : AgSt (tS T (gcomp s d) G h wT wG) =
      mvS _ _ (cl-comp T D G s d hs hd wT wD wG h)
        (HS.ag-o H H' (cls T wT) (cls D wD) (cls G wG) (cSub D s G hs wD wG) (cSub T d D hd wT wD)
           (ih1 hs wD wG) (ih2 hd wT wD))
     where {
      hs : Pf (gjsub D s G) = pf (gjsub D s G) h1 ;
      hd : Pf (gjsub T d D) = pf (gjsub T d D) h2 ;
      wD : Pf (gjwf D) = wf-dom D s G hs ;
     } ;

    case-gs-eps (G : GE) (h : GDer (gjwf G)) (ih1 : QC G) (h' : Pf (gjsub G geps gnil)) (w : Pf (gjwf G))
      (wn : Pf (gjwf gnil)) : AgSt (tS G geps gnil h' w wn) =
      mvS _ _ (cl-eps G w wn h') (HS.ag-eps H H' (cls G w) (ih1 w)) ;

    case-gs-p (G A : GE) (h : GDer (gjty G A)) (ih1 : QT G A) (h' : Pf (gjsub (gext G A) gp G))
      (wE : Pf (gjwf (gext G A))) (w : Pf (gjwf G)) : AgSt (tS (gext G A) gp G h' wE w) =
      mvS _ _ (cl-p G A hA w wE h') (HS.ag-p H H' (cls G w) (cTy G A hA w) (ih1 hA w))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h ;
     } ;

    case-gs-lift (D G A s : GE) (h1 : GDer (gjsub D s G)) (h2 : GDer (gjty G A)) (ih1 : QS D s G) (ih2 : QT G A)
      (h : Pf (gjsub (gext D (gsb A s)) (glift A s) (gext G A))) (wE1 : Pf (gjwf (gext D (gsb A s))))
      (wE2 : Pf (gjwf (gext G A))) : AgSt (tS (gext D (gsb A s)) (glift A s) (gext G A) h wE1 wE2) =
      mvS _ _ (cl-lift D G A s hA hs wD wG wE1 wE2 h)
        (HS.ag-lift H H' (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG) (ih2 hA wG) (ih1 hs wD wG))
     where {
      hs : Pf (gjsub D s G) = pf (gjsub D s G) h1 ;
      hA : Pf (gjty G A) = pf (gjty G A) h2 ;
      wD : Pf (gjwf D) = wf-dom D s G hs ;
      wG : Pf (gjwf G) = wf-cod D s G hs ;
     } ;

    case-gs-sec (G A a : GE) (h1 : GDer (gjty G A)) (h2 : GDer (gjtm G a A)) (ih1 : QT G A) (ih2 : QE G a A)
      (h : Pf (gjsub G (gsec A a) (gext G A))) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
      AgSt (tS G (gsec A a) (gext G A) h w wE) =
      mvS _ _ (cl-sec G A a hA ha w wE h)
        (HS.ag-sec H H' (cls G w) (cTy G A hA w) (cEl G A a ha hA w) (ih2 ha hA w))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h1 ;
      ha : Pf (gjtm G a A) = pf (gjtm G a A) h2 ;
     } ;

    case-gs-cx (D D' G G' s : GE) (h0 : GDer (gjwf D')) (h0' : GDer (gjwf G')) (h1 : GDer (gjeqcx D D'))
      (h2 : GDer (gjeqcx G G')) (h : GDer (gjsub D s G))
      (ih1 : QC D') (ih2 : QC G') (ih3 : Top) (ih4 : Top) (ih5 : QS D s G)
      (h' : Pf (gjsub D' s G')) (wD' : Pf (gjwf D')) (wG' : Pf (gjwf G')) : AgSt (tS D' s G' h' wD' wG') =
      mvS _ _ (tS-cx D D' G G' s hs wD wG h' wD' wG' (pf (gjeqcx D D') h1) (pf (gjeqcx G G') h2)) (ih5 hs wD wG)
     where {
      hs : Pf (gjsub D s G) = pf (gjsub D s G) h ;
      wD : Pf (gjwf D) = wf-dom D s G hs ;
      wG : Pf (gjwf G) = wf-cod D s G hs ;
     } ;

    ----------------------------------------------------------------------
    -- types

    case-gt-pi (G A B : GE) (h1 : GDer (gjty G A)) (h2 : GDer (gjty (gext G A) B)) (ih1 : QT G A) (ih2 : QT (gext G A) B)
      (h : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) : AgTt (tT G (gpi A B) h w) =
      mvT _ _ (cl-Pi G A B hA hB w wE h)
        (HS.ag-Pi H H' (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (ih1 hA w)
           (ihT-at (gext G A) B ih2 hB wE (eC G A hA w) (eP G A hA w wE)))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h1 ;
      hB : Pf (gjty (gext G A) B) = pf (gjty (gext G A) B) h2 ;
      wE : Pf (gjwf (gext G A)) = wf-ty (gext G A) B hB ;
     } ;

    case-gt-uu (G : GE) (n : Nat) (h : GDer (gjwf G)) (nb : LeN n N) (ih1 : QC G)
      (h' : Pf (gjty G (guu n))) (w : Pf (gjwf G)) : AgTt (tT G (guu n) h' w) =
      mvT _ _ (cl-univ (n, nb) G w h') (HS.ag-univ H H' (n, nb) (cls G w) (ih1 w)) ;

    case-gt-el (G : GE) (n : Nat) (a : GE) (h : GDer (gjtm G a (guu n))) (ih1 : QE G a (guu n))
      (h' : Pf (gjty G (gel n a))) (w : Pf (gjwf G)) : AgTt (tT G (gel n a) h' w) =
      mvT _ _ (cl-decode n' G a ha hU w h')
        (HS.ag-decode H H' n' (cls G w) (codeC n' G a ha hU w)
           (ihE-at G a (guu n) ih1 ha hU w (cls G w) (refl (cls G w)) (univ n' (cls G w))
              (pUg n' (cls G w) G hU w (refl (cls G w)))))
     where {
      hd : GDer (gjty G (guu n)) = (GP.gpresup (gjtm G a (guu n)) h).2 ;
      n' : EM.LevelAt N = (n, g-universe-bound G n hd) ;
      ha : Pf (gjtm G a (guu n)) = pf (gjtm G a (guu n)) h ;
      hU : Pf (gjty G (guu n)) = pf (gjty G (guu n)) hd ;
     } ;

    case-gt-sb (D G A s : GE) (h1 : GDer (gjty G A)) (h2 : GDer (gjsub D s G)) (ih1 : QT G A) (ih2 : QS D s G)
      (h : Pf (gjty D (gsb A s))) (w : Pf (gjwf D)) : AgTt (tT D (gsb A s) h w) =
      mvT _ _ (cl-subT D G A s hA hs w wG h)
        (HS.ag-subT H H' (cls D w) (cls G wG) (cTy G A hA wG) (cSub D s G hs w wG) (ih1 hA wG) (ih2 hs w wG))
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h1 ;
      hs : Pf (gjsub D s G) = pf (gjsub D s G) h2 ;
      wG : Pf (gjwf G) = wf-cod D s G hs ;
     } ;

    case-gt-cx (G D A : GE) (h0 : GDer (gjwf D)) (h1 : GDer (gjeqcx G D)) (h2 : GDer (gjty G A))
      (ih1 : QC D) (ih2 : Top) (ih3 : QT G A)
      (h : Pf (gjty D A)) (w : Pf (gjwf D)) : AgTt (tT D A h w) =
      mvT _ _ (tT-cx G D A hA wG h w (pf (gjeqcx G D) h1)) (ih3 hA wG)
     where {
      hA : Pf (gjty G A) = pf (gjty G A) h2 ;
      wG : Pf (gjwf G) = wf-ty G A hA ;
     } ;
  } ;
} ;
