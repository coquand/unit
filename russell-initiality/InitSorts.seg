-- InitSorts.seg (PLAN-INIT, Part F, section 4): the sorts of the term
-- model of T_E.  Representatives are raw GE data with a MERE derivation
-- (Pf J = Sq (GDer J)) and paths to the fixed classes of their contexts
-- (and types); the relation is mere judgemental equality, stated at the
-- context (and type) of the FIRST representative.
--   Ctx          = CtxPre / gjeqcx,                    cls G w
--   Ty c         = TyPre c / gjeqty,                   clsTy c G A h w pc
--   El c T       = ElPre c T / gjeqtm,                 clsEl c T G A a h hA w pc pT
--   Sub d c      = SubPre d c / gjeqsub,               clsSub d c D s G h wD wG pd pc
-- For every sort: -eq (relates), -irr (same raw data, other proofs and
-- paths), same-* (effectiveness for two representatives of one class),
-- *-ind (induction into propositions), Rep* (a representative of a given
-- element, with its path) and rep-* (merely one exists), tr-* (transport
-- only changes the path components; el-transport is the special case of
-- the plan).  Derived rule eqsub-cx: context conversion of substitution
-- equality (GDer has gs-cx but no rule for gjeqsub).
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
module RG = B.RGAT[l] ;
open InitQuot[l] ;

------------------------------------------------------------------------
-- mere derivations

Pf (J : GJ) : U l = Sq (GDer J) ;
pf (J : GJ) (h : GDer J) : Pf J = sq (GDer J) h ;
pf-prop (J : GJ) : isProp (Pf J) = sq-prop (GDer J) ;
pf-map (J K : GJ) (f : GDer J -> GDer K) (a : Pf J) : Pf K = sq-map (GDer J) (GDer K) f a ;
pf-map2 (J1 J2 K : GJ) (f : GDer J1 -> GDer J2 -> GDer K) (a1 : Pf J1) (a2 : Pf J2) : Pf K =
  sq-map2 (GDer J1) (GDer J2) (GDer K) f a1 a2 ;
pf-map3 (J1 J2 J3 K : GJ) (f : GDer J1 -> GDer J2 -> GDer J3 -> GDer K)
  (a1 : Pf J1) (a2 : Pf J2) (a3 : Pf J3) : Pf K =
  sq-map3 (GDer J1) (GDer J2) (GDer J3) (GDer K) f a1 a2 a3 ;
pf-map4 (J1 J2 J3 J4 K : GJ) (f : GDer J1 -> GDer J2 -> GDer J3 -> GDer J4 -> GDer K)
  (a1 : Pf J1) (a2 : Pf J2) (a3 : Pf J3) (a4 : Pf J4) : Pf K =
  sq-map4 (GDer J1) (GDer J2) (GDer J3) (GDer J4) (GDer K) f a1 a2 a3 a4 ;
pf-map5 (J1 J2 J3 J4 J5 K : GJ) (f : GDer J1 -> GDer J2 -> GDer J3 -> GDer J4 -> GDer J5 -> GDer K)
  (a1 : Pf J1) (a2 : Pf J2) (a3 : Pf J3) (a4 : Pf J4) (a5 : Pf J5) : Pf K =
  sq-map5 (GDer J1) (GDer J2) (GDer J3) (GDer J4) (GDer J5) (GDer K) f a1 a2 a3 a4 a5 ;
pf-map6 (J1 J2 J3 J4 J5 J6 K : GJ)
  (f : GDer J1 -> GDer J2 -> GDer J3 -> GDer J4 -> GDer J5 -> GDer J6 -> GDer K)
  (a1 : Pf J1) (a2 : Pf J2) (a3 : Pf J3) (a4 : Pf J4) (a5 : Pf J5) (a6 : Pf J6) : Pf K =
  sq-map6 (GDer J1) (GDer J2) (GDer J3) (GDer J4) (GDer J5) (GDer J6) (GDer K) f a1 a2 a3 a4 a5 a6 ;

-- presuppositions, merely
wf-ty (G A : GE) (h : Pf (gjty G A)) : Pf (gjwf G) =
  pf-map (gjty G A) (gjwf G) (\ k -> GP.gpresup (gjty G A) k) h ;
wf-tm (G a A : GE) (h : Pf (gjtm G a A)) : Pf (gjwf G) =
  pf-map (gjtm G a A) (gjwf G) (\ k -> (GP.gpresup (gjtm G a A) k).1) h ;
ty-tm (G a A : GE) (h : Pf (gjtm G a A)) : Pf (gjty G A) =
  pf-map (gjtm G a A) (gjty G A) (\ k -> (GP.gpresup (gjtm G a A) k).2) h ;
wf-dom (D s G : GE) (h : Pf (gjsub D s G)) : Pf (gjwf D) =
  pf-map (gjsub D s G) (gjwf D) (\ k -> (GP.gpresup (gjsub D s G) k).1) h ;
wf-cod (D s G : GE) (h : Pf (gjsub D s G)) : Pf (gjwf G) =
  pf-map (gjsub D s G) (gjwf G) (\ k -> (GP.gpresup (gjsub D s G) k).2) h ;

------------------------------------------------------------------------
-- derived rule: context conversion of substitution equality,
-- s = s gid = t gid = t  and  s = gid s = gid t = t

eqsub-cx (D D' G G' s t : GE) (wD' : GDer (gjwf D')) (wG' : GDer (gjwf G'))
  (eD : GDer (gjeqcx D D')) (eG : GDer (gjeqcx G G')) (h : GDer (gjeqsub D s t G)) :
  GDer (gjeqsub D' s t G') =
  gq-trans D' s (gcomp gid s) t G'
    (gq-sym D' (gcomp gid s) s G' (gq-idl D' G' s s2))
    (gq-trans D' (gcomp gid s) (gcomp gid t) t G' h2a (gq-idl D' G' t t2))
 where {
  pre : GP.GPJ (gjeqsub D s t G) = GP.gpresup (gjeqsub D s t G) h ;
  wD : GDer (gjwf D) = pre.1 ;
  wG : GDer (gjwf G) = pre.2.1 ;
  hs : GDer (gjsub D s G) = pre.2.2.1 ;
  ht : GDer (gjsub D t G) = pre.2.2.2 ;
  i : GDer (gjsub D' gid D) =
    gs-cx D' D' D' D gid wD' wD (gc-refl D' wD') (RG.cx-sym D D' eD) (gs-id D' wD') ;
  s1 : GDer (gjsub D' s G) = gs-cx D D' G G s wD' wG eD (gc-refl G wG) hs ;
  t1 : GDer (gjsub D' t G) = gs-cx D D' G G t wD' wG eD (gc-refl G wG) ht ;
  h1a : GDer (gjeqsub D' (gcomp s gid) (gcomp t gid) G) =
    gq-comp D' D G s t gid gid h (gq-refl D' gid D i) ;
  h1 : GDer (gjeqsub D' s t G) =
    gq-trans D' s (gcomp s gid) t G
      (gq-sym D' (gcomp s gid) s G (gq-idr D' G s s1))
      (gq-trans D' (gcomp s gid) (gcomp t gid) t G h1a (gq-idr D' G t t1)) ;
  j : GDer (gjsub G gid G') =
    gs-cx G G G G' gid wG wG' (gc-refl G wG) eG (gs-id G wG) ;
  h2a : GDer (gjeqsub D' (gcomp gid s) (gcomp gid t) G') =
    gq-comp D' G G' gid gid s t (gq-refl G gid G' j) h1 ;
  s2 : GDer (gjsub D' s G') = gs-cx D D' G G' s wD' wG' eD eG hs ;
  t2 : GDer (gjsub D' t G') = gs-cx D D' G G' t wD' wG' eD eG ht ;
 } ;

------------------------------------------------------------------------
-- contexts

CtxPre : U l = (G : GE) * Pf (gjwf G) ;
cx-rel (x y : CtxPre) : U l = Pf (gjeqcx x.1 y.1) ;
module CQ = Quot[CtxPre, cx-rel, \ x y -> pf-prop (gjeqcx x.1 y.1),
  \ x -> pf-map (gjwf x.1) (gjeqcx x.1 x.1) (\ k -> gc-refl x.1 k) x.2,
  \ x y -> pf-map (gjeqcx x.1 y.1) (gjeqcx y.1 x.1) (RG.cx-sym x.1 y.1),
  \ x y z -> pf-map2 (gjeqcx x.1 y.1) (gjeqcx y.1 z.1) (gjeqcx x.1 z.1) (RG.cx-trans x.1 y.1 z.1)] ;

Ctx : U l = CQ.Q ;
isSetCtx : isSet Ctx = CQ.set ;
cls (G : GE) (w : Pf (gjwf G)) : Ctx = CQ.inc (G, w) ;

cls-eq (G G' : GE) (w : Pf (gjwf G)) (w' : Pf (gjwf G')) (e : Pf (gjeqcx G G')) :
  Id Ctx (cls G w) (cls G' w') = CQ.relates (G, w) (G', w') e ;
cls-irr (G : GE) (w w' : Pf (gjwf G)) : Id Ctx (cls G w) (cls G w') =
  cls-eq G G w w' (pf-map (gjwf G) (gjeqcx G G) (\ k -> gc-refl G k) w) ;
cls-eff (G G' : GE) (w : Pf (gjwf G)) (w' : Pf (gjwf G')) (p : Id Ctx (cls G w) (cls G' w')) :
  Pf (gjeqcx G G') = CQ.effective (G, w) (G', w') p ;
same-cx (c : Ctx) (G G' : GE) (w : Pf (gjwf G)) (w' : Pf (gjwf G'))
  (p : Id Ctx (cls G w) c) (p' : Id Ctx (cls G' w') c) : Pf (gjeqcx G G') =
  cls-eff G G' w w' (trans Ctx (cls G w) c (cls G' w') p (sym Ctx (cls G' w') c p')) ;
ctx-ind (P : Ctx -> U l) (pP : (c : Ctx) -> isProp (P c))
  (f : (G : GE) (w : Pf (gjwf G)) -> P (cls G w)) (c : Ctx) : P c =
  CQ.induction @l P pP (\ x -> f x.1 x.2) c ;

-- a representative of a context class
RepCtx (c : Ctx) : U l = (G : GE) * ((w : Pf (gjwf G)) * Id Ctx (cls G w) c) ;
rep-ctx (c : Ctx) : Sq (RepCtx c) =
  sq-map ((x : CtxPre) * Id Ctx (CQ.inc x) c) (RepCtx c) (\ y -> (y.1.1, (y.1.2, y.2))) (CQ.rep c) ;

------------------------------------------------------------------------
-- types over a context class

TyPre (c : Ctx) : U l = (G : GE) * ((A : GE) * ((h : Pf (gjty G A)) * ((w : Pf (gjwf G)) * Id Ctx (cls G w) c))) ;
tyG (c : Ctx) (x : TyPre c) : GE = x.1 ;
tyA (c : Ctx) (x : TyPre c) : GE = x.2.1 ;
tyH (c : Ctx) (x : TyPre c) : Pf (gjty (tyG c x) (tyA c x)) = x.2.2.1 ;
tyW (c : Ctx) (x : TyPre c) : Pf (gjwf (tyG c x)) = x.2.2.2.1 ;
tyP (c : Ctx) (x : TyPre c) : Id Ctx (cls (tyG c x) (tyW c x)) c = x.2.2.2.2 ;

module TQ (c : Ctx) {
  rel (x y : TyPre c) : U l = Pf (gjeqty (tyG c x) (tyA c x) (tyA c y)) ;
  cx (x y : TyPre c) : Pf (gjeqcx (tyG c x) (tyG c y)) =
    same-cx c (tyG c x) (tyG c y) (tyW c x) (tyW c y) (tyP c x) (tyP c y) ;
  rr (x : TyPre c) : rel x x =
    pf-map (gjty (tyG c x) (tyA c x)) (gjeqty (tyG c x) (tyA c x) (tyA c x)) (\ k -> ge-refl (tyG c x) (tyA c x) k) (tyH c x) ;
  rs (x y : TyPre c) (e : rel x y) : rel y x =
    pf-map3 (gjeqty (tyG c x) (tyA c x) (tyA c y)) (gjeqcx (tyG c x) (tyG c y)) (gjwf (tyG c y))
      (gjeqty (tyG c y) (tyA c y) (tyA c x))
      (\ e0 k w -> ge-cx (tyG c x) (tyG c y) (tyA c y) (tyA c x) w k (ge-sym (tyG c x) (tyA c x) (tyA c y) e0))
      e (cx x y) (tyW c y) ;
  rt (x y z : TyPre c) (e1 : rel x y) (e2 : rel y z) : rel x z =
    pf-map4 (gjeqty (tyG c x) (tyA c x) (tyA c y)) (gjeqty (tyG c y) (tyA c y) (tyA c z))
      (gjeqcx (tyG c y) (tyG c x)) (gjwf (tyG c x)) (gjeqty (tyG c x) (tyA c x) (tyA c z))
      (\ f1 f2 k w -> ge-trans (tyG c x) (tyA c x) (tyA c y) (tyA c z) f1
        (ge-cx (tyG c y) (tyG c x) (tyA c y) (tyA c z) w k f2))
      e1 e2 (cx y x) (tyW c x) ;
  module Q = Quot[TyPre c, rel, \ x y -> pf-prop (gjeqty (tyG c x) (tyA c x) (tyA c y)), rr, rs, rt] ;
} ;

Ty (c : Ctx) : U l = TQ[c].Q.Q ;
isSetTy (c : Ctx) : isSet (Ty c) = TQ[c].Q.set ;
clsTy (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) : Ty c =
  TQ[c].Q.inc (G, (A, (h, (w, pc)))) ;

clsTy-eq (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (G' A' : GE) (h' : Pf (gjty G' A')) (w' : Pf (gjwf G')) (pc' : Id Ctx (cls G' w') c)
  (e : Pf (gjeqty G A A')) : Id (Ty c) (clsTy c G A h w pc) (clsTy c G' A' h' w' pc') =
  TQ[c].Q.relates (G, (A, (h, (w, pc)))) (G', (A', (h', (w', pc')))) e ;
clsTy-irr (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (h' : Pf (gjty G A)) (w' : Pf (gjwf G)) (pc' : Id Ctx (cls G w') c) :
  Id (Ty c) (clsTy c G A h w pc) (clsTy c G A h' w' pc') =
  clsTy-eq c G A h w pc G A h' w' pc' (pf-map (gjty G A) (gjeqty G A A) (\ k -> ge-refl G A k) h) ;
-- move a type to another representative context of the same class
ty-move (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (G' : GE) (w' : Pf (gjwf G')) (pc' : Id Ctx (cls G' w') c) : Pf (gjty G' A) =
  pf-map3 (gjeqcx G G') (gjwf G') (gjty G A) (gjty G' A) (\ k v t -> gt-cx G G' A v k t)
    (same-cx c G G' w w' pc pc') w' h ;
clsTy-move (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (G' : GE) (h' : Pf (gjty G' A)) (w' : Pf (gjwf G')) (pc' : Id Ctx (cls G' w') c) :
  Id (Ty c) (clsTy c G A h w pc) (clsTy c G' A h' w' pc') =
  clsTy-eq c G A h w pc G' A h' w' pc' (pf-map (gjty G A) (gjeqty G A A) (\ k -> ge-refl G A k) h) ;
clsTy-eff (c : Ctx) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (G' A' : GE) (h' : Pf (gjty G' A')) (w' : Pf (gjwf G')) (pc' : Id Ctx (cls G' w') c)
  (p : Id (Ty c) (clsTy c G A h w pc) (clsTy c G' A' h' w' pc')) : Pf (gjeqty G A A') =
  TQ[c].Q.effective (G, (A, (h, (w, pc)))) (G', (A', (h', (w', pc')))) p ;
same-ty (c : Ctx) (T : Ty c)
  (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (G' A' : GE) (h' : Pf (gjty G' A')) (w' : Pf (gjwf G')) (pc' : Id Ctx (cls G' w') c)
  (e : Id (Ty c) (clsTy c G A h w pc) T) (e' : Id (Ty c) (clsTy c G' A' h' w' pc') T) : Pf (gjeqty G A A') =
  clsTy-eff c G A h w pc G' A' h' w' pc'
    (trans (Ty c) (clsTy c G A h w pc) T (clsTy c G' A' h' w' pc') e (sym (Ty c) (clsTy c G' A' h' w' pc') T e')) ;
ty-ind (c : Ctx) (P : Ty c -> U l) (pP : (T : Ty c) -> isProp (P T))
  (f : (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c) -> P (clsTy c G A h w pc))
  (T : Ty c) : P T =
  TQ[c].Q.induction @l P pP (\ x -> f x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2) T ;

-- a representative of a given type, with its path
RepTy (c : Ctx) (T : Ty c) : U l =
  (x : TyPre c) * Id (Ty c) (clsTy c (tyG c x) (tyA c x) (tyH c x) (tyW c x) (tyP c x)) T ;
mkRepTy (c : Ctx) (T : Ty c) (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G)) (pc : Id Ctx (cls G w) c)
  (e : Id (Ty c) (clsTy c G A h w pc) T) : RepTy c T = ((G, (A, (h, (w, pc)))), e) ;
rep-ty (c : Ctx) (T : Ty c) : Sq (RepTy c T) =
  sq-map ((x : TyPre c) * Id (Ty c) (TQ[c].Q.inc x) T) (RepTy c T) (\ y -> (y.1, y.2)) (TQ[c].Q.rep T) ;
-- accessors of a representative with its path
rtG (c : Ctx) (T : Ty c) (r : RepTy c T) : GE = tyG c r.1 ;
rtA (c : Ctx) (T : Ty c) (r : RepTy c T) : GE = tyA c r.1 ;
rtH (c : Ctx) (T : Ty c) (r : RepTy c T) : Pf (gjty (rtG c T r) (rtA c T r)) = tyH c r.1 ;
rtW (c : Ctx) (T : Ty c) (r : RepTy c T) : Pf (gjwf (rtG c T r)) = tyW c r.1 ;
rtP (c : Ctx) (T : Ty c) (r : RepTy c T) : Id Ctx (cls (rtG c T r) (rtW c T r)) c = tyP c r.1 ;
rtE (c : Ctx) (T : Ty c) (r : RepTy c T) :
  Id (Ty c) (clsTy c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r)) T = r.2 ;

------------------------------------------------------------------------
-- elements of a type over a context class

ElPre (c : Ctx) (T : Ty c) : U l =
  (G : GE) * ((A : GE) * ((a : GE) * ((h : Pf (gjtm G a A)) * ((hA : Pf (gjty G A)) *
    ((w : Pf (gjwf G)) * ((pc : Id Ctx (cls G w) c) * Id (Ty c) (clsTy c G A hA w pc) T)))))) ;
elG (c : Ctx) (T : Ty c) (x : ElPre c T) : GE = x.1 ;
elA (c : Ctx) (T : Ty c) (x : ElPre c T) : GE = x.2.1 ;
ela (c : Ctx) (T : Ty c) (x : ElPre c T) : GE = x.2.2.1 ;
elH (c : Ctx) (T : Ty c) (x : ElPre c T) : Pf (gjtm (elG c T x) (ela c T x) (elA c T x)) = x.2.2.2.1 ;
elHA (c : Ctx) (T : Ty c) (x : ElPre c T) : Pf (gjty (elG c T x) (elA c T x)) = x.2.2.2.2.1 ;
elW (c : Ctx) (T : Ty c) (x : ElPre c T) : Pf (gjwf (elG c T x)) = x.2.2.2.2.2.1 ;
elP (c : Ctx) (T : Ty c) (x : ElPre c T) : Id Ctx (cls (elG c T x) (elW c T x)) c = x.2.2.2.2.2.2.1 ;
elE (c : Ctx) (T : Ty c) (x : ElPre c T) :
  Id (Ty c) (clsTy c (elG c T x) (elA c T x) (elHA c T x) (elW c T x) (elP c T x)) T = x.2.2.2.2.2.2.2 ;

module EQ (c : Ctx) (T : Ty c) {
  rel (x y : ElPre c T) : U l = Pf (gjeqtm (elG c T x) (ela c T x) (ela c T y) (elA c T x)) ;
  cx (x y : ElPre c T) : Pf (gjeqcx (elG c T x) (elG c T y)) =
    same-cx c (elG c T x) (elG c T y) (elW c T x) (elW c T y) (elP c T x) (elP c T y) ;
  ty (x y : ElPre c T) : Pf (gjeqty (elG c T x) (elA c T x) (elA c T y)) =
    same-ty c T (elG c T x) (elA c T x) (elHA c T x) (elW c T x) (elP c T x)
      (elG c T y) (elA c T y) (elHA c T y) (elW c T y) (elP c T y) (elE c T x) (elE c T y) ;
  rr (x : ElPre c T) : rel x x =
    pf-map (gjtm (elG c T x) (ela c T x) (elA c T x)) (gjeqtm (elG c T x) (ela c T x) (ela c T x) (elA c T x))
      (\ k -> gm-refl (elG c T x) (ela c T x) (elA c T x) k) (elH c T x) ;
  rs (x y : ElPre c T) (e : rel x y) : rel y x =
    pf-map5 (gjeqtm (elG c T x) (ela c T x) (ela c T y) (elA c T x)) (gjty (elG c T x) (elA c T x))
      (gjeqty (elG c T x) (elA c T x) (elA c T y)) (gjeqcx (elG c T x) (elG c T y)) (gjwf (elG c T y))
      (gjeqtm (elG c T y) (ela c T y) (ela c T x) (elA c T y))
      (\ e0 hA t k w -> gm-ecx (elG c T x) (elG c T y) (ela c T y) (ela c T x) (elA c T y) w k
        (gm-eqconv (elG c T x) (ela c T y) (ela c T x) (elA c T x) (elA c T y)
          (gm-sym (elG c T x) (ela c T x) (ela c T y) (elA c T x) hA e0) t))
      e (elHA c T x) (ty x y) (cx x y) (elW c T y) ;
  rt (x y z : ElPre c T) (e1 : rel x y) (e2 : rel y z) : rel x z =
    pf-map5 (gjeqtm (elG c T x) (ela c T x) (ela c T y) (elA c T x))
      (gjeqtm (elG c T y) (ela c T y) (ela c T z) (elA c T y))
      (gjeqty (elG c T x) (elA c T x) (elA c T y)) (gjeqcx (elG c T y) (elG c T x)) (gjwf (elG c T x))
      (gjeqtm (elG c T x) (ela c T x) (ela c T z) (elA c T x))
      (\ f1 f2 t k w -> gm-trans (elG c T x) (ela c T x) (ela c T y) (ela c T z) (elA c T x) f1
        (gm-eqconv (elG c T x) (ela c T y) (ela c T z) (elA c T y) (elA c T x)
          (gm-ecx (elG c T y) (elG c T x) (ela c T y) (ela c T z) (elA c T y) w k f2)
          (ge-sym (elG c T x) (elA c T x) (elA c T y) t)))
      e1 e2 (ty x y) (cx y x) (elW c T x) ;
  module Q = Quot[ElPre c T, rel, \ x y -> pf-prop (gjeqtm (elG c T x) (ela c T x) (ela c T y) (elA c T x)), rr, rs, rt] ;
} ;

El (c : Ctx) (T : Ty c) : U l = EQ[c,T].Q.Q ;
isSetEl (c : Ctx) (T : Ty c) : isSet (El c T) = EQ[c,T].Q.set ;
clsEl (c : Ctx) (T : Ty c) (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T) : El c T =
  EQ[c,T].Q.inc (G, (A, (a, (h, (hA, (w, (pc, pT))))))) ;

clsEl-eq (c : Ctx) (T : Ty c)
  (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T)
  (G' A' a' : GE) (h' : Pf (gjtm G' a' A')) (hA' : Pf (gjty G' A')) (w' : Pf (gjwf G'))
  (pc' : Id Ctx (cls G' w') c) (pT' : Id (Ty c) (clsTy c G' A' hA' w' pc') T)
  (e : Pf (gjeqtm G a a' A)) :
  Id (El c T) (clsEl c T G A a h hA w pc pT) (clsEl c T G' A' a' h' hA' w' pc' pT') =
  EQ[c,T].Q.relates (G, (A, (a, (h, (hA, (w, (pc, pT))))))) (G', (A', (a', (h', (hA', (w', (pc', pT'))))))) e ;
clsEl-irr (c : Ctx) (T : Ty c)
  (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T)
  (G' A' : GE) (h' : Pf (gjtm G' a A')) (hA' : Pf (gjty G' A')) (w' : Pf (gjwf G'))
  (pc' : Id Ctx (cls G' w') c) (pT' : Id (Ty c) (clsTy c G' A' hA' w' pc') T) :
  Id (El c T) (clsEl c T G A a h hA w pc pT) (clsEl c T G' A' a h' hA' w' pc' pT') =
  clsEl-eq c T G A a h hA w pc pT G' A' a h' hA' w' pc' pT'
    (pf-map (gjtm G a A) (gjeqtm G a a A) (\ k -> gm-refl G a A k) h) ;
clsEl-eff (c : Ctx) (T : Ty c)
  (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T)
  (G' A' a' : GE) (h' : Pf (gjtm G' a' A')) (hA' : Pf (gjty G' A')) (w' : Pf (gjwf G'))
  (pc' : Id Ctx (cls G' w') c) (pT' : Id (Ty c) (clsTy c G' A' hA' w' pc') T)
  (p : Id (El c T) (clsEl c T G A a h hA w pc pT) (clsEl c T G' A' a' h' hA' w' pc' pT')) :
  Pf (gjeqtm G a a' A) =
  EQ[c,T].Q.effective (G, (A, (a, (h, (hA, (w, (pc, pT))))))) (G', (A', (a', (h', (hA', (w', (pc', pT'))))))) p ;
el-ind (c : Ctx) (T : Ty c) (P : El c T -> U l) (pP : (t : El c T) -> isProp (P t))
  (f : (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
       (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T) -> P (clsEl c T G A a h hA w pc pT))
  (t : El c T) : P t =
  EQ[c,T].Q.induction @l P pP (\ x -> f x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2.1 x.2.2.2.2.2.1 x.2.2.2.2.2.2.1 x.2.2.2.2.2.2.2) t ;

RepEl (c : Ctx) (T : Ty c) (t : El c T) : U l =
  (x : ElPre c T) * Id (El c T)
    (clsEl c T (elG c T x) (elA c T x) (ela c T x) (elH c T x) (elHA c T x) (elW c T x) (elP c T x) (elE c T x)) t ;
mkRepEl (c : Ctx) (T : Ty c) (t : El c T)
  (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T)
  (e : Id (El c T) (clsEl c T G A a h hA w pc pT) t) : RepEl c T t =
  ((G, (A, (a, (h, (hA, (w, (pc, pT))))))), e) ;
rep-el (c : Ctx) (T : Ty c) (t : El c T) : Sq (RepEl c T t) =
  sq-map ((x : ElPre c T) * Id (El c T) (EQ[c,T].Q.inc x) t) (RepEl c T t) (\ y -> (y.1, y.2)) (EQ[c,T].Q.rep t) ;
reG (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : GE = elG c T r.1 ;
reA (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : GE = elA c T r.1 ;
rea (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : GE = ela c T r.1 ;
reH (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) :
  Pf (gjtm (reG c T t r) (rea c T t r) (reA c T t r)) = elH c T r.1 ;
reHA (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : Pf (gjty (reG c T t r) (reA c T t r)) = elHA c T r.1 ;
reW (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : Pf (gjwf (reG c T t r)) = elW c T r.1 ;
reP (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : Id Ctx (cls (reG c T t r) (reW c T t r)) c = elP c T r.1 ;
reT (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) :
  Id (Ty c) (clsTy c (reG c T t r) (reA c T t r) (reHA c T t r) (reW c T t r) (reP c T t r)) T = elE c T r.1 ;
reE (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) :
  Id (El c T) (clsEl c T (reG c T t r) (reA c T t r) (rea c T t r) (reH c T t r) (reHA c T t r)
    (reW c T t r) (reP c T t r) (reT c T t r)) t = r.2 ;
-- the type representative carried by an element representative
re-ty (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) : RepTy c T =
  mkRepTy c T (reG c T t r) (reA c T t r) (reHA c T t r) (reW c T t r) (reP c T t r) (reT c T t r) ;

------------------------------------------------------------------------
-- substitutions between context classes

SubPre (d c : Ctx) : U l =
  (D : GE) * ((s : GE) * ((G : GE) * ((h : Pf (gjsub D s G)) * ((wD : Pf (gjwf D)) *
    ((wG : Pf (gjwf G)) * ((pd : Id Ctx (cls D wD) d) * Id Ctx (cls G wG) c)))))) ;
sbD (d c : Ctx) (x : SubPre d c) : GE = x.1 ;
sbs (d c : Ctx) (x : SubPre d c) : GE = x.2.1 ;
sbG (d c : Ctx) (x : SubPre d c) : GE = x.2.2.1 ;
sbH (d c : Ctx) (x : SubPre d c) : Pf (gjsub (sbD d c x) (sbs d c x) (sbG d c x)) = x.2.2.2.1 ;
sbWD (d c : Ctx) (x : SubPre d c) : Pf (gjwf (sbD d c x)) = x.2.2.2.2.1 ;
sbWG (d c : Ctx) (x : SubPre d c) : Pf (gjwf (sbG d c x)) = x.2.2.2.2.2.1 ;
sbPD (d c : Ctx) (x : SubPre d c) : Id Ctx (cls (sbD d c x) (sbWD d c x)) d = x.2.2.2.2.2.2.1 ;
sbPG (d c : Ctx) (x : SubPre d c) : Id Ctx (cls (sbG d c x) (sbWG d c x)) c = x.2.2.2.2.2.2.2 ;

module SQ (d c : Ctx) {
  rel (x y : SubPre d c) : U l = Pf (gjeqsub (sbD d c x) (sbs d c x) (sbs d c y) (sbG d c x)) ;
  cxD (x y : SubPre d c) : Pf (gjeqcx (sbD d c x) (sbD d c y)) =
    same-cx d (sbD d c x) (sbD d c y) (sbWD d c x) (sbWD d c y) (sbPD d c x) (sbPD d c y) ;
  cxG (x y : SubPre d c) : Pf (gjeqcx (sbG d c x) (sbG d c y)) =
    same-cx c (sbG d c x) (sbG d c y) (sbWG d c x) (sbWG d c y) (sbPG d c x) (sbPG d c y) ;
  rr (x : SubPre d c) : rel x x =
    pf-map (gjsub (sbD d c x) (sbs d c x) (sbG d c x)) (gjeqsub (sbD d c x) (sbs d c x) (sbs d c x) (sbG d c x))
      (\ k -> gq-refl (sbD d c x) (sbs d c x) (sbG d c x) k) (sbH d c x) ;
  rs (x y : SubPre d c) (e : rel x y) : rel y x =
    pf-map5 (gjeqsub (sbD d c x) (sbs d c x) (sbs d c y) (sbG d c x)) (gjwf (sbD d c y)) (gjwf (sbG d c y))
      (gjeqcx (sbD d c x) (sbD d c y)) (gjeqcx (sbG d c x) (sbG d c y))
      (gjeqsub (sbD d c y) (sbs d c y) (sbs d c x) (sbG d c y))
      (\ e0 v1 v2 k1 k2 -> eqsub-cx (sbD d c x) (sbD d c y) (sbG d c x) (sbG d c y) (sbs d c y) (sbs d c x) v1 v2 k1 k2
        (gq-sym (sbD d c x) (sbs d c x) (sbs d c y) (sbG d c x) e0))
      e (sbWD d c y) (sbWG d c y) (cxD x y) (cxG x y) ;
  rt (x y z : SubPre d c) (e1 : rel x y) (e2 : rel y z) : rel x z =
    pf-map6 (gjeqsub (sbD d c x) (sbs d c x) (sbs d c y) (sbG d c x))
      (gjeqsub (sbD d c y) (sbs d c y) (sbs d c z) (sbG d c y))
      (gjwf (sbD d c x)) (gjwf (sbG d c x)) (gjeqcx (sbD d c y) (sbD d c x)) (gjeqcx (sbG d c y) (sbG d c x))
      (gjeqsub (sbD d c x) (sbs d c x) (sbs d c z) (sbG d c x))
      (\ f1 f2 v1 v2 k1 k2 -> gq-trans (sbD d c x) (sbs d c x) (sbs d c y) (sbs d c z) (sbG d c x) f1
        (eqsub-cx (sbD d c y) (sbD d c x) (sbG d c y) (sbG d c x) (sbs d c y) (sbs d c z) v1 v2 k1 k2 f2))
      e1 e2 (sbWD d c x) (sbWG d c x) (cxD y x) (cxG y x) ;
  module Q = Quot[SubPre d c, rel, \ x y -> pf-prop (gjeqsub (sbD d c x) (sbs d c x) (sbs d c y) (sbG d c x)), rr, rs, rt] ;
} ;

Sub (d c : Ctx) : U l = SQ[d,c].Q.Q ;
isSetSub (d c : Ctx) : isSet (Sub d c) = SQ[d,c].Q.set ;
clsSub (d c : Ctx) (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c) : Sub d c =
  SQ[d,c].Q.inc (D, (s, (G, (h, (wD, (wG, (pd, pc))))))) ;

clsSub-eq (d c : Ctx)
  (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c)
  (D' s' G' : GE) (h' : Pf (gjsub D' s' G')) (wD' : Pf (gjwf D')) (wG' : Pf (gjwf G'))
  (pd' : Id Ctx (cls D' wD') d) (pc' : Id Ctx (cls G' wG') c)
  (e : Pf (gjeqsub D s s' G)) :
  Id (Sub d c) (clsSub d c D s G h wD wG pd pc) (clsSub d c D' s' G' h' wD' wG' pd' pc') =
  SQ[d,c].Q.relates (D, (s, (G, (h, (wD, (wG, (pd, pc))))))) (D', (s', (G', (h', (wD', (wG', (pd', pc'))))))) e ;
clsSub-irr (d c : Ctx)
  (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c)
  (D' G' : GE) (h' : Pf (gjsub D' s G')) (wD' : Pf (gjwf D')) (wG' : Pf (gjwf G'))
  (pd' : Id Ctx (cls D' wD') d) (pc' : Id Ctx (cls G' wG') c) :
  Id (Sub d c) (clsSub d c D s G h wD wG pd pc) (clsSub d c D' s G' h' wD' wG' pd' pc') =
  clsSub-eq d c D s G h wD wG pd pc D' s G' h' wD' wG' pd' pc'
    (pf-map (gjsub D s G) (gjeqsub D s s G) (\ k -> gq-refl D s G k) h) ;
clsSub-eff (d c : Ctx)
  (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c)
  (D' s' G' : GE) (h' : Pf (gjsub D' s' G')) (wD' : Pf (gjwf D')) (wG' : Pf (gjwf G'))
  (pd' : Id Ctx (cls D' wD') d) (pc' : Id Ctx (cls G' wG') c)
  (p : Id (Sub d c) (clsSub d c D s G h wD wG pd pc) (clsSub d c D' s' G' h' wD' wG' pd' pc')) :
  Pf (gjeqsub D s s' G) =
  SQ[d,c].Q.effective (D, (s, (G, (h, (wD, (wG, (pd, pc))))))) (D', (s', (G', (h', (wD', (wG', (pd', pc'))))))) p ;
sub-ind (d c : Ctx) (P : Sub d c -> U l) (pP : (s : Sub d c) -> isProp (P s))
  (f : (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
       (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c) -> P (clsSub d c D s G h wD wG pd pc))
  (s : Sub d c) : P s =
  SQ[d,c].Q.induction @l P pP (\ x -> f x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2.1 x.2.2.2.2.2.1 x.2.2.2.2.2.2.1 x.2.2.2.2.2.2.2) s ;

RepSub (d c : Ctx) (s : Sub d c) : U l =
  (x : SubPre d c) * Id (Sub d c)
    (clsSub d c (sbD d c x) (sbs d c x) (sbG d c x) (sbH d c x) (sbWD d c x) (sbWG d c x) (sbPD d c x) (sbPG d c x)) s ;
mkRepSub (d c : Ctx) (s : Sub d c)
  (D s0 G : GE) (h : Pf (gjsub D s0 G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) d) (pc : Id Ctx (cls G wG) c)
  (e : Id (Sub d c) (clsSub d c D s0 G h wD wG pd pc) s) : RepSub d c s =
  ((D, (s0, (G, (h, (wD, (wG, (pd, pc))))))), e) ;
rep-sub (d c : Ctx) (s : Sub d c) : Sq (RepSub d c s) =
  sq-map ((x : SubPre d c) * Id (Sub d c) (SQ[d,c].Q.inc x) s) (RepSub d c s) (\ y -> (y.1, y.2)) (SQ[d,c].Q.rep s) ;
rsD (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : GE = sbD d c r.1 ;
rss (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : GE = sbs d c r.1 ;
rsG (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : GE = sbG d c r.1 ;
rsH (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : Pf (gjsub (rsD d c s r) (rss d c s r) (rsG d c s r)) = sbH d c r.1 ;
rsWD (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : Pf (gjwf (rsD d c s r)) = sbWD d c r.1 ;
rsWG (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : Pf (gjwf (rsG d c s r)) = sbWG d c r.1 ;
rsPD (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : Id Ctx (cls (rsD d c s r) (rsWD d c s r)) d = sbPD d c r.1 ;
rsPG (d c : Ctx) (s : Sub d c) (r : RepSub d c s) : Id Ctx (cls (rsG d c s r) (rsWG d c s r)) c = sbPG d c r.1 ;
rsE (d c : Ctx) (s : Sub d c) (r : RepSub d c s) :
  Id (Sub d c) (clsSub d c (rsD d c s r) (rss d c s r) (rsG d c s r) (rsH d c s r) (rsWD d c s r) (rsWG d c s r)
    (rsPD d c s r) (rsPG d c s r)) s = r.2 ;

------------------------------------------------------------------------
-- transport only changes the path components (by idJ, then Ctx and Ty c
-- are sets)

tr-ty (X : U l) (E : X -> Ctx) (x y : X) (e : Id X x y)
  (G A : GE) (h : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) (E x)) (pc' : Id Ctx (cls G w) (E y)) :
  Id (Ty (E y)) (subst X (\ z -> Ty (E z)) x y e (clsTy (E x) G A h w pc)) (clsTy (E y) G A h w pc') =
  idJ X x (\ z e0 -> (q : Id Ctx (cls G w) (E z)) ->
      Id (Ty (E z)) (subst X (\ z' -> Ty (E z')) x z e0 (clsTy (E x) G A h w pc)) (clsTy (E z) G A h w q))
    (\ q -> ap (Id Ctx (cls G w) (E x)) (Ty (E x)) (\ q' -> clsTy (E x) G A h w q') pc q
      (isSetCtx (cls G w) (E x) pc q))
    y e pc' ;

tr-sub (X : U l) (E F : X -> Ctx) (x y : X) (e : Id X x y)
  (D s G : GE) (h : Pf (gjsub D s G)) (wD : Pf (gjwf D)) (wG : Pf (gjwf G))
  (pd : Id Ctx (cls D wD) (E x)) (pc : Id Ctx (cls G wG) (F x))
  (pd' : Id Ctx (cls D wD) (E y)) (pc' : Id Ctx (cls G wG) (F y)) :
  Id (Sub (E y) (F y)) (subst X (\ z -> Sub (E z) (F z)) x y e (clsSub (E x) (F x) D s G h wD wG pd pc))
    (clsSub (E y) (F y) D s G h wD wG pd' pc') =
  idJ X x (\ z e0 -> (qd : Id Ctx (cls D wD) (E z)) (qc : Id Ctx (cls G wG) (F z)) ->
      Id (Sub (E z) (F z)) (subst X (\ z' -> Sub (E z') (F z')) x z e0 (clsSub (E x) (F x) D s G h wD wG pd pc))
        (clsSub (E z) (F z) D s G h wD wG qd qc))
    (\ qd qc -> trans (Sub (E x) (F x)) (clsSub (E x) (F x) D s G h wD wG pd pc)
        (clsSub (E x) (F x) D s G h wD wG qd pc) (clsSub (E x) (F x) D s G h wD wG qd qc)
        (ap (Id Ctx (cls D wD) (E x)) (Sub (E x) (F x)) (\ q -> clsSub (E x) (F x) D s G h wD wG q pc) pd qd
          (isSetCtx (cls D wD) (E x) pd qd))
        (ap (Id Ctx (cls G wG) (F x)) (Sub (E x) (F x)) (\ q -> clsSub (E x) (F x) D s G h wD wG qd q) pc qc
          (isSetCtx (cls G wG) (F x) pc qc)))
    y e pd' pc' ;

-- elements: over a family of contexts E and types T; the path to the
-- context is kept as a parameter of the motive, the type path is
-- replaced (Ty is a set)
tr-el (X : U l) (E : X -> Ctx) (T : (x : X) -> Ty (E x)) (x y : X) (e : Id X x y)
  (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) (E x)) (pT : Id (Ty (E x)) (clsTy (E x) G A hA w pc) (T x))
  (pc' : Id Ctx (cls G w) (E y)) (pT' : Id (Ty (E y)) (clsTy (E y) G A hA w pc') (T y)) :
  Id (El (E y) (T y)) (subst X (\ z -> El (E z) (T z)) x y e (clsEl (E x) (T x) G A a h hA w pc pT))
    (clsEl (E y) (T y) G A a h hA w pc' pT') =
  idJ X x (\ z e0 -> (qc : Id Ctx (cls G w) (E z)) (qT : Id (Ty (E z)) (clsTy (E z) G A hA w qc) (T z)) ->
      Id (El (E z) (T z)) (subst X (\ z' -> El (E z') (T z')) x z e0 (clsEl (E x) (T x) G A a h hA w pc pT))
        (clsEl (E z) (T z) G A a h hA w qc qT))
    (\ qc qT -> clsEl-irr (E x) (T x) G A a h hA w pc pT G A h hA w qc qT)
    y e pc' pT' ;

-- the El-transport lemma of the plan: transport in El c along T = T'
el-transport (c : Ctx) (T T' : Ty c) (e : Id (Ty c) T T')
  (G A a : GE) (h : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (w : Pf (gjwf G))
  (pc : Id Ctx (cls G w) c) (pT : Id (Ty c) (clsTy c G A hA w pc) T)
  (pT' : Id (Ty c) (clsTy c G A hA w pc) T') :
  Id (El c T') (subst (Ty c) (El c) T T' e (clsEl c T G A a h hA w pc pT)) (clsEl c T' G A a h hA w pc pT') =
  tr-el (Ty c) (\ z -> c) (\ z -> z) T T' e G A a h hA w pc pT pc pT' ;

------------------------------------------------------------------------
-- two representatives of one element are judgementally equal, at the
-- context (and type) of the first

same-rc (c : Ctx) (r r' : RepCtx c) : Pf (gjeqcx r.1 r'.1) =
  same-cx c r.1 r'.1 r.2.1 r'.2.1 r.2.2 r'.2.2 ;
same-rt (c : Ctx) (T : Ty c) (r r' : RepTy c T) : Pf (gjeqty (rtG c T r) (rtA c T r) (rtA c T r')) =
  same-ty c T (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r)
    (rtG c T r') (rtA c T r') (rtH c T r') (rtW c T r') (rtP c T r') (rtE c T r) (rtE c T r') ;
same-re (c : Ctx) (T : Ty c) (t : El c T) (r r' : RepEl c T t) :
  Pf (gjeqtm (reG c T t r) (rea c T t r) (rea c T t r') (reA c T t r)) =
  clsEl-eff c T (reG c T t r) (reA c T t r) (rea c T t r) (reH c T t r) (reHA c T t r) (reW c T t r) (reP c T t r) (reT c T t r)
    (reG c T t r') (reA c T t r') (rea c T t r') (reH c T t r') (reHA c T t r') (reW c T t r') (reP c T t r') (reT c T t r')
    (trans (El c T) _ t _ (reE c T t r) (sym (El c T) _ t (reE c T t r'))) ;
same-rs (d c : Ctx) (s : Sub d c) (r r' : RepSub d c s) :
  Pf (gjeqsub (rsD d c s r) (rss d c s r) (rss d c s r') (rsG d c s r)) =
  clsSub-eff d c (rsD d c s r) (rss d c s r) (rsG d c s r) (rsH d c s r) (rsWD d c s r) (rsWG d c s r) (rsPD d c s r) (rsPG d c s r)
    (rsD d c s r') (rss d c s r') (rsG d c s r') (rsH d c s r') (rsWD d c s r') (rsWG d c s r') (rsPD d c s r') (rsPG d c s r')
    (trans (Sub d c) _ s _ (rsE d c s r) (sym (Sub d c) _ s (rsE d c s r'))) ;

-- a type representative moved to another raw context of the same class
rt-move (c : Ctx) (T : Ty c) (r : RepTy c T) (G' : GE) (w' : Pf (gjwf G')) (pc' : Id Ctx (cls G' w') c) : RepTy c T =
  mkRepTy c T G' (rtA c T r) (ty-move c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r) G' w' pc') w' pc'
    (trans (Ty c) (clsTy c G' (rtA c T r) (ty-move c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r) G' w' pc') w' pc')
      (clsTy c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r)) T
      (sym (Ty c) (clsTy c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r))
        (clsTy c G' (rtA c T r) (ty-move c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r) G' w' pc') w' pc')
        (clsTy-move c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r) G'
          (ty-move c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r) G' w' pc') w' pc'))
      (rtE c T r)) ;
-- an element representative, retyped and moved: a term of the raw type A1
-- over G1, when A1 over G1 represents the same type
re-move (c : Ctx) (T : Ty c) (t : El c T) (r : RepEl c T t) (r' : RepTy c T) :
  Pf (gjtm (rtG c T r') (rea c T t r) (rtA c T r')) =
  pf-map4 (gjtm (reG c T t r) (rea c T t r) (reA c T t r)) (gjeqty (reG c T t r) (reA c T t r) (rtA c T r'))
    (gjeqcx (reG c T t r) (rtG c T r')) (gjwf (rtG c T r'))
    (gjtm (rtG c T r') (rea c T t r) (rtA c T r'))
    (\ h e k w -> gm-cx (reG c T t r) (rtG c T r') (rea c T t r) (rtA c T r') w k
      (gm-conv (reG c T t r) (rea c T t r) (reA c T t r) (rtA c T r') h e))
    (reH c T t r) (same-rt c T (re-ty c T t r) r') (same-cx c (reG c T t r) (rtG c T r') (reW c T t r) (rtW c T r') (reP c T t r) (rtP c T r'))
    (rtW c T r') ;
-- two element representatives are equal at the context and raw type of a
-- type representative
re-eq (c : Ctx) (T : Ty c) (t : El c T) (r1 r2 : RepEl c T t) (r' : RepTy c T) :
  Pf (gjeqtm (rtG c T r') (rea c T t r1) (rea c T t r2) (rtA c T r')) =
  pf-map4 (gjeqtm (reG c T t r1) (rea c T t r1) (rea c T t r2) (reA c T t r1)) (gjeqty (reG c T t r1) (reA c T t r1) (rtA c T r'))
    (gjeqcx (reG c T t r1) (rtG c T r')) (gjwf (rtG c T r'))
    (gjeqtm (rtG c T r') (rea c T t r1) (rea c T t r2) (rtA c T r'))
    (\ e et k w -> gm-ecx (reG c T t r1) (rtG c T r') (rea c T t r1) (rea c T t r2) (rtA c T r') w k
      (gm-eqconv (reG c T t r1) (rea c T t r1) (rea c T t r2) (reA c T t r1) (rtA c T r') e et))
    (same-re c T t r1 r2) (same-rt c T (re-ty c T t r1) r')
    (same-cx c (reG c T t r1) (rtG c T r') (reW c T t r1) (rtW c T r') (reP c T t r1) (rtP c T r'))
    (rtW c T r') ;
