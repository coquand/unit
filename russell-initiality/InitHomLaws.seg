-- InitHomLaws: strict morphisms M -> M' of Ehrhard models of level N
-- (PLAN-INIT section 5), and pointwise agreement of two morphisms.
-- Segment of InitHom.Morphism (l, N, M, M').
--
-- Form of the laws ("canonical form").  A law whose two sides live in
-- the same fibre of M' is a path in that fibre (Sub' X Y, Ty' X,
-- Term' X = (A : Ty' X) * El' X A, or the set of codes El' X (univ' n X)).
-- A law whose sides live over different contexts of M' (because of
-- ctx (ext G A) versus ext' (ctx G) (ty G A), or ctx nil versus nil') is
-- a path in the total space TyT', TmT' or SubT' (InitHomBase).  Data of M
-- living over an extended context ext G A that is an ARGUMENT of an
-- operation (B in Pi, b in lam, b in pic) is moved along ctx-ext by the
-- derived members mv-ty, mv-el, mv-code; these are the only transports.
--
-- The laws are what is needed
--  (a) for existence: the interpretation of TEInterp satisfies each law
--      on representatives, where ctx (extend g a) = C.ext (ctx g) a holds
--      by definition; with the quotient's beta lemmas each law becomes a
--      path between representatives;
--  (b) for uniqueness: the relational form of each law (InitHomRelA/B,
--      rel-*) says that related arguments give related results; applying
--      it to H and to H' with the H'-images as arguments gives Agree H H'
--      on every generated element.
-- The Pi-iso.fun law is NOT a field: it follows from the inv law
-- (InitHomRelB.rel-fun).
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
open InitHomBase ;

record Hom {
  -- the four maps
  ctx (G : C.Ctx) : C'.Ctx ;
  sub (D G : C.Ctx) (s : C.Sub D G) : C'.Sub (ctx D) (ctx G) ;
  ty (G : C.Ctx) (A : C.Ty G) : C'.Ty (ctx G) ;
  tm (G : C.Ctx) (A : C.Ty G) (a : C.El G A) : C'.El (ctx G) (ty G A) ;

  -- contexts
  ctx-nil : Id C'.Ctx (ctx C.nil) C'.nil ;
  ctx-ext (G : C.Ctx) (A : C.Ty G) : Id C'.Ctx (ctx (C.ext G A)) (C'.ext (ctx G) (ty G A)) ;

  -- moving the data of M over an extended context along ctx-ext
  ext' (G : C.Ctx) (A : C.Ty G) : C'.Ctx = C'.ext (ctx G) (ty G A) ;
  mv-ty (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : C'.Ty (ext' G A) =
    mvTy (ctx (C.ext G A)) (ext' G A) (ctx-ext G A) (ty (C.ext G A) B) ;
  mv-el (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B)
    : C'.El (ext' G A) (mv-ty G A B) =
    mvEl (ctx (C.ext G A)) (ext' G A) (ctx-ext G A) (ty (C.ext G A) B) (tm (C.ext G A) B b) ;

  -- substitutions
  sub-id (G : C.Ctx) : Id (C'.Sub (ctx G) (ctx G)) (sub G G (C.id G)) (C'.id (ctx G)) ;
  sub-o (T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D)
    : Id (C'.Sub (ctx T) (ctx G)) (sub T G (C.o T D G s s'))
         (C'.o (ctx T) (ctx D) (ctx G) (sub D G s) (sub T D s')) ;
  sub-eps (G : C.Ctx)
    : Id SubT' (ctx G, (ctx C.nil, sub G C.nil (C.eps G))) (ctx G, (C'.nil, C'.eps (ctx G))) ;
  sub-p (G : C.Ctx) (A : C.Ty G)
    : Id SubT' (ctx (C.ext G A), (ctx G, sub (C.ext G A) G (C.p G A)))
               (ext' G A, (ctx G, C'.p (ctx G) (ty G A))) ;
  sub-lift (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G)
    : Id SubT' (ctx (C.ext D (C.subT D G A s)),
                (ctx (C.ext G A), sub (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s)))
               (C'.ext (ctx D) (C'.subT (ctx D) (ctx G) (ty G A) (sub D G s)),
                (ext' G A, C'.lift (ctx D) (ctx G) (ty G A) (sub D G s))) ;
  sub-sec (G : C.Ctx) (A : C.Ty G) (a : C.El G A)
    : Id SubT' (ctx G, (ctx (C.ext G A), sub G (C.ext G A) (C.sec G A a)))
               (ctx G, (ext' G A, C'.sec (ctx G) (ty G A) (tm G A a))) ;

  -- types
  ty-subT (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G)
    : Id (C'.Ty (ctx D)) (ty D (C.subT D G A s)) (C'.subT (ctx D) (ctx G) (ty G A) (sub D G s)) ;
  ty-Pi (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A))
    : Id (C'.Ty (ctx G)) (ty G (P.Pi G A B)) (P'.Pi (ctx G) (ty G A) (mv-ty G A B)) ;
  ty-univ (n : LevelAt N) (G : C.Ctx)
    : Id (C'.Ty (ctx G)) (ty G (M.univ n G)) (M'.univ n (ctx G)) ;

  -- the image of a code, as a code of M'
  code (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G)) : CodeF' n (ctx G) =
    subst (C'.Ty (ctx G)) (C'.El (ctx G)) (ty G (M.univ n G)) (M'.univ n (ctx G)) (ty-univ n G)
      (tm G (M.univ n G) a) ;

  ty-decode (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    : Id (C'.Ty (ctx G)) (ty G (M.decode n G a)) (M'.decode n (ctx G) (code n G a)) ;

  -- terms
  tm-subt (D G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G)
    : Id (Term' (ctx D)) (ty D (C.subT D G A s), tm D (C.subT D G A s) (C.subt D G A a s))
         (C'.subT (ctx D) (ctx G) (ty G A) (sub D G s), C'.subt (ctx D) (ctx G) (ty G A) (tm G A a) (sub D G s)) ;
  tm-q (G : C.Ctx) (A : C.Ty G)
    : Id TmT' (ctx (C.ext G A), (ty (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)),
                                 tm (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A)))
              (ext' G A, (C'.subT (ext' G A) (ctx G) (ty G A) (C'.p (ctx G) (ty G A)),
                          C'.q (ctx G) (ty G A))) ;
  tm-lam (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B)
    : Id (Term' (ctx G)) (ty G (P.Pi G A B), tm G (P.Pi G A B) ((P.Pi-iso G A B).inv b))
         (P'.Pi (ctx G) (ty G A) (mv-ty G A B),
          (P'.Pi-iso (ctx G) (ty G A) (mv-ty G A B)).inv (mv-el G A B b)) ;

  -- the binder of pic: ctx (ext G (decode a)) = ext' (ctx G) (decode' (code a))
  dec-ext (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    : Id C'.Ctx (ctx (C.ext G (M.decode n G a))) (C'.ext (ctx G) (M'.decode n (ctx G) (code n G a))) =
    trans C'.Ctx (ctx (C.ext G (M.decode n G a))) (ext' G (M.decode n G a))
      (C'.ext (ctx G) (M'.decode n (ctx G) (code n G a)))
      (ctx-ext G (M.decode n G a))
      (ap (C'.Ty (ctx G)) C'.Ctx (\ T -> C'.ext (ctx G) T)
          (ty G (M.decode n G a)) (M'.decode n (ctx G) (code n G a)) (ty-decode n G a)) ;
  mv-code (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
      (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))))
    : CodeF' n (C'.ext (ctx G) (M'.decode n (ctx G) (code n G a))) =
    mvCode n (ctx (C.ext G (M.decode n G a))) (C'.ext (ctx G) (M'.decode n (ctx G) (code n G a)))
      (dec-ext n G a) (code n (C.ext G (M.decode n G a)) b) ;

  -- universe operations, on codes
  tm-pic (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
      (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))))
    : Id (CodeF' n (ctx G)) (code n G (M.pic n G a b)) (M'.pic n (ctx G) (code n G a) (mv-code n G a b)) ;
  tm-uc (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx)
    : Id (CodeF' n (ctx G)) (code n G (M.uc m n lt G)) (M'.uc m n lt (ctx G)) ;
  tm-lf (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (a : C.El G (M.univ m G))
    : Id (CodeF' n (ctx G)) (code n G (M.lf m n lt G a)) (M'.lf m n lt (ctx G) (code m G a)) ;
} ;

------------------------------------------------------------------------
-- relations between M and M' induced by a morphism: the image of an
-- element of M equals a given element of M' in the total space

RCtx (H : Hom) (G : C.Ctx) (X : C'.Ctx) : U l = Id C'.Ctx (H.ctx G) X ;
RTy (H : Hom) (G : C.Ctx) (A : C.Ty G) (w : TyT') : U l = Id TyT' (H.ctx G, H.ty G A) w ;
RTm (H : Hom) (G : C.Ctx) (A : C.Ty G) (a : C.El G A) (w : TmT') : U l =
  Id TmT' (H.ctx G, (H.ty G A, H.tm G A a)) w ;
RSub (H : Hom) (D G : C.Ctx) (s : C.Sub D G) (w : SubT') : U l =
  Id SubT' (H.ctx D, (H.ctx G, H.sub D G s)) w ;

------------------------------------------------------------------------
-- pointwise agreement of two morphisms (the statement of uniqueness):
-- equal contexts, and equal images in the total spaces

record Agree (H H' : Hom) {
  ctx-ag (G : C.Ctx) : RCtx H G (H'.ctx G) ;
  ty-ag (G : C.Ctx) (A : C.Ty G) : RTy H G A (H'.ctx G, H'.ty G A) ;
  tm-ag (G : C.Ctx) (A : C.Ty G) (a : C.El G A) : RTm H G A a (H'.ctx G, (H'.ty G A, H'.tm G A a)) ;
  sub-ag (D G : C.Ctx) (s : C.Sub D G) : RSub H D G s (H'.ctx D, (H'.ctx G, H'.sub D G s)) ;
} ;

-- fibrewise consequences of agreement
ag-fibre-ty (H H' : Hom) (ag : Agree[H,H']) (G : C.Ctx) (A : C.Ty G)
  : Id (C'.Ty (H'.ctx G)) (mvTy (H.ctx G) (H'.ctx G) (ag.ctx-ag G) (H.ty G A)) (H'.ty G A) =
  fibe C'.Ctx set-Ctx' C'.Ty (H.ctx G) (H'.ctx G) (ag.ctx-ag G) (H.ty G A) (H'.ty G A) (ag.ty-ag G A) ;
