-- Simultaneous congruence for actions, binders and universe operations in FGAT.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FCtx[l] ; open FSubstLaws[l] ; open FSubTransport[l] ; open FCompareBase[l] ; open CFullSub[l] ;

c-full-msb (D G A a s E H B b t : FA) (source : CE D E) (target : CE G H)
    (types : TE G A B) (terms : ME G a b A) (subs : SE D s t G) :
    ME D (fmsb D G A a s) (fmsb E H B b t) (ftsb D G A s) =
  me-trans payload (me-trans at-type (me-trans at-target at-source))
 where {
  es : FPJ (fjeqtm G a b A) = fpresup (fjeqtm G a b A) terms ;
  ss : FPJ (fjeqsub D s t G) = fpresup (fjeqsub D s t G) subs ;
  hA : Ty G A = es.2.1 ;
  hB : Ty G B = (fpresup (fjeqty G A B) types).2.2 ;
  hs : Sb D s G = ss.2.2.1 ;
  ht : Sb D t G = ss.2.2.2 ;
  hb : Tm' G b B = tm-conv es.2.2.2 types ;
  payload : ME D (fmsb D G A a s) (fmsb D G A b t) (ftsb D G A s) =
    fm-esb D G a b A s t hA es.2.2.1 terms hs ht subs ;
  at-type : ME D (fmsb D G A b t) (fmsb D G B b t) (ftsb D G A s) =
    me-conv (fm-sb-type D G b A t hA es.2.2.2 ht B types) (ty-sym (sb-same-ty hA hs ht subs)) ;
  type-after-payload : TE D (ftsb D G A s) (ftsb D G B t) = sb-ty-cong hA types hs ht subs ;
  at-target : ME D (fmsb D G B b t) (fmsb D H B b t) (ftsb D G A s) =
    me-conv (fm-sb-target D G b B t hB hb ht H target) (ty-sym type-after-payload) ;
  at-source : ME D (fmsb D H B b t) (fmsb E H B b t) (ftsb D G A s) =
    fm-eqconv D (fmsb D H B b t) (fmsb E H B b t) (ftsb D H B t) (ftsb D G A s)
      (fm-sb-source D H b B t (move-ty G H B target hB) (move-tm G H b B target hb)
      (move-target D G H t target ht) E source)
      (ty-sym (ty-trans {D} {ftsb D G A s} {ftsb D G B t} {ftsb D H B t}
        type-after-payload (fe-sb-target D G B t hB ht H target))) ;
 } ;

c-full-pi (G A B H A' B' : FA) (contexts : CE G H) (domains : TE G A A')
    (bodies : TE (fext G A) B B') : TE G (fpi G A B) (fpi H A' B') =
  fe-trans G (fpi G A B) (fpi G A' B') (fpi H A' B') (fe-pi G A A' B B' d.2.1 domains bodies)
    (fe-pi-context G A' B' d.2.2 (move-ty (fext G A) (fext G A') B' binder b.2.2) H contexts)
 where {
  d : FPJ (fjeqty G A A') = fpresup (fjeqty G A A') domains ;
  b : FPJ (fjeqty (fext G A) B B') = fpresup (fjeqty (fext G A) B B') bodies ;
  binder : CE (fext G A) (fext G A') = ext-eq (cx-refl d.1) domains ;
 } ;

c-full-lam (G A B b H A' B' b' : FA) (contexts : CE G H) (domains : TE G A A')
    (bodies : TE (fext G A) B B') (terms : ME (fext G A) b b' B) :
    ME G (flam G A B b) (flam H A' B' b') (fpi G A B) =
  fm-trans G (flam G A B b) (flam G A' B' b') (flam H A' B' b') (fpi G A B)
    (fm-elam G A A' B B' b b' d.2.1 domains bodies terms)
    (fm-eqconv G (flam G A' B' b') (flam H A' B' b') (fpi G A' B') (fpi G A B)
      (fm-lam-context G A' B' b' d.2.2 at-body at-term H contexts)
      (ty-sym (fe-pi G A A' B B' d.2.1 domains bodies)))
 where {
  d : FPJ (fjeqty G A A') = fpresup (fjeqty G A A') domains ;
  p : FPJ (fjeqty (fext G A) B B') = fpresup (fjeqty (fext G A) B B') bodies ;
  t : FPJ (fjeqtm (fext G A) b b' B) = fpresup (fjeqtm (fext G A) b b' B) terms ;
  binder : CE (fext G A) (fext G A') = ext-eq (cx-refl d.1) domains ;
  at-body : Ty (fext G A') B' = move-ty (fext G A) (fext G A') B' binder p.2.2 ;
  at-term : Tm' (fext G A') b' B' = move-tm (fext G A) (fext G A') b' B' binder (tm-conv t.2.2.2 bodies) ;
 } ;

c-full-app (G A B c a H A' B' c' a' : FA) (contexts : CE G H) (domains : TE G A A')
    (bodies : TE (fext G A) B B') (functions : ME G c c' (fpi G A B)) (terms : ME G a a' A) :
    ME G (fapp G A B c a) (fapp H A' B' c' a') (ftsb G (fext G A) B (fsec G A a)) =
  fm-trans G (fapp G A B c a) (fapp G A' B' c' a') (fapp H A' B' c' a') (ftsb G (fext G A) B (fsec G A a))
    (fm-eapp G A A' B B' c c' a a' d.2.1 p.2.1 t.2.2.1 domains bodies functions terms)
    (fm-eqconv G (fapp G A' B' c' a') (fapp H A' B' c' a')
      (ftsb G (fext G A') B' (fsec G A' a')) (ftsb G (fext G A) B (fsec G A a))
      (fm-app-context G A' B' c' a' d.2.2 at-body at-function (tm-conv t.2.2.2 domains) H contexts)
      (ty-sym result-types))
 where {
  d : FPJ (fjeqty G A A') = fpresup (fjeqty G A A') domains ;
  p : FPJ (fjeqty (fext G A) B B') = fpresup (fjeqty (fext G A) B B') bodies ;
  u : FPJ (fjeqtm G c c' (fpi G A B)) = fpresup (fjeqtm G c c' (fpi G A B)) functions ;
  t : FPJ (fjeqtm G a a' A) = fpresup (fjeqtm G a a' A) terms ;
  same-context : CE G G = cx-refl d.1 ;
  binder : CE (fext G A) (fext G A') = ext-eq same-context domains ;
  at-body : Ty (fext G A') B' = move-ty (fext G A) (fext G A') B' binder p.2.2 ;
  at-function : Tm' G c' (fpi G A' B') = tm-conv u.2.2.2 (fe-pi G A A' B B' d.2.1 domains bodies) ;
  result-types : TE G (ftsb G (fext G A) B (fsec G A a)) (ftsb G (fext G A') B' (fsec G A' a')) =
    c-full-tsb G (fext G A) B (fsec G A a) G (fext G A') B' (fsec G A' a') same-context binder bodies
      (c-full-sec G A a G A' a' same-context domains terms) ;
 } ;

c-full-el (n : Nat) (G a H b : FA) (contexts : CE G H) (codes : ME G a b (fuu n G)) :
    TE G (fel n G a) (fel n H b) =
  fe-trans G (fel n G a) (fel n G b) (fel n H b)
    (fe-el G n a b codes) (fe-el-context G n b (fpresup (fjeqtm G a b (fuu n G)) codes).2.2.2 H contexts) ;

c-full-pic (n : Nat) (G a b H a' b' : FA) (contexts : CE G H) (domains : ME G a a' (fuu n G))
    (bodies : ME (fext G (fel n G a)) b b' (fuu n (fext G (fel n G a)))) (bound : LeN n N) :
    ME G (fpic n G a b) (fpic n H a' b') (fuu n G) =
  fm-trans G (fpic n G a b) (fpic n G a' b') (fpic n H a' b') (fuu n G)
    (fm-epic G n a a' b b' d.2.2.1 domains bodies)
    (fm-pic-context G n a' b' d.2.2.2 at-body H contexts)
 where {
  d : FPJ (fjeqtm G a a' (fuu n G)) = fpresup (fjeqtm G a a' (fuu n G)) domains ;
  L : FA = fext G (fel n G a) ;
  R : FA = fext G (fel n G a') ;
  p : FPJ (fjeqtm L b b' (fuu n L)) = fpresup (fjeqtm L b b' (fuu n L)) bodies ;
  binder : CE L R = fc-ext G G (fel n G a) (fel n G a') (cx-refl d.1) (fe-el G n a a' domains) ;
  at-body : Tm' R b' (fuu n R) = move-universe {L} {R} {b'} n (wf-right L R binder) binder bound p.2.2.2 ;
 } ;

c-full-lf (m n : Nat) (G a H b : FA) (contexts : CE G H) (codes : ME G a b (fuu m G))
    (strict : LeN (suc m) n) (bound : LeN n N) : ME G (flf m n G a) (flf m n H b) (fuu n G) =
  fm-trans G (flf m n G a) (flf m n G b) (flf m n H b) (fuu n G) (fm-elf G m n a b codes strict bound)
    (fm-lf-context G m n b (fpresup (fjeqtm G a b (fuu m G)) codes).2.2.2 strict bound H contexts) ;
