 where {
    p : Sb r.c.e.t r.x.t r.k.e.t = r.d ;
 } ;

lift-aq-sym (D : GA) (s : GA) (t : GA) (G : GA) (r : LiftSE[D,s,t,G]) : LiftSE[D,t,s,G] =
  put-se D t s G r.c.e r.y r.x r.k.e (fq-sym r.c.e.t r.x.t r.y.t r.k.e.t p)
 where {
    p : SE r.c.e.t r.x.t r.y.t r.k.e.t = r.d ;
 } ;

lift-aq-trans (D : GA) (s : GA) (t : GA) (u : GA) (G : GA) (r1 : LiftSE[D,s,t,G]) (r2 : LiftSE[D,t,u,G]) : LiftSE[D,s,u,G] =
  put-se D s u G r1.c.e r1.x r2.y r1.k.e (fq-trans r1.c.e.t r1.x.t r1.y.t r2.y.t r1.k.e.t p1 p2)
 where {
    p1 : SE r1.c.e.t r1.x.t r1.y.t r1.k.e.t = r1.d ;
    right : SE r1.c.e.t r2.x.t r2.y.t r1.k.e.t = (at-se D t u G r2 r1.c r1.k) ;
    middle : SE r1.c.e.t r1.y.t r2.x.t r1.k.e.t = sub-align D t G r1.c r1.k r1.y r2.x (fpresup (fjeqsub r1.c.e.t r1.x.t r1.y.t r1.k.e.t) p1).2.2.2 (fpresup (fjeqsub r1.c.e.t r2.x.t r2.y.t r1.k.e.t) right).2.2.1 ;
    p2 : SE r1.c.e.t r1.y.t r2.y.t r1.k.e.t = fq-trans r1.c.e.t r1.y.t r2.x.t r2.y.t r1.k.e.t middle right ;
 } ;

lift-aq-comp (T : GA) (D : GA) (G : GA) (s : GA) (s' : GA) (d : GA) (d' : GA) (r1 : LiftSE[D,s,s',G]) (r2 : LiftSE[T,d,d',D]) : LiftSE[T,(acomp s d),(acomp s' d'),G] =
  put-se T (acomp s d) (acomp s' d') G r2.c.e (e-comp r2.c.e.t r2.k.e.t r1.k.e.t s r1.x d r2.x) (e-comp r2.c.e.t r2.k.e.t r1.k.e.t s' r1.y d' r2.y) r1.k.e (fq-comp r2.c.e.t r2.k.e.t r1.k.e.t r1.x.t r1.y.t r2.x.t r2.y.t p1 p2)
 where {
    p1 : SE r2.k.e.t r1.x.t r1.y.t r1.k.e.t = (at-se D s s' G r1 r2.k r1.k) ;
    p2 : SE r2.c.e.t r2.x.t r2.y.t r2.k.e.t = r2.d ;
 } ;

lift-aq-lift (D : GA) (G : GA) (A : GA) (A' : GA) (s : GA) (s' : GA) (r1 : LiftTE[G,A,A']) (r3 : LiftSE[D,s,s',G]) : LiftSE[(aext D (asb A s)),(alift A s),(alift A' s'),(aext G A)] =
  put-se (aext D (asb A s)) (alift A s) (alift A' s') (aext G A) (e-ext D r3.c.e (asb A s) (e-tsb r3.c.e.t r3.k.e.t A r1.a s r3.x)) (e-lift r3.c.e.t r3.k.e.t A r1.a s r3.x) (e-lift r3.c.e.t r3.k.e.t A' r1.b s' r3.y) (e-ext G r3.k.e A r1.a) (fq-lift r3.c.e.t r3.k.e.t r1.a.t r1.b.t r3.x.t r3.y.t p0 p1 p2 p3)
 where {
    p1 : TE r3.k.e.t r1.a.t r1.b.t = (at-te G A A' r1 r3.k) ;
    p0 : Ty r3.k.e.t r1.a.t = (fpresup (fjeqty r3.k.e.t r1.a.t r1.b.t) p1).2.1 ;
    p3 : SE r3.c.e.t r3.x.t r3.y.t r3.k.e.t = r3.d ;
    p2 : Sb r3.c.e.t r3.x.t r3.k.e.t = (fpresup (fjeqsub r3.c.e.t r3.x.t r3.y.t r3.k.e.t) p3).2.2.1 ;
 } ;

lift-aq-sec (G : GA) (A : GA) (A' : GA) (a : GA) (a' : GA) (r1 : LiftTE[G,A,A']) (r2 : LiftME[G,a,a',A]) : LiftSE[G,(asec A a),(asec A' a'),(aext G A)] =
  put-se G (asec A a) (asec A' a') (aext G A) r1.c.e (e-sec r1.c.e.t A r1.a a r2.x) (e-sec r1.c.e.t A' r1.b a' r2.y) (e-ext G r1.c.e A r1.a) (fq-sec r1.c.e.t r1.a.t r1.b.t r2.x.t r2.y.t pA pa pa' p1 p2)
