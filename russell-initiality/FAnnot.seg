annotate : (J : GAJ) -> GADer J -> LiftJ J = split {
  a-nil -> lift-a-nil ;
  a-ext G A h | r -> lift-a-ext G A r ;
  ac-nil -> lift-ac-nil ;
  ac-refl G h | r -> lift-ac-refl G r ;
  ac-ext G D A B h1 h2 | r1 r2 -> lift-ac-ext G D A B r1 r2 ;
  as-id G h | r -> lift-as-id G r ;
  as-comp T D G s d h1 h2 | r1 r2 -> lift-as-comp T D G s d r1 r2 ;
  as-eps G h | r -> lift-as-eps G r ;
  as-p G A h | r -> lift-as-p G A r ;
  as-lift D G A s h1 h2 | r1 r2 -> lift-as-lift D G A s r1 r2 ;
