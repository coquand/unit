    p2 : ME r2.c.e.t r2.x.t r2.y.t r2.t.t = r2.d ;
 } ;

lift-aq-refl (D : GA) (s : GA) (G : GA) (r : LiftSub[D,s,G]) : LiftSE[D,s,s,G] =
