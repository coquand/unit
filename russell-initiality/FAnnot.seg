    p1 : Ty r3.k.e.t r1.a.t = (at-ty G A r1 r3.k) ;
    p2 : Tm' r3.k.e.t r2.x.t r1.a.t = (tm-at-type G a A r2 r3.k r1.a p1) ;
    p3 : Sb r3.c.e.t r3.x.t r3.k.e.t = r3.d ;
