lift-ae-uu-cx (G : GA) (H : GA) (n : Nat) (re : LiftCE[G,H]) (nb : LeN n N) : LiftTE[G,(auu n G),(auu n H)] =
  put-te G (auu n G) (auu n H) re.c.e (e-uu n G re.c.e) (e-uu n H re.k.e) (fe-uu-cx re.c.e.t re.k.e.t n pe nb)
 where {
    pe : CE re.c.e.t re.k.e.t = re.d ;
