lift-aq-lift-p-sec-q (G : GA) (A : GA) (r : LiftTy[G,A]) : LiftSE[(aext G A),(acomp (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A))),(aid (aext G A)),(aext G A)] =
