    pa' : Tm' r1.c.e.t r2.y.t r1.a.t = (fpresup (fjeqtm r1.c.e.t r2.x.t r2.y.t r1.a.t) p2).2.2.2 ;
 } ;

lift-aq-idl (D : GA) (G : GA) (s : GA) (r : LiftSub[D,s,G]) : LiftSE[D,(acomp (aid G) s),s,G] =
