lift-aq-assoc (Q : GA) (T : GA) (D : GA) (G : GA) (s : GA) (d : GA) (e : GA) (r1 : LiftSub[D,s,G]) (r2 : LiftSub[T,d,D]) (r3 : LiftSub[Q,e,T]) : LiftSE[Q,(acomp (acomp s d) e),(acomp s (acomp d e)),G] =
