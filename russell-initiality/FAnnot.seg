lift-aq-lift-comp (T : GA) (D : GA) (G : GA) (A : GA) (s : GA) (d : GA) (r0 : LiftTy[G,A]) (r1 : LiftSub[D,s,G]) (r2 : LiftSub[T,d,D]) : LiftSE[(aext T (asb A (acomp s d))),(alift A (acomp s d)),(acomp (alift A s) (alift (asb A s) d)),(aext G A)] =
