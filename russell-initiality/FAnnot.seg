lift-am-uc-cx (G : GA) (H : GA) (m : Nat) (n : Nat) (re : LiftCE[G,H]) (lt : LeN (suc m) n) (nb : LeN n N) : LiftME[G,(auc m n G),(auc m n H),(auu n G)] =
  put-me G (auc m n G) (auc m n H) (auu n G) re.c.e (e-uc m n G re.c.e) (e-uc m n H re.k.e) (e-uu n G re.c.e) (fm-uc-cx re.c.e.t re.k.e.t m n pe lt nb)
 where {
    pe : CE re.c.e.t re.k.e.t = re.d ;
 } ;

lift-aq-id-cx (G : GA) (H : GA) (re : LiftCE[G,H]) : LiftSE[G,(aid G),(aid H),G] =
