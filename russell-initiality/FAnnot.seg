lift-aq-eps-cx (G : GA) (H : GA) (re : LiftCE[G,H]) : LiftSE[G,(aeps G),(aeps H),anil] =
  put-se G (aeps G) (aeps H) anil re.c.e (e-eps G re.c.e) (e-eps H re.k.e) e-nil (fq-eps-cx re.c.e.t re.k.e.t pe)
 where {
