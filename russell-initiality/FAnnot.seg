lift-am-elf (G : GA) (m : Nat) (n : Nat) (a : GA) (a' : GA) (r : LiftME[G,a,a',(auu m G)]) (le : LeN (suc m) n) (nb : LeN n N) : LiftME[G,(alf m n a),(alf m n a'),(auu n G)] =
