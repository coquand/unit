-- Inspect an annotated expression at a prescribed raw image.
-- The view exposes the surviving children and their individual raw identities.
level l ;
open Base ; open GAT[l] ; open AGAT[l] ; open AForget[l] ;

Shape : GE -> U l = split {
  gnil -> Top ;
  gext G A -> (G' : GA) * (A' : GA) * Id GE (fg G') G * Id GE (fg A') A ;
  gpi A B -> (A' : GA) * (B' : GA) * Id GE (fg A') A * Id GE (fg B') B ;
  guu n -> GA ;
  gel n a -> (a' : GA) * Id GE (fg a') a ;
  gsb t s -> (t' : GA) * (s' : GA) * Id GE (fg t') t * Id GE (fg s') s ;
  glam A B b -> (A' : GA) * (B' : GA) * (b' : GA) * Id GE (fg A') A * Id GE (fg B') B * Id GE (fg b') b ;
  gapp A B c a -> (A' : GA) * (B' : GA) * (c' : GA) * (a' : GA) * Id GE (fg A') A * Id GE (fg B') B * Id GE (fg c') c * Id GE (fg a') a ;
  gpic n a b -> (a' : GA) * (b' : GA) * Id GE (fg a') a * Id GE (fg b') b ;
  guc m n -> GA ;
  glf m n a -> (a' : GA) * Id GE (fg a') a ;
  gq -> (X : GA) * GA ;
  gid -> GA ;
  gcomp s d -> (s' : GA) * (d' : GA) * Id GE (fg s') s * Id GE (fg d') d ;
  geps -> GA ;
  gp -> (X : GA) * GA ;
  glift A s -> (A' : GA) * (s' : GA) * Id GE (fg A') A * Id GE (fg s') s ;
  gsec A a -> (A' : GA) * (a' : GA) * Id GE (fg A') A * Id GE (fg a') a } ;

shape-term : (e : GE) -> Shape e -> GA = split {
  gnil -> \ x -> anil ;
  gext G A -> \ x -> aext x.1 x.2.1 ;
  gpi A B -> \ x -> api x.1 x.2.1 ;
  guu n -> \ x -> auu n x ;
  gel n a -> \ x -> ael n x.1 ;
  gsb t s -> \ x -> asb x.1 x.2.1 ;
  glam A B b -> \ x -> alam x.1 x.2.1 x.2.2.1 ;
  gapp A B c a -> \ x -> aapp x.1 x.2.1 x.2.2.1 x.2.2.2.1 ;
  gpic n a b -> \ x -> apic n x.1 x.2.1 ;
  guc m n -> \ x -> auc m n x ;
  glf m n a -> \ x -> alf m n x.1 ;
  gq -> \ x -> aq x.1 x.2 ;
  gid -> \ x -> aid x ;
  gcomp s d -> \ x -> acomp x.1 x.2.1 ;
  geps -> \ x -> aeps x ;
  gp -> \ x -> ap x.1 x.2 ;
  glift A s -> \ x -> alift x.1 x.2.1 ;
  gsec A a -> \ x -> asec x.1 x.2.1 } ;

shape-self : (X : GA) -> Shape (fg X) = split {
  anil -> tt ;
  aext G A -> (G, (A, (refl (fg G), refl (fg A)))) ;
  api A B -> (A, (B, (refl (fg A), refl (fg B)))) ;
  auu n X -> X ;
  ael n a -> (a, refl (fg a)) ;
  asb t s -> (t, (s, (refl (fg t), refl (fg s)))) ;
  alam A B b -> (A, (B, (b, (refl (fg A), (refl (fg B), refl (fg b)))))) ;
  aapp A B c a -> (A, (B, (c, (a, (refl (fg A), (refl (fg B), (refl (fg c), refl (fg a)))))))) ;
  apic n a b -> (a, (b, (refl (fg a), refl (fg b)))) ;
  auc m n X -> X ;
  alf m n a -> (a, refl (fg a)) ;
  aq X Y -> (X, Y) ;
  aid X -> X ;
  acomp s d -> (s, (d, (refl (fg s), refl (fg d)))) ;
  aeps X -> X ;
  ap X Y -> (X, Y) ;
  alift A s -> (A, (s, (refl (fg A), refl (fg s)))) ;
  asec A a -> (A, (a, (refl (fg A), refl (fg a)))) } ;

shape-self-id : (X : GA) -> Id GA (shape-term (fg X) (shape-self X)) X = split {
  anil -> refl anil ;
  aext G A -> refl (aext G A) ;
  api A B -> refl (api A B) ;
  auu n X -> refl (auu n X) ;
  ael n a -> refl (ael n a) ;
  asb t s -> refl (asb t s) ;
  alam A B b -> refl (alam A B b) ;
  aapp A B c a -> refl (aapp A B c a) ;
  apic n a b -> refl (apic n a b) ;
  auc m n X -> refl (auc m n X) ;
  alf m n a -> refl (alf m n a) ;
  aq X Y -> refl (aq X Y) ;
  aid X -> refl (aid X) ;
  acomp s d -> refl (acomp s d) ;
  aeps X -> refl (aeps X) ;
  ap X Y -> refl (ap X Y) ;
  alift A s -> refl (alift A s) ;
  asec A a -> refl (asec A a) } ;

Repr (e : GE) (X : GA) : U l = (s : Shape e) * Id GA (shape-term e s) X ;

shape-view (e : GE) (X : GA) (p : Id GE (fg X) e) : Repr e X =
  Prelude[l].subst GE (\ Y -> Repr Y X) (fg X) e p (shape-self X, shape-self-id X) ;
