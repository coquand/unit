-- InitOpsSub.seg (PLAN-INIT, Part F): substitution in types and terms of
-- the term model: subT (raw gsb A s), subt (raw gsb a s), with beta lemmas
-- for any representatives of the arguments and any raw context of the
-- result.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
open InitQuot[l] ;
open InitSorts[l] ;

------------------------------------------------------------------------
-- types:  subT d c A s,  A over G, s : D -> G'

module OpSubT (d c : Ctx) (A : Ty c) (s : Sub d c) {
  W : U l = RepTy c A * RepSub d c s ;
  G (x : W) : GE = rtG c A x.1 ;
  A0 (x : W) : GE = rtA c A x.1 ;
  D (x : W) : GE = rsD d c s x.2 ;
  G' (x : W) : GE = rsG d c s x.2 ;
  s0 (x : W) : GE = rss d c s x.2 ;
  cx (x : W) : Pf (gjeqcx (G x) (G' x)) =
    same-cx c (G x) (G' x) (rtW c A x.1) (rsWG d c s x.2) (rtP c A x.1) (rsPG d c s x.2) ;
  der (x : W) : Pf (gjty (D x) (gsb (A0 x) (s0 x))) =
    pf-map4 (gjty (G x) (A0 x)) (gjsub (D x) (s0 x) (G' x)) (gjeqcx (G x) (G' x)) (gjwf (G' x))
      (gjty (D x) (gsb (A0 x) (s0 x)))
      (\ hA hs k w -> gt-sb (D x) (G' x) (A0 x) (s0 x) (gt-cx (G x) (G' x) (A0 x) w k hA) hs)
      (rtH c A x.1) (rsH d c s x.2) (cx x) (rsWG d c s x.2) ;
  f (x : W) : Ty d = clsTy d (D x) (gsb (A0 x) (s0 x)) (der x) (rsWD d c s x.2) (rsPD d c s x.2) ;
  rel (x y : W) : Pf (gjeqty (D x) (gsb (A0 x) (s0 x)) (gsb (A0 y) (s0 y))) =
    pf-map5 (gjty (G x) (A0 x)) (gjeqcx (G x) (G' x)) (gjwf (G' x)) (gjeqty (G x) (A0 x) (A0 y))
      (gjeqsub (D x) (s0 x) (s0 y) (G' x)) (gjeqty (D x) (gsb (A0 x) (s0 x)) (gsb (A0 y) (s0 y)))
      (\ hA k w eA es -> ge-sb (D x) (G' x) (A0 x) (A0 y) (s0 x) (s0 y) (gt-cx (G x) (G' x) (A0 x) w k hA)
        (ge-cx (G x) (G' x) (A0 x) (A0 y) w k eA)
        (GP.gpresup (gjeqsub (D x) (s0 x) (s0 y) (G' x)) es).2.2.1
        (GP.gpresup (gjeqsub (D x) (s0 x) (s0 y) (G' x)) es).2.2.2 es)
      (rtH c A x.1) (cx x) (rsWG d c s x.2) (same-rt c A x.1 y.1) (same-rs d c s x.2 y.2) ;
  const (x y : W) : Id (Ty d) (f x) (f y) =
    clsTy-eq d (D x) (gsb (A0 x) (s0 x)) (der x) (rsWD d c s x.2) (rsPD d c s x.2)
      (D y) (gsb (A0 y) (s0 y)) (der y) (rsWD d c s y.2) (rsPD d c s y.2) (rel x y) ;
  module Ch = Choice[W, Ty d, isSetTy d, f, const] ;
  reps : Sq W = sq-pair (RepTy c A) (RepSub d c s) (rep-ty c A) (rep-sub d c s) ;
  value : Ty d = Ch.elim reps ;
  beta (x : W) : Id (Ty d) value (f x) = Ch.beta reps x ;
} ;

subT (d c : Ctx) (A : Ty c) (s : Sub d c) : Ty d = OpSubT[d,c,A,s].value ;
subT-der (d c : Ctx) (A : Ty c) (s : Sub d c) (r : RepTy c A) (r' : RepSub d c s) :
  Pf (gjty (rsD d c s r') (gsb (rtA c A r) (rss d c s r'))) = OpSubT[d,c,A,s].der (r, r') ;
subT-beta (d c : Ctx) (A : Ty c) (s : Sub d c) (r : RepTy c A) (r' : RepSub d c s)
  (D1 : GE) (h : Pf (gjty D1 (gsb (rtA c A r) (rss d c s r')))) (w : Pf (gjwf D1)) (pd : Id Ctx (cls D1 w) d) :
  Id (Ty d) (subT d c A s) (clsTy d D1 (gsb (rtA c A r) (rss d c s r')) h w pd) =
  trans (Ty d) (subT d c A s) (OpSubT[d,c,A,s].f (r, r')) (clsTy d D1 (gsb (rtA c A r) (rss d c s r')) h w pd)
    (OpSubT[d,c,A,s].beta (r, r'))
    (clsTy-move d (rsD d c s r') (gsb (rtA c A r) (rss d c s r')) (OpSubT[d,c,A,s].der (r, r'))
      (rsWD d c s r') (rsPD d c s r') D1 h w pd) ;
subT-beta' (d c : Ctx) (A : Ty c) (s : Sub d c) (r : RepTy c A) (r' : RepSub d c s)
  (D1 : GE) (h : Pf (gjty D1 (gsb (rtA c A r) (rss d c s r')))) (w : Pf (gjwf D1)) (pd : Id Ctx (cls D1 w) d) :
  Id (Ty d) (clsTy d D1 (gsb (rtA c A r) (rss d c s r')) h w pd) (subT d c A s) =
  sym (Ty d) (subT d c A s) (clsTy d D1 (gsb (rtA c A r) (rss d c s r')) h w pd) (subT-beta d c A s r r' D1 h w pd) ;
-- the representative of subT d c A s given by representatives of A and s
subT-rep (d c : Ctx) (A : Ty c) (s : Sub d c) (r : RepTy c A) (r' : RepSub d c s) : RepTy d (subT d c A s) =
  mkRepTy d (subT d c A s) (rsD d c s r') (gsb (rtA c A r) (rss d c s r')) (subT-der d c A s r r')
    (rsWD d c s r') (rsPD d c s r')
    (subT-beta' d c A s r r' (rsD d c s r') (subT-der d c A s r r') (rsWD d c s r') (rsPD d c s r')) ;

------------------------------------------------------------------------
-- terms:  subt d c A a s,  a : A0 over G, s : D -> G'

module OpSubt (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) {
  W : U l = RepEl c A a * RepSub d c s ;
  G (x : W) : GE = reG c A a x.1 ;
  A0 (x : W) : GE = reA c A a x.1 ;
  a0 (x : W) : GE = rea c A a x.1 ;
  D (x : W) : GE = rsD d c s x.2 ;
  G' (x : W) : GE = rsG d c s x.2 ;
  s0 (x : W) : GE = rss d c s x.2 ;
  rA (x : W) : RepTy c A = re-ty c A a x.1 ;
  cx (x : W) : Pf (gjeqcx (G x) (G' x)) =
    same-cx c (G x) (G' x) (reW c A a x.1) (rsWG d c s x.2) (reP c A a x.1) (rsPG d c s x.2) ;
  derT (x : W) : Pf (gjty (D x) (gsb (A0 x) (s0 x))) = subT-der d c A s (rA x) x.2 ;
  der (x : W) : Pf (gjtm (D x) (gsb (a0 x) (s0 x)) (gsb (A0 x) (s0 x))) =
    pf-map5 (gjtm (G x) (a0 x) (A0 x)) (gjty (G x) (A0 x)) (gjsub (D x) (s0 x) (G' x)) (gjeqcx (G x) (G' x))
      (gjwf (G' x)) (gjtm (D x) (gsb (a0 x) (s0 x)) (gsb (A0 x) (s0 x)))
      (\ ha hA hs k w -> gm-sb (D x) (G' x) (a0 x) (A0 x) (s0 x) (gt-cx (G x) (G' x) (A0 x) w k hA)
        (gm-cx (G x) (G' x) (a0 x) (A0 x) w k ha) hs)
      (reH c A a x.1) (reHA c A a x.1) (rsH d c s x.2) (cx x) (rsWG d c s x.2) ;
  pT (x : W) : Id (Ty d) (clsTy d (D x) (gsb (A0 x) (s0 x)) (derT x) (rsWD d c s x.2) (rsPD d c s x.2)) (subT d c A s) =
    subT-beta' d c A s (rA x) x.2 (D x) (derT x) (rsWD d c s x.2) (rsPD d c s x.2) ;
  f (x : W) : El d (subT d c A s) =
    clsEl d (subT d c A s) (D x) (gsb (A0 x) (s0 x)) (gsb (a0 x) (s0 x)) (der x) (derT x)
      (rsWD d c s x.2) (rsPD d c s x.2) (pT x) ;
  rel (x y : W) : Pf (gjeqtm (D x) (gsb (a0 x) (s0 x)) (gsb (a0 y) (s0 y)) (gsb (A0 x) (s0 x))) =
    pf-map6 (gjtm (G x) (a0 x) (A0 x)) (gjty (G x) (A0 x)) (gjeqcx (G x) (G' x)) (gjwf (G' x))
      (gjeqtm (G x) (a0 x) (a0 y) (A0 x)) (gjeqsub (D x) (s0 x) (s0 y) (G' x))
      (gjeqtm (D x) (gsb (a0 x) (s0 x)) (gsb (a0 y) (s0 y)) (gsb (A0 x) (s0 x)))
      (\ ha hA k w ea es -> gm-esb (D x) (G' x) (a0 x) (a0 y) (A0 x) (s0 x) (s0 y)
        (gt-cx (G x) (G' x) (A0 x) w k hA) (gm-cx (G x) (G' x) (a0 x) (A0 x) w k ha)
        (gm-ecx (G x) (G' x) (a0 x) (a0 y) (A0 x) w k ea)
        (GP.gpresup (gjeqsub (D x) (s0 x) (s0 y) (G' x)) es).2.2.1
        (GP.gpresup (gjeqsub (D x) (s0 x) (s0 y) (G' x)) es).2.2.2 es)
      (reH c A a x.1) (reHA c A a x.1) (cx x) (rsWG d c s x.2) (same-re c A a x.1 y.1) (same-rs d c s x.2 y.2) ;
  const (x y : W) : Id (El d (subT d c A s)) (f x) (f y) =
    clsEl-eq d (subT d c A s) (D x) (gsb (A0 x) (s0 x)) (gsb (a0 x) (s0 x)) (der x) (derT x)
      (rsWD d c s x.2) (rsPD d c s x.2) (pT x)
      (D y) (gsb (A0 y) (s0 y)) (gsb (a0 y) (s0 y)) (der y) (derT y)
      (rsWD d c s y.2) (rsPD d c s y.2) (pT y) (rel x y) ;
  module Ch = Choice[W, El d (subT d c A s), isSetEl d (subT d c A s), f, const] ;
  reps : Sq W = sq-pair (RepEl c A a) (RepSub d c s) (rep-el c A a) (rep-sub d c s) ;
  value : El d (subT d c A s) = Ch.elim reps ;
  beta (x : W) : Id (El d (subT d c A s)) value (f x) = Ch.beta reps x ;
} ;

subt (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) : El d (subT d c A s) = OpSubt[d,c,A,a,s].value ;
subt-der (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) (r : RepEl c A a) (r' : RepSub d c s) :
  Pf (gjtm (rsD d c s r') (gsb (rea c A a r) (rss d c s r')) (gsb (reA c A a r) (rss d c s r'))) =
  OpSubt[d,c,A,a,s].der (r, r') ;
-- for any raw context D1 and raw type A1 of the result
subt-beta (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) (r : RepEl c A a) (r' : RepSub d c s)
  (D1 A1 : GE) (h : Pf (gjtm D1 (gsb (rea c A a r) (rss d c s r')) A1)) (hA : Pf (gjty D1 A1))
  (w : Pf (gjwf D1)) (pd : Id Ctx (cls D1 w) d) (pT : Id (Ty d) (clsTy d D1 A1 hA w pd) (subT d c A s)) :
  Id (El d (subT d c A s)) (subt d c A a s) (clsEl d (subT d c A s) D1 A1 (gsb (rea c A a r) (rss d c s r')) h hA w pd pT) =
  trans (El d (subT d c A s)) (subt d c A a s) (OpSubt[d,c,A,a,s].f (r, r'))
    (clsEl d (subT d c A s) D1 A1 (gsb (rea c A a r) (rss d c s r')) h hA w pd pT)
    (OpSubt[d,c,A,a,s].beta (r, r'))
    (clsEl-irr d (subT d c A s) (rsD d c s r') (gsb (reA c A a r) (rss d c s r')) (gsb (rea c A a r) (rss d c s r'))
      (OpSubt[d,c,A,a,s].der (r, r')) (OpSubt[d,c,A,a,s].derT (r, r')) (rsWD d c s r') (rsPD d c s r')
      (OpSubt[d,c,A,a,s].pT (r, r')) D1 A1 h hA w pd pT) ;
