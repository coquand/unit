-- The code of the iterative sets in a strictly larger universe.
level k l ;
constraint k+ <= l ;
open Base ;
module Small = IterativeSets[k] ;
module Large = IterativeSets[l] ;
module Lift = IterativeSetLift[k,l] ;
module P = Prelude[k+] ;

universe-code : Large.V = Large.mkV Small.V Lift.liftV
  (\ x y p -> P.Sigma-eq Small.M Small.isIt x.1 y.1 x.2 y.2
    (Lift.liftV-inj x y p) (Small.isProp-isIt y.1)) ;

decode-universe-code : Id (U l) (Large.Ix universe-code) Small.V =
  refl Small.V ;
