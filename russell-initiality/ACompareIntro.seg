-- The remaining constructor cases of U1, using the introduction frames.
level l ;
open Base ; open Lib[l] ; open AGAT[l] ; open APresup[l] ; open ACtx[l] ; open AGen[l] ; open AUniqCases[l] ;

term-frame-type (D a T P : GA) (f : TmGen D a T) (i : Id GA f.2.1 P) : TE D P T =
  Prelude[l].subst GA (\ X -> TE D X T) f.2.1 P i f.2.2.2.2 ;

framed-term (D E a b P Q T V L : GA) (e : CE D E) (lD : CE L D) (l : TE D P T) (r : TE E Q V)
    (et : TE L P Q) (em : ME L a b P) : TE D T V * ME D a b T =
  term-compare-finish D E a b P Q T V e l r (move-te L D P Q lD et) (move-me L D a b P lD em) ;

uu-compare (n : Nat) (X Y : GA) : TyCompare (auu n X) (auu n Y) =
  \ D E e x y -> compare D E e (gen-ty D (auu n X) x) (gen-ty E (auu n Y) y)
  where {
    compare (D E : GA) (e : CE D E) (p : TyGen D (auu n X)) (q : TyGen E (auu n Y)) :
        TE D (auu n X) (auu n Y) =
      move-te X D (auu n X) (auu n Y) xd
        (ae-uu-cx X Y n (compare-origins X Y D E xd ye e) p.2.1.2)
      where {
        xd : CE X D = Prelude[l].subst GA (\ Z -> CE Z D) p.1 X p.2.1.1 p.2.2 ;
        ye : CE Y E = Prelude[l].subst GA (\ Z -> CE Z E) q.1 Y q.2.1.1 q.2.2 ;
      } ;
  } ;

pi-compare (A B A' B' : GA) (ca : TyCompare A A') (cb : TyCompare B B') : TyCompare (api A B) (api A' B') =
  \ D E e x y -> compare D E e (gen-ty D (api A B) x) (gen-ty E (api A' B') y)
  where {
    compare (D E : GA) (e : CE D E) (p : TyGen D (api A B)) (q : TyGen E (api A' B')) :
        TE D (api A B) (api A' B') =
      move-te p.1 D (api A B) (api A' B') p.2.2
        (ae-pi p.1 A A' B B' p.2.1.1 aa
          (cb (aext p.1 A) (aext q.1 A') (ac-ext p.1 q.1 A A' origins aa) p.2.1.2 q.2.1.2))
      where {
        origins : CE p.1 q.1 = compare-origins p.1 q.1 D E p.2.2 q.2.2 e ;
        aa : TE p.1 A A' = ca p.1 q.1 origins p.2.1.1 q.2.1.1 ;
      } ;
  } ;

el-compare (n : Nat) (a b : GA) (ca : TmCompare a b) : TyCompare (ael n a) (ael n b) =
  \ D E e x y -> compare D E e (gen-ty D (ael n a) x) (gen-ty E (ael n b) y)
  where {
    compare (D E : GA) (e : CE D E) (p : TyGen D (ael n a)) (q : TyGen E (ael n b)) :
        TE D (ael n a) (ael n b) =
      move-te p.1 D (ael n a) (ael n b) p.2.2
        (ae-el p.1 n a b (ca p.1 q.1 (auu n p.1) (auu n q.1)
          (compare-origins p.1 q.1 D E p.2.2 q.2.2 e) p.2.1 q.2.1).2) ;
  } ;

lam-compare (A B b A' B' b' : GA) (ca : TyCompare A A') (cb : TyCompare B B') (cc : TmCompare b b') :
    TmCompare (alam A B b) (alam A' B' b') =
  \ D E T V e x y -> compare D E T V e (gen-tm D (alam A B b) T x) (gen-tm E (alam A' B' b') V y)
  where {
    compare (D E T V : GA) (e : CE D E) (p : TmGen D (alam A B b) T) (q : TmGen E (alam A' B' b') V) :
        TE D T V * ME D (alam A B b) (alam A' B' b') T =
      framed-term D E (alam A B b) (alam A' B' b') (api A B) (api A' B') T V p.1 e p.2.2.2.1
        (term-frame-type D (alam A B b) T (api A B) p lp.2.2.2)
        (term-frame-type E (alam A' B' b') V (api A' B') q rp.2.2.2)
        (ae-pi p.1 A A' B B' lp.1 aa bb)
        (am-elam p.1 A A' B B' b b' lp.1 aa bb
          (cc (aext p.1 A) (aext q.1 A') B B' ext lp.2.2.1 rp.2.2.1).2)
      where {
        lp : TmIntro p.1 p.2.1 (alam A B b) = p.2.2.1 ;
        rp : TmIntro q.1 q.2.1 (alam A' B' b') = q.2.2.1 ;
        eq : CE p.1 q.1 = compare-origins p.1 q.1 D E p.2.2.2.1 q.2.2.2.1 e ;
        aa : TE p.1 A A' = ca p.1 q.1 eq lp.1 rp.1 ;
        ext : CE (aext p.1 A) (aext q.1 A') = ac-ext p.1 q.1 A A' eq aa ;
        bb : TE (aext p.1 A) B B' = cb (aext p.1 A) (aext q.1 A') ext lp.2.1 rp.2.1 ;
      } ;
  } ;

app-compare (A B c a A' B' c' a' : GA) (ca : TyCompare A A') (cb : TyCompare B B')
    (cf : TmCompare c c') (cx : TmCompare a a') : TmCompare (aapp A B c a) (aapp A' B' c' a') =
  \ D E T V e x y -> compare D E T V e (gen-tm D (aapp A B c a) T x) (gen-tm E (aapp A' B' c' a') V y)
  where {
    compare (D E T V : GA) (e : CE D E) (p : TmGen D (aapp A B c a) T) (q : TmGen E (aapp A' B' c' a') V) :
        TE D T V * ME D (aapp A B c a) (aapp A' B' c' a') T =
      framed-term D E (aapp A B c a) (aapp A' B' c' a') (asb B (asec A a)) (asb B' (asec A' a')) T V
        p.1 e p.2.2.2.1
        (term-frame-type D (aapp A B c a) T (asb B (asec A a)) p lp.2.2.2.2)
        (term-frame-type E (aapp A' B' c' a') V (asb B' (asec A' a')) q rp.2.2.2.2)
        (ae-sb p.1 (aext p.1 A) B B' (asec A a) (asec A' a') lp.2.1 bb sections.2.2.1 sections.2.2.2 sec)
        (am-eapp p.1 A A' B B' c c' a a' lp.1 lp.2.1 lp.2.2.2.1 aa bb
          (cf p.1 q.1 (api A B) (api A' B') eq lp.2.2.1 rp.2.2.1).2 xx)
      where {
        lp : TmIntro p.1 p.2.1 (aapp A B c a) = p.2.2.1 ;
        rp : TmIntro q.1 q.2.1 (aapp A' B' c' a') = q.2.2.1 ;
        eq : CE p.1 q.1 = compare-origins p.1 q.1 D E p.2.2.2.1 q.2.2.2.1 e ;
        aa : TE p.1 A A' = ca p.1 q.1 eq lp.1 rp.1 ;
        ext : CE (aext p.1 A) (aext q.1 A') = ac-ext p.1 q.1 A A' eq aa ;
        bb : TE (aext p.1 A) B B' = cb (aext p.1 A) (aext q.1 A') ext lp.2.1 rp.2.1 ;
        xx : ME p.1 a a' A = (cx p.1 q.1 A A' eq lp.2.2.2.1 rp.2.2.2.1).2 ;
        sec : SE p.1 (asec A a) (asec A' a') (aext p.1 A) =
          aq-sec p.1 A A' a a' lp.1 lp.2.2.2.1 (apresup (ajeqtm p.1 a a' A) xx).2.2.2 aa xx ;
        sections : APJ (ajeqsub p.1 (asec A a) (asec A' a') (aext p.1 A)) =
          apresup (ajeqsub p.1 (asec A a) (asec A' a') (aext p.1 A)) sec ;
      } ;
  } ;

pic-compare (n : Nat) (a b a' b' : GA) (ca : TmCompare a a') (cb : TmCompare b b') :
    TmCompare (apic n a b) (apic n a' b') =
  \ D E T V e x y -> compare D E T V e (gen-tm D (apic n a b) T x) (gen-tm E (apic n a' b') V y)
  where {
    compare (D E T V : GA) (e : CE D E) (p : TmGen D (apic n a b) T) (q : TmGen E (apic n a' b') V) :
        TE D T V * ME D (apic n a b) (apic n a' b') T =
      framed-term D E (apic n a b) (apic n a' b') (auu n p.1) (auu n q.1) T V p.1 e p.2.2.2.1
        (term-frame-type D (apic n a b) T (auu n p.1) p lp.2.2)
        (term-frame-type E (apic n a' b') V (auu n q.1) q rp.2.2)
        (ae-uu-cx p.1 q.1 n eq (a-universe-tm-bound p.1 a n lp.1))
        (am-epic p.1 n a a' b b' lp.1 aa
          (cb (aext p.1 (ael n a)) (aext q.1 (ael n a'))
            (auu n (aext p.1 (ael n a))) (auu n (aext q.1 (ael n a'))) ext lp.2.1 rp.2.1).2)
      where {
        lp : TmIntro p.1 p.2.1 (apic n a b) = p.2.2.1 ;
        rp : TmIntro q.1 q.2.1 (apic n a' b') = q.2.2.1 ;
        eq : CE p.1 q.1 = compare-origins p.1 q.1 D E p.2.2.2.1 q.2.2.2.1 e ;
        aa : ME p.1 a a' (auu n p.1) = (ca p.1 q.1 (auu n p.1) (auu n q.1) eq lp.1 rp.1).2 ;
        ext : CE (aext p.1 (ael n a)) (aext q.1 (ael n a')) =
          ac-ext p.1 q.1 (ael n a) (ael n a') eq (ae-el p.1 n a a' aa) ;
      } ;
  } ;

lf-compare (m n : Nat) (a b : GA) (ca : TmCompare a b) : TmCompare (alf m n a) (alf m n b) =
  \ D E T V e x y -> compare D E T V e (gen-tm D (alf m n a) T x) (gen-tm E (alf m n b) V y)
  where {
    compare (D E T V : GA) (e : CE D E) (p : TmGen D (alf m n a) T) (q : TmGen E (alf m n b) V) :
        TE D T V * ME D (alf m n a) (alf m n b) T =
      framed-term D E (alf m n a) (alf m n b) (auu n p.1) (auu n q.1) T V p.1 e p.2.2.2.1
        (term-frame-type D (alf m n a) T (auu n p.1) p lp.2.2.2)
        (term-frame-type E (alf m n b) V (auu n q.1) q rp.2.2.2)
        (ae-uu-cx p.1 q.1 n eq lp.2.2.1)
        (am-elf p.1 m n a b (ca p.1 q.1 (auu m p.1) (auu m q.1) eq lp.1 rp.1).2 lp.2.1 lp.2.2.1)
      where {
        lp : TmIntro p.1 p.2.1 (alf m n a) = p.2.2.1 ;
        rp : TmIntro q.1 q.2.1 (alf m n b) = q.2.2.1 ;
        eq : CE p.1 q.1 = compare-origins p.1 q.1 D E p.2.2.2.1 q.2.2.2.1 e ;
      } ;
  } ;

code-frame (m n : Nat) (D X T : GA) (v : TmGen D (auc m n X) T) : CE X D * TE D (auu n X) T =
  (Prelude[l].subst GA (\ Z -> CE Z D) v.1 X h.1 v.2.2.2.1,
   term-frame-type D (auc m n X) T (auu n X) v
     (Prelude[l].trans GA v.2.1 (auu n v.1) (auu n X) h.2.2.2
       (Prelude[l].ap GA GA (\ Z -> auu n Z) v.1 X h.1)))
  where { h : TmIntro v.1 v.2.1 (auc m n X) = v.2.2.1 ; } ;

uc-compare (m n : Nat) (X Y : GA) : TmCompare (auc m n X) (auc m n Y) =
  \ D E T V e x y -> compare D E T V e (gen-tm D (auc m n X) T x) (gen-tm E (auc m n Y) V y)
  where {
    compare (D E T V : GA) (e : CE D E) (p : TmGen D (auc m n X) T) (q : TmGen E (auc m n Y) V) :
        TE D T V * ME D (auc m n X) (auc m n Y) T =
      framed-term D E (auc m n X) (auc m n Y) (auu n X) (auu n Y) T V X e lp.1 lp.2 rp.2
        (ae-uu-cx X Y n eq p.2.2.1.2.2.1)
        (am-uc-cx X Y m n eq p.2.2.1.2.1 p.2.2.1.2.2.1)
      where {
        lp : CE X D * TE D (auu n X) T = code-frame m n D X T p ;
        rp : CE Y E * TE E (auu n Y) V = code-frame m n E Y V q ;
        eq : CE X Y = compare-origins X Y D E lp.1 rp.1 e ;
      } ;
  } ;

id-frame (D G X : GA) (v : SubGen D (aid X) G) : CE X D * CE X G =
  (Prelude[l].subst GA (\ Z -> CE Z D) v.1 X v.2.2.1.1 v.2.2.2.1,
   Prelude[l].subst GA (\ Z -> CE Z G) v.2.1 X v.2.2.1.2.1 v.2.2.2.2) ;

id-compare (X Y : GA) : SubCompare (aid X) (aid Y) =
  \ D E G H e x y -> compare D E G H e
    (id-frame D G X (gen-sub D (aid X) G x)) (id-frame E H Y (gen-sub E (aid Y) H y))
  where {
    compare (D E G H : GA) (e : CE D E) (p : CE X D * CE X G) (q : CE Y E * CE Y H) :
        CE G H * SE D (aid X) (aid Y) G =
      (compare-ends X Y G H p.2 q.2 eq, move-se X D X G (aid X) (aid Y) p.1 p.2 (aq-id-cx X Y eq))
      where { eq : CE X Y = compare-origins X Y D E p.1 q.1 e ; } ;
  } ;

eps-frame (D G X : GA) (v : SubGen D (aeps X) G) : CE X D * CE anil G =
  (Prelude[l].subst GA (\ Z -> CE Z D) v.1 X v.2.2.1.1 v.2.2.2.1,
   Prelude[l].subst GA (\ Z -> CE Z G) v.2.1 anil v.2.2.1.2.1 v.2.2.2.2) ;

eps-compare (X Y : GA) : SubCompare (aeps X) (aeps Y) =
  \ D E G H e x y -> compare D E G H e
    (eps-frame D G X (gen-sub D (aeps X) G x)) (eps-frame E H Y (gen-sub E (aeps Y) H y))
  where {
    compare (D E G H : GA) (e : CE D E) (p : CE X D * CE anil G) (q : CE Y E * CE anil H) :
        CE G H * SE D (aeps X) (aeps Y) G =
      (compare-ends anil anil G H p.2 q.2 ac-nil, move-se X D anil G (aeps X) (aeps Y) p.1 p.2
        (aq-eps-cx X Y (compare-origins X Y D E p.1 q.1 e))) ;
  } ;

sec-compare (A a B b : GA) (ca : TyCompare A B) (cb : TmCompare a b) : SubCompare (asec A a) (asec B b) =
  \ D E G H e x y -> compare D E G H e (gen-sub D (asec A a) G x) (gen-sub E (asec B b) H y)
  where {
    compare (D E G H : GA) (e : CE D E) (p : SubGen D (asec A a) G) (q : SubGen E (asec B b) H) :
        CE G H * SE D (asec A a) (asec B b) G =
      (compare-ends (aext p.1 A) (aext q.1 B) G H lp rp (ac-ext p.1 q.1 A B eq aa),
       move-se p.1 D (aext p.1 A) G (asec A a) (asec B b) p.2.2.2.1 lp
         (aq-sec p.1 A B a b p.2.2.1.2.1 p.2.2.1.2.2 (apresup (ajeqtm p.1 a b A) ab).2.2.2 aa ab))
      where {
        lp : CE (aext p.1 A) G =
          Prelude[l].subst GA (\ Z -> CE Z G) p.2.1 (aext p.1 A) p.2.2.1.1 p.2.2.2.2 ;
        rp : CE (aext q.1 B) H =
          Prelude[l].subst GA (\ Z -> CE Z H) q.2.1 (aext q.1 B) q.2.2.1.1 q.2.2.2.2 ;
        eq : CE p.1 q.1 = compare-origins p.1 q.1 D E p.2.2.2.1 q.2.2.2.1 e ;
        aa : TE p.1 A B = ca p.1 q.1 eq p.2.2.1.2.1 q.2.2.1.2.1 ;
        ab : ME p.1 a b A = (cb p.1 q.1 A B eq p.2.2.1.2.2 q.2.2.1.2.2).2 ;
      } ;
  } ;

comp-compare (s d t e : GA) (cs : SubCompare s t) (cd : SubCompare d e) : SubCompare (acomp s d) (acomp t e) =
  \ D E G H de x y -> compare D E G H de (gen-sub D (acomp s d) G x) (gen-sub E (acomp t e) H y)
  where {
    compare (D E G H : GA) (de : CE D E) (p : SubGen D (acomp s d) G) (q : SubGen E (acomp t e) H) :
        CE G H * SE D (acomp s d) (acomp t e) G =
      (compare-ends p.2.1 q.2.1 G H p.2.2.2.2 q.2.2.2.2 ps.1,
       move-se p.1 D p.2.1 G (acomp s d) (acomp t e) p.2.2.2.1 p.2.2.2.2
         (aq-comp p.1 lp.1 p.2.1 s t d e ps.2 pd.2))
      where {
        lp : SubIntro p.1 p.2.1 (acomp s d) = p.2.2.1 ;
        rp : SubIntro q.1 q.2.1 (acomp t e) = q.2.2.1 ;
        pd : CE lp.1 rp.1 * SE p.1 d e lp.1 =
          cd p.1 q.1 lp.1 rp.1 (compare-origins p.1 q.1 D E p.2.2.2.1 q.2.2.2.1 de) lp.2.2 rp.2.2 ;
        ps : CE p.2.1 q.2.1 * SE lp.1 s t p.2.1 = cs lp.1 rp.1 p.2.1 q.2.1 pd.1 lp.2.1 rp.2.1 ;
      } ;
  } ;
