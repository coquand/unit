-- Raw denotation checks in an arbitrary bounded model.
open Base ;
open Prelude[l] ;
open Paths[l] ;
open TEInterpBase ;
open TEDenote ;

U0 : C.Ty (ctx empty-tel) = M.univ (zero,tt) (ctx empty-tel) ;
G : Tel = extend empty-tel U0 ;
A : B.GAT[l].GE = gsb (guu zero) gp ;
Ap : C.Ty (ctx G) = C.subT (ctx G) (ctx empty-tel) U0 (C.p (ctx empty-tel) U0) ;
a : C.El (ctx G) Ap = C.q (ctx empty-tel) U0 ;

universe-by-projection : TyDown A G Ap =
  ((tt,((tt,tt),tt)),refl Ap) ;

section-denotes : SubDown (gsec A gq) G (extend G Ap) (C.sec (ctx G) Ap a) =
  ((universe-by-projection.1,((tt,refl Ap),tt)),refl (extend G Ap,C.sec (ctx G) Ap a)) ;

projection-after-section : SubDown (gcomp gp (gsec A gq)) G G (C.id (ctx G)) =
  ((section-denotes.1,(tt,tt)),apH (\ s -> (G,s)) (C.p-sec (ctx G) Ap a)) ;
