-- Russell correspondence through the two translations on FAJ.
level l ;
open Base ; open TSyntax[l] ; open TTyping[l] ; open RTyping[l] ;
open FGAT[l] ; open CGAT[l] ; open CToFull[l] ; open CFromFull[l] ; open FRGAT[l] ;

c-derivability (J : FAJ) : (FADer J -> CDer J) * (CDer J -> FADer J) = (c-from-full J, c-to-full J) ;

CWf (G : Cx) : U l = (X : FA) * (CDer (fjwf X) * Id Cx (fC X) G) ;
CTy (G : Cx) (A : Tm) : U l =
  (X Y : FA) * (CDer (fjty X Y) * (Id Cx (fC X) G * Id Tm (fT Y) A)) ;
CTm (G : Cx) (a A : Tm) : U l =
  (X y Y : FA) * (CDer (fjtm X y Y) * (Id Cx (fC X) G * (Id Tm (fT y) a * Id Tm (fT Y) A))) ;
CEqTy (G : Cx) (A B : Tm) : U l =
  (X Y Z : FA) * (CDer (fjeqty X Y Z) * (Id Cx (fC X) G * (Id Tm (fT Y) A * Id Tm (fT Z) B))) ;
CEqTm (G : Cx) (a b A : Tm) : U l =
  (X y z Y : FA) * (CDer (fjeqtm X y z Y) * (Id Cx (fC X) G * (Id Tm (fT y) a * (Id Tm (fT z) b * Id Tm (fT Y) A)))) ;

r2c-wf (G : Cx) (h : RDer (jwf G)) : CWf G =
  (q.1,(c-from-full (fjwf q.1) q.2.1,q.2.2))
 where { q : FWf G = r2f-wf G h ; } ;

r2c-ty (G : Cx) (A : Tm) (h : RDer (jty G A)) : CTy G A =
  (q.1,(q.2.1,(c-from-full (fjty q.1 q.2.1) q.2.2.1,q.2.2.2)))
 where { q : FTy G A = r2f-ty G A h ; } ;

r2c-tm (G : Cx) (a A : Tm) (h : RDer (jtm G a A)) : CTm G a A =
  (q.1,(q.2.1,(q.2.2.1,(c-from-full (fjtm q.1 q.2.1 q.2.2.1) q.2.2.2.1,q.2.2.2.2))))
 where { q : FTm G a A = r2f-tm G a A h ; } ;

r2c-eqty (G : Cx) (A B : Tm) (h : RDer (jeqty G A B)) : CEqTy G A B =
  (q.1,(q.2.1,(q.2.2.1,(c-from-full (fjeqty q.1 q.2.1 q.2.2.1) q.2.2.2.1,q.2.2.2.2))))
 where { q : FEqTy G A B = r2f-eqty G A B h ; } ;

r2c-eqtm (G : Cx) (a b A : Tm) (h : RDer (jeqtm G a b A)) : CEqTm G a b A =
  (q.1,(q.2.1,(q.2.2.1,(q.2.2.2.1,(c-from-full (fjeqtm q.1 q.2.1 q.2.2.1 q.2.2.2.1) q.2.2.2.2.1,q.2.2.2.2.2)))))
 where { q : FEqTm G a b A = r2f-eqtm G a b A h ; } ;

c2r-wf (G : FA) (h : CDer (fjwf G)) : RDer (jwf (fC G)) = f2r-wf G (c-to-full (fjwf G) h) ;
c2r-ty (G A : FA) (h : CDer (fjty G A)) : RDer (jty (fC G) (fT A)) = f2r-ty G A (c-to-full (fjty G A) h) ;
c2r-tm (G a A : FA) (h : CDer (fjtm G a A)) : RDer (jtm (fC G) (fT a) (fT A)) =
  f2r-tm G a A (c-to-full (fjtm G a A) h) ;
c2r-eqty (G A B : FA) (h : CDer (fjeqty G A B)) : RDer (jeqty (fC G) (fT A) (fT B)) =
  f2r-eqty G A B (c-to-full (fjeqty G A B) h) ;
c2r-eqtm (G a b A : FA) (h : CDer (fjeqtm G a b A)) : RDer (jeqtm (fC G) (fT a) (fT b) (fT A)) =
  f2r-eqtm G a b A (c-to-full (fjeqtm G a b A) h) ;

-- Representatives with equal Russell images are convertible in CGAT.
cu-cx (G H : FA) (wG : CDer (fjwf G)) (wH : CDer (fjwf H)) (e : Id Cx (fC G) (fC H)) :
    CDer (fjeqcx G H) = c-from-full (fjeqcx G H) (fu-cx1 G H (c-to-full (fjwf G) wG) (c-to-full (fjwf H) wH) e) ;

cu-ty (G A B : FA) (hA : CDer (fjty G A)) (hB : CDer (fjty G B)) (e : Id Tm (fT A) (fT B)) :
    CDer (fjeqty G A B) =
  c-from-full (fjeqty G A B) (fu-ty G A B (c-to-full (fjty G A) hA) (c-to-full (fjty G B) hB) e) ;

cu-tm (G a A b B : FA) (ha : CDer (fjtm G a A)) (hb : CDer (fjtm G b B))
    (e : Id Tm (fT a) (fT b)) (eT : Id Tm (fT A) (fT B)) : CDer (fjeqty G A B) * CDer (fjeqtm G a b A) =
  (c-from-full (fjeqty G A B) q.1,c-from-full (fjeqtm G a b A) q.2)
 where {
  q : FADer (fjeqty G A B) * FADer (fjeqtm G a b A) =
    fu-tm G a A b B (c-to-full (fjtm G a A) ha) (c-to-full (fjtm G b B) hb) e eT ;
 } ;

cu-eqty (G A B A' B' : FA) (h : CDer (fjeqty G A B)) (k : CDer (fjeqty G A' B'))
    (eA : Id Tm (fT A) (fT A')) (eB : Id Tm (fT B) (fT B')) : CDer (fjeqty G A A') * CDer (fjeqty G B B') =
  (c-from-full (fjeqty G A A') q.1,c-from-full (fjeqty G B B') q.2)
 where {
  q : FADer (fjeqty G A A') * FADer (fjeqty G B B') =
    fu-eqty G A B A' B' (c-to-full (fjeqty G A B) h) (c-to-full (fjeqty G A' B') k) eA eB ;
 } ;

cu-eqtm (G a b A a' b' B : FA) (h : CDer (fjeqtm G a b A)) (k : CDer (fjeqtm G a' b' B))
    (ea : Id Tm (fT a) (fT a')) (eb : Id Tm (fT b) (fT b')) (eA : Id Tm (fT A) (fT B)) :
    CDer (fjeqty G A B) * (CDer (fjeqtm G a a' A) * CDer (fjeqtm G b b' A)) =
  (c-from-full (fjeqty G A B) q.1,(c-from-full (fjeqtm G a a' A) q.2.1,c-from-full (fjeqtm G b b' A) q.2.2))
 where {
  q : FADer (fjeqty G A B) * (FADer (fjeqtm G a a' A) * FADer (fjeqtm G b b' A)) =
    fu-eqtm G a b A a' b' B (c-to-full (fjeqtm G a b A) h) (c-to-full (fjeqtm G a' b' B) k) ea eb eA ;
 } ;
