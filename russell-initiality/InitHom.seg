-- PLAN-INIT Part H: strict morphisms between Ehrhard models of level N.
-- Morphism (l, N, M, M'): a morphism M -> M' is a record Hom (InitHomLaws);
-- InitHomBase has the total spaces of M', InitHomRel* the relational form
-- of every law (the form used for uniqueness), InitHomLaws also Agree.
module Morphism (l : Level) (N : Base.Nat) (M : EhrhardTEModel[l].TEModel[N]) (M' : EhrhardTEModel[l].TEModel[N]) {
  import InitHomBase ; import InitHomLaws ; import InitHomRelA ; import InitHomRelB ; import InitHomStep ;
} ;
