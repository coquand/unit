-- RTyping.seg: the judgements of T_Russell with annotations (sterbac4
-- Appendix A.3), over the raw syntax of TSyntax (only var, pi, lam, app,
-- uu are used) and the judgement forms Jf / contexts Cx of TTyping.
-- Cumulativity A : U_n => A : U_p for n <= p (as the lifts of TTyping).
-- Extra premises (admissible presuppositions) as in TTyping, so that the
-- erasure of every T_Tarski rule is an instance of a rule here.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ;

data RDer : (J : Jf) -> U l =
  -- contexts
    rwf-nil : RDer (jwf cnil)
  | rwf-snoc (G : Cx) (A : Tm) (h : RDer (jty G A)) : RDer (jwf (csnoc G A))
  -- variables
  | rtm-v0 (G : Cx) (A : Tm) (h : RDer (jty G A)) : RDer (jtm (csnoc G A) (var zero) (wk A))
  | rtm-vs (G : Cx) (B : Tm) (n : Nat) (A : Tm) (h1 : RDer (jtm G (var n) A)) (h2 : RDer (jty G B)) :
      RDer (jtm (csnoc G B) (var (suc n)) (wk A))
  -- types
  | rty-pi (G : Cx) (A B : Tm) (h1 : RDer (jty G A)) (h2 : RDer (jty (csnoc G A) B)) : RDer (jty G (pi A B))
  | rty-uu (G : Cx) (n : Nat) (h : RDer (jwf G)) (nb : LeN n N) : RDer (jty G (uu n))
  | rty-of (G : Cx) (n : Nat) (A : Tm) (h : RDer (jtm G A (uu n))) : RDer (jty G A)
  -- terms
  | rtm-lam (G : Cx) (A B b : Tm) (h1 : RDer (jty G A)) (h2 : RDer (jty (csnoc G A) B))
      (h3 : RDer (jtm (csnoc G A) b B)) : RDer (jtm G (lam A B b) (pi A B))
  | rtm-app (G : Cx) (A B c a : Tm) (h1 : RDer (jty G A)) (h2 : RDer (jty (csnoc G A) B))
      (h3 : RDer (jtm G c (pi A B))) (h4 : RDer (jtm G a A)) : RDer (jtm G (app A B c a) (subst1 B a))
  | rtm-pi (G : Cx) (n : Nat) (A B : Tm) (h1 : RDer (jtm G A (uu n))) (h2 : RDer (jtm (csnoc G A) B (uu n))) :
      RDer (jtm G (pi A B) (uu n))
  | rtm-uu (G : Cx) (m n : Nat) (h : RDer (jwf G)) (lt : LeN (suc m) n) (nb : LeN n N) : RDer (jtm G (uu m) (uu n))
  | rtm-cum (G : Cx) (m n : Nat) (A : Tm) (h : RDer (jtm G A (uu m))) (le : LeN (suc m) n) (nb : LeN n N) : RDer (jtm G A (uu n))
  | rtm-conv (G : Cx) (a A B : Tm) (h1 : RDer (jtm G a A)) (h2 : RDer (jeqty G A B)) : RDer (jtm G a B)
  -- type equality
  | reqty-refl (G : Cx) (A : Tm) (h : RDer (jty G A)) : RDer (jeqty G A A)
  | reqty-sym (G : Cx) (A B : Tm) (h : RDer (jeqty G A B)) : RDer (jeqty G B A)
  | reqty-trans (G : Cx) (A B C : Tm) (h1 : RDer (jeqty G A B)) (h2 : RDer (jeqty G B C)) : RDer (jeqty G A C)
  | reqty-pi (G : Cx) (A A' B B' : Tm) (h0 : RDer (jty G A)) (h1 : RDer (jeqty G A A')) (h2 : RDer (jeqty (csnoc G A) B B')) :
      RDer (jeqty G (pi A B) (pi A' B'))
  | reqty-of (G : Cx) (n : Nat) (A A' : Tm) (h : RDer (jeqtm G A A' (uu n))) : RDer (jeqty G A A')
  -- term equality
  | reqtm-refl (G : Cx) (a A : Tm) (h : RDer (jtm G a A)) : RDer (jeqtm G a a A)
  | reqtm-sym (G : Cx) (a b A : Tm) (hA : RDer (jty G A)) (h : RDer (jeqtm G a b A)) : RDer (jeqtm G b a A)
  | reqtm-trans (G : Cx) (a b c A : Tm) (h1 : RDer (jeqtm G a b A)) (h2 : RDer (jeqtm G b c A)) : RDer (jeqtm G a c A)
  | reqtm-conv (G : Cx) (a b A B : Tm) (h1 : RDer (jeqtm G a b A)) (h2 : RDer (jeqty G A B)) : RDer (jeqtm G a b B)
  | reqtm-cum (G : Cx) (m n : Nat) (a b : Tm) (h : RDer (jeqtm G a b (uu m))) (le : LeN (suc m) n) (nb : LeN n N) : RDer (jeqtm G a b (uu n))
  | reqtm-pi (G : Cx) (n : Nat) (A A' B B' : Tm) (h0 : RDer (jtm G A (uu n))) (h1 : RDer (jeqtm G A A' (uu n)))
      (h2 : RDer (jeqtm (csnoc G A) B B' (uu n))) : RDer (jeqtm G (pi A B) (pi A' B') (uu n))
  | reqtm-lam (G : Cx) (A A' B B' b b' : Tm) (h0 : RDer (jty G A)) (h1 : RDer (jeqty G A A')) (h2 : RDer (jeqty (csnoc G A) B B'))
      (h3 : RDer (jeqtm (csnoc G A) b b' B)) : RDer (jeqtm G (lam A B b) (lam A' B' b') (pi A B))
  | reqtm-app (G : Cx) (A A' B B' c c' a a' : Tm) (h0 : RDer (jty G A)) (hB : RDer (jty (csnoc G A) B)) (ha : RDer (jtm G a A))
      (h1 : RDer (jeqty G A A')) (h2 : RDer (jeqty (csnoc G A) B B'))
      (h3 : RDer (jeqtm G c c' (pi A B))) (h4 : RDer (jeqtm G a a' A)) :
      RDer (jeqtm G (app A B c a) (app A' B' c' a') (subst1 B a))
  | reqtm-beta (G : Cx) (A B b a : Tm) (hA : RDer (jty G A)) (hB : RDer (jty (csnoc G A) B)) (h1 : RDer (jtm (csnoc G A) b B))
      (h2 : RDer (jtm G a A)) : RDer (jeqtm G (app A B (lam A B b) a) (subst1 b a) (subst1 B a))
  | reqtm-eta (G : Cx) (A B f : Tm) (hA : RDer (jty G A)) (hB : RDer (jty (csnoc G A) B)) (h : RDer (jtm G f (pi A B))) :
      RDer (jeqtm G f (lam A B (app (wk A) (wkl B) (wk f) (var zero))) (pi A B)) ;

rder-tm-ty (G : Cx) (a A A' : Tm) (e : Id Tm A A') (d : RDer (jtm G a A)) : RDer (jtm G a A') =
  subst Tm (\ T -> RDer (jtm G a T)) A A' e d ;
rder-ty (G : Cx) (A A' : Tm) (e : Id Tm A A') (d : RDer (jty G A)) : RDer (jty G A') =
  subst Tm (\ T -> RDer (jty G T)) A A' e d ;
rder-eqtm-r (G : Cx) (a b b' A : Tm) (e : Id Tm b b') (d : RDer (jeqtm G a b A)) : RDer (jeqtm G a b' A) =
  subst Tm (\ T -> RDer (jeqtm G a T A)) b b' e d ;
rder-eqtm-ty (G : Cx) (a b A A' : Tm) (e : Id Tm A A') (d : RDer (jeqtm G a b A)) : RDer (jeqtm G a b A') =
  subst Tm (\ T -> RDer (jeqtm G a b T)) A A' e d ;
