-- InitOpsPi.seg (PLAN-INIT, Part F): dependent products of the term model.
--   Pi c A B        raw  gpi A B
--   pi-inv c A B b  raw  glam A B b                 (Pi-iso inv, abstraction)
--   pi-fun c A B f  raw  gapp (A p) (B lift_A(p)) (f p) q  over G.A
--                                                    (Pi-iso fun)
-- The Iso record itself (fun-inv, inv-fun) is an equation (Part A).
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;

------------------------------------------------------------------------
-- raw application to the variable, and its congruence (in GDer)

app-q (A B f : GE) : GE = gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq ;

app-q-der (G A B f : GE) (hA : GDer (gjty G A)) (hB : GDer (gjty (gext G A) B)) (hf : GDer (gjtm G f (gpi A B))) :
  GDer (gjtm (gext G A) (app-q A B f) B) =
  gm-conv E (app-q A B f) (gsb (gsb B (glift A gp)) (gsec (gsb A gp) gq)) B
    (gm-app E (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq hAp hBl hfp (gm-q G A hA))
    (GP.sb-eta G A B hA hB)
 where {
  E : GE = gext G A ;
  hp : GDer (gjsub E gp G) = gs-p G A hA ;
  hAp : GDer (gjty E (gsb A gp)) = gt-sb E G A gp hA hp ;
  hl : GDer (gjsub (gext E (gsb A gp)) (glift A gp) E) = gs-lift E G A gp hp hA ;
  hBl : GDer (gjty (gext E (gsb A gp)) (gsb B (glift A gp))) = gt-sb (gext E (gsb A gp)) E B (glift A gp) hB hl ;
  hfp : GDer (gjtm E (gsb f gp) (gpi (gsb A gp) (gsb B (glift A gp)))) =
    gm-conv E (gsb f gp) (gsb (gpi A B) gp) (gpi (gsb A gp) (gsb B (glift A gp)))
      (gm-sb E G f (gpi A B) gp (gt-pi G A B hA hB) hf hp) (ge-pi-sb E G A B gp hA hB hp) ;
 } ;

app-q-eq (G A A' B B' f f' : GE) (hA : GDer (gjty G A)) (hB : GDer (gjty (gext G A) B))
  (hf : GDer (gjtm G f (gpi A B))) (eA : GDer (gjeqty G A A')) (eB : GDer (gjeqty (gext G A) B B'))
  (ef : GDer (gjeqtm G f f' (gpi A B))) :
  GDer (gjeqtm (gext G A) (app-q A B f) (app-q A' B' f') B) =
  gm-eqconv E (app-q A B f) (app-q A' B' f') (gsb (gsb B (glift A gp)) (gsec (gsb A gp) gq)) B
    (gm-eapp E (gsb A gp) (gsb A' gp) (gsb B (glift A gp)) (gsb B' (glift A' gp)) (gsb f gp) (gsb f' gp) gq gq
      hAp hBl (gm-q G A hA) eAp eBl efp (gm-refl E gq (gsb A gp) (gm-q G A hA)))
    (GP.sb-eta G A B hA hB)
 where {
  E : GE = gext G A ;
  hp : GDer (gjsub E gp G) = gs-p G A hA ;
  hpp : GDer (gjeqsub E gp gp G) = gq-refl E gp G hp ;
  hAp : GDer (gjty E (gsb A gp)) = gt-sb E G A gp hA hp ;
  hl : GDer (gjsub (gext E (gsb A gp)) (glift A gp) E) = gs-lift E G A gp hp hA ;
  hBl : GDer (gjty (gext E (gsb A gp)) (gsb B (glift A gp))) = gt-sb (gext E (gsb A gp)) E B (glift A gp) hB hl ;
  el : GDer (gjeqsub (gext E (gsb A gp)) (glift A gp) (glift A' gp) E) = gq-lift E G A A' gp gp hA eA hp hpp ;
  eAp : GDer (gjeqty E (gsb A gp) (gsb A' gp)) = ge-sb E G A A' gp gp hA eA hp hp hpp ;
  eBl : GDer (gjeqty (gext E (gsb A gp)) (gsb B (glift A gp)) (gsb B' (glift A' gp))) =
    ge-sb (gext E (gsb A gp)) E B B' (glift A gp) (glift A' gp) hB eB hl
      (GP.gpresup (gjeqsub (gext E (gsb A gp)) (glift A gp) (glift A' gp) E) el).2.2.2 el ;
  efp : GDer (gjeqtm E (gsb f gp) (gsb f' gp) (gpi (gsb A gp) (gsb B (glift A gp)))) =
    gm-eqconv E (gsb f gp) (gsb f' gp) (gsb (gpi A B) gp) (gpi (gsb A gp) (gsb B (glift A gp)))
      (gm-esb E G f f' (gpi A B) gp gp (gt-pi G A B hA hB) hf ef hp hp hpp) (ge-pi-sb E G A B gp hA hB hp) ;
 } ;

------------------------------------------------------------------------
-- Pi c A B,  A over G,  B over (a context equal to) G.A0

module OpPi (c : Ctx) (A : Ty c) (T : Ty (ext c A)) {
  W : U l = RepTy c A * RepTy (ext c A) T ;
  G (x : W) : GE = rtG c A x.1 ;
  A0 (x : W) : GE = rtA c A x.1 ;
  B0 (x : W) : GE = rtA (ext c A) T x.2 ;
  wE (x : W) : Pf (gjwf (gext (G x) (A0 x))) = ext-der c A x.1 ;
  pE (x : W) : Id Ctx (cls (gext (G x) (A0 x)) (wE x)) (ext c A) = ext-beta' c A x.1 (wE x) ;
  -- B, represented over G.A0
  rB (x : W) : RepTy (ext c A) T = rt-move (ext c A) T x.2 (gext (G x) (A0 x)) (wE x) (pE x) ;
  der (x : W) : Pf (gjty (G x) (gpi (A0 x) (B0 x))) =
    pf-map2 (gjty (G x) (A0 x)) (gjty (gext (G x) (A0 x)) (B0 x)) (gjty (G x) (gpi (A0 x) (B0 x)))
      (\ ha hb -> gt-pi (G x) (A0 x) (B0 x) ha hb) (rtH c A x.1) (rtH (ext c A) T (rB x)) ;
  f (x : W) : Ty c = clsTy c (G x) (gpi (A0 x) (B0 x)) (der x) (rtW c A x.1) (rtP c A x.1) ;
  rel (x y : W) : Pf (gjeqty (G x) (gpi (A0 x) (B0 x)) (gpi (A0 y) (B0 y))) =
    pf-map3 (gjty (G x) (A0 x)) (gjeqty (G x) (A0 x) (A0 y)) (gjeqty (gext (G x) (A0 x)) (B0 x) (B0 y))
      (gjeqty (G x) (gpi (A0 x) (B0 x)) (gpi (A0 y) (B0 y)))
      (\ ha eA eB -> ge-pi (G x) (A0 x) (A0 y) (B0 x) (B0 y) ha eA eB)
      (rtH c A x.1) (same-rt c A x.1 y.1) (same-rt (ext c A) T (rB x) y.2) ;
  const (x y : W) : Id (Ty c) (f x) (f y) =
    clsTy-eq c (G x) (gpi (A0 x) (B0 x)) (der x) (rtW c A x.1) (rtP c A x.1)
      (G y) (gpi (A0 y) (B0 y)) (der y) (rtW c A y.1) (rtP c A y.1) (rel x y) ;
  module Ch = Choice[W, Ty c, isSetTy c, f, const] ;
  reps : Sq W = sq-pair (RepTy c A) (RepTy (ext c A) T) (rep-ty c A) (rep-ty (ext c A) T) ;
  value : Ty c = Ch.elim reps ;
  beta (x : W) : Id (Ty c) value (f x) = Ch.beta reps x ;
} ;

Pi (c : Ctx) (A : Ty c) (T : Ty (ext c A)) : Ty c = OpPi[c,A,T].value ;
Pi-der (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (r : RepTy c A) (r' : RepTy (ext c A) T) :
  Pf (gjty (rtG c A r) (gpi (rtA c A r) (rtA (ext c A) T r'))) = OpPi[c,A,T].der (r, r') ;
Pi-beta (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (r : RepTy c A) (r' : RepTy (ext c A) T)
  (G1 : GE) (h : Pf (gjty G1 (gpi (rtA c A r) (rtA (ext c A) T r')))) (w : Pf (gjwf G1)) (pc : Id Ctx (cls G1 w) c) :
  Id (Ty c) (Pi c A T) (clsTy c G1 (gpi (rtA c A r) (rtA (ext c A) T r')) h w pc) =
  trans (Ty c) (Pi c A T) (OpPi[c,A,T].f (r, r')) (clsTy c G1 (gpi (rtA c A r) (rtA (ext c A) T r')) h w pc)
    (OpPi[c,A,T].beta (r, r'))
    (clsTy-move c (rtG c A r) (gpi (rtA c A r) (rtA (ext c A) T r')) (OpPi[c,A,T].der (r, r')) (rtW c A r) (rtP c A r)
      G1 h w pc) ;
Pi-rep (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (r : RepTy c A) (r' : RepTy (ext c A) T) : RepTy c (Pi c A T) =
  mkRepTy c (Pi c A T) (rtG c A r) (gpi (rtA c A r) (rtA (ext c A) T r')) (Pi-der c A T r r') (rtW c A r) (rtP c A r)
    (sym (Ty c) (Pi c A T) (clsTy c (rtG c A r) (gpi (rtA c A r) (rtA (ext c A) T r')) (Pi-der c A T r r') (rtW c A r) (rtP c A r))
      (Pi-beta c A T r r' (rtG c A r) (Pi-der c A T r r') (rtW c A r) (rtP c A r))) ;

------------------------------------------------------------------------
-- abstraction  pi-inv c A B b : El c (Pi c A B)

module OpPiInv (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) {
  W : U l = RepTy c A * (RepTy (ext c A) T * RepEl (ext c A) T b) ;
  G (x : W) : GE = rtG c A x.1 ;
  A0 (x : W) : GE = rtA c A x.1 ;
  B0 (x : W) : GE = rtA (ext c A) T x.2.1 ;
  b0 (x : W) : GE = rea (ext c A) T b x.2.2 ;
  rB (x : W) : RepTy (ext c A) T = OpPi[c,A,T].rB (x.1, x.2.1) ;
  hb (x : W) : Pf (gjtm (gext (G x) (A0 x)) (b0 x) (B0 x)) = re-move (ext c A) T b x.2.2 (rB x) ;
  rP (x : W) : RepTy c (Pi c A T) = Pi-rep c A T x.1 x.2.1 ;
  der (x : W) : Pf (gjtm (G x) (glam (A0 x) (B0 x) (b0 x)) (gpi (A0 x) (B0 x))) =
    pf-map3 (gjty (G x) (A0 x)) (gjty (gext (G x) (A0 x)) (B0 x)) (gjtm (gext (G x) (A0 x)) (b0 x) (B0 x))
      (gjtm (G x) (glam (A0 x) (B0 x) (b0 x)) (gpi (A0 x) (B0 x)))
      (\ ha hB hb0 -> gm-lam (G x) (A0 x) (B0 x) (b0 x) ha hB hb0)
      (rtH c A x.1) (rtH (ext c A) T (rB x)) (hb x) ;
  f (x : W) : El c (Pi c A T) =
    clsEl c (Pi c A T) (G x) (gpi (A0 x) (B0 x)) (glam (A0 x) (B0 x) (b0 x)) (der x)
      (rtH c (Pi c A T) (rP x)) (rtW c A x.1) (rtP c A x.1) (rtE c (Pi c A T) (rP x)) ;
  rel (x y : W) : Pf (gjeqtm (G x) (glam (A0 x) (B0 x) (b0 x)) (glam (A0 y) (B0 y) (b0 y)) (gpi (A0 x) (B0 x))) =
    pf-map4 (gjty (G x) (A0 x)) (gjeqty (G x) (A0 x) (A0 y)) (gjeqty (gext (G x) (A0 x)) (B0 x) (B0 y))
      (gjeqtm (gext (G x) (A0 x)) (b0 x) (b0 y) (B0 x))
      (gjeqtm (G x) (glam (A0 x) (B0 x) (b0 x)) (glam (A0 y) (B0 y) (b0 y)) (gpi (A0 x) (B0 x)))
      (\ ha eA eB eb -> gm-elam (G x) (A0 x) (A0 y) (B0 x) (B0 y) (b0 x) (b0 y) ha eA eB eb)
      (rtH c A x.1) (same-rt c A x.1 y.1) (same-rt (ext c A) T (rB x) y.2.1)
      (re-eq (ext c A) T b x.2.2 y.2.2 (rB x)) ;
  const (x y : W) : Id (El c (Pi c A T)) (f x) (f y) =
    clsEl-eq c (Pi c A T) (G x) (gpi (A0 x) (B0 x)) (glam (A0 x) (B0 x) (b0 x)) (der x)
      (rtH c (Pi c A T) (rP x)) (rtW c A x.1) (rtP c A x.1) (rtE c (Pi c A T) (rP x))
      (G y) (gpi (A0 y) (B0 y)) (glam (A0 y) (B0 y) (b0 y)) (der y)
      (rtH c (Pi c A T) (rP y)) (rtW c A y.1) (rtP c A y.1) (rtE c (Pi c A T) (rP y))
      (rel x y) ;
  module Ch = Choice[W, El c (Pi c A T), isSetEl c (Pi c A T), f, const] ;
  reps : Sq W = sq-pair (RepTy c A) (RepTy (ext c A) T * RepEl (ext c A) T b) (rep-ty c A)
    (sq-pair (RepTy (ext c A) T) (RepEl (ext c A) T b) (rep-ty (ext c A) T) (rep-el (ext c A) T b)) ;
  value : El c (Pi c A T) = Ch.elim reps ;
  beta (x : W) : Id (El c (Pi c A T)) value (f x) = Ch.beta reps x ;
} ;

pi-inv (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) : El c (Pi c A T) = OpPiInv[c,A,T,b].value ;
pi-inv-beta (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T)
  (r : RepTy c A) (r' : RepTy (ext c A) T) (r'' : RepEl (ext c A) T b)
  (G1 A1 : GE) (h : Pf (gjtm G1 (glam (rtA c A r) (rtA (ext c A) T r') (rea (ext c A) T b r'')) A1))
  (hA : Pf (gjty G1 A1)) (w : Pf (gjwf G1)) (pc : Id Ctx (cls G1 w) c)
  (pT : Id (Ty c) (clsTy c G1 A1 hA w pc) (Pi c A T)) :
  Id (El c (Pi c A T)) (pi-inv c A T b)
    (clsEl c (Pi c A T) G1 A1 (glam (rtA c A r) (rtA (ext c A) T r') (rea (ext c A) T b r'')) h hA w pc pT) =
  trans (El c (Pi c A T)) (pi-inv c A T b) (OpPiInv[c,A,T,b].f (r, (r', r'')))
    (clsEl c (Pi c A T) G1 A1 (glam (rtA c A r) (rtA (ext c A) T r') (rea (ext c A) T b r'')) h hA w pc pT)
    (OpPiInv[c,A,T,b].beta (r, (r', r'')))
    (clsEl-irr c (Pi c A T) (rtG c A r) (gpi (rtA c A r) (rtA (ext c A) T r'))
      (glam (rtA c A r) (rtA (ext c A) T r') (rea (ext c A) T b r''))
      (OpPiInv[c,A,T,b].der (r, (r', r''))) (Pi-der c A T r r') (rtW c A r) (rtP c A r)
      (rtE c (Pi c A T) (Pi-rep c A T r r')) G1 A1 h hA w pc pT) ;

------------------------------------------------------------------------
-- application to the variable  pi-fun c A B f : El (ext c A) B

module OpPiFun (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (t : El c (Pi c A T)) {
  W : U l = RepTy c A * (RepTy (ext c A) T * RepEl c (Pi c A T) t) ;
  G (x : W) : GE = rtG c A x.1 ;
  A0 (x : W) : GE = rtA c A x.1 ;
  B0 (x : W) : GE = rtA (ext c A) T x.2.1 ;
  f0 (x : W) : GE = rea c (Pi c A T) t x.2.2 ;
  rB (x : W) : RepTy (ext c A) T = OpPi[c,A,T].rB (x.1, x.2.1) ;
  rP (x : W) : RepTy c (Pi c A T) = Pi-rep c A T x.1 x.2.1 ;
  hf (x : W) : Pf (gjtm (G x) (f0 x) (gpi (A0 x) (B0 x))) = re-move c (Pi c A T) t x.2.2 (rP x) ;
  der (x : W) : Pf (gjtm (gext (G x) (A0 x)) (app-q (A0 x) (B0 x) (f0 x)) (B0 x)) =
    pf-map3 (gjty (G x) (A0 x)) (gjty (gext (G x) (A0 x)) (B0 x)) (gjtm (G x) (f0 x) (gpi (A0 x) (B0 x)))
      (gjtm (gext (G x) (A0 x)) (app-q (A0 x) (B0 x) (f0 x)) (B0 x))
      (\ ha hB hf0 -> app-q-der (G x) (A0 x) (B0 x) (f0 x) ha hB hf0)
      (rtH c A x.1) (rtH (ext c A) T (rB x)) (hf x) ;
  f (x : W) : El (ext c A) T =
    clsEl (ext c A) T (gext (G x) (A0 x)) (B0 x) (app-q (A0 x) (B0 x) (f0 x)) (der x)
      (rtH (ext c A) T (rB x)) (rtW (ext c A) T (rB x)) (rtP (ext c A) T (rB x)) (rtE (ext c A) T (rB x)) ;
  rel (x y : W) : Pf (gjeqtm (gext (G x) (A0 x)) (app-q (A0 x) (B0 x) (f0 x)) (app-q (A0 y) (B0 y) (f0 y)) (B0 x)) =
    pf-map6 (gjty (G x) (A0 x)) (gjty (gext (G x) (A0 x)) (B0 x)) (gjtm (G x) (f0 x) (gpi (A0 x) (B0 x)))
      (gjeqty (G x) (A0 x) (A0 y)) (gjeqty (gext (G x) (A0 x)) (B0 x) (B0 y))
      (gjeqtm (G x) (f0 x) (f0 y) (gpi (A0 x) (B0 x)))
      (gjeqtm (gext (G x) (A0 x)) (app-q (A0 x) (B0 x) (f0 x)) (app-q (A0 y) (B0 y) (f0 y)) (B0 x))
      (\ ha hB hf0 eA eB ef -> app-q-eq (G x) (A0 x) (A0 y) (B0 x) (B0 y) (f0 x) (f0 y) ha hB hf0 eA eB ef)
      (rtH c A x.1) (rtH (ext c A) T (rB x)) (hf x)
      (same-rt c A x.1 y.1) (same-rt (ext c A) T (rB x) y.2.1)
      (re-eq c (Pi c A T) t x.2.2 y.2.2 (rP x)) ;
  const (x y : W) : Id (El (ext c A) T) (f x) (f y) =
    clsEl-eq (ext c A) T (gext (G x) (A0 x)) (B0 x) (app-q (A0 x) (B0 x) (f0 x)) (der x)
      (rtH (ext c A) T (rB x)) (rtW (ext c A) T (rB x)) (rtP (ext c A) T (rB x)) (rtE (ext c A) T (rB x))
      (gext (G y) (A0 y)) (B0 y) (app-q (A0 y) (B0 y) (f0 y)) (der y)
      (rtH (ext c A) T (rB y)) (rtW (ext c A) T (rB y)) (rtP (ext c A) T (rB y)) (rtE (ext c A) T (rB y))
      (rel x y) ;
  module Ch = Choice[W, El (ext c A) T, isSetEl (ext c A) T, f, const] ;
  reps : Sq W = sq-pair (RepTy c A) (RepTy (ext c A) T * RepEl c (Pi c A T) t) (rep-ty c A)
    (sq-pair (RepTy (ext c A) T) (RepEl c (Pi c A T) t) (rep-ty (ext c A) T) (rep-el c (Pi c A T) t)) ;
  value : El (ext c A) T = Ch.elim reps ;
  beta (x : W) : Id (El (ext c A) T) value (f x) = Ch.beta reps x ;
} ;

pi-fun (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (t : El c (Pi c A T)) : El (ext c A) T = OpPiFun[c,A,T,t].value ;
pi-fun-beta (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (t : El c (Pi c A T))
  (r : RepTy c A) (r' : RepTy (ext c A) T) (r'' : RepEl c (Pi c A T) t)
  (E1 B1 : GE) (h : Pf (gjtm E1 (app-q (rtA c A r) (rtA (ext c A) T r') (rea c (Pi c A T) t r'')) B1))
  (hB : Pf (gjty E1 B1)) (w : Pf (gjwf E1)) (pe : Id Ctx (cls E1 w) (ext c A))
  (pT : Id (Ty (ext c A)) (clsTy (ext c A) E1 B1 hB w pe) T) :
  Id (El (ext c A) T) (pi-fun c A T t)
    (clsEl (ext c A) T E1 B1 (app-q (rtA c A r) (rtA (ext c A) T r') (rea c (Pi c A T) t r'')) h hB w pe pT) =
  trans (El (ext c A) T) (pi-fun c A T t) (OpPiFun[c,A,T,t].f (r, (r', r'')))
    (clsEl (ext c A) T E1 B1 (app-q (rtA c A r) (rtA (ext c A) T r') (rea c (Pi c A T) t r'')) h hB w pe pT)
    (OpPiFun[c,A,T,t].beta (r, (r', r'')))
    (clsEl-irr (ext c A) T (gext (rtG c A r) (rtA c A r)) (rtA (ext c A) T r')
      (app-q (rtA c A r) (rtA (ext c A) T r') (rea c (Pi c A T) t r''))
      (OpPiFun[c,A,T,t].der (r, (r', r''))) (rtH (ext c A) T (OpPiFun[c,A,T,t].rB (r, (r', r''))))
      (rtW (ext c A) T (OpPiFun[c,A,T,t].rB (r, (r', r''))))
      (rtP (ext c A) T (OpPiFun[c,A,T,t].rB (r, (r', r''))))
      (rtE (ext c A) T (OpPiFun[c,A,T,t].rB (r, (r', r''))))
      E1 B1 h hB w pe pT) ;
