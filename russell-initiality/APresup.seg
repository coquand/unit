-- Presuppositions for AGAT, ported from GPresup.
-- Context equality also returns its reverse in the same induction.

level l ;
open Base ; open Lib[l] ; open AGAT[l] ; open TTyping[l] ;

W (G : GA) : U l = GADer (ajwf G) ;
Ty (G A : GA) : U l = GADer (ajty G A) ;
Tm' (G a A : GA) : U l = GADer (ajtm G a A) ;
Sb (D s G : GA) : U l = GADer (ajsub D s G) ;

APJ : GAJ -> U l = split {
  ajwf G -> Top ;
  ajty G A -> W G ;
  ajtm G a A -> W G * Ty G A ;
  ajsub D s G -> W D * W G ;
  ajeqcx G D -> W G * (W D * GADer (ajeqcx D G)) ;
  ajeqty G A B -> W G * (Ty G A * Ty G B) ;
  ajeqtm G a b A -> W G * (Ty G A * (Tm' G a A * Tm' G b A)) ;
  ajeqsub D s t G -> W D * (W G * (Sb D s G * Sb D t G)) } ;

------------------------------------------------------------------------
-- derived equations of the substitution calculus

-- context conversion along the last type
cxl (G A A' : GA) (wG : W G) (e : GADer (ajeqty G A A')) : GADer (ajeqcx (aext G A) (aext G A')) =
  ac-ext G G A A' (ac-refl G wG) e ;

-- (A p) sec(A, a) = A
sb-p-sec (G A a : GA) (wG : W G) (hA : Ty G A) (ha : Tm' G a A) : GADer (ajeqty G (asb (asb A (ap G A)) (asec A a)) A) =
  ae-trans G (asb (asb A (ap G A)) (asec A a)) (asb A (acomp (ap G A) (asec A a))) A
    (ae-sb-comp G (aext G A) G A (ap G A) (asec A a) hA (as-p G A hA) (as-sec G A a hA ha))
    (ae-trans G (asb A (acomp (ap G A) (asec A a))) (asb A (aid G)) A
       (ae-sb G G A A (acomp (ap G A) (asec A a)) (aid G) hA (ae-refl G A hA)
          (as-comp G (aext G A) G (ap G A) (asec A a) (as-p G A hA) (as-sec G A a hA ha)) (as-id G wG) (aq-p-sec G A a hA ha))
       (ae-sb-id G A hA)) ;

-- (A p) lift_A(s) = (A s) p   over D.(A s)
sb-p-lift (D G A s : GA) (hA : Ty G A) (hs : Sb D s G) :
    GADer (ajeqty (aext D (asb A s)) (asb (asb A (ap G A)) (alift A s)) (asb (asb A s) (ap D (asb A s)))) =
  ae-trans (aext D (asb A s)) (asb (asb A (ap G A)) (alift A s)) (asb A (acomp (ap G A) (alift A s))) (asb (asb A s) (ap D (asb A s)))
    (ae-sb-comp (aext D (asb A s)) (aext G A) G A (ap G A) (alift A s) hA (as-p G A hA) (as-lift D G A s hs hA))
    (ae-trans (aext D (asb A s)) (asb A (acomp (ap G A) (alift A s))) (asb A (acomp s (ap D (asb A s)))) (asb (asb A s) (ap D (asb A s)))
       (ae-sb (aext D (asb A s)) G A A (acomp (ap G A) (alift A s)) (acomp s (ap D (asb A s))) hA (ae-refl G A hA)
          (as-comp (aext D (asb A s)) (aext G A) G (ap G A) (alift A s) (as-p G A hA) (as-lift D G A s hs hA))
          (as-comp (aext D (asb A s)) D G s (ap D (asb A s)) hs (as-p D (asb A s) (at-sb D G A s hA hs)))
          (aq-p-lift D G A s hA hs))
       (ae-sym (aext D (asb A s)) (asb (asb A s) (ap D (asb A s))) (asb A (acomp s (ap D (asb A s))))
          (ae-sb-comp (aext D (asb A s)) D G A s (ap D (asb A s)) hA hs (as-p D (asb A s) (at-sb D G A s hA hs))))) ;

-- (B lift_A(p)) sec(A p, q) = B   over G.A
sb-eta (G A B : GA) (hA : Ty G A) (hB : Ty (aext G A) B) :
    GADer (ajeqty (aext G A) (asb (asb B (alift A (ap G A))) (asec (asb A (ap G A)) (aq G A))) B) =
  ae-trans (aext G A) (asb (asb B (alift A (ap G A))) (asec (asb A (ap G A)) (aq G A))) (asb B (acomp (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A)))) B
    (ae-sb-comp (aext G A) (aext (aext G A) (asb A (ap G A))) (aext G A) B (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A)) hB
       (as-lift (aext G A) G A (ap G A) (as-p G A hA) hA)
       (as-sec (aext G A) (asb A (ap G A)) (aq G A) (at-sb (aext G A) G A (ap G A) hA (as-p G A hA)) (am-q G A hA)))
    (ae-trans (aext G A) (asb B (acomp (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A)))) (asb B (aid (aext G A))) B
       (ae-sb (aext G A) (aext G A) B B (acomp (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A))) (aid (aext G A)) hB (ae-refl (aext G A) B hB)
          (as-comp (aext G A) (aext (aext G A) (asb A (ap G A))) (aext G A) (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A))
             (as-lift (aext G A) G A (ap G A) (as-p G A hA) hA)
             (as-sec (aext G A) (asb A (ap G A)) (aq G A) (at-sb (aext G A) G A (ap G A) hA (as-p G A hA)) (am-q G A hA)))
          (as-id (aext G A) (a-ext G A hA)) (aq-lift-p-sec-q G A hA))
       (ae-sb-id (aext G A) B hB)) ;

-- (B sec(A,a)) s = (B lift_A(s)) sec(A s, a s)
sb-sec-comp (D G A B a s : GA) (hA : Ty G A) (hB : Ty (aext G A) B) (ha : Tm' G a A) (hs : Sb D s G) :
    GADer (ajeqty D (asb (asb B (asec A a)) s) (asb (asb B (alift A s)) (asec (asb A s) (asb a s)))) =
  ae-trans D (asb (asb B (asec A a)) s) (asb B (acomp (asec A a) s)) (asb (asb B (alift A s)) (asec (asb A s) (asb a s)))
    (ae-sb-comp D G (aext G A) B (asec A a) s hB (as-sec G A a hA ha) hs)
    (ae-trans D (asb B (acomp (asec A a) s)) (asb B (acomp (alift A s) (asec (asb A s) (asb a s))))
       (asb (asb B (alift A s)) (asec (asb A s) (asb a s)))
       (ae-sb D (aext G A) B B (acomp (asec A a) s) (acomp (alift A s) (asec (asb A s) (asb a s))) hB (ae-refl (aext G A) B hB)
          (as-comp D G (aext G A) (asec A a) s (as-sec G A a hA ha) hs)
          (as-comp D (aext D (asb A s)) (aext G A) (alift A s) (asec (asb A s) (asb a s)) (as-lift D G A s hs hA)
             (as-sec D (asb A s) (asb a s) (at-sb D G A s hA hs) (am-sb D G a A s hA ha hs)))
          (aq-sec-comp D G A a s hA ha hs))
       (ae-sym D (asb (asb B (alift A s)) (asec (asb A s) (asb a s))) (asb B (acomp (alift A s) (asec (asb A s) (asb a s))))
          (ae-sb-comp D (aext D (asb A s)) (aext G A) B (alift A s) (asec (asb A s) (asb a s)) hB (as-lift D G A s hs hA)
             (as-sec D (asb A s) (asb a s) (at-sb D G A s hA hs) (am-sb D G a A s hA ha hs))))) ;

-- a : U_n gives a s : U_n
sb-uu (D G a s : GA) (n : Nat) (hU : Ty G (auu n G)) (ha : Tm' G a (auu n G)) (hs : Sb D s G) : Tm' D (asb a s) (auu n D) =
  am-conv D (asb a s) (asb (auu n G) s) (auu n D) (am-sb D G a (auu n G) s hU ha hs) (ae-uu-sb D G n s hs (a-universe-bound G G n hU)) ;

------------------------------------------------------------------------
-- the binder cases

c-ae-pi (G A A' B B' : GA) (h0 : Ty G A) (h1 : GADer (ajeqty G A A')) (h2 : GADer (ajeqty (aext G A) B B'))
    (r0 : APJ (ajty G A)) (r1 : APJ (ajeqty G A A')) (r2 : APJ (ajeqty (aext G A) B B')) :
    APJ (ajeqty G (api A B) (api A' B')) =
  (r0, (at-pi G A B h0 r2.2.1,
        at-pi G A' B' r1.2.2 (at-cx (aext G A) (aext G A') B' (a-ext G A' r1.2.2) (cxl G A A' r0 h1) r2.2.2))) ;

c-am-elam (G A A' B B' b b' : GA) (h0 : Ty G A) (h1 : GADer (ajeqty G A A')) (h2 : GADer (ajeqty (aext G A) B B'))
    (r0 : APJ (ajty G A)) (r1 : APJ (ajeqty G A A')) (r2 : APJ (ajeqty (aext G A) B B'))
    (r3 : APJ (ajeqtm (aext G A) b b' B)) : APJ (ajeqtm G (alam A B b) (alam A' B' b') (api A B)) =
  (r0, (at-pi G A B h0 r3.2.1, (am-lam G A B b h0 r3.2.1 r3.2.2.1,
   am-conv G (alam A' B' b') (api A' B') (api A B)
     (am-lam G A' B' b' r1.2.2 (at-cx (aext G A) (aext G A') B' (a-ext G A' r1.2.2) (cxl G A A' r0 h1) r2.2.2)
        (am-cx (aext G A) (aext G A') b' B' (a-ext G A' r1.2.2) (cxl G A A' r0 h1)
           (am-conv (aext G A) b' B B' r3.2.2.2 h2)))
     (ae-sym G (api A B) (api A' B') (ae-pi G A A' B B' h0 h1 h2))))) ;

-- sec(A', a') : G -> G.A
sec-cx (G A A' a' : GA) (wG : W G) (hA : Ty G A) (hA' : Ty G A') (h1 : GADer (ajeqty G A A')) (ha' : Tm' G a' A) :
    Sb G (asec A' a') (aext G A) =
  as-cx G G (aext G A') (aext G A) (asec A' a') wG (a-ext G A hA) (ac-refl G wG) (cxl G A' A wG (ae-sym G A A' h1))
    (as-sec G A' a' hA' (am-conv G a' A A' ha' h1)) ;

c-am-eapp (G A A' B B' c c' a a' : GA) (h0 : Ty G A) (hB : Ty (aext G A) B) (ha : Tm' G a A)
    (h1 : GADer (ajeqty G A A')) (h2 : GADer (ajeqty (aext G A) B B')) (h4 : GADer (ajeqtm G a a' A))
    (r0 : APJ (ajty G A)) (r1 : APJ (ajeqty G A A')) (r2 : APJ (ajeqty (aext G A) B B'))
    (r3 : APJ (ajeqtm G c c' (api A B))) (r4 : APJ (ajeqtm G a a' A)) :
    APJ (ajeqtm G (aapp A B c a) (aapp A' B' c' a') (asb B (asec A a))) =
  (r0, (at-sb G (aext G A) B (asec A a) hB (as-sec G A a h0 ha), (am-app G A B c a h0 hB r3.2.2.1 ha,
   am-conv G (aapp A' B' c' a') (asb B' (asec A' a')) (asb B (asec A a))
     (am-app G A' B' c' a' r1.2.2 (at-cx (aext G A) (aext G A') B' (a-ext G A' r1.2.2) (cxl G A A' r0 h1) r2.2.2)
        (am-conv G c' (api A B) (api A' B') r3.2.2.2 (ae-pi G A A' B B' h0 h1 h2))
        (am-conv G a' A A' r4.2.2.2 h1))
     (ae-sym G (asb B (asec A a)) (asb B' (asec A' a'))
        (ae-sb G (aext G A) B B' (asec A a) (asec A' a') hB h2 (as-sec G A a h0 ha)
           (sec-cx G A A' a' r0 h0 r1.2.2 h1 r4.2.2.2) (aq-sec G A A' a a' h0 ha r4.2.2.2 h1 h4)))))) ;

-- Moving a code across context equality also changes its universe annotation.
move-uu-tm (G D a : GA) (n : Nat) (wD : W D) (e : GADer (ajeqcx G D))
    (nb : LeN n N) (h : Tm' G a (auu n G)) : Tm' D a (auu n D) =
  am-conv D a (auu n G) (auu n D) (am-cx G D a (auu n G) wD e h)
    (ae-cx G D (auu n G) (auu n D) wD e (ae-uu-cx G D n e nb)) ;

c-am-epic (G : GA) (n : Nat) (a a' b b' : GA) (h0 : Tm' G a (auu n G))
    (h1 : GADer (ajeqtm G a a' (auu n G)))
    (r0 : APJ (ajtm G a (auu n G))) (r1 : APJ (ajeqtm G a a' (auu n G)))
    (r2 : APJ (ajeqtm (aext G (ael n a)) b b' (auu n (aext G (ael n a))))) :
    APJ (ajeqtm G (apic n a b) (apic n a' b') (auu n G)) =
  (r0.1, (r0.2, (am-pic G n a b h0 r2.2.2.1,
    am-pic G n a' b' r1.2.2.2
      (move-uu-tm (aext G (ael n a)) (aext G (ael n a')) b' n
        (a-ext G (ael n a') (at-el G n a' r1.2.2.2))
        (cxl G (ael n a) (ael n a') r0.1 (ae-el G n a a' h1))
        (a-universe-bound G G n r0.2) r2.2.2.2)))) ;

c-am-eta (G A B f : GA) (hA : Ty G A) (hB : Ty (aext G A) B) (h : Tm' G f (api A B)) (wG : W G) :
    APJ (ajeqtm G f (alam A B (aapp (asb A (ap G A)) (asb B (alift A (ap G A))) (asb f (ap G A)) (aq G A))) (api A B)) =
  (wG, (at-pi G A B hA hB, (h,
   am-lam G A B (aapp (asb A (ap G A)) (asb B (alift A (ap G A))) (asb f (ap G A)) (aq G A)) hA hB
     (am-conv (aext G A) (aapp (asb A (ap G A)) (asb B (alift A (ap G A))) (asb f (ap G A)) (aq G A))
        (asb (asb B (alift A (ap G A))) (asec (asb A (ap G A)) (aq G A))) B
        (am-app (aext G A) (asb A (ap G A)) (asb B (alift A (ap G A))) (asb f (ap G A)) (aq G A)
           (at-sb (aext G A) G A (ap G A) hA (as-p G A hA))
           (at-sb (aext (aext G A) (asb A (ap G A))) (aext G A) B (alift A (ap G A)) hB (as-lift (aext G A) G A (ap G A) (as-p G A hA) hA))
           (am-conv (aext G A) (asb f (ap G A)) (asb (api A B) (ap G A)) (api (asb A (ap G A)) (asb B (alift A (ap G A))))
              (am-sb (aext G A) G f (api A B) (ap G A) (at-pi G A B hA hB) h (as-p G A hA))
              (ae-pi-sb (aext G A) G A B (ap G A) hA hB (as-p G A hA)))
           (am-q G A hA))
        (sb-eta G A B hA hB))))) ;

c-am-lf-pic (G : GA) (n p : Nat) (a b : GA) (h1 : Tm' G a (auu n G))
    (h2 : Tm' (aext G (ael n a)) b (auu n (aext G (ael n a))))
    (le : LeN (suc n) p) (nb : LeN p N) (wG : W G) :
    APJ (ajeqtm G (alf n p (apic n a b)) (apic p (alf n p a) (alf n p b)) (auu p G)) =
  (wG, (at-uu G p wG nb, (am-lf G n p (apic n a b) (am-pic G n a b h1 h2) le nb,
    am-pic G p (alf n p a) (alf n p b) ha
      (move-uu-tm (aext G (ael n a)) (aext G (ael p (alf n p a))) (alf n p b) p
        (a-ext G (ael p (alf n p a)) (at-el G p (alf n p a) ha))
        (cxl G (ael n a) (ael p (alf n p a)) wG
          (ae-sym G (ael p (alf n p a)) (ael n a) (ae-el-lf G n p a h1 le nb)))
        nb (am-lf (aext G (ael n a)) n p b h2 le nb)))))
  where { ha : Tm' G (alf n p a) (auu p G) = am-lf G n p a h1 le nb ; } ;

------------------------------------------------------------------------
-- substitution cases

c-am-sb-comp (T D G a A s d : GA) (h0 : Tm' G a A) (h1 : Sb D s G) (h2 : Sb T d D) (hA : Ty G A) (wT : W T) :
    APJ (ajeqtm T (asb (asb a s) d) (asb a (acomp s d)) (asb A (acomp s d))) =
  (wT, (at-sb T G A (acomp s d) hA (as-comp T D G s d h1 h2),
   (am-conv T (asb (asb a s) d) (asb (asb A s) d) (asb A (acomp s d))
      (am-sb T D (asb a s) (asb A s) d (at-sb D G A s hA h1) (am-sb D G a A s hA h0 h1) h2)
      (ae-sb-comp T D G A s d hA h1 h2),
    am-sb T G a A (acomp s d) hA h0 (as-comp T D G s d h1 h2)))) ;

c-am-lam-sb (D G A B b s : GA) (h1 : Ty G A) (h2 : Ty (aext G A) B) (h3 : Tm' (aext G A) b B) (h4 : Sb D s G) (wD : W D) :
    APJ (ajeqtm D (asb (alam A B b) s) (alam (asb A s) (asb B (alift A s)) (asb b (alift A s)))
                 (api (asb A s) (asb B (alift A s)))) =
  (wD, (at-pi D (asb A s) (asb B (alift A s)) (at-sb D G A s h1 h4)
          (at-sb (aext D (asb A s)) (aext G A) B (alift A s) h2 (as-lift D G A s h4 h1)),
   (am-conv D (asb (alam A B b) s) (asb (api A B) s) (api (asb A s) (asb B (alift A s)))
      (am-sb D G (alam A B b) (api A B) s (at-pi G A B h1 h2) (am-lam G A B b h1 h2 h3) h4)
      (ae-pi-sb D G A B s h1 h2 h4),
    am-lam D (asb A s) (asb B (alift A s)) (asb b (alift A s)) (at-sb D G A s h1 h4)
      (at-sb (aext D (asb A s)) (aext G A) B (alift A s) h2 (as-lift D G A s h4 h1))
      (am-sb (aext D (asb A s)) (aext G A) b B (alift A s) h2 h3 (as-lift D G A s h4 h1))))) ;

c-am-app-sb (D G A B c a s : GA) (h1 : Ty G A) (h2 : Ty (aext G A) B) (h3 : Tm' G c (api A B)) (h4 : Tm' G a A)
    (h5 : Sb D s G) (wD : W D) :
    APJ (ajeqtm D (asb (aapp A B c a) s) (aapp (asb A s) (asb B (alift A s)) (asb c s) (asb a s))
                 (asb (asb B (alift A s)) (asec (asb A s) (asb a s)))) =
  (wD, (at-sb D (aext D (asb A s)) (asb B (alift A s)) (asec (asb A s) (asb a s))
          (at-sb (aext D (asb A s)) (aext G A) B (alift A s) h2 (as-lift D G A s h5 h1))
          (as-sec D (asb A s) (asb a s) (at-sb D G A s h1 h5) (am-sb D G a A s h1 h4 h5)),
   (am-conv D (asb (aapp A B c a) s) (asb (asb B (asec A a)) s) (asb (asb B (alift A s)) (asec (asb A s) (asb a s)))
      (am-sb D G (aapp A B c a) (asb B (asec A a)) s (at-sb G (aext G A) B (asec A a) h2 (as-sec G A a h1 h4))
         (am-app G A B c a h1 h2 h3 h4) h5)
      (sb-sec-comp D G A B a s h1 h2 h4 h5),
    am-app D (asb A s) (asb B (alift A s)) (asb c s) (asb a s) (at-sb D G A s h1 h5)
      (at-sb (aext D (asb A s)) (aext G A) B (alift A s) h2 (as-lift D G A s h5 h1))
      (am-conv D (asb c s) (asb (api A B) s) (api (asb A s) (asb B (alift A s)))
         (am-sb D G c (api A B) s (at-pi G A B h1 h2) h3 h5) (ae-pi-sb D G A B s h1 h2 h5))
      (am-sb D G a A s h1 h4 h5)))) ;

c-am-pic-sb (D G : GA) (n : Nat) (a b s : GA) (h1 : Tm' G a (auu n G))
    (h2 : Tm' (aext G (ael n a)) b (auu n (aext G (ael n a))))
    (h3 : Sb D s G) (wD : W D) (hU : Ty G (auu n G))
    (hUext : Ty (aext G (ael n a)) (auu n (aext G (ael n a)))) :
    APJ (ajeqtm D (asb (apic n a b) s) (apic n (asb a s) (asb b (alift (ael n a) s))) (auu n D)) =
  (wD, (at-uu D n wD nb, (sb-uu D G (apic n a b) s n hU (am-pic G n a b h1 h2) h3,
    am-pic D n (asb a s) (asb b (alift (ael n a) s)) ha
      (move-uu-tm (aext D (asb (ael n a) s)) (aext D (ael n (asb a s)))
        (asb b (alift (ael n a) s)) n (a-ext D (ael n (asb a s)) (at-el D n (asb a s) ha))
        (cxl D (asb (ael n a) s) (ael n (asb a s)) wD (ae-el-sb D G n a s h1 h3)) nb
        (sb-uu (aext D (asb (ael n a) s)) (aext G (ael n a)) b (alift (ael n a) s) n
          hUext h2 (as-lift D G (ael n a) s h3 (at-el G n a h1)))))))
  where {
    nb : LeN n N = a-universe-bound G G n hU ;
    ha : Tm' D (asb a s) (auu n D) = sb-uu D G a s n hU h1 h3 ;
  } ;

c-am-q-lift (D G A s : GA) (h1 : Ty G A) (h2 : Sb D s G) :
    APJ (ajeqtm (aext D (asb A s)) (asb (aq G A) (alift A s)) (aq D (asb A s)) (asb (asb A s) (ap D (asb A s)))) =
  (a-ext D (asb A s) (at-sb D G A s h1 h2),
   (at-sb (aext D (asb A s)) D (asb A s) (ap D (asb A s)) (at-sb D G A s h1 h2) (as-p D (asb A s) (at-sb D G A s h1 h2)),
    (am-conv (aext D (asb A s)) (asb (aq G A) (alift A s)) (asb (asb A (ap G A)) (alift A s)) (asb (asb A s) (ap D (asb A s)))
       (am-sb (aext D (asb A s)) (aext G A) (aq G A) (asb A (ap G A)) (alift A s) (at-sb (aext G A) G A (ap G A) h1 (as-p G A h1))
          (am-q G A h1) (as-lift D G A s h2 h1))
       (sb-p-lift D G A s h1 h2),
     am-q D (asb A s) (at-sb D G A s h1 h2)))) ;

c-am-q-sec (G A a : GA) (h1 : Ty G A) (h2 : Tm' G a A) (wG : W G) : APJ (ajeqtm G (asb (aq G A) (asec A a)) a A) =
  (wG, (h1,
   (am-conv G (asb (aq G A) (asec A a)) (asb (asb A (ap G A)) (asec A a)) A
      (am-sb G (aext G A) (aq G A) (asb A (ap G A)) (asec A a) (at-sb (aext G A) G A (ap G A) h1 (as-p G A h1)) (am-q G A h1)
         (as-sec G A a h1 h2))
      (sb-p-sec G A a wG h1 h2),
    h2))) ;

------------------------------------------------------------------------
-- substitution equality cases

c-aq-lift (D G A A' s s' : GA) (h0 : Ty G A) (h1 : GADer (ajeqty G A A')) (h2 : Sb D s G)
    (h3 : GADer (ajeqsub D s s' G)) (r1 : APJ (ajeqty G A A')) (r2 : APJ (ajsub D s G)) (r3 : APJ (ajeqsub D s s' G)) :
    APJ (ajeqsub (aext D (asb A s)) (alift A s) (alift A' s') (aext G A)) =
  (a-ext D (asb A s) (at-sb D G A s h0 h2), (a-ext G A h0, (as-lift D G A s h2 h0,
   as-cx (aext D (asb A' s')) (aext D (asb A s)) (aext G A') (aext G A) (alift A' s')
     (a-ext D (asb A s) (at-sb D G A s h0 h2)) (a-ext G A h0)
     (cxl D (asb A' s') (asb A s) r2.1 (ae-sym D (asb A s) (asb A' s') (ae-sb D G A A' s s' h0 h1 h2 r3.2.2.2 h3)))
     (cxl G A' A r2.2 (ae-sym G A A' h1))
     (as-lift D G A' s' r3.2.2.2 r1.2.2)))) ;

c-aq-lift-id (G A : GA) (h : Ty G A) (wG : W G) :
    APJ (ajeqsub (aext G (asb A (aid G))) (alift A (aid G)) (aid (aext G A)) (aext G A)) =
  (a-ext G (asb A (aid G)) (at-sb G G A (aid G) h (as-id G wG)), (a-ext G A h, (as-lift G G A (aid G) (as-id G wG) h,
   as-cx (aext G A) (aext G (asb A (aid G))) (aext G A) (aext G A) (aid (aext G A))
     (a-ext G (asb A (aid G)) (at-sb G G A (aid G) h (as-id G wG))) (a-ext G A h)
     (cxl G A (asb A (aid G)) wG (ae-sym G (asb A (aid G)) A (ae-sb-id G A h)))
     (ac-refl (aext G A) (a-ext G A h)) (as-id (aext G A) (a-ext G A h))))) ;

c-aq-lift-comp (T D G A s d : GA) (h0 : Ty G A) (h1 : Sb D s G) (h2 : Sb T d D) (wT : W T) :
    APJ (ajeqsub (aext T (asb A (acomp s d))) (alift A (acomp s d)) (acomp (alift A s) (alift (asb A s) d)) (aext G A)) =
  (a-ext T (asb A (acomp s d)) (at-sb T G A (acomp s d) h0 (as-comp T D G s d h1 h2)), (a-ext G A h0,
   (as-lift T G A (acomp s d) (as-comp T D G s d h1 h2) h0,
    as-cx (aext T (asb (asb A s) d)) (aext T (asb A (acomp s d))) (aext G A) (aext G A) (acomp (alift A s) (alift (asb A s) d))
      (a-ext T (asb A (acomp s d)) (at-sb T G A (acomp s d) h0 (as-comp T D G s d h1 h2))) (a-ext G A h0)
      (cxl T (asb (asb A s) d) (asb A (acomp s d)) wT (ae-sb-comp T D G A s d h0 h1 h2))
      (ac-refl (aext G A) (a-ext G A h0))
      (as-comp (aext T (asb (asb A s) d)) (aext D (asb A s)) (aext G A) (alift A s) (alift (asb A s) d)
         (as-lift D G A s h1 h0) (as-lift T D (asb A s) d h2 (at-sb D G A s h0 h1)))))) ;

c-aq-sec-comp (D G A a s : GA) (h1 : Ty G A) (h2 : Tm' G a A) (h3 : Sb D s G) (wD : W D) :
    APJ (ajeqsub D (acomp (asec A a) s) (acomp (alift A s) (asec (asb A s) (asb a s))) (aext G A)) =
  (wD, (a-ext G A h1, (as-comp D G (aext G A) (asec A a) s (as-sec G A a h1 h2) h3,
   as-comp D (aext D (asb A s)) (aext G A) (alift A s) (asec (asb A s) (asb a s)) (as-lift D G A s h3 h1)
     (as-sec D (asb A s) (asb a s) (at-sb D G A s h1 h3) (am-sb D G a A s h1 h2 h3))))) ;

c-aq-lift-p-sec-q (G A : GA) (h : Ty G A) :
    APJ (ajeqsub (aext G A) (acomp (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A))) (aid (aext G A)) (aext G A)) =
  (a-ext G A h, (a-ext G A h,
   (as-comp (aext G A) (aext (aext G A) (asb A (ap G A))) (aext G A) (alift A (ap G A)) (asec (asb A (ap G A)) (aq G A))
      (as-lift (aext G A) G A (ap G A) (as-p G A h) h)
      (as-sec (aext G A) (asb A (ap G A)) (aq G A) (at-sb (aext G A) G A (ap G A) h (as-p G A h)) (am-q G A h)),
    as-id (aext G A) (a-ext G A h)))) ;

------------------------------------------------------------------------
-- Annotation congruences

p-annotation-presup (G H A B : GA) (e : GADer (ajeqcx G H)) (p : GADer (ajeqty G A B))
    (r : APJ (ajeqcx G H)) (t : APJ (ajeqty G A B)) :
    APJ (ajeqsub (aext G A) (ap G A) (ap H B) G) =
  (a-ext G A t.2.1, (r.1, (as-p G A t.2.1,
    as-cx (aext H B) (aext G A) H G (ap H B)
      (a-ext G A t.2.1) r.1 (ac-ext H G B A r.2.2
        (ae-cx G H B A r.2.1 e (ae-sym G A B p))) r.2.2
      (as-p H B (at-cx G H B r.2.1 e t.2.2))))) ;

q-annotation-presup (G H A B : GA) (e : GADer (ajeqcx G H)) (p : GADer (ajeqty G A B))
    (r : APJ (ajeqcx G H)) (t : APJ (ajeqty G A B)) :
    APJ (ajeqtm (aext G A) (aq G A) (aq H B) (asb A (ap G A))) =
  (pp.1, (at-sb (aext G A) G A (ap G A) t.2.1 pp.2.2.1, (am-q G A t.2.1,
    am-conv (aext G A) (aq H B) (asb B (ap H B)) (asb A (ap G A))
      (am-cx (aext H B) (aext G A) (aq H B) (asb B (ap H B)) pp.1
        (ac-ext H G B A r.2.2 (ae-cx G H B A r.2.1 e (ae-sym G A B p)))
        (am-q H B (at-cx G H B r.2.1 e t.2.2)))
      (ae-sym (aext G A) (asb A (ap G A)) (asb B (ap H B))
        (ae-sb (aext G A) G A B (ap G A) (ap H B) t.2.1 p pp.2.2.1 pp.2.2.2
          (aq-p-cx G H A B e p))))))
  where { pp : APJ (ajeqsub (aext G A) (ap G A) (ap H B) G) = p-annotation-presup G H A B e p r t ; } ;

------------------------------------------------------------------------
-- the presupposition lemma

apresup : (J : GAJ) -> GADer J -> APJ J = split {
  a-nil -> tt ;
  a-ext G A h -> tt ;
  ac-nil -> (a-nil, (a-nil, ac-nil)) ;
  ac-refl G h -> (h, (h, ac-refl G h)) ;
  ac-ext G D A B h1 h2 | r1 r2 ->
    (a-ext G A r2.2.1, (a-ext D B (at-cx G D B r1.2.1 h1 r2.2.2),
     ac-ext D G B A r1.2.2 (ae-cx G D B A r1.2.1 h1 (ae-sym G A B h2)))) ;
  as-id G h -> (h, h) ;
  as-comp T D G s d h1 h2 | r1 r2 -> (r2.1, r1.2) ;
  as-eps G h -> (h, a-nil) ;
  as-p G A h | r -> (a-ext G A h, r) ;
  as-lift D G A s h1 h2 | r1 r2 -> (a-ext D (asb A s) (at-sb D G A s h2 h1), a-ext G A h2) ;
  as-sec G A a h1 h2 | r1 r2 -> (r1, a-ext G A h1) ;
  as-cx D D' G G' s h0 h0' h1 h2 h -> (h0, h0') ;
  at-pi G A B h1 h2 | r1 r2 -> r1 ;
  at-uu G n h nb -> h ;
  at-el G n a h | r -> r.1 ;
  at-sb D G A s h1 h2 | r1 r2 -> r2.1 ;
  at-cx G D A h0 h1 h2 -> h0 ;
  am-lam G A B b h1 h2 h3 | r1 r2 r3 -> (r1, at-pi G A B h1 h2) ;
  am-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> (r1, at-sb G (aext G A) B (asec A a) h2 (as-sec G A a h1 h4)) ;
  am-pic G n a b h1 h2 | r1 r2 -> r1 ;
  am-uc G m n h lt nb -> (h, at-uu G n h nb) ;
  am-lf G m n a h le nb | r -> (r.1, at-uu G n r.1 nb) ;
  am-q G A h | r -> (a-ext G A h, at-sb (aext G A) G A (ap G A) h (as-p G A h)) ;
  am-sb D G a A s hA h1 h2 | rA r1 r2 -> (r2.1, at-sb D G A s hA h2) ;
  am-conv G a A B h1 h2 | r1 r2 -> (r1.1, r2.2.2) ;
  am-cx G D a A h0 h1 h2 | r0 r1 r2 -> (h0, at-cx G D A h0 h1 r2.2) ;
  ae-refl G A h | r -> (r, (h, h)) ;
  ae-sym G A B h | r -> (r.1, (r.2.2, r.2.1)) ;
  ae-trans G A B C h1 h2 | r1 r2 -> (r1.1, (r1.2.1, r2.2.2)) ;
  ae-pi G A A' B B' h0 h1 h2 | r0 r1 r2 -> c-ae-pi G A A' B B' h0 h1 h2 r0 r1 r2 ;
  ae-el G n a a' h | r -> (r.1, (at-el G n a r.2.2.1, at-el G n a' r.2.2.2)) ;
  ae-sb D G A A' s s' h0 h1 h2 h3 h4 | r0 r1 r2 r3 r4 -> (r2.1, (at-sb D G A s h0 h2, at-sb D G A' s' r1.2.2 h3)) ;
  ae-el-lf G m n a h le nb | r -> (r.1, (at-el G n (alf m n a) (am-lf G m n a h le nb), at-el G m a h)) ;
  ae-el-pic G n a b h1 h2 | r1 r2 ->
    (r1.1, (at-el G n (apic n a b) (am-pic G n a b h1 h2),
            at-pi G (ael n a) (ael n b) (at-el G n a h1) (at-el (aext G (ael n a)) n b h2))) ;
  ae-el-uc G m n h lt nb -> (h, (at-el G n (auc m n G) (am-uc G m n h lt nb), at-uu G m h (leN-trans m n N (lt-le m n lt) nb))) ;
  ae-sb-id G A h | r -> (r, (at-sb G G A (aid G) h (as-id G r), h)) ;
  ae-sb-comp T D G A s d h0 h1 h2 | r0 r1 r2 ->
    (r2.1, (at-sb T D (asb A s) d (at-sb D G A s h0 h1) h2, at-sb T G A (acomp s d) h0 (as-comp T D G s d h1 h2))) ;
  ae-pi-sb D G A B s h1 h2 h3 | r1 r2 r3 ->
    (r3.1, (at-sb D G (api A B) s (at-pi G A B h1 h2) h3,
            at-pi D (asb A s) (asb B (alift A s)) (at-sb D G A s h1 h3)
              (at-sb (aext D (asb A s)) (aext G A) B (alift A s) h2 (as-lift D G A s h3 h1)))) ;
  ae-uu-sb D G n s h nb | r -> (r.1, (at-sb D G (auu n G) s (at-uu G n r.2 nb) h, at-uu D n r.1 nb)) ;
  ae-el-sb D G n a s h1 h2 | r1 r2 ->
    (r2.1, (at-sb D G (ael n a) s (at-el G n a h1) h2, at-el D n (asb a s) (sb-uu D G a s n r1.2 h1 h2))) ;
  ae-cx G D A B h0 h1 h2 | r0 r1 r2 -> (h0, (at-cx G D A h0 h1 r2.2.1, at-cx G D B h0 h1 r2.2.2)) ;
  am-refl G a A h | r -> (r.1, (r.2, (h, h))) ;
  am-sym G a b A hA h | rA r -> (r.1, (r.2.1, (r.2.2.2, r.2.2.1))) ;
  am-trans G a b c A h1 h2 | r1 r2 -> (r1.1, (r1.2.1, (r1.2.2.1, r2.2.2.2))) ;
  am-eqconv G a b A B h1 h2 | r1 r2 ->
    (r1.1, (r2.2.2, (am-conv G a A B r1.2.2.1 h2, am-conv G b A B r1.2.2.2 h2))) ;
  am-elam G A A' B B' b b' h0 h1 h2 h3 | r0 r1 r2 r3 -> c-am-elam G A A' B B' b b' h0 h1 h2 r0 r1 r2 r3 ;
  am-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | r0 rB ra r1 r2 r3 r4 ->
    c-am-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h4 r0 r1 r2 r3 r4 ;
  am-epic G n a a' b b' h0 h1 h2 | r0 r1 r2 -> c-am-epic G n a a' b b' h0 h1 r0 r1 r2 ;
  am-elf G m n a a' h le nb | r -> (r.1, (at-uu G n r.1 nb, (am-lf G m n a r.2.2.1 le nb, am-lf G m n a' r.2.2.2 le nb))) ;
  am-esb D G a a' A s s' hA h0 h1 h2 h3 h4 | rA r0 r1 r2 r3 r4 ->
    (r2.1, (at-sb D G A s hA h2, (am-sb D G a A s hA h0 h2,
     am-conv D (asb a' s') (asb A s') (asb A s) (am-sb D G a' A s' hA r1.2.2.2 h3)
       (ae-sym D (asb A s) (asb A s') (ae-sb D G A A s s' hA (ae-refl G A hA) h2 h3 h4))))) ;
  am-beta G A B b a hA hB h1 h2 | rA rB r1 r2 ->
    (rA, (at-sb G (aext G A) B (asec A a) hB (as-sec G A a hA h2),
     (am-app G A B (alam A B b) a hA hB (am-lam G A B b hA hB h1) h2,
      am-sb G (aext G A) b B (asec A a) hB h1 (as-sec G A a hA h2)))) ;
  am-eta G A B f hA hB h | rA rB r -> c-am-eta G A B f hA hB h rA ;
  am-lf-pic G n p a b h1 h2 le nb | r1 r2 -> c-am-lf-pic G n p a b h1 h2 le nb r1.1 ;
  am-lf-uc G m n p h lt le nb ->
    (h, (at-uu G p h nb,
      (am-lf G n p (auc m n G) (am-uc G m n h lt (leN-trans n p N (lt-le n p le) nb)) le nb,
       am-uc G m p h (leN-trans (suc m) n p lt (lt-le n p le)) nb))) ;
  am-lf-lf G m n p a h le1 le2 nb | r ->
    (r.1, (at-uu G p r.1 nb,
       (am-lf G n p (alf m n a) (am-lf G m n a h le1 (leN-trans n p N (lt-le n p le2) nb)) le2 nb,
        am-lf G m p a h (leN-trans (suc m) n p le1 (lt-le n p le2)) nb))) ;
  am-sb-id G a A h | r ->
    (r.1, (r.2, (am-conv G (asb a (aid G)) (asb A (aid G)) A (am-sb G G a A (aid G) r.2 h (as-id G r.1)) (ae-sb-id G A r.2), h))) ;
  am-sb-comp T D G a A s d h0 h1 h2 | r0 r1 r2 -> c-am-sb-comp T D G a A s d h0 h1 h2 r0.2 r2.1 ;
  am-lam-sb D G A B b s h1 h2 h3 h4 | r1 r2 r3 r4 -> c-am-lam-sb D G A B b s h1 h2 h3 h4 r4.1 ;
  am-app-sb D G A B c a s h1 h2 h3 h4 h5 | r1 r2 r3 r4 r5 -> c-am-app-sb D G A B c a s h1 h2 h3 h4 h5 r5.1 ;
  am-pic-sb D G n a b s h1 h2 h3 | r1 r2 r3 -> c-am-pic-sb D G n a b s h1 h2 h3 r3.1 r1.2 r2.2 ;
  am-uc-sb D G m n s h lt nb | r ->
    (r.1, (at-uu D n r.1 nb, (sb-uu D G (auc m n G) s n (at-uu G n r.2 nb) (am-uc G m n r.2 lt nb) h, am-uc D m n r.1 lt nb))) ;
  am-lf-sb D G m n a s h1 h2 le nb | r1 r2 ->
    (r2.1, (at-uu D n r2.1 nb, (sb-uu D G (alf m n a) s n (at-uu G n r2.2 nb) (am-lf G m n a h1 le nb) h2,
     am-lf D m n (asb a s) (sb-uu D G a s m r1.2 h1 h2) le nb))) ;
  am-q-lift D G A s h1 h2 | r1 r2 -> c-am-q-lift D G A s h1 h2 ;
  am-q-sec G A a h1 h2 | r1 r2 -> c-am-q-sec G A a h1 h2 r1 ;
  am-ecx G D a b A h0 h1 h2 | r0 r1 r2 ->
    (h0, (at-cx G D A h0 h1 r2.2.1, (am-cx G D a A h0 h1 r2.2.2.1, am-cx G D b A h0 h1 r2.2.2.2))) ;
  aq-refl D s G h | r -> (r.1, (r.2, (h, h))) ;
  aq-sym D s t G h | r -> (r.1, (r.2.1, (r.2.2.2, r.2.2.1))) ;
  aq-trans D s t u G h1 h2 | r1 r2 -> (r1.1, (r1.2.1, (r1.2.2.1, r2.2.2.2))) ;
  aq-comp T D G s s' d d' h1 h2 | r1 r2 ->
    (r2.1, (r1.2.1, (as-comp T D G s d r1.2.2.1 r2.2.2.1, as-comp T D G s' d' r1.2.2.2 r2.2.2.2))) ;
  aq-lift D G A A' s s' h0 h1 h2 h3 | r0 r1 r2 r3 -> c-aq-lift D G A A' s s' h0 h1 h2 h3 r1 r2 r3 ;
  aq-sec G A A' a a' hA ha ha' h1 h2 | rA ra ra' r1 r2 ->
    (rA, (a-ext G A hA, (as-sec G A a hA ha, sec-cx G A A' a' rA hA r1.2.2 h1 ha'))) ;
  aq-idl D G s h | r -> (r.1, (r.2, (as-comp D G G (aid G) s (as-id G r.2) h, h))) ;
  aq-idr D G s h | r -> (r.1, (r.2, (as-comp D D G s (aid D) h (as-id D r.1), h))) ;
  aq-assoc Q T D G s d e h1 h2 h3 | r1 r2 r3 ->
    (r3.1, (r1.2, (as-comp Q T G (acomp s d) e (as-comp T D G s d h1 h2) h3,
                   as-comp Q D G s (acomp d e) h1 (as-comp Q T D d e h2 h3)))) ;
  aq-eps G s h | r -> (r.1, (a-nil, (h, as-eps G r.1))) ;
  aq-lift-id G A h | r -> c-aq-lift-id G A h r ;
  aq-lift-comp T D G A s d h0 h1 h2 | r0 r1 r2 -> c-aq-lift-comp T D G A s d h0 h1 h2 r2.1 ;
  aq-p-lift D G A s h1 h2 | r1 r2 ->
    (a-ext D (asb A s) (at-sb D G A s h1 h2), (r1,
     (as-comp (aext D (asb A s)) (aext G A) G (ap G A) (alift A s) (as-p G A h1) (as-lift D G A s h2 h1),
      as-comp (aext D (asb A s)) D G s (ap D (asb A s)) h2 (as-p D (asb A s) (at-sb D G A s h1 h2))))) ;
  aq-p-sec G A a h1 h2 | r1 r2 ->
    (r1, (r1, (as-comp G (aext G A) G (ap G A) (asec A a) (as-p G A h1) (as-sec G A a h1 h2), as-id G r1))) ;
  aq-sec-comp D G A a s h1 h2 h3 | r1 r2 r3 -> c-aq-sec-comp D G A a s h1 h2 h3 r3.1 ;
  aq-lift-p-sec-q G A h | r -> c-aq-lift-p-sec-q G A h ;
  ae-uu-cx G H n e nb | r ->
    (r.1, (at-uu G n r.1 nb, at-cx H G (auu n H) r.1 r.2.2 (at-uu H n r.2.1 nb))) ;
  am-uc-cx G H m n e lt nb | r ->
    (r.1, (at-uu G n r.1 nb, (am-uc G m n r.1 lt nb,
      move-uu-tm H G (auc m n H) n r.1 r.2.2 nb (am-uc H m n r.2.1 lt nb)))) ;
  aq-id-cx G H e | r ->
    (r.1, (r.1, (as-id G r.1, as-cx H G H G (aid H) r.1 r.1 r.2.2 r.2.2 (as-id H r.2.1)))) ;
  aq-eps-cx G H e | r ->
    (r.1, (a-nil, (as-eps G r.1, as-cx H G anil anil (aeps H) r.1 a-nil r.2.2 ac-nil (as-eps H r.2.1)))) ;
  aq-p-cx G H A B e p | r t -> p-annotation-presup G H A B e p r t ;
  am-q-cx G H A B e p | r t -> q-annotation-presup G H A B e p r t } ;

a-cx-sym (G D : GA) (e : GADer (ajeqcx G D)) : GADer (ajeqcx D G) =
  (apresup (ajeqcx G D) e).2.2 ;

a-universe-tm-bound (G a : GA) (n : Nat) (h : Tm' G a (auu n G)) : LeN n N =
  a-universe-bound G G n (apresup (ajtm G a (auu n G)) h).2 ;
