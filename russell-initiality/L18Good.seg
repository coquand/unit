-- L18Good.seg: the substitution part of Lemma 18.
--   transports of GAT derivations and environments along raw equations
--   Good G0 G s     s i satisfies PM, NM, EM in G0 (at the substituted type)
--   ST / SMt        ev (A[s]) e is typed and equal to ev A (evs s e)
--   CtxS G          PT, NT, ET, ST for the types of G
--   evs-ok, enveq-good-sub, enveq-good-rel, ci-sub, good-lift

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open GAT[l] ; open Ev[l] ;
open L18Base[l] ;

------------------------------------------------------------------------
-- transports

gtm-a (D a a' T : GE) (e : Id GE a a') (h : GDer (gjtm D a T)) : GDer (gjtm D a' T) = subst GE (\ X -> GDer (gjtm D X T)) a a' e h ;
gtm-T (D a T T' : GE) (e : Id GE T T') (h : GDer (gjtm D a T)) : GDer (gjtm D a T') = subst GE (\ X -> GDer (gjtm D a X)) T T' e h ;
gty-A (D A A' : GE) (e : Id GE A A') (h : GDer (gjty D A)) : GDer (gjty D A') = subst GE (\ X -> GDer (gjty D X)) A A' e h ;
geqt-l (D A A' B : GE) (e : Id GE A A') (h : GDer (gjeqty D A B)) : GDer (gjeqty D A' B) = subst GE (\ X -> GDer (gjeqty D X B)) A A' e h ;
geqt-r (D A B B' : GE) (e : Id GE B B') (h : GDer (gjeqty D A B)) : GDer (gjeqty D A B') = subst GE (\ X -> GDer (gjeqty D A X)) B B' e h ;
geqm-l (D a a' b T : GE) (e : Id GE a a') (h : GDer (gjeqtm D a b T)) : GDer (gjeqtm D a' b T) = subst GE (\ X -> GDer (gjeqtm D X b T)) a a' e h ;
geqm-r (D a b b' T : GE) (e : Id GE b b') (h : GDer (gjeqtm D a b T)) : GDer (gjeqtm D a b' T) = subst GE (\ X -> GDer (gjeqtm D a X T)) b b' e h ;
geqm-T (D a b T T' : GE) (e : Id GE T T') (h : GDer (gjeqtm D a b T)) : GDer (gjeqtm D a b T') = subst GE (\ X -> GDer (gjeqtm D a b X)) T T' e h ;

symG (a b : GE) (e : Id GE a b) : Id GE b a = sym GE a b e ;

envok-pt (D : GE) : (G : Cx) -> (e e' : Nat -> GE) -> GPt e e' -> EnvOk D G e -> EnvOk D G e' = split {
  cnil -> \ e e' p o -> tt ;
  csnoc G A | r -> \ e e' p o ->
    (r (\ i -> e (suc i)) (\ i -> e' (suc i)) (\ i -> p (suc i)) o.1,
     gtm-a D (e zero) (e' zero) (ev A (\ i -> e' (suc i))) (p zero)
       (gtm-T D (e zero) (ev A (\ i -> e (suc i))) (ev A (\ i -> e' (suc i)))
          (ev-ext A (\ i -> e (suc i)) (\ i -> e' (suc i)) (\ i -> p (suc i))) o.2)) } ;

enveq-ptl (D : GE) : (G : Cx) -> (e1 e1' e2 : Nat -> GE) -> GPt e1 e1' -> EnvEq D G e1 e2 -> EnvEq D G e1' e2 = split {
  cnil -> \ e1 e1' e2 p q -> tt ;
  csnoc G A | r -> \ e1 e1' e2 p q ->
    (r (\ i -> e1 (suc i)) (\ i -> e1' (suc i)) (\ i -> e2 (suc i)) (\ i -> p (suc i)) q.1,
     geqm-l D (e1 zero) (e1' zero) (e2 zero) (ev A (\ i -> e1' (suc i))) (p zero)
       (geqm-T D (e1 zero) (e2 zero) (ev A (\ i -> e1 (suc i))) (ev A (\ i -> e1' (suc i)))
          (ev-ext A (\ i -> e1 (suc i)) (\ i -> e1' (suc i)) (\ i -> p (suc i))) q.2)) } ;

enveq-ptr (D : GE) : (G : Cx) -> (e1 e2 e2' : Nat -> GE) -> GPt e2 e2' -> EnvEq D G e1 e2 -> EnvEq D G e1 e2' = split {
  cnil -> \ e1 e2 e2' p q -> tt ;
  csnoc G A | r -> \ e1 e2 e2' p q ->
    (r (\ i -> e1 (suc i)) (\ i -> e2 (suc i)) (\ i -> e2' (suc i)) (\ i -> p (suc i)) q.1,
     geqm-r D (e1 zero) (e2 zero) (e2' zero) (ev A (\ i -> e1 (suc i))) (p zero) q.2) } ;

------------------------------------------------------------------------
-- the two composite relations of environments

-- (e p) lift_X(s) ~ (e s) p
enveq-plift (D T X s : GE) (wD : GDer (gjwf D)) (wT : GDer (gjwf T)) (hX : GDer (gjty D X)) (hs : GDer (gjsub T s D))
    (G : Cx) (c : CtxI G) (e : Nat -> GE) (o : EnvOk D G e) :
    EnvEq (gext T (gsb X s)) G (esb (esb e gp) (glift X s)) (esb (esb e s) gp) =
  enveq-trans (gext T (gsb X s)) (g-ext T (gsb X s) (gt-sb T D X s hX hs)) G c
    (esb (esb e gp) (glift X s)) (esb e (gcomp gp (glift X s))) (esb (esb e s) gp)
    (env-sub (gext D X) (gext T (gsb X s)) (glift X s) (g-ext D X hX) (g-ext T (gsb X s) (gt-sb T D X s hX hs))
       (gs-lift T D X s hs hX) G c (esb e gp) (env-sub D (gext D X) gp wD (g-ext D X hX) (gs-p D X hX) G c e o))
    (env-sub D (gext T (gsb X s)) (gcomp gp (glift X s)) wD (g-ext T (gsb X s) (gt-sb T D X s hX hs))
       (gs-comp (gext T (gsb X s)) (gext D X) D gp (glift X s) (gs-p D X hX) (gs-lift T D X s hs hX)) G c e o)
    (enveq-comp D (gext D X) (gext T (gsb X s)) gp (glift X s) wD (g-ext D X hX) (g-ext T (gsb X s) (gt-sb T D X s hX hs))
       (gs-p D X hX) (gs-lift T D X s hs hX) G c e o)
    (enveq-trans (gext T (gsb X s)) (g-ext T (gsb X s) (gt-sb T D X s hX hs)) G c
       (esb e (gcomp gp (glift X s))) (esb e (gcomp s gp)) (esb (esb e s) gp)
       (env-sub D (gext T (gsb X s)) (gcomp gp (glift X s)) wD (g-ext T (gsb X s) (gt-sb T D X s hX hs))
          (gs-comp (gext T (gsb X s)) (gext D X) D gp (glift X s) (gs-p D X hX) (gs-lift T D X s hs hX)) G c e o)
       (env-sub D (gext T (gsb X s)) (gcomp s gp) wD (g-ext T (gsb X s) (gt-sb T D X s hX hs))
          (gs-comp (gext T (gsb X s)) T D s gp hs (gs-p T (gsb X s) (gt-sb T D X s hX hs))) G c e o)
       (enveq-subeq D (gext T (gsb X s)) (gcomp gp (glift X s)) (gcomp s gp) wD (g-ext T (gsb X s) (gt-sb T D X s hX hs))
          (gs-comp (gext T (gsb X s)) (gext D X) D gp (glift X s) (gs-p D X hX) (gs-lift T D X s hs hX))
          (gs-comp (gext T (gsb X s)) T D s gp hs (gs-p T (gsb X s) (gt-sb T D X s hX hs)))
          (gq-p-lift T D X s hX hs) G c e o)
       (enveq-sym (gext T (gsb X s)) (g-ext T (gsb X s) (gt-sb T D X s hX hs)) G c
          (esb (esb e s) gp) (esb e (gcomp s gp))
          (env-sub T (gext T (gsb X s)) gp wT (g-ext T (gsb X s) (gt-sb T D X s hX hs)) (gs-p T (gsb X s) (gt-sb T D X s hX hs))
             G c (esb e s) (env-sub D T s wD wT hs G c e o))
          (env-sub D (gext T (gsb X s)) (gcomp s gp) wD (g-ext T (gsb X s) (gt-sb T D X s hX hs))
             (gs-comp (gext T (gsb X s)) T D s gp hs (gs-p T (gsb X s) (gt-sb T D X s hX hs))) G c e o)
          (enveq-comp D T (gext T (gsb X s)) s gp wD wT (g-ext T (gsb X s) (gt-sb T D X s hX hs)) hs
             (gs-p T (gsb X s) (gt-sb T D X s hX hs)) G c e o))) ;

-- (e p) sec_X(a) ~ e
enveq-psec (D X a : GE) (wD : GDer (gjwf D)) (hX : GDer (gjty D X)) (ha : GDer (gjtm D a X))
    (G : Cx) (c : CtxI G) (e : Nat -> GE) (o : EnvOk D G e) :
    EnvEq D G (esb (esb e gp) (gsec X a)) e =
  enveq-trans D wD G c (esb (esb e gp) (gsec X a)) (esb e (gcomp gp (gsec X a))) e
    (env-sub (gext D X) D (gsec X a) (g-ext D X hX) wD (gs-sec D X a hX ha) G c (esb e gp)
       (env-sub D (gext D X) gp wD (g-ext D X hX) (gs-p D X hX) G c e o))
    (env-sub D D (gcomp gp (gsec X a)) wD wD (gs-comp D (gext D X) D gp (gsec X a) (gs-p D X hX) (gs-sec D X a hX ha)) G c e o)
    (enveq-comp D (gext D X) D gp (gsec X a) wD (g-ext D X hX) wD (gs-p D X hX) (gs-sec D X a hX ha) G c e o)
    (enveq-trans D wD G c (esb e (gcomp gp (gsec X a))) (esb e gid) e
       (env-sub D D (gcomp gp (gsec X a)) wD wD (gs-comp D (gext D X) D gp (gsec X a) (gs-p D X hX) (gs-sec D X a hX ha)) G c e o)
       (env-sub D D gid wD wD (gs-id D wD) G c e o)
       (enveq-subeq D D (gcomp gp (gsec X a)) gid wD wD
          (gs-comp D (gext D X) D gp (gsec X a) (gs-p D X hX) (gs-sec D X a hX ha)) (gs-id D wD)
          (gq-p-sec D X a hX ha) G c e o)
       (enveq-id D wD G c e o)) ;

------------------------------------------------------------------------
-- substitutions

evs (s : Nat -> Tm) (e : Nat -> GE) : Nat -> GE = \ i -> ev (s i) e ;

Good (G0 : Cx) : Cx -> (Nat -> Tm) -> U l = split {
  cnil -> \ s -> Top ;
  csnoc G A | r -> \ s -> r (\ i -> s (suc i)) *
     (PM G0 (s zero) (Sub.trav A (\ i -> s (suc i))) *
      (NM G0 (s zero) (Sub.trav A (\ i -> s (suc i))) * EM G0 (s zero) (Sub.trav A (\ i -> s (suc i))))) } ;

ST (G : Cx) (A : Tm) : U l = (G0 : Cx) -> (s : Nat -> Tm) -> CtxI G0 -> Good G0 G s ->
  (D : GE) -> (e : Nat -> GE) -> GDer (gjwf D) -> EnvOk D G0 e ->
  GDer (gjty D (ev (Sub.trav A s) e)) * GDer (gjeqty D (ev (Sub.trav A s) e) (ev A (evs s e))) ;

SMt (G : Cx) (a A : Tm) : U l = (G0 : Cx) -> (s : Nat -> Tm) -> CtxI G0 -> Good G0 G s ->
  (D : GE) -> (e : Nat -> GE) -> GDer (gjwf D) -> EnvOk D G0 e ->
  GDer (gjtm D (ev (Sub.trav a s) e) (ev A (evs s e))) *
  GDer (gjeqtm D (ev (Sub.trav a s) e) (ev a (evs s e)) (ev A (evs s e))) ;

CtxS : Cx -> U l = split {
  cnil -> Top ;
  csnoc G A | r -> r * (PT G A * (NT G A * (ET G A * ST G A))) } ;

cs-ci : (G : Cx) -> CtxS G -> CtxI G = split {
  cnil -> \ c -> tt ;
  csnoc G A | r -> \ c -> (r c.1, (c.2.1, (c.2.2.1, c.2.2.2.1))) } ;

-- the type of s 0, read with ev
st-ty (G0 G : Cx) (A : Tm) (st : ST G A) (s : Nat -> Tm) (c0 : CtxI G0) (g : Good G0 G s) (D : GE) (e : Nat -> GE)
    (wD : GDer (gjwf D)) (o : EnvOk D G0 e) : GDer (gjeqty D (ev (Sub.trav A s) e) (ev A (evs s e))) =
  (st G0 s c0 g D e wD o).2 ;

evs-ok (G0 : Cx) (c0 : CtxI G0) (D : GE) (wD : GDer (gjwf D)) (e : Nat -> GE) (o : EnvOk D G0 e) :
    (G : Cx) -> CtxS G -> (s : Nat -> Tm) -> Good G0 G s -> EnvOk D G (evs s e) = split {
  cnil -> \ c s g -> tt ;
  csnoc G A | r -> \ c s g ->
    (r c.1 (\ i -> s (suc i)) g.1,
     gm-conv D (ev (s zero) e) (ev (Sub.trav A (\ i -> s (suc i))) e) (ev A (evs (\ i -> s (suc i)) e))
       (g.2.1 D e wD o)
       (st-ty G0 G A c.2.2.2.2 (\ i -> s (suc i)) c0 g.1 D e wD o)) } ;

enveq-good-rel (G0 : Cx) (c0 : CtxI G0) (D : GE) (wD : GDer (gjwf D)) (e1 e2 : Nat -> GE) (r : Rel D G0 e1 e2) :
    (G : Cx) -> CtxS G -> (s : Nat -> Tm) -> Good G0 G s -> EnvEq D G (evs s e1) (evs s e2) = split {
  cnil -> \ c s g -> tt ;
  csnoc G A | r' -> \ c s g ->
    (r' c.1 (\ i -> s (suc i)) g.1,
     gm-eqconv D (ev (s zero) e1) (ev (s zero) e2) (ev (Sub.trav A (\ i -> s (suc i))) e1) (ev A (evs (\ i -> s (suc i)) e1))
       (g.2.2.2 D e1 e2 wD r)
       (st-ty G0 G A c.2.2.2.2 (\ i -> s (suc i)) c0 g.1 D e1 wD r.1)) } ;

enveq-good-sub (G0 : Cx) (c0 : CtxI G0) (D T t : GE) (wD : GDer (gjwf D)) (wT : GDer (gjwf T)) (ht : GDer (gjsub T t D))
    (e : Nat -> GE) (o : EnvOk D G0 e) :
    (G : Cx) -> CtxS G -> (s : Nat -> Tm) -> Good G0 G s -> EnvEq T G (esb (evs s e) t) (evs s (esb e t)) = split {
  cnil -> \ c s g -> tt ;
  csnoc G A | r -> \ c s g ->
    (r c.1 (\ i -> s (suc i)) g.1,
     gm-eqconv T (gsb (ev (s zero) e) t) (ev (s zero) (esb e t)) (ev (Sub.trav A (\ i -> s (suc i))) (esb e t))
       (ev A (esb (evs (\ i -> s (suc i)) e) t))
       (g.2.2.1 D e T t wD wT o ht)
       (ge-trans T (ev (Sub.trav A (\ i -> s (suc i))) (esb e t)) (ev A (evs (\ i -> s (suc i)) (esb e t))) (ev A (esb (evs (\ i -> s (suc i)) e) t))
          (st-ty G0 G A c.2.2.2.2 (\ i -> s (suc i)) c0 g.1 T (esb e t) wT (env-sub D T t wD wT ht G0 c0 e o))
          (c.2.2.2.1 T (evs (\ i -> s (suc i)) (esb e t)) (esb (evs (\ i -> s (suc i)) e) t) wT
             (evs-ok G0 c0 T wT (esb e t) (env-sub D T t wD wT ht G0 c0 e o) G c.1 (\ i -> s (suc i)) g.1,
              (env-sub D T t wD wT ht G (cs-ci G c.1) (evs (\ i -> s (suc i)) e) (evs-ok G0 c0 D wD e o G c.1 (\ i -> s (suc i)) g.1),
               enveq-sym T wT G (cs-ci G c.1) (esb (evs (\ i -> s (suc i)) e) t) (evs (\ i -> s (suc i)) (esb e t))
                 (env-sub D T t wD wT ht G (cs-ci G c.1) (evs (\ i -> s (suc i)) e) (evs-ok G0 c0 D wD e o G c.1 (\ i -> s (suc i)) g.1))
                 (evs-ok G0 c0 T wT (esb e t) (env-sub D T t wD wT ht G0 c0 e o) G c.1 (\ i -> s (suc i)) g.1)
                 (r c.1 (\ i -> s (suc i)) g.1)))))) } ;

------------------------------------------------------------------------
-- the properties of A[s], from those of A

ci-sub (G0 G : Cx) (A : Tm) (c0 : CtxI G0) (cG : CtxS G) (s : Nat -> Tm) (g : Good G0 G s)
    (pA : PT G A) (nA : NT G A) (eA : ET G A) (sA : ST G A) :
    PT G0 (Sub.trav A s) * (NT G0 (Sub.trav A s) * ET G0 (Sub.trav A s)) =
  (\ D e wD o -> (sA G0 s c0 g D e wD o).1,
   (\ D e T t wD wT o ht ->
      ge-trans T (gsb (ev (Sub.trav A s) e) t) (gsb (ev A (evs s e)) t) (ev (Sub.trav A s) (esb e t))
        (ge-sb T D (ev (Sub.trav A s) e) (ev A (evs s e)) t t (sA G0 s c0 g D e wD o).1 (sA G0 s c0 g D e wD o).2 ht ht
           (gq-refl T t D ht))
        (ge-trans T (gsb (ev A (evs s e)) t) (ev A (esb (evs s e) t)) (ev (Sub.trav A s) (esb e t))
           (nA D (evs s e) T t wD wT (evs-ok G0 c0 D wD e o G cG s g) ht)
           (ge-trans T (ev A (esb (evs s e) t)) (ev A (evs s (esb e t))) (ev (Sub.trav A s) (esb e t))
              (eA T (esb (evs s e) t) (evs s (esb e t)) wT
                 (env-sub D T t wD wT ht G (cs-ci G cG) (evs s e) (evs-ok G0 c0 D wD e o G cG s g),
                  (evs-ok G0 c0 T wT (esb e t) (env-sub D T t wD wT ht G0 c0 e o) G cG s g,
                   enveq-good-sub G0 c0 D T t wD wT ht e o G cG s g)))
              (ge-sym T (ev (Sub.trav A s) (esb e t)) (ev A (evs s (esb e t)))
                 (sA G0 s c0 g T (esb e t) wT (env-sub D T t wD wT ht G0 c0 e o)).2))),
    \ D e1 e2 wD r ->
      ge-trans D (ev (Sub.trav A s) e1) (ev A (evs s e1)) (ev (Sub.trav A s) e2) (sA G0 s c0 g D e1 wD r.1).2
        (ge-trans D (ev A (evs s e1)) (ev A (evs s e2)) (ev (Sub.trav A s) e2)
           (eA D (evs s e1) (evs s e2) wD
              (evs-ok G0 c0 D wD e1 r.1 G cG s g, (evs-ok G0 c0 D wD e2 r.2.1 G cG s g, enveq-good-rel G0 c0 D wD e1 e2 r G cG s g)))
           (ge-sym D (ev (Sub.trav A s) e2) (ev A (evs s e2)) (sA G0 s c0 g D e2 wD r.2.1).2)))) ;
