       (ge-sb D (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (up (evs s e))) (gsec (ev (Sub.trav A s) e) (ev (Sub.trav a s) e)) (gsec (ev (Sub.trav A s) e) (ev a (evs s e))) (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.2.2.2.2 rB.2.2.2.1 D e wD o).1 (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.2.2.2.2 rB.2.2.2.1 D e wD o).2
          (gs-sec D (ev (Sub.trav A s) e) (ev (Sub.trav a s) e) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (gm-conv D (ev (Sub.trav a s) e) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).1 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2))) (gs-sec D (ev (Sub.trav A s) e) (ev a (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (gm-conv D (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.1 D (evs s e) wD (evs-ok G0 c0 D wD e o G rA.1 s g)) (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)))
          (gq-sec D (ev (Sub.trav A s) e) (ev (Sub.trav A s) e) (ev (Sub.trav a s) e) (ev a (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (gm-conv D (ev (Sub.trav a s) e) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).1 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)) (gm-conv D (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.1 D (evs s e) wD (evs-ok G0 c0 D wD e o G rA.1 s g)) (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)) (ge-refl D (ev (Sub.trav A s) e) (rA.2.2.2.2 G0 s c0 g D e wD o).1) (gm-eqconv D (ev (Sub.trav a s) e) (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).2 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2))))
