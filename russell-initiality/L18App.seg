    (wD : GDer (gjwf D)) (o : EnvOk D G0 e) :
    GDer (gjtm D (ev (Sub.trav (app A B c a) s) e) (ev (subst1 B a) (evs s e))) *
    GDer (gjeqtm D (ev (Sub.trav (app A B c a) s) e) (ev (app A B c a) (evs s e)) (ev (subst1 B a) (evs s e))) =
