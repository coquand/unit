c-app (G : Cx) (A B c a : Tm) (rA : L18J (jty G A)) (rB : L18J (jty (csnoc G A) B)) (rc : L18J (jtm G c (pi A B)))
    (ra : L18J (jtm G a A)) : L18J (jtm G (app A B c a) (subst1 B a)) =
  (rA.1,
   (\ D e wD o ->
      gm-conv D (gapp (ev A e) (ev B (up e)) (ev c e) (ev a e)) (gsb (ev B (up e)) (gsec (ev A e) (ev a e))) (ev (subst1 B a) e)
        (gm-app D (ev A e) (ev B (up e)) (ev c e) (ev a e) (rA.2.1 D e wD o)
           (rB.2.1 (gext D (ev A e)) (up e) (g-ext D (ev A e) (rA.2.1 D e wD o)) (env-up D e wD G A (cs-ci (csnoc G A) rB.1) o))
           (rc.2.1 D e wD o) (ra.2.1 D e wD o))
        (tyapp G A B a rA.1 (cs-ci (csnoc G A) rB.1) rB.1 ra.2.1 ra.2.2.1 ra.2.2.2.1 rB.2.2.1 rB.2.2.2.1 rB.2.2.2.2
           D (ev A e) e wD (rA.2.1 D e wD o) (ge-refl D (ev A e) (rA.2.1 D e wD o)) o (ra.2.1 D e wD o)),
    (\ D e T s wD wT o hs ->
       gm-eqconv T (gsb (gapp (ev A e) (ev B (up e)) (ev c e) (ev a e)) s) (gapp (ev A (esb e s)) (ev B (up (esb e s))) (ev c (esb e s)) (ev a (esb e s)))
         (gsb (gsb (ev B (up e)) (glift (ev A e) s)) (gsec (gsb (ev A e) s) (gsb (ev a e) s))) (ev (subst1 B a) (esb e s))
         (gm-trans T (gsb (gapp (ev A e) (ev B (up e)) (ev c e) (ev a e)) s) (gapp (gsb (ev A e) s) (gsb (ev B (up e)) (glift (ev A e) s)) (gsb (ev c e) s) (gsb (ev a e) s)) (gapp (ev A (esb e s)) (ev B (up (esb e s))) (ev c (esb e s)) (ev a (esb e s)))
            (gsb (gsb (ev B (up e)) (glift (ev A e) s)) (gsec (gsb (ev A e) s) (gsb (ev a e) s)))
