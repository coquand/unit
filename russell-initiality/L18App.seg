-- L18App.seg: Lemma 18, the case of application.
--   tyapp    (ev B (up e)) sec_X(ev a e) = ev (B[a]) e
--   tysec-sb ((B lift s) sec(a s)) = (B sec(a)) s       (Ehrhard: sec(a) s = lift(s) sec(a s))
--   c-app

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18Bind[l] ; open L18Pi[l] ;

tyapp (G : Cx) (A B a : Tm) (cG : CtxS G) (cI : CI G A) (cGA : CtxS (csnoc G A))
    (pa : PM G a A) (na : NM G a A) (ea : EM G a A) (nB : NT (csnoc G A) B) (eB : ET (csnoc G A) B) (sB : ST (csnoc G A) B)
    (D X : GE) (e : Nat -> GE) (wD : GDer (gjwf D)) (hX : GDer (gjty D X)) (eX : GDer (gjeqty D X (ev A e)))
    (o : EnvOk D G e) (ha : GDer (gjtm D (ev a e) X)) :
    GDer (gjeqty D (gsb (ev B (up e)) (gsec X (ev a e))) (ev (subst1 B a) e)) =
  ge-trans D (gsb (ev B (up e)) (gsec X (ev a e))) (ev B (evs (sub1 a) e)) (ev (subst1 B a) e)
    (ty-sec G A a B cG cI cGA pa na ea nB eB D X e wD hX eX o ha)
    (ge-sym D (ev (subst1 B a) e) (ev B (evs (sub1 a) e))
       (sB G (sub1 a) (cs-ci G cG) (good-sub1 G (cs-ci G cG) A a pa na ea) D e wD o).2) ;

-- ((Y lift_X(s)) sec_{X s}(a s)) = (Y sec_X(a)) s
tysec-sb (D T X Y a s : GE) (hX : GDer (gjty D X)) (hY : GDer (gjty (gext D X) Y)) (ha : GDer (gjtm D a X))
    (hs : GDer (gjsub T s D)) :
    GDer (gjeqty T (gsb (gsb Y (glift X s)) (gsec (gsb X s) (gsb a s))) (gsb (gsb Y (gsec X a)) s)) =
  ge-trans T (gsb (gsb Y (glift X s)) (gsec (gsb X s) (gsb a s))) (gsb Y (gcomp (glift X s) (gsec (gsb X s) (gsb a s))))
    (gsb (gsb Y (gsec X a)) s)
    (ge-sb-comp T (gext T (gsb X s)) (gext D X) Y (glift X s) (gsec (gsb X s) (gsb a s)) hY (gs-lift T D X s hs hX)
       (gs-sec T (gsb X s) (gsb a s) (gt-sb T D X s hX hs) (gm-sb T D a X s hX ha hs)))
    (ge-trans T (gsb Y (gcomp (glift X s) (gsec (gsb X s) (gsb a s)))) (gsb Y (gcomp (gsec X a) s)) (gsb (gsb Y (gsec X a)) s)
       (ge-sb T (gext D X) Y Y (gcomp (glift X s) (gsec (gsb X s) (gsb a s))) (gcomp (gsec X a) s) hY (ge-refl (gext D X) Y hY)
          (gs-comp T (gext T (gsb X s)) (gext D X) (glift X s) (gsec (gsb X s) (gsb a s)) (gs-lift T D X s hs hX)
             (gs-sec T (gsb X s) (gsb a s) (gt-sb T D X s hX hs) (gm-sb T D a X s hX ha hs)))
          (gs-comp T D (gext D X) (gsec X a) s (gs-sec D X a hX ha) hs)
          (gq-sym T (gcomp (gsec X a) s) (gcomp (glift X s) (gsec (gsb X s) (gsb a s))) (gext D X)
             (gq-sec-comp T D X a s hX ha hs)))
       (ge-sym T (gsb (gsb Y (gsec X a)) s) (gsb Y (gcomp (gsec X a) s))
          (ge-sb-comp T D (gext D X) Y (gsec X a) s hY (gs-sec D X a hX ha) hs))) ;

app-smt (G : Cx) (A B c a : Tm) (rA : L18J (jty G A)) (rB : L18J (jty (csnoc G A) B)) (rc : L18J (jtm G c (pi A B)))
