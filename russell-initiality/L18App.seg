       (ge-sb D (gext D (ev (Sub.trav A s) e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (up (evs s e))) (gsec (ev (Sub.trav A s) e) (ev (Sub.trav a s) e)) (gsec (ev (Sub.trav A s) e) (ev a (evs s e))) (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.2.2.2.2 rB.2.2.2.1 D e wD o).1 (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.2.2.2.2 rB.2.2.2.1 D e wD o).2
          (gs-sec D (ev (Sub.trav A s) e) (ev (Sub.trav a s) e) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (gm-conv D (ev (Sub.trav a s) e) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).1 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2))) (gs-sec D (ev (Sub.trav A s) e) (ev a (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (gm-conv D (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.1 D (evs s e) wD (evs-ok G0 c0 D wD e o G rA.1 s g)) (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)))
          (gq-sec D (ev (Sub.trav A s) e) (ev (Sub.trav A s) e) (ev (Sub.trav a s) e) (ev a (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (gm-conv D (ev (Sub.trav a s) e) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).1 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)) (gm-conv D (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.1 D (evs s e) wD (evs-ok G0 c0 D wD e o G rA.1 s g)) (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)) (ge-refl D (ev (Sub.trav A s) e) (rA.2.2.2.2 G0 s c0 g D e wD o).1) (gm-eqconv D (ev (Sub.trav a s) e) (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).2 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2))))
       (tyapp G A B a rA.1 (cs-ci (csnoc G A) rB.1) rB.1 ra.2.1 ra.2.2.1 ra.2.2.2.1 rB.2.2.1 rB.2.2.2.1 rB.2.2.2.2 D (ev (Sub.trav A s) e) (evs s e) wD (rA.2.2.2.2 G0 s c0 g D e wD o).1 (rA.2.2.2.2 G0 s c0 g D e wD o).2 (evs-ok G0 c0 D wD e o G rA.1 s g) (gm-conv D (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.1 D (evs s e) wD (evs-ok G0 c0 D wD e o G rA.1 s g)) (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)))),
   gm-eqconv D (gapp (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev (Sub.trav c s) e) (ev (Sub.trav a s) e)) (gapp (ev A (evs s e)) (ev B (up (evs s e))) (ev c (evs s e)) (ev a (evs s e))) (gsb (ev (Sub.trav B (Sub.lift s)) (up e)) (gsec (ev (Sub.trav A s) e) (ev (Sub.trav a s) e)))
     (ev (subst1 B a) (evs s e))
     (gm-eapp D (ev (Sub.trav A s) e) (ev A (evs s e)) (ev (Sub.trav B (Sub.lift s)) (up e)) (ev B (up (evs s e))) (ev (Sub.trav c s) e) (ev c (evs s e)) (ev (Sub.trav a s) e) (ev a (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).1 (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.2.2.2.2 rB.2.2.2.1 D e wD o).1 (gm-conv D (ev (Sub.trav a s) e) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).1 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)) (rA.2.2.2.2 G0 s c0 g D e wD o).2 (st-bind G0 G A B c0 rA.1 (cs-ci (csnoc G A) rB.1) rB.1 s g rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.2.2.2.2 rB.2.2.2.1 D e wD o).2
        (gm-eqconv D (ev (Sub.trav c s) e) (ev c (evs s e)) (ev (pi A B) (evs s e)) (gpi (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e))) (rc.2.2.2.2 G0 s c0 g D e wD o).2 (ge-sym D (gpi (ev (Sub.trav A s) e) (ev (Sub.trav B (Sub.lift s)) (up e))) (ev (pi A B) (evs s e)) ((pi-props G A B rA.1 rA.2.1 rA.2.2.1 rA.2.2.2.1 rA.2.2.2.2 rB.1 rB.2.1 rB.2.2.1 rB.2.2.2.1 rB.2.2.2.2).2.2.2 G0 s c0 g D e wD o).2)) (gm-eqconv D (ev (Sub.trav a s) e) (ev a (evs s e)) (ev A (evs s e)) (ev (Sub.trav A s) e) (ra.2.2.2.2 G0 s c0 g D e wD o).2 (ge-sym D (ev (Sub.trav A s) e) (ev A (evs s e)) (rA.2.2.2.2 G0 s c0 g D e wD o).2)))
