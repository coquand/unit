-- Equality of codes and its action on their indices.
level l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = IterativeSets[l] ;

code-path (x y : W.V) (p : Id W.M x.1 y.1) : Id W.V x y =
  Sigma-eq W.M W.isIt x.1 y.1 x.2 y.2 p (W.isProp-isIt y.1) ;

move-index (x y : W.V) (p : Id W.V x y) (a : W.Ix x) : W.Ix y =
  subst W.V (\ v -> W.Ix v) x y p a ;

-- Extensionality with explicitly matched indices. They may have different
-- types (for example, the functions into the fibres before and after lift).
reindex-code (x y : W.V)
    (f : W.Ix x -> W.Ix y) (g : W.Ix y -> W.Ix x)
    (forward : (a : W.Ix x) -> Id W.V (W.ev x a) (W.ev y (f a)))
    (backward : (b : W.Ix y) -> Id W.V (W.ev x (g b)) (W.ev y b)) :
    Id W.V x y =
  code-path x y
    (W.ext x.1 y.1 x.2 y.2 (\ z ->
      (\ a -> (f a.1, transH (symH (apH (\ v -> v.1) (forward a.1))) a.2),
       \ b -> (g b.1, transH (apH (\ v -> v.1) (backward b.1)) b.2)))) ;

pi-cong (x y : W.V) (p : Id W.V x y) (B : W.Ix x -> W.V) (C : W.Ix y -> W.V)
    (point : (a : W.Ix x) -> Id W.V (B a) (C (move-index x y p a))) :
    Id W.V (W.PiV x B) (W.PiV y C) =
  idJ W.V x
    (\ y' p' -> (C' : W.Ix y' -> W.V) -> ((a : W.Ix x) -> Id W.V (B a) (C' (move-index x y' p' a)))
      -> Id W.V (W.PiV x B) (W.PiV y' C'))
    (\ C' h -> apH (W.PiV x) (funext (W.Ix x) (\ a -> W.V) B C' h)) y p C point ;
