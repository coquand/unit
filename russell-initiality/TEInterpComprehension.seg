-- Soundness of the equations for p, q, lift, and sec.
open Base ; open Prelude[l] ; open Paths[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpJudgement ; open B.GAT[l] ;

case-gq-p-sec (G A a : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjtm G a A)) :
    SoundJ (gjeqsub G (gcomp gp (gsec A a)) gid G) =
  (r.1,(r.1,\ d g hd hg -> at-context G (\ z -> SubEquality d z (gcomp gp (gsec A a)) gid)
    (d,hd) (build d (p.2 d hd)) g hg))
 where {
  build (g : Tel) (a' : TermValue g A a) : SubEquality g g (gcomp gp (gsec A a)) gid =
    same-sub g g (gcomp gp (gsec A a)) gid
      (C.o (ctx g) (ctx (extend g a'.1)) (ctx g) (C.p (ctx g) a'.1) f) (C.id (ctx g))
      (comp-down gp (gsec A a) g (extend g a'.1) g (C.p (ctx g) a'.1) f (p-down g a'.1)
        (sec-down A a g a'.1 a'.2.2.1 a'.2.1 a'.2.2.2))
      (id-down g) (C.p-sec (ctx g) a'.1 a'.2.2.1)
   where { f : C.Sub (ctx g) (ctx (extend g a'.1)) = C.sec (ctx g) a'.1 a'.2.2.1 ; } ;
 } ;

case-gq-lift-id (G A : GE) (r : SoundJ (gjty G A)) :
    SoundJ (gjeqsub (gext G (gsb A gid)) (glift A gid) gid (gext G A)) =
  (wd,(wg,at-contexts (gext G (gsb A gid)) (gext G A)
    (\ d e -> SubEquality d e (glift A gid) gid) wd wg
    (same-sub x x (glift A gid) gid f (C.id (ctx x))
      (lift-down-as A gid g g a.1 i a.2 (id-down g) a.1 e) (id-down x) (C.lift-id (ctx g) a.1))))
 where {
  g : Tel = r.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  x : Tel = extend g a.1 ;
  i : C.Sub (ctx g) (ctx g) = C.id (ctx g) ;
  a-sub : C.Ty (ctx g) = C.subT (ctx g) (ctx g) a.1 i ;
  e : Id (C.Ty (ctx g)) a-sub a.1 = C.subT-id (ctx g) a.1 ;
  f : C.Sub (ctx x) (ctx x) = cast-lift g g a.1 i a.1 e ;
  wd : CtxValue (gext G (gsb A gid)) =
    extension-witness G (gsb A gid) g r.1.2 a.1 (ty-move (gsb A gid) g a-sub a.1 e
      (ty-sub-down A gid g g a.1 i a.2 (id-down g))) ;
  wg : CtxValue (gext G A) = extension-witness G A g r.1.2 a.1 a.2 ;
 } ;

case-gq-p-lift (D G A s : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjsub D s G)) :
    SoundJ (gjeqsub (gext D (gsb A s)) (gcomp gp (glift A s)) (gcomp s gp) G) =
  (wd,(r.1,at-contexts (gext D (gsb A s)) G
    (\ j h -> SubEquality j h (gcomp gp (glift A s)) (gcomp s gp)) wd r.1 at-canonical))
 where {
  d : Tel = p.1.1 ;
  g : Tel = r.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  f : SubValue d g s = p.2.2 d g p.1.2 r.1.2 ;
  as : C.Ty (ctx d) = C.subT (ctx d) (ctx g) a.1 f.1 ;
  x : Tel = extend d as ;
  y : Tel = extend g a.1 ;
  wd : CtxValue (gext D (gsb A s)) =
    extension-witness D (gsb A s) d p.1.2 as (ty-sub-down A s d g a.1 f.1 a.2 f.2) ;
  L : C.Sub (ctx x) (ctx y) = C.lift (ctx d) (ctx g) a.1 f.1 ;
  at-canonical : SubEquality x g (gcomp gp (glift A s)) (gcomp s gp) =
    same-sub x g (gcomp gp (glift A s)) (gcomp s gp)
      (C.o (ctx x) (ctx y) (ctx g) (C.p (ctx g) a.1) L)
      (C.o (ctx x) (ctx d) (ctx g) f.1 (C.p (ctx d) as))
      (comp-down gp (glift A s) x y g (C.p (ctx g) a.1) L (p-down g a.1) (lift-down A s d g a.1 f.1 a.2 f.2))
      (comp-down s gp x d g f.1 (C.p (ctx d) as) f.2 (p-down d as)) (C.p-lift (ctx d) (ctx g) a.1 f.1) ;
 } ;

case-gq-lift-comp (T D G A s t : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjsub D s G)) (q : SoundJ (gjsub T t D)) :
    SoundJ (gjeqsub (gext T (gsb A (gcomp s t))) (glift A (gcomp s t)) (gcomp (glift A s) (glift (gsb A s) t)) (gext G A)) =
  (wx,(wz,at-contexts (gext T (gsb A (gcomp s t))) (gext G A)
    (\ d' g' -> SubEquality d' g' (glift A (gcomp s t)) (gcomp (glift A s) (glift (gsb A s) t)))
    wx wz at-canonical))
 where {
  e : Tel = q.1.1 ;
  d : Tel = p.1.1 ;
  g : Tel = r.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  f : SubValue d g s = p.2.2 d g p.1.2 r.1.2 ;
  k : SubValue e d t = q.2.2 e d q.1.2 p.1.2 ;
  fk : C.Sub (ctx e) (ctx g) = C.o (ctx e) (ctx d) (ctx g) f.1 k.1 ;
  hfk : SubDown (gcomp s t) e g fk = comp-down s t e d g f.1 k.1 f.2 k.2 ;
  B' : C.Ty (ctx d) = C.subT (ctx d) (ctx g) a.1 f.1 ;
  E : C.Ty (ctx e) = C.subT (ctx e) (ctx d) B' k.1 ;
  pE : Id (C.Ty (ctx e)) (C.subT (ctx e) (ctx g) a.1 fk) E = C.subT-o (ctx e) (ctx d) (ctx g) a.1 f.1 k.1 ;
  x : Tel = extend e E ;
  y : Tel = extend d B' ;
  z : Tel = extend g a.1 ;
  wx : CtxValue (gext T (gsb A (gcomp s t))) =
    extension-witness T (gsb A (gcomp s t)) e q.1.2 E
      (ty-move (gsb A (gcomp s t)) e (C.subT (ctx e) (ctx g) a.1 fk) E pE
        (ty-sub-down A (gcomp s t) e g a.1 fk a.2 hfk)) ;
  wz : CtxValue (gext G A) = extension-witness G A g r.1.2 a.1 a.2 ;
  Lf : C.Sub (ctx y) (ctx z) = C.lift (ctx d) (ctx g) a.1 f.1 ;
  Lk : C.Sub (ctx x) (ctx y) = C.lift (ctx e) (ctx d) B' k.1 ;
  Lfk : C.Sub (ctx x) (ctx z) = cast-lift e g a.1 fk E pE ;
  at-canonical : SubEquality x z (glift A (gcomp s t)) (gcomp (glift A s) (glift (gsb A s) t)) =
    same-sub x z (glift A (gcomp s t)) (gcomp (glift A s) (glift (gsb A s) t))
      Lfk (C.o (ctx x) (ctx y) (ctx z) Lf Lk)
      (lift-down-as A (gcomp s t) e g a.1 fk a.2 hfk E pE)
      (comp-down (glift A s) (glift (gsb A s) t) x y z Lf Lk (lift-down A s d g a.1 f.1 a.2 f.2)
        (lift-down (gsb A s) t e d B' k.1 (ty-sub-down A s d g a.1 f.1 a.2 f.2) k.2))
      (C.lift-o (ctx e) (ctx d) (ctx g) a.1 f.1 k.1) ;
 } ;

case-gq-sec-comp (D G A a s : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjtm G a A)) (p : SoundJ (gjsub D s G)) :
    SoundJ (gjeqsub D (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))) (gext G A)) =
  (p.1,(wg,\ d j hd hj -> at-context (gext G A)
    (\ z -> SubEquality d z (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))))
    wg (build d (p.2.2 d g hd r.1.2)) j hj))
 where {
  g : Tel = r.1.1 ;
  t : TermValue g A a = r.2 g r.1.2 ;
  y : Tel = extend g t.1 ;
  wg : CtxValue (gext G A) = extension-witness G A g r.1.2 t.1 t.2.1 ;
  sg : C.Sub (ctx g) (ctx y) = C.sec (ctx g) t.1 t.2.2.1 ;
  build (d : Tel) (f : SubValue d g s) :
      SubEquality d y (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))) =
    same-sub d y (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s)))
      (C.o (ctx d) (ctx g) (ctx y) sg f.1) (C.o (ctx d) (ctx x) (ctx y) L sd)
      (comp-down (gsec A a) s d g y sg f.1 (sec-down A a g t.1 t.2.2.1 t.2.1 t.2.2.2) f.2)
      (comp-down (glift A s) (gsec (gsb A s) (gsb a s)) d x y L sd (lift-down A s d g t.1 f.1 t.2.1 f.2)
        (sec-down (gsb A s) (gsb a s) d as u (ty-sub-down A s d g t.1 f.1 t.2.1 f.2)
          (tm-sub-down a s d g t.1 t.2.2.1 f.1 t.2.2.2 f.2)))
      (C.sec-o (ctx d) (ctx g) t.1 t.2.2.1 f.1)
   where {
    as : C.Ty (ctx d) = C.subT (ctx d) (ctx g) t.1 f.1 ;
    x : Tel = extend d as ;
    u : C.El (ctx d) as = C.subt (ctx d) (ctx g) t.1 t.2.2.1 f.1 ;
    L : C.Sub (ctx x) (ctx y) = C.lift (ctx d) (ctx g) t.1 f.1 ;
    sd : C.Sub (ctx d) (ctx x) = C.sec (ctx d) as u ;
   } ;
 } ;

case-gq-lift-p-sec-q (G A : GE) (r : SoundJ (gjty G A)) :
    SoundJ (gjeqsub (gext G A) (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid (gext G A)) =
  (w,(w,at-contexts (gext G A) (gext G A)
    (\ d g' -> SubEquality d g' (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid) w w at-canonical))
 where {
  g : Tel = r.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  w : CtxValue (gext G A) = extension-witness G A g r.1.2 a.1 a.2 ;
  x : Tel = w.1 ;
  ap' : C.Ty (ctx x) = q-type g a.1 ;
  y : Tel = extend x ap' ;
  px : C.Sub (ctx x) (ctx g) = C.p (ctx g) a.1 ;
  L : C.Sub (ctx y) (ctx x) = C.lift (ctx x) (ctx g) a.1 px ;
  S : C.Sub (ctx x) (ctx y) = C.sec (ctx x) ap' (C.q (ctx g) a.1) ;
  at-canonical : SubEquality x x (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid =
    same-sub x x (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid (C.o (ctx x) (ctx y) (ctx x) L S)
      (C.id (ctx x))
      (comp-down (glift A gp) (gsec (gsb A gp) gq) x y x L S
        (lift-down A gp x g a.1 px a.2 (p-down g a.1))
        (sec-down (gsb A gp) gq x ap' (C.q (ctx g) a.1)
          (ty-sub-down A gp x g a.1 px a.2 (p-down g a.1)) (q-down g a.1)))
      (id-down x) (C.lift-p-sec-q (ctx g) a.1) ;
 } ;

case-gm-q-lift (D G A s : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjsub D s G)) :
    SoundJ (gjeqtm (gext D (gsb A s)) (gsb gq (glift A s)) gq (gsb (gsb A s) gp)) =
  (w,at-context (gext D (gsb A s)) (\ j -> TermEquality j (gsb (gsb A s) gp) (gsb gq (glift A s)) gq)
    w at-canonical)
 where {
  g : Tel = r.1.1 ;
  d : Tel = p.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  f : SubValue d g s = p.2.2 d g p.1.2 r.1.2 ;
  As : C.Ty (ctx d) = C.subT (ctx d) (ctx g) a.1 f.1 ;
  hAs : TyDown (gsb A s) d As = ty-sub-down A s d g a.1 f.1 a.2 f.2 ;
  w : CtxValue (gext D (gsb A s)) = extension-witness D (gsb A s) d p.1.2 As hAs ;
  x : Tel = w.1 ;
  y : Tel = extend g a.1 ;
  L : C.Sub (ctx x) (ctx y) = C.lift (ctx d) (ctx g) a.1 f.1 ;
  A0 : C.Ty (ctx x) = C.subT (ctx x) (ctx y) (q-type g a.1) L ;
  t0 : C.El (ctx x) A0 = C.subt (ctx x) (ctx y) (q-type g a.1) (C.q (ctx g) a.1) L ;
  at-canonical : TermEquality x (gsb (gsb A s) gp) (gsb gq (glift A s)) gq =
    same-term x (gsb (gsb A s) gp) (gsb gq (glift A s)) gq (A0,t0) (q-type d As,C.q (ctx d) As)
      (ty-sub-down (gsb A s) gp x d As (C.p (ctx d) As) hAs (p-down d As))
      (tm-sub-down gq (glift A s) x y (q-type g a.1) (C.q (ctx g) a.1) L (q-down g a.1) (lift-down A s d g a.1 f.1 a.2 f.2))
      (q-down d As)
      (term-path x A0 (q-type d As) t0 (C.q (ctx d) As) (C.p-lift-T (ctx d) (ctx g) a.1 a.1 f.1)
        (C.q-lift (ctx d) (ctx g) a.1 f.1)) ;
 } ;

case-gm-q-sec (G A a : GE) (w : SoundJ (gjty G A)) (r : SoundJ (gjtm G a A)) :
    SoundJ (gjeqtm G (gsb gq (gsec A a)) a A) =
  (r.1,\ g hg -> build g (r.2 g hg))
 where {
  build (g : Tel) (t : TermValue g A a) : TermEquality g A (gsb gq (gsec A a)) a =
    same-term g A (gsb gq (gsec A a)) a (B',v) (t.1,t.2.2.1) t.2.1
      (tm-sub-down gq (gsec A a) g x (q-type g t.1) (C.q (ctx g) t.1) f (q-down g t.1)
        (sec-down A a g t.1 t.2.2.1 t.2.1 t.2.2.2)) t.2.2.2
      (term-path g B' t.1 v t.2.2.1 (C.p-sec-T (ctx g) t.1 t.1 t.2.2.1) (C.q-sec (ctx g) t.1 t.2.2.1))
   where {
    x : Tel = extend g t.1 ;
    f : C.Sub (ctx g) (ctx x) = C.sec (ctx g) t.1 t.2.2.1 ;
    B' : C.Ty (ctx g) = C.subT (ctx g) (ctx x) (q-type g t.1) f ;
    v : C.El (ctx g) B' = C.subt (ctx g) (ctx x) (q-type g t.1) (C.q (ctx g) t.1) f ;
   } ;
 } ;
