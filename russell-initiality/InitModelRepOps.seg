-- InitModelRepOps.seg (PLAN-INIT, Part A): every operation of the term
-- model on normalised representatives (InitModelRep): the representative
-- of the result is the evident raw expression over the given raw
-- contexts, with the evident GDer rule; the path is F's beta lemma.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitModelRep[l] ;

------------------------------------------------------------------------
-- contexts

nil-cp : CP nil = (gnil, (g-nil, refl nil)) ;

ext-cp (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) : CP (ext c A) =
  (gext g.1 x.1, (g-ext g.1 x.1 x.2.1,
    ext-beta' c A (toRT c g A x) (pf (gjwf (gext g.1 x.1)) (g-ext g.1 x.1 x.2.1)))) ;

------------------------------------------------------------------------
-- substitutions

id-n (c : Ctx) (g : CP c) : NS c c g g (id c) =
  (gid, (gs-id g.1 g.2.1,
    sym (Sub c c) (id c) (clS c c g g gid (gs-id g.1 g.2.1))
      (id-beta c g.1 g.1 (pf (gjsub g.1 gid g.1) (gs-id g.1 g.2.1)) (cpw c g) (cpw c g) g.2.2 g.2.2))) ;

eps-n (c : Ctx) (g : CP c) : NS c nil g nil-cp (eps c) =
  (geps, (gs-eps g.1 g.2.1,
    sym (Sub c nil) (eps c) (clS c nil g nil-cp geps (gs-eps g.1 g.2.1))
      (eps-beta c g.1 gnil (pf (gjsub g.1 geps gnil) (gs-eps g.1 g.2.1)) (cpw c g) (cpw nil nil-cp) g.2.2 (refl nil)))) ;

o-n (t d c : Ctx) (gt : CP t) (gd : CP d) (gc : CP c) (s : Sub d c) (s' : Sub t d)
  (u : NS d c gd gc s) (u' : NS t d gt gd s') : NS t c gt gc (o t d c s s') =
  (gcomp u.1 u'.1, (gs-comp gt.1 gd.1 gc.1 u.1 u'.1 u.2.1 u'.2.1,
    sym (Sub t c) (o t d c s s') (clS t c gt gc (gcomp u.1 u'.1) (gs-comp gt.1 gd.1 gc.1 u.1 u'.1 u.2.1 u'.2.1))
      (o-beta t d c s s' (toRS d c gd gc s u) (toRS t d gt gd s' u') gt.1 gc.1
        (pf (gjsub gt.1 (gcomp u.1 u'.1) gc.1) (gs-comp gt.1 gd.1 gc.1 u.1 u'.1 u.2.1 u'.2.1))
        (cpw t gt) (cpw c gc) gt.2.2 gc.2.2))) ;

subT-n (d c : Ctx) (gd : CP d) (gc : CP c) (A : Ty c) (s : Sub d c) (x : NT c gc A) (u : NS d c gd gc s) :
  NT d gd (subT d c A s) =
  (gsb x.1 u.1, (gt-sb gd.1 gc.1 x.1 u.1 x.2.1 u.2.1,
    subT-beta' d c A s (toRT c gc A x) (toRS d c gd gc s u) gd.1
      (pf (gjty gd.1 (gsb x.1 u.1)) (gt-sb gd.1 gc.1 x.1 u.1 x.2.1 u.2.1)) (cpw d gd) gd.2.2)) ;

subt-n (d c : Ctx) (gd : CP d) (gc : CP c) (A : Ty c) (s : Sub d c) (x : NT c gc A) (t : El c A)
  (y : NE c gc A x t) (u : NS d c gd gc s) : NE d gd (subT d c A s) (subT-n d c gd gc A s x u) (subt d c A t s) =
  (gsb y.1 u.1, (gm-sb gd.1 gc.1 y.1 x.1 u.1 x.2.1 y.2.1 u.2.1,
    sym (El d (subT d c A s)) (subt d c A t s)
      (clE d gd (subT d c A s) (subT-n d c gd gc A s x u) (gsb y.1 u.1) (gm-sb gd.1 gc.1 y.1 x.1 u.1 x.2.1 y.2.1 u.2.1))
      (subt-beta d c A t s (toRE c gc A x t y) (toRS d c gd gc s u) gd.1 (gsb x.1 u.1)
        (pf (gjtm gd.1 (gsb y.1 u.1) (gsb x.1 u.1)) (gm-sb gd.1 gc.1 y.1 x.1 u.1 x.2.1 y.2.1 u.2.1))
        (pf (gjty gd.1 (gsb x.1 u.1)) (gt-sb gd.1 gc.1 x.1 u.1 x.2.1 u.2.1))
        (cpw d gd) gd.2.2 (subT-n d c gd gc A s x u).2.2))) ;

p-n (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) : NS (ext c A) c (ext-cp c g A x) g (p c A) =
  (gp, (gs-p g.1 x.1 x.2.1,
    sym (Sub (ext c A) c) (p c A) (clS (ext c A) c (ext-cp c g A x) g gp (gs-p g.1 x.1 x.2.1))
      (p-beta c A (gext g.1 x.1) g.1 (pf (gjsub (gext g.1 x.1) gp g.1) (gs-p g.1 x.1 x.2.1))
        (cpw (ext c A) (ext-cp c g A x)) (cpw c g) (ext-cp c g A x).2.2 g.2.2))) ;

q-n (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) :
  NE (ext c A) (ext-cp c g A x) (subT (ext c A) c A (p c A))
    (subT-n (ext c A) c (ext-cp c g A x) g A (p c A) x (p-n c g A x)) (q c A) =
  (gq, (gm-q g.1 x.1 x.2.1,
    sym (El (ext c A) (subT (ext c A) c A (p c A))) (q c A)
      (clE (ext c A) (ext-cp c g A x) (subT (ext c A) c A (p c A))
        (subT-n (ext c A) c (ext-cp c g A x) g A (p c A) x (p-n c g A x)) gq (gm-q g.1 x.1 x.2.1))
      (q-beta c A (gext g.1 x.1) (gsb x.1 gp) (pf (gjtm (gext g.1 x.1) gq (gsb x.1 gp)) (gm-q g.1 x.1 x.2.1))
        (pf (gjty (gext g.1 x.1) (gsb x.1 gp)) (subT-n (ext c A) c (ext-cp c g A x) g A (p c A) x (p-n c g A x)).2.1)
        (cpw (ext c A) (ext-cp c g A x)) (ext-cp c g A x).2.2
        (subT-n (ext c A) c (ext-cp c g A x) g A (p c A) x (p-n c g A x)).2.2))) ;

lift-n (d c : Ctx) (gd : CP d) (gc : CP c) (A : Ty c) (s : Sub d c) (x : NT c gc A) (u : NS d c gd gc s) :
  NS (ext d (subT d c A s)) (ext c A) (ext-cp d gd (subT d c A s) (subT-n d c gd gc A s x u)) (ext-cp c gc A x)
    (lift d c A s) =
  (glift x.1 u.1, (gs-lift gd.1 gc.1 x.1 u.1 u.2.1 x.2.1,
    sym (Sub (ext d (subT d c A s)) (ext c A)) (lift d c A s)
      (clS (ext d (subT d c A s)) (ext c A) (ext-cp d gd (subT d c A s) (subT-n d c gd gc A s x u)) (ext-cp c gc A x)
        (glift x.1 u.1) (gs-lift gd.1 gc.1 x.1 u.1 u.2.1 x.2.1))
      (lift-beta d c A s (toRT c gc A x) (toRS d c gd gc s u) (gext gd.1 (gsb x.1 u.1)) (gext gc.1 x.1)
        (pf (gjsub (gext gd.1 (gsb x.1 u.1)) (glift x.1 u.1) (gext gc.1 x.1)) (gs-lift gd.1 gc.1 x.1 u.1 u.2.1 x.2.1))
        (cpw (ext d (subT d c A s)) (ext-cp d gd (subT d c A s) (subT-n d c gd gc A s x u)))
        (cpw (ext c A) (ext-cp c gc A x))
        (ext-cp d gd (subT d c A s) (subT-n d c gd gc A s x u)).2.2 (ext-cp c gc A x).2.2))) ;

sec-n (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) (t : El c A) (y : NE c g A x t) :
  NS c (ext c A) g (ext-cp c g A x) (sec c A t) =
  (gsec x.1 y.1, (gs-sec g.1 x.1 y.1 x.2.1 y.2.1,
    sym (Sub c (ext c A)) (sec c A t) (clS c (ext c A) g (ext-cp c g A x) (gsec x.1 y.1) (gs-sec g.1 x.1 y.1 x.2.1 y.2.1))
      (sec-beta c A t (toRE c g A x t y) g.1 (gext g.1 x.1)
        (pf (gjsub g.1 (gsec x.1 y.1) (gext g.1 x.1)) (gs-sec g.1 x.1 y.1 x.2.1 y.2.1))
        (cpw c g) (cpw (ext c A) (ext-cp c g A x)) g.2.2 (ext-cp c g A x).2.2))) ;

------------------------------------------------------------------------
-- products

Pi-n (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) (T : Ty (ext c A)) (z : NT (ext c A) (ext-cp c g A x) T) :
  NT c g (Pi c A T) =
  (gpi x.1 z.1, (gt-pi g.1 x.1 z.1 x.2.1 z.2.1,
    sym (Ty c) (Pi c A T) (clT c g (gpi x.1 z.1) (gt-pi g.1 x.1 z.1 x.2.1 z.2.1))
      (Pi-beta c A T (toRT c g A x) (toRT (ext c A) (ext-cp c g A x) T z) g.1
        (pf (gjty g.1 (gpi x.1 z.1)) (gt-pi g.1 x.1 z.1 x.2.1 z.2.1)) (cpw c g) g.2.2))) ;

pi-inv-n (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) (T : Ty (ext c A)) (z : NT (ext c A) (ext-cp c g A x) T)
  (t : El (ext c A) T) (y : NE (ext c A) (ext-cp c g A x) T z t) :
  NE c g (Pi c A T) (Pi-n c g A x T z) (pi-inv c A T t) =
  (glam x.1 z.1 y.1, (gm-lam g.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1,
    sym (El c (Pi c A T)) (pi-inv c A T t)
      (clE c g (Pi c A T) (Pi-n c g A x T z) (glam x.1 z.1 y.1) (gm-lam g.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1))
      (pi-inv-beta c A T t (toRT c g A x) (toRT (ext c A) (ext-cp c g A x) T z) (toRE (ext c A) (ext-cp c g A x) T z t y)
        g.1 (gpi x.1 z.1) (pf (gjtm g.1 (glam x.1 z.1 y.1) (gpi x.1 z.1)) (gm-lam g.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1))
        (pf (gjty g.1 (gpi x.1 z.1)) (gt-pi g.1 x.1 z.1 x.2.1 z.2.1)) (cpw c g) g.2.2 (Pi-n c g A x T z).2.2))) ;

pi-fun-n (c : Ctx) (g : CP c) (A : Ty c) (x : NT c g A) (T : Ty (ext c A)) (z : NT (ext c A) (ext-cp c g A x) T)
  (f : El c (Pi c A T)) (y : NE c g (Pi c A T) (Pi-n c g A x T z) f) :
  NE (ext c A) (ext-cp c g A x) T z (pi-fun c A T f) =
  (app-q x.1 z.1 y.1, (app-q-der g.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1,
    sym (El (ext c A) T) (pi-fun c A T f)
      (clE (ext c A) (ext-cp c g A x) T z (app-q x.1 z.1 y.1) (app-q-der g.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1))
      (pi-fun-beta c A T f (toRT c g A x) (toRT (ext c A) (ext-cp c g A x) T z) (toRE c g (Pi c A T) (Pi-n c g A x T z) f y)
        (gext g.1 x.1) z.1 (pf (gjtm (gext g.1 x.1) (app-q x.1 z.1 y.1) z.1) (app-q-der g.1 x.1 z.1 y.1 x.2.1 z.2.1 y.2.1))
        (pf (gjty (gext g.1 x.1) z.1) z.2.1) (cpw (ext c A) (ext-cp c g A x)) (ext-cp c g A x).2.2 z.2.2))) ;

------------------------------------------------------------------------
-- universes

univ-n (n : EM.LevelAt N) (c : Ctx) (g : CP c) : NT c g (univ n c) =
  (guu n.1, (gt-uu g.1 n.1 g.2.1 n.2,
    sym (Ty c) (univ n c) (clT c g (guu n.1) (gt-uu g.1 n.1 g.2.1 n.2))
      (univ-beta n c g.1 (pf (gjty g.1 (guu n.1)) (gt-uu g.1 n.1 g.2.1 n.2)) (cpw c g) g.2.2))) ;

-- a code over the normal representative of the universe
NC (n : EM.LevelAt N) (c : Ctx) (g : CP c) (a : El c (univ n c)) : U l = NE c g (univ n c) (univ-n n c g) a ;

decode-n (n : EM.LevelAt N) (c : Ctx) (g : CP c) (a : El c (univ n c)) (y : NC n c g a) : NT c g (decode n c a) =
  (gel n.1 y.1, (gt-el g.1 n.1 y.1 y.2.1,
    sym (Ty c) (decode n c a) (clT c g (gel n.1 y.1) (gt-el g.1 n.1 y.1 y.2.1))
      (decode-beta n c a (toRE c g (univ n c) (univ-n n c g) a y) g.1
        (pf (gjty g.1 (gel n.1 y.1)) (gt-el g.1 n.1 y.1 y.2.1)) (cpw c g) g.2.2))) ;

dext-cp (n : EM.LevelAt N) (c : Ctx) (g : CP c) (a : El c (univ n c)) (y : NC n c g a) : CP (ext c (decode n c a)) =
  ext-cp c g (decode n c a) (decode-n n c g a y) ;

pic-n (n : EM.LevelAt N) (c : Ctx) (g : CP c) (a : El c (univ n c)) (y : NC n c g a)
  (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) (y' : NC n (ext c (decode n c a)) (dext-cp n c g a y) b) :
  NC n c g (pic n c a b) =
  (gpic n.1 y.1 y'.1, (gm-pic g.1 n.1 y.1 y'.1 y.2.1 y'.2.1,
    sym (El c (univ n c)) (pic n c a b)
      (clE c g (univ n c) (univ-n n c g) (gpic n.1 y.1 y'.1) (gm-pic g.1 n.1 y.1 y'.1 y.2.1 y'.2.1))
      (pic-beta n c a b (toRE c g (univ n c) (univ-n n c g) a y)
        (toRE (ext c (decode n c a)) (dext-cp n c g a y) (univ n (ext c (decode n c a)))
          (univ-n n (ext c (decode n c a)) (dext-cp n c g a y)) b y')
        g.1 (guu n.1) (pf (gjtm g.1 (gpic n.1 y.1 y'.1) (guu n.1)) (gm-pic g.1 n.1 y.1 y'.1 y.2.1 y'.2.1))
        (pf (gjty g.1 (guu n.1)) (gt-uu g.1 n.1 g.2.1 n.2)) (cpw c g) g.2.2 (univ-n n c g).2.2))) ;

uc-n (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (g : CP c) : NC n c g (uc m n lt c) =
  (guc m.1 n.1, (gm-uc g.1 m.1 n.1 g.2.1 lt n.2,
    sym (El c (univ n c)) (uc m n lt c)
      (clE c g (univ n c) (univ-n n c g) (guc m.1 n.1) (gm-uc g.1 m.1 n.1 g.2.1 lt n.2))
      (uc-beta m n lt c g.1 (guu n.1) (pf (gjtm g.1 (guc m.1 n.1) (guu n.1)) (gm-uc g.1 m.1 n.1 g.2.1 lt n.2))
        (pf (gjty g.1 (guu n.1)) (gt-uu g.1 n.1 g.2.1 n.2)) (cpw c g) g.2.2 (univ-n n c g).2.2))) ;

lf-n (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (g : CP c) (a : El c (univ m c)) (y : NC m c g a) :
  NC n c g (lf m n lt c a) =
  (glf m.1 n.1 y.1, (gm-lf g.1 m.1 n.1 y.1 y.2.1 lt n.2,
    sym (El c (univ n c)) (lf m n lt c a)
      (clE c g (univ n c) (univ-n n c g) (glf m.1 n.1 y.1) (gm-lf g.1 m.1 n.1 y.1 y.2.1 lt n.2))
      (lf-beta m n lt c a (toRE c g (univ m c) (univ-n m c g) a y) g.1 (guu n.1)
        (pf (gjtm g.1 (glf m.1 n.1 y.1) (guu n.1)) (gm-lf g.1 m.1 n.1 y.1 y.2.1 lt n.2))
        (pf (gjty g.1 (guu n.1)) (gt-uu g.1 n.1 g.2.1 n.2)) (cpw c g) g.2.2 (univ-n n c g).2.2))) ;
