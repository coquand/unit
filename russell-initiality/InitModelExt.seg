-- InitModelExt.seg (PLAN-INIT, Part A): the comprehension laws of the
-- term model (fields lift-id lift-o p-lift p-sec sec-o lift-p-sec-q q-lift
-- q-sec of CwF).  Fields with a transport are proved for an ARBITRARY
-- path of types (-gen); the record instance (InitModel.seg) passes the
-- path required by the field.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module GP = B.GPresup[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitModelRep[l] ;
open InitModelRepOps[l] ;

lift-id-gen (c : Ctx) (A : Ty c) (e : Id (Ty c) (subT c c A (id c)) A) :
  Id (Sub (ext c A) (ext c A))
     (subst (Ty c) (\ B -> Sub (ext c B) (ext c A)) (subT c c A (id c)) A e (lift c c A (id c)))
     (id (ext c A)) =
  with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x ->
    ns-eq (ext c A) (ext c A)
      (cp-tr (Ty c) (\ B -> ext c B) (subT c c A (id c)) A e
        (ext-cp c cc (subT c c A (id c)) (subT-n c c cc cc A (id c) x (id-n c cc))))
      (cp-tr (Ty c) (\ B -> ext c A) (subT c c A (id c)) A e (ext-cp c cc A x))
      (ext-cp c cc A x) (ext-cp c cc A x)
      (subst (Ty c) (\ B -> Sub (ext c B) (ext c A)) (subT c c A (id c)) A e (lift c c A (id c)))
      (id (ext c A))
      (ns-subst (Ty c) (\ B -> ext c B) (\ B -> ext c A) (subT c c A (id c)) A e
        (ext-cp c cc (subT c c A (id c)) (subT-n c c cc cc A (id c) x (id-n c cc))) (ext-cp c cc A x)
        (lift c c A (id c)) (lift-n c c cc cc A (id c) x (id-n c cc)))
      (id-n (ext c A) (ext-cp c cc A x))
      (gq-lift-id cc.1 x.1 x.2.1)))
 where {
  P : U l = Id (Sub (ext c A) (ext c A))
     (subst (Ty c) (\ B -> Sub (ext c B) (ext c A)) (subT c c A (id c)) A e (lift c c A (id c))) (id (ext c A)) ;
  pP : isProp P = isSetSub (ext c A) (ext c A)
     (subst (Ty c) (\ B -> Sub (ext c B) (ext c A)) (subT c c A (id c)) A e (lift c c A (id c))) (id (ext c A)) ;
 } ;

module LiftO (t d c : Ctx) (A : Ty c) (s : Sub d c) (s' : Sub t d)
  (e : Id (Ty t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s')) {
  X : Ty t = subT t c A (o t d c s s') ;
  Y : Ty t = subT t d (subT d c A s) s' ;
  lhs : Sub (ext t Y) (ext c A) = subst (Ty t) (\ B -> Sub (ext t B) (ext c A)) X Y e (lift t c A (o t d c s s')) ;
  rhs : Sub (ext t Y) (ext c A) =
    o (ext t Y) (ext d (subT d c A s)) (ext c A) (lift d c A s) (lift t d (subT d c A s) s') ;
  P : U l = Id (Sub (ext t Y) (ext c A)) lhs rhs ;
  pP : isProp P = isSetSub (ext t Y) (ext c A) lhs rhs ;
  at (ct : CP t) (cd : CP d) (cc : CP c) (x : NT c cc A) (u : NS d c cd cc s) (u' : NS t d ct cd s') : P =
    ns-eq (ext t Y) (ext c A)
      (cp-tr (Ty t) (\ B -> ext t B) X Y e (ext-cp t ct X (subT-n t c ct cc A (o t d c s s') x uo)))
      (cp-tr (Ty t) (\ B -> ext c A) X Y e (ext-cp c cc A x))
      (ext-cp t ct Y (subT-n t d ct cd (subT d c A s) s' xs u')) (ext-cp c cc A x)
      lhs rhs
      (ns-subst (Ty t) (\ B -> ext t B) (\ B -> ext c A) X Y e
        (ext-cp t ct X (subT-n t c ct cc A (o t d c s s') x uo)) (ext-cp c cc A x)
        (lift t c A (o t d c s s')) (lift-n t c ct cc A (o t d c s s') x uo))
      (o-n (ext t Y) (ext d (subT d c A s)) (ext c A)
        (ext-cp t ct Y (subT-n t d ct cd (subT d c A s) s' xs u')) (ext-cp d cd (subT d c A s) xs) (ext-cp c cc A x)
        (lift d c A s) (lift t d (subT d c A s) s') (lift-n d c cd cc A s x u)
        (lift-n t d ct cd (subT d c A s) s' xs u'))
      (gq-lift-comp ct.1 cd.1 cc.1 x.1 u.1 u'.1 x.2.1 u.2.1 u'.2.1)
   where {
    uo : NS t c ct cc (o t d c s s') = o-n t d c ct cd cc s s' u u' ;
    xs : NT d cd (subT d c A s) = subT-n d c cd cc A s x u ;
   } ;
  proof : P =
    with-cp t P pP (\ ct -> with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
    with-nt c cc A P pP (\ x -> with-ns d c cd cc s P pP (\ u -> with-ns t d ct cd s' P pP (\ u' ->
      at ct cd cc x u u')))))) ;
} ;

lift-o-gen (t d c : Ctx) (A : Ty c) (s : Sub d c) (s' : Sub t d)
  (e : Id (Ty t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s')) :
  Id (Sub (ext t (subT t d (subT d c A s) s')) (ext c A))
     (subst (Ty t) (\ B -> Sub (ext t B) (ext c A)) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') e
       (lift t c A (o t d c s s')))
     (o (ext t (subT t d (subT d c A s) s')) (ext d (subT d c A s)) (ext c A) (lift d c A s) (lift t d (subT d c A s) s')) =
  LiftO[t,d,c,A,s,s',e].proof ;

p-lift (d c : Ctx) (A : Ty c) (s : Sub d c) :
  Id (Sub (ext d (subT d c A s)) c)
     (o (ext d (subT d c A s)) (ext c A) c (p c A) (lift d c A s))
     (o (ext d (subT d c A s)) d c s (p d (subT d c A s))) =
  with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
  with-nt c cc A P pP (\ x -> with-ns d c cd cc s P pP (\ u ->
    ns-eq (ext d (subT d c A s)) c
      (ext-cp d cd (subT d c A s) (subT-n d c cd cc A s x u)) cc
      (ext-cp d cd (subT d c A s) (subT-n d c cd cc A s x u)) cc
      (o (ext d (subT d c A s)) (ext c A) c (p c A) (lift d c A s))
      (o (ext d (subT d c A s)) d c s (p d (subT d c A s)))
      (o-n (ext d (subT d c A s)) (ext c A) c (ext-cp d cd (subT d c A s) (subT-n d c cd cc A s x u))
        (ext-cp c cc A x) cc (p c A) (lift d c A s) (p-n c cc A x) (lift-n d c cd cc A s x u))
      (o-n (ext d (subT d c A s)) d c (ext-cp d cd (subT d c A s) (subT-n d c cd cc A s x u)) cd cc
        s (p d (subT d c A s)) u (p-n d cd (subT d c A s) (subT-n d c cd cc A s x u)))
      (gq-p-lift cd.1 cc.1 x.1 u.1 x.2.1 u.2.1)))))
 where {
  P : U l = Id (Sub (ext d (subT d c A s)) c)
     (o (ext d (subT d c A s)) (ext c A) c (p c A) (lift d c A s))
     (o (ext d (subT d c A s)) d c s (p d (subT d c A s))) ;
  pP : isProp P = isSetSub (ext d (subT d c A s)) c
     (o (ext d (subT d c A s)) (ext c A) c (p c A) (lift d c A s))
     (o (ext d (subT d c A s)) d c s (p d (subT d c A s))) ;
 } ;

p-sec (c : Ctx) (A : Ty c) (a : El c A) : Id (Sub c c) (o c (ext c A) c (p c A) (sec c A a)) (id c) =
  with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x -> with-ne c cc A x a P pP (\ y ->
    ns-eq c c cc cc cc cc (o c (ext c A) c (p c A) (sec c A a)) (id c)
      (o-n c (ext c A) c cc (ext-cp c cc A x) cc (p c A) (sec c A a) (p-n c cc A x) (sec-n c cc A x a y))
      (id-n c cc)
      (gq-p-sec cc.1 x.1 y.1 x.2.1 y.2.1))))
 where {
  P : U l = Id (Sub c c) (o c (ext c A) c (p c A) (sec c A a)) (id c) ;
  pP : isProp P = isSetSub c c (o c (ext c A) c (p c A) (sec c A a)) (id c) ;
 } ;

sec-o (d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) :
  Id (Sub d (ext c A)) (o d c (ext c A) (sec c A a) s)
     (o d (ext d (subT d c A s)) (ext c A) (lift d c A s) (sec d (subT d c A s) (subt d c A a s))) =
  with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
  with-nt c cc A P pP (\ x -> with-ne c cc A x a P pP (\ y -> with-ns d c cd cc s P pP (\ u ->
    ns-eq d (ext c A) cd (ext-cp c cc A x) cd (ext-cp c cc A x)
      (o d c (ext c A) (sec c A a) s)
      (o d (ext d (subT d c A s)) (ext c A) (lift d c A s) (sec d (subT d c A s) (subt d c A a s)))
      (o-n d c (ext c A) cd cc (ext-cp c cc A x) (sec c A a) s (sec-n c cc A x a y) u)
      (o-n d (ext d (subT d c A s)) (ext c A) cd (ext-cp d cd (subT d c A s) (subT-n d c cd cc A s x u)) (ext-cp c cc A x)
        (lift d c A s) (sec d (subT d c A s) (subt d c A a s)) (lift-n d c cd cc A s x u)
        (sec-n d cd (subT d c A s) (subT-n d c cd cc A s x u) (subt d c A a s) (subt-n d c cd cc A s x a y u)))
      (gq-sec-comp cd.1 cc.1 x.1 y.1 u.1 x.2.1 y.2.1 u.2.1))))))
 where {
  P : U l = Id (Sub d (ext c A)) (o d c (ext c A) (sec c A a) s)
     (o d (ext d (subT d c A s)) (ext c A) (lift d c A s) (sec d (subT d c A s) (subt d c A a s))) ;
  pP : isProp P = isSetSub d (ext c A) (o d c (ext c A) (sec c A a) s)
     (o d (ext d (subT d c A s)) (ext c A) (lift d c A s) (sec d (subT d c A s) (subt d c A a s))) ;
 } ;

module LPSQ (c : Ctx) (A : Ty c) {
  E : Ctx = ext c A ;
  T : Ty E = subT E c A (p c A) ;
  lhs : Sub E E = o E (ext E T) E (lift E c A (p c A)) (sec E T (q c A)) ;
  P : U l = Id (Sub E E) lhs (id E) ;
  pP : isProp P = isSetSub E E lhs (id E) ;
  at (cc : CP c) (x : NT c cc A) : P =
    ns-eq E E cE cE cE cE lhs (id E)
      (o-n E (ext E T) E cE (ext-cp E cE T xs) cE (lift E c A (p c A)) (sec E T (q c A))
        (lift-n E c cE cc A (p c A) x (p-n c cc A x)) (sec-n E cE T xs (q c A) (q-n c cc A x)))
      (id-n E cE)
      (gq-lift-p-sec-q cc.1 x.1 x.2.1)
   where {
    cE : CP E = ext-cp c cc A x ;
    xs : NT E cE T = subT-n E c cE cc A (p c A) x (p-n c cc A x) ;
   } ;
  proof : P = with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x -> at cc x)) ;
} ;

lift-p-sec-q (c : Ctx) (A : Ty c) :
  Id (Sub (ext c A) (ext c A))
     (o (ext c A) (ext (ext c A) (subT (ext c A) c A (p c A))) (ext c A)
        (lift (ext c A) c A (p c A)) (sec (ext c A) (subT (ext c A) c A (p c A)) (q c A)))
     (id (ext c A)) = LPSQ[c,A].proof ;

------------------------------------------------------------------------
-- the variable

module QLift (d c : Ctx) (A : Ty c) (s : Sub d c) {
  E1 : Ctx = ext d (subT d c A s) ;
  X : Ty E1 = subT E1 (ext c A) (subT (ext c A) c A (p c A)) (lift d c A s) ;
  Y : Ty E1 = subT E1 d (subT d c A s) (p d (subT d c A s)) ;
  module Gen (e : Id (Ty E1) X Y) {
    lhs : El E1 Y = subst (Ty E1) (El E1) X Y e (subt E1 (ext c A) (subT (ext c A) c A (p c A)) (q c A) (lift d c A s)) ;
    P : U l = Id (El E1 Y) lhs (q d (subT d c A s)) ;
    pP : isProp P = isSetEl E1 Y lhs (q d (subT d c A s)) ;
    at (cd : CP d) (cc : CP c) (x : NT c cc A) (u : NS d c cd cc s) : P =
      ne-eq E1 cE1 cE1 Y (nt-tr E1 cE1 X Y xX e) (subT-n E1 d cE1 cd (subT d c A s) (p d (subT d c A s)) xS (p-n d cd (subT d c A s) xS))
        lhs (q d (subT d c A s))
        (ne-subst E1 cE1 X Y e xX (subt E1 (ext c A) (subT (ext c A) c A (p c A)) (q c A) (lift d c A s))
          (subt-n E1 (ext c A) cE1 cE (subT (ext c A) c A (p c A)) (lift d c A s) xs (q c A) (q-n c cc A x) ul))
        (q-n d cd (subT d c A s) xS)
        (gm-eqconv cE1.1 (gsb gq (glift x.1 u.1)) gq (gsb (gsb x.1 u.1) gp) (gsb (gsb x.1 gp) (glift x.1 u.1))
          (gm-q-lift cd.1 cc.1 x.1 u.1 x.2.1 u.2.1)
          (ge-sym cE1.1 (gsb (gsb x.1 gp) (glift x.1 u.1)) (gsb (gsb x.1 u.1) gp) (GP.sb-p-lift cd.1 cc.1 x.1 u.1 x.2.1 u.2.1)))
     where {
      xS : NT d cd (subT d c A s) = subT-n d c cd cc A s x u ;
      cE1 : CP E1 = ext-cp d cd (subT d c A s) xS ;
      cE : CP (ext c A) = ext-cp c cc A x ;
      xs : NT (ext c A) cE (subT (ext c A) c A (p c A)) = subT-n (ext c A) c cE cc A (p c A) x (p-n c cc A x) ;
      ul : NS E1 (ext c A) cE1 cE (lift d c A s) = lift-n d c cd cc A s x u ;
      xX : NT E1 cE1 X = subT-n E1 (ext c A) cE1 cE (subT (ext c A) c A (p c A)) (lift d c A s) xs ul ;
     } ;
    proof : P =
      with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
      with-nt c cc A P pP (\ x -> with-ns d c cd cc s P pP (\ u -> at cd cc x u)))) ;
  } ;
} ;

q-lift-gen (d c : Ctx) (A : Ty c) (s : Sub d c)
  (e : Id (Ty (ext d (subT d c A s)))
         (subT (ext d (subT d c A s)) (ext c A) (subT (ext c A) c A (p c A)) (lift d c A s))
         (subT (ext d (subT d c A s)) d (subT d c A s) (p d (subT d c A s)))) :
  Id (El (ext d (subT d c A s)) (subT (ext d (subT d c A s)) d (subT d c A s) (p d (subT d c A s))))
     (subst (Ty (ext d (subT d c A s))) (El (ext d (subT d c A s)))
            (subT (ext d (subT d c A s)) (ext c A) (subT (ext c A) c A (p c A)) (lift d c A s))
            (subT (ext d (subT d c A s)) d (subT d c A s) (p d (subT d c A s)))
            e
            (subt (ext d (subT d c A s)) (ext c A) (subT (ext c A) c A (p c A)) (q c A) (lift d c A s)))
     (q d (subT d c A s)) = QLift[d,c,A,s].Gen[e].proof ;

module QSec (c : Ctx) (A : Ty c) (a : El c A) {
  X : Ty c = subT c (ext c A) (subT (ext c A) c A (p c A)) (sec c A a) ;
  module Gen (e : Id (Ty c) X A) {
    lhs : El c A = subst (Ty c) (El c) X A e (subt c (ext c A) (subT (ext c A) c A (p c A)) (q c A) (sec c A a)) ;
    P : U l = Id (El c A) lhs a ;
    pP : isProp P = isSetEl c A lhs a ;
    at (cc : CP c) (x : NT c cc A) (y : NE c cc A x a) : P =
      ne-eq c cc cc A (nt-tr c cc X A xX e) x lhs a
        (ne-subst c cc X A e xX (subt c (ext c A) (subT (ext c A) c A (p c A)) (q c A) (sec c A a))
          (subt-n c (ext c A) cc cE (subT (ext c A) c A (p c A)) (sec c A a) xs (q c A) (q-n c cc A x) us))
        y
        (gm-eqconv cc.1 (gsb gq (gsec x.1 y.1)) y.1 x.1 (gsb (gsb x.1 gp) (gsec x.1 y.1))
          (gm-q-sec cc.1 x.1 y.1 x.2.1 y.2.1)
          (ge-sym cc.1 (gsb (gsb x.1 gp) (gsec x.1 y.1)) x.1 (GP.sb-p-sec cc.1 x.1 y.1 cc.2.1 x.2.1 y.2.1)))
     where {
      cE : CP (ext c A) = ext-cp c cc A x ;
      xs : NT (ext c A) cE (subT (ext c A) c A (p c A)) = subT-n (ext c A) c cE cc A (p c A) x (p-n c cc A x) ;
      us : NS c (ext c A) cc cE (sec c A a) = sec-n c cc A x a y ;
      xX : NT c cc X = subT-n c (ext c A) cc cE (subT (ext c A) c A (p c A)) (sec c A a) xs us ;
     } ;
    proof : P = with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x -> with-ne c cc A x a P pP (\ y -> at cc x y))) ;
  } ;
} ;

q-sec-gen (c : Ctx) (A : Ty c) (a : El c A)
  (e : Id (Ty c) (subT c (ext c A) (subT (ext c A) c A (p c A)) (sec c A a)) A) :
  Id (El c A)
     (subst (Ty c) (El c) (subT c (ext c A) (subT (ext c A) c A (p c A)) (sec c A a)) A e
            (subt c (ext c A) (subT (ext c A) c A (p c A)) (q c A) (sec c A a)))
     a = QSec[c,A,a].Gen[e].proof ;
