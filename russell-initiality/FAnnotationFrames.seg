-- Right-hand typings for single-coordinate annotation congruences.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FSubstLaws[l] ;

pi-context-frame {G H A B : FA} (e : CE G H) (r : FPJ (fjeqcx G H)) (hA : Ty G A)
    (hB : Ty (fext G A) B) : FPJ (fjeqty G (fpi G A B) (fpi H A B)) =
  (r.1,(pi-ty hA hB,ty-cx r.1 r.2.2 (pi-ty hA' (ty-cx (ext-wf hA') (ext-eq e (ty-refl hA)) hB))))
 where { hA' : Ty H A = ty-cx r.2.1 e hA ; } ;

el-context-frame {G H a : FA} (n : Nat) (e : CE G H) (r : FPJ (fjeqcx G H))
    (hU : Ty G (fuu n G)) (h : Tm' G a (fuu n G)) : FPJ (fjeqty G (fel n G a) (fel n H a)) =
  (r.1,(ft-el G n a h, ty-cx r.1 r.2.2 (ft-el H n a (move-universe n r.2.1 e (f-universe-bound G G n hU) h)))) ;

lam-context-frame {G H A B b : FA} (e : CE G H) (r : FPJ (fjeqcx G H)) (hA : Ty G A)
    (hB : Ty (fext G A) B) (hb : Tm' (fext G A) b B) :
    FPJ (fjeqtm G (flam G A B b) (flam H A B b) (fpi G A B)) =
  (r.1,(pi-ty hA hB,(lam-tm hA hB hb,
    tm-conv (tm-cx r.1 r.2.2 (lam-tm hA' (ty-cx (ext-wf hA') ext hB) (tm-cx (ext-wf hA') ext hb)))
      (ty-sym (fe-pi-context G A B hA hB H e)))))
 where {
  hA' : Ty H A = ty-cx r.2.1 e hA ;
  ext : CE (fext G A) (fext H A) = ext-eq e (ty-refl hA) ;
 } ;

app-context-frame {G H A B c a : FA} (e : CE G H) (r : FPJ (fjeqcx G H)) (hA : Ty G A)
    (hB : Ty (fext G A) B) (hc : Tm' G c (fpi G A B)) (ha : Tm' G a A) :
    FPJ (fjeqtm G (fapp G A B c a) (fapp H A B c a) (ftsb G (fext G A) B (fsec G A a))) =
  (r.1,(ty-sub hB s,(app-tm hA hB hc ha,
    tm-conv {G} {fapp H A B c a} {ftsb H (fext H A) B (fsec H A a)} {ftsb G (fext G A) B (fsec G A a)}
      (tm-cx r.1 r.2.2 (app-tm hA' (ty-cx (ext-wf hA') ext hB)
        (tm-conv (tm-cx r.2.1 e hc) (te-cx r.2.1 e (fe-pi-context G A B hA hB H e))) ha'))
      (ty-sym (sub-frame-eq r.1 (ext-wf hA') e ext hB hB (ty-refl hB) s s'
        (fq-sec-context G A a hA ha H e))))))
 where {
  hA' : Ty H A = ty-cx r.2.1 e hA ;
  ha' : Tm' H a A = tm-cx r.2.1 e ha ;
  ext : CE (fext G A) (fext H A) = ext-eq e (ty-refl hA) ;
  s : Sb G (fsec G A a) (fext G A) = sec-sub hA ha ;
  s' : Sb G (fsec H A a) (fext G A) =
    sub-cx r.1 (ext-wf hA) r.2.2 (ext-eq r.2.2 (ty-refl hA')) (sec-sub hA' ha') ;
 } ;

pic-context-frame {G H a b : FA} (n : Nat) (e : CE G H) (r : FPJ (fjeqcx G H))
    (hU : Ty G (fuu n G)) (ha : Tm' G a (fuu n G))
    (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a)))) :
    FPJ (fjeqtm G (fpic n G a b) (fpic n H a b) (fuu n G)) =
  (r.1,(hU,(fm-pic G n a b ha hb,
    move-universe n r.1 r.2.2 nb (fm-pic H n a b ha'
      (move-universe n (ext-wf (ft-el H n a ha')) (ext-eq e (fe-el-context G n a ha H e)) nb hb)))))
 where {
  nb : LeN n N = f-universe-bound G G n hU ;
  ha' : Tm' H a (fuu n H) = move-universe n r.2.1 e nb ha ;
 } ;

tm-source-frame {D E G A a s : FA} (e : CE D E) (r : FPJ (fjeqcx D E))
    (wG : W G) (hA : Ty G A) (ha : Tm' G a A) (hs : Sb D s G) :
    FPJ (fjeqtm D (fmsb D G A a s) (fmsb E G A a s) (ftsb D G A s)) =
  (r.1,(ty-sub hA hs,(tm-sub hA ha hs,
    tm-conv {D} {fmsb E G A a s} {ftsb E G A s} {ftsb D G A s}
      (tm-cx r.1 r.2.2 (tm-sub hA ha (sub-cx r.2.1 wG e (cx-refl wG) hs)))
      (ty-sym (fe-sb-source D G A s hA hs E e))))) ;

tm-target-frame {D G H A a s : FA} (e : CE G H) (r : FPJ (fjeqcx G H))
    (wD : W D) (hA : Ty G A) (ha : Tm' G a A) (hs : Sb D s G) :
    FPJ (fjeqtm D (fmsb D G A a s) (fmsb D H A a s) (ftsb D G A s)) =
  (wD,(ty-sub hA hs,(tm-sub hA ha hs,
    tm-conv {D} {fmsb D H A a s} {ftsb D H A s} {ftsb D G A s}
      (tm-sub (ty-cx r.2.1 e hA) (tm-cx r.2.1 e ha) (sub-cx wD r.2.1 (cx-refl wD) e hs))
      (ty-sym (fe-sb-target D G A s hA hs H e))))) ;

lift-source-frame {D E G A s : FA} (e : CE D E) (r : FPJ (fjeqcx D E))
    (wG : W G) (hA : Ty G A) (hs : Sb D s G) :
    FPJ (fjeqsub (fext D (ftsb D G A s)) (flift D G A s) (flift E G A s) (fext G A)) =
  (wD,(wA,(lift-sub hA hs, sub-cx wD wA
    (ext-eq r.2.2 (te-cx r.2.1 e (ty-sym (fe-sb-source D G A s hA hs E e))))
    (cx-refl wA) (lift-sub hA (sub-cx r.2.1 wG e (cx-refl wG) hs)))))
 where {
  wD : W (fext D (ftsb D G A s)) = ext-wf (ty-sub hA hs) ;
  wA : W (fext G A) = ext-wf hA ;
 } ;

lift-target-frame {D G H A s : FA} (e : CE G H) (r : FPJ (fjeqcx G H))
    (wD : W D) (hA : Ty G A) (hs : Sb D s G) :
    FPJ (fjeqsub (fext D (ftsb D G A s)) (flift D G A s) (flift D H A s) (fext G A)) =
  (source,(target,(lift-sub hA hs, sub-cx source target
    (ext-eq (cx-refl wD) (ty-sym (fe-sb-target D G A s hA hs H e)))
    (ext-eq r.2.2 (ty-refl hA')) (lift-sub hA' (sub-cx wD r.2.1 (cx-refl wD) e hs)))))
 where {
  hA' : Ty H A = ty-cx r.2.1 e hA ;
  source : W (fext D (ftsb D G A s)) = ext-wf (ty-sub hA hs) ;
  target : W (fext G A) = ext-wf hA ;
 } ;
