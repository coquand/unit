-- Context generation, equality inversion, and transport for AGAT.
level l ;
open Base ; open Lib[l] ; open AGAT[l] ; open APresup[l] ;

CE (G D : GA) : U l = GADer (ajeqcx G D) ;
TE (G A B : GA) : U l = GADer (ajeqty G A B) ;
ME (G a b A : GA) : U l = GADer (ajeqtm G a b A) ;
SE (D s t G : GA) : U l = GADer (ajeqsub D s t G) ;

wf-left (G D : GA) (e : CE G D) : W G = (apresup (ajeqcx G D) e).1 ;
wf-right (G D : GA) (e : CE G D) : W D = (apresup (ajeqcx G D) e).2.1 ;

WfHead : GA -> U l = split {
  anil -> Top ;
  aext G A -> Ty G A ;
  api A B -> Empty ;
  auu n X -> Empty ;
  ael n a -> Empty ;
  asb t s -> Empty ;
  alam A B b -> Empty ;
  aapp A B c a -> Empty ;
  apic n a b -> Empty ;
  auc m n X -> Empty ;
  alf m n a -> Empty ;
  aq X A -> Empty ;
  aid X -> Empty ;
  acomp s d -> Empty ;
  aeps X -> Empty ;
  ap X A -> Empty ;
  alift A s -> Empty ;
  asec A a -> Empty } ;

CxView : GA -> GA -> U l = split {
  anil -> \ E -> Id GA E anil ;
  aext G A -> \ E -> (D B : GA) * (Id GA E (aext D B) * (CE G D * TE G A B)) ;
  api A B -> \ E -> Empty ;
  auu n X -> \ E -> Empty ;
  ael n a -> \ E -> Empty ;
  asb t s -> \ E -> Empty ;
  alam A B b -> \ E -> Empty ;
  aapp A B c a -> \ E -> Empty ;
  apic n a b -> \ E -> Empty ;
  auc m n X -> \ E -> Empty ;
  alf m n a -> \ E -> Empty ;
  aq X A -> \ E -> Empty ;
  aid X -> \ E -> Empty ;
  acomp s d -> \ E -> Empty ;
  aeps X -> \ E -> Empty ;
  ap X A -> \ E -> Empty ;
  alift A s -> \ E -> Empty ;
  asec A a -> \ E -> Empty } ;

cx-view-refl : (G : GA) -> W G -> WfHead G -> CxView G G = split {
  anil -> \ w t -> refl anil ;
  aext G A -> \ w t -> (G, (A, (refl (aext G A), (ac-refl G (apresup (ajty G A) t), ae-refl G A t)))) ;
  api A B -> \ w t -> t ;
  auu n X -> \ w t -> t ;
  ael n a -> \ w t -> t ;
  asb t s -> \ w t -> t ;
  alam A B b -> \ w t -> t ;
  aapp A B c a -> \ w t -> t ;
  apic n a b -> \ w t -> t ;
  auc m n X -> \ w t -> t ;
  alf m n a -> \ w t -> t ;
  aq X A -> \ w t -> t ;
  aid X -> \ w t -> t ;
  acomp s d -> \ w t -> t ;
  aeps X -> \ w t -> t ;
  ap X A -> \ w t -> t ;
  alift A s -> \ w t -> t ;
  asec A a -> \ w t -> t } ;

CtxGen : GAJ -> U l = split {
  ajwf G -> WfHead G ; ajeqcx G D -> CxView G D ;
  ajty G A -> Top ; ajtm G a A -> Top ; ajsub D s G -> Top ;
  ajeqty G A B -> Top ; ajeqtm G a b A -> Top ; ajeqsub D s t G -> Top } ;

ctx-gen : (J : GAJ) -> GADer J -> CtxGen J = split {
  a-nil -> tt ;
  a-ext G A h -> h ;
  ac-nil -> refl anil ;
  ac-refl G h | r -> cx-view-refl G h r ;
  ac-ext G D A B h1 h2 -> (D, (B, (refl (aext D B), (h1, h2)))) ;
  as-id G h -> tt ;
  as-comp T D G s d h1 h2 -> tt ;
  as-eps G h -> tt ;
  as-p G A h -> tt ;
  as-lift D G A s h1 h2 -> tt ;
  as-sec G A a h1 h2 -> tt ;
  as-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  at-pi G A B h1 h2 -> tt ;
  at-uu G n h nb -> tt ;
  at-el G n a h -> tt ;
  at-sb D G A s h1 h2 -> tt ;
  at-cx G D A h0 h1 h2 -> tt ;
  am-lam G A B b h1 h2 h3 -> tt ;
  am-app G A B c a h1 h2 h3 h4 -> tt ;
  am-pic G n a b h1 h2 -> tt ;
  am-uc G m n h lt nb -> tt ;
  am-lf G m n a h le nb -> tt ;
  am-q G A h -> tt ;
  am-sb D G a A s hA h1 h2 -> tt ;
  am-conv G a A B h1 h2 -> tt ;
  am-cx G D a A h0 h1 h2 -> tt ;
  ae-refl G A h -> tt ;
  ae-sym G A B h -> tt ;
  ae-trans G A B C h1 h2 -> tt ;
  ae-pi G A A' B B' h0 h1 h2 -> tt ;
  ae-el G n a a' h -> tt ;
  ae-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ae-el-lf G m n a h le nb -> tt ;
  ae-el-pic G n a b h1 h2 -> tt ;
  ae-el-uc G m n h lt nb -> tt ;
  ae-sb-id G A h -> tt ;
  ae-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ae-pi-sb D G A B s h1 h2 h3 -> tt ;
  ae-uu-sb D G n s h nb -> tt ;
  ae-el-sb D G n a s h1 h2 -> tt ;
  ae-cx G D A B h0 h1 h2 -> tt ;
  am-refl G a A h -> tt ;
  am-sym G a b A hA h -> tt ;
  am-trans G a b c A h1 h2 -> tt ;
  am-eqconv G a b A B h1 h2 -> tt ;
  am-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  am-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  am-epic G n a a' b b' h0 h1 h2 -> tt ;
  am-elf G m n a a' h le nb -> tt ;
  am-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  am-beta G A B b a hA hB h1 h2 -> tt ;
  am-eta G A B f hA hB h -> tt ;
  am-lf-pic G n p a b h1 h2 le nb -> tt ;
  am-lf-uc G m n p h lt le nb -> tt ;
  am-lf-lf G m n p a h le1 le2 nb -> tt ;
  am-sb-id G a A h -> tt ;
  am-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  am-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  am-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  am-pic-sb D G n a b s h1 h2 h3 -> tt ;
  am-uc-sb D G m n s h lt nb -> tt ;
  am-lf-sb D G m n a s h1 h2 le nb -> tt ;
  am-q-lift D G A s h1 h2 -> tt ;
  am-q-sec G A a h1 h2 -> tt ;
  am-ecx G D a b A h0 h1 h2 -> tt ;
  aq-refl D s G h -> tt ;
  aq-sym D s t G h -> tt ;
  aq-trans D s t u G h1 h2 -> tt ;
  aq-comp T D G s s' d d' h1 h2 -> tt ;
  aq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  aq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  aq-idl D G s h -> tt ;
  aq-idr D G s h -> tt ;
  aq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  aq-eps G s h -> tt ;
  aq-lift-id G A h -> tt ;
  aq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  aq-p-lift D G A s h1 h2 -> tt ;
  aq-p-sec G A a h1 h2 -> tt ;
  aq-sec-comp D G A a s h1 h2 h3 -> tt ;
  aq-lift-p-sec-q G A h -> tt ;
  ae-uu-cx G H n e nb -> tt ;
  am-uc-cx G H m n e lt nb -> tt ;
  aq-id-cx G H e -> tt ;
  aq-eps-cx G H e -> tt ;
  aq-p-cx G H A B e p -> tt ;
  am-q-cx G H A B e p -> tt } ;

wf-ext-inv (G A : GA) (w : W (aext G A)) : Ty G A =
  ctx-gen (ajwf (aext G A)) w ;

context-view (G D : GA) (e : CE G D) : CxView G D =
  ctx-gen (ajeqcx G D) e ;

a-prefix : GA -> GA = split {
  anil -> anil ;
  aext G A -> G ;
  api A B -> anil ;
  auu n X -> anil ;
  ael n a -> anil ;
  asb t s -> anil ;
  alam A B b -> anil ;
  aapp A B c a -> anil ;
  apic n a b -> anil ;
  auc m n X -> anil ;
  alf m n a -> anil ;
  aq X A -> anil ;
  aid X -> anil ;
  acomp s d -> anil ;
  aeps X -> anil ;
  ap X A -> anil ;
  alift A s -> anil ;
  asec A a -> anil } ;

a-last : GA -> GA = split {
  anil -> anil ;
  aext G A -> A ;
  api A B -> anil ;
  auu n X -> anil ;
  ael n a -> anil ;
  asb t s -> anil ;
  alam A B b -> anil ;
  aapp A B c a -> anil ;
  apic n a b -> anil ;
  auc m n X -> anil ;
  alf m n a -> anil ;
  aq X A -> anil ;
  aid X -> anil ;
  acomp s d -> anil ;
  aeps X -> anil ;
  ap X A -> anil ;
  alift A s -> anil ;
  asec A a -> anil } ;

cx-ext-inv (G A D B : GA) (e : CE (aext G A) (aext D B)) : CE G D * TE G A B =
  Prelude[l].subst GA (\ X -> CE G (a-prefix X) * TE G A (a-last X)) (aext h.1 h.2.1) (aext D B)
    (Prelude[l].sym GA (aext D B) (aext h.1 h.2.1) h.2.2.1) h.2.2.2
  where { h : CxView (aext G A) (aext D B) = context-view (aext G A) (aext D B) e ; } ;

cx-trans-finish (G A D B E : GA) (r : (X Y : GA) -> CE G X -> CE X Y -> CE G Y)
    (e : CE G D) (t : TE G A B) (v : CxView (aext D B) E) : CE (aext G A) E =
  Prelude[l].subst GA (\ X -> CE (aext G A) X) (aext v.1 v.2.1) E
    (Prelude[l].sym GA E (aext v.1 v.2.1) v.2.2.1)
    (ac-ext G v.1 A v.2.1 (r D v.1 e v.2.2.2.1)
      (ae-trans G A B v.2.1 t
        (ae-cx D G B v.2.1 (wf-left G D e) (a-cx-sym G D e) v.2.2.2.2))) ;

cx-trans-ext (G A D E : GA) (r : (X Y : GA) -> CE G X -> CE X Y -> CE G Y)
    (v : CxView (aext G A) D) (f : CE D E) : CE (aext G A) E =
  cx-trans-finish G A v.1 v.2.1 E r v.2.2.2.1 v.2.2.2.2
    (context-view (aext v.1 v.2.1) E
      (Prelude[l].subst GA (\ X -> CE X E) D (aext v.1 v.2.1) v.2.2.1 f)) ;

a-cx-trans : (G D E : GA) -> CE G D -> CE D E -> CE G E = split {
  anil -> \ D E e f -> Prelude[l].subst GA (\ X -> CE X E) D anil (context-view anil D e) f ;
  aext G A | rG rA -> \ D E e f -> cx-trans-ext G A D E rG (context-view (aext G A) D e) f ;
  api A B -> \ D E e f -> efq (context-view (api A B) D e) ;
  auu n X -> \ D E e f -> efq (context-view (auu n X) D e) ;
  ael n a -> \ D E e f -> efq (context-view (ael n a) D e) ;
  asb t s -> \ D E e f -> efq (context-view (asb t s) D e) ;
  alam A B b -> \ D E e f -> efq (context-view (alam A B b) D e) ;
  aapp A B c a -> \ D E e f -> efq (context-view (aapp A B c a) D e) ;
  apic n a b -> \ D E e f -> efq (context-view (apic n a b) D e) ;
  auc m n X -> \ D E e f -> efq (context-view (auc m n X) D e) ;
  alf m n a -> \ D E e f -> efq (context-view (alf m n a) D e) ;
  aq X A -> \ D E e f -> efq (context-view (aq X A) D e) ;
  aid X -> \ D E e f -> efq (context-view (aid X) D e) ;
  acomp s d -> \ D E e f -> efq (context-view (acomp s d) D e) ;
  aeps X -> \ D E e f -> efq (context-view (aeps X) D e) ;
  ap X A -> \ D E e f -> efq (context-view (ap X A) D e) ;
  alift A s -> \ D E e f -> efq (context-view (alift A s) D e) ;
  asec A a -> \ D E e f -> efq (context-view (asec A a) D e) } ;

-- Transport to the right endpoints of the given context equalities.
move-ty (G H A : GA) (e : CE G H) (h : Ty G A) : Ty H A =
  at-cx G H A (wf-right G H e) e h ;

move-tm (G H a A : GA) (e : CE G H) (h : Tm' G a A) : Tm' H a A =
  am-cx G H a A (wf-right G H e) e h ;

move-te (G H A B : GA) (e : CE G H) (h : TE G A B) : TE H A B =
  ae-cx G H A B (wf-right G H e) e h ;

move-me (G H a b A : GA) (e : CE G H) (h : ME G a b A) : ME H a b A =
  am-ecx G H a b A (wf-right G H e) e h ;

move-sub (D E G H s : GA) (d : CE D E) (g : CE G H) (h : Sb D s G) : Sb E s H =
  as-cx D E G H s (wf-right D E d) (wf-right G H g) d g h ;

-- Cancel the two endpoint identities at the new endpoints.
cancel-end-ids (D G s : GA) (wD : W D) (h : Sb D s G) :
    SE D (acomp (aid G) (acomp s (aid D))) s G =
  aq-trans D (acomp (aid G) (acomp s (aid D))) (acomp s (aid D)) s G
    (aq-idl D G (acomp s (aid D)) (as-comp D D G s (aid D) h (as-id D wD)))
    (aq-idr D G s h) ;

move-se (D E G H s t : GA) (d : CE D E) (g : CE G H) (h : SE D s t G) : SE E s t H =
  aq-trans E s ss t H (aq-sym E ss s H (cancel-end-ids E H s wE hs))
    (aq-trans E ss tt' t H between (cancel-end-ids E H t wE ht))
  where {
    wE : W E = wf-right D E d ;
    wH : W H = wf-right G H g ;
    rs : APJ (ajeqsub D s t G) = apresup (ajeqsub D s t G) h ;
    hs : Sb E s H = move-sub D E G H s d g rs.2.2.1 ;
    ht : Sb E t H = move-sub D E G H t d g rs.2.2.2 ;
    left-id : Sb E (aid E) D =
      move-sub E E E D (aid E) (ac-refl E wE) (a-cx-sym D E d) (as-id E wE) ;
    right-id : Sb G (aid H) H =
      move-sub H G H H (aid H) (a-cx-sym G H g) (ac-refl H wH) (as-id H wH) ;
    ss : GA = acomp (aid H) (acomp s (aid E)) ;
    tt' : GA = acomp (aid H) (acomp t (aid E)) ;
    between : SE E ss tt' H =
      aq-comp E G H (aid H) (aid H) (acomp s (aid E)) (acomp t (aid E))
        (aq-refl G (aid H) H right-id)
        (aq-comp E D G s t (aid E) (aid E) h (aq-refl E (aid E) D left-id)) ;
  } ;
