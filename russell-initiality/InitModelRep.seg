-- InitModelRep.seg (PLAN-INIT, Part A): normalised representatives.
-- To prove an equation (a proposition: a path in a set) we first fix a
-- raw representative of every context class involved (CP c), and then
-- take representatives of all types, substitutions and terms OVER THESE
-- FIXED raw contexts (NT, NS, NE), with actual GDer derivations (the
-- goal is a proposition, so the mere derivations of F can be eliminated).
-- Then the two sides of an equation have representatives with the same
-- raw contexts and the GDer rule applies without context conversions.
--   CP c                 (G, w : GDer (gjwf G), cls G w = c)
--   NT c g T             (A, h : GDer (gjty g A), class = T)
--   NS d c gd gc s       (s0, h : GDer (gjsub gd s0 gc), class = s)
--   NE c g T x t         (a0, h : GDer (gjtm g a0 x), class = t)  (x : NT c g T)
-- with-* : any representative merely exists (eliminators into props);
-- nt-eq ns-eq ne-eq : relates; nt-tr ne-subst cp-tr ns-subst : transport
-- only changes the path component; ns-move ne-retype : change of raw
-- contexts / raw type.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
open InitQuot[l] ;
open InitSorts[l] ;

------------------------------------------------------------------------
-- contexts

CP (c : Ctx) : U l = (G : GE) * ((w : GDer (gjwf G)) * Id Ctx (cls G (pf (gjwf G) w)) c) ;
cpw (c : Ctx) (g : CP c) : Pf (gjwf g.1) = pf (gjwf g.1) g.2.1 ;

cp-ex (c : Ctx) : Sq (CP c) =
  sq-rec (RepCtx c) (Sq (CP c)) (sq-prop (CP c))
    (\ r -> sq-rec (GDer (gjwf r.1)) (Sq (CP c)) (sq-prop (CP c))
      (\ k -> sq (CP c) (r.1, (k, trans Ctx (cls r.1 (pf (gjwf r.1) k)) (cls r.1 r.2.1) c
        (cls-irr r.1 (pf (gjwf r.1) k) r.2.1) r.2.2)))
      r.2.1)
    (rep-ctx c) ;

with-cp (c : Ctx) (P : U l) (pP : isProp P) (f : CP c -> P) : P = sq-rec (CP c) P pP f (cp-ex c) ;

-- moving a context point along a path of classes
cp-tr (X : U l) (E : X -> Ctx) (x y : X) (e : Id X x y) (g : CP (E x)) : CP (E y) =
  (g.1, (g.2.1, trans Ctx (cls g.1 (cpw (E x) g)) (E x) (E y) g.2.2 (ap X Ctx E x y e))) ;

------------------------------------------------------------------------
-- types

clT (c : Ctx) (g : CP c) (A : GE) (h : GDer (gjty g.1 A)) : Ty c =
  clsTy c g.1 A (pf (gjty g.1 A) h) (cpw c g) g.2.2 ;

NT (c : Ctx) (g : CP c) (T : Ty c) : U l =
  (A : GE) * ((h : GDer (gjty g.1 A)) * Id (Ty c) (clT c g A h) T) ;

toRT (c : Ctx) (g : CP c) (T : Ty c) (x : NT c g T) : RepTy c T =
  mkRepTy c T g.1 x.1 (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2 x.2.2 ;

nt-ex (c : Ctx) (g : CP c) (T : Ty c) : Sq (NT c g T) =
  sq-rec (RepTy c T) (Sq (NT c g T)) (sq-prop (NT c g T))
    (\ r -> sq-rec (GDer (gjty g.1 (rtA c T r))) (Sq (NT c g T)) (sq-prop (NT c g T))
      (\ k -> sq (NT c g T) (rtA c T r, (k,
        trans (Ty c) (clT c g (rtA c T r) k) (clsTy c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r)) T
          (clsTy-move c g.1 (rtA c T r) (pf (gjty g.1 (rtA c T r)) k) (cpw c g) g.2.2
            (rtG c T r) (rtH c T r) (rtW c T r) (rtP c T r))
          (rtE c T r))))
      (ty-move c (rtG c T r) (rtA c T r) (rtH c T r) (rtW c T r) (rtP c T r) g.1 (cpw c g) g.2.2))
    (rep-ty c T) ;

with-nt (c : Ctx) (g : CP c) (T : Ty c) (P : U l) (pP : isProp P) (f : NT c g T -> P) : P =
  sq-rec (NT c g T) P pP f (nt-ex c g T) ;

nt-eq (c : Ctx) (g g' : CP c) (T T' : Ty c) (x : NT c g T) (x' : NT c g' T')
  (e : GDer (gjeqty g.1 x.1 x'.1)) : Id (Ty c) T T' =
  trans (Ty c) T (clT c g x.1 x.2.1) T'
    (sym (Ty c) (clT c g x.1 x.2.1) T x.2.2)
    (trans (Ty c) (clT c g x.1 x.2.1) (clT c g' x'.1 x'.2.1) T'
      (clsTy-eq c g.1 x.1 (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2
        g'.1 x'.1 (pf (gjty g'.1 x'.1) x'.2.1) (cpw c g') g'.2.2 (pf (gjeqty g.1 x.1 x'.1) e))
      x'.2.2) ;

nt-tr (c : Ctx) (g : CP c) (T T' : Ty c) (x : NT c g T) (e : Id (Ty c) T T') : NT c g T' =
  (x.1, (x.2.1, trans (Ty c) (clT c g x.1 x.2.1) T T' x.2.2 e)) ;

------------------------------------------------------------------------
-- substitutions

clS (d c : Ctx) (gd : CP d) (gc : CP c) (s0 : GE) (h : GDer (gjsub gd.1 s0 gc.1)) : Sub d c =
  clsSub d c gd.1 s0 gc.1 (pf (gjsub gd.1 s0 gc.1) h) (cpw d gd) (cpw c gc) gd.2.2 gc.2.2 ;

NS (d c : Ctx) (gd : CP d) (gc : CP c) (s : Sub d c) : U l =
  (s0 : GE) * ((h : GDer (gjsub gd.1 s0 gc.1)) * Id (Sub d c) (clS d c gd gc s0 h) s) ;

toRS (d c : Ctx) (gd : CP d) (gc : CP c) (s : Sub d c) (u : NS d c gd gc s) : RepSub d c s =
  mkRepSub d c s gd.1 u.1 gc.1 (pf (gjsub gd.1 u.1 gc.1) u.2.1) (cpw d gd) (cpw c gc) gd.2.2 gc.2.2 u.2.2 ;

ns-ex (d c : Ctx) (gd : CP d) (gc : CP c) (s : Sub d c) : Sq (NS d c gd gc s) =
  sq-rec (RepSub d c s) (Sq (NS d c gd gc s)) (sq-prop (NS d c gd gc s))
    (\ r -> sq-rec (GDer (gjsub gd.1 (rss d c s r) gc.1)) (Sq (NS d c gd gc s)) (sq-prop (NS d c gd gc s))
      (\ k -> sq (NS d c gd gc s) (rss d c s r, (k,
        trans (Sub d c) (clS d c gd gc (rss d c s r) k)
          (clsSub d c (rsD d c s r) (rss d c s r) (rsG d c s r) (rsH d c s r) (rsWD d c s r) (rsWG d c s r)
            (rsPD d c s r) (rsPG d c s r)) s
          (clsSub-irr d c gd.1 (rss d c s r) gc.1 (pf (gjsub gd.1 (rss d c s r) gc.1) k) (cpw d gd) (cpw c gc)
            gd.2.2 gc.2.2 (rsD d c s r) (rsG d c s r) (rsH d c s r) (rsWD d c s r) (rsWG d c s r)
            (rsPD d c s r) (rsPG d c s r))
          (rsE d c s r))))
      (pf-map3 (gjsub (rsD d c s r) (rss d c s r) (rsG d c s r)) (gjeqcx (rsD d c s r) gd.1) (gjeqcx (rsG d c s r) gc.1)
        (gjsub gd.1 (rss d c s r) gc.1)
        (\ h eD eG -> gs-cx (rsD d c s r) gd.1 (rsG d c s r) gc.1 (rss d c s r) gd.2.1 gc.2.1 eD eG h)
        (rsH d c s r)
        (same-cx d (rsD d c s r) gd.1 (rsWD d c s r) (cpw d gd) (rsPD d c s r) gd.2.2)
        (same-cx c (rsG d c s r) gc.1 (rsWG d c s r) (cpw c gc) (rsPG d c s r) gc.2.2)))
    (rep-sub d c s) ;

with-ns (d c : Ctx) (gd : CP d) (gc : CP c) (s : Sub d c) (P : U l) (pP : isProp P) (f : NS d c gd gc s -> P) : P =
  sq-rec (NS d c gd gc s) P pP f (ns-ex d c gd gc s) ;

ns-eq (d c : Ctx) (gd : CP d) (gc : CP c) (gd' : CP d) (gc' : CP c) (s s' : Sub d c)
  (u : NS d c gd gc s) (u' : NS d c gd' gc' s') (e : GDer (gjeqsub gd.1 u.1 u'.1 gc.1)) : Id (Sub d c) s s' =
  trans (Sub d c) s (clS d c gd gc u.1 u.2.1) s'
    (sym (Sub d c) (clS d c gd gc u.1 u.2.1) s u.2.2)
    (trans (Sub d c) (clS d c gd gc u.1 u.2.1) (clS d c gd' gc' u'.1 u'.2.1) s'
      (clsSub-eq d c gd.1 u.1 gc.1 (pf (gjsub gd.1 u.1 gc.1) u.2.1) (cpw d gd) (cpw c gc) gd.2.2 gc.2.2
        gd'.1 u'.1 gc'.1 (pf (gjsub gd'.1 u'.1 gc'.1) u'.2.1) (cpw d gd') (cpw c gc') gd'.2.2 gc'.2.2
        (pf (gjeqsub gd.1 u.1 u'.1 gc.1) e))
      u'.2.2) ;

ns-subst (X : U l) (E F : X -> Ctx) (x y : X) (e : Id X x y) (gd : CP (E x)) (gc : CP (F x))
  (s : Sub (E x) (F x)) (u : NS (E x) (F x) gd gc s) :
  NS (E y) (F y) (cp-tr X E x y e gd) (cp-tr X F x y e gc) (subst X (\ z -> Sub (E z) (F z)) x y e s) =
  (u.1, (u.2.1,
    trans (Sub (E y) (F y)) (clS (E y) (F y) (cp-tr X E x y e gd) (cp-tr X F x y e gc) u.1 u.2.1)
      (subst X (\ z -> Sub (E z) (F z)) x y e (clS (E x) (F x) gd gc u.1 u.2.1))
      (subst X (\ z -> Sub (E z) (F z)) x y e s)
      (sym (Sub (E y) (F y)) (subst X (\ z -> Sub (E z) (F z)) x y e (clS (E x) (F x) gd gc u.1 u.2.1))
        (clS (E y) (F y) (cp-tr X E x y e gd) (cp-tr X F x y e gc) u.1 u.2.1)
        (tr-sub X E F x y e gd.1 u.1 gc.1 (pf (gjsub gd.1 u.1 gc.1) u.2.1) (cpw (E x) gd) (cpw (F x) gc)
          gd.2.2 gc.2.2 (cp-tr X E x y e gd).2.2 (cp-tr X F x y e gc).2.2))
      (ap (Sub (E x) (F x)) (Sub (E y) (F y)) (\ v -> subst X (\ z -> Sub (E z) (F z)) x y e v)
        (clS (E x) (F x) gd gc u.1 u.2.1) s u.2.2))) ;

-- change of the raw contexts (judgementally equal ones)
ns-move (d c : Ctx) (gd : CP d) (gc : CP c) (gd' : CP d) (gc' : CP c) (s : Sub d c) (u : NS d c gd gc s)
  (ed : GDer (gjeqcx gd.1 gd'.1)) (ec : GDer (gjeqcx gc.1 gc'.1)) : NS d c gd' gc' s =
  (u.1, (gs-cx gd.1 gd'.1 gc.1 gc'.1 u.1 gd'.2.1 gc'.2.1 ed ec u.2.1,
    trans (Sub d c) (clS d c gd' gc' u.1 (gs-cx gd.1 gd'.1 gc.1 gc'.1 u.1 gd'.2.1 gc'.2.1 ed ec u.2.1))
      (clS d c gd gc u.1 u.2.1) s
      (clsSub-irr d c gd'.1 u.1 gc'.1 (pf (gjsub gd'.1 u.1 gc'.1) (gs-cx gd.1 gd'.1 gc.1 gc'.1 u.1 gd'.2.1 gc'.2.1 ed ec u.2.1))
        (cpw d gd') (cpw c gc') gd'.2.2 gc'.2.2 gd.1 gc.1 (pf (gjsub gd.1 u.1 gc.1) u.2.1) (cpw d gd) (cpw c gc) gd.2.2 gc.2.2)
      u.2.2)) ;

------------------------------------------------------------------------
-- terms

clE (c : Ctx) (g : CP c) (T : Ty c) (x : NT c g T) (a0 : GE) (h : GDer (gjtm g.1 a0 x.1)) : El c T =
  clsEl c T g.1 x.1 a0 (pf (gjtm g.1 a0 x.1) h) (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2 x.2.2 ;

NE (c : Ctx) (g : CP c) (T : Ty c) (x : NT c g T) (t : El c T) : U l =
  (a0 : GE) * ((h : GDer (gjtm g.1 a0 x.1)) * Id (El c T) (clE c g T x a0 h) t) ;

toRE (c : Ctx) (g : CP c) (T : Ty c) (x : NT c g T) (t : El c T) (y : NE c g T x t) : RepEl c T t =
  mkRepEl c T t g.1 x.1 y.1 (pf (gjtm g.1 y.1 x.1) y.2.1) (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2 x.2.2 y.2.2 ;

ne-ex (c : Ctx) (g : CP c) (T : Ty c) (x : NT c g T) (t : El c T) : Sq (NE c g T x t) =
  sq-rec (RepEl c T t) (Sq (NE c g T x t)) (sq-prop (NE c g T x t))
    (\ r -> sq-rec (GDer (gjtm g.1 (rea c T t r) x.1)) (Sq (NE c g T x t)) (sq-prop (NE c g T x t))
      (\ k -> sq (NE c g T x t) (rea c T t r, (k,
        trans (El c T) (clE c g T x (rea c T t r) k)
          (clsEl c T (reG c T t r) (reA c T t r) (rea c T t r) (reH c T t r) (reHA c T t r) (reW c T t r)
            (reP c T t r) (reT c T t r)) t
          (clsEl-irr c T g.1 x.1 (rea c T t r) (pf (gjtm g.1 (rea c T t r) x.1) k) (pf (gjty g.1 x.1) x.2.1)
            (cpw c g) g.2.2 x.2.2
            (reG c T t r) (reA c T t r) (reH c T t r) (reHA c T t r) (reW c T t r) (reP c T t r) (reT c T t r))
          (reE c T t r))))
      (re-move c T t r (toRT c g T x)))
    (rep-el c T t) ;

with-ne (c : Ctx) (g : CP c) (T : Ty c) (x : NT c g T) (t : El c T) (P : U l) (pP : isProp P)
  (f : NE c g T x t -> P) : P =
  sq-rec (NE c g T x t) P pP f (ne-ex c g T x t) ;

-- relates, at the raw context and raw type of the first representative
ne-eq (c : Ctx) (g g' : CP c) (T : Ty c) (x : NT c g T) (x' : NT c g' T) (t t' : El c T)
  (y : NE c g T x t) (y' : NE c g' T x' t') (e : GDer (gjeqtm g.1 y.1 y'.1 x.1)) : Id (El c T) t t' =
  trans (El c T) t (clE c g T x y.1 y.2.1) t'
    (sym (El c T) (clE c g T x y.1 y.2.1) t y.2.2)
    (trans (El c T) (clE c g T x y.1 y.2.1) (clE c g' T x' y'.1 y'.2.1) t'
      (clsEl-eq c T g.1 x.1 y.1 (pf (gjtm g.1 y.1 x.1) y.2.1) (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2 x.2.2
        g'.1 x'.1 y'.1 (pf (gjtm g'.1 y'.1 x'.1) y'.2.1) (pf (gjty g'.1 x'.1) x'.2.1) (cpw c g') g'.2.2 x'.2.2
        (pf (gjeqtm g.1 y.1 y'.1 x.1) e))
      y'.2.2) ;

ne-subst (c : Ctx) (g : CP c) (T T' : Ty c) (e : Id (Ty c) T T') (x : NT c g T) (t : El c T) (y : NE c g T x t) :
  NE c g T' (nt-tr c g T T' x e) (subst (Ty c) (El c) T T' e t) =
  (y.1, (y.2.1,
    trans (El c T') (clE c g T' (nt-tr c g T T' x e) y.1 y.2.1)
      (subst (Ty c) (El c) T T' e (clE c g T x y.1 y.2.1)) (subst (Ty c) (El c) T T' e t)
      (sym (El c T') (subst (Ty c) (El c) T T' e (clE c g T x y.1 y.2.1)) (clE c g T' (nt-tr c g T T' x e) y.1 y.2.1)
        (el-transport c T T' e g.1 x.1 y.1 (pf (gjtm g.1 y.1 x.1) y.2.1) (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2
          x.2.2 (nt-tr c g T T' x e).2.2))
      (ap (El c T) (El c T') (\ v -> subst (Ty c) (El c) T T' e v) (clE c g T x y.1 y.2.1) t y.2.2))) ;

-- change of the raw type (a judgementally equal one)
ne-retype (c : Ctx) (g : CP c) (T : Ty c) (x x' : NT c g T) (t : El c T) (y : NE c g T x t)
  (e : GDer (gjeqty g.1 x.1 x'.1)) : NE c g T x' t =
  (y.1, (gm-conv g.1 y.1 x.1 x'.1 y.2.1 e,
    trans (El c T) (clE c g T x' y.1 (gm-conv g.1 y.1 x.1 x'.1 y.2.1 e)) (clE c g T x y.1 y.2.1) t
      (clsEl-irr c T g.1 x'.1 y.1 (pf (gjtm g.1 y.1 x'.1) (gm-conv g.1 y.1 x.1 x'.1 y.2.1 e)) (pf (gjty g.1 x'.1) x'.2.1)
        (cpw c g) g.2.2 x'.2.2 g.1 x.1 (pf (gjtm g.1 y.1 x.1) y.2.1) (pf (gjty g.1 x.1) x.2.1) (cpw c g) g.2.2 x.2.2)
      y.2.2)) ;
