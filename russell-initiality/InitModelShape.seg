-- InitModelShape.seg (PLAN-INIT, Part A): the shape of the term model.
--   record Eqs   the EQUATION fields of TEModel[N] (CwF, PiStr with the
--                two Iso laws, universes), stated for the operations of
--                Part F (InitOpsCtx/Sub/Ext/Pi/U); the set-ness fields are
--                F's isSetCtx/isSetSub/isSetTy/isSetEl and are not fields.
--   mk (e : Eqs) : TEModel[N]
--                every operation field is F's operation (so (mk e).cwf.subT
--                is subT, (mk e).products.Pi is Pi, ((mk e).products.Pi-iso
--                c A B).fun is pi-fun c A B, ...), every equation field is
--                taken from e.
-- The derived members of CwF / TEModel used in field types (p-lift-T,
-- p-sec-T, code-sub, up-code, lift-binder) are copied as derived members
-- of Eqs, with F's operations; they agree definitionally with those of
-- (mk e).
level l ;
open Base ; open Prelude[l] ;
open EhrhardCwF ;
module EM = EhrhardTEModel[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;

record Eqs {
  ----------------------------------------------------------------------
  -- category
  o-idl (D G : Ctx) (s : Sub D G) : Id (Sub D G) (o D G G (id G) s) s ;
  o-idr (D G : Ctx) (s : Sub D G) : Id (Sub D G) (o D D G s (id D)) s ;
  o-assoc (Q T D G : Ctx) (s : Sub D G) (s' : Sub T D) (s'' : Sub Q T)
    : Id (Sub Q G) (o Q T G (o T D G s s') s'') (o Q D G s (o Q T D s' s'')) ;
  eps-uniq (G : Ctx) (s : Sub G nil) : Id (Sub G nil) s (eps G) ;

  ----------------------------------------------------------------------
  -- substitution action
  subT-id (G : Ctx) (A : Ty G) : Id (Ty G) (subT G G A (id G)) A ;
  subT-o (T D G : Ctx) (A : Ty G) (s : Sub D G) (s' : Sub T D)
    : Id (Ty T) (subT T G A (o T D G s s')) (subT T D (subT D G A s) s') ;
  subt-id (G : Ctx) (A : Ty G) (a : El G A)
    : Id (El G A) (subst (Ty G) (El G) (subT G G A (id G)) A (subT-id G A) (subt G G A a (id G))) a ;
  subt-o (T D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (s' : Sub T D)
    : Id (El T (subT T D (subT D G A s) s'))
         (subst (Ty T) (El T) (subT T G A (o T D G s s')) (subT T D (subT D G A s) s')
                (subT-o T D G A s s') (subt T G A a (o T D G s s')))
         (subt T D (subT D G A s) (subt D G A a s) s') ;

  ----------------------------------------------------------------------
  -- comprehension
  lift-id (G : Ctx) (A : Ty G)
    : Id (Sub (ext G A) (ext G A))
         (subst (Ty G) (\ B -> Sub (ext G B) (ext G A)) (subT G G A (id G)) A (subT-id G A)
                (lift G G A (id G)))
         (id (ext G A)) ;
  lift-o (T D G : Ctx) (A : Ty G) (s : Sub D G) (s' : Sub T D)
    : Id (Sub (ext T (subT T D (subT D G A s) s')) (ext G A))
         (subst (Ty T) (\ B -> Sub (ext T B) (ext G A))
                (subT T G A (o T D G s s')) (subT T D (subT D G A s) s')
                (subT-o T D G A s s') (lift T G A (o T D G s s')))
         (o (ext T (subT T D (subT D G A s) s')) (ext D (subT D G A s)) (ext G A)
            (lift D G A s) (lift T D (subT D G A s) s')) ;
  p-lift (D G : Ctx) (A : Ty G) (s : Sub D G)
    : Id (Sub (ext D (subT D G A s)) G)
         (o (ext D (subT D G A s)) (ext G A) G (p G A) (lift D G A s))
         (o (ext D (subT D G A s)) D G s (p D (subT D G A s))) ;
  p-sec (G : Ctx) (A : Ty G) (a : El G A)
    : Id (Sub G G) (o G (ext G A) G (p G A) (sec G A a)) (id G) ;
  sec-o (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G)
    : Id (Sub D (ext G A)) (o D G (ext G A) (sec G A a) s)
         (o D (ext D (subT D G A s)) (ext G A) (lift D G A s)
            (sec D (subT D G A s) (subt D G A a s))) ;
  lift-p-sec-q (G : Ctx) (A : Ty G)
    : Id (Sub (ext G A) (ext G A))
         (o (ext G A) (ext (ext G A) (subT (ext G A) G A (p G A))) (ext G A)
            (lift (ext G A) G A (p G A))
            (sec (ext G A) (subT (ext G A) G A (p G A)) (q G A)))
         (id (ext G A)) ;

  -- copies of the derived members of CwF
  p-lift-T (D G : Ctx) (A B : Ty G) (s : Sub D G)
    : Id (Ty (ext D (subT D G A s)))
         (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
         (subT (ext D (subT D G A s)) D (subT D G B s) (p D (subT D G A s))) =
    trans (Ty E)
      (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
      (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
      (subT E D (subT D G B s) (p D (subT D G A s)))
      (sym (Ty E) (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
                  (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
                  (subT-o E (ext G A) G B (p G A) (lift D G A s)))
      (trans (Ty E)
         (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
         (subT E G B (o E D G s (p D (subT D G A s))))
         (subT E D (subT D G B s) (p D (subT D G A s)))
         (ap (Sub E G) (Ty E) (\ s' -> subT E G B s')
             (o E (ext G A) G (p G A) (lift D G A s)) (o E D G s (p D (subT D G A s)))
             (p-lift D G A s))
         (subT-o E D G B s (p D (subT D G A s))))
   where { E : Ctx = ext D (subT D G A s) ; } ;

  p-sec-T (G : Ctx) (A B : Ty G) (a : El G A)
    : Id (Ty G) (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a)) B =
    trans (Ty G)
      (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
      (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
      B
      (sym (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
                  (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
                  (subT-o G (ext G A) G B (p G A) (sec G A a)))
      (trans (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a))) (subT G G B (id G)) B
         (ap (Sub G G) (Ty G) (\ s' -> subT G G B s')
             (o G (ext G A) G (p G A) (sec G A a)) (id G) (p-sec G A a))
         (subT-id G B)) ;

  q-lift (D G : Ctx) (A : Ty G) (s : Sub D G)
    : Id (El (ext D (subT D G A s)) (subT (ext D (subT D G A s)) D (subT D G A s) (p D (subT D G A s))))
         (subst (Ty (ext D (subT D G A s))) (El (ext D (subT D G A s)))
                (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G A (p G A)) (lift D G A s))
                (subT (ext D (subT D G A s)) D (subT D G A s) (p D (subT D G A s)))
                (p-lift-T D G A A s)
                (subt (ext D (subT D G A s)) (ext G A) (subT (ext G A) G A (p G A)) (q G A) (lift D G A s)))
         (q D (subT D G A s)) ;
  q-sec (G : Ctx) (A : Ty G) (a : El G A)
    : Id (El G A)
         (subst (Ty G) (El G) (subT G (ext G A) (subT (ext G A) G A (p G A)) (sec G A a)) A
                (p-sec-T G A A a)
                (subt G (ext G A) (subT (ext G A) G A (p G A)) (q G A) (sec G A a)))
         a ;

  ----------------------------------------------------------------------
  -- dependent products
  Pi-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G)
    : Id (Ty D) (subT D G (Pi G A B) s)
                (Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) ;
  Pi-fun-inv (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (b : El (ext G A) B)
    : Id (El (ext G A) B) (pi-fun G A B (pi-inv G A B b)) b ;
  Pi-inv-fun (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El G (Pi G A B))
    : Id (El G (Pi G A B)) (pi-inv G A B (pi-fun G A B f)) f ;
  Pi-iso-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El (ext G A) B) (s : Sub D G)
    : Id (El D (Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))))
         (subst (Ty D) (El D) (subT D G (Pi G A B) s)
                (Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)))
                (Pi-nat D G A B s)
                (subt D G (Pi G A B) (pi-inv G A B f) s))
         (pi-inv D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
            (subt (ext D (subT D G A s)) (ext G A) B f (lift D G A s))) ;

  ----------------------------------------------------------------------
  -- universes
  univ-nat (n : EM.LevelAt N) (D G : Ctx) (s : Sub D G) :
      Id (Ty D) (subT D G (univ n G) s) (univ n D) ;

  code-sub (n : EM.LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s : Sub D G) : El D (univ n D) =
    subst (Ty D) (El D) (subT D G (univ n G) s) (univ n D) (univ-nat n D G s)
      (subt D G (univ n G) a s) ;

  decode-nat (n : EM.LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s : Sub D G) :
      Id (Ty D) (subT D G (decode n G a) s) (decode n D (code-sub n D G a s)) ;

  up-code (n : EM.LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s : Sub D G) :
      Sub (ext D (decode n D (code-sub n D G a s))) (ext G (decode n G a)) =
    subst (Ty D) (\ B -> Sub (ext D B) (ext G (decode n G a)))
      (subT D G (decode n G a) s) (decode n D (code-sub n D G a s)) (decode-nat n D G a s)
      (lift D G (decode n G a) s) ;

  el-lf (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G)) :
      Id (Ty G) (decode n G (lf m n lt G a)) (decode m G a) ;
  el-pic (n : EM.LevelAt N) (G : Ctx) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) :
      Id (Ty G) (decode n G (pic n G a b)) (Pi G (decode n G a) (decode n (ext G (decode n G a)) b)) ;
  el-uc (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) :
      Id (Ty G) (decode n G (uc m n lt G)) (univ m G) ;

  lift-binder (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G)) :
      Sub (ext G (decode n G (lf m n lt G a))) (ext G (decode m G a)) =
    idJ (Ty G) (decode n G (lf m n lt G a)) (\ B' e' -> Sub (ext G (decode n G (lf m n lt G a))) (ext G B'))
      (id (ext G (decode n G (lf m n lt G a)))) (decode m G a) (el-lf m n lt G a) ;

  lf-pic (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G))
      (b : El (ext G (decode m G a)) (univ m (ext G (decode m G a)))) :
      Id (El G (univ n G)) (lf m n lt G (pic m G a b))
        (pic n G (lf m n lt G a)
          (lf m n lt (ext G (decode n G (lf m n lt G a)))
            (code-sub m (ext G (decode n G (lf m n lt G a))) (ext G (decode m G a)) b (lift-binder m n lt G a)))) ;
  lf-uc (m n p0 : EM.LevelAt N) (mn : EM.StrictAt N m n) (np : EM.StrictAt N n p0) (mp : EM.StrictAt N m p0) (G : Ctx) :
      Id (El G (univ p0 G)) (lf n p0 np G (uc m n mn G)) (uc m p0 mp G) ;
  lf-lf (m n p0 : EM.LevelAt N) (mn : EM.StrictAt N m n) (np : EM.StrictAt N n p0) (mp : EM.StrictAt N m p0) (G : Ctx)
      (a : El G (univ m G)) :
      Id (El G (univ p0 G)) (lf n p0 np G (lf m n mn G a)) (lf m p0 mp G a) ;

  pic-nat (n : EM.LevelAt N) (D G : Ctx) (s : Sub D G) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) :
      Id (El D (univ n D)) (code-sub n D G (pic n G a b) s)
        (pic n D (code-sub n D G a s)
          (code-sub n (ext D (decode n D (code-sub n D G a s))) (ext G (decode n G a)) b (up-code n D G a s))) ;
  uc-nat (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (D G : Ctx) (s : Sub D G) :
      Id (El D (univ n D)) (code-sub n D G (uc m n lt G) s) (uc m n lt D) ;
  lf-nat (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (D G : Ctx) (s : Sub D G) (a : El G (univ m G)) :
      Id (El D (univ n D)) (code-sub n D G (lf m n lt G a) s) (lf m n lt D (code-sub m D G a s)) ;
} ;

------------------------------------------------------------------------
-- the model built from the equations

mkCwF (e : Eqs) : CwF[l] =
  new CwF[l,
    Ctx := Ctx, Sub := Sub, isSetSub := isSetSub, id := id, o := o,
    o-idl := e.o-idl, o-idr := e.o-idr, o-assoc := e.o-assoc,
    nil := nil, eps := eps, eps-uniq := e.eps-uniq,
    Ty := Ty, isSetTy := isSetTy, subT := subT, subT-id := e.subT-id, subT-o := e.subT-o,
    El := El, isSetEl := isSetEl, subt := subt, subt-id := e.subt-id, subt-o := e.subt-o,
    ext := ext, p := p, q := q, lift := lift, sec := sec,
    lift-id := e.lift-id, lift-o := e.lift-o, p-lift := e.p-lift, p-sec := e.p-sec,
    sec-o := e.sec-o, lift-p-sec-q := e.lift-p-sec-q,
    q-lift := e.q-lift, q-sec := e.q-sec] ;

mkIso (e : Eqs) (G : Ctx) (A : Ty G) (B : Ty (ext G A)) : Iso (El G (Pi G A B)) (El (ext G A) B) =
  new IsoData[El G (Pi G A B), El (ext G A) B,
    fun := pi-fun G A B, inv := pi-inv G A B,
    fun-inv := e.Pi-fun-inv G A B, inv-fun := e.Pi-inv-fun G A B] ;

mkPi (e : Eqs) : PiStr[l, mkCwF e] =
  new PiStr[l, mkCwF e,
    Pi := Pi, Pi-nat := e.Pi-nat, Pi-iso := mkIso e, Pi-iso-nat := e.Pi-iso-nat] ;

mk (e : Eqs) : EM.TEModel[N] =
  new EM.TEModel[N,
    cwf := mkCwF e, isSetCtx := isSetCtx, products := mkPi e,
    univ := univ, univ-nat := e.univ-nat,
    decode := decode, decode-nat := e.decode-nat,
    pic := pic, uc := uc, lf := lf,
    el-lf := e.el-lf, el-pic := e.el-pic, el-uc := e.el-uc,
    lf-pic := e.lf-pic, lf-uc := e.lf-uc, lf-lf := e.lf-lf,
    pic-nat := e.pic-nat, uc-nat := e.uc-nat, lf-nat := e.lf-nat] ;

-- the operations of mk e are those of Part F, definitionally
mk-subT (e : Eqs) : Id ((d c : Ctx) (A : Ty c) (s : Sub d c) -> Ty d) (mk e).cwf.subT subT = refl subT ;
mk-pi-fun (e : Eqs) (G : Ctx) (A : Ty G) (B : Ty (ext G A)) :
  Id (El G (Pi G A B) -> El (ext G A) B) ((mk e).products.Pi-iso G A B).fun (pi-fun G A B) = refl (pi-fun G A B) ;
mk-lf (e : Eqs) : Id ((m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (a : El c (univ m c)) -> El c (univ n c))
  (mk e).lf lf = refl lf ;
