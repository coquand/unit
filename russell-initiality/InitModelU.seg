-- InitModelU.seg (PLAN-INIT, Part A): the universe laws of the term model
-- (fields univ-nat decode-nat el-lf el-pic el-uc lf-pic lf-uc lf-lf
-- pic-nat uc-nat lf-nat of TEModel[N]).
-- The fields whose statements use code-sub / up-code / lift-binder (that
-- is, transports along univ-nat, decode-nat, el-lf) are proved in the
-- module Nat for an ARBITRARY proof un of univ-nat (and Nat.Nat2 for an
-- arbitrary proof dn of decode-nat, lf-pic-gen for an arbitrary path of
-- el-lf): the types are sets, so only the endpoints matter.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitModelRep[l] ;
open InitModelRepOps[l] ;

univ-nat (n : EM.LevelAt N) (d c : Ctx) (s : Sub d c) : Id (Ty d) (subT d c (univ n c) s) (univ n d) =
  with-cp d P pP (\ cd -> with-cp c P pP (\ cc -> with-ns d c cd cc s P pP (\ u ->
    nt-eq d cd cd (subT d c (univ n c) s) (univ n d) (subT-n d c cd cc (univ n c) s (univ-n n c cc) u) (univ-n n d cd)
      (ge-uu-sb cd.1 cc.1 n.1 u.1 u.2.1 n.2))))
 where { P : U l = Id (Ty d) (subT d c (univ n c) s) (univ n d) ; pP : isProp P = isSetTy d (subT d c (univ n c) s) (univ n d) ; } ;

-- the representative of a substituted code, along any path univ-nat
cs-n (n : EM.LevelAt N) (d c : Ctx) (cd : CP d) (cc : CP c) (a : El c (univ n c)) (y : NC n c cc a)
  (s : Sub d c) (u : NS d c cd cc s) (e : Id (Ty d) (subT d c (univ n c) s) (univ n d)) :
  NC n d cd (subst (Ty d) (El d) (subT d c (univ n c) s) (univ n d) e (subt d c (univ n c) a s)) =
  ne-retype d cd (univ n d) (nt-tr d cd (subT d c (univ n c) s) (univ n d) xU e) (univ-n n d cd)
    (subst (Ty d) (El d) (subT d c (univ n c) s) (univ n d) e (subt d c (univ n c) a s))
    (ne-subst d cd (subT d c (univ n c) s) (univ n d) e xU (subt d c (univ n c) a s)
      (subt-n d c cd cc (univ n c) s (univ-n n c cc) a y u))
    (ge-uu-sb cd.1 cc.1 n.1 u.1 u.2.1 n.2)
 where { xU : NT d cd (subT d c (univ n c) s) = subT-n d c cd cc (univ n c) s (univ-n n c cc) u ; } ;

------------------------------------------------------------------------
-- decoding

el-lf (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (a : El c (univ m c)) :
  Id (Ty c) (decode n c (lf m n lt c a)) (decode m c a) =
  with-cp c P pP (\ cc -> with-ne c cc (univ m c) (univ-n m c cc) a P pP (\ y ->
    nt-eq c cc cc (decode n c (lf m n lt c a)) (decode m c a)
      (decode-n n c cc (lf m n lt c a) (lf-n m n lt c cc a y)) (decode-n m c cc a y)
      (ge-el-lf cc.1 m.1 n.1 y.1 y.2.1 lt n.2)))
 where { P : U l = Id (Ty c) (decode n c (lf m n lt c a)) (decode m c a) ;
         pP : isProp P = isSetTy c (decode n c (lf m n lt c a)) (decode m c a) ; } ;

el-pic (n : EM.LevelAt N) (c : Ctx) (a : El c (univ n c))
  (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) :
  Id (Ty c) (decode n c (pic n c a b)) (Pi c (decode n c a) (decode n (ext c (decode n c a)) b)) =
  with-cp c P pP (\ cc -> with-ne c cc (univ n c) (univ-n n c cc) a P pP (\ y ->
  with-ne (ext c (decode n c a)) (dext-cp n c cc a y) (univ n (ext c (decode n c a)))
    (univ-n n (ext c (decode n c a)) (dext-cp n c cc a y)) b P pP (\ y' ->
    nt-eq c cc cc (decode n c (pic n c a b)) (Pi c (decode n c a) (decode n (ext c (decode n c a)) b))
      (decode-n n c cc (pic n c a b) (pic-n n c cc a y b y'))
      (Pi-n c cc (decode n c a) (decode-n n c cc a y) (decode n (ext c (decode n c a)) b)
        (decode-n n (ext c (decode n c a)) (dext-cp n c cc a y) b y'))
      (ge-el-pic cc.1 n.1 y.1 y'.1 y.2.1 y'.2.1))))
 where { P : U l = Id (Ty c) (decode n c (pic n c a b)) (Pi c (decode n c a) (decode n (ext c (decode n c a)) b)) ;
         pP : isProp P = isSetTy c (decode n c (pic n c a b)) (Pi c (decode n c a) (decode n (ext c (decode n c a)) b)) ; } ;

el-uc (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) : Id (Ty c) (decode n c (uc m n lt c)) (univ m c) =
  with-cp c P pP (\ cc ->
    nt-eq c cc cc (decode n c (uc m n lt c)) (univ m c) (decode-n n c cc (uc m n lt c) (uc-n m n lt c cc)) (univ-n m c cc)
      (ge-el-uc cc.1 m.1 n.1 cc.2.1 lt n.2))
 where { P : U l = Id (Ty c) (decode n c (uc m n lt c)) (univ m c) ;
         pP : isProp P = isSetTy c (decode n c (uc m n lt c)) (univ m c) ; } ;

------------------------------------------------------------------------
-- lifting of codes

lf-uc (m n p0 : EM.LevelAt N) (mn : EM.StrictAt N m n) (np : EM.StrictAt N n p0) (mp : EM.StrictAt N m p0) (c : Ctx) :
  Id (El c (univ p0 c)) (lf n p0 np c (uc m n mn c)) (uc m p0 mp c) =
  with-cp c P pP (\ cc ->
    ne-eq c cc cc (univ p0 c) (univ-n p0 c cc) (univ-n p0 c cc) (lf n p0 np c (uc m n mn c)) (uc m p0 mp c)
      (lf-n n p0 np c cc (uc m n mn c) (uc-n m n mn c cc)) (uc-n m p0 mp c cc)
      (gm-lf-uc cc.1 m.1 n.1 p0.1 cc.2.1 mn np p0.2))
 where { P : U l = Id (El c (univ p0 c)) (lf n p0 np c (uc m n mn c)) (uc m p0 mp c) ;
         pP : isProp P = isSetEl c (univ p0 c) (lf n p0 np c (uc m n mn c)) (uc m p0 mp c) ; } ;

lf-lf (m n p0 : EM.LevelAt N) (mn : EM.StrictAt N m n) (np : EM.StrictAt N n p0) (mp : EM.StrictAt N m p0) (c : Ctx)
  (a : El c (univ m c)) :
  Id (El c (univ p0 c)) (lf n p0 np c (lf m n mn c a)) (lf m p0 mp c a) =
  with-cp c P pP (\ cc -> with-ne c cc (univ m c) (univ-n m c cc) a P pP (\ y ->
    ne-eq c cc cc (univ p0 c) (univ-n p0 c cc) (univ-n p0 c cc) (lf n p0 np c (lf m n mn c a)) (lf m p0 mp c a)
      (lf-n n p0 np c cc (lf m n mn c a) (lf-n m n mn c cc a y)) (lf-n m p0 mp c cc a y)
      (gm-lf-lf cc.1 m.1 n.1 p0.1 y.1 y.2.1 mn np p0.2)))
 where { P : U l = Id (El c (univ p0 c)) (lf n p0 np c (lf m n mn c a)) (lf m p0 mp c a) ;
         pP : isProp P = isSetEl c (univ p0 c) (lf n p0 np c (lf m n mn c a)) (lf m p0 mp c a) ; } ;

------------------------------------------------------------------------
-- the laws stated with code-sub, for any proof of univ-nat

UN : U l = (n : EM.LevelAt N) (d c : Ctx) (s : Sub d c) -> Id (Ty d) (subT d c (univ n c) s) (univ n d) ;

module Nat (un : UN) {
  code-sub (n : EM.LevelAt N) (d c : Ctx) (a : El c (univ n c)) (s : Sub d c) : El d (univ n d) =
    subst (Ty d) (El d) (subT d c (univ n c) s) (univ n d) (un n d c s) (subt d c (univ n c) a s) ;

  decode-nat (n : EM.LevelAt N) (d c : Ctx) (a : El c (univ n c)) (s : Sub d c) :
    Id (Ty d) (subT d c (decode n c a) s) (decode n d (code-sub n d c a s)) =
    with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
    with-ne c cc (univ n c) (univ-n n c cc) a P pP (\ y -> with-ns d c cd cc s P pP (\ u ->
      nt-eq d cd cd (subT d c (decode n c a) s) (decode n d (code-sub n d c a s))
        (subT-n d c cd cc (decode n c a) s (decode-n n c cc a y) u)
        (decode-n n d cd (code-sub n d c a s) (cs-n n d c cd cc a y s u (un n d c s)))
        (ge-el-sb cd.1 cc.1 n.1 y.1 u.1 y.2.1 u.2.1)))))
   where { P : U l = Id (Ty d) (subT d c (decode n c a) s) (decode n d (code-sub n d c a s)) ;
           pP : isProp P = isSetTy d (subT d c (decode n c a) s) (decode n d (code-sub n d c a s)) ; } ;

  uc-nat (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (d c : Ctx) (s : Sub d c) :
    Id (El d (univ n d)) (code-sub n d c (uc m n lt c) s) (uc m n lt d) =
    with-cp d P pP (\ cd -> with-cp c P pP (\ cc -> with-ns d c cd cc s P pP (\ u ->
      ne-eq d cd cd (univ n d) (univ-n n d cd) (univ-n n d cd) (code-sub n d c (uc m n lt c) s) (uc m n lt d)
        (cs-n n d c cd cc (uc m n lt c) (uc-n m n lt c cc) s u (un n d c s)) (uc-n m n lt d cd)
        (gm-uc-sb cd.1 cc.1 m.1 n.1 u.1 u.2.1 lt n.2))))
   where { P : U l = Id (El d (univ n d)) (code-sub n d c (uc m n lt c) s) (uc m n lt d) ;
           pP : isProp P = isSetEl d (univ n d) (code-sub n d c (uc m n lt c) s) (uc m n lt d) ; } ;

  lf-nat (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (d c : Ctx) (s : Sub d c) (a : El c (univ m c)) :
    Id (El d (univ n d)) (code-sub n d c (lf m n lt c a) s) (lf m n lt d (code-sub m d c a s)) =
    with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
    with-ne c cc (univ m c) (univ-n m c cc) a P pP (\ y -> with-ns d c cd cc s P pP (\ u ->
      ne-eq d cd cd (univ n d) (univ-n n d cd) (univ-n n d cd) (code-sub n d c (lf m n lt c a) s) (lf m n lt d (code-sub m d c a s))
        (cs-n n d c cd cc (lf m n lt c a) (lf-n m n lt c cc a y) s u (un n d c s))
        (lf-n m n lt d cd (code-sub m d c a s) (cs-n m d c cd cc a y s u (un m d c s)))
        (gm-lf-sb cd.1 cc.1 m.1 n.1 y.1 u.1 y.2.1 u.2.1 lt n.2)))))
   where { P : U l = Id (El d (univ n d)) (code-sub n d c (lf m n lt c a) s) (lf m n lt d (code-sub m d c a s)) ;
           pP : isProp P = isSetEl d (univ n d) (code-sub n d c (lf m n lt c a) s) (lf m n lt d (code-sub m d c a s)) ; } ;

  -- lf-pic, for any path el-lf (lift-binder is the transport of id along it)
  module LfPic (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (a : El c (univ m c))
    (b : El (ext c (decode m c a)) (univ m (ext c (decode m c a))))
    (el : Id (Ty c) (decode n c (lf m n lt c a)) (decode m c a)) {
    X' : Ctx = ext c (decode n c (lf m n lt c a)) ;
    Y' : Ctx = ext c (decode m c a) ;
    LB : Sub X' Y' =
      idJ (Ty c) (decode n c (lf m n lt c a)) (\ B' e' -> Sub X' (ext c B')) (id X') (decode m c a) el ;
    lhs : El c (univ n c) = lf m n lt c (pic m c a b) ;
    rhs : El c (univ n c) = pic n c (lf m n lt c a) (lf m n lt X' (code-sub m X' Y' b LB)) ;
    P : U l = Id (El c (univ n c)) lhs rhs ;
    pP : isProp P = isSetEl c (univ n c) lhs rhs ;
    at (cc : CP c) (y : NC m c cc a) (y' : NC m Y' (dext-cp m c cc a y) b) : P =
      ne-eq c cc cc (univ n c) (univ-n n c cc) (univ-n n c cc) lhs rhs
        (lf-n m n lt c cc (pic m c a b) (pic-n m c cc a y b y'))
        (pic-n n c cc (lf m n lt c a) yl (lf m n lt X' (code-sub m X' Y' b LB))
          (lf-n m n lt X' cX (code-sub m X' Y' b LB) (cs-n m X' Y' cX cY b y' LB uLB (un m X' Y' LB))))
        (gm-trans cc.1 (glf m.1 n.1 (gpic m.1 y.1 y'.1)) (gpic n.1 (glf m.1 n.1 y.1) (glf m.1 n.1 y'.1))
          (gpic n.1 (glf m.1 n.1 y.1) (glf m.1 n.1 (gsb y'.1 gid))) (guu n.1)
          (gm-lf-pic cc.1 m.1 n.1 y.1 y'.1 y.2.1 y'.2.1 lt n.2)
          (gm-epic cc.1 n.1 (glf m.1 n.1 y.1) (glf m.1 n.1 y.1) (glf m.1 n.1 y'.1) (glf m.1 n.1 (gsb y'.1 gid)) yl.2.1
            (gm-refl cc.1 (glf m.1 n.1 y.1) (guu n.1) yl.2.1)
            (gm-ecx cY.1 cX.1 (glf m.1 n.1 y'.1) (glf m.1 n.1 (gsb y'.1 gid)) (guu n.1) cX.2.1 ecYX
              (gm-elf cY.1 m.1 n.1 y'.1 (gsb y'.1 gid)
                (gm-sym cY.1 (gsb y'.1 gid) y'.1 (guu m.1) (gt-uu cY.1 m.1 cY.2.1 m.2) (gm-sb-id cY.1 y'.1 (guu m.1) y'.2.1))
                lt n.2))))
     where {
      yl : NC n c cc (lf m n lt c a) = lf-n m n lt c cc a y ;
      cX : CP X' = dext-cp n c cc (lf m n lt c a) yl ;
      cY : CP Y' = dext-cp m c cc a y ;
      eEl : GDer (gjeqty cc.1 (gel n.1 (glf m.1 n.1 y.1)) (gel m.1 y.1)) = ge-el-lf cc.1 m.1 n.1 y.1 y.2.1 lt n.2 ;
      ecXY : GDer (gjeqcx cX.1 cY.1) =
        gc-ext cc.1 cc.1 (gel n.1 (glf m.1 n.1 y.1)) (gel m.1 y.1) (gc-refl cc.1 cc.2.1) eEl ;
      ecYX : GDer (gjeqcx cY.1 cX.1) =
        gc-ext cc.1 cc.1 (gel m.1 y.1) (gel n.1 (glf m.1 n.1 y.1)) (gc-refl cc.1 cc.2.1)
          (ge-sym cc.1 (gel n.1 (glf m.1 n.1 y.1)) (gel m.1 y.1) eEl) ;
      uLB0 : NS X' Y' (cp-tr (Ty c) (\ z -> X') (decode n c (lf m n lt c a)) (decode m c a) el cX)
          (cp-tr (Ty c) (\ z -> ext c z) (decode n c (lf m n lt c a)) (decode m c a) el cX) LB =
        ns-subst (Ty c) (\ z -> X') (\ z -> ext c z) (decode n c (lf m n lt c a)) (decode m c a) el cX cX
          (id X') (id-n X' cX) ;
      uLB : NS X' Y' cX cY LB =
        ns-move X' Y' (cp-tr (Ty c) (\ z -> X') (decode n c (lf m n lt c a)) (decode m c a) el cX)
          (cp-tr (Ty c) (\ z -> ext c z) (decode n c (lf m n lt c a)) (decode m c a) el cX) cX cY LB uLB0
          (gc-refl cX.1 cX.2.1) ecXY ;
     } ;
    proof : P =
      with-cp c P pP (\ cc -> with-ne c cc (univ m c) (univ-n m c cc) a P pP (\ y ->
      with-ne Y' (dext-cp m c cc a y) (univ m Y') (univ-n m Y' (dext-cp m c cc a y)) b P pP (\ y' -> at cc y y'))) ;
  } ;

  lf-pic-gen (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (a : El c (univ m c))
    (b : El (ext c (decode m c a)) (univ m (ext c (decode m c a))))
    (el : Id (Ty c) (decode n c (lf m n lt c a)) (decode m c a)) :
    Id (El c (univ n c)) (lf m n lt c (pic m c a b))
      (pic n c (lf m n lt c a)
        (lf m n lt (ext c (decode n c (lf m n lt c a)))
          (code-sub m (ext c (decode n c (lf m n lt c a))) (ext c (decode m c a)) b
            (idJ (Ty c) (decode n c (lf m n lt c a)) (\ B' e' -> Sub (ext c (decode n c (lf m n lt c a))) (ext c B'))
              (id (ext c (decode n c (lf m n lt c a)))) (decode m c a) el)))) =
    LfPic[m,n,lt,c,a,b,el].proof ;

  DN : U l = (n : EM.LevelAt N) (d c : Ctx) (a : El c (univ n c)) (s : Sub d c) ->
    Id (Ty d) (subT d c (decode n c a) s) (decode n d (code-sub n d c a s)) ;

  module Nat2 (dn : DN) {
    up-code (n : EM.LevelAt N) (d c : Ctx) (a : El c (univ n c)) (s : Sub d c) :
      Sub (ext d (decode n d (code-sub n d c a s))) (ext c (decode n c a)) =
      subst (Ty d) (\ B -> Sub (ext d B) (ext c (decode n c a)))
        (subT d c (decode n c a) s) (decode n d (code-sub n d c a s)) (dn n d c a s)
        (lift d c (decode n c a) s) ;

    module PicNat (n : EM.LevelAt N) (d c : Ctx) (s : Sub d c) (a : El c (univ n c))
      (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) {
      ca : El d (univ n d) = code-sub n d c a s ;
      D' : Ctx = ext d (decode n d ca) ;
      C' : Ctx = ext c (decode n c a) ;
      UP : Sub D' C' = up-code n d c a s ;
      lhs : El d (univ n d) = code-sub n d c (pic n c a b) s ;
      rhs : El d (univ n d) = pic n d ca (code-sub n D' C' b UP) ;
      P : U l = Id (El d (univ n d)) lhs rhs ;
      pP : isProp P = isSetEl d (univ n d) lhs rhs ;
      at (cd : CP d) (cc : CP c) (y : NC n c cc a) (y' : NC n C' (dext-cp n c cc a y) b) (u : NS d c cd cc s) : P =
        ne-eq d cd cd (univ n d) (univ-n n d cd) (univ-n n d cd) lhs rhs
          (cs-n n d c cd cc (pic n c a b) (pic-n n c cc a y b y') s u (un n d c s))
          (pic-n n d cd ca ya (code-sub n D' C' b UP) (cs-n n D' C' cD' cC' b y' UP uUP (un n D' C' UP)))
          (gm-pic-sb cd.1 cc.1 n.1 y.1 y'.1 u.1 y.2.1 y'.2.1 u.2.1)
       where {
        ya : NC n d cd ca = cs-n n d c cd cc a y s u (un n d c s) ;
        cD' : CP D' = dext-cp n d cd ca ya ;
        cC' : CP C' = dext-cp n c cc a y ;
        xd : NT d cd (subT d c (decode n c a) s) = subT-n d c cd cc (decode n c a) s (decode-n n c cc a y) u ;
        cL : CP (ext d (subT d c (decode n c a) s)) = ext-cp d cd (subT d c (decode n c a) s) xd ;
        uUP0 : NS D' C' (cp-tr (Ty d) (\ z -> ext d z) (subT d c (decode n c a) s) (decode n d ca) (dn n d c a s) cL)
            (cp-tr (Ty d) (\ z -> C') (subT d c (decode n c a) s) (decode n d ca) (dn n d c a s) cC') UP =
          ns-subst (Ty d) (\ z -> ext d z) (\ z -> C') (subT d c (decode n c a) s) (decode n d ca) (dn n d c a s) cL cC'
            (lift d c (decode n c a) s) (lift-n d c cd cc (decode n c a) s (decode-n n c cc a y) u) ;
        uUP : NS D' C' cD' cC' UP =
          ns-move D' C' (cp-tr (Ty d) (\ z -> ext d z) (subT d c (decode n c a) s) (decode n d ca) (dn n d c a s) cL)
            (cp-tr (Ty d) (\ z -> C') (subT d c (decode n c a) s) (decode n d ca) (dn n d c a s) cC') cD' cC' UP uUP0
            (gc-ext cd.1 cd.1 (gsb (gel n.1 y.1) u.1) (gel n.1 (gsb y.1 u.1)) (gc-refl cd.1 cd.2.1)
              (ge-el-sb cd.1 cc.1 n.1 y.1 u.1 y.2.1 u.2.1))
            (gc-refl cC'.1 cC'.2.1) ;
       } ;
      proof : P =
        with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
        with-ne c cc (univ n c) (univ-n n c cc) a P pP (\ y ->
        with-ne C' (dext-cp n c cc a y) (univ n C') (univ-n n C' (dext-cp n c cc a y)) b P pP (\ y' ->
        with-ns d c cd cc s P pP (\ u -> at cd cc y y' u))))) ;
    } ;

    pic-nat (n : EM.LevelAt N) (d c : Ctx) (s : Sub d c) (a : El c (univ n c))
      (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) :
      Id (El d (univ n d)) (code-sub n d c (pic n c a b) s)
        (pic n d (code-sub n d c a s)
          (code-sub n (ext d (decode n d (code-sub n d c a s))) (ext c (decode n c a)) b (up-code n d c a s))) =
      PicNat[n,d,c,s,a,b].proof ;
  } ;
} ;

------------------------------------------------------------------------
-- top-level names (modules are not exported by open)

code-sub-u (un : UN) (n : EM.LevelAt N) (d c : Ctx) (a : El c (univ n c)) (s : Sub d c) : El d (univ n d) =
  Nat[un].code-sub n d c a s ;
DN-u (un : UN) : U l = Nat[un].DN ;
decode-nat-u (un : UN) : DN-u un = Nat[un].decode-nat ;
uc-nat-u (un : UN) (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (d c : Ctx) (s : Sub d c) :
  Id (El d (univ n d)) (code-sub-u un n d c (uc m n lt c) s) (uc m n lt d) = Nat[un].uc-nat m n lt d c s ;
lf-nat-u (un : UN) (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (d c : Ctx) (s : Sub d c) (a : El c (univ m c)) :
  Id (El d (univ n d)) (code-sub-u un n d c (lf m n lt c a) s) (lf m n lt d (code-sub-u un m d c a s)) =
  Nat[un].lf-nat m n lt d c s a ;
lf-pic-u (un : UN) (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (c : Ctx) (a : El c (univ m c))
  (b : El (ext c (decode m c a)) (univ m (ext c (decode m c a))))
  (el : Id (Ty c) (decode n c (lf m n lt c a)) (decode m c a)) :
  Id (El c (univ n c)) (lf m n lt c (pic m c a b))
    (pic n c (lf m n lt c a)
      (lf m n lt (ext c (decode n c (lf m n lt c a)))
        (code-sub-u un m (ext c (decode n c (lf m n lt c a))) (ext c (decode m c a)) b
          (idJ (Ty c) (decode n c (lf m n lt c a)) (\ B' e' -> Sub (ext c (decode n c (lf m n lt c a))) (ext c B'))
            (id (ext c (decode n c (lf m n lt c a)))) (decode m c a) el)))) =
  Nat[un].lf-pic-gen m n lt c a b el ;
pic-nat-u (un : UN) (dn : DN-u un) (n : EM.LevelAt N) (d c : Ctx) (s : Sub d c) (a : El c (univ n c))
  (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) :
  Id (El d (univ n d)) (code-sub-u un n d c (pic n c a b) s)
    (pic n d (code-sub-u un n d c a s)
      (code-sub-u un n (ext d (decode n d (code-sub-u un n d c a s))) (ext c (decode n c a)) b
        (Nat[un].Nat2[dn].up-code n d c a s))) =
  Nat[un].Nat2[dn].pic-nat n d c s a b ;
