-- Semantic category equations and reindexing under identity and composition.
open Base ; open Prelude[l] ; open Paths[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpJudgement ; open B.GAT[l] ;

case-gq-idl (D G s : GE) (r : SoundJ (gjsub D s G)) : SoundJ (gjeqsub D (gcomp gid s) s G) =
  (r.1,(r.2.1,\ d g hd hg -> build d g (r.2.2 d g hd hg)))
 where {
  build (d g : Tel) (f : SubValue d g s) : SubEquality d g (gcomp gid s) s =
    same-sub d g (gcomp gid s) s (C.o (ctx d) (ctx g) (ctx g) (C.id (ctx g)) f.1) f.1
      (comp-down gid s d g g (C.id (ctx g)) f.1 (id-down g) f.2) f.2 (C.o-idl (ctx d) (ctx g) f.1) ;
 } ;

case-gq-idr (D G s : GE) (r : SoundJ (gjsub D s G)) : SoundJ (gjeqsub D (gcomp s gid) s G) =
  (r.1,(r.2.1,\ d g hd hg -> build d g (r.2.2 d g hd hg)))
 where {
  build (d g : Tel) (f : SubValue d g s) : SubEquality d g (gcomp s gid) s =
    same-sub d g (gcomp s gid) s (C.o (ctx d) (ctx d) (ctx g) f.1 (C.id (ctx d))) f.1
      (comp-down s gid d d g f.1 (C.id (ctx d)) f.2 (id-down d)) f.2 (C.o-idr (ctx d) (ctx g) f.1) ;
 } ;

case-gq-assoc (Q T D G s t u : GE) (r : SoundJ (gjsub D s G)) (p : SoundJ (gjsub T t D)) (v : SoundJ (gjsub Q u T)) :
    SoundJ (gjeqsub Q (gcomp (gcomp s t) u) (gcomp s (gcomp t u)) G) =
  (v.1,(r.2.1,\ q g hq hg -> build q g (r.2.2 d g r.1.2 hg) (v.2.2 q j hq p.1.2)))
 where {
  d : Tel = r.1.1 ;
  j : Tel = p.1.1 ;
  w : SubValue j d t = p.2.2 j d p.1.2 r.1.2 ;
  build (q g : Tel) (a : SubValue d g s) (b : SubValue q j u) :
      SubEquality q g (gcomp (gcomp s t) u) (gcomp s (gcomp t u)) =
    same-sub q g (gcomp (gcomp s t) u) (gcomp s (gcomp t u))
      (C.o (ctx q) (ctx j) (ctx g) aw b.1) (C.o (ctx q) (ctx d) (ctx g) a.1 wb)
      (comp-down (gcomp s t) u q j g aw b.1 (comp-down s t j d g a.1 w.1 a.2 w.2) b.2)
      (comp-down s (gcomp t u) q d g a.1 wb a.2 (comp-down t u q j d w.1 b.1 w.2 b.2))
      (C.o-assoc (ctx q) (ctx j) (ctx d) (ctx g) a.1 w.1 b.1)
   where {
    aw : C.Sub (ctx j) (ctx g) = C.o (ctx j) (ctx d) (ctx g) a.1 w.1 ;
    wb : C.Sub (ctx q) (ctx d) = C.o (ctx q) (ctx j) (ctx d) w.1 b.1 ;
   } ;
 } ;

case-gq-eps (G s : GE) (r : SoundJ (gjsub G s gnil)) : SoundJ (gjeqsub G s geps gnil) =
  (r.1,((empty-tel,empty-down),\ d g hd hg ->
    at-context gnil (\ j -> SubEquality d j s geps) (empty-tel,empty-down)
      (build d (r.2.2 d empty-tel hd empty-down)) g hg))
 where {
  build (d : Tel) (f : SubValue d empty-tel s) : SubEquality d empty-tel s geps =
    same-sub d empty-tel s geps f.1 (C.eps (ctx d)) f.2 (eps-down d) (C.eps-uniq (ctx d) f.1) ;
 } ;

case-ge-sb-id (G A : GE) (r : SoundJ (gjty G A)) : SoundJ (gjeqty G (gsb A gid) A) =
  (r.1,\ g hg -> build g (r.2 g hg))
 where {
  build (g : Tel) (a : TypeValue g A) : TypeEquality g (gsb A gid) A =
    same-type g (gsb A gid) A (C.subT (ctx g) (ctx g) a.1 (C.id (ctx g))) a.1
      (ty-sub-down A gid g g a.1 (C.id (ctx g)) a.2 (id-down g)) a.2 (C.subT-id (ctx g) a.1) ;
 } ;

case-gm-sb-id (G a A : GE) (r : SoundJ (gjtm G a A)) : SoundJ (gjeqtm G (gsb a gid) a A) =
  (r.1,\ g hg -> build g (r.2 g hg))
 where {
  build (g : Tel) (a' : TermValue g A a) : TermEquality g A (gsb a gid) a =
    same-term g A (gsb a gid) a (T,v) (a'.1,a'.2.2.1) a'.2.1
      (tm-sub-down a gid g g a'.1 a'.2.2.1 (C.id (ctx g)) a'.2.2.2 (id-down g)) a'.2.2.2
      (term-path g T a'.1 v a'.2.2.1 (C.subT-id (ctx g) a'.1) (C.subt-id (ctx g) a'.1 a'.2.2.1))
   where {
    T : C.Ty (ctx g) = C.subT (ctx g) (ctx g) a'.1 (C.id (ctx g)) ;
    v : C.El (ctx g) T = C.subt (ctx g) (ctx g) a'.1 a'.2.2.1 (C.id (ctx g)) ;
   } ;
 } ;

case-ge-sb-comp (T D G A s t : GE) (r : SoundJ (gjty G A)) (p : SoundJ (gjsub D s G)) (v : SoundJ (gjsub T t D)) :
    SoundJ (gjeqty T (gsb (gsb A s) t) (gsb A (gcomp s t))) =
  (v.1,\ e he -> build e (v.2.2 e d he p.1.2))
 where {
  g : Tel = r.1.1 ;
  d : Tel = p.1.1 ;
  a : TypeValue g A = r.2 g r.1.2 ;
  f : SubValue d g s = p.2.2 d g p.1.2 r.1.2 ;
  B' : C.Ty (ctx d) = C.subT (ctx d) (ctx g) a.1 f.1 ;
  build (e : Tel) (k : SubValue e d t) : TypeEquality e (gsb (gsb A s) t) (gsb A (gcomp s t)) =
    same-type e (gsb (gsb A s) t) (gsb A (gcomp s t)) (C.subT (ctx e) (ctx d) B' k.1) (C.subT (ctx e) (ctx g) a.1 fk)
      (ty-sub-down (gsb A s) t e d B' k.1 (ty-sub-down A s d g a.1 f.1 a.2 f.2) k.2)
      (ty-sub-down A (gcomp s t) e g a.1 fk a.2 (comp-down s t e d g f.1 k.1 f.2 k.2))
      (symH (C.subT-o (ctx e) (ctx d) (ctx g) a.1 f.1 k.1))
   where { fk : C.Sub (ctx e) (ctx g) = C.o (ctx e) (ctx d) (ctx g) f.1 k.1 ; } ;
 } ;

case-gm-sb-comp (T D G a A s t : GE) (r : SoundJ (gjtm G a A)) (p : SoundJ (gjsub D s G)) (v : SoundJ (gjsub T t D)) :
    SoundJ (gjeqtm T (gsb (gsb a s) t) (gsb a (gcomp s t)) (gsb A (gcomp s t))) =
  (v.1,\ e he -> build e (v.2.2 e d he p.1.2))
 where {
  g : Tel = r.1.1 ;
  d : Tel = p.1.1 ;
  a' : TermValue g A a = r.2 g r.1.2 ;
  f : SubValue d g s = p.2.2 d g p.1.2 r.1.2 ;
  B' : C.Ty (ctx d) = C.subT (ctx d) (ctx g) a'.1 f.1 ;
  b : C.El (ctx d) B' = C.subt (ctx d) (ctx g) a'.1 a'.2.2.1 f.1 ;
  build (e : Tel) (k : SubValue e d t) : TermEquality e (gsb A (gcomp s t)) (gsb (gsb a s) t) (gsb a (gcomp s t)) =
    same-term e (gsb A (gcomp s t)) (gsb (gsb a s) t) (gsb a (gcomp s t)) (S',u) (T',w)
      (ty-sub-down A (gcomp s t) e g a'.1 fk a'.2.1 hk)
      (tm-sub-down (gsb a s) t e d B' b k.1 (tm-sub-down a s d g a'.1 a'.2.2.1 f.1 a'.2.2.2 f.2) k.2)
      (tm-sub-down a (gcomp s t) e g a'.1 a'.2.2.1 fk a'.2.2.2 hk)
      (symH (term-path e T' S' w u (C.subT-o (ctx e) (ctx d) (ctx g) a'.1 f.1 k.1)
        (C.subt-o (ctx e) (ctx d) (ctx g) a'.1 a'.2.2.1 f.1 k.1)))
   where {
    fk : C.Sub (ctx e) (ctx g) = C.o (ctx e) (ctx d) (ctx g) f.1 k.1 ;
    hk : SubDown (gcomp s t) e g fk = comp-down s t e d g f.1 k.1 f.2 k.2 ;
    S' : C.Ty (ctx e) = C.subT (ctx e) (ctx d) B' k.1 ;
    T' : C.Ty (ctx e) = C.subT (ctx e) (ctx g) a'.1 fk ;
    u : C.El (ctx e) S' = C.subt (ctx e) (ctx d) B' b k.1 ;
    w : C.El (ctx e) T' = C.subt (ctx e) (ctx g) a'.1 a'.2.2.1 fk ;
   } ;
 } ;
