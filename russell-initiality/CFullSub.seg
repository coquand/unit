-- Simultaneous congruence for substitutions and the type action in FGAT.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FCtx[l] ; open FSubstLaws[l] ; open FSubTransport[l] ;

c-full-comp (T D G s d Q E H t e : FA) (source : CE T Q) (middle : CE D E) (target : CE G H)
    (p : SE D s t G) (q : SE T d e D) : SE T (fcomp T D G s d) (fcomp Q E H t e) G =
  se-trans (comp-eq p q) (se-trans at-middle (se-trans at-source at-target))
 where {
  ht : Sb D t G = (fpresup (fjeqsub D s t G) p).2.2.2 ;
  he : Sb T e D = (fpresup (fjeqsub T d e D) q).2.2.2 ;
  ht' : Sb E t G = move-source D E G t middle ht ;
  he' : Sb T e E = move-target T D E e middle he ;
  at-middle : SE T (fcomp T D G t e) (fcomp T E G t e) G =
    fq-comp-middle T D G t e ht he E middle ;
  at-source : SE T (fcomp T E G t e) (fcomp Q E G t e) G =
    fq-comp-source T E G t e ht' he' Q source ;
  at-target : SE T (fcomp Q E G t e) (fcomp Q E H t e) G =
    se-source Q T G (fcomp Q E G t e) (fcomp Q E H t e) (f-cx-sym T Q source)
      (fq-comp-target Q E G t e ht' (move-source T Q E e source he') H target) ;
 } ;

c-full-tsb (D G A s E H B t : FA) (source : CE D E) (target : CE G H)
    (types : TE G A B) (subs : SE D s t G) : TE D (ftsb D G A s) (ftsb E H B t) =
  sub-frame-eq (wf-left D E source) (wf-right G H target) source target
    type-ends.2.1 type-ends.2.2 types sub-ends.2.2.1 sub-ends.2.2.2 subs
 where {
  type-ends : FPJ (fjeqty G A B) = fpresup (fjeqty G A B) types ;
  sub-ends : FPJ (fjeqsub D s t G) = fpresup (fjeqsub D s t G) subs ;
 } ;

c-full-lift (D G A s E H B t : FA) (source : CE D E) (target : CE G H)
    (types : TE G A B) (subs : SE D s t G) :
    SE (fext D (ftsb D G A s)) (flift D G A s) (flift E H B t) (fext G A) =
  se-trans (fq-lift D G A B s t hA types hs subs)
    (move-se (fext D (ftsb D G B t)) (fext D (ftsb D G A s)) (fext G B) (fext G A)
      (flift D G B t) (flift E H B t) back-source back-target (se-trans at-source at-target))
 where {
  type-ends : FPJ (fjeqty G A B) = fpresup (fjeqty G A B) types ;
  sub-ends : FPJ (fjeqsub D s t G) = fpresup (fjeqsub D s t G) subs ;
  hA : Ty G A = type-ends.2.1 ;
  hB : Ty G B = type-ends.2.2 ;
  hs : Sb D s G = sub-ends.2.2.1 ;
  ht : Sb D t G = sub-ends.2.2.2 ;
  back-source : CE (fext D (ftsb D G B t)) (fext D (ftsb D G A s)) =
    ext-eq (cx-refl sub-ends.1) (ty-sym (sb-ty-cong hA types hs ht subs)) ;
  back-target : CE (fext G B) (fext G A) = ext-eq (cx-refl type-ends.1) (ty-sym types) ;
  at-source : SE (fext D (ftsb D G B t)) (flift D G B t) (flift E G B t) (fext G B) =
    fq-lift-source D G B t ht hB E source ;
  change-source : CE (fext D (ftsb D G B t)) (fext E (ftsb E G B t)) =
    ext-eq source (fe-sb-source D G B t hB ht E source) ;
  at-target : SE (fext D (ftsb D G B t)) (flift E G B t) (flift E H B t) (fext G B) =
    se-source (fext E (ftsb E G B t)) (fext D (ftsb D G B t)) (fext G B)
      (flift E G B t) (flift E H B t) (f-cx-sym (fext D (ftsb D G B t)) (fext E (ftsb E G B t)) change-source)
      (fq-lift-target E G B t (move-source D E G t source ht) hB H target) ;
 } ;

c-full-sec (G A a H B b : FA) (contexts : CE G H) (types : TE G A B) (terms : ME G a b A) :
    SE G (fsec G A a) (fsec H B b) (fext G A) =
  se-trans (fq-sec G A B a b ts.2.1 es.2.2.1 es.2.2.2 types terms)
    (se-target G (fext G B) (fext G A) (fsec G B b) (fsec H B b)
      (ext-eq (cx-refl ts.1) (ty-sym types))
      (fq-sec-context G B b ts.2.2 (tm-conv es.2.2.2 types) H contexts))
 where {
  ts : FPJ (fjeqty G A B) = fpresup (fjeqty G A B) types ;
  es : FPJ (fjeqtm G a b A) = fpresup (fjeqtm G a b A) terms ;
 } ;
