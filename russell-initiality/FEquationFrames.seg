-- Endpoints of the product and substitution equations.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FSubstLaws[l] ;

pi-eq-frame {G A A' B B' : FA} (w : W G) (eqA : TE G A A') (hA : Ty G A) (hA' : Ty G A')
    (hB : Ty (fext G A) B) (hB' : Ty (fext G A) B') : FPJ (fjeqty G (fpi G A B) (fpi G A' B')) =
  (w,(pi-ty hA hB, pi-ty hA' (ty-cx (ext-wf hA') (ext-eq (cx-refl w) eqA) hB'))) ;

lam-eq-frame {G A A' B B' b b' : FA} (w : W G) (eqA : TE G A A') (eqB : TE (fext G A) B B')
    (hA : Ty G A) (hA' : Ty G A') (hB : Ty (fext G A) B) (hB' : Ty (fext G A) B')
    (hb : Tm' (fext G A) b B) (hb' : Tm' (fext G A) b' B) :
    FPJ (fjeqtm G (flam G A B b) (flam G A' B' b') (fpi G A B)) =
  (w,(pi-ty hA hB,(lam-tm hA hB hb,
    tm-conv (lam-tm hA' (ty-cx (ext-wf hA') frame hB') (tm-cx (ext-wf hA') frame (tm-conv hb' eqB)))
      (ty-sym (fe-pi G A A' B B' hA eqA eqB)))))
 where {
  frame : CE (fext G A) (fext G A') = ext-eq (cx-refl w) eqA ;
 } ;

sec-align {G A A' a' : FA} (w : W G) (hA : Ty G A) (hA' : Ty G A') (eqA : TE G A A') (ha' : Tm' G a' A) :
    Sb G (fsec G A' a') (fext G A) =
  sub-cx w (ext-wf hA) (cx-refl w) (ext-eq (cx-refl w) (ty-sym eqA)) (sec-sub hA' (tm-conv ha' eqA)) ;

app-eq-frame {G A A' B B' c c' a a' : FA} (w : W G)
    (eqA : TE G A A') (eqB : TE (fext G A) B B') (eq-a : ME G a a' A)
    (hA : Ty G A) (hA' : Ty G A') (hB : Ty (fext G A) B) (hB' : Ty (fext G A) B')
    (hc : Tm' G c (fpi G A B)) (hc' : Tm' G c' (fpi G A B))
    (ha : Tm' G a A) (ha' : Tm' G a' A) :
    FPJ (fjeqtm G (fapp G A B c a) (fapp G A' B' c' a') (ftsb G (fext G A) B (fsec G A a))) =
  (w,(ty-sub hB left-sec,(app-tm hA hB hc ha,
    tm-conv {G} {fapp G A' B' c' a'} {ftsb G (fext G A') B' (fsec G A' a')} {ftsb G (fext G A) B (fsec G A a)}
      (app-tm hA' (ty-cx (ext-wf hA') frame hB')
      (tm-conv hc' (fe-pi G A A' B B' hA eqA eqB)) (tm-conv ha' eqA))
      (ty-trans
        (ty-sym (fe-sb-target G (fext G A) B' (fsec G A' a') hB' right-sec (fext G A') frame))
        (ty-sym (sb-ty-cong hB eqB left-sec right-sec (fq-sec G A A' a a' hA ha ha' eqA eq-a)))))))
 where {
  frame : CE (fext G A) (fext G A') = ext-eq (cx-refl w) eqA ;
  left-sec : Sb G (fsec G A a) (fext G A) = sec-sub hA ha ;
  right-sec : Sb G (fsec G A' a') (fext G A) = sec-align w hA hA' eqA ha' ;
 } ;

pic-eq-frame {G a a' b b' : FA} (n : Nat) (w : W G) (hU : Ty G (fuu n G))
    (e : ME G a a' (fuu n G)) (ha : Tm' G a (fuu n G)) (ha' : Tm' G a' (fuu n G))
    (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a))))
    (hb' : Tm' (fext G (fel n G a)) b' (fuu n (fext G (fel n G a)))) :
    FPJ (fjeqtm G (fpic n G a b) (fpic n G a' b') (fuu n G)) =
  (w,(hU,(fm-pic G n a b ha hb,
    fm-pic G n a' b' ha'
      (move-universe n (ext-wf (ft-el G n a' ha'))
        (ext-eq (cx-refl w) (fe-el G n a a' e)) (f-universe-bound G G n hU) hb')))) ;

eta-frame {G A B f : FA} (w : W G) (hA : Ty G A) (hB : Ty (fext G A) B) (hf : Tm' G f (fpi G A B)) :
    FPJ (fjeqtm G f (flam G A B (fapp (fext G A) (ftsb (fext G A) G A (fp G A))
      (ftsb (fext (fext G A) (ftsb (fext G A) G A (fp G A))) (fext G A) B (flift (fext G A) G A (fp G A)))
      (fmsb (fext G A) G (fpi G A B) f (fp G A)) (fq G A))) (fpi G A B)) =
  (w,(pi-ty hA hB,(hf,
    lam-tm hA hB
      (tm-conv
        (app-tm (ty-sub hA p) (ty-sub hB t)
          (tm-conv (tm-sub (pi-ty hA hB) hf p) (fe-pi-sb (fext G A) G A B (fp G A) hA hB p)) (q-tm hA))
        (sub-id-from (ext-wf hA) hB t (sec-sub (ty-sub hA p) (q-tm hA)) (fq-lift-p-sec-q G A hA))))))
 where {
  p : Sb (fext G A) (fp G A) G = p-sub hA ;
  t : Sb (fext (fext G A) (ftsb (fext G A) G A (fp G A))) (flift (fext G A) G A (fp G A)) (fext G A) =
    lift-sub hA p ;
 } ;

lift-pic-frame {G a b : FA} (n p : Nat) (w : W G)
    (ha : Tm' G a (fuu n G)) (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a))))
    (le : LeN (suc n) p) (nb : LeN p N) :
    FPJ (fjeqtm G (flf n p G (fpic n G a b)) (fpic p G (flf n p G a) (flf n p (fext G (fel n G a)) b)) (fuu p G)) =
  (w,(ft-uu G p w nb,(fm-lf G n p (fpic n G a b) (fm-pic G n a b ha hb) le nb,
    fm-pic G p (flf n p G a) (flf n p (fext G (fel n G a)) b) ha'
      (move-universe {fext G (fel n G a)} {fext G (fel p G (flf n p G a))} {flf n p (fext G (fel n G a)) b}
        p (ext-wf (ft-el G p (flf n p G a) ha'))
        (ext-eq (cx-refl w) (ty-sym (fe-el-lf G n p a ha le nb))) nb
        (fm-lf (fext G (fel n G a)) n p b hb le nb)))))
 where {
  ha' : Tm' G (flf n p G a) (fuu p G) = fm-lf G n p a ha le nb ;
 } ;

lam-sub-frame {D G A B b s : FA} (w : W D) (hA : Ty G A) (hB : Ty (fext G A) B)
    (hb : Tm' (fext G A) b B) (hs : Sb D s G) :
    FPJ (fjeqtm D (fmsb D G (fpi G A B) (flam G A B b) s)
      (flam D (ftsb D G A s) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fmsb (fext D (ftsb D G A s)) (fext G A) B b (flift D G A s)))
      (fpi D (ftsb D G A s) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s)))) =
  (w,(pi-ty (ty-sub hA hs) (ty-sub hB t),
    (tm-conv (tm-sub (pi-ty hA hB) (lam-tm hA hB hb) hs) (fe-pi-sb D G A B s hA hB hs),
     lam-tm (ty-sub hA hs) (ty-sub hB t) (tm-sub hB hb t))))
 where {
  t : Sb (fext D (ftsb D G A s)) (flift D G A s) (fext G A) = lift-sub hA hs ;
 } ;

app-sub-frame {D G A B c a s : FA} (w : W D) (hA : Ty G A) (hB : Ty (fext G A) B)
    (hc : Tm' G c (fpi G A B)) (ha : Tm' G a A) (hs : Sb D s G) :
    FPJ (fjeqtm D (fmsb D G (ftsb G (fext G A) B (fsec G A a)) (fapp G A B c a) s)
      (fapp D (ftsb D G A s) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fmsb D G (fpi G A B) c s) (fmsb D G A a s))
      (ftsb D (fext D (ftsb D G A s)) (ftsb (fext D (ftsb D G A s)) (fext G A) B (flift D G A s))
        (fsec D (ftsb D G A s) (fmsb D G A a s)))) =
  (w,(ty-sub (ty-sub hB t) (sec-sub (ty-sub hA hs) (tm-sub hA ha hs)),
    (tm-conv (tm-sub (ty-sub hB (sec-sub hA ha)) (app-tm hA hB hc ha) hs) (sub-sec-comp hA hB ha hs),
     app-tm (ty-sub hA hs) (ty-sub hB t)
       (tm-conv (tm-sub (pi-ty hA hB) hc hs) (fe-pi-sb D G A B s hA hB hs)) (tm-sub hA ha hs))))
 where {
  t : Sb (fext D (ftsb D G A s)) (flift D G A s) (fext G A) = lift-sub hA hs ;
 } ;

pic-sub-frame {D G a b s : FA} (n : Nat) (w : W D) (hU : Ty G (fuu n G))
    (hUext : Ty (fext G (fel n G a)) (fuu n (fext G (fel n G a))))
    (ha : Tm' G a (fuu n G)) (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a)))) (hs : Sb D s G) :
    FPJ (fjeqtm D (fmsb D G (fuu n G) (fpic n G a b) s)
      (fpic n D (fmsb D G (fuu n G) a s)
        (fmsb (fext D (ftsb D G (fel n G a) s)) (fext G (fel n G a)) (fuu n (fext G (fel n G a))) b
          (flift D G (fel n G a) s))) (fuu n D)) =
  (w,(ft-uu D n w nb,(sub-universe n hU (fm-pic G n a b ha hb) hs,
    fm-pic D n (fmsb D G (fuu n G) a s)
      (fmsb (fext D (ftsb D G (fel n G a) s)) (fext G (fel n G a)) (fuu n (fext G (fel n G a))) b
          (flift D G (fel n G a) s)) ha'
      (move-universe {fext D (ftsb D G (fel n G a) s)} {fext D (fel n D (fmsb D G (fuu n G) a s))}
        {fmsb (fext D (ftsb D G (fel n G a) s)) (fext G (fel n G a)) (fuu n (fext G (fel n G a))) b
          (flift D G (fel n G a) s)} n (ext-wf (ft-el D n (fmsb D G (fuu n G) a s) ha'))
        (ext-eq (cx-refl w) (fe-el-sb D G n a s ha hs)) nb
        (sub-universe n hUext hb (lift-sub (ft-el G n a ha) hs))))))
 where {
  nb : LeN n N = f-universe-bound G G n hU ;
  ha' : Tm' D (fmsb D G (fuu n G) a s) (fuu n D) = sub-universe n hU ha hs ;
 } ;
