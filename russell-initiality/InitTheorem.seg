-- InitTheorem.seg (PLAN-INIT, Part T): initiality of the term model of T_E.
-- For every level bound N and every Ehrhard model M of level N (at the
-- universe level l of the syntax), there is a morphism from the term model
-- TM (InitModel: derivable judgements modulo judgemental equality) to M,
-- namely the interpretation (InitExistHom.exist), and every morphism
-- TM -> M agrees with it (InitUniq.init-uniq).
-- Used inside module Initial (l) (M) of InitCheck.seg (free names l, N, M).
module EM = EhrhardTEModel[l] ;
TM : EM.TEModel[N] = InitModel[l].TM ;
module Mo = InitHom.Morphism[l,N,TM,M] ;
Hom : U l = Mo.InitHomLaws.Hom ;
Agree (H H' : Hom) : U l = Mo.InitHomLaws.Agree[H,H'] ;

existence : Hom = Exist[l,M].InitExistHom.exist InitModel[l].eqs ;

uniqueness (H : Hom) : Agree H existence =
  InitUniq[l].init-uniq InitModel[l].eqs M H existence ;

-- any two morphisms agree
uniqueness2 (H H' : Hom) : Agree H H' =
  InitUniq[l].init-uniq InitModel[l].eqs M H H' ;
