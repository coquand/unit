-- GLean.seg: the lean Ehrhard-GAT, without the admissible premises that
-- GAT.GDer carries, and the two translations:
--   to-glean : GDer J -> GDerL J    forgets the extra premises
--   to-gder  : GDerL J -> GDer J    recovers them by GPresup.gpresup,
--                                    inversion of |- G.A and Pi-inversion
-- Dropped premises: gm-app G |- A ; gm-sb G |- A ; ge-sb G |- A, s, s' typed ;
-- gm-sym G |- A ; ge-pi, gm-elam, gm-eapp G |- A ; gm-eapp G.A |- B, a : A ;
-- gm-epic a : U_n ; gm-esb G |- A, a : A, s, s' typed ; gm-beta, gm-eta
-- G |- A, G.A |- B ; gq-lift G |- A, s typed ; gq-sec G |- A, a, a' : A.
-- (Body generated from GAT.seg by gen_glean.py.)

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open GAT[l] ; open GPresup[l] ;

------------------------------------------------------------------------
-- inversion of |- G.A  (only g-ext concludes it)

ExtInvC : GE -> U l = split {
  gnil -> Top ;
  gext G A -> GDer (gjty G A) ;
  gpi A B -> Top ;
  guu n -> Top ;
  gel n a -> Top ;
  gsb t s -> Top ;
  glam A B b -> Top ;
  gapp A B c a -> Top ;
  gpic n a b -> Top ;
  guc m n -> Top ;
  glf m n a -> Top ;
  gq -> Top ;
  gid -> Top ;
  gcomp s d -> Top ;
  geps -> Top ;
  gp -> Top ;
  glift A s -> Top ;
  gsec A a -> Top } ;

ExtInv : GJ -> U l = split {
  gjwf X -> ExtInvC X ; gjty G A -> Top ; gjtm G a A -> Top ; gjsub D s G -> Top ; gjeqcx G D -> Top ;
  gjeqty G A B -> Top ; gjeqtm G a b A -> Top ; gjeqsub D s t G -> Top } ;

ext-inv : (J : GJ) -> GDer J -> ExtInv J = split {
  g-nil -> tt ;
  g-ext G A h -> h ;
  gc-nil -> tt ;
  gc-refl G h -> tt ;
  gc-ext G D A B h1 h2 -> tt ;
  gs-id G h -> tt ;
  gs-comp T D G s d h1 h2 -> tt ;
  gs-eps G h -> tt ;
  gs-p G A h -> tt ;
  gs-lift D G A s h1 h2 -> tt ;
  gs-sec G A a h1 h2 -> tt ;
  gs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  gt-pi G A B h1 h2 -> tt ;
  gt-uu G n h nb -> tt ;
  gt-el G n a h -> tt ;
  gt-sb D G A s h1 h2 -> tt ;
  gt-cx G D A h0 h1 h2 -> tt ;
  gm-lam G A B b h1 h2 h3 -> tt ;
  gm-app G A B c a h1 h2 h3 h4 -> tt ;
  gm-pic G n a b h1 h2 -> tt ;
  gm-uc G m n h lt nb -> tt ;
  gm-lf G m n a h le nb -> tt ;
  gm-q G A h -> tt ;
  gm-sb D G a A s hA h1 h2 -> tt ;
  gm-conv G a A B h1 h2 -> tt ;
  gm-cx G D a A h0 h1 h2 -> tt ;
  ge-refl G A h -> tt ;
  ge-sym G A B h -> tt ;
  ge-trans G A B C h1 h2 -> tt ;
  ge-pi G A A' B B' h0 h1 h2 -> tt ;
  ge-el G n a a' h -> tt ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ge-el-lf G m n a h le nb -> tt ;
  ge-el-pic G n a b h1 h2 -> tt ;
  ge-el-uc G m n h lt nb -> tt ;
  ge-sb-id G A h -> tt ;
  ge-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ge-pi-sb D G A B s h1 h2 h3 -> tt ;
  ge-uu-sb D G n s h nb -> tt ;
  ge-el-sb D G n a s h1 h2 -> tt ;
  ge-cx G D A B h0 h1 h2 -> tt ;
  gm-refl G a A h -> tt ;
  gm-sym G a b A hA h -> tt ;
  gm-trans G a b c A h1 h2 -> tt ;
  gm-eqconv G a b A B h1 h2 -> tt ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  gm-epic G n a a' b b' h0 h1 h2 -> tt ;
  gm-elf G m n a a' h le nb -> tt ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  gm-beta G A B b a hA hB h1 h2 -> tt ;
  gm-eta G A B f hA hB h -> tt ;
  gm-lf-pic G n p a b h1 h2 le nb -> tt ;
  gm-lf-uc G m n p h lt le nb -> tt ;
  gm-lf-lf G m n p a h le1 le2 nb -> tt ;
  gm-sb-id G a A h -> tt ;
  gm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  gm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  gm-uc-sb D G m n s h lt nb -> tt ;
  gm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  gm-q-lift D G A s h1 h2 -> tt ;
  gm-q-sec G A a h1 h2 -> tt ;
  gm-ecx G D a b A h0 h1 h2 -> tt ;
  gq-refl D s G h -> tt ;
  gq-sym D s t G h -> tt ;
  gq-trans D s t u G h1 h2 -> tt ;
  gq-comp T D G s s' d d' h1 h2 -> tt ;
  gq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  gq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  gq-idl D G s h -> tt ;
  gq-idr D G s h -> tt ;
  gq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  gq-eps G s h -> tt ;
  gq-lift-id G A h -> tt ;
  gq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  gq-p-lift D G A s h1 h2 -> tt ;
  gq-p-sec G A a h1 h2 -> tt ;
  gq-sec-comp D G A a s h1 h2 h3 -> tt ;
  gq-lift-p-sec-q G A h -> tt } ;

wf-ext-inv (G A : GE) (w : GDer (gjwf (gext G A))) : GDer (gjty G A) = ext-inv (gjwf (gext G A)) w ;

------------------------------------------------------------------------
-- Pi-inversion of type derivations, through context conversion gt-cx

PiInvG (G : GE) : GE -> U l = split {
  gnil -> Top ;
  gext G A -> Top ;
  gpi A B -> GDer (gjty G A) * GDer (gjty (gext G A) B) ;
  guu n -> Top ;
  gel n a -> Top ;
  gsb t s -> Top ;
  glam A B b -> Top ;
  gapp A B c a -> Top ;
  gpic n a b -> Top ;
  guc m n -> Top ;
  glf m n a -> Top ;
  gq -> Top ;
  gid -> Top ;
  gcomp s d -> Top ;
  geps -> Top ;
  gp -> Top ;
  glift A s -> Top ;
  gsec A a -> Top } ;

pinv-cx (G D : GE) (w : GDer (gjwf D)) (c : GDer (gjeqcx G D)) : (T : GE) -> PiInvG G T -> PiInvG D T = split {
  gnil -> \ p -> tt ;
  gext G A -> \ p -> tt ;
  gpi A B -> \ p -> (gt-cx G D A w c p.1, gt-cx (gext G A) (gext D A) B (g-ext D A (gt-cx G D A w c p.1)) (gc-ext G D A A c (ge-refl G A p.1)) p.2) ;
  guu n -> \ p -> tt ;
  gel n a -> \ p -> tt ;
  gsb t s -> \ p -> tt ;
  glam A B b -> \ p -> tt ;
  gapp A B c a -> \ p -> tt ;
  gpic n a b -> \ p -> tt ;
  guc m n -> \ p -> tt ;
  glf m n a -> \ p -> tt ;
  gq -> \ p -> tt ;
  gid -> \ p -> tt ;
  gcomp s d -> \ p -> tt ;
  geps -> \ p -> tt ;
  gp -> \ p -> tt ;
  glift A s -> \ p -> tt ;
  gsec A a -> \ p -> tt } ;

InvPiG : GJ -> U l = split {
  gjwf X -> Top ; gjty G T -> PiInvG G T ; gjtm G a A -> Top ; gjsub D s G -> Top ; gjeqcx G D -> Top ;
  gjeqty G A B -> Top ; gjeqtm G a b A -> Top ; gjeqsub D s t G -> Top } ;

ginv-pi : (J : GJ) -> GDer J -> InvPiG J = split {
  g-nil -> tt ;
  g-ext G A h -> tt ;
  gc-nil -> tt ;
  gc-refl G h -> tt ;
  gc-ext G D A B h1 h2 -> tt ;
  gs-id G h -> tt ;
  gs-comp T D G s d h1 h2 -> tt ;
  gs-eps G h -> tt ;
  gs-p G A h -> tt ;
  gs-lift D G A s h1 h2 -> tt ;
  gs-sec G A a h1 h2 -> tt ;
  gs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  gt-pi G A B h1 h2 -> (h1, h2) ;
  gt-uu G n h nb -> tt ;
  gt-el G n a h -> tt ;
  gt-sb D G A s h1 h2 -> tt ;
  gt-cx G D A h0 h1 h2 | r0 r1 r2 -> pinv-cx G D h0 h1 A r2 ;
  gm-lam G A B b h1 h2 h3 -> tt ;
  gm-app G A B c a h1 h2 h3 h4 -> tt ;
  gm-pic G n a b h1 h2 -> tt ;
  gm-uc G m n h lt nb -> tt ;
  gm-lf G m n a h le nb -> tt ;
  gm-q G A h -> tt ;
  gm-sb D G a A s hA h1 h2 -> tt ;
  gm-conv G a A B h1 h2 -> tt ;
  gm-cx G D a A h0 h1 h2 -> tt ;
  ge-refl G A h -> tt ;
  ge-sym G A B h -> tt ;
  ge-trans G A B C h1 h2 -> tt ;
  ge-pi G A A' B B' h0 h1 h2 -> tt ;
  ge-el G n a a' h -> tt ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ge-el-lf G m n a h le nb -> tt ;
  ge-el-pic G n a b h1 h2 -> tt ;
  ge-el-uc G m n h lt nb -> tt ;
  ge-sb-id G A h -> tt ;
  ge-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ge-pi-sb D G A B s h1 h2 h3 -> tt ;
  ge-uu-sb D G n s h nb -> tt ;
  ge-el-sb D G n a s h1 h2 -> tt ;
  ge-cx G D A B h0 h1 h2 -> tt ;
  gm-refl G a A h -> tt ;
  gm-sym G a b A hA h -> tt ;
  gm-trans G a b c A h1 h2 -> tt ;
  gm-eqconv G a b A B h1 h2 -> tt ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  gm-epic G n a a' b b' h0 h1 h2 -> tt ;
  gm-elf G m n a a' h le nb -> tt ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  gm-beta G A B b a hA hB h1 h2 -> tt ;
  gm-eta G A B f hA hB h -> tt ;
  gm-lf-pic G n p a b h1 h2 le nb -> tt ;
  gm-lf-uc G m n p h lt le nb -> tt ;
  gm-lf-lf G m n p a h le1 le2 nb -> tt ;
  gm-sb-id G a A h -> tt ;
  gm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  gm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  gm-uc-sb D G m n s h lt nb -> tt ;
  gm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  gm-q-lift D G A s h1 h2 -> tt ;
  gm-q-sec G A a h1 h2 -> tt ;
  gm-ecx G D a b A h0 h1 h2 -> tt ;
  gq-refl D s G h -> tt ;
  gq-sym D s t G h -> tt ;
  gq-trans D s t u G h1 h2 -> tt ;
  gq-comp T D G s s' d d' h1 h2 -> tt ;
  gq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  gq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  gq-idl D G s h -> tt ;
  gq-idr D G s h -> tt ;
  gq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  gq-eps G s h -> tt ;
  gq-lift-id G A h -> tt ;
  gq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  gq-p-lift D G A s h1 h2 -> tt ;
  gq-p-sec G A a h1 h2 -> tt ;
  gq-sec-comp D G A a s h1 h2 h3 -> tt ;
  gq-lift-p-sec-q G A h -> tt } ;

ty-gpi-inv (G A B : GE) (h : GDer (gjty G (gpi A B))) : GDer (gjty G A) * GDer (gjty (gext G A) B) =
  ginv-pi (gjty G (gpi A B)) h ;

------------------------------------------------------------------------
-- the lean system and the translations

data GDerL : (J : GJ) -> U l =
    lg-nil : GDerL (gjwf gnil)
  | lg-ext (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjwf (gext G A))
  | lgc-nil : GDerL (gjeqcx gnil gnil)
  | lgc-refl (G : GE) (h : GDerL (gjwf G)) : GDerL (gjeqcx G G)
  | lgc-ext (G : GE) (D : GE) (A : GE) (B : GE) (h1 : GDerL (gjeqcx G D)) (h2 : GDerL (gjeqty G A B)) : GDerL (gjeqcx (gext G A) (gext D B))
  | lgs-id (G : GE) (h : GDerL (gjwf G)) : GDerL (gjsub G gid G)
  | lgs-comp (T : GE) (D : GE) (G : GE) (s : GE) (d : GE) (h1 : GDerL (gjsub D s G)) (h2 : GDerL (gjsub T d D)) : GDerL (gjsub T (gcomp s d) G)
  | lgs-eps (G : GE) (h : GDerL (gjwf G)) : GDerL (gjsub G geps gnil)
  | lgs-p (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjsub (gext G A) gp G)
  | lgs-lift (D : GE) (G : GE) (A : GE) (s : GE) (h1 : GDerL (gjsub D s G)) (h2 : GDerL (gjty G A)) : GDerL (gjsub (gext D (gsb A s)) (glift A s) (gext G A))
  | lgs-sec (G : GE) (A : GE) (a : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjtm G a A)) : GDerL (gjsub G (gsec A a) (gext G A))
  | lgs-cx (D : GE) (D' : GE) (G : GE) (G' : GE) (s : GE) (h0 : GDerL (gjwf D')) (h0' : GDerL (gjwf G')) (h1 : GDerL (gjeqcx D D')) (h2 : GDerL (gjeqcx G G')) (h : GDerL (gjsub D s G)) : GDerL (gjsub D' s G')
  | lgt-pi (G : GE) (A : GE) (B : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjty (gext G A) B)) : GDerL (gjty G (gpi A B))
  | lgt-uu (G : GE) (n : Nat) (h : GDerL (gjwf G)) (nb : LeN n N) : GDerL (gjty G (guu n))
  | lgt-el (G : GE) (n : Nat) (a : GE) (h : GDerL (gjtm G a (guu n))) : GDerL (gjty G (gel n a))
  | lgt-sb (D : GE) (G : GE) (A : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjsub D s G)) : GDerL (gjty D (gsb A s))
  | lgt-cx (G : GE) (D : GE) (A : GE) (h0 : GDerL (gjwf D)) (h1 : GDerL (gjeqcx G D)) (h2 : GDerL (gjty G A)) : GDerL (gjty D A)
  | lgm-lam (G : GE) (A : GE) (B : GE) (b : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjty (gext G A) B)) (h3 : GDerL (gjtm (gext G A) b B)) : GDerL (gjtm G (glam A B b) (gpi A B))
  | lgm-app (G : GE) (A : GE) (B : GE) (c : GE) (a : GE) (h2 : GDerL (gjty (gext G A) B)) (h3 : GDerL (gjtm G c (gpi A B))) (h4 : GDerL (gjtm G a A)) : GDerL (gjtm G (gapp A B c a) (gsb B (gsec A a)))
  | lgm-pic (G : GE) (n : Nat) (a : GE) (b : GE) (h1 : GDerL (gjtm G a (guu n))) (h2 : GDerL (gjtm (gext G (gel n a)) b (guu n))) : GDerL (gjtm G (gpic n a b) (guu n))
  | lgm-uc (G : GE) (m : Nat) (n : Nat) (h : GDerL (gjwf G)) (lt : LeN (suc m) n) (nb : LeN n N) : GDerL (gjtm G (guc m n) (guu n))
  | lgm-lf (G : GE) (m : Nat) (n : Nat) (a : GE) (h : GDerL (gjtm G a (guu m))) (le : LeN (suc m) n) (nb : LeN n N) : GDerL (gjtm G (glf m n a) (guu n))
  | lgm-q (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjtm (gext G A) gq (gsb A gp))
  | lgm-sb (D : GE) (G : GE) (a : GE) (A : GE) (s : GE) (h1 : GDerL (gjtm G a A)) (h2 : GDerL (gjsub D s G)) : GDerL (gjtm D (gsb a s) (gsb A s))
  | lgm-conv (G : GE) (a : GE) (A : GE) (B : GE) (h1 : GDerL (gjtm G a A)) (h2 : GDerL (gjeqty G A B)) : GDerL (gjtm G a B)
  | lgm-cx (G : GE) (D : GE) (a : GE) (A : GE) (h0 : GDerL (gjwf D)) (h1 : GDerL (gjeqcx G D)) (h2 : GDerL (gjtm G a A)) : GDerL (gjtm D a A)
  | lge-refl (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjeqty G A A)
  | lge-sym (G : GE) (A : GE) (B : GE) (h : GDerL (gjeqty G A B)) : GDerL (gjeqty G B A)
  | lge-trans (G : GE) (A : GE) (B : GE) (C : GE) (h1 : GDerL (gjeqty G A B)) (h2 : GDerL (gjeqty G B C)) : GDerL (gjeqty G A C)
  | lge-pi (G : GE) (A : GE) (A' : GE) (B : GE) (B' : GE) (h1 : GDerL (gjeqty G A A')) (h2 : GDerL (gjeqty (gext G A) B B')) : GDerL (gjeqty G (gpi A B) (gpi A' B'))
  | lge-el (G : GE) (n : Nat) (a : GE) (a' : GE) (h : GDerL (gjeqtm G a a' (guu n))) : GDerL (gjeqty G (gel n a) (gel n a'))
  | lge-sb (D : GE) (G : GE) (A : GE) (A' : GE) (s : GE) (s' : GE) (h1 : GDerL (gjeqty G A A')) (h4 : GDerL (gjeqsub D s s' G)) : GDerL (gjeqty D (gsb A s) (gsb A' s'))
  | lge-el-lf (G : GE) (m : Nat) (n : Nat) (a : GE) (h : GDerL (gjtm G a (guu m))) (le : LeN (suc m) n) (nb : LeN n N) : GDerL (gjeqty G (gel n (glf m n a)) (gel m a))
  | lge-el-pic (G : GE) (n : Nat) (a : GE) (b : GE) (h1 : GDerL (gjtm G a (guu n))) (h2 : GDerL (gjtm (gext G (gel n a)) b (guu n))) : GDerL (gjeqty G (gel n (gpic n a b)) (gpi (gel n a) (gel n b)))
  | lge-el-uc (G : GE) (m : Nat) (n : Nat) (h : GDerL (gjwf G)) (lt : LeN (suc m) n) (nb : LeN n N) : GDerL (gjeqty G (gel n (guc m n)) (guu m))
  | lge-sb-id (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjeqty G (gsb A gid) A)
  | lge-sb-comp (T : GE) (D : GE) (G : GE) (A : GE) (s : GE) (d : GE) (h0 : GDerL (gjty G A)) (h1 : GDerL (gjsub D s G)) (h2 : GDerL (gjsub T d D)) : GDerL (gjeqty T (gsb (gsb A s) d) (gsb A (gcomp s d)))
  | lge-pi-sb (D : GE) (G : GE) (A : GE) (B : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjty (gext G A) B)) (h3 : GDerL (gjsub D s G)) : GDerL (gjeqty D (gsb (gpi A B) s) (gpi (gsb A s) (gsb B (glift A s))))
  | lge-uu-sb (D : GE) (G : GE) (n : Nat) (s : GE) (h : GDerL (gjsub D s G)) (nb : LeN n N) : GDerL (gjeqty D (gsb (guu n) s) (guu n))
  | lge-el-sb (D : GE) (G : GE) (n : Nat) (a : GE) (s : GE) (h1 : GDerL (gjtm G a (guu n))) (h2 : GDerL (gjsub D s G)) : GDerL (gjeqty D (gsb (gel n a) s) (gel n (gsb a s)))
  | lge-cx (G : GE) (D : GE) (A : GE) (B : GE) (h0 : GDerL (gjwf D)) (h1 : GDerL (gjeqcx G D)) (h2 : GDerL (gjeqty G A B)) : GDerL (gjeqty D A B)
  | lgm-refl (G : GE) (a : GE) (A : GE) (h : GDerL (gjtm G a A)) : GDerL (gjeqtm G a a A)
  | lgm-sym (G : GE) (a : GE) (b : GE) (A : GE) (h : GDerL (gjeqtm G a b A)) : GDerL (gjeqtm G b a A)
  | lgm-trans (G : GE) (a : GE) (b : GE) (c : GE) (A : GE) (h1 : GDerL (gjeqtm G a b A)) (h2 : GDerL (gjeqtm G b c A)) : GDerL (gjeqtm G a c A)
  | lgm-eqconv (G : GE) (a : GE) (b : GE) (A : GE) (B : GE) (h1 : GDerL (gjeqtm G a b A)) (h2 : GDerL (gjeqty G A B)) : GDerL (gjeqtm G a b B)
  | lgm-elam (G : GE) (A : GE) (A' : GE) (B : GE) (B' : GE) (b : GE) (b' : GE) (h1 : GDerL (gjeqty G A A')) (h2 : GDerL (gjeqty (gext G A) B B')) (h3 : GDerL (gjeqtm (gext G A) b b' B)) : GDerL (gjeqtm G (glam A B b) (glam A' B' b') (gpi A B))
  | lgm-eapp (G : GE) (A : GE) (A' : GE) (B : GE) (B' : GE) (c : GE) (c' : GE) (a : GE) (a' : GE) (h1 : GDerL (gjeqty G A A')) (h2 : GDerL (gjeqty (gext G A) B B')) (h3 : GDerL (gjeqtm G c c' (gpi A B))) (h4 : GDerL (gjeqtm G a a' A)) : GDerL (gjeqtm G (gapp A B c a) (gapp A' B' c' a') (gsb B (gsec A a)))
  | lgm-epic (G : GE) (n : Nat) (a : GE) (a' : GE) (b : GE) (b' : GE) (h1 : GDerL (gjeqtm G a a' (guu n))) (h2 : GDerL (gjeqtm (gext G (gel n a)) b b' (guu n))) : GDerL (gjeqtm G (gpic n a b) (gpic n a' b') (guu n))
  | lgm-elf (G : GE) (m : Nat) (n : Nat) (a : GE) (a' : GE) (h : GDerL (gjeqtm G a a' (guu m))) (le : LeN (suc m) n) (nb : LeN n N) : GDerL (gjeqtm G (glf m n a) (glf m n a') (guu n))
  | lgm-esb (D : GE) (G : GE) (a : GE) (a' : GE) (A : GE) (s : GE) (s' : GE) (h1 : GDerL (gjeqtm G a a' A)) (h4 : GDerL (gjeqsub D s s' G)) : GDerL (gjeqtm D (gsb a s) (gsb a' s') (gsb A s))
  | lgm-beta (G : GE) (A : GE) (B : GE) (b : GE) (a : GE) (h1 : GDerL (gjtm (gext G A) b B)) (h2 : GDerL (gjtm G a A)) : GDerL (gjeqtm G (gapp A B (glam A B b) a) (gsb b (gsec A a)) (gsb B (gsec A a)))
  | lgm-eta (G : GE) (A : GE) (B : GE) (f : GE) (h : GDerL (gjtm G f (gpi A B))) : GDerL (gjeqtm G f (glam A B (gapp (gsb A gp) (gsb B (glift A gp)) (gsb f gp) gq)) (gpi A B))
  | lgm-lf-pic (G : GE) (n : Nat) (p : Nat) (a : GE) (b : GE) (h1 : GDerL (gjtm G a (guu n))) (h2 : GDerL (gjtm (gext G (gel n a)) b (guu n))) (le : LeN (suc n) p) (nb : LeN p N) : GDerL (gjeqtm G (glf n p (gpic n a b)) (gpic p (glf n p a) (glf n p b)) (guu p))
  | lgm-lf-uc (G : GE) (m : Nat) (n : Nat) (p : Nat) (h : GDerL (gjwf G)) (lt : LeN (suc m) n) (le : LeN (suc n) p) (nb : LeN p N) : GDerL (gjeqtm G (glf n p (guc m n)) (guc m p) (guu p))
  | lgm-lf-lf (G : GE) (m : Nat) (n : Nat) (p : Nat) (a : GE) (h : GDerL (gjtm G a (guu m))) (le1 : LeN (suc m) n) (le2 : LeN (suc n) p) (nb : LeN p N) : GDerL (gjeqtm G (glf n p (glf m n a)) (glf m p a) (guu p))
  | lgm-sb-id (G : GE) (a : GE) (A : GE) (h : GDerL (gjtm G a A)) : GDerL (gjeqtm G (gsb a gid) a A)
  | lgm-sb-comp (T : GE) (D : GE) (G : GE) (a : GE) (A : GE) (s : GE) (d : GE) (h0 : GDerL (gjtm G a A)) (h1 : GDerL (gjsub D s G)) (h2 : GDerL (gjsub T d D)) : GDerL (gjeqtm T (gsb (gsb a s) d) (gsb a (gcomp s d)) (gsb A (gcomp s d)))
  | lgm-lam-sb (D : GE) (G : GE) (A : GE) (B : GE) (b : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjty (gext G A) B)) (h3 : GDerL (gjtm (gext G A) b B)) (h4 : GDerL (gjsub D s G)) : GDerL (gjeqtm D (gsb (glam A B b) s) (glam (gsb A s) (gsb B (glift A s)) (gsb b (glift A s))) (gpi (gsb A s) (gsb B (glift A s))))
  | lgm-app-sb (D : GE) (G : GE) (A : GE) (B : GE) (c : GE) (a : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjty (gext G A) B)) (h3 : GDerL (gjtm G c (gpi A B))) (h4 : GDerL (gjtm G a A)) (h5 : GDerL (gjsub D s G)) : GDerL (gjeqtm D (gsb (gapp A B c a) s) (gapp (gsb A s) (gsb B (glift A s)) (gsb c s) (gsb a s)) (gsb (gsb B (glift A s)) (gsec (gsb A s) (gsb a s))))
  | lgm-pic-sb (D : GE) (G : GE) (n : Nat) (a : GE) (b : GE) (s : GE) (h1 : GDerL (gjtm G a (guu n))) (h2 : GDerL (gjtm (gext G (gel n a)) b (guu n))) (h3 : GDerL (gjsub D s G)) : GDerL (gjeqtm D (gsb (gpic n a b) s) (gpic n (gsb a s) (gsb b (glift (gel n a) s))) (guu n))
  | lgm-uc-sb (D : GE) (G : GE) (m : Nat) (n : Nat) (s : GE) (h : GDerL (gjsub D s G)) (lt : LeN (suc m) n) (nb : LeN n N) : GDerL (gjeqtm D (gsb (guc m n) s) (guc m n) (guu n))
  | lgm-lf-sb (D : GE) (G : GE) (m : Nat) (n : Nat) (a : GE) (s : GE) (h1 : GDerL (gjtm G a (guu m))) (h2 : GDerL (gjsub D s G)) (le : LeN (suc m) n) (nb : LeN n N) : GDerL (gjeqtm D (gsb (glf m n a) s) (glf m n (gsb a s)) (guu n))
  | lgm-q-lift (D : GE) (G : GE) (A : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjsub D s G)) : GDerL (gjeqtm (gext D (gsb A s)) (gsb gq (glift A s)) gq (gsb (gsb A s) gp))
  | lgm-q-sec (G : GE) (A : GE) (a : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjtm G a A)) : GDerL (gjeqtm G (gsb gq (gsec A a)) a A)
  | lgm-ecx (G : GE) (D : GE) (a : GE) (b : GE) (A : GE) (h0 : GDerL (gjwf D)) (h1 : GDerL (gjeqcx G D)) (h2 : GDerL (gjeqtm G a b A)) : GDerL (gjeqtm D a b A)
  | lgq-refl (D : GE) (s : GE) (G : GE) (h : GDerL (gjsub D s G)) : GDerL (gjeqsub D s s G)
  | lgq-sym (D : GE) (s : GE) (t : GE) (G : GE) (h : GDerL (gjeqsub D s t G)) : GDerL (gjeqsub D t s G)
  | lgq-trans (D : GE) (s : GE) (t : GE) (u : GE) (G : GE) (h1 : GDerL (gjeqsub D s t G)) (h2 : GDerL (gjeqsub D t u G)) : GDerL (gjeqsub D s u G)
  | lgq-comp (T : GE) (D : GE) (G : GE) (s : GE) (s' : GE) (d : GE) (d' : GE) (h1 : GDerL (gjeqsub D s s' G)) (h2 : GDerL (gjeqsub T d d' D)) : GDerL (gjeqsub T (gcomp s d) (gcomp s' d') G)
  | lgq-lift (D : GE) (G : GE) (A : GE) (A' : GE) (s : GE) (s' : GE) (h1 : GDerL (gjeqty G A A')) (h3 : GDerL (gjeqsub D s s' G)) : GDerL (gjeqsub (gext D (gsb A s)) (glift A s) (glift A' s') (gext G A))
  | lgq-sec (G : GE) (A : GE) (A' : GE) (a : GE) (a' : GE) (h1 : GDerL (gjeqty G A A')) (h2 : GDerL (gjeqtm G a a' A)) : GDerL (gjeqsub G (gsec A a) (gsec A' a') (gext G A))
  | lgq-idl (D : GE) (G : GE) (s : GE) (h : GDerL (gjsub D s G)) : GDerL (gjeqsub D (gcomp gid s) s G)
  | lgq-idr (D : GE) (G : GE) (s : GE) (h : GDerL (gjsub D s G)) : GDerL (gjeqsub D (gcomp s gid) s G)
  | lgq-assoc (Q : GE) (T : GE) (D : GE) (G : GE) (s : GE) (d : GE) (e : GE) (h1 : GDerL (gjsub D s G)) (h2 : GDerL (gjsub T d D)) (h3 : GDerL (gjsub Q e T)) : GDerL (gjeqsub Q (gcomp (gcomp s d) e) (gcomp s (gcomp d e)) G)
  | lgq-eps (G : GE) (s : GE) (h : GDerL (gjsub G s gnil)) : GDerL (gjeqsub G s geps gnil)
  | lgq-lift-id (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjeqsub (gext G (gsb A gid)) (glift A gid) gid (gext G A))
  | lgq-lift-comp (T : GE) (D : GE) (G : GE) (A : GE) (s : GE) (d : GE) (h0 : GDerL (gjty G A)) (h1 : GDerL (gjsub D s G)) (h2 : GDerL (gjsub T d D)) : GDerL (gjeqsub (gext T (gsb A (gcomp s d))) (glift A (gcomp s d)) (gcomp (glift A s) (glift (gsb A s) d)) (gext G A))
  | lgq-p-lift (D : GE) (G : GE) (A : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjsub D s G)) : GDerL (gjeqsub (gext D (gsb A s)) (gcomp gp (glift A s)) (gcomp s gp) G)
  | lgq-p-sec (G : GE) (A : GE) (a : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjtm G a A)) : GDerL (gjeqsub G (gcomp gp (gsec A a)) gid G)
  | lgq-sec-comp (D : GE) (G : GE) (A : GE) (a : GE) (s : GE) (h1 : GDerL (gjty G A)) (h2 : GDerL (gjtm G a A)) (h3 : GDerL (gjsub D s G)) : GDerL (gjeqsub D (gcomp (gsec A a) s) (gcomp (glift A s) (gsec (gsb A s) (gsb a s))) (gext G A))
  | lgq-lift-p-sec-q (G : GE) (A : GE) (h : GDerL (gjty G A)) : GDerL (gjeqsub (gext G A) (gcomp (glift A gp) (gsec (gsb A gp) gq)) gid (gext G A)) ;

to-glean : (J : GJ) -> GDer J -> GDerL J = split {
  g-nil -> lg-nil ;
  g-ext G A h | xh -> lg-ext G A xh ;
  gc-nil -> lgc-nil ;
  gc-refl G h | xh -> lgc-refl G xh ;
  gc-ext G D A B h1 h2 | xh1 xh2 -> lgc-ext G D A B xh1 xh2 ;
  gs-id G h | xh -> lgs-id G xh ;
  gs-comp T D G s d h1 h2 | xh1 xh2 -> lgs-comp T D G s d xh1 xh2 ;
  gs-eps G h | xh -> lgs-eps G xh ;
  gs-p G A h | xh -> lgs-p G A xh ;
  gs-lift D G A s h1 h2 | xh1 xh2 -> lgs-lift D G A s xh1 xh2 ;
  gs-sec G A a h1 h2 | xh1 xh2 -> lgs-sec G A a xh1 xh2 ;
  gs-cx D D' G G' s h0 h0' h1 h2 h | xh0 xh0p xh1 xh2 xh -> lgs-cx D D' G G' s xh0 xh0p xh1 xh2 xh ;
  gt-pi G A B h1 h2 | xh1 xh2 -> lgt-pi G A B xh1 xh2 ;
  gt-uu G n h nb | xh -> lgt-uu G n xh nb ;
  gt-el G n a h | xh -> lgt-el G n a xh ;
  gt-sb D G A s h1 h2 | xh1 xh2 -> lgt-sb D G A s xh1 xh2 ;
  gt-cx G D A h0 h1 h2 | xh0 xh1 xh2 -> lgt-cx G D A xh0 xh1 xh2 ;
  gm-lam G A B b h1 h2 h3 | xh1 xh2 xh3 -> lgm-lam G A B b xh1 xh2 xh3 ;
  gm-app G A B c a h1 h2 h3 h4 | xh1 xh2 xh3 xh4 -> lgm-app G A B c a xh2 xh3 xh4 ;
  gm-pic G n a b h1 h2 | xh1 xh2 -> lgm-pic G n a b xh1 xh2 ;
  gm-uc G m n h lt nb | xh -> lgm-uc G m n xh lt nb ;
  gm-lf G m n a h le nb | xh -> lgm-lf G m n a xh le nb ;
  gm-q G A h | xh -> lgm-q G A xh ;
  gm-sb D G a A s hA h1 h2 | xhA xh1 xh2 -> lgm-sb D G a A s xh1 xh2 ;
  gm-conv G a A B h1 h2 | xh1 xh2 -> lgm-conv G a A B xh1 xh2 ;
  gm-cx G D a A h0 h1 h2 | xh0 xh1 xh2 -> lgm-cx G D a A xh0 xh1 xh2 ;
  ge-refl G A h | xh -> lge-refl G A xh ;
  ge-sym G A B h | xh -> lge-sym G A B xh ;
  ge-trans G A B C h1 h2 | xh1 xh2 -> lge-trans G A B C xh1 xh2 ;
  ge-pi G A A' B B' h0 h1 h2 | xh0 xh1 xh2 -> lge-pi G A A' B B' xh1 xh2 ;
  ge-el G n a a' h | xh -> lge-el G n a a' xh ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 | xh0 xh1 xh2 xh3 xh4 -> lge-sb D G A A' s s' xh1 xh4 ;
  ge-el-lf G m n a h le nb | xh -> lge-el-lf G m n a xh le nb ;
  ge-el-pic G n a b h1 h2 | xh1 xh2 -> lge-el-pic G n a b xh1 xh2 ;
  ge-el-uc G m n h lt nb | xh -> lge-el-uc G m n xh lt nb ;
  ge-sb-id G A h | xh -> lge-sb-id G A xh ;
  ge-sb-comp T D G A s d h0 h1 h2 | xh0 xh1 xh2 -> lge-sb-comp T D G A s d xh0 xh1 xh2 ;
  ge-pi-sb D G A B s h1 h2 h3 | xh1 xh2 xh3 -> lge-pi-sb D G A B s xh1 xh2 xh3 ;
  ge-uu-sb D G n s h nb | xh -> lge-uu-sb D G n s xh nb ;
  ge-el-sb D G n a s h1 h2 | xh1 xh2 -> lge-el-sb D G n a s xh1 xh2 ;
  ge-cx G D A B h0 h1 h2 | xh0 xh1 xh2 -> lge-cx G D A B xh0 xh1 xh2 ;
  gm-refl G a A h | xh -> lgm-refl G a A xh ;
  gm-sym G a b A hA h | xhA xh -> lgm-sym G a b A xh ;
  gm-trans G a b c A h1 h2 | xh1 xh2 -> lgm-trans G a b c A xh1 xh2 ;
  gm-eqconv G a b A B h1 h2 | xh1 xh2 -> lgm-eqconv G a b A B xh1 xh2 ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 | xh0 xh1 xh2 xh3 -> lgm-elam G A A' B B' b b' xh1 xh2 xh3 ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 | xh0 xhB xha xh1 xh2 xh3 xh4 -> lgm-eapp G A A' B B' c c' a a' xh1 xh2 xh3 xh4 ;
  gm-epic G n a a' b b' h0 h1 h2 | xh0 xh1 xh2 -> lgm-epic G n a a' b b' xh1 xh2 ;
  gm-elf G m n a a' h le nb | xh -> lgm-elf G m n a a' xh le nb ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 | xhA xh0 xh1 xh2 xh3 xh4 -> lgm-esb D G a a' A s s' xh1 xh4 ;
  gm-beta G A B b a hA hB h1 h2 | xhA xhB xh1 xh2 -> lgm-beta G A B b a xh1 xh2 ;
  gm-eta G A B f hA hB h | xhA xhB xh -> lgm-eta G A B f xh ;
  gm-lf-pic G n p a b h1 h2 le nb | xh1 xh2 -> lgm-lf-pic G n p a b xh1 xh2 le nb ;
  gm-lf-uc G m n p h lt le nb | xh -> lgm-lf-uc G m n p xh lt le nb ;
  gm-lf-lf G m n p a h le1 le2 nb | xh -> lgm-lf-lf G m n p a xh le1 le2 nb ;
  gm-sb-id G a A h | xh -> lgm-sb-id G a A xh ;
  gm-sb-comp T D G a A s d h0 h1 h2 | xh0 xh1 xh2 -> lgm-sb-comp T D G a A s d xh0 xh1 xh2 ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 | xh1 xh2 xh3 xh4 -> lgm-lam-sb D G A B b s xh1 xh2 xh3 xh4 ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 | xh1 xh2 xh3 xh4 xh5 -> lgm-app-sb D G A B c a s xh1 xh2 xh3 xh4 xh5 ;
  gm-pic-sb D G n a b s h1 h2 h3 | xh1 xh2 xh3 -> lgm-pic-sb D G n a b s xh1 xh2 xh3 ;
  gm-uc-sb D G m n s h lt nb | xh -> lgm-uc-sb D G m n s xh lt nb ;
  gm-lf-sb D G m n a s h1 h2 le nb | xh1 xh2 -> lgm-lf-sb D G m n a s xh1 xh2 le nb ;
  gm-q-lift D G A s h1 h2 | xh1 xh2 -> lgm-q-lift D G A s xh1 xh2 ;
  gm-q-sec G A a h1 h2 | xh1 xh2 -> lgm-q-sec G A a xh1 xh2 ;
  gm-ecx G D a b A h0 h1 h2 | xh0 xh1 xh2 -> lgm-ecx G D a b A xh0 xh1 xh2 ;
  gq-refl D s G h | xh -> lgq-refl D s G xh ;
  gq-sym D s t G h | xh -> lgq-sym D s t G xh ;
  gq-trans D s t u G h1 h2 | xh1 xh2 -> lgq-trans D s t u G xh1 xh2 ;
  gq-comp T D G s s' d d' h1 h2 | xh1 xh2 -> lgq-comp T D G s s' d d' xh1 xh2 ;
  gq-lift D G A A' s s' h0 h1 h2 h3 | xh0 xh1 xh2 xh3 -> lgq-lift D G A A' s s' xh1 xh3 ;
  gq-sec G A A' a a' hA ha ha' h1 h2 | xhA xha xhap xh1 xh2 -> lgq-sec G A A' a a' xh1 xh2 ;
  gq-idl D G s h | xh -> lgq-idl D G s xh ;
  gq-idr D G s h | xh -> lgq-idr D G s xh ;
  gq-assoc Q T D G s d e h1 h2 h3 | xh1 xh2 xh3 -> lgq-assoc Q T D G s d e xh1 xh2 xh3 ;
  gq-eps G s h | xh -> lgq-eps G s xh ;
  gq-lift-id G A h | xh -> lgq-lift-id G A xh ;
  gq-lift-comp T D G A s d h0 h1 h2 | xh0 xh1 xh2 -> lgq-lift-comp T D G A s d xh0 xh1 xh2 ;
  gq-p-lift D G A s h1 h2 | xh1 xh2 -> lgq-p-lift D G A s xh1 xh2 ;
  gq-p-sec G A a h1 h2 | xh1 xh2 -> lgq-p-sec G A a xh1 xh2 ;
  gq-sec-comp D G A a s h1 h2 h3 | xh1 xh2 xh3 -> lgq-sec-comp D G A a s xh1 xh2 xh3 ;
  gq-lift-p-sec-q G A h | xh -> lgq-lift-p-sec-q G A xh } ;

to-gder : (J : GJ) -> GDerL J -> GDer J = split {
  lg-nil -> g-nil ;
  lg-ext G A h | xh -> g-ext G A xh ;
  lgc-nil -> gc-nil ;
  lgc-refl G h | xh -> gc-refl G xh ;
  lgc-ext G D A B h1 h2 | xh1 xh2 -> gc-ext G D A B xh1 xh2 ;
  lgs-id G h | xh -> gs-id G xh ;
  lgs-comp T D G s d h1 h2 | xh1 xh2 -> gs-comp T D G s d xh1 xh2 ;
  lgs-eps G h | xh -> gs-eps G xh ;
  lgs-p G A h | xh -> gs-p G A xh ;
  lgs-lift D G A s h1 h2 | xh1 xh2 -> gs-lift D G A s xh1 xh2 ;
  lgs-sec G A a h1 h2 | xh1 xh2 -> gs-sec G A a xh1 xh2 ;
  lgs-cx D D' G G' s h0 h0' h1 h2 h | xh0 xh0p xh1 xh2 xh -> gs-cx D D' G G' s xh0 xh0p xh1 xh2 xh ;
  lgt-pi G A B h1 h2 | xh1 xh2 -> gt-pi G A B xh1 xh2 ;
  lgt-uu G n h nb | xh -> gt-uu G n xh nb ;
  lgt-el G n a h | xh -> gt-el G n a xh ;
  lgt-sb D G A s h1 h2 | xh1 xh2 -> gt-sb D G A s xh1 xh2 ;
  lgt-cx G D A h0 h1 h2 | xh0 xh1 xh2 -> gt-cx G D A xh0 xh1 xh2 ;
  lgm-lam G A B b h1 h2 h3 | xh1 xh2 xh3 -> gm-lam G A B b xh1 xh2 xh3 ;
  lgm-app G A B c a h2 h3 h4 | xh2 xh3 xh4 -> gm-app G A B c a (wf-ext-inv G A (gpresup (gjty (gext G A) B) xh2)) xh2 xh3 xh4 ;
  lgm-pic G n a b h1 h2 | xh1 xh2 -> gm-pic G n a b xh1 xh2 ;
  lgm-uc G m n h lt nb | xh -> gm-uc G m n xh lt nb ;
  lgm-lf G m n a h le nb | xh -> gm-lf G m n a xh le nb ;
  lgm-q G A h | xh -> gm-q G A xh ;
  lgm-sb D G a A s h1 h2 | xh1 xh2 -> gm-sb D G a A s ((gpresup (gjtm G a A) xh1).2) xh1 xh2 ;
  lgm-conv G a A B h1 h2 | xh1 xh2 -> gm-conv G a A B xh1 xh2 ;
  lgm-cx G D a A h0 h1 h2 | xh0 xh1 xh2 -> gm-cx G D a A xh0 xh1 xh2 ;
