-- Generated by gen_aannot.py --full. Views at a given raw AGAT image.

level l ;
open Base ; open Lib[l] ; open AGAT[l] ; open FGAT[l] ; open FForget[l] ;

action-expr : Bool -> FA -> FA -> FA -> FA -> FA -> FA = split {
  false -> \ D G A t s -> ftsb D G t s ;
  true -> \ D G A t s -> fmsb D G A t s } ;

Shape : GA -> U l = split {
  anil -> Top ;
  aext G A -> (full-G : FA) * (full-A : FA) * Id GA (ff full-G) G * Id GA (ff full-A) A ;
  api A B -> (full-G : FA) * (full-A : FA) * (full-B : FA) * Id GA (ff full-A) A * Id GA (ff full-B) B ;
  auu n G -> (full-G : FA) * Id GA (ff full-G) G ;
  ael n a -> (full-G : FA) * (full-a : FA) * Id GA (ff full-a) a ;
  asb t s -> (full-kind : Bool) * (full-D : FA) * (full-G : FA) * (full-A : FA) * (full-t : FA) * (full-s : FA) * Id GA (ff full-t) t * Id GA (ff full-s) s ;
  alam A B b -> (full-G : FA) * (full-A : FA) * (full-B : FA) * (full-b : FA) * Id GA (ff full-A) A * Id GA (ff full-B) B * Id GA (ff full-b) b ;
  aapp A B c a -> (full-G : FA) * (full-A : FA) * (full-B : FA) * (full-c : FA) * (full-a : FA) * Id GA (ff full-A) A * Id GA (ff full-B) B * Id GA (ff full-c) c * Id GA (ff full-a) a ;
  apic n a b -> (full-G : FA) * (full-a : FA) * (full-b : FA) * Id GA (ff full-a) a * Id GA (ff full-b) b ;
  auc m n G -> (full-G : FA) * Id GA (ff full-G) G ;
  alf m n a -> (full-G : FA) * (full-a : FA) * Id GA (ff full-a) a ;
  aq G A -> (full-G : FA) * (full-A : FA) * Id GA (ff full-G) G * Id GA (ff full-A) A ;
  aid G -> (full-G : FA) * Id GA (ff full-G) G ;
  acomp s d -> (full-T : FA) * (full-D : FA) * (full-G : FA) * (full-s : FA) * (full-d : FA) * Id GA (ff full-s) s * Id GA (ff full-d) d ;
  aeps G -> (full-G : FA) * Id GA (ff full-G) G ;
  ap G A -> (full-G : FA) * (full-A : FA) * Id GA (ff full-G) G * Id GA (ff full-A) A ;
  alift A s -> (full-D : FA) * (full-G : FA) * (full-A : FA) * (full-s : FA) * Id GA (ff full-A) A * Id GA (ff full-s) s ;
  asec A a -> (full-G : FA) * (full-A : FA) * (full-a : FA) * Id GA (ff full-A) A * Id GA (ff full-a) a } ;

shape-term : (a : GA) -> Shape a -> FA = split {
  anil -> \ x -> fnil ;
  aext G A -> \ x -> fext x.1 x.2.1 ;
  api A B -> \ x -> fpi x.1 x.2.1 x.2.2.1 ;
  auu n G -> \ x -> fuu n x.1 ;
  ael n a -> \ x -> fel n x.1 x.2.1 ;
  asb t s -> \ x -> action-expr x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2.1 x.2.2.2.2.2.1 ;
  alam A B b -> \ x -> flam x.1 x.2.1 x.2.2.1 x.2.2.2.1 ;
  aapp A B c a -> \ x -> fapp x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2.1 ;
  apic n a b -> \ x -> fpic n x.1 x.2.1 x.2.2.1 ;
  auc m n G -> \ x -> fuc m n x.1 ;
  alf m n a -> \ x -> flf m n x.1 x.2.1 ;
  aq G A -> \ x -> fq x.1 x.2.1 ;
  aid G -> \ x -> fid x.1 ;
  acomp s d -> \ x -> fcomp x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2.1 ;
  aeps G -> \ x -> feps x.1 ;
  ap G A -> \ x -> fp x.1 x.2.1 ;
  alift A s -> \ x -> flift x.1 x.2.1 x.2.2.1 x.2.2.2.1 ;
  asec A a -> \ x -> fsec x.1 x.2.1 x.2.2.1 } ;

shape-self : (X : FA) -> Shape (ff X) = split {
  fnil -> tt ;
  fext G A -> (G,(A,(refl (ff G),refl (ff A)))) ;
  fpi G A B -> (G,(A,(B,(refl (ff A),refl (ff B))))) ;
  fuu n G -> (G,refl (ff G)) ;
  fel n G a -> (G,(a,refl (ff a))) ;
  ftsb D G A s -> (false,(D,(G,(fnil,(A,(s,(refl (ff A),refl (ff s)))))))) ;
  fmsb D G A a s -> (true,(D,(G,(A,(a,(s,(refl (ff a),refl (ff s)))))))) ;
  flam G A B b -> (G,(A,(B,(b,(refl (ff A),(refl (ff B),refl (ff b))))))) ;
  fapp G A B c a -> (G,(A,(B,(c,(a,(refl (ff A),(refl (ff B),(refl (ff c),refl (ff a))))))))) ;
  fpic n G a b -> (G,(a,(b,(refl (ff a),refl (ff b))))) ;
  fuc m n G -> (G,refl (ff G)) ;
  flf m n G a -> (G,(a,refl (ff a))) ;
  fq G A -> (G,(A,(refl (ff G),refl (ff A)))) ;
  fid G -> (G,refl (ff G)) ;
  fcomp T D G s d -> (T,(D,(G,(s,(d,(refl (ff s),refl (ff d))))))) ;
  feps G -> (G,refl (ff G)) ;
  fp G A -> (G,(A,(refl (ff G),refl (ff A)))) ;
  flift D G A s -> (D,(G,(A,(s,(refl (ff A),refl (ff s)))))) ;
  fsec G A a -> (G,(A,(a,(refl (ff A),refl (ff a))))) } ;

shape-self-id : (X : FA) -> Id FA (shape-term (ff X) (shape-self X)) X = split {
  fnil -> refl fnil ;
  fext G A -> refl (fext G A) ;
  fpi G A B -> refl (fpi G A B) ;
  fuu n G -> refl (fuu n G) ;
  fel n G a -> refl (fel n G a) ;
  ftsb D G A s -> refl (ftsb D G A s) ;
  fmsb D G A a s -> refl (fmsb D G A a s) ;
  flam G A B b -> refl (flam G A B b) ;
  fapp G A B c a -> refl (fapp G A B c a) ;
  fpic n G a b -> refl (fpic n G a b) ;
  fuc m n G -> refl (fuc m n G) ;
  flf m n G a -> refl (flf m n G a) ;
  fq G A -> refl (fq G A) ;
  fid G -> refl (fid G) ;
  fcomp T D G s d -> refl (fcomp T D G s d) ;
  feps G -> refl (feps G) ;
  fp G A -> refl (fp G A) ;
  flift D G A s -> refl (flift D G A s) ;
  fsec G A a -> refl (fsec G A a) } ;

Repr (a : GA) (X : FA) : U l = (s : Shape a) * Id FA (shape-term a s) X ;

shape-view (a : GA) (X : FA) (p : Id GA (ff X) a) : Repr a X =
  Prelude[l].subst GA (\ Y -> Repr Y X) (ff X) a p (shape-self X,shape-self-id X) ;
