-- InitHomCat: the category laws for morphisms of TEModel[N] in Sigma
-- form (PLAN-INIT, Part C).  Segment of InitHomS.CatLaws (l, N, M1, M2,
-- M3, M4, fe).  The maps of a composite are composites of maps, so both
-- sides of each law have the same maps by definition; hom-ext turns the
-- pointwise refl agreement into a path in HomS (the laws are a
-- proposition).
open Base ;
open Prelude[l] ;
module S12 = MorphismS[l,N,M1,M2,fe] ;
module S11 = MorphismS[l,N,M1,M1,fe] ;
module S22 = MorphismS[l,N,M2,M2,fe] ;
module Mo12 = InitHom.Morphism[l,N,M1,M2] ;
module Mo14 = InitHom.Morphism[l,N,M1,M4] ;
module S14 = MorphismS[l,N,M1,M4,fe] ;

-- identities
idS1 : S11.InitHomSig.HomS = S11.InitHomSig.toS InitHomIdentity.Identity[l,N,M1].InitHomId.idHom ;
idS2 : S22.InitHomSig.HomS = S22.InitHomSig.toS InitHomIdentity.Identity[l,N,M2].InitHomId.idHom ;

-- left unit: h . id = h  (id first, as the composite M1 -> M1 -> M2)
left-unit (h : S12.InitHomSig.HomS)
  : Id S12.InitHomSig.HomS (Composition[l,N,M1,M1,M2,fe].InitHomComp.compS idS1 h) h =
  S12.InitHomExt.hom-ext (Composition[l,N,M1,M1,M2,fe].InitHomComp.compS idS1 h) h
    (new Mo12.InitHomLaws.Agree[S12.InitHomSig.fromS (Composition[l,N,M1,M1,M2,fe].InitHomComp.compS idS1 h),
                                S12.InitHomSig.fromS h,
      ctx-ag := \ G -> refl (h.1.1 G),
      ty-ag := \ G A -> refl (h.1.1 G, h.1.2.2.1 G A),
      tm-ag := \ G A a -> refl (h.1.1 G, (h.1.2.2.1 G A, h.1.2.2.2 G A a)),
      sub-ag := \ D G s -> refl (h.1.1 D, (h.1.1 G, h.1.2.1 D G s))]) ;

-- right unit: id . h = h  (the composite M1 -> M2 -> M2)
right-unit (h : S12.InitHomSig.HomS)
  : Id S12.InitHomSig.HomS (Composition[l,N,M1,M2,M2,fe].InitHomComp.compS h idS2) h =
  S12.InitHomExt.hom-ext (Composition[l,N,M1,M2,M2,fe].InitHomComp.compS h idS2) h
    (new Mo12.InitHomLaws.Agree[S12.InitHomSig.fromS (Composition[l,N,M1,M2,M2,fe].InitHomComp.compS h idS2),
                                S12.InitHomSig.fromS h,
      ctx-ag := \ G -> refl (h.1.1 G),
      ty-ag := \ G A -> refl (h.1.1 G, h.1.2.2.1 G A),
      tm-ag := \ G A a -> refl (h.1.1 G, (h.1.2.2.1 G A, h.1.2.2.2 G A a)),
      sub-ag := \ D G s -> refl (h.1.1 D, (h.1.1 G, h.1.2.1 D G s))]) ;

-- associativity, M1 -> M2 -> M3 -> M4
assoc (f : MorphismS[l,N,M1,M2,fe].InitHomSig.HomS) (g : MorphismS[l,N,M2,M3,fe].InitHomSig.HomS)
      (k : MorphismS[l,N,M3,M4,fe].InitHomSig.HomS)
  : Id S14.InitHomSig.HomS
      (Composition[l,N,M1,M3,M4,fe].InitHomComp.compS (Composition[l,N,M1,M2,M3,fe].InitHomComp.compS f g) k)
      (Composition[l,N,M1,M2,M4,fe].InitHomComp.compS f (Composition[l,N,M2,M3,M4,fe].InitHomComp.compS g k)) =
  S14.InitHomExt.hom-ext
    (Composition[l,N,M1,M3,M4,fe].InitHomComp.compS (Composition[l,N,M1,M2,M3,fe].InitHomComp.compS f g) k)
    (Composition[l,N,M1,M2,M4,fe].InitHomComp.compS f (Composition[l,N,M2,M3,M4,fe].InitHomComp.compS g k))
    (new Mo14.InitHomLaws.Agree[
       S14.InitHomSig.fromS (Composition[l,N,M1,M3,M4,fe].InitHomComp.compS (Composition[l,N,M1,M2,M3,fe].InitHomComp.compS f g) k),
       S14.InitHomSig.fromS (Composition[l,N,M1,M2,M4,fe].InitHomComp.compS f (Composition[l,N,M2,M3,M4,fe].InitHomComp.compS g k)),
       ctx-ag := \ G -> refl (k.1.1 (g.1.1 (f.1.1 G))),
       ty-ag := \ G A -> refl (k.1.1 (g.1.1 (f.1.1 G)), k.1.2.2.1 (g.1.1 (f.1.1 G)) (g.1.2.2.1 (f.1.1 G) (f.1.2.2.1 G A))),
       tm-ag := \ G A a -> refl (k.1.1 (g.1.1 (f.1.1 G)),
                  (k.1.2.2.1 (g.1.1 (f.1.1 G)) (g.1.2.2.1 (f.1.1 G) (f.1.2.2.1 G A)),
                   k.1.2.2.2 (g.1.1 (f.1.1 G)) (g.1.2.2.1 (f.1.1 G) (f.1.2.2.1 G A))
                     (g.1.2.2.2 (f.1.1 G) (f.1.2.2.1 G A) (f.1.2.2.2 G A a)))),
       sub-ag := \ D G s -> refl (k.1.1 (g.1.1 (f.1.1 D)), (k.1.1 (g.1.1 (f.1.1 G)),
                  k.1.2.1 (g.1.1 (f.1.1 D)) (g.1.1 (f.1.1 G)) (g.1.2.1 (f.1.1 D) (f.1.1 G) (f.1.2.1 D G s))))]) ;
