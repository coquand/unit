-- InitHomStep: the induction steps of uniqueness, for two morphisms
-- H, H' : Hom M -> M'.  For each operation op: if H and H' agree on the
-- arguments of op (in the total spaces, as in Agree), they agree on its
-- result.  Each step is  rel-op H (H'-images) ; (rel-op H' (H'-images))^-1,
-- the H'-images of data over ext G A being the canonical ones (canon-*).
-- Segment of InitHom.Morphism (l, N, M, M').
--
-- Abbreviations of the agreement statements (the components of Agree):
--   AgC H H' G     = RCtx H G (H'.ctx G)
--   AgT H H' G A   = RTy H G A (H'.ctx G, H'.ty G A)
--   AgE H H' G A a = RTm H G A a (H'.ctx G, (H'.ty G A, H'.tm G A a))
--   AgS H H' D G s = RSub H D G s (H'.ctx D, (H'.ctx G, H'.sub D G s))
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
open InitHomBase ;
open InitHomLaws ;
open InitHomRelA ;
open InitHomRelB ;

AgC (H H' : Hom) (G : C.Ctx) : U l = RCtx H G (H'.ctx G) ;
AgT (H H' : Hom) (G : C.Ctx) (A : C.Ty G) : U l = RTy H G A (H'.ctx G, H'.ty G A) ;
AgE (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (a : C.El G A) : U l =
  RTm H G A a (H'.ctx G, (H'.ty G A, H'.tm G A a)) ;
AgS (H H' : Hom) (D G : C.Ctx) (s : C.Sub D G) : U l =
  RSub H D G s (H'.ctx D, (H'.ctx G, H'.sub D G s)) ;

-- Agree from its components
mkAgree (H H' : Hom) (c : (G : C.Ctx) -> AgC H H' G) (t : (G : C.Ctx) (A : C.Ty G) -> AgT H H' G A)
    (e : (G : C.Ctx) (A : C.Ty G) (a : C.El G A) -> AgE H H' G A a)
    (s : (D G : C.Ctx) (f : C.Sub D G) -> AgS H H' D G f) : Agree[H,H'] =
  new Agree[H, H', ctx-ag := c, ty-ag := t, tm-ag := e, sub-ag := s] ;

------------------------------------------------------------------------
-- contexts

ag-nil (H H' : Hom) : AgC H H' C.nil = transH H.ctx-nil (symH H'.ctx-nil) ;

ag-ext (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (eA : AgT H H' G A) : AgC H H' (C.ext G A) =
  transH (rel-ext H G A (H'.ctx G) (H'.ty G A) eA) (symH (H'.ctx-ext G A)) ;

------------------------------------------------------------------------
-- substitutions

ag-id (H H' : Hom) (G : C.Ctx) (eG : AgC H H' G) : AgS H H' G G (C.id G) =
  transH (rel-id H G (H'.ctx G) eG) (symH (rel-id H' G (H'.ctx G) (refl (H'.ctx G)))) ;

ag-o (H H' : Hom) (T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D)
    (es : AgS H H' D G s) (es' : AgS H H' T D s') : AgS H H' T G (C.o T D G s s') =
  transH (rel-o H T D G s s' (H'.ctx T) (H'.ctx D) (H'.ctx G) (H'.sub D G s) (H'.sub T D s') es es')
    (symH (rel-o H' T D G s s' (H'.ctx T) (H'.ctx D) (H'.ctx G) (H'.sub D G s) (H'.sub T D s')
             (refl (H'.ctx D, (H'.ctx G, H'.sub D G s))) (refl (H'.ctx T, (H'.ctx D, H'.sub T D s'))))) ;

ag-eps (H H' : Hom) (G : C.Ctx) (eG : AgC H H' G) : AgS H H' G C.nil (C.eps G) =
  transH (rel-eps H G (H'.ctx G) eG) (symH (rel-eps H' G (H'.ctx G) (refl (H'.ctx G)))) ;

ag-p (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (eA : AgT H H' G A) : AgS H H' (C.ext G A) G (C.p G A) =
  transH (rel-p H G A (H'.ctx G) (H'.ty G A) eA)
    (symH (rel-p H' G A (H'.ctx G) (H'.ty G A) (refl (H'.ctx G, H'.ty G A)))) ;

ag-sec (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (a : C.El G A) (ea : AgE H H' G A a)
  : AgS H H' G (C.ext G A) (C.sec G A a) =
  transH (rel-sec H G A a (H'.ctx G) (H'.ty G A) (H'.tm G A a) ea)
    (symH (rel-sec H' G A a (H'.ctx G) (H'.ty G A) (H'.tm G A a) (refl (H'.ctx G, (H'.ty G A, H'.tm G A a))))) ;

ag-lift (H H' : Hom) (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (eA : AgT H H' G A) (es : AgS H H' D G s)
  : AgS H H' (C.ext D (C.subT D G A s)) (C.ext G A) (C.lift D G A s) =
  transH (rel-lift H D G A s (H'.ctx D) (H'.ctx G) (H'.ty G A) (H'.sub D G s) eA es)
    (symH (rel-lift H' D G A s (H'.ctx D) (H'.ctx G) (H'.ty G A) (H'.sub D G s)
             (refl (H'.ctx G, H'.ty G A)) (refl (H'.ctx D, (H'.ctx G, H'.sub D G s))))) ;

------------------------------------------------------------------------
-- types

ag-subT (H H' : Hom) (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (eA : AgT H H' G A) (es : AgS H H' D G s)
  : AgT H H' D (C.subT D G A s) =
  transH (rel-subT H D G A s (H'.ctx D) (H'.ctx G) (H'.ty G A) (H'.sub D G s) eA es)
    (symH (rel-subT H' D G A s (H'.ctx D) (H'.ctx G) (H'.ty G A) (H'.sub D G s)
             (refl (H'.ctx G, H'.ty G A)) (refl (H'.ctx D, (H'.ctx G, H'.sub D G s))))) ;

ag-Pi (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A))
    (eA : AgT H H' G A) (eB : AgT H H' (C.ext G A) B) : AgT H H' G (P.Pi G A B) =
  transH (rel-Pi H G A B (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B) eA (transH eB (canon-ty-ext H' G A B)))
    (symH (rel-Pi H' G A B (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B)
             (refl (H'.ctx G, H'.ty G A)) (canon-ty-ext H' G A B))) ;

ag-univ (H H' : Hom) (n : LevelAt N) (G : C.Ctx) (eG : AgC H H' G) : AgT H H' G (M.univ n G) =
  transH (rel-univ H n G (H'.ctx G) eG) (symH (rel-univ H' n G (H'.ctx G) (refl (H'.ctx G)))) ;

ag-decode (H H' : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (ea : AgE H H' G (M.univ n G) a) : AgT H H' G (M.decode n G a) =
  transH (rel-decode H n G a (H'.ctx G) (H'.code n G a) (transH ea (code-rel H' n G a)))
    (symH (rel-decode H' n G a (H'.ctx G) (H'.code n G a) (code-rel H' n G a))) ;

------------------------------------------------------------------------
-- terms

ag-q (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (eA : AgT H H' G A)
  : AgE H H' (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A) =
  transH (rel-q H G A (H'.ctx G) (H'.ty G A) eA)
    (symH (rel-q H' G A (H'.ctx G) (H'.ty G A) (refl (H'.ctx G, H'.ty G A)))) ;

ag-subt (H H' : Hom) (D G : C.Ctx) (A : C.Ty G) (a : C.El G A) (s : C.Sub D G)
    (ea : AgE H H' G A a) (es : AgS H H' D G s) : AgE H H' D (C.subT D G A s) (C.subt D G A a s) =
  transH (rel-subt H D G A a s (H'.ctx D) (H'.ctx G) (H'.ty G A) (H'.tm G A a) (H'.sub D G s) ea es)
    (symH (rel-subt H' D G A a s (H'.ctx D) (H'.ctx G) (H'.ty G A) (H'.tm G A a) (H'.sub D G s)
             (refl (H'.ctx G, (H'.ty G A, H'.tm G A a))) (refl (H'.ctx D, (H'.ctx G, H'.sub D G s))))) ;

ag-lam (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B)
    (eA : AgT H H' G A) (eb : AgE H H' (C.ext G A) B b)
  : AgE H H' G (P.Pi G A B) ((P.Pi-iso G A B).inv b) =
  transH (rel-lam H G A B b (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B) (H'.mv-el G A B b) eA
            (transH eb (canon-tm-ext H' G A B b)))
    (symH (rel-lam H' G A B b (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B) (H'.mv-el G A B b)
             (refl (H'.ctx G, H'.ty G A)) (canon-tm-ext H' G A B b))) ;

-- the image of f : El G (Pi A B) under H', read in El' (Pi' (mv-ty B))
fun-arg (H' : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f : C.El G (P.Pi G A B))
  : C'.El (H'.ctx G) (P'.Pi (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B)) =
  subst (C'.Ty (H'.ctx G)) (C'.El (H'.ctx G)) (H'.ty G (P.Pi G A B))
    (P'.Pi (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B)) (H'.ty-Pi G A B) (H'.tm G (P.Pi G A B) f) ;

fun-arg-rel (H' : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f : C.El G (P.Pi G A B))
  : RTm H' G (P.Pi G A B) f (H'.ctx G, (P'.Pi (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B), fun-arg H' G A B f)) =
  ap (Term' (H'.ctx G)) TmT' (\ v -> (H'.ctx G, v))
    (H'.ty G (P.Pi G A B), H'.tm G (P.Pi G A B) f)
    (P'.Pi (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B), fun-arg H' G A B f)
    (tot-subst (C'.Ty (H'.ctx G)) (C'.El (H'.ctx G)) (H'.ty G (P.Pi G A B))
       (P'.Pi (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B)) (H'.ty-Pi G A B) (H'.tm G (P.Pi G A B) f)) ;

ag-fun (H H' : Hom) (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f : C.El G (P.Pi G A B))
    (eA : AgT H H' G A) (eB : AgT H H' (C.ext G A) B) (ef : AgE H H' G (P.Pi G A B) f)
  : AgE H H' (C.ext G A) B ((P.Pi-iso G A B).fun f) =
  transH (rel-fun H G A B f (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B) (fun-arg H' G A B f) eA
            (transH eB (canon-ty-ext H' G A B)) (transH ef (fun-arg-rel H' G A B f)))
    (symH (rel-fun H' G A B f (H'.ctx G) (H'.ty G A) (H'.mv-ty G A B) (fun-arg H' G A B f)
             (refl (H'.ctx G, H'.ty G A)) (canon-ty-ext H' G A B) (fun-arg-rel H' G A B f))) ;

ag-pic (H H' : Hom) (n : LevelAt N) (G : C.Ctx) (a : C.El G (M.univ n G))
    (b : C.El (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))))
    (ea : AgE H H' G (M.univ n G) a)
    (eb : AgE H H' (C.ext G (M.decode n G a)) (M.univ n (C.ext G (M.decode n G a))) b)
  : AgE H H' G (M.univ n G) (M.pic n G a b) =
  transH (rel-pic H n G a b (H'.ctx G) (H'.code n G a) (H'.mv-code n G a b)
            (transH ea (code-rel H' n G a)) (transH eb (canon-code-ext H' n G a b)))
    (symH (rel-pic H' n G a b (H'.ctx G) (H'.code n G a) (H'.mv-code n G a b)
             (code-rel H' n G a) (canon-code-ext H' n G a b))) ;

ag-uc (H H' : Hom) (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (eG : AgC H H' G)
  : AgE H H' G (M.univ n G) (M.uc m n lt G) =
  transH (rel-uc H m n lt G (H'.ctx G) eG) (symH (rel-uc H' m n lt G (H'.ctx G) (refl (H'.ctx G)))) ;

ag-lf (H H' : Hom) (m n : LevelAt N) (lt : StrictAt N m n) (G : C.Ctx) (a : C.El G (M.univ m G))
    (ea : AgE H H' G (M.univ m G) a) : AgE H H' G (M.univ n G) (M.lf m n lt G a) =
  transH (rel-lf H m n lt G a (H'.ctx G) (H'.code m G a) (transH ea (code-rel H' m G a)))
    (symH (rel-lf H' m n lt G a (H'.ctx G) (H'.code m G a) (code-rel H' m G a))) ;
