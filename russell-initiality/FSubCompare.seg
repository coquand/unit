-- Compare substitutions at their recorded frames.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FSubstLaws[l] ; open FCtx[l] ; open FGen[l] ; open FSubTransport[l] ; open FCompareBase[l] ;

id-frame-compare (G H : FA) : SubFrameCompare (fid G) (fid H) =
  \ e w w' -> (e,fq-id-cx G H e) ;

eps-frame-compare (G H : FA) : SubFrameCompare (feps G) (feps H) =
  \ e w w' -> (fc-nil,fq-eps-cx G H e) ;

p-frame-compare (G A H B : FA) : SubFrameCompare (fp G A) (fp H B) =
  \ e h k -> ((cx-ext-inv G A H B e).1,fq-p-cx G H A B (cx-ext-inv G A H B e).1 (cx-ext-inv G A H B e).2) ;

comp-frame-compare (T D G s d Q E H t e : FA) (cs : SubCompare s t) (cd : SubCompare d e) :
    SubFrameCompare (fcomp T D G s d) (fcomp Q E H t e) =
  \ origins p q -> compare origins p.1 p.2 q.1 q.2
 where {
  compare (origins : CE T Q) (hs : Sb D s G) (hd : Sb T d D) (ht : Sb E t H) (he : Sb Q e E) :
      CE G H * SE T (fcomp T D G s d) (fcomp Q E H t e) G =
    (ss.1,se-trans (comp-eq ss.2 ds.2) (se-trans middle (se-trans source target)))
   where {
    ds : CE D E * SE T d e D = cd T Q D E origins hd he ;
    ss : CE G H * SE D s t G = cs D E G H ds.1 hs ht ;
    ht-left : Sb D t G = (fpresup (fjeqsub D s t G) ss.2).2.2.2 ;
    he-left : Sb T e D = (fpresup (fjeqsub T d e D) ds.2).2.2.2 ;
    ht-middle : Sb E t G = move-source D E G t ds.1 ht-left ;
    he-middle : Sb T e E = move-target T D E e ds.1 he-left ;
    middle : SE T (fcomp T D G t e) (fcomp T E G t e) G =
      fq-comp-middle T D G t e ht-left he-left E ds.1 ;
    source : SE T (fcomp T E G t e) (fcomp Q E G t e) G =
      fq-comp-source T E G t e ht-middle he-middle Q origins ;
    target : SE T (fcomp Q E G t e) (fcomp Q E H t e) G =
      se-source Q T G (fcomp Q E G t e) (fcomp Q E H t e) (f-cx-sym T Q origins)
        (fq-comp-target Q E G t e ht-middle he H ss.1) ;
   } ;
 } ;

sec-frame-compare (G A a H B b : FA) (ca : TyCompare A B) (cb : TmCompare a b) :
    SubFrameCompare (fsec G A a) (fsec H B b) =
  \ e p q -> compare e p.1 p.2 q.1 q.2
 where {
  compare (e : CE G H) (hA : Ty G A) (ha : Tm' G a A) (hB : Ty H B) (hb : Tm' H b B) :
      CE (fext G A) (fext H B) * SE G (fsec G A a) (fsec H B b) (fext G A) =
    (ext-eq e types,se-trans (fq-sec G A B a b hA ha hbA types terms)
      (se-target G (fext G B) (fext G A) (fsec G B b) (fsec H B b) (ext-eq (cx-refl wG) (ty-sym types))
        (fq-sec-context G B b hB-left (tm-conv hbA types) H e)))
   where {
    types : TE G A B = ca G H e hA hB ;
    terms : ME G a b A = (cb G H A B e ha hb).2 ;
    hB-left : Ty G B = (fpresup (fjeqty G A B) types).2.2 ;
    hbA : Tm' G b A = (fpresup (fjeqtm G a b A) terms).2.2.2 ;
    wG : W G = wf-left G H e ;
   } ;
 } ;

lift-frame-compare (D G A s E H B t : FA) (ca : TyCompare A B) (cs : SubCompare s t) :
    SubFrameCompare (flift D G A s) (flift E H B t) =
  \ e p q -> compare e p.1 p.2 q.1 q.2
 where {
  compare (e : CE (fext D (ftsb D G A s)) (fext E (ftsb E H B t)))
      (hs : Sb D s G) (hA : Ty G A) (ht : Sb E t H) (hB : Ty H B) :
      CE (fext G A) (fext H B) * SE (fext D (ftsb D G A s)) (flift D G A s) (flift E H B t) (fext G A) =
    (ext-eq ss.1 types,se-trans (fq-lift D G A B s t hA types hs ss.2)
      (move-se (fext D (ftsb D G B t)) (fext D (ftsb D G A s)) (fext G B) (fext G A)
        (flift D G B t) (flift E H B t) backD backG (se-trans source target)))
   where {
    d : CE D E = (cx-ext-inv D (ftsb D G A s) E (ftsb E H B t) e).1 ;
    ss : CE G H * SE D s t G = cs D E G H d hs ht ;
    types : TE G A B = ca G H ss.1 hA hB ;
    ht-left : Sb D t G = (fpresup (fjeqsub D s t G) ss.2).2.2.2 ;
    hB-left : Ty G B = (fpresup (fjeqty G A B) types).2.2 ;
    backD : CE (fext D (ftsb D G B t)) (fext D (ftsb D G A s)) =
      ext-eq (cx-refl (wf-left D E d)) (ty-sym (sb-ty-cong hA types hs ht-left ss.2)) ;
    backG : CE (fext G B) (fext G A) = ext-eq (cx-refl (wf-left G H ss.1)) (ty-sym types) ;
    source : SE (fext D (ftsb D G B t)) (flift D G B t) (flift E G B t) (fext G B) =
      fq-lift-source D G B t ht-left hB-left E d ;
    target : SE (fext D (ftsb D G B t)) (flift E G B t) (flift E H B t) (fext G B) =
      se-source (fext E (ftsb E G B t)) (fext D (ftsb D G B t)) (fext G B) (flift E G B t) (flift E H B t)
        (f-cx-sym (fext D (ftsb D G B t)) (fext E (ftsb E G B t))
          (ext-eq d (fe-sb-source D G B t hB-left ht-left E d)))
        (fq-lift-target E G B t (move-source D E G t d ht-left) hB-left H ss.1) ;
   } ;
 } ;
