-- Recover the premises and endpoints of the introduction rule.
-- The frame retains the equalities accumulated along context and type conversion.
level l ;
open Base ; open Lib[l] ; open AGAT[l] ; open APresup[l] ; open ACtx[l] ;

TyIntro (G : GA) : GA -> U l = split {
  anil -> Empty ;
  aext G A -> Empty ;
  api A B -> Ty G A * Ty (aext G A) B ;
  auu n X -> Id GA G X * LeN n N ;
  ael n a -> Tm' G a (auu n G) ;
  asb t s -> (H : GA) * (Ty H t * Sb G s H) ;
  alam A B b -> Empty ;
  aapp A B c a -> Empty ;
  apic n a b -> Empty ;
  auc m n X -> Empty ;
  alf m n a -> Empty ;
  aq X A -> Empty ;
  aid X -> Empty ;
  acomp s d -> Empty ;
  aeps X -> Empty ;
  ap X A -> Empty ;
  alift A s -> Empty ;
  asec A a -> Empty } ;

TmIntro (G P : GA) : GA -> U l = split {
  anil -> Empty ;
  aext G A -> Empty ;
  api A B -> Empty ;
  auu n X -> Empty ;
  ael n a -> Empty ;
  asb t s -> (H A : GA) * (Ty H A * (Tm' H t A * (Sb G s H * Id GA P (asb A s)))) ;
  alam A B b -> Ty G A * (Ty (aext G A) B * (Tm' (aext G A) b B * Id GA P (api A B))) ;
  aapp A B c a -> Ty G A * (Ty (aext G A) B * (Tm' G c (api A B) * (Tm' G a A * Id GA P (asb B (asec A a))))) ;
  apic n a b -> Tm' G a (auu n G) * (Tm' (aext G (ael n a)) b (auu n (aext G (ael n a))) * Id GA P (auu n G)) ;
  auc m n X -> Id GA G X * (LeN (suc m) n * (LeN n N * Id GA P (auu n G))) ;
  alf m n a -> Tm' G a (auu m G) * (LeN (suc m) n * (LeN n N * Id GA P (auu n G))) ;
  aq X A -> Id GA G (aext X A) * (Ty X A * Id GA P (asb A (ap X A))) ;
  aid X -> Empty ;
  acomp s d -> Empty ;
  aeps X -> Empty ;
  ap X A -> Empty ;
  alift A s -> Empty ;
  asec A a -> Empty } ;

SubIntro (D G : GA) : GA -> U l = split {
  anil -> Empty ;
  aext G A -> Empty ;
  api A B -> Empty ;
  auu n X -> Empty ;
  ael n a -> Empty ;
  asb t s -> Empty ;
  alam A B b -> Empty ;
  aapp A B c a -> Empty ;
  apic n a b -> Empty ;
  auc m n X -> Empty ;
  alf m n a -> Empty ;
  aq X A -> Empty ;
  aid X -> Id GA D X * (Id GA G X * W X) ;
  acomp s d -> (H : GA) * (Sb H s G * Sb D d H) ;
  aeps X -> Id GA D X * (Id GA G anil * W X) ;
  ap X A -> Id GA D (aext X A) * (Id GA G X * Ty X A) ;
  alift A s -> (E H : GA) * (Id GA D (aext E (asb A s)) * (Id GA G (aext H A) * (Sb E s H * Ty H A))) ;
  asec A a -> Id GA G (aext D A) * (Ty D A * Tm' D a A) } ;

TyGen (G A : GA) : U l = (H : GA) * (TyIntro H A * CE H G) ;
TmGen (G a A : GA) : U l = (H P : GA) * (TmIntro H P a * (CE H G * TE G P A)) ;
SubGen (D s G : GA) : U l = (E H : GA) * (SubIntro E H s * (CE E D * CE H G)) ;

ty-origin (G A : GA) (h : Ty G A) (premises : TyIntro G A) : TyGen G A =
  (G, (premises, ac-refl G (apresup (ajty G A) h))) ;

tm-origin (G a A : GA) (h : Tm' G a A) (premises : TmIntro G A a) : TmGen G a A =
  (G, (A, (premises, (ac-refl G r.1, ae-refl G A r.2))))
  where { r : APJ (ajtm G a A) = apresup (ajtm G a A) h ; } ;

sub-origin (D G s : GA) (h : Sb D s G) (premises : SubIntro D G s) : SubGen D s G =
  (D, (G, (premises, (ac-refl D r.1, ac-refl G r.2))))
  where { r : APJ (ajsub D s G) = apresup (ajsub D s G) h ; } ;

TypingGen : GAJ -> U l = split {
  ajty G A -> TyGen G A ; ajtm G a A -> TmGen G a A ; ajsub D s G -> SubGen D s G ;
  ajwf G -> Top ; ajeqcx G D -> Top ; ajeqty G A B -> Top ;
  ajeqtm G a b A -> Top ; ajeqsub D s t G -> Top } ;

gen-typing : (J : GAJ) -> GADer J -> TypingGen J = split {
  a-nil -> tt ;
  a-ext G A h -> tt ;
  ac-nil -> tt ;
  ac-refl G h -> tt ;
  ac-ext G D A B h1 h2 -> tt ;
  as-id G h -> sub-origin G G (aid G) (as-id G h) (refl G, (refl G, h)) ;
  as-comp T D G s d h1 h2 -> sub-origin T G (acomp s d) (as-comp T D G s d h1 h2) (D, (h1, h2)) ;
  as-eps G h -> sub-origin G anil (aeps G) (as-eps G h) (refl G, (refl anil, h)) ;
  as-p G A h -> sub-origin (aext G A) G (ap G A) (as-p G A h) (refl (aext G A), (refl G, h)) ;
  as-lift D G A s h1 h2 -> sub-origin (aext D (asb A s)) (aext G A) (alift A s) (as-lift D G A s h1 h2)
    (D, (G, (refl (aext D (asb A s)), (refl (aext G A), (h1, h2))))) ;
  as-sec G A a h1 h2 -> sub-origin G (aext G A) (asec A a) (as-sec G A a h1 h2) (refl (aext G A), (h1, h2)) ;
  as-cx D D' G G' s h0 h0' h1 h2 h | r0 r0' r1 r2 rh ->
    (rh.1, (rh.2.1, (rh.2.2.1, (a-cx-trans rh.1 D D' rh.2.2.2.1 h1, a-cx-trans rh.2.1 G G' rh.2.2.2.2 h2)))) ;
  at-pi G A B h1 h2 -> ty-origin G (api A B) (at-pi G A B h1 h2) (h1, h2) ;
  at-uu G n h nb -> ty-origin G (auu n G) (at-uu G n h nb) (refl G, nb) ;
  at-el G n a h -> ty-origin G (ael n a) (at-el G n a h) h ;
  at-sb D G A s h1 h2 -> ty-origin D (asb A s) (at-sb D G A s h1 h2) (G, (h1, h2)) ;
  at-cx G D A h0 h1 h2 | r0 r1 r2 -> (r2.1, (r2.2.1, a-cx-trans r2.1 G D r2.2.2 h1)) ;
  am-lam G A B b h1 h2 h3 -> tm-origin G (alam A B b) (api A B) (am-lam G A B b h1 h2 h3) (h1, (h2, (h3, refl (api A B)))) ;
  am-app G A B c a h1 h2 h3 h4 -> tm-origin G (aapp A B c a) (asb B (asec A a)) (am-app G A B c a h1 h2 h3 h4)
    (h1, (h2, (h3, (h4, refl (asb B (asec A a)))))) ;
  am-pic G n a b h1 h2 -> tm-origin G (apic n a b) (auu n G) (am-pic G n a b h1 h2) (h1, (h2, refl (auu n G))) ;
  am-uc G m n h lt nb -> tm-origin G (auc m n G) (auu n G) (am-uc G m n h lt nb) (refl G, (lt, (nb, refl (auu n G)))) ;
  am-lf G m n a h le nb -> tm-origin G (alf m n a) (auu n G) (am-lf G m n a h le nb) (h, (le, (nb, refl (auu n G)))) ;
  am-q G A h -> tm-origin (aext G A) (aq G A) (asb A (ap G A)) (am-q G A h)
    (refl (aext G A), (h, refl (asb A (ap G A)))) ;
  am-sb D G a A s hA h1 h2 -> tm-origin D (asb a s) (asb A s) (am-sb D G a A s hA h1 h2) (G, (A, (hA, (h1, (h2, refl (asb A s)))))) ;
  am-conv G a A B h1 h2 | r1 r2 -> (r1.1, (r1.2.1, (r1.2.2.1, (r1.2.2.2.1, ae-trans G r1.2.1 A B r1.2.2.2.2 h2)))) ;
  am-cx G D a A h0 h1 h2 | r0 r1 r2 ->
    (r2.1, (r2.2.1, (r2.2.2.1, (a-cx-trans r2.1 G D r2.2.2.2.1 h1,
      ae-cx G D r2.2.1 A h0 h1 r2.2.2.2.2)))) ;
  ae-refl G A h -> tt ;
  ae-sym G A B h -> tt ;
  ae-trans G A B C h1 h2 -> tt ;
  ae-pi G A A' B B' h0 h1 h2 -> tt ;
  ae-el G n a a' h -> tt ;
  ae-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ae-el-lf G m n a h le nb -> tt ;
  ae-el-pic G n a b h1 h2 -> tt ;
  ae-el-uc G m n h lt nb -> tt ;
  ae-sb-id G A h -> tt ;
  ae-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ae-pi-sb D G A B s h1 h2 h3 -> tt ;
  ae-uu-sb D G n s h nb -> tt ;
  ae-el-sb D G n a s h1 h2 -> tt ;
  ae-cx G D A B h0 h1 h2 -> tt ;
  am-refl G a A h -> tt ;
  am-sym G a b A hA h -> tt ;
  am-trans G a b c A h1 h2 -> tt ;
  am-eqconv G a b A B h1 h2 -> tt ;
  am-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  am-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  am-epic G n a a' b b' h0 h1 h2 -> tt ;
  am-elf G m n a a' h le nb -> tt ;
  am-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  am-beta G A B b a hA hB h1 h2 -> tt ;
  am-eta G A B f hA hB h -> tt ;
  am-lf-pic G n p a b h1 h2 le nb -> tt ;
  am-lf-uc G m n p h lt le nb -> tt ;
  am-lf-lf G m n p a h le1 le2 nb -> tt ;
  am-sb-id G a A h -> tt ;
  am-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  am-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  am-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  am-pic-sb D G n a b s h1 h2 h3 -> tt ;
  am-uc-sb D G m n s h lt nb -> tt ;
  am-lf-sb D G m n a s h1 h2 le nb -> tt ;
  am-q-lift D G A s h1 h2 -> tt ;
  am-q-sec G A a h1 h2 -> tt ;
  am-ecx G D a b A h0 h1 h2 -> tt ;
  aq-refl D s G h -> tt ;
  aq-sym D s t G h -> tt ;
  aq-trans D s t u G h1 h2 -> tt ;
  aq-comp T D G s s' d d' h1 h2 -> tt ;
  aq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  aq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  aq-idl D G s h -> tt ;
  aq-idr D G s h -> tt ;
  aq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  aq-eps G s h -> tt ;
  aq-lift-id G A h -> tt ;
  aq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  aq-p-lift D G A s h1 h2 -> tt ;
  aq-p-sec G A a h1 h2 -> tt ;
  aq-sec-comp D G A a s h1 h2 h3 -> tt ;
  aq-lift-p-sec-q G A h -> tt ;
  ae-uu-cx G H n e nb -> tt ;
  am-uc-cx G H m n e lt nb -> tt ;
  aq-id-cx G H e -> tt ;
  aq-eps-cx G H e -> tt ;
  aq-p-cx G H A B e p -> tt ;
  am-q-cx G H A B e p -> tt } ;

gen-ty (G A : GA) (h : Ty G A) : TyGen G A = gen-typing (ajty G A) h ;
gen-tm (G a A : GA) (h : Tm' G a A) : TmGen G a A = gen-typing (ajtm G a A) h ;
gen-sub (D s G : GA) (h : Sb D s G) : SubGen D s G = gen-typing (ajsub D s G) h ;
