-- InitHomComp: composition of morphisms of TEModel[N] (PLAN-INIT,
-- Part C).  Segment of InitHomS.Composition (l, N, M1, M2, M3, fe).
-- For F : M1 -> M2 and G : M2 -> M3, Comp[F,G].comp : M1 -> M3.  The
-- four maps compose with no transport; each law of the composite is the
-- law of F, mapped by G, followed by the law of G.  The only work is
-- for the derived members (mv-ty, mv-el, code, mv-code): G commutes
-- with moving along a path of contexts of M2 (nat-*), moves compose
-- along trans (trans-*), and G.code after F.code is the code of the
-- composite (code-comp).  compS is the composition on the Sigma form.
open Base ;
open Prelude[l] ;
open Paths[l] ;
open EhrhardCwF ;
open EhrhardTEModel[l] ;
module A = InitHom.Morphism[l,N,M1,M2] ;
module B = InitHom.Morphism[l,N,M2,M3] ;
module Q = InitHom.Morphism[l,N,M1,M3] ;
module SA = MorphismS[l,N,M1,M2,fe] ;
module SB = MorphismS[l,N,M2,M3,fe] ;
module SQ = MorphismS[l,N,M1,M3,fe] ;

C1 : CwF[l] = M1.cwf ;
C2 : CwF[l] = M2.cwf ;
C3 : CwF[l] = M3.cwf ;
P1 : PiStr[l,C1] = M1.products ;
P2 : PiStr[l,C2] = M2.products ;
P3 : PiStr[l,C3] = M3.products ;

Term2 (Y : C2.Ctx) : U l = (T : C2.Ty Y) * C2.El Y T ;
Term3 (Z : C3.Ctx) : U l = (T : C3.Ty Z) * C3.El Z T ;
TmT2 : U l = (Y : C2.Ctx) * Term2 Y ;
TmT3 : U l = (Z : C3.Ctx) * Term3 Z ;
SubT2 : U l = (Y : C2.Ctx) * (Y' : C2.Ctx) * C2.Sub Y Y' ;
SubT3 : U l = (Z : C3.Ctx) * (Z' : C3.Ctx) * C3.Sub Z Z' ;
CodeF2 (n : LevelAt N) (Y : C2.Ctx) : U l = C2.El Y (M2.univ n Y) ;
CodeF3 (n : LevelAt N) (Z : C3.Ctx) : U l = C3.El Z (M3.univ n Z) ;

------------------------------------------------------------------------
-- moves along paths of contexts

mv2 (Y Y' : C2.Ctx) (e : Id C2.Ctx Y Y') (T : C2.Ty Y) : C2.Ty Y' = subst C2.Ctx C2.Ty Y Y' e T ;
mvE2 (Y Y' : C2.Ctx) (e : Id C2.Ctx Y Y') (T : C2.Ty Y) (t : C2.El Y T) : C2.El Y' (mv2 Y Y' e T) =
  idJ C2.Ctx Y (\ Z e1 -> C2.El Z (mv2 Y Z e1 T)) t Y' e ;
mvC2 (n : LevelAt N) (Y Y' : C2.Ctx) (e : Id C2.Ctx Y Y') (c : CodeF2 n Y) : CodeF2 n Y' =
  subst C2.Ctx (CodeF2 n) Y Y' e c ;

mv3 (Z Z' : C3.Ctx) (e : Id C3.Ctx Z Z') (T : C3.Ty Z) : C3.Ty Z' = subst C3.Ctx C3.Ty Z Z' e T ;
mvE3 (Z Z' : C3.Ctx) (e : Id C3.Ctx Z Z') (T : C3.Ty Z) (t : C3.El Z T) : C3.El Z' (mv3 Z Z' e T) =
  idJ C3.Ctx Z (\ W e1 -> C3.El W (mv3 Z W e1 T)) t Z' e ;
mvP3 (Z Z' : C3.Ctx) (e : Id C3.Ctx Z Z') (u : Term3 Z) : Term3 Z' =
  (mv3 Z Z' e u.1, mvE3 Z Z' e u.1 u.2) ;
mvC3 (n : LevelAt N) (Z Z' : C3.Ctx) (e : Id C3.Ctx Z Z') (c : CodeF3 n Z) : CodeF3 n Z' =
  subst C3.Ctx (CodeF3 n) Z Z' e c ;

-- moves compose along trans
trans-ty (Z Z' Z'' : C3.Ctx) (e1 : Id C3.Ctx Z Z') (e2 : Id C3.Ctx Z' Z'') (T : C3.Ty Z)
  : Id (C3.Ty Z'') (mv3 Z' Z'' e2 (mv3 Z Z' e1 T)) (mv3 Z Z'' (trans C3.Ctx Z Z' Z'' e1 e2) T) =
  idJ C3.Ctx Z' (\ W e3 -> Id (C3.Ty W) (mv3 Z' W e3 (mv3 Z Z' e1 T)) (mv3 Z W (trans C3.Ctx Z Z' W e1 e3) T))
    (refl (mv3 Z Z' e1 T)) Z'' e2 ;

trans-tm (Z Z' Z'' : C3.Ctx) (e1 : Id C3.Ctx Z Z') (e2 : Id C3.Ctx Z' Z'') (u : Term3 Z)
  : Id (Term3 Z'') (mvP3 Z' Z'' e2 (mvP3 Z Z' e1 u)) (mvP3 Z Z'' (trans C3.Ctx Z Z' Z'' e1 e2) u) =
  idJ C3.Ctx Z' (\ W e3 -> Id (Term3 W) (mvP3 Z' W e3 (mvP3 Z Z' e1 u)) (mvP3 Z W (trans C3.Ctx Z Z' W e1 e3) u))
    (refl (mvP3 Z Z' e1 u)) Z'' e2 ;

trans-code (n : LevelAt N) (Z Z' Z'' : C3.Ctx) (e1 : Id C3.Ctx Z Z') (e2 : Id C3.Ctx Z' Z'') (c : CodeF3 n Z)
  : Id (CodeF3 n Z'') (mvC3 n Z' Z'' e2 (mvC3 n Z Z' e1 c)) (mvC3 n Z Z'' (trans C3.Ctx Z Z' Z'' e1 e2) c) =
  idJ C3.Ctx Z' (\ W e3 -> Id (CodeF3 n W) (mvC3 n Z' W e3 (mvC3 n Z Z' e1 c)) (mvC3 n Z W (trans C3.Ctx Z Z' W e1 e3) c))
    (refl (mvC3 n Z Z' e1 c)) Z'' e2 ;

-- transports in a family compose along trans
subst-trans (X : U l) (Fm : X -> U l) (x y z : X) (p : Id X x y) (q : Id X y z) (u : Fm x)
  : Id (Fm z) (subst X Fm y z q (subst X Fm x y p u)) (subst X Fm x z (trans X x y z p q) u) =
  idJ X y (\ w r -> Id (Fm w) (subst X Fm y w r (subst X Fm x y p u)) (subst X Fm x w (trans X x y w p r) u))
    (refl (subst X Fm x y p u)) z q ;

-- two codes over equal codes, moved from one context, are equal pairs
CodePair (n : LevelAt N) (W : C3.Ctx) : U l =
  (c : CodeF3 n W) * CodeF3 n (C3.ext W (M3.decode n W c)) ;

code-pair (n : LevelAt N) (W Z0 : C3.Ctx) (c1 c2 : CodeF3 n W) (q : Id (CodeF3 n W) c1 c2)
    (e1 : Id C3.Ctx Z0 (C3.ext W (M3.decode n W c1))) (e2 : Id C3.Ctx Z0 (C3.ext W (M3.decode n W c2)))
    (m0 : CodeF3 n Z0)
  : Id (CodePair n W) (c1, mvC3 n Z0 (C3.ext W (M3.decode n W c1)) e1 m0)
                      (c2, mvC3 n Z0 (C3.ext W (M3.decode n W c2)) e2 m0) =
  idJ (CodeF3 n W) c1
    (\ c3 q3 -> (e3 : Id C3.Ctx Z0 (C3.ext W (M3.decode n W c3)))
       -> Id (CodePair n W) (c1, mvC3 n Z0 (C3.ext W (M3.decode n W c1)) e1 m0)
                            (c3, mvC3 n Z0 (C3.ext W (M3.decode n W c3)) e3 m0))
    (\ e3 -> ap (Id C3.Ctx Z0 (C3.ext W (M3.decode n W c1))) (CodePair n W)
               (\ e4 -> (c1, mvC3 n Z0 (C3.ext W (M3.decode n W c1)) e4 m0)) e1 e3
               (M3.isSetCtx Z0 (C3.ext W (M3.decode n W c1)) e1 e3))
    c2 q e2 ;

------------------------------------------------------------------------
-- the composite of F : M1 -> M2 and G : M2 -> M3

module Comp (F : A.InitHomLaws.Hom) (G : B.InitHomLaws.Hom) {

  -- G commutes with moves along paths of contexts of M2
  nat-ty (Y Y' : C2.Ctx) (e : Id C2.Ctx Y Y') (T : C2.Ty Y)
    : Id (C3.Ty (G.ctx Y')) (G.ty Y' (mv2 Y Y' e T))
         (mv3 (G.ctx Y) (G.ctx Y') (ap C2.Ctx C3.Ctx G.ctx Y Y' e) (G.ty Y T)) =
    idJ C2.Ctx Y (\ Z e1 -> Id (C3.Ty (G.ctx Z)) (G.ty Z (mv2 Y Z e1 T))
                              (mv3 (G.ctx Y) (G.ctx Z) (ap C2.Ctx C3.Ctx G.ctx Y Z e1) (G.ty Y T)))
      (refl (G.ty Y T)) Y' e ;

  nat-tm (Y Y' : C2.Ctx) (e : Id C2.Ctx Y Y') (T : C2.Ty Y) (t : C2.El Y T)
    : Id (Term3 (G.ctx Y')) (G.ty Y' (mv2 Y Y' e T), G.tm Y' (mv2 Y Y' e T) (mvE2 Y Y' e T t))
         (mvP3 (G.ctx Y) (G.ctx Y') (ap C2.Ctx C3.Ctx G.ctx Y Y' e) (G.ty Y T, G.tm Y T t)) =
    idJ C2.Ctx Y (\ Z e1 -> Id (Term3 (G.ctx Z)) (G.ty Z (mv2 Y Z e1 T), G.tm Z (mv2 Y Z e1 T) (mvE2 Y Z e1 T t))
                              (mvP3 (G.ctx Y) (G.ctx Z) (ap C2.Ctx C3.Ctx G.ctx Y Z e1) (G.ty Y T, G.tm Y T t)))
      (refl (G.ty Y T, G.tm Y T t)) Y' e ;

  nat-code (n : LevelAt N) (Y Y' : C2.Ctx) (e : Id C2.Ctx Y Y') (c : CodeF2 n Y)
    : Id (CodeF3 n (G.ctx Y')) (G.code n Y' (mvC2 n Y Y' e c))
         (mvC3 n (G.ctx Y) (G.ctx Y') (ap C2.Ctx C3.Ctx G.ctx Y Y' e) (G.code n Y c)) =
    idJ C2.Ctx Y (\ Z e1 -> Id (CodeF3 n (G.ctx Z)) (G.code n Z (mvC2 n Y Z e1 c))
                              (mvC3 n (G.ctx Y) (G.ctx Z) (ap C2.Ctx C3.Ctx G.ctx Y Z e1) (G.code n Y c)))
      (refl (G.code n Y c)) Y' e ;

  -- G commutes with transport of a term along a path of types
  nat-subst (Y : C2.Ctx) (T T' : C2.Ty Y) (q : Id (C2.Ty Y) T T') (t : C2.El Y T)
    : Id (C3.El (G.ctx Y) (G.ty Y T')) (G.tm Y T' (subst (C2.Ty Y) (C2.El Y) T T' q t))
         (subst (C3.Ty (G.ctx Y)) (C3.El (G.ctx Y)) (G.ty Y T) (G.ty Y T')
            (ap (C2.Ty Y) (C3.Ty (G.ctx Y)) (G.ty Y) T T' q) (G.tm Y T t)) =
    idJ (C2.Ty Y) T (\ T1 q1 -> Id (C3.El (G.ctx Y) (G.ty Y T1)) (G.tm Y T1 (subst (C2.Ty Y) (C2.El Y) T T1 q1 t))
         (subst (C3.Ty (G.ctx Y)) (C3.El (G.ctx Y)) (G.ty Y T) (G.ty Y T1)
            (ap (C2.Ty Y) (C3.Ty (G.ctx Y)) (G.ty Y) T T1 q1) (G.tm Y T t)))
      (refl (G.tm Y T t)) T' q ;

  ----------------------------------------------------------------------
  -- the four maps

  cctx (X : C1.Ctx) : C3.Ctx = G.ctx (F.ctx X) ;
  csub (D X : C1.Ctx) (s : C1.Sub D X) : C3.Sub (cctx D) (cctx X) = G.sub (F.ctx D) (F.ctx X) (F.sub D X s) ;
  cty (X : C1.Ctx) (A : C1.Ty X) : C3.Ty (cctx X) = G.ty (F.ctx X) (F.ty X A) ;
  ctm (X : C1.Ctx) (A : C1.Ty X) (a : C1.El X A) : C3.El (cctx X) (cty X A) =
    G.tm (F.ctx X) (F.ty X A) (F.tm X A a) ;

  -- G on total spaces
  Gs (u : SubT2) : SubT3 = (G.ctx u.1, (G.ctx u.2.1, G.sub u.1 u.2.1 u.2.2)) ;
  Gt (Y : C2.Ctx) (u : Term2 Y) : Term3 (G.ctx Y) = (G.ty Y u.1, G.tm Y u.1 u.2) ;
  Gtt (u : TmT2) : TmT3 = (G.ctx u.1, Gt u.1 u.2) ;

  ----------------------------------------------------------------------
  -- contexts

  c-ctx-nil : Id C3.Ctx (cctx C1.nil) C3.nil =
    trans C3.Ctx (G.ctx (F.ctx C1.nil)) (G.ctx C2.nil) C3.nil
      (ap C2.Ctx C3.Ctx G.ctx (F.ctx C1.nil) C2.nil F.ctx-nil) G.ctx-nil ;

  cce (X : C1.Ctx) (A : C1.Ty X) : Id C3.Ctx (cctx (C1.ext X A)) (C3.ext (cctx X) (cty X A)) =
    trans C3.Ctx (cctx (C1.ext X A)) (G.ctx (C2.ext (F.ctx X) (F.ty X A))) (C3.ext (cctx X) (cty X A))
      (ap C2.Ctx C3.Ctx G.ctx (F.ctx (C1.ext X A)) (C2.ext (F.ctx X) (F.ty X A)) (F.ctx-ext X A))
      (G.ctx-ext (F.ctx X) (F.ty X A)) ;

  ----------------------------------------------------------------------
  -- substitutions

  c-sub-id (X : C1.Ctx) : Id (C3.Sub (cctx X) (cctx X)) (csub X X (C1.id X)) (C3.id (cctx X)) =
    trans (C3.Sub (cctx X) (cctx X)) (csub X X (C1.id X)) (G.sub (F.ctx X) (F.ctx X) (C2.id (F.ctx X))) (C3.id (cctx X))
      (ap (C2.Sub (F.ctx X) (F.ctx X)) (C3.Sub (cctx X) (cctx X)) (G.sub (F.ctx X) (F.ctx X))
          (F.sub X X (C1.id X)) (C2.id (F.ctx X)) (F.sub-id X))
      (G.sub-id (F.ctx X)) ;

  c-sub-o (T D X : C1.Ctx) (s : C1.Sub D X) (s' : C1.Sub T D)
    : Id (C3.Sub (cctx T) (cctx X)) (csub T X (C1.o T D X s s'))
         (C3.o (cctx T) (cctx D) (cctx X) (csub D X s) (csub T D s')) =
    trans (C3.Sub (cctx T) (cctx X)) (csub T X (C1.o T D X s s'))
      (G.sub (F.ctx T) (F.ctx X) (C2.o (F.ctx T) (F.ctx D) (F.ctx X) (F.sub D X s) (F.sub T D s')))
      (C3.o (cctx T) (cctx D) (cctx X) (csub D X s) (csub T D s'))
      (ap (C2.Sub (F.ctx T) (F.ctx X)) (C3.Sub (cctx T) (cctx X)) (G.sub (F.ctx T) (F.ctx X))
          (F.sub T X (C1.o T D X s s')) (C2.o (F.ctx T) (F.ctx D) (F.ctx X) (F.sub D X s) (F.sub T D s'))
          (F.sub-o T D X s s'))
      (G.sub-o (F.ctx T) (F.ctx D) (F.ctx X) (F.sub D X s) (F.sub T D s')) ;

  c-sub-eps (X : C1.Ctx)
    : Id SubT3 (cctx X, (cctx C1.nil, csub X C1.nil (C1.eps X))) (cctx X, (C3.nil, C3.eps (cctx X))) =
    trans SubT3 (Gs (F.ctx X, (F.ctx C1.nil, F.sub X C1.nil (C1.eps X))))
      (Gs (F.ctx X, (C2.nil, C2.eps (F.ctx X)))) (cctx X, (C3.nil, C3.eps (cctx X)))
      (ap SubT2 SubT3 Gs (F.ctx X, (F.ctx C1.nil, F.sub X C1.nil (C1.eps X)))
          (F.ctx X, (C2.nil, C2.eps (F.ctx X))) (F.sub-eps X))
      (G.sub-eps (F.ctx X)) ;

  c-sub-p (X : C1.Ctx) (A : C1.Ty X)
    : Id SubT3 (cctx (C1.ext X A), (cctx X, csub (C1.ext X A) X (C1.p X A)))
               (C3.ext (cctx X) (cty X A), (cctx X, C3.p (cctx X) (cty X A))) =
    trans SubT3 (Gs (F.ctx (C1.ext X A), (F.ctx X, F.sub (C1.ext X A) X (C1.p X A))))
      (Gs (C2.ext (F.ctx X) (F.ty X A), (F.ctx X, C2.p (F.ctx X) (F.ty X A))))
      (C3.ext (cctx X) (cty X A), (cctx X, C3.p (cctx X) (cty X A)))
      (ap SubT2 SubT3 Gs (F.ctx (C1.ext X A), (F.ctx X, F.sub (C1.ext X A) X (C1.p X A)))
          (C2.ext (F.ctx X) (F.ty X A), (F.ctx X, C2.p (F.ctx X) (F.ty X A))) (F.sub-p X A))
      (G.sub-p (F.ctx X) (F.ty X A)) ;

  c-sub-lift (D X : C1.Ctx) (A : C1.Ty X) (s : C1.Sub D X)
    : Id SubT3 (cctx (C1.ext D (C1.subT D X A s)),
                (cctx (C1.ext X A), csub (C1.ext D (C1.subT D X A s)) (C1.ext X A) (C1.lift D X A s)))
               (C3.ext (cctx D) (C3.subT (cctx D) (cctx X) (cty X A) (csub D X s)),
                (C3.ext (cctx X) (cty X A), C3.lift (cctx D) (cctx X) (cty X A) (csub D X s))) =
    trans SubT3
      (Gs (F.ctx (C1.ext D (C1.subT D X A s)),
           (F.ctx (C1.ext X A), F.sub (C1.ext D (C1.subT D X A s)) (C1.ext X A) (C1.lift D X A s))))
      (Gs (C2.ext (F.ctx D) (C2.subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)),
           (C2.ext (F.ctx X) (F.ty X A), C2.lift (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s))))
      (C3.ext (cctx D) (C3.subT (cctx D) (cctx X) (cty X A) (csub D X s)),
       (C3.ext (cctx X) (cty X A), C3.lift (cctx D) (cctx X) (cty X A) (csub D X s)))
      (ap SubT2 SubT3 Gs
          (F.ctx (C1.ext D (C1.subT D X A s)),
           (F.ctx (C1.ext X A), F.sub (C1.ext D (C1.subT D X A s)) (C1.ext X A) (C1.lift D X A s)))
          (C2.ext (F.ctx D) (C2.subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)),
           (C2.ext (F.ctx X) (F.ty X A), C2.lift (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)))
          (F.sub-lift D X A s))
      (G.sub-lift (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)) ;

  c-sub-sec (X : C1.Ctx) (A : C1.Ty X) (a : C1.El X A)
    : Id SubT3 (cctx X, (cctx (C1.ext X A), csub X (C1.ext X A) (C1.sec X A a)))
               (cctx X, (C3.ext (cctx X) (cty X A), C3.sec (cctx X) (cty X A) (ctm X A a))) =
    trans SubT3 (Gs (F.ctx X, (F.ctx (C1.ext X A), F.sub X (C1.ext X A) (C1.sec X A a))))
      (Gs (F.ctx X, (C2.ext (F.ctx X) (F.ty X A), C2.sec (F.ctx X) (F.ty X A) (F.tm X A a))))
      (cctx X, (C3.ext (cctx X) (cty X A), C3.sec (cctx X) (cty X A) (ctm X A a)))
      (ap SubT2 SubT3 Gs (F.ctx X, (F.ctx (C1.ext X A), F.sub X (C1.ext X A) (C1.sec X A a)))
          (F.ctx X, (C2.ext (F.ctx X) (F.ty X A), C2.sec (F.ctx X) (F.ty X A) (F.tm X A a))) (F.sub-sec X A a))
      (G.sub-sec (F.ctx X) (F.ty X A) (F.tm X A a)) ;

  ----------------------------------------------------------------------
  -- types

  c-ty-subT (D X : C1.Ctx) (A : C1.Ty X) (s : C1.Sub D X)
    : Id (C3.Ty (cctx D)) (cty D (C1.subT D X A s)) (C3.subT (cctx D) (cctx X) (cty X A) (csub D X s)) =
    trans (C3.Ty (cctx D)) (cty D (C1.subT D X A s))
      (G.ty (F.ctx D) (C2.subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)))
      (C3.subT (cctx D) (cctx X) (cty X A) (csub D X s))
      (ap (C2.Ty (F.ctx D)) (C3.Ty (cctx D)) (G.ty (F.ctx D)) (F.ty D (C1.subT D X A s))
          (C2.subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)) (F.ty-subT D X A s))
      (G.ty-subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s)) ;

  -- the move of the composite, and G's move of F's move
  cmvTy (X : C1.Ctx) (A : C1.Ty X) (B : C1.Ty (C1.ext X A)) : C3.Ty (C3.ext (cctx X) (cty X A)) =
    mv3 (cctx (C1.ext X A)) (C3.ext (cctx X) (cty X A)) (cce X A) (cty (C1.ext X A) B) ;
  cmvTm (X : C1.Ctx) (A : C1.Ty X) (B : C1.Ty (C1.ext X A)) (b : C1.El (C1.ext X A) B)
    : Term3 (C3.ext (cctx X) (cty X A)) =
    mvP3 (cctx (C1.ext X A)) (C3.ext (cctx X) (cty X A)) (cce X A) (cty (C1.ext X A) B, ctm (C1.ext X A) B b) ;

  -- the endpoints of the three paths
  ZA (X : C1.Ctx) (A : C1.Ty X) : C3.Ctx = cctx (C1.ext X A) ;
  ZB (X : C1.Ctx) (A : C1.Ty X) : C3.Ctx = G.ctx (C2.ext (F.ctx X) (F.ty X A)) ;
  ZC (X : C1.Ctx) (A : C1.Ty X) : C3.Ctx = C3.ext (cctx X) (cty X A) ;
  eAB (X : C1.Ctx) (A : C1.Ty X) : Id C3.Ctx (ZA X A) (ZB X A) =
    ap C2.Ctx C3.Ctx G.ctx (F.ctx (C1.ext X A)) (C2.ext (F.ctx X) (F.ty X A)) (F.ctx-ext X A) ;

  mvTy-comp (X : C1.Ctx) (A : C1.Ty X) (B : C1.Ty (C1.ext X A))
    : Id (C3.Ty (ZC X A)) (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B)) (cmvTy X A B) =
    trans (C3.Ty (ZC X A)) (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B))
      (mv3 (ZB X A) (ZC X A) (G.ctx-ext (F.ctx X) (F.ty X A)) (mv3 (ZA X A) (ZB X A) (eAB X A) (cty (C1.ext X A) B)))
      (cmvTy X A B)
      (ap (C3.Ty (ZB X A)) (C3.Ty (ZC X A)) (mv3 (ZB X A) (ZC X A) (G.ctx-ext (F.ctx X) (F.ty X A)))
          (G.ty (C2.ext (F.ctx X) (F.ty X A)) (F.mv-ty X A B))
          (mv3 (ZA X A) (ZB X A) (eAB X A) (cty (C1.ext X A) B))
          (nat-ty (F.ctx (C1.ext X A)) (C2.ext (F.ctx X) (F.ty X A)) (F.ctx-ext X A) (F.ty (C1.ext X A) B)))
      (trans-ty (ZA X A) (ZB X A) (ZC X A) (eAB X A) (G.ctx-ext (F.ctx X) (F.ty X A)) (cty (C1.ext X A) B)) ;

  mvTm-comp (X : C1.Ctx) (A : C1.Ty X) (B : C1.Ty (C1.ext X A)) (b : C1.El (C1.ext X A) B)
    : Id (Term3 (ZC X A)) (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B),
                           G.mv-el (F.ctx X) (F.ty X A) (F.mv-ty X A B) (F.mv-el X A B b))
         (cmvTm X A B b) =
    trans (Term3 (ZC X A))
      (mvP3 (ZB X A) (ZC X A) (G.ctx-ext (F.ctx X) (F.ty X A))
         (G.ty (C2.ext (F.ctx X) (F.ty X A)) (F.mv-ty X A B),
          G.tm (C2.ext (F.ctx X) (F.ty X A)) (F.mv-ty X A B) (F.mv-el X A B b)))
      (mvP3 (ZB X A) (ZC X A) (G.ctx-ext (F.ctx X) (F.ty X A))
         (mvP3 (ZA X A) (ZB X A) (eAB X A) (cty (C1.ext X A) B, ctm (C1.ext X A) B b)))
      (cmvTm X A B b)
      (ap (Term3 (ZB X A)) (Term3 (ZC X A)) (mvP3 (ZB X A) (ZC X A) (G.ctx-ext (F.ctx X) (F.ty X A)))
          (G.ty (C2.ext (F.ctx X) (F.ty X A)) (F.mv-ty X A B),
           G.tm (C2.ext (F.ctx X) (F.ty X A)) (F.mv-ty X A B) (F.mv-el X A B b))
          (mvP3 (ZA X A) (ZB X A) (eAB X A) (cty (C1.ext X A) B, ctm (C1.ext X A) B b))
          (nat-tm (F.ctx (C1.ext X A)) (C2.ext (F.ctx X) (F.ty X A)) (F.ctx-ext X A)
             (F.ty (C1.ext X A) B) (F.tm (C1.ext X A) B b)))
      (trans-tm (ZA X A) (ZB X A) (ZC X A) (eAB X A) (G.ctx-ext (F.ctx X) (F.ty X A))
         (cty (C1.ext X A) B, ctm (C1.ext X A) B b)) ;

  c-ty-Pi (X : C1.Ctx) (A : C1.Ty X) (B : C1.Ty (C1.ext X A))
    : Id (C3.Ty (cctx X)) (cty X (P1.Pi X A B)) (P3.Pi (cctx X) (cty X A) (cmvTy X A B)) =
    trans (C3.Ty (cctx X)) (cty X (P1.Pi X A B))
      (G.ty (F.ctx X) (P2.Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B)))
      (P3.Pi (cctx X) (cty X A) (cmvTy X A B))
      (ap (C2.Ty (F.ctx X)) (C3.Ty (cctx X)) (G.ty (F.ctx X)) (F.ty X (P1.Pi X A B))
          (P2.Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B)) (F.ty-Pi X A B))
      (trans (C3.Ty (cctx X)) (G.ty (F.ctx X) (P2.Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B)))
         (P3.Pi (cctx X) (cty X A) (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B)))
         (P3.Pi (cctx X) (cty X A) (cmvTy X A B))
         (G.ty-Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B))
         (ap (C3.Ty (ZC X A)) (C3.Ty (cctx X)) (\ T -> P3.Pi (cctx X) (cty X A) T)
             (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B)) (cmvTy X A B) (mvTy-comp X A B))) ;

  ----------------------------------------------------------------------
  -- universes and codes

  ctu (n : LevelAt N) (X : C1.Ctx) : Id (C3.Ty (cctx X)) (cty X (M1.univ n X)) (M3.univ n (cctx X)) =
    trans (C3.Ty (cctx X)) (cty X (M1.univ n X)) (G.ty (F.ctx X) (M2.univ n (F.ctx X))) (M3.univ n (cctx X))
      (ap (C2.Ty (F.ctx X)) (C3.Ty (cctx X)) (G.ty (F.ctx X)) (F.ty X (M1.univ n X)) (M2.univ n (F.ctx X))
          (F.ty-univ n X))
      (G.ty-univ n (F.ctx X)) ;

  ccode (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X)) : CodeF3 n (cctx X) =
    subst (C3.Ty (cctx X)) (C3.El (cctx X)) (cty X (M1.univ n X)) (M3.univ n (cctx X)) (ctu n X)
      (ctm X (M1.univ n X) a) ;

  code-comp (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
    : Id (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X a)) (ccode n X a) =
    trans (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X a))
      (subst (C3.Ty (cctx X)) (C3.El (cctx X)) (G.ty (F.ctx X) (M2.univ n (F.ctx X))) (M3.univ n (cctx X))
         (G.ty-univ n (F.ctx X))
         (subst (C3.Ty (cctx X)) (C3.El (cctx X)) (cty X (M1.univ n X)) (G.ty (F.ctx X) (M2.univ n (F.ctx X)))
            (ap (C2.Ty (F.ctx X)) (C3.Ty (cctx X)) (G.ty (F.ctx X)) (F.ty X (M1.univ n X)) (M2.univ n (F.ctx X))
                (F.ty-univ n X))
            (ctm X (M1.univ n X) a)))
      (ccode n X a)
      (ap (C3.El (cctx X) (G.ty (F.ctx X) (M2.univ n (F.ctx X)))) (CodeF3 n (cctx X))
          (subst (C3.Ty (cctx X)) (C3.El (cctx X)) (G.ty (F.ctx X) (M2.univ n (F.ctx X))) (M3.univ n (cctx X))
             (G.ty-univ n (F.ctx X)))
          (G.tm (F.ctx X) (M2.univ n (F.ctx X)) (F.code n X a))
          (subst (C3.Ty (cctx X)) (C3.El (cctx X)) (cty X (M1.univ n X)) (G.ty (F.ctx X) (M2.univ n (F.ctx X)))
             (ap (C2.Ty (F.ctx X)) (C3.Ty (cctx X)) (G.ty (F.ctx X)) (F.ty X (M1.univ n X)) (M2.univ n (F.ctx X))
                 (F.ty-univ n X))
             (ctm X (M1.univ n X) a))
          (nat-subst (F.ctx X) (F.ty X (M1.univ n X)) (M2.univ n (F.ctx X)) (F.ty-univ n X)
             (F.tm X (M1.univ n X) a)))
      (subst-trans (C3.Ty (cctx X)) (C3.El (cctx X)) (cty X (M1.univ n X)) (G.ty (F.ctx X) (M2.univ n (F.ctx X)))
         (M3.univ n (cctx X))
         (ap (C2.Ty (F.ctx X)) (C3.Ty (cctx X)) (G.ty (F.ctx X)) (F.ty X (M1.univ n X)) (M2.univ n (F.ctx X))
             (F.ty-univ n X))
         (G.ty-univ n (F.ctx X)) (ctm X (M1.univ n X) a)) ;

  c-ty-decode (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
    : Id (C3.Ty (cctx X)) (cty X (M1.decode n X a)) (M3.decode n (cctx X) (ccode n X a)) =
    trans (C3.Ty (cctx X)) (cty X (M1.decode n X a))
      (G.ty (F.ctx X) (M2.decode n (F.ctx X) (F.code n X a)))
      (M3.decode n (cctx X) (ccode n X a))
      (ap (C2.Ty (F.ctx X)) (C3.Ty (cctx X)) (G.ty (F.ctx X)) (F.ty X (M1.decode n X a))
          (M2.decode n (F.ctx X) (F.code n X a)) (F.ty-decode n X a))
      (trans (C3.Ty (cctx X)) (G.ty (F.ctx X) (M2.decode n (F.ctx X) (F.code n X a)))
         (M3.decode n (cctx X) (G.code n (F.ctx X) (F.code n X a)))
         (M3.decode n (cctx X) (ccode n X a))
         (G.ty-decode n (F.ctx X) (F.code n X a))
         (ap (CodeF3 n (cctx X)) (C3.Ty (cctx X)) (M3.decode n (cctx X))
             (G.code n (F.ctx X) (F.code n X a)) (ccode n X a) (code-comp n X a))) ;

  -- the binder of pic for the composite, and its move
  cdec-ext (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
    : Id C3.Ctx (cctx (C1.ext X (M1.decode n X a))) (C3.ext (cctx X) (M3.decode n (cctx X) (ccode n X a))) =
    trans C3.Ctx (cctx (C1.ext X (M1.decode n X a))) (C3.ext (cctx X) (cty X (M1.decode n X a)))
      (C3.ext (cctx X) (M3.decode n (cctx X) (ccode n X a)))
      (cce X (M1.decode n X a))
      (ap (C3.Ty (cctx X)) C3.Ctx (\ T -> C3.ext (cctx X) T)
          (cty X (M1.decode n X a)) (M3.decode n (cctx X) (ccode n X a)) (c-ty-decode n X a)) ;

  cmvCode (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
      (b : C1.El (C1.ext X (M1.decode n X a)) (M1.univ n (C1.ext X (M1.decode n X a))))
    : CodeF3 n (C3.ext (cctx X) (M3.decode n (cctx X) (ccode n X a))) =
    mvC3 n (cctx (C1.ext X (M1.decode n X a))) (C3.ext (cctx X) (M3.decode n (cctx X) (ccode n X a)))
      (cdec-ext n X a) (ccode n (C1.ext X (M1.decode n X a)) b) ;

  -- abbreviations for tm-pic
  Xd (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X)) : C1.Ctx = C1.ext X (M1.decode n X a) ;
  Yd (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X)) : C2.Ctx =
    C2.ext (F.ctx X) (M2.decode n (F.ctx X) (F.code n X a)) ;
  Wd (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X)) : C3.Ctx =
    C3.ext (cctx X) (M3.decode n (cctx X) (G.code n (F.ctx X) (F.code n X a))) ;
  eF (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X)) : Id C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) =
    ap C2.Ctx C3.Ctx G.ctx (F.ctx (Xd n X a)) (Yd n X a) (F.dec-ext n X a) ;

  mvCode-comp (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
      (b : C1.El (Xd n X a) (M1.univ n (Xd n X a)))
    : Id (CodeF3 n (Wd n X a))
         (G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
         (mvC3 n (cctx (Xd n X a)) (Wd n X a)
            (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
            (ccode n (Xd n X a) b)) =
    trans (CodeF3 n (Wd n X a))
      (G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
      (mvC3 n (G.ctx (Yd n X a)) (Wd n X a) (G.dec-ext n (F.ctx X) (F.code n X a))
         (mvC3 n (cctx (Xd n X a)) (G.ctx (Yd n X a)) (eF n X a) (G.code n (F.ctx (Xd n X a)) (F.code n (Xd n X a) b))))
      (mvC3 n (cctx (Xd n X a)) (Wd n X a)
         (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
         (ccode n (Xd n X a) b))
      (ap (CodeF3 n (G.ctx (Yd n X a))) (CodeF3 n (Wd n X a))
          (mvC3 n (G.ctx (Yd n X a)) (Wd n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
          (G.code n (Yd n X a) (F.mv-code n X a b))
          (mvC3 n (cctx (Xd n X a)) (G.ctx (Yd n X a)) (eF n X a) (G.code n (F.ctx (Xd n X a)) (F.code n (Xd n X a) b)))
          (nat-code n (F.ctx (Xd n X a)) (Yd n X a) (F.dec-ext n X a) (F.code n (Xd n X a) b)))
      (trans (CodeF3 n (Wd n X a))
         (mvC3 n (G.ctx (Yd n X a)) (Wd n X a) (G.dec-ext n (F.ctx X) (F.code n X a))
            (mvC3 n (cctx (Xd n X a)) (G.ctx (Yd n X a)) (eF n X a) (G.code n (F.ctx (Xd n X a)) (F.code n (Xd n X a) b))))
         (mvC3 n (cctx (Xd n X a)) (Wd n X a)
            (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
            (G.code n (F.ctx (Xd n X a)) (F.code n (Xd n X a) b)))
         (mvC3 n (cctx (Xd n X a)) (Wd n X a)
            (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
            (ccode n (Xd n X a) b))
         (trans-code n (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a))
            (G.code n (F.ctx (Xd n X a)) (F.code n (Xd n X a) b)))
         (ap (CodeF3 n (cctx (Xd n X a))) (CodeF3 n (Wd n X a))
             (mvC3 n (cctx (Xd n X a)) (Wd n X a)
                (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a))))
             (G.code n (F.ctx (Xd n X a)) (F.code n (Xd n X a) b)) (ccode n (Xd n X a) b)
             (code-comp n (Xd n X a) b))) ;

  pair-comp (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
      (b : C1.El (Xd n X a) (M1.univ n (Xd n X a)))
    : Id (CodePair n (cctx X))
         (G.code n (F.ctx X) (F.code n X a), G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
         (ccode n X a, cmvCode n X a b) =
    trans (CodePair n (cctx X))
      (G.code n (F.ctx X) (F.code n X a), G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
      (G.code n (F.ctx X) (F.code n X a),
       mvC3 n (cctx (Xd n X a)) (Wd n X a)
         (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
         (ccode n (Xd n X a) b))
      (ccode n X a, cmvCode n X a b)
      (ap (CodeF3 n (Wd n X a)) (CodePair n (cctx X)) (\ v -> (G.code n (F.ctx X) (F.code n X a), v))
          (G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
          (mvC3 n (cctx (Xd n X a)) (Wd n X a)
             (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
             (ccode n (Xd n X a) b))
          (mvCode-comp n X a b))
      (code-pair n (cctx X) (cctx (Xd n X a)) (G.code n (F.ctx X) (F.code n X a)) (ccode n X a) (code-comp n X a)
         (trans C3.Ctx (cctx (Xd n X a)) (G.ctx (Yd n X a)) (Wd n X a) (eF n X a) (G.dec-ext n (F.ctx X) (F.code n X a)))
         (cdec-ext n X a) (ccode n (Xd n X a) b)) ;

  ----------------------------------------------------------------------
  -- terms

  c-tm-subt (D X : C1.Ctx) (A : C1.Ty X) (a : C1.El X A) (s : C1.Sub D X)
    : Id (Term3 (cctx D)) (cty D (C1.subT D X A s), ctm D (C1.subT D X A s) (C1.subt D X A a s))
         (C3.subT (cctx D) (cctx X) (cty X A) (csub D X s),
          C3.subt (cctx D) (cctx X) (cty X A) (ctm X A a) (csub D X s)) =
    trans (Term3 (cctx D))
      (Gt (F.ctx D) (F.ty D (C1.subT D X A s), F.tm D (C1.subT D X A s) (C1.subt D X A a s)))
      (Gt (F.ctx D) (C2.subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s),
                     C2.subt (F.ctx D) (F.ctx X) (F.ty X A) (F.tm X A a) (F.sub D X s)))
      (C3.subT (cctx D) (cctx X) (cty X A) (csub D X s),
       C3.subt (cctx D) (cctx X) (cty X A) (ctm X A a) (csub D X s))
      (ap (Term2 (F.ctx D)) (Term3 (cctx D)) (Gt (F.ctx D))
          (F.ty D (C1.subT D X A s), F.tm D (C1.subT D X A s) (C1.subt D X A a s))
          (C2.subT (F.ctx D) (F.ctx X) (F.ty X A) (F.sub D X s),
           C2.subt (F.ctx D) (F.ctx X) (F.ty X A) (F.tm X A a) (F.sub D X s))
          (F.tm-subt D X A a s))
      (G.tm-subt (F.ctx D) (F.ctx X) (F.ty X A) (F.tm X A a) (F.sub D X s)) ;

  c-tm-q (X : C1.Ctx) (A : C1.Ty X)
    : Id TmT3 (cctx (C1.ext X A), (cty (C1.ext X A) (C1.subT (C1.ext X A) X A (C1.p X A)),
                                   ctm (C1.ext X A) (C1.subT (C1.ext X A) X A (C1.p X A)) (C1.q X A)))
              (C3.ext (cctx X) (cty X A),
               (C3.subT (C3.ext (cctx X) (cty X A)) (cctx X) (cty X A) (C3.p (cctx X) (cty X A)),
                C3.q (cctx X) (cty X A))) =
    trans TmT3
      (Gtt (F.ctx (C1.ext X A), (F.ty (C1.ext X A) (C1.subT (C1.ext X A) X A (C1.p X A)),
                                 F.tm (C1.ext X A) (C1.subT (C1.ext X A) X A (C1.p X A)) (C1.q X A))))
      (Gtt (C2.ext (F.ctx X) (F.ty X A),
            (C2.subT (C2.ext (F.ctx X) (F.ty X A)) (F.ctx X) (F.ty X A) (C2.p (F.ctx X) (F.ty X A)),
             C2.q (F.ctx X) (F.ty X A))))
      (C3.ext (cctx X) (cty X A),
       (C3.subT (C3.ext (cctx X) (cty X A)) (cctx X) (cty X A) (C3.p (cctx X) (cty X A)),
        C3.q (cctx X) (cty X A)))
      (ap TmT2 TmT3 Gtt
          (F.ctx (C1.ext X A), (F.ty (C1.ext X A) (C1.subT (C1.ext X A) X A (C1.p X A)),
                                F.tm (C1.ext X A) (C1.subT (C1.ext X A) X A (C1.p X A)) (C1.q X A)))
          (C2.ext (F.ctx X) (F.ty X A),
           (C2.subT (C2.ext (F.ctx X) (F.ty X A)) (F.ctx X) (F.ty X A) (C2.p (F.ctx X) (F.ty X A)),
            C2.q (F.ctx X) (F.ty X A)))
          (F.tm-q X A))
      (G.tm-q (F.ctx X) (F.ty X A)) ;

  lamPair (X : C1.Ctx) (A : C1.Ty X) (u : Term3 (ZC X A)) : Term3 (cctx X) =
    (P3.Pi (cctx X) (cty X A) u.1, (P3.Pi-iso (cctx X) (cty X A) u.1).inv u.2) ;

  c-tm-lam (X : C1.Ctx) (A : C1.Ty X) (B : C1.Ty (C1.ext X A)) (b : C1.El (C1.ext X A) B)
    : Id (Term3 (cctx X)) (cty X (P1.Pi X A B), ctm X (P1.Pi X A B) ((P1.Pi-iso X A B).inv b))
         (lamPair X A (cmvTm X A B b)) =
    trans (Term3 (cctx X))
      (Gt (F.ctx X) (F.ty X (P1.Pi X A B), F.tm X (P1.Pi X A B) ((P1.Pi-iso X A B).inv b)))
      (Gt (F.ctx X) (P2.Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B),
                     (P2.Pi-iso (F.ctx X) (F.ty X A) (F.mv-ty X A B)).inv (F.mv-el X A B b)))
      (lamPair X A (cmvTm X A B b))
      (ap (Term2 (F.ctx X)) (Term3 (cctx X)) (Gt (F.ctx X))
          (F.ty X (P1.Pi X A B), F.tm X (P1.Pi X A B) ((P1.Pi-iso X A B).inv b))
          (P2.Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B),
           (P2.Pi-iso (F.ctx X) (F.ty X A) (F.mv-ty X A B)).inv (F.mv-el X A B b))
          (F.tm-lam X A B b))
      (trans (Term3 (cctx X))
         (Gt (F.ctx X) (P2.Pi (F.ctx X) (F.ty X A) (F.mv-ty X A B),
                        (P2.Pi-iso (F.ctx X) (F.ty X A) (F.mv-ty X A B)).inv (F.mv-el X A B b)))
         (lamPair X A (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B),
                       G.mv-el (F.ctx X) (F.ty X A) (F.mv-ty X A B) (F.mv-el X A B b)))
         (lamPair X A (cmvTm X A B b))
         (G.tm-lam (F.ctx X) (F.ty X A) (F.mv-ty X A B) (F.mv-el X A B b))
         (ap (Term3 (ZC X A)) (Term3 (cctx X)) (lamPair X A)
             (G.mv-ty (F.ctx X) (F.ty X A) (F.mv-ty X A B),
              G.mv-el (F.ctx X) (F.ty X A) (F.mv-ty X A B) (F.mv-el X A B b))
             (cmvTm X A B b) (mvTm-comp X A B b))) ;

  picPair (n : LevelAt N) (X : C1.Ctx) (u : CodePair n (cctx X)) : CodeF3 n (cctx X) =
    M3.pic n (cctx X) u.1 u.2 ;

  c-tm-pic (n : LevelAt N) (X : C1.Ctx) (a : C1.El X (M1.univ n X))
      (b : C1.El (Xd n X a) (M1.univ n (Xd n X a)))
    : Id (CodeF3 n (cctx X)) (ccode n X (M1.pic n X a b)) (M3.pic n (cctx X) (ccode n X a) (cmvCode n X a b)) =
    trans (CodeF3 n (cctx X)) (ccode n X (M1.pic n X a b))
      (G.code n (F.ctx X) (F.code n X (M1.pic n X a b)))
      (M3.pic n (cctx X) (ccode n X a) (cmvCode n X a b))
      (sym (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X (M1.pic n X a b))) (ccode n X (M1.pic n X a b))
         (code-comp n X (M1.pic n X a b)))
      (trans (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X (M1.pic n X a b)))
         (G.code n (F.ctx X) (M2.pic n (F.ctx X) (F.code n X a) (F.mv-code n X a b)))
         (M3.pic n (cctx X) (ccode n X a) (cmvCode n X a b))
         (ap (CodeF2 n (F.ctx X)) (CodeF3 n (cctx X)) (G.code n (F.ctx X))
             (F.code n X (M1.pic n X a b)) (M2.pic n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
             (F.tm-pic n X a b))
         (trans (CodeF3 n (cctx X)) (G.code n (F.ctx X) (M2.pic n (F.ctx X) (F.code n X a) (F.mv-code n X a b)))
            (picPair n X (G.code n (F.ctx X) (F.code n X a), G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b)))
            (M3.pic n (cctx X) (ccode n X a) (cmvCode n X a b))
            (G.tm-pic n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
            (ap (CodePair n (cctx X)) (CodeF3 n (cctx X)) (picPair n X)
                (G.code n (F.ctx X) (F.code n X a), G.mv-code n (F.ctx X) (F.code n X a) (F.mv-code n X a b))
                (ccode n X a, cmvCode n X a b) (pair-comp n X a b)))) ;

  c-tm-uc (m n : LevelAt N) (lt : StrictAt N m n) (X : C1.Ctx)
    : Id (CodeF3 n (cctx X)) (ccode n X (M1.uc m n lt X)) (M3.uc m n lt (cctx X)) =
    trans (CodeF3 n (cctx X)) (ccode n X (M1.uc m n lt X))
      (G.code n (F.ctx X) (F.code n X (M1.uc m n lt X))) (M3.uc m n lt (cctx X))
      (sym (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X (M1.uc m n lt X))) (ccode n X (M1.uc m n lt X))
         (code-comp n X (M1.uc m n lt X)))
      (trans (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X (M1.uc m n lt X)))
         (G.code n (F.ctx X) (M2.uc m n lt (F.ctx X))) (M3.uc m n lt (cctx X))
         (ap (CodeF2 n (F.ctx X)) (CodeF3 n (cctx X)) (G.code n (F.ctx X))
             (F.code n X (M1.uc m n lt X)) (M2.uc m n lt (F.ctx X)) (F.tm-uc m n lt X))
         (G.tm-uc m n lt (F.ctx X))) ;

  c-tm-lf (m n : LevelAt N) (lt : StrictAt N m n) (X : C1.Ctx) (a : C1.El X (M1.univ m X))
    : Id (CodeF3 n (cctx X)) (ccode n X (M1.lf m n lt X a)) (M3.lf m n lt (cctx X) (ccode m X a)) =
    trans (CodeF3 n (cctx X)) (ccode n X (M1.lf m n lt X a))
      (G.code n (F.ctx X) (F.code n X (M1.lf m n lt X a))) (M3.lf m n lt (cctx X) (ccode m X a))
      (sym (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X (M1.lf m n lt X a))) (ccode n X (M1.lf m n lt X a))
         (code-comp n X (M1.lf m n lt X a)))
      (trans (CodeF3 n (cctx X)) (G.code n (F.ctx X) (F.code n X (M1.lf m n lt X a)))
         (G.code n (F.ctx X) (M2.lf m n lt (F.ctx X) (F.code m X a))) (M3.lf m n lt (cctx X) (ccode m X a))
         (ap (CodeF2 n (F.ctx X)) (CodeF3 n (cctx X)) (G.code n (F.ctx X))
             (F.code n X (M1.lf m n lt X a)) (M2.lf m n lt (F.ctx X) (F.code m X a)) (F.tm-lf m n lt X a))
         (trans (CodeF3 n (cctx X)) (G.code n (F.ctx X) (M2.lf m n lt (F.ctx X) (F.code m X a)))
            (M3.lf m n lt (cctx X) (G.code m (F.ctx X) (F.code m X a))) (M3.lf m n lt (cctx X) (ccode m X a))
            (G.tm-lf m n lt (F.ctx X) (F.code m X a))
            (ap (CodeF3 m (cctx X)) (CodeF3 n (cctx X)) (M3.lf m n lt (cctx X))
                (G.code m (F.ctx X) (F.code m X a)) (ccode m X a) (code-comp m X a)))) ;

  ----------------------------------------------------------------------
  -- the composite

  comp : Q.InitHomLaws.Hom = new Q.InitHomLaws.Hom[
    ctx := cctx, sub := csub, ty := cty, tm := ctm,
    ctx-nil := c-ctx-nil, ctx-ext := cce,
    sub-id := c-sub-id, sub-o := c-sub-o, sub-eps := c-sub-eps, sub-p := c-sub-p,
    sub-lift := c-sub-lift, sub-sec := c-sub-sec,
    ty-subT := c-ty-subT, ty-Pi := c-ty-Pi, ty-univ := ctu, ty-decode := c-ty-decode,
    tm-subt := c-tm-subt, tm-q := c-tm-q, tm-lam := c-tm-lam,
    tm-pic := c-tm-pic, tm-uc := c-tm-uc, tm-lf := c-tm-lf] ;
} ;

-- composition on the Sigma form
compS (h : SA.InitHomSig.HomS) (k : SB.InitHomSig.HomS) : SQ.InitHomSig.HomS =
  SQ.InitHomSig.toS Comp[SA.InitHomSig.fromS h, SB.InitHomSig.fromS k].comp ;
