    (fjsub T d D) r-h2).1) (c-refl-ctx D (cpresup (fjsub D s G) r-h1).1) r-e (c-refl-sub D G s r-h1) (c-refl-sub T
    D d r-h2)) ;
  fq-lift-source D G A s h1 h2 D' e | r-h1 r-h2 r-e -> (c-eq-flift D G A s D' G A s r-e (c-refl-ctx G (cpresup
    (fjsub D s G) r-h1).2) (c-refl-ty G A r-h2) (c-refl-sub D G s r-h1)) ;
  fq-lift-target D G A s h1 h2 G' e | r-h1 r-h2 r-e -> (c-eq-flift D G A s D G' A s (c-refl-ctx D (cpresup (fjsub
    D s G) r-h1).1) r-e (c-refl-ty G A r-h2) (c-refl-sub D G s r-h1)) ;
  fq-sec-context G A a h1 h2 G' e | r-h1 r-h2 r-e -> (c-eq-fsec G A a G' A a r-e (c-refl-ty G A r-h1) (c-refl-tm G
    A a r-h2)) } ;
