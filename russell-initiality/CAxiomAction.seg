-- Axiom instances whose endpoints use the substitution and comprehension laws.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open CGAT[l] ; open CTyping[l] ; open CAxiomBase[l] ;

sb-id-ty {G A : FA} (hA : Ty G A) : TE G (ftsb G G A (fid G)) A = use-c-fe-sb-id G A (ty-wf hA) hA ;

sb-comp-ty {T D G A s d : FA} (hA : Ty G A) (hs : Sb D s G) (hd : Sb T d D) :
    TE T (ftsb T D (ftsb D G A s) d) (ftsb T G A (fcomp T D G s d)) =
  use-c-fe-sb-comp T D G A s d (sub-source-wf hd) (sub-source-wf hs) (ty-wf hA) hA hs hd ;

use-c-fm-sb-id (G A a : FA) (w : W G) (hA : Ty G A) (ha : Tm' G a A) :
    CDer (fjeqtm G (fmsb G G A a (fid G)) a A) =
  c-fm-sb-id G A a w hA ha
    (c-conv-tm G (ftsb G G A (fid G)) G A (fmsb G G A a (fid G)) (cx-refl w)
      (sb-id-ty hA) (tm-sub hA ha (id-sub w))) ha ;

use-c-fm-sb-comp (T D G A a s d : FA) (wT : W T) (wD : W D) (wG : W G)
    (hA : Ty G A) (ha : Tm' G a A) (hs : Sb D s G) (hd : Sb T d D) :
    CDer (fjeqtm T (fmsb T D (ftsb D G A s) (fmsb D G A a s) d)
      (fmsb T G A a (fcomp T D G s d)) (ftsb T G A (fcomp T D G s d))) =
  c-fm-sb-comp T D G A a s d wT wD wG hA ha hs hd
    (c-conv-tm T (ftsb T D (ftsb D G A s) d) T (ftsb T G A (fcomp T D G s d))
      (fmsb T D (ftsb D G A s) (fmsb D G A a s) d) (cx-refl wT) (sb-comp-ty hA hs hd)
      (tm-sub (ty-sub hA hs) (tm-sub hA ha hs) hd))
    (tm-sub hA ha (comp-sub hs hd)) ;

use-c-fq-lift-id (G A : FA) (w : W G) (hA : Ty G A) :
    SE (fext G (ftsb G G A (fid G))) (flift G G A (fid G)) (fid (fext G A)) (fext G A) =
  c-fq-lift-id G A w hA (lift-sub hA (id-sub w))
    (c-conv-sub (fext G A) (fext G A) (fext G (ftsb G G A (fid G))) (fext G A) (fid (fext G A))
      (ext-eq (cx-refl w) (ty-sym (sb-id-ty hA))) (cx-refl (ext-wf hA)) (id-sub (ext-wf hA))) ;

use-c-fq-lift-comp (T D G A s d : FA) (wT : W T) (wD : W D) (wG : W G)
    (hA : Ty G A) (hs : Sb D s G) (hd : Sb T d D) :
    SE (fext T (ftsb T G A (fcomp T D G s d))) (flift T G A (fcomp T D G s d))
      (fcomp (fext T (ftsb T D (ftsb D G A s) d)) (fext D (ftsb D G A s)) (fext G A)
        (flift D G A s) (flift T D (ftsb D G A s) d)) (fext G A) =
  c-fq-lift-comp T D G A s d wT wD wG hA hs hd (lift-sub hA (comp-sub hs hd))
    (c-conv-sub (fext T (ftsb T D (ftsb D G A s) d)) (fext G A) (fext T (ftsb T G A (fcomp T D G s d))) (fext G A)
      (fcomp (fext T (ftsb T D (ftsb D G A s) d)) (fext D (ftsb D G A s)) (fext G A)
        (flift D G A s) (flift T D (ftsb D G A s) d))
      (ext-eq (cx-refl wT) (sb-comp-ty hA hs hd)) (cx-refl (ext-wf hA))
      (comp-sub (lift-sub hA hs) (lift-sub (ty-sub hA hs) hd))) ;

sub-id-from {D G A s d : FA} (w : W D) (hA : Ty D A) (hs : Sb G s D) (hd : Sb D d G)
    (e : SE D (fcomp D G D s d) (fid D) D) : TE D (ftsb D G (ftsb G D A s) d) A =
  c-trans-ty D (ftsb D G (ftsb G D A s) d) (ftsb D D A (fcomp D G D s d)) A (sb-comp-ty hA hs hd)
    (c-trans-ty D (ftsb D D A (fcomp D G D s d)) (ftsb D D A (fid D)) A (sb-same-ty hA e) (sb-id-ty hA)) ;

use-c-fm-q-sec (G A a : FA) (w : W G) (hA : Ty G A) (ha : Tm' G a A) :
    CDer (fjeqtm G (fmsb G (fext G A) (ftsb (fext G A) G A (fp G A)) (fq G A) (fsec G A a)) a A) =
  c-fm-q-sec G A a w hA ha
    (c-conv-tm G (ftsb G (fext G A) (ftsb (fext G A) G A (fp G A)) (fsec G A a)) G A
      (fmsb G (fext G A) (ftsb (fext G A) G A (fp G A)) (fq G A) (fsec G A a)) (cx-refl w)
      (sub-id-from w hA (p-sub hA) (sec-sub hA ha) (use-c-fq-p-sec G A a w hA ha))
      (tm-sub (ty-sub hA (p-sub hA)) (q-tm hA) (sec-sub hA ha))) ha ;

use-c-fm-q-lift (D G A s : FA) (wD : W D) (wG : W G) (hA : Ty G A) (hs : Sb D s G) :
    CDer (fjeqtm (fext D (ftsb D G A s))
      (fmsb (fext D (ftsb D G A s)) (fext G A) (ftsb (fext G A) G A (fp G A)) (fq G A) (flift D G A s))
      (fq D (ftsb D G A s)) (ftsb (fext D (ftsb D G A s)) D (ftsb D G A s) (fp D (ftsb D G A s)))) =
  c-fm-q-lift D G A s wD wG hA hs
    (c-conv-tm E L E R
      (fmsb E (fext G A) (ftsb (fext G A) G A (fp G A)) (fq G A) (flift D G A s))
      (cx-refl (ext-wf hAs)) type-eq (tm-sub (ty-sub hA (p-sub hA)) (q-tm hA) lift)) (q-tm hAs)
 where {
  E : FA = fext D (ftsb D G A s) ;
  L : FA = ftsb E (fext G A) (ftsb (fext G A) G A (fp G A)) (flift D G A s) ;
  R : FA = ftsb E D (ftsb D G A s) (fp D (ftsb D G A s)) ;
  hAs : Ty D (ftsb D G A s) = ty-sub hA hs ;
  lift : Sb E (flift D G A s) (fext G A) = lift-sub hA hs ;
  M : FA = ftsb E G A (fcomp E (fext G A) G (fp G A) (flift D G A s)) ;
  M' : FA = ftsb E G A (fcomp E D G s (fp D (ftsb D G A s))) ;
  type-eq : TE E L R = c-trans-ty E L M R (sb-comp-ty hA (p-sub hA) lift)
    (c-trans-ty E M M' R (sb-same-ty {E} {G} {A} {fcomp E (fext G A) G (fp G A) (flift D G A s)}
      {fcomp E D G s (fp D (ftsb D G A s))} hA (use-c-fq-p-lift D G A s wD wG hA hs))
      (ty-sym (sb-comp-ty hA hs (p-sub hAs)))) ;
 } ;

sub-universe (n : Nat) {D G a s : FA} (nb : LeN n N) (ha : Tm' G a (fuu n G)) (hs : Sb D s G) :
    Tm' D (fmsb D G (fuu n G) a s) (fuu n D) =
  c-conv-tm D (ftsb D G (fuu n G) s) D (fuu n D) (fmsb D G (fuu n G) a s) (cx-refl (sub-source-wf hs))
    (use-c-fe-uu-sb n D G s (sub-source-wf hs) (sub-target-wf hs) hs nb) (tm-sub (tm-ty ha) ha hs) ;
