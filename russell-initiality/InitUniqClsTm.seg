-- InitUniqClsTm.seg (PLAN-INIT, Part U): the class lemmas cl-<op> of
-- InitUniqCls for the term formers: q, subt, lam (Pi-iso.inv), app
-- (subt of Pi-iso.fun along sec, then app-sec-eq), pic, uc, lf.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module EM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsExt[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
open InitUniqTot[l] ;
open InitUniqCls[l] ;

------------------------------------------------------------------------
-- q

qT (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) : Ty (eC G A hA w) =
  subT (eC G A hA w) (cls G w) (cTy G A hA w) (p (cls G w) (cTy G A hA w)) ;

cl-q (G A : GE) (hA : Pf (gjty G A)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A)))
  (h : Pf (gjtm (gext G A) gq (gsb A gp))) (hT : Pf (gjty (gext G A) (gsb A gp))) :
  Id TotTm (eC G A hA w, (qT G A hA w, q (cls G w) (cTy G A hA w))) (tE (gext G A) (gsb A gp) gq h hT wE) =
  tE-from (eC G A hA w) (qT G A hA w) (q (cls G w) (cTy G A hA w)) (gext G A) (gsb A gp) gq h hT wE
    (eP G A hA w wE) pT
    (q-beta (cls G w) (cTy G A hA w) (gext G A) (gsb A gp) h hT wE (eP G A hA w wE) pT)
 where {
  pT : Id (Ty (eC G A hA w)) (clsTy (eC G A hA w) (gext G A) (gsb A gp) hT wE (eP G A hA w wE)) (qT G A hA w) =
    symH (subT-beta (eC G A hA w) (cls G w) (cTy G A hA w) (p (cls G w) (cTy G A hA w)) (rA G A hA w)
            (p-rep (cls G w) (cTy G A hA w) (rA G A hA w)) (gext G A) hT wE (eP G A hA w wE)) ;
 } ;

------------------------------------------------------------------------
-- substitution in terms

cl-sb (D G a A s : GE) (ha : Pf (gjtm G a A)) (hA : Pf (gjty G A)) (hs : Pf (gjsub D s G))
  (wD : Pf (gjwf D)) (wG : Pf (gjwf G)) (h : Pf (gjtm D (gsb a s) (gsb A s))) (hT : Pf (gjty D (gsb A s))) :
  Id TotTm (cls D wD, (sT D G A s hA hs wD wG,
              subt (cls D wD) (cls G wG) (cTy G A hA wG) (cEl G A a ha hA wG) (cSub D s G hs wD wG)))
    (tE D (gsb A s) (gsb a s) h hT wD) =
  tE-from (cls D wD) (sT D G A s hA hs wD wG)
    (subt (cls D wD) (cls G wG) (cTy G A hA wG) (cEl G A a ha hA wG) (cSub D s G hs wD wG))
    D (gsb A s) (gsb a s) h hT wD (refl (cls D wD)) pT
    (subt-beta (cls D wD) (cls G wG) (cTy G A hA wG) (cEl G A a ha hA wG) (cSub D s G hs wD wG)
       (rEc G A a ha hA wG) (rSc D s G hs wD wG) D (gsb A s) h hT wD (refl (cls D wD)) pT)
 where {
  pT : Id (Ty (cls D wD)) (clsTy (cls D wD) D (gsb A s) hT wD (refl (cls D wD))) (sT D G A s hA hs wD wG) =
    symH (subT-beta (cls D wD) (cls G wG) (cTy G A hA wG) (cSub D s G hs wD wG) (rA G A hA wG) (rSc D s G hs wD wG)
            D hT wD (refl (cls D wD))) ;
 } ;

------------------------------------------------------------------------
-- abstraction (Pi-iso.inv)

piT (G A B : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  Ty (cls G w) = Pi (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) ;
pP (G A B : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A)))
  (hP : Pf (gjty G (gpi A B))) : Id (Ty (cls G w)) (clsTy (cls G w) G (gpi A B) hP w (refl (cls G w))) (piT G A B hA hB w wE) =
  symH (Pi-beta (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (rA G A hA w) (rB G A B hA hB w wE) G hP w (refl (cls G w))) ;

cl-lam (G A B b : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hb : Pf (gjtm (gext G A) b B))
  (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) (h : Pf (gjtm G (glam A B b) (gpi A B))) (hP : Pf (gjty G (gpi A B))) :
  Id TotTm (cls G w, (piT G A B hA hB w wE, pi-inv (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (elB G A B b hA hB hb w wE)))
    (tE G (gpi A B) (glam A B b) h hP w) =
  tE-from (cls G w) (piT G A B hA hB w wE) (pi-inv (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (elB G A B b hA hB hb w wE))
    G (gpi A B) (glam A B b) h hP w (refl (cls G w)) (pP G A B hA hB w wE hP)
    (pi-inv-beta (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (elB G A B b hA hB hb w wE)
       (rA G A hA w) (rB G A B hA hB w wE) (rb G A B b hA hB hb w wE)
       G (gpi A B) h hP w (refl (cls G w)) (pP G A B hA hB w wE hP)) ;

------------------------------------------------------------------------
-- application:  apply = subt (Pi-iso.fun f) (sec a)

fC (G A B f : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hf : Pf (gjtm G f (gpi A B)))
  (hP : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) : El (cls G w) (piT G A B hA hB w wE) =
  clsEl (cls G w) (piT G A B hA hB w wE) G (gpi A B) f hf hP w (refl (cls G w)) (pP G A B hA hB w wE hP) ;
rfC (G A B f : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hf : Pf (gjtm G f (gpi A B)))
  (hP : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  RepEl (cls G w) (piT G A B hA hB w wE) (fC G A B f hA hB hf hP w wE) =
  rE (cls G w) (piT G A B hA hB w wE) G (gpi A B) f hf hP w (refl (cls G w)) (pP G A B hA hB w wE hP) ;

-- Pi-iso.fun f
funC (G A B f : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hf : Pf (gjtm G f (gpi A B)))
  (hP : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) : El (eC G A hA w) (tyB G A B hA hB w wE) =
  pi-fun (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (fC G A B f hA hB hf hP w wE) ;
hq (G A B f : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hf : Pf (gjtm G f (gpi A B))) :
  Pf (gjtm (gext G A) (app-q A B f) B) =
  pf-map3 (gjty G A) (gjty (gext G A) B) (gjtm G f (gpi A B)) (gjtm (gext G A) (app-q A B f) B)
    (\ k1 k2 k3 -> app-q-der G A B f k1 k2 k3) hA hB hf ;
rFun (G A B f : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hf : Pf (gjtm G f (gpi A B)))
  (hP : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  RepEl (eC G A hA w) (tyB G A B hA hB w wE) (funC G A B f hA hB hf hP w wE) =
  mkRepEl (eC G A hA w) (tyB G A B hA hB w wE) (funC G A B f hA hB hf hP w wE)
    (gext G A) B (app-q A B f) (hq G A B f hA hB hf) hB wE (eP G A hA w wE) (refl (tyB G A B hA hB w wE))
    (symH (pi-fun-beta (cls G w) (cTy G A hA w) (tyB G A B hA hB w wE) (fC G A B f hA hB hf hP w wE)
             (rA G A hA w) (rB G A B hA hB w wE) (rfC G A B f hA hB hf hP w wE)
             (gext G A) B (hq G A B f hA hB hf) hB wE (eP G A hA w wE) (refl (tyB G A B hA hB w wE)))) ;

-- sec a
secC (G A a : GE) (hA : Pf (gjty G A)) (ha : Pf (gjtm G a A)) (w : Pf (gjwf G)) : Sub (cls G w) (eC G A hA w) =
  sec (cls G w) (cTy G A hA w) (cEl G A a ha hA w) ;
hsec (G A a : GE) (hA : Pf (gjty G A)) (ha : Pf (gjtm G a A)) : Pf (gjsub G (gsec A a) (gext G A)) =
  pf-map2 (gjty G A) (gjtm G a A) (gjsub G (gsec A a) (gext G A)) (\ k1 k2 -> gs-sec G A a k1 k2) hA ha ;
rSec (G A a : GE) (hA : Pf (gjty G A)) (ha : Pf (gjtm G a A)) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) :
  RepSub (cls G w) (eC G A hA w) (secC G A a hA ha w) =
  mkRepSub (cls G w) (eC G A hA w) (secC G A a hA ha w) G (gsec A a) (gext G A) (hsec G A a hA ha) w wE
    (refl (cls G w)) (eP G A hA w wE)
    (symH (sec-beta (cls G w) (cTy G A hA w) (cEl G A a ha hA w) (rEc G A a ha hA w) G (gext G A) (hsec G A a hA ha) w wE
             (refl (cls G w)) (eP G A hA w wE))) ;

appT (G A B a : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (ha : Pf (gjtm G a A))
  (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A))) : Ty (cls G w) =
  subT (cls G w) (eC G A hA w) (tyB G A B hA hB w wE) (secC G A a hA ha w) ;

cl-app (G A B f a : GE) (hA : Pf (gjty G A)) (hB : Pf (gjty (gext G A) B)) (hf : Pf (gjtm G f (gpi A B)))
  (ha : Pf (gjtm G a A)) (hP : Pf (gjty G (gpi A B))) (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G A)))
  (h : Pf (gjtm G (gapp A B f a) (gsb B (gsec A a)))) (hT : Pf (gjty G (gsb B (gsec A a)))) :
  Id TotTm (cls G w, (appT G A B a hA hB ha w wE,
              subt (cls G w) (eC G A hA w) (tyB G A B hA hB w wE) (funC G A B f hA hB hf hP w wE) (secC G A a hA ha w)))
    (tE G (gsb B (gsec A a)) (gapp A B f a) h hT w) =
  transH
    (tE-from (cls G w) (appT G A B a hA hB ha w wE)
       (subt (cls G w) (eC G A hA w) (tyB G A B hA hB w wE) (funC G A B f hA hB hf hP w wE) (secC G A a hA ha w))
       G (gsb B (gsec A a)) (gsb (app-q A B f) (gsec A a)) hs2 hT w (refl (cls G w)) pT
       (subt-beta (cls G w) (eC G A hA w) (tyB G A B hA hB w wE) (funC G A B f hA hB hf hP w wE) (secC G A a hA ha w)
          (rFun G A B f hA hB hf hP w wE) (rSec G A a hA ha w wE)
          G (gsb B (gsec A a)) hs2 hT w (refl (cls G w)) pT))
    (tE-eq G (gsb B (gsec A a)) (gsb (app-q A B f) (gsec A a)) (gapp A B f a) hs2 h hT w
       (pf-map4 (gjty G A) (gjty (gext G A) B) (gjtm G f (gpi A B)) (gjtm G a A)
          (gjeqtm G (gsb (app-q A B f) (gsec A a)) (gapp A B f a) (gsb B (gsec A a)))
          (\ k1 k2 k3 k4 -> app-sec-eq G A B f a k1 k2 k3 k4) hA hB hf ha))
 where {
  pT : Id (Ty (cls G w)) (clsTy (cls G w) G (gsb B (gsec A a)) hT w (refl (cls G w))) (appT G A B a hA hB ha w wE) =
    symH (subT-beta (cls G w) (eC G A hA w) (tyB G A B hA hB w wE) (secC G A a hA ha w)
            (rB G A B hA hB w wE) (rSec G A a hA ha w wE) G hT w (refl (cls G w))) ;
  hs2 : Pf (gjtm G (gsb (app-q A B f) (gsec A a)) (gsb B (gsec A a))) =
    pf-map3 (gjty (gext G A) B) (gjtm (gext G A) (app-q A B f) B) (gjsub G (gsec A a) (gext G A))
      (gjtm G (gsb (app-q A B f) (gsec A a)) (gsb B (gsec A a)))
      (\ k1 k2 k3 -> gm-sb G (gext G A) (app-q A B f) B (gsec A a) k1 k2 k3)
      hB (hq G A B f hA hB hf) (hsec G A a hA ha) ;
 } ;

------------------------------------------------------------------------
-- universe codes

-- the decoded binder of pic
dC (n : EM.LevelAt N) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1))) (w : Pf (gjwf G)) :
  Ty (cls G w) = decode n (cls G w) (codeC n G a ha hU w) ;
dE (n : EM.LevelAt N) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1))) (w : Pf (gjwf G)) : Ctx =
  ext (cls G w) (dC n G a ha hU w) ;
dP (n : EM.LevelAt N) (G a : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1))) (w : Pf (gjwf G))
  (wE : Pf (gjwf (gext G (gel n.1 a)))) : Id Ctx (cls (gext G (gel n.1 a)) wE) (dE n G a ha hU w) =
  ext-beta' (cls G w) (dC n G a ha hU w)
    (decode-rep n (cls G w) (codeC n G a ha hU w) (rcodeg n (cls G w) G a ha hU w (refl (cls G w)))) wE ;
bC (n : EM.LevelAt N) (G a b : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1)))
  (hb : Pf (gjtm (gext G (gel n.1 a)) b (guu n.1))) (hUE : Pf (gjty (gext G (gel n.1 a)) (guu n.1)))
  (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G (gel n.1 a)))) : El (dE n G a ha hU w) (univ n (dE n G a ha hU w)) =
  codeg n (dE n G a ha hU w) (gext G (gel n.1 a)) b hb hUE wE (dP n G a ha hU w wE) ;

cl-pic (n : EM.LevelAt N) (G a b : GE) (ha : Pf (gjtm G a (guu n.1))) (hU : Pf (gjty G (guu n.1)))
  (hb : Pf (gjtm (gext G (gel n.1 a)) b (guu n.1))) (hUE : Pf (gjty (gext G (gel n.1 a)) (guu n.1)))
  (w : Pf (gjwf G)) (wE : Pf (gjwf (gext G (gel n.1 a)))) (h : Pf (gjtm G (gpic n.1 a b) (guu n.1))) :
  Id TotTm (cls G w, (univ n (cls G w), pic n (cls G w) (codeC n G a ha hU w) (bC n G a b ha hU hb hUE w wE)))
    (tE G (guu n.1) (gpic n.1 a b) h hU w) =
  tE-from (cls G w) (univ n (cls G w)) (pic n (cls G w) (codeC n G a ha hU w) (bC n G a b ha hU hb hUE w wE))
    G (guu n.1) (gpic n.1 a b) h hU w (refl (cls G w)) (pUg n (cls G w) G hU w (refl (cls G w)))
    (pic-beta n (cls G w) (codeC n G a ha hU w) (bC n G a b ha hU hb hUE w wE)
       (rcodeg n (cls G w) G a ha hU w (refl (cls G w)))
       (rcodeg n (dE n G a ha hU w) (gext G (gel n.1 a)) b hb hUE wE (dP n G a ha hU w wE))
       G (guu n.1) h hU w (refl (cls G w)) (pUg n (cls G w) G hU w (refl (cls G w)))) ;

cl-uc (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : GE) (w : Pf (gjwf G))
  (h : Pf (gjtm G (guc m.1 n.1) (guu n.1))) (hU : Pf (gjty G (guu n.1))) :
  Id TotTm (cls G w, (univ n (cls G w), uc m n lt (cls G w))) (tE G (guu n.1) (guc m.1 n.1) h hU w) =
  tE-from (cls G w) (univ n (cls G w)) (uc m n lt (cls G w)) G (guu n.1) (guc m.1 n.1) h hU w (refl (cls G w))
    (pUg n (cls G w) G hU w (refl (cls G w)))
    (uc-beta m n lt (cls G w) G (guu n.1) h hU w (refl (cls G w)) (pUg n (cls G w) G hU w (refl (cls G w)))) ;

cl-lf (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G a : GE) (ha : Pf (gjtm G a (guu m.1)))
  (hUm : Pf (gjty G (guu m.1))) (w : Pf (gjwf G))
  (h : Pf (gjtm G (glf m.1 n.1 a) (guu n.1))) (hU : Pf (gjty G (guu n.1))) :
  Id TotTm (cls G w, (univ n (cls G w), lf m n lt (cls G w) (codeC m G a ha hUm w))) (tE G (guu n.1) (glf m.1 n.1 a) h hU w) =
  tE-from (cls G w) (univ n (cls G w)) (lf m n lt (cls G w) (codeC m G a ha hUm w)) G (guu n.1) (glf m.1 n.1 a) h hU w
    (refl (cls G w)) (pUg n (cls G w) G hU w (refl (cls G w)))
    (lf-beta m n lt (cls G w) (codeC m G a ha hUm w) (rcodeg m (cls G w) G a ha hUm w (refl (cls G w)))
       G (guu n.1) h hU w (refl (cls G w)) (pUg n (cls G w) G hU w (refl (cls G w)))) ;
