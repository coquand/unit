-- Raw annotation witnesses and the constructor operations on them.
level l ;
open Base ; open GAT[l] ; open AGAT[l] ; open AForget[l] ;

record LiftExpr {
  raw : GE ; t : GA ; image : Id GE (fg t) raw
} ;

e-nil : LiftExpr[gnil] =
  new LiftExpr[gnil, t := anil,
    image := refl gnil] ;

e-ext (G : GE) (A : GE) (xG : LiftExpr[G]) (xA : LiftExpr[A]) : LiftExpr[gext G A] =
  new LiftExpr[gext G A, t := aext xG.t xA.t,
    image := TSyntax[l].cong2 GE GE GE (\ yG yA -> gext yG yA) (fg xG.t) G (fg xA.t) A xG.image xA.image] ;

e-pi (A : GE) (B : GE) (xA : LiftExpr[A]) (xB : LiftExpr[B]) : LiftExpr[gpi A B] =
  new LiftExpr[gpi A B, t := api xA.t xB.t,
    image := TSyntax[l].cong2 GE GE GE (\ yA yB -> gpi yA yB) (fg xA.t) A (fg xB.t) B xA.image xB.image] ;

e-uu (n : Nat) (G : GE) (xG : LiftExpr[G]) : LiftExpr[guu n] =
  new LiftExpr[guu n, t := auu n xG.t,
    image := refl (guu n)] ;

e-el (n : Nat) (a : GE) (xa : LiftExpr[a]) : LiftExpr[gel n a] =
  new LiftExpr[gel n a, t := ael n xa.t,
    image := Prelude[l].ap GE GE (\ ya -> gel n ya) (fg xa.t) a xa.image] ;

e-sb (t : GE) (s : GE) (xt : LiftExpr[t]) (xs : LiftExpr[s]) : LiftExpr[gsb t s] =
  new LiftExpr[gsb t s, t := asb xt.t xs.t,
    image := TSyntax[l].cong2 GE GE GE (\ yt ys -> gsb yt ys) (fg xt.t) t (fg xs.t) s xt.image xs.image] ;

e-lam (A : GE) (B : GE) (b : GE) (xA : LiftExpr[A]) (xB : LiftExpr[B]) (xb : LiftExpr[b]) : LiftExpr[glam A B b] =
  new LiftExpr[glam A B b, t := alam xA.t xB.t xb.t,
    image := TSyntax[l].cong3 GE (\ yA yB yb -> glam yA yB yb) (fg xA.t) A (fg xB.t) B (fg xb.t) b xA.image xB.image xb.image] ;

e-app (A : GE) (B : GE) (c : GE) (a : GE) (xA : LiftExpr[A]) (xB : LiftExpr[B]) (xc : LiftExpr[c]) (xa : LiftExpr[a]) : LiftExpr[gapp A B c a] =
  new LiftExpr[gapp A B c a, t := aapp xA.t xB.t xc.t xa.t,
    image := TSyntax[l].cong4 GE (\ yA yB yc ya -> gapp yA yB yc ya) (fg xA.t) A (fg xB.t) B (fg xc.t) c (fg xa.t) a xA.image xB.image xc.image xa.image] ;

e-pic (n : Nat) (a : GE) (b : GE) (xa : LiftExpr[a]) (xb : LiftExpr[b]) : LiftExpr[gpic n a b] =
  new LiftExpr[gpic n a b, t := apic n xa.t xb.t,
    image := TSyntax[l].cong2 GE GE GE (\ ya yb -> gpic n ya yb) (fg xa.t) a (fg xb.t) b xa.image xb.image] ;

e-uc (m : Nat) (n : Nat) (G : GE) (xG : LiftExpr[G]) : LiftExpr[guc m n] =
  new LiftExpr[guc m n, t := auc m n xG.t,
    image := refl (guc m n)] ;

e-lf (m : Nat) (n : Nat) (a : GE) (xa : LiftExpr[a]) : LiftExpr[glf m n a] =
  new LiftExpr[glf m n a, t := alf m n xa.t,
    image := Prelude[l].ap GE GE (\ ya -> glf m n ya) (fg xa.t) a xa.image] ;

e-q (G : GE) (A : GE) (xG : LiftExpr[G]) (xA : LiftExpr[A]) : LiftExpr[gq] =
  new LiftExpr[gq, t := aq xG.t xA.t,
    image := refl gq] ;

e-id (G : GE) (xG : LiftExpr[G]) : LiftExpr[gid] =
  new LiftExpr[gid, t := aid xG.t,
    image := refl gid] ;

e-comp (s : GE) (d : GE) (xs : LiftExpr[s]) (xd : LiftExpr[d]) : LiftExpr[gcomp s d] =
  new LiftExpr[gcomp s d, t := acomp xs.t xd.t,
    image := TSyntax[l].cong2 GE GE GE (\ ys yd -> gcomp ys yd) (fg xs.t) s (fg xd.t) d xs.image xd.image] ;

e-eps (G : GE) (xG : LiftExpr[G]) : LiftExpr[geps] =
  new LiftExpr[geps, t := aeps xG.t,
    image := refl geps] ;

e-p (G : GE) (A : GE) (xG : LiftExpr[G]) (xA : LiftExpr[A]) : LiftExpr[gp] =
  new LiftExpr[gp, t := ap xG.t xA.t,
    image := refl gp] ;

e-lift (A : GE) (s : GE) (xA : LiftExpr[A]) (xs : LiftExpr[s]) : LiftExpr[glift A s] =
  new LiftExpr[glift A s, t := alift xA.t xs.t,
    image := TSyntax[l].cong2 GE GE GE (\ yA ys -> glift yA ys) (fg xA.t) A (fg xs.t) s xA.image xs.image] ;

e-sec (A : GE) (a : GE) (xA : LiftExpr[A]) (xa : LiftExpr[a]) : LiftExpr[gsec A a] =
  new LiftExpr[gsec A a, t := asec xA.t xa.t,
    image := TSyntax[l].cong2 GE GE GE (\ yA ya -> gsec yA ya) (fg xA.t) A (fg xa.t) a xA.image xa.image] ;
