-- TTyping.seg: the judgements of T_Tarski (sterbac4, Appendix A.2).
--   Cx        raw contexts, cnil | csnoc G A
--   Jf        the judgement forms: wf, type, term, type equality, term equality
--   Der J     ONE family indexed by the judgement form.
-- Deviations from the paper, all admissible presuppositions:
--   binder congruences carry the left premise  G |- A  (eqty-pi, eqtm-lam,
--   eqtm-app) or  G |- a : U_n  (eqtm-pic);
--   eqtm-beta carries G |- A, G.A |- B ;  eqtm-eta carries G |- A, G.A |- B ;
--   eqtm-app carries  G.A |- B, G |- a : A ;  eqtm-sym carries G |- A.
-- Levels: m < n is LeN (suc m) n.  Lifts t^n_m are strict (m < n), as the
-- cumulativity of T_Russell (A.3): with t^n_n, erasure is not injective up
-- to conversion (t^0_0 a and a), decided 2026-11-22.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ;

data Cx = cnil | csnoc (G : Cx) (A : Tm) ;

data Jf =
    jwf (G : Cx)
  | jty (G : Cx) (A : Tm)
  | jtm (G : Cx) (a A : Tm)
  | jeqty (G : Cx) (A B : Tm)
  | jeqtm (G : Cx) (a b A : Tm) ;

data Der : (J : Jf) -> U l =
  -- contexts
    wf-nil : Der (jwf cnil)
  | wf-snoc (G : Cx) (A : Tm) (h : Der (jty G A)) : Der (jwf (csnoc G A))
  -- variables
  | tm-v0 (G : Cx) (A : Tm) (h : Der (jty G A)) : Der (jtm (csnoc G A) (var zero) (wk A))
  | tm-vs (G : Cx) (B : Tm) (n : Nat) (A : Tm) (h1 : Der (jtm G (var n) A)) (h2 : Der (jty G B)) :
      Der (jtm (csnoc G B) (var (suc n)) (wk A))
  -- types
  | ty-pi (G : Cx) (A B : Tm) (h1 : Der (jty G A)) (h2 : Der (jty (csnoc G A) B)) : Der (jty G (pi A B))
  | ty-uu (G : Cx) (n : Nat) (h : Der (jwf G)) (nb : LeN n N) : Der (jty G (uu n))
  | ty-el (G : Cx) (n : Nat) (a : Tm) (h : Der (jtm G a (uu n))) : Der (jty G (el n a))
  -- terms
  | tm-lam (G : Cx) (A B b : Tm) (h1 : Der (jty G A)) (h2 : Der (jty (csnoc G A) B))
      (h3 : Der (jtm (csnoc G A) b B)) : Der (jtm G (lam A B b) (pi A B))
  | tm-app (G : Cx) (A B c a : Tm) (h1 : Der (jty G A)) (h2 : Der (jty (csnoc G A) B))
      (h3 : Der (jtm G c (pi A B))) (h4 : Der (jtm G a A)) : Der (jtm G (app A B c a) (subst1 B a))
  | tm-pic (G : Cx) (n : Nat) (a b : Tm) (h1 : Der (jtm G a (uu n))) (h2 : Der (jtm (csnoc G (el n a)) b (uu n))) :
      Der (jtm G (pic n a b) (uu n))
  | tm-uc (G : Cx) (m n : Nat) (h : Der (jwf G)) (lt : LeN (suc m) n) (nb : LeN n N) : Der (jtm G (uc m n) (uu n))
  | tm-lf (G : Cx) (m n : Nat) (a : Tm) (h : Der (jtm G a (uu m))) (le : LeN (suc m) n) (nb : LeN n N) : Der (jtm G (lf m n a) (uu n))
  | tm-conv (G : Cx) (a A B : Tm) (h1 : Der (jtm G a A)) (h2 : Der (jeqty G A B)) : Der (jtm G a B)
  -- type equality
  | eqty-refl (G : Cx) (A : Tm) (h : Der (jty G A)) : Der (jeqty G A A)
  | eqty-sym (G : Cx) (A B : Tm) (h : Der (jeqty G A B)) : Der (jeqty G B A)
  | eqty-trans (G : Cx) (A B C : Tm) (h1 : Der (jeqty G A B)) (h2 : Der (jeqty G B C)) : Der (jeqty G A C)
  | eqty-pi (G : Cx) (A A' B B' : Tm) (h0 : Der (jty G A)) (h1 : Der (jeqty G A A')) (h2 : Der (jeqty (csnoc G A) B B')) :
      Der (jeqty G (pi A B) (pi A' B'))
  | eqty-el (G : Cx) (n : Nat) (a a' : Tm) (h : Der (jeqtm G a a' (uu n))) : Der (jeqty G (el n a) (el n a'))
  | eqty-el-lf (G : Cx) (m n : Nat) (a : Tm) (h : Der (jtm G a (uu m))) (le : LeN (suc m) n) (nb : LeN n N) :
      Der (jeqty G (el n (lf m n a)) (el m a))
  | eqty-el-pic (G : Cx) (n : Nat) (a b : Tm) (h1 : Der (jtm G a (uu n))) (h2 : Der (jtm (csnoc G (el n a)) b (uu n))) :
      Der (jeqty G (el n (pic n a b)) (pi (el n a) (el n b)))
  | eqty-el-uc (G : Cx) (m n : Nat) (h : Der (jwf G)) (lt : LeN (suc m) n) (nb : LeN n N) : Der (jeqty G (el n (uc m n)) (uu m))
  -- term equality
  | eqtm-refl (G : Cx) (a A : Tm) (h : Der (jtm G a A)) : Der (jeqtm G a a A)
  | eqtm-sym (G : Cx) (a b A : Tm) (hA : Der (jty G A)) (h : Der (jeqtm G a b A)) : Der (jeqtm G b a A)
  | eqtm-trans (G : Cx) (a b c A : Tm) (h1 : Der (jeqtm G a b A)) (h2 : Der (jeqtm G b c A)) : Der (jeqtm G a c A)
  | eqtm-conv (G : Cx) (a b A B : Tm) (h1 : Der (jeqtm G a b A)) (h2 : Der (jeqty G A B)) : Der (jeqtm G a b B)
  | eqtm-lam (G : Cx) (A A' B B' b b' : Tm) (h0 : Der (jty G A)) (h1 : Der (jeqty G A A')) (h2 : Der (jeqty (csnoc G A) B B'))
      (h3 : Der (jeqtm (csnoc G A) b b' B)) : Der (jeqtm G (lam A B b) (lam A' B' b') (pi A B))
  | eqtm-app (G : Cx) (A A' B B' c c' a a' : Tm) (h0 : Der (jty G A)) (hB : Der (jty (csnoc G A) B)) (ha : Der (jtm G a A))
      (h1 : Der (jeqty G A A')) (h2 : Der (jeqty (csnoc G A) B B'))
      (h3 : Der (jeqtm G c c' (pi A B))) (h4 : Der (jeqtm G a a' A)) :
      Der (jeqtm G (app A B c a) (app A' B' c' a') (subst1 B a))
  | eqtm-pic (G : Cx) (n : Nat) (a a' b b' : Tm) (h0 : Der (jtm G a (uu n))) (h1 : Der (jeqtm G a a' (uu n)))
      (h2 : Der (jeqtm (csnoc G (el n a)) b b' (uu n))) : Der (jeqtm G (pic n a b) (pic n a' b') (uu n))
  | eqtm-lf (G : Cx) (m n : Nat) (a a' : Tm) (h : Der (jeqtm G a a' (uu m))) (le : LeN (suc m) n) (nb : LeN n N) :
      Der (jeqtm G (lf m n a) (lf m n a') (uu n))
  | eqtm-beta (G : Cx) (A B b a : Tm) (hA : Der (jty G A)) (hB : Der (jty (csnoc G A) B)) (h1 : Der (jtm (csnoc G A) b B))
      (h2 : Der (jtm G a A)) : Der (jeqtm G (app A B (lam A B b) a) (subst1 b a) (subst1 B a))
  | eqtm-eta (G : Cx) (A B f : Tm) (hA : Der (jty G A)) (hB : Der (jty (csnoc G A) B)) (h : Der (jtm G f (pi A B))) :
      Der (jeqtm G f (lam A B (app (wk A) (wkl B) (wk f) (var zero))) (pi A B))
  | eqtm-lf-pic (G : Cx) (n p : Nat) (a b : Tm) (h1 : Der (jtm G a (uu n))) (h2 : Der (jtm (csnoc G (el n a)) b (uu n)))
      (le : LeN (suc n) p) (nb : LeN p N) : Der (jeqtm G (lf n p (pic n a b)) (pic p (lf n p a) (lf n p b)) (uu p))
  | eqtm-lf-uc (G : Cx) (m n p : Nat) (h : Der (jwf G)) (lt : LeN (suc m) n) (le : LeN (suc n) p) (nb : LeN p N) :
      Der (jeqtm G (lf n p (uc m n)) (uc m p) (uu p))
  | eqtm-lf-lf (G : Cx) (m n p : Nat) (a : Tm) (h : Der (jtm G a (uu m))) (le1 : LeN (suc m) n) (le2 : LeN (suc n) p) (nb : LeN p N) :
      Der (jeqtm G (lf n p (lf m n a)) (lf m p a) (uu p)) ;

------------------------------------------------------------------------
-- m < n gives m <= n
lt-le : (m n : Nat) -> LeN (suc m) n -> LeN m n = split {
  zero -> \ n h -> tt ;
  suc m | r -> split { zero -> \ h -> efq h ; suc n -> \ h -> r n h } } ;

-- a derivation moved along equations of raw terms

der-tm-ty (G : Cx) (a A A' : Tm) (e : Id Tm A A') (d : Der (jtm G a A)) : Der (jtm G a A') =
  subst Tm (\ T -> Der (jtm G a T)) A A' e d ;
der-tm-tm (G : Cx) (a a' A : Tm) (e : Id Tm a a') (d : Der (jtm G a A)) : Der (jtm G a' A) =
  subst Tm (\ T -> Der (jtm G T A)) a a' e d ;
der-ty (G : Cx) (A A' : Tm) (e : Id Tm A A') (d : Der (jty G A)) : Der (jty G A') =
  subst Tm (\ T -> Der (jty G T)) A A' e d ;
der-eqty-l (G : Cx) (A A' B : Tm) (e : Id Tm A A') (d : Der (jeqty G A B)) : Der (jeqty G A' B) =
  subst Tm (\ T -> Der (jeqty G T B)) A A' e d ;
der-eqty-r (G : Cx) (A B B' : Tm) (e : Id Tm B B') (d : Der (jeqty G A B)) : Der (jeqty G A B') =
  subst Tm (\ T -> Der (jeqty G A T)) B B' e d ;
der-eqtm-l (G : Cx) (a a' b A : Tm) (e : Id Tm a a') (d : Der (jeqtm G a b A)) : Der (jeqtm G a' b A) =
  subst Tm (\ T -> Der (jeqtm G T b A)) a a' e d ;
der-eqtm-r (G : Cx) (a b b' A : Tm) (e : Id Tm b b') (d : Der (jeqtm G a b A)) : Der (jeqtm G a b' A) =
  subst Tm (\ T -> Der (jeqtm G a T A)) b b' e d ;
der-eqtm-ty (G : Cx) (a b A A' : Tm) (e : Id Tm A A') (d : Der (jeqtm G a b A)) : Der (jeqtm G a b A') =
  subst Tm (\ T -> Der (jeqtm G a b T)) A A' e d ;

-- context equality, a recursive predicate (used by context conversion)
CxEq : Cx -> Cx -> U l = split {
  cnil -> split { cnil -> Top ; csnoc D B -> Empty } ;
  csnoc G A | r -> split { cnil -> Empty ; csnoc D B -> r D * Der (jeqty G A B) } } ;

-- Recover the level bound from a derivation of a bare universe.
t-universe-level : Tm -> U l = split {
  var i -> Top ;
  pi A B -> Top ;
  lam A B b -> Top ;
  app A B c a -> Top ;
  uu n -> LeN n N ;
  el n a -> Top ;
  pic n a b -> Top ;
  uc m n -> Top ;
  lf m n a -> Top } ;

t-universe-bound-at : Jf -> U l = split {
  jwf G -> Top ;
  jty G A -> t-universe-level A ;
  jtm G a A -> Top ;
  jeqty G A B -> Top ;
  jeqtm G a b A -> Top } ;

t-universe-bound-J : (J : Jf) -> Der J -> t-universe-bound-at J = split {
  wf-nil -> tt ;
  wf-snoc G A h -> tt ;
  tm-v0 G A h -> tt ;
  tm-vs G B n A h1 h2 -> tt ;
  ty-pi G A B h1 h2 -> tt ;
  ty-uu G n h nb -> nb ;
  ty-el G n a h -> tt ;
  tm-lam G A B b h1 h2 h3 -> tt ;
  tm-app G A B c a h1 h2 h3 h4 -> tt ;
  tm-pic G n a b h1 h2 -> tt ;
  tm-uc G m n h lt nb -> tt ;
  tm-lf G m n a h le nb -> tt ;
  tm-conv G a A B h1 h2 -> tt ;
  eqty-refl G A h -> tt ;
  eqty-sym G A B h -> tt ;
  eqty-trans G A B C h1 h2 -> tt ;
  eqty-pi G A A' B B' h0 h1 h2 -> tt ;
  eqty-el G n a a' h -> tt ;
  eqty-el-lf G m n a h le nb -> tt ;
  eqty-el-pic G n a b h1 h2 -> tt ;
  eqty-el-uc G m n h lt nb -> tt ;
  eqtm-refl G a A h -> tt ;
  eqtm-sym G a b A hA h -> tt ;
  eqtm-trans G a b c A h1 h2 -> tt ;
  eqtm-conv G a b A B h1 h2 -> tt ;
  eqtm-lam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  eqtm-app G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  eqtm-pic G n a a' b b' h0 h1 h2 -> tt ;
  eqtm-lf G m n a a' h le nb -> tt ;
  eqtm-beta G A B b a hA hB h1 h2 -> tt ;
  eqtm-eta G A B f hA hB h -> tt ;
  eqtm-lf-pic G n p a b h1 h2 le nb -> tt ;
  eqtm-lf-uc G m n p h lt le nb -> tt ;
  eqtm-lf-lf G m n p a h le1 le2 nb -> tt } ;

t-universe-bound (G : Cx) (n : Nat) (h : Der (jty G (uu n))) : LeN n N =
  t-universe-bound-J (jty G (uu n)) h ;
