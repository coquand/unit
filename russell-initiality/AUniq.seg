-- Coherence of annotations by structural induction on the common bare GE.
level l ;
open Base ; open Lib[l] ; open GAT[l] ; open AGAT[l] ; open AForget[l] ;
open APresup[l] ; open ACtx[l] ; open AGen[l] ; open AUniqCases[l] ; open AShape[l] ; open ACompareIntro[l] ;

CxCompare (G H : GA) : U l = W G -> W H -> CE G H ;
Compare (X Y : GA) : U l = TyCompare X Y * (TmCompare X Y * (SubCompare X Y * CxCompare X Y)) ;

CompareAt (e : GE) : U l = (X Y : GA) -> Id GE (fg X) e -> Id GE (fg Y) e -> Compare X Y ;

compare-shapes (e : GE) (k : (l r : Shape e) -> Compare (shape-term e l) (shape-term e r)) : CompareAt e =
  \ X Y x y -> on-repr X Y (shape-view e X x) (shape-view e Y y)
  where {
    on-repr (X Y : GA) (p : Repr e X) (q : Repr e Y) : Compare X Y =
      Prelude[l].subst GA (\ Z -> Compare X Z) (shape-term e q.1) Y q.2
        (Prelude[l].subst GA (\ Z -> Compare Z (shape-term e q.1)) (shape-term e p.1) X p.2 (k p.1 q.1)) ;
  } ;

cx-compare-extension (G A H B : GA) (cg : CxCompare G H) (ca : TyCompare A B) :
    CxCompare (aext G A) (aext H B) =
  \ p q -> compare (wf-ext-inv G A p) (wf-ext-inv H B q)
  where {
    compare (ha : Ty G A) (hb : Ty H B) : CE (aext G A) (aext H B) =
      ac-ext G H A B eq (ca G H eq ha hb)
      where { eq : CE G H = cg (apresup (ajty G A) ha) (apresup (ajty H B) hb) ; } ;
  } ;

compare-raw : (e : GE) -> CompareAt e = split {
  gnil -> compare-shapes gnil (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term gnil l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term gnil l) T proof1).2.2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term gnil l) C proof1).2.2.1,
        \ x y -> ac-nil)))) ;
  gext G A | rG rA -> compare-shapes (gext G A) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (gext G A) l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (gext G A) l) T proof1).2.2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (gext G A) l) C proof1).2.2.1,
        cx-compare-extension l.1 l.2.1 r.1 r.2.1 (rG l.1 r.1 l.2.2.1 r.2.2.1).2.2.2 (rA l.2.1 r.2.1 l.2.2.2 r.2.2.2).1)))) ;
  gpi A B | rA rB -> compare-shapes (gpi A B) (\ l r -> (
      pi-compare l.1 l.2.1 r.1 r.2.1 (rA l.1 r.1 l.2.2.1 r.2.2.1).1 (rB l.2.1 r.2.1 l.2.2.2 r.2.2.2).1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (gpi A B) l) T proof1).2.2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (gpi A B) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gpi A B) l)) w))))) ;
  guu n -> compare-shapes (guu n) (\ l r -> (
      uu-compare n l r,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (guu n) l) T proof1).2.2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (guu n) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (guu n) l)) w))))) ;
  gel n a | ra -> compare-shapes (gel n a) (\ l r -> (
      el-compare n l.1 r.1 (ra l.1 r.1 l.2 r.2).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (gel n a) l) T proof1).2.2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (gel n a) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gel n a) l)) w))))) ;
  gsb t s | rt rs -> compare-shapes (gsb t s) (\ l r -> (
      ty-action-compare l.1 r.1 l.2.1 r.2.1 (rt l.1 r.1 l.2.2.1 r.2.2.1).1 (rs l.2.1 r.2.1 l.2.2.2 r.2.2.2).2.2.1,
      (tm-action-compare l.1 r.1 l.2.1 r.2.1 (rt l.1 r.1 l.2.2.1 r.2.2.1).2.1 (rs l.2.1 r.2.1 l.2.2.2 r.2.2.2).2.2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (gsb t s) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gsb t s) l)) w))))) ;
  glam A B b | rA rB rb -> compare-shapes (glam A B b) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (glam A B b) l) proof1).2.1,
      (lam-compare l.1 l.2.1 l.2.2.1 r.1 r.2.1 r.2.2.1 (rA l.1 r.1 l.2.2.2.1 r.2.2.2.1).1 (rB l.2.1 r.2.1 l.2.2.2.2.1 r.2.2.2.2.1).1 (rb l.2.2.1 r.2.2.1 l.2.2.2.2.2 r.2.2.2.2.2).2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (glam A B b) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (glam A B b) l)) w))))) ;
  gapp A B c a | rA rB rc ra -> compare-shapes (gapp A B c a) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (gapp A B c a) l) proof1).2.1,
      (app-compare l.1 l.2.1 l.2.2.1 l.2.2.2.1 r.1 r.2.1 r.2.2.1 r.2.2.2.1 (rA l.1 r.1 l.2.2.2.2.1 r.2.2.2.2.1).1 (rB l.2.1 r.2.1 l.2.2.2.2.2.1 r.2.2.2.2.2.1).1 (rc l.2.2.1 r.2.2.1 l.2.2.2.2.2.2.1 r.2.2.2.2.2.2.1).2.1 (ra l.2.2.2.1 r.2.2.2.1 l.2.2.2.2.2.2.2 r.2.2.2.2.2.2.2).2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (gapp A B c a) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gapp A B c a) l)) w))))) ;
  gpic n a b | ra rb -> compare-shapes (gpic n a b) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (gpic n a b) l) proof1).2.1,
      (pic-compare n l.1 l.2.1 r.1 r.2.1 (ra l.1 r.1 l.2.2.1 r.2.2.1).2.1 (rb l.2.1 r.2.1 l.2.2.2 r.2.2.2).2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (gpic n a b) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gpic n a b) l)) w))))) ;
  guc m n -> compare-shapes (guc m n) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (guc m n) l) proof1).2.1,
      (uc-compare m n l r,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (guc m n) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (guc m n) l)) w))))) ;
  glf m n a | ra -> compare-shapes (glf m n a) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (glf m n a) l) proof1).2.1,
      (lf-compare m n l.1 r.1 (ra l.1 r.1 l.2 r.2).2.1,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term (glf m n a) l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (glf m n a) l)) w))))) ;
  gq -> compare-shapes gq (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term gq l) proof1).2.1,
      (q-compare l.1 l.2 r.1 r.2,
       (\ D E C K eq proof1 proof2 -> efq (gen-sub D (shape-term gq l) C proof1).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term gq l)) w))))) ;
  gid -> compare-shapes gid (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term gid l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term gid l) T proof1).2.2.1,
       (id-compare l r,
        \ w w' -> efq (ctx-gen (ajwf (shape-term gid l)) w))))) ;
  gcomp s d | rs rd -> compare-shapes (gcomp s d) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (gcomp s d) l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (gcomp s d) l) T proof1).2.2.1,
       (comp-compare l.1 l.2.1 r.1 r.2.1 (rs l.1 r.1 l.2.2.1 r.2.2.1).2.2.1 (rd l.2.1 r.2.1 l.2.2.2 r.2.2.2).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gcomp s d) l)) w))))) ;
  geps -> compare-shapes geps (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term geps l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term geps l) T proof1).2.2.1,
       (eps-compare l r,
        \ w w' -> efq (ctx-gen (ajwf (shape-term geps l)) w))))) ;
  gp -> compare-shapes gp (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term gp l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term gp l) T proof1).2.2.1,
       (p-compare l.1 l.2 r.1 r.2,
        \ w w' -> efq (ctx-gen (ajwf (shape-term gp l)) w))))) ;
  glift A s | rA rs -> compare-shapes (glift A s) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (glift A s) l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (glift A s) l) T proof1).2.2.1,
       (lift-compare l.1 r.1 l.2.1 r.2.1 (rA l.1 r.1 l.2.2.1 r.2.2.1).1 (rs l.2.1 r.2.1 l.2.2.2 r.2.2.2).2.2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (glift A s) l)) w))))) ;
  gsec A a | rA ra -> compare-shapes (gsec A a) (\ l r -> (
      \ D E eq proof1 proof2 -> efq (gen-ty D (shape-term (gsec A a) l) proof1).2.1,
      (\ D E T V eq proof1 proof2 -> efq (gen-tm D (shape-term (gsec A a) l) T proof1).2.2.1,
       (sec-compare l.1 l.2.1 r.1 r.2.1 (rA l.1 r.1 l.2.2.1 r.2.2.1).1 (ra l.2.1 r.2.1 l.2.2.2 r.2.2.2).2.1,
        \ w w' -> efq (ctx-gen (ajwf (shape-term (gsec A a) l)) w))))) } ;

-- The same-image interface used by annotation and downstream clients.
compare-fg (X Y : GA) (e : Id GE (fg X) (fg Y)) : Compare X Y =
  compare-raw (fg Y) X Y e (refl (fg Y)) ;

same-ty (A B : GA) (e : Id GE (fg A) (fg B)) : TyCompare A B = (compare-fg A B e).1 ;
same-tm (a b : GA) (e : Id GE (fg a) (fg b)) : TmCompare a b = (compare-fg a b e).2.1 ;
same-sub (s t : GA) (e : Id GE (fg s) (fg t)) : SubCompare s t = (compare-fg s t e).2.2.1 ;
same-cx (G H : GA) (e : Id GE (fg G) (fg H)) : CxCompare G H = (compare-fg G H e).2.2.2 ;

-- Equality judgements compare their displayed sides via presuppositions.
same-cx-eq (G H G' H' : GA) (eg : Id GE (fg G) (fg G')) (eh : Id GE (fg H) (fg H'))
    (p : CE G H) (q : CE G' H') : CE G G' * CE H H' =
  (same-cx G G' eg (wf-left G H p) (wf-left G' H' q),
   same-cx H H' eh (wf-right G H p) (wf-right G' H' q)) ;

same-ty-eq (G H A B A' B' : GA) (e : CE G H)
    (ea : Id GE (fg A) (fg A')) (eb : Id GE (fg B) (fg B')) (p : TE G A B) (q : TE H A' B') :
    TE G A A' * TE G B B' =
  (same-ty A A' ea G H e pp.2.1 qp.2.1, same-ty B B' eb G H e pp.2.2 qp.2.2)
  where {
    pp : APJ (ajeqty G A B) = apresup (ajeqty G A B) p ;
    qp : APJ (ajeqty H A' B') = apresup (ajeqty H A' B') q ;
  } ;

same-tm-eq (G H a b A a' b' B : GA) (e : CE G H)
    (ea : Id GE (fg a) (fg a')) (eb : Id GE (fg b) (fg b')) (p : ME G a b A) (q : ME H a' b' B) :
    TE G A B * (ME G a a' A * ME G b b' A) =
  (left.1, (left.2, (same-tm b b' eb G H A B e pp.2.2.2 qp.2.2.2).2))
  where {
    pp : APJ (ajeqtm G a b A) = apresup (ajeqtm G a b A) p ;
    qp : APJ (ajeqtm H a' b' B) = apresup (ajeqtm H a' b' B) q ;
    left : TE G A B * ME G a a' A = same-tm a a' ea G H A B e pp.2.2.1 qp.2.2.1 ;
  } ;

same-sub-eq (D E G H s t s' t' : GA) (e : CE D E)
    (es : Id GE (fg s) (fg s')) (et : Id GE (fg t) (fg t')) (p : SE D s t G) (q : SE E s' t' H) :
    CE G H * (SE D s s' G * SE D t t' G) =
  (left.1, (left.2, (same-sub t t' et D E G H e pp.2.2.2 qp.2.2.2).2))
  where {
    pp : APJ (ajeqsub D s t G) = apresup (ajeqsub D s t G) p ;
    qp : APJ (ajeqsub E s' t' H) = apresup (ajeqsub E s' t' H) q ;
    left : CE G H * SE D s s' G = same-sub s s' es D E G H e pp.2.2.1 qp.2.2.1 ;
  } ;
