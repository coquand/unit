-- Thm20.seg: sterbac4, Theorem 20 for Ehrhard-GAT: the erasure |-|_T from
-- Ehrhard-GAT to T_Tarski has a section, unique up to conversion.
--   sound-*      Theorem 16:  G |-G J  gives  |G| |-T |J|
--   section-*    existence:   G |-T J  gives  ceil G |-G ceil J, with
--                             |ceil G| = G and |ceil J| = J  (Lemmas 17, 18)
--   unique-*     uniqueness:  two GAT judgements over the same GAT context
--                             with the same erasure are convertible (Lemma 19)
--   unique-cx    |-G G  gives  |-G G = ceil |G|

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ;
open GAT[l] ; open GSound[l] ; open Ev[l] ; open L18[l] ; open L19[l] ;

-- Theorem 16
sound-ty (G A : GE) (h : GDer (gjty G A)) : Der (jty (ec G) (et A)) = sound (gjty G A) h ;
sound-tm (G a A : GE) (h : GDer (gjtm G a A)) : Der (jtm (ec G) (et a) (et A)) = sound (gjtm G a A) h ;
sound-eqty (G A B : GE) (h : GDer (gjeqty G A B)) : Der (jeqty (ec G) (et A) (et B)) = sound (gjeqty G A B) h ;
sound-eqtm (G a b A : GE) (h : GDer (gjeqtm G a b A)) : Der (jeqtm (ec G) (et a) (et b) (et A)) = sound (gjeqtm G a b A) h ;

-- Theorem 20, existence
section-ty (G : Cx) (A : Tm) (d : Der (jty G A)) :
    GDer (gjty (ceilC G) (ceil A)) * (Id Cx (ec (ceilC G)) G * Id Tm (et (ceil A)) A) =
  (lift-ty G A d, (er-ceilC G, er-ceil A)) ;

section-tm (G : Cx) (a A : Tm) (d : Der (jtm G a A)) :
    GDer (gjtm (ceilC G) (ceil a) (ceil A)) * (Id Cx (ec (ceilC G)) G * (Id Tm (et (ceil a)) a * Id Tm (et (ceil A)) A)) =
  (lift-tm G a A d, (er-ceilC G, (er-ceil a, er-ceil A))) ;

section-eqty (G : Cx) (A B : Tm) (d : Der (jeqty G A B)) : GDer (gjeqty (ceilC G) (ceil A) (ceil B)) = lift-eqty G A B d ;
section-eqtm (G : Cx) (a b A : Tm) (d : Der (jeqtm G a b A)) : GDer (gjeqtm (ceilC G) (ceil a) (ceil b) (ceil A)) =
  lift-eqtm G a b A d ;

-- Theorem 20, uniqueness up to conversion
unique-ty (G A1 A2 : GE) (h1 : GDer (gjty G A1)) (h2 : GDer (gjty G A2)) (e : Id Tm (et A1) (et A2)) :
    GDer (gjeqty G A1 A2) =
  ge-trans G A1 (ceil (et A2)) A2
    (subst Tm (\ X -> GDer (gjeqty G A1 (ceil X))) (et A1) (et A2) e (lemma19 (gjty G A1) h1).2)
    (ge-sym G A2 (ceil (et A2)) (lemma19 (gjty G A2) h2).2) ;

unique-tm (G a1 a2 A : GE) (hA : GDer (gjty G A)) (h1 : GDer (gjtm G a1 A)) (h2 : GDer (gjtm G a2 A))
    (e : Id Tm (et a1) (et a2)) : GDer (gjeqtm G a1 a2 A) =
  gm-trans G a1 (ceil (et a2)) a2 A
    (subst Tm (\ X -> GDer (gjeqtm G a1 (ceil X) A)) (et a1) (et a2) e (lemma19 (gjtm G a1 A) h1).2)
    (gm-sym G a2 (ceil (et a2)) A hA (lemma19 (gjtm G a2 A) h2).2) ;

unique-cx (G : GE) (h : GDer (gjwf G)) : GDer (gjeqcx G (ceilC (ec G))) = (lemma19 (gjwf G) h).2.2 ;
