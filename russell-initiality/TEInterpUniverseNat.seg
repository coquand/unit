-- Naturality of universes, decoding, and codes under substitution.
open Base ; open Prelude[l] ; open Paths[l] ; open Lib[l] ; open EhrhardTEModel[l] ;
open TEInterpBase ; open TEDenote ; open TEInterpIntro ; open TEInterpFormers ;
open TEInterpJudgement ; open TEInterpUniverses ; open B.GAT[l] ;

code-sub-down (n : Nat) (nb : LeN n N) (a s : GE) (d g : Tel) (u : Code (n,nb) g) (f : C.Sub (ctx d) (ctx g))
    (ha : TmDown a g (universe-at (n,nb) g) u) (hs : SubDown s d g f) :
    TmDown (gsb a s) d (universe-at (n,nb) d) (M.code-sub (n,nb) (ctx d) (ctx g) u f) =
  tm-cast-down (gsb a s) d (C.subT (ctx d) (ctx g) U-g f) (universe-at (n,nb) d) (M.univ-nat (n,nb) (ctx d) (ctx g) f)
    (C.subt (ctx d) (ctx g) U-g u f) (tm-sub-down a s d g U-g u f ha hs)
 where { U-g : C.Ty (ctx g) = universe-at (n,nb) g ; } ;

module ReindexedCode (n : Nat) (nb : LeN n N) (a s : GE) (d g : Tel) (u : CodeValue n nb g a) (f : SubValue d g s) {
  A : C.Ty (ctx g) = decode-at (n,nb) g u.1 ;
  B' : C.Ty (ctx d) = C.subT (ctx d) (ctx g) A f.1 ;
  ha : TyDown (gel n a) g A = decode-down n nb a g u.1 u.2 ;
  w : Code (n,nb) d = M.code-sub (n,nb) (ctx d) (ctx g) u.1 f.1 ;
  hw : TmDown (gsb a s) d (universe-at (n,nb) d) w = code-sub-down n nb a s d g u.1 f.1 u.2 f.2 ;
  T : C.Ty (ctx d) = decode-at (n,nb) d w ;
  hT : TyDown (gel n (gsb a s)) d T = decode-down n nb (gsb a s) d w hw ;
  dn : Id (C.Ty (ctx d)) B' T = M.decode-nat (n,nb) (ctx d) (ctx g) u.1 f.1 ;
  x : Tel = extend g A ;
  y : Tel = extend d T ;
  up : C.Sub (ctx y) (ctx x) = M.up-code (n,nb) (ctx d) (ctx g) u.1 f.1 ;
  up-down : SubDown (glift (gel n a) s) y x up =
    lift-down-as (gel n a) s d g A f.1 ha f.2 T dn ;
} ;

case-ge-uu-sb (D G : GE) (n : Nat) (s : GE) (nb : LeN n N) (r : SoundJ (gjsub D s G)) :
    SoundJ (gjeqty D (gsb (guu n) s) (guu n)) =
  (r.1,\ d hd -> build d (r.2.2 d g hd r.2.1.2))
 where {
  g : Tel = r.2.1.1 ;
  U-g : C.Ty (ctx g) = universe-at (n,nb) g ;
  build (d : Tel) (f : SubValue d g s) : TypeEquality d (gsb (guu n) s) (guu n) =
    same-type d (gsb (guu n) s) (guu n) (C.subT (ctx d) (ctx g) U-g f.1) (universe-at (n,nb) d)
      (ty-sub-down (guu n) s d g U-g f.1 (univ-down n nb g) f.2) (univ-down n nb d) (M.univ-nat (n,nb) (ctx d) (ctx g) f.1) ;
 } ;

module DecodeNaturality (n : Nat) (nb : LeN n N) (a s : GE) (d g : Tel) (u : CodeValue n nb g a) (f : SubValue d g s) {
  module S = ReindexedCode[n,nb,a,s,d,g,u,f] ;
  equation : TypeEquality d (gsb (gel n a) s) (gel n (gsb a s)) =
    same-type d (gsb (gel n a) s) (gel n (gsb a s)) S.B' S.T
      (ty-sub-down (gel n a) s d g S.A f.1 S.ha f.2) S.hT S.dn ;
} ;

case-ge-el-sb (D G : GE) (n : Nat) (a s : GE) (r : SoundJ (gjtm G a (guu n))) (p : SoundJ (gjsub D s G)) :
    SoundJ (gjeqty D (gsb (gel n a) s) (gel n (gsb a s))) =
  (p.1,\ d hd -> DecodeNaturality[n,nb,a,s,d,g,u,p.2.2 d g hd r.1.2].equation)
 where {
  g : Tel = r.1.1 ;
  t : TermValue g (guu n) a = r.2 g r.1.2 ;
  nb : LeN n N = level-bound n g t.1 t.2.1 ;
  u : CodeValue n nb g a = code-value n nb g a t ;
 } ;

case-gm-uc-sb (D G : GE) (m n : Nat) (s : GE) (lt : LeN (suc m) n) (nb : LeN n N) (r : SoundJ (gjsub D s G)) :
    SoundJ (gjeqtm D (gsb (guc m n) s) (guc m n) (guu n)) =
  (r.1,\ d hd -> build d (r.2.2 d g hd r.2.1.2))
 where {
  g : Tel = r.2.1.1 ;
  mb : LeN m N = lower-bound m n lt nb ;
  u : Code (n,nb) g = M.uc (m,mb) (n,nb) lt (ctx g) ;
  build (d : Tel) (f : SubValue d g s) : TermEquality d (guu n) (gsb (guc m n) s) (guc m n) =
    same-term d (guu n) (gsb (guc m n) s) (guc m n)
      (universe-at (n,nb) d,M.code-sub (n,nb) (ctx d) (ctx g) u f.1)
      (universe-at (n,nb) d,M.uc (m,mb) (n,nb) lt (ctx d)) (univ-down n nb d)
      (code-sub-down n nb (guc m n) s d g u f.1 (uc-down m n mb nb lt g) f.2)
      (uc-down m n mb nb lt d) (code-pair-path (n,nb) d (M.code-sub (n,nb) (ctx d) (ctx g) u f.1) (M.uc (m,mb) (n,nb) lt (ctx d)) (M.uc-nat (m,mb) (n,nb) lt (ctx d) (ctx g) f.1)) ;
 } ;

case-gm-lf-sb (D G : GE) (m n : Nat) (a s : GE) (lt : LeN (suc m) n) (nb : LeN n N)
    (r : SoundJ (gjtm G a (guu m))) (p : SoundJ (gjsub D s G)) :
    SoundJ (gjeqtm D (gsb (glf m n a) s) (glf m n (gsb a s)) (guu n)) =
  (p.1,\ d hd -> build d (p.2.2 d g hd r.1.2))
 where {
  g : Tel = r.1.1 ;
  mb : LeN m N = lower-bound m n lt nb ;
  u : CodeValue m mb g a = code-value m mb g a (r.2 g r.1.2) ;
  v : Code (n,nb) g = M.lf (m,mb) (n,nb) lt (ctx g) u.1 ;
  build (d : Tel) (f : SubValue d g s) : TermEquality d (guu n) (gsb (glf m n a) s) (glf m n (gsb a s)) =
    same-term d (guu n) (gsb (glf m n a) s) (glf m n (gsb a s))
      (universe-at (n,nb) d,M.code-sub (n,nb) (ctx d) (ctx g) v f.1)
      (universe-at (n,nb) d,M.lf (m,mb) (n,nb) lt (ctx d) w) (univ-down n nb d)
      (code-sub-down n nb (glf m n a) s d g v f.1 (lf-down m n mb nb lt a g u.1 u.2) f.2)
      (lf-down m n mb nb lt (gsb a s) d w (code-sub-down m mb a s d g u.1 f.1 u.2 f.2))
      (code-pair-path (n,nb) d (M.code-sub (n,nb) (ctx d) (ctx g) v f.1) (M.lf (m,mb) (n,nb) lt (ctx d) w) (M.lf-nat (m,mb) (n,nb) lt (ctx d) (ctx g) f.1 u.1))
   where { w : Code (m,mb) d = M.code-sub (m,mb) (ctx d) (ctx g) u.1 f.1 ; } ;
 } ;

module ProductCodeNaturality (n : Nat) (a b s : GE) (d g : Tel) (v : CodeProduct[n,g,a,b]) (f : SubValue d g s) {
  module S = ReindexedCode[n,v.nb,a,s,d,g,v.left,f] ;
  B' : GE = gsb b (glift (gel n a) s) ;
  b-sub : Code (n,v.nb) S.y = M.code-sub (n,v.nb) (ctx S.y) (ctx S.x) v.right.1 S.up ;
  low : Code (n,v.nb) d = M.code-sub (n,v.nb) (ctx d) (ctx g) v.prod f.1 ;
  high : Code (n,v.nb) d = M.pic (n,v.nb) (ctx d) S.w b-sub ;

  equation : TermEquality d (guu n) (gsb (gpic n a b) s) (gpic n (gsb a s) B') =
    same-term d (guu n) (gsb (gpic n a b) s) (gpic n (gsb a s) B')
      (universe-at (n,v.nb) d,low) (universe-at (n,v.nb) d,high) (univ-down n v.nb d)
      (code-sub-down n v.nb (gpic n a b) s d g v.prod f.1 v.prod-down f.2)
      (pic-down n v.nb (gsb a s) B' d S.w b-sub S.hw
        (code-sub-down n v.nb b (glift (gel n a) s) S.y S.x v.right.1 S.up v.right.2 S.up-down))
      (code-pair-path (n,v.nb) d low high (M.pic-nat (n,v.nb) (ctx d) (ctx g) f.1 v.left.1 v.right.1)) ;
} ;

case-gm-pic-sb (D G : GE) (n : Nat) (a b s : GE)
    (r : SoundJ (gjtm G a (guu n))) (p : SoundJ (gjtm (gext G (gel n a)) b (guu n))) (q : SoundJ (gjsub D s G)) :
    SoundJ (gjeqtm D (gsb (gpic n a b) s) (gpic n (gsb a s) (gsb b (glift (gel n a) s))) (guu n)) =
  (q.1,\ d hd -> ProductCodeNaturality[n,a,b,s,d,g,v,q.2.2 d g hd r.1.2].equation)
 where {
  g : Tel = r.1.1 ;
  v : CodeProduct[n,g,a,b] = code-product G n a b r p g r.1.2 ;
 } ;
