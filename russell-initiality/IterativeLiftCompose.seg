-- Composition of lifts and the lift of an iterative-set universe code.
level i j l ;
constraint i <= j, j <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module S = IterativeSets[i] ;
module W = IterativeSets[l] ;
module L1 = IterativeSetLift[i,j] ;
module L2 = IterativeSetLift[j,l] ;
module L = IterativeSetLift[i,l] ;
open IterativeSetPaths[l] ;

liftM-compose : (a : S.M) -> Id W.M (L2.liftM (L1.liftM a)) (L.liftM a) = split {
  sup A f | r -> apH (\ q -> sup A q)
    (funext A (\ a -> W.M) (\ a -> L2.liftM (L1.liftM (f a))) (\ a -> L.liftM (f a)) r) } ;

liftV-compose (a : S.V) : Id W.V (L2.liftV (L1.liftV a)) (L.liftV a) =
  code-path (L2.liftV (L1.liftV a)) (L.liftV a) (liftM-compose a.1) ;

module Universe (i+ <= j) {
  module U1 = IterativeUniverse[i,j] ;
  module U2 = IterativeUniverse[i,l] ;

  lift-universe : Id W.V (L2.liftV U1.universe-code) U2.universe-code =
    code-path (L2.liftV U1.universe-code) U2.universe-code
      (apH (\ q -> sup S.V q)
        (funext S.V (\ a -> W.M) (\ a -> L2.liftM (L1.liftM a.1)) (\ a -> L.liftM a.1)
          (\ a -> liftM-compose a.1))) ;
} ;
