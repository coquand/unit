-- InitQuot.seg (PLAN-INIT, Part F): the quotient library for the term model.
--
-- Prop, prop-path, PropFamilies and the module Quot (inc, induction,
-- relates, effective, set) are COPIED from SmallQuotient.seg (the user's
-- file; effective small quotients from replacement, funext and propUA),
-- without Descend/DescendLarge.  Added here:
--   Sq, sq, sq-prop, sq-rec, sq-map..sq-map6   mere existence (truncation)
--   Quot.rep            every class has a representative (merely)
--   Choice              unique choice: a weakly constant map W -> B into a
--                       set factors through Sq W, with a propositional beta
-- Operations of the term model are defined with Choice on the type of
-- representatives of ALL their arguments at once (InitOps*.seg), so no
-- nested descent and no dependent quotient elimination is needed.
-- Free names: fe, propUA, images, surjections (from the driver module).
level l ;
open Base ; open Prelude[l] ;
module QH = Prelude[l+] ;
module QF = Axioms[l].FunExtLemmas[fe @l] ;
module QG = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module QRep = Replacement[l,l+] ;

------------------------------------------------------------------------
-- mere existence

Sq (X : U l) : U l = Truncation[l].Trunc[X].carrier ;
sq (X : U l) (x : X) : Sq X = Truncation[l].Trunc[X].inc x ;
sq-prop (X : U l) : isProp (Sq X) = Truncation[l].Trunc[X].proposition ;
sq-rec (X P : U l) (pP : isProp P) (f : X -> P) (t : Sq X) : P =
  Truncation[l].Trunc[X].induction @l (\ u -> P) (\ u -> pP) f t ;
sq-map (X Y : U l) (f : X -> Y) (a : Sq X) : Sq Y =
  sq-rec X (Sq Y) (sq-prop Y) (\ x -> sq Y (f x)) a ;
sq-map2 (X Y Z : U l) (f : X -> Y -> Z) (a : Sq X) (b : Sq Y) : Sq Z =
  sq-rec X (Sq Z) (sq-prop Z) (\ x -> sq-map Y Z (f x) b) a ;
sq-map3 (X Y Z R : U l) (f : X -> Y -> Z -> R) (a : Sq X) (b : Sq Y) (c : Sq Z) : Sq R =
  sq-rec X (Sq R) (sq-prop R) (\ x -> sq-map2 Y Z R (f x) b c) a ;
sq-map4 (X Y Z V R : U l) (f : X -> Y -> Z -> V -> R) (a : Sq X) (b : Sq Y) (c : Sq Z) (d : Sq V) : Sq R =
  sq-rec X (Sq R) (sq-prop R) (\ x -> sq-map3 Y Z V R (f x) b c d) a ;
sq-map5 (X Y Z V S R : U l) (f : X -> Y -> Z -> V -> S -> R)
  (a : Sq X) (b : Sq Y) (c : Sq Z) (d : Sq V) (e : Sq S) : Sq R =
  sq-rec X (Sq R) (sq-prop R) (\ x -> sq-map4 Y Z V S R (f x) b c d e) a ;
sq-map6 (X Y Z V S S' R : U l) (f : X -> Y -> Z -> V -> S -> S' -> R)
  (a : Sq X) (b : Sq Y) (c : Sq Z) (d : Sq V) (e : Sq S) (g : Sq S') : Sq R =
  sq-rec X (Sq R) (sq-prop R) (\ x -> sq-map5 Y Z V S S' R (f x) b c d e g) a ;
sq-pair (X Y : U l) (a : Sq X) (b : Sq Y) : Sq (X * Y) =
  sq-map2 X Y (X * Y) (\ x y -> (x, y)) a b ;

------------------------------------------------------------------------
-- unique choice

module Choice (W B : U l) (sB : isSet B) (f : W -> B)
  (const : (w v : W) -> Id B (f w) (f v)) {
  Has (b : B) : U l = Sq ((w : W) * Id B (f w) b) ;
  Cand : U l = (b : B) * Has b ;
  value-eq (b c : B) (u : (w : W) * Id B (f w) b) (v : (w : W) * Id B (f w) c) : Id B b c =
    trans B b (f u.1) c (sym B (f u.1) b u.2) (trans B (f u.1) (f v.1) c (const u.1 v.1) v.2) ;
  cand-prop : isProp Cand = \ u v -> Sigma-eq B Has u.1 v.1 u.2 v.2
    (sq-rec ((w : W) * Id B (f w) u.1) (Id B u.1 v.1) (sB u.1 v.1)
      (\ x -> sq-rec ((w : W) * Id B (f w) v.1) (Id B u.1 v.1) (sB u.1 v.1)
        (\ y -> value-eq u.1 v.1 x y) v.2) u.2)
    (sq-prop ((w : W) * Id B (f w) v.1)) ;
  at (w : W) : Cand = (f w, sq ((v : W) * Id B (f v) (f w)) (w, refl (f w))) ;
  choose (t : Sq W) : Cand = sq-rec W Cand cand-prop at t ;
  elim (t : Sq W) : B = (choose t).1 ;
  beta (t : Sq W) (w : W) : Id B (elim t) (f w) =
    ap Cand B (\ x -> x.1) (choose t) (at w) (cand-prop (choose t) (at w)) ;
} ;

------------------------------------------------------------------------
-- quotients (copied from SmallQuotient.seg)

Prop : U l+ = (X : U l) * isProp X ;

prop-path (P Q : Prop) (u : P.1 -> Q.1) (v : Q.1 -> P.1) : Id Prop P Q =
  QH.Sigma-eq (U l) (\ X -> isProp X) P.1 Q.1 P.2 Q.2
    ((propUA @l P.1 Q.1 P.2 Q.2).sec (u, qinv P.1 Q.1 u v (\ y -> Q.2 (u (v y)) y) (\ x -> P.2 (v (u x)) x)))
    (QF.isProp-isProp Q.1) ;

module PropFamilies (A : U l) (f : A -> Prop) {
  Logical (g : A -> Prop) : U l = (a : A) -> ((f a).1 -> (g a).1) * ((g a).1 -> (f a).1) ;
  logical-prop (g : A -> Prop) : isProp (Logical g) = QF.isProp-Pi A (\ a -> ((f a).1 -> (g a).1) * ((g a).1 -> (f a).1)) (\ a ->
    isProp-Sigma ((f a).1 -> (g a).1) (\ u -> (g a).1 -> (f a).1)
      (QF.isProp-Pi (f a).1 (\ u -> (g a).1) (\ u -> (g a).2))
      (\ u -> QF.isProp-Pi (g a).1 (\ v -> (f a).1) (\ v -> (f a).2))) ;
  logical-refl : Logical f = \ a -> (\ x -> x, \ x -> x) ;
  decode (g : A -> Prop) (h : Logical g) : Id (A -> Prop) f g =
    QG.funext A (\ a -> Prop) f g (\ a -> prop-path (f a) (g a) (h a).1 (h a).2) ;
  encode (g : A -> Prop) (p : Id (A -> Prop) f g) : Logical g =
    QH.subst (A -> Prop) (\ k -> Logical k) f g p logical-refl ;
  path-prop (g : A -> Prop) : QH.isProp (Id (A -> Prop) f g) =
    QH.Hedberg[A -> Prop, f, \ k -> Logical k, logical-prop, logical-refl, decode].hedberg g ;
  small (g : A -> Prop) : QRep.Small (Id (A -> Prop) f g) =
    (Logical g,(decode g,QH.qinv (Logical g) (Id (A -> Prop) f g) (decode g) (encode g)
      (\ p -> path-prop g (decode g (encode g p)) p) (\ h -> logical-prop g (encode g (decode g h)) h))) ;
} ;

module Quot (A : U l) (rel : A -> A -> U l)
 (prop : (a b : A) -> isProp (rel a b))
 (rr : (a : A) -> rel a a)
 (rs : (a b : A) -> rel a b -> rel b a)
 (rt : (a b c : A) -> rel a b -> rel b c -> rel a c) {
  small : QRep.LocallySmall (A -> Prop) = \ f g -> PropFamilies[A,f].small g ;
  family (a : A) : A -> Prop = \ x -> (rel x a, prop x a) ;
  image : QRep.Image[A,A -> Prop,family] = images @l @(l+) A (A -> Prop) small family ;
  Q : U l = image.carrier ;
  inc : A -> Q = image.quotient ;
  induction : [j] (P : Q -> U j) -> ((q : Q) -> Prelude[j].isProp (P q)) ->
    ((a : A) -> P (inc a)) -> (q : Q) -> P q = <j> \ P p b ->
    (surjections @l @(l+) @j A (A -> Prop) small family P p).sec b ;
  Logical (q r : Q) : U l = PropFamilies[A,image.inclusion q].Logical (image.inclusion r) ;
  logical-prop (q r : Q) : isProp (Logical q r) = PropFamilies[A,image.inclusion q].logical-prop (image.inclusion r) ;
  logical-path (q r : Q) (h : Logical q r) : Id Q q r = (image.embedding q r).sec
    (PropFamilies[A,image.inclusion q].decode (image.inclusion r) h) ;
  set : isSet Q = \ q -> Hedberg[Q,q,Logical q,logical-prop q,
    \ a -> (\ u -> u,\ u -> u),logical-path q].hedberg ;
  relates (a b : A) (h : rel a b) : Id Q (inc a) (inc b) = (image.embedding (inc a) (inc b)).sec
    (QH.trans _ _ _ _ (image.triangle a)
      (QH.trans _ _ _ _
        (PropFamilies[A,family a].decode (family b) (\ x -> (\ u -> rt x a b u h,\ v -> rt x b a v (rs a b h))))
        (QH.sym _ _ _ (image.triangle b)))) ;
  effective (a b : A) (p : Id Q (inc a) (inc b)) : rel a b =
    QH.subst (A -> Prop) (\ f -> (f a).1) (family a) (family b)
      (QH.trans _ _ _ _ (QH.sym _ _ _ (image.triangle a))
        (QH.trans _ _ _ _ (QH.ap Q (A -> Prop) image.inclusion _ _ p) (image.triangle b))) (rr a) ;
  -- added: every class merely has a representative
  rep (q : Q) : Sq ((a : A) * Id Q (inc a) q) =
    induction @l (\ r -> Sq ((a : A) * Id Q (inc a) r)) (\ r -> sq-prop ((a : A) * Id Q (inc a) r))
      (\ a -> sq ((b : A) * Id Q (inc b) (inc a)) (a, refl (inc a))) q ;
} ;
