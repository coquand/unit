-- A finite hierarchy inside the top iterative-set universe. A stage
-- decodes injectively, and a link preserves decoding and codes the
-- smaller stage. The three equations between lifted terms follow
-- from these facts in the model.
level l ;
open Base ;
open Prelude[l+] ;
open EhrhardTEModel[l+] ;
module W = IterativeSets[l] ;

record VStage {
  carrier : W.V ;
  decode : W.Ix carrier -> W.V ;
  decode-inj (a b : W.Ix carrier) (e : Id W.V (decode a) (decode b)) : Id (W.Ix carrier) a b ;
  prod (a : W.Ix carrier) (B : W.Ix (decode a) -> W.Ix carrier) : W.Ix carrier ;
  decode-prod (a : W.Ix carrier) (B : W.Ix (decode a) -> W.Ix carrier) :
      Id W.V (decode (prod a B)) (W.PiV (decode a) (\ x -> decode (B x))) ;
} ;

record VLink (S T : VStage) {
  uc : W.Ix T.carrier ;
  lf : W.Ix S.carrier -> W.Ix T.carrier ;
  decode-uc : Id W.V (T.decode uc) S.carrier ;
  decode-lf (a : W.Ix S.carrier) : Id W.V (T.decode (lf a)) (S.decode a) ;
} ;

record VHierarchy (N : Nat) {
  stage : LevelAt N -> VStage ;
  link (m n : LevelAt N) (lt : StrictAt N m n) : VLink[stage m, stage n] ;
} ;

module StageAt (k : Level) (k+ <= l) {
  module S = IterativeSets[k] ;
  module L = IterativeSetLift[k,l] ;
  module P = IterativeSetPaths[k] ;
  module Uc = IterativeUniverse[k,l] ;
  module LL = IterativeLiftLaws[k,l] ;
  module LP = IterativeLiftPi[k,l] ;

  decode-inj (a b : S.V) (e : Id W.V (L.liftV a) (L.liftV b)) : Id S.V a b =
    P.code-path a b (L.liftV-inj a b (ap W.V W.M (\ v -> v.1) (L.liftV a) (L.liftV b) e)) ;

  prod (a : S.V) (B : W.Ix (L.liftV a) -> S.V) : S.V =
    S.PiV a (\ x -> B (LL.raise a x)) ;

  stage : VStage = new VStage[
    carrier := Uc.universe-code, decode := L.liftV, decode-inj := decode-inj,
    prod := prod, decode-prod := LP.lift-pi] ;
} ;

module LinkAt (i j : Level) (i+ <= j, j+ <= l) {
  module Low = StageAt[i] ;
  module High = StageAt[j] ;
  module L = IterativeSetLift[i,j] ;
  module Uc = IterativeUniverse[i,j] ;
  module C = IterativeLiftCompose[i,j,l] ;

  link : VLink[Low.stage,High.stage] = new VLink[Low.stage,High.stage,
    uc := Uc.universe-code, lf := L.liftV,
    decode-uc := C.Universe.lift-universe, decode-lf := C.liftV-compose] ;
} ;
