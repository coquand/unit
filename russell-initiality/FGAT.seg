  | fq-idr (D : FA) (G : FA) (s : FA) (h : FADer (fjsub D s G)) : FADer (fjeqsub D (fcomp D D G s (fid D)) s G)
  | fq-assoc (Q : FA) (T : FA) (D : FA) (G : FA) (s : FA) (d : FA) (e : FA) (h1 : FADer (fjsub D s G)) (h2 : FADer
      (fjsub T d D)) (h3 : FADer (fjsub Q e T)) : FADer (fjeqsub Q (fcomp Q T G (fcomp T D G s d) e) (fcomp Q D
      G s (fcomp Q T D d e)) G)
  | fq-eps (G : FA) (s : FA) (h : FADer (fjsub G s fnil)) : FADer (fjeqsub G s (feps G) fnil)
  | fq-lift-id (G : FA) (A : FA) (h : FADer (fjty G A)) : FADer (fjeqsub (fext G (ftsb G G A (fid G))) (flift G G A
      (fid G)) (fid (fext G A)) (fext G A))
  | fq-lift-comp (T : FA) (D : FA) (G : FA) (A : FA) (s : FA) (d : FA) (h0 : FADer (fjty G A)) (h1 : FADer (fjsub D
      s G)) (h2 : FADer (fjsub T d D)) : FADer (fjeqsub (fext T (ftsb T G A (fcomp T D G s d))) (flift T G A
      (fcomp T D G s d)) (fcomp (fext T (ftsb T D (ftsb D G A s) d)) (fext D (ftsb D G A s)) (fext G A) (flift D
      G A s) (flift T D (ftsb D G A s) d)) (fext G A))
  | fq-p-lift (D : FA) (G : FA) (A : FA) (s : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjsub D s G)) : FADer
      (fjeqsub (fext D (ftsb D G A s)) (fcomp (fext D (ftsb D G A s)) (fext G A) G (fp G A) (flift D G A s))
      (fcomp (fext D (ftsb D G A s)) D G s (fp D (ftsb D G A s))) G)
  | fq-p-sec (G : FA) (A : FA) (a : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjtm G a A)) : FADer (fjeqsub G (fcomp
      G (fext G A) G (fp G A) (fsec G A a)) (fid G) G)
  | fq-sec-comp (D : FA) (G : FA) (A : FA) (a : FA) (s : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjtm G a A)) (h3 :
      FADer (fjsub D s G)) : FADer (fjeqsub D (fcomp D G (fext G A) (fsec G A a) s) (fcomp D (fext D (ftsb D G A
      s)) (fext G A) (flift D G A s) (fsec D (ftsb D G A s) (fmsb D G A a s))) (fext G A))
  | fq-lift-p-sec-q (G : FA) (A : FA) (h : FADer (fjty G A)) : FADer (fjeqsub (fext G A) (fcomp (fext G A) (fext
      (fext G A) (ftsb (fext G A) G A (fp G A))) (fext G A) (flift (fext G A) G A (fp G A)) (fsec (fext G A)
      (ftsb (fext G A) G A (fp G A)) (fq G A))) (fid (fext G A)) (fext G A))
  | fe-uu-cx (G : FA) (H : FA) (n : Nat) (e : FADer (fjeqcx G H)) (nb : LeN n N) : FADer (fjeqty G (fuu n G) (fuu n
      H))
  | fm-uc-cx (G : FA) (H : FA) (m : Nat) (n : Nat) (e : FADer (fjeqcx G H)) (lt : LeN (suc m) n) (nb : LeN n N) :
      FADer (fjeqtm G (fuc m n G) (fuc m n H) (fuu n G))
  | fq-id-cx (G : FA) (H : FA) (e : FADer (fjeqcx G H)) : FADer (fjeqsub G (fid G) (fid H) G)
  | fq-eps-cx (G : FA) (H : FA) (e : FADer (fjeqcx G H)) : FADer (fjeqsub G (feps G) (feps H) fnil)
  | fq-p-cx (G : FA) (H : FA) (A : FA) (B : FA) (e : FADer (fjeqcx G H)) (p : FADer (fjeqty G A B)) : FADer (fjeqsub
      (fext G A) (fp G A) (fp H B) G)
  | fm-q-cx (G : FA) (H : FA) (A : FA) (B : FA) (e : FADer (fjeqcx G H)) (p : FADer (fjeqty G A B)) : FADer (fjeqtm
      (fext G A) (fq G A) (fq H B) (ftsb (fext G A) G A (fp G A)))
  | fe-pi-context (G : FA) (A : FA) (B : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjty (fext G A) B)) (G' : FA) (e :
      FADer (fjeqcx G G')) : FADer (fjeqty G (fpi G A B) (fpi G' A B))
  | fe-el-context (G : FA) (n : Nat) (a : FA) (h : FADer (fjtm G a (fuu n G))) (G' : FA) (e : FADer (fjeqcx G G')) :
      FADer (fjeqty G (fel n G a) (fel n G' a))
  | fe-sb-source (D : FA) (G : FA) (A : FA) (s : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjsub D s G)) (D' : FA) (e
      : FADer (fjeqcx D D')) : FADer (fjeqty D (ftsb D G A s) (ftsb D' G A s))
  | fe-sb-target (D : FA) (G : FA) (A : FA) (s : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjsub D s G)) (G' : FA) (e
      : FADer (fjeqcx G G')) : FADer (fjeqty D (ftsb D G A s) (ftsb D G' A s))
  | fm-lam-context (G : FA) (A : FA) (B : FA) (b : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjty (fext G A) B)) (h3
      : FADer (fjtm (fext G A) b B)) (G' : FA) (e : FADer (fjeqcx G G')) : FADer (fjeqtm G (flam G A B b) (flam
      G' A B b) (fpi G A B))
  | fm-app-context (G : FA) (A : FA) (B : FA) (c : FA) (a : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjty (fext G A)
      B)) (h3 : FADer (fjtm G c (fpi G A B))) (h4 : FADer (fjtm G a A)) (G' : FA) (e : FADer (fjeqcx G G')) :
      FADer (fjeqtm G (fapp G A B c a) (fapp G' A B c a) (ftsb G (fext G A) B (fsec G A a)))
  | fm-pic-context (G : FA) (n : Nat) (a : FA) (b : FA) (h1 : FADer (fjtm G a (fuu n G))) (h2 : FADer (fjtm (fext G
      (fel n G a)) b (fuu n (fext G (fel n G a))))) (G' : FA) (e : FADer (fjeqcx G G')) : FADer (fjeqtm G (fpic
      n G a b) (fpic n G' a b) (fuu n G))
  | fm-lf-context (G : FA) (m : Nat) (n : Nat) (a : FA) (h : FADer (fjtm G a (fuu m G))) (le : LeN (suc m) n) (nb :
      LeN n N) (G' : FA) (e : FADer (fjeqcx G G')) : FADer (fjeqtm G (flf m n G a) (flf m n G' a) (fuu n G))
  | fm-sb-source (D : FA) (G : FA) (a : FA) (A : FA) (s : FA) (hA : FADer (fjty G A)) (h1 : FADer (fjtm G a A)) (h2
      : FADer (fjsub D s G)) (D' : FA) (e : FADer (fjeqcx D D')) : FADer (fjeqtm D (fmsb D G A a s) (fmsb D' G A
      a s) (ftsb D G A s))
  | fm-sb-target (D : FA) (G : FA) (a : FA) (A : FA) (s : FA) (hA : FADer (fjty G A)) (h1 : FADer (fjtm G a A)) (h2
      : FADer (fjsub D s G)) (G' : FA) (e : FADer (fjeqcx G G')) : FADer (fjeqtm D (fmsb D G A a s) (fmsb D G' A
      a s) (ftsb D G A s))
  | fm-sb-type (D : FA) (G : FA) (a : FA) (A : FA) (s : FA) (hA : FADer (fjty G A)) (h1 : FADer (fjtm G a A)) (h2 :
      FADer (fjsub D s G)) (A' : FA) (e : FADer (fjeqty G A A')) : FADer (fjeqtm D (fmsb D G A a s) (fmsb D G A'
      a s) (ftsb D G A s))
  | fq-comp-source (T : FA) (D : FA) (G : FA) (s : FA) (d : FA) (h1 : FADer (fjsub D s G)) (h2 : FADer (fjsub T d
      D)) (T' : FA) (e : FADer (fjeqcx T T')) : FADer (fjeqsub T (fcomp T D G s d) (fcomp T' D G s d) G)
  | fq-comp-middle (T : FA) (D : FA) (G : FA) (s : FA) (d : FA) (h1 : FADer (fjsub D s G)) (h2 : FADer (fjsub T d
      D)) (D' : FA) (e : FADer (fjeqcx D D')) : FADer (fjeqsub T (fcomp T D G s d) (fcomp T D' G s d) G)
  | fq-comp-target (T : FA) (D : FA) (G : FA) (s : FA) (d : FA) (h1 : FADer (fjsub D s G)) (h2 : FADer (fjsub T d
      D)) (G' : FA) (e : FADer (fjeqcx G G')) : FADer (fjeqsub T (fcomp T D G s d) (fcomp T D G' s d) G)
  | fq-lift-source (D : FA) (G : FA) (A : FA) (s : FA) (h1 : FADer (fjsub D s G)) (h2 : FADer (fjty G A)) (D' : FA)
      (e : FADer (fjeqcx D D')) : FADer (fjeqsub (fext D (ftsb D G A s)) (flift D G A s) (flift D' G A s) (fext
      G A))
  | fq-lift-target (D : FA) (G : FA) (A : FA) (s : FA) (h1 : FADer (fjsub D s G)) (h2 : FADer (fjty G A)) (G' : FA)
      (e : FADer (fjeqcx G G')) : FADer (fjeqsub (fext D (ftsb D G A s)) (flift D G A s) (flift D G' A s) (fext
      G A))
  | fq-sec-context (G : FA) (A : FA) (a : FA) (h1 : FADer (fjty G A)) (h2 : FADer (fjtm G a A)) (G' : FA) (e : FADer
      (fjeqcx G G')) : FADer (fjeqsub G (fsec G A a) (fsec G' A a) (fext G A)) ;

f-universe-level : FA -> U l = split {
  fnil -> Top ;
  fext G A -> Top ;
  fpi G A B -> Top ;
  fuu n G -> LeN n N ;
  fel n G a -> Top ;
  ftsb D G A s -> Top ;
  fmsb D G A a s -> Top ;
  flam G A B b -> Top ;
  fapp G A B c a -> Top ;
  fpic n G a b -> Top ;
  fuc m n G -> Top ;
  flf m n G a -> Top ;
  fq G A -> Top ;
  fid G -> Top ;
  fcomp T D G s d -> Top ;
  feps G -> Top ;
  fp G A -> Top ;
  flift D G A s -> Top ;
  fsec G A a -> Top } ;

f-universe-bound-at : FAJ -> U l = split {
  fjwf G -> Top ;
  fjty G A -> f-universe-level A ;
  fjtm G a A -> Top ;
  fjsub D s G -> Top ;
  fjeqcx G D -> Top ;
  fjeqty G A B -> Top ;
  fjeqtm G a b A -> Top ;
  fjeqsub D s t G -> Top } ;

f-universe-bound-J : (J : FAJ) -> FADer J -> f-universe-bound-at J = split {
  f-nil -> tt ;
  f-ext G A h -> tt ;
  fc-nil -> tt ;
  fc-refl G h -> tt ;
  fc-ext G D A B h1 h2 -> tt ;
  fs-id G h -> tt ;
  fs-comp T D G s d h1 h2 -> tt ;
  fs-eps G h -> tt ;
  fs-p G A h -> tt ;
  fs-lift D G A s h1 h2 -> tt ;
  fs-sec G A a h1 h2 -> tt ;
  fs-cx D D' G G' s h0 h0' h1 h2 h -> tt ;
  ft-pi G A B h1 h2 -> tt ;
  ft-uu G n h nb -> nb ;
  ft-el G n a h -> tt ;
  ft-sb D G A s h1 h2 -> tt ;
  ft-cx G D A h0 h1 h2 | rh0 rh1 rh2 -> rh2 ;
  fm-lam G A B b h1 h2 h3 -> tt ;
  fm-app G A B c a h1 h2 h3 h4 -> tt ;
  fm-pic G n a b h1 h2 -> tt ;
  fm-uc G m n h lt nb -> tt ;
  fm-lf G m n a h le nb -> tt ;
  fm-q G A h -> tt ;
  fm-sb D G a A s hA h1 h2 -> tt ;
  fm-conv G a A B h1 h2 -> tt ;
  fm-cx G D a A h0 h1 h2 -> tt ;
  fe-refl G A h -> tt ;
  fe-sym G A B h -> tt ;
  fe-trans G A B C h1 h2 -> tt ;
  fe-pi G A A' B B' h0 h1 h2 -> tt ;
  fe-el G n a a' h -> tt ;
  fe-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  fe-el-lf G m n a h le nb -> tt ;
  fe-el-pic G n a b h1 h2 -> tt ;
  fe-el-uc G m n h lt nb -> tt ;
  fe-sb-id G A h -> tt ;
  fe-sb-comp T D G A s d h0 h1 h2 -> tt ;
  fe-pi-sb D G A B s h1 h2 h3 -> tt ;
  fe-uu-sb D G n s h nb -> tt ;
  fe-el-sb D G n a s h1 h2 -> tt ;
  fe-cx G D A B h0 h1 h2 -> tt ;
  fm-refl G a A h -> tt ;
  fm-sym G a b A hA h -> tt ;
  fm-trans G a b c A h1 h2 -> tt ;
  fm-eqconv G a b A B h1 h2 -> tt ;
  fm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  fm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  fm-epic G n a a' b b' h0 h1 h2 -> tt ;
  fm-elf G m n a a' h le nb -> tt ;
  fm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  fm-beta G A B b a hA hB h1 h2 -> tt ;
  fm-eta G A B f hA hB h -> tt ;
  fm-lf-pic G n p a b h1 h2 le nb -> tt ;
  fm-lf-uc G m n p h lt le nb -> tt ;
  fm-lf-lf G m n p a h le1 le2 nb -> tt ;
  fm-sb-id G a A h -> tt ;
  fm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  fm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  fm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  fm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  fm-uc-sb D G m n s h lt nb -> tt ;
  fm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  fm-q-lift D G A s h1 h2 -> tt ;
  fm-q-sec G A a h1 h2 -> tt ;
  fm-ecx G D a b A h0 h1 h2 -> tt ;
  fq-refl D s G h -> tt ;
  fq-sym D s t G h -> tt ;
  fq-trans D s t u G h1 h2 -> tt ;
  fq-comp T D G s s' d d' h1 h2 -> tt ;
  fq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  fq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  fq-idl D G s h -> tt ;
  fq-idr D G s h -> tt ;
  fq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  fq-eps G s h -> tt ;
  fq-lift-id G A h -> tt ;
  fq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  fq-p-lift D G A s h1 h2 -> tt ;
  fq-p-sec G A a h1 h2 -> tt ;
  fq-sec-comp D G A a s h1 h2 h3 -> tt ;
  fq-lift-p-sec-q G A h -> tt ;
  fe-uu-cx G H n e nb -> tt ;
  fm-uc-cx G H m n e lt nb -> tt ;
  fq-id-cx G H e -> tt ;
  fq-eps-cx G H e -> tt ;
  fq-p-cx G H A B e p -> tt ;
  fm-q-cx G H A B e p -> tt ;
  fe-pi-context G A B h1 h2 G' e -> tt ;
  fe-el-context G n a h G' e -> tt ;
  fe-sb-source D G A s h1 h2 D' e -> tt ;
  fe-sb-target D G A s h1 h2 G' e -> tt ;
  fm-lam-context G A B b h1 h2 h3 G' e -> tt ;
  fm-app-context G A B c a h1 h2 h3 h4 G' e -> tt ;
  fm-pic-context G n a b h1 h2 G' e -> tt ;
  fm-lf-context G m n a h le nb G' e -> tt ;
  fm-sb-source D G a A s hA h1 h2 D' e -> tt ;
  fm-sb-target D G a A s hA h1 h2 G' e -> tt ;
  fm-sb-type D G a A s hA h1 h2 A' e -> tt ;
  fq-comp-source T D G s d h1 h2 T' e -> tt ;
  fq-comp-middle T D G s d h1 h2 D' e -> tt ;
  fq-comp-target T D G s d h1 h2 G' e -> tt ;
  fq-lift-source D G A s h1 h2 D' e -> tt ;
  fq-lift-target D G A s h1 h2 G' e -> tt ;
  fq-sec-context G A a h1 h2 G' e -> tt } ;

f-universe-bound (G X : FA) (n : Nat) (h : FADer (fjty G (fuu n X))) : LeN n N =
  f-universe-bound-J (fjty G (fuu n X)) h ;
