-- TInv.seg: definitional inversion for T_Tarski from soundness in the
-- levelled filter model, at the bottom environment (sterbac4 §2.2,
-- Theorems 9 and 10 for T_Tarski; Pi-injectivity is not needed for
-- T_Tarski <=> T_Russell).
--   tfits-bot      the bottom environment fits every well-formed context
--   uu-inj         G |- U_m = U_n            gives  m = n
--   pi-uu-noconf   G |- Pi(A, B) = U_n       is not derivable
--   uc-inj         G |- U^k_m = U^k_n : U_k  gives  m = n
--   uc-pic-noconf  G |- U^k_m = Pi_k(a, b) : U_k  is not derivable

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open LTypes[l] ; open LConsistency[l] ; open LTyping[l] ;
open LFilter[l] ; open LSoundF[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ; open TSem[l] ; open TSound[l] ;

rho0 : TEnv = \ i -> prin om ;

tfits-bot : (G : Cx) -> CtxOk G -> TFits G rho0 = split {
  cnil -> \ h i -> prin-cons om cons-om ;
  csnoc G A | r -> \ h ->
    (r h.1, (tsound (jty G A) h.2 rho0 (r h.1), \ t le -> enl-om (prin om) (tsem A rho0) t le le)) } ;

-- the two filters of a semantic type equality, at the bottom environment
eqty-bot (G : Cx) (A B : Tm) (d : Der (jeqty G A B)) : FEq (tsem A rho0) (tsem B rho0) =
  tsound (jeqty G A B) d rho0 (tfits-bot G (ok-of (jeqty G A B) d)) ;

eqtm-bot (G : Cx) (a b A : Tm) (d : Der (jeqtm G a b A)) : FEq (tsem a rho0) (tsem b rho0) =
  tsound (jeqtm G a b A) d rho0 (tfits-bot G (ok-of (jeqtm G a b A) d)) ;

-- Theorem 9
uu-inj (G : Cx) (m n : Nat) (d : Der (jeqty G (uu m) (uu n))) : Id Nat m n =
  univ-inj n m ((eqty-bot G (uu m) (uu n) d).1 (univ m) (le-refl (univ m))) ;

-- Theorem 10
pi-uu-noconf (G : Cx) (A B : Tm) (n : Nat) (d : Der (jeqty G (pi A B) (uu n))) : Empty =
  pi-univ-clash (tsem A rho0) (tfam B rho0) (univ n) n (le-refl (univ n))
    ((eqty-bot G (pi A B) (uu n) d).2 (univ n) (le-refl (univ n))) ;

-- the same for codes
uc-inj (G : Cx) (k m n : Nat) (d : Der (jeqtm G (uc m k) (uc n k) (uu k))) : Id Nat m n =
  univ-inj n m ((eqtm-bot G (uc m k) (uc n k) (uu k) d).1 (univ m) (le-refl (univ m))) ;

uc-pic-noconf (G : Cx) (k m : Nat) (a b : Tm) (d : Der (jeqtm G (uc m k) (pic k a b) (uu k))) : Empty =
  pi-univ-clash (tsem a rho0) (tfam b rho0) (univ m) m (le-refl (univ m))
    ((eqtm-bot G (uc m k) (pic k a b) (uu k) d).1 (univ m) (le-refl (univ m))) ;
