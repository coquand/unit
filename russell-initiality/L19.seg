-- L19.seg: sterbac4, Lemma 19 for Ehrhard-GAT (left inverse modulo
-- conversion), by induction on GAT derivations, using Theorem 16 and
-- Lemma 18 on the erased derivations.
--   G |-G A      gives  G |-G A = ceil |A|
--   G |-G a : A  gives  G |-G a = ceil |a| : A
--   s : D -> G   gives  idv s ~ ev |s| idv   (pointwise, over D)
--   |-G G        gives  |-G G = ceil |G|

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open TSyntax[l] ; open TTyping[l] ; open TSubst[l] ; open TSubLib[l] ;
open GAT[l] ; open GSound[l] ; open Ev[l] ; open L18Base[l] ; open L18Good[l] ; open L18Var[l] ; open L18[l] ;
open L19Base[l] ;

L19J : GJ -> U l = split {
  gjwf G -> Ctx19 G ;
  gjty G A -> Ctx19 G * GDer (gjeqty G A (ceil (et A))) ;
  gjtm G a A -> Ctx19 G * GDer (gjeqtm G a (ceil (et a)) A) ;
  gjsub D s G -> Ctx19 D * (Ctx19 G * EnvEq D (ec G) (esb idv s) (evs (es s) idv)) ;
  gjeqcx G D -> Top ;
  gjeqty G A B -> Top ;
  gjeqtm G a b A -> Top ;
  gjeqsub D s t G -> Top } ;


sb19-ty (D G A s : GE) (hA : GDer (gjty G A)) (hs : GDer (gjsub D s G)) (rA : L19J (gjty G A)) (rs : L19J (gjsub D s G)) :
    GDer (gjeqty D (gsb A s) (ceil (Sub.trav (et A) (es s)))) =
  ge-trans D (gsb A s) (gsb (ceil (et A)) s) (ceil (Sub.trav (et A) (es s)))
    (ge-sb D G A (ceil (et A)) s s hA rA.2 hs hs (gq-refl D s G hs))
    (ge-trans D (gsb (ceil (et A)) s) (ev (et A) (esb idv s)) (ceil (Sub.trav (et A) (es s)))
       ((l18ty G A hA).2.2.1 G idv D s rs.2.1.1 rs.1.1 rs.2.1.2.1 hs)
       (ge-trans D (ev (et A) (esb idv s)) (ev (et A) (evs (es s) idv)) (ceil (Sub.trav (et A) (es s)))
          ((l18ty G A hA).2.2.2.1 D (esb idv s) (evs (es s) idv) rs.1.1 (env-sub G D s rs.2.1.1 rs.1.1 hs (ec G) (ciG G rs.2.1.1) idv rs.2.1.2.1, (evs-ok (ec D) (ciG D rs.1.1) D rs.1.1 idv rs.1.2.1 (ec G) (csG G rs.2.1.1) (es s) (good-of-sok (ec D) (ec G) (es s) (sound (gjsub D s G) hs).2.2), rs.2.2)))
          (ge-sym D (ceil (Sub.trav (et A) (es s))) (ev (et A) (evs (es s) idv)) ((l18ty G A hA).2.2.2.2 (ec D) (es s) (ciG D rs.1.1) (good-of-sok (ec D) (ec G) (es s) (sound (gjsub D s G) hs).2.2) D idv rs.1.1 rs.1.2.1).2))) ;


