          (gm-sym D (ceil (Sub.trav (et a) (es s))) (ev (et a) (evs (es s) idv)) (ev (et A) (evs (es s) idv)) ((l18ty G A hA).2.1 D (evs (es s) idv) rs.1.1 (evs-ok (ec D) (ciG D rs.1.1) D rs.1.1 idv rs.1.2.1 (ec G) (csG G rs.2.1.1) (es s) (good-of-sok (ec D) (ec G) (es s) (sound (gjsub D s G) hs).2.2)))
             ((l18tm G a A ha).2.2.2.2 (ec D) (es s) (ciG D rs.1.1) (good-of-sok (ec D) (ec G) (es s) (sound (gjsub D s G) hs).2.2) D idv rs.1.1 rs.1.2.1).2)
