sec19 (G A a : GE) (h1 : GDer (gjty G A)) (h2 : GDer (gjtm G a A)) (r1 : L19J (gjty G A)) (r2 : L19J (gjtm G a A)) :
    EnvEq G (csnoc (ec G) (et A)) (esb idv (gsec A a)) (evs (sub1 (et a)) idv) =
  ((enveq-psec G A a r1.1.1 h1 h2 (ec G) (ciG G r1.1.1) idv r1.1.2.1), (gm-eqconv G (gsb gq (gsec A a)) (ceil (et a)) A (ev (et A) (esb (esb idv gp) (gsec A a))) (gm-trans G (gsb gq (gsec A a)) a (ceil (et a)) A (gm-q-sec G A a h1 h2) r2.2) (ge-trans G A (ceil (et A)) (ev (et A) (esb (esb idv gp) (gsec A a))) r1.2 (ge-sym G (ev (et A) (esb (esb idv gp) (gsec A a))) (ceil (et A)) ((l18ty G A h1).2.2.2.1 G (esb (esb idv gp) (gsec A a)) idv r1.1.1 ((env-sub (gext G A) G (gsec A a) (g-ext G A h1) r1.1.1 (gs-sec G A a h1 h2) (ec G) (ciG G r1.1.1) (esb idv gp) (env-sub G (gext G A) gp r1.1.1 (g-ext G A h1) (gs-p G A h1) (ec G) (ciG G r1.1.1) idv r1.1.2.1)), (r1.1.2.1, (enveq-psec G A a r1.1.1 h1 h2 (ec G) (ciG G r1.1.1) idv r1.1.2.1)))))))) ;


lemma19 : (J : GJ) -> GDer J -> L19J J = split {
  g-nil -> (g-nil, (tt, gc-nil)) ;
  g-ext G A h | r -> ctx19-ext G A r.1 h r.2 ;
  gc-nil -> tt ;
  gc-refl G h -> tt ;
  gc-ext G D A B h1 h2 -> tt ;
  gs-id G h | r -> (r, (r, enveq-id G r.1 (ec G) (ciG G r.1) idv r.2.1)) ;
  gs-comp T D G s d h1 h2 | r1 r2 -> (r2.1, (r1.2.1, comp19 T D G s d h1 h2 r1 r2)) ;
  gs-eps G h | r -> (r, ((g-nil, (tt, gc-nil)), tt)) ;
  gs-p G A h | r -> (ctx19-ext G A r.1 h r.2, (r.1, enveq-refl (gext G A) (ec G) (esb idv gp) (ctx19-ext G A r.1 h r.2).2.1.1)) ;
  gs-lift D G A s h1 h2 | r1 r2 -> (ctx19-ext D (gsb A s) r1.1 (gt-sb D G A s h2 h1) (sb19-ty D G A s h2 h1 r2 r1), (ctx19-ext G A r2.1 h2 r2.2, lift19 D G A s h1 h2 r1 r2)) ;
  gs-sec G A a h1 h2 | r1 r2 -> (r1.1, (ctx19-ext G A r1.1 h1 r1.2, sec19 G A a h1 h2 r1 r2)) ;
  gs-cx D D' G G' s h0 h0' h1 h2 h | r0 r0' r1 r2 r ->
    (r0, (r0', enveq-cod D' h0 (ec G) (ec G') (sound (gjeqcx G G') h2) (esb idv s) (evs (es s) idv)
       (envok-dom D D' h0 h1 (ec G) (esb idv s) (env-sub G D s r.2.1.1 r.1.1 h (ec G) (ciG G r.2.1.1) idv r.2.1.2.1))
       (enveq-dom D D' h0 h1 (ec G) (esb idv s) (evs (es s) idv) r.2.2))) ;
  gt-pi G A B h1 h2 | r1 r2 -> (r1.1, ge-pi G A (ceil (et A)) B (ev (et B) (up idv)) h1 r1.2 (geqt-r (gext G A) B (ceil (et B)) (ev (et B) (up idv)) (bd19 (et B)) r2.2)) ;
  gt-uu G n h nb | r -> (r, ge-refl G (guu n) (gt-uu G n r.1 nb)) ;
  gt-el G n a h | r -> (r.1, ge-el G n a (ceil (et a)) r.2) ;
  gt-sb D G A s h1 h2 | r1 r2 -> (r2.1, sb19-ty D G A s h1 h2 r1 r2) ;
  gt-cx G D A h0 h1 h2 | r0 r1 r2 -> (r0, ge-cx G D A (ceil (et A)) r0.1 h1 r2.2) ;
  gm-lam G A B b h1 h2 h3 | r1 r2 r3 -> (r1.1, gm-elam G A (ceil (et A)) B (ev (et B) (up idv)) b (ev (et b) (up idv)) h1 r1.2 (geqt-r (gext G A) B (ceil (et B)) (ev (et B) (up idv)) (bd19 (et B)) r2.2) (geqm-r (gext G A) b (ceil (et b)) (ev (et b) (up idv)) B (bd19 (et b)) r3.2)) ;
  gm-app G A B c a h1 h2 h3 h4 | r1 r2 r3 r4 -> (r1.1, gm-eapp G A (ceil (et A)) B (ev (et B) (up idv)) c (ceil (et c)) a (ceil (et a)) h1 h2 h4 r1.2 (geqt-r (gext G A) B (ceil (et B)) (ev (et B) (up idv)) (bd19 (et B)) r2.2) r3.2 r4.2) ;
  gm-pic G n a b h1 h2 | r1 r2 -> (r1.1, gm-epic G n a (ceil (et a)) b (ev (et b) (up idv)) h1 r1.2 (geqm-r (gext G (gel n a)) b (ceil (et b)) (ev (et b) (up idv)) (guu n) (bd19 (et b)) r2.2)) ;
  gm-uc G m n h lt nb | r -> (r, gm-refl G (guc m n) (guu n) (gm-uc G m n r.1 lt nb)) ;
  gm-lf G m n a h le nb | r -> (r.1, gm-elf G m n a (ceil (et a)) r.2 le nb) ;
  gm-q G A h | r -> (ctx19-ext G A r.1 h r.2, gm-refl (gext G A) gq (gsb A gp) (gm-q G A h)) ;
  gm-sb D G a A s hA h1 h2 | rA r1 r2 -> (r2.1, sb19-tm D G a A s hA h1 h2 rA r1 r2) ;
  gm-conv G a A B h1 h2 | r1 r2 -> (r1.1, gm-eqconv G a (ceil (et a)) A B r1.2 h2) ;
  gm-cx G D a A h0 h1 h2 | r0 r1 r2 -> (r0, gm-ecx G D a (ceil (et a)) A r0.1 h1 r2.2) ;
  ge-refl G A h -> tt ;
  ge-sym G A B h -> tt ;
  ge-trans G A B C h1 h2 -> tt ;
  ge-pi G A A' B B' h0 h1 h2 -> tt ;
  ge-el G n a a' h -> tt ;
  ge-sb D G A A' s s' h0 h1 h2 h3 h4 -> tt ;
  ge-el-lf G m n a h le nb -> tt ;
  ge-el-pic G n a b h1 h2 -> tt ;
  ge-el-uc G m n h lt nb -> tt ;
  ge-sb-id G A h -> tt ;
  ge-sb-comp T D G A s d h0 h1 h2 -> tt ;
  ge-pi-sb D G A B s h1 h2 h3 -> tt ;
  ge-uu-sb D G n s h nb -> tt ;
  ge-el-sb D G n a s h1 h2 -> tt ;
  ge-cx G D A B h0 h1 h2 -> tt ;
  gm-refl G a A h -> tt ;
  gm-sym G a b A hA h -> tt ;
  gm-trans G a b c A h1 h2 -> tt ;
  gm-eqconv G a b A B h1 h2 -> tt ;
  gm-elam G A A' B B' b b' h0 h1 h2 h3 -> tt ;
  gm-eapp G A A' B B' c c' a a' h0 hB ha h1 h2 h3 h4 -> tt ;
  gm-epic G n a a' b b' h0 h1 h2 -> tt ;
  gm-elf G m n a a' h le nb -> tt ;
  gm-esb D G a a' A s s' hA h0 h1 h2 h3 h4 -> tt ;
  gm-beta G A B b a hA hB h1 h2 -> tt ;
  gm-eta G A B f hA hB h -> tt ;
  gm-lf-pic G n p a b h1 h2 le nb -> tt ;
  gm-lf-uc G m n p h lt le nb -> tt ;
  gm-lf-lf G m n p a h le1 le2 nb -> tt ;
  gm-sb-id G a A h -> tt ;
  gm-sb-comp T D G a A s d h0 h1 h2 -> tt ;
  gm-lam-sb D G A B b s h1 h2 h3 h4 -> tt ;
  gm-app-sb D G A B c a s h1 h2 h3 h4 h5 -> tt ;
  gm-pic-sb D G n a b s h1 h2 h3 -> tt ;
  gm-uc-sb D G m n s h lt nb -> tt ;
  gm-lf-sb D G m n a s h1 h2 le nb -> tt ;
  gm-q-lift D G A s h1 h2 -> tt ;
  gm-q-sec G A a h1 h2 -> tt ;
  gm-ecx G D a b A h0 h1 h2 -> tt ;
  gq-refl D s G h -> tt ;
  gq-sym D s t G h -> tt ;
  gq-trans D s t u G h1 h2 -> tt ;
  gq-comp T D G s s' d d' h1 h2 -> tt ;
  gq-lift D G A A' s s' h0 h1 h2 h3 -> tt ;
  gq-sec G A A' a a' hA ha ha' h1 h2 -> tt ;
  gq-idl D G s h -> tt ;
  gq-idr D G s h -> tt ;
  gq-assoc Q T D G s d e h1 h2 h3 -> tt ;
  gq-eps G s h -> tt ;
  gq-lift-id G A h -> tt ;
  gq-lift-comp T D G A s d h0 h1 h2 -> tt ;
  gq-p-lift D G A s h1 h2 -> tt ;
  gq-p-sec G A a h1 h2 -> tt ;
  gq-sec-comp D G A a s h1 h2 h3 -> tt ;
  gq-lift-p-sec-q G A h -> tt } ;
