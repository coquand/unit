-- The split category with families of iterative-set codes.
level l ;
open Base ;
open Prelude[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
open EhrhardCwF ;
module W = IterativeSets[l] ;

TyV (G : W.V) : U l+ = W.Ix G -> W.V ;
TmV (G : W.V) (A : TyV G) : U l = (x : W.Ix G) -> W.Ix (A x) ;

vCwF : CwF[l+] =
  new CwF[l+,
    Ctx := W.V,
    Sub := \ D G -> W.Ix D -> W.Ix G,
    isSetSub := \ D G -> isSet-Pi (W.Ix D) (\ x -> W.Ix G) (\ x -> W.isSetIx G),
    id := \ G x -> x,
    o := \ T D G s t x -> s (t x),
    o-idl := \ D G s -> refl s,
    o-idr := \ D G s -> refl s,
    o-assoc := \ Q T D G s t u -> refl (\ x -> s (t (u x))),
    nil := W.unitV,
    eps := \ G x -> tt,
    eps-uniq := \ G s -> funext (W.Ix G) (\ x -> Top) s (\ x -> tt) (\ x -> isTop (s x) tt),
    Ty := TyV,
    isSetTy := \ G -> isSet-Pi (W.Ix G) (\ x -> W.V) (\ x -> W.isSetV),
    subT := \ D G A s x -> A (s x),
    subT-id := \ G A -> refl A,
    subT-o := \ T D G A s t -> refl (\ x -> A (s (t x))),
    El := \ G A -> TmV G A,
    isSetEl := \ G A -> isSet-Pi (W.Ix G) (\ x -> W.Ix (A x)) (\ x -> W.isSetIx (A x)),
    subt := \ D G A a s x -> a (s x),
    subt-id := \ G A a -> refl a,
    subt-o := \ T D G A a s t -> refl (\ x -> a (s (t x))),
    ext := W.SigV,
    p := \ G A x -> x.1,
    q := \ G A x -> x.2,
    lift := \ D G A s x -> (s x.1, x.2),
    sec := \ G A a x -> (x, a x),
    lift-id := \ G A -> refl (\ x -> x),
    lift-o := \ T D G A s t -> refl (\ x -> (s (t x.1), x.2)),
    p-lift := \ D G A s -> refl (\ x -> s x.1),
    p-sec := \ G A a -> refl (\ x -> x),
    sec-o := \ D G A a s -> refl (\ x -> (s x, a (s x))),
    lift-p-sec-q := \ G A -> refl (\ x -> x),
    q-lift := \ D G A s -> refl (\ x -> x.2),
    q-sec := \ G A a -> refl a] ;

vPi (G : W.V) (A : TyV G) (B : TyV (W.SigV G A)) : TyV G =
  \ x -> W.PiV (A x) (\ y -> B (x,y)) ;

vPi-iso (G : W.V) (A : TyV G) (B : TyV (W.SigV G A)) :
    Iso (TmV G (vPi G A B)) (TmV (W.SigV G A) B) =
  new IsoData[TmV G (vPi G A B), TmV (W.SigV G A) B,
    fun := \ f w -> f w.1 w.2,
    inv := \ b x y -> b (x,y),
    fun-inv := \ b -> refl b,
    inv-fun := \ f -> refl f] ;

vProducts : PiStr[l+, vCwF] =
  new PiStr[l+, vCwF,
    Pi := vPi,
    Pi-nat := \ D G A B s -> refl (\ x -> W.PiV (A (s x)) (\ y -> B (s x,y))),
    Pi-iso := vPi-iso,
    Pi-iso-nat := \ D G A B b s -> refl (\ x y -> b (s x,y))] ;
