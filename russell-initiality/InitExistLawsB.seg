-- InitExistLawsB.seg (PLAN-INIT, Part E): the laws of a morphism for
-- products and universes, over the operations of InitOpsPi/InitOpsU:
--   ex-ty-Pi, ex-tm-lam (Pi-iso inv = pi-inv), ex-ty-univ, ex-ty-decode,
--   ex-tm-pic, ex-tm-uc, ex-tm-lf.
-- The transports of InitHomLaws (mv-ty, mv-el, code, dec-ext, mv-code)
-- are reproduced with the same bodies (my-*), built from the laws
-- ex-ctx-ext, ex-ty-univ, ex-ty-decode of the interpretation, so that
-- they are definitionally those of the record Hom once it is built.
-- Data over an extended context move along the path of telescopes
-- tel-ext (ty-down-mv, tm-down-mv, code-down-mv of InitExistBase).
-- Segment of InitCheckE.InitE.Exist (l, M).
open Base ; open Prelude[l] ; open Paths[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
module TM = EhrhardTEModel[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitOpsPi[l] ;
open InitOpsU[l] ;
module S = TEInterp.Interpret[l,N,M] ;
open S.TEInterpBase ;
open S.TEDenote ;
open S.TEInterpIntro ;
open S.TEInterpFormers ;
module J = S.TEInterpJudgement ;
open InitExistBase ;
open InitExistMaps ;
open InitExistLawsA ;

------------------------------------------------------------------------
-- products

my-mv-ty (c : Ctx) (A : Ty c) (T : Ty (ext c A)) : C.Ty (C.ext (hctx c) (hty c A)) =
  mvTy0 (hctx (ext c A)) (C.ext (hctx c) (hty c A)) (ex-ctx-ext c A) (hty (ext c A) T) ;

my-mv-el (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) :
  C.El (C.ext (hctx c) (hty c A)) (my-mv-ty c A T) =
  mvEl0 (hctx (ext c A)) (C.ext (hctx c) (hty c A)) (ex-ctx-ext c A) (hty (ext c A) T) (htm (ext c A) T b) ;

mv-ty-down (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (r : RepTy (ext c A) T) :
  TyDown (rtA (ext c A) T r) (extend (tel c) (hty c A)) (my-mv-ty c A T) =
  ty-down-mv (rtA (ext c A) T r) (tel (ext c A)) (extend (tel c) (hty c A)) (tel-ext c A) (ex-ctx-ext c A)
    (hty (ext c A) T) (hty-down-r (ext c A) T r) ;

ex-ty-Pi (c : Ctx) (A : Ty c) (T : Ty (ext c A)) :
  Id (C.Ty (hctx c)) (hty c (Pi c A T)) (M.products.Pi (hctx c) (hty c A) (my-mv-ty c A T)) =
  sq-rec (RepTy c A * RepTy (ext c A) T)
    (Id (C.Ty (hctx c)) (hty c (Pi c A T)) (M.products.Pi (hctx c) (hty c A) (my-mv-ty c A T)))
    (C.isSetTy (hctx c) (hty c (Pi c A T)) (M.products.Pi (hctx c) (hty c A) (my-mv-ty c A T)))
    (\ x -> ty-fn (gpi (rtA c A x.1) (rtA (ext c A) T x.2)) (tel c) (hty c (Pi c A T))
      (M.products.Pi (hctx c) (hty c A) (my-mv-ty c A T))
      (hty-down-r c (Pi c A T) (Pi-rep c A T x.1 x.2))
      (pi-down (rtA c A x.1) (rtA (ext c A) T x.2) (tel c) (hty c A) (my-mv-ty c A T)
        (hty-down-r c A x.1) (mv-ty-down c A T x.2)))
    (OpPi[c,A,T].reps) ;

module ExLam (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) {
  lhs : Term (tel c) = (hty c (Pi c A T), htm c (Pi c A T) (pi-inv c A T b)) ;
  rhs : Term (tel c) = (M.products.Pi (hctx c) (hty c A) (my-mv-ty c A T),
    (M.products.Pi-iso (hctx c) (hty c A) (my-mv-ty c A T)).inv (my-mv-el c A T b)) ;
  W : U l = RepTy c A * (RepTy (ext c A) T * RepEl (ext c A) T b) ;
  A0 (x : W) : GE = rtA c A x.1 ;
  B0 (x : W) : GE = rtA (ext c A) T x.2.1 ;
  b0 (x : W) : GE = rea (ext c A) T b x.2.2 ;
  step (x : W) : Id (Term (tel c)) lhs rhs =
    J.tm-functional (glam (A0 x) (B0 x) (b0 x)) (tel c) lhs rhs
      (htm-down c (Pi c A T) (pi-inv c A T b) (rtG c A x.1) (gpi (A0 x) (B0 x)) (glam (A0 x) (B0 x) (b0 x))
        (OpPiInv[c,A,T,b].der x) (rtH c (Pi c A T) (OpPiInv[c,A,T,b].rP x)) (rtW c A x.1) (rtP c A x.1)
        (rtE c (Pi c A T) (OpPiInv[c,A,T,b].rP x))
        (sym (El c (Pi c A T)) (pi-inv c A T b) (OpPiInv[c,A,T,b].f x) (OpPiInv[c,A,T,b].beta x)))
      (lam-down (A0 x) (B0 x) (b0 x) (tel c) (hty c A) (my-mv-ty c A T) (my-mv-el c A T b)
        (hty-down-r c A x.1) (mv-ty-down c A T x.2.1)
        (tm-down-mv (b0 x) (tel (ext c A)) (extend (tel c) (hty c A)) (tel-ext c A) (ex-ctx-ext c A)
          (hty (ext c A) T) (htm (ext c A) T b) (htm-down-r (ext c A) T b x.2.2))) ;
  result : Id (Term (tel c)) lhs rhs =
    sq-rec W (Id (Term (tel c)) lhs rhs) (term-set (tel c) lhs rhs) step (OpPiInv[c,A,T,b].reps) ;
} ;

ex-tm-lam (c : Ctx) (A : Ty c) (T : Ty (ext c A)) (b : El (ext c A) T) :
  Id (Term (tel c)) (hty c (Pi c A T), htm c (Pi c A T) (pi-inv c A T b))
    (M.products.Pi (hctx c) (hty c A) (my-mv-ty c A T),
     (M.products.Pi-iso (hctx c) (hty c A) (my-mv-ty c A T)).inv (my-mv-el c A T b)) =
  ExLam[c,A,T,b].result ;

------------------------------------------------------------------------
-- universes

ex-ty-univ (n : TM.LevelAt N) (c : Ctx) : Id (C.Ty (hctx c)) (hty c (univ n c)) (M.univ n (hctx c)) =
  sq-rec (RepCtx c) (Id (C.Ty (hctx c)) (hty c (univ n c)) (M.univ n (hctx c)))
    (C.isSetTy (hctx c) (hty c (univ n c)) (M.univ n (hctx c)))
    (\ r -> ty-fn (guu n.1) (tel c) (hty c (univ n c)) (M.univ n (hctx c))
      (hty-down-r c (univ n c) (univ-rep n c r)) (univ-down n.1 n.2 (tel c)))
    (rep-ctx c) ;

-- the image of a code (InitHomLaws.code)
my-code (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) : CodeF0 n (hctx c) =
  subst (C.Ty (hctx c)) (C.El (hctx c)) (hty c (univ n c)) (M.univ n (hctx c)) (ex-ty-univ n c)
    (htm c (univ n c) a) ;

code-down (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) (a0 : GE)
    (h : TmDown a0 (tel c) (hty c (univ n c)) (htm c (univ n c) a)) :
    TmDown a0 (tel c) (M.univ n (hctx c)) (my-code n c a) =
  J.tm-cast-down a0 (tel c) (hty c (univ n c)) (M.univ n (hctx c)) (ex-ty-univ n c) (htm c (univ n c) a) h ;

code-down-r (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) (r : RepEl c (univ n c) a) :
    TmDown (rea c (univ n c) a r) (tel c) (M.univ n (hctx c)) (my-code n c a) =
  code-down n c a (rea c (univ n c) a r) (htm-down-r c (univ n c) a r) ;

ex-ty-decode (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) :
  Id (C.Ty (hctx c)) (hty c (decode n c a)) (M.decode n (hctx c) (my-code n c a)) =
  sq-rec (RepEl c (univ n c) a) (Id (C.Ty (hctx c)) (hty c (decode n c a)) (M.decode n (hctx c) (my-code n c a)))
    (C.isSetTy (hctx c) (hty c (decode n c a)) (M.decode n (hctx c) (my-code n c a)))
    (\ r -> ty-fn (gel n.1 (rea c (univ n c) a r)) (tel c) (hty c (decode n c a)) (M.decode n (hctx c) (my-code n c a))
      (hty-down-r c (decode n c a) (decode-rep n c a r))
      (decode-down n.1 n.2 (rea c (univ n c) a r) (tel c) (my-code n c a) (code-down-r n c a r)))
    (rep-el c (univ n c) a) ;

-- the binder of pic (InitHomLaws.dec-ext, mv-code)
my-dec-ext (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) :
  Id C.Ctx (hctx (ext c (decode n c a))) (C.ext (hctx c) (M.decode n (hctx c) (my-code n c a))) =
  trans C.Ctx (hctx (ext c (decode n c a))) (C.ext (hctx c) (hty c (decode n c a)))
    (C.ext (hctx c) (M.decode n (hctx c) (my-code n c a)))
    (ex-ctx-ext c (decode n c a))
    (ap (C.Ty (hctx c)) C.Ctx (\ T -> C.ext (hctx c) T)
      (hty c (decode n c a)) (M.decode n (hctx c) (my-code n c a)) (ex-ty-decode n c a)) ;

my-mv-code (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c))
    (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) :
    CodeF0 n (C.ext (hctx c) (M.decode n (hctx c) (my-code n c a))) =
  mvCode0 n (hctx (ext c (decode n c a))) (C.ext (hctx c) (M.decode n (hctx c) (my-code n c a)))
    (my-dec-ext n c a) (my-code n (ext c (decode n c a)) b) ;

tel-dec-ext (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c)) :
  Id Tel (tel (ext c (decode n c a))) (extend (tel c) (M.decode n (hctx c) (my-code n c a))) =
  trans Tel (tel (ext c (decode n c a))) (extend (tel c) (hty c (decode n c a)))
    (extend (tel c) (M.decode n (hctx c) (my-code n c a)))
    (tel-ext c (decode n c a))
    (ap (C.Ty (hctx c)) Tel (\ T -> extend (tel c) T)
      (hty c (decode n c a)) (M.decode n (hctx c) (my-code n c a)) (ex-ty-decode n c a)) ;

module ExPic (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c))
    (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) {
  E : Ctx = ext c (decode n c a) ;
  W : U l = RepEl c (univ n c) a * RepEl E (univ n E) b ;
  a0 (x : W) : GE = rea c (univ n c) a x.1 ;
  b0 (x : W) : GE = rea E (univ n E) b x.2 ;
  ru (x : W) : RepTy c (univ n c) = OpPic[n,c,a,b].ru x ;
  lhs : CodeF0 n (hctx c) = my-code n c (pic n c a b) ;
  rhs : CodeF0 n (hctx c) = M.pic n (hctx c) (my-code n c a) (my-mv-code n c a b) ;
  step (x : W) : Id (CodeF0 n (hctx c)) lhs rhs =
    tm-fn (gpic n.1 (a0 x) (b0 x)) (tel c) (M.univ n (hctx c)) lhs rhs
      (code-down n c (pic n c a b) (gpic n.1 (a0 x) (b0 x))
        (htm-down c (univ n c) (pic n c a b) (reG c (univ n c) a x.1) (guu n.1) (gpic n.1 (a0 x) (b0 x))
          (OpPic[n,c,a,b].der x) (rtH c (univ n c) (ru x)) (rtW c (univ n c) (ru x)) (rtP c (univ n c) (ru x))
          (rtE c (univ n c) (ru x))
          (sym (El c (univ n c)) (pic n c a b) (OpPic[n,c,a,b].f x) (OpPic[n,c,a,b].beta x))))
      (pic-down n.1 n.2 (a0 x) (b0 x) (tel c) (my-code n c a) (my-mv-code n c a b) (code-down-r n c a x.1)
        (code-down-mv n (b0 x) (tel E) (extend (tel c) (M.decode n (hctx c) (my-code n c a))) (tel-dec-ext n c a)
          (my-dec-ext n c a) (my-code n E b) (code-down-r n E b x.2))) ;
  result : Id (CodeF0 n (hctx c)) lhs rhs =
    sq-rec W (Id (CodeF0 n (hctx c)) lhs rhs) (C.isSetEl (hctx c) (M.univ n (hctx c)) lhs rhs) step
      (OpPic[n,c,a,b].reps) ;
} ;

ex-tm-pic (n : TM.LevelAt N) (c : Ctx) (a : El c (univ n c))
    (b : El (ext c (decode n c a)) (univ n (ext c (decode n c a)))) :
  Id (CodeF0 n (hctx c)) (my-code n c (pic n c a b)) (M.pic n (hctx c) (my-code n c a) (my-mv-code n c a b)) =
  ExPic[n,c,a,b].result ;

ex-tm-uc (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) :
  Id (CodeF0 n (hctx c)) (my-code n c (uc m n lt c)) (M.uc m n lt (hctx c)) =
  sq-rec (RepCtx c) (Id (CodeF0 n (hctx c)) (my-code n c (uc m n lt c)) (M.uc m n lt (hctx c)))
    (C.isSetEl (hctx c) (M.univ n (hctx c)) (my-code n c (uc m n lt c)) (M.uc m n lt (hctx c)))
    (\ r -> tm-fn (guc m.1 n.1) (tel c) (M.univ n (hctx c)) (my-code n c (uc m n lt c)) (M.uc m n lt (hctx c))
      (code-down n c (uc m n lt c) (guc m.1 n.1)
        (htm-down c (univ n c) (uc m n lt c) r.1 (guu n.1) (guc m.1 n.1) (OpUc[m,n,lt,c].der r)
          (rtH c (univ n c) (OpUc[m,n,lt,c].ru r)) (rtW c (univ n c) (OpUc[m,n,lt,c].ru r))
          (rtP c (univ n c) (OpUc[m,n,lt,c].ru r)) (rtE c (univ n c) (OpUc[m,n,lt,c].ru r))
          (sym (El c (univ n c)) (uc m n lt c) (OpUc[m,n,lt,c].f r) (OpUc[m,n,lt,c].beta r))))
      (uc-down m.1 n.1 m.2 n.2 lt (tel c)))
    (rep-ctx c) ;

ex-tm-lf (m n : TM.LevelAt N) (lt : TM.StrictAt N m n) (c : Ctx) (a : El c (univ m c)) :
  Id (CodeF0 n (hctx c)) (my-code n c (lf m n lt c a)) (M.lf m n lt (hctx c) (my-code m c a)) =
  sq-rec (RepEl c (univ m c) a) (Id (CodeF0 n (hctx c)) (my-code n c (lf m n lt c a)) (M.lf m n lt (hctx c) (my-code m c a)))
    (C.isSetEl (hctx c) (M.univ n (hctx c)) (my-code n c (lf m n lt c a)) (M.lf m n lt (hctx c) (my-code m c a)))
    (\ r -> tm-fn (glf m.1 n.1 (rea c (univ m c) a r)) (tel c) (M.univ n (hctx c))
      (my-code n c (lf m n lt c a)) (M.lf m n lt (hctx c) (my-code m c a))
      (code-down n c (lf m n lt c a) (glf m.1 n.1 (rea c (univ m c) a r))
        (htm-down c (univ n c) (lf m n lt c a) (reG c (univ m c) a r) (guu n.1) (glf m.1 n.1 (rea c (univ m c) a r))
          (OpLf[m,n,lt,c,a].der r)
          (rtH c (univ n c) (OpLf[m,n,lt,c,a].run r)) (rtW c (univ n c) (OpLf[m,n,lt,c,a].run r))
          (rtP c (univ n c) (OpLf[m,n,lt,c,a].run r)) (rtE c (univ n c) (OpLf[m,n,lt,c,a].run r))
          (sym (El c (univ n c)) (lf m n lt c a) (OpLf[m,n,lt,c,a].f r) (OpLf[m,n,lt,c,a].beta r))))
      (lf-down m.1 n.1 m.2 n.2 lt (rea c (univ m c) a r) (tel c) (my-code m c a) (code-down-r m c a r)))
    (rep-el c (univ m c) a) ;
