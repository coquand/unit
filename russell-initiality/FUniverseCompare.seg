-- Coherence for universes, decoding, product codes and lifts.
level l ;
open Base ; open Lib[l] ; open FGAT[l] ; open FTyping[l] ; open FPresup[l] ;
open FSubstLaws[l] ; open FCtx[l] ; open FGen[l] ; open FCompareBase[l] ;

uu-frame-compare (n : Nat) (G H : FA) : TyFrameCompare (fuu n G) (fuu n H) =
  \ e p q -> fe-uu-cx G H n e p.2 ;

uc-frame-compare (m n : Nat) (G H : FA) : TmFrameCompare (fuc m n G) (fuc m n H) =
  \ e p q -> (fe-uu-cx G H n e p.2.2,fm-uc-cx G H m n e p.2.1 p.2.2) ;

el-frame-compare (n : Nat) (G a H b : FA) (ca : TmCompare a b) :
    TyFrameCompare (fel n G a) (fel n H b) =
  \ e h k -> compare e (ca G H (fuu n G) (fuu n H) e h k).2
 where {
  compare (e : CE G H) (terms : ME G a b (fuu n G)) : TE G (fel n G a) (fel n H b) =
    fe-trans G (fel n G a) (fel n G b) (fel n H b) (fe-el G n a b terms)
      (fe-el-context G n b (fpresup (fjeqtm G a b (fuu n G)) terms).2.2.2 H e) ;
 } ;

lf-frame-compare (m n : Nat) (G a H b : FA) (ca : TmCompare a b) :
    TmFrameCompare (flf m n G a) (flf m n H b) =
  \ e p q -> compare e (ca G H (fuu m G) (fuu m H) e p.1 q.1).2 p.2.1 p.2.2
 where {
  compare (e : CE G H) (h : ME G a b (fuu m G)) (le : LeN (suc m) n) (nb : LeN n N) :
      TE G (fuu n G) (fuu n H) * ME G (flf m n G a) (flf m n H b) (fuu n G) =
    (fe-uu-cx G H n e nb,fm-trans G (flf m n G a) (flf m n G b) (flf m n H b) (fuu n G)
      (fm-elf G m n a b h le nb)
      (fm-lf-context G m n b (fpresup (fjeqtm G a b (fuu m G)) h).2.2.2 le nb H e)) ;
 } ;

pic-frame-compare (n : Nat) (G a b H a' b' : FA) (ca : TmCompare a a') (cb : TmCompare b b') :
    TmFrameCompare (fpic n G a b) (fpic n H a' b') =
  \ e p q -> compare e p.1 p.2 q.1 q.2
 where {
  compare (e : CE G H) (ha : Tm' G a (fuu n G)) (hb : Tm' (fext G (fel n G a)) b (fuu n (fext G (fel n G a))))
      (ha' : Tm' H a' (fuu n H)) (hb' : Tm' (fext H (fel n H a')) b' (fuu n (fext H (fel n H a')))) :
      TE G (fuu n G) (fuu n H) * ME G (fpic n G a b) (fpic n H a' b') (fuu n G) =
    (fe-uu-cx G H n e nb,fm-trans G (fpic n G a b) (fpic n G a' b') (fpic n H a' b') (fuu n G)
      (fm-epic G n a a' b b' ha domains bodies)
      (fm-pic-context G n a' b' right-domain right-body H e))
   where {
    domains : ME G a a' (fuu n G) = (ca G H (fuu n G) (fuu n H) e ha ha').2 ;
    right-domain : Tm' G a' (fuu n G) = (fpresup (fjeqtm G a a' (fuu n G)) domains).2.2.2 ;
    dec-context : TE G (fel n G a') (fel n H a') = fe-el-context G n a' right-domain H e ;
    binder : CE (fext G (fel n G a)) (fext H (fel n H a')) =
      ext-eq e (fe-trans G (fel n G a) (fel n G a') (fel n H a') (fe-el G n a a' domains) dec-context) ;
    bodies : ME (fext G (fel n G a)) b b' (fuu n (fext G (fel n G a))) =
      (cb (fext G (fel n G a)) (fext H (fel n H a')) (fuu n (fext G (fel n G a))) (fuu n (fext H (fel n H a'))) binder hb hb').2 ;
    nb : LeN n N = f-universe-tm-bound G a n ha ;
    right-body : Tm' (fext G (fel n G a')) b' (fuu n (fext G (fel n G a'))) =
      move-universe {fext H (fel n H a')} {fext G (fel n G a')} {b'} n
        (ext-wf (ft-el G n a' right-domain))
        (f-cx-sym (fext G (fel n G a')) (fext H (fel n H a')) (ext-eq e dec-context)) nb hb' ;
   } ;
 } ;
