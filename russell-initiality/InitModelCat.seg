-- InitModelCat.seg (PLAN-INIT, Part A): the category laws and the laws of
-- the substitution action of the term model (fields o-idl o-idr o-assoc
-- eps-uniq subT-id subT-o subt-id subt-o of CwF).  The fields with a
-- transport (subt-id, subt-o) are proved for an ARBITRARY path of types
-- (-gen), Ty being a set.
-- Method: fix raw contexts (with-cp), normalised representatives of the
-- arguments (with-nt/ns/ne), compute both sides with InitModelRepOps, and
-- relate them (nt-eq/ns-eq/ne-eq) with the GDer rule.
level l ;
open Base ; open Prelude[l] ;
module B = BoundedSyntax[N] ;
open B.GAT[l] ;
open InitQuot[l] ;
open InitSorts[l] ;
open InitOpsCtx[l] ;
open InitOpsSub[l] ;
open InitModelRep[l] ;
open InitModelRepOps[l] ;

------------------------------------------------------------------------
-- category

o-idl (d c : Ctx) (s : Sub d c) : Id (Sub d c) (o d c c (id c) s) s =
  with-cp d P pP (\ cd -> with-cp c P pP (\ cc -> with-ns d c cd cc s P pP (\ u ->
    ns-eq d c cd cc cd cc (o d c c (id c) s) s (o-n d c c cd cc cc (id c) s (id-n c cc) u) u
      (gq-idl cd.1 cc.1 u.1 u.2.1))))
 where { P : U l = Id (Sub d c) (o d c c (id c) s) s ; pP : isProp P = isSetSub d c (o d c c (id c) s) s ; } ;

o-idr (d c : Ctx) (s : Sub d c) : Id (Sub d c) (o d d c s (id d)) s =
  with-cp d P pP (\ cd -> with-cp c P pP (\ cc -> with-ns d c cd cc s P pP (\ u ->
    ns-eq d c cd cc cd cc (o d d c s (id d)) s (o-n d d c cd cd cc s (id d) u (id-n d cd)) u
      (gq-idr cd.1 cc.1 u.1 u.2.1))))
 where { P : U l = Id (Sub d c) (o d d c s (id d)) s ; pP : isProp P = isSetSub d c (o d d c s (id d)) s ; } ;

o-assoc (q0 t d c : Ctx) (s : Sub d c) (s' : Sub t d) (s'' : Sub q0 t) :
  Id (Sub q0 c) (o q0 t c (o t d c s s') s'') (o q0 d c s (o q0 t d s' s'')) =
  with-cp q0 P pP (\ cq -> with-cp t P pP (\ ct -> with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
  with-ns d c cd cc s P pP (\ u -> with-ns t d ct cd s' P pP (\ u' -> with-ns q0 t cq ct s'' P pP (\ u'' ->
    ns-eq q0 c cq cc cq cc (o q0 t c (o t d c s s') s'') (o q0 d c s (o q0 t d s' s''))
      (o-n q0 t c cq ct cc (o t d c s s') s'' (o-n t d c ct cd cc s s' u u') u'')
      (o-n q0 d c cq cd cc s (o q0 t d s' s'') u (o-n q0 t d cq ct cd s' s'' u' u''))
      (gq-assoc cq.1 ct.1 cd.1 cc.1 u.1 u'.1 u''.1 u.2.1 u'.2.1 u''.2.1))))))))
 where {
  P : U l = Id (Sub q0 c) (o q0 t c (o t d c s s') s'') (o q0 d c s (o q0 t d s' s'')) ;
  pP : isProp P = isSetSub q0 c (o q0 t c (o t d c s s') s'') (o q0 d c s (o q0 t d s' s'')) ;
 } ;

eps-uniq (c : Ctx) (s : Sub c nil) : Id (Sub c nil) s (eps c) =
  with-cp c P pP (\ cc -> with-ns c nil cc nil-cp s P pP (\ u ->
    ns-eq c nil cc nil-cp cc nil-cp s (eps c) u (eps-n c cc) (gq-eps cc.1 u.1 u.2.1)))
 where { P : U l = Id (Sub c nil) s (eps c) ; pP : isProp P = isSetSub c nil s (eps c) ; } ;

------------------------------------------------------------------------
-- substitution in types

subT-id (c : Ctx) (A : Ty c) : Id (Ty c) (subT c c A (id c)) A =
  with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x ->
    nt-eq c cc cc (subT c c A (id c)) A (subT-n c c cc cc A (id c) x (id-n c cc)) x (ge-sb-id cc.1 x.1 x.2.1)))
 where { P : U l = Id (Ty c) (subT c c A (id c)) A ; pP : isProp P = isSetTy c (subT c c A (id c)) A ; } ;

subT-o (t d c : Ctx) (A : Ty c) (s : Sub d c) (s' : Sub t d) :
  Id (Ty t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') =
  with-cp t P pP (\ ct -> with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
  with-nt c cc A P pP (\ x -> with-ns d c cd cc s P pP (\ u -> with-ns t d ct cd s' P pP (\ u' ->
    nt-eq t ct ct (subT t c A (o t d c s s')) (subT t d (subT d c A s) s')
      (subT-n t c ct cc A (o t d c s s') x (o-n t d c ct cd cc s s' u u'))
      (subT-n t d ct cd (subT d c A s) s' (subT-n d c cd cc A s x u) u')
      (ge-sym ct.1 (gsb (gsb x.1 u.1) u'.1) (gsb x.1 (gcomp u.1 u'.1))
        (ge-sb-comp ct.1 cd.1 cc.1 x.1 u.1 u'.1 x.2.1 u.2.1 u'.2.1))))))))
 where {
  P : U l = Id (Ty t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') ;
  pP : isProp P = isSetTy t (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') ;
 } ;

------------------------------------------------------------------------
-- substitution in terms

subt-id-gen (c : Ctx) (A : Ty c) (a : El c A) (e : Id (Ty c) (subT c c A (id c)) A) :
  Id (El c A) (subst (Ty c) (El c) (subT c c A (id c)) A e (subt c c A a (id c))) a =
  with-cp c P pP (\ cc -> with-nt c cc A P pP (\ x -> with-ne c cc A x a P pP (\ y ->
    ne-eq c cc cc A (nt-tr c cc (subT c c A (id c)) A (subT-n c c cc cc A (id c) x (id-n c cc)) e) x
      (subst (Ty c) (El c) (subT c c A (id c)) A e (subt c c A a (id c))) a
      (ne-subst c cc (subT c c A (id c)) A e (subT-n c c cc cc A (id c) x (id-n c cc)) (subt c c A a (id c))
        (subt-n c c cc cc A (id c) x a y (id-n c cc)))
      y
      (gm-eqconv cc.1 (gsb y.1 gid) y.1 x.1 (gsb x.1 gid) (gm-sb-id cc.1 y.1 x.1 y.2.1)
        (ge-sym cc.1 (gsb x.1 gid) x.1 (ge-sb-id cc.1 x.1 x.2.1))))))
 where {
  P : U l = Id (El c A) (subst (Ty c) (El c) (subT c c A (id c)) A e (subt c c A a (id c))) a ;
  pP : isProp P = isSetEl c A (subst (Ty c) (El c) (subT c c A (id c)) A e (subt c c A a (id c))) a ;
 } ;

subt-id (c : Ctx) (A : Ty c) (a : El c A) :
  Id (El c A) (subst (Ty c) (El c) (subT c c A (id c)) A (subT-id c A) (subt c c A a (id c))) a =
  subt-id-gen c A a (subT-id c A) ;

subt-o-gen (t d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) (s' : Sub t d)
  (e : Id (Ty t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s')) :
  Id (El t (subT t d (subT d c A s) s'))
     (subst (Ty t) (El t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') e (subt t c A a (o t d c s s')))
     (subt t d (subT d c A s) (subt d c A a s) s') =
  with-cp t P pP (\ ct -> with-cp d P pP (\ cd -> with-cp c P pP (\ cc ->
  with-nt c cc A P pP (\ x -> with-ne c cc A x a P pP (\ y ->
  with-ns d c cd cc s P pP (\ u -> with-ns t d ct cd s' P pP (\ u' ->
    ne-eq t ct ct (subT t d (subT d c A s) s')
      (nt-tr t ct (subT t c A (o t d c s s')) (subT t d (subT d c A s) s')
        (subT-n t c ct cc A (o t d c s s') x (o-n t d c ct cd cc s s' u u')) e)
      (subT-n t d ct cd (subT d c A s) s' (subT-n d c cd cc A s x u) u')
      (subst (Ty t) (El t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') e (subt t c A a (o t d c s s')))
      (subt t d (subT d c A s) (subt d c A a s) s')
      (ne-subst t ct (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') e
        (subT-n t c ct cc A (o t d c s s') x (o-n t d c ct cd cc s s' u u')) (subt t c A a (o t d c s s'))
        (subt-n t c ct cc A (o t d c s s') x a y (o-n t d c ct cd cc s s' u u')))
      (subt-n t d ct cd (subT d c A s) s' (subT-n d c cd cc A s x u) (subt d c A a s) (subt-n d c cd cc A s x a y u) u')
      (gm-sym ct.1 (gsb (gsb y.1 u.1) u'.1) (gsb y.1 (gcomp u.1 u'.1)) (gsb x.1 (gcomp u.1 u'.1))
        (gt-sb ct.1 cc.1 x.1 (gcomp u.1 u'.1) x.2.1 (gs-comp ct.1 cd.1 cc.1 u.1 u'.1 u.2.1 u'.2.1))
        (gm-sb-comp ct.1 cd.1 cc.1 y.1 x.1 u.1 u'.1 y.2.1 u.2.1 u'.2.1)))))))))
 where {
  P : U l = Id (El t (subT t d (subT d c A s) s'))
     (subst (Ty t) (El t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') e (subt t c A a (o t d c s s')))
     (subt t d (subT d c A s) (subt d c A a s) s') ;
  pP : isProp P = isSetEl t (subT t d (subT d c A s) s')
     (subst (Ty t) (El t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') e (subt t c A a (o t d c s s')))
     (subt t d (subT d c A s) (subt d c A a s) s') ;
 } ;

subt-o (t d c : Ctx) (A : Ty c) (a : El c A) (s : Sub d c) (s' : Sub t d) :
  Id (El t (subT t d (subT d c A s) s'))
     (subst (Ty t) (El t) (subT t c A (o t d c s s')) (subT t d (subT d c A s) s') (subT-o t d c A s s')
       (subt t c A a (o t d c s s')))
     (subt t d (subT d c A s) (subt d c A a s) s') =
  subt-o-gen t d c A a s s' (subT-o t d c A s s') ;
