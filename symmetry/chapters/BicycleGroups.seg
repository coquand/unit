-- Multiplication of paths acts by composition of the associated bijections.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = BicycleSymmetries[l] ; module Big = Prelude[l+] ; module BP = Paths[l+] ;
module E = Equivalences[l] ; module BE = Equivalences[l+] ; module CG = ChapterFour[l] ; module LC = LoopConj[l+] ;
module Based (X : U l) (x : X) (Y : U l+) (y : Y) (f : X -> Y) (p : Id Y (f x) y)
  (emb : Big.isEquiv (Id X x x) (Id Y (f x) (f x)) (Big.ap X Y f x x)) {
  module Lift = PathTransport[l+].BasedLoops[X,x,Y,y,f,p,emb] ;
  raw : Big.Equiv (Id X x x) (Id Y (f x) (f x)) = Lift.raw ;
  loops : Big.Equiv (Id X x x) (Id Y y y) = Lift.loops ;
  mul (u v : Id X x x) : Id (Id Y y y) (loops.1 (transH v u)) (BP.transH (loops.1 v) (loops.1 u)) =
    Lift.compose v u ;
} ;
module For (G : B.Bicycle) {
  module C = B.Component[G] ; module S = CG.Symmetries[C.group] ; module M = B.Maps[G,G] ; module N = B.Normality[G] ;
  module P = Based[C.L.carrier,C.L.point,B.Bicycle,G,C.L.image.inclusion,C.L.path-at-point,C.L.image.embedding C.L.point C.L.point] ;
  code : Equiv S.carrier M.iso = Truncations[l].lower _ _ (BE.compose _ _ _ P.loops (B.Identity[G].equivalence G)) ;
  composition (H : B.Bicycle) (p : Id B.Bicycle G H) (K : B.Bicycle) (q : Id B.Bicycle H K) (x : G.X) :
    Id K.X ((B.Identity[G].System.tr K (BP.transH p q)).1.1 x)
      ((B.Identity[H].System.tr K q).1.1 ((B.Identity[G].System.tr H p).1.1 x)) =
    idJ B.Bicycle H (\ W r -> Id W.X ((B.Identity[G].System.tr W (BP.transH p r)).1.1 x)
      ((B.Identity[H].System.tr W r).1.1 ((B.Identity[G].System.tr H p).1.1 x))) (refl ((B.Identity[G].System.tr H p).1.1 x)) K q ;
  preserves (p q : S.carrier) : Id M.iso (code.1 (S.abstract.mul p q)) (N.composite (code.1 q) (code.1 p)) =
    M.eq _ _ (\ x -> transH (BP.apH (\ r -> (B.Identity[G].System.tr G r).1.1 x) (P.mul p q))
      (composition G (P.loops.1 q) G (P.loops.1 p) x)) ;
} ;
module Permutations (X : U l) (s : isSet X) {
  module G = CG.Symmetric[X,s] ; module S = CG.Symmetries[G.group] ;
  module P = Based[G.group.space,G.pt,U l,X,G.C.extension,G.C.triangle tt,G.C.image.embedding G.pt G.pt] ;
  decode : Equiv S.carrier (Equiv X X) = Truncations[l].lower _ _ (BE.compose _ _ _ P.loops (Axioms[l].idtoeqv X X,univ @l X X)) ;
  compose (Y : U l) (p : Id (U l) X Y) (Z : U l) (q : Id (U l) Y Z) (x : X) :
    Id Z ((Axioms[l].idtoeqv X Z (BP.transH p q)).1 x) ((Axioms[l].idtoeqv Y Z q).1 ((Axioms[l].idtoeqv X Y p).1 x)) =
    idJ (U l) Y (\ W r -> Id W ((Axioms[l].idtoeqv X W (BP.transH p r)).1 x)
      ((Axioms[l].idtoeqv Y W r).1 ((Axioms[l].idtoeqv X Y p).1 x))) (refl ((Axioms[l].idtoeqv X Y p).1 x)) Z q ;
  mul (p q : S.carrier) (x : X) : Id X ((decode.1 (S.abstract.mul p q)).1 x) ((decode.1 p).1 ((decode.1 q).1 x)) =
    transH (BP.apH (\ r -> (Axioms[l].idtoeqv X X r).1 x) (P.mul p q)) (compose X (P.loops.1 q) X (P.loops.1 p) x) ;
} ;
module Regular (G : B.Bicycle) (o : G.X) (section : G.X -> B.Maps[G,G].iso)
  (beta : (x : G.X) -> Id G.X (B.Maps[G,G].eval o (section x)) x) {
  module C = For[G] ; module M = C.M ;
  coords : Equiv C.S.carrier G.X = E.compose _ _ _ C.code (M.eval o,qinv _ _ (M.eval o) section beta
    (\ f -> M.injective o _ f (beta (M.eval o f)))) ;
  law (p q : C.S.carrier) : Id G.X (coords.1 (C.S.abstract.mul p q)) ((section (coords.1 p)).1.1 (coords.1 q)) =
    transH (apH (M.eval o) (C.preserves p q)) (apH (M.eval (coords.1 q))
      (symH (M.injective o _ (C.code.1 p) (beta (coords.1 p))))) ;
} ;
module Compare (G : B.Bicycle) (o : G.X) (section : G.X -> B.Maps[G,G].iso)
  (beta : (x : G.X) -> Id G.X (B.Maps[G,G].eval o (section x)) x)
  (Y : U l) (s : isSet Y) (label : Equiv G.X (Equiv Y Y))
  (compose : (x y : G.X) (z : Y) -> Id Y ((label.1 ((section x).1.1 y)).1 z) ((label.1 x).1 ((label.1 y).1 z))) {
  module R = Regular[G,o,section,beta] ; module P = Permutations[Y,s] ;
  show : Equiv R.C.S.carrier (Equiv Y Y) = E.compose _ _ _ R.coords label ;
  iso : Equiv R.C.S.carrier P.S.carrier = E.compose _ _ _ show (Bijection[l].inverse _ _ P.decode) ;
  compute (p : R.C.S.carrier) (z : Y) : Id Y ((P.decode.1 (iso.1 p)).1 z) ((show.1 p).1 z) =
    apH (\ f -> f.1 z) (P.decode.2.sec-eq (show.1 p)) ;
  action-mul (p q : R.C.S.carrier) (z : Y) :
    Id Y ((show.1 (R.C.S.abstract.mul p q)).1 z) ((show.1 p).1 ((show.1 q).1 z)) =
    transH (apH (\ t -> (label.1 t).1 z) (R.law p q)) (compose (R.coords.1 p) (R.coords.1 q) z) ;
  decoded-mul (p q : R.C.S.carrier) (z : Y) :
    Id Y ((P.decode.1 (P.S.abstract.mul (iso.1 p) (iso.1 q))).1 z) ((show.1 p).1 ((show.1 q).1 z)) =
    transH (P.mul (iso.1 p) (iso.1 q) z)
      (transH (compute p ((P.decode.1 (iso.1 q)).1 z)) (apH (show.1 p).1 (compute q z))) ;
  multiplicative (p q : R.C.S.carrier) : Id P.S.carrier (iso.1 (R.C.S.abstract.mul p q)) (P.S.abstract.mul (iso.1 p) (iso.1 q)) =
    E.injective _ _ P.decode.1 P.decode.2 _ _ (ChapterTwo[l].equiv-ext Y Y _ _
      (\ z -> transH (compute (R.C.S.abstract.mul p q) z) (transH (action-mul p q z) (symH (decoded-mul p q z))))) ;
  id : Id CG.ConcreteGroup R.C.C.group P.G.group = BE.injective _ _ GroupIdentity[l].loops GroupIdentity[l].equivalence.2 _ _
    (GroupIdentity[l].abstract-path R.C.S.abstract P.S.abstract iso multiplicative) ;
} ;

module TwoPermutations {
  module T = TwoElementSets[l] ; module Q = T.SBase ; X : U l = T.standard ;
  module P = Permutations[X,FiniteCycles[l].fin-set T.two] ;
  module S = P.S ;
  eq (f g : Equiv X X) (h : (x : X) -> Id X (f.1 x) (g.1 x)) : Id (Equiv X X) f g = ChapterTwo[l].equiv-ext X X f g h ;
  invol-tail : (i : FinChoice[l].Fin T.one) (x : X) -> Id X ((Q.choose-tail i).1 ((Q.choose-tail i).1 x)) x = split {
    none -> Q.twice ; some j -> absurd _ j } ;
  invol-label : (i : X) (x : X) -> Id X ((Q.choose i).1 ((Q.choose i).1 x)) x = split { none -> \ x -> refl x ; some i -> invol-tail i } ;
  invol (f : Equiv X X) : (x : X) -> Id X (f.1 (f.1 x)) x = subst (Equiv X X) (\ e -> (x : X) -> Id X (e.1 (e.1 x)) x)
    _ f (Q.automorphisms.2.sec-eq f) (invol-label (Q.automorphisms.2.sec f)) ;
  -- In a two-element set every permutation is its own inverse, including composites.
  comm (e f : Equiv X X) (x : X) : Id X (e.1 (f.1 x)) (f.1 (e.1 x)) =
    transH (symH (apH (\ z -> e.1 (f.1 z)) (transH (apH e.1 (invol f (e.1 x))) (invol e x)))) (invol (E.compose _ _ _ f e) (f.1 (e.1 x))) ;
  abelian (p q : S.carrier) : Id S.carrier (S.abstract.mul p q) (S.abstract.mul q p) = E.injective _ _ P.decode.1 P.decode.2 _ _
    (eq _ _ (\ x -> transH (P.mul p q x) (transH (comm (P.decode.1 p) (P.decode.1 q) x) (symH (P.mul q p x))))) ;
  unit-action (x : X) : Id X ((P.decode.1 S.abstract.e).1 x) x =
    BP.apH (\ r -> (Axioms[l].idtoeqv X X r).1 x) (LC.conj-refl (U l) _ _ (P.G.C.triangle tt)) ;
  exponent-two (p : S.carrier) : Id S.carrier (S.abstract.mul p p) S.abstract.e = E.injective _ _ P.decode.1 P.decode.2 _ _
    (eq _ _ (\ x -> transH (P.mul p p x) (transH (invol (P.decode.1 p) x) (symH (unit-action x))))) ;
} ;
