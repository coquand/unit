-- Exercise 5.3.29 (Lagrange's theorem): for a finite group G and a subgroup
-- with finite G-set X and underlying group H, #G = #X * #H.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module F = FiniteSets[l] ; module A = FiniteArithmetic[l] ; module N = FiniteCounting[l] ; module C = Cardinality[l] ;
module TC = TruncationCombinators[l] ;
module At (G : ChapterFour[l].ConcreteGroup) (H : Subgroups[l].Over[G].Sub)
  (fg : F.Finite (Id G.space G.point G.point)) (fx : F.Finite (GSets[l].Over[G].el H.1 G.point)) {
  module L = SubgroupTheory[l].Over[G].Lagrange[H] ; module S = L.A ; module GS = GSets[l].Over[G] ;
  X : U l = GS.el H.1 G.point ;
  stab-finite : F.Finite S.stabilizer = A.sigma (Id G.space G.point G.point) fg (\ g -> Subgroups[l].Over[G].Action[H.1].F.stabilizes g L.x0)
    (\ g -> FiniteSubsets[l].Proposition[Subgroups[l].Over[G].Action[H.1].F.stabilizes g L.x0,Subgroups[l].Over[G].Action[H.1].F.stabilizes-prop g L.x0].finite
      (FiniteDecisions[l].On[X,fx].discrete (GS.act H.1 G.point G.point g L.x0) L.x0)) ;
  -- H is finite.
  finite : F.Finite S.loops = A.Change[S.stabilizer,S.loops,Bijection[l].inverse _ _ S.symmetries].finite stab-finite ;
  module Count (f : L.Premise) {
    module Un = N.Uniform[X,S.loops,fx,finite,\ x -> S.loops,\ x -> idEquiv S.loops] ;
    formula : Id Nat (C.Count[Id G.space G.point G.point].cardinal fg) (N.times (C.Count[X].cardinal fx) (C.Count[S.loops].cardinal finite)) =
      transH (A.Change[Id G.space G.point G.point,Un.total,L.construction f].same fg Un.bounded) Un.formula ;
  } ;
  theorem : Id Nat (C.Count[Id G.space G.point G.point].cardinal fg) (N.times (C.Count[X].cardinal fx) (C.Count[S.loops].cardinal finite)) =
    TC.rec L.Premise @l _ (NatArith[l].nat-set _ _) (\ f -> Count[f].formula) (L.premise fx) ;
} ;
