-- Section 2.18. Conditional implications between logical principles.
level u v ; constraint u <= v ;
open Base ; open Prelude[v] ;
module P = Prelude[u] ;
module B = Prelude[v+] ;
module Q = Quotient[u] ;
module V = Quotient[v] ;
module L = Logic[v] ;
LEM : U v+ = (A : U v) -> isProp A -> L.Dec A ;
DNE : U v+ = (A : U v) -> isProp A -> L.Not (L.Not A) -> A ;
dec-to-dne (A : U v) : L.Dec A -> L.Not (L.Not A) -> A = split {
  yes a -> \ n -> a ; no k -> \ n -> absurd A (n k) } ;
lem-dne (lem : LEM) : DNE = \ A p -> dec-to-dne A (lem A p) ;
dne-lem (dne : DNE) : LEM = \ A p -> dne (L.Dec A) (L.dec-prop A p)
  (\ reject -> reject (no (\ a -> reject (yes a)))) ;

lift (X : Q.Prop) : V.Prop = (X.1,\ a b -> X.2 a b) ;
Resizing : U v+ = B.isEquiv Q.Prop V.Prop lift ;
module UnderLEM (lem : LEM) {
  small (X : V.Prop) : L.Dec X.1 -> Q.Prop = split {
    yes x -> (Top,isTop) ; no n -> (Empty,P.isProp-Empty) } ;
  lower (X : V.Prop) : Q.Prop = small X (lem X.1 X.2) ;
  large-law (X : V.Prop) : (d : L.Dec X.1) -> Id V.Prop (lift (small X d)) X = split {
    yes x -> V.prop-path (lift (Top,isTop)) X (\ t -> x) (\ x -> tt) ;
    no n -> V.prop-path (lift (Empty,P.isProp-Empty)) X (absurd X.1) n } ;
  small-law (X : Q.Prop) : (d : L.Dec X.1) -> Id Q.Prop (small (lift X) d) X = split {
    yes x -> Q.prop-path (Top,isTop) X (\ t -> x) (\ x -> tt) ;
    no n -> Q.prop-path (Empty,P.isProp-Empty) X (absurd X.1) n } ;
  resizes : Resizing = B.qinv Q.Prop V.Prop lift lower
    (\ X -> large-law X (lem X.1 X.2)) (\ X -> small-law X (lem X.1 (lift X).2)) ;
} ;
