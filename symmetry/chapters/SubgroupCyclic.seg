-- Exercise 5.3.16: two monomorphisms j, j' : C3 -> Sigma3 with Uj /= Uj'
-- that are identified in Mono(Sigma3). Here j' = j o iota with iota the
-- inversion automorphism of C3.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ;
module C3Monos {
  module D = CyclicGroupImage[l].Degree[CG.two] ; module Gen = CyclicGenerator[l].Standard[CG.two] ;
  C3 : CG.ConcreteGroup = D.G.group ; Sym3 : CG.ConcreteGroup = D.K.G.group ;
  module ST = SubgroupTheory[l].Over[Sym3] ; module SM = SubgroupMono[l].Over[Sym3] ;
  module J = Gen.J ; module Hm = Gen.Hom ;
  UC : U l = J.carrier ;
  step : Fin CG.three -> Fin CG.three = FiniteCycles[l].Standard[CG.two].step ;
  s : UC = Gen.generator ;
  j : CG.Hom C3 Sym3 = D.projection ;
  loop-j (p : UC) : ST.UG = ST.loop-map C3 j p ;
  mono-j : ST.isMono C3 j = SubgroupTheory[l].injective-fibres _ _ ST.UG-set _ D.inj ;
  -- The inversion: the homomorphism sending the generator s to s s.
  v : UC = J.abstract.mul s s ;
  lab-v (x : UC) : Id (Fin CG.three) (Gen.label.1 (J.abstract.mul v x)) (step (step (Gen.label.1 x))) =
    transH (apH Gen.label.1 (J.abstract.assoc s s x)) (transH (Gen.advance (J.abstract.mul s x)) (apH step (Gen.advance x))) ;
  module KP = CyclicHom[l,l].Powers[J.abstract,v] ;
  dbl : Nat -> Fin CG.three = split { zero -> none ; suc k | r -> step (step r) } ;
  lab-pow : (k : Nat) -> Id (Fin CG.three) (Gen.label.1 (KP.power k)) (dbl k) = split {
    zero -> Gen.start ; suc k | r -> transH (lab-v (KP.power k)) (apH (\ i -> step (step i)) r) } ;
  torsion : Id UC (KP.power CG.three) J.abstract.e = Hm.faithful _ _ (transH (lab-pow CG.three) (symH Gen.start)) ;
  module Ext = Hm.Into[J.abstract].Extend[(v,torsion)] ;
  f : UC -> UC = Ext.f ;
  sigma (i : Fin CG.three) : Fin CG.three = dbl (CyclicHom[l,l].rank CG.three i) ;
  sigma-1 : (k : Fin (suc zero)) -> Id (Fin CG.three) (sigma (sigma (some (some k)))) (some (some k)) =
    split { none -> refl (some (some none)) ; some e -> absurd (Id (Fin CG.three) (sigma (sigma (some (some (some e))))) (some (some (some e)))) e } ;
  sigma-2 : (i : Fin CG.two) -> Id (Fin CG.three) (sigma (sigma (some i))) (some i) =
    split { none -> refl (some none) ; some k -> sigma-1 k } ;
  sigma-sigma : (i : Fin CG.three) -> Id (Fin CG.three) (sigma (sigma i)) i = split { none -> refl none ; some i -> sigma-2 i } ;
  f-label (x : UC) : Id (Fin CG.three) (Gen.label.1 (f x)) (sigma (Gen.label.1 x)) = lab-pow (CyclicHom[l,l].rank CG.three (Gen.label.1 x)) ;
  f-f (x : UC) : Id UC (f (f x)) x = Hm.faithful _ _ (transH (f-label (f x)) (transH (apH sigma (f-label x)) (sigma-sigma (Gen.label.1 x)))) ;
  f-equiv : Equiv UC UC = (f,qinv _ _ f f f-f f-f) ;
  module OM = ChapterSeven[l].OrdinaryMaps[C3,C3] ;
  iota : CG.Hom C3 C3 = OM.comparison.2.sec Ext.hom ;
  iota-loop (p : UC) : Id UC ((OM.M.D.loop iota).1 p) (f p) = apH (\ g -> g.1 p) (OM.comparison.2.sec-eq Ext.hom) ;
  iota-equiv : isEquiv C3.space C3.space iota.1 = Whitehead[l].Pointed[C3.space,C3.point,C3.space,C3.point,iota,C3.connected,
    Equivalences[l].homotopy _ _ f-equiv (OM.M.D.loop iota).1 iota-loop].equiv C3.connected ;
  j' : CG.Hom C3 Sym3 = CG.compose C3 C3 Sym3 j iota ;
  lj' (p : UC) : ST.UG = ST.loop-map C3 j' p ;
  loop-j' (p : UC) : Id ST.UG (lj' p) (loop-j (f p)) = transH
    (apH (\ h -> h.1 p) (LoopCalc[l].loop-comp C3.space C3.point C3.space C3.point Sym3.space Sym3.point iota j))
    (apH loop-j (iota-loop p)) ;
  mono-j' : ST.isMono C3 j' = SubgroupTheory[l].injective-fibres _ _ ST.UG-set _ (\ p q h ->
    transH (symH (f-f p)) (transH (apH f (D.inj (f p) (f q)
      (transH (symH (loop-j' p)) (transH h (loop-j' q))))) (f-f q))) ;
  -- Uj and Uj' differ at the generator.
  is-one-2 : Fin CG.two -> U l = split { none -> Top ; some k -> Empty } ;
  is-one : Fin CG.three -> U l = split { none -> Empty ; some i -> is-one-2 i } ;
  label-s : Id (Fin CG.three) (Gen.label.1 s) (step none) =
    transH (apH Gen.label.1 (symH (J.abstract.unitr s))) (transH (Gen.advance J.abstract.e) (apH step Gen.start)) ;
  different (h : Id (UC -> ST.UG) (ST.loop-map C3 j) (ST.loop-map C3 j')) : Empty =
    subst (Fin CG.three) is-one (step none) (step (step none))
      (transH (symH label-s) (transH (apH Gen.label.1 fixed) (transH (f-label s) (apH sigma label-s)))) tt where {
    fixed : Id UC s (f s) = D.inj s (f s) (transH (apH (\ g -> g s) h) (loop-j' s)) ;
  } ;
  -- (C3,j) and (C3,j') are identified in Mono(Sigma3) along iota.
  identified : Id ST.Mono (C3,j',mono-j') (C3,j,mono-j) =
    Big.trans ST.Mono _ _ _
      (SM.mono-path C3 j' mono-j' C3.space C3.point (iota,iota-equiv) (GroupIdentity[l].parts C3) j mono-j (refl j'))
      (SM.rebuilt C3 j mono-j) ;
} ;
