-- Exercise 4.3.5 and Exercise 4.4.19.
level u v ; open Base ; open Prelude[u \/ v] ;
module FL = Axioms[u \/ v].FunExtLemmas[fe @(u \/ v)] ;
module Pointwise (X : U u) (G : Group[v].Grp) {
  carrier : U (u \/ v) = X -> G.G ;
  eq (f g : carrier) : ((x : X) -> Id G.G (f x) (g x)) -> Id carrier f g = FL.funext X (\ x -> G.G) f g ;
  group : Group[u \/ v].Grp = new Group[u \/ v].Grp[carrier,FL.isSet-Pi X (\ x -> G.G) (\ x -> G.setG),
    (\ x -> G.e),(\ f g x -> G.mul (f x) (g x)),(\ f x -> G.inv (f x)),
    (\ f g h -> eq _ _ (\ x -> G.assoc (f x) (g x) (h x))),
    (\ f -> eq _ _ (\ x -> G.unitl (f x))),(\ f -> eq _ _ (\ x -> G.unitr (f x))),
    (\ f -> eq _ _ (\ x -> G.invl (f x))),(\ f -> eq _ _ (\ x -> G.invr (f x)))] ;
  abelian (c : (x y : G.G) -> Id G.G (G.mul x y) (G.mul y x)) (f g : carrier) :
    Id carrier (group.mul f g) (group.mul g f) = eq _ _ (\ x -> c (f x) (g x)) ;
} ;
module Maps (G : ChapterFour[u].ConcreteGroup) (A : U u) (h : HLevels[u].isTrunc ChapterFour[u].three A) {
  module M = PointedAdjunction[u,u].FreeMaps[G.space,G.point,A] ;
  module P (a : A) { module C = PointedComponent[u].AtBase[A,h,a] ; } ;
  total : U u = (a : A) * ChapterFour[u].Hom G P[a].C.P.group ;
  equivalence : Prelude[u].Equiv total (G.space -> A) = Equivalences[u].compose _ _ _
    (Fibres[u].sigma-equiv A (\ a -> ChapterFour[u].Hom G P[a].C.P.group)
      (\ a -> Lemma4[u].PtMap G.space G.point A a) (\ a -> P[a].C.Cones[G].universal)) M.equivalence ;
} ;
