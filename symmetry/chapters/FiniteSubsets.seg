-- §§2.24 and 8.4.3. Finiteness of arbitrary subsets of a finite set
-- entails excluded middle. For a proposition, finiteness is decidability.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; open Logic[l] ;
module F = FiniteSets[l] ;
module Proposition (P : U l) (prop : isProp P) {
  decide-size : (n : Nat) -> Equiv (Fin n) P -> Dec P = split {
    zero -> \ e -> no (\ p -> e.2.sec p) ;
    suc n -> \ e -> yes (e.1 none) } ;
  decide : F.Finite P -> Dec P = TC.rec ((n : Nat) * Equiv (Fin n) P) @l (Dec P)
    (dec-prop P prop) (\ w -> decide-size w.1 w.2) ;
  single (p : P) : Fin (suc zero) -> P = split { none -> p ; some x -> absurd P x } ;
  at-zero : (i : Fin (suc zero)) -> Id (Fin (suc zero)) none i = split { none -> refl none ; some x -> absurd (Id (Fin (suc zero)) none (some x)) x } ;
  singleton (p : P) : Equiv (Fin (suc zero)) P = (single p,qinv _ _ (single p) (\ x -> none) (prop p) at-zero) ;
  empty (h : P -> Empty) : Equiv (Fin zero) P = (absurd P,qinv _ _ (absurd P) h
    (\ p -> absurd (Id P (absurd P (h p)) p) (h p)) (\ x -> absurd (Id Empty (h (absurd P x)) x) x)) ;
  finite : Dec P -> F.Finite P = split {
    yes p -> F.enumerated P (suc zero) (singleton p) ;
    no h -> F.enumerated P zero (empty h) } ;
  equivalence : Equiv (F.Finite P) (Dec P) = (decide,qinv _ _ decide finite
    (\ d -> dec-prop P prop _ _) (\ w -> T.Trunc[(n : Nat) * Equiv (Fin n) P].proposition _ _)) ;
} ;
finite-unit : F.Finite Top = Proposition[Top,isTop].finite (yes tt) ;
AllSubsetsFinite : U l+ = (A : U l) -> F.Finite A -> (P : A -> U l) -> ((x : A) -> isProp (P x)) -> F.Finite ((x : A) * P x) ;
excluded-middle (all : AllSubsetsFinite) (P : U l) (prop : isProp P) : Dec P =
  TC.rec ((n : Nat) * Equiv (Fin n) ((t : Top) * P)) @l (Dec P) (dec-prop P prop)
    (\ w -> Proposition[P,prop].decide-size w.1 (Equivalences[l].compose _ _ _ w.2
      ((\ v -> v.2),qinv ((t : Top) * P) P (\ v -> v.2) (\ p -> (tt,p)) (\ p -> refl p)
        (\ v -> ap Top ((t : Top) * P) (\ t -> (t,v.2)) tt v.1 (isTop tt v.1)))))
    (all Top finite-unit (\ t -> P) (\ t -> prop)) ;
