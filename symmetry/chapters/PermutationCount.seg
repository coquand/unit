-- Count bijections by picking the image of none and restricting to its complement.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ; open Logic[l] ;
module C = Cardinality[l] ; module E = Equivalences[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ; module F = FiniteCounting[l] ;
ext (A B : U l) (f g : Equiv A B) (h : (x : A) -> Id B (f.1 x) (g.1 x)) : Id (Equiv A B) f g = ChapterTwo[l].equiv-ext A B f g h ;
module Split (A Y : U l) (discrete : FiniteDecisions[l].Discrete Y) {
  module O = C.Option[A] ; label : U l = (y : Y) * Equiv A (C.delete Y y) ;
  module Tail (e : Equiv (Opt A) Y) {
    o : Y = e.1 none ;
    P (z : Opt A) : U l = Id (Opt A) z none -> Empty ;
    Q (y : Y) : U l = Id Y y o -> Empty ;
    eq (z : Opt A) : Equiv (P z) (Q (e.1 z)) = Bijection[l].prop-equiv _ _ (not-prop (Id (Opt A) z none)) (not-prop (Id Y (e.1 z) o))
      (\ k p -> k (E.injective _ _ e.1 e.2 z none p)) (\ k p -> k (apH e.1 p)) ;
    restrict : Equiv A (C.delete Y o) = E.compose _ _ _ O.equiv (E.compose _ _ _
      (Fibres[l].sigma-equiv (Opt A) P (\ z -> Q (e.1 z)) eq) (ChapterTwo[l].change-base _ _ e Q)) ;
  } ;
  take (e : Equiv (Opt A) Y) : label = (e.1 none,Tail[e].restrict) ;
  module Add (y : Y) (d : Equiv A (C.delete Y y)) {
    put : Opt A -> Y = split { none -> y ; some a -> (d.1 a).1 } ;
    pick (z : Y) : Dec (Id Y z y) -> Opt A = split { yes q -> none ; no k -> some (d.2.sec (z,k)) } ;
    beta (z : Y) : (v : Dec (Id Y z y)) -> Id Y (put (pick z v)) z = split { yes q -> symH q ;
      no k -> ap (C.delete Y y) Y (\ t -> t.1) _ _ (d.2.sec-eq (z,k)) } ;
    at-y : (v : Dec (Id Y y y)) -> Id (Opt A) (pick y v) none = split { yes q -> refl none ; no k -> absurd _ (k (refl y)) } ;
    other (a : A) : (v : Dec (Id Y (d.1 a).1 y)) -> Id (Opt A) (pick (d.1 a).1 v) (some a) = split {
      yes q -> absurd _ ((d.1 a).2 q) ; no k -> ap A (Opt A) (\ v -> some v) (d.2.sec ((d.1 a).1,k)) a
        (transH (ap (C.delete Y y) A d.2.sec ((d.1 a).1,k) (d.1 a) (Sigma-eq Y (\ z -> Id Y z y -> Empty) _ _ k (d.1 a).2 (refl (d.1 a).1) (not-prop (Id Y (d.1 a).1 y)))) (sec-ret _ _ d.1 d.2 a)) } ;
    eta : (z : Opt A) -> Id (Opt A) (pick (put z) (discrete (put z) y)) z = split { none -> at-y (discrete y y) ; some a -> other a (discrete (d.1 a).1 y) } ;
    equiv : Equiv (Opt A) Y = (put,qinv _ _ put (\ z -> pick z (discrete z y)) (\ z -> beta z (discrete z y)) eta) ;
    ret : Id label (take equiv) (y,d) = ap (Equiv A (C.delete Y y)) label (\ t -> (y,t)) _ d
      (ext _ _ (Tail[equiv].restrict) d (\ a -> Sigma-eq Y (\ z -> Id Y z y -> Empty) _ _ _ _ (refl (d.1 a).1) (not-prop _))) ;
  } ;
  add (w : label) : Equiv (Opt A) Y = Add[w.1,w.2].equiv ;
  eta (e : Equiv (Opt A) Y) : (z : Opt A) -> Id Y ((add (take e)).1 z) (e.1 z) = split { none -> refl (e.1 none) ; some a -> refl (e.1 (some a)) } ;
  equivalence : Equiv (Equiv (Opt A) Y) label = (take,qinv _ _ take add (\ w -> Add[w.1,w.2].ret) (\ e -> ext _ _ _ e (eta e))) ;
} ;
perms (n : Nat) : U l = Equiv (Fin n) (Fin n) ;
module Step (n : Nat) {
  X : U l = Fin (suc n) ; module S = Split[Fin n,X,FiniteDecisions[l].standard (suc n)] ;
  change (Y : U l) (e : Equiv (Fin n) Y) : Equiv (perms n) (Equiv (Fin n) Y) =
    Axioms[l].UnivalenceLemmas[univ @l].eqind (Fin n) (\ Z d -> Equiv (perms n) (Equiv (Fin n) Z)) (idEquiv (perms n)) Y e ;
  labels : Equiv (X * perms n) (perms (suc n)) = E.compose _ _ _ (Fibres[l].sigma-equiv X (\ i -> perms n) (\ i -> Equiv (Fin n) (C.delete X i))
    (\ i -> change _ C.Puncture[n,i].equiv)) (Bijection[l].inverse _ _ S.equivalence) ;
} ;
factorial : Nat -> Nat = split { zero -> suc zero ; suc n | r -> F.times (suc n) r } ;
empty-prop : isProp (perms zero) = isProp-Sigma (Empty -> Empty) (isEquiv Empty Empty) (FL.isProp-Pi Empty (\ i -> Empty) (\ i -> isProp-Empty)) (EquivProp[l].isEquiv-prop Empty Empty) ;
module Induction (n : Nat) (e : Equiv (Fin (factorial n)) (perms n)) {
  k : Nat = suc n ;
  raw : Equiv (Fin (F.sum k (\ i -> factorial n))) (Fin k * perms n) = F.enumerate k (\ i -> factorial n) (\ i -> perms n) (\ i -> e) ;
  block : Equiv (Fin (factorial k)) (Fin k * perms n) = subst Nat (\ m -> Equiv (Fin m) (Fin k * perms n)) _ _ (F.constant k (factorial n)) raw ;
} ;
enumeration : (n : Nat) -> Equiv (Fin (factorial n)) (perms n) = split {
  zero -> FiniteSubsets[l].Proposition[perms zero,empty-prop].singleton (idEquiv Empty) ;
  suc n | r -> E.compose _ _ _ Induction[n,r].block Step[n].labels } ;
