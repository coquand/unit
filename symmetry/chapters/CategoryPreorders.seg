-- Sections 6.2, 6.3 and 6.5. Antisymmetry and Galois connections.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module K = WildCategory[o,h] ;
module On (C : K.Wild) (thin : (x y : C.ob) -> isProp (C.hom x y)) {
  iso-prop (x y : C.ob) : isProp (C.iso x y) =
    isProp-Sigma (C.hom x y) (\ f -> WildIsos[o,h].At[C,x,y,f].data-inv) (thin x y) (\ f -> WildIsos[o,h].At[C,x,y,f].prop) ;
  objects-set (u : C.univalent) (x y : C.ob) : isProp (Id C.ob x y) =
    retract-prop _ _ (C.idtoiso x y) (u x y).sec (sec-ret _ _ _ (u x y)) (iso-prop x y) ;
  antisymmetric (u : C.univalent) (x y : C.ob) (f : C.hom x y) (g : C.hom y x) : Id C.ob x y =
    (u x y).sec (f,(g,thin y y _ _),g,thin x x _ _) ;
  univalent (s : isSet C.ob) (antisym : (x y : C.ob) -> C.hom x y -> C.hom y x -> Id C.ob x y) : C.univalent =
    \ x y -> qinv _ _ (C.idtoiso x y) (\ i -> antisym x y i.1 i.2.1.1) (\ i -> iso-prop x y _ _) (\ p -> s x y _ _) ;
  post-embedding (x y z : C.ob) (f : C.hom y z) (g k : C.hom x y) :
    isEquiv (Id (C.hom x y) g k) (Id (C.hom x z) (C.comp _ _ _ f g) (C.comp _ _ _ f k))
      (ap (C.hom x y) (C.hom x z) (C.comp x y z f) g k) =
    qinv _ _ _ (\ p -> thin x y g k) (\ p -> prop-to-set _ (thin x z) _ _ _ _) (\ p -> prop-to-set _ (thin x y) _ _ _ _) ;
  pre-embedding (x y z : C.ob) (f : C.hom x y) (g k : C.hom y z) :
    isEquiv (Id (C.hom y z) g k) (Id (C.hom x z) (C.comp _ _ _ g f) (C.comp _ _ _ k f))
      (ap (C.hom y z) (C.hom x z) (\ t -> C.comp x y z t f) g k) =
    qinv _ _ _ (\ p -> thin y z g k) (\ p -> prop-to-set _ (thin x z) _ _ _ _) (\ p -> prop-to-set _ (thin y z) _ _ _ _) ;
} ;
module Galois (C D : K.Wild) (c : (x y : C.ob) -> isProp (C.hom x y)) (d : (x y : D.ob) -> isProp (D.hom x y))
  (F : WildFunctors[o,h,o,h].Map[C,D]) (G : WildFunctors[o,h,o,h].Map[D,C]) {
  module M = Adjunctions[o,h,o,h].Wild[C,D,F,G] ;
  iff : U (o \/ h) = (x : C.ob) (y : D.ob) ->
    (D.hom (F.obj x) y -> C.hom x (G.obj y)) * (C.hom x (G.obj y) -> D.hom (F.obj x) y) ;
  from (k : iff) : M.Adjunction = new M.Adjunction[\ x y -> ((k x y).1,Prelude[h].qinv _ _ (k x y).1 (k x y).2
    (\ f -> c x (G.obj y) _ _) (\ f -> d (F.obj x) y _ _)),\ x w y u v -> c w (G.obj y) _ _,\ x y z v u -> c x (G.obj z) _ _] ;
  to (k : M.Adjunction) : iff = \ x y -> ((k.transpose x y).1,(k.transpose x y).2.sec) ;
} ;
module Make (O : U o) (le : O -> O -> U h) (thin : (x y : O) -> isProp (le x y))
  (r : (x : O) -> le x x) (t : (x y z : O) -> le x y -> le y z -> le x z) {
  pre : K.Wild = new K.Wild[O,le,r,\ x y z g f -> t x y z f g,\ x y f -> thin x y _ f,\ x y f -> thin x y _ f,
    \ w x y z f g k -> thin w z _ _] ;
  module Order = On[pre,thin] ;
} ;
module Monotone (C D : K.Wild) (thin : (x y : D.ob) -> isProp (D.hom x y)) {
  module F = WildFunctors[o,h,o,h] ; module E = F.Ext[C,D,\ x y -> prop-to-set _ (thin x y)] ;
  map : U (o \/ h) = (g : C.ob -> D.ob) * E.At[g].arrows ;
  from (v : map) : F.Map[C,D] = E.At[v.1].build (v.2,(\ x -> thin _ _ _ _),\ x y z g f -> thin _ _ _ _) ;
  to (f : F.Map[C,D]) : map = (f.obj,f.map) ;
  equiv : Equiv (F.Map[C,D]) map = (to,qinv _ _ to from (\ s -> refl s) (\ f -> transH
    (E.At[f.obj].equal (f.map,(\ x -> thin _ _ _ _),\ x y z g k -> thin _ _ _ _) (f.map,f.map-idn,f.map-comp) (refl f.map)) (E.eta f))) ;
} ;
