-- Section 6.5. The left adjoint on sets takes the set truncation of each dependent sum.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module F = WildFunctors[l+,l,l+,l] ; module Adj = Adjunctions[l+,l,l+,l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module H = HLevels[l] ;
module Along (A B : U l) (f : A -> B) {
  module SA = SetFamilies[l].Over[A] ; module SB = SetFamilies[l].Over[B] ;
  module V = FamilyAdjunctions[l].Along[A,B,f] ;
  module R = TruncationAdjunction[l].Higher[suc zero].R ;
  C : WildCategory[l+,l].Wild = WildCategory[l+,l].forget SA.pre ;
  D : WildCategory[l+,l].Wild = WildCategory[l+,l].forget SB.pre ;
  pull (Y : SB.family) (a : A) : CategoryOfSets[l].ob = Y (f a) ;
  reindex : F.Map[D,C] = new F.Map[D,C,pull,\ X Y u a -> u (f a),\ X -> refl (C.idn (pull X)),\ X Y Z g k -> refl (\ a x -> g (f a) (k (f a) x))] ;
  pi (X : SA.family) (b : B) : CategoryOfSets[l].ob = (V.prod (\ a -> (X a).1) b,
    FL.isSet-Pi A (\ a -> Id B (f a) b -> (X a).1) (\ a -> FL.isSet-Pi (Id B (f a) b) (\ p -> (X a).1) (\ p -> (X a).2))) ;
  product : F.Map[C,D] = new F.Map[C,D,pi,\ X Y -> V.prod-map (\ a -> (X a).1) (\ a -> (Y a).1),
    \ X -> refl (D.idn (pi X)),\ X Y Z g k -> refl (\ b s a p -> g a (k a (s a p)))] ;
  module PA = Adj.Wild[D,C,reindex,product] ;
  product-adjunction : PA.Adjunction = new PA.Adjunction[\ Y X -> V.Product[(\ b -> (Y b).1),(\ a -> (X a).1)].equiv,
    \ Y Z X -> V.product-adjunction.pre (\ b -> (Y b).1) (\ b -> (Z b).1) (\ a -> (X a).1),
    \ Y X Z -> V.product-adjunction.post (\ b -> (Y b).1) (\ a -> (X a).1) (\ a -> (Z a).1)] ;
  raw (X : SA.family) : B -> U l = V.sum (\ a -> (X a).1) ;
  sum (X : SA.family) (b : B) : CategoryOfSets[l].ob = ((R.object (raw X b)).1,H.trunc-set _ (R.object (raw X b)).2) ;
  on (X Y : SA.family) (u : C.hom X Y) (b : B) : (sum X b).1 -> (sum Y b).1 =
    R.map (raw X b) (raw Y b) (V.sum-map (\ a -> (X a).1) (\ a -> (Y a).1) u b) ;
  sigma : F.Map[C,D] = new F.Map[C,D,sum,on,
    \ X -> FL.funext B (\ b -> (sum X b).1 -> (sum X b).1) _ _ (\ b -> R.identity (raw X b)),
    \ X Y Z g k -> FL.funext B (\ b -> (sum X b).1 -> (sum Z b).1) _ _ (\ b -> R.comp (raw X b) (raw Y b) (raw Z b)
      (V.sum-map (\ a -> (Y a).1) (\ a -> (Z a).1) g b) (V.sum-map (\ a -> (X a).1) (\ a -> (Y a).1) k b))] ;
  module Pair (X : SA.family) (Y : SB.family) {
    module S = V.Sum[(\ a -> (X a).1),(\ b -> (Y b).1)] ;
    module At (b : B) { module I = R.Into[raw X b,((Y b).1,H.set-trunc _ (Y b).2)] ; } ;
    pre (k : D.hom (sum X) Y) : V.T.hom (raw X) (\ b -> (Y b).1) = \ b -> (At[b].I.equiv).1 (k b) ;
    equiv : Equiv (D.hom (sum X) Y) (C.hom X (pull Y)) = EquivalenceLemmas[l].then _ _ _
      (pre,qinv _ _ pre (\ g b -> At[b].I.equiv.2.sec (g b))
        (\ g -> FL.funext B (\ b -> raw X b -> (Y b).1) _ _ (\ b -> At[b].I.equiv.2.sec-eq (g b)))
        (\ k -> FL.funext B (\ b -> (sum X b).1 -> (Y b).1) _ _ (\ b -> sec-ret _ _ _ At[b].I.equiv.2 (k b)))) S.equiv ;
  } ;
  module LA = Adj.Wild[C,D,sigma,reindex] ;
  sum-adjunction : LA.Adjunction = new LA.Adjunction[\ X Y -> Pair[X,Y].equiv,
    \ X Z Y u v -> FL.funext A (\ a -> (Z a).1 -> (Y (f a)).1) _ _ (\ a -> FL.funext (Z a).1 (\ z -> (Y (f a)).1) _ _
      (\ z -> apH (v (f a)) (R.beta (raw Z (f a)) (raw X (f a)) (V.sum-map (\ i -> (Z i).1) (\ i -> (X i).1) u (f a)) (a,refl (f a),z)))),
    \ X Y Z v u -> refl (\ a z -> u (f a) (Pair[X,Y].equiv.1 v a z))] ;
} ;
-- Specialize the functors to the group actions of Chapter 5.
module GroupActions (G K : ChapterFour[l].ConcreteGroup) (p : ChapterFour[l].Hom G K) {
  module I = InducedActions[l].Along[G,K,p] ; module A = Along[G.space,K.space,p.1] ;
  restriction (Y : I.AH.GSet) : Id I.AG.GSet (A.reindex.obj Y) (I.restrict Y) = refl (I.restrict Y) ;
  induction (X : I.AG.GSet) : Id I.AH.GSet (A.sigma.obj X) (I.induce X) = refl (I.induce X) ;
  coinduction (X : I.AG.GSet) : Id I.AH.GSet (A.product.obj X) (I.coinduce X) = refl (I.coinduce X) ;
} ;
