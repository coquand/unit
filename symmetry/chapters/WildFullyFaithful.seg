-- Section 6.7. A fully faithful functor from a category into a wild
-- precategory has propositional fibres up to isomorphism.
level a b c d ; open Base ; open Prelude[a \/ b \/ c \/ d] ; open Paths[a \/ b \/ c \/ d] ;
module V = WildCategory[a,b] ; module W = WildCategory[c,d] ; module F = WildFunctors[a,b,c,d] ;
module H = Prelude[b \/ d] ; module N = Prelude[d] ;
module On (C : Category[a,b].Category) (D : W.Wild) (f : F.Map[V.forget C.pre,D])
  (ff : F.Between[V.forget C.pre,D].Action[f].fully-faithful) {
  -- Keep explicit witnesses when restricting to the objects isomorphic to images.
  ob : U (a \/ c \/ d) = (x : C.pre.ob) * (y : D.ob) * D.iso (f.obj x) y ;
  include (x : C.pre.ob) : ob = (x,f.obj x,D.ident (f.obj x)) ;
  target (s : ob) : D.ob = s.2.1 ;
  image : WildCategory[a \/ c \/ d,d].Wild = new WildCategory[a \/ c \/ d,d].Wild[ob,
    (\ s t -> D.hom (target s) (target t)),(\ s -> D.idn (target s)),(\ s t u -> D.comp (target s) (target t) (target u)),
    (\ s t -> D.unit-l (target s) (target t)),(\ s t -> D.unit-r (target s) (target t)),(\ r s t u -> D.assoc (target r) (target s) (target t) (target u))] ;
  module Pair (s t : ob) {
    module I = WildIsos[c,d].At[D,f.obj s.1,target s,s.2.2.1].Inverse[s.2.2.2] ;
    module J = WildIsos[c,d].At[D,f.obj t.1,target t,t.2.2.1].Inverse[t.2.2.2] ;
    rel (A B : U (b \/ d)) (e : H.Equiv A B) (set : H.isSet A) : H.isSet B =
      HLevels[b \/ d].trunc-set B (HLevels[b \/ d].equiv-trunc' (suc (suc zero)) A B e (HLevels[b \/ d].set-trunc A set)) ;
    from-base : H.isSet (D.hom (f.obj s.1) (f.obj t.1)) = rel _ _ (f.map s.1 t.1,ff s.1 t.1) (C.pre.hom-set s.1 t.1) ;
    back (A B : U d) (e : N.Equiv A B) (sb : N.isSet B) : N.isSet A =
      HLevels[d].trunc-set A (HLevels[d].equiv-trunc (suc (suc zero)) A B e (HLevels[d].set-trunc B sb)) ;
    set : N.isSet (image.hom s t) = back _ _ (I.pre (target t)) (back _ _
      (EquivalenceLemmas[d].inverse _ _ (J.post (f.obj s.1))) from-base) ;
  } ;
  module P = WildIsos[a \/ c \/ d,d].HomSets[image,\ s t -> Pair[s,t].set] ;
  module G = Functor[a,b,a \/ c \/ d,d] ;
  embed : G.Functor[C.pre,P.pre] = new G.Functor[C.pre,P.pre,include,f.map,f.map-idn,f.map-comp] ;
  module S = FullyFaithful[a,b,a \/ c \/ d,d,a \/ b \/ c \/ d].IntoPrecategory[C,P.pre,embed,ff] ;
  fiber (y : D.ob) : U (a \/ d) = (x : C.pre.ob) * D.iso (f.obj x) y ;
  module At (y : D.ob) (v : fiber y) {
    t : ob = (v.1,y,v.2) ;
    pack (w : fiber y) : S.S t = (w.1,P.AtPair[include w.1,t].to w.2) ;
    unpack (w : S.S t) : fiber y = (w.1,P.AtPair[include w.1,t].from w.2) ;
    ret (w : fiber y) : Id (fiber y) (unpack (pack w)) w = ap (D.iso (f.obj w.1) y) (fiber y) (\ i -> (w.1,i)) _ _
      (Sigma-eq (D.hom (f.obj w.1) y) (\ g -> WildIsos[c,d].At[D,f.obj w.1,y,g].data-inv) _ _ _ _ (refl w.2.1) WildIsos[c,d].At[D,f.obj w.1,y,w.2.1].prop) ;
  } ;
  prop (y : D.ob) : isProp (fiber y) = \ v w -> retract-prop (fiber y) (S.S At[y,v].t) At[y,v].pack At[y,v].unpack At[y,v].ret (S.S-prop At[y,v].t) v w ;
} ;
