-- Section 2.27. The set of components of a fibre is exactly what
-- passage from the set image to the propositional image forgets.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module T = Truncation[l] ; module H = HLevels[l] ;
module At (A B : U l) (f : A -> B) {
  fibre (b : B) : U l = (a : A) * Id B (f a) b ;
  mere (b : B) : U l = T.Trunc[fibre b].carrier ;
  module SetPart (b : B) { module S = ChapterTwo[l].Truncate[suc zero,fibre b] ;
    module Collapse = S.Into[\ z -> mere b,\ z -> H.prop-trunc (suc zero) (mere b) T.Trunc[fibre b].proposition] ;
    forget : S.carrier -> mere b = Collapse.extend T.Trunc[fibre b].inc ;
  } ;
  parts (b : B) : U l = SetPart[b].S.carrier ;
  set-image : U l = (b : B) * parts b ; image : U l = (b : B) * mere b ;
  compare (w : set-image) : image = (w.1,SetPart[w.1].forget w.2) ;
  module Sub = ChapterTwo[l].Subtype[B,mere,\ b -> T.Trunc[fibre b].proposition] ;
  over (w : image) : Equiv ((z : set-image) * Id image (compare z) w) (parts w.1) = Equivalences[l].compose _ _ _
    (Fibres[l].sigma-equiv set-image (\ z -> Id image (compare z) w) (\ z -> Id B z.1 w.1)
      (\ z -> Sub.At[compare z].paths w)) ChapterTwo[l].Projection[B,parts,w.1].equivalence ;
} ;
module Stages (A B : U l) (f : A -> B) {
  module I = At[A,B,f] ; module Tt = FamilyClassifier[l].Over[B].Total[(A,f)] ;
  first (w : Tt.total) : I.set-image = (w.1,I.SetPart[w.1].S.unit w.2) ;
  member (w : I.set-image) : U l = (t : Tt.total) * Id I.set-image (first t) w ;
  part (w : I.set-image) : U l = (z : I.fibre w.1) * Id (I.parts w.1) (I.SetPart[w.1].S.unit z) w.2 ;
  include (w : I.set-image) (z : part w) : member w = ((w.1,z.1),apH (\ t -> (w.1,t)) z.2) ;
  at (b : B) (z : I.fibre b) (w : I.set-image) (p : Id I.set-image (first (b,z)) w) : part w =
    idJ I.set-image (first (b,z)) (\ w q -> part w) (z,refl (I.SetPart[b].S.unit z)) w p ;
  extract (w : I.set-image) (m : member w) : part w = at m.1.1 m.1.2 w m.2 ;
  section (b : B) (z : I.fibre b) (w : I.set-image) (p : Id I.set-image (first (b,z)) w) : Id (member w) (include w (at b z w p)) ((b,z),p) =
    idJ I.set-image (first (b,z)) (\ t q -> Id (member t) (include t (at b z t q)) ((b,z),q))
      (refl ((b,z),refl (first (b,z)))) w p ;
  retract (b : B) (z : I.fibre b) (s : I.parts b) (p : Id (I.parts b) (I.SetPart[b].S.unit z) s) :
    Id (part (b,s)) (extract (b,s) (include (b,s) (z,p))) (z,p) = idJ (I.parts b) (I.SetPart[b].S.unit z)
      (\ v q -> Id (part (b,v)) (extract (b,v) (include (b,v) (z,q))) (z,q)) (refl (z,refl (I.SetPart[b].S.unit z))) s p ;
  equivalence (w : I.set-image) : Equiv (member w) (part w) = (extract w,qinv _ _ (extract w) (include w)
    (\ z -> retract w.1 z.1 w.2 z.2) (\ m -> section m.1.1 m.1.2 w m.2)) ;
  connected (w : I.set-image) : ConnectedLaws[l].conn (member w) =
    Deloop[l].equiv-conn (suc (suc zero)) _ _ (equivalence w) (I.SetPart[w.1].S.op.conn (I.fibre w.1) w.2) ;
  middle-set (w : I.image) : isSet ((z : I.set-image) * Id I.image (I.compare z) w) =
    H.trunc-set _ (H.equiv-trunc (suc (suc zero)) _ _ (I.over w) (I.SetPart[w.1].S.op.trunc (I.fibre w.1))) ;
  middle-inhabited (w : I.image) : T.Trunc[(z : I.set-image) * Id I.image (I.compare z) w].carrier =
    TruncationCombinators[l].map (I.fibre w.1) ((z : I.set-image) * Id I.image (I.compare z) w)
      (\ z -> (I.over w).2.sec (I.SetPart[w.1].S.unit z)) w.2 ;
} ;
