-- Section 6.4. Univalence of the wild category of precategories and functors.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module K = Category[o,h] ; module W = WildCategory[o,h] ; module F = WildFunctors[o,h,o,h] ;
module FC = FunctorComposition[o,h] ; module P = Prelude[o] ; module B = Prelude[o+ \/ h+] ; module BP = Paths[o+ \/ h+] ;
category : WildCategory[o+ \/ h+,o \/ h].Wild = FC.precats ;
base (C : K.Precategory) : U o = C.ob * C.ob ;
arrows (C : K.Precategory) (w : base C) : U h = C.hom w.1 w.2 ;
total-hom (C : K.Precategory) : U (o \/ h) = (w : base C) * arrows C w ;
module Action (C D : K.Precategory) (f : category.hom C D) {
  endpoints (w : base C) : base D = (f.obj w.1,f.obj w.2) ;
  total (v : total-hom C) : total-hom D = (endpoints v.1,f.map v.1.1 v.1.2 v.2) ;
} ;
module From (C : K.Precategory) {
  module I = CategoryIdentity[o,h].From[C] ;
  module Pair (D : K.Precategory) {
    underlying (e : I.iso D) : category.hom C D = new F.Map[W.forget C,W.forget D,e.1.1,(\ x y -> (e.2.1 x y).1),e.2.2.1,\ x y z g k -> e.2.2.2 x y z k g] ;
    module Given (i : category.iso C D) {
      f : category.hom C D = i.1 ; g : category.hom D C = i.2.1.1 ;
      module X = WildIsos[o+ \/ h+,o \/ h].At[category,C,D,f].Inverse[i.2] ;
      module A = Action[C,D,f] ; module R = Action[D,C,g] ;
      left (y : D.ob) : Id D.ob (f.obj (g.obj y)) y = apH (\ t -> t.obj y) i.2.1.2 ;
      right (x : C.ob) : Id C.ob (g.obj (f.obj x)) x = apH (\ t -> t.obj x) X.gf ;
      obj : P.Equiv C.ob D.ob = (f.obj,P.qinv _ _ f.obj g.obj left right) ;
      base-equiv : Equiv (base C) (base D) = (A.endpoints,qinv _ _ A.endpoints R.endpoints
        (\ w -> transH (ap D.ob (base D) (\ y -> (y,f.obj (g.obj w.2))) _ _ (left w.1)) (ap D.ob (base D) (\ y -> (w.1,y)) _ _ (left w.2)))
        (\ w -> transH (ap C.ob (base C) (\ x -> (x,g.obj (f.obj w.2))) _ _ (right w.1)) (ap C.ob (base C) (\ x -> (w.1,x)) _ _ (right w.2)))) ;
      total-equiv : isEquiv (total-hom C) (total-hom D) A.total = qinv _ _ A.total R.total
        (\ w -> ap (category.hom D D) (total-hom D) (\ t -> Action[D,D,t].total w) _ _ i.2.1.2)
        (\ w -> ap (category.hom C C) (total-hom C) (\ t -> Action[C,C,t].total w) _ _ X.gf) ;
      module Sq = FibrewiseEquivalence[o \/ h].Square[base C,base D,base-equiv,(\ w -> arrows C w),(\ w -> arrows D w),(\ w -> f.map w.1 w.2)] ;
      strict : I.iso D = (obj,(\ x y -> (f.map x y,EquivalenceLemmas[h].lower @o _ _ _ (Sq.at total-equiv (x,y)))),
        f.map-idn,\ x y z k g1 -> f.map-comp x y z g1 k) ;
    } ;
  } ;
  agrees (D : K.Precategory) (p : Id K.Precategory C D) : Id (category.hom C D)
    (category.idtoiso C D p).1 (Pair[D].underlying ((I.equality D).1 p)) =
    idJ K.Precategory C (\ Z q -> Id (category.hom C Z) (category.idtoiso C Z q).1 (Pair[Z].underlying ((I.equality Z).1 q)))
      (refl (category.idn C)) D p ;
  total : U (o+ \/ h+) = (D : K.Precategory) * category.iso C D ;
  lift (w : I.total) : total = (w.1,category.idtoiso C w.1 ((I.equality w.1).2.sec w.2)) ;
  module Back (D : K.Precategory) (i : category.iso C D) {
    module G = Pair[D].Given[i] ;
    p : Id K.Precategory C D = (I.equality D).2.sec G.strict ;
    equality : Id (category.hom C D) (category.idtoiso C D p).1 i.1 = transH (agrees D p)
      (transH (apH Pair[D].underlying ((I.equality D).2.sec-eq G.strict)) (FC.eta (W.forget C) (W.forget D) i.1)) ;
    iso-path : Id (category.iso C D) (category.idtoiso C D p) i = Sigma-eq (category.hom C D)
      (\ f -> WildIsos[o+ \/ h+,o \/ h].At[category,C,D,f].data-inv) _ _ _ _ equality WildIsos[o+ \/ h+,o \/ h].At[category,C,D,i.1].prop ;
    contract : Id total (lift I.center) (D,i) = BP.transH (BP.apH lift (I.contract D G.strict))
      (B.ap (category.iso C D) total (\ j -> (D,j)) _ _ iso-path) ;
  } ;
  module FT = FundThm[o+ \/ h+].FT[K.Precategory,C,(\ D -> category.iso C D),category.ident C,(lift I.center,\ w -> Back[w.1,w.2].contract)] ;
  compute (D : K.Precategory) (p : Id K.Precategory C D) : Id (category.iso C D) (FT.tr D p) (category.idtoiso C D p) =
    idJ K.Precategory C (\ Z q -> Id (category.iso C Z) (FT.tr Z q) (category.idtoiso C Z q)) (refl (category.ident C)) D p ;
} ;
univalent : category.univalent = \ C D -> EquivalenceLemmas[o+ \/ h+].homotopy _ _ _ _ (From[C].compute D) (From[C].FT.equiv D) ;
univalence-prop (C : K.Precategory) : isProp (K.Univalent C) = \ u -> CategorySIP[o,h].Proofs[new K.Category[C,u]].univalence-prop u ;
module Categories = FullSubcategory[o+ \/ h+,o \/ h,o \/ h].On[category,K.Univalent,univalence-prop] ;
categories-univalent : Categories.sub.univalent = Categories.univalent univalent ;
