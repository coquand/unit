-- Exercise 6.8.6. All four corner types have independent levels.
level a b c d ; open Base ; open Prelude[a \/ b \/ c \/ d] ;
module Span (B : U b) (C : U c) (D : U d) (f : B -> D) (g : C -> D) {
  pullback : U (b \/ c \/ d) = (y : B) * (z : C) * Id D (f y) (g z) ;
  module From (A : U a) {
    legs : U (a \/ b \/ c) = (A -> B) * (A -> C) ;
    equality (p : legs) : U (a \/ d) = Id (A -> D) (\ x -> f (p.1 x)) (\ x -> g (p.2 x)) ;
    homotopy (p : legs) : U (a \/ d) = (x : A) -> Id D (f (p.1 x)) (g (p.2 x)) ;
    square : U (a \/ b \/ c \/ d) = (p : legs) * equality p ;
    pointwise : U (a \/ b \/ c \/ d) = (p : legs) * homotopy p ;
    evaluate (w : pointwise) (x : A) : pullback = (w.1.1 x,w.1.2 x,w.2 x) ;
    restrict (h : A -> pullback) : pointwise = ((\ x -> (h x).1,\ x -> (h x).2.1),\ x -> (h x).2.2) ;
    maps : Equiv pointwise (A -> pullback) = (evaluate,qinv _ _ evaluate restrict (\ h -> refl h) (\ w -> refl w)) ;
    path (p : legs) : Equiv (equality p) (homotopy p) = (happly A (\ x -> D) _ _,
      fe @(a \/ b \/ c \/ d) A (\ x -> D) _ _) ;
    universal : Equiv square (A -> pullback) = Equivalences[a \/ b \/ c \/ d].compose _ _ _
      (Fibres[a \/ b \/ c \/ d].sigma-equiv legs (\ p -> equality p) (\ p -> homotopy p) path) maps ;
    is-pullback-square (w : square) : U (a \/ b \/ c \/ d) = isEquiv A pullback (universal.1 w) ;
  } ;
} ;
module Point (C : U c) (D : U d) (g : C -> D) (y : D) {
  module S = Span[Top,C,D,\ t -> y,g] ;
  fiber : U (c \/ d) = (x : C) * Id D y (g x) ;
  insert (v : fiber) : S.pullback = (tt,v) ;
  eta (v : S.pullback) : Id S.pullback (insert v.2) v = ap Top S.pullback (\ t -> (t,v.2)) tt v.1 (isTop tt v.1) ;
  example : Equiv S.pullback fiber = (\ w -> w.2,qinv _ _ (\ w -> w.2) insert (\ w -> refl w) eta) ;
} ;
