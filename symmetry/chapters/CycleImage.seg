-- Theorem 3.9.13. The quotient X/m of infinite cycles factors through the
-- standard m-cycle component: q (X,t) = (X/m,[t]) is 0-connected and the
-- underlying set map r on m-cycles is 0-truncated.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module LB = LoopConj[l+] ; module LC = LoopConj[l] ;
module CC = CycleComponents[l] ; module I = InfiniteCycle[l] ; module RC = RootCircle[l] ;
module Z = Integers[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Cn = Connected[l] ; module Sets = CircleBundles[l] ; module II = IntegerIteration[l] ;
module W = Whitehead[l] ; module WB = Whitehead[l+] ;
-- Paths in the small component of a permutation u, and transport around loops.
module In (u : CC.Perm) {
  module C = CC.Component[u] ;
  P0 : CC.Perm = C.show C.pt ;
  k : Id CC.Perm P0 u = C.C.path-at-point ;
  sh (x y : C.space) (p : Id C.space x y) : Id CC.Perm (C.show x) (C.show y) = Big.ap C.space CC.Perm C.show x y p ;
  actC (x y : C.space) (p : Id C.space x y) (t : (C.show x).1.1) : (C.show y).1.1 = RC.act (C.show x) (C.show y) (sh x y p) t ;
  actC-trans (x y : C.space) (p : Id C.space x y) (z : C.space) (q : Id C.space y z) (t : (C.show x).1.1) :
    Id (C.show z).1.1 (actC x z (trans C.space x y z p q) t) (actC y z q (actC x y p t)) =
    idJ C.space y (\ w r -> Id (C.show w).1.1 (actC x w (trans C.space x y w p r) t) (actC y w r (actC x y p t)))
      (refl (actC x y p t)) z q ;
  actC-sym (x y : C.space) (p : Id C.space x y) : (t : (C.show y).1.1) ->
    Id (C.show x).1.1 (actC y x (sym C.space x y p) t) (RC.act (C.show y) (C.show x) (Big.sym CC.Perm (C.show x) (C.show y) (sh x y p)) t) =
    idJ C.space x (\ w r -> (s : (C.show w).1.1) -> Id (C.show x).1.1 (actC w x (sym C.space x w r) s)
      (RC.act (C.show w) (C.show x) (Big.sym CC.Perm (C.show x) (C.show w) (sh x w r)) s)) (\ s -> refl s) y p ;
  label (b : u.1.1) (q : Id C.space C.pt C.pt) : u.1.1 = RC.act u u (LB.conj CC.Perm P0 u k (sh C.pt C.pt q)) b ;
  start (b : u.1.1) : P0.1.1 = RC.act u P0 (Big.sym CC.Perm P0 u k) b ;
  label-unfold (b : u.1.1) (q : Id C.space C.pt C.pt) : Id u.1.1 (label b q) (RC.act P0 u k (actC C.pt C.pt q (start b))) =
    transH (RC.act-trans u P0 (Big.sym CC.Perm P0 u k) u (Big.trans CC.Perm P0 P0 u (sh C.pt C.pt q) k) b)
      (RC.act-trans P0 P0 (sh C.pt C.pt q) u k (start b)) ;
} ;
-- A map of permutations sending u to w (along base) restricts to the components.
-- Its effect on loops is computed from a natural map g : x -> F x.
module Lift (u w : CC.Perm) (F : CC.Perm -> CC.Perm) (base : Id CC.Perm (F u) w)
  (g : (x : CC.Perm) -> x.1.1 -> (F x).1.1)
  (nat : (x y : CC.Perm) (p : Id CC.Perm x y) (t : x.1.1) ->
    Id (F y).1.1 (RC.act (F x) (F y) (Big.ap CC.Perm CC.Perm F x y p) (g x t)) (g y (RC.act x y p t)))
  (nat-sym : (x y : CC.Perm) (p : Id CC.Perm x y) (t : y.1.1) ->
    Id (F x).1.1 (RC.act (F y) (F x) (Big.sym CC.Perm (F x) (F y) (Big.ap CC.Perm CC.Perm F x y p)) (g y t)) (g x (RC.act y x (Big.sym CC.Perm x y p) t))) {
  module A = In[u] ; module B = In[w] ;
  fibre (v : CC.Perm) : U l+ = (x : B.C.space) * Id CC.Perm (B.C.show x) v ;
  fibre-prop (v : CC.Perm) : Big.isProp (fibre v) = Groupoid[l+].emb-fib-prop B.C.space CC.Perm B.C.show B.C.C.image.embedding v ;
  reach (z : A.C.space) (p : Id A.C.space A.C.pt z) : fibre (F (A.C.show z)) = (B.C.pt,Big.trans CC.Perm _ _ _ B.k
    (Big.trans CC.Perm _ _ _ (Big.sym CC.Perm (F u) w base) (Big.ap CC.Perm CC.Perm F u (A.C.show z)
      (Big.trans CC.Perm _ _ _ (Big.sym CC.Perm A.P0 u A.k) (A.sh A.C.pt z p))))) ;
  lift (z : A.C.space) : fibre (F (A.C.show z)) = TC.rec (Id A.C.space A.C.pt z) @(l+) (fibre (F (A.C.show z)))
    (fibre-prop (F (A.C.show z))) (reach z) (A.C.reaches z) ;
  map (z : A.C.space) : B.C.space = (lift z).1 ;
  e (z : A.C.space) : Id CC.Perm (B.C.show (map z)) (F (A.C.show z)) = (lift z).2 ;
  Pm : CC.Perm = B.C.show (map A.C.pt) ;
  tail : Id CC.Perm (F A.P0) B.P0 = Big.trans CC.Perm _ _ _ (Big.ap CC.Perm CC.Perm F A.P0 u A.k)
    (Big.trans CC.Perm _ _ _ base (Big.sym CC.Perm B.P0 w B.k)) ;
  at-point : Id CC.Perm Pm B.P0 = Big.trans CC.Perm _ _ _ (e A.C.pt) tail ;
  pointing : Id B.C.space (map A.C.pt) B.C.pt = (B.C.C.image.embedding (map A.C.pt) B.C.pt).sec at-point ;
  pointing-sh : Id (Id CC.Perm Pm B.P0) (B.sh (map A.C.pt) B.C.pt pointing) at-point =
    (B.C.C.image.embedding (map A.C.pt) B.C.pt).sec-eq at-point ;
  natural (x y : A.C.space) (p : Id A.C.space x y) (t : (B.C.show (map x)).1.1) :
    Id (B.C.show (map y)).1.1 (B.actC (map x) (map y) (ap A.C.space B.C.space map x y p) t)
      (RC.act (F (A.C.show y)) (B.C.show (map y)) (Big.sym CC.Perm _ _ (e y)) (RC.act (F (A.C.show x)) (F (A.C.show y))
        (Big.ap CC.Perm CC.Perm F _ _ (A.sh x y p)) (RC.act (B.C.show (map x)) (F (A.C.show x)) (e x) t))) =
    idJ A.C.space x (\ z r -> Id (B.C.show (map z)).1.1 (B.actC (map x) (map z) (ap A.C.space B.C.space map x z r) t)
      (RC.act (F (A.C.show z)) (B.C.show (map z)) (Big.sym CC.Perm _ _ (e z)) (RC.act (F (A.C.show x)) (F (A.C.show z))
        (Big.ap CC.Perm CC.Perm F _ _ (A.sh x z r)) (RC.act (B.C.show (map x)) (F (A.C.show x)) (e x) t))))
      (symH (RC.act-back (B.C.show (map x)) (F (A.C.show x)) (e x) t)) y p ;
  image-loop (q : Id A.C.space A.C.pt A.C.pt) : Id B.C.space B.C.pt B.C.pt =
    LC.conj B.C.space (map A.C.pt) B.C.pt pointing (ap A.C.space B.C.space map A.C.pt A.C.pt q) ;
  module Labels (b0 : u.1.1) (c0 : w.1.1) (hit : Id w.1.1 (RC.act (F u) w base (g u b0)) c0) {
    inner : Id (F u).1.1 (RC.act w (F u) (Big.sym CC.Perm _ _ base) (RC.act B.P0 w (Big.sym CC.Perm _ _ (Big.sym CC.Perm _ _ B.k)) (B.start c0))) (g u b0) =
      transH (apH (RC.act w (F u) (Big.sym CC.Perm _ _ base)) (RC.act-back w B.P0 (Big.sym CC.Perm _ _ B.k) c0))
        (transH (apH (RC.act w (F u) (Big.sym CC.Perm _ _ base)) (symH hit)) (RC.act-back (F u) w base (g u b0))) ;
    tail-back : Id (F A.P0).1.1 (RC.act B.P0 (F A.P0) (Big.sym CC.Perm _ _ tail) (B.start c0)) (g A.P0 (A.start b0)) =
      transH (RC.act-sym-trans (F A.P0) (F u) (Big.ap CC.Perm CC.Perm F A.P0 u A.k) B.P0 (Big.trans CC.Perm _ _ _ base (Big.sym CC.Perm _ _ B.k)) (B.start c0))
        (transH (apH (RC.act (F u) (F A.P0) (Big.sym CC.Perm _ _ (Big.ap CC.Perm CC.Perm F A.P0 u A.k))) (RC.act-sym-trans (F u) w base B.P0 (Big.sym CC.Perm _ _ B.k) (B.start c0)))
          (transH (apH (RC.act (F u) (F A.P0) (Big.sym CC.Perm _ _ (Big.ap CC.Perm CC.Perm F A.P0 u A.k))) inner) (nat-sym A.P0 u A.k b0))) ;
    s1 : Pm.1.1 = RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt)) (g A.P0 (A.start b0)) ;
    step-in : Id Pm.1.1 (B.actC B.C.pt (map A.C.pt) (sym B.C.space _ _ pointing) (B.start c0)) s1 =
      transH (B.actC-sym (map A.C.pt) B.C.pt pointing (B.start c0))
        (transH (Big.ap (Id CC.Perm Pm B.P0) Pm.1.1 (\ p -> RC.act B.P0 Pm (Big.sym CC.Perm _ _ p) (B.start c0)) _ _ pointing-sh)
          (transH (RC.act-sym-trans Pm (F A.P0) (e A.C.pt) B.P0 tail (B.start c0)) (apH (RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt))) tail-back))) ;
    step-loop (q : Id A.C.space A.C.pt A.C.pt) : Id Pm.1.1 (B.actC (map A.C.pt) (map A.C.pt) (ap A.C.space B.C.space map A.C.pt A.C.pt q) s1)
      (RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt)) (g A.P0 (A.actC A.C.pt A.C.pt q (A.start b0)))) =
      transH (natural A.C.pt A.C.pt q s1) (apH (RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt)))
        (transH (apH (RC.act (F A.P0) (F A.P0) (Big.ap CC.Perm CC.Perm F _ _ (A.sh A.C.pt A.C.pt q))) (RC.act-forth Pm (F A.P0) (e A.C.pt) (g A.P0 (A.start b0))))
          (nat A.P0 A.P0 (A.sh A.C.pt A.C.pt q) (A.start b0)))) ;
    step-out (a : A.P0.1.1) : Id B.P0.1.1 (B.actC (map A.C.pt) B.C.pt pointing (RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt)) (g A.P0 a)))
      (RC.act w B.P0 (Big.sym CC.Perm _ _ B.k) (RC.act (F u) w base (g u (RC.act A.P0 u A.k a)))) =
      transH (Big.ap (Id CC.Perm Pm B.P0) B.P0.1.1 (\ p -> RC.act Pm B.P0 p (RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt)) (g A.P0 a))) _ _ pointing-sh)
        (transH (RC.act-trans Pm (F A.P0) (e A.C.pt) B.P0 tail (RC.act (F A.P0) Pm (Big.sym CC.Perm _ _ (e A.C.pt)) (g A.P0 a)))
          (transH (apH (RC.act (F A.P0) B.P0 tail) (RC.act-forth Pm (F A.P0) (e A.C.pt) (g A.P0 a)))
            (transH (RC.act-trans (F A.P0) (F u) (Big.ap CC.Perm CC.Perm F A.P0 u A.k) B.P0 (Big.trans CC.Perm _ _ _ base (Big.sym CC.Perm _ _ B.k)) (g A.P0 a))
              (transH (apH (RC.act (F u) B.P0 (Big.trans CC.Perm _ _ _ base (Big.sym CC.Perm _ _ B.k))) (nat A.P0 u A.k a))
                (RC.act-trans (F u) w base B.P0 (Big.sym CC.Perm _ _ B.k) (g u (RC.act A.P0 u A.k a))))))) ;
    -- The label of the image loop is read off from the label of the loop.
    image-label (q : Id A.C.space A.C.pt A.C.pt) : Id w.1.1 (B.label c0 (image-loop q)) (RC.act (F u) w base (g u (A.label b0 q))) =
      transH (B.label-unfold c0 (image-loop q))
        (transH (apH (RC.act B.P0 w B.k) (B.actC-trans B.C.pt (map A.C.pt) (sym B.C.space _ _ pointing) B.C.pt
            (trans B.C.space _ _ _ (ap A.C.space B.C.space map A.C.pt A.C.pt q) pointing) (B.start c0)))
          (transH (apH (RC.act B.P0 w B.k) (B.actC-trans (map A.C.pt) (map A.C.pt) (ap A.C.space B.C.space map A.C.pt A.C.pt q) B.C.pt pointing
              (B.actC B.C.pt (map A.C.pt) (sym B.C.space _ _ pointing) (B.start c0))))
            (transH (apH (\ t -> RC.act B.P0 w B.k (B.actC (map A.C.pt) B.C.pt pointing (B.actC (map A.C.pt) (map A.C.pt) (ap A.C.space B.C.space map A.C.pt A.C.pt q) t))) step-in)
              (transH (apH (\ t -> RC.act B.P0 w B.k (B.actC (map A.C.pt) B.C.pt pointing t)) (step-loop q))
                (transH (apH (RC.act B.P0 w B.k) (step-out (A.actC A.C.pt A.C.pt q (A.start b0))))
                  (transH (RC.act-forth B.P0 w B.k _) (apH (\ a -> RC.act (F u) w base (g u a)) (symH (A.label-unfold b0 q))))))))) ;
  } ;
} ;
-- (r . (p . r^-1))^-1 . p = r, by induction on r.
cancel-loop (Y : U l) (x y : Y) (r : Id Y x y) : (p : Id Y x y) ->
  Id (Id Y x y) (trans Y x x y (sym Y x x (trans Y x y x p (sym Y x y r))) p) r =
  idJ Y x (\ z r1 -> (p : Id Y x z) -> Id (Id Y x z) (trans Y x x z (sym Y x x (trans Y x z x p (sym Y x z r1))) p) r1)
    (\ p -> trans-sym-l Y x x p) y r ;
module Degree (n : Nat) {
  -- The induced permutation of X/m.
  module Bar (v : CC.Perm) {
    module V = CycleQuotient[l].At[n,v] ; module Q = V.Q ;
    t : Equiv V.X V.X = v.2 ;
    module Fw = II.Map[V.X,V.X,t,t,t.1,\ x -> refl (t.1 (t.1 x))] ;
    back-law (x : V.X) : Id V.X (t.2.sec (t.1 x)) (t.1 (t.2.sec x)) = transH (sec-ret V.X V.X t.1 t.2 x) (symH (t.2.sec-eq x)) ;
    module Bw = II.Map[V.X,V.X,t,t,t.2.sec,back-law] ;
    forward (x y : V.X) (w : V.witness x y) : V.witness (t.1 x) (t.1 y) = (w.1,w.2.1,transH (symH (Fw.at x w.1)) (apH t.1 w.2.2)) ;
    backward (x y : V.X) (w : V.witness x y) : V.witness (t.2.sec x) (t.2.sec y) = (w.1,w.2.1,transH (symH (Bw.at x w.1)) (apH t.2.sec w.2.2)) ;
    module Next = Q.Descend[Q.Q,Q.set,\ x -> Q.inc (t.1 x),\ x y r -> Q.relates _ _ (TC.map _ _ (forward x y) r)] ;
    module Prev = Q.Descend[Q.Q,Q.set,\ x -> Q.inc (t.2.sec x),\ x y r -> Q.relates _ _ (TC.map _ _ (backward x y) r)] ;
    next-prev (c : Q.Q) : Id Q.Q (Next.map (Prev.map c)) c = Q.induction @l (\ d -> Id Q.Q (Next.map (Prev.map d)) d) (\ d -> Q.set _ d)
      (\ x -> transH (apH Next.map (Prev.beta x)) (transH (Next.beta (t.2.sec x)) (apH Q.inc (t.2.sec-eq x)))) c ;
    prev-next (c : Q.Q) : Id Q.Q (Prev.map (Next.map c)) c = Q.induction @l (\ d -> Id Q.Q (Prev.map (Next.map d)) d) (\ d -> Q.set _ d)
      (\ x -> transH (apH Prev.map (Next.beta x)) (transH (Prev.beta (t.1 x)) (apH Q.inc (sec-ret V.X V.X t.1 t.2 x)))) c ;
    bar : CC.Perm = ((Q.Q,Q.set),(Next.map,qinv Q.Q Q.Q Next.map Prev.map next-prev prev-next)) ;
  } ;
  F (v : CC.Perm) : CC.Perm = Bar[v].bar ;
  g (v : CC.Perm) (x : v.1.1) : (F v).1.1 = Bar[v].Q.inc x ;
  nat (x y : CC.Perm) (p : Id CC.Perm x y) (t : x.1.1) :
    Id (F y).1.1 (RC.act (F x) (F y) (Big.ap CC.Perm CC.Perm F x y p) (g x t)) (g y (RC.act x y p t)) =
    idJ CC.Perm x (\ z r -> Id (F z).1.1 (RC.act (F x) (F z) (Big.ap CC.Perm CC.Perm F x z r) (g x t)) (g z (RC.act x z r t))) (refl (g x t)) y p ;
  nat-sym (x y : CC.Perm) (p : Id CC.Perm x y) : (t : y.1.1) ->
    Id (F x).1.1 (RC.act (F y) (F x) (Big.sym CC.Perm (F x) (F y) (Big.ap CC.Perm CC.Perm F x y p)) (g y t)) (g x (RC.act y x (Big.sym CC.Perm x y p) t)) =
    idJ CC.Perm x (\ z r -> (t : z.1.1) -> Id (F x).1.1 (RC.act (F z) (F x) (Big.sym CC.Perm (F x) (F z) (Big.ap CC.Perm CC.Perm F x z r)) (g z t))
      (g x (RC.act z x (Big.sym CC.Perm x z r) t))) (\ t -> refl (g x t)) y p ;
  -- The quotient map out of the component of any cycle whose periods m divides.
  module Quot (u' : CC.Perm) (cyc : CycleRootFibres[l].ConnectedPermutation[u'].cycle)
    (cond : CycleQuotient[l].At[n,u'].condition) (x0 : u'.1.1) {
    wm : CC.Perm = CC.Finite[n].standard ;
    module St = FiniteCycles[l].Standard[n] ; module V0 = CycleQuotient[l].At[n,u'] ;
    module Count = RootClassification[l].At[n,u'].Cycle[cyc.1,cyc.2] ;
    module E = Count.Based[cond,x0] ;
    module B0 = Bar[u'] ;
    commutes (c : B0.Q.Q) : Id St.A (E.Dsc.map (B0.Next.map c)) (St.step (E.Dsc.map c)) =
      B0.Q.induction @l (\ d -> Id St.A (E.Dsc.map (B0.Next.map d)) (St.step (E.Dsc.map d))) (\ d -> FiniteCycles[l].fin-set (suc n) _ _)
        (\ y -> transH (apH E.Dsc.map (B0.Next.beta y)) (transH (E.Dsc.beta (u'.2.1 y))
          (transH (E.O.step y) (apH St.step (symH (E.Dsc.beta y)))))) c ;
    iso-q : CC.From[F u'].Iso wm = (Bijection[l].inverse _ _ E.quotient-enumeration,commutes) ;
    std-q : Id CC.Perm (F u') wm = CC.From[F u'].IdSystem.un wm iso-q ;
    act-std-q (c : B0.Q.Q) : Id St.A (RC.act (F u') wm std-q c) (E.Dsc.map c) =
      Big.ap (CC.From[F u'].Iso wm) St.A (\ h -> h.1.1 c) _ _ (CC.From[F u'].IdSystem.tr-un wm iso-q) ;
    hit : Id St.A (RC.act (F u') wm std-q (g u' x0)) none =
      transH (act-std-q (g u' x0)) (transH (E.Dsc.beta x0) E.O.zero-law) ;
    module L = Lift[u',wm,F,std-q,g,nat,nat-sym] ; module LL = L.Labels[x0,none,hit] ;
    module C0 = L.A.C ; module Cm = L.B.C ;
    q (z : C0.space) : Cm.space = L.map z ;
    -- r is 0-truncated and r q is the quotient map.
    r (w : Cm.space) : Sets.Set = (Cm.show w).1 ;
    quotient (z : C0.space) : Sets.Set = (F (C0.show z)).1 ;
    factor (z : C0.space) : Id Sets.Set (r (q z)) (quotient z) = Big.ap CC.Perm Sets.Set (\ v -> v.1) _ _ (L.e z) ;
    module Truncated (S : Sets.Set) {
      fibre : U l+ = WB.fib Cm.space Sets.Set r S ;
      over : U l+ = WB.fib CC.Perm Sets.Set (\ v -> v.1) S ;
      pieces : U l+ = (y : over) * L.fibre y.1 ;
      divide (w : fibre) : pieces = ((Cm.show w.1,w.2),(w.1,refl (Cm.show w.1))) ;
      join (y : pieces) : fibre = (y.2.1,Big.trans Sets.Set _ _ _ (Big.ap CC.Perm Sets.Set (\ v -> v.1) _ _ y.2.2) y.1.2) ;
      join-divide (w : fibre) : Id fibre (join (divide w)) w =
        Big.ap (Id Sets.Set (r w.1) S) fibre (\ e -> (w.1,e)) _ _ (Big.trans-refl-l Sets.Set _ _ w.2) ;
      divide-join (y : pieces) : Id pieces (divide (join y)) y =
        idJ CC.Perm (Cm.show y.2.1) (\ v s -> (p : Id Sets.Set v.1 S) -> Id pieces (divide (join ((v,p),(y.2.1,s)))) ((v,p),(y.2.1,s)))
          (\ p -> Big.ap (Id Sets.Set (r y.2.1) S) pieces (\ e -> ((Cm.show y.2.1,e),(y.2.1,refl (Cm.show y.2.1)))) _ _
            (Big.trans-refl-l Sets.Set _ _ p)) y.1.1 y.2.2 y.1.2 ;
      over-set : Big.isSet over = HLevels[l+].trunc-set over (HLevels[l+].equiv-trunc (suc (suc zero)) over (Sets.Aut S)
        ChapterTwo[l+].Projection[Sets.Set,\ X -> Sets.Aut X,S].equivalence (HLevels[l+].set-trunc (Sets.Aut S) (Sets.equivalences-are-set S S))) ;
      pieces-set : Big.isSet pieces = Big.isSet-Sigma over (\ y -> L.fibre y.1) over-set (\ y -> Big.prop-to-set _ (L.fibre-prop y.1)) ;
      set : Big.isSet fibre = HLevels[l+].trunc-set fibre (HLevels[l+].equiv-trunc (suc (suc zero)) fibre pieces
        (divide,Big.qinv fibre pieces divide join divide-join join-divide) (HLevels[l+].set-trunc pieces pieces-set)) ;
    } ;
  } ;
  -- The standard infinite cycle goes to the standard m-cycle.
  u0 : CC.Perm = I.standard ;
  module R = InfiniteRootBundles[l].Degree[n] ;
  module Inf = Quot[u0,InfiniteRootBundles[l].cycle,R.period,Z.zeroZ] ; open Inf ;
  -- Loops: the label k of an infinite cycle goes to the class of k.
  labm : Equiv (Id Cm.space Cm.pt Cm.pt) St.A =
    Equivalences[l].compose _ _ _ PermutationLoops[l].At[wm].encode FiniteCycles[l].Centralizer[n].symmetries ;
  lab0 : Equiv (Id C0.space C0.pt C0.pt) Z.Int = InfiniteCycleCircle[l].label ;
  loop-class (d : Id C0.space C0.pt C0.pt) : Id St.A (labm.1 (L.image-loop d)) (E.Dsc.map (B0.Q.inc (lab0.1 d))) =
    transH (LL.image-label d) (act-std-q (g u0 (lab0.1 d))) ;
  surjective (ell : Id Cm.space Cm.pt Cm.pt) : (d : Id C0.space C0.pt C0.pt) * Id (Id Cm.space Cm.pt Cm.pt) (L.image-loop d) ell =
    (lab0.2.sec (V0.A.N.power (E.rank (labm.1 ell)) Z.zeroZ),
     Equivalences[l].injective _ _ labm.1 labm.2 _ _ (transH (loop-class (lab0.2.sec (V0.A.N.power (E.rank (labm.1 ell)) Z.zeroZ)))
       (transH (apH (\ b -> E.Dsc.map (B0.Q.inc b)) (lab0.2.sec-eq (V0.A.N.power (E.rank (labm.1 ell)) Z.zeroZ))) (E.reads (labm.1 ell))))) ;
  -- q is 0-connected.
  fib (y : Cm.space) : U l = W.fib C0.space Cm.space q y ;
  centre : fib Cm.pt = (C0.pt,L.pointing) ;
  module Centre (p : Id Cm.space (q C0.pt) Cm.pt) {
    ell : Id Cm.space Cm.pt Cm.pt = LC.conj Cm.space (q C0.pt) Cm.pt L.pointing (trans Cm.space _ _ _ p (sym Cm.space _ _ L.pointing)) ;
    d : Id C0.space C0.pt C0.pt = (surjective ell).1 ;
    on-d : Id (Id Cm.space (q C0.pt) (q C0.pt)) (ap C0.space Cm.space q C0.pt C0.pt d) (trans Cm.space _ _ _ p (sym Cm.space _ _ L.pointing)) =
      transH (symH (LC.conj-back Cm.space (q C0.pt) Cm.pt L.pointing (ap C0.space Cm.space q C0.pt C0.pt d)))
        (transH (apH (LC.conj Cm.space Cm.pt (q C0.pt) (sym Cm.space _ _ L.pointing)) (surjective ell).2)
          (LC.conj-back Cm.space (q C0.pt) Cm.pt L.pointing (trans Cm.space _ _ _ p (sym Cm.space _ _ L.pointing)))) ;
    path : Id (fib Cm.pt) (C0.pt,p) centre = Sigma-path C0.space (\ x -> Id Cm.space (q x) Cm.pt) C0.pt C0.pt p L.pointing d
      (transH (Groupoid[l].transport-fib C0.space Cm.space q Cm.pt C0.pt C0.pt d p)
        (transH (apH (\ r -> trans Cm.space _ _ _ (sym Cm.space _ _ r) p) on-d) (cancel-loop Cm.space (q C0.pt) Cm.pt L.pointing p))) ;
  } ;
  to-centre (a : fib Cm.pt) : T.Trunc[Id (fib Cm.pt) a centre].carrier =
    TC.rec (Id C0.space C0.pt a.1) @l _ T.Trunc[Id (fib Cm.pt) a centre].proposition
      (\ c -> idJ C0.space C0.pt (\ z r -> (p : Id Cm.space (q z) Cm.pt) -> T.Trunc[Id (fib Cm.pt) (z,p) centre].carrier)
        (\ p -> T.Trunc[Id (fib Cm.pt) (C0.pt,p) centre].inc Centre[p].path) a.1 c a.2) (C0.reaches a.1) ;
  connected-at-point : Cn.isConn (suc (suc zero)) (fib Cm.pt) = (T.Trunc[fib Cm.pt].inc centre,\ a b ->
    (TC.map2 (Id (fib Cm.pt) a centre) (Id (fib Cm.pt) b centre) (Id (fib Cm.pt) a b) (\ x y -> trans (fib Cm.pt) a centre b x (sym (fib Cm.pt) b centre y)) (to-centre a) (to-centre b),\ x y -> tt)) ;
  connected (y : Cm.space) : Cn.isConn (suc (suc zero)) (fib y) = TC.rec (Id Cm.space Cm.pt y) @l _
    (Cn.conn-prop (suc (suc zero)) (fib y))
    (\ p -> subst Cm.space (\ y1 -> Cn.isConn (suc (suc zero)) (fib y1)) Cm.pt y p connected-at-point) (Cm.reaches y) ;
  -- Theorem 3.9.13: the 0-image of _/m : Cyc_0 -> Set is the component of the
  -- standard m-cycle, with q and r as the two maps of the factorization.
  module Image = ZeroImage[l+].Comparison[C0.space,Cm.space,Sets.Set,quotient,q,r,factor,
    \ y -> UniverseChange[l,l+].connected (suc (suc zero)) (fib y) (connected y),
    \ S -> HLevels[l+].set-trunc Truncated[S].fibre Truncated[S].set] ;
  zero-image : Big.Equiv Image.Im.space Cm.space = Image.equivalence ;
  zero-image-q (z : C0.space) : Id Cm.space (zero-image.1 (Image.Im.quotient z)) (q z) = Image.left z ;
  zero-image-r (w : Image.Im.space) : Id Sets.Set (r (zero-image.1 w)) w.1 = Image.right w ;
} ;
