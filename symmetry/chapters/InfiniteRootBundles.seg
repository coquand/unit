-- Every fibre over an infinite cycle merely has m elements. The equivalence
-- with its quotient by m-step orbits is canonical; numbering it uses a point.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module I = InfiniteCycle[l] ; module C = I.Component ; module CC = CycleComponents[l] ;
module Z = Integers[l] ; module L = Torsor[l].AbL[Z.intAb] ;
module Big = Prelude[l+] ; module E = Equivalences[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module A = IntegerIteration[l].Orbit[Z.Int,I.shift] ;
translate (x k : Z.Int) : Id Z.Int (Z.add x k) (A.power k x) = A.Unique[x,Z.add x,refl x,Z.add-sucR x].at k ;
module Standard = CycleRootFibres[l].ConnectedPermutation[I.standard] ;
cycle : Standard.cycle = (T.Trunc[Z.Int].inc Z.zeroZ,\ x y -> T.Trunc[Standard.walk x y].inc
  (Z.add (Z.neg x) y,transH (symH (translate x (Z.add (Z.neg x) y))) (transH (symH (Z.assoc x (Z.neg x) y))
    (transH (apH (\ a -> Z.add a y) (Z.invr x)) (Z.zero-l y))))) ;
module Degree (n : Nat) {
  module D = CycleDivision[l].Degree[n] ; module R = CycleRootFibres[l].Degree[n] ;
  module V = CycleQuotient[l].At[n,I.standard] ;
  period : V.condition = \ k h -> apH D.residue (transH (symH (Z.zero-l k)) (transH (translate Z.zeroZ k) (h Z.zeroZ))) ;
  conditions (v : CC.Perm) : U l = CycleRootFibres[l].ConnectedPermutation[v].cycle * CycleQuotient[l].At[n,v].condition ;
  at (z : C.space) : conditions (C.show z) = TC.rec (Id C.space C.pt z) @l _
    (isProp-Sigma (CycleRootFibres[l].ConnectedPermutation[C.show z].cycle) (\ h -> CycleQuotient[l].At[n,C.show z].condition)
      CycleRootFibres[l].ConnectedPermutation[C.show z].prop (\ h -> CycleQuotient[l].At[n,C.show z].proposition))
    (\ p -> Big.subst CC.Perm (\ v -> conditions v) I.standard (C.show z)
      (Big.trans _ _ _ _ (Big.sym _ _ _ C.C.path-at-point) (Big.ap C.space CC.Perm C.show C.pt z p)) (cycle,period)) (C.reaches z) ;
  module Over (z : C.space) {
    v : CC.Perm = C.show z ;
    module Q = CycleQuotient[l].At[n,v] ;
    module H = R.Over[(v,(at z).1)] ;
    d : Q.subgroup-inclusion = Q.inclusion (at z).2 ;
    quotient : U l = Q.Q.Q ;
    remove : Equiv H.small quotient = (\ w -> w.2,qinv H.small quotient (\ w -> w.2) (\ q -> (d,q))
      (\ q -> refl q) (\ w -> ap Q.subgroup-inclusion H.small (\ p -> (p,w.2)) _ _ (Q.inclusion-prop d w.1))) ;
    fibre : Big.Equiv H.fibre quotient = Equivalences[l+].compose _ _ _ H.classification (UniverseChange[l+,l].raise-equiv _ _ remove) ;
    enumerate (x : v.1.1) : Equiv (Fin D.m) quotient = H.Count.Based[(at z).2,x].quotient-enumeration ;
    size : T.Trunc[Equiv (Fin D.m) quotient].carrier = TC.map v.1.1 _ enumerate (at z).1.1 ;
  } ;
  -- Euclidean division conjugates the formal root of successor to successor.
  standard-iso : CC.From[R.rho I.standard].Iso I.standard =
    (Bijection[l].inverse _ _ D.coordinates,D.next) ;
  standard-path : Id CC.Perm (R.rho I.standard) I.standard = CC.From[R.rho I.standard].IdSystem.un I.standard standard-iso ;
} ;
