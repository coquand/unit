-- Section 5.2. Examples of G-sets, maps of G-sets, G-subsets, finiteness,
-- transitivity, injectivity of evaluation and normality.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module HL = HLevels[l] ;
PropAt : U l+ = (P : U l) * isProp P ;
isProp-isProp (P : U l) : isProp (isProp P) = \ a b ->
  FL.funext P (\ x -> (y : P) -> Id P x y) a b (\ x -> FL.funext P (\ y -> Id P x y) (a x) (b x)
    (\ y -> prop-to-set P a x y (a x y) (b x y))) ;
-- Propositional extensionality, from univalence.
prop-path (P Q : PropAt) (f : P.1 -> Q.1) (g : Q.1 -> P.1) : Id PropAt P Q =
  Big.Sigma-eq (U l) (\ A -> isProp A) _ _ _ _
    (Axioms[l].UnivalenceLemmas[univ @l].ua P.1 Q.1 (Bijection[l].prop-equiv P.1 Q.1 P.2 Q.2 f g)) (isProp-isProp Q.1) ;
module Over (G : CG.ConcreteGroup) {
  module Act = ChapterFive[l,l].Actions[G] ;
  el (X : Act.GSet) (z : G.space) : U l = (X z).1 ;
  act (X : Act.GSet) (z w : G.space) (g : Id G.space z w) (x : el X z) : el X w = subst G.space (el X) z w g x ;
  -- Examples 5.2.2, 5.2.4 and 5.2.5.
  trivial (S : Act.SetAt) : Act.GSet = \ z -> S ;
  principal : Act.GSet = ChapterFive[l,l].Principal[G].action ;
  adjoint : Act.GSet = \ z -> (Id G.space z z,HL.trunc-set _ (G.groupoid z z)) ;
  adjoint-acts (z w : G.space) (g : Id G.space z w) (p : Id G.space z z) :
    Id (Id G.space w w) (act adjoint z w g p) (LoopConj[l].conj G.space z w g p) =
    idJ G.space z (\ w1 g1 -> Id (Id G.space w1 w1) (act adjoint z w1 g1 p) (LoopConj[l].conj G.space z w1 g1 p))
      (symH (LoopConj[l].conj-refl-loop G.space z p)) w g ;
  -- Example 5.2.6: pointed maps from BH to BG pointed at a varying point.
  homs (H : CG.ConcreteGroup) : Act.GSet = \ y -> (Lemma4[l].PtMap H.space H.point G.space y,
    HL.trunc-set _ (Lemma4[l].cor5-map CG.two (suc zero) H.space H.point H.connected G.space y G.groupoid)) ;
  -- Definition 5.2.8 and Exercise 5.2.9.
  Hom (X Y : Act.GSet) : U l = (z : G.space) -> el X z -> el Y z ;
  Hom-set (X Y : Act.GSet) : isSet (Hom X Y) = FL.isSet-Pi G.space (\ z -> el X z -> el Y z)
    (\ z -> FL.isSet-Pi (el X z) (\ x -> el Y z) (\ x -> (Y z).2)) ;
  total (X : Act.GSet) : U l = (z : G.space) * el X z ;
  Fibred (X Y : Act.GSet) : U l = (f : total X -> total Y) * Id (total X -> G.space) (\ w -> w.1) (\ w -> (f w).1) ;
  module Totalization (X Y : Act.GSet) {
    to (h : Hom X Y) : Fibred X Y = (\ w -> (w.1,h w.1 w.2),refl (\ w -> w.1)) ;
    from (F : Fibred X Y) : Hom X Y = \ z x -> subst G.space (el Y) _ z
      (sym G.space z _ (happly (total X) (\ w -> G.space) _ _ F.2 (z,x))) (F.1 (z,x)).2 ;
    move (g : total X -> G.space) (p : Id (total X -> G.space) (\ w -> w.1) g) : (k : (w : total X) -> el Y (g w)) ->
      Id (Fibred X Y) (to (from ((\ w -> (g w,k w)),p))) ((\ w -> (g w,k w)),p) =
      idJ (total X -> G.space) (\ w -> w.1) (\ g1 p1 -> (k : (w : total X) -> el Y (g1 w)) ->
        Id (Fibred X Y) (to (from ((\ w -> (g1 w,k w)),p1))) ((\ w -> (g1 w,k w)),p1))
        (\ k -> refl (to (from ((\ w -> (w.1,k w)),refl (\ w -> w.1))))) g p ;
    equivalence : Equiv (Hom X Y) (Fibred X Y) = (to,qinv _ _ to from
      (\ F -> move (\ w -> (F.1 w).1) F.2 (\ w -> (F.1 w).2)) (\ h -> refl h)) ;
  } ;
  -- Remark 5.2.10.
  equivariant (X Y : Act.GSet) (f : Hom X Y) (z w : G.space) (g : Id G.space z w) (x : el X z) :
    Id (el Y w) (f w (act X z w g x)) (act Y z w g (f z x)) =
    idJ G.space z (\ w1 g1 -> Id (el Y w1) (f w1 (act X z w1 g1 x)) (act Y z w1 g1 (f z x))) (refl (f z x)) w g ;
  -- Definition 5.2.11 and Exercise 5.2.12.
  SubG (X : Act.GSet) : U l+ = (z : G.space) -> el X z -> PropAt ;
  underlying (X : Act.GSet) (P : SubG X) : Act.GSet = \ z -> ((x : el X z) * (P z x).1,
    isSet-Sigma (el X z) (\ x -> (P z x).1) (X z).2 (\ x -> prop-to-set _ (P z x).2)) ;
  module Subsets (X : Act.GSet) {
    pt : G.space = G.point ;
    closed : U l+ = (Q : el X pt -> PropAt) * ((x : el X pt) (g : Id G.space pt pt) -> (Q x).1 -> (Q (act X pt pt g x)).1) ;
    carry (P : SubG X) (z : G.space) (x : el X z) (w : G.space) (g : Id G.space z w) : (P z x).1 -> (P w (act X z w g x)).1 =
      idJ G.space z (\ w1 g1 -> (P z x).1 -> (P w1 (act X z w1 g1 x)).1) (\ h -> h) w g ;
    evaluate (P : SubG X) : closed = (P pt,\ x g -> carry P pt x pt g) ;
    extend (Q : closed) : SubG X = \ z x -> ((p : Id G.space pt z) -> (Q.1 (act X z pt (sym G.space pt z p) x)).1,
      FL.isProp-Pi (Id G.space pt z) (\ p -> (Q.1 (act X z pt (sym G.space pt z p) x)).1) (\ p -> (Q.1 (act X z pt (sym G.space pt z p) x)).2)) ;
    back-to (x : el X pt) (w : G.space) (p : Id G.space pt w) :
      Id (el X pt) (act X w pt (sym G.space pt w p) (act X pt w p x)) x =
      idJ G.space pt (\ w1 p1 -> Id (el X pt) (act X w1 pt (sym G.space pt w1 p1) (act X pt w1 p1 x)) x) (refl x) w p ;
    closed-prop (Q : el X pt -> PropAt) : Big.isProp ((x : el X pt) (g : Id G.space pt pt) -> (Q x).1 -> (Q (act X pt pt g x)).1) =
      Axioms[l+].FunExtLemmas[fe @(l+)].isProp-Pi (el X pt) (\ x -> (g : Id G.space pt pt) -> (Q x).1 -> (Q (act X pt pt g x)).1)
        (\ x -> FL.isProp-Pi (Id G.space pt pt) (\ g -> (Q x).1 -> (Q (act X pt pt g x)).1)
          (\ g -> FL.isProp-Pi (Q x).1 (\ h -> (Q (act X pt pt g x)).1) (\ h -> (Q (act X pt pt g x)).2))) ;
    eval-extend (Q : closed) : Id closed (evaluate (extend Q)) Q = Big.Sigma-eq (el X pt -> PropAt)
      (\ R -> (x : el X pt) (g : Id G.space pt pt) -> (R x).1 -> (R (act X pt pt g x)).1) _ _ _ _
      (Axioms[l+].FunExtLemmas[fe @(l+)].funext (el X pt) (\ x -> PropAt) _ _ (\ x -> prop-path _ _
        (\ h -> h (refl pt)) (\ h p -> Q.2 x (sym G.space pt pt p) h))) (closed-prop Q.1) ;
    extend-eval (P : SubG X) : Id (SubG X) (extend (evaluate P)) P =
      Axioms[l+].FunExtLemmas[fe @(l+)].funext G.space (\ z -> el X z -> PropAt) _ _ (\ z ->
        Axioms[l+].FunExtLemmas[fe @(l+)].funext (el X z) (\ x -> PropAt) _ _ (\ x -> prop-path _ _
          (\ h -> TC.rec (Id G.space pt z) @l _ (P z x).2 (\ p -> subst (el X z) (\ y -> (P z y).1) _ x
            (idJ G.space pt (\ w1 p1 -> (y : el X w1) -> Id (el X w1) (act X pt w1 p1 (act X w1 pt (sym G.space pt w1 p1) y)) y)
              (\ y -> refl y) z p x)
            (carry P pt _ z p (h p))) ((G.connected.2 pt z).1))
          (\ h p -> carry P z x pt (sym G.space pt z p) h))) ;
    equivalence : Big.Equiv (SubG X) closed = (evaluate,Big.qinv _ _ evaluate extend eval-extend extend-eval) ;
  } ;
  -- Definition 5.2.18.
  finite (X : Act.GSet) : U l = FiniteSets[l].Finite (el X G.point) ;
  -- Definition 5.2.20 and Lemma 5.2.22 (ConnectedActions.Family).
  module Transitive (X : Act.GSet) {
    module C = ConnectedActions[l].Family[G.space,G.point,G.connected,el X] ;
    transitive : U l = C.inhabited * C.transitive ;
    total-connected (h : transitive) : Connected[l].isConn CG.two (total X) = C.to-connected h ;
    from-connected (c : Connected[l].isConn CG.two (total X)) : transitive = C.from-connected c ;
    reach (h : transitive) (z w : G.space) (x : el X z) (y : el X w) :
      T.Trunc[(g : Id G.space z w) * Id (el X w) (act X z w g x) y].carrier =
      TC.map _ _ (sPath G.space (el X) (z,x) (w,y)) (C.lift-pair h.2 z w x y) ;
  } ;
  -- Lemma 5.2.23. For a transitive X, evaluation at a point is injective.
  module Evaluation (X Y : Act.GSet) (z : G.space) (x : el X z) (h : Transitive[X].transitive) {
    ev (f : Hom X Y) : el Y z = f z x ;
    agree (f f' : Hom X Y) (e : Id (el Y z) (f z x) (f' z x)) (w : G.space) (y : el X w) : Id (el Y w) (f w y) (f' w y) =
      TC.rec ((g : Id G.space z w) * Id (el X w) (act X z w g x) y) @l _ ((Y w).2 _ _) (\ c ->
        transH (apH (f w) (symH c.2)) (transH (equivariant X Y f z w c.1 x)
          (transH (apH (act Y z w c.1) e) (transH (symH (equivariant X Y f' z w c.1 x)) (apH (f' w) c.2)))))
        (Transitive[X].reach h z w x y) ;
    injective (f f' : Hom X Y) (e : Id (el Y z) (ev f) (ev f')) : Id (Hom X Y) f f' =
      FL.funext G.space (\ w -> el X w -> el Y w) f f' (\ w ->
        FL.funext (el X w) (\ y -> el Y w) (f w) (f' w) (agree f f' e w)) ;
  } ;
  -- Definition 5.2.25.
  evaluate-path (X : Act.GSet) (z : G.space) (x : el X z) (e : Id Act.GSet X X) : el X z = Big.subst Act.GSet (\ Y -> el Y z) X X e x ;
  isNormal (X : Act.GSet) : U l+ = Transitive[X].transitive *
    ((z : G.space) (x : el X z) -> Big.isEquiv (Id Act.GSet X X) (el X z) (evaluate-path X z x)) ;
  -- Paths of G-sets are determined by their transport functions.
  transport-hom (X Y : Act.GSet) (e : Id Act.GSet X Y) : Hom X Y = \ z x -> Big.subst Act.GSet (\ W -> el W z) X Y e x ;
  fibre-path (X Y : Act.GSet) (e : Id Act.GSet X Y) (z : G.space) : Id (U l) (el X z) (el Y z) =
    Big.ap Act.SetAt (U l) (\ S -> S.1) _ _ (Big.happly G.space (\ w -> Act.SetAt) X Y e z) ;
  module PathInjective (X Y : Act.GSet) {
    module FB = Axioms[l+].FunExtLemmas[fe @(l+)] ;
    computes (e : Id Act.GSet X Y) (z : G.space) (x : el X z) :
      Id (el Y z) ((Axioms[l].idtoeqv (el X z) (el Y z) (fibre-path X Y e z)).1 x) (transport-hom X Y e z x) =
      idJ Act.GSet X (\ W r -> Id (el W z) ((Axioms[l].idtoeqv (el X z) (el W z) (fibre-path X W r z)).1 x) (transport-hom X W r z x))
        (refl x) Y e ;
    injective (e e' : Id Act.GSet X Y) (h : (z : G.space) (x : el X z) -> Id (el Y z) (transport-hom X Y e z x) (transport-hom X Y e' z x)) :
      Id (Id Act.GSet X Y) e e' = Equivalences[l+].injective _ _ (Big.happly G.space (\ w -> Act.SetAt) X Y) (fe @(l+) G.space (\ w -> Act.SetAt) X Y) e e'
        (FB.funext G.space (\ z -> Id Act.SetAt (X z) (Y z)) _ _ (\ z ->
          Equivalences[l+].injective _ _ (Big.ap Act.SetAt (U l) (\ S -> S.1) (X z) (Y z)) (CircleBundles[l].S.At[X z].paths (Y z)).2 _ _
            (Equivalences[l+].injective _ _ (Axioms[l].idtoeqv (el X z) (el Y z)) (univ @l (el X z) (el Y z)) _ _
              (Big.Sigma-eq (el X z -> el Y z) (\ f -> isEquiv (el X z) (el Y z) f) _ _ _ _
                (FL.funext (el X z) (\ x -> el Y z) _ _ (\ x -> transH (computes e z x) (transH (h z x) (symH (computes e' z x)))))
                (EquivProp[l].isEquiv-prop _ _ _))))) ;
  } ;
  -- After Lemma 5.2.23: evaluation of paths out of a transitive G-set is injective.
  path-evaluation-injective (X Y : Act.GSet) (z : G.space) (x : el X z) (h : Transitive[X].transitive)
    (e e' : Id Act.GSet X Y) (p : Id (el Y z) (transport-hom X Y e z x) (transport-hom X Y e' z x)) : Id (Id Act.GSet X Y) e e' =
    PathInjective[X,Y].injective e e' (\ w y -> Evaluation[X,Y,z,x,h].agree (transport-hom X Y e) (transport-hom X Y e') p w y) ;
} ;
