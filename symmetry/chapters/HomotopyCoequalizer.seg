-- Optional interface for sections 8.5--8.7. Data are parameters of a
-- separate segment. The same chosen colimit eliminates at every target level.
level l ;
open Base ; open Prelude[l] ;
record Coequalizer (A B : U l) (s t : A -> B) {
  space : U l ;
  point : B -> space ;
  edge (a : A) : Id space (point (s a)) (point (t a)) ;
} ;
module Property (A B : U l) (s t : A -> B) (Q : Coequalizer[A,B,s,t]) {
  cocone : [k] U k -> U (k \/ l) = <k> \ Y ->
    (v : B -> Y) * ((a : A) -> Id Y (v (s a)) (v (t a))) ;
  restrict : [k] (Y : U k) -> (Q.space -> Y) -> cocone @k Y =
    <k> \ Y f -> (\ b -> f (Q.point b),\ a -> Prelude[l \/ k].ap Q.space Y f _ _ (Q.edge a)) ;
  universal : [k] U (l \/ k+) = <k> (Y : U k) -> Prelude[l \/ k].isEquiv
    (Q.space -> Y) (cocone @k Y) (restrict @k Y) ;
} ;
