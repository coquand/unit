-- Sections 3.1 and 3.4. The chosen circle and its generator are in U_l.
level l ;
open Base ; open Prelude[l] ;
module Z = Integers[l] ;
module K = EM[l].EM1[Z.intAb] ;
Circle : U l = K.K1 ;
base : Circle = K.k0 ;
loop : Id Circle base base = CircleProperty[l].Circle[Circle].g ;
winding : Equiv (Id Circle base base) Z.Int = K.band-equiv base ;
module Maps (Y : U l) {
  module C = CircleProperty[l].Circle[Y] ;
  free-loops : U l = (y : Y) * Id Y y y ;
  evaluation : Equiv (Circle -> Y) free-loops = (C.E,C.E-equiv) ;
  rec (y : Y) (p : Id Y y y) : Circle -> Y = evaluation.2.sec (y,p) ;
  beta (y : Y) (p : Id Y y y) : Id free-loops (evaluation.1 (rec y p)) (y,p) =
    evaluation.2.sec-eq (y,p) ;
} ;
