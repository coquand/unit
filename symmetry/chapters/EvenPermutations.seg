-- Exercise 4.5.14. An odd transposition pairs even with odd permutations.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Logic[l] ;
module Big = Prelude[l+] ; module BP = Paths[l+] ; module BE = Equivalences[l+] ; module E = Equivalences[l] ;
module T = Truncation[l] ; module F = FiniteSets[l] ; module FA = FiniteArithmetic[l] ; module Z = Z2[l] ;
module Labeled (n : Nat) {
  module S = SignLaws[l].Degree[n] ; module K = S.K ; module A = S.Standard ;
  X : U l = K.X ; aut : U l = Equiv X X ;
  module Sub = ChapterTwo[l+].Subtype[U l,\ Y -> K.D.Dom.codes Y,\ Y -> T.Trunc[Equiv X Y].proposition] ;
  code : Big.Equiv S.loops aut = BE.compose _ _ _ (Sub.At[K.A].paths K.A) (Axioms[l].idtoeqv X X,univ @l X X) ;
  act (v : K.V) (p : Id K.V K.A v) : (z : X) -> Id v.1 ((Axioms[l].idtoeqv X v.1 (Big.ap K.V (U l) K.carrier K.A v p)).1 z) ((K.image v p).1 z) =
    idJ K.V K.A (\ t r -> (z : X) -> Id t.1 ((Axioms[l].idtoeqv X t.1 (Big.ap K.V (U l) K.carrier K.A t r)).1 z) ((K.image t r).1 z)) (\ z -> refl z) v p ;
  move-comp (v : K.V) (p : Id K.V K.A v) (w : K.V) (q : Id K.V v w) (x : X) :
    Id w.1 ((K.image w (BP.transH p q)).1 x) ((SignComputation[l].Move[K.V,K.carrier,v].equiv w q).1 ((K.image v p).1 x)) =
    idJ K.V v (\ t r -> Id t.1 ((K.image t (BP.transH p r)).1 x)
      ((SignComputation[l].Move[K.V,K.carrier,v].equiv t r).1 ((K.image v p).1 x))) (refl ((K.image v p).1 x)) w q ;
  loop (e : aut) : S.loops = K.Permutation[e].loop ;
  sign (e : aut) : Bool = S.E.sign (loop e) ;
  compose (e f : aut) : Id S.loops (BP.transH (loop e) (loop f)) (loop (E.compose X X X e f)) =
    BE.injective _ _ code.1 code.2 _ _ (PermutationCount[l].ext X X _ _ (\ x -> transH (act K.A (BP.transH (loop e) (loop f)) x)
      (transH (move-comp K.A (loop e) K.A (loop f) x) (transH (K.Permutation[f].applies ((K.image K.A (loop e)).1 x))
        (transH (apH f.1 (K.Permutation[e].applies x)) (symH (transH (act K.A (loop (E.compose X X X e f)) x)
          (K.Permutation[E.compose X X X e f].applies x)))))))) ;
  multiply (e f : aut) : Id Bool (sign (E.compose X X X e f)) (Z.xor (sign e) (sign f)) =
    transH (BP.apH S.E.sign (BP.symH (compose e f))) (S.multiply (loop e) (loop f)) ;
  module Swap = S.M.Marked[A.pair,A.data-point.2.1,A.data-point.2.2.1,A.data-point.2.2.2] ;
  turn (e : aut) : aut = E.compose X X X Swap.transpose e ;
  odd-even (e : aut) : Id Bool (sign (turn e)) (not (sign e)) = transH (multiply Swap.transpose e) (apH (\ v -> Z.xor v (sign e)) A.sign) ;
  involution (e : aut) : Id aut (turn (turn e)) e = PermutationCount[l].ext X X _ e (\ x -> apH e.1 (Swap.invol x)) ;
  part (b : Bool) : U l = (e : aut) * Id Bool (sign e) b ;
  prop (e : aut) (b : Bool) : isProp (Id Bool (sign e) b) = Z.bool-set _ b ;
  shift (b : Bool) (v : part b) : part (not b) = (turn v.1,transH (odd-even v.1) (apH not v.2)) ;
  invert (b : Bool) (v : part b) : Id (part b) (turn (turn v.1),transH (odd-even (turn v.1))
    (transH (apH not (shift b v).2) (Z.not-not b))) v = Sigma-eq aut (\ e -> Id Bool (sign e) b) _ _ _ _ (involution v.1) (prop v.1 b) ;
  paired : Equiv (part false) (part true) = (shift false,qinv _ _ (shift false) (shift true)
    (\ v -> Sigma-eq aut (\ e -> Id Bool (sign e) true) _ _ _ _ (involution v.1) (prop v.1 true))
    (\ v -> Sigma-eq aut (\ e -> Id Bool (sign e) false) _ _ _ _ (involution v.1) (prop v.1 false))) ;
  Fsize : F.Finite aut = T.Trunc[(k : Nat) * Equiv (FinChoice[l].Fin k) aut].inc (PermutationCount[l].factorial K.D.S.N,PermutationCount[l].enumeration K.D.S.N) ;
  finite (b : Bool) : F.Finite (part b) = FA.sigma aut Fsize (\ e -> Id Bool (sign e) b)
    (\ e -> FiniteSubsets[l].Proposition[Id Bool (sign e) b,prop e b].finite (TwoElementSets[l].Booleans.P.D.discrete (sign e) b)) ;
  add : U l = FA.Sum (part false) (part true) ;
  forget : add -> aut = split { left h -> h.1 ; right h -> h.1 } ;
  choose (e : aut) : (b : Bool) -> Id Bool (sign e) b -> add = split { false -> \ p -> left (e,p) ; true -> \ p -> right (e,p) } ;
  beta (e : aut) : (b : Bool) (p : Id Bool (sign e) b) -> Id aut (forget (choose e b p)) e = split { false -> \ p -> refl e ; true -> \ p -> refl e } ;
  from (e : aut) : add = choose e (sign e) (refl (sign e)) ;
  constant (e : aut) (b : Bool) (p : Id Bool (sign e) b) : Id add (from e) (choose e b p) =
    idJ Bool (sign e) (\ c q -> Id add (from e) (choose e c q)) (refl (from e)) b p ;
  eta : (z : add) -> Id add (from (forget z)) z = split { left h -> constant h.1 false h.2 ; right h -> constant h.1 true h.2 } ;
  sum : Equiv add aut = (forget,qinv _ _ forget from (\ e -> beta e (sign e) (refl (sign e))) eta) ;
  count (b : Bool) : Nat = Cardinality[l].Count[part b].cardinal (finite b) ;
  equal : Id Nat (count false) (count true) = FA.Change[part false,part true,paired].same (finite false) (finite true) ;
  module Total = FA.SumOf[part false,part true] ;
  twice-even : Id Nat (NatArith[l].plus (count false) (count false)) (PermutationCount[l].factorial K.D.S.N) =
    transH (apH (NatArith[l].plus (count false)) equal) (transH (symH (Total.cardinal (finite false) (finite true)))
      (transH (FA.Change[add,aut,sum].same (Total.finite (finite false) (finite true)) Fsize)
        (Cardinality[l].Count[aut].computes Fsize _ (PermutationCount[l].enumeration K.D.S.N)))) ;
} ;
