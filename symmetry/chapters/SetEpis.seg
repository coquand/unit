-- Exercise 6.3.10, testing categorical epimorphisms against small sets only.
-- Double each point of B and identify its two copies on the image of f.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
data Either (A B : U l) : U l = left (x : A) | right (y : B) ;
module Map (A B : U l) (setB : isSet B) (f : A -> B) {
  fibre (b : B) : U l = (a : A) * Id B (f a) b ;
  image (b : B) : U l = Tr.Trunc[fibre b].carrier ;
  surjective : U l = (b : B) -> image b ;
  epi : U l+ = (C : U l) -> isSet C -> (g h : B -> C) ->
    Id (A -> C) (\ a -> g (f a)) (\ a -> h (f a)) -> Id (B -> C) g h ;
  surj-epi (s : surjective) (C : U l) (c : isSet C) (g h : B -> C)
    (e : Id (A -> C) (\ a -> g (f a)) (\ a -> h (f a))) : Id (B -> C) g h =
    FL.funext B (\ b -> C) g h (\ b -> TC.rec (fibre b) @l (Id C (g b) (h b)) (c (g b) (h b))
      (\ w -> subst B (\ z -> Id C (g z) (h z)) (f w.1) b w.2 (happly A (\ a -> C) _ _ e w.1)) (s b)) ;
  module Double (b : B) {
    witness (x y : Bool) : U l = Either (Id Bool x y) (image b) ;
    rel (x y : Bool) : U l = Tr.Trunc[witness x y].carrier ;
    rr (x : Bool) : rel x x = Tr.Trunc[witness x x].inc (left (refl x)) ;
    flip (x y : Bool) : witness x y -> witness y x = split {
      left p -> left (symH p) ; right u -> right u } ;
    rs (x y : Bool) : rel x y -> rel y x = TC.map (witness x y) (witness y x) (flip x y) ;
    join (x y z : Bool) : witness x y -> witness y z -> witness x z = split {
      left p -> split { left q -> left (transH p q) ; right u -> right u } ;
      right u -> \ v -> right u } ;
    rt (x y z : Bool) : rel x y -> rel y z -> rel x z =
      TC.map2 (witness x y) (witness y z) (witness x z) (join x y z) ;
    module Q = Quotient[l].Quot[Bool,rel,\ x y -> Tr.Trunc[witness x y].proposition,rr,rs,rt] ;
    code : Bool -> U l = split { true -> Top ; false -> Empty } ;
    recover : witness true false -> image b = split {
      left p -> absurd (image b) (subst Bool code true false p tt) ; right u -> u } ;
    effective (p : Id Q.Q (Q.inc true) (Q.inc false)) : image b =
      TC.rec (witness true false) @l (image b) Tr.Trunc[fibre b].proposition recover (Q.effective true false p) ;
  } ;
  family (b : B) : U l = Double[b].Q.Q ;
  test : U l = (b : B) * family b ;
  set : isSet test = isSet-Sigma B family setB (\ b -> Double[b].Q.set) ;
  first (b : B) : test = (b,Double[b].Q.inc true) ;
  second (b : B) : test = (b,Double[b].Q.inc false) ;
  coincide (a : A) : Id test (first (f a)) (second (f a)) =
    ap (family (f a)) test (\ q -> (f a,q)) _ _ (Double[f a].Q.relates true false
      (Tr.Trunc[Double[f a].witness true false].inc (right (Tr.Trunc[fibre (f a)].inc (a,refl (f a)))))) ;
  module At (e : epi) (b : B) {
    equal : Id test (first b) (second b) = happly B (\ z -> test) first second
      (e test set first second (FL.funext A (\ a -> test) _ _ coincide)) b ;
    lift : (p : Id B b b) * Id (family b) (subst B family b b p (first b).2) (second b).2 =
      sPath B family (first b) (second b) equal ;
    vertical : Id (family b) (first b).2 (second b).2 =
      subst (Id B b b) (\ p -> Id (family b) (subst B family b b p (first b).2) (second b).2)
        lift.1 (refl b) (setB b b lift.1 (refl b)) lift.2 ;
    hit : image b = Double[b].effective vertical ;
  } ;
  epi-surj (e : epi) : surjective = \ b -> At[e,b].hit ;
} ;
