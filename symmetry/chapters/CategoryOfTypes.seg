-- The wild category of types, with its initial object, terminal object and products.
level l ; open Base ; open Prelude[l] ; module Big = Prelude[l+] ;
module W = WildCategory[l+,l] ; module E = EquivalenceLemmas[l+] ;
types : W.Wild = new W.Wild[U l,\ X Y -> X -> Y,\ X x -> x,\ X Y Z g f x -> g (f x),
  \ X Y f -> refl f,\ X Y f -> refl f,\ W X Y Z f g k -> refl (\ w -> k (g (f w)))] ;
module Isos (X Y : U l) {
  iso : U l = types.iso X Y ;
  module FL = Axioms[l].FunExtLemmas[fe @l] ;
  pack (e : Equiv X Y) : iso = (e.1,(e.2.sec,FL.funext Y (\ y -> Y) _ _ e.2.sec-eq),
    e.2.ret,FL.funext X (\ x -> X) _ _ e.2.ret-eq) ;
  unpack (i : iso) : Equiv X Y = (i.1,new IsEquiv[X,Y,i.1,i.2.1.1,
    happly Y (\ y -> Y) _ _ i.2.1.2,i.2.2.1,happly X (\ x -> X) _ _ i.2.2.2]) ;
  iso-eta (i : iso) : Id iso (pack (unpack i)) i =
    Paths[l].transH (ap _ iso (\ p -> (i.1,(i.2.1.1,p),(pack (unpack i)).2.2)) _ _
      (FL.funext-happly Y (\ y -> Y) _ _ i.2.1.2))
      (ap _ iso (\ p -> (i.1,i.2.1,i.2.2.1,p)) _ _ (FL.funext-happly X (\ x -> X) _ _ i.2.2.2)) ;
} ;
equiv-eta (X Y : U l) (e : Equiv X Y) : Id (Equiv X Y) (Isos[X,Y].unpack (Isos[X,Y].pack e)) e =
  Axioms[l].UnivalenceLemmas[univ @l].eqind X
    (\ Z k -> Id (Equiv X Z) (Isos[X,Z].unpack (Isos[X,Z].pack k)) k)
    (Paths[l].apH Isos[X,X].unpack (Isos[X,X].iso-eta (types.ident X))) Y e ;
module L = Paths[l+] ;
compute (X Y : U l) (p : Id (U l) X Y) :
  Id (types.iso X Y) (Isos[X,Y].pack (Axioms[l].idtoeqv X Y p)) (types.idtoiso X Y p) =
  idJ (U l) X (\ Z r -> Id (types.iso X Z) (Isos[X,Z].pack (Axioms[l].idtoeqv X Z r)) (types.idtoiso X Z r))
    (Isos[X,X].iso-eta (types.ident X)) Y p ;
univalent : types.univalent = \ X Y -> E.homotopy _ _ _ _ (compute X Y)
  (E.compose _ _ _ Isos[X,Y].pack (Axioms[l].idtoeqv X Y) (Big.qinv _ _ Isos[X,Y].pack Isos[X,Y].unpack Isos[X,Y].iso-eta (equiv-eta X Y)) (univ @l X Y)) ;
module Extremal = W.Extremal[types] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
terminal : Extremal.terminal Top = \ X -> (\ x -> tt,\ f -> FL.funext X (\ x -> Top) _ f (\ x -> isTop tt (f x))) ;
empty-law (X : U l) (f : Empty -> X) : (x : Empty) -> Id X (absurd X x) (f x) = split {} ;
initial : Extremal.initial Empty = \ X -> (absurd X,\ f -> FL.funext Empty (\ x -> X) _ f (empty-law X f)) ;
module Product (A B : U l) {
  module P = ProductCones[l+,l].Binary[types,A,B] ;
  apex : P.cone = (A * B,(\ w -> w.1),\ w -> w.2) ;
  pair (X : U l) (s : P.legs X) : X -> A * B = \ x -> (s.1 x,s.2 x) ;
  mediates (u : P.cone) : P.arrow u apex = (pair u.1 u.2,refl u.2) ;
  eta (X : U l) (f : X -> A * B) (s : P.legs X) (r : Id (P.legs X) (P.pull X apex.1 f apex.2) s) :
    Id (P.arrow (X,s) apex) (mediates (X,s)) (f,r) =
    idJ (P.legs X) (P.pull X apex.1 f apex.2) (\ t q -> Id (P.arrow (X,t) apex) (mediates (X,t)) (f,q))
      (refl (f,refl (P.pull X apex.1 f apex.2))) s r ;
  product : P.product = (apex,\ u -> (mediates u,\ v -> eta u.1 v.1 u.2 v.2)) ;
} ;
module Coproduct (A B : U l) {
  module P = ProductCones[l+,l].Binary[W.op types,A,B] ;
  data sum : U l = left (x : A) | right (y : B) ;
  apex : P.cone = (sum,(\ x -> left x),\ y -> right y) ;
  copair (X : U l) (s : P.legs X) : sum -> X = split { left x -> s.1 x ; right y -> s.2 y } ;
  restrict (X : U l) (f : sum -> X) : P.legs X = P.pull X sum f apex.2 ;
  at (X : U l) (f : sum -> X) : (z : sum) -> Id X (copair X (restrict X f) z) (f z) =
    split { left x -> refl (f (left x)) ; right y -> refl (f (right y)) } ;
  equiv (X : U l) : Equiv (sum -> X) (P.legs X) = (restrict X,qinv _ _ (restrict X) (copair X)
    (\ s -> refl s) (\ f -> FL.funext sum (\ z -> X) _ f (at X f))) ;
  coproduct : P.product = (apex,\ u -> WildIsos[l,l].contract _ _ (equiv u.1) u.2) ;
} ;
-- The wild slice of types over B has homotopies as its triangle witnesses.
module Over (B0 : U l) {
  ob : U l+ = (X : U l) * (X -> B0) ;
  tri (X Y : ob) (f : X.1 -> Y.1) : U l = (x : X.1) -> Id B0 (X.2 x) (Y.2 (f x)) ;
  hom (X Y : ob) : U l = (f : X.1 -> Y.1) * tri X Y f ;
  identity (X : ob) : hom X X = ((\ x -> x),\ x -> refl (X.2 x)) ;
  comp (X Y Z : ob) (g : hom Y Z) (f : hom X Y) : hom X Z =
    ((\ x -> g.1 (f.1 x)),\ x -> Paths[l].transH (f.2 x) (g.2 (f.1 x))) ;
  triangle (X Y : ob) (f : X.1 -> Y.1) (p q : tri X Y f) (e : (x : X.1) -> Id (Id B0 (X.2 x) (Y.2 (f x))) (p x) (q x)) :
    Id (hom X Y) (f,p) (f,q) = ap (tri X Y f) (hom X Y) (\ t -> (f,t)) p q (FL.funext X.1 (\ x -> Id B0 (X.2 x) (Y.2 (f x))) p q e) ;
  assoc (x y z t : B0) (p : Id B0 x y) (q : Id B0 y z) (r : Id B0 z t) :
    Id (Id B0 x t) (Paths[l].transH (Paths[l].transH p q) r) (Paths[l].transH p (Paths[l].transH q r)) =
    idJ B0 z (\ b s -> Id (Id B0 x b) (Paths[l].transH (Paths[l].transH p q) s) (Paths[l].transH p (Paths[l].transH q s))) (refl (Paths[l].transH p q)) t r ;
  category : W.Wild = new W.Wild[ob,hom,identity,comp,(\ X Y f -> refl f),
    (\ X Y f -> triangle X Y f.1 _ f.2 (\ x -> trans-refl-l _ _ _ (f.2 x))),
    (\ X Y Z T f g k -> triangle X T (\ x -> k.1 (g.1 (f.1 x))) _ _ (\ x -> assoc _ _ _ _ (f.2 x) (g.2 (f.1 x)) (k.2 (g.1 (f.1 x)))))] ;
} ;
