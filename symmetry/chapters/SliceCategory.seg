-- Sections 6.2–6.4. Ordinary slice categories, univalence, and the projection.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module K = Category[o,h] ; module KS = Category[o \/ h,h] ; module Q = Prelude[h] ;
module Over (C : K.Precategory) (b : C.ob) {
  module R = Arrows[o,h].Arrows[C] ;
  ob : U (o \/ h) = (x : C.ob) * C.hom x b ;
  leg (x y : ob) (f : C.hom x.1 y.1) : U h = Id (C.hom x.1 b) (R.cmp y.2 f) x.2 ;
  hom (x y : ob) : U h = (f : C.hom x.1 y.1) * leg x y f ;
  equal (x y : ob) (f g : hom x y) (q : Id (C.hom x.1 y.1) f.1 g.1) : Id (hom x y) f g =
    Q.Sigma-eq _ (leg x y) _ _ _ _ q (C.hom-set _ _ _ _) ;
  identity (x : ob) : hom x x = (C.idn x.1,R.unit-r x.2) ;
  comp (x y z : ob) (g : hom y z) (f : hom x y) : hom x z =
    (R.cmp g.1 f.1,transH (R.assoc z.2 g.1 f.1) (transH (R.right g.2 f.1) f.2)) ;
  pre : KS.Precategory = new KS.Precategory[ob,hom,
    \ x y -> Q.isSet-Sigma _ (leg x y) (C.hom-set x.1 y.1) (\ f -> Q.prop-to-set _ (C.hom-set _ _ _ _)),
    identity,comp,\ x y f -> equal x y _ f (R.unit-l f.1),\ x y f -> equal x y _ f (R.unit-r f.1),
    \ w x y z f g k -> equal w z _ _ (R.assoc k.1 g.1 f.1)] ;
  module F = Functor[o \/ h,h,o,h] ;
  projection : F.Functor[pre,C] = new F.Functor[pre,C,\ x -> x.1,\ x y f -> f.1,\ x -> refl (C.idn x.1),\ x y z g f -> refl (R.cmp g.1 f.1)] ;
  module At (x : ob) {
    total : U (o \/ h) = KS.Singletons[pre].Singl x ;
    base : U (o \/ h) = K.Singletons[C].Singl x.1 ;
    module P = F.Maps[pre,C,projection] ;
    forget (w : total) : base = (w.1.1,P.map-iso w.2) ;
    module Lift (z : C.ob) (i : C.Iso x.1 z) {
      t : C.hom z b = R.cmp x.2 (R.inv i) ;
      point : ob = (z,t) ;
      forward : hom x point = (i.1,R.undo-r x.2 (R.iso-inv i)) ;
      back : hom point x = (R.inv i,refl t) ;
      iso : pre.Iso x point = (forward,back,equal x x _ _ (R.inv-arr i),equal point point _ _ (R.arr-inv i)) ;
      extend (v : C.hom z b) (e : Id (C.hom z b) t v) : (j : pre.Iso x (z,v)) ->
        Id (C.hom x.1 z) i.1 j.1.1 -> Id total (point,iso) ((z,v),j) =
        idJ (C.hom z b) t (\ u q -> (j : pre.Iso x (z,u)) -> Id (C.hom x.1 z) i.1 j.1.1 -> Id total (point,iso) ((z,u),j))
          (\ j p -> ap (pre.Iso x point) total (\ k -> (point,k)) iso j
            (Arrows[o \/ h,h].Arrows[pre].iso-eq iso j (equal x point forward j.1 p))) v e ;
    } ;
    make (u : base) : total = (Lift[u.1,u.2].point,Lift[u.1,u.2].iso) ;
    ret (w : total) : Id total (make (forget w)) w =
      Lift[w.1.1,(forget w).2].extend w.1.2 (transH (R.right (symH w.2.1.2) (R.inv (forget w).2)) (R.undo-r w.1.2 (forget w).2)) w.2 (refl w.2.1.1) ;
    prop (ua : K.Univalent C) : isProp total = retract-prop total base forget make ret
      (K.Objects[new K.Category[C,ua]].singl-prop x.1) ;
  } ;
  category (ua : K.Univalent C) : KS.Category = new KS.Category[pre,KS.FromTotal[pre,\ x -> At[x].prop ua].univalent] ;
} ;
module Under (C : K.Precategory) (b : C.ob) {
  module Opp = WildIsos[o,h].HomSets[WildCategory[o,h].op (WildCategory[o,h].forget C),\ x y -> C.hom-set y x] ;
  module S = Over[Opp.pre,b] ;
  coslice : WildCategory[o \/ h,h].Wild = WildCategory[o \/ h,h].op (WildCategory[o \/ h,h].forget S.pre) ;
} ;
