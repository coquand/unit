-- Instances of the optional coequalizer. Points come with propositional
-- computation via the counit of the displayed mapping equivalences.
level l k ;
open Base ; open Prelude[l \/ k] ;
module H = HomotopyCoequalizer[l] ;
data Sum (A B : U l) : U l = left (a : A) | right (b : B) ;
module Pushout (A B C : U l) (s : C -> A) (t : C -> B) {
  src (c : C) : Sum A B = left (s c) ;
  tgt (c : C) : Sum A B = right (t c) ;
  Q : H.Coequalizer[C,Sum A B,src,tgt] = coeq @l C (Sum A B) src tgt ;
  in-left (a : A) : Q.space = Q.point (left a) ;
  in-right (b : B) : Q.space = Q.point (right b) ;
  glue (c : C) : Id Q.space (in-left (s c)) (in-right (t c)) = Q.edge c ;
  module P = H.Property[C,Sum A B,src,tgt,Q] ;
  maps (Y : U k) : Equiv (Q.space -> Y) (P.cocone @k Y) =
    (P.restrict @k Y,coeq-up @l @k C (Sum A B) src tgt Y) ;
} ;
module Wedge (A : U l) (a : A) (B : U l) (b : B) {
  module W = Pushout[A,B,Top,\ t -> a,\ t -> b] ;
  space : U l = W.Q.space ;
  base : space = W.in-left a ;
  join : Id space base (W.in-right b) = W.glue tt ;
  module Maps (Y : U k) (y : Y) {
    module E = Equivalences[l \/ k] ;
    module FL = Axioms[l \/ k].FunExtLemmas[fe @(l \/ k)] ;
    pair : U (l \/ k) = (A -> Y) * (B -> Y) ;
    restrict (f : Sum A B -> Y) : pair = (\ x -> f (left x),\ x -> f (right x)) ;
    merge (v : pair) : Sum A B -> Y = split { left x -> v.1 x ; right x -> v.2 x } ;
    agree (f : Sum A B -> Y) : (z : Sum A B) -> Id Y (merge (restrict f) z) (f z) =
      split { left x -> refl (f (left x)) ; right x -> refl (f (right x)) } ;
    on-sum : Equiv (Sum A B -> Y) pair = (restrict,qinv (Sum A B -> Y) pair restrict merge
      (\ v -> refl v) (\ f -> FL.funext (Sum A B) (\ z -> Y) _ _ (agree f))) ;
    gluing (v : pair) : U (l \/ k) = Top -> Id Y (v.1 a) (v.2 b) ;
    path (v : pair) : U (l \/ k) = Id Y (v.1 a) (v.2 b) ;
    at-tt (v : pair) : Equiv (gluing v) (path v) = (\ h -> h tt,
      qinv (gluing v) (path v) (\ h -> h tt) (\ p t -> p) (\ p -> refl p)
        (\ h -> FL.funext Top (\ t -> path v) _ _ (\ t -> ap Top (path v) h tt t (isTop tt t)))) ;
    cones : U (l \/ k) = (v : pair) * path v ;
    from-wedge : Equiv (space -> Y) cones = E.compose (space -> Y) (W.P.cocone @k Y) cones (W.maps Y)
      (E.compose (W.P.cocone @k Y) ((v : pair) * gluing v) cones
        (ChapterTwo[l \/ k].change-base (Sum A B -> Y) pair on-sum gluing)
        (Fibres[l \/ k].sigma-equiv pair gluing path at-tt)) ;
    pointed-cones : U (l \/ k) = (v : cones) * Id Y (v.1.1 a) y ;
    pointed-pair : U (l \/ k) = ((f : A -> Y) * Id Y (f a) y) * ((g : B -> Y) * Id Y (g b) y) ;
    -- Given f(a)=y, identifying f(a) with g(b) is equivalent to pointing g.
    invert (x z : Y) : Equiv (Id Y x z) (Id Y z x) =
      (sym Y x z,qinv _ _ (sym Y x z) (sym Y z x)
        (\ p -> idJ Y z (\ u q -> Id (Id Y z u) (sym Y u z (sym Y z u q)) q) (refl (refl z)) x p)
        (\ p -> idJ Y x (\ u q -> Id (Id Y x u) (sym Y u x (sym Y x u q)) q) (refl (refl x)) z p)) ;
    point-right (x z : Y) (r : Id Y x y) : Equiv (Id Y x z) (Id Y z y) =
      idJ Y x (\ u q -> Equiv (Id Y x z) (Id Y z u)) (invert x z) y r ;
    separate (w : pointed-cones) : pointed-pair =
      ((w.1.1.1,w.2),(w.1.1.2,(point-right (w.1.1.1 a) (w.1.1.2 b) w.2).1 w.1.2)) ;
    combine (w : pointed-pair) : pointed-cones =
      (((w.1.1,w.2.1),(point-right (w.1.1 a) (w.2.1 b) w.1.2).2.sec w.2.2),w.1.2) ;
    beta (w : pointed-pair) : Id pointed-pair (separate (combine w)) w =
      ap (Id Y (w.2.1 b) y) pointed-pair (\ q -> (w.1,(w.2.1,q))) _ _
        ((point-right (w.1.1 a) (w.2.1 b) w.1.2).2.sec-eq w.2.2) ;
    eta (w : pointed-cones) : Id pointed-cones (combine (separate w)) w =
      ap (path w.1.1) pointed-cones (\ p -> ((w.1.1,p),w.2)) _ _
        (sec-ret _ _ (point-right (w.1.1.1 a) (w.1.1.2 b) w.2).1
          (point-right (w.1.1.1 a) (w.1.1.2 b) w.2).2 w.1.2) ;
    pointed : U (l \/ k) = (f : space -> Y) * Id Y (f base) y ;
    universal : Equiv pointed pointed-pair = E.compose pointed pointed-cones pointed-pair
      (ChapterTwo[l \/ k].change-base (space -> Y) cones from-wedge (\ w -> Id Y (w.1.1 a) y))
      (separate,qinv pointed-cones pointed-pair separate combine beta eta) ;
  } ;

} ;
module Bouquet (S : U l) {
  endpt (s : S) : Top = tt ;
  Q : H.Coequalizer[S,Top,endpt,endpt] = coeq @l S Top endpt endpt ;
  base : Q.space = Q.point tt ;
  loop (s : S) : Id Q.space base base = Q.edge s ;
  module P = H.Property[S,Top,endpt,endpt,Q] ;
  maps (Y : U k) : Equiv (Q.space -> Y) (P.cocone @k Y) =
    (P.restrict @k Y,coeq-up @l @k S Top endpt endpt Y) ;

  module Universal (Y : U k) (y : Y) {
    module E = Equivalences[l \/ k] ;
    module FL = Axioms[l \/ k].FunExtLemmas[fe @(l \/ k)] ;
    evaluate (f : Top -> Y) : Y = f tt ;
    constant (z : Y) : Top -> Y = \ t -> z ;
    top-eta (f : Top -> Y) : Id (Top -> Y) (constant (evaluate f)) f =
      FL.funext Top (\ t -> Y) _ _ (\ t -> ap Top Y f tt t (isTop tt t)) ;
    top-equiv : Equiv (Top -> Y) Y = (evaluate,qinv (Top -> Y) Y evaluate constant (\ z -> refl z) top-eta) ;
    loops (z : Y) : U (l \/ k) = S -> Id Y z z ;
    free : Equiv (Q.space -> Y) ((z : Y) * loops z) =
      E.compose (Q.space -> Y) (P.cocone @k Y) ((z : Y) * loops z) (maps Y)
        (ChapterTwo[l \/ k].change-base (Top -> Y) Y top-equiv loops) ;
    pointed : U (l \/ k) = (f : Q.space -> Y) * Id Y (f base) y ;
    module At = ChapterTwo[l \/ k].Projection[Y,loops,y] ;
    pointed-universal : Equiv pointed (loops y) =
      E.compose pointed At.fibre (loops y)
        (ChapterTwo[l \/ k].change-base (Q.space -> Y) ((z : Y) * loops z) free (\ w -> Id Y w.1 y))
        At.equivalence ;
  } ;
  module Rec (Y : U k) (y : Y) (p : S -> Id Y y y) {
    data-at-base : P.cocone @k Y = (\ t -> y,p) ;
    rec : Q.space -> Y = (maps Y).2.sec data-at-base ;
    beta : Id (P.cocone @k Y) ((maps Y).1 rec) data-at-base = (maps Y).2.sec-eq data-at-base ;
  } ;
} ;

