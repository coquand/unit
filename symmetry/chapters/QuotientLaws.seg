-- Section 2.22. Uniqueness of descent for the replacement quotient.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module By (X : U l) (R : X -> X -> U l) (p : (x y : X) -> isProp (R x y))
  (r : (x : X) -> R x x) (s : (x y : X) -> R x y -> R y x) (t : (x y z : X) -> R x y -> R y z -> R x z) {
  module Q = Quotient[l].Quot[X,R,p,r,s,t] ;
  module Into (Y : U l) (set : isSet Y) (f : X -> Y) (h : (x y : X) -> R x y -> Id Y (f x) (f y)) {
    module D = Q.Descend[Y,set,f,h] ;
    law (g : Q.Q -> Y) : U l = (x : X) -> Id Y (g (Q.inc x)) (f x) ;
    solutions : U l = (g : Q.Q -> Y) * law g ;
    unique (w : solutions) : Id solutions (D.map,D.beta) w = Sigma-eq (Q.Q -> Y) law _ _ _ _
      (FL.funext Q.Q (\ z -> Y) D.map w.1 (Q.induction @l (\ z -> Id Y (D.map z) (w.1 z))
        (\ z -> set _ _) (\ x -> transH (D.beta x) (symH (w.2 x))))) (FL.isProp-Pi X (\ x -> Id Y (w.1 (Q.inc x)) (f x)) (\ x -> set _ _)) ;
    universal : FunExtUA[l].isContr solutions = ((D.map,D.beta),unique) ;
  } ;
  class-at (a : X) (q : Q.Q) : Id Q.Q (Q.inc a) q -> Q.code q a =
    \ h -> subst Q.Q (\ z -> Q.code z a) (Q.inc a) q h
      (Prelude[l+].subst (X -> Quotient[l].Prop) (\ F -> (F a).1) (Q.family a) (Q.image.inclusion (Q.inc a))
        (Prelude[l+].sym _ _ _ (Q.image.triangle a)) (r a)) ;
  identifies (a : X) : (q : Q.Q) -> Q.code q a -> Id Q.Q (Q.inc a) q =
    Q.induction @l (\ q -> Q.code q a -> Id Q.Q (Q.inc a) q)
      (\ q -> FL.isProp-Pi (Q.code q a) (\ h -> Id Q.Q (Q.inc a) q) (\ h -> Q.set _ q))
      (\ b h -> Q.relates a b (Prelude[l+].subst (X -> Quotient[l].Prop) (\ F -> (F a).1)
        (Q.image.inclusion (Q.inc b)) (Q.family b) (Q.image.triangle b) h)) ;
  module Sections (P : Q.Q -> U l) (set : (q : Q.Q) -> isSet (P q)) (b : (a : X) -> P (Q.inc a))
    (coherent : (x y : X) (h : R x y) -> Id (P (Q.inc y)) (subst Q.Q P (Q.inc x) (Q.inc y) (Q.relates x y h) (b x)) (b y)) {
    total : U l = (q : Q.Q) * P q ;
    at (a : X) : total = (Q.inc a,b a) ;
    respect (x y : X) (h : R x y) : Id total (at x) (at y) = Sigma-path Q.Q P _ _ _ _ (Q.relates x y h) (coherent x y h) ;
    module D = Q.Descend[total,isSet-Sigma Q.Q P Q.set set,at,respect] ;
    back : (q : Q.Q) -> Id Q.Q (D.map q).1 q = Q.induction @l (\ q -> Id Q.Q (D.map q).1 q) (\ q -> Q.set _ q)
      (\ a -> ap total Q.Q (\ w -> w.1) _ _ (D.beta a)) ;
    extend (q : Q.Q) : P q = subst Q.Q P (D.map q).1 q (back q) (D.map q).2 ;
    beta (a : X) : Id (P (Q.inc a)) (extend (Q.inc a)) (b a) = transH
      (apH (\ p -> subst Q.Q P (D.map (Q.inc a)).1 (Q.inc a) p (D.map (Q.inc a)).2)
        (Q.set _ _ (back (Q.inc a)) (ap total Q.Q (\ w -> w.1) _ _ (D.beta a))))
      (Sigma-snd Q.Q P _ _ _ _ (D.beta a)) ;
  } ;
  -- Exercise 2.22.17. Instantiate the recursor and proposition induction
  -- with those of a HIT quotient. No HIT is needed as a global assumption.
  module Compare (Y : U l) (set : isSet Y) (point : X -> Y)
    (glue : (x y : X) -> R x y -> Id Y (point x) (point y))
    (rec : (Z : U l) (sz : isSet Z) (f : X -> Z) (h : (x y : X) -> R x y -> Id Z (f x) (f y)) ->
      (g : Y -> Z) * ((x : X) -> Id Z (g (point x)) (f x)))
    (ind : (P : Y -> U l) (p : (y : Y) -> isProp (P y)) -> ((x : X) -> P (point x)) -> (y : Y) -> P y) {
    module D = Q.Descend[Y,set,point,glue] ;
    inverse : (g : Y -> Q.Q) * ((x : X) -> Id Q.Q (g (point x)) (Q.inc x)) = rec Q.Q Q.set Q.inc Q.relates ;
    beta : (y : Y) -> Id Y (D.map (inverse.1 y)) y = ind (\ y -> Id Y (D.map (inverse.1 y)) y)
      (\ y -> set _ y) (\ x -> transH (apH D.map (inverse.2 x)) (D.beta x)) ;
    eta : (q : Q.Q) -> Id Q.Q (inverse.1 (D.map q)) q = Q.induction @l (\ q -> Id Q.Q (inverse.1 (D.map q)) q)
      (\ q -> Q.set _ q) (\ x -> transH (apH inverse.1 (D.beta x)) (inverse.2 x)) ;
    equivalence : Equiv Q.Q Y = (D.map,qinv _ _ D.map inverse.1 beta eta) ;
  } ;
} ;
module Indiscrete (X : U l) {
  module Q = By[X,\ x y -> Top,\ x y -> isTop,\ x -> tt,\ x y p -> tt,\ x y z p q -> tt].Q ;
  prop (a b : Q.Q) : Id Q.Q a b = Q.induction @l (\ z -> Id Q.Q z b) (\ z -> Q.set z b)
    (\ x -> Q.induction @l (\ z -> Id Q.Q (Q.inc x) z) (Q.set (Q.inc x)) (\ y -> Q.relates x y tt) b) a ;
  module Tr = T.Trunc[X] ;
  forward : Q.Q -> Tr.carrier = Q.induction @l (\ z -> Tr.carrier) (\ z -> Tr.proposition) Tr.inc ;
  inverse : Tr.carrier -> Q.Q = TC.rec X @l Q.Q prop Q.inc ;
  equivalence : Equiv Q.Q Tr.carrier = (forward,qinv _ _ forward inverse (\ z -> Tr.proposition _ z) (\ z -> prop _ z)) ;
} ;
