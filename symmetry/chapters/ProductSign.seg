-- Exercise 4.5.4 on loops of the small product group, including E empty.
level l ; open Base ; open Prelude[l+] ; open Paths[l+] ; open Logic[l] ;
module C = SignComputation[l] ; module T = TwoElementSets[l] ; module Y = SignOrderings[l].Component[T.two] ;
module LC = LoopConj[l+] ; module CP = PointedComponent[l+] ;
module F = FiniteSets[l] ; module CG = ChapterFour[l] ; module P = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Measure (X : U l+) (f : X -> Y.large) {
  family (z : X) : U l = (f z).1 ;
  value (x : X) (p : Id X x x) : Bool = C.Bit[family x,(f x).2].value (C.Move[X,family,x].equiv x p) ;
  trivial (x : X) : Id Bool (value x (refl x)) false = SignLaws[l].Laws[family x,(f x).2].unit ;
  conjugate (x : X) (p : Id X x x) (y : X) (k : Id X x y) : Id Bool (value y (LC.conj X x y k p)) (value x p) =
    idJ X x (\ z r -> Id Bool (value z (LC.conj X x z r p)) (value x p)) (apH (value x) (LC.conj-refl-loop X x p)) y k ;
} ;
module Change (X Z : U l+) (f : X -> Z) (g : Z -> Y.large) (x : X) {
  module A = Measure[X,\ t -> g (f t)] ; module B = Measure[Z,g] ;
  act (y : X) (p : Id X x y) : Id (P.Equiv (g (f x)).1 (g (f y)).1)
    (C.Move[Z,B.family,f x].equiv (f y) (apH f p)) (C.Move[X,A.family,x].equiv y p) =
    idJ X x (\ z r -> Id (P.Equiv (g (f x)).1 (g (f z)).1) (C.Move[Z,B.family,f x].equiv (f z) (ap X Z f x z r))
      (C.Move[X,A.family,x].equiv z r)) (refl (P.idEquiv (g (f x)).1)) y p ;
  law (p : Id X x x) : Id Bool (B.value (f x) (apH f p)) (A.value x p) = apH C.Bit[(g (f x)).1,(g (f x)).2].value (act x p) ;
} ;
module View = Measure[Y.large,\ y -> y] ;
module Small = Measure[Y.G.group.space,Y.presentation.1] ;
-- Changing to the replacement presentation preserves the permutation bit.
module Lifted (X : U l) (x : X) (V : U l+) (v : V) (f : X -> V) (path : Id V (f x) v)
  (classify : V -> Y.large) (point : Id Y.G.group.space (Y.presentation.2.sec (classify (f x))) Y.G.pt) {
  map (t : X) : Y.G.group.space = Y.presentation.2.sec (classify (f t)) ;
  hom : Lemma4[l].PtMap X x Y.G.group.space Y.G.pt = (map,point) ;
  module D = DeloopMaps[l].Maps[X,x,Y.G.group.space,Y.G.pt] ; module V0 = Measure[V,classify] ;
  at (q : Id X x x) : Id V v v = LC.conj V _ v path (apH f q) ;
  source (t : X) : Y.large = Y.presentation.1 (map t) ; target (t : X) : Y.large = classify (f t) ;
  H (t : X) : Id Y.large (source t) (target t) = Y.presentation.2.sec-eq (target t) ;
  module At (p : Id X x x) {
    natural : Id Bool (View.value (target x) (apH target p)) (View.value (source x) (apH source p)) =
      transH (apH (View.value (target x)) (LC.ap-homotopy X Y.large source target H x x p))
        (View.conjugate (source x) (apH source p) (target x) (H x)) ;
    raw : Id Bool (Small.value Y.G.pt ((D.loop hom).1 p)) (Measure[X,source].value x p) =
      transH (apH (Small.value Y.G.pt) (D.loop-ap hom p)) (transH (Small.conjugate (map x) (apH map p) Y.G.pt point)
        (Change[X,Y.G.group.space,map,Y.presentation.1,x].law p)) ;
    value : Id Bool (Small.value Y.G.pt ((D.loop hom).1 p)) (V0.value v (at p)) = transH raw
      (transH (symH (Change[X,Y.large,source,\ y -> y,x].law p)) (transH (symH natural) (transH
        (Change[X,Y.large,target,\ y -> y,x].law p) (transH (symH (Change[X,V,f,classify,x].law p))
          (symH (V0.conjugate (f x) (apH f p) v path)))))) ;
  } ;
} ;

module Product (E : U l) (fin : F.Finite E) {
  module M = SignOrderings[l].Product[E,fin] ; module P0 = C.Product[E,fin] ;
  X : U l = M.G.space ; o : X = M.G.point ; module D = ChapterSeven[l].Homomorphisms[M.G.group,Y.G.group].D ;
  loops : U l = Id X o o ; module Count = FiniteParity[l].On[E,fin] ;
  module Input (i : E) { module B = Measure[X,\ v -> Y.presentation.1 (v i)] ; } ;
  bits (p : loops) (i : E) : Bool = Input[i].B.value o p ;
  output (f : CG.Hom M.G.group Y.G.group) (p : loops) : Bool = Small.value Y.G.pt ((D.loop f).1 p) ;
  module Nonempty (h : Truncation[l].Trunc[E].carrier) {
    module Q = M.Nonempty[h] ; module A = P0.Nonempty[h] ; module L = Measure[M.families,Q.classify] ;
    module In (i : E) { module I = Measure[M.families,\ v -> v i] ; } ;
    module Lift = Lifted[X,o,M.families,M.standard,Q.unpack,Q.law,Q.classify,Q.point] ;
    module At (p : loops) {
      raw : Id M.families (Q.unpack o) (Q.unpack o) = apH Q.unpack p ;
      q : Id M.families M.standard M.standard = LC.conj M.families _ _ Q.law raw ;
      input (i : E) : Id Bool (A.bits q i) (bits p i) = transH (In[i].I.conjugate (Q.unpack o) raw M.standard Q.law)
        (Change[X,M.families,Q.unpack,\ v -> v i,o].law p) ;
      product : Id Bool (output Q.hom p) (Count.parity (bits p)) = transH Lift.At[p].value
        (transH (A.computes q) (apH Count.parity (FL.funext E (\ i -> Bool) (A.bits q) (bits p) input))) ;
    } ;
  } ;
  module EmptyIndex (k : Truncation[l].Trunc[M.Search.total].carrier -> Empty) {
    empty (i : E) : Empty = k (Truncation[l].Trunc[M.Search.total].inc (i,tt)) ;
    paths : P.isProp X = FL.isProp-Pi E (\ i -> Y.G.group.space) (\ i -> absurd _ (empty i)) ;
    rule (f : CG.Hom M.G.group Y.G.group) (p : loops) : Id Bool (output f p) (Count.parity (bits p)) =
      transH (apH (output f) (P.prop-to-set X paths o o p (refl o))) (transH (apH (Small.value Y.G.pt) (D.loop f).2)
        (transH (Small.trivial Y.G.pt) (symH (transH (apH Count.parity (FL.funext E (\ i -> Bool) (bits p) (\ i -> false) (\ i -> absurd _ (empty i)))) Count.zero-law)))) ;
  } ;
  cases (p : loops) : (d : Dec Truncation[l].Trunc[M.Search.total].carrier) -> Id Bool (output (M.choose d) p) (Count.parity (bits p)) = split {
    yes s -> Nonempty[TruncationCombinators[l].map M.Search.total E (\ w -> w.1) s].At[p].product ; no k -> EmptyIndex[k].rule _ p } ;
  computes (p : loops) : Id Bool (output M.product p) (Count.parity (bits p)) = cases p M.Search.exists ;
} ;

