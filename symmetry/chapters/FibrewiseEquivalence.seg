-- A map of families over a base equivalence is a fibrewise equivalence
-- whenever it is an equivalence on total spaces.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module W = Whitehead[l] ; module FU = FunExtUA[l] ;
sing (A : U l) (x y : A) (p : Id A x y) : Id ((z : A) * Id A z y) (y,refl y) (x,p) =
  idJ A x (\ z q -> Id ((v : A) * Id A v z) (z,refl z) (x,q)) (refl (x,refl x)) y p ;
fibers (A B : U l) (e : Equiv A B) : (y : B) -> FU.isContr (W.fib A B e.1 y) =
  Axioms[l].UnivalenceLemmas[univ @l].eqind A (\ C d -> (y : C) -> FU.isContr (W.fib A C d.1 y))
    (\ y -> ((y,refl y),\ v -> sing A v.1 y v.2)) B e ;
module Over (A : U l) (P Q : A -> U l) (f : (a : A) -> P a -> Q a) {
  X : U l = (a : A) * P a ; Y : U l = (a : A) * Q a ;
  total (w : X) : Y = (w.1,f w.1 w.2) ;
  module Fiber (a : A) (y : Q a) {
    source : U l = W.fib (P a) (Q a) (f a) y ;
    target : U l = W.fib X Y total (a,y) ;
    include (w : source) : target = ((a,w.1),ap (Q a) Y (\ t -> (a,t)) _ _ w.2) ;
  } ;
  decode (w : X) (v : Y) (p : Id Y (total w) v) : Fiber[v.1,v.2].source =
    idJ Y (total w) (\ z q -> Fiber[z.1,z.2].source) (w.2,refl (f w.1 w.2)) v p ;
  retract (a : A) (x : P a) (y : Q a) (p : Id (Q a) (f a x) y) : Id (Fiber[a,y].source)
    (decode (a,x) (a,y) (Fiber[a,y].include (x,p)).2) (x,p) =
    idJ (Q a) (f a x) (\ z q -> Id (Fiber[a,z].source) (decode (a,x) (a,z) (Fiber[a,z].include (x,q)).2) (x,q))
      (refl (x,refl (f a x))) y p ;
  at (e : isEquiv X Y total) (a : A) : isEquiv (P a) (Q a) (f a) =
    W.contr-equiv _ _ (f a) (\ y -> HLevels[l].retract-contr (Fiber[a,y].source) (Fiber[a,y].target)
      Fiber[a,y].include (\ v -> decode v.1 (a,y) v.2) (\ w -> retract a w.1 y w.2) (fibers X Y (total,e) (a,y))) ;
} ;
module Square (A B : U l) (d : Equiv A B) (P : A -> U l) (Q : B -> U l)
  (f : (a : A) -> P a -> Q (d.1 a)) {
  module O = Over[A,P,\ a -> Q (d.1 a),f] ;
  Y : U l = (b : B) * Q b ;
  total (w : O.X) : Y = (d.1 w.1,f w.1 w.2) ;
  at (equiv : isEquiv O.X Y total) (a : A) : isEquiv (P a) (Q (d.1 a)) (f a) = O.at
    (W.cancel-equiv O.X O.Y Y O.total (ChapterTwo[l].change-base A B d Q).1 (ChapterTwo[l].change-base A B d Q).2 equiv) a ;
} ;
module Triangle (X Y Z : U l) (f : X -> Y) (g : X -> Z) (h : Y -> Z) (p : Id (X -> Z) (\ x -> h (f x)) g) {
  module E = Equivalences[l] ;
  forward (ef : isEquiv X Y f) (eh : isEquiv Y Z h) : isEquiv X Z g =
    subst (X -> Z) (isEquiv X Z) _ g p (E.compose X Y Z (f,ef) (h,eh)).2 ;
  composite (eg : isEquiv X Z g) : isEquiv X Z (\ x -> h (f x)) = subst (X -> Z) (isEquiv X Z) g _ (symH p) eg ;
  inner (eh : isEquiv Y Z h) (eg : isEquiv X Z g) : isEquiv X Y f = W.cancel-equiv X Y Z f h eh (composite eg) ;
  outer (ef : isEquiv X Y f) (eg : isEquiv X Z g) : isEquiv Y Z h = E.homotopy _ _
    (E.compose Y X Z (Bijection[l].inverse X Y (f,ef)) ((\ x -> h (f x)),composite eg)) h
    (\ y -> symH (apH h (ef.sec-eq y))) ;
} ;
total-equivalence (A B : U l) (e : Equiv A B) (P : A -> U l) (Q : B -> U l)
  (d : (a : A) -> Equiv (P a) (Q (e.1 a))) : Equiv ((a : A) * P a) ((b : B) * Q b) =
  Equivalences[l].compose _ _ _ (Fibres[l].sigma-equiv A P (\ a -> Q (e.1 a)) d) (ChapterTwo[l].change-base A B e Q) ;
