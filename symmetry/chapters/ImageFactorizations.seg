-- Section 2.17. Image factorizations through an embedding are unique.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module BP = Paths[l+] ; module T = Truncation[l] ;
module TC = TruncationCombinators[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module BL = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Of (A B : U l) (f : A -> B) {
  module C = FamilyClassifier[l].Over[B] ; module E = C.Embeddings ;
  src (e : E.arrows) : U l = e.1.1 ; inc (e : E.arrows) : src e -> B = e.1.2 ;
  fib (e : E.arrows) : B -> U l = C.fibres e.1 ;
  lift (e : E.arrows) : U l = (a : A) -> fib e (f a) ;
  covers (e : E.arrows) (g : lift e) : U l = (x : src e) -> T.Trunc[(a : A) * Id (src e) (g a).1 x].carrier ;
  factors (e : E.arrows) : U l = (g : lift e) * covers e g ;
  prop (e : E.arrows) : isProp (factors e) = isProp-Sigma (lift e) (covers e)
    (FL.isProp-Pi A (\ a -> fib e (f a)) (\ a -> e.2 (f a))) (\ g -> FL.isProp-Pi (src e)
      (\ x -> T.Trunc[(a : A) * Id (src e) (g a).1 x].carrier) (\ x -> T.Trunc[(a : A) * Id (src e) (g a).1 x].proposition)) ;
  factorizations : U l+ = (e : E.arrows) * factors e ;
  module I = RefinedImage[l].At[A,B,f] ;
  inclusion (w : I.image) : B = w.1 ;
  module P (y : B) { module F = ChapterTwo[l].Projection[B,I.mere,y] ; } ;
  embedding : E.arrows = ((I.image,inclusion),\ y -> retract-prop (P[y].F.fibre) (I.mere y)
    P[y].F.forward P[y].F.backward (\ z -> P[y].F.contract z.1 z.2) T.Trunc[I.fibre y].proposition) ;
  point (a : A) : I.image = (f a,T.Trunc[I.fibre (f a)].inc (a,refl (f a))) ;
  image-lift (a : A) : fib embedding (f a) = (point a,refl (f a)) ;
  cover (x : I.image) : T.Trunc[(a : A) * Id I.image (point a) x].carrier =
    TC.map (I.fibre x.1) ((a : A) * Id I.image (point a) x) (\ w -> (w.1,(I.Sub.At[point w.1].paths x).2.sec w.2)) x.2 ;
  center : factorizations = (embedding,image-lift,cover) ;
  module Any (e : E.arrows) (g : factors e) {
    to (y : B) : I.mere y -> fib e y = TC.rec (I.fibre y) @l _ (e.2 y)
      (\ w -> ((g.1 w.1).1,transH (g.1 w.1).2 w.2)) ;
    from (y : B) (z : fib e y) : I.mere y = TC.map ((a : A) * Id (src e) (g.1 a).1 z.1) (I.fibre y)
      (\ w -> (w.1,transH (symH (g.1 w.1).2) (transH (apH (inc e) w.2) z.2))) (g.2 z.1) ;
    family : Id (B -> Quotient[l].Prop) (C.subtype-classifier.1 embedding) (C.subtype-classifier.1 e) =
      BL.funext B (\ y -> Quotient[l].Prop) _ _ (\ y -> Quotient[l].prop-path _ _
        (\ z -> to y (P[y].F.forward z)) (\ z -> P[y].F.backward (from y z))) ;
    equal : Id E.arrows embedding e = Equivalences[l+].injective _ _ C.subtype-classifier.1 C.subtype-classifier.2 embedding e family ;
  } ;
  contractible : FunExtUA[l+].isContr factorizations = (center,\ w -> Big.Sigma-eq E.arrows (\ e -> factors e) _ _ _ _
    Any[w.1,w.2].equal (prop w.1)) ;
} ;
module Universal (A B : U l) (f : A -> B) {
  module I = Of[A,B,f] ; module S = ConnectedLaws[l].Surjection[A,I.I.image,I.point] ;
  image-set (s : isSet B) : isSet I.I.image = Torsor[l].isSet-sub B I.I.mere s (\ b -> T.Trunc[I.I.fibre b].proposition) ;
  module Predicate (P : B -> U l) (p : (b : B) -> isProp (P b)) {
    on-source : U l = (a : A) -> P (f a) ;
    on-image : U l = (z : I.I.image) -> P z.1 ;
    restriction (g : on-image) (a : A) : P (f a) = g (I.point a) ;
    extension : on-source -> on-image = S.With[I.cover].descend (\ z -> P z.1) (\ z -> p z.1) ;
    equivalence : Equiv on-image on-source = Bijection[l].prop-equiv _ _
      (FL.isProp-Pi I.I.image (\ z -> P z.1) (\ z -> p z.1)) (FL.isProp-Pi A (\ a -> P (f a)) (\ a -> p (f a))) restriction extension ;
  } ;
} ;
