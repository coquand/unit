-- Compute the sign of a loop by transporting any representative local ordering.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module SO = SignOrderings[l] ; module Two = TwoElementSets[l] ; module PQ = ParityQuotient[l] ;
module Big = Prelude[l+] ; module BP = Paths[l+] ; module Z = Z2[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bit (X : U l) (size : Two.size X) {
  module A = Two.At[X,size] ; module D = PQ.Distance[X,size] ;
  value (e : Equiv X X) : Bool = Two.Booleans.number (A.automorphisms.2.sec e) ;
  tail : (i : FinChoice[l].Fin Two.one) (x : X) -> Id Bool true (D.diff x ((A.choose-tail i).1 x)) = split {
    none -> \ x -> symH (D.apart x (A.other x) (\ h -> A.apart x (symH h))) ; some j -> absurd _ j } ;
  label : (i : Two.standard) (x : X) -> Id Bool (Two.Booleans.number i) (D.diff x ((A.choose i).1 x)) = split {
    none -> \ x -> symH (D.same x x (refl x)) ; some i -> tail i } ;
  at (e : Equiv X X) (x : X) : Id Bool (value e) (D.diff x (e.1 x)) = transH (label (A.automorphisms.2.sec e) x)
    (apH (\ d -> D.diff x (d.1 x)) (A.automorphisms.2.sec-eq e)) ;
} ;
module Move (A : U l+) (P : A -> U l) (a : A) {
  equiv (b : A) (p : Id A a b) : Equiv (P a) (P b) =
    idJ A a (\ z q -> Equiv (P a) (P z)) (idEquiv (P a)) b p ;
} ;
module Orientation (A : U l+) (E : A -> U l) (finite : (a : A) -> FiniteSets[l].Finite (E a))
  (P : (a : A) -> E a -> U l) (size : (a : A) (i : E a) -> Two.size (P a i)) {
  module At (a : A) { module Q = PQ.Family[E a,finite a,P a,size a] ; } ;
  orders (a : A) : U l = At[a].Q.sections ; orientation (a : A) : U l = At[a].Q.Q.Q ;
  module From (a : A) (f : orders a) {
    module Q = At[a].Q ;
    section (b : A) (p : Id A a b) : orders b = (Move[A,orders,a].equiv b p).1 f ;
    action (b : A) (p : Id A a b) : Id (orientation b) ((Move[A,orientation,a].equiv b p).1 (Q.Q.inc f)) (At[b].Q.Q.inc (section b p)) =
      idJ A a (\ t r -> Id (orientation t) ((Move[A,orientation,a].equiv t r).1 (Q.Q.inc f)) (At[t].Q.Q.inc (section t r))) (refl (Q.Q.inc f)) b p ;
    module Loop (p : Id A a a) {
      e : Equiv (orientation a) (orientation a) = Move[A,orientation,a].equiv a p ;
      g : orders a = section a p ;
      fixed : U l = Id (orientation a) (Q.Q.inc f) (e.1 (Q.Q.inc f)) ;
      module D = Q.Based[f] ;
      to (h : fixed) : Q.rel f g = transH (symH (D.D.beta g))
        (transH (apH D.D.map (symH (transH h (action a p)))) (transH (D.D.beta f) (Q.reflexive f))) ;
      from (h : Q.rel f g) : fixed = transH (Q.Q.relates f g h) (symH (action a p)) ;
      module Nonempty (sz : Two.size (orientation a)) {
        module V = Bit[orientation a,sz] ;
        same (h : Q.rel f g) : Id Bool (V.value e) (Q.distance f g) = transH (V.at e (Q.Q.inc f))
          (transH (V.D.same _ _ (from h)) (symH h)) ;
        odd (h : Id Bool (Q.distance f g) true) : Id Bool (V.value e) (Q.distance f g) = transH (V.at e (Q.Q.inc f))
          (transH (V.D.apart _ _ (\ q -> TruthValues[l].separate (transH (symH h) (to q)))) (symH h)) ;
        choose : (b : Bool) -> Id Bool (Q.distance f g) b -> Id Bool (V.value e) (Q.distance f g) = split { false -> same ; true -> odd } ;
        computes : Id Bool (V.value e) (Q.Index.parity (Q.differences f g)) = choose (Q.distance f g) (refl (Q.distance f g)) ;
      } ;
    } ;
  } ;
} ;
module Sign (n : Nat) {
  module D = SO.Degree[n] ;
  module O = Orientation[D.Dom.large,\ v -> D.At[v].O.pairs,\ v -> D.At[v].O.finite-pairs,\ v -> D.At[v].O.carrier,\ v -> D.At[v].O.size] ;
  module At (a : D.Dom.large) {
    module V = Bit[(D.classify a).1,(D.classify a).2] ;
    sign (p : Id D.Dom.large a a) : Bool = V.value (Move[D.Dom.large,O.orientation,a].equiv a p) ;
    computes (p : Id D.Dom.large a a) (f : O.orders a) : Id Bool (sign p)
      (D.At[a].O.Par.distance f (O.From[a,f].section a p)) = O.From[a,f].Loop[p].Nonempty[D.At[a].size].computes ;
  } ;
} ;
module Product (E : U l) (finite : FiniteSets[l].Finite E) {
  module M = SO.Product[E,finite] ;
  module O = Orientation[M.families,\ v -> E,\ v -> finite,\ v i -> (v i).1,\ v i -> (v i).2] ;
  module Nonempty (h : Truncation[l].Trunc[E].carrier) {
    module Q = M.Nonempty[h] ; module A = M.At[M.standard].P ; module L = O.From[M.standard,Q.section] ;
    action (v : M.families) (p : Id M.families M.standard v) (i : E) : Id ((v i).1) (L.section v p i)
      ((Move[M.families,\ u -> (u i).1,M.standard].equiv v p).1 none) =
      idJ M.families M.standard (\ u r -> Id ((u i).1) (L.section u r i) ((Move[M.families,\ w -> (w i).1,M.standard].equiv u r).1 none)) (refl (Q.section i)) v p ;
    component (p : Id M.families M.standard M.standard) (i : E) : Equiv Two.standard Two.standard = Move[M.families,\ u -> (u i).1,M.standard].equiv M.standard p ;
    bits (p : Id M.families M.standard M.standard) (i : E) : Bool = Bit[Two.standard,Two.base.2].value (component p i) ;
    computes (p : Id M.families M.standard M.standard) : Id Bool
      (Bit[A.Q.Q,A.two h].value (L.Loop[p].e)) (FiniteParity[l].On[E,finite].parity (bits p)) =
      transH L.Loop[p].Nonempty[A.two h].computes (apH A.Index.parity (FL.funext E (\ i -> Bool) _ _ (\ i ->
        transH (apH (PQ.Distance[Two.standard,Two.base.2].diff none) (action M.standard p i)) (symH (Bit[Two.standard,Two.base.2].at (component p i) none))))) ;
  } ;
} ;

module Crossings (n : Nat) {
  module D = SO.Degree[n] ; module S = Sign[n] ;
  V : U l+ = D.Dom.large ; A : V = D.Dom.base ; X : U l = A.1 ;
  pairs (v : V) : U l = D.At[v].O.pairs ;
  module P = D.At[A].O ; module Par = P.Par ;
  -- Apply the least-member search directly to the predicates in this presentation.
  least (z : pairs A) : P.carrier z = D.S.choose (z.1,Prelude[l].trans _ _ _ _
    (ap (FiniteSets[l].Finite X) Nat (\ t -> SO.Subsets[X,t].number z.1) _ _
      (FiniteSets[l].Universe.finite-prop X D.S.finite (D.fin A))) z.2)
    (FiniteDecisions[l].search D.S.N (P.member z.1) (\ i -> TruthValues[l].decide (z.1 i))) ;
  carrier (v : V) : U l = v.1 ;
  image (v : V) (p : Id V A v) : Equiv X v.1 = Move[V,carrier,A].equiv v p ;
  pull (v : V) (p : Id V A v) : Equiv (pairs v) (pairs A) = Move[V,pairs,v].equiv A (BP.symH p) ;
  old (v : V) (p : Id V A v) (z : pairs v) : X = (least ((pull v p).1 z)).1 ;
  moved (v : V) (p : Id V A v) (z : pairs v) : Id v.1 ((S.O.From[A,least].section v p z).1) ((image v p).1 (old v p z)) =
    idJ V A (\ t r -> (w : pairs t) -> Id t.1 ((S.O.From[A,least].section t r w).1) ((image t r).1 (old t r w))) (\ w -> refl (least w).1) v p z ;
  module Permutation (e : Equiv X X) {
    module Sub = ChapterTwo[l+].Subtype[U l,\ Y -> D.Dom.codes Y,\ Y -> Truncation[l].Trunc[Equiv X Y].proposition] ;
    ua : Id (U l) X X = Axioms[l].UnivalenceLemmas[univ @l].ua X X e ;
    loop : Id V A A = (Sub.At[A].paths A).2.sec ua ;
    identifies (v : V) (p : Id V A v) (x : X) : Id v.1 ((image v p).1 x) (coe X v.1 (Big.ap V (U l) carrier A v p) x) =
      idJ V A (\ t r -> Id t.1 ((image t r).1 x) (coe X t.1 (Big.ap V (U l) carrier A t r) x)) (refl x) v p ;
    applies (x : X) : Id X ((image A loop).1 x) (e.1 x) = transH (identifies A loop x)
      (transH (BP.apH (\ r -> coe X X r x) ((Sub.At[A].paths A).2.sec-eq ua)) (Axioms[l].UnivalenceLemmas[univ @l].ua-beta X X e x)) ;
    -- For each target pair compare its least member with the image of the
    -- least member of its inverse image. A disagreement is one crossing.
    old-first (z : pairs A) : X = e.1 (old A loop z) ;
    flips (z : pairs A) : Bool = PQ.flag (Id X (least z).1 (old-first z))
      (FiniteDecisions[l].standard D.S.N (least z).1 (old-first z)) ;
    g : Par.sections = S.O.From[A,least].section A loop ;
    value (z : pairs A) : Id X (g z).1 (old-first z) = transH (moved A loop z) (applies (old A loop z)) ;
    module At (z : pairs A) {
      module Vz = PQ.Distance[P.carrier z,P.size z] ;
      prob : U l = Id X (least z).1 (old-first z) ;
      hit (h : prob) : Id Bool (Par.differences least g z) false = Vz.same (least z) (g z) (Sigma-eq X (P.member z.1) _ _ _ _
        (transH h (symH (value z))) (TruthValues[l].truth (z.1 (g z).1)).2) ;
      miss (h : prob -> Empty) : Id Bool (Par.differences least g z) true = Vz.apart (least z) (g z) (\ r -> h
        (transH (ap (P.carrier z) X (\ w -> w.1) _ _ r) (value z))) ;
      bit : (d : Logic[l].Dec prob) -> Id Bool (Par.differences least g z) (PQ.flag prob d) = split { yes h -> hit h ; no h -> miss h } ;
    } ;
    crossings : Nat = FiniteCounting[l].Indexed[pairs A,P.finite-pairs,\ z -> FiniteParity[l].bit (flips z)].value ;
    sign-rule : Id Bool (S.At[A].sign loop) (Z.rhoN crossings) = transH (S.At[A].computes loop least)
      (apH Par.Index.parity (FL.funext (pairs A) (\ z -> Bool) (Par.differences least g) flips (\ z -> At[z].bit (FiniteDecisions[l].standard D.S.N (least z).1 (old-first z))))) ;
  } ;
} ;
