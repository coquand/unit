-- Example 4.2.23 and Exercises 4.2.24-25. Factor the circle map sending
-- the generator to rotation through the small group of the standard cycle.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module E = Equivalences[l] ; module BP = Paths[l+] ; module H = HLevels[l] ;
module C = Connected[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module LC = LoopConj[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Map (G K : CG.ConcreteGroup) (f : CG.Hom G K) {
  module D = ChapterSeven[l].Homomorphisms[G,K] ; module U0 = D.Underlying[f] ; module V = FibreLevels[l].Of[G.space,K.space,f.1] ;
  source : U l = D.A.carrier ; target : U l = D.B.carrier ;
  module Surjection (hit : (y : target) -> (p : source) * Id target (U0.f.1 p) y) {
    raw (y : V.paths G.point G.point) : V.over G.point G.point y = ((hit (U0.c y)).1,
      transH (symH (LC.conj-back K.space _ _ f.2 (U0.raw (hit (U0.c y)).1))) (transH
        (apH (LC.conj K.space _ _ (symH f.2)) (transH (symH (D.D.loop-ap f (hit (U0.c y)).1)) (hit (U0.c y)).2)) (LC.conj-back K.space _ _ f.2 y))) ;
    covers (x y : G.space) : U l = (z : V.paths x y) -> T.Trunc[V.over x y z].carrier ;
    all : (x y : G.space) -> covers x y = C.conn-elim2 zero G.space G.point G.connected covers
      (\ x y -> FL.isProp-Pi (V.paths x y) (\ z -> T.Trunc[V.over x y z].carrier) (\ z -> T.Trunc[V.over x y z].proposition))
      (\ z -> T.Trunc[V.over G.point G.point z].inc (raw z)) ;
    connected (b : K.space) : C.isConn CG.two (V.S.fibre b) =
      (TC.map (Id K.space (f.1 G.point) b) (V.S.fibre b) (\ p -> (G.point,p)) ((K.connected.2 (f.1 G.point) b).1),
       \ u v -> (TC.map (V.over u.1 v.1 (V.difference b u v)) (Id (V.S.fibre b) u v) (V.identify u.1 v.1 b v.2 u.2).1
          (all u.1 v.1 (V.difference b u v)),\ p q -> tt)) ;
  } ;
  module Injective (inj : (p q : source) -> Id target (U0.f.1 p) (U0.f.1 q) -> Id source p q) {
    raw (p q : source) (r : Id (V.paths G.point G.point) (U0.raw p) (U0.raw q)) : Id source p q =
      inj p q (transH (D.D.loop-ap f p) (transH (apH U0.c r) (symH (D.D.loop-ap f q)))) ;
    module At = FibreLevels[l].Of[source,V.paths G.point G.point,U0.raw].SetTarget[H.trunc-set _ (K.groupoid (f.1 G.point) (f.1 G.point))] ;
    truncated (b : K.space) : H.isTrunc CG.two (V.S.fibre b) = V.based (suc zero) G.point G.connected
      (\ z -> H.prop-trunc zero _ (At.from raw z)) b ;
  } ;
} ;
module Degree (n : Nat) {
  module F = CycleComponents[l].Finite[n] ; module Gen = CyclicGenerator[l].Standard[n] ;
  module P = PermutationLoops[l].At[F.standard] ; module G = F.Cyc ;
  X : U l = FinChoice[l].Fin (suc n) ; module K = BicycleGroups[l].Permutations[X,FiniteCycles[l].fin-set (suc n)] ;
  module M = ChapterSeven[l].OrdinaryMaps[G.group,K.G.group] ;
  send (p : P.J.carrier) : K.S.carrier = K.decode.2.sec (P.encode.1 p).1 ;
  label (p : P.J.carrier) (x : X) : Id X ((K.decode.1 (send p)).1 x) ((P.encode.1 p).1.1 x) =
    apH (\ e -> e.1 x) (K.decode.2.sec-eq (P.encode.1 p).1) ;
  law (p q : P.J.carrier) : Id K.S.carrier (send (P.J.abstract.mul p q)) (K.S.abstract.mul (send p) (send q)) =
    E.injective _ _ K.decode.1 K.decode.2 _ _ (PermutationCount[l].ext X X _ _ (\ x -> transH (label (P.J.abstract.mul p q) x)
      (transH (BP.apH (\ r -> (P.I.tr F.standard r).1.1 x) (P.based-mul p q)) (transH (P.comp F.standard F.standard (P.based.1 q) F.standard (P.based.1 p) x)
        (symH (transH (K.mul (send p) (send q) x) (transH (label p ((K.decode.1 (send q)).1 x)) (apH (P.encode.1 p).1.1 (label q x))))))))) ;
  h : M.ordinary = (send,law) ; projection : CG.Hom G.group K.G.group = M.comparison.2.sec h ;
  computes (p : P.J.carrier) : Id K.S.carrier ((M.M.D.loop projection).1 p) (send p) = apH (\ g -> g.1 p) (M.comparison.2.sec-eq h) ;
  inj (p q : P.J.carrier) (v : Id K.S.carrier ((M.M.D.loop projection).1 p) ((M.M.D.loop projection).1 q)) : Id P.J.carrier p q =
    E.injective _ _ P.encode.1 P.encode.2 _ _ (Sigma-eq _ (\ e -> CycleComponents[l].From[F.standard].Comm X e F.standard.2) _ _ _ _
      (transH (symH (K.decode.2.sec-eq (P.encode.1 p).1)) (transH (apH K.decode.1 (transH (symH (computes p)) (transH v (computes q))))
        (K.decode.2.sec-eq (P.encode.1 q).1))) (CycleComponents[l].From[F.standard].law-prop X (FiniteCycles[l].fin-set (suc n)) (P.encode.1 q).1 F.standard.2)) ;
  module Truncated = Map[G.group,K.G.group,projection].Injective[inj] ;
  Z : CG.ConcreteGroup = CG.integer-group ;
  module Circle = CircleProperty[l].Circle[G.space] ; module B = ChapterSeven[l].Homomorphisms[Z,G.group] ;
  cover : CG.Hom Z G.group = (CG.integer-hom G.group).2.sec Gen.generator ;
  module U0 = B.Underlying[cover] ;
  generator : Id P.J.carrier (U0.f.1 Circle.g) Gen.generator = transH (symH (Circle.evPt-loop G.pt cover)) ((CG.integer-hom G.group).2.sec-eq Gen.generator) ;
  module Pow = CyclicHom[l,l].Powers[B.A.abstract,Circle.g] ;
  powers : (k : Nat) -> Id P.J.carrier (U0.f.1 (Pow.power k)) (Gen.Hom.JP.power k) = split {
    zero -> U0.f.2 ; suc k | r -> transH (U0.law Circle.g (Pow.power k)) (transH (apH (\ a -> P.J.abstract.mul a (U0.f.1 (Pow.power k))) generator) (apH (P.J.abstract.mul Gen.generator) r)) } ;
  hit (p : P.J.carrier) : (t : B.A.carrier) * Id P.J.carrier (U0.f.1 t) p =
    (Pow.power (Gen.Hom.generates p).1,transH (powers (Gen.Hom.generates p).1) (Gen.Hom.generates p).2) ;
  module CoverFibres = Map[Z,G.group,cover].Surjection[hit] ;
  bundle : CG.Hom Z K.G.group = CG.compose Z G.group K.G.group projection cover ;
  module Image = ZeroImage[l].Comparison[Z.space,G.space,K.G.group.space,bundle.1,cover.1,projection.1,\ x -> refl (bundle.1 x),
    CoverFibres.connected,Truncated.truncated] ;
  pt : Image.Im.space = Image.Im.quotient Z.point ;
  pointing : Id G.space (Image.down pt) G.pt = transH (Image.left Z.point) cover.2 ;
  group : CG.ConcreteGroup = new CG.ConcreteGroup[Image.Im.space,pt,Deloop[l].equiv-conn CG.two _ _ Image.equivalence G.group.connected,
    H.equiv-trunc CG.three _ _ Image.equivalence G.group.groupoid] ;
  equivalent : Lemma4[l].PtEquiv Image.Im.space pt G.space G.pt = ((Image.down,pointing),Image.equivalence.2) ;
  equality : Id CG.ConcreteGroup group G.group = GroupIdentity[l].concrete-path group G.group equivalent ;
  module Coordinates {
    module D = AlternatingComparison[l].PathsOf[Image.Im.space,G.space,UniverseChange[l+,l].raise-equiv _ _ Image.equivalence,pt] ;
    module L = BicycleGroups[l].Based[Image.Im.space,pt,G.space,G.pt,Image.down,pointing,(D.ap pt).2] ;
    module S = FiniteCycles[l].Centralizer[n] ; module R = FiniteCycles[l].Standard[n] ;
    loops : U l = Id Image.Im.space pt pt ;
    rotations : Equiv loops S.aut = E.compose _ _ _ (Truncations[l].lower _ _ L.loops) P.encode ;
    permutation (p : loops) : Equiv X X = (rotations.1 p).1 ;
    exponent (p : loops) : Nat = (R.reaches (S.eval (rotations.1 p))).1 ;
    generated (p : loops) (x : X) : Id X (R.iterate (exponent p) x) ((permutation p).1 x) =
      S.agree (S.shift (S.eval (rotations.1 p))) (rotations.1 p) (S.beta (S.eval (rotations.1 p))) x ;
    rotation (k : Nat) : S.aut = ((R.iterate k,S.equiv-power k),R.I.commute k) ;
    realize (k : Nat) : loops = rotations.2.sec (rotation k) ;
    action (k : Nat) (x : X) : Id X ((permutation (realize k)).1 x) (R.iterate k x) =
      apH (\ w -> w.1.1 x) (rotations.2.sec-eq (rotation k)) ;
  } ;
} ;
module Two = Degree[suc zero] ;
module Double {
  module A = Two ; module K = A.K ; module P = A.P ; module G = A.G ;
  module U0 = A.M.M.Underlying[A.projection] ;
  X : U l = A.X ;
  supply (p : K.S.carrier) : CycleComponents[l].From[A.F.standard].Iso A.F.standard =
    (K.decode.1 p,BicycleGroups[l].TwoPermutations.comm (K.decode.1 p) A.F.standard.2) ;
  pick (p : K.S.carrier) : P.J.carrier = P.encode.2.sec (supply p) ;
  beta (p : K.S.carrier) : Id K.S.carrier (U0.f.1 (pick p)) p = transH (A.computes (pick p))
    (transH (apH K.decode.2.sec (apH (\ w -> w.1) (P.encode.2.sec-eq (supply p)))) (sec-ret _ _ K.decode.1 K.decode.2 p)) ;
  loops : isEquiv P.J.carrier K.S.carrier U0.f.1 = qinv _ _ U0.f.1 pick beta (\ x -> A.inj _ _ (beta (U0.f.1 x))) ;
  equiv : isEquiv G.space K.G.group.space A.projection.1 =
    Whitehead[l].Pointed[G.space,G.pt,K.G.group.space,K.G.pt,A.projection,G.group.connected,loops].equiv K.G.group.connected ;
  cyclic-symmetric : Id CG.ConcreteGroup G.group K.G.group = GroupIdentity[l].concrete-path G.group K.G.group (A.projection,equiv) ;
  module Im = A.Image ;
  contractible (b : K.G.group.space) : FunExtUA[l].isContr (Im.T b) = H.retract-contr _ _ Im.Down[b].map (Im.over b)
    (Im.Forth[b].E.ext Im.Forth[b].at) (FibrewiseEquivalence[l].fibers _ _ (A.projection.1,equiv) b) ;
} ;

-- Example 4.2.22. Carry the component of a permutation across circle
-- monodromy and compare its small group directly to the bundle component.
module BundlePresentation (v : CycleComponents[l].Perm) {
  module CC = CycleComponents[l] ; module G = CC.Component[v] ; module F = CircleBundles[l] ;
  module Big = Prelude[l+] ; module BH = HLevels[l+] ; module BE = Equivalences[l+] ;
  bundles : U l+ = F.C.Circle -> F.Set ; bundle : bundles = F.monodromy.2.sec v ;
  groupoid (a b : CC.Perm) : BH.isTrunc CG.two (Id CC.Perm a b) = BH.equiv-trunc CG.two _ _
    (CC.From[a].IdSystem.tr b,CC.From[a].IdSystem.equiv b) (BH.set-trunc _ (CC.From[a].set b)) ;
  module A = ChapterFour[l+].Automorphisms[CC.Perm,groupoid,v] ;
  module U0 = Axioms[l+].UnivalenceLemmas[univ @(l+)] ;
  component (X : U l+) (x : X) : U l+ = (y : X) * Truncation[l+].Trunc[Id X x y].carrier ;
  base (X : U l+) (x : X) : component X x = (x,Truncation[l+].Trunc[Id X x x].inc (refl x)) ;
  module Move (X : U l+) (x : X) {
    change (Y : U l+) (e : Big.Equiv X Y) : Lemma4[l+].PtEquiv (component X x) (base X x) (component Y (e.1 x)) (base Y (e.1 x)) =
      U0.eqind X (\ Z d -> Lemma4[l+].PtEquiv (component X x) (base X x) (component Z (d.1 x)) (base Z (d.1 x)))
        (((\ z -> z),refl (base X x)),(Big.idEquiv (component X x)).2) Y e ;
  } ;
  module K = Move[CC.Perm,v] ;
  to-bundle : Lemma4[l+].PtEquiv A.B A.pt (component bundles bundle) (base bundles bundle) = K.change bundles (Bijection[l+].inverse _ _ F.monodromy) ;
  pt : Id A.B (G.C.presentation.1 G.pt) A.pt = Big.Sigma-eq CC.Perm A.membership _ _ _ _ G.C.path-at-point Truncation[l+].Trunc[Id CC.Perm v v].proposition ;
  display : Big.Equiv G.space (component bundles bundle) = BE.compose _ _ _ G.C.presentation (to-bundle.1.1,to-bundle.2) ;
  pointed : Lemma4[l+].PtEquiv G.space G.pt (component bundles bundle) (base bundles bundle) =
    ((display.1,BP.transH (BP.apH to-bundle.1.1 pt) to-bundle.1.2),display.2) ;
} ;
