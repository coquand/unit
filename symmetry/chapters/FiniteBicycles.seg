-- Definition 4.6.3 and the two six-pointed examples of Exercise 4.6.14.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open BicycleExamples[l] ;
module Six {
  data X : U l = k0 | k1 | k2 | k3 | k4 | k5 ;
  v0 : X = k0 ;
  v1 : X = k1 ;
  v2 : X = k2 ;
  v3 : X = k3 ;
  v4 : X = k4 ;
  v5 : X = k5 ;
  n : Nat = (suc (suc (suc (suc (suc (suc zero)))))) ;
  cases (P : X -> U l) (v0 : P k0) (v1 : P k1) (v2 : P k2) (v3 : P k3) (v4 : P k4) (v5 : P k5) : (x : X) -> P x =
    split { k0 -> v0 ; k1 -> v1 ; k2 -> v2 ; k3 -> v3 ; k4 -> v4 ; k5 -> v5 } ;
  index : X -> FinChoice[l].Fin n = split { k0 -> none ; k1 -> (some none) ; k2 -> (some (some none)) ; k3 -> (some (some (some none))) ; k4 -> (some (some (some (some none)))) ; k5 -> (some (some (some (some (some none))))) } ;
  decode5 : FinChoice[l].Fin (suc zero) -> X = split { none -> k5 ; some i -> absurd X i } ;
  decode4 : FinChoice[l].Fin (suc (suc zero)) -> X = split { none -> k4 ; some i -> decode5 i } ;
  decode3 : FinChoice[l].Fin (suc (suc (suc zero))) -> X = split { none -> k3 ; some i -> decode4 i } ;
  decode2 : FinChoice[l].Fin (suc (suc (suc (suc zero)))) -> X = split { none -> k2 ; some i -> decode3 i } ;
  decode1 : FinChoice[l].Fin (suc (suc (suc (suc (suc zero))))) -> X = split { none -> k1 ; some i -> decode2 i } ;
  decode0 : FinChoice[l].Fin (suc (suc (suc (suc (suc (suc zero)))))) -> X = split { none -> k0 ; some i -> decode1 i } ;
  eta : (v : X) -> Id X (decode0 (index v)) v = split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  set : isSet X = HLevels[l].trunc-set X (HLevels[l].retract-trunc (suc (suc zero)) X (FinChoice[l].Fin n) index decode0 eta
    (HLevels[l].set-trunc _ (FiniteCycles[l].fin-set n))) ;
} ;
module Eight {
  data X : U l = k0 | k1 | k2 | k3 | k4 | k5 | k6 | k7 ;
  n : Nat = (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) ;
  cases (P : X -> U l) (v0 : P k0) (v1 : P k1) (v2 : P k2) (v3 : P k3) (v4 : P k4) (v5 : P k5) (v6 : P k6) (v7 : P k7) : (x : X) -> P x =
    split { k0 -> v0 ; k1 -> v1 ; k2 -> v2 ; k3 -> v3 ; k4 -> v4 ; k5 -> v5 ; k6 -> v6 ; k7 -> v7 } ;
  index : X -> FinChoice[l].Fin n = split { k0 -> none ; k1 -> (some none) ; k2 -> (some (some none)) ; k3 -> (some (some (some none))) ; k4 -> (some (some (some (some none)))) ; k5 -> (some (some (some (some (some none))))) ; k6 -> (some (some (some (some (some (some none)))))) ; k7 -> (some (some (some (some (some (some (some none))))))) } ;
  decode7 : FinChoice[l].Fin (suc zero) -> X = split { none -> k7 ; some i -> absurd X i } ;
  decode6 : FinChoice[l].Fin (suc (suc zero)) -> X = split { none -> k6 ; some i -> decode7 i } ;
  decode5 : FinChoice[l].Fin (suc (suc (suc zero))) -> X = split { none -> k5 ; some i -> decode6 i } ;
  decode4 : FinChoice[l].Fin (suc (suc (suc (suc zero)))) -> X = split { none -> k4 ; some i -> decode5 i } ;
  decode3 : FinChoice[l].Fin (suc (suc (suc (suc (suc zero))))) -> X = split { none -> k3 ; some i -> decode4 i } ;
  decode2 : FinChoice[l].Fin (suc (suc (suc (suc (suc (suc zero)))))) -> X = split { none -> k2 ; some i -> decode3 i } ;
  decode1 : FinChoice[l].Fin (suc (suc (suc (suc (suc (suc (suc zero))))))) -> X = split { none -> k1 ; some i -> decode2 i } ;
  decode0 : FinChoice[l].Fin (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) -> X = split { none -> k0 ; some i -> decode1 i } ;
  eta : (v : X) -> Id X (decode0 (index v)) v = split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  set : isSet X = HLevels[l].trunc-set X (HLevels[l].retract-trunc (suc (suc zero)) X (FinChoice[l].Fin n) index decode0 eta
    (HLevels[l].set-trunc _ (FiniteCycles[l].fin-set n))) ;
} ;
positive : Z.Int = pos (suc zero) ;
red : B.letter = left positive ; blue : B.letter = right positive ;
module Quaternion {
  open Eight ;
  a : X -> X = split { k0 -> k1 ; k1 -> k4 ; k2 -> k3 ; k3 -> k6 ; k4 -> k5 ; k5 -> k0 ; k6 -> k7 ; k7 -> k2 } ;
  a-back : X -> X = split { k0 -> k5 ; k1 -> k0 ; k2 -> k7 ; k3 -> k2 ; k4 -> k1 ; k5 -> k4 ; k6 -> k3 ; k7 -> k6 } ;
  a-right : (v : X) -> Id X (a (a-back v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  a-left : (v : X) -> Id X (a-back (a v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  a-equiv : Equiv X X = (a,qinv X X a a-back a-right a-left) ;
  b : X -> X = split { k0 -> k7 ; k1 -> k6 ; k2 -> k1 ; k3 -> k0 ; k4 -> k3 ; k5 -> k2 ; k6 -> k5 ; k7 -> k4 } ;
  b-back : X -> X = split { k0 -> k3 ; k1 -> k2 ; k2 -> k5 ; k3 -> k4 ; k4 -> k7 ; k5 -> k6 ; k6 -> k1 ; k7 -> k0 } ;
  b-right : (v : X) -> Id X (b (b-back v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  b-left : (v : X) -> Id X (b-back (b v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  b-equiv : Equiv X X = (b,qinv X X b b-back b-right b-left) ;
  module R = Routes[X,a-equiv,b-equiv] ;
  paths : (v : X) -> R.A.route k0 v = split {
    k0 -> (nil,refl k0) ;
    k1 -> ((cons red nil),refl k1) ;
    k2 -> ((cons red (cons blue nil)),refl k2) ;
    k3 -> ((cons blue (cons red (cons red nil))),refl k3) ;
    k4 -> ((cons red (cons red nil)),refl k4) ;
    k5 -> ((cons red (cons red (cons red nil))),refl k5) ;
    k6 -> ((cons blue (cons red nil)),refl k6) ;
    k7 -> ((cons blue nil),refl k7) } ;
  bicycle : B.Bicycle = R.Based[k0,paths].bicycle set ;
  group : ChapterFour[l].ConcreteGroup = B.Component[bicycle].group ;
  module M = B.Maps[bicycle,bicycle] ; module N = B.Normality[bicycle] ;
  r : X -> X = split { k0 -> k1 ; k1 -> k4 ; k2 -> k7 ; k3 -> k2 ; k4 -> k5 ; k5 -> k0 ; k6 -> k3 ; k7 -> k6 } ;
  r-back : X -> X = split { k0 -> k5 ; k1 -> k0 ; k2 -> k3 ; k3 -> k6 ; k4 -> k1 ; k5 -> k4 ; k6 -> k7 ; k7 -> k2 } ;
  r-right : (v : X) -> Id X (r (r-back v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  r-left : (v : X) -> Id X (r-back (r v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  r-equiv : Equiv X X = (r,qinv X X r r-back r-right r-left) ;
  r-a : (v : X) -> Id X (r (a v)) (a (r v)) =
    split { k0 -> refl k4 ; k1 -> refl k5 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k0 ; k5 -> refl k1 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  r-b : (v : X) -> Id X (r (b v)) (b (r v)) =
    split { k0 -> refl k6 ; k1 -> refl k3 ; k2 -> refl k4 ; k3 -> refl k1 ; k4 -> refl k2 ; k5 -> refl k7 ; k6 -> refl k0 ; k7 -> refl k5 } ;
  r-sym : M.iso = (r-equiv,r-a,r-b) ;
  s : X -> X = split { k0 -> k7 ; k1 -> k2 ; k2 -> k5 ; k3 -> k0 ; k4 -> k3 ; k5 -> k6 ; k6 -> k1 ; k7 -> k4 } ;
  s-back : X -> X = split { k0 -> k3 ; k1 -> k6 ; k2 -> k1 ; k3 -> k4 ; k4 -> k7 ; k5 -> k2 ; k6 -> k5 ; k7 -> k0 } ;
  s-right : (v : X) -> Id X (s (s-back v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  s-left : (v : X) -> Id X (s-back (s v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  s-equiv : Equiv X X = (s,qinv X X s s-back s-right s-left) ;
  s-a : (v : X) -> Id X (s (a v)) (a (s v)) =
    split { k0 -> refl k2 ; k1 -> refl k3 ; k2 -> refl k0 ; k3 -> refl k1 ; k4 -> refl k6 ; k5 -> refl k7 ; k6 -> refl k4 ; k7 -> refl k5 } ;
  s-b : (v : X) -> Id X (s (b v)) (b (s v)) =
    split { k0 -> refl k4 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k7 ; k4 -> refl k0 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k3 } ;
  s-sym : M.iso = (s-equiv,s-a,s-b) ;
  send : X -> M.iso = split {
    k0 -> B.Identity[bicycle].id ;
    k1 -> r-sym ;
    k2 -> (N.composite r-sym s-sym) ;
    k3 -> (N.composite (N.composite r-sym r-sym) s-sym) ;
    k4 -> (N.composite r-sym r-sym) ;
    k5 -> (N.composite (N.composite r-sym r-sym) r-sym) ;
    k6 -> (N.composite s-sym r-sym) ;
    k7 -> s-sym } ;
  sends : (v : X) -> Id X (M.eval k0 (send v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 ; k6 -> refl k6 ; k7 -> refl k7 } ;
  at-base : isEquiv M.iso X (M.eval k0) = qinv _ _ (M.eval k0) send sends (\ f -> M.injective k0 _ f (sends (M.eval k0 f))) ;
  normality : N.normality = N.At[k0,at-base].all ;
  symmetries : Equiv (Id group.space group.point group.point) X = Equivalences[l].compose _ _ _ B.Component[bicycle].symmetries (M.eval k0,at-base) ;
} ;
module Hexagon {
  open Six ;
  a : X -> X = split { k0 -> k1 ; k1 -> k0 ; k2 -> k3 ; k3 -> k2 ; k4 -> k5 ; k5 -> k4 } ;
  a-right : (v : X) -> Id X (a (a v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  a-equiv : Equiv X X = (a,qinv X X a a a-right a-right) ;
  b : X -> X = split { k0 -> k5 ; k1 -> k2 ; k2 -> k1 ; k3 -> k4 ; k4 -> k3 ; k5 -> k0 } ;
  b-right : (v : X) -> Id X (b (b v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  b-equiv : Equiv X X = (b,qinv X X b b b-right b-right) ;
  module R = Routes[X,a-equiv,b-equiv] ;
  paths : (v : X) -> R.A.route k0 v = split {
    k0 -> (nil,refl k0) ;
    k1 -> ((cons red nil),refl k1) ;
    k2 -> ((cons blue (cons red nil)),refl k2) ;
    k3 -> ((cons red (cons blue (cons red nil))),refl k3) ;
    k4 -> ((cons red (cons blue nil)),refl k4) ;
    k5 -> ((cons blue nil),refl k5) } ;
  bicycle : B.Bicycle = R.Based[k0,paths].bicycle set ;
  group : ChapterFour[l].ConcreteGroup = B.Component[bicycle].group ;
  module M = B.Maps[bicycle,bicycle] ; module N = B.Normality[bicycle] ;
  r : X -> X = split { k0 -> k1 ; k1 -> k0 ; k2 -> k5 ; k3 -> k4 ; k4 -> k3 ; k5 -> k2 } ;
  r-right : (v : X) -> Id X (r (r v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  r-equiv : Equiv X X = (r,qinv X X r r r-right r-right) ;
  r-a : (v : X) -> Id X (r (a v)) (a (r v)) =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k4 ; k3 -> refl k5 ; k4 -> refl k2 ; k5 -> refl k3 } ;
  r-b : (v : X) -> Id X (r (b v)) (b (r v)) =
    split { k0 -> refl k2 ; k1 -> refl k5 ; k2 -> refl k0 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k1 } ;
  r-sym : M.iso = (r-equiv,r-a,r-b) ;
  s : X -> X = split { k0 -> k5 ; k1 -> k4 ; k2 -> k3 ; k3 -> k2 ; k4 -> k1 ; k5 -> k0 } ;
  s-right : (v : X) -> Id X (s (s v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  s-equiv : Equiv X X = (s,qinv X X s s s-right s-right) ;
  s-a : (v : X) -> Id X (s (a v)) (a (s v)) =
    split { k0 -> refl k4 ; k1 -> refl k5 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k0 ; k5 -> refl k1 } ;
  s-b : (v : X) -> Id X (s (b v)) (b (s v)) =
    split { k0 -> refl k0 ; k1 -> refl k3 ; k2 -> refl k4 ; k3 -> refl k1 ; k4 -> refl k2 ; k5 -> refl k5 } ;
  s-sym : M.iso = (s-equiv,s-a,s-b) ;
  send : X -> M.iso = split {
    k0 -> B.Identity[bicycle].id ;
    k1 -> r-sym ;
    k2 -> (N.composite s-sym r-sym) ;
    k3 -> (N.composite (N.composite r-sym s-sym) r-sym) ;
    k4 -> (N.composite r-sym s-sym) ;
    k5 -> s-sym } ;
  sends : (v : X) -> Id X (M.eval k0 (send v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  at-base : isEquiv M.iso X (M.eval k0) = qinv _ _ (M.eval k0) send sends (\ f -> M.injective k0 _ f (sends (M.eval k0 f))) ;
  normality : N.normality = N.At[k0,at-base].all ;
  symmetries : Equiv (Id group.space group.point group.point) X = Equivalences[l].compose _ _ _ B.Component[bicycle].symmetries (M.eval k0,at-base) ;
} ;
module Prism {
  open Six ;
  a : X -> X = split { k0 -> k2 ; k1 -> k0 ; k2 -> k1 ; k3 -> k4 ; k4 -> k5 ; k5 -> k3 } ;
  a-back : X -> X = split { k0 -> k1 ; k1 -> k2 ; k2 -> k0 ; k3 -> k5 ; k4 -> k3 ; k5 -> k4 } ;
  a-right : (v : X) -> Id X (a (a-back v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  a-left : (v : X) -> Id X (a-back (a v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  a-equiv : Equiv X X = (a,qinv X X a a-back a-right a-left) ;
  b : X -> X = split { k0 -> k3 ; k1 -> k4 ; k2 -> k5 ; k3 -> k0 ; k4 -> k1 ; k5 -> k2 } ;
  b-right : (v : X) -> Id X (b (b v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  b-equiv : Equiv X X = (b,qinv X X b b b-right b-right) ;
  module R = Routes[X,a-equiv,b-equiv] ;
  paths : (v : X) -> R.A.route k0 v = split {
    k0 -> (nil,refl k0) ;
    k1 -> ((cons red (cons red nil)),refl k1) ;
    k2 -> ((cons red nil),refl k2) ;
    k3 -> ((cons blue nil),refl k3) ;
    k4 -> ((cons red (cons blue nil)),refl k4) ;
    k5 -> ((cons blue (cons red nil)),refl k5) } ;
  bicycle : B.Bicycle = R.Based[k0,paths].bicycle set ;
  group : ChapterFour[l].ConcreteGroup = B.Component[bicycle].group ;
  module M = B.Maps[bicycle,bicycle] ; module N = B.Normality[bicycle] ;
  r : X -> X = split { k0 -> k2 ; k1 -> k0 ; k2 -> k1 ; k3 -> k5 ; k4 -> k3 ; k5 -> k4 } ;
  r-back : X -> X = split { k0 -> k1 ; k1 -> k2 ; k2 -> k0 ; k3 -> k4 ; k4 -> k5 ; k5 -> k3 } ;
  r-right : (v : X) -> Id X (r (r-back v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  r-left : (v : X) -> Id X (r-back (r v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  r-equiv : Equiv X X = (r,qinv X X r r-back r-right r-left) ;
  r-a : (v : X) -> Id X (r (a v)) (a (r v)) =
    split { k0 -> refl k1 ; k1 -> refl k2 ; k2 -> refl k0 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  r-b : (v : X) -> Id X (r (b v)) (b (r v)) =
    split { k0 -> refl k5 ; k1 -> refl k3 ; k2 -> refl k4 ; k3 -> refl k2 ; k4 -> refl k0 ; k5 -> refl k1 } ;
  r-sym : M.iso = (r-equiv,r-a,r-b) ;
  s : X -> X = split { k0 -> k3 ; k1 -> k5 ; k2 -> k4 ; k3 -> k0 ; k4 -> k2 ; k5 -> k1 } ;
  s-right : (v : X) -> Id X (s (s v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  s-equiv : Equiv X X = (s,qinv X X s s s-right s-right) ;
  s-a : (v : X) -> Id X (s (a v)) (a (s v)) =
    split { k0 -> refl k4 ; k1 -> refl k3 ; k2 -> refl k5 ; k3 -> refl k2 ; k4 -> refl k1 ; k5 -> refl k0 } ;
  s-b : (v : X) -> Id X (s (b v)) (b (s v)) =
    split { k0 -> refl k0 ; k1 -> refl k2 ; k2 -> refl k1 ; k3 -> refl k3 ; k4 -> refl k5 ; k5 -> refl k4 } ;
  s-sym : M.iso = (s-equiv,s-a,s-b) ;
  send : X -> M.iso = split {
    k0 -> B.Identity[bicycle].id ;
    k1 -> (N.composite r-sym r-sym) ;
    k2 -> r-sym ;
    k3 -> s-sym ;
    k4 -> (N.composite r-sym s-sym) ;
    k5 -> (N.composite s-sym r-sym) } ;
  sends : (v : X) -> Id X (M.eval k0 (send v)) v =
    split { k0 -> refl k0 ; k1 -> refl k1 ; k2 -> refl k2 ; k3 -> refl k3 ; k4 -> refl k4 ; k5 -> refl k5 } ;
  at-base : isEquiv M.iso X (M.eval k0) = qinv _ _ (M.eval k0) send sends (\ f -> M.injective k0 _ f (sends (M.eval k0 f))) ;
  normality : N.normality = N.At[k0,at-base].all ;
  symmetries : Equiv (Id group.space group.point group.point) X = Equivalences[l].compose _ _ _ B.Component[bicycle].symmetries (M.eval k0,at-base) ;
} ;
