-- Exercise 4.5.8. Even permutations of three letters are exactly the
-- centralizer of the standard rotation. Conjugation reverses its direction.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module R = SixSymmetries[l] ; module S = R.S ; module L = EvenPermutations[l].Labeled[suc zero] ;
module A = AlternatingComparison[l].Action[suc zero] ; module E = Equivalences[l] ; module BP = Paths[l+] ;
module F = CycleComponents[l].Finite[TwoElementSets[l].two] ; module P = PermutationLoops[l].At[F.standard] ;
module B = FiniteCycles[l].Standard[TwoElementSets[l].two] ;
X : U l = R.X ; aut : U l = L.aut ; evens : U l = L.part false ;
one : aut = idEquiv X ; r : aut = R.jki ; rr : aut = R.kij ; t : aut = R.jik ;
comp (a b : aut) : aut = E.compose X X X a b ;
zero-law : Id Bool (L.sign one) false = transH (BP.apH L.S.E.sign (Prelude[l+].sec-ret _ _ L.code.1 L.code.2 (refl L.K.A))) L.S.unit ;
times (a b c : aut) (p : Id aut (comp a b) c) : Id Bool (L.sign c) (Z2[l].xor (L.sign a) (L.sign b)) =
  transH (apH L.sign (symH p)) (L.multiply a b) ;
square : Id aut (comp r r) rr = R.ext _ _ (refl R.k) (refl R.i) (refl R.j) ;
cube : Id aut (comp rr r) one = R.ext _ _ (refl R.i) (refl R.j) (refl R.k) ;
even-rr : Id Bool (L.sign rr) false = transH (times r r rr square) (Z2[l].xor-invr (L.sign r)) ;
even-r : Id Bool (L.sign r) false = transH (symH (transH (times rr r one cube) (apH (\ b -> Z2[l].xor b (L.sign r)) even-rr))) zero-law ;
swap : Id aut L.Swap.transpose t = R.ext _ _ L.Swap.at-u L.Swap.at-v
  (L.Swap.Rules[R.k].away (R.separate R.k R.i) (R.separate R.k R.j) (L.S.M.discrete R.k R.i)) ;
odd-t : Id Bool (L.sign t) true = transH (apH L.sign (symH swap)) L.A.sign ;
odd-product (e f : aut) (h : Id aut (comp t e) f) (w : Id Bool (L.sign e) false) : Id Bool (L.sign f) true =
  transH (times t e f h) (transH (apH (\ b -> Z2[l].xor b (L.sign e)) odd-t) (apH not w)) ;
odd-ikj : Id Bool (L.sign R.ikj) true = odd-product rr R.ikj (R.ext _ _ (refl R.i) (refl R.k) (refl R.j)) even-rr ;
odd-kji : Id Bool (L.sign R.kji) true = odd-product r R.kji (R.ext _ _ (refl R.k) (refl R.j) (refl R.i)) even-r ;
comm (e : aut) : U l = (x : X) -> Id X (e.1 (B.step x)) (B.step (e.1 x)) ;
comm-prop (e : aut) : isProp (comm e) = Axioms[l].FunExtLemmas[fe @l].isProp-Pi X (\ x -> Id X (e.1 (B.step x)) (B.step (e.1 x))) (\ x -> FiniteCycles[l].fin-set R.n _ _) ;
even (e : aut) : U l = Id Bool (L.sign e) false ;
laws (e : aut) : U l = (even e -> comm e) * (comm e -> even e) ;
yes (e : aut) (v : even e) (h : comm e) : laws e = (\ p -> h,\ k -> v) ;
no (e : aut) (v : Id Bool (L.sign e) true) (h : comm e -> Empty) : laws e =
  (\ p -> absurd _ (TruthValues[l].separate (transH (symH v) p)),\ k -> absurd _ (h k)) ;
table : (u : S.X) -> laws (R.Hex.table u) = S.cases (\ u -> laws (R.Hex.table u))
  (yes R.ijk (transH (apH L.sign (R.ext R.ijk one (refl R.i) (refl R.j) (refl R.k))) zero-law) (R.cases (\ x -> Id X (R.ijk.1 (B.step x)) (B.step (R.ijk.1 x))) (refl R.j) (refl R.k) (refl R.i)))
  (no t odd-t (\ h -> R.separate R.i R.k (h R.i)))
  (yes r even-r (R.cases (\ x -> Id X (r.1 (B.step x)) (B.step (r.1 x))) (refl R.k) (refl R.i) (refl R.j)))
  (no R.kji odd-kji (\ h -> R.separate R.j R.i (h R.i)))
  (yes rr even-rr (R.cases (\ x -> Id X (rr.1 (B.step x)) (B.step (rr.1 x))) (refl R.i) (refl R.j) (refl R.k)))
  (no R.ikj odd-ikj (\ h -> R.separate R.k R.j (h R.i))) ;
classify (e : aut) : laws e = subst aut laws _ e (R.Hex.labels.2.sec-eq e) (table (R.Hex.labels.2.sec e)) ;
sub : Equiv evens (CycleComponents[l].From[F.standard].Iso F.standard) =
  Fibres[l].sigma-equiv aut even comm (\ e -> Bijection[l].prop-equiv _ _ (Z2[l].bool-set _ _) (comm-prop e) (classify e).1 (classify e).2) ;
mirror (e : aut) : aut = comp t (comp e t) ;
closed (e : aut) (h : even e) : even (mirror e) = transH (L.multiply t (comp e t))
  (transH (apH (Z2[l].xor (L.sign t)) (L.multiply e t)) (transH (apH (\ b -> Z2[l].xor (L.sign t) (Z2[l].xor b (L.sign t))) h) (Z2[l].xor-invr (L.sign t)))) ;
flip (w : evens) : evens = (mirror w.1,closed w.1 w.2) ;
tt-law (x : X) : Id X (t.1 (t.1 x)) x = R.cases (\ z -> Id X (t.1 (t.1 z)) z) (refl R.i) (refl R.j) (refl R.k) x ;
twice (w : evens) : Id evens (flip (flip w)) w = Sigma-eq aut even _ _ _ _
  (PermutationCount[l].ext X X _ _ (\ x -> transH (tt-law (w.1.1 (t.1 (t.1 x)))) (apH w.1.1 (tt-law x)))) (Z2[l].bool-set _ _) ;
reflection : Equiv evens evens = (flip,qinv _ _ flip flip twice twice) ;
module Identify (d : Equiv evens evens) (product : (p q : A.G.carrier) (x : X) ->
  Id X ((d.1 (A.A.evens.1 (A.G.abstract.mul p q))).1.1 x) ((d.1 (A.A.evens.1 p)).1.1 ((d.1 (A.A.evens.1 q)).1.1 x))) {
  iso : Equiv A.G.carrier P.J.carrier = E.compose _ _ _ A.A.evens (E.compose _ _ _ d (E.compose _ _ _ sub (Bijection[l].inverse _ _ P.encode))) ;
  apply (p : A.G.carrier) (x : X) : Id X ((P.encode.1 (iso.1 p)).1.1 x) ((d.1 (A.A.evens.1 p)).1.1 x) =
    apH (\ c -> c.1.1 x) (P.encode.2.sec-eq (sub.1 (d.1 (A.A.evens.1 p)))) ;
  law (p q : A.G.carrier) : Id P.J.carrier (iso.1 (A.G.abstract.mul p q)) (P.J.abstract.mul (iso.1 p) (iso.1 q)) =
    E.injective _ _ P.encode.1 P.encode.2 _ _ (Sigma-eq aut comm _ _ _ _
      (PermutationCount[l].ext X X _ _ (\ x -> transH (apply (A.G.abstract.mul p q) x) (transH (product p q x)
        (symH (transH (BP.apH (\ v -> (P.I.tr F.standard v).1.1 x) (P.based-mul (iso.1 p) (iso.1 q)))
          (transH (P.comp F.standard F.standard (P.based.1 (iso.1 q)) F.standard (P.based.1 (iso.1 p)) x)
            (transH (apply p ((P.encode.1 (iso.1 q)).1.1 x)) (apH (d.1 (A.A.evens.1 p)).1.1 (apply q x))))))))) (comm-prop _)) ;
  module M = ChapterSeven[l].OrdinaryMaps[A.A.Alt.group,F.Cyc.group] ;
  abstract : M.ordinary = (iso.1,law) ;
  hom : ChapterFour[l].Hom A.A.Alt.group F.Cyc.group = M.comparison.2.sec abstract ;
  computes (p : A.G.carrier) : Id P.J.carrier ((M.M.D.loop hom).1 p) (iso.1 p) =
    apH (\ h -> h.1 p) (M.comparison.2.sec-eq abstract) ;
  equivalence : Lemma4[l].PtEquiv A.A.Alt.group.space A.A.Alt.group.point F.Cyc.group.space F.Cyc.group.point =
    (hom,Whitehead[l].Pointed[A.A.Alt.group.space,A.A.Alt.group.point,F.Cyc.group.space,F.Cyc.group.point,hom,
      A.A.Alt.group.connected,E.homotopy _ _ iso (M.M.D.loop hom).1 computes].equiv F.Cyc.group.connected) ;
} ;
module Direct = Identify[idEquiv evens,A.mul] ;
mirror-mul (p q : A.G.carrier) (x : X) : Id X ((flip (A.A.evens.1 (A.G.abstract.mul p q))).1.1 x) ((flip (A.A.evens.1 p)).1.1 ((flip (A.A.evens.1 q)).1.1 x)) =
  transH (apH t.1 (A.mul p q (t.1 x))) (symH (apH (\ v -> t.1 ((A.label p).1 v)) (tt-law ((A.label q).1 (t.1 x))))) ;
module Reverse = Identify[reflection,mirror-mul] ;
rotation : A.G.carrier = A.A.evens.2.sec (r,even-r) ;
different (h : Id (ChapterFour[l].Hom A.A.Alt.group F.Cyc.group) Direct.hom Reverse.hom) : Empty =
  let-different (transH (symH (Direct.computes rotation)) (transH (apH (\ f -> (Direct.M.M.D.loop f).1 rotation) h) (Reverse.computes rotation)))
  where {
    point : Id evens (A.A.evens.1 rotation) (r,even-r) = A.A.evens.2.sec-eq (r,even-r) ;
    let-different (q : Id P.J.carrier (Direct.iso.1 rotation) (Reverse.iso.1 rotation)) : Empty = R.separate R.j R.k
      (transH (symH (apH (\ w -> w.1.1 R.i) point)) (transH (symH (Direct.apply rotation R.i))
        (transH (apH (\ p -> (P.encode.1 p).1.1 R.i) q) (transH (Reverse.apply rotation R.i) (apH (\ w -> (flip w).1.1 R.i) point))))) ;
  } ;
