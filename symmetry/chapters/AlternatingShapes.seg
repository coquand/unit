-- The classifying type in Definition 4.5.7 is the whole type of sign
-- ordered sets. Give a pointed comparison with the small concrete kernel.
level l ; open Base ; open Prelude[l+] ; open Paths[l+] ;
module P = Prelude[l] ; module BE = Equivalences[l+] ; module T = TwoElementSets[l] ;
module BI = Bijection[l+] ; module CG = ChapterFour[l] ;
module At (n : Nat) {
  module S = SignLaws[l].Degree[n] ; module K = S.K ; module A = SignOrderings[l].Alternating[n] ;
  module D = A.S ; module X = D.Dom ; module Y = D.Cod ; module F = S.Signed.Family ;
  family (v : X.large) : U l = (D.classify v).1 ;
  V : X.large = X.presentation.1 X.G.pt ;
  module Back = AlternatingComparison[l].PathsOf[Y.large,Y.G.group.space,BI.inverse _ _ Y.presentation,D.classify V] ;
  module Sub = ChapterTwo[l+].Subtype[U l,\ Z -> Y.codes Z,\ Z -> Truncation[l].Trunc[P.Equiv T.standard Z].proposition] ;
  point : Id Y.large (D.classify V) Y.base = transH (apH D.classify X.pointing) D.base-law ;
  module AtShape (x : X.G.group.space) {
    v : X.large = X.presentation.1 x ; z : Y.large = D.classify v ;
    reverse : Equiv (Id Y.G.group.space (D.map x) A.a) (Id Y.G.group.space A.a (D.map x)) =
      ((\ r -> symH r),qinv (Id Y.G.group.space (D.map x) A.a) (Id Y.G.group.space A.a (D.map x)) (\ r -> symH r) (\ r -> symH r) (\ r -> Groupoid[l+].sym-sym Y.G.group.space _ _ r) (\ r -> Groupoid[l+].sym-sym Y.G.group.space _ _ r)) ;
    read : Equiv (Id Y.G.group.space (D.map x) A.a) (family v) = BE.compose _ _ _ reverse
      (BE.compose _ _ _ (BI.inverse _ _ (Back.ap z)) (BE.compose _ _ _
        (Fibres[l+].trans-equiv Y.large Y.base (D.classify V) z (symH point))
        (BE.compose _ _ _ (Sub.At[Y.base].paths z) T.At[family v,z.2].path-labels))) ;
  } ;
  presentation : Equiv A.fibre F.total = BE.compose _ _ _
    (Fibres[l+].sigma-equiv X.G.group.space (\ x -> Id Y.G.group.space (D.map x) A.a) (\ x -> family (X.presentation.1 x)) (\ x -> AtShape[x].read))
    (ChapterTwo[l+].change-base X.G.group.space X.large X.presentation (\ v -> family v)) ;
  connected : Connected[l+].isConn CG.two A.fibre = Deloop[l+].equiv-conn CG.two _ _ presentation S.Signed.connected ;
  reach (t : A.fibre) : A.Kernel.membership t = TruncationCombinators[l+].rec (Id A.fibre A.base t) @l _
    Truncation[l].Trunc[Id A.fibre A.base t].proposition Truncation[l].Trunc[Id A.fibre A.base t].inc ((connected.2 A.base t).1) ;
  project : Equiv A.group.space A.fibre = ((\ w -> w.1),qinv _ _ (\ w -> w.1) (\ t -> (t,reach t)) (\ t -> refl t)
    (\ w -> Sigma-eq A.fibre (\ t -> A.Kernel.membership t) _ _ _ _ (refl w.1) Truncation[l].Trunc[Id A.fibre A.base w.1].proposition)) ;
  display : Equiv A.group.space F.total = BE.compose _ _ _ project presentation ;
  marked : family X.base = subst X.large (\ v -> family v) V X.base X.pointing (display.1 A.group.point).2 ;
  slide : Id F.total (display.1 A.group.point) (X.base,marked) = Sigma-path X.large (\ v -> family v) _ _ _ _ X.pointing (refl marked) ;
  module W (v : X.large) { module O = T.At[family v,(D.classify v).2] ; } ;
  flip : Equiv F.total F.total = Fibres[l+].sigma-equiv X.large (\ v -> family v) (\ v -> family v)
    (\ v -> UniverseChange[l+,l].raise-equiv _ _ W[v].O.swap) ;
  goal : U l+ = Lemma4[l+].PtEquiv A.group.space A.group.point F.total S.Signed.base ;
  choose : Logic[l].Dec (Id (family X.base) marked S.Signed.base.2) -> goal = split {
    yes p -> ((display.1,transH slide (ap (family X.base) F.total (\ t -> (X.base,t)) _ _ p)),display.2) ;
    no k -> (((\ t -> flip.1 (display.1 t)),transH (apH flip.1 slide) (ap (family X.base) F.total (\ t -> (X.base,t)) _ _
      (W[X.base].O.only marked S.Signed.base.2 (\ p -> k (symH p))))),(BE.compose _ _ _ display flip).2) } ;
  pointed : goal = choose (W[X.base].O.D.discrete marked S.Signed.base.2) ;
} ;
