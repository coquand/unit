-- Exercise 2.19.2. Small indices and a locally small family give a locally
-- small dependent product. The codomain level may exceed the index level.
level u v ; constraint u <= v ; open Base ; open Prelude[v] ;
module R = Replacement[u,v] ;
module Product (A : U u) (B : A -> U v) (h : (a : A) -> R.LocallySmall (B a)) {
  sections : U v = (a : A) -> B a ;
  module PathsOf (f g : sections) {
    small (a : A) : U u = (h a (f a) (g a)).1 ;
    paths (a : A) : U v = Id (B a) (f a) (g a) ;
    to (a : A) : small a -> paths a = (h a (f a) (g a)).2.1 ;
    pointwise : Equiv ((a : A) -> small a) ((a : A) -> paths a) = ((\ k a -> to a (k a)),
      PiEquiv[v].pi-equiv A (\ a -> small a) paths to (\ a -> (h a (f a) (g a)).2.2)) ;
    presentation : R.Small (Id sections f g) = ((a : A) -> small a,Equivalences[v].compose _ _ _ pointwise
      (Bijection[v].inverse _ _ (happly A B f g,fe @v A B f g))) ;
  } ;
  locally-small : R.LocallySmall sections = \ f g -> PathsOf[f,g].presentation ;
} ;

module Component (X : U v) (small : Replacement[u,v].LocallySmall X) (x : X) {
  point-map (t : Top) : X = x ;
  image : R.Image[Top,X,point-map] = images @u @v Top X small point-map ;
  carrier : U u = image.carrier ;
  point : carrier = image.quotient tt ;
  module SmallTrunc = Truncation[u] ;
  path-from-point (z : carrier) : SmallTrunc.Trunc[Id carrier point z].carrier =
    (surjections @u @v @u Top X small point-map
      (\ w -> SmallTrunc.Trunc[Id carrier point w].carrier)
      (\ w -> SmallTrunc.Trunc[Id carrier point w].proposition)).sec
      (\ t -> SmallTrunc.Trunc[Id carrier point (image.quotient t)].inc
        (Prelude[u].ap Top carrier image.quotient tt t (isTop tt t))) z ;
  path-at-point : Id X (image.inclusion point) x = image.triangle tt ;
  module B = Prelude[v] ; module T = Truncation[v] ;
  reaches (y : X) : U v = T.Trunc[Id X x y].carrier ;
  component : U v = (y : X) * reaches y ;
  witness : (z : carrier) -> reaches (image.inclusion z) = (surjections @u @v @v Top X small point-map
    (\ z -> reaches (image.inclusion z)) (\ z -> T.Trunc[Id X x (image.inclusion z)].proposition)).sec
    (\ t -> T.Trunc[Id X x (image.inclusion (image.quotient t))].inc (B.sym _ _ _ (image.triangle t))) ;
  forget (z : carrier) : component = (image.inclusion z,witness z) ;
  fibre (y : X) : U v = (z : carrier) * Id X (image.inclusion z) y ;
  unique (y : X) : B.isProp (fibre y) = Groupoid[v].emb-fib-prop carrier X image.inclusion image.embedding y ;
  locate (w : component) : fibre w.1 = TruncationCombinators[v].rec (Id X x w.1) @v (fibre w.1)
    (unique w.1) (\ p -> (point,B.trans X _ x w.1 path-at-point p)) w.2 ;
  presentation : B.Equiv carrier component = (forget,B.qinv _ _ forget (\ w -> (locate w).1)
    (\ w -> B.Sigma-eq X reaches _ _ _ _ (locate w).2 T.Trunc[Id X x w.1].proposition)
    (\ z -> B.ap (fibre (image.inclusion z)) carrier (\ w -> w.1) _ _
      (unique (image.inclusion z) (locate (forget z)) (z,refl (image.inclusion z))))) ;
} ;
