-- Apply the chapter 7 equivalence to the algebraic group sum.
level l ; open Base ; open Prelude[l] ;
module CG = ChapterFour[l] ; module GI = GroupIdentity[l] ; module E = Equivalences[l] ;
module Sum (G H : CG.ConcreteGroup) {
  module A = AlgebraicSum[l].Sum[GI.loops G,GI.loops H] ;
  group : CG.ConcreteGroup = GI.deloop A.group ;
  module Into (J : CG.ConcreteGroup) {
    module S = A.Into[GI.loops J] ;
    algebra (K : Group[l].Grp) : U l = QGrp[l].GHom K (GI.loops J) ;
    identify (K : Group[l].Grp) (p : Id Group[l].Grp (GI.loops group) K) :
      Equiv (algebra (GI.loops group)) (algebra K) =
      idJ Group[l].Grp (GI.loops group) (\ Z q -> Equiv (algebra (GI.loops group)) (algebra Z))
        (idEquiv (algebra (GI.loops group))) K p ;
    compare : Equiv (CG.Hom group J) (algebra A.group) = E.compose _ _ _ ChapterSeven[l].OrdinaryMaps[group,J].comparison
      (identify A.group (GI.equivalence.2.sec-eq A.group)) ;
    separate : Equiv (CG.Hom G J * CG.Hom H J) S.pair = E.compose _ _ _
      (E.product _ _ (CG.Hom H J) ChapterSeven[l].OrdinaryMaps[G,J].comparison)
      (Fibres[l].sigma-equiv (algebra (GI.loops G)) (\ t -> CG.Hom H J) (\ t -> algebra (GI.loops H)) (\ t -> ChapterSeven[l].OrdinaryMaps[H,J].comparison)) ;
    universal : Equiv (CG.Hom group J) (CG.Hom G J * CG.Hom H J) = E.compose _ _ _ compare
      (E.compose _ _ _ S.universal (Bijection[l].inverse _ _ separate)) ;
  } ;
} ;
