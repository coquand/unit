-- Section 8.7. Freeness as an equivalence of types of maps.
level l ;
open Base ; open Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module T = Theorems[l,l] ;
module Free (X : U l) (G : Group[l].Grp) {
  source : Group[l].Grp = T.free-group X ;
  module F = FreeGroup[l,l].FreeGroup[FreeInstance[l,l].free,X] ;
  preserves (h : source.C -> G.C) : U l = (p q : source.C) ->
    Id G.C (h (source.mul p q)) (G.mul (h p) (h q)) ;
  hom : U l = (h : source.C -> G.C) * preserves h ;
  restrict (h : hom) : X -> G.C = \ x -> h.1 (F.eta x) ;
  extend (f : X -> G.C) : hom = (Lift[l,l].Lift[FreeInstance[l,l].free,X,G,tt,f].lift,T.free-lift-mul X G f) ;
  beta (f : X -> G.C) : Id (X -> G.C) (restrict (extend f)) f =
    FL.funext X (\ x -> G.C) _ _ (T.free-lift-eta X G f) ;
  law-prop (h : source.C -> G.C) : isProp (preserves h) =
    FL.isProp-Pi source.C (\ p -> (q : source.C) -> Id G.C (h (source.mul p q)) (G.mul (h p) (h q)))
      (\ p -> FL.isProp-Pi source.C (\ q -> Id G.C (h (source.mul p q)) (G.mul (h p) (h q)))
        (\ q -> G.set (h (source.mul p q)) (G.mul (h p) (h q)))) ;
  eta (h : hom) : Id hom (extend (restrict h)) h =
    Sigma-eq (source.C -> G.C) preserves _ _ _ _
      (sym (source.C -> G.C) _ _ (FL.funext source.C (\ p -> G.C) _ _
        (T.free-lift-unique X G (restrict h) h.1 h.2 (\ x -> refl (h.1 (F.eta x))))))
      (law-prop h.1) ;
  universal : Equiv hom (X -> G.C) = (restrict,qinv hom (X -> G.C) restrict extend beta eta) ;
} ;
