-- Definitions 5.3.2--5.3.4. The group of a pointed transitive action,
-- with its injective projection and the description of its loops as a stabilizer.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ;
module Over (G : CG.ConcreteGroup) {
  module Act = ChapterFive[l,l].Actions[G] ;
  module Action (X : Act.GSet) {
    module F = Act.On[X] ;
    module C = ConnectedActions[l].Family[G.space,G.point,G.connected,F.family] ;
    module At (x : F.carrier) (transitive : C.transitive) {
      pt : F.total = (G.point,x) ;
      conn : Connected[l].isConn CG.two F.total = C.to-connected (Truncation[l].Trunc[F.carrier].inc x,transitive) ;
      group : CG.ConcreteGroup = new CG.ConcreteGroup[F.total,pt,conn,
        HLevels[l].trunc-Sigma CG.three G.space F.family G.groupoid
          (\ z -> HLevels[l].trunc-suc CG.two _ (HLevels[l].set-trunc _ (X z).2))] ;
      projection : CG.Hom group G = (\ z -> z.1,refl G.point) ;
      loops : U l = Id F.total pt pt ;
      stabilizer : U l = (p : Id G.space G.point G.point) * F.stabilizes p x ;
      encode : loops -> stabilizer = sPath G.space F.family pt pt ;
      decode (w : stabilizer) : loops = Sigma-path G.space F.family G.point G.point x x w.1 w.2 ;
      over (z : F.total) (q : Id F.total pt z) : Id (Id G.space G.point z.1)
        (sPath G.space F.family pt z q).1 (apH projection.1 q) =
        idJ F.total pt (\ y r -> Id (Id G.space G.point y.1)
          (sPath G.space F.family pt y r).1 (ap F.total G.space projection.1 pt y r)) (refl (refl G.point)) z q ;
      beta (w : stabilizer) : Id stabilizer (encode (decode w)) w =
        Sigma-eq (Id G.space G.point G.point) (\ p -> F.stabilizes p x) _ _ _ _
          (transH (over pt (decode w)) (Fibres[l].fst-Sigma-path G.space F.family G.point G.point x x w.1 w.2))
          (F.stabilizes-prop w.1 x) ;
      symmetries : Equiv loops stabilizer = (encode,qinv loops stabilizer encode decode beta (rsPath G.space F.family pt pt)) ;
      injective (p q : loops) (h : Id (Id G.space G.point G.point) (apH projection.1 p) (apH projection.1 q)) :
        Id loops p q = Equivalences[l].injective _ _ encode symmetries.2 p q
          (Sigma-eq (Id G.space G.point G.point) (\ k -> F.stabilizes k x) _ _ _ _
            (transH (over pt p) (transH h (symH (over pt q)))) (F.stabilizes-prop (encode q).1 x)) ;
    } ;
  } ;
  Sub : U l+ = (X : Act.GSet) * Action[X].F.carrier * Action[X].C.transitive ;
  underlying (H : Sub) : CG.ConcreteGroup = Action[H.1].At[H.2.1,H.2.2].group ;
  inclusion (H : Sub) : CG.Hom (underlying H) G = Action[H.1].At[H.2.1,H.2.2].projection ;
} ;
