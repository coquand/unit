-- Theorem 3.10.1. Maps out of the small positive n-cycle into a groupoid.
-- We orient the generator by the forward rotation.
level u v ; open Base ; open Prelude[u \/ v] ; open Paths[u \/ v] ;
module CG = ChapterFour[u \/ v] ; module E = Equivalences[u \/ v] ;
module Mapping (n : Nat) (Y : U v) (gpd : HLevels[v].isTrunc CG.three Y) {
  module S = CyclicGenerator[u].Standard[n] ;
  A : U u = S.C.space ; a : A = S.C.pt ; m : Nat = suc n ;
  group : CG.ConcreteGroup = new CG.ConcreteGroup[A,a,
    UniverseChange[u,v].connected CG.two A S.C.group.connected,UniverseChange[v,u].truncated CG.three A S.C.group.groupoid] ;
  module Source = CG.Symmetries[group] ;
  module Generator = CyclicHom[u,u \/ v].Cyclic[n,Source.abstract,S.generator,
    UniverseChange[v,u].raise-equiv _ _ S.label,S.start,S.advance] ;
  power (y : Y) (p : Id Y y y) : Nat -> Id Y y y = split {
    zero -> refl y ; suc k | r -> transH r p } ;
  module At (y : Y) {
    module C = PointedComponent[u \/ v].AtBase[Y,UniverseChange[u,v].truncated CG.three Y gpd,y] ; module B = CG.Symmetries[C.group] ;
    module H = ChapterSeven[u \/ v].OrdinaryMaps[group,C.group] ;
    module R = Generator.Into[B.abstract] ;
    module Pointed = C.Cones[group] ;
    proj (x : C.component) : Y = x.1 ;
    loops : Equiv B.carrier (Id Y y y) = C.P.symmetries ;
    torsion (p : Id Y y y) : U v = Id (Id Y y y) (power y p m) (refl y) ;
    codes : U v = (p : Id Y y y) * torsion p ;
    module Lift (s : B.carrier) {
      module P = CyclicHom[u,u \/ v].Powers[B.abstract,s] ;
      commutes : (k : Nat) -> Id (Id Y y y) (loops.1 (P.power k)) (power y (loops.1 s) k) = split {
        zero -> refl (refl y) ; suc k | r -> transH (Groupoid[u \/ v].ap-trans C.component Y proj C.point C.point C.point (P.power k) s)
          (apH (\ q -> transH q (loops.1 s)) r) } ;
      raw : U (u \/ v) = Id B.carrier (P.power m) B.abstract.e ;
      forward (h : raw) : torsion (loops.1 s) = transH (symH (commutes m)) (apH loops.1 h) ;
      backward (h : torsion (loops.1 s)) : raw = E.injective _ _ loops.1 loops.2 _ _ (transH (commutes m) h) ;
      equiv : Equiv raw (torsion (loops.1 s)) = (forward,qinv _ _ forward backward
        (\ h -> HLevels[v].trunc-set _ (gpd y y) _ _ _ _) (\ h -> B.abstract.setG _ _ _ _)) ;
    } ;
    convert : Equiv R.torsion codes = E.compose _ _ _
      (Fibres[u \/ v].sigma-equiv B.carrier (\ s -> Lift[s].raw) (\ s -> torsion (loops.1 s)) (\ s -> Lift[s].equiv))
      (ChapterTwo[u \/ v].change-base B.carrier (Id Y y y) loops (\ p -> torsion p)) ;
    pointed : Equiv Pointed.cones codes = E.compose _ _ _ (Bijection[u \/ v].inverse _ _ Pointed.universal)
      (E.compose _ _ _ H.comparison (E.compose _ _ _ R.universal convert)) ;
  } ;
  based : U (u \/ v) = (y : Y) * Lemma4[u \/ v].PtMap A a Y y ;
  point (h : A -> Y) : based = (h a,h,refl (h a)) ;
  contract (h : A -> Y) (y : Y) (p : Id Y (h a) y) : Id based (point h) (y,h,p) =
    idJ Y (h a) (\ z q -> Id based (point h) (z,h,q)) (refl (point h)) y p ;
  with-point : Equiv (A -> Y) based = (point,qinv _ _ point (\ v -> v.2.1) (\ v -> contract v.2.1 v.1 v.2.2) (\ h -> refl h)) ;
  data-type : U v = (y : Y) * At[y].codes ;
  universal : Equiv (A -> Y) data-type = E.compose _ _ _ with-point
    (Fibres[u \/ v].sigma-equiv Y (\ y -> Lemma4[u \/ v].PtMap A a Y y) (\ y -> At[y].codes) (\ y -> At[y].pointed)) ;
  module Evaluate (h : A -> Y) {
    y : Y = h a ;
    module R = At[y] ; module C = R.C ;
    module L = C.Lift[group,(h,refl y)] ;
    q : Id C.component (L.lift a) (L.lift a) = apH L.lift S.generator ;
    module LC = LoopConj[u \/ v] ;
    generator-law : Id (Id Y y y) (universal.1 h).2.1 (apH h S.generator) =
      PointedComponent[u \/ v].Canonical[group,Y,UniverseChange[u,v].truncated CG.three Y gpd,h].computes S.generator ;
    law : R.torsion (apH h S.generator) =
      subst (Id Y y y) (\ p -> R.torsion p) (universal.1 h).2.1 (apH h S.generator) generator-law (universal.1 h).2.2 ;
    value : data-type = (y,apH h S.generator,law) ;
    computes : Id data-type value (universal.1 h) = ap R.codes data-type (\ w -> (y,w)) _ _
      (Sigma-eq (Id Y y y) (\ p -> R.torsion p) _ _ _ _ (symH generator-law) (HLevels[v].trunc-set _ (gpd y y) _ _)) ;
  } ;
  evaluation : Equiv (A -> Y) data-type = (\ h -> Evaluate[h].value,E.homotopy _ _ universal (\ h -> Evaluate[h].value) (\ h -> Evaluate[h].computes)) ;

  -- The book designates the inverse rotation as its loop.
  book-generator : Id A a a = symH S.generator ;
  module Invert (y : Y) {
    module G = Groupoid[v] ;
    module R = At[y] ;
    commute (p : Id Y y y) : (k : Nat) -> Id (Id Y y y) (transH p (power y p k)) (power y p (suc k)) = split {
      zero -> symH (trans-refl-l Y y y p) ;
      suc k | h -> transH (symH (G.tassoc Y y y y p (power y p k) y p)) (apH (\ z -> transH z p) h) } ;
    inverse-power (p : Id Y y y) : (k : Nat) -> Id (Id Y y y) (symH (power y p k)) (power y (symH p) k) = split {
      zero -> refl (refl y) ;
      suc k | h -> transH (G.sym-trans Y y y y (power y p k) p)
        (transH (apH (trans Y y y y (symH p)) h) (commute (symH p) k)) } ;
    invert (w : R.codes) : R.codes = (symH w.1,
      transH (symH (inverse-power w.1 m)) (apH (sym Y y y) w.2)) ;
    twice (w : R.codes) : Id R.codes (invert (invert w)) w = Sigma-eq (Id Y y y) (\ p -> R.torsion p)
      _ _ _ _ (G.sym-sym Y y y w.1) (HLevels[v].trunc-set _ (gpd y y) _ _) ;
    equiv : Equiv R.codes R.codes = (invert,qinv _ _ invert invert twice twice) ;
  } ;
  negative : Equiv (A -> Y) data-type = E.compose _ _ _ evaluation
    (Fibres[u \/ v].sigma-equiv Y (\ y -> At[y].codes) (\ y -> At[y].codes) (\ y -> Invert[y].equiv)) ;
  module Book (h : A -> Y) {
    y : Y = h a ; module R = At[y] ;
    change : Id (Id Y y y) (negative.1 h).2.1 (apH h book-generator) =
      Puppe[u \/ v].ap-sym A Y h a a S.generator ;
    law : R.torsion (apH h book-generator) = subst (Id Y y y) (\ p -> R.torsion p) _ _ change (negative.1 h).2.2 ;
    value : data-type = (y,apH h book-generator,law) ;
    computes : Id data-type value (negative.1 h) = ap R.codes data-type (\ z -> (y,z)) _ _
      (Sigma-eq (Id Y y y) (\ p -> R.torsion p) _ _ _ _ (symH change) (HLevels[v].trunc-set _ (gpd y y) _ _)) ;
  } ;
  book-evaluation : Equiv (A -> Y) data-type = (\ h -> Book[h].value,
    E.homotopy _ _ negative (\ h -> Book[h].value) (\ h -> Book[h].computes)) ;
} ;
