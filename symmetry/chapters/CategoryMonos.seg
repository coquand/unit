-- Section 6.3. Monos and epis use propositional fibres even for higher homs.
level o h ; open Base ; open Prelude[h] ; open Paths[h] ;
module W = WildCategory[o,h] ;
embedding (X Y : U h) (f : X -> Y) : U h = (y : Y) -> isProp ((x : X) * Id Y (f x) y) ;
module In (C : W.Wild) (a b : C.ob) (f : C.hom a b) {
  mono : U (o \/ h) = (x : C.ob) -> embedding (C.hom x a) (C.hom x b) (C.comp x a b f) ;
  epi : U (o \/ h) = (x : C.ob) -> embedding (C.hom b x) (C.hom a x) (\ g -> C.comp a b x g f) ;
} ;
dual (C : W.Wild) (a b : C.ob) (f : C.hom a b) : Id (U (o \/ h)) In[W.op C,b,a,f].mono In[C,a,b,f].epi = refl In[C,a,b,f].epi ;
module Types (A B : U h) (f : A -> B) {
  module FL = Axioms[h].FunExtLemmas[fe @h] ;
  mono : U h+ = (X : U h) -> embedding (X -> A) (X -> B) (\ g x -> f (g x)) ;
  module Test (X : U h) (k : X -> B) {
    fiber : U h = (g : X -> A) * Id (X -> B) (\ x -> f (g x)) k ;
    points : U h = (x : X) -> (a : A) * Id B (f a) (k x) ;
    evaluate (v : fiber) : points = \ x -> (v.1 x,happly X (\ z -> B) _ k v.2 x) ;
    assemble (s : points) : fiber = ((\ x -> (s x).1),FL.funext X (\ x -> B) _ k (\ x -> (s x).2)) ;
    section (s : points) : Id points (evaluate (assemble s)) s = FL.funext X (\ x -> (a : A) * Id B (f a) (k x)) _ s
      (\ x -> ap (Id B (f (s x).1) (k x)) ((a : A) * Id B (f a) (k x)) (\ p -> ((s x).1,p)) _ _
        (apH (\ t -> t x) (FL.happly-funext X (\ z -> B) (\ z -> f (s z).1) k (\ z -> (s z).2)))) ;
    retract (v : fiber) : Id fiber (assemble (evaluate v)) v = ap (Id (X -> B) (\ x -> f (v.1 x)) k) fiber (\ t -> (v.1,t)) _ _
      (FL.funext-happly X (\ x -> B) _ k v.2) ;
    equivalence : Equiv fiber points = (evaluate,qinv _ _ evaluate assemble section retract) ;
  } ;
  from (e : embedding A B f) : mono = \ X k -> retract-prop (Test[X,k].fiber) (Test[X,k].points)
    Test[X,k].evaluate Test[X,k].assemble Test[X,k].retract (FL.isProp-Pi X (\ x -> (a : A) * Id B (f a) (k x)) (\ x -> e (k x))) ;
  module Singleton (b : B) {
    module T = Test[Top,\ t -> b] ;
    evaluate (v : T.fiber) : (a : A) * Id B (f a) b = T.evaluate v tt ;
    include (v : (a : A) * Id B (f a) b) : T.fiber = T.assemble (\ t -> v) ;
    ret (v : (a : A) * Id B (f a) b) : Id ((a : A) * Id B (f a) b) (evaluate (include v)) v =
      apH (\ s -> s tt) (T.section (\ t -> v)) ;
  } ;
  to (m : mono) (b : B) : isProp ((a : A) * Id B (f a) b) = retract-prop _ Singleton[b].T.fiber
    Singleton[b].include Singleton[b].evaluate Singleton[b].ret (m Top (\ t -> b)) ;
} ;
module Cancellation (X Y : U h) (f : X -> Y) {
  cancel : U h = (u v : X) -> Id Y (f u) (f v) -> Id X u v ;
  to (e : embedding X Y f) : cancel = \ u v p ->
    ap ((t : X) * Id Y (f t) (f v)) X (\ t -> t.1) _ _ (e (f v) (u,p) (v,refl (f v))) ;
  from (s : isSet Y) (c : cancel) : embedding X Y f = \ y u v -> Sigma-eq X (\ t -> Id Y (f t) y) _ _ _ _
    (c u.1 v.1 (transH u.2 (symH v.2))) (s _ y) ;
} ;
module InPreorder (C : W.Wild) (thin : (x y : C.ob) -> isProp (C.hom x y)) (a b : C.ob) (f : C.hom a b) {
  mono : In[C,a,b,f].mono = \ x -> Cancellation[C.hom x a,C.hom x b,C.comp _ _ _ f].from (prop-to-set _ (thin x b)) (\ g k q -> thin x a g k) ;
  epi : In[C,a,b,f].epi = \ x -> Cancellation[C.hom b x,C.hom a x,\ k -> C.comp _ _ _ k f].from (prop-to-set _ (thin a x)) (\ g k q -> thin b x g k) ;
} ;
module Ordinary (C : Category[o,h].Precategory) (a b : C.ob) (f : C.hom a b) {
  module I = In[W.forget C,a,b,f] ;
  mono-cancel : U (o \/ h) = (x : C.ob) -> Cancellation[C.hom x a,C.hom x b,C.comp x a b f].cancel ;
  epi-cancel : U (o \/ h) = (x : C.ob) -> Cancellation[C.hom b x,C.hom a x,\ g -> C.comp a b x g f].cancel ;
  mono : (I.mono -> mono-cancel) * (mono-cancel -> I.mono) =
    ((\ m x -> Cancellation[C.hom x a,C.hom x b,C.comp x a b f].to (m x)),
     \ c x -> Cancellation[C.hom x a,C.hom x b,C.comp x a b f].from (C.hom-set x b) (c x)) ;
  epi : (I.epi -> epi-cancel) * (epi-cancel -> I.epi) =
    ((\ m x -> Cancellation[C.hom b x,C.hom a x,\ g -> C.comp _ _ _ g f].to (m x)),
     \ c x -> Cancellation[C.hom b x,C.hom a x,\ g -> C.comp _ _ _ g f].from (C.hom-set a x) (c x)) ;
} ;
