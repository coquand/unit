-- Cross-universe elimination for already constructed small types.
-- The map and its fibres stay at u and the family takes its values at v.
level u v ;
open Base ; module J = Prelude[u \/ v] ;
module T = Truncation[u \/ v] ;
-- Adapt ClassBase.conn-lift and TruncUp.trunc-up to the join of two levels.
connected : (n : Nat) (X : U u) -> Connected[u].isConn n X -> Connected[u \/ v].isConn n X = split {
  zero -> \ X c -> tt ;
  suc n | r -> \ X c -> (Truncation[u].Trunc[X].induction @(u \/ v)
    (\ w -> T.Trunc[X].carrier) (\ w -> T.Trunc[X].proposition) T.Trunc[X].inc c.1,
    \ x y -> r (Id X x y) (c.2 x y)) } ;
truncated : (n : Nat) (Y : U v) -> HLevels[v].isTrunc n Y -> HLevels[u \/ v].isTrunc n Y = split {
  zero -> \ Y c -> c ; suc n | r -> \ Y t x y -> r (Id Y x y) (t x y) } ;
module Along (n : Nat) (A B : U u) (f : A -> B)
    (cf : (b : B) -> Connected[u].isConn n (Whitehead[u].fib A B f b))
    (P : B -> U v) (tP : (b : B) -> HLevels[v].isTrunc n (P b)) {
  module E = ConnectedMaps[u \/ v].Elim[n,A,B,f,\ b -> connected n (Whitehead[u].fib A B f b) (cf b),
    \ b -> P b,\ b -> truncated n (P b) (tP b)] ;
} ;
module TruncationElim (n : Nat) (X : U u) {
  module Op = ChapterTwo[u].Truncate[n,X] ;
  module Into (P : Op.carrier -> U v) (tP : (z : Op.carrier) -> HLevels[v].isTrunc (suc n) (P z)) {
    module E = Along[suc n,X,Op.carrier,Op.unit,Op.op.conn X,P,tP].E ;
    restriction : J.Equiv ((z : Op.carrier) -> P z) ((x : X) -> P (Op.unit x)) = (E.precomp,E.equiv) ;
  } ;
} ;

raise-equiv (A B : U v) (e : Prelude[v].Equiv A B) : J.Equiv A B =
  (e.1,J.qinv A B e.1 e.2.sec e.2.sec-eq (Prelude[v].sec-ret A B e.1 e.2)) ;
