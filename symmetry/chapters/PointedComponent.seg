-- Pointed maps from a connected group into a pointed groupoid land in its component.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ;
module AtBase (span : U l) (span-groupoid : HLevels[l].isTrunc CG.three span) (base : span) {
  module P = CG.Automorphisms[span,span-groupoid,base] ;
  component : U l = P.B ;
  point : component = P.pt ;
  group : CG.ConcreteGroup = P.group ;
  module Lift (K : CG.ConcreteGroup) (cone : Lemma4[l].PtMap K.space K.point span base) {
    reach (x : K.space) : P.membership (cone.1 x) = TruncationCombinators[l].map
      (Id K.space K.point x) (Id span base (cone.1 x))
      (\ p -> transH (symH cone.2) (apH cone.1 p)) ((K.connected.2 K.point x).1) ;
    lift (x : K.space) : component = (cone.1 x,reach x) ;
    module S = P.S.At[lift K.point] ;
    pointed : CG.Hom K group = (lift,(S.paths point).2.sec cone.2) ;
    factors (x : K.space) : Id span ((pointed.1 x).1) (cone.1 x) = refl (cone.1 x) ;
    pointing-law : Id (Id span (cone.1 K.point) base)
      ((S.paths point).1 pointed.2) cone.2 = (S.paths point).2.sec-eq cone.2 ;
  } ;
  module Cones (K : CG.ConcreteGroup) {
    maps : U l = CG.Hom K group ;
    cones : U l = Lemma4[l].PtMap K.space K.point span base ;
    proj (z : component) : span = z.1 ;
    forget (h : maps) : cones = (\ x -> proj (h.1 x),apH proj h.2) ;
    restore (c : cones) : maps = Lift[K,c].pointed ;
    beta (c : cones) : Id cones (forget (restore c)) c =
      ap (Id span (c.1 K.point) base) cones (\ w -> (c.1,w)) _ _ Lift[K,c].pointing-law ;
    module Over (h : maps) {
      module L = Lift[K,forget h] ;
      module At (x : K.space) {
        module S = P.S.At[L.lift x] ;
        eq : Id component (L.lift x) (h.1 x) = (S.paths (h.1 x)).2.sec (refl (proj (h.1 x))) ;
        over-id : Id (Id span (proj (h.1 x)) (proj (h.1 x))) (apH proj eq) (refl (proj (h.1 x))) =
          (S.paths (h.1 x)).2.sec-eq (refl (proj (h.1 x))) ;
      } ;
      triangle : Id (Id component (L.lift K.point) point) L.pointed.2 (transH At[K.point].eq h.2) =
        Equivalences[l].injective _ _ (L.S.paths point).1 (L.S.paths point).2 _ _
          (transH L.pointing-law (symH (transH (Groupoid[l].ap-trans component span proj _ _ _ At[K.point].eq h.2)
            (transH (apH (\ p -> transH p (apH proj h.2)) At[K.point].over-id)
              (trans-refl-l span _ _ (apH proj h.2)))))) ;
      eta : Id maps (restore (forget h)) h = DeloopMaps[l].ptmap-path K.space K.point component point
        L.lift h.1 L.pointed.2 h.2 (\ x -> At[x].eq) triangle ;
    } ;
    universal : Equiv maps cones = (forget,qinv maps cones forget restore beta (\ h -> Over[h].eta)) ;
  } ;
} ;

module Conjugation (X Y : U l) (f : X -> Y) (x : X) (p : Id X x x) {
  module LC = LoopConj[l] ;
  natural (z : X) (w : Id X x z) : Id (Id Y (f z) (f z)) (apH f (LC.conj X x z w p))
    (LC.conj Y (f x) (f z) (apH f w) (apH f p)) =
    idJ X x (\ z1 w1 -> Id (Id Y (f z1) (f z1)) (apH f (LC.conj X x z1 w1 p))
      (LC.conj Y (f x) (f z1) (apH f w1) (apH f p)))
      (transH (apH (ap X Y f x x) (LC.conj-refl-loop X x p)) (symH (LC.conj-refl-loop Y (f x) (apH f p)))) z w ;
} ;
module Canonical (K : CG.ConcreteGroup) (Y : U l) (gpd : HLevels[l].isTrunc CG.three Y) (h : K.space -> Y) {
  y : Y = h K.point ;
  module C = AtBase[Y,gpd,y] ;
  module L = C.Lift[K,(h,refl y)] ;
  module D = DeloopMaps[l].Maps[K.space,K.point,C.component,C.point] ;
  module LC = LoopConj[l] ;
  proj (x : C.component) : Y = x.1 ;
  computes (p : Id K.space K.point K.point) : Id (Id Y y y) (C.P.symmetries.1 ((D.loop L.pointed).1 p)) (apH h p) =
    transH (apH C.P.symmetries.1 (D.loop-ap L.pointed p))
      (transH (Conjugation[C.component,Y,proj,L.lift K.point,apH L.lift p].natural C.point L.pointed.2)
        (transH (apH (\ w -> LC.conj Y y y w (apH proj (apH L.lift p))) L.pointing-law)
          (transH (LC.conj-refl-loop Y y (apH proj (apH L.lift p))) (LoopCalc[l].ap-ap K.space C.component Y L.lift proj K.point K.point p)))) ;
} ;
