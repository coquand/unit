-- Construction 3.8.2 and Lemma 3.8.4. Stretch a permutation by inserting
-- m-1 idle steps. The m-th power applies the original map on every copy.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module F = FiniteCycles[l] ;
module Root (n : Nat) (X : U l) (f : X -> X) {
  index : U l = Fin (suc n) ;
  copies : U l = index * X ;
  update : index -> X -> X = split { none -> f ; some i -> \ x -> x } ;
  next (i : index) (x : X) : copies = (i,update i x) ;
  root (w : copies) : copies = next ((F.rotation n).1 w.1) w.2 ;
  module I = F.Iteration[copies,root] ;
  idle (i : Fin n) (x : X) : Id copies (root (F.prefix n i,x)) (some i,x) =
    ap index copies (\ k -> next k x) _ _ (F.advance n i) ;
  tick (x : X) : Id copies (root (F.last n,x)) (none,f x) = ap index copies (\ k -> next k x) _ _ (F.wrap n) ;
  first (x : X) : Id copies (I.power (suc n) (none,x)) (none,f x) =
    transH (apH root (I.traverse n (\ i -> (i,x)) (\ i -> idle i x))) (tick x) ;
  module At (x : X) {
    law (i : index) : U l = Id copies (I.power (suc n) (i,x)) (i,f x) ;
    advance (i : Fin n) (h : law (F.prefix n i)) : law (some i) =
      transH (apH (I.power (suc n)) (symH (idle i x)))
        (transH (I.commute (suc n) (F.prefix n i,x)) (transH (apH root h) (idle i (f x)))) ;
    lap : (i : index) -> law i = F.interval n law (first x) advance ;
  } ;
  power-law : Id (copies -> copies) (I.power (suc n)) (\ w -> (w.1,f w.2)) =
    Axioms[l].FunExtLemmas[fe @l].funext copies (\ w -> copies) _ _ (\ w -> At[w.2].lap w.1) ;
  module Invertible (e : isEquiv X X f) {
    fiberwise : (i : index) -> isEquiv X X (update i) = split { none -> e ; some i -> (idEquiv X).2 } ;
    rotate : Equiv copies copies = Equivalences[l].product index index X (F.rotation n) ;
    change : Equiv copies copies = Fibres[l].sigma-equiv index (\ i -> X) (\ i -> X) (\ i -> (update i,fiberwise i)) ;
    equivalence : isEquiv copies copies root = (Equivalences[l].compose copies copies copies rotate change).2 ;
  } ;
} ;
rho (n : Nat) (u : CycleComponents[l].Perm) : CycleComponents[l].Perm =
  ((Root[n,u.1.1,u.2.1].copies,isSet-Sigma (Fin (suc n)) (\ i -> u.1.1) (F.fin-set (suc n)) (\ i -> u.1.2)),
    Root[n,u.1.1,u.2.1].root,Root[n,u.1.1,u.2.1].Invertible[u.2.2].equivalence) ;
