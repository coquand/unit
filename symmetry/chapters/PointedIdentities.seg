-- Exercises 2.21.7, 2.21.10 and 2.21.11.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ;
module O = PtEquivOps[l] ; module Big = Prelude[l+] ;
pointed : U l+ = (X : U l) * X ;
module From (A : U l) (a : A) {
  iso (v : pointed) : U l+ = PtEquiv A a v.1 v.2 ;
  total : U l+ = (v : pointed) * iso v ;
  center : total = ((A,a),O.idPt A a) ;
  contract (w : total) : Id total center w = O.ptEqInd A a (\ Z z e -> Id total center ((Z,z),e)) (refl center) w.1.1 w.1.2 w.2 ;
  module F = FundThm[l+].FT[pointed,(A,a),iso,O.idPt A a,(center,contract)] ;
  univalence (v : pointed) : Big.Equiv (Id pointed (A,a) v) (iso v) = (F.tr v,F.equiv v) ;
  module Composite (B : U l) (b : B) (e : PtEquiv A a B b) {
    inverse : PtEquiv B b A a = O.pt-inv A a B b e ;
    left : PtMap A a A a = (O.pt-comp A a B b A a e inverse).1 ;
    right : PtMap B b B b = (O.pt-comp B b A a B b inverse e).1 ;
  } ;
  left (B : U l) (b : B) (e : PtEquiv A a B b) : Id (PtMap A a A a) Composite[B,b,e].left (O.idPt A a).1 =
    O.ptEqInd A a (\ Z z d -> Id (PtMap A a A a) Composite[Z,z,d].left (O.idPt A a).1) (refl (O.idPt A a).1) B b e ;
  right (B : U l) (b : B) (e : PtEquiv A a B b) : Id (PtMap B b B b) Composite[B,b,e].right (O.idPt B b).1 =
    O.ptEqInd A a (\ Z z d -> Id (PtMap Z z Z z) Composite[Z,z,d].right (O.idPt Z z).1) (refl (O.idPt A a).1) B b e ;
  module FibreTriangle (B : U l) (b : B) (f : PtMap A a B b) {
    module T = FamilyClassifier[l].Over[B].Total[(A,f.1)] ;
    point : T.total = (b,a,f.2) ;
    projection (w : T.total) : B = w.1 ;
    maps : U l = PtMap T.total point B b ;
    triangle : Id maps (\ w -> f.1 (T.forward w),f.2) (projection,refl b) =
      DeloopMaps[l].ptmap-path T.total point B b (\ w -> f.1 (T.forward w)) projection f.2 (refl b)
        (\ w -> w.2.2) (refl f.2) ;
  } ;
} ;
