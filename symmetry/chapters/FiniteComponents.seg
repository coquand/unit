-- Sections 2.24 and 2.27. The fibres of the cardinal map are the
-- components of Fin n, and the projections forget the indicated data.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = Prelude[l+] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module F = FiniteSets[l] ; module C = Cardinality[l] ; module T = Truncation[l] ;
module H = HLevels[l] ; module BH = HLevels[l+] ;
all : U l+ = F.Universe.all ;
part (n : Nat) : U l+ = (X : U l) * C.Count[X].size n ;
forget (X : U l) (n : Nat) (h : C.Count[X].size n) : F.Finite X =
  TruncationCombinators[l].map (Equiv (FinChoice[l].Fin n) X) ((m : Nat) * Equiv (FinChoice[l].Fin m) X) (\ e -> (n,e)) h ;
separate (v : all) : (n : Nat) * part n = ((C.Count[v.1].count v.2).1,v.1,(C.Count[v.1].count v.2).2) ;
assemble (z : (n : Nat) * part n) : all = (z.2.1,forget z.2.1 z.1 z.2.2) ;
decomposition : B.Equiv all ((n : Nat) * part n) = (separate,B.qinv _ _ separate assemble
  (\ z -> B.ap C.Count[z.2.1].cardinals ((n : Nat) * part n) (\ w -> (w.1,z.2.1,w.2)) _ _
    (C.Count[z.2.1].proposition (C.Count[z.2.1].count (assemble z).2) (z.1,z.2.2)))
  (\ v -> B.Sigma-eq (U l) (\ X -> F.Finite X) _ _ _ _ (refl v.1) (F.Universe.finite-prop v.1))) ;
module S = ChapterTwo[l+].Subtype[U l,\ X -> F.Finite X,\ X -> F.Universe.finite-prop X] ;
module At (v : all) {
  module P = ChapterTwo[l+].Projection[all,\ w -> all,v] ;
  second-set : B.Equiv P.fibre all = P.equivalence ;
  module Ux = ChapterTwo[l+].Projection[all,\ w -> w.1,v] ;
  chosen-point : B.Equiv Ux.fibre v.1 = Ux.equivalence ;
  structure : B.isSet Ux.fibre = BH.trunc-set _ (BH.equiv-trunc (suc (suc zero)) _ _ chosen-point
    (BH.set-trunc v.1 (FiniteDecisions[l].On[v.1,v.2].set))) ;
  module AtSize (n : Nat) {
    module K = ChapterTwo[l+].Projection[all,\ w -> C.Count[w.1].size n,v] ;
    property : B.isProp K.fibre = B.retract-prop K.fibre (C.Count[v.1].size n) K.forward K.backward
      (\ z -> K.contract z.1 z.2) T.Trunc[Equiv (FinChoice[l].Fin n) v.1].proposition ;
  } ;
} ;
module PathsOf (v w : all) {
  equivalent : B.Equiv (Id all v w) (Equiv v.1 w.1) = Equivalences[l+].compose _ _ _ (S.At[v].paths w)
    (Axioms[l].idtoeqv v.1 w.1,univ @l v.1 w.1) ;
  set : B.isSet (Id all v w) = BH.trunc-set _ (BH.equiv-trunc (suc (suc zero)) _ _ equivalent (BH.set-trunc _
    (Torsor[l].isSet-sub (v.1 -> w.1) (isEquiv v.1 w.1) (FL.isSet-Pi v.1 (\ x -> w.1) (\ x -> FiniteDecisions[l].On[w.1,w.2].set))
      (EquivProp[l].isEquiv-prop v.1 w.1)))) ;
} ;
module UniqueSize (n : Nat) (p : isProp (FinChoice[l].Fin n)) {
  X : U l = FinChoice[l].Fin n ;
  base : part n = (X,T.Trunc[Equiv X X].inc (idEquiv X)) ;
  module AtPoint (v : part n) {
    prop : isProp v.1 = TruncationCombinators[l].rec (Equiv X v.1) @l _ (FL.isProp-isProp v.1)
      (\ e -> retract-prop v.1 X e.2.sec e.1 e.2.sec-eq p) v.2 ;
    labels-prop : isProp (Equiv X v.1) = isProp-Sigma (X -> v.1) (isEquiv X v.1)
      (FL.isProp-Pi X (\ x -> v.1) (\ x -> prop)) (EquivProp[l].isEquiv-prop X v.1) ;
    label : Equiv X v.1 = TruncationCombinators[l].rec (Equiv X v.1) @l _ labels-prop (\ e -> e) v.2 ;
    path : Id (part n) base v = B.Sigma-eq (U l) (\ Y -> C.Count[Y].size n) _ _ _ _
      (Axioms[l].UnivalenceLemmas[univ @l].ua X v.1 label) T.Trunc[Equiv X v.1].proposition ;
  } ;
  contractible : FunExtUA[l+].isContr (part n) = (base,\ v -> AtPoint[v].path) ;
} ;
empty-component : FunExtUA[l+].isContr (part zero) = UniqueSize[zero,isProp-Empty].contractible ;
singleton-component : FunExtUA[l+].isContr (part (suc zero)) = UniqueSize[suc zero,H.contr-prop _ TwoElementSets[l].one-contr].contractible ;
