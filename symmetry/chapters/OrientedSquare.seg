-- Chapter 1. Model the oriented square by its four cyclically ordered vertices.
level l ; open Base ; open Prelude[l] ; open FinChoice[l] ;
three : Nat = suc (suc (suc zero)) ;
four : Nat = suc three ;
module C = CycleComponents[l].Finite[three] ;
module R = FiniteCycles[l].Standard[three] ;
loops : U l = ChapterOne[l].Symmetry C.Cyc.space C.Cyc.pt ;
vertices : Equiv loops (Fin four) = C.symmetries ;
labels : Equiv (Fin four) loops = Bijection[l].inverse _ _ vertices ;
finite : FiniteSets[l].Finite loops = FiniteSets[l].enumerated loops four labels ;
count : Id Nat (Cardinality[l].Count[loops].cardinal finite) four = Cardinality[l].Count[loops].computes finite four labels ;
quarter-turn : Equiv (Fin four) (Fin four) = FiniteCycles[l].rotation three ;
full-turn (x : Fin four) : Id (Fin four) (R.iterate four x) x = R.period x ;
distinct : Id (Fin four) (quarter-turn.1 none) none -> Empty = Cardinality[l].Option[Fin three].apart none ;
