-- Section 5.5. Restriction, induction and coinduction of G-sets along a
-- homomorphism, and Lemma 5.5.6 from Theorem 5.5.7.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module HL = HLevels[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Along (G H : CG.ConcreteGroup) (f : CG.Hom G H) {
  module AG = ChapterFive[l,l].Actions[G] ; module AH = ChapterFive[l,l].Actions[H] ;
  Bf : G.space -> H.space = f.1 ;
  -- Definition 5.5.9: restriction f^* and induction f_!.
  restrict (Y : AH.GSet) : AG.GSet = \ z -> Y (Bf z) ;
  module Induce (X : AG.GSet) (w : H.space) {
    module T = ChapterTwo[l].Truncate[suc zero,(z : G.space) * Id H.space (Bf z) w * (X z).1] ;
    carrier : U l = T.carrier ;
    set : isSet carrier = HL.trunc-set _ (T.op.trunc ((z : G.space) * Id H.space (Bf z) w * (X z).1)) ;
  } ;
  induce (X : AG.GSet) : AH.GSet = \ w -> (Induce[X,w].carrier,Induce[X,w].set) ;
  -- Remark 5.5.13: coinduction f_*.
  coinduce (X : AG.GSet) : AH.GSet = \ w -> ((z : G.space) -> Id H.space (Bf z) w -> (X z).1,
    FL.isSet-Pi G.space (\ z -> Id H.space (Bf z) w -> (X z).1) (\ z -> FL.isSet-Pi (Id H.space (Bf z) w) (\ p -> (X z).1) (\ p -> (X z).2))) ;
  -- The unit of the induction: x in X(z) gives the class of (z,refl,x) in f_! X (Bf z).
  unit (X : AG.GSet) (z : G.space) (x : (X z).1) : (restrict (induce X) z).1 = Induce[X,Bf z].T.unit (z,refl (Bf z),x) ;
} ;
-- The action on paths of an equivalence is an equivalence.
module ApEquiv (A : U l+) {
  module P = Prelude[l+] ;
  motive (B : U l+) (e : P.Equiv A B) : U l++ = (y z : A) -> P.isEquiv (Id A y z) (Id B (e.1 y) (e.1 z)) (P.ap A B e.1 y z) ;
  ap-id (y z : A) (p : Id A y z) : Id (Id A y z) (P.ap A A (\ x -> x) y z p) p =
    idJ A y (\ w q -> Id (Id A y w) (P.ap A A (\ x -> x) y w q) q) (refl (refl y)) z p ;
  base : motive A (P.idEquiv A) = \ y z ->
    Equivalences[l+].homotopy (Id A y z) (Id A y z) (P.idEquiv (Id A y z)) (P.ap A A (\ x -> x) y z) (ap-id y z) ;
  equiv (B : U l+) (e : P.Equiv A B) : motive B e = Axioms[l+].UnivalenceLemmas[univ @(l+)].eqind A motive base B e ;
} ;
-- Lemma 5.5.6: the principal G-sets P_y form an embedding of BG into G-sets.
module Principal (G : CG.ConcreteGroup) {
  module C = ConcreteTorsors[l].Classify[G] ;
  embedding (y z : G.space) : Big.isEquiv (Id G.space y z) (Id C.Tor (C.classify y) (C.classify z))
    (Big.ap G.space C.Tor C.classify y z) = ApEquiv[G.space].equiv C.Tor C.equivalence y z ;
} ;
-- The set truncation of a set is the set itself.
module SetTrunc (A : U l) (sA : isSet A) {
  module ST = ChapterTwo[l].Truncate[suc zero,A] ;
  module R = ST.Into[\ z -> A,\ z -> HL.set-trunc A sA] ;
  out : ST.carrier -> A = R.E.ext (\ a -> a) ;
  st-set : isSet ST.carrier = HL.trunc-set _ (ST.op.trunc A) ;
  module Q = ST.Into[\ z -> Id ST.carrier (ST.unit (out z)) z,\ z -> HL.prop-trunc (suc zero) _ (st-set _ z)] ;
  equiv : Equiv A ST.carrier = (ST.unit,qinv _ _ ST.unit out (Q.E.ext (\ a -> apH ST.unit (R.E.ext-beta (\ a1 -> a1) a)))
    (\ a -> R.E.ext-beta (\ a1 -> a1) a)) ;
} ;
-- Construction 5.5.16: induction of torsors.
module Torsors (G H : CG.ConcreteGroup) (f : CG.Hom G H) {
  module I = Along[G,H,f] ; module CGt = ConcreteTorsors[l].Classify[G] ; module CHt = ConcreteTorsors[l].Classify[H] ;
  module Sing (z : G.space) (w : H.space) {
    total : U l = (z' : G.space) * Id H.space (I.Bf z') w * Id G.space z z' ;
    contract : Equiv total (Id H.space (I.Bf z) w) = (\ t -> subst G.space (\ y -> Id H.space (I.Bf y) w) t.1 z (sym G.space z t.1 t.2.2) t.2.1,
      qinv _ _ (\ t -> subst G.space (\ y -> Id H.space (I.Bf y) w) t.1 z (sym G.space z t.1 t.2.2) t.2.1) (\ p -> (z,p,refl z)) (\ p -> refl p)
        (\ t -> idJ G.space z (\ y q -> (p : Id H.space (I.Bf y) w) -> Id total (z,subst G.space (\ y1 -> Id H.space (I.Bf y1) w) y z (sym G.space z y q) p,refl z) (y,p,q))
          (\ p -> refl (z,p,refl z)) t.1 t.2.2 t.2.1)) ;
    set : isSet (Id H.space (I.Bf z) w) = HL.trunc-set _ (H.groupoid (I.Bf z) w) ;
    total-set : isSet total = HL.trunc-set total (HL.equiv-trunc CG.two total _ contract (HL.set-trunc _ set)) ;
    equiv : Equiv (I.Induce[CGt.represent z,w].carrier) (Id H.space (I.Bf z) w) =
      Equivalences[l].compose _ _ _ (Bijection[l].inverse _ _ SetTrunc[total,total-set].equiv) contract ;
  } ;
  -- eta: the induced G-set of P_z is P_(Bf z).
  eta (z : G.space) : Id I.AH.GSet (I.induce (CGt.represent z)) (CHt.represent (I.Bf z)) =
    Axioms[l+].FunExtLemmas[fe @(l+)].funext H.space (\ w -> I.AH.SetAt) _ _ (\ w -> Big.Sigma-eq (U l) (\ A -> isSet A) _ _ _ _
      (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ Sing[z,w].equiv) (Torsor[l].isProp-isSet _)) ;
  base-path : Id I.AH.GSet CHt.principal (I.induce CGt.principal) =
    Big.trans I.AH.GSet _ _ _ (Big.ap H.space I.AH.GSet CHt.represent _ _ (Big.sym H.space _ _ f.2)) (Big.sym I.AH.GSet _ _ (eta G.point)) ;
  induce (t : CGt.Tor) : CHt.Tor = (I.induce t.1,TruncationCombinators[l+].map (Id I.AG.GSet CGt.principal t.1) (Id I.AH.GSet CHt.principal (I.induce t.1))
    (\ p -> Big.trans I.AH.GSet _ _ _ base-path (Big.ap I.AG.GSet I.AH.GSet I.induce _ _ p)) t.2) ;
  square (z : G.space) : Id CHt.Tor (induce (CGt.classify z)) (CHt.classify (I.Bf z)) =
    Big.Sigma-eq I.AH.GSet CHt.mere _ _ _ _ (eta z) Truncation[l+].Trunc[Id I.AH.GSet CHt.principal (CHt.represent (I.Bf z))].proposition ;
  pointed : Id CHt.Tor (induce (CGt.classify G.point)) (CHt.classify H.point) =
    Big.trans CHt.Tor _ _ _ (square G.point) (Big.ap H.space CHt.Tor CHt.classify _ _ f.2) ;
} ;
-- Lemma 5.5.17 (after the Rocq development): when Uf is surjective, Bf has
-- connected fibres, and restriction along Bf is an embedding of H-sets into G-sets.
module Restriction (G H : CG.ConcreteGroup) (f : CG.Hom G H)
  (surj : (h : Id H.space H.point H.point) -> Truncation[l].Trunc[(g : Id G.space G.point G.point) *
     Id (Id H.space H.point H.point) (SubgroupTheory[l].Over[H].loop-map G f g) h].carrier) {
  module I = Along[G,H,f] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module LC = LoopConj[l] ;
  module M = DeloopMaps[l].Maps[G.space,G.point,H.space,H.point] ;
  pt : G.space = G.point ; Bf : G.space -> H.space = I.Bf ;
  fib (y : H.space) : U l = Whitehead[l].fib G.space H.space Bf y ;
  centre : fib H.point = (pt,f.2) ;
  module Centre (p : Id H.space (Bf pt) H.point) (d : Id G.space pt pt)
    (hd : Id (Id H.space H.point H.point) (SubgroupTheory[l].Over[H].loop-map G f d)
      (LC.conj H.space (Bf pt) H.point f.2 (trans H.space _ _ _ p (sym H.space _ _ f.2)))) {
    on-d : Id (Id H.space (Bf pt) (Bf pt)) (apH Bf d) (trans H.space _ _ _ p (sym H.space _ _ f.2)) =
      transH (symH (LC.conj-back H.space (Bf pt) H.point f.2 (apH Bf d)))
        (transH (apH (LC.conj H.space H.point (Bf pt) (sym H.space _ _ f.2)) (transH (symH (M.loop-ap f d)) hd))
          (LC.conj-back H.space (Bf pt) H.point f.2 (trans H.space _ _ _ p (sym H.space _ _ f.2)))) ;
    path : Id (fib H.point) (pt,p) centre = Sigma-path G.space (\ x -> Id H.space (Bf x) H.point) pt pt p f.2 d
      (transH (Groupoid[l].transport-fib G.space H.space Bf H.point pt pt d p)
        (transH (apH (\ r -> trans H.space _ _ _ (sym H.space _ _ r) p) on-d) (CycleImage[l].cancel-loop H.space (Bf pt) H.point f.2 p))) ;
  } ;
  to-centre (a : fib H.point) : T.Trunc[Id (fib H.point) a centre].carrier =
    TC.rec (Id G.space pt a.1) @l _ T.Trunc[Id (fib H.point) a centre].proposition
      (\ c -> idJ G.space pt (\ z r -> (p : Id H.space (Bf z) H.point) -> T.Trunc[Id (fib H.point) (z,p) centre].carrier)
        (\ p -> TC.map _ _ (\ w -> Centre[p,w.1,w.2].path)
          (surj (LC.conj H.space (Bf pt) H.point f.2 (trans H.space _ _ _ p (sym H.space _ _ f.2))))) a.1 c a.2)
      ((G.connected.2 pt a.1).1) ;
  connected-at-point : Connected[l].isConn CG.two (fib H.point) = (T.Trunc[fib H.point].inc centre,\ a b ->
    (TC.map2 (Id (fib H.point) a centre) (Id (fib H.point) b centre) (Id (fib H.point) a b)
      (\ x y -> trans (fib H.point) a centre b x (sym (fib H.point) b centre y)) (to-centre a) (to-centre b),\ x y -> tt)) ;
  connected (y : H.space) : Connected[l].isConn CG.two (fib y) = TC.rec (Id H.space H.point y) @l _
    (Connected[l].conn-prop CG.two (fib y))
    (\ q -> subst H.space (\ y1 -> Connected[l].isConn CG.two (fib y1)) H.point y q connected-at-point) ((H.connected.2 H.point y).1) ;
  -- f^* is an embedding.
  module Restrict (Y Y' : I.AH.GSet) {
    module FB = Axioms[l+].FunExtLemmas[fe @(l+)] ;
    P (w : H.space) : U l+ = Id I.AH.SetAt (Y w) (Y' w) ;
    P-set (w : H.space) : HLevels[l+].isTrunc CG.two (P w) = ActionComparison[l,l].groupoid (Y w) (Y' w) ;
    module El = ConnectedMaps[l+].Elim[CG.two,G.space,H.space,Bf,\ y -> UniverseChange[l,l+].connected CG.two (fib y) (connected y),P,P-set] ;
    composite (q : Id I.AH.GSet Y Y') : Id I.AG.GSet (I.restrict Y) (I.restrict Y') =
      FB.funext G.space (\ z -> I.AG.SetAt) _ _ (El.precomp (Big.happly H.space (\ w -> I.AH.SetAt) Y Y' q)) ;
    agrees (q : Id I.AH.GSet Y Y') : Id (Id I.AG.GSet (I.restrict Y) (I.restrict Y'))
      (Big.ap I.AH.GSet I.AG.GSet I.restrict Y Y' q) (composite q) =
      idJ I.AH.GSet Y (\ Z r -> Id (Id I.AG.GSet (I.restrict Y) (I.restrict Z)) (Big.ap I.AH.GSet I.AG.GSet I.restrict Y Z r)
        (FB.funext G.space (\ z -> I.AG.SetAt) _ _ (ConnectedMaps[l+].Elim[CG.two,G.space,H.space,Bf,
          \ y -> UniverseChange[l,l+].connected CG.two (fib y) (connected y),\ w -> Id I.AH.SetAt (Y w) (Z w),
          \ w -> ActionComparison[l,l].groupoid (Y w) (Z w)].precomp (Big.happly H.space (\ w -> I.AH.SetAt) Y Z r))))
        (Big.sym _ _ _ (FB.funext-happly G.space (\ z -> I.AG.SetAt) (I.restrict Y) (I.restrict Y) (refl (I.restrict Y)))) Y' q ;
    composite-equiv : Big.isEquiv _ _ composite = (Equivalences[l+].compose (Id I.AH.GSet Y Y') ((w : H.space) -> P w) (Id I.AG.GSet (I.restrict Y) (I.restrict Y'))
      (Big.happly H.space (\ w -> I.AH.SetAt) Y Y',fe @(l+) H.space (\ w -> I.AH.SetAt) Y Y')
      (Equivalences[l+].compose ((w : H.space) -> P w) ((z : G.space) -> P (Bf z)) (Id I.AG.GSet (I.restrict Y) (I.restrict Y')) (El.precomp,El.equiv)
        (FB.funext G.space (\ z -> I.AG.SetAt) (I.restrict Y) (I.restrict Y'),
          (Bijection[l+].inverse (Id I.AG.GSet (I.restrict Y) (I.restrict Y')) ((z : G.space) -> P (Bf z)) (Big.happly G.space (\ z -> I.AG.SetAt) (I.restrict Y) (I.restrict Y'),
            fe @(l+) G.space (\ z -> I.AG.SetAt) (I.restrict Y) (I.restrict Y'))).2))).2 ;
    embedding : Big.isEquiv _ _ (Big.ap I.AH.GSet I.AG.GSet I.restrict Y Y') =
      Equivalences[l+].homotopy _ _ (composite,composite-equiv) _ agrees ;
  } ;
} ;
