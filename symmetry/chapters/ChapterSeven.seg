-- Section 7.5. A multiplicative pointed map of symmetries has a unique delooping.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Homomorphisms (G H : ChapterFour[l].ConcreteGroup) {
  module D = DeloopMaps[l].Maps[G.space,G.point,H.space,H.point] ;
  module A = ChapterFour[l].Symmetries[G] ;
  module B = ChapterFour[l].Symmetries[H] ;
  module Lift (f : D.PMO)
    (hom : (p q : A.carrier) -> Id B.carrier (f.1 (A.abstract.mul p q)) (B.abstract.mul (f.1 p) (f.1 q))) {
    module Fibre = D.Over[f] ;
    unique : FunExtUA[l].isContr Fibre.Unloop = Fibre.Mult[G.connected,H.groupoid,\ p q -> hom q p].cor12 ;
    deloop : ChapterFour[l].Hom G H = unique.1.1 ;
    computes : Id D.PMO f (D.loop deloop) = unique.1.2 ;
  } ;

  Law (f : D.PMO) : U l = (p q : A.carrier) ->
    Id B.carrier (f.1 (A.abstract.mul p q)) (B.abstract.mul (f.1 p) (f.1 q)) ;
  law-prop (f : D.PMO) : isProp (Law f) = FL.isProp-Pi A.carrier
    (\ p -> (q : A.carrier) -> Id B.carrier (f.1 (A.abstract.mul p q)) (B.abstract.mul (f.1 p) (f.1 q)))
    (\ p -> FL.isProp-Pi A.carrier (\ q -> Id B.carrier (f.1 (A.abstract.mul p q)) (B.abstract.mul (f.1 p) (f.1 q)))
       (\ q -> B.abstract.setG _ _)) ;
  abstract-hom : U l = (f : D.PMO) * Law f ;
  module Underlying (F : ChapterFour[l].Hom G H) {
    f : D.PMO = D.loop F ;
    raw (p : A.carrier) : Id H.space (F.1 G.point) (F.1 G.point) =
      ap G.space H.space F.1 G.point G.point p ;
    c : Id H.space (F.1 G.point) (F.1 G.point) -> B.carrier =
      LoopConj[l].conj H.space (F.1 G.point) H.point F.2 ;
    law (p q : A.carrier) : Id B.carrier (f.1 (A.abstract.mul p q)) (B.abstract.mul (f.1 p) (f.1 q)) =
      calc B.carrier {
        f.1 (A.abstract.mul p q)
          =< D.loop-ap F (A.abstract.mul p q) > c (raw (A.abstract.mul p q))
          =< apH c (Groupoid[l].ap-trans G.space H.space F.1 G.point G.point G.point q p) >
             c (trans H.space (F.1 G.point) (F.1 G.point) (F.1 G.point) (raw q) (raw p))
          =< LoopConj[l].conj-mult H.space (F.1 G.point) H.point F.2 (raw q) (raw p) >
             B.abstract.mul (c (raw p)) (c (raw q))
          =< apH (\ z -> B.abstract.mul z (c (raw q))) (symH (D.loop-ap F p)) > B.abstract.mul (f.1 p) (c (raw q))
          =< apH (B.abstract.mul (f.1 p)) (symH (D.loop-ap F q)) > B.abstract.mul (f.1 p) (f.1 q) } ;
  } ;
  forward (F : ChapterFour[l].Hom G H) : abstract-hom = (D.loop F,Underlying[F].law) ;
  backward (h : abstract-hom) : ChapterFour[l].Hom G H = Lift[h.1,h.2].deloop ;
  beta (h : abstract-hom) : Id abstract-hom (forward (backward h)) h =
    Sigma-eq D.PMO Law _ _ _ _ (symH (Lift[h.1,h.2].computes)) (law-prop h.1) ;
  eta (F : ChapterFour[l].Hom G H) : Id (ChapterFour[l].Hom G H) (backward (forward F)) F =
    ap D.Over[D.loop F].Unloop (ChapterFour[l].Hom G H) (\ w -> w.1) _ _
       (Lift[D.loop F,Underlying[F].law].unique.2 (F,refl (D.loop F))) ;
  equivalence : Equiv (ChapterFour[l].Hom G H) abstract-hom =
    (forward,qinv _ _ forward backward beta eta) ;
} ;

-- Section 7.4. B(Omega X) maps by a pointed equivalence to X. The unit law
-- needed to point the underlying multiplicative bijection follows by cancellation.
module ConcreteRecovery (X : ChapterFour[l].ConcreteGroup) {
  module UX = ChapterFour[l].Symmetries[X] ;
  module R = AbstractRecovery[l].Recover[UX.abstract] ;
  BX : ChapterFour[l].ConcreteGroup = R.C.concrete ;
  module M = Homomorphisms[BX,X] ;
  e : Equiv M.A.carrier UX.carrier = R.iso ;
  image-unit : Id UX.carrier (e.1 M.A.abstract.e) UX.abstract.e =
    transH (Group[l].GrpL[UX.abstract].solve-r (e.1 M.A.abstract.e) (e.1 M.A.abstract.e) (e.1 M.A.abstract.e)
       (symH (R.preserves M.A.abstract.e M.A.abstract.e)))
       (UX.abstract.invr (e.1 M.A.abstract.e)) ;
  induced : M.abstract-hom = ((e.1,image-unit),R.preserves) ;
  f : ChapterFour[l].Hom BX X = M.backward induced ;
  loops-eq : Id M.D.PMO induced.1 (M.D.loop f) = M.Lift[induced.1,induced.2].computes ;
  underlying-equiv : isEquiv M.A.carrier UX.carrier (M.D.loop f).1 =
    subst M.D.PMO (\ h -> isEquiv M.A.carrier UX.carrier h.1) induced.1 (M.D.loop f) loops-eq e.2 ;
  pointed-equivalence : Lemma4[l].PtEquiv BX.space BX.point X.space X.point =
    (f,Whitehead[l].Pointed[BX.space,BX.point,X.space,X.point,f,BX.connected,underlying-equiv].equiv X.connected) ;
} ;

-- Forgetting the proof of unit preservation preserves the homomorphism type.
module OrdinaryMaps (G H : ChapterFour[l].ConcreteGroup) {
  module M = Homomorphisms[G,H] ;
  ordinary : U l = QGrp[l].GHom M.A.abstract M.B.abstract ;
  forget (h : M.abstract-hom) : ordinary = (h.1.1,h.2) ;
  point (h : ordinary) : M.abstract-hom = ((h.1,QGrp[l].GHomL[M.A.abstract,M.B.abstract,h].hom-e),h.2) ;
  eta (h : M.abstract-hom) : Id M.abstract-hom (point (forget h)) h =
    Sigma-eq M.D.PMO M.Law _ _ _ _
      (Sigma-eq (M.A.carrier -> M.B.carrier) (\ f -> Id M.B.carrier (f M.A.abstract.e) M.B.abstract.e)
        _ _ _ _ (refl h.1.1) (M.B.abstract.setG _ _)) (M.law-prop h.1) ;
  comparison : Equiv (ChapterFour[l].Hom G H) ordinary = Equivalences[l].compose _ _ _ M.equivalence
    (forget,qinv _ _ forget point (\ h -> refl h) eta) ;
} ;
