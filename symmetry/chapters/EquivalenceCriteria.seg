-- Section 6.7. Fully faithful and essentially surjective functors out of a category.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module K = Category[o,h] ; module V = WildCategory[o,h] ; module J = Functor[o,h,o,h] ; module G = WildFunctors[o,h,o,h] ;
module B = Prelude[o+ \/ h+] ; module BP = Paths[o+ \/ h+] ; module E = CategoricalEquivalences[o,h,o,h] ;
module FL = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
module Between (C D : K.Precategory) {
    fun : U (o \/ h) = J.Functor[C,D] ;
    module At (f : fun) {
      w : G.Map[V.forget C,V.forget D] = G.ordinary C D f ;
      module A = AdjointUniqueness[o,h,o,h].ForPrecategory[C,V.forget D,w] ;
      module Laws (r : A.right) {
        module T = Adjunctions[o,h,o,h].Wild[V.forget C,V.forget D,w,r.1].Triangles[r.2] ;
        unit (x : C.ob) : U h = C.isIso x (r.1.obj (f.obj x)) (T.unit x) ;
        counit (y : D.ob) : U h = D.isIso (f.obj (r.1.obj y)) y (T.counit y) ;
        all : U (o \/ h) = ((x : C.ob) -> unit x) * ((y : D.ob) -> counit y) ;
        prop : isProp all = isProp-Sigma ((x : C.ob) -> unit x) (\ t -> (y : D.ob) -> counit y)
          (FL.isProp-Pi C.ob (\ x -> unit x) (\ x -> Arrows[o,h].Arrows[C].isIso-prop {x} {r.1.obj (f.obj x)} (T.unit x)))
          (\ t -> FL.isProp-Pi D.ob (\ y -> counit y) (\ y -> Arrows[o,h].Arrows[D].isIso-prop {f.obj (r.1.obj y)} {y} (T.counit y))) ;
      } ;
      adj : U (o \/ h) = (r : A.right) * Laws[r].all ;
      prop (ua : K.Univalent C) : isProp adj = isProp-Sigma A.right (\ r -> Laws[r].all) (A.unique ua) (\ r -> Laws[r].prop) ;
      module Construct (ff : J.FullyFaithful C D f) (s : J.SplitEssSurj C D f) {
        module X = E.Construct[C,D,f,ff,s] ;
        result : adj = ((X.B.right,X.B.adjunction),X.unit-iso,X.counit-iso) ;
      } ;
      module Given (e : adj) {
        module T = Laws[e.1].T ;
        module X = E.Given[V.forget C,V.forget D,w,e.1.1,e.1.2].On[
          (\ x -> (((e.2.1 x).1,(e.2.1 x).2.2),(e.2.1 x).1,(e.2.1 x).2.1)),
          (\ y -> (((e.2.2 y).1,(e.2.2 y).2.2),(e.2.2 y).1,(e.2.2 y).2.1))] ;
        ff : J.FullyFaithful C D f = X.fully-faithful ;
        split-eso : J.SplitEssSurj C D f = \ y -> (e.1.1.obj y,T.counit y,e.2.2 y) ;
        es : J.EssSurj C D f = \ y -> Truncation[o \/ h].Trunc[(x : C.ob) * D.Iso (f.obj x) y].inc (split-eso y) ;
      } ;
      weak : U (o \/ h) = J.FullyFaithful C D f * J.EssSurj C D f ;
      split-weak : U (o \/ h) = J.FullyFaithful C D f * J.SplitEssSurj C D f ;
      ff-prop : isProp (J.FullyFaithful C D f) = FL.isProp-Pi C.ob
        (\ x -> (y : C.ob) -> Prelude[h].isEquiv (C.hom x y) (D.hom (f.obj x) (f.obj y)) (f.map x y))
        (\ x -> FL.isProp-Pi C.ob (\ y -> Prelude[h].isEquiv (C.hom x y) (D.hom (f.obj x) (f.obj y)) (f.map x y))
          (\ y -> EquivProp[h].isEquiv-prop _ _ (f.map x y))) ;
      split-from (u : split-weak) : adj = Construct[u.1,u.2].result ;
      split-to (e : adj) : split-weak = (Given[e].ff,Given[e].split-eso) ;
      module Section (u : split-weak) {
        module X = Construct[u.1,u.2].X ;
        point (y : D.ob) : Id ((x : C.ob) * D.Iso (f.obj x) y) ((split-to (split-from u)).2 y) (u.2 y) =
          ap (D.Iso (f.obj (X.obj y)) y) ((x : C.ob) * D.Iso (f.obj x) y) (\ i -> (X.obj y,i)) _ _
            (Arrows[o,h].Arrows[D].iso-eq _ _ (transH (X.AD.left (X.AD.arr (X.iso y)) (f.map-idn (X.obj y))) (X.AD.unit-r (X.AD.arr (X.iso y))))) ;
        law : Id split-weak (split-to (split-from u)) u = transH
          (ap (J.FullyFaithful C D f) split-weak (\ ff -> (ff,(split-to (split-from u)).2)) (split-to (split-from u)).1 u.1 (ff-prop (split-to (split-from u)).1 u.1))
          (ap (J.SplitEssSurj C D f) split-weak (\ s -> (u.1,s)) (split-to (split-from u)).2 u.2 (FL.funext D.ob (\ y -> (x : C.ob) * D.Iso (f.obj x) y) _ _ point)) ;
      } ;
      module Retract (e : adj) {
        original : A.data-type = A.pack e.1 ;
        rebuilt : adj = split-from (split-to e) ;
        new-data : A.data-type = A.pack rebuilt.1 ;
        module X = Construct[Given[e].ff,Given[e].split-eso].X ;
        module Pair (y : D.ob) {
          old : A.At[y].rep = original.1 y ; fresh : A.At[y].rep = new-data.1 y ;
          agrees (x : C.ob) (v : D.hom (f.obj x) y) : Id (C.hom x old.1) ((fresh.2.1 x).1 v) ((old.2.1 x).1 v) =
            X.L.unique (X.iso y) (X.L.lift-eq (X.iso y) v) (A.At[y].With[old].recover x v) ;
          maps : Id (A.At[y].maps old.1) fresh.2.1 old.2.1 = FL.funext C.ob (\ x -> Prelude[h].Equiv (D.hom (f.obj x) y) (C.hom x old.1)) _ _
            (\ x -> Sigma-eq (D.hom (f.obj x) y -> C.hom x old.1) (\ m -> Prelude[h].isEquiv _ _ m) _ _ _ _
              (FL.funext (D.hom (f.obj x) y) (\ v -> C.hom x old.1) _ _ (agrees x))
              (EquivProp[h].isEquiv-prop _ _ (old.2.1 x).1)) ;
          law : Id A.At[y].rep fresh old = ap ((m : A.At[y].maps old.1) * A.At[y].Laws[old.1,m].law) A.At[y].rep (\ s -> (old.1,s)) _ _
            (Sigma-eq (A.At[y].maps old.1) (\ m -> A.At[y].Laws[old.1,m].law) _ _ _ _ maps A.At[y].Laws[old.1,old.2.1].prop) ;
        } ;
        eq-data : Id A.data-type new-data original = Sigma-eq A.reps (\ s -> A.Given[s].R.choices) _ _ _ _
          (FL.funext D.ob (\ y -> A.At[y].rep) _ _ (\ y -> Pair[y].law))
          (FunExtUA[o \/ h].pathC _ A.Given[original.1].R.compatible-adjoints) ;
        law : Id adj rebuilt e = Sigma-eq A.right (\ r -> Laws[r].all) _ _ _ _
          (transH (symH (A.eta rebuilt.1.1 rebuilt.1.2)) (transH (apH A.unpack eq-data) (A.eta e.1.1 e.1.2))) Laws[e.1].prop ;
      } ;
      split-criterion : Equiv adj split-weak = (split-to,qinv _ _ split-to split-from (\ u -> Section[u].law) (\ e -> Retract[e].law)) ;
      module Univalent (ua : K.Univalent C) {
      split-prop (ff : J.FullyFaithful C D f) : isProp (J.SplitEssSurj C D f) = FL.isProp-Pi D.ob
        (\ y -> (x : C.ob) * D.Iso (f.obj x) y) (FullyFaithful[o,h,o,h,o \/ h].IntoPrecategory[new K.Category[C,ua],D,f,ff].S-prop) ;
      split-weak-prop : isProp split-weak = \ u v -> Sigma-eq (J.FullyFaithful C D f) (\ ff -> J.SplitEssSurj C D f) _ _ _ _
        (ff-prop u.1 v.1) (split-prop v.1) ;
      weak-prop : isProp weak = isProp-Sigma (J.FullyFaithful C D f) (\ ff -> J.EssSurj C D f) ff-prop
        (\ ff -> FL.isProp-Pi D.ob (\ y -> Truncation[o \/ h].Trunc[(x : C.ob) * D.Iso (f.obj x) y].carrier)
          (\ y -> Truncation[o \/ h].Trunc[(x : C.ob) * D.Iso (f.obj x) y].proposition)) ;
      to (e : adj) : weak = (Given[e].ff,Given[e].es) ;
      from (u : weak) : adj = Construct[u.1,FullyFaithful[o,h,o,h,o \/ h].IntoPrecategory[new K.Category[C,ua],D,f,u.1].choose u.2].result ;
      criterion : Equiv adj weak = (to,qinv _ _ to from (\ u -> weak-prop _ u) (\ e -> prop ua _ e)) ;
      merely : U (o \/ h) = Truncation[o \/ h].Trunc[adj].carrier ;
      from-mere (v : merely) : weak = TruncationCombinators[o \/ h].rec adj @(o \/ h) weak weak-prop to v ;
      to-mere (v : weak) : merely = Truncation[o \/ h].Trunc[adj].inc (from v) ;
      } ;
    } ;
    cat-equiv : U (o \/ h) = (f : fun) * At[f].adj ;
    object (e : cat-equiv) : fun = e.1 ;
    module Forget (ua : K.Univalent C) (f : fun) {
      fiber : U (o \/ h) = (e : cat-equiv) * Id fun (object e) f ;
      to (v : fiber) : At[f].adj = subst fun (\ g -> At[g].adj) v.1.1 f v.2 v.1.2 ;
      from (v : At[f].adj) : fiber = ((f,v),refl f) ;
      ret (v : fiber) : Id fiber (from (to v)) v =
        idJ fun v.1.1 (\ g q -> Id ((e : cat-equiv) * Id fun e.1 g)
          ((g,subst fun (\ k -> At[k].adj) v.1.1 g q v.1.2),refl g) (v.1,q)) (refl (v.1,refl v.1.1)) f v.2 ;
      embedding : isProp fiber = retract-prop fiber At[f].adj to from ret (At[f].prop ua) ;
    } ;
} ;
