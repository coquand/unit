-- A proposition on the coequalizer holds everywhere if it holds on the points.
-- Use the mapping property into the set of small propositions.
level l ;
open Base ; open Prelude[l] ;
module Big = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FB = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module QP = Quotient[l] ;
module PropSet (P : QP.Prop) {
  rel (Q : QP.Prop) : U l = (P.1 -> Q.1) * (Q.1 -> P.1) ;
  prop (Q : QP.Prop) : isProp (rel Q) = isProp-Sigma (P.1 -> Q.1) (\ f -> Q.1 -> P.1)
    (F.isProp-Pi P.1 (\ x -> Q.1) (\ x -> Q.2)) (\ f -> F.isProp-Pi Q.1 (\ y -> P.1) (\ y -> P.2)) ;
  paths (Q : QP.Prop) : Big.isProp (Id QP.Prop P Q) =
    Big.Hedberg[QP.Prop,P,\ V -> rel V,prop,(\ x -> x,\ x -> x),\ V w -> QP.prop-path P V w.1 w.2].hedberg Q ;
} ;
module Points (A B : U l) (s t : A -> B) {
  module C = HomotopyCoequalizer[l] ;
  Q : C.Coequalizer[A,B,s,t] = coeq @l A B s t ;
  module P = C.Property[A,B,s,t,Q] ;
  module Elim (D : Q.space -> U l) (prop : (z : Q.space) -> isProp (D z)) (d : (b : B) -> D (Q.point b)) {
    classify (z : Q.space) : QP.Prop = (D z,prop z) ;
    truth (z : Q.space) : QP.Prop = (Top,isTop) ;
    edges (v : B -> QP.Prop) : U l+ = (a : A) -> Id QP.Prop (v (s a)) (v (t a)) ;
    prop-edges (v : B -> QP.Prop) : Big.isProp (edges v) = FB.isProp-Pi A
      (\ a -> Id QP.Prop (v (s a)) (v (t a))) (\ a -> PropSet[v (s a)].paths (v (t a))) ;
    equal-cones : Id (P.cocone @(l+) QP.Prop) (P.restrict @(l+) QP.Prop truth) (P.restrict @(l+) QP.Prop classify) =
      Big.Sigma-eq (B -> QP.Prop) edges _ _ _ _
        (FB.funext B (\ b -> QP.Prop) _ _ (\ b -> QP.prop-path (truth (Q.point b)) (classify (Q.point b))
          (\ h -> d b) (\ h -> tt))) (prop-edges (\ b -> classify (Q.point b))) ;
    equal : Id (Q.space -> QP.Prop) truth classify = Equivalences[l+].injective
      (Q.space -> QP.Prop) (P.cocone @(l+) QP.Prop) (P.restrict @(l+) QP.Prop)
      (coeq-up @l @(l+) A B s t QP.Prop) truth classify equal-cones ;
    section (z : Q.space) : D z = Big.subst (Q.space -> QP.Prop) (\ h -> (h z).1) truth classify equal tt ;
  } ;
} ;
