-- Exercise 3.8.8. On the component of the integer successor, the m-th root
-- composed with the circle comparison c is the pointed composite c o delta_m.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module LB = LoopConj[l+] ;
module CC = CycleComponents[l] ; module I = InfiniteCycle[l] ; module C = I.Component ;
module V = InfiniteCycleCircle[l] ; module S = ChapterThree[l] ; module Z = Integers[l] ;
module TC = TruncationCombinators[l] ; module L4 = Lemma4[l] ;
-- Transport of the underlying element along a path of permutations.
act (x y : CC.Perm) (p : Id CC.Perm x y) (t : x.1.1) : y.1.1 = (CC.From[x].IdSystem.tr y p).1.1 t ;
act-trans (x y : CC.Perm) (p : Id CC.Perm x y) (z : CC.Perm) (q : Id CC.Perm y z) (t : x.1.1) :
  Id z.1.1 (act x z (Big.trans CC.Perm x y z p q) t) (act y z q (act x y p t)) =
  idJ CC.Perm y (\ w r -> Id w.1.1 (act x w (Big.trans CC.Perm x y w p r) t) (act y w r (act x y p t)))
    (refl (act x y p t)) z q ;
act-back (x y : CC.Perm) (p : Id CC.Perm x y) (t : x.1.1) : Id x.1.1 (act y x (Big.sym CC.Perm x y p) (act x y p t)) t =
  idJ CC.Perm x (\ w r -> Id x.1.1 (act w x (Big.sym CC.Perm x w r) (act x w r t)) t) (refl t) y p ;
act-forth (x y : CC.Perm) (p : Id CC.Perm x y) : (t : y.1.1) -> Id y.1.1 (act x y p (act y x (Big.sym CC.Perm x y p) t)) t =
  idJ CC.Perm x (\ w r -> (s : w.1.1) -> Id w.1.1 (act x w r (act w x (Big.sym CC.Perm x w r) s)) s) (\ s -> refl s) y p ;
act-sym-trans (x y : CC.Perm) (p : Id CC.Perm x y) (z : CC.Perm) (q : Id CC.Perm y z) : (t : z.1.1) ->
  Id x.1.1 (act z x (Big.sym CC.Perm x z (Big.trans CC.Perm x y z p q)) t) (act y x (Big.sym CC.Perm x y p) (act z y (Big.sym CC.Perm y z q) t)) =
  idJ CC.Perm y (\ w r -> (s : w.1.1) -> Id x.1.1 (act w x (Big.sym CC.Perm x w (Big.trans CC.Perm x y w p r)) s)
    (act y x (Big.sym CC.Perm x y p) (act w y (Big.sym CC.Perm y w r) s))) (\ s -> refl (act y x (Big.sym CC.Perm x y p) s)) z q ;
-- Paths in the component, seen in the large type of permutations.
sh (x y : C.space) (p : Id C.space x y) : Id CC.Perm (C.show x) (C.show y) = Big.ap C.space CC.Perm C.show x y p ;
actC (x y : C.space) (p : Id C.space x y) (t : (C.show x).1.1) : (C.show y).1.1 = act (C.show x) (C.show y) (sh x y p) t ;
actC-trans (x y : C.space) (p : Id C.space x y) (z : C.space) (q : Id C.space y z) (t : (C.show x).1.1) :
  Id (C.show z).1.1 (actC x z (trans C.space x y z p q) t) (actC y z q (actC x y p t)) =
  idJ C.space y (\ w r -> Id (C.show w).1.1 (actC x w (trans C.space x y w p r) t) (actC y w r (actC x y p t)))
    (refl (actC x y p t)) z q ;
actC-sym (x y : C.space) (p : Id C.space x y) : (t : (C.show y).1.1) ->
  Id (C.show x).1.1 (actC y x (sym C.space x y p) t) (act (C.show y) (C.show x) (Big.sym CC.Perm (C.show x) (C.show y) (sh x y p)) t) =
  idJ C.space x (\ w r -> (s : (C.show w).1.1) -> Id (C.show x).1.1 (actC w x (sym C.space x w r) s)
    (act (C.show w) (C.show x) (Big.sym CC.Perm (C.show x) (C.show w) (sh x w r)) s)) (\ s -> refl s) y p ;
u0 : CC.Perm = I.standard ;
k : Id CC.Perm (C.show C.pt) u0 = C.C.path-at-point ;
-- The integer label of a loop: transport zero around it.
label (q : Id C.space C.pt C.pt) : Z.Int = act u0 u0 (LB.conj CC.Perm (C.show C.pt) u0 k (sh C.pt C.pt q)) Z.zeroZ ;
label-is (q : Id C.space C.pt C.pt) : Id Z.Int (V.label.1 q) (label q) = refl (label q) ;
s0 : (C.show C.pt).1.1 = act u0 (C.show C.pt) (Big.sym CC.Perm (C.show C.pt) u0 k) Z.zeroZ ;
label-unfold (q : Id C.space C.pt C.pt) : Id Z.Int (label q) (act (C.show C.pt) u0 k (actC C.pt C.pt q s0)) =
  transH (act-trans u0 (C.show C.pt) (Big.sym CC.Perm (C.show C.pt) u0 k) u0
    (Big.trans CC.Perm (C.show C.pt) (C.show C.pt) u0 (sh C.pt C.pt q) k) Z.zeroZ)
    (act-trans (C.show C.pt) (C.show C.pt) (sh C.pt C.pt q) u0 k s0) ;
-- Powers of the generator, and of the predecessor at zero.
module Pred = FiniteCycles[l].Iteration[Z.Int,Z.predZ] ; module Succ = FiniteCycles[l].Iteration[Z.Int,Z.sucZ] ;
power : Nat -> Id S.Circle S.base S.base = split { zero -> refl S.base ; suc j | r -> V.M.M.A.abstract.mul r S.loop } ;
power-winding : (j : Nat) -> Id Z.Int (V.winding.1 (power j)) (Pred.power j Z.zeroZ) = split {
  zero -> S.K.band-unit S.base ;
  suc j | r -> transH (V.additive (power j) S.loop) (transH (apH (Z.add (V.winding.1 (power j))) V.inverse-generator) (apH Z.predZ r)) } ;
cancel : (j : Nat) (x : Z.Int) -> Id Z.Int (Succ.power j (Pred.power j x)) x = split {
  zero -> \ x -> refl x ;
  suc j | r -> \ x -> transH (apH (\ y -> Z.sucZ (Succ.power j y)) (symH (Pred.commute j x)))
    (transH (apH Z.sucZ (r (Z.predZ x))) (Z.suc-pred x)) } ;
module CP = CircleProperty[l].Circle[C.space] ; module CS = CircleProperty[l].Circle[S.Circle] ;
module Pt = LoopCalc[l] ;
c : L4.PtMap S.Circle S.base C.space C.pt = V.map ;
-- Each instance of the circle property has its own opaque generator.
generator-same : Id (Id S.Circle S.base S.base) CP.g S.loop = Equivalences[l].injective _ _ S.winding.1 S.winding.2 _ _
  (transH (transH (CP.band-g (refl S.base)) (apH Z.sucZ (S.K.band-unit S.base))) (symH V.generator)) ;
ev-comp (B : U l) (b0 : B) (F : L4.PtMap S.Circle S.base B b0) (G : L4.PtMap B b0 C.space C.pt) :
  Id (Id C.space C.pt C.pt) (CP.evPt C.pt (Pt.ptcomp S.Circle S.base B b0 C.space C.pt F G))
    ((DeloopMaps[l].Maps[B,b0,C.space,C.pt].loop G).1 ((DeloopMaps[l].Maps[S.Circle,S.base,B,b0].loop F).1 S.loop)) =
  transH (CP.evPt-loop C.pt (Pt.ptcomp S.Circle S.base B b0 C.space C.pt F G))
    (transH (ap (DeloopMaps[l].Maps[S.Circle,S.base,C.space,C.pt].PMO) (Id C.space C.pt C.pt) (\ h -> h.1 CP.g) _ _
      (Pt.loop-comp S.Circle S.base B b0 C.space C.pt F G))
      (ap (Id S.Circle S.base S.base) (Id C.space C.pt C.pt) (\ q -> (DeloopMaps[l].Maps[B,b0,C.space,C.pt].loop G).1
        ((DeloopMaps[l].Maps[S.Circle,S.base,B,b0].loop F).1 q)) _ _ generator-same)) ;
-- The label of the image of a loop under c is its (book) winding number.
c-label (p : Id S.Circle S.base S.base) : Id Z.Int (label ((DeloopMaps[l].Maps[S.Circle,S.base,C.space,C.pt].loop c).1 p)) (V.winding.1 p) =
  transH (ap (Id S.Circle S.base S.base -> Id C.space C.pt C.pt) Z.Int (\ f -> label (f p)) _ _ V.on-loops) (V.iso-label p) ;
module Degree (n : Nat) {
  module D = CycleDivision[l].Degree[n] ; module R = InfiniteRootBundles[l].Degree[n] ;
  rho (v : CC.Perm) : CC.Perm = CycleRoots[l].rho n v ;
  std : Id CC.Perm (rho u0) u0 = R.standard-path ;
  act-rho (x y : CC.Perm) (p : Id CC.Perm x y) (w : (rho x).1.1) :
    Id (rho y).1.1 (act (rho x) (rho y) (Big.ap CC.Perm CC.Perm rho x y p) w) (w.1,act x y p w.2) =
    idJ CC.Perm x (\ z r -> Id (rho z).1.1 (act (rho x) (rho z) (Big.ap CC.Perm CC.Perm rho x z r) w) (w.1,act x z r w.2)) (refl w) y p ;
  act-rho-sym (x y : CC.Perm) (p : Id CC.Perm x y) : (w : (rho y).1.1) ->
    Id (rho x).1.1 (act (rho y) (rho x) (Big.sym CC.Perm (rho x) (rho y) (Big.ap CC.Perm CC.Perm rho x y p)) w)
      (w.1,act y x (Big.sym CC.Perm x y p) w.2) =
    idJ CC.Perm x (\ z r -> (w : (rho z).1.1) -> Id (rho x).1.1 (act (rho z) (rho x) (Big.sym CC.Perm (rho x) (rho z) (Big.ap CC.Perm CC.Perm rho x z r)) w)
      (w.1,act z x (Big.sym CC.Perm x z r) w.2)) (\ w -> refl w) y p ;
  -- Transport along the Euclidean identification is decoding.
  act-std (w : (rho u0).1.1) : Id Z.Int (act (rho u0) u0 std w) (D.decode w) =
    Big.ap (CC.From[rho u0].Iso u0) Z.Int (\ h -> h.1.1 w) _ _ (CC.From[rho u0].IdSystem.tr-un u0 R.standard-iso) ;
  -- The root maps the component to itself.
  fibre (w : CC.Perm) : U l+ = (x : C.space) * Id CC.Perm (C.show x) w ;
  fibre-prop (w : CC.Perm) : Big.isProp (fibre w) = Groupoid[l+].emb-fib-prop C.space CC.Perm C.show C.C.image.embedding w ;
  reach (z : C.space) (p : Id C.space C.pt z) : fibre (rho (C.show z)) = (C.pt,Big.trans CC.Perm _ _ _ k
    (Big.trans CC.Perm _ _ _ (Big.sym CC.Perm (rho u0) u0 std) (Big.ap CC.Perm CC.Perm rho u0 (C.show z)
      (Big.trans CC.Perm _ _ _ (Big.sym CC.Perm (C.show C.pt) u0 k) (sh C.pt z p))))) ;
  lift (z : C.space) : fibre (rho (C.show z)) = TC.rec (Id C.space C.pt z) @(l+) (fibre (rho (C.show z)))
    (fibre-prop (rho (C.show z))) (reach z) (C.reaches z) ;
  root (z : C.space) : C.space = (lift z).1 ;
  e (z : C.space) : Id CC.Perm (C.show (root z)) (rho (C.show z)) = (lift z).2 ;
  tail : Id CC.Perm (rho (C.show C.pt)) (C.show C.pt) = Big.trans CC.Perm _ _ _ (Big.ap CC.Perm CC.Perm rho (C.show C.pt) u0 k)
    (Big.trans CC.Perm _ _ _ std (Big.sym CC.Perm (C.show C.pt) u0 k)) ;
  at-point : Id CC.Perm (C.show (root C.pt)) (C.show C.pt) = Big.trans CC.Perm _ _ _ (e C.pt) tail ;
  pointing : Id C.space (root C.pt) C.pt = (C.C.image.embedding (root C.pt) C.pt).sec at-point ;
  pointing-sh : Id (Id CC.Perm (C.show (root C.pt)) (C.show C.pt)) (sh (root C.pt) C.pt pointing) at-point =
    (C.C.image.embedding (root C.pt) C.pt).sec-eq at-point ;
  map : L4.PtMap C.space C.pt C.space C.pt = (root,pointing) ;
  module MC = DeloopMaps[l].Maps[C.space,C.pt,C.space,C.pt] ;
  natural (x y : C.space) (p : Id C.space x y) (t : (C.show (root x)).1.1) :
    Id (C.show (root y)).1.1 (actC (root x) (root y) (ap C.space C.space root x y p) t)
      (act (rho (C.show y)) (C.show (root y)) (Big.sym CC.Perm _ _ (e y)) (act (rho (C.show x)) (rho (C.show y))
        (Big.ap CC.Perm CC.Perm rho _ _ (sh x y p)) (act (C.show (root x)) (rho (C.show x)) (e x) t))) =
    idJ C.space x (\ w r -> Id (C.show (root w)).1.1 (actC (root x) (root w) (ap C.space C.space root x w r) t)
      (act (rho (C.show w)) (C.show (root w)) (Big.sym CC.Perm _ _ (e w)) (act (rho (C.show x)) (rho (C.show w))
        (Big.ap CC.Perm CC.Perm rho _ _ (sh x w r)) (act (C.show (root x)) (rho (C.show x)) (e x) t))))
      (symH (act-back (C.show (root x)) (rho (C.show x)) (e x) t)) y p ;
  -- The effect on loops: the label is multiplied by m.
  pt : C.space = C.pt ;
  P0 : CC.Perm = C.show C.pt ;
  Pr : CC.Perm = C.show (root C.pt) ;
  inner : Id (rho u0).1.1 (act u0 (rho u0) (Big.sym CC.Perm _ _ std) (act P0 u0 (Big.sym CC.Perm _ _ (Big.sym CC.Perm _ _ k)) s0)) D.origin =
    transH (apH (act u0 (rho u0) (Big.sym CC.Perm _ _ std)) (act-back u0 P0 (Big.sym CC.Perm _ _ k) Z.zeroZ))
      (transH (apH (act u0 (rho u0) (Big.sym CC.Perm _ _ std)) (symH (act-std D.origin))) (act-back (rho u0) u0 std D.origin)) ;
  tail-back : Id (rho P0).1.1 (act P0 (rho P0) (Big.sym CC.Perm _ _ tail) s0) (none,s0) =
    transH (act-sym-trans (rho P0) (rho u0) (Big.ap CC.Perm CC.Perm rho P0 u0 k) P0 (Big.trans CC.Perm _ _ _ std (Big.sym CC.Perm _ _ k)) s0)
      (transH (apH (act (rho u0) (rho P0) (Big.sym CC.Perm _ _ (Big.ap CC.Perm CC.Perm rho P0 u0 k))) (act-sym-trans (rho u0) u0 std P0 (Big.sym CC.Perm _ _ k) s0))
        (transH (apH (act (rho u0) (rho P0) (Big.sym CC.Perm _ _ (Big.ap CC.Perm CC.Perm rho P0 u0 k))) inner) (act-rho-sym P0 u0 k D.origin))) ;
  s1 : Pr.1.1 = act (rho P0) Pr (Big.sym CC.Perm _ _ (e C.pt)) (none,s0) ;
  step-in : Id Pr.1.1 (actC C.pt (root C.pt) (sym C.space _ _ pointing) s0) s1 =
    transH (actC-sym (root C.pt) C.pt pointing s0)
      (transH (Big.ap (Id CC.Perm Pr P0) Pr.1.1 (\ p -> act P0 Pr (Big.sym CC.Perm _ _ p) s0) _ _ pointing-sh)
        (transH (act-sym-trans Pr (rho P0) (e C.pt) P0 tail s0) (apH (act (rho P0) Pr (Big.sym CC.Perm _ _ (e C.pt))) tail-back))) ;
  step-loop (q : Id C.space C.pt C.pt) : Id Pr.1.1 (actC (root C.pt) (root C.pt) (ap C.space C.space root C.pt C.pt q) s1)
    (act (rho P0) Pr (Big.sym CC.Perm _ _ (e C.pt)) (none,actC C.pt C.pt q s0)) =
    transH (natural C.pt C.pt q s1) (apH (act (rho P0) Pr (Big.sym CC.Perm _ _ (e C.pt)))
      (transH (apH (act (rho P0) (rho P0) (Big.ap CC.Perm CC.Perm rho _ _ (sh C.pt C.pt q))) (act-forth Pr (rho P0) (e C.pt) (none,s0)))
        (act-rho P0 P0 (sh C.pt C.pt q) (none,s0)))) ;
  step-out (a : P0.1.1) : Id P0.1.1 (actC (root C.pt) C.pt pointing (act (rho P0) Pr (Big.sym CC.Perm _ _ (e C.pt)) (none,a)))
    (act u0 P0 (Big.sym CC.Perm _ _ k) (D.multiple (act P0 u0 k a))) =
    transH (Big.ap (Id CC.Perm Pr P0) P0.1.1 (\ p -> act Pr P0 p (act (rho P0) Pr (Big.sym CC.Perm _ _ (e C.pt)) (none,a))) _ _ pointing-sh)
      (transH (act-trans Pr (rho P0) (e C.pt) P0 tail _)
        (transH (apH (act (rho P0) P0 tail) (act-forth Pr (rho P0) (e C.pt) (none,a)))
          (transH (act-trans (rho P0) (rho u0) (Big.ap CC.Perm CC.Perm rho P0 u0 k) P0 (Big.trans CC.Perm _ _ _ std (Big.sym CC.Perm _ _ k)) (none,a))
            (transH (apH (act (rho u0) P0 (Big.trans CC.Perm _ _ _ std (Big.sym CC.Perm _ _ k))) (act-rho P0 u0 k (none,a)))
              (transH (act-trans (rho u0) u0 std P0 (Big.sym CC.Perm _ _ k) (none,act P0 u0 k a))
                (apH (act u0 P0 (Big.sym CC.Perm _ _ k)) (act-std (none,act P0 u0 k a)))))))) ;
  root-loop (q : Id C.space C.pt C.pt) : Id C.space C.pt C.pt = LoopConj[l].conj C.space (root C.pt) C.pt pointing (ap C.space C.space root C.pt C.pt q) ;
  root-label (q : Id C.space C.pt C.pt) : Id Z.Int (label (root-loop q)) (D.multiple (label q)) =
    transH (label-unfold (root-loop q))
      (transH (apH (act P0 u0 k) (actC-trans C.pt (root C.pt) (sym C.space _ _ pointing) C.pt
          (trans C.space _ _ _ (ap C.space C.space root C.pt C.pt q) pointing) s0))
        (transH (apH (act P0 u0 k) (actC-trans (root C.pt) (root C.pt) (ap C.space C.space root C.pt C.pt q) C.pt pointing (actC C.pt (root C.pt) (sym C.space _ _ pointing) s0)))
          (transH (apH (\ t -> act P0 u0 k (actC (root C.pt) C.pt pointing (actC (root C.pt) (root C.pt) (ap C.space C.space root C.pt C.pt q) t))) step-in)
            (transH (apH (\ t -> act P0 u0 k (actC (root C.pt) C.pt pointing t)) (step-loop q))
              (transH (apH (act P0 u0 k) (step-out (actC C.pt C.pt q s0)))
                (transH (act-forth P0 u0 k _) (apH D.multiple (symH (label-unfold q))))))))) ;
  -- delta_m sends the generator to its m-th power.
  delta : L4.PtMap S.Circle S.base S.Circle S.base = (CS.pointed-equiv S.base).2.sec (power D.m) ;
  delta-loop : Id (Id S.Circle S.base S.base) (CS.evPt S.base delta) (power D.m) = (CS.pointed-equiv S.base).2.sec-eq (power D.m) ;
  multiple-minus : Id Z.Int (D.multiple (negsuc zero)) (Pred.power D.m Z.zeroZ) =
    Equivalences[l].injective Z.Int Z.Int D.full.1 D.full.2 _ _ (transH (D.full.2.sec-eq Z.zeroZ) (symH (cancel D.m Z.zeroZ))) ;
  left : L4.PtMap S.Circle S.base C.space C.pt = Pt.ptcomp S.Circle S.base C.space C.pt C.space C.pt c map ;
  right : L4.PtMap S.Circle S.base C.space C.pt = Pt.ptcomp S.Circle S.base S.Circle S.base C.space C.pt delta c ;
  left-label : Id Z.Int (label (CP.evPt C.pt left)) (Pred.power D.m Z.zeroZ) =
    transH (apH label (ev-comp C.space C.pt c map))
      (transH (apH label (MC.loop-ap map ((DeloopMaps[l].Maps[S.Circle,S.base,C.space,C.pt].loop c).1 S.loop)))
        (transH (root-label ((DeloopMaps[l].Maps[S.Circle,S.base,C.space,C.pt].loop c).1 S.loop))
          (transH (apH D.multiple V.loop-label) multiple-minus))) ;
  right-label : Id Z.Int (label (CP.evPt C.pt right)) (Pred.power D.m Z.zeroZ) =
    transH (apH label (ev-comp S.Circle S.base delta c))
      (transH (c-label _) (transH (apH V.winding.1 (transH (symH (CS.evPt-loop S.base delta)) delta-loop)) (power-winding D.m))) ;
  same-loop : Id (Id C.space C.pt C.pt) (CP.evPt C.pt left) (CP.evPt C.pt right) =
    Equivalences[l].injective _ _ V.label.1 V.label.2 _ _ (transH left-label (symH right-label)) ;
  -- Exercise 3.8.8: rho_m o c = c o delta_m as pointed maps.
  comparison : Id (L4.PtMap S.Circle S.base C.space C.pt) left right =
    Equivalences[l].injective _ _ (CP.evPt C.pt) (CP.pointed-up C.pt) _ _ same-loop ;
} ;
