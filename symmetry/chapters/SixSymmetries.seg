-- Exercise 4.6.14. Enumerate the permutations of three letters, then
-- compare composition with evaluation on the two six-vertex bicycles.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module F = FiniteBicycles[l] ; module S = F.Six ; module B = BicycleSymmetries[l] ;
module H = F.Hexagon ; module P = F.Prism ; module BG = BicycleGroups[l] ;
n : Nat = ChapterFour[l].three ; X : U l = Fin n ;
i : X = none ; j : X = some none ; k : X = some (some none) ;
cases (A : X -> U l) (u : A i) (v : A j) (w : A k) : (x : X) -> A x =
  combine (suc (suc zero)) A u (combine (suc zero) (\ t -> A (some t)) v (combine zero (\ t -> A (some (some t))) w (\ t -> absurd _ t))) ;
at (x y z : X) : X -> X = cases (\ t -> X) x y z ;
arrow (f g : X -> X) (r : (x : X) -> Id X (f (g x)) x) (s : (x : X) -> Id X (g (f x)) x) : Equiv X X = (f,qinv _ _ f g r s) ;
ext (f g : Equiv X X) (a : Id X (f.1 i) (g.1 i)) (b : Id X (f.1 j) (g.1 j)) (c : Id X (f.1 k) (g.1 k)) : Id (Equiv X X) f g =
  Sigma-eq (X -> X) (isEquiv X X) _ _ _ _ (Axioms[l].FunExtLemmas[fe @l].funext X (\ x -> X) _ _
    (cases (\ x -> Id X (f.1 x) (g.1 x)) a b c)) (EquivProp[l].isEquiv-prop X X g.1) ;
tag : X -> Nat = cases (\ x -> Nat) zero (suc zero) (suc (suc zero)) ;
ijk : Equiv X X = arrow (at i j k) (at i j k)
  (cases (\ x -> Id X ((at i j k) ((at i j k) x)) x) (refl i) (refl j) (refl k)) (cases (\ x -> Id X ((at i j k) ((at i j k) x)) x) (refl i) (refl j) (refl k)) ;
ikj : Equiv X X = arrow (at i k j) (at i k j)
  (cases (\ x -> Id X ((at i k j) ((at i k j) x)) x) (refl i) (refl j) (refl k)) (cases (\ x -> Id X ((at i k j) ((at i k j) x)) x) (refl i) (refl j) (refl k)) ;
jik : Equiv X X = arrow (at j i k) (at j i k)
  (cases (\ x -> Id X ((at j i k) ((at j i k) x)) x) (refl i) (refl j) (refl k)) (cases (\ x -> Id X ((at j i k) ((at j i k) x)) x) (refl i) (refl j) (refl k)) ;
jki : Equiv X X = arrow (at j k i) (at k i j)
  (cases (\ x -> Id X ((at j k i) ((at k i j) x)) x) (refl i) (refl j) (refl k)) (cases (\ x -> Id X ((at k i j) ((at j k i) x)) x) (refl i) (refl j) (refl k)) ;
kij : Equiv X X = arrow (at k i j) (at j k i)
  (cases (\ x -> Id X ((at k i j) ((at j k i) x)) x) (refl i) (refl j) (refl k)) (cases (\ x -> Id X ((at j k i) ((at k i j) x)) x) (refl i) (refl j) (refl k)) ;
kji : Equiv X X = arrow (at k j i) (at k j i)
  (cases (\ x -> Id X ((at k j i) ((at k j i) x)) x) (refl i) (refl j) (refl k)) (cases (\ x -> Id X ((at k j i) ((at k j i) x)) x) (refl i) (refl j) (refl k)) ;
separate (x y : X) (h : Id X x y) : NatArith[l].code (tag x) (tag y) =
  subst Nat (NatArith[l].code (tag x)) _ _ (apH tag h) (NatArith[l].code-refl (tag x)) ;
distinct (x y z : X) : U l = (Id X x y -> Empty) * (Id X x z -> Empty) * (Id X y z -> Empty) ;
injective (f : Equiv X X) : distinct (f.1 i) (f.1 j) (f.1 k) =
  ((\ h -> separate i j (Equivalences[l].injective _ _ f.1 f.2 i j h)),
    (\ h -> separate i k (Equivalences[l].injective _ _ f.1 f.2 i k h)),
    \ h -> separate j k (Equivalences[l].injective _ _ f.1 f.2 j k h)) ;
X3 : U l = X ; n3 : Nat = n ;
module Enumeration (table : S.X -> Equiv X X) {
  found (x y z : X) : U l = (r : S.X) * Id X ((table r).1 i) x * Id X ((table r).1 j) y * Id X ((table r).1 k) z ;
  valid (x y z : X) : U l = distinct x y z -> found x y z ;

  module Decode (lookup : (x y z : X) -> valid x y z) {
    find (f : Equiv X X) : found (f.1 i) (f.1 j) (f.1 k) = lookup (f.1 i) (f.1 j) (f.1 k) (injective f) ;
    recover (f : Equiv X X) : Id (Equiv X X) (table (find f).1) f = ext _ f (find f).2.1 (find f).2.2.1 (find f).2.2.2 ;
  } ;
} ;
module Hex {

  table : S.X -> Equiv X X = split { k0 -> ijk ; k1 -> jik ; k2 -> jki ; k3 -> kji ; k4 -> kij ; k5 -> ikj } ;
  module L = Enumeration[table] ;
  row-ii : (z : X3) -> L.valid i i z = cases (\ z -> L.valid i i z)
    (\ d -> absurd _ (d.1 (refl i))) (\ d -> absurd _ (d.1 (refl i))) (\ d -> absurd _ (d.1 (refl i))) ;
  row-ij : (z : X3) -> L.valid i j z = cases (\ z -> L.valid i j z)
    (\ d -> absurd _ (d.2.1 (refl i))) (\ d -> absurd _ (d.2.2 (refl j))) (\ d -> (S.v0,refl i,refl j,refl k)) ;
  row-ik : (z : X3) -> L.valid i k z = cases (\ z -> L.valid i k z)
    (\ d -> absurd _ (d.2.1 (refl i))) (\ d -> (S.v5,refl i,refl k,refl j)) (\ d -> absurd _ (d.2.2 (refl k))) ;
  row-ji : (z : X3) -> L.valid j i z = cases (\ z -> L.valid j i z)
    (\ d -> absurd _ (d.2.2 (refl i))) (\ d -> absurd _ (d.2.1 (refl j))) (\ d -> (S.v1,refl j,refl i,refl k)) ;
  row-jj : (z : X3) -> L.valid j j z = cases (\ z -> L.valid j j z)
    (\ d -> absurd _ (d.1 (refl j))) (\ d -> absurd _ (d.1 (refl j))) (\ d -> absurd _ (d.1 (refl j))) ;
  row-jk : (z : X3) -> L.valid j k z = cases (\ z -> L.valid j k z)
    (\ d -> (S.v2,refl j,refl k,refl i)) (\ d -> absurd _ (d.2.1 (refl j))) (\ d -> absurd _ (d.2.2 (refl k))) ;
  row-ki : (z : X3) -> L.valid k i z = cases (\ z -> L.valid k i z)
    (\ d -> absurd _ (d.2.2 (refl i))) (\ d -> (S.v4,refl k,refl i,refl j)) (\ d -> absurd _ (d.2.1 (refl k))) ;
  row-kj : (z : X3) -> L.valid k j z = cases (\ z -> L.valid k j z)
    (\ d -> (S.v3,refl k,refl j,refl i)) (\ d -> absurd _ (d.2.2 (refl j))) (\ d -> absurd _ (d.2.1 (refl k))) ;
  row-kk : (z : X3) -> L.valid k k z = cases (\ z -> L.valid k k z)
    (\ d -> absurd _ (d.1 (refl k))) (\ d -> absurd _ (d.1 (refl k))) (\ d -> absurd _ (d.1 (refl k))) ;
  lookup : (x y z : X3) -> L.valid x y z = cases (\ x -> (y z : X3) -> L.valid x y z)
    (cases (\ y -> (z : X3) -> L.valid i y z) row-ii row-ij row-ik)
    (cases (\ y -> (z : X3) -> L.valid j y z) row-ji row-jj row-jk)
    (cases (\ y -> (z : X3) -> L.valid k y z) row-ki row-kj row-kk) ;
  module D = L.Decode[lookup] ;
  eta : (v : S.X) -> Id S.X (D.find (table v)).1 v = split { k0 -> refl S.v0 ; k1 -> refl S.v1 ; k2 -> refl S.v2 ; k3 -> refl S.v3 ; k4 -> refl S.v4 ; k5 -> refl S.v5 } ;
  labels : Equiv S.X (Equiv X3 X3) = (table,qinv _ _ table (\ f -> (D.find f).1) D.recover eta) ;
  law (x y : S.X) : U l = (z : X3) -> Id X3 ((table ((H.send x).1.1 y)).1 z) ((table x).1 ((table y).1 z)) ;
  entry (u v : S.X) (z : X3) : U l = Id X3 ((table ((H.send u).1.1 v)).1 z) ((table u).1 ((table v).1 z)) ;
  check (u v : S.X) : entry u v i -> entry u v j -> entry u v k -> law u v = cases (entry u v) ;
  row0 : (v : S.X) -> law S.v0 v = S.cases (law S.v0)
    (check S.v0 S.v0 (refl i) (refl j) (refl k))
    (check S.v0 S.v1 (refl j) (refl i) (refl k))
    (check S.v0 S.v2 (refl j) (refl k) (refl i))
    (check S.v0 S.v3 (refl k) (refl j) (refl i))
    (check S.v0 S.v4 (refl k) (refl i) (refl j))
    (check S.v0 S.v5 (refl i) (refl k) (refl j)) ;
  row1 : (v : S.X) -> law S.v1 v = S.cases (law S.v1)
    (check S.v1 S.v0 (refl j) (refl i) (refl k))
    (check S.v1 S.v1 (refl i) (refl j) (refl k))
    (check S.v1 S.v2 (refl i) (refl k) (refl j))
    (check S.v1 S.v3 (refl k) (refl i) (refl j))
    (check S.v1 S.v4 (refl k) (refl j) (refl i))
    (check S.v1 S.v5 (refl j) (refl k) (refl i)) ;
  row2 : (v : S.X) -> law S.v2 v = S.cases (law S.v2)
    (check S.v2 S.v0 (refl j) (refl k) (refl i))
    (check S.v2 S.v1 (refl k) (refl j) (refl i))
    (check S.v2 S.v2 (refl k) (refl i) (refl j))
    (check S.v2 S.v3 (refl i) (refl k) (refl j))
    (check S.v2 S.v4 (refl i) (refl j) (refl k))
    (check S.v2 S.v5 (refl j) (refl i) (refl k)) ;
  row3 : (v : S.X) -> law S.v3 v = S.cases (law S.v3)
    (check S.v3 S.v0 (refl k) (refl j) (refl i))
    (check S.v3 S.v1 (refl j) (refl k) (refl i))
    (check S.v3 S.v2 (refl j) (refl i) (refl k))
    (check S.v3 S.v3 (refl i) (refl j) (refl k))
    (check S.v3 S.v4 (refl i) (refl k) (refl j))
    (check S.v3 S.v5 (refl k) (refl i) (refl j)) ;
  row4 : (v : S.X) -> law S.v4 v = S.cases (law S.v4)
    (check S.v4 S.v0 (refl k) (refl i) (refl j))
    (check S.v4 S.v1 (refl i) (refl k) (refl j))
    (check S.v4 S.v2 (refl i) (refl j) (refl k))
    (check S.v4 S.v3 (refl j) (refl i) (refl k))
    (check S.v4 S.v4 (refl j) (refl k) (refl i))
    (check S.v4 S.v5 (refl k) (refl j) (refl i)) ;
  row5 : (v : S.X) -> law S.v5 v = S.cases (law S.v5)
    (check S.v5 S.v0 (refl i) (refl k) (refl j))
    (check S.v5 S.v1 (refl k) (refl i) (refl j))
    (check S.v5 S.v2 (refl k) (refl j) (refl i))
    (check S.v5 S.v3 (refl j) (refl k) (refl i))
    (check S.v5 S.v4 (refl j) (refl i) (refl k))
    (check S.v5 S.v5 (refl i) (refl j) (refl k)) ;
  group-path : Id ChapterFour[l].ConcreteGroup H.group BG.Permutations[X3,FiniteCycles[l].fin-set n3].G.group =
    BG.Compare[H.bicycle,S.v0,H.send,H.sends,X3,FiniteCycles[l].fin-set n3,labels,
      S.cases (\ x -> (y : S.X) -> law x y) row0 row1 row2 row3 row4 row5].id ;
} ;
module Prism {

  table : S.X -> Equiv X X = split { k0 -> ijk ; k1 -> kij ; k2 -> jki ; k3 -> jik ; k4 -> ikj ; k5 -> kji } ;
  module L = Enumeration[table] ;
  row-ii : (z : X3) -> L.valid i i z = cases (\ z -> L.valid i i z)
    (\ d -> absurd _ (d.1 (refl i))) (\ d -> absurd _ (d.1 (refl i))) (\ d -> absurd _ (d.1 (refl i))) ;
  row-ij : (z : X3) -> L.valid i j z = cases (\ z -> L.valid i j z)
    (\ d -> absurd _ (d.2.1 (refl i))) (\ d -> absurd _ (d.2.2 (refl j))) (\ d -> (S.v0,refl i,refl j,refl k)) ;
  row-ik : (z : X3) -> L.valid i k z = cases (\ z -> L.valid i k z)
    (\ d -> absurd _ (d.2.1 (refl i))) (\ d -> (S.v4,refl i,refl k,refl j)) (\ d -> absurd _ (d.2.2 (refl k))) ;
  row-ji : (z : X3) -> L.valid j i z = cases (\ z -> L.valid j i z)
    (\ d -> absurd _ (d.2.2 (refl i))) (\ d -> absurd _ (d.2.1 (refl j))) (\ d -> (S.v3,refl j,refl i,refl k)) ;
  row-jj : (z : X3) -> L.valid j j z = cases (\ z -> L.valid j j z)
    (\ d -> absurd _ (d.1 (refl j))) (\ d -> absurd _ (d.1 (refl j))) (\ d -> absurd _ (d.1 (refl j))) ;
  row-jk : (z : X3) -> L.valid j k z = cases (\ z -> L.valid j k z)
    (\ d -> (S.v2,refl j,refl k,refl i)) (\ d -> absurd _ (d.2.1 (refl j))) (\ d -> absurd _ (d.2.2 (refl k))) ;
  row-ki : (z : X3) -> L.valid k i z = cases (\ z -> L.valid k i z)
    (\ d -> absurd _ (d.2.2 (refl i))) (\ d -> (S.v1,refl k,refl i,refl j)) (\ d -> absurd _ (d.2.1 (refl k))) ;
  row-kj : (z : X3) -> L.valid k j z = cases (\ z -> L.valid k j z)
    (\ d -> (S.v5,refl k,refl j,refl i)) (\ d -> absurd _ (d.2.2 (refl j))) (\ d -> absurd _ (d.2.1 (refl k))) ;
  row-kk : (z : X3) -> L.valid k k z = cases (\ z -> L.valid k k z)
    (\ d -> absurd _ (d.1 (refl k))) (\ d -> absurd _ (d.1 (refl k))) (\ d -> absurd _ (d.1 (refl k))) ;
  lookup : (x y z : X3) -> L.valid x y z = cases (\ x -> (y z : X3) -> L.valid x y z)
    (cases (\ y -> (z : X3) -> L.valid i y z) row-ii row-ij row-ik)
    (cases (\ y -> (z : X3) -> L.valid j y z) row-ji row-jj row-jk)
    (cases (\ y -> (z : X3) -> L.valid k y z) row-ki row-kj row-kk) ;
  module D = L.Decode[lookup] ;
  eta : (v : S.X) -> Id S.X (D.find (table v)).1 v = split { k0 -> refl S.v0 ; k1 -> refl S.v1 ; k2 -> refl S.v2 ; k3 -> refl S.v3 ; k4 -> refl S.v4 ; k5 -> refl S.v5 } ;
  labels : Equiv S.X (Equiv X3 X3) = (table,qinv _ _ table (\ f -> (D.find f).1) D.recover eta) ;
  law (x y : S.X) : U l = (z : X3) -> Id X3 ((table ((P.send x).1.1 y)).1 z) ((table x).1 ((table y).1 z)) ;
  entry (u v : S.X) (z : X3) : U l = Id X3 ((table ((P.send u).1.1 v)).1 z) ((table u).1 ((table v).1 z)) ;
  check (u v : S.X) : entry u v i -> entry u v j -> entry u v k -> law u v = cases (entry u v) ;
  row0 : (v : S.X) -> law S.v0 v = S.cases (law S.v0)
    (check S.v0 S.v0 (refl i) (refl j) (refl k))
    (check S.v0 S.v1 (refl k) (refl i) (refl j))
    (check S.v0 S.v2 (refl j) (refl k) (refl i))
    (check S.v0 S.v3 (refl j) (refl i) (refl k))
    (check S.v0 S.v4 (refl i) (refl k) (refl j))
    (check S.v0 S.v5 (refl k) (refl j) (refl i)) ;
  row1 : (v : S.X) -> law S.v1 v = S.cases (law S.v1)
    (check S.v1 S.v0 (refl k) (refl i) (refl j))
    (check S.v1 S.v1 (refl j) (refl k) (refl i))
    (check S.v1 S.v2 (refl i) (refl j) (refl k))
    (check S.v1 S.v3 (refl i) (refl k) (refl j))
    (check S.v1 S.v4 (refl k) (refl j) (refl i))
    (check S.v1 S.v5 (refl j) (refl i) (refl k)) ;
  row2 : (v : S.X) -> law S.v2 v = S.cases (law S.v2)
    (check S.v2 S.v0 (refl j) (refl k) (refl i))
    (check S.v2 S.v1 (refl i) (refl j) (refl k))
    (check S.v2 S.v2 (refl k) (refl i) (refl j))
    (check S.v2 S.v3 (refl k) (refl j) (refl i))
    (check S.v2 S.v4 (refl j) (refl i) (refl k))
    (check S.v2 S.v5 (refl i) (refl k) (refl j)) ;
  row3 : (v : S.X) -> law S.v3 v = S.cases (law S.v3)
    (check S.v3 S.v0 (refl j) (refl i) (refl k))
    (check S.v3 S.v1 (refl k) (refl j) (refl i))
    (check S.v3 S.v2 (refl i) (refl k) (refl j))
    (check S.v3 S.v3 (refl i) (refl j) (refl k))
    (check S.v3 S.v4 (refl j) (refl k) (refl i))
    (check S.v3 S.v5 (refl k) (refl i) (refl j)) ;
  row4 : (v : S.X) -> law S.v4 v = S.cases (law S.v4)
    (check S.v4 S.v0 (refl i) (refl k) (refl j))
    (check S.v4 S.v1 (refl j) (refl i) (refl k))
    (check S.v4 S.v2 (refl k) (refl j) (refl i))
    (check S.v4 S.v3 (refl k) (refl i) (refl j))
    (check S.v4 S.v4 (refl i) (refl j) (refl k))
    (check S.v4 S.v5 (refl j) (refl k) (refl i)) ;
  row5 : (v : S.X) -> law S.v5 v = S.cases (law S.v5)
    (check S.v5 S.v0 (refl k) (refl j) (refl i))
    (check S.v5 S.v1 (refl i) (refl k) (refl j))
    (check S.v5 S.v2 (refl j) (refl i) (refl k))
    (check S.v5 S.v3 (refl j) (refl k) (refl i))
    (check S.v5 S.v4 (refl k) (refl i) (refl j))
    (check S.v5 S.v5 (refl i) (refl j) (refl k)) ;
  group-path : Id ChapterFour[l].ConcreteGroup P.group BG.Permutations[X3,FiniteCycles[l].fin-set n3].G.group =
    BG.Compare[P.bicycle,S.v0,P.send,P.sends,X3,FiniteCycles[l].fin-set n3,labels,
      S.cases (\ x -> (y : S.X) -> law x y) row0 row1 row2 row3 row4 row5].id ;
} ;
same-group : Id ChapterFour[l].ConcreteGroup H.group P.group = Paths[l+].transH Hex.group-path (Paths[l+].symH Prism.group-path) ;
module Apart {
  square : (v : S.X) -> Id S.X (H.a (H.a v)) v = H.a-right ;
  fixed (e : B.Maps[H.bicycle,P.bicycle].iso) (v : S.X) : Id S.X (P.a (P.a (e.1.1 v))) (e.1.1 v) =
    transH (symH (apH P.a (e.2.1 v))) (transH (symH (e.2.1 (H.a v))) (apH e.1.1 (square v))) ;
  impossible (e : B.Maps[H.bicycle,P.bicycle].iso) : Empty = Cardinality[l].Option[FinChoice[l].Fin (suc (suc (suc (suc (suc zero)))))].apart none
    (apH S.index (transH (symH (apH (\ z -> P.a (P.a z)) (e.1.2.sec-eq S.v0))) (transH (fixed e (e.1.2.sec S.v0)) (e.1.2.sec-eq S.v0)))) ;
  distinct-components : Truncation[l+].Trunc[Id B.Bicycle H.bicycle P.bicycle].carrier -> Empty =
    TruncationCombinators[l+].rec (Id B.Bicycle H.bicycle P.bicycle) @l Empty isProp-Empty
      (\ p -> impossible ((B.Identity[H.bicycle].equivalence P.bicycle).1 p)) ;
} ;
module Nonabelian {
  module Q = BG.Permutations[X,FiniteCycles[l].fin-set n] ; A : Group[l].Grp = Q.S.abstract ;
  a : A.G = Q.decode.2.sec jik ; b : A.G = Q.decode.2.sec ikj ;
  action (e : Equiv X X) (v : X) : Id X ((Q.decode.1 (Q.decode.2.sec e)).1 v) (e.1 v) =
    apH (\ f -> f.1 v) (Q.decode.2.sec-eq e) ;
  composite (e f : Equiv X X) (v : X) : Id X ((Q.decode.1 (A.mul (Q.decode.2.sec e) (Q.decode.2.sec f))).1 v) (e.1 (f.1 v)) =
    transH (Q.mul (Q.decode.2.sec e) (Q.decode.2.sec f) v)
      (transH (action e ((Q.decode.1 (Q.decode.2.sec f)).1 v)) (apH e.1 (action f v))) ;
  witness (p : Id A.G (A.mul a b) (A.mul b a)) : Empty = separate j k (transH (symH (composite jik ikj i))
    (transH (apH (\ g -> (Q.decode.1 g).1 i) p) (composite ikj jik i))) ;
} ;

-- Remark 4.4.14. The same identity function on BΣ₃ with two pointings.
module Pointings {
  module W = Nonabelian ; module G = W.Q.G ; A : Group[l].Grp = W.A ;
  module D = ChapterSeven[l].Homomorphisms[G.group,G.group].D ; module L = LoopConj[l] ;
  maps : U l = ChapterFour[l].Hom G.group G.group ;
  change (p : A.G) : maps = (\ x -> x,p) ;
  value (p q : A.G) : Id A.G ((D.loop (change p)).1 q) (L.conj G.group.space G.pt G.pt p q) =
    transH (D.loop-ap (change p) q) (apH (L.conj G.group.space G.pt G.pt p) (Fibres[l].ap-id G.group.space G.pt G.pt q)) ;
  different-pointings (p : Id maps (change A.e) (change W.a)) : Empty = W.witness
    (transH (symH (Group[l].GrpL[A].cancr W.a (A.mul W.a W.b)))
      (apH (\ t -> A.mul t W.a) (transH (symH (value W.a W.b))
        (transH (symH (apH (\ h -> (D.loop h).1 W.b) p)) (transH (value A.e W.b) (L.conj-refl-loop G.group.space G.pt W.b)))))) ;
} ;
