-- Sections 3.6 and 3.8. The small component of a permutation, and the
-- symmetry type of the standard n-cycle. The component uses replacement.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = Prelude[l+] ; module BP = Paths[l+] ; module S = CircleBundles[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module R = Replacement[l,l+] ;
Perm : U l+ = (X : S.Set) * S.Aut X ;
module From (u : Perm) {
  X : U l = u.1.1 ;
  perm : Equiv X X = u.2 ;
  Comm (Y : U l) (e : Equiv X Y) (b : Equiv Y Y) : U l = (x : X) -> Id Y (e.1 (perm.1 x)) (b.1 (e.1 x)) ;
  Iso (v : Perm) : U l = (e : Equiv X v.1.1) * Comm v.1.1 e v.2 ;
  total : U l+ = (v : Perm) * Iso v ;
  item (Y : U l) (e : Equiv X Y) (s : isSet Y) (b : Equiv Y Y) (h : Comm Y e b) : total = (((Y,s),b),e,h) ;
  id : Iso u = (idEquiv X,\ x -> refl (perm.1 x)) ;
  center : total = (u,id) ;
  law-prop (Y : U l) (s : isSet Y) (e : Equiv X Y) (b : Equiv Y Y) : isProp (Comm Y e b) =
    FL.isProp-Pi X (\ x -> Id Y (e.1 (perm.1 x)) (b.1 (e.1 x))) (\ x -> s _ _) ;
  same (h : Comm X (idEquiv X) perm) : Id total center (item X (idEquiv X) u.1.2 perm h) =
    B.ap (Comm X (idEquiv X) perm) total (item X (idEquiv X) u.1.2 perm) _ _ (law-prop X u.1.2 (idEquiv X) perm id.2 h) ;
  equals (b : Equiv X X) (h : Comm X (idEquiv X) b) : Id (Equiv X X) perm b = ChapterTwo[l].equiv-ext X X perm b h ;
  move (b : Equiv X X) (p : Id (Equiv X X) perm b) : (h : Comm X (idEquiv X) b) -> Id total center (item X (idEquiv X) u.1.2 b h) =
    idJ (Equiv X X) perm (\ d q -> (h : Comm X (idEquiv X) d) -> Id total center (item X (idEquiv X) u.1.2 d h)) same b p ;
  motive (Y : U l) (e : Equiv X Y) : U l+ =
    (s : isSet Y) (b : Equiv Y Y) (h : Comm Y e b) -> Id total center (item Y e s b h) ;
  base : motive X (idEquiv X) = \ s b h -> BP.transH (move b (equals b h) h)
    (B.ap (isSet X) total (\ t -> item X (idEquiv X) t b h) _ _ (Torsor[l].isProp-isSet X u.1.2 s)) ;
  contract (v : total) : Id total center v =
    Axioms[l].UnivalenceLemmas[univ @l].eqind X motive base v.1.1.1 v.2.1 v.1.1.2 v.1.2 v.2.2 ;
  module IdSystem = FundThm[l+].FT[Perm,u,\ v -> Iso v,id,(center,contract)] ;
  small (v : Perm) : R.Small (Id Perm u v) =
    (Iso v,(IdSystem.un v,B.qinv _ _ (IdSystem.un v) (IdSystem.tr v) (IdSystem.un-tr v) (IdSystem.tr-un v))) ;
  set (v : Perm) : isSet (Iso v) = isSet-Sigma (Equiv X v.1.1) (\ e -> Comm v.1.1 e v.2)
    (S.equivalences-are-set u.1 v.1)
    (\ e -> prop-to-set _ (law-prop v.1.1 v.1.2 e v.2)) ;
} ;
local : R.LocallySmall Perm = \ u v -> From[u].small v ;
module Component (u : Perm) {
  module C = ChapterTwo[l].Component[Perm,local,u] ;
  space : U l = C.carrier ;
  pt : space = C.point ;
  show : space -> Perm = C.image.inclusion ;
  module At (x y : space) {
    module F = From[show x] ;
    codes : Equiv (Id space x y) (F.Iso (show y)) = Truncations[l].lower _ _ (Equivalences[l+].compose
      (Id space x y) (Id Perm (show x) (show y)) (F.Iso (show y)) (B.ap space Perm show x y,C.image.embedding x y)
      (F.IdSystem.tr (show y),F.IdSystem.equiv (show y))) ;
    set : isSet (Id space x y) = HLevels[l].trunc-set _ (HLevels[l].equiv-trunc ChapterFour[l].two _ _ codes
      (HLevels[l].set-trunc _ (F.set (show y)))) ;
  } ;
  module T = Truncation[l] ;
  reaches (x : space) : T.Trunc[Id space pt x].carrier = C.C.path-from-point x ;
  group : ChapterFour[l].ConcreteGroup = new ChapterFour[l].ConcreteGroup[space,pt,
    ChapterFour[l].Reachable[space,pt,reaches].connected,\ x y -> HLevels[l].set-trunc _ At[x,y].set] ;
  loops : Equiv (Id space pt pt) (From[u].Iso u) =
    B.subst Perm (\ v -> Equiv (Id space pt pt) (From[v].Iso v)) (show pt) u C.path-at-point At[pt,pt].codes ;
} ;
module Finite (n : Nat) {
  module F = FiniteCycles[l] ;
  standard : Perm = ((FinChoice[l].Fin (suc n),F.fin-set (suc n)),F.rotation n) ;
  module Cyc = Component[standard] ;
  symmetries : Equiv (Id Cyc.space Cyc.pt Cyc.pt) (FinChoice[l].Fin (suc n)) =
    Equivalences[l].compose _ _ _ Cyc.loops F.Centralizer[n].symmetries ;
} ;
