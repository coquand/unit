-- Section 6.7. Rezk completion of the path pregroupoid computes 1-truncation.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = Prelude[l+] ; module BP = Paths[l+] ; module K = Category[l,l] ; module S = CategorySIP[l,l] ;
module G = GroupoidIdentity[l] ; module F = FlaggedCategories[l] ; module H = HLevels[l] ;
module CM = ConnectedMaps[l] ; module BL = Axioms[l+].FunExtLemmas[fe @l+] ;
two : Nat = suc (suc zero) ;
module On (A : U l) {
  module T = ChapterTwo[l].Truncate[two,A] ;
  grp : G.types = (T.carrier,\ x y -> H.trunc-set _ (T.op.trunc A x y)) ;
  marked : F.flags = (G.Path[grp].cat,A,T.unit,\ t -> (T.op.conn A t).1) ;
  path-pre : K.Precategory = F.pre marked ;
  module Pair (x y : A) {
    X : U l = Id A x y ; Y : U l = path-pre.hom x y ;
    module ST = ChapterTwo[l].Truncate[suc zero,X] ;
    a : X -> Y = ap A T.carrier T.unit x y ;
    module Extend (Z : U l) (s : H.isTrunc two Z) {
      module ByUnit = ST.Into[\ t -> Z,\ t -> s].E ;
      module ByAp = CM.Elim[two,X,Y,a,CM.fib-ap-conn two A T.carrier T.unit (T.op.conn A) x y,\ t -> Z,\ t -> s] ;
    } ;
    module P = Extend[Y,T.op.trunc A (T.unit x) (T.unit y)] ;
    module Q = Extend[ST.carrier,ST.op.trunc X] ;
    decode : ST.carrier -> Y = P.ByUnit.ext a ;
    encode : Y -> ST.carrier = Q.ByAp.ext ST.unit ;
    computes (p : X) : Id Y (decode (ST.unit p)) (a p) = P.ByUnit.ext-beta a p ;
    sec : Id (Y -> Y) (\ p -> decode (encode p)) (\ p -> p) = P.ByAp.unique _ _
      (\ p -> transH (apH decode (Q.ByAp.ext-beta ST.unit p)) (computes p)) ;
    ret : Id (ST.carrier -> ST.carrier) (\ p -> encode (decode p)) (\ p -> p) = Q.ByUnit.unique _ _
      (\ p -> transH (apH encode (computes p)) (Q.ByAp.ext-beta ST.unit p)) ;
    equiv : Equiv Y ST.carrier = (encode,qinv _ _ encode decode (happly _ (\ t -> ST.carrier) _ _ ret) (happly Y (\ t -> Y) _ _ sec)) ;
  } ;
  hom (x y : A) : U l = Pair[x,y].ST.carrier ;
  family : U l+ = A -> A -> U l ;
  hom-path : Id family path-pre.hom hom = BL.funext A (\ x -> A -> U l) _ _ (\ x -> BL.funext A (\ y -> U l) _ _
    (\ y -> Axioms[l].UnivalenceLemmas[univ @l].ua _ _ Pair[x,y].equiv)) ;
  ops : S.Operations[A,path-pre.hom] = (S.structure-raw A (S.from-pre path-pre)).2 ;
  build (m : family) (v : S.Operations[A,m]) : K.Precategory = S.to-pre A (S.structure-from A (m,v)) ;
  lift (m : family) (p : Id family path-pre.hom m) :
    Id K.Precategory path-pre (build m (B.subst family (\ n -> S.Operations[A,n]) path-pre.hom m p ops)) =
    idJ family path-pre.hom (\ n q -> Id K.Precategory path-pre (build n (B.subst family (\ k -> S.Operations[A,k]) path-pre.hom n q ops)))
      (refl path-pre) m p ;
  -- Transport the path operations. The arrow type of this presentation is literally the set truncation.
  pre : K.Precategory = build hom (B.subst family (\ n -> S.Operations[A,n]) path-pre.hom hom hom-path ops) ;
  completion (C : K.Precategory) : U l = RezkCompletion[l,l,l,l].On[C].completion.pre.ob ;
  comparison : Id (U l) (completion pre) T.carrier = BP.transH
    (BP.apH completion (BP.symH (lift hom hom-path))) (BP.apH (\ w -> w.1.pre.ob) (F.Recover[marked].path)) ;
  equivalence : Equiv (completion pre) T.carrier = Axioms[l].idtoeqv _ _ comparison ;
} ;
