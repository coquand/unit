level l ; open Base ;
module Wd = Wedges[l,l] ;
-- Sections 8.6 and 8.7. Reflection gives the ordinary groups from the full
-- homotopy constructions. Their universal properties follow by precomposition.
module SumGroup (G H : ChapterFour[l].ConcreteGroup) {
  module W = Wd.Wedge[G.space,G.point,H.space,H.point] ;
  module CG = ChapterFour[l] ;
  module T = Truncation[l] ;
  reach (z : W.space) : U l = T.Trunc[Id W.space W.base z].carrier ;
  left-path (x : G.space) : reach (W.W.in-left x) = TruncationCombinators[l].map
    (Id G.space G.point x) (Id W.space W.base (W.W.in-left x))
    (Prelude[l].ap G.space W.space W.W.in-left G.point x) ((G.connected.2 G.point x).1) ;
  right-path (x : H.space) : reach (W.W.in-right x) = TruncationCombinators[l].map
    (Id H.space H.point x) (Id W.space W.base (W.W.in-right x))
    (\ p -> Paths[l].transH W.join (Prelude[l].ap H.space W.space W.W.in-right H.point x p))
    ((H.connected.2 H.point x).1) ;
  generators : (v : Wd.Sum G.space H.space) -> reach (W.W.Q.point v) =
    split { left x -> left-path x ; right x -> right-path x } ;
  module P = CoequalizerConnected[l].Points[Top,Wd.Sum G.space H.space,W.W.src,W.W.tgt] ;
  module C = P.Elim[reach,\ z -> T.Trunc[Id W.space W.base z].proposition,generators] ;
  module T1 = PointedTruncation[l].Reflect[W.space,W.base,CG.Reachable[W.space,W.base,C.section].connected] ;
  group : CG.ConcreteGroup = T1.group ;
  module Into (J : CG.ConcreteGroup) {
    module Maps = Wedges[l,l].Wedge[G.space,G.point,H.space,H.point].Maps[J.space,J.point] ;
    universal : Prelude[l].Equiv (CG.Hom group J) (CG.Hom G J * CG.Hom H J) = Equivalences[l].compose
      (CG.Hom group J) (Lemma4[l].PtMap W.space W.base J.space J.point) (CG.Hom G J * CG.Hom H J)
      T1.Maps[J].pointed Maps.universal ;
  } ;
} ;

module Free (S : U l) {
  module B = Wd.Bouquet[S] ;
  module CG = ChapterFour[l] ;
  module T = Truncation[l] ;
  reach (z : B.Q.space) : U l = T.Trunc[Id B.Q.space B.base z].carrier ;
  generators : (t : Top) -> reach (B.Q.point t) = split { tt -> T.Trunc[Id B.Q.space B.base B.base].inc (refl B.base) } ;
  module P = CoequalizerConnected[l].Points[S,Top,B.endpt,B.endpt] ;
  module C = P.Elim[reach,\ z -> T.Trunc[Id B.Q.space B.base z].proposition,generators] ;
  module T1 = PointedTruncation[l].Reflect[B.Q.space,B.base,CG.Reachable[B.Q.space,B.base,C.section].connected] ;
  group : CG.ConcreteGroup = T1.group ;
  module Into (G : CG.ConcreteGroup) {
    universal : Prelude[l].Equiv (CG.Hom group G) (S -> Id G.space G.point G.point) =
      Equivalences[l].compose (CG.Hom group G) (Lemma4[l].PtMap B.Q.space B.base G.space G.point)
        (S -> Id G.space G.point G.point) T1.Maps[G].pointed B.Universal[G.space,G.point].pointed-universal ;
  } ;
} ;
