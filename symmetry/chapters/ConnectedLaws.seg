-- Sections 2.16-2.17. Connected components, dependent sums and surjective maps.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module FU = FunExtUA[l] ;
conn (X : U l) : U l = Connected[l].isConn (suc (suc zero)) X ;
module Mere (X : U l) {
  module Tr = T.Trunc[X] ;
  fibre (z : Tr.carrier) : U l = (x : X) * Id Tr.carrier (Tr.inc x) z ;
  onto : (z : Tr.carrier) -> T.Trunc[fibre z].carrier = Tr.induction @l (\ z -> T.Trunc[fibre z].carrier)
    (\ z -> T.Trunc[fibre z].proposition) (\ x -> T.Trunc[fibre (Tr.inc x)].inc (x,refl (Tr.inc x))) ;
  fixed (p : isProp X) : Equiv X Tr.carrier = Bijection[l].prop-equiv _ _ p Tr.proposition Tr.inc (TC.rec X @l X p (\ x -> x)) ;
} ;
module Component (X : U l) (x : X) {
  reach (y : X) : U l = T.Trunc[Id X x y].carrier ;
  module S = ChapterTwo[l].Subtype[X,reach,\ y -> T.Trunc[Id X x y].proposition] ;
  base : S.total = (x,T.Trunc[Id X x x].inc (refl x)) ;
  joined (u v : S.total) : T.Trunc[Id S.total u v].carrier = TC.map2 (Id X x u.1) (Id X x v.1) (Id S.total u v)
    (\ p q -> (S.At[u].paths v).2.sec (transH (symH p) q)) u.2 v.2 ;
  connected : conn S.total = (T.Trunc[S.total].inc base,\ u v -> (joined u v,\ p q -> tt)) ;
  preserve (P : X -> U l) (p : (y : X) -> isProp (P y)) (y : X) (h : reach y) (v : P x) : P y =
    TC.rec (Id X x y) @l (P y) (p y) (\ e -> subst X P x y e v) h ;
} ;
module Loops (X : U l) (h : (x : X) -> isProp (Id X x x)) {
  trivial (x y : X) (p : Id X x y) : (q : Id X x y) -> Id (Id X x y) p q =
    idJ X x (\ z r -> (s : Id X x z) -> Id (Id X x z) r s) (h x (refl x)) y p ;
  contract (c : conn X) : FU.isContr X = TC.rec X @l _ (Torsor[l].isProp-isContr X)
    (\ x -> (x,\ y -> TC.rec (Id X x y) @l _ (trivial x y) (\ p -> p) ((c.2 x y).1))) c.1 ;
} ;
module Surjection (X Y : U l) (f : X -> Y) {
  fibre (y : Y) : U l = (x : X) * Id Y (f x) y ;
  onto : U l = (y : Y) -> T.Trunc[fibre y].carrier ;
  module With (s : onto) {
    joined (c : conn X) (a b : Y) : T.Trunc[Id Y a b].carrier = TC.bind2 (fibre a) (fibre b) (Id Y a b)
      (\ u v -> TC.map (Id X u.1 v.1) (Id Y a b) (\ p -> transH (symH u.2) (transH (apH f p) v.2)) ((c.2 u.1 v.1).1)) (s a) (s b) ;
    connected (c : conn X) : conn Y = (TC.map X Y f c.1,\ a b -> (joined c a b,\ p q -> tt)) ;
    equivalence (h : (y : Y) -> isProp (fibre y)) : isEquiv X Y f = Whitehead[l].contr-equiv X Y f
      (\ y -> ((Mere[fibre y].fixed (h y)).2.sec (s y),h y _)) ;
    descend (P : Y -> U l) (p : (y : Y) -> isProp (P y)) (g : (x : X) -> P (f x)) (y : Y) : P y =
      TC.rec (fibre y) @l (P y) (p y) (\ w -> subst Y P (f w.1) y w.2 (g w.1)) (s y) ;
  } ;
  reaches (h : T.Trunc[X].carrier) (c : conn Y) (y : Y) : T.Trunc[fibre y].carrier =
    TC.bind X (fibre y) (\ x -> TC.map (Id Y (f x) y) (fibre y) (\ p -> (x,p)) ((c.2 (f x) y).1)) h ;
} ;
module Total (A : U l) (B : A -> U l) {
  X : U l = (a : A) * B a ;
  module With (c : conn A) (d : (a : A) -> conn (B a)) {
    joined (u v : X) : T.Trunc[Id X u v].carrier = TC.bind (Id A u.1 v.1) (Id X u v) (\ p ->
      TC.map (Id (B v.1) (subst A B u.1 v.1 p u.2) v.2) (Id X u v) (Sigma-path A B u.1 v.1 u.2 v.2 p)
        (((d v.1).2 (subst A B u.1 v.1 p u.2) v.2).1)) ((c.2 u.1 v.1).1) ;
    connected : conn X = (TC.bind A X (\ a -> TC.map (B a) X (\ b -> (a,b)) (d a).1) c.1,
      \ u v -> (joined u v,\ p q -> tt)) ;
  } ;
  P (a : A) : U l = T.Trunc[B a].carrier ;
  module S = ChapterTwo[l].Subtype[A,P,\ a -> T.Trunc[B a].proposition] ;
  map (u : X) : S.total = (u.1,T.Trunc[B u.1].inc u.2) ;
  module F = Surjection[X,S.total,map] ;
  onto (v : S.total) : T.Trunc[F.fibre v].carrier = TC.map (B v.1) (F.fibre v)
    (\ b -> ((v.1,b),(S.At[map (v.1,b)].paths v).2.sec (refl v.1))) v.2 ;
  connected-image : conn X -> conn S.total = F.With[onto].connected ;
} ;
