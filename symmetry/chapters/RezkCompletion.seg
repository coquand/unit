-- Section 6.7. Take the small full image of the Yoneda embedding.
level o h m n ; open Base ; open Paths[o \/ h+] ;
module K = Category[o,h] ; module Small = Category[o \/ h,o \/ h] ;
module F = Functor[o,h,o \/ h,o \/ h] ;
module On (C : K.Precategory) {
  module Y = Presheaves[o,h].On[C] ;
  module R = CompletionUP[o \/ h+,o \/ h,m,n,o \/ h \/ m \/ n].Instance[Y.category,C.ob,Y.rep] ;
  completion : Small.Category = R.SFI.category ;
  map (a b : C.ob) (f : C.hom a b) : completion.pre.hom (R.q.obj a) (R.q.obj b) =
    R.q.map a b (Y.action a b f) ;
  unit : F.Functor[C,completion.pre] = new F.Functor[C,completion.pre,R.q.obj,map,
    \ a -> transH (apH (R.q.map a a) (Y.embedding.map-idn a)) (R.q.map-idn a),
    \ a b c g f -> transH (apH (R.q.map a c) (Y.embedding.map-comp a b c g f))
      (R.q.map-comp a b c (Y.action b c g) (Y.action a b f))] ;
  fully-faithful : F.FullyFaithful C completion.pre unit = \ a b ->
    EquivalenceLemmas[o \/ h].compose _ _ _ (R.q.map a b) (Y.action a b) (R.fully-faithful a b) (Y.fully-faithful a b) ;
  essentially-surjective : F.EssSurj C completion.pre unit = R.ess-surj ;
  -- The precomposition theorem uses a common ambient bound for its two sources.
  source : Small.Precategory = new Small.Precategory[C.ob,\ x y -> C.hom x y,C.hom-set,C.idn,C.comp,C.unit-l,C.unit-r,C.assoc] ;
  module SF = Functor[o \/ h,o \/ h,o \/ h,o \/ h] ;
  inclusion : SF.Functor[source,completion.pre] =
    new SF.Functor[source,completion.pre,unit.obj,unit.map,unit.map-idn,unit.map-comp] ;
  module Into (D : Category[m,n].Category) {
    module T = UniversalProperty[o \/ h,o \/ h,m,n,o \/ h \/ m \/ n].Theorem[source,completion.pre,D,inclusion,fully-faithful,essentially-surjective] ;
    module FC = FunctorUnivalence[o \/ h,o \/ h,m,n,o \/ h \/ m \/ n] ;
    module H = Functor[o \/ h,o \/ h,m,n] ;
    restriction : Prelude[o \/ h \/ m \/ n].Equiv (H.Functor[completion.pre,D.pre]) (H.Functor[source,D.pre]) =
      (T.Q.functor,EquivObjects[o \/ h \/ m \/ n,o \/ h \/ m \/ n,o \/ h \/ m \/ n,o \/ h \/ m \/ n,o \/ h \/ m \/ n].Corollary[
        FC.Univalence[completion.pre,D].category,FC.Univalence[source,D].category,T.Q.star,T.fully-faithful,T.split-ess-surj].equiv) ;
  } ;
} ;
-- The large presentation consists of the merely representable presheaves.
module Presentation (C : K.Precategory) {
  module R = On[C] ; module Y = R.Y ; module I = R.R.SFI ; module B = Prelude[o \/ h+] ;
  large : U (o \/ h+) = (F : Y.presheaf) * I.Generated F ;
  include (x : R.completion.pre.ob) : large = (I.image.inclusion x,I.generated x) ;
  locate (w : large) : R.completion.pre.ob = (I.to-fibre w.1 w.2).1 ;
  property (F : Y.presheaf) : B.isProp (I.Generated F) =
    Truncation[o \/ h].Trunc[(x : C.ob) * Y.pre.Iso (Y.rep x) F].proposition ;
  section (w : large) : Id large (include (locate w)) w = B.Sigma-eq Y.presheaf (\ F -> I.Generated F) _ _ _ _
    (I.to-fibre w.1 w.2).2 (property w.1) ;
  retract (x : R.completion.pre.ob) : Id R.completion.pre.ob (locate (include x)) x =
    B.ap (I.Fibre (I.image.inclusion x)) R.completion.pre.ob (\ t -> t.1) _ _
      (I.fibre-prop (I.image.inclusion x) (I.to-fibre (I.image.inclusion x) (I.generated x)) (x,refl (I.image.inclusion x))) ;
  small : B.Equiv R.completion.pre.ob large = (include,B.qinv _ _ include locate section retract) ;
} ;
