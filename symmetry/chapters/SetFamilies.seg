-- Section 6.2. This presentation of G-sets works over any base, including BG.
level l ; open Base ; open Prelude[l] ; open Paths[l+] ;
module B = Prelude[l+] ; module F = FamilyAdjunctions[l] ;
module S = CategoryOfSets[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ; module BL = Axioms[l+].FunExtLemmas[fe @l+] ;
module Over (A : U l) {
  module D = F.Families[A] ;
  sets (X : D.family) : U l = (a : A) -> isSet (X a) ;
  prop (X : D.family) : isProp (sets X) = FL.isProp-Pi A (\ a -> isSet (X a)) (\ a -> S.set-prop (X a)) ;
  module Sub = FullSubcategory[l+,l,l].On[D.category,sets,prop] ;
  module Struct = WildIsos[l+,l].HomSets[Sub.sub,\ X Y -> FL.isSet-Pi A (\ a -> X.1 a -> Y.1 a)
    (\ a -> FL.isSet-Pi (X.1 a) (\ x -> Y.1 a) (\ x -> Y.2 a))] ;
  category : Category[l+,l].Category = Struct.category (Sub.univalent (F.families-univalent A)) ;
  -- Usual family notation, as used in Chapter 5.
  family : U l+ = A -> S.ob ;
  collect (V : family) : Sub.ob = ((\ a -> (V a).1),\ a -> (V a).2) ;
  distribute (U0 : Sub.ob) : family = \ a -> (U0.1 a,U0.2 a) ;
  object-equivalence : B.Equiv family Sub.ob = (collect,B.qinv _ _ collect distribute (\ t -> refl t) (\ V -> refl V)) ;
  module K = Category[l+,l] ;
  pre : K.Precategory = new K.Precategory[family,\ V W -> category.pre.hom (collect V) (collect W),
    \ V W -> category.pre.hom-set (collect V) (collect W),\ V -> category.pre.idn (collect V),
    \ U0 V W -> category.pre.comp (collect U0) (collect V) (collect W),
    \ V W -> category.pre.unit-l (collect V) (collect W),\ V W -> category.pre.unit-r (collect V) (collect W),
    \ T U0 V W -> category.pre.assoc (collect T) (collect U0) (collect V) (collect W)] ;
  module At (V : family) {
    center : K.Singletons[pre].Singl V = (V,pre.iso-id V) ;
    convert (t : K.Singletons[category.pre].Singl (collect V)) : K.Singletons[pre].Singl V = (distribute t.1,t.2) ;
    path (w : K.Singletons[pre].Singl V) : Id (K.Singletons[pre].Singl V) center w = apH convert
      (K.Objects[category].singl-prop (collect V) (collect V,category.pre.iso-id (collect V)) (collect w.1,w.2)) ;
  } ;
  families : K.Category = new K.Category[pre,K.FromTotal[pre,\ V u v -> transH (symH (At[V].path u)) (At[V].path v)].univalent] ;
} ;
