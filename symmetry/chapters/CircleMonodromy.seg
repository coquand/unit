-- The source circle and the sets in a bundle may live at unrelated levels.
level u v ; open Base ; open Prelude[u \/ v+] ;
module S = CircleBundles[v] ;
module C = ChapterThree[u] ;
module L = CircleLarge[u,u \/ v+].Mapping[S.Set] ;
loops (a : S.Set) : Equiv (Id S.Set a a) (S.Aut a) =
  UniverseChange[u,v+].raise-equiv (Id S.Set a a) (S.Aut a) (S.loops a) ;
monodromy : Equiv (C.Circle -> S.Set) ((a : S.Set) * S.Aut a) = Equivalences[u \/ v+].compose
  (C.Circle -> S.Set) ((a : S.Set) * Id S.Set a a) ((a : S.Set) * S.Aut a)
  (L.E,L.E-equiv) (Fibres[u \/ v+].sigma-equiv S.Set (\ a -> Id S.Set a a) (\ a -> S.Aut a) loops) ;
