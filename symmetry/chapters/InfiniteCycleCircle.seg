-- The component of the integer successor is the chosen circle, with
-- predecessor as the image of the circle generator (book convention).
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Paths[l+] ; module Z = Integers[l] ; module V = InfiniteCycle[l] ;
module P = PermutationLoops[l].At[V.standard] ; module C = V.Component ;
module S = ChapterThree[l] ; module CG = ChapterFour[l] ; module G = Groupoid[l] ;
module M = ChapterSeven[l].OrdinaryMaps[CG.integer-group,C.group] ;
module E = Equivalences[l] ; module inv = Bijection[l] ;
label : Equiv P.J.carrier Z.Int = E.compose _ _ _ P.encode V.at-standard ;
value (p : P.P) : Z.Int = V.evaluate V.standard (P.I.tr V.standard p) ;
preserves (p q : P.J.carrier) : Id Z.Int (label.1 (P.J.abstract.mul p q)) (Z.add (label.1 p) (label.1 q)) =
  transH (Big.apH value (P.based-mul p q)) (transH (P.comp V.standard V.standard (P.based.1 q) V.standard (P.based.1 p) Z.zeroZ)
    (symH (V.Determine[P.encode.1 p].at (label.1 q)))) ;
inv-label : Equiv Z.Int P.J.carrier = inv.inverse _ _ label ;
reverse (p : M.M.A.carrier) : M.M.A.carrier = symH p ;
reverse-equiv : Equiv M.M.A.carrier M.M.A.carrier = (reverse,qinv _ _ reverse reverse
  (G.sym-sym S.Circle S.base S.base) (G.sym-sym S.Circle S.base S.base)) ;
winding : Equiv M.M.A.carrier Z.Int = E.compose _ _ _ reverse-equiv S.winding ;
additive (p q : M.M.A.carrier) : Id Z.Int (winding.1 (M.M.A.abstract.mul p q)) (Z.add (winding.1 p) (winding.1 q)) =
  transH (apH S.winding.1 (G.sym-trans S.Circle S.base S.base S.base q p)) (S.K.band-hom S.base (reverse p) (reverse q)) ;
iso : Equiv M.M.A.carrier P.J.carrier = E.compose _ _ _ winding inv-label ;
iso-label (p : M.M.A.carrier) : Id Z.Int (label.1 (iso.1 p)) (winding.1 p) = label.2.sec-eq (winding.1 p) ;
law (p q : M.M.A.carrier) : Id P.J.carrier (iso.1 (M.M.A.abstract.mul p q)) (P.J.abstract.mul (iso.1 p) (iso.1 q)) =
  E.injective _ _ label.1 label.2 _ _ (transH (iso-label (M.M.A.abstract.mul p q)) (transH (additive p q)
    (transH (apH (\ z -> Z.add z (winding.1 q)) (symH (iso-label p)))
      (transH (apH (Z.add (label.1 (iso.1 p))) (symH (iso-label q))) (symH (preserves (iso.1 p) (iso.1 q))))))) ;
hom : M.ordinary = (iso.1,law) ;
map : CG.Hom CG.integer-group C.group = M.comparison.2.sec hom ;
on-loops : Id (M.M.A.carrier -> P.J.carrier) (M.M.D.loop map).1 iso.1 =
  ap M.ordinary (M.M.A.carrier -> P.J.carrier) (\ h -> h.1) _ _ (M.comparison.2.sec-eq hom) ;
loop-equiv : isEquiv M.M.A.carrier P.J.carrier (M.M.D.loop map).1 =
  subst (M.M.A.carrier -> P.J.carrier) (isEquiv M.M.A.carrier P.J.carrier) _ _ (symH on-loops) iso.2 ;
equivalence : Lemma4[l].PtEquiv S.Circle S.base C.space C.pt =
  (map,Whitehead[l].Pointed[S.Circle,S.base,C.space,C.pt,map,S.K.conn1,loop-equiv].equiv C.group.connected) ;
one : Z.Int = pos (suc zero) ;
generator : Id Z.Int (S.winding.1 S.loop) one =
  transH (CircleProperty[l].Circle[S.Circle].band-g (refl S.base)) (apH Z.sucZ (S.K.band-unit S.base)) ;
inverse-generator : Id Z.Int (winding.1 S.loop) (negsuc zero) =
  transH (symH (Z.pred-suc (winding.1 S.loop))) (apH Z.predZ
    (transH (apH (Z.add (winding.1 S.loop)) (symH generator))
      (transH (symH (S.K.band-hom S.base (reverse S.loop) S.loop))
        (transH (apH S.winding.1 (trans-sym-l S.Circle S.base S.base S.loop)) (S.K.band-unit S.base))))) ;
loop-label : Id Z.Int (label.1 ((M.M.D.loop map).1 S.loop)) (negsuc zero) =
  transH (apH (\ f -> label.1 (f S.loop)) on-loops) (transH (iso-label S.loop) inverse-generator) ;
on-generator (x : Z.Int) : Id Z.Int ((P.encode.1 ((M.M.D.loop map).1 S.loop)).1.1 x) (Z.predZ x) =
  transH (symH (V.Determine[P.encode.1 ((M.M.D.loop map).1 S.loop)].at x))
    (transH (apH (\ z -> Z.add z x) loop-label)
      (transH (Z.add-predL Z.zeroZ x) (apH Z.predZ (Z.zero-l x)))) ;
