-- Section 6.7. Paths of univalent categories classify adjoint equivalences.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module K = Category[o,h] ; module V = WildCategory[o,h] ; module J = Functor[o,h,o,h] ; module G = WildFunctors[o,h,o,h] ;
module B = Prelude[o+ \/ h+] ; module BP = Paths[o+ \/ h+] ; module E = CategoricalEquivalences[o,h,o,h] ;
module FL = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
module From (C : K.Category) {
  module I = CategoryIdentity[o,h].UnivalentFrom[C] ;
  module To (D : K.Category) {
    module Criteria = EquivalenceCriteria[o,h].Between[C.pre,D.pre] ;
    fun : U (o \/ h) = Criteria.fun ;
    cat-equiv : U (o \/ h) = Criteria.cat-equiv ;
    module Strict (e : I.iso D) {
      f : fun = new J.Functor[C.pre,D.pre,e.1.1,(\ x y -> (e.2.1 x y).1),e.2.2.1,\ x y z g k -> e.2.2.2 x y z k g] ;
      s : J.SplitEssSurj C.pre D.pre f = \ y -> (e.1.2.sec y,D.pre.idtoiso _ _ (e.1.2.sec-eq y)) ;
      out : cat-equiv = (f,Criteria.At[f].Construct[(\ x y -> (e.2.1 x y).2),s].result) ;
    } ;
    module Back (e : cat-equiv) {
      module Given = Criteria.At[e.1].Given[e.2] ;
      strict : I.iso D = I.Weak[D,e.1,Given.ff,Given.es].strict ;
    } ;
    eta : (f : fun) (e : Criteria.At[f].adj) -> Id cat-equiv Strict[Back[(f,e)].strict].out (f,e) =
      split { Functor obj map i k -> \ e -> Sigma-eq fun (\ f -> Criteria.At[f].adj) _ _ _ _
        (refl (new J.Functor[C.pre,D.pre,obj,map,i,k])) (Criteria.At[new J.Functor[C.pre,D.pre,obj,map,i,k]].prop C.univalent) } ;
  } ;
  total : U (o+ \/ h+) = (D : K.Category) * To[D].cat-equiv ;
  lift (w : I.total) : total = (w.1,To[w.1].Strict[w.2].out) ;
  center : total = lift I.center ;
  identity : To[C].cat-equiv = To[C].Strict[I.I.identity].out ;
  contract (w : total) : Id total center w = BP.transH
    (BP.apH lift (I.contract w.1 To[w.1].Back[w.2].strict))
    (B.ap To[w.1].cat-equiv total (\ e -> (w.1,e)) _ _ (To[w.1].eta w.2.1 w.2.2)) ;
  module FT = FundThm[o+ \/ h+].FT[K.Category,C,(\ D -> To[D].cat-equiv),identity,(center,contract)] ;
  equivalence (D : K.Category) : B.Equiv (Id K.Category C D) To[D].cat-equiv = (FT.tr D,FT.equiv D) ;
} ;
