-- Sections 5.5 and 7.4. Small classifying groupoid of any group by replacement.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ;
module BE = Equivalences[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module R = Replacement[l,l+] ;
module Classify (G : Group[l].Grp) {
  module T = GTorsor[l].GTor[G] ;
  module PathsOf (X : T.Tor) {
    module FT = FundThm[l+].FT[T.Tor,X,\ Y -> T.Hom X Y,T.idhom X,T.contr X] ;
    small (Y : T.Tor) : R.Small (Id T.Tor X Y) =
      (T.Hom X Y,(FT.un Y,Big.qinv _ _ (FT.un Y) (FT.tr Y) (FT.un-tr Y) (FT.tr-un Y))) ;
  } ;
  module C = ChapterTwo[l].Component[T.Tor,\ X Y -> PathsOf[X].small Y,T.triv] ;
  BG : U l = C.carrier ;
  pt : BG = C.point ;
  torsor : BG -> T.Tor = C.image.inclusion ;
  module At (x y : BG) {
    encode : Id BG x y -> Id T.Tor (torsor x) (torsor y) = Big.ap BG T.Tor torsor x y ;
    module I = PathsOf[torsor x].FT ;
    equiv-big : Big.Equiv (Id BG x y) (T.Hom (torsor x) (torsor y)) =
      BE.compose (Id BG x y) (Id T.Tor (torsor x) (torsor y)) (T.Hom (torsor x) (torsor y)) (encode,C.image.embedding x y) (I.tr (torsor y),I.equiv (torsor y)) ;
    equiv : Equiv (Id BG x y) (T.Hom (torsor x) (torsor y)) =
      Truncations[l].lower _ _ equiv-big ;
    X : T.Tor = torsor x ;
    Y : T.Tor = torsor y ;
    hom-set : isSet (T.Hom X Y) = isSet-Sigma (X.1 -> Y.1) (T.EqvH X Y)
      (FL.isSet-Pi X.1 (\ t -> Y.1) (\ t -> Y.2.2.1))
      (\ f -> prop-to-set (T.EqvH X Y f) (T.eqvh-prop X Y f)) ;
    set : isSet (Id BG x y) = HLevels[l].trunc-set _ (HLevels[l].equiv-trunc (suc (suc zero))
      _ _ equiv (HLevels[l].set-trunc _ hom-set)) ;
  } ;
  merePath (x y : BG) : U l = Truncation[l].Trunc[Id BG x y].carrier ;
  reaches (x : BG) : merePath pt x =
    (surjections @l @(l+) @l Top T.Tor (\ X Y -> PathsOf[X].small Y) C.point-map
       (merePath pt) (\ z -> Truncation[l].Trunc[Id BG pt z].proposition)).sec
       (\ t -> Truncation[l].Trunc[Id BG pt (C.image.quotient t)].inc
           (ap Top BG C.image.quotient tt t (isTop tt t))) x ;
  between (x y : BG) : merePath x y = Truncation[l].Trunc[Id BG pt x].induction @l
    (\ w -> merePath x y) (\ w -> Truncation[l].Trunc[Id BG x y].proposition)
    (\ p -> TruncationCombinators[l].map (Id BG pt y) (Id BG x y)
      (\ q -> transH (symH p) q) (reaches y)) (reaches x) ;
  concrete : ChapterFour[l].ConcreteGroup = new ChapterFour[l].ConcreteGroup[BG,pt,
    (Truncation[l].Trunc[BG].inc pt,\ x y -> (between x y,\ p q -> tt)),
    \ x y -> HLevels[l].set-trunc _ At[x,y].set] ;

  -- Every torsor is merely pointed. This gives an inverse to the small presentation.
  fibre (Y : T.Tor) : U l+ = (x : BG) * Id T.Tor (torsor x) Y ;
  fibre-prop (Y : T.Tor) : Big.isProp (fibre Y) =
    Groupoid[l+].emb-fib-prop BG T.Tor torsor C.image.embedding Y ;
  section (Y : T.Tor) : fibre Y = Truncation[l].Trunc[Y.1].induction @(l+)
    (\ w -> fibre Y) (\ w -> fibre-prop Y)
    (\ t -> (pt,Big.trans T.Tor _ _ _ C.path-at-point (T.pt-triv Y t))) Y.2.2.2.2.2.2 ;
  presentation : Big.Equiv BG T.Tor = (torsor,Big.qinv BG T.Tor torsor
    (\ Y -> (section Y).1) (\ Y -> (section Y).2)
    (\ x -> Big.ap (fibre (torsor x)) BG (\ w -> w.1) _ _
       (fibre-prop (torsor x) (section (torsor x)) (x,refl (torsor x))))) ;

  module TrivialSymmetries {
    end : U l = T.Hom T.triv T.triv ;
    evaluate (h : end) : G.G = h.1 G.e ;
    translate (g : G.G) : end = T.pt-hom T.triv g ;
    beta (g : G.G) : Id G.G (evaluate (translate g)) g = G.unitl g ;
    eta (h : end) : Id end (translate (evaluate h)) h =
      Sigma-eq (G.G -> G.G) (T.EqvH T.triv T.triv) _ _ _ _
        (FL.funext G.G (\ x -> G.G) _ _ (\ x ->
          transH (symH (h.2 x G.e)) (apH h.1 (G.unitr x)))) (T.eqvh-prop T.triv T.triv h.1) ;
    values : Equiv end G.G = (evaluate,qinv end G.G evaluate translate beta eta) ;
  } ;
  identify-end (X Y : T.Tor) (p : Id T.Tor X Y) : Equiv (T.Hom X X) (T.Hom Y Y) =
    idJ T.Tor X (\ Z q -> Equiv (T.Hom X X) (T.Hom Z Z)) (idEquiv (T.Hom X X)) Y p ;
  loops : Equiv (Id BG pt pt) G.G = Equivalences[l].compose (Id BG pt pt) (T.Hom T.triv T.triv) G.G
    (Equivalences[l].compose (Id BG pt pt) (T.Hom (torsor pt) (torsor pt)) (T.Hom T.triv T.triv)
      At[pt,pt].equiv (identify-end (torsor pt) T.triv C.path-at-point))
    TrivialSymmetries.values ;
} ;
