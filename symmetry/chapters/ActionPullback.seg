-- Exercise 7.6.4. Evaluation at the base point (Lemma 7.6.1, in
-- ActionComparison) turns restriction f^* of G-sets into restriction
-- along abs(f): the square commutes up to an identification.
level u v ; open Base ; open Prelude[u \/ v+] ;
module P = Prelude[v] ; module CG = ChapterFour[u] ; module AC = ActionComparison[u,v] ;
module S = CircleBundles[v] ; module FL = Axioms[u \/ v+].FunExtLemmas[fe @(u \/ v+)] ;
module PH = Paths[u \/ v+] ;

-- Transport lemmas.
subst-trans (A : U (u \/ v+)) (Y : A -> U (u \/ v+)) (a b : A) (p : Id A a b) (c : A) (q : Id A b c) (x : Y a) :
  Id (Y c) (subst A Y a c (trans A a b c p q) x) (subst A Y b c q (subst A Y a b p x)) =
  idJ A b (\ d r -> Id (Y d) (subst A Y a d (trans A a b d p r) x) (subst A Y b d r (subst A Y a b p x)))
    (refl (subst A Y a b p x)) c q ;
subst-sym (A : U (u \/ v+)) (Y : A -> U (u \/ v+)) (a b : A) (p : Id A a b) (x : Y a) :
  Id (Y a) (subst A Y b a (sym A a b p) (subst A Y a b p x)) x =
  idJ A a (\ d r -> Id (Y a) (subst A Y d a (sym A a d r) (subst A Y a d r x)) x) (refl x) b p ;
subst-ap (A B : U (u \/ v+)) (f : A -> B) (Y : B -> U (u \/ v+)) (a b : A) (p : Id A a b) (x : Y (f a)) :
  Id (Y (f b)) (subst A (\ z -> Y (f z)) a b p x) (subst B Y (f a) (f b) (ap A B f a b p) x) =
  idJ A a (\ d r -> Id (Y (f d)) (subst A (\ z -> Y (f z)) a d r x) (subst B Y (f a) (f d) (ap A B f a d r) x)) (refl x) b p ;
-- subst along a conjugated loop
subst-conj (A : U (u \/ v+)) (Y : A -> U (u \/ v+)) (a b : A) (w : Id A a b) (l : Id A a a) (x : Y a) :
  Id (Y b) (subst A Y b b (trans A b a b (sym A a b w) (trans A a a b l w)) (subst A Y a b w x))
    (subst A Y a b w (subst A Y a a l x)) =
  PH.transH (subst-trans A Y b a (sym A a b w) b (trans A a a b l w) (subst A Y a b w x))
    (PH.transH (ap (Y a) (Y b) (subst A Y a b (trans A a a b l w)) _ _ (subst-sym A Y a b w x))
      (subst-trans A Y a a l b w x)) ;

-- Abstract G-sets with identified underlying sets are identified once the
-- identification of sets intertwines the two actions.
module Transport (G : CG.ConcreteGroup) {
  module C = AC.Classify[G] ;
  carrier : U u = CG.Symmetries[G].carrier ;
  tr (a b : S.Set) (q : Id S.Set a b) (x : a.1) : b.1 = subst S.Set (\ c -> c.1) a b q x ;
  Intertwines (a b : S.Set) (q : Id S.Set a b) (al : C.Fiber[a].actions) (be : C.Fiber[b].actions) : U (u \/ v) =
    (p : carrier) (x : a.1) -> Id b.1 ((be.1 p).1 (tr a b q x)) (tr a b q ((al.1 p).1 x)) ;
  same (a : S.Set) (al be : C.Fiber[a].actions) (h : Intertwines a a (refl a) al be) : Id C.abstract (a,al) (a,be) =
    ap C.Fiber[a].actions C.abstract (\ w -> (a,w)) al be
      (Sigma-eq (carrier -> S.Aut a) (\ g -> C.Fiber[a].Law g) al.1 be.1 al.2 be.2
        (FL.funext carrier (\ p -> S.Aut a) al.1 be.1 (\ p ->
          P.Sigma-eq (a.1 -> a.1) (P.isEquiv a.1 a.1) _ _ _ _
            (Axioms[v].FunExtLemmas[fe @v].funext a.1 (\ x -> a.1) _ _ (\ x -> P.sym a.1 _ _ (h p x)))
            (EquivProp[v].isEquiv-prop a.1 a.1 _)))
        (C.Fiber[a].law-prop be.1)) ;
  path (a : S.Set) (al : C.Fiber[a].actions) (b : S.Set) (q : Id S.Set a b) :
    (be : C.Fiber[b].actions) -> Intertwines a b q al be -> Id C.abstract (a,al) (b,be) =
    idJ S.Set a (\ c r -> (be : C.Fiber[c].actions) -> Intertwines a c r al be -> Id C.abstract (a,al) (c,be))
      (same a al) b q ;
} ;

module Square (G H : CG.ConcreteGroup) (f : CG.Hom G H) {
  module CGr = AC.Classify[G] ; module CH = AC.Classify[H] ;
  module T = Transport[G] ;
  module D = DeloopMaps[u].Maps[G.space,G.point,H.space,H.point] ;
  absf : QGrp[u].GHom CG.Symmetries[G].abstract CG.Symmetries[H].abstract = ChapterSeven[u].OrdinaryMaps[G,H].comparison.1 f ;
  -- f^* on G-sets, and abs(f)^* on abstract G-sets
  restrict (F : CH.sets) : CGr.sets = \ z -> F (f.1 z) ;
  pull (A : CH.abstract) : CGr.abstract = (A.1,\ p -> A.2.1 (absf.1 p),\ p q ->
    PH.transH (ap CH.Small.carrier (S.Aut A.1) A.2.1 _ _ (absf.2 p q)) (A.2.2 (absf.1 p) (absf.1 q))) ;
  module At (F : CH.sets) {
    Y (w : H.space) : U v = (F w).1 ;
    q : Id S.Set (F (f.1 G.point)) (F H.point) = ap H.space S.Set F _ _ f.2 ;
    tr-q (x : Y (f.1 G.point)) : Id (Y H.point) (T.tr _ _ q x) (subst H.space (\ w -> Y w) _ _ f.2 x) =
      PH.symH (subst-ap H.space S.Set F (\ c -> c.1) _ _ f.2 x) ;
    left : CGr.abstract = CGr.equivalence.1 (restrict F) ;
    right : CGr.abstract = pull (CH.equivalence.1 F) ;
    intertwines : T.Intertwines left.1 right.1 q left.2 right.2 = \ p x -> PH.transH
      (CH.Monodromy[F].computes (absf.1 p) (T.tr _ _ q x)) (PH.transH
      (ap (Id H.space H.point H.point) (Y H.point) (\ r -> subst H.space (\ w -> Y w) _ _ r (T.tr _ _ q x)) _ _ (D.loop-ap f p))
      (PH.transH (ap (Y H.point) (Y H.point) (subst H.space (\ w -> Y w) H.point H.point (trans H.space H.point (f.1 G.point) H.point (sym H.space (f.1 G.point) H.point f.2) (trans H.space (f.1 G.point) (f.1 G.point) H.point (ap G.space H.space f.1 G.point G.point p) f.2))) _ _ (tr-q x))
      (PH.transH (subst-conj H.space (\ w -> Y w) _ _ f.2 (ap G.space H.space f.1 _ _ p) x)
      (PH.transH (ap (Y (f.1 G.point)) (Y H.point) (subst H.space (\ w -> Y w) _ _ f.2) _ _
          (PH.transH (PH.symH (subst-ap G.space H.space f.1 (\ w -> Y w) _ _ p x))
            (PH.symH (CGr.Monodromy[restrict F].computes p x))))
        (PH.symH (tr-q ((left.2.1 p).1 x))))))) ;
    square : Id CGr.abstract left right = T.path left.1 left.2 right.1 q right.2 intertwines ;
  } ;
  square (F : CH.sets) : Id CGr.abstract (CGr.equivalence.1 (restrict F)) (pull (CH.equivalence.1 F)) = At[F].square ;
} ;
