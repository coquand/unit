-- Section 7.4. Turn the two recovery theorems into an equivalence of the
-- actual types of groups. Records in Unit have propositional eta.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module Gp = Group[l] ; module Big = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
ops (A : U l) : U l = A * (A -> A -> A) * (A -> A) ;
module On (A : U l) (o : ops A) {
  e : A = o.1 ; m : A -> A -> A = o.2.1 ; i : A -> A = o.2.2 ;
  Assoc : U l = (x y z : A) -> Id A (m (m x y) z) (m x (m y z)) ;
  L : U l = (x : A) -> Id A (m e x) x ;
  R : U l = (x : A) -> Id A (m x e) x ;
  IL : U l = (x : A) -> Id A (m (i x) x) e ;
  IR : U l = (x : A) -> Id A (m x (i x)) e ;
  laws : U l = isSet A * Assoc * L * R * IL * IR ;
  both (P Q : U l) (p : isProp P) (q : isProp Q) : isProp (P * Q) = isProp-Sigma P (\ x -> Q) p (\ x -> q) ;
  module Set (s : isSet A) {
    unary (f g : A -> A) : isProp ((x : A) -> Id A (f x) (g x)) = FL.isProp-Pi A (\ x -> Id A (f x) (g x)) (\ x -> s _ _) ;
    assoc-prop : isProp Assoc = FL.isProp-Pi A (\ x -> (y z : A) -> Id A (m (m x y) z) (m x (m y z)))
      (\ x -> FL.isProp-Pi A (\ y -> (z : A) -> Id A (m (m x y) z) (m x (m y z)))
        (\ y -> unary (m (m x y)) (\ z -> m x (m y z)))) ;
    rest : isProp (Assoc * L * R * IL * IR) = both Assoc _ assoc-prop (both L _
      (unary (m e) (\ x -> x)) (both R _ (unary (\ x -> m x e) (\ x -> x)) (both IL IR
      (unary (\ x -> m (i x) x) (\ x -> e)) (unary (\ x -> m x (i x)) (\ x -> e))))) ;
  } ;
  prop : isProp laws = isProp-Sigma (isSet A) (\ s -> Assoc * L * R * IL * IR) (Torsor[l].isProp-isSet A) (\ s -> Set[s].rest) ;
} ;
structure (A : U l) : U l = (o : ops A) * On[A,o].laws ;
pack (A : U l) (s : structure A) : Gp.Grp = new Gp.Grp[A,s.2.1,s.1.1,s.1.2.1,s.1.2.2,
  s.2.2.1,s.2.2.2.1,s.2.2.2.2.1,s.2.2.2.2.2.1,s.2.2.2.2.2.2] ;
unpack (J : Gp.Grp) : structure J.G = ((J.e,J.mul,J.inv),J.setG,J.assoc,J.unitl,J.unitr,J.invl,J.invr) ;
eta : (J : Gp.Grp) -> Id Gp.Grp (pack J.G (unpack J)) J =
  split { Grp A s e m i a u v p q -> refl (new Gp.Grp[A,s,e,m,i,a,u,v,p,q]) } ;
pairs (A B : U l) (x y : A) (a b : B) (p : Id A x y) (q : Id B a b) : Id (A * B) (x,a) (y,b) =
  trans (A * B) _ (y,a) _ (ap A (A * B) (\ v -> (v,a)) x y p) (ap B (A * B) (\ w -> (y,w)) a b q) ;
module Compare (A : U l) (s : structure A) {
  S : Gp.Grp = pack A s ;
  module Equal (t : structure A) (law : (x y : A) -> Id A (S.mul x y) (t.1.2.1 x y)) {
    T : Gp.Grp = pack A t ;
    module H = QGrp[l].GHomL[S,T,(\ x -> x,law)] ;
    mult : Id (A -> A -> A) S.mul T.mul = FL.funext A (\ x -> A -> A) _ _ (\ x ->
      FL.funext A (\ y -> A) _ _ (law x)) ;
    op-path : Id (ops A) s.1 t.1 = pairs A _ _ _ _ _ H.hom-e
      (pairs (A -> A -> A) (A -> A) _ _ _ _ mult (FL.funext A (\ x -> A) _ _ H.hom-inv)) ;
    path : Id Gp.Grp S T = Big.ap (structure A) Gp.Grp (pack A) s t
      (Sigma-eq (ops A) (\ o -> On[A,o].laws) _ _ _ _ op-path On[A,t.1].prop) ;
  } ;
  motive (B : U l) (d : Equiv A B) : U l+ = (t : structure B) ->
    ((x y : A) -> Id B (d.1 (S.mul x y)) (t.1.2.1 (d.1 x) (d.1 y))) -> Id Gp.Grp S (pack B t) ;
  general (B : U l) (d : Equiv A B) : motive B d =
    Axioms[l].UnivalenceLemmas[univ @l].eqind A motive (\ t law -> Equal[t,law].path) B d ;
} ;
abstract-path (S T : Gp.Grp) (e : Equiv S.G T.G) (law : (x y : S.G) -> Id T.G (e.1 (S.mul x y)) (T.mul (e.1 x) (e.1 y))) :
  Id Gp.Grp S T = Big.trans _ _ _ _ (Big.sym _ _ _ (eta S))
    (Big.trans _ _ _ _ (Compare[S.G,unpack S].general T.G e (unpack T) law) (eta T)) ;

data-of (X : U l) : U l = Connected[l].isConn CG.two X * HLevels[l].isTrunc CG.three X ;
data-prop (X : U l) : isProp (data-of X) = isProp-Sigma (Connected[l].isConn CG.two X) (\ c -> HLevels[l].isTrunc CG.three X)
  (Connected[l].conn-prop CG.two X) (\ c -> HLevels[l].trunc-prop CG.three X) ;
build (X : U l) (x : X) (s : data-of X) : CG.ConcreteGroup = new CG.ConcreteGroup[X,x,s.1,s.2] ;
parts (G : CG.ConcreteGroup) : data-of G.space = (G.connected,G.groupoid) ;
rebuild : (G : CG.ConcreteGroup) -> Id CG.ConcreteGroup (build G.space G.point (parts G)) G =
  split { ConcreteGroup X x c t -> refl (new CG.ConcreteGroup[X,x,c,t]) } ;
concrete-path (G H : CG.ConcreteGroup) (e : Lemma4[l].PtEquiv G.space G.point H.space H.point) : Id CG.ConcreteGroup G H =
  Big.trans _ _ _ _ (Big.sym _ _ _ (rebuild G)) (Big.trans _ _ _ _
    (PtEquivOps[l].ptEqInd G.space G.point (\ Y y d -> (t : data-of Y) -> Id CG.ConcreteGroup (build G.space G.point (parts G)) (build Y y t))
      (\ t -> Big.ap (data-of G.space) CG.ConcreteGroup (build G.space G.point) _ _ (data-prop G.space (parts G) t))
      H.space H.point e (parts H)) (rebuild H)) ;
loops (G : CG.ConcreteGroup) : Gp.Grp = CG.Symmetries[G].abstract ;
deloop (H : Gp.Grp) : CG.ConcreteGroup = TorsorDelooping[l].Classify[H].concrete ;
equivalence : Big.Equiv CG.ConcreteGroup Gp.Grp = (loops,Big.qinv _ _ loops deloop
  (\ H -> abstract-path (loops (deloop H)) H AbstractRecovery[l].Recover[H].iso AbstractRecovery[l].Recover[H].preserves)
  (\ G -> concrete-path (deloop (loops G)) G ChapterSeven[l].ConcreteRecovery[G].pointed-equivalence)) ;

hom-path (J K : Group[l].Grp) (f g : QGrp[l].GHom J K) (h : (x : J.G) -> Id K.G (f.1 x) (g.1 x)) : Id (QGrp[l].GHom J K) f g =
  Sigma-eq (J.G -> K.G) (\ k -> (x y : J.G) -> Id K.G (k (J.mul x y)) (K.mul (k x) (k y))) _ _ _ _
    (FL.funext J.G (\ x -> K.G) _ _ h)
    (FL.isProp-Pi J.G (\ x -> (y : J.G) -> Id K.G (g.1 (J.mul x y)) (K.mul (g.1 x) (g.1 y)))
      (\ x -> FL.isProp-Pi J.G (\ y -> Id K.G (g.1 (J.mul x y)) (K.mul (g.1 x) (g.1 y))) (\ y -> K.setG _ _))) ;
