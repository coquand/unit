-- Sections 3.3--3.5. Set bundles on the small circle are sets with a permutation.
level l ;
open Base ; open Prelude[l+] ;
module P = Prelude[l] ;
module C = ChapterThree[l] ;
Set : U l+ = (X : U l) * P.isSet X ;
module S = ChapterTwo[l+].Subtype[U l,\ X -> P.isSet X,Torsor[l].isProp-isSet] ;
module L = CircleLarge[l,l+].Mapping[Set] ;
Aut (X : Set) : U l = P.Equiv X.1 X.1 ;
equivalences-are-set (a b : Set) : P.isSet (P.Equiv a.1 b.1) = P.isSet-Sigma (a.1 -> b.1) (P.isEquiv a.1 b.1)
  (Axioms[l].FunExtLemmas[fe @l].isSet-Pi a.1 (\ x -> b.1) (\ x -> b.2))
  (\ f -> P.prop-to-set _ (EquivProp[l].isEquiv-prop a.1 b.1 f)) ;
loops (X : Set) : Equiv (Id Set X X) (Aut X) = Equivalences[l+].compose
  (Id Set X X) (Id (U l) X.1 X.1) (Aut X) (S.At[X].paths X)
  (Axioms[l].idtoeqv X.1 X.1,univ @l X.1 X.1) ;
monodromy : Equiv (C.Circle -> Set) ((X : Set) * Aut X) = Equivalences[l+].compose
  (C.Circle -> Set) ((X : Set) * Id Set X X) ((X : Set) * Aut X)
  (L.E,L.E-equiv) (Fibres[l+].sigma-equiv Set (\ X -> Id Set X X) (\ X -> Aut X) loops) ;
