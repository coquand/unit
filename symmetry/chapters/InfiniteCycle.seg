-- Chapter 3. Evaluate a symmetry of the integer successor at zero.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Z = Integers[l] ; module CC = CycleComponents[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module Big = Prelude[l+] ;
I : U l = Z.Int ;
shift : Equiv I I = (Z.sucZ,qinv I I Z.sucZ Z.predZ Z.suc-pred Z.pred-suc) ;
standard : CC.Perm = ((I,Z.int-set),shift) ;
module From = CC.From[standard] ; module Component = CC.Component[standard] ;
module Laws = Torsor[l].AbL[Z.intAb] ;
undo (a b : I) (p : Id I (Z.add a b) Z.zeroZ) (x : I) : Id I (Z.add a (Z.add b x)) x =
  transH (symH (Z.assoc a b x)) (transH (apH (\ z -> Z.add z x) p) (Z.zero-l x)) ;
translation (a : I) : From.Iso standard =
  ((Z.add a,qinv I I (Z.add a) (Z.add (Z.neg a)) (undo a (Z.neg a) (Z.invr a))
      (undo (Z.neg a) a (Laws.invl a))),Z.add-sucR a) ;
module Determine (h : From.Iso standard) {
  f : I -> I = h.1.1 ;
  pred (x : I) : Id I (Z.predZ (f x)) (f (Z.predZ x)) =
    transH (apH Z.predZ (transH (apH f (symH (Z.suc-pred x))) (h.2 (Z.predZ x)))) (Z.pred-suc (f (Z.predZ x))) ;
  positive : (n : Nat) -> Id I (Z.addP (f Z.zeroZ) n) (f (pos n)) = split {
    zero -> refl (f Z.zeroZ) ; suc n | r -> transH (apH Z.sucZ r) (symH (h.2 (pos n))) } ;
  negative : (n : Nat) -> Id I (Z.addN (f Z.zeroZ) n) (f (negsuc n)) = split {
    zero -> pred Z.zeroZ ; suc n | r -> transH (apH Z.predZ r) (pred (negsuc n)) } ;
  at : (z : I) -> Id I (Z.add (f Z.zeroZ) z) (f z) = split { pos n -> positive n ; negsuc n -> negative n } ;
  unique : Id (From.Iso standard) (translation (f Z.zeroZ)) h =
    Sigma-eq (Equiv I I) (\ e -> From.Comm I e shift) _ _ _ _
      (ChapterTwo[l].equiv-ext I I (translation (f Z.zeroZ)).1 h.1 at)
      (From.law-prop I Z.int-set h.1 shift) ;
} ;
evaluate (v : CC.Perm) (h : From.Iso v) : v.1.1 = h.1.1 Z.zeroZ ;
at-standard : Equiv (From.Iso standard) I = (evaluate standard,qinv _ _ (evaluate standard) translation
  (\ x -> refl x) (\ h -> Determine[h].unique)) ;
symmetries : Equiv (Id Component.space Component.pt Component.pt) I = Equivalences[l].compose _ _ _ Component.loops at-standard ;
-- The assertion that evaluation is an equivalence descends to the whole component.
property (v : CC.Perm) : U l = isEquiv (From.Iso v) v.1.1 (evaluate v) ;
at-point : property (Component.show Component.pt) = Big.subst CC.Perm (\ v -> property v) standard (Component.show Component.pt)
  (Big.sym _ _ _ Component.C.path-at-point) at-standard.2 ;
evaluation (z : Component.space) : Equiv (From.Iso (Component.show z)) (Component.show z).1.1 =
  (evaluate (Component.show z),TruncationCombinators[l].rec (Id Component.space Component.pt z) @l _
    (EquivProp[l].isEquiv-prop _ _ (evaluate (Component.show z)))
    (\ p -> subst Component.space (\ w -> property (Component.show w)) Component.pt z p at-point) (Component.reaches z)) ;
based-codes (z : Component.space) : Equiv (Id Component.space Component.pt z) (From.Iso (Component.show z)) =
  Big.subst CC.Perm (\ w -> Equiv (Id Component.space Component.pt z) (CC.From[w].Iso (Component.show z)))
    (Component.show Component.pt) standard Component.C.path-at-point Component.At[Component.pt,z].codes ;
based-evaluation (z : Component.space) : Equiv (Id Component.space Component.pt z) (Component.show z).1.1 =
  Equivalences[l].compose _ _ _ (based-codes z) (evaluation z) ;
