level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
record ConcreteGroup {
  space : U l ;
  point : space ;
  connected : Connected[l].isConn (suc (suc zero)) space ;
  groupoid : HLevels[l].isTrunc (suc (suc (suc zero))) space ;
} ;
integer-group : ConcreteGroup = new ConcreteGroup[ChapterThree[l].Circle,ChapterThree[l].base,
  ChapterThree[l].K.conn1, ChapterThree[l].K.trunc1] ;
Hom (G H : ConcreteGroup) : U l = Lemma4[l].PtMap G.space G.point H.space H.point ;
compose (G H J : ConcreteGroup) (g : Hom H J) (f : Hom G H) : Hom G J =
  LoopCalc[l].ptcomp G.space G.point H.space H.point J.space J.point f g ;
module Symmetries (G : ConcreteGroup) {
  open G ;
  carrier : U l = Id space point point ;
  -- Book multiplication is categorical composition.
  abstract : Group[l].Grp = new Group[l].Grp[carrier,HLevels[l].trunc-set carrier (groupoid point point),
    refl point,\ q p -> trans space point point point p q,sym space point point,
    \ a b c -> symH (Groupoid[l].tassoc space point point point c b point a),
    \ a -> refl a,trans-refl-l space point point,
    Groupoid[l].trans-sym-r space point point,trans-sym-l space point point] ;
} ;

two : Nat = suc (suc zero) ;
three : Nat = suc two ;
module Tr = Truncation[l] ;
-- A pointed type is connected if every point is merely reachable from its base.
module Reachable (A : U l) (a : A) (reach : (b : A) -> Tr.Trunc[Id A a b].carrier) {
  between (x y : A) : Tr.Trunc[Id A x y].carrier = Tr.Trunc[Id A a x].induction @l
    (\ w -> Tr.Trunc[Id A x y].carrier) (\ w -> Tr.Trunc[Id A x y].proposition)
    (\ p -> TruncationCombinators[l].map (Id A a y) (Id A x y) (\ q -> transH (symH p) q) (reach y)) (reach x) ;
  connected : Connected[l].isConn two A = (Tr.Trunc[A].inc a,\ x y -> (between x y,\ p q -> tt)) ;
} ;
module Automorphisms (X : U l) (gpd : HLevels[l].isTrunc three X) (x : X) {
  membership (y : X) : U l = Tr.Trunc[Id X x y].carrier ;
  B : U l = (y : X) * membership y ;
  pt : B = (x,Tr.Trunc[Id X x x].inc (refl x)) ;
  module S = ChapterTwo[l].Subtype[X,membership,\ y -> Tr.Trunc[Id X x y].proposition] ;
  reaches (v : B) : Tr.Trunc[Id B pt v].carrier =
    TruncationCombinators[l].map (Id X x v.1) (Id B pt v) (S.At[pt].paths v).2.sec v.2 ;
  group : ConcreteGroup = new ConcreteGroup[B,pt,Reachable[B,pt,reaches].connected,
    HLevels[l].trunc-Sigma three X membership gpd
      (\ y -> HLevels[l].prop-trunc two (membership y) Tr.Trunc[Id X x y].proposition)] ;
  symmetries : Equiv (Id B pt pt) (Id X x x) = S.At[pt].paths pt ;
} ;

-- A pointed map from the integer group is determined by one group element.
integer-hom (G : ConcreteGroup) : Equiv (Hom integer-group G) (Symmetries[G].carrier) =
  CircleProperty[l].Circle[G.space].pointed-equiv G.point ;

-- The small component of X in the universe classifies its permutations.
module Symmetric (X : U l) (set : isSet X) {
  module C = Completion[l].Complete[Top,\ t -> X] ;
  pt : C.base = C.quotient tt ;
  reach (z : C.base) : Tr.Trunc[Id C.base pt z].carrier = LocalSmallness[l,l+].Component[U l,Completion[l].universe-small,X].path-from-point z ;
  sets (z : C.base) : isSet (C.extension z) =
    (C.surjective @l (\ w -> isSet (C.extension w)) (\ w -> Torsor[l].isProp-isSet (C.extension w))).sec
      (\ t -> Prelude[l+].subst (U l) (\ Y -> isSet Y) X (C.extension (C.quotient t))
        (Prelude[l+].sym _ _ _ (C.triangle t)) set) z ;
  module At (a b : C.base) {
    A : U l = C.extension a ;
    B : U l = C.extension b ;
    perms : isSet (Equiv A B) = isSet-Sigma (A -> B) (isEquiv A B)
      (Axioms[l].FunExtLemmas[fe @l].isSet-Pi A (\ t -> B) (\ t -> sets b))
      (\ f -> prop-to-set _ (EquivProp[l].isEquiv-prop A B f)) ;
    paths : Equiv (Id C.base a b) (Equiv A B) = Truncations[l].lower _ _
      (C.Identity[a,b].forward,C.Identity[a,b].univalent) ;
  } ;
  group : ConcreteGroup = new ConcreteGroup[C.base,pt,Reachable[C.base,pt,reach].connected,
    \ a b -> HLevels[l].equiv-trunc two _ _ At[a,b].paths (HLevels[l].set-trunc _ At[a,b].perms)] ;
  change (Y : U l) : U l = Equiv (Id C.base pt pt) (Equiv Y Y) ;
  permutations : Equiv (Id C.base pt pt) (Equiv X X) =
    Prelude[l+].subst (U l) (\ Y -> change Y) (C.extension pt) X (C.triangle tt) At[pt,pt].paths ;
} ;
