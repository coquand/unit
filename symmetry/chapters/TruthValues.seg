-- Exercises 2.18.3 and 2.20.2. The Boolean classifier for decidable predicates.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Logic[l] ;
module Q = Quotient[l] ; module B = Prelude[l+] ; module D = Decidability[l,l] ;
module FL = Axioms[l+].FunExtLemmas[fe @(l+)] ;
truth (b : Bool) : Q.Prop = (Id Bool true b,Z2[l].bool-set true b) ;
separate (p : Id Bool true false) : Empty = subst Bool (Z2[l].code true) true false p tt ;
decide : (b : Bool) -> Dec (truth b).1 = split { true -> yes (refl true) ; false -> no separate } ;
bit (P : Q.Prop) : Dec P.1 -> Bool = split { yes x -> true ; no n -> false } ;
classifies (P : Q.Prop) : (d : Dec P.1) -> Id Q.Prop (truth (bit P d)) P = split {
  yes x -> Q.prop-path (truth true) P (\ p -> x) (\ p -> refl true) ;
  no n -> Q.prop-path (truth false) P (\ p -> absurd _ (separate p)) (\ p -> absurd _ (n p)) } ;
reify : (b : Bool) (d : Dec (truth b).1) -> Id Bool (bit (truth b) d) b = split {
  true -> split { yes x -> refl true ; no n -> absurd _ (n (refl true)) } ;
  false -> split { yes x -> absurd _ (separate x) ; no n -> refl false } } ;
classifier : U l+ = B.isEquiv Bool Q.Prop truth ;
from-lem (lem : D.LEM) : classifier = B.qinv _ _ truth (\ P -> bit P (lem P.1 P.2))
  (\ P -> classifies P (lem P.1 P.2)) (\ b -> reify b (lem (truth b).1 (truth b).2)) ;
to-lem (e : classifier) (A : U l) (p : isProp A) : Dec A =
  B.subst Q.Prop (\ P -> Dec P.1) _ (A,p) (e.sec-eq (A,p)) (decide (e.sec (A,p))) ;
lem-prop : B.isProp D.LEM = FL.isProp-Pi (U l) (\ A -> isProp A -> Dec A)
  (\ A -> FL.isProp-Pi (isProp A) (\ p -> Dec A) (\ p -> dec-prop A p)) ;
equivalence : B.Equiv D.LEM classifier = (from-lem,B.qinv _ _ from-lem to-lem
  (\ c -> EquivProp[l+].isEquiv-prop Bool Q.Prop truth _ c) (\ h -> lem-prop _ h)) ;
decidable-proposition (P : Q.Prop) : Dec P.1 -> FiniteArithmetic[l].Sum (Equiv P.1 Top) (Equiv P.1 Empty) =
  split { yes x -> left ((\ p -> tt),qinv _ _ (\ p -> tt) (\ t -> x) (\ t -> isTop tt t) (\ p -> P.2 x p)) ;
    no n -> right (n,qinv _ _ n (absurd P.1) (\ t -> absurd _ t) (\ p -> absurd _ (n p))) } ;
module HedbergTheorem (A : U l) (d : (x y : A) -> Dec (Id A x y)) {
  flag (P : U l) : Dec P -> Bool = split { yes p -> true ; no n -> false } ;
  introduce (P : U l) (p : P) : (v : Dec P) -> Id Bool true (flag P v) = split {
    yes q -> refl true ; no n -> absurd _ (n p) } ;
  eliminate (P : U l) : (v : Dec P) -> Id Bool true (flag P v) -> P = split {
    yes q -> \ h -> q ; no n -> \ h -> absurd _ (separate h) } ;
  set (x : A) : (y : A) -> isProp (Id A x y) = Hedberg[A,x,\ y -> Id Bool true (flag (Id A x y) (d x y)),
    \ y -> Z2[l].bool-set _ _,introduce (Id A x x) (refl x) (d x x),\ y -> eliminate (Id A x y) (d x y)].hedberg ;
} ;
