-- Theorem 5.6.1 on underlying groups. The permutation induced by a loop
-- determines that loop by evaluation on the identity symmetry.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module Regular (G : ChapterFour[l].ConcreteGroup) {
  module R = ChapterFive[l,l].Principal[G] ;
  module S = ChapterFour[l].Symmetries[G] ;
  module E = Equivalences[l] ;
  e : S.carrier = refl G.point ;
  translate (x y : G.space) (p : Id G.space x y) : Equiv (R.carrier x) (R.carrier y) =
    idJ G.space x (\ z q -> Equiv (R.carrier x) (R.carrier z)) (idEquiv (R.carrier x)) y p ;
  module Law (x y : G.space) (p : Id G.space x y) {
    compose (z : G.space) (q : Id G.space y z) (v : R.carrier x) :
      Id (R.carrier z) ((translate x z (transH p q)).1 v)
        ((translate y z q).1 ((translate x y p).1 v)) =
      idJ G.space y (\ w r -> Id (R.carrier w) ((translate x w (transH p r)).1 v)
        ((translate y w r).1 ((translate x y p).1 v))) (refl ((translate x y p).1 v)) z q ;
  } ;
  permutation (p : S.carrier) : Equiv S.carrier S.carrier = translate G.point G.point p ;
  value (x : G.space) (p : R.carrier x) : Id (R.carrier x) ((translate G.point x p).1 e) p =
    idJ G.space G.point (\ z q -> Id (R.carrier z) ((translate G.point z q).1 e) q) (refl e) x p ;
  faithful (p q : S.carrier) (h : Id (Equiv S.carrier S.carrier) (permutation p) (permutation q)) :
    Id S.carrier p q = transH (symH (value G.point p))
      (transH (apH (\ f -> f.1 e) h) (value G.point q)) ;
  preserves (p q : S.carrier) : Id (Equiv S.carrier S.carrier) (permutation (S.abstract.mul p q))
    (E.compose _ _ _ (permutation q) (permutation p)) =
    Sigma-eq (S.carrier -> S.carrier) (isEquiv S.carrier S.carrier) _ _ _ _
      (Axioms[l].FunExtLemmas[fe @l].funext S.carrier (\ t -> S.carrier) _ _ (Law[G.point,G.point,q].compose G.point p))
      (EquivProp[l].isEquiv-prop S.carrier S.carrier _) ;
} ;
