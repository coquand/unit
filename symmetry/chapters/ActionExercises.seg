-- Exercises 5.4.8, 5.4.12 and 5.5.2.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module TB = Truncation[l+] ; module HL = HLevels[l] ; module FB = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (G : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ;
  module O = Orbits[l].Over[G].Orbits[X] ;
  pt : G.space = G.point ;
  transitive : U l = GS.Transitive[X].transitive ;
  -- Exercise 5.4.8: X/G is contractible if and only if X is transitive.
  module Contractible {
    meets (h : transitive) (x : GS.el X pt) (O1 : O.quotient) : Id O.quotient (O.orbit x) O1 =
      TC.rec ((y : GS.el X pt) * (O1.1 pt y).1) @(l+) _ (O.quotient-set _ _)
        (\ w -> Big.trans O.quotient _ _ _ (O.orbit-of-hit x w.1 (h.2 x w.1)) (O.Represent[O1,w.1,w.2].path)) O1.2.1 ;
    to (h : transitive) : FunExtUA[l+].isContr O.quotient =
      TC.rec (GS.el X pt) @(l+) _ (HLevels[l+].trunc-prop zero O.quotient) (\ x -> (O.orbit x,meets h x)) h.1 ;
    from (c : FunExtUA[l+].isContr O.quotient) : transitive =
      (TC.map ((y : GS.el X pt) * (c.1.1 pt y).1) (GS.el X pt) (\ w -> w.1) c.1.2.1,\ x y -> O.same-orbit x y (HLevels[l+].contr-prop O.quotient c (O.orbit x) (O.orbit y))) ;
  } ;
  -- Exercise 5.4.12: points in the same orbit have merely equal stabilizer groups.
  stabilizers (x y : GS.el X pt) (p : Id O.quotient (O.orbit x) (O.orbit y)) :
    TB.Trunc[Id CG.ConcreteGroup O.Stabilizer[x].group O.Stabilizer[y].group].carrier =
    TC.rec (O.hit x y) @(l+) _ TB.Trunc[Id CG.ConcreteGroup O.Stabilizer[x].group O.Stabilizer[y].group].proposition
      (\ w -> TB.Trunc[Id CG.ConcreteGroup O.Stabilizer[x].group O.Stabilizer[y].group].inc
        (Big.ap O.hG CG.ConcreteGroup (\ u -> CG.Automorphisms[O.hG,O.groupoid,u].group) (pt,x) (pt,y)
          (Sigma-path G.space (GS.el X) pt pt x y w.1 w.2))) (O.same-orbit x y p) ;
  -- Exercise 5.5.2: X is a torsor if and only if it is free and transitive.
  module Torsors {
    module C = ConcreteTorsors[l].Classify[G] ;
    contr : U l = FunExtUA[l].isContr O.hG ;
    contr-set (c : contr) : O.hG-set = HL.trunc-set O.hG (HL.contr-trunc CG.two O.hG c) ;
    contr-connected (c : contr) : Connected[l].isConn CG.two O.hG =
      (T.Trunc[O.hG].inc c.1,\ u v -> (T.Trunc[Id O.hG u v].inc (HL.contr-prop O.hG c u v),\ p q -> tt)) ;
    connected-set-contr (k : Connected[l].isConn CG.two O.hG) (s : O.hG-set) : contr =
      TC.rec O.hG @l _ (HL.trunc-prop zero O.hG)
        (\ a -> (a,\ b -> TC.rec (Id O.hG a b) @l _ (s a b) (\ q -> q) ((k.2 a b).1))) k.1 ;
    -- A G-set with contractible action type is merely the principal one.
    module Recover (c : contr) {
      module F = FundThm[l].FT[G.space,c.1.1,\ y -> (X y).1,c.1.2,c] ;
      eq (y : G.space) : Id Act.SetAt (C.represent c.1.1 y) (X y) =
        Big.Sigma-eq (U l) (\ S -> isSet S) _ _ _ _
          (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (F.tr y,F.equiv y)) (Torsor[l].isProp-isSet _) ;
      path : Id Act.GSet (C.represent c.1.1) X = FB.funext G.space (\ z -> Act.SetAt) _ _ eq ;
      mere : C.mere X = TC.rec (Id G.space pt c.1.1) @(l+) (C.mere X) TB.Trunc[Id Act.GSet C.principal X].proposition
        (\ p -> TB.Trunc[Id Act.GSet C.principal X].inc
          (Big.trans Act.GSet _ _ _ (Big.ap G.space Act.GSet C.represent pt c.1.1 p) path))
        ((G.connected.2 pt c.1.1).1) ;
    } ;
    to (m : C.mere X) : O.free * transitive = (O.set-free (contr-set (C.trivial (X,m))),
      GS.Transitive[X].from-connected (contr-connected (C.trivial (X,m)))) ;
    from (w : O.free * transitive) : C.mere X =
      Recover[connected-set-contr (GS.Transitive[X].total-connected w.2) (O.free-set w.1)].mere ;
  } ;
} ;
-- Exercise 5.4.23: maps of G-sets are the fixed points of the G-set of maps.
module Maps (G : CG.ConcreteGroup) (X Y : ChapterFive[l,l].Actions[G].GSet) {
  module GS = GSets[l].Over[G] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
  pt : G.space = G.point ;
  maps : ChapterFive[l,l].Actions[G].GSet = \ z -> (GS.el X z -> GS.el Y z,
    FL.isSet-Pi (GS.el X z) (\ x -> GS.el Y z) (\ x -> (Y z).2)) ;
  module O = Orbits[l].Over[G].Orbits[maps] ;
  equivalence : Equiv (GS.Hom X Y) ((f : GS.el X pt -> GS.el Y pt) * O.everywhere f) = O.Invariant.equivalence ;
} ;
-- Exercise 5.2.26: if evaluation of automorphisms is an equivalence at one
-- point, then it is an equivalence at every point.
module Evaluations (G : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ;
  ev (z : G.space) (x : GS.el X z) : Id Act.GSet X X -> GS.el X z = GS.evaluate-path X z x ;
  good (z : G.space) (x : GS.el X z) : U l+ = Big.isEquiv (Id Act.GSet X X) (GS.el X z) (ev z x) ;
  good-prop (z : G.space) (x : GS.el X z) : Big.isProp (good z x) = EquivProp[l+].isEquiv-prop _ _ (ev z x) ;
  moved (z : G.space) (x : GS.el X z) (h : good z x) (e0 : Id Act.GSet X X) : good z (ev z x e0) =
    idJ Act.GSet X (\ Y e1 -> Big.isEquiv (Id Act.GSet Y Y) (GS.el Y z)
      (\ e -> Big.subst Act.GSet (\ W -> GS.el W z) Y Y e (Big.subst Act.GSet (\ W -> GS.el W z) X Y e1 x))) h X e0 ;
  same-fibre (z : G.space) (x : GS.el X z) (h : good z x) (y : GS.el X z) : good z y =
    Big.subst (GS.el X z) (\ y1 -> good z y1) _ y (h.sec-eq y) (moved z x h (h.sec y)) ;
  along (z : G.space) (x : GS.el X z) (h : good z x) (w : G.space) (p : Id G.space z w) : good w (GS.act X z w p x) =
    idJ G.space z (\ w1 p1 -> good w1 (GS.act X z w1 p1 x)) h w p ;
  everywhere (z : G.space) (x : GS.el X z) (h : good z x) (w : G.space) (y : GS.el X w) : good w y =
    TC.rec (Id G.space z w) @(l+) _ (good-prop w y)
      (\ p -> same-fibre w (GS.act X z w p x) (along z x h w p) y) ((G.connected.2 z w).1) ;
} ;
-- Exercises 5.5.11 (second part) and 5.5.15: induction and coinduction are
-- left and right adjoint to restriction.
module Adjunctions (G H : CG.ConcreteGroup) (f : CG.Hom G H) {
  module I = InducedActions[l].Along[G,H,f] ;
  module GG = GSets[l].Over[G] ; module GH = GSets[l].Over[H] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
  Bf : G.space -> H.space = I.Bf ;
  module Left (X : I.AG.GSet) (Y : I.AH.GSet) {
    pairs (w : H.space) : U l = (z : G.space) * Id H.space (Bf z) w * GG.el X z ;
    extend (w : H.space) (b : pairs w -> GH.el Y w) : GH.el (I.induce X) w -> GH.el Y w =
      I.Induce[X,w].T.Into[\ t -> GH.el Y w,\ t -> HL.set-trunc _ (Y w).2].extend b ;
    computation (w : H.space) (b : pairs w -> GH.el Y w) (c : pairs w) :
      Id (GH.el Y w) (extend w b (I.Induce[X,w].T.unit c)) (b c) =
      I.Induce[X,w].T.Into[\ t -> GH.el Y w,\ t -> HL.set-trunc _ (Y w).2].computation b c ;
    to (k : GH.Hom (I.induce X) Y) : GG.Hom X (I.restrict Y) = \ z x -> k (Bf z) (I.unit X z x) ;
    from (k : GG.Hom X (I.restrict Y)) : GH.Hom (I.induce X) Y = \ w ->
      extend w (\ c -> subst H.space (GH.el Y) (Bf c.1) w c.2.1 (k c.1 c.2.2)) ;
    to-from (k : GG.Hom X (I.restrict Y)) : Id (GG.Hom X (I.restrict Y)) (to (from k)) k =
      FL.funext G.space (\ z -> GG.el X z -> GG.el (I.restrict Y) z) _ _ (\ z ->
        FL.funext (GG.el X z) (\ x -> GG.el (I.restrict Y) z) _ _ (\ x ->
          computation (Bf z) (\ c -> subst H.space (GH.el Y) (Bf c.1) (Bf z) c.2.1 (k c.1 c.2.2)) (z,refl (Bf z),x))) ;
    unit-moves (k : GH.Hom (I.induce X) Y) (z : G.space) (x : GG.el X z) (w : H.space) (p : Id H.space (Bf z) w) :
      Id (GH.el Y w) (subst H.space (GH.el Y) (Bf z) w p (k (Bf z) (I.unit X z x))) (k w (I.Induce[X,w].T.unit (z,p,x))) =
      idJ H.space (Bf z) (\ w1 p1 -> Id (GH.el Y w1) (subst H.space (GH.el Y) (Bf z) w1 p1 (k (Bf z) (I.unit X z x)))
        (k w1 (I.Induce[X,w1].T.unit (z,p1,x)))) (refl (k (Bf z) (I.unit X z x))) w p ;
    from-to (k : GH.Hom (I.induce X) Y) : Id (GH.Hom (I.induce X) Y) (from (to k)) k =
      FL.funext H.space (\ w -> GH.el (I.induce X) w -> GH.el Y w) _ _ (\ w ->
        FL.funext (GH.el (I.induce X) w) (\ t -> GH.el Y w) _ _
          (I.Induce[X,w].T.Into[\ t -> Id (GH.el Y w) (from (to k) w t) (k w t),
            \ t -> HL.prop-trunc (suc zero) _ ((Y w).2 _ _)].extend (\ c ->
            transH (computation w (\ c1 -> subst H.space (GH.el Y) (Bf c1.1) w c1.2.1 (to k c1.1 c1.2.2)) c)
              (unit-moves k c.1 c.2.2 w c.2.1)))) ;
    equivalence : Equiv (GH.Hom (I.induce X) Y) (GG.Hom X (I.restrict Y)) = (to,qinv _ _ to from to-from from-to) ;
  } ;
  module Right (Y : I.AH.GSet) (X : I.AG.GSet) {
    to (k : GG.Hom (I.restrict Y) X) : GH.Hom Y (I.coinduce X) = \ w y z p ->
      idJ H.space (Bf z) (\ w1 p1 -> GH.el Y w1 -> GG.el X z) (k z) w p y ;
    from (k : GH.Hom Y (I.coinduce X)) : GG.Hom (I.restrict Y) X = \ z y -> k (Bf z) y z (refl (Bf z)) ;
    to-from (k : GH.Hom Y (I.coinduce X)) (w : H.space) (y : GH.el Y w) (z : G.space) (p : Id H.space (Bf z) w) :
      Id (GG.el X z) (to (from k) w y z p) (k w y z p) =
      idJ H.space (Bf z) (\ w1 p1 -> (y1 : GH.el Y w1) -> Id (GG.el X z) (to (from k) w1 y1 z p1) (k w1 y1 z p1))
        (\ y1 -> refl (k (Bf z) y1 z (refl (Bf z)))) w p y ;
    equivalence : Equiv (GG.Hom (I.restrict Y) X) (GH.Hom Y (I.coinduce X)) = (to,qinv _ _ to from
      (\ k -> FL.funext H.space (\ w -> GH.el Y w -> GH.el (I.coinduce X) w) _ _ (\ w ->
        FL.funext (GH.el Y w) (\ y -> GH.el (I.coinduce X) w) _ _ (\ y ->
          FL.funext G.space (\ z -> Id H.space (Bf z) w -> GG.el X z) _ _ (\ z ->
            FL.funext (Id H.space (Bf z) w) (\ p -> GG.el X z) _ _ (\ p -> to-from k w y z p)))))
      (\ k -> refl k)) ;
  } ;
} ;
-- Exercise 5.2.7: the adjoint G-set is the G-set Hom(Z,G).
module AdjointHoms (G : CG.ConcreteGroup) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ;
  fibre (y : G.space) : Id Act.SetAt (GS.adjoint y) (GS.homs CG.integer-group y) =
    Big.Sigma-eq (U l) (\ S -> isSet S) _ _ _ _
      (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (Bijection[l].inverse _ _ (CircleProperty[l].Circle[G.space].pointed-equiv y)))
      (Torsor[l].isProp-isSet _) ;
  path : Id Act.GSet GS.adjoint (GS.homs CG.integer-group) = FB.funext G.space (\ z -> Act.SetAt) _ _ fibre ;
} ;
-- Exercise 5.2.17: G is trivial (BG is contractible) if and only if Ad_G is
-- the principal G-set.
module AdjointPrincipal (G : CG.ConcreteGroup) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ;
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  trivial : U l = FunExtUA[l].isContr G.space ;
  contr-equiv (A B : U l) (cA : FunExtUA[l].isContr A) (cB : FunExtUA[l].isContr B) : Equiv A B =
    (\ a -> cB.1,qinv _ _ (\ a -> cB.1) (\ b -> cA.1) (\ b -> HL.contr-prop B cB _ b) (\ a -> HL.contr-prop A cA _ a)) ;
  to (c : trivial) : Id Act.GSet GS.adjoint GS.principal = FB.funext G.space (\ z -> Act.SetAt) _ _ (\ z ->
    Big.Sigma-eq (U l) (\ S -> isSet S) _ _ _ _
      (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (contr-equiv _ _ (HL.contr-paths G.space c z z) (HL.contr-paths G.space c pt z)))
      (Torsor[l].isProp-isSet _)) ;
  -- The free loop space is contractible when Ad_G is principal; hence every loop is trivial.
  free-contr (e : Id Act.GSet GS.adjoint GS.principal) : FunExtUA[l].isContr (GS.total GS.adjoint) =
    Big.subst Act.GSet (\ X -> FunExtUA[l].isContr (GS.total X)) GS.principal GS.adjoint (Big.sym Act.GSet _ _ e)
      ChapterFive[l,l].Principal[G].total-contractible ;
  is-refl (e : Id Act.GSet GS.adjoint GS.principal) (p : UG) : Id UG p (refl pt) =
    subst (GS.total GS.adjoint) (\ u -> Id (Id G.space u.1 u.1) u.2 (refl u.1)) (pt,refl pt) (pt,p)
      (HL.contr-prop _ (free-contr e) (pt,refl pt) (pt,p)) (refl (refl pt)) ;
  from (e : Id Act.GSet GS.adjoint GS.principal) : trivial =
    BasicGroups[l].Contract[G,\ p q -> transH (is-refl e p) (symH (is-refl e q))].contractible ;
} ;
-- Exercise 5.2.16: G is abelian if and only if Ad_G is the trivial G-set on UG.
module AdjointTrivial (G : CG.ConcreteGroup) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ; module LC = LoopConj[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  UG-set : isSet UG = HL.trunc-set _ (G.groupoid pt pt) ;
  triv : Act.GSet = GS.trivial (UG,UG-set) ;
  abelian : U l = BasicGroups[l].abelian G ;
  -- trans (sym p) (trans p r) = r.
  cancel (x y : G.space) (p : Id G.space x y) : (z : G.space) (r : Id G.space y z) ->
    Id (Id G.space y z) (trans G.space y x z (sym G.space x y p) (trans G.space x y z p r)) r =
    idJ G.space x (\ y1 p1 -> (z : G.space) (r : Id G.space y1 z) ->
      Id (Id G.space y1 z) (trans G.space y1 x z (sym G.space x y1 p1) (trans G.space x y1 z p1 r)) r)
      (\ z r -> transH (trans-refl-l G.space x z (trans G.space x x z (refl x) r)) (trans-refl-l G.space x z r)) y p ;
  -- From Ad_G = triv to commutativity.
  module Back (e : Id Act.GSet GS.adjoint triv) {
    phi : GS.Hom GS.adjoint triv = GS.transport-hom GS.adjoint triv e ;
    phi-equiv : Equiv UG UG = Axioms[l].idtoeqv UG UG (GS.fibre-path GS.adjoint triv e pt) ;
    phi-injective (q q' : UG) (h : Id UG (phi pt q) (phi pt q')) : Id UG q q' =
      Equivalences[l].injective _ _ phi-equiv.1 phi-equiv.2 q q'
        (transH (GS.PathInjective[GS.adjoint,triv].computes e pt q) (transH h (symH (GS.PathInjective[GS.adjoint,triv].computes e pt q')))) ;
    const-act (g : UG) (y : UG) : Id UG (GS.act triv pt pt g y) y =
      idJ G.space pt (\ w g1 -> Id UG (subst G.space (\ z -> UG) pt w g1 y) y) (refl y) pt g ;
    conj-trivial (g q : UG) : Id UG (LC.conj G.space pt pt g q) q = phi-injective _ _
      (transH (apH (phi pt) (symH (GS.adjoint-acts pt pt g q)))
        (transH (GS.equivariant GS.adjoint triv phi pt pt g q) (const-act g (phi pt q)))) ;
    -- trans (sym p) (trans q p) = s gives trans q p = trans p s.
    move (x y : G.space) (p : Id G.space x y) : (q : Id G.space x x) (s : Id G.space y y)
      (h : Id (Id G.space y y) (trans G.space y x y (sym G.space x y p) (trans G.space x x y q p)) s) ->
      Id (Id G.space x y) (trans G.space x x y q p) (trans G.space x y y p s) =
      idJ G.space x (\ y1 p1 -> (q : Id G.space x x) (s : Id G.space y1 y1)
        (h : Id (Id G.space y1 y1) (trans G.space y1 x y1 (sym G.space x y1 p1) (trans G.space x x y1 q p1)) s) ->
        Id (Id G.space x y1) (trans G.space x x y1 q p1) (trans G.space x y1 y1 p1 s))
        (\ q s h -> transH (transH (symH (trans-refl-l G.space x x q)) h) (symH (trans-refl-l G.space x x s))) y p ;
    commutes : abelian = \ p q -> move pt pt p q q (conj-trivial p q) ;
  } ;
  -- From commutativity to Ad_G = triv: conjugation along any path pt = z.
  module Forth (a : abelian) (z : G.space) {
    B : U l = Equiv UG (Id G.space z z) ;
    B-set : isSet B = isSet-Sigma (UG -> Id G.space z z) (isEquiv UG (Id G.space z z))
      (FL.isSet-Pi UG (\ t -> Id G.space z z) (\ t -> HL.trunc-set _ (G.groupoid z z)))
      (\ f -> prop-to-set _ (EquivProp[l].isEquiv-prop UG (Id G.space z z) f)) ;
    along (z1 : G.space) (p : Id G.space pt z1) : Equiv UG (Id G.space z1 z1) = (LC.conj G.space pt z1 p,
      qinv _ _ (LC.conj G.space pt z1 p) (LC.conj G.space z1 pt (sym G.space pt z1 p))
        (LC.conj-sym-back G.space pt z1 p) (LC.conj-back G.space pt z1 p)) ;
    loop-conj (p u : UG) : Id UG (LC.conj G.space pt pt p u) (trans G.space pt pt pt (refl pt) u) =
      transH (apH (trans G.space pt pt pt (sym G.space pt pt p)) (a p u))
        (transH (cancel pt pt p pt u) (symH (trans-refl-l G.space pt pt u))) ;
    agree-at (z1 : G.space) (p' : Id G.space pt z1) : (p : Id G.space pt z1) ->
      Id (Equiv UG (Id G.space z1 z1)) (along z1 p) (along z1 p') =
      idJ G.space pt (\ z2 p2 -> (p : Id G.space pt z2) -> Id (Equiv UG (Id G.space z2 z2)) (along z2 p) (along z2 p2))
        (\ p -> Sigma-eq (UG -> UG) (isEquiv UG UG) _ _ _ _
          (FL.funext UG (\ u -> UG) _ _ (loop-conj p)) (EquivProp[l].isEquiv-prop UG UG (LC.conj G.space pt pt (refl pt)))) z1 p' ;
    module K = ConstantMap[l].Constant[Id G.space pt z,B,B-set,along z,\ p p' -> agree-at z p' p] ;
    equiv : B = K.value ((G.connected.2 pt z).1) ;
    fibre : Id Act.SetAt (GS.adjoint z) (triv z) = Big.Sigma-eq (U l) (\ S -> isSet S) _ _ _ _
      (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (Bijection[l].inverse _ _ equiv)) (Torsor[l].isProp-isSet _) ;
  } ;
  forth (a : abelian) : Id Act.GSet GS.adjoint triv = FB.funext G.space (\ z -> Act.SetAt) _ _ (\ z -> Forth[a,z].fibre) ;
  back (e : Id Act.GSet GS.adjoint triv) : abelian = Back[e].commutes ;
} ;
-- Exercise 5.6.4: the fixed permutations of UG for the G-set
-- PP(z) = (P(z) = P(z)) are the right multiplications, and evaluation at refl
-- followed by inversion is an isomorphism onto UG.
module FixedPermutations (G : CG.ConcreteGroup) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  UG-set : isSet UG = HL.trunc-set _ (G.groupoid pt pt) ;
  perms (z : G.space) : U l = Equiv (Id G.space pt z) (Id G.space pt z) ;
  PP : Act.GSet = \ z -> (perms z,isSet-Sigma (Id G.space pt z -> Id G.space pt z) (isEquiv (Id G.space pt z) (Id G.space pt z))
    (FL.isSet-Pi (Id G.space pt z) (\ t -> Id G.space pt z) (\ t -> HL.trunc-set _ (G.groupoid pt z)))
    (\ f -> prop-to-set _ (EquivProp[l].isEquiv-prop _ _ f))) ;
  module O = Orbits[l].Over[G].Orbits[PP] ;
  -- Transport in PP is conjugation: p . pi = x |-> pi(x p^-1) p.
  act-PP (z : G.space) (p : Id G.space pt z) (pi : perms pt) (x : Id G.space pt z) :
    Id (Id G.space pt z) ((GS.act PP pt z p pi).1 x) (trans G.space pt pt z (pi.1 (trans G.space pt z pt x (sym G.space pt z p))) p) =
    idJ G.space pt (\ z1 p1 -> (x1 : Id G.space pt z1) ->
      Id (Id G.space pt z1) ((GS.act PP pt z1 p1 pi).1 x1) (trans G.space pt pt z1 (pi.1 (trans G.space pt z1 pt x1 (sym G.space pt z1 p1))) p1))
      (\ x1 -> refl (pi.1 x1)) z p x ;
  cancel-back (x y z : G.space) (k : Id G.space x y) (p : Id G.space z y) :
    Id (Id G.space x y) (trans G.space x z y (trans G.space x y z k (sym G.space z y p)) p) k =
    idJ G.space z (\ y1 p1 -> (k1 : Id G.space x y1) ->
      Id (Id G.space x y1) (trans G.space x z y1 (trans G.space x y1 z k1 (sym G.space z y1 p1)) p1) k1) (\ k1 -> refl k1) y p k ;
  cancel-front (x y : G.space) (p : Id G.space x y) : (z : G.space) (r : Id G.space x z) ->
    Id (Id G.space x z) (trans G.space x y z p (trans G.space y x z (sym G.space x y p) r)) r =
    idJ G.space x (\ y1 p1 -> (z : G.space) (r : Id G.space x z) ->
      Id (Id G.space x z) (trans G.space x y1 z p1 (trans G.space y1 x z (sym G.space x y1 p1) r)) r)
      (\ z r -> transH (trans-refl-l G.space x z (trans G.space x x z (refl x) r)) (trans-refl-l G.space x z r)) y p ;
  -- pi(g g') = g pi(g'), in the book's order of multiplication.
  hom (pi : perms pt) : U l = (g g' : UG) -> Id UG (pi.1 (trans G.space pt pt pt g' g)) (trans G.space pt pt pt (pi.1 g') g) ;
  hom-prop (pi : perms pt) : isProp (hom pi) = FL.isProp-Pi UG (\ g -> (g' : UG) -> Id UG (pi.1 (trans G.space pt pt pt g' g)) (trans G.space pt pt pt (pi.1 g') g))
    (\ g -> FL.isProp-Pi UG (\ g' -> Id UG (pi.1 (trans G.space pt pt pt g' g)) (trans G.space pt pt pt (pi.1 g') g)) (\ g' -> UG-set _ _)) ;
  fixed-hom (pi : perms pt) (h : O.everywhere pi) : hom pi = \ g g' ->
    transH (apH (\ s -> s.1 (trans G.space pt pt pt g' g)) (symH (h g)))
      (transH (act-PP pt g pi (trans G.space pt pt pt g' g))
        (apH (\ y -> trans G.space pt pt pt (pi.1 y) g) (Groupoid[l].cancel-r G.space pt pt pt g' g))) ;
  hom-fixed (pi : perms pt) (k : hom pi) : O.everywhere pi = \ g ->
    Sigma-eq (UG -> UG) (isEquiv UG UG) _ _ _ _ (FL.funext UG (\ x -> UG) _ _ (\ x ->
      transH (act-PP pt g pi x) (transH (symH (k g (trans G.space pt pt pt x (sym G.space pt pt g))))
        (apH pi.1 (cancel-back pt pt pt x g))))) (EquivProp[l].isEquiv-prop UG UG pi.1) ;
  Fixed : U l = (pi : perms pt) * hom pi ;
  eval (pi : Fixed) : UG = pi.1.1 (refl pt) ;
  rmul (h : UG) : Fixed = ((\ x -> trans G.space pt pt pt h x,qinv _ _ (\ x -> trans G.space pt pt pt h x) (\ x -> trans G.space pt pt pt (sym G.space pt pt h) x)
      (\ x -> cancel-front pt pt h pt x) (\ x -> AdjointTrivial[G].cancel pt pt h pt x)),
    \ g g' -> symH (Groupoid[l].tassoc G.space pt pt pt h g' pt g)) ;
  fixed-rmul (pi : Fixed) (x : UG) : Id UG (pi.1.1 x) (trans G.space pt pt pt (eval pi) x) =
    transH (apH pi.1.1 (symH (trans-refl-l G.space pt pt x))) (pi.2 x (refl pt)) ;
  eval-equiv : Equiv Fixed UG = (eval,qinv _ _ eval rmul (\ h -> refl h) (\ pi ->
    Sigma-eq (perms pt) hom _ _ _ _ (Sigma-eq (UG -> UG) (isEquiv UG UG) _ _ _ _
      (FL.funext UG (\ x -> UG) _ _ (\ x -> symH (fixed-rmul pi x))) (EquivProp[l].isEquiv-prop UG UG pi.1.1)) (hom-prop pi.1))) ;
  -- Evaluation reverses the order: eval(pi o pi') = eval(pi') eval(pi).
  compose (pi pi' : Fixed) : Id UG (pi.1.1 (eval pi')) (trans G.space pt pt pt (eval pi) (eval pi')) = fixed-rmul pi (eval pi') ;
  -- Followed by inversion it preserves the order.
  inverse (pi : Fixed) : UG = sym G.space pt pt (eval pi) ;
  sym-equiv : Equiv UG UG = (sym G.space pt pt,qinv _ _ (sym G.space pt pt) (sym G.space pt pt)
    (Groupoid[l].sym-sym G.space pt pt) (Groupoid[l].sym-sym G.space pt pt)) ;
  inverse-equiv : Equiv Fixed UG = Equivalences[l].compose _ _ _ eval-equiv sym-equiv ;
  inverse-hom (pi pi' : Fixed) : Id UG (sym G.space pt pt (pi.1.1 (eval pi')))
    (trans G.space pt pt pt (inverse pi') (inverse pi)) =
    transH (apH (sym G.space pt pt) (compose pi pi')) (Groupoid[l].sym-trans G.space pt pt pt (eval pi) (eval pi')) ;
} ;
-- Exercise 5.5.10: without the set truncation, f_! X need not be an H-set:
-- for Z -> 1 and the constant G-set 1 the untruncated fibre is the circle.
module WhyTruncate {
  module Z = Integers[l] ; module C3 = ChapterThree[l] ;
  G : CG.ConcreteGroup = CG.integer-group ; H : CG.ConcreteGroup = SignOrderings[l].trivial ;
  f : CG.Hom G H = (\ z -> tt,refl tt) ;
  X : ChapterFive[l,l].Actions[G].GSet = GSets[l].Over[G].trivial (Top,prop-to-set Top isTop) ;
  untruncated : U l = (z : G.space) * Id H.space (f.1 z) tt * (X z).1 ;
  section (a : C3.Circle) : untruncated = (a,refl tt,tt) ;
  not-set (s : isSet untruncated) : Empty =
    subst Z.Int (Z.code (pos zero)) (pos zero) (negsuc zero)
      (transH (symH (C3.winding.2.sec-eq (pos zero)))
        (transH (apH C3.winding.1 (circle-set C3.base C3.base (C3.winding.2.sec (pos zero)) (C3.winding.2.sec (negsuc zero))))
          (C3.winding.2.sec-eq (negsuc zero))))
      (Z.code-refl (pos zero)) where {
    circle-set : isSet C3.Circle = Groupoid[l].set-retract C3.Circle untruncated section (\ w -> w.1) (\ a -> refl a) s ;
  } ;
} ;
-- Exercise 5.5.11, first part: for an isomorphism f, f_! X is X o Bf^-1.
module InduceIso (G H : CG.ConcreteGroup) (f : CG.Hom G H) (i : isEquiv G.space H.space f.1) (X : ChapterFive[l,l].Actions[G].GSet) {
  module I = InducedActions[l].Along[G,H,f] ;
  pairs (A B : U l) (e : Equiv A B) (F : A -> U l) (w : B) : U l = (z : A) * Id B (e.1 z) w * F z ;
  motive (A : U l) (F : A -> U l) (B : U l) (e : Equiv A B) : U l = (w : B) -> Equiv (pairs A B e F w) (F (e.2.sec w)) ;
  base (A : U l) (F : A -> U l) : motive A F A (idEquiv A) = \ w ->
    (\ c -> subst A F c.1 w c.2.1 c.2.2,qinv _ _ (\ c -> subst A F c.1 w c.2.1 c.2.2) (\ x -> (w,refl w,x)) (\ x -> refl x)
      (\ c -> idJ A c.1 (\ w1 p1 -> (x : F c.1) -> Id (pairs A A (idEquiv A) F w1) (w1,refl w1,subst A F c.1 w1 p1 x) (c.1,p1,x))
        (\ x -> refl (c.1,refl c.1,x)) w c.2.1 c.2.2)) ;
  contract (A B : U l) (e : Equiv A B) (F : A -> U l) : motive A F B e =
    Axioms[l].UnivalenceLemmas[univ @l].eqind A (\ B1 e1 -> motive A F B1 e1) (base A F) B e ;
  fibre (w : H.space) : Equiv (pairs G.space H.space (f.1,i) (\ z -> (X z).1) w) (X (i.sec w)).1 =
    contract G.space H.space (f.1,i) (\ z -> (X z).1) w ;
  fibre-set (w : H.space) : isSet (pairs G.space H.space (f.1,i) (\ z -> (X z).1) w) =
    HL.trunc-set _ (HL.equiv-trunc CG.two _ _ (fibre w) (HL.set-trunc _ (X (i.sec w)).2)) ;
  equivalence (w : H.space) : Equiv (I.induce X w).1 (X (i.sec w)).1 = Equivalences[l].compose _ _ _
    (Bijection[l].inverse _ _ InducedActions[l].SetTrunc[pairs G.space H.space (f.1,i) (\ z -> (X z).1) w,fibre-set w].equiv) (fibre w) ;
} ;
-- Remark 5.4.7: G-subsets of X are the subsets of X/G.
module SubsetsOfOrbits (G : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet) {
  module GS = GSets[l].Over[G] ; module O = Orbits[l].Over[G].Orbits[X] ;
  PropAt : U l+ = GSets[l].PropAt ;
  curry : Big.Equiv (GS.SubG X) (O.hG -> PropAt) = (\ P u -> P u.1 u.2,Big.qinv _ _ (\ P u -> P u.1 u.2) (\ Q z x -> Q (z,x))
    (\ Q -> refl Q) (\ P -> refl P)) ;
  restrict : Big.Equiv (O.ST.carrier -> PropAt) (O.hG -> PropAt) =
    UniverseChange[l,l+].TruncationElim[suc zero,O.hG].Into[\ z -> PropAt,\ z -> HLevels[l+].set-trunc PropAt Orbits[l].propat-set].restriction ;
  module Pre (A B : U l+) (e : Big.Equiv A B) {
    to (k : B -> PropAt) : A -> PropAt = \ a -> k (e.1 a) ;
    from (h : A -> PropAt) : B -> PropAt = \ b -> h (e.2.sec b) ;
    equiv : Big.Equiv (B -> PropAt) (A -> PropAt) = (to,Big.qinv _ _ to from
      (\ h -> FB.funext A (\ a -> PropAt) _ _ (\ a -> Big.ap A PropAt h _ _ (Big.sec-ret A B e.1 e.2 a)))
      (\ k -> FB.funext B (\ b -> PropAt) _ _ (\ b -> Big.ap B PropAt k _ _ (e.2.sec-eq b)))) ;
  } ;
  equivalence : Big.Equiv (GS.SubG X) (O.quotient -> PropAt) = Equivalences[l+].compose _ _ _ curry
    (Equivalences[l+].compose _ _ _ (Bijection[l+].inverse _ _ restrict) (Bijection[l+].inverse _ _ Pre[O.ST.carrier,O.quotient,O.truncation].equiv)) ;
} ;
-- Example 5.4.16, Exercise 5.4.17 and Exercise 5.4.27 (first parts):
-- the elements of a trivial G-set are fixed.
module TrivialStabilizer (G : CG.ConcreteGroup) (S : ChapterFive[l,l].Actions[G].SetAt) (s : S.1) {
  module GS = GSets[l].Over[G] ;
  X : ChapterFive[l,l].Actions[G].GSet = GS.trivial S ;
  module O = Orbits[l].Over[G].Orbits[X] ; module St = O.Stabilizer[s] ; module A = St.Aut ; module OS = O.OrbitStabilizer[s] ;
  pt : G.space = G.point ;
  const (z w : G.space) (g : Id G.space z w) (y : S.1) : Id S.1 (GS.act X z w g y) y =
    idJ G.space z (\ w1 g1 -> Id S.1 (GS.act X z w1 g1 y) y) (refl y) w g ;
  fixed : St.fixed = O.Fixed[s].to-fixed (\ g -> const pt pt g s) ;
  tot-path (z : G.space) (p : Id G.space pt z) : Id O.hG (pt,s) (z,s) =
    idJ G.space pt (\ z1 p1 -> Id O.hG (pt,s) (z1,s)) (refl (pt,s)) z p ;
  to (v : A.B) : G.space = v.1.1 ;
  from (z : G.space) : A.B = ((z,s),TC.map _ _ (tot-path z) ((G.connected.2 pt z).1)) ;
  second (v : A.B) : Id S.1 s v.1.2 = TC.rec (Id O.hG (pt,s) v.1) @l _ (S.2 _ _)
    (\ q -> transH (symH (const pt v.1.1 (sPath G.space (GS.el X) (pt,s) v.1 q).1 s)) (sPath G.space (GS.el X) (pt,s) v.1 q).2) v.2 ;
  from-to (v : A.B) : Id A.B (from (to v)) v = Sigma-eq O.hG A.membership _ _ _ _
    (apH (\ y -> (v.1.1,y)) (second v)) (T.Trunc[Id O.hG (pt,s) v.1].proposition) ;
  -- BG_s is BG.
  equiv : Equiv A.B G.space = (to,qinv _ _ to from (\ z -> refl z) from-to) ;
  -- The action type of the G_s-set G~_s is contractible.
  through-contr : FunExtUA[l+].isContr St.through = ((s,refl (O.orbit s)),\ w -> Big.Sigma-eq S.1
    (\ y -> Id O.quotient (O.orbit s) (O.orbit y)) _ _ _ _
    (TC.rec (O.hit s w.1) @l _ (S.2 _ _) (\ h -> transH (symH (const pt pt h.1 s)) h.2) (O.same-orbit s w.1 w.2))
    (O.quotient-set _ _)) ;
  action-contr : FunExtUA[l].isContr OS.action-type = HLevels[l+].equiv-trunc zero OS.action-type St.through OS.theorem through-contr ;
} ;
-- The elements of the principal G-set are free.
module PrincipalStabilizer (G : CG.ConcreteGroup) (g : Id G.space G.point G.point) {
  module GS = GSets[l].Over[G] ;
  X : ChapterFive[l,l].Actions[G].GSet = GS.principal ;
  module O = Orbits[l].Over[G].Orbits[X] ; module St = O.Stabilizer[g] ; module A = St.Aut ; module OS = O.OrbitStabilizer[g] ;
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  hG-contr : FunExtUA[l].isContr O.hG = ChapterFive[l,l].Principal[G].total-contractible ;
  -- BG_g is contractible.
  free : St.free = HL.trunc-Sigma zero O.hG A.membership hG-contr (\ u ->
    (T.Trunc[Id O.hG (pt,g) u].inc (HL.contr-prop _ hG-contr (pt,g) u),\ t -> T.Trunc[Id O.hG (pt,g) u].proposition _ t)) ;
  module Tor = Over[G,X].Torsors ;
  transitive : GS.Transitive[X].transitive = (Tor.to (TB.Trunc[Id ChapterFive[l,l].Actions[G].GSet Tor.C.principal X].inc (refl X))).2 ;
  all (y : UG) : Id O.quotient (O.orbit g) (O.orbit y) = O.orbit-of-hit g y (transitive.2 g y) ;
  project : Big.Equiv St.through UG = (\ w -> w.1,Big.qinv _ _ (\ w -> w.1) (\ y -> (y,all y)) (\ y -> refl y)
    (\ w -> Big.Sigma-eq UG (\ y -> Id O.quotient (O.orbit g) (O.orbit y)) _ _ _ _ (refl w.1) (O.quotient-set _ _))) ;
  -- The action type of G~_g is UG.
  action-type : Big.Equiv OS.action-type UG = Equivalences[l+].compose _ _ _ OS.theorem project ;
} ;
-- Exercise 5.4.26: G_x acts on G~_x by composition with the image of the path.
module TildeAction (G : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet) (x : (X G.point).1) {
  module Sd = Orbits[l].Stabilized[G,X,x] ; module GT = GSets[l].Over[Sd.St.group] ;
  pt : G.space = G.point ; K : U l = Sd.St.group.space ;
  acts (w w' : K) (s : Id K w w') (g : GT.el Sd.tilde w) :
    Id (Id G.space pt w'.1.1) (GT.act Sd.tilde w w' s g) (trans G.space pt w.1.1 w'.1.1 g (apH (\ v -> v.1.1) s)) =
    idJ K w (\ w1 s1 -> Id (Id G.space pt w1.1.1) (GT.act Sd.tilde w w1 s1 g) (trans G.space pt w.1.1 w1.1.1 g (apH (\ v -> v.1.1) s1)))
      (refl g) w' s ;
} ;
-- Example 5.3.17: the first inclusion G -> G x K is a monomorphism.
module FirstInclusion (G K : CG.ConcreteGroup) {
  module P = ConcreteExamples[l].Binary[G,K] ; module ST = SubgroupTheory[l].Over[P.group] ;
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  i : CG.Hom G P.group = P.include-first ;
  on-loops (p : UG) : Id (Id P.pair P.base P.base) (ST.loop-map G i p) (apH i.1 p) =
    transH (DeloopMaps[l].Maps[G.space,pt,P.pair,P.base].loop-ap i p) (trans-refl-l P.pair P.base P.base (apH i.1 p)) ;
  back (p : UG) : Id UG (apH P.first.1 (apH i.1 p)) p =
    transH (LoopCalc[l].ap-ap G.space P.pair G.space i.1 P.first.1 pt pt p) (Fibres[l].ap-id G.space pt pt p) ;
  mono : ST.isMono G i = SubgroupTheory[l].injective-fibres _ _ ST.UG-set _ (\ p q h ->
    transH (symH (back p)) (transH (apH (apH P.first.1) (transH (symH (on-loops p)) (transH h (on-loops q)))) (back q))) ;
} ;
-- The second inclusion K -> G x K is a monomorphism.
module SecondInclusion (G K : CG.ConcreteGroup) {
  module P = ConcreteExamples[l].Binary[G,K] ; module ST = SubgroupTheory[l].Over[P.group] ;
  pt : K.space = K.point ; UK : U l = Id K.space pt pt ;
  i : CG.Hom K P.group = P.include-second ;
  on-loops (p : UK) : Id (Id P.pair P.base P.base) (ST.loop-map K i p) (apH i.1 p) =
    transH (DeloopMaps[l].Maps[K.space,pt,P.pair,P.base].loop-ap i p) (trans-refl-l P.pair P.base P.base (apH i.1 p)) ;
  back (p : UK) : Id UK (apH P.second.1 (apH i.1 p)) p =
    transH (LoopCalc[l].ap-ap K.space P.pair K.space i.1 P.second.1 pt pt p) (Fibres[l].ap-id K.space pt pt p) ;
  mono : ST.isMono K i = SubgroupTheory[l].injective-fibres _ _ ST.UG-set _ (\ p q h ->
    transH (symH (back p)) (transH (apH (apH P.second.1) (transH (symH (on-loops p)) (transH h (on-loops q)))) (back q))) ;
} ;
