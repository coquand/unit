-- Construction 3.8: the zero class of a cyclic grading determines it.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Z = Integers[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = FiniteCycles[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module At (n : Nat) (v : CycleComponents[l].Perm) {
  module V = CycleQuotient[l].At[n,v] ; open V ;
  module Cycle (inh : T.Trunc[X].carrier) (hit : transitive) {
    module H = Transitive[hit] ;
    Phase : U l = B.phase v ;
    phase-set : isSet Phase = Torsor[l].isSet-sub (X -> S.A) (\ f -> (y : X) -> Id S.A (f (v.2.1 y)) (S.step (f y)))
      (FL.isSet-Pi X (\ y -> S.A) (\ y -> F.fin-set m)) (B.laws v) ;
    module Zero (c : Phase) {
      module N = H.Phase[c].Map ;
      points : U l = (x : X) * Id S.A (c.1 x) none ;
      find (x : X) : points = (A.power (Z.neg (pos (S.reaches (c.1 x)).1)) x,
        transH (N.at x (Z.neg (pos (S.reaches (c.1 x)).1))) (transH
          (apH (R.power (Z.neg (pos (S.reaches (c.1 x)).1))) (symH (S.reaches (c.1 x)).2))
          (R.undo (pos (S.reaches (c.1 x)).1) none))) ;
      inhabited : T.Trunc[points].carrier = TC.map X points find inh ;
      class (a : points) : Q.Q = Q.inc a.1 ;
      same (a b : points) : Id Q.Q (class a) (class b) = Q.relates a.1 b.1 (TC.map (walk a.1 b.1) (witness a.1 b.1)
        (\ w -> (w.1,transH (apH (R.power w.1) (symH a.2))
          (transH (symH (N.at a.1 w.1)) (transH (apH c.1 w.2) b.2)),w.2)) (hit a.1 b.1)) ;
      module K = ConstantMap[l].Constant[points,Q.Q,Q.set,class,same] ;
      value : Q.Q = K.value inhabited ;
      computes : (a : points) -> Id Q.Q value (class a) = K.value-at inhabited ;
    } ;
    target : U l = condition * Q.Q ;
    classify (c : Phase) : target = (H.Phase[c].period inh,Zero[c].value) ;
    module From (d : condition) {
      normalized (x : X) : Phase = H.Origin[d,x].grading ;
      respect (x y : X) : rel x y -> Id Phase (normalized x) (normalized y) =
        TC.rec (witness x y) @l _ (phase-set _ _) (\ w -> H.ext (normalized x) (normalized y) y
          (transH (H.Origin[d,x].Target[y].computes (w.1,w.2.2)) (transH w.2.1 (symH H.Origin[d,y].zero-law)))) ;
      module Desc = Q.Descend[Phase,phase-set,normalized,respect] ;
      zero-class (q : Q.Q) : Id Q.Q (Zero[Desc.map q].value) q = Q.induction @l
        (\ r -> Id Q.Q (Zero[Desc.map r].value) r) (\ r -> Q.set _ r)
        (\ x -> Zero[Desc.map (Q.inc x)].computes (x,transH (apH (\ c -> c.1 x) (Desc.beta x)) H.Origin[d,x].zero-law)) q ;
    } ;
    rebuild (w : target) : Phase = From[w.1].Desc.map w.2 ;
    beta (w : target) : Id target (classify (rebuild w)) w =
      transH (ap condition target (\ d -> (d,(classify (rebuild w)).2)) _ _ (proposition _ w.1))
        (ap Q.Q target (\ q -> (w.1,q)) _ w.2 (From[w.1].zero-class w.2)) ;
    module Recover (c : Phase) {
      module N = From[(classify c).1] ;
      at-zero (a : Zero[c].points) : Id Phase (rebuild (classify c)) c =
        transH (apH N.Desc.map (Zero[c].computes a)) (transH (N.Desc.beta a.1)
          (H.ext (N.normalized a.1) c a.1 (transH H.Origin[(classify c).1,a.1].zero-law (symH a.2)))) ;
      eta : Id Phase (rebuild (classify c)) c = TC.rec Zero[c].points @l _ (phase-set _ _) at-zero Zero[c].inhabited ;
    } ;
    equivalence : Equiv Phase target = (classify,qinv _ _ classify rebuild beta (\ c -> Recover[c].eta)) ;
    roots : Prelude[l+].Equiv B.Over[v].roots target = Equivalences[l+].compose _ _ _ B.Over[v].grading
      (UniverseChange[l+,l].raise-equiv Phase target equivalence) ;
    module Based (d : condition) (x : X) {
      module O = H.Origin[d,x] ;
      module N = H.Phase[O.grading].Map ;
      rank (i : S.A) : Nat = CyclicHom[l,l].rank m i ;
      position (i : S.A) : Id S.A (S.iterate (rank i) none) i = B.Slice[v,O.grading].position i ;
      assign (i : S.A) : Q.Q = Q.inc (A.N.power (rank i) x) ;
      module Rotation (i : S.A) {
        module Sh = H.Phase[O.grading].Shift[i] ;
        fixed (k : Z.Int) (h : divides k) : Id S.A (R.power k i) i =
          transH (apH (R.power k) (symH (Sh.V.beta i))) (transH (symH (Sh.Natural.at none k))
            (transH (apH Sh.e.1.1 h) (Sh.V.beta i))) ;
      } ;
      respect (a b : X) : rel a b -> Id S.A (O.f a) (O.f b) = TC.rec (witness a b) @l _ (F.fin-set m _ _) (\ w ->
        symH (transH (apH O.f (symH w.2.2)) (transH (N.at a w.1) (Rotation[O.f a].fixed w.1 w.2.1)))) ;
      module Dsc = Q.Descend[S.A,F.fin-set m,O.f,respect] ;
      reads (i : S.A) : Id S.A (Dsc.map (assign i)) i = transH (Dsc.beta (A.N.power (rank i) x)) (transH
        (O.Target[A.N.power (rank i) x].computes (pos (rank i),refl (A.N.power (rank i) x))) (position i)) ;
      same-grade (a b : X) (p : Id S.A (O.f a) (O.f b)) : Id Q.Q (Q.inc a) (Q.inc b) = Q.relates a b
        (TC.map (walk a b) (witness a b) (\ w -> (w.1,H.Phase[O.grading].Shift[O.f a].fixes-zero w.1
          (transH (symH (N.at a w.1)) (transH (apH O.f w.2) (symH p))),w.2)) (hit a b)) ;
      writes (q : Q.Q) : Id Q.Q (assign (Dsc.map q)) q = Q.induction @l (\ r -> Id Q.Q (assign (Dsc.map r)) r)
        (\ r -> Q.set _ r) (\ y -> same-grade (A.N.power (rank (Dsc.map (Q.inc y))) x) y (transH (symH (Dsc.beta (A.N.power (rank (Dsc.map (Q.inc y))) x)))
          (transH (reads (Dsc.map (Q.inc y))) (Dsc.beta y)))) q ;
      quotient-enumeration : Equiv S.A Q.Q = (assign,qinv _ _ assign Dsc.map writes reads) ;
    } ;
  } ;
} ;
