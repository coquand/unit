-- Sign for any merely finite set, including degrees zero and one. No
-- identification of its torsor of orientations with Fin 2 is chosen.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module S = SignOrderings[l] ; module Two = TwoElementSets[l] ;
module F = FiniteSets[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Big = Prelude[l+] ; module BP = Paths[l+] ; module E = Equivalences[l] ;
module Cod = S.Component[Two.two] ;
module Sized (n : Nat) (A : S.Component[n].large) {
  module M = S.Component[n] ;
  finite : F.Finite A.1 = FiniteComponents[l].forget A.1 n A.2 ;
  module G = CG.Symmetric[A.1,FiniteDecisions[l].On[A.1,finite].set] ;
  size (x : G.group.space) : M.codes (G.C.extension x) = (G.C.surjective @l
    (\ z -> M.codes (G.C.extension z)) (\ z -> T.Trunc[Equiv M.X (G.C.extension z)].proposition)).sec
      (\ t -> Big.subst (U l) (\ Y -> M.codes Y) A.1 (G.C.extension (G.C.quotient t)) (BP.symH (G.C.triangle t)) A.2) x ;
  family (z : G.group.space) : M.large = (G.C.extension z,size z) ;
  base : Id M.large (family G.pt) A = Big.Sigma-eq (U l) (\ Y -> M.codes Y) _ _ _ _ (G.C.triangle tt) T.Trunc[Equiv M.X A.1].proposition ;
} ;
module Positive (n : Nat) (A : S.Component[suc (suc n)].large) {
  module G = Sized[suc (suc n),A] ; module D = S.Degree[n] ;
  W : U l = (D.classify A).1 ; module O = Two.At[W,(D.classify A).2] ;
  module At (v : D.Dom.large) {
    Y : U l = (D.classify v).1 ; arrows : U l = Equiv W Y ;
    other-base (X : U l) (e : Equiv Two.standard X) : Equiv (Equiv Two.standard Y) (Equiv X Y) =
      Axioms[l].UnivalenceLemmas[univ @l].eqind Two.standard (\ V h -> Equiv (Equiv Two.standard Y) (Equiv V Y)) (idEquiv _) X e ;
    size : Two.size arrows = TC.bind (Equiv Two.standard W) (Equiv Two.standard arrows) (\ e -> TC.map (Equiv Two.standard Y)
      (Equiv Two.standard arrows) (\ d -> E.compose _ _ _ d (E.compose _ _ _ (Bijection[l].inverse _ _ Two.At[Y,(D.classify v).2].labelled)
        (other-base W e))) (D.classify v).2) (D.classify A).2 ;
  } ;
  classifier (v : D.Dom.large) : Cod.large = (At[v].arrows,At[v].size) ;
  base-law : Id Cod.large (classifier A) Cod.base = Big.Sigma-eq (U l) (\ Y -> Cod.codes Y) _ _ _ _
    (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (Bijection[l].inverse _ _ O.automorphisms)) T.Trunc[Equiv Two.standard Two.standard].proposition ;
  map (x : G.G.group.space) : Cod.G.group.space = Cod.presentation.2.sec (classifier (G.family x)) ;
  point : Id Cod.G.group.space (map G.G.pt) Cod.G.pt = BP.transH (BP.apH Cod.presentation.2.sec
    (BP.transH (BP.apH classifier G.base) (BP.transH base-law (BP.symH Cod.pointing)))) (Big.sec-ret _ _ Cod.presentation.1 Cod.presentation.2 Cod.G.pt) ;
  hom : CG.Hom G.G.group Cod.G.group = (map,point) ;
  module Sub = ChapterTwo[l+].Subtype[U l,\ Y -> D.Dom.codes Y,\ Y -> T.Trunc[Equiv D.S.X Y].proposition] ;
  loop (e : Equiv A.1 A.1) : Id D.Dom.large A A = (Sub.At[A].paths A).2.sec (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ e) ;
  bit (e : Equiv A.1 A.1) : Bool = SignComputation[l].Sign[n].At[A].sign (loop e) ;
} ;
small (n : Nat) (A : S.Component[n].large) : CG.Hom Sized[n,A].G.group Cod.G.group = (\ x -> Cod.G.pt,refl Cod.G.pt) ;
tail : (n : Nat) (A : S.Component[suc n].large) -> CG.Hom Sized[suc n,A].G.group Cod.G.group = split {
  zero -> small (suc zero) ; suc n -> \ A -> Positive[n,A].hom } ;
hom : (n : Nat) (A : S.Component[n].large) -> CG.Hom Sized[n,A].G.group Cod.G.group = split {
  zero -> small zero ; suc n -> tail n } ;
tail-bit : (n : Nat) (A : S.Component[suc n].large) -> Equiv A.1 A.1 -> Bool = split {
  zero -> \ A e -> false ; suc n -> \ A -> Positive[n,A].bit } ;
bit : (n : Nat) (A : S.Component[n].large) -> Equiv A.1 A.1 -> Bool = split { zero -> \ A e -> false ; suc n -> tail-bit n } ;
module Any (X : U l) (fin : F.Finite X) {
  module Count = Cardinality[l].Count[X] ;
  degree : Nat = Count.cardinal fin ; labelled : S.Component[degree].large = (X,(Count.count fin).2) ;
  sign : Equiv X X -> Bool = bit degree labelled ;
  homomorphism : CG.Hom Sized[degree,labelled].G.group Cod.G.group = hom degree labelled ;
} ;

module Relative (n : Nat) (A : S.Component[suc (suc n)].large) {
  module H = Positive[n,A] ; module D = H.D ; module G = H.G ; module B0 = SignComputation[l] ;
  module PS = ProductSign[l] ; V : U l+ = D.Dom.large ; W : U l = H.W ;
  arrows : U l = Equiv W W ; module Bit = B0.Bit[W,(D.classify A).2] ; module O = Bit.A ;
  module R = B0.Bit[arrows,(H.classifier A).2] ;
  identity : arrows = idEquiv W ;
  transport (v : V) (p : Id V A v) : Id (H.At[v].arrows)
    ((B0.Move[V,\ t -> H.At[t].arrows,A].equiv v p).1 identity)
    (B0.Move[V,\ t -> (D.classify t).1,A].equiv v p) = idJ V A (\ t r -> Id (H.At[t].arrows)
      ((B0.Move[V,\ z -> H.At[z].arrows,A].equiv t r).1 identity) (B0.Move[V,\ z -> (D.classify z).1,A].equiv t r))
      (refl identity) v p ;
  different (p : Id arrows identity O.swap) : Empty = TC.rec W @l Empty isProp-Empty
    (\ x -> O.apart x (symH (apH (\ d -> d.1 x) p))) SignLaws[l].Laws[W,(D.classify A).2].inhabit ;
  tail-label : (i : FinChoice[l].Fin Two.one) -> Id Bool (R.D.diff identity (O.choose-tail i)) true =
    split { none -> R.D.apart identity O.swap different ; some z -> absurd _ z } ;
  labels : (i : Two.standard) -> Id Bool (R.D.diff identity (O.choose i)) (Two.Booleans.number i) =
    split { none -> R.D.same identity identity (refl identity) ; some i -> tail-label i } ;
  detects (e : arrows) : Id Bool (R.D.diff identity e) (Bit.value e) =
    transH (apH (R.D.diff identity) (symH (O.automorphisms.2.sec-eq e))) (labels (O.automorphisms.2.sec e)) ;
  comparison (p : Id V A A) : Id Bool (PS.Measure[V,H.classifier].value A p) (B0.Sign[n].At[A].sign p) =
    transH (R.at (B0.Move[V,\ t -> H.At[t].arrows,A].equiv A p) identity)
      (transH (apH (R.D.diff identity) (transport A p)) (detects (B0.Move[V,\ t -> (D.classify t).1,A].equiv A p))) ;
  module Small = PS.Lifted[G.G.group.space,G.G.pt,V,A,G.family,G.base,H.classifier,H.point] ;
  computes (p : Id G.G.group.space G.G.pt G.G.pt) : Id Bool (PS.Small.value Cod.G.pt ((Small.D.loop H.hom).1 p))
    (B0.Sign[n].At[A].sign (Small.at p)) = transH Small.At[p].value (comparison (Small.at p)) ;
} ;
