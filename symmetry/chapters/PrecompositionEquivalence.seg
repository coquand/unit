-- Section 6.7. Restriction along a weak equivalence is an adjoint equivalence.
level o h m n j ; open Base ; constraint o <= j ; constraint h <= j ; constraint m <= j ; constraint n <= j ;
module C0 = Category[o,h] ; module F = Functor[o,h,o,h] ;
module On (C D : C0.Precategory) (E : Category[m,n].Category) (f : F.Functor[C,D])
  (ff : F.FullyFaithful C D f) (es : F.EssSurj C D f) {
  module P = UniversalProperty[o,h,m,n,j].Theorem[C,D,E,f,ff,es] ;
  module FC = FunctorUnivalence[o,h,m,n,j] ;
  module K = EquivalenceCriteria[j,j].Between[FC.Univalence[D,E].category.pre,FC.Univalence[C,E].category.pre].At[P.Q.star] ;
  equivalence : K.adj = K.Construct[P.fully-faithful,P.split-ess-surj].result ;
} ;
