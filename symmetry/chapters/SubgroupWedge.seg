-- Exercise 5.3.31, after the free groups of Section 4.6 (GroupSums).
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ;
module SE = SubgroupExamples[l] ;
-- Exercise 5.3.31: the free group on two generators (the truncated wedge of two
-- circles) acts on 3 by the cyclic successor and the transposition of 0 and 1.
-- Powers of the first generator give an explicit choice map for (X,0).
module WedgeAction {
  module C3 = ChapterThree[l] ; module K = C3.K ; module Z = Integers[l] ;
  Zg : CG.ConcreteGroup = CG.integer-group ;
  module SG = GroupSums[l].SumGroup[Zg,Zg] ; W : CG.ConcreteGroup = SG.group ;
  module S3 = SignOrderings[l].Component[CG.three] ; Sym3 : CG.ConcreteGroup = S3.G.group ;
  rot : Equiv (Fin CG.three) (Fin CG.three) = FiniteCycles[l].rotation CG.two ;
  swap : Equiv (Fin CG.three) (Fin CG.three) = FiniteCycles[l].Exchange[Fin (suc zero)].equiv ;
  loop-of (e : Equiv (Fin CG.three) (Fin CG.three)) : Id Sym3.space Sym3.point Sym3.point = S3.G.permutations.2.sec e ;
  hom-of (e : Equiv (Fin CG.three) (Fin CG.three)) : CG.Hom Zg Sym3 = (CG.integer-hom Sym3).2.sec (loop-of e) ;
  module Uni = SG.Into[Sym3] ;
  phi : CG.Hom W Sym3 = Uni.universal.2.sec (hom-of rot,hom-of swap) ;
  module TS = SE.ThroughSymmetric[CG.three,W,phi] ;
  X : ChapterFive[l,l].Actions[W].GSet = TS.X ;
  incl (c : C3.Circle) : W.space = SG.T1.T.unit (SG.W.W.in-left c) ;
  F (c : C3.Circle) : U l = TS.ext (phi.1 (incl c)) ;
  module CP = SE.CirclePowers[F] ;
  module E3 = CircleProperty[l].Circle[Sym3.space] ;
  generators : Id (Id C3.Circle C3.base C3.base) E3.g C3.loop = Equivalences[l].injective _ _ C3.winding.1 C3.winding.2 E3.g C3.loop
    (transH (E3.band-g (refl C3.base)) (symH (CircleProperty[l].Circle[C3.Circle].band-g (refl C3.base)))) ;
  module M1 = DeloopMaps[l].Maps[C3.Circle,C3.base,Sym3.space,Sym3.point] ;
  first : Lemma4[l].PtMap C3.Circle C3.base Sym3.space Sym3.point = (\ c -> phi.1 (incl c),phi.2) ;
  first-is : Id (CG.Hom Zg Sym3) first (hom-of rot) = Big.ap _ (CG.Hom Zg Sym3) (\ w -> w.1) _ _ (Uni.universal.2.sec-eq (hom-of rot,hom-of swap)) ;
  hom-loop (e : Equiv (Fin CG.three) (Fin CG.three)) : Id (Id Sym3.space Sym3.point Sym3.point) ((M1.loop (hom-of e)).1 C3.loop) (loop-of e) =
    transH (apH (M1.loop (hom-of e)).1 (symH generators)) (transH (symH (E3.evPt-loop Sym3.point (hom-of e))) ((CG.integer-hom Sym3).2.sec-eq (loop-of e))) ;
  gen-loop : Id (Id Sym3.space Sym3.point Sym3.point) (TS.loop-map (apH incl C3.loop)) (loop-of rot) =
    transH (DeloopMaps[l].Maps[W.space,W.point,Sym3.space,Sym3.point].loop-ap phi (apH incl C3.loop))
      (transH (apH (\ r -> trans Sym3.space Sym3.point (phi.1 W.point) Sym3.point (sym Sym3.space (phi.1 W.point) Sym3.point phi.2)
          (trans Sym3.space (phi.1 W.point) (phi.1 W.point) Sym3.point r phi.2))
        (LoopCalc[l].ap-ap C3.Circle W.space Sym3.space incl phi.1 C3.base C3.base C3.loop))
        (transH (symH (M1.loop-ap first C3.loop)) (transH (apH (\ h -> (M1.loop h).1 C3.loop) first-is) (hom-loop rot)))) ;
  on-F (c : C3.Circle) (q : Id C3.Circle C3.base c) (x : F C3.base) :
    Id (F c) (subst C3.Circle F C3.base c q x) (subst W.space (\ z -> TS.ext (phi.1 z)) W.point (incl c) (apH incl q) x) =
    subst-ap C3.Circle W.space incl (\ z -> TS.ext (phi.1 z)) C3.base c q x ;
  steps (x : F C3.base) : Id (Fin CG.three) (TS.alpha.1 (CP.a.1 x)) (rot.1 (TS.alpha.1 x)) =
    transH (apH TS.alpha.1 (on-F C3.base C3.loop x)) (transH (TS.acts (apH incl C3.loop) x)
      (transH (apH (\ r -> (S3.G.permutations.1 r).1 (TS.alpha.1 x)) gen-loop) (apH (\ e -> e.1 (TS.alpha.1 x)) (S3.G.permutations.2.sec-eq rot)))) ;
  module Rot = IntegerIteration[l].Orbit[Fin CG.three,rot] ;
  module Conj = IntegerIteration[l].Map[F C3.base,Fin CG.three,CP.a,rot,TS.alpha.1,steps] ;
  zero : F C3.base = TS.alpha.2.sec none ;
  power-of (k : Z.Int) : Id W.space W.point W.point = apH incl (K.unband C3.base k) ;
  find (y : Fin CG.three) : (k : Z.Int) * Id (Fin CG.three) (Rot.power k none) y = SE.RotationLagrange[CG.two].find y ;
  choice (x : F C3.base) : (g : Id W.space W.point W.point) * Id (F C3.base) (GSets[l].Over[W].act X W.point W.point g x) zero =
    (power-of (Z.neg (find (TS.alpha.1 x)).1),Equivalences[l].injective _ _ TS.alpha.1 TS.alpha.2 _ _
      (transH (apH TS.alpha.1 (symH (on-F C3.base (K.unband C3.base (Z.neg (find (TS.alpha.1 x)).1)) x)))
        (transH (apH TS.alpha.1 (CP.power x (Z.neg (find (TS.alpha.1 x)).1)))
          (transH (Conj.at x (Z.neg (find (TS.alpha.1 x)).1))
            (transH (apH (Rot.power (Z.neg (find (TS.alpha.1 x)).1)) (symH (find (TS.alpha.1 x)).2))
              (transH (Rot.undo (find (TS.alpha.1 x)).1 none) (symH (TS.alpha.2.sec-eq none)))))))) ;
  Fp (z : W.space) : U l = TS.ext (phi.1 z) ;
  w0 : W.space = W.point ;
  subst-trans (q : Id W.space w0 w0) (z : W.space) (r : Id W.space w0 z) (x : Fp w0) :
    Id (Fp z) (subst W.space Fp w0 z (trans W.space w0 w0 z q r) x) (subst W.space Fp w0 z r (subst W.space Fp w0 w0 q x)) =
    idJ W.space w0 (\ z1 r1 -> Id (Fp z1) (subst W.space Fp w0 z1 (trans W.space w0 w0 z1 q r1) x) (subst W.space Fp w0 z1 r1 (subst W.space Fp w0 w0 q x)))
      (refl (subst W.space Fp w0 w0 q x)) z r ;
  back-sym (z : W.space) (q : Id W.space w0 z) (y : Fp w0) :
    Id (Fp w0) (subst W.space Fp z w0 (sym W.space w0 z q) (subst W.space Fp w0 z q y)) y =
    idJ W.space w0 (\ z1 q1 -> Id (Fp w0) (subst W.space Fp z1 w0 (sym W.space w0 z1 q1) (subst W.space Fp w0 z1 q1 y)) y) (refl y) z q ;
  hits (x y : Fp w0) : (p : Id W.space w0 w0) * Id (Fp w0) (subst W.space Fp w0 w0 p x) y =
    (trans W.space w0 w0 w0 (choice x).1 (sym W.space w0 w0 (choice y).1),
      transH (subst-trans (choice x).1 w0 (sym W.space w0 w0 (choice y).1) x)
        (transH (apH (subst W.space Fp w0 w0 (sym W.space w0 w0 (choice y).1)) (transH (choice x).2 (symH (choice y).2)))
          (back-sym w0 (choice y).1 y))) ;
  transitive : Subgroups[l].Over[W].Action[X].C.transitive = \ x y ->
    Truncation[l].Trunc[(p : Id W.space w0 w0) * Id (Fp w0) (subst W.space Fp w0 w0 p x) y].inc (hits x y) ;
  sub : Subgroups[l].Over[W].Sub = (X,zero,transitive) ;
  module L = SubgroupTheory[l].Over[W].Lagrange[sub] ;
  lagrange : Equiv (Id W.space w0 w0) (Fp w0 * L.A.loops) = L.construction choice ;
  equivalence : Equiv (Id W.space w0 w0) (Fin CG.three * L.A.loops) =
    Equivalences[l].compose _ _ _ lagrange (Equivalences[l].product (Fp w0) (Fin CG.three) L.A.loops TS.alpha) ;
} ;
