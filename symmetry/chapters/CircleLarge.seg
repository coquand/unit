-- Free-loop evaluation for a fixed small K(Z,1) and a larger target.
-- Adapted from CircleProperty.Circle in the Unit library; its retract lemmas are reused.
level u l ;
constraint u <= l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module G = Groupoid[l] ;
open Retracts[l] ; open Integers[u] ; open Lemma4[l] ;
module W = Whitehead[l] ;
module LC = LoopConj[l] ;

open CircleProperty[l] ;
module SmallIntegersRec (W0 : U l) (phi : Equiv W0 W0) (w : W0) {
  Steps (h : Int -> W0) : U l = (n : Int) -> Id W0 (h (sucZ n)) (phi.1 (h n)) ;
  Data (h : Int -> W0) : U l = Id W0 (h zeroZ) w * Steps h ;
  C1 : U l = (h : Int -> W0) * Data h ;

  -- the conditions, by cases on Z
  Data' (h : Int -> W0) : U l =
    Id W0 (h zeroZ) w * ((n : Nat) -> Id W0 (h (pos (suc n))) (phi.1 (h (pos n)))) *
    Id W0 (h zeroZ) (phi.1 (h (negsuc zero))) * ((m : Nat) -> Id W0 (h (negsuc m)) (phi.1 (h (negsuc (suc m))))) ;
  negE (h : Int -> W0) (c0 : Id W0 (h zeroZ) (phi.1 (h (negsuc zero)))) (cn : (m : Nat) -> Id W0 (h (negsuc m)) (phi.1 (h (negsuc (suc m))))) :
    (m : Nat) -> Id W0 (h (sucZ (negsuc m))) (phi.1 (h (negsuc m))) = split { zero -> c0 ; suc m -> cn m } ;
  allE (h : Int -> W0) (d : Data' h) : Steps h = split { pos n -> d.2.1 n ; negsuc m -> negE h d.2.2.1 d.2.2.2 m } ;
  split-d (h : Int -> W0) (d : Data h) : Data' h = (d.1, \ n -> d.2 (pos n), d.2 (negsuc zero), \ m -> d.2 (negsuc (suc m))) ;
  neg-eta (h : Int -> W0) (e : Steps h) : (m : Nat) -> Id (Id W0 (h (sucZ (negsuc m))) (phi.1 (h (negsuc m))))
      (negE h (e (negsuc zero)) (\ m1 -> e (negsuc (suc m1))) m) (e (negsuc m)) =
    split { zero -> refl (e (negsuc zero)) ; suc m -> refl (e (negsuc (suc m))) } ;
  all-eta (h : Int -> W0) (d : Data h) : (n : Int) -> Id (Id W0 (h (sucZ n)) (phi.1 (h n))) (allE h (split-d h d) n) (d.2 n) =
    split { pos n -> refl (d.2 (pos n)) ; negsuc m -> neg-eta h d.2 m } ;
  rt-data (h : Int -> W0) : Retract[Data h, Data' h] =
    new Retract[Data h, Data' h, split-d h, \ d -> (d.1, allE h d),
      \ d -> pair-eq (Id W0 (h zeroZ) w) (Steps h) d.1 d.1 (allE h (split-d h d)) d.2 (refl d.1)
                (FL.funext Int (\ n -> Id W0 (h (sucZ n)) (phi.1 (h n))) (allE h (split-d h d)) d.2 (all-eta h d))] ;

  -- functions on Z are pairs of functions on N
  NN : U l = (Nat -> W0) * (Nat -> W0) ;
  res (h : Int -> W0) : NN = (\ n -> h (pos n), \ m -> h (negsuc m)) ;
  glue (x : NN) : Int -> W0 = split { pos n -> x.1 n ; negsuc m -> x.2 m } ;
  glue-res-at (h : Int -> W0) : (n : Int) -> Id W0 (glue (res h) n) (h n) =
    split { pos n -> refl (h (pos n)) ; negsuc m -> refl (h (negsuc m)) } ;
  glue-res (h : Int -> W0) : Id (Int -> W0) (glue (res h)) h = FL.funext Int (\ n -> W0) (glue (res h)) h (glue-res-at h) ;
  res-equiv : Equiv (Int -> W0) NN = (res, qinv (Int -> W0) NN res glue (\ x -> refl x) glue-res) ;
  Phi (x : NN) : U l =
    Id W0 (x.1 zero) w * ((n : Nat) -> Id W0 (x.1 (suc n)) (phi.1 (x.1 n))) *
    Id W0 (x.1 zero) (phi.1 (x.2 zero)) * ((m : Nat) -> Id W0 (x.2 m) (phi.1 (x.2 (suc m)))) ;

  -- the negative half
  module NR = NatRec[W0, phi.1, w] ;
  B (a : NR.C0) : U l = (b : Nat -> W0) * Id W0 (a.1 zero) (phi.1 (b zero)) * ((m : Nat) -> Id W0 (b m) (phi.1 (b (suc m)))) ;
  rt-B (a : NR.C0) : Retract[B a, NatRec[W0, phi.2.sec, phi.2.sec (a.1 zero)].C0] =
    rt-Sigma (Nat -> W0) (\ b -> Id W0 (a.1 zero) (phi.1 (b zero)) * ((m : Nat) -> Id W0 (b m) (phi.1 (b (suc m)))))
      (NatRec[W0, phi.2.sec, phi.2.sec (a.1 zero)].Data)
      (\ b -> rt-prod (Id W0 (a.1 zero) (phi.1 (b zero))) ((m : Nat) -> Id W0 (b m) (phi.1 (b (suc m))))
                 (Id W0 (b zero) (phi.2.sec (a.1 zero))) ((m : Nat) -> Id W0 (b (suc m)) (phi.2.sec (b m)))
                 (equiv-rt W0 W0 phi (a.1 zero) (b zero))
                 (rt-Pi Nat (\ m -> Id W0 (b m) (phi.1 (b (suc m)))) (\ m -> Id W0 (b (suc m)) (phi.2.sec (b m)))
                    (\ m -> equiv-rt W0 W0 phi (b m) (b (suc m))))) ;
  B-contr (a : NR.C0) : isContr (B a) =
    rt-trunc zero (B a) (NatRec[W0, phi.2.sec, phi.2.sec (a.1 zero)].C0) (rt-B a) NatRec[W0, phi.2.sec, phi.2.sec (a.1 zero)].contr ;

  -- C1 <| Sigma h Data' h <| Sigma x Phi x <| Sigma a B a
  rt-split : Retract[(x : NN) * Phi x, (a : NR.C0) * B a] =
    new Retract[(x : NN) * Phi x, (a : NR.C0) * B a,
      \ v -> ((v.1.1, v.2.1, v.2.2.1), (v.1.2, v.2.2.2.1, v.2.2.2.2)),
      \ v -> ((v.1.1, v.2.1), (v.1.2.1, v.1.2.2, v.2.2.1, v.2.2.2)), \ v -> refl v] ;
  rt-C1 : Retract[C1, (a : NR.C0) * B a] =
    rt-comp C1 ((h : Int -> W0) * Data' h) ((a : NR.C0) * B a)
      (rt-Sigma (Int -> W0) Data Data' rt-data)
      (rt-comp ((h : Int -> W0) * Data' h) ((x : NN) * Phi x) ((a : NR.C0) * B a)
         (rt-base (Int -> W0) NN res-equiv Phi) rt-split) ;
  contr : isContr C1 =
    rt-trunc zero C1 ((a : NR.C0) * B a) rt-C1
      (trunc-Sigma-contr zero NR.C0 B NR.contr (B-contr NR.contr.1)) ;
} ;

module Mapping (Y : U l) {
  module Z1 = ChapterThree[u].K ;
  module Small = CircleProperty[u].Circle[Z1.K1] ;
  band-equiv : Equiv (Id Z1.K1 Z1.k0 Z1.k0) Int = (Z1.band Z1.k0,
    qinv _ _ (Z1.band Z1.k0) (Z1.unband Z1.k0) (Z1.band-unband Z1.k0) (Z1.unband-band Z1.k0)) ;
  E (F : Z1.K1 -> Y) : LY Y = (F Z1.k0, ap Z1.K1 Y F Z1.k0 Z1.k0 Small.g) ;

  module Pt (y : Y) (lp : Id Y y y) {
    Cond (k : Z1.K1) (y' : Y) (h : Id Z1.K1 Z1.k0 k -> Id Y y y') : U l =
      (p : Id Z1.K1 Z1.k0 k) -> Id (Id Y y y') (h (trans Z1.K1 Z1.k0 Z1.k0 k Small.g p)) (trans Y y y y' lp (h p)) ;
    Q (k : Z1.K1) : U l = (y' : Y) * (h : Id Z1.K1 Z1.k0 k -> Id Y y y') * Cond k y' h ;

    -- Lemma 3 at k0: through the band, Lemma 2
    phi (y' : Y) : Equiv (Id Y y y') (Id Y y y') = Fibres[l].trans-equiv Y y y y' lp ;
    pre (y' : Y) : Equiv (Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') (Int -> Id Y y y') =
      (\ h n -> h (Z1.unband Z1.k0 n),
       qinv (Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') (Int -> Id Y y y') (\ h n -> h (Z1.unband Z1.k0 n)) (\ hz p -> hz (Z1.band Z1.k0 p))
         (\ hz -> FL.funext Int (\ n -> Id Y y y') (\ n -> hz (Z1.band Z1.k0 (Z1.unband Z1.k0 n))) hz
                     (\ n -> ap Int (Id Y y y') hz (Z1.band Z1.k0 (Z1.unband Z1.k0 n)) n (Z1.band-unband Z1.k0 n)))
         (\ h -> FL.funext (Id Z1.K1 Z1.k0 Z1.k0) (\ p -> Id Y y y') (\ p -> h (Z1.unband Z1.k0 (Z1.band Z1.k0 p))) h
                     (\ p -> ap (Id Z1.K1 Z1.k0 Z1.k0) (Id Y y y') h (Z1.unband Z1.k0 (Z1.band Z1.k0 p)) p (Z1.unband-band Z1.k0 p)))) ;
    Gs (y' : Y) (hz : Int -> Id Y y y') (n : Int) : U l = Id (Id Y y y') (hz (sucZ n)) (trans Y y y y' lp (hz n)) ;
    -- moving along (*)
    tr-equiv (y' : Y) (hz : Int -> Id Y y y') (p : Id Z1.K1 Z1.k0 Z1.k0) :
      Equiv (Id (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 Small.g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p)))) (Gs y' hz (Z1.band Z1.k0 p)) =
      Fibres[l].trans-equiv (Id Y y y') (hz (sucZ (Z1.band Z1.k0 p))) (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 Small.g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p)))
        (sym (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 Small.g p))) (hz (sucZ (Z1.band Z1.k0 p)))
           (ap Int (Id Y y y') hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 Small.g p)) (sucZ (Z1.band Z1.k0 p)) (Small.band-g p))) ;
    cond-rt (y' : Y) (hz : Int -> Id Y y y') : Retract[Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p)), (n : Int) -> Gs y' hz n] =
      rt-comp (Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p))) ((p : Id Z1.K1 Z1.k0 Z1.k0) -> Gs y' hz (Z1.band Z1.k0 p)) ((n : Int) -> Gs y' hz n)
        (rt-Pi (Id Z1.K1 Z1.k0 Z1.k0)
           (\ p -> Id (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 Small.g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p))))
           (\ p -> Gs y' hz (Z1.band Z1.k0 p))
           (\ p -> rt-equiv (Id (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 Small.g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p))))
                      (Gs y' hz (Z1.band Z1.k0 p)) (tr-equiv y' hz p)))
        (pi-rt (Id Z1.K1 Z1.k0 Z1.k0) Int band-equiv (Gs y' hz)) ;
    Q0-rt : Retract[Q Z1.k0, (v : (y' : Y) * Id Y y y') * SmallIntegersRec[Id Y y v.1, phi v.1, v.2].C1] =
      rt-comp (Q Z1.k0) ((y' : Y) * (hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n)) ((v : (y' : Y) * Id Y y y') * SmallIntegersRec[Id Y y v.1, phi v.1, v.2].C1)
        (rt-Sigma Y (\ y' -> (h : Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') * Cond Z1.k0 y' h) (\ y' -> (hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n))
           (\ y' -> rt-comp ((h : Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') * Cond Z1.k0 y' h)
                      ((hz : Int -> Id Y y y') * Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p))) ((hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n))
                      (rt-base' (Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') (Int -> Id Y y y') (pre y') (Cond Z1.k0 y'))
                      (rt-Sigma (Int -> Id Y y y') (\ hz -> Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p))) (\ hz -> (n : Int) -> Gs y' hz n) (cond-rt y'))))
        (new Retract[(y' : Y) * (hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n), (v : (y' : Y) * Id Y y y') * SmallIntegersRec[Id Y y v.1, phi v.1, v.2].C1,
           \ v -> ((v.1, v.2.1 zeroZ), (v.2.1, refl (v.2.1 zeroZ), v.2.2)), \ v -> (v.1.1, v.2.1, v.2.2.2), \ v -> refl v]) ;
    Q0-contr : isContr (Q Z1.k0) =
      rt-trunc zero (Q Z1.k0) ((v : (y' : Y) * Id Y y y') * SmallIntegersRec[Id Y y v.1, phi v.1, v.2].C1) Q0-rt
        (trunc-Sigma-contr zero ((y' : Y) * Id Y y y') (\ v -> SmallIntegersRec[Id Y y v.1, phi v.1, v.2].C1) (DeloopMaps[l].singL Y y)
           SmallIntegersRec[Id Y y y, phi y, refl y].contr) ;
    -- Lemma 3
    Q-contr (k : Z1.K1) : isContr (Q k) =
      Truncation[u].Trunc[Id Z1.K1 Z1.k0 k].induction @l (\ _ -> isContr (Q k))
        (\ _ -> Torsor[l].isProp-isContr (Q k))
        (\ p -> subst Z1.K1 (\ z -> isContr (Q z)) Z1.k0 k p Q0-contr)
        ((Z1.conn1.2 Z1.k0 k).1) ;
    PiQ-contr : isContr ((k : Z1.K1) -> Q k) = FunExtUA[l].FE[univ @l].wfe Z1.K1 Q Q-contr ;

    -- Theorem 4: the fibre of E is a retract of Pi Q
    D (F : Z1.K1 -> Y) (e : Id Y y (F Z1.k0)) (k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) : U l =
      Id (Id Y y (F k)) (trans Y y (F Z1.k0) (F k) e (ap Z1.K1 Y F Z1.k0 k (trans Z1.K1 Z1.k0 Z1.k0 k Small.g p)))
        (trans Y y y (F k) lp (trans Y y (F Z1.k0) (F k) e (ap Z1.K1 Y F Z1.k0 k p))) ;
    X1 : U l = (F : Z1.K1 -> Y) * (e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0) ;
    Hm (F : Z1.K1 -> Y) : U l = (k : Z1.K1) -> Id Z1.K1 Z1.k0 k -> Id Y y (F k) ;
    CondH (F : Z1.K1 -> Y) (H : Hm F) : U l =
      (k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) -> Id (Id Y y (F k)) (H k (trans Z1.K1 Z1.k0 Z1.k0 k Small.g p)) (trans Y y y (F k) lp (H k p)) ;
    X2 : U l = (F : Z1.K1 -> Y) * (H : Hm F) * CondH F H ;
    j (F : Z1.K1 -> Y) (e : Id Y y (F Z1.k0)) : Hm F = \ k p -> trans Y y (F Z1.k0) (F k) e (ap Z1.K1 Y F Z1.k0 k p) ;
    j-ev (F : Z1.K1 -> Y) (H : Hm F) : Id (Hm F) (j F (H Z1.k0 (refl Z1.k0))) H =
      FL.funext Z1.K1 (\ k -> Id Z1.K1 Z1.k0 k -> Id Y y (F k)) (j F (H Z1.k0 (refl Z1.k0))) H (\ k ->
        FL.funext (Id Z1.K1 Z1.k0 k) (\ p -> Id Y y (F k)) (j F (H Z1.k0 (refl Z1.k0)) k) (H k) (\ p ->
          idJ Z1.K1 Z1.k0 (\ k1 p1 -> Id (Id Y y (F k1)) (j F (H Z1.k0 (refl Z1.k0)) k1 p1) (H k1 p1)) (refl (H Z1.k0 (refl Z1.k0))) k p)) ;
    j-equiv (F : Z1.K1 -> Y) : Equiv (Id Y y (F Z1.k0)) (Hm F) =
      (j F, qinv (Id Y y (F Z1.k0)) (Hm F) (j F) (\ H -> H Z1.k0 (refl Z1.k0)) (j-ev F) (\ e -> refl e)) ;
    -- (1) paths in L Y
    fib-rt : Retract[W.fib (Z1.K1 -> Y) (LY Y) E (y, lp), X1] =
      rt-Sigma (Z1.K1 -> Y) (\ F -> Id (LY Y) (E F) (y, lp)) (\ F -> (e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0))
        (\ F -> lp-rt Y (F Z1.k0) (ap Z1.K1 Y F Z1.k0 Z1.k0 Small.g) (y, lp)) ;
    -- (4), then (3)
    X1-rt : Retract[X1, X2] =
      rt-Sigma (Z1.K1 -> Y) (\ F -> (e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0)) (\ F -> (H : Hm F) * CondH F H) (\ F ->
        rt-comp ((e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0)) ((e : Id Y y (F Z1.k0)) * ((k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) -> D F e k p))
          ((H : Hm F) * CondH F H)
          (rt-Sigma (Id Y y (F Z1.k0)) (\ e -> D F e Z1.k0 (refl Z1.k0)) (\ e -> (k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) -> D F e k p)
             (\ e -> yon-rt Z1.K1 Z1.k0 (D F e)))
          (rt-base (Id Y y (F Z1.k0)) (Hm F) (j-equiv F) (CondH F))) ;
    -- (2) distributivity
    X2-rt : Retract[X2, (k : Z1.K1) -> Q k] =
      new Retract[X2, (k : Z1.K1) -> Q k, \ v k -> (v.1 k, v.2.1 k, v.2.2 k),
        \ f -> (\ k -> (f k).1, \ k -> (f k).2.1, \ k -> (f k).2.2), \ v -> refl v] ;
    fib-contr : isContr (W.fib (Z1.K1 -> Y) (LY Y) E (y, lp)) =
      rt-trunc zero (W.fib (Z1.K1 -> Y) (LY Y) E (y, lp)) ((k : Z1.K1) -> Q k)
        (rt-comp (W.fib (Z1.K1 -> Y) (LY Y) E (y, lp)) X1 ((k : Z1.K1) -> Q k) fib-rt
           (rt-comp X1 X2 ((k : Z1.K1) -> Q k) X1-rt X2-rt))
        PiQ-contr ;
  } ;

  -- Theorem 4
  E-equiv : isEquiv (Z1.K1 -> Y) (LY Y) E = W.contr-equiv (Z1.K1 -> Y) (LY Y) E (\ v -> Pt[v.1, v.2].fib-contr) ;

} ;
