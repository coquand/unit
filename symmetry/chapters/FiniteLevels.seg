-- A small finite set stays finite in a larger universe, with the same cardinal.
level u v ; constraint u <= v ; open Base ; open Prelude[v] ;
module S = FinChoice[u] ; module L = FinChoice[v] ;
module Option (A : U u) (B : U v) (e : Equiv A B) {
  up : S.Opt A -> L.Opt B = split { none -> none ; some x -> some (e.1 x) } ;
  down : L.Opt B -> S.Opt A = split { none -> none ; some y -> some (e.2.sec y) } ;
  sec : (y : L.Opt B) -> Id (L.Opt B) (up (down y)) y = split {
    none -> refl none ; some y -> ap B (L.Opt B) (\ b -> some b) _ _ (e.2.sec-eq y) } ;
  ret : (x : S.Opt A) -> Id (S.Opt A) (down (up x)) x = split {
    none -> refl none ; some x -> ap A (S.Opt A) (\ a -> some a) _ _ (sec-ret A B e.1 e.2 x) } ;
  equiv : Equiv (S.Opt A) (L.Opt B) = (up,qinv _ _ up down sec ret) ;
} ;
standard : (n : Nat) -> Equiv (S.Fin n) (L.Fin n) = split {
  zero -> idEquiv Empty ; suc n | r -> Option[S.Fin n,L.Fin n,r].equiv } ;
module At (X : U u) {
  labels (n : Nat) (d : Prelude[u].Equiv (S.Fin n) X) : Equiv (L.Fin n) X =
    Equivalences[v].compose _ _ _ (Bijection[v].inverse _ _ (standard n)) (UniverseChange[v,u].raise-equiv _ _ d) ;
  finite : FiniteSets[u].Finite X -> FiniteSets[v].Finite X =
    TruncationCombinators[u].rec ((n : Nat) * Prelude[u].Equiv (S.Fin n) X) @v _
      (Truncation[v].Trunc[(n : Nat) * Equiv (L.Fin n) X].proposition)
      (\ w -> Truncation[v].Trunc[(n : Nat) * Equiv (L.Fin n) X].inc (w.1,labels w.1 w.2)) ;
  same (f : FiniteSets[u].Finite X) : Id Nat (Cardinality[v].Count[X].cardinal (finite f)) (Cardinality[u].Count[X].cardinal f) =
    TruncationCombinators[u].rec ((n : Nat) * Prelude[u].Equiv (S.Fin n) X) @v _ (NatArith[v].nat-set _ _)
      (\ w -> Paths[v].transH (Cardinality[v].Count[X].computes (finite f) w.1 (labels w.1 w.2))
        (Paths[v].symH (Cardinality[u].Count[X].computes f w.1 w.2))) f ;
} ;
