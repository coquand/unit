-- Section 2.24. Cancel a point from a finite equivalence, then extract the
-- unique cardinal from a mere enumeration. No enumeration is chosen.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module E = Equivalences[l] ;
delete (A : U l) (x : A) : U l = (y : A) * (Id A y x -> Empty) ;
move (A B : U l) (e : Equiv A B) (x : A) : Equiv (delete A x) (delete B (e.1 x)) =
  Axioms[l].UnivalenceLemmas[univ @l].eqind A (\ C d -> Equiv (delete A x) (delete C (d.1 x)))
    (idEquiv (delete A x)) B e ;
module Option (A : U l) {
  tag : Opt A -> U l = split { none -> Empty ; some x -> Top } ;
  apart (a : A) (p : Id (Opt A) (some a) none) : Empty = subst (Opt A) tag (some a) none p tt ;
  insert (a : A) : delete (Opt A) none = (some a,apart a) ;
  remove : (z : Opt A) -> (Id (Opt A) z none -> Empty) -> A = split {
    none -> \ h -> absurd A (h (refl none)) ; some a -> \ h -> a } ;
  compute : (z : Opt A) (h : Id (Opt A) z none -> Empty) ->
    Id (delete (Opt A) none) (insert (remove z h)) (z,h) = split {
    none -> \ h -> absurd (Id (delete (Opt A) none) (insert (remove none h)) (none,h)) (h (refl none)) ;
    some a -> \ h -> Sigma-eq (Opt A) (\ z -> Id (Opt A) z none -> Empty) _ _ _ _ (refl (some a))
      (Logic[l].not-prop (Id (Opt A) (some a) none)) } ;
  equiv : Equiv A (delete (Opt A) none) = (insert,qinv _ _ insert (\ v -> remove v.1 v.2)
    (\ v -> compute v.1 v.2) (\ a -> refl a)) ;
} ;
module Puncture (n : Nat) (x : Fin (suc n)) {
  module S = FiniteCycles[l].Centralizer[n] ;
  turn : Equiv (Fin (suc n)) (Fin (suc n)) = (S.shift x).1 ;
  equiv : Equiv (Fin n) (delete (Fin (suc n)) x) =
    subst (Fin (suc n)) (\ a -> Equiv (Fin n) (delete (Fin (suc n)) a)) (turn.1 none) x (S.beta x)
      (E.compose _ _ _ Option[Fin n].equiv (move _ _ turn none)) ;
} ;
cancel (n m : Nat) (e : Equiv (Fin (suc n)) (Fin (suc m))) : Equiv (Fin n) (Fin m) =
  E.compose _ _ _ Option[Fin n].equiv (E.compose _ _ _ (move _ _ e none)
    (Bijection[l].inverse _ _ Puncture[m,e.1 none].equiv)) ;
unique : (n m : Nat) -> Equiv (Fin n) (Fin m) -> Id Nat n m = split {
  zero -> split { zero -> \ e -> refl zero ; suc m -> \ e -> absurd (Id Nat zero (suc m)) (e.2.sec none) } ;
  suc n | r -> split { zero -> \ e -> absurd (Id Nat (suc n) zero) (e.1 none) ;
    suc m -> \ e -> apH (\ k -> suc k) (r m (cancel n m e)) } } ;
module Count (A : U l) {
  size (n : Nat) : U l = T.Trunc[Equiv (Fin n) A].carrier ;
  cardinals : U l = (n : Nat) * size n ;
  only (n m : Nat) : size n -> size m -> Id Nat n m = \ u v ->
    TC.rec (Equiv (Fin n) A) @l _ (NatArith[l].nat-set n m) (\ e ->
      TC.rec (Equiv (Fin m) A) @l _ (NatArith[l].nat-set n m) (\ d ->
        unique n m (E.compose _ _ _ e (Bijection[l].inverse _ _ d))) v) u ;
  proposition : isProp cardinals = \ u v -> Sigma-eq Nat size _ _ _ _
    (only u.1 v.1 u.2 v.2) T.Trunc[Equiv (Fin v.1) A].proposition ;
  count : FiniteSets[l].Finite A -> cardinals = TC.rec ((n : Nat) * Equiv (Fin n) A) @l cardinals proposition
    (\ w -> (w.1,T.Trunc[Equiv (Fin w.1) A].inc w.2)) ;
  cardinal (finite : FiniteSets[l].Finite A) : Nat = (count finite).1 ;
  computes (finite : FiniteSets[l].Finite A) (n : Nat) (e : Equiv (Fin n) A) : Id Nat (cardinal finite) n =
    only _ n (count finite).2 (T.Trunc[Equiv (Fin n) A].inc e) ;
} ;
