-- Section 6.4. Representable functors into types for a wild source.
level o h ; open Base ; open Prelude[h] ; open Paths[h] ;
module W = WildCategory[o,h] ; module F = WildFunctors[o,h,h+,h] ; module T = CategoryOfTypes[h] ;
module L = Axioms[h].FunExtLemmas[fe @h] ;
module From (C : W.Wild) (a : C.ob) {
  covariant : F.Map[C,T.types] = new F.Map[C,T.types,C.hom a,(\ x y g k -> C.comp a x y g k),
    (\ x -> L.funext (C.hom a x) (\ k -> C.hom a x) _ _ (C.unit-l _ _)),
    (\ x y z g f -> L.funext (C.hom a x) (\ k -> C.hom a z) _ _ (\ k -> symH (C.assoc a x y z k f g)))] ;
} ;
module At (C : W.Wild) (a : C.ob) {
  contra : F.Map[W.op C,T.types] = From[W.op C,a].covariant ;
} ;
