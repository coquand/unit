-- Relate the small concrete kernel to even permutations in the universe presentation.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module BP = Paths[l+] ; module BE = Equivalences[l+] ; module E = Equivalences[l] ;
module LC = LoopConj[l+] ; module H = HLevels[l+] ; module B = Bijection[l+] ;
module PathsOf (X Y : U l+) (e : Big.Equiv X Y) (x : X) {
  ap (y : X) : Big.Equiv (Id X x y) (Id Y (e.1 x) (e.1 y)) = (Big.ap X Y e.1 x y,FibreLevels[l+].Of[X,Y,e.1].reflect
    (\ z -> H.contr-prop _ (FibrewiseEquivalence[l+].fibers X Y e z)) x y) ;
} ;
compose (X Y Z : U l+) (f : X -> Y) (g : Y -> Z) (x y : X) (p : Id X x y) :
  Id (Id Z (g (f x)) (g (f y))) (BP.apH (\ t -> g (f t)) p) (BP.apH g (BP.apH f p)) =
  idJ X x (\ t r -> Id (Id Z (g (f x)) (g (f t))) (Big.ap X Z (\ w -> g (f w)) x t r)
    (Big.ap Y Z g (f x) (f t) (Big.ap X Y f x t r))) (refl (refl (g (f x)))) y p ;
module At (n : Nat) {
  module L = EvenPermutations[l].Labeled[n] ; module S = L.S ; module K = L.K ; module D = K.D ;
  module Alt = SignOrderings[l].Alternating[n] ; module A = D.Dom ; module Y = D.Cod ;
  module DP = PathsOf[A.G.group.space,K.V,A.presentation,A.G.pt] ;
  module Lift = BicycleGroups[l].Based[A.G.group.space,A.G.pt,K.V,K.A,A.presentation.1,A.pointing,(DP.ap A.G.pt).2] ;
  labels : Equiv (Id A.G.group.space A.G.pt A.G.pt) L.aut = Truncations[l].lower _ _ (BE.compose _ _ _ Lift.loops L.code) ;
  module AtBase (q : S.loops) {
    module C = ChapterTwo[l+].Subtype[U l,\ V -> Y.codes V,\ V -> Truncation[l].Trunc[Equiv TwoElementSets[l].standard V].proposition] ;
    cls : Id Y.large (D.classify K.A) (D.classify K.A) = BP.apH D.classify q ;
    decode : Big.Equiv (Id Y.large (D.classify K.A) (D.classify K.A)) (Equiv S.W S.W) =
      BE.compose _ _ _ (C.At[D.classify K.A].paths (D.classify K.A)) (Axioms[l].idtoeqv S.W S.W,univ @l S.W S.W) ;
    acts (v : K.V) (p : Id K.V K.A v) : Id (Equiv S.W (K.S.O.orientation v))
      (Axioms[l].idtoeqv S.W (K.S.O.orientation v) (Big.ap Y.large (U l) (\ w -> w.1) (D.classify K.A) (D.classify v)
        (Big.ap K.V Y.large D.classify K.A v p))) (S.Move.equiv v p) =
      idJ K.V K.A (\ t r -> Id (Equiv S.W (K.S.O.orientation t))
        (Axioms[l].idtoeqv S.W (K.S.O.orientation t) (Big.ap Y.large (U l) (\ w -> w.1) (D.classify K.A) (D.classify t)
          (Big.ap K.V Y.large D.classify K.A t r))) (S.Move.equiv t r)) (refl (idEquiv S.W)) v p ;
    unit : U l+ = Id (Id Y.large (D.classify K.A) (D.classify K.A)) cls (refl (D.classify K.A)) ;
    to (h : unit) : Id Bool (S.E.sign q) false = transH (apH S.L.V.value (symH (acts K.A q)))
      (transH (BP.apH (\ z -> S.L.V.value (decode.1 z)) h) S.L.unit) ;
    label-zero : (v : TwoElementSets[l].standard) -> Id Bool (TwoElementSets[l].Booleans.number v) false -> Id TwoElementSets[l].standard v none =
      split { none -> \ p -> refl none ; some j -> \ p -> absurd _ (TruthValues[l].separate p) } ;
    from (h : Id Bool (S.E.sign q) false) : unit = BE.injective _ _ decode.1 decode.2 _ _
      (transH (acts K.A q) (transH (symH (S.L.V.A.automorphisms.2.sec-eq (S.Move.equiv K.A q)))
        (apH S.L.V.A.choose (label-zero (S.L.V.A.automorphisms.2.sec (S.Move.equiv K.A q)) h)))) ;
  } ;
  module Loop (p : Id A.G.group.space A.G.pt A.G.pt) {
    q : S.loops = Lift.loops.1 p ; module R = AtBase[q] ;
    k : Id K.V (A.presentation.1 A.G.pt) (A.presentation.1 A.G.pt) = Lift.raw.1 p ;
    f (x : A.G.group.space) : Y.large = D.classify (A.presentation.1 x) ;
    m : Id Y.large (f A.G.pt) (f A.G.pt) = BP.apH f p ;
    t : Id Y.large (f A.G.pt) (D.classify K.A) = BP.apH D.classify A.pointing ;
    raw : U l+ = Id (Id Y.large (f A.G.pt) (f A.G.pt)) m (refl (f A.G.pt)) ;
    natural : Id (Id Y.large (D.classify K.A) (D.classify K.A)) R.cls (LC.conj Y.large _ _ t m) =
      BP.transH (PointedComponent[l+].Conjugation[K.V,Y.large,D.classify,A.presentation.1 A.G.pt,k].natural K.A A.pointing)
        (BP.apH (LC.conj Y.large _ _ t) (BP.symH (compose _ _ _ A.presentation.1 D.classify A.G.pt A.G.pt p))) ;
    to-base (h : raw) : R.unit = BP.transH natural (BP.transH (BP.apH (LC.conj Y.large _ _ t) h) (LC.conj-refl Y.large _ _ t)) ;
    from-base (h : R.unit) : raw = BP.transH (BP.symH (LC.conj-back Y.large _ _ t m)) (BP.transH
      (BP.apH (LC.conj Y.large _ _ (BP.symH t)) (BP.transH (BP.symH natural) h)) (LC.conj-refl Y.large _ _ (BP.symH t))) ;
    module CY = PathsOf[Y.large,Y.G.group.space,B.inverse _ _ Y.presentation,f A.G.pt] ;
    law : Id (Id Y.G.group.space (D.map A.G.pt) (D.map A.G.pt)) (Alt.L.raw p) ((CY.ap (f A.G.pt)).1 m) =
      compose _ _ _ f Y.presentation.2.sec A.G.pt A.G.pt p ;
    up (h : D.even p) : raw = BE.injective _ _ (CY.ap (f A.G.pt)).1 (CY.ap (f A.G.pt)).2 m (refl (f A.G.pt))
      (BP.transH (BP.symH law) (Alt.Raw[p].from h)) ;
    down (h : raw) : D.even p = Alt.Raw[p].to (BP.transH law (BP.apH (CY.ap (f A.G.pt)).1 h)) ;
    loop-law : Id S.loops (L.loop (labels.1 p)) q = Big.sec-ret _ _ L.code.1 L.code.2 q ;
    forward (h : D.even p) : Id Bool (L.sign (labels.1 p)) false =
      transH (BP.apH S.E.sign loop-law) (R.to (to-base (up h))) ;
    backward (h : Id Bool (L.sign (labels.1 p)) false) : D.even p =
      down (from-base (R.from (transH (BP.symH (BP.apH S.E.sign loop-law)) h))) ;
    equiv : Equiv (D.even p) (Id Bool (L.sign (labels.1 p)) false) = Bijection[l].prop-equiv _ _
      (ChapterFour[l].Symmetries[Y.G.group].abstract.setG _ _) (Z2[l].bool-set _ _) forward backward ;
  } ;
  evens : Equiv (ChapterFour[l].Symmetries[Alt.group].carrier) (L.part false) = E.compose _ _ _ Alt.symmetries
    (E.compose _ _ _ (Fibres[l].sigma-equiv _ D.even (\ p -> Id Bool (L.sign (labels.1 p)) false) (\ p -> Loop[p].equiv))
       (ChapterTwo[l].change-base _ _ labels (\ e -> Id Bool (L.sign e) false))) ;
  module Size = FiniteArithmetic[l].Change[L.part false,ChapterFour[l].Symmetries[Alt.group].carrier,Bijection[l].inverse _ _ evens] ;
  finite : FiniteSets[l].Finite (ChapterFour[l].Symmetries[Alt.group].carrier) = Size.finite (L.finite false) ;
  cardinal : Nat = Cardinality[l].Count[ChapterFour[l].Symmetries[Alt.group].carrier].cardinal finite ;
  half-factorial : Id Nat (NatArith[l].plus cardinal cardinal) (PermutationCount[l].factorial K.D.S.N) =
    transH (apH (\ m -> NatArith[l].plus m m) (symH (Size.same (L.finite false) finite))) L.twice-even ;
} ;

module Action (n : Nat) {
  module A = At[n] ; module D = A.D ; module K = A.K ; module Y = A.Y ; module Alt = A.Alt ;
  module G = ChapterFour[l].Symmetries[Alt.group] ; module LG = ChapterFour[l].Symmetries[D.Dom.G.group] ;
  X : U l = K.X ; module L = A.L ; module P = A.Lift ;
  label (p : G.carrier) : L.aut = (A.evens.1 p).1 ;
  fibre-fst (z : Alt.fibre) (q : Id Alt.fibre Alt.base z) : Id (Id D.Dom.G.group.space D.Dom.G.pt z.1)
    (sPath D.Dom.G.group.space (\ x -> Id Y.G.group.space (D.map x) Alt.a) Alt.base z q).1
    (ap Alt.fibre D.Dom.G.group.space (\ w -> w.1) Alt.base z q) =
    idJ Alt.fibre Alt.base (\ v r -> Id (Id D.Dom.G.group.space D.Dom.G.pt v.1)
      (sPath D.Dom.G.group.space (\ x -> Id Y.G.group.space (D.map x) Alt.a) Alt.base v r).1
      (ap Alt.fibre D.Dom.G.group.space (\ w -> w.1) Alt.base v r)) (refl (refl D.Dom.G.pt)) z q ;
  restrict (p : G.carrier) : LG.carrier = apH Alt.inclusion.1 p ;
  proj (p : G.carrier) : Id LG.carrier (Alt.symmetries.1 p).1 (restrict p) = transH
    (fibre-fst Alt.base (Alt.Kernel.symmetries.1 p)) (BP.symH (compose Alt.group.space Alt.fibre D.Dom.G.group.space
      (\ w -> w.1) (\ w -> w.1) Alt.group.point Alt.group.point p)) ;
  view (p : G.carrier) (x : X) : Id X ((label p).1 x) ((K.image K.A (P.loops.1 (restrict p))).1 x) =
    transH (apH (\ t -> (A.labels.1 t).1 x) (proj p)) (L.act K.A (P.loops.1 (restrict p)) x) ;
  mul (p q : G.carrier) (x : X) : Id X ((label (G.abstract.mul p q)).1 x) ((label p).1 ((label q).1 x)) =
    transH (view (G.abstract.mul p q) x) (transH (BP.apH (\ v -> (K.image K.A (P.loops.1 v)).1 x)
      (Groupoid[l].ap-trans Alt.group.space D.Dom.G.group.space Alt.inclusion.1 Alt.group.point Alt.group.point Alt.group.point q p))
      (transH (BP.apH (\ v -> (K.image K.A v).1 x) (P.mul (restrict p) (restrict q)))
        (transH (L.move-comp K.A (P.loops.1 (restrict q)) K.A (P.loops.1 (restrict p)) x)
          (transH (symH (view p ((K.image K.A (P.loops.1 (restrict q))).1 x))) (apH (label p).1 (symH (view q x))))))) ;
  faithful (p q : G.carrier) (h : Id L.aut (label p) (label q)) : Id G.carrier p q =
    E.injective _ _ A.evens.1 A.evens.2 _ _ (Sigma-eq L.aut (\ e -> Id Bool (L.sign e) false) _ _ _ _ h (Z2[l].bool-set _ _)) ;
} ;
