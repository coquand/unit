-- Sections 2.13 and 2.24. A two-element set has a canonical swap but
-- choosing an enumeration uniformly would produce a point fixed by swap.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ; open Logic[l] ;
module B = Prelude[l+] ; module BP = Paths[l+] ; module C = Cardinality[l] ; module F = FiniteSets[l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module FU = FunExtUA[l] ;
one : Nat = suc zero ; two : Nat = suc one ; standard : U l = Fin two ;
module S = FiniteCycles[l].Centralizer[one] ;
size (X : U l) : U l = T.Trunc[Equiv standard X].carrier ;
punctured (X : U l) : U l = (x : X) -> FU.isContr (C.delete X x) ;
one-contr : FU.isContr (Fin one) = (none,FiniteSubsets[l].Proposition[Top,isTop].at-zero) ;
standard-contr (x : standard) : FU.isContr (C.delete standard x) =
  HLevels[l].equiv-trunc' zero _ _ C.Puncture[one,x].equiv one-contr ;
module At (X : U l) (h : size X) {
  finite : F.Finite X = TC.map (Equiv standard X) ((n : Nat) * Equiv (Fin n) X) (\ e -> (two,e)) h ;
  module D = FiniteDecisions[l].On[X,finite] ;
  holes : punctured X = TC.rec (Equiv standard X) @l (punctured X)
    (FL.isProp-Pi X (\ x -> FU.isContr (C.delete X x)) (\ x -> Torsor[l].isProp-isContr (C.delete X x)))
    (\ e -> UA.eqind standard (\ Y d -> punctured Y) standard-contr X e) h ;
  other (x : X) : X = (holes x).1.1 ;
  apart (x : X) : Id X (other x) x -> Empty = (holes x).1.2 ;
  only (x y : X) (ne : Id X y x -> Empty) : Id X (other x) y =
    ap (C.delete X x) X (\ v -> v.1) _ _ ((holes x).2 (y,ne)) ;
  twice (x : X) : Id X (other (other x)) x = only (other x) x (\ p -> apart x (symH p)) ;
  swap : Equiv X X = (other,qinv _ _ other other twice twice) ;
  module Ext (Y : U l) (e d : Equiv Y X) (x : Y) (at-x : Id X (e.1 x) (d.1 x))
    (decide : FiniteDecisions[l].Discrete Y) {
    at-y (y : Y) : Dec (Id Y y x) -> Id X (e.1 y) (d.1 y) = split {
      yes p -> transH (apH e.1 p) (transH at-x (symH (apH d.1 p))) ;
      no ne -> transH (symH (only (e.1 x) (e.1 y) (\ p -> ne (Equivalences[l].injective _ _ e.1 e.2 y x p))))
        (only (e.1 x) (d.1 y) (\ p -> ne (Equivalences[l].injective _ _ d.1 d.2 y x (transH p at-x)))) } ;
    equal : Id (Equiv Y X) e d = ChapterTwo[l].equiv-ext Y X e d (\ y -> at-y y (decide y x)) ;
  } ;
  labels : U l = Equiv standard X ;
  eval (e : labels) : X = e.1 none ;
  module Enumerated (e : labels) {
    label (x : X) : labels = Equivalences[l].compose _ _ _ (S.shift (e.2.sec x)).1 e ;
    beta (x : X) : Id X (eval (label x)) x = transH (apH e.1 (S.beta (e.2.sec x))) (e.2.sec-eq x) ;
    is-equiv : isEquiv labels X eval = qinv _ _ eval label beta
      (\ d -> Ext[standard,label (eval d),d,none,beta (eval d),FiniteDecisions[l].standard two].equal) ;
  } ;
  labelled : Equiv labels X = (eval,TC.rec labels @l _ (EquivProp[l].isEquiv-prop labels X eval) (\ e -> Enumerated[e].is-equiv) h) ;
  permutations : U l = Equiv X X ;
  choose-tail : Fin one -> permutations = split { none -> swap ; some i -> absurd permutations i } ;
  choose : standard -> permutations = split { none -> idEquiv X ; some i -> choose-tail i } ;
  module Point (x : X) {
    classify (e : permutations) : Dec (Id X (e.1 x) x) -> standard = split { yes p -> none ; no k -> some none } ;
    classify-law (e : permutations) : (d : Dec (Id X (e.1 x) x)) -> Id X ((choose (classify e d)).1 x) (e.1 x) =
      split { yes p -> symH p ; no k -> only x (e.1 x) k } ;
    code (e : permutations) : standard = classify e (D.discrete (e.1 x) x) ;
    sec (e : permutations) : Id permutations (choose (code e)) e =
      Ext[X,choose (code e),e,x,classify-law e (D.discrete (e.1 x) x),D.discrete].equal ;
    zero-law : (d : Dec (Id X x x)) -> Id standard (classify (idEquiv X) d) none =
      split { yes p -> refl none ; no k -> absurd _ (k (refl x)) } ;
    one-law : (d : Dec (Id X (other x) x)) -> Id standard (classify swap d) (some none) =
      split { yes p -> absurd _ (apart x p) ; no k -> refl (some none) } ;
    tail-law : (i : Fin one) -> Id standard (code (choose-tail i)) (some i) =
      split { none -> one-law (D.discrete (other x) x) ; some j -> absurd _ j } ;
    ret : (i : standard) -> Id standard (code (choose i)) i = split { none -> zero-law (D.discrete x x) ; some i -> tail-law i } ;
    is-equiv : isEquiv standard permutations choose = qinv _ _ choose code sec ret ;
  } ;
  automorphisms : Equiv standard permutations = (choose,TC.rec labels @l _ (EquivProp[l].isEquiv-prop standard permutations choose)
    (\ e -> Point[e.1 none].is-equiv) h) ;
  loops : B.Equiv (Id (U l) X X) standard = Equivalences[l+].compose _ _ _
    (Axioms[l].idtoeqv X X,univ @l X X) (UniverseChange[l+,l].raise-equiv _ _ (Bijection[l].inverse _ _ automorphisms)) ;
  path-labels : B.Equiv (Id (U l) standard X) X = Equivalences[l+].compose _ _ _
    (Axioms[l].idtoeqv standard X,univ @l standard X) (UniverseChange[l+,l].raise-equiv _ _ labelled) ;
  loop-identification : Id (U l+) (Id (U l) X X) standard =
    Axioms[l+].UnivalenceLemmas[univ @(l+)].ua _ _ loops ;
  label-identification : Id (U l+) X (Id (U l) standard X) =
    Axioms[l+].UnivalenceLemmas[univ @(l+)].ua _ _ (Bijection[l+].inverse _ _ path-labels) ;
} ;
component : U l+ = (X : U l) * size X ;
base : component = (standard,T.Trunc[Equiv standard standard].inc (idEquiv standard)) ;
module SBase = At[standard,base.2] ;
module Sub = ChapterTwo[l+].Subtype[U l,\ X -> size X,\ X -> T.Trunc[Equiv standard X].proposition] ;
module NoChoice (s : (w : component) -> w.1) {
  loop : Id component base base = (Sub.At[base].paths base).2.sec (UA.ua standard standard SBase.swap) ;
  decoded : Id (Id (U l) standard standard) ((Sub.At[base].paths base).1 loop) (UA.ua standard standard SBase.swap) =
    (Sub.At[base].paths base).2.sec-eq _ ;
  natural (v : component) (p : Id component base v) : Id v.1
    (coe standard v.1 (B.ap component (U l) (\ w -> w.1) base v p) (s base)) (s v) =
    idJ component base (\ w q -> Id w.1 (coe standard w.1 (B.ap component (U l) (\ t -> t.1) base w q) (s base)) (s w))
      (refl (s base)) v p ;
  impossible : Empty = SBase.apart (s base) (transH (symH (UA.ua-beta standard standard SBase.swap (s base)))
    (transH (BP.apH (\ p -> coe standard standard p (s base)) (BP.symH decoded)) (natural base loop))) ;
} ;
no-uniform-label (e : (w : component) -> Id (U l) w.1 standard) : Empty =
  NoChoice[\ w -> coe standard w.1 (B.sym _ _ _ (e w)) none].impossible ;
module Booleans {
  singleton : Equiv (Fin one) Top = ((\ i -> tt),qinv _ _ (\ i -> tt) (\ t -> none) (isTop tt) one-contr.2) ;
  number : standard -> Bool = split { none -> false ; some i -> true } ;
  index : Bool -> standard = split { false -> none ; true -> some none } ;
  beta : (b : Bool) -> Id Bool (number (index b)) b = split { true -> refl true ; false -> refl false } ;
  eta : (i : standard) -> Id standard (index (number i)) i = split {
    none -> refl none ; some i -> ap (Fin one) standard (\ z -> some z) none i (one-contr.2 i) } ;
  labels : Equiv standard Bool = (number,qinv _ _ number index beta eta) ;
  module P = At[Bool,T.Trunc[Equiv standard Bool].inc labels] ;
  loop : U l+ = Id (U l) Bool Bool ;
  loops : B.Equiv loop Bool = Equivalences[l+].compose _ _ _ P.loops (UniverseChange[l+,l].raise-equiv _ _ labels) ;
  flip : Equiv Bool Bool = (not,qinv _ _ not not Z2[l].not-not Z2[l].not-not) ;
  swap : loop = UA.ua Bool Bool flip ;
  eval (p : loop) : Bool = coe Bool Bool p false ;
  distinguish (p q : loop) (h : Id Bool (eval p) (eval q)) : Id loop p q = Equivalences[l+].injective _ _
    (Axioms[l].idtoeqv Bool Bool) (univ @l Bool Bool) p q
    P.Ext[Bool,Axioms[l].idtoeqv Bool Bool p,Axioms[l].idtoeqv Bool Bool q,false,
      transH (UA.fst-idtoeqv Bool Bool p false) (transH h (symH (UA.fst-idtoeqv Bool Bool q false))),P.D.discrete].equal ;
  label : Bool -> loop = split { false -> refl Bool ; true -> swap } ;
  computes : (b : Bool) -> Id Bool (eval (label b)) b = split { false -> refl false ; true -> UA.ua-beta Bool Bool flip false } ;
  classification : B.Equiv loop Bool = (eval,B.qinv _ _ eval label computes (\ p -> distinguish _ p (computes (eval p)))) ;
  along (Y : U l) (p : Id (U l) Bool Y) (Z : U l) (q : Id (U l) Y Z) : Id Z (coe Bool Z (BP.transH p q) false)
    (coe Y Z q (coe Bool Y p false)) = idJ (U l) Y (\ V r -> Id V (coe Bool V (BP.transH p r) false) (coe Y V r (coe Bool Y p false)))
      (refl (coe Bool Y p false)) Z q ;
  square : Id loop (BP.transH swap swap) (refl Bool) = distinguish _ _ (transH (along Bool swap Bool swap)
    (transH (apH (coe Bool Bool swap) (UA.ua-beta Bool Bool flip false)) (UA.ua-beta Bool Bool flip true))) ;
  -- Exercise 2.17.3. The fibre of the point Bool in Set contains two unequal loops.
  sets : U l+ = (X : U l) * isSet X ;
  point : sets = (Bool,Z2[l].bool-set) ;
  module ST = ChapterTwo[l+].Subtype[U l,\ X -> isSet X,\ X -> Torsor[l].isProp-isSet X] ;
  paths : B.Equiv (Id sets point point) loop = ST.At[point].paths point ;
  fibre : U l+ = (t : Top) * Id sets point point ;
  not-embedding (h : B.isProp fibre) : Empty = TruthValues[l].separate (BP.transH
    (BP.symH (computes true)) (BP.apH eval (BP.transH (BP.symH (paths.2.sec-eq swap))
      (BP.transH (BP.apH (\ w -> paths.1 w.2) (h (tt,paths.2.sec swap) (tt,paths.2.sec (refl Bool)))) (paths.2.sec-eq (refl Bool)))))) ;
} ;
