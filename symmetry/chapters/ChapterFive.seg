-- Sections 5.2--5.4. Independent levels for the group and its action.
level l k ;
open Base ; open Prelude[l \/ k] ;
module Actions (G : ChapterFour[l].ConcreteGroup) {
  SetAt : U k+ = (A : U k) * Prelude[k].isSet A ;
  GSet : U (l \/ k+) = G.space -> SetAt ;
  module On (X : GSet) {
    family (z : G.space) : U k = (X z).1 ;
    carrier : U k = family G.point ;
    act (g : Id G.space G.point G.point) : carrier -> carrier =
      subst G.space (\ z -> family z) G.point G.point g ;
    total : U (l \/ k) = (z : G.space) * family z ;
    orbits : U (l \/ k) = ChapterTwo[l \/ k].Truncate[suc zero,total].carrier ;
    orbit (x : carrier) : orbits = ChapterTwo[l \/ k].Truncate[suc zero,total].unit (G.point,x) ;
    stabilizes (g : Id G.space G.point G.point) (x : carrier) : U k = Id carrier (act g x) x ;
    stabilizes-prop (g : Id G.space G.point G.point) (x : carrier) : Prelude[k].isProp (stabilizes g x) =
      (X G.point).2 (act g x) x ;
  } ;
} ;

-- Section 5.4. Maps out of orbits correspond to invariant maps to a set,
-- expressed as fibrewise maps to its constant family.
module Invariants (G : ChapterFour[l].ConcreteGroup) (X : Actions[G].GSet)
  (Y : U (l \/ k)) (setY : isSet Y) {
  module A = Actions[G].On[X] ;
  module T = ChapterTwo[l \/ k].Truncate[suc zero,A.total] ;
  module R = T.Into[\ z -> Y,\ z -> HLevels[l \/ k].set-trunc Y setY] ;
  invariant : U (l \/ k) = (z : G.space) -> A.family z -> Y ;
  curry (f : A.total -> Y) (z : G.space) (x : A.family z) : Y = f (z,x) ;
  uncurry (h : invariant) (w : A.total) : Y = h w.1 w.2 ;
  factors : Equiv (A.orbits -> Y) invariant = Equivalences[l \/ k].compose
    (A.orbits -> Y) (A.total -> Y) invariant (R.E.precomp,R.E.equiv)
    (curry,qinv (A.total -> Y) invariant curry uncurry (\ h -> refl h) (\ f -> refl f)) ;
} ;

-- The principal action consists of paths out of the point. Its total space
-- is contractible, and evaluation of an equivariant family map at refl is
-- the dependent Yoneda equivalence. This gives Cayley's faithful action.
module Principal (G : ChapterFour[l].ConcreteGroup) {
  carrier (z : G.space) : U l = Id G.space G.point z ;
  set (z : G.space) : Prelude[l].isSet (carrier z) = HLevels[l].trunc-set _ (G.groupoid G.point z) ;
  action : G.space -> (A : U l) * Prelude[l].isSet A = \ z -> (carrier z,set z) ;
  total-contractible : FunExtUA[l].isContr ((z : G.space) * carrier z) = DeloopMaps[l].singL G.space G.point ;
  module Evaluation (F : G.space -> U k) {
    transformations : U (l \/ k) = (z : G.space) -> carrier z -> F z ;
    evaluate (h : transformations) : F G.point = h G.point (refl G.point) ;
    represent (u : F G.point) (z : G.space) (p : carrier z) : F z =
      subst G.space (\ y -> F y) G.point z p u ;
    computes (h : transformations) (z : G.space) (p : carrier z) :
      Id (F z) (represent (evaluate h) z p) (h z p) =
      idJ G.space G.point (\ y q -> Id (F y) (represent (evaluate h) y q) (h y q))
        (refl (evaluate h)) z p ;
    module FL = Axioms[l \/ k].FunExtLemmas[fe @(l \/ k)] ;
    yoneda : Equiv transformations (F G.point) = (evaluate,qinv _ _ evaluate represent (\ u -> refl u)
      (\ h -> FL.funext G.space (\ z -> carrier z -> F z) _ _ (\ z ->
        FL.funext (carrier z) (\ p -> F z) _ _ (computes h z)))) ;
  } ;
} ;
