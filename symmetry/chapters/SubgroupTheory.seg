-- Section 5.3. Subgroups form a set, monomorphisms, and the Lagrange
-- decomposition of the symmetries of G along a subgroup.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module HL = HLevels[l] ; module W = Whitehead[l] ; module E = Equivalences[l] ;
-- An injective map into a set has propositional fibres.
injective-fibres (A B : U l) (sB : isSet B) (f : A -> B) (inj : (a a' : A) -> Id B (f a) (f a') -> Id A a a') (b : B) :
  isProp (W.fib A B f b) = \ u v -> Sigma-eq A (\ a -> Id B (f a) b) _ _ _ _ (inj u.1 v.1 (transH u.2 (symH v.2))) (sB _ b) ;
-- Postconcatenation with a path.
post-equiv (A : U l) (x y z : A) (r : Id A y z) : Equiv (Id A x y) (Id A x z) =
  (\ q -> trans A x y z q r,qinv _ _ (\ q -> trans A x y z q r) (\ s -> trans A x z y s (sym A y z r))
    (idJ A y (\ c r1 -> (s : Id A x c) -> Id (Id A x c) (trans A x y c (trans A x c y s (sym A y c r1)) r1) s) (\ s -> refl s) z r)
    (idJ A y (\ c r1 -> (q : Id A x y) -> Id (Id A x y) (trans A x c y (trans A x y c q r1) (sym A y c r1)) q) (\ q -> refl q) z r)) ;
module Over (G : CG.ConcreteGroup) {
  module S = Subgroups[l].Over[G] ; module GS = GSets[l].Over[G] ; module Act = S.Act ;
  pt : G.space = G.point ;
  UG : U l = Id G.space pt pt ;
  UG-set : isSet UG = HL.trunc-set _ (G.groupoid pt pt) ;
  -- Lemma 5.3.6.
  rest (X : Act.GSet) : U l = GS.el X pt * S.Action[X].C.transitive ;
  transitive-prop (X : Act.GSet) : isProp S.Action[X].C.transitive =
    FL.isProp-Pi (GS.el X pt) (\ x -> (y : GS.el X pt) -> S.Action[X].C.relation x y) (\ x ->
      FL.isProp-Pi (GS.el X pt) (\ y -> S.Action[X].C.relation x y) (\ y -> T.Trunc[S.Action[X].C.hits x y].proposition)) ;
  rest-set (X : Act.GSet) : isSet (rest X) = isSet-Sigma (GS.el X pt) (\ x -> S.Action[X].C.transitive) (X pt).2
    (\ x -> prop-to-set _ (transitive-prop X)) ;
  transitive-of (H : S.Sub) : GS.Transitive[H.1].transitive = (T.Trunc[GS.el H.1 pt].inc H.2.1,H.2.2) ;
  first (X Y : Act.GSet) (e : Id Act.GSet X Y) (r : rest X) :
    Id (GS.el Y pt) (Big.subst Act.GSet (\ V -> rest V) X Y e r).1 (GS.transport-hom X Y e pt r.1) =
    idJ Act.GSet X (\ V q -> Id (GS.el V pt) (Big.subst Act.GSet (\ V -> rest V) X V q r).1 (GS.transport-hom X V q pt r.1)) (refl r.1) Y e ;
  codes (a b : S.Sub) : U l+ = (e : Id Act.GSet a.1 b.1) * Id (rest b.1) (Big.subst Act.GSet (\ V -> rest V) a.1 b.1 e a.2) b.2 ;
  codes-prop (a b : S.Sub) : Big.isProp (codes a b) = \ u v ->
    Big.Sigma-eq (Id Act.GSet a.1 b.1) (\ e -> Id (rest b.1) (Big.subst Act.GSet (\ V -> rest V) a.1 b.1 e a.2) b.2) _ _ _ _
      (GS.path-evaluation-injective a.1 b.1 pt a.2.1 (transitive-of a) u.1 v.1
        (transH (symH (first a.1 b.1 u.1 a.2)) (transH (apH (\ r -> r.1) u.2)
          (transH (symH (apH (\ r -> r.1) v.2)) (first a.1 b.1 v.1 a.2)))))
      (rest-set b.1 _ b.2) ;
  sub-set : Big.isSet S.Sub = \ a b p q -> Equivalences[l+].injective (Id S.Sub a b) (codes a b)
    (ConnectedMaps[l+].sigma-paths Act.GSet (\ V -> rest V) a b).1 (ConnectedMaps[l+].sigma-paths Act.GSet (\ V -> rest V) a b).2 p q
    (codes-prop a b _ _) ;
  -- Definition 5.3.11.
  decidable (H : S.Sub) : U l = (x y : GS.el H.1 pt) -> Logic[l].Dec (Id (GS.el H.1 pt) x y) ;
  -- Definition 5.3.13.
  loop-map (H : CG.ConcreteGroup) (i : CG.Hom H G) : Id H.space H.point H.point -> UG =
    (DeloopMaps[l].Maps[H.space,H.point,G.space,G.point].loop i).1 ;
  isMono (H : CG.ConcreteGroup) (i : CG.Hom H G) : U l = (g : UG) -> isProp (W.fib _ _ (loop-map H i) g) ;
  isMono-prop (H : CG.ConcreteGroup) (i : CG.Hom H G) : isProp (isMono H i) =
    FL.isProp-Pi UG (\ g -> isProp (W.fib _ _ (loop-map H i) g)) (\ g -> FL.isProp-isProp _) ;
  Mono : U l+ = (H : CG.ConcreteGroup) * (i : CG.Hom H G) * isMono H i ;
  trivial (m : Mono) : U l = FunExtUA[l].isContr m.1.space ;
  proper (m : Mono) : U l = isEquiv _ _ (loop-map m.1 m.2.1) -> Empty ;
  -- Definition 5.3.23.
  trivial-sub (H : S.Sub) : U l = FunExtUA[l].isContr S.Action[H.1].F.total ;
  proper-sub (H : S.Sub) : U l = FunExtUA[l].isContr (GS.el H.1 pt) -> Empty ;
  -- The map F : Sub(G) -> Mono(G) of Lemma 5.3.18.
  module Monic (H : S.Sub) {
    module A = S.Action[H.1].At[H.2.1,H.2.2] ;
    on-loops (p : A.loops) : Id UG (loop-map A.group A.projection p) (apH A.projection.1 p) =
      transH (DeloopMaps[l].Maps[A.group.space,A.group.point,G.space,G.point].loop-ap A.projection p)
        (trans-refl-l G.space pt pt (apH A.projection.1 p)) ;
    mono : isMono A.group A.projection = injective-fibres _ _ UG-set _ (\ p q h ->
      A.injective p q (transH (symH (on-loops p)) (transH h (on-loops q)))) ;
  } ;
  to-mono (H : S.Sub) : Mono = (S.underlying H,S.inclusion H,Monic[H].mono) ;
  -- Constructions 5.3.27 and 5.3.28.
  module Lagrange (H : S.Sub) {
    X : Act.GSet = H.1 ; x0 : GS.el X pt = H.2.1 ;
    module A = S.Action[X].At[x0,H.2.2] ;
    point (x : GS.el X pt) : S.Action[X].F.total = (pt,x) ;
    cls (g : UG) : GS.el X pt = GS.act X pt pt g x0 ;
    fib (x : GS.el X pt) : U l = (g : UG) * Id (GS.el X pt) (cls g) x ;
    eta (g : UG) (y : GS.el X pt) (e : Id (GS.el X pt) (cls g) y) :
      Id ((x : GS.el X pt) * fib x) (cls g,(g,refl (cls g))) (y,(g,e)) =
      idJ (GS.el X pt) (cls g) (\ y1 e1 -> Id ((x : GS.el X pt) * fib x) (cls g,(g,refl (cls g))) (y1,(g,e1))) (refl (cls g,(g,refl (cls g)))) y e ;
    index : Equiv UG ((x : GS.el X pt) * fib x) = (\ g -> (cls g,(g,refl (cls g))),qinv _ _ (\ g -> (cls g,(g,refl (cls g))))
      (\ w -> w.2.1) (\ w -> eta w.2.1 w.1 w.2.2) (\ g -> refl g)) ;
    to-path (x : GS.el X pt) : Equiv (fib x) (Id S.Action[X].F.total (point x0) (point x)) =
      Bijection[l].inverse _ _ (ConnectedMaps[l].sigma-paths G.space (GS.el X) (point x0) (point x)) ;
    Premise : U l = (x : GS.el X pt) -> (g : UG) * Id (GS.el X pt) (GS.act X pt pt g x) x0 ;
    back (f : Premise) (x : GS.el X pt) : Id S.Action[X].F.total (point x) (point x0) =
      Sigma-path G.space (GS.el X) pt pt x x0 (f x).1 (f x).2 ;
    construction (f : Premise) : Equiv UG (GS.el X pt * A.loops) = E.compose _ _ _ index
      (Fibres[l].sigma-equiv (GS.el X pt) fib (\ x -> A.loops) (\ x ->
        E.compose _ _ _ (to-path x) (post-equiv S.Action[X].F.total (point x0) (point x) (point x0) (back f x)))) ;
    construction' (f : Premise) : Equiv UG ((x : GS.el X pt) * Id S.Action[X].F.total (point x) (point x)) = E.compose _ _ _ index
      (Fibres[l].sigma-equiv (GS.el X pt) fib (\ x -> Id S.Action[X].F.total (point x) (point x)) (\ x ->
        E.compose _ _ _ (to-path x) (Fibres[l].trans-equiv S.Action[X].F.total (point x) (point x0) (point x) (back f x)))) ;
    -- The premise holds merely when the underlying set is finite.
    premise (fx : FiniteSets[l].Finite (GS.el X pt)) : T.Trunc[Premise].carrier =
      FiniteSets[l].choice (GS.el X pt) fx (\ x -> (g : UG) * Id (GS.el X pt) (GS.act X pt pt g x) x0)
        (\ x -> H.2.2 x x0) ;
  } ;
} ;
