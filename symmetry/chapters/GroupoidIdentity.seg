-- Section 6.7. Sending a 1-type to its path groupoid is an equivalence.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module K = Category[l,l] ; module L = Axioms[l].FunExtLemmas[fe @l] ;
one (X : U l) : U l = (x y : X) -> isSet (Id X x y) ;
one-prop (X : U l) : isProp (one X) = L.isProp-Pi X (\ x -> (y : X) -> isSet (Id X x y))
  (\ x -> L.isProp-Pi X (\ y -> isSet (Id X x y)) (\ y -> CategoryOfSets[l].set-prop (Id X x y))) ;
types : U l+ = (X : U l) * one X ;
inv (C : K.Category) : U l = (x y : C.pre.ob) (f : C.pre.hom x y) -> C.pre.isIso x y f ;
inv-prop (C : K.Category) : isProp (inv C) = L.isProp-Pi C.pre.ob (\ x -> (y : C.pre.ob) (f : C.pre.hom x y) -> C.pre.isIso x y f)
  (\ x -> L.isProp-Pi C.pre.ob (\ y -> (f : C.pre.hom x y) -> C.pre.isIso x y f)
    (\ y -> L.isProp-Pi (C.pre.hom x y) (C.pre.isIso x y) (Arrows[l,l].Arrows[C.pre].isIso-prop {x} {y}))) ;
groupoids : U l+ = (C : K.Category) * inv C ;
module Path (T : types) {
  module X = PathGroupoid[l].Of[T.1] ; module H = WildIsos[l,l].HomSets[X.paths,T.2] ;
  cat : K.Category = H.category X.univalent ;
  all : inv cat = \ x y p -> (H.AtPair[x,y].to (p,X.invertible x y p)).2 ;
} ;
to (T : types) : groupoids = (Path[T].cat,Path[T].all) ;
from (G : groupoids) : types = (G.1.pre.ob,K.Objects[G.1].one-type) ;
module Recover (G : groupoids) {
  C : K.Precategory = G.1.pre ;
  module I = CategoryIdentity[l,l].UnivalentFrom[(to (from G)).1] ;
  arrow (x y : C.ob) (p : Id C.ob x y) : C.hom x y = (C.idtoiso x y p).1 ;
  equiv (x y : C.ob) : isEquiv (Id C.ob x y) (C.hom x y) (arrow x y) =
    EquivalenceLemmas[l].compose _ _ _ (\ i -> i.1) (C.idtoiso x y)
      (qinv (C.Iso x y) (C.hom x y) (\ i -> i.1) (\ f -> (f,G.2 x y f)) (\ f -> refl f)
        (\ i -> Arrows[l,l].Arrows[C].iso-eq _ _ (refl i.1))) (G.1.univalent x y) ;
  comp (x y z : C.ob) (p : Id C.ob x y) (q : Id C.ob y z) :
    Id (C.hom x z) (arrow x z (transH p q)) (C.comp x y z (arrow y z q) (arrow x y p)) =
    idJ C.ob y (\ w r -> Id (C.hom x w) (arrow x w (transH p r)) (C.comp x y w (arrow y w r) (arrow x y p)))
      (symH (C.unit-l x y (arrow x y p))) z q ;
  strict : I.iso G.1 = (idEquiv C.ob,(\ x y -> (arrow x y,equiv x y)),(\ x -> refl (C.idn x)),comp) ;
  path : Id groupoids (to (from G)) G = Big.Sigma-eq K.Category (\ D -> inv D) _ _ _ _
    ((I.equality G.1).2.sec strict) (inv-prop G.1) ;
} ;
equivalence : Big.Equiv types groupoids = (to,Big.qinv types groupoids to from (\ G -> Recover[G].path)
  (\ T -> Big.Sigma-eq (U l) (\ X -> one X) _ _ _ _ (refl T.1) (one-prop T.1))) ;
