-- Small presentations are propositions. Adapt the comparison of presentations
-- from DOMAIN/UNIT/ScottSmallness to arbitrary types and independent levels.
level s v ; open Base ; module L = Prelude[s \/ v] ; module P = Prelude[s+ \/ v] ; module H = Paths[s+ \/ v] ;
module E = EquivalenceLemmas[s \/ v] ; module UA = Axioms[s].UnivalenceLemmas[univ @s] ;
module FL = Axioms[s \/ v].FunExtLemmas[fe @(s \/ v)] ;
small (X : U (s \/ v)) : U (s+ \/ v) = (A : U s) * L.Equiv A X ;
module On (X : U (s \/ v)) {
  along (A : U s) (e : L.Equiv A X) (B : U s) (p : Id (U s) A B) :
    (d : L.Equiv B X) -> ((a : A) -> Id X (e.1 a) (d.1 (Prelude[s].coe A B p a))) ->
    Id (L.Equiv B X) (P.subst (U s) (\ Z -> L.Equiv Z X) A B p e) d =
    idJ (U s) A (\ Z q -> (d : L.Equiv Z X) -> ((a : A) -> Id X (e.1 a) (d.1 (Prelude[s].coe A Z q a))) ->
      Id (L.Equiv Z X) (P.subst (U s) (\ V -> L.Equiv V X) A Z q e) d)
      (\ d h -> L.Sigma-eq (A -> X) (L.isEquiv A X) _ _ _ _ (FL.funext A (\ a -> X) _ _ h) (EquivProp[s \/ v].isEquiv-prop _ _ d.1)) B p ;
  module Pair (u w : small X) {
    d : L.Equiv u.1 w.1 = E.then _ _ _ u.2 (E.inverse _ _ w.2) ;
    e : Prelude[s].Equiv u.1 w.1 = (d.1,EquivalenceLemmas[s].lower @v _ _ d.1 d.2) ;
    p : Id (U s) u.1 w.1 = UA.ua _ _ e ;
    equal : Id (small X) u w = P.Sigma-path (U s) (\ A -> L.Equiv A X) _ _ _ _ p (along u.1 u.2 w.1 p w.2
      (\ a -> H.symH (H.transH (H.apH w.2.1 (UA.ua-beta _ _ e a)) (w.2.2.sec-eq (u.2.1 a))))) ;
  } ;
  prop : P.isProp (small X) = \ u w -> Pair[u,w].equal ;
} ;
change (X Y : U (s \/ v)) (u : small X) (d : L.Equiv X Y) : small Y = (u.1,E.then _ _ _ u.2 d) ;
sigma (X : U (s \/ v)) (Y : X -> U (s \/ v)) (u : small X) (w : (x : X) -> small (Y x)) : small ((x : X) * Y x) =
  ((a : u.1) * (w (u.2.1 a)).1,FibrewiseEquivalence[s \/ v].total-equivalence u.1 X u.2 (\ a -> (w (u.2.1 a)).1) Y (\ a -> (w (u.2.1 a)).2)) ;
paths (X : U (s \/ v)) (u : small X) : (x y : X) -> small (Id X x y) =
  Axioms[s \/ v].UnivalenceLemmas[univ @(s \/ v)].eqind u.1 (\ Z e -> (x y : Z) -> small (Id Z x y))
    (\ x y -> (Id u.1 x y,L.idEquiv (Id u.1 x y))) X u.2 ;
