-- Section 6.4. The path groupoid is left adjoint to the object type of a category.
level a o h ; open Base ; open Prelude[a \/ o \/ h] ; open Paths[a \/ o \/ h] ;
module On (X : U a) (C : WildCategory[o,h].Wild) (hs : (x y : C.ob) -> Prelude[h].isSet (C.hom x y)) {
  module P = PathGroupoid[a].Of[X] ; module F = WildFunctors[a,a,o,h] ;
  module E = F.Ext[P.paths,C,hs] ; module FL = Axioms[a \/ o \/ h].FunExtLemmas[fe @(a \/ o \/ h)] ;
  fun : U (a \/ o \/ h) = F.Map[P.paths,C] ;
  module Build (f : X -> C.ob) {
    arrow (x y : X) (p : Id X x y) : C.hom (f x) (f y) = (C.idtoiso (f x) (f y) (apH f p)).1 ;
    comp (x y z : X) (q : Id X y z) (p : Id X x y) : Id (C.hom (f x) (f z))
      (arrow x z (Paths[a].transH p q)) (C.comp _ _ _ (arrow y z q) (arrow x y p)) =
      idJ X y (\ w r -> Id (C.hom (f x) (f w)) (arrow x w (Paths[a].transH p r)) (C.comp _ _ _ (arrow y w r) (arrow x y p)))
        (symH (C.unit-l _ _ (arrow x y p))) z q ;
    map : fun = new F.Map[P.paths,C,f,arrow,\ x -> refl (C.idn (f x)),comp] ;
  } ;
  module Recover (t : fun) {
    module R = E.At[t.obj] ; module B = Build[t.obj] ;
    point (x y : X) (p : Id X x y) : Id (C.hom (t.obj x) (t.obj y)) (B.arrow x y p) (t.map x y p) =
      idJ X x (\ w r -> Id (C.hom (t.obj x) (t.obj w)) (B.arrow x w r) (t.map x w r)) (symH (t.map-idn x)) y p ;
    arrows : Id R.arrows B.arrow t.map = FL.funext X (\ x -> (y : X) -> Id X x y -> C.hom (t.obj x) (t.obj y)) _ _
      (\ x -> FL.funext X (\ y -> Id X x y -> C.hom (t.obj x) (t.obj y)) _ _
        (\ y -> FL.funext (Id X x y) (\ p -> C.hom (t.obj x) (t.obj y)) _ _ (point x y))) ;
    path : Id fun B.map t = transH (R.equal (B.arrow,B.map.map-idn,B.comp) (t.map,t.map-idn,t.map-comp) arrows) (E.eta t) ;
  } ;
  equivalence : Equiv fun (X -> C.ob) = ((\ t -> t.obj),qinv _ _ (\ t -> t.obj) (\ f -> Build[f].map)
    (\ f -> refl f) (\ t -> Recover[t].path)) ;
} ;
