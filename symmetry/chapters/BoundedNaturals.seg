-- The ordered formulation of pigeonhole and the bounded-natural presentation of Fin.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
open LeastNumber[l] ; open NatArith[l] ; open FiniteArithmetic[l] ;
bounded (n : Nat) : U l = (k : Nat) * lt k n ;
same (n : Nat) (x y : bounded n) (p : Id Nat x.1 y.1) : Id (bounded n) x y =
  Sigma-eq Nat (\ k -> lt k n) _ _ _ _ p (le-prop (suc y.1) n) ;
first-index (n : Nat) : bounded (suc n) = (zero,up zero n (bottom n)) ;
next-index (n : Nat) (x : bounded n) : bounded (suc n) = (suc x.1,up (suc x.1) n x.2) ;
number : (n : Nat) -> Fin n -> bounded n = split { zero -> absurd (bounded zero) ;
  suc n | r -> split { none -> first-index n ; some i -> next-index n (r i) } } ;
index : (n k : Nat) -> lt k n -> Fin n = split { zero -> \ k h -> absurd _ (empty k h) ;
  suc n | r -> split { zero -> \ h -> none ; suc k -> \ h -> some (r k (down (suc k) n h)) } } ;
recover : (n k : Nat) (h : lt k n) -> Id Nat (number n (index n k h)).1 k = split {
  zero -> \ k h -> absurd _ (empty k h) ; suc n | r -> split { zero -> \ h -> refl zero ;
    suc k -> \ h -> apH (\ t -> suc t) (r k (down (suc k) n h)) } } ;
inverse (n : Nat) (x : bounded n) : Fin n = index n x.1 x.2 ;
lower-proof (n : Nat) (x : bounded n) : lt x.1 n = down (suc x.1) n (next-index n x).2 ;
round : (n : Nat) (i : Fin n) -> Id (Fin n) (inverse n (number n i)) i = split {
  zero -> \ i -> absurd _ i ; suc n | r -> split { none -> refl none ;
    some i -> ap (Fin n) (Fin (suc n)) (\ t -> some t) (index n (number n i).1 (lower-proof n (number n i))) i (transH
      (apH (index n (number n i).1) (le-prop (suc (number n i).1) n (lower-proof n (number n i)) (number n i).2)) (r i)) } } ;
equivalence (n : Nat) : Equiv (Fin n) (bounded n) = (number n,qinv _ _ (number n) (inverse n)
  (\ x -> same n _ x (recover n x.1 x.2)) (round n)) ;
order (a b : Nat) : U l = Sum (lt a b) (lt b a) ;
raise (a b : Nat) : order a b -> order (suc a) (suc b) = split {
  left h -> left (up (suc a) b h) ; right h -> right (up (suc b) a h) } ;
compare : (a b : Nat) -> (Id Nat a b -> Empty) -> order a b = split {
  zero -> split { zero -> \ h -> absurd _ (h (refl zero)) ; suc b -> \ h -> left (up zero b (bottom b)) } ;
  suc a | r -> split { zero -> \ h -> right (up zero a (bottom a)) ;
    suc b -> \ h -> raise a b (r b (\ p -> h (apH (\ k -> suc k) p))) } } ;
module PHP (n : Nat) (f : Nat -> Nat) (bound : (k : Nat) -> lt k (suc n) -> lt (f k) n) {
  value (i : Fin (suc n)) : Nat = (number (suc n) i).1 ;
  within (i : Fin (suc n)) : lt (value i) (suc n) = (number (suc n) i).2 ;
  result (i : Fin (suc n)) : bounded n = (f (value i),bound (value i) (within i)) ;
  g (i : Fin (suc n)) : Fin n = inverse n (result i) ;
  module F = FinitePigeonhole[l] ;
  w : F.collision (Fin (suc n)) (Fin n) g = F.pigeonhole n g ;
  i : Fin (suc n) = w.1 ; j : Fin (suc n) = w.2.1 ;
  unequal (p : Id Nat (value i) (value j)) : Empty = w.2.2.1 (Equivalences[l].injective _ _ _ (equivalence (suc n)).2 i j
    (same (suc n) _ _ p)) ;
  equal : Id Nat (f (value i)) (f (value j)) = transH (symH (recover n _ (result i).2))
    (transH (apH (\ k -> (number n k).1) w.2.2.2) (recover n _ (result j).2)) ;
  answer : U l = (a : Nat) * (b : Nat) * lt a b * lt b (suc n) * Id Nat (f b) (f a) ;
  sort : order (value i) (value j) -> answer = split {
    left h -> (value i,value j,h,within j,symH equal) ; right h -> (value j,value i,h,within i,equal) } ;
  pigeonhole : answer = sort (compare (value i) (value j) unequal) ;
} ;
irreflexive : (n : Nat) -> lt n n -> Empty = split { zero -> empty zero ; suc n | r -> \ h -> r (down (suc n) n h) } ;
distinct (n m : Nat) (h : lt n m) (p : Id (U l) (bounded n) (bounded m)) : Empty = irreflexive n
  (subst Nat (lt n) m n (symH (Cardinality[l].unique n m (Equivalences[l].compose _ _ _ (equivalence n)
    (Equivalences[l].compose _ _ _ (Axioms[l].idtoeqv _ _ p) (Bijection[l].inverse _ _ (equivalence m)))))) h) ;
