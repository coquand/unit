-- The quotient X/m and the period condition of Construction 3.8.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module Z = Integers[l] ; module II = IntegerIteration[l] ; module F = FiniteCycles[l] ;
module TC = TruncationCombinators[l] ; module T = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module At (n : Nat) (v : CycleComponents[l].Perm) {
  module D = CycleDivision[l].Degree[n] ; module S = D.S ; module R = D.Residue ;
  module B = RootBundles[l].Degree[n] ;
  X : U l = v.1.1 ; module A = II.Orbit[X,v.2] ; m : Nat = suc n ;
  walk (x y : X) : U l = (k : Z.Int) * Id X (A.power k x) y ;
  transitive : U l = (x y : X) -> T.Trunc[walk x y].carrier ;
  fixes (k : Z.Int) : U l = (x : X) -> Id X (A.power k x) x ;
  -- An explicit, unique quotient is available by signed Euclidean division.
  divides (k : Z.Int) : U l = Id S.A (D.residue k) none ;
  condition : U l = (k : Z.Int) -> fixes k -> divides k ;
  proposition : isProp condition = FL.isProp-Pi Z.Int (\ k -> fixes k -> divides k)
    (\ k -> FL.isProp-Pi (fixes k) (\ h -> divides k) (\ h -> F.fin-set m _ none)) ;
  multiple-of (k : Z.Int) : U l = (q : Z.Int) * Id Z.Int (D.multiple q) k ;
  subgroup-inclusion : U l = (k : Z.Int) -> fixes k -> T.Trunc[multiple-of k].carrier ;
  inclusion-prop : isProp subgroup-inclusion = FL.isProp-Pi Z.Int (\ k -> fixes k -> T.Trunc[multiple-of k].carrier)
    (\ k -> FL.isProp-Pi (fixes k) (\ h -> T.Trunc[multiple-of k].carrier) (\ h -> T.Trunc[multiple-of k].proposition)) ;
  inclusion (d : condition) : subgroup-inclusion = \ k h -> T.Trunc[multiple-of k].inc (D.quotient k,D.exact k (d k h)) ;
  criterion (d : subgroup-inclusion) : condition = \ k h -> TC.rec (multiple-of k) @l (divides k) (F.fin-set m _ none)
    (\ w -> transH (apH D.residue (symH w.2)) (D.divisible w.1)) (d k h) ;
  period-condition : Equiv condition subgroup-inclusion = (inclusion,qinv _ _ inclusion criterion
    (\ d -> inclusion-prop _ d) (\ d -> proposition _ d)) ;
  module Block = II.Orbit[X,(A.N.power m,A.nat-equiv m)] ;
  module AtPoint (x : X) {
    orbit (k : Z.Int) : X = A.power k x ;
    module Map = II.Map[Z.Int,X,InfiniteCycle[l].shift,v.2,orbit,\ k -> A.step k x] ;
    blocks (q : Z.Int) : Id X (orbit (D.multiple q)) (Block.power q x) =
      II.Map[Z.Int,X,D.full,(A.N.power m,A.nat-equiv m),orbit,\ z -> Map.at z (pos m)].at Z.zeroZ q ;
  } ;
  witness (x y : X) : U l = (k : Z.Int) * divides k * Id X (A.power k x) y ;
  rel (x y : X) : U l = T.Trunc[witness x y].carrier ;
  reach (x y : X) : U l = (q : Z.Int) * Id X (Block.power q x) y ;
  to-block (x y : X) (w : witness x y) : reach x y = (D.quotient w.1,
    transH (symH (AtPoint[x].blocks (D.quotient w.1))) (transH (apH (AtPoint[x].orbit) (D.exact w.1 w.2.1)) w.2.2)) ;
  from-block (x y : X) (w : reach x y) : witness x y =
    (D.multiple w.1,D.divisible w.1,transH (AtPoint[x].blocks w.1) w.2) ;
  reverse (x y : X) (w : witness x y) : witness y x = (Z.neg w.1,
    transH (apH (R.power (Z.neg w.1)) (symH w.2.1)) (R.undo w.1 none),
    transH (apH (A.power (Z.neg w.1)) (symH w.2.2)) (A.undo w.1 x)) ;
  join (x y z : X) (a : witness x y) (b : witness y z) : witness x z = (Z.add a.1 b.1,
    transH (R.Add[a.1,none].compose b.1) (transH (apH (R.power b.1) a.2.1) b.2.1),
    transH (A.Add[a.1,x].compose b.1) (transH (apH (A.power b.1) a.2.2) b.2.2)) ;
  module Q = Quotient[l].Quot[X,rel,\ x y -> T.Trunc[witness x y].proposition,
    \ x -> T.Trunc[witness x x].inc (Z.zeroZ,refl none,refl x),
    \ x y -> TC.map _ _ (reverse x y),\ x y z -> TC.map2 _ _ _ (join x y z)] ;
  module Transitive (hit : transitive) {
    commute (j k : Z.Int) (x : X) : Id X (A.power k (A.power j x)) (A.power j (A.power k x)) =
      transH (symH (A.Add[j,x].compose k)) (transH (apH (AtPoint[x].orbit) (Z.comm j k)) (A.Add[k,x].compose j)) ;
    global (k : Z.Int) (x : X) (p : Id X (A.power k x) x) (y : X) : Id X (A.power k y) y =
      TC.rec (walk x y) @l _ (v.1.2 _ y) (\ w -> transH (apH (A.power k) (symH w.2))
        (transH (commute w.1 k x) (transH (apH (A.power w.1) p) w.2))) (hit x y) ;
    module Origin (d : condition) (x : X) {
      module Target (y : X) {
        number (w : walk x y) : S.A = D.residue w.1 ;
        loop (u w : walk x y) : fixes (Z.add u.1 (Z.neg w.1)) = global _ x
          (transH (A.Add[u.1,x].compose (Z.neg w.1)) (transH (apH (A.power (Z.neg w.1)) (transH u.2 (symH w.2))) (A.undo w.1 x))) ;
        agree (u w : walk x y) : Id S.A (number u) (number w) = R.cancel (Z.neg w.1) _ _
          (transH (symH (R.Add[u.1,none].compose (Z.neg w.1))) (transH (d _ (loop u w)) (symH (R.undo w.1 none)))) ;
        module Value = ConstantMap[l].Constant[walk x y,S.A,F.fin-set m,number,agree] ;
        grade : S.A = Value.value (hit x y) ;
        computes : (w : walk x y) -> Id S.A grade (number w) = Value.value-at (hit x y) ;
      } ;
      f (y : X) : S.A = Target[y].grade ;
      zero-law : Id S.A (f x) none = Target[x].computes (Z.zeroZ,refl x) ;
      step (y : X) : Id S.A (f (v.2.1 y)) (S.step (f y)) = TC.rec (walk x y) @l _ (F.fin-set m _ _) (\ w ->
        transH (Target[v.2.1 y].computes (Z.sucZ w.1,transH (A.step w.1 x) (apH v.2.1 w.2)))
          (transH (R.step w.1 none) (apH S.step (symH (Target[y].computes w))))) (hit x y) ;
      grading : B.phase v = (f,step) ;
    } ;
    module Phase (c : B.phase v) {
      module Map = II.Map[X,S.A,v.2,F.rotation n,c.1,c.2] ;
      module Shift (i : S.A) {
        module V = F.Centralizer[n] ;
        e : V.aut = V.shift i ;
        module Natural = II.Map[S.A,S.A,F.rotation n,F.rotation n,e.1.1,e.2] ;
        fixes-zero (k : Z.Int) (h : Id S.A (R.power k i) i) : divides k = Equivalences[l].injective _ _ e.1.1 e.1.2 _ _
          (transH (Natural.at none k) (transH (apH (R.power k) (V.beta i)) (transH h (symH (V.beta i))))) ;
      } ;
      period (inh : T.Trunc[X].carrier) : condition = TC.rec X @l condition proposition
        (\ x k h -> Shift[c.1 x].fixes-zero k (transH (symH (Map.at x k)) (apH c.1 (h x)))) inh ;
    } ;
    ext (a b : B.phase v) (x : X) (p : Id S.A (a.1 x) (b.1 x)) : Id (B.phase v) a b =
      Sigma-eq (X -> S.A) (\ f -> (y : X) -> Id S.A (f (v.2.1 y)) (S.step (f y))) _ _ _ _
        (FL.funext X (\ y -> S.A) _ _ (\ y -> TC.rec (walk x y) @l _ (F.fin-set m _ _) (\ w ->
          transH (apH a.1 (symH w.2)) (transH (Phase[a].Map.at x w.1) (transH (apH (R.power w.1) p)
            (transH (symH (Phase[b].Map.at x w.1)) (apH b.1 w.2))))) (hit x y))) (B.laws v b.1) ;
  } ;
} ;
