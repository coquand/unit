-- Section 6.4. The functor laws also hold with higher arrow types.
level o h ; open Base ; open Paths[o \/ h] ; open Prelude[o \/ h] ;
module W = WildCategory[o,h] ; module F = WildFunctors[o,h,o,h] ; module FL = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
identity (C : W.Wild) : F.Map[C,C] = new F.Map[C,C,\ x -> x,\ x y f -> f,\ x -> refl (C.idn x),\ x y z g f -> refl (C.comp x y z g f)] ;
compose (C D E : W.Wild) (g : F.Map[D,E]) (f : F.Map[C,D]) : F.Map[C,E] =
  new F.Map[C,E,(\ x -> g.obj (f.obj x)),(\ x y u -> g.map _ _ (f.map x y u)),
    (\ x -> transH (apH (g.map _ _) (f.map-idn x)) (g.map-idn (f.obj x))),
    (\ x y z k u -> transH (apH (g.map _ _) (f.map-comp x y z k u)) (g.map-comp _ _ _ (f.map y z k) (f.map x y u)))] ;
module Ext (C D : W.Wild) (t : F.Map[C,D]) {
  i (x : C.ob) : U h = Id (D.hom (t.obj x) (t.obj x)) (t.map x x (C.idn x)) (D.idn (t.obj x)) ;
  c (x y z : C.ob) (g : C.hom y z) (f : C.hom x y) : U h =
    Id (D.hom (t.obj x) (t.obj z)) (t.map x z (C.comp _ _ _ g f)) (D.comp _ _ _ (t.map _ _ g) (t.map _ _ f)) ;
  id-law : U (o \/ h) = (x : C.ob) -> i x ;
  cmp-law : U (o \/ h) = (x y z : C.ob) (g : C.hom y z) (f : C.hom x y) -> c x y z g f ;
  build (j : id-law) (k : cmp-law) : F.Map[C,D] = new F.Map[C,D,t.obj,t.map,j,k] ;
  equal (j j' : id-law) (k k' : cmp-law) (u : (x : C.ob) -> Id (i x) (j x) (j' x))
    (v : (x y z : C.ob) (g : C.hom y z) (f : C.hom x y) -> Id (c x y z g f) (k x y z g f) (k' x y z g f)) :
    Id (F.Map[C,D]) (build j k) (build j' k') =
    transH (apH (\ s -> build s k) (FL.funext C.ob (\ x -> i x) j j' u))
      (apH (build j') (FL.funext C.ob (\ x -> (y z : C.ob) (g : C.hom y z) (f : C.hom x y) -> c x y z g f) k k'
        (\ x -> FL.funext C.ob (\ y -> (z : C.ob) (g : C.hom y z) (f : C.hom x y) -> c x y z g f) _ _
        (\ y -> FL.funext C.ob (\ z -> (g : C.hom y z) (f : C.hom x y) -> c x y z g f) _ _
        (\ z -> FL.funext (C.hom y z) (\ g -> (f : C.hom x y) -> c x y z g f) _ _
        (\ g -> FL.funext (C.hom x y) (\ f -> c x y z g f) _ _ (v x y z g))))))) ;
} ;
eta (C D : W.Wild) : (f : F.Map[C,D]) -> Id (F.Map[C,D]) (Ext[C,D,f].build f.map-idn f.map-comp) f =
  split { Map f g i c -> refl (new F.Map[C,D,f,g,i,c]) } ;
id-ap (X : U h) (x y : X) (q : Id X x y) : Id (Id X x y) (apH (\ u -> u) q) q =
  idJ X x (\ z p -> Id (Id X x z) (apH (\ u -> u) p) p) (refl (refl x)) y q ;
module Units (C D : W.Wild) (f : F.Map[C,D]) {
  module X = Ext[C,D,f] ; lf : F.Map[C,D] = compose C D D (identity D) f ; rf : F.Map[C,D] = compose C C D f (identity C) ;
  left : Id (F.Map[C,D]) lf f = transH (X.equal lf.map-idn f.map-idn lf.map-comp f.map-comp
    (\ x -> id-ap _ _ _ (f.map-idn x)) (\ x y z g k -> id-ap _ _ _ (f.map-comp x y z g k))) (eta C D f) ;
  right : Id (F.Map[C,D]) rf f = transH (X.equal rf.map-idn f.map-idn rf.map-comp f.map-comp
    (\ x -> trans-refl-l _ _ _ (f.map-idn x)) (\ x y z g k -> trans-refl-l _ _ _ (f.map-comp x y z g k))) (eta C D f) ;
} ;
module Coherence (X Y Z : U h) (f : X -> Y) (g : Y -> Z) (x : X) {
  eq (x' : X) (p : Id X x x') (y : Y) (q : Id Y (f x') y) (z : Z) (r : Id Z (g y) z) : U h =
    Id (Id Z (g (f x)) z) (transH (apH g (transH (apH f p) q)) r) (transH (apH (\ t -> g (f t)) p) (transH (apH g q) r)) ;
  law (x' : X) (p : Id X x x') : (y : Y) (q : Id Y (f x') y) (z : Z) (r : Id Z (g y) z) -> eq x' p y q z r =
    idJ X x (\ v s -> (y : Y) (q : Id Y (f v) y) (z : Z) (r : Id Z (g y) z) -> eq v s y q z r)
      (\ y q -> idJ Y (f x) (\ v s -> (z : Z) (r : Id Z (g v) z) -> eq x (refl x) v s z r)
        (\ z r -> idJ Z (g (f x)) (\ v s -> eq x (refl x) (f x) (refl (f x)) v s) (refl (refl (g (f x)))) z r) y q) x' p ;
} ;
module Triple (C D E T : W.Wild) (f : F.Map[C,D]) (g : F.Map[D,E]) (k : F.Map[E,T]) {
  lhs : F.Map[C,T] = compose C E T k (compose C D E g f) ;
  rhs : F.Map[C,T] = compose C D T (compose D E T k g) f ;
  assoc : Id (F.Map[C,T]) lhs rhs = Ext[C,T,lhs].equal lhs.map-idn rhs.map-idn lhs.map-comp rhs.map-comp
    (\ x -> Coherence[D.hom (f.obj x) (f.obj x),E.hom (g.obj (f.obj x)) (g.obj (f.obj x)),T.hom (rhs.obj x) (rhs.obj x),
      g.map _ _,k.map _ _,f.map x x (C.idn x) ].law (D.idn (f.obj x)) (f.map-idn x) (E.idn (g.obj (f.obj x))) (g.map-idn (f.obj x)) (T.idn (rhs.obj x)) (k.map-idn (g.obj (f.obj x))))
    (\ x y z v u -> Coherence[D.hom (f.obj x) (f.obj z),E.hom (g.obj (f.obj x)) (g.obj (f.obj z)),T.hom (rhs.obj x) (rhs.obj z),
      g.map _ _,k.map _ _,f.map x z (C.comp _ _ _ v u)].law (D.comp _ _ _ (f.map y z v) (f.map x y u)) (f.map-comp x y z v u) (E.comp _ _ _ (g.map _ _ (f.map y z v)) (g.map _ _ (f.map x y u))) (g.map-comp _ _ _ (f.map y z v) (f.map x y u)) (T.comp _ _ _ (rhs.map y z v) (rhs.map x y u))
      (k.map-comp _ _ _ (g.map _ _ (f.map _ _ v)) (g.map _ _ (f.map _ _ u)))) ;
} ;
precats : WildCategory[o+ \/ h+,o \/ h].Wild = new WildCategory[o+ \/ h+,o \/ h].Wild[Category[o,h].Precategory,
  (\ C D -> F.Map[W.forget C,W.forget D]),(\ C -> identity (W.forget C)),(\ C D E -> compose (W.forget C) (W.forget D) (W.forget E)),
  (\ C D f -> Units[W.forget C,W.forget D,f].left),(\ C D f -> Units[W.forget C,W.forget D,f].right),
  (\ C D E T f g k -> Triple[W.forget C,W.forget D,W.forget E,W.forget T,f,g,k].assoc)] ;
