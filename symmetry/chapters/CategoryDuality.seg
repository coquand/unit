-- Section 6.3. Opposite is an involution, including the associativity witness.
level o h ; open Base ; module W = WildCategory[o,h] ; module P = Paths[h] ;
module FL = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
double (T : U h) (x y : T) (q : Id T x y) : Id (Id T x y) (P.symH (P.symH q)) q =
  idJ T x (\ z r -> Id (Id T x z) (P.symH (P.symH r)) r) (refl (refl x)) y q ;
module At (C : W.Wild) {
  twice : W.Wild = W.op (W.op C) ;
  law (w x y z : C.ob) (f : C.hom w x) (g : C.hom x y) (k : C.hom y z) : U h =
    Id (C.hom w z) (C.comp w y z k (C.comp w x y g f)) (C.comp w x z (C.comp x y z k g) f) ;
  assoc-law : Id ((w : C.ob) -> (x : C.ob) -> (y : C.ob) -> (z : C.ob) -> (f : C.hom w x) -> (g : C.hom x y) -> (k : C.hom y z) -> law w x y z f g k) twice.assoc C.assoc =
    FL.funext (C.ob) (\ w -> (x : C.ob) -> (y : C.ob) -> (z : C.ob) -> (f : C.hom w x) -> (g : C.hom x y) -> (k : C.hom y z) -> law w x y z f g k) (twice.assoc ) (C.assoc )
      (\ w -> FL.funext (C.ob) (\ x -> (y : C.ob) -> (z : C.ob) -> (f : C.hom w x) -> (g : C.hom x y) -> (k : C.hom y z) -> law w x y z f g k) (twice.assoc w) (C.assoc w)
      (\ x -> FL.funext (C.ob) (\ y -> (z : C.ob) -> (f : C.hom w x) -> (g : C.hom x y) -> (k : C.hom y z) -> law w x y z f g k) (twice.assoc w x) (C.assoc w x)
      (\ y -> FL.funext (C.ob) (\ z -> (f : C.hom w x) -> (g : C.hom x y) -> (k : C.hom y z) -> law w x y z f g k) (twice.assoc w x y) (C.assoc w x y)
      (\ z -> FL.funext (C.hom w x) (\ f -> (g : C.hom x y) -> (k : C.hom y z) -> law w x y z f g k) (twice.assoc w x y z) (C.assoc w x y z)
      (\ f -> FL.funext (C.hom x y) (\ g -> (k : C.hom y z) -> law w x y z f g k) (twice.assoc w x y z f) (C.assoc w x y z f)
      (\ g -> FL.funext (C.hom y z) (\ k -> law w x y z f g k) (twice.assoc w x y z f g) (C.assoc w x y z f g)
      (\ k -> double _ _ _ (C.assoc w x y z f g k)))))))) ;
  raw (a : (w x y z : C.ob) (f : C.hom w x) (g : C.hom x y) (k : C.hom y z) -> law w x y z f g k) : W.Wild =
    new W.Wild[C.ob,C.hom,C.idn,C.comp,C.unit-l,C.unit-r,a] ;
  equal : Id W.Wild twice (raw C.assoc) = Paths[o+ \/ h+].apH raw assoc-law ;
} ;
involution : (C : W.Wild) -> Id W.Wild (W.op (W.op C)) C =
  split { Wild O m i c u v a -> At[new W.Wild[O,m,i,c,u,v,a]].equal } ;
equivalence : Prelude[o+ \/ h+].Equiv W.Wild W.Wild =
  (W.op,Prelude[o+ \/ h+].qinv _ _ W.op W.op involution involution) ;
