-- Exercise 2.25.8. A specified small presentation of each large fibre.
level u v ; constraint u+ <= v ; open Base ; open Prelude[v+] ;
module Small = Prelude[v] ; module E = Equivalences[v+] ; module UA = Axioms[v].UnivalenceLemmas[univ @v] ;
module FL = Axioms[v+].FunExtLemmas[fe @(v+)] ;
presentation (Y : U v) : U v = (X : U u) * Small.Equiv X Y ;
presented : U v+ = (Y : U v) * presentation Y ;
pack (X : U u) : presented = (X,X,Small.idEquiv X) ;
forget (w : presented) : U u = w.2.1 ;
round (w : presented) : Id presented (pack (forget w)) w = UA.eqind w.2.1
  (\ Y e -> Id presented (pack w.2.1) (Y,w.2.1,e)) (refl (pack w.2.1)) w.1 w.2.2 ;
small-types : Equiv presented (U u) = (forget,qinv _ _ forget pack (\ X -> refl X) round) ;
module Over (A : U v) {
  module S = FamilyClassifier[v].Over[A].Structured[presentation] ;
  read (h : S.objects) (a : A) : U u = forget (h a) ;
  write (P : A -> U u) (a : A) : presented = pack (P a) ;
  codes : Equiv S.objects (A -> U u) = (read,qinv _ _ read write (\ P -> refl P)
    (\ h -> FL.funext A (\ a -> presented) _ _ (\ a -> round (h a)))) ;
  classifier : Equiv S.arrows (A -> U u) = E.compose _ _ _ S.equivalence codes ;
} ;
