-- The path groupoid is univalent at every homotopy level.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module W = WildCategory[l,l] ;
module Of (X : U l) {
  assoc (w x y z : X) (p : Id X w x) (q : Id X x y) (r : Id X y z) :
    Id (Id X w z) (transH (transH p q) r) (transH p (transH q r)) =
    idJ X y (\ t s -> Id (Id X w t) (transH (transH p q) s) (transH p (transH q s))) (refl (transH p q)) z r ;
  paths : W.Wild = new W.Wild[X,\ x y -> Id X x y,\ x -> refl x,\ w x y q p -> transH p q,
    \ x y p -> refl p,trans-refl-l X,assoc] ;
  forget (x y : X) (p : Id X x y) : Id (Id X x y) (paths.idtoiso x y p).1 p =
    idJ X x (\ t q -> Id (Id X x t) (paths.idtoiso x t q).1 q) (refl (refl x)) y p ;
  invertible (x y : X) (p : Id X x y) : WildIsos[l,l].At[paths,x,y,p].data-inv =
    idJ X x (\ t q -> WildIsos[l,l].At[paths,x,t,q].data-inv) (paths.ident x).2 y p ;
  univalent : paths.univalent = \ x y -> qinv _ _ (paths.idtoiso x y) (\ i -> i.1)
    (\ i -> Sigma-eq (Id X x y) (\ p -> WildIsos[l,l].At[paths,x,y,p].data-inv) _ _ _ _ (forget x y i.1)
      WildIsos[l,l].At[paths,x,y,i.1].prop) (forget x y) ;
} ;
module Maps (X Y : U l) (f : X -> Y) {
  module A = Of[X] ; module B = Of[Y] ; module F = WildFunctors[l,l,l,l] ;
  preserves (x y z : X) (p : Id X x y) (q : Id X y z) : Id (Id Y (f x) (f z))
    (apH f (transH p q)) (transH (apH f p) (apH f q)) =
    idJ X y (\ t r -> Id (Id Y (f x) (f t)) (apH f (transH p r)) (transH (apH f p) (apH f r)))
      (refl (apH f p)) z q ;
  functor : F.Map[A.paths,B.paths] = new F.Map[A.paths,B.paths,f,ap X Y f,
    \ x -> refl (refl (f x)),\ x y z q p -> preserves x y z p q] ;
} ;
-- Theorem 6.7: a functor out of a path groupoid into another path
-- groupoid is determined by its object function when the target is a 1-type.
module Classification (X Y : U l) (groupoid : (x y : Y) -> isSet (Id Y x y)) {
  module A = Of[X] ; module B = Of[Y] ; module F = WildFunctors[l,l,l,l] ;
  module E = F.Ext[A.paths,B.paths,groupoid] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
  fun : U l = F.Map[A.paths,B.paths] ;
  obj (t : fun) : X -> Y = t.obj ;
  build (f : X -> Y) : fun = Maps[X,Y,f].functor ;
  module At (t : fun) {
    module R = E.At[t.obj] ;
    map-path (x y : X) (p : Id X x y) : Id (Id Y (t.obj x) (t.obj y)) (apH t.obj p) (t.map x y p) =
      idJ X x (\ z q -> Id (Id Y (t.obj x) (t.obj z)) (apH t.obj q) (t.map x z q)) (symH (t.map-idn x)) y p ;
    arrows : Id R.arrows (build t.obj).map t.map = FL.funext X (\ x -> (y : X) -> Id X x y -> Id Y (t.obj x) (t.obj y)) (build t.obj).map t.map
      (\ x -> FL.funext X (\ y -> Id X x y -> Id Y (t.obj x) (t.obj y)) ((build t.obj).map x) (t.map x) (\ y -> FL.funext (Id X x y) (\ q -> Id Y (t.obj x) (t.obj y)) ((build t.obj).map x y) (t.map x y) (map-path x y))) ;
    law : Id fun (build (obj t)) t = transH (R.equal ((build t.obj).map,(build t.obj).map-idn,(build t.obj).map-comp)
      (t.map,t.map-idn,t.map-comp) arrows) (E.eta t) ;
  } ;
  equivalence : Equiv fun (X -> Y) = (obj,qinv _ _ obj build (\ f -> refl f) (\ t -> At[t].law)) ;
} ;
module Homotopy (X Y : U l) (f g : X -> Y) (h : (x : X) -> Id Y (f x) (g x)) {
  module B = WildFunctors[l,l,l,l].Between[Of[X].paths,Of[Y].paths] ;
  natural : B.natural Maps[X,Y,f].functor Maps[X,Y,g].functor h = \ x y p ->
    idJ X x (\ z r -> Id (Id Y (f x) (g z)) (transH (h x) (apH g r)) (transH (apH f r) (h z)))
      (symH (trans-refl-l _ _ _ (h x))) y p ;
  transformation : B.transformation Maps[X,Y,f].functor Maps[X,Y,g].functor = (h,natural) ;
} ;
