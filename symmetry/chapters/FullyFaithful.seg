-- Sections 6.6–6.7. The fibre argument of the pinned EquivObjects library
-- only needs full faithfulness. Introduce essential surjectivity at splitting.
level k1 l1 k2 l2 j ; open Base ;
constraint k1 <= j ; constraint l1 <= j ; constraint k2 <= j ; constraint l2 <= j ;
module C1 = Category[k1,l1] ; module C2 = Category[k2,l2] ;
module F12 = Functor[k1,l1,k2,l2] ;
module P = Prelude[j] ; module H2 = Paths[l2] ;

module IntoPrecategory (X : C1.Category) (Y : C2.Precategory) (Pf : F12.Functor[X.pre, Y])
  (ff : F12.FullyFaithful X.pre Y Pf) {
 module AY = Arrows[k2,l2].Arrows[Y] ;
 module MP = F12.Maps[X.pre,Y,Pf] ;
 module L = F12.Faithful[X.pre,Y,Pf,ff] ;

 S (y : Y.ob) : U j = (x : X.pre.ob) * Y.Iso (Pf.obj x) y ;

 along (y : Y.ob) (x x' : X.pre.ob) (p : Id X.pre.ob x x') :
  (e : Y.Iso (Pf.obj x') y) -> Id (S y) (x, AY.iso-cmp e (MP.map-iso (X.pre.idtoiso x x' p))) (x', e) =
  idJ X.pre.ob x
   (\ x1 p1 -> (e : Y.Iso (Pf.obj x1) y) -> Id (S y) (x, AY.iso-cmp e (MP.map-iso (X.pre.idtoiso x x1 p1))) (x1, e))
   (\ e -> P.ap (Y.Iso (Pf.obj x) y) (S y) (\ e1 -> (x, e1)) (AY.iso-cmp e (MP.map-iso (X.pre.iso-id x))) e
     (AY.iso-eq (AY.iso-cmp e (MP.map-iso (X.pre.iso-id x))) e
       (H2.transH (AY.left (AY.arr e) (Pf.map-idn x)) (AY.unit-r (AY.arr e)))))
   x' p ;

 lifted (y : Y.ob) (u v : S y) : X.pre.Iso u.1 v.1 = L.reflect-iso (AY.iso-cmp (AY.iso-inv v.2) u.2) ;
 -- by definition the arrow of lifted is lift v.2 (arr u.2)
 lifted-eq (y : Y.ob) (u v : S y) :
  Id (Y.hom (Pf.obj u.1) y) (AY.cmp (AY.arr v.2) (Pf.map u.1 v.1 (Arrows[k1,l1].Arrows[X.pre].arr (lifted y u v)))) (AY.arr u.2) =
  L.lift-eq v.2 (AY.arr u.2) ;

 S-prop (y : Y.ob) : P.isProp (S y) = \ u v ->
  calc (S y) {
   u
    =< P.ap (Y.Iso (Pf.obj u.1) y) (S y) (\ e1 -> (u.1, e1)) u.2 (AY.iso-cmp v.2 (MP.map-iso (lifted y u v)))
        (AY.iso-eq u.2 (AY.iso-cmp v.2 (MP.map-iso (lifted y u v))) (H2.symH (lifted-eq y u v))) >
   (u.1, AY.iso-cmp v.2 (MP.map-iso (lifted y u v)))
    =< P.ap (X.pre.Iso u.1 v.1) (S y) (\ phi -> (u.1, AY.iso-cmp v.2 (MP.map-iso phi)))
        (lifted y u v) (X.pre.idtoiso u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v)))
        (P.sym (X.pre.Iso u.1 v.1) (X.pre.idtoiso u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v))) (lifted y u v)
          ((X.univalent u.1 v.1).sec-eq (lifted y u v))) >
   (u.1, AY.iso-cmp v.2 (MP.map-iso (X.pre.idtoiso u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v)))))
    =< along y u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v)) v.2 >
   v } ;

 -- Essential surjectivity supplies a mere inhabitant of an already propositional type.
 choose (es : F12.EssSurj X.pre Y Pf) : F12.SplitEssSurj X.pre Y Pf = \ y ->
   Truncation[k1 \/ l2].Trunc[(x : X.pre.ob) * Y.Iso (Pf.obj x) y].induction @j
     (\ t -> S y) (\ t -> S-prop y) (\ t -> t) (es y) ;
} ;

module FullyFaithful (X : C1.Category) (Y : C2.Category) (Pf : F12.Functor[X.pre, Y.pre])
  (ff : F12.FullyFaithful X.pre Y.pre Pf) {
 module Common = IntoPrecategory[X,Y.pre,Pf,ff] ;
 S (y : Y.pre.ob) : U j = Common.S y ;
 S-prop (y : Y.pre.ob) : P.isProp (S y) = Common.S-prop y ;
 Fib (y : Y.pre.ob) : U j = (x : X.pre.ob) * Id Y.pre.ob (Pf.obj x) y ;
 Fib-prop (y : Y.pre.ob) : P.isProp (Fib y) =
  P.retract-prop (Fib y) (S y)
   (\ w -> (w.1, Y.pre.idtoiso (Pf.obj w.1) y w.2)) (\ w -> (w.1, Y.isotoid (Pf.obj w.1) y w.2))
   (\ w -> P.ap (Id Y.pre.ob (Pf.obj w.1) y) (Fib y) (\ q -> (w.1, q))
     (Y.isotoid (Pf.obj w.1) y (Y.pre.idtoiso (Pf.obj w.1) y w.2)) w.2
     (Prelude[k2 \/ l2].sec-ret (Id Y.pre.ob (Pf.obj w.1) y) (Y.pre.Iso (Pf.obj w.1) y)
       (Y.pre.idtoiso (Pf.obj w.1) y) (Y.univalent (Pf.obj w.1) y) w.2))
   (S-prop y) ;

 choose (es : F12.EssSurj X.pre Y.pre Pf) : F12.SplitEssSurj X.pre Y.pre Pf = Common.choose es ;
 equiv (es : F12.EssSurj X.pre Y.pre Pf) : P.isEquiv X.pre.ob Y.pre.ob Pf.obj =
   EquivObjects[k1,l1,k2,l2,j].Corollary[X,Y,Pf,ff,choose es].equiv ;
} ;
