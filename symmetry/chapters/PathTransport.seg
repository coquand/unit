-- Section 2.14. Unit composes paths in traversal order.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Along (A : U l) (P : A -> U l) (a : A) {
  move (b : A) (e : Id A a b) : P a -> P b = subst A P a b e ;
  dep (f : (x : A) -> P x) (b : A) (e : Id A a b) : Id (P b) (move b e (f a)) (f b) =
    idJ A a (\ x q -> Id (P x) (move x q (f a)) (f x)) (refl (f a)) b e ;
  module Between (f g : (x : A) -> P x) (i : Id (P a) (f a) (g a)) {
    paths (x : A) : U l = Id (P x) (f x) (g x) ;
    formula (b : A) (e : Id A a b) : paths b =
      transH (transH (symH (dep f b e)) (apH (move b e) i)) (dep g b e) ;
    identity (z : P a) (p : Id (P a) (f a) z) : Id (Id (P a) (f a) z) p (transH (refl (f a)) (apH (move a (refl a)) p)) =
      idJ (P a) (f a) (\ y q -> Id (Id (P a) (f a) y) q (transH (refl (f a)) (apH (move a (refl a)) q))) (refl (refl (f a))) z p ;
    transport (b : A) (e : Id A a b) : Id (paths b) (subst A paths a b e i) (formula b e) =
      idJ A a (\ x q -> Id (paths x) (subst A paths a x q i) (formula x q)) (identity (g a) i) b e ;
  } ;
  loops (f : (x : A) -> P x) (b : A) (e : Id A a b) :
    Equiv (Id (P b) (move b e (f a)) (f b)) (Id (P a) (f a) (f a)) =
    idJ A a (\ x q -> Equiv (Id (P x) (move x q (f a)) (f x)) (Id (P a) (f a) (f a))) (idEquiv _) b e ;
} ;
module Ordinary (A : U l) (a : A) {
  constant (B : U l) (i : B) (b : A) (p : Id A a b) : Id B (subst A (\ x -> B) a b p i) i =
    idJ A a (\ x q -> Id B (subst A (\ z -> B) a x q i) i) (refl i) b p ;
  target (z : A) (i : Id A z a) (b : A) (e : Id A a b) :
    Id (Id A z b) (subst A (\ t -> Id A z t) a b e i) (transH i e) =
    idJ A a (\ x q -> Id (Id A z x) (subst A (\ t -> Id A z t) a x q i) (transH i q)) (refl i) b e ;
  source (z : A) (i : Id A a z) (b : A) (e : Id A a b) :
    Id (Id A b z) (subst A (\ x -> Id A x z) a b e i) (transH (symH e) i) =
    idJ A a (\ x q -> Id (Id A x z) (subst A (\ t -> Id A t z) a x q i) (transH (symH q) i))
      (symH (trans-refl-l A a z i)) b e ;
  conjugate (i : Id A a a) (b : A) (e : Id A a b) :
    Id (Id A b b) (subst A (\ x -> Id A x x) a b e i) (transH (transH (symH e) i) e) =
    idJ A a (\ x q -> Id (Id A x x) (subst A (\ t -> Id A t t) a x q i) (transH (transH (symH q) i) q))
      (symH (trans-refl-l A a a i)) b e ;
} ;
pointwise (X Y : U l) (x : X) (y : Y) (f g : X -> Y) (e : Id (X -> Y) f g) (p : Id Y y (f x)) :
  Id (Id Y y (g x)) (subst (X -> Y) (\ k -> Id Y y (k x)) f g e p) (transH p (happly X (\ t -> Y) f g e x)) =
  idJ (X -> Y) f (\ k q -> Id (Id Y y (k x)) (subst (X -> Y) (\ m -> Id Y y (m x)) f k q p)
    (transH p (happly X (\ t -> Y) f k q x))) (refl p) g e ;
module Arrows (A : U l) (Y Z : A -> U l) (a : A) (f : Y a -> Z a) {
  family (x : A) : U l = Y x -> Z x ;
  action (b : A) (e : Id A a b) : (y : Y b) -> Id (Z b) (subst A family a b e f y)
    (subst A Z a b e (f (subst A Y b a (symH e) y))) = idJ A a (\ t q -> (y : Y t) ->
      Id (Z t) (subst A family a t q f y) (subst A Z a t q (f (subst A Y t a (symH q) y)))) (\ y -> refl (f y)) b e ;
} ;
module PathsOfMaps (X Y : U l) (f g : X -> Y) (x : X) (i : Id Y (f x) (g x)) {
  P (a : X) : U l = Id Y (f a) (g a) ;
  term (y : X) (p : Id X x y) : P y = transH (transH (symH (apH f p)) i) (apH g p) ;
  rule (y : X) (p : Id X x y) : Id (P y) (subst X P x y p i) (term y p) =
    idJ X x (\ t q -> Id (P t) (subst X P x t q i) (term t q)) (symH (trans-refl-l Y _ _ i)) y p ;
} ;
module Over (X : U l) (P : X -> U l) {
  move (a b : X) (p : Id X a b) : P a -> P b = subst X P a b p ;
  compose (a b : X) (p : Id X a b) (c : X) (q : Id X b c) :
    Id (P a -> P c) (move a c (transH p q)) (\ x -> move b c q (move a b p x)) =
    idJ X b (\ z r -> Id (P a -> P z) (move a z (transH p r)) (\ x -> move b z r (move a b p x))) (refl (move a b p)) c q ;
  pull (A : U l) (f : A -> X) (a b : A) (p : Id A a b) : Id (P (f a) -> P (f b))
    (subst A (\ t -> P (f t)) a b p) (move (f a) (f b) (apH f p)) = idJ A a
    (\ t q -> Id (P (f a) -> P (f t)) (subst A (\ s -> P (f s)) a t q) (move (f a) (f t) (apH f q))) (refl (\ x -> x)) b p ;
  path (a b : X) (p : Id X a b) (u : P a) (v : P b) : U l = Id (P b) (move a b p u) v ;
  join (a b : X) (p : Id X a b) (u : P a) (v : P b) (h : path a b p u v) (c : X) (q : Id X b c) :
    (w : P c) -> path b c q v w -> path a c (transH p q) u w = idJ X b
    (\ z r -> (w : P z) -> path b z r v w -> path a z (transH p r) u w) (\ w k -> transH h k) c q ;
  inverse (a b : X) (p : Id X a b) (u : P a) : (v : P b) -> path a b p u v -> path b a (symH p) v u =
    idJ X a (\ z q -> (v : P z) -> path a z q u v -> path z a (symH q) v u) (\ v h -> symH h) b p ;
  right-unit (a b : X) (p : Id X a b) (u : P a) (v : P b) (h : path a b p u v) :
    Id (path a b p u v) (join a b p u v h b (refl b) v (refl v)) h = refl h ;
  apply (Z : U l) (g : (a : X) -> P a -> Z) (a b : X) (p : Id X a b) (u : P a) :
    (v : P b) -> path a b p u v -> Id Z (g a u) (g b v) = idJ X a
    (\ z q -> (v : P z) -> path a z q u v -> Id Z (g a u) (g z v)) (ap (P a) Z (g a) u) b p ;
  at-refl (Z : U l) (g : (a : X) -> P a -> Z) (a : X) (u v : P a) (q : Id (P a) u v) :
    Id (Id Z (g a u) (g a v)) (apply Z g a a (refl a) u v q) (apH (g a) q) = refl (apH (g a) q) ;
} ;
constant-map (X Y : U l) (a b : X) (p : Id X a b) : Id (Y -> Y) (subst X (\ t -> Y) a b p) (\ y -> y) =
  idJ X a (\ z q -> Id (Y -> Y) (subst X (\ t -> Y) a z q) (\ y -> y)) (refl (\ y -> y)) b p ;
naturality (X Y : U l) (f g : X -> Y) (h : (x : X) -> Id Y (f x) (g x)) (a b : X) (p : Id X a b) :
  Id (Id Y (f a) (g b)) (transH (apH f p) (h b)) (transH (h a) (apH g p)) =
  idJ X a (\ z q -> Id (Id Y (f a) (g z)) (transH (apH f q) (h z)) (transH (h a) (apH g q))) (trans-refl-l Y _ _ (h a)) b p ;

-- Transport the induced equivalence on loops along a choice of basepoint path.
module BasedLoops (X : U l) (x : X) (Y : U l) (y : Y) (f : X -> Y) (p : Id Y (f x) y)
  (emb : isEquiv (Id X x x) (Id Y (f x) (f x)) (ap X Y f x x)) {
  module C = LoopConj[l] ;
  raw : Equiv (Id X x x) (Id Y (f x) (f x)) = (ap X Y f x x,emb) ;
  loops : Equiv (Id X x x) (Id Y y y) = Equivalences[l].compose _ _ _ raw
    (C.conj Y _ _ p,qinv _ _ (C.conj Y _ _ p) (C.conj Y _ _ (symH p))
      (C.conj-sym-back Y _ _ p) (C.conj-back Y _ _ p)) ;
  compose (u v : Id X x x) : Id (Id Y y y) (loops.1 (transH u v)) (transH (loops.1 u) (loops.1 v)) =
    transH (apH (C.conj Y _ _ p) (Groupoid[l].ap-trans X Y f x x x u v))
      (C.conj-mult Y _ _ p (raw.1 u) (raw.1 v)) ;
} ;
