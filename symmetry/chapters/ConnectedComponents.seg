-- Sections 2.16 and 2.22. Paths in the set truncation and decomposition.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module H = HLevels[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module FU = FunExtUA[l] ;
module Parts (X : U l) {
  module S = ChapterTwo[l].Truncate[suc zero,X] ;
  set : isSet S.carrier = H.trunc-set _ (S.op.trunc X) ;
  part (z : S.carrier) : U l = (x : X) * Id S.carrier (S.unit x) z ;
  connected (z : S.carrier) : Connected[l].isConn (suc (suc zero)) (part z) = S.op.conn X z ;
  decomposition : Equiv X ((z : S.carrier) * part z) = Bijection[l].inverse _ _
    FamilyClassifier[l].Over[S.carrier].Total[(X,S.unit)].equiv ;
  module PathsAt (x y : X) {
    actual : U l = Id X x y ; joined : U l = Id S.carrier (S.unit x) (S.unit y) ;
    encode : T.Trunc[actual].carrier -> joined = TC.rec actual @l joined (set _ _) (ap X S.carrier S.unit x y) ;
    decode (p : joined) : T.Trunc[actual].carrier = TC.map (Id (part (S.unit y)) (x,p) (y,refl (S.unit y))) actual
      (ap (part (S.unit y)) X (\ z -> z.1) _ _) (((connected (S.unit y)).2 (x,p) (y,refl (S.unit y))).1) ;
    equivalence : Equiv T.Trunc[actual].carrier joined = (encode,qinv _ _ encode decode
      (\ p -> set _ _ _ p) (\ h -> T.Trunc[actual].proposition _ h)) ;
  } ;
  module Test (P : S.carrier -> U l) (p : (z : S.carrier) -> isProp (P z)) {
    module Elim = S.Into[P,\ z -> H.prop-trunc (suc zero) (P z) (p z)] ;
  } ;
  contractible (h : Connected[l].isConn (suc (suc zero)) X) : FU.isContr S.carrier =
    TC.rec X @l _ (Torsor[l].isProp-isContr S.carrier) (\ x -> (S.unit x,
      Test[\ z -> Id S.carrier (S.unit x) z, set (S.unit x)].Elim.extend (\ y -> PathsAt[x,y].encode ((h.2 x y).1)))) h.1 ;
  converse (c : FU.isContr S.carrier) : Connected[l].isConn (suc (suc zero)) X =
    (TC.map (part c.1) X (\ z -> z.1) (connected c.1).1,\ x y ->
      (PathsAt[x,y].decode (FU.pathC S.carrier c (S.unit x) (S.unit y)),\ p q -> tt)) ;
} ;
-- Recognition of a set truncation by its points and its path relation.
module Recognition (X Y : U l) (set : isSet Y) (f : X -> Y)
  (onto : (y : Y) -> T.Trunc[(x : X) * Id Y (f x) y].carrier)
  (reflect : (x x' : X) -> Id Y (f x) (f x') -> T.Trunc[Id X x x'].carrier) {
  module C = Parts[X] ; module D = C.S.Into[\ z -> Y,\ z -> H.set-trunc Y set] ;
  map : C.S.carrier -> Y = D.extend f ;
  beta : (x : X) -> Id Y (map (C.S.unit x)) (f x) = D.computation f ;
  member (y : Y) : U l = (z : C.S.carrier) * Id Y (map z) y ;
  surj (y : Y) : T.Trunc[member y].carrier = TC.map ((x : X) * Id Y (f x) y) (member y)
    (\ w -> (C.S.unit w.1,transH (beta w.1) w.2)) (onto y) ;
  inj (u v : C.S.carrier) (p : Id Y (map u) (map v)) : Id C.S.carrier u v =
    TC.rec (C.part u) @l _ (C.set u v) (\ a -> TC.rec (C.part v) @l _ (C.set u v) (\ b ->
      transH (symH a.2) (transH (C.PathsAt[a.1,b.1].encode (reflect a.1 b.1 (transH (symH (beta a.1))
        (transH (apH map a.2) (transH p (transH (symH (apH map b.2)) (beta b.1))))))) b.2)) (C.connected v).1) (C.connected u).1 ;
  equivalence : Equiv C.S.carrier Y = (map,Bijection[l].Bij[C.S.carrier,Y,set,map,inj,surj].equiv) ;
} ;
module Subset (X : U l) (P : Parts[X].S.carrier -> U l) (p : (z : Parts[X].S.carrier) -> isProp (P z)) {
  module C = Parts[X] ; module S = ChapterTwo[l].Subtype[C.S.carrier,P,p] ;
  module Ux = ChapterTwo[l].Subtype[X,\ x -> P (C.S.unit x),\ x -> p (C.S.unit x)] ;
  map (w : Ux.total) : S.total = (C.S.unit w.1,w.2) ;
  set : isSet S.total = Torsor[l].isSet-sub C.S.carrier P C.set p ;
  fibre (z : S.total) : U l = (w : Ux.total) * Id S.total (map w) z ;
  pre (z : S.total) (w : C.part z.1) : Ux.total = (w.1,subst C.S.carrier P z.1 (C.S.unit w.1) (symH w.2) z.2) ;
  onto (z : S.total) : T.Trunc[fibre z].carrier = TC.map (C.part z.1) (fibre z)
    (\ w -> (pre z w,(S.At[map (pre z w)].paths z).2.sec w.2)) (C.connected z.1).1 ;
  reflect (u v : Ux.total) (q : Id S.total (map u) (map v)) : T.Trunc[Id Ux.total u v].carrier =
    TC.map (Id X u.1 v.1) (Id Ux.total u v) (Ux.At[u].paths v).2.sec
      (C.PathsAt[u.1,v.1].decode ((S.At[map u].paths (map v)).1 q)) ;
  module Result = Recognition[Ux.total,S.total,set,map,onto,reflect] ;
} ;
module AtGenerator (X : U l) (x : X) {
  module C = Parts[X] ;
  component : U l = (y : X) * T.Trunc[Id X x y].carrier ;
  paths (y : X) : Equiv (Id C.S.carrier (C.S.unit y) (C.S.unit x)) T.Trunc[Id X x y].carrier =
    Equivalences[l].compose _ _ _ (ConnectedMaps[l].sym-equiv C.S.carrier (C.S.unit y) (C.S.unit x))
      (Bijection[l].inverse _ _ C.PathsAt[x,y].equivalence) ;
  equivalence : Equiv (C.part (C.S.unit x)) component = Fibres[l].sigma-equiv X
    (\ y -> Id C.S.carrier (C.S.unit y) (C.S.unit x)) (\ y -> T.Trunc[Id X x y].carrier) paths ;
} ;
