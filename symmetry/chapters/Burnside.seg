-- Section 5.7. Count the pairs (g,x) with g.x = x one orbit at a time.
level u v ; open Base ; open Prelude[u \/ v] ; open Paths[u \/ v] ;
module E = Equivalences[u \/ v] ; module B = Bijection[u \/ v] ;
module T = Truncation[u \/ v] ; module TC = TruncationCombinators[u \/ v] ;
module F = FiniteSets[u \/ v] ; module A = FiniteArithmetic[u \/ v] ;
module C = Cardinality[u \/ v] ; module N = FiniteCounting[u \/ v] ;
module Law (G : ChapterFour[u].ConcreteGroup) (X : ChapterFive[u,v].Actions[G].GSet)
  (fg : FiniteSets[u].Finite (Id G.space G.point G.point)) (fx : FiniteSets[v].Finite (X G.point).1) {
  module H = FiniteActions[u,v].Action[G,X,fg,fx] ; module O = H.O ;
  stabilizer (x : O.carrier) : U (u \/ v) = H.Transporter[x,x].space ;
  module Block (q : O.orbits) {
    module Q = H.Orbit[q] ;
    bounded : F.Finite Q.fibre = A.sigma O.carrier H.fx (\ x -> Id O.orbits (O.orbit x) q)
      (\ x -> FiniteSubsets[u \/ v].Proposition[Id O.orbits (O.orbit x) q,H.orbit-set _ _].finite (H.discrete _ q)) ;
    space : U (u \/ v) = (z : Q.fibre) * stabilizer z.1 ;
    module Based (a : Q.fibre) {
      x : O.carrier = a.1 ;
      movers (z : Q.fibre) : U (u \/ v) = H.Transporter[x,z.1].space ;
      moved : U (u \/ v) = (z : Q.fibre) * movers z ;
      land (g : H.group) : Id O.orbits (O.orbit (O.act g x)) q =
        transH (symH (apH H.S.unit (H.Transporter[x,O.act g x].path (g,refl (O.act g x))))) a.2 ;
      label (g : H.group) : moved = ((O.act g x,land g),(g,refl (O.act g x))) ;
      eta (g : H.group) (y : O.carrier) (p : Id O.carrier (O.act g x) y) (r : Id O.orbits (O.orbit y) q) :
        Id moved (label g) ((y,r),(g,p)) = idJ O.carrier (O.act g x)
          (\ z t -> (h : Id O.orbits (O.orbit z) q) -> Id moved (label g) ((z,h),(g,t)))
          (\ h -> apH (\ k -> ((O.act g x,k),(g,refl (O.act g x)))) (H.orbit-set _ q (land g) h)) y p r ;
      index : Equiv moved H.group = (\ w -> w.2.1,qinv moved H.group (\ w -> w.2.1) label
        (\ g -> refl g) (\ w -> eta w.2.1 w.1.1 w.2.2 w.1.2)) ;
      paths (y z : O.carrier) : Equiv (Id O.total (H.point y) (H.point z)) H.Transporter[y,z].space =
        ConnectedMaps[u \/ v].sigma-paths G.space (\ b -> O.family b) (H.point y) (H.point z) ;
      shift (z : Q.fibre) (t : movers z) : Equiv (stabilizer z.1) (movers z) =
        E.compose _ _ _ (B.inverse _ _ (paths z.1 z.1))
          (E.compose _ _ _ (Fibres[u \/ v].trans-equiv O.total (H.point x) (H.point z.1) (H.point z.1)
            (H.Transporter[x,z.1].path t)) (paths x z.1)) ;
      compare (t : (z : Q.fibre) -> movers z) : Equiv space H.group =
        E.compose _ _ _ (Fibres[u \/ v].sigma-equiv Q.fibre (\ z -> stabilizer z.1) movers (\ z -> shift z (t z))) index ;
      witnesses : T.Trunc[(z : Q.fibre) -> movers z].carrier =
        F.choice Q.fibre bounded movers (\ z -> H.Transporter[x,z.1].backward (transH a.2 (symH z.2))) ;
      possible : T.Trunc[Equiv space H.group].carrier = TC.map ((z : Q.fibre) -> movers z) _ compare
        witnesses ;
      stab-finite : F.Finite (stabilizer x) = A.sigma H.group H.fg (H.Transporter[x,x].moves)
        (\ g -> FiniteSubsets[u \/ v].Proposition[H.Transporter[x,x].moves g,O.stabilizes-prop g x].finite
          (FiniteDecisions[u \/ v].On[O.carrier,H.fx].discrete (O.act g x) x)) ;
      -- Transport the second endpoint of a path while keeping its source fixed.
      at-target (z : Q.fibre) (t : movers z) : Equiv (movers z) (stabilizer x) =
        E.compose _ _ _ (B.inverse _ _ (paths x z.1))
          (E.compose _ _ _ (Axioms[u \/ v].idtoeqv _ _ (Prelude[(u \/ v)+].ap O.total (U (u \/ v)) (\ b -> Id O.total (H.point x) b) _ _
            (symH (H.Transporter[x,z.1].path t)))) (paths x x)) ;
      module Lagrange (t : (z : Q.fibre) -> movers z) {
        module Uniform = N.Uniform[Q.fibre,stabilizer x,bounded,stab-finite,movers,\ z -> at-target z (t z)] ;
        formula : Id Nat (Cardinality[u].Count[H.group].cardinal fg)
          (N.times (C.Count[Q.fibre].cardinal bounded) (C.Count[stabilizer x].cardinal stab-finite)) =
          transH (symH (FiniteLevels[u,u \/ v].At[H.group].same fg))
            (transH (symH (A.Change[moved,H.group,index].same Uniform.bounded H.fg)) Uniform.formula) ;
      } ;
      orbit-stabilizer : Id Nat (Cardinality[u].Count[H.group].cardinal fg)
        (N.times (C.Count[Q.fibre].cardinal bounded) (C.Count[stabilizer x].cardinal stab-finite)) =
        TC.rec ((z : Q.fibre) -> movers z) @(u \/ v) _ (NatArith[u \/ v].nat-set _ _) (\ t -> Lagrange[t].formula)
          witnesses ;
    } ;
    possible : T.Trunc[Equiv space H.group].carrier = TC.rec Q.fibre @(u \/ v) _ T.Trunc[Equiv space H.group].proposition
      (\ a -> Based[a].possible) Q.onto ;
  } ;
  grouped : U (u \/ v) = (q : O.orbits) * Block[q].space ;
  collect (w : H.pairs) : grouped = (O.orbit w.2.1,((w.2.1,refl (O.orbit w.2.1)),(w.1,w.2.2))) ;
  flatten (w : grouped) : H.pairs = (w.2.2.1,(w.2.1.1,w.2.2.2)) ;
  round (x : O.carrier) (t : stabilizer x) (q : O.orbits) (p : Id O.orbits (O.orbit x) q) :
    Id grouped (collect (t.1,(x,t.2))) (q,((x,p),t)) = idJ O.orbits (O.orbit x)
      (\ z h -> Id grouped (collect (t.1,(x,t.2))) (z,((x,h),t))) (refl (collect (t.1,(x,t.2)))) q p ;
  partition : Equiv H.pairs grouped = (collect,qinv _ _ collect flatten
    (\ w -> round w.2.1.1 w.2.2 w.1 w.2.1.2) (\ w -> refl w)) ;
  sizes : U (u \/ v) = (q : O.orbits) -> Equiv Block[q].space H.group ;
  module Count (e : sizes) {
    module Uniform = N.Uniform[O.orbits,H.group,H.orbits-finite,H.fg,\ q -> Block[q].space,e] ;
    formula : Id Nat (C.Count[H.pairs].cardinal H.pairs-finite)
      (N.times (C.Count[O.orbits].cardinal H.orbits-finite) (Cardinality[u].Count[H.group].cardinal fg)) =
      transH (A.Change[H.pairs,grouped,partition].same H.pairs-finite Uniform.bounded)
        (transH Uniform.formula (apH (N.times (C.Count[O.orbits].cardinal H.orbits-finite))
          (FiniteLevels[u,u \/ v].At[H.group].same fg))) ;
  } ;
  formula : Id Nat (C.Count[H.pairs].cardinal H.pairs-finite)
    (N.times (C.Count[O.orbits].cardinal H.orbits-finite) (Cardinality[u].Count[H.group].cardinal fg)) =
    TC.rec sizes @(u \/ v) _ (NatArith[u \/ v].nat-set _ _) (\ e -> Count[e].formula)
      (F.choice O.orbits H.orbits-finite (\ q -> Equiv Block[q].space H.group) (\ q -> Block[q].possible)) ;
  fixed-size (g : H.group) : Nat = Cardinality[v].Count[H.fixed g].cardinal (H.fixed-finite g) ;
  module Fixed = N.Weighted[H.group,H.fg,\ g -> H.fixed g,
    \ g -> FiniteLevels[v,u \/ v].At[H.fixed g].finite (H.fixed-finite g)] ;
  weights : Id (H.group -> Nat) Fixed.weight fixed-size =
    Axioms[u \/ v].FunExtLemmas[fe @(u \/ v)].funext H.group (\ g -> Nat) _ _
      (\ g -> FiniteLevels[v,u \/ v].At[H.fixed g].same (H.fixed-finite g)) ;
  sum-of-fixed-points : Id Nat N.Indexed[H.group,H.fg,fixed-size].value
    (N.times (C.Count[O.orbits].cardinal H.orbits-finite) (Cardinality[u].Count[H.group].cardinal fg)) =
    transH (symH (apH (\ f -> N.Indexed[H.group,H.fg,f].value) weights))
      (transH (symH Fixed.formula) formula) ;
} ;
