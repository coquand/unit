-- Sections 2.24 and 4.2. Finite choice also applies to an unlabelled finite set.
level l ;
open Base ; open Prelude[l] ;
module F = FinChoice[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
Finite (A : U l) : U l = T.Trunc[(n : Nat) * Equiv (F.Fin n) A].carrier ;
enumerated (A : U l) (n : Nat) (labels : Equiv (F.Fin n) A) : Finite A =
  T.Trunc[(k : Nat) * Equiv (F.Fin k) A].inc (n,labels) ;
Choice (A : U l) : U l+ = (P : A -> U l) -> ((a : A) -> T.Trunc[P a].carrier) ->
  T.Trunc[(a : A) -> P a].carrier ;
labelled (n : Nat) (A : U l) (e : Equiv (F.Fin n) A) : Choice A =
  Axioms[l].UnivalenceLemmas[univ @l].eqind (F.Fin n) (\ B d -> Choice B) (F.fc n) A e ;
choice (A : U l) (fin : Finite A) (P : A -> U l) (h : (a : A) -> T.Trunc[P a].carrier) :
  T.Trunc[(a : A) -> P a].carrier =
  TC.rec ((n : Nat) * Equiv (F.Fin n) A) @l (T.Trunc[(a : A) -> P a].carrier)
    T.Trunc[(a : A) -> P a].proposition (\ w -> labelled w.1 A w.2 P h) fin ;

module Products (I : U l) (finite : Finite I) (H : I -> ChapterFour[l].ConcreteGroup) {
  space : U l = (i : I) -> (H i).space ;
  point : space = \ i -> (H i).point ;
  reaches (v : space) : T.Trunc[Id space point v].carrier =
    TC.map ((i : I) -> Id (H i).space (point i) (v i)) (Id space point v)
      (FL.funext I (\ i -> (H i).space) point v)
      (choice I finite (\ i -> Id (H i).space (point i) (v i))
        (\ i -> ((H i).connected.2 (point i) (v i)).1)) ;
  group : ChapterFour[l].ConcreteGroup = new ChapterFour[l].ConcreteGroup[space,point,
    ChapterFour[l].Reachable[space,point,reaches].connected,
    HLevels[l].trunc-Pi ChapterFour[l].three I (\ i -> (H i).space) (\ i -> (H i).groupoid)] ;
} ;

-- Take the small image of the standard finite sets in the universe.
module Universe {
  module C = Completion[l].Complete[Nat,F.Fin] ;
  module Big = Prelude[l+] ;
  module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
  all : U l+ = (X : U l) * Finite X ;
  small : U l = C.base ;
  finite-prop (X : U l) : isProp (Finite X) = T.Trunc[(n : Nat) * Equiv (F.Fin n) X].proposition ;
  witness (z : small) : Finite (C.extension z) =
    (C.surjective @l (\ w -> Finite (C.extension w)) (\ w -> finite-prop (C.extension w))).sec
      (\ n -> T.Trunc[(k : Nat) * Equiv (F.Fin k) (C.extension (C.quotient n))].inc
        (n,Axioms[l].idtoeqv _ _ (Big.sym _ _ _ (C.triangle n)))) z ;
  forget (z : small) : all = (C.extension z,witness z) ;
  fiber (X : U l) : U l+ = (z : small) * Id (U l) (C.extension z) X ;
  unique (X : U l) : Big.isProp (fiber X) =
    Groupoid[l+].emb-fib-prop small (U l) C.extension C.image.embedding X ;
  locate (v : all) : fiber v.1 = TC.rec ((n : Nat) * Equiv (F.Fin n) v.1) @(l+)
    (fiber v.1) (unique v.1) (\ p -> (C.quotient p.1,Big.trans _ _ _ _ (C.triangle p.1)
      (Completion[l].UniversePaths[F.Fin p.1,v.1].decode p.2))) v.2 ;
  presentation : Big.Equiv small all = (forget,Big.qinv small all forget
    (\ v -> (locate v).1)
    (\ v -> Big.Sigma-eq (U l) (\ X -> Finite X) _ _ _ _ (locate v).2 (finite-prop v.1))
    (\ z -> Big.ap (fiber (C.extension z)) small (\ t -> t.1) _ _
      (unique (C.extension z) (locate (forget z)) (z,refl (C.extension z))))) ;
} ;
