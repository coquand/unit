-- Section 5.7. Count fixed points and orbits at the join of the two levels.
level u v ; open Base ; open Prelude[u \/ v] ; open Paths[u \/ v] ;
module J = FiniteSets[u \/ v] ; module D = FiniteDecisions[u \/ v] ; module A = FiniteArithmetic[u \/ v] ;
module L = Logic[u \/ v] ; module T = Truncation[u \/ v] ; module TC = TruncationCombinators[u \/ v] ;
module Action (G : ChapterFour[u].ConcreteGroup) (X : ChapterFive[u,v].Actions[G].GSet)
  (finiteG : FiniteSets[u].Finite (Id G.space G.point G.point))
  (finiteX : FiniteSets[v].Finite (X G.point).1) {
  module O = ChapterFive[u,v].Actions[G].On[X] ;
  group : U u = Id G.space G.point G.point ;
  fg : J.Finite group = FiniteLevels[u,u \/ v].At[group].finite finiteG ;
  fx : J.Finite O.carrier = FiniteLevels[v,u \/ v].At[O.carrier].finite finiteX ;
  module S = ChapterTwo[u \/ v].Truncate[suc zero,O.total] ;
  orbit-set : isSet O.orbits = HLevels[u \/ v].trunc-set _ (S.op.trunc O.total) ;
  point (x : O.carrier) : O.total = (G.point,x) ;
  fixed (g : group) : U v = (x : O.carrier) * O.stabilizes g x ;
  fixed-finite (g : group) : FiniteSets[v].Finite (fixed g) = FiniteArithmetic[v].sigma O.carrier finiteX (O.stabilizes g)
    (\ x -> FiniteSubsets[v].Proposition[O.stabilizes g x,O.stabilizes-prop g x].finite
      (FiniteDecisions[v].On[O.carrier,finiteX].discrete (O.act g x) x)) ;
  pairs : U (u \/ v) = (g : group) * fixed g ;
  pairs-finite : J.Finite pairs = A.sigma group fg (\ g -> fixed g)
    (\ g -> FiniteLevels[v,u \/ v].At[fixed g].finite (fixed-finite g)) ;
  module Orbit (q : O.orbits) {
    fibre : U (u \/ v) = (x : O.carrier) * Id O.orbits (O.orbit x) q ;
    mere : U (u \/ v) = T.Trunc[fibre].carrier ;
    from (z : G.space) (p : Id G.space G.point z) (x : O.family z) (h : Id O.orbits (S.unit (z,x)) q) : fibre =
      idJ G.space G.point (\ w s -> (y : O.family w) -> Id O.orbits (S.unit (w,y)) q -> fibre)
        (\ y t -> (y,t)) z p x h ;
    onto : mere = TC.rec ((z : O.total) * Id O.orbits (S.unit z) q) @(u \/ v) _ T.Trunc[fibre].proposition
      (\ w -> TruncationCombinators[u].rec (Id G.space G.point w.1.1) @(u \/ v) _ T.Trunc[fibre].proposition
        (\ p -> T.Trunc[fibre].inc (from w.1.1 p w.1.2 w.2)) (G.connected.2 G.point w.1.1).1) (S.op.conn O.total q).1 ;
  } ;
  module Transporter (x y : O.carrier) {
    moves (g : group) : U (u \/ v) = Id O.carrier (O.act g x) y ;
    space : U (u \/ v) = (g : group) * moves g ;
    path (t : space) : Id O.total (point x) (point y) = Sigma-path G.space (\ z -> O.family z) _ _ x y t.1 t.2 ;
    equality : U (u \/ v) = Id O.orbits (O.orbit x) (O.orbit y) ;
    forward : T.Trunc[space].carrier -> equality = TC.rec space @(u \/ v) equality (orbit-set _ _) (\ t -> apH S.unit (path t)) ;
    backward (p : equality) : T.Trunc[space].carrier =
      TC.map (Id ((z : O.total) * Id O.orbits (S.unit z) (O.orbit y)) (point x,p) (point y,refl (O.orbit y))) space
        (\ h -> sPath G.space (\ z -> O.family z) (point x) (point y) (apH (\ w -> w.1) h))
        (((S.op.conn O.total (O.orbit y)).2 (point x,p) (point y,refl (O.orbit y))).1) ;
    decide : L.Dec equality = D.transfer _ _ forward backward
      (D.Bounded[group,fg,moves,\ g -> D.On[O.carrier,fx].discrete (O.act g x) y].exists) ;
  } ;
  discrete (q r : O.orbits) : L.Dec (Id O.orbits q r) =
    TC.rec Orbit[q].fibre @(u \/ v) _ (L.dec-prop _ (orbit-set q r)) (\ a ->
      TC.rec Orbit[r].fibre @(u \/ v) _ (L.dec-prop _ (orbit-set q r)) (\ b ->
        subst O.orbits (\ z -> L.Dec (Id O.orbits q z)) _ r b.2
          (subst O.orbits (\ z -> L.Dec (Id O.orbits z (O.orbit b.1))) _ q a.2
            Transporter[a.1,b.1].decide)) Orbit[r].onto) Orbit[q].onto ;
  orbits-finite : J.Finite O.orbits = FiniteImages[u \/ v].Image[O.carrier,O.orbits,O.orbit,discrete,\ q -> Orbit[q].onto].finite fx ;
} ;
