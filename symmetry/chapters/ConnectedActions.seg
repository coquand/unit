-- Sections 3.6 and 5.2. A family over a connected pointed type has connected
-- total space precisely when the base fibre is inhabited and the action is transitive.
level l ;
open Base ; open Prelude[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Family (B : U l) (b : B) (connected : Connected[l].isConn (suc (suc zero)) B)
              (F : B -> U l) {
  total : U l = (z : B) * F z ;
  fibre : U l = F b ;
  hits (x y : fibre) : U l = (p : Id B b b) * Id fibre (subst B F b b p x) y ;
  relation (x y : fibre) : U l = Tr.Trunc[hits x y].carrier ;
  transitive : U l = (x y : fibre) -> relation x y ;
  inhabited : U l = Tr.Trunc[fibre].carrier ;
  path (x y : total) : U l = Tr.Trunc[Id total x y].carrier ;
  fibre-path (x y : fibre) (w : hits x y) : Id total (b,x) (b,y) =
    Sigma-path B F b b x y w.1 w.2 ;
  move-to-base (v : total) : inhabited = TC.map (Id B v.1 b) fibre
    (\ p -> subst B F v.1 b p v.2) ((connected.2 v.1 b).1) ;
  from-connected (c : Connected[l].isConn (suc (suc zero)) total) : inhabited * transitive =
    (TC.bind total fibre move-to-base c.1,\ x y -> TC.map (Id total (b,x) (b,y)) (hits x y)
      (sPath B F (b,x) (b,y)) ((c.2 (b,x) (b,y)).1)) ;
  lift-pair (h : transitive) (z z' : B) : (x : F z) (y : F z') -> path (z,x) (z',y) =
    Connected[l].conn-elim2 zero B b connected
      (\ u v -> (x : F u) (y : F v) -> path (u,x) (v,y))
      (\ u v -> FL.isProp-Pi (F u) (\ x -> (y : F v) -> path (u,x) (v,y))
         (\ x -> FL.isProp-Pi (F v) (\ y -> path (u,x) (v,y))
           (\ y -> Tr.Trunc[Id total (u,x) (v,y)].proposition)))
      (\ x y -> TC.map (hits x y) (Id total (b,x) (b,y)) (fibre-path x y) (h x y)) z z' ;
  to-connected (w : inhabited * transitive) : Connected[l].isConn (suc (suc zero)) total =
    (TC.map fibre total (\ x -> (b,x)) w.1,\ u v -> (lift-pair w.2 u.1 v.1 u.2 v.2,\ p q -> tt)) ;
} ;
module CircleCover (X : ChapterThree[l].Circle -> CircleBundles[l].Set) {
  module C = ChapterThree[l] ;
  fibre (z : C.Circle) : U l = (X z).1 ;
  module A = Family[C.Circle,C.base,C.K.conn1,fibre] ;
  power (n : Integers[l].Int) (x : A.fibre) : A.fibre =
    subst C.Circle fibre C.base C.base (C.K.unband C.base n) x ;
  integer-hit (x y : A.fibre) : U l = (n : Integers[l].Int) * Id A.fibre (power n x) y ;
  hits-equiv (x y : A.fibre) : Equiv (integer-hit x y) (A.hits x y) =
    ChapterTwo[l].change-base Integers[l].Int (Id C.Circle C.base C.base)
      (C.K.unband C.base,qinv _ _ (C.K.unband C.base) (C.K.band C.base)
        (C.K.unband-band C.base) (C.K.band-unband C.base))
      (\ p -> Id A.fibre (subst C.Circle fibre C.base C.base p x) y) ;
  cyclic : U l = A.inhabited * ((x y : A.fibre) -> Tr.Trunc[integer-hit x y].carrier) ;
  connected-cycle (c : Connected[l].isConn (suc (suc zero)) A.total) : cyclic =
    ((A.from-connected c).1,\ x y -> TC.map (A.hits x y) (integer-hit x y)
      (hits-equiv x y).2.sec ((A.from-connected c).2 x y)) ;
  cycle-connected (w : cyclic) : Connected[l].isConn (suc (suc zero)) A.total =
    A.to-connected (w.1,\ x y -> TC.map (integer-hit x y) (A.hits x y) (hits-equiv x y).1 (w.2 x y)) ;
} ;
