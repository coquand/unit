-- Section 4.7 and the pointed recognition criterion of 4.2.6.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module C = Connected[l] ; module H = HLevels[l] ;
module B = Prelude[l+] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
pointed : U l+ = (X : U l) * X ;
conn (w : pointed) : U l = C.isConn CG.two w.1 ;
groups : U l+ = (w : pointed) * conn w ;
space (G : groups) : U l = G.1.1 ; point (G : groups) : space G = G.1.2 ;
maps (G K : groups) : U l = Lemma4[l].PtMap (space G) (point G) (space K) (point K) ;
gpd (G : groups) : U l = H.isTrunc CG.three (space G) ;
module Ordinary = ChapterTwo[l+].Subtype[groups,\ G -> gpd G,\ G -> H.trunc-prop CG.three (space G)] ;
forget (G : CG.ConcreteGroup) : groups = ((G.space,G.point),G.connected) ;
pack (G : CG.ConcreteGroup) : Ordinary.total = (forget G,G.groupoid) ;
unpack (w : Ordinary.total) : CG.ConcreteGroup = new CG.ConcreteGroup[space w.1,point w.1,w.1.2,w.2] ;
presentation : B.Equiv CG.ConcreteGroup Ordinary.total = (pack,B.qinv _ _ pack unpack (\ w -> refl w) GroupIdentity[l].rebuild) ;
fib (G : groups) : U l+ = (K : CG.ConcreteGroup) * Id groups (forget K) G ;
module At (G : groups) {
  module F = ChapterTwo[l+].Projection[groups,\ K -> gpd K,G] ;
  classify : B.Equiv (fib G) (gpd G) = Equivalences[l+].compose _ _ _
    (ChapterTwo[l+].change-base CG.ConcreteGroup Ordinary.total presentation (\ w -> Id groups w.1 G)) F.equivalence ;
  embedding : B.isProp (fib G) = B.retract-prop _ _ classify.1 classify.2.sec (B.sec-ret _ _ classify.1 classify.2) (H.trunc-prop CG.three (space G)) ;
  loop-set : U l = isSet (Id (space G) (point G) (point G)) ;
  recognize (s : loop-set) : gpd G = C.conn-elim2 zero (space G) (point G) G.2
    (\ x y -> H.isTrunc CG.two (Id (space G) x y)) (\ x y -> H.trunc-prop CG.two (Id (space G) x y))
    (H.set-trunc _ s) ;
} ;
module Automorphisms (X : U l) (x : X) {
  module K = ConnectedLaws[l].Component[X,x] ;
  group : groups = ((K.S.total,K.base),K.connected) ;
  symmetries : Equiv (Id (space group) (point group) (point group)) (Id X x x) = K.S.At[K.base].paths K.base ;
} ;

-- 4.2.35 and 4.4.12. The identity of concrete groups is a pointed equivalence.
module ConnectedPart = ChapterTwo[l+].Subtype[pointed,\ v -> conn v,\ v -> C.conn-prop CG.two v.1] ;
module Identifications (G K : CG.ConcreteGroup) {
  module BH = HLevels[l+] ; module E = Equivalences[l+] ;
  hom-set : isSet (CG.Hom G K) = H.trunc-set _ (Lemma4[l].cor5-map CG.two (suc zero)
    G.space G.point G.connected K.space K.point K.groupoid) ;
  iso : U l = Lemma4[l].PtEquiv G.space G.point K.space K.point ;
  iso-set : isSet iso = H.trunc-set _ (Lemma4[l].cor5-equiv (suc zero) (suc zero)
    G.space G.point G.connected K.space K.point K.groupoid) ;
  pack-path : B.Equiv (Id CG.ConcreteGroup G K) (Id Ordinary.total (pack G) (pack K)) =
    (B.ap CG.ConcreteGroup Ordinary.total pack G K,FibreLevels[l+].Of[CG.ConcreteGroup,Ordinary.total,pack].reflect
      (\ v -> BH.contr-prop _ (FibrewiseEquivalence[l+].fibers _ _ presentation v)) G K) ;
  paths : B.Equiv (Id CG.ConcreteGroup G K) iso = E.compose _ _ _ pack-path (E.compose _ _ _
    (Ordinary.At[pack G].paths (pack K)) (E.compose _ _ _ (ConnectedPart.At[forget G].paths (forget K))
      (PointedIdentities[l].From[G.space,G.point].univalence (K.space,K.point)))) ;
  path-set : BH.isTrunc CG.two (Id CG.ConcreteGroup G K) = BH.equiv-trunc CG.two _ _ paths (BH.set-trunc _ iso-set) ;
} ;
groupoid : HLevels[l+].isTrunc CG.three CG.ConcreteGroup = \ G K -> Identifications[G,K].path-set ;
module Inner (G : CG.ConcreteGroup) {
  module Aut = ChapterFour[l+].Automorphisms[CG.ConcreteGroup,groupoid,G] ;
  at (x : G.space) : CG.ConcreteGroup = new CG.ConcreteGroup[G.space,x,G.connected,G.groupoid] ;
  eta : Id CG.ConcreteGroup (at G.point) G = GroupIdentity[l].rebuild G ;
  reach (x : G.space) : Aut.membership (at x) = TruncationCombinators[l].rec (Id G.space G.point x) @(l+) _
    Truncation[l+].Trunc[Id CG.ConcreteGroup G (at x)].proposition
    (\ p -> Truncation[l+].Trunc[Id CG.ConcreteGroup G (at x)].inc (Paths[l+].transH (Paths[l+].symH eta) (Paths[l+].apH at p)))
    ((G.connected.2 G.point x).1) ;
  inn : Lemma4[l+].PtMap G.space G.point Aut.group.space Aut.pt = (\ x -> (at x,reach x),
    B.Sigma-eq CG.ConcreteGroup Aut.membership _ _ _ _ eta Truncation[l+].Trunc[Id CG.ConcreteGroup G G].proposition) ;
} ;

module Repoint (G : groups) {
  at (y : space G) : groups = ((space G,y),G.2) ;
  merely (y : space G) : Truncation[l+].Trunc[Id groups G (at y)].carrier =
    TruncationCombinators[l].rec (Id (space G) (point G) y) @(l+) _ Truncation[l+].Trunc[Id groups G (at y)].proposition
      (\ p -> Truncation[l+].Trunc[Id groups G (at y)].inc (Paths[l+].apH at p)) ((G.2.2 (point G) y).1) ;
} ;

module Recognition (X : U l) (x : X) {
  reachable : U l = (y : X) -> Truncation[l].Trunc[Id X x y].carrier ;
  path-test : Equiv (C.isConn CG.two X) reachable = Bijection[l].prop-equiv _ _ (C.conn-prop CG.two X)
    (FL.isProp-Pi X (\ y -> Truncation[l].Trunc[Id X x y].carrier) (\ y -> Truncation[l].Trunc[Id X x y].proposition))
    (\ h y -> (h.2 x y).1) (\ h -> CG.Reachable[X,x,h].connected) ;
  module WithConnectivity (h : C.isConn CG.two X) {
    G : groups = ((X,x),h) ;
    loop-test : Equiv (gpd G) (At[G].loop-set) = Bijection[l].prop-equiv _ _ (H.trunc-prop CG.three X)
      (Torsor[l].isProp-isSet (Id X x x)) (\ k -> H.trunc-set _ (k x x)) At[G].recognize ;
  } ;
} ;

module RecognitionPresentation {
  data-at (w : pointed) : U l = Recognition[w.1,w.2].reachable * isSet (Id w.1 w.2 w.2) ;
  prop (w : pointed) : isProp (data-at w) = isProp-Sigma Recognition[w.1,w.2].reachable (\ a -> isSet (Id w.1 w.2 w.2))
    (FL.isProp-Pi w.1 (\ y -> Truncation[l].Trunc[Id w.1 w.2 y].carrier) (\ y -> Truncation[l].Trunc[Id w.1 w.2 y].proposition))
    (\ a -> Torsor[l].isProp-isSet (Id w.1 w.2 w.2)) ;
  total : U l+ = (w : pointed) * data-at w ;
  encode (G : CG.ConcreteGroup) : total = ((G.space,G.point),(\ y -> (G.connected.2 G.point y).1),H.trunc-set _ (G.groupoid G.point G.point)) ;
  module From (v : total) {
    module R = Recognition[v.1.1,v.1.2] ;
    c : C.isConn CG.two v.1.1 = R.path-test.2.sec v.2.1 ;
    group : CG.ConcreteGroup = new CG.ConcreteGroup[v.1.1,v.1.2,c,R.WithConnectivity[c].loop-test.2.sec v.2.2] ;
  } ;
  round (G : CG.ConcreteGroup) : Id CG.ConcreteGroup From[encode G].group G = GroupIdentity[l].concrete-path _ _
    (((\ x -> x),refl G.point),(idEquiv G.space).2) ;
  equivalence : B.Equiv CG.ConcreteGroup total = (encode,B.qinv _ _ encode (\ v -> From[v].group)
    (\ v -> B.Sigma-eq pointed (\ w -> data-at w) _ _ _ _ (refl v.1) (prop v.1)) round) ;
} ;
