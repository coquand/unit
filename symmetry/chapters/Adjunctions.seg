-- Definition 6.5.1 and the two triangle identities (Exercise 6.5.2).
level a b c d ;
open Base ; open Prelude[a \/ b \/ c \/ d] ; open Paths[a \/ b \/ c \/ d] ;
module H = Prelude[b \/ d] ; module KC = Category[a,b] ; module KD = Category[c,d] ;
module Wild (C : WildCategory[a,b].Wild) (D : WildCategory[c,d].Wild) (F : WildFunctors[a,b,c,d].Map[C,D]) (G : WildFunctors[c,d,a,b].Map[D,C]) {
  record Adjunction {
    transpose (x : C.ob) (y : D.ob) : H.Equiv (D.hom (F.obj x) y) (C.hom x (G.obj y)) ;
    pre (x w : C.ob) (y : D.ob) (u : C.hom w x) (v : D.hom (F.obj x) y) :
      Id (C.hom w (G.obj y)) ((transpose w y).1 (D.comp _ _ _ v (F.map _ _ u)))
        (C.comp _ _ _ ((transpose x y).1 v) u) ;
    post (x : C.ob) (y z : D.ob) (v : D.hom (F.obj x) y) (u : D.hom y z) :
      Id (C.hom x (G.obj z)) ((transpose x z).1 (D.comp _ _ _ u v))
        (C.comp _ _ _ (G.map _ _ u) ((transpose x y).1 v)) ;
  } ;
  module Triangles (A : Adjunction) {
    unit (x : C.ob) : C.hom x (G.obj (F.obj x)) = (A.transpose x (F.obj x)).1 (D.idn (F.obj x)) ;
    counit (y : D.ob) : D.hom (F.obj (G.obj y)) y = (A.transpose (G.obj y) y).2.sec (C.idn (G.obj y)) ;
    beta (y : D.ob) : Id (C.hom (G.obj y) (G.obj y)) ((A.transpose (G.obj y) y).1 (counit y)) (C.idn (G.obj y)) =
      (A.transpose (G.obj y) y).2.sec-eq (C.idn (G.obj y)) ;
    inject (X Y : U (b \/ d)) (e : H.Equiv X Y) (a b : X) (p : Id Y (e.1 a) (e.1 b)) : Id X a b =
      transH (symH (H.sec-ret X Y e.1 e.2 a)) (transH (apH e.2.sec p) (H.sec-ret X Y e.1 e.2 b)) ;
    natural (x w : C.ob) (y z : D.ob) (h0 : C.hom w x) (v : D.hom (F.obj x) y) (k : D.hom y z) :
      Id (C.hom w (G.obj z)) ((A.transpose w z).1 (D.comp _ _ _ k (D.comp _ _ _ v (F.map w x h0))))
        (C.comp _ _ _ (G.map _ _ k) (C.comp _ _ _ ((A.transpose x y).1 v) h0)) =
      transH (A.post w y z (D.comp _ _ _ v (F.map w x h0)) k) (apH (C.comp _ _ _ (G.map _ _ k)) (A.pre x w y h0 v)) ;
    counit-natural (x y : D.ob) (f : D.hom x y) :
      Id (D.hom (F.obj (G.obj x)) y) (D.comp _ _ _ f (counit x)) (D.comp _ _ _ (counit y) (F.map _ _ (G.map _ _ f))) =
      inject _ _ (A.transpose (G.obj x) y) _ _ (transH (A.post (G.obj x) x y (counit x) f)
        (transH (apH (C.comp _ _ _ (G.map _ _ f)) (beta x)) (transH (C.unit-r _ _ (G.map _ _ f))
          (symH (transH (A.pre (G.obj y) (G.obj x) y (G.map _ _ f) (counit y))
            (transH (apH (\ k -> C.comp _ _ _ k (G.map _ _ f)) (beta y)) (C.unit-l _ _ (G.map _ _ f)))))))) ;
    unit-natural (x y : C.ob) (f : C.hom x y) :
      Id (C.hom x (G.obj (F.obj y))) (C.comp _ _ _ (G.map _ _ (F.map x y f)) (unit x)) (C.comp _ _ _ (unit y) f) =
      transH (symH (A.post x (F.obj x) (F.obj y) (D.idn (F.obj x)) (F.map x y f)))
        (transH (apH (A.transpose x (F.obj y)).1 (transH (D.unit-r _ _ (F.map x y f)) (symH (D.unit-l _ _ (F.map x y f)))))
          (A.pre y x (F.obj y) f (D.idn (F.obj y)))) ;
    left (x : C.ob) : Id (D.hom (F.obj x) (F.obj x)) (D.comp _ _ _ (counit (F.obj x)) (F.map _ _ (unit x))) (D.idn (F.obj x)) =
      inject _ _ (A.transpose x (F.obj x)) _ _
        (transH (A.pre _ _ _ (unit x) (counit (F.obj x)))
          (transH (apH (\ h -> C.comp _ _ _ h (unit x)) (beta (F.obj x))) (C.unit-l _ _ (unit x)))) ;
    right (y : D.ob) : Id (C.hom (G.obj y) (G.obj y)) (C.comp _ _ _ (G.map _ _ (counit y)) (unit (G.obj y))) (C.idn (G.obj y)) =
      transH (symH (A.post _ _ _ (D.idn _) (counit y)))
        (transH (apH (A.transpose (G.obj y) y).1 (D.unit-r _ _ (counit y))) (beta y)) ;
  } ;
  module FromTriangles (unit : (x : C.ob) -> C.hom x (G.obj (F.obj x)))
    (counit : (y : D.ob) -> D.hom (F.obj (G.obj y)) y)
    (unit-nat : (x y : C.ob) (f : C.hom x y) -> Id (C.hom x (G.obj (F.obj y)))
      (C.comp _ _ _ (G.map _ _ (F.map _ _ f)) (unit x)) (C.comp _ _ _ (unit y) f))
    (counit-nat : (x y : D.ob) (f : D.hom x y) -> Id (D.hom (F.obj (G.obj x)) y)
      (D.comp _ _ _ f (counit x)) (D.comp _ _ _ (counit y) (F.map _ _ (G.map _ _ f))))
    (left : (x : C.ob) -> Id (D.hom (F.obj x) (F.obj x)) (D.comp _ _ _ (counit (F.obj x)) (F.map _ _ (unit x))) (D.idn _))
    (right : (y : D.ob) -> Id (C.hom (G.obj y) (G.obj y)) (C.comp _ _ _ (G.map _ _ (counit y)) (unit (G.obj y))) (C.idn _)) {
    forward (x : C.ob) (y : D.ob) (f : D.hom (F.obj x) y) : C.hom x (G.obj y) = C.comp _ _ _ (G.map _ _ f) (unit x) ;
    back (x : C.ob) (y : D.ob) (g : C.hom x (G.obj y)) : D.hom (F.obj x) y = D.comp _ _ _ (counit y) (F.map _ _ g) ;
    pre (x w : C.ob) (y : D.ob) (u : C.hom w x) (v : D.hom (F.obj x) y) :
      Id (C.hom w (G.obj y)) (forward w y (D.comp _ _ _ v (F.map _ _ u))) (C.comp _ _ _ (forward x y v) u) =
      transH (apH (\ k -> C.comp _ _ _ k (unit w)) (G.map-comp _ _ _ v (F.map _ _ u)))
        (transH (symH (C.assoc _ _ _ _ (unit w) (G.map _ _ (F.map _ _ u)) (G.map _ _ v)))
          (transH (apH (C.comp _ _ _ (G.map _ _ v)) (unit-nat w x u)) (C.assoc _ _ _ _ u (unit x) (G.map _ _ v)))) ;
    post (x : C.ob) (y z : D.ob) (v : D.hom (F.obj x) y) (u : D.hom y z) :
      Id (C.hom x (G.obj z)) (forward x z (D.comp _ _ _ u v)) (C.comp _ _ _ (G.map _ _ u) (forward x y v)) =
      transH (apH (\ k -> C.comp _ _ _ k (unit x)) (G.map-comp _ _ _ u v))
        (symH (C.assoc _ _ _ _ (unit x) (G.map _ _ v) (G.map _ _ u))) ;
    section (x : C.ob) (y : D.ob) (g : C.hom x (G.obj y)) : Id (C.hom x (G.obj y)) (forward x y (back x y g)) g =
      transH (pre (G.obj y) x y g (counit y)) (transH (apH (\ k -> C.comp _ _ _ k g) (right y)) (C.unit-l _ _ g)) ;
    module Retract (x : C.ob) (y : D.ob) (f : D.hom (F.obj x) y) {
      FX : D.ob = F.obj x ; FGFX : D.ob = F.obj (G.obj FX) ; FGY : D.ob = F.obj (G.obj y) ;
      u : D.hom FX FGFX = F.map x (G.obj FX) (unit x) ;
      v : D.hom FGFX FGY = F.map (G.obj FX) (G.obj y) (G.map FX y f) ;
      law : Id (D.hom FX y) (back x y (forward x y f)) f =
        calc (D.hom FX y) {
          back x y (forward x y f)
          =< apH (D.comp FX FGY y (counit y)) (F.map-comp x (G.obj FX) (G.obj y) (G.map FX y f) (unit x)) >
            D.comp FX FGY y (counit y) (D.comp FX FGFX FGY v u)
          =< D.assoc FX FGFX FGY y u v (counit y) > D.comp FX FGFX y (D.comp FGFX FGY y (counit y) v) u
          =< apH (\ k -> D.comp FX FGFX y k u) (symH (counit-nat FX y f)) > D.comp FX FGFX y (D.comp FGFX FX y f (counit FX)) u
          =< symH (D.assoc FX FGFX FX y u (counit FX) f) > D.comp FX FX y f (D.comp FX FGFX FX (counit FX) u)
          =< apH (D.comp FX FX y f) (left x) > D.comp FX FX y f (D.idn FX)
          =< D.unit-r FX y f > f } ;
    } ;
    adjunction : Adjunction = new Adjunction[\ x y -> (forward x y,H.qinv _ _ (forward x y) (back x y) (section x y) (\ f -> Retract[x,y,f].law)),pre,post] ;
  } ;
} ;
module Between (C : KC.Precategory) (D : KD.Precategory) (F : Functor[a,b,c,d].Functor[C,D]) (G : Functor[c,d,a,b].Functor[D,C]) {
  module General = Wild[WildCategory[a,b].forget C,WildCategory[c,d].forget D,
    WildFunctors[a,b,c,d].ordinary C D F,WildFunctors[c,d,a,b].ordinary D C G] ;
  record Adjunction {
    transpose (x : C.ob) (y : D.ob) : Equiv (D.hom (F.obj x) y) (C.hom x (G.obj y)) ;
    pre (x w : C.ob) (y : D.ob) (u : C.hom w x) (v : D.hom (F.obj x) y) :
      Id (C.hom w (G.obj y)) ((transpose w y).1 (D.comp _ _ _ v (F.map _ _ u)))
        (C.comp _ _ _ ((transpose x y).1 v) u) ;
    post (x : C.ob) (y z : D.ob) (v : D.hom (F.obj x) y) (u : D.hom y z) :
      Id (C.hom x (G.obj z)) ((transpose x z).1 (D.comp _ _ _ u v))
        (C.comp _ _ _ (G.map _ _ u) ((transpose x y).1 v)) ;
  } ;
  module Triangles (A : Adjunction) {
    module T = General.Triangles[new General.Adjunction[\ x y -> ((A.transpose x y).1,EquivalenceLemmas[b \/ d].lower @(a \/ b \/ c \/ d) _ _ (A.transpose x y).1 (A.transpose x y).2),A.pre,A.post]] ;
    unit (x : C.ob) : C.hom x (G.obj (F.obj x)) = T.unit x ;
    counit (y : D.ob) : D.hom (F.obj (G.obj y)) y = T.counit y ;
    beta (y : D.ob) : Id (C.hom (G.obj y) (G.obj y)) ((A.transpose (G.obj y) y).1 (counit y)) (C.idn (G.obj y)) = T.beta y ;
    inject (X Y : U (a \/ b \/ c \/ d)) (e : Equiv X Y) (a b : X) (p : Id Y (e.1 a) (e.1 b)) : Id X a b =
      transH (symH (sec-ret X Y e.1 e.2 a)) (transH (apH e.2.sec p) (sec-ret X Y e.1 e.2 b)) ;
    left (x : C.ob) : Id (D.hom (F.obj x) (F.obj x)) (D.comp _ _ _ (counit (F.obj x)) (F.map _ _ (unit x))) (D.idn (F.obj x)) = T.left x ;
    right (y : D.ob) : Id (C.hom (G.obj y) (G.obj y)) (C.comp _ _ _ (G.map _ _ (counit y)) (unit (G.obj y))) (C.idn (G.obj y)) = T.right y ;
  } ;
} ;
