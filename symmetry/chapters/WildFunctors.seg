-- Section 6.4. Functors and natural transformations with higher hom types.
level a b c d ; open Base ; open Paths[b \/ d] ;
module S = WildCategory[a,b] ; module T = WildCategory[c,d] ;
record Map (C : S.Wild) (D : T.Wild) {
  obj : C.ob -> D.ob ;
  map (x y : C.ob) : C.hom x y -> D.hom (obj x) (obj y) ;
  map-idn (x : C.ob) : Id (D.hom (obj x) (obj x)) (map x x (C.idn x)) (D.idn (obj x)) ;
  map-comp (x y z : C.ob) (g : C.hom y z) (f : C.hom x y) :
    Id (D.hom (obj x) (obj z)) (map x z (C.comp x y z g f)) (D.comp _ _ _ (map y z g) (map x y f)) ;
} ;
module Between (C : S.Wild) (D : T.Wild) {
  natural (F G : Map[C,D]) (t : (x : C.ob) -> D.hom (F.obj x) (G.obj x)) : U (a \/ b \/ d) =
    (x y : C.ob) (f : C.hom x y) -> Id (D.hom (F.obj x) (G.obj y))
      (D.comp _ _ _ (G.map x y f) (t x)) (D.comp _ _ _ (t y) (F.map x y f)) ;
  transformation (F G : Map[C,D]) : U (a \/ b \/ d) =
    (t : (x : C.ob) -> D.hom (F.obj x) (G.obj x)) * natural F G t ;
  module Action (F : Map[C,D]) {
    fully-faithful : U (a \/ b \/ d) = (x y : C.ob) -> Prelude[b \/ d].isEquiv (C.hom x y) (D.hom (F.obj x) (F.obj y)) (F.map x y) ;
    inverse-law (x y : C.ob) (f : C.hom x y) (g : C.hom y x) (p : Id (C.hom x x) (C.comp _ _ _ g f) (C.idn x)) :
      Id (D.hom (F.obj x) (F.obj x)) (D.comp _ _ _ (F.map y x g) (F.map x y f)) (D.idn (F.obj x)) =
      transH (symH (F.map-comp x y x g f)) (transH (apH (F.map x x) p) (F.map-idn x)) ;
    iso (x y : C.ob) (i : C.iso x y) : D.iso (F.obj x) (F.obj y) =
      (F.map x y i.1,(F.map y x i.2.1.1,inverse-law y x i.2.1.1 i.1 i.2.1.2),
        F.map y x i.2.2.1,inverse-law x y i.1 i.2.2.1 i.2.2.2) ;
  } ;
} ;
ordinary (C : Category[a,b].Precategory) (D : Category[c,d].Precategory) (F : Functor[a,b,c,d].Functor[C,D]) : Map[S.forget C,T.forget D] =
  new Map[S.forget C,T.forget D,F.obj,F.map,F.map-idn,F.map-comp] ;
-- When the target has hom sets, the two functor laws are propositions.
module Ext (C : S.Wild) (D : T.Wild) (sets : (x y : D.ob) -> Prelude[d].isSet (D.hom x y)) {
  module FL = Axioms[a \/ b \/ c \/ d].FunExtLemmas[fe @(a \/ b \/ c \/ d)] ;
  module P = Prelude[a \/ b \/ c \/ d] ;
  module At (obj : C.ob -> D.ob) {
    arrows : U (a \/ b \/ d) = (x y : C.ob) -> C.hom x y -> D.hom (obj x) (obj y) ;
    module On (f : arrows) {
      id-law : U (a \/ d) = (x : C.ob) -> Id (D.hom (obj x) (obj x)) (f x x (C.idn x)) (D.idn (obj x)) ;
      comp-law : U (a \/ b \/ d) = (x y z : C.ob) (g : C.hom y z) (k : C.hom x y) ->
        Id (D.hom (obj x) (obj z)) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k)) ;
      id-prop : P.isProp id-law = FL.isProp-Pi C.ob (\ x -> Id (D.hom (obj x) (obj x)) (f x x (C.idn x)) (D.idn (obj x)))
        (\ x -> sets _ _ (f x x (C.idn x)) _) ;
      comp-prop : P.isProp comp-law = FL.isProp-Pi (C.ob) (\ x -> (y : C.ob) (z : C.ob) (g : C.hom y z) (k : C.hom x y) -> Id (D.hom (obj x) (obj z)) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k)))
        (\ x -> FL.isProp-Pi (C.ob) (\ y -> (z : C.ob) (g : C.hom y z) (k : C.hom x y) -> Id (D.hom (obj x) (obj z)) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k)))
        (\ y -> FL.isProp-Pi (C.ob) (\ z -> (g : C.hom y z) (k : C.hom x y) -> Id (D.hom (obj x) (obj z)) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k)))
        (\ z -> FL.isProp-Pi (C.hom y z) (\ g -> (k : C.hom x y) -> Id (D.hom (obj x) (obj z)) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k)))
        (\ g -> FL.isProp-Pi (C.hom x y) (\ k -> Id (D.hom (obj x) (obj z)) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k)))
        (\ k -> sets (obj x) (obj z) (f x z (C.comp x y z g k)) (D.comp _ _ _ (f y z g) (f x y k))))))) ;
      laws : U (a \/ b \/ d) = id-law * comp-law ;
      prop : P.isProp laws = P.isProp-Sigma id-law (\ s -> comp-law) id-prop (\ s -> comp-prop) ;
    } ;
    raw : U (a \/ b \/ d) = (f : arrows) * On[f].laws ;
    build (r : raw) : Map[C,D] = new Map[C,D,obj,r.1,r.2.1,r.2.2] ;
    equal (r s : raw) (p : Id arrows r.1 s.1) : Id (Map[C,D]) (build r) (build s) =
      Prelude[a+ \/ b+ \/ c+ \/ d+].ap raw (Map[C,D]) build r s
        (P.Sigma-eq arrows (\ f -> On[f].laws) _ _ _ _ p On[s.1].prop) ;
  } ;
  eta : (F : Map[C,D]) -> Id (Map[C,D]) (At[F.obj].build (F.map,F.map-idn,F.map-comp)) F =
    split { Map f g i k -> refl (new Map[C,D,f,g,i,k]) } ;
} ;
module Full (C : S.Wild) (D : T.Wild) (f : Map[C,D]) {
  module P = Prelude[b \/ d] ;
  fiber (x y : C.ob) (v : D.hom (f.obj x) (f.obj y)) : U (b \/ d) = (u : C.hom x y) * Id (D.hom (f.obj x) (f.obj y)) (f.map x y u) v ;
  faithful : U (a \/ b \/ d) = (x y : C.ob) (v : D.hom (f.obj x) (f.obj y)) -> P.isProp (fiber x y v) ;
  full : U (a \/ b \/ d) = (x y : C.ob) (v : D.hom (f.obj x) (f.obj y)) -> Truncation[b \/ d].Trunc[fiber x y v].carrier ;
  module Both (i : faithful) (s : full) {
    get (x y : C.ob) (v : D.hom (f.obj x) (f.obj y)) : fiber x y v =
      TruncationCombinators[b \/ d].rec (fiber x y v) @(b \/ d) (fiber x y v) (i x y v) (\ t -> t) (s x y v) ;
    equivalent : Between[C,D].Action[f].fully-faithful = \ x y -> P.qinv _ _ (f.map x y) (\ v -> (get x y v).1)
      (\ v -> (get x y v).2) (\ u -> P.ap (fiber x y (f.map x y u)) (C.hom x y) (\ w -> w.1) _ _
        (i x y (f.map x y u) (get x y (f.map x y u)) (u,refl (f.map x y u)))) ;
  } ;
} ;
module IsoAction (C : S.Wild) (D : T.Wild) (f : Map[C,D]) (ff : Between[C,D].Action[f].fully-faithful) {
  module M = Between[C,D].Action[f] ; module P = Prelude[b \/ d] ;
  back (x y : C.ob) : D.hom (f.obj x) (f.obj y) -> C.hom x y = (ff x y).sec ;
  cancel (x y : C.ob) (g k : C.hom x y) (e : Id (D.hom (f.obj x) (f.obj y)) (f.map x y g) (f.map x y k)) : Id (C.hom x y) g k =
    transH (symH (P.sec-ret _ _ _ (ff x y) g)) (transH (apH (back x y) e) (P.sec-ret _ _ _ (ff x y) k)) ;
  law (x y : C.ob) (k : D.hom (f.obj x) (f.obj y)) (g : D.hom (f.obj y) (f.obj x))
    (p : Id (D.hom (f.obj x) (f.obj x)) (D.comp _ _ _ g k) (D.idn (f.obj x))) :
    Id (C.hom x x) (C.comp _ _ _ (back y x g) (back x y k)) (C.idn x) =
    cancel x x _ _ (transH (f.map-comp x y x (back y x g) (back x y k))
      (transH (apH (\ v -> D.comp _ _ _ v (f.map x y (back x y k))) ((ff y x).sec-eq g))
        (transH (apH (D.comp _ _ _ g) ((ff x y).sec-eq k)) (transH p (symH (f.map-idn x)))))) ;
  inverse (x y : C.ob) (i : D.iso (f.obj x) (f.obj y)) : C.iso x y =
    (back x y i.1,(back y x i.2.1.1,law y x i.2.1.1 i.1 i.2.1.2),back y x i.2.2.1,law x y i.1 i.2.2.1 i.2.2.2) ;
  equivalence (x y : C.ob) : P.Equiv (C.iso x y) (D.iso (f.obj x) (f.obj y)) = (M.iso x y,P.qinv _ _ (M.iso x y) (inverse x y)
    (\ i -> Prelude[d].Sigma-eq (D.hom (f.obj x) (f.obj y)) (\ k -> WildIsos[c,d].At[D,f.obj x,f.obj y,k].data-inv) _ _ _ _
      ((ff x y).sec-eq i.1) WildIsos[c,d].At[D,f.obj x,f.obj y,i.1].prop)
    (\ i -> Prelude[b].Sigma-eq (C.hom x y) (\ k -> WildIsos[a,b].At[C,x,y,k].data-inv) _ _ _ _
      (P.sec-ret _ _ _ (ff x y) i.1) WildIsos[a,b].At[C,x,y,i.1].prop)) ;
  reflect (x y : C.ob) (k : C.hom x y) (i : WildIsos[c,d].At[D,f.obj x,f.obj y,f.map x y k].data-inv) :
    WildIsos[a,b].At[C,x,y,k].data-inv = Prelude[b].subst _ (\ t -> WildIsos[a,b].At[C,x,y,t].data-inv) _ k
      (P.sec-ret _ _ _ (ff x y) k) (inverse x y (f.map x y k,i)).2 ;
  module Objects (uc : C.univalent) (ud : D.univalent) (x y : C.ob) {
    module B = Prelude[a \/ b \/ c \/ d] ; module L = EquivalenceLemmas[a \/ b \/ c \/ d] ;
    module T0 = Paths[a \/ b \/ c \/ d] ;
    v : B.Equiv (Id D.ob (f.obj x) (f.obj y)) (D.iso (f.obj x) (f.obj y)) = (D.idtoiso _ _,B.qinv _ _ (D.idtoiso (f.obj x) (f.obj y))
      (ud (f.obj x) (f.obj y)).sec (ud (f.obj x) (f.obj y)).sec-eq (Prelude[c \/ d].sec-ret _ _ _ (ud (f.obj x) (f.obj y)))) ;
    action (z : C.ob) (p : Id C.ob x z) : Id (D.iso (f.obj x) (f.obj z)) (M.iso x z (C.idtoiso x z p)) (D.idtoiso _ _ (T0.apH f.obj p)) =
      idJ C.ob x (\ w q -> Id (D.iso (f.obj x) (f.obj w)) (M.iso x w (C.idtoiso x w q)) (D.idtoiso _ _ (T0.apH f.obj q)))
        (Prelude[d].Sigma-eq _ (\ k -> WildIsos[c,d].At[D,f.obj x,f.obj x,k].data-inv) _ _ _ _ (f.map-idn x)
          WildIsos[c,d].At[D,f.obj x,f.obj x,D.idn (f.obj x)].prop) z p ;
    i : B.Equiv (C.iso x y) (D.iso (f.obj x) (f.obj y)) = (M.iso x y,B.qinv _ _ (M.iso x y) (equivalence x y).2.sec
      (equivalence x y).2.sec-eq (P.sec-ret _ _ _ (equivalence x y).2)) ;
    u : B.Equiv (Id C.ob x y) (C.iso x y) = (C.idtoiso x y,B.qinv _ _ (C.idtoiso x y) (uc x y).sec (uc x y).sec-eq (Prelude[a \/ b].sec-ret _ _ _ (uc x y))) ;
    composite : B.Equiv (Id C.ob x y) (Id D.ob (f.obj x) (f.obj y)) = L.then _ _ _ (L.then _ _ _ u i) (L.inverse _ _ v) ;
    embedding : B.isEquiv (Id C.ob x y) (Id D.ob (f.obj x) (f.obj y)) (B.ap C.ob D.ob f.obj x y) = L.homotopy _ _ composite.1 (B.ap C.ob D.ob f.obj x y)
      (\ p -> T0.transH (T0.apH v.2.sec (action y p)) (B.sec-ret _ _ _ v.2 (T0.apH f.obj p))) composite.2 ;
  } ;
} ;
