-- Exercise 4.6.9. Recover both cycle symmetries from an isomorphism of products.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = BicycleSymmetries[l] ; module I = IntegerIteration[l] ; module CC = CycleComponents[l] ;
module C = CycleRootFibres[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Big = Prelude[l+] ; module BP = Paths[l+] ; module E = Equivalences[l] ;
module At (c : C.Cycle) {
  X : U l = c.1.1.1 ; set : isSet X = c.1.1.2 ; t : Equiv X X = c.1.2 ;
  module V = C.ConnectedPermutation[c.1] ;
  module Constant (Y : U l) (s : isSet Y) (f : X -> Y) (h : (x : X) -> Id Y (f (t.1 x)) (f x)) {
    step (x : X) (k : Integers[l].Int) : Id Y (f (V.A.power k x)) (f x) = transH (I.Map[X,Y,t,idEquiv Y,f,h].at x k)
      (symH (I.Orbit[Y,idEquiv Y].Unique[f x,\ j -> f x,refl (f x),\ j -> refl (f x)].at k)) ;
    all (x y : X) : Id Y (f x) (f y) = TC.rec (V.walk x y) @l _ (s _ _) (\ w -> transH (symH (step x w.1)) (apH f w.2)) (c.2.2 x y) ;
  } ;
} ;
module Product (c d : C.Cycle) {
  module X = At[c] ; module Y = At[d] ; span : U l = X.X * Y.X ;
  a : Equiv span span = E.product X.X X.X Y.X X.t ;
  b : Equiv span span = Fibres[l].sigma-equiv X.X (\ x -> Y.X) (\ x -> Y.X) (\ x -> Y.t) ;
  module R = BicycleExamples[l].Routes[span,a,b] ; module Word = R.A ;
  xwalk (x x' : X.X) (y : Y.X) (w : X.V.walk x x') : Word.route (x,y) (x',y) = (cons (left w.1) nil,
    transH (symH (I.Map[X.X,span,X.t,a,\ z -> (z,y),\ z -> refl (X.t.1 z,y)].at x w.1))
      (ap X.X span (\ z -> (z,y)) _ _ w.2)) ;
  ywalk (x : X.X) (y y' : Y.X) (w : Y.V.walk y y') : Word.route (x,y) (x,y') = (cons (right w.1) nil,
    transH (symH (I.Map[Y.X,span,Y.t,b,\ z -> (x,z),\ z -> refl (x,Y.t.1 z)].at y w.1))
      (ap Y.X span (\ z -> (x,z)) _ _ w.2)) ;
  product : B.Bicycle = new B.Bicycle[span,isSet-Sigma X.X (\ x -> Y.X) X.set (\ x -> Y.set),a,b,
    TC.pair X.X Y.X c.2.1 d.2.1,\ v w -> TC.map2 (X.V.walk v.1 w.1) (Y.V.walk v.2 w.2) (Word.route v w)
      (\ p q -> R.then-route v (w.1,v.2) w (xwalk v.1 w.1 v.2 p) (ywalk w.1 v.2 w.2 q)) (c.2.2 v.1 w.1) (d.2.2 v.2 w.2)] ;
  commute (z : span) : Id span (a.1 (b.1 z)) (b.1 (a.1 z)) = refl (X.t.1 z.1,Y.t.1 z.2) ;
} ;
pair : U l+ = C.Cycle * C.Cycle ;
product (w : pair) : B.Bicycle = Product[w.1,w.2].product ;
module Maps (u v : pair) {
  module A = Product[u.1,u.2] ; module D = Product[v.1,v.2] ; module M = B.Maps[A.product,D.product] ;
  left : U l = CC.From[u.1.1].Iso v.1.1 ; right : U l = CC.From[u.2.1].Iso v.2.1 ;
  both : U l = left * right ;
  make (h : both) : M.iso = (E.compose _ _ _ (E.product _ _ A.Y.X h.1.1)
    (Fibres[l].sigma-equiv D.X.X (\ x -> A.Y.X) (\ x -> D.Y.X) (\ x -> h.2.1)),
    (\ w -> ap D.X.X D.span (\ x -> (x,h.2.1.1 w.2)) _ _ (h.1.2 w.1)),
    \ w -> ap D.Y.X D.span (\ y -> (h.1.1.1 w.1,y)) _ _ (h.2.2 w.2)) ;
  module Split (e : M.iso) (x0 : A.X.X) (y0 : A.Y.X) {
    f (x : A.X.X) : D.X.X = (e.1.1 (x,y0)).1 ; g (y : A.Y.X) : D.Y.X = (e.1.1 (x0,y)).2 ;
    fst-at (x : A.X.X) (y : A.Y.X) : Id D.X.X (f x) (e.1.1 (x,y)).1 = A.Y.Constant[D.X.X,D.X.set,
      \ z -> (e.1.1 (x,z)).1,\ z -> ap D.span D.X.X (\ w -> w.1) _ _ (e.2.2 (x,z))].all y0 y ;
    snd-at (x : A.X.X) (y : A.Y.X) : Id D.Y.X (g y) (e.1.1 (x,y)).2 = A.X.Constant[D.Y.X,D.Y.set,
      \ z -> (e.1.1 (z,y)).2,\ z -> ap D.span D.Y.X (\ w -> w.2) _ _ (e.2.1 (z,y))].all x0 x ;
    inverse-x (x : D.X.X) : A.X.X = (e.1.2.sec (x,g y0)).1 ;
    inverse-y (y : D.Y.X) : A.Y.X = (e.1.2.sec (f x0,y)).2 ;
    beta-x (x : D.X.X) : Id D.X.X (f (inverse-x x)) x = transH (fst-at (inverse-x x) (e.1.2.sec (x,g y0)).2)
      (ap D.span D.X.X (\ w -> w.1) _ _ (e.1.2.sec-eq (x,g y0))) ;
    beta-y (y : D.Y.X) : Id D.Y.X (g (inverse-y y)) y = transH (snd-at (e.1.2.sec (f x0,y)).1 (inverse-y y))
      (ap D.span D.Y.X (\ w -> w.2) _ _ (e.1.2.sec-eq (f x0,y))) ;
    eta-x (x : A.X.X) : Id A.X.X (inverse-x (f x)) x = ap A.span A.X.X (\ z -> z.1) _ _
      (transH (apH e.1.2.sec (ap D.Y.X D.span (\ y -> (f x,y)) _ _ (snd-at x y0))) (sec-ret _ _ e.1.1 e.1.2 (x,y0))) ;
    eta-y (y : A.Y.X) : Id A.Y.X (inverse-y (g y)) y = ap A.span A.Y.X (\ z -> z.2) _ _
      (transH (apH e.1.2.sec (ap D.X.X D.span (\ x -> (x,g y)) _ _ (fst-at x0 y))) (sec-ret _ _ e.1.1 e.1.2 (x0,y))) ;
    data-pair : both = (((f,qinv _ _ f inverse-x beta-x eta-x),\ x -> ap D.span D.X.X (\ w -> w.1) _ _ (e.2.1 (x,y0))),
      (g,qinv _ _ g inverse-y beta-y eta-y),\ y -> ap D.span D.Y.X (\ w -> w.2) _ _ (e.2.2 (x0,y))) ;
    beta : Id M.iso (make data-pair) e = M.injective (x0,y0) _ _ (refl (e.1.1 (x0,y0))) ;
  } ;
  module Based (x0 : A.X.X) (y0 : A.Y.X) {
    separate (e : M.iso) : both = Split[e,x0,y0].data-pair ;
    eta (h : both) : Id both (separate (make h)) h = GroupIdentity[l].pairs left right _ _ _ _
      (Sigma-eq _ (\ e -> CC.From[u.1.1].Comm D.X.X e D.X.t) _ _ _ _
        (PermutationCount[l].ext _ _ _ _ (\ x -> refl (h.1.1.1 x))) (CC.From[u.1.1].law-prop D.X.X D.X.set h.1.1 D.X.t))
      (Sigma-eq _ (\ e -> CC.From[u.2.1].Comm D.Y.X e D.Y.t) _ _ _ _
        (PermutationCount[l].ext _ _ _ _ (\ y -> refl (h.2.1.1 y))) (CC.From[u.2.1].law-prop D.Y.X D.Y.set h.2.1 D.Y.t)) ;
    equiv : isEquiv both M.iso make = qinv _ _ make separate (\ e -> Split[e,x0,y0].beta) eta ;
  } ;
  equivalence : Equiv both M.iso = (make,TC.rec A.X.X @l _ (EquivProp[l].isEquiv-prop _ _ make)
    (\ x -> TC.rec A.Y.X @l _ (EquivProp[l].isEquiv-prop _ _ make) (\ y -> Based[x,y].equiv) u.2.2.1) u.1.2.1) ;
} ;
module PathsOf (u : pair) {
  module BE = Equivalences[l+] ;
  cycle (c d : C.Cycle) : Big.Equiv (Id C.Cycle c d) (CC.From[c.1].Iso d.1) = BE.compose _ _ _ (C.Sub.At[c].paths d)
    (CC.From[c.1].IdSystem.tr d.1,CC.From[c.1].IdSystem.equiv d.1) ;
  ids (v : pair) : U l+ = Id C.Cycle u.1 v.1 * Id C.Cycle u.2 v.2 ;
  separate (v : pair) (p : Id pair u v) : ids v = (BP.apH (\ z -> z.1) p,BP.apH (\ z -> z.2) p) ;
  join (v : pair) (w : ids v) : Id pair u v = GroupIdentity[l+].pairs C.Cycle C.Cycle _ _ _ _ w.1 w.2 ;
  same (v : pair) (p : Id pair u v) : Id (Id pair u v) (join v (separate v p)) p =
    idJ pair u (\ z q -> Id (Id pair u z) (join z (separate z q)) q) (refl (refl u)) v p ;
  beta (x : C.Cycle) (p : Id C.Cycle u.1 x) (y : C.Cycle) (q : Id C.Cycle u.2 y) : Id (ids (x,y)) (separate (x,y) (join (x,y) (p,q))) (p,q) =
    idJ C.Cycle u.1 (\ c a -> (d : C.Cycle) (b : Id C.Cycle u.2 d) -> Id (ids (c,d)) (separate (c,d) (join (c,d) (a,b))) (a,b))
      (\ d b -> idJ C.Cycle u.2 (\ z r -> Id (ids (u.1,z)) (separate (u.1,z) (join (u.1,z) (refl u.1,r))) (refl u.1,r))
        (refl (separate u (refl u))) d b) x p y q ;
  coords (v : pair) : Big.Equiv (Id pair u v) (Maps[u,v].M.iso) = BE.compose (Id pair u v) (ids v) (Maps[u,v].M.iso) (separate v,Big.qinv _ _ (separate v) (join v)
    (\ w -> beta v.1 w.1 v.2 w.2) (same v)) (BE.compose _ _ _
      (BE.product (Id C.Cycle u.1 v.1) (Maps[u,v].left) (Id C.Cycle u.2 v.2) (cycle u.1 v.1)) (BE.compose _ _ _ (Fibres[l+].sigma-equiv (Maps[u,v].left)
        (\ x -> Id C.Cycle u.2 v.2) (\ x -> Maps[u,v].right) (\ x -> cycle u.2 v.2))
        (UniverseChange[l+,l].raise-equiv _ _ Maps[u,v].equivalence))) ;
  module G = B.Identity[product u] ;
  encode (v : pair) (p : Id pair u v) : Maps[u,v].M.iso = (G.equivalence (product v)).1 (BP.apH product p) ;
  law (v : pair) (p : Id pair u v) : Id (Maps[u,v].M.iso) (encode v p) ((coords v).1 p) =
    idJ pair u (\ z r -> Id (Maps[u,z].M.iso) (encode z r) ((coords z).1 r)) (Maps[u,u].M.eq _ _ (\ w -> refl w)) v p ;
  embedding (v : pair) : Big.isEquiv (Id pair u v) (Id B.Bicycle (product u) (product v)) (Big.ap pair B.Bicycle product u v) =
    Whitehead[l+].cancel-equiv _ _ _ (Big.ap pair B.Bicycle product u v) (G.equivalence (product v)).1 (G.equivalence (product v)).2
       (BE.homotopy _ _ (coords v) (encode v) (law v)) ;
} ;
-- The commuting bicycle with both generators the Boolean swap cannot be a product.
module Diagonal {
  a : Equiv Bool Bool = TwoElementSets[l].Booleans.flip ; module R = BicycleExamples[l].Routes[Bool,a,a] ;
  path : (y : Bool) -> R.A.route false y = split { false -> (nil,refl false) ; true -> (cons (left (pos (suc zero))) nil,refl true) } ;
  bicycle : B.Bicycle = R.Based[false,path].bicycle Z2[l].bool-set ;
  commuting (b : Bool) : Id Bool (a.1 (a.1 b)) (a.1 (a.1 b)) = refl (a.1 (a.1 b)) ;
  module Not (u : pair) (e : B.Maps[bicycle,product u].iso) {
    module P = Product[u.1,u.2] ;
    w : P.span = e.1.1 false ;
    same : Id P.span (P.a.1 w) (P.b.1 w) = transH (symH (e.2.1 false)) (e.2.2 false) ;
    fixed : Id P.span (P.a.1 w) w = ap P.X.X P.span (\ x -> (x,w.2)) _ _ (ap P.span P.X.X (\ z -> z.1) _ _ same) ;
    contradiction : Empty = TruthValues[l].separate (E.injective _ _ e.1.1 e.1.2 true false (transH (e.2.1 false) fixed)) ;
  } ;
  outside (u : pair) (p : Id B.Bicycle bicycle (product u)) : Empty = Not[u,(B.Identity[bicycle].equivalence (product u)).1 p].contradiction ;
} ;
