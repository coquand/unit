-- Section 2.24. A list is a length together with a table indexed by Fin.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module H = HLevels[l] ;
module Lists (X : U l) {
  list : U l = Ring[l].List X ;
  table : U l = (n : Nat) * (Fin n -> X) ;
  start : table = (zero,fin-zero (\ i -> X)) ;
  push (x : X) (t : table) : table = (suc t.1,combine t.1 (\ i -> X) x t.2) ;
  lookup : list -> table = split { nil -> start ; cons x xs | r -> push x r } ;
  build : (n : Nat) -> (Fin n -> X) -> list = split {
    zero -> \ f -> nil ; suc n | r -> \ f -> cons (f none) (r (\ i -> f (some i))) } ;
  rebuild : (xs : list) -> Id list (build (lookup xs).1 (lookup xs).2) xs = split {
    nil -> refl nil ; cons x xs | r -> apH (\ t -> cons x t) r } ;
  entries (n : Nat) (f : Fin (suc n) -> X) : (i : Fin (suc n)) ->
    Id X (combine n (\ j -> X) (f none) (\ j -> f (some j)) i) (f i) = split {
      none -> refl (f none) ; some j -> refl (f (some j)) } ;
  reread : (n : Nat) (f : Fin n -> X) -> Id table (lookup (build n f)) (n,f) = split {
    zero -> \ f -> apH (\ g -> (zero,g))
      (FL.funext (Fin zero) (\ i -> X) start.2 f (fin-zero (\ i -> Id X (start.2 i) (f i)))) ;
    suc n | r -> \ f -> transH (apH (push (f none)) (r (\ i -> f (some i))))
      (ap (Fin (suc n) -> X) table (\ g -> (suc n,g)) (combine n (\ i -> X) (f none) (\ i -> f (some i))) f (FL.funext (Fin (suc n)) (\ i -> X) (combine n (\ i -> X) (f none) (\ i -> f (some i))) f (entries n f))) } ;
  equivalence : Equiv list table = (lookup,qinv list table lookup (\ t -> build t.1 t.2)
    (\ t -> reread t.1 t.2) rebuild) ;
  two : Nat = suc (suc zero) ;
  truncated (n : Nat) (h : H.isTrunc (NatArith[l].plus n two) X) : H.isTrunc (NatArith[l].plus n two) list =
    H.equiv-trunc _ list table equivalence (H.trunc-Sigma _ Nat (\ k -> Fin k -> X)
      (H.trunc-lift two Nat (H.set-trunc Nat NatArith[l].nat-set) n)
      (\ k -> H.trunc-Pi _ (Fin k) (\ i -> X) (\ i -> h))) ;
  append : list -> list -> list = split { nil -> \ ys -> ys ; cons x xs | r -> \ ys -> cons x (r ys) } ;
  reverse : list -> list = split { nil -> nil ; cons x xs | r -> append r (cons x nil) } ;
  associative : (xs ys zs : list) -> Id list (append xs (append ys zs)) (append (append xs ys) zs) = split {
    nil -> \ ys zs -> refl (append ys zs) ; cons x xs | r -> \ ys zs -> apH (\ w -> cons x w) (r ys zs) } ;
  module Contractible (c : FunExtUA[l].isContr X) {
    fill (n : Nat) : table = (n,\ i -> c.1) ;
    section (w : table) : Id table (fill w.1) w = ap (Fin w.1 -> X) table (\ g -> (w.1,g)) _ _
      (FL.funext (Fin w.1) (\ i -> X) _ w.2 (\ i -> c.2 (w.2 i))) ;
    length : Equiv list Nat = Equivalences[l].compose list table Nat equivalence
      ((\ w -> w.1),qinv table Nat (\ w -> w.1) fill (\ n -> refl n) section) ;
  } ;
} ;
