-- Section 6.2. Sets form a univalent category; objects and arrows live one level apart.
level l ; open Base ; open Prelude[l] ; open Paths[l+] ;
module Big = Prelude[l+] ; module K = Category[l+,l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
ob : U l+ = (X : U l) * isSet X ;
hom (X Y : ob) : U l = X.1 -> Y.1 ;
pre : K.Precategory = new K.Precategory[ob,hom,\ X Y -> FL.isSet-Pi X.1 (\ x -> Y.1) (\ x -> Y.2),
  \ X x -> x,\ X Y Z g f x -> g (f x),\ X Y f -> refl f,\ X Y f -> refl f,
  \ W X Y Z f g k -> refl (\ w -> k (g (f w)))] ;
set-prop (X : U l) : isProp (isSet X) = FL.isProp-Pi X (\ x -> (y : X) -> isProp (Id X x y))
  (\ x -> FL.isProp-Pi X (\ y -> isProp (Id X x y)) (\ y -> FL.isProp-isProp (Id X x y))) ;
module At (X : ob) {
  module S = K.Singletons[pre] ;
  center : S.Singl X = (X,pre.iso-id X) ;
  pack (Y : U l) (e : Equiv X.1 Y) (s : isSet Y) : S.Singl X =
    ((Y,s),e.1,e.2.sec,FL.funext X.1 (\ x -> X.1) _ _ (sec-ret X.1 Y e.1 e.2),FL.funext Y (\ y -> Y) _ _ e.2.sec-eq) ;
  start (s : isSet X.1) : Id (S.Singl X) center (pack X.1 (idEquiv X.1) s) =
    transH (Big.ap (pre.Iso X X) (S.Singl X) (\ i -> (X,i)) _ _
      (Arrows[l+,l].Arrows[pre].iso-eq (pre.iso-id X) (pack X.1 (idEquiv X.1) X.2).2 (refl (\ x -> x))))
      (apH (pack X.1 (idEquiv X.1)) (set-prop X.1 X.2 s)) ;
  extend (Y : U l) (e : Equiv X.1 Y) : (s : isSet Y) -> Id (S.Singl X) center (pack Y e s) =
    Axioms[l].UnivalenceLemmas[univ @l].eqind X.1
      (\ Z k -> (s : isSet Z) -> Id (S.Singl X) center (pack Z k s)) start Y e ;
  equiv (Y : ob) (i : pre.Iso X Y) : Equiv X.1 Y.1 = (i.1,qinv _ _ i.1 i.2.1
    (happly Y.1 (\ y -> Y.1) _ _ i.2.2.2) (happly X.1 (\ x -> X.1) _ _ i.2.2.1)) ;
  contract (v : S.Singl X) : Id (S.Singl X) center v = transH (extend v.1.1 (equiv v.1 v.2) v.1.2)
    (Big.ap (pre.Iso X v.1) (S.Singl X) (\ i -> (v.1,i)) _ _
      (Arrows[l+,l].Arrows[pre].iso-eq (pack v.1.1 (equiv v.1 v.2) v.1.2).2 v.2 (refl v.2.1))) ;
} ;
category : K.Category = new K.Category[pre,K.FromTotal[pre,\ X u v -> transH (symH (At[X].contract u)) (At[X].contract v)].univalent] ;
unit-set : ob = (Top,prop-to-set Top isTop) ;
terminal : WildCategory[l+,l].Extremal[WildCategory[l+,l].forget pre].terminal unit-set =
  \ X -> CategoryOfTypes[l].terminal X.1 ;
