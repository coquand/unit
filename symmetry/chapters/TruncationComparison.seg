-- Truncating X at two different levels gives equivalent types. The
-- comparison sends the generators to one another, propositionally.
level u v ; constraint u <= v ;
open Base ; open Prelude[v] ; open Paths[v] ;
module Compare (n : Nat) (X : U u) {
  module S = ChapterTwo[u].Truncate[n,X] ; module L = ChapterTwo[v].Truncate[n,X] ;
  module Up = UniverseChange[u,v].TruncationElim[n,X].Into[\ t -> L.carrier,\ t -> L.op.trunc X].E ;
  module Down = UniverseChange[v,u].TruncationElim[n,X].Into[\ t -> S.carrier,\ t -> S.op.trunc X].E ;
  up : S.carrier -> L.carrier = Up.ext L.unit ;
  down : L.carrier -> S.carrier = Down.ext S.unit ;
  computes (x : X) : Id L.carrier (up (S.unit x)) (L.unit x) = Up.ext-beta L.unit x ;
  module LS = ChapterTwo[v].Truncate[n,X].Into[\ t -> L.carrier,\ t -> L.op.trunc X].E ;
  module SS = ChapterTwo[u].Truncate[n,X].Into[\ t -> S.carrier,\ t -> S.op.trunc X].E ;
  large : Id (L.carrier -> L.carrier) (\ b -> up (down b)) (\ b -> b) = LS.unique _ _
    (\ x -> transH (apH up (Down.ext-beta S.unit x)) (computes x)) ;
  small : Id (S.carrier -> S.carrier) (\ a -> down (up a)) (\ a -> a) = SS.unique _ _
    (\ x -> transH (apH down (computes x)) (Down.ext-beta S.unit x)) ;
  comparison : Equiv S.carrier L.carrier = (up,qinv _ _ up down
    (happly L.carrier (\ x -> L.carrier) _ _ large) (happly S.carrier (\ x -> S.carrier) _ _ small)) ;
} ;
