level l ;
open Base ; open Prelude[l] ;
equiv-ext (A B : U l) (f g : Equiv A B) (h : (x : A) -> Id B (f.1 x) (g.1 x)) : Id (Equiv A B) f g =
  Sigma-eq (A -> B) (isEquiv A B) _ _ _ _
    (Axioms[l].FunExtLemmas[fe @l].funext A (\ x -> B) f.1 g.1 h) (EquivProp[l].isEquiv-prop A B g.1) ;

-- Sections 2.16, 2.22 and 2.26. Index zero here means propositional truncation.
module Truncate (n : Nat) (X : U l) {
  module T = Truncations[l] ;
  op : T.TruncOp[suc n] = T.TO n ;
  carrier : U l = op.T X ;
  unit : X -> carrier = op.unit X ;
  module Into (P : carrier -> U l) (h : (z : carrier) -> HLevels[l].isTrunc (suc n) (P z)) {
    module E = ConnectedMaps[l].Elim[suc n,X,carrier,unit,op.conn X,P,h] ;
    extend (b : (x : X) -> P (unit x)) : (z : carrier) -> P z = E.ext b ;
    computation (b : (x : X) -> P (unit x)) (x : X) :
      Id (P (unit x)) (extend b (unit x)) (b x) = E.ext-beta b x ;
  } ;
} ;
-- Section 2.19. The component of a point in a locally small type is small.
module Component (X : U l+) (small : Replacement[l,l+].LocallySmall X) (x : X) {
  module C = LocalSmallness[l,l+].Component[X,small,x] ;
  module R = Replacement[l,l+] ;
  point-map (t : Top) : X = x ;
  image : R.Image[Top,X,point-map] = C.image ;
  carrier : U l = C.carrier ;
  point : carrier = C.point ;
  path-at-point : Id X (image.inclusion point) x = C.path-at-point ;
  presentation : Prelude[l+].Equiv carrier C.component = C.presentation ;
} ;

-- Section 2.20. Equality in a subtype is equality of underlying elements.
module Subtype (A : U l) (P : A -> U l) (prop : (x : A) -> isProp (P x)) {
  total : U l = (x : A) * P x ;
  module At (u : total) {
    R (v : total) : U l = Id A u.1 v.1 ;
    based : U l = (v : total) * R v ;
    centre : based = (u,refl u.1) ;
    contract (y : A) (p : Id A u.1 y) : (s : P y) -> Id based centre ((y,s),p) =
      idJ A u.1 (\ z q -> (s : P z) -> Id based centre ((z,s),q))
        (\ s -> ap (P u.1) based (\ t -> ((u.1,t),refl u.1)) u.2 s (prop u.1 u.2 s)) y p ;
    module F = FundThm[l].FT[total,u,R,refl u.1,(centre,\ w -> contract w.1.1 w.2 w.1.2)] ;
    project (v : total) (p : Id total u v) : R v = ap total A (\ w -> w.1) u v p ;
    computes (v : total) (p : Id total u v) : Id (R v) (project v p) (F.tr v p) =
      idJ total u (\ w q -> Id (R w) (project w q) (F.tr w q)) (refl (refl u.1)) v p ;
    paths (v : total) : Equiv (Id total u v) (R v) = (project v,
      Equivalences[l].homotopy (Id total u v) (R v) (F.tr v,F.equiv v) (project v) (computes v)) ;
  } ;
} ;

-- Changing the base of a dependent sum along an equivalence (SphereAxiom.sigma-base).
change-base (X Y : U l) (e : Equiv X Y) (P : Y -> U l) :
  Equiv ((x : X) * P (e.1 x)) ((y : Y) * P y) =
  (\ w -> (e.1 w.1,w.2),
   Axioms[l].UnivalenceLemmas[univ @l].eqind X
    (\ Z d -> (R : Z -> U l) -> isEquiv ((x : X) * R (d.1 x)) ((z : Z) * R z) (\ w -> (d.1 w.1,w.2)))
    (\ R -> (idEquiv ((x : X) * R x)).2) Y e P) ;

module Projection (A : U l) (P : A -> U l) (a : A) {
  fibre : U l = (v : (x : A) * P x) * Id A v.1 a ;
  forward (v : fibre) : P a = subst A P v.1.1 a v.2 v.1.2 ;
  backward (u : P a) : fibre = ((a,u),refl a) ;
  contract (v : (x : A) * P x) (p : Id A v.1 a) : Id fibre (backward (forward (v,p))) (v,p) =
    idJ A v.1 (\ b q -> Id ((w : (x : A) * P x) * Id A w.1 b)
      ((b,subst A P v.1 b q v.2),refl b) (v,q)) (refl (v,refl v.1)) a p ;
  equivalence : Equiv fibre (P a) = (forward,qinv fibre (P a) forward backward (\ u -> refl u) (\ v -> contract v.1 v.2)) ;
} ;
