-- Integer iterates and their uniqueness from the recursion theorem for Z.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Z = Integers[l] ; module F = FiniteCycles[l] ; module E = Equivalences[l] ;
module Orbit (X : U l) (t : Equiv X X) {
  module N = F.Iteration[X,t.1] ; module Back = F.Iteration[X,t.2.sec] ;
  power : Z.Int -> X -> X = split { pos n -> N.power n ; negsuc n -> Back.power (suc n) } ;
  successor-neg : (n : Nat) (x : X) -> Id X (power (Z.sucZ (negsuc n)) x) (t.1 (power (negsuc n) x)) = split {
    zero -> \ x -> symH (t.2.sec-eq x) ; suc n -> \ x -> symH (t.2.sec-eq (power (negsuc n) x)) } ;
  step : (k : Z.Int) (x : X) -> Id X (power (Z.sucZ k) x) (t.1 (power k x)) = split {
    pos n -> \ x -> refl (t.1 (N.power n x)) ; negsuc n -> successor-neg n } ;
  module Unique (x : X) (f : Z.Int -> X) (z : Id X (f Z.zeroZ) x) (s : (k : Z.Int) -> Id X (f (Z.sucZ k)) (t.1 (f k))) {
    module R = CircleProperty[l].IntRec[X,t,x] ;
    paths : Id R.C1 (f,z,s) ((\ k -> power k x),refl x,\ k -> step k x) =
      FunExtUA[l].pathC R.C1 R.contr _ _ ;
    at (k : Z.Int) : Id X (f k) (power k x) = ap R.C1 X (\ a -> a.1 k) _ _ paths ;
  } ;
  module Add (k : Z.Int) (x : X) {
    sum (j : Z.Int) : X = power (Z.add k j) x ;
    succ-law (j : Z.Int) : Id X (sum (Z.sucZ j)) (t.1 (sum j)) =
      transH (apH (\ i -> power i x) (Z.add-sucR k j)) (step (Z.add k j) x) ;
    compose : (j : Z.Int) -> Id X (sum j) (power j (power k x)) =
      Unique[power k x,sum,refl (power k x),succ-law].at ;
  } ;
  undo (k : Z.Int) (x : X) : Id X (power (Z.neg k) (power k x)) x =
    transH (symH (Add[k,x].compose (Z.neg k))) (apH (\ i -> power i x) (Z.invr k)) ;
  cancel (k : Z.Int) (x y : X) (p : Id X (power k x) (power k y)) : Id X x y =
    transH (symH (undo k x)) (transH (apH (power (Z.neg k)) p) (undo k y)) ;
  nat-equiv : (k : Nat) -> isEquiv X X (N.power k) = split {
    zero -> (idEquiv X).2 ; suc k | r -> (E.compose X X X (N.power k,r) t).2 } ;
} ;
module Map (X Y : U l) (t : Equiv X X) (s : Equiv Y Y) (f : X -> Y)
  (h : (x : X) -> Id Y (f (t.1 x)) (s.1 (f x))) {
  module A = Orbit[X,t] ; module B = Orbit[Y,s] ;
  at (x : X) : (k : Z.Int) -> Id Y (f (A.power k x)) (B.power k (f x)) =
    B.Unique[f x,\ k -> f (A.power k x),refl (f x),\ k -> transH (apH f (A.step k x)) (h (A.power k x))].at ;
} ;
