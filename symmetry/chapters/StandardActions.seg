-- Definitions 5.2.28 and 5.2.29 with Exercise 5.2.13: actions of G in a
-- groupoid A are pairs of an object and a homomorphism to its automorphisms.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module L4 = Lemma4[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module E = Equivalences[l] ;
-- Maps out of a pointed type are a point together with a pointed map to it.
pointing (X : U l) (x : X) (A : U l) : Equiv (X -> A) ((a : A) * L4.PtMap X x A a) =
  (\ f -> (f x,(f,refl (f x))),qinv _ _ (\ f -> (f x,(f,refl (f x)))) (\ w -> w.2.1) (\ w ->
    idJ A (w.2.1 x) (\ a p -> Id ((b : A) * L4.PtMap X x A b) (w.2.1 x,(w.2.1,refl (w.2.1 x))) (a,(w.2.1,p)))
      (refl (w.2.1 x,(w.2.1,refl (w.2.1 x)))) w.1 w.2.2) (\ f -> refl f)) ;
-- The first projection of Sigma-eq.
fst-Sigma-eq (A : U l) (B : A -> U l) (a a' : A) (b : B a) (b' : B a') (p : Id A a a') (pB : isProp (B a')) :
  Id (Id A a a') (ap ((x : A) * B x) A (\ w -> w.1) _ _ (Sigma-eq A B a a' b b' p pB)) p =
  idJ A a (\ z q -> (pz : isProp (B z)) -> (b2 : B z) ->
      Id (Id A a z) (ap ((x : A) * B x) A (\ w -> w.1) _ _ (Sigma-eq A B a z b b2 q pz)) q)
    (\ pz b2 -> transH (LoopCalc[l].ap-ap (B a) ((x : A) * B x) A (\ u -> (a,u)) (\ w -> w.1) b b2 (pz b b2))
      (LoopCalc[l].ap-const (B a) A a b b2 (pz b b2))) a' p pB b' ;
-- Exercise 5.2.13: out of a connected type, pointed maps land in the component.
module Component (X : U l) (x : X) (cX : Connected[l].isConn CG.two X) (B : U l) (gpd : HLevels[l].isTrunc CG.three B) (b : B) {
  module Aut = CG.Automorphisms[B,gpd,b] ;
  member-prop (y : B) : isProp (Aut.membership y) = T.Trunc[Id B b y].proposition ;
  witness (g : L4.PtMap X x B b) (z : X) : Aut.membership (g.1 z) = TC.map (Id X x z) (Id B b (g.1 z))
      (\ q -> trans B b (g.1 x) (g.1 z) (sym B (g.1 x) b g.2) (apH g.1 q)) ((cX.2 x z).1) ;
  into (g : L4.PtMap X x B b) : L4.PtMap X x Aut.B Aut.pt = (\ z -> (g.1 z,witness g z),
    Sigma-eq B Aut.membership _ _ (witness g x) Aut.pt.2 g.2 (member-prop b)) ;
  out (h : L4.PtMap X x Aut.B Aut.pt) : L4.PtMap X x B b = (\ z -> (h.1 z).1,ap Aut.B B (\ v -> v.1) _ _ h.2) ;
  out-into (g : L4.PtMap X x B b) : Id (L4.PtMap X x B b) (out (into g)) g =
    ap (Id B (g.1 x) b) (L4.PtMap X x B b) (\ p -> (g.1,p)) _ _ (fst-Sigma-eq B Aut.membership _ _ (witness g x) Aut.pt.2 g.2 (member-prop b)) ;
  fst-injective (u : Aut.B) (p q : Id Aut.B u Aut.pt) (h : Id (Id B u.1 b) (ap Aut.B B (\ v -> v.1) _ _ p) (ap Aut.B B (\ v -> v.1) _ _ q)) :
    Id (Id Aut.B u Aut.pt) p q = E.injective _ _ _ (Aut.S.At[u].paths Aut.pt).2 p q h ;
  into-out (h : L4.PtMap X x Aut.B Aut.pt) : Id (L4.PtMap X x Aut.B Aut.pt) (into (out h)) h =
    DeloopMaps[l].ptmap-path X x Aut.B Aut.pt (into (out h)).1 h.1 (into (out h)).2 h.2
      (\ z -> Sigma-eq B Aut.membership _ _ (witness (out h) z) (h.1 z).2 (refl (h.1 z).1) (member-prop (h.1 z).1))
      (fst-injective _ _ _ (transH (fst-Sigma-eq B Aut.membership _ _ (witness (out h) x) Aut.pt.2 (ap Aut.B B (\ v -> v.1) _ _ h.2) (member-prop b))
        (transH (symH (trans-refl-l B _ _ (ap Aut.B B (\ v -> v.1) _ _ h.2)))
          (transH (apH (\ r -> trans B _ _ _ r (ap Aut.B B (\ v -> v.1) _ _ h.2))
            (symH (fst-Sigma-eq B Aut.membership _ _ (witness (out h) x) (h.1 x).2 (refl (h.1 x).1) (member-prop (h.1 x).1))))
            (symH (Groupoid[l].ap-trans Aut.B B (\ v -> v.1) _ _ _ (Sigma-eq B Aut.membership _ _ (witness (out h) x) (h.1 x).2 (refl (h.1 x).1) (member-prop (h.1 x).1)) h.2)))))) ;
  equiv : Equiv (L4.PtMap X x B b) (L4.PtMap X x Aut.B Aut.pt) = (into,qinv _ _ into out into-out out-into) ;
} ;
-- Definition 5.2.28: actions of G in a groupoid A.
module In (G : CG.ConcreteGroup) (A : U l) (gpd : HLevels[l].isTrunc CG.three A) {
  action : U l = G.space -> A ;
  on (a : A) : U l = CG.Hom G CG.Automorphisms[A,gpd,a].group ;
  classify : Equiv action ((a : A) * on a) = E.compose _ _ _ (pointing G.space G.point A)
    (Fibres[l].sigma-equiv A (\ a -> L4.PtMap G.space G.point A a) on (\ a -> Component[G.space,G.point,G.connected,A,gpd,a].equiv)) ;
} ;
-- Definition 5.2.29: the standard action of G on its shape.
standard (G : CG.ConcreteGroup) : In[G,G.space,G.groupoid].action = \ z -> z ;
