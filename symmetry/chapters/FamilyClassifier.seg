-- Sections 2.20 and 2.25. Classify maps by their fibres and restrict the
-- equivalence by any fibrewise structure, including points, props and sets.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = Prelude[l+] ; module BP = Paths[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module BL = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
module Over (A : U l) {
  maps : U l+ = (X : U l) * (X -> A) ;
  families : U l+ = A -> U l ;
  fibres (w : maps) (a : A) : U l = (x : w.1) * Id A (w.2 x) a ;
  project (P : families) : maps = ((a : A) * P a,\ z -> z.1) ;
  beta (P : families) : Id families (fibres (project P)) P = BL.funext A (\ a -> U l) _ P
    (\ a -> UA.ua _ _ ChapterTwo[l].Projection[A,P,a].equivalence) ;
  module Total (w : maps) {
    total : U l = (a : A) * fibres w a ;
    forward (u : total) : w.1 = u.2.1 ;
    backward (x : w.1) : total = (w.2 x,x,refl (w.2 x)) ;
    contracts (x : w.1) (a : A) (p : Id A (w.2 x) a) : Id total (backward x) (a,x,p) =
      idJ A (w.2 x) (\ b q -> Id total (backward x) (b,x,q)) (refl (backward x)) a p ;
    equiv : Equiv total w.1 = (forward,qinv _ _ forward backward (\ x -> refl x) (\ u -> contracts u.2.1 u.1 u.2.2)) ;
  } ;
  identify (X : U l) (f : X -> A) (Y : U l) (e : Equiv X Y) : (g : Y -> A) ->
    ((x : X) -> Id A (f x) (g (e.1 x))) -> Id maps (X,f) (Y,g) =
    UA.eqind X (\ Z d -> (g : Z -> A) -> ((x : X) -> Id A (f x) (g (d.1 x))) -> Id maps (X,f) (Z,g))
      (\ g h -> B.ap (X -> A) maps (\ k -> (X,k)) f g (FL.funext X (\ x -> A) f g h)) Y e ;
  eta (w : maps) : Id maps (project (fibres w)) w = identify Total[w].total (\ u -> u.1) w.1 Total[w].equiv w.2
    (\ u -> symH u.2.2) ;
  classifier : B.Equiv maps families = (fibres,B.qinv _ _ fibres project beta eta) ;
  module Structured (P : U l -> U l) {
    structure (F : families) : U l = (a : A) -> P (F a) ;
    arrows : U l+ = (w : maps) * structure (fibres w) ;
    objects : U l+ = A -> (X : U l) * P X ;
    assemble (w : (F : families) * structure F) (a : A) : (X : U l) * P X = (w.1 a,w.2 a) ;
    unpack (g : objects) : (F : families) * structure F = (\ a -> (g a).1,\ a -> (g a).2) ;
    equivalence : B.Equiv arrows objects = Equivalences[l+].compose _ _ _
      (ChapterTwo[l+].change-base maps families classifier (\ F -> structure F))
      (assemble,B.qinv _ _ assemble unpack (\ g -> refl g) (\ w -> refl w)) ;
  } ;
  module Embeddings = Structured[isProp] ; module Coverings = Structured[isSet] ;
  module SplitMaps = Structured[\ X -> X] ;
  subtype-classifier : B.Equiv Embeddings.arrows (A -> Quotient[l].Prop) = Embeddings.equivalence ;
  injections-set : B.isSet Embeddings.arrows = HLevels[l+].trunc-set _ (HLevels[l+].equiv-trunc (suc (suc zero)) _ _
    subtype-classifier (HLevels[l+].set-trunc _ (\ f g -> Quotient[l].PropFamilies[A,f].path-prop g))) ;
} ;
module Subsets (A : U l) {
  sub : U l+ = A -> Quotient[l].Prop ;
  le (P Q : sub) : U l = (a : A) -> (P a).1 -> (Q a).1 ;
  prop (P Q : sub) : isProp (le P Q) = FL.isProp-Pi A (\ a -> (P a).1 -> (Q a).1)
    (\ a -> FL.isProp-Pi (P a).1 (\ p -> (Q a).1) (\ p -> (Q a).2)) ;
  reflexive (P : sub) : le P P = \ a p -> p ;
  transitive (P Q R : sub) (f : le P Q) (g : le Q R) : le P R = \ a p -> g a (f a p) ;
  antisymmetric (P Q : sub) (f : le P Q) (g : le Q P) : Id sub P Q =
    Quotient[l].PropFamilies[A,P].decode Q (\ a -> (f a,g a)) ;
  bottom (a : A) : Quotient[l].Prop = (Empty,isProp-Empty) ;
  top (a : A) : Quotient[l].Prop = (Top,isTop) ;
  least (P : sub) : le bottom P = \ a -> absurd (P a).1 ;
  greatest (P : sub) : le P top = \ a p -> tt ;
} ;
module SubtypeLevel (A : U l) (P : A -> U l) (p : (a : A) -> isProp (P a)) {
  module H = HLevels[l] ;
  truncated (n : Nat) (h : H.isTrunc (suc n) A) : H.isTrunc (suc n) ((a : A) * P a) =
    H.trunc-Sigma (suc n) A P h (\ a -> H.prop-trunc n (P a) (p a)) ;
} ;
module UniverseLevels {
  module H = HLevels[l] ; module BH = HLevels[l+] ;
  module Props = ChapterTwo[l+].Subtype[U l,\ X -> isProp X,\ X -> FL.isProp-isProp X] ;
  module Sets = ChapterTwo[l+].Subtype[U l,\ X -> isSet X,\ X -> Torsor[l].isProp-isSet X] ;
  module PropPaths (P Q : Props.total) {
    e : B.Equiv (Id Props.total P Q) (Equiv P.1 Q.1) = Equivalences[l+].compose _ _ _
      (Props.At[P].paths Q) (Axioms[l].idtoeqv P.1 Q.1,univ @l P.1 Q.1) ;
    prop : isProp (Equiv P.1 Q.1) = isProp-Sigma (P.1 -> Q.1) (isEquiv P.1 Q.1)
      (FL.isProp-Pi P.1 (\ p -> Q.1) (\ p -> Q.2)) (EquivProp[l].isEquiv-prop P.1 Q.1) ;
    paths : B.isProp (Id Props.total P Q) = B.retract-prop _ _ e.1 e.2.sec (B.sec-ret _ _ e.1 e.2) prop ;
  } ;
  module SetPaths (X Y : Sets.total) {
    e : B.Equiv (Id Sets.total X Y) (Equiv X.1 Y.1) = Equivalences[l+].compose _ _ _
      (Sets.At[X].paths Y) (Axioms[l].idtoeqv X.1 Y.1,univ @l X.1 Y.1) ;
    set : isSet (Equiv X.1 Y.1) = Torsor[l].isSet-sub (X.1 -> Y.1) (isEquiv X.1 Y.1)
      (FL.isSet-Pi X.1 (\ x -> Y.1) (\ x -> Y.2)) (EquivProp[l].isEquiv-prop X.1 Y.1) ;
    paths : B.isSet (Id Sets.total X Y) = B.isSet-retract _ _ e.1 e.2.sec (B.sec-ret _ _ e.1 e.2) set ;
  } ;
} ;
