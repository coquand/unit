-- Section 6.7. Smallness relative to a third independent universe.
level s o h ; open Base ; module R = RezkCompletion[o,h,o,h] ; module K = Category[o,h] ;
module S = EssentialSmallness[s,o \/ h] ; module P = Prelude[s \/ o \/ h] ; module L = Paths[s \/ o \/ h] ;
module E = EquivalenceLemmas[s \/ o \/ h] ; module B = Prelude[s+ \/ o \/ h] ;
module On (C : K.Precategory) (local : (x y : C.ob) -> Replacement[s,h].Small (C.hom x y)) {
  module M = R.On[C] ; D : Category[o \/ h,o \/ h].Category = M.completion ;
  module Dense (T : D.pre.ob -> U (s+ \/ o \/ h)) (prop : (x : D.pre.ob) -> B.isProp (T x)) (g : (a : C.ob) -> T (M.unit.obj a)) {
    extend (x : D.pre.ob) : T x = TruncationCombinators[o \/ h].rec ((a : C.ob) * D.pre.Iso (M.unit.obj a) x) @(s+ \/ o \/ h) (T x) (prop x)
      (\ w -> B.subst D.pre.ob T _ x (D.isotoid _ _ w.2) (g w.1)) (M.essentially-surjective x) ;
  } ;
  module At (a b : C.ob) {
    source : S.small (C.hom a b) = ((local a b).1,(local a b).2.1,P.qinv _ _ (local a b).2.1 (local a b).2.2.sec
      (local a b).2.2.sec-eq (Prelude[s \/ h].sec-ret _ _ _ (local a b).2.2)) ;
    equiv : P.Equiv (C.hom a b) (D.pre.hom (M.unit.obj a) (M.unit.obj b)) = (M.unit.map a b,P.qinv _ _ (M.unit.map a b)
      (M.fully-faithful a b).sec (M.fully-faithful a b).sec-eq (Prelude[o \/ h].sec-ret _ _ _ (M.fully-faithful a b))) ;
    presentation : S.small (D.pre.hom (M.unit.obj a) (M.unit.obj b)) = S.change _ _ source equiv ;
  } ;
  module Row (a : C.ob) {
    all : (y : D.pre.ob) -> S.small (D.pre.hom (M.unit.obj a) y) =
      Dense[(\ y -> S.small (D.pre.hom (M.unit.obj a) y)),(\ y -> S.On[D.pre.hom (M.unit.obj a) y].prop),(\ b -> At[a,b].presentation)].extend ;
  } ;
  hom-small : (x y : D.pre.ob) -> S.small (D.pre.hom x y) = Dense[(\ x -> (y : D.pre.ob) -> S.small (D.pre.hom x y)),
    (\ x -> Axioms[s+ \/ o \/ h].FunExtLemmas[fe @(s+ \/ o \/ h)].isProp-Pi D.pre.ob (\ y -> S.small (D.pre.hom x y)) (\ y -> S.On[D.pre.hom x y].prop)),(\ a -> Row[a].all)].extend ;
  module Pair (x y : D.pre.ob) {
    module H = Arrows[o \/ h,o \/ h].Arrows[D.pre] ;
    module Inverse (f : D.pre.hom x y) (g : D.pre.hom y x) {
      left : U (o \/ h) = Id (D.pre.hom x x) (H.cmp g f) (D.pre.idn x) ;
      right : U (o \/ h) = Id (D.pre.hom y y) (H.cmp f g) (D.pre.idn y) ;
      small : S.small (left * right) = S.sigma left (\ p -> right) (S.paths _ (hom-small x x) _ _) (\ p -> S.paths _ (hom-small y y) _ _) ;
    } ;
    iso : S.small (D.pre.Iso x y) = S.sigma (D.pre.hom x y) (\ f -> D.pre.isIso x y f) (hom-small x y)
      (\ f -> S.sigma (D.pre.hom y x) (\ g -> Inverse[f,g].left * Inverse[f,g].right) (hom-small y x) (\ g -> Inverse[f,g].small)) ;
    id-iso : P.Equiv (Id D.pre.ob x y) (D.pre.Iso x y) = (D.pre.idtoiso x y,P.qinv _ _ (D.pre.idtoiso x y) (D.univalent x y).sec
      (D.univalent x y).sec-eq (Prelude[o \/ h].sec-ret _ _ _ (D.univalent x y))) ;
    small : S.small (Id D.pre.ob x y) = S.change _ _ iso (E.inverse _ _ id-iso) ;
  } ;
  module LP = R.Presentation[C] ;
  module Big = Prelude[s \/ o \/ h+] ;
  module BigE = EquivalenceLemmas[s \/ o \/ h+] ;
  large-hom (x y : LP.large) : U (o \/ h) = M.Y.hom x.1 y.1 ;
  module Transport = Prelude[s+ \/ o \/ h+] ;
  large-local (x y : LP.large) : S.small (large-hom x y) =
    Transport.subst LP.large (\ w -> S.small (large-hom x w)) _ y (LP.section y)
      (Transport.subst LP.large (\ w -> S.small (large-hom w (LP.include (LP.locate y)))) _ x (LP.section x)
        (hom-small (LP.locate x) (LP.locate y))) ;
  module Objects (u : Replacement[s,o].Small C.ob) {
    mark (a : u.1) : D.pre.ob = M.unit.obj (u.2.1 a) ;
    image : Replacement[s,o \/ h].Image[u.1,D.pre.ob,mark] = images @s @(o \/ h) u.1 D.pre.ob (\ x y -> Pair[x,y].small) mark ;
    fib (x : D.pre.ob) : U (s \/ o \/ h) = (a : image.carrier) * Id D.pre.ob (image.inclusion a) x ;
    prop (x : D.pre.ob) : P.isProp (fib x) = Groupoid[s \/ o \/ h].emb-fib-prop image.carrier D.pre.ob image.inclusion image.embedding x ;
    preimage (a : C.ob) : fib (M.unit.obj a) = (image.quotient (u.2.2.sec a),
      L.transH (image.triangle (u.2.2.sec a)) (L.apH M.unit.obj (u.2.2.sec-eq a))) ;
    hit : (x : D.pre.ob) -> fib x = Dense[(\ x -> fib x),prop,preimage].extend ;
    small : S.small D.pre.ob = (image.carrier,image.inclusion,Whitehead[s \/ o \/ h].contr-equiv _ _ image.inclusion (\ x -> (hit x,prop x (hit x)))) ;
    large-small : Replacement[s,o \/ h+].Small LP.large = (image.carrier,BigE.then image.carrier D.pre.ob LP.large
      (image.inclusion,Big.qinv _ _ image.inclusion small.2.2.sec small.2.2.sec-eq (P.sec-ret _ _ _ small.2.2))
      (LP.include,Big.qinv _ _ LP.include LP.locate LP.section LP.retract)) ;
  } ;
} ;
