-- Section 6.7. The unit and counit of an adjoint equivalence give full
-- faithfulness and split essential surjectivity.
level a b c d ; open Base ; open Paths[b \/ d] ; module H = Prelude[b \/ d] ;
module Given (C : WildCategory[a,b].Wild) (D : WildCategory[c,d].Wild)
  (F : WildFunctors[a,b,c,d].Map[C,D]) (G : WildFunctors[c,d,a,b].Map[D,C]) (A : Adjunctions[a,b,c,d].Wild[C,D,F,G].Adjunction) {
  module T = Adjunctions[a,b,c,d].Wild[C,D,F,G].Triangles[A] ;
  module Unit (u : (x : C.ob) -> WildIsos[a,b].At[C,x,G.obj (F.obj x),T.unit x].data-inv) {
    module Hom (x y : C.ob) {
      module I = WildIsos[a,b].At[C,y,G.obj (F.obj y),T.unit y].Inverse[u y] ;
      e : H.Equiv (D.hom (F.obj x) (F.obj y)) (C.hom x (G.obj (F.obj y))) = A.transpose x (F.obj y) ;
      at (f : C.hom x y) : Id (C.hom x (G.obj (F.obj y))) (e.1 (F.map x y f)) ((I.post x).1 f) =
        transH (apH e.1 (symH (D.unit-l _ _ (F.map x y f)))) (A.pre y x (F.obj y) f (D.idn (F.obj y))) ;
      factor (f : C.hom x y) : Id (D.hom (F.obj x) (F.obj y)) (e.2.sec ((I.post x).1 f)) (F.map x y f) =
        transH (apH e.2.sec (symH (at f))) (H.sec-ret _ _ _ e.2 (F.map x y f)) ;
      ff : H.isEquiv (C.hom x y) (D.hom (F.obj x) (F.obj y)) (F.map x y) =
        EquivalenceLemmas[b \/ d].homotopy _ _ _ _ factor
          (EquivalenceLemmas[b \/ d].compose _ _ _ e.2.sec (I.post x).1
            (EquivalenceLemmas[b \/ d].inverse _ _ e).2
            (H.qinv _ _ (I.post x).1 (I.post x).2.sec (I.post x).2.sec-eq (Prelude[b].sec-ret _ _ _ (I.post x).2))) ;
    } ;
    fully-faithful : WildFunctors[a,b,c,d].Between[C,D].Action[F].fully-faithful = \ x y -> Hom[x,y].ff ;
  } ;
  module On (u : (x : C.ob) -> WildIsos[a,b].At[C,x,G.obj (F.obj x),T.unit x].data-inv)
    (v : (y : D.ob) -> WildIsos[c,d].At[D,F.obj (G.obj y),y,T.counit y].data-inv) {
    fully-faithful : WildFunctors[a,b,c,d].Between[C,D].Action[F].fully-faithful = Unit[u].fully-faithful ;
    split-surjection (y : D.ob) : (x : C.ob) * D.iso (F.obj x) y = (G.obj y,T.counit y,v y) ;
  } ;
} ;
module Construct (C : Category[a,b].Precategory) (D : Category[c,d].Precategory) (F : Functor[a,b,c,d].Functor[C,D])
  (ff : Functor[a,b,c,d].FullyFaithful C D F) (s : Functor[a,b,c,d].SplitEssSurj C D F) {
  module L = Functor[a,b,c,d].Faithful[C,D,F,ff] ; module AD = Arrows[c,d].Arrows[D] ;
  module AC = Arrows[a,b].Arrows[C] ;
  obj (y : D.ob) : C.ob = (s y).1 ;
  iso (y : D.ob) : D.Iso (F.obj (obj y)) y = (s y).2 ;
  back (x : C.ob) (y : D.ob) (g : C.hom x (obj y)) : D.hom (F.obj x) y = AD.cmp (AD.arr (iso y)) (F.map _ _ g) ;
  module Hom (x : C.ob) (y : D.ob) {
    to (f : D.hom (F.obj x) y) : C.hom x (obj y) = L.lift (iso y) f ;
    eta (g : C.hom x (obj y)) : Id (C.hom x (obj y)) (to (back x y g)) g =
      L.unique (iso y) (L.lift-eq (iso y) (back x y g)) (refl (back x y g)) ;
    alpha : H.Equiv (D.hom (F.obj x) y) (C.hom x (obj y)) =
      (to,H.qinv _ _ to (back x y) eta (L.lift-eq (iso y))) ;
  } ;
  pre (x w : C.ob) (y : D.ob) (u : C.hom w x) (v : D.hom (F.obj x) y) :
    Id (C.hom w (obj y)) (Hom[w,y].to (AD.cmp v (F.map w x u))) (AC.cmp (Hom[x,y].to v) u) =
    L.unique (iso y) (L.lift-eq (iso y) (AD.cmp v (F.map w x u)))
      (transH (AD.left (AD.arr (iso y)) (F.map-comp _ _ _ (Hom[x,y].to v) u))
        (transH (AD.assoc (AD.arr (iso y)) (F.map x (obj y) (Hom[x,y].to v)) (F.map w x u))
          (AD.right (L.lift-eq (iso y) v) (F.map w x u)))) ;
  module B = AdjointRepresentation[a,b,c,d].Build[WildCategory[a,b].forget C,WildCategory[c,d].forget D,
    WildFunctors[a,b,c,d].ordinary C D F,obj,\ x y -> Hom[x,y].alpha,pre] ;
  module T = B.M.Triangles[B.adjunction] ;
  counit-iso (y : D.ob) : D.isIso (F.obj (obj y)) y (T.counit y) =
    Prelude[d].subst _ (D.isIso (F.obj (obj y)) y) (AD.arr (iso y)) (T.counit y)
      (symH (transH (AD.left (AD.arr (iso y)) (F.map-idn (obj y))) (AD.unit-r (AD.arr (iso y))))) (iso y).2 ;
  unit-iso (x : C.ob) : C.isIso x (obj (F.obj x)) (T.unit x) =
    Prelude[b].subst _ (C.isIso x (obj (F.obj x))) _ (T.unit x)
      (symH (apH (L.pre {x} {obj (F.obj x)}) (AD.unit-r (AD.inv (iso (F.obj x))))))
      (L.reflect-iso (AD.iso-inv (iso (F.obj x)))).2 ;
} ;
module Property (K : Category[a,b].Category) (D : WildCategory[c,d].Wild)
  (F : WildFunctors[a,b,c,d].Map[WildCategory[a,b].forget K.pre,D]) {
  C : WildCategory[a,b].Wild = WildCategory[a,b].forget K.pre ;
  module A = AdjointUniqueness[a,b,c,d].On[K,D,F] ;
  module P = Prelude[a \/ b \/ c \/ d] ; module FL = Axioms[a \/ b \/ c \/ d].FunExtLemmas[fe @(a \/ b \/ c \/ d)] ;
  module Laws (r : A.right) {
    module T = Adjunctions[a,b,c,d].Wild[C,D,F,r.1].Triangles[r.2] ;
    unit (x : C.ob) : U b = WildIsos[a,b].At[C,x,r.1.obj (F.obj x),T.unit x].data-inv ;
    counit (y : D.ob) : U d = WildIsos[c,d].At[D,F.obj (r.1.obj y),y,T.counit y].data-inv ;
    all : U (a \/ b \/ c \/ d) = ((x : C.ob) -> unit x) * ((y : D.ob) -> counit y) ;
    prop : P.isProp all = P.isProp-Sigma ((x : C.ob) -> unit x) (\ t -> (y : D.ob) -> counit y)
      (FL.isProp-Pi C.ob (\ x -> unit x) (\ x -> WildIsos[a,b].At[C,x,r.1.obj (F.obj x),T.unit x].prop))
      (\ t -> FL.isProp-Pi D.ob (\ y -> counit y) (\ y -> WildIsos[c,d].At[D,F.obj (r.1.obj y),y,T.counit y].prop)) ;
  } ;
  is-cat-equiv : U (a \/ b \/ c \/ d) = (r : A.right) * Laws[r].all ;
  prop : P.isProp is-cat-equiv = P.isProp-Sigma A.right (\ r -> Laws[r].all) A.unique (\ r -> Laws[r].prop) ;
} ;
