-- Section 7.6. A G-set is a set together with a representation of the
-- underlying abstract group in its symmetric group.
level u v ; open Base ; open Prelude[u \/ v+] ;
module P = Prelude[v] ; module CG = ChapterFour[u \/ v+] ; module E = Equivalences[u \/ v+] ;
module S = CircleBundles[v] ;
module Equality (a b : S.Set) {
  aut : U v = P.Equiv a.1 b.1 ;
  arrows : Equiv (Id S.Set a b) aut = E.compose (Id S.Set a b) (Id (U v) a.1 b.1) aut
    (UniverseChange[u,v+].raise-equiv _ _ (S.S.At[a].paths b))
    (UniverseChange[u,v+].raise-equiv (Id (U v) a.1 b.1) aut (Axioms[v].idtoeqv a.1 b.1,univ @v a.1 b.1)) ;
  set : P.isSet aut = S.equivalences-are-set a b ;
} ;
groupoid : HLevels[u \/ v+].isTrunc CG.three S.Set = \ a b -> HLevels[u \/ v+].equiv-trunc CG.two _ _
  Equality[a,b].arrows (HLevels[u \/ v+].set-trunc _ Equality[a,b].set) ;
module Classify (G : ChapterFour[u].ConcreteGroup) {
  module T = Truncation[u \/ v+] ;
  reach (x : G.space) : T.Trunc[Id G.space G.point x].carrier =
    TruncationCombinators[u].rec (Id G.space G.point x) @(u \/ v+) _ T.Trunc[Id G.space G.point x].proposition
      T.Trunc[Id G.space G.point x].inc ((G.connected.2 G.point x).1) ;
  large : CG.ConcreteGroup = new CG.ConcreteGroup[G.space,G.point,CG.Reachable[G.space,G.point,reach].connected,
    UniverseChange[v+,u].truncated CG.three G.space G.groupoid] ;
  module Small = ChapterFour[u].Symmetries[G] ;
  module Fiber (a : S.Set) {
    module C = PointedComponent[u \/ v+].AtBase[S.Set,groupoid,a] ;
    module M = ChapterSeven[u \/ v+].OrdinaryMaps[large,C.group] ;
    module Pts = C.Cones[large] ;
    representation : U (u \/ v+) = M.ordinary ;
    equiv : Equiv Pts.cones representation = E.compose _ _ _ (Bijection[u \/ v+].inverse _ _ Pts.universal) M.comparison ;
    permutation : Equiv M.M.B.carrier (S.Aut a) = E.compose _ _ _ C.P.symmetries (CircleMonodromy[u,v].loops a) ;
    act (r : representation) (p : Id G.space G.point G.point) : S.Aut a = permutation.1 (r.1 p) ;
    module B = M.M.B ; module D = M.M.A ; module FL = Axioms[u \/ v+].FunExtLemmas[fe @(u \/ v+)] ;
    family (x : C.component) : U v = x.1.1 ;
    transport (x y : C.component) (p : Id C.component x y) : P.Equiv (family x) (family y) =
      Axioms[v].idtoeqv _ _ (ap S.Set (U v) (\ s -> s.1) _ _ (ap C.component S.Set (\ t -> t.1) x y p)) ;
    compose (x y : C.component) (p : Id C.component x y) (z : C.component) (q : Id C.component y z) (t : family x) :
      Id (family z) ((transport x z (Paths[u \/ v+].transH p q)).1 t) ((transport y z q).1 ((transport x y p).1 t)) =
      idJ C.component y (\ w r -> Id (family w) ((transport x w (Paths[u \/ v+].transH p r)).1 t)
        ((transport y w r).1 ((transport x y p).1 t))) (refl ((transport x y p).1 t)) z q ;
    times (f g : S.Aut a) : S.Aut a = Equivalences[v].compose a.1 a.1 a.1 g f ;
    preserves (p q : B.carrier) : Id (S.Aut a) (permutation.1 (B.abstract.mul p q)) (times (permutation.1 p) (permutation.1 q)) =
      P.Sigma-eq (a.1 -> a.1) (P.isEquiv a.1 a.1) _ _ _ _
        (Axioms[v].FunExtLemmas[fe @v].funext a.1 (\ x -> a.1) _ _ (compose C.point C.point q C.point p))
        (EquivProp[v].isEquiv-prop a.1 a.1 _) ;
    Law (f : Small.carrier -> S.Aut a) : U (u \/ v) = (p q : Small.carrier) ->
      Id (S.Aut a) (f (Small.abstract.mul p q)) (times (f p) (f q)) ;
    actions : U (u \/ v) = (f : Small.carrier -> S.Aut a) * Law f ;
    law-prop (f : D.carrier -> S.Aut a) : isProp (Law f) = FL.isProp-Pi D.carrier
      (\ p -> (q : D.carrier) -> Id (S.Aut a) (f (D.abstract.mul p q)) (times (f p) (f q)))
      (\ p -> FL.isProp-Pi D.carrier (\ q -> Id (S.Aut a) (f (D.abstract.mul p q)) (times (f p) (f q)))
        (\ q -> Equality[a,a].set _ _)) ;
    from (r : representation) : actions = (act r,\ p q -> Paths[u \/ v+].transH (Paths[u \/ v+].apH permutation.1 (r.2 p q)) (preserves (r.1 p) (r.1 q))) ;
    module To (d : actions) {
      f (p : D.carrier) : B.carrier = permutation.2.sec (d.1 p) ;
      b (p : D.carrier) : Id (S.Aut a) (permutation.1 (f p)) (d.1 p) = permutation.2.sec-eq (d.1 p) ;
      law (p q : D.carrier) : Id B.carrier (f (D.abstract.mul p q)) (B.abstract.mul (f p) (f q)) =
        E.injective _ _ permutation.1 permutation.2 _ _
          (Paths[u \/ v+].transH (b (D.abstract.mul p q)) (Paths[u \/ v+].transH (d.2 p q)
            (Paths[u \/ v+].transH (ap (S.Aut a) (S.Aut a) (\ t -> times t (d.1 q)) _ _ (sym _ _ _ (b p)))
              (Paths[u \/ v+].transH (ap (S.Aut a) (S.Aut a) (times (permutation.1 (f p))) _ _ (sym _ _ _ (b q)))
                (sym _ _ _ (preserves (f p) (f q))))))) ;
      rep : representation = (f,law) ;
      beta : Id actions (from rep) d = Sigma-eq (D.carrier -> S.Aut a) (\ f -> Law f) _ _ _ _
        (FL.funext D.carrier (\ p -> S.Aut a) _ _ b) (law-prop d.1) ;
    } ;
    eta (r : representation) : Id representation To[from r].rep r =
      GroupIdentity[u \/ v+].hom-path D.abstract B.abstract _ r
        (\ p -> sec-ret _ _ permutation.1 permutation.2 (r.1 p)) ;
    permutations : Equiv representation actions = (from,qinv _ _ from (\ d -> To[d].rep) (\ d -> To[d].beta) eta) ;
  } ;
  sets : U (u \/ v+) = G.space -> S.Set ;
  based : U (u \/ v+) = (a : S.Set) * Lemma4[u \/ v+].PtMap G.space G.point S.Set a ;
  point (F : sets) : based = (F G.point,F,refl (F G.point)) ;
  forget (v : based) : sets = v.2.1 ;
  triangle (F : sets) (a : S.Set) (p : Id S.Set (F G.point) a) : Id based (point F) (a,F,p) =
    idJ S.Set (F G.point) (\ b q -> Id based (point F) (b,F,q)) (refl (point F)) a p ;
  with-fibre : Equiv sets based = (point,qinv _ _ point forget (\ v -> triangle v.2.1 v.1 v.2.2) (\ F -> refl F)) ;
  abstract : U (u \/ v+) = (a : S.Set) * Fiber[a].actions ;
  equivalence : Equiv sets abstract = E.compose sets based abstract with-fibre
    (Fibres[u \/ v+].sigma-equiv S.Set (\ a -> Lemma4[u \/ v+].PtMap G.space G.point S.Set a)
      (\ a -> Fiber[a].actions) (\ a -> E.compose _ _ _ Fiber[a].equiv Fiber[a].permutations)) ;
  module Monodromy (X : sets) {
    a : S.Set = X G.point ;
    module L = PointedComponent[u \/ v+].Canonical[large,S.Set,groupoid,X] ;
    fiber (z : G.space) : U v = (X z).1 ;
    identification (z : G.space) (p : Id G.space G.point z) (x : a.1) : Id (fiber z)
      ((Axioms[v].idtoeqv _ _ (ap S.Set (U v) (\ w -> w.1) _ _ (ap G.space S.Set X _ _ p))).1 x)
      (subst G.space (\ w -> fiber w) G.point z p x) =
      idJ G.space G.point (\ w q -> Id (fiber w)
        ((Axioms[v].idtoeqv _ _ (ap S.Set (U v) (\ t -> t.1) _ _ (ap G.space S.Set X _ _ q))).1 x)
        (subst G.space (\ t -> fiber t) G.point w q x)) (refl x) z p ;
    computes (p : Id G.space G.point G.point) (x : a.1) : Id a.1 (((equivalence.1 X).2.1 p).1 x)
      (subst G.space (\ w -> fiber w) G.point G.point p x) = Paths[u \/ v+].transH
        (ap (Id S.Set a a) a.1 (\ q -> ((S.loops a).1 q).1 x) _ _ (L.computes p)) (identification G.point p x) ;
  } ;
} ;
