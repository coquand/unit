-- Lemma 7.6.1 in the encoding of AbstractActions: for one universe level,
-- the abstract G-sets of ActionComparison (a set with a multiplicative map
-- from UG to its permutations) are AbstractActions.GSet (abs G) on the nose.
level l ; open Base ; open Prelude[l+] ;
module CG = ChapterFour[l] ; module AA = AbstractActions[l] ;
module Link (G : CG.ConcreteGroup) {
  module C = ActionComparison[l,l].Classify[G] ;
  J : Group[l].Grp = CG.Symmetries[G].abstract ;
  same : Id (U l+) C.abstract (AA.GSet J) = refl C.abstract ;
  -- Lemma 7.6.1: G-sets are abstract abs(G)-sets
  evaluation : Equiv (G.space -> CircleBundles[l].Set) (AA.GSet J) = C.equivalence ;
  -- the underlying set is the fibre at the base point, and the action of a
  -- loop is transport along it
  set-at (X : C.sets) : Id (U l) (evaluation.1 X).1.1 (X G.point).1 = refl (X G.point).1 ;
  action (X : C.sets) (p : Id G.space G.point G.point) (x : (X G.point).1) :
    Id (X G.point).1 (AA.act J (evaluation.1 X) p x) (subst G.space (\ z -> (X z).1) G.point G.point p x) =
    C.Monodromy[X].computes p x ;
} ;
-- Exercise 7.6.4 in this encoding: evaluation turns f^* into abs(f)^*.
module PullbackSquare (G H : CG.ConcreteGroup) (f : CG.Hom G H) {
  J : Group[l].Grp = CG.Symmetries[G].abstract ; K : Group[l].Grp = CG.Symmetries[H].abstract ;
  absf : AbstractGroups[l].Hom J K = AbstractGroups[l].abstr G H f ;
  square (X : H.space -> CircleBundles[l].Set) :
    Id (AA.GSet J) (Link[G].evaluation.1 (\ z -> X (f.1 z))) (AA.pull J K absf (Link[H].evaluation.1 X)) =
    ActionPullback[l,l].Square[G,H,f].square X ;
} ;
