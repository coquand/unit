-- Sections 6.4 and 6.7. The structure identity principle for precategories.
level o h ; open Base ; open Prelude[o+ \/ h+] ; open Paths[o+ \/ h+] ;
module K = Category[o,h] ; module S = CategorySIP[o,h] ; module H = Prelude[h] ; module O = Prelude[o] ;
module L = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
module From (C : K.Precategory) {
  module Fixed = CategorySIPFixed[o,h].On[C.ob,S.from-pre C] ;
  ops : S.Operations[C.ob,C.hom] = (S.structure-raw C.ob (S.from-pre C)).2 ;
  build (V : U o) (m : V -> V -> U h) (t : S.Operations[V,m]) : K.Precategory = S.to-pre V (S.structure-from V (m,t)) ;
  module Laws (D : K.Precategory) (f : O.Equiv C.ob D.ob) (e : (x y : C.ob) -> H.Equiv (C.hom x y) (D.hom (f.1 x) (f.1 y))) {
    idn : U (o \/ h) = (x : C.ob) -> Id (D.hom (f.1 x) (f.1 x)) ((e x x).1 (C.idn x)) (D.idn (f.1 x)) ;
    comp : U (o \/ h) = (x y z : C.ob) (k : C.hom x y) (g : C.hom y z) ->
      Id (D.hom (f.1 x) (f.1 z)) ((e x z).1 (C.comp x y z g k)) (D.comp _ _ _ ((e y z).1 g) ((e x y).1 k)) ;
    all : U (o \/ h) = idn * comp ;
  } ;
  iso (D : K.Precategory) : U (o \/ h) = (f : O.Equiv C.ob D.ob) *
    (e : (x y : C.ob) -> H.Equiv (C.hom x y) (D.hom (f.1 x) (f.1 y))) * Laws[D,f,e].all ;
  total : U (o+ \/ h+) = (D : K.Precategory) * iso D ;
  module E = CategorySIPFamily[o,h].On[C.ob * C.ob,\ i -> C.hom i.1 i.2] ;
  idhom (x y : C.ob) : H.Equiv (C.hom x y) (C.hom x y) = H.idEquiv (C.hom x y) ;
  identity : iso C = (O.idEquiv C.ob,idhom,(\ x -> refl (C.idn x)),\ x y z k g -> refl (C.comp x y z g k)) ;
  center : total = (build C.ob C.hom ops,identity) ;
  module FE = WildFunctors[o,h,o,h].Ext[WildCategory[o,h].forget C,WildCategory[o,h].forget C,C.hom-set] ;
  module IdentityLaws = FE.At[\ x -> x].On[\ x y k -> k] ;
  unit-proof (s : Laws[C,O.idEquiv C.ob,idhom].all) : Id total center (build C.ob C.hom ops,O.idEquiv C.ob,idhom,s) =
    ap Laws[C,O.idEquiv C.ob,idhom].all total (\ k -> (build C.ob C.hom ops,O.idEquiv C.ob,idhom,k)) _ _
      (transH (ap _ Laws[C,O.idEquiv C.ob,idhom].all (\ p -> (p,identity.2.2.2)) _ _ (IdentityLaws.id-prop identity.2.2.1 s.1))
        (ap _ Laws[C,O.idEquiv C.ob,idhom].all (\ p -> (s.1,\ x y z k g -> p x y z g k)) _ _
          (IdentityLaws.comp-prop (\ x y z g k -> identity.2.2.2 x y z k g) (\ x y z g k -> s.2 x y z k g)))) ;
  module BaseCase (t : S.Operations[C.ob,C.hom]) (s : Laws[build C.ob C.hom t,O.idEquiv C.ob,idhom].all) {
    module U0 = Fixed.BaseCase[t,s.1,s.2] ;
    path : Id (S.Operations[C.ob,C.hom]) ops t = S.Fixed[C.ob,C.hom].equal ops t U0.identity-eq U0.composition-eq ;
    result : Id total center (build C.ob C.hom t,O.idEquiv C.ob,idhom,s) = idJ (S.Operations[C.ob,C.hom]) ops
      (\ u r -> (k : Laws[build C.ob C.hom u,O.idEquiv C.ob,idhom].all) -> Id total center (build C.ob C.hom u,O.idEquiv C.ob,idhom,k))
      unit-proof t path s ;
  } ;
  motive (v : E.Family) (e : E.FiberEquiv v) : U (o+ \/ h+) =
    (t : S.Operations[C.ob,\ x y -> v (x,y)]) (s : Laws[build C.ob (\ x y -> v (x,y)) t,O.idEquiv C.ob,\ x y -> e (x,y)].all) ->
    Id total center (build C.ob (\ x y -> v (x,y)) t,O.idEquiv C.ob,(\ x y -> e (x,y)),s) ;
  fixed (v : E.Family) (e : E.FiberEquiv v) : motive v e =
    E.eqind motive (\ t s -> BaseCase[t,s].result) v e ;
  object-motive (V : U o) (f : O.Equiv C.ob V) : U (o+ \/ h+) =
    (m : V -> V -> U h) (t : S.Operations[V,m]) (e : (x y : C.ob) -> H.Equiv (C.hom x y) (m (f.1 x) (f.1 y)))
    (s : Laws[build V m t,f,e].all) -> Id total center (build V m t,f,e,s) ;
  objects (V : U o) (f : O.Equiv C.ob V) : object-motive V f =
    subst (O.Equiv C.ob V) (object-motive V) _ f ((univ @o C.ob V).sec-eq f)
      (idJ (U o) C.ob (\ Z q -> object-motive Z (Axioms[o].idtoeqv C.ob Z q))
        (\ m t e s -> fixed (\ i -> m i.1 i.2) (\ i -> e i.1 i.2) t s) V ((univ @o C.ob V).sec f)) ;
  contract : (D : K.Precategory) (i : iso D) -> Id total center (D,i) =
    split { Precategory V m hs idn comp left right assoc -> \ i ->
      objects V i.1 m (new S.Operations[V,m,hs,idn,comp,left,right,assoc]) i.2.1 i.2.2 } ;
  module FT = FundThm[o+ \/ h+].FT[K.Precategory,C,\ D -> iso D,identity,(center,\ w -> contract w.1 w.2)] ;
  equality (D : K.Precategory) : Equiv (Id K.Precategory C D) (iso D) = (FT.tr D,FT.equiv D) ;
} ;
-- Adding the propositional univalence field preserves the identity principle.
module UnivalentFrom (C : K.Category) {
  module I = From[C.pre] ;
  iso (D : K.Category) : U (o \/ h) = I.iso D.pre ;
  total : U (o+ \/ h+) = (D : K.Category) * iso D ;
  extended : U (o+ \/ h+) = (w : I.total) * K.Univalent w.1 ;
  pack (w : extended) : total = (new K.Category[w.1.1,w.2],w.1.2) ;
  base : extended = ((C.pre,I.identity),C.univalent) ;
  lift (D : K.Precategory) (i : I.iso D) (u : K.Univalent D) :
    Id extended base ((D,i),u) =
    Sigma-eq I.total (\ w -> K.Univalent w.1) _ _ _ _
      (transH (symH (I.contract C.pre I.identity)) (I.contract D i))
      S.Proofs[new K.Category[D,u]].univalence-prop ;
  center : total = pack base ;
  contract : (D : K.Category) (i : iso D) -> Id total center (D,i) =
    split { Category D u -> \ i -> apH pack (lift D i u) } ;
  module FT = FundThm[o+ \/ h+].FT[K.Category,C,\ D -> iso D,I.identity,(center,\ w -> contract w.1 w.2)] ;
  equality (D : K.Category) : Equiv (Id K.Category C D) (iso D) = (FT.tr D,FT.equiv D) ;
  module Weak (D : K.Category) (F : Functor[o,h,o,h].Functor[C.pre,D.pre])
    (ff : Functor[o,h,o,h].FullyFaithful C.pre D.pre F) (es : Functor[o,h,o,h].EssSurj C.pre D.pre F) {
    module E = FullyFaithful[o,h,o,h,o \/ h].FullyFaithful[C,D,F,ff] ;
    object-equiv : O.Equiv C.pre.ob D.pre.ob = (F.obj,O.qinv _ _ F.obj (E.equiv es).sec (E.equiv es).sec-eq
      (Prelude[o \/ h].sec-ret _ _ F.obj (E.equiv es))) ;
    strict : iso D = (object-equiv,(\ x y -> (F.map x y,ff x y)),F.map-idn,\ x y z k g -> F.map-comp x y z g k) ;
    path : Id K.Category C D = (equality D).2.sec strict ;
    computes : Id (iso D) ((equality D).1 path) strict = (equality D).2.sec-eq strict ;
  } ;
} ;
