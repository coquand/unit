-- Theorem 3.9.11 for n = 0, existence part. A factorization f ~ h g with g
-- 0-connected and h 0-truncated identifies the 0-image of f with the middle
-- type, compatibly with both triangles.
level u ; open Base ; open Prelude[u] ; open Paths[u] ;
module W = Whitehead[u] ; module HL = HLevels[u] ; module Cn = Connected[u] ;
two : Nat = suc (suc zero) ;
module Comparison (A X B : U u) (f : A -> B) (g : A -> X) (h : X -> B)
  (H : (a : A) -> Id B (h (g a)) (f a))
  (cg : (x : X) -> Cn.isConn two (W.fib A X g x))
  (th : (b : B) -> HL.isTrunc two (W.fib X B h b)) {
  module Im = HigherImages[u,u].Image[suc zero,A,B,f] ; op : Truncations[u].TruncOp[two] = Im.op ;
  fibre (b : B) : U u = W.fib A B f b ;
  T (b : B) : U u = op.T (fibre b) ;
  unit (b : B) (w : fibre b) : T b = op.unit (fibre b) w ;
  paths (Y : U u) (t : HL.isTrunc two Y) (y y' : Y) : HL.isTrunc two (Id Y y y') = HL.trunc-suc (suc zero) (Id Y y y') (t y y') ;
  -- transport in the truncated fibres
  move (b : B) (a : A) (p0 : Id B (f a) b) (c : B) (p : Id B b c) :
    Id (T c) (subst B T b c p (unit b (a,p0))) (unit c (a,trans B (f a) b c p0 p)) =
    idJ B b (\ c1 p1 -> Id (T c1) (subst B T b c1 p1 (unit b (a,p0))) (unit c1 (a,trans B (f a) b c1 p0 p1))) (refl (unit b (a,p0))) c p ;
  -- from the image to X, fibrewise
  module Down (b : B) {
    module E = ConnectedMaps[u].Elim[two,fibre b,T b,unit b,op.conn (fibre b),\ z -> W.fib X B h b,\ z -> th b] ;
    base (w : fibre b) : W.fib X B h b = (g w.1,trans B _ _ _ (H w.1) w.2) ;
    map (z : T b) : W.fib X B h b = E.ext base z ;
    beta (w : fibre b) : Id (W.fib X B h b) (map (unit b w)) (base w) = E.ext-beta base w ;
  } ;
  down (w : Im.space) : X = (Down[w.1].map w.2).1 ;
  -- from X to the image
  module Up = ConnectedMaps[u].Elim[two,A,X,g,cg,\ x -> T (h x),\ x -> op.trunc (fibre (h x))] ;
  section-at (a : A) : T (h (g a)) = unit (h (g a)) (a,sym B _ _ (H a)) ;
  section (x : X) : T (h x) = Up.ext section-at x ;
  up (x : X) : Im.space = (h x,section x) ;
  -- down after up
  module Back = ConnectedMaps[u].Elim[two,A,X,g,cg,\ x -> Id (W.fib X B h (h x)) (Down[h x].map (section x)) (x,refl (h x)),
    \ x -> paths (W.fib X B h (h x)) (th (h x)) _ _] ;
  back-at (a : A) : Id (W.fib X B h (h (g a))) (Down[h (g a)].map (section (g a))) (g a,refl (h (g a))) =
    transH (apH (Down[h (g a)].map) (Up.ext-beta section-at a)) (transH (Down[h (g a)].beta (a,sym B _ _ (H a)))
      (ap (Id B (h (g a)) (h (g a))) (W.fib X B h (h (g a))) (\ p -> (g a,p)) _ _ (Groupoid[u].trans-sym-r B _ _ (H a)))) ;
  down-up (x : X) : Id X (down (up x)) x = ap (W.fib X B h (h x)) X (\ w -> w.1) _ _ (Back.ext back-at x) ;
  -- up after down
  over (b : B) (y : W.fib X B h b) : T b = subst B T (h y.1) b y.2 (section y.1) ;
  module Forth (b : B) {
    module E = ConnectedMaps[u].Elim[two,fibre b,T b,unit b,op.conn (fibre b),\ z -> Id (T b) (over b (Down[b].map z)) z,
      \ z -> paths (T b) (op.trunc (fibre b)) _ _] ;
    at (w : fibre b) : Id (T b) (over b (Down[b].map (unit b w))) (unit b w) =
      transH (apH (over b) (Down[b].beta w))
        (transH (apH (subst B T (h (g w.1)) b (trans B _ _ _ (H w.1) w.2)) (Up.ext-beta section-at w.1))
          (transH (move (h (g w.1)) w.1 (sym B _ _ (H w.1)) b (trans B _ _ _ (H w.1) w.2))
            (ap (Id B (f w.1) b) (T b) (\ p -> unit b (w.1,p)) _ _ (trans-cancel B _ _ _ (H w.1) w.2)))) ;
  } ;
  up-down (w : Im.space) : Id Im.space (up (down w)) w =
    Sigma-path B T (h (down w)) w.1 (section (down w)) w.2 (Down[w.1].map w.2).2 (Forth[w.1].E.ext Forth[w.1].at w.2) ;
  equivalence : Equiv Im.space X = (down,qinv Im.space X down up down-up up-down) ;
  -- the two triangles
  left (a : A) : Id X (down (Im.quotient a)) (g a) =
    ap (W.fib X B h (f a)) X (\ y -> y.1) _ _ (Down[f a].beta (a,refl (f a))) ;
  right (w : Im.space) : Id B (h (down w)) (Im.inclusion w) = (Down[w.1].map w.2).2 ;
} ;
