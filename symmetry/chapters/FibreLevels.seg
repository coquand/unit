-- Construction 2.17.7 and Corollary 2.17.9, including the based test.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module H = HLevels[l] ; module W = Whitehead[l] ; module CM = ConnectedMaps[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Of (A B : U l) (f : A -> B) {
  module S = ConnectedLaws[l].Surjection[A,B,f] ;
  paths (x y : A) : U l = Id B (f x) (f y) ;
  over (x y : A) (w : paths x y) : U l = W.fib (Id A x y) (paths x y) (ap A B f x y) w ;
  difference (b : B) (u v : S.fibre b) : paths u.1 v.1 = transH u.2 (symH v.2) ;
  identify (x y : A) (b : B) (q : Id B (f y) b) : (p : Id B (f x) b) ->
    Equiv (over x y (transH p (symH q))) (Id (S.fibre b) (x,p) (y,q)) =
    idJ B (f y) (\ z r -> (p : Id B (f x) z) -> Equiv (over x y (transH p (symH r))) (Id (S.fibre z) (x,p) (y,r)))
      (CM.fib-ap A B f x y) b q ;
  test (n : Nat) (x y : A) : U l = (w : paths x y) -> H.isTrunc n (over x y w) ;
  prop (n : Nat) (x y : A) : isProp (test n x y) = FL.isProp-Pi (paths x y) (\ w -> H.isTrunc n (over x y w))
    (\ w -> H.trunc-prop n (over x y w)) ;
  lower (n : Nat) (h : (b : B) -> H.isTrunc (suc n) (S.fibre b)) (x y : A) (w : paths x y) : H.isTrunc n (over x y w) =
    H.equiv-trunc n _ _ (CM.fib-ap A B f x y w) (h (f y) (x,w) (y,refl (f y))) ;
  upper (n : Nat) (h : (x y : A) -> test n x y) (b : B) (u v : S.fibre b) : H.isTrunc n (Id (S.fibre b) u v) =
    H.equiv-trunc' n _ _ (identify u.1 v.1 b v.2 u.2) (h u.1 v.1 (difference b u v)) ;
  based (n : Nat) (a : A) (c : ConnectedLaws[l].conn A) (h : test n a a) (b : B) : H.isTrunc (suc n) (S.fibre b) =
    upper n (Connected[l].conn-elim2 zero A a c (test n) (prop n) h) b ;
  reflect (h : (b : B) -> isProp (S.fibre b)) (x y : A) : isEquiv (Id A x y) (paths x y) (ap A B f x y) =
    W.contr-equiv _ _ _ (lower zero (\ b -> H.prop-paths _ (h b)) x y) ;
  module SetTarget (set : isSet B) {
    to (h : (b : B) -> isProp (S.fibre b)) (x y : A) : paths x y -> Id A x y = (reflect h x y).sec ;
    from (inj : (x y : A) -> paths x y -> Id A x y) (b : B) (u v : S.fibre b) : Id (S.fibre b) u v =
      Sigma-eq A (\ a -> Id B (f a) b) _ _ _ _ (inj u.1 v.1 (difference b u v)) (set _ b) ;
  } ;
} ;
