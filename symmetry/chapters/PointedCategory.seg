-- Section 6.2. Pointed types and the full concrete group example.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module W = WildCategory[l+,l] ; module P = PointedIdentities[l] ; module L = LoopCalc[l] ;
module M = Lemma4[l] ; module O = PtEquivOps[l] ; module B = Prelude[l+] ;
hom (x y : P.pointed) : U l = M.PtMap x.1 x.2 y.1 y.2 ;
identity (x : P.pointed) : hom x x = L.ptid x.1 x.2 ;
compose (x y z : P.pointed) (g : hom y z) (f : hom x y) : hom x z = L.ptcomp x.1 x.2 y.1 y.2 z.1 z.2 f g ;
ap-identity (X : U l) (a b : X) (p : Id X a b) : Id (Id X a b) (ap X X (\ x -> x) a b p) p =
  idJ X a (\ t q -> Id (Id X a t) (ap X X (\ x -> x) a t q) q) (refl (refl a)) b p ;
unit-l (x y : P.pointed) (f : hom x y) : Id (hom x y) (compose x y y (identity y) f) f =
  ap (Id y.1 (f.1 x.2) y.2) (hom x y) (\ q -> (f.1,q)) _ _ (ap-identity y.1 _ _ f.2) ;
unit-r (x y : P.pointed) (f : hom x y) : Id (hom x y) (compose x x y f (identity x)) f =
  ap (Id y.1 (f.1 x.2) y.2) (hom x y) (\ q -> (f.1,q)) _ _ (trans-refl-l y.1 _ _ f.2) ;
assoc (w x y z : P.pointed) (f : hom w x) (g : hom x y) (k : hom y z) :
  Id (hom w z) (compose w y z k (compose w x y g f)) (compose w x z (compose x y z k g) f) =
  L.ptcomp-assoc w.1 w.2 x.1 x.2 y.1 y.2 z.1 z.2 f g k ;
category : W.Wild = new W.Wild[P.pointed,hom,identity,compose,unit-l,unit-r,assoc] ;
module At (x y : P.pointed) {
  maps : U l = hom x y ; iso : U l = category.iso x y ;
  pe : U l = M.PtEquiv x.1 x.2 y.1 y.2 ;
  pack (e : pe) : iso = (e.1,((O.pt-inv x.1 x.2 y.1 y.2 e).1,L.pt-inv-r x.1 x.2 y.1 y.2 e),
    (O.pt-inv x.1 x.2 y.1 y.2 e).1,L.pt-inv-l x.1 x.2 y.1 y.2 e) ;
  underlying (i : iso) : isEquiv x.1 y.1 i.1.1 = new IsEquiv[x.1,y.1,i.1.1,
    i.2.1.1.1,\ b -> ap (hom y y) y.1 (\ f -> f.1 b) _ _ i.2.1.2,
    i.2.2.1.1,\ a -> ap (hom x x) x.1 (\ f -> f.1 a) _ _ i.2.2.2] ;
  unpack (i : iso) : pe = (i.1,underlying i) ;
  beta (i : iso) : Id iso (pack (unpack i)) i = Sigma-eq maps (\ f -> WildIsos[l+,l].At[category,x,y,f].data-inv)
    _ _ _ _ (refl i.1) WildIsos[l+,l].At[category,x,y,i.1].prop ;
  eta (e : pe) : Id pe (unpack (pack e)) e = Sigma-eq maps (\ f -> isEquiv x.1 y.1 f.1) _ _ _ _
    (refl e.1) (EquivProp[l].isEquiv-prop x.1 y.1 e.1.1) ;
  compare : B.Equiv pe iso = (pack,B.qinv _ _ pack unpack beta eta) ;
} ;
computes (x y : P.pointed) (q : Id P.pointed x y) :
  Id (category.iso x y) (At[x,y].pack ((P.From[x.1,x.2].univalence y).1 q)) (category.idtoiso x y q) =
  idJ P.pointed x (\ z r -> Id (category.iso x z) (At[x,z].pack ((P.From[x.1,x.2].univalence z).1 r)) (category.idtoiso x z r))
    (Sigma-eq (hom x x) (\ f -> WildIsos[l+,l].At[category,x,x,f].data-inv) _ _ _ _
      (refl (identity x)) WildIsos[l+,l].At[category,x,x,identity x].prop) y q ;
univalent : category.univalent = \ x y -> EquivalenceLemmas[l+].homotopy _ _ _ _ (computes x y)
  (EquivalenceLemmas[l+].compose _ _ _ At[x,y].pack (P.From[x.1,x.2].univalence y).1 At[x,y].compare.2 (P.From[x.1,x.2].univalence y).2) ;
module Groups {
  module G = ChapterFour[l] ; module K = Category[l+,l] ;
  pt (x : G.ConcreteGroup) : P.pointed = (x.space,x.point) ;
  pre : K.Precategory = new K.Precategory[G.ConcreteGroup,G.Hom,\ x y -> InfinityGroups[l].Identifications[x,y].hom-set,
    \ x -> identity (pt x),G.compose,\ x y -> unit-l (pt x) (pt y),\ x y -> unit-r (pt x) (pt y),
    \ w x y z -> assoc (pt w) (pt x) (pt y) (pt z)] ;
  module Compare (x y : G.ConcreteGroup) {
    module I = InfinityGroups[l].Identifications[x,y] ; module T = At[pt x,pt y] ;
    to (e : I.iso) : pre.Iso x y = (e.1,(O.pt-inv x.space x.point y.space y.point e).1,
      L.pt-inv-l x.space x.point y.space y.point e,L.pt-inv-r x.space x.point y.space y.point e) ;
    from (i : pre.Iso x y) : I.iso = T.unpack (i.1,(i.2.1,i.2.2.2),i.2.1,i.2.2.1) ;
    correspondence : B.Equiv I.iso (pre.Iso x y) = (to,B.qinv _ _ to from
      (\ i -> Arrows[l+,l].Arrows[pre].iso-eq _ i (refl i.1))
      (\ e -> Sigma-eq (G.Hom x y) (\ m -> isEquiv x.space y.space m.1) _ _ _ _ (refl e.1)
        (EquivProp[l].isEquiv-prop _ _ e.1.1))) ;
  } ;
  group-computes (x y : G.ConcreteGroup) (q : Id G.ConcreteGroup x y) :
    Id (pre.Iso x y) (Compare[x,y].to (InfinityGroups[l].Identifications[x,y].paths.1 q)) (pre.idtoiso x y q) =
    idJ G.ConcreteGroup x (\ z r -> Id (pre.Iso x z)
      (Compare[x,z].to (InfinityGroups[l].Identifications[x,z].paths.1 r)) (pre.idtoiso x z r))
      (Arrows[l+,l].Arrows[pre].iso-eq _ _ (refl (identity (pt x)))) y q ;
  groups : K.Category = new K.Category[pre,\ x y -> EquivalenceLemmas[l+].homotopy _ _ _ _ (group-computes x y)
    (EquivalenceLemmas[l+].compose _ _ _ Compare[x,y].to InfinityGroups[l].Identifications[x,y].paths.1
      Compare[x,y].correspondence.2 InfinityGroups[l].Identifications[x,y].paths.2)] ;
} ;

module Binary (X Y : P.pointed) {
  pair : P.pointed = (X.1 * Y.1,X.2,Y.2) ;
  fst : hom pair X = (\ w -> w.1,refl X.2) ; snd : hom pair Y = (\ w -> w.2,refl Y.2) ;
  module From (T : P.pointed) {
    legs : U l = hom T X * hom T Y ;
    project (h : hom T pair) : legs = (compose T pair X fst h,compose T pair Y snd h) ;
    build (s : legs) : hom T pair = ((\ t -> (s.1.1 t,s.2.1 t)),
      GroupIdentity[l].pairs X.1 Y.1 _ _ _ _ s.1.2 s.2.2) ;
    module Coordinates (a : X.1) (b : Y.1) {
      xy : U l = X.1 * Y.1 ;
      path (z : xy) (p : Id X.1 a z.1) (q : Id Y.1 b z.2) : Id xy (a,b) z =
        GroupIdentity[l].pairs X.1 Y.1 a z.1 b z.2 p q ;
      left (x : X.1) (p : Id X.1 a x) (y : Y.1) (q : Id Y.1 b y) :
        Id (Id X.1 a x) (ap xy X.1 fst.1 (a,b) (x,y) (path (x,y) p q)) p =
        idJ X.1 a (\ u r -> (v : Y.1) (s : Id Y.1 b v) -> Id (Id X.1 a u) (ap xy X.1 fst.1 (a,b) (u,v) (path (u,v) r s)) r)
          (\ v s -> idJ Y.1 b (\ w h -> Id (Id X.1 a a) (ap xy X.1 fst.1 (a,b) (a,w) (path (a,w) (refl a) h)) (refl a))
            (refl (refl a)) v s) x p y q ;
      right (x : X.1) (p : Id X.1 a x) (y : Y.1) (q : Id Y.1 b y) :
        Id (Id Y.1 b y) (ap xy Y.1 snd.1 (a,b) (x,y) (path (x,y) p q)) q =
        idJ X.1 a (\ u r -> (v : Y.1) (s : Id Y.1 b v) -> Id (Id Y.1 b v) (ap xy Y.1 snd.1 (a,b) (u,v) (path (u,v) r s)) s)
          (\ v s -> idJ Y.1 b (\ w h -> Id (Id Y.1 b w) (ap xy Y.1 snd.1 (a,b) (a,w) (path (a,w) (refl a) h)) h)
            (refl (refl b)) v s) x p y q ;
      eta (z : xy) (p : Id xy (a,b) z) : Id (Id xy (a,b) z) (path z (apH fst.1 p) (apH snd.1 p)) p =
        idJ xy (a,b) (\ t q -> Id (Id xy (a,b) t) (path t (apH fst.1 q) (apH snd.1 q)) q) (refl (refl (a,b))) z p ;
    } ;
    module Section (s : legs) {
      module Z = Coordinates[s.1.1 T.2,s.2.1 T.2] ;
      left : Id (hom T X) (project (build s)).1 s.1 = ap _ (hom T X) (\ p -> (s.1.1,p)) _ _ (Z.left X.2 s.1.2 Y.2 s.2.2) ;
      right : Id (hom T Y) (project (build s)).2 s.2 = ap _ (hom T Y) (\ p -> (s.2.1,p)) _ _ (Z.right X.2 s.1.2 Y.2 s.2.2) ;
      law : Id legs (project (build s)) s = GroupIdentity[l].pairs (hom T X) (hom T Y) _ _ _ _ left right ;
    } ;
    eta (h : hom T pair) : Id (hom T pair) (build (project h)) h =
      ap _ (hom T pair) (\ q -> (h.1,q)) _ _ (Coordinates[(h.1 T.2).1,(h.1 T.2).2].eta pair.2 h.2) ;
    equiv : Equiv (hom T pair) legs = (project,qinv _ _ project build (\ s -> Section[s].law) eta) ;
  } ;
} ;
module GroupProduct (G H : ChapterFour[l].ConcreteGroup) {
  module K = ConcreteExamples[l].Binary[G,H] ;
  module B0 = Binary[Groups.pt G,Groups.pt H] ;
  module Cones = ProductCones[l+,l].Binary[W.forget Groups.pre,G,H] ;
  apex : Cones.cone = (K.group,K.first,K.second) ;
  product : Cones.product = (apex,\ v -> WildIsos[l,l].contract _ _ B0.From[Groups.pt v.1].equiv v.2) ;
} ;

module Extremal = W.Extremal[category] ;
one : P.pointed = (Top,tt) ;
terminal : Extremal.terminal one = \ x -> (((\ t -> tt),refl tt),\ h ->
  Sigma-eq (x.1 -> Top) (\ f -> Id Top (f x.2) tt) _ _ _ _
    (Axioms[l].FunExtLemmas[fe @l].funext x.1 (\ t -> Top) _ h.1 (\ t -> isTop tt (h.1 t))) (prop-to-set Top isTop _ _)) ;
module FromOne (y : P.pointed) (h : hom one y) {
  start : hom one y = ((\ t -> y.2),refl y.2) ;
  at : (t : Top) -> Id y.1 (h.1 t) y.2 = split { tt -> h.2 } ;
  law : Id (hom one y) h start = DeloopMaps[l].ptmap-path Top tt y.1 y.2 h.1 start.1 h.2 start.2 at (refl h.2) ;
} ;
initial : Extremal.initial one = \ y -> (((\ t -> y.2),refl y.2),\ h -> symH FromOne[y,h].law) ;
module GroupExtremal = W.Extremal[W.forget Groups.pre] ;
trivial-terminal : GroupExtremal.terminal SignOrderings[l].trivial = \ G -> ConcreteExamples[l].TrivialMaps[G].terminal ;
trivial-initial : GroupExtremal.initial SignOrderings[l].trivial = \ G -> ConcreteExamples[l].TrivialMaps[G].initial ;

module FreePoint {
  module Opt = FinChoice[l] ; module TC = CategoryOfTypes[l] ; module F = WildFunctors[l+,l,l+,l] ;
  free (X : U l) : P.pointed = (Opt.Opt X,none) ;
  map (X Y : U l) (f : X -> Y) : hom (free X) (free Y) = (FiniteCycles[l].option-map X Y f,refl none) ;
  module Laws (X : U l) {
    id-point : (z : Opt.Opt X) -> Id (Opt.Opt X) ((map X X (\ x -> x)).1 z) z =
      split { none -> refl none ; some x -> refl (some x) } ;
    idn : Id (hom (free X) (free X)) (map X X (\ x -> x)) (identity (free X)) =
      DeloopMaps[l].ptmap-path (Opt.Opt X) none (Opt.Opt X) none _ _ (refl none) (refl none) id-point (refl (refl none)) ;
    module Comp (Y Z : U l) (g : Y -> Z) (f : X -> Y) {
      pt : (z : Opt.Opt X) -> Id (Opt.Opt Z) ((map X Z (\ x -> g (f x))).1 z) ((map Y Z g).1 ((map X Y f).1 z)) =
        split { none -> refl none ; some x -> refl (some (g (f x))) } ;
      law : Id (hom (free X) (free Z)) (map X Z (\ x -> g (f x))) (compose (free X) (free Y) (free Z) (map Y Z g) (map X Y f)) =
        DeloopMaps[l].ptmap-path (Opt.Opt X) none (Opt.Opt Z) none _ _ (refl none) (refl none) pt (refl (refl none)) ;
    } ;
  } ;
  plus : F.Map[TC.types,category] = new F.Map[TC.types,category,free,map,\ X -> Laws[X].idn,\ X Y Z g f -> Laws[X].Comp[Y,Z,g,f].law] ;
  forget : F.Map[category,TC.types] = new F.Map[category,TC.types,\ X -> X.1,\ X Y f -> f.1,
    \ X -> refl (\ x -> x),\ X Y Z g f -> refl (\ x -> g.1 (f.1 x))] ;
  module FC = FunctorComposition[l+,l] ;
  unit : F.Between[TC.types,TC.types].transformation (FC.identity TC.types) (FC.compose TC.types category TC.types forget plus) =
    ((\ X x -> some x),\ X Y f -> refl (\ x -> some (f x))) ;
  module Adj = Adjunctions[l+,l,l+,l].Wild[TC.types,category,plus,forget] ;
  adjunction : Adj.Adjunction = new Adj.Adjunction[\ X Y -> PointedAdjunction[l,l].Adjoin[X,Y.1,Y.2].adjunction,
    \ X Y Z u v -> refl (\ y -> v.1 (some (u y))),\ X Y Z v u -> refl (\ x -> u.1 (v.1 (some x)))] ;
} ;
module LoopFunctor {
  pointed (X : P.pointed) : P.pointed = (Id X.1 X.2 X.2,refl X.2) ;
  on (X Y : P.pointed) : hom X Y -> hom (pointed X) (pointed Y) = DeloopMaps[l].Maps[X.1,X.2,Y.1,Y.2].loop ;
  module IdentityLaw (X : P.pointed) {
    module M0 = DeloopMaps[l].Maps[X.1,X.2,X.1,X.2] ;
    point (p : (pointed X).1) : Id (pointed X).1 ((on X X (identity X)).1 p) p =
      transH (M0.loop-ap (identity X) p) (transH (trans-refl-l _ _ _ (apH (\ x -> x) p)) (ap-identity _ _ _ p)) ;
    law : Id (hom (pointed X) (pointed X)) (on X X (identity X)) (identity (pointed X)) =
      DeloopMaps[l].ptmap-path (pointed X).1 (pointed X).2 (pointed X).1 (pointed X).2 _ _ _ _ point (refl (refl (refl X.2))) ;
  } ;
  module F = WildFunctors[l+,l,l+,l] ;
  loops : F.Map[category,category] = new F.Map[category,category,pointed,on,(\ X -> IdentityLaw[X].law),
    (\ X Y Z g f -> L.loop-comp X.1 X.2 Y.1 Y.2 Z.1 Z.2 f g)] ;
  underlying (G : Groups.G.ConcreteGroup) : CategoryOfSets[l].ob = ((pointed (Groups.pt G)).1,HLevels[l].trunc-set _ (G.groupoid G.point G.point)) ;
  symmetries : Functor[l+,l,l+,l].Functor[Groups.pre,CategoryOfSets[l].pre] =
    new Functor[l+,l,l+,l].Functor[Groups.pre,CategoryOfSets[l].pre,underlying,(\ G H f -> (on (Groups.pt G) (Groups.pt H) f).1),
      (\ G -> apH (\ p -> p.1) (IdentityLaw[Groups.pt G].law)),(\ G H K g f -> apH (\ p -> p.1) (loops.map-comp (Groups.pt G) (Groups.pt H) (Groups.pt K) g f))] ;
} ;
