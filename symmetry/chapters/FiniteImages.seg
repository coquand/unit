-- Section 2.24. A discrete surjective image of a finite set is finite.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ; open Logic[l] ;
module F = FiniteSets[l] ; module D = FiniteDecisions[l] ; module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Image (X Y : U l) (f : X -> Y) (d : D.Discrete Y)
    (onto : (y : Y) -> T.Trunc[(x : X) * Id Y (f x) y].carrier) {
  module Labels (n : Nat) (e : Equiv (Fin n) X) {
    map (i : Fin n) : Y = f (e.1 i) ;
    fibre (y : Y) : U l = (i : Fin n) * Id Y (map i) y ;
    lift (y : Y) (w : (x : X) * Id Y (f x) y) : fibre y =
      (e.2.sec w.1,transH (apH f (e.2.sec-eq w.1)) w.2) ;
    pick (y : Y) : Dec (fibre y) -> fibre y = split {
      yes w -> w ; no h -> absurd (fibre y) (TC.rec _ @l Empty isProp-Empty (\ w -> h (lift y w)) (onto y)) } ;
    chosen (y : Y) : fibre y = pick y (D.search n (\ i -> Id Y (map i) y) (\ i -> d (map i) y)) ;
    rep (i : Fin n) : U l = Id (Fin n) (chosen (map i)).1 i ;
    prop (i : Fin n) : isProp (rep i) = FiniteCycles[l].fin-set n _ _ ;
    reps : U l = (i : Fin n) * rep i ;
    bounded : F.Finite reps = FiniteArithmetic[l].sigma _ (FiniteCounting[l].standard n) rep
      (\ i -> FiniteSubsets[l].Proposition[rep i,prop i].finite (D.standard n _ i)) ;
    section (y : Y) : reps = ((chosen y).1,apH (\ z -> (chosen z).1) (chosen y).2) ;
    equiv : Equiv reps Y = (\ w -> map w.1,qinv reps Y (\ w -> map w.1) section
      (\ y -> (chosen y).2) (\ w -> Sigma-eq (Fin n) rep _ _ _ _ w.2 (prop w.1))) ;
  } ;
  finite : F.Finite X -> F.Finite Y = TC.rec ((n : Nat) * Equiv (Fin n) X) @l _ (F.Universe.finite-prop Y)
    (\ w -> FiniteArithmetic[l].Change[Labels[w.1,w.2].reps,Y,Labels[w.1,w.2].equiv].finite Labels[w.1,w.2].bounded) ;
} ;
module QuotientOf (X : U l) (r : X -> X -> U l) (p : (x y : X) -> isProp (r x y))
  (rr : (x : X) -> r x x) (rs : (x y : X) -> r x y -> r y x)
  (rt : (x y z : X) -> r x y -> r y z -> r x z) (d : (x y : X) -> Dec (r x y)) {
  module Q = Quotient[l].Quot[X,r,p,rr,rs,rt] ;
  decision (q t : Q.Q) : U l = Dec (Id Q.Q q t) ;
  prop (q t : Q.Q) : isProp (decision q t) = dec-prop _ (Q.set q t) ;
  discrete (q t : Q.Q) : decision q t = Q.induction @l (\ z -> decision z t) (\ z -> prop z t) (\ x ->
    Q.induction @l (decision (Q.inc x)) (prop (Q.inc x)) (\ y ->
      D.transfer _ _ (Q.relates x y) (Q.effective x y) (d x y)) t) q ;
  fibre (q : Q.Q) : U l = (x : X) * Id Q.Q (Q.inc x) q ;
  onto : (q : Q.Q) -> T.Trunc[fibre q].carrier = Q.induction @l (\ q -> T.Trunc[fibre q].carrier)
    (\ q -> T.Trunc[fibre q].proposition) (\ x -> T.Trunc[fibre (Q.inc x)].inc (x,refl (Q.inc x))) ;
  finite : F.Finite X -> F.Finite Q.Q = Image[X,Q.Q,Q.inc,discrete,onto].finite ;
} ;
