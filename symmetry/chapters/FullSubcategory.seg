-- Section 6.2. Full subcategories on a proposition-valued predicate inherit univalence.
level o h p ; open Base ; open Prelude[o \/ h \/ p] ; open Paths[o \/ h \/ p] ;
module On (C : WildCategory[o,h].Wild) (P : C.ob -> U p) (prop : (x : C.ob) -> isProp (P x)) {
  ob : U (o \/ p) = (x : C.ob) * P x ;
  sub : WildCategory[o \/ p,h].Wild = new WildCategory[o \/ p,h].Wild[ob,\ x y -> C.hom x.1 y.1,\ x -> C.idn x.1,
    \ x y z -> C.comp x.1 y.1 z.1,\ x y -> C.unit-l x.1 y.1,\ x y -> C.unit-r x.1 y.1,
    \ x y z w -> C.assoc x.1 y.1 z.1 w.1] ;
  first : ob -> C.ob = \ w -> w.1 ;
  module At (x : ob) {
    lift (z : C.ob) (e : Id C.ob x.1 z) : (s : P z) -> Id ob x (z,s) =
      idJ C.ob x.1 (\ b r -> (s : P b) -> Id ob x (b,s))
        (\ s -> ap (P x.1) ob (\ t -> (x.1,t)) x.2 s (prop x.1 x.2 s)) z e ;
    at-base : Id (Id ob x x) (lift x.1 (refl x.1) x.2) (refl x) =
      apH (ap (P x.1) ob (\ t -> (x.1,t)) x.2 x.2) (loop-refl (P x.1) (prop-to-set _ (prop x.1)) x.2 (prop x.1 x.2 x.2)) ;
    ret (y : ob) (r : Id ob x y) : Id (Id ob x y) (lift y.1 (apH first r) y.2) r =
      idJ ob x (\ w q -> Id (Id ob x w) (lift w.1 (apH first q) w.2) q) at-base y r ;
    constant (s : P x.1) (q : Id (P x.1) x.2 s) : Id (Id C.ob x.1 x.1)
      (apH first (ap (P x.1) ob (\ t -> (x.1,t)) x.2 s q)) (refl x.1) =
      idJ (P x.1) x.2 (\ t r -> Id (Id C.ob x.1 x.1) (apH first (ap (P x.1) ob (\ v -> (x.1,v)) x.2 t r)) (refl x.1))
        (refl (refl x.1)) s q ;
    sec (z : C.ob) (r : Id C.ob x.1 z) : (s : P z) -> Id (Id C.ob x.1 z) (apH first (lift z r s)) r =
      idJ C.ob x.1 (\ w q -> (s : P w) -> Id (Id C.ob x.1 w) (apH first (lift w q s)) q)
        (\ s -> constant s (prop x.1 x.2 s)) z r ;
    paths (y : ob) : isEquiv (Id ob x y) (Id C.ob x.1 y.1) (ap ob C.ob first x y) =
      qinv _ _ (ap ob C.ob first x y) (\ r -> lift y.1 r y.2) (\ r -> sec y.1 r y.2) (ret y) ;
    computes (y : ob) (q : Id ob x y) : Id (sub.iso x y) (C.idtoiso x.1 y.1 (apH first q)) (sub.idtoiso x y q) =
      idJ ob x (\ w r -> Id (sub.iso x w) (C.idtoiso x.1 w.1 (apH first r)) (sub.idtoiso x w r)) (refl (sub.ident x)) y q ;
  } ;
  univalent (ua : C.univalent) : sub.univalent = \ x y ->
    EquivalenceLemmas[o \/ h \/ p].homotopy _ _ _ _ (At[x].computes y)
      (EquivalenceLemmas[o \/ h \/ p].compose _ _ _ (C.idtoiso x.1 y.1) (ap ob C.ob first x y)
        (qinv _ _ (C.idtoiso x.1 y.1) (ua x.1 y.1).sec (ua x.1 y.1).sec-eq
          (Prelude[o \/ h].sec-ret _ _ _ (ua x.1 y.1))) (At[x].paths y)) ;
} ;
