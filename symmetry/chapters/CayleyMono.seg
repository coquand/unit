-- Theorem 5.6.1 (Cayley), after the Rocq development: the homomorphism
-- rho_G : G -> Sigma_UG classified by z |-> (z = sh_G) is a monomorphism.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module HL = HLevels[l] ;
-- Transport in the family of paths into a fixed point.
transport-to (A : U l) (c a : A) : (b : A) (g : Id A a b) (p : Id A a c) ->
  Id (Id A b c) (subst A (\ z -> Id A z c) a b g p) (trans A b a c (sym A a b g) p) =
  \ b g -> idJ A a (\ b1 g1 -> (p : Id A a c) -> Id (Id A b1 c) (subst A (\ z -> Id A z c) a b1 g1 p) (trans A b1 a c (sym A a b1 g1) p))
    (\ p -> symH (trans-refl-l A a c p)) b g ;
-- Transport along ap is coercion.
coe-ap (A : U l) (P : A -> U l) (a : A) : (b : A) (g : Id A a b) (x : P a) ->
  Id (P b) (coe (P a) (P b) (Big.ap A (U l) P a b g) x) (subst A P a b g x) =
  \ b g -> idJ A a (\ b1 g1 -> (x : P a) -> Id (P b1) (coe (P a) (P b1) (Big.ap A (U l) P a b1 g1) x) (subst A P a b1 g1 x))
    (\ x -> refl x) b g ;
module Regular (G : CG.ConcreteGroup) {
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  module Sym = CG.Symmetric[UG,HL.trunc-set _ (G.groupoid pt pt)] ; module C = Sym.C ;
  K (z : G.space) : U l = Id G.space z pt ;
  fibre (Y : U l) : U l+ = (b : C.base) * Id (U l) (C.extension b) Y ;
  fibre-prop (Y : U l) : Big.isProp (fibre Y) = Groupoid[l+].emb-fib-prop C.base (U l) C.extension C.image.embedding Y ;
  reach (z : G.space) (p : Id G.space pt z) : fibre (K z) =
    (Sym.pt,Big.trans (U l) _ _ _ (C.triangle tt) (Big.ap G.space (U l) K pt z p)) ;
  lift (z : G.space) : fibre (K z) = TC.rec (Id G.space pt z) @(l+) (fibre (K z)) (fibre-prop (K z)) (reach z) ((G.connected.2 pt z).1) ;
  F (z : G.space) : C.base = (lift z).1 ;
  e (z : G.space) : Id (U l) (C.extension (F z)) (K z) = (lift z).2 ;
  pointing : Id C.base (F pt) Sym.pt = (C.image.embedding (F pt) Sym.pt).sec (Big.trans (U l) _ _ _ (e pt) (Big.sym (U l) _ _ (C.triangle tt))) ;
  rho : CG.Hom G Sym.group = (F,pointing) ;
  module M = DeloopMaps[l].Maps[G.space,pt,C.base,Sym.pt] ;
  -- rho on symmetries determines the symmetry.
  on-K (g g' : UG) (h : Id (Id C.base (F pt) (F pt)) (apH F g) (apH F g')) : Id (Id (U l) (K pt) (K pt)) (Big.ap G.space (U l) K pt pt g) (Big.ap G.space (U l) K pt pt g') =
    Paths[l+].transH (LoopConj[l+].ap-homotopy G.space (U l) (\ z -> C.extension (F z)) K e pt pt g)
      (Paths[l+].transH (Big.ap (Id (U l) (C.extension (F pt)) (C.extension (F pt))) (Id (U l) (K pt) (K pt))
        (\ r -> LoopConj[l+].conj (U l) _ _ (e pt) r) _ _
        (Paths[l+].transH (Paths[l+].symH (LoopCalc[l+].ap-ap G.space C.base (U l) F C.extension pt pt g))
          (Paths[l+].transH (Big.ap (Id C.base (F pt) (F pt)) (Id (U l) (C.extension (F pt)) (C.extension (F pt)))
            (\ r -> Big.ap C.base (U l) C.extension (F pt) (F pt) r) _ _ h) (LoopCalc[l+].ap-ap G.space C.base (U l) F C.extension pt pt g'))))
        (Paths[l+].symH (LoopConj[l+].ap-homotopy G.space (U l) (\ z -> C.extension (F z)) K e pt pt g'))) ;
  value (g : UG) : Id (K pt) (coe (K pt) (K pt) (Big.ap G.space (U l) K pt pt g) (refl pt)) (sym G.space pt pt g) =
    transH (coe-ap G.space K pt pt g (refl pt)) (transport-to G.space pt pt pt g (refl pt)) ;
  faithful (g g' : UG) (h : Id (Id C.base (F pt) (F pt)) (apH F g) (apH F g')) : Id UG g g' =
    transH (symH (Groupoid[l].sym-sym G.space pt pt g)) (transH (apH (sym G.space pt pt)
      (transH (symH (value g)) (transH (Big.ap (Id (U l) (K pt) (K pt)) (K pt) (\ r -> coe (K pt) (K pt) r (refl pt)) _ _ (on-K g g' h)) (value g'))))
      (Groupoid[l].sym-sym G.space pt pt g')) ;
  -- Theorem 5.6.1.
  mono : SubgroupTheory[l].Over[Sym.group].isMono G rho = SubgroupTheory[l].injective-fibres _ _
    (HL.trunc-set _ (Sym.group.groupoid Sym.pt Sym.pt)) _ (\ g g' p -> faithful g g'
      (transH (symH (LoopConj[l].conj-back C.base (F pt) Sym.pt pointing (apH F g)))
        (transH (apH (LoopConj[l].conj C.base Sym.pt (F pt) (sym C.base (F pt) Sym.pt pointing))
          (transH (symH (M.loop-ap rho g)) (transH p (M.loop-ap rho g'))))
          (LoopConj[l].conj-back C.base (F pt) Sym.pt pointing (apH F g'))))) ;
} ;
