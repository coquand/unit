-- Section 6.2. Bi-invertibility is a proposition even for higher hom types.
level o h ; open Base ; open Prelude[h] ; open Paths[h] ;
module K = WildCategory[o,h] ; module FU = FunExtUA[h] ;
fiber (X Y : U h) (e : Equiv X Y) (y : Y) : U h = (x : X) * Id Y (e.1 x) y ;
contract (X Y : U h) (e : Equiv X Y) : (y : Y) -> FU.isContr (fiber X Y e y) =
  Axioms[h].UnivalenceLemmas[univ @h].eqind X (\ T d -> (t : T) -> FU.isContr (fiber X T d t)) (FU.sing X) Y e ;
module At (C : K.Wild) (x y : C.ob) (f : C.hom x y) {
  data-inv : U h = ((g : C.hom y x) * Id (C.hom y y) (C.comp _ _ _ f g) (C.idn y)) *
    ((g : C.hom y x) * Id (C.hom x x) (C.comp _ _ _ g f) (C.idn x)) ;
  module Inverse (i : data-inv) {
    g : C.hom y x = i.1.1 ; k : C.hom y x = i.2.1 ;
    agree : Id (C.hom y x) k g = transH (symH (C.unit-r _ _ k))
      (transH (apH (C.comp _ _ _ k) (symH i.1.2))
        (transH (C.assoc _ _ _ _ g f k) (transH (apH (\ t -> C.comp _ _ _ t g) i.2.2) (C.unit-l _ _ g)))) ;
    gf : Id (C.hom x x) (C.comp _ _ _ g f) (C.idn x) =
      transH (apH (\ t -> C.comp _ _ _ t f) (symH agree)) i.2.2 ;
    left-law (a b c : C.ob) (s : C.hom a b) (t : C.hom b a)
      (r : Id (C.hom a a) (C.comp _ _ _ t s) (C.idn a)) (u : C.hom c a) :
      Id (C.hom c a) (C.comp _ _ _ t (C.comp _ _ _ s u)) u =
      transH (C.assoc _ _ _ _ u s t) (transH (apH (\ v -> C.comp _ _ _ v u) r) (C.unit-l _ _ u)) ;
    right-law (a b c : C.ob) (s : C.hom a b) (t : C.hom b a)
      (r : Id (C.hom a a) (C.comp _ _ _ t s) (C.idn a)) (u : C.hom a c) :
      Id (C.hom a c) (C.comp _ _ _ (C.comp _ _ _ u t) s) u =
      transH (symH (C.assoc _ _ _ _ s t u)) (transH (apH (C.comp _ _ _ u) r) (C.unit-r _ _ u)) ;
    post (z : C.ob) : Equiv (C.hom z x) (C.hom z y) = (C.comp _ _ _ f,
      qinv _ _ (C.comp _ _ _ f) (C.comp _ _ _ g) (left-law y x z g f i.1.2) (left-law x y z f g gf)) ;
    pre (z : C.ob) : Equiv (C.hom y z) (C.hom x z) = ((\ u -> C.comp _ _ _ u f),
      qinv _ _ (\ u -> C.comp _ _ _ u f) (\ u -> C.comp _ _ _ u g)
        (right-law x y z f g gf) (right-law y x z g f i.1.2)) ;
    property : isProp data-inv = isProp-Sigma (fiber _ _ (post y) (C.idn y))
      (\ t -> fiber _ _ (pre x) (C.idn x))
      (FU.pathC _ (contract _ _ (post y) (C.idn y))) (\ t -> FU.pathC _ (contract _ _ (pre x) (C.idn x))) ;
  } ;
  prop : isProp data-inv = \ i j -> Inverse[i].property i j ;
} ;
module Ordinary (C : Category[o,h].Category) {
  D : K.Wild = K.forget C.pre ;
  module E = EquivalenceLemmas[o \/ h] ; module P = Prelude[o \/ h] ;
  pack (x y : D.ob) (i : C.pre.Iso x y) : D.iso x y = (i.1,(i.2.1,i.2.2.2),i.2.1,i.2.2.1) ;
  unpack (x y : D.ob) (i : D.iso x y) : C.pre.Iso x y = (i.1,i.2.1.1,At[D,x,y,i.1].Inverse[i.2].gf,i.2.1.2) ;
  beta (x y : D.ob) (i : D.iso x y) : Id (D.iso x y) (pack x y (unpack x y i)) i =
    Sigma-eq (D.hom x y) (\ f -> At[D,x,y,f].data-inv) _ _ _ _ (refl i.1) At[D,x,y,i.1].prop ;
  eta (x y : D.ob) (i : C.pre.Iso x y) : Id (C.pre.Iso x y) (unpack x y (pack x y i)) i =
    Sigma-eq (D.hom x y) (C.pre.isIso x y) _ _ _ _ (refl i.1) (Arrows[o,h].Arrows[C.pre].isIso-prop {x} {y} i.1) ;
  compute (x y : D.ob) (p : Id D.ob x y) : Id (D.iso x y) (pack x y (C.pre.idtoiso x y p)) (D.idtoiso x y p) =
    idJ D.ob x (\ z r -> Id (D.iso x z) (pack x z (C.pre.idtoiso x z r)) (D.idtoiso x z r)) (refl (D.ident x)) y p ;
  univalent : D.univalent = \ x y -> E.homotopy _ _ _ _ (compute x y)
    (E.compose _ _ _ (pack x y) (C.pre.idtoiso x y) (P.qinv _ _ (pack x y) (unpack x y) (beta x y) (eta x y)) (C.univalent x y)) ;
} ;
module HomSets (C : K.Wild) (s : (x y : C.ob) -> isSet (C.hom x y)) {
  module Cat = Category[o,h] ; module P = Prelude[o \/ h] ;
  pre : Cat.Precategory = new Cat.Precategory[C.ob,C.hom,s,C.idn,C.comp,C.unit-l,C.unit-r,C.assoc] ;
  module AtPair (x y : C.ob) {
    to (i : C.iso x y) : pre.Iso x y = (i.1,i.2.1.1,At[C,x,y,i.1].Inverse[i.2].gf,i.2.1.2) ;
    from (i : pre.Iso x y) : C.iso x y = (i.1,(i.2.1,i.2.2.2),i.2.1,i.2.2.1) ;
    equiv : P.isEquiv (C.iso x y) (pre.Iso x y) to = P.qinv _ _ to from
      (\ i -> Arrows[o,h].Arrows[pre].iso-eq _ i (refl i.1))
      (\ i -> Sigma-eq (C.hom x y) (\ f -> At[C,x,y,f].data-inv) _ _ _ _ (refl i.1) At[C,x,y,i.1].prop) ;
  } ;
  compute (x y : C.ob) (p : Id C.ob x y) : Id (pre.Iso x y) (AtPair[x,y].to (C.idtoiso x y p)) (pre.idtoiso x y p) =
    idJ C.ob x (\ z r -> Id (pre.Iso x z) (AtPair[x,z].to (C.idtoiso x z r)) (pre.idtoiso x z r))
      (Arrows[o,h].Arrows[pre].iso-eq _ _ (refl (C.idn x))) y p ;
  category (u : C.univalent) : Cat.Category = new Cat.Category[pre,\ x y -> EquivalenceLemmas[o \/ h].homotopy _ _ _ _ (compute x y)
    (EquivalenceLemmas[o \/ h].compose _ _ _ AtPair[x,y].to (C.idtoiso x y) AtPair[x,y].equiv (u x y))] ;
} ;
module Calculus (C : K.Wild) {
  equal (x y : C.ob) (i j : C.iso x y) (p : Id (C.hom x y) i.1 j.1) : Id (C.iso x y) i j =
    Sigma-eq (C.hom x y) (\ f -> At[C,x,y,f].data-inv) _ _ _ _ p At[C,x,y,j.1].prop ;
  module Of (x y : C.ob) (i : C.iso x y) {
    module I = At[C,x,y,i.1].Inverse[i.2] ;
    inverse : C.iso y x = (I.g,(i.1,I.gf),i.1,i.2.1.2) ;
  } ;
  cancel (x y z : C.ob) (f : C.hom x y) (g : C.hom y z) (fi : C.hom y x) (gi : C.hom z y)
    (p : Id (C.hom x x) (C.comp _ _ _ fi f) (C.idn x)) (q : Id (C.hom y y) (C.comp _ _ _ gi g) (C.idn y)) :
    Id (C.hom x x) (C.comp _ _ _ (C.comp _ _ _ fi gi) (C.comp _ _ _ g f)) (C.idn x) =
    transH (symH (C.assoc _ _ _ _ (C.comp _ _ _ g f) gi fi)) (transH (apH (C.comp _ _ _ fi)
      (transH (C.assoc _ _ _ _ f g gi) (transH (apH (\ v -> C.comp _ _ _ v f) q) (C.unit-l _ _ f)))) p) ;
  compose (x y z : C.ob) (j : C.iso y z) (i : C.iso x y) : C.iso x z =
    (C.comp _ _ _ j.1 i.1,
      (C.comp _ _ _ i.2.1.1 j.2.1.1,cancel z y x j.2.1.1 i.2.1.1 j.1 i.1 j.2.1.2 i.2.1.2),
      C.comp _ _ _ i.2.2.1 j.2.2.1,cancel x y z i.1 j.1 i.2.2.1 j.2.2.1 i.2.2.2 j.2.2.2) ;
  module Post (x y z : C.ob) (j : C.iso y z) {
    module I = Of[y,z,j] ;
    back : C.iso x z -> C.iso x y = compose x z y I.inverse ;
    equiv : Equiv (C.iso x y) (C.iso x z) = (compose x y z j,qinv _ _ (compose x y z j) back
      (\ i -> equal _ _ _ i (I.I.left-law z y x I.I.g j.1 j.2.1.2 i.1))
      (\ i -> equal _ _ _ i (I.I.left-law y z x j.1 I.I.g I.I.gf i.1))) ;
  } ;
} ;
module Criterion (C : K.Wild) (Q : (x y : C.ob) -> C.hom x y -> U h) (pr : (x y : C.ob) (f : C.hom x y) -> isProp (Q x y f))
  (to : (x y : C.ob) (f : C.hom x y) -> At[C,x,y,f].data-inv -> Q x y f)
  (phi : (x y : C.ob) -> Prelude[o \/ h].Equiv (Id C.ob x y) ((f : C.hom x y) * Q x y f))
  (agree : (x y : C.ob) (p : Id C.ob x y) -> Id (C.hom x y) (C.idtoiso x y p).1 ((phi x y).1 p).1) {
  module P = Prelude[o \/ h] ; module E = EquivalenceLemmas[o \/ h] ;
  module Pair (x y : C.ob) {
    marked : U h = (f : C.hom x y) * Q x y f ;
    proj (u : marked) : C.hom x y = u.1 ;
    un (u : marked) : Id C.ob x y = (phi x y).2.sec u ;
    equip (u : marked) : C.iso x y = (u.1,subst (C.hom x y) (\ f -> At[C,x,y,f].data-inv) _ u.1
      (transH (agree x y (un u)) (apH proj ((phi x y).2.sec-eq u))) (C.idtoiso x y (un u)).2) ;
    strip (i : C.iso x y) : marked = (i.1,to x y i.1 i.2) ;
    eqv : P.isEquiv marked (C.iso x y) equip = P.qinv _ _ equip strip (\ i -> Calculus[C].equal _ _ _ i (refl i.1))
      (\ u -> Sigma-eq (C.hom x y) (Q x y) _ _ _ _ (refl u.1) (pr x y u.1)) ;
    ua : P.isEquiv (Id C.ob x y) (C.iso x y) (C.idtoiso x y) = E.homotopy _ _ (\ p -> equip ((phi x y).1 p)) (C.idtoiso x y)
      (\ p -> Calculus[C].equal x y _ _ (symH (agree x y p))) (E.compose _ _ _ equip (phi x y).1 eqv (phi x y).2) ;
  } ;
  univalent : C.univalent = \ x y -> Pair[x,y].ua ;
} ;
