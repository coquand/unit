-- Euclidean coordinates for the integer successor: a finite position
-- and an integer counting full turns, including at negative integers.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module Z = Integers[l] ; module F = FiniteCycles[l] ; module II = IntegerIteration[l] ;
module Degree (n : Nat) {
  m : Nat = suc n ; module S = F.Standard[n] ; module R = CycleRoots[l].Root[n,Z.Int,Z.sucZ] ;
  module A = II.Orbit[Z.Int,InfiniteCycle[l].shift] ;
  full : Equiv Z.Int Z.Int = (A.N.power m,A.nat-equiv m) ;
  module M = II.Orbit[Z.Int,full] ; module Residue = II.Orbit[S.A,F.rotation n] ;
  multiple (q : Z.Int) : Z.Int = M.power q Z.zeroZ ;
  rank (i : S.A) : Nat = CyclicHom[l,l].rank m i ;
  decode (w : R.copies) : Z.Int = A.N.power (rank w.1) (multiple w.2) ;
  comm (i : S.A) : U l = (q : Z.Int) -> Id Z.Int (decode (R.root (i,q))) (Z.sucZ (decode (i,q))) ;
  idle (i : Fin n) (q : Z.Int) : Id Z.Int (decode (R.root (F.prefix n i,q))) (Z.sucZ (decode (F.prefix n i,q))) = transH (apH decode (R.idle i q))
    (apH Z.sucZ (apH (\ k -> A.N.power k (multiple q)) (symH (CyclicHom[l,l].prefix-rank n i)))) ;
  tick (q : Z.Int) : Id Z.Int (decode (R.root (F.last n,q))) (Z.sucZ (decode (F.last n,q))) = transH (apH decode (R.tick q)) (transH (M.step q Z.zeroZ)
    (apH Z.sucZ (apH (\ k -> A.N.power k (multiple q)) (symH (CyclicHom[l,l].last-rank n))))) ;
  previous (j : S.A) : S.A = (F.rotation n).2.sec j ;
  shift-law (i j : S.A) (p : Id S.A (S.step i) j) (h : comm i) : comm (previous j) =
    subst S.A comm i _ (transH (symH (sec-ret S.A S.A S.step (F.rotation n).2 i)) (apH previous p)) h ;
  cases : (j : S.A) -> comm (previous j) = split {
    none -> shift-law (F.last n) none (F.wrap n) tick ;
    some i -> shift-law (F.prefix n i) (some i) (F.advance n i) (idle i) } ;
  next (w : R.copies) : Id Z.Int (decode (R.root w)) (Z.sucZ (decode w)) =
    subst S.A comm _ w.1 (sec-ret S.A S.A S.step (F.rotation n).2 w.1) (cases (S.step w.1)) w.2 ;
  root : Equiv R.copies R.copies = (R.root,R.Invertible[InfiniteCycle[l].shift.2].equivalence) ;
  module B = II.Orbit[R.copies,root] ;
  origin : R.copies = (none,Z.zeroZ) ;
  divide (z : Z.Int) : R.copies = B.power z origin ;
  succ-law (z : Z.Int) : Id R.copies (divide (Z.sucZ z)) (R.root (divide z)) = B.step z origin ;
  module Decode = II.Map[R.copies,Z.Int,root,InfiniteCycle[l].shift,decode,next] ;
  identity (z : Z.Int) : Id Z.Int (decode (divide z)) z = transH (Decode.at origin z)
    (symH (A.Unique[Z.zeroZ,\ i -> i,refl Z.zeroZ,\ i -> refl (Z.sucZ i)].at z)) ;
  module Encode = II.Map[Z.Int,R.copies,InfiniteCycle[l].shift,root,divide,succ-law] ;
  block : Equiv R.copies R.copies = (B.N.power m,B.nat-equiv m) ;
  embed (q : Z.Int) : R.copies = (none,q) ;
  module EBlock = II.Map[Z.Int,R.copies,full,block,divide,\ z -> Encode.at z (pos m)] ;
  module Origin = II.Map[Z.Int,R.copies,InfiniteCycle[l].shift,block,embed,\ z -> symH (R.first z)] ;
  zero-column (q : Z.Int) : Id R.copies (divide (multiple q)) (embed q) =
    transH (EBlock.at Z.zeroZ q) (transH (symH (Origin.at Z.zeroZ q))
      (apH embed (symH (A.Unique[Z.zeroZ,\ i -> i,refl Z.zeroZ,\ i -> refl (Z.sucZ i)].at q)))) ;
  column (q : Z.Int) : (i : S.A) -> Id R.copies (divide (decode (i,q))) (i,q) =
    F.interval n (\ i -> Id R.copies (divide (decode (i,q))) (i,q)) (zero-column q)
      (\ i h -> transH (apH divide (apH Z.sucZ (apH (\ k -> A.N.power k (multiple q)) (symH (CyclicHom[l,l].prefix-rank n i)))))
        (transH (succ-law (decode (F.prefix n i,q))) (transH (apH R.root h) (R.idle i q)))) ;
  coordinates : Equiv Z.Int R.copies = (divide,qinv _ _ divide decode (\ w -> column w.2 w.1) identity) ;
  residue (k : Z.Int) : S.A = Residue.power k none ;
  projection (k : Z.Int) : Id S.A (divide k).1 (residue k) =
    II.Map[R.copies,S.A,root,F.rotation n,\ w -> w.1,\ w -> refl (S.step w.1)].at origin k ;
  quotient (k : Z.Int) : Z.Int = (divide k).2 ;
  exact (k : Z.Int) (p : Id S.A (residue k) none) : Id Z.Int (multiple (quotient k)) k =
    transH (apH (\ i -> decode (i,quotient k)) (symH (transH (projection k) p))) (identity k) ;
  divisible (q : Z.Int) : Id S.A (residue (multiple q)) none =
    transH (symH (projection (multiple q))) (ap R.copies S.A (\ w -> w.1) _ _ (zero-column q)) ;
} ;
