-- Change of universe for the chosen circle, including its generator.
level u v ; constraint u <= v ; open Base ; open Prelude[v] ; open Paths[v] ;
module S = ChapterThree[u] ; module L = ChapterThree[v] ;
free (Y : U v) : U v = (y : Y) * Id Y y y ;
module PointedLoop (A : U v) (a : A) (p : Id A a a) {
  eval (Y : U v) (h : A -> Y) : free Y = (h a,ap A Y h a a p) ;
  module Round (B : U v) (b : B) (q : Id B b b) (f : A -> B) (g : B -> A)
    (bf : Id (free B) (eval B f) (b,q)) (bg : Id (free A) (g b,ap B A g b b q) (a,p))
    (unique : isEquiv (A -> A) (free A) (eval A)) {
    push (w : free B) : free A = (g w.1,ap B A g w.1 w.1 w.2) ;
    natural : Id (free A) (eval A (\ x -> g (f x))) (push (eval B f)) = ap (Id A (g (f a)) (g (f a))) (free A)
      (\ r -> (g (f a),r)) _ _ (symH (LoopCalc[v].ap-ap A B A f g a a p)) ;
    identity : Id (free A) (eval A (\ x -> x)) (a,p) =
      ap (Id A a a) (free A) (\ r -> (a,r)) _ _ (Fibres[v].ap-id A a a p) ;
    composite : Id (A -> A) (\ x -> g (f x)) (\ x -> x) = Equivalences[v].injective _ _ (eval A) unique _ _
      (transH natural (transH (apH push bf) (transH bg (symH identity)))) ;
  } ;
} ;
module Up = CircleLarge[u,v].Mapping[L.Circle] ;
module Down = CircleLarge[v,v].Mapping[S.Circle] ;
up : S.Circle -> L.Circle = Up.E-equiv.sec (L.base,L.loop) ;
down : L.Circle -> S.Circle = Down.E-equiv.sec (S.base,S.loop) ;
loop-up : Id (free L.Circle) (Up.E up) (L.base,L.loop) = Up.E-equiv.sec-eq (L.base,L.loop) ;
loop-down : Id (free S.Circle) (Down.E down) (S.base,S.loop) = Down.E-equiv.sec-eq (S.base,S.loop) ;
module Small = PointedLoop[S.Circle,S.base,S.loop].Round[L.Circle,L.base,L.loop,up,down,loop-up,loop-down,
  CircleLarge[u,v].Mapping[S.Circle].E-equiv] ;
module Large = PointedLoop[L.Circle,L.base,L.loop].Round[S.Circle,S.base,S.loop,down,up,loop-down,loop-up,
  CircleLarge[v,v].Mapping[L.Circle].E-equiv] ;
comparison : Equiv S.Circle L.Circle = (up,qinv _ _ up down
  (happly L.Circle (\ z -> L.Circle) _ _ Large.composite) (happly S.Circle (\ z -> S.Circle) _ _ Small.composite)) ;
