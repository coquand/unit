-- Section 6.6. A functor out of a univalent category has at most one right adjoint.
level a b c d ; open Base ; open Prelude[a \/ b \/ c \/ d] ; open Paths[a \/ b \/ c \/ d] ;
module L = Axioms[a \/ b \/ c \/ d].FunExtLemmas[fe @(a \/ b \/ c \/ d)] ;
module H = Prelude[b \/ d] ; module V = WildCategory[a,b] ; module G = WildFunctors[c,d,a,b] ;
module ForPrecategory (C0 : Category[a,b].Precategory) (D : WildCategory[c,d].Wild) (F : WildFunctors[a,b,c,d].Map[V.forget C0,D]) {
  C : V.Wild = V.forget C0 ;
  module At (y : D.ob) {
    arrows (x : C.ob) : U d = D.hom (F.obj x) y ;
    maps (z : C.ob) : U (a \/ b \/ d) = (x : C.ob) -> H.Equiv (arrows x) (C.hom x z) ;
    module Laws (z : C.ob) (m : maps z) {
      eq (x w : C.ob) (h : C.hom w x) (f : arrows x) : U b =
        Id (C.hom w z) ((m w).1 (D.comp _ _ _ f (F.map _ _ h))) (C.comp _ _ _ ((m x).1 f) h) ;
      law : U (a \/ b \/ d) = (x w : C.ob) (h : C.hom w x) (f : arrows x) -> eq x w h f ;
      prop : isProp law = L.isProp-Pi C.ob (\ x -> (w : C.ob) (h : C.hom w x) (f : arrows x) -> eq x w h f)
        (\ x -> L.isProp-Pi C.ob (\ w -> (h : C.hom w x) (f : arrows x) -> eq x w h f)
        (\ w -> L.isProp-Pi (C.hom w x) (\ h -> (f : arrows x) -> eq x w h f)
        (\ h -> L.isProp-Pi (arrows x) (\ f -> eq x w h f) (\ f -> C0.hom-set _ _ _ _)))) ;
    } ;
    rep : U (a \/ b \/ d) = (z : C.ob) * (m : maps z) * Laws[z,m].law ;
    module With (r : rep) {
      m : maps r.1 = r.2.1 ; eps : arrows r.1 = (m r.1).2.sec (C.idn r.1) ;
      beta : Id (C.hom r.1 r.1) ((m r.1).1 eps) (C.idn r.1) = (m r.1).2.sec-eq (C.idn r.1) ;
      recover (x : C.ob) (v : arrows x) : Id (arrows x) (D.comp _ _ _ eps (F.map _ _ ((m x).1 v))) v =
        transH (symH (H.sec-ret _ _ _ (m x).2 (D.comp _ _ _ eps (F.map _ _ ((m x).1 v))))) (transH (apH (m x).2.sec (transH (r.2.2 _ _ ((m x).1 v) eps)
          (transH (apH (\ k -> C.comp _ _ _ k ((m x).1 v)) beta) (C.unit-l _ _ _)))) (H.sec-ret _ _ _ (m x).2 v)) ;
    } ;
    k (r s : rep) : C.hom r.1 s.1 = (s.2.1 r.1).1 With[r].eps ;
    spec (r s : rep) (x : C.ob) (v : arrows x) : Id (C.hom x s.1) ((s.2.1 x).1 v) (C.comp _ _ _ (k r s) ((r.2.1 x).1 v)) =
      transH (apH (s.2.1 x).1 (symH (With[r].recover x v))) (s.2.2 _ _ ((r.2.1 x).1 v) With[r].eps) ;
    inverse (r s : rep) : Id (C.hom r.1 r.1) (C.comp _ _ _ (k s r) (k r s)) (C.idn r.1) =
      transH (symH (spec s r r.1 With[r].eps)) With[r].beta ;
    iso (r s : rep) : C0.Iso r.1 s.1 = (k r s,k s r,inverse r s,inverse s r) ;
    module Lift (r : rep) {
      at-base (m : maps r.1) (n : Laws[r.1,m].law) (e : (x : C.ob) (f : arrows x) ->
        Id (C.hom x r.1) ((m x).1 f) (C.comp _ _ _ (C.idn r.1) ((r.2.1 x).1 f))) : Id rep r (r.1,m,n) =
        ap ((v : maps r.1) * Laws[r.1,v].law) rep (\ t -> (r.1,t)) _ _
          (Sigma-eq (maps r.1) (\ v -> Laws[r.1,v].law) _ _ _ _
            (L.funext C.ob (\ x -> H.Equiv (arrows x) (C.hom x r.1)) r.2.1 m (\ x ->
              Sigma-eq (arrows x -> C.hom x r.1) (\ u -> H.isEquiv (arrows x) (C.hom x r.1) u) _ _ _ _
                (L.funext (arrows x) (\ f -> C.hom x r.1) _ _ (\ f -> symH (transH (e x f) (C.unit-l _ _ _))))
                (EquivProp[b \/ d].isEquiv-prop _ _ (m x).1))) Laws[r.1,m].prop) ;
      along (z : C.ob) (p : Id C.ob r.1 z) : (m : maps z) (n : Laws[z,m].law)
        (e : (x : C.ob) (f : arrows x) -> Id (C.hom x z) ((m x).1 f) (C.comp _ _ _ (C0.idtoiso r.1 z p).1 ((r.2.1 x).1 f))) -> Id rep r (z,m,n) =
        idJ C.ob r.1 (\ w q -> (m : maps w) (n : Laws[w,m].law)
          (e : (x : C.ob) (f : arrows x) -> Id (C.hom x w) ((m x).1 f) (C.comp _ _ _ (C0.idtoiso r.1 w q).1 ((r.2.1 x).1 f))) -> Id rep r (w,m,n)) at-base z p ;
    } ;
    prop (ua : Category[a,b].Univalent C0) : isProp rep = \ r s -> Lift[r].along s.1 ((ua r.1 s.1).sec (iso r s)) s.2.1 s.2.2 (\ x v ->
      transH (spec r s x v) (ap (C0.Iso r.1 s.1) (C.hom x s.1) (\ i -> C.comp _ _ _ i.1 ((r.2.1 x).1 v)) (iso r s) (C0.idtoiso r.1 s.1 ((ua r.1 s.1).sec (iso r s))) (symH ((ua r.1 s.1).sec-eq (iso r s))))) ;
  } ;
  reps : U (a \/ b \/ c \/ d) = (y : D.ob) -> At[y].rep ;
  module Given (t : reps) {
    module A = AdjointRepresentation[a,b,c,d].Build[C,D,F,(\ y -> (t y).1),(\ x y -> (t y).2.1 x),(\ x w y -> (t y).2.2 x w)] ;
    module R = A.Unique[C0.hom-set] ;
  } ;
  data-type : U (a \/ b \/ c \/ d) = (t : reps) * Given[t].R.choices ;
  prop (ua : Category[a,b].Univalent C0) : isProp data-type = isProp-Sigma reps (\ t -> Given[t].R.choices)
    (L.isProp-Pi D.ob (\ y -> At[y].rep) (\ y -> At[y].prop ua)) (\ t -> FunExtUA[a \/ b \/ c \/ d].pathC _ Given[t].R.compatible-adjoints) ;
  right : U (a \/ b \/ c \/ d) = (g : G.Map[D,C]) * Adjunctions[a,b,c,d].Wild[C,D,F,g].Adjunction ;
  pack (j : right) : data-type = ((\ y -> (j.1.obj y,(\ x -> j.2.transpose x y),\ x w -> j.2.pre x w y)),
    j.1.map,(j.1.map-idn,j.1.map-comp),j.2.post) ;
  module Unpack (w : data-type) {
    g : G.Map[D,C] = new G.Map[D,C,(\ y -> (w.1 y).1),w.2.1,w.2.2.1.1,w.2.2.1.2] ;
    module M = Adjunctions[a,b,c,d].Wild[C,D,F,g] ;
    j : right = (g,new M.Adjunction[(\ x y -> (w.1 y).2.1 x),(\ x z y -> (w.1 y).2.2 x z),w.2.2.2]) ;
  } ;
  unpack (w : data-type) : right = Unpack[w].j ;
  eta : (g : G.Map[D,C]) (j : Adjunctions[a,b,c,d].Wild[C,D,F,g].Adjunction) -> Id right (unpack (pack (g,j))) (g,j) =
    split { Map o m i k -> split { Adjunction e p q -> refl (new G.Map[D,C,o,m,i,k],new Adjunctions[a,b,c,d].Wild[C,D,F,new G.Map[D,C,o,m,i,k]].Adjunction[e,p,q]) } } ;
  -- Forget the pre-naturality proof as well. Its fibre remains contractible
  -- over any prescribed object action and hom equivalences admitting that law.
  raw : U (a \/ b \/ c \/ d) = (y : D.ob) -> (z : C.ob) * At[y].maps z ;
  natural (t : raw) : U (a \/ b \/ c \/ d) = (y : D.ob) -> At[y].Laws[(t y).1,(t y).2].law ;
  natural-prop (t : raw) : isProp (natural t) = L.isProp-Pi D.ob (\ y -> At[y].Laws[(t y).1,(t y).2].law)
    (\ y -> At[y].Laws[(t y).1,(t y).2].prop) ;
  representations : U (a \/ b \/ c \/ d) = (t : raw) * natural t ;
  present (j : right) : raw = \ y -> (j.1.obj y,\ x -> j.2.transpose x y) ;
  restrict (j : right) : representations = (present j,\ y x w -> j.2.pre x w y) ;
  regroup (v : representations) : reps = \ y -> ((v.1 y).1,(v.1 y).2,v.2 y) ;
  extend (v : representations) : right = unpack (regroup v,Given[regroup v].R.center) ;
  rebuild (j : right) : Id right (extend (restrict j)) j = transH
    (apH (\ k -> unpack ((pack j).1,k)) (Given[(pack j).1].R.contract (pack j).2)) (eta j.1 j.2) ;
  equiv : Equiv right representations = (restrict,qinv _ _ restrict extend (\ v -> refl v) rebuild) ;
  module Compatible (v : representations) {
    fiber : U (a \/ b \/ c \/ d) = (j : right) * Id raw (present j) v.1 ;
    full : U (a \/ b \/ c \/ d) = (j : right) * Id representations (restrict j) v ;
    module Sub = FullSubcategory[a \/ b \/ c \/ d,a \/ b \/ c \/ d,a \/ b \/ c \/ d].On[PathGroupoid[a \/ b \/ c \/ d].Of[raw].paths,natural,natural-prop] ;
    include (s : fiber) : full = (s.1,Sub.At[restrict s.1].lift v.1 s.2 v.2) ;
    forget (s : full) : fiber = (s.1,apH (\ t -> t.1) s.2) ;
    ret (s : fiber) : Id fiber (forget (include s)) s =
      ap (Id raw (present s.1) v.1) fiber (\ p -> (s.1,p)) _ _
        (Sub.At[restrict s.1].sec v.1 s.2 v.2) ;
    module U0 = FunExtUA[a \/ b \/ c \/ d] ;
    all : U0.isContr full = WildIsos[a \/ b \/ c \/ d,a \/ b \/ c \/ d].contract _ _ equiv v ;
    contractible : U0.isContr fiber = (forget all.1,\ s -> transH (apH forget (all.2 (include s))) (ret s)) ;
  } ;
  unique (ua : Category[a,b].Univalent C0) : isProp right = retract-prop right data-type pack unpack (\ j -> eta j.1 j.2) (prop ua) ;
} ;
module On (K : Category[a,b].Category) (D : WildCategory[c,d].Wild) (F : WildFunctors[a,b,c,d].Map[V.forget K.pre,D]) {
  module U0 = ForPrecategory[K.pre,D,F] ;
  right : U (a \/ b \/ c \/ d) = U0.right ;
  unique : isProp right = U0.unique K.univalent ;
} ;
