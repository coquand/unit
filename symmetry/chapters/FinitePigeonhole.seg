-- Section 2.23. Return the two indices of a collision.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ; open Logic[l] ;
module C = Cardinality[l] ; module D = FiniteDecisions[l] ;
collision (A B : U l) (f : A -> B) : U l = (x : A) * (y : A) * (Id A x y -> Empty) * Id B (f x) (f y) ;
unbox (A : U l) (a : A) : Opt A -> A = split { none -> a ; some i -> i } ;
module Remove (n : Nat) (f : Fin (suc (suc n)) -> Fin (suc n)) {
  A : U l = Fin (suc n) ; B : U l = Fin (suc (suc n)) ;
  hit (i : A) : U l = Id A (f (some i)) (f none) ;
  found (z : (i : A) * hit i) : collision B A f = (some z.1,none,C.Option[A].apart z.1,z.2) ;
  module Miss (h : ((i : A) * hit i) -> Empty) {
    module P = C.Puncture[n,f none] ;
    puncture (i : A) : C.delete A (f none) = (f (some i),\ p -> h (i,p)) ;
    small (i : A) : Fin n = P.equiv.2.sec (puncture i) ;
    lift (w : collision A (Fin n) small) : collision B A f = (some w.1,some w.2.1,
      \ p -> w.2.2.1 (ap B A (unbox A w.1) _ _ p),
      ap (C.delete A (f none)) A (\ z -> z.1) _ _ (transH (symH (P.equiv.2.sec-eq (puncture w.1)))
        (transH (apH P.equiv.1 w.2.2.2) (P.equiv.2.sec-eq (puncture w.2.1))))) ;
  } ;
  step (r : (g : A -> Fin n) -> collision A (Fin n) g) : Dec ((i : A) * hit i) -> collision B A f = split {
    yes z -> found z ; no h -> Miss[h].lift (r Miss[h].small) } ;
} ;
pigeonhole : (n : Nat) (f : Fin (suc n) -> Fin n) -> collision (Fin (suc n)) (Fin n) f = split {
  zero -> \ f -> absurd _ (f none) ;
  suc n | r -> \ f -> Remove[n,f].step r (D.search (suc n) Remove[n,f].hit
    (\ i -> D.standard (suc n) (f (some i)) (f none))) } ;
