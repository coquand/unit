-- Sections 2.9–2.12. Universal properties of sums, products and sections.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Unit (X : U l) {
  evaluate : Equiv (Top -> X) X = ((\ f -> f tt),qinv _ _ (\ f -> f tt) (\ x t -> x) (\ x -> refl x)
    (\ f -> FL.funext Top (\ t -> X) _ f (\ t -> apH f (isTop tt t)))) ;
  drop : Equiv (X * Top) X = ((\ w -> w.1),qinv _ _ (\ w -> w.1) (\ x -> (x,tt)) (\ x -> refl x)
    (\ w -> ap Top (X * Top) (\ t -> (w.1,t)) tt w.2 (isTop tt w.2))) ;
} ;
module ContractAway (X : U l) (a : X) (P : (x : X) -> Id X a x -> U l) {
  total : U l = (x : X) * (p : Id X a x) * P x p ;
  include (z : P a (refl a)) : total = (a,refl a,z) ;
  value (x : X) (p : Id X a x) : P x p -> P a (refl a) =
    idJ X a (\ y q -> P y q -> P a (refl a)) (\ z -> z) x p ;
  eta (x : X) (p : Id X a x) : (z : P x p) -> Id total (include (value x p z)) (x,p,z) =
    idJ X a (\ y q -> (z : P y q) -> Id total (include (value y q z)) (y,q,z)) (\ z -> refl (include z)) x p ;
  sum : Equiv total (P a (refl a)) = ((\ w -> value w.1 w.2.1 w.2.2),qinv _ _ (\ w -> value w.1 w.2.1 w.2.2) include
    (\ z -> refl z) (\ w -> eta w.1 w.2.1 w.2.2)) ;
  sections : U l = (x : X) (p : Id X a x) -> P x p ;
  build (z : P a (refl a)) (x : X) (p : Id X a x) : P x p = idJ X a P z x p ;
  agrees (f : sections) (x : X) (p : Id X a x) : Id (P x p) (build (f a (refl a)) x p) (f x p) =
    idJ X a (\ y q -> Id (P y q) (build (f a (refl a)) y q) (f y q)) (refl (f a (refl a))) x p ;
  product : Equiv sections (P a (refl a)) = ((\ f -> f a (refl a)),qinv _ _ (\ f -> f a (refl a)) build (\ z -> refl z)
    (\ f -> FL.funext X (\ x -> (p : Id X a x) -> P x p) _ f (\ x -> FL.funext (Id X a x) (P x) _ (f x) (agrees f x)))) ;
} ;
module Sums (X Y : U l) (P : X -> Y -> U l) {
  left : U l = (x : X) * (y : Y) * P x y ; right : U l = (y : Y) * (x : X) * P x y ;
  swap : Equiv left right = ((\ w -> (w.2.1,w.1,w.2.2)),qinv _ _ (\ w -> (w.2.1,w.1,w.2.2))
    (\ w -> (w.2.1,w.1,w.2.2)) (\ w -> refl w) (\ w -> refl w)) ;
  choose : Equiv ((x : X) -> (y : Y) * P x y) ((f : X -> Y) * ((x : X) -> P x (f x))) =
    ((\ h -> ((\ x -> (h x).1),\ x -> (h x).2)),qinv _ _ (\ h -> ((\ x -> (h x).1),\ x -> (h x).2))
      (\ t x -> (t.1 x,t.2 x)) (\ w -> refl w) (\ h -> refl h)) ;
} ;
module Sections (X Z : U l) (Y : X -> U l) (f : Z -> X) {
  maps : U l = Z -> (x : X) * Y x ;
  total : U l = (g : maps) * Id (Z -> X) f (\ z -> (g z).1) ;
  family (h : Z -> X) : U l = (z : Z) -> Y (h z) ;
  sections : U l = family f ;
  module K = ContractAway[Z -> X,f,\ h p -> family h] ;
  expand : Equiv total K.total = ((\ w -> ((\ z -> (w.1 z).1),w.2,\ z -> (w.1 z).2)),
    qinv _ _ (\ w -> ((\ z -> (w.1 z).1),w.2,\ z -> (w.1 z).2)) (\ w -> ((\ z -> (w.1 z,w.2.2 z)),w.2.1))
      (\ w -> refl w) (\ w -> refl w)) ;
  equivalence : Equiv total sections = Equivalences[l].compose _ _ _ expand K.sum ;
} ;
module Binary (P : Bool -> U l) {
  sections : U l = (b : Bool) -> P b ;
  build (x : P false) (y : P true) : sections = split { false -> x ; true -> y } ;
  computes (f : sections) : (b : Bool) -> Id (P b) (build (f false) (f true) b) (f b) =
    split { false -> refl (f false) ; true -> refl (f true) } ;
  product : Equiv sections (P false * P true) = ((\ f -> (f false,f true)),qinv _ _ (\ f -> (f false,f true))
    (\ w -> build w.1 w.2) (\ w -> refl w) (\ f -> FL.funext Bool P _ f (computes f))) ;
} ;
module Either (X Y : U l) {
  open FiniteArithmetic[l] ;
  P : Bool -> U l = split { false -> X ; true -> Y } ;
  total : U l = (b : Bool) * P b ;
  put : Sum X Y -> total = split { left x -> (false,x) ; right y -> (true,y) } ;
  get : (b : Bool) -> P b -> Sum X Y = split { false -> \ x -> left x ; true -> \ y -> right y } ;
  eta : (w : Sum X Y) -> Id (Sum X Y) (get (put w).1 (put w).2) w =
    split { left x -> refl (left x) ; right y -> refl (right y) } ;
  beta : (b : Bool) (z : P b) -> Id total (put (get b z)) (b,z) =
    split { false -> \ x -> refl (false,x) ; true -> \ y -> refl (true,y) } ;
  sum : Equiv (Sum X Y) total = (put,qinv _ _ put (\ w -> get w.1 w.2) (\ w -> beta w.1 w.2) eta) ;
  module Maps (Z : U l) {
    out (a : X -> Z) (b : Y -> Z) : Sum X Y -> Z = split { left x -> a x ; right y -> b y } ;
    restrict (f : Sum X Y -> Z) : (X -> Z) * (Y -> Z) = ((\ x -> f (left x)),\ y -> f (right y)) ;
    at (f : Sum X Y -> Z) : (w : Sum X Y) -> Id Z (out (restrict f).1 (restrict f).2 w) (f w) =
      split { left x -> refl (f (left x)) ; right y -> refl (f (right y)) } ;
    equivalence : Equiv (Sum X Y -> Z) ((X -> Z) * (Y -> Z)) = (restrict,qinv _ _ restrict (\ w -> out w.1 w.2)
      (\ w -> refl w) (\ f -> FL.funext (Sum X Y) (\ w -> Z) _ f (at f))) ;
  } ;
} ;
product-swap (X Y : U l) : Equiv (X * Y) (Y * X) = ((\ w -> (w.2,w.1)),qinv _ _ (\ w -> (w.2,w.1))
  (\ w -> (w.2,w.1)) (\ w -> refl w) (\ w -> refl w)) ;
distribute (X Y : U l) (Z : Y -> U l) : Equiv (X * ((y : Y) * Z y)) ((y : Y) * X * Z y) =
  ((\ w -> (w.2.1,w.1,w.2.2)),qinv _ _ (\ w -> (w.2.1,w.1,w.2.2))
    (\ w -> (w.2.1,w.1,w.2.2)) (\ w -> refl w) (\ w -> refl w)) ;
curry (X Z : U l) (Y : X -> U l) : Equiv (((x : X) * Y x) -> Z) ((x : X) -> Y x -> Z) =
  ((\ f x y -> f (x,y)),qinv _ _ (\ f x y -> f (x,y)) (\ g w -> g w.1 w.2) (\ g -> refl g) (\ f -> refl f)) ;
module Composite (X Y Z : U l) (f : X -> Y) (g : Y -> Z) (z : Z) {
  source : U l = (x : X) * Id Z (g (f x)) z ;
  target : U l = (v : (y : Y) * Id Z (g y) z) * (x : X) * Id Y (f x) v.1 ;
  put (w : source) : target = ((f w.1,w.2),w.1,refl (f w.1)) ;
  get (w : target) : source = (w.2.1,transH (apH g w.2.2) w.1.2) ;
  beta (x : X) (y : Y) (p : Id Y (f x) y) : (q : Id Z (g y) z) -> Id target (put (get ((y,q),x,p))) ((y,q),x,p) =
    idJ Y (f x) (\ t h -> (q : Id Z (g t) z) -> Id target (put (get ((t,q),x,h))) ((t,q),x,h))
      (\ q -> ap (Id Z (g (f x)) z) target (\ r -> ((f x,r),x,refl (f x))) _ _ (trans-refl-l Z _ z q)) y p ;
  equivalence : Equiv source target = (put,qinv _ _ put get (\ w -> beta w.2.1 w.1.1 w.2.2 w.1.2)
    (\ w -> ap (Id Z (g (f w.1)) z) source (\ r -> (w.1,r)) _ _ (trans-refl-l Z _ z w.2))) ;
} ;
module Lift (X Z : U l) (Y : X -> U l) (p : (x : X) -> isProp (Y x)) (f : Z -> X) {
  module S = Sections[X,Z,Y,f] ;
  unique : isProp S.total = retract-prop S.total S.sections S.equivalence.1 S.equivalence.2.sec
    (sec-ret _ _ S.equivalence.1 S.equivalence.2) (FL.isProp-Pi Z (\ z -> Y (f z)) (\ z -> p (f z))) ;
  exists (h : S.sections) : FunExtUA[l].isContr S.total = (S.equivalence.2.sec h,unique _) ;
  holds (c : FunExtUA[l].isContr S.total) : S.sections = S.equivalence.1 c.1 ;
} ;
module SumPaths (X Y : U l) {
  open FiniteArithmetic[l] ;
  S : U l = Sum X Y ;
  code : S -> S -> U l = split {
    left x -> split { left u -> Id X x u ; right v -> Empty } ;
    right y -> split { left u -> Empty ; right v -> Id Y y v } } ;
  base : (s : S) -> code s s = split { left x -> refl x ; right y -> refl y } ;
  decode : (s t : S) -> code s t -> Id S s t = split {
    left x -> split { left u -> ap X S (\ a -> left a) x u ; right v -> absurd _ } ;
    right y -> split { left u -> absurd _ ; right v -> ap Y S (\ b -> right b) y v } } ;
  encode (s t : S) (p : Id S s t) : code s t = subst S (code s) s t p (base s) ;
  round : (s t : S) (c : code s t) -> Id (code s t) (encode s t (decode s t c)) c = split {
    left x -> split { left u -> \ c -> idJ X x (\ v q -> Id (Id X x v) (encode (left x) (left v) (decode (left x) (left v) q)) q)
      (refl (refl x)) u c ; right y -> \ c -> absurd _ c } ;
    right y -> split { left x -> \ c -> absurd _ c ; right v -> \ c -> idJ Y y
      (\ w q -> Id (Id Y y w) (encode (right y) (right w) (decode (right y) (right w) q)) q) (refl (refl y)) v c } } ;
  at-refl : (s : S) -> Id (Id S s s) (decode s s (base s)) (refl s) = split { left x -> refl (refl (left x)) ; right y -> refl (refl (right y)) } ;
  paths (s t : S) : Equiv (Id S s t) (code s t) = (encode s t,qinv _ _ (encode s t) (decode s t) (round s t)
    (\ p -> idJ S s (\ w q -> Id (Id S s w) (decode s w (encode s w q)) q) (at-refl s) t p)) ;
  code-prop (sx : isSet X) (sy : isSet Y) : (s t : S) -> isProp (code s t) = split {
    left x -> split { left u -> sx x u ; right v -> isProp-Empty } ;
    right y -> split { left u -> isProp-Empty ; right v -> sy y v } } ;
  set (sx : isSet X) (sy : isSet Y) (s t : S) : isProp (Id S s t) = retract-prop _ _ (encode s t) (decode s t)
    (\ p -> idJ S s (\ w q -> Id (Id S s w) (decode s w (encode s w q)) q) (at-refl s) t p) (code-prop sx sy s t) ;
} ;
module RightEmpty (X : U l) {
  open FiniteArithmetic[l] ;
  drop : Sum X Empty -> X = split { left x -> x ; right y -> absurd X y } ;
  eta : (w : Sum X Empty) -> Id (Sum X Empty) (left (drop w)) w = split { left x -> refl (left x) ; right y -> absurd _ y } ;
  equivalence : Equiv (Sum X Empty) X = (drop,qinv _ _ drop (\ x -> left x) (\ x -> refl x) eta) ;
} ;
module Wrapped (X : U l) {
  data Copy : U l = wrap (x : X) ;
  unwrap : Copy -> X = split { wrap x -> x } ;
  eta : (z : Copy) -> Id Copy (wrap (unwrap z)) z = split { wrap x -> refl (wrap x) } ;
  equivalence : Equiv Copy X = (unwrap,qinv _ _ unwrap (\ x -> wrap x) (\ x -> refl x) eta) ;
  set (s : isSet X) : isSet Copy = HLevels[l].trunc-set Copy (HLevels[l].equiv-trunc (suc (suc zero)) Copy X equivalence (HLevels[l].set-trunc X s)) ;
} ;
module PairPaths (X Y : U l) (a : X) (b : Y) (c : X) (d : Y) {
  P : X -> U l = \ x -> Y ;
  fibre (p : Id X a c) : Equiv (Id Y (subst X P a c p b) d) (Id Y b d) =
    Fibres[l].trans-equiv Y b (subst X P a c p b) d (symH (PathTransport[l].Ordinary[X,a].constant Y b c p)) ;
  equivalence : Equiv (Id (X * Y) (a,b) (c,d)) (Id X a c * Id Y b d) = Equivalences[l].compose _ _ _
    (ConnectedMaps[l].sigma-paths X P (a,b) (c,d))
    (Fibres[l].sigma-equiv (Id X a c) (\ p -> Id Y (subst X P a c p b) d) (\ p -> Id Y b d) fibre) ;
} ;
