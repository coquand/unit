-- Section 6.7. The universe of small univalent categories is a 2-type.
level l ; open Base ; open Prelude[l] ;
module K = Category[l,l] ; module W = WildCategory[l,l] ; module H = HLevels[l] ; module BH = HLevels[l+] ;
two : Nat = suc (suc zero) ; three : Nat = suc two ;
equivs (A B : U l) (gr : H.isTrunc three B) : H.isTrunc three (Equiv A B) =
  H.trunc-Sigma three (A -> B) (isEquiv A B) (H.trunc-Pi three A (\ a -> B) (\ a -> gr))
    (\ f -> H.prop-trunc two _ (EquivProp[l].isEquiv-prop A B f)) ;
module Pair (C D : K.Category) {
  module I = CategoryIdentity[l,l].UnivalentFrom[C] ; module J = I.I ;
  module Ex = WildFunctors[l,l,l,l].Ext[W.forget C.pre,W.forget D.pre,D.pre.hom-set] ;
  base : U l = Equiv C.pre.ob D.pre.ob ;
  obj : H.isTrunc three base = equivs C.pre.ob D.pre.ob (\ x y -> H.set-trunc _ (K.Objects[D].one-type x y)) ;
  module Over (f : base) {
    hom (x y : C.pre.ob) : U l = Equiv (C.pre.hom x y) (D.pre.hom (f.1 x) (f.1 y)) ;
    maps : U l = (x y : C.pre.ob) -> hom x y ;
    arrows : H.isTrunc three maps = H.trunc-Pi three C.pre.ob (\ x -> (y : C.pre.ob) -> hom x y)
      (\ x -> H.trunc-Pi three C.pre.ob (hom x) (\ y -> equivs (C.pre.hom x y) (D.pre.hom (f.1 x) (f.1 y))
        (\ g k -> H.prop-trunc (suc zero) _ (D.pre.hom-set _ _ g k)))) ;
    module At (e : maps) {
      module Laws = J.Laws[D.pre,f,e] ;
      module Ext = Ex.At[f.1].On[\ x y -> (e x y).1] ;
      swap (p : Ext.comp-law) : Laws.comp = \ x y z k g -> p x y z g k ;
      comp-prop : isProp Laws.comp = \ u v -> Paths[l].apH swap (Ext.comp-prop (\ x y z g k -> u x y z k g) (\ x y z g k -> v x y z k g)) ;
      prop : isProp Laws.all = isProp-Sigma Laws.idn (\ t -> Laws.comp) Ext.id-prop (\ t -> comp-prop) ;
    } ;
    rest : H.isTrunc three ((e : maps) * J.Laws[D.pre,f,e].all) =
      H.trunc-Sigma three maps (\ e -> J.Laws[D.pre,f,e].all) arrows (\ e -> H.prop-trunc two _ At[e].prop) ;
  } ;
  strict : H.isTrunc three (I.iso D) = H.trunc-Sigma three base (\ f -> (e : Over[f].maps) * J.Laws[D.pre,f,e].all) obj (\ f -> Over[f].rest) ;
  paths : BH.isTrunc three (Id K.Category C D) = BH.equiv-trunc three _ _ (I.equality D) strict ;
} ;
category-2-type : BH.isTrunc (suc three) K.Category = \ C D -> Pair[C,D].paths ;
