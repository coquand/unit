-- Section 7.4. Recover the original multiplication, including the opposite
-- order introduced by using left torsors and the book's path composition.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ;
module BP = Paths[l+] ;
module BE = Equivalences[l+] ;
module GP = Groupoid[l+] ;
module LC = LoopConj[l+] ;
module Recover (G : Group[l].Grp) {
  module C = TorsorDelooping[l].Classify[G] ;
  module T = C.T ;
  module A = ChapterFour[l].Symmetries[C.concrete] ;
  module F = C.PathsOf[T.triv].FT ;
  torloop : U l+ = Id T.Tor T.triv T.triv ;
  value (p : torloop) : G.G = (T.idtohom T.triv T.triv p).1 G.e ;
  compose-at (X Y : T.Tor) (p : Id T.Tor X Y) (x : X.1) (Z : T.Tor) (q : Id T.Tor Y Z) :
    Id Z.1 ((T.idtohom X Z (Big.trans T.Tor X Y Z p q)).1 x)
           ((T.idtohom Y Z q).1 ((T.idtohom X Y p).1 x)) =
    idJ T.Tor Y (\ V r -> Id V.1 ((T.idtohom X V (Big.trans T.Tor X Y V p r)).1 x)
      ((T.idtohom Y V r).1 ((T.idtohom X Y p).1 x))) (refl ((T.idtohom X Y p).1 x)) Z q ;
  value-mul (p q : torloop) : Id G.G (value (Big.trans T.Tor T.triv T.triv T.triv p q)) (G.mul (value p) (value q)) =
    transH (compose-at T.triv T.triv p G.e T.triv q)
      (transH (apH (T.idtohom T.triv T.triv q).1 (symH (G.unitr (value p))))
        ((T.idtohom T.triv T.triv q).2 (value p) G.e)) ;
  idtohom-tr (Y : T.Tor) (p : Id T.Tor T.triv Y) : Id (T.Hom T.triv Y) (T.idtohom T.triv Y p) (F.tr Y p) =
    idJ T.Tor T.triv (\ Z q -> Id (T.Hom T.triv Z) (T.idtohom T.triv Z q) (F.tr Z q)) (refl (T.idhom T.triv)) Y p ;
  value-equiv : Big.Equiv torloop G.G = BE.compose torloop (T.Hom T.triv T.triv) G.G
    (T.idtohom T.triv T.triv,BE.homotopy torloop (T.Hom T.triv T.triv) (F.tr T.triv,F.equiv T.triv)
      (T.idtohom T.triv T.triv) (idtohom-tr T.triv))
    (C.TrivialSymmetries.evaluate,Big.qinv _ _ C.TrivialSymmetries.evaluate C.TrivialSymmetries.translate
      C.TrivialSymmetries.beta C.TrivialSymmetries.eta) ;
  path : Id T.Tor (C.torsor C.pt) T.triv = C.C.path-at-point ;
  at : U l+ = Id T.Tor (C.torsor C.pt) (C.torsor C.pt) ;
  based : Big.Equiv A.carrier torloop = BE.compose A.carrier at torloop
    (C.At[C.pt,C.pt].encode,C.C.image.embedding C.pt C.pt)
    (LC.conj T.Tor (C.torsor C.pt) T.triv path,Big.qinv at torloop
      (LC.conj T.Tor (C.torsor C.pt) T.triv path)
      (LC.conj T.Tor T.triv (C.torsor C.pt) (Big.sym T.Tor _ _ path))
      (LC.conj-sym-back T.Tor (C.torsor C.pt) T.triv path)
      (LC.conj-back T.Tor (C.torsor C.pt) T.triv path)) ;
  reversed : Big.Equiv torloop torloop = (Big.sym T.Tor T.triv T.triv,Big.qinv _ _
    (Big.sym T.Tor T.triv T.triv) (Big.sym T.Tor T.triv T.triv) (GP.sym-sym T.Tor T.triv T.triv) (GP.sym-sym T.Tor T.triv T.triv)) ;
  iso : Equiv A.carrier G.G = Truncations[l].lower _ _
    (BE.compose A.carrier torloop G.G based (BE.compose torloop torloop G.G reversed value-equiv)) ;
  based-mul (p q : A.carrier) : Id torloop (based.1 (A.abstract.mul p q)) (Big.trans T.Tor T.triv T.triv T.triv (based.1 q) (based.1 p)) =
    BP.transH (BP.apH (LC.conj T.Tor (C.torsor C.pt) T.triv path)
      (GP.ap-trans C.BG T.Tor C.torsor C.pt C.pt C.pt q p))
      (LC.conj-mult T.Tor (C.torsor C.pt) T.triv path (C.At[C.pt,C.pt].encode q) (C.At[C.pt,C.pt].encode p)) ;
  preserves (p q : A.carrier) : Id G.G (iso.1 (A.abstract.mul p q)) (G.mul (iso.1 p) (iso.1 q)) =
    transH (BP.apH (\ r -> value (Big.sym T.Tor T.triv T.triv r)) (based-mul p q))
      (transH (BP.apH value (GP.sym-trans T.Tor T.triv T.triv T.triv (based.1 q) (based.1 p)))
        (value-mul (reversed.1 (based.1 p)) (reversed.1 (based.1 q)))) ;
} ;
