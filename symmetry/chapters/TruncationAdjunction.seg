-- Section 6.5. The reflection into truncated types in the replacement segment.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module H = HLevels[l] ; module TC = CategoryOfTypes[l] ; module W = WildCategory[l+,l] ; module F = WildFunctors[l+,l,l+,l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Reflect (n : Nat) (op : Truncations[l].TruncOp[n]) {
  module Sub = FullSubcategory[l+,l,l].On[TC.types,H.isTrunc n,H.trunc-prop n] ;
  object (X : U l) : Sub.ob = (op.T X,op.trunc X) ;
  module Into (X : U l) (Y : Sub.ob) {
    module E = ConnectedMaps[l].Elim[n,X,op.T X,op.unit X,op.conn X,\ w -> Y.1,\ w -> Y.2] ;
    equiv : Equiv (op.T X -> Y.1) (X -> Y.1) = (E.precomp,E.equiv) ;
  } ;
  map (X Y : U l) (f : X -> Y) : op.T X -> op.T Y = Into[X,object Y].E.ext (\ x -> op.unit Y (f x)) ;
  beta (X Y : U l) (f : X -> Y) (x : X) : Id (op.T Y) (map X Y f (op.unit X x)) (op.unit Y (f x)) =
    Into[X,object Y].E.ext-beta (\ z -> op.unit Y (f z)) x ;
  identity (X : U l) : Id (op.T X -> op.T X) (map X X (\ x -> x)) (\ x -> x) =
    Into[X,object X].E.unique _ _ (beta X X (\ x -> x)) ;
  comp (X Y Z : U l) (g : Y -> Z) (f : X -> Y) : Id (op.T X -> op.T Z) (map X Z (\ x -> g (f x))) (\ t -> map Y Z g (map X Y f t)) =
    Into[X,object Z].E.unique _ _ (\ x -> transH (beta X Z (\ z -> g (f z)) x)
      (symH (transH (apH (map Y Z g) (beta X Y f x)) (beta Y Z g (f x))))) ;
  reflector : F.Map[TC.types,Sub.sub] = new F.Map[TC.types,Sub.sub,object,map,identity,comp] ;
  inclusion : F.Map[Sub.sub,TC.types] = new F.Map[Sub.sub,TC.types,\ X -> X.1,\ X Y f -> f,
    \ X -> refl (\ x -> x),\ X Y Z g f -> refl (\ x -> g (f x))] ;
  module Adj = Adjunctions[l+,l,l+,l].Wild[TC.types,Sub.sub,reflector,inclusion] ;
  adjunction : Adj.Adjunction = new Adj.Adjunction[\ X Y -> Into[X,Y].equiv,
    \ X V Y u f -> FL.funext V (\ x -> Y.1) _ _ (\ x -> apH f (beta V X u x)),
    \ X Y Z f g -> refl (\ x -> g (f (op.unit X x)))] ;
} ;
module Higher (n : Nat) {
  module R = Reflect[suc n,Truncations[l].TO n] ;
} ;
module GroupActions (G : ChapterFour[l].ConcreteGroup) {
  module S = SetFamilies[l].Over[G.space] ;
  group-sets : Category[l+,l].Category = S.families ;
  objects : Id (U l+) group-sets.pre.ob ChapterFive[l,l].Actions[G].GSet = refl S.family ;
} ;
module SetEpimorphisms (X Y : CategoryOfSets[l].ob) (f : X.1 -> Y.1) {
  module E = SetEpis[l].Map[X.1,Y.1,Y.2,f] ;
  module M = CategoryMonos[l+,l].Ordinary[CategoryOfSets[l].pre,X,Y,f] ;
  onto (e : M.I.epi) : E.surjective = E.epi-surj (\ Z s -> M.epi.1 e (Z,s)) ;
  epi (s : E.surjective) : M.I.epi = M.epi.2 (\ Z -> E.surj-epi s Z.1 Z.2) ;
} ;
