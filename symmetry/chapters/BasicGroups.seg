-- The small symmetric groups and the examples of 4.2.19 and 4.2.21.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module B = Prelude[l+] ; module BP = Paths[l+] ;
module H = HLevels[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module E = Equivalences[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
finite (G : CG.ConcreteGroup) : U l = FiniteSets[l].Finite (CG.Symmetries[G].carrier) ;
abelian (G : CG.ConcreteGroup) : U l = (p q : CG.Symmetries[G].carrier) ->
  Id (CG.Symmetries[G].carrier) (CG.Symmetries[G].abstract.mul p q) (CG.Symmetries[G].abstract.mul q p) ;
abelian-prop (G : CG.ConcreteGroup) : isProp (abelian G) = FL.isProp-Pi (CG.Symmetries[G].carrier)
  (\ p -> (q : CG.Symmetries[G].carrier) -> Id (CG.Symmetries[G].carrier) (CG.Symmetries[G].abstract.mul p q) (CG.Symmetries[G].abstract.mul q p))
  (\ p -> FL.isProp-Pi (CG.Symmetries[G].carrier) (\ q -> Id (CG.Symmetries[G].carrier) (CG.Symmetries[G].abstract.mul p q) (CG.Symmetries[G].abstract.mul q p))
    (\ q -> CG.Symmetries[G].abstract.setG _ _)) ;
module Contract (G : CG.ConcreteGroup) (loops : isProp (CG.Symmetries[G].carrier)) {
  global : (x : G.space) -> isProp (Id G.space x x) = Connected[l].conn-elim zero G.space G.point G.connected
    (\ x -> isProp (Id G.space x x)) (\ x -> FL.isProp-isProp (Id G.space x x)) loops ;
  contractible : FunExtUA[l].isContr G.space = ConnectedLaws[l].Loops[G.space,global].contract G.connected ;
  group-path : Id CG.ConcreteGroup G SignOrderings[l].trivial = GroupIdentity[l].concrete-path G SignOrderings[l].trivial
    (((\ w -> tt),refl tt),qinv _ _ (\ w -> tt) (\ t -> G.point) (isTop tt) (H.contr-prop _ contractible G.point)) ;
} ;
module Proposition (X : U l) (p : isProp X) {
  module G = CG.Symmetric[X,prop-to-set X p] ;
  perms : isProp (Equiv X X) = isProp-Sigma (X -> X) (isEquiv X X) (FL.isProp-Pi X (\ x -> X) (\ x -> p)) (EquivProp[l].isEquiv-prop X X) ;
  module Trivial = Contract[G.group,retract-prop _ _ G.permutations.1 G.permutations.2.sec (sec-ret _ _ G.permutations.1 G.permutations.2) perms] ;
} ;
module PropUniverse {
  X : U l+ = Quotient[l].Prop ; module BH = HLevels[l+] ;
  set : B.isSet X = BH.trunc-set X (BH.retract-trunc CG.two X (Top -> X) (\ p t -> p) (\ f -> f tt) (\ p -> refl p)
    (BH.set-trunc _ (\ f g -> Quotient[l].PropFamilies[Top,f].path-prop g))) ;
  module At (p : X) {
    module G = ChapterFour[l+].Automorphisms[X,BH.trunc-suc CG.two X (BH.set-trunc X set),p] ;
    prop : B.isProp G.B = \ x y -> B.Sigma-eq X G.membership _ _ _ _ (TruncationCombinators[l+].rec (Id X p x.1) @(l+) (Id X x.1 y.1)
      (set x.1 y.1) (\ a -> TruncationCombinators[l+].rec (Id X p y.1) @(l+) _ (set x.1 y.1) (\ b -> BP.transH (BP.symH a) b) y.2) x.2)
      Truncation[l+].Trunc[Id X p y.1].proposition ;
    trivial : Id ChapterFour[l+].ConcreteGroup G.group SignOrderings[l+].trivial = GroupIdentity[l+].concrete-path G.group SignOrderings[l+].trivial
      (((\ x -> tt),refl tt),B.qinv _ _ (\ x -> tt) (\ t -> G.pt) (isTop tt) (prop G.pt)) ;
  } ;
} ;
module Countable {
  module Z = Integers[l] ;
  zig : Z.Int -> Z.Int = split { pos n -> negsuc n ; negsuc n -> pos (suc n) } ;
  decode : Nat -> Z.Int = split { zero -> pos zero ; suc n | r -> zig r } ;
  double : Nat -> Nat = split { zero -> zero ; suc n | r -> suc (suc r) } ;
  code : Z.Int -> Nat = split { pos n -> double n ; negsuc n -> suc (double n) } ;
  successor : (x : Z.Int) -> Id Nat (code (zig x)) (suc (code x)) = split { pos n -> refl (suc (double n)) ; negsuc n -> refl (suc (suc (double n))) } ;
  eta : (n : Nat) -> Id Nat (code (decode n)) n = split { zero -> refl zero ; suc n | r -> transH (successor (decode n)) (apH (\ j -> suc j) r) } ;
  positive : (n : Nat) -> Id Z.Int (decode (double n)) (pos n) = split { zero -> refl (pos zero) ; suc n | r -> apH (\ x -> zig (zig x)) r } ;
  beta : (x : Z.Int) -> Id Z.Int (decode (code x)) x = split { pos n -> positive n ; negsuc n -> apH zig (positive n) } ;
  equiv : Equiv Nat Z.Int = (decode,qinv _ _ decode code beta eta) ;
  sets : U l+ = CircleBundles[l].Set ;
  change : Id sets (Nat,NatArith[l].nat-set) (Z.Int,Z.int-set) = B.Sigma-eq (U l) (\ X -> isSet X) _ _ _ _
    (Axioms[l].UnivalenceLemmas[univ @l].ua Nat Z.Int equiv) (Torsor[l].isProp-isSet Z.Int) ;
  group (s : sets) : CG.ConcreteGroup = CG.Symmetric[s.1,s.2].group ;
  identifies : Id CG.ConcreteGroup (group (Nat,NatArith[l].nat-set)) (group (Z.Int,Z.int-set)) = BP.apH group change ;
} ;
module Integer {
  module I = InfiniteCycleCircle[l] ; module Z = Integers[l] ; module G = I.C ; module S = I.S ;
  module A = CG.Symmetries[CG.integer-group] ; module M = I.M ;
  positive : Equiv A.carrier I.P.J.carrier = E.compose _ _ _ S.winding I.inv-label ;
  value (p : A.carrier) : Id Z.Int (I.label.1 (positive.1 p)) (S.winding.1 p) = I.label.2.sec-eq (S.winding.1 p) ;
  law (p q : A.carrier) : Id I.P.J.carrier (positive.1 (A.abstract.mul p q)) (I.P.J.abstract.mul (positive.1 p) (positive.1 q)) =
    E.injective _ _ I.label.1 I.label.2 _ _ (transH (value (A.abstract.mul p q)) (transH (S.K.band-hom S.base q p)
      (transH (Z.comm (S.winding.1 q) (S.winding.1 p)) (symH (transH (I.preserves (positive.1 p) (positive.1 q))
        (transH (apH (\ x -> Z.add x (I.label.1 (positive.1 q))) (value p)) (apH (Z.add (S.winding.1 p)) (value q))))))) ) ;
  hom : CG.Hom CG.integer-group G.group = M.comparison.2.sec (positive.1,law) ;
  computes (p : A.carrier) : Id I.P.J.carrier ((M.M.D.loop hom).1 p) (positive.1 p) = apH (\ h -> h.1 p) (M.comparison.2.sec-eq (positive.1,law)) ;
  eqv : Lemma4[l].PtEquiv S.Circle S.base G.space G.pt = (hom,Whitehead[l].Pointed[S.Circle,S.base,G.space,G.pt,hom,S.K.conn1,
    E.homotopy _ _ positive (M.M.D.loop hom).1 computes].equiv G.group.connected) ;
  different (p : Id (CG.Hom CG.integer-group G.group) I.map hom) : Empty = subst Z.Int (Z.code (negsuc zero)) _ _
    (transH (symH I.loop-label) (transH (apH (\ f -> I.label.1 ((M.M.D.loop f).1 S.loop)) p)
      (transH (apH I.label.1 (computes S.loop)) (transH (value S.loop) I.generator)))) (Z.code-refl (negsuc zero)) ;
  module PathsOf = InfinityGroups[l].Identifications[CG.integer-group,G.group] ;
  clockwise : Id CG.ConcreteGroup CG.integer-group G.group = PathsOf.paths.2.sec I.equivalence ;
  counterclockwise : Id CG.ConcreteGroup CG.integer-group G.group = PathsOf.paths.2.sec eqv ;
  distinct (p : Id (Id CG.ConcreteGroup CG.integer-group G.group) clockwise counterclockwise) : Empty = different
    (BP.apH (\ w -> w.1) (BP.transH (BP.symH (PathsOf.paths.2.sec-eq I.equivalence)) (BP.transH (BP.apH PathsOf.paths.1 p) (PathsOf.paths.2.sec-eq eqv)))) ;
} ;

module FiniteUniverse {
  module U0 = FiniteSets[l].Universe ; module Ux = U0.C ; module F = FiniteComponents[l] ;
  module BH = HLevels[l+] ; module BE = Equivalences[l+] ; module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
  decode (x y : U0.small) : Equiv (Id U0.small x y) (Equiv (Ux.extension x) (Ux.extension y)) =
    Truncations[l].lower _ _ (Ux.Identity[x,y].forward,Ux.Identity[x,y].univalent) ;
  groupoid (x y : U0.small) : H.isTrunc CG.two (Id U0.small x y) = H.equiv-trunc CG.two _ _ (decode x y)
    (H.set-trunc _ (CircleBundles[l].equivalences-are-set (Ux.extension x,FiniteDecisions[l].On[Ux.extension x,U0.witness x].set)
      (Ux.extension y,FiniteDecisions[l].On[Ux.extension y,U0.witness y].set))) ;
  module Degree (n : Nat) {
    module S = SignOrderings[l].Component[n] ; pt : U0.small = Ux.quotient n ; module G = CG.Automorphisms[U0.small,groupoid,pt] ;
    label (z : U0.small) : Equiv (Id U0.small pt z) (Equiv S.X (Ux.extension z)) =
      B.subst (U l) (\ X -> Equiv (Id U0.small pt z) (Equiv X (Ux.extension z))) _ S.X (Ux.triangle n) (decode pt z) ;
    to (z : U0.small) : G.membership z -> S.codes (Ux.extension z) = TC.map (Id U0.small pt z) (Equiv S.X (Ux.extension z)) (label z).1 ;
    back (z : U0.small) : S.codes (Ux.extension z) -> G.membership z = TC.map (Equiv S.X (Ux.extension z)) (Id U0.small pt z) (label z).2.sec ;
    codes (z : U0.small) : Equiv (G.membership z) (S.codes (Ux.extension z)) = Bijection[l].prop-equiv _ _
      T.Trunc[Id U0.small pt z].proposition T.Trunc[Equiv S.X (Ux.extension z)].proposition (to z) (back z) ;
    family (v : F.all) : U l = S.codes v.1 ;
    total : U l+ = (v : F.all) * family v ;
    forget (t : total) : S.large = (t.1.1,t.2) ;
    restore (v : S.large) : total = ((v.1,F.forget v.1 n v.2),v.2) ;
    eta (t : total) : Id total (restore (forget t)) t = B.ap (FiniteSets[l].Finite t.1.1) total (\ h -> ((t.1.1,h),t.2)) _ _
      (U0.finite-prop t.1.1 _ _) ;
    presentation : B.Equiv G.B S.large = BE.compose _ _ _
      (UniverseChange[l+,l].raise-equiv _ _ (Fibres[l].sigma-equiv U0.small G.membership (\ z -> S.codes (Ux.extension z)) codes))
      (BE.compose _ _ _ (ChapterTwo[l+].change-base U0.small F.all U0.presentation (\ v -> family v))
        (forget,B.qinv _ _ forget restore (\ v -> refl v) eta)) ;
    base : Id S.large (presentation.1 G.pt) S.base = B.Sigma-eq (U l) (\ Y -> S.codes Y) _ _ _ _ (Ux.triangle n) T.Trunc[Equiv S.X S.X].proposition ;
    equiv : Equiv G.B S.G.group.space = Truncations[l].lower _ _ (BE.compose _ _ _ presentation (Bijection[l+].inverse _ _ S.presentation)) ;
    pointed : Id S.G.group.space (equiv.1 G.pt) S.G.pt = BP.transH (BP.apH S.presentation.2.sec (BP.transH base (BP.symH S.pointing)))
      (B.sec-ret _ _ S.presentation.1 S.presentation.2 S.G.pt) ;
    equality : Id CG.ConcreteGroup G.group S.G.group = GroupIdentity[l].concrete-path G.group S.G.group ((equiv.1,pointed),equiv.2) ;
  } ;
} ;
module SmallDegree (n : Nat) (c : FunExtUA[l+].isContr (FiniteComponents[l].part n)) {
  module S = SignOrderings[l].Component[n] ;
  center : (v : S.G.group.space) -> Id S.G.group.space S.G.pt v = \ v -> Equivalences[l+].injective _ _ S.presentation.1 S.presentation.2 _ _
    (HLevels[l+].contr-prop _ c _ _) ;
  trivial : Id CG.ConcreteGroup S.G.group SignOrderings[l].trivial = GroupIdentity[l].concrete-path _ _
    (((\ v -> tt),refl tt),qinv _ _ (\ v -> tt) (\ t -> S.G.pt) (isTop tt) center) ;
} ;
sigma-zero : Id CG.ConcreteGroup SignOrderings[l].Component[zero].G.group SignOrderings[l].trivial =
  SmallDegree[zero,FiniteComponents[l].empty-component].trivial ;
sigma-one : Id CG.ConcreteGroup SignOrderings[l].Component[suc zero].G.group SignOrderings[l].trivial =
  SmallDegree[suc zero,FiniteComponents[l].singleton-component].trivial ;

module AtDesignatedPoint (G : CG.ConcreteGroup) {
  module A = CG.Automorphisms[G.space,G.groupoid,G.point] ;
  lift (y : G.space) : A.B = (y,(G.connected.2 G.point y).1) ;
  first (z : A.B) : G.space = z.1 ;
  eta (z : A.B) : Id A.B (lift (first z)) z = Sigma-eq G.space A.membership _ _ _ _ (refl z.1) T.Trunc[Id G.space G.point z.1].proposition ;
  equality : Id CG.ConcreteGroup A.group G = GroupIdentity[l].concrete-path A.group G
    ((first,refl G.point),qinv _ _ first lift (\ y -> refl y) eta) ;
} ;

module AbelianProduct (G K : CG.ConcreteGroup) (g : abelian G) (k : abelian K) {
  module P = ConcreteExamples[l].Binary[G,K] ; module S = CG.Symmetries[P.group] ;
  x : G.space = G.point ; y : K.space = K.point ;
  combine (a : G.space) (b : K.space) (p : Id G.space x a) (q : Id K.space y b) : Id P.pair P.base (a,b) = P.Loops.combine a b p q ;
  eta (z : P.pair) (p : Id P.pair P.base z) : Id (Id P.pair P.base z) (combine z.1 z.2 (apH (\ t -> t.1) p) (apH (\ t -> t.2) p)) p = P.Loops.eta z p ;
  module Factor (A : U l) (f : P.pair -> A) (c : (p q : Id A (f P.base) (f P.base)) -> Id (Id A (f P.base) (f P.base)) (transH q p) (transH p q)) {
    commute (p q : S.carrier) : Id (Id A (f P.base) (f P.base)) (apH f (S.abstract.mul p q)) (apH f (S.abstract.mul q p)) =
      transH (Groupoid[l].ap-trans P.pair A f P.base P.base P.base q p) (transH (c (apH f p) (apH f q)) (symH (Groupoid[l].ap-trans P.pair A f P.base P.base P.base p q))) ;
  } ;
  module A = Factor[G.space,\ t -> t.1,g] ; module B0 = Factor[K.space,\ t -> t.2,k] ;
  result (p q : S.carrier) : Id S.carrier (S.abstract.mul p q) (S.abstract.mul q p) =
    P.Loops.ext (S.abstract.mul p q) (S.abstract.mul q p) (A.commute p q) (B0.commute p q) ;
} ;
