-- Section 5.4. Orbits as transitive G-subsets, the comparison with the set
-- truncation of the action type, stabilizers, fixed and free points.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module TB = Truncation[l+] ; module TCB = TruncationCombinators[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module FB = Axioms[l+].FunExtLemmas[fe @(l+)] ; module HL = HLevels[l] ;
module E = Equivalences[l] ;
equiv-prop (A B : U l) (pA : isProp A) (pB : isProp B) : isProp (Equiv A B) =
  isProp-Sigma (A -> B) (isEquiv A B) (FL.isProp-Pi A (\ a -> B) (\ a -> pB)) (\ f -> EquivProp[l].isEquiv-prop A B f) ;
-- The propositions of U l form a set.
propat-set : Big.isSet GSets[l].PropAt = \ P Q p q -> Equivalences[l+].injective _ _
  (\ r -> Axioms[l].idtoeqv P.1 Q.1 (Big.ap GSets[l].PropAt (U l) (\ S -> S.1) P Q r))
  (Equivalences[l+].compose (Id GSets[l].PropAt P Q) (Id (U l) P.1 Q.1) (Equiv P.1 Q.1) (ChapterTwo[l+].Subtype[U l,\ A -> isProp A,\ A -> GSets[l].isProp-isProp A].At[P].paths Q)
    (Axioms[l].idtoeqv P.1 Q.1,univ @l P.1 Q.1)).2 p q (equiv-prop P.1 Q.1 P.2 Q.2 _ _) ;
module Over (G : CG.ConcreteGroup) {
  module GS = GSets[l].Over[G] ; module Act = GS.Act ;
  pt : G.space = G.point ; UG : U l = Id G.space pt pt ;
  module Orbits (X : Act.GSet) {
    -- Definition 5.4.1.
    hG : U l = GS.total X ;
    invariant : U l = (z : G.space) -> GS.el X z ;
    groupoid : HL.isTrunc CG.three hG = HL.trunc-Sigma CG.three G.space (GS.el X) G.groupoid
      (\ z -> HL.trunc-suc CG.two _ (HL.set-trunc _ (X z).2)) ;
    transitive-prop (Y : Act.GSet) : isProp (GS.Transitive[Y].transitive) =
      isProp-Sigma GS.Transitive[Y].C.inhabited (\ h -> GS.Transitive[Y].C.transitive) T.Trunc[GS.el Y pt].proposition (\ h ->
        FL.isProp-Pi (GS.el Y pt) (\ x -> (y : GS.el Y pt) -> GS.Transitive[Y].C.relation x y) (\ x ->
          FL.isProp-Pi (GS.el Y pt) (\ y -> GS.Transitive[Y].C.relation x y) (\ y -> T.Trunc[GS.Transitive[Y].C.hits x y].proposition))) ;
    quotient : U l+ = (O : GS.SubG X) * GS.Transitive[GS.underlying X O].transitive ;
    subg-set : Big.isSet (GS.SubG X) = FB.isSet-Pi G.space (\ z -> GS.el X z -> GSets[l].PropAt)
      (\ z -> FB.isSet-Pi (GS.el X z) (\ x -> GSets[l].PropAt) (\ x -> propat-set)) ;
    quotient-set : Big.isSet quotient = Big.isSet-Sigma (GS.SubG X) (\ O -> GS.Transitive[GS.underlying X O].transitive) subg-set
      (\ O -> Big.prop-to-set _ (transitive-prop (GS.underlying X O))) ;
    -- Definition 5.4.3 and Lemma 5.4.4.
    cls (u : hG) : GS.SubG X = \ z x -> (T.Trunc[Id hG u (z,x)].carrier,T.Trunc[Id hG u (z,x)].proposition) ;
    module Class (u : hG) {
      Y : Act.GSet = GS.underlying X (cls u) ;
      module Aut = CG.Automorphisms[hG,groupoid,u] ;
      to (w : GS.total Y) : Aut.B = ((w.1,w.2.1),w.2.2) ;
      from (c : Aut.B) : GS.total Y = (c.1.1,(c.1.2,c.2)) ;
      equiv : Equiv (GS.total Y) Aut.B = (to,qinv _ _ to from (\ c -> refl c) (\ w -> refl w)) ;
      transitive : GS.Transitive[Y].transitive = GS.Transitive[Y].from-connected
        (CircleProperty[l].conn-rt _ _ (CircleProperty[l].rt-equiv _ _ equiv) Aut.group.connected) ;
    } ;
    orbit0 (u : hG) : quotient = (cls u,Class[u].transitive) ;
    -- Lemma 5.4.5: orbit0 is surjective and effective.
    module Represent (O : quotient) (x : GS.el X pt) (h : (O.1 pt x).1) {
      Y : Act.GSet = GS.underlying X O.1 ;
      first (z w : G.space) (g : Id G.space z w) (y : GS.el Y z) : Id (GS.el X w) (GS.act Y z w g y).1 (GS.act X z w g y.1) =
        idJ G.space z (\ w1 g1 -> Id (GS.el X w1) (GS.act Y z w1 g1 y).1 (GS.act X z w1 g1 y.1)) (refl y.1) w g ;
      to (z : G.space) (y : GS.el X z) (k : (O.1 z y).1) : T.Trunc[Id hG (pt,x) (z,y)].carrier =
        TC.map _ _ (\ c -> Sigma-path G.space (GS.el X) pt z x y c.1 (transH (symH (first pt z c.1 (x,h))) (apH (\ v -> v.1) c.2)))
          (GS.Transitive[Y].reach O.2 pt z (x,h) (y,k)) ;
      from (z : G.space) (y : GS.el X z) (t : T.Trunc[Id hG (pt,x) (z,y)].carrier) : (O.1 z y).1 =
        TC.rec (Id hG (pt,x) (z,y)) @l _ (O.1 z y).2 (\ p -> subst hG (\ v -> (O.1 v.1 v.2).1) (pt,x) (z,y) p h) t ;
      same : Id (GS.SubG X) O.1 (cls (pt,x)) = FB.funext G.space (\ z -> GS.el X z -> GSets[l].PropAt) _ _ (\ z ->
        FB.funext (GS.el X z) (\ y -> GSets[l].PropAt) _ _ (\ y -> GSets[l].prop-path _ _ (to z y) (from z y))) ;
      path : Id quotient (orbit0 (pt,x)) O = Big.sym quotient _ _ (Big.Sigma-eq (GS.SubG X)
        (\ P -> GS.Transitive[GS.underlying X P].transitive) _ _ _ _ same (transitive-prop _)) ;
    } ;
    surjective (O : quotient) : TB.Trunc[(u : hG) * Id quotient (orbit0 u) O].carrier =
      TC.rec ((x : GS.el X pt) * (O.1 pt x).1) @(l+) _ TB.Trunc[(u : hG) * Id quotient (orbit0 u) O].proposition
        (\ w -> TB.Trunc[(u : hG) * Id quotient (orbit0 u) O].inc ((pt,w.1),Represent[O,w.1,w.2].path)) O.2.1 ;
    effective (u v : hG) (p : Id quotient (orbit0 u) (orbit0 v)) : T.Trunc[Id hG u v].carrier =
      coe _ _ (Big.sym (U l) _ _ (Big.ap (GS.SubG X) (U l) (\ P -> (P v.1 v.2).1) _ _ (Big.ap quotient (GS.SubG X) (\ O -> O.1) _ _ p)))
        (T.Trunc[Id hG v v].inc (refl v)) ;
    -- The comparison with the set truncation of the action type.
    module ST = ChapterTwo[l].Truncate[suc zero,hG] ;
    module Elim = UniverseChange[l,l+].TruncationElim[suc zero,hG].Into[\ z -> quotient,\ z -> HLevels[l+].set-trunc quotient quotient-set] ;
    compare (z : ST.carrier) : quotient = Elim.restriction.2.sec orbit0 z ;
    compare-unit (u : hG) : Id quotient (compare (ST.unit u)) (orbit0 u) =
      Big.happly hG (\ w -> quotient) _ _ (Elim.restriction.2.sec-eq orbit0) u ;
    st-set : isSet ST.carrier = HL.trunc-set _ (ST.op.trunc hG) ;
    st-paths (u v : hG) (t : T.Trunc[Id hG u v].carrier) : Id ST.carrier (ST.unit u) (ST.unit v) =
      TC.rec (Id hG u v) @l _ (st-set _ _) (\ p -> apH ST.unit p) t ;
    injective : Bijection[l+].Injective compare = \ a b ->
      UniverseChange[l,l+].TruncationElim[suc zero,hG].Into[\ a1 -> (b1 : ST.carrier) -> Id quotient (compare a1) (compare b1) -> Id ST.carrier a1 b1,
        \ a1 -> HLevels[l+].trunc-Pi CG.two ST.carrier (\ b1 -> Id quotient (compare a1) (compare b1) -> Id ST.carrier a1 b1)
          (\ b1 -> HLevels[l+].trunc-Pi CG.two (Id quotient (compare a1) (compare b1)) (\ q -> Id ST.carrier a1 b1)
            (\ q -> HLevels[l+].prop-trunc (suc zero) (Id ST.carrier a1 b1) (st-set a1 b1)))].restriction.2.sec
        (\ u b1 -> UniverseChange[l,l+].TruncationElim[suc zero,hG].Into[\ b2 -> Id quotient (compare (ST.unit u)) (compare b2) -> Id ST.carrier (ST.unit u) b2,
          \ b2 -> HLevels[l+].trunc-Pi CG.two (Id quotient (compare (ST.unit u)) (compare b2)) (\ q -> Id ST.carrier (ST.unit u) b2)
            (\ q -> HLevels[l+].prop-trunc (suc zero) (Id ST.carrier (ST.unit u) b2) (st-set (ST.unit u) b2))].restriction.2.sec
          (\ v q -> st-paths u v (effective u v (Big.trans quotient _ _ _ (Big.sym quotient _ _ (compare-unit u)) (Big.trans quotient _ _ _ q (compare-unit v))))) b1) a b ;
    onto (O : quotient) : TB.Trunc[Bijection[l+].Fibre compare O].carrier =
      TCB.map ((u : hG) * Id quotient (orbit0 u) O) (Bijection[l+].Fibre compare O) (\ w -> (ST.unit w.1,Big.trans quotient _ _ _ (compare-unit w.1) w.2)) (surjective O) ;
    truncation : Big.Equiv ST.carrier quotient = (compare,Bijection[l+].Bij[ST.carrier,quotient,quotient-set,compare,injective,onto].equiv) ;
    -- Corollary 5.4.6.
    orbit (x : GS.el X pt) : quotient = orbit0 (pt,x) ;
    hit (x y : GS.el X pt) : U l = (g : UG) * Id (GS.el X pt) (GS.act X pt pt g x) y ;
    same-orbit (x y : GS.el X pt) (p : Id quotient (orbit x) (orbit y)) : T.Trunc[hit x y].carrier =
      TC.map _ _ (sPath G.space (GS.el X) (pt,x) (pt,y)) (effective (pt,x) (pt,y) p) ;
    orbit-of-hit (x y : GS.el X pt) (t : T.Trunc[hit x y].carrier) : Id quotient (orbit x) (orbit y) =
      TC.rec (hit x y) @(l+) _ (quotient-set _ _) (\ w -> Big.ap hG quotient orbit0 (pt,x) (pt,y) (Sigma-path G.space (GS.el X) pt pt x y w.1 w.2)) t ;
    orbit-onto (O : quotient) : TB.Trunc[(x : GS.el X pt) * Id quotient (orbit x) O].carrier =
      TC.rec ((x : GS.el X pt) * (O.1 pt x).1) @(l+) _ TB.Trunc[(x : GS.el X pt) * Id quotient (orbit x) O].proposition
        (\ w -> TB.Trunc[(x : GS.el X pt) * Id quotient (orbit x) O].inc (w.1,Represent[O,w.1,w.2].path)) O.2.1 ;
    -- Definition 5.4.10: the stabilizer group, its inclusion, and the orbit through x.
    module Stabilizer (x : GS.el X pt) {
      module Aut = CG.Automorphisms[hG,groupoid,(pt,x)] ;
      group : CG.ConcreteGroup = Aut.group ;
      inclusion : CG.Hom group G = (\ v -> v.1.1,refl pt) ;
      through : U l+ = (y : GS.el X pt) * Id quotient (orbit x) (orbit y) ;
      -- Definition 5.4.15.
      fixed : U l = isEquiv _ _ (SubgroupTheory[l].Over[G].loop-map group inclusion) ;
      free : U l = FunExtUA[l].isContr group.space ;
    } ;
    free : U l = (x : GS.el X pt) -> Stabilizer[x].free ;
    -- Lemma 5.4.14: the orbits partition the underlying set.
    partition : Big.Equiv ((O : quotient) * (x : GS.el X pt) * Id quotient (orbit x) O) (GS.el X pt) =
      (\ w -> w.2.1,Big.qinv _ _ (\ w -> w.2.1) (\ x -> (orbit x,(x,refl (orbit x)))) (\ x -> refl x)
        (\ w -> idJ quotient (orbit w.2.1) (\ O1 p -> Id ((O : quotient) * (x : GS.el X pt) * Id quotient (orbit x) O)
          (orbit w.2.1,(w.2.1,refl (orbit w.2.1))) (O1,(w.2.1,p))) (refl (orbit w.2.1,(w.2.1,refl (orbit w.2.1)))) w.1 w.2.2)) ;
    -- Lemma 5.4.20: x is fixed exactly when every symmetry fixes it.
    everywhere (x : GS.el X pt) : U l = (g : UG) -> Id (GS.el X pt) (GS.act X pt pt g x) x ;
    module Fixed (x : GS.el X pt) {
      module St = Stabilizer[x] ; module A = St.Aut ;
      stab : U l = (g : UG) * Id (GS.el X pt) (GS.act X pt pt g x) x ;
      code : Equiv (Id A.B A.pt A.pt) stab = E.compose _ _ _ A.symmetries (ConnectedMaps[l].sigma-paths G.space (GS.el X) (pt,x) (pt,x)) ;
      first (u : hG) (p : Id hG (pt,x) u) : Id (Id G.space pt u.1) (sPath G.space (GS.el X) (pt,x) u p).1 (apH (\ v -> v.1) p) =
        idJ hG (pt,x) (\ v r -> Id (Id G.space pt v.1) (sPath G.space (GS.el X) (pt,x) v r).1 (apH (\ w -> w.1) r)) (refl (refl pt)) u p ;
      on-loops (q : Id A.B A.pt A.pt) : Id UG (SubgroupTheory[l].Over[G].loop-map St.group St.inclusion q) (code.1 q).1 =
        transH (DeloopMaps[l].Maps[A.B,A.pt,G.space,pt].loop-ap St.inclusion q)
          (transH (trans-refl-l G.space pt pt _) (transH (symH (LoopCalc[l].ap-ap A.B hG G.space (\ v -> v.1) (\ u -> u.1) _ _ q))
            (symH (first (pt,x) (A.symmetries.1 q))))) ;
      projection (h : everywhere x) : Equiv stab UG = (\ w -> w.1,qinv _ _ (\ w -> w.1) (\ g -> (g,h g)) (\ g -> refl g)
        (\ w -> Sigma-eq UG (\ g -> Id (GS.el X pt) (GS.act X pt pt g x) x) _ _ _ _ (refl w.1) ((X pt).2 _ x))) ;
      to-fixed (h : everywhere x) : St.fixed = E.homotopy _ _ (E.compose _ _ _ code (projection h)) _ on-loops ;
      from-fixed (f : St.fixed) : everywhere x = \ g -> subst UG (\ k -> Id (GS.el X pt) (GS.act X pt pt k x) x) _ g
        (transH (symH (on-loops (f.sec g))) (f.sec-eq g)) (code.1 (f.sec g)).2 ;
    } ;
    -- Lemma 5.4.21: evaluation of invariant maps is injective, with the fixed points as image.
    module Invariant {
      ev (f : invariant) : GS.el X pt = f pt ;
      ev-injective (f g : invariant) (p : Id (GS.el X pt) (f pt) (g pt)) : Id invariant f g =
        FL.funext G.space (GS.el X) f g (Connected[l].conn-elim zero G.space pt G.connected (\ z -> Id (GS.el X z) (f z) (g z))
          (\ z -> (X z).2 _ _) p) ;
      fixes (f : invariant) : everywhere (f pt) = \ g -> idJ G.space pt (\ w q -> Id (GS.el X w) (GS.act X pt w q (f pt)) (f w))
        (refl (f pt)) pt g ;
      module Build (x : GS.el X pt) (h : everywhere x) (z : G.space) {
        number (p : Id G.space pt z) : GS.el X z = GS.act X pt z p x ;
        agree (p q : Id G.space pt z) : Id (GS.el X z) (number p) (number q) =
          idJ G.space pt (\ w q1 -> (p1 : Id G.space pt w) -> Id (GS.el X w) (GS.act X pt w p1 x) (GS.act X pt w q1 x))
            (\ p1 -> h p1) z q p ;
        module K = ConstantMap[l].Constant[Id G.space pt z,GS.el X z,(X z).2,number,agree] ;
        value : GS.el X z = K.value ((G.connected.2 pt z).1) ;
      } ;
      build (w : (x : GS.el X pt) * everywhere x) : invariant = \ z -> Build[w.1,w.2,z].value ;
      build-pt (w : (x : GS.el X pt) * everywhere x) : Id (GS.el X pt) (build w pt) w.1 =
        Build[w.1,w.2,pt].K.value-at ((G.connected.2 pt pt).1) (refl pt) ;
      everywhere-prop (x : GS.el X pt) : isProp (everywhere x) = FL.isProp-Pi UG (\ g -> Id (GS.el X pt) (GS.act X pt pt g x) x) (\ g -> (X pt).2 _ x) ;
      equivalence : Equiv invariant ((x : GS.el X pt) * everywhere x) = (\ f -> (f pt,fixes f),qinv _ _ (\ f -> (f pt,fixes f)) build
        (\ w -> Sigma-eq (GS.el X pt) everywhere _ _ _ _ (build-pt w) (everywhere-prop w.1))
        (\ f -> ev-injective (build (f pt,fixes f)) f (build-pt (f pt,fixes f)))) ;
    } ;
    -- Definition 5.4.25 and Construction 5.4.28 (orbit-stabilizer).
    module OrbitStabilizer (x : GS.el X pt) {
      module St = Stabilizer[x] ; module A = St.Aut ;
      tilde (v : A.B) : U l = Id G.space pt v.1.1 ;
      action-type : U l = (v : A.B) * tilde v ;
      reach (y : GS.el X pt) : U l = T.Trunc[Id hG (pt,x) (pt,y)].carrier ;
      along (z : G.space) (y : GS.el X z) (p : Id G.space pt z) : Id hG (z,y) (pt,GS.act X z pt (sym G.space pt z p) y) =
        idJ G.space pt (\ w q -> (y1 : GS.el X w) -> Id hG (w,y1) (pt,GS.act X w pt (sym G.space pt w q) y1)) (\ y1 -> refl (pt,y1)) z p y ;
      to (w : action-type) : (y : GS.el X pt) * reach y = (GS.act X w.1.1.1 pt (sym G.space pt w.1.1.1 w.2) w.1.1.2,
        TC.map (Id hG (pt,x) w.1.1) (Id hG (pt,x) (pt,GS.act X w.1.1.1 pt (sym G.space pt w.1.1.1 w.2) w.1.1.2)) (\ r -> transH r (along w.1.1.1 w.1.1.2 w.2)) w.1.2) ;
      from (w : (y : GS.el X pt) * reach y) : action-type = (((pt,w.1),w.2),refl pt) ;
      from-to (w : action-type) : Id action-type (from (to w)) w = idJ G.space pt (\ z p -> (y : GS.el X z) (t : T.Trunc[Id hG (pt,x) (z,y)].carrier) ->
        Id action-type (from (to (((z,y),t),p))) (((z,y),t),p))
        (\ y t -> ap (T.Trunc[Id hG (pt,x) (pt,y)].carrier) action-type (\ t1 -> (((pt,y),t1),refl pt)) _ _ (T.Trunc[Id hG (pt,x) (pt,y)].proposition _ t))
        w.1.1.1 w.2 w.1.1.2 w.1.2 ;
      to-from (w : (y : GS.el X pt) * reach y) : Id ((y : GS.el X pt) * reach y) (to (from w)) w =
        Sigma-eq (GS.el X pt) reach _ _ _ _ (refl w.1) (T.Trunc[Id hG (pt,x) (pt,w.1)].proposition) ;
      reached : Equiv action-type ((y : GS.el X pt) * reach y) = (to,qinv _ _ to from to-from from-to) ;
      orbit-equiv : Big.Equiv ((y : GS.el X pt) * reach y) St.through = Fibres[l+].sigma-equiv (GS.el X pt) (\ y -> reach y)
        (\ y -> Id quotient (orbit x) (orbit y)) (\ y -> (\ t -> TC.rec (Id hG (pt,x) (pt,y)) @(l+) _ (quotient-set _ _)
          (\ p -> Big.ap hG quotient orbit0 (pt,x) (pt,y) p) t,Big.qinv _ _ (\ t -> TC.rec (Id hG (pt,x) (pt,y)) @(l+) _ (quotient-set _ _)
          (\ p -> Big.ap hG quotient orbit0 (pt,x) (pt,y) p) t) (effective (pt,x) (pt,y)) (\ q -> quotient-set _ _ _ q)
          (\ t -> T.Trunc[Id hG (pt,x) (pt,y)].proposition _ t))) ;
      theorem : Big.Equiv action-type St.through = Equivalences[l+].compose _ _ _ (UniverseChange[l+,l].raise-equiv _ _ reached) orbit-equiv ;
    } ;
    -- Lemma 5.4.18 (after the Rocq development: free iff the loops are trivial).
    loops-to-paths (a : hG) (h : isProp (Id hG a a)) (b : hG) : isProp (Id hG a b) = \ p q ->
      idJ hG a (\ c q1 -> (p1 : Id hG a c) -> Id (Id hG a c) p1 q1) (\ p1 -> h p1 (refl a)) b q p ;
    module Free (x : GS.el X pt) {
      module St = Stabilizer[x] ; module A = St.Aut ;
      loops : U l = Id hG (pt,x) (pt,x) ;
      to-loops (c : St.free) : isProp loops = \ l1 l2 -> Equivalences[l].injective _ _ (Bijection[l].inverse _ _ A.symmetries).1
        (Bijection[l].inverse _ _ A.symmetries).2 l1 l2 (HL.contr-prop _ (HL.contr-paths _ c A.pt A.pt) _ _) ;
      base-prop (h : isProp loops) : isProp (Id A.B A.pt A.pt) = \ l1 l2 ->
        Equivalences[l].injective _ _ A.symmetries.1 A.symmetries.2 l1 l2 (h _ _) ;
      paths-prop (h : isProp loops) (v : A.B) : isProp (Id A.B A.pt v) = \ p q ->
        idJ A.B A.pt (\ c q1 -> (p1 : Id A.B A.pt c) -> Id (Id A.B A.pt c) p1 q1) (\ p1 -> base-prop h p1 (refl A.pt)) v q p ;
      from-loops (h : isProp loops) : St.free = (A.pt,\ v -> TC.rec (Id A.B A.pt v) @l _ (paths-prop h v) (\ p -> p) (A.reaches v)) ;
      acts-injectively : U l = (g g' : UG) -> Id (GS.el X pt) (GS.act X pt pt g x) (GS.act X pt pt g' x) -> Id UG g g' ;
      to-injective (c : St.free) : acts-injectively = \ g g' e ->
        transH (symH (Fibres[l].fst-Sigma-path G.space (GS.el X) pt pt x (GS.act X pt pt g' x) g e))
          (transH (ap (Id hG (pt,x) (pt,GS.act X pt pt g' x)) UG (\ r -> ap hG G.space (\ v -> v.1) _ _ r) _ _ (loops-to-paths (pt,x) (to-loops c) (pt,GS.act X pt pt g' x)
            (Sigma-path G.space (GS.el X) pt pt x (GS.act X pt pt g' x) g e) (Sigma-path G.space (GS.el X) pt pt x (GS.act X pt pt g' x) g' (refl (GS.act X pt pt g' x)))))
          (Fibres[l].fst-Sigma-path G.space (GS.el X) pt pt x (GS.act X pt pt g' x) g' (refl (GS.act X pt pt g' x)))) ;
      from-injective (h : acts-injectively) : St.free = from-loops (\ l1 l2 -> Equivalences[l].injective _ _
        (ConnectedMaps[l].sigma-paths G.space (GS.el X) (pt,x) (pt,x)).1 (ConnectedMaps[l].sigma-paths G.space (GS.el X) (pt,x) (pt,x)).2 l1 l2
        (Sigma-eq UG (\ g -> Id (GS.el X pt) (GS.act X pt pt g x) x) _ _ _ _
          (h _ _ (transH (sPath G.space (GS.el X) (pt,x) (pt,x) l1).2 (symH (sPath G.space (GS.el X) (pt,x) (pt,x) l2).2))) ((X pt).2 _ x))) ;
    } ;
    -- Lemma 5.4.19.
    hG-set : U l = isSet hG ;
    set-free (s : hG-set) : free = \ x -> Free[x].from-loops (s _ _) ;
    free-set (f : free) : hG-set = \ a b -> loops-to-paths a (TC.rec (Id G.space a.1 pt) @l _ (FL.isProp-isProp _)
      (\ p -> subst hG (\ c -> isProp (Id hG c c)) (pt,GS.act X a.1 pt p a.2) a
        (symH (Sigma-path G.space (GS.el X) a.1 pt a.2 (GS.act X a.1 pt p a.2) p (refl (GS.act X a.1 pt p a.2))))
        (Free[GS.act X a.1 pt p a.2].to-loops (f _))) ((G.connected.2 a.1 pt).1)) b ;
    set-orbit0 (s : hG-set) : Big.isEquiv hG quotient orbit0 = Bijection[l+].Bij[hG,quotient,quotient-set,orbit0,
      \ u v p -> TC.rec (Id hG u v) @l _ (s u v) (\ q -> q) (effective u v p),surjective].equiv ;
    orbit0-set (e : Big.isEquiv hG quotient orbit0) : hG-set = HLevels[l+].trunc-set hG
      (HLevels[l+].equiv-trunc CG.two hG quotient (orbit0,e) (HLevels[l+].set-trunc quotient quotient-set)) ;
  } ;
} ;
-- Corollaries 5.4.29 and 5.4.30, and Construction 5.4.31.
module Stabilized (G : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet) (x : (X G.point).1) {
  module O = Over[G].Orbits[X] ; module OS = O.OrbitStabilizer[x] ; module St = OS.St ;
  tilde : ChapterFive[l,l].Actions[St.group].GSet = \ v -> (OS.tilde v,HL.trunc-set _ (G.groupoid G.point v.1.1)) ;
  module TG = Over[St.group].Orbits[tilde] ;
  through-set : Big.isSet St.through = Big.isSet-Sigma (GSets[l].Over[G].el X G.point) (\ y -> Id O.quotient (O.orbit x) (O.orbit y))
    (\ a b -> (X G.point).2 a b) (\ y -> Big.prop-to-set _ (O.quotient-set _ _)) ;
  action-set : TG.hG-set = HLevels[l+].trunc-set TG.hG (HLevels[l+].equiv-trunc CG.two TG.hG St.through OS.theorem
    (HLevels[l+].set-trunc St.through through-set)) ;
  -- Corollary 5.4.29.
  tilde-free : TG.free = TG.set-free action-set ;
  -- Corollary 5.4.30.
  cosets (g : OS.tilde St.Aut.pt) : TG.Free[g].acts-injectively = TG.Free[g].to-injective (tilde-free g) ;
} ;
-- Construction 5.4.31.
module PreLagrange (G : CG.ConcreteGroup) (H : Subgroups[l].Over[G].Sub) {
  module Sd = Stabilized[G,H.1,H.2.1] ; module O = Sd.O ;
  all-orbit (y : GSets[l].Over[G].el H.1 G.point) : Id O.quotient (O.orbit H.2.1) (O.orbit y) = O.orbit-of-hit H.2.1 y (H.2.2 H.2.1 y) ;
  to-through : Big.Equiv (GSets[l].Over[G].el H.1 G.point) Sd.St.through = (\ y -> (y,all-orbit y),Big.qinv _ _ (\ y -> (y,all-orbit y)) (\ w -> w.1)
    (\ w -> Big.Sigma-eq _ (\ y -> Id O.quotient (O.orbit H.2.1) (O.orbit y)) _ _ _ _ (refl w.1) (O.quotient-set _ _)) (\ y -> refl y)) ;
  equivalence : Big.Equiv (GSets[l].Over[G].el H.1 G.point) Sd.TG.quotient = Equivalences[l+].compose _ _ _ to-through
    (Equivalences[l+].compose _ _ _ (Bijection[l+].inverse _ _ Sd.OS.theorem) (Sd.TG.orbit0,Sd.TG.set-orbit0 Sd.action-set)) ;
} ;
