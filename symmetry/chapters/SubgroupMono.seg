-- Lemma 5.3.18 and Corollary 5.3.21. Subgroups are the monomorphisms into G,
-- by the preimage of the classifying map.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module Big = Prelude[l+] ; module CG = ChapterFour[l] ; module T = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module FB = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module HL = HLevels[l] ; module W = Whitehead[l] ; module GI = GroupIdentity[l] ; module L4 = Lemma4[l] ; module LCalc = LoopCalc[l] ;
-- trans a b = trans a' b implies a = a'.
right-cancel (A : U l) (x y : A) (a a' : Id A x y) (z : A) (b : Id A y z) :
  Id (Id A x z) (trans A x y z a b) (trans A x y z a' b) -> Id (Id A x y) a a' =
  idJ A y (\ c b1 -> Id (Id A x c) (trans A x y c a b1) (trans A x y c a' b1) -> Id (Id A x y) a a') (\ h -> h) z b ;
-- The first projection of Sigma-eq.
fst-Sigma-eq (A : U l+) (B : A -> U l+) (a a' : A) (b : B a) (b' : B a') (p : Id A a a') (pB : Big.isProp (B a')) :
  Id (Id A a a') (Big.ap ((x : A) * B x) A (\ w -> w.1) _ _ (Big.Sigma-eq A B a a' b b' p pB)) p =
  idJ A a (\ z q -> (pz : Big.isProp (B z)) -> (b2 : B z) ->
      Id (Id A a z) (Big.ap ((x : A) * B x) A (\ w -> w.1) _ _ (Big.Sigma-eq A B a z b b2 q pz)) q)
    (\ pz b2 -> Paths[l+].transH (LoopCalc[l+].ap-ap (B a) ((x : A) * B x) A (\ u -> (a,u)) (\ w -> w.1) b b2 (pz b b2))
      (LoopCalc[l+].ap-const (B a) A a b b2 (pz b b2))) a' p pB b' ;
module Over (G : CG.ConcreteGroup) {
  module ST = SubgroupTheory[l].Over[G] ; module S = ST.S ; module GS = ST.GS ; module Act = ST.Act ;
  pt : G.space = G.point ;
  -- Identifying monomorphisms along pointed equivalences of classifying types.
  tri (X : U l) (x : X) (t : GI.data-of X) (j : L4.PtMap X x G.space pt) (mj : ST.isMono (GI.build X x t) j) : ST.Mono =
    (GI.build X x t,j,mj) ;
  ptcomp-id (X : U l) (x : X) (j : L4.PtMap X x G.space pt) :
    Id (L4.PtMap X x G.space pt) (LCalc.ptcomp X x X x G.space pt (LCalc.ptid X x) j) j =
    ap (Id G.space (j.1 x) pt) (L4.PtMap X x G.space pt) (\ w -> (j.1,w)) _ _ (trans-refl-l G.space _ _ j.2) ;
  module Along (X : U l) (x : X) (c0 : Connected[l].isConn CG.two X) (g0 : HL.isTrunc CG.three X)
    (i : L4.PtMap X x G.space pt) (mi : ST.isMono (GI.build X x (c0,g0)) i) {
    motive (Y : U l) (y : Y) (d : L4.PtEquiv X x Y y) : U l+ = (t : GI.data-of Y) (j : L4.PtMap Y y G.space pt)
      (mj : ST.isMono (GI.build Y y t) j) (c : Id (L4.PtMap X x G.space pt) (LCalc.ptcomp X x Y y G.space pt d.1 j) i) ->
      Id ST.Mono (tri X x (c0,g0) i mi) (tri Y y t j mj) ;
    base : motive X x (PtEquivOps[l].idPt X x) = \ t j mj c ->
      Big.trans ST.Mono _ (tri X x t i mi) _ (Big.ap (GI.data-of X) ST.Mono (\ s -> tri X x s i mi) _ _ (GI.data-prop X (c0,g0) t))
        (Big.ap ((k : L4.PtMap X x G.space pt) * ST.isMono (GI.build X x t) k) ST.Mono (\ w -> tri X x t w.1 w.2) (i,mi) (j,mj)
          (Big.Sigma-eq (L4.PtMap X x G.space pt) (\ k -> ST.isMono (GI.build X x t) k) _ _ _ _
            (sym (L4.PtMap X x G.space pt) _ _ (trans (L4.PtMap X x G.space pt) _ _ _ (sym (L4.PtMap X x G.space pt) _ _ (ptcomp-id X x j)) c))
            (ST.isMono-prop (GI.build X x t) j))) ;
    path (Y : U l) (y : Y) (d : L4.PtEquiv X x Y y) : motive Y y d = PtEquivOps[l].ptEqInd X x motive base Y y d ;
  } ;
  mono-path : (H : CG.ConcreteGroup) (i : CG.Hom H G) (mi : ST.isMono H i) (Y : U l) (y : Y) (d : L4.PtEquiv H.space H.point Y y)
    (t : GI.data-of Y) (j : L4.PtMap Y y G.space pt) (mj : ST.isMono (GI.build Y y t) j)
    (c : Id (L4.PtMap H.space H.point G.space pt) (LCalc.ptcomp H.space H.point Y y G.space pt d.1 j) i) ->
    Id ST.Mono (H,i,mi) (tri Y y t j mj) =
    split { ConcreteGroup X x c0 g0 -> \ i mi Y y d t j mj c -> Along[X,x,c0,g0,i,mi].path Y y d t j mj c } ;
  rebuilt : (H : CG.ConcreteGroup) (i : CG.Hom H G) (mi : ST.isMono H i) ->
    Id ST.Mono (tri H.space H.point (GI.parts H) i mi) (H,i,mi) =
    split { ConcreteGroup X x c0 g0 -> \ i mi -> refl (tri X x (c0,g0) i mi) } ;
  -- The preimage G-set of a monomorphism.
  module Preimage (m : ST.Mono) {
    H : CG.ConcreteGroup = m.1 ; i : CG.Hom H G = m.2.1 ;
    f : H.space -> G.space = i.1 ;
    module M = DeloopMaps[l].Maps[H.space,H.point,G.space,G.point] ;
    inj-at (x y : H.space) : U l = (p q : Id H.space x y) -> Id (Id G.space (f x) (f y)) (apH f p) (apH f q) -> Id (Id H.space x y) p q ;
    inj-prop (x y : H.space) : isProp (inj-at x y) =
      FL.isProp-Pi (Id H.space x y) (\ p -> (q : Id H.space x y) -> Id (Id G.space (f x) (f y)) (apH f p) (apH f q) -> Id (Id H.space x y) p q) (\ p ->
        FL.isProp-Pi (Id H.space x y) (\ q -> Id (Id G.space (f x) (f y)) (apH f p) (apH f q) -> Id (Id H.space x y) p q) (\ q ->
          FL.isProp-Pi (Id (Id G.space (f x) (f y)) (apH f p) (apH f q)) (\ h -> Id (Id H.space x y) p q)
            (\ h -> HL.trunc-set _ (H.groupoid x y) p q))) ;
    base-inj : inj-at H.point H.point = \ p q h -> ap (W.fib _ _ (ST.loop-map H i) ((M.loop i).1 p)) (Id H.space H.point H.point) (\ w -> w.1) _ _
      (m.2.2 ((M.loop i).1 p) (p,refl ((M.loop i).1 p)) (q,symH (transH (M.loop-ap i p)
        (transH (apH (\ r -> trans G.space pt (f H.point) pt (sym G.space (f H.point) pt i.2) (trans G.space (f H.point) (f H.point) pt r i.2)) h)
          (symH (M.loop-ap i q)))))) ;
    inj (x y : H.space) : inj-at x y = Connected[l].conn-elim2 zero H.space H.point H.connected inj-at inj-prop base-inj x y ;
    fibre (z : G.space) : U l = W.fib H.space G.space f z ;
    module FibrePaths (z : G.space) (u v : fibre z) {
      codes : U l = (r : Id H.space u.1 v.1) * Id (Id G.space (f v.1) z) (subst H.space (\ a -> Id G.space (f a) z) u.1 v.1 r u.2) v.2 ;
      solve (w : codes) : Id (Id G.space (f v.1) z) (trans G.space (f v.1) (f u.1) z (sym G.space (f u.1) (f v.1) (apH f w.1)) u.2) v.2 =
        transH (symH (Groupoid[l].transport-fib H.space G.space f z u.1 v.1 w.1 u.2)) w.2 ;
      prop : isProp codes = \ w w' -> Sigma-eq (Id H.space u.1 v.1)
        (\ r -> Id (Id G.space (f v.1) z) (subst H.space (\ a -> Id G.space (f a) z) u.1 v.1 r u.2) v.2) _ _ _ _
        (inj u.1 v.1 w.1 w'.1 (transH (symH (Groupoid[l].sym-sym G.space _ _ (apH f w.1)))
          (transH (apH (sym G.space (f v.1) (f u.1)) (right-cancel G.space (f v.1) (f u.1) _ _ z u.2 (transH (solve w) (symH (solve w')))))
            (Groupoid[l].sym-sym G.space _ _ (apH f w'.1)))))
        (HL.trunc-set _ (G.groupoid (f v.1) z) _ v.2) ;
    } ;
    fibre-set (z : G.space) : isSet (fibre z) = \ u v p q -> Equivalences[l].injective (Id (fibre z) u v) FibrePaths[z,u,v].codes
      (ConnectedMaps[l].sigma-paths H.space (\ a -> Id G.space (f a) z) u v).1
      (ConnectedMaps[l].sigma-paths H.space (\ a -> Id G.space (f a) z) u v).2 p q (FibrePaths[z,u,v].prop _ _) ;
    X : Act.GSet = \ z -> (fibre z,fibre-set z) ;
    x0 : fibre pt = (H.point,i.2) ;
    back (w : GS.total X) : Id (GS.total X) (f w.2.1,(w.2.1,refl (f w.2.1))) w =
      idJ G.space (f w.2.1) (\ z p -> Id (GS.total X) (f w.2.1,(w.2.1,refl (f w.2.1))) (z,(w.2.1,p))) (refl (f w.2.1,(w.2.1,refl (f w.2.1)))) w.1 w.2.2 ;
    total-equiv : Equiv (GS.total X) H.space = (\ w -> w.2.1,qinv _ _ (\ w -> w.2.1) (\ x -> (f x,(x,refl (f x))))
      (\ x -> refl x) back) ;
    connected : Connected[l].isConn CG.two (GS.total X) =
      CircleProperty[l].conn-rt _ _ (CircleProperty[l].rt-equiv _ _ total-equiv) H.connected ;
    sub : S.Sub = (X,x0,(S.Action[X].C.from-connected connected).2) ;
  } ;
  E (m : ST.Mono) : S.Sub = Preimage[m].sub ;
  -- F after E
  module Back (m : ST.Mono) {
    module P = Preimage[m] ;
    d : L4.PtEquiv (GS.total P.X) (pt,P.x0) P.H.space P.H.point = ((\ w -> w.2.1,refl P.H.point),P.total-equiv.2) ;
    c : Id (L4.PtMap (GS.total P.X) (pt,P.x0) G.space pt)
      (LCalc.ptcomp (GS.total P.X) (pt,P.x0) P.H.space P.H.point G.space pt d.1 P.i) (\ w -> w.1,refl pt) =
      DeloopMaps[l].ptmap-path (GS.total P.X) (pt,P.x0) G.space pt (\ w -> P.f w.2.1) (\ w -> w.1)
        (trans G.space _ _ _ (refl (P.f P.H.point)) P.i.2) (refl pt) (\ w -> w.2.2) (trans-refl-l G.space _ _ P.i.2) ;
    path : Id ST.Mono (ST.to-mono (E m)) m = Big.trans ST.Mono _ _ _
      (mono-path (S.underlying (E m)) (S.inclusion (E m)) (ST.Monic[E m].mono) P.H.space P.H.point d (GI.parts P.H) P.i m.2.2 c)
      (rebuilt m.1 m.2.1 m.2.2) ;
  } ;
  -- E after F
  module Forth (s : S.Sub) {
    module P = Preimage[ST.to-mono s] ;
    Xs : Act.GSet = s.1 ;
    proj (z : G.space) : Equiv (P.fibre z) (GS.el Xs z) = ChapterTwo[l].Projection[G.space,GS.el Xs,z].equivalence ;
    on-level (z : G.space) : Id Act.SetAt (P.X z) (Xs z) = Big.Sigma-eq (U l) (\ A -> isSet A) _ _ _ _
      (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (proj z)) (Torsor[l].isProp-isSet _) ;
    e : Id Act.GSet P.X Xs = FB.funext G.space (\ z -> Act.SetAt) _ _ on-level ;
    on-fibre : Id (Id (U l) (P.fibre pt) (GS.el Xs pt)) (GS.fibre-path P.X Xs e pt) (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (proj pt)) =
      Paths[l+].transH (Big.ap (Id Act.SetAt (P.X pt) (Xs pt)) (Id (U l) (P.fibre pt) (GS.el Xs pt)) (\ q -> Big.ap Act.SetAt (U l) (\ S0 -> S0.1) _ _ q) _ _
        (Big.ap ((z : G.space) -> Id Act.SetAt (P.X z) (Xs z)) (Id Act.SetAt (P.X pt) (Xs pt)) (\ h -> h pt) _ _
          (FB.happly-funext G.space (\ z -> Act.SetAt) P.X Xs on-level)))
        (fst-Sigma-eq (U l) (\ A -> isSet A) _ _ _ _ (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (proj pt)) (Torsor[l].isProp-isSet _)) ;
    moves : Id (GS.el Xs pt) (GS.transport-hom P.X Xs e pt P.x0) s.2.1 =
      transH (symH (GS.PathInjective[P.X,Xs].computes e pt P.x0))
        (transH (Big.ap (Id (U l) (P.fibre pt) (GS.el Xs pt)) (GS.el Xs pt) (\ q -> (Axioms[l].idtoeqv _ _ q).1 P.x0) _ _ on-fibre)
          (transH (Axioms[l].UnivalenceLemmas[univ @l].fst-idtoeqv _ _ _ P.x0) (Axioms[l].UnivalenceLemmas[univ @l].ua-beta _ _ (proj pt) P.x0))) ;
    path : Id S.Sub (E (ST.to-mono s)) s = (ConnectedMaps[l+].sigma-paths Act.GSet (\ V -> ST.rest V) (E (ST.to-mono s)) s).2.sec
      (e,Sigma-eq (GS.el Xs pt) (\ x -> S.Action[Xs].C.transitive) _ _ _ _
        (transH (ST.first P.X Xs e (E (ST.to-mono s)).2) moves) (ST.transitive-prop Xs)) ;
  } ;
  -- Lemma 5.3.18 and Corollary 5.3.21.
  equivalence : Big.Equiv S.Sub ST.Mono = (ST.to-mono,Big.qinv _ _ ST.to-mono E (\ m -> Back[m].path) (\ s -> Forth[s].path)) ;
  mono-set : Big.isSet ST.Mono = HLevels[l+].trunc-set ST.Mono (HLevels[l+].equiv-trunc CG.two ST.Mono S.Sub
    (Bijection[l+].inverse _ _ equivalence) (HLevels[l+].set-trunc S.Sub ST.sub-set)) ;
  -- Lemma 5.3.22, for the monomorphism F(X,pt).
  module Picks (s : S.Sub) (g : ST.UG) {
    module A = S.Action[s.1].At[s.2.1,s.2.2] ;
    image : U l = (h : A.loops) * Id ST.UG (ST.loop-map A.group A.projection h) g ;
    to (p : Id (GS.el s.1 pt) (GS.act s.1 pt pt g s.2.1) s.2.1) : image = (A.decode (g,p),transH (ST.Monic[s].on-loops (A.decode (g,p)))
      (transH (symH (A.over A.pt (A.decode (g,p)))) (apH (\ w -> w.1) (A.beta (g,p))))) ;
    from (w : image) : Id (GS.el s.1 pt) (GS.act s.1 pt pt g s.2.1) s.2.1 =
      subst ST.UG (\ k -> Id (GS.el s.1 pt) (GS.act s.1 pt pt k s.2.1) s.2.1) _ g
        (transH (A.over A.pt w.1) (transH (symH (ST.Monic[s].on-loops w.1)) w.2)) (A.encode w.1).2 ;
  } ;
} ;
