-- Section 8.4. Homotopy pullback of the underlying classifying maps,
-- pointed by their two pointing paths. The group uses the pointed component.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module Pullback (G H J : ChapterFour[l].ConcreteGroup)
  (f : ChapterFour[l].Hom G J) (g : ChapterFour[l].Hom H J) {
  span : U l = (a : G.space) * (b : H.space) * Id J.space (f.1 a) (g.1 b) ;
  base : span = (G.point,H.point,transH f.2 (symH g.2)) ;
  component : U l = (w : span) * Truncation[l].Trunc[Id span base w].carrier ;
  point : component = (base,Truncation[l].Trunc[Id span base base].inc (refl base)) ;
  left (z : component) : G.space = z.1.1 ;
  right (z : component) : H.space = z.1.2.1 ;
  commutes (z : component) : Id J.space (f.1 (left z)) (g.1 (right z)) = z.1.2.2 ;
  module HL = HLevels[l] ;
  module CG = ChapterFour[l] ;
  span-groupoid : HL.isTrunc CG.three span =
    HL.trunc-Sigma CG.three G.space (\ a -> (b : H.space) * Id J.space (f.1 a) (g.1 b)) G.groupoid
      (\ a -> HL.trunc-Sigma CG.three H.space (\ b -> Id J.space (f.1 a) (g.1 b)) H.groupoid
        (\ b -> HL.trunc-suc CG.two _ (J.groupoid (f.1 a) (g.1 b)))) ;
  module P = CG.Automorphisms[span,span-groupoid,base] ;
  group : CG.ConcreteGroup = P.group ;
  project-left : CG.Hom group G = (left,refl G.point) ;
  project-right : CG.Hom group H = (right,refl H.point) ;
  module Universal = PointedComponent[l].AtBase[span,span-groupoid,base] ;
} ;

module CG = ChapterFour[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Semi (G : CG.ConcreteGroup) (H : G.space -> CG.ConcreteGroup) {
  B : U l = (z : G.space) * (H z).space ;
  pt : B = (G.point,(H G.point).point) ;
  projection (z : B) : G.space = z.1 ;
  section (z : G.space) : B = (z,(H z).point) ;
  reach (z : G.space) : U l = (w : (H z).space) -> Tr.Trunc[Id B pt (z,w)].carrier ;
  over-point : reach G.point = \ w -> TruncationCombinators[l].map
    (Id (H G.point).space (H G.point).point w) (Id B pt (G.point,w))
    (ap (H G.point).space B (\ t -> (G.point,t)) (H G.point).point w)
    (((H G.point).connected.2 (H G.point).point w).1) ;
  reaches (v : B) : Tr.Trunc[Id B pt v].carrier =
    Connected[l].conn-elim zero G.space G.point G.connected reach
      (\ z -> FL.isProp-Pi (H z).space (\ w -> Tr.Trunc[Id B pt (z,w)].carrier)
        (\ w -> Tr.Trunc[Id B pt (z,w)].proposition)) over-point v.1 v.2 ;
  group : CG.ConcreteGroup = new CG.ConcreteGroup[B,pt,CG.Reachable[B,pt,reaches].connected,
    HLevels[l].trunc-Sigma CG.three G.space (\ z -> (H z).space) G.groupoid (\ z -> (H z).groupoid)] ;
  project : CG.Hom group G = (projection,refl G.point) ;
  splitting : CG.Hom G group = (section,refl pt) ;
  split-law (x : G.space) : Id G.space (projection (section x)) x = refl x ;
} ;
module Wreath (G H : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet) {
  module Power (z : G.space) { module A = CG.Automorphisms[(X z).1 -> H.space,
    HLevels[l].trunc-Pi CG.three (X z).1 (\ x -> H.space) (\ x -> H.groupoid),\ x -> H.point] ; } ;
  group : CG.ConcreteGroup = Semi[G,\ z -> Power[z].A.group].group ;
} ;

module FiniteWreath (G H : CG.ConcreteGroup) (X : ChapterFive[l,l].Actions[G].GSet)
  (finite : FiniteSets[l].Finite ((X G.point).1)) {
  module W = Wreath[G,H,X] ;
  all-finite (z : G.space) : FiniteSets[l].Finite ((X z).1) =
    Connected[l].conn-elim zero G.space G.point G.connected (\ y -> FiniteSets[l].Finite ((X y).1))
      (\ y -> Tr.Trunc[(n : Nat) * Equiv (FinChoice[l].Fin n) ((X y).1)].proposition) finite z ;
  module At (z : G.space) {
    module P = FiniteSets[l].Products[(X z).1,all-finite z,\ i -> H] ;
    module A = W.Power[z].A ;
    equiv : Equiv A.B P.space = (\ v -> v.1,qinv A.B P.space (\ v -> v.1) (\ f -> (f,P.reaches f))
      (\ f -> refl f) (\ v -> Sigma-eq P.space A.membership _ _ _ _ (refl v.1)
        Tr.Trunc[Id P.space P.point v.1].proposition)) ;
  } ;
  classifying : Equiv W.group.space ((z : G.space) * ((X z).1 -> H.space)) =
    Fibres[l].sigma-equiv G.space (\ z -> W.Power[z].A.B) (\ z -> (X z).1 -> H.space) (\ z -> At[z].equiv) ;
} ;
