-- Sections 6.2–6.3. Objects and arrows may have independent levels.
level o h ; open Base ; open Prelude[o \/ h] ;
record Wild {
  ob : U o ;
  hom : ob -> ob -> U h ;
  idn (x : ob) : hom x x ;
  comp (x y z : ob) : hom y z -> hom x y -> hom x z ;
  unit-l (x y : ob) (f : hom x y) : Id (hom x y) (comp x y y (idn y) f) f ;
  unit-r (x y : ob) (f : hom x y) : Id (hom x y) (comp x x y f (idn x)) f ;
  assoc (w x y z : ob) (f : hom w x) (g : hom x y) (k : hom y z) :
    Id (hom w z) (comp w y z k (comp w x y g f)) (comp w x z (comp x y z k g) f) ;
  iso (x y : ob) : U h = (f : hom x y) *
    ((g : hom y x) * Id (hom y y) (comp y x y f g) (idn y)) *
    ((g : hom y x) * Id (hom x x) (comp x y x g f) (idn x)) ;
  ident (x : ob) : iso x x = (idn x,(idn x,unit-l x x (idn x)),idn x,unit-l x x (idn x)) ;
  idtoiso (x y : ob) (p : Id ob x y) : iso x y =
    idJ ob x (\ z q -> iso x z) (ident x) y p ;
  univalent : U (o \/ h) = (x y : ob) -> isEquiv (Id ob x y) (iso x y) (idtoiso x y) ;
} ;
forget (C : Category[o,h].Precategory) : Wild = new Wild[C.ob,C.hom,C.idn,C.comp,C.unit-l,C.unit-r,C.assoc] ;
op (C : Wild) : Wild = new Wild[C.ob,\ x y -> C.hom y x,C.idn,\ x y z g f -> C.comp z y x f g,
  \ x y f -> C.unit-r y x f,\ x y f -> C.unit-l y x f,
  \ w x y z f g k -> Paths[h].symH (C.assoc z y x w k g f)] ;

module FU = FunExtUA[o \/ h] ;
module FL = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
contr-prop (X : U h) (c d : FU.isContr X) : Id (FU.isContr X) c d =
  Sigma-eq X (\ x -> (y : X) -> Id X x y) _ _ _ _ (c.2 d.1)
    (FL.isProp-Pi X (\ y -> Id X d.1 y) (\ y -> prop-to-set X (FU.pathC X c) d.1 y)) ;

module Extremal (C : Wild) {
  terminal (x : C.ob) : U (o \/ h) = (y : C.ob) -> FU.isContr (C.hom y x) ;
  initial (x : C.ob) : U (o \/ h) = (y : C.ob) -> FU.isContr (C.hom x y) ;
  terminals : U (o \/ h) = (x : C.ob) * terminal x ;
  initials : U (o \/ h) = (x : C.ob) * initial x ;
  terminal-prop (ua : C.univalent) (p q : terminals) : Id terminals p q =
    Sigma-eq C.ob terminal _ _ _ _ ((ua p.1 q.1).sec
      ((q.2 p.1).1,((p.2 q.1).1,FU.pathC _ (q.2 q.1) _ _),(p.2 q.1).1,FU.pathC _ (p.2 p.1) _ _))
      (FL.isProp-Pi C.ob (\ y -> FU.isContr (C.hom y q.1)) (\ y -> contr-prop _)) ;
  initial-prop (ua : C.univalent) (p q : initials) : Id initials p q =
    Sigma-eq C.ob initial _ _ _ _ ((ua p.1 q.1).sec
      ((p.2 q.1).1,((q.2 p.1).1,FU.pathC _ (q.2 q.1) _ _),(q.2 p.1).1,FU.pathC _ (p.2 p.1) _ _))
      (FL.isProp-Pi C.ob (\ y -> FU.isContr (C.hom q.1 y)) (\ y -> contr-prop _)) ;
} ;
-- Optional coherences in the remark on wild categories.
module Coherence (C : Wild) {
  unit-law : U (o \/ h) = (x : C.ob) -> Id (Id (C.hom x x) (C.comp x x x (C.idn x) (C.idn x)) (C.idn x))
    (C.unit-l x x (C.idn x)) (C.unit-r x x (C.idn x)) ;
  module Pentagon (a b c d e : C.ob) (f : C.hom a b) (g : C.hom b c) (h0 : C.hom c d) (k : C.hom d e) {
    start : C.hom a e = C.comp _ _ _ k (C.comp _ _ _ h0 (C.comp _ _ _ g f)) ;
    end : C.hom a e = C.comp _ _ _ (C.comp _ _ _ (C.comp _ _ _ k h0) g) f ;
    law : U h = Id (Id (C.hom a e) start end)
      (Paths[h].transH (Paths[h].apH (C.comp _ _ _ k) (C.assoc _ _ _ _ f g h0))
        (Paths[h].transH (C.assoc _ _ _ _ f (C.comp _ _ _ h0 g) k)
          (Paths[h].apH (\ v -> C.comp _ _ _ v f) (C.assoc _ _ _ _ g h0 k))))
      (Paths[h].transH (C.assoc _ _ _ _ (C.comp _ _ _ g f) h0 k) (C.assoc _ _ _ _ f g (C.comp _ _ _ k h0))) ;
  } ;
  pentagon : U (o \/ h) = (a b c d e : C.ob) (f : C.hom a b) (g : C.hom b c) (h0 : C.hom c d) (k : C.hom d e) -> Pentagon[a,b,c,d,e,f,g,h0,k].law ;
} ;
