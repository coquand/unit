-- Exercise 4.5.12. Sort each two-element subset by the ranks in Fin n.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Logic[l] ;
module L = LeastNumber[l] ; module B = BoundedNaturals[l] ; module N = NatArith[l] ;
module E = Equivalences[l] ; module TV = TruthValues[l] ; module FP = FiniteParity[l] ;
module Two = TwoElementSets[l] ; module FA = FiniteArithmetic[l] ;
module At (n : Nat) {
  module M = TranspositionSign[l].At[n] ; module K = M.K ; module P = M.P ; module C = CycleSigns[l].At[n] ;
  X : U l = M.X ; N0 : Nat = K.D.S.N ;
  rank (x : X) : Nat = (B.number N0 x).1 ;
  inj (a b : X) (p : Id Nat (rank a) (rank b)) : Id X a b = E.injective _ _ _ (B.equivalence N0).2 a b (B.same N0 _ _ p) ;
  lt (a b : X) : U l = L.lt (rank a) (rank b) ;
  ne (a b : X) (h : lt a b) (p : Id X a b) : Empty = B.irreflexive (rank b) (subst X (\ t -> lt t b) a b p h) ;
  asym (a b : X) (h : lt a b) (k : lt b a) : Empty = B.irreflexive (rank a)
    (N.le-trans _ (rank b) _ h (N.le-trans _ (suc (rank b)) _ (N.le-sum-r (rank b) (suc zero)) k)) ;
  transport (a b c d : X) (p : Id X a b) (q : Id X c d) (h : lt a c) : lt b d =
    subst X (lt b) c d q (subst X (\ t -> lt t c) a b p h) ;
  ordered : U l = (x : X) * (y : X) * lt x y ;
  path (v w : ordered) (p : Id X v.1 w.1) (q : Id X v.2.1 w.2.1) : Id ordered v w =
    idJ X v.1 (\ a r -> (b : X) (s : lt a b) -> Id X v.2.1 b -> Id ordered v (a,b,s))
      (\ b s h -> ap ((b : X) * lt v.1 b) ordered (\ t -> (v.1,t)) v.2 (b,s) (Sigma-eq X (lt v.1) _ _ _ _ h (N.le-prop (suc (rank v.1)) (rank b)))) w.1 p w.2.1 w.2.2 q ;
  module Members (z : M.pair) {
    module T = Two.At[P.carrier z,P.size z] ;
    frame : U l = (x : P.carrier z) * (y : P.carrier z) * lt x.1 y.1 ;
    a : P.carrier z = K.least z ; b : P.carrier z = T.other a ;
    arrange : B.order (rank a.1) (rank b.1) -> frame = split { left h -> (a,b,h) ; right h -> (b,a,h) } ;
    sorted : frame = arrange (B.compare _ _ (\ p -> T.apart a (M.eq z b a (symH (inj a.1 b.1 p))))) ;
    forget (s : frame) : ordered = (s.1.1,s.2.1.1,s.2.2) ;
    module Unique (s t : frame) {
      x : P.carrier z = s.1 ; y : P.carrier z = s.2.1 ; u : P.carrier z = t.1 ; v : P.carrier z = t.2.1 ;
      other (x y u : P.carrier z) (h : Id (P.carrier z) y x -> Empty) (k : Id (P.carrier z) u x -> Empty) :
        Id (P.carrier z) y u = transH (symH (T.only x y h)) (T.only x u k) ;
      good (p : Id (P.carrier z) x u) : Id ordered (forget s) (forget t) = path _ _ (M.proj z x u p)
        (M.proj z y v (other x y v (\ q -> ne x.1 y.1 s.2.2 (symH (M.proj z y x q)))
          (\ q -> ne u.1 v.1 t.2.2 (symH (M.proj z v u (transH q p)))))) ;
      bad (p : Id (P.carrier z) x u -> Empty) : Empty =
        asym x.1 y.1 s.2.2 (transport u.1 y.1 v.1 x.1
          (M.proj z u y (other x u y (\ q -> p (symH q)) (\ q -> ne x.1 y.1 s.2.2 (symH (M.proj z y x q)))))
          (M.proj z v x (other u v x (\ q -> ne u.1 v.1 t.2.2 (symH (M.proj z v u q))) p)) t.2.2) ;
      choose : Dec (Id (P.carrier z) x u) -> Id ordered (forget s) (forget t) = split { yes p -> good p ; no h -> absurd _ (bad h) } ;
      agrees : Id ordered (forget s) (forget t) = choose (T.D.discrete x u) ;
    } ;
  } ;
  sort (z : M.pair) : ordered = Members[z].forget Members[z].sorted ;
  module Of (w : ordered) { module Q = C.Pair[w.1,w.2.1,ne w.1 w.2.1 w.2.2] ; } ;
  pack (w : ordered) : M.pair = Of[w].Q.pair ;
  beta (w : ordered) : Id ordered (sort (pack w)) w = Members[pack w].Unique[Members[pack w].sorted,(Of[w].Q.u,Of[w].Q.v,w.2.2)].agrees ;
  eta (z : M.pair) : Id M.pair (pack (sort z)) z = Of[sort z].Q.Swap.AtPair[z].unique (Members[z].sorted.1.2) (Members[z].sorted.2.1.2) ;
  coordinates : Equiv M.pair ordered = (sort,qinv _ _ sort pack beta eta) ;

  module Permutation (e : Equiv X X) {
    module Q = K.Permutation[e] ; module O = K.S.O ;
    first (z : M.pair) : P.carrier z = Members[z].sorted.1 ;
    module Move = O.From[K.A,first] ;
    g : K.Par.sections = Move.section K.A Q.loop ;
    pull : Equiv M.pair M.pair = K.pull K.A Q.loop ;
    coord : Equiv M.pair ordered = E.compose _ _ _ pull coordinates ;
    inverted (w : ordered) : U l = lt (e.1 w.2.1) (e.1 w.1) ;
    inversions : U l = (w : ordered) * inverted w ;
    moved (v : K.V) (p : Id K.V K.A v) (z : K.pairs v) : Id v.1 ((Move.section v p z).1) ((K.image v p).1 ((first ((K.pull v p).1 z)).1)) =
      idJ K.V K.A (\ t r -> (z : K.pairs t) -> Id t.1 ((Move.section t r z).1) ((K.image t r).1 ((first ((K.pull t r).1 z)).1)))
        (\ z -> refl (first z).1) v p z ;
    natural (v : K.V) (p : Id K.V K.A v) (z : K.pairs v) (x : X) : Id Bool (((K.pull v p).1 z).1 x) (z.1 ((K.image v p).1 x)) =
      idJ K.V K.A (\ t r -> (z : K.pairs t) -> Id Bool (((K.pull t r).1 z).1 x) (z.1 ((K.image t r).1 x))) (\ z -> refl (z.1 x)) v p z ;
    diff (z : M.pair) : Bool = K.Par.differences first g z ;
    module Over (z : M.pair) {
      w : ordered = coord.1 z ; x : X = e.1 w.1 ; y : X = e.1 w.2.1 ;
      distinct (p : Id X x y) : Empty = ne w.1 w.2.1 w.2.2 (E.injective X X e.1 e.2 _ _ p) ;
      push (t : P.carrier (pull.1 z)) : P.carrier z = (e.1 t.1,transH t.2 (transH (natural K.A Q.loop z t.1) (apH z.1 (Q.applies t.1)))) ;
      a : P.carrier z = push (first (pull.1 z)) ; b : P.carrier z = push (Members[pull.1 z].sorted.2.1) ;
      moving : Id X (g z).1 x = transH (moved K.A Q.loop z) (Q.applies (first (pull.1 z)).1) ;
      module V = ParityQuotient[l].Distance[P.carrier z,P.size z] ;
      module I = FiniteSubsets[l].Proposition[inverted w,N.le-prop (suc (rank y)) (rank x)] ;
      fibre (b : Bool) : U l = Equiv (FinChoice[l].Fin (FP.bit b)) (inverted w) ;
      module Asc (h : lt x y) {
        minimum : Id X (first z).1 x = ap ordered X (\ v -> v.1) _ _ Members[z].Unique[Members[z].sorted,(a,b,h)].agrees ;
        bit : Id Bool (diff z) false = V.same (first z) (g z) (M.eq z _ _ (transH minimum (symH moving))) ;
        equiv : fibre (diff z) = subst Bool fibre false (diff z) (symH bit) (I.empty (asym x y h)) ;
      } ;
      module Desc (h : lt y x) {
        minimum : Id X (first z).1 y = ap ordered X (\ v -> v.1) _ _ Members[z].Unique[Members[z].sorted,(b,a,h)].agrees ;
        bit : Id Bool (diff z) true = V.apart (first z) (g z) (\ p -> distinct
          (transH (symH moving) (transH (symH (M.proj z _ _ p)) minimum))) ;
        equiv : fibre (diff z) = subst Bool fibre true (diff z) (symH bit) (I.singleton h) ;
      } ;
      compare : B.order (rank x) (rank y) -> fibre (diff z) = split { left h -> Asc[h].equiv ; right h -> Desc[h].equiv } ;
      fibre-equiv : fibre (diff z) = compare (B.compare _ _ (\ p -> distinct (inj x y p))) ;
    } ;
    module Count = FiniteCounting[l].Indexed[M.pair,P.finite-pairs,\ z -> FP.bit (diff z)] ;
    equivalence : Equiv Count.total inversions = E.compose _ _ _
      (Fibres[l].sigma-equiv M.pair (\ z -> FinChoice[l].Fin (FP.bit (diff z))) (\ z -> inverted (coord.1 z)) (\ z -> Over[z].fibre-equiv))
      (ChapterTwo[l].change-base M.pair ordered coord inverted) ;
    module Change = FA.Change[Count.total,inversions,equivalence] ;
    finite : FiniteSets[l].Finite inversions = Change.finite Count.bounded ;
    number : Nat = Cardinality[l].Count[inversions].cardinal finite ;
    sign-rule : Id Bool (EvenPermutations[l].Labeled[n].sign e) (Z2[l].rhoN number) =
      transH (K.S.At[K.A].computes Q.loop first) (apH Z2[l].rhoN (Change.same Count.bounded finite)) ;
  } ;
} ;

-- Uniform statement, with inversion count zero in the two smallest degrees.
module Number (m : Nat) (e : Equiv (FinChoice[l].Fin m) (FinChoice[l].Fin m)) {
  X : U l = FinChoice[l].Fin m ; rank (i : X) : Nat = (B.number m i).1 ;
  lt (x y : X) : U l = L.lt (rank x) (rank y) ;
  ordered : U l = (x : X) * (y : X) * lt x y ;
  inverted (w : ordered) : U l = lt (e.1 w.2.1) (e.1 w.1) ;
  inversions : U l = (w : ordered) * inverted w ;
  std : FiniteSets[l].Finite X = FiniteCounting[l].standard m ;
  bound (x y : X) : FiniteSets[l].Finite (lt x y) = FiniteSubsets[l].Proposition[lt x y,N.le-prop (suc (rank x)) (rank y)].finite (L.strict-dec (rank x) (rank y)) ;
  ord-fin : FiniteSets[l].Finite ordered = FA.sigma X std (\ x -> (y : X) * lt x y) (\ x -> FA.sigma X std (lt x) (bound x)) ;
  finite : FiniteSets[l].Finite inversions = FA.sigma ordered ord-fin inverted (\ w -> bound (e.1 w.2.1) (e.1 w.1)) ;
  value : Nat = Cardinality[l].Count[inversions].cardinal finite ;
  empty (k : ordered -> Empty) : Id Nat value zero = Cardinality[l].Count[inversions].computes finite zero
    (FiniteSubsets[l].Proposition[inversions,\ a b -> absurd _ (k a.1)].empty (\ w -> k w.1)) ;
} ;
module Degrees (m : Nat) {
  module S = SignOrderings[l].Component[m] ;
  statement : U l = (e : Equiv S.X S.X) -> Id Bool (FiniteSign[l].bit m S.base e) (Z2[l].rhoN Number[m,e].value) ;
} ;
module Low {
  zero-sign : Degrees[zero].statement = \ e -> symH (apH Z2[l].rhoN (Number[zero,e].empty (\ w -> w.1))) ;
  one : Nat = suc zero ;
  single (x y : FinChoice[l].Fin one) : Id (FinChoice[l].Fin one) x y = HLevels[l].contr-prop _ Two.one-contr x y ;
  one-sign : Degrees[one].statement = \ e -> symH (apH Z2[l].rhoN (Number[one,e].empty (\ w -> B.irreflexive (Number[one,e].rank w.1)
    (subst (FinChoice[l].Fin one) (Number[one,e].lt w.1) w.2.1 w.1 (single w.2.1 w.1) w.2.2)))) ;
} ;
positive (n : Nat) : Degrees[suc (suc n)].statement = \ e -> transH At[n].Permutation[e].sign-rule
  (apH Z2[l].rhoN (apH Cardinality[l].Count[Number[suc (suc n),e].inversions].cardinal
    (FiniteSets[l].Universe.finite-prop Number[suc (suc n),e].inversions At[n].Permutation[e].finite Number[suc (suc n),e].finite))) ;
successor : (n : Nat) -> Degrees[suc n].statement = split { zero -> Low.one-sign ; suc n -> positive n } ;
sign-rule : (n : Nat) -> Degrees[n].statement = split { zero -> Low.zero-sign ; suc n -> successor n } ;
