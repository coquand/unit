-- A symmetry of x is a loop at x. Book composition applies p first, then q.
level l ;
open Base ; open Prelude[l] ;
Symmetry (X : U l) (x : X) : U l = Id X x x ;
module At (X : U l) (x : X) {
  compose (q p : Symmetry X x) : Symmetry X x = trans X x x x p q ;
  inverse (p : Symmetry X x) : Symmetry X x = sym X x x p ;
  cancel (p : Symmetry X x) : Id (Symmetry X x) (compose (inverse p) p) (refl x) =
    Groupoid[l].trans-sym-r X x x p ;
} ;
