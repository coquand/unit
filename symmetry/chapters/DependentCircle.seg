-- The dependent evaluation equivalence of §3.1, for a fixed circle at u
-- and a family at v. Its inverse computes on the point and path together.
level u v ; open Base ; open Prelude[u \/ v] ; open Paths[u \/ v] ;
module C = ChapterThree[u] ; module E = Equivalences[u \/ v] ;
module With (P : C.Circle -> U v) {
  T : U (u \/ v) = (x : C.Circle) * P x ;
  fst (z : T) : C.Circle = z.1 ;
  free (A : U (u \/ v)) : U (u \/ v) = (x : A) * Id A x x ;
  code (a b : T) : U (u \/ v) = (p : Id C.Circle a.1 b.1) * Id (P b.1) (subst C.Circle (\ x -> P x) _ _ p a.2) b.2 ;
  read (a b : T) (p : Id T a b) : code a b = (apH fst p,Sigma-snd C.Circle (\ x -> P x) a.1 b.1 a.2 b.2 p) ;
  write (a b : T) (h : code a b) : Id T a b = Sigma-path C.Circle (\ x -> P x) a.1 b.1 a.2 b.2 h.1 h.2 ;
  rw (a : T) (y : C.Circle) (p : Id C.Circle a.1 y) (b : P y) (q : Id (P y) (subst C.Circle (\ x -> P x) _ _ p a.2) b) :
    Id (code a (y,b)) (read a (y,b) (write a (y,b) (p,q))) (p,q) =
    idJ C.Circle a.1 (\ z r -> (s : P z) (t : Id (P z) (subst C.Circle (\ x -> P x) _ _ r a.2) s) ->
      Id (code a (z,s)) (read a (z,s) (write a (z,s) (r,t))) (r,t))
      (\ s t -> idJ (P a.1) a.2 (\ w h -> Id (code a (a.1,w)) (read a (a.1,w) (write a (a.1,w) (refl a.1,h))) (refl a.1,h))
        (refl (refl a.1,refl a.2)) s t) y p b q ;
  paths (a b : T) : Equiv (Id T a b) (code a b) = (read a b,qinv _ _ (read a b) (write a b)
    (\ w -> rw a b.1 w.1 b.2 w.2) (\ p -> idJ T a (\ z q -> Id (Id T a z) (write a z (read a z q)) q) (refl (refl a)) b p)) ;
  dependent (w : free C.Circle) : U (u \/ v) = (b : P w.1) * Id (P w.1) (subst C.Circle (\ x -> P x) _ _ w.2 b) b ;
  data-space : U (u \/ v) = (w : free C.Circle) * dependent w ;
  packed : U (u \/ v) = (a : T) * code a a ;
  rearrange (w : packed) : data-space = ((w.1.1,w.2.1),w.1.2,w.2.2) ;
  rearranged : Equiv packed data-space = (rearrange,qinv _ _ rearrange
    (\ w -> ((w.1.1,w.2.1),w.1.2,w.2.2)) (\ w -> refl w) (\ w -> refl w)) ;
  decompose : Equiv (free T) data-space = E.compose _ _ _ (Fibres[u \/ v].sigma-equiv T (\ a -> Id T a a)
    (\ a -> code a a) (\ a -> paths a a)) rearranged ;
  end : U u = C.Circle -> C.Circle ;
  sections (f : end) : U (u \/ v) = (x : C.Circle) -> P (f x) ;
  maps : U (u \/ v) = (f : end) * sections f ;
  graph (w : maps) (x : C.Circle) : T = (w.1 x,w.2 x) ;
  graphs : Equiv maps (C.Circle -> T) = (graph,qinv _ _ graph (\ h -> (\ x -> (h x).1,\ x -> (h x).2))
    (\ h -> refl h) (\ w -> refl w)) ;
  module L = CircleLarge[u,u \/ v].Mapping[T] ; module M = CircleLarge[u,u \/ v].Mapping[C.Circle] ;
  complete : Equiv maps data-space = E.compose _ _ _ graphs (E.compose _ _ _ (L.E,L.E-equiv) decompose) ;
  edge (w : maps) (x y : C.Circle) (p : Id C.Circle x y) : Id (P (w.1 y))
    (subst C.Circle (\ z -> P z) _ _ (apH w.1 p) (w.2 x)) (w.2 y) =
    idJ C.Circle x (\ z q -> Id (P (w.1 z)) (subst C.Circle (\ t -> P t) _ _ (apH w.1 q) (w.2 x)) (w.2 z))
      (refl (w.2 x)) y p ;
  natural (w : maps) (x y : C.Circle) (p : Id C.Circle x y) : Id (code (graph w x) (graph w y))
    (apH w.1 p,edge w x y p) (read _ _ (apH (graph w) p)) =
    idJ C.Circle x (\ z q -> Id (code (graph w x) (graph w z)) (apH w.1 q,edge w x z q) (read _ _ (apH (graph w) q)))
      (refl (refl (w.1 x),refl (w.2 x))) y p ;
  at (f : end) (s : sections f) : dependent (M.E f) = (s C.base,edge (f,s) C.base C.base C.loop) ;
  module Square = FibrewiseEquivalence[u \/ v].Square[end,free C.Circle,(M.E,M.E-equiv),sections,dependent,at] ;
  total-equiv : isEquiv maps data-space Square.total = E.homotopy _ _ complete Square.total
    (\ w -> ap (code (graph w C.base) (graph w C.base)) data-space
      (\ q -> ((w.1 C.base,q.1),w.2 C.base,q.2)) _ _ (natural w C.base C.base C.loop)) ;
  identity (x : C.Circle) : C.Circle = x ;
  boundary : U (u \/ v) = dependent (C.base,C.loop) ;
  along (x y : C.Circle) (b : P x) (c : P y) (p : Id C.Circle x y) : U (u \/ v) =
    Id (P y) (subst C.Circle (\ z -> P z) x y p b) c ;
  dap (s : sections identity) (x y : C.Circle) (p : Id C.Circle x y) : along x y (s x) (s y) p =
    idJ C.Circle x (\ z q -> along x z (s x) (s z) q) (refl (s x)) y p ;
  corrected (s : sections identity) (x y : C.Circle) (p : Id C.Circle x y) :
    Id (along x y (s x) (s y) p)
      (subst (Id C.Circle x y) (along x y (s x) (s y)) (apH identity p) p
        (Fibres[u \/ v].ap-id C.Circle x y p) (edge (identity,s) x y p)) (dap s x y p) =
    idJ C.Circle x (\ z q -> Id (along x z (s x) (s z) q)
      (subst (Id C.Circle x z) (along x z (s x) (s z)) (apH identity q) q
        (Fibres[u \/ v].ap-id C.Circle x z q) (edge (identity,s) x z q)) (dap s x z q)) (refl (refl (s x))) y p ;
  adjust (p q : Id C.Circle C.base C.base) (e : Id (Id C.Circle C.base C.base) p q) (b : P C.base) :
    Equiv (along C.base C.base b b p) (along C.base C.base b b q) =
    (subst (Id C.Circle C.base C.base) (along C.base C.base b b) p q e,
      idJ (Id C.Circle C.base C.base) p (\ r h -> isEquiv (along C.base C.base b b p) (along C.base C.base b b r)
        (subst (Id C.Circle C.base C.base) (along C.base C.base b b) p r h)) (idEquiv (along C.base C.base b b p)).2 q e) ;
  data-equiv : Equiv (dependent (M.E identity)) boundary = Fibres[u \/ v].sigma-equiv (P C.base)
    (\ b -> along C.base C.base b b (apH identity C.loop)) (\ b -> along C.base C.base b b C.loop)
    (adjust _ _ (Fibres[u \/ v].ap-id C.Circle C.base C.base C.loop)) ;
  underlying : Equiv (sections identity) boundary = E.compose _ _ _ (at identity,Square.at total-equiv identity) data-equiv ;
  evaluate (s : sections identity) : boundary = (s C.base,dap s C.base C.base C.loop) ;
  evaluation : Equiv ((x : C.Circle) -> P x) boundary = (evaluate,E.homotopy _ _ underlying evaluate
    (\ s -> ap (along C.base C.base (s C.base) (s C.base) C.loop) boundary (\ r -> (s C.base,r)) _ _
      (symH (corrected s C.base C.base C.loop)))) ;
  induction (w : boundary) : (x : C.Circle) -> P x = evaluation.2.sec w ;
  computation (w : boundary) : Id boundary (evaluation.1 (induction w)) w = evaluation.2.sec-eq w ;
} ;
