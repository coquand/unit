-- Theorem 5.5.7, for torsors defined as the component of the principal G-set.
level l ; open Base ; open Prelude[l] ;
module Big = Prelude[l+] ; module T = Truncation[l+] ;
module Classify (G : ChapterFour[l].ConcreteGroup) {
  module A = ChapterFive[l,l].Actions[G] ;
  module FL = Axioms[l+].FunExtLemmas[fe @(l+)] ;
  represent (z y : G.space) : A.SetAt = (Id G.space z y,HLevels[l].trunc-set _ (G.groupoid z y)) ;
  principal : A.GSet = represent G.point ;
  mere (X : A.GSet) : U l+ = T.Trunc[Id A.GSet principal X].carrier ;
  Tor : U l+ = (X : A.GSet) * mere X ;
  reaches (z : G.space) : mere (represent z) = TruncationCombinators[l].rec (Id G.space G.point z) @(l+)
    (mere (represent z)) T.Trunc[Id A.GSet principal (represent z)].proposition
    (\ p -> T.Trunc[Id A.GSet principal (represent z)].inc (Big.ap G.space A.GSet represent G.point z p))
    ((G.connected.2 G.point z).1) ;
  classify (z : G.space) : Tor = (represent z,reaches z) ;
  total (X : A.GSet) : U l = (y : G.space) * (X y).1 ;
  contr (X : A.GSet) : U l = FunExtUA[l].isContr (total X) ;
  represent-contr (z : G.space) : contr (represent z) = DeloopMaps[l].singL G.space z ;
  trivial (t : Tor) : contr t.1 = T.Trunc[Id A.GSet principal t.1].induction @l
    (\ w -> contr t.1) (\ w -> Torsor[l].isProp-isContr (total t.1))
    (\ p -> Big.subst A.GSet (\ X -> contr X) principal t.1 p (represent-contr G.point)) t.2 ;
  center (t : Tor) : G.space = (trivial t).1.1 ;
  module Recover (t : Tor) {
    module F = FundThm[l].FT[G.space,center t,\ y -> (t.1 y).1,(trivial t).1.2,trivial t] ;
    eq (y : G.space) : Id A.SetAt (represent (center t) y) (t.1 y) =
      Big.Sigma-eq (U l) (\ X -> isSet X) _ _ _ _
        (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ (F.tr y,F.equiv y)) (Torsor[l].isProp-isSet _) ;
    beta : Id Tor (classify (center t)) t = Big.Sigma-eq A.GSet mere _ _ _ _
      (FL.funext G.space (\ z -> A.SetAt) _ _ eq) T.Trunc[Id A.GSet principal t.1].proposition ;
  } ;
  eta (z : G.space) : Id G.space (center (classify z)) z =
    ap (contr (represent z)) G.space (\ c -> c.1.1) _ _
      (Torsor[l].isProp-isContr (total (represent z)) (trivial (classify z)) (represent-contr z)) ;
  equivalence : Big.Equiv G.space Tor = (classify,Big.qinv _ _ classify center (\ t -> Recover[t].beta) eta) ;
} ;
