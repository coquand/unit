-- Section 6.6. Covariant Yoneda evaluated at the identity of a.
level o h v ;
open Base ; open Prelude[o \/ h \/ v] ;
module Yoneda (C : Category[o,h].Precategory) (a : C.ob)
  (F : C.ob -> U v) (map : (x y : C.ob) -> C.hom x y -> F x -> F y)
  (unit : (v : F a) -> Id (F a) (map a a (C.idn a) v) v)
  (comp : (x y : C.ob) (g : C.hom x y) (f : C.hom a x) (v : F a) ->
     Id (F y) (map x y g (map a x f v)) (map a y (C.comp a x y g f) v)) {
  family : U (o \/ h \/ v) = (x : C.ob) -> C.hom a x -> F x ;
  natural (t : family) : U (o \/ h \/ v) = (x y : C.ob) (g : C.hom x y) (f : C.hom a x) ->
    Id (F y) (map x y g (t x f)) (t y (C.comp a x y g f)) ;
  represent (v : F a) : family = \ x f -> map a x f v ;
  represent-natural (v : F a) : natural (represent v) = \ x y g f -> comp x y g f v ;
  evaluate (t : family) : F a = t a (C.idn a) ;
  evaluate-represent (v : F a) : Id (F a) (evaluate (represent v)) v = unit v ;
  represent-evaluate (t : family) (n : natural t) (x : C.ob) (f : C.hom a x) :
    Id (F x) (represent (evaluate t) x f) (t x f) =
    trans (F x) _ _ _ (n a x f (C.idn a)) (ap (C.hom a x) (F x) (t x) _ _ (C.unit-r a x f)) ;
} ;

-- Naturality is a proposition when F takes values in sets.
module YonedaEquivalence (C : Category[o,h].Precategory) (a : C.ob)
  (F : C.ob -> U v) (sF : (x : C.ob) -> isSet (F x))
  (map : (x y : C.ob) -> C.hom x y -> F x -> F y)
  (unit : (v : F a) -> Id (F a) (map a a (C.idn a) v) v)
  (comp : (x y : C.ob) (g : C.hom x y) (f : C.hom a x) (v : F a) ->
     Id (F y) (map x y g (map a x f v)) (map a y (C.comp a x y g f) v)) {
  module Y = Yoneda[C,a,F,map,unit,comp] ;
  module FL = Axioms[o \/ h \/ v].FunExtLemmas[fe @(o \/ h \/ v)] ;
  condition (t : Y.family) (x y : C.ob) (g : C.hom x y) (f : C.hom a x) : U v =
    Id (F y) (map x y g (t x f)) (t y (C.comp a x y g f)) ;
  nat-prop (t : Y.family) : isProp (Y.natural t) = FL.isProp-Pi C.ob
    (\ x -> (y : C.ob) (g : C.hom x y) (f : C.hom a x) -> condition t x y g f)
    (\ x -> FL.isProp-Pi C.ob (\ y -> (g : C.hom x y) (f : C.hom a x) -> condition t x y g f)
      (\ y -> FL.isProp-Pi (C.hom x y) (\ g -> (f : C.hom a x) -> condition t x y g f)
        (\ g -> FL.isProp-Pi (C.hom a x) (\ f -> condition t x y g f) (\ f -> sF y _ _)))) ;
  Nat : U (o \/ h \/ v) = (t : Y.family) * Y.natural t ;
  ev (n : Nat) : F a = Y.evaluate n.1 ;
  rep (v : F a) : Nat = (Y.represent v,Y.represent-natural v) ;
  eta (n : Nat) : Id Nat (rep (ev n)) n = Sigma-eq Y.family Y.natural _ _ _ _
    (FL.funext C.ob (\ x -> C.hom a x -> F x) _ _ (\ x ->
      FL.funext (C.hom a x) (\ f -> F x) _ _ (Y.represent-evaluate n.1 n.2 x))) (nat-prop n.1) ;
  yoneda : Equiv Nat (F a) = (ev,qinv Nat (F a) ev rep Y.evaluate-represent eta) ;
} ;
