-- Exercises 3.9.14 and 3.9.15. The fibre of q at the standard m-cycle is the
-- component of the cycles whose m-th root lands in the domain of q.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module Big = Prelude[l+] ; module CC = CycleComponents[l] ; module CF = CycleRootFibres[l] ;
module II = IntegerIteration[l] ; module Z = Integers[l] ; module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module TB = Truncation[l+] ; module TCB = TruncationCombinators[l+] ;
module RC = RootCircle[l] ; module CI = CycleImage[l] ; module W = Whitehead[l] ; module E = Equivalences[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module HL = HLevels[l] ;
module Cn = Connected[l] ; module Sets = CircleBundles[l] ; module I = InfiniteCycle[l] ;
two : Nat = suc (suc zero) ;
-- Lemma 3.6.14: cycles with the same periods are merely equal.
fixes (v : CC.Perm) (k : Z.Int) : U l = (x : v.1.1) -> Id v.1.1 (II.Orbit[v.1.1,v.2].power k x) x ;
fixes-prop (v : CC.Perm) (k : Z.Int) : isProp (fixes v k) =
  FL.isProp-Pi v.1.1 (\ x -> Id v.1.1 (II.Orbit[v.1.1,v.2].power k x) x) (\ x -> v.1.2 _ _) ;
module Towards (v w : CC.Perm) (cv : CF.ConnectedPermutation[v].cycle) (vw : (k : Z.Int) -> fixes v k -> fixes w k)
  (x : v.1.1) (y : w.1.1) {
  module P = CF.ConnectedPermutation[v] ; module B = II.Orbit[w.1.1,w.2] ;
  module G = CycleQuotient[l].At[zero,v].Transitive[cv.2] ;
  module Target (x' : v.1.1) {
    number (a : P.walk x x') : w.1.1 = B.power a.1 y ;
    loop (a b : P.walk x x') : fixes v (Z.add a.1 (Z.neg b.1)) = G.global _ x
      (transH (P.A.Add[a.1,x].compose (Z.neg b.1)) (transH (apH (P.A.power (Z.neg b.1)) (transH a.2 (symH b.2))) (P.A.undo b.1 x))) ;
    agree (a b : P.walk x x') : Id w.1.1 (number a) (number b) = B.cancel (Z.neg b.1) _ _
      (transH (symH (B.Add[a.1,y].compose (Z.neg b.1))) (transH (vw _ (loop a b) y) (symH (B.undo b.1 y)))) ;
    module K = ConstantMap[l].Constant[P.walk x x',w.1.1,w.1.2,number,agree] ;
    value : w.1.1 = K.value (cv.2 x x') ;
    computes (a : P.walk x x') : Id w.1.1 value (number a) = K.value-at (cv.2 x x') a ;
  } ;
  f (x' : v.1.1) : w.1.1 = Target[x'].value ;
  step (x' : v.1.1) : Id w.1.1 (f (v.2.1 x')) (w.2.1 (f x')) = TC.rec (P.walk x x') @l _ (w.1.2 _ _) (\ a ->
    transH (Target[v.2.1 x'].computes (Z.sucZ a.1,transH (P.A.step a.1 x) (apH v.2.1 a.2)))
      (transH (B.step a.1 y) (apH w.2.1 (symH (Target[x'].computes a))))) (cv.2 x x') ;
} ;
module Classify (v w : CC.Perm) (cv : CF.ConnectedPermutation[v].cycle) (cw : CF.ConnectedPermutation[w].cycle)
  (vw : (k : Z.Int) -> fixes v k -> fixes w k) (wv : (k : Z.Int) -> fixes w k -> fixes v k) {
  module Go (x : v.1.1) (y : w.1.1) {
    module F = Towards[v,w,cv,vw,x,y] ; module G = Towards[w,v,cw,wv,y,x] ;
    back (x' : v.1.1) : Id v.1.1 (G.f (F.f x')) x' = TC.rec (F.P.walk x x') @l _ (v.1.2 _ _) (\ a ->
      transH (apH G.f (F.Target[x'].computes a)) (transH (G.Target[F.B.power a.1 y].computes (a.1,refl (F.B.power a.1 y))) a.2)) (cv.2 x x') ;
    forth (y' : w.1.1) : Id w.1.1 (F.f (G.f y')) y' = TC.rec (G.P.walk y y') @l _ (w.1.2 _ _) (\ a ->
      transH (apH F.f (G.Target[y'].computes a)) (transH (F.Target[G.B.power a.1 x].computes (a.1,refl (G.B.power a.1 x))) a.2)) (cw.2 y y') ;
    iso : CC.From[v].Iso w = ((F.f,qinv v.1.1 w.1.1 F.f G.f forth back),F.step) ;
    path : Id CC.Perm v w = CC.From[v].IdSystem.un w iso ;
  } ;
  merely : TB.Trunc[Id CC.Perm v w].carrier = TC.rec v.1.1 @(l+) _ TB.Trunc[Id CC.Perm v w].proposition
    (\ x -> TC.rec w.1.1 @(l+) _ TB.Trunc[Id CC.Perm v w].proposition (\ y -> TB.Trunc[Id CC.Perm v w].inc Go[x,y].path) cw.1) cv.1 ;
} ;
-- Lemma 3.8.9: in the component of a cycle, the pointed cycles form a contractible type.
module Evaluation (u : CC.Perm) (b : u.1.1) (eqv : isEquiv (CC.From[u].Iso u) u.1.1 (\ h -> h.1.1 b)) {
  module C = CC.Component[u] ; module From = CC.From[u] ;
  evaluate (v : CC.Perm) (h : From.Iso v) : v.1.1 = h.1.1 b ;
  property (v : CC.Perm) : U l = isEquiv (From.Iso v) v.1.1 (evaluate v) ;
  at-point : property (C.show C.pt) = Big.subst CC.Perm (\ v -> property v) u (C.show C.pt) (Big.sym _ _ _ C.C.path-at-point) eqv ;
  evaluation (z : C.space) : Equiv (From.Iso (C.show z)) (C.show z).1.1 = (evaluate (C.show z),TC.rec (Id C.space C.pt z) @l _
    (EquivProp[l].isEquiv-prop _ _ (evaluate (C.show z))) (\ p -> subst C.space (\ w -> property (C.show w)) C.pt z p at-point) (C.reaches z)) ;
  based-codes (z : C.space) : Equiv (Id C.space C.pt z) (From.Iso (C.show z)) =
    Big.subst CC.Perm (\ w -> Equiv (Id C.space C.pt z) (CC.From[w].Iso (C.show z))) (C.show C.pt) u C.C.path-at-point C.At[C.pt,z].codes ;
  based-evaluation (z : C.space) : Equiv (Id C.space C.pt z) (C.show z).1.1 = E.compose _ _ _ (based-codes z) (evaluation z) ;
  pointed : U l = (z : C.space) * (C.show z).1.1 ;
  to-paths : Equiv pointed ((z : C.space) * Id C.space z C.pt) = E.compose _ _ _
    (Fibres[l].sigma-equiv C.space (\ z -> (C.show z).1.1) (\ z -> Id C.space C.pt z) (\ z -> Bijection[l].inverse _ _ (based-evaluation z)))
    (Fibres[l].sigma-equiv C.space (\ z -> Id C.space C.pt z) (\ z -> Id C.space z C.pt) (\ z -> ConnectedMaps[l].sym-equiv C.space C.pt z)) ;
  contractible : FunExtUA[l].isContr pointed = HL.equiv-trunc zero pointed _ to-paths (FunExtUA[l].sing C.space C.pt) ;
} ;
-- Sums over a contractible base, and sums over fibres.
contr-base (Bt : U l) (Qf Fm : Bt -> U l) (c : FunExtUA[l].isContr ((b : Bt) * Qf b)) (b0 : Bt) (q0 : Qf b0) :
  Equiv ((b : Bt) * Fm b * Qf b) (Fm b0) =
  (\ v -> subst Bt Fm v.1 b0 (ap ((b : Bt) * Qf b) Bt (\ w -> w.1) _ _ (HL.contr-prop _ c (v.1,v.2.2) (b0,q0))) v.2.1,
   qinv _ _ (\ v -> subst Bt Fm v.1 b0 (ap ((b : Bt) * Qf b) Bt (\ w -> w.1) _ _ (HL.contr-prop _ c (v.1,v.2.2) (b0,q0))) v.2.1)
     (\ x -> (b0,x,q0))
     (\ x -> ap (Id ((b : Bt) * Qf b) (b0,q0) (b0,q0)) (Fm b0)
        (\ r -> subst Bt Fm b0 b0 (ap ((b : Bt) * Qf b) Bt (\ w -> w.1) _ _ r) x) _ (refl (b0,q0))
        (HL.contr-prop _ (HL.contr-paths _ c (b0,q0) (b0,q0)) _ _))
     (\ v -> (idJ ((b : Bt) * Qf b) (v.1,v.2.2) (\ w r -> Id ((b : Bt) * Fm b * Qf b)
        (w.1,subst Bt Fm v.1 w.1 (ap ((b : Bt) * Qf b) Bt (\ u -> u.1) _ _ r) v.2.1,w.2) v)
        (refl v) (b0,q0) (HL.contr-prop _ c (v.1,v.2.2) (b0,q0))))) ;
sum-fibre (A B : U l) (f : A -> B) (P : B -> U l) : Equiv ((a : A) * P (f a)) ((b : B) * W.fib A B f b * P b) =
  (\ w -> (f w.1,(w.1,refl (f w.1)),w.2),qinv _ _ (\ w -> (f w.1,(w.1,refl (f w.1)),w.2))
    (\ v -> (v.2.1.1,subst B P v.1 (f v.2.1.1) (sym B _ _ v.2.1.2) v.2.2))
    (\ v -> idJ B (f v.2.1.1) (\ c e -> (p : P c) -> Id ((b : B) * W.fib A B f b * P b)
       (f v.2.1.1,(v.2.1.1,refl (f v.2.1.1)),subst B P c (f v.2.1.1) (sym B _ _ e) p) (c,(v.2.1.1,e),p))
       (\ p -> refl (f v.2.1.1,(v.2.1.1,refl (f v.2.1.1)),p)) v.1 v.2.1.2 v.2.2)
    (\ w -> refl w)) ;
module Degree (n : Nat) {
  module R = CF.Degree[n] ;
  -- The m-th root determines the periods of a cycle.
  module Periods (a : CC.Perm) (ca : CF.ConnectedPermutation[a].cycle) {
    module Lf = R.Lift[a] ;
    module G = CycleQuotient[l].At[zero,R.rho a].Transitive[(Lf.up ca).2] ;
    up (k : Z.Int) (h : fixes a k) : fixes (R.rho a) (R.D.multiple k) = TC.rec a.1.1 @l _ (fixes-prop (R.rho a) _)
      (\ x -> G.global _ (Lf.embed x) (transH (Lf.block k x) (apH Lf.embed (h x)))) ca.1 ;
    down (k : Z.Int) (h : fixes (R.rho a) (R.D.multiple k)) : fixes a k = \ x ->
      ap Lf.H.X a.1.1 (\ w -> w.2) _ _ (transH (symH (Lf.block k x)) (h (Lf.embed x))) ;
  } ;
  along (v v' : CC.Perm) (p : Id CC.Perm v v') (k : Z.Int) (h : fixes v k) : fixes v' k = Big.subst CC.Perm (\ u -> fixes u k) v v' p h ;
  -- Reflection: if rho a is merely rho uB, then a is merely uB.
  module Reflect (uB : CC.Perm) (cB : CF.ConnectedPermutation[uB].cycle) (a : CC.Perm) {
    cycle-of (p : Id CC.Perm (R.rho a) (R.rho uB)) : CF.ConnectedPermutation[a].cycle = R.Lift[a].down
      (Big.subst CC.Perm (\ v -> CF.ConnectedPermutation[v].cycle) (R.rho uB) (R.rho a) (Big.sym _ _ _ p) (R.Lift[uB].up cB)) ;
    exact (p : Id CC.Perm (R.rho a) (R.rho uB)) : TB.Trunc[Id CC.Perm uB a].carrier =
      Classify[uB,a,cB,cycle-of p,
        \ k h -> Periods[a,cycle-of p].down k (along _ _ (Big.sym _ _ _ p) _ (Periods[uB,cB].up k h)),
        \ k h -> Periods[uB,cB].down k (along _ _ p _ (Periods[a,cycle-of p].up k h))].merely ;
    merely (p : TB.Trunc[Id CC.Perm (R.rho a) (R.rho uB)].carrier) : TB.Trunc[Id CC.Perm uB a].carrier =
      TCB.rec (Id CC.Perm (R.rho a) (R.rho uB)) @(l+) _ TB.Trunc[Id CC.Perm uB a].proposition exact p ;
  } ;
  -- Lemma 3.8.10: m divides every period of an m-th root.
  root-condition (v : CC.Perm) (x : v.1.1) : CycleQuotient[l].At[n,R.rho v].condition = \ k h ->
    transH (symH (R.Lift[v].Project.at (none,x) k)) (ap (R.rho v).1.1 (Fin (suc n)) (\ w -> w.1) _ _ (h (none,x))) ;
  -- The fibre of q at the standard m-cycle, for a source component uB whose
  -- root lands in the component uB' on which q is defined.
  module Fibre (uB uB' : CC.Perm) (base : Id CC.Perm (R.rho uB) uB')
    (cB : CF.ConnectedPermutation[uB].cycle) (cB' : CF.ConnectedPermutation[uB'].cycle)
    (cond : CycleQuotient[l].At[n,uB'].condition) (x0 : uB'.1.1) {
    module Q = CI.Degree[n].Quot[uB',cB',cond,x0] ;
    module A = CI.In[uB] ; module A' = Q.L.A ; module M = Q.L.B ;
    q (d : A'.C.space) : M.C.space = Q.q d ;
    carrier (z : M.C.space) : U l = (M.C.show z).1.1 ;
    fib (z : M.C.space) : U l = W.fib A'.C.space M.C.space q z ;
    module Ev = Evaluation[Q.wm,none,FiniteCycles[l].Centralizer[n].symmetries.2] ;
    e4 : Equiv ((z : M.C.space) * fib z * carrier z) (fib M.C.pt) = contr-base M.C.space carrier fib Ev.contractible M.C.pt (M.start none) ;
    e3 : Equiv ((d : A'.C.space) * carrier (q d)) ((z : M.C.space) * fib z * carrier z) = sum-fibre A'.C.space M.C.space q carrier ;
    Qd (d : A'.C.space) : U l = (CI.Degree[n].F (A'.C.show d)).1.1 ;
    e1a (d : A'.C.space) : Equiv (carrier (q d)) (Qd d) = (RC.act _ _ (Q.L.e d),qinv _ _ (RC.act _ _ (Q.L.e d))
      (RC.act _ _ (Big.sym _ _ _ (Q.L.e d))) (RC.act-forth _ _ (Q.L.e d)) (RC.act-back _ _ (Q.L.e d))) ;
    conditions (v : CC.Perm) : U l = CF.ConnectedPermutation[v].cycle * CycleQuotient[l].At[n,v].condition ;
    at (d : A'.C.space) : conditions (A'.C.show d) = TC.rec (Id A'.C.space A'.C.pt d) @l _
      (isProp-Sigma (CF.ConnectedPermutation[A'.C.show d].cycle) (\ h -> CycleQuotient[l].At[n,A'.C.show d].condition)
        CF.ConnectedPermutation[A'.C.show d].prop (\ h -> CycleQuotient[l].At[n,A'.C.show d].proposition))
      (\ p -> Big.subst CC.Perm (\ v -> conditions v) uB' (A'.C.show d)
        (Big.trans CC.Perm _ _ _ (Big.sym CC.Perm _ _ A'.k) (A'.sh A'.C.pt d p)) (cB',cond)) (A'.C.reaches d) ;
    module Over (d : A'.C.space) {
      v : CC.Perm = A'.C.show d ;
      module V = CycleQuotient[l].At[n,v] ;
      module H = R.Over[(v,(at d).1)] ;
      inc : V.subgroup-inclusion = V.inclusion (at d).2 ;
      remove : Equiv H.small V.Q.Q = (\ w -> w.2,qinv H.small V.Q.Q (\ w -> w.2) (\ c -> (inc,c)) (\ c -> refl c)
        (\ w -> ap V.subgroup-inclusion H.small (\ p -> (p,w.2)) _ _ (V.inclusion-prop inc w.1))) ;
      -- the fibre of the m-th root over d is X/m
      raw-quotient : Big.Equiv H.raw (Qd d) = Equivalences[l+].compose _ _ _ (Bijection[l+].inverse _ _ H.underlying)
        (Equivalences[l+].compose _ _ _ H.classification (UniverseChange[l+,l].raise-equiv _ _ remove)) ;
    } ;
    Sm : U l+ = (d : A'.C.space) * (a : CC.Perm) * Id CC.Perm (R.rho a) (A'.C.show d) ;
    e1 : Big.Equiv ((d : A'.C.space) * carrier (q d)) Sm = Fibres[l+].sigma-equiv A'.C.space (\ d -> carrier (q d))
      (\ d -> Over[d].H.raw) (\ d -> Equivalences[l+].compose _ _ _ (UniverseChange[l+,l].raise-equiv _ _ (e1a d))
        (Bijection[l+].inverse _ _ Over[d].raw-quotient)) ;
    -- the total space of the fibres of the root is the source component
    module Lr = CI.Lift[uB,uB',R.rho,base,\ x t -> (none,t),\ x y p t -> RC.Degree[n].act-rho x y p (none,t),
      \ x y p t -> RC.Degree[n].act-rho-sym x y p (none,t)] ;
    fibA (a : CC.Perm) : U l+ = (x : A.C.space) * Id CC.Perm (A.C.show x) a ;
    fibA-prop (a : CC.Perm) : Big.isProp (fibA a) = Groupoid[l+].emb-fib-prop A.C.space CC.Perm A.C.show A.C.C.image.embedding a ;
    liftA (a : CC.Perm) (h : TB.Trunc[Id CC.Perm uB a].carrier) : fibA a = TCB.rec (Id CC.Perm uB a) @(l+) (fibA a) (fibA-prop a)
      (\ p -> (A.C.pt,Big.trans CC.Perm _ _ _ A.k p)) h ;
    Sa : U l+ = (a : CC.Perm) * Lr.fibre (R.rho a) ;
    swap (w : Sm) : Sa = (w.2.1,(w.1,Big.sym _ _ _ w.2.2)) ;
    unswap (y : Sa) : Sm = (y.2.1,(y.1,Big.sym _ _ _ y.2.2)) ;
    unswap-swap (w : Sm) : Id Sm (unswap (swap w)) w = Big.ap (Id CC.Perm (R.rho w.2.1) (A'.C.show w.1)) Sm (\ p -> (w.1,(w.2.1,p))) _ _
      (Groupoid[l+].sym-sym CC.Perm _ _ w.2.2) ;
    swap-unswap (y : Sa) : Id Sa (swap (unswap y)) y = Big.ap (Id CC.Perm (A'.C.show y.2.1) (R.rho y.1)) Sa (\ p -> (y.1,(y.2.1,p))) _ _
      (Groupoid[l+].sym-sym CC.Perm _ _ y.2.2) ;
    near (y : Sa) : TB.Trunc[Id CC.Perm (R.rho y.1) (R.rho uB)].carrier = TC.rec (Id A'.C.space A'.C.pt y.2.1) @(l+) _
      TB.Trunc[Id CC.Perm (R.rho y.1) (R.rho uB)].proposition
      (\ c -> TB.Trunc[Id CC.Perm (R.rho y.1) (R.rho uB)].inc (Big.trans CC.Perm _ _ _ (Big.sym _ _ _ y.2.2)
        (Big.trans CC.Perm _ _ _ (Big.sym _ _ _ (A'.sh A'.C.pt y.2.1 c)) (Big.trans CC.Perm _ _ _ A'.k (Big.sym _ _ _ base))))) (A'.C.reaches y.2.1) ;
    found (y : Sa) : fibA y.1 = liftA y.1 (Reflect[uB,cB,y.1].merely (near y)) ;
    down (y : Sa) : A.C.space = (found y).1 ;
    up (x : A.C.space) : Sa = (A.C.show x,(Lr.map x,Lr.e x)) ;
    down-up (x : A.C.space) : Id A.C.space (down (up x)) x =
      Big.ap (fibA (A.C.show x)) A.C.space (\ f -> f.1) _ _ (fibA-prop _ (found (up x)) (x,refl (A.C.show x))) ;
    up-down (y : Sa) : Id Sa (up (down y)) y =
      Big.Sigma-eq CC.Perm (\ a -> Lr.fibre (R.rho a)) _ _ _ _ (found y).2 (Lr.fibre-prop (R.rho y.1)) ;
    e2 : Big.Equiv Sm A.C.space = Equivalences[l+].compose Sm Sa A.C.space (swap,Big.qinv Sm Sa swap unswap swap-unswap unswap-swap)
      (down,Big.qinv Sa A.C.space down up down-up up-down) ;
    raise (X Y : U l) (e : Equiv X Y) : Big.Equiv X Y = UniverseChange[l+,l].raise-equiv X Y e ;
    fibre-equiv : Equiv (fib M.C.pt) A.C.space = Truncations[l].lower _ _ (Equivalences[l+].compose _ _ _
      (raise _ _ (Bijection[l].inverse _ _ e4)) (Equivalences[l+].compose _ _ _ (raise _ _ (Bijection[l].inverse _ _ e3))
        (Equivalences[l+].compose _ _ _ e1 e2))) ;
    -- hence q is 0-connected, and its 0-image factorization
    connected-at-point : Cn.isConn two (fib M.C.pt) =
      CircleProperty[l].conn-rt _ _ (CircleProperty[l].rt-equiv _ _ fibre-equiv) A.C.group.connected ;
    connected (y : M.C.space) : Cn.isConn two (fib y) = TC.rec (Id M.C.space M.C.pt y) @l _ (Cn.conn-prop two (fib y))
      (\ p -> subst M.C.space (\ y1 -> Cn.isConn two (fib y1)) M.C.pt y p connected-at-point) (M.C.reaches y) ;
    module Image = ZeroImage[l+].Comparison[A'.C.space,M.C.space,Sets.Set,Q.quotient,q,Q.r,Q.factor,
      \ y -> UniverseChange[l,l+].connected two (fib y) (connected y),
      \ S -> HLevels[l+].set-trunc Q.Truncated[S].fibre Q.Truncated[S].set] ;
    zero-image : Big.Equiv Image.Im.space M.C.space = Image.equivalence ;
  } ;
  -- Exercise 3.9.14: infinite cycles. This q is the map of Theorem 3.9.13.
  module Infinite {
    module RB = InfiniteRootBundles[l].Degree[n] ;
    module F = Fibre[I.standard,I.standard,RB.standard-path,InfiniteRootBundles[l].cycle,InfiniteRootBundles[l].cycle,RB.period,Z.zeroZ] ;
    same-q : Id (F.A'.C.space -> F.M.C.space) F.q CI.Degree[n].Inf.q = refl F.q ;
    fibre : Equiv (F.fib F.M.C.pt) F.A.C.space = F.fibre-equiv ;
  } ;
  -- Exercise 3.9.15: cycles of order d = j+1. Cyc_md is the component of the
  -- root of the standard d-cycle, as in the book.
  module Finite (j : Nat) {
    uB : CC.Perm = CC.Finite[j].standard ;
    module St = FiniteCycles[l].Standard[j] ; module P = CF.ConnectedPermutation[uB] ;
    from-start (x : St.A) : P.walk none x = (pos (St.reaches x).1,(St.reaches x).2) ;
    cycle : P.cycle = (T.Trunc[St.A].inc none,\ x y -> T.Trunc[P.walk x y].inc (P.join x none y (P.reverse none x (from-start x)) (from-start y))) ;
    module F = Fibre[uB,R.rho uB,refl (R.rho uB),cycle,R.Lift[uB].up cycle,root-condition uB none,(none,none)] ;
    root : F.A.C.space -> F.A'.C.space = F.Lr.map ;
    quotient-is-fibre (d : F.A'.C.space) : Big.Equiv F.Over[d].H.raw (F.Q.quotient d).1 = F.Over[d].raw-quotient ;
    connected (y : F.M.C.space) : Cn.isConn two (F.fib y) = F.connected y ;
    fibre : Equiv (F.fib F.M.C.pt) F.A.C.space = F.fibre-equiv ;
    zero-image : Big.Equiv F.Image.Im.space F.M.C.space = F.zero-image ;
  } ;
} ;
