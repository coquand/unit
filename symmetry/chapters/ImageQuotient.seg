-- Exercise 2.22.19. Quotient by the path relation induced by a function.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Of (A B : U l) (f : A -> B) {
  module I = ImageFactorizations[l].Of[A,B,f] ; module C = ConnectedComponents[l].Parts[I.I.image] ;
  path (a b : A) : U l = Id B (f a) (f b) ;
  rel (a b : A) : U l = T.Trunc[path a b].carrier ;
  comp (a b c : A) (p : rel a b) (q : rel b c) : rel a c = TC.rec (path a b) @l _ T.Trunc[path a c].proposition
    (\ h -> TC.map (path b c) (path a c) (\ k -> transH h k) q) p ;
  module Q = Quotient[l].Quot[A,rel,\ a b -> T.Trunc[path a b].proposition,\ a -> T.Trunc[path a a].inc (refl (f a)),
    \ a b -> TC.map (path a b) (path b a) (\ h -> symH h),comp] ;
  point (a : A) : C.S.carrier = C.S.unit (I.point a) ;
  module P (a b : A) { module S = C.PathsAt[I.point a,I.point b] ;
    paths : Equiv S.actual (path a b) = I.I.Sub.At[I.point a].paths (I.point b) ;
    sound (h : rel a b) : S.joined = S.encode (TC.map (path a b) S.actual paths.2.sec h) ;
    complete (h : S.joined) : rel a b = TC.map S.actual (path a b) paths.1 (S.decode h) ;
  } ;
  module D = Q.Descend[C.S.carrier,C.set,point,\ a b -> P[a,b].sound] ;
  member (y : C.S.carrier) : U l = (x : Q.Q) * Id C.S.carrier (D.map x) y ;
  onto (y : C.S.carrier) : T.Trunc[member y].carrier = TC.rec (C.part y) @l _ T.Trunc[member y].proposition
    (\ z -> TC.map ((a : A) * Id I.I.image (I.point a) z.1) (member y)
      (\ w -> (Q.inc w.1,transH (D.beta w.1) (transH (apH C.S.unit w.2) z.2))) (I.cover z.1)) (C.connected y).1 ;
  fib (x : Q.Q) : U l = (a : A) * Id Q.Q (Q.inc a) x ;
  rep : (x : Q.Q) -> T.Trunc[fib x].carrier = Q.induction @l (\ x -> T.Trunc[fib x].carrier)
    (\ x -> T.Trunc[fib x].proposition) (\ a -> T.Trunc[fib (Q.inc a)].inc (a,refl (Q.inc a))) ;
  inj (x y : Q.Q) (p : Id C.S.carrier (D.map x) (D.map y)) : Id Q.Q x y = TC.rec (fib x) @l _ (Q.set x y)
    (\ a -> TC.rec (fib y) @l _ (Q.set x y) (\ b -> transH (symH a.2) (transH (Q.relates a.1 b.1
      (P[a.1,b.1].complete (transH (symH (D.beta a.1)) (transH (apH D.map a.2) (transH p
        (transH (symH (apH D.map b.2)) (D.beta b.1))))))) b.2)) (rep y)) (rep x) ;
  equivalence : Equiv Q.Q C.S.carrier = (D.map,Bijection[l].Bij[Q.Q,C.S.carrier,C.set,D.map,inj,onto].equiv) ;
} ;
