-- Section 6.7. Mark an object-surjective family in a univalent category.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = Prelude[l+] ; module K = Category[l,l] ; module F = Functor[l,l,l,l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ; module E = EquivalenceLemmas[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
surj (A X : U l) (f : A -> X) : U l = (x : X) -> T.Trunc[(a : A) * Id X (f a) x].carrier ;
flags : U l+ = (D : K.Category) * (A : U l) * (f : A -> D.pre.ob) * surj A D.pre.ob f ;
pre (w : flags) : K.Precategory = CompletionUP[l,l,l,l,l].Instance[w.1,w.2.1,w.2.2.1].pre ;
module Image (C : K.Precategory) {
  module R = RezkCompletion[l,l,l,l].On[C] ;
  onto : surj C.ob R.completion.pre.ob R.unit.obj = \ x -> TC.map ((a : C.ob) * R.completion.pre.Iso (R.unit.obj a) x) ((a : C.ob) * Id R.completion.pre.ob (R.unit.obj a) x)
    (\ w -> (w.1,R.completion.isotoid (R.unit.obj w.1) x w.2)) (R.essentially-surjective x) ;
  flag : flags = (R.completion,C.ob,R.unit.obj,onto) ;
  module I = CategoryIdentity[l,l].From[C] ;
  strict : I.iso (pre flag) = (idEquiv C.ob,(\ a b -> (R.unit.map a b,R.fully-faithful a b)),R.unit.map-idn,\ a b c h g -> R.unit.map-comp a b c g h) ;
  path : Id K.Precategory (pre flag) C = Paths[l+].symH ((I.equality (pre flag)).2.sec strict) ;
} ;
flag (C : K.Precategory) : flags = Image[C].flag ;
module Recover (w : flags) {
  D : K.Category = w.1 ; A : U l = w.2.1 ; f : A -> D.pre.ob = w.2.2.1 ;
  C : K.Precategory = pre w ; module U0 = Image[C] ; module R = U0.R ;
  M : K.Category = R.completion ;
  embed : F.Functor[R.source,D.pre] = new F.Functor[R.source,D.pre,f,\ a b h -> h,\ a -> refl (C.idn a),\ a b c g h -> refl (C.comp a b c g h)] ;
  module UP = R.Into[D] ;
  extend : F.Functor[M.pre,D.pre] = UP.restriction.2.sec embed ;
  triangle : Id (F.Functor[R.source,D.pre]) (UP.restriction.1 extend) embed = UP.restriction.2.sec-eq embed ;
  point (a : A) : Id D.pre.ob (extend.obj (R.unit.obj a)) (f a) = apH (\ t -> t.obj a) triangle ;
  composite : F.FullyFaithful R.source D.pre (UP.restriction.1 extend) = subst (F.Functor[R.source,D.pre])
    (F.FullyFaithful R.source D.pre) embed _ (symH triangle) (\ a b -> (idEquiv (C.hom a b)).2) ;
  property (x y : M.pre.ob) : U l = isEquiv (M.pre.hom x y) (D.pre.hom (extend.obj x) (extend.obj y)) (extend.map x y) ;
  prop (x y : M.pre.ob) : isProp (property x y) = CategorySIP[l,l].EquivProofs[M.pre.hom x y,D.pre.hom (extend.obj x) (extend.obj y),M.pre.hom-set x y,D.pre.hom-set _ _,extend.map x y].proof-prop ;
  generators (a b : A) : property (R.unit.obj a) (R.unit.obj b) =
    E.homotopy _ _ (\ k -> (UP.restriction.1 extend).map a b ((R.fully-faithful a b).sec k)) (extend.map (R.unit.obj a) (R.unit.obj b)) (\ k -> apH (extend.map _ _) ((R.fully-faithful a b).sec-eq k))
      (E.compose _ _ _ ((UP.restriction.1 extend).map a b) (R.fully-faithful a b).sec
        (composite a b) (E.inverse (C.hom a b) (M.pre.hom (R.unit.obj a) (R.unit.obj b)) (R.unit.map a b,R.fully-faithful a b)).2) ;
  module Dense (P : M.pre.ob -> U l) (pr : (x : M.pre.ob) -> isProp (P x)) (g : (a : A) -> P (R.unit.obj a)) {
    all (x : M.pre.ob) : P x = TC.rec ((a : A) * Id M.pre.ob (R.unit.obj a) x) @l (P x) (pr x)
      (\ v -> subst M.pre.ob P _ x v.2 (g v.1)) (U0.onto x) ;
  } ;
  ff : F.FullyFaithful M.pre D.pre extend = Dense[(\ x -> (y : M.pre.ob) -> property x y),
    (\ x -> FL.isProp-Pi M.pre.ob (property x) (prop x)),(\ a -> Dense[property (R.unit.obj a),prop (R.unit.obj a),generators a].all)].all ;
  es : F.EssSurj M.pre D.pre extend = \ d -> TC.map ((a : A) * Id D.pre.ob (f a) d) ((x : M.pre.ob) * D.pre.Iso (extend.obj x) d)
    (\ v -> (R.unit.obj v.1,D.pre.idtoiso _ _ (transH (point v.1) v.2))) (w.2.2.2 d) ;
  module I = CategoryIdentity[l,l].UnivalentFrom[M] ; module W = I.Weak[D,extend,ff,es] ;
  carried (N : K.Category) (p : Id K.Category M N) (a : A) : N.pre.ob = ((I.equality N).1 p).1.1 (R.unit.obj a) ;
  module Lift (a : A -> M.pre.ob) (s : surj A M.pre.ob a) {
    same (b : A -> M.pre.ob) (e : Id (A -> M.pre.ob) a b) : (t : surj A M.pre.ob b) -> Id flags (M,A,a,s) (M,A,b,t) =
      idJ (A -> M.pre.ob) a (\ c q -> (t : surj A M.pre.ob c) -> Id flags (M,A,a,s) (M,A,c,t))
        (\ t -> B.ap (surj A M.pre.ob a) flags (\ v -> (M,A,a,v)) s t
          (FL.isProp-Pi M.pre.ob (\ x -> T.Trunc[(v : A) * Id M.pre.ob (a v) x].carrier)
            (\ x -> T.Trunc[(v : A) * Id M.pre.ob (a v) x].proposition) s t)) b e ;
  } ;
  module Start = Lift[R.unit.obj,U0.onto] ;
  along (N : K.Category) (p : Id K.Category M N) : (b : A -> N.pre.ob) (t : surj A N.pre.ob b)
    (e : (a : A) -> Id N.pre.ob (carried N p a) (b a)) -> Id flags (flag C) (N,A,b,t) =
    idJ K.Category M (\ Z q -> (b : A -> Z.pre.ob) (t : surj A Z.pre.ob b) (e : (a : A) -> Id Z.pre.ob (carried Z q a) (b a)) ->
      Id flags (flag C) (Z,A,b,t)) (\ b t e -> Start.same b (FL.funext A (\ a -> M.pre.ob) R.unit.obj b e) t) N p ;
  path : Id flags (flag C) w = along D W.path f w.2.2.2 (\ a -> transH
    (apH (\ i -> i.1.1 (R.unit.obj a)) W.computes) (point a)) ;
} ;
equivalence : B.Equiv K.Precategory flags = (flag,B.qinv _ _ flag pre (\ w -> Recover[w].path) (\ C -> Image[C].path)) ;
