-- Section 6.8. A universal cone has a contractible type of mediating maps.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module FL = Axioms[o \/ h].FunExtLemmas[fe @(o \/ h)] ;
module FU = FunExtUA[o \/ h] ;
module Binary (C : WildCategory[o,h].Wild) (A B : C.ob) {
  legs (x : C.ob) : U h = C.hom x A * C.hom x B ;
  cone : U (o \/ h) = (x : C.ob) * legs x ;
  pull (x y : C.ob) (f : C.hom x y) (q : legs y) : legs x =
    (C.comp x y A q.1 f,C.comp x y B q.2 f) ;
  pair-path (x : C.ob) (s t : legs x) (p : Id (C.hom x A) s.1 t.1) (q : Id (C.hom x B) s.2 t.2) : Id (legs x) s t =
    transH (ap (C.hom x A) (legs x) (\ a -> (a,s.2)) _ _ p) (ap (C.hom x B) (legs x) (\ b -> (t.1,b)) _ _ q) ;
  unit (v : cone) : Id (legs v.1) (pull v.1 v.1 (C.idn v.1) v.2) v.2 =
    pair-path v.1 _ _ (C.unit-r _ _ v.2.1) (C.unit-r _ _ v.2.2) ;
  arrow (u v : cone) : U h = (f : C.hom u.1 v.1) * Id (legs u.1) (pull u.1 v.1 f v.2) u.2 ;
  identity (u : cone) : arrow u u = (C.idn u.1,unit u) ;
  compose (u v w : cone) (f : arrow u v) (g : arrow v w) : arrow u w =
    (C.comp _ _ _ g.1 f.1,transH (pair-path u.1 _ _
      (C.assoc _ _ _ _ f.1 g.1 w.2.1) (C.assoc _ _ _ _ f.1 g.1 w.2.2))
      (transH (apH (pull u.1 v.1 f.1) g.2) f.2)) ;
  universal (v : cone) : U (o \/ h) = (u : cone) -> FU.isContr (arrow u v) ;
  product : U (o \/ h) = (v : cone) * universal v ;
  universal-prop (v : cone) : isProp (universal v) = FL.isProp-Pi cone
    (\ u -> FU.isContr (arrow u v)) (\ u -> WildCategory[o,h].contr-prop (arrow u v)) ;
  module Compare (P Q : product) {
    p : cone = P.1 ; q : cone = Q.1 ;
    f : arrow p q = (Q.2 p).1 ; g : arrow q p = (P.2 q).1 ;
    endo (v : product) (t : arrow v.1 v.1) : Id (C.hom v.1.1 v.1.1) t.1 (C.idn v.1.1) =
      apH (\ k -> k.1) (FU.pathC (arrow v.1 v.1) (v.2 v.1) t (identity v.1)) ;
    iso : C.iso p.1 q.1 = (f.1,(g.1,endo Q (compose q p q g f)),g.1,endo P (compose p q p f g)) ;
  } ;
  cone-path (p : cone) (y : C.ob) (e : Id C.ob p.1 y) :
    (s : legs y) -> Id (legs p.1) (pull p.1 y (C.idtoiso p.1 y e).1 s) p.2 -> Id cone p (y,s) =
    idJ C.ob p.1 (\ z r -> (s : legs z) -> Id (legs p.1) (pull p.1 z (C.idtoiso p.1 z r).1 s) p.2 -> Id cone p (z,s))
      (\ s k -> apH (\ t -> (p.1,t)) (transH (symH k) (unit (p.1,s)))) y e ;
  unique (ua : C.univalent) (P Q : product) : Id product P Q =
    Sigma-eq cone universal _ _ _ _ (cone-path P.1 Q.1.1 ((ua P.1.1 Q.1.1).sec Compare[P,Q].iso) Q.1.2
      (transH (apH (\ i -> pull P.1.1 Q.1.1 i.1 Q.1.2) ((ua P.1.1 Q.1.1).sec-eq Compare[P,Q].iso))
        Compare[P,Q].f.2)) (universal-prop Q.1) ;
} ;

-- For an ordinary precategory the compatibility of each arrow is a proposition.
module ConeCategory (C : Category[o,h].Precategory) (A B : C.ob) {
  module P = Binary[WildCategory[o,h].forget C,A,B] ;
  module K = Category[o \/ h,h] ; module L = Prelude[h] ;
  legs-set (x : C.ob) : L.isSet (P.legs x) = L.isSet-Sigma (C.hom x A) (\ f -> C.hom x B) (C.hom-set x A) (\ f -> C.hom-set x B) ;
  condition (u v : P.cone) (f : C.hom u.1 v.1) : U h = Id (P.legs u.1) (P.pull u.1 v.1 f v.2) u.2 ;
  set (u v : P.cone) : L.isSet (P.arrow u v) = L.isSet-Sigma (C.hom u.1 v.1) (condition u v) (C.hom-set u.1 v.1)
    (\ f -> L.prop-to-set _ (legs-set u.1 _ _)) ;
  ext (u v : P.cone) (f g : P.arrow u v) (q : Id (C.hom u.1 v.1) f.1 g.1) : Id (P.arrow u v) f g =
    L.Sigma-eq (C.hom u.1 v.1) (condition u v) _ _ _ _ q (legs-set u.1 _ _) ;
  pre : K.Precategory = new K.Precategory[P.cone,P.arrow,set,P.identity,\ u v w g f -> P.compose u v w f g,
    \ u v f -> ext u v _ f (C.unit-l _ _ f.1),\ u v f -> ext u v _ f (C.unit-r _ _ f.1),
    \ t u v w f g k -> ext t w _ _ (C.assoc _ _ _ _ f.1 g.1 k.1)] ;
  module W = WildCategory[o \/ h,h] ; module E = W.Extremal[W.forget pre] ;
  terminal (v : P.cone) : Equiv (P.universal v) (E.terminal v) = idEquiv (P.universal v) ;
} ;
-- Comparison with the book's two triangle equations in its stated orientation.
module PairPaths (A B : U h) (x : A * B) {
  split-path (y : A * B) (e : Id (A * B) y x) : Id A x.1 y.1 * Id B x.2 y.2 =
    (apH (\ v -> v.1) (symH e),apH (\ v -> v.2) (symH e)) ;
  join (a : A) (p : Id A x.1 a) (b : B) (q : Id B x.2 b) : Id (A * B) (a,b) x =
    idJ A x.1 (\ a1 t -> (b1 : B) (q1 : Id B x.2 b1) -> Id (A * B) (a1,b1) x)
      (\ b1 q1 -> idJ B x.2 (\ b2 t -> Id (A * B) (x.1,b2) x) (refl x) b1 q1) a p b q ;
  sec (a : A) (p : Id A x.1 a) (b : B) (q : Id B x.2 b) :
    Id (Id A x.1 a * Id B x.2 b) (split-path (a,b) (join a p b q)) (p,q) =
    idJ A x.1 (\ w r -> (b1 : B) (q1 : Id B x.2 b1) -> Id (Id A x.1 w * Id B x.2 b1) (split-path (w,b1) (join w r b1 q1)) (r,q1))
      (\ b1 q1 -> idJ B x.2 (\ z t -> Id (Id A x.1 x.1 * Id B x.2 z) (split-path (x.1,z) (join x.1 (refl x.1) z t)) (refl x.1,t))
        (refl (refl x.1,refl x.2)) b1 q1) a p b q ;
  back (y : A * B) (s : Id A x.1 y.1 * Id B x.2 y.2) : Id (A * B) y x = join y.1 s.1 y.2 s.2 ;
  ret (y : A * B) (e : Id (A * B) y x) : Id (Id (A * B) y x) (back y (split-path y e)) e =
    Paths[h].idJR (A * B) x (\ z q -> Id (Id (A * B) z x) (back z (split-path z q)) q) (refl (refl x)) y e ;
} ;
module Book (C : WildCategory[o,h].Wild) (A B : C.ob) {
  module P = Binary[C,A,B] ;
  module Between (u v : P.cone) {
    module Q = PairPaths[C.hom u.1 A,C.hom u.1 B,u.2] ;
    eqs (f : C.hom u.1 v.1) : U h = Id (C.hom u.1 A) u.2.1 (C.comp _ _ _ v.2.1 f) * Id (C.hom u.1 B) u.2.2 (C.comp _ _ _ v.2.2 f) ;
    mediators : U h = (f : C.hom u.1 v.1) * eqs f ;
    to (w : P.arrow u v) : mediators = (w.1,Q.split-path (P.pull _ _ w.1 v.2) w.2) ;
    from (w : mediators) : P.arrow u v = (w.1,Q.back (P.pull _ _ w.1 v.2) w.2) ;
    eq (w : mediators) : Id mediators (to (from w)) w = ap (eqs w.1) mediators (\ t -> (w.1,t)) _ _
      (Q.sec _ w.2.1 _ w.2.2) ;
    ret (w : P.arrow u v) : Id (P.arrow u v) (from (to w)) w =
      ap (Id (P.legs u.1) (P.pull _ _ w.1 v.2) u.2) (P.arrow u v) (\ t -> (w.1,t)) _ _ (Q.ret _ w.2) ;
  } ;
  universal (v : P.cone) : U (o \/ h) = (u : P.cone) -> FU.isContr Between[u,v].mediators ;
  to (v : P.cone) (k : P.universal v) : universal v = \ u -> (Between[u,v].to (k u).1,\ f ->
    transH (apH Between[u,v].to ((k u).2 (Between[u,v].from f))) (Between[u,v].eq f)) ;
  from (v : P.cone) (k : universal v) : P.universal v = \ u -> (Between[u,v].from (k u).1,\ f ->
    transH (apH Between[u,v].from ((k u).2 (Between[u,v].to f))) (Between[u,v].ret f)) ;
  has-products : U (o \/ h) = (a b : C.ob) -> Binary[C,a,b].product ;
  transport (x y : C.ob) (e : Id C.ob x y) (a : C.ob) (f : C.hom x a) :
    Id (C.hom y a) (subst C.ob (\ z -> C.hom z a) x y e f) (C.comp _ _ _ f (C.idtoiso x y e).2.1.1) =
    idJ C.ob x (\ z q -> Id (C.hom z a) (subst C.ob (\ w -> C.hom w a) x z q f) (C.comp _ _ _ f (C.idtoiso x z q).2.1.1))
      (symH (C.unit-r _ _ f)) y e ;
} ;
