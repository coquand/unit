-- Sections 2.23.1-4. Search below a given witness, then descend through
-- mere existence using uniqueness of the least witness.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ;
open Logic[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
bottom (m : Nat) : Le zero m = (m,plus-zero m) ;
up (a b : Nat) (h : Le a b) : Le (suc a) (suc b) = (h.1,transH (plus-suc h.1 a) (apH (\ k -> suc k) h.2)) ;
down (a b : Nat) (h : Le (suc a) (suc b)) : Le a b = (h.1,suc-inj (transH (symH (plus-suc h.1 a)) h.2)) ;
empty (a : Nat) (h : Le (suc a) zero) : Empty = Integers[l].not-code _ _ (transH (symH (plus-suc h.1 a)) h.2) ;
antisym : (a b : Nat) -> Le a b -> Le b a -> Id Nat a b = split {
  zero -> split { zero -> \ p q -> refl zero ; suc b -> \ p q -> absurd _ (empty b q) } ;
  suc a | r -> split { zero -> \ p q -> absurd _ (empty a p) ; suc b -> \ p q -> apH (\ k -> suc k) (r b (down a b p) (down b a q)) } } ;
raise-dec (a b : Nat) : Dec (Le a b) -> Dec (Le (suc a) (suc b)) = split {
  yes h -> yes (up a b h) ; no h -> no (\ p -> h (down a b p)) } ;
decide : (a b : Nat) -> Dec (Le a b) = split { zero -> \ b -> yes (bottom b) ;
  suc a | r -> split { zero -> no (empty a) ; suc b -> raise-dec a b (r b) } } ;
lt (a b : Nat) : U l = Le (suc a) b ;
strict-dec (a b : Nat) : Dec (lt a b) = decide (suc a) b ;
least (P : Nat -> U l) (a : Nat) : U l = P a * ((b : Nat) -> P b -> Le a b) ;
answer (P : Nat -> U l) : U l = (a : Nat) * least P a ;
first (P : Nat -> U l) (p : P zero) : answer P = (zero,p,\ b q -> bottom b) ;
shift (P : Nat -> U l) (h : P zero -> Empty) (w : answer (\ b -> P (suc b))) :
  (b : Nat) -> P b -> Le (suc w.1) b = split { zero -> \ q -> absurd _ (h q) ; suc b -> \ q -> up w.1 b (w.2.2 b q) } ;
step (P : Nat -> U l) (k : (h : P zero -> Empty) -> answer (\ b -> P (suc b))) : Dec (P zero) -> answer P = split {
  yes p -> first P p ; no h -> (suc (k h).1,(k h).2.1,shift P h (k h)) } ;
search : (n : Nat) (P : Nat -> U l) (d : (m : Nat) -> Dec (P m)) -> P n -> answer P = split {
  zero -> \ P d p -> first P p ; suc n | r -> \ P d p -> step P (\ h -> r (\ b -> P (suc b)) (\ b -> d (suc b)) p) (d zero) } ;
module Minimum (P : Nat -> U l) (prop : (n : Nat) -> isProp (P n)) (d : (n : Nat) -> Dec (P n)) {
  law (a : Nat) : isProp (least P a) = isProp-Sigma (P a) (\ p -> (b : Nat) -> P b -> Le a b) (prop a)
    (\ p -> FL.isProp-Pi Nat (\ b -> P b -> Le a b) (\ b -> FL.isProp-Pi (P b) (\ q -> Le a b) (\ q -> le-prop a b))) ;
  unique (x y : answer P) : Id (answer P) x y = Sigma-eq Nat (least P) _ _ _ _
    (antisym x.1 y.1 (x.2.2 y.1 y.2.1) (y.2.2 x.1 x.2.1)) (law y.1) ;
  witnesses : U l = (n : Nat) * P n ;
  minimum : Truncation[l].Trunc[witnesses].carrier -> answer P = TruncationCombinators[l].rec witnesses @l (answer P)
    unique (\ w -> search w.1 P d w.2) ;
} ;
