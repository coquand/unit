-- Identify the multiplication by a generating symmetry of the finite cycle.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module B = Prelude[l+] ; module BP = Paths[l+] ; module LC = LoopConj[l+] ;
module CC = CycleComponents[l] ;
module Standard (n : Nat) {
  module F = CC.Finite[n] ; module C = F.Cyc ; module J = ChapterFour[l].Symmetries[C.group] ;
  u : CC.Perm = F.standard ; module I = CC.From[u].IdSystem ;
  open PermutationLoops[l].At[u] ;
  module S = FiniteCycles[l].Centralizer[n] ;
  label : Equiv J.carrier (Fin (suc n)) = Equivalences[l].compose _ _ _ encode S.symmetries ;
  rotation : S.aut = (FiniteCycles[l].rotation n,\ i -> refl (FiniteCycles[l].Standard[n].step (FiniteCycles[l].Standard[n].step i))) ;
  generator : J.carrier = encode.2.sec rotation ;
  evaluate (p : P) : Fin (suc n) = (I.tr u p).1.1 none ;
  start : Id (Fin (suc n)) (label.1 J.abstract.e) none =
    BP.apH evaluate (LC.conj-refl CC.Perm _ _ k) ;
  advance (x : J.carrier) : Id (Fin (suc n)) (label.1 (J.abstract.mul generator x)) (FiniteCycles[l].Standard[n].step (label.1 x)) =
    transH (BP.apH evaluate (based-mul generator x)) (transH (comp u u (based.1 x) u (based.1 generator) none)
      (ap S.aut (Fin (suc n)) (\ a -> a.1.1 (label.1 x)) _ _ (encode.2.sec-eq rotation))) ;
  module Hom = CyclicHom[l,l].Cyclic[n,J.abstract,generator,label,start,advance] ;
} ;
