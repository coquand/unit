-- Section 6.4. Commutative squares, the two projections and univalence.
level o h ; open Base ; open Prelude[o \/ h] ; open Paths[o \/ h] ;
module K = Category[o,h] ; module KA = Category[o \/ h,h] ; module Q = Prelude[h] ;
module On (C : K.Precategory) {
  module R = Arrows[o,h].Arrows[C] ;
  ob : U (o \/ h) = (x : C.ob) * (y : C.ob) * C.hom x y ;
  sides (x y : ob) : U h = C.hom x.1 y.1 * C.hom x.2.1 y.2.1 ;
  square (x y : ob) (s : sides x y) : U h = Id (C.hom x.1 y.2.1) (R.cmp y.2.2 s.1) (R.cmp s.2 x.2.2) ;
  hom (x y : ob) : U h = (s : sides x y) * square x y s ;
  equal (x y : ob) (f g : hom x y) (p : Id (C.hom x.1 y.1) f.1.1 g.1.1) (q : Id (C.hom x.2.1 y.2.1) f.1.2 g.1.2) : Id (hom x y) f g =
    Q.Sigma-eq (sides x y) (square x y) _ _ _ _
      (transH (ap (C.hom x.1 y.1) (sides x y) (\ t -> (t,f.1.2)) _ _ p) (ap (C.hom x.2.1 y.2.1) (sides x y) (\ t -> (g.1.1,t)) _ _ q)) (C.hom-set _ _ _ _) ;
  identity (x : ob) : hom x x = ((C.idn x.1,C.idn x.2.1),transH (R.unit-r x.2.2) (symH (R.unit-l x.2.2))) ;
  comp (x y z : ob) (g : hom y z) (f : hom x y) : hom x z = ((R.cmp g.1.1 f.1.1,R.cmp g.1.2 f.1.2),
    transH (R.assoc z.2.2 g.1.1 f.1.1) (transH (R.right g.2 f.1.1) (transH (symH (R.assoc g.1.2 y.2.2 f.1.1))
      (transH (R.left g.1.2 f.2) (R.assoc g.1.2 f.1.2 x.2.2))))) ;
  pre : KA.Precategory = new KA.Precategory[ob,hom,(\ x y -> Q.isSet-Sigma (sides x y) (square x y)
    (Q.isSet-Sigma _ (\ t -> C.hom x.2.1 y.2.1) (C.hom-set x.1 y.1) (\ t -> C.hom-set x.2.1 y.2.1)) (\ s -> Q.prop-to-set _ (C.hom-set _ _ _ _))),
    identity,comp,(\ x y f -> equal x y _ f (R.unit-l f.1.1) (R.unit-l f.1.2)),(\ x y f -> equal x y _ f (R.unit-r f.1.1) (R.unit-r f.1.2)),
    (\ w x y z f g k -> equal w z _ _ (R.assoc k.1.1 g.1.1 f.1.1) (R.assoc k.1.2 g.1.2 f.1.2))] ;
  module F = Functor[o \/ h,h,o,h] ;
  dom : F.Functor[pre,C] = new F.Functor[pre,C,\ x -> x.1,\ x y f -> f.1.1,\ x -> refl (C.idn x.1),\ x y z g f -> refl (R.cmp g.1.1 f.1.1)] ;
  cod : F.Functor[pre,C] = new F.Functor[pre,C,\ x -> x.2.1,\ x y f -> f.1.2,\ x -> refl (C.idn x.2.1),\ x y z g f -> refl (R.cmp g.1.2 f.1.2)] ;
  module At (x : ob) {
    total : U (o \/ h) = KA.Singletons[pre].Singl x ;
    base : U (o \/ h) = K.Singletons[C].Singl x.1 * K.Singletons[C].Singl x.2.1 ;
    forget (v : total) : base = ((v.1.1,F.Maps[pre,C,dom].map-iso v.2),(v.1.2.1,F.Maps[pre,C,cod].map-iso v.2)) ;
    module Lift (s : base) {
      i : C.Iso x.1 s.1.1 = s.1.2 ; j : C.Iso x.2.1 s.2.1 = s.2.2 ;
      t : C.hom s.1.1 s.2.1 = R.cmp (R.cmp j.1 x.2.2) (R.inv i) ;
      target : ob = (s.1.1,s.2.1,t) ;
      f : hom x target = ((i.1,j.1),R.undo-r (R.cmp j.1 x.2.2) (R.iso-inv i)) ;
      g : hom target x = ((R.inv i,R.inv j),R.square-inv i j f.2) ;
      iso : pre.Iso x target = (f,g,equal x x _ _ (R.inv-arr i) (R.inv-arr j),equal target target _ _ (R.arr-inv i) (R.arr-inv j)) ;
      point : total = (target,iso) ;
      lift (k : C.hom s.1.1 s.2.1) (p : Id (C.hom s.1.1 s.2.1) t k) :
        (e : pre.Iso x (s.1.1,s.2.1,k)) -> Id (C.hom x.1 s.1.1) i.1 e.1.1.1 -> Id (C.hom x.2.1 s.2.1) j.1 e.1.1.2 -> Id total point ((s.1.1,s.2.1,k),e) =
        idJ (C.hom s.1.1 s.2.1) t (\ k q -> (e : pre.Iso x (s.1.1,s.2.1,k)) -> Id (C.hom x.1 s.1.1) i.1 e.1.1.1 ->
          Id (C.hom x.2.1 s.2.1) j.1 e.1.1.2 -> Id total point ((s.1.1,s.2.1,k),e))
          (\ e p q -> ap (pre.Iso x target) total (\ v -> (target,v)) iso e (Arrows[o \/ h,h].Arrows[pre].iso-eq iso e (equal x target f e.1 p q))) k p ;
    } ;
    make (s : base) : total = Lift[s].point ;
    ret (v : total) : Id total (make (forget v)) v = Lift[forget v].lift v.1.2.2
      (transH (R.right (symH v.2.1.2) (R.inv (forget v).1.2)) (R.undo-r v.1.2.2 (forget v).1.2)) v.2 (refl v.2.1.1.1) (refl v.2.1.1.2) ;
    prop (ua : K.Univalent C) : isProp total = retract-prop total base forget make ret (isProp-Sigma (K.Singletons[C].Singl x.1)
      (\ s -> K.Singletons[C].Singl x.2.1) (K.Objects[new K.Category[C,ua]].singl-prop x.1) (\ s -> K.Objects[new K.Category[C,ua]].singl-prop x.2.1)) ;
  } ;
  category (ua : K.Univalent C) : KA.Category = new KA.Category[pre,KA.FromTotal[pre,\ x -> At[x].prop ua].univalent] ;
} ;
