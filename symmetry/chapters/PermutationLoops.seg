-- Path composition in the small component of any permutation.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module B = Prelude[l+] ; module BP = Paths[l+] ; module LC = LoopConj[l+] ;
module CC = CycleComponents[l] ;
module At (u : CC.Perm) {
  module C = CC.Component[u] ; module J = ChapterFour[l].Symmetries[C.group] ;
  module I = CC.From[u].IdSystem ;
  P : U l+ = Id CC.Perm u u ;
  k : Id CC.Perm (C.show C.pt) u = C.C.path-at-point ;
  module Lift = PathTransport[l+].BasedLoops[C.space,C.pt,CC.Perm,u,C.show,k,C.C.image.embedding C.pt C.pt] ;
  image-loop (p : J.carrier) : Id CC.Perm (C.show C.pt) (C.show C.pt) = Lift.raw.1 p ;
  based : B.Equiv J.carrier P = Lift.loops ;
  encode : Equiv J.carrier (CC.From[u].Iso u) = Truncations[l].lower _ _ (Equivalences[l+].compose _ _ _ based (I.tr u,I.equiv u)) ;
  comp (x y : CC.Perm) (p : Id CC.Perm x y) (z : CC.Perm) (q : Id CC.Perm y z) (t : x.1.1) :
    Id z.1.1 ((CC.From[x].IdSystem.tr z (BP.transH p q)).1.1 t)
      ((CC.From[y].IdSystem.tr z q).1.1 ((CC.From[x].IdSystem.tr y p).1.1 t)) =
    idJ CC.Perm y (\ w r -> Id w.1.1 ((CC.From[x].IdSystem.tr w (BP.transH p r)).1.1 t)
      ((CC.From[y].IdSystem.tr w r).1.1 ((CC.From[x].IdSystem.tr y p).1.1 t))) (refl ((CC.From[x].IdSystem.tr y p).1.1 t)) z q ;
  based-mul (p q : J.carrier) : Id P (based.1 (J.abstract.mul p q)) (BP.transH (based.1 q) (based.1 p)) = Lift.compose q p ;
} ;
