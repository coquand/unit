-- Section 3.1. Dependent elimination by mapping to the total space and
-- identifying the composite with the first projection with the identity.
level u l ; constraint u <= l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module S = ChapterThree[u] ;
module End = CircleLarge[u,l].Mapping[S.Circle] ;
module Dependent (P : S.Circle -> U l) (b : P S.base)
  (over : Id (P S.base) (subst S.Circle P S.base S.base S.loop b) b) {
  total : U l = (x : S.Circle) * P x ;
  at-base : total = (S.base,b) ;
  edge : Id total at-base at-base = Sigma-path S.Circle P S.base S.base b b S.loop over ;
  fst (v : total) : S.Circle = v.1 ;
  edge-fst : Id (Id S.Circle S.base S.base) (ap total S.Circle fst at-base at-base edge) S.loop =
    Fibres[l].fst-Sigma-path S.Circle P S.base S.base b b S.loop over ;
  module Map = CircleLarge[u,l].Mapping[total] ;
  LY (Y : U l) : U l = (y : Y) * Id Y y y ;
  boundary : LY total = (at-base,edge) ;
  rec : S.Circle -> total = Map.E-equiv.sec boundary ;
  rec-beta : Id (LY total) (Map.E rec) boundary = Map.E-equiv.sec-eq boundary ;
  project (v : LY total) : LY S.Circle = (fst v.1,ap total S.Circle fst v.1 v.1 v.2) ;
  downstairs (x : S.Circle) : S.Circle = fst (rec x) ;
  identity (x : S.Circle) : S.Circle = x ;
  natural : Id (LY S.Circle) (End.E downstairs) (project (Map.E rec)) =
    ap (Id S.Circle (downstairs S.base) (downstairs S.base)) (LY S.Circle)
      (\ q -> (downstairs S.base,q)) _ _
      (symH (LoopCalc[l].ap-ap S.Circle total S.Circle rec fst S.base S.base S.loop)) ;
  same-data : Id (LY S.Circle) (End.E downstairs) (End.E identity) =
    transH natural (transH (apH project rec-beta)
      (apH (\ q -> (S.base,q)) (transH edge-fst (symH (Fibres[l].ap-id S.Circle S.base S.base S.loop))))) ;
  section-law : Id (S.Circle -> S.Circle) downstairs identity = Equivalences[l].injective
    (S.Circle -> S.Circle) (LY S.Circle) End.E End.E-equiv downstairs identity same-data ;
  ind (x : S.Circle) : P x = subst S.Circle P (downstairs x) x
    (happly S.Circle (\ z -> S.Circle) downstairs identity section-law x) (rec x).2 ;
} ;
