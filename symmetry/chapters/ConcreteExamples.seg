-- Binary products, the Klein four group, and naturality of evaluation.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ; module H = HLevels[l] ; module Big = Prelude[l+] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Binary (G K : CG.ConcreteGroup) {
  family : Bool -> CG.ConcreteGroup = split { false -> G ; true -> K } ;
  module P = FiniteSets[l].Products[Bool,SignOrderings[l].bool-finite,family] ;
  pair : U l = G.space * K.space ; base : pair = (G.point,K.point) ;
  compare : Equiv P.space pair = ElementaryTypes[l].Binary[\ b -> (family b).space].product ;
  group : CG.ConcreteGroup = new CG.ConcreteGroup[pair,base,Deloop[l].equiv-conn CG.two _ _
    (Bijection[l].inverse _ _ compare) P.group.connected,H.equiv-trunc' CG.three _ _ compare P.group.groupoid] ;
  identification : Id CG.ConcreteGroup P.group group = GroupIdentity[l].concrete-path P.group group ((compare.1,refl base),compare.2) ;
  first : CG.Hom group G = (\ v -> v.1,refl G.point) ;
  second : CG.Hom group K = (\ v -> v.2,refl K.point) ;
  module Loops {
    module S = CG.Symmetries[group] ;
    combine (a : G.space) (b : K.space) : Id G.space G.point a -> Id K.space K.point b -> Id pair base (a,b) = GroupIdentity[l].pairs G.space K.space G.point a K.point b ;
    eta (z : pair) (p : Id pair base z) : Id (Id pair base z)
      (combine z.1 z.2 (apH first.1 p) (apH second.1 p)) p =
      idJ pair base (\ v r -> Id (Id pair base v)
        (combine v.1 v.2 (ap pair G.space first.1 base v r) (ap pair K.space second.1 base v r)) r)
        (refl (refl base)) z p ;
    ext (p q : S.carrier)
      (h : Id (Id G.space G.point G.point) (apH first.1 p) (apH first.1 q))
      (k : Id (Id K.space K.point K.point) (apH second.1 p) (apH second.1 q)) : Id S.carrier p q =
      transH (symH (eta base p))
        (transH (apH (\ r -> combine G.point K.point r (apH second.1 p)) h)
          (transH (apH (combine G.point K.point (apH first.1 q)) k) (eta base q))) ;
  } ;
  include-first : CG.Hom G group = (\ x -> (x,K.point),refl base) ;
  include-second : CG.Hom K group = (\ y -> (G.point,y),refl base) ;
} ;
module TrivialMaps (G : CG.ConcreteGroup) {
  one : CG.ConcreteGroup = SignOrderings[l].trivial ;
  to : CG.Hom G one = (\ x -> tt,refl tt) ;
  from : CG.Hom one G = (\ t -> G.point,refl G.point) ;
  terminal : FunExtUA[l].isContr (CG.Hom G one) = (to,\ h -> Sigma-eq (G.space -> Top) (\ f -> Id Top (f G.point) tt) _ _ _ _
    (Axioms[l].FunExtLemmas[fe @l].funext G.space (\ x -> Top) to.1 h.1 (\ x -> isTop tt (h.1 x))) (prop-to-set Top isTop _ _)) ;
  module From (h : CG.Hom one G) {
    homotopy : (t : Top) -> Id G.space (h.1 t) G.point = split { tt -> h.2 } ;
    unique : Id (CG.Hom one G) h from = DeloopMaps[l].ptmap-path Top tt G.space G.point h.1 from.1 h.2 from.2 homotopy (refl h.2) ;
  } ;
  initial : FunExtUA[l].isContr (CG.Hom one G) = (from,\ h -> symH From[h].unique) ;
} ;
module Klein {
  module Two = BicycleGroups[l].TwoPermutations ; module K = Binary[Two.P.G.group,Two.P.G.group] ;
  module S = CG.Symmetries[K.group] ;
  module L = CG.Symmetries[Two.P.G.group] ; X : U l = Two.P.G.group.space ; o : X = Two.P.G.pt ;
  combine (x y : X) (p : Id X o x) (q : Id X o y) : Id K.pair K.base (x,y) = K.Loops.combine x y p q ;
  paths (z : K.pair) (r : Id K.pair K.base z) : Id (Id K.pair K.base z)
    (combine z.1 z.2 (apH (\ u -> u.1) r) (apH (\ u -> u.2) r)) r = K.Loops.eta z r ;
  square (p : S.carrier) : Id S.carrier (S.abstract.mul p p) S.abstract.e =
    K.Loops.ext (S.abstract.mul p p) S.abstract.e
      (transH (Groupoid[l].ap-trans K.pair X K.first.1 K.base K.base K.base p p) (Two.exponent-two (apH K.first.1 p)))
      (transH (Groupoid[l].ap-trans K.pair X K.second.1 K.base K.base K.base p p) (Two.exponent-two (apH K.second.1 p))) ;
  module C = CyclicGenerator[l].Standard[CG.three] ;
  gen : C.J.carrier = C.generator ;
  once : Id (FinChoice[l].Fin (suc CG.three)) (C.label.1 gen) (FiniteCycles[l].Standard[CG.three].step none) = transH (symH (apH C.label.1 (C.J.abstract.unitr gen)))
    (transH (C.advance C.J.abstract.e) (apH FiniteCycles[l].Standard[CG.three].step C.start)) ;
  twice : Id (FinChoice[l].Fin (suc CG.three)) (C.label.1 (C.J.abstract.mul gen gen)) (FiniteCycles[l].Standard[CG.three].step (FiniteCycles[l].Standard[CG.three].step none)) = transH (C.advance gen) (apH FiniteCycles[l].Standard[CG.three].step once) ;
  not-square (p : Id C.J.carrier (C.J.abstract.mul gen gen) C.J.abstract.e) : Empty =
    Cardinality[l].Option[FinChoice[l].Fin CG.three].apart (some none) (transH (symH twice) (transH (apH C.label.1 p) C.start)) ;
  exponent (G : CG.ConcreteGroup) : U l = (p : CG.Symmetries[G].carrier) -> Id (CG.Symmetries[G].carrier)
    (CG.Symmetries[G].abstract.mul p p) (CG.Symmetries[G].abstract.e) ;
  distinct (p : Id CG.ConcreteGroup K.group C.C.group) : Empty =
    not-square (Big.subst CG.ConcreteGroup (\ G -> exponent G) _ _ p square gen) ;
} ;
module Natural (G K : CG.ConcreteGroup) (f : CG.Hom G K) {
  module Z = ChapterThree[l] ; module C = CG ; module M = ChapterSeven[l].Homomorphisms[G,K] ;
  module E = CircleProperty[l].Circle[G.space] ; module D = CircleProperty[l].Circle[K.space] ;
  generators : Id (Id Z.Circle Z.base Z.base) D.g E.g = Equivalences[l].injective _ _ Z.winding.1 Z.winding.2 D.g E.g
    (transH (D.band-g (refl Z.base)) (symH (E.band-g (refl Z.base)))) ;
  evaluate (g : C.Hom C.integer-group G) : Id M.B.carrier ((C.integer-hom K).1 (C.compose C.integer-group G K f g))
    ((M.D.loop f).1 ((C.integer-hom G).1 g)) =
    transH (D.evPt-loop K.point (C.compose C.integer-group G K f g))
      (transH (apH (\ h -> h.1 D.g) (LoopCalc[l].loop-comp Z.Circle Z.base G.space G.point K.space K.point g f))
        (apH (M.D.loop f).1 (transH (apH (ChapterSeven[l].Homomorphisms[C.integer-group,G].D.loop g).1 generators) (symH (E.evPt-loop G.point g))))) ;
} ;

-- Apply a type constructor to the whole component of X using its small image.
module Extend (X : U l) (s : isSet X) (F : U l -> U l) (Y : U l) (t : isSet Y) (base : Id (U l) (F X) Y) {
  module A = CG.Symmetric[X,s] ; module K = CG.Symmetric[Y,t] ;
  lookup (z : A.group.space) : U l+ = (w : K.group.space) * Id (U l) (K.C.extension w) (F (A.C.extension z)) ;
  property (z : A.group.space) : Big.isProp (lookup z) = Groupoid[l+].emb-fib-prop K.group.space (U l) K.C.extension K.C.image.embedding (F (A.C.extension z)) ;
  at (v : Top) : lookup (A.C.quotient v) = (K.pt,Paths[l+].transH (K.C.triangle tt)
    (Paths[l+].symH (Paths[l+].transH (Paths[l+].apH F (A.C.triangle v)) base))) ;
  lift : (z : A.group.space) -> lookup z = (A.C.surjective @(l+) lookup property).sec at ;
  hom : CG.Hom A.group K.group = (\ z -> (lift z).1,Big.ap (lookup A.pt) K.group.space (\ w -> w.1) _ _ (property A.pt (lift A.pt) (at tt))) ;
} ;
module ExtendSets (X Y : U l) (s : isSet X) (t : isSet Y) {
  module S = ElementaryTypes[l].Either[X,Y] ;
  summands : (b : Bool) -> isSet (S.P b) = split { false -> s ; true -> t } ;
  sum-set : isSet (FiniteArithmetic[l].Sum X Y) = H.trunc-set _ (H.equiv-trunc CG.two _ _ S.sum
    (H.set-trunc _ (isSet-Sigma Bool S.P Z2[l].bool-set summands))) ;
  module Sum = Extend[X,s,\ A -> FiniteArithmetic[l].Sum A Y,FiniteArithmetic[l].Sum X Y,sum-set,refl (FiniteArithmetic[l].Sum X Y)] ;
  module Product = Extend[X,s,\ A -> A * Y,X * Y,isSet-Sigma X (\ x -> Y) s (\ x -> t),refl (X * Y)] ;
} ;

module ExtendFinite (m n : Nat) {
  module A = FiniteArithmetic[l] ; module FC = FiniteCounting[l] ; module F = FinChoice[l] ; module U0 = Axioms[l].UnivalenceLemmas[univ @l] ;
  X : U l = F.Fin m ; Y : U l = F.Fin n ;
  add : Nat = NatArith[l].plus m n ; mult : Nat = FC.times m n ;
  formula : Id Nat (FC.sum m (\ i -> n)) mult = FC.constant m n ;
  pairs : Equiv (F.Fin mult) (X * Y) = subst Nat (\ k -> Equiv (F.Fin k) (X * Y)) _ mult formula
    (FC.enumerate m (\ i -> n) (\ i -> Y) (\ i -> idEquiv Y)) ;
  module Sum = Extend[X,FiniteCycles[l].fin-set m,\ Z -> A.Sum Z Y,F.Fin add,FiniteCycles[l].fin-set add,
    U0.ua _ _ (Bijection[l].inverse _ _ (A.sum-fin m n))] ;
  module Product = Extend[X,FiniteCycles[l].fin-set m,\ Z -> Z * Y,F.Fin mult,FiniteCycles[l].fin-set mult,
    U0.ua _ _ (Bijection[l].inverse _ _ pairs)] ;
} ;

module BinaryFamily (I : U l) (labels : Equiv Bool I) (fin : FiniteSets[l].Finite I) (G : I -> CG.ConcreteGroup) {
  module P = FiniteSets[l].Products[I,fin,G] ;
  module Q = Binary[G (labels.1 false),G (labels.1 true)] ;
  sections (X : U l) (e : Equiv Bool X) : U l+ = (B : X -> U l) ->
    isEquiv ((i : X) -> B i) ((i : Bool) -> B (e.1 i)) (\ f i -> f (e.1 i)) ;
  restrict : sections I labels = Axioms[l].UnivalenceLemmas[univ @l].eqind Bool sections
    (\ B -> (idEquiv ((i : Bool) -> B i)).2) I labels ;
  identify : Equiv P.space Q.pair = Equivalences[l].compose _ _ _
    ((\ f i -> f (labels.1 i)),restrict (\ i -> (G i).space)) ElementaryTypes[l].Binary[\ b -> (G (labels.1 b)).space].product ;
  equality : Id CG.ConcreteGroup P.group Q.group = GroupIdentity[l].concrete-path P.group Q.group ((identify.1,refl Q.base),identify.2) ;
} ;
