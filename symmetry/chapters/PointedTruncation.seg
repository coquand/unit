-- Reflection of a connected pointed type into connected pointed groupoids.
level l ;
open Base ; open Prelude[l] ;
module CG = ChapterFour[l] ;
module E = Equivalences[l] ;
module R = ChapterTwo[l] ;
module Reflect (X : U l) (x : X) (c : Connected[l].isConn CG.two X) {
  module T = R.Truncate[CG.two,X] ;
  space : U l = T.carrier ;
  pt : space = T.unit x ;
  connected : Connected[l].isConn CG.two space = ConnectedMaps[l].conn-up CG.two X space T.unit
    (\ z -> Connected[l].conn-down CG.two (Whitehead[l].fib X space T.unit z) (T.op.conn X z)) c ;
  group : CG.ConcreteGroup = new CG.ConcreteGroup[space,pt,connected,T.op.trunc X] ;
  module Maps (H : CG.ConcreteGroup) {
    module S = T.Into[\ z -> H.space,\ z -> H.groupoid] ;
    unpointed : Equiv (space -> H.space) (X -> H.space) = (S.E.precomp,S.E.equiv) ;
    pointed : Equiv (CG.Hom group H) (Lemma4[l].PtMap X x H.space H.point) =
      R.change-base (space -> H.space) (X -> H.space) unpointed (\ f -> Id H.space (f x) H.point) ;
  } ;
} ;
