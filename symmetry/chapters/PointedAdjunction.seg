-- Section 2.21. Adjoin a base point and forget a chosen target point.
level u v ; open Base ; open Prelude[u \/ v] ; open Paths[u \/ v] ;
module FL = Axioms[u \/ v].FunExtLemmas[fe @(u \/ v)] ;
module Adjoin (A : U u) (B : U v) (b : B) {
  plus : U u = FinChoice[u].Opt A ;
  pointed : U (u \/ v) = (f : plus -> B) * Id B (f none) b ;
  restrict (w : pointed) (a : A) : B = w.1 (some a) ;
  extend (y : B) (f : A -> B) : plus -> B = split { none -> y ; some a -> f a } ;
  pack (f : A -> B) : pointed = (extend b f,refl b) ;
  module At (f : plus -> B) {
    same : (i : plus) -> Id B (extend (f none) (\ a -> f (some a)) i) (f i) =
      split { none -> refl (f none) ; some a -> refl (f (some a)) } ;
    eta (y : B) (p : Id B (f none) y) : Id ((g : plus -> B) * Id B (g none) y)
      (extend y (\ a -> f (some a)),refl y) (f,p) =
      idJ B (f none) (\ z q -> Id ((g : plus -> B) * Id B (g none) z)
        (extend z (\ a -> f (some a)),refl z) (f,q))
        (DeloopMaps[u \/ v].ptmap-path plus none B (f none) _ f (refl (f none)) (refl (f none)) same (refl (refl (f none)))) y p ;
  } ;
  adjunction : Equiv pointed (A -> B) = (restrict,qinv _ _ restrict pack (\ f -> refl f) (\ w -> At[w.1].eta b w.2)) ;
} ;
module FreeMaps (A : U u) (a : A) (B : U v) {
  total : U (u \/ v) = (b : B) * (f : A -> B) * Id B (f a) b ;
  forget (w : total) : A -> B = w.2.1 ;
  choose (f : A -> B) : total = (f a,f,refl (f a)) ;
  eta (f : A -> B) (b : B) (p : Id B (f a) b) : Id total (choose f) (b,f,p) =
    idJ B (f a) (\ y q -> Id total (choose f) (y,f,q)) (refl (choose f)) b p ;
  equivalence : Equiv total (A -> B) = (forget,qinv _ _ forget choose (\ f -> refl f) (\ w -> eta w.2.1 w.1 w.2.2)) ;
} ;
module Homotopies (A : U u) (a : A) (B : U v) (b : B) {
  M : U (u \/ v) = A -> B ; points (f : M) : U (u \/ v) = Id B (f a) b ;
  maps : U (u \/ v) = (f : M) * points f ;
  module From (f : maps) {
    H (g : M) : U (u \/ v) = (x : A) -> Id B (f.1 x) (g x) ;
    coh (g : maps) (h : H g.1) : U (u \/ v) = Id (points f.1) f.2 (transH (h a) g.2) ;
    pairs (g : maps) : U (u \/ v) = (h : H g.1) * coh g h ;
    moved (g : maps) (p : Id M f.1 g.1) : U (u \/ v) = Id (points g.1) (subst M points f.1 g.1 p f.2) g.2 ;
    at-refl (w : points f.1) : Equiv (Id (points f.1) f.2 w) (coh (f.1,w) (\ x -> refl (f.1 x))) =
      subst (points f.1) (\ t -> Equiv (Id (points f.1) f.2 w) (Id (points f.1) f.2 t)) w
        (transH (refl (f.1 a)) w) (symH (trans-refl-l B _ b w)) (idEquiv _) ;
    on-path (g : M) (p : Id M f.1 g) : (w : points g) -> Equiv (moved (g,w) p) (coh (g,w) (happly A (\ x -> B) f.1 g p)) =
      idJ M f.1 (\ k q -> (w : points k) -> Equiv (moved (k,w) q) (coh (k,w) (happly A (\ x -> B) f.1 k q))) at-refl g p ;
    equivalence (g : maps) : Equiv (Id maps f g) (pairs g) = Equivalences[u \/ v].compose _ _ _
      (ConnectedMaps[u \/ v].sigma-paths M points f g) (Equivalences[u \/ v].compose _ _ _
        (Fibres[u \/ v].sigma-equiv (Id M f.1 g.1) (moved g) (\ p -> coh g (happly A (\ x -> B) f.1 g.1 p))
          (\ p -> on-path g.1 p g.2))
        (ChapterTwo[u \/ v].change-base (Id M f.1 g.1) (H g.1)
          (happly A (\ x -> B) f.1 g.1,fe @(u \/ v) A (\ x -> B) f.1 g.1) (coh g))) ;
    by-induction (g : maps) (p : Id maps f g) : pairs g = idJ maps f (\ k q -> pairs k)
      ((\ x -> refl (f.1 x)),symH (trans-refl-l B _ b f.2)) g p ;
    total : U (u \/ v) = (g : maps) * pairs g ;
    based : FunExtUA[u \/ v].isContr total = HLevels[u \/ v].equiv-trunc' zero _ _
      (Fibres[u \/ v].sigma-equiv maps (\ g -> Id maps f g) pairs equivalence) (DeloopMaps[u \/ v].singL maps f) ;
    module FT = FundThm[u \/ v].FT[maps,f,pairs,by-induction f (refl f),based] ;
    agrees (g : maps) (p : Id maps f g) : Id (pairs g) (by-induction g p) (FT.tr g p) =
      idJ maps f (\ k q -> Id (pairs k) (by-induction k q) (FT.tr k q)) (refl (by-induction f (refl f))) g p ;
    induction-equiv (g : maps) : isEquiv (Id maps f g) (pairs g) (by-induction g) = Equivalences[u \/ v].homotopy _ _
      (FT.tr g,FT.equiv g) (by-induction g) (agrees g) ;
  } ;
} ;
