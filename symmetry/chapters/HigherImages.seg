-- Section 3.9. Fibrewise truncation followed by projection, with dependent
-- unique extension into truncated families over the image.
level u v ;
open Base ; open Prelude[u \/ v] ;
module FL = Axioms[u \/ v].FunExtLemmas[fe @(u \/ v)] ;
module W = Whitehead[u] ;
module Image (n : Nat) (A B : U u) (f : A -> B) {
  op : Truncations[u].TruncOp[suc n] = Truncations[u].TO n ;
  fibre (b : B) : U u = W.fib A B f b ;
  part (b : B) : U u = op.T (fibre b) ;
  space : U u = (b : B) * part b ;
  inclusion (w : space) : B = w.1 ;
  quotient (a : A) : space = (f a,op.unit (fibre (f a)) (a,refl (f a))) ;
  triangle (a : A) : Id B (inclusion (quotient a)) (f a) = refl (f a) ;
  truncated (b : B) : HLevels[u].isTrunc (suc n) (W.fib space B inclusion b) =
    HLevels[u].equiv-trunc (suc n) (W.fib space B inclusion b) (part b)
      ChapterTwo[u].Projection[B,part,b].equivalence (op.trunc (fibre b)) ;
  module Sections (P : space -> U v) (levelP : (w : space) -> HLevels[v].isTrunc (suc n) (P w)) {
    module Over (b : B) {
      module M = UniverseChange[u,v].Along[suc n,fibre b,part b,op.unit (fibre b),op.conn (fibre b),
        \ z -> P (b,z),\ z -> levelP (b,z)] ;
      module E = M.E ;
    } ;
    restrict (h : (w : space) -> P w) (a : A) : P (quotient a) = h (quotient a) ;
    move (h : (a : A) -> P (quotient a)) (a : A) (b : B) (p : Id B (f a) b) :
      P (b,op.unit (fibre b) (a,p)) =
      idJ B (f a) (\ z q -> P (z,op.unit (fibre z) (a,q))) (h a) b p ;
    extend (h : (a : A) -> P (quotient a)) (w : space) : P w =
      Over[w.1].E.ext (\ u -> move h u.1 w.1 u.2) w.2 ;
    beta (h : (a : A) -> P (quotient a)) : Id ((a : A) -> P (quotient a)) (restrict (extend h)) h =
      FL.funext A (\ a -> P (quotient a)) _ _ (\ a -> Over[f a].E.ext-beta (\ u -> move h u.1 (f a) u.2) (a,refl (f a))) ;
    agrees (h : (w : space) -> P w) (a : A) (b : B) (p : Id B (f a) b) :
      Id (P (b,op.unit (fibre b) (a,p))) (move (restrict h) a b p) (h (b,op.unit (fibre b) (a,p))) =
      idJ B (f a) (\ z q -> Id (P (z,op.unit (fibre z) (a,q))) (move (restrict h) a z q) (h (z,op.unit (fibre z) (a,q))))
        (refl (h (quotient a))) b p ;
    over-eta (h : (w : space) -> P w) (b : B) : Id ((z : part b) -> P (b,z))
      (\ z -> extend (restrict h) (b,z)) (\ z -> h (b,z)) =
      Over[b].E.unique _ _ (\ u -> trans (P (b,op.unit (fibre b) u)) _ _ _
        (Over[b].E.ext-beta (\ v -> move (restrict h) v.1 b v.2) u) (agrees h u.1 b u.2)) ;
    eta (h : (w : space) -> P w) : Id ((w : space) -> P w) (extend (restrict h)) h =
      FL.funext space (\ w -> P w) _ _ (\ w -> happly (part w.1) (\ z -> P (w.1,z)) _ _ (over-eta h w.1) w.2) ;
    universal : Equiv ((w : space) -> P w) ((a : A) -> P (quotient a)) = (restrict,qinv _ _ restrict extend beta eta) ;
  } ;
} ;
