-- Section 7.7. A second point of BG makes the concrete group into a heap.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module CG = ChapterFour[l] ;
module Big = Prelude[l+] ;
Heap : U l+ = (G : CG.ConcreteGroup) * G.space ;
underlying (H : Heap) : U l = Id H.1.space H.1.point H.2 ;
set (H : Heap) : isSet (underlying H) = HLevels[l].trunc-set _ (H.1.groupoid H.1.point H.2) ;
double (G : CG.ConcreteGroup) : Heap = (G,G.point) ;
move (G : CG.ConcreteGroup) (z : G.space) : CG.ConcreteGroup =
  new CG.ConcreteGroup[G.space,z,G.connected,G.groupoid] ;
swap (H : Heap) : Heap = (move H.1 H.2,H.1.point) ;
left : Big.Equiv Heap ((G : CG.ConcreteGroup) * G.space) = Big.idEquiv Heap ;
unswap : (G : CG.ConcreteGroup) (z : G.space) -> Id Heap (swap (swap (G,z))) (G,z) =
  split { ConcreteGroup X x c t -> \ z -> refl (new CG.ConcreteGroup[X,x,c,t],z) } ;
at-base : (G : CG.ConcreteGroup) -> Id CG.ConcreteGroup G (move G G.point) =
  split { ConcreteGroup X x c t -> refl (new CG.ConcreteGroup[X,x,c,t]) } ;
right : Big.Equiv Heap ((G : CG.ConcreteGroup) * G.space) = (swap,
  Big.qinv Heap Heap swap swap (\ H -> unswap H.1 H.2) (\ H -> unswap H.1 H.2)) ;
PointedHeap : U l+ = (H : Heap) * underlying H ;
embed (G : CG.ConcreteGroup) : PointedHeap = (double G,refl G.point) ;
contract (G : CG.ConcreteGroup) (x : G.space) (p : Id G.space G.point x) :
  Id PointedHeap (embed G) ((G,x),p) =
  idJ G.space G.point (\ y q -> Id PointedHeap (embed G) ((G,y),q)) (refl (embed G)) x p ;
pointed : Big.Equiv CG.ConcreteGroup PointedHeap = (embed,Big.qinv _ _ embed (\ v -> v.1.1)
  (\ v -> contract v.1.1 v.1.2 v.2) (\ G -> refl G)) ;
module Ends (H : Heap) {
  module T = Truncation[l+] ;
  equality : U l+ = Id CG.ConcreteGroup H.1 (swap H).1 ;
  same : T.Trunc[equality].carrier = TruncationCombinators[l].rec (underlying H) @(l+)
    T.Trunc[equality].carrier T.Trunc[equality].proposition
    (\ p -> T.Trunc[equality].inc (Paths[l+].transH (at-base H.1) (Big.ap H.1.space CG.ConcreteGroup (move H.1) H.1.point H.2 p)))
    ((H.1.connected.2 H.1.point H.2).1) ;
  ternary (p q r : underlying H) : underlying H = transH (transH r (symH q)) p ;
} ;
