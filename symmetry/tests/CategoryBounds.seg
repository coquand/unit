-- The Yoneda image is small at the join, even though presheaves are larger.
level o h ;
module C = Category[o,h] ;
objects (D : C.Precategory) : U (o \/ h+) = Presheaves[o,h].On[D].presheaf ;
arrows (D : C.Precategory) (F G : Presheaves[o,h].On[D].presheaf) : U (o \/ h) =
  Presheaves[o,h].On[D].hom F G ;
completion (D : C.Precategory) : U (o \/ h) = RezkCompletion[o,h,o,h].On[D].completion.pre.ob ;
presheaves-too-small (D : C.Precategory) : U (o \/ h) = Presheaves[o,h].On[D].presheaf ;
missing-object-level (D : C.Precategory) : U h = RezkCompletion[o,h,o,h].On[D].completion.pre.ob ;
missing-arrow-level (D : C.Precategory) : U o = RezkCompletion[o,h,o,h].On[D].completion.pre.ob ;
