-- The first nine declarations are positive controls. The last nine must fail.
level u v s ; open Base ;
action-bound (G : ChapterFour[u].ConcreteGroup) : U (u \/ v+) = ActionComparison[u,v].Classify[G].abstract ;
image-bound (n : Nat) (A B : U u) (f : A -> B) : U u = HigherImages[u,v].Image[n,A,B,f].space ;
finite-raise (X : U u) : FiniteSets[u].Finite X -> FiniteSets[u \/ v].Finite X =
  FiniteLevels[u,u \/ v].At[X].finite ;
root-presentation (n : Nat) (b : CycleRootFibres[u].Cycle) : U u = CycleRootFibres[u].Degree[n].Over[b].small ;
classifier-bound (A : U (u+ \/ v)) :
  Prelude[(u+ \/ v)+].Equiv SmallFamilyClassifier[u,u+ \/ v].Over[A].S.arrows (A -> U u) =
  SmallFamilyClassifier[u,u+ \/ v].Over[A].classifier ;
alternating-bound (n : Nat) : U u = SignOrderings[u].Alternating[n].group.space ;
bicycle-bound (q : BicycleSymmetries[u].Bicycle) : U u = BicycleSymmetries[u].Component[q].group.space ;
rezk-hom-presentation (C : Category[u,v].Precategory) (loc : (a b : C.ob) -> Replacement[s,v].Small (C.hom a b))
  (x y : RezkCompletion[u,v,u,v].On[C].completion.pre.ob) : U s = (RezkSmallness[s,u,v].On[C,loc].hom-small x y).1 ;
rezk-object-presentation (C : Category[u,v].Precategory) (loc : (a b : C.ob) -> Replacement[s,v].Small (C.hom a b))
  (ob : Replacement[s,u].Small C.ob) : U s = RezkSmallness[s,u,v].On[C,loc].Objects[ob].large-small.1 ;
rezk-forgot-presentation-level (C : Category[u,v].Precategory) (loc : (a b : C.ob) -> Replacement[s,v].Small (C.hom a b))
  (ob : Replacement[s,u].Small C.ob) : U u = RezkSmallness[s,u,v].On[C,loc].Objects[ob].large-small.1 ;
bicycle-ambient-too-small : U u = BicycleSymmetries[u].Bicycle ;
sign-classifier-too-small (n : Nat) : U u = SignOrderings[u].Component[n].large ;
classifier-unrelated (A : U v) :
  Prelude[v+].Equiv SmallFamilyClassifier[u,v].Over[A].S.arrows (A -> U u) =
  SmallFamilyClassifier[u,v].Over[A].classifier ;
root-fibre-too-small (n : Nat) (b : CycleRootFibres[u].Cycle) : U u = CycleRootFibres[u].Degree[n].Over[b].fibre ;
finite-unrelated (n : Nat) : Prelude[u \/ v].Equiv (FinChoice[u].Fin n) (FinChoice[v].Fin n) =
  FiniteLevels[u,v].standard n ;
missing-successor : U v = CircleBundles[v].Set ;
missing-join (G : ChapterFour[u].ConcreteGroup) (Y : CircleBundles[v].Set) : U v =
  ActionComparison[u,v].Classify[G].Fiber[Y].actions ;
missing-constraint (n : Nat) : ChapterTwo[u].Truncate[n,Top].carrier -> ChapterTwo[v].Truncate[n,Top].carrier =
  TruncationComparison[u,v].Compare[n,Top].up ;
