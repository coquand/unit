-- sag/categories: univalent categories as structured 1-types
-- (doc/univalent-categories.tex, DESIGN.md).  Same Theory segment as
-- sag/replacement: univalence and the two parts of replacement; function
-- extensionality is derived from univalence, as in sag/replacement.
import Base ;
import Prelude ;
import Paths ;
import Axioms ;
import FunExtUA ;
import Replacement ;

module Theory
  (univ : [l] Axioms[l].Univalence)
  (images : [l] [k] Replacement[l,k].Images)
  (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
  fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
  import Truncation ;
  import TruncationCombinators ;
  import EquivalenceLemmas ;
  import Category ;
  import Arrows ;
  import Functor ;
  import FunctorCat ;
  import PrecomposeFF ;
  import Descent ;
  import UniversalProperty ;
  import FunctorUnivalence ;
  import EquivObjects ;
  import SmallImage ;
  import CompletionUP ;
  import WildCategory ;
  import EquivProp ;
  import CategoryDuality ;
  import WildIsos ;
  import SliceCategory ;
  import ArrowCategory ;
  import FullSubcategory ;
  import WildFunctors ;
  import WildFunctorCategory ;
  import WildFunctorUnivalence ;
  import FunctorComposition ;
  import PathGroupoid ;
  import PathCore ;
  import ProductCones ;
  import CategoryOfTypes ;
  import RepresentableFunctors ;
  import CategoryMonos ;
  import CategoryOfSets ;
  import FundThm ;
  import CategorySIP ;
  import CategorySIPFamily ;
  import CategorySIPFixed ;
  import FullyFaithful ;
  import CategoryIdentity ;
  import GroupoidIdentity ;
  import Presheaves ;
  import RezkCompletion ;
  import FlaggedCategories ;
  import ChapterSix ;
  import Adjunctions ;
  import FamilyAdjunctions ;
  import SetFamilies ;
  import AdjointRepresentation ;
  import AdjointUniqueness ;
  import CategoricalEquivalences ;
  import EquivalenceCriteria ;
  import PrecompositionEquivalence ;
  import CategoryUnivalence ;
  import CategoryPreorders ;
} ;
