cabal-version:      2.4
name:               seg
version:            0.1.0.0
synopsis:           A dependent type theory checked in a context of unit
                    declarations: AUTOMATH/Wang segments as modules, the
                    BCDE universe system (levels, constraints, cumulative
                    Russell universes), glued conversion and a lock.
license:            MIT
author:             Thierry Coquand
build-type:         Simple

common basics
    default-language: Haskell2010
    ghc-options:      -Wall -Wno-incomplete-uni-patterns -Wno-name-shadowing

library
    import:           basics
    hs-source-dirs:   src
    exposed-modules:  Level, Seg, SegParse
    build-depends:    base, containers

executable seg
    import:           basics
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -rtsopts
    build-depends:    base, containers, directory, seg
