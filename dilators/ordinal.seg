-- ordinal.seg: cubicaltt/examples/ordinal.ctt rewritten for seg/primrec
-- (recursion only through eliminators, sequential scope).  From the JSL 89
-- paper of Stan Wainer: the slow growing hierarchy G collapses the Hardy
-- hierarchy H one level down.  Function extensionality is used only for
-- the last statement, as a module parameter.

level a ;

data Unit = tt ;
data N = zero | suc (n : N) ;

data ord = oz | os (n : ord) | ol (f : N -> ord) ;

data ord2 = tz | ts (n : ord2) | tl (f : N -> ord2) | tl2 (f : ord -> ord2) ;

ap (A B : U a) (f : A -> B) (x y : A) (p : Id A x y) : Id B (f x) (f y) =
  idJ A x (\ z q -> Id B (f x) (f z)) (refl (f x)) y p ;

trans (A : U a) (x y z : A) (p : Id A x y) (q : Id A y z) : Id A x z =
  idJ A y (\ w q' -> Id A x w) p z q ;

inj0 : N -> ord = split {
  zero -> oz ;
  suc n | r -> os r } ;

G1 : ord -> N -> N = split {
  oz -> \ x -> zero ;
  os z | r -> \ x -> suc (r x) ;
  ol f | r -> \ x -> r x x } ;

G2 : ord2 -> N -> ord = split {
  tz -> \ x -> oz ;
  ts z | r -> \ x -> os (r x) ;
  tl f | r -> \ x -> r x x ;
  tl2 f | r -> \ x -> ol (\ m -> r (inj0 m) x) } ;

-- the condition on the fundamental sequences of the Omega-limits
O2 (n : N) : ord2 -> U a = split {
  tz -> Unit ;
  ts z | r -> r ;
  tl f | r -> (p : N) -> r p ;
  tl2 f | r -> (x : ord) -> r x * Id ord (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) } ;

inj12 : ord -> ord2 = split {
  oz -> tz ;
  os z | r -> ts r ;
  ol f | r -> tl r } ;

H1 : ord -> N -> N = split {
  oz -> \ x -> x ;
  os z | r -> \ x -> r (suc x) ;
  ol f | r -> \ x -> r x x } ;

H2 : ord2 -> ord -> ord = split {
  tz -> \ x -> x ;
  ts z | r -> \ x -> r (os x) ;
  tl f | r -> \ x -> ol (\ m -> r m x) ;
  tl2 f | r -> \ x -> r x x } ;

collapsing (n : N)
  : (x : ord2) (y : ord) -> O2 n x -> Id N (G1 (H2 x y) n) (H1 (G2 x n) (G1 y n)) = split {
  tz -> \ y h -> refl (G1 y n) ;
  ts z | r -> \ y h -> r (os y) h ;
  tl f | r -> \ y h -> r n y (h n) ;
  tl2 f | r -> \ y h ->
    trans N (G1 (H2 (f y) y) n) (H1 (G2 (f y) n) (G1 y n))
            (H1 (G2 (f (inj0 (G1 y n))) n) (G1 y n))
      (r y y (h y).1)
      (ap ord N (\ o -> H1 o (G1 y n))
          (G2 (f y) n) (G2 (f (inj0 (G1 y n))) n) (h y).2) } ;

------------------------------------------------------------------------
-- an application

omega : ord = ol inj0 ;

omega1 : ord2 = tl2 inj12 ;

remO (n : N) : (x : ord) -> O2 n (inj12 x) = split {
  oz -> tt ;
  os z | r -> r ;
  ol f | r -> \ p -> r p } ;

remO1 (n : N) : (x : ord) -> Id ord (G2 (inj12 x) n) (G2 (inj12 (inj0 (G1 x n))) n) = split {
  oz -> refl oz ;
  os z | r -> ap ord ord (\ o -> os o) (G2 (inj12 z) n) (G2 (inj12 (inj0 (G1 z n))) n) r ;
  ol f | r -> r n } ;

lemOmega1 (n : N) : O2 n omega1 = \ x -> (remO n x, remO1 n x) ;

corr1 (n : N) : Id N (G1 (H2 omega1 omega) n) (H1 (G2 omega1 n) (G1 omega n)) =
  collapsing n omega1 omega (lemOmega1 n) ;

lem : (n p : N) -> Id N (G1 (inj0 n) p) n = split {
  zero -> \ p -> refl zero ;
  suc q | r -> \ p -> ap N N (\ k -> suc k) (G1 (inj0 q) p) q (r p) } ;

lem1 (n : N) : Id N (G1 omega n) n = lem n n ;

lem2 : (n p : N) -> Id ord (G2 (inj12 (inj0 n)) p) (inj0 n) = split {
  zero -> \ p -> refl oz ;
  suc q | r -> \ p -> ap ord ord (\ o -> os o) (G2 (inj12 (inj0 q)) p) (inj0 q) (r p) } ;

lem3 (n : N) : Id ord (G2 (inj12 (inj0 n)) n) (inj0 n) = lem2 n n ;

lem4 (n : N) : Id N (H1 (G2 omega1 n) n) (H1 omega n) =
  ap ord N (\ o -> H1 o n) (G2 (inj12 (inj0 n)) n) (inj0 n) (lem3 n) ;

------------------------------------------------------------------------
-- arithmetic on both kinds of trees, by recursion on the second argument;
-- limits, including the Omega-limits, are taken pointwise

sym (A : U a) (x y : A) (p : Id A x y) : Id A y x =
  idJ A x (\ z q -> Id A z x) (refl x) y p ;

addo (a0 : ord) : ord -> ord = split {
  oz -> a0 ;
  os b | r -> os r ;
  ol f | r -> ol r } ;

mulo (a0 : ord) : ord -> ord = split {
  oz -> oz ;
  os b | r -> addo r a0 ;
  ol f | r -> ol r } ;

expo (a0 : ord) : ord -> ord = split {
  oz -> os oz ;
  os b | r -> mulo a0 r ;
  ol f | r -> ol r } ;

add (a0 : ord2) : ord2 -> ord2 = split {
  tz -> a0 ;
  ts b | r -> ts r ;
  tl f | r -> tl r ;
  tl2 f | r -> tl2 r } ;

mul (a0 : ord2) : ord2 -> ord2 = split {
  tz -> tz ;
  ts b | r -> add r a0 ;
  tl f | r -> tl r ;
  tl2 f | r -> tl2 r } ;

exp (a0 : ord2) : ord2 -> ord2 = split {
  tz -> ts tz ;
  ts b | r -> mul a0 r ;
  tl f | r -> tl r ;
  tl2 f | r -> tl2 r } ;

-- epsilon_{Omega+1} = sup (Omega+1, Omega^(Omega+1), ...), and epsilon_0
tow : N -> ord2 = split {
  zero -> ts omega1 ;
  suc k | r -> exp omega1 r } ;

eps2 : ord2 = tl tow ;

towo : N -> ord = split {
  zero -> os omega ;
  suc k | r -> expo omega r } ;

e0 : ord = ol towo ;

-- the Howard ordinal, as Girard defines it (9.A: eta_0 = lambda_{eps_{Omega+1}}(omega))
eta0 : ord = H2 eps2 omega ;

-- the G1 and H1 hierarchies coincide: G1 (H2 omega1 omega) and H1 omega
-- are the same function (the only use of function extensionality)
module FE (funext : (A B : U a) (f g : A -> B) -> ((x : A) -> Id B (f x) (g x)) -> Id (A -> B) f g) {
  corr2 : Id (N -> N) (\ n -> G1 (H2 omega1 omega) n) (\ n -> H1 omega n) =
    funext N N (\ n -> G1 (H2 omega1 omega) n) (\ n -> H1 omega n)
      (\ n -> trans N (G1 (H2 omega1 omega) n) (H1 (G2 omega1 n) n) (H1 omega n)
                (trans N (G1 (H2 omega1 omega) n) (H1 (G2 omega1 n) (G1 omega n)) (H1 (G2 omega1 n) n)
                   (corr1 n)
                   (ap N N (\ k -> H1 (G2 omega1 n) k) (G1 omega n) n (lem1 n)))
                (lem4 n)) ;

  -- G2 commutes with the arithmetic (funext under the Omega-limits)
  G2add (n : N) (a0 : ord2) : (b : ord2) -> Id ord (G2 (add a0 b) n) (addo (G2 a0 n) (G2 b n)) = split {
    tz -> refl (G2 a0 n) ;
    ts b | r -> ap ord ord (\ o -> os o) (G2 (add a0 b) n) (addo (G2 a0 n) (G2 b n)) r ;
    tl f | r -> r n ;
    tl2 f | r ->
      ap (N -> ord) ord (\ g -> ol g)
         (\ m -> G2 (add a0 (f (inj0 m))) n) (\ m -> addo (G2 a0 n) (G2 (f (inj0 m)) n))
         (funext N ord (\ m -> G2 (add a0 (f (inj0 m))) n) (\ m -> addo (G2 a0 n) (G2 (f (inj0 m)) n))
            (\ m -> r (inj0 m))) } ;

  G2mul (n : N) (a0 : ord2) : (b : ord2) -> Id ord (G2 (mul a0 b) n) (mulo (G2 a0 n) (G2 b n)) = split {
    tz -> refl oz ;
    ts b | r ->
      trans ord (G2 (add (mul a0 b) a0) n) (addo (G2 (mul a0 b) n) (G2 a0 n))
                (addo (mulo (G2 a0 n) (G2 b n)) (G2 a0 n))
        (G2add n (mul a0 b) a0)
        (ap ord ord (\ o -> addo o (G2 a0 n)) (G2 (mul a0 b) n) (mulo (G2 a0 n) (G2 b n)) r) ;
    tl f | r -> r n ;
    tl2 f | r ->
      ap (N -> ord) ord (\ g -> ol g)
         (\ m -> G2 (mul a0 (f (inj0 m))) n) (\ m -> mulo (G2 a0 n) (G2 (f (inj0 m)) n))
         (funext N ord (\ m -> G2 (mul a0 (f (inj0 m))) n) (\ m -> mulo (G2 a0 n) (G2 (f (inj0 m)) n))
            (\ m -> r (inj0 m))) } ;

  G2exp (n : N) (a0 : ord2) : (b : ord2) -> Id ord (G2 (exp a0 b) n) (expo (G2 a0 n) (G2 b n)) = split {
    tz -> refl (os oz) ;
    ts b | r ->
      trans ord (G2 (mul a0 (exp a0 b)) n) (mulo (G2 a0 n) (G2 (exp a0 b) n))
                (mulo (G2 a0 n) (expo (G2 a0 n) (G2 b n)))
        (G2mul n a0 (exp a0 b))
        (ap ord ord (\ o -> mulo (G2 a0 n) o) (G2 (exp a0 b) n) (expo (G2 a0 n) (G2 b n)) r) ;
    tl f | r -> r n ;
    tl2 f | r ->
      ap (N -> ord) ord (\ g -> ol g)
         (\ m -> G2 (exp a0 (f (inj0 m))) n) (\ m -> expo (G2 a0 n) (G2 (f (inj0 m)) n))
         (funext N ord (\ m -> G2 (exp a0 (f (inj0 m))) n) (\ m -> expo (G2 a0 n) (G2 (f (inj0 m)) n))
            (\ m -> r (inj0 m))) } ;

  -- the condition O2 is preserved by the arithmetic
  O2add (n : N) (a0 : ord2) (ha : O2 n a0) : (b : ord2) -> O2 n b -> O2 n (add a0 b) = split {
    tz -> \ hb -> ha ;
    ts b | r -> \ hb -> r hb ;
    tl f | r -> \ hb p -> r p (hb p) ;
    tl2 f | r -> \ hb x ->
      (r x (hb x).1,
       trans ord (G2 (add a0 (f x)) n) (addo (G2 a0 n) (G2 (f x) n))
                 (G2 (add a0 (f (inj0 (G1 x n)))) n)
         (G2add n a0 (f x))
         (trans ord (addo (G2 a0 n) (G2 (f x) n)) (addo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
                    (G2 (add a0 (f (inj0 (G1 x n)))) n)
            (ap ord ord (\ o -> addo (G2 a0 n) o) (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) (hb x).2)
            (sym ord (G2 (add a0 (f (inj0 (G1 x n)))) n) (addo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
               (G2add n a0 (f (inj0 (G1 x n))))))) } ;

  O2mul (n : N) (a0 : ord2) (ha : O2 n a0) : (b : ord2) -> O2 n b -> O2 n (mul a0 b) = split {
    tz -> \ hb -> tt ;
    ts b | r -> \ hb -> O2add n (mul a0 b) (r hb) a0 ha ;
    tl f | r -> \ hb p -> r p (hb p) ;
    tl2 f | r -> \ hb x ->
      (r x (hb x).1,
       trans ord (G2 (mul a0 (f x)) n) (mulo (G2 a0 n) (G2 (f x) n))
                 (G2 (mul a0 (f (inj0 (G1 x n)))) n)
         (G2mul n a0 (f x))
         (trans ord (mulo (G2 a0 n) (G2 (f x) n)) (mulo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
                    (G2 (mul a0 (f (inj0 (G1 x n)))) n)
            (ap ord ord (\ o -> mulo (G2 a0 n) o) (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) (hb x).2)
            (sym ord (G2 (mul a0 (f (inj0 (G1 x n)))) n) (mulo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
               (G2mul n a0 (f (inj0 (G1 x n))))))) } ;

  O2exp (n : N) (a0 : ord2) (ha : O2 n a0) : (b : ord2) -> O2 n b -> O2 n (exp a0 b) = split {
    tz -> \ hb -> tt ;
    ts b | r -> \ hb -> O2mul n a0 ha (exp a0 b) (r hb) ;
    tl f | r -> \ hb p -> r p (hb p) ;
    tl2 f | r -> \ hb x ->
      (r x (hb x).1,
       trans ord (G2 (exp a0 (f x)) n) (expo (G2 a0 n) (G2 (f x) n))
                 (G2 (exp a0 (f (inj0 (G1 x n)))) n)
         (G2exp n a0 (f x))
         (trans ord (expo (G2 a0 n) (G2 (f x) n)) (expo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
                    (G2 (exp a0 (f (inj0 (G1 x n)))) n)
            (ap ord ord (\ o -> expo (G2 a0 n) o) (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) (hb x).2)
            (sym ord (G2 (exp a0 (f (inj0 (G1 x n)))) n) (expo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
               (G2exp n a0 (f (inj0 (G1 x n))))))) } ;

  -- so O2 holds up to epsilon_{Omega+1}
  O2tow (n : N) : (k : N) -> O2 n (tow k) = split {
    zero -> lemOmega1 n ;
    suc k | r -> O2exp n omega1 (lemOmega1 n) (tow k) r } ;

  O2eps (n : N) : O2 n eps2 = \ p -> O2tow n p ;

  -- G2 collapses epsilon_{Omega+1} to epsilon_0
  G2omega1 (n : N) : Id ord (G2 omega1 n) omega =
    ap (N -> ord) ord (\ g -> ol g) (\ m -> G2 (inj12 (inj0 m)) n) (\ m -> inj0 m)
       (funext N ord (\ m -> G2 (inj12 (inj0 m)) n) (\ m -> inj0 m) (\ m -> lem2 m n)) ;

  G2tow (n : N) : (k : N) -> Id ord (G2 (tow k) n) (towo k) = split {
    zero -> ap ord ord (\ o -> os o) (G2 omega1 n) omega (G2omega1 n) ;
    suc k | r ->
      trans ord (G2 (exp omega1 (tow k)) n) (expo (G2 omega1 n) (G2 (tow k) n)) (expo omega (towo k))
        (G2exp n omega1 (tow k))
        (trans ord (expo (G2 omega1 n) (G2 (tow k) n)) (expo omega (G2 (tow k) n)) (expo omega (towo k))
           (ap ord ord (\ o -> expo o (G2 (tow k) n)) (G2 omega1 n) omega (G2omega1 n))
           (ap ord ord (\ o -> expo omega o) (G2 (tow k) n) (towo k) r)) } ;

  -- the hierarchy theorem: the slow growing hierarchy at eta_0 is the
  -- Hardy hierarchy at epsilon_0
  hier (n : N) : Id N (G1 eta0 n) (H1 e0 n) =
    trans N (G1 eta0 n) (H1 (G2 eps2 n) (G1 omega n)) (H1 e0 n)
      (collapsing n eps2 omega (O2eps n))
      (trans N (H1 (G2 eps2 n) (G1 omega n)) (H1 (G2 eps2 n) n) (H1 e0 n)
         (ap N N (\ k -> H1 (G2 eps2 n) k) (G1 omega n) n (lem1 n))
         (ap ord N (\ o -> H1 o n) (G2 (tow n) n) (towo n) (G2tow n n))) ;

  hierFun : Id (N -> N) (\ n -> G1 eta0 n) (\ n -> H1 e0 n) =
    funext N N (\ n -> G1 eta0 n) (\ n -> H1 e0 n) (\ n -> hier n) ;
} ;
