-- dilator.seg: pre-dilators on the category of finite ordinals with
-- strictly increasing maps (Girard, Proof Theory and Logical Complexity,
-- ch. 8), and the normal form theorem: every point has a least support,
-- and the corresponding point is in the trace.  Then the denotations of
-- D at a decidable linear order X, and their order (section (c)), and
-- well-foundedness (section (d)): accessibility, the dilators Id, 1,
-- D + E and D . E, and the trees of polynomial dilators (ordinal.seg).
-- Section (e): 2^X is well-founded, the pre-dilator 2^D and its trees, up
-- to epsilon_0 and the Howard ordinal.  Then morphisms (g), connected
-- components (f: 9.1.5-9.1.7, the restriction 8.3.6 and the splitting
-- along a cut) and kinds (h: 9.1.10-9.1.11).
--
-- A strictly increasing map [m] -> [n] (with [n] = {0, .., n-1}) is a word
-- over {o, i} of length n with m letters i: the characteristic function of
-- its image.  Every word is such a map, from [ones w] to [len w], so
-- composition and intersection (the pull-back of two injections) are
-- computed on words, and all the predicates are decidable.

level a ;

data Unit = tt ;
data Bool = false | true ;
data N = zero | suc (n : N) ;
data Wd = nil | o (w : Wd) | i (w : Wd) ;

------------------------------------------------------------------------
-- equality

ap (A B : U a) (f : A -> B) (x y : A) (p : Id A x y) : Id B (f x) (f y) =
  idJ A x (\ z q -> Id B (f x) (f z)) (refl (f x)) y p ;

trans (A : U a) (x y z : A) (p : Id A x y) (q : Id A y z) : Id A x z =
  idJ A y (\ w q' -> Id A x w) p z q ;

sym (A : U a) (x y : A) (p : Id A x y) : Id A y x =
  idJ A x (\ z q -> Id A z x) (refl x) y p ;

subst (A : U a) (F : A -> U a) (x y : A) (p : Id A x y) (u : F x) : F y =
  idJ A x (\ z q -> F z) u y p ;

ifU : Bool -> U a -> U a -> U a = split {
  false -> \ X Y -> Y ;
  true -> \ X Y -> X } ;

absurdB (A : U a) (h : Id Bool false true) : A =
  subst Bool (\ c -> ifU c A Unit) false true h tt ;

isZero : N -> Bool = split { zero -> true ; suc n -> false } ;

absurdN (A : U a) (m : N) (h : Id N zero (suc m)) : A =
  subst N (\ k -> ifU (isZero k) Unit A) zero (suc m) h tt ;

pred : N -> N = split { zero -> zero ; suc n -> n } ;

sucInj (m n : N) (h : Id N (suc m) (suc n)) : Id N m n = ap N N pred (suc m) (suc n) h ;

------------------------------------------------------------------------
-- booleans and numbers

andB : Bool -> Bool -> Bool = split {
  false -> \ b -> false ;
  true -> \ b -> b } ;

andB-l : (c d : Bool) -> Id Bool (andB c d) true -> Id Bool c true = split {
  false -> \ d h -> h ;
  true -> \ d h -> refl true } ;

andB-r : (c d : Bool) -> Id Bool (andB c d) true -> Id Bool d true = split {
  false -> \ d h -> absurdB (Id Bool d true) h ;
  true -> \ d h -> h } ;

ifW (A : U a) : Bool -> A -> A -> A = split {
  false -> \ x y -> y ;
  true -> \ x y -> x } ;

eqN : N -> N -> Bool = split {
  zero -> split { zero -> true ; suc n -> false } ;
  suc m | r -> split { zero -> false ; suc n -> r n } } ;

eqN-refl : (n : N) -> Id Bool (eqN n n) true = split {
  zero -> refl true ;
  suc n | r -> r } ;

eqN-sound : (m n : N) -> Id Bool (eqN m n) true -> Id N m n = split {
  zero -> split {
    zero -> \ h -> refl zero ;
    suc n -> \ h -> absurdB (Id N zero (suc n)) h } ;
  suc m | r -> split {
    zero -> \ h -> absurdB (Id N (suc m) zero) h ;
    suc n -> \ h -> ap N N (\ k -> suc k) m n (r n h) } } ;

------------------------------------------------------------------------
-- words

len : Wd -> N = split { nil -> zero ; o w | r -> suc r ; i w | r -> suc r } ;

ones : Wd -> N = split { nil -> zero ; o w | r -> r ; i w | r -> suc r } ;

idW : N -> Wd = split { zero -> nil ; suc n | r -> i r } ;

hd : Wd -> Bool = split { nil -> false ; o w -> false ; i w -> true } ;

tl : Wd -> Wd = split { nil -> nil ; o w -> w ; i w -> w } ;

cons (c : Bool) (w : Wd) : Wd = ifW Wd c (i w) (o w) ;

-- at w y: is y in the image of w ?
at : Wd -> N -> Bool = split {
  nil -> \ y -> false ;
  o w | r -> split { zero -> false ; suc y -> r y } ;
  i w | r -> split { zero -> true ; suc y -> r y } } ;

-- rank w y: the number of points of the image before y (the preimage of y)
rank : Wd -> N -> N = split {
  nil -> \ y -> zero ;
  o w | r -> split { zero -> zero ; suc y -> r y } ;
  i w | r -> split { zero -> zero ; suc y -> suc (r y) } } ;

-- intersection of two subsets of the same [p]
andW : Wd -> Wd -> Wd = split {
  nil -> \ b -> nil ;
  o w | r -> \ b -> o (r (tl b)) ;
  i w | r -> \ b -> cons (hd b) (r (tl b)) } ;

-- composition: compW v w = v . w  (w : [m] -> [n], v : [n] -> [p])
compW : Wd -> Wd -> Wd = split {
  nil -> \ w -> nil ;
  o v | r -> \ w -> o (r w) ;
  i v | r -> \ w -> cons (hd w) (r (tl w)) } ;

------------------------------------------------------------------------
-- lemmas on words

at-hd : (b : Wd) -> Id Bool (at b zero) (hd b) = split {
  nil -> refl false ; o w -> refl false ; i w -> refl true } ;

at-tl : (b : Wd) (y : N) -> Id Bool (at b (suc y)) (at (tl b) y) = split {
  nil -> \ y -> refl false ; o w -> \ y -> refl (at w y) ; i w -> \ y -> refl (at w y) } ;

at-cons0 : (c : Bool) (w : Wd) -> Id Bool (at (cons c w) zero) c = split {
  false -> \ w -> refl false ; true -> \ w -> refl true } ;

at-consS : (c : Bool) (w : Wd) (y : N) -> Id Bool (at (cons c w) (suc y)) (at w y) = split {
  false -> \ w y -> refl (at w y) ; true -> \ w y -> refl (at w y) } ;

len-cons : (c : Bool) (w : Wd) -> Id N (len (cons c w)) (suc (len w)) = split {
  false -> \ w -> refl (suc (len w)) ; true -> \ w -> refl (suc (len w)) } ;

len-idW : (n : N) -> Id N (len (idW n)) n = split {
  zero -> refl zero ;
  suc n | r -> ap N N (\ k -> suc k) (len (idW n)) n r } ;

len-and : (v b : Wd) -> Id N (len (andW v b)) (len v) = split {
  nil -> \ b -> refl zero ;
  o v | r -> \ b -> ap N N (\ k -> suc k) (len (andW v (tl b))) (len v) (r (tl b)) ;
  i v | r -> \ b -> trans N (len (cons (hd b) (andW v (tl b)))) (suc (len (andW v (tl b)))) (suc (len v))
                      (len-cons (hd b) (andW v (tl b)))
                      (ap N N (\ k -> suc k) (len (andW v (tl b))) (len v) (r (tl b))) } ;

len-comp : (v w : Wd) -> Id N (len (compW v w)) (len v) = split {
  nil -> \ w -> refl zero ;
  o v | r -> \ w -> ap N N (\ k -> suc k) (len (compW v w)) (len v) (r w) ;
  i v | r -> \ w -> trans N (len (cons (hd w) (compW v (tl w)))) (suc (len (compW v (tl w)))) (suc (len v))
                      (len-cons (hd w) (compW v (tl w)))
                      (ap N N (\ k -> suc k) (len (compW v (tl w))) (len v) (r (tl w))) } ;

-- membership in an intersection
at-and : (v : Wd) (y : N) (b : Wd) -> Id Bool (at (andW v b) y) (andB (at v y) (at b y)) = split {
  nil -> \ y b -> refl false ;
  o v | r -> split {
    zero -> \ b -> refl false ;
    suc y -> \ b -> trans Bool (at (andW v (tl b)) y) (andB (at v y) (at (tl b) y)) (andB (at v y) (at b (suc y)))
                       (r y (tl b))
                       (ap Bool Bool (\ c -> andB (at v y) c) (at (tl b) y) (at b (suc y))
                          (sym Bool (at b (suc y)) (at (tl b) y) (at-tl b y))) } ;
  i v | r -> split {
    zero -> \ b -> trans Bool (at (cons (hd b) (andW v (tl b))) zero) (hd b) (at b zero)
                     (at-cons0 (hd b) (andW v (tl b)))
                     (sym Bool (at b zero) (hd b) (at-hd b)) ;
    suc y -> \ b -> trans Bool (at (cons (hd b) (andW v (tl b))) (suc y)) (at (andW v (tl b)) y)
                       (andB (at v y) (at b (suc y)))
                       (at-consS (hd b) (andW v (tl b)) y)
                       (trans Bool (at (andW v (tl b)) y) (andB (at v y) (at (tl b) y)) (andB (at v y) (at b (suc y)))
                          (r y (tl b))
                          (ap Bool Bool (\ c -> andB (at v y) c) (at (tl b) y) (at b (suc y))
                             (sym Bool (at b (suc y)) (at (tl b) y) (at-tl b y)))) } } ;

-- membership in a composite: y is in the image of v . w iff y is in the
-- image of v and its preimage is in the image of w
at-comp : (v : Wd) (y : N) (w : Wd) -> Id Bool (at (compW v w) y) (andB (at v y) (at w (rank v y))) = split {
  nil -> \ y w -> refl false ;
  o v | r -> split {
    zero -> \ w -> refl false ;
    suc y -> \ w -> r y w } ;
  i v | r -> split {
    zero -> \ w -> trans Bool (at (cons (hd w) (compW v (tl w))) zero) (hd w) (at w zero)
                     (at-cons0 (hd w) (compW v (tl w)))
                     (sym Bool (at w zero) (hd w) (at-hd w)) ;
    suc y -> \ w -> trans Bool (at (cons (hd w) (compW v (tl w))) (suc y)) (at (compW v (tl w)) y)
                       (andB (at v y) (at w (suc (rank v y))))
                       (at-consS (hd w) (compW v (tl w)) y)
                       (trans Bool (at (compW v (tl w)) y) (andB (at v y) (at (tl w) (rank v y)))
                          (andB (at v y) (at w (suc (rank v y))))
                          (r y (tl w))
                          (ap Bool Bool (\ c -> andB (at v y) c) (at (tl w) (rank v y)) (at w (suc (rank v y)))
                             (sym Bool (at w (suc (rank v y))) (at (tl w) (rank v y)) (at-tl w (rank v y))))) } } ;

------------------------------------------------------------------------
-- inclusion of images

Le (u v : Wd) : U a = (y : N) -> Id Bool (at u y) true -> Id Bool (at v y) true ;

Le-refl (u : Wd) : Le u u = \ y h -> h ;

Le-trans (u v w : Wd) (p : Le u v) (q : Le v w) : Le u w = \ y h -> q y (p y h) ;

Le-and-l (v b : Wd) : Le (andW v b) v = \ y h ->
  andB-l (at v y) (at b y)
    (trans Bool (andB (at v y) (at b y)) (at (andW v b) y) true
       (sym Bool (at (andW v b) y) (andB (at v y) (at b y)) (at-and v y b)) h) ;

Le-and-r (v b : Wd) : Le (andW v b) b = \ y h ->
  andB-r (at v y) (at b y)
    (trans Bool (andB (at v y) (at b y)) (at (andW v b) y) true
       (sym Bool (at (andW v b) y) (andB (at v y) (at b y)) (at-and v y b)) h) ;

len-zero : (v : Wd) -> Id N (len v) zero -> Id Wd v nil = split {
  nil -> \ h -> refl nil ;
  o v -> \ h -> absurdN (Id Wd (o v) nil) (len v) (sym N (suc (len v)) zero h) ;
  i v -> \ h -> absurdN (Id Wd (i v) nil) (len v) (sym N (suc (len v)) zero h) } ;

-- two words of the same length with the same image are equal
wext : (u v : Wd) -> Id N (len u) (len v) -> Le u v -> Le v u -> Id Wd u v = split {
  nil -> \ v hl p q -> sym Wd v nil (len-zero v (sym N zero (len v) hl)) ;
  o u | r -> split {
    nil -> \ hl p q -> absurdN (Id Wd (o u) nil) (len u) (sym N (suc (len u)) zero hl) ;
    o v -> \ hl p q -> ap Wd Wd (\ w -> o w) u v
                         (r v (sucInj (len u) (len v) hl) (\ y h -> p (suc y) h) (\ y h -> q (suc y) h)) ;
    i v -> \ hl p q -> absurdB (Id Wd (o u) (i v)) (q zero (refl true)) } ;
  i u | r -> split {
    nil -> \ hl p q -> absurdN (Id Wd (i u) nil) (len u) (sym N (suc (len u)) zero hl) ;
    o v -> \ hl p q -> absurdB (Id Wd (i u) (o v)) (p zero (refl true)) ;
    i v -> \ hl p q -> ap Wd Wd (\ w -> i w) u v
                         (r v (sucInj (len u) (len v) hl) (\ y h -> p (suc y) h) (\ y h -> q (suc y) h)) } } ;

-- if v . w has the image of v (lengths matching), then w is the identity
fullH (s : Wd) (r : (w : Wd) -> Id N (len w) (ones s) -> Le s (compW s w) -> Id Wd w (idW (len w)))
  : (w : Wd) -> Id N (len w) (suc (ones s)) -> Le (i s) (compW (i s) w) -> Id Wd w (idW (len w)) = split {
  nil -> \ hl p -> absurdN (Id Wd nil nil) (ones s) hl ;
  o w -> \ hl p -> absurdB (Id Wd (o w) (idW (len (o w)))) (p zero (refl true)) ;
  i w -> \ hl p -> ap Wd Wd (\ u -> i u) w (idW (len w))
                     (r w (sucInj (len w) (ones s) hl) (\ y h -> p (suc y) h)) } ;

full : (s w : Wd) -> Id N (len w) (ones s) -> Le s (compW s w) -> Id Wd w (idW (len w)) = split {
  nil -> \ w hl p -> subst Wd (\ u -> Id Wd u (idW (len u))) nil w
                       (sym Wd w nil (len-zero w hl)) (refl nil) ;
  o s | r -> \ w hl p -> r w hl (\ y h -> p (suc y) h) ;
  i s | r -> \ w hl p -> fullH s r w hl p } ;

-- restrict w s: s seen inside the image of w, as a word of length ones w
restrict : Wd -> Wd -> Wd = split {
  nil -> \ s -> nil ;
  o w | r -> \ s -> r (tl s) ;
  i w | r -> \ s -> cons (hd s) (r (tl s)) } ;

len-restrict : (w s : Wd) -> Id N (len (restrict w s)) (ones w) = split {
  nil -> \ s -> refl zero ;
  o w | r -> \ s -> r (tl s) ;
  i w | r -> \ s -> trans N (len (cons (hd s) (restrict w (tl s)))) (suc (len (restrict w (tl s)))) (suc (ones w))
                      (len-cons (hd s) (restrict w (tl s)))
                      (ap N N (\ k -> suc k) (len (restrict w (tl s))) (ones w) (r (tl s))) } ;

comp-id : (w : Wd) -> Id Wd (compW w (idW (ones w))) w = split {
  nil -> refl nil ;
  o w | r -> ap Wd Wd (\ u -> o u) (compW w (idW (ones w))) w r ;
  i w | r -> ap Wd Wd (\ u -> i u) (compW w (idW (ones w))) w r } ;

-- if the image of s is inside the image of w, then s = w . restrict w s
restrict-comp : (w s : Wd) -> Id N (len s) (len w) -> Le s w -> Id Wd (compW w (restrict w s)) s = split {
  nil -> \ s hl p -> sym Wd s nil (len-zero s hl) ;
  o w | r -> split {
    nil -> \ hl p -> absurdN (Id Wd (compW (o w) (restrict (o w) nil)) nil) (len w) hl ;
    o s -> \ hl p -> ap Wd Wd (\ u -> o u) (compW w (restrict w s)) s
                       (r s (sucInj (len s) (len w) hl) (\ y h -> p (suc y) h)) ;
    i s -> \ hl p -> absurdB (Id Wd (compW (o w) (restrict (o w) (i s))) (i s)) (p zero (refl true)) } ;
  i w | r -> split {
    nil -> \ hl p -> absurdN (Id Wd (compW (i w) (restrict (i w) nil)) nil) (len w) hl ;
    o s -> \ hl p -> ap Wd Wd (\ u -> o u) (compW w (restrict w s)) s
                       (r s (sucInj (len s) (len w) hl) (\ y h -> p (suc y) h)) ;
    i s -> \ hl p -> ap Wd Wd (\ u -> i u) (compW w (restrict w s)) s
                       (r s (sucInj (len s) (len w) hl) (\ y h -> p (suc y) h)) } } ;

-- sel w z: the z-th point of the image of w (inverse of rank)
ltN : N -> N -> Bool = split {
  zero -> split { zero -> false ; suc n -> true } ;
  suc m | r -> split { zero -> false ; suc n -> r n } } ;

ltN-zero : (y : N) -> Id Bool (ltN y zero) false = split {
  zero -> refl false ; suc y -> refl false } ;

sel : Wd -> N -> N = split {
  nil -> \ z -> zero ;
  o w | r -> \ z -> suc (r z) ;
  i w | r -> split { zero -> zero ; suc z -> suc (r z) } } ;

sel-rank : (w : Wd) (y : N) -> Id Bool (at w y) true -> Id N (sel w (rank w y)) y = split {
  nil -> \ y h -> absurdB (Id N zero y) h ;
  o w | r -> split {
    zero -> \ h -> absurdB (Id N (sel (o w) zero) zero) h ;
    suc y -> \ h -> ap N N (\ k -> suc k) (sel w (rank w y)) y (r y h) } ;
  i w | r -> split {
    zero -> \ h -> refl zero ;
    suc y -> \ h -> ap N N (\ k -> suc k) (sel w (rank w y)) y (r y h) } } ;

at-sel : (w : Wd) (z : N) -> Id Bool (ltN z (ones w)) true -> Id Bool (at w (sel w z)) true = split {
  nil -> \ z h -> absurdB (Id Bool (at nil (sel nil z)) true)
                    (trans Bool false (ltN z zero) true
                       (sym Bool (ltN z zero) false (ltN-zero z)) h) ;
  o w | r -> \ z h -> r z h ;
  i w | r -> split {
    zero -> \ h -> refl true ;
    suc z -> \ h -> r z h } } ;

rank-sel : (w : Wd) (z : N) -> Id Bool (ltN z (ones w)) true -> Id N (rank w (sel w z)) z = split {
  nil -> \ z h -> absurdB (Id N zero z)
                    (trans Bool false (ltN z zero) true
                       (sym Bool (ltN z zero) false (ltN-zero z)) h) ;
  o w | r -> \ z h -> r z h ;
  i w | r -> split {
    zero -> \ h -> refl zero ;
    suc z -> \ h -> ap N N (\ k -> suc k) (rank w (sel w z)) z (r z h) } } ;

rank-lt : (w : Wd) (y : N) -> Id Bool (at w y) true -> Id Bool (ltN (rank w y) (ones w)) true = split {
  nil -> \ y h -> absurdB (Id Bool (ltN zero zero) true) h ;
  o w | r -> split {
    zero -> \ h -> absurdB (Id Bool (ltN zero (ones w)) true) h ;
    suc y -> \ h -> r y h } ;
  i w | r -> split {
    zero -> \ h -> refl true ;
    suc y -> \ h -> r y h } } ;

at-lt : (w : Wd) (y : N) -> Id Bool (at w y) true -> Id Bool (ltN y (len w)) true = split {
  nil -> \ y h -> absurdB (Id Bool (ltN y zero) true) h ;
  o w | r -> split {
    zero -> \ h -> refl true ;
    suc y -> \ h -> r y h } ;
  i w | r -> split {
    zero -> \ h -> refl true ;
    suc y -> \ h -> r y h } } ;

at-idW : (n y : N) -> Id Bool (ltN y n) true -> Id Bool (at (idW n) y) true = split {
  zero -> \ y h -> absurdB (Id Bool (at nil y) true)
                     (trans Bool false (ltN y zero) true (sym Bool (ltN y zero) false (ltN-zero y)) h) ;
  suc n | r -> split {
    zero -> \ h -> refl true ;
    suc y -> \ h -> r y h } } ;

------------------------------------------------------------------------
-- Hedberg: a type with decidable equality has unique identity proofs

data Empty = ;
data Or (A B : U a) : U a = inl (x : A) | inr (y : B) ;

absurdE (A : U a) : Empty -> A = split { } ;

module Hedberg (A : U a) (dec : (x y : A) -> Or (Id A x y) (Id A x y -> Empty)) {

  fd (x y : A) : Or (Id A x y) (Id A x y -> Empty) -> Id A x y -> Id A x y = split {
    inl q -> \ p -> q ;
    inr k -> \ p -> absurdE (Id A x y) (k p) } ;

  -- fd is constant
  fd-const (x y : A) : (d : Or (Id A x y) (Id A x y -> Empty)) (p q : Id A x y)
    -> Id (Id A x y) (fd x y d p) (fd x y d q) = split {
    inl q0 -> \ p q -> refl q0 ;
    inr k -> \ p q -> absurdE (Id (Id A x y) (fd x y (inr k) p) (fd x y (inr k) q)) (k p) } ;

  f (x y : A) (p : Id A x y) : Id A x y = fd x y (dec x y) p ;

  linv (x y : A) (r : Id A x y) : Id (Id A y y) (trans A y x y (sym A x y r) r) (refl y) =
    idJ A x (\ y' r' -> Id (Id A y' y') (trans A y' x y' (sym A x y' r') r') (refl y')) (refl (refl x)) y r ;

  -- every p is determined by f
  key (x y : A) (p : Id A x y) : Id (Id A x y) (trans A x x y (sym A x x (f x x (refl x))) (f x y p)) p =
    idJ A x (\ y' p' -> Id (Id A x y') (trans A x x y' (sym A x x (f x x (refl x))) (f x y' p')) p')
      (linv x x (f x x (refl x))) y p ;

  uip (x y : A) (p q : Id A x y) : Id (Id A x y) p q =
    trans (Id A x y) p (trans A x x y (sym A x x (f x x (refl x))) (f x y q)) q
      (trans (Id A x y) p (trans A x x y (sym A x x (f x x (refl x))) (f x y p))
                          (trans A x x y (sym A x x (f x x (refl x))) (f x y q))
         (sym (Id A x y) (trans A x x y (sym A x x (f x x (refl x))) (f x y p)) p (key x y p))
         (ap (Id A x y) (Id A x y) (\ t -> trans A x x y (sym A x x (f x x (refl x))) t)
            (f x y p) (f x y q) (fd-const x y (dec x y) p q)))
      (key x y q) ;
} ;

decB : (b c : Bool) -> Or (Id Bool b c) (Id Bool b c -> Empty) = split {
  false -> split {
    false -> inl (refl false) ;
    true -> inr (\ h -> absurdB Empty h) } ;
  true -> split {
    false -> inr (\ h -> absurdB Empty (sym Bool true false h)) ;
    true -> inl (refl true) } } ;

decSuc (m n : N) : Or (Id N m n) (Id N m n -> Empty) -> Or (Id N (suc m) (suc n)) (Id N (suc m) (suc n) -> Empty) = split {
  inl e -> inl (ap N N (\ k -> suc k) m n e) ;
  inr k -> inr (\ h -> k (sucInj m n h)) } ;

decN : (m n : N) -> Or (Id N m n) (Id N m n -> Empty) = split {
  zero -> split {
    zero -> inl (refl zero) ;
    suc n -> inr (\ h -> absurdN Empty n h) } ;
  suc m | r -> split {
    zero -> inr (\ h -> absurdN Empty m (sym N (suc m) zero h)) ;
    suc n -> decSuc m n (r n) } } ;

code : Wd -> N = split { nil -> zero ; o w -> suc zero ; i w -> suc (suc zero) } ;

decO (u v : Wd) : Or (Id Wd u v) (Id Wd u v -> Empty) -> Or (Id Wd (o u) (o v)) (Id Wd (o u) (o v) -> Empty) = split {
  inl e -> inl (ap Wd Wd (\ w -> o w) u v e) ;
  inr k -> inr (\ h -> k (ap Wd Wd tl (o u) (o v) h)) } ;

decI (u v : Wd) : Or (Id Wd u v) (Id Wd u v -> Empty) -> Or (Id Wd (i u) (i v)) (Id Wd (i u) (i v) -> Empty) = split {
  inl e -> inl (ap Wd Wd (\ w -> i w) u v e) ;
  inr k -> inr (\ h -> k (ap Wd Wd tl (i u) (i v) h)) } ;

decW : (u v : Wd) -> Or (Id Wd u v) (Id Wd u v -> Empty) = split {
  nil -> split {
    nil -> inl (refl nil) ;
    o v -> inr (\ h -> absurdN Empty zero (ap Wd N code nil (o v) h)) ;
    i v -> inr (\ h -> absurdN Empty (suc zero) (ap Wd N code nil (i v) h)) } ;
  o u | r -> split {
    nil -> inr (\ h -> absurdN Empty zero (ap Wd N code nil (o u) (sym Wd (o u) nil h))) ;
    o v -> decO u v (r v) ;
    i v -> inr (\ h -> absurdN Empty zero (sucInj zero (suc zero) (ap Wd N code (o u) (i v) h))) } ;
  i u | r -> split {
    nil -> inr (\ h -> absurdN Empty (suc zero) (ap Wd N code nil (i u) (sym Wd (i u) nil h))) ;
    o v -> inr (\ h -> absurdN Empty zero (sucInj zero (suc zero) (ap Wd N code (o v) (i u) (sym Wd (i u) (o v) h)))) ;
    i v -> decI u v (r v) } } ;

module HB = Hedberg[Bool, decB] ;
module HN = Hedberg[N, decN] ;
module HW = Hedberg[Wd, decW] ;

ap2 (A B C : U a) (f : A -> B -> C) (x x' : A) (y y' : B) (p : Id A x x') (q : Id B y y')
  : Id C (f x y) (f x' y') =
  trans C (f x y) (f x' y) (f x' y')
    (ap A C (\ u -> f u y) x x' p) (ap B C (\ v -> f x' v) y y' q) ;

-- equality of pairs whose second components are propositions (Sigma has eta)
pairEq (A : U a) (B : A -> U a) (pB : (x : A) (u v : B x) -> Id (B x) u v) (x : A) (u : B x)
  (y : A) (e : Id A x y) (v : B y) : Id ((z : A) * B z) (x, u) (y, v) =
  idJ A x (\ y' e' -> (v' : B y') -> Id ((z : A) * B z) (x, u) (y', v'))
    (\ v' -> ap (B x) ((z : A) * B z) (\ w -> (x, w)) u v' (pB x u v')) y e v ;

prodEq (A B : U a) (s t : A * B) (e1 : Id A s.1 t.1) (e2 : Id B s.2 t.2) : Id (A * B) s t =
  ap2 A B (A * B) (\ x y -> (x, y)) s.1 t.1 s.2 t.2 e1 e2 ;

ones-idW : (n : N) -> Id N (ones (idW n)) n = split {
  zero -> refl zero ;
  suc n | r -> ap N N (\ k -> suc k) (ones (idW n)) n r } ;

rank-idW : (m y : N) -> Id Bool (ltN y m) true -> Id N (rank (idW m) y) y = split {
  zero -> \ y h -> absurdB (Id N zero y)
                     (trans Bool false (ltN y zero) true (sym Bool (ltN y zero) false (ltN-zero y)) h) ;
  suc m | r -> split {
    zero -> \ h -> refl zero ;
    suc y -> \ h -> ap N N (\ k -> suc k) (rank (idW m) y) y (r y h) } } ;

------------------------------------------------------------------------
-- pre-dilators: functors on the finite ordinals with strictly increasing
-- maps that preserve pull-backs, i.e. intersections of images

module PreDil (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  -- the least support, computed (it does not need the proof that x is in D(p))
  module Sup (p x : N) {

    inIm (u : Wd) : Bool = at (D1 u) x ;

    -- g u is u if u is a support, and the identity otherwise
    g (u : Wd) : Wd = ifW Wd (andB (inIm u) (eqN (len u) p)) u (idW p) ;

    -- S k pre: the intersection of the g (pre w) for all words w of length k
    S : N -> (Wd -> Wd) -> Wd = split {
      zero -> \ pre -> g (pre nil) ;
      suc k | r -> \ pre -> andW (r (\ w -> pre (o w))) (r (\ w -> pre (i w))) } ;

    supp : Wd = S p (\ w -> w) ;
  } ;

  -- a point x of D(p)
  module Point (p x : N) (hx : Id Bool (at (D1 (idW p)) x) true) {

    open Sup[p, x] ;

    -- u : [k] -> [p] is a support of x when x is in the image of D(u)
    Supp (u : Wd) : U a = Id N (len u) p * Id Bool (inIm u) true ;

    supp-id : Supp (idW p) = (len-idW p, hx) ;

    -- supports are closed under intersection: this is where pull-backs are used
    supp-meet (u v : Wd) (hu : Supp u) (hv : Supp v) : Supp (andW u v) =
      (trans N (len (andW u v)) (len u) p (len-and u v) hu.1,
       trans Bool (inIm (andW u v)) (at (andW (D1 u) (D1 v)) x) true
         (ap Wd Bool (\ w -> at w x) (D1 (andW u v)) (andW (D1 u) (D1 v))
            (dmeet u v (trans N (len u) p (len v) hu.1 (sym N (len v) p hv.1))))
         (trans Bool (at (andW (D1 u) (D1 v)) x) (andB (inIm u) (inIm v)) true
            (at-and (D1 u) x (D1 v))
            (trans Bool (andB (inIm u) (inIm v)) (andB true (inIm v)) true
               (ap Bool Bool (\ c -> andB c (inIm v)) (inIm u) true hu.2)
               hv.2))) ;

    ifSupp (u : Wd) : (c : Bool) -> (Id Bool c true -> Supp u) -> Supp (idW p) -> Supp (ifW Wd c u (idW p)) = split {
      false -> \ h k -> k ;
      true -> \ h k -> h (refl true) } ;

    supp-g (u : Wd) : Supp (g u) =
      ifSupp u (andB (inIm u) (eqN (len u) p))
        (\ h -> (eqN-sound (len u) p (andB-r (inIm u) (eqN (len u) p) h),
                 andB-l (inIm u) (eqN (len u) p) h))
        supp-id ;

    g-fix (u : Wd) (hu : Supp u) : Id Wd (g u) u =
      subst Bool (\ c -> Id Wd (ifW Wd c u (idW p)) u) true (andB (inIm u) (eqN (len u) p))
        (sym Bool (andB (inIm u) (eqN (len u) p)) true
           (trans Bool (andB (inIm u) (eqN (len u) p)) (andB true (eqN (len u) p)) true
              (ap Bool Bool (\ c -> andB c (eqN (len u) p)) (inIm u) true hu.2)
              (subst N (\ k -> Id Bool (eqN k p) true) p (len u) (sym N (len u) p hu.1) (eqN-refl p))))
        (refl u) ;

    supp-S : (k : N) (pre : Wd -> Wd) -> Supp (S k pre) = split {
      zero -> \ pre -> supp-g (pre nil) ;
      suc k | r -> \ pre -> supp-meet (S k (\ w -> pre (o w))) (S k (\ w -> pre (i w)))
                              (r (\ w -> pre (o w))) (r (\ w -> pre (i w))) } ;

    S-lb : (w : Wd) (pre : Wd -> Wd) -> Le (S (len w) pre) (g (pre w)) = split {
      nil -> \ pre -> Le-refl (g (pre nil)) ;
      o w | r -> \ pre -> Le-trans (S (len (o w)) pre) (S (len w) (\ v -> pre (o v))) (g (pre (o w)))
                            (Le-and-l (S (len w) (\ v -> pre (o v))) (S (len w) (\ v -> pre (i v))))
                            (r (\ v -> pre (o v))) ;
      i w | r -> \ pre -> Le-trans (S (len (i w)) pre) (S (len w) (\ v -> pre (i v))) (g (pre (i w)))
                            (Le-and-r (S (len w) (\ v -> pre (o v))) (S (len w) (\ v -> pre (i v))))
                            (r (\ v -> pre (i v))) } ;

    -- the least support
    supp-supp : Supp supp = supp-S p (\ w -> w) ;

    supp-min (u : Wd) (hu : Supp u) : Le supp u =
      subst Wd (\ v -> Le supp v) (g u) u (g-fix u hu)
        (subst N (\ k -> Le (S k (\ w -> w)) (g u)) (len u) p hu.1 (S-lb u (\ w -> w))) ;

    supp-unique (s : Wd) (hs : Supp s) (ms : (u : Wd) -> Supp u -> Le s u) : Id Wd s supp =
      wext s supp (trans N (len s) p (len supp) hs.1 (sym N (len supp) p supp-supp.1))
        (ms supp supp-supp) (supp-min s hs) ;

    -- the point z of D(ones supp) with D(supp)(z) = x is in the trace:
    -- it is in the image of no proper strictly increasing map
    z : N = rank (D1 supp) x ;

    supp-comp (w : Wd) (hl : Id N (len w) (ones supp)) (hz : Id Bool (at (D1 w) z) true)
      : Supp (compW supp w) =
      (trans N (len (compW supp w)) (len supp) p (len-comp supp w) supp-supp.1,
       trans Bool (inIm (compW supp w)) (at (compW (D1 supp) (D1 w)) x) true
         (ap Wd Bool (\ v -> at v x) (D1 (compW supp w)) (compW (D1 supp) (D1 w))
            (dcomp supp w (sym N (len w) (ones supp) hl)))
         (trans Bool (at (compW (D1 supp) (D1 w)) x) (andB (inIm supp) (at (D1 w) z)) true
            (at-comp (D1 supp) x (D1 w))
            (trans Bool (andB (inIm supp) (at (D1 w) z)) (andB true (at (D1 w) z)) true
               (ap Bool Bool (\ c -> andB c (at (D1 w) z)) (inIm supp) true supp-supp.2)
               hz))) ;

    trace (w : Wd) (hl : Id N (len w) (ones supp)) (hz : Id Bool (at (D1 w) z) true)
      : Id Wd w (idW (len w)) =
      full supp w hl (supp-min (compW supp w) (supp-comp w hl hz)) ;

    -- uniqueness of the normal form: if x = D(w)(z') with w a support and
    -- z' in the trace, then w is the least support (and so z' = z)
    InTrace (w : Wd) : U a =
      (v : Wd) -> Id N (len v) (ones w) -> Id Bool (at (D1 v) (rank (D1 w) x)) true -> Id Wd v (idW (len v)) ;

    unique (w : Wd) (hw : Supp w) (tw : InTrace w) : Id Wd supp w =
      trans Wd supp (compW w (restrict w supp)) w
        (sym Wd (compW w (restrict w supp)) supp
           (restrict-comp w supp (trans N (len supp) p (len w) supp-supp.1 (sym N (len w) p hw.1)) (supp-min w hw)))
        (trans Wd (compW w (restrict w supp)) (compW w (idW (ones w))) w
           (ap Wd Wd (\ u -> compW w u) (restrict w supp) (idW (ones w))
              (trans Wd (restrict w supp) (idW (len (restrict w supp))) (idW (ones w))
                 (tw (restrict w supp) (len-restrict w supp)
                    (andB-r (at (D1 w) x) (at (D1 (restrict w supp)) (rank (D1 w) x))
                       (trans Bool (andB (at (D1 w) x) (at (D1 (restrict w supp)) (rank (D1 w) x)))
                                   (at (D1 (compW w (restrict w supp))) x) true
                          (sym Bool (at (D1 (compW w (restrict w supp))) x)
                                    (andB (at (D1 w) x) (at (D1 (restrict w supp)) (rank (D1 w) x)))
                             (trans Bool (at (D1 (compW w (restrict w supp))) x)
                                         (at (compW (D1 w) (D1 (restrict w supp))) x)
                                         (andB (at (D1 w) x) (at (D1 (restrict w supp)) (rank (D1 w) x)))
                                (ap Wd Bool (\ u -> at u x) (D1 (compW w (restrict w supp)))
                                    (compW (D1 w) (D1 (restrict w supp)))
                                    (dcomp w (restrict w supp)
                                       (sym N (len (restrict w supp)) (ones w) (len-restrict w supp))))
                                (at-comp (D1 w) x (D1 (restrict w supp)))))
                          (trans Bool (at (D1 (compW w (restrict w supp))) x) (inIm supp) true
                             (ap Wd Bool (\ u -> at (D1 u) x) (compW w (restrict w supp)) supp
                                (restrict-comp w supp (trans N (len supp) p (len w) supp-supp.1 (sym N (len w) p hw.1))
                                   (supp-min w hw)))
                             supp-supp.2))))
                 (ap N Wd (\ k -> idW k) (len (restrict w supp)) (ones w) (len-restrict w supp))))
           (comp-id w)) ;

    unique-z (w : Wd) (hw : Supp w) (tw : InTrace w) : Id N z (rank (D1 w) x) =
      ap Wd N (\ u -> rank (D1 u) x) supp w (unique w hw tw) ;
  } ;

  ----------------------------------------------------------------------
  -- the denotation form: D(p) is in bijection with the triples (w, z)
  -- with w : [n] -> [p] and z in the trace Tr(n)

  Pt (p : N) : U a = (x : N) * Id Bool (at (D1 (idW p)) x) true ;

  InTr (n z : N) : U a = (v : Wd) -> Id N (len v) n -> Id Bool (at (D1 v) z) true -> Id Wd v (idW n) ;

  hzOf (n z : N) (h : Id Bool (ltN z (D0 n)) true) : Id Bool (at (D1 (idW n)) z) true =
    subst Wd (\ u -> Id Bool (at u z) true) (idW (D0 n)) (D1 (idW n))
      (sym Wd (D1 (idW n)) (idW (D0 n)) (did n)) (at-idW (D0 n) z h) ;

  rkid (n z : N) (h : Id Bool (ltN z (D0 n)) true) : Id N (rank (D1 (idW n)) z) z =
    trans N (rank (D1 (idW n)) z) (rank (idW (D0 n)) z) z
      (ap Wd N (\ u -> rank u z) (D1 (idW n)) (idW (D0 n)) (did n)) (rank-idW (D0 n) z h) ;

  -- the trace is decidable: z is in Tr(n) iff its least support is the identity
  trace-supp (n z : N) (h : Id Bool (ltN z (D0 n)) true) (tr : InTr n z) : Id Wd Sup[n, z].supp (idW n) =
    Point[n, z, hzOf n z h].unique (idW n) (len-idW n, hzOf n z h)
      (\ v hl hv -> trans Wd v (idW n) (idW (len v))
         (tr v (trans N (len v) (ones (idW n)) n hl (ones-idW n))
            (subst N (\ k -> Id Bool (at (D1 v) k) true) (rank (D1 (idW n)) z) z (rkid n z h) hv))
         (ap N Wd (\ k -> idW k) n (len v) (sym N (len v) n (trans N (len v) (ones (idW n)) n hl (ones-idW n))))) ;

  supp-trace (n z : N) (h : Id Bool (ltN z (D0 n)) true) (e : Id Wd Sup[n, z].supp (idW n)) : InTr n z =
    \ v hl hv -> wext v (idW n) (trans N (len v) n (len (idW n)) hl (sym N (len (idW n)) n (len-idW n)))
      (\ y hy -> at-idW n y (subst N (\ k -> Id Bool (ltN y k) true) (len v) n hl (at-lt v y hy)))
      (subst Wd (\ u -> Le u v) Sup[n, z].supp (idW n) e (Point[n, z, hzOf n z h].supp-min v (hl, hv))) ;

  -- a denotation: a support w : [n] -> [p], a point z of D(n), and the
  -- (decidable) conditions; all the conditions are propositions
  T (p : N) (w : Wd) (z : N) : U a =
    Id N (len w) p * (Id Bool (ltN z (D0 (ones w))) true * Id Wd Sup[ones w, z].supp (idW (ones w))) ;

  Den (p : N) : U a = (w : Wd) * (z : N) * T p w z ;

  ltD (w : Wd) (z : N) (h : Id Bool (ltN z (D0 (ones w))) true) : Id Bool (ltN z (ones (D1 w))) true =
    subst N (\ k -> Id Bool (ltN z k) true) (D0 (ones w)) (ones (D1 w))
      (sym N (ones (D1 w)) (D0 (ones w)) (dones w)) h ;

  fwd-lt (p : N) (x : Pt p) : Id Bool (ltN Point[p, x.1, x.2].z (D0 (ones Sup[p, x.1].supp))) true =
    subst N (\ k -> Id Bool (ltN Point[p, x.1, x.2].z k) true)
      (ones (D1 Sup[p, x.1].supp)) (D0 (ones Sup[p, x.1].supp))
      (dones Sup[p, x.1].supp)
      (rank-lt (D1 Sup[p, x.1].supp) x.1 Point[p, x.1, x.2].supp-supp.2) ;

  fwd (p : N) (x : Pt p) : Den p =
    (Sup[p, x.1].supp,
     Point[p, x.1, x.2].z,
     Point[p, x.1, x.2].supp-supp.1,
     fwd-lt p x,
     trace-supp (ones Sup[p, x.1].supp) Point[p, x.1, x.2].z (fwd-lt p x)
       (\ v hl hz -> trans Wd v (idW (len v)) (idW (ones Sup[p, x.1].supp))
          (Point[p, x.1, x.2].trace v hl hz)
          (ap N Wd (\ k -> idW k) (len v) (ones Sup[p, x.1].supp) hl))) ;

  trD (p : N) (d : Den p) : InTr (ones d.1) d.2.1 = supp-trace (ones d.1) d.2.1 d.2.2.2.1 d.2.2.2.2 ;

  bwdx (p : N) (d : Den p) : N = sel (D1 d.1) d.2.1 ;

  bwd-at (p : N) (d : Den p) : Id Bool (at (D1 d.1) (bwdx p d)) true =
    at-sel (D1 d.1) d.2.1 (ltD d.1 d.2.1 d.2.2.2.1) ;

  bwd (p : N) (d : Den p) : Pt p =
    (bwdx p d,
     subst Wd (\ u -> Id Bool (at u (bwdx p d)) true) (idW (D0 p)) (D1 (idW p))
       (sym Wd (D1 (idW p)) (idW (D0 p)) (did p))
       (at-idW (D0 p) (bwdx p d)
          (subst N (\ k -> Id Bool (ltN (bwdx p d) k) true) (len (D1 d.1)) (D0 p)
             (trans N (len (D1 d.1)) (D0 (len d.1)) (D0 p) (dlen d.1)
                (ap N N D0 (len d.1) p d.2.2.1))
             (at-lt (D1 d.1) (bwdx p d) (bwd-at p d))))) ;

  -- the round trips on the data
  bwd-fwd (p : N) (x : Pt p) : Id N (bwd p (fwd p x)).1 x.1 =
    sel-rank (D1 Sup[p, x.1].supp) x.1 Point[p, x.1, x.2].supp-supp.2 ;

  fwd-bwd-w (p : N) (d : Den p) : Id Wd (fwd p (bwd p d)).1 d.1 =
    Point[p, (bwd p d).1, (bwd p d).2].unique d.1 (d.2.2.1, bwd-at p d)
      (\ v hl hz -> trans Wd v (idW (ones d.1)) (idW (len v))
         (trD p d v hl
            (subst N (\ k -> Id Bool (at (D1 v) k) true) (rank (D1 d.1) (bwdx p d)) d.2.1
               (rank-sel (D1 d.1) d.2.1 (ltD d.1 d.2.1 d.2.2.2.1)) hz))
         (ap N Wd (\ k -> idW k) (ones d.1) (len v) (sym N (len v) (ones d.1) hl))) ;

  fwd-bwd-z (p : N) (d : Den p) : Id N (fwd p (bwd p d)).2.1 d.2.1 =
    trans N (fwd p (bwd p d)).2.1 (rank (D1 d.1) (bwdx p d)) d.2.1
      (Point[p, (bwd p d).1, (bwd p d).2].unique-z d.1 (d.2.2.1, bwd-at p d)
         (\ v hl hz -> trans Wd v (idW (ones d.1)) (idW (len v))
            (trD p d v hl
               (subst N (\ k -> Id Bool (at (D1 v) k) true) (rank (D1 d.1) (bwdx p d)) d.2.1
                  (rank-sel (D1 d.1) d.2.1 (ltD d.1 d.2.1 d.2.2.2.1)) hz))
            (ap N Wd (\ k -> idW k) (ones d.1) (len v) (sym N (len v) (ones d.1) hl))))
      (rank-sel (D1 d.1) d.2.1 (ltD d.1 d.2.1 d.2.2.2.1)) ;

  -- the full round trips, by Hedberg (the conditions are propositions)
  propT (p : N) (w : Wd) (z : N) (t t' : T p w z) : Id (T p w z) t t' =
    prodEq (Id N (len w) p) (Id Bool (ltN z (D0 (ones w))) true * Id Wd Sup[ones w, z].supp (idW (ones w))) t t'
      (HN.uip (len w) p t.1 t'.1)
      (prodEq (Id Bool (ltN z (D0 (ones w))) true) (Id Wd Sup[ones w, z].supp (idW (ones w))) t.2 t'.2
         (HB.uip (ltN z (D0 (ones w))) true t.2.1 t'.2.1)
         (HW.uip Sup[ones w, z].supp (idW (ones w)) t.2.2 t'.2.2)) ;

  denEq (p : N) (w : Wd) (z : N) (t : T p w z) (w' : Wd) (e1 : Id Wd w w') (z' : N) (e2 : Id N z z')
    (t' : T p w' z') : Id (Den p) (w, (z, t)) (w', (z', t')) =
    idJ Wd w (\ w2 e -> (z2 : N) (e2' : Id N z z2) (t2 : T p w2 z2) -> Id (Den p) (w, (z, t)) (w2, (z2, t2)))
      (\ z2 e2' -> idJ N z (\ z3 e3 -> (t3 : T p w z3) -> Id (Den p) (w, (z, t)) (w, (z3, t3)))
         (\ t3 -> ap (T p w z) (Den p) (\ s -> (w, (z, s))) t t3 (propT p w z t t3)) z2 e2')
      w' e1 z' e2 t' ;

  bwd-fwd-full (p : N) (x : Pt p) : Id (Pt p) (bwd p (fwd p x)) x =
    pairEq N (\ y -> Id Bool (at (D1 (idW p)) y) true) (\ y u v -> HB.uip (at (D1 (idW p)) y) true u v)
      (bwd p (fwd p x)).1 (bwd p (fwd p x)).2 x.1 (bwd-fwd p x) x.2 ;

  fwd-bwd-full (p : N) (d : Den p) : Id (Den p) (fwd p (bwd p d)) d =
    denEq p (fwd p (bwd p d)).1 (fwd p (bwd p d)).2.1 (fwd p (bwd p d)).2.2 d.1 (fwd-bwd-w p d)
      d.2.1 (fwd-bwd-z p d) d.2.2 ;
} ;

------------------------------------------------------------------------
-- examples

-- the identity dilator
module DId = PreDil[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w)] ;

-- Id + 1: D(n) = n + 1, a new point on top; D(w) = w followed by i
sn : Wd -> Wd = split {
  nil -> i nil ;
  o w | r -> o r ;
  i w | r -> i r } ;

sn-len : (w : Wd) -> Id N (len (sn w)) (suc (len w)) = split {
  nil -> refl (suc zero) ;
  o w | r -> ap N N (\ k -> suc k) (len (sn w)) (suc (len w)) r ;
  i w | r -> ap N N (\ k -> suc k) (len (sn w)) (suc (len w)) r } ;

sn-ones : (w : Wd) -> Id N (ones (sn w)) (suc (ones w)) = split {
  nil -> refl (suc zero) ;
  o w | r -> r ;
  i w | r -> ap N N (\ k -> suc k) (ones (sn w)) (suc (ones w)) r } ;

sn-id : (n : N) -> Id Wd (sn (idW n)) (idW (suc n)) = split {
  zero -> refl (i nil) ;
  suc n | r -> ap Wd Wd (\ w -> i w) (sn (idW n)) (idW (suc n)) r } ;

sn-comp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (sn (compW v w)) (compW (sn v) (sn w)) = split {
  nil -> \ w h -> subst Wd (\ u -> Id Wd (i nil) (compW (i nil) (sn u))) nil w
                    (sym Wd w nil (len-zero w (sym N zero (len w) h))) (refl (i nil)) ;
  o v | r -> \ w h -> ap Wd Wd (\ u -> o u) (sn (compW v w)) (compW (sn v) (sn w)) (r w h) ;
  i v | r -> split {
    nil -> \ h -> absurdN (Id Wd (sn (compW (i v) nil)) (compW (sn (i v)) (sn nil))) (ones v)
                    (sym N (suc (ones v)) zero h) ;
    o w -> \ h -> ap Wd Wd (\ u -> o u) (sn (compW v w)) (compW (sn v) (sn w))
                    (r w (sucInj (ones v) (len w) h)) ;
    i w -> \ h -> ap Wd Wd (\ u -> i u) (sn (compW v w)) (compW (sn v) (sn w))
                    (r w (sucInj (ones v) (len w) h)) } } ;

sn-meet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (sn (andW v w)) (andW (sn v) (sn w)) = split {
  nil -> \ w h -> subst Wd (\ u -> Id Wd (i nil) (andW (i nil) (sn u))) nil w
                    (sym Wd w nil (len-zero w (sym N zero (len w) h))) (refl (i nil)) ;
  o v | r -> split {
    nil -> \ h -> absurdN (Id Wd (sn (andW (o v) nil)) (andW (sn (o v)) (sn nil))) (len v)
                    (sym N (suc (len v)) zero h) ;
    o w -> \ h -> ap Wd Wd (\ u -> o u) (sn (andW v w)) (andW (sn v) (sn w))
                    (r w (sucInj (len v) (len w) h)) ;
    i w -> \ h -> ap Wd Wd (\ u -> o u) (sn (andW v w)) (andW (sn v) (sn w))
                    (r w (sucInj (len v) (len w) h)) } ;
  i v | r -> split {
    nil -> \ h -> absurdN (Id Wd (sn (andW (i v) nil)) (andW (sn (i v)) (sn nil))) (len v)
                    (sym N (suc (len v)) zero h) ;
    o w -> \ h -> ap Wd Wd (\ u -> o u) (sn (andW v w)) (andW (sn v) (sn w))
                    (r w (sucInj (len v) (len w) h)) ;
    i w -> \ h -> ap Wd Wd (\ u -> i u) (sn (andW v w)) (andW (sn v) (sn w))
                    (r w (sucInj (len v) (len w) h)) } } ;

module DSuc = PreDil[\ n -> suc n, sn, sn-len, sn-ones, sn-id,
  sn-comp, sn-meet] ;

one : N = suc zero ;
two : N = suc one ;
three : N = suc two ;
four : N = suc three ;

-- in D(3) = 4 for Id + 1: the top point 3 has the empty support (it comes
-- from the trace point 0 of D(0)); the point 1 has the support {1}
#conv DSuc.Sup[three, three].supp = o (o (o nil)) ;
#conv DSuc.Point[three, three, refl true].z = zero ;
#conv DSuc.Sup[three, one].supp = o (i (o nil)) ;
#conv DSuc.Point[three, one, refl true].z = zero ;
#conv DId.Sup[three, two].supp = o (o (i nil)) ;

-- the denotation of the point 1 of D(3) for Id + 1: support {1}, trace point 0,
-- and back
#conv (DSuc.fwd three (one, refl true)).1 = o (i (o nil)) ;
#conv (DSuc.fwd three (one, refl true)).2.1 = zero ;
#conv (DSuc.bwd three (DSuc.fwd three (one, refl true))).1 = one ;

------------------------------------------------------------------------
-- the sum of two pre-dilators: D(n) + E(n), D(w) followed by E(w)

plus : N -> N -> N = split {
  zero -> \ n -> n ;
  suc m | r -> \ n -> suc (r n) } ;

app : Wd -> Wd -> Wd = split {
  nil -> \ v -> v ;
  o w | r -> \ v -> o (r v) ;
  i w | r -> \ v -> i (r v) } ;

len-app : (u v : Wd) -> Id N (len (app u v)) (plus (len u) (len v)) = split {
  nil -> \ v -> refl (len v) ;
  o u | r -> \ v -> ap N N (\ k -> suc k) (len (app u v)) (plus (len u) (len v)) (r v) ;
  i u | r -> \ v -> ap N N (\ k -> suc k) (len (app u v)) (plus (len u) (len v)) (r v) } ;

ones-app : (u v : Wd) -> Id N (ones (app u v)) (plus (ones u) (ones v)) = split {
  nil -> \ v -> refl (ones v) ;
  o u | r -> \ v -> r v ;
  i u | r -> \ v -> ap N N (\ k -> suc k) (ones (app u v)) (plus (ones u) (ones v)) (r v) } ;

idW-plus : (m n : N) -> Id Wd (idW (plus m n)) (app (idW m) (idW n)) = split {
  zero -> \ n -> refl (idW n) ;
  suc m | r -> \ n -> ap Wd Wd (\ w -> i w) (idW (plus m n)) (app (idW m) (idW n)) (r n) } ;

comp-app : (u v : Wd) -> Id N (ones u) (len v) -> (u' v' : Wd)
  -> Id Wd (compW (app u u') (app v v')) (app (compW u v) (compW u' v')) = split {
  nil -> \ v h u' v' -> subst Wd (\ c -> Id Wd (compW u' (app c v')) (compW u' v')) nil v
                          (sym Wd v nil (len-zero v (sym N zero (len v) h))) (refl (compW u' v')) ;
  o u | r -> \ v h u' v' -> ap Wd Wd (\ w -> o w) (compW (app u u') (app v v')) (app (compW u v) (compW u' v'))
                              (r v h u' v') ;
  i u | r -> split {
    nil -> \ h u' v' -> absurdN (Id Wd (compW (app (i u) u') (app nil v')) (app (compW (i u) nil) (compW u' v')))
                          (ones u) (sym N (suc (ones u)) zero h) ;
    o v -> \ h u' v' -> ap Wd Wd (\ w -> o w) (compW (app u u') (app v v')) (app (compW u v) (compW u' v'))
                          (r v (sucInj (ones u) (len v) h) u' v') ;
    i v -> \ h u' v' -> ap Wd Wd (\ w -> i w) (compW (app u u') (app v v')) (app (compW u v) (compW u' v'))
                          (r v (sucInj (ones u) (len v) h) u' v') } } ;

and-app : (u v : Wd) -> Id N (len u) (len v) -> (u' v' : Wd)
  -> Id Wd (andW (app u u') (app v v')) (app (andW u v) (andW u' v')) = split {
  nil -> \ v h u' v' -> subst Wd (\ c -> Id Wd (andW u' (app c v')) (andW u' v')) nil v
                          (sym Wd v nil (len-zero v (sym N zero (len v) h))) (refl (andW u' v')) ;
  o u | r -> split {
    nil -> \ h u' v' -> absurdN (Id Wd (andW (app (o u) u') (app nil v')) (app (andW (o u) nil) (andW u' v')))
                          (len u) (sym N (suc (len u)) zero h) ;
    o v -> \ h u' v' -> ap Wd Wd (\ w -> o w) (andW (app u u') (app v v')) (app (andW u v) (andW u' v'))
                          (r v (sucInj (len u) (len v) h) u' v') ;
    i v -> \ h u' v' -> ap Wd Wd (\ w -> o w) (andW (app u u') (app v v')) (app (andW u v) (andW u' v'))
                          (r v (sucInj (len u) (len v) h) u' v') } ;
  i u | r -> split {
    nil -> \ h u' v' -> absurdN (Id Wd (andW (app (i u) u') (app nil v')) (app (andW (i u) nil) (andW u' v')))
                          (len u) (sym N (suc (len u)) zero h) ;
    o v -> \ h u' v' -> ap Wd Wd (\ w -> o w) (andW (app u u') (app v v')) (app (andW u v) (andW u' v'))
                          (r v (sucInj (len u) (len v) h) u' v') ;
    i v -> \ h u' v' -> ap Wd Wd (\ w -> i w) (andW (app u u') (app v v')) (app (andW u v) (andW u' v'))
                          (r v (sucInj (len u) (len v) h) u' v') } } ;

module SumDil
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w))) {

  S0 (n : N) : N = plus (D0 n) (E0 n) ;

  S1 (w : Wd) : Wd = app (D1 w) (E1 w) ;

  slen (w : Wd) : Id N (len (S1 w)) (S0 (len w)) =
    trans N (len (S1 w)) (plus (len (D1 w)) (len (E1 w))) (S0 (len w))
      (len-app (D1 w) (E1 w))
      (ap2 N N N plus (len (D1 w)) (D0 (len w)) (len (E1 w)) (E0 (len w)) (dlen w) (elen w)) ;

  sones (w : Wd) : Id N (ones (S1 w)) (S0 (ones w)) =
    trans N (ones (S1 w)) (plus (ones (D1 w)) (ones (E1 w))) (S0 (ones w))
      (ones-app (D1 w) (E1 w))
      (ap2 N N N plus (ones (D1 w)) (D0 (ones w)) (ones (E1 w)) (E0 (ones w)) (dones w) (eones w)) ;

  sid (n : N) : Id Wd (S1 (idW n)) (idW (S0 n)) =
    trans Wd (S1 (idW n)) (app (idW (D0 n)) (idW (E0 n))) (idW (S0 n))
      (ap2 Wd Wd Wd app (D1 (idW n)) (idW (D0 n)) (E1 (idW n)) (idW (E0 n)) (did n) (eid n))
      (sym Wd (idW (S0 n)) (app (idW (D0 n)) (idW (E0 n))) (idW-plus (D0 n) (E0 n))) ;

  scomp (v w : Wd) (h : Id N (ones v) (len w)) : Id Wd (S1 (compW v w)) (compW (S1 v) (S1 w)) =
    trans Wd (S1 (compW v w)) (app (compW (D1 v) (D1 w)) (compW (E1 v) (E1 w))) (compW (S1 v) (S1 w))
      (ap2 Wd Wd Wd app (D1 (compW v w)) (compW (D1 v) (D1 w)) (E1 (compW v w)) (compW (E1 v) (E1 w))
         (dcomp v w h) (ecomp v w h))
      (sym Wd (compW (S1 v) (S1 w)) (app (compW (D1 v) (D1 w)) (compW (E1 v) (E1 w)))
         (comp-app (D1 v) (D1 w)
            (trans N (ones (D1 v)) (D0 (ones v)) (len (D1 w)) (dones v)
               (trans N (D0 (ones v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (ones v) (len w) h)
                  (sym N (len (D1 w)) (D0 (len w)) (dlen w))))
            (E1 v) (E1 w))) ;

  smeet (v w : Wd) (h : Id N (len v) (len w)) : Id Wd (S1 (andW v w)) (andW (S1 v) (S1 w)) =
    trans Wd (S1 (andW v w)) (app (andW (D1 v) (D1 w)) (andW (E1 v) (E1 w))) (andW (S1 v) (S1 w))
      (ap2 Wd Wd Wd app (D1 (andW v w)) (andW (D1 v) (D1 w)) (E1 (andW v w)) (andW (E1 v) (E1 w))
         (dmeet v w h) (emeet v w h))
      (sym Wd (andW (S1 v) (S1 w)) (app (andW (D1 v) (D1 w)) (andW (E1 v) (E1 w)))
         (and-app (D1 v) (D1 w)
            (trans N (len (D1 v)) (D0 (len v)) (len (D1 w)) (dlen v)
               (trans N (D0 (len v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (len v) (len w) h)
                  (sym N (len (D1 w)) (D0 (len w)) (dlen w))))
            (E1 v) (E1 w))) ;

  module P = PreDil[S0, S1, slen, sones, sid, scomp, smeet] ;
} ;

-- the constant pre-dilator 1
module K1 = PreDil[\ n -> one, \ w -> i nil, \ w -> refl one, \ w -> refl one,
  \ n -> refl (i nil), \ v w h -> refl (i nil), \ v w h -> refl (i nil)] ;

-- Id + 1 as a sum, and Id + Id
module IdPlus1 = SumDil[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w),
  \ n -> one, \ w -> i nil, \ w -> refl one, \ w -> refl one,
  \ n -> refl (i nil), \ v w h -> refl (i nil), \ v w h -> refl (i nil)] ;

module IdPlusId = SumDil[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w),
  \ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w)] ;

#conv IdPlus1.P.Sup[three, three].supp = o (o (o nil)) ;
#conv IdPlus1.P.Sup[three, one].supp = o (i (o nil)) ;
-- in D(3) = 6 for Id + Id: the points 1 and 4 have the same support {1},
-- with the two trace points 0 and 1 of D(1) = 2
#conv IdPlusId.P.Sup[three, one].supp = o (i (o nil)) ;
#conv IdPlusId.P.Sup[three, four].supp = o (i (o nil)) ;
#conv IdPlusId.P.Point[three, one, refl true].z = zero ;
#conv IdPlusId.P.Point[three, four, refl true].z = one ;

------------------------------------------------------------------------
-- the product of two pre-dilators: E(n) copies of D(n), the ordinal
-- product D(n).E(n); on maps the Kronecker product of the words

mul : N -> N -> N = split {
  zero -> \ n -> zero ;
  suc m | r -> \ n -> plus n (r n) } ;

zeros : N -> Wd = split { zero -> nil ; suc n | r -> o r } ;

kron : Wd -> Wd -> Wd = split {
  nil -> \ d -> nil ;
  o e | r -> \ d -> app (zeros (len d)) (r d) ;
  i e | r -> \ d -> app d (r d) } ;

len-zeros : (n : N) -> Id N (len (zeros n)) n = split {
  zero -> refl zero ;
  suc n | r -> ap N N (\ k -> suc k) (len (zeros n)) n r } ;

ones-zeros : (n : N) -> Id N (ones (zeros n)) zero = split {
  zero -> refl zero ;
  suc n | r -> r } ;

comp-zeros : (n : N) (w : Wd) -> Id Wd (compW (zeros n) w) (zeros n) = split {
  zero -> \ w -> refl nil ;
  suc n | r -> \ w -> ap Wd Wd (\ u -> o u) (compW (zeros n) w) (zeros n) (r w) } ;

and-zeros : (n : N) (w : Wd) -> Id Wd (andW (zeros n) w) (zeros n) = split {
  zero -> \ w -> refl nil ;
  suc n | r -> \ w -> ap Wd Wd (\ u -> o u) (andW (zeros n) (tl w)) (zeros n) (r (tl w)) } ;

-- composing with, or intersecting with, the empty image
compZH (d : Wd) (r : (k : N) -> Id Wd (compW d (zeros k)) (zeros (len d)))
  : (k : N) -> Id Wd (compW (i d) (zeros k)) (zeros (len (i d))) = split {
  zero -> ap Wd Wd (\ u -> o u) (compW d nil) (zeros (len d)) (r zero) ;
  suc k -> ap Wd Wd (\ u -> o u) (compW d (zeros k)) (zeros (len d)) (r k) } ;

comp-into-zeros : (d : Wd) (k : N) -> Id Wd (compW d (zeros k)) (zeros (len d)) = split {
  nil -> \ k -> refl nil ;
  o d | r -> \ k -> ap Wd Wd (\ u -> o u) (compW d (zeros k)) (zeros (len d)) (r k) ;
  i d | r -> compZH d r } ;

andZH (d : Wd) (r : (k : N) -> Id Wd (andW d (zeros k)) (zeros (len d)))
  : (k : N) -> Id Wd (andW (i d) (zeros k)) (zeros (len (i d))) = split {
  zero -> ap Wd Wd (\ u -> o u) (andW d nil) (zeros (len d)) (r zero) ;
  suc k -> ap Wd Wd (\ u -> o u) (andW d (zeros k)) (zeros (len d)) (r k) } ;

and-into-zeros : (d : Wd) (k : N) -> Id Wd (andW d (zeros k)) (zeros (len d)) = split {
  nil -> \ k -> refl nil ;
  o d | r -> split {
    zero -> ap Wd Wd (\ u -> o u) (andW d nil) (zeros (len d)) (r zero) ;
    suc k -> ap Wd Wd (\ u -> o u) (andW d (zeros k)) (zeros (len d)) (r k) } ;
  i d | r -> andZH d r } ;

len-kron : (e d : Wd) -> Id N (len (kron e d)) (mul (len e) (len d)) = split {
  nil -> \ d -> refl zero ;
  o e | r -> \ d -> trans N (len (kron (o e) d)) (plus (len (zeros (len d))) (len (kron e d)))
                      (mul (len (o e)) (len d))
                      (len-app (zeros (len d)) (kron e d))
                      (ap2 N N N plus (len (zeros (len d))) (len d) (len (kron e d)) (mul (len e) (len d))
                         (len-zeros (len d)) (r d)) ;
  i e | r -> \ d -> trans N (len (kron (i e) d)) (plus (len d) (len (kron e d))) (mul (len (i e)) (len d))
                      (len-app d (kron e d))
                      (ap N N (\ k -> plus (len d) k) (len (kron e d)) (mul (len e) (len d)) (r d)) } ;

ones-kron : (e d : Wd) -> Id N (ones (kron e d)) (mul (ones e) (ones d)) = split {
  nil -> \ d -> refl zero ;
  o e | r -> \ d -> trans N (ones (kron (o e) d)) (plus (ones (zeros (len d))) (ones (kron e d)))
                      (mul (ones e) (ones d))
                      (ones-app (zeros (len d)) (kron e d))
                      (ap2 N N N plus (ones (zeros (len d))) zero (ones (kron e d)) (mul (ones e) (ones d))
                         (ones-zeros (len d)) (r d)) ;
  i e | r -> \ d -> trans N (ones (kron (i e) d)) (plus (ones d) (ones (kron e d))) (mul (ones (i e)) (ones d))
                      (ones-app d (kron e d))
                      (ap N N (\ k -> plus (ones d) k) (ones (kron e d)) (mul (ones e) (ones d)) (r d)) } ;

idW-mul : (m n : N) -> Id Wd (idW (mul m n)) (kron (idW m) (idW n)) = split {
  zero -> \ n -> refl nil ;
  suc m | r -> \ n -> trans Wd (idW (plus n (mul m n))) (app (idW n) (idW (mul m n))) (kron (idW (suc m)) (idW n))
                        (idW-plus n (mul m n))
                        (ap Wd Wd (\ w -> app (idW n) w) (idW (mul m n)) (kron (idW m) (idW n)) (r n)) } ;

zerosLen (d d' : Wd) (h : Id N (len d) (len d')) : Id Wd (zeros (len d)) (zeros (len d')) =
  ap N Wd zeros (len d) (len d') h ;

comp-kron : (e e' : Wd) -> Id N (ones e) (len e') -> (d d' : Wd) -> Id N (ones d) (len d')
  -> Id Wd (compW (kron e d) (kron e' d')) (kron (compW e e') (compW d d')) = split {
  nil -> \ e' h d d' hd -> refl nil ;
  o e | r -> \ e' h d d' hd ->
    trans Wd (compW (kron (o e) d) (kron e' d')) (app (zeros (len d)) (kron (compW e e') (compW d d')))
             (kron (compW (o e) e') (compW d d'))
      (trans Wd (compW (kron (o e) d) (kron e' d'))
                (app (compW (zeros (len d)) nil) (compW (kron e d) (kron e' d')))
                (app (zeros (len d)) (kron (compW e e') (compW d d')))
         (comp-app (zeros (len d)) nil (ones-zeros (len d)) (kron e d) (kron e' d'))
         (ap2 Wd Wd Wd app (compW (zeros (len d)) nil) (zeros (len d))
            (compW (kron e d) (kron e' d')) (kron (compW e e') (compW d d'))
            (comp-zeros (len d) nil) (r e' h d d' hd)))
      (ap Wd Wd (\ z -> app z (kron (compW e e') (compW d d'))) (zeros (len d)) (zeros (len (compW d d')))
         (zerosLen d (compW d d') (sym N (len (compW d d')) (len d) (len-comp d d')))) ;
  i e | r -> split {
    nil -> \ h d d' hd -> absurdN (Id Wd (compW (kron (i e) d) (kron nil d')) (kron (compW (i e) nil) (compW d d')))
                            (ones e) (sym N (suc (ones e)) zero h) ;
    o e' -> \ h d d' hd ->
      trans Wd (compW (kron (i e) d) (kron (o e') d'))
               (app (zeros (len d)) (kron (compW e e') (compW d d')))
               (kron (compW (i e) (o e')) (compW d d'))
        (trans Wd (compW (kron (i e) d) (kron (o e') d'))
                  (app (compW d (zeros (len d'))) (compW (kron e d) (kron e' d')))
                  (app (zeros (len d)) (kron (compW e e') (compW d d')))
           (comp-app d (zeros (len d')) (trans N (ones d) (len d') (len (zeros (len d'))) hd
                                           (sym N (len (zeros (len d'))) (len d') (len-zeros (len d'))))
              (kron e d) (kron e' d'))
           (ap2 Wd Wd Wd app (compW d (zeros (len d'))) (zeros (len d))
              (compW (kron e d) (kron e' d')) (kron (compW e e') (compW d d'))
              (comp-into-zeros d (len d')) (r e' (sucInj (ones e) (len e') h) d d' hd)))
        (ap Wd Wd (\ z -> app z (kron (compW e e') (compW d d'))) (zeros (len d)) (zeros (len (compW d d')))
           (zerosLen d (compW d d') (sym N (len (compW d d')) (len d) (len-comp d d')))) ;
    i e' -> \ h d d' hd ->
      trans Wd (compW (kron (i e) d) (kron (i e') d'))
               (app (compW d d') (compW (kron e d) (kron e' d')))
               (kron (compW (i e) (i e')) (compW d d'))
        (comp-app d d' hd (kron e d) (kron e' d'))
        (ap Wd Wd (\ w -> app (compW d d') w) (compW (kron e d) (kron e' d')) (kron (compW e e') (compW d d'))
           (r e' (sucInj (ones e) (len e') h) d d' hd)) } } ;

and-kron : (e e' : Wd) -> Id N (len e) (len e') -> (d d' : Wd) -> Id N (len d) (len d')
  -> Id Wd (andW (kron e d) (kron e' d')) (kron (andW e e') (andW d d')) = split {
  nil -> \ e' h d d' hd -> refl nil ;
  o e | r -> split {
    nil -> \ h d d' hd -> absurdN (Id Wd (andW (kron (o e) d) (kron nil d')) (kron (andW (o e) nil) (andW d d')))
                            (len e) (sym N (suc (len e)) zero h) ;
    o e' -> \ h d d' hd ->
      trans Wd (andW (kron (o e) d) (kron (o e') d'))
               (app (zeros (len d)) (kron (andW e e') (andW d d')))
               (kron (andW (o e) (o e')) (andW d d'))
        (trans Wd (andW (kron (o e) d) (kron (o e') d'))
                  (app (andW (zeros (len d)) (zeros (len d'))) (andW (kron e d) (kron e' d')))
                  (app (zeros (len d)) (kron (andW e e') (andW d d')))
           (and-app (zeros (len d)) (zeros (len d'))
              (trans N (len (zeros (len d))) (len d) (len (zeros (len d'))) (len-zeros (len d))
                 (trans N (len d) (len d') (len (zeros (len d'))) hd
                    (sym N (len (zeros (len d'))) (len d') (len-zeros (len d')))))
              (kron e d) (kron e' d'))
           (ap2 Wd Wd Wd app (andW (zeros (len d)) (zeros (len d'))) (zeros (len d))
              (andW (kron e d) (kron e' d')) (kron (andW e e') (andW d d'))
              (and-zeros (len d) (zeros (len d'))) (r e' (sucInj (len e) (len e') h) d d' hd)))
        (ap Wd Wd (\ z -> app z (kron (andW e e') (andW d d'))) (zeros (len d)) (zeros (len (andW d d')))
           (zerosLen d (andW d d') (sym N (len (andW d d')) (len d) (len-and d d')))) ;
    i e' -> \ h d d' hd ->
      trans Wd (andW (kron (o e) d) (kron (i e') d'))
               (app (zeros (len d)) (kron (andW e e') (andW d d')))
               (kron (andW (o e) (i e')) (andW d d'))
        (trans Wd (andW (kron (o e) d) (kron (i e') d'))
                  (app (andW (zeros (len d)) d') (andW (kron e d) (kron e' d')))
                  (app (zeros (len d)) (kron (andW e e') (andW d d')))
           (and-app (zeros (len d)) d' (trans N (len (zeros (len d))) (len d) (len d') (len-zeros (len d)) hd)
              (kron e d) (kron e' d'))
           (ap2 Wd Wd Wd app (andW (zeros (len d)) d') (zeros (len d))
              (andW (kron e d) (kron e' d')) (kron (andW e e') (andW d d'))
              (and-zeros (len d) d') (r e' (sucInj (len e) (len e') h) d d' hd)))
        (ap Wd Wd (\ z -> app z (kron (andW e e') (andW d d'))) (zeros (len d)) (zeros (len (andW d d')))
           (zerosLen d (andW d d') (sym N (len (andW d d')) (len d) (len-and d d')))) } ;
  i e | r -> split {
    nil -> \ h d d' hd -> absurdN (Id Wd (andW (kron (i e) d) (kron nil d')) (kron (andW (i e) nil) (andW d d')))
                            (len e) (sym N (suc (len e)) zero h) ;
    o e' -> \ h d d' hd ->
      trans Wd (andW (kron (i e) d) (kron (o e') d'))
               (app (zeros (len d)) (kron (andW e e') (andW d d')))
               (kron (andW (i e) (o e')) (andW d d'))
        (trans Wd (andW (kron (i e) d) (kron (o e') d'))
                  (app (andW d (zeros (len d'))) (andW (kron e d) (kron e' d')))
                  (app (zeros (len d)) (kron (andW e e') (andW d d')))
           (and-app d (zeros (len d')) (trans N (len d) (len d') (len (zeros (len d'))) hd
                                          (sym N (len (zeros (len d'))) (len d') (len-zeros (len d'))))
              (kron e d) (kron e' d'))
           (ap2 Wd Wd Wd app (andW d (zeros (len d'))) (zeros (len d))
              (andW (kron e d) (kron e' d')) (kron (andW e e') (andW d d'))
              (and-into-zeros d (len d')) (r e' (sucInj (len e) (len e') h) d d' hd)))
        (ap Wd Wd (\ z -> app z (kron (andW e e') (andW d d'))) (zeros (len d)) (zeros (len (andW d d')))
           (zerosLen d (andW d d') (sym N (len (andW d d')) (len d) (len-and d d')))) ;
    i e' -> \ h d d' hd ->
      trans Wd (andW (kron (i e) d) (kron (i e') d'))
               (app (andW d d') (andW (kron e d) (kron e' d')))
               (kron (andW (i e) (i e')) (andW d d'))
        (and-app d d' hd (kron e d) (kron e' d'))
        (ap Wd Wd (\ w -> app (andW d d') w) (andW (kron e d) (kron e' d')) (kron (andW e e') (andW d d'))
           (r e' (sucInj (len e) (len e') h) d d' hd)) } } ;

module ProdDil
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w))) {

  P0 (n : N) : N = mul (E0 n) (D0 n) ;

  P1 (w : Wd) : Wd = kron (E1 w) (D1 w) ;

  plen (w : Wd) : Id N (len (P1 w)) (P0 (len w)) =
    trans N (len (P1 w)) (mul (len (E1 w)) (len (D1 w))) (P0 (len w))
      (len-kron (E1 w) (D1 w))
      (ap2 N N N mul (len (E1 w)) (E0 (len w)) (len (D1 w)) (D0 (len w)) (elen w) (dlen w)) ;

  pones (w : Wd) : Id N (ones (P1 w)) (P0 (ones w)) =
    trans N (ones (P1 w)) (mul (ones (E1 w)) (ones (D1 w))) (P0 (ones w))
      (ones-kron (E1 w) (D1 w))
      (ap2 N N N mul (ones (E1 w)) (E0 (ones w)) (ones (D1 w)) (D0 (ones w)) (eones w) (dones w)) ;

  pid (n : N) : Id Wd (P1 (idW n)) (idW (P0 n)) =
    trans Wd (P1 (idW n)) (kron (idW (E0 n)) (idW (D0 n))) (idW (P0 n))
      (ap2 Wd Wd Wd kron (E1 (idW n)) (idW (E0 n)) (D1 (idW n)) (idW (D0 n)) (eid n) (did n))
      (sym Wd (idW (P0 n)) (kron (idW (E0 n)) (idW (D0 n))) (idW-mul (E0 n) (D0 n))) ;

  -- ones (F v) = len (F w) for a functor F, from ones v = len w
  matchD (v w : Wd) (h : Id N (ones v) (len w)) : Id N (ones (D1 v)) (len (D1 w)) =
    trans N (ones (D1 v)) (D0 (ones v)) (len (D1 w)) (dones v)
      (trans N (D0 (ones v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (ones v) (len w) h)
         (sym N (len (D1 w)) (D0 (len w)) (dlen w))) ;

  matchE (v w : Wd) (h : Id N (ones v) (len w)) : Id N (ones (E1 v)) (len (E1 w)) =
    trans N (ones (E1 v)) (E0 (ones v)) (len (E1 w)) (eones v)
      (trans N (E0 (ones v)) (E0 (len w)) (len (E1 w)) (ap N N E0 (ones v) (len w) h)
         (sym N (len (E1 w)) (E0 (len w)) (elen w))) ;

  lenD (v w : Wd) (h : Id N (len v) (len w)) : Id N (len (D1 v)) (len (D1 w)) =
    trans N (len (D1 v)) (D0 (len v)) (len (D1 w)) (dlen v)
      (trans N (D0 (len v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (len v) (len w) h)
         (sym N (len (D1 w)) (D0 (len w)) (dlen w))) ;

  lenE (v w : Wd) (h : Id N (len v) (len w)) : Id N (len (E1 v)) (len (E1 w)) =
    trans N (len (E1 v)) (E0 (len v)) (len (E1 w)) (elen v)
      (trans N (E0 (len v)) (E0 (len w)) (len (E1 w)) (ap N N E0 (len v) (len w) h)
         (sym N (len (E1 w)) (E0 (len w)) (elen w))) ;

  pcomp (v w : Wd) (h : Id N (ones v) (len w)) : Id Wd (P1 (compW v w)) (compW (P1 v) (P1 w)) =
    trans Wd (P1 (compW v w)) (kron (compW (E1 v) (E1 w)) (compW (D1 v) (D1 w))) (compW (P1 v) (P1 w))
      (ap2 Wd Wd Wd kron (E1 (compW v w)) (compW (E1 v) (E1 w)) (D1 (compW v w)) (compW (D1 v) (D1 w))
         (ecomp v w h) (dcomp v w h))
      (sym Wd (compW (P1 v) (P1 w)) (kron (compW (E1 v) (E1 w)) (compW (D1 v) (D1 w)))
         (comp-kron (E1 v) (E1 w) (matchE v w h) (D1 v) (D1 w) (matchD v w h))) ;

  pmeet (v w : Wd) (h : Id N (len v) (len w)) : Id Wd (P1 (andW v w)) (andW (P1 v) (P1 w)) =
    trans Wd (P1 (andW v w)) (kron (andW (E1 v) (E1 w)) (andW (D1 v) (D1 w))) (andW (P1 v) (P1 w))
      (ap2 Wd Wd Wd kron (E1 (andW v w)) (andW (E1 v) (E1 w)) (D1 (andW v w)) (andW (D1 v) (D1 w))
         (emeet v w h) (dmeet v w h))
      (sym Wd (andW (P1 v) (P1 w)) (kron (andW (E1 v) (E1 w)) (andW (D1 v) (D1 w)))
         (and-kron (E1 v) (E1 w) (lenE v w h) (D1 v) (D1 w) (lenD v w h))) ;

  module P = PreDil[P0, P1, plen, pones, pid, pcomp, pmeet] ;
} ;

-- Id . Id: D(n) = n.n, the pairs (a, b) ordered by b first
module IdTimesId = ProdDil[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w),
  \ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w)] ;

-- in D(2) = 4: the points are (0,0) (1,0) (0,1) (1,1); the diagonal points
-- have a one-point support, the others the full support, where they are
-- the two trace points 1 and 2 of D(2)
#conv IdTimesId.P.Sup[two, zero].supp = i (o nil) ;
#conv IdTimesId.P.Sup[two, three].supp = o (i nil) ;
#conv IdTimesId.P.Sup[two, one].supp = i (i nil) ;
#conv IdTimesId.P.Point[two, one, refl true].z = one ;
#conv IdTimesId.P.Sup[two, two].supp = i (i nil) ;
#conv IdTimesId.P.Point[two, two, refl true].z = two ;

------------------------------------------------------------------------
-- (c) the order on the denotations of D(X), for a decidable linear
-- order X
--
-- A strictly increasing map [n] -> X is a sorted list of length n.  The
-- denotations of D(X) are the pairs (a, z), a sorted and z in Tr(len a).
-- To compare (a, z) and (a', z'), take the union c of a and a' (merge),
-- with a = c . u and a' = c . u', and compare D(u)(z) and D(u')(z') in
-- D(len c).  Any other common refinement gives the same result (indep),
-- and the comparison is again a decidable linear order.

data O3 = lt | eq | gt ;

flip : O3 -> O3 = split { lt -> gt ; eq -> eq ; gt -> lt } ;

isLt : O3 -> Bool = split { lt -> true ; eq -> false ; gt -> false } ;

isEq : O3 -> Bool = split { lt -> false ; eq -> true ; gt -> false } ;

isLt-sound : (c : O3) -> Id Bool (isLt c) true -> Id O3 c lt = split {
  lt -> \ h -> refl lt ;
  eq -> \ h -> absurdB (Id O3 eq lt) h ;
  gt -> \ h -> absurdB (Id O3 gt lt) h } ;

-- the only fixed point of flip is eq
flip-fix : (c : O3) -> Id O3 c (flip c) -> Id O3 c eq = split {
  lt -> \ h -> absurdB (Id O3 lt eq) (sym Bool true false (ap O3 Bool isLt lt gt h)) ;
  eq -> \ h -> refl eq ;
  gt -> \ h -> absurdB (Id O3 gt eq) (ap O3 Bool isLt gt lt h) } ;

andB-intro : (c d : Bool) -> Id Bool c true -> Id Bool d true -> Id Bool (andB c d) true = split {
  false -> \ d h k -> h ;
  true -> \ d h k -> k } ;

sucEq (m n : N) (h : Id N m n) : Id N (suc m) (suc n) = ap N N (\ k -> suc k) m n h ;

-- the order on N: an instance of the interface below
cmpN : N -> N -> O3 = split {
  zero -> split { zero -> eq ; suc n -> lt } ;
  suc m | r -> split { zero -> gt ; suc n -> r n } } ;

cmpN-eq : (m n : N) -> Id O3 (cmpN m n) eq -> Id N m n = split {
  zero -> split {
    zero -> \ h -> refl zero ;
    suc n -> \ h -> absurdB (Id N zero (suc n)) (ap O3 Bool isEq lt eq h) } ;
  suc m | r -> split {
    zero -> \ h -> absurdB (Id N (suc m) zero) (ap O3 Bool isEq gt eq h) ;
    suc n -> \ h -> sucEq m n (r n h) } } ;

cmpN-flip : (m n : N) -> Id O3 (cmpN n m) (flip (cmpN m n)) = split {
  zero -> split { zero -> refl eq ; suc n -> refl gt } ;
  suc m | r -> split { zero -> refl lt ; suc n -> r n } } ;

cmpN-trans : (x y z : N) -> Id O3 (cmpN x y) lt -> Id O3 (cmpN y z) lt -> Id O3 (cmpN x z) lt = split {
  zero -> split {
    zero -> \ z h1 h2 -> absurdB (Id O3 (cmpN zero z) lt) (ap O3 Bool isLt eq lt h1) ;
    suc y -> split {
      zero -> \ h1 h2 -> absurdB (Id O3 (cmpN zero zero) lt) (ap O3 Bool isLt gt lt h2) ;
      suc z -> \ h1 h2 -> refl lt } } ;
  suc x | r -> split {
    zero -> \ z h1 h2 -> absurdB (Id O3 (cmpN (suc x) z) lt) (ap O3 Bool isLt gt lt h1) ;
    suc y -> split {
      zero -> \ h1 h2 -> absurdB (Id O3 (cmpN (suc x) zero) lt) (ap O3 Bool isLt gt lt h2) ;
      suc z -> \ h1 h2 -> r y z h1 h2 } } } ;

-- sel is functorial: the z-th point of the image of f . g
sel-comp : (f g : Wd) (z : N) -> Id N (ones f) (len g) -> Id N (sel (compW f g) z) (sel f (sel g z)) = split {
  nil -> \ g z h -> refl zero ;
  o f | r -> \ g z h -> sucEq (sel (compW f g) z) (sel f (sel g z)) (r g z h) ;
  i f | r -> split {
    nil -> \ z h -> absurdN (Id N (sel (compW (i f) nil) z) (sel (i f) (sel nil z))) (ones f)
                      (sym N (suc (ones f)) zero h) ;
    o g -> \ z h -> sucEq (sel (compW f g) z) (sel f (sel g z)) (r g z (sucInj (ones f) (len g) h)) ;
    i g -> split {
      zero -> \ h -> refl zero ;
      suc z -> \ h -> sucEq (sel (compW f g) z) (sel f (sel g z)) (r g z (sucInj (ones f) (len g) h)) } } } ;

-- and strictly increasing on [ones f]
sel-mono : (f : Wd) (m m' : N) -> Id Bool (ltN m (ones f)) true -> Id Bool (ltN m' (ones f)) true
  -> Id O3 (cmpN (sel f m) (sel f m')) (cmpN m m') = split {
  nil -> \ m m' h h' -> absurdB (Id O3 (cmpN (sel nil m) (sel nil m')) (cmpN m m'))
                          (trans Bool false (ltN m zero) true (sym Bool (ltN m zero) false (ltN-zero m)) h) ;
  o f | r -> \ m m' h h' -> r m m' h h' ;
  i f | r -> split {
    zero -> split {
      zero -> \ h h' -> refl eq ;
      suc m' -> \ h h' -> refl lt } ;
    suc m -> split {
      zero -> \ h h' -> refl gt ;
      suc m' -> \ h h' -> r m m' h h' } } } ;

data List (A : U a) : U a = nilL | consL (x : A) (l : List A) ;

------------------------------------------------------------------------
-- a decidable linear order X, given by a comparison: cmpX x y = eq only
-- for x = y, cmpX is antisymmetric, and lt is transitive

module LinOrd (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt) {

  ltX (x y : X) : Bool = isLt (cmpX x y) ;

  ltX-trans (x y z : X) (h1 : Id Bool (ltX x y) true) (h2 : Id Bool (ltX y z) true) : Id Bool (ltX x z) true =
    ap O3 Bool isLt (cmpX x z) lt (xtrans x y z (isLt-sound (cmpX x y) h1) (isLt-sound (cmpX y z) h2)) ;

  -- lt is irreflexive: cmpX x x = flip (cmpX x x)
  ltX-irr (A : U a) (x : X) (h : Id Bool (ltX x x) true) : A =
    absurdB A (ap O3 Bool isLt gt lt
      (trans O3 gt (cmpX x x) lt
         (trans O3 gt (flip (cmpX x x)) (cmpX x x)
            (ap O3 O3 flip lt (cmpX x x) (sym O3 (cmpX x x) lt (isLt-sound (cmpX x x) h)))
            (sym O3 (cmpX x x) (flip (cmpX x x)) (xflip x x)))
         (isLt-sound (cmpX x x) h))) ;

  lenL : List X -> N = split { nilL -> zero ; consL x l | r -> suc r } ;

  tlL : List X -> List X = split { nilL -> nilL ; consL x l -> l } ;

  -- allGt x l: every element of l is above x
  allGt (x : X) : List X -> Bool = split {
    nilL -> true ;
    consL y l | r -> andB (ltX x y) r } ;

  -- a sorted list is a strictly increasing map [lenL l] -> X
  sortedB : List X -> Bool = split {
    nilL -> true ;
    consL x l | r -> andB (allGt x l) r } ;

  allGt-trans (x y : X) (h : Id Bool (ltX x y) true) : (l : List X) -> Id Bool (allGt y l) true -> Id Bool (allGt x l) true = split {
    nilL -> \ k -> refl true ;
    consL z l | r -> \ k -> andB-intro (ltX x z) (allGt x l)
                              (ltX-trans x y z h (andB-l (ltX y z) (allGt y l) k))
                              (r (andB-r (ltX y z) (allGt y l) k)) } ;

  -- compL c w: the composite c . w, the sublist of c selected by w
  compL : List X -> Wd -> List X = split {
    nilL -> \ w -> nilL ;
    consL x c | r -> \ w -> ifW (List X) (hd w) (consL x (r (tl w))) (r (tl w)) } ;

  lenL-compL : (c : List X) (w : Wd) -> Id N (len w) (lenL c) -> Id N (lenL (compL c w)) (ones w) = split {
    nilL -> \ w h -> ap Wd N ones nil w (sym Wd w nil (len-zero w h)) ;
    consL x c | r -> split {
      nil -> \ h -> absurdN (Id N (lenL (compL (consL x c) nil)) (ones nil)) (lenL c) h ;
      o w -> \ h -> r w (sucInj (len w) (lenL c) h) ;
      i w -> \ h -> sucEq (lenL (compL c w)) (ones w) (r w (sucInj (len w) (lenL c) h)) } } ;

  compL-zeros : (c : List X) -> Id (List X) (compL c (zeros (lenL c))) nilL = split {
    nilL -> refl nilL ;
    consL x c | r -> r } ;

  compL-id : (c : List X) -> Id (List X) (compL c (idW (lenL c))) c = split {
    nilL -> refl nilL ;
    consL x c | r -> ap (List X) (List X) (\ l -> consL x l) (compL c (idW (lenL c))) c r } ;

  -- (c . e) . v = c . (e . v)
  compL-comp : (c : List X) (e v : Wd) -> Id N (len e) (lenL c) -> Id N (ones e) (len v)
    -> Id (List X) (compL (compL c e) v) (compL c (compW e v)) = split {
    nilL -> \ e v he hv -> refl nilL ;
    consL x c | r -> split {
      nil -> \ v he hv -> absurdN (Id (List X) (compL (compL (consL x c) nil) v) (compL (consL x c) (compW nil v)))
                            (lenL c) he ;
      o e -> \ v he hv -> r e v (sucInj (len e) (lenL c) he) hv ;
      i e -> split {
        nil -> \ he hv -> absurdN (Id (List X) (compL (compL (consL x c) (i e)) nil) (compL (consL x c) (compW (i e) nil)))
                            (ones e) (sym N (suc (ones e)) zero hv) ;
        o v -> \ he hv -> r e v (sucInj (len e) (lenL c) he) (sucInj (ones e) (len v) hv) ;
        i v -> \ he hv -> ap (List X) (List X) (\ l -> consL x l) (compL (compL c e) v) (compL c (compW e v))
                            (r e v (sucInj (len e) (lenL c) he) (sucInj (ones e) (len v) hv)) } } } ;

  allGt-compL (t : X) : (c : List X) (w : Wd) -> Id Bool (allGt t c) true -> Id Bool (allGt t (compL c w)) true = split {
    nilL -> \ w h -> refl true ;
    consL x c | r -> split {
      nil -> \ h -> r nil (andB-r (ltX t x) (allGt t c) h) ;
      o w -> \ h -> r w (andB-r (ltX t x) (allGt t c) h) ;
      i w -> \ h -> andB-intro (ltX t x) (allGt t (compL c w)) (andB-l (ltX t x) (allGt t c) h)
                      (r w (andB-r (ltX t x) (allGt t c) h)) } } ;

  sorted-compL : (c : List X) (w : Wd) -> Id Bool (sortedB c) true -> Id Bool (sortedB (compL c w)) true = split {
    nilL -> \ w h -> refl true ;
    consL x c | r -> split {
      nil -> \ h -> r nil (andB-r (allGt x c) (sortedB c) h) ;
      o w -> \ h -> r w (andB-r (allGt x c) (sortedB c) h) ;
      i w -> \ h -> andB-intro (allGt x (compL c w)) (sortedB (compL c w))
                      (allGt-compL x c w (andB-l (allGt x c) (sortedB c) h))
                      (r w (andB-r (allGt x c) (sortedB c) h)) } } ;

  -- a sorted list is injective: c . w = c . w' gives w = w'
  compL-inj : (c : List X) (w w' : Wd) -> Id Bool (sortedB c) true -> Id N (len w) (lenL c) -> Id N (len w') (lenL c)
    -> Id (List X) (compL c w) (compL c w') -> Id Wd w w' = split {
    nilL -> \ w w' hs hl hl' he -> trans Wd w nil w' (len-zero w hl) (sym Wd w' nil (len-zero w' hl')) ;
    consL x c | r -> split {
      nil -> \ w' hs hl hl' he -> absurdN (Id Wd nil w') (lenL c) hl ;
      o w -> split {
        nil -> \ hs hl hl' he -> absurdN (Id Wd (o w) nil) (lenL c) hl' ;
        o w' -> \ hs hl hl' he -> ap Wd Wd (\ u -> o u) w w'
                   (r w w' (andB-r (allGt x c) (sortedB c) hs) (sucInj (len w) (lenL c) hl) (sucInj (len w') (lenL c) hl') he) ;
        i w' -> \ hs hl hl' he -> ltX-irr (Id Wd (o w) (i w')) x
                   (andB-l (ltX x x) (allGt x (compL c w'))
                      (subst (List X) (\ l -> Id Bool (allGt x l) true) (compL c w) (consL x (compL c w')) he
                         (allGt-compL x c w (andB-l (allGt x c) (sortedB c) hs)))) } ;
      i w -> split {
        nil -> \ hs hl hl' he -> absurdN (Id Wd (i w) nil) (lenL c) hl' ;
        o w' -> \ hs hl hl' he -> ltX-irr (Id Wd (i w) (o w')) x
                   (andB-l (ltX x x) (allGt x (compL c w))
                      (subst (List X) (\ l -> Id Bool (allGt x l) true) (compL c w') (consL x (compL c w))
                         (sym (List X) (consL x (compL c w)) (compL c w') he)
                         (allGt-compL x c w' (andB-l (allGt x c) (sortedB c) hs)))) ;
        i w' -> \ hs hl hl' he -> ap Wd Wd (\ u -> i u) w w'
                   (r w w' (andB-r (allGt x c) (sortedB c) hs) (sucInj (len w) (lenL c) hl) (sucInj (len w') (lenL c) hl')
                      (ap (List X) (List X) tlL (consL x (compL c w)) (consL x (compL c w')) he)) } } } ;

  ----------------------------------------------------------------------
  -- the union of two sorted lists, with the two inclusions

  Cv : U a = List X * (Wd * Wd) ;

  stepM (x y : X) (m1 m2 m3 : Cv) : O3 -> Cv = split {
    lt -> (consL x m1.1, i m1.2.1, o m1.2.2) ;
    eq -> (consL x m2.1, i m2.2.1, i m2.2.2) ;
    gt -> (consL y m3.1, o m3.2.1, i m3.2.2) } ;

  merge : List X -> (List X) -> Cv = split {
    nilL -> \ b -> (b, zeros (lenL b), idW (lenL b)) ;
    consL x a | r -> split {
      nilL -> (consL x a, idW (lenL (consL x a)), zeros (lenL (consL x a))) ;
      consL y b | s -> stepM x y (r (consL y b)) (r b) s (cmpX x y) } } ;

  -- c . w = a, with w : [lenL a] -> [lenL c]
  Over (c : List X) (v : Wd) (l : List X) : U a = Id N (len v) (lenL c) * Id (List X) (compL c v) l ;

  -- m = (c, u, u') covers a and b, c is sorted, and every bound of a and b bounds c
  Cov (l l' : List X) (m : Cv) : U a =
    Id N (len m.2.1) (lenL m.1) * (Id N (len m.2.2) (lenL m.1) *
    (Id (List X) (compL m.1 m.2.1) l * (Id (List X) (compL m.1 m.2.2) l' *
    (Id Bool (sortedB m.1) true *
     ((t : X) -> Id Bool (allGt t l) true -> Id Bool (allGt t l') true -> Id Bool (allGt t m.1) true))))) ;

  mOver1 (a b : List X) (m : Cv) (k : Cov a b m) : Over m.1 m.2.1 a = (k.1, k.2.2.1) ;

  mOver2 (a b : List X) (m : Cv) (k : Cov a b m) : Over m.1 m.2.2 b = (k.2.1, k.2.2.2.1) ;

  covLt (x : X) (a : List X) (y : X) (b : List X)
    (ha : Id Bool (sortedB (consL x a)) true) (hb : Id Bool (sortedB (consL y b)) true)
    (m1 : Cv) (h1 : Cov a (consL y b) m1) (hc : Id Bool (ltX x y) true)
    : Cov (consL x a) (consL y b) (consL x m1.1, i m1.2.1, o m1.2.2) =
    (sucEq (len m1.2.1) (lenL m1.1) h1.1,
     sucEq (len m1.2.2) (lenL m1.1) h1.2.1,
     ap (List X) (List X) (\ l -> consL x l) (compL m1.1 m1.2.1) a h1.2.2.1,
     h1.2.2.2.1,
     andB-intro (allGt x m1.1) (sortedB m1.1)
       (h1.2.2.2.2.2 x (andB-l (allGt x a) (sortedB a) ha)
          (andB-intro (ltX x y) (allGt x b) hc (allGt-trans x y hc b (andB-l (allGt y b) (sortedB b) hb))))
       h1.2.2.2.2.1,
     \ t ht hu -> andB-intro (ltX t x) (allGt t m1.1) (andB-l (ltX t x) (allGt t a) ht)
                    (h1.2.2.2.2.2 t (andB-r (ltX t x) (allGt t a) ht) hu)) ;

  covEq (x : X) (a : List X) (y : X) (b : List X)
    (ha : Id Bool (sortedB (consL x a)) true) (hb : Id Bool (sortedB (consL y b)) true)
    (m2 : Cv) (h2 : Cov a b m2) (exy : Id X x y)
    : Cov (consL x a) (consL y b) (consL x m2.1, i m2.2.1, i m2.2.2) =
    (sucEq (len m2.2.1) (lenL m2.1) h2.1,
     sucEq (len m2.2.2) (lenL m2.1) h2.2.1,
     ap (List X) (List X) (\ l -> consL x l) (compL m2.1 m2.2.1) a h2.2.2.1,
     trans (List X) (consL x (compL m2.1 m2.2.2)) (consL x b) (consL y b)
       (ap (List X) (List X) (\ l -> consL x l) (compL m2.1 m2.2.2) b h2.2.2.2.1)
       (ap X (List X) (\ t -> consL t b) x y exy),
     andB-intro (allGt x m2.1) (sortedB m2.1)
       (h2.2.2.2.2.2 x (andB-l (allGt x a) (sortedB a) ha)
          (subst X (\ t -> Id Bool (allGt t b) true) y x (sym X x y exy) (andB-l (allGt y b) (sortedB b) hb)))
       h2.2.2.2.2.1,
     \ t ht hu -> andB-intro (ltX t x) (allGt t m2.1) (andB-l (ltX t x) (allGt t a) ht)
                    (h2.2.2.2.2.2 t (andB-r (ltX t x) (allGt t a) ht) (andB-r (ltX t y) (allGt t b) hu))) ;

  covGt (x : X) (a : List X) (y : X) (b : List X)
    (ha : Id Bool (sortedB (consL x a)) true) (hb : Id Bool (sortedB (consL y b)) true)
    (m3 : Cv) (h3 : Cov (consL x a) b m3) (hc : Id Bool (ltX y x) true)
    : Cov (consL x a) (consL y b) (consL y m3.1, o m3.2.1, i m3.2.2) =
    (sucEq (len m3.2.1) (lenL m3.1) h3.1,
     sucEq (len m3.2.2) (lenL m3.1) h3.2.1,
     h3.2.2.1,
     ap (List X) (List X) (\ l -> consL y l) (compL m3.1 m3.2.2) b h3.2.2.2.1,
     andB-intro (allGt y m3.1) (sortedB m3.1)
       (h3.2.2.2.2.2 y (andB-intro (ltX y x) (allGt y a) hc (allGt-trans y x hc a (andB-l (allGt x a) (sortedB a) ha)))
          (andB-l (allGt y b) (sortedB b) hb))
       h3.2.2.2.2.1,
     \ t ht hu -> andB-intro (ltX t y) (allGt t m3.1) (andB-l (ltX t y) (allGt t b) hu)
                    (h3.2.2.2.2.2 t ht (andB-r (ltX t y) (allGt t b) hu))) ;

  stepOK (x : X) (a : List X) (y : X) (b : List X)
    (ha : Id Bool (sortedB (consL x a)) true) (hb : Id Bool (sortedB (consL y b)) true)
    (m1 m2 m3 : Cv) (h1 : Cov a (consL y b) m1) (h2 : Cov a b m2) (h3 : Cov (consL x a) b m3)
    : (c : O3) -> Id O3 (cmpX x y) c -> Cov (consL x a) (consL y b) (stepM x y m1 m2 m3 c) = split {
    lt -> \ hc -> covLt x a y b ha hb m1 h1 (ap O3 Bool isLt (cmpX x y) lt hc) ;
    eq -> \ hc -> covEq x a y b ha hb m2 h2 (xeq x y hc) ;
    gt -> \ hc -> covGt x a y b ha hb m3 h3
                    (ap O3 Bool isLt (cmpX y x) lt
                       (trans O3 (cmpX y x) (flip (cmpX x y)) lt (xflip x y) (ap O3 O3 flip (cmpX x y) gt hc))) } ;

  mergeOK : (a b : List X) -> Id Bool (sortedB a) true -> Id Bool (sortedB b) true -> Cov a b (merge a b) = split {
    nilL -> \ b ha hb -> (len-zeros (lenL b), len-idW (lenL b), compL-zeros b, compL-id b, hb, \ t ht hu -> hu) ;
    consL x a | r -> split {
      nilL -> \ ha hb -> (len-idW (lenL (consL x a)), len-zeros (lenL (consL x a)),
                          compL-id (consL x a), compL-zeros (consL x a), ha, \ t ht hu -> ht) ;
      consL y b | s -> \ ha hb ->
        stepOK x a y b ha hb (merge a (consL y b)) (merge a b) (merge (consL x a) b)
          (r (consL y b) (andB-r (allGt x a) (sortedB a) ha) hb)
          (r b (andB-r (allGt x a) (sortedB a) ha) (andB-r (allGt y b) (sortedB b) hb))
          (s ha (andB-r (allGt y b) (sortedB b) hb))
          (cmpX x y) (refl (cmpX x y)) } } ;

  ----------------------------------------------------------------------
  -- refinements

  onesOver (c : List X) (v : Wd) (a : List X) (ov : Over c v a) : Id N (ones v) (lenL a) =
    trans N (ones v) (lenL (compL c v)) (lenL a)
      (sym N (lenL (compL c v)) (ones v) (lenL-compL c v ov.1))
      (ap (List X) N lenL (compL c v) a ov.2) ;

  oneLen (c : List X) (e : Wd) (c1 : List X) (oe : Over c e c1) (v : Wd) (a : List X) (ov : Over c1 v a)
    : Id N (ones e) (len v) =
    trans N (ones e) (lenL c1) (len v) (onesOver c e c1 oe) (sym N (len v) (lenL c1) ov.1) ;

  -- if c . e = c1 and c1 . v = a, then c . (e . v) = a
  overComp (c : List X) (e : Wd) (c1 : List X) (oe : Over c e c1) (v : Wd) (a : List X) (ov : Over c1 v a)
    : Over c (compW e v) a =
    (trans N (len (compW e v)) (len e) (lenL c) (len-comp e v) oe.1,
     trans (List X) (compL c (compW e v)) (compL c1 v) a
       (trans (List X) (compL c (compW e v)) (compL (compL c e) v) (compL c1 v)
          (sym (List X) (compL (compL c e) v) (compL c (compW e v)) (compL-comp c e v oe.1 (oneLen c e c1 oe v a ov)))
          (ap (List X) (List X) (\ l -> compL l v) (compL c e) c1 oe.2))
       ov.2) ;

  overUnique (c : List X) (hc : Id Bool (sortedB c) true) (v v' : Wd) (a : List X) (ov : Over c v a) (ov' : Over c v' a)
    : Id Wd v v' =
    compL-inj c v v' hc ov.1 ov'.1 (trans (List X) (compL c v) a (compL c v') ov.2 (sym (List X) (compL c v') a ov'.2)) ;

  ----------------------------------------------------------------------
  -- the denotations of a pre-dilator at X, and their order

  module DenOrd (D0 : N -> N) (D1 : Wd -> Wd)
    (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
    (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
    (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
    (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
    (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

    module PD = PreDil[D0, D1, dlen, dones, did, dcomp, dmeet] ;

    matchD (v w : Wd) (h : Id N (ones v) (len w)) : Id N (ones (D1 v)) (len (D1 w)) =
      trans N (ones (D1 v)) (D0 (ones v)) (len (D1 w)) (dones v)
        (trans N (D0 (ones v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (ones v) (len w) h)
           (sym N (len (D1 w)) (D0 (len w)) (dlen w))) ;

    -- comparing D(u)(z) and D(u')(z') in D(len u)
    cmpVia (u : Wd) (z : N) (u' : Wd) (z' : N) : O3 = cmpN (sel (D1 u) z) (sel (D1 u') z') ;

    sel-D (e v : Wd) (h : Id N (ones e) (len v)) (z : N) : Id N (sel (D1 (compW e v)) z) (sel (D1 e) (sel (D1 v) z)) =
      trans N (sel (D1 (compW e v)) z) (sel (compW (D1 e) (D1 v)) z) (sel (D1 e) (sel (D1 v) z))
        (ap Wd N (\ u -> sel u z) (D1 (compW e v)) (compW (D1 e) (D1 v)) (dcomp e v h))
        (sel-comp (D1 e) (D1 v) z (matchD e v h)) ;

    selLt (e v : Wd) (h : Id N (ones e) (len v)) (z : N) (hz : Id Bool (ltN z (ones (D1 v))) true)
      : Id Bool (ltN (sel (D1 v) z) (ones (D1 e))) true =
      subst N (\ k -> Id Bool (ltN (sel (D1 v) z) k) true) (len (D1 v)) (ones (D1 e))
        (sym N (ones (D1 e)) (len (D1 v)) (matchD e v h))
        (at-lt (D1 v) (sel (D1 v) z) (at-sel (D1 v) z hz)) ;

    -- functoriality: the comparison is invariant under composition with e
    cmpVia-comp (e v v' : Wd) (z z' : N) (h : Id N (ones e) (len v)) (h' : Id N (ones e) (len v'))
      (hz : Id Bool (ltN z (ones (D1 v))) true) (hz' : Id Bool (ltN z' (ones (D1 v'))) true)
      : Id O3 (cmpVia (compW e v) z (compW e v') z') (cmpVia v z v' z') =
      trans O3 (cmpVia (compW e v) z (compW e v') z')
               (cmpN (sel (D1 e) (sel (D1 v) z)) (sel (D1 e) (sel (D1 v') z')))
               (cmpVia v z v' z')
        (ap2 N N O3 cmpN (sel (D1 (compW e v)) z) (sel (D1 e) (sel (D1 v) z))
           (sel (D1 (compW e v')) z') (sel (D1 e) (sel (D1 v') z'))
           (sel-D e v h z) (sel-D e v' h' z'))
        (sel-mono (D1 e) (sel (D1 v) z) (sel (D1 v') z') (selLt e v h z hz) (selLt e v' h' z' hz')) ;

    zOver (c : List X) (v : Wd) (a : List X) (ov : Over c v a) (z : N) (hz : Id Bool (ltN z (D0 (lenL a))) true)
      : Id Bool (ltN z (ones (D1 v))) true =
      subst N (\ k -> Id Bool (ltN z k) true) (D0 (lenL a)) (ones (D1 v))
        (sym N (ones (D1 v)) (D0 (lenL a))
           (trans N (ones (D1 v)) (D0 (ones v)) (D0 (lenL a)) (dones v)
              (ap N N D0 (ones v) (lenL a) (onesOver c v a ov))))
        hz ;

    -- independence: two common refinements (c1, v1, v1') and (c2, v2, v2')
    -- of a and a' give the same comparison; both factor through their union
    indepM (a a' : List X) (z z' : N) (hz : Id Bool (ltN z (D0 (lenL a))) true) (hz' : Id Bool (ltN z' (D0 (lenL a'))) true)
      (c1 : List X) (v1 v1' : Wd) (o1 : Over c1 v1 a) (o1' : Over c1 v1' a')
      (c2 : List X) (v2 v2' : Wd) (o2 : Over c2 v2 a) (o2' : Over c2 v2' a')
      (m : Cv) (k : Cov c1 c2 m)
      : Id O3 (cmpVia v1 z v1' z') (cmpVia v2 z v2' z') =
      trans O3 (cmpVia v1 z v1' z') (cmpVia (compW m.2.1 v1) z (compW m.2.1 v1') z') (cmpVia v2 z v2' z')
        (sym O3 (cmpVia (compW m.2.1 v1) z (compW m.2.1 v1') z') (cmpVia v1 z v1' z')
           (cmpVia-comp m.2.1 v1 v1' z z'
              (oneLen m.1 m.2.1 c1 (mOver1 c1 c2 m k) v1 a o1)
              (oneLen m.1 m.2.1 c1 (mOver1 c1 c2 m k) v1' a' o1')
              (zOver c1 v1 a o1 z hz) (zOver c1 v1' a' o1' z' hz')))
        (trans O3 (cmpVia (compW m.2.1 v1) z (compW m.2.1 v1') z') (cmpVia (compW m.2.2 v2) z (compW m.2.2 v2') z')
                  (cmpVia v2 z v2' z')
           (ap2 Wd Wd O3 (\ u u' -> cmpVia u z u' z') (compW m.2.1 v1) (compW m.2.2 v2) (compW m.2.1 v1') (compW m.2.2 v2')
              (overUnique m.1 k.2.2.2.2.1 (compW m.2.1 v1) (compW m.2.2 v2) a
                 (overComp m.1 m.2.1 c1 (mOver1 c1 c2 m k) v1 a o1)
                 (overComp m.1 m.2.2 c2 (mOver2 c1 c2 m k) v2 a o2))
              (overUnique m.1 k.2.2.2.2.1 (compW m.2.1 v1') (compW m.2.2 v2') a'
                 (overComp m.1 m.2.1 c1 (mOver1 c1 c2 m k) v1' a' o1')
                 (overComp m.1 m.2.2 c2 (mOver2 c1 c2 m k) v2' a' o2')))
           (cmpVia-comp m.2.2 v2 v2' z z'
              (oneLen m.1 m.2.2 c2 (mOver2 c1 c2 m k) v2 a o2)
              (oneLen m.1 m.2.2 c2 (mOver2 c1 c2 m k) v2' a' o2')
              (zOver c2 v2 a o2 z hz) (zOver c2 v2' a' o2' z' hz'))) ;

    indep (a a' : List X) (z z' : N) (hz : Id Bool (ltN z (D0 (lenL a))) true) (hz' : Id Bool (ltN z' (D0 (lenL a'))) true)
      (c1 : List X) (v1 v1' : Wd) (s1 : Id Bool (sortedB c1) true) (o1 : Over c1 v1 a) (o1' : Over c1 v1' a')
      (c2 : List X) (v2 v2' : Wd) (s2 : Id Bool (sortedB c2) true) (o2 : Over c2 v2 a) (o2' : Over c2 v2' a')
      : Id O3 (cmpVia v1 z v1' z') (cmpVia v2 z v2' z') =
      indepM a a' z z' hz hz' c1 v1 v1' o1 o1' c2 v2 v2' o2 o2' (merge c1 c2) (mergeOK c1 c2 s1 s2) ;

    -- a denotation (a, z): a sorted, z in the trace Tr(lenL a)
    TP (n z : N) : U a = Id Bool (ltN z (D0 n)) true * Id Wd PD.Sup[n, z].supp (idW n) ;

    TX (l : List X) (z : N) : U a = Id Bool (sortedB l) true * TP (lenL l) z ;

    DenX : U a = (a : List X) * (z : N) * TX a z ;

    cmpDen (d d' : DenX) : O3 = cmpVia (merge d.1 d'.1).2.1 d.2.1 (merge d.1 d'.1).2.2 d'.2.1 ;

    mOK (d d' : DenX) : Cov d.1 d'.1 (merge d.1 d'.1) = mergeOK d.1 d'.1 d.2.2.1 d'.2.2.1 ;

    -- the comparison does not depend on the choice of the union c
    den-indep (d d' : DenX) (c : List X) (v v' : Wd) (sc : Id Bool (sortedB c) true)
      (ov : Over c v d.1) (ov' : Over c v' d'.1)
      : Id O3 (cmpVia v d.2.1 v' d'.2.1) (cmpDen d d') =
      indep d.1 d'.1 d.2.1 d'.2.1 d.2.2.2.1 d'.2.2.2.1 c v v' sc ov ov'
        (merge d.1 d'.1).1 (merge d.1 d'.1).2.1 (merge d.1 d'.1).2.2 (mOK d d').2.2.2.2.1
        (mOver1 d.1 d'.1 (merge d.1 d'.1) (mOK d d')) (mOver2 d.1 d'.1 (merge d.1 d'.1) (mOK d d')) ;

    -- linearity: antisymmetry
    den-flip (d d' : DenX) : Id O3 (cmpDen d' d) (flip (cmpDen d d')) =
      trans O3 (cmpDen d' d) (cmpVia (merge d.1 d'.1).2.2 d'.2.1 (merge d.1 d'.1).2.1 d.2.1) (flip (cmpDen d d'))
        (sym O3 (cmpVia (merge d.1 d'.1).2.2 d'.2.1 (merge d.1 d'.1).2.1 d.2.1) (cmpDen d' d)
           (den-indep d' d (merge d.1 d'.1).1 (merge d.1 d'.1).2.2 (merge d.1 d'.1).2.1 (mOK d d').2.2.2.2.1
              (mOver2 d.1 d'.1 (merge d.1 d'.1) (mOK d d')) (mOver1 d.1 d'.1 (merge d.1 d'.1) (mOK d d'))))
        (cmpN-flip (sel (D1 (merge d.1 d'.1).2.1) d.2.1) (sel (D1 (merge d.1 d'.1).2.2) d'.2.1)) ;

    -- transitivity, through a common refinement of the three
    transC (d1 d2 d3 : DenX) (c : List X) (v1 v2 v3 : Wd) (sc : Id Bool (sortedB c) true)
      (o1 : Over c v1 d1.1) (o2 : Over c v2 d2.1) (o3 : Over c v3 d3.1)
      (h12 : Id O3 (cmpDen d1 d2) lt) (h23 : Id O3 (cmpDen d2 d3) lt) : Id O3 (cmpDen d1 d3) lt =
      trans O3 (cmpDen d1 d3) (cmpVia v1 d1.2.1 v3 d3.2.1) lt
        (sym O3 (cmpVia v1 d1.2.1 v3 d3.2.1) (cmpDen d1 d3) (den-indep d1 d3 c v1 v3 sc o1 o3))
        (cmpN-trans (sel (D1 v1) d1.2.1) (sel (D1 v2) d2.2.1) (sel (D1 v3) d3.2.1)
           (trans O3 (cmpVia v1 d1.2.1 v2 d2.2.1) (cmpDen d1 d2) lt (den-indep d1 d2 c v1 v2 sc o1 o2) h12)
           (trans O3 (cmpVia v2 d2.2.1 v3 d3.2.1) (cmpDen d2 d3) lt (den-indep d2 d3 c v2 v3 sc o2 o3) h23)) ;

    transM (d1 d2 d3 : DenX) (m12 : Cv) (k12 : Cov d1.1 d2.1 m12) (m : Cv) (k : Cov m12.1 d3.1 m)
      (h12 : Id O3 (cmpDen d1 d2) lt) (h23 : Id O3 (cmpDen d2 d3) lt) : Id O3 (cmpDen d1 d3) lt =
      transC d1 d2 d3 m.1 (compW m.2.1 m12.2.1) (compW m.2.1 m12.2.2) m.2.2 k.2.2.2.2.1
        (overComp m.1 m.2.1 m12.1 (mOver1 m12.1 d3.1 m k) m12.2.1 d1.1 (mOver1 d1.1 d2.1 m12 k12))
        (overComp m.1 m.2.1 m12.1 (mOver1 m12.1 d3.1 m k) m12.2.2 d2.1 (mOver2 d1.1 d2.1 m12 k12))
        (mOver2 m12.1 d3.1 m k) h12 h23 ;

    den-trans (d1 d2 d3 : DenX) (h12 : Id O3 (cmpDen d1 d2) lt) (h23 : Id O3 (cmpDen d2 d3) lt)
      : Id O3 (cmpDen d1 d3) lt =
      transM d1 d2 d3 (merge d1.1 d2.1) (mOK d1 d2) (merge (merge d1.1 d2.1).1 d3.1)
        (mergeOK (merge d1.1 d2.1).1 d3.1 (mOK d1 d2).2.2.2.2.1 d3.2.2.1) h12 h23 ;

    -- equality: two denotations with the same image in D(lenL c) are
    -- equal, by the normal form in D(lenL c)
    denP (d : DenX) (c : List X) (u : Wd) (ov : Over c u d.1) : PD.Den (lenL c) =
      (u, d.2.1, ov.1,
       subst N (\ k -> TP k d.2.1) (lenL d.1) (ones u) (sym N (ones u) (lenL d.1) (onesOver c u d.1 ov)) d.2.2.2) ;

    denP-eq (d d' : DenX) (c : List X) (u u' : Wd) (ov : Over c u d.1) (ov' : Over c u' d'.1)
      (ex : Id N (sel (D1 u) d.2.1) (sel (D1 u') d'.2.1))
      : Id (PD.Den (lenL c)) (denP d c u ov) (denP d' c u' ov') =
      trans (PD.Den (lenL c)) (denP d c u ov) (PD.fwd (lenL c) (PD.bwd (lenL c) (denP d c u ov))) (denP d' c u' ov')
        (sym (PD.Den (lenL c)) (PD.fwd (lenL c) (PD.bwd (lenL c) (denP d c u ov))) (denP d c u ov)
           (PD.fwd-bwd-full (lenL c) (denP d c u ov)))
        (trans (PD.Den (lenL c)) (PD.fwd (lenL c) (PD.bwd (lenL c) (denP d c u ov)))
                                 (PD.fwd (lenL c) (PD.bwd (lenL c) (denP d' c u' ov'))) (denP d' c u' ov')
           (ap (PD.Pt (lenL c)) (PD.Den (lenL c)) (PD.fwd (lenL c))
              (PD.bwd (lenL c) (denP d c u ov)) (PD.bwd (lenL c) (denP d' c u' ov'))
              (pairEq N (\ y -> Id Bool (at (D1 (idW (lenL c))) y) true)
                 (\ y s t -> HB.uip (at (D1 (idW (lenL c))) y) true s t)
                 (PD.bwd (lenL c) (denP d c u ov)).1 (PD.bwd (lenL c) (denP d c u ov)).2
                 (PD.bwd (lenL c) (denP d' c u' ov')).1 ex (PD.bwd (lenL c) (denP d' c u' ov')).2))
           (PD.fwd-bwd-full (lenL c) (denP d' c u' ov'))) ;

    propTX (a : List X) (z : N) (t t' : TX a z) : Id (TX a z) t t' =
      prodEq (Id Bool (sortedB a) true) (TP (lenL a) z) t t'
        (HB.uip (sortedB a) true t.1 t'.1)
        (prodEq (Id Bool (ltN z (D0 (lenL a))) true) (Id Wd PD.Sup[lenL a, z].supp (idW (lenL a))) t.2 t'.2
           (HB.uip (ltN z (D0 (lenL a))) true t.2.1 t'.2.1)
           (HW.uip PD.Sup[lenL a, z].supp (idW (lenL a)) t.2.2 t'.2.2)) ;

    denXEq (a : List X) (z : N) (t : TX a z) (a' : List X) (e1 : Id (List X) a a') (z' : N) (e2 : Id N z z')
      (t' : TX a' z') : Id DenX (a, (z, t)) (a', (z', t')) =
      idJ (List X) a (\ a2 e -> (z2 : N) (e2' : Id N z z2) (t2 : TX a2 z2) -> Id DenX (a, (z, t)) (a2, (z2, t2)))
        (\ z2 e2' -> idJ N z (\ z3 e3 -> (t3 : TX a z3) -> Id DenX (a, (z, t)) (a, (z3, t3)))
           (\ t3 -> ap (TX a z) DenX (\ s -> (a, (z, s))) t t3 (propTX a z t t3)) z2 e2')
        a' e1 z' e2 t' ;

    eqC (d d' : DenX) (c : List X) (u u' : Wd) (ov : Over c u d.1) (ov' : Over c u' d'.1)
      (E : Id (PD.Den (lenL c)) (denP d c u ov) (denP d' c u' ov')) : Id DenX d d' =
      denXEq d.1 d.2.1 d.2.2 d'.1
        (trans (List X) d.1 (compL c u) d'.1 (sym (List X) (compL c u) d.1 ov.2)
           (trans (List X) (compL c u) (compL c u') d'.1
              (ap Wd (List X) (\ w -> compL c w) u u'
                 (ap (PD.Den (lenL c)) Wd (\ s -> s.1) (denP d c u ov) (denP d' c u' ov') E))
              ov'.2))
        d'.2.1 (ap (PD.Den (lenL c)) N (\ s -> s.2.1) (denP d c u ov) (denP d' c u' ov') E) d'.2.2 ;

    den-eq (d d' : DenX) (h : Id O3 (cmpDen d d') eq) : Id DenX d d' =
      eqC d d' (merge d.1 d'.1).1 (merge d.1 d'.1).2.1 (merge d.1 d'.1).2.2
        (mOver1 d.1 d'.1 (merge d.1 d'.1) (mOK d d')) (mOver2 d.1 d'.1 (merge d.1 d'.1) (mOK d d'))
        (denP-eq d d' (merge d.1 d'.1).1 (merge d.1 d'.1).2.1 (merge d.1 d'.1).2.2
           (mOver1 d.1 d'.1 (merge d.1 d'.1) (mOK d d')) (mOver2 d.1 d'.1 (merge d.1 d'.1) (mOK d d'))
           (cmpN-eq (sel (D1 (merge d.1 d'.1).2.1) d.2.1) (sel (D1 (merge d.1 d'.1).2.2) d'.2.1) h)) ;

    den-refl (d : DenX) : Id O3 (cmpDen d d) eq = flip-fix (cmpDen d d) (den-flip d d) ;

    ----------------------------------------------------------------------
    -- D(X) is the direct limit of the D(n): a sorted c : [n] -> X sends a
    -- denotation (w, z) of D(n) to (c . w, z), preserving the order of
    -- D(n) (the order of the points sel (D1 w) z, by the bijection), and
    -- every denotation of D(X) comes from its own support

    embC (c : List X) (sc : Id Bool (sortedB c) true) (e : PD.Den (lenL c)) : DenX =
      (compL c e.1, e.2.1, sorted-compL c e.1 sc,
       subst N (\ k -> TP k e.2.1) (ones e.1) (lenL (compL c e.1))
         (sym N (lenL (compL c e.1)) (ones e.1) (lenL-compL c e.1 e.2.2.1)) e.2.2.2) ;

    embC-order (c : List X) (sc : Id Bool (sortedB c) true) (e e' : PD.Den (lenL c))
      : Id O3 (cmpDen (embC c sc e) (embC c sc e')) (cmpN (sel (D1 e.1) e.2.1) (sel (D1 e'.1) e'.2.1)) =
      sym O3 (cmpVia e.1 e.2.1 e'.1 e'.2.1) (cmpDen (embC c sc e) (embC c sc e'))
        (den-indep (embC c sc e) (embC c sc e') c e.1 e'.1 sc
           (e.2.2.1, refl (compL c e.1)) (e'.2.2.1, refl (compL c e'.1))) ;

    -- the denotation (id, z) of D(lenL a)
    idDen (d : DenX) : PD.Den (lenL d.1) =
      (idW (lenL d.1), d.2.1, len-idW (lenL d.1),
       subst N (\ k -> TP k d.2.1) (lenL d.1) (ones (idW (lenL d.1)))
         (sym N (ones (idW (lenL d.1))) (lenL d.1) (ones-idW (lenL d.1))) d.2.2.2) ;

    embC-onto (d : DenX) : Id DenX (embC d.1 d.2.2.1 (idDen d)) d =
      denXEq (compL d.1 (idW (lenL d.1))) d.2.1 (embC d.1 d.2.2.1 (idDen d)).2.2
        d.1 (compL-id d.1) d.2.1 (refl d.2.1) d.2.2 ;

    -- two images along different lists are compared through the union:
    -- with c = m . u and c' = m . u', the points D(u)(x) and D(u')(x')
    embC-cmp (c c' : List X) (sc : Id Bool (sortedB c) true) (sc' : Id Bool (sortedB c') true)
      (x : PD.Den (lenL c)) (x' : PD.Den (lenL c'))
      : Id O3 (cmpDen (embC c sc x) (embC c' sc' x'))
              (cmpN (sel (D1 (merge c c').2.1) (sel (D1 x.1) x.2.1)) (sel (D1 (merge c c').2.2) (sel (D1 x'.1) x'.2.1))) =
      trans O3 (cmpDen (embC c sc x) (embC c' sc' x'))
               (cmpVia (compW (merge c c').2.1 x.1) x.2.1 (compW (merge c c').2.2 x'.1) x'.2.1)
               (cmpN (sel (D1 (merge c c').2.1) (sel (D1 x.1) x.2.1)) (sel (D1 (merge c c').2.2) (sel (D1 x'.1) x'.2.1)))
        (sym O3 (cmpVia (compW (merge c c').2.1 x.1) x.2.1 (compW (merge c c').2.2 x'.1) x'.2.1)
                (cmpDen (embC c sc x) (embC c' sc' x'))
           (den-indep (embC c sc x) (embC c' sc' x') (merge c c').1
              (compW (merge c c').2.1 x.1) (compW (merge c c').2.2 x'.1) (mergeOK c c' sc sc').2.2.2.2.1
              (overComp (merge c c').1 (merge c c').2.1 c (mOver1 c c' (merge c c') (mergeOK c c' sc sc'))
                 x.1 (compL c x.1) (x.2.2.1, refl (compL c x.1)))
              (overComp (merge c c').1 (merge c c').2.2 c' (mOver2 c c' (merge c c') (mergeOK c c' sc sc'))
                 x'.1 (compL c' x'.1) (x'.2.2.1, refl (compL c' x'.1)))))
        (ap2 N N O3 cmpN (sel (D1 (compW (merge c c').2.1 x.1)) x.2.1) (sel (D1 (merge c c').2.1) (sel (D1 x.1) x.2.1))
           (sel (D1 (compW (merge c c').2.2 x'.1)) x'.2.1) (sel (D1 (merge c c').2.2) (sel (D1 x'.1) x'.2.1))
           (sel-D (merge c c').2.1 x.1
              (oneLen (merge c c').1 (merge c c').2.1 c (mOver1 c c' (merge c c') (mergeOK c c' sc sc'))
                 x.1 (compL c x.1) (x.2.2.1, refl (compL c x.1))) x.2.1)
           (sel-D (merge c c').2.2 x'.1
              (oneLen (merge c c').1 (merge c c').2.2 c' (mOver2 c c' (merge c c') (mergeOK c c' sc sc'))
                 x'.1 (compL c' x'.1) (x'.2.2.1, refl (compL c' x'.1))) x'.2.1)) ;
  } ;
} ;

------------------------------------------------------------------------
-- functoriality in X: a strictly increasing f : X -> Y (it preserves the
-- comparison) gives D(f) : D(X) -> D(Y), (a, z) |-> (f . a, z)

map (A B : U a) (f : A -> B) : List A -> List B = split {
  nilL -> nilL ;
  consL x l | r -> consL (f x) r } ;

map-id (A : U a) : (l : List A) -> Id (List A) (map A A (\ x -> x) l) l = split {
  nilL -> refl nilL ;
  consL x l | r -> ap (List A) (List A) (\ k -> consL x k) (map A A (\ y -> y) l) l r } ;

map-comp (A B C : U a) (f : A -> B) (g : B -> C)
  : (l : List A) -> Id (List C) (map B C g (map A B f l)) (map A C (\ x -> g (f x)) l) = split {
  nilL -> refl nilL ;
  consL x l | r -> ap (List C) (List C) (\ k -> consL (g (f x)) k)
                     (map B C g (map A B f l)) (map A C (\ y -> g (f y)) l) r } ;

module Fun (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  (Y : U a) (cmpY : Y -> Y -> O3)
  (yeq : (x y : Y) -> Id O3 (cmpY x y) eq -> Id Y x y)
  (yflip : (x y : Y) -> Id O3 (cmpY y x) (flip (cmpY x y)))
  (ytrans : (x y z : Y) -> Id O3 (cmpY x y) lt -> Id O3 (cmpY y z) lt -> Id O3 (cmpY x z) lt)
  (f : X -> Y) (fmono : (x x' : X) -> Id O3 (cmpY (f x) (f x')) (cmpX x x'))
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
  module LY = LinOrd[Y, cmpY, yeq, yflip, ytrans] ;
  module DX = LX.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module DY = LY.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;

  lenL-map : (l : List X) -> Id N (LY.lenL (map X Y f l)) (LX.lenL l) = split {
    nilL -> refl zero ;
    consL x l | r -> sucEq (LY.lenL (map X Y f l)) (LX.lenL l) r } ;

  compL-map : (c : List X) (w : Wd) -> Id (List Y) (map X Y f (LX.compL c w)) (LY.compL (map X Y f c) w) = split {
    nilL -> \ w -> refl nilL ;
    consL x c | r -> split {
      nil -> r nil ;
      o w -> r w ;
      i w -> ap (List Y) (List Y) (\ l -> consL (f x) l) (map X Y f (LX.compL c w)) (LY.compL (map X Y f c) w) (r w) } } ;

  allGt-map (t : X) : (l : List X) -> Id Bool (LY.allGt (f t) (map X Y f l)) (LX.allGt t l) = split {
    nilL -> refl true ;
    consL y l | r -> ap2 Bool Bool Bool andB (isLt (cmpY (f t) (f y))) (isLt (cmpX t y))
                       (LY.allGt (f t) (map X Y f l)) (LX.allGt t l)
                       (ap O3 Bool isLt (cmpY (f t) (f y)) (cmpX t y) (fmono t y)) r } ;

  sorted-map : (l : List X) -> Id Bool (LY.sortedB (map X Y f l)) (LX.sortedB l) = split {
    nilL -> refl true ;
    consL x l | r -> ap2 Bool Bool Bool andB (LY.allGt (f x) (map X Y f l)) (LX.allGt x l)
                       (LY.sortedB (map X Y f l)) (LX.sortedB l) (allGt-map x l) r } ;

  Df (d : DX.DenX) : DY.DenX =
    (map X Y f d.1, d.2.1,
     trans Bool (LY.sortedB (map X Y f d.1)) (LX.sortedB d.1) true (sorted-map d.1) d.2.2.1,
     subst N (\ k -> DY.TP k d.2.1) (LX.lenL d.1) (LY.lenL (map X Y f d.1))
       (sym N (LY.lenL (map X Y f d.1)) (LX.lenL d.1) (lenL-map d.1)) d.2.2.2) ;

  ovY (a c : List X) (v : Wd) (ov : LX.Over c v a) : LY.Over (map X Y f c) v (map X Y f a) =
    (trans N (len v) (LX.lenL c) (LY.lenL (map X Y f c)) ov.1
       (sym N (LY.lenL (map X Y f c)) (LX.lenL c) (lenL-map c)),
     trans (List Y) (LY.compL (map X Y f c) v) (map X Y f (LX.compL c v)) (map X Y f a)
       (sym (List Y) (map X Y f (LX.compL c v)) (LY.compL (map X Y f c) v) (compL-map c v))
       (ap (List X) (List Y) (map X Y f) (LX.compL c v) a ov.2)) ;

  -- D(f) preserves the order: the image of the union refines f . a and f . a'
  Df-order (d d' : DX.DenX) : Id O3 (DY.cmpDen (Df d) (Df d')) (DX.cmpDen d d') =
    sym O3 (DX.cmpDen d d') (DY.cmpDen (Df d) (Df d'))
      (DY.den-indep (Df d) (Df d') (map X Y f (LX.merge d.1 d'.1).1)
         (LX.merge d.1 d'.1).2.1 (LX.merge d.1 d'.1).2.2
         (trans Bool (LY.sortedB (map X Y f (LX.merge d.1 d'.1).1)) (LX.sortedB (LX.merge d.1 d'.1).1) true
            (sorted-map (LX.merge d.1 d'.1).1) (DX.mOK d d').2.2.2.2.1)
         (ovY d.1 (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1
            (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))
         (ovY d'.1 (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2
            (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))) ;

  -- D(f) is injective
  Df-inj (d d' : DX.DenX) (e : Id DY.DenX (Df d) (Df d')) : Id DX.DenX d d' =
    DX.den-eq d d'
      (trans O3 (DX.cmpDen d d') (DY.cmpDen (Df d) (Df d')) eq
         (sym O3 (DY.cmpDen (Df d) (Df d')) (DX.cmpDen d d') (Df-order d d'))
         (subst DY.DenX (\ x -> Id O3 (DY.cmpDen (Df d) x) eq) (Df d) (Df d') e (DY.den-refl (Df d)))) ;

  -- and its image is the denotations whose support lies in the image of
  -- f; with injectivity, this is the preservation of pull-backs
  pre (d : DY.DenX) (a : List X) (e : Id (List Y) (map X Y f a) d.1) : DX.DenX =
    (a, d.2.1,
     trans Bool (LX.sortedB a) (LY.sortedB d.1) true
       (trans Bool (LX.sortedB a) (LY.sortedB (map X Y f a)) (LY.sortedB d.1)
          (sym Bool (LY.sortedB (map X Y f a)) (LX.sortedB a) (sorted-map a))
          (ap (List Y) Bool LY.sortedB (map X Y f a) d.1 e))
       d.2.2.1,
     subst N (\ k -> DX.TP k d.2.1) (LY.lenL d.1) (LX.lenL a)
       (trans N (LY.lenL d.1) (LY.lenL (map X Y f a)) (LX.lenL a)
          (ap (List Y) N LY.lenL d.1 (map X Y f a) (sym (List Y) (map X Y f a) d.1 e))
          (lenL-map a))
       d.2.2.2) ;

  Df-onto (d : DY.DenX) (a : List X) (e : Id (List Y) (map X Y f a) d.1) : Id DY.DenX (Df (pre d a e)) d =
    DY.denXEq (map X Y f a) d.2.1 (Df (pre d a e)).2.2 d.1 e d.2.1 (refl d.2.1) d.2.2 ;
} ;

-- the functor laws: D(id) = id and D(g . f) = D(g) . D(f)
module FunId (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  module F = Fun[X, cmpX, xeq, xflip, xtrans, X, cmpX, xeq, xflip, xtrans,
    \ x -> x, \ x x' -> refl (cmpX x x'), D0, D1, dlen, dones, did, dcomp, dmeet] ;

  Df-id (d : F.DX.DenX) : Id F.DX.DenX (F.Df d) d =
    F.DX.denXEq (map X X (\ x -> x) d.1) d.2.1 (F.Df d).2.2 d.1 (map-id X d.1) d.2.1 (refl d.2.1) d.2.2 ;
} ;

module FunComp (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  (Y : U a) (cmpY : Y -> Y -> O3)
  (yeq : (x y : Y) -> Id O3 (cmpY x y) eq -> Id Y x y)
  (yflip : (x y : Y) -> Id O3 (cmpY y x) (flip (cmpY x y)))
  (ytrans : (x y z : Y) -> Id O3 (cmpY x y) lt -> Id O3 (cmpY y z) lt -> Id O3 (cmpY x z) lt)
  (Z : U a) (cmpZ : Z -> Z -> O3)
  (zeq : (x y : Z) -> Id O3 (cmpZ x y) eq -> Id Z x y)
  (zflip : (x y : Z) -> Id O3 (cmpZ y x) (flip (cmpZ x y)))
  (ztrans : (x y z : Z) -> Id O3 (cmpZ x y) lt -> Id O3 (cmpZ y z) lt -> Id O3 (cmpZ x z) lt)
  (f : X -> Y) (fmono : (x x' : X) -> Id O3 (cmpY (f x) (f x')) (cmpX x x'))
  (g : Y -> Z) (gmono : (y y' : Y) -> Id O3 (cmpZ (g y) (g y')) (cmpY y y'))
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  module F = Fun[X, cmpX, xeq, xflip, xtrans, Y, cmpY, yeq, yflip, ytrans, f, fmono,
    D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module G = Fun[Y, cmpY, yeq, yflip, ytrans, Z, cmpZ, zeq, zflip, ztrans, g, gmono,
    D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module GF = Fun[X, cmpX, xeq, xflip, xtrans, Z, cmpZ, zeq, zflip, ztrans, \ x -> g (f x),
    \ x x' -> trans O3 (cmpZ (g (f x)) (g (f x'))) (cmpY (f x) (f x')) (cmpX x x') (gmono (f x) (f x')) (fmono x x'),
    D0, D1, dlen, dones, did, dcomp, dmeet] ;

  Df-comp (d : F.DX.DenX) : Id G.DY.DenX (G.Df (F.Df d)) (GF.Df d) =
    G.DY.denXEq (map Y Z g (map X Y f d.1)) d.2.1 (G.Df (F.Df d)).2.2
      (map X Z (\ x -> g (f x)) d.1) (map-comp X Y Z f g d.1) d.2.1 (refl d.2.1) (GF.Df d).2.2 ;
} ;

------------------------------------------------------------------------
-- X = omega: the denotations with support in [p] form a copy of D(p)

ltN-cmp : (m n : N) -> Id Bool (isLt (cmpN m n)) (ltN m n) = split {
  zero -> split { zero -> refl false ; suc n -> refl true } ;
  suc m | r -> split { zero -> refl false ; suc n -> r n } } ;

ltN-zero-abs (A : U a) (y : N) (h : Id Bool (ltN y zero) true) : A =
  absurdB A (trans Bool false (ltN y zero) true (sym Bool (ltN y zero) false (ltN-zero y)) h) ;

ltN-irr (A : U a) : (k : N) -> Id Bool (ltN k k) true -> A = split {
  zero -> \ h -> absurdB A h ;
  suc k | r -> \ h -> r h } ;

ltN-suc : (k : N) -> Id Bool (ltN k (suc k)) true = split {
  zero -> refl true ;
  suc k | r -> r } ;

ltN-sucR : (t k : N) -> Id Bool (ltN t k) true -> Id Bool (ltN t (suc k)) true = split {
  zero -> \ k h -> refl true ;
  suc t | r -> split {
    zero -> \ h -> ltN-zero-abs (Id Bool (ltN (suc t) one) true) (suc t) h ;
    suc k -> \ h -> r k h } } ;

ltN-zs (y : N) : (z : N) -> Id Bool (ltN y z) true -> Id Bool (ltN zero z) true = split {
  zero -> \ h -> ltN-zero-abs (Id Bool (ltN zero zero) true) y h ;
  suc z -> \ h -> refl true } ;

-- k <= y < z gives k < z
ltN-le-lt : (k y z : N) -> Id Bool (ltN k (suc y)) true -> Id Bool (ltN y z) true -> Id Bool (ltN k z) true = split {
  zero -> \ y z h1 h2 -> ltN-zs y z h2 ;
  suc k | r -> split {
    zero -> \ z h1 h2 -> ltN-zero-abs (Id Bool (ltN (suc k) z) true) k h1 ;
    suc y -> split {
      zero -> \ h1 h2 -> ltN-zero-abs (Id Bool (ltN (suc k) zero) true) (suc y) h2 ;
      suc z -> \ h1 h2 -> r y z h1 h2 } } } ;

-- k <= y and y /= k give k < y
le-neq : (k y : N) -> Id Bool (ltN k (suc y)) true -> Id Bool (eqN y k) false -> Id Bool (ltN k y) true = split {
  zero -> split {
    zero -> \ h1 h2 -> absurdB (Id Bool false true) (sym Bool true false h2) ;
    suc y -> \ h1 h2 -> refl true } ;
  suc k | r -> split {
    zero -> \ h1 h2 -> ltN-zero-abs (Id Bool (ltN (suc k) zero) true) k h1 ;
    suc y -> \ h1 h2 -> r y h1 h2 } } ;

plus-zero : (n : N) -> Id N (plus n zero) n = split {
  zero -> refl zero ;
  suc n | r -> sucEq (plus n zero) n r } ;

plus-sucR : (n k : N) -> Id N (plus n (suc k)) (suc (plus n k)) = split {
  zero -> \ k -> refl (suc k) ;
  suc n | r -> \ k -> sucEq (plus n (suc k)) (suc (plus n k)) (r k) } ;

le-plus (k : N) : (n : N) -> Id Bool (ltN k (suc (plus n k))) true = split {
  zero -> ltN-suc k ;
  suc n | r -> ltN-sucR k (suc (plus n k)) r } ;

-- bounds on the elements of a list of numbers
geAll (k : N) : List N -> Bool = split {
  nilL -> true ;
  consL y l | r -> andB (ltN k (suc y)) r } ;

ltAll (m : N) : List N -> Bool = split {
  nilL -> true ;
  consL y l | r -> andB (ltN y m) r } ;

geAll0 : (a : List N) -> Id Bool (geAll zero a) true = split {
  nilL -> refl true ;
  consL y l | r -> r } ;

ltAll-shift (n k : N) (l : List N) (h : Id Bool (ltAll (suc (plus n k)) l) true) : Id Bool (ltAll (plus n (suc k)) l) true =
  subst N (\ m -> Id Bool (ltAll m l) true) (suc (plus n k)) (plus n (suc k))
    (sym N (plus n (suc k)) (suc (plus n k)) (plus-sucR n k)) h ;

-- rangeFrom n k = [k, .., k + n - 1]
rangeFrom : N -> N -> List N = split {
  zero -> \ k -> nilL ;
  suc n | r -> \ k -> consL k (r (suc k)) } ;

-- the characteristic word of a in [k, k + n)
charStep (k : N) : List N -> (List N -> Wd) -> Wd = split {
  nilL -> \ g -> o (g nilL) ;
  consL y l -> \ g -> ifW Wd (eqN y k) (i (g l)) (o (g (consL y l))) } ;

charW : N -> N -> List N -> Wd = split {
  zero -> \ k a -> nil ;
  suc n | r -> \ k a -> charStep k a (r (suc k)) } ;

module LN = LinOrd[N, cmpN, cmpN-eq, cmpN-flip, cmpN-trans] ;

lenL-range : (n k : N) -> Id N (LN.lenL (rangeFrom n k)) n = split {
  zero -> \ k -> refl zero ;
  suc n | r -> \ k -> sucEq (LN.lenL (rangeFrom n (suc k))) n (r (suc k)) } ;

allGt-range (t : N) : (n k : N) -> Id Bool (ltN t k) true -> Id Bool (LN.allGt t (rangeFrom n k)) true = split {
  zero -> \ k h -> refl true ;
  suc n | r -> \ k h -> andB-intro (LN.ltX t k) (LN.allGt t (rangeFrom n (suc k)))
                          (trans Bool (isLt (cmpN t k)) (ltN t k) true (ltN-cmp t k) h)
                          (r (suc k) (ltN-sucR t k h)) } ;

sorted-range : (n k : N) -> Id Bool (LN.sortedB (rangeFrom n k)) true = split {
  zero -> \ k -> refl true ;
  suc n | r -> \ k -> andB-intro (LN.allGt k (rangeFrom n (suc k))) (LN.sortedB (rangeFrom n (suc k)))
                        (allGt-range k n (suc k) (ltN-suc k)) (r (suc k)) } ;

ltAll-range : (n k : N) -> Id Bool (ltAll (plus n k) (rangeFrom n k)) true = split {
  zero -> \ k -> refl true ;
  suc n | r -> \ k -> andB-intro (ltN k (suc (plus n k))) (ltAll (suc (plus n k)) (rangeFrom n (suc k)))
                        (le-plus k n)
                        (subst N (\ m -> Id Bool (ltAll m (rangeFrom n (suc k))) true) (plus n (suc k)) (suc (plus n k))
                           (plus-sucR n k) (r (suc k))) } ;

ltAll-compL (m : N) : (c : List N) (w : Wd) -> Id Bool (ltAll m c) true -> Id Bool (ltAll m (LN.compL c w)) true = split {
  nilL -> \ w h -> refl true ;
  consL x c | r -> split {
    nil -> \ h -> r nil (andB-r (ltN x m) (ltAll m c) h) ;
    o w -> \ h -> r w (andB-r (ltN x m) (ltAll m c) h) ;
    i w -> \ h -> andB-intro (ltN x m) (ltAll m (LN.compL c w)) (andB-l (ltN x m) (ltAll m c) h)
                    (r w (andB-r (ltN x m) (ltAll m c) h)) } } ;

-- the elements above y are above k when k <= y
gt-geAll (k y : N) (hk : Id Bool (ltN k (suc y)) true)
  : (l : List N) -> Id Bool (LN.allGt y l) true -> Id Bool (geAll (suc k) l) true = split {
  nilL -> \ h -> refl true ;
  consL z l | r -> \ h -> andB-intro (ltN k z) (geAll (suc k) l)
                            (ltN-le-lt k y z hk
                               (trans Bool (ltN y z) (isLt (cmpN y z)) true (sym Bool (isLt (cmpN y z)) (ltN y z) (ltN-cmp y z))
                                  (andB-l (LN.ltX y z) (LN.allGt y l) h)))
                            (r (andB-r (LN.ltX y z) (LN.allGt y l) h)) } ;

-- a sorted list with elements in [k, k + n) is rangeFrom n k . charW n k a
RW (n k : N) (l : List N) : U a =
  Id N (len (charW n k l)) n * Id (List N) (LN.compL (rangeFrom n k) (charW n k l)) l ;

chW0 (k : N) : (a : List N) -> Id Bool (geAll k a) true -> Id Bool (ltAll k a) true -> RW zero k a = split {
  nilL -> \ hg hl -> (refl zero, refl nilL) ;
  consL y l -> \ hg hl -> ltN-irr (RW zero k (consL y l)) k
                            (ltN-le-lt k y k (andB-l (ltN k (suc y)) (geAll k l) hg) (andB-l (ltN y k) (ltAll k l) hl)) } ;

-- the induction hypothesis: for all lists, at n and suc k
IHW (n k : N) : U a =
  (a : List N) -> Id Bool (LN.sortedB a) true -> Id Bool (geAll (suc k) a) true
    -> Id Bool (ltAll (plus n (suc k)) a) true -> RW n (suc k) a ;

chC (n k : N) (ih : IHW n k) (y : N) (l : List N)
  (hs : Id Bool (LN.sortedB (consL y l)) true) (hg : Id Bool (geAll k (consL y l)) true)
  (hl : Id Bool (ltAll (suc (plus n k)) (consL y l)) true)
  : (b : Bool) -> Id Bool (eqN y k) b
    -> Id N (len (ifW Wd b (i (charW n (suc k) l)) (o (charW n (suc k) (consL y l))))) (suc n)
     * Id (List N) (LN.compL (consL k (rangeFrom n (suc k))) (ifW Wd b (i (charW n (suc k) l)) (o (charW n (suc k) (consL y l)))))
                   (consL y l) = split {
  true -> \ he ->
    (sucEq (len (charW n (suc k) l)) n
       (ih l (andB-r (LN.allGt y l) (LN.sortedB l) hs)
          (gt-geAll k y (andB-l (ltN k (suc y)) (geAll k l) hg) l (andB-l (LN.allGt y l) (LN.sortedB l) hs))
          (ltAll-shift n k l (andB-r (ltN y (suc (plus n k))) (ltAll (suc (plus n k)) l) hl))).1,
     trans (List N) (consL k (LN.compL (rangeFrom n (suc k)) (charW n (suc k) l))) (consL k l) (consL y l)
       (ap (List N) (List N) (\ t -> consL k t) (LN.compL (rangeFrom n (suc k)) (charW n (suc k) l)) l
          (ih l (andB-r (LN.allGt y l) (LN.sortedB l) hs)
             (gt-geAll k y (andB-l (ltN k (suc y)) (geAll k l) hg) l (andB-l (LN.allGt y l) (LN.sortedB l) hs))
             (ltAll-shift n k l (andB-r (ltN y (suc (plus n k))) (ltAll (suc (plus n k)) l) hl))).2)
       (ap N (List N) (\ t -> consL t l) k y (sym N y k (eqN-sound y k he)))) ;
  false -> \ he ->
    (sucEq (len (charW n (suc k) (consL y l))) n
       (ih (consL y l) hs
          (andB-intro (ltN k y) (geAll (suc k) l)
             (le-neq k y (andB-l (ltN k (suc y)) (geAll k l) hg) he)
             (gt-geAll k y (andB-l (ltN k (suc y)) (geAll k l) hg) l (andB-l (LN.allGt y l) (LN.sortedB l) hs)))
          (ltAll-shift n k (consL y l) hl)).1,
     (ih (consL y l) hs
        (andB-intro (ltN k y) (geAll (suc k) l)
           (le-neq k y (andB-l (ltN k (suc y)) (geAll k l) hg) he)
           (gt-geAll k y (andB-l (ltN k (suc y)) (geAll k l) hg) l (andB-l (LN.allGt y l) (LN.sortedB l) hs)))
        (ltAll-shift n k (consL y l) hl)).2) } ;

chS (n k : N) (ih : IHW n k) : (a : List N) -> Id Bool (LN.sortedB a) true -> Id Bool (geAll k a) true
  -> Id Bool (ltAll (suc (plus n k)) a) true -> RW (suc n) k a = split {
  nilL -> \ hs hg hl -> (sucEq (len (charW n (suc k) nilL)) n (ih nilL (refl true) (refl true) (refl true)).1,
                         (ih nilL (refl true) (refl true) (refl true)).2) ;
  consL y l -> \ hs hg hl -> chC n k ih y l hs hg hl (eqN y k) (refl (eqN y k)) } ;

chW : (n k : N) (a : List N) -> Id Bool (LN.sortedB a) true -> Id Bool (geAll k a) true
  -> Id Bool (ltAll (plus n k) a) true -> RW n k a = split {
  zero -> \ k a hs hg hl -> chW0 k a hg hl ;
  suc n | r -> \ k a hs hg hl -> chS n k (r (suc k)) a hs hg hl } ;

module Omega (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  module DN = LN.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;

  range (p : N) : List N = rangeFrom p zero ;

  -- D(p) into D(omega), along [0, .., p - 1] (of length p, by lenL-range)
  copy (p : N) (e : DN.PD.Den (LN.lenL (range p))) : DN.DenX = DN.embC (range p) (sorted-range p zero) e ;

  copy-order (p : N) (e e' : DN.PD.Den (LN.lenL (range p)))
    : Id O3 (DN.cmpDen (copy p e) (copy p e')) (cmpN (sel (D1 e.1) e.2.1) (sel (D1 e'.1) e'.2.1)) =
    DN.embC-order (range p) (sorted-range p zero) e e' ;

  copy-bound (p : N) (e : DN.PD.Den (LN.lenL (range p))) : Id Bool (ltAll p (copy p e).1) true =
    ltAll-compL p (range p) e.1
      (subst N (\ m -> Id Bool (ltAll m (range p)) true) (plus p zero) p (plus-zero p) (ltAll-range p zero)) ;

  -- every denotation with support in [p] is in the copy
  chP (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : RW p zero d.1 =
    chW p zero d.1 d.2.2.1 (geAll0 d.1)
      (subst N (\ m -> Id Bool (ltAll m d.1) true) p (plus p zero) (sym N (plus p zero) p (plus-zero p)) h) ;

  ovP (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : LN.Over (range p) (charW p zero d.1) d.1 =
    (trans N (len (charW p zero d.1)) p (LN.lenL (range p)) (chP p d h).1
       (sym N (LN.lenL (range p)) p (lenL-range p zero)),
     (chP p d h).2) ;

  copyPre (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : DN.PD.Den (LN.lenL (range p)) =
    (charW p zero d.1, d.2.1, (ovP p d h).1,
     subst N (\ k -> DN.TP k d.2.1) (LN.lenL d.1) (ones (charW p zero d.1))
       (sym N (ones (charW p zero d.1)) (LN.lenL d.1) (LN.onesOver (range p) (charW p zero d.1) d.1 (ovP p d h)))
       d.2.2.2) ;

  copy-onto (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : Id DN.DenX (copy p (copyPre p d h)) d =
    DN.denXEq (LN.compL (range p) (charW p zero d.1)) d.2.1 (copy p (copyPre p d h)).2.2
      d.1 (chP p d h).2 d.2.1 (refl d.2.1) d.2.2 ;

  -- the same copy, typed on D(p) itself: the denotations of D(p) and of
  -- D(lenL (range p)) differ only in the proof of the length
  toR (p : N) (e : DN.PD.Den p) : DN.PD.Den (LN.lenL (range p)) =
    (e.1, e.2.1, trans N (len e.1) p (LN.lenL (range p)) e.2.2.1 (sym N (LN.lenL (range p)) p (lenL-range p zero)),
     e.2.2.2) ;

  fromR (p : N) (e : DN.PD.Den (LN.lenL (range p))) : DN.PD.Den p =
    (e.1, e.2.1, trans N (len e.1) (LN.lenL (range p)) p e.2.2.1 (lenL-range p zero), e.2.2.2) ;

  copyP (p : N) (e : DN.PD.Den p) : DN.DenX = copy p (toR p e) ;

  copyP-order (p : N) (e e' : DN.PD.Den p)
    : Id O3 (DN.cmpDen (copyP p e) (copyP p e')) (cmpN (DN.PD.bwd p e).1 (DN.PD.bwd p e').1) =
    copy-order p (toR p e) (toR p e') ;

  copyP-onto (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : Id DN.DenX (copyP p (fromR p (copyPre p d h))) d =
    DN.denXEq (LN.compL (range p) (charW p zero d.1)) d.2.1 (copyP p (fromR p (copyPre p d h))).2.2
      d.1 (chP p d h).2 d.2.1 (refl d.2.1) d.2.2 ;

  -- on the points of D(p): the order of D(p) is the order of N, and every
  -- denotation bounded by p is the image of a point
  pt (p : N) (x : DN.PD.Pt p) : DN.DenX = copyP p (DN.PD.fwd p x) ;

  pt-order (p : N) (x x' : DN.PD.Pt p) : Id O3 (DN.cmpDen (pt p x) (pt p x')) (cmpN x.1 x'.1) =
    trans O3 (DN.cmpDen (pt p x) (pt p x')) (cmpN (DN.PD.bwd p (DN.PD.fwd p x)).1 (DN.PD.bwd p (DN.PD.fwd p x')).1)
             (cmpN x.1 x'.1)
      (copyP-order p (DN.PD.fwd p x) (DN.PD.fwd p x'))
      (ap2 N N O3 cmpN (DN.PD.bwd p (DN.PD.fwd p x)).1 x.1 (DN.PD.bwd p (DN.PD.fwd p x')).1 x'.1
         (DN.PD.bwd-fwd p x) (DN.PD.bwd-fwd p x')) ;

  ptPre (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : DN.PD.Pt p = DN.PD.bwd p (fromR p (copyPre p d h)) ;

  pt-onto (p : N) (d : DN.DenX) (h : Id Bool (ltAll p d.1) true) : Id DN.DenX (pt p (ptPre p d h)) d =
    trans DN.DenX (pt p (ptPre p d h)) (copyP p (fromR p (copyPre p d h))) d
      (ap (DN.PD.Den p) DN.DenX (copyP p) (DN.PD.fwd p (ptPre p d h)) (fromR p (copyPre p d h))
         (DN.PD.fwd-bwd-full p (fromR p (copyPre p d h))))
      (copyP-onto p d h) ;
} ;

------------------------------------------------------------------------
-- examples: X = N

five : N = suc four ;

-- Id . Id at N: the denotation ([x, y], z) with z = 2 is the pair (x, y),
-- with z = 1 the pair (y, x), and ([x], 0) is (x, x); pairs are compared
-- on the second component first
module IdIdN = LN.DenOrd[IdTimesId.P0, IdTimesId.P1, IdTimesId.plen, IdTimesId.pones,
  IdTimesId.pid, IdTimesId.pcomp, IdTimesId.pmeet] ;

module Ex {
  dA : IdIdN.DenX = (consL zero (consL five nilL), two, refl true, refl true, refl (i (i nil))) ;
  dB : IdIdN.DenX = (consL three nilL, zero, refl true, refl true, refl (i nil)) ;
  dC : IdIdN.DenX = (consL zero (consL five nilL), one, refl true, refl true, refl (i (i nil))) ;

  #conv IdIdN.cmpDen dA dB = gt ;
  #conv IdIdN.cmpDen dC dB = lt ;
  #conv IdIdN.cmpDen dA dC = gt ;
  #conv IdIdN.cmpDen dB dB = eq ;
} ;

-- the copy of D(6) in D(omega): ([0, 5], 2) comes from the word
-- i o o o o i of length 6, and back
six : N = suc five ;
module OmIdId = Omega[IdTimesId.P0, IdTimesId.P1, IdTimesId.plen, IdTimesId.pones,
  IdTimesId.pid, IdTimesId.pcomp, IdTimesId.pmeet] ;
#conv (OmIdId.copyPre six Ex.dA (refl true)).1 = i (o (o (o (o (i nil))))) ;
#conv (OmIdId.copy six (OmIdId.copyPre six Ex.dA (refl true))).1 = consL zero (consL five nilL) ;

-- D(X) is again a decidable linear order
module LIdIdN = LinOrd[IdIdN.DenX, IdIdN.cmpDen, IdIdN.den-eq, IdIdN.den-flip, IdIdN.den-trans] ;

------------------------------------------------------------------------
-- (d) well-foundedness.  Accessibility is an inductive predicate; since
-- there are no indexed families, it is a W-type of trees, each node
-- labelled by a point and branching over its predecessors, with a
-- recursive condition (Good) that the labels are the right ones.

ltO (A : U a) (cmp : A -> A -> O3) (x y : A) : Bool = isLt (cmp x y) ;

module Acc (A : U a) (lt : A -> A -> Bool) {
  Lt (x y : A) : U a = Id Bool (lt x y) true ;

  data AT : U a = node (x : A) (f : (y : A) -> Lt y x -> AT) ;

  Good : AT -> A -> U a = split {
    node x0 f | r -> \ x -> Id A x0 x * ((y : A) (h : Lt y x0) -> r y h y) } ;

  AccP (x : A) : U a = (t : AT) * Good t x ;

  WF : U a = (x : A) -> AccP x ;

  acc (x : A) (k : (y : A) -> Lt y x -> AccP y) : AccP x =
    (node x (\ y h -> (k y h).1), refl x, \ y h -> (k y h).2) ;

  -- the induction principle
  indT (P : A -> U a) (step : (x : A) -> ((y : A) -> Lt y x -> P y) -> P x)
    : (t : AT) (x : A) -> Good t x -> P x = split {
    node x0 f | r -> \ x g -> subst A P x0 x g.1 (step x0 (\ y h -> r y h y (g.2 y h))) } ;

  ind (P : A -> U a) (step : (x : A) -> ((y : A) -> Lt y x -> P y) -> P x) (x : A) (ax : AccP x) : P x =
    indT P step ax.1 x ax.2 ;

  -- the predecessors of an accessible point are accessible
  accPred (x : A) (ax : AccP x) : (y : A) -> Lt y x -> AccP y =
    ind (\ x1 -> (y : A) -> Lt y x1 -> AccP y) (\ x1 ih y h -> acc y (ih y h)) x ax ;
} ;

-- accessibility is pulled back along a map preserving the order
module Pull (A : U a) (ltA : A -> A -> Bool) (B : U a) (ltB : B -> B -> Bool) (f : A -> B)
  (mono : (x y : A) -> Id Bool (ltA x y) true -> Id Bool (ltB (f x) (f y)) true) {
  module AA = Acc[A, ltA] ;
  module AB = Acc[B, ltB] ;

  pull (x : A) (bx : AB.AccP (f x)) : AA.AccP x =
    AB.ind (\ b -> (x1 : A) -> Id B (f x1) b -> AA.AccP x1)
      (\ b ih x1 e -> AA.acc x1 (\ y h -> ih (f y) (subst B (\ c -> AB.Lt (f y) c) (f x1) b e (mono y x1 h)) y (refl (f y))))
      (f x) bx x (refl (f x)) ;

  pullWF (w : AB.WF) : AA.WF = \ x -> pull x (w (f x)) ;
} ;


-- the ordered sum A + B: all of A, then all of B
module SumOrd (A : U a) (ltA : A -> A -> Bool) (B : U a) (ltB : B -> B -> Bool) {
  ltS : Or A B -> Or A B -> Bool = split {
    inl x -> split { inl y -> ltA x y ; inr y -> true } ;
    inr x -> split { inl y -> false ; inr y -> ltB x y } } ;

  module AA = Acc[A, ltA] ;
  module AB = Acc[B, ltB] ;
  module AS = Acc[Or A B, ltS] ;

  predL (x : A) (ih : (y : A) -> AA.Lt y x -> AS.AccP (inl y)) : (s : Or A B) -> AS.Lt s (inl x) -> AS.AccP s = split {
    inl y -> \ h -> ih y h ;
    inr y -> \ h -> absurdB (AS.AccP (inr y)) h } ;

  accL (x : A) (ax : AA.AccP x) : AS.AccP (inl x) =
    AA.ind (\ x1 -> AS.AccP (inl x1)) (\ x1 ih -> AS.acc (inl x1) (predL x1 ih)) x ax ;

  predR (wa : AA.WF) (x : B) (ih : (y : B) -> AB.Lt y x -> AS.AccP (inr y)) : (s : Or A B) -> AS.Lt s (inr x) -> AS.AccP s = split {
    inl y -> \ h -> accL y (wa y) ;
    inr y -> \ h -> ih y h } ;

  accR (wa : AA.WF) (x : B) (bx : AB.AccP x) : AS.AccP (inr x) =
    AB.ind (\ x1 -> AS.AccP (inr x1)) (\ x1 ih -> AS.acc (inr x1) (predR wa x1 ih)) x bx ;

  wfS (wa : AA.WF) (wb : AB.WF) : AS.WF = split {
    inl x -> accL x (wa x) ;
    inr x -> accR wa x (wb x) } ;
} ;

-- the lexicographic product A * B, the first component first
lexO3 : O3 -> O3 -> O3 = split { lt -> \ c -> lt ; eq -> \ c -> c ; gt -> \ c -> gt } ;

module LexOrd (A : U a) (cmpA : A -> A -> O3) (aeq : (x y : A) -> Id O3 (cmpA x y) eq -> Id A x y)
  (B : U a) (cmpB : B -> B -> O3) {
  ltP (p q : A * B) : Bool = isLt (lexO3 (cmpA p.1 q.1) (cmpB p.2 q.2)) ;

  module AA = Acc[A, ltO A cmpA] ;
  module AB = Acc[B, ltO B cmpB] ;
  module AP = Acc[A * B, ltP] ;

  -- the predecessors of (x, y), by cases on the first components
  predP (x : A) (y : B) (ih1 : (x1 : A) -> AA.Lt x1 x -> (y1 : B) -> AP.AccP (x1, y1))
    (ih2 : (y1 : B) -> AB.Lt y1 y -> AP.AccP (x, y1)) (q : A * B)
    : (c : O3) -> Id O3 (cmpA q.1 x) c -> AP.Lt q (x, y) -> AP.AccP q = split {
    lt -> \ e h -> ih1 q.1 (ap O3 Bool isLt (cmpA q.1 x) lt e) q.2 ;
    eq -> \ e h -> subst A (\ x1 -> AP.AccP (x1, q.2)) x q.1 (sym A q.1 x (aeq q.1 x e))
                     (ih2 q.2 (subst O3 (\ c -> Id Bool (isLt (lexO3 c (cmpB q.2 y))) true) (cmpA q.1 x) eq e h)) ;
    gt -> \ e h -> absurdB (AP.AccP q) (subst O3 (\ c -> Id Bool (isLt (lexO3 c (cmpB q.2 y))) true) (cmpA q.1 x) gt e h) } ;

  accX (wb : AB.WF) (x : A) (ax : AA.AccP x) : (y : B) -> AP.AccP (x, y) =
    AA.ind (\ x1 -> (y : B) -> AP.AccP (x1, y))
      (\ x1 ih1 y0 -> AB.ind (\ y1 -> AP.AccP (x1, y1))
          (\ y1 ih2 -> AP.acc (x1, y1) (\ q h -> predP x1 y1 ih1 ih2 q (cmpA q.1 x1) (refl (cmpA q.1 x1)) h))
          y0 (wb y0))
      x ax ;

  wfP (wa : AA.WF) (wb : AB.WF) : AP.WF = \ p -> accX wb p.1 (wa p.1) p.2 ;
} ;

-- N is well-founded
module AN = Acc[N, ltO N cmpN] ;

isLt-cmpN0 : (m : N) -> Id Bool (isLt (cmpN m zero)) false = split {
  zero -> refl false ; suc m -> refl false } ;

orSuc (m n : N) : Or (Id Bool (isLt (cmpN m n)) true) (Id N m n)
  -> Or (Id Bool (isLt (cmpN (suc m) (suc n))) true) (Id N (suc m) (suc n)) = split {
  inl h -> inl h ;
  inr e -> inr (sucEq m n e) } ;

-- m < n + 1 gives m < n or m = n
ltS-cases : (m n : N) -> Id Bool (isLt (cmpN m (suc n))) true -> Or (Id Bool (isLt (cmpN m n)) true) (Id N m n) = split {
  zero -> split {
    zero -> \ h -> inr (refl zero) ;
    suc n -> \ h -> inl (refl true) } ;
  suc m | r -> split {
    zero -> \ h -> absurdB (Or (Id Bool (isLt (cmpN (suc m) zero)) true) (Id N (suc m) zero))
                     (trans Bool false (isLt (cmpN m zero)) true (sym Bool (isLt (cmpN m zero)) false (isLt-cmpN0 m)) h) ;
    suc n -> \ h -> orSuc m n (r n h) } } ;

accN-step (n : N) (r : (m : N) -> AN.Lt m n -> AN.AccP m) (m : N)
  : Or (Id Bool (isLt (cmpN m n)) true) (Id N m n) -> AN.AccP m = split {
  inl h -> r m h ;
  inr e -> subst N (\ k -> AN.AccP k) n m (sym N m n e) (AN.acc n r) } ;

accN-below : (n m : N) -> AN.Lt m n -> AN.AccP m = split {
  zero -> \ m h -> absurdB (AN.AccP m)
                     (trans Bool false (isLt (cmpN m zero)) true (sym Bool (isLt (cmpN m zero)) false (isLt-cmpN0 m)) h) ;
  suc n | r -> \ m h -> accN-step n r m (ltS-cases m n h) } ;

wfN : AN.WF = \ n -> AN.acc n (accN-below n) ;

------------------------------------------------------------------------
-- arithmetic and words for the sum and the product

plus-assoc : (x y z : N) -> Id N (plus (plus x y) z) (plus x (plus y z)) = split {
  zero -> \ y z -> refl (plus y z) ;
  suc x | r -> \ y z -> sucEq (plus (plus x y) z) (plus x (plus y z)) (r y z) } ;

cmpN-plus : (L x y : N) -> Id O3 (cmpN (plus L x) (plus L y)) (cmpN x y) = split {
  zero -> \ x y -> refl (cmpN x y) ;
  suc L | r -> \ x y -> r x y } ;

ltN-plus : (L x y : N) -> Id Bool (ltN (plus L x) (plus L y)) (ltN x y) = split {
  zero -> \ x y -> refl (ltN x y) ;
  suc L | r -> \ x y -> r x y } ;

-- x < L gives x < L + k
cmpN-lt-plus : (x L k : N) -> Id Bool (ltN x L) true -> Id O3 (cmpN x (plus L k)) lt = split {
  zero -> split {
    zero -> \ k h -> absurdB (Id O3 (cmpN zero (plus zero k)) lt) h ;
    suc L -> \ k h -> refl lt } ;
  suc x | r -> split {
    zero -> \ k h -> absurdB (Id O3 (cmpN (suc x) (plus zero k)) lt) h ;
    suc L -> \ k h -> r L k h } } ;

cmpN-gt-plus (x L k : N) (h : Id Bool (ltN x L) true) : Id O3 (cmpN (plus L k) x) gt =
  trans O3 (cmpN (plus L k) x) (flip (cmpN x (plus L k))) gt
    (cmpN-flip x (plus L k)) (ap O3 O3 flip (cmpN x (plus L k)) lt (cmpN-lt-plus x L k h)) ;

at-app-l : (A : Wd) (z : N) (B : Wd) -> Id Bool (ltN z (len A)) true -> Id Bool (at (app A B) z) (at A z) = split {
  nil -> \ z B h -> ltN-zero-abs (Id Bool (at B z) false) z h ;
  o A | r -> split { zero -> \ B h -> refl false ; suc z -> \ B h -> r z B h } ;
  i A | r -> split { zero -> \ B h -> refl true ; suc z -> \ B h -> r z B h } } ;

at-app-r : (A B : Wd) (y : N) -> Id Bool (at (app A B) (plus (len A) y)) (at B y) = split {
  nil -> \ B y -> refl (at B y) ;
  o A | r -> \ B y -> r B y ;
  i A | r -> \ B y -> r B y } ;

sel-app-l : (A : Wd) (z : N) (B : Wd) -> Id Bool (ltN z (ones A)) true -> Id N (sel (app A B) z) (sel A z) = split {
  nil -> \ z B h -> ltN-zero-abs (Id N (sel B z) zero) z h ;
  o A | r -> \ z B h -> sucEq (sel (app A B) z) (sel A z) (r z B h) ;
  i A | r -> split {
    zero -> \ B h -> refl zero ;
    suc z -> \ B h -> sucEq (sel (app A B) z) (sel A z) (r z B h) } } ;

sel-app-r : (A B : Wd) (y : N) -> Id N (sel (app A B) (plus (ones A) y)) (plus (len A) (sel B y)) = split {
  nil -> \ B y -> refl (sel B y) ;
  o A | r -> \ B y -> sucEq (sel (app A B) (plus (ones A) y)) (plus (len A) (sel B y)) (r B y) ;
  i A | r -> \ B y -> sucEq (sel (app A B) (plus (ones A) y)) (plus (len A) (sel B y)) (r B y) } ;

sel-app-zeros : (k : N) (B : Wd) (y : N) -> Id N (sel (app (zeros k) B) y) (plus k (sel B y)) = split {
  zero -> \ B y -> refl (sel B y) ;
  suc k | r -> \ B y -> sucEq (sel (app (zeros k) B) y) (plus k (sel B y)) (r B y) } ;

sel-lt (A : Wd) (z : N) (h : Id Bool (ltN z (ones A)) true) : Id Bool (ltN (sel A z) (len A)) true =
  at-lt A (sel A z) (at-sel A z h) ;

-- the point j of the block e of kron E D (the blocks have length ones D)
sel-kron : (EW : Wd) (e : N) (DW : Wd) (j : N) -> Id Bool (ltN e (ones EW)) true -> Id Bool (ltN j (ones DW)) true
  -> Id N (sel (kron EW DW) (plus (mul e (ones DW)) j)) (plus (mul (sel EW e) (len DW)) (sel DW j)) = split {
  nil -> \ e DW j he hj -> ltN-zero-abs (Id N zero (plus (mul zero (len DW)) (sel DW j))) e he ;
  o EW | r -> \ e DW j he hj ->
    trans N (sel (kron (o EW) DW) (plus (mul e (ones DW)) j))
            (plus (len DW) (sel (kron EW DW) (plus (mul e (ones DW)) j)))
            (plus (mul (sel (o EW) e) (len DW)) (sel DW j))
      (sel-app-zeros (len DW) (kron EW DW) (plus (mul e (ones DW)) j))
      (trans N (plus (len DW) (sel (kron EW DW) (plus (mul e (ones DW)) j)))
               (plus (len DW) (plus (mul (sel EW e) (len DW)) (sel DW j)))
               (plus (mul (sel (o EW) e) (len DW)) (sel DW j))
         (ap N N (\ k -> plus (len DW) k) (sel (kron EW DW) (plus (mul e (ones DW)) j))
            (plus (mul (sel EW e) (len DW)) (sel DW j)) (r e DW j he hj))
         (sym N (plus (plus (len DW) (mul (sel EW e) (len DW))) (sel DW j))
                (plus (len DW) (plus (mul (sel EW e) (len DW)) (sel DW j)))
            (plus-assoc (len DW) (mul (sel EW e) (len DW)) (sel DW j)))) ;
  i EW | r -> split {
    zero -> \ DW j he hj -> sel-app-l DW j (kron EW DW) hj ;
    suc e -> \ DW j he hj ->
      trans N (sel (kron (i EW) DW) (plus (mul (suc e) (ones DW)) j))
              (sel (app DW (kron EW DW)) (plus (ones DW) (plus (mul e (ones DW)) j)))
              (plus (mul (sel (i EW) (suc e)) (len DW)) (sel DW j))
        (ap N N (\ k -> sel (app DW (kron EW DW)) k) (plus (plus (ones DW) (mul e (ones DW))) j)
           (plus (ones DW) (plus (mul e (ones DW)) j)) (plus-assoc (ones DW) (mul e (ones DW)) j))
        (trans N (sel (app DW (kron EW DW)) (plus (ones DW) (plus (mul e (ones DW)) j)))
                 (plus (len DW) (sel (kron EW DW) (plus (mul e (ones DW)) j)))
                 (plus (mul (sel (i EW) (suc e)) (len DW)) (sel DW j))
           (sel-app-r DW (kron EW DW) (plus (mul e (ones DW)) j))
           (trans N (plus (len DW) (sel (kron EW DW) (plus (mul e (ones DW)) j)))
                    (plus (len DW) (plus (mul (sel EW e) (len DW)) (sel DW j)))
                    (plus (mul (sel (i EW) (suc e)) (len DW)) (sel DW j))
              (ap N N (\ k -> plus (len DW) k) (sel (kron EW DW) (plus (mul e (ones DW)) j))
                 (plus (mul (sel EW e) (len DW)) (sel DW j)) (r e DW j he hj))
              (sym N (plus (plus (len DW) (mul (sel EW e) (len DW))) (sel DW j))
                     (plus (len DW) (plus (mul (sel EW e) (len DW)) (sel DW j)))
                 (plus-assoc (len DW) (mul (sel EW e) (len DW)) (sel DW j))))) } } ;

-- with B, B' < L, comparing A.L + B and A'.L + B' is lexicographic
cmp-lex (L : N) : (A A' B B' : N) -> Id Bool (ltN B L) true -> Id Bool (ltN B' L) true
  -> Id O3 (cmpN (plus (mul A L) B) (plus (mul A' L) B')) (lexO3 (cmpN A A') (cmpN B B')) = split {
  zero -> split {
    zero -> \ B B' h h' -> refl (cmpN B B') ;
    suc A' -> \ B B' h h' ->
      trans O3 (cmpN B (plus (plus L (mul A' L)) B')) (cmpN B (plus L (plus (mul A' L) B'))) lt
        (ap N O3 (\ k -> cmpN B k) (plus (plus L (mul A' L)) B') (plus L (plus (mul A' L) B'))
           (plus-assoc L (mul A' L) B'))
        (cmpN-lt-plus B L (plus (mul A' L) B') h) } ;
  suc A | r -> split {
    zero -> \ B B' h h' ->
      trans O3 (cmpN (plus (plus L (mul A L)) B) B') (cmpN (plus L (plus (mul A L) B)) B') gt
        (ap N O3 (\ k -> cmpN k B') (plus (plus L (mul A L)) B) (plus L (plus (mul A L) B))
           (plus-assoc L (mul A L) B))
        (cmpN-gt-plus B' L (plus (mul A L) B) h') ;
    suc A' -> \ B B' h h' ->
      trans O3 (cmpN (plus (plus L (mul A L)) B) (plus (plus L (mul A' L)) B'))
               (cmpN (plus L (plus (mul A L) B)) (plus L (plus (mul A' L) B')))
               (lexO3 (cmpN A A') (cmpN B B'))
        (ap2 N N O3 cmpN (plus (plus L (mul A L)) B) (plus L (plus (mul A L) B))
           (plus (plus L (mul A' L)) B') (plus L (plus (mul A' L) B'))
           (plus-assoc L (mul A L) B) (plus-assoc L (mul A' L) B'))
        (trans O3 (cmpN (plus L (plus (mul A L) B)) (plus L (plus (mul A' L) B')))
                  (cmpN (plus (mul A L) B) (plus (mul A' L) B'))
                  (lexO3 (cmpN A A') (cmpN B B'))
           (cmpN-plus L (plus (mul A L) B) (plus (mul A' L) B'))
           (r A' B B' h h')) } } ;

-- z < L, or z = L + y
cutS (L z : N) : Or (Id Bool (ltN z L) true) ((y : N) * Id N z (plus L y))
  -> Or (Id Bool (ltN (suc z) (suc L)) true) ((y : N) * Id N (suc z) (plus (suc L) y)) = split {
  inl h -> inl h ;
  inr p -> inr (p.1, sucEq z (plus L p.1) p.2) } ;

cut : (L z : N) -> Or (Id Bool (ltN z L) true) ((y : N) * Id N z (plus L y)) = split {
  zero -> \ z -> inr (z, refl z) ;
  suc L | r -> split {
    zero -> inl (refl true) ;
    suc z -> cutS L z (r z) } } ;

-- division with remainder: z < E.L gives z = q.L + r with r < L and q < E
QR (L E z : N) : U a =
  (q : N) * (r : N) * (Id N z (plus (mul q L) r) * (Id Bool (ltN r L) true * Id Bool (ltN q E) true)) ;

hyLt (L E z y : N) (e : Id N z (plus L y)) (h : Id Bool (ltN z (plus L (mul E L))) true)
  : Id Bool (ltN y (mul E L)) true =
  trans Bool (ltN y (mul E L)) (ltN (plus L y) (plus L (mul E L))) true
    (sym Bool (ltN (plus L y) (plus L (mul E L))) (ltN y (mul E L)) (ltN-plus L y (mul E L)))
    (subst N (\ k -> Id Bool (ltN k (plus L (mul E L))) true) z (plus L y) e h) ;

dmR (L E z y : N) (e : Id N z (plus L y)) (qy : QR L E y) : QR L (suc E) z =
  (suc qy.1, qy.2.1,
   trans N z (plus L y) (plus (plus L (mul qy.1 L)) qy.2.1) e
     (trans N (plus L y) (plus L (plus (mul qy.1 L) qy.2.1)) (plus (plus L (mul qy.1 L)) qy.2.1)
        (ap N N (\ k -> plus L k) y (plus (mul qy.1 L) qy.2.1) qy.2.2.1)
        (sym N (plus (plus L (mul qy.1 L)) qy.2.1) (plus L (plus (mul qy.1 L) qy.2.1))
           (plus-assoc L (mul qy.1 L) qy.2.1))),
   qy.2.2.2.1, qy.2.2.2.2) ;

dmStep (L E : N) (r : (z : N) -> Id Bool (ltN z (mul E L)) true -> QR L E z) (z : N)
  (h : Id Bool (ltN z (plus L (mul E L))) true)
  : Or (Id Bool (ltN z L) true) ((y : N) * Id N z (plus L y)) -> QR L (suc E) z = split {
  inl hl -> (zero, z, refl z, hl, refl true) ;
  inr p -> dmR L E z p.1 p.2 (r p.1 (hyLt L E z p.1 p.2 h)) } ;

dm (L : N) : (E z : N) -> Id Bool (ltN z (mul E L)) true -> QR L E z = split {
  zero -> \ z h -> ltN-zero-abs (QR L zero z) z h ;
  suc E | r -> \ z h -> dmStep L E r z h (cut L z) } ;

-- the single point z of [n], for the trace of the identity
pt : N -> N -> Wd = split {
  zero -> \ z -> nil ;
  suc n | r -> split { zero -> i (zeros n) ; suc z -> o (r z) } } ;

len-pt : (n z : N) -> Id N (len (pt n z)) n = split {
  zero -> \ z -> refl zero ;
  suc n | r -> split {
    zero -> sucEq (len (zeros n)) n (len-zeros n) ;
    suc z -> sucEq (len (pt n z)) n (r z) } } ;

at-pt : (n z : N) -> Id Bool (ltN z n) true -> Id Bool (at (pt n z) z) true = split {
  zero -> \ z h -> ltN-zero-abs (Id Bool (at nil z) true) z h ;
  suc n | r -> split {
    zero -> \ h -> refl true ;
    suc z -> \ h -> r z h } } ;

ones-pt : (n z : N) -> Id Bool (ltN z n) true -> Id N (ones (pt n z)) one = split {
  zero -> \ z h -> ltN-zero-abs (Id N zero one) z h ;
  suc n | r -> split {
    zero -> \ h -> sucEq (ones (zeros n)) zero (ones-zeros n) ;
    suc z -> \ h -> r z h } } ;

lt-one : (z : N) -> Id Bool (ltN z one) true -> Id N z zero = split {
  zero -> \ h -> refl zero ;
  suc z -> \ h -> ltN-zero-abs (Id N (suc z) zero) z h } ;

------------------------------------------------------------------------
-- the denotations of the identity, of 1, of a sum and of a product are
-- well-founded at a well-founded X: each maps into X, a point, an
-- ordered sum or a lexicographic product, preserving the order

module IdWF (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt) {
  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
  module DI = LX.DenOrd[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
    \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w)] ;

  -- the trace of the identity is Tr(1) = {0}: the point z of [n] is a
  -- support of z, so it is the identity, and n = 1
  lenOne (d : DI.DenX) : Id N (LX.lenL d.1) one =
    trans N (LX.lenL d.1) (ones (idW (LX.lenL d.1))) one
      (sym N (ones (idW (LX.lenL d.1))) (LX.lenL d.1) (ones-idW (LX.lenL d.1)))
      (trans N (ones (idW (LX.lenL d.1))) (ones (pt (LX.lenL d.1) d.2.1)) one
         (ap Wd N ones (idW (LX.lenL d.1)) (pt (LX.lenL d.1) d.2.1)
            (sym Wd (pt (LX.lenL d.1) d.2.1) (idW (LX.lenL d.1))
               (DI.PD.supp-trace (LX.lenL d.1) d.2.1 d.2.2.2.1 d.2.2.2.2 (pt (LX.lenL d.1) d.2.1)
                  (len-pt (LX.lenL d.1) d.2.1) (at-pt (LX.lenL d.1) d.2.1 d.2.2.2.1))))
         (ones-pt (LX.lenL d.1) d.2.1 d.2.2.2.1)) ;

  zZero (d : DI.DenX) : Id N d.2.1 zero =
    lt-one d.2.1 (subst N (\ k -> Id Bool (ltN d.2.1 k) true) (LX.lenL d.1) one (lenOne d) d.2.2.2.1) ;

  lenL0 : (l : List X) -> Id N (LX.lenL l) zero -> Id (List X) l nilL = split {
    nilL -> \ h -> refl nilL ;
    consL x l -> \ h -> absurdN (Id (List X) (consL x l) nilL) (LX.lenL l) (sym N (suc (LX.lenL l)) zero h) } ;

  single : (l : List X) -> Id N (LX.lenL l) one -> (x : X) * Id (List X) l (consL x nilL) = split {
    nilL -> \ h -> absurdN ((x : X) * Id (List X) nilL (consL x nilL)) zero h ;
    consL x l -> \ h -> (x, ap (List X) (List X) (\ k -> consL x k) l nilL (lenL0 l (sucInj (LX.lenL l) zero h))) } ;

  phi (d : DI.DenX) : X = (single d.1 (lenOne d)).1 ;

  F (q q' : List X * N) : O3 = cmpN (sel (LX.merge q.1 q'.1).2.1 q.2) (sel (LX.merge q.1 q'.1).2.2 q'.2) ;

  -- the comparison of two singletons is the comparison in X
  cmpOne (x y : X) : (c : O3) -> Id O3 (cmpN
      (sel (LX.stepM x y (consL y nilL, o nil, i nil) (nilL, nil, nil) (consL x nilL, i nil, o nil) c).2.1 zero)
      (sel (LX.stepM x y (consL y nilL, o nil, i nil) (nilL, nil, nil) (consL x nilL, i nil, o nil) c).2.2 zero)) c = split {
    lt -> refl lt ; eq -> refl eq ; gt -> refl gt } ;

  phi-cmp (d d' : DI.DenX) : Id O3 (DI.cmpDen d d') (cmpX (phi d) (phi d')) =
    trans O3 (F (d.1, d.2.1) (d'.1, d'.2.1)) (F (consL (phi d) nilL, zero) (consL (phi d') nilL, zero)) (cmpX (phi d) (phi d'))
      (ap2 (List X * N) (List X * N) O3 F (d.1, d.2.1) (consL (phi d) nilL, zero) (d'.1, d'.2.1) (consL (phi d') nilL, zero)
         (prodEq (List X) N (d.1, d.2.1) (consL (phi d) nilL, zero) (single d.1 (lenOne d)).2 (zZero d))
         (prodEq (List X) N (d'.1, d'.2.1) (consL (phi d') nilL, zero) (single d'.1 (lenOne d')).2 (zZero d')))
      (cmpOne (phi d) (phi d') (cmpX (phi d) (phi d'))) ;

  mono (d d' : DI.DenX) (h : Id Bool (ltO DI.DenX DI.cmpDen d d') true) : Id Bool (ltO X cmpX (phi d) (phi d')) true =
    trans Bool (isLt (cmpX (phi d) (phi d'))) (isLt (DI.cmpDen d d')) true
      (ap O3 Bool isLt (cmpX (phi d) (phi d')) (DI.cmpDen d d') (sym O3 (DI.cmpDen d d') (cmpX (phi d) (phi d')) (phi-cmp d d')))
      h ;

  module PI = Pull[DI.DenX, ltO DI.DenX DI.cmpDen, X, ltO X cmpX, phi, mono] ;

  wf (wx : Acc[X, ltO X cmpX].WF) : Acc[DI.DenX, ltO DI.DenX DI.cmpDen].WF = PI.pullWF wx ;
} ;

module OneWF (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt) {
  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
  module DK = LX.DenOrd[\ n -> one, \ w -> i nil, \ w -> refl one, \ w -> refl one,
    \ n -> refl (i nil), \ v w h -> refl (i nil), \ v w h -> refl (i nil)] ;
  module AK = Acc[DK.DenX, ltO DK.DenX DK.cmpDen] ;

  -- the trace point is 0, so all comparisons are eq: there is no descent
  allEq (d d' : DK.DenX) : Id O3 (DK.cmpDen d' d) eq =
    ap2 N N O3 (\ z1 z2 -> cmpN (sel (i nil) z1) (sel (i nil) z2)) d'.2.1 zero d.2.1 zero
      (lt-one d'.2.1 d'.2.2.2.1) (lt-one d.2.1 d.2.2.2.1) ;

  wf : AK.WF = \ d -> AK.acc d (\ d' h -> absurdB (AK.AccP d')
    (trans Bool false (isLt (DK.cmpDen d' d)) true
       (ap O3 Bool isLt eq (DK.cmpDen d' d) (sym O3 (DK.cmpDen d' d) eq (allEq d d'))) h)) ;
} ;

module SumWF (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w))) {
  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
  module SD = SumDil[D0, D1, dlen, dones, did, dcomp, dmeet, E0, E1, elen, eones, eid, ecomp, emeet] ;
  module DD = LX.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module DE = LX.DenOrd[E0, E1, elen, eones, eid, ecomp, emeet] ;
  module DS = LX.DenOrd[SD.S0, SD.S1, SD.slen, SD.sones, SD.sid, SD.scomp, SD.smeet] ;

  lenD (v : Wd) (n : N) (hl : Id N (len v) n) : Id N (len (D1 v)) (D0 n) =
    trans N (len (D1 v)) (D0 (len v)) (D0 n) (dlen v) (ap N N D0 (len v) n hl) ;

  onesD (u : Wd) (n : N) (hu : Id N (ones u) n) : Id N (ones (D1 u)) (D0 n) =
    trans N (ones (D1 u)) (D0 (ones u)) (D0 n) (dones u) (ap N N D0 (ones u) n hu) ;

  ltOnesD (u : Wd) (n : N) (hu : Id N (ones u) n) (z : N) (h : Id Bool (ltN z (D0 n)) true)
    : Id Bool (ltN z (ones (D1 u))) true =
    subst N (\ k -> Id Bool (ltN z k) true) (D0 n) (ones (D1 u)) (sym N (ones (D1 u)) (D0 n) (onesD u n hu)) h ;

  -- the trace of D + E below D(n) is the trace of D, above it that of E
  trD (n z : N) (hz : Id Bool (ltN z (D0 n)) true) (tr : DS.PD.InTr n z) : DD.PD.InTr n z =
    \ v hl hv -> tr v hl
      (trans Bool (at (SD.S1 v) z) (at (D1 v) z) true
         (at-app-l (D1 v) z (E1 v)
            (subst N (\ k -> Id Bool (ltN z k) true) (D0 n) (len (D1 v)) (sym N (len (D1 v)) (D0 n) (lenD v n hl)) hz))
         hv) ;

  trE (n y : N) (tr : DS.PD.InTr n (plus (D0 n) y)) : DE.PD.InTr n y =
    \ v hl hv -> tr v hl
      (trans Bool (at (SD.S1 v) (plus (D0 n) y)) (at (E1 v) y) true
         (trans Bool (at (SD.S1 v) (plus (D0 n) y)) (at (SD.S1 v) (plus (len (D1 v)) y)) (at (E1 v) y)
            (ap N Bool (\ k -> at (SD.S1 v) (plus k y)) (D0 n) (len (D1 v)) (sym N (len (D1 v)) (D0 n) (lenD v n hl)))
            (at-app-r (D1 v) (E1 v) y))
         hv) ;

  hyE (n z y : N) (e : Id N z (plus (D0 n) y)) (h : Id Bool (ltN z (plus (D0 n) (E0 n))) true)
    : Id Bool (ltN y (E0 n)) true =
    trans Bool (ltN y (E0 n)) (ltN (plus (D0 n) y) (plus (D0 n) (E0 n))) true
      (sym Bool (ltN (plus (D0 n) y) (plus (D0 n) (E0 n))) (ltN y (E0 n)) (ltN-plus (D0 n) y (E0 n)))
      (subst N (\ k -> Id Bool (ltN k (plus (D0 n) (E0 n))) true) z (plus (D0 n) y) e h) ;

  Cut (d : DS.DenX) : U a =
    Or (Id Bool (ltN d.2.1 (D0 (LX.lenL d.1))) true) ((y : N) * Id N d.2.1 (plus (D0 (LX.lenL d.1)) y)) ;

  phi0 (d : DS.DenX) : Cut d -> Or DD.DenX DE.DenX = split {
    inl h -> inl (d.1, d.2.1, d.2.2.1, h,
                  DD.PD.trace-supp (LX.lenL d.1) d.2.1 h
                    (trD (LX.lenL d.1) d.2.1 h (DS.PD.supp-trace (LX.lenL d.1) d.2.1 d.2.2.2.1 d.2.2.2.2))) ;
    inr q -> inr (d.1, q.1, d.2.2.1, hyE (LX.lenL d.1) d.2.1 q.1 q.2 d.2.2.2.1,
                  DE.PD.trace-supp (LX.lenL d.1) q.1 (hyE (LX.lenL d.1) d.2.1 q.1 q.2 d.2.2.2.1)
                    (trE (LX.lenL d.1) q.1
                       (subst N (\ k -> DS.PD.InTr (LX.lenL d.1) k) d.2.1 (plus (D0 (LX.lenL d.1)) q.1) q.2
                          (DS.PD.supp-trace (LX.lenL d.1) d.2.1 d.2.2.2.1 d.2.2.2.2)))) } ;

  phi (d : DS.DenX) : Or DD.DenX DE.DenX = phi0 d (cut (D0 (LX.lenL d.1)) d.2.1) ;

  -- the points of D + E at the union
  selL (u : Wd) (n : N) (hu : Id N (ones u) n) (z : N) (h : Id Bool (ltN z (D0 n)) true)
    : Id N (sel (SD.S1 u) z) (sel (D1 u) z) = sel-app-l (D1 u) z (E1 u) (ltOnesD u n hu z h) ;

  selR (u : Wd) (n : N) (hu : Id N (ones u) n) (y : N)
    : Id N (sel (SD.S1 u) (plus (D0 n) y)) (plus (D0 (len u)) (sel (E1 u) y)) =
    trans N (sel (SD.S1 u) (plus (D0 n) y)) (sel (SD.S1 u) (plus (ones (D1 u)) y)) (plus (D0 (len u)) (sel (E1 u) y))
      (ap N N (\ k -> sel (SD.S1 u) (plus k y)) (D0 n) (ones (D1 u)) (sym N (ones (D1 u)) (D0 n) (onesD u n hu)))
      (trans N (sel (SD.S1 u) (plus (ones (D1 u)) y)) (plus (len (D1 u)) (sel (E1 u) y)) (plus (D0 (len u)) (sel (E1 u) y))
         (sel-app-r (D1 u) (E1 u) y)
         (ap N N (\ k -> plus k (sel (E1 u) y)) (len (D1 u)) (D0 (len u)) (dlen u))) ;

  kS (d d' : DS.DenX) : LX.Cov d.1 d'.1 (LX.merge d.1 d'.1) = LX.mergeOK d.1 d'.1 d.2.2.1 d'.2.2.1 ;

  hu1 (d d' : DS.DenX) : Id N (ones (LX.merge d.1 d'.1).2.1) (LX.lenL d.1) =
    LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d.1 (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (kS d d')) ;

  hu2 (d d' : DS.DenX) : Id N (ones (LX.merge d.1 d'.1).2.2) (LX.lenL d'.1) =
    LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d'.1 (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (kS d d')) ;

  lenEq (d d' : DS.DenX) : Id N (len (LX.merge d.1 d'.1).2.2) (len (LX.merge d.1 d'.1).2.1) =
    trans N (len (LX.merge d.1 d'.1).2.2) (LX.lenL (LX.merge d.1 d'.1).1) (len (LX.merge d.1 d'.1).2.1)
      (kS d d').2.1 (sym N (len (LX.merge d.1 d'.1).2.1) (LX.lenL (LX.merge d.1 d'.1).1) (kS d d').1) ;

  eqLL (d d' : DS.DenX) (h : Id Bool (ltN d.2.1 (D0 (LX.lenL d.1))) true) (h' : Id Bool (ltN d'.2.1 (D0 (LX.lenL d'.1))) true)
    : Id O3 (DS.cmpDen d d') (cmpN (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)) =
    ap2 N N O3 cmpN (sel (SD.S1 (LX.merge d.1 d'.1).2.1) d.2.1) (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1)
      (sel (SD.S1 (LX.merge d.1 d'.1).2.2) d'.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)
      (selL (LX.merge d.1 d'.1).2.1 (LX.lenL d.1) (hu1 d d') d.2.1 h)
      (selL (LX.merge d.1 d'.1).2.2 (LX.lenL d'.1) (hu2 d d') d'.2.1 h') ;

  eqRR (d d' : DS.DenX) (q : (y : N) * Id N d.2.1 (plus (D0 (LX.lenL d.1)) y))
    (q' : (y : N) * Id N d'.2.1 (plus (D0 (LX.lenL d'.1)) y))
    : Id O3 (DS.cmpDen d d') (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) q.1) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1)) =
    trans O3 (DS.cmpDen d d')
      (cmpN (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
            (plus (D0 (len (LX.merge d.1 d'.1).2.2)) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1)))
      (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) q.1) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))
      (ap2 N N O3 cmpN (sel (SD.S1 (LX.merge d.1 d'.1).2.1) d.2.1)
         (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
         (sel (SD.S1 (LX.merge d.1 d'.1).2.2) d'.2.1)
         (plus (D0 (len (LX.merge d.1 d'.1).2.2)) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))
         (trans N (sel (SD.S1 (LX.merge d.1 d'.1).2.1) d.2.1)
                  (sel (SD.S1 (LX.merge d.1 d'.1).2.1) (plus (D0 (LX.lenL d.1)) q.1))
                  (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
            (ap N N (\ k -> sel (SD.S1 (LX.merge d.1 d'.1).2.1) k) d.2.1 (plus (D0 (LX.lenL d.1)) q.1) q.2)
            (selR (LX.merge d.1 d'.1).2.1 (LX.lenL d.1) (hu1 d d') q.1))
         (trans N (sel (SD.S1 (LX.merge d.1 d'.1).2.2) d'.2.1)
                  (sel (SD.S1 (LX.merge d.1 d'.1).2.2) (plus (D0 (LX.lenL d'.1)) q'.1))
                  (plus (D0 (len (LX.merge d.1 d'.1).2.2)) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))
            (ap N N (\ k -> sel (SD.S1 (LX.merge d.1 d'.1).2.2) k) d'.2.1 (plus (D0 (LX.lenL d'.1)) q'.1) q'.2)
            (selR (LX.merge d.1 d'.1).2.2 (LX.lenL d'.1) (hu2 d d') q'.1)))
      (trans O3
         (cmpN (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
               (plus (D0 (len (LX.merge d.1 d'.1).2.2)) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1)))
         (cmpN (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
               (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1)))
         (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) q.1) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))
         (ap N O3 (\ k -> cmpN (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
                               (plus (D0 k) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1)))
            (len (LX.merge d.1 d'.1).2.2) (len (LX.merge d.1 d'.1).2.1) (lenEq d d'))
         (cmpN-plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1)
            (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))) ;

  -- a point of E is above every point of D
  eqRL (d d' : DS.DenX) (q : (y : N) * Id N d.2.1 (plus (D0 (LX.lenL d.1)) y))
    (h' : Id Bool (ltN d'.2.1 (D0 (LX.lenL d'.1))) true) : Id O3 (DS.cmpDen d d') gt =
    trans O3 (DS.cmpDen d d')
      (cmpN (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
            (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1))
      gt
      (ap2 N N O3 cmpN (sel (SD.S1 (LX.merge d.1 d'.1).2.1) d.2.1)
         (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
         (sel (SD.S1 (LX.merge d.1 d'.1).2.2) d'.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)
         (trans N (sel (SD.S1 (LX.merge d.1 d'.1).2.1) d.2.1)
                  (sel (SD.S1 (LX.merge d.1 d'.1).2.1) (plus (D0 (LX.lenL d.1)) q.1))
                  (plus (D0 (len (LX.merge d.1 d'.1).2.1)) (sel (E1 (LX.merge d.1 d'.1).2.1) q.1))
            (ap N N (\ k -> sel (SD.S1 (LX.merge d.1 d'.1).2.1) k) d.2.1 (plus (D0 (LX.lenL d.1)) q.1) q.2)
            (selR (LX.merge d.1 d'.1).2.1 (LX.lenL d.1) (hu1 d d') q.1))
         (selL (LX.merge d.1 d'.1).2.2 (LX.lenL d'.1) (hu2 d d') d'.2.1 h'))
      (cmpN-gt-plus (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1) (D0 (len (LX.merge d.1 d'.1).2.1))
         (sel (E1 (LX.merge d.1 d'.1).2.1) q.1)
         (subst N (\ k -> Id Bool (ltN (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1) k) true)
            (len (D1 (LX.merge d.1 d'.1).2.2)) (D0 (len (LX.merge d.1 d'.1).2.1))
            (lenD (LX.merge d.1 d'.1).2.2 (len (LX.merge d.1 d'.1).2.1) (lenEq d d'))
            (sel-lt (D1 (LX.merge d.1 d'.1).2.2) d'.2.1
               (ltOnesD (LX.merge d.1 d'.1).2.2 (LX.lenL d'.1) (hu2 d d') d'.2.1 h')))) ;

  module SO = SumOrd[DD.DenX, ltO DD.DenX DD.cmpDen, DE.DenX, ltO DE.DenX DE.cmpDen] ;

  monoC (d d' : DS.DenX) : (c : Cut d) (c' : Cut d') -> Id Bool (ltO DS.DenX DS.cmpDen d d') true
    -> Id Bool (SO.ltS (phi0 d c) (phi0 d' c')) true = split {
    inl h -> split {
      inl h' -> \ hl -> trans Bool (isLt (cmpN (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)))
                         (isLt (DS.cmpDen d d')) true
                         (ap O3 Bool isLt (cmpN (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1))
                            (DS.cmpDen d d')
                            (sym O3 (DS.cmpDen d d') (cmpN (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1))
                               (eqLL d d' h h')))
                         hl ;
      inr q' -> \ hl -> refl true } ;
    inr q -> split {
      inl h' -> \ hl -> absurdB (Id Bool false true)
                         (trans Bool false (isLt (DS.cmpDen d d')) true
                            (ap O3 Bool isLt gt (DS.cmpDen d d') (sym O3 (DS.cmpDen d d') gt (eqRL d d' q h')))
                            hl) ;
      inr q' -> \ hl -> trans Bool (isLt (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) q.1) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1)))
                         (isLt (DS.cmpDen d d')) true
                         (ap O3 Bool isLt (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) q.1) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))
                            (DS.cmpDen d d')
                            (sym O3 (DS.cmpDen d d') (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) q.1) (sel (E1 (LX.merge d.1 d'.1).2.2) q'.1))
                               (eqRR d d' q q')))
                         hl } } ;

  mono (d d' : DS.DenX) (h : Id Bool (ltO DS.DenX DS.cmpDen d d') true) : Id Bool (SO.ltS (phi d) (phi d')) true =
    monoC d d' (cut (D0 (LX.lenL d.1)) d.2.1) (cut (D0 (LX.lenL d'.1)) d'.2.1) h ;

  module PS = Pull[DS.DenX, ltO DS.DenX DS.cmpDen, Or DD.DenX DE.DenX, SO.ltS, phi, mono] ;

  wf (wd : Acc[DD.DenX, ltO DD.DenX DD.cmpDen].WF) (we : Acc[DE.DenX, ltO DE.DenX DE.cmpDen].WF)
    : Acc[DS.DenX, ltO DS.DenX DS.cmpDen].WF = PS.pullWF (SO.wfS wd we) ;
} ;

module ProdWF (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w))) {
  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
  module PR = ProdDil[D0, D1, dlen, dones, did, dcomp, dmeet, E0, E1, elen, eones, eid, ecomp, emeet] ;
  module DD = LX.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module DE = LX.DenOrd[E0, E1, elen, eones, eid, ecomp, emeet] ;
  module DP = LX.DenOrd[PR.P0, PR.P1, PR.plen, PR.pones, PR.pid, PR.pcomp, PR.pmeet] ;

  onesD (u : Wd) (n : N) (hu : Id N (ones u) n) : Id N (ones (D1 u)) (D0 n) =
    trans N (ones (D1 u)) (D0 (ones u)) (D0 n) (dones u) (ap N N D0 (ones u) n hu) ;

  onesE (u : Wd) (n : N) (hu : Id N (ones u) n) : Id N (ones (E1 u)) (E0 n) =
    trans N (ones (E1 u)) (E0 (ones u)) (E0 n) (eones u) (ap N N E0 (ones u) n hu) ;

  ltOnesD (u : Wd) (n : N) (hu : Id N (ones u) n) (z : N) (h : Id Bool (ltN z (D0 n)) true)
    : Id Bool (ltN z (ones (D1 u))) true =
    subst N (\ k -> Id Bool (ltN z k) true) (D0 n) (ones (D1 u)) (sym N (ones (D1 u)) (D0 n) (onesD u n hu)) h ;

  ltOnesE (u : Wd) (n : N) (hu : Id N (ones u) n) (z : N) (h : Id Bool (ltN z (E0 n)) true)
    : Id Bool (ltN z (ones (E1 u))) true =
    subst N (\ k -> Id Bool (ltN z k) true) (E0 n) (ones (E1 u)) (sym N (ones (E1 u)) (E0 n) (onesE u n hu)) h ;

  -- a point of D . E at n is a pair: z = e.D(n) + j
  qr (d : DP.DenX) : QR (D0 (LX.lenL d.1)) (E0 (LX.lenL d.1)) d.2.1 =
    dm (D0 (LX.lenL d.1)) (E0 (LX.lenL d.1)) d.2.1 d.2.2.2.1 ;

  ptE (d : DP.DenX) : DE.PD.Den (LX.lenL d.1) =
    DE.PD.fwd (LX.lenL d.1) ((qr d).1, DE.PD.hzOf (LX.lenL d.1) (qr d).1 (qr d).2.2.2.2) ;

  ptD (d : DP.DenX) : DD.PD.Den (LX.lenL d.1) =
    DD.PD.fwd (LX.lenL d.1) ((qr d).2.1, DD.PD.hzOf (LX.lenL d.1) (qr d).2.1 (qr d).2.2.2.1) ;

  phiE (d : DP.DenX) : DE.DenX = DE.embC d.1 d.2.2.1 (ptE d) ;

  phiD (d : DP.DenX) : DD.DenX = DD.embC d.1 d.2.2.1 (ptD d) ;

  phi (d : DP.DenX) : DE.DenX * DD.DenX = (phiE d, phiD d) ;

  selP (u : Wd) (n : N) (hu : Id N (ones u) n) (e j : N) (he : Id Bool (ltN e (E0 n)) true) (hj : Id Bool (ltN j (D0 n)) true)
    : Id N (sel (PR.P1 u) (plus (mul e (D0 n)) j)) (plus (mul (sel (E1 u) e) (len (D1 u))) (sel (D1 u) j)) =
    trans N (sel (PR.P1 u) (plus (mul e (D0 n)) j)) (sel (PR.P1 u) (plus (mul e (ones (D1 u))) j))
            (plus (mul (sel (E1 u) e) (len (D1 u))) (sel (D1 u) j))
      (ap N N (\ k -> sel (PR.P1 u) (plus (mul e k) j)) (D0 n) (ones (D1 u)) (sym N (ones (D1 u)) (D0 n) (onesD u n hu)))
      (sel-kron (E1 u) e (D1 u) j (ltOnesE u n hu e he) (ltOnesD u n hu j hj)) ;

  kS (d d' : DP.DenX) : LX.Cov d.1 d'.1 (LX.merge d.1 d'.1) = LX.mergeOK d.1 d'.1 d.2.2.1 d'.2.2.1 ;

  hu1 (d d' : DP.DenX) : Id N (ones (LX.merge d.1 d'.1).2.1) (LX.lenL d.1) =
    LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d.1 (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (kS d d')) ;

  hu2 (d d' : DP.DenX) : Id N (ones (LX.merge d.1 d'.1).2.2) (LX.lenL d'.1) =
    LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d'.1 (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (kS d d')) ;

  -- the two blocks have the same length D(lenL c)
  lenDD (d d' : DP.DenX) : Id N (len (D1 (LX.merge d.1 d'.1).2.2)) (len (D1 (LX.merge d.1 d'.1).2.1)) =
    trans N (len (D1 (LX.merge d.1 d'.1).2.2)) (D0 (len (LX.merge d.1 d'.1).2.2)) (len (D1 (LX.merge d.1 d'.1).2.1)) (dlen (LX.merge d.1 d'.1).2.2)
      (trans N (D0 (len (LX.merge d.1 d'.1).2.2)) (D0 (len (LX.merge d.1 d'.1).2.1)) (len (D1 (LX.merge d.1 d'.1).2.1))
         (ap N N D0 (len (LX.merge d.1 d'.1).2.2) (len (LX.merge d.1 d'.1).2.1)
            (trans N (len (LX.merge d.1 d'.1).2.2) (LX.lenL (LX.merge d.1 d'.1).1) (len (LX.merge d.1 d'.1).2.1)
               (kS d d').2.1 (sym N (len (LX.merge d.1 d'.1).2.1) (LX.lenL (LX.merge d.1 d'.1).1) (kS d d').1)))
         (sym N (len (D1 (LX.merge d.1 d'.1).2.1)) (D0 (len (LX.merge d.1 d'.1).2.1)) (dlen (LX.merge d.1 d'.1).2.1))) ;

  A1 (d d' : DP.DenX) : N = sel (E1 (LX.merge d.1 d'.1).2.1) (qr d).1 ;
  A2 (d d' : DP.DenX) : N = sel (E1 (LX.merge d.1 d'.1).2.2) (qr d').1 ;
  B1 (d d' : DP.DenX) : N = sel (D1 (LX.merge d.1 d'.1).2.1) (qr d).2.1 ;
  B2 (d d' : DP.DenX) : N = sel (D1 (LX.merge d.1 d'.1).2.2) (qr d').2.1 ;
  L (d d' : DP.DenX) : N = len (D1 (LX.merge d.1 d'.1).2.1) ;

  hB1 (d d' : DP.DenX) : Id Bool (ltN (B1 d d') (L d d')) true =
    sel-lt (D1 (LX.merge d.1 d'.1).2.1) (qr d).2.1 (ltOnesD (LX.merge d.1 d'.1).2.1 (LX.lenL d.1) (hu1 d d') (qr d).2.1 (qr d).2.2.2.1) ;

  hB2 (d d' : DP.DenX) : Id Bool (ltN (B2 d d') (L d d')) true =
    subst N (\ k -> Id Bool (ltN (B2 d d') k) true) (len (D1 (LX.merge d.1 d'.1).2.2)) (L d d') (lenDD d d')
      (sel-lt (D1 (LX.merge d.1 d'.1).2.2) (qr d').2.1 (ltOnesD (LX.merge d.1 d'.1).2.2 (LX.lenL d'.1) (hu2 d d') (qr d').2.1 (qr d').2.2.2.1)) ;

  -- the order of D . E is lexicographic, E first
  eqArith (d d' : DP.DenX)
    : Id O3 (DP.cmpDen d d') (lexO3 (cmpN (A1 d d') (A2 d d')) (cmpN (B1 d d') (B2 d d'))) =
    trans O3 (DP.cmpDen d d')
      (cmpN (plus (mul (A1 d d') (L d d')) (B1 d d')) (plus (mul (A2 d d') (len (D1 (LX.merge d.1 d'.1).2.2))) (B2 d d')))
      (lexO3 (cmpN (A1 d d') (A2 d d')) (cmpN (B1 d d') (B2 d d')))
      (ap2 N N O3 cmpN (sel (PR.P1 (LX.merge d.1 d'.1).2.1) d.2.1) (plus (mul (A1 d d') (L d d')) (B1 d d'))
         (sel (PR.P1 (LX.merge d.1 d'.1).2.2) d'.2.1) (plus (mul (A2 d d') (len (D1 (LX.merge d.1 d'.1).2.2))) (B2 d d'))
         (trans N (sel (PR.P1 (LX.merge d.1 d'.1).2.1) d.2.1)
                  (sel (PR.P1 (LX.merge d.1 d'.1).2.1) (plus (mul (qr d).1 (D0 (LX.lenL d.1))) (qr d).2.1))
                  (plus (mul (A1 d d') (L d d')) (B1 d d'))
            (ap N N (\ k -> sel (PR.P1 (LX.merge d.1 d'.1).2.1) k) d.2.1 (plus (mul (qr d).1 (D0 (LX.lenL d.1))) (qr d).2.1) (qr d).2.2.1)
            (selP (LX.merge d.1 d'.1).2.1 (LX.lenL d.1) (hu1 d d') (qr d).1 (qr d).2.1 (qr d).2.2.2.2 (qr d).2.2.2.1))
         (trans N (sel (PR.P1 (LX.merge d.1 d'.1).2.2) d'.2.1)
                  (sel (PR.P1 (LX.merge d.1 d'.1).2.2) (plus (mul (qr d').1 (D0 (LX.lenL d'.1))) (qr d').2.1))
                  (plus (mul (A2 d d') (len (D1 (LX.merge d.1 d'.1).2.2))) (B2 d d'))
            (ap N N (\ k -> sel (PR.P1 (LX.merge d.1 d'.1).2.2) k) d'.2.1 (plus (mul (qr d').1 (D0 (LX.lenL d'.1))) (qr d').2.1) (qr d').2.2.1)
            (selP (LX.merge d.1 d'.1).2.2 (LX.lenL d'.1) (hu2 d d') (qr d').1 (qr d').2.1 (qr d').2.2.2.2 (qr d').2.2.2.1)))
      (trans O3 (cmpN (plus (mul (A1 d d') (L d d')) (B1 d d')) (plus (mul (A2 d d') (len (D1 (LX.merge d.1 d'.1).2.2))) (B2 d d')))
                (cmpN (plus (mul (A1 d d') (L d d')) (B1 d d')) (plus (mul (A2 d d') (L d d')) (B2 d d')))
                (lexO3 (cmpN (A1 d d') (A2 d d')) (cmpN (B1 d d') (B2 d d')))
         (ap N O3 (\ k -> cmpN (plus (mul (A1 d d') (L d d')) (B1 d d')) (plus (mul (A2 d d') k) (B2 d d')))
            (len (D1 (LX.merge d.1 d'.1).2.2)) (L d d') (lenDD d d'))
         (cmp-lex (L d d') (A1 d d') (A2 d d') (B1 d d') (B2 d d') (hB1 d d') (hB2 d d'))) ;

  -- and the two components are the comparisons in E(X) and D(X)
  eqE (d d' : DP.DenX) : Id O3 (DE.cmpDen (phiE d) (phiE d')) (cmpN (A1 d d') (A2 d d')) =
    trans O3 (DE.cmpDen (phiE d) (phiE d'))
      (cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) (DE.PD.bwd (LX.lenL d.1) (ptE d)).1) (sel (E1 (LX.merge d.1 d'.1).2.2) (DE.PD.bwd (LX.lenL d'.1) (ptE d')).1))
      (cmpN (A1 d d') (A2 d d'))
      (DE.embC-cmp d.1 d'.1 d.2.2.1 d'.2.2.1 (ptE d) (ptE d'))
      (ap2 N N O3 (\ k k' -> cmpN (sel (E1 (LX.merge d.1 d'.1).2.1) k) (sel (E1 (LX.merge d.1 d'.1).2.2) k'))
         (DE.PD.bwd (LX.lenL d.1) (ptE d)).1 (qr d).1 (DE.PD.bwd (LX.lenL d'.1) (ptE d')).1 (qr d').1
         (DE.PD.bwd-fwd (LX.lenL d.1) ((qr d).1, DE.PD.hzOf (LX.lenL d.1) (qr d).1 (qr d).2.2.2.2))
         (DE.PD.bwd-fwd (LX.lenL d'.1) ((qr d').1, DE.PD.hzOf (LX.lenL d'.1) (qr d').1 (qr d').2.2.2.2))) ;

  eqD (d d' : DP.DenX) : Id O3 (DD.cmpDen (phiD d) (phiD d')) (cmpN (B1 d d') (B2 d d')) =
    trans O3 (DD.cmpDen (phiD d) (phiD d'))
      (cmpN (sel (D1 (LX.merge d.1 d'.1).2.1) (DD.PD.bwd (LX.lenL d.1) (ptD d)).1) (sel (D1 (LX.merge d.1 d'.1).2.2) (DD.PD.bwd (LX.lenL d'.1) (ptD d')).1))
      (cmpN (B1 d d') (B2 d d'))
      (DD.embC-cmp d.1 d'.1 d.2.2.1 d'.2.2.1 (ptD d) (ptD d'))
      (ap2 N N O3 (\ k k' -> cmpN (sel (D1 (LX.merge d.1 d'.1).2.1) k) (sel (D1 (LX.merge d.1 d'.1).2.2) k'))
         (DD.PD.bwd (LX.lenL d.1) (ptD d)).1 (qr d).2.1 (DD.PD.bwd (LX.lenL d'.1) (ptD d')).1 (qr d').2.1
         (DD.PD.bwd-fwd (LX.lenL d.1) ((qr d).2.1, DD.PD.hzOf (LX.lenL d.1) (qr d).2.1 (qr d).2.2.2.1))
         (DD.PD.bwd-fwd (LX.lenL d'.1) ((qr d').2.1, DD.PD.hzOf (LX.lenL d'.1) (qr d').2.1 (qr d').2.2.2.1))) ;

  phi-cmp (d d' : DP.DenX)
    : Id O3 (DP.cmpDen d d') (lexO3 (DE.cmpDen (phiE d) (phiE d')) (DD.cmpDen (phiD d) (phiD d'))) =
    trans O3 (DP.cmpDen d d') (lexO3 (cmpN (A1 d d') (A2 d d')) (cmpN (B1 d d') (B2 d d')))
      (lexO3 (DE.cmpDen (phiE d) (phiE d')) (DD.cmpDen (phiD d) (phiD d')))
      (eqArith d d')
      (ap2 O3 O3 O3 lexO3 (cmpN (A1 d d') (A2 d d')) (DE.cmpDen (phiE d) (phiE d'))
         (cmpN (B1 d d') (B2 d d')) (DD.cmpDen (phiD d) (phiD d'))
         (sym O3 (DE.cmpDen (phiE d) (phiE d')) (cmpN (A1 d d') (A2 d d')) (eqE d d'))
         (sym O3 (DD.cmpDen (phiD d) (phiD d')) (cmpN (B1 d d') (B2 d d')) (eqD d d'))) ;

  module LO = LexOrd[DE.DenX, DE.cmpDen, DE.den-eq, DD.DenX, DD.cmpDen] ;

  mono (d d' : DP.DenX) (h : Id Bool (ltO DP.DenX DP.cmpDen d d') true) : Id Bool (LO.ltP (phi d) (phi d')) true =
    trans Bool (LO.ltP (phi d) (phi d')) (isLt (DP.cmpDen d d')) true
      (ap O3 Bool isLt (lexO3 (DE.cmpDen (phiE d) (phiE d')) (DD.cmpDen (phiD d) (phiD d'))) (DP.cmpDen d d')
         (sym O3 (DP.cmpDen d d') (lexO3 (DE.cmpDen (phiE d) (phiE d')) (DD.cmpDen (phiD d) (phiD d'))) (phi-cmp d d')))
      h ;

  module PP = Pull[DP.DenX, ltO DP.DenX DP.cmpDen, DE.DenX * DD.DenX, LO.ltP, phi, mono] ;

  wf (wd : Acc[DD.DenX, ltO DD.DenX DD.cmpDen].WF) (we : Acc[DE.DenX, ltO DE.DenX DE.cmpDen].WF)
    : Acc[DP.DenX, ltO DP.DenX DP.cmpDen].WF = PP.pullWF (LO.wfP we wd) ;
} ;

------------------------------------------------------------------------
-- (e) the exponential.  2^X is the set of finite subsets of X, ordered
-- by the largest element of the symmetric difference: as a linear order,
-- the decreasing lists of X compared lexicographically.  On the finite
-- ordinals 2^n = pow2 n, the subset s of [n] being the number whose bit
-- k is 1 when k is in s.  The pre-dilator 2^D is 2^- composed with D.

dblN : N -> N = split {
  zero -> zero ;
  suc n | r -> suc (suc r) } ;

pow2 : N -> N = split {
  zero -> one ;
  suc n | r -> dblN r } ;

-- lo w: every letter of w followed by o; dbl w: every letter doubled
lo : Wd -> Wd = split {
  nil -> nil ;
  o w | r -> o (o r) ;
  i w | r -> i (o r) } ;

dbl : Wd -> Wd = split {
  nil -> nil ;
  o w | r -> o (o r) ;
  i w | r -> i (i r) } ;

-- 2^w for w : [m] -> [n]: the position j < 2^n is in the image iff the
-- subset j of [n] is inside the image of w (the bit 0 of j is the first
-- letter of w, so the first letter splits j into its parity and its half)
exW : Wd -> Wd = split {
  nil -> i nil ;
  o w | r -> lo r ;
  i w | r -> dbl r } ;

len-lo : (w : Wd) -> Id N (len (lo w)) (dblN (len w)) = split {
  nil -> refl zero ;
  o w | r -> sucEq (suc (len (lo w))) (suc (dblN (len w))) (sucEq (len (lo w)) (dblN (len w)) r) ;
  i w | r -> sucEq (suc (len (lo w))) (suc (dblN (len w))) (sucEq (len (lo w)) (dblN (len w)) r) } ;

len-dbl : (w : Wd) -> Id N (len (dbl w)) (dblN (len w)) = split {
  nil -> refl zero ;
  o w | r -> sucEq (suc (len (dbl w))) (suc (dblN (len w))) (sucEq (len (dbl w)) (dblN (len w)) r) ;
  i w | r -> sucEq (suc (len (dbl w))) (suc (dblN (len w))) (sucEq (len (dbl w)) (dblN (len w)) r) } ;

ones-lo : (w : Wd) -> Id N (ones (lo w)) (ones w) = split {
  nil -> refl zero ;
  o w | r -> r ;
  i w | r -> sucEq (ones (lo w)) (ones w) r } ;

ones-dbl : (w : Wd) -> Id N (ones (dbl w)) (dblN (ones w)) = split {
  nil -> refl zero ;
  o w | r -> r ;
  i w | r -> sucEq (suc (ones (dbl w))) (suc (dblN (ones w))) (sucEq (ones (dbl w)) (dblN (ones w)) r) } ;

len-ex : (w : Wd) -> Id N (len (exW w)) (pow2 (len w)) = split {
  nil -> refl one ;
  o w | r -> trans N (len (lo (exW w))) (dblN (len (exW w))) (dblN (pow2 (len w)))
               (len-lo (exW w)) (ap N N dblN (len (exW w)) (pow2 (len w)) r) ;
  i w | r -> trans N (len (dbl (exW w))) (dblN (len (exW w))) (dblN (pow2 (len w)))
               (len-dbl (exW w)) (ap N N dblN (len (exW w)) (pow2 (len w)) r) } ;

ones-ex : (w : Wd) -> Id N (ones (exW w)) (pow2 (ones w)) = split {
  nil -> refl one ;
  o w | r -> trans N (ones (lo (exW w))) (ones (exW w)) (pow2 (ones w)) (ones-lo (exW w)) r ;
  i w | r -> trans N (ones (dbl (exW w))) (dblN (ones (exW w))) (dblN (pow2 (ones w)))
               (ones-dbl (exW w)) (ap N N dblN (ones (exW w)) (pow2 (ones w)) r) } ;

dbl-id : (k : N) -> Id Wd (dbl (idW k)) (idW (dblN k)) = split {
  zero -> refl nil ;
  suc k | r -> ap Wd Wd (\ u -> i (i u)) (dbl (idW k)) (idW (dblN k)) r } ;

ex-id : (n : N) -> Id Wd (exW (idW n)) (idW (pow2 n)) = split {
  zero -> refl (i nil) ;
  suc n | r -> trans Wd (dbl (exW (idW n))) (dbl (idW (pow2 n))) (idW (dblN (pow2 n)))
                 (ap Wd Wd dbl (exW (idW n)) (idW (pow2 n)) r) (dbl-id (pow2 n)) } ;

-- composition
lo-cons : (c : Bool) (w : Wd) -> Id Wd (lo (cons c w)) (cons c (o (lo w))) = split {
  false -> \ w -> refl (o (o (lo w))) ;
  true -> \ w -> refl (i (o (lo w))) } ;

comp-lo : (A B : Wd) -> Id Wd (compW (lo A) B) (lo (compW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> \ B -> ap Wd Wd (\ u -> o (o u)) (compW (lo A) B) (lo (compW A B)) (r B) ;
  i A | r -> \ B -> trans Wd (cons (hd B) (o (compW (lo A) (tl B)))) (cons (hd B) (o (lo (compW A (tl B)))))
                      (lo (compW (i A) B))
                      (ap Wd Wd (\ u -> cons (hd B) (o u)) (compW (lo A) (tl B)) (lo (compW A (tl B))) (r (tl B)))
                      (sym Wd (lo (cons (hd B) (compW A (tl B)))) (cons (hd B) (o (lo (compW A (tl B)))))
                         (lo-cons (hd B) (compW A (tl B)))) } ;

comp-dbl-dbl : (A B : Wd) -> Id Wd (compW (dbl A) (dbl B)) (dbl (compW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> \ B -> ap Wd Wd (\ u -> o (o u)) (compW (dbl A) (dbl B)) (dbl (compW A B)) (r B) ;
  i A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (compW (dbl A) nil) (dbl (compW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (compW (dbl A) (dbl B)) (dbl (compW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> i (i u)) (compW (dbl A) (dbl B)) (dbl (compW A B)) (r B) } } ;

comp-dbl-lo : (A B : Wd) -> Id Wd (compW (dbl A) (lo B)) (lo (compW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> \ B -> ap Wd Wd (\ u -> o (o u)) (compW (dbl A) (lo B)) (lo (compW A B)) (r B) ;
  i A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (compW (dbl A) nil) (lo (compW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (compW (dbl A) (lo B)) (lo (compW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> i (o u)) (compW (dbl A) (lo B)) (lo (compW A B)) (r B) } } ;

ex-comp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (exW (compW v w)) (compW (exW v) (exW w)) = split {
  nil -> \ w h -> subst Wd (\ u -> Id Wd (i nil) (compW (i nil) (exW u))) nil w
                    (sym Wd w nil (len-zero w (sym N zero (len w) h))) (refl (i nil)) ;
  o v | r -> \ w h -> trans Wd (lo (exW (compW v w))) (lo (compW (exW v) (exW w))) (compW (lo (exW v)) (exW w))
                        (ap Wd Wd lo (exW (compW v w)) (compW (exW v) (exW w)) (r w h))
                        (sym Wd (compW (lo (exW v)) (exW w)) (lo (compW (exW v) (exW w))) (comp-lo (exW v) (exW w))) ;
  i v | r -> split {
    nil -> \ h -> absurdN (Id Wd (exW (compW (i v) nil)) (compW (exW (i v)) (exW nil))) (ones v)
                    (sym N (suc (ones v)) zero h) ;
    o w -> \ h -> trans Wd (lo (exW (compW v w))) (lo (compW (exW v) (exW w))) (compW (dbl (exW v)) (lo (exW w)))
                    (ap Wd Wd lo (exW (compW v w)) (compW (exW v) (exW w)) (r w (sucInj (ones v) (len w) h)))
                    (sym Wd (compW (dbl (exW v)) (lo (exW w))) (lo (compW (exW v) (exW w))) (comp-dbl-lo (exW v) (exW w))) ;
    i w -> \ h -> trans Wd (dbl (exW (compW v w))) (dbl (compW (exW v) (exW w))) (compW (dbl (exW v)) (dbl (exW w)))
                    (ap Wd Wd dbl (exW (compW v w)) (compW (exW v) (exW w)) (r w (sucInj (ones v) (len w) h)))
                    (sym Wd (compW (dbl (exW v)) (dbl (exW w))) (dbl (compW (exW v) (exW w))) (comp-dbl-dbl (exW v) (exW w))) } } ;

-- intersection
and-lo-lo : (A B : Wd) -> Id Wd (andW (lo A) (lo B)) (lo (andW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) nil) (lo (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) (lo B)) (lo (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) (lo B)) (lo (andW A B)) (r B) } ;
  i A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) nil) (lo (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) (lo B)) (lo (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> i (o u)) (andW (lo A) (lo B)) (lo (andW A B)) (r B) } } ;

and-lo-dbl : (A B : Wd) -> Id Wd (andW (lo A) (dbl B)) (lo (andW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) nil) (lo (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) (dbl B)) (lo (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) (dbl B)) (lo (andW A B)) (r B) } ;
  i A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) nil) (lo (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (lo A) (dbl B)) (lo (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> i (o u)) (andW (lo A) (dbl B)) (lo (andW A B)) (r B) } } ;

and-dbl-lo : (A B : Wd) -> Id Wd (andW (dbl A) (lo B)) (lo (andW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) nil) (lo (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) (lo B)) (lo (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) (lo B)) (lo (andW A B)) (r B) } ;
  i A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) nil) (lo (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) (lo B)) (lo (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> i (o u)) (andW (dbl A) (lo B)) (lo (andW A B)) (r B) } } ;

and-dbl-dbl : (A B : Wd) -> Id Wd (andW (dbl A) (dbl B)) (dbl (andW A B)) = split {
  nil -> \ B -> refl nil ;
  o A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) nil) (dbl (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) (dbl B)) (dbl (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) (dbl B)) (dbl (andW A B)) (r B) } ;
  i A | r -> split {
    nil -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) nil) (dbl (andW A nil)) (r nil) ;
    o B -> ap Wd Wd (\ u -> o (o u)) (andW (dbl A) (dbl B)) (dbl (andW A B)) (r B) ;
    i B -> ap Wd Wd (\ u -> i (i u)) (andW (dbl A) (dbl B)) (dbl (andW A B)) (r B) } } ;

ex-meet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (exW (andW v w)) (andW (exW v) (exW w)) = split {
  nil -> \ w h -> subst Wd (\ u -> Id Wd (i nil) (andW (i nil) (exW u))) nil w
                    (sym Wd w nil (len-zero w (sym N zero (len w) h))) (refl (i nil)) ;
  o v | r -> split {
    nil -> \ h -> absurdN (Id Wd (exW (andW (o v) nil)) (andW (exW (o v)) (exW nil))) (len v) (sym N (suc (len v)) zero h) ;
    o w -> \ h -> trans Wd (lo (exW (andW v w))) (lo (andW (exW v) (exW w))) (andW (lo (exW v)) (lo (exW w)))
                    (ap Wd Wd lo (exW (andW v w)) (andW (exW v) (exW w)) (r w (sucInj (len v) (len w) h)))
                    (sym Wd (andW (lo (exW v)) (lo (exW w))) (lo (andW (exW v) (exW w))) (and-lo-lo (exW v) (exW w))) ;
    i w -> \ h -> trans Wd (lo (exW (andW v w))) (lo (andW (exW v) (exW w))) (andW (lo (exW v)) (dbl (exW w)))
                    (ap Wd Wd lo (exW (andW v w)) (andW (exW v) (exW w)) (r w (sucInj (len v) (len w) h)))
                    (sym Wd (andW (lo (exW v)) (dbl (exW w))) (lo (andW (exW v) (exW w))) (and-lo-dbl (exW v) (exW w))) } ;
  i v | r -> split {
    nil -> \ h -> absurdN (Id Wd (exW (andW (i v) nil)) (andW (exW (i v)) (exW nil))) (len v) (sym N (suc (len v)) zero h) ;
    o w -> \ h -> trans Wd (lo (exW (andW v w))) (lo (andW (exW v) (exW w))) (andW (dbl (exW v)) (lo (exW w)))
                    (ap Wd Wd lo (exW (andW v w)) (andW (exW v) (exW w)) (r w (sucInj (len v) (len w) h)))
                    (sym Wd (andW (dbl (exW v)) (lo (exW w))) (lo (andW (exW v) (exW w))) (and-dbl-lo (exW v) (exW w))) ;
    i w -> \ h -> trans Wd (dbl (exW (andW v w))) (dbl (andW (exW v) (exW w))) (andW (dbl (exW v)) (dbl (exW w)))
                    (ap Wd Wd dbl (exW (andW v w)) (andW (exW v) (exW w)) (r w (sucInj (len v) (len w) h)))
                    (sym Wd (andW (dbl (exW v)) (dbl (exW w))) (dbl (andW (exW v) (exW w))) (and-dbl-dbl (exW v) (exW w))) } } ;

-- the pre-dilator 2^D
module ExpDil
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  X0 (n : N) : N = pow2 (D0 n) ;

  X1 (w : Wd) : Wd = exW (D1 w) ;

  xlen (w : Wd) : Id N (len (X1 w)) (X0 (len w)) =
    trans N (len (X1 w)) (pow2 (len (D1 w))) (X0 (len w)) (len-ex (D1 w))
      (ap N N pow2 (len (D1 w)) (D0 (len w)) (dlen w)) ;

  xones (w : Wd) : Id N (ones (X1 w)) (X0 (ones w)) =
    trans N (ones (X1 w)) (pow2 (ones (D1 w))) (X0 (ones w)) (ones-ex (D1 w))
      (ap N N pow2 (ones (D1 w)) (D0 (ones w)) (dones w)) ;

  xid (n : N) : Id Wd (X1 (idW n)) (idW (X0 n)) =
    trans Wd (X1 (idW n)) (exW (idW (D0 n))) (idW (X0 n))
      (ap Wd Wd exW (D1 (idW n)) (idW (D0 n)) (did n)) (ex-id (D0 n)) ;

  matchD (v w : Wd) (h : Id N (ones v) (len w)) : Id N (ones (D1 v)) (len (D1 w)) =
    trans N (ones (D1 v)) (D0 (ones v)) (len (D1 w)) (dones v)
      (trans N (D0 (ones v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (ones v) (len w) h)
         (sym N (len (D1 w)) (D0 (len w)) (dlen w))) ;

  lenD (v w : Wd) (h : Id N (len v) (len w)) : Id N (len (D1 v)) (len (D1 w)) =
    trans N (len (D1 v)) (D0 (len v)) (len (D1 w)) (dlen v)
      (trans N (D0 (len v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (len v) (len w) h)
         (sym N (len (D1 w)) (D0 (len w)) (dlen w))) ;

  xcomp (v w : Wd) (h : Id N (ones v) (len w)) : Id Wd (X1 (compW v w)) (compW (X1 v) (X1 w)) =
    trans Wd (X1 (compW v w)) (exW (compW (D1 v) (D1 w))) (compW (X1 v) (X1 w))
      (ap Wd Wd exW (D1 (compW v w)) (compW (D1 v) (D1 w)) (dcomp v w h))
      (ex-comp (D1 v) (D1 w) (matchD v w h)) ;

  xmeet (v w : Wd) (h : Id N (len v) (len w)) : Id Wd (X1 (andW v w)) (andW (X1 v) (X1 w)) =
    trans Wd (X1 (andW v w)) (exW (andW (D1 v) (D1 w))) (andW (X1 v) (X1 w))
      (ap Wd Wd exW (D1 (andW v w)) (andW (D1 v) (D1 w)) (dmeet v w h))
      (ex-meet (D1 v) (D1 w) (lenD v w h)) ;

  module P = PreDil[X0, X1, xlen, xones, xid, xcomp, xmeet] ;
} ;

-- 2^Id: D(2) = 4, the subsets 0 = {}, 1 = {0}, 2 = {1}, 3 = {0, 1}; the
-- support of a subset is the subset itself, so the trace of 2^Id at n is
-- the full subset of [n]
module TwoId = ExpDil[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w)] ;

#conv TwoId.X0 three = suc (suc (suc (suc (suc (suc (suc (suc zero))))))) ;
#conv TwoId.X1 (o (i nil)) = i (o (i (o nil))) ;
#conv TwoId.P.Sup[two, zero].supp = o (o nil) ;
#conv TwoId.P.Sup[two, one].supp = i (o nil) ;
#conv TwoId.P.Sup[two, two].supp = o (i nil) ;
#conv TwoId.P.Point[two, two, refl true].z = one ;
#conv TwoId.P.Sup[two, three].supp = i (i nil) ;
#conv TwoId.P.Point[two, three, refl true].z = three ;


------------------------------------------------------------------------
-- 2^Y is well-founded when Y is.  Its elements are the decreasing lists,
-- compared lexicographically (the first element is the largest, and a
-- proper prefix is smaller).

snoc (A : U a) : List A -> A -> List A = split {
  nilL -> \ t -> consL t nilL ;
  consL x l | r -> \ t -> consL x (r t) } ;

lexL (A : U a) (cmp : A -> A -> O3) : List A -> List A -> O3 = split {
  nilL -> split { nilL -> eq ; consL y m -> lt } ;
  consL x l | r -> split { nilL -> gt ; consL y m -> lexO3 (cmp x y) (r m) } } ;

-- hdLt l x: the first element of l (if any) is below x
hdLt (A : U a) (ltA : A -> A -> Bool) : List A -> A -> Bool = split {
  nilL -> \ x -> true ;
  consL y l -> \ x -> ltA y x } ;

decL (A : U a) (ltA : A -> A -> Bool) : List A -> Bool = split {
  nilL -> true ;
  consL x l | r -> andB (hdLt A ltA l x) r } ;

module Exp2 (Y : U a) (cmpY : Y -> Y -> O3) (yeq : (x y : Y) -> Id O3 (cmpY x y) eq -> Id Y x y) {

  dec (l : List Y) : Bool = decL Y (ltO Y cmpY) l ;

  -- the order of 2^Y: only decreasing lists are below anything
  ltE (l l' : List Y) : Bool = andB (dec l) (isLt (lexL Y cmpY l l')) ;

  module AY = Acc[Y, ltO Y cmpY] ;
  module AE = Acc[List Y, ltE] ;

  -- the empty list is the least element
  noNil : (k : List Y) -> AE.Lt k nilL -> Empty = split {
    nilL -> \ h -> absurdB Empty (andB-r (dec nilL) false h) ;
    consL y m -> \ h -> absurdB Empty (andB-r (dec (consL y m)) false h) } ;

  accNil : AE.AccP nilL = AE.acc nilL (\ k h -> absurdE (AE.AccP k) (noNil k h)) ;

  -- x :: l is accessible for all decreasing l
  PH (x : Y) : U a = (l : List Y) -> Id Bool (dec (consL x l)) true -> AE.AccP (consL x l) ;

  -- a decreasing list below x is accessible, if PH holds below x
  accBelow (x : Y) (ih : (y : Y) -> AY.Lt y x -> PH y)
    : (m : List Y) -> Id Bool (dec m) true -> Id Bool (hdLt Y (ltO Y cmpY) m x) true -> AE.AccP m = split {
    nilL -> \ hd hh -> accNil ;
    consL y m -> \ hd hh -> ih y hh m hd } ;

  -- the predecessors y :: k of x :: l1: y < x, or y = x and k < l1
  predC (x : Y) (ih : (y : Y) -> AY.Lt y x -> PH y) (l1 : List Y)
    (ih2 : (k : List Y) -> AE.Lt k l1 -> Id Bool (dec (consL x k)) true -> AE.AccP (consL x k))
    (y : Y) (k : List Y) (hk : AE.Lt (consL y k) (consL x l1))
    : (c : O3) -> Id O3 (cmpY y x) c -> AE.AccP (consL y k) = split {
    lt -> \ e -> ih y (ap O3 Bool isLt (cmpY y x) lt e) k
                   (andB-l (dec (consL y k)) (isLt (lexL Y cmpY (consL y k) (consL x l1))) hk) ;
    eq -> \ e -> subst Y (\ t -> AE.AccP (consL t k)) x y (sym Y y x (yeq y x e))
                   (ih2 k
                      (andB-intro (dec k) (isLt (lexL Y cmpY k l1))
                         (andB-r (hdLt Y (ltO Y cmpY) k y) (dec k)
                            (andB-l (dec (consL y k)) (isLt (lexL Y cmpY (consL y k) (consL x l1))) hk))
                         (subst O3 (\ c1 -> Id Bool (isLt (lexO3 c1 (lexL Y cmpY k l1))) true) (cmpY y x) eq e
                            (andB-r (dec (consL y k)) (isLt (lexL Y cmpY (consL y k) (consL x l1))) hk)))
                      (subst Y (\ t -> Id Bool (dec (consL t k)) true) y x (yeq y x e)
                         (andB-l (dec (consL y k)) (isLt (lexL Y cmpY (consL y k) (consL x l1))) hk))) ;
    gt -> \ e -> absurdB (AE.AccP (consL y k))
                   (subst O3 (\ c1 -> Id Bool (isLt (lexO3 c1 (lexL Y cmpY k l1))) true) (cmpY y x) gt e
                      (andB-r (dec (consL y k)) (isLt (lexL Y cmpY (consL y k) (consL x l1))) hk)) } ;

  predK (x : Y) (ih : (y : Y) -> AY.Lt y x -> PH y) (l1 : List Y)
    (ih2 : (k : List Y) -> AE.Lt k l1 -> Id Bool (dec (consL x k)) true -> AE.AccP (consL x k))
    : (k : List Y) -> AE.Lt k (consL x l1) -> AE.AccP k = split {
    nilL -> \ h -> accNil ;
    consL y k -> \ h -> predC x ih l1 ih2 y k h (cmpY y x) (refl (cmpY y x)) } ;

  -- inner induction, on the accessibility of the tail
  inner (x : Y) (ih : (y : Y) -> AY.Lt y x -> PH y) (l : List Y) (al : AE.AccP l)
    : Id Bool (dec (consL x l)) true -> AE.AccP (consL x l) =
    AE.ind (\ l1 -> Id Bool (dec (consL x l1)) true -> AE.AccP (consL x l1))
      (\ l1 ih2 hd1 -> AE.acc (consL x l1) (predK x ih l1 ih2)) l al ;

  -- outer induction, on the accessibility of the head
  accHead (x : Y) (ax : AY.AccP x) : PH x =
    AY.ind PH
      (\ x1 ih l hd -> inner x1 ih l
         (accBelow x1 ih l (andB-r (hdLt Y (ltO Y cmpY) l x1) (dec l) hd)
            (andB-l (hdLt Y (ltO Y cmpY) l x1) (dec l) hd)) hd)
      x ax ;

  accDec (wy : AY.WF) : (l : List Y) -> Id Bool (dec l) true -> AE.AccP l = split {
    nilL -> \ h -> accNil ;
    consL x l -> \ h -> accHead x (wy x) l h } ;

  wfE (wy : AY.WF) : AE.WF =
    \ l -> AE.acc l (\ k h -> accDec wy k (andB-l (dec k) (isLt (lexL Y cmpY k l)) h)) ;
} ;

------------------------------------------------------------------------
-- lemmas on lists

lexL-map (A A' B C : U a) (cmp1 : B -> B -> O3) (cmp2 : C -> C -> O3)
  (f : A -> B) (f' : A' -> B) (g : A -> C) (g' : A' -> C)
  (H : (x : A) (y : A') -> Id O3 (cmp1 (f x) (f' y)) (cmp2 (g x) (g' y)))
  : (l : List A) (l' : List A')
    -> Id O3 (lexL B cmp1 (map A B f l) (map A' B f' l')) (lexL C cmp2 (map A C g l) (map A' C g' l')) = split {
  nilL -> split { nilL -> refl eq ; consL y m -> refl lt } ;
  consL x l | r -> split {
    nilL -> refl gt ;
    consL y m -> ap2 O3 O3 O3 lexO3 (cmp1 (f x) (f' y)) (cmp2 (g x) (g' y))
                   (lexL B cmp1 (map A B f l) (map A' B f' m)) (lexL C cmp2 (map A C g l) (map A' C g' m))
                   (H x y) (r m) } } ;

hdLt-map (A B : U a) (ltA : A -> A -> Bool) (ltB : B -> B -> Bool) (f : A -> B)
  (H : (x y : A) -> Id Bool (ltB (f x) (f y)) (ltA x y)) (x : A)
  : (l : List A) -> Id Bool (hdLt B ltB (map A B f l) (f x)) (hdLt A ltA l x) = split {
  nilL -> refl true ;
  consL y l -> H y x } ;

decL-map (A B : U a) (ltA : A -> A -> Bool) (ltB : B -> B -> Bool) (f : A -> B)
  (H : (x y : A) -> Id Bool (ltB (f x) (f y)) (ltA x y))
  : (l : List A) -> Id Bool (decL B ltB (map A B f l)) (decL A ltA l) = split {
  nilL -> refl true ;
  consL x l | r -> ap2 Bool Bool Bool andB (hdLt B ltB (map A B f l) (f x)) (hdLt A ltA l x)
                     (decL B ltB (map A B f l)) (decL A ltA l) (hdLt-map A B ltA ltB f H x l) r } ;

-- every element of l is above t
aboveAll (A : U a) (ltA : A -> A -> Bool) (t : A) : List A -> Bool = split {
  nilL -> true ;
  consL y l | r -> andB (ltA t y) r } ;

hdSnoc (A : U a) (ltA : A -> A -> Bool) (t x : A)
  : (l : List A) -> Id Bool (hdLt A ltA l x) true -> Id Bool (ltA t x) true -> Id Bool (hdLt A ltA (snoc A l t) x) true = split {
  nilL -> \ h1 h2 -> h2 ;
  consL y l -> \ h1 h2 -> h1 } ;

decL-snoc (A : U a) (ltA : A -> A -> Bool) (t : A)
  : (l : List A) -> Id Bool (decL A ltA l) true -> Id Bool (aboveAll A ltA t l) true
    -> Id Bool (decL A ltA (snoc A l t)) true = split {
  nilL -> \ h k -> refl true ;
  consL x l | r -> \ h k ->
    andB-intro (hdLt A ltA (snoc A l t) x) (decL A ltA (snoc A l t))
      (hdSnoc A ltA t x l (andB-l (hdLt A ltA l x) (decL A ltA l) h) (andB-l (ltA t x) (aboveAll A ltA t l) k))
      (r (andB-r (hdLt A ltA l x) (decL A ltA l) h) (andB-r (ltA t x) (aboveAll A ltA t l) k)) } ;

map-snoc (A B : U a) (f : A -> B) : (l : List A) (t : A) -> Id (List B) (map A B f (snoc A l t)) (snoc B (map A B f l) (f t)) = split {
  nilL -> \ t -> refl (consL (f t) nilL) ;
  consL x l | r -> \ t -> ap (List B) (List B) (\ k -> consL (f x) k) (map A B f (snoc A l t)) (snoc B (map A B f l) (f t)) (r t) } ;

-- a list of numbers below m, with the proofs
attach (m : N) : (l : List N) -> Id Bool (ltAll m l) true -> List ((t : N) * Id Bool (ltN t m) true) = split {
  nilL -> \ h -> nilL ;
  consL y l | r -> \ h -> consL (y, andB-l (ltN y m) (ltAll m l) h) (r (andB-r (ltN y m) (ltAll m l) h)) } ;

proj-attach (m : N)
  : (l : List N) (h : Id Bool (ltAll m l) true) -> Id (List N) (map ((t : N) * Id Bool (ltN t m) true) N (\ p -> p.1) (attach m l h)) l = split {
  nilL -> \ h -> refl nilL ;
  consL y l | r -> \ h -> ap (List N) (List N) (\ k -> consL y k)
                     (map ((t : N) * Id Bool (ltN t m) true) N (\ p -> p.1) (attach m l (andB-r (ltN y m) (ltAll m l) h))) l
                     (r (andB-r (ltN y m) (ltAll m l) h)) } ;

ltAll-suc (m : N) : (l : List N) -> Id Bool (ltAll (suc m) (map N N (\ k -> suc k) l)) (ltAll m l) = split {
  nilL -> refl true ;
  consL y l | r -> ap Bool Bool (\ c -> andB (ltN y m) c) (ltAll (suc m) (map N N (\ k -> suc k) l)) (ltAll m l) r } ;

ltAll-snoc (m t : N) : (l : List N) -> Id Bool (ltAll m l) true -> Id Bool (ltN t m) true -> Id Bool (ltAll m (snoc N l t)) true = split {
  nilL -> \ h k -> andB-intro (ltN t m) true k (refl true) ;
  consL y l | r -> \ h k -> andB-intro (ltN y m) (ltAll m (snoc N l t)) (andB-l (ltN y m) (ltAll m l) h)
                              (r (andB-r (ltN y m) (ltAll m l) h) k) } ;

------------------------------------------------------------------------
-- binary numerals: numW w is the number whose bit k is the letter k of w,
-- and onesL w lists the positions of the letters i, in decreasing order

numC : Bool -> N -> N = split {
  false -> \ x -> dblN x ;
  true -> \ x -> suc (dblN x) } ;

numW : Wd -> N = split {
  nil -> zero ;
  o w | r -> dblN r ;
  i w | r -> suc (dblN r) } ;

numW-cons : (c : Bool) (w : Wd) -> Id N (numW (cons c w)) (numC c (numW w)) = split {
  false -> \ w -> refl (dblN (numW w)) ;
  true -> \ w -> refl (suc (dblN (numW w))) } ;

onesL : Wd -> List N = split {
  nil -> nilL ;
  o w | r -> map N N (\ k -> suc k) r ;
  i w | r -> snoc N (map N N (\ k -> suc k) r) zero } ;

-- halving: hp z = (q, b) with z = numC b q
hpS (q : N) : Bool -> N * Bool = split {
  false -> (q, true) ;
  true -> (suc q, false) } ;

hp : N -> N * Bool = split {
  zero -> (zero, false) ;
  suc z | r -> hpS r.1 r.2 } ;

hpOk (q : N) : (b : Bool) (z : N) -> Id N (numC b q) z -> Id N (numC (hpS q b).2 (hpS q b).1) (suc z) = split {
  false -> \ z e -> sucEq (dblN q) z e ;
  true -> \ z e -> sucEq (suc (dblN q)) z e } ;

hp-ok : (z : N) -> Id N (numC (hp z).2 (hp z).1) z = split {
  zero -> refl zero ;
  suc z | r -> hpOk (hp z).1 (hp z).2 z r } ;

-- the k bits of z
bits : N -> N -> Wd = split {
  zero -> \ z -> nil ;
  suc k | r -> \ z -> cons (hp z).2 (r (hp z).1) } ;

len-bits : (k z : N) -> Id N (len (bits k z)) k = split {
  zero -> \ z -> refl zero ;
  suc k | r -> \ z -> trans N (len (cons (hp z).2 (bits k (hp z).1))) (suc (len (bits k (hp z).1))) (suc k)
                        (len-cons (hp z).2 (bits k (hp z).1)) (sucEq (len (bits k (hp z).1)) k (r (hp z).1)) } ;

ltN-dbl : (x y : N) -> Id Bool (ltN (dblN x) (dblN y)) (ltN x y) = split {
  zero -> split { zero -> refl false ; suc y -> refl true } ;
  suc x | r -> split { zero -> refl false ; suc y -> r y } } ;

ltN-dbl1 : (x y : N) -> Id Bool (ltN x y) true -> Id Bool (ltN (suc (dblN x)) (dblN y)) true = split {
  zero -> split {
    zero -> \ h -> absurdB (Id Bool (ltN one zero) true) h ;
    suc y -> \ h -> refl true } ;
  suc x | r -> split {
    zero -> \ h -> absurdB (Id Bool (ltN (suc (dblN (suc x))) zero) true) h ;
    suc y -> \ h -> r y h } } ;

ltN-half1 : (q y : N) -> Id Bool (ltN (suc (dblN q)) (dblN y)) true -> Id Bool (ltN q y) true = split {
  zero -> split {
    zero -> \ h -> absurdB (Id Bool (ltN zero zero) true) h ;
    suc y -> \ h -> refl true } ;
  suc q | r -> split {
    zero -> \ h -> absurdB (Id Bool (ltN (suc q) zero) true) h ;
    suc y -> \ h -> r y h } } ;

ltN-half : (b : Bool) (q y : N) -> Id Bool (ltN (numC b q) (dblN y)) true -> Id Bool (ltN q y) true = split {
  false -> \ q y h -> trans Bool (ltN q y) (ltN (dblN q) (dblN y)) true (sym Bool (ltN (dblN q) (dblN y)) (ltN q y) (ltN-dbl q y)) h ;
  true -> \ q y h -> ltN-half1 q y h } ;

numW-lt : (s : Wd) -> Id Bool (ltN (numW s) (pow2 (len s))) true = split {
  nil -> refl true ;
  o s | r -> trans Bool (ltN (dblN (numW s)) (dblN (pow2 (len s)))) (ltN (numW s) (pow2 (len s))) true
               (ltN-dbl (numW s) (pow2 (len s))) r ;
  i s | r -> ltN-dbl1 (numW s) (pow2 (len s)) r } ;

numW-bits : (k z : N) -> Id Bool (ltN z (pow2 k)) true -> Id N (numW (bits k z)) z = split {
  zero -> \ z h -> sym N z zero (lt-one z h) ;
  suc k | r -> \ z h ->
    trans N (numW (cons (hp z).2 (bits k (hp z).1))) (numC (hp z).2 (numW (bits k (hp z).1))) z
      (numW-cons (hp z).2 (bits k (hp z).1))
      (trans N (numC (hp z).2 (numW (bits k (hp z).1))) (numC (hp z).2 (hp z).1) z
         (ap N N (\ m -> numC (hp z).2 m) (numW (bits k (hp z).1)) (hp z).1
            (r (hp z).1 (ltN-half (hp z).2 (hp z).1 (pow2 k)
                           (subst N (\ m -> Id Bool (ltN m (dblN (pow2 k))) true) z (numC (hp z).2 (hp z).1)
                              (sym N (numC (hp z).2 (hp z).1) z (hp-ok z)) h))))
         (hp-ok z)) } ;

-- the point j of 2^w is the subset w(j)
sel-lo : (A : Wd) (z : N) -> Id N (sel (lo A) z) (dblN (sel A z)) = split {
  nil -> \ z -> refl zero ;
  o A | r -> \ z -> sucEq (suc (sel (lo A) z)) (suc (dblN (sel A z))) (sucEq (sel (lo A) z) (dblN (sel A z)) (r z)) ;
  i A | r -> split {
    zero -> refl zero ;
    suc z -> sucEq (suc (sel (lo A) z)) (suc (dblN (sel A z))) (sucEq (sel (lo A) z) (dblN (sel A z)) (r z)) } } ;

sel-dbl0 : (A : Wd) (z : N) -> Id N (sel (dbl A) (dblN z)) (dblN (sel A z)) = split {
  nil -> \ z -> refl zero ;
  o A | r -> \ z -> sucEq (suc (sel (dbl A) (dblN z))) (suc (dblN (sel A z))) (sucEq (sel (dbl A) (dblN z)) (dblN (sel A z)) (r z)) ;
  i A | r -> split {
    zero -> refl zero ;
    suc z -> sucEq (suc (sel (dbl A) (dblN z))) (suc (dblN (sel A z))) (sucEq (sel (dbl A) (dblN z)) (dblN (sel A z)) (r z)) } } ;

sel-dbl1 : (A : Wd) (z : N) -> Id Bool (ltN z (ones A)) true -> Id N (sel (dbl A) (suc (dblN z))) (suc (dblN (sel A z))) = split {
  nil -> \ z h -> ltN-zero-abs (Id N zero (suc (dblN zero))) z h ;
  o A | r -> \ z h -> sucEq (suc (sel (dbl A) (suc (dblN z)))) (suc (suc (dblN (sel A z))))
                        (sucEq (sel (dbl A) (suc (dblN z))) (suc (dblN (sel A z))) (r z h)) ;
  i A | r -> split {
    zero -> \ h -> refl one ;
    suc z -> \ h -> sucEq (suc (sel (dbl A) (suc (dblN z)))) (suc (suc (dblN (sel A z))))
                      (sucEq (sel (dbl A) (suc (dblN z))) (suc (dblN (sel A z))) (r z h)) } } ;

ltOnesEx (W s : Wd) (h : Id N (len s) (ones W)) : Id Bool (ltN (numW s) (ones (exW W))) true =
  subst N (\ m -> Id Bool (ltN (numW s) m) true) (pow2 (len s)) (ones (exW W))
    (trans N (pow2 (len s)) (pow2 (ones W)) (ones (exW W)) (ap N N pow2 (len s) (ones W) h)
       (sym N (ones (exW W)) (pow2 (ones W)) (ones-ex W)))
    (numW-lt s) ;

sel-ex : (W s : Wd) -> Id N (len s) (ones W) -> Id N (sel (exW W) (numW s)) (numW (compW W s)) = split {
  nil -> \ s h -> subst Wd (\ u -> Id N (sel (i nil) (numW u)) (numW (compW nil u))) nil s
                    (sym Wd s nil (len-zero s h)) (refl zero) ;
  o W | r -> \ s h -> trans N (sel (lo (exW W)) (numW s)) (dblN (sel (exW W) (numW s))) (dblN (numW (compW W s)))
                        (sel-lo (exW W) (numW s)) (ap N N dblN (sel (exW W) (numW s)) (numW (compW W s)) (r s h)) ;
  i W | r -> split {
    nil -> \ h -> absurdN (Id N (sel (exW (i W)) (numW nil)) (numW (compW (i W) nil))) (ones W) h ;
    o s -> \ h -> trans N (sel (dbl (exW W)) (dblN (numW s))) (dblN (sel (exW W) (numW s))) (dblN (numW (compW W s)))
                    (sel-dbl0 (exW W) (numW s))
                    (ap N N dblN (sel (exW W) (numW s)) (numW (compW W s)) (r s (sucInj (len s) (ones W) h))) ;
    i s -> \ h -> trans N (sel (dbl (exW W)) (suc (dblN (numW s)))) (suc (dblN (sel (exW W) (numW s))))
                    (suc (dblN (numW (compW W s))))
                    (sel-dbl1 (exW W) (numW s) (ltOnesEx W s (sucInj (len s) (ones W) h)))
                    (ap N N (\ k -> suc (dblN k)) (sel (exW W) (numW s)) (numW (compW W s))
                       (r s (sucInj (len s) (ones W) h))) } } ;

-- the ones of the image w(s) are the images of the ones of s
onesL-comp : (W s : Wd) -> Id N (len s) (ones W) -> Id (List N) (onesL (compW W s)) (map N N (sel W) (onesL s)) = split {
  nil -> \ s h -> subst Wd (\ u -> Id (List N) nilL (map N N (sel nil) (onesL u))) nil s
                    (sym Wd s nil (len-zero s h)) (refl nilL) ;
  o W | r -> \ s h ->
    trans (List N) (map N N (\ k -> suc k) (onesL (compW W s))) (map N N (\ k -> suc k) (map N N (sel W) (onesL s)))
                   (map N N (sel (o W)) (onesL s))
      (ap (List N) (List N) (map N N (\ k -> suc k)) (onesL (compW W s)) (map N N (sel W) (onesL s)) (r s h))
      (map-comp N N N (sel W) (\ k -> suc k) (onesL s)) ;
  i W | r -> split {
    nil -> \ h -> absurdN (Id (List N) (onesL (compW (i W) nil)) (map N N (sel (i W)) (onesL nil))) (ones W) h ;
    o s -> \ h ->
      trans (List N) (map N N (\ k -> suc k) (onesL (compW W s))) (map N N (\ k -> suc k) (map N N (sel W) (onesL s)))
                     (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s)))
        (ap (List N) (List N) (map N N (\ k -> suc k)) (onesL (compW W s)) (map N N (sel W) (onesL s))
           (r s (sucInj (len s) (ones W) h)))
        (trans (List N) (map N N (\ k -> suc k) (map N N (sel W) (onesL s))) (map N N (\ x -> suc (sel W x)) (onesL s))
                        (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s)))
           (map-comp N N N (sel W) (\ k -> suc k) (onesL s))
           (sym (List N) (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s))) (map N N (\ x -> suc (sel W x)) (onesL s))
              (map-comp N N N (\ k -> suc k) (sel (i W)) (onesL s)))) ;
    i s -> \ h ->
      trans (List N) (snoc N (map N N (\ k -> suc k) (onesL (compW W s))) zero)
                     (snoc N (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s))) zero)
                     (map N N (sel (i W)) (snoc N (map N N (\ k -> suc k) (onesL s)) zero))
        (ap (List N) (List N) (\ l -> snoc N l zero)
           (map N N (\ k -> suc k) (onesL (compW W s))) (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s)))
           (trans (List N) (map N N (\ k -> suc k) (onesL (compW W s))) (map N N (\ k -> suc k) (map N N (sel W) (onesL s)))
                           (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s)))
              (ap (List N) (List N) (map N N (\ k -> suc k)) (onesL (compW W s)) (map N N (sel W) (onesL s))
                 (r s (sucInj (len s) (ones W) h)))
              (trans (List N) (map N N (\ k -> suc k) (map N N (sel W) (onesL s))) (map N N (\ x -> suc (sel W x)) (onesL s))
                              (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s)))
                 (map-comp N N N (sel W) (\ k -> suc k) (onesL s))
                 (sym (List N) (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s))) (map N N (\ x -> suc (sel W x)) (onesL s))
                    (map-comp N N N (\ k -> suc k) (sel (i W)) (onesL s))))))
        (sym (List N) (map N N (sel (i W)) (snoc N (map N N (\ k -> suc k) (onesL s)) zero))
                      (snoc N (map N N (sel (i W)) (map N N (\ k -> suc k) (onesL s))) zero)
           (map-snoc N N (sel (i W)) (map N N (\ k -> suc k) (onesL s)) zero)) } } ;

-- comparing numerals is comparing the lists of their ones
cmpBit : Bool -> Bool -> O3 = split {
  false -> split { false -> eq ; true -> lt } ;
  true -> split { false -> gt ; true -> eq } } ;

snz : Bool -> List N -> List N = split {
  false -> \ l -> l ;
  true -> \ l -> snoc N l zero } ;

snz-cons : (c : Bool) (x : N) (l : List N) -> Id (List N) (snz c (consL x l)) (consL x (snz c l)) = split {
  false -> \ x l -> refl (consL x l) ;
  true -> \ x l -> refl (consL x (snoc N l zero)) } ;

lexO3-assoc : (c1 c2 c3 : O3) -> Id O3 (lexO3 (lexO3 c1 c2) c3) (lexO3 c1 (lexO3 c2 c3)) = split {
  lt -> \ c2 c3 -> refl lt ;
  eq -> \ c2 c3 -> refl (lexO3 c2 c3) ;
  gt -> \ c2 c3 -> refl gt } ;

lexNN : (c c' : Bool) -> Id O3 (lexL N cmpN (snz c nilL) (snz c' nilL)) (cmpBit c c') = split {
  false -> split { false -> refl eq ; true -> refl lt } ;
  true -> split { false -> refl gt ; true -> refl eq } } ;

lexNC : (c : Bool) (y : N) (l : List N) -> Id O3 (lexL N cmpN (snz c nilL) (consL (suc y) l)) lt = split {
  false -> \ y l -> refl lt ;
  true -> \ y l -> refl lt } ;

lexCN : (c : Bool) (x : N) (l : List N) -> Id O3 (lexL N cmpN (consL (suc x) l) (snz c nilL)) gt = split {
  false -> \ x l -> refl gt ;
  true -> \ x l -> refl gt } ;

lex-snz (c c' : Bool) : (l l' : List N)
  -> Id O3 (lexL N cmpN (snz c (map N N (\ k -> suc k) l)) (snz c' (map N N (\ k -> suc k) l')))
           (lexO3 (lexL N cmpN l l') (cmpBit c c')) = split {
  nilL -> split {
    nilL -> lexNN c c' ;
    consL y m -> trans O3 (lexL N cmpN (snz c nilL) (snz c' (consL (suc y) (map N N (\ k -> suc k) m))))
                          (lexL N cmpN (snz c nilL) (consL (suc y) (snz c' (map N N (\ k -> suc k) m)))) lt
                   (ap (List N) O3 (\ l2 -> lexL N cmpN (snz c nilL) l2)
                      (snz c' (consL (suc y) (map N N (\ k -> suc k) m))) (consL (suc y) (snz c' (map N N (\ k -> suc k) m)))
                      (snz-cons c' (suc y) (map N N (\ k -> suc k) m)))
                   (lexNC c y (snz c' (map N N (\ k -> suc k) m))) } ;
  consL x l | r -> split {
    nilL -> trans O3 (lexL N cmpN (snz c (consL (suc x) (map N N (\ k -> suc k) l))) (snz c' nilL))
                     (lexL N cmpN (consL (suc x) (snz c (map N N (\ k -> suc k) l))) (snz c' nilL)) gt
              (ap (List N) O3 (\ l2 -> lexL N cmpN l2 (snz c' nilL))
                 (snz c (consL (suc x) (map N N (\ k -> suc k) l))) (consL (suc x) (snz c (map N N (\ k -> suc k) l)))
                 (snz-cons c (suc x) (map N N (\ k -> suc k) l)))
              (lexCN c' x (snz c (map N N (\ k -> suc k) l))) ;
    consL y m ->
      trans O3 (lexL N cmpN (snz c (consL (suc x) (map N N (\ k -> suc k) l))) (snz c' (consL (suc y) (map N N (\ k -> suc k) m))))
               (lexO3 (cmpN x y) (lexL N cmpN (snz c (map N N (\ k -> suc k) l)) (snz c' (map N N (\ k -> suc k) m))))
               (lexO3 (lexO3 (cmpN x y) (lexL N cmpN l m)) (cmpBit c c'))
        (ap2 (List N) (List N) O3 (lexL N cmpN)
           (snz c (consL (suc x) (map N N (\ k -> suc k) l))) (consL (suc x) (snz c (map N N (\ k -> suc k) l)))
           (snz c' (consL (suc y) (map N N (\ k -> suc k) m))) (consL (suc y) (snz c' (map N N (\ k -> suc k) m)))
           (snz-cons c (suc x) (map N N (\ k -> suc k) l)) (snz-cons c' (suc y) (map N N (\ k -> suc k) m)))
        (trans O3 (lexO3 (cmpN x y) (lexL N cmpN (snz c (map N N (\ k -> suc k) l)) (snz c' (map N N (\ k -> suc k) m))))
                  (lexO3 (cmpN x y) (lexO3 (lexL N cmpN l m) (cmpBit c c')))
                  (lexO3 (lexO3 (cmpN x y) (lexL N cmpN l m)) (cmpBit c c'))
           (ap O3 O3 (\ c3 -> lexO3 (cmpN x y) c3)
              (lexL N cmpN (snz c (map N N (\ k -> suc k) l)) (snz c' (map N N (\ k -> suc k) m)))
              (lexO3 (lexL N cmpN l m) (cmpBit c c')) (r m))
           (sym O3 (lexO3 (lexO3 (cmpN x y) (lexL N cmpN l m)) (cmpBit c c'))
                   (lexO3 (cmpN x y) (lexO3 (lexL N cmpN l m) (cmpBit c c')))
              (lexO3-assoc (cmpN x y) (lexL N cmpN l m) (cmpBit c c')))) } } ;

-- comparing 2x + c and 2y + c' is lexicographic, the halves first
numC-suc : (c : Bool) (x : N) -> Id N (numC c (suc x)) (suc (suc (numC c x))) = split {
  false -> \ x -> refl (suc (suc (dblN x))) ;
  true -> \ x -> refl (suc (suc (suc (dblN x)))) } ;

cmpDbl00 : (c c' : Bool) -> Id O3 (cmpN (numC c zero) (numC c' zero)) (cmpBit c c') = split {
  false -> split { false -> refl eq ; true -> refl lt } ;
  true -> split { false -> refl gt ; true -> refl eq } } ;

cmpDbl0S : (c : Bool) (n : N) -> Id O3 (cmpN (numC c zero) (suc (suc n))) lt = split {
  false -> \ n -> refl lt ;
  true -> \ n -> refl lt } ;

cmpDblS0 : (c : Bool) (n : N) -> Id O3 (cmpN (suc (suc n)) (numC c zero)) gt = split {
  false -> \ n -> refl gt ;
  true -> \ n -> refl gt } ;

cmpDbl (c c' : Bool) : (x y : N) -> Id O3 (cmpN (numC c x) (numC c' y)) (lexO3 (cmpN x y) (cmpBit c c')) = split {
  zero -> split {
    zero -> cmpDbl00 c c' ;
    suc y -> trans O3 (cmpN (numC c zero) (numC c' (suc y))) (cmpN (numC c zero) (suc (suc (numC c' y)))) lt
               (ap N O3 (\ k -> cmpN (numC c zero) k) (numC c' (suc y)) (suc (suc (numC c' y))) (numC-suc c' y))
               (cmpDbl0S c (numC c' y)) } ;
  suc x | r -> split {
    zero -> trans O3 (cmpN (numC c (suc x)) (numC c' zero)) (cmpN (suc (suc (numC c x))) (numC c' zero)) gt
              (ap N O3 (\ k -> cmpN k (numC c' zero)) (numC c (suc x)) (suc (suc (numC c x))) (numC-suc c x))
              (cmpDblS0 c' (numC c x)) ;
    suc y -> trans O3 (cmpN (numC c (suc x)) (numC c' (suc y))) (cmpN (suc (suc (numC c x))) (suc (suc (numC c' y))))
               (lexO3 (cmpN x y) (cmpBit c c'))
               (ap2 N N O3 cmpN (numC c (suc x)) (suc (suc (numC c x))) (numC c' (suc y)) (suc (suc (numC c' y)))
                  (numC-suc c x) (numC-suc c' y))
               (r y) } } ;

cmpStep (c c' : Bool) (A A' : Wd) (ih : Id O3 (cmpN (numW A) (numW A')) (lexL N cmpN (onesL A) (onesL A')))
  : Id O3 (cmpN (numC c (numW A)) (numC c' (numW A')))
          (lexL N cmpN (snz c (map N N (\ k -> suc k) (onesL A))) (snz c' (map N N (\ k -> suc k) (onesL A')))) =
  trans O3 (cmpN (numC c (numW A)) (numC c' (numW A'))) (lexO3 (cmpN (numW A) (numW A')) (cmpBit c c'))
           (lexL N cmpN (snz c (map N N (\ k -> suc k) (onesL A))) (snz c' (map N N (\ k -> suc k) (onesL A'))))
    (cmpDbl c c' (numW A) (numW A'))
    (trans O3 (lexO3 (cmpN (numW A) (numW A')) (cmpBit c c')) (lexO3 (lexL N cmpN (onesL A) (onesL A')) (cmpBit c c'))
              (lexL N cmpN (snz c (map N N (\ k -> suc k) (onesL A))) (snz c' (map N N (\ k -> suc k) (onesL A'))))
       (ap O3 O3 (\ c3 -> lexO3 c3 (cmpBit c c')) (cmpN (numW A) (numW A')) (lexL N cmpN (onesL A) (onesL A')) ih)
       (sym O3 (lexL N cmpN (snz c (map N N (\ k -> suc k) (onesL A))) (snz c' (map N N (\ k -> suc k) (onesL A'))))
               (lexO3 (lexL N cmpN (onesL A) (onesL A')) (cmpBit c c'))
          (lex-snz c c' (onesL A) (onesL A')))) ;

cmp-numW : (A A' : Wd) -> Id N (len A) (len A') -> Id O3 (cmpN (numW A) (numW A')) (lexL N cmpN (onesL A) (onesL A')) = split {
  nil -> split {
    nil -> \ h -> refl eq ;
    o A' -> \ h -> absurdN (Id O3 (cmpN (numW nil) (numW (o A'))) (lexL N cmpN (onesL nil) (onesL (o A')))) (len A') h ;
    i A' -> \ h -> absurdN (Id O3 (cmpN (numW nil) (numW (i A'))) (lexL N cmpN (onesL nil) (onesL (i A')))) (len A') h } ;
  o A | r -> split {
    nil -> \ h -> absurdN (Id O3 (cmpN (numW (o A)) zero) (lexL N cmpN (onesL (o A)) nilL)) (len A) (sym N (suc (len A)) zero h) ;
    o A' -> \ h -> cmpStep false false A A' (r A' (sucInj (len A) (len A') h)) ;
    i A' -> \ h -> cmpStep false true A A' (r A' (sucInj (len A) (len A') h)) } ;
  i A | r -> split {
    nil -> \ h -> absurdN (Id O3 (cmpN (numW (i A)) zero) (lexL N cmpN (onesL (i A)) nilL)) (len A) (sym N (suc (len A)) zero h) ;
    o A' -> \ h -> cmpStep true false A A' (r A' (sucInj (len A) (len A') h)) ;
    i A' -> \ h -> cmpStep true true A A' (r A' (sucInj (len A) (len A') h)) } } ;

-- onesL w is decreasing, and bounded by len w
aboveSuc : (l : List N) -> Id Bool (aboveAll N (ltO N cmpN) zero (map N N (\ k -> suc k) l)) true = split {
  nilL -> refl true ;
  consL y l | r -> r } ;

dec-onesL : (w : Wd) -> Id Bool (decL N (ltO N cmpN) (onesL w)) true = split {
  nil -> refl true ;
  o w | r -> trans Bool (decL N (ltO N cmpN) (map N N (\ k -> suc k) (onesL w))) (decL N (ltO N cmpN) (onesL w)) true
               (decL-map N N (ltO N cmpN) (ltO N cmpN) (\ k -> suc k) (\ x y -> refl (isLt (cmpN x y))) (onesL w)) r ;
  i w | r -> decL-snoc N (ltO N cmpN) zero (map N N (\ k -> suc k) (onesL w))
               (trans Bool (decL N (ltO N cmpN) (map N N (\ k -> suc k) (onesL w))) (decL N (ltO N cmpN) (onesL w)) true
                  (decL-map N N (ltO N cmpN) (ltO N cmpN) (\ k -> suc k) (\ x y -> refl (isLt (cmpN x y))) (onesL w)) r)
               (aboveSuc (onesL w)) } ;

onesL-lt : (w : Wd) -> Id Bool (ltAll (len w) (onesL w)) true = split {
  nil -> refl true ;
  o w | r -> trans Bool (ltAll (suc (len w)) (map N N (\ k -> suc k) (onesL w))) (ltAll (len w) (onesL w)) true
               (ltAll-suc (len w) (onesL w)) r ;
  i w | r -> ltAll-snoc (suc (len w)) zero (map N N (\ k -> suc k) (onesL w))
               (trans Bool (ltAll (suc (len w)) (map N N (\ k -> suc k) (onesL w))) (ltAll (len w) (onesL w)) true
                  (ltAll-suc (len w) (onesL w)) r)
               (refl true) } ;

-- examples: 6 = {1, 2}, 5 = {0, 2}, and 6 > 5 since 1 > 0 after 2 = 2
#conv bits three six = o (i (i nil)) ;
#conv onesL (bits three six) = consL two (consL one nilL) ;
#conv lexL N cmpN (onesL (bits three six)) (onesL (bits three five)) = gt ;

------------------------------------------------------------------------
-- (2^D)(X) is well-founded when D(X) is: a denotation (a, z) of 2^D is a
-- subset s of D(lenL a), and goes to the decreasing list of the points
-- D(a)(t) of D(X), t in s.  The comparison of two denotations, through the
-- union c of a and a' with a = c . u and a' = c . u', compares the subsets
-- D(u)(s) and D(u')(s') of D(lenL c) (sel-ex), that is the decreasing lists
-- of their elements (cmp-numW, onesL-comp), that is the lists of points of
-- D(X) (lexL-map, DD.embC-cmp).

module ExpWF (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {
  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
  module XE = ExpDil[D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module DD = LX.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module DT = LX.DenOrd[XE.X0, XE.X1, XE.xlen, XE.xones, XE.xid, XE.xcomp, XE.xmeet] ;
  module EY = Exp2[DD.DenX, DD.cmpDen, DD.den-eq] ;

  -- the subset s of D(lenL a), and its elements
  nn (d : DT.DenX) : N = D0 (LX.lenL d.1) ;

  sW (d : DT.DenX) : Wd = bits (nn d) d.2.1 ;

  PtD (d : DT.DenX) : U a = (t : N) * Id Bool (ltN t (nn d)) true ;

  prD (d : DT.DenX) : Id Bool (ltAll (nn d) (onesL (sW d))) true =
    subst N (\ m -> Id Bool (ltAll m (onesL (sW d))) true) (len (sW d)) (nn d) (len-bits (nn d) d.2.1) (onesL-lt (sW d)) ;

  att (d : DT.DenX) : List (PtD d) = attach (nn d) (onesL (sW d)) (prD d) ;

  fw (d : DT.DenX) (p : PtD d) : DD.PD.Den (LX.lenL d.1) =
    DD.PD.fwd (LX.lenL d.1) (p.1, DD.PD.hzOf (LX.lenL d.1) p.1 p.2) ;

  gD (d : DT.DenX) (p : PtD d) : DD.DenX = DD.embC d.1 d.2.2.1 (fw d p) ;

  phi (d : DT.DenX) : List DD.DenX = map (PtD d) DD.DenX (gD d) (att d) ;

  -- phi d is decreasing: gD d preserves the order
  gOrd (d : DT.DenX) (p p' : PtD d) : Id O3 (DD.cmpDen (gD d p) (gD d p')) (cmpN p.1 p'.1) =
    trans O3 (DD.cmpDen (gD d p) (gD d p')) (cmpN (DD.PD.bwd (LX.lenL d.1) (fw d p)).1 (DD.PD.bwd (LX.lenL d.1) (fw d p')).1)
             (cmpN p.1 p'.1)
      (DD.embC-order d.1 d.2.2.1 (fw d p) (fw d p'))
      (ap2 N N O3 cmpN (DD.PD.bwd (LX.lenL d.1) (fw d p)).1 p.1 (DD.PD.bwd (LX.lenL d.1) (fw d p')).1 p'.1
         (DD.PD.bwd-fwd (LX.lenL d.1) (p.1, DD.PD.hzOf (LX.lenL d.1) p.1 p.2))
         (DD.PD.bwd-fwd (LX.lenL d.1) (p'.1, DD.PD.hzOf (LX.lenL d.1) p'.1 p'.2))) ;

  decPhi (d : DT.DenX) : Id Bool (EY.dec (phi d)) true =
    trans Bool (decL DD.DenX (ltO DD.DenX DD.cmpDen) (phi d)) (decL (PtD d) (\ p p' -> ltO N cmpN p.1 p'.1) (att d)) true
      (decL-map (PtD d) DD.DenX (\ p p' -> ltO N cmpN p.1 p'.1) (ltO DD.DenX DD.cmpDen) (gD d)
         (\ p p' -> ap O3 Bool isLt (DD.cmpDen (gD d p) (gD d p')) (cmpN p.1 p'.1) (gOrd d p p')) (att d))
      (trans Bool (decL (PtD d) (\ p p' -> ltO N cmpN p.1 p'.1) (att d))
                  (decL N (ltO N cmpN) (map (PtD d) N (\ p -> p.1) (att d))) true
         (sym Bool (decL N (ltO N cmpN) (map (PtD d) N (\ p -> p.1) (att d))) (decL (PtD d) (\ p p' -> ltO N cmpN p.1 p'.1) (att d))
            (decL-map (PtD d) N (\ p p' -> ltO N cmpN p.1 p'.1) (ltO N cmpN) (\ p -> p.1)
               (\ p p' -> refl (isLt (cmpN p.1 p'.1))) (att d)))
         (trans Bool (decL N (ltO N cmpN) (map (PtD d) N (\ p -> p.1) (att d))) (decL N (ltO N cmpN) (onesL (sW d))) true
            (ap (List N) Bool (decL N (ltO N cmpN)) (map (PtD d) N (\ p -> p.1) (att d)) (onesL (sW d))
               (proj-attach (nn d) (onesL (sW d)) (prD d)))
            (dec-onesL (sW d)))) ;

  -- two denotations, through their union
  kS (d d' : DT.DenX) : LX.Cov d.1 d'.1 (LX.merge d.1 d'.1) = LX.mergeOK d.1 d'.1 d.2.2.1 d'.2.2.1 ;

  hu1 (d d' : DT.DenX) : Id N (ones (LX.merge d.1 d'.1).2.1) (LX.lenL d.1) =
    LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d.1 (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (kS d d')) ;

  hu2 (d d' : DT.DenX) : Id N (ones (LX.merge d.1 d'.1).2.2) (LX.lenL d'.1) =
    LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d'.1 (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (kS d d')) ;

  U1 (d d' : DT.DenX) : Wd = D1 (LX.merge d.1 d'.1).2.1 ;

  U2 (d d' : DT.DenX) : Wd = D1 (LX.merge d.1 d'.1).2.2 ;

  lenU (d d' : DT.DenX) : Id N (len (U1 d d')) (len (U2 d d')) =
    trans N (len (U1 d d')) (D0 (len (LX.merge d.1 d'.1).2.1)) (len (U2 d d')) (dlen (LX.merge d.1 d'.1).2.1)
      (trans N (D0 (len (LX.merge d.1 d'.1).2.1)) (D0 (len (LX.merge d.1 d'.1).2.2)) (len (U2 d d'))
         (ap N N D0 (len (LX.merge d.1 d'.1).2.1) (len (LX.merge d.1 d'.1).2.2)
            (trans N (len (LX.merge d.1 d'.1).2.1) (LX.lenL (LX.merge d.1 d'.1).1) (len (LX.merge d.1 d'.1).2.2)
               (kS d d').1 (sym N (len (LX.merge d.1 d'.1).2.2) (LX.lenL (LX.merge d.1 d'.1).1) (kS d d').2.1)))
         (sym N (len (U2 d d')) (D0 (len (LX.merge d.1 d'.1).2.2)) (dlen (LX.merge d.1 d'.1).2.2))) ;

  ls1 (d d' : DT.DenX) : Id N (len (sW d)) (ones (U1 d d')) =
    trans N (len (sW d)) (nn d) (ones (U1 d d')) (len-bits (nn d) d.2.1)
      (sym N (ones (U1 d d')) (nn d)
         (trans N (ones (U1 d d')) (D0 (ones (LX.merge d.1 d'.1).2.1)) (nn d) (dones (LX.merge d.1 d'.1).2.1)
            (ap N N D0 (ones (LX.merge d.1 d'.1).2.1) (LX.lenL d.1) (hu1 d d')))) ;

  ls2 (d d' : DT.DenX) : Id N (len (sW d')) (ones (U2 d d')) =
    trans N (len (sW d')) (nn d') (ones (U2 d d')) (len-bits (nn d') d'.2.1)
      (sym N (ones (U2 d d')) (nn d')
         (trans N (ones (U2 d d')) (D0 (ones (LX.merge d.1 d'.1).2.2)) (nn d') (dones (LX.merge d.1 d'.1).2.2)
            (ap N N D0 (ones (LX.merge d.1 d'.1).2.2) (LX.lenL d'.1) (hu2 d d')))) ;

  lenC (d d' : DT.DenX) : Id N (len (compW (U1 d d') (sW d))) (len (compW (U2 d d') (sW d'))) =
    trans N (len (compW (U1 d d') (sW d))) (len (U1 d d')) (len (compW (U2 d d') (sW d')))
      (len-comp (U1 d d') (sW d))
      (trans N (len (U1 d d')) (len (U2 d d')) (len (compW (U2 d d') (sW d')))
         (lenU d d') (sym N (len (compW (U2 d d') (sW d'))) (len (U2 d d')) (len-comp (U2 d d') (sW d')))) ;

  zW (d : DT.DenX) : Id N (numW (sW d)) d.2.1 = numW-bits (nn d) d.2.1 d.2.2.2.1 ;

  -- the points of D(X) are compared as their images in D(lenL c)
  gCmp (d d' : DT.DenX) (p : PtD d) (p' : PtD d')
    : Id O3 (DD.cmpDen (gD d p) (gD d' p')) (cmpN (sel (U1 d d') p.1) (sel (U2 d d') p'.1)) =
    trans O3 (DD.cmpDen (gD d p) (gD d' p'))
      (cmpN (sel (U1 d d') (DD.PD.bwd (LX.lenL d.1) (fw d p)).1) (sel (U2 d d') (DD.PD.bwd (LX.lenL d'.1) (fw d' p')).1))
      (cmpN (sel (U1 d d') p.1) (sel (U2 d d') p'.1))
      (DD.embC-cmp d.1 d'.1 d.2.2.1 d'.2.2.1 (fw d p) (fw d' p'))
      (ap2 N N O3 (\ k k' -> cmpN (sel (U1 d d') k) (sel (U2 d d') k'))
         (DD.PD.bwd (LX.lenL d.1) (fw d p)).1 p.1 (DD.PD.bwd (LX.lenL d'.1) (fw d' p')).1 p'.1
         (DD.PD.bwd-fwd (LX.lenL d.1) (p.1, DD.PD.hzOf (LX.lenL d.1) p.1 p.2))
         (DD.PD.bwd-fwd (LX.lenL d'.1) (p'.1, DD.PD.hzOf (LX.lenL d'.1) p'.1 p'.2))) ;

  mapAtt (d : DT.DenX) (W : Wd)
    : Id (List N) (map (PtD d) N (\ p -> sel W p.1) (att d)) (map N N (sel W) (onesL (sW d))) =
    trans (List N) (map (PtD d) N (\ p -> sel W p.1) (att d)) (map N N (sel W) (map (PtD d) N (\ p -> p.1) (att d)))
                   (map N N (sel W) (onesL (sW d)))
      (sym (List N) (map N N (sel W) (map (PtD d) N (\ p -> p.1) (att d))) (map (PtD d) N (\ p -> sel W p.1) (att d))
         (map-comp (PtD d) N N (\ p -> p.1) (sel W) (att d)))
      (ap (List N) (List N) (map N N (sel W)) (map (PtD d) N (\ p -> p.1) (att d)) (onesL (sW d))
         (proj-attach (nn d) (onesL (sW d)) (prD d))) ;

  -- the comparison of (2^D)(X) is the lexicographic comparison of phi
  st1 (d d' : DT.DenX)
    : Id O3 (DT.cmpDen d d') (cmpN (numW (compW (U1 d d') (sW d))) (numW (compW (U2 d d') (sW d')))) =
    trans O3 (DT.cmpDen d d') (cmpN (sel (exW (U1 d d')) (numW (sW d))) (sel (exW (U2 d d')) (numW (sW d'))))
             (cmpN (numW (compW (U1 d d') (sW d))) (numW (compW (U2 d d') (sW d'))))
      (ap2 N N O3 (\ k k' -> cmpN (sel (exW (U1 d d')) k) (sel (exW (U2 d d')) k'))
         d.2.1 (numW (sW d)) d'.2.1 (numW (sW d'))
         (sym N (numW (sW d)) d.2.1 (zW d)) (sym N (numW (sW d')) d'.2.1 (zW d')))
      (ap2 N N O3 cmpN (sel (exW (U1 d d')) (numW (sW d))) (numW (compW (U1 d d') (sW d)))
         (sel (exW (U2 d d')) (numW (sW d'))) (numW (compW (U2 d d') (sW d')))
         (sel-ex (U1 d d') (sW d) (ls1 d d')) (sel-ex (U2 d d') (sW d') (ls2 d d'))) ;

  st2 (d d' : DT.DenX)
    : Id O3 (cmpN (numW (compW (U1 d d') (sW d))) (numW (compW (U2 d d') (sW d'))))
            (lexL N cmpN (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d)) (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d'))) =
    trans O3 (cmpN (numW (compW (U1 d d') (sW d))) (numW (compW (U2 d d') (sW d'))))
             (lexL N cmpN (onesL (compW (U1 d d') (sW d))) (onesL (compW (U2 d d') (sW d'))))
             (lexL N cmpN (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d)) (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d')))
      (cmp-numW (compW (U1 d d') (sW d)) (compW (U2 d d') (sW d')) (lenC d d'))
      (ap2 (List N) (List N) O3 (lexL N cmpN)
         (onesL (compW (U1 d d') (sW d))) (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d))
         (onesL (compW (U2 d d') (sW d'))) (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d'))
         (trans (List N) (onesL (compW (U1 d d') (sW d))) (map N N (sel (U1 d d')) (onesL (sW d)))
                         (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d))
            (onesL-comp (U1 d d') (sW d) (ls1 d d'))
            (sym (List N) (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d)) (map N N (sel (U1 d d')) (onesL (sW d)))
               (mapAtt d (U1 d d'))))
         (trans (List N) (onesL (compW (U2 d d') (sW d'))) (map N N (sel (U2 d d')) (onesL (sW d')))
                         (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d'))
            (onesL-comp (U2 d d') (sW d') (ls2 d d'))
            (sym (List N) (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d')) (map N N (sel (U2 d d')) (onesL (sW d')))
               (mapAtt d' (U2 d d'))))) ;

  phi-cmp (d d' : DT.DenX) : Id O3 (DT.cmpDen d d') (lexL DD.DenX DD.cmpDen (phi d) (phi d')) =
    trans O3 (DT.cmpDen d d') (cmpN (numW (compW (U1 d d') (sW d))) (numW (compW (U2 d d') (sW d'))))
             (lexL DD.DenX DD.cmpDen (phi d) (phi d'))
      (st1 d d')
      (trans O3 (cmpN (numW (compW (U1 d d') (sW d))) (numW (compW (U2 d d') (sW d'))))
                (lexL N cmpN (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d)) (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d')))
                (lexL DD.DenX DD.cmpDen (phi d) (phi d'))
         (st2 d d')
         (sym O3 (lexL DD.DenX DD.cmpDen (phi d) (phi d'))
                 (lexL N cmpN (map (PtD d) N (\ p -> sel (U1 d d') p.1) (att d)) (map (PtD d') N (\ p -> sel (U2 d d') p.1) (att d')))
            (lexL-map (PtD d) (PtD d') DD.DenX N DD.cmpDen cmpN (gD d) (gD d')
               (\ p -> sel (U1 d d') p.1) (\ p -> sel (U2 d d') p.1) (gCmp d d') (att d) (att d')))) ;

  mono (d d' : DT.DenX) (h : Id Bool (ltO DT.DenX DT.cmpDen d d') true) : Id Bool (EY.ltE (phi d) (phi d')) true =
    andB-intro (EY.dec (phi d)) (isLt (lexL DD.DenX DD.cmpDen (phi d) (phi d'))) (decPhi d)
      (trans Bool (isLt (lexL DD.DenX DD.cmpDen (phi d) (phi d'))) (isLt (DT.cmpDen d d')) true
         (ap O3 Bool isLt (lexL DD.DenX DD.cmpDen (phi d) (phi d')) (DT.cmpDen d d')
            (sym O3 (DT.cmpDen d d') (lexL DD.DenX DD.cmpDen (phi d) (phi d')) (phi-cmp d d')))
         h) ;

  module PE = Pull[DT.DenX, ltO DT.DenX DT.cmpDen, List DD.DenX, EY.ltE, phi, mono] ;

  wf (wd : Acc[DD.DenX, ltO DD.DenX DD.cmpDen].WF) : Acc[DT.DenX, ltO DT.DenX DT.cmpDen].WF = PE.pullWF (EY.wfE wd) ;
} ;

------------------------------------------------------------------------
-- polynomial pre-dilators (built from Id, 1, +, . and 2^) are dilators

-- a pre-dilator, as one structure
PDS : U a =
  (D0 : N -> N) * (D1 : Wd -> Wd) *
  (((w : Wd) -> Id N (len (D1 w)) (D0 (len w))) *
   (((w : Wd) -> Id N (ones (D1 w)) (D0 (ones w))) *
    (((n : N) -> Id Wd (D1 (idW n)) (idW (D0 n))) *
     (((v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w))) *
      ((v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))))))) ;

sumPDS (P Q : PDS) : PDS =
  (SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].S0, SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].S1,
   SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].slen, SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].sones, SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].sid,
   SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].scomp, SumDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].smeet) ;

prodPDS (P Q : PDS) : PDS =
  (ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].P0, ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].P1,
   ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].plen, ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].pones, ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].pid,
   ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].pcomp, ProdDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2, Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].pmeet) ;

expPDS (P : PDS) : PDS =
  (ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].X0, ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].X1, ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].xlen, ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].xones,
   ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].xid, ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].xcomp, ExpDil[P.1, P.2.1, P.2.2.1, P.2.2.2.1, P.2.2.2.2.1, P.2.2.2.2.2.1, P.2.2.2.2.2.2].xmeet) ;

data Pol = pId | pOne | pSum (p q : Pol) | pProd (p q : Pol) | pExp (p : Pol) ;

interp : Pol -> PDS = split {
  pId -> (\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
          \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w)) ;
  pOne -> (\ n -> one, \ w -> i nil, \ w -> refl one, \ w -> refl one,
           \ n -> refl (i nil), \ v w h -> refl (i nil), \ v w h -> refl (i nil)) ;
  pSum p q | rp rq -> sumPDS rp rq ;
  pProd p q | rp rq -> prodPDS rp rq ;
  pExp p | rp -> expPDS rp } ;

-- D is a dilator: D(X) is well-founded whenever X is (a quantification
-- over a large type)
IsDil (Q : PDS) : U a+ =
  (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
  -> Acc[X, ltO X cmpX].WF
  -> Acc[LinOrd[X, cmpX, xeq, xflip, xtrans].DenOrd[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].DenX,
         ltO LinOrd[X, cmpX, xeq, xflip, xtrans].DenOrd[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].DenX LinOrd[X, cmpX, xeq, xflip, xtrans].DenOrd[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].cmpDen].WF ;

module PolWF (X : U a) (cmpX : X -> X -> O3)
  (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
  (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
  (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt) (wx : Acc[X, ltO X cmpX].WF) {
  module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;

  WFD (Q : PDS) : U a = Acc[LX.DenOrd[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].DenX, ltO LX.DenOrd[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].DenX LX.DenOrd[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2].cmpDen].WF ;

  thm : (p : Pol) -> WFD (interp p) = split {
    pId -> IdWF[X, cmpX, xeq, xflip, xtrans].wf wx ;
    pOne -> OneWF[X, cmpX, xeq, xflip, xtrans].wf ;
    pSum p q | rp rq -> SumWF[X, cmpX, xeq, xflip, xtrans, (interp p).1, (interp p).2.1, (interp p).2.2.1, (interp p).2.2.2.1, (interp p).2.2.2.2.1, (interp p).2.2.2.2.2.1, (interp p).2.2.2.2.2.2, (interp q).1, (interp q).2.1, (interp q).2.2.1, (interp q).2.2.2.1, (interp q).2.2.2.2.1, (interp q).2.2.2.2.2.1, (interp q).2.2.2.2.2.2].wf rp rq ;
    pProd p q | rp rq -> ProdWF[X, cmpX, xeq, xflip, xtrans, (interp p).1, (interp p).2.1, (interp p).2.2.1, (interp p).2.2.2.1, (interp p).2.2.2.2.1, (interp p).2.2.2.2.2.1, (interp p).2.2.2.2.2.2, (interp q).1, (interp q).2.1, (interp q).2.2.1, (interp q).2.2.2.1, (interp q).2.2.2.2.1, (interp q).2.2.2.2.2.1, (interp q).2.2.2.2.2.2].wf rp rq ;
    pExp p | rp -> ExpWF[X, cmpX, xeq, xflip, xtrans, (interp p).1, (interp p).2.1, (interp p).2.2.1, (interp p).2.2.2.1, (interp p).2.2.2.2.1, (interp p).2.2.2.2.2.1, (interp p).2.2.2.2.2.2].wf rp } ;
} ;

polDil (p : Pol) : IsDil (interp p) = \ X cmpX xeq xflip xtrans wx -> PolWF[X, cmpX, xeq, xflip, xtrans, wx].thm p ;

-- in particular D(omega) is well-founded
omegaWF (p : Pol) : Acc[LN.DenOrd[(interp p).1, (interp p).2.1, (interp p).2.2.1, (interp p).2.2.2.1, (interp p).2.2.2.2.1, (interp p).2.2.2.2.2.1, (interp p).2.2.2.2.2.2].DenX,
                        ltO LN.DenOrd[(interp p).1, (interp p).2.1, (interp p).2.2.1, (interp p).2.2.2.1, (interp p).2.2.2.2.1, (interp p).2.2.2.2.2.1, (interp p).2.2.2.2.2.2].DenX LN.DenOrd[(interp p).1, (interp p).2.1, (interp p).2.2.1, (interp p).2.2.2.1, (interp p).2.2.2.2.1, (interp p).2.2.2.2.2.1, (interp p).2.2.2.2.2.2].cmpDen].WF =
  polDil p N cmpN cmpN-eq cmpN-flip cmpN-trans wfN ;

------------------------------------------------------------------------
-- the link with ordinal.seg: the tree of a polynomial dilator, built
-- directly by addo and mulo; its slow growing hierarchy is
-- gamma(k) = |D(k)| = D0 k, the number of points of D(k), which is also
-- the number of denotations of D(omega) bounded by k (Omega.pt)
-- (ord, inj0, G1, addo, mulo, omega, lem are copied from ordinal.seg)

data ord = oz | os (n : ord) | ol (f : N -> ord) ;

inj0 : N -> ord = split {
  zero -> oz ;
  suc n | r -> os r } ;

G1 : ord -> N -> N = split {
  oz -> \ x -> zero ;
  os z | r -> \ x -> suc (r x) ;
  ol f | r -> \ x -> r x x } ;

addo (a0 : ord) : ord -> ord = split {
  oz -> a0 ;
  os b | r -> os r ;
  ol f | r -> ol r } ;

mulo (a0 : ord) : ord -> ord = split {
  oz -> oz ;
  os b | r -> addo r a0 ;
  ol f | r -> ol r } ;

omega : ord = ol inj0 ;

lem : (n p : N) -> Id N (G1 (inj0 n) p) n = split {
  zero -> \ p -> refl zero ;
  suc q | r -> \ p -> ap N N (\ k -> suc k) (G1 (inj0 q) p) q (r p) } ;

plus-comm : (m n : N) -> Id N (plus m n) (plus n m) = split {
  zero -> \ n -> sym N (plus n zero) n (plus-zero n) ;
  suc m | r -> \ n -> trans N (suc (plus m n)) (suc (plus n m)) (plus n (suc m))
                         (sucEq (plus m n) (plus n m) (r n)) (sym N (plus n (suc m)) (suc (plus n m)) (plus-sucR n m)) } ;

G1-addo (k : N) (x : ord) : (y : ord) -> Id N (G1 (addo x y) k) (plus (G1 x k) (G1 y k)) = split {
  oz -> sym N (plus (G1 x k) zero) (G1 x k) (plus-zero (G1 x k)) ;
  os y | r -> trans N (suc (G1 (addo x y) k)) (suc (plus (G1 x k) (G1 y k))) (plus (G1 x k) (suc (G1 y k)))
                (sucEq (G1 (addo x y) k) (plus (G1 x k) (G1 y k)) r)
                (sym N (plus (G1 x k) (suc (G1 y k))) (suc (plus (G1 x k) (G1 y k))) (plus-sucR (G1 x k) (G1 y k))) ;
  ol f | r -> r k } ;

G1-mulo (k : N) (x : ord) : (y : ord) -> Id N (G1 (mulo x y) k) (mul (G1 y k) (G1 x k)) = split {
  oz -> refl zero ;
  os y | r -> trans N (G1 (addo (mulo x y) x) k) (plus (G1 (mulo x y) k) (G1 x k)) (mul (suc (G1 y k)) (G1 x k))
                (G1-addo k (mulo x y) x)
                (trans N (plus (G1 (mulo x y) k) (G1 x k)) (plus (mul (G1 y k) (G1 x k)) (G1 x k)) (mul (suc (G1 y k)) (G1 x k))
                   (ap N N (\ m -> plus m (G1 x k)) (G1 (mulo x y) k) (mul (G1 y k) (G1 x k)) r)
                   (plus-comm (mul (G1 y k) (G1 x k)) (G1 x k))) ;
  ol f | r -> r k } ;

-- 2^b, with 2^(b+1) = 2^b + 2^b
exp2o : ord -> ord = split {
  oz -> os oz ;
  os b | r -> addo r r ;
  ol f | r -> ol r } ;

dblN-plus : (n : N) -> Id N (dblN n) (plus n n) = split {
  zero -> refl zero ;
  suc n | r -> trans N (suc (suc (dblN n))) (suc (suc (plus n n))) (suc (plus n (suc n)))
                 (sucEq (suc (dblN n)) (suc (plus n n)) (sucEq (dblN n) (plus n n) r))
                 (sucEq (suc (plus n n)) (plus n (suc n)) (sym N (plus n (suc n)) (suc (plus n n)) (plus-sucR n n))) } ;

G1-exp2o (k : N) : (y : ord) -> Id N (G1 (exp2o y) k) (pow2 (G1 y k)) = split {
  oz -> refl one ;
  os y | r -> trans N (G1 (addo (exp2o y) (exp2o y)) k) (plus (G1 (exp2o y) k) (G1 (exp2o y) k)) (dblN (pow2 (G1 y k)))
                (G1-addo k (exp2o y) (exp2o y))
                (trans N (plus (G1 (exp2o y) k) (G1 (exp2o y) k)) (plus (pow2 (G1 y k)) (pow2 (G1 y k))) (dblN (pow2 (G1 y k)))
                   (ap2 N N N plus (G1 (exp2o y) k) (pow2 (G1 y k)) (G1 (exp2o y) k) (pow2 (G1 y k)) r r)
                   (sym N (dblN (pow2 (G1 y k))) (plus (pow2 (G1 y k)) (pow2 (G1 y k))) (dblN-plus (pow2 (G1 y k))))) ;
  ol f | r -> r k } ;

-- D(omega) as a tree: Id is omega, 1 is 1, D + E and D . E (E copies of
-- D), and 2^D
tree : Pol -> ord = split {
  pId -> omega ;
  pOne -> os oz ;
  pSum p q | rp rq -> addo rp rq ;
  pProd p q | rp rq -> mulo rp rq ;
  pExp p | rp -> exp2o rp } ;

-- Girard 9.A for polynomial dilators: gamma_{D(omega)}(k) = |D(k)|
hier : (p : Pol) (k : N) -> Id N (G1 (tree p) k) ((interp p).1 k) = split {
  pId -> \ k -> lem k k ;
  pOne -> \ k -> refl one ;
  pSum p q | rp rq -> \ k ->
    trans N (G1 (addo (tree p) (tree q)) k) (plus (G1 (tree p) k) (G1 (tree q) k)) ((interp (pSum p q)).1 k)
      (G1-addo k (tree p) (tree q))
      (ap2 N N N plus (G1 (tree p) k) ((interp p).1 k) (G1 (tree q) k) ((interp q).1 k) (rp k) (rq k)) ;
  pProd p q | rp rq -> \ k ->
    trans N (G1 (mulo (tree p) (tree q)) k) (mul (G1 (tree q) k) (G1 (tree p) k)) ((interp (pProd p q)).1 k)
      (G1-mulo k (tree p) (tree q))
      (ap2 N N N mul (G1 (tree q) k) ((interp q).1 k) (G1 (tree p) k) ((interp p).1 k) (rq k) (rp k)) ;
  pExp p | rp -> \ k ->
    trans N (G1 (exp2o (tree p)) k) (pow2 (G1 (tree p) k)) ((interp (pExp p)).1 k)
      (G1-exp2o k (tree p)) (ap N N pow2 (G1 (tree p) k) ((interp p).1 k) (rp k)) } ;

-- example: (Id + 1) . Id, D(n) = n.(n + 1), the tree omega.(omega + 1)
exPol : Pol = pProd (pSum pId pOne) pId ;
#conv (interp exPol).1 three = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))) ;
#conv G1 (tree exPol) three = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))) ;

-- 2^Id: D(3) = 8
#conv (interp (pExp pId)).1 three = suc (suc (suc (suc (suc (suc (suc (suc zero))))))) ;
#conv G1 (tree (pExp pId)) three = suc (suc (suc (suc (suc (suc (suc (suc zero))))))) ;

------------------------------------------------------------------------
-- the level Omega (copied from ordinal.seg, constructors tl, tl2 renamed
-- tL, tL2 and add, mul renamed add2, mul2 to avoid clashes): the tree
-- D(Omega) of a polynomial dilator collapses to D(omega), satisfies the
-- condition O2, and so the slow growing hierarchy at D(Omega)[omega] is
-- the Hardy hierarchy at D(omega)

data ord2 = tz | ts (n : ord2) | tL (f : N -> ord2) | tL2 (f : ord -> ord2) ;

G2 : ord2 -> N -> ord = split {
  tz -> \ x -> oz ;
  ts z | r -> \ x -> os (r x) ;
  tL f | r -> \ x -> r x x ;
  tL2 f | r -> \ x -> ol (\ m -> r (inj0 m) x) } ;

O2 (n : N) : ord2 -> U a = split {
  tz -> Unit ;
  ts z | r -> r ;
  tL f | r -> (p : N) -> r p ;
  tL2 f | r -> (x : ord) -> r x * Id ord (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) } ;

inj12 : ord -> ord2 = split {
  oz -> tz ;
  os z | r -> ts r ;
  ol f | r -> tL r } ;

H1 : ord -> N -> N = split {
  oz -> \ x -> x ;
  os z | r -> \ x -> r (suc x) ;
  ol f | r -> \ x -> r x x } ;

H2 : ord2 -> ord -> ord = split {
  tz -> \ x -> x ;
  ts z | r -> \ x -> r (os x) ;
  tL f | r -> \ x -> ol (\ m -> r m x) ;
  tL2 f | r -> \ x -> r x x } ;

collapsing (n : N)
  : (x : ord2) (y : ord) -> O2 n x -> Id N (G1 (H2 x y) n) (H1 (G2 x n) (G1 y n)) = split {
  tz -> \ y h -> refl (G1 y n) ;
  ts z | r -> \ y h -> r (os y) h ;
  tL f | r -> \ y h -> r n y (h n) ;
  tL2 f | r -> \ y h ->
    trans N (G1 (H2 (f y) y) n) (H1 (G2 (f y) n) (G1 y n))
            (H1 (G2 (f (inj0 (G1 y n))) n) (G1 y n))
      (r y y (h y).1)
      (ap ord N (\ o -> H1 o (G1 y n))
          (G2 (f y) n) (G2 (f (inj0 (G1 y n))) n) (h y).2) } ;

omega1 : ord2 = tL2 inj12 ;

remO (n : N) : (x : ord) -> O2 n (inj12 x) = split {
  oz -> tt ;
  os z | r -> r ;
  ol f | r -> \ p -> r p } ;

remO1 (n : N) : (x : ord) -> Id ord (G2 (inj12 x) n) (G2 (inj12 (inj0 (G1 x n))) n) = split {
  oz -> refl oz ;
  os z | r -> ap ord ord (\ o -> os o) (G2 (inj12 z) n) (G2 (inj12 (inj0 (G1 z n))) n) r ;
  ol f | r -> r n } ;

lemOmega1 (n : N) : O2 n omega1 = \ x -> (remO n x, remO1 n x) ;

lem2 : (n p : N) -> Id ord (G2 (inj12 (inj0 n)) p) (inj0 n) = split {
  zero -> \ p -> refl oz ;
  suc q | r -> \ p -> ap ord ord (\ o -> os o) (G2 (inj12 (inj0 q)) p) (inj0 q) (r p) } ;

add2 (a0 : ord2) : ord2 -> ord2 = split {
  tz -> a0 ;
  ts b | r -> ts r ;
  tL f | r -> tL r ;
  tL2 f | r -> tL2 r } ;

mul2 (a0 : ord2) : ord2 -> ord2 = split {
  tz -> tz ;
  ts b | r -> add2 r a0 ;
  tL f | r -> tL r ;
  tL2 f | r -> tL2 r } ;

exp2 : ord2 -> ord2 = split {
  tz -> ts tz ;
  ts b | r -> add2 r r ;
  tL f | r -> tL r ;
  tL2 f | r -> tL2 r } ;

-- D(Omega): Id is Omega
tree2 : Pol -> ord2 = split {
  pId -> omega1 ;
  pOne -> ts tz ;
  pSum p q | rp rq -> add2 rp rq ;
  pProd p q | rp rq -> mul2 rp rq ;
  pExp p | rp -> exp2 rp } ;

-- the tower T_0 = Id + 1, T_(k+1) = 2^T_k: its trees have the limits
-- epsilon_0 and epsilon_(Omega+1) (2^(omega+1) = omega.2, 2^(omega.2) =
-- omega^2, ...), and eta0D is the Howard ordinal, as in ordinal.seg
towP : N -> Pol = split {
  zero -> pSum pId pOne ;
  suc k | r -> pExp r } ;

e0D : ord = ol (\ k -> tree (towP k)) ;

eps2D : ord2 = tL (\ k -> tree2 (towP k)) ;

eta0D : ord = H2 eps2D omega ;

module FE (funext : (A B : U a) (f g : A -> B) -> ((x : A) -> Id B (f x) (g x)) -> Id (A -> B) f g) {

  G2add (n : N) (a0 : ord2) : (b : ord2) -> Id ord (G2 (add2 a0 b) n) (addo (G2 a0 n) (G2 b n)) = split {
    tz -> refl (G2 a0 n) ;
    ts b | r -> ap ord ord (\ o -> os o) (G2 (add2 a0 b) n) (addo (G2 a0 n) (G2 b n)) r ;
    tL f | r -> r n ;
    tL2 f | r ->
      ap (N -> ord) ord (\ g -> ol g)
         (\ m -> G2 (add2 a0 (f (inj0 m))) n) (\ m -> addo (G2 a0 n) (G2 (f (inj0 m)) n))
         (funext N ord (\ m -> G2 (add2 a0 (f (inj0 m))) n) (\ m -> addo (G2 a0 n) (G2 (f (inj0 m)) n))
            (\ m -> r (inj0 m))) } ;

  G2mul (n : N) (a0 : ord2) : (b : ord2) -> Id ord (G2 (mul2 a0 b) n) (mulo (G2 a0 n) (G2 b n)) = split {
    tz -> refl oz ;
    ts b | r ->
      trans ord (G2 (add2 (mul2 a0 b) a0) n) (addo (G2 (mul2 a0 b) n) (G2 a0 n))
                (addo (mulo (G2 a0 n) (G2 b n)) (G2 a0 n))
        (G2add n (mul2 a0 b) a0)
        (ap ord ord (\ o -> addo o (G2 a0 n)) (G2 (mul2 a0 b) n) (mulo (G2 a0 n) (G2 b n)) r) ;
    tL f | r -> r n ;
    tL2 f | r ->
      ap (N -> ord) ord (\ g -> ol g)
         (\ m -> G2 (mul2 a0 (f (inj0 m))) n) (\ m -> mulo (G2 a0 n) (G2 (f (inj0 m)) n))
         (funext N ord (\ m -> G2 (mul2 a0 (f (inj0 m))) n) (\ m -> mulo (G2 a0 n) (G2 (f (inj0 m)) n))
            (\ m -> r (inj0 m))) } ;

  O2add (n : N) (a0 : ord2) (ha : O2 n a0) : (b : ord2) -> O2 n b -> O2 n (add2 a0 b) = split {
    tz -> \ hb -> ha ;
    ts b | r -> \ hb -> r hb ;
    tL f | r -> \ hb p -> r p (hb p) ;
    tL2 f | r -> \ hb x ->
      (r x (hb x).1,
       trans ord (G2 (add2 a0 (f x)) n) (addo (G2 a0 n) (G2 (f x) n))
                 (G2 (add2 a0 (f (inj0 (G1 x n)))) n)
         (G2add n a0 (f x))
         (trans ord (addo (G2 a0 n) (G2 (f x) n)) (addo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
                    (G2 (add2 a0 (f (inj0 (G1 x n)))) n)
            (ap ord ord (\ o -> addo (G2 a0 n) o) (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) (hb x).2)
            (sym ord (G2 (add2 a0 (f (inj0 (G1 x n)))) n) (addo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
               (G2add n a0 (f (inj0 (G1 x n))))))) } ;

  O2mul (n : N) (a0 : ord2) (ha : O2 n a0) : (b : ord2) -> O2 n b -> O2 n (mul2 a0 b) = split {
    tz -> \ hb -> tt ;
    ts b | r -> \ hb -> O2add n (mul2 a0 b) (r hb) a0 ha ;
    tL f | r -> \ hb p -> r p (hb p) ;
    tL2 f | r -> \ hb x ->
      (r x (hb x).1,
       trans ord (G2 (mul2 a0 (f x)) n) (mulo (G2 a0 n) (G2 (f x) n))
                 (G2 (mul2 a0 (f (inj0 (G1 x n)))) n)
         (G2mul n a0 (f x))
         (trans ord (mulo (G2 a0 n) (G2 (f x) n)) (mulo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
                    (G2 (mul2 a0 (f (inj0 (G1 x n)))) n)
            (ap ord ord (\ o -> mulo (G2 a0 n) o) (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) (hb x).2)
            (sym ord (G2 (mul2 a0 (f (inj0 (G1 x n)))) n) (mulo (G2 a0 n) (G2 (f (inj0 (G1 x n))) n))
               (G2mul n a0 (f (inj0 (G1 x n))))))) } ;

  G2exp2 (n : N) : (b : ord2) -> Id ord (G2 (exp2 b) n) (exp2o (G2 b n)) = split {
    tz -> refl (os oz) ;
    ts b | r ->
      trans ord (G2 (add2 (exp2 b) (exp2 b)) n) (addo (G2 (exp2 b) n) (G2 (exp2 b) n))
                (addo (exp2o (G2 b n)) (exp2o (G2 b n)))
        (G2add n (exp2 b) (exp2 b))
        (ap2 ord ord ord addo (G2 (exp2 b) n) (exp2o (G2 b n)) (G2 (exp2 b) n) (exp2o (G2 b n)) r r) ;
    tL f | r -> r n ;
    tL2 f | r ->
      ap (N -> ord) ord (\ g -> ol g)
         (\ m -> G2 (exp2 (f (inj0 m))) n) (\ m -> exp2o (G2 (f (inj0 m)) n))
         (funext N ord (\ m -> G2 (exp2 (f (inj0 m))) n) (\ m -> exp2o (G2 (f (inj0 m)) n))
            (\ m -> r (inj0 m))) } ;

  O2exp2 (n : N) : (b : ord2) -> O2 n b -> O2 n (exp2 b) = split {
    tz -> \ hb -> tt ;
    ts b | r -> \ hb -> O2add n (exp2 b) (r hb) (exp2 b) (r hb) ;
    tL f | r -> \ hb p -> r p (hb p) ;
    tL2 f | r -> \ hb x ->
      (r x (hb x).1,
       trans ord (G2 (exp2 (f x)) n) (exp2o (G2 (f x) n)) (G2 (exp2 (f (inj0 (G1 x n)))) n)
         (G2exp2 n (f x))
         (trans ord (exp2o (G2 (f x) n)) (exp2o (G2 (f (inj0 (G1 x n))) n)) (G2 (exp2 (f (inj0 (G1 x n)))) n)
            (ap ord ord exp2o (G2 (f x) n) (G2 (f (inj0 (G1 x n))) n) (hb x).2)
            (sym ord (G2 (exp2 (f (inj0 (G1 x n)))) n) (exp2o (G2 (f (inj0 (G1 x n))) n))
               (G2exp2 n (f (inj0 (G1 x n))))))) } ;

  G2omega1 (n : N) : Id ord (G2 omega1 n) omega =
    ap (N -> ord) ord (\ g -> ol g) (\ m -> G2 (inj12 (inj0 m)) n) (\ m -> inj0 m)
       (funext N ord (\ m -> G2 (inj12 (inj0 m)) n) (\ m -> inj0 m) (\ m -> lem2 m n)) ;

  -- every polynomial D(Omega) satisfies O2
  O2tree (n : N) : (p : Pol) -> O2 n (tree2 p) = split {
    pId -> lemOmega1 n ;
    pOne -> tt ;
    pSum p q | rp rq -> O2add n (tree2 p) rp (tree2 q) rq ;
    pProd p q | rp rq -> O2mul n (tree2 p) rp (tree2 q) rq ;
    pExp p | rp -> O2exp2 n (tree2 p) rp } ;

  -- D(Omega) collapses to D(omega): Omega becomes omega
  G2tree (n : N) : (p : Pol) -> Id ord (G2 (tree2 p) n) (tree p) = split {
    pId -> G2omega1 n ;
    pOne -> refl (os oz) ;
    pSum p q | rp rq ->
      trans ord (G2 (add2 (tree2 p) (tree2 q)) n) (addo (G2 (tree2 p) n) (G2 (tree2 q) n)) (addo (tree p) (tree q))
        (G2add n (tree2 p) (tree2 q))
        (ap2 ord ord ord addo (G2 (tree2 p) n) (tree p) (G2 (tree2 q) n) (tree q) rp rq) ;
    pProd p q | rp rq ->
      trans ord (G2 (mul2 (tree2 p) (tree2 q)) n) (mulo (G2 (tree2 p) n) (G2 (tree2 q) n)) (mulo (tree p) (tree q))
        (G2mul n (tree2 p) (tree2 q))
        (ap2 ord ord ord mulo (G2 (tree2 p) n) (tree p) (G2 (tree2 q) n) (tree q) rp rq) ;
    pExp p | rp ->
      trans ord (G2 (exp2 (tree2 p)) n) (exp2o (G2 (tree2 p) n)) (exp2o (tree p))
        (G2exp2 n (tree2 p)) (ap ord ord exp2o (G2 (tree2 p) n) (tree p) rp) } ;

  -- the collapsing theorem for polynomial dilators
  collapse-tree (n : N) (p : Pol) (y : ord) : Id N (G1 (H2 (tree2 p) y) n) (H1 (tree p) (G1 y n)) =
    trans N (G1 (H2 (tree2 p) y) n) (H1 (G2 (tree2 p) n) (G1 y n)) (H1 (tree p) (G1 y n))
      (collapsing n (tree2 p) y (O2tree n p))
      (ap ord N (\ o -> H1 o (G1 y n)) (G2 (tree2 p) n) (tree p) (G2tree n p)) ;

  -- at y = omega: the slow growing hierarchy at D(Omega)[omega] is the
  -- Hardy hierarchy at D(omega)
  hierH (n : N) (p : Pol) : Id N (G1 (H2 (tree2 p) omega) n) (H1 (tree p) n) =
    trans N (G1 (H2 (tree2 p) omega) n) (H1 (tree p) (G1 omega n)) (H1 (tree p) n)
      (collapse-tree n p omega)
      (ap N N (\ k -> H1 (tree p) k) (G1 omega n) n (lem n n)) ;

  -- the hierarchy theorem of ordinal.seg through dilators: the slow
  -- growing hierarchy at the Howard ordinal is the Hardy hierarchy at
  -- epsilon_0
  hierEta (n : N) : Id N (G1 eta0D n) (H1 e0D n) =
    trans N (G1 (H2 eps2D omega) n) (H1 (G2 eps2D n) (G1 omega n)) (H1 e0D n)
      (collapsing n eps2D omega (\ p -> O2tree n (towP p)))
      (trans N (H1 (G2 (tree2 (towP n)) n) (G1 omega n)) (H1 (G2 (tree2 (towP n)) n) n) (H1 (tree (towP n)) n)
         (ap N N (\ k -> H1 (G2 (tree2 (towP n)) n) k) (G1 omega n) n (lem n n))
         (ap ord N (\ t -> H1 t n) (G2 (tree2 (towP n)) n) (tree (towP n)) (G2tree n (towP n)))) ;
} ;

------------------------------------------------------------------------
-- (g) morphisms.  A natural transformation T : D -> E is a family of
-- strictly increasing maps t n : [D0 n] -> [E0 n] with E(w) . t m = t n . D(w)
-- for w : [m] -> [n].  T sends the trace of D into the trace of E (Girard
-- 8.2.5 (ii)), the denotation (w, z) to (w, T(m)(z)), and is determined by
-- its action on the traces (8.3.5 (ii)).

cmpN-refl : (n : N) -> Id O3 (cmpN n n) eq = split {
  zero -> refl eq ;
  suc n | r -> r } ;

-- sel f is injective on [ones f]
sel-inj (f : Wd) (x y : N) (hx : Id Bool (ltN x (ones f)) true) (hy : Id Bool (ltN y (ones f)) true)
  (e : Id N (sel f x) (sel f y)) : Id N x y =
  cmpN-eq x y
    (trans O3 (cmpN x y) (cmpN (sel f x) (sel f y)) eq
       (sym O3 (cmpN (sel f x) (sel f y)) (cmpN x y) (sel-mono f x y hx hy))
       (subst N (\ k -> Id O3 (cmpN (sel f x) k) eq) (sel f x) (sel f y) e (cmpN-refl (sel f x)))) ;

-- a word is determined by its length, its number of ones and sel
sel-ext (A B : Wd) (hl : Id N (len A) (len B)) (ho : Id N (ones A) (ones B))
  (hs : (x : N) -> Id Bool (ltN x (ones A)) true -> Id N (sel A x) (sel B x)) : Id Wd A B =
  wext A B hl
    (\ y h -> subst N (\ k -> Id Bool (at B k) true) (sel B (rank A y)) y
                (trans N (sel B (rank A y)) (sel A (rank A y)) y
                   (sym N (sel A (rank A y)) (sel B (rank A y)) (hs (rank A y) (rank-lt A y h)))
                   (sel-rank A y h))
                (at-sel B (rank A y)
                   (subst N (\ k -> Id Bool (ltN (rank A y) k) true) (ones A) (ones B) ho (rank-lt A y h))))
    (\ y h -> subst N (\ k -> Id Bool (at A k) true) (sel A (rank B y)) y
                (trans N (sel A (rank B y)) (sel B (rank B y)) y
                   (hs (rank B y)
                      (subst N (\ k -> Id Bool (ltN (rank B y) k) true) (ones B) (ones A) (sym N (ones A) (ones B) ho)
                         (rank-lt B y h)))
                   (sel-rank B y h))
                (at-sel A (rank B y)
                   (subst N (\ k -> Id Bool (ltN (rank B y) k) true) (ones B) (ones A) (sym N (ones A) (ones B) ho)
                      (rank-lt B y h)))) ;

sel-idW : (k z : N) -> Id Bool (ltN z k) true -> Id N (sel (idW k) z) z = split {
  zero -> \ z h -> ltN-zero-abs (Id N zero z) z h ;
  suc k | r -> split {
    zero -> \ h -> refl zero ;
    suc z -> \ h -> sucEq (sel (idW k) z) z (r z h) } } ;

-- a v : [k] -> [n] which is not the identity misses a point p; then the
-- two maps [n] -> [n+1] that skip p and p+1 agree on v (Girard 8.2.5)
TwoW (v : Wd) : U a =
  (g1 : Wd) * (g2 : Wd) * (Id N (len g1) (suc (len v)) * (Id N (len g2) (suc (len v)) *
  (Id N (ones g1) (len v) * (Id N (ones g2) (len v) *
  ((Id Wd g1 g2 -> Empty) * Id Wd (compW g1 v) (compW g2 v)))))) ;

twoI (v : Wd) (q : TwoW v) : TwoW (i v) =
  (i q.1, i q.2.1, sucEq (len q.1) (suc (len v)) q.2.2.1, sucEq (len q.2.1) (suc (len v)) q.2.2.2.1,
   sucEq (ones q.1) (len v) q.2.2.2.2.1, sucEq (ones q.2.1) (len v) q.2.2.2.2.2.1,
   \ e -> q.2.2.2.2.2.2.1 (ap Wd Wd tl (i q.1) (i q.2.1) e),
   ap Wd Wd (\ u -> i u) (compW q.1 v) (compW q.2.1 v) q.2.2.2.2.2.2.2) ;

twoDec (v : Wd) (r : (Id Wd v (idW (len v)) -> Empty) -> TwoW v) (ne : Id Wd (i v) (idW (len (i v))) -> Empty)
  : Or (Id Wd v (idW (len v))) (Id Wd v (idW (len v)) -> Empty) -> TwoW (i v) = split {
  inl e -> absurdE (TwoW (i v)) (ne (ap Wd Wd (\ u -> i u) v (idW (len v)) e)) ;
  inr k -> twoI v (r k) } ;

twoW : (v : Wd) -> (Id Wd v (idW (len v)) -> Empty) -> TwoW v = split {
  nil -> \ ne -> absurdE (TwoW nil) (ne (refl nil)) ;
  o v -> \ ne ->
    (o (i (idW (len v))), i (o (idW (len v))),
     sucEq (suc (len (idW (len v)))) (suc (len v)) (sucEq (len (idW (len v))) (len v) (len-idW (len v))),
     sucEq (suc (len (idW (len v)))) (suc (len v)) (sucEq (len (idW (len v))) (len v) (len-idW (len v))),
     sucEq (ones (idW (len v))) (len v) (ones-idW (len v)),
     sucEq (ones (idW (len v))) (len v) (ones-idW (len v)),
     \ e -> absurdB Empty (ap Wd Bool hd (o (i (idW (len v)))) (i (o (idW (len v)))) e),
     refl (o (o (compW (idW (len v)) v)))) ;
  i v | r -> \ ne -> twoDec v r ne (decW v (idW (len v))) } ;

module Nat
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w)))
  (t : N -> Wd) (tlen : (n : N) -> Id N (len (t n)) (E0 n)) (tones : (n : N) -> Id N (ones (t n)) (D0 n))
  (tnat : (w : Wd) -> Id Wd (compW (E1 w) (t (ones w))) (compW (t (len w)) (D1 w))) {

  module PD = PreDil[D0, D1, dlen, dones, did, dcomp, dmeet] ;
  module PE = PreDil[E0, E1, elen, eones, eid, ecomp, emeet] ;

  -- z is in the trace Tr(n)
  TPd (n z : N) : U a = Id Bool (ltN z (D0 n)) true * Id Wd PD.Sup[n, z].supp (idW n) ;
  TPe (n z : N) : U a = Id Bool (ltN z (E0 n)) true * Id Wd PE.Sup[n, z].supp (idW n) ;

  -- T(n)(D(w)(z)) = E(w)(T(m)(z))
  nat-sel (w : Wd) (z : N) : Id N (sel (t (len w)) (sel (D1 w) z)) (sel (E1 w) (sel (t (ones w)) z)) =
    trans N (sel (t (len w)) (sel (D1 w) z)) (sel (compW (t (len w)) (D1 w)) z) (sel (E1 w) (sel (t (ones w)) z))
      (sym N (sel (compW (t (len w)) (D1 w)) z) (sel (t (len w)) (sel (D1 w) z))
         (sel-comp (t (len w)) (D1 w) z
            (trans N (ones (t (len w))) (D0 (len w)) (len (D1 w)) (tones (len w)) (sym N (len (D1 w)) (D0 (len w)) (dlen w)))))
      (trans N (sel (compW (t (len w)) (D1 w)) z) (sel (compW (E1 w) (t (ones w))) z) (sel (E1 w) (sel (t (ones w)) z))
         (ap Wd N (\ u -> sel u z) (compW (t (len w)) (D1 w)) (compW (E1 w) (t (ones w)))
            (sym Wd (compW (E1 w) (t (ones w))) (compW (t (len w)) (D1 w)) (tnat w)))
         (sel-comp (E1 w) (t (ones w)) z
            (trans N (ones (E1 w)) (E0 (ones w)) (len (t (ones w))) (eones w)
               (sym N (len (t (ones w))) (E0 (ones w)) (tlen (ones w)))))) ;

  natn (n : N) (w : Wd) (hl : Id N (len w) n) (z : N) : Id N (sel (t n) (sel (D1 w) z)) (sel (E1 w) (sel (t (ones w)) z)) =
    subst N (\ k -> Id N (sel (t k) (sel (D1 w) z)) (sel (E1 w) (sel (t (ones w)) z))) (len w) n hl (nat-sel w z) ;

  ltT (n z : N) (h : Id Bool (ltN z (D0 n)) true) : Id Bool (ltN (sel (t n) z) (E0 n)) true =
    subst N (\ k -> Id Bool (ltN (sel (t n) z) k) true) (len (t n)) (E0 n) (tlen n)
      (sel-lt (t n) z (subst N (\ k -> Id Bool (ltN z k) true) (D0 n) (ones (t n)) (sym N (ones (t n)) (D0 n) (tones n)) h)) ;

  -- 8.2.5 (ii): if T(m)(z) is in the image of E(v) with v not the
  -- identity, take g1 /= g2 with g1 . v = g2 . v; then E(g1) and E(g2)
  -- agree on T(m)(z), so (naturality, T injective) D(g1) and D(g2) agree
  -- on z, and since z is in the trace, g1 and g2 are both the least
  -- support of this point
  module TrT (m z : N) (tp : TPd m z) (v : Wd) (hl : Id N (len v) m)
    (hv : Id Bool (at (E1 v) (sel (t m) z)) true) (ne : Id Wd v (idW (len v)) -> Empty) {

    q : TwoW v = twoW v ne ;

    y : N = sel (t m) z ;

    e : N = rank (E1 v) y ;

    -- E(g)(y) = E(g . v)(e)
    Eg (g : Wd) (og : Id N (ones g) (len v)) : Id N (sel (E1 g) y) (sel (E1 (compW g v)) e) =
      trans N (sel (E1 g) y) (sel (E1 g) (sel (E1 v) e)) (sel (E1 (compW g v)) e)
        (ap N N (\ k -> sel (E1 g) k) y (sel (E1 v) e) (sym N (sel (E1 v) e) y (sel-rank (E1 v) y hv)))
        (trans N (sel (E1 g) (sel (E1 v) e)) (sel (compW (E1 g) (E1 v)) e) (sel (E1 (compW g v)) e)
           (sym N (sel (compW (E1 g) (E1 v)) e) (sel (E1 g) (sel (E1 v) e))
              (sel-comp (E1 g) (E1 v) e
                 (trans N (ones (E1 g)) (E0 (ones g)) (len (E1 v)) (eones g)
                    (trans N (E0 (ones g)) (E0 (len v)) (len (E1 v)) (ap N N E0 (ones g) (len v) og)
                       (sym N (len (E1 v)) (E0 (len v)) (elen v))))))
           (ap Wd N (\ u -> sel u e) (compW (E1 g) (E1 v)) (E1 (compW g v))
              (sym Wd (E1 (compW g v)) (compW (E1 g) (E1 v)) (ecomp g v og)))) ;

    E12 : Id N (sel (E1 q.1) y) (sel (E1 q.2.1) y) =
      trans N (sel (E1 q.1) y) (sel (E1 (compW q.1 v)) e) (sel (E1 q.2.1) y)
        (Eg q.1 q.2.2.2.2.1)
        (trans N (sel (E1 (compW q.1 v)) e) (sel (E1 (compW q.2.1 v)) e) (sel (E1 q.2.1) y)
           (ap Wd N (\ u -> sel (E1 u) e) (compW q.1 v) (compW q.2.1 v) q.2.2.2.2.2.2.2)
           (sym N (sel (E1 q.2.1) y) (sel (E1 (compW q.2.1 v)) e) (Eg q.2.1 q.2.2.2.2.2.1))) ;

    -- naturality at g : [m] -> [m + 1]
    natg (g : Wd) (hg : Id N (len g) (suc m)) (og : Id N (ones g) m)
      : Id N (sel (t (suc m)) (sel (D1 g) z)) (sel (E1 g) y) =
      trans N (sel (t (suc m)) (sel (D1 g) z)) (sel (E1 g) (sel (t (ones g)) z)) (sel (E1 g) y)
        (natn (suc m) g hg z)
        (ap N N (\ k -> sel (E1 g) (sel (t k) z)) (ones g) m og) ;

    bx (g : Wd) (hg : Id N (len g) (suc m)) (og : Id N (ones g) m)
      : Id Bool (ltN (sel (D1 g) z) (ones (t (suc m)))) true =
      subst N (\ k -> Id Bool (ltN (sel (D1 g) z) k) true) (len (D1 g)) (ones (t (suc m)))
        (trans N (len (D1 g)) (D0 (suc m)) (ones (t (suc m)))
           (trans N (len (D1 g)) (D0 (len g)) (D0 (suc m)) (dlen g) (ap N N D0 (len g) (suc m) hg))
           (sym N (ones (t (suc m))) (D0 (suc m)) (tones (suc m))))
        (sel-lt (D1 g) z
           (subst N (\ k -> Id Bool (ltN z k) true) (D0 m) (ones (D1 g))
              (sym N (ones (D1 g)) (D0 m) (trans N (ones (D1 g)) (D0 (ones g)) (D0 m) (dones g) (ap N N D0 (ones g) m og)))
              tp.1)) ;

    hg1 : Id N (len q.1) (suc m) = trans N (len q.1) (suc (len v)) (suc m) q.2.2.1 (sucEq (len v) m hl) ;
    hg2 : Id N (len q.2.1) (suc m) = trans N (len q.2.1) (suc (len v)) (suc m) q.2.2.2.1 (sucEq (len v) m hl) ;
    og1 : Id N (ones q.1) m = trans N (ones q.1) (len v) m q.2.2.2.2.1 hl ;
    og2 : Id N (ones q.2.1) m = trans N (ones q.2.1) (len v) m q.2.2.2.2.2.1 hl ;

    -- D(g1)(z) = D(g2)(z)
    xe : Id N (sel (D1 q.1) z) (sel (D1 q.2.1) z) =
      sel-inj (t (suc m)) (sel (D1 q.1) z) (sel (D1 q.2.1) z) (bx q.1 hg1 og1) (bx q.2.1 hg2 og2)
        (trans N (sel (t (suc m)) (sel (D1 q.1) z)) (sel (E1 q.1) y) (sel (t (suc m)) (sel (D1 q.2.1) z))
           (natg q.1 hg1 og1)
           (trans N (sel (E1 q.1) y) (sel (E1 q.2.1) y) (sel (t (suc m)) (sel (D1 q.2.1) z))
              E12 (sym N (sel (t (suc m)) (sel (D1 q.2.1) z)) (sel (E1 q.2.1) y) (natg q.2.1 hg2 og2)))) ;

    -- the denotations (g1, z) and (g2, z) of D(m + 1)
    d1 : PD.Den (suc m) = (q.1, z, hg1, subst N (\ k -> TPd k z) m (ones q.1) (sym N (ones q.1) m og1) tp) ;
    d2 : PD.Den (suc m) = (q.2.1, z, hg2, subst N (\ k -> TPd k z) m (ones q.2.1) (sym N (ones q.2.1) m og2) tp) ;

    geq : Id Wd q.1 q.2.1 =
      trans Wd q.1 PD.Sup[suc m, sel (D1 q.1) z].supp q.2.1
        (sym Wd PD.Sup[suc m, sel (D1 q.1) z].supp q.1 (PD.fwd-bwd-w (suc m) d1))
        (trans Wd PD.Sup[suc m, sel (D1 q.1) z].supp PD.Sup[suc m, sel (D1 q.2.1) z].supp q.2.1
           (ap N Wd (\ k -> PD.Sup[suc m, k].supp) (sel (D1 q.1) z) (sel (D1 q.2.1) z) xe)
           (PD.fwd-bwd-w (suc m) d2)) ;

    contra : Empty = q.2.2.2.2.2.2.1 geq ;
  } ;

  trDec (m z : N) (tp : TPd m z) (v : Wd) (hl : Id N (len v) m) (hv : Id Bool (at (E1 v) (sel (t m) z)) true)
    : Or (Id Wd v (idW m)) (Id Wd v (idW m) -> Empty) -> Id Wd v (idW m) = split {
    inl e -> e ;
    inr k -> absurdE (Id Wd v (idW m))
               TrT[m, z, tp, v, hl, hv, \ e -> k (trans Wd v (idW (len v)) (idW m) e (ap N Wd (\ j -> idW j) (len v) m hl))].contra } ;

  trT (m z : N) (tp : TPd m z) : TPe m (sel (t m) z) =
    (ltT m z tp.1,
     PE.trace-supp m (sel (t m) z) (ltT m z tp.1)
       (\ v hl hv -> trDec m z tp v hl hv (decW v (idW m)))) ;

  -- the action on denotations: (w, z) goes to (w, T(m)(z))
  denT (n : N) (d : PD.Den n) : PE.Den n = (d.1, sel (t (ones d.1)) d.2.1, d.2.2.1, trT (ones d.1) d.2.1 d.2.2.2) ;

  denT-ok (n : N) (d : PD.Den n) : Id N (PE.bwd n (denT n d)).1 (sel (t n) (PD.bwd n d).1) =
    sym N (sel (t n) (sel (D1 d.1) d.2.1)) (sel (E1 d.1) (sel (t (ones d.1)) d.2.1)) (natn n d.1 d.2.2.1 d.2.1) ;
} ;

-- two natural transformations that agree on the traces are equal
module NatEq
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w)))
  (t : N -> Wd) (tlen : (n : N) -> Id N (len (t n)) (E0 n)) (tones : (n : N) -> Id N (ones (t n)) (D0 n))
  (tnat : (w : Wd) -> Id Wd (compW (E1 w) (t (ones w))) (compW (t (len w)) (D1 w)))
  (t' : N -> Wd) (tlen' : (n : N) -> Id N (len (t' n)) (E0 n)) (tones' : (n : N) -> Id N (ones (t' n)) (D0 n))
  (tnat' : (w : Wd) -> Id Wd (compW (E1 w) (t' (ones w))) (compW (t' (len w)) (D1 w))) {

  module T1 = Nat[D0, D1, dlen, dones, did, dcomp, dmeet, E0, E1, elen, eones, eid, ecomp, emeet, t, tlen, tones, tnat] ;
  module T2 = Nat[D0, D1, dlen, dones, did, dcomp, dmeet, E0, E1, elen, eones, eid, ecomp, emeet, t', tlen', tones', tnat'] ;

  module Pts (agree : (m z : N) -> T1.TPd m z -> Id N (sel (t m) z) (sel (t' m) z)) {

    -- on x = D(w)(z), with (w, z) the denotation of x
    eqPt (n x : N) (h : Id Bool (ltN x (D0 n)) true) : Id N (sel (t n) x) (sel (t' n) x) =
      trans N (sel (t n) x) (sel (t n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1) (sel (t' n) x)
        (ap N N (\ k -> sel (t n) k) x (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1
           (sym N (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1 x (T1.PD.bwd-fwd n (x, T1.PD.hzOf n x h))))
        (trans N (sel (t n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1)
                 (sel (t' n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1) (sel (t' n) x)
           (trans N (sel (t n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1)
                    (sel (E1 T1.PD.Sup[n, x].supp) (sel (t (ones T1.PD.Sup[n, x].supp)) T1.PD.Point[n, x, T1.PD.hzOf n x h].z))
                    (sel (t' n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1)
              (T1.natn n T1.PD.Sup[n, x].supp (T1.PD.fwd n (x, T1.PD.hzOf n x h)).2.2.1 T1.PD.Point[n, x, T1.PD.hzOf n x h].z)
              (trans N (sel (E1 T1.PD.Sup[n, x].supp) (sel (t (ones T1.PD.Sup[n, x].supp)) T1.PD.Point[n, x, T1.PD.hzOf n x h].z))
                       (sel (E1 T1.PD.Sup[n, x].supp) (sel (t' (ones T1.PD.Sup[n, x].supp)) T1.PD.Point[n, x, T1.PD.hzOf n x h].z))
                       (sel (t' n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1)
                 (ap N N (\ k -> sel (E1 T1.PD.Sup[n, x].supp) k)
                    (sel (t (ones T1.PD.Sup[n, x].supp)) T1.PD.Point[n, x, T1.PD.hzOf n x h].z)
                    (sel (t' (ones T1.PD.Sup[n, x].supp)) T1.PD.Point[n, x, T1.PD.hzOf n x h].z)
                    (agree (ones T1.PD.Sup[n, x].supp) T1.PD.Point[n, x, T1.PD.hzOf n x h].z
                       (T1.PD.fwd n (x, T1.PD.hzOf n x h)).2.2.2))
                 (sym N (sel (t' n) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1)
                        (sel (E1 T1.PD.Sup[n, x].supp) (sel (t' (ones T1.PD.Sup[n, x].supp)) T1.PD.Point[n, x, T1.PD.hzOf n x h].z))
                    (T2.natn n T1.PD.Sup[n, x].supp (T1.PD.fwd n (x, T1.PD.hzOf n x h)).2.2.1 T1.PD.Point[n, x, T1.PD.hzOf n x h].z))))
           (ap N N (\ k -> sel (t' n) k) (T1.PD.bwd n (T1.PD.fwd n (x, T1.PD.hzOf n x h))).1 x
              (T1.PD.bwd-fwd n (x, T1.PD.hzOf n x h)))) ;

    eqT (n : N) : Id Wd (t n) (t' n) =
      sel-ext (t n) (t' n)
        (trans N (len (t n)) (E0 n) (len (t' n)) (tlen n) (sym N (len (t' n)) (E0 n) (tlen' n)))
        (trans N (ones (t n)) (D0 n) (ones (t' n)) (tones n) (sym N (ones (t' n)) (D0 n) (tones' n)))
        (\ x h -> eqPt n x (subst N (\ k -> Id Bool (ltN x k) true) (ones (t n)) (D0 n) (tones n) h)) ;
  } ;
} ;

-- the inclusions of D and E into D + E (Girard 9.1.3): natural
-- transformations, whose traces are z |-> z and y |-> D0 m + y
idW-comp : (C : Wd) -> Id Wd (compW (idW (len C)) C) C = split {
  nil -> refl nil ;
  o C | r -> ap Wd Wd (\ u -> o u) (compW (idW (len C)) C) C r ;
  i C | r -> ap Wd Wd (\ u -> i u) (compW (idW (len C)) C) C r } ;

app-nil : (A : Wd) -> Id Wd (app A nil) A = split {
  nil -> refl nil ;
  o A | r -> ap Wd Wd (\ u -> o u) (app A nil) A r ;
  i A | r -> ap Wd Wd (\ u -> i u) (app A nil) A r } ;

module SumInc
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (E0 : N -> N) (E1 : Wd -> Wd)
  (elen : (w : Wd) -> Id N (len (E1 w)) (E0 (len w)))
  (eones : (w : Wd) -> Id N (ones (E1 w)) (E0 (ones w)))
  (eid : (n : N) -> Id Wd (E1 (idW n)) (idW (E0 n)))
  (ecomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (E1 (compW v w)) (compW (E1 v) (E1 w)))
  (emeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (E1 (andW v w)) (andW (E1 v) (E1 w))) {

  module SD = SumDil[D0, D1, dlen, dones, did, dcomp, dmeet, E0, E1, elen, eones, eid, ecomp, emeet] ;

  inl (n : N) : Wd = app (idW (D0 n)) (zeros (E0 n)) ;

  inr (n : N) : Wd = app (zeros (D0 n)) (idW (E0 n)) ;

  inl-len (n : N) : Id N (len (inl n)) (SD.S0 n) =
    trans N (len (inl n)) (plus (len (idW (D0 n))) (len (zeros (E0 n)))) (SD.S0 n)
      (len-app (idW (D0 n)) (zeros (E0 n)))
      (ap2 N N N plus (len (idW (D0 n))) (D0 n) (len (zeros (E0 n))) (E0 n) (len-idW (D0 n)) (len-zeros (E0 n))) ;

  inl-ones (n : N) : Id N (ones (inl n)) (D0 n) =
    trans N (ones (inl n)) (plus (ones (idW (D0 n))) (ones (zeros (E0 n)))) (D0 n)
      (ones-app (idW (D0 n)) (zeros (E0 n)))
      (trans N (plus (ones (idW (D0 n))) (ones (zeros (E0 n)))) (plus (D0 n) zero) (D0 n)
         (ap2 N N N plus (ones (idW (D0 n))) (D0 n) (ones (zeros (E0 n))) zero (ones-idW (D0 n)) (ones-zeros (E0 n)))
         (plus-zero (D0 n))) ;

  inr-len (n : N) : Id N (len (inr n)) (SD.S0 n) =
    trans N (len (inr n)) (plus (len (zeros (D0 n))) (len (idW (E0 n)))) (SD.S0 n)
      (len-app (zeros (D0 n)) (idW (E0 n)))
      (ap2 N N N plus (len (zeros (D0 n))) (D0 n) (len (idW (E0 n))) (E0 n) (len-zeros (D0 n)) (len-idW (E0 n))) ;

  inr-ones (n : N) : Id N (ones (inr n)) (E0 n) =
    trans N (ones (inr n)) (plus (ones (zeros (D0 n))) (ones (idW (E0 n)))) (E0 n)
      (ones-app (zeros (D0 n)) (idW (E0 n)))
      (ap2 N N N plus (ones (zeros (D0 n))) zero (ones (idW (E0 n))) (E0 n) (ones-zeros (D0 n)) (ones-idW (E0 n))) ;

  -- compW (D1 w) (idW (D0 m)) = D1 w, and compW (idW (D0 n)) (D1 w) = D1 w
  cidR (w : Wd) : Id Wd (compW (D1 w) (idW (D0 (ones w)))) (D1 w) =
    subst N (\ k -> Id Wd (compW (D1 w) (idW k)) (D1 w)) (ones (D1 w)) (D0 (ones w)) (dones w) (comp-id (D1 w)) ;

  cidL (w : Wd) : Id Wd (compW (idW (D0 (len w))) (D1 w)) (D1 w) =
    subst N (\ k -> Id Wd (compW (idW k) (D1 w)) (D1 w)) (len (D1 w)) (D0 (len w)) (dlen w) (idW-comp (D1 w)) ;

  eidR (w : Wd) : Id Wd (compW (E1 w) (idW (E0 (ones w)))) (E1 w) =
    subst N (\ k -> Id Wd (compW (E1 w) (idW k)) (E1 w)) (ones (E1 w)) (E0 (ones w)) (eones w) (comp-id (E1 w)) ;

  eidL (w : Wd) : Id Wd (compW (idW (E0 (len w))) (E1 w)) (E1 w) =
    subst N (\ k -> Id Wd (compW (idW k) (E1 w)) (E1 w)) (len (E1 w)) (E0 (len w)) (elen w) (idW-comp (E1 w)) ;

  inl-nat (w : Wd) : Id Wd (compW (SD.S1 w) (inl (ones w))) (compW (inl (len w)) (D1 w)) =
    trans Wd (compW (SD.S1 w) (inl (ones w))) (app (D1 w) (zeros (E0 (len w)))) (compW (inl (len w)) (D1 w))
      (trans Wd (compW (SD.S1 w) (inl (ones w)))
                (app (compW (D1 w) (idW (D0 (ones w)))) (compW (E1 w) (zeros (E0 (ones w)))))
                (app (D1 w) (zeros (E0 (len w))))
         (comp-app (D1 w) (idW (D0 (ones w)))
            (trans N (ones (D1 w)) (D0 (ones w)) (len (idW (D0 (ones w)))) (dones w)
               (sym N (len (idW (D0 (ones w)))) (D0 (ones w)) (len-idW (D0 (ones w)))))
            (E1 w) (zeros (E0 (ones w))))
         (ap2 Wd Wd Wd app (compW (D1 w) (idW (D0 (ones w)))) (D1 w)
            (compW (E1 w) (zeros (E0 (ones w)))) (zeros (E0 (len w)))
            (cidR w)
            (trans Wd (compW (E1 w) (zeros (E0 (ones w)))) (zeros (len (E1 w))) (zeros (E0 (len w)))
               (comp-into-zeros (E1 w) (E0 (ones w))) (ap N Wd zeros (len (E1 w)) (E0 (len w)) (elen w)))))
      (sym Wd (compW (inl (len w)) (D1 w)) (app (D1 w) (zeros (E0 (len w))))
         (trans Wd (compW (inl (len w)) (D1 w)) (compW (inl (len w)) (app (D1 w) nil)) (app (D1 w) (zeros (E0 (len w))))
            (ap Wd Wd (\ u -> compW (inl (len w)) u) (D1 w) (app (D1 w) nil) (sym Wd (app (D1 w) nil) (D1 w) (app-nil (D1 w))))
            (trans Wd (compW (inl (len w)) (app (D1 w) nil))
                      (app (compW (idW (D0 (len w))) (D1 w)) (compW (zeros (E0 (len w))) nil))
                      (app (D1 w) (zeros (E0 (len w))))
               (comp-app (idW (D0 (len w))) (D1 w)
                  (trans N (ones (idW (D0 (len w)))) (D0 (len w)) (len (D1 w)) (ones-idW (D0 (len w)))
                     (sym N (len (D1 w)) (D0 (len w)) (dlen w)))
                  (zeros (E0 (len w))) nil)
               (ap2 Wd Wd Wd app (compW (idW (D0 (len w))) (D1 w)) (D1 w)
                  (compW (zeros (E0 (len w))) nil) (zeros (E0 (len w)))
                  (cidL w) (comp-zeros (E0 (len w)) nil))))) ;

  inr-nat (w : Wd) : Id Wd (compW (SD.S1 w) (inr (ones w))) (compW (inr (len w)) (E1 w)) =
    trans Wd (compW (SD.S1 w) (inr (ones w))) (app (zeros (D0 (len w))) (E1 w)) (compW (inr (len w)) (E1 w))
      (trans Wd (compW (SD.S1 w) (inr (ones w)))
                (app (compW (D1 w) (zeros (D0 (ones w)))) (compW (E1 w) (idW (E0 (ones w)))))
                (app (zeros (D0 (len w))) (E1 w))
         (comp-app (D1 w) (zeros (D0 (ones w)))
            (trans N (ones (D1 w)) (D0 (ones w)) (len (zeros (D0 (ones w)))) (dones w)
               (sym N (len (zeros (D0 (ones w)))) (D0 (ones w)) (len-zeros (D0 (ones w)))))
            (E1 w) (idW (E0 (ones w))))
         (ap2 Wd Wd Wd app (compW (D1 w) (zeros (D0 (ones w)))) (zeros (D0 (len w)))
            (compW (E1 w) (idW (E0 (ones w)))) (E1 w)
            (trans Wd (compW (D1 w) (zeros (D0 (ones w)))) (zeros (len (D1 w))) (zeros (D0 (len w)))
               (comp-into-zeros (D1 w) (D0 (ones w))) (ap N Wd zeros (len (D1 w)) (D0 (len w)) (dlen w)))
            (eidR w)))
      (sym Wd (compW (inr (len w)) (E1 w)) (app (zeros (D0 (len w))) (E1 w))
         (trans Wd (compW (inr (len w)) (app nil (E1 w)))
                   (app (compW (zeros (D0 (len w))) nil) (compW (idW (E0 (len w))) (E1 w)))
                   (app (zeros (D0 (len w))) (E1 w))
            (comp-app (zeros (D0 (len w))) nil (ones-zeros (D0 (len w))) (idW (E0 (len w))) (E1 w))
            (ap2 Wd Wd Wd app (compW (zeros (D0 (len w))) nil) (zeros (D0 (len w)))
               (compW (idW (E0 (len w))) (E1 w)) (E1 w)
               (comp-zeros (D0 (len w)) nil) (eidL w)))) ;

  module TL = Nat[D0, D1, dlen, dones, did, dcomp, dmeet, SD.S0, SD.S1, SD.slen, SD.sones, SD.sid, SD.scomp, SD.smeet,
                  inl, inl-len, inl-ones, inl-nat] ;
  module TR = Nat[E0, E1, elen, eones, eid, ecomp, emeet, SD.S0, SD.S1, SD.slen, SD.sones, SD.sid, SD.scomp, SD.smeet,
                  inr, inr-len, inr-ones, inr-nat] ;

  selL (m z : N) (h : Id Bool (ltN z (D0 m)) true) : Id N (sel (inl m) z) z =
    trans N (sel (inl m) z) (sel (idW (D0 m)) z) z
      (sel-app-l (idW (D0 m)) z (zeros (E0 m))
         (subst N (\ k -> Id Bool (ltN z k) true) (D0 m) (ones (idW (D0 m))) (sym N (ones (idW (D0 m))) (D0 m) (ones-idW (D0 m))) h))
      (sel-idW (D0 m) z h) ;

  selR (m y : N) (h : Id Bool (ltN y (E0 m)) true) : Id N (sel (inr m) y) (plus (D0 m) y) =
    trans N (sel (inr m) y) (plus (D0 m) (sel (idW (E0 m)) y)) (plus (D0 m) y)
      (sel-app-zeros (D0 m) (idW (E0 m)) y)
      (ap N N (\ k -> plus (D0 m) k) (sel (idW (E0 m)) y) y (sel-idW (E0 m) y h)) ;

  -- the traces of D and of E are in the trace of D + E
  trL (m z : N) (tp : TL.TPd m z) : TL.TPe m z =
    subst N (\ k -> TL.TPe m k) (sel (inl m) z) z (selL m z tp.1) (TL.trT m z tp) ;

  trR (m y : N) (tp : TR.TPd m y) : TR.TPe m (plus (D0 m) y) =
    subst N (\ k -> TR.TPe m k) (sel (inr m) y) (plus (D0 m) y) (selR m y tp.1) (TR.trT m y tp) ;
} ;

-- example: the trace point 0 of Id at 1 goes to the trace point 0 of Id + 1,
-- the trace point 0 of 1 at 0 to the point 0 of (Id + 1)(0)
module IncIdOne = SumInc[\ n -> n, \ w -> w, \ w -> refl (len w), \ w -> refl (ones w),
  \ n -> refl (idW n), \ v w h -> refl (compW v w), \ v w h -> refl (andW v w),
  \ n -> one, \ w -> i nil, \ w -> refl one, \ w -> refl one,
  \ n -> refl (i nil), \ v w h -> refl (i nil), \ v w h -> refl (i nil)] ;

#conv IncIdOne.inl three = i (i (i (o nil))) ;
#conv IncIdOne.inr three = o (o (o (i nil))) ;

------------------------------------------------------------------------
-- (f) connected components (Girard 9.1.5-9.1.7).  Two trace points (m, z)
-- and (m', z') are separated when every denotation with trace (m, z) is
-- below every denotation with trace (m', z'), whatever the coefficients
-- (|S(m, z ; m', z')| = 0 in Girard's notation, with the sign +1); they
-- are linked when they are separated in neither order.  In a sum F + G of
-- non zero pre-dilators, the trace points coming from F are separated from
-- those coming from G (the proof of 9.1.7).  So a non zero pre-dilator
-- whose trace points are all linked is connected: it is not a non trivial
-- sum.

module Conn
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

  module PD = PreDil[D0, D1, dlen, dones, did, dcomp, dmeet] ;

  TP (n z : N) : U a = Id Bool (ltN z (D0 n)) true * Id Wd PD.Sup[n, z].supp (idW n) ;

  Sep (m z m' z' : N) : U a =
    (u u' : Wd) -> Id N (len u) (len u') -> Id N (ones u) m -> Id N (ones u') m'
      -> Id O3 (cmpN (sel (D1 u) z) (sel (D1 u') z')) lt ;

  Linked (m z m' z' : N) : U a = (Sep m z m' z' -> Empty) * (Sep m' z' m z -> Empty) ;

  AllLinked : U a = (m z m' z' : N) -> TP m z -> TP m' z' -> Linked m z m' z' ;

  -- a trace point is not separated from itself
  sepIrr (m z m' z' : N) (em : Id N m m') (ez : Id N z z') (s : Sep m z m' z') : Empty =
    absurdB Empty
      (ap O3 Bool isLt eq lt
         (trans O3 eq (cmpN (sel (D1 (idW m)) z) (sel (D1 (idW m)) z')) lt
            (subst N (\ k -> Id O3 eq (cmpN (sel (D1 (idW m)) z) (sel (D1 (idW m)) k))) z z' ez
               (sym O3 (cmpN (sel (D1 (idW m)) z) (sel (D1 (idW m)) z)) eq (cmpN-refl (sel (D1 (idW m)) z))))
            (s (idW m) (idW m) (refl (len (idW m))) (ones-idW m) (trans N (ones (idW m)) m m' (ones-idW m) em)))) ;

  -- a pre-dilator with a single trace point (m0, z0) has all its trace points linked
  single (m0 z0 : N) (uniq : (m z : N) -> TP m z -> Id N m m0 * Id N z z0) : AllLinked =
    \ m z m' z' tp tp' ->
      (\ s -> sepIrr m z m' z' (trans N m m0 m' (uniq m z tp).1 (sym N m' m0 (uniq m' z' tp').1))
                (trans N z z0 z' (uniq m z tp).2 (sym N z' z0 (uniq m' z' tp').2)) s,
       \ s -> sepIrr m' z' m z (trans N m' m0 m (uniq m' z' tp').1 (sym N m m0 (uniq m z tp).1))
                (trans N z' z0 z (uniq m' z' tp').2 (sym N z z0 (uniq m z tp).2)) s) ;

  -- separation is an order between the denotations of D(X), for any X
  module InX (X : U a) (cmpX : X -> X -> O3)
    (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
    (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
    (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt) {
    module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
    module DX = LX.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;

    sepX (d d' : DX.DenX) (s : Sep (LX.lenL d.1) d.2.1 (LX.lenL d'.1) d'.2.1) : Id O3 (DX.cmpDen d d') lt =
      s (LX.merge d.1 d'.1).2.1 (LX.merge d.1 d'.1).2.2
        (trans N (len (LX.merge d.1 d'.1).2.1) (LX.lenL (LX.merge d.1 d'.1).1) (len (LX.merge d.1 d'.1).2.2)
           (DX.mOK d d').1 (sym N (len (LX.merge d.1 d'.1).2.2) (LX.lenL (LX.merge d.1 d'.1).1) (DX.mOK d d').2.1))
        (LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d.1 (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))
        (LX.onesOver (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d'.1 (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d'))) ;
  } ;
} ;

-- pre-dilators as structures (PDS): non zero, sums, connected (9.1.5)
NonZero (Q : PDS) : U a = (n : N) * (x : N) * Id Bool (ltN x (Q.1 n)) true ;

IsSum (Q F G : PDS) : U a =
  ((n : N) -> Id N (Q.1 n) (plus (F.1 n) (G.1 n))) * ((w : Wd) -> Id Wd (Q.2.1 w) (app (F.2.1 w) (G.2.1 w))) ;

Connected (Q : PDS) : U a = NonZero Q * ((F G : PDS) -> IsSum Q F G -> NonZero F -> NonZero G -> Empty) ;

-- in F + G, a trace point of F and a trace point of G are separated
module ConnSum (F G : PDS) {
  module SI = SumInc[F.1, F.2.1, F.2.2.1, F.2.2.2.1, F.2.2.2.2.1, F.2.2.2.2.2.1, F.2.2.2.2.2.2,
                     G.1, G.2.1, G.2.2.1, G.2.2.2.1, G.2.2.2.2.1, G.2.2.2.2.2.1, G.2.2.2.2.2.2] ;
  module CS = Conn[SI.SD.S0, SI.SD.S1, SI.SD.slen, SI.SD.sones, SI.SD.sid, SI.SD.scomp, SI.SD.smeet] ;
  module PF = PreDil[F.1, F.2.1, F.2.2.1, F.2.2.2.1, F.2.2.2.2.1, F.2.2.2.2.2.1, F.2.2.2.2.2.2] ;
  module PG = PreDil[G.1, G.2.1, G.2.2.1, G.2.2.2.1, G.2.2.2.2.1, G.2.2.2.2.2.1, G.2.2.2.2.2.2] ;

  sepFG (m z m' y : N) (hz : Id Bool (ltN z (F.1 m)) true) : CS.Sep m z m' (plus (F.1 m') y) =
    \ u u' hl hm hm' ->
      trans O3 (cmpN (sel (SI.SD.S1 u) z) (sel (SI.SD.S1 u') (plus (F.1 m') y)))
               (cmpN (sel (F.2.1 u) z) (plus (len (F.2.1 u)) (sel (G.2.1 u') y))) lt
        (ap2 N N O3 cmpN (sel (SI.SD.S1 u) z) (sel (F.2.1 u) z)
           (sel (SI.SD.S1 u') (plus (F.1 m') y)) (plus (len (F.2.1 u)) (sel (G.2.1 u') y))
           (sel-app-l (F.2.1 u) z (G.2.1 u)
              (subst N (\ k -> Id Bool (ltN z k) true) (F.1 m) (ones (F.2.1 u))
                 (sym N (ones (F.2.1 u)) (F.1 m)
                    (trans N (ones (F.2.1 u)) (F.1 (ones u)) (F.1 m) (F.2.2.2.1 u) (ap N N F.1 (ones u) m hm)))
                 hz))
           (trans N (sel (SI.SD.S1 u') (plus (F.1 m') y)) (sel (SI.SD.S1 u') (plus (ones (F.2.1 u')) y))
                    (plus (len (F.2.1 u)) (sel (G.2.1 u') y))
              (ap N N (\ k -> sel (SI.SD.S1 u') (plus k y)) (F.1 m') (ones (F.2.1 u'))
                 (sym N (ones (F.2.1 u')) (F.1 m')
                    (trans N (ones (F.2.1 u')) (F.1 (ones u')) (F.1 m') (F.2.2.2.1 u') (ap N N F.1 (ones u') m' hm'))))
              (trans N (sel (SI.SD.S1 u') (plus (ones (F.2.1 u')) y)) (plus (len (F.2.1 u')) (sel (G.2.1 u') y))
                       (plus (len (F.2.1 u)) (sel (G.2.1 u') y))
                 (sel-app-r (F.2.1 u') (G.2.1 u') y)
                 (ap N N (\ k -> plus k (sel (G.2.1 u') y)) (len (F.2.1 u')) (len (F.2.1 u))
                    (trans N (len (F.2.1 u')) (F.1 (len u')) (len (F.2.1 u)) (F.2.2.1 u')
                       (trans N (F.1 (len u')) (F.1 (len u)) (len (F.2.1 u))
                          (ap N N F.1 (len u') (len u) (sym N (len u) (len u') hl))
                          (sym N (len (F.2.1 u)) (F.1 (len u)) (F.2.2.1 u))))))))
        (cmpN-lt-plus (sel (F.2.1 u) z) (len (F.2.1 u)) (sel (G.2.1 u') y)
           (sel-lt (F.2.1 u) z
              (subst N (\ k -> Id Bool (ltN z k) true) (F.1 m) (ones (F.2.1 u))
                 (sym N (ones (F.2.1 u)) (F.1 m)
                    (trans N (ones (F.2.1 u)) (F.1 (ones u)) (F.1 m) (F.2.2.2.1 u) (ap N N F.1 (ones u) m hm)))
                 hz))) ;

  -- Lemma 9.1.7: F + G with F and G non zero has two separated trace points,
  -- the traces of the normal forms of a point of F and of a point of G
  module NL (nzF : NonZero F) (nzG : NonZero G) {
    dF : PF.Den nzF.1 = PF.fwd nzF.1 (nzF.2.1, PF.hzOf nzF.1 nzF.2.1 nzF.2.2) ;
    dG : PG.Den nzG.1 = PG.fwd nzG.1 (nzG.2.1, PG.hzOf nzG.1 nzG.2.1 nzG.2.2) ;

    notLinked (al : CS.AllLinked) : Empty =
      (al (ones dF.1) dF.2.1 (ones dG.1) (plus (F.1 (ones dG.1)) dG.2.1)
          (SI.trL (ones dF.1) dF.2.1 dF.2.2.2) (SI.trR (ones dG.1) dG.2.1 dG.2.2.2)).1
        (sepFG (ones dF.1) dF.2.1 (ones dG.1) dG.2.1 dF.2.2.2.1) ;
  } ;
} ;

-- Lemma 9.1.7: a non zero pre-dilator whose trace points are all linked is
-- connected
module ConnCrit (Q : PDS) {
  module CQ = Conn[Q.1, Q.2.1, Q.2.2.1, Q.2.2.2.1, Q.2.2.2.2.1, Q.2.2.2.2.2.1, Q.2.2.2.2.2.2] ;

  module Split (F G : PDS) (isS : IsSum Q F G) {
    module CF = ConnSum[F, G] ;

    -- the trace points and the separation of F + G are those of Q
    tpQ (m z : N) (tp : CF.CS.TP m z) : CQ.TP m z =
      (subst N (\ k -> Id Bool (ltN z k) true) (plus (F.1 m) (G.1 m)) (Q.1 m) (sym N (Q.1 m) (plus (F.1 m) (G.1 m)) (isS.1 m)) tp.1,
       CQ.PD.trace-supp m z
         (subst N (\ k -> Id Bool (ltN z k) true) (plus (F.1 m) (G.1 m)) (Q.1 m) (sym N (Q.1 m) (plus (F.1 m) (G.1 m)) (isS.1 m)) tp.1)
         (\ v hl hv -> CF.CS.PD.supp-trace m z tp.1 tp.2 v hl
            (trans Bool (at (CF.SI.SD.S1 v) z) (at (Q.2.1 v) z) true
               (ap Wd Bool (\ u -> at u z) (CF.SI.SD.S1 v) (Q.2.1 v) (sym Wd (Q.2.1 v) (CF.SI.SD.S1 v) (isS.2 v)))
               hv))) ;

    sepQ (m z m' z' : N) (s : CF.CS.Sep m z m' z') : CQ.Sep m z m' z' =
      \ u u' hl hm hm' ->
        trans O3 (cmpN (sel (Q.2.1 u) z) (sel (Q.2.1 u') z')) (cmpN (sel (CF.SI.SD.S1 u) z) (sel (CF.SI.SD.S1 u') z')) lt
          (ap2 Wd Wd O3 (\ A B -> cmpN (sel A z) (sel B z')) (Q.2.1 u) (CF.SI.SD.S1 u) (Q.2.1 u') (CF.SI.SD.S1 u')
             (isS.2 u) (isS.2 u'))
          (s u u' hl hm hm') ;

    allS (al : CQ.AllLinked) : CF.CS.AllLinked =
      \ m z m' z' tp tp' ->
        (\ s -> (al m z m' z' (tpQ m z tp) (tpQ m' z' tp')).1 (sepQ m z m' z' s),
         \ s -> (al m z m' z' (tpQ m z tp) (tpQ m' z' tp')).2 (sepQ m' z' m z s)) ;

    noSplit (al : CQ.AllLinked) (nzF : NonZero F) (nzG : NonZero G) : Empty =
      CF.NL[nzF, nzG].notLinked (allS al) ;
  } ;

  connected (nz : NonZero Q) (al : CQ.AllLinked) : Connected Q =
    (nz, \ F G isS nzF nzG -> Split[F, G, isS].noSplit al nzF nzG) ;
} ;

-- examples: Id and 1 have a single trace point, (1, 0) and (0, 0), so they
-- are connected; Id + 1 is not
module ConnId = ConnCrit[interp pId] ;

idTr (m z : N) (tp : ConnId.CQ.TP m z) : Id N m one * Id N z zero =
  (trans N m (ones (idW m)) one (sym N (ones (idW m)) m (ones-idW m))
     (trans N (ones (idW m)) (ones (pt m z)) one
        (ap Wd N ones (idW m) (pt m z)
           (sym Wd (pt m z) (idW m) (ConnId.CQ.PD.supp-trace m z tp.1 tp.2 (pt m z) (len-pt m z) (at-pt m z tp.1))))
        (ones-pt m z tp.1)),
   lt-one z (subst N (\ k -> Id Bool (ltN z k) true) m one
               (trans N m (ones (idW m)) one (sym N (ones (idW m)) m (ones-idW m))
                  (trans N (ones (idW m)) (ones (pt m z)) one
                     (ap Wd N ones (idW m) (pt m z)
                        (sym Wd (pt m z) (idW m) (ConnId.CQ.PD.supp-trace m z tp.1 tp.2 (pt m z) (len-pt m z) (at-pt m z tp.1))))
                     (ones-pt m z tp.1)))
               tp.1)) ;

idConnected : Connected (interp pId) = ConnId.connected (one, zero, refl true) (ConnId.CQ.single one zero idTr) ;

module ConnOne = ConnCrit[interp pOne] ;

oneTr (m z : N) (tp : ConnOne.CQ.TP m z) : Id N m zero * Id N z zero =
  (trans N m (ones (idW m)) zero (sym N (ones (idW m)) m (ones-idW m))
     (trans N (ones (idW m)) (ones (zeros m)) zero
        (ap Wd N ones (idW m) (zeros m)
           (sym Wd (zeros m) (idW m)
              (ConnOne.CQ.PD.supp-trace m z tp.1 tp.2 (zeros m) (len-zeros m)
                 (subst N (\ k -> Id Bool (at (i nil) k) true) zero z (sym N z zero (lt-one z tp.1)) (refl true)))))
        (ones-zeros m)),
   lt-one z tp.1) ;

oneConnected : Connected (interp pOne) = ConnOne.connected (zero, zero, refl true) (ConnOne.CQ.single zero zero oneTr) ;

idPlusOne-notConnected (c : Connected (interp (pSum pId pOne))) : Empty =
  c.2 (interp pId) (interp pOne) (\ n -> refl (plus n one), \ w -> refl (app w (i nil)))
    (one, zero, refl true) (zero, zero, refl true) ;

------------------------------------------------------------------------
-- (h) kinds (Girard 9.1.10-9.1.11).  A dilator is of kind 0 (it is 0), 1
-- (F' + 1), omega (a sum over a limit of non zero dilators) or Omega
-- (F' + F'' with F'' connected and not 1).  For a tree of the level Omega
-- the kind is the head constructor: tz, ts, tL, tL2.  For the polynomial
-- dilators (with 2^), tree2 p has kind 1 or Omega, never 0 or omega, and
-- it has kind 1 iff the largest point of D(n + 1) is a constant (a point
-- coming from D(0)), as for F' + 1 (oneTop).

data Kind = k0 | k1 | kw | kW ;

isK0 : Kind -> Bool = split { k0 -> true ; k1 -> false ; kw -> false ; kW -> false } ;

isK1 : Kind -> Bool = split { k0 -> false ; k1 -> true ; kw -> false ; kW -> false } ;

goodK : Kind -> Bool = split { k0 -> false ; k1 -> true ; kw -> false ; kW -> true } ;

kindT : ord2 -> Kind = split {
  tz -> k0 ;
  ts b -> k1 ;
  tL f -> kw ;
  tL2 f -> kW } ;

-- the kind once the successors are removed
baseT : ord2 -> Kind = split {
  tz -> k0 ;
  ts b | r -> r ;
  tL f -> kw ;
  tL2 f -> kW } ;

kSum (k : Kind) : Kind -> Kind = split { k0 -> k ; k1 -> k1 ; kw -> kw ; kW -> kW } ;

kM (k : Kind) : Kind -> Kind = split { k0 -> k0 ; k1 -> k ; kw -> kw ; kW -> kW } ;

kE : Kind -> Kind = split { k0 -> k1 ; k1 -> k1 ; kw -> kw ; kW -> kW } ;

kSum-same : (k : Kind) -> Id Kind (kSum k k) k = split {
  k0 -> refl k0 ; k1 -> refl k1 ; kw -> refl kw ; kW -> refl kW } ;

kSum-nz (k : Kind) : (k' : Kind) -> Id Bool (isK0 k') false -> Id Kind (kSum k k') k' = split {
  k0 -> \ h -> absurdB (Id Kind k k0) (sym Bool true false h) ;
  k1 -> \ h -> refl k1 ;
  kw -> \ h -> refl kw ;
  kW -> \ h -> refl kW } ;

kindT-add (x : ord2) : (y : ord2) -> Id Kind (kindT (add2 x y)) (kSum (kindT x) (kindT y)) = split {
  tz -> refl (kindT x) ;
  ts b -> refl k1 ;
  tL f -> refl kw ;
  tL2 f -> refl kW } ;

baseT-add (x : ord2) : (y : ord2) -> Id Kind (baseT (add2 x y)) (kSum (baseT x) (baseT y)) = split {
  tz -> refl (baseT x) ;
  ts b | r -> r ;
  tL f -> refl kw ;
  tL2 f -> refl kW } ;

kindT-mul (x : ord2) (hx : Id Bool (isK0 (kindT x)) false)
  : (y : ord2) -> Id Kind (kindT (mul2 x y)) (kM (kindT x) (kindT y)) = split {
  tz -> refl k0 ;
  ts b -> trans Kind (kindT (add2 (mul2 x b) x)) (kSum (kindT (mul2 x b)) (kindT x)) (kindT x)
            (kindT-add (mul2 x b) x) (kSum-nz (kindT (mul2 x b)) (kindT x) hx) ;
  tL f -> refl kw ;
  tL2 f -> refl kW } ;

baseT-mul0 (x : ord2) (hx : Id Kind (baseT x) k0) : (y : ord2) -> Id Kind (baseT (mul2 x y)) (baseT y) = split {
  tz -> refl k0 ;
  ts b | r -> trans Kind (baseT (add2 (mul2 x b) x)) (kSum (baseT (mul2 x b)) (baseT x)) (baseT b)
                (baseT-add (mul2 x b) x)
                (ap2 Kind Kind Kind kSum (baseT (mul2 x b)) (baseT b) (baseT x) k0 r hx) ;
  tL f -> refl kw ;
  tL2 f -> refl kW } ;

baseT-mulW (x : ord2) (hx : Id Kind (baseT x) kW)
  : (y : ord2) -> Id Bool (goodK (kindT y)) true -> Id Kind (baseT (mul2 x y)) kW = split {
  tz -> \ h -> absurdB (Id Kind k0 kW) h ;
  ts b -> \ h -> trans Kind (baseT (add2 (mul2 x b) x)) (kSum (baseT (mul2 x b)) (baseT x)) kW
                   (baseT-add (mul2 x b) x) (ap Kind Kind (kSum (baseT (mul2 x b))) (baseT x) kW hx) ;
  tL f -> \ h -> absurdB (Id Kind kw kW) h ;
  tL2 f -> \ h -> refl kW } ;

baseT-exp : (b : ord2) -> Id Kind (baseT (exp2 b)) (baseT b) = split {
  tz -> refl k0 ;
  ts b | r -> trans Kind (baseT (add2 (exp2 b) (exp2 b))) (kSum (baseT (exp2 b)) (baseT (exp2 b))) (baseT b)
                (baseT-add (exp2 b) (exp2 b))
                (trans Kind (kSum (baseT (exp2 b)) (baseT (exp2 b))) (baseT (exp2 b)) (baseT b) (kSum-same (baseT (exp2 b))) r) ;
  tL f -> refl kw ;
  tL2 f -> refl kW } ;

kindT-exp : (b : ord2) -> Id Kind (kindT (exp2 b)) (kE (baseT b)) = split {
  tz -> refl k1 ;
  ts b | r -> trans Kind (kindT (add2 (exp2 b) (exp2 b))) (kSum (kindT (exp2 b)) (kindT (exp2 b))) (kE (baseT b))
                (kindT-add (exp2 b) (exp2 b))
                (trans Kind (kSum (kindT (exp2 b)) (kindT (exp2 b))) (kindT (exp2 b)) (kE (baseT b)) (kSum-same (kindT (exp2 b))) r) ;
  tL f -> refl kw ;
  tL2 f -> refl kW } ;

-- the syntax: is D constant, is the top point of D(n + 1) a constant
isConst : Pol -> Bool = split {
  pId -> false ;
  pOne -> true ;
  pSum p q | rp rq -> andB rp rq ;
  pProd p q | rp rq -> andB rq rp ;
  pExp p | rp -> rp } ;

topK : Pol -> Bool = split {
  pId -> false ;
  pOne -> true ;
  pSum p q | rp rq -> rq ;
  pProd p q | rp rq -> andB rq rp ;
  pExp p -> isConst p } ;

kSumB : (c d : Bool) -> Id Kind (kSum (ifW Kind c k0 kW) (ifW Kind d k0 kW)) (ifW Kind (andB c d) k0 kW) = split {
  false -> split { false -> refl kW ; true -> refl kW } ;
  true -> split { false -> refl kW ; true -> refl k0 } } ;

kSumT (k : Kind) : (c : Bool) -> Id Kind (kSum k (ifW Kind c k1 kW)) (ifW Kind c k1 kW) = split {
  false -> refl kW ;
  true -> refl k1 } ;

kMB (cp : Bool) : (cq : Bool) -> Id Kind (kM (ifW Kind cp k1 kW) (ifW Kind cq k1 kW)) (ifW Kind (andB cq cp) k1 kW) = split {
  false -> refl kW ;
  true -> refl (ifW Kind cp k1 kW) } ;

kEB : (c : Bool) -> Id Kind (kE (ifW Kind c k0 kW)) (ifW Kind c k1 kW) = split {
  false -> refl kW ;
  true -> refl k1 } ;

nzB : (c : Bool) -> Id Bool (isK0 (ifW Kind c k1 kW)) false = split { false -> refl false ; true -> refl false } ;

goodB : (c : Bool) -> Id Bool (goodK (ifW Kind c k1 kW)) true = split { false -> refl true ; true -> refl true } ;

isK1B : (c : Bool) -> Id Bool (isK1 (ifW Kind c k1 kW)) c = split { false -> refl false ; true -> refl true } ;

andFK : (c : Bool) -> Id Kind kW (ifW Kind (andB c false) k0 kW) = split { false -> refl kW ; true -> refl kW } ;

andTK : (c : Bool) -> Id Kind (ifW Kind c k0 kW) (ifW Kind (andB c true) k0 kW) = split { false -> refl kW ; true -> refl k0 } ;

baseProd (x y : ord2) (cq : Bool) (hy : Id Kind (baseT y) (ifW Kind cq k0 kW)) (gy : Id Bool (goodK (kindT y)) true)
  : (cp : Bool) -> Id Kind (baseT x) (ifW Kind cp k0 kW) -> Id Kind (baseT (mul2 x y)) (ifW Kind (andB cq cp) k0 kW) = split {
  false -> \ hx -> trans Kind (baseT (mul2 x y)) kW (ifW Kind (andB cq false) k0 kW) (baseT-mulW x hx y gy) (andFK cq) ;
  true -> \ hx -> trans Kind (baseT (mul2 x y)) (baseT y) (ifW Kind (andB cq true) k0 kW) (baseT-mul0 x hx y)
                    (trans Kind (baseT y) (ifW Kind cq k0 kW) (ifW Kind (andB cq true) k0 kW) hy (andTK cq)) } ;

TreeK (p : Pol) : U a =
  Id Kind (baseT (tree2 p)) (ifW Kind (isConst p) k0 kW) * Id Kind (kindT (tree2 p)) (ifW Kind (topK p) k1 kW) ;

treeK : (p : Pol) -> TreeK p = split {
  pId -> (refl kW, refl kW) ;
  pOne -> (refl k0, refl k1) ;
  pSum p q | rp rq ->
    (trans Kind (baseT (add2 (tree2 p) (tree2 q))) (kSum (baseT (tree2 p)) (baseT (tree2 q)))
                (ifW Kind (andB (isConst p) (isConst q)) k0 kW)
       (baseT-add (tree2 p) (tree2 q))
       (trans Kind (kSum (baseT (tree2 p)) (baseT (tree2 q))) (kSum (ifW Kind (isConst p) k0 kW) (ifW Kind (isConst q) k0 kW))
                   (ifW Kind (andB (isConst p) (isConst q)) k0 kW)
          (ap2 Kind Kind Kind kSum (baseT (tree2 p)) (ifW Kind (isConst p) k0 kW) (baseT (tree2 q)) (ifW Kind (isConst q) k0 kW)
             rp.1 rq.1)
          (kSumB (isConst p) (isConst q))),
     trans Kind (kindT (add2 (tree2 p) (tree2 q))) (kSum (kindT (tree2 p)) (kindT (tree2 q))) (ifW Kind (topK q) k1 kW)
       (kindT-add (tree2 p) (tree2 q))
       (trans Kind (kSum (kindT (tree2 p)) (kindT (tree2 q))) (kSum (kindT (tree2 p)) (ifW Kind (topK q) k1 kW))
                   (ifW Kind (topK q) k1 kW)
          (ap Kind Kind (kSum (kindT (tree2 p))) (kindT (tree2 q)) (ifW Kind (topK q) k1 kW) rq.2)
          (kSumT (kindT (tree2 p)) (topK q)))) ;
  pProd p q | rp rq ->
    (baseProd (tree2 p) (tree2 q) (isConst q) rq.1
       (trans Bool (goodK (kindT (tree2 q))) (goodK (ifW Kind (topK q) k1 kW)) true
          (ap Kind Bool goodK (kindT (tree2 q)) (ifW Kind (topK q) k1 kW) rq.2) (goodB (topK q)))
       (isConst p) rp.1,
     trans Kind (kindT (mul2 (tree2 p) (tree2 q))) (kM (kindT (tree2 p)) (kindT (tree2 q)))
                (ifW Kind (andB (topK q) (topK p)) k1 kW)
       (kindT-mul (tree2 p)
          (trans Bool (isK0 (kindT (tree2 p))) (isK0 (ifW Kind (topK p) k1 kW)) false
             (ap Kind Bool isK0 (kindT (tree2 p)) (ifW Kind (topK p) k1 kW) rp.2) (nzB (topK p)))
          (tree2 q))
       (trans Kind (kM (kindT (tree2 p)) (kindT (tree2 q))) (kM (ifW Kind (topK p) k1 kW) (ifW Kind (topK q) k1 kW))
                   (ifW Kind (andB (topK q) (topK p)) k1 kW)
          (ap2 Kind Kind Kind kM (kindT (tree2 p)) (ifW Kind (topK p) k1 kW) (kindT (tree2 q)) (ifW Kind (topK q) k1 kW)
             rp.2 rq.2)
          (kMB (topK p) (topK q)))) ;
  pExp p | rp ->
    (trans Kind (baseT (exp2 (tree2 p))) (baseT (tree2 p)) (ifW Kind (isConst p) k0 kW) (baseT-exp (tree2 p)) rp.1,
     trans Kind (kindT (exp2 (tree2 p))) (kE (baseT (tree2 p))) (ifW Kind (isConst p) k1 kW)
       (kindT-exp (tree2 p))
       (trans Kind (kE (baseT (tree2 p))) (kE (ifW Kind (isConst p) k0 kW)) (ifW Kind (isConst p) k1 kW)
          (ap Kind Kind kE (baseT (tree2 p)) (ifW Kind (isConst p) k0 kW) rp.1) (kEB (isConst p)))) } ;

-- a polynomial dilator is of kind 1 or Omega
kindPol (p : Pol) : Id Bool (goodK (kindT (tree2 p))) true =
  trans Bool (goodK (kindT (tree2 p))) (goodK (ifW Kind (topK p) k1 kW)) true
    (ap Kind Bool goodK (kindT (tree2 p)) (ifW Kind (topK p) k1 kW) (treeK p).2) (goodB (topK p)) ;

------------------------------------------------------------------------
-- the semantic side: the top point of D(n)

allB : Wd -> Bool = split {
  nil -> true ;
  o w -> false ;
  i w | r -> r } ;

isNilW : Wd -> Bool = split { nil -> true ; o w -> false ; i w -> false } ;

orB : Bool -> Bool -> Bool = split {
  false -> \ c -> c ;
  true -> \ c -> true } ;

-- the largest point of D(n) is a constant: it is in the image of D(0);
-- every point of D(n) is a constant
topC (Q : PDS) (n : N) : Bool = at (Q.2.1 (zeros n)) (pred (Q.1 n)) ;

allC (Q : PDS) (n : N) : Bool = allB (Q.2.1 (zeros n)) ;

lenZ (Q : PDS) (n : N) : Id N (len (Q.2.1 (zeros n))) (Q.1 n) =
  trans N (len (Q.2.1 (zeros n))) (Q.1 (len (zeros n))) (Q.1 n) (Q.2.2.1 (zeros n)) (ap N N Q.1 (len (zeros n)) n (len-zeros n)) ;

at-zeros : (k y : N) -> Id Bool (at (zeros k) y) false = split {
  zero -> \ y -> refl false ;
  suc k | r -> split { zero -> refl false ; suc y -> r y } } ;

allB-app : (A B : Wd) -> Id Bool (allB (app A B)) (andB (allB A) (allB B)) = split {
  nil -> \ B -> refl (allB B) ;
  o A -> \ B -> refl false ;
  i A | r -> \ B -> r B } ;

pow2S : (k : N) -> (j : N) * Id N (pow2 k) (suc j) = split {
  zero -> (zero, refl one) ;
  suc k | r -> (suc (dblN r.1), ap N N dblN (pow2 k) (suc r.1) r.2) } ;

-- the polynomial dilators are non zero at n + 1
posP (n : N) : (p : Pol) -> (k : N) * Id N ((interp p).1 (suc n)) (suc k) = split {
  pId -> (n, refl (suc n)) ;
  pOne -> (zero, refl one) ;
  pSum p q | rp rq -> (plus ((interp p).1 (suc n)) rq.1,
                       trans N (plus ((interp p).1 (suc n)) ((interp q).1 (suc n))) (plus ((interp p).1 (suc n)) (suc rq.1))
                               (suc (plus ((interp p).1 (suc n)) rq.1))
                         (ap N N (\ k -> plus ((interp p).1 (suc n)) k) ((interp q).1 (suc n)) (suc rq.1) rq.2)
                         (plus-sucR ((interp p).1 (suc n)) rq.1)) ;
  pProd p q | rp rq -> (plus rp.1 (mul rq.1 (suc rp.1)),
                        ap2 N N N mul ((interp q).1 (suc n)) (suc rq.1) ((interp p).1 (suc n)) (suc rp.1) rq.2 rp.2) ;
  pExp p | rp -> pow2S ((interp p).1 (suc n)) } ;

-- sums: the top point is the top point of the second summand
topApp (A B : Wd) (k : N) (hB : Id N (len B) (suc k))
  : Id Bool (at (app A B) (pred (plus (len A) (len B)))) (at B (pred (len B))) =
  trans Bool (at (app A B) (pred (plus (len A) (len B)))) (at (app A B) (pred (plus (len A) (suc k)))) (at B (pred (len B)))
    (ap N Bool (\ m -> at (app A B) (pred (plus (len A) m))) (len B) (suc k) hB)
    (trans Bool (at (app A B) (pred (plus (len A) (suc k)))) (at (app A B) (plus (len A) k)) (at B (pred (len B)))
       (ap N Bool (\ m -> at (app A B) (pred m)) (plus (len A) (suc k)) (suc (plus (len A) k)) (plus-sucR (len A) k))
       (trans Bool (at (app A B) (plus (len A) k)) (at B k) (at B (pred (len B)))
          (at-app-r A B k)
          (ap N Bool (\ m -> at B (pred m)) (suc k) (len B) (sym N (len B) (suc k) hB)))) ;

topSum (F G : PDS) (n k : N) (hG : Id N (G.1 n) (suc k)) : Id Bool (topC (sumPDS F G) n) (topC G n) =
  trans Bool (at (app (F.2.1 (zeros n)) (G.2.1 (zeros n))) (pred (plus (F.1 n) (G.1 n))))
             (at (app (F.2.1 (zeros n)) (G.2.1 (zeros n))) (pred (plus (len (F.2.1 (zeros n))) (len (G.2.1 (zeros n))))))
             (topC G n)
    (ap2 N N Bool (\ m m' -> at (app (F.2.1 (zeros n)) (G.2.1 (zeros n))) (pred (plus m m')))
       (F.1 n) (len (F.2.1 (zeros n))) (G.1 n) (len (G.2.1 (zeros n)))
       (sym N (len (F.2.1 (zeros n))) (F.1 n) (lenZ F n)) (sym N (len (G.2.1 (zeros n))) (G.1 n) (lenZ G n)))
    (trans Bool (at (app (F.2.1 (zeros n)) (G.2.1 (zeros n))) (pred (plus (len (F.2.1 (zeros n))) (len (G.2.1 (zeros n))))))
                (at (G.2.1 (zeros n)) (pred (len (G.2.1 (zeros n))))) (topC G n)
       (topApp (F.2.1 (zeros n)) (G.2.1 (zeros n)) k (trans N (len (G.2.1 (zeros n))) (G.1 n) (suc k) (lenZ G n) hG))
       (ap N Bool (\ m -> at (G.2.1 (zeros n)) (pred m)) (len (G.2.1 (zeros n))) (G.1 n) (lenZ G n))) ;

-- kind 1: in F + 1, the top point is the constant of 1
oneTop (F : PDS) (n : N) : Id Bool (topC (sumPDS F (interp pOne)) n) true = topSum F (interp pOne) n zero (refl one) ;

allSum (F G : PDS) (n : N) : Id Bool (allC (sumPDS F G) n) (andB (allC F n) (allC G n)) =
  allB-app (F.2.1 (zeros n)) (G.2.1 (zeros n)) ;

-- products: the top point of kron E D is (top of E, top of D)
kronTop (D : Wd) (d : N) (hD : Id N (len D) (suc d)) (X : Wd) (hX : Id N (len X) (len D)) (E : Wd) (j : N)
  (hK : Id N (len (kron E D)) (suc j))
  : Id Bool (at (app X (kron E D)) (pred (plus (len D) (mul (len E) (len D))))) (at (kron E D) (pred (mul (len E) (len D)))) =
  trans Bool (at (app X (kron E D)) (pred (plus (len D) (mul (len E) (len D)))))
             (at (app X (kron E D)) (pred (plus (len X) (len (kron E D))))) (at (kron E D) (pred (mul (len E) (len D))))
    (ap2 N N Bool (\ m m' -> at (app X (kron E D)) (pred (plus m m'))) (len D) (len X) (mul (len E) (len D)) (len (kron E D))
       (sym N (len X) (len D) hX) (sym N (len (kron E D)) (mul (len E) (len D)) (len-kron E D)))
    (trans Bool (at (app X (kron E D)) (pred (plus (len X) (len (kron E D))))) (at (kron E D) (pred (len (kron E D))))
                (at (kron E D) (pred (mul (len E) (len D))))
       (topApp X (kron E D) j hK)
       (ap N Bool (\ m -> at (kron E D) (pred m)) (len (kron E D)) (mul (len E) (len D)) (len-kron E D))) ;

lenKS (D : Wd) (d : N) (hD : Id N (len D) (suc d)) (E : Wd) (k : N) (he : Id N (len E) (suc k))
  : Id N (len (kron E D)) (suc (plus d (mul k (len D)))) =
  trans N (len (kron E D)) (mul (len E) (len D)) (suc (plus d (mul k (len D))))
    (len-kron E D)
    (trans N (mul (len E) (len D)) (mul (suc k) (len D)) (suc (plus d (mul k (len D))))
       (ap N N (\ m -> mul m (len D)) (len E) (suc k) he)
       (ap N N (\ m -> plus m (mul k (len D))) (len D) (suc d) hD)) ;

TopK (D : Wd) (d : N) (E : Wd) : U a =
  Id Bool (at (kron E D) (pred (mul (len E) (len D)))) (andB (at E (pred (len E))) (at D d)) ;

kronO (D : Wd) (d : N) (hD : Id N (len D) (suc d))
  : (E : Wd) -> TopK D d E -> TopK D d (o E) = split {
  nil -> \ r -> trans Bool (at (app (zeros (len D)) nil) (pred (plus (len D) zero))) (at (zeros (len D)) (pred (plus (len D) zero))) false
             (ap Wd Bool (\ u -> at u (pred (plus (len D) zero))) (app (zeros (len D)) nil) (zeros (len D)) (app-nil (zeros (len D))))
             (at-zeros (len D) (pred (plus (len D) zero))) ;
  o E -> \ r -> trans Bool (at (app (zeros (len D)) (kron (o E) D)) (pred (plus (len D) (mul (len (o E)) (len D)))))
              (at (kron (o E) D) (pred (mul (len (o E)) (len D)))) (andB (at (o E) (len E)) (at D d))
              (kronTop D d hD (zeros (len D)) (len-zeros (len D)) (o E) (plus d (mul (len E) (len D)))
                 (lenKS D d hD (o E) (len E) (refl (suc (len E)))))
              r ;
  i E -> \ r -> trans Bool (at (app (zeros (len D)) (kron (i E) D)) (pred (plus (len D) (mul (len (i E)) (len D)))))
              (at (kron (i E) D) (pred (mul (len (i E)) (len D)))) (andB (at (i E) (len E)) (at D d))
              (kronTop D d hD (zeros (len D)) (len-zeros (len D)) (i E) (plus d (mul (len E) (len D)))
                 (lenKS D d hD (i E) (len E) (refl (suc (len E)))))
              r } ;

kronI (D : Wd) (d : N) (hD : Id N (len D) (suc d))
  : (E : Wd) -> TopK D d E -> TopK D d (i E) = split {
  nil -> \ r -> trans Bool (at (app D nil) (pred (plus (len D) zero))) (at D (pred (len D))) (at D d)
             (ap2 Wd N Bool (\ u m -> at u (pred m)) (app D nil) D (plus (len D) zero) (len D) (app-nil D) (plus-zero (len D)))
             (ap N Bool (\ m -> at D (pred m)) (len D) (suc d) hD) ;
  o E -> \ r -> trans Bool (at (app D (kron (o E) D)) (pred (plus (len D) (mul (len (o E)) (len D)))))
              (at (kron (o E) D) (pred (mul (len (o E)) (len D)))) (andB (at (o E) (len E)) (at D d))
              (kronTop D d hD D (refl (len D)) (o E) (plus d (mul (len E) (len D)))
                 (lenKS D d hD (o E) (len E) (refl (suc (len E)))))
              r ;
  i E -> \ r -> trans Bool (at (app D (kron (i E) D)) (pred (plus (len D) (mul (len (i E)) (len D)))))
              (at (kron (i E) D) (pred (mul (len (i E)) (len D)))) (andB (at (i E) (len E)) (at D d))
              (kronTop D d hD D (refl (len D)) (i E) (plus d (mul (len E) (len D)))
                 (lenKS D d hD (i E) (len E) (refl (suc (len E)))))
              r } ;

at-top-kron (D : Wd) (d : N) (hD : Id N (len D) (suc d)) : (E : Wd) -> TopK D d E = split {
  nil -> refl false ;
  o E | r -> kronO D d hD E r ;
  i E | r -> kronI D d hD E r } ;

topProd (P Q : PDS) (n d : N) (hP : Id N (P.1 n) (suc d)) : Id Bool (topC (prodPDS P Q) n) (andB (topC Q n) (topC P n)) =
  trans Bool (at (kron (Q.2.1 (zeros n)) (P.2.1 (zeros n))) (pred (mul (Q.1 n) (P.1 n))))
             (at (kron (Q.2.1 (zeros n)) (P.2.1 (zeros n))) (pred (mul (len (Q.2.1 (zeros n))) (len (P.2.1 (zeros n))))))
             (andB (topC Q n) (topC P n))
    (ap2 N N Bool (\ m m' -> at (kron (Q.2.1 (zeros n)) (P.2.1 (zeros n))) (pred (mul m m')))
       (Q.1 n) (len (Q.2.1 (zeros n))) (P.1 n) (len (P.2.1 (zeros n)))
       (sym N (len (Q.2.1 (zeros n))) (Q.1 n) (lenZ Q n)) (sym N (len (P.2.1 (zeros n))) (P.1 n) (lenZ P n)))
    (trans Bool (at (kron (Q.2.1 (zeros n)) (P.2.1 (zeros n))) (pred (mul (len (Q.2.1 (zeros n))) (len (P.2.1 (zeros n))))))
                (andB (at (Q.2.1 (zeros n)) (pred (len (Q.2.1 (zeros n))))) (at (P.2.1 (zeros n)) d))
                (andB (topC Q n) (topC P n))
       (at-top-kron (P.2.1 (zeros n)) d (trans N (len (P.2.1 (zeros n))) (P.1 n) (suc d) (lenZ P n) hP) (Q.2.1 (zeros n)))
       (ap2 N N Bool (\ m m' -> andB (at (Q.2.1 (zeros n)) (pred m)) (at (P.2.1 (zeros n)) m'))
          (len (Q.2.1 (zeros n))) (Q.1 n) d (pred (P.1 n))
          (lenZ Q n) (ap N N pred (suc d) (P.1 n) (sym N (P.1 n) (suc d) hP)))) ;

boolK : (c e n0 : Bool) -> Id Bool (andB c (andB e (orB n0 c))) (andB e c) = split {
  false -> split {
    false -> \ n0 -> refl false ;
    true -> split { false -> refl false ; true -> refl false } } ;
  true -> split {
    false -> \ n0 -> refl false ;
    true -> split { false -> refl true ; true -> refl true } } } ;

allB-kron (D : Wd) (d : N) (hD : Id N (len D) (suc d))
  : (E : Wd) -> Id Bool (allB (kron E D)) (andB (allB E) (orB (isNilW E) (allB D))) = split {
  nil -> refl true ;
  o E | r -> trans Bool (allB (app (zeros (len D)) (kron E D))) (andB (allB (zeros (len D))) (allB (kron E D))) false
               (allB-app (zeros (len D)) (kron E D))
               (ap N Bool (\ m -> andB (allB (zeros m)) (allB (kron E D))) (len D) (suc d) hD) ;
  i E | r -> trans Bool (allB (app D (kron E D))) (andB (allB D) (andB (allB E) (orB (isNilW E) (allB D))))
               (andB (allB E) (allB D))
               (trans Bool (allB (app D (kron E D))) (andB (allB D) (allB (kron E D)))
                           (andB (allB D) (andB (allB E) (orB (isNilW E) (allB D))))
                  (allB-app D (kron E D))
                  (ap Bool Bool (\ c -> andB (allB D) c) (allB (kron E D)) (andB (allB E) (orB (isNilW E) (allB D))) r))
               (boolK (allB D) (allB E) (isNilW E)) } ;

nilLen : (E : Wd) (k : N) -> Id N (len E) (suc k) -> Id Bool (isNilW E) false = split {
  nil -> \ k h -> absurdN (Id Bool true false) k h ;
  o E -> \ k h -> refl false ;
  i E -> \ k h -> refl false } ;

andB-false : (c : Bool) -> Id Bool (andB c false) false = split { false -> refl false ; true -> refl false } ;

allProd (P Q : PDS) (n d k : N) (hP : Id N (P.1 n) (suc d)) (hQ : Id N (Q.1 n) (suc k))
  : Id Bool (allC (prodPDS P Q) n) (andB (allC Q n) (allC P n)) =
  trans Bool (allB (kron (Q.2.1 (zeros n)) (P.2.1 (zeros n))))
             (andB (allB (Q.2.1 (zeros n))) (orB (isNilW (Q.2.1 (zeros n))) (allB (P.2.1 (zeros n)))))
             (andB (allC Q n) (allC P n))
    (allB-kron (P.2.1 (zeros n)) d (trans N (len (P.2.1 (zeros n))) (P.1 n) (suc d) (lenZ P n) hP) (Q.2.1 (zeros n)))
    (ap Bool Bool (\ c -> andB (allB (Q.2.1 (zeros n))) (orB c (allB (P.2.1 (zeros n)))))
       (isNilW (Q.2.1 (zeros n))) false
       (nilLen (Q.2.1 (zeros n)) k (trans N (len (Q.2.1 (zeros n))) (Q.1 n) (suc k) (lenZ Q n) hQ))) ;

-- 2^: the top point is the full subset, a constant iff D(n) is constant
at-lo-odd : (A : Wd) (j : N) -> Id Bool (at (lo A) (suc (dblN j))) false = split {
  nil -> \ j -> refl false ;
  o A | r -> split { zero -> refl false ; suc j -> r j } ;
  i A | r -> split { zero -> refl false ; suc j -> r j } } ;

at-dbl-odd : (A : Wd) (j : N) -> Id Bool (at (dbl A) (suc (dblN j))) (at A j) = split {
  nil -> \ j -> refl false ;
  o A | r -> split { zero -> refl false ; suc j -> r j } ;
  i A | r -> split { zero -> refl true ; suc j -> r j } } ;

at-top-ex : (W : Wd) -> Id Bool (at (exW W) (pred (pow2 (len W)))) (allB W) = split {
  nil -> refl true ;
  o W | r -> trans Bool (at (lo (exW W)) (pred (dblN (pow2 (len W))))) (at (lo (exW W)) (pred (dblN (suc (pow2S (len W)).1)))) false
               (ap N Bool (\ m -> at (lo (exW W)) (pred (dblN m))) (pow2 (len W)) (suc (pow2S (len W)).1) (pow2S (len W)).2)
               (at-lo-odd (exW W) (pow2S (len W)).1) ;
  i W | r -> trans Bool (at (dbl (exW W)) (pred (dblN (pow2 (len W))))) (at (dbl (exW W)) (pred (dblN (suc (pow2S (len W)).1))))
               (allB W)
               (ap N Bool (\ m -> at (dbl (exW W)) (pred (dblN m))) (pow2 (len W)) (suc (pow2S (len W)).1) (pow2S (len W)).2)
               (trans Bool (at (dbl (exW W)) (suc (dblN (pow2S (len W)).1))) (at (exW W) (pow2S (len W)).1) (allB W)
                  (at-dbl-odd (exW W) (pow2S (len W)).1)
                  (trans Bool (at (exW W) (pow2S (len W)).1) (at (exW W) (pred (pow2 (len W)))) (allB W)
                     (ap N Bool (\ m -> at (exW W) (pred m)) (suc (pow2S (len W)).1) (pow2 (len W))
                        (sym N (pow2 (len W)) (suc (pow2S (len W)).1) (pow2S (len W)).2))
                     r)) } ;

exW-shape : (W : Wd) -> (X : Wd) * Id Wd (exW W) (i X) = split {
  nil -> (nil, refl (i nil)) ;
  o W | r -> (o (lo r.1), ap Wd Wd lo (exW W) (i r.1) r.2) ;
  i W | r -> (i (dbl r.1), ap Wd Wd dbl (exW W) (i r.1) r.2) } ;

allB-dbl : (A : Wd) -> Id Bool (allB (dbl A)) (allB A) = split {
  nil -> refl true ;
  o A -> refl false ;
  i A | r -> r } ;

allB-ex : (W : Wd) -> Id Bool (allB (exW W)) (allB W) = split {
  nil -> refl true ;
  o W -> ap Wd Bool (\ u -> allB (lo u)) (exW W) (i (exW-shape W).1) (exW-shape W).2 ;
  i W | r -> trans Bool (allB (dbl (exW W))) (allB (exW W)) (allB W) (allB-dbl (exW W)) r } ;

topExp (P : PDS) (n : N) : Id Bool (topC (expPDS P) n) (allC P n) =
  trans Bool (at (exW (P.2.1 (zeros n))) (pred (pow2 (P.1 n)))) (at (exW (P.2.1 (zeros n))) (pred (pow2 (len (P.2.1 (zeros n))))))
             (allC P n)
    (ap N Bool (\ m -> at (exW (P.2.1 (zeros n))) (pred (pow2 m))) (P.1 n) (len (P.2.1 (zeros n)))
       (sym N (len (P.2.1 (zeros n))) (P.1 n) (lenZ P n)))
    (at-top-ex (P.2.1 (zeros n))) ;

-- the top point of D(n + 1) is a constant iff topK p, and all points of
-- D(n + 1) are constants iff isConst p
semK (n : N) : (p : Pol)
  -> Id Bool (topC (interp p) (suc n)) (topK p) * Id Bool (allC (interp p) (suc n)) (isConst p) = split {
  pId -> (at-zeros (suc n) n, refl false) ;
  pOne -> (refl true, refl true) ;
  pSum p q | rp rq ->
    (trans Bool (topC (interp (pSum p q)) (suc n)) (topC (interp q) (suc n)) (topK q)
       (topSum (interp p) (interp q) (suc n) (posP n q).1 (posP n q).2) rq.1,
     trans Bool (allC (interp (pSum p q)) (suc n)) (andB (allC (interp p) (suc n)) (allC (interp q) (suc n)))
                (andB (isConst p) (isConst q))
       (allSum (interp p) (interp q) (suc n))
       (ap2 Bool Bool Bool andB (allC (interp p) (suc n)) (isConst p) (allC (interp q) (suc n)) (isConst q) rp.2 rq.2)) ;
  pProd p q | rp rq ->
    (trans Bool (topC (interp (pProd p q)) (suc n)) (andB (topC (interp q) (suc n)) (topC (interp p) (suc n)))
                (andB (topK q) (topK p))
       (topProd (interp p) (interp q) (suc n) (posP n p).1 (posP n p).2)
       (ap2 Bool Bool Bool andB (topC (interp q) (suc n)) (topK q) (topC (interp p) (suc n)) (topK p) rq.1 rp.1),
     trans Bool (allC (interp (pProd p q)) (suc n)) (andB (allC (interp q) (suc n)) (allC (interp p) (suc n)))
                (andB (isConst q) (isConst p))
       (allProd (interp p) (interp q) (suc n) (posP n p).1 (posP n q).1 (posP n p).2 (posP n q).2)
       (ap2 Bool Bool Bool andB (allC (interp q) (suc n)) (isConst q) (allC (interp p) (suc n)) (isConst p) rq.2 rp.2)) ;
  pExp p | rp ->
    (trans Bool (topC (interp (pExp p)) (suc n)) (allC (interp p) (suc n)) (isConst p) (topExp (interp p) (suc n)) rp.2,
     trans Bool (allC (interp (pExp p)) (suc n)) (allC (interp p) (suc n)) (isConst p) (allB-ex ((interp p).2.1 (zeros (suc n)))) rp.2) } ;

-- 9.1.11 for the polynomial dilators: tree2 p has kind 1 iff the top point
-- of D(n + 1) is a constant, for any n; otherwise it has kind Omega
kind1 (p : Pol) (n : N) : Id Bool (isK1 (kindT (tree2 p))) (topC (interp p) (suc n)) =
  trans Bool (isK1 (kindT (tree2 p))) (topK p) (topC (interp p) (suc n))
    (trans Bool (isK1 (kindT (tree2 p))) (isK1 (ifW Kind (topK p) k1 kW)) (topK p)
       (ap Kind Bool isK1 (kindT (tree2 p)) (ifW Kind (topK p) k1 kW) (treeK p).2) (isK1B (topK p)))
    (sym Bool (topC (interp p) (suc n)) (topK p) (semK n p).1) ;

-- examples: Id + 1 is of kind 1, Id, (Id + 1) . Id and 2^(Id + 1) of kind
-- Omega, 2^1 = 1 + 1 of kind 1
#conv kindT (tree2 (pSum pId pOne)) = k1 ;
#conv kindT (tree2 pId) = kW ;
#conv kindT (tree2 exPol) = kW ;
#conv kindT (tree2 (pExp (pSum pId pOne))) = kW ;
#conv kindT (tree2 (pExp pOne)) = k1 ;
#conv topC (interp (pExp (pSum pId pOne))) two = false ;
#conv topC (interp (pExp pOne)) two = true ;

------------------------------------------------------------------------
-- (f, continued) the restriction of D to a decidable set c of trace
-- points (Girard 8.3.6): F(n) is the set of points of D(n) whose trace is
-- in c, F(w) the restriction of D(w).  It is a pre-dilator, and the
-- inclusion is a natural transformation F -> D whose trace lands in c.
-- When the points of c are separated from (below) the others, D is the
-- sum of the restrictions to c and to its complement: this splitting
-- along a cut is the step of 9.1.6 that builds the components.

notB : Bool -> Bool = split { false -> true ; true -> false } ;

-- words with the same length and the same letters are equal
at-ext (A B : Wd) (hl : Id N (len A) (len B)) (h : (y : N) -> Id Bool (at A y) (at B y)) : Id Wd A B =
  wext A B hl
    (\ y hy -> trans Bool (at B y) (at A y) true (sym Bool (at A y) (at B y) (h y)) hy)
    (\ y hy -> trans Bool (at A y) (at B y) true (h y) hy) ;

ones-comp : (v w : Wd) -> Id N (ones v) (len w) -> Id N (ones (compW v w)) (ones w) = split {
  nil -> \ w h -> subst Wd (\ u -> Id N zero (ones u)) nil w (sym Wd w nil (len-zero w (sym N zero (len w) h))) (refl zero) ;
  o v | r -> \ w h -> r w h ;
  i v | r -> split {
    nil -> \ h -> absurdN (Id N (ones (compW (i v) nil)) zero) (ones v) (sym N (suc (ones v)) zero h) ;
    o w -> \ h -> r w (sucInj (ones v) (len w) h) ;
    i w -> \ h -> sucEq (ones (compW v w)) (ones w) (r w (sucInj (ones v) (len w) h)) } } ;

comp-assoc : (A B C : Wd) -> Id N (ones A) (len B) -> Id N (ones B) (len C)
  -> Id Wd (compW (compW A B) C) (compW A (compW B C)) = split {
  nil -> \ B C h1 h2 -> refl nil ;
  o A | r -> \ B C h1 h2 -> ap Wd Wd (\ u -> o u) (compW (compW A B) C) (compW A (compW B C)) (r B C h1 h2) ;
  i A | r -> split {
    nil -> \ C h1 h2 -> absurdN (Id Wd (compW (compW (i A) nil) C) (compW (i A) (compW nil C))) (ones A)
                         (sym N (suc (ones A)) zero h1) ;
    o B -> \ C h1 h2 -> ap Wd Wd (\ u -> o u) (compW (compW A B) C) (compW A (compW B C)) (r B C (sucInj (ones A) (len B) h1) h2) ;
    i B -> split {
      nil -> \ h1 h2 -> absurdN (Id Wd (compW (compW (i A) (i B)) nil) (compW (i A) (compW (i B) nil))) (ones B)
                          (sym N (suc (ones B)) zero h2) ;
      o C -> \ h1 h2 -> ap Wd Wd (\ u -> o u) (compW (compW A B) C) (compW A (compW B C))
                          (r B C (sucInj (ones A) (len B) h1) (sucInj (ones B) (len C) h2)) ;
      i C -> \ h1 h2 -> ap Wd Wd (\ u -> i u) (compW (compW A B) C) (compW A (compW B C))
                          (r B C (sucInj (ones A) (len B) h1) (sucInj (ones B) (len C) h2)) } } } ;

-- a strictly increasing map is a monomorphism
comp-cancel : (A X Y : Wd) -> Id N (len X) (ones A) -> Id N (len Y) (ones A) -> Id Wd (compW A X) (compW A Y) -> Id Wd X Y = split {
  nil -> \ X Y hx hy e -> trans Wd X nil Y (len-zero X hx) (sym Wd Y nil (len-zero Y hy)) ;
  o A | r -> \ X Y hx hy e -> r X Y hx hy (ap Wd Wd tl (compW (o A) X) (compW (o A) Y) e) ;
  i A | r -> split {
    nil -> \ Y hx hy e -> absurdN (Id Wd nil Y) (ones A) hx ;
    o X -> split {
      nil -> \ hx hy e -> absurdN (Id Wd (o X) nil) (ones A) hy ;
      o Y -> \ hx hy e -> ap Wd Wd (\ u -> o u) X Y
                            (r X Y (sucInj (len X) (ones A) hx) (sucInj (len Y) (ones A) hy)
                               (ap Wd Wd tl (compW (i A) (o X)) (compW (i A) (o Y)) e)) ;
      i Y -> \ hx hy e -> absurdB (Id Wd (o X) (i Y)) (ap Wd Bool hd (compW (i A) (o X)) (compW (i A) (i Y)) e) } ;
    i X -> split {
      nil -> \ hx hy e -> absurdN (Id Wd (i X) nil) (ones A) hy ;
      o Y -> \ hx hy e -> absurdB (Id Wd (i X) (o Y))
                            (ap Wd Bool hd (compW (i A) (o Y)) (compW (i A) (i X))
                               (sym Wd (compW (i A) (i X)) (compW (i A) (o Y)) e)) ;
      i Y -> \ hx hy e -> ap Wd Wd (\ u -> i u) X Y
                            (r X Y (sucInj (len X) (ones A) hx) (sucInj (len Y) (ones A) hy)
                               (ap Wd Wd tl (compW (i A) (i X)) (compW (i A) (i Y)) e)) } } } ;

boolCA : (p q s : Bool) -> Id Bool (andB p (andB q s)) (andB (andB p q) (andB p s)) = split {
  false -> \ q s -> refl false ;
  true -> \ q s -> refl (andB q s) } ;

boolDA : (p q s : Bool) -> Id Bool (andB (andB p q) s) (andB (andB p s) (andB q s)) = split {
  false -> \ q s -> refl false ;
  true -> split {
    false -> split { false -> refl false ; true -> refl false } ;
    true -> split { false -> refl false ; true -> refl true } } } ;

-- composition distributes over intersection
comp-and (A X Y : Wd) : Id Wd (compW A (andW X Y)) (andW (compW A X) (compW A Y)) =
  at-ext (compW A (andW X Y)) (andW (compW A X) (compW A Y))
    (trans N (len (compW A (andW X Y))) (len A) (len (andW (compW A X) (compW A Y)))
       (len-comp A (andW X Y))
       (sym N (len (andW (compW A X) (compW A Y))) (len A)
          (trans N (len (andW (compW A X) (compW A Y))) (len (compW A X)) (len A)
             (len-and (compW A X) (compW A Y)) (len-comp A X))))
    (\ y -> trans Bool (at (compW A (andW X Y)) y) (andB (at A y) (andB (at X (rank A y)) (at Y (rank A y))))
                       (at (andW (compW A X) (compW A Y)) y)
              (trans Bool (at (compW A (andW X Y)) y) (andB (at A y) (at (andW X Y) (rank A y)))
                          (andB (at A y) (andB (at X (rank A y)) (at Y (rank A y))))
                 (at-comp A y (andW X Y))
                 (ap Bool Bool (\ c -> andB (at A y) c) (at (andW X Y) (rank A y)) (andB (at X (rank A y)) (at Y (rank A y)))
                    (at-and X (rank A y) Y)))
              (trans Bool (andB (at A y) (andB (at X (rank A y)) (at Y (rank A y))))
                          (andB (andB (at A y) (at X (rank A y))) (andB (at A y) (at Y (rank A y))))
                          (at (andW (compW A X) (compW A Y)) y)
                 (boolCA (at A y) (at X (rank A y)) (at Y (rank A y)))
                 (sym Bool (at (andW (compW A X) (compW A Y)) y)
                           (andB (andB (at A y) (at X (rank A y))) (andB (at A y) (at Y (rank A y))))
                    (trans Bool (at (andW (compW A X) (compW A Y)) y) (andB (at (compW A X) y) (at (compW A Y) y))
                                (andB (andB (at A y) (at X (rank A y))) (andB (at A y) (at Y (rank A y))))
                       (at-and (compW A X) y (compW A Y))
                       (ap2 Bool Bool Bool andB (at (compW A X) y) (andB (at A y) (at X (rank A y)))
                          (at (compW A Y) y) (andB (at A y) (at Y (rank A y)))
                          (at-comp A y X) (at-comp A y Y)))))) ;

and-dist (A B C : Wd) : Id Wd (andW (andW A B) C) (andW (andW A C) (andW B C)) =
  at-ext (andW (andW A B) C) (andW (andW A C) (andW B C))
    (trans N (len (andW (andW A B) C)) (len A) (len (andW (andW A C) (andW B C)))
       (trans N (len (andW (andW A B) C)) (len (andW A B)) (len A) (len-and (andW A B) C) (len-and A B))
       (sym N (len (andW (andW A C) (andW B C))) (len A)
          (trans N (len (andW (andW A C) (andW B C))) (len (andW A C)) (len A) (len-and (andW A C) (andW B C)) (len-and A C))))
    (\ y -> trans Bool (at (andW (andW A B) C) y) (andB (andB (at A y) (at B y)) (at C y)) (at (andW (andW A C) (andW B C)) y)
              (trans Bool (at (andW (andW A B) C) y) (andB (at (andW A B) y) (at C y)) (andB (andB (at A y) (at B y)) (at C y))
                 (at-and (andW A B) y C)
                 (ap Bool Bool (\ c -> andB c (at C y)) (at (andW A B) y) (andB (at A y) (at B y)) (at-and A y B)))
              (trans Bool (andB (andB (at A y) (at B y)) (at C y)) (andB (andB (at A y) (at C y)) (andB (at B y) (at C y)))
                          (at (andW (andW A C) (andW B C)) y)
                 (boolDA (at A y) (at B y) (at C y))
                 (sym Bool (at (andW (andW A C) (andW B C)) y) (andB (andB (at A y) (at C y)) (andB (at B y) (at C y)))
                    (trans Bool (at (andW (andW A C) (andW B C)) y) (andB (at (andW A C) y) (at (andW B C) y))
                                (andB (andB (at A y) (at C y)) (andB (at B y) (at C y)))
                       (at-and (andW A C) y (andW B C))
                       (ap2 Bool Bool Bool andB (at (andW A C) y) (andB (at A y) (at C y)) (at (andW B C) y) (andB (at B y) (at C y))
                          (at-and A y C) (at-and B y C)))))) ;

restrict-self : (X : Wd) -> Id Wd (restrict X X) (idW (ones X)) = split {
  nil -> refl nil ;
  o X | r -> r ;
  i X | r -> ap Wd Wd (\ u -> i u) (restrict X X) (idW (ones X)) r } ;

-- the word of length k with the letters f 0, .., f (k - 1)
tab : N -> (N -> Bool) -> Wd = split {
  zero -> \ f -> nil ;
  suc k | r -> \ f -> cons (f zero) (r (\ j -> f (suc j))) } ;

len-tab : (k : N) (f : N -> Bool) -> Id N (len (tab k f)) k = split {
  zero -> \ f -> refl zero ;
  suc k | r -> \ f -> trans N (len (cons (f zero) (tab k (\ j -> f (suc j))))) (suc (len (tab k (\ j -> f (suc j))))) (suc k)
                        (len-cons (f zero) (tab k (\ j -> f (suc j))))
                        (sucEq (len (tab k (\ j -> f (suc j)))) k (r (\ j -> f (suc j)))) } ;

at-tab : (k : N) (f : N -> Bool) (j : N) -> Id Bool (ltN j k) true -> Id Bool (at (tab k f) j) (f j) = split {
  zero -> \ f j h -> ltN-zero-abs (Id Bool false (f j)) j h ;
  suc k | r -> \ f -> split {
    zero -> \ h -> at-cons0 (f zero) (tab k (\ j -> f (suc j))) ;
    suc j -> \ h -> trans Bool (at (cons (f zero) (tab k (\ j1 -> f (suc j1)))) (suc j)) (at (tab k (\ j1 -> f (suc j1))) j) (f (suc j))
                      (at-consS (f zero) (tab k (\ j1 -> f (suc j1))) j)
                      (r (\ j1 -> f (suc j1)) j h) } } ;

module Restr
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (c : N -> N -> Bool) {

  module PD = PreDil[D0, D1, dlen, dones, did, dcomp, dmeet] ;

  TPr (k z : N) : U a = Id Bool (ltN z (D0 k)) true * Id Wd PD.Sup[k, z].supp (idW k) ;

  -- is the trace (ones s, z) of the point x of D(n) in c
  trc (n x : N) : Bool = c (ones PD.Sup[n, x].supp) (rank (D1 PD.Sup[n, x].supp) x) ;

  -- F(n) inside D(n)
  chi (n : N) : Wd = tab (D0 n) (trc n) ;

  len-chi (n : N) : Id N (len (chi n)) (D0 n) = len-tab (D0 n) (trc n) ;

  -- D(w) preserves the traces: if x = D(s)(z), then D(w)(x) = D(w . s)(z)
  module Inv (w : Wd) (x : N) (hx : Id Bool (ltN x (D0 (ones w))) true) {

    dx : PD.Den (ones w) = PD.fwd (ones w) (x, PD.hzOf (ones w) x hx) ;

    hls : Id N (ones w) (len dx.1) = sym N (len dx.1) (ones w) dx.2.2.1 ;

    hos : Id N (ones (compW w dx.1)) (ones dx.1) = ones-comp w dx.1 hls ;

    e : PD.Den (len w) =
      (compW w dx.1, dx.2.1, len-comp w dx.1,
       subst N (\ k -> TPr k dx.2.1) (ones dx.1) (ones (compW w dx.1)) (sym N (ones (compW w dx.1)) (ones dx.1) hos) dx.2.2.2) ;

    ye : Id N (sel (D1 w) x) (sel (D1 (compW w dx.1)) dx.2.1) =
      trans N (sel (D1 w) x) (sel (D1 w) (sel (D1 dx.1) dx.2.1)) (sel (D1 (compW w dx.1)) dx.2.1)
        (ap N N (\ k -> sel (D1 w) k) x (sel (D1 dx.1) dx.2.1)
           (sym N (sel (D1 dx.1) dx.2.1) x (PD.bwd-fwd (ones w) (x, PD.hzOf (ones w) x hx))))
        (trans N (sel (D1 w) (sel (D1 dx.1) dx.2.1)) (sel (compW (D1 w) (D1 dx.1)) dx.2.1) (sel (D1 (compW w dx.1)) dx.2.1)
           (sym N (sel (compW (D1 w) (D1 dx.1)) dx.2.1) (sel (D1 w) (sel (D1 dx.1) dx.2.1))
              (sel-comp (D1 w) (D1 dx.1) dx.2.1
                 (trans N (ones (D1 w)) (D0 (ones w)) (len (D1 dx.1)) (dones w)
                    (trans N (D0 (ones w)) (D0 (len dx.1)) (len (D1 dx.1)) (ap N N D0 (ones w) (len dx.1) hls)
                       (sym N (len (D1 dx.1)) (D0 (len dx.1)) (dlen dx.1))))))
           (ap Wd N (\ u -> sel u dx.2.1) (compW (D1 w) (D1 dx.1)) (D1 (compW w dx.1))
              (sym Wd (D1 (compW w dx.1)) (compW (D1 w) (D1 dx.1)) (dcomp w dx.1 hls)))) ;

    inv : Id Bool (trc (len w) (sel (D1 w) x)) (trc (ones w) x) =
      trans Bool (trc (len w) (sel (D1 w) x)) (trc (len w) (sel (D1 (compW w dx.1)) dx.2.1)) (trc (ones w) x)
        (ap N Bool (trc (len w)) (sel (D1 w) x) (sel (D1 (compW w dx.1)) dx.2.1) ye)
        (trans Bool (trc (len w) (sel (D1 (compW w dx.1)) dx.2.1)) (c (ones (compW w dx.1)) dx.2.1) (trc (ones w) x)
           (ap2 Wd N Bool (\ u k -> c (ones u) k)
              (PD.fwd (len w) (PD.bwd (len w) e)).1 (compW w dx.1)
              (PD.fwd (len w) (PD.bwd (len w) e)).2.1 dx.2.1
              (PD.fwd-bwd-w (len w) e) (PD.fwd-bwd-z (len w) e))
           (ap N Bool (\ k -> c k dx.2.1) (ones (compW w dx.1)) (ones dx.1) hos)) ;
  } ;

  -- F is a pull-back of D: the image of F(m) under D(w) is the
  -- intersection of the image of D(w) with F(n)
  hrk (w : Wd) (y : N) (h : Id Bool (at (D1 w) y) true) : Id Bool (ltN (rank (D1 w) y) (D0 (ones w))) true =
    subst N (\ k -> Id Bool (ltN (rank (D1 w) y) k) true) (ones (D1 w)) (D0 (ones w)) (dones w) (rank-lt (D1 w) y h) ;

  hly (w : Wd) (y : N) (h : Id Bool (at (D1 w) y) true) : Id Bool (ltN y (D0 (len w))) true =
    subst N (\ k -> Id Bool (ltN y k) true) (len (D1 w)) (D0 (len w)) (dlen w) (at-lt (D1 w) y h) ;

  pbAt (w : Wd) (y : N) : (b : Bool) -> Id Bool (at (D1 w) y) b
    -> Id Bool (at (compW (D1 w) (chi (ones w))) y) (at (andW (D1 w) (chi (len w))) y) = split {
    false -> \ h ->
      trans Bool (at (compW (D1 w) (chi (ones w))) y) false (at (andW (D1 w) (chi (len w))) y)
        (trans Bool (at (compW (D1 w) (chi (ones w))) y) (andB (at (D1 w) y) (at (chi (ones w)) (rank (D1 w) y))) false
           (at-comp (D1 w) y (chi (ones w)))
           (ap Bool Bool (\ b1 -> andB b1 (at (chi (ones w)) (rank (D1 w) y))) (at (D1 w) y) false h))
        (sym Bool (at (andW (D1 w) (chi (len w))) y) false
           (trans Bool (at (andW (D1 w) (chi (len w))) y) (andB (at (D1 w) y) (at (chi (len w)) y)) false
              (at-and (D1 w) y (chi (len w)))
              (ap Bool Bool (\ b1 -> andB b1 (at (chi (len w)) y)) (at (D1 w) y) false h))) ;
    true -> \ h ->
      trans Bool (at (compW (D1 w) (chi (ones w))) y) (at (chi (ones w)) (rank (D1 w) y)) (at (andW (D1 w) (chi (len w))) y)
        (trans Bool (at (compW (D1 w) (chi (ones w))) y) (andB (at (D1 w) y) (at (chi (ones w)) (rank (D1 w) y)))
                    (at (chi (ones w)) (rank (D1 w) y))
           (at-comp (D1 w) y (chi (ones w)))
           (ap Bool Bool (\ b1 -> andB b1 (at (chi (ones w)) (rank (D1 w) y))) (at (D1 w) y) true h))
        (trans Bool (at (chi (ones w)) (rank (D1 w) y)) (trc (ones w) (rank (D1 w) y)) (at (andW (D1 w) (chi (len w))) y)
           (at-tab (D0 (ones w)) (trc (ones w)) (rank (D1 w) y) (hrk w y h))
           (trans Bool (trc (ones w) (rank (D1 w) y)) (trc (len w) y) (at (andW (D1 w) (chi (len w))) y)
              (trans Bool (trc (ones w) (rank (D1 w) y)) (trc (len w) (sel (D1 w) (rank (D1 w) y))) (trc (len w) y)
                 (sym Bool (trc (len w) (sel (D1 w) (rank (D1 w) y))) (trc (ones w) (rank (D1 w) y))
                    Inv[w, rank (D1 w) y, hrk w y h].inv)
                 (ap N Bool (trc (len w)) (sel (D1 w) (rank (D1 w) y)) y (sel-rank (D1 w) y h)))
              (trans Bool (trc (len w) y) (at (chi (len w)) y) (at (andW (D1 w) (chi (len w))) y)
                 (sym Bool (at (chi (len w)) y) (trc (len w) y) (at-tab (D0 (len w)) (trc (len w)) y (hly w y h)))
                 (sym Bool (at (andW (D1 w) (chi (len w))) y) (at (chi (len w)) y)
                    (trans Bool (at (andW (D1 w) (chi (len w))) y) (andB (at (D1 w) y) (at (chi (len w)) y)) (at (chi (len w)) y)
                       (at-and (D1 w) y (chi (len w)))
                       (ap Bool Bool (\ b1 -> andB b1 (at (chi (len w)) y)) (at (D1 w) y) true h)))))) } ;

  pb (w : Wd) : Id Wd (compW (D1 w) (chi (ones w))) (andW (D1 w) (chi (len w))) =
    at-ext (compW (D1 w) (chi (ones w))) (andW (D1 w) (chi (len w)))
      (trans N (len (compW (D1 w) (chi (ones w)))) (len (D1 w)) (len (andW (D1 w) (chi (len w))))
         (len-comp (D1 w) (chi (ones w)))
         (sym N (len (andW (D1 w) (chi (len w)))) (len (D1 w)) (len-and (D1 w) (chi (len w)))))
      (\ y -> pbAt w y (at (D1 w) y) (refl (at (D1 w) y))) ;

  -- the restricted pre-dilator
  F0 (n : N) : N = ones (chi n) ;

  F1 (w : Wd) : Wd = restrict (chi (len w)) (compW (D1 w) (chi (ones w))) ;

  chr (w : Wd) : Id Wd (compW (chi (len w)) (F1 w)) (compW (D1 w) (chi (ones w))) =
    restrict-comp (chi (len w)) (compW (D1 w) (chi (ones w)))
      (trans N (len (compW (D1 w) (chi (ones w)))) (len (D1 w)) (len (chi (len w)))
         (len-comp (D1 w) (chi (ones w)))
         (trans N (len (D1 w)) (D0 (len w)) (len (chi (len w))) (dlen w)
            (sym N (len (chi (len w))) (D0 (len w)) (len-chi (len w)))))
      (subst Wd (\ u -> Le u (chi (len w))) (andW (D1 w) (chi (len w))) (compW (D1 w) (chi (ones w)))
         (sym Wd (compW (D1 w) (chi (ones w))) (andW (D1 w) (chi (len w))) (pb w))
         (Le-and-r (D1 w) (chi (len w)))) ;

  chrG (w : Wd) (n : N) (hn : Id N (len w) n) (m : N) (hm : Id N (ones w) m)
    : Id Wd (compW (chi n) (F1 w)) (compW (D1 w) (chi m)) =
    trans Wd (compW (chi n) (F1 w)) (compW (chi (len w)) (F1 w)) (compW (D1 w) (chi m))
      (ap N Wd (\ k -> compW (chi k) (F1 w)) n (len w) (sym N (len w) n hn))
      (trans Wd (compW (chi (len w)) (F1 w)) (compW (D1 w) (chi (ones w))) (compW (D1 w) (chi m))
         (chr w) (ap N Wd (\ k -> compW (D1 w) (chi k)) (ones w) m hm)) ;

  flen (w : Wd) : Id N (len (F1 w)) (F0 (len w)) = len-restrict (chi (len w)) (compW (D1 w) (chi (ones w))) ;

  oD (w : Wd) : Id N (ones (D1 w)) (len (chi (ones w))) =
    trans N (ones (D1 w)) (D0 (ones w)) (len (chi (ones w))) (dones w) (sym N (len (chi (ones w))) (D0 (ones w)) (len-chi (ones w))) ;

  fones (w : Wd) : Id N (ones (F1 w)) (F0 (ones w)) =
    trans N (ones (F1 w)) (ones (compW (chi (len w)) (F1 w))) (F0 (ones w))
      (sym N (ones (compW (chi (len w)) (F1 w))) (ones (F1 w))
         (ones-comp (chi (len w)) (F1 w) (sym N (len (F1 w)) (F0 (len w)) (flen w))))
      (trans N (ones (compW (chi (len w)) (F1 w))) (ones (compW (D1 w) (chi (ones w)))) (F0 (ones w))
         (ap Wd N ones (compW (chi (len w)) (F1 w)) (compW (D1 w) (chi (ones w))) (chr w))
         (ones-comp (D1 w) (chi (ones w)) (oD w))) ;

  fid (n : N) : Id Wd (F1 (idW n)) (idW (F0 n)) =
    trans Wd (F1 (idW n)) (restrict (chi (len (idW n))) (compW (idW (D0 n)) (chi (ones (idW n))))) (idW (F0 n))
      (ap Wd Wd (\ u -> restrict (chi (len (idW n))) (compW u (chi (ones (idW n))))) (D1 (idW n)) (idW (D0 n)) (did n))
      (trans Wd (restrict (chi (len (idW n))) (compW (idW (D0 n)) (chi (ones (idW n)))))
                (restrict (chi n) (compW (idW (D0 n)) (chi n))) (idW (F0 n))
         (ap2 N N Wd (\ k k' -> restrict (chi k) (compW (idW (D0 n)) (chi k'))) (len (idW n)) n (ones (idW n)) n
            (len-idW n) (ones-idW n))
         (trans Wd (restrict (chi n) (compW (idW (D0 n)) (chi n))) (restrict (chi n) (chi n)) (idW (F0 n))
            (ap Wd Wd (\ u -> restrict (chi n) u) (compW (idW (D0 n)) (chi n)) (chi n)
               (subst N (\ k -> Id Wd (compW (idW k) (chi n)) (chi n)) (len (chi n)) (D0 n) (len-chi n) (idW-comp (chi n))))
            (restrict-self (chi n)))) ;

  mD (v w : Wd) (h : Id N (ones v) (len w)) : Id N (ones (D1 v)) (len (D1 w)) =
    trans N (ones (D1 v)) (D0 (ones v)) (len (D1 w)) (dones v)
      (trans N (D0 (ones v)) (D0 (len w)) (len (D1 w)) (ap N N D0 (ones v) (len w) h)
         (sym N (len (D1 w)) (D0 (len w)) (dlen w))) ;

  oDl (v w : Wd) (h : Id N (ones v) (len w)) : Id N (ones (D1 v)) (len (chi (len w))) =
    trans N (ones (D1 v)) (D0 (ones v)) (len (chi (len w))) (dones v)
      (trans N (D0 (ones v)) (D0 (len w)) (len (chi (len w))) (ap N N D0 (ones v) (len w) h)
         (sym N (len (chi (len w))) (D0 (len w)) (len-chi (len w)))) ;

  fcomp (v w : Wd) (h : Id N (ones v) (len w)) : Id Wd (F1 (compW v w)) (compW (F1 v) (F1 w)) =
    comp-cancel (chi (len v)) (F1 (compW v w)) (compW (F1 v) (F1 w))
      (trans N (len (F1 (compW v w))) (F0 (len (compW v w))) (F0 (len v)) (flen (compW v w))
         (ap N N F0 (len (compW v w)) (len v) (len-comp v w)))
      (trans N (len (compW (F1 v) (F1 w))) (len (F1 v)) (F0 (len v)) (len-comp (F1 v) (F1 w)) (flen v))
      (trans Wd (compW (chi (len v)) (F1 (compW v w))) (compW (D1 (compW v w)) (chi (ones w)))
                (compW (chi (len v)) (compW (F1 v) (F1 w)))
         (chrG (compW v w) (len v) (len-comp v w) (ones w) (ones-comp v w h))
         (trans Wd (compW (D1 (compW v w)) (chi (ones w))) (compW (compW (D1 v) (D1 w)) (chi (ones w)))
                   (compW (chi (len v)) (compW (F1 v) (F1 w)))
            (ap Wd Wd (\ u -> compW u (chi (ones w))) (D1 (compW v w)) (compW (D1 v) (D1 w)) (dcomp v w h))
            (trans Wd (compW (compW (D1 v) (D1 w)) (chi (ones w))) (compW (D1 v) (compW (D1 w) (chi (ones w))))
                      (compW (chi (len v)) (compW (F1 v) (F1 w)))
               (comp-assoc (D1 v) (D1 w) (chi (ones w)) (mD v w h) (oD w))
               (trans Wd (compW (D1 v) (compW (D1 w) (chi (ones w)))) (compW (D1 v) (compW (chi (len w)) (F1 w)))
                         (compW (chi (len v)) (compW (F1 v) (F1 w)))
                  (ap Wd Wd (\ u -> compW (D1 v) u) (compW (D1 w) (chi (ones w))) (compW (chi (len w)) (F1 w))
                     (sym Wd (compW (chi (len w)) (F1 w)) (compW (D1 w) (chi (ones w))) (chr w)))
                  (trans Wd (compW (D1 v) (compW (chi (len w)) (F1 w))) (compW (compW (D1 v) (chi (len w))) (F1 w))
                            (compW (chi (len v)) (compW (F1 v) (F1 w)))
                     (sym Wd (compW (compW (D1 v) (chi (len w))) (F1 w)) (compW (D1 v) (compW (chi (len w)) (F1 w)))
                        (comp-assoc (D1 v) (chi (len w)) (F1 w) (oDl v w h) (sym N (len (F1 w)) (F0 (len w)) (flen w))))
                     (trans Wd (compW (compW (D1 v) (chi (len w))) (F1 w)) (compW (compW (chi (len v)) (F1 v)) (F1 w))
                               (compW (chi (len v)) (compW (F1 v) (F1 w)))
                        (ap Wd Wd (\ u -> compW u (F1 w)) (compW (D1 v) (chi (len w))) (compW (chi (len v)) (F1 v))
                           (sym Wd (compW (chi (len v)) (F1 v)) (compW (D1 v) (chi (len w)))
                              (chrG v (len v) (refl (len v)) (len w) h)))
                        (comp-assoc (chi (len v)) (F1 v) (F1 w) (sym N (len (F1 v)) (F0 (len v)) (flen v))
                           (trans N (ones (F1 v)) (F0 (ones v)) (len (F1 w)) (fones v)
                              (trans N (F0 (ones v)) (F0 (len w)) (len (F1 w)) (ap N N F0 (ones v) (len w) h)
                                 (sym N (len (F1 w)) (F0 (len w)) (flen w))))))))))) ;

  meetE (v w : Wd) (h : Id N (len v) (len w))
    : Id Wd (compW (chi (len v)) (F1 (andW v w))) (compW (chi (len v)) (andW (F1 v) (F1 w))) =
    trans Wd (compW (chi (len v)) (F1 (andW v w))) (andW (andW (D1 v) (D1 w)) (chi (len v)))
             (compW (chi (len v)) (andW (F1 v) (F1 w)))
      (trans Wd (compW (chi (len v)) (F1 (andW v w))) (compW (D1 (andW v w)) (chi (ones (andW v w))))
                (andW (andW (D1 v) (D1 w)) (chi (len v)))
         (chrG (andW v w) (len v) (len-and v w) (ones (andW v w)) (refl (ones (andW v w))))
         (trans Wd (compW (D1 (andW v w)) (chi (ones (andW v w)))) (andW (D1 (andW v w)) (chi (len (andW v w))))
                   (andW (andW (D1 v) (D1 w)) (chi (len v)))
            (pb (andW v w))
            (ap2 Wd N Wd (\ u k -> andW u (chi k)) (D1 (andW v w)) (andW (D1 v) (D1 w)) (len (andW v w)) (len v)
               (dmeet v w h) (len-and v w))))
      (trans Wd (andW (andW (D1 v) (D1 w)) (chi (len v))) (andW (andW (D1 v) (chi (len v))) (andW (D1 w) (chi (len v))))
                (compW (chi (len v)) (andW (F1 v) (F1 w)))
         (and-dist (D1 v) (D1 w) (chi (len v)))
         (trans Wd (andW (andW (D1 v) (chi (len v))) (andW (D1 w) (chi (len v))))
                   (andW (compW (chi (len v)) (F1 v)) (compW (chi (len v)) (F1 w)))
                   (compW (chi (len v)) (andW (F1 v) (F1 w)))
            (ap2 Wd Wd Wd andW (andW (D1 v) (chi (len v))) (compW (chi (len v)) (F1 v))
               (andW (D1 w) (chi (len v))) (compW (chi (len v)) (F1 w))
               (trans Wd (andW (D1 v) (chi (len v))) (compW (D1 v) (chi (ones v))) (compW (chi (len v)) (F1 v))
                  (sym Wd (compW (D1 v) (chi (ones v))) (andW (D1 v) (chi (len v))) (pb v))
                  (sym Wd (compW (chi (len v)) (F1 v)) (compW (D1 v) (chi (ones v))) (chr v)))
               (trans Wd (andW (D1 w) (chi (len v))) (andW (D1 w) (chi (len w))) (compW (chi (len v)) (F1 w))
                  (ap N Wd (\ k -> andW (D1 w) (chi k)) (len v) (len w) h)
                  (trans Wd (andW (D1 w) (chi (len w))) (compW (D1 w) (chi (ones w))) (compW (chi (len v)) (F1 w))
                     (sym Wd (compW (D1 w) (chi (ones w))) (andW (D1 w) (chi (len w))) (pb w))
                     (sym Wd (compW (chi (len v)) (F1 w)) (compW (D1 w) (chi (ones w)))
                        (chrG w (len v) (sym N (len v) (len w) h) (ones w) (refl (ones w)))))))
            (sym Wd (compW (chi (len v)) (andW (F1 v) (F1 w))) (andW (compW (chi (len v)) (F1 v)) (compW (chi (len v)) (F1 w)))
               (comp-and (chi (len v)) (F1 v) (F1 w))))) ;

  fmeet (v w : Wd) (h : Id N (len v) (len w)) : Id Wd (F1 (andW v w)) (andW (F1 v) (F1 w)) =
    comp-cancel (chi (len v)) (F1 (andW v w)) (andW (F1 v) (F1 w))
      (trans N (len (F1 (andW v w))) (F0 (len (andW v w))) (F0 (len v)) (flen (andW v w))
         (ap N N F0 (len (andW v w)) (len v) (len-and v w)))
      (trans N (len (andW (F1 v) (F1 w))) (len (F1 v)) (F0 (len v)) (len-and (F1 v) (F1 w)) (flen v))
      (meetE v w h) ;

  module P = PreDil[F0, F1, flen, fones, fid, fcomp, fmeet] ;

  -- the inclusion F -> D is a natural transformation, and its trace is in c
  tnat (w : Wd) : Id Wd (compW (D1 w) (chi (ones w))) (compW (chi (len w)) (F1 w)) =
    sym Wd (compW (chi (len w)) (F1 w)) (compW (D1 w) (chi (ones w))) (chr w) ;

  module Inc = Nat[F0, F1, flen, fones, fid, fcomp, fmeet, D0, D1, dlen, dones, did, dcomp, dmeet,
                   chi, len-chi, \ n -> refl (F0 n), tnat] ;

  trIn (m t : N) (tp : Inc.TPd m t) : Id Bool (c m (sel (chi m) t)) true =
    trans Bool (c m (sel (chi m) t)) (trc m (sel (chi m) t)) true
      (sym Bool (trc m (sel (chi m) t)) (c m (sel (chi m) t))
         (trans Bool (trc m (sel (chi m) t)) (c (ones (idW m)) (rank (D1 (idW m)) (sel (chi m) t))) (c m (sel (chi m) t))
            (ap Wd Bool (\ u -> c (ones u) (rank (D1 u) (sel (chi m) t)))
               PD.Sup[m, sel (chi m) t].supp (idW m) (Inc.trT m t tp).2)
            (ap2 N N Bool c (ones (idW m)) m (rank (D1 (idW m)) (sel (chi m) t)) (sel (chi m) t)
               (ones-idW m) (PD.rkid m (sel (chi m) t) (Inc.trT m t tp).1))))
      (trans Bool (trc m (sel (chi m) t)) (at (chi m) (sel (chi m) t)) true
         (sym Bool (at (chi m) (sel (chi m) t)) (trc m (sel (chi m) t))
            (at-tab (D0 m) (trc m) (sel (chi m) t) (Inc.trT m t tp).1))
         (at-sel (chi m) t tp.1)) ;
} ;

-- a table whose true positions are below its false positions is 1^a 0^b
SortT (k : N) (f : N -> Bool) : U a =
  (x y : N) -> Id Bool (ltN x k) true -> Id Bool (ltN y k) true -> Id Bool (f x) true -> Id Bool (f y) false
    -> Id Bool (ltN x y) true ;

Blocks (k : N) (f : N -> Bool) : U a =
  Id Wd (tab k f) (app (idW (ones (tab k f))) (zeros (ones (tab k (\ j -> notB (f j)))))) *
  Id Wd (tab k (\ j -> notB (f j))) (app (zeros (ones (tab k f))) (idW (ones (tab k (\ j -> notB (f j)))))) ;

allFalse : (k : N) (f : N -> Bool) -> ((x : N) -> Id Bool (ltN x k) true -> Id Bool (f x) false)
  -> Id Wd (tab k f) (zeros k) * Id Wd (tab k (\ j -> notB (f j))) (idW k) = split {
  zero -> \ f h -> (refl nil, refl nil) ;
  suc k | r -> \ f h ->
    (subst Bool (\ b -> Id Wd (cons b (tab k (\ j -> f (suc j)))) (zeros (suc k))) false (f zero)
       (sym Bool (f zero) false (h zero (refl true)))
       (ap Wd Wd (\ u -> o u) (tab k (\ j -> f (suc j))) (zeros k) (r (\ j -> f (suc j)) (\ x hx -> h (suc x) hx)).1),
     subst Bool (\ b -> Id Wd (cons (notB b) (tab k (\ j -> notB (f (suc j))))) (idW (suc k))) false (f zero)
       (sym Bool (f zero) false (h zero (refl true)))
       (ap Wd Wd (\ u -> i u) (tab k (\ j -> notB (f (suc j)))) (idW k) (r (\ j -> f (suc j)) (\ x hx -> h (suc x) hx)).2)) } ;

blocksT (k : N) (f : N -> Bool) (ih : Blocks k (\ j -> f (suc j))) (e : Id Bool (f zero) true) : Blocks (suc k) f =
  subst Bool (\ b -> Id Wd (cons b (tab k (\ j -> f (suc j))))
                       (app (idW (ones (cons b (tab k (\ j -> f (suc j))))))
                            (zeros (ones (cons (notB b) (tab k (\ j -> notB (f (suc j)))))))) *
                     Id Wd (cons (notB b) (tab k (\ j -> notB (f (suc j)))))
                       (app (zeros (ones (cons b (tab k (\ j -> f (suc j))))))
                            (idW (ones (cons (notB b) (tab k (\ j -> notB (f (suc j)))))))))
    true (f zero) (sym Bool (f zero) true e)
    (ap Wd Wd (\ u -> i u) (tab k (\ j -> f (suc j)))
       (app (idW (ones (tab k (\ j -> f (suc j))))) (zeros (ones (tab k (\ j -> notB (f (suc j))))))) ih.1,
     ap Wd Wd (\ u -> o u) (tab k (\ j -> notB (f (suc j))))
       (app (zeros (ones (tab k (\ j -> f (suc j))))) (idW (ones (tab k (\ j -> notB (f (suc j))))))) ih.2) ;

fxFalse (k : N) (f : N -> Bool) (st : SortT (suc k) f) (e : Id Bool (f zero) false) (x : N) (hx : Id Bool (ltN x (suc k)) true)
  : (b : Bool) -> Id Bool (f x) b -> Id Bool (f x) false = split {
  false -> \ e' -> e' ;
  true -> \ e' -> ltN-zero-abs (Id Bool (f x) false) x (st x zero hx (refl true) e' e) } ;

blocksF (k : N) (f : N -> Bool) (st : SortT (suc k) f) (e : Id Bool (f zero) false) : Blocks (suc k) f =
  (trans Wd (tab (suc k) f) (zeros (suc k)) (app (idW (ones (tab (suc k) f))) (zeros (ones (tab (suc k) (\ j -> notB (f j))))))
     (allFalse (suc k) f (\ x hx -> fxFalse k f st e x hx (f x) (refl (f x)))).1
     (sym Wd (app (idW (ones (tab (suc k) f))) (zeros (ones (tab (suc k) (\ j -> notB (f j)))))) (app (idW zero) (zeros (suc k)))
        (ap2 N N Wd (\ p q -> app (idW p) (zeros q)) (ones (tab (suc k) f)) zero (ones (tab (suc k) (\ j -> notB (f j)))) (suc k)
           (trans N (ones (tab (suc k) f)) (ones (zeros (suc k))) zero
              (ap Wd N ones (tab (suc k) f) (zeros (suc k)) (allFalse (suc k) f (\ x hx -> fxFalse k f st e x hx (f x) (refl (f x)))).1)
              (ones-zeros (suc k)))
           (trans N (ones (tab (suc k) (\ j -> notB (f j)))) (ones (idW (suc k))) (suc k)
              (ap Wd N ones (tab (suc k) (\ j -> notB (f j))) (idW (suc k))
                 (allFalse (suc k) f (\ x hx -> fxFalse k f st e x hx (f x) (refl (f x)))).2)
              (ones-idW (suc k))))),
   trans Wd (tab (suc k) (\ j -> notB (f j))) (idW (suc k))
            (app (zeros (ones (tab (suc k) f))) (idW (ones (tab (suc k) (\ j -> notB (f j))))))
     (allFalse (suc k) f (\ x hx -> fxFalse k f st e x hx (f x) (refl (f x)))).2
     (sym Wd (app (zeros (ones (tab (suc k) f))) (idW (ones (tab (suc k) (\ j -> notB (f j)))))) (app (zeros zero) (idW (suc k)))
        (ap2 N N Wd (\ p q -> app (zeros p) (idW q)) (ones (tab (suc k) f)) zero (ones (tab (suc k) (\ j -> notB (f j)))) (suc k)
           (trans N (ones (tab (suc k) f)) (ones (zeros (suc k))) zero
              (ap Wd N ones (tab (suc k) f) (zeros (suc k)) (allFalse (suc k) f (\ x hx -> fxFalse k f st e x hx (f x) (refl (f x)))).1)
              (ones-zeros (suc k)))
           (trans N (ones (tab (suc k) (\ j -> notB (f j)))) (ones (idW (suc k))) (suc k)
              (ap Wd N ones (tab (suc k) (\ j -> notB (f j))) (idW (suc k))
                 (allFalse (suc k) f (\ x hx -> fxFalse k f st e x hx (f x) (refl (f x)))).2)
              (ones-idW (suc k)))))) ;

tabCase (k : N) (r : (f : N -> Bool) -> SortT k f -> Blocks k f) (f : N -> Bool) (st : SortT (suc k) f)
  : (b : Bool) -> Id Bool (f zero) b -> Blocks (suc k) f = split {
  false -> \ e -> blocksF k f st e ;
  true -> \ e -> blocksT k f (r (\ j -> f (suc j)) (\ x y hx hy fx fy -> st (suc x) (suc y) hx hy fx fy)) e } ;

tabSplit : (k : N) (f : N -> Bool) -> SortT k f -> Blocks k f = split {
  zero -> \ f st -> (refl nil, refl nil) ;
  suc k | r -> \ f st -> tabCase k r f st (f zero) (refl (f zero)) } ;

andB-true : (c : Bool) -> Id Bool (andB c true) c = split { false -> refl false ; true -> refl true } ;

-- the splitting along a cut: if every trace point in c is separated from
-- (below) every trace point outside c, then D is the sum of its
-- restrictions to c and to the complement of c
module SplitCut
  (D0 : N -> N) (D1 : Wd -> Wd)
  (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
  (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
  (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
  (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
  (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w)))
  (c : N -> N -> Bool)
  (hcut : (m z m' z' : N) -> Conn[D0, D1, dlen, dones, did, dcomp, dmeet].TP m z
         -> Conn[D0, D1, dlen, dones, did, dcomp, dmeet].TP m' z'
         -> Id Bool (c m z) true -> Id Bool (c m' z') false
         -> Conn[D0, D1, dlen, dones, did, dcomp, dmeet].Sep m z m' z') {

  module RF = Restr[D0, D1, dlen, dones, did, dcomp, dmeet, c] ;
  module RG = Restr[D0, D1, dlen, dones, did, dcomp, dmeet, \ m z -> notB (c m z)] ;

  dP (n x : N) (hx : Id Bool (ltN x (D0 n)) true) : RF.PD.Den n = RF.PD.fwd n (x, RF.PD.hzOf n x hx) ;

  -- in D(n), the points of c are below the others
  sortN (n : N) : SortT (D0 n) (RF.trc n) =
    \ x y hx hy fx fy ->
      trans Bool (ltN x y) (isLt (cmpN x y)) true
        (sym Bool (isLt (cmpN x y)) (ltN x y) (ltN-cmp x y))
        (ap O3 Bool isLt (cmpN x y) lt
           (trans O3 (cmpN x y) (cmpN (sel (D1 (dP n x hx).1) (dP n x hx).2.1) (sel (D1 (dP n y hy).1) (dP n y hy).2.1)) lt
              (ap2 N N O3 cmpN x (sel (D1 (dP n x hx).1) (dP n x hx).2.1) y (sel (D1 (dP n y hy).1) (dP n y hy).2.1)
                 (sym N (sel (D1 (dP n x hx).1) (dP n x hx).2.1) x (RF.PD.bwd-fwd n (x, RF.PD.hzOf n x hx)))
                 (sym N (sel (D1 (dP n y hy).1) (dP n y hy).2.1) y (RF.PD.bwd-fwd n (y, RF.PD.hzOf n y hy))))
              (hcut (ones (dP n x hx).1) (dP n x hx).2.1 (ones (dP n y hy).1) (dP n y hy).2.1
                 (dP n x hx).2.2.2 (dP n y hy).2.2.2 fx fy
                 (dP n x hx).1 (dP n y hy).1
                 (trans N (len (dP n x hx).1) n (len (dP n y hy).1) (dP n x hx).2.2.1 (sym N (len (dP n y hy).1) n (dP n y hy).2.2.1))
                 (refl (ones (dP n x hx).1)) (refl (ones (dP n y hy).1))))) ;

  -- F(n) is the first block of D(n), G(n) the second
  bl (n : N) : Blocks (D0 n) (RF.trc n) = tabSplit (D0 n) (RF.trc n) (sortN n) ;

  sum0 (n : N) : Id N (D0 n) (plus (RF.F0 n) (RG.F0 n)) =
    trans N (D0 n) (len (RF.chi n)) (plus (RF.F0 n) (RG.F0 n))
      (sym N (len (RF.chi n)) (D0 n) (RF.len-chi n))
      (trans N (len (RF.chi n)) (len (app (idW (RF.F0 n)) (zeros (RG.F0 n)))) (plus (RF.F0 n) (RG.F0 n))
         (ap Wd N len (RF.chi n) (app (idW (RF.F0 n)) (zeros (RG.F0 n))) (bl n).1)
         (trans N (len (app (idW (RF.F0 n)) (zeros (RG.F0 n)))) (plus (len (idW (RF.F0 n))) (len (zeros (RG.F0 n))))
                  (plus (RF.F0 n) (RG.F0 n))
            (len-app (idW (RF.F0 n)) (zeros (RG.F0 n)))
            (ap2 N N N plus (len (idW (RF.F0 n))) (RF.F0 n) (len (zeros (RG.F0 n))) (RG.F0 n)
               (len-idW (RF.F0 n)) (len-zeros (RG.F0 n))))) ;

  blockF (n : N) (X : Wd) (hX : Id N (len X) (RF.F0 n))
    : Id Wd (compW (app (idW (RF.F0 n)) (zeros (RG.F0 n))) X) (app X (zeros (RG.F0 n))) =
    trans Wd (compW (app (idW (RF.F0 n)) (zeros (RG.F0 n))) X) (compW (app (idW (RF.F0 n)) (zeros (RG.F0 n))) (app X nil))
             (app X (zeros (RG.F0 n)))
      (ap Wd Wd (\ u -> compW (app (idW (RF.F0 n)) (zeros (RG.F0 n))) u) X (app X nil) (sym Wd (app X nil) X (app-nil X)))
      (trans Wd (compW (app (idW (RF.F0 n)) (zeros (RG.F0 n))) (app X nil))
                (app (compW (idW (RF.F0 n)) X) (compW (zeros (RG.F0 n)) nil)) (app X (zeros (RG.F0 n)))
         (comp-app (idW (RF.F0 n)) X
            (trans N (ones (idW (RF.F0 n))) (RF.F0 n) (len X) (ones-idW (RF.F0 n)) (sym N (len X) (RF.F0 n) hX))
            (zeros (RG.F0 n)) nil)
         (ap2 Wd Wd Wd app (compW (idW (RF.F0 n)) X) X (compW (zeros (RG.F0 n)) nil) (zeros (RG.F0 n))
            (subst N (\ k -> Id Wd (compW (idW k) X) X) (len X) (RF.F0 n) hX (idW-comp X))
            (comp-zeros (RG.F0 n) nil))) ;

  blockG (n : N) (X : Wd) (hX : Id N (len X) (RG.F0 n))
    : Id Wd (compW (app (zeros (RF.F0 n)) (idW (RG.F0 n))) X) (app (zeros (RF.F0 n)) X) =
    trans Wd (compW (app (zeros (RF.F0 n)) (idW (RG.F0 n))) (app nil X))
             (app (compW (zeros (RF.F0 n)) nil) (compW (idW (RG.F0 n)) X)) (app (zeros (RF.F0 n)) X)
      (comp-app (zeros (RF.F0 n)) nil (ones-zeros (RF.F0 n)) (idW (RG.F0 n)) X)
      (ap2 Wd Wd Wd app (compW (zeros (RF.F0 n)) nil) (zeros (RF.F0 n)) (compW (idW (RG.F0 n)) X) X
         (comp-zeros (RF.F0 n) nil)
         (subst N (\ k -> Id Wd (compW (idW k) X) X) (len X) (RG.F0 n) hX (idW-comp X))) ;

  -- the letter y of D(w): in the first block it is a letter of F(w), in
  -- the second a letter of G(w)
  atF (w : Wd) (y : N) (hl : Id Bool (ltN y (RF.F0 (len w))) true)
    : Id Bool (at (D1 w) y) (at (RF.F1 w) y) =
    trans Bool (at (D1 w) y) (at (andW (D1 w) (RF.chi (len w))) y) (at (RF.F1 w) y)
      (trans Bool (at (D1 w) y) (andB (at (D1 w) y) (at (RF.chi (len w)) y)) (at (andW (D1 w) (RF.chi (len w))) y)
         (trans Bool (at (D1 w) y) (andB (at (D1 w) y) true) (andB (at (D1 w) y) (at (RF.chi (len w)) y))
            (sym Bool (andB (at (D1 w) y) true) (at (D1 w) y) (andB-true (at (D1 w) y)))
            (ap Bool Bool (\ b -> andB (at (D1 w) y) b) true (at (RF.chi (len w)) y)
               (sym Bool (at (RF.chi (len w)) y) true
                  (trans Bool (at (RF.chi (len w)) y) (at (app (idW (RF.F0 (len w))) (zeros (RG.F0 (len w)))) y) true
                     (ap Wd Bool (\ u -> at u y) (RF.chi (len w)) (app (idW (RF.F0 (len w))) (zeros (RG.F0 (len w)))) (bl (len w)).1)
                     (trans Bool (at (app (idW (RF.F0 (len w))) (zeros (RG.F0 (len w)))) y) (at (idW (RF.F0 (len w))) y) true
                        (at-app-l (idW (RF.F0 (len w))) y (zeros (RG.F0 (len w)))
                           (subst N (\ k -> Id Bool (ltN y k) true) (RF.F0 (len w)) (len (idW (RF.F0 (len w))))
                              (sym N (len (idW (RF.F0 (len w)))) (RF.F0 (len w)) (len-idW (RF.F0 (len w)))) hl))
                        (at-idW (RF.F0 (len w)) y hl))))))
         (sym Bool (at (andW (D1 w) (RF.chi (len w))) y) (andB (at (D1 w) y) (at (RF.chi (len w)) y))
            (at-and (D1 w) y (RF.chi (len w)))))
      (trans Bool (at (andW (D1 w) (RF.chi (len w))) y) (at (compW (RF.chi (len w)) (RF.F1 w)) y) (at (RF.F1 w) y)
         (ap Wd Bool (\ u -> at u y) (andW (D1 w) (RF.chi (len w))) (compW (RF.chi (len w)) (RF.F1 w))
            (trans Wd (andW (D1 w) (RF.chi (len w))) (compW (D1 w) (RF.chi (ones w))) (compW (RF.chi (len w)) (RF.F1 w))
               (sym Wd (compW (D1 w) (RF.chi (ones w))) (andW (D1 w) (RF.chi (len w))) (RF.pb w))
               (RF.tnat w)))
         (trans Bool (at (compW (RF.chi (len w)) (RF.F1 w)) y) (at (app (RF.F1 w) (zeros (RG.F0 (len w)))) y) (at (RF.F1 w) y)
            (ap Wd Bool (\ u -> at u y) (compW (RF.chi (len w)) (RF.F1 w)) (app (RF.F1 w) (zeros (RG.F0 (len w))))
               (trans Wd (compW (RF.chi (len w)) (RF.F1 w)) (compW (app (idW (RF.F0 (len w))) (zeros (RG.F0 (len w)))) (RF.F1 w))
                         (app (RF.F1 w) (zeros (RG.F0 (len w))))
                  (ap Wd Wd (\ u -> compW u (RF.F1 w)) (RF.chi (len w)) (app (idW (RF.F0 (len w))) (zeros (RG.F0 (len w))))
                     (bl (len w)).1)
                  (blockF (len w) (RF.F1 w) (RF.flen w))))
            (at-app-l (RF.F1 w) y (zeros (RG.F0 (len w)))
               (subst N (\ k -> Id Bool (ltN y k) true) (RF.F0 (len w)) (len (RF.F1 w))
                  (sym N (len (RF.F1 w)) (RF.F0 (len w)) (RF.flen w)) hl)))) ;

  atG (w : Wd) (y : N) (hl : Id Bool (ltN y (RG.F0 (len w))) true)
    : Id Bool (at (D1 w) (plus (RF.F0 (len w)) y)) (at (RG.F1 w) y) =
    trans Bool (at (D1 w) (plus (RF.F0 (len w)) y)) (at (andW (D1 w) (RG.chi (len w))) (plus (RF.F0 (len w)) y)) (at (RG.F1 w) y)
      (trans Bool (at (D1 w) (plus (RF.F0 (len w)) y))
                  (andB (at (D1 w) (plus (RF.F0 (len w)) y)) (at (RG.chi (len w)) (plus (RF.F0 (len w)) y)))
                  (at (andW (D1 w) (RG.chi (len w))) (plus (RF.F0 (len w)) y))
         (trans Bool (at (D1 w) (plus (RF.F0 (len w)) y)) (andB (at (D1 w) (plus (RF.F0 (len w)) y)) true)
                     (andB (at (D1 w) (plus (RF.F0 (len w)) y)) (at (RG.chi (len w)) (plus (RF.F0 (len w)) y)))
            (sym Bool (andB (at (D1 w) (plus (RF.F0 (len w)) y)) true) (at (D1 w) (plus (RF.F0 (len w)) y))
               (andB-true (at (D1 w) (plus (RF.F0 (len w)) y))))
            (ap Bool Bool (\ b -> andB (at (D1 w) (plus (RF.F0 (len w)) y)) b) true (at (RG.chi (len w)) (plus (RF.F0 (len w)) y))
               (sym Bool (at (RG.chi (len w)) (plus (RF.F0 (len w)) y)) true
                  (trans Bool (at (RG.chi (len w)) (plus (RF.F0 (len w)) y))
                              (at (app (zeros (RF.F0 (len w))) (idW (RG.F0 (len w)))) (plus (RF.F0 (len w)) y)) true
                     (ap Wd Bool (\ u -> at u (plus (RF.F0 (len w)) y)) (RG.chi (len w))
                        (app (zeros (RF.F0 (len w))) (idW (RG.F0 (len w)))) (bl (len w)).2)
                     (trans Bool (at (app (zeros (RF.F0 (len w))) (idW (RG.F0 (len w)))) (plus (RF.F0 (len w)) y))
                                 (at (idW (RG.F0 (len w))) y) true
                        (subst N (\ k -> Id Bool (at (app (zeros (RF.F0 (len w))) (idW (RG.F0 (len w)))) (plus k y))
                                                 (at (idW (RG.F0 (len w))) y))
                           (len (zeros (RF.F0 (len w)))) (RF.F0 (len w)) (len-zeros (RF.F0 (len w)))
                           (at-app-r (zeros (RF.F0 (len w))) (idW (RG.F0 (len w))) y))
                        (at-idW (RG.F0 (len w)) y hl))))))
         (sym Bool (at (andW (D1 w) (RG.chi (len w))) (plus (RF.F0 (len w)) y))
                   (andB (at (D1 w) (plus (RF.F0 (len w)) y)) (at (RG.chi (len w)) (plus (RF.F0 (len w)) y)))
            (at-and (D1 w) (plus (RF.F0 (len w)) y) (RG.chi (len w)))))
      (trans Bool (at (andW (D1 w) (RG.chi (len w))) (plus (RF.F0 (len w)) y))
                  (at (compW (RG.chi (len w)) (RG.F1 w)) (plus (RF.F0 (len w)) y)) (at (RG.F1 w) y)
         (ap Wd Bool (\ u -> at u (plus (RF.F0 (len w)) y)) (andW (D1 w) (RG.chi (len w))) (compW (RG.chi (len w)) (RG.F1 w))
            (trans Wd (andW (D1 w) (RG.chi (len w))) (compW (D1 w) (RG.chi (ones w))) (compW (RG.chi (len w)) (RG.F1 w))
               (sym Wd (compW (D1 w) (RG.chi (ones w))) (andW (D1 w) (RG.chi (len w))) (RG.pb w))
               (RG.tnat w)))
         (trans Bool (at (compW (RG.chi (len w)) (RG.F1 w)) (plus (RF.F0 (len w)) y))
                     (at (app (zeros (RF.F0 (len w))) (RG.F1 w)) (plus (RF.F0 (len w)) y)) (at (RG.F1 w) y)
            (ap Wd Bool (\ u -> at u (plus (RF.F0 (len w)) y)) (compW (RG.chi (len w)) (RG.F1 w)) (app (zeros (RF.F0 (len w))) (RG.F1 w))
               (trans Wd (compW (RG.chi (len w)) (RG.F1 w)) (compW (app (zeros (RF.F0 (len w))) (idW (RG.F0 (len w)))) (RG.F1 w))
                         (app (zeros (RF.F0 (len w))) (RG.F1 w))
                  (ap Wd Wd (\ u -> compW u (RG.F1 w)) (RG.chi (len w)) (app (zeros (RF.F0 (len w))) (idW (RG.F0 (len w))))
                     (bl (len w)).2)
                  (blockG (len w) (RG.F1 w) (RG.flen w))))
            (subst N (\ k -> Id Bool (at (app (zeros (RF.F0 (len w))) (RG.F1 w)) (plus k y)) (at (RG.F1 w) y))
               (len (zeros (RF.F0 (len w)))) (RF.F0 (len w)) (len-zeros (RF.F0 (len w)))
               (at-app-r (zeros (RF.F0 (len w))) (RG.F1 w) y)))) ;

  -- the two words agree below plus (F0 n) (G0 n)
  atS (w : Wd) (y : N) (hy : Id Bool (ltN y (plus (RF.F0 (len w)) (RG.F0 (len w)))) true)
    : Or (Id Bool (ltN y (RF.F0 (len w))) true) ((y1 : N) * Id N y (plus (RF.F0 (len w)) y1))
      -> Id Bool (at (D1 w) y) (at (app (RF.F1 w) (RG.F1 w)) y) = split {
    inl h -> trans Bool (at (D1 w) y) (at (RF.F1 w) y) (at (app (RF.F1 w) (RG.F1 w)) y)
               (atF w y h)
               (sym Bool (at (app (RF.F1 w) (RG.F1 w)) y) (at (RF.F1 w) y)
                  (at-app-l (RF.F1 w) y (RG.F1 w)
                     (subst N (\ k -> Id Bool (ltN y k) true) (RF.F0 (len w)) (len (RF.F1 w))
                        (sym N (len (RF.F1 w)) (RF.F0 (len w)) (RF.flen w)) h))) ;
    inr q -> subst N (\ k -> Id Bool (at (D1 w) k) (at (app (RF.F1 w) (RG.F1 w)) k)) (plus (RF.F0 (len w)) q.1) y
               (sym N y (plus (RF.F0 (len w)) q.1) q.2)
               (trans Bool (at (D1 w) (plus (RF.F0 (len w)) q.1)) (at (RG.F1 w) q.1)
                           (at (app (RF.F1 w) (RG.F1 w)) (plus (RF.F0 (len w)) q.1))
                  (atG w q.1
                     (trans Bool (ltN q.1 (RG.F0 (len w))) (ltN (plus (RF.F0 (len w)) q.1) (plus (RF.F0 (len w)) (RG.F0 (len w)))) true
                        (sym Bool (ltN (plus (RF.F0 (len w)) q.1) (plus (RF.F0 (len w)) (RG.F0 (len w)))) (ltN q.1 (RG.F0 (len w)))
                           (ltN-plus (RF.F0 (len w)) q.1 (RG.F0 (len w))))
                        (subst N (\ k -> Id Bool (ltN k (plus (RF.F0 (len w)) (RG.F0 (len w)))) true) y (plus (RF.F0 (len w)) q.1) q.2 hy)))
                  (sym Bool (at (app (RF.F1 w) (RG.F1 w)) (plus (RF.F0 (len w)) q.1)) (at (RG.F1 w) q.1)
                     (subst N (\ k -> Id Bool (at (app (RF.F1 w) (RG.F1 w)) (plus k q.1)) (at (RG.F1 w) q.1))
                        (len (RF.F1 w)) (RF.F0 (len w)) (RF.flen w)
                        (at-app-r (RF.F1 w) (RG.F1 w) q.1)))) } ;

  lenS (w : Wd) : Id N (len (app (RF.F1 w) (RG.F1 w))) (plus (RF.F0 (len w)) (RG.F0 (len w))) =
    trans N (len (app (RF.F1 w) (RG.F1 w))) (plus (len (RF.F1 w)) (len (RG.F1 w))) (plus (RF.F0 (len w)) (RG.F0 (len w)))
      (len-app (RF.F1 w) (RG.F1 w))
      (ap2 N N N plus (len (RF.F1 w)) (RF.F0 (len w)) (len (RG.F1 w)) (RG.F0 (len w)) (RF.flen w) (RG.flen w)) ;

  lenD (w : Wd) : Id N (len (D1 w)) (plus (RF.F0 (len w)) (RG.F0 (len w))) =
    trans N (len (D1 w)) (D0 (len w)) (plus (RF.F0 (len w)) (RG.F0 (len w))) (dlen w) (sum0 (len w)) ;

  sum1 (w : Wd) : Id Wd (D1 w) (app (RF.F1 w) (RG.F1 w)) =
    wext (D1 w) (app (RF.F1 w) (RG.F1 w))
      (trans N (len (D1 w)) (plus (RF.F0 (len w)) (RG.F0 (len w))) (len (app (RF.F1 w) (RG.F1 w)))
         (lenD w) (sym N (len (app (RF.F1 w) (RG.F1 w))) (plus (RF.F0 (len w)) (RG.F0 (len w))) (lenS w)))
      (\ y h -> trans Bool (at (app (RF.F1 w) (RG.F1 w)) y) (at (D1 w) y) true
                  (sym Bool (at (D1 w) y) (at (app (RF.F1 w) (RG.F1 w)) y)
                     (atS w y (subst N (\ k -> Id Bool (ltN y k) true) (len (D1 w)) (plus (RF.F0 (len w)) (RG.F0 (len w))) (lenD w)
                                 (at-lt (D1 w) y h))
                        (cut (RF.F0 (len w)) y)))
                  h)
      (\ y h -> trans Bool (at (D1 w) y) (at (app (RF.F1 w) (RG.F1 w)) y) true
                  (atS w y (subst N (\ k -> Id Bool (ltN y k) true) (len (app (RF.F1 w) (RG.F1 w))) (plus (RF.F0 (len w)) (RG.F0 (len w)))
                              (lenS w) (at-lt (app (RF.F1 w) (RG.F1 w)) y h))
                     (cut (RF.F0 (len w)) y))
                  h) ;

  -- the structures, and the sum
  DQ : PDS = (D0, D1, dlen, dones, did, dcomp, dmeet) ;
  FQ : PDS = (RF.F0, RF.F1, RF.flen, RF.fones, RF.fid, RF.fcomp, RF.fmeet) ;
  GQ : PDS = (RG.F0, RG.F1, RG.flen, RG.fones, RG.fid, RG.fcomp, RG.fmeet) ;

  isSum : IsSum DQ FQ GQ = (sum0, sum1) ;

  -- a connected pre-dilator has no proper cut
  noCut (cn : Connected DQ) (nzF : NonZero FQ) (nzG : NonZero GQ) : Empty = cn.2 FQ GQ isSum nzF nzG ;
} ;

-- example: the restriction of Id + 1 to its trace points of level 1 (the
-- points of Id) and to the others (the point of 1)
module RIdOne = Restr[IdPlus1.S0, IdPlus1.S1, IdPlus1.slen, IdPlus1.sones, IdPlus1.sid, IdPlus1.scomp, IdPlus1.smeet,
  \ m z -> eqN m one] ;
module RIdOneC = Restr[IdPlus1.S0, IdPlus1.S1, IdPlus1.slen, IdPlus1.sones, IdPlus1.sid, IdPlus1.scomp, IdPlus1.smeet,
  \ m z -> notB (eqN m one)] ;

#conv RIdOne.chi three = i (i (i (o nil))) ;
#conv RIdOne.F0 three = three ;
#conv RIdOneC.F0 three = one ;
#conv RIdOne.F1 (o (i nil)) = o (i nil) ;

------------------------------------------------------------------------
-- A univalent segment.  Function extensionality and univalence are
-- hypotheses, given as types (as in core/Axioms.seg), never postulated;
-- nothing above depends on them.  Example: Girard 8.2.6, the extension of
-- D to a linear order X is unique.  Any extension G of D to X (G restricted
-- to the finite subsets c of X is D, G(c) is strictly increasing, and every
-- point of G comes from a finite subset: G preserves direct limits) is
-- EQUAL, as an ordered type, to the extension D(X) by denotations.

isEquiv (A B : U a) (f : A -> B) : U a =
  (s : B -> A) * (((b : B) -> Id B (f (s b)) b) * ((t : B -> A) * ((x : A) -> Id A (t (f x)) x))) ;

isEquivL (A B : U a+) (f : A -> B) : U a+ =
  (s : B -> A) * (((b : B) -> Id B (f (s b)) b) * ((t : B -> A) * ((x : A) -> Id A (t (f x)) x))) ;

Equiv (A B : U a) : U a = (f : A -> B) * isEquiv A B f ;

idEquiv (A : U a) : Equiv A A = (\ x -> x, \ x -> x, \ x -> refl x, \ x -> x, \ x -> refl x) ;

idtoeqv (A B : U a) (p : Id (U a) A B) : Equiv A B = idJ (U a) A (\ X q -> Equiv A X) (idEquiv A) B p ;

Univalence : U a+ = (A B : U a) -> isEquivL (Id (U a) A B) (Equiv A B) (idtoeqv A B) ;

-- ordered types
OrdT : U a+ = (A : U a) * (A -> A -> O3) ;

apL (A : U a) (B : U a+) (f : A -> B) (x y : A) (p : Id A x y) : Id B (f x) (f y) =
  idJ A x (\ z q -> Id B (f x) (f z)) (refl (f x)) y p ;

module UA (funext : (A B : U a) (f g : A -> B) -> ((x : A) -> Id B (f x) (g x)) -> Id (A -> B) f g)
  (ua : Univalence) {

  -- the structure identity principle for ordered types: along p : A = B,
  -- (A, cA) = (B, cB) as soon as the map of p preserves the comparison
  SipH (A B : U a) (p : Id (U a) A B) (cA : A -> A -> O3) (cB : B -> B -> O3) : U a =
    (x y : A) -> Id O3 (cB ((idtoeqv A B p).1 x) ((idtoeqv A B p).1 y)) (cA x y) ;

  sip (A : U a) (cA : A -> A -> O3) (B : U a) (p : Id (U a) A B)
    : (cB : B -> B -> O3) -> SipH A B p cA cB -> Id OrdT (A, cA) (B, cB) =
    idJ (U a) A (\ B1 p1 -> (cB1 : B1 -> B1 -> O3) -> SipH A B1 p1 cA cB1 -> Id OrdT (A, cA) (B1, cB1))
      (\ cB1 h -> apL (A -> A -> O3) OrdT (\ c -> (A, c)) cA cB1
         (funext A (A -> O3) cA cB1
            (\ x -> funext A O3 (cA x) (cB1 x) (\ y -> sym O3 (cB1 x y) (cA x y) (h x y)))))
      B p ;

  -- an equivalence preserving the comparison is an equality of ordered types
  uaOrd (A B : U a) (cA : A -> A -> O3) (cB : B -> B -> O3) (f : A -> B) (ef : isEquiv A B f)
    (hf : (x y : A) -> Id O3 (cB (f x) (f y)) (cA x y)) : Id OrdT (A, cA) (B, cB) =
    sip A cA B ((ua A B).1 (f, ef)) cB
      (subst (A -> B) (\ g -> (x y : A) -> Id O3 (cB (g x) (g y)) (cA x y))
         f (idtoeqv A B ((ua A B).1 (f, ef))).1
         (ap (Equiv A B) (A -> B) (\ e -> e.1) (f, ef) (idtoeqv A B ((ua A B).1 (f, ef)))
            (sym (Equiv A B) (idtoeqv A B ((ua A B).1 (f, ef))) (f, ef) ((ua A B).2.1 (f, ef))))
         hf) ;

  module Ext (X : U a) (cmpX : X -> X -> O3)
    (xeq : (x y : X) -> Id O3 (cmpX x y) eq -> Id X x y)
    (xflip : (x y : X) -> Id O3 (cmpX y x) (flip (cmpX x y)))
    (xtrans : (x y z : X) -> Id O3 (cmpX x y) lt -> Id O3 (cmpX y z) lt -> Id O3 (cmpX x z) lt)
    (D0 : N -> N) (D1 : Wd -> Wd)
    (dlen : (w : Wd) -> Id N (len (D1 w)) (D0 (len w)))
    (dones : (w : Wd) -> Id N (ones (D1 w)) (D0 (ones w)))
    (did : (n : N) -> Id Wd (D1 (idW n)) (idW (D0 n)))
    (dcomp : (v w : Wd) -> Id N (ones v) (len w) -> Id Wd (D1 (compW v w)) (compW (D1 v) (D1 w)))
    (dmeet : (v w : Wd) -> Id N (len v) (len w) -> Id Wd (D1 (andW v w)) (andW (D1 v) (D1 w))) {

    module LX = LinOrd[X, cmpX, xeq, xflip, xtrans] ;
    module DX = LX.DenOrd[D0, D1, dlen, dones, did, dcomp, dmeet] ;

    -- an extension G of D to X: iota c is G(c) : D(n) -> G, for a finite
    -- subset c = [c_0 < .. < c_(n-1)] of X
    module Uniq (G : U a) (cmpG : G -> G -> O3)
      (iota : (c : List X) -> Id Bool (LX.sortedB c) true -> (x : N) -> Id Bool (ltN x (D0 (LX.lenL c))) true -> G)
      -- naturality: G(c) . D(w) = G(c . w)
      (inat : (c : List X) (sc : Id Bool (LX.sortedB c) true) (w : Wd) (hw : Id N (len w) (LX.lenL c)) (z : N)
              (hs : Id Bool (ltN (sel (D1 w) z) (D0 (LX.lenL c))) true)
              (hz : Id Bool (ltN z (D0 (LX.lenL (LX.compL c w)))) true)
         -> Id G (iota c sc (sel (D1 w) z) hs) (iota (LX.compL c w) (LX.sorted-compL c w sc) z hz))
      -- G(c) is strictly increasing
      (imono : (c : List X) (sc : Id Bool (LX.sortedB c) true) (x y : N)
               (hx : Id Bool (ltN x (D0 (LX.lenL c))) true) (hy : Id Bool (ltN y (D0 (LX.lenL c))) true)
         -> Id O3 (cmpG (iota c sc x hx) (iota c sc y hy)) (cmpN x y))
      -- direct limits: every point of G comes from a finite subset
      (ionto : (g : G) -> (c : List X) * (sc : Id Bool (LX.sortedB c) true) * (x : N)
                 * (hx : Id Bool (ltN x (D0 (LX.lenL c))) true) * Id G (iota c sc x hx) g) {

      -- iota does not depend on the proofs
      iotaEq (c : List X) (sc : Id Bool (LX.sortedB c) true) (x : N) (hx : Id Bool (ltN x (D0 (LX.lenL c))) true)
        (c' : List X) (e : Id (List X) c c')
        : (sc' : Id Bool (LX.sortedB c') true) (hx' : Id Bool (ltN x (D0 (LX.lenL c'))) true)
          -> Id G (iota c sc x hx) (iota c' sc' x hx') =
        idJ (List X) c
          (\ c2 e2 -> (sc2 : Id Bool (LX.sortedB c2) true) (hx2 : Id Bool (ltN x (D0 (LX.lenL c2))) true)
                        -> Id G (iota c sc x hx) (iota c2 sc2 x hx2))
          (\ sc2 hx2 -> ap2 (Id Bool (LX.sortedB c) true) (Id Bool (ltN x (D0 (LX.lenL c))) true) G
                          (\ s h -> iota c s x h) sc sc2 hx hx2
                          (HB.uip (LX.sortedB c) true sc sc2) (HB.uip (ltN x (D0 (LX.lenL c))) true hx hx2))
          c' e ;

      iotaX (c : List X) (sc : Id Bool (LX.sortedB c) true) (x : N) (hx : Id Bool (ltN x (D0 (LX.lenL c))) true)
        (x' : N) (e : Id N x x') : (hx' : Id Bool (ltN x' (D0 (LX.lenL c))) true) -> Id G (iota c sc x hx) (iota c sc x' hx') =
        idJ N x (\ x2 e2 -> (hx2 : Id Bool (ltN x2 (D0 (LX.lenL c))) true) -> Id G (iota c sc x hx) (iota c sc x2 hx2))
          (\ hx2 -> ap (Id Bool (ltN x (D0 (LX.lenL c))) true) G (\ h -> iota c sc x h) hx hx2
                      (HB.uip (ltN x (D0 (LX.lenL c))) true hx hx2))
          x' e ;

      -- the comparison map D(X) -> G
      phi (d : DX.DenX) : G = iota d.1 d.2.2.1 d.2.1 d.2.2.2.1 ;

      bnd (c : List X) (v : Wd) (d : DX.DenX) (ov : LX.Over c v d.1)
        : Id Bool (ltN (sel (D1 v) d.2.1) (D0 (LX.lenL c))) true =
        subst N (\ k -> Id Bool (ltN (sel (D1 v) d.2.1) k) true) (len (D1 v)) (D0 (LX.lenL c))
          (trans N (len (D1 v)) (D0 (len v)) (D0 (LX.lenL c)) (dlen v) (ap N N D0 (len v) (LX.lenL c) ov.1))
          (sel-lt (D1 v) d.2.1 (DX.zOver c v d.1 ov d.2.1 d.2.2.2.1)) ;

      -- phi d computed through a refinement c of d.1
      via (c : List X) (sc : Id Bool (LX.sortedB c) true) (v : Wd) (d : DX.DenX) (ov : LX.Over c v d.1)
        : Id G (phi d) (iota c sc (sel (D1 v) d.2.1) (bnd c v d ov)) =
        trans G (phi d) (iota (LX.compL c v) (LX.sorted-compL c v sc) d.2.1
                          (subst (List X) (\ l -> Id Bool (ltN d.2.1 (D0 (LX.lenL l))) true) d.1 (LX.compL c v)
                             (sym (List X) (LX.compL c v) d.1 ov.2) d.2.2.2.1))
                (iota c sc (sel (D1 v) d.2.1) (bnd c v d ov))
          (iotaEq d.1 d.2.2.1 d.2.1 d.2.2.2.1 (LX.compL c v) (sym (List X) (LX.compL c v) d.1 ov.2)
             (LX.sorted-compL c v sc)
             (subst (List X) (\ l -> Id Bool (ltN d.2.1 (D0 (LX.lenL l))) true) d.1 (LX.compL c v)
                (sym (List X) (LX.compL c v) d.1 ov.2) d.2.2.2.1))
          (sym G (iota c sc (sel (D1 v) d.2.1) (bnd c v d ov))
                 (iota (LX.compL c v) (LX.sorted-compL c v sc) d.2.1
                    (subst (List X) (\ l -> Id Bool (ltN d.2.1 (D0 (LX.lenL l))) true) d.1 (LX.compL c v)
                       (sym (List X) (LX.compL c v) d.1 ov.2) d.2.2.2.1))
             (inat c sc v ov.1 d.2.1 (bnd c v d ov)
                (subst (List X) (\ l -> Id Bool (ltN d.2.1 (D0 (LX.lenL l))) true) d.1 (LX.compL c v)
                   (sym (List X) (LX.compL c v) d.1 ov.2) d.2.2.2.1))) ;

      -- phi preserves the comparison
      phi-cmp (d d' : DX.DenX) : Id O3 (cmpG (phi d) (phi d')) (DX.cmpDen d d') =
        trans O3 (cmpG (phi d) (phi d'))
                 (cmpG (iota (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1 (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1)
                          (bnd (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d'))))
                       (iota (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1 (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)
                          (bnd (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d' (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))))
                 (DX.cmpDen d d')
          (ap2 G G O3 cmpG (phi d)
             (iota (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1 (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1)
                (bnd (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d'))))
             (phi d')
             (iota (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1 (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)
                (bnd (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d' (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d'))))
             (via (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1 (LX.merge d.1 d'.1).2.1 d
                (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))
             (via (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1 (LX.merge d.1 d'.1).2.2 d'
                (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d'))))
          (imono (LX.merge d.1 d'.1).1 (DX.mOK d d').2.2.2.2.1
             (sel (D1 (LX.merge d.1 d'.1).2.1) d.2.1) (sel (D1 (LX.merge d.1 d'.1).2.2) d'.2.1)
             (bnd (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.1 d (LX.mOver1 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))
             (bnd (LX.merge d.1 d'.1).1 (LX.merge d.1 d'.1).2.2 d' (LX.mOver2 d.1 d'.1 (LX.merge d.1 d'.1) (DX.mOK d d')))) ;

      phi-inj (d d' : DX.DenX) (e : Id G (phi d) (phi d')) : Id DX.DenX d d' =
        DX.den-eq d d'
          (trans O3 (DX.cmpDen d d') (cmpG (phi d) (phi d')) eq
             (sym O3 (cmpG (phi d) (phi d')) (DX.cmpDen d d') (phi-cmp d d'))
             (trans O3 (cmpG (phi d) (phi d')) (cmpG (phi d) (phi d)) eq
                (ap G O3 (\ g -> cmpG (phi d) g) (phi d') (phi d) (sym G (phi d) (phi d') e))
                (trans O3 (cmpG (phi d) (phi d)) (DX.cmpDen d d) eq (phi-cmp d d) (DX.den-refl d)))) ;

      -- the inverse: the normal form of the point x of G(c)
      fwG (g : G) : DX.PD.Den (LX.lenL (ionto g).1) =
        DX.PD.fwd (LX.lenL (ionto g).1) ((ionto g).2.2.1, DX.PD.hzOf (LX.lenL (ionto g).1) (ionto g).2.2.1 (ionto g).2.2.2.1) ;

      psi (g : G) : DX.DenX = DX.embC (ionto g).1 (ionto g).2.1 (fwG g) ;

      xe (g : G) : Id N (sel (D1 (fwG g).1) (fwG g).2.1) (ionto g).2.2.1 =
        DX.PD.bwd-fwd (LX.lenL (ionto g).1) ((ionto g).2.2.1, DX.PD.hzOf (LX.lenL (ionto g).1) (ionto g).2.2.1 (ionto g).2.2.2.1) ;

      hsG (g : G) : Id Bool (ltN (sel (D1 (fwG g).1) (fwG g).2.1) (D0 (LX.lenL (ionto g).1))) true =
        subst N (\ k -> Id Bool (ltN k (D0 (LX.lenL (ionto g).1))) true) (ionto g).2.2.1 (sel (D1 (fwG g).1) (fwG g).2.1)
          (sym N (sel (D1 (fwG g).1) (fwG g).2.1) (ionto g).2.2.1 (xe g)) (ionto g).2.2.2.1 ;

      phi-psi (g : G) : Id G (phi (psi g)) g =
        trans G (phi (psi g)) (iota (ionto g).1 (ionto g).2.1 (sel (D1 (fwG g).1) (fwG g).2.1) (hsG g)) g
          (sym G (iota (ionto g).1 (ionto g).2.1 (sel (D1 (fwG g).1) (fwG g).2.1) (hsG g)) (phi (psi g))
             (inat (ionto g).1 (ionto g).2.1 (fwG g).1 (fwG g).2.2.1 (fwG g).2.1 (hsG g) (psi g).2.2.2.1))
          (trans G (iota (ionto g).1 (ionto g).2.1 (sel (D1 (fwG g).1) (fwG g).2.1) (hsG g))
                   (iota (ionto g).1 (ionto g).2.1 (ionto g).2.2.1 (ionto g).2.2.2.1) g
             (iotaX (ionto g).1 (ionto g).2.1 (sel (D1 (fwG g).1) (fwG g).2.1) (hsG g) (ionto g).2.2.1 (xe g) (ionto g).2.2.2.1)
             (ionto g).2.2.2.2) ;

      psi-phi (d : DX.DenX) : Id DX.DenX (psi (phi d)) d = phi-inj (psi (phi d)) d (phi-psi (phi d)) ;

      phi-equiv : isEquiv DX.DenX G phi = (psi, phi-psi, psi, psi-phi) ;

      -- Girard 8.2.6: G is the extension by denotations
      uniq : Id OrdT (DX.DenX, DX.cmpDen) (G, cmpG) = uaOrd DX.DenX G DX.cmpDen cmpG phi phi-equiv phi-cmp ;
    } ;
  } ;
} ;
