-- CJ.seg (L3, inside CB, level l): J from a contraction (model.tex §9,
-- Thm "J, strictly", the part about compositions).  A context D over G
-- (pr : D -> G) with a centre c : G -> D (pr c = id), a natural line lam z
-- in D from c (pr z) to z, and a cofibration psi on D, full at the centres,
-- on which lam z is constant at the centre.  For C over D with a
-- composition from e0 to e1 and d over G along c:
--
--   J d z    the composite along lam z from d (pr z), with the side psi z
--            given by the constant lines at d
--   beta     J d (c x) = d x: at a centre the side contains the identity
--
-- Swan's identity type (CIdJ) is the instance D = G.A.Id(a, q), c = refl.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module JC (G D : PCtx) (pr : PSub[D, G]) (c : PSub[G, D])
  (prc : (X : Ob) (x : W0.Ix (G.ob X)) -> Id (W0.Ix (G.ob X)) (pr.nt X (c.nt X x)) x)
  (lam : (X : Ob) -> W0.Ix (D.ob X) -> W0.Ix (CLine[l].FC[D].ob X))
  (lam-nat : (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X))
     -> Id (W0.Ix (CLine[l].FC[D].ob Y)) (lam Y (D.act Y X h z)) (CLine[l].FC[D].actF Y X h (lam X z)))
  (lam0 : (X : Ob) (z : W0.Ix (D.ob X)) -> Id (W0.Ix (D.ob X)) ((lam X z).1 X (idH X) (ptH X e0)) (c.nt X (pr.nt X z)))
  (lam1 : (X : Ob) (z : W0.Ix (D.ob X)) -> Id (W0.Ix (D.ob X)) ((lam X z).1 X (idH X) (ptH X e1)) z)
  (psi : (X : Ob) -> W0.Ix (D.ob X) -> Phi X)
  (psi-nat : (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) -> Id (Phi Y) (pre Y X h (psi X z)) (psi Y (D.act Y X h z)))
  (psi-c : (X : Ob) (x : W0.Ix (G.ob X)) -> Lands X X (psi X (c.nt X x)) (idH X))
  (lam-c : (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (i : Lands W X (psi X z) f) (j : Hom W Iv)
     -> Id (W0.Ix (D.ob W)) ((lam X z).1 W f j) (c.nt W (pr.nt W (D.act W X f z))))
  (C : PTy[D]) (cC : CLine[l].Lines[D, C].CompK[e0, e1].Comp)
  (d : PEl[G, subTy G D C c]) {
  module FD = CLine[l].FC[D] ;
  module FA = CLine[l].FT[D, C] ;
  module CK = CLine[l].Lines[D, C].CompK[e0, e1] ;
  module EK = CK.EK ;
  module EK' = CLine[l].EndKit[D, C, e1] ;
  module EV = FA.Ev[e0] ;
  module EV' = FA.Ev[e1] ;
  module TC = GPR.TyL[D, C] ;
  module TV = EK.TV ;
  module TS = EK.TS ;
  module PT = EK.PT ;
  module TT = GPR.TyL[TV.E, CK.Tend] ;
  module RC = CPartial[l].Rel[TV.E, EK.SFm.SF, CK.Tend, CK.endL] ;

  ----------------------------------------------------------------------
  -- d at the centre, read in E

  dE (X : Ob) (x : W0.Ix (G.ob X)) : TC.EI X = (c.nt X x, d.eob X x) ;

  dE-act (Y X : Ob) (h : Hom Y X) (x : W0.Ix (G.ob X)) : Id (TC.EI Y) (TC.E.act Y X h (dE X x)) (dE Y (G.act Y X h x)) =
    transH (TC.pr-tact Y X h (c.nt X x) (c.nt Y (G.act Y X h x)) (ntEq G D c Y X h x (G.act Y X h x) (refl (G.act Y X h x))) (d.eob X x))
      (apH {W0.Ix (C.tob Y (c.nt Y (G.act Y X h x)))} {TC.EI Y} (\ v -> (c.nt Y (G.act Y X h x), v))
         (d.enat Y X h x (G.act Y X h x) (refl (G.act Y X h x)))) ;

  -- the centre of z restricted along f
  pr-act (V W X : Ob) (g : Hom V W) (f : Hom W X) (z : W0.Ix (D.ob X))
    : Id (W0.Ix (G.ob V)) (G.act V W g (pr.nt W (D.act W X f z))) (pr.nt V (D.act V X (compH V W X f g) z)) =
    transH (symH (pr.nt-nat V W g (D.act W X f z))) (apH (pr.nt V) (symH (D.act-o V W X f g z))) ;

  dz (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) : TC.EI W = dE W (pr.nt W (D.act W X f z)) ;

  dz-act (X : Ob) (z : W0.Ix (D.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X)
    : Id (TC.EI V) (TC.E.act V W g (dz X z W f)) (dz X z V (compH V W X f g)) =
    transH (dE-act V W g (pr.nt W (D.act W X f z))) (apH (dE V) (pr-act V W X g f z)) ;

  ----------------------------------------------------------------------
  -- the problem at z: the start and the side

  start (X : Ob) (z : W0.Ix (D.ob X)) : TV.EI X =
    (lam X z, TC.coeT X (c.nt X (pr.nt X z)) ((lam X z).1 X (idH X) (ptH X e0)) (symH (lam0 X z)) (d.eob X (pr.nt X z))) ;

  start-E (X : Ob) (z : W0.Ix (D.ob X)) : Id (TC.EI X) (EK.endE X (start X z)) (dE X (pr.nt X z)) =
    symH (TC.pr-coe X (c.nt X (pr.nt X z)) ((lam X z).1 X (idH X) (ptH X e0)) (symH (lam0 X z)) (d.eob X (pr.nt X z))) ;

  -- the end of the restricted start, read in E
  startAct-E (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X)
    : Id (TC.EI W) (EK.endE W (TV.E.act W X f (start X z))) (dz X z W f) =
    transH (EK.endE-act W X f (start X z))
     (transH (apH (TC.E.act W X f) (start-E X z))
      (transH (dE-act W X f (pr.nt X z)) (apH (dE W) (symH (pr.nt-nat W X f z))))) ;

  module Sd (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (i : Lands W X (psi X z) f) {
    t (W' : Ob) (g : Hom W' W) (j : Hom W' Iv) : TC.EI W' = dz X z W' (compH W' W X f g) ;

    tp (W' : Ob) (g : Hom W' W) (j : Hom W' Iv) : Id (W0.Ix (D.ob W')) (t W' g j).1 ((FD.actF W X f (lam X z)).1 W' g j) =
      symH (lam-c X z W' (compH W' W X f g) (lands-comp W' W X (psi X z) f g i) j) ;

    tn (V W' : Ob) (g : Hom V W') (g' : Hom W' W) (j : Hom W' Iv)
      : Id (TC.EI V) (TC.E.act V W' g (t W' g' j)) (t V (compH V W' W g' g) (compH V W' Iv j g)) =
      transH (dz-act X z V W' g (compH W' W X f g')) (apH (dz X z V) (comp-assoc V W' W X f g' g)) ;

    -- the constant line at d, over the restricted line
    L : EK.TL.EI W = (FD.actF W X f (lam X z), FA.lamA W (FD.actF W X f (lam X z)) t tp tn) ;

    q : Id (TC.EI W) (EK.endE W (EV.evA.mE W L)) (EK.endE W (TV.E.act W X f (start X z))) =
      transH (EV.endB-E W L)
        (transH (apH (dz X z W) (comp-idr W X f)) (symH (startAct-E X z W f))) ;

    v : TS.EI W = EK.mkTS W (TV.E.act W X f (start X z)) L (refl (FD.actF W X f (lam X z))) q ;
  } ;

  sideV (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (i : Lands W X (psi X z) f) : TS.EI W = Sd[X, z, W, f, i].v ;

  side (X : Ob) (z : W0.Ix (D.ob X)) : PT.Side[X, start X z] =
    new PT.Side[X, start X z, psi X z, sideV X z,
      \ W f i -> EK.mkTS-pt W (TV.E.act W X f (start X z)) Sd[X, z, W, f, i].L (refl (FD.actF W X f (lam X z))) Sd[X, z, W, f, i].q,
      \ W' W chi f i i' ->
        EK.mkTS-act W' W chi (TV.E.act W X f (start X z)) Sd[X, z, W, f, i].L (refl (FD.actF W X f (lam X z))) Sd[X, z, W, f, i].q
          (TV.E.act W' X (compH W' W X f chi) (start X z)) Sd[X, z, W', compH W' W X f chi, i'].L
          (refl (FD.actF W' X (compH W' W X f chi) (lam X z))) Sd[X, z, W', compH W' W X f chi, i'].q
          (symH (TV.E.act-o W' W X f chi (start X z)))
          (\ V'' f'' j -> apH (dz X z V'') (symH (comp-assoc V'' W' W X f chi f'')))] ;

  ----------------------------------------------------------------------
  -- the problem is uniform

  pt (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) : Id (TV.EI Y) (TV.E.act Y X h (start X z)) (start Y (D.act Y X h z)) =
    EK.tv-eq Y (TV.E.act Y X h (start X z)) (start Y (D.act Y X h z)) (symH (lam-nat Y X h z))
      (transH (startAct-E X z Y h) (symH (start-E Y (D.act Y X h z)))) ;

  sd-eq (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X))
    : Id (PT.Side[Y, start Y (D.act Y X h z)])
         (subst (TV.EI Y) (\ w -> PT.Side[Y, w]) (TV.E.act Y X h (start X z)) (start Y (D.act Y X h z)) (pt Y X h z)
            (PT.rside Y X h (start X z) (side X z)))
         (side Y (D.act Y X h z)) =
    PT.side-extH Y (TV.E.act Y X h (start X z)) (start Y (D.act Y X h z)) (pt Y X h z)
      (PT.rside Y X h (start X z) (side X z)) (side Y (D.act Y X h z))
      (psi-nat Y X h z)
      (\ W g i i' ->
         EK.mkTS-eq W (TV.E.act W X (compH W Y X h g) (start X z)) (TV.E.act W Y g (start Y (D.act Y X h z)))
           Sd[X, z, W, compH W Y X h g, lands-pre W Y X h (psi X z) g i].L Sd[Y, D.act Y X h z, W, g, i'].L
           (refl (FD.actF W X (compH W Y X h g) (lam X z))) Sd[X, z, W, compH W Y X h g, lands-pre W Y X h (psi X z) g i].q
           (refl (FD.actF W Y g (lam Y (D.act Y X h z)))) Sd[Y, D.act Y X h z, W, g, i'].q
           (transH (TV.E.act-o W Y X h g (start X z)) (apH (TV.E.act W Y g) (pt Y X h z)))
           (\ V'' f j -> apH (\ k -> dE V'' (pr.nt V'' k))
              (transH (apH (\ k -> D.act V'' X k z) (comp-assoc V'' W Y X h g f)) (D.act-o V'' Y X h (compH V'' W Y g f) z)))) ;

  ----------------------------------------------------------------------
  -- the composite, read in E

  out (X : Ob) (z : W0.Ix (D.ob X)) : TT.EI X = (start X z, cC.kop X (start X z) (side X z)) ;

  rd (V : Ob) (u : TT.EI V) : TC.EI V = EK'.endE V (CK.SE.mV V u) ;

  rd-act (V' V : Ob) (g : Hom V' V) (u : TT.EI V) : Id (TC.EI V') (rd V' (TT.E.act V' V g u)) (TC.E.act V' V g (rd V u)) =
    transH (apH (EK'.endE V') (symH (CK.SE.mV-nat V' V g u))) (EK'.endE-act V' V g (CK.SE.mV V u)) ;

  outU (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) : Id (TT.EI Y) (TT.E.act Y X h (out X z)) (out Y (D.act Y X h z)) =
    transH (cC.kunif Y X h (start X z) (side X z))
      (RC.kop-cong cC Y (TV.E.act Y X h (start X z)) (start Y (D.act Y X h z)) (pt Y X h z)
         (PT.rside Y X h (start X z) (side X z)) (side Y (D.act Y X h z)) (sd-eq Y X h z)) ;

  -- the point of the composite is z
  rd-pt (X : Ob) (z : W0.Ix (D.ob X)) : Id (W0.Ix (D.ob X)) (rd X (out X z)).1 z = lam1 X z ;

  ----------------------------------------------------------------------
  -- J

  jv (X : Ob) (z : W0.Ix (D.ob X)) : TC.T X z = TC.fromE X z (rd X (out X z)) (rd-pt X z) ;

  jv-E (X : Ob) (z : W0.Ix (D.ob X)) : Id (TC.EI X) (z, jv X z) (rd X (out X z)) = TC.fromE-eq X z (rd X (out X z)) (rd-pt X z) ;

  jnat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) (z' : W0.Ix (D.ob Y)) (e : Id (W0.Ix (D.ob Y)) (D.act Y X h z) z')
    : Id (TC.T Y z') (C.tact Y X h z z' e (jv X z)) (jv Y z') =
    TC.pr-inj Y z' (C.tact Y X h z z' e (jv X z)) (jv Y z')
      (calc (TC.EI Y) {
          (z', C.tact Y X h z z' e (jv X z))
        =< symH (TC.pr-tact Y X h z z' e (jv X z)) >
          TC.E.act Y X h (z, jv X z)
        =< apH (TC.E.act Y X h) (jv-E X z) >
          TC.E.act Y X h (rd X (out X z))
        =< symH (rd-act Y X h (out X z)) >
          rd Y (TT.E.act Y X h (out X z))
        =< apH (rd Y) (outU Y X h z) >
          rd Y (out Y (D.act Y X h z))
        =< symH (jv-E Y (D.act Y X h z)) >
          (D.act Y X h z, jv Y (D.act Y X h z))
        =< apH (\ w -> (w, jv Y w)) e >
          (z', jv Y z') }) ;

  J : PEl[D, C] = new PEl[D, C, jv, jnat] ;

  ----------------------------------------------------------------------
  -- the computation rule: at a centre the side contains the identity

  beta-E (X : Ob) (x : W0.Ix (G.ob X)) : Id (TC.EI X) (rd X (out X (c.nt X x))) (dE X x) =
    calc (TC.EI X) {
        rd X (out X (c.nt X x))
      =< apH (rd X) (RC.kfull cC X (start X (c.nt X x)) (side X (c.nt X x)) (psi-c X x)) >
        rd X (CK.endL.mE X (sideV X (c.nt X x) X (idH X) (psi-c X x)))
      =< EV'.endB-E X (EK.lineL X (sideV X (c.nt X x) X (idH X) (psi-c X x))) >
        (EK.lineL X (sideV X (c.nt X x) X (idH X) (psi-c X x))).2.1.1 X (idH X) (ptH X e1)
      =< apH (\ L -> L.2.1.1 X (idH X) (ptH X e1))
           (EK.mkTS-line X (TV.E.act X X (idH X) (start X (c.nt X x))) Sd[X, c.nt X x, X, idH X, psi-c X x].L
              (refl (FD.actF X X (idH X) (lam X (c.nt X x)))) Sd[X, c.nt X x, X, idH X, psi-c X x].q) >
        dz X (c.nt X x) X (compH X X X (idH X) (idH X))
      =< apH (\ w -> dE X (pr.nt X w)) (transH (apH (\ k -> D.act X X k (c.nt X x)) (comp-idl X X (idH X))) (D.act-id X (c.nt X x))) >
        dE X (pr.nt X (c.nt X x))
      =< apH (dE X) (prc X x) >
        dE X x } ;

  beta (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (C.tob X (c.nt X x))) (J.eob X (c.nt X x)) (d.eob X x) =
    TC.pr-inj X (c.nt X x) (jv X (c.nt X x)) (d.eob X x) (transH (jv-E X (c.nt X x)) (beta-E X x)) ;
} ;
