-- The lower universe as a type in the code-map CwF.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module N = CDName[a] ;
module K = CDCodeContext[a] ;
module C = K.C ;
module O = K.Ops ;
module X = CDUniverseLift[a] ;
module U0 = N.B.DC.DU ;
module W = V[a+] ;
module P = N.P ;
open P.PS ;

module Univ (fibU : N.Fib nilP (U0.UTy nilP)) {
  Uconst : C.C.Ty nilP = N.name nilP (U0.UTy nilP) fibU ;

  universe (G : PCtx) : C.C.Ty G = C.C.subT G nilP Uconst (epsP G) ;

  univ-nat (D G : PCtx) (s : PSub[D, G])
    : Id (C.C.Ty D) (C.C.subT D G (universe G) s) (universe D) =
    C.C.ty-ext D _ _ (\ I x -> refl ((universe D).1 I x)) ;

  module Read (G : PCtx) {
    A : PTy[G] = C.decode G (universe G) ;
    B : PTy[G] = U0.UTy G ;
    module E = N.CDNameDecode.Read[nilP, U0.UTy nilP, N.horn nilP (U0.UTy nilP) fibU] ;

    constant : Id (PTy[G]) (subTy G nilP (U0.UTy nilP) (epsP G)) B =
      ty-ext G B.tob
        (subTy G nilP (U0.UTy nilP) (epsP G)).tact B.tact
        (subTy G nilP (U0.UTy nilP) (epsP G)).tact-id B.tact-id
        (subTy G nilP (U0.UTy nilP) (epsP G)).tact-o B.tact-o
        (\ J I f x y e z -> refl (U0.uAct J I f z)) ;

    path : Id (PTy[G]) A B =
      transH (symH (C.decode-sub G nilP Uconst (epsP G)))
        (transH (apH (\ T -> subTy G nilP T (epsP G)) E.law) constant) ;

    Lower : U a+ = PEl[G, B] ;
    Upper : U a+ = O.El G (universe G) ;

    up (b : Lower) : Upper = subst (PTy[G]) (\ T -> PEl[G, T]) B A (symH path) b ;
    down (b : Upper) : Lower = subst (PTy[G]) (\ T -> PEl[G, T]) A B path b ;

    down-values (b : Upper) : Id (elObs G B.tob) (down b).eob b.eob =
      tob-same G (\ T -> PEl[G, T]) (\ e -> elObs G e) (\ T u -> u.eob) A B path (refl B.tob) b ;

    up-values (b : Lower) : Id (elObs G A.tob) (up b).eob b.eob =
      tob-same G (\ T -> PEl[G, T]) (\ e -> elObs G e) (\ T u -> u.eob) B A (symH path) (refl B.tob) b ;

    -- Sections of the constant universe type are maps into its context.
    as-map (b : Lower) : PSub[G, U0.UCtx] =
      new PSub[G, U0.UCtx, b.eob, \ J I f x -> symH (b.enat J I f x (G.act J I f x) (refl (G.act J I f x)))] ;

    as-section (h : PSub[G, U0.UCtx]) : Lower =
      new PEl[G, B, h.nt, \ J I f x y e -> transH (symH (h.nt-nat J I f x)) (apH (h.nt J) e)] ;

    code (b : Upper) : PSub[G, U0.UCtx] = as-map (down b) ;
    section (h : PSub[G, U0.UCtx]) : Upper = up (as-section h) ;

    section-point (h : PSub[G, U0.UCtx]) (I : Nat) (x : W.Ix (G.ob I))
      : Id (U0.U0 I) ((section h).eob I x) (h.nt I x) =
      apH (\ t -> t I x) (up-values (as-section h)) ;

    code-point (b : Upper) (I : Nat) (x : W.Ix (G.ob I)) : Id (U0.U0 I) ((code b).nt I x) (b.eob I x) =
      apH (\ t -> t I x) (down-values b) ;

    opaque path ; opaque code-point ; opaque section-point ;
  } ;

  -- T is postcomposition with the inclusion of codes.
  lift-code (G : PCtx) (h : PSub[G, U0.UCtx]) : C.C.Ty G =
    (\ I x -> X.inc I (h.nt I x), \ J I f x ->
      transH (apH (X.inc J) (h.nt-nat J I f x)) (X.include-nat J I f (h.nt I x))) ;

  decode (G : PCtx) (a0 : O.El G (universe G)) : C.C.Ty G =
    lift-code G (Read[G].code a0) ;

  decode-inj (G : PCtx) (a0 b : O.El G (universe G)) (q : Id (C.C.Ty G) (decode G a0) (decode G b))
    : Id (O.El G (universe G)) a0 b =
    el-ext G (C.decode G (universe G)) a0 b (\ I x -> transH (symH (Read[G].code-point a0 I x))
      (transH (X.include-inj I ((Read[G].code a0).nt I x) ((Read[G].code b).nt I x)
        (apH (\ d -> d.1 I x) q)) (Read[G].code-point b I x))) ;

  import CDCodeUniverseSub ;
} ;
