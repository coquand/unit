-- CHtpyOps.seg (L3, inside CB, level l): homotopies between maps of types
-- and their operations (localisation.tex §5).  A homotopy between al, be :
-- A -> B over G is an element of the path type over G.A: at (x , a) a path
-- in B over the constant line at x from al(a) to be(a) (CPath.PathOverE).
--
--   NMap, compN, idN   maps of types over G, composite, identity
--   HT                 the type of homotopies; pv its values, pv-res
--   Ret                retarget along pointwise equal maps
--   WL, WR             whiskering by a map on the left, on the right
--   Rf                 the constant homotopy al ~ al
--   TP                 a path from aK to bK moved along a line of the
--                      context G.A.B (CPathComp), the B-end moving along a
--                      homotopy: Inv, Cat below, for B with a composition

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[l] ;
open GPR.PS ;

module NMap (G : PCtx) (A B : PTy[G]) {
  nfun (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x)) : W0.Ix (B.tob I x) ;
  nnat (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y)
    (a0 : W0.Ix (A.tob I x)) : Id (W0.Ix (B.tob J y)) (B.tact J I f x y e (nfun I x a0)) (nfun J y (A.tact J I f x y e a0)) ;
} ;

compN (G : PCtx) (A B C : PTy[G]) (al : NMap[G, A, B]) (be : NMap[G, B, C]) : NMap[G, A, C] =
  new NMap[G, A, C, \ I x a0 -> be.nfun I x (al.nfun I x a0),
    \ J I f x y e a0 -> transH (be.nnat J I f x y e (al.nfun I x a0)) (apH (be.nfun J y) (al.nnat J I f x y e a0))] ;

idN (G : PCtx) (A : PTy[G]) : NMap[G, A, A] = new NMap[G, A, A, \ I x a0 -> a0, \ J I f x y e a0 -> refl (A.tact J I f x y e a0)] ;

------------------------------------------------------------------------
-- the type of homotopies

module HT (G : PCtx) (A B : PTy[G]) (al be : NMap[G, A, B]) {
  module TB = GPR.TyL[G, B] ;
  GA : PCtx = extP G A ;

  -- the constant line at x
  s (X : Ob) (z : W0.Ix (GA.ob X)) (V : Ob) (f : Hom V X) (i : Hom V Iv) : W0.Ix (G.ob V) = G.act V X f z.1 ;

  sN (J I : Ob) (h : Hom J I) (z : W0.Ix (GA.ob I)) (z' : W0.Ix (GA.ob J)) (e : Id (W0.Ix (GA.ob J)) (GA.act J I h z) z')
    (V : Ob) (f : Hom V J) (i : Hom V Iv) : Id (W0.Ix (G.ob V)) (s I z V (compH V J I h f) i) (s J z' V f i) =
    transH (G.act-o V J I h f z.1) (apH (\ y -> G.act V J f y.1) e) ;

  aE (V : Ob) (z : W0.Ix (GA.ob V)) : TB.EI V = (z.1, al.nfun V z.1 z.2) ;
  bE (V : Ob) (z : W0.Ix (GA.ob V)) : TB.EI V = (z.1, be.nfun V z.1 z.2) ;

  aE-act (V X : Ob) (f : Hom V X) (z : W0.Ix (GA.ob X)) : Id (TB.EI V) (TB.E.act V X f (aE X z)) (aE V (GA.act V X f z)) =
    transH (TB.pr-tact V X f z.1 (G.act V X f z.1) (refl (G.act V X f z.1)) (al.nfun X z.1 z.2))
      (apH {W0.Ix (B.tob V (G.act V X f z.1))} {TB.EI V} (\ v -> (G.act V X f z.1, v))
         (al.nnat V X f z.1 (G.act V X f z.1) (refl (G.act V X f z.1)) z.2)) ;
  bE-act (V X : Ob) (f : Hom V X) (z : W0.Ix (GA.ob X)) : Id (TB.EI V) (TB.E.act V X f (bE X z)) (bE V (GA.act V X f z)) =
    transH (TB.pr-tact V X f z.1 (G.act V X f z.1) (refl (G.act V X f z.1)) (be.nfun X z.1 z.2))
      (apH {W0.Ix (B.tob V (G.act V X f z.1))} {TB.EI V} (\ v -> (G.act V X f z.1, v))
         (be.nnat V X f z.1 (G.act V X f z.1) (refl (G.act V X f z.1)) z.2)) ;

  module PT = CPath[l].PathOverE[GA, G, B, true, s, sN, aE, bE, aE-act, bE-act] ;

  -- the values of a homotopy, and at a restricted point
  pv (H : PEl[GA, PT.PathP]) (X : Ob) (z : W0.Ix (GA.ob X)) (V : Ob) (g : Hom V X) (j : Hom V Iv) : TB.EI V = (H.eob X z).1.1 V g j ;

  pv-res (H : PEl[GA, PT.PathP]) (m n : Ob) (k : Hom m n) (z : W0.Ix (GA.ob n)) (z' : W0.Ix (GA.ob m))
    (e : Id (W0.Ix (GA.ob m)) (GA.act m n k z) z') (V : Ob) (g : Hom V m) (j : Hom V Iv)
    : Id (TB.EI V) (pv H n z V (compH V m n k g) j) (pv H m z' V g j) =
    apH (\ Q -> Q.1.1 V g j) (H.enat m n k z z' e) ;

  opaque aE-act ; opaque bE-act ;
} ;

------------------------------------------------------------------------
-- retarget along pointwise equal maps

module Ret (G : PCtx) (A B : PTy[G]) (al be al' be' : NMap[G, A, B])
  (pa : (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x)) -> Id (W0.Ix (B.tob I x)) (al'.nfun I x a0) (al.nfun I x a0))
  (pb : (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x)) -> Id (W0.Ix (B.tob I x)) (be'.nfun I x a0) (be.nfun I x a0))
  (H : PEl[extP G A, HT[G, A, B, al, be].PT.PathP]) {
  module T = HT[G, A, B, al, be] ;
  module T' = HT[G, A, B, al', be'] ;

  path (X : Ob) (z : W0.Ix (T.GA.ob X)) : W0.Ix (T'.PT.tobP X z) =
    T'.PT.mkPath X z (\ V f i -> T.pv H X z V f i) (H.eob X z).1.2 (H.eob X z).2.1
      (transH (H.eob X z).2.2.1 (apH {W0.Ix (B.tob X z.1)} {T.TB.EI X} (\ v -> (z.1, v)) (symH (pa X z.1 z.2))))
      (transH (H.eob X z).2.2.2 (apH {W0.Ix (B.tob X z.1)} {T.TB.EI X} (\ v -> (z.1, v)) (symH (pb X z.1 z.2)))) ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (T.GA.ob I)) (z' : W0.Ix (T.GA.ob J)) (e : Id (W0.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (W0.Ix (T'.PT.tobP J z')) (T'.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T'.PT.path-eq J z' (T'.PT.PathP.tact J I h z z' e (path I z)) (path J z') (\ V f i -> T.pv-res H J I h z z' e V f i) ;

  opaque enat ;

  res : PEl[T'.GA, T'.PT.PathP] = new PEl[T'.GA, T'.PT.PathP, path, enat] ;
} ;

------------------------------------------------------------------------
-- left whiskering

module WL (G : PCtx) (A B C : PTy[G]) (al be : NMap[G, A, B]) (de : NMap[G, B, C])
  (H : PEl[extP G A, HT[G, A, B, al, be].PT.PathP]) {
  module T = HT[G, A, B, al, be] ;
  module T' = HT[G, A, C, compN G A B C al de, compN G A B C be de] ;
  module TB = GPR.TyL[G, B] ;
  module TC = GPR.TyL[G, C] ;

  dE (V : Ob) (w : TB.EI V) : TC.EI V = (w.1, de.nfun V w.1 w.2) ;

  dE-act (V Y : Ob) (g : Hom V Y) (w : TB.EI Y) : Id (TC.EI V) (TC.E.act V Y g (dE Y w)) (dE V (TB.E.act V Y g w)) =
    transH (TC.pr-tact V Y g w.1 (G.act V Y g w.1) (refl (G.act V Y g w.1)) (de.nfun Y w.1 w.2))
      (apH {W0.Ix (C.tob V (G.act V Y g w.1))} {TC.EI V} (\ v -> (G.act V Y g w.1, v))
         (de.nnat V Y g w.1 (G.act V Y g w.1) (refl (G.act V Y g w.1)) w.2)) ;

  path (X : Ob) (z : W0.Ix (T.GA.ob X)) : W0.Ix (T'.PT.tobP X z) =
    T'.PT.mkPath X z (\ V f i -> dE V (T.pv H X z V f i))
      (\ V' V g f i -> transH (dE-act V' V g (T.pv H X z V f i)) (apH (dE V') ((H.eob X z).1.2 V' V g f i)))
      (H.eob X z).2.1 (apH (dE X) (H.eob X z).2.2.1) (apH (dE X) (H.eob X z).2.2.2) ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (T.GA.ob I)) (z' : W0.Ix (T.GA.ob J)) (e : Id (W0.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (W0.Ix (T'.PT.tobP J z')) (T'.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T'.PT.path-eq J z' (T'.PT.PathP.tact J I h z z' e (path I z)) (path J z') (\ V f i -> apH (dE V) (T.pv-res H J I h z z' e V f i)) ;

  opaque dE-act ; opaque enat ;

  res : PEl[T'.GA, T'.PT.PathP] = new PEl[T'.GA, T'.PT.PathP, path, enat] ;
} ;

------------------------------------------------------------------------
-- right whiskering

module WR (G : PCtx) (A B C : PTy[G]) (al be : NMap[G, A, B]) (ga : NMap[G, C, A])
  (H : PEl[extP G A, HT[G, A, B, al, be].PT.PathP]) {
  module T = HT[G, A, B, al, be] ;
  module T' = HT[G, C, B, compN G C A B ga al, compN G C A B ga be] ;

  zA (X : Ob) (z : W0.Ix (T'.GA.ob X)) : W0.Ix (T.GA.ob X) = (z.1, ga.nfun X z.1 z.2) ;

  zA-act (J I : Ob) (h : Hom J I) (z : W0.Ix (T'.GA.ob I)) : Id (W0.Ix (T.GA.ob J)) (T.GA.act J I h (zA I z)) (zA J (T'.GA.act J I h z)) =
    apH {W0.Ix (A.tob J (G.act J I h z.1))} {W0.Ix (T.GA.ob J)} (\ v -> (G.act J I h z.1, v))
      (ga.nnat J I h z.1 (G.act J I h z.1) (refl (G.act J I h z.1)) z.2) ;

  path (X : Ob) (z : W0.Ix (T'.GA.ob X)) : W0.Ix (T'.PT.tobP X z) =
    T'.PT.mkPath X z (\ V f i -> T.pv H X (zA X z) V f i) (H.eob X (zA X z)).1.2 (H.eob X (zA X z)).2.1
      (H.eob X (zA X z)).2.2.1 (H.eob X (zA X z)).2.2.2 ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (T'.GA.ob I)) (z' : W0.Ix (T'.GA.ob J)) (e : Id (W0.Ix (T'.GA.ob J)) (T'.GA.act J I h z) z')
    : Id (W0.Ix (T'.PT.tobP J z')) (T'.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T'.PT.path-eq J z' (T'.PT.PathP.tact J I h z z' e (path I z)) (path J z')
      (\ V f i -> T.pv-res H J I h (zA I z) (zA J z') (transH (zA-act J I h z) (apH (zA J) e)) V f i) ;

  opaque zA-act ; opaque enat ;

  res : PEl[T'.GA, T'.PT.PathP] = new PEl[T'.GA, T'.PT.PathP, path, enat] ;
} ;

------------------------------------------------------------------------
-- the constant homotopy

module Rf (G : PCtx) (A B : PTy[G]) (al : NMap[G, A, B]) {
  module T = HT[G, A, B, al, al] ;
  module EL = GPR.PshL[T.TB.E] ;

  path (X : Ob) (z : W0.Ix (T.GA.ob X)) : W0.Ix (T.PT.tobP X z) =
    T.PT.mkPath X z (\ V f i -> T.TB.E.act V X f (T.aE X z))
      (\ V' V g f i -> EL.actC V' V X f g (T.aE X z))
      (\ V f i -> refl (G.act V X f z.1))
      (EL.actId X (idH X) (refl (idH X)) (T.aE X z)) (EL.actId X (idH X) (refl (idH X)) (T.aE X z)) ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (T.GA.ob I)) (z' : W0.Ix (T.GA.ob J)) (e : Id (W0.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' e (path I z)) (path J z')
      (\ V f i -> transH (symH (EL.actC V J I h f (T.aE I z)))
                   (apH (T.TB.E.act V J f) (transH (T.aE-act J I h z) (apH (T.aE J) e)))) ;

  opaque enat ;

  res : PEl[T.GA, T.PT.PathP] = new PEl[T.GA, T.PT.PathP, path, enat] ;
} ;

------------------------------------------------------------------------
-- moving a path along a homotopy of its moving end
--
-- K = G.A.B (B pulled back to G.A); at k = (z , b) a path in B over the
-- constant line at z.1 from aK k to bK k (one of them moves with b).  A
-- homotopy H2 : be ~ ga gives the line (f , j) |-> (z f , H2(z)(f , j)) of
-- K, from (z , be z) to (z , ga z); the composite of the path type along it
-- (CPathComp, empty side) moves a path at the start to one at the end.

module TP (G : PCtx) (A B : PTy[G]) (be ga : NMap[G, A, B])
  (H2 : PEl[extP G A, HT[G, A, B, be, ga].PT.PathP])
  (aK bK : (W : Ob) -> W0.Ix ((extP (extP G A) (subTy (extP G A) G B (pP G A))).ob W) -> GPR.TyL[G, B].EI W)
  (aK-act : (W X : Ob) (f : Hom W X) (k : W0.Ix ((extP (extP G A) (subTy (extP G A) G B (pP G A))).ob X))
     -> Id (GPR.TyL[G, B].EI W) (GPR.TyL[G, B].E.act W X f (aK X k)) (aK W ((extP (extP G A) (subTy (extP G A) G B (pP G A))).act W X f k)))
  (bK-act : (W X : Ob) (f : Hom W X) (k : W0.Ix ((extP (extP G A) (subTy (extP G A) G B (pP G A))).ob X))
     -> Id (GPR.TyL[G, B].EI W) (GPR.TyL[G, B].E.act W X f (bK X k)) (bK W ((extP (extP G A) (subTy (extP G A) G B (pP G A))).act W X f k)))
  (aK-pt : (W : Ob) (k : W0.Ix ((extP (extP G A) (subTy (extP G A) G B (pP G A))).ob W))
     -> Id (W0.Ix (G.ob W)) (aK W k).1 (G.act W W (idH W) k.1.1))
  (bK-pt : (W : Ob) (k : W0.Ix ((extP (extP G A) (subTy (extP G A) G B (pP G A))).ob W))
     -> Id (W0.Ix (G.ob W)) (bK W k).1 (G.act W W (idH W) k.1.1))
  (cB : CLine[l].Lines[G, B].CompK[e0, e1].Comp) {
  GA : PCtx = extP G A ;
  B' : PTy[GA] = subTy GA G B (pP G A) ;
  K : PCtx = extP GA B' ;
  module TB = GPR.TyL[G, B] ;
  module T2 = HT[G, A, B, be, ga] ;
  module GAL = GPR.PshL[GA] ;

  sK (X : Ob) (k : W0.Ix (K.ob X)) (V : Ob) (f : Hom V X) (i : Hom V Iv) : W0.Ix (G.ob V) = G.act V X f k.1.1 ;

  sKN (J I : Ob) (h : Hom J I) (k : W0.Ix (K.ob I)) (k' : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h k) k')
    (V : Ob) (f : Hom V J) (i : Hom V Iv) : Id (W0.Ix (G.ob V)) (sK I k V (compH V J I h f) i) (sK J k' V f i) =
    transH (G.act-o V J I h f k.1.1) (apH (\ y -> G.act V J f y.1.1) e) ;

  sKF (X : Ob) (k : W0.Ix (K.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (G.ob V)) (G.act V W g (sK X k W f i)) (sK X k V (compH V W X f g) (compH V W Iv i g)) =
    symH (G.act-o V W X f g k.1.1) ;

  module PC = CPathComp[l].PathC[K, G, B, true, sK, sKN, sKF, aK, bK, aK-act, bK-act, aK-pt, bK-pt, e0, e1, cB] ;
  module PT = PC.PT ;
  module CP = PC.CP ;

  -- points of K are read in the total of B
  kE (W : Ob) (k : W0.Ix (K.ob W)) : TB.EI W = (k.1.1, k.2) ;

  kEq (W : Ob) (k k' : W0.Ix (K.ob W)) (P : Id (W0.Ix (GA.ob W)) k.1 k'.1) (Q : Id (TB.EI W) (kE W k) (kE W k')) : Id (W0.Ix (K.ob W)) k k' =
    idJ (W0.Ix (GA.ob W)) k.1
      (\ z2 P2 -> (b2 : W0.Ix (B.tob W z2.1)) -> Id (TB.EI W) (kE W k) (z2.1, b2) -> Id (W0.Ix (K.ob W)) k (z2, b2))
      (\ b2 Q2 -> apH {W0.Ix (B.tob W k.1.1)} {W0.Ix (K.ob W)} (\ b3 -> (k.1, b3)) (TB.pr-inj W k.1.1 k.2 b2 Q2))
      k'.1 P k'.2 Q ;

  kE-act (V W : Ob) (g : Hom V W) (k : W0.Ix (K.ob W)) : Id (TB.EI V) (kE V (K.act V W g k)) (TB.E.act V W g (kE W k)) =
    symH (TB.pr-tact V W g k.1.1 (G.act V W g k.1.1) (ntEq GA G (pP G A) V W g k.1 (GA.act V W g k.1) (refl (GA.act V W g k.1))) k.2) ;

  ----------------------------------------------------------------------
  -- the line of K at (X , z)

  bL (X : Ob) (z : W0.Ix (GA.ob X)) (W : Ob) (f : Hom W X) (j : Hom W Iv) : W0.Ix (B.tob W (G.act W X f z.1)) =
    TB.fromE W (G.act W X f z.1) (T2.pv H2 X z W f j) ((H2.eob X z).2.1 W f j) ;

  kL (X : Ob) (z : W0.Ix (GA.ob X)) (W : Ob) (f : Hom W X) (j : Hom W Iv) : W0.Ix (K.ob W) = (GA.act W X f z, bL X z W f j) ;

  kL-E (X : Ob) (z : W0.Ix (GA.ob X)) (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (TB.EI W) (kE W (kL X z W f j)) (T2.pv H2 X z W f j) =
    TB.fromE-eq W (G.act W X f z.1) (T2.pv H2 X z W f j) ((H2.eob X z).2.1 W f j) ;

  kL-nat (X : Ob) (z : W0.Ix (GA.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
    : Id (W0.Ix (K.ob V)) (K.act V W g (kL X z W f j)) (kL X z V (compH V W X f g) (compH V W Iv j g)) =
    kEq V (K.act V W g (kL X z W f j)) (kL X z V (compH V W X f g) (compH V W Iv j g)) (GAL.actC V W X f g z)
      (transH (kE-act V W g (kL X z W f j))
        (transH (apH (TB.E.act V W g) (kL-E X z W f j))
          (transH ((H2.eob X z).1.2 V W g f j) (symH (kL-E X z V (compH V W X f g) (compH V W Iv j g)))))) ;

  L (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (CLine[l].FC[K].ob X) = (kL X z, kL-nat X z) ;

  k0 (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (K.ob X) = kL X z X (idH X) (ptH X e0) ;
  k1 (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (K.ob X) = kL X z X (idH X) (ptH X e1) ;

  -- the line at a restricted point is the restricted line
  kL-res (J I : Ob) (h : Hom J I) (z : W0.Ix (GA.ob I)) (W : Ob) (f : Hom W J) (j : Hom W Iv)
    : Id (W0.Ix (K.ob W)) (kL I z W (compH W J I h f) j) (kL J (GA.act J I h z) W f j) =
    kEq W (kL I z W (compH W J I h f) j) (kL J (GA.act J I h z) W f j) (symH (GAL.actC W J I h f z))
      (transH (kL-E I z W (compH W J I h f) j)
        (transH (T2.pv-res H2 J I h z (GA.act J I h z) (refl (GA.act J I h z)) W f j) (symH (kL-E J (GA.act J I h z) W f j)))) ;

  opaque kEq ; opaque kE-act ; opaque kL-E ; opaque kL-nat ; opaque kL-res ;

  ----------------------------------------------------------------------
  -- the move

  emptyP (X : Ob) (x : CP.TV.EI X) : CP.PT.Side[X, x] =
    new CP.PT.Side[X, x, emptyS X, \ V f i -> absurd _ (empty-lands V X f i), \ V f i -> absurd _ (empty-lands V X f i),
      \ W' W chi f i i' -> absurd _ (empty-lands W X f i)] ;

  xS (X : Ob) (z : W0.Ix (GA.ob X)) (st : W0.Ix (PT.tobP X (k0 X z))) : CP.TV.EI X = (L X z, st) ;

  out (X : Ob) (z : W0.Ix (GA.ob X)) (st : W0.Ix (PT.tobP X (k0 X z))) : W0.Ix (PT.tobP X (k1 X z)) =
    PC.comp.kop X (xS X z st) (emptyP X (xS X z st)) ;

  -- uniform: at the restricted point and a start with the restricted values
  module Un (J I : Ob) (h : Hom J I) (z : W0.Ix (GA.ob I)) (st : W0.Ix (PT.tobP I (k0 I z))) (st' : W0.Ix (PT.tobP J (k0 J (GA.act J I h z))))
    (stR : (V : Ob) (f : Hom V J) (i : Hom V Iv) -> Id (TB.EI V) (st.1.1 V (compH V J I h f) i) (st'.1.1 V f i)) {
    z' : W0.Ix (GA.ob J) = GA.act J I h z ;

    lineEq : Id (W0.Ix (CLine[l].FC[K].ob J)) (CLine[l].FC[K].actF J I h (L I z)) (L J z') =
      CLine[l].FC[K].fam-eq J (CLine[l].FC[K].actF J I h (L I z)) (L J z') (\ W f j -> kL-res J I h z W f j) ;

    xEq : Id (CP.TV.EI J) (CP.TV.E.act J I h (xS I z st)) (xS J z' st') =
      CP.tv-eq J (CP.TV.E.act J I h (xS I z st)) (xS J z' st') lineEq
        (transH (CP.endE-act J I h (xS I z st))
          (PT.tp-ext J (PT.TP.E.act J I h (CP.endE I (xS I z st))) (CP.endE J (xS J z' st'))
             (transH (kL-nat I z J I h (idH I) (ptH I e0))
               (transH (apH (\ q -> kL I z J q (compH J I Iv (ptH I e0) h)) (transH (comp-idl J I h) (symH (comp-idr J I h))))
                 (transH (apH (\ q -> kL I z J (compH J J I h (idH J)) q) (ptH-nat J I h e0))
                   (kL-res J I h z J (idH J) (ptH J e0)))))
             (\ V g j -> stR V g j))) ;

    sEq : Id (CP.PT.Side[J, xS J z' st'])
             (subst (CP.TV.EI J) (\ q -> CP.PT.Side[J, q]) (CP.TV.E.act J I h (xS I z st)) (xS J z' st') xEq
                (CP.PT.rside J I h (xS I z st) (emptyP I (xS I z st))))
             (emptyP J (xS J z' st')) =
      CP.PT.side-extH J (CP.TV.E.act J I h (xS I z st)) (xS J z' st') xEq
        (CP.PT.rside J I h (xS I z st) (emptyP I (xS I z st))) (emptyP J (xS J z' st'))
        (pre-empty J I h) (\ V f i i' -> absurd _ (empty-lands V J f i')) ;

    tEq : Id (PC.TT.EI J) (PC.TT.E.act J I h (xS I z st, out I z st)) (xS J z' st', out J z' st') =
      transH (PC.comp.kunif J I h (xS I z st) (emptyP I (xS I z st)))
        (PC.RCP.kop-cong PC.comp J (CP.TV.E.act J I h (xS I z st)) (xS J z' st') xEq
           (CP.PT.rside J I h (xS I z st) (emptyP I (xS I z st))) (emptyP J (xS J z' st')) sEq) ;

    res (V : Ob) (f : Hom V J) (i : Hom V Iv) : Id (TB.EI V) ((out I z st).1.1 V (compH V J I h f) i) ((out J z' st').1.1 V f i) =
      apH (\ q -> q.2.1.1 V f i) tEq ;

    opaque lineEq ; opaque xEq ; opaque sEq ; opaque tEq ; opaque res ;
  } ;
} ;

------------------------------------------------------------------------
-- concatenation: H1 : al ~ be and H2 : be ~ ga give al ~ ga
-- (the path from al to b moved along H2, from H1)

module Cat (G : PCtx) (A B : PTy[G]) (al be ga : NMap[G, A, B]) (cB : CLine[l].Lines[G, B].CompK[e0, e1].Comp)
  (H1 : PEl[extP G A, HT[G, A, B, al, be].PT.PathP]) (H2 : PEl[extP G A, HT[G, A, B, be, ga].PT.PathP]) {
  module T1 = HT[G, A, B, al, be] ;
  module T2 = HT[G, A, B, be, ga] ;
  module T = HT[G, A, B, al, ga] ;
  module TB = T1.TB ;
  GA : PCtx = extP G A ;
  K : PCtx = extP GA (subTy GA G B (pP G A)) ;
  module GAL = GPR.PshL[GA] ;

  aK (W : Ob) (k : W0.Ix (K.ob W)) : TB.EI W = T1.aE W k.1 ;
  bK (W : Ob) (k : W0.Ix (K.ob W)) : TB.EI W = (k.1.1, k.2) ;

  bK-act (W X : Ob) (f : Hom W X) (k : W0.Ix (K.ob X)) : Id (TB.EI W) (TB.E.act W X f (bK X k)) (bK W (K.act W X f k)) =
    TB.pr-tact W X f k.1.1 (G.act W X f k.1.1) (ntEq GA G (pP G A) W X f k.1 (GA.act W X f k.1) (refl (GA.act W X f k.1))) k.2 ;

  module M = TP[G, A, B, be, ga, H2, aK, bK, \ W X f k -> T1.aE-act W X f k.1, bK-act,
    \ W k -> symH (G.act-id W k.1.1), \ W k -> symH (G.act-id W k.1.1), cB] ;

  start (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (M.PT.tobP X (M.k0 X z)) =
    M.PT.mkPath X (M.k0 X z) (\ V f i -> T1.pv H1 X z V f i) (H1.eob X z).1.2
      (\ V f i -> transH ((H1.eob X z).2.1 V f i) (apH (G.act V X f) (symH (G.act-id X z.1))))
      (transH (H1.eob X z).2.2.1 (apH (T1.aE X) (symH (GAL.actId X (idH X) (refl (idH X)) z))))
      (transH (H1.eob X z).2.2.2 (transH (symH (H2.eob X z).2.2.1) (symH (M.kL-E X z X (idH X) (ptH X e0))))) ;

  end (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (M.PT.tobP X (M.k1 X z)) = M.out X z (start X z) ;

  path (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (T.PT.tobP X z) =
    T.PT.mkPath X z (\ V f i -> (end X z).1.1 V f i) (end X z).1.2
      (\ V f i -> transH ((end X z).2.1 V f i) (apH (G.act V X f) (G.act-id X z.1)))
      (transH (end X z).2.2.1 (apH (T1.aE X) (GAL.actId X (idH X) (refl (idH X)) z)))
      (transH (end X z).2.2.2 (transH (M.kL-E X z X (idH X) (ptH X e1)) (H2.eob X z).2.2.2)) ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (GA.ob I)) (z' : W0.Ix (GA.ob J)) (e : Id (W0.Ix (GA.ob J)) (GA.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    idJ (W0.Ix (GA.ob J)) (GA.act J I h z)
      (\ z2 e2 -> Id (W0.Ix (T.PT.tobP J z2)) (T.PT.PathP.tact J I h z z2 e2 (path I z)) (path J z2))
      (T.PT.path-eq J (GA.act J I h z) (T.PT.PathP.tact J I h z (GA.act J I h z) (refl (GA.act J I h z)) (path I z)) (path J (GA.act J I h z))
         (\ V f i -> M.Un[J, I, h, z, start I z, start J (GA.act J I h z),
                          \ V' f' i' -> T1.pv-res H1 J I h z (GA.act J I h z) (refl (GA.act J I h z)) V' f' i'].res V f i))
      z' e ;

  opaque bK-act ; opaque enat ;

  res : PEl[T.GA, T.PT.PathP] = new PEl[T.GA, T.PT.PathP, path, enat] ;
} ;

------------------------------------------------------------------------
-- inverse: H : al ~ be gives be ~ al
-- (the constant path at al moved along H, its start end moving)

module Inv (G : PCtx) (A B : PTy[G]) (al be : NMap[G, A, B]) (cB : CLine[l].Lines[G, B].CompK[e0, e1].Comp)
  (H : PEl[extP G A, HT[G, A, B, al, be].PT.PathP]) {
  module T1 = HT[G, A, B, al, be] ;
  module T = HT[G, A, B, be, al] ;
  module TB = T1.TB ;
  module EL = GPR.PshL[TB.E] ;
  GA : PCtx = extP G A ;
  K : PCtx = extP GA (subTy GA G B (pP G A)) ;
  module GAL = GPR.PshL[GA] ;

  aK (W : Ob) (k : W0.Ix (K.ob W)) : TB.EI W = (k.1.1, k.2) ;
  bK (W : Ob) (k : W0.Ix (K.ob W)) : TB.EI W = T1.aE W k.1 ;

  aK-act (W X : Ob) (f : Hom W X) (k : W0.Ix (K.ob X)) : Id (TB.EI W) (TB.E.act W X f (aK X k)) (aK W (K.act W X f k)) =
    TB.pr-tact W X f k.1.1 (G.act W X f k.1.1) (ntEq GA G (pP G A) W X f k.1 (GA.act W X f k.1) (refl (GA.act W X f k.1))) k.2 ;

  module M = TP[G, A, B, al, be, H, aK, bK, aK-act, \ W X f k -> T1.aE-act W X f k.1,
    \ W k -> symH (G.act-id W k.1.1), \ W k -> symH (G.act-id W k.1.1), cB] ;

  -- the constant path at al
  start (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (M.PT.tobP X (M.k0 X z)) =
    M.PT.mkPath X (M.k0 X z) (\ V f i -> TB.E.act V X f (T1.aE X z)) (\ V' V g f i -> EL.actC V' V X f g (T1.aE X z))
      (\ V f i -> apH (G.act V X f) (symH (G.act-id X z.1)))
      (transH (EL.actId X (idH X) (refl (idH X)) (T1.aE X z)) (transH (symH (H.eob X z).2.2.1) (symH (M.kL-E X z X (idH X) (ptH X e0)))))
      (transH (EL.actId X (idH X) (refl (idH X)) (T1.aE X z)) (apH (T1.aE X) (symH (GAL.actId X (idH X) (refl (idH X)) z)))) ;

  end (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (M.PT.tobP X (M.k1 X z)) = M.out X z (start X z) ;

  path (X : Ob) (z : W0.Ix (GA.ob X)) : W0.Ix (T.PT.tobP X z) =
    T.PT.mkPath X z (\ V f i -> (end X z).1.1 V f i) (end X z).1.2
      (\ V f i -> transH ((end X z).2.1 V f i) (apH (G.act V X f) (G.act-id X z.1)))
      (transH (end X z).2.2.1 (transH (M.kL-E X z X (idH X) (ptH X e1)) (H.eob X z).2.2.2))
      (transH (end X z).2.2.2 (apH (T1.aE X) (GAL.actId X (idH X) (refl (idH X)) z))) ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (GA.ob I)) (z' : W0.Ix (GA.ob J)) (e : Id (W0.Ix (GA.ob J)) (GA.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    idJ (W0.Ix (GA.ob J)) (GA.act J I h z)
      (\ z2 e2 -> Id (W0.Ix (T.PT.tobP J z2)) (T.PT.PathP.tact J I h z z2 e2 (path I z)) (path J z2))
      (T.PT.path-eq J (GA.act J I h z) (T.PT.PathP.tact J I h z (GA.act J I h z) (refl (GA.act J I h z)) (path I z)) (path J (GA.act J I h z))
         (\ V f i -> M.Un[J, I, h, z, start I z, start J (GA.act J I h z),
                          \ V' f' i' -> transH (symH (EL.actC V' J I h f' (T1.aE I z)))
                                          (apH (TB.E.act V' J f') (T1.aE-act J I h z))].res V f i))
      z' e ;

  opaque aK-act ; opaque enat ;

  res : PEl[T.GA, T.PT.PathP] = new PEl[T.GA, T.PT.PathP, path, enat] ;
} ;

------------------------------------------------------------------------
-- homotopy equivalences

module HEq (G : PCtx) (A B : PTy[G]) (f : NMap[G, A, B]) {
  inv : NMap[G, B, A] ;
  hl : PEl[extP G A, HT[G, A, A, compN G A B A f inv, idN G A].PT.PathP] ;
  hr : PEl[extP G B, HT[G, B, B, compN G B A B inv f, idN G B].PT.PathP] ;
} ;

-- a strict equality of maps gives a homotopy
strictH (G : PCtx) (A B : PTy[G]) (al be : NMap[G, A, B])
  (p : (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x)) -> Id (W0.Ix (B.tob I x)) (be.nfun I x a0) (al.nfun I x a0))
  : PEl[extP G A, HT[G, A, B, al, be].PT.PathP] =
  Ret[G, A, B, al, al, al, be, \ I x a0 -> refl (al.nfun I x a0), p, Rf[G, A, B, al].res].res ;
