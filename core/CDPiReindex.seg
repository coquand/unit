-- Move a dependent type over the change of its domain.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module F = CDStructPi[a, a+] ;
module R = CDFibReindex[a, a+] ;
module DB = F.DB ;
module W = V[a+] ;
module P = F.GPR ;
open P.PS ;
open SmallCat[a].Objs[DB.obV] ;
open SmallCat[a].Homs[DB.obV, DB.homV] ;

module Back (G : PCtx) (A A' : PTy[G]) (p : Id (PTy[G]) A A') {
  module TR = DB.CTrFib[a+].TR[G, A] ;
  map : PSub[extP G A', extP G A] =
    new PSub[extP G A', extP G A, TR.ta A' p, \ J I f w -> symH (TR.tanat A' p J I f w)] ;

  fixed (same : Id (TOb G) A.tob A'.tob) (I : Ob) (v : W.Ix ((extP G A').ob I))
    : Id (W.Ix ((extP G A).ob I)) (map.nt I v)
      (v.1, subst W.V (\ w -> W.Ix w) (A'.tob I v.1) (A.tob I v.1) (apH (\ o -> o I v.1) (symH same)) v.2) =
    apH {W.Ix (A.tob I v.1)} {W.Ix ((extP G A).ob I)} (\ z -> (v.1, z))
      (TR.tr-pw A' p I v.1 (apH (\ o -> o I v.1) (symH same)) v.2) ;
} ;

module Domain (G : PCtx) (A : F.STy G) (B : F.STy (extP G A.1)) {
  Pair : U a++ = (T : F.STy G) * F.STy (extP G T.1) ;
  base : Pair = (A, B) ;

  id-law : Id (F.STy (extP G A.1)) B (F.subS (extP G A.1) (extP G A.1) B (Back[G, A.1, A.1, refl A.1].map)) =
    transH (R.clSub-id (extP G A.1) B.1 B.2)
      (apH (F.subS (extP G A.1) (extP G A.1) B)
        (sub-ext (extP G A.1) (extP G A.1) (idS (extP G A.1)) Back[G, A.1, A.1, refl A.1].map (\ I v -> refl v))) ;

  pair (A' : F.STy G) (p : Id (F.STy G) A A')
    : Id Pair base (A', F.subS (extP G A'.1) (extP G A.1) B Back[G, A.1, A'.1, apH (\ z -> z.1) p].map) =
    idJ (F.STy G) A
      (\ T q -> Id Pair base (T, F.subS (extP G T.1) (extP G A.1) B Back[G, A.1, T.1, apH (\ z -> z.1) q].map))
      (apH {F.STy (extP G A.1)} {Pair} (\ C -> (A, C)) id-law) A' p ;

  opaque pair ;
} ;
