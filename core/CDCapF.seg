-- CDCapF.seg (L8, Delta): seg/model DCapF.seg ported (module names only).  Was: the horns of the shuffle chain from e1 (the ascending
-- recursion P_0, ..., P_N, in line form).  At step d the shuffle P_d is
-- glued to SF N d (the boundary, the upper lid and P_0 .. P_{d-1}) along
-- the horn at its vertex d + 1:
--
--   capF1   P_d g in SF N d  =>  g misses a face y /= d + 1
--   capF2   g misses a face y /= d + 1  =>  P_d g in SF N d
--   incF    SF N (d+1) is in SF N d u P_d
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DS = DBm.DS ;
module DHm = CDeltaCl[a] ;
module DPS = CDPrS[a] ;
module DPm = CDPrism[a] ;
open CDPrismPt[a] ;
open CDCapBase[a] ;
open CDCapT[a] ;

------------------------------------------------------------------------
-- reading P_d g

gkF (N d W : Nat) (g : Hom (lin W) (lin (suc N))) : Hom (lin W) (lin N) = compH (lin W) (lin (suc N)) (lin N) (gkD N d) g ;
jkF (N d W : Nat) (g : Hom (lin W) (lin (suc N))) : Hom (lin W) Iv = compH (lin W) (lin (suc N)) Iv (jkD N d) g ;

inBdF (N d W : Nat) (g : Hom (lin W) (lin (suc N))) (z : Nat) (zN : IsT (leb z N)) (mz : IsT (missB W N (gkF N d W g) z))
  : IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)) =
  or-l (or (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g))) (Stg[N, suc zero, condF d].shB W (gkF N d W g) (jkF N d W g))
    (or-l (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g)) (ex-i N (\ y -> missB W N (gkF N d W g) y) z zN mz)) ;

inLidF (N d W : Nat) (g : Hom (lin W) (lin (suc N))) (l : IsT (lidB (suc zero) W (jkF N d W g))) : IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)) =
  or-l (or (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g))) (Stg[N, suc zero, condF d].shB W (gkF N d W g) (jkF N d W g))
    (or-r (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g)) l) ;

inShF (N d W : Nat) (g : Hom (lin W) (lin (suc N))) (k' : Nat) (k'N : IsT (leb k' N)) (c : IsT (condF d k'))
  (u : IsT (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) : IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)) =
  or-r (or (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g))) (Stg[N, suc zero, condF d].shB W (gkF N d W g) (jkF N d W g))
    (ex-i N (\ k2 -> and (condF d k2) (DPm.memP N k2 W (gkF N d W g) (jkF N d W g))) k' k'N
       (and-i (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g)) c u)) ;

-- the face k of P_k: k = 0 gives the upper lid, k = k0 + 1 gives P_k0
capK (N : Nat) : (d : Nat) -> IsT (leb d N) -> (W : Nat) (g : Hom (lin W) (lin (suc N))) -> IsT (missB W (suc N) g d)
  -> IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)) = split {
  zero -> \ hd W g mb -> inLidF N zero W g
    (fa-i W (\ v -> eqN (valT W (suc zero) (jkF N zero W g) v) (suc zero))
       (\ v hv -> substH (\ x -> IsT (eqN x (suc zero)))
                    (symH (transH (valT-pj N zero W g v hv) (ptC0 N (valT W (suc N) g v) (valT-range W (suc N) g v) (miss-e W (suc N) zero g mb v hv))))
                    (refl true))) ;
  suc k0 -> \ hd W g mb -> inShF N (suc k0) W g k0 (leb-trans k0 (suc k0) N (leb-suc k0) hd) (leb-refl k0)
    (fa-i W (\ v -> DPm.memK k0 (valT W N (gkF N (suc k0) W g) v) (valT W (suc zero) (jkF N (suc k0) W g) v))
       (\ v hv -> substH (\ x -> IsT (DPm.memK k0 x (valT W (suc zero) (jkF N (suc k0) W g) v))) (symH (valT-pg N (suc k0) W g v hv))
                    (substH (\ x -> IsT (DPm.memK k0 (pc N (suc k0) (valT W (suc N) g v)) x)) (symH (valT-pj N (suc k0) W g v hv))
                       (ptB' N k0 (valT W (suc N) g v) hd (valT-range W (suc N) g v) (miss-e W (suc N) (suc k0) g mb v hv))))) } ;

module CF (N d : Nat) (hd : IsT (leb d N)) {
  toHorn (W : Nat) (g : Hom (lin W) (lin (suc N))) (y : Nat) (hy : IsT (leb y (suc N))) (ky : IsT (not (eqN y (suc d))))
    (mb : IsT (missB W (suc N) g y)) : DS.Lands W (suc N) (DHm.hornS N (suc d)) g =
    DHm.lands-horn W N (suc d) y hy ky g (miss-of W N y g mb) ;

  missLo (W : Nat) (g : Hom (lin W) (lin (suc N))) (z : Nat) (lt : IsT (ltb z d)) (mz : IsT (missB W N (gkF N d W g) z))
    : IsT (missB W (suc N) g z) =
    miss-i W (suc N) z g (\ v hv e -> contra (valT W N (gkF N d W g) v) z (miss-e W N z (gkF N d W g) mz v hv)
      (transH (valT-pg N d W g v hv) (transH (apH (pc N d) e) (ptE N d z hd lt)))) ;

  missK (W : Nat) (g : Hom (lin W) (lin (suc N))) (mz : IsT (missB W N (gkF N d W g) d)) : IsT (missB W (suc N) g d) =
    miss-i W (suc N) d g (\ v hv e -> contra (valT W N (gkF N d W g) v) d (miss-e W N d (gkF N d W g) mz v hv)
      (transH (valT-pg N d W g v hv) (transH (apH (pc N d) e) (ptF0 N d hd)))) ;

  missHi (W : Nat) (g : Hom (lin W) (lin (suc N))) (z : Nat) (ge : IsT (leb d z)) (zN : IsT (leb z N)) (mz : IsT (missB W N (gkF N d W g) z))
    : IsT (missB W (suc N) g (suc z)) =
    miss-i W (suc N) (suc z) g (\ v hv e -> contra (valT W N (gkF N d W g) v) z (miss-e W N z (gkF N d W g) mz v hv)
      (transH (valT-pg N d W g v hv) (transH (apH (pc N d) e) (ptF N d z ge zN)))) ;

  -- the upper lid: g misses 0
  missLid (W : Nat) (g : Hom (lin W) (lin (suc N))) (l : IsT (lidB (suc zero) W (jkF N d W g))) : IsT (missB W (suc N) g zero) =
    miss-i W (suc N) zero g (\ v hv e -> false-true
      (substH (\ x -> IsT (eqN x (suc zero))) (transH (valT-pj N d W g v hv) (transH (apH (pl N d) e) (ptG0 N d)))
         (fa-e W (\ v' -> eqN (valT W (suc zero) (jkF N d W g) v') (suc zero)) l v hv))) ;

  -- P_d g in P_k' with k' < d: g misses d
  missSh (W : Nat) (g : Hom (lin W) (lin (suc N))) (k' : Nat) (lt : IsT (ltb k' d)) (u : IsT (DPm.memP N k' W (gkF N d W g) (jkF N d W g)))
    : IsT (missB W (suc N) g d) =
    miss-i W (suc N) d g (\ v hv e -> false-true (transH (symH (ptH' N d k' hd lt))
      (substH (\ x -> IsT (DPm.memK k' (pc N d d) x)) (transH (valT-pj N d W g v hv) (apH (pl N d) e))
        (substH (\ x -> IsT (DPm.memK k' x (valT W (suc zero) (jkF N d W g) v))) (transH (valT-pg N d W g v hv) (apH (pc N d) e))
          (fa-e W (\ v' -> DPm.memK k' (valT W N (gkF N d W g) v') (valT W (suc zero) (jkF N d W g) v')) u v hv))))) ;

  -- d /= d + 1, and below
  nK : IsT (not (eqN d (suc d))) = ltb-neq d (suc d) (leb-refl d) ;

  bdCase (W : Nat) (g : Hom (lin W) (lin (suc N))) (z : Nat) (zN : IsT (leb z N)) (mz : IsT (missB W N (gkF N d W g) z))
    : DS.Lands W (suc N) (DHm.hornS N (suc d)) g =
    ltb-dec (DS.Lands W (suc N) (DHm.hornS N (suc d)) g) z d
      (\ lt -> toHorn W g z (leb-step z N zN) (ltb-neq z (suc d) (leb-step (suc z) d lt)) (missLo W g z lt mz))
      (\ ge -> eqN-dec (DS.Lands W (suc N) (DHm.hornS N (suc d)) g) z d
                 (\ e -> toHorn W g d (leb-step d N hd) nK (missK W g (substH (\ x -> IsT (missB W N (gkF N d W g) x)) e mz)))
                 (\ ne -> toHorn W g (suc z) zN ne (missHi W g z ge zN mz))) ;

  capF1 (W : Nat) (g : Hom (lin W) (lin (suc N))) (s : IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)))
    : DS.Lands W (suc N) (DHm.hornS N (suc d)) g =
    or-elim (DS.Lands W (suc N) (DHm.hornS N (suc d)) g) (or (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g)))
      (Stg[N, suc zero, condF d].shB W (gkF N d W g) (jkF N d W g)) s
      (\ s0 -> or-elim (DS.Lands W (suc N) (DHm.hornS N (suc d)) g) (bdB N W (gkF N d W g)) (lidB (suc zero) W (jkF N d W g)) s0
         (\ b -> bdCase W g (ex-e N (\ y -> missB W N (gkF N d W g) y) b).1 (ex-e N (\ y -> missB W N (gkF N d W g) y) b).2.1
                    (ex-e N (\ y -> missB W N (gkF N d W g) y) b).2.2)
         (\ l -> toHorn W g zero (refl true) (refl true) (missLid W g l)))
      (\ u -> toHorn W g d (leb-step d N hd) nK
                 (missSh W g (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).1
                    (and-l (condF d (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).1)
                           (DPm.memP N (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).1 W (gkF N d W g) (jkF N d W g))
                           (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).2.2)
                    (and-r (condF d (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).1)
                           (DPm.memP N (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).1 W (gkF N d W g) (jkF N d W g))
                           (ex-e N (\ k' -> and (condF d k') (DPm.memP N k' W (gkF N d W g) (jkF N d W g))) u).2.2))) ;

  ----------------------------------------------------------------------
  bdLo (W : Nat) (g : Hom (lin W) (lin (suc N))) (y : Nat) (lt : IsT (ltb y d)) (mb : IsT (missB W (suc N) g y))
    : IsT (missB W N (gkF N d W g) y) =
    fa-i W (\ v -> not (eqN (valT W N (gkF N d W g) v) y))
      (\ v hv -> neqT (valT W N (gkF N d W g) v) (pc N d (valT W (suc N) g v)) y (valT-pg N d W g v hv)
                   (ptA N d (valT W (suc N) g v) y hd (valT-range W (suc N) g v) lt (miss-e W (suc N) y g mb v hv))) ;

  bdHi (W : Nat) (g : Hom (lin W) (lin (suc N))) (y' : Nat) (lt : IsT (ltb d y')) (mb : IsT (missB W (suc N) g (suc y')))
    : IsT (missB W N (gkF N d W g) y') =
    fa-i W (\ v -> not (eqN (valT W N (gkF N d W g) v) y'))
      (\ v hv -> neqT (valT W N (gkF N d W g) v) (pc N d (valT W (suc N) g v)) y' (valT-pg N d W g v hv)
                   (ptD N d (valT W (suc N) g v) y' hd (valT-range W (suc N) g v) lt (miss-e W (suc N) (suc y') g mb v hv))) ;

  -- y > d, y /= d + 1
  capUp (W : Nat) (g : Hom (lin W) (lin (suc N))) : (y : Nat) -> IsT (ltb d y) -> IsT (leb y (suc N)) -> IsT (not (eqN y (suc d)))
    -> IsT (missB W (suc N) g y) -> IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)) = split {
    zero -> \ lt hy ky mb -> absurd _ (false-true lt) ;
    suc y' -> \ lt hy ky mb -> inBdF N d W g y' hy (bdHi W g y' (leb-neq d y' lt (neq-sym y' d ky)) mb) } ;

  capF2 (W : Nat) (g : Hom (lin W) (lin (suc N))) (i : DS.Lands W (suc N) (DHm.hornS N (suc d)) g)
    : IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g)) =
    ltb-dec (IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g))) (DHm.horn-lands W N (suc d) g i).1 d
      (\ lt -> inBdF N d W g (DHm.horn-lands W N (suc d) g i).1 (leb-trans (DHm.horn-lands W N (suc d) g i).1 d N (ltb-leb (DHm.horn-lands W N (suc d) g i).1 d lt) hd)
                  (bdLo W g (DHm.horn-lands W N (suc d) g i).1 lt (of-miss W N (DHm.horn-lands W N (suc d) g i).1 g (DHm.horn-lands W N (suc d) g i).2.2.2)))
      (\ ge -> eqN-dec (IsT ((SF N d).1 W (gkF N d W g) (jkF N d W g))) (DHm.horn-lands W N (suc d) g i).1 d
                 (\ e -> capK N d hd W g (substH (\ x -> IsT (missB W (suc N) g x)) e
                                            (of-miss W N (DHm.horn-lands W N (suc d) g i).1 g (DHm.horn-lands W N (suc d) g i).2.2.2)))
                 (\ ne -> capUp W g (DHm.horn-lands W N (suc d) g i).1
                             (leb-neq d (DHm.horn-lands W N (suc d) g i).1 ge (neq-sym (DHm.horn-lands W N (suc d) g i).1 d ne))
                             (DHm.horn-lands W N (suc d) g i).2.1 (DHm.horn-lands W N (suc d) g i).2.2.1
                             (of-miss W N (DHm.horn-lands W N (suc d) g i).1 g (DHm.horn-lands W N (suc d) g i).2.2.2))) ;

  ----------------------------------------------------------------------
  incF (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT ((SF N (suc d)).1 W f j))
    : IsT (or ((SF N d).1 W f j) (DPm.memP N d W f j)) =
    or-elim (IsT (or ((SF N d).1 W f j) (DPm.memP N d W f j))) (or (bdB N W f) (lidB (suc zero) W j))
      (Stg[N, suc zero, condF (suc d)].shB W f j) s
      (\ s0 -> or-l ((SF N d).1 W f j) (DPm.memP N d W f j)
                  (or-l (or (bdB N W f) (lidB (suc zero) W j)) (Stg[N, suc zero, condF d].shB W f j) s0))
      (\ u -> incSh W f j (ex-e N (\ k' -> and (condF (suc d) k') (DPm.memP N k' W f j)) u).1
                 (ex-e N (\ k' -> and (condF (suc d) k') (DPm.memP N k' W f j)) u).2.1
                 (ex-e N (\ k' -> and (condF (suc d) k') (DPm.memP N k' W f j)) u).2.2) ;

  incSh (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (k' : Nat) (k'N : IsT (leb k' N))
    (cu : IsT (and (condF (suc d) k') (DPm.memP N k' W f j))) : IsT (or ((SF N d).1 W f j) (DPm.memP N d W f j)) =
    eqN-dec (IsT (or ((SF N d).1 W f j) (DPm.memP N d W f j))) k' d
      (\ e -> or-r ((SF N d).1 W f j) (DPm.memP N d W f j)
                  (substH (\ x -> IsT (DPm.memP N x W f j)) e (and-r (condF (suc d) k') (DPm.memP N k' W f j) cu)))
      (\ ne -> or-l ((SF N d).1 W f j) (DPm.memP N d W f j)
                  (or-r (or (bdB N W f) (lidB (suc zero) W j)) (Stg[N, suc zero, condF d].shB W f j)
                     (ex-i N (\ k2 -> and (condF d k2) (DPm.memP N k2 W f j)) k' k'N
                        (and-i (condF d k') (DPm.memP N k' W f j)
                           (leb-neq k' d (and-l (condF (suc d) k') (DPm.memP N k' W f j) cu) ne)
                           (and-r (condF (suc d) k') (DPm.memP N k' W f j) cu))))) ;
} ;
