-- CExtEq2.seg (L5, inside CB): the universal equivalence e_U, glued from
-- the points' own (CGlueRC).  At a point w = ((D , full) , a) of E_AU, the
-- local context is D's E_At over RC(Z , ph) with iota = Pt[Z , D].tA
-- (CExtEq1), the point (id , a) over w, and the local structure D's own
-- equivalence.  Coherence: along g, (D g)'s equivalence is D's moved along
-- the cart Chi (CGlueE.act1); the point carts commute with Chi (CompatA /
-- CompatB / CompatMS), and the two extensions agree by kop-cong of D's.
--
-- Quarry: seg/model GExtEq (Co, eqU), GYonEq*.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module EQ2 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module F = CEquiv[a+].HFib[UB.CU.resCtx, UB.BU, UB.AU', UB.alU] ;
  RES : L.PCtx = UB.CU.resCtx ;

  ----------------------------------------------------------------------
  -- the point carts commute with the action

  module Co (Z : Ob) (D : GE.GD1 Z) (Y : Ob) (g : Hom Y Z) {
    D' : GE.GD1 Y = UB.GDr.act Y Z g D ;
    module PD = E1.Pt[Z, D] ;
    module PD' = E1.Pt[Y, D'] ;
    module CHI = GE.Chi[Y, Z, g, D.1] ;

    CompatA (W : Ob) (u : PD'.T0.TAt.EI W) : Id (UB.TAU.EI W) (PD'.tA W u) (PD.tA W (CHI.tA W u)) =
      PD.pair-eqV1 (V1.Ix (RES.ob W)) (PD.codeA W) (PD'.s W u.1) (PD.s W (CHI.sl.nt W u.1))
        (UB.CU.res-eq W (PD'.s W u.1) (PD.s W (CHI.sl.nt W u.1)) (symH (UB.GDr.act-o W Y Z g u.1.1 D)))
        (PD'.tA W u).2 (PD.tA W (CHI.tA W u)).2
        (transH (symH (apH (PD'.o W) (symH (comp-idr W Y u.1.1)))) (apH (PD.o W) (symH (comp-idr W Z (compH W Y Z g u.1.1)))))
        (transH (apH (CExtEq1.sV (PD.codeA W (PD'.s W u.1)) (PD.codeA W (PD.s W (CHI.sl.nt W u.1)))
                       (transH (symH (apH (PD'.o W) (symH (comp-idr W Y u.1.1)))) (apH (PD.o W) (symH (comp-idr W Z (compH W Y Z g u.1.1))))))
                   (PD'.trH-V W u.1.1 (compH W W Y u.1.1 (idH W)) (symH (comp-idr W Y u.1.1)) u.2))
          (transH (CExtEq1.sV-two (PD'.o W u.1.1) (PD.codeA W (PD'.s W u.1)) (PD.codeA W (PD.s W (CHI.sl.nt W u.1)))
                     (apH (PD'.o W) (symH (comp-idr W Y u.1.1)))
                     (transH (symH (apH (PD'.o W) (symH (comp-idr W Y u.1.1)))) (apH (PD.o W) (symH (comp-idr W Z (compH W Y Z g u.1.1)))))
                     (apH (PD.o W) (symH (comp-idr W Z (compH W Y Z g u.1.1)))) u.2)
                  (symH (PD.trH-V W (compH W Y Z g u.1.1) (compH W W Z (compH W Y Z g u.1.1) (idH W)) (symH (comp-idr W Z (compH W Y Z g u.1.1))) u.2)))) ;

    CompatB (W : Ob) (u : PD'.T0.TBt.EI W) : Id (UB.TBU.EI W) (PD'.tB W u) (PD.tB W (CHI.tB W u)) =
      PD.pair-eqV1 (V1.Ix (RES.ob W)) (PD.codeB W) (PD'.s W u.1) (PD.s W (CHI.sl.nt W u.1))
        (UB.CU.res-eq W (PD'.s W u.1) (PD.s W (CHI.sl.nt W u.1)) (symH (UB.GDr.act-o W Y Z g u.1.1 D)))
        (PD'.tB W u).2 (PD.tB W (CHI.tB W u)).2
        (transH (symH (apH (UU.fib0 W) (PD'.PB W u.1))) (apH (UU.fib0 W) (PD.PB W (CHI.sl.nt W u.1))))
        (transH (apH (CExtEq1.sV (PD.codeB W (PD'.s W u.1)) (PD.codeB W (PD.s W (CHI.sl.nt W u.1)))
                       (transH (symH (apH (UU.fib0 W) (PD'.PB W u.1))) (apH (UU.fib0 W) (PD.PB W (CHI.sl.nt W u.1)))))
                   (UU.substF W (PD'.bd.1 W u.1.1 u.1.2) (PD'.bd.1 W (compH W W Y u.1.1 (idH W)) (PD'.q2 W u.1)) (PD'.PB W u.1) u.2))
          (transH (CExtEq1.sV-two (UU.fib0 W (PD'.bd.1 W u.1.1 u.1.2)) (PD.codeB W (PD'.s W u.1)) (PD.codeB W (PD.s W (CHI.sl.nt W u.1)))
                     (apH (UU.fib0 W) (PD'.PB W u.1))
                     (transH (symH (apH (UU.fib0 W) (PD'.PB W u.1))) (apH (UU.fib0 W) (PD.PB W (CHI.sl.nt W u.1))))
                     (apH (UU.fib0 W) (PD.PB W (CHI.sl.nt W u.1))) u.2)
                  (symH (UU.substF W (PD.bd.1 W (CHI.sl.nt W u.1).1 (CHI.sl.nt W u.1).2)
                           (PD.bd.1 W (compH W W Z (CHI.sl.nt W u.1).1 (idH W)) (PD.q2 W (CHI.sl.nt W u.1))) (PD.PB W (CHI.sl.nt W u.1)) u.2)))) ;

    opaque CompatA ; opaque CompatB ;

    CompatMS (W : Ob) (v : PD'.H.F'.TF.EI W) : Id (F.TF.EI W) (PD'.H.mS W v) (PD.H.mS W (CHI.H.mS W v)) =
      F.fibE-eq W (PD'.H.mS W v) (PD.H.mS W (CHI.H.mS W v)) (CompatA W v.1)
        (transH (PD'.H.bm-E W v)
          (transH (CompatB W (PD'.H.F'.fibB W v))
            (transH (apH (PD.tB W) (symH (CHI.H.bm-E W v))) (symH (PD.H.bm-E W (CHI.H.mS W v))))))
        (\ W' f j -> CompatA W' (PD'.H.F'.fibL W v W' f j)) ;

    opaque CompatMS ;
  } ;

  ----------------------------------------------------------------------
  -- the gluing data

  o (Z : Ob) (w : UB.TAU.EI Z) : W0.Ix ((E1.Pt[Z, w.1.1].H.F'.EA).ob Z) = ((idH Z, UB.qU Z w.1.1 w.1.2), w.2) ;

  oio (Z : Ob) (w : UB.TAU.EI Z) : Id (UB.TAU.EI Z) (E1.Pt[Z, w.1.1].tA Z (o Z w)) w =
    E1.Pt[Z, w.1.1].pair-eqV1 (V1.Ix (RES.ob Z)) (E1.Pt[Z, w.1.1].codeA Z) (E1.Pt[Z, w.1.1].s Z (o Z w).1) w.1
      (UB.CU.res-eq Z (E1.Pt[Z, w.1.1].s Z (o Z w).1) w.1 (UB.GDr.act-id Z w.1.1))
      (E1.Pt[Z, w.1.1].tA Z (o Z w)).2 w.2
      (symH (apH (E1.Pt[Z, w.1.1].o Z) (symH (comp-idr Z Z (idH Z)))))
      (transH (apH (CExtEq1.sV (E1.Pt[Z, w.1.1].codeA Z (E1.Pt[Z, w.1.1].s Z (o Z w).1)) (E1.Pt[Z, w.1.1].codeA Z w.1)
                     (symH (apH (E1.Pt[Z, w.1.1].o Z) (symH (comp-idr Z Z (idH Z))))))
                 (E1.Pt[Z, w.1.1].trH-V Z (idH Z) (compH Z Z Z (idH Z) (idH Z)) (symH (comp-idr Z Z (idH Z))) w.2))
              (CExtEq1.sV-two (E1.Pt[Z, w.1.1].o Z (idH Z)) (E1.Pt[Z, w.1.1].codeA Z (E1.Pt[Z, w.1.1].s Z (o Z w).1)) (E1.Pt[Z, w.1.1].codeA Z w.1)
                 (apH (E1.Pt[Z, w.1.1].o Z) (symH (comp-idr Z Z (idH Z))))
                 (symH (apH (E1.Pt[Z, w.1.1].o Z) (symH (comp-idr Z Z (idH Z)))))
                 (refl (E1.Pt[Z, w.1.1].o Z (idH Z))) w.2)) ;

  opaque oio ;

  ----------------------------------------------------------------------
  -- coherence

  module Ch (Z : Ob) (w : UB.TAU.EI Z) (Y : Ob) (g : Hom Y Z)
    (sg : CPartial[a].Partials[E1.Pt[Z, w.1.1].H.F'.EA, E1.Pt[Z, w.1.1].H.F'.FibT].Side[Y, (E1.Pt[Z, w.1.1].H.F'.EA).act Y Z g (o Z w)])
    (sg' : CPartial[a].Partials[E1.Pt[Y, (UB.TAU.E.act Y Z g w).1.1].H.F'.EA, E1.Pt[Y, (UB.TAU.E.act Y Z g w).1.1].H.F'.FibT].Side[Y, o Y (UB.TAU.E.act Y Z g w)])
    (HQ : Id (Phi Y) sg.pQ sg'.pQ)
    (Hv : (V : Ob) (f : Hom V Y) (i : Lands V Y sg.pQ f) (i' : Lands V Y sg'.pQ f)
          -> Id (F.TF.EI V) (E1.Pt[Z, w.1.1].H.mS V (sg.pv V f i)) (E1.Pt[Y, (UB.TAU.E.act Y Z g w).1.1].H.mS V (sg'.pv V f i'))) {
    module C0 = Co[Z, w.1.1, Y, g] ;
    module PD = C0.PD ;
    module PD' = C0.PD' ;
    module CHI = C0.CHI ;
    module RD = CPartial[a].Rel[PD.H.F'.EA, PD.H.F'.FibT, PD.H.F'.FibT, CPartial[a].pmap-id PD.H.F'.EA PD.H.F'.FibT] ;
    module PL = CPartial[a].Partials[PD.H.F'.EA, PD.H.F'.FibT] ;

    w' : UB.TAU.EI Y = UB.TAU.E.act Y Z g w ;
    cg : W0.Ix (PD.H.F'.EA.ob Y) = (PD.H.F'.EA).act Y Z g (o Z w) ;
    c' : W0.Ix (PD.H.F'.EA.ob Y) = CHI.tA Y (o Y w') ;

    P : Id (W0.Ix (PD.H.F'.EA.ob Y)) cg c' =
      PD.tAinj Y cg c'
        (CGlueE.RCm[Z, w.1.1.1.2.1].pt-eq Y cg.1 c'.1 (transH (comp-idl Y Z g) (symH (comp-idr Y Z g))))
        (transH (symH (PD.tAnat Y Z g (o Z w)))
          (transH (apH (UB.TAU.E.act Y Z g) (oio Z w))
            (transH (symH (oio Y w')) (C0.CompatA Y (o Y w'))))) ;

    R : Id (PL.Side[Y, c']) (subst (W0.Ix (PD.H.F'.EA.ob Y)) (\ z -> PL.Side[Y, z]) cg c' P sg) (CHI.H.C.mside w.1.1.2 Y (o Y w') sg') =
      PL.side-extH Y cg c' P sg (CHI.H.C.mside w.1.1.2 Y (o Y w') sg') HQ
        (\ V f i i' -> PD.H.mSinj V (sg.pv V f i) (CHI.H.mS V (sg'.pv V f i'))
           (transH (sg.ppt V f i) (transH (apH ((PD.H.F'.EA).act V Y f) P)
              (transH (CHI.tAnat V Y f (o Y w')) (symH (apH (CHI.tA V) (sg'.ppt V f i'))))))
           (transH (Hv V f i i') (C0.CompatMS V (sg'.pv V f i')))) ;

    coh : Id (F.TF.EI Y) (PD.H.mS Y (cg, w.1.1.2.kop Y cg sg)) (PD'.H.mS Y (o Y w', (CHI.H.moveEq w.1.1.2).kop Y (o Y w') sg')) =
      transH (apH (PD.H.mS Y) (RD.kop-cong w.1.1.2 Y cg c' P sg (CHI.H.C.mside w.1.1.2 Y (o Y w') sg') R))
        (symH (transH (C0.CompatMS Y (o Y w', (CHI.H.moveEq w.1.1.2).kop Y (o Y w') sg'))
                      (apH (PD.H.mS Y) (CHI.H.C.kopMv w.1.1.2 Y (o Y w') sg')))) ;
  } ;

  ----------------------------------------------------------------------
  -- the universal equivalence

  module GL = CGlueRC[a+, a].Glue[F.EA, F.FibT, F.FibT, CPartial[a+].pmap-id F.EA F.FibT,
    \ Z w -> E1.Pt[Z, w.1.1].H.F'.EA,
    \ Z w W c -> E1.Pt[Z, w.1.1].tA W c,
    \ Z w V W g c -> symH (E1.Pt[Z, w.1.1].tAnat V W g c),
    o, oio,
    \ Z w -> E1.Pt[Z, w.1.1].H.F'.FibT, \ Z w -> E1.Pt[Z, w.1.1].H.F'.FibT,
    \ Z w -> CPartial[a].pmap-id (E1.Pt[Z, w.1.1].H.F'.EA) (E1.Pt[Z, w.1.1].H.F'.FibT),
    \ Z w W v -> E1.Pt[Z, w.1.1].H.mS W v, \ Z w W v -> refl (E1.Pt[Z, w.1.1].tA W v.1),
    \ Z w V W g v -> E1.Pt[Z, w.1.1].H.mSnat V W g v,
    \ Z w W v v' P Q -> E1.Pt[Z, w.1.1].H.mSinj W v v' P Q,
    \ Z w W c u -> E1.Pt[Z, w.1.1].H.Bk[W, c, u].res, \ Z w W c u -> E1.Pt[Z, w.1.1].H.Bk[W, c, u].res-t,
    \ Z w W v -> E1.Pt[Z, w.1.1].H.mS W v, \ Z w W v -> refl (E1.Pt[Z, w.1.1].tA W v.1),
    \ Z w V W g v -> E1.Pt[Z, w.1.1].H.mSnat V W g v,
    \ Z w W v -> refl (E1.Pt[Z, w.1.1].H.mS W v),
    \ Z w -> w.1.1.2,
    \ Z w Y g sg sg' HQ Hv -> Ch[Z, w, Y, g, sg, sg', HQ, Hv].coh] ;

  eqU : CEquiv[a+].EquivOp UB.CU.resCtx UB.BU UB.AU' UB.alU = GL.rc ;
} ;
