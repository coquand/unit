-- CLocRestr.seg (L9, localisation of the poset model): the restriction i*
-- (localisation.tex §1).  A context G and a type A over the posets are
-- read on the linear posets [n] = lin n as a simplicial set i*G and a type
-- i*A of the Delta instance (CDeltaBase.DB): the same hom codes
-- Hom (lin m) (lin n), the same interval lin 1, the same connections.
--
--   iG , iA        the restrictions
--   rdG , rdA      a line of G (resp. in A) at X, read along f : [n] -> X:
--                  a line of i*G (resp. in i*A) at n, (g , j) |-> (f g , j)
--   rdG-act        reading along f then restricting along g is reading
--                  along f g (the problem at f g is the problem at f,
--                  restricted)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ;
module DB = CDeltaBase[a].DB ;
module PP = PB.GPre[l].PS ;
module DP = DB.GPre[l].PS ;

module R (G : PP.PCtx) {
  iG : DP.PCtx =
    new DP.PCtx[\ n -> G.ob (lin n), \ m n f x -> G.act (lin m) (lin n) f x, \ n x -> G.act-id (lin n) x,
                \ k m n f g x -> G.act-o (lin k) (lin m) (lin n) f g x] ;

  module FP = PB.CLine[l].FC[G] ;
  module FD = DB.CLine[l].FC[iG] ;

  -- a line of G at X read along f : [n] -> X
  rdG (X : Ob) (n : Nat) (f : Hom (lin n) X) (L : W0.Ix (FP.ob X)) : W0.Ix (FD.ob n) =
    (\ W g j -> L.1 (lin W) (compH (lin W) (lin n) X f g) j,
     \ V W g g' j -> transH (L.2 (lin V) (lin W) g (compH (lin W) (lin n) X f g') j)
                            (apH (\ k -> L.1 (lin V) k (compH (lin V) (lin W) Iv j g)) (comp-assoc (lin V) (lin W) (lin n) X f g' g))) ;

  -- reading along f then restricting along g is reading along f g
  rdG-act (X : Ob) (m n : Nat) (g : Hom (lin m) (lin n)) (f : Hom (lin n) X) (L : W0.Ix (FP.ob X))
    : Id (W0.Ix (FD.ob m)) (FD.actF m n g (rdG X n f L)) (rdG X m (compH (lin m) (lin n) X f g) L) =
    FD.fam-eq m (FD.actF m n g (rdG X n f L)) (rdG X m (compH (lin m) (lin n) X f g) L)
      (\ W g' j -> apH (\ k -> L.1 (lin W) k j) (symH (comp-assoc (lin W) (lin m) (lin n) X f g g'))) ;

  -- the reading of a line at X along the identity of a linear X
  rdG-pt (X : Ob) (n : Nat) (f : Hom (lin n) X) (L : W0.Ix (FP.ob X)) (e : El Iv)
    : Id (W0.Ix (G.ob (lin n))) ((FD.ev e).nt n (rdG X n f L)) (L.1 (lin n) f (constH (lin n) Iv e)) =
    apH (\ k -> L.1 (lin n) k (constH (lin n) Iv e)) (comp-idr (lin n) X f) ;

  module T (A : PP.PTy[G]) {
    iA : DP.PTy[iG] =
      new DP.PTy[iG, \ n x -> A.tob (lin n) x, \ m n f x y e b -> A.tact (lin m) (lin n) f x y e b,
                 \ n x e b -> A.tact-id (lin n) x e b,
                 \ k m n f g x y z e1 e2 e3 b -> A.tact-o (lin k) (lin m) (lin n) f g x y z e1 e2 e3 b] ;

    module TA = PB.GPre[l].TyL[G, A] ;
    module TiA = DB.GPre[l].TyL[iG, iA] ;
    module FAP = PB.CLine[l].FT[G, A] ;
    module FAD = DB.CLine[l].FT[iG, iA] ;
    module FEP = FAP.FE ;
    module FED = FAD.FE ;

    -- a line in E_A at X read along f : a line in E_{i*A} at n
    rdE (X : Ob) (n : Nat) (f : Hom (lin n) X) (L : W0.Ix (FEP.ob X)) : W0.Ix (FED.ob n) =
      (\ W g j -> L.1 (lin W) (compH (lin W) (lin n) X f g) j,
       \ V W g g' j -> transH (L.2 (lin V) (lin W) g (compH (lin W) (lin n) X f g') j)
                              (apH (\ k -> L.1 (lin V) k (compH (lin V) (lin W) Iv j g)) (comp-assoc (lin V) (lin W) (lin n) X f g' g))) ;

    -- a line in A over x read along f : a line in i*A over the read line
    rdA (X : Ob) (n : Nat) (f : Hom (lin n) X) (x : W0.Ix (FP.ob X)) (L : W0.Ix (FAP.tobF X x)) : W0.Ix (FAD.tobF n (rdG X n f x)) =
      (rdE X n f L.1, FD.fam-eq n (FAD.piL n (rdE X n f L.1)) (rdG X n f x)
                        (\ W g j -> apH (\ y -> y.1 (lin W) (compH (lin W) (lin n) X f g) j) L.2)) ;
  } ;
} ;
