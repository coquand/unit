-- CMoveLaws.seg (L2, inside CB, levels i j k): the laws of Move, once.
--
--   Comp   moving along (s1 , ...) : (D1 , m1) -> (D , m) then along
--          (s2 , ...) : (D , m) -> (D0 , m0) is moving along the composite
--          (comp: by Mv.unique, the moved sides agree by side-ext)
--   Sub    substitution of a structure along t : D' -> D is Move with the
--          identity on fibres (rcSub); the substitution laws of every
--          transported structure are instances of Comp
--
-- Quarry: seg/model GTransferComp, GTransferEqTwice, GTransferSub,
-- GTransferEqSub, GTransferEqComp, GFibLaws (subFibEL-o).

level i j k ;
constraint a <= i ;
constraint a <= j ;
constraint a <= k ;
open Base ;
open Prelude[(i \/ j \/ k)+] ;
open Paths[(i \/ j \/ k)+] ;
module W1 = V[i] ;
module W2 = V[j] ;
module W0 = V[k] ;
module P1 = GPre[i] ;
module P2 = GPre[j] ;
module P0 = GPre[k] ;

module Comp (D1 : P1.PS.PCtx) (S1 T1 : P1.PS.PTy[D1]) (m1 : CPartial[i].PMap[D1, S1, T1])
  (D : P2.PS.PCtx) (S T : P2.PS.PTy[D]) (m : CPartial[j].PMap[D, S, T])
  (D0 : P0.PS.PCtx) (S0 T0 : P0.PS.PTy[D0]) (m0 : CPartial[k].PMap[D0, S0, T0])
  -- the first move (D1 -> D)
  (s1 : (W : Ob) -> W1.Ix (D1.ob W) -> W2.Ix (D.ob W))
  (s1-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D1.ob W)) -> Id (W2.Ix (D.ob V)) (s1 V (D1.act V W g d)) (D.act V W g (s1 W d)))
  (mS1 : (W : Ob) -> P1.TyL[D1, S1].EI W -> P2.TyL[D, S].EI W)
  (mSpt1 : (W : Ob) (v : P1.TyL[D1, S1].EI W) -> Id (W2.Ix (D.ob W)) (mS1 W v).1 (s1 W v.1))
  (mSnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, S1].EI W)
     -> Id (P2.TyL[D, S].EI V) (P2.TyL[D, S].E.act V W g (mS1 W v)) (mS1 V (P1.TyL[D1, S1].E.act V W g v)))
  (mT1 : (W : Ob) -> P1.TyL[D1, T1].EI W -> P2.TyL[D, T].EI W)
  (mTpt1 : (W : Ob) (v : P1.TyL[D1, T1].EI W) -> Id (W2.Ix (D.ob W)) (mT1 W v).1 (s1 W v.1))
  (mTnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, T1].EI W)
     -> Id (P2.TyL[D, T].EI V) (P2.TyL[D, T].E.act V W g (mT1 W v)) (mT1 V (P1.TyL[D1, T1].E.act V W g v)))
  (mTinj1 : (W : Ob) (v v' : P1.TyL[D1, T1].EI W) (P : Id (W1.Ix (D1.ob W)) v.1 v'.1) (Q : Id (P2.TyL[D, T].EI W) (mT1 W v) (mT1 W v'))
     -> Id (P1.TyL[D1, T1].EI W) v v')
  (bk1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (T.tob X (s1 X x))) -> W1.Ix (T1.tob X x))
  (bkMv1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (T.tob X (s1 X x))) -> Id (P2.TyL[D, T].EI X) (mT1 X (x, bk1 X x u)) (s1 X x, u))
  (sq1 : (W : Ob) (v : P1.TyL[D1, S1].EI W) -> Id (P2.TyL[D, T].EI W) (mT1 W (m1.mE W v)) (m.mE W (mS1 W v)))
  -- the second move (D -> D0)
  (s2 : (W : Ob) -> W2.Ix (D.ob W) -> W0.Ix (D0.ob W))
  (s2-nat : (V W : Ob) (g : Hom V W) (d : W2.Ix (D.ob W)) -> Id (W0.Ix (D0.ob V)) (s2 V (D.act V W g d)) (D0.act V W g (s2 W d)))
  (mS2 : (W : Ob) -> P2.TyL[D, S].EI W -> P0.TyL[D0, S0].EI W)
  (mSpt2 : (W : Ob) (v : P2.TyL[D, S].EI W) -> Id (W0.Ix (D0.ob W)) (mS2 W v).1 (s2 W v.1))
  (mSnat2 : (V W : Ob) (g : Hom V W) (v : P2.TyL[D, S].EI W)
     -> Id (P0.TyL[D0, S0].EI V) (P0.TyL[D0, S0].E.act V W g (mS2 W v)) (mS2 V (P2.TyL[D, S].E.act V W g v)))
  (mT2 : (W : Ob) -> P2.TyL[D, T].EI W -> P0.TyL[D0, T0].EI W)
  (mTpt2 : (W : Ob) (v : P2.TyL[D, T].EI W) -> Id (W0.Ix (D0.ob W)) (mT2 W v).1 (s2 W v.1))
  (mTnat2 : (V W : Ob) (g : Hom V W) (v : P2.TyL[D, T].EI W)
     -> Id (P0.TyL[D0, T0].EI V) (P0.TyL[D0, T0].E.act V W g (mT2 W v)) (mT2 V (P2.TyL[D, T].E.act V W g v)))
  (mTinj2 : (W : Ob) (v v' : P2.TyL[D, T].EI W) (P : Id (W2.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[D0, T0].EI W) (mT2 W v) (mT2 W v'))
     -> Id (P2.TyL[D, T].EI W) v v')
  (bk2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s2 X x))) -> W2.Ix (T.tob X x))
  (bkMv2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s2 X x))) -> Id (P0.TyL[D0, T0].EI X) (mT2 X (x, bk2 X x u)) (s2 X x, u))
  (sq2 : (W : Ob) (v : P2.TyL[D, S].EI W) -> Id (P0.TyL[D0, T0].EI W) (mT2 W (m.mE W v)) (m0.mE W (mS2 W v)))
  -- the structure on the target
  (k0 : CPartial[k].Rel[D0, S0, T0, m0].RC) {
  module TT1 = P1.TyL[D1, T1] ;
  module TT = P2.TyL[D, T] ;
  module TT0 = P0.TyL[D0, T0] ;

  module M2 = CMove[k, j].Mv[D, S, T, m, D0, S0, T0, m0, s2, s2-nat, mS2, mSpt2, mSnat2, mT2, mTpt2, mTnat2, mTinj2, bk2, bkMv2, sq2, k0] ;
  module M1 = CMove[j, i].Mv[D1, S1, T1, m1, D, S, T, m, s1, s1-nat, mS1, mSpt1, mSnat1, mT1, mTpt1, mTnat1, mTinj1, bk1, bkMv1, sq1, M2.rc] ;

  -- the composite data
  s (W : Ob) (d : W1.Ix (D1.ob W)) : W0.Ix (D0.ob W) = s2 W (s1 W d) ;
  s-nat (V W : Ob) (g : Hom V W) (d : W1.Ix (D1.ob W)) : Id (W0.Ix (D0.ob V)) (s V (D1.act V W g d)) (D0.act V W g (s W d)) =
    transH (apH (s2 V) (s1-nat V W g d)) (s2-nat V W g (s1 W d)) ;
  mS (W : Ob) (v : P1.TyL[D1, S1].EI W) : P0.TyL[D0, S0].EI W = mS2 W (mS1 W v) ;
  mSpt (W : Ob) (v : P1.TyL[D1, S1].EI W) : Id (W0.Ix (D0.ob W)) (mS W v).1 (s W v.1) =
    transH (mSpt2 W (mS1 W v)) (apH (s2 W) (mSpt1 W v)) ;
  mSnat (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, S1].EI W)
    : Id (P0.TyL[D0, S0].EI V) (P0.TyL[D0, S0].E.act V W g (mS W v)) (mS V (P1.TyL[D1, S1].E.act V W g v)) =
    transH (mSnat2 V W g (mS1 W v)) (apH (mS2 V) (mSnat1 V W g v)) ;
  mT (W : Ob) (v : TT1.EI W) : TT0.EI W = mT2 W (mT1 W v) ;
  mTnat (V W : Ob) (g : Hom V W) (v : TT1.EI W) : Id (TT0.EI V) (TT0.E.act V W g (mT W v)) (mT V (TT1.E.act V W g v)) =
    transH (mTnat2 V W g (mT1 W v)) (apH (mT2 V) (mTnat1 V W g v)) ;
  mTpt (W : Ob) (v : TT1.EI W) : Id (W0.Ix (D0.ob W)) (mT W v).1 (s W v.1) = transH (mTpt2 W (mT1 W v)) (apH (s2 W) (mTpt1 W v)) ;
  mTinj (W : Ob) (v v' : TT1.EI W) (P : Id (W1.Ix (D1.ob W)) v.1 v'.1) (Q : Id (TT0.EI W) (mT W v) (mT W v')) : Id (TT1.EI W) v v' =
    mTinj1 W v v' P (mTinj2 W (mT1 W v) (mT1 W v') (transH (mTpt1 W v) (transH (apH (s1 W) P) (symH (mTpt1 W v')))) Q) ;
  bk (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (T0.tob X (s X x))) : W1.Ix (T1.tob X x) = bk1 X x (bk2 X (s1 X x) u) ;
  bkMv (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (T0.tob X (s X x))) : Id (TT0.EI X) (mT X (x, bk X x u)) (s X x, u) =
    transH (apH (mT2 X) (bkMv1 X x (bk2 X (s1 X x) u))) (bkMv2 X (s1 X x) u) ;
  sq (W : Ob) (v : P1.TyL[D1, S1].EI W) : Id (TT0.EI W) (mT W (m1.mE W v)) (m0.mE W (mS W v)) =
    transH (apH (mT2 W) (sq1 W v)) (sq2 W (mS1 W v)) ;

  module MC = CMove[k, i].Mv[D1, S1, T1, m1, D0, S0, T0, m0, s, s-nat, mS, mSpt, mSnat, mT, mTpt, mTnat, mTinj, bk, bkMv, sq, k0] ;

  -- moving twice is moving along the composite
  comp : Id (CPartial[i].Rel[D1, S1, T1, m1].RC) M1.rc MC.rc =
    MC.unique M1.rc (\ X x sd ->
      transH (apH (mT2 X) (M1.kopMv X x sd))
        (transH (M2.kopMv X (s1 X x) (M1.mside X x sd))
          (apH {CPartial[k].Partials[D0, S0].Side[X, s X x]} {TT0.EI X} (\ z -> (s X x, k0.kop X (s X x) z))
             (CPartial[k].Partials[D0, S0].side-ext X (s X x) (M2.mside X (s1 X x) (M1.mside X x sd)) (MC.mside X x sd)
                (refl sd.pQ) (\ W f i0 i0' -> apH (\ q -> mS W (sd.pv W f q)) (isProp-Lands W X sd.pQ f i0 i0')))))) ;
} ;

------------------------------------------------------------------------
-- identity: moving along the identity, with identity maps, does nothing

module Id1 (D : P1.PS.PCtx) (S T : P1.PS.PTy[D]) (m : CPartial[i].PMap[D, S, T]) (k0 : CPartial[i].Rel[D, S, T, m].RC) {
  module TT = P1.TyL[D, T] ;
  module M = CMove[i, i].Mv[D, S, T, m, D, S, T, m, \ W d -> d, \ V W g d -> refl (D.act V W g d),
    \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (P1.TyL[D, S].E.act V W g v),
    \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (TT.E.act V W g v),
    \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> refl (m.mE W v), k0] ;

  idm : Id (CPartial[i].Rel[D, S, T, m].RC) k0 M.rc =
    M.unique k0 (\ X x sd ->
      apH {CPartial[i].Partials[D, S].Side[X, x]} {TT.EI X} (\ z -> (x, k0.kop X x z))
        (CPartial[i].Partials[D, S].side-ext X x sd (M.mside X x sd) (refl sd.pQ) (\ W f h h' -> CPartial[i].Partials[D, S].pv-irr X x sd W f h h'))) ;
} ;

------------------------------------------------------------------------
-- congruence: the moved structure depends only on the maps, up to
-- pointwise equality (s , mS , mT)

module Cong (D : P1.PS.PCtx) (S T : P1.PS.PTy[D]) (m : CPartial[i].PMap[D, S, T])
  (D0 : P0.PS.PCtx) (S0 T0 : P0.PS.PTy[D0]) (m0 : CPartial[k].PMap[D0, S0, T0])
  (s1 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (D0.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (D0.ob V)) (s1 V (D.act V W g d)) (D0.act V W g (s1 W d)))
  (mS1 : (W : Ob) -> P1.TyL[D, S].EI W -> P0.TyL[D0, S0].EI W)
  (mSpt1 : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (W0.Ix (D0.ob W)) (mS1 W v).1 (s1 W v.1))
  (mSnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, S].EI W)
     -> Id (P0.TyL[D0, S0].EI V) (P0.TyL[D0, S0].E.act V W g (mS1 W v)) (mS1 V (P1.TyL[D, S].E.act V W g v)))
  (mT1 : (W : Ob) -> P1.TyL[D, T].EI W -> P0.TyL[D0, T0].EI W)
  (mTpt1 : (W : Ob) (v : P1.TyL[D, T].EI W) -> Id (W0.Ix (D0.ob W)) (mT1 W v).1 (s1 W v.1))
  (mTnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, T].EI W)
     -> Id (P0.TyL[D0, T0].EI V) (P0.TyL[D0, T0].E.act V W g (mT1 W v)) (mT1 V (P1.TyL[D, T].E.act V W g v)))
  (mTinj1 : (W : Ob) (v v' : P1.TyL[D, T].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[D0, T0].EI W) (mT1 W v) (mT1 W v'))
     -> Id (P1.TyL[D, T].EI W) v v')
  (bk1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s1 X x))) -> W1.Ix (T.tob X x))
  (bkMv1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s1 X x))) -> Id (P0.TyL[D0, T0].EI X) (mT1 X (x, bk1 X x u)) (s1 X x, u))
  (sq1 : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (P0.TyL[D0, T0].EI W) (mT1 W (m.mE W v)) (m0.mE W (mS1 W v)))
  (s2 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (D0.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (D0.ob V)) (s2 V (D.act V W g d)) (D0.act V W g (s2 W d)))
  (mS2 : (W : Ob) -> P1.TyL[D, S].EI W -> P0.TyL[D0, S0].EI W)
  (mSpt2 : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (W0.Ix (D0.ob W)) (mS2 W v).1 (s2 W v.1))
  (mSnat2 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, S].EI W)
     -> Id (P0.TyL[D0, S0].EI V) (P0.TyL[D0, S0].E.act V W g (mS2 W v)) (mS2 V (P1.TyL[D, S].E.act V W g v)))
  (mT2 : (W : Ob) -> P1.TyL[D, T].EI W -> P0.TyL[D0, T0].EI W)
  (mTpt2 : (W : Ob) (v : P1.TyL[D, T].EI W) -> Id (W0.Ix (D0.ob W)) (mT2 W v).1 (s2 W v.1))
  (mTnat2 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, T].EI W)
     -> Id (P0.TyL[D0, T0].EI V) (P0.TyL[D0, T0].E.act V W g (mT2 W v)) (mT2 V (P1.TyL[D, T].E.act V W g v)))
  (mTinj2 : (W : Ob) (v v' : P1.TyL[D, T].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[D0, T0].EI W) (mT2 W v) (mT2 W v'))
     -> Id (P1.TyL[D, T].EI W) v v')
  (bk2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s2 X x))) -> W1.Ix (T.tob X x))
  (bkMv2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s2 X x))) -> Id (P0.TyL[D0, T0].EI X) (mT2 X (x, bk2 X x u)) (s2 X x, u))
  (sq2 : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (P0.TyL[D0, T0].EI W) (mT2 W (m.mE W v)) (m0.mE W (mS2 W v)))
  (Ps : (W : Ob) (x : W1.Ix (D.ob W)) -> Id (W0.Ix (D0.ob W)) (s1 W x) (s2 W x))
  (PmS : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (P0.TyL[D0, S0].EI W) (mS1 W v) (mS2 W v))
  (PmT : (W : Ob) (v : P1.TyL[D, T].EI W) -> Id (P0.TyL[D0, T0].EI W) (mT1 W v) (mT2 W v))
  (k0 : CPartial[k].Rel[D0, S0, T0, m0].RC) {
  module PG = CPartial[k].Partials[D0, S0] ;
  module RG = CPartial[k].Rel[D0, S0, T0, m0] ;
  module M1 = CMove[k, i].Mv[D, S, T, m, D0, S0, T0, m0, s1, s-nat1, mS1, mSpt1, mSnat1, mT1, mTpt1, mTnat1, mTinj1, bk1, bkMv1, sq1, k0] ;
  module M2 = CMove[k, i].Mv[D, S, T, m, D0, S0, T0, m0, s2, s-nat2, mS2, mSpt2, mSnat2, mT2, mTpt2, mTnat2, mTinj2, bk2, bkMv2, sq2, k0] ;

  cong : Id (CPartial[i].Rel[D, S, T, m].RC) M1.rc M2.rc =
    M2.unique M1.rc (\ X x sd ->
      transH (symH (PmT X (x, M1.kop X x sd)))
        (transH (M1.kopMv X x sd)
          (RG.kop-cong k0 X (s1 X x) (s2 X x) (Ps X x) (M1.mside X x sd) (M2.mside X x sd)
             (PG.side-extH X (s1 X x) (s2 X x) (Ps X x) (M1.mside X x sd) (M2.mside X x sd) (refl sd.pQ)
                (\ W f h h' -> transH (PmS W (sd.pv W f h)) (apH (\ q -> mS2 W (sd.pv W f q)) (isProp-Lands W X sd.pQ f h h'))))))) ;

  opaque cong ;
} ;
