-- CCartLaws.seg (L3, inside CB, level l): the laws of moving compositions
-- and fibration structures along cartesian maps (model.tex Lemma
-- move-laws, Prop "substitution": c[id] = c, c[st] = c[s][t]).
--
--   CC   moving along two carts is moving along their composite
--   CI   moving along the identity cart does nothing
--
-- Each is Move's law (CMoveLaws.Comp / Id1), then Cong with the pointwise
-- equalities of the moved data (ends, strict-fibre elements, composites).
-- Quarry: seg/model GFibLaws (MorComp), GFibExt (MorId).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module CC (D1 : PCtx) (A1 : PTy[D1]) (D : PCtx) (A' : PTy[D]) (G : PCtx) (A : PTy[G])
  (s1 : (W : Ob) -> W0.Ix (D1.ob W) -> W0.Ix (D.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W0.Ix (D1.ob W)) -> Id (W0.Ix (D.ob V)) (s1 V (D1.act V W g d)) (D.act V W g (s1 W d)))
  (ta1 : (W : Ob) -> GPR.TyL[D1, A1].EI W -> GPR.TyL[D, A'].EI W)
  (tapt1 : (W : Ob) (v : GPR.TyL[D1, A1].EI W) -> Id (W0.Ix (D.ob W)) (ta1 W v).1 (s1 W v.1))
  (tanat1 : (V W : Ob) (g : Hom V W) (v : GPR.TyL[D1, A1].EI W)
     -> Id (GPR.TyL[D, A'].EI V) (GPR.TyL[D, A'].E.act V W g (ta1 W v)) (ta1 V (GPR.TyL[D1, A1].E.act V W g v)))
  (tainj1 : (W : Ob) (v v' : GPR.TyL[D1, A1].EI W) (P : Id (W0.Ix (D1.ob W)) v.1 v'.1) (Q : Id (GPR.TyL[D, A'].EI W) (ta1 W v) (ta1 W v'))
     -> Id (GPR.TyL[D1, A1].EI W) v v')
  (bk1 : (X : Ob) (x : W0.Ix (D1.ob X)) (u : W0.Ix (A'.tob X (s1 X x))) -> W0.Ix (A1.tob X x))
  (bkta1 : (X : Ob) (x : W0.Ix (D1.ob X)) (u : W0.Ix (A'.tob X (s1 X x))) -> Id (GPR.TyL[D, A'].EI X) (ta1 X (x, bk1 X x u)) (s1 X x, u))
  (s2 : (W : Ob) -> W0.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W0.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s2 V (D.act V W g d)) (G.act V W g (s2 W d)))
  (ta2 : (W : Ob) -> GPR.TyL[D, A'].EI W -> GPR.TyL[G, A].EI W)
  (tapt2 : (W : Ob) (v : GPR.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta2 W v).1 (s2 W v.1))
  (tanat2 : (V W : Ob) (g : Hom V W) (v : GPR.TyL[D, A'].EI W)
     -> Id (GPR.TyL[G, A].EI V) (GPR.TyL[G, A].E.act V W g (ta2 W v)) (ta2 V (GPR.TyL[D, A'].E.act V W g v)))
  (tainj2 : (W : Ob) (v v' : GPR.TyL[D, A'].EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (GPR.TyL[G, A].EI W) (ta2 W v) (ta2 W v'))
     -> Id (GPR.TyL[D, A'].EI W) v v')
  (bk2 : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> W0.Ix (A'.tob X x))
  (bkta2 : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> Id (GPR.TyL[G, A].EI X) (ta2 X (x, bk2 X x u)) (s2 X x, u)) {
  module C1 = CCart[l, l].Cart[D1, A1, D, A', s1, s-nat1, ta1, tapt1, tanat1, tainj1, bk1, bkta1] ;
  module C2 = CCart[l, l].Cart[D, A', G, A, s2, s-nat2, ta2, tapt2, tanat2, tainj2, bk2, bkta2] ;

  -- the composite cart
  s (W : Ob) (d : W0.Ix (D1.ob W)) : W0.Ix (G.ob W) = s2 W (s1 W d) ;
  s-nat (V W : Ob) (g : Hom V W) (d : W0.Ix (D1.ob W)) : Id (W0.Ix (G.ob V)) (s V (D1.act V W g d)) (G.act V W g (s W d)) =
    transH (apH (s2 V) (s-nat1 V W g d)) (s-nat2 V W g (s1 W d)) ;
  ta (W : Ob) (v : GPR.TyL[D1, A1].EI W) : GPR.TyL[G, A].EI W = ta2 W (ta1 W v) ;
  tapt (W : Ob) (v : GPR.TyL[D1, A1].EI W) : Id (W0.Ix (G.ob W)) (ta W v).1 (s W v.1) = transH (tapt2 W (ta1 W v)) (apH (s2 W) (tapt1 W v)) ;
  tanat (V W : Ob) (g : Hom V W) (v : GPR.TyL[D1, A1].EI W)
    : Id (GPR.TyL[G, A].EI V) (GPR.TyL[G, A].E.act V W g (ta W v)) (ta V (GPR.TyL[D1, A1].E.act V W g v)) =
    transH (tanat2 V W g (ta1 W v)) (apH (ta2 V) (tanat1 V W g v)) ;
  tainj (W : Ob) (v v' : GPR.TyL[D1, A1].EI W) (P : Id (W0.Ix (D1.ob W)) v.1 v'.1) (Q : Id (GPR.TyL[G, A].EI W) (ta W v) (ta W v'))
    : Id (GPR.TyL[D1, A1].EI W) v v' =
    tainj1 W v v' P (tainj2 W (ta1 W v) (ta1 W v') (transH (tapt1 W v) (transH (apH (s1 W) P) (symH (tapt1 W v')))) Q) ;
  bk (X : Ob) (x : W0.Ix (D1.ob X)) (u : W0.Ix (A.tob X (s X x))) : W0.Ix (A1.tob X x) = bk1 X x (bk2 X (s1 X x) u) ;
  bkta (X : Ob) (x : W0.Ix (D1.ob X)) (u : W0.Ix (A.tob X (s X x))) : Id (GPR.TyL[G, A].EI X) (ta X (x, bk X x u)) (s X x, u) =
    transH (apH (ta2 X) (bkta1 X x (bk2 X (s1 X x) u))) (bkta2 X (s1 X x) u) ;

  module C12 = CCart[l, l].Cart[D1, A1, G, A, s, s-nat, ta, tapt, tanat, tainj, bk, bkta] ;

  -- the moved ends agree
  Ps (e : IPt) (W : Ob) (z : C1.AtEnd[e].EK'.TV.EI W) : Id (C12.AtEnd[e].EK.TV.EI W) (C2.AtEnd[e].sV W (C1.AtEnd[e].sV W z)) (C12.AtEnd[e].sV W z) =
    C12.AtEnd[e].EK.tv-eq W (C2.AtEnd[e].sV W (C1.AtEnd[e].sV W z)) (C12.AtEnd[e].sV W z)
      (C12.FG.fam-eq W (C2.sI W (C1.sI W z.1)) (C12.sI W z.1) (\ V g j -> refl (s2 V (s1 V (z.1.1 V g j)))))
      (transH (C2.AtEnd[e].sVE W (C1.AtEnd[e].sV W z)) (transH (apH (ta2 W) (C1.AtEnd[e].sVE W z)) (symH (C12.AtEnd[e].sVE W z)))) ;

  module E (e e' : IPt) (c : CLine[l].Lines[G, A].CompK[e, e'].Comp) {
    module M1 = C1.MoveComp[e, e'] ;
    module M2 = C2.MoveComp[e, e'] ;
    module M12 = C12.MoveComp[e, e'] ;
    module A1e = C1.AtEnd[e] ;
    module A2e = C2.AtEnd[e] ;
    module A12e = C12.AtEnd[e] ;

    module CP = CMoveLaws[l, l, l].Comp[A1e.EK'.TV.E, A1e.EK'.SFm.SF, M1.CK'.Tend, M1.CK'.endL,
      A2e.EK'.TV.E, A2e.EK'.SFm.SF, M2.CK'.Tend, M2.CK'.endL,
      A2e.EK.TV.E, A2e.EK.SFm.SF, M2.CK.Tend, M2.CK.endL,
      A1e.sV, A1e.sV-nat, A1e.mS, A1e.mSpt, A1e.mSnat, M1.mT, \ W v -> refl (A1e.sV W v.1), M1.mTnat, M1.mTinj, M1.bkT, M1.bkMv, M1.sq,
      A2e.sV, A2e.sV-nat, A2e.mS, A2e.mSpt, A2e.mSnat, M2.mT, \ W v -> refl (A2e.sV W v.1), M2.mTnat, M2.mTinj, M2.bkT, M2.bkMv, M2.sq, c] ;

    PmS (W : Ob) (u : A1e.EK'.TS.EI W) : Id (A12e.EK.TS.EI W) (A2e.mS W (A1e.mS W u)) (A12e.mS W u) =
      A12e.EK.ts-ext W (A2e.mS W (A1e.mS W u)) (A12e.mS W u)
        (transH (A2e.mSpt W (A1e.mS W u)) (transH (apH (A2e.sV W) (A1e.mSpt W u)) (transH (Ps e W u.1) (symH (A12e.mSpt W u)))))
        (\ V g j -> transH (apH (\ M -> M.2.1.1 V g j) (A2e.mS-line W (A1e.mS W u)))
           (transH (apH (\ M -> ta2 V (M.2.1.1 V g j)) (A1e.mS-line W u)) (symH (apH (\ M -> M.2.1.1 V g j) (A12e.mS-line W u))))) ;

    PmT (W : Ob) (v : M1.TT'.EI W) : Id (M12.TT.EI W) (M2.mT W (M1.mT W v)) (M12.mT W v) =
      M12.CK.SE.mV-inj W (M2.mT W (M1.mT W v)) (M12.mT W v) (Ps e W v.1) (Ps e' W (M1.CK'.SE.mV W v)) ;

    comp : Id (M1.CK'.Comp) (M1.move (M2.move c)) (M12.move c) =
      transH CP.comp
        (CMoveLaws[l, l, l].Cong[A1e.EK'.TV.E, A1e.EK'.SFm.SF, M1.CK'.Tend, M1.CK'.endL,
          A2e.EK.TV.E, A2e.EK.SFm.SF, M2.CK.Tend, M2.CK.endL,
          CP.s, CP.s-nat, CP.mS, CP.mSpt, CP.mSnat, CP.mT, CP.mTpt, CP.mTnat, CP.mTinj, CP.bk, CP.bkMv, CP.sq,
          A12e.sV, A12e.sV-nat, A12e.mS, A12e.mSpt, A12e.mSnat, M12.mT, \ W v -> refl (A12e.sV W v.1), M12.mTnat, M12.mTinj, M12.bkT, M12.bkMv, M12.sq,
          Ps e, PmS, PmT, c].cong) ;
  } ;

  -- fibration structures
  compFib (c : CLine[l].Lines[G, A].Fib) : Id (CLine[l].Lines[D1, A1].Fib) (C1.moveFib (C2.moveFib c)) (C12.moveFib c) =
    transH (apH {CLine[l].Lines[D1, A1].CompK[e0, e1].Comp} {CLine[l].Lines[D1, A1].Fib} (\ z -> (z, (C1.moveFib (C2.moveFib c)).2)) E[e0, e1, c.1].comp)
           (apH {CLine[l].Lines[D1, A1].CompK[e1, e0].Comp} {CLine[l].Lines[D1, A1].Fib} (\ z -> ((C12.moveFib c).1, z)) E[e1, e0, c.2].comp) ;
} ;


-- carts with pointwise equal maps move alike
module CG (D : PCtx) (A' : PTy[D]) (G : PCtx) (A : PTy[G])
  (s1 : (W : Ob) -> W0.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W0.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s1 V (D.act V W g d)) (G.act V W g (s1 W d)))
  (ta1 : (W : Ob) -> GPR.TyL[D, A'].EI W -> GPR.TyL[G, A].EI W)
  (tapt1 : (W : Ob) (v : GPR.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta1 W v).1 (s1 W v.1))
  (tanat1 : (V W : Ob) (g : Hom V W) (v : GPR.TyL[D, A'].EI W)
     -> Id (GPR.TyL[G, A].EI V) (GPR.TyL[G, A].E.act V W g (ta1 W v)) (ta1 V (GPR.TyL[D, A'].E.act V W g v)))
  (tainj1 : (W : Ob) (v v' : GPR.TyL[D, A'].EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (GPR.TyL[G, A].EI W) (ta1 W v) (ta1 W v'))
     -> Id (GPR.TyL[D, A'].EI W) v v')
  (bk1 : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X (s1 X x))) -> W0.Ix (A'.tob X x))
  (bkta1 : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X (s1 X x))) -> Id (GPR.TyL[G, A].EI X) (ta1 X (x, bk1 X x u)) (s1 X x, u))
  (s2 : (W : Ob) -> W0.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W0.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s2 V (D.act V W g d)) (G.act V W g (s2 W d)))
  (ta2 : (W : Ob) -> GPR.TyL[D, A'].EI W -> GPR.TyL[G, A].EI W)
  (tapt2 : (W : Ob) (v : GPR.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta2 W v).1 (s2 W v.1))
  (tanat2 : (V W : Ob) (g : Hom V W) (v : GPR.TyL[D, A'].EI W)
     -> Id (GPR.TyL[G, A].EI V) (GPR.TyL[G, A].E.act V W g (ta2 W v)) (ta2 V (GPR.TyL[D, A'].E.act V W g v)))
  (tainj2 : (W : Ob) (v v' : GPR.TyL[D, A'].EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (GPR.TyL[G, A].EI W) (ta2 W v) (ta2 W v'))
     -> Id (GPR.TyL[D, A'].EI W) v v')
  (bk2 : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> W0.Ix (A'.tob X x))
  (bkta2 : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> Id (GPR.TyL[G, A].EI X) (ta2 X (x, bk2 X x u)) (s2 X x, u))
  (Ps : (W : Ob) (x : W0.Ix (D.ob W)) -> Id (W0.Ix (G.ob W)) (s1 W x) (s2 W x))
  (Pta : (W : Ob) (v : GPR.TyL[D, A'].EI W) -> Id (GPR.TyL[G, A].EI W) (ta1 W v) (ta2 W v)) {
  module C1 = CCart[l, l].Cart[D, A', G, A, s1, s-nat1, ta1, tapt1, tanat1, tainj1, bk1, bkta1] ;
  module C2 = CCart[l, l].Cart[D, A', G, A, s2, s-nat2, ta2, tapt2, tanat2, tainj2, bk2, bkta2] ;

  PsV (e : IPt) (W : Ob) (z : C1.AtEnd[e].EK'.TV.EI W) : Id (C1.AtEnd[e].EK.TV.EI W) (C1.AtEnd[e].sV W z) (C2.AtEnd[e].sV W z) =
    C1.AtEnd[e].EK.tv-eq W (C1.AtEnd[e].sV W z) (C2.AtEnd[e].sV W z)
      (C1.FG.fam-eq W (C1.sI W z.1) (C2.sI W z.1) (\ V g j -> Ps V (z.1.1 V g j)))
      (transH (C1.AtEnd[e].sVE W z) (transH (Pta W (C1.AtEnd[e].EK'.endE W z)) (symH (C2.AtEnd[e].sVE W z)))) ;

  module E (e e' : IPt) (c : CLine[l].Lines[G, A].CompK[e, e'].Comp) {
    module M1 = C1.MoveComp[e, e'] ;
    module M2 = C2.MoveComp[e, e'] ;
    module A1e = C1.AtEnd[e] ;
    module A2e = C2.AtEnd[e] ;

    PmS (W : Ob) (u : A1e.EK'.TS.EI W) : Id (A1e.EK.TS.EI W) (A1e.mS W u) (A2e.mS W u) =
      A1e.EK.ts-ext W (A1e.mS W u) (A2e.mS W u)
        (transH (A1e.mSpt W u) (transH (PsV e W u.1) (symH (A2e.mSpt W u))))
        (\ V g j -> transH (apH (\ M -> M.2.1.1 V g j) (A1e.mS-line W u))
           (transH (Pta V ((A1e.EK'.lineL W u).2.1.1 V g j)) (symH (apH (\ M -> M.2.1.1 V g j) (A2e.mS-line W u))))) ;

    PmT (W : Ob) (v : M1.TT'.EI W) : Id (M1.TT.EI W) (M1.mT W v) (M2.mT W v) =
      M1.CK.SE.mV-inj W (M1.mT W v) (M2.mT W v) (PsV e W v.1) (PsV e' W (M1.CK'.SE.mV W v)) ;

    cong : Id (M1.CK'.Comp) (M1.move c) (M2.move c) =
      CMoveLaws[l, l, l].Cong[A1e.EK'.TV.E, A1e.EK'.SFm.SF, M1.CK'.Tend, M1.CK'.endL,
        A1e.EK.TV.E, A1e.EK.SFm.SF, M1.CK.Tend, M1.CK.endL,
        A1e.sV, A1e.sV-nat, A1e.mS, A1e.mSpt, A1e.mSnat, M1.mT, \ W v -> refl (A1e.sV W v.1), M1.mTnat, M1.mTinj, M1.bkT, M1.bkMv, M1.sq,
        A2e.sV, A2e.sV-nat, A2e.mS, A2e.mSpt, A2e.mSnat, M2.mT, \ W v -> refl (A2e.sV W v.1), M2.mTnat, M2.mTinj, M2.bkT, M2.bkMv, M2.sq,
        PsV e, PmS, PmT, c].cong ;
  } ;

  congFib (c : CLine[l].Lines[G, A].Fib) : Id (CLine[l].Lines[D, A'].Fib) (C1.moveFib c) (C2.moveFib c) =
    transH (apH {CLine[l].Lines[D, A'].CompK[e0, e1].Comp} {CLine[l].Lines[D, A'].Fib} (\ z -> (z, (C1.moveFib c).2)) E[e0, e1, c.1].cong)
           (apH {CLine[l].Lines[D, A'].CompK[e1, e0].Comp} {CLine[l].Lines[D, A'].Fib} (\ z -> ((C2.moveFib c).1, z)) E[e1, e0, c.2].cong) ;
} ;

-- the identity cart (identity maps, any naturality proof) moves nothing
module CI (G : PCtx) (A : PTy[G])
  (tanat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[G, A].EI W)
     -> Id (GPR.TyL[G, A].EI V) (GPR.TyL[G, A].E.act V W g v) (GPR.TyL[G, A].E.act V W g v)) {
  module C = CCart[l, l].Cart[G, A, G, A, \ W x -> x, \ V W g x -> refl (G.act V W g x),
    \ W v -> v, \ W v -> refl v.1, tanat, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u)] ;

  PsV (e : IPt) (W : Ob) (z : C.AtEnd[e].EK'.TV.EI W) : Id (C.AtEnd[e].EK.TV.EI W) z (C.AtEnd[e].sV W z) =
    C.AtEnd[e].EK.tv-eq W z (C.AtEnd[e].sV W z) (C.FG.fam-eq W z.1 (C.sI W z.1) (\ V g j -> refl (z.1.1 V g j)))
      (symH (C.AtEnd[e].sVE W z)) ;

  module E (e e' : IPt) (c : CLine[l].Lines[G, A].CompK[e, e'].Comp) {
    module M = C.MoveComp[e, e'] ;
    module Ae = C.AtEnd[e] ;
    module I1 = CMoveLaws[l, l, l].Id1[Ae.EK.TV.E, Ae.EK.SFm.SF, M.CK.Tend, M.CK.endL, c] ;

    PmS (W : Ob) (u : Ae.EK.TS.EI W) : Id (Ae.EK.TS.EI W) u (Ae.mS W u) =
      Ae.EK.ts-ext W u (Ae.mS W u) (transH (PsV e W u.1) (symH (Ae.mSpt W u)))
        (\ V g j -> symH (apH (\ M2 -> M2.2.1.1 V g j) (Ae.mS-line W u))) ;

    PmT (W : Ob) (v : M.TT.EI W) : Id (M.TT.EI W) v (M.mT W v) =
      M.CK.SE.mV-inj W v (M.mT W v) (PsV e W v.1) (PsV e' W (M.CK.SE.mV W v)) ;

    idm : Id (M.CK.Comp) c (M.move c) =
      transH I1.idm
        (CMoveLaws[l, l, l].Cong[Ae.EK.TV.E, Ae.EK.SFm.SF, M.CK.Tend, M.CK.endL,
          Ae.EK.TV.E, Ae.EK.SFm.SF, M.CK.Tend, M.CK.endL,
          \ W d -> d, \ V W g d -> refl (Ae.EK.TV.E.act V W g d),
          \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (Ae.EK.TS.E.act V W g v),
          \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (M.TT.E.act V W g v),
          \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> refl (M.CK.endL.mE W v),
          Ae.sV, Ae.sV-nat, Ae.mS, Ae.mSpt, Ae.mSnat, M.mT, \ W v -> refl (Ae.sV W v.1), M.mTnat, M.mTinj, M.bkT, M.bkMv, M.sq,
          PsV e, PmS, PmT, c].cong) ;
  } ;

  idFib (c : CLine[l].Lines[G, A].Fib) : Id (CLine[l].Lines[G, A].Fib) c (C.moveFib c) =
    transH (apH {CLine[l].Lines[G, A].CompK[e0, e1].Comp} {CLine[l].Lines[G, A].Fib} (\ z -> (z, c.2)) E[e0, e1, c.1].idm)
           (apH {CLine[l].Lines[G, A].CompK[e1, e0].Comp} {CLine[l].Lines[G, A].Fib} (\ z -> ((C.moveFib c).1, z)) E[e1, e0, c.2].idm) ;
} ;
