-- COp.seg (L2, inside CB, any level l >= a): operations without
-- uniformity, for a family of sieves (model.tex: Construction "move" for
-- operations without uniformity).  An index set I, a condition ok on
-- it, and for each index an object ob i with a sieve S i on it; for a type
-- A over G:
--
--   HData i rho   an element of A on the sieve S i at rho : G(ob i)
--   FExt i rho h  an extension of it to ob i
--   Op            a filling operation (no uniformity)
--   op-ext        two operations are equal when their fillers are
--
-- Delta's horn filling is the instance I = Nat * Nat, ok (m , k) =
-- k <= m+1, ob = [m+1], S = the horn.  Quarry: seg/model GFillS.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module WL = V[l] ;
module GPL = GPre[l] ;
open GPL.PS ;

module OpS (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (i : I) -> Phi (ob i)) (G : PCtx) (A : PTy[G]) {
  open GPL.TyL[G, A] ;
  module PT = CPartial[l].Partials[G, A] ;

  HData (i : I) (rho : Pt (ob i)) : U l =
    (v : PT.PvTy (ob i) (S i)) * (PT.PptTy (ob i) rho (S i) v * PT.PnTy (ob i) (S i) v) ;

  Cond (i : I) (rho : Pt (ob i)) (h : HData i rho) (a0 : T (ob i) rho) : U l =
    (W : Ob) (f : Hom W (ob i)) (j : Lands W (ob i) (S i) f) -> Id (EI W) (E.act W (ob i) f (rho, a0)) (h.1 W f j) ;

  FExt (i : I) (rho : Pt (ob i)) (h : HData i rho) : U l = (a0 : T (ob i) rho) * Cond i rho h a0 ;

  Op : U l = (i : I) -> ok i -> (rho : Pt (ob i)) -> (h : HData i rho) -> FExt i rho h ;

  -- the side condition of an extension is a proposition
  isProp-Cond (i : I) (rho : Pt (ob i)) (h : HData i rho) (a0 : T (ob i) rho) : isProp (Cond i rho h a0) =
    isProp-Pi Ob (\ W -> (f : Hom W (ob i)) (j : Lands W (ob i) (S i) f) -> Id (EI W) (E.act W (ob i) f (rho, a0)) (h.1 W f j)) (\ W ->
    isProp-Pi (Hom W (ob i)) (\ f -> (j : Lands W (ob i) (S i) f) -> Id (EI W) (E.act W (ob i) f (rho, a0)) (h.1 W f j)) (\ f ->
    isProp-Pi (Lands W (ob i) (S i) f) (\ j -> Id (EI W) (E.act W (ob i) f (rho, a0)) (h.1 W f j)) (\ j ->
      WL.isSetIx (E.ob W) (E.act W (ob i) f (rho, a0)) (h.1 W f j)))) ;

  opaque isProp-Cond ;

  -- two operations with the same fillers are equal
  op-ext (c c' : Op) (H : (i : I) (o : ok i) (rho : Pt (ob i)) (h : HData i rho) -> Id (T (ob i) rho) (c i o rho h).1 (c' i o rho h).1)
    : Id Op c c' =
    funext I (\ i -> ok i -> (rho : Pt (ob i)) -> (h : HData i rho) -> FExt i rho h) c c' (\ i ->
    funext (ok i) (\ o -> (rho : Pt (ob i)) -> (h : HData i rho) -> FExt i rho h) (c i) (c' i) (\ o ->
    funext (Pt (ob i)) (\ rho -> (h : HData i rho) -> FExt i rho h) (c i o) (c' i o) (\ rho ->
    funext (HData i rho) (\ h -> FExt i rho h) (c i o rho) (c' i o rho) (\ h ->
      Sigma-eq (T (ob i) rho) (\ a0 -> Cond i rho h a0) (c i o rho h).1 (c' i o rho h).1 (c i o rho h).2 (c' i o rho h).2
        (H i o rho h) (isProp-Cond i rho h (c' i o rho h).1))))) ;

  opaque op-ext ;

  -- data with the same values are equal
  hd-eq (i : I) (rho : Pt (ob i)) (h h' : HData i rho) (P : Id (PT.PvTy (ob i) (S i)) h.1 h'.1) : Id (HData i rho) h h' =
    Sigma-eq (PT.PvTy (ob i) (S i))
      (\ v -> PT.PptTy (ob i) rho (S i) v * PT.PnTy (ob i) (S i) v) h.1 h'.1 h.2 h'.2 P
      (isProp-Sigma (PT.PptTy (ob i) rho (S i) h'.1) (\ z -> PT.PnTy (ob i) (S i) h'.1)
         (PT.isProp-Ppt (ob i) rho (S i) h'.1) (\ z -> PT.isProp-Pn (ob i) (S i) h'.1)) ;
} ;

------------------------------------------------------------------------
-- extensionality across types with the same objects part: equal pairs
-- (A , c) = (B q , c') when the actions agree pointwise and the fillers
-- agree on data with the same values (the naturality proofs are taken in
-- each type)

module OpExt (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (i : I) -> Phi (ob i)) (G : PCtx) (A : PTy[G]) {
  module F = OpS[I, ok, ob, S, G, A] ;
  module PP = CPartial[l].Partials[G, A] ;

  Pack : U l = (h : TactTy G A.tob) * (IdLaw G A.tob h * OLaw G A.tob h) ;

  packOf : Pack = (A.tact, (A.tact-id, A.tact-o)) ;

  B (q : Pack) : PTy[G] = mkTy G A.tob q.1 q.2.1 q.2.2 ;

  Agree (q : Pack) (c : F.Op) (c' : OpS[I, ok, ob, S, G, B q].Op) : U l =
    (i : I) (o : ok i) (rho : WL.Ix (G.ob (ob i))) (v : PP.PvTy (ob i) (S i)) (pp : PP.PptTy (ob i) rho (S i) v)
    (pnA : PP.PnTy (ob i) (S i) v) (pnB : CPartial[l].Partials[G, B q].PnTy (ob i) (S i) v)
    -> Id (WL.Ix (A.tob (ob i) rho)) (c i o rho (v, (pp, pnA))).1 (c' i o rho (v, (pp, pnB))).1 ;

  base (c c' : F.Op) (H : Agree packOf c c') : Id ((A' : PTy[G]) * OpS[I, ok, ob, S, G, A'].Op) (A, c) (A, c') =
    apH {F.Op} {(A' : PTy[G]) * OpS[I, ok, ob, S, G, A'].Op} (\ z -> (A, z))
      (F.op-ext c c' (\ i o rho h -> H i o rho h.1 h.2.1 h.2.2 h.2.2)) ;

  opaque base ;
} ;

-- The extensionality of OpExt, for every A.  The base case of the J below
-- needs  B packOf = A , which holds definitionally only for an A built with
-- new (records have no definitional eta), so the statement is proved for
-- every A by the eliminator of PTy.
module OpExtE (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (i : I) -> Phi (ob i)) (G : PCtx) {
  CoreTy (A : PTy[G]) : U l+ =
    (c : OpS[I, ok, ob, S, G, A].Op) (q : OpExt[I, ok, ob, S, G, A].Pack)
    (Q : Id (OpExt[I, ok, ob, S, G, A].Pack) (OpExt[I, ok, ob, S, G, A].packOf) q)
    (c' : OpS[I, ok, ob, S, G, OpExt[I, ok, ob, S, G, A].B q].Op) (H : OpExt[I, ok, ob, S, G, A].Agree q c c')
    -> Id ((A' : PTy[G]) * OpS[I, ok, ob, S, G, A'].Op) (A, c) (OpExt[I, ok, ob, S, G, A].B q, c') ;

  core : (A : PTy[G]) -> CoreTy A = split { PTy o h hi ho -> \ c q Q c' H ->
    idJ (OpExt[I, ok, ob, S, G, mkTy G o h hi ho].Pack) (OpExt[I, ok, ob, S, G, mkTy G o h hi ho].packOf)
      (\ q2 Q2 -> (c2 : OpS[I, ok, ob, S, G, OpExt[I, ok, ob, S, G, mkTy G o h hi ho].B q2].Op)
                  -> OpExt[I, ok, ob, S, G, mkTy G o h hi ho].Agree q2 c c2
                  -> Id ((A' : PTy[G]) * OpS[I, ok, ob, S, G, A'].Op) (mkTy G o h hi ho, c)
                        (OpExt[I, ok, ob, S, G, mkTy G o h hi ho].B q2, c2))
      (OpExt[I, ok, ob, S, G, mkTy G o h hi ho].base c) q Q c' H } ;

  isOpExt (A : PTy[G]) (c : OpS[I, ok, ob, S, G, A].Op) (q : OpExt[I, ok, ob, S, G, A].Pack)
    (Ht : PtEq G A.tob A.tact q.1) (c' : OpS[I, ok, ob, S, G, OpExt[I, ok, ob, S, G, A].B q].Op)
    (H : OpExt[I, ok, ob, S, G, A].Agree q c c')
    : Id ((A' : PTy[G]) * OpS[I, ok, ob, S, G, A'].Op) (A, c) (OpExt[I, ok, ob, S, G, A].B q, c') =
    core A c q
      (Sigma-eq (TactTy G A.tob) (\ h -> IdLaw G A.tob h * OLaw G A.tob h) A.tact q.1 (A.tact-id, A.tact-o) q.2
         (tact-funext G A.tob A.tact q.1 Ht)
         (isProp-Sigma (IdLaw G A.tob q.1) (\ z -> OLaw G A.tob q.1) (idLaw-prop G A.tob q.1) (\ z -> oLaw-prop G A.tob q.1)))
      c' H ;

  opaque core ; opaque isOpExt ;
} ;
