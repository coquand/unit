-- CEquiv.seg (L3, inside CB, level l): homotopy fibres and equivalence
-- structures (model.tex §3.3 item 5).  The fibre of al : B -> A at
-- (x , a) is the Sigma of b in B(x) and a path in A over x from al b to
-- (x , a); an equivalence structure is a ContrOp on it.
--
-- Quarry: seg/model GEquiv.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[l] ;
open GPR.PS ;
module PFm = PresheafFormers[a, l].PFormers[BC] ;

module HFib (D : PCtx) (B A : PTy[D]) (al : CPartial[l].PMap[D, B, A]) {
  module TA = GPR.TyL[D, A] ;
  module TB = GPR.TyL[D, B] ;

  EA : PCtx = TA.E ;

  -- B over E_A, and the context of the points (x , a , b)
  B1 : PTy[EA] = subTy EA D B (pP D A) ;
  EAB : PCtx = extP EA B1 ;
  module TAB = GPR.TyL[EA, B1] ;

  -- the point of D, the end alpha (x , b) and the end (x , a), in E
  sx (W : Ob) (y : W0.Ix (EAB.ob W)) : W0.Ix (D.ob W) = (TA.pr1 W (TAB.pr1 W y)) ;
  aE (W : Ob) (y : W0.Ix (EAB.ob W)) : TA.EI W = al.mE W (TB.pr W (TA.pr1 W (TAB.pr1 W y)) (TAB.pr2 W y)) ;
  bE (W : Ob) (y : W0.Ix (EAB.ob W)) : TA.EI W = (TAB.pr1 W y) ;

  -- the B part of a restricted point, read in E_B
  bAct (W X : Ob) (f : Hom W X) (y : W0.Ix (EAB.ob X))
    : Id (TB.EI W) (TB.E.act W X f (TB.pr X (TA.pr1 X (TAB.pr1 X y)) (TAB.pr2 X y))) (TB.pr W (TA.pr1 W (TAB.pr1 W (EAB.act W X f y))) (TAB.pr2 W (EAB.act W X f y))) =
    apH {W0.Ix (B.tob W (D.act W X f (TA.pr1 X (TAB.pr1 X y))))} {TB.EI W} (\ v -> (TB.pr W (D.act W X f (TA.pr1 X (TAB.pr1 X y))) v))
      (tact-irr D B W X f (TA.pr1 X (TAB.pr1 X y)) (D.act W X f (TA.pr1 X (TAB.pr1 X y))) (refl (D.act W X f (TA.pr1 X (TAB.pr1 X y))))
         (ntEq EA D (pP D A) W X f (TAB.pr1 X y) (EA.act W X f (TAB.pr1 X y)) (refl (EA.act W X f (TAB.pr1 X y)))) (TAB.pr2 X y)) ;

  aE-act (W X : Ob) (f : Hom W X) (y : W0.Ix (EAB.ob X)) : Id (TA.EI W) (TA.E.act W X f (aE X y)) (aE W (EAB.act W X f y)) =
    transH (symH (al.mnat W X f (TB.pr X (TA.pr1 X (TAB.pr1 X y)) (TAB.pr2 X y)))) (apH (al.mE W) (bAct W X f y)) ;

  bE-act (W X : Ob) (f : Hom W X) (y : W0.Ix (EAB.ob X)) : Id (TA.EI W) (TA.E.act W X f (bE X y)) (bE W (EAB.act W X f y)) =
    refl (TA.E.act W X f (TAB.pr1 X y)) ;

  opaque bAct ;

  -- the paths, and the fibre type
  module GL = GPR.PshL[EAB] ;

  sN (J I : Ob) (h : Hom J I) (x : W0.Ix (EAB.ob I)) (y : W0.Ix (EAB.ob J)) (e : Id (W0.Ix (EAB.ob J)) (EAB.act J I h x) y)
    (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (D.ob W)) (sx W (EAB.act W I (compH W J I h f) x)) (sx W (EAB.act W J f y)) =
    apH (sx W) (transH (symH (GL.actC W J I h f x)) (apH (EAB.act W J f) e)) ;

  module PE = CPath[l].PathOverE[EAB, D, A, true, \ X x W f i -> sx W (EAB.act W X f x), sN, aE, bE, aE-act, bE-act] ;

  module SG = PFm.SigAB[EA, B1, PE.PathP] ;

  FibT : PTy[EA] = SG.SigP ;

  ----------------------------------------------------------------------
  -- elements of the fibre type, read in E: the point (x , a), the B part
  -- and the line values

  module TF = GPR.TyL[EA, FibT] ;

  fibB (X : Ob) (v : TF.EI X) : TB.EI X = (TB.pr X (TA.pr1 X (TF.pr1 X v)) ((TF.pr2 X v).1)) ;

  fibL (X : Ob) (v : TF.EI X) (W : Ob) (f : Hom W X) (i : Hom W Iv) : TA.EI W = (TF.pr2 X v).2.1.1 W f i ;

  fibL-pt (X : Ob) (v : TF.EI X) (W : Ob) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (D.ob W)) (TA.pr1 W (fibL X v W f i)) (D.act W X f (TA.pr1 X (TF.pr1 X v))) = (TF.pr2 X v).2.2.1 W f i ;

  fibL-nat (X : Ob) (v : TF.EI X) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
    : Id (TA.EI V) (TA.E.act V W g (fibL X v W f i)) (fibL X v V (compH V W X f g) (compH V W Iv i g)) =
    (TF.pr2 X v).2.1.2 V W g f i ;

  fibL-0 (X : Ob) (v : TF.EI X) : Id (TA.EI X) (fibL X v X (idH X) (ptH X e0)) (al.mE X (fibB X v)) = (TF.pr2 X v).2.2.2.1 ;

  fibL-1 (X : Ob) (v : TF.EI X) : Id (TA.EI X) (fibL X v X (idH X) (ptH X e1)) (TF.pr1 X v) = (TF.pr2 X v).2.2.2.2 ;

  -- the action: the B part is acted on, the line is precomposed
  fibB-act (V X : Ob) (g : Hom V X) (v : TF.EI X) : Id (TB.EI V) (fibB V (TF.E.act V X g v)) (TB.E.act V X g (fibB X v)) =
    symH (bAct V X g (TAB.pr X (TF.pr1 X v) ((TF.pr2 X v).1))) ;

  fibL-act (V X : Ob) (g : Hom V X) (v : TF.EI X) (W : Ob) (f : Hom W V) (i : Hom W Iv)
    : Id (TA.EI W) (fibL V (TF.E.act V X g v) W f i) (fibL X v W (compH W V X g f) i) =
    refl (fibL X v W (compH W V X g f) i) ;

  -- an element from its point, its B part and a line with its conditions
  mkFib (X : Ob) (w : TA.EI X) (b : TB.T X (TA.pr1 X w)) (t : (W : Ob) -> Hom W X -> Hom W Iv -> TA.EI W)
    (tn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
          -> Id (TA.EI V) (TA.E.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g)))
    (tp : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (D.ob W)) (TA.pr1 W (t W f i)) (D.act W X f (TA.pr1 X w)))
    (t0 : Id (TA.EI X) (t X (idH X) (ptH X e0)) (al.mE X (TB.pr X (TA.pr1 X w) b))) (t1 : Id (TA.EI X) (t X (idH X) (ptH X e1)) w)
    : TF.EI X = (TF.pr X w (b, PE.mkPath X (TAB.pr X w b) t tn tp t0 t1)) ;

  -- an element is determined by its point, its B part and its line
  fibE-eq (X : Ob) (v v' : TF.EI X) (P : Id (TA.EI X) (TF.pr1 X v) (TF.pr1 X v')) (qb : Id (TB.EI X) (fibB X v) (fibB X v'))
    (ql : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI W) (fibL X v W f i) (fibL X v' W f i)) : Id (TF.EI X) v v' =
    idJ (TA.EI X) (TF.pr1 X v)
      (\ w2 P2 -> (u2 : W0.Ix (FibT.tob X w2)) -> Id (TB.EI X) (fibB X v) (fibB X (TF.pr X w2 u2))
         -> ((W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI W) (fibL X v W f i) (fibL X (TF.pr X w2 u2) W f i))
         -> Id (TF.EI X) v (TF.pr X w2 u2))
      (\ u2 qb2 ql2 -> apH {W0.Ix (FibT.tob X (TF.pr1 X v))} {TF.EI X} (\ z -> (TF.pr X (TF.pr1 X v) z))
         (idJ (TB.T X (TA.pr1 X (TF.pr1 X v))) (TF.pr2 X v).1
            (\ b2 Q2 -> (pth : W0.Ix (PE.tobP X (TAB.pr X (TF.pr1 X v) b2)))
               -> ((W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI W) (fibL X v W f i) (pth.1.1 W f i))
               -> Id (W0.Ix (FibT.tob X (TF.pr1 X v))) (TF.pr2 X v) (b2, pth))
            (\ pth ql3 -> apH {W0.Ix (PE.tobP X (TAB.pr X (TF.pr1 X v) ((TF.pr2 X v).1)))} {W0.Ix (FibT.tob X (TF.pr1 X v))} (\ z -> ((TF.pr2 X v).1, z))
               (PE.path-eq X (TAB.pr X (TF.pr1 X v) ((TF.pr2 X v).1)) (TF.pr2 X v).2 pth ql3))
            u2.1 (TB.pr-inj X (TA.pr1 X (TF.pr1 X v)) (TF.pr2 X v).1 u2.1 qb2) u2.2 ql2))
      (TF.pr1 X v') P (TF.pr2 X v') qb ql ;

  opaque fibE-eq ;
} ;

-- equivalence structures: partial elements of the fibres extend
EquivOp (D : PCtx) (B A : PTy[D]) (al : CPartial[l].PMap[D, B, A]) : U l+ =
  CPartial[l].ContrOp (extP D A) HFib[D, B, A, al].FibT ;
