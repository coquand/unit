-- CLocDNC.seg (L9): the concrete description of D_N (postnikov.tex,
-- Proposition DN).  An element of D_N A = D (K_N A) at (X , x) is the same
-- as a family
--
--   w n f  in  A([n] , f^* x)       for n <= N and f : [n] -> X
--
-- with  w(f) g = w(f g)  for every strictly monotone g (CEl).
--
--   to         read u(f) at the identity
--   from       u(f) at g : [j] -> [n] is  w(f m) sigma,  for the image
--              factorisation g = m sigma (CLocEZ.EZH); K-compatibility and
--              D-compatibility by the comparison of two factorisations
--              (CLocEZ.EZK)
--   to-from, from-to, to-nat

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZm = CLocEZ[a] ;
module VF = CDeltaFact[a] ;

-- the values of the identity
valT-id (p v : Nat) (hv : IsT (leb v p)) : Id Nat (VF.valT p p (idH (lin p)) v) v =
  apH vnum (transH (symH (VF.valT-tree p p (idH (lin p)) v hv)) (app-idH1 (lin p) (leaf v, hv))) ;

-- sigma is an epimorphism (it has a section)
module Epi (j n : Nat) (g : Hom (lin j) (lin n)) {
  module Z = EZm.EZH[j, n, g] ;

  epi (Y : Ob) (p q : Hom (lin Z.r) Y)
    (e : Id (Hom (lin j) Y) (compH (lin j) (lin Z.r) Y p Z.sigH) (compH (lin j) (lin Z.r) Y q Z.sigH)) : Id (Hom (lin Z.r) Y) p q =
    calc (Hom (lin Z.r) Y) {
        p
      =< symH (comp-idr (lin Z.r) Y p) >
        compH (lin Z.r) (lin Z.r) Y p (idH (lin Z.r))
      =< apH (compH (lin Z.r) (lin Z.r) Y p) (symH Z.sec) >
        compH (lin Z.r) (lin Z.r) Y p (compH (lin Z.r) (lin j) (lin Z.r) Z.sigH Z.secH)
      =< symH (comp-assoc (lin Z.r) (lin j) (lin Z.r) Y p Z.sigH Z.secH) >
        compH (lin Z.r) (lin j) Y (compH (lin j) (lin Z.r) Y p Z.sigH) Z.secH
      =< apH (\ k -> compH (lin Z.r) (lin j) Y k Z.secH) e >
        compH (lin Z.r) (lin j) Y (compH (lin j) (lin Z.r) Y q Z.sigH) Z.secH
      =< comp-assoc (lin Z.r) (lin j) (lin Z.r) Y q Z.sigH Z.secH >
        compH (lin Z.r) (lin Z.r) Y q (compH (lin Z.r) (lin j) (lin Z.r) Z.sigH Z.secH)
      =< apH (compH (lin Z.r) (lin Z.r) Y q) Z.sec >
        compH (lin Z.r) (lin Z.r) Y q (idH (lin Z.r))
      =< comp-idr (lin Z.r) Y q >
        q } ;
} ;

module DC (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat) {
  module KM = CK.KT[G, A, N] ;
  module DK = LD.DT[G, KM.KA] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module TK = KM.TK ;
  module GL = PB.GPre[l].PshL[G] ;

  ----------------------------------------------------------------------
  -- the concrete families

  CFam (X : Ob) (x : W.Ix (G.ob X)) : U l =
    (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) -> TA.T (lin n) (G.act (lin n) X f x) ;

  crd (X : Ob) (x : W.Ix (G.ob X)) (w : CFam X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) : TA.EI (lin n) =
    (G.act (lin n) X f x, w n hn f) ;

  CCompat (X : Ob) (x : W.Ix (G.ob X)) (w : CFam X x) : U l =
    (m n : Nat) (hm : IsT (leb m N)) (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) -> Strict (lin m) (lin n) g -> (f : Hom (lin n) X)
    -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g)) ;

  CEl (X : Ob) (x : W.Ix (G.ob X)) : U l = (w : CFam X x) * CCompat X x w ;

  isProp-CCompat (X : Ob) (x : W.Ix (G.ob X)) (w : CFam X x) : isProp (CCompat X x w) =
    isProp-Pi Nat (\ m -> (n : Nat) (hm : IsT (leb m N)) (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) -> Strict (lin m) (lin n) g -> (f : Hom (lin n) X)
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ m ->
    isProp-Pi Nat (\ n -> (hm : IsT (leb m N)) (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) -> Strict (lin m) (lin n) g -> (f : Hom (lin n) X)
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ n ->
    isProp-Pi (IsT (leb m N)) (\ hm -> (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) -> Strict (lin m) (lin n) g -> (f : Hom (lin n) X)
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ hm ->
    isProp-Pi (IsT (leb n N)) (\ hn -> (g : Hom (lin m) (lin n)) -> Strict (lin m) (lin n) g -> (f : Hom (lin n) X)
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ hn ->
    isProp-Pi (Hom (lin m) (lin n)) (\ g -> Strict (lin m) (lin n) g -> (f : Hom (lin n) X)
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ g ->
    isProp-Pi (Strict (lin m) (lin n) g) (\ s -> (f : Hom (lin n) X)
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ s ->
    isProp-Pi (Hom (lin n) X) (\ f
      -> Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (crd X x w n hn f)) (crd X x w m hm (compH (lin m) (lin n) X f g))) (\ f ->
      W.isSetIx (TA.E.ob (lin m)) _ _))))))) ;

  Cext (X : Ob) (x : W.Ix (G.ob X)) (w w' : CEl X x)
    (h : (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) -> Id (TA.EI (lin n)) (crd X x w.1 n hn f) (crd X x w'.1 n hn f))
    : Id (CEl X x) w w' =
    Sigma-eq (CFam X x) (\ v -> CCompat X x v) w.1 w'.1 w.2 w'.2
      (funext Nat (\ n -> (hn : IsT (leb n N)) (f : Hom (lin n) X) -> TA.T (lin n) (G.act (lin n) X f x)) w.1 w'.1 (\ n ->
         funext (IsT (leb n N)) (\ hn -> (f : Hom (lin n) X) -> TA.T (lin n) (G.act (lin n) X f x)) (w.1 n) (w'.1 n) (\ hn ->
           funext (Hom (lin n) X) (\ f -> TA.T (lin n) (G.act (lin n) X f x)) (w.1 n hn) (w'.1 n hn) (\ f ->
             TA.pr-inj (lin n) _ (w.1 n hn f) (w'.1 n hn f) (h n hn f)))))
      (isProp-CCompat X x w'.1) ;

  ----------------------------------------------------------------------
  -- to: read u(f) at the identity

  rdId (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) : TA.EI (lin n) =
    KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 n hn (idH (lin n)) ;

  toF (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) : CFam X x = \ n hn f ->
    TA.fromE (lin n) (G.act (lin n) X f x) (rdId X x u n hn f) (G.act-id (lin n) (G.act (lin n) X f x)) ;

  crd-toF (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X)
    : Id (TA.EI (lin n)) (crd X x (toF X x u) n hn f) (rdId X x u n hn f) =
    TA.fromE-eq (lin n) (G.act (lin n) X f x) (rdId X x u n hn f) (G.act-id (lin n) (G.act (lin n) X f x)) ;

  -- u read at the identity, along a strict map
  rdId-act (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) (m n : Nat) (hm : IsT (leb m N)) (hn : IsT (leb n N))
    (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X)
    : Id (TA.EI (lin m)) (TA.E.act (lin m) (lin n) g (rdId X x u n hn f)) (rdId X x u m hm (compH (lin m) (lin n) X f g)) =
    transH ((u.1 n f).2 m n hm hn g (idH (lin n)))
     (transH (apH (\ q -> KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 m hm q)
                  (transH (comp-idl (lin m) (lin n) g) (symH (comp-idr (lin m) (lin n) g))))
      (transH (symH (KM.rd-ktact (lin m) (lin n) g (G.act (lin n) X f x) (G.act (lin m) (lin n) g (G.act (lin n) X f x))
                       (refl (G.act (lin m) (lin n) g (G.act (lin n) X f x))) (u.1 n f) m hm (idH (lin m))))
              (apH (\ w' -> KM.rd (lin m) w'.1 w'.2.1 m hm (idH (lin m))) (u.2 m n g s f)))) ;

  toC (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) : CCompat X x (toF X x u) = \ m n hm hn g s f ->
    transH (apH (TA.E.act (lin m) (lin n) g) (crd-toF X x u n hn f))
      (transH (rdId-act X x u m n hm hn g s f) (symH (crd-toF X x u m hm (compH (lin m) (lin n) X f g)))) ;

  to (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) : CEl X x = (toF X x u, toC X x u) ;

  ----------------------------------------------------------------------
  -- from: u(f) at g = m sigma is w(f m) sigma

  module EV (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n)) {
    module Z = EZm.EZH[j, n, g] ;
    hr : IsT (leb Z.r N) = leb-trans Z.r j N Z.r-le hj ;
    fm : Hom (lin Z.r) X = compH (lin Z.r) (lin n) X f Z.mH ;

    val : TA.EI (lin j) = TA.E.act (lin j) (lin Z.r) Z.sigH (crd X x w.1 Z.r hr fm) ;

    fm-sig : Id (Hom (lin j) X) (compH (lin j) (lin Z.r) X fm Z.sigH) (compH (lin j) (lin n) X f g) =
      transH (comp-assoc (lin j) (lin Z.r) (lin n) X f Z.mH Z.sigH) (apH (compH (lin j) (lin n) X f) Z.fac) ;

    val-pt : Id (W.Ix (G.ob (lin j))) val.1 (G.act (lin j) (lin n) g (G.act (lin n) X f x)) =
      transH (GL.actC (lin j) (lin Z.r) X fm Z.sigH x)
        (transH (apH (\ q -> G.act (lin j) X q x) fm-sig) (symH (GL.actC (lin j) (lin n) X f g x))) ;
  } ;

  kF (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n : Nat) (f : Hom (lin n) X) : KM.Fam (lin n) (G.act (lin n) X f x) = \ j hj g ->
    TA.fromE (lin j) (G.act (lin j) (lin n) g (G.act (lin n) X f x)) EV[X, x, w, n, f, j, hj, g].val EV[X, x, w, n, f, j, hj, g].val-pt ;

  rd-kF (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n))
    : Id (TA.EI (lin j)) (KM.rd (lin n) (G.act (lin n) X f x) (kF X x w n f) j hj g) EV[X, x, w, n, f, j, hj, g].val =
    TA.fromE-eq (lin j) (G.act (lin j) (lin n) g (G.act (lin n) X f x)) EV[X, x, w, n, f, j, hj, g].val EV[X, x, w, n, f, j, hj, g].val-pt ;

  -- K-compatibility: two factorisations, of g and of g t
  module KC (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n : Nat) (f : Hom (lin n) X)
    (j2 j : Nat) (hj2 : IsT (leb j2 N)) (hj : IsT (leb j N)) (t : Hom (lin j2) (lin j)) (g : Hom (lin j) (lin n)) {
    module E1 = EV[X, x, w, n, f, j, hj, g] ;
    module E2 = EV[X, x, w, n, f, j2, hj2, compH (lin j2) (lin j) (lin n) g t] ;
    gt : Hom (lin j2) (lin n) = compH (lin j2) (lin j) (lin n) g t ;

    module K = EZm.EZK[j, j2, n, n, g, gt, t,
      \ v v' hv hv' e -> transH (symH (CDPrism[a].valT-comp j2 j n g t v hv)) (transH e (CDPrism[a].valT-comp j2 j n g t v' hv')),
      \ v v' hv hv' e -> transH (CDPrism[a].valT-comp j2 j n g t v hv) (transH e (symH (CDPrism[a].valT-comp j2 j n g t v' hv')))] ;

    -- m2 = m mu
    eqM : Id (Hom (lin E2.Z.r) (lin n)) (compH (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu) E2.Z.mH =
      Epi[j2, n, gt].epi (lin n) (compH (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu) E2.Z.mH
        (calc (Hom (lin j2) (lin n)) {
            compH (lin j2) (lin E2.Z.r) (lin n) (compH (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu) E2.Z.sigH
          =< comp-assoc (lin j2) (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu E2.Z.sigH >
            compH (lin j2) (lin E1.Z.r) (lin n) E1.Z.mH (compH (lin j2) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH)
          =< apH (compH (lin j2) (lin E1.Z.r) (lin n) E1.Z.mH) (symH K.muEq) >
            compH (lin j2) (lin E1.Z.r) (lin n) E1.Z.mH (compH (lin j2) (lin j) (lin E1.Z.r) E1.Z.sigH t)
          =< symH (comp-assoc (lin j2) (lin j) (lin E1.Z.r) (lin n) E1.Z.mH E1.Z.sigH t) >
            compH (lin j2) (lin j) (lin n) (compH (lin j) (lin E1.Z.r) (lin n) E1.Z.mH E1.Z.sigH) t
          =< apH (\ k -> compH (lin j2) (lin j) (lin n) k t) E1.Z.fac >
            gt
          =< symH E2.Z.fac >
            compH (lin j2) (lin E2.Z.r) (lin n) E2.Z.mH E2.Z.sigH }) ;

    fmEq : Id (Hom (lin E2.Z.r) X) (compH (lin E2.Z.r) (lin E1.Z.r) X E1.fm K.mu) E2.fm =
      transH (comp-assoc (lin E2.Z.r) (lin E1.Z.r) (lin n) X f E1.Z.mH K.mu) (apH (compH (lin E2.Z.r) (lin n) X f) eqM) ;

    res : Id (TA.EI (lin j2)) (TA.E.act (lin j2) (lin j) t E1.val) E2.val =
      calc (TA.EI (lin j2)) {
          TA.E.act (lin j2) (lin j) t E1.val
        =< TA.PE.actC (lin j2) (lin j) (lin E1.Z.r) E1.Z.sigH t (crd X x w.1 E1.Z.r E1.hr E1.fm) >
          TA.E.act (lin j2) (lin E1.Z.r) (compH (lin j2) (lin j) (lin E1.Z.r) E1.Z.sigH t) (crd X x w.1 E1.Z.r E1.hr E1.fm)
        =< TA.PE.actEq (lin j2) (lin E1.Z.r) _ _ K.muEq (crd X x w.1 E1.Z.r E1.hr E1.fm) >
          TA.E.act (lin j2) (lin E1.Z.r) (compH (lin j2) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH) (crd X x w.1 E1.Z.r E1.hr E1.fm)
        =< symH (TA.PE.actC (lin j2) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH (crd X x w.1 E1.Z.r E1.hr E1.fm)) >
          TA.E.act (lin j2) (lin E2.Z.r) E2.Z.sigH (TA.E.act (lin E2.Z.r) (lin E1.Z.r) K.mu (crd X x w.1 E1.Z.r E1.hr E1.fm))
        =< apH (TA.E.act (lin j2) (lin E2.Z.r) E2.Z.sigH) (w.2 E2.Z.r E1.Z.r E2.hr E1.hr K.mu K.muStrict E1.fm) >
          TA.E.act (lin j2) (lin E2.Z.r) E2.Z.sigH (crd X x w.1 E2.Z.r E2.hr (compH (lin E2.Z.r) (lin E1.Z.r) X E1.fm K.mu))
        =< apH (\ q -> TA.E.act (lin j2) (lin E2.Z.r) E2.Z.sigH (crd X x w.1 E2.Z.r E2.hr q)) fmEq >
          E2.val } ;
  } ;

  kC (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n : Nat) (f : Hom (lin n) X) : KM.Compat (lin n) (G.act (lin n) X f x) (kF X x w n f) =
    \ j2 j hj2 hj t g ->
      transH (apH (TA.E.act (lin j2) (lin j) t) (rd-kF X x w n f j hj g))
        (transH (KC[X, x, w, n, f, j2, j, hj2, hj, t, g].res) (symH (rd-kF X x w n f j2 hj2 (compH (lin j2) (lin j) (lin n) g t)))) ;

  fromF (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) : DK.Fam X x = \ n f -> (kF X x w n f, kC X x w n f) ;

  -- D-compatibility: two factorisations, of s g and of g, for s strict
  module DC2 (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n' n : Nat) (s : Hom (lin n') (lin n)) (st : Strict (lin n') (lin n) s)
    (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n')) {
    sg : Hom (lin j) (lin n) = compH (lin j) (lin n') (lin n) s g ;
    fs : Hom (lin n') X = compH (lin n') (lin n) X f s ;
    module E1 = EV[X, x, w, n, f, j, hj, sg] ;
    module E2 = EV[X, x, w, n', fs, j, hj, g] ;

    module K = EZm.EZK[j, j, n, n', sg, g, idH (lin j),
      \ v v' hv hv' e -> transH (apH (VF.valT j n sg) (valT-id j v hv))
                          (transH (CDPrism[a].valT-comp j n' n s g v hv)
                            (transH (apH (VF.valT n' n s) e)
                              (transH (symH (CDPrism[a].valT-comp j n' n s g v' hv')) (symH (apH (VF.valT j n sg) (valT-id j v' hv')))))),
      \ v v' hv hv' e -> EZm.VH.valT-inj n' n s st (VF.valT j n' g v) (VF.valT j n' g v')
                           (VF.valT-range j n' g v) (VF.valT-range j n' g v')
                           (transH (symH (CDPrism[a].valT-comp j n' n s g v hv))
                             (transH (apH (VF.valT j n sg) (symH (valT-id j v hv)))
                               (transH e (transH (apH (VF.valT j n sg) (valT-id j v' hv')) (CDPrism[a].valT-comp j n' n s g v' hv')))))] ;

    sigEq : Id (Hom (lin j) (lin E1.Z.r)) E1.Z.sigH (compH (lin j) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH) =
      transH (symH (comp-idr (lin j) (lin E1.Z.r) E1.Z.sigH)) K.muEq ;

    -- m1 mu = s m2
    eqM : Id (Hom (lin E2.Z.r) (lin n)) (compH (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu) (compH (lin E2.Z.r) (lin n') (lin n) s E2.Z.mH) =
      Epi[j, n', g].epi (lin n) (compH (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu) (compH (lin E2.Z.r) (lin n') (lin n) s E2.Z.mH)
        (calc (Hom (lin j) (lin n)) {
            compH (lin j) (lin E2.Z.r) (lin n) (compH (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu) E2.Z.sigH
          =< comp-assoc (lin j) (lin E2.Z.r) (lin E1.Z.r) (lin n) E1.Z.mH K.mu E2.Z.sigH >
            compH (lin j) (lin E1.Z.r) (lin n) E1.Z.mH (compH (lin j) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH)
          =< apH (compH (lin j) (lin E1.Z.r) (lin n) E1.Z.mH) (symH sigEq) >
            compH (lin j) (lin E1.Z.r) (lin n) E1.Z.mH E1.Z.sigH
          =< E1.Z.fac >
            sg
          =< apH (compH (lin j) (lin n') (lin n) s) (symH E2.Z.fac) >
            compH (lin j) (lin n') (lin n) s (compH (lin j) (lin E2.Z.r) (lin n') E2.Z.mH E2.Z.sigH)
          =< symH (comp-assoc (lin j) (lin E2.Z.r) (lin n') (lin n) s E2.Z.mH E2.Z.sigH) >
            compH (lin j) (lin E2.Z.r) (lin n) (compH (lin E2.Z.r) (lin n') (lin n) s E2.Z.mH) E2.Z.sigH }) ;

    fmEq : Id (Hom (lin E2.Z.r) X) (compH (lin E2.Z.r) (lin E1.Z.r) X E1.fm K.mu) E2.fm =
      transH (comp-assoc (lin E2.Z.r) (lin E1.Z.r) (lin n) X f E1.Z.mH K.mu)
        (transH (apH (compH (lin E2.Z.r) (lin n) X f) eqM)
                (symH (comp-assoc (lin E2.Z.r) (lin n') (lin n) X f s E2.Z.mH))) ;

    res : Id (TA.EI (lin j)) E1.val E2.val =
      calc (TA.EI (lin j)) {
          E1.val
        =< TA.PE.actEq (lin j) (lin E1.Z.r) _ _ sigEq (crd X x w.1 E1.Z.r E1.hr E1.fm) >
          TA.E.act (lin j) (lin E1.Z.r) (compH (lin j) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH) (crd X x w.1 E1.Z.r E1.hr E1.fm)
        =< symH (TA.PE.actC (lin j) (lin E2.Z.r) (lin E1.Z.r) K.mu E2.Z.sigH (crd X x w.1 E1.Z.r E1.hr E1.fm)) >
          TA.E.act (lin j) (lin E2.Z.r) E2.Z.sigH (TA.E.act (lin E2.Z.r) (lin E1.Z.r) K.mu (crd X x w.1 E1.Z.r E1.hr E1.fm))
        =< apH (TA.E.act (lin j) (lin E2.Z.r) E2.Z.sigH) (w.2 E2.Z.r E1.Z.r E2.hr E1.hr K.mu K.muStrict E1.fm) >
          TA.E.act (lin j) (lin E2.Z.r) E2.Z.sigH (crd X x w.1 E2.Z.r E2.hr (compH (lin E2.Z.r) (lin E1.Z.r) X E1.fm K.mu))
        =< apH (\ q -> TA.E.act (lin j) (lin E2.Z.r) E2.Z.sigH (crd X x w.1 E2.Z.r E2.hr q)) fmEq >
          E2.val } ;
  } ;

  fromC (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) : DK.Compat X x (fromF X x w) = \ n' n s st f ->
    KM.EKext (lin n') (TK.E.act (lin n') (lin n) s (DK.rd X x (fromF X x w) n f)) (DK.rd X x (fromF X x w) n' (compH (lin n') (lin n) X f s))
      (GL.actC (lin n') (lin n) X f s x)
      (\ j hj g ->
        transH (KM.rd-ktact (lin n') (lin n) s (G.act (lin n) X f x) (G.act (lin n') (lin n) s (G.act (lin n) X f x))
                  (refl (G.act (lin n') (lin n) s (G.act (lin n) X f x))) (fromF X x w n f) j hj g)
         (transH (rd-kF X x w n f j hj (compH (lin j) (lin n') (lin n) s g))
          (transH (DC2[X, x, w, n', n, s, st, f, j, hj, g].res)
                  (symH (rd-kF X x w n' (compH (lin n') (lin n) X f s) j hj g))))) ;

  from (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) : DK.DEl X x = (fromF X x w, fromC X x w) ;

  ----------------------------------------------------------------------
  -- the two maps are inverse

  -- below N, the value of from w at f is etaK (w f)
  val-low (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X)
    (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n))
    : Id (TA.EI (lin j)) EV[X, x, w, n, f, j, hj, g].val (TA.E.act (lin j) (lin n) g (crd X x w.1 n hn f)) =
    transH (apH (TA.E.act (lin j) (lin EV[X, x, w, n, f, j, hj, g].Z.r) EV[X, x, w, n, f, j, hj, g].Z.sigH)
              (symH (w.2 EV[X, x, w, n, f, j, hj, g].Z.r n EV[X, x, w, n, f, j, hj, g].hr hn
                       EV[X, x, w, n, f, j, hj, g].Z.mH EV[X, x, w, n, f, j, hj, g].Z.strict f)))
      (transH (TA.PE.actC (lin j) (lin EV[X, x, w, n, f, j, hj, g].Z.r) (lin n) EV[X, x, w, n, f, j, hj, g].Z.mH
                 EV[X, x, w, n, f, j, hj, g].Z.sigH (crd X x w.1 n hn f))
              (TA.PE.actEq (lin j) (lin n) _ _ EV[X, x, w, n, f, j, hj, g].Z.fac (crd X x w.1 n hn f))) ;

  to-from (X : Ob) (x : W.Ix (G.ob X)) (w : CEl X x) : Id (CEl X x) (to X x (from X x w)) w =
    Cext X x (to X x (from X x w)) w (\ n hn f ->
      transH (crd-toF X x (from X x w) n hn f)
        (transH (rd-kF X x w n f n hn (idH (lin n)))
          (transH (val-low X x w n hn f n hn (idH (lin n))) (TA.E.act-id (lin n) (crd X x w.1 n hn f))))) ;

  -- u at f m, read at the identity, is u at f read at m (for m strict)
  rdId-act' (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) (n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n))
    : Id (TA.EI (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r))
         (KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr
            EV[X, x, to X x u, n, f, j, hj, g].Z.mH)
         (rdId X x u EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr EV[X, x, to X x u, n, f, j, hj, g].fm) =
    transH (apH (\ q -> KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr q)
              (symH (comp-idr (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) (lin n) EV[X, x, to X x u, n, f, j, hj, g].Z.mH)))
      (transH (symH (KM.rd-ktact (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) (lin n) EV[X, x, to X x u, n, f, j, hj, g].Z.mH
                       (G.act (lin n) X f x) (G.act (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) (lin n) EV[X, x, to X x u, n, f, j, hj, g].Z.mH (G.act (lin n) X f x))
                       (refl (G.act (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) (lin n) EV[X, x, to X x u, n, f, j, hj, g].Z.mH (G.act (lin n) X f x)))
                       (u.1 n f) EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr (idH (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r))))
              (apH (\ w' -> KM.rd (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) w'.1 w'.2.1 EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr
                              (idH (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r)))
                   (u.2 EV[X, x, to X x u, n, f, j, hj, g].Z.r n EV[X, x, to X x u, n, f, j, hj, g].Z.mH EV[X, x, to X x u, n, f, j, hj, g].Z.strict f))) ;

  from-to (X : Ob) (x : W.Ix (G.ob X)) (u : DK.DEl X x) : Id (DK.DEl X x) (from X x (to X x u)) u =
    DK.Dext X x (from X x (to X x u)) u (\ n f ->
      KM.EKext (lin n) (DK.rd X x (from X x (to X x u)).1 n f) (DK.rd X x u.1 n f) (refl (G.act (lin n) X f x)) (\ j hj g ->
        calc (TA.EI (lin j)) {
            KM.rd (lin n) (G.act (lin n) X f x) (kF X x (to X x u) n f) j hj g
          =< rd-kF X x (to X x u) n f j hj g >
            EV[X, x, to X x u, n, f, j, hj, g].val
          =< apH (TA.E.act (lin j) (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) EV[X, x, to X x u, n, f, j, hj, g].Z.sigH)
               (transH (crd-toF X x u EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr EV[X, x, to X x u, n, f, j, hj, g].fm)
                       (symH (rdId-act' X x u n f j hj g))) >
            TA.E.act (lin j) (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) EV[X, x, to X x u, n, f, j, hj, g].Z.sigH
              (KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 EV[X, x, to X x u, n, f, j, hj, g].Z.r EV[X, x, to X x u, n, f, j, hj, g].hr
                 EV[X, x, to X x u, n, f, j, hj, g].Z.mH)
          =< (u.1 n f).2 j EV[X, x, to X x u, n, f, j, hj, g].Z.r hj EV[X, x, to X x u, n, f, j, hj, g].hr
               EV[X, x, to X x u, n, f, j, hj, g].Z.sigH EV[X, x, to X x u, n, f, j, hj, g].Z.mH >
            KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 j hj
              (compH (lin j) (lin EV[X, x, to X x u, n, f, j, hj, g].Z.r) (lin n) EV[X, x, to X x u, n, f, j, hj, g].Z.mH EV[X, x, to X x u, n, f, j, hj, g].Z.sigH)
          =< apH (\ q -> KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 j hj q) EV[X, x, to X x u, n, f, j, hj, g].Z.fac >
            KM.rd (lin n) (G.act (lin n) X f x) (u.1 n f).1 j hj g })) ;


  ----------------------------------------------------------------------
  -- to commutes with restriction

  to-nat (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
    (u : DK.DEl X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) Y)
    : Id (TA.EI (lin n)) (crd Y y (toF Y y (DK.dtact Y X h x y e u)) n hn f) (crd X x (toF X x u) n hn (compH (lin n) Y X h f)) =
    transH (crd-toF Y y (DK.dtact Y X h x y e u) n hn f)
      (transH (apH (\ w' -> KM.rd (lin n) w'.1 w'.2.1 n hn (idH (lin n))) (DK.rd-dtact Y X h x y e u n f))
              (symH (crd-toF X x u n hn (compH (lin n) Y X h f)))) ;
} ;
