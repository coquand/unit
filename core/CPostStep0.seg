-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostStep0.seg (L9): steps 1 and 3 of the construction of psi at a
-- point f : [0] -> X (postnikov.tex, Theorem conv): the boxes have no
-- faces, only the lid (step 1) and the ends t = 0 , 1 (step 3).  The lids,
-- the end data and the outputs are those of CPostStep1.P1 and
-- CPostStep3.E3.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;
module S1m = CPostStep1[a, l] ;
module S3m = CPostStep3[a, l] ;

-- step 1 at a point: the prism from the lid u_1 at 1, with no sides
module S1z (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W0.Ix (G.ob X)) (u : LD.DT[G, CK.KT[G, A, suc zero].KA].DEl X x) (f : Hom (lin zero) X) {
  module P = S1m.P1[G, A, X, x, zero, u, f] ;
  module RG = CLocRestr[a, l].R[G] ;
  module FF = CDFill[a, l].FF[RG.iG, RG.T[A].iA, CLocHorn[a, l].HornOfFib[G, A, c].horn] ;

  module Bx = CBoxFill[a, l].BF[G, A, e1, FF.S.fill, FF.S.sides, FF.S.face,
    P.BX.XB, P.HP.ht, P.HP.B, P.HP.hB, P.HP.hm, P.HP.hi, P.xB, P.a0, P.a0p, P.a0n, SP.emptyS P.BX.XB,
    \ W g i j -> absurd _ (false-true i), \ W g i j -> absurd _ (false-true i),
    \ V W h g i i' j -> absurd _ (false-true i), \ W g i -> absurd _ (false-true i)] ;

  module O = P.Out[Bx.Fv, Bx.Fp, Bx.Fn, Bx.Fe] ;
} ;

-- step 3 at a point: the square from the lid H at s = 1, with the ends only
module S3z (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W0.Ix (G.ob X)) (f : Hom (lin zero) X) (N : Nat) (hN : IsT (leb (suc zero) N))
  (uN : LD.DT[G, CK.KT[G, A, N].KA].DEl X x) (uN1 : LD.DT[G, CK.KT[G, A, suc N].KA].DEl X x)
  (pN : LD.DT[G, CK.KT[G, A, N].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r (suc N))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pN.1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc N].rd (lin r) (G.act (lin r) X q x) (uN1.1 r q).1 r hr' (idH (lin r))))
  (pe1 : (r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pN.1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) X q x) (uN.1 r q).1 r hr (idH (lin r))))
  (psi : PB.GPre[l].TyL[G, A].EI (lin (zero))) (psi-pt : Id (W0.Ix (G.ob (lin (zero)))) (PB.GPre[l].TyL[G, A].pr1 (lin (zero)) psi) (G.act (lin (zero)) X f x))
  (H : (W : Nat) -> Hom (lin W) (lin (zero)) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hp : (W : Nat) (g : Hom (lin W) (lin (zero))) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (H W g j)) (G.act (lin W) (lin (zero)) g (G.act (lin (zero)) X f x)))
  (Hn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin (zero))) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (H W g j))
              (H V (compH (lin V) (lin W) (lin (zero)) g h) (compH (lin V) (lin W) Iv j h)))
  (H0 : (W : Nat) (g : Hom (lin W) (lin (zero)))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin (zero)) g psi))
  (H1 : (W : Nat) (g : Hom (lin W) (lin (zero)))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e1))
              (PM.DR[G, A, N, X, x, uN, lin (zero), EZ.HLin[zero].ht, zero, EZ.HLin[zero].hB, EZ.HLin[zero].hm, EZ.HLin[zero].hi,
                     leb-trans (zero) (suc (zero)) N (leb-suc (zero)) hN, f].val W g)) {
  module E = S3m.E3[G, A, X, x, zero, f, N, hN, uN, uN1, pN, pe0, pe1, psi, psi-pt, H, Hp, Hn, H0, H1] ;
  module TA = E.TA ;
  module RG = CLocRestr[a, l].R[G] ;
  module FF = CDFill[a, l].FF[RG.iG, RG.T[A].iA, CLocHorn[a, l].HornOfFib[G, A, c].horn] ;

  module Sq = CPostSq[a, l].SqZ[G, A, e1, FF.S.fill, FF.S.sides, FF.S.face, E.xf, psi, psi-pt, H, Hp, Hn, E.DP.val, E.Plp, E.DP.vn, H0, E.L1] ;

  Thf (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : TA.EI (lin W) = Sq.Thf W g j ;

  Thf-p (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (Thf W g j)) (G.act (lin W) E.BX.XB g E.xB) = Sq.Bx.Fp W g j ;

  Thf-n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) E.BX.XB g h) (compH (lin V) (lin W) Iv j h)) =
    Sq.Bx.Fn V W h g j ;

  Thf-s1 (W : Nat) (g : Hom (lin W) E.BX.XB) : Id (TA.EI (lin W)) (Thf W g (constH (lin W) Iv e1)) (H W (Sq.E.p1g W g) (Sq.E.p2g W g)) = Sq.Thf-e W g ;

  Thf-t0 (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Thf W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin zero) g psi) = Sq.Thf-t0 W g j ;

  Thf-t1 (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Thf W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e1)) j) (E.DP.val W (pairH (lin zero) Iv (lin W) g j)) = Sq.Thf-t1 W g j ;

  module HH = E.HT[Thf, Thf-p, Thf-n, Thf-t0, Thf-t1] ;
} ;
