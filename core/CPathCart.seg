-- CPathCart.seg (L3, inside CB, level l): the cartesian map
-- Path A[r] a[r] b[r] -> Path A a b over r : D -> G (model.tex Thm "type
-- formers", naturality).  The fibre map tau maps the values of a path by
-- the lift of r (the conditions transported along r.nt-nat); bk reads a
-- path of A over r x back over x.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PathCart (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a b : PEl[G, A]) {
  A' : PTy[D] = subTy D G A r ;
  a' : PEl[D, A'] = subEl D G A a r ;
  b' : PEl[D, A'] = subEl D G A b r ;
  module PF' = CPathFib[l].PathFib[D, A', a', b'] ;
  module PF = CPathFib[l].PathFib[G, A, a, b] ;
  module SEA = CSub[l].SubE[D, G, r, A] ;
  module TA = GPR.TyL[G, A] ;
  module TA' = GPR.TyL[D, A'] ;
  module TP = PF.PT.TP ;
  module TP' = PF'.PT.TP ;
  module MF = CLine[l].FMap[TA'.E, TA.E, liftP D G A r] ;

  ----------------------------------------------------------------------
  -- the fibre map

  tau (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (PF'.PT.tobP X x)) : W0.Ix (PF.PT.tobP X (r.nt X x)) =
    (MF.mapF X u.1,
     (\ W f i -> transH (apH (r.nt W) (u.2.1 W f i)) (r.nt-nat W X f x),
      (apH (SEA.mV X) u.2.2.1, apH (SEA.mV X) u.2.2.2))) ;

  ta (W : Ob) (v : TP'.EI W) : TP.EI W = (r.nt W v.1, tau W v.1 v.2) ;

  tanat (V W : Ob) (g : Hom V W) (v : TP'.EI W) : Id (TP.EI V) (TP.E.act V W g (ta W v)) (ta V (TP'.E.act V W g v)) =
    PF.PT.tp-ext V (TP.E.act V W g (ta W v)) (ta V (TP'.E.act V W g v)) (symH (r.nt-nat V W g v.1))
      (\ V' g' j -> refl (SEA.mV V' (v.2.1.1 V' (compH V' V W g g') j))) ;

  tainj (W : Ob) (v v' : TP'.EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (TP.EI W) (ta W v) (ta W v')) : Id (TP'.EI W) v v' =
    PF'.PT.tp-ext W v v' P (\ V g j ->
      SEA.mV-inj V (v.2.1.1 V g j) (v'.2.1.1 V g j)
        (transH (v.2.2.1 V g j) (transH (apH (D.act V W g) P) (symH (v'.2.2.1 V g j))))
        (apH (\ z -> z.2.1.1 V g j) Q)) ;

  ----------------------------------------------------------------------
  -- reading back

  module Bk (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (PF.PT.tobP X (r.nt X x))) {
    py (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (u.1.1 W f i).1 (r.nt W (D.act W X f x)) =
      transH (u.2.1 W f i) (symH (r.nt-nat W X f x)) ;

    bv (W : Ob) (f : Hom W X) (i : Hom W Iv) : TA'.EI W =
      (D.act W X f x, TA.coeT W (u.1.1 W f i).1 (r.nt W (D.act W X f x)) (py W f i) (u.1.1 W f i).2) ;

    bvE (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (TA.EI W) (SEA.mV W (bv W f i)) (u.1.1 W f i) =
      symH (TA.pr-coe W (u.1.1 W f i).1 (r.nt W (D.act W X f x)) (py W f i) (u.1.1 W f i).2) ;

    bn (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
      : Id (TA'.EI V) (TA'.E.act V W g (bv W f i)) (bv V (compH V W X f g) (compH V W Iv i g)) =
      SEA.mV-inj V (TA'.E.act V W g (bv W f i)) (bv V (compH V W X f g) (compH V W Iv i g)) (symH (D.act-o V W X f g x))
        (calc (TA.EI V) {
            SEA.mV V (TA'.E.act V W g (bv W f i))
          =< symH (SEA.mV-nat V W g (bv W f i)) >
            TA.E.act V W g (SEA.mV W (bv W f i))
          =< apH (TA.E.act V W g) (bvE W f i) >
            TA.E.act V W g (u.1.1 W f i)
          =< u.1.2 V W g f i >
            u.1.1 V (compH V W X f g) (compH V W Iv i g)
          =< symH (bvE V (compH V W X f g) (compH V W Iv i g)) >
            SEA.mV V (bv V (compH V W X f g) (compH V W Iv i g)) }) ;

    q0 : Id (TA'.EI X) (bv X (idH X) (ptH X e0)) (PF'.PE.aE X x) =
      SEA.mV-inj X (bv X (idH X) (ptH X e0)) (PF'.PE.aE X x) (D.act-id X x) (transH (bvE X (idH X) (ptH X e0)) u.2.2.1) ;

    q1 : Id (TA'.EI X) (bv X (idH X) (ptH X e1)) (PF'.PE.bE X x) =
      SEA.mV-inj X (bv X (idH X) (ptH X e1)) (PF'.PE.bE X x) (D.act-id X x) (transH (bvE X (idH X) (ptH X e1)) u.2.2.2) ;

    res : W0.Ix (PF'.PT.tobP X x) = ((bv, bn), (\ W f i -> refl (D.act W X f x), (q0, q1))) ;

    res-ta : Id (TP.EI X) (ta X (x, res)) (r.nt X x, u) =
      PF.PT.tp-ext X (ta X (x, res)) (r.nt X x, u) (refl (r.nt X x)) (\ V g j -> bvE V g j) ;

    opaque bn ; opaque q0 ; opaque q1 ;
  } ;

  bk (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (PF.PT.tobP X (r.nt X x))) : W0.Ix (PF'.PT.tobP X x) = Bk[X, x, u].res ;

  bkta (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (PF.PT.tobP X (r.nt X x))) : Id (TP.EI X) (ta X (x, bk X x u)) (r.nt X x, u) =
    Bk[X, x, u].res-ta ;

  opaque tainj ; opaque bkta ;

  module C = CCart[l, l].Cart[D, PF'.PathT, G, PF.PathT, r.nt, r.nt-nat, ta, \ W v -> refl (r.nt W v.1), tanat, tainj, bk, bkta] ;
} ;
