-- CFibU2.seg (L7, inside CB): the side value of the fibrancy of the
-- universe is natural: restricted along h it is the side value of the
-- restricted line, over F h (CGlueCartNat; the lines agree by actF-o).
--
-- Quarry: seg/model GCompU2.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module SVN (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  (X : Ob) (lam : V1.Ix (CLine[a+].FC[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx].ob X)) (d : Bool)
  (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) (pF : Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) ((CLine[a+].FC[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx].ev (tgt d)).nt X lam) F)
  (ph : Phi X) (full : IsT (allS X ph))
  (J : Ob) (h : Hom J X) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module PU = CPartial[a+].Partials[UU.UCtx, UA.UaTy] ;

  module FGU = CLine[a+].FC[UU.UCtx] ;
  module D = CFibU1.SV[Cl, clSub, clSub-id, clSub-o, encCl, elFib, X, lam, d, F, pF, ph, full] ;
  module D' = CFibU1.SV[Cl, clSub, clSub-id, clSub-o, encCl, elFib, J, FGU.actF J X h lam, d, UU.uAct J X h F,
    transH (FGU.evN (tgt d) J X h lam) (apH (UU.uAct J X h) pF), pre J X h ph, UA.fullAct J X h ph full] ;
  RES : L.PCtx = D.GIU ;

  Pell (W : Ob) (r : W0.Ix (D'.R.RC.ob W)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h r.1)))
    : Id (V1.Ix (RES.ob W)) (D.ell W (compH W J X h r.1, q2)) (D'.ell W r) = FGU.actF-o W J X h r.1 lam ;

  PB (W : Ob) (g : Hom W J) (q : IsT (CGlueD.fl J (pre J X h ph) W g)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h g)))
    : Id (UU.U0 W) (D.B W (compH W J X h g) q2) (D'.B W g q) = apH (D.cS W) (Pell W (g, q) q2) ;

  PtA (W : Ob) (v : D'.TAt.EI W) (q2 : IsT (CGlueD.fl X ph W (compH W J X h v.1.1)))
    : Id (D.TAg.EI W) (D'.tA W v) (D.tA W ((compH W J X h v.1.1, q2), v.2)) =
    D.pair-eqV1 (V1.Ix (RES.ob W)) (D.codeA W) (D'.ell W v.1) (D.ell W (compH W J X h v.1.1, q2)) (symH (Pell W v.1 q2))
      (D'.toA W v.1 v.2) (D.toA W (compH W J X h v.1.1, q2) v.2) (apH (D.codeA W) (symH (Pell W v.1 q2)))
      (transH (apH (CExtEq1.sV (D.codeA W (D'.ell W v.1)) (D.codeA W (D.ell W (compH W J X h v.1.1, q2))) (apH (D.codeA W) (symH (Pell W v.1 q2))))
                 (D'.toAV W v.1 v.2))
        (transH (CExtEq1.sV-two (D.o W (compH W J X h v.1.1)) (D.codeA W (D'.ell W v.1)) (D.codeA W (D.ell W (compH W J X h v.1.1, q2)))
                   (transH (apH (D'.o W) (symH (comp-idr W J v.1.1))) (apH (UU.fib0 W) (symH (D'.PF W v.1))))
                   (apH (D.codeA W) (symH (Pell W v.1 q2)))
                   (transH (apH (D.o W) (symH (comp-idr W X (compH W J X h v.1.1)))) (apH (UU.fib0 W) (symH (D.PF W (compH W J X h v.1.1, q2))))) v.2)
                (symH (D.toAV W (compH W J X h v.1.1, q2) v.2)))) ;

  codeB (W : Ob) (y : V1.Ix (RES.ob W)) : W0.V = UU.fib0 W (D.cS W y) ;

  PtB (W : Ob) (r : W0.Ix (D'.R.RC.ob W)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h r.1)))
    (b : W0.Ix (UU.fib0 W (D.B W (compH W J X h r.1) q2)))
    : Id (D.TBg.EI W)
         (D'.tB W (r, subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (D.B W (compH W J X h r.1) q2) (D'.B W r.1 r.2) (PB W r.1 r.2 q2) b))
         (D.tB W ((compH W J X h r.1, q2), b)) =
    D.pair-eqV1 (V1.Ix (RES.ob W)) (codeB W) (D'.ell W r) (D.ell W (compH W J X h r.1, q2)) (symH (Pell W r q2))
      (subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (D.B W (compH W J X h r.1) q2) (D'.B W r.1 r.2) (PB W r.1 r.2 q2) b) b
      (apH (codeB W) (symH (Pell W r q2)))
      (transH (apH (CExtEq1.sV (codeB W (D'.ell W r)) (codeB W (D.ell W (compH W J X h r.1, q2))) (apH (codeB W) (symH (Pell W r q2))))
                 (UU.substF W (D.B W (compH W J X h r.1) q2) (D'.B W r.1 r.2) (PB W r.1 r.2 q2) b))
              (CExtEq1.sV-two (codeB W (D.ell W (compH W J X h r.1, q2))) (codeB W (D'.ell W r)) (codeB W (D.ell W (compH W J X h r.1, q2)))
                 (apH (UU.fib0 W) (PB W r.1 r.2 q2)) (apH (codeB W) (symH (Pell W r q2))) (refl (codeB W (D.ell W (compH W J X h r.1, q2)))) b)) ;

  opaque PtA ; opaque PtB ;

  module N = CGlueCartNat.GCN[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, D.B, D.bn, RES, D.TF.SB, D.TF.SA, D.TF.tr, D.TF.trEquiv,
    D.ell, D.ell-nat, D.tA, \ W v -> refl (D.ell W v.1), D.tAnat, D.tAinj, D.fromA, D.bkAta, D.tB, \ W v -> refl (D.ell W v.1), D.tBnat, D.tBinj, \ Y x z -> z, \ Y x z -> refl (D.ell Y x, z),
    J, h, D'.B, D'.bn,
    D'.ell, D'.ell-nat, D'.tA, \ W v -> refl (D'.ell W v.1), D'.tAnat, D'.tAinj, D'.fromA, D'.bkAta, D'.tB, \ W v -> refl (D'.ell W v.1), D'.tBnat, D'.tBinj, \ Y x z -> z, \ Y x z -> refl (D'.ell Y x, z),
    PB, PtA, PtB] ;

  -- the side value commutes with restriction
  law : Id (GE.GD1 J) (GE.act1 J X h D.dat) D'.dat = N.law ;

  lawU : Id (UA.UaT0 J (UU.uAct J X h F)) (UA.uaTact J X h F (UU.uAct J X h F) (refl (UU.uAct J X h F)) D.out) D'.out =
    UA.uaExt J (UU.uAct J X h F) (UA.uaTact J X h F (UU.uAct J X h F) (refl (UU.uAct J X h F)) D.out) D'.out law ;
} ;
