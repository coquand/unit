-- A shuffle chain commutes with a cartesian map that respects horns.
module DPS = CDPrS[a] ;

module Prism
  (h' : DH'.isFib) (h : DH.isFib) (law : HornLaw h' h) (N : Nat)
  (x : WD.Ix (C.FD.ob N)) (y : WG.Ix (C.FG.ob N))
  (points : (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
     -> Id (TA.Pt W) (s W (x.1 W f j)) (y.1 W f j)) {
  module DC' = CDChain[a, k].DC[D, A', N, x.1, x.2] ;
  module DC = CDChain[a, l].DC[G, A, N, y.1, y.2] ;
  module P' = DC'.P ;
  module P = DC.P ;

  Related (S : DPS.PrS N) (L' : P'.PLine[S]) (L : P.PLine[S]) : U l =
    (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (p : IsT (S.1 W f j))
    -> Id (TA.EI W) (ta W (L'.v W f j p)) (L.v W f j p) ;

  module Chain (S : Nat -> DPS.PrS N)
    (kv : Nat -> Nat) (hkv : (d : Nat) -> IsT (leb d N) -> IsT (leb (kv d) (suc N)))
    (s1 : Nat -> Hom (lin (suc N)) (lin N)) (s2 : Nat -> Hom (lin (suc N)) Iv)
    (Mem : Nat -> (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> Bool) (Mc : (d : Nat) -> DPS.PrClos N (Mem d))
    (fac : (d W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> IsT (Mem d W f j) -> Hom (lin W) (lin (suc N)))
    (fac1 : (d W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (Mem d W f j))
            -> Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc N)) (lin N) (s1 d) (fac d W f j u)) f)
    (fac2 : (d W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (Mem d W f j))
            -> Id (Hom (lin W) Iv) (compH (lin W) (lin (suc N)) Iv (s2 d) (fac d W f j u)) j)
    (uniq : (d W : Nat) (h h' : Hom (lin W) (lin (suc N)))
            -> Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc N)) (lin N) (s1 d) h) (compH (lin W) (lin (suc N)) (lin N) (s1 d) h')
            -> Id (Hom (lin W) Iv) (compH (lin W) (lin (suc N)) Iv (s2 d) h) (compH (lin W) (lin (suc N)) Iv (s2 d) h')
            -> Id (Hom (lin W) (lin (suc N))) h h')
    (cap1 : (d : Nat) -> IsT (leb d N) -> (W : Nat) (g : Hom (lin W) (lin (suc N)))
            -> IsT ((S d).1 W (compH (lin W) (lin (suc N)) (lin N) (s1 d) g) (compH (lin W) (lin (suc N)) Iv (s2 d) g))
            -> DB.Lands W (suc N) (hornS N (kv d)) g)
    (cap2 : (d : Nat) -> IsT (leb d N) -> (W : Nat) (g : Hom (lin W) (lin (suc N))) -> DB.Lands W (suc N) (hornS N (kv d)) g
            -> IsT ((S d).1 W (compH (lin W) (lin (suc N)) (lin N) (s1 d) g) (compH (lin W) (lin (suc N)) Iv (s2 d) g)))
    (inc : (d : Nat) -> IsT (leb d N) -> (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
           -> IsT ((S (suc d)).1 W f j) -> IsT (or ((S d).1 W f j) (Mem d W f j)))
    (L' : P'.PLine[S zero]) (L : P.PLine[S zero]) (r0 : Related (S zero) L' L) {

    module C' = DC'.Chain[S, L', kv, hkv, s1, s2, Mem, Mc, fac, fac1, fac2, uniq, cap1, cap2, inc, h'] ;
    module Cg = DC.Chain[S, L, kv, hkv, s1, s2, Mem, Mc, fac, fac1, fac2, uniq, cap1, cap2, inc, h] ;

    module Next (d : Nat) (hd : IsT (leb d N)) (z' : P'.PLine[S d]) (z : P.PLine[S d])
      (r : Related (S d) z' z) {
      module X' = C'.Step[d, hd, z'].Gl ;
      module X = Cg.Step[d, hd, z].Gl ;

      filler : Id (TA.EI (suc N)) (ta (suc N) X'.aE) X.aE =
        law N (kv d) (hkv d hd) X'.rho X.rho (points (suc N) (s1 d) (s2 d))
          X'.hdata X.hdata (\ W f i -> r W _ _ (cap2 d hd W f i)) ;

      value (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (p : IsT (X.S'.1 W f j))
        : Id (TA.EI W) (ta W (X'.L'.v W f j p)) (X.L'.v W f j p) =
        bcaseL _ ((S d).1 W f j)
          (\ t -> transH (apH (ta W) (X'.vS W f j p t))
             (transH (r W f j t) (symH (X.vS W f j p t))))
          (\ nt -> outside W f j p nt (X.memOf W f j p nt))
       where {
         outside (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (p : IsT (X.S'.1 W f j))
           (nt : Id Bool ((S d).1 W f j) false) (u : IsT (Mem d W f j))
           : Id (TA.EI W) (ta W (X'.L'.v W f j p)) (X.L'.v W f j p) =
           transH (apH (ta W) (X'.vM W f j p nt u))
             (transH (symH (tn W (suc N) (fac d W f j u) X'.aE))
               (transH (apH (TA.E.act W (suc N) (fac d W f j u)) filler) (symH (X.vM W f j p nt u)))) ;
       } ;

      opaque filler ; opaque value ;
    } ;

    related : (d : Nat) (hd : IsT (leb d (suc N))) -> Related (S d) (C'.chain d hd) (Cg.chain d hd) = split {
      zero -> \ hd -> r0 ;
      suc d | ih-d -> \ hd W f j p ->
        Next[d, hd, C'.chain d (leb-step d N hd), Cg.chain d (leb-step d N hd), ih-d (leb-step d N hd)].value
          W f j (inc d hd W f j p) } ;

    opaque related ;
  } ;

  open CDCapT[a] ;
  open CDCapBase[a] ;
  open CDPrism[a] ;
  open CDeltaFact[a] ;
  module DPm = CDPrism[a] ;
  module DT = CDCapT[a] ;
  module DF = CDCapF[a] ;
  module PF' = CDPrismFill[a, k].PF[D, A', h', N, x.1, x.2] ;
  module PF = CDPrismFill[a, l].PF[G, A, h, N, y.1, y.2] ;

  module FT (L' : P'.PLine[S0 N zero]) (L : P.PLine[S0 N zero]) (r : Related (S0 N zero) L' L) {
    module T' = PF'.FT[L'] ;
    module T = PF.FT[L] ;
    module Ch = Chain[\ d -> ST N d, 
      \ d -> subN N d, \ d hd -> leb-step (subN N d) N (sub-le N d),
      \ d -> gkD N (subN N d), \ d -> jkD N (subN N d),
      \ d -> DPm.memP N (subN N d), \ d -> DPm.memP-clos N (subN N d),
      \ d -> DPm.facP N (subN N d), \ d W f j u -> DPm.FacP[N, subN N d, W, f, j, u].e1, \ d W f j u -> DPm.FacP[N, subN N d, W, f, j, u].e2,
      \ d -> DPm.uniqP N (subN N d),
      \ d hd -> DT.CT[N, d, hd].capT1, \ d hd -> DT.CT[N, d, hd].capT2, \ d hd -> DT.CT[N, d, hd].incT,
      DC'.restrPL (S0 N zero) (ST N zero) T'.inc0 L',
      DC.restrPL (S0 N zero) (ST N zero) T.inc0 L,
      \ W f j p -> transH
        (apH (\ z -> ta W (L'.v W f j z)) (isProp-IsT' _ (T'.inc0 W f j p) (T.inc0 W f j p)))
        (r W f j (T.inc0 W f j p))] ;

    total (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      : Id (TA.EI W) (ta W (T'.tot W f j)) (T.tot W f j) =
      transH
        (apH (\ z -> ta W (T'.final.v W f j z)) (isProp-IsT' _ (T'.inAll W f j) (T.inAll W f j)))
        (Ch.related (suc N) (leb-refl N) W f j (T.inAll W f j)) ;
  } ;

  module FF (L' : P'.PLine[S0 N (suc zero)]) (L : P.PLine[S0 N (suc zero)]) (r : Related (S0 N (suc zero)) L' L) {
    module T' = PF'.FF[L'] ;
    module T = PF.FF[L] ;
    module Ch = Chain[\ d -> SF N d, 
      \ d -> suc d, \ d hd -> hd,
      \ d -> gkD N d, \ d -> jkD N d,
      \ d -> DPm.memP N d, \ d -> DPm.memP-clos N d,
      \ d -> DPm.facP N d, \ d W f j u -> DPm.FacP[N, d, W, f, j, u].e1, \ d W f j u -> DPm.FacP[N, d, W, f, j, u].e2,
      \ d -> DPm.uniqP N d,
      \ d hd -> DF.CF[N, d, hd].capF1, \ d hd -> DF.CF[N, d, hd].capF2, \ d hd -> DF.CF[N, d, hd].incF,
      DC'.restrPL (S0 N (suc zero)) (SF N zero) T'.inc0 L',
      DC.restrPL (S0 N (suc zero)) (SF N zero) T.inc0 L,
      \ W f j p -> transH
        (apH (\ z -> ta W (L'.v W f j z)) (isProp-IsT' _ (T'.inc0 W f j p) (T.inc0 W f j p)))
        (r W f j (T.inc0 W f j p))] ;

    total (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      : Id (TA.EI W) (ta W (T'.tot W f j)) (T.tot W f j) =
      transH
        (apH (\ z -> ta W (T'.final.v W f j z)) (isProp-IsT' _ (T'.inAll W f j) (T.inAll W f j)))
        (Ch.related (suc N) (leb-refl N) W f j (T.inAll W f j)) ;
  } ;

} ;
