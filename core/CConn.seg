-- CConn.seg (L3, inside CB, level l): connection lines and constant lines,
-- on lines as families (CLine.FC / FT).
--
--   connG W z i   the line j |-> z (c_d (i , j)) of G at W
--   connA W L i   the same for a line L in A
--   constA W u    the constant line at u in A
--
-- Quarry: seg/model GConn (ConnKit), without the path-structure interface.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module Conn (G : PCtx) (A : PTy[G]) (d : Bool) {
  module FG = CLine[l].FC[G] ;
  module FA = CLine[l].FT[G, A] ;
  module TA = GPR.TyL[G, A] ;
  module TL = FA.TL ;

  cIeq (V' V W : Ob) (g : Hom V' V) (f : Hom V W) (i : Hom W Iv) (j : Hom V Iv)
    : Id (Hom V' Iv) (compH V' V Iv (cI d V (compH V W Iv i f) j) g)
                     (cI d V' (compH V' W Iv i (compH V' V W f g)) (compH V' V Iv j g)) =
    transH (cI-nat d V' V g (compH V W Iv i f) j)
           (apH (\ k -> cI d V' k (compH V' V Iv j g)) (comp-assoc V' V W Iv i f g)) ;

  ----------------------------------------------------------------------
  -- in G

  connG (W : Ob) (z : W0.Ix (FG.ob W)) (i : Hom W Iv) : W0.Ix (FG.ob W) =
    (\ V g j -> z.1 V g (cI d V (compH V W Iv i g) j),
     \ V' V g f j -> transH (z.2 V' V g f (cI d V (compH V W Iv i f) j))
                            (apH (\ k -> z.1 V' (compH V' V W f g) k) (cIeq V' V W g f i j))) ;

  connG-act (W' W : Ob) (g : Hom W' W) (z : W0.Ix (FG.ob W)) (i : Hom W Iv)
    : Id (W0.Ix (FG.ob W')) (FG.actF W' W g (connG W z i)) (connG W' (FG.actF W' W g z) (compH W' W Iv i g)) =
    FG.fam-eq W' (FG.actF W' W g (connG W z i)) (connG W' (FG.actF W' W g z) (compH W' W Iv i g))
      (\ V f j -> apH (\ k -> z.1 V (compH V W' W g f) (cI d V k j)) (symH (comp-assoc V W' W Iv i g f))) ;

  -- its end at src d is that of z, its end at tgt d is z at (id , i)
  connG-src (W : Ob) (z : W0.Ix (FG.ob W)) (i : Hom W Iv)
    : Id (W0.Ix (G.ob W)) ((FG.ev (src d)).nt W (connG W z i)) ((FG.ev (src d)).nt W z) =
    apH (\ k -> z.1 W (idH W) k) (cI-jsrc d W (compH W W Iv i (idH W))) ;

  connG-tgt (W : Ob) (z : W0.Ix (FG.ob W)) (i : Hom W Iv)
    : Id (W0.Ix (G.ob W)) ((FG.ev (tgt d)).nt W (connG W z i)) (z.1 W (idH W) i) =
    apH (\ k -> z.1 W (idH W) k) (transH (cI-jtgt d W (compH W W Iv i (idH W))) (comp-idr W Iv i)) ;

  ----------------------------------------------------------------------
  -- in A

  connA (W : Ob) (L : TL.EI W) (i : Hom W Iv) : TL.EI W =
    (connG W L.1 i,
     FA.lamA W (connG W L.1 i)
       (\ V g j -> L.2.1.1 V g (cI d V (compH V W Iv i g) j))
       (\ V g j -> apH (\ y -> y.1 V g (cI d V (compH V W Iv i g) j)) L.2.2)
       (\ V' V g f j -> transH (L.2.1.2 V' V g f (cI d V (compH V W Iv i f) j))
                               (apH (\ k -> L.2.1.1 V' (compH V' V W f g) k) (cIeq V' V W g f i j)))) ;

  connA-val (W : Ob) (L : TL.EI W) (i : Hom W Iv) (V : Ob) (g : Hom V W) (j : Hom V Iv)
    : Id (TA.EI V) ((connA W L i).2.1.1 V g j) (L.2.1.1 V g (cI d V (compH V W Iv i g) j)) =
    refl (L.2.1.1 V g (cI d V (compH V W Iv i g) j)) ;

  constA (W : Ob) (u : TA.EI W) : TL.EI W =
    (FG.constF W u.1,
     FA.lamA W (FG.constF W u.1) (\ V g j -> TA.E.act V W g u) (\ V g j -> refl (G.act V W g u.1))
       (\ V' V g f j -> TA.PE.actC V' V W f g u)) ;

  constA-val (W : Ob) (u : TA.EI W) (V : Ob) (g : Hom V W) (j : Hom V Iv)
    : Id (TA.EI V) ((constA W u).2.1.1 V g j) (TA.E.act V W g u) = refl (TA.E.act V W g u) ;
} ;
