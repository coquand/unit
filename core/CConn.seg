-- CConn.seg (L3, inside CB, level l): connection lines and constant lines,
-- on lines as families (CLine.FC / FT).
--
--   connG W z i   the line j |-> z (c_d (i , j)) of G at W
--   connA W L i   the same for a line L in A
--   constA W u    the constant line at u in A
--
-- Quarry: seg/model GConn (ConnKit), without the path-structure interface.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module Conn (G : PCtx) (A : PTy[G]) (d : Bool) {
  module FG = CLine[l].FC[G] ;
  module FA = CLine[l].FT[G, A] ;
  module TA = GPR.TyL[G, A] ;
  module TL = FA.TL ;

  cIeq (V' V W : Ob) (g : Hom V' V) (f : Hom V W) (i : IvP W) (j : IvP V)
    : Id (IvP V') (ivA V' V g (cI d V (ivA V W f i) j))
                     (cI d V' (ivA V' W (compH V' V W f g) i) (ivA V' V g j)) =
    transH (cI-nat d V' V g (ivA V W f i) j)
           (apH (\ k -> cI d V' k (ivA V' V g j)) (ivA-comp V' V W f g i)) ;

  ----------------------------------------------------------------------
  -- in G

  connG (W : Ob) (z : W0.Ix (FG.ob W)) (i : IvP W) : W0.Ix (FG.ob W) =
    (\ V g j -> z.1 V g (cI d V (ivA V W g i) j),
     \ V' V g f j -> transH (z.2 V' V g f (cI d V (ivA V W f i) j))
                            (apH (\ k -> z.1 V' (compH V' V W f g) k) (cIeq V' V W g f i j))) ;

  connG-act (W' W : Ob) (g : Hom W' W) (z : W0.Ix (FG.ob W)) (i : IvP W)
    : Id (W0.Ix (FG.ob W')) (FG.actF W' W g (connG W z i)) (connG W' (FG.actF W' W g z) (ivA W' W g i)) =
    FG.fam-eq W' (FG.actF W' W g (connG W z i)) (connG W' (FG.actF W' W g z) (ivA W' W g i))
      (\ V f j -> apH (\ k -> z.1 V (compH V W' W g f) (cI d V k j)) (symH (ivA-comp V W' W g f i))) ;

  -- its end at src d is that of z, its end at tgt d is z at (id , i)
  connG-src (W : Ob) (z : W0.Ix (FG.ob W)) (i : IvP W)
    : Id (W0.Ix (G.ob W)) ((FG.ev (src d)).nt W (connG W z i)) ((FG.ev (src d)).nt W z) =
    apH (\ k -> z.1 W (idH W) k) (cI-jsrc d W (ivA W W (idH W) i)) ;

  connG-tgt (W : Ob) (z : W0.Ix (FG.ob W)) (i : IvP W)
    : Id (W0.Ix (G.ob W)) ((FG.ev (tgt d)).nt W (connG W z i)) (z.1 W (idH W) i) =
    apH (\ k -> z.1 W (idH W) k) (transH (cI-jtgt d W (ivA W W (idH W) i)) (ivA-id W i)) ;

  ----------------------------------------------------------------------
  -- in A

  connA (W : Ob) (L : TL.EI W) (i : IvP W) : TL.EI W =
    (TL.pr W (connG W (TL.pr1 W L) i) (FA.lamA W (connG W (TL.pr1 W L) i)
       (\ V g j -> FA.lval W L V g (cI d V (ivA V W g i) j))
       (\ V g j -> apH (\ y -> y.1 V g (cI d V (ivA V W g i) j)) (TL.pr2 W L).2)
       (\ V' V g f j -> transH ((TL.pr2 W L).1.2 V' V g f (cI d V (ivA V W f i) j))
                               (apH (\ k -> FA.lval W L V' (compH V' V W f g) k) (cIeq V' V W g f i j))))) ;

  connA-val (W : Ob) (L : TL.EI W) (i : IvP W) (V : Ob) (g : Hom V W) (j : IvP V)
    : Id (TA.EI V) (FA.lval W (connA W L i) V g j) (FA.lval W L V g (cI d V (ivA V W g i) j)) =
    refl (FA.lval W L V g (cI d V (ivA V W g i) j)) ;

  constA (W : Ob) (u : TA.EI W) : TL.EI W =
    (TL.pr W (FG.constF W (TA.pr1 W u)) (FA.lamA W (FG.constF W (TA.pr1 W u)) (\ V g j -> TA.E.act V W g u) (\ V g j -> refl (G.act V W g (TA.pr1 W u)))
       (\ V' V g f j -> TA.PE.actC V' V W f g u))) ;

  constA-val (W : Ob) (u : TA.EI W) (V : Ob) (g : Hom V W) (j : IvP V)
    : Id (TA.EI V) (FA.lval W (constA W u) V g j) (TA.E.act V W g u) = refl (TA.E.act V W g u) ;
} ;
