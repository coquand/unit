-- CHFibLaws.seg (L3, inside CB, levels i j k n): the laws of moveEq
-- (CHFibCart), once: congruence (pointwise equal maps move alike),
-- composite (moving twice is moving along the composite), identity
-- (moving along identity maps does nothing).  Each is CMoveLaws on the
-- Move data of the homotopy fibres, with the fibre maps compared by
-- fibE-eq.
--
-- Quarry: seg/model GTransferEqCong, GTransferEqComp, GTransferEqTwice,
-- GEqLaws (LawId), GEqLaws2 (LawO).

level i j k ;
constraint a <= i ;
constraint a <= j ;
constraint a <= k ;
open Base ;
open Prelude[(i \/ j \/ k)+] ;
open Paths[(i \/ j \/ k)+] ;
module W1 = V[i] ;
module W2 = V[j] ;
module W0 = V[k] ;
module P1 = GPre[i] ;
module P2 = GPre[j] ;
module P0 = GPre[k] ;

------------------------------------------------------------------------
-- congruence: two carts with pointwise equal maps

module HCong (D : P1.PS.PCtx) (B' A' : P1.PS.PTy[D]) (al' : CPartial[i].PMap[D, B', A'])
  (G : P0.PS.PCtx) (B A : P0.PS.PTy[G]) (al : CPartial[k].PMap[G, B, A])
  (s1 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s1 V (D.act V W g d)) (G.act V W g (s1 W d)))
  (tA1 : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tApt1 : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (tA1 W v).1 (s1 W v.1))
  (tAnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (tA1 W v)) (tA1 V (P1.TyL[D, A'].E.act V W g v)))
  (tAinj1 : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (tA1 W v) (tA1 W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bkA1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s1 X x))) -> W1.Ix (A'.tob X x))
  (bkAta1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s1 X x))) -> Id (P0.TyL[G, A].EI X) (tA1 X (x, bkA1 X x u)) (s1 X x, u))
  (tB1 : (W : Ob) -> P1.TyL[D, B'].EI W -> P0.TyL[G, B].EI W)
  (tBpt1 : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (W0.Ix (G.ob W)) (tB1 W v).1 (s1 W v.1))
  (tBnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, B'].EI W)
     -> Id (P0.TyL[G, B].EI V) (P0.TyL[G, B].E.act V W g (tB1 W v)) (tB1 V (P1.TyL[D, B'].E.act V W g v)))
  (tBinj1 : (W : Ob) (v v' : P1.TyL[D, B'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, B].EI W) (tB1 W v) (tB1 W v'))
     -> Id (P1.TyL[D, B'].EI W) v v')
  (bkB1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (B.tob X (s1 X x))) -> W1.Ix (B'.tob X x))
  (bkBta1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (B.tob X (s1 X x))) -> Id (P0.TyL[G, B].EI X) (tB1 X (x, bkB1 X x u)) (s1 X x, u))
  (comm1 : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (P0.TyL[G, A].EI W) (tA1 W (al'.mE W v)) (al.mE W (tB1 W v)))
  (s2 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s2 V (D.act V W g d)) (G.act V W g (s2 W d)))
  (tA2 : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tApt2 : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (tA2 W v).1 (s2 W v.1))
  (tAnat2 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (tA2 W v)) (tA2 V (P1.TyL[D, A'].E.act V W g v)))
  (tAinj2 : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (tA2 W v) (tA2 W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bkA2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> W1.Ix (A'.tob X x))
  (bkAta2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> Id (P0.TyL[G, A].EI X) (tA2 X (x, bkA2 X x u)) (s2 X x, u))
  (tB2 : (W : Ob) -> P1.TyL[D, B'].EI W -> P0.TyL[G, B].EI W)
  (tBpt2 : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (W0.Ix (G.ob W)) (tB2 W v).1 (s2 W v.1))
  (tBnat2 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, B'].EI W)
     -> Id (P0.TyL[G, B].EI V) (P0.TyL[G, B].E.act V W g (tB2 W v)) (tB2 V (P1.TyL[D, B'].E.act V W g v)))
  (tBinj2 : (W : Ob) (v v' : P1.TyL[D, B'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, B].EI W) (tB2 W v) (tB2 W v'))
     -> Id (P1.TyL[D, B'].EI W) v v')
  (bkB2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (B.tob X (s2 X x))) -> W1.Ix (B'.tob X x))
  (bkBta2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (B.tob X (s2 X x))) -> Id (P0.TyL[G, B].EI X) (tB2 X (x, bkB2 X x u)) (s2 X x, u))
  (comm2 : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (P0.TyL[G, A].EI W) (tA2 W (al'.mE W v)) (al.mE W (tB2 W v)))
  (PtA : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (P0.TyL[G, A].EI W) (tA1 W v) (tA2 W v))
  (PtB : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (P0.TyL[G, B].EI W) (tB1 W v) (tB2 W v))
  (e : CEquiv[k].EquivOp G B A al) {
  module H1 = CHFibCart[k, i].HCart[D, B', A', al', G, B, A, al, s1, s-nat1, tA1, tApt1, tAnat1, tAinj1, bkA1, bkAta1, tB1, tBpt1, tBnat1, tBinj1, bkB1, bkBta1, comm1] ;
  module H2 = CHFibCart[k, i].HCart[D, B', A', al', G, B, A, al, s2, s-nat2, tA2, tApt2, tAnat2, tAinj2, bkA2, bkAta2, tB2, tBpt2, tBnat2, tBinj2, bkB2, bkBta2, comm2] ;
  module F = H1.F ;

  PmS (W : Ob) (v : H1.F'.TF.EI W) : Id (F.TF.EI W) (H1.mS W v) (H2.mS W v) =
    F.fibE-eq W (H1.mS W v) (H2.mS W v) (PtA W v.1)
      (transH (H1.bm-E W v) (transH (PtB W (H1.F'.fibB W v)) (symH (H2.bm-E W v))))
      (\ W' f j0 -> PtA W' (H1.F'.fibL W v W' f j0)) ;

  cong : Id (CEquiv[i].EquivOp D B' A' al') (H1.moveEq e) (H2.moveEq e) =
    CMoveLaws[i, i, k].Cong[H1.F'.EA, H1.F'.FibT, H1.F'.FibT, CPartial[i].pmap-id H1.F'.EA H1.F'.FibT,
      F.EA, F.FibT, F.FibT, CPartial[k].pmap-id F.EA F.FibT,
      tA1, H1.sE-nat, H1.mS, \ W v -> refl (tA1 W v.1), H1.mSnat, H1.mS, \ W v -> refl (tA1 W v.1), H1.mSnat, H1.mSinj,
      \ X w u -> H1.Bk[X, w, u].res, \ X w u -> H1.Bk[X, w, u].res-t, \ W v -> refl (H1.mS W v),
      tA2, H2.sE-nat, H2.mS, \ W v -> refl (tA2 W v.1), H2.mSnat, H2.mS, \ W v -> refl (tA2 W v.1), H2.mSnat, H2.mSinj,
      \ X w u -> H2.Bk[X, w, u].res, \ X w u -> H2.Bk[X, w, u].res-t, \ W v -> refl (H2.mS W v),
      PtA, PmS, PmS, e].cong ;
} ;

------------------------------------------------------------------------
-- composite: moving along H2 then along H1 is moving along the composite

module HComp (D1 : P1.PS.PCtx) (B1 A1 : P1.PS.PTy[D1]) (al1 : CPartial[i].PMap[D1, B1, A1])
  (D : P2.PS.PCtx) (B' A' : P2.PS.PTy[D]) (al' : CPartial[j].PMap[D, B', A'])
  (G : P0.PS.PCtx) (B A : P0.PS.PTy[G]) (al : CPartial[k].PMap[G, B, A])
  (s1 : (W : Ob) -> W1.Ix (D1.ob W) -> W2.Ix (D.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D1.ob W)) -> Id (W2.Ix (D.ob V)) (s1 V (D1.act V W g d)) (D.act V W g (s1 W d)))
  (tA1 : (W : Ob) -> P1.TyL[D1, A1].EI W -> P2.TyL[D, A'].EI W)
  (tApt1 : (W : Ob) (v : P1.TyL[D1, A1].EI W) -> Id (W2.Ix (D.ob W)) (tA1 W v).1 (s1 W v.1))
  (tAnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, A1].EI W)
     -> Id (P2.TyL[D, A'].EI V) (P2.TyL[D, A'].E.act V W g (tA1 W v)) (tA1 V (P1.TyL[D1, A1].E.act V W g v)))
  (tAinj1 : (W : Ob) (v v' : P1.TyL[D1, A1].EI W) (P : Id (W1.Ix (D1.ob W)) v.1 v'.1) (Q : Id (P2.TyL[D, A'].EI W) (tA1 W v) (tA1 W v'))
     -> Id (P1.TyL[D1, A1].EI W) v v')
  (bkA1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (A'.tob X (s1 X x))) -> W1.Ix (A1.tob X x))
  (bkAta1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (A'.tob X (s1 X x))) -> Id (P2.TyL[D, A'].EI X) (tA1 X (x, bkA1 X x u)) (s1 X x, u))
  (tB1 : (W : Ob) -> P1.TyL[D1, B1].EI W -> P2.TyL[D, B'].EI W)
  (tBpt1 : (W : Ob) (v : P1.TyL[D1, B1].EI W) -> Id (W2.Ix (D.ob W)) (tB1 W v).1 (s1 W v.1))
  (tBnat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, B1].EI W)
     -> Id (P2.TyL[D, B'].EI V) (P2.TyL[D, B'].E.act V W g (tB1 W v)) (tB1 V (P1.TyL[D1, B1].E.act V W g v)))
  (tBinj1 : (W : Ob) (v v' : P1.TyL[D1, B1].EI W) (P : Id (W1.Ix (D1.ob W)) v.1 v'.1) (Q : Id (P2.TyL[D, B'].EI W) (tB1 W v) (tB1 W v'))
     -> Id (P1.TyL[D1, B1].EI W) v v')
  (bkB1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (B'.tob X (s1 X x))) -> W1.Ix (B1.tob X x))
  (bkBta1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (B'.tob X (s1 X x))) -> Id (P2.TyL[D, B'].EI X) (tB1 X (x, bkB1 X x u)) (s1 X x, u))
  (comm1 : (W : Ob) (v : P1.TyL[D1, B1].EI W) -> Id (P2.TyL[D, A'].EI W) (tA1 W (al1.mE W v)) (al'.mE W (tB1 W v)))
  (s2 : (W : Ob) -> W2.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W2.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s2 V (D.act V W g d)) (G.act V W g (s2 W d)))
  (tA2 : (W : Ob) -> P2.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tApt2 : (W : Ob) (v : P2.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (tA2 W v).1 (s2 W v.1))
  (tAnat2 : (V W : Ob) (g : Hom V W) (v : P2.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (tA2 W v)) (tA2 V (P2.TyL[D, A'].E.act V W g v)))
  (tAinj2 : (W : Ob) (v v' : P2.TyL[D, A'].EI W) (P : Id (W2.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (tA2 W v) (tA2 W v'))
     -> Id (P2.TyL[D, A'].EI W) v v')
  (bkA2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> W2.Ix (A'.tob X x))
  (bkAta2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> Id (P0.TyL[G, A].EI X) (tA2 X (x, bkA2 X x u)) (s2 X x, u))
  (tB2 : (W : Ob) -> P2.TyL[D, B'].EI W -> P0.TyL[G, B].EI W)
  (tBpt2 : (W : Ob) (v : P2.TyL[D, B'].EI W) -> Id (W0.Ix (G.ob W)) (tB2 W v).1 (s2 W v.1))
  (tBnat2 : (V W : Ob) (g : Hom V W) (v : P2.TyL[D, B'].EI W)
     -> Id (P0.TyL[G, B].EI V) (P0.TyL[G, B].E.act V W g (tB2 W v)) (tB2 V (P2.TyL[D, B'].E.act V W g v)))
  (tBinj2 : (W : Ob) (v v' : P2.TyL[D, B'].EI W) (P : Id (W2.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, B].EI W) (tB2 W v) (tB2 W v'))
     -> Id (P2.TyL[D, B'].EI W) v v')
  (bkB2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (B.tob X (s2 X x))) -> W2.Ix (B'.tob X x))
  (bkBta2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (B.tob X (s2 X x))) -> Id (P0.TyL[G, B].EI X) (tB2 X (x, bkB2 X x u)) (s2 X x, u))
  (comm2 : (W : Ob) (v : P2.TyL[D, B'].EI W) -> Id (P0.TyL[G, A].EI W) (tA2 W (al'.mE W v)) (al.mE W (tB2 W v)))
  (e : CEquiv[k].EquivOp G B A al) {
  module H2 = CHFibCart[k, j].HCart[D, B', A', al', G, B, A, al, s2, s-nat2, tA2, tApt2, tAnat2, tAinj2, bkA2, bkAta2, tB2, tBpt2, tBnat2, tBinj2, bkB2, bkBta2, comm2] ;
  module H1 = CHFibCart[j, i].HCart[D1, B1, A1, al1, D, B', A', al', s1, s-nat1, tA1, tApt1, tAnat1, tAinj1, bkA1, bkAta1, tB1, tBpt1, tBnat1, tBinj1, bkB1, bkBta1, comm1] ;

  -- the composite cart
  s (W : Ob) (d : W1.Ix (D1.ob W)) : W0.Ix (G.ob W) = s2 W (s1 W d) ;
  s-nat (V W : Ob) (g : Hom V W) (d : W1.Ix (D1.ob W)) : Id (W0.Ix (G.ob V)) (s V (D1.act V W g d)) (G.act V W g (s W d)) =
    transH (apH (s2 V) (s-nat1 V W g d)) (s-nat2 V W g (s1 W d)) ;
  tA (W : Ob) (v : P1.TyL[D1, A1].EI W) : P0.TyL[G, A].EI W = tA2 W (tA1 W v) ;
  tApt (W : Ob) (v : P1.TyL[D1, A1].EI W) : Id (W0.Ix (G.ob W)) (tA W v).1 (s W v.1) = transH (tApt2 W (tA1 W v)) (apH (s2 W) (tApt1 W v)) ;
  tAnat (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, A1].EI W)
    : Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (tA W v)) (tA V (P1.TyL[D1, A1].E.act V W g v)) =
    transH (tAnat2 V W g (tA1 W v)) (apH (tA2 V) (tAnat1 V W g v)) ;
  tAinj (W : Ob) (v v' : P1.TyL[D1, A1].EI W) (P : Id (W1.Ix (D1.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (tA W v) (tA W v'))
    : Id (P1.TyL[D1, A1].EI W) v v' =
    tAinj1 W v v' P (tAinj2 W (tA1 W v) (tA1 W v') (transH (tApt1 W v) (transH (apH (s1 W) P) (symH (tApt1 W v')))) Q) ;
  bkA (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (A.tob X (s X x))) : W1.Ix (A1.tob X x) = bkA1 X x (bkA2 X (s1 X x) u) ;
  bkAta (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (A.tob X (s X x))) : Id (P0.TyL[G, A].EI X) (tA X (x, bkA X x u)) (s X x, u) =
    transH (apH (tA2 X) (bkAta1 X x (bkA2 X (s1 X x) u))) (bkAta2 X (s1 X x) u) ;
  tB (W : Ob) (v : P1.TyL[D1, B1].EI W) : P0.TyL[G, B].EI W = tB2 W (tB1 W v) ;
  tBpt (W : Ob) (v : P1.TyL[D1, B1].EI W) : Id (W0.Ix (G.ob W)) (tB W v).1 (s W v.1) = transH (tBpt2 W (tB1 W v)) (apH (s2 W) (tBpt1 W v)) ;
  tBnat (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, B1].EI W)
    : Id (P0.TyL[G, B].EI V) (P0.TyL[G, B].E.act V W g (tB W v)) (tB V (P1.TyL[D1, B1].E.act V W g v)) =
    transH (tBnat2 V W g (tB1 W v)) (apH (tB2 V) (tBnat1 V W g v)) ;
  tBinj (W : Ob) (v v' : P1.TyL[D1, B1].EI W) (P : Id (W1.Ix (D1.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, B].EI W) (tB W v) (tB W v'))
    : Id (P1.TyL[D1, B1].EI W) v v' =
    tBinj1 W v v' P (tBinj2 W (tB1 W v) (tB1 W v') (transH (tBpt1 W v) (transH (apH (s1 W) P) (symH (tBpt1 W v')))) Q) ;
  bkB (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (B.tob X (s X x))) : W1.Ix (B1.tob X x) = bkB1 X x (bkB2 X (s1 X x) u) ;
  bkBta (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (B.tob X (s X x))) : Id (P0.TyL[G, B].EI X) (tB X (x, bkB X x u)) (s X x, u) =
    transH (apH (tB2 X) (bkBta1 X x (bkB2 X (s1 X x) u))) (bkBta2 X (s1 X x) u) ;
  comm (W : Ob) (v : P1.TyL[D1, B1].EI W) : Id (P0.TyL[G, A].EI W) (tA W (al1.mE W v)) (al.mE W (tB W v)) =
    transH (apH (tA2 W) (comm1 W v)) (comm2 W (tB1 W v)) ;

  module H12 = CHFibCart[k, i].HCart[D1, B1, A1, al1, G, B, A, al, s, s-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta, comm] ;

  module CP = CMoveLaws[i, j, k].Comp[H1.F'.EA, H1.F'.FibT, H1.F'.FibT, CPartial[i].pmap-id H1.F'.EA H1.F'.FibT,
    H2.F'.EA, H2.F'.FibT, H2.F'.FibT, CPartial[j].pmap-id H2.F'.EA H2.F'.FibT,
    H2.F.EA, H2.F.FibT, H2.F.FibT, CPartial[k].pmap-id H2.F.EA H2.F.FibT,
    tA1, H1.sE-nat, H1.mS, \ W v -> refl (tA1 W v.1), H1.mSnat, H1.mS, \ W v -> refl (tA1 W v.1), H1.mSnat, H1.mSinj,
      \ X w u -> H1.Bk[X, w, u].res, \ X w u -> H1.Bk[X, w, u].res-t, \ W v -> refl (H1.mS W v),
    tA2, H2.sE-nat, H2.mS, \ W v -> refl (tA2 W v.1), H2.mSnat, H2.mS, \ W v -> refl (tA2 W v.1), H2.mSnat, H2.mSinj,
      \ X w u -> H2.Bk[X, w, u].res, \ X w u -> H2.Bk[X, w, u].res-t, \ W v -> refl (H2.mS W v), e] ;

  PmS (W : Ob) (v : H1.F'.TF.EI W) : Id (H2.F.TF.EI W) (H2.mS W (H1.mS W v)) (H12.mS W v) =
    H2.F.fibE-eq W (H2.mS W (H1.mS W v)) (H12.mS W v) (refl (tA W v.1))
      (transH (H2.bm-E W (H1.mS W v)) (transH (apH (tB2 W) (H1.bm-E W v)) (symH (H12.bm-E W v))))
      (\ W' f j0 -> refl (tA W' (H1.F'.fibL W v W' f j0))) ;

  comp : Id (CEquiv[i].EquivOp D1 B1 A1 al1) (H1.moveEq (H2.moveEq e)) (H12.moveEq e) =
    transH CP.comp
      (CMoveLaws[i, i, k].Cong[H1.F'.EA, H1.F'.FibT, H1.F'.FibT, CPartial[i].pmap-id H1.F'.EA H1.F'.FibT,
        H2.F.EA, H2.F.FibT, H2.F.FibT, CPartial[k].pmap-id H2.F.EA H2.F.FibT,
        CP.s, CP.s-nat, CP.mS, CP.mSpt, CP.mSnat, CP.mT, CP.mTpt, CP.mTnat, CP.mTinj, CP.bk, CP.bkMv, CP.sq,
        tA, H12.sE-nat, H12.mS, \ W v -> refl (tA W v.1), H12.mSnat, H12.mS, \ W v -> refl (tA W v.1), H12.mSnat, H12.mSinj,
      \ X w u -> H12.Bk[X, w, u].res, \ X w u -> H12.Bk[X, w, u].res-t, \ W v -> refl (H12.mS W v),
        \ W x -> refl (tA W x), PmS, PmS, e].cong) ;
} ;

------------------------------------------------------------------------
-- identity: moving along identity maps does nothing

module HId (D : P1.PS.PCtx) (B' A' : P1.PS.PTy[D]) (al' : CPartial[i].PMap[D, B', A']) (e : CEquiv[i].EquivOp D B' A' al') {
  module H = CHFibCart[i, i].HCart[D, B', A', al', D, B', A', al',
    \ W d -> d, \ V W g d -> refl (D.act V W g d),
    \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (P1.TyL[D, A'].E.act V W g v), \ W v v' P Q -> Q,
    \ X x u -> u, \ X x u -> refl (x, u),
    \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (P1.TyL[D, B'].E.act V W g v), \ W v v' P Q -> Q,
    \ X x u -> u, \ X x u -> refl (x, u),
    \ W v -> refl (al'.mE W v)] ;
  module F = H.F ;
  module I1 = CMoveLaws[i, i, i].Id1[F.EA, F.FibT, F.FibT, CPartial[i].pmap-id F.EA F.FibT, e] ;

  PmS (W : Ob) (v : F.TF.EI W) : Id (F.TF.EI W) (H.mS W v) v =
    F.fibE-eq W (H.mS W v) v (refl v.1) (H.bm-E W v) (\ W' f j0 -> refl (F.fibL W v W' f j0)) ;

  idm : Id (CEquiv[i].EquivOp D B' A' al') (H.moveEq e) e =
    transH (CMoveLaws[i, i, i].Cong[F.EA, F.FibT, F.FibT, CPartial[i].pmap-id F.EA F.FibT,
              F.EA, F.FibT, F.FibT, CPartial[i].pmap-id F.EA F.FibT,
              (\ W v -> v), H.sE-nat, H.mS, \ W v -> refl v.1, H.mSnat, H.mS, \ W v -> refl v.1, H.mSnat, H.mSinj,
      \ X w u -> H.Bk[X, w, u].res, \ X w u -> H.Bk[X, w, u].res-t, \ W v -> refl (H.mS W v),
              \ W d -> d, \ V W g d -> refl (F.EA.act V W g d),
              \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (F.TF.E.act V W g v),
              \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (F.TF.E.act V W g v),
              \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> refl v,
              \ W x -> refl x, PmS, PmS, e].cong)
      (symH I1.idm) ;
} ;
