-- The simplicial development with excluded middle as a parameter.
open Base ;

module Delta (lem : [b] (P : U b) -> Prelude[b].isProp P -> Arith[b].Plus P (P -> Empty)) {
  module Classical = CClassical.Cl[lem] ;
  open Classical ;
  import CDHornDirection ;
  import CDHornTotalData ;
  import CDHornNat ;
} ;
