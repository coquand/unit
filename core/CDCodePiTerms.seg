-- The terms of a named product are the terms of the underlying product.
module At (G : PCtx) (A : C.C.Ty G) (B : C.C.Ty (O.ext G A)) {
  module P0 = PresheafPi[a, a+].PPi[N.DB.BC].PiCode[G, C.decode G A, C.decode (O.ext G A) B] ;
  module Form = N.CDNameDecode.Read[G, (raw G A B).1, N.horn G (raw G A B).1 (raw G A B).2] ;
  namedT : PTy[G] = C.decode G (Pi G A B) ;
  actual : PTy[G] = P0.PiP ;
  p : Id (PTy[G]) namedT actual = Form.law ;

  Target : U a+ = O.El (O.ext G A) B ;
  Terms (X : PTy[G]) : U a+ = PEl[G, X] ;

  -- The term bijection is transported along the equality of presheaf
  -- types obtained by decoding the product name.
  iso : Iso (O.El G (Pi G A B)) Target =
    idJ (PTy[G]) actual
      (\ X q -> Iso (Terms X) Target) P0.PiP-iso namedT (symH p) ;
} ;
