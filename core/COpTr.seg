-- COpTr.seg (L2, inside CB, level l): transport is a move, for operations
-- without uniformity (model.tex lem:tr-move).  A path P : A = A2 of types
-- over D gives fibre maps (transport along P); an operation c of A
-- transported along P is c pulled back along them (COpMove.Pull).  Proof:
-- J on P; at refl the pull-back has the same fillers.
--
-- Quarry: seg/model DClT.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module TO (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (i : I) -> Phi (ob i)) (D : PCtx) (A : PTy[D]) {
  module TR = CTrFib[l].TR[D, A] ;

  -- a fibre bijection, both ways
  bf (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (W : Ob) (x : W0.Ix (D.ob W)) (b : W0.Ix (A2.tob W x))
    : Id (W0.Ix (A2.tob W x)) (TR.fwV A2 P2 W x (TR.trV A2 P2 W x b)) b =
    idJ (PTy[D]) A (\ A3 P3 -> (b3 : W0.Ix (A3.tob W x)) -> Id (W0.Ix (A3.tob W x)) (TR.fwV A3 P3 W x (TR.trV A3 P3 W x b3)) b3)
      (\ b3 -> refl b3) A2 P2 b ;

  fb (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (W : Ob) (x : W0.Ix (D.ob W)) (b : W0.Ix (A.tob W x))
    : Id (W0.Ix (A.tob W x)) (TR.trV A2 P2 W x (TR.fwV A2 P2 W x b)) b =
    idJ (PTy[D]) A (\ A3 P3 -> Id (W0.Ix (A.tob W x)) (TR.trV A3 P3 W x (TR.fwV A3 P3 W x b)) b)
      (refl b) A2 P2 ;

  module Pl (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (c : COp[l].OpS[I, ok, ob, S, D, A].Op) {
    module P = COpMove[l, l].Pull[I, ok, ob, S, D, A2, D, A, \ W x -> x, \ V W g x -> refl (D.act V W g x),
      TR.trV A2 P2, TR.fwV A2 P2, bf A2 P2, fb A2 P2, TR.tanat A2 P2, c] ;
  } ;

  -- transport is the pull-back
  law (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) : (c : COp[l].OpS[I, ok, ob, S, D, A].Op)
      -> Id ((T : PTy[D]) * COp[l].OpS[I, ok, ob, S, D, T].Op) (A, c) (A2, Pl[A2, P2, c].P.op) =
    idJ (PTy[D]) A
      (\ A3 P3 -> (c : COp[l].OpS[I, ok, ob, S, D, A].Op)
         -> Id ((T : PTy[D]) * COp[l].OpS[I, ok, ob, S, D, T].Op) (A, c) (A3, Pl[A3, P3, c].P.op))
      (\ c -> apH {COp[l].OpS[I, ok, ob, S, D, A].Op} {(T : PTy[D]) * COp[l].OpS[I, ok, ob, S, D, T].Op} (\ z -> (A, z))
         (COp[l].OpS[I, ok, ob, S, D, A].op-ext c Pl[A, refl A, c].P.op (\ i o rho h ->
            apH {COp[l].OpS[I, ok, ob, S, D, A].HData i rho} {W0.Ix (A.tob (ob i) rho)} (\ hd -> (c i o rho hd).1)
              (COp[l].OpS[I, ok, ob, S, D, A].hd-eq i rho h (Pl[A, refl A, c].P.mv i rho h) (refl h.1)))))
      A2 P2 ;

  opaque law ;
} ;
