-- CFibFinal.seg (L6/L7, inside CB, Cl = Fib): the final statements for
-- the classifier Cl = Fib, from El's fibration and lem:el-yon only:
-- univalence (CUaOp.ua) and the universe fibrant (CFibU3.fibU), with
-- smallCl / (C1) / (C2) discharged (CSmallSub, CSmallFull3).
-- Both instances (posets, Delta) supply elFib and yonH.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L = GPre[a+].PS ;
open GYon[a] ;

module UF (elFib : CLine[a+].Lines[CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].UCtx, CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].EGen].Fib)
  (yonH : (Z : Ob) (F : CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].U0 Z)
     -> Id (CLine[a].Lines[yP Z, F.1].Fib) (CYonCart.YC[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].Yc[Z, F].K.moveFib elFib) F.2) {
  module UB = CExtBig.UB[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl] ;
  module XS = CExtSmall.XS[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl, elFib] ;

  smallCl (D : PCtx) (l : CSmall.XSub[D, UB.GDr]) : CFibCl.Cl D (CSmall.xsub D UB.GDr XS.SA l) = XS.fibExt D l ;

  smallCl-sub (D D' : PCtx) (l : CSmall.XSub[D, UB.GDr]) (t : PSub[D', D])
    : Id ((A : PTy[D']) * CFibCl.Cl D' A)
         (subTy D' D (CSmall.xsub D UB.GDr XS.SA l) t, CFibCl.clSub D' D t (CSmall.xsub D UB.GDr XS.SA l) (smallCl D l))
         (CSmall.xsub D' UB.GDr XS.SA (CSmall.xoS D' D UB.GDr l t), smallCl D' (CSmall.xoS D' D UB.GDr l t)) =
    CSmallSub.SS[UB.GDr, XS.SA, D, D', l, t, XS.fibSA].law ;

  smallCl-full (W : Ob) (y : CGlueE.GE[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].GD1 W) (q : IsT (CGlueD.fl W y.1.2.1 W (idH W)))
    : Id (CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].U0 W) (CSmall.xsub (yP W) UB.GDr XS.SA (UB.yhat W y), smallCl (yP W) (UB.yhat W y)) (y.1.2.2.1 W (idH W) q) =
    CSmallFull3.F3[elFib, yonH, W, y, q].law ;

  -- univalence
  module UO = CUaOp.UaOp[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl, elFib, smallCl, smallCl-sub, smallCl-full] ;
  ua : CPartial[a+].ContrOp UO.UU.UCtx UO.UA.UaTy = UO.ua ;

  -- the universe is fibrant, in any context
  fibU (G : L.PCtx) : CLine[a+].Lines[G, CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].UTy G].Fib =
    CFibU3.FibU[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl, elFib, smallCl, smallCl-sub, smallCl-full, G].fibU ;
} ;
