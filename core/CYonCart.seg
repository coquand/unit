-- CYonCart.seg (L4, inside CB): the Yoneda cart of a code (model.tex
-- lem:el-yon).  For F in U(Z), the map k |-> F k of y Z into the
-- universe is covered by a cart from F.1 into El (fibre maps: transport
-- along F (k id) = F k).  Its derived maps (CCart) are the maps of lines,
-- strict-fibre elements and composites.
--
-- Quarry: seg/model PElL (ElP), GElC (Yon.H1).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module LP = GPre[a+] ;
open GYon[a] ;
open Encode[a, a+] ;

module YC (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module TE = LP.TyL[UU.UCtx, UU.EGen] ;

  sV (v w : W0.V) (c : Id W0.V v w) (z : W0.Ix v) : W0.Ix w = subst W0.V (\ u -> W0.Ix u) v w c z ;

  sV-round (v w : W0.V) (c : Id W0.V v w) (z : W0.Ix w) : Id (W0.Ix w) (sV v w c (sV w v (symH c) z)) z =
    idJ W0.V v (\ w2 c2 -> (z2 : W0.Ix w2) -> Id (W0.Ix w2) (sV v w2 c2 (sV w2 v (symH c2) z2)) z2) (\ z2 -> refl z2) w c z ;

  sV-round' (v w : W0.V) (c : Id W0.V v w) (z : W0.Ix v) : Id (W0.Ix v) (sV w v (symH c) (sV v w c z)) z =
    idJ W0.V v (\ w2 c2 -> Id (W0.Ix v) (sV w2 v (symH c2) (sV v w2 c2 z)) z) (refl z) w c ;

  -- the action of El on a pair, with any path of codes
  tacE (V W : Ob) (g : Hom V W) (c : UU.U0 W) (c' : UU.U0 V) (q : Id (UU.U0 V) (UU.uAct V W g c) c') (b : W0.Ix (UU.fib0 W c))
    : Id (TE.EI V) (TE.E.act V W g (c, b)) (c', UU.tactG V W g c c' q b) =
    idJ (UU.U0 V) (UU.uAct V W g c) (\ c2 q2 -> Id (TE.EI V) (TE.E.act V W g (c, b)) (c2, UU.tactG V W g c c2 q2 b))
      (refl (TE.E.act V W g (c, b))) c' q ;

  -- pairs of El, over a path of codes
  pairE (V : Ob) (c c' : UU.U0 V) (p : Id (UU.U0 V) c c') (b : W0.Ix (UU.fib0 V c)) (b' : W0.Ix (UU.fib0 V c'))
    (H : Id (W0.Ix (UU.fib0 V c')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) c c' p b) b') : Id (TE.EI V) (c, b) (c', b') =
    idJ (UU.U0 V) c (\ c2 p2 -> (b2 : W0.Ix (UU.fib0 V c2)) -> Id (W0.Ix (UU.fib0 V c2)) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) c c2 p2 b) b2
                       -> Id (TE.EI V) (c, b) (c2, b2))
      (\ b2 H2 -> apH {W0.Ix (UU.fib0 V c)} {TE.EI V} (\ z -> (c, z)) H2) c' p b' H ;

  ------------------------------------------------------------------------
  -- the Yoneda cart of a code F over y Z

  module Yc (Z : Ob) (F : UU.U0 Z) {
    module TF = GPR.TyL[yP Z, F.1] ;

    s (W : Ob) (k : Hom W Z) : UU.U0 W = UU.uAct W Z k F ;

    s-nat (V W : Ob) (g : Hom V W) (k : Hom W Z) : Id (UU.U0 V) (s V (compH V W Z k g)) (UU.uAct V W g (s W k)) =
      UU.uAct-o V W Z k g F ;

    Po (I : Ob) (x : Hom I Z) : Id W0.V (UU.fib0 I (s I x)) (F.1.tob I x) = apH (F.1.tob I) (comp-idr I Z x) ;

    -- El's action read in F (GElC Yon.H1, with any path of codes)
    H1 (J I : Ob) (f : Hom J I) (x : Hom I Z) (y : Hom J Z) (e : Id (Hom J Z) (compH J I Z x f) y)
      (e' : Id (UU.U0 J) (UU.uAct J I f (s I x)) (s J y)) (a0 : W0.Ix (UU.fib0 I (s I x)))
      : Id (W0.Ix (F.1.tob J y))
           (sV (UU.fib0 J (s J y)) (F.1.tob J y) (Po J y) (UU.tactG J I f (s I x) (s J y) e' a0))
           (F.1.tact J I f x y e (sV (UU.fib0 I (s I x)) (F.1.tob I x) (Po I x) a0)) =
      calc (W0.Ix (F.1.tob J y)) {
          sV (UU.fib0 J (s J y)) (F.1.tob J y) (Po J y) (UU.tactG J I f (s I x) (s J y) e' a0)
        =< apH (sV (UU.fib0 J (s J y)) (F.1.tob J y) (Po J y))
             (transH (UU.substF J (UU.uAct J I f (s I x)) (s J y) e' t)
               (UU.fib-move (Hom J Z) (F.1.tob J) y1 y0 pH (ap (UU.U0 J) W0.V (UU.fib0 J) (UU.uAct J I f (s I x)) (s J y) e') t)) >
          sV (F.1.tob J y0) (F.1.tob J y) (Po J y) (subst (Hom J Z) (\ k -> W0.Ix (F.1.tob J k)) y1 y0 pH t)
        =< apH (sV (F.1.tob J y0) (F.1.tob J y) (Po J y)) (UU.tact-move (yP Z) F.1 J I f x0 y1 y0 n (transH n pH) pH a0) >
          sV (F.1.tob J y0) (F.1.tob J y) (Po J y) (F.1.tact J I f x0 y0 (transH n pH) a0)
        =< UU.fib-move (Hom J Z) (F.1.tob J) y0 y (comp-idr J Z y) (Po J y) (F.1.tact J I f x0 y0 (transH n pH) a0) >
          subst (Hom J Z) (\ k -> W0.Ix (F.1.tob J k)) y0 y (comp-idr J Z y) (F.1.tact J I f x0 y0 (transH n pH) a0)
        =< UU.tact-move (yP Z) F.1 J I f x0 y0 y (transH n pH) eY (comp-idr J Z y) a0 >
          F.1.tact J I f x0 y eY a0
        =< symH (UU.tact-src-move (yP Z) F.1 J I f x0 x y (comp-idr I Z x) e eY a0) >
          F.1.tact J I f x y e (subst (Hom I Z) (\ k -> W0.Ix (F.1.tob I k)) x0 x (comp-idr I Z x) a0)
        =< apH (F.1.tact J I f x y e) (symH (UU.fib-move (Hom I Z) (F.1.tob I) x0 x (comp-idr I Z x) (Po I x) a0)) >
          F.1.tact J I f x y e (sV (UU.fib0 I (s I x)) (F.1.tob I x) (Po I x) a0) }
     where {
       x0 : Hom I Z = compH I I Z x (idH I) ;
       y1 : Hom J Z = compH J I Z x (compH J J I f (idH J)) ;
       y0 : Hom J Z = compH J J Z y (idH J) ;
       n : Id (Hom J Z) (compH J I Z x0 f) y1 = ntEq (yP I) (yP Z) (yH I Z x) J I f (idH I) (compH J J I f (idH J)) (UU.idf-eq J I f) ;
       pH : Id (Hom J Z) y1 y0 = transH (apH (compH J I Z x) (comp-idr J I f)) (transH e (symH (comp-idr J Z y))) ;
       eY : Id (Hom J Z) (compH J I Z x0 f) y = transH (transH n pH) (comp-idr J Z y) ;
       t : W0.Ix (F.1.tob J y1) = F.1.tact J I f x0 y1 n a0 ; } ;

    ta (W : Ob) (v : TF.EI W) : TE.EI W = (s W v.1, sV (F.1.tob W v.1) (UU.fib0 W (s W v.1)) (symH (Po W v.1)) v.2) ;

    tanat (V W : Ob) (g : Hom V W) (v : TF.EI W) : Id (TE.EI V) (TE.E.act V W g (ta W v)) (ta V (TF.E.act V W g v)) =
      transH (tacE V W g (s W v.1) (s V (compH V W Z v.1 g)) (symH (s-nat V W g v.1)) (ta W v).2)
        (apH {W0.Ix (UU.fib0 V (s V (compH V W Z v.1 g)))} {TE.EI V} (\ z -> (s V (compH V W Z v.1 g), z))
          (transH (symH (sV-round' (UU.fib0 V (s V (compH V W Z v.1 g))) (F.1.tob V (compH V W Z v.1 g)) (Po V (compH V W Z v.1 g))
                     (UU.tactG V W g (s W v.1) (s V (compH V W Z v.1 g)) (symH (s-nat V W g v.1)) (ta W v).2)))
            (apH (sV (F.1.tob V (compH V W Z v.1 g)) (UU.fib0 V (s V (compH V W Z v.1 g))) (symH (Po V (compH V W Z v.1 g))))
              (transH (H1 V W g v.1 (compH V W Z v.1 g) (refl (compH V W Z v.1 g)) (symH (s-nat V W g v.1)) (ta W v).2)
                (apH (F.1.tact V W g v.1 (compH V W Z v.1 g) (refl (compH V W Z v.1 g)))
                   (sV-round (UU.fib0 W (s W v.1)) (F.1.tob W v.1) (Po W v.1) v.2)))))) ;

    tainj (W : Ob) (v v' : TF.EI W) (P : Id (Hom W Z) v.1 v'.1) (Q : Id (TE.EI W) (ta W v) (ta W v')) : Id (TF.EI W) v v' =
      idJ (Hom W Z) v.1
        (\ k2 P2 -> (b2 : W0.Ix (F.1.tob W k2)) -> Id (TE.EI W) (ta W v) (ta W (k2, b2)) -> Id (TF.EI W) v (k2, b2))
        (\ b2 Q2 -> apH {W0.Ix (F.1.tob W v.1)} {TF.EI W} (\ z -> (v.1, z))
           (transH (symH (sV-round' (F.1.tob W v.1) (UU.fib0 W (s W v.1)) (symH (Po W v.1)) v.2))
             (transH (apH (sV (UU.fib0 W (s W v.1)) (F.1.tob W v.1) (symH (symH (Po W v.1)))) (TE.pr-inj W (s W v.1) (ta W v).2 (ta W (v.1, b2)).2 Q2))
                     (sV-round' (F.1.tob W v.1) (UU.fib0 W (s W v.1)) (symH (Po W v.1)) b2))))
        v'.1 P v'.2 Q ;

    bk (X : Ob) (k : Hom X Z) (u : W0.Ix (UU.fib0 X (s X k))) : W0.Ix (F.1.tob X k) = sV (UU.fib0 X (s X k)) (F.1.tob X k) (Po X k) u ;

    bkta (X : Ob) (k : Hom X Z) (u : W0.Ix (UU.fib0 X (s X k))) : Id (TE.EI X) (ta X (k, bk X k u)) (s X k, u) =
      apH {W0.Ix (UU.fib0 X (s X k))} {TE.EI X} (\ z -> (s X k, z))
        (sV-round' (UU.fib0 X (s X k)) (F.1.tob X k) (Po X k) u) ;

    opaque tanat ; opaque tainj ; opaque bkta ;

    module K = CCart[a+, a].Cart[yP Z, F.1, UU.UCtx, UU.EGen, s, s-nat, ta, \ W v -> refl (s W v.1), tanat, tainj, bk, bkta] ;
  } ;
} ;
