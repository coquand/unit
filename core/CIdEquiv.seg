-- CIdEquiv.seg (L3, inside CB, level l): the projection of Swan's identity
-- type to the path type is an equivalence (model.tex §9.1, Prop "Id and
-- Path").  A side p of the homotopy fibre of proj over w = (y , q): its
-- lines form a partial line of paths over the constant line at y, ending
-- at q (S1); filled by Fill e1 of the path type, the filler starts at a
-- path a0, and the fibre element is ((a0 , ph) , filler) with
--     ph = p.pQ /\ (f |-> the sieve of the Id part of p at f).
-- a0 is constant on ph because at a map in p's sieve it is the path part
-- of p (the filler agrees with the sides).  As CExtEquiv2/3, one side.
--
--   IE[.., kP, dc].equiv     an equivalence structure on proj
--   IdEquiv[G, A, a, b]      for Id(a , b) over G

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module IE (K H : PCtx) (A : PTy[H])
  (s : (X : Ob) -> W0.Ix (K.ob X) -> (W : Ob) -> Hom W X -> Hom W Iv -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (aE bE : (W : Ob) -> W0.Ix (K.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (K.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (K.act W X f x)))
  (kP : CLine[l].Lines[K, CPath[l].PathOverE[K, H, A, true, s, sN, aE, bE, aE-act, bE-act].PathP].Fill e1)
  (dc : CId[l].DConj) {
  module IO = CId[l].IdOver[K, H, A, s, sN, aE, bE, aE-act, bE-act] ;
  module PT = IO.PT ;
  module TA = PT.TA ;
  module TP = PT.TP ;
  module TI = IO.TI ;
  module HF = CEquiv[l].HFib[K, IO.IdT, PT.PathP, IO.proj] ;
  module FK = CLine[l].FC[K] ;
  module FTP = CLine[l].FT[K, PT.PathP] ;
  module KA = CLine[l].EndKit[K, PT.PathP, e1] ;
  module RK = CPartial[l].Rel[KA.TV.E, KA.SFm.SF, KA.SFm.SF, CPartial[l].pmap-id KA.TV.E KA.SFm.SF] ;
  module PX = CPartial[l].Partials[HF.EA, HF.FibT] ;
  module GL = GPR.PshL[K] ;

  -- the sieve of the Id part of a fibre element
  bPhi (V : Ob) (v : HF.TF.EI V) : Phi V = (HF.fibB V v).2.2.1 ;

  bPhi-act (V W : Ob) (g : Hom V W) (v : HF.TF.EI W) : Id (Phi V) (pre V W g (bPhi W v)) (bPhi V (HF.TF.E.act V W g v)) =
    apH (\ z -> z.2.2.1) (symH (HF.fibB-act V W g v)) ;

  module Th (X : Ob) (w : TP.EI X) (p : PX.Side[X, w]) {
    y : W0.Ix (K.ob X) = w.1 ;

    ------------------------------------------------------------------
    -- the base point: the constant line at y, with w at e1

    cL : W0.Ix (FK.ob X) = FK.constF X y ;

    x0 : KA.TV.EI X = (cL, TP.fromE X (K.act X X (idH X) y) w (symH (K.act-id X y))) ;

    x0-E : Id (TP.EI X) (KA.endE X x0) w = TP.fromE-eq X (K.act X X (idH X) y) w (symH (K.act-id X y)) ;

    x0-act (V : Ob) (f : Hom V X) : Id (TP.EI V) (TP.E.act V X f w) (KA.endE V (KA.TV.E.act V X f x0)) =
      transH (apH (TP.E.act V X f) (symH x0-E)) (symH (KA.endE-act V X f x0)) ;

    -- the side: the lines of p's fibre elements
    module S1 = CLineSide[l].LineSide[K, PT.PathP, e1, X, x0, p.pQ, \ V f i W g j -> HF.fibL V (p.pv V f i) W g j,
        \ V f i W g j -> transH (HF.fibL-pt V (p.pv V f i) W g j)
                           (transH (apH (\ z -> K.act W V g z.1) (p.ppt V f i)) (GL.actC W V X f g y)),
        \ V f i W' W g' g j -> HF.fibL-nat V (p.pv V f i) W' W g' g j,
        \ V f i -> transH (HF.fibL-1 V (p.pv V f i)) (transH (p.ppt V f i) (x0-act V f)),
        \ V' V chi f i i' W g j -> transH (apH (\ z -> HF.fibL V' z W g j) (symH (p.pnat V' V chi f i i')))
                                          (HF.fibL-act V' V chi (p.pv V f i) W g j)] ;

    ------------------------------------------------------------------
    -- the filler

    fill : W0.Ix (KA.SFm.SF.tob X x0) = kP.kop X x0 S1.side ;

    Fv (W : Ob) (f : Hom W X) (j : Hom W Iv) : TP.EI W = fill.1.1.1 W f j ;

    Fn (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
      : Id (TP.EI V) (TP.E.act V W g (Fv W f j)) (Fv V (compH V W X f g) (compH V W Iv j g)) = fill.1.1.2 V W g f j ;

    Fpt (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (W0.Ix (K.ob W)) (Fv W f j).1 (K.act W X f y) =
      apH (\ z -> z.1 W f j) fill.1.2 ;

    F1 : Id (TP.EI X) (Fv X (idH X) (ptH X e1)) w =
      transH (symH (FTP.Ev[e1].endB-E X (cL, fill.1))) (transH (apH (KA.endE X) fill.2) x0-E) ;

    F-S1 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TP.EI W) (Fv W (compH W V X f g) j) (HF.fibL V (p.pv V f i) W g j) =
      transH (symH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act V X f (x0, fill))))
        (transH (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (kP.kside X x0 S1.side V f i)) (S1.sv-val V f i W g j)) ;

    opaque F1 ; opaque F-S1 ;

    F0-act (W : Ob) (f : Hom W X)
      : Id (TP.EI W) (TP.E.act W X f (Fv X (idH X) (ptH X e0))) (Fv W (compH W W X f (idH W)) (ptH W e0)) =
      transH (Fn W X f (idH X) (ptH X e0))
        (transH (apH (\ k -> Fv W k (compH W X Iv (ptH X e0) f)) (transH (comp-idl W X f) (symH (comp-idr W X f))))
                (apH (\ k -> Fv W (compH W W X f (idH W)) k) (ptH-nat W X f e0))) ;

    ------------------------------------------------------------------
    -- the start a0 and the sieve ph

    a0E : TP.EI X = Fv X (idH X) (ptH X e0) ;

    a0pt : Id (W0.Ix (K.ob X)) a0E.1 y = transH (Fpt X (idH X) (ptH X e0)) (K.act-id X y) ;

    a0 : TP.T X y = TP.fromE X y a0E a0pt ;

    a0-E : Id (TP.EI X) (y, a0) a0E = TP.fromE-eq X y a0E a0pt ;

    Fs (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) : Phi V = bPhi V (p.pv V f i) ;

    Fn' (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X p.pQ f) (i' : Lands V X p.pQ (compH V W X f g))
      : Id (Phi V) (pre V W g (Fs W f i)) (Fs V (compH V W X f g) i') =
      transH (bPhi-act V W g (p.pv W f i)) (apH (bPhi V) (p.pnat V W g f i i')) ;

    module DL = CId[l].DCL[dc, X, p.pQ, Fs, Fn'] ;

    ph : Phi X = DL.DQ ;

    -- restricted to p's sieve, a0 is the path part of p
    a0side (W : Ob) (f : Hom W X) (i : Lands W X p.pQ f)
      : Id (TP.EI W) (TP.E.act W X f (y, a0)) (IO.proj.mE W (HF.fibB W (p.pv W f i))) =
      calc (TP.EI W) {
          TP.E.act W X f (y, a0)
        =< apH (TP.E.act W X f) a0-E >
          TP.E.act W X f a0E
        =< F0-act W f >
          Fv W (compH W W X f (idH W)) (ptH W e0)
        =< F-S1 W f i W (idH W) (ptH W e0) >
          HF.fibL W (p.pv W f i) W (idH W) (ptH W e0)
        =< HF.fibL-0 W (p.pv W f i) >
          IO.proj.mE W (HF.fibB W (p.pv W f i)) } ;

    c (W : Ob) (f : Hom W X) (l : Lands W X ph f) (k : Hom W Iv) : Id (TA.EI W) (a0.1.1 W f k) (aE W (K.act W X f y)) =
      calc (TA.EI W) {
          a0.1.1 W f k
        =< apH (\ m -> a0.1.1 W m k) (symH (comp-idr W X f)) >
          (TP.E.act W X f (y, a0)).2.1.1 W (idH W) k
        =< apH (\ z -> z.2.1.1 W (idH W) k) (a0side W f (dc.dc-out W X p.pQ Fs Fn' f l).1) >
          (HF.fibB W (p.pv W f (dc.dc-out W X p.pQ Fs Fn' f l).1)).2.1.1.1 W (idH W) k
        =< (HF.fibB W (p.pv W f (dc.dc-out W X p.pQ Fs Fn' f l).1)).2.2.2 W (idH W) (dc.dc-out W X p.pQ Fs Fn' f l).2 k >
          aE W (K.act W W (idH W) (HF.fibB W (p.pv W f (dc.dc-out W X p.pQ Fs Fn' f l).1)).1)
        =< apH (aE W) (transH (K.act-id W (HF.fibB W (p.pv W f (dc.dc-out W X p.pQ Fs Fn' f l).1)).1)
                         (symH (apH (\ z -> z.1) (a0side W f (dc.dc-out W X p.pQ Fs Fn' f l).1)))) >
          aE W (K.act W X f y) } ;

    b : TI.T X y = (a0, (ph, c)) ;

    F0 : Id (TP.EI X) (Fv X (idH X) (ptH X e0)) (IO.proj.mE X (y, b)) = symH a0-E ;

    v0 : HF.TF.EI X = HF.mkFib X w b Fv Fn Fpt F0 F1 ;
  } ;

  kop (X : Ob) (w : TP.EI X) (p : PX.Side[X, w]) : HF.TF.T X w = Th[X, w, p].v0.2 ;

  kside (X : Ob) (w : TP.EI X) (p : PX.Side[X, w]) (W : Ob) (f : Hom W X) (i : Lands W X p.pQ f)
    : Id (HF.TF.EI W) (HF.TF.E.act W X f (w, kop X w p)) (p.pv W f i) =
    HF.fibE-eq W (HF.TF.E.act W X f (w, kop X w p)) (p.pv W f i) (symH (p.ppt W f i))
      (transH (HF.fibB-act W X f Th[X, w, p].v0)
        (IO.tpI-ext W (TI.E.act W X f (w.1, Th[X, w, p].b)) (HF.fibB W (p.pv W f i))
           (apH (\ z -> z.1) (Th[X, w, p].a0side W f i))
           (\ V g k -> apH (\ z -> z.2.1.1 V g k) (Th[X, w, p].a0side W f i))
           (Th[X, w, p].DL.dc-at W f i)))
      (\ V g j -> Th[X, w, p].F-S1 W f i V g j) ;

  module KU (Y X : Ob) (h : Hom Y X) (w : TP.EI X) (p : PX.Side[X, w]) {
    wY : TP.EI Y = HF.EA.act Y X h w ;
    pY : PX.Side[Y, wY] = PX.rside Y X h w p ;

    module ThX = Th[X, w, p] ;
    module ThY = Th[Y, wY, pY] ;

    x0eq : Id (KA.TV.EI Y) (KA.TV.E.act Y X h ThX.x0) ThY.x0 =
      KA.tv-eq Y (KA.TV.E.act Y X h ThX.x0) ThY.x0
        (FK.fam-eq Y (FK.actF Y X h ThX.cL) ThY.cL (\ W f i -> symH (GL.actC W Y X h f ThX.y)))
        (transH (KA.endE-act Y X h ThX.x0) (transH (apH (TP.E.act Y X h) ThX.x0-E) (symH ThY.x0-E))) ;

    tsY (W : Ob) (g : Hom W Y) (u v : KA.TS.EI W)
      (pu : Id (KA.TV.EI W) u.1 (KA.TV.E.act W X (compH W Y X h g) ThX.x0))
      (pv : Id (KA.TV.EI W) v.1 (KA.TV.E.act W Y g ThY.x0))
      (q : (V : Ob) (g' : Hom V W) (j : Hom V Iv) -> Id (TP.EI V) ((KA.lineL W u).2.1.1 V g' j) ((KA.lineL W v).2.1.1 V g' j))
      : Id (KA.TS.EI W) u v =
      KA.ts-ext W u v
        (transH pu (transH (symH (KA.TV.PE.actC W Y X h g ThX.x0)) (transH (apH (KA.TV.E.act W Y g) x0eq) (symH pv)))) q ;

    ppR : Id (KA.PT.Side[Y, ThY.x0])
             (subst (KA.TV.EI Y) (\ z -> KA.PT.Side[Y, z]) (KA.TV.E.act Y X h ThX.x0) ThY.x0 x0eq
                    (KA.PT.rside Y X h ThX.x0 ThX.S1.side))
             ThY.S1.side =
      KA.PT.side-extH Y (KA.TV.E.act Y X h ThX.x0) ThY.x0 x0eq (KA.PT.rside Y X h ThX.x0 ThX.S1.side) ThY.S1.side
        (refl (pre Y X h p.pQ))
        (\ W g i i' ->
          tsY W g (ThX.S1.sv W (compH W Y X h g) (lands-pre W Y X h p.pQ g i)) (ThY.S1.sv W g i')
            (ThX.S1.sv-pt W (compH W Y X h g) (lands-pre W Y X h p.pQ g i)) (ThY.S1.sv-pt W g i')
            (\ V g' j -> transH (ThX.S1.sv-val W (compH W Y X h g) (lands-pre W Y X h p.pQ g i) V g' j)
                         (transH (apH (\ z -> HF.fibL W z V g' j)
                                    (PX.pv-irr X w p W (compH W Y X h g) (lands-pre W Y X h p.pQ g i) (lands-pre W Y X h p.pQ g i')))
                                 (symH (ThY.S1.sv-val W g i' V g' j))))) ;

    fillR : Id (KA.TS.EI Y) (KA.TS.E.act Y X h (ThX.x0, ThX.fill)) (ThY.x0, ThY.fill) =
      transH (kP.kunif Y X h ThX.x0 ThX.S1.side)
        (RK.kop-cong kP Y (KA.TV.E.act Y X h ThX.x0) ThY.x0 x0eq (KA.PT.rside Y X h ThX.x0 ThX.S1.side) ThY.S1.side ppR) ;

    FvR (W : Ob) (g : Hom W Y) (j : Hom W Iv) : Id (TP.EI W) (ThX.Fv W (compH W Y X h g) j) (ThY.Fv W g j) =
      transH (symH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act Y X h (ThX.x0, ThX.fill))))
             (apH (\ u -> (KA.lineL Y u).2.1.1 W g j) fillR) ;

    opaque ppR ; opaque fillR ;

    a0eq : Id (TP.EI Y) (TP.E.act Y X h (ThX.y, ThX.a0)) (ThY.y, ThY.a0) =
      transH (apH (TP.E.act Y X h) ThX.a0-E)
        (transH (ThX.F0-act Y h) (transH (FvR Y (idH Y) (ptH Y e0)) (symH ThY.a0-E))) ;

    bR : Id (TI.EI Y) (TI.E.act Y X h (ThX.y, ThX.b)) (ThY.y, ThY.b) =
      IO.tpI-ext Y (TI.E.act Y X h (ThX.y, ThX.b)) (ThY.y, ThY.b)
        (apH (\ z -> z.1) a0eq)
        (\ V g k -> apH (\ z -> z.2.1.1 V g k) a0eq)
        (ThX.DL.dc-restr Y h ThY.Fn') ;

    unif : Id (HF.TF.EI Y) (HF.TF.E.act Y X h (w, kop X w p)) (wY, kop Y wY pY) =
      HF.fibE-eq Y (HF.TF.E.act Y X h ThX.v0) ThY.v0 (refl wY)
        (transH (HF.fibB-act Y X h ThX.v0) bR)
        (\ W g j -> FvR W g j) ;
  } ;

  opaque kside ;

  equiv : CEquiv[l].EquivOp K IO.IdT PT.PathP IO.proj =
    new CPartial[l].Rel[HF.EA, HF.FibT, HF.FibT, CPartial[l].pmap-id HF.EA HF.FibT].RC[kop, kside,
      \ Y X h w p -> KU[Y, X, h, w, p].unif] ;
} ;

------------------------------------------------------------------------
-- for Id(a , b) over G

module IdEquiv (G : PCtx) (A : PTy[G]) (a b : PEl[G, A]) {
  module PF = CPathFib[l].PathFib[G, A, a, b] ;
  module IFb = CIdFib[l].IdFib[G, A, a, b] ;

  module EQ (kP : CLine[l].Lines[G, PF.PathT].Fill e1) (dc : CId[l].DConj) {
    module I = IE[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act, kP, dc] ;
  } ;

  -- the filler of the path type from its composition from e1 to e0
  equiv (fA : CLine[l].Lines[G, A].Fib) (dc : CId[l].DConj)
    : CEquiv[l].EquivOp G IFb.IdT PF.PathT CId[l].IdOver[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act].proj =
    EQ[CFill[l].FillC[G, PF.PathT, false, (PF.fib fA).2].fill, dc].I.equiv ;
} ;
