-- CExt2.seg (L5, inside CB; quarry seg/model GExt2, was Ext2.seg): MODEL/Poset/Ext.agda, part 2.  The action on pairs (PAct), and
-- the type Ext by cases on full: the action is by cases on the Bools at the
-- source and the target (true -> false is impossible, full-act).  Ext is
-- the type ExtT.
--
-- Agda's matches on (c , e) pairs of a Bool and an equation full X rho = c
-- are helpers splitting one Bool at a time (tactS/tactT/tactF, tid', the
-- segment TO for the composition law).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
open VCode[l] ;
module GP = CCof[l] ;

module ExtB2 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR]) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;

  -- the B-component of a pair depends on the map only, not on its presentation
  pb-hom (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f g : Hom W X) (E : Id (Hom W X) f g)
    (q : IsT (full W (G.act W X f rho))) (q' : IsT (full W (G.act W X g rho)))
    : Id (TB.EI W) (pb X rho u W f q) (pb X rho u W g q') =
    idJ (Hom W X) f (\ g2 E2 -> (q2 : IsT (full W (G.act W X g2 rho))) -> Id (TB.EI W) (pb X rho u W f q) (pb X rho u W g2 q2))
      (\ q2 -> apH (pb X rho u W f) (isProp-IsT' (full W (G.act W X f rho)) q q2)) g E q' ;

  -- the action on pairs, along f : J -> I with act f x = y
  module PAct (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (E : Id (W0.Ix (G.ob J)) (G.act J I f x) y) {

    qTr (W : Ob) (g : Hom W J) (q : IsT (full W (G.act W J g y))) : IsT (full W (G.act W I (compH W J I f g) x)) =
      full-eq W (G.act W J g y) (G.act W I (compH W J I f g) x) (symH (transH (G.act-o W J I f g x) (apH (G.act W J g) E))) q ;

    pbE (u : Pairs I x) : BETy J y = \ W g q -> pb I x u W (compH W J I f g) (qTr W g q) ;

    pbpt' (u : Pairs I x) : BptTy J y (pbE u) = \ W g q ->
      res-eq W (pbE u W g q).1 (G.act W J g y, q) (transH (G.act-o W J I f g x) (apH (G.act W J g) E)) ;

    pbal (u : Pairs I x) : BalTy J y (A.tact J I f x y E (pa I x u)) (pbE u) = \ W g q ->
      transH (pal I x u W (compH W J I f g) (qTr W g q))
       (transH (EA.act-o W J I f g (x, pa I x u)) (apH (EA.act W J g) (TA.pr-tact J I f x y E (pa I x u)))) ;

    -- naturality of pb at f g, and (f g) chi = f (g chi)
    pbnat (u : Pairs I x) : BnatTy J y (pbE u) = \ W' W chi g q q' ->
      transH (pnatF I x u W' W chi (compH W J I f g) (qTr W g q) (qA W' W chi g q'))
             (pb-hom I x u W' (compH W' W I (compH W J I f g) chi) (compH W' J I f (compH W' W J g chi))
                (comp-assoc W' W J I f g chi) (qA W' W chi g q') (qTr W' (compH W' W J g chi) q'))
     where {
      qA (W' W : Ob) (chi : Hom W' W) (g : Hom W J) (q' : IsT (full W' (G.act W' J (compH W' W J g chi) y)))
        : IsT (full W' (G.act W' I (compH W' W I (compH W J I f g) chi) x)) =
        full-eq W' (G.act W' I (compH W' J I f (compH W' W J g chi)) x) (G.act W' I (compH W' W I (compH W J I f g) chi) x)
          (apH (\ k -> G.act W' I k x) (symH (comp-assoc W' W J I f g chi))) (qTr W' (compH W' W J g chi) q') ; } ;

    pact (u : Pairs I x) : Pairs J y = mkPairs J y (A.tact J I f x y E (pa I x u)) (pbE u) (pbpt' u) (pbal u) (pbnat u) ;

    pact-a (u : Pairs I x) : Id (TA.T J y) (pa J y (pact u)) (A.tact J I f x y E (pa I x u)) =
      mkPairs-a J y (A.tact J I f x y E (pa I x u)) (pbE u) (pbpt' u) (pbal u) (pbnat u) ;

    pact-b (u : Pairs I x) (W : Ob) (g : Hom W J) (q : IsT (full W (G.act W J g y)))
      : Id (TB.EI W) (pb J y (pact u) W g q) (pb I x u W (compH W J I f g) (qTr W g q)) =
      mkPairs-b J y (A.tact J I f x y E (pa I x u)) (pbE u) (pbpt' u) (pbal u) (pbnat u) W g q ;

    -- to B, when y is full
    toBv (p : IsT (full J y)) (u : Pairs I x) : TB.T J (y, p) =
      KBE.fromE J (y, p) (pb I x u J f (full-eq J y (G.act J I f x) (symH E) p)) (res-eq J (G.act J I f x, full-eq J y (G.act J I f x) (symH E) p) (y, p) E) ;

    toBv-E (p : IsT (full J y)) (u : Pairs I x) (q : IsT (full J (G.act J I f x)))
      : Id (TB.EI J) ((y, p), toBv p u) (pb I x u J f q) =
      transH (KBE.fromE-eq J (y, p) (pb I x u J f (full-eq J y (G.act J I f x) (symH E) p))
                (res-eq J (G.act J I f x, full-eq J y (G.act J I f x) (symH E) p) (y, p) E))
             (apH (pb I x u J f) (isProp-IsT' (full J (G.act J I f x)) (full-eq J y (G.act J I f x) (symH E) p) q)) ;

    opaque pact-a ; opaque pact-b ; opaque toBv-E ;
  } ;

  ----------------------------------------------------------------------
  -- The type, by cases on full

  ExtV (X : Ob) (rho : W0.Ix (G.ob X)) : (c : Bool) -> Id Bool (full X rho) c -> W0.V = split {
    true -> \ e -> B.tob X (rho, e) ;
    false -> \ e -> pairsV X rho } ;

  tf-absurd (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (E : Id (W0.Ix (G.ob J)) (G.act J I f x) y)
    (e : IsT (full I x)) (e' : Id Bool (full J y) false) : Empty =
    false-true (transH (symH e') (full-eq J (G.act J I f x) y E (full-act J I f x e))) ;

  module TA2 (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (E : Id (W0.Ix (G.ob J)) (G.act J I f x) y) {
    TT1 (c : Bool) : U l = (e : Id Bool (full I x) c) (c' : Bool) (e' : Id Bool (full J y) c') -> W0.Ix (ExtV I x c e) -> W0.Ix (ExtV J y c' e') ;

    tactT (e : IsT (full I x)) : (c' : Bool) (e' : Id Bool (full J y) c') -> W0.Ix (ExtV I x true e) -> W0.Ix (ExtV J y c' e') = split {
      true -> \ e' u -> B.tact J I f (x, e) (y, e') (res-eq J (G'.act J I f (x, e)) (y, e') E) u ;
      false -> \ e' u -> absurd _ (tf-absurd J I f x y E e e') } ;

    tactF (e : Id Bool (full I x) false) : (c' : Bool) (e' : Id Bool (full J y) c') -> W0.Ix (ExtV I x false e) -> W0.Ix (ExtV J y c' e') = split {
      true -> \ e' u -> PAct[J, I, f, x, y, E].toBv e' u ;
      false -> \ e' u -> PAct[J, I, f, x, y, E].pact u } ;

    tactS : (c : Bool) -> TT1 c = split {
      true -> \ e -> tactT e ;
      false -> \ e -> tactF e } ;
  } ;

  extOb (X : Ob) (rho : W0.Ix (G.ob X)) : W0.V = ExtV X rho (full X rho) (refl (full X rho)) ;

  extAct : TactTy G extOb = \ J I f x y E u ->
    TA2[J, I, f, x, y, E].tactS (full I x) (refl (full I x)) (full J y) (refl (full J y)) u ;

  pact-id (I : Ob) (x : W0.Ix (G.ob I)) (E : Id (W0.Ix (G.ob I)) (G.act I I (idH I) x) x) (u : Pairs I x)
    : Id (Pairs I x) (PAct[I, I, idH I, x, x, E].pact u) u =
    pairs-eq I x (PAct[I, I, idH I, x, x, E].pact u) u
      (transH (PAct[I, I, idH I, x, x, E].pact-a u) (A.tact-id I x E (pa I x u)))
      (\ W f q -> transH (PAct[I, I, idH I, x, x, E].pact-b u W f q)
                    (pb-hom I x u W (compH W I I (idH I) f) f (comp-idl W I f) (PAct[I, I, idH I, x, x, E].qTr W f q) q)) ;

  module PO (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (z : W0.Ix (G.ob K))
    (E1 : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (E2 : Id (W0.Ix (G.ob K)) (G.act K J g y) z)
    (E3 : Id (W0.Ix (G.ob K)) (G.act K I (compH K J I f g) x) z) {
    module P3 = PAct[K, I, compH K J I f g, x, z, E3] ;
    module P1 = PAct[J, I, f, x, y, E1] ;
    module P2 = PAct[K, J, g, y, z, E2] ;

    pact-o (u : Pairs I x) : Id (Pairs K z) (P3.pact u) (P2.pact (P1.pact u)) =
      pairs-eq K z (P3.pact u) (P2.pact (P1.pact u))
        (transH (P3.pact-a u)
         (transH (A.tact-o K J I f g x y z E1 E2 E3 (pa I x u))
          (transH (apH (A.tact K J g y z E2) (symH (P1.pact-a u)))
                  (symH (P2.pact-a (P1.pact u))))))
        (\ W h q -> transH (P3.pact-b u W h q)
                     (transH (pb-hom I x u W (compH W K I (compH K J I f g) h) (compH W J I f (compH W K J g h))
                                  (comp-assoc W K J I f g h) (P3.qTr W h q) (P1.qTr W (compH W K J g h) (P2.qTr W h q)))
                             (symH (transH (P2.pact-b (P1.pact u) W h q)
                                           (P1.pact-b u W (compH W K J g h) (P2.qTr W h q)))))) ;

    toBv-o1 (e'' : Id Bool (full K z) true) (u : Pairs I x) : Id (TB.T K (z, e'')) (P3.toBv e'' u) (P2.toBv e'' (P1.pact u)) =
      TB.pr-inj K (z, e'') (P3.toBv e'' u) (P2.toBv e'' (P1.pact u))
        (transH (P3.toBv-E e'' u (full-eq K z (G.act K I (compH K J I f g) x) (symH E3) e''))
         (transH (apH (pb I x u K (compH K J I f g))
                      (isProp-IsT' (full K (G.act K I (compH K J I f g) x)) (full-eq K z (G.act K I (compH K J I f g) x) (symH E3) e'')
                                   (P1.qTr K g (full-eq K z (G.act K J g y) (symH E2) e''))))
          (symH (transH (P2.toBv-E e'' (P1.pact u) (full-eq K z (G.act K J g y) (symH E2) e''))
                        (P1.pact-b u K g (full-eq K z (G.act K J g y) (symH E2) e'')))))) ;

    toBv-o2 (e' : Id Bool (full J y) true) (e'' : Id Bool (full K z) true) (u : Pairs I x)
      : Id (TB.T K (z, e'')) (P3.toBv e'' u) (B.tact K J g (y, e') (z, e'') (res-eq K (G'.act K J g (y, e')) (z, e'') E2) (P1.toBv e' u)) =
      TB.pr-inj K (z, e'') (P3.toBv e'' u) (B.tact K J g (y, e') (z, e'') (res-eq K (G'.act K J g (y, e')) (z, e'') E2) (P1.toBv e' u))
        (transH (P3.toBv-E e'' u (full-eq K z (G.act K I (compH K J I f g) x) (symH E3) e''))
         (transH (symH (pnatF I x u K J g f (full-eq J y (G.act J I f x) (symH E1) e') (full-eq K z (G.act K I (compH K J I f g) x) (symH E3) e'')))
          (transH (apH (EB.act K J g) (symH (P1.toBv-E e' u (full-eq J y (G.act J I f x) (symH E1) e'))))
                  (TB.pr-tact K J g (y, e') (z, e'') (res-eq K (G'.act K J g (y, e')) (z, e'') E2) (P1.toBv e' u))))) ;

    -- the composition law, by cases on the three Bools
    ToTy (c : Bool) (e : Id Bool (full I x) c) (c' : Bool) (e' : Id Bool (full J y) c') (c'' : Bool) (e'' : Id Bool (full K z) c'') : U l =
      (u : W0.Ix (ExtV I x c e))
      -> Id (W0.Ix (ExtV K z c'' e'')) (TA2[K, I, compH K J I f g, x, z, E3].tactS c e c'' e'' u)
            (TA2[K, J, g, y, z, E2].tactS c' e' c'' e'' (TA2[J, I, f, x, y, E1].tactS c e c' e' u)) ;

    toTT (e : IsT (full I x)) (e' : IsT (full J y)) : (c'' : Bool) (e'' : Id Bool (full K z) c'') -> ToTy true e true e' c'' e'' = split {
      true -> \ e'' u -> B.tact-o K J I f g (x, e) (y, e') (z, e'')
                (res-eq J (G'.act J I f (x, e)) (y, e') E1) (res-eq K (G'.act K J g (y, e')) (z, e'') E2)
                (res-eq K (G'.act K I (compH K J I f g) (x, e)) (z, e'') E3) u ;
      false -> \ e'' u -> absurd _ (tf-absurd K J g y z E2 e' e'') } ;

    toT (e : IsT (full I x)) : (c' : Bool) (e' : Id Bool (full J y) c') (c'' : Bool) (e'' : Id Bool (full K z) c'') -> ToTy true e c' e' c'' e'' = split {
      true -> \ e' -> toTT e e' ;
      false -> \ e' c'' e'' u -> absurd _ (tf-absurd J I f x y E1 e e') } ;

    toFT (e : Id Bool (full I x) false) (e' : IsT (full J y)) : (c'' : Bool) (e'' : Id Bool (full K z) c'') -> ToTy false e true e' c'' e'' = split {
      true -> \ e'' u -> toBv-o2 e' e'' u ;
      false -> \ e'' u -> absurd _ (tf-absurd K J g y z E2 e' e'') } ;

    toFF (e : Id Bool (full I x) false) (e' : Id Bool (full J y) false) : (c'' : Bool) (e'' : Id Bool (full K z) c'') -> ToTy false e false e' c'' e'' = split {
      true -> \ e'' u -> toBv-o1 e'' u ;
      false -> \ e'' u -> pact-o u } ;

    toF (e : Id Bool (full I x) false) : (c' : Bool) (e' : Id Bool (full J y) c') (c'' : Bool) (e'' : Id Bool (full K z) c'') -> ToTy false e c' e' c'' e'' = split {
      true -> \ e' -> toFT e e' ;
      false -> \ e' -> toFF e e' } ;

    toA : (c : Bool) (e : Id Bool (full I x) c) (c' : Bool) (e' : Id Bool (full J y) c') (c'' : Bool) (e'' : Id Bool (full K z) c'') -> ToTy c e c' e' c'' e'' = split {
      true -> \ e -> toT e ;
      false -> \ e -> toF e } ;
  } ;

  tid' (I : Ob) (x : W0.Ix (G.ob I)) (E : Id (W0.Ix (G.ob I)) (G.act I I (idH I) x) x)
    : (c : Bool) (e : Id Bool (full I x) c) (u : W0.Ix (ExtV I x c e)) -> Id (W0.Ix (ExtV I x c e)) (TA2[I, I, idH I, x, x, E].tactS c e c e u) u = split {
    true -> \ e u -> B.tact-id I (x, e) (res-eq I (G'.act I I (idH I) (x, e)) (x, e) E) u ;
    false -> \ e u -> pact-id I x E u } ;

  opaque pact-id ; opaque tid' ;

  extId : IdLaw G extOb extAct = \ I x E u -> tid' I x E (full I x) (refl (full I x)) u ;

  extO : OLaw G extOb extAct = \ K J I f g x y z E1 E2 E3 u ->
    PO[K, J, I, f, g, x, y, z, E1, E2, E3].toA (full I x) (refl (full I x)) (full J y) (refl (full J y)) (full K z) (refl (full K z)) u ;

  opaque extId ; opaque extO ;

  ExtT : PTy[G] = (mkTy G extOb extAct extId extO) ;
} ;
