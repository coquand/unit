-- CHornRetr.seg (L3, inside CB, level lv): composition gives extension
-- along a RETRACTION LINE (Gabriel-Zisman; model.tex Theorem hornbox (1)).
-- Data at X: a partial element hs of A at rho (one sieve H: on Delta the
-- horn); a natural family r (W , f , i) : W -> X over the generalised
-- points (f , i) of X * I (the retraction, curried), with
--   R1  r (f , e') = f                       (r is a retraction at e')
--   R2  r (f , e) lands in H                 (the start lies in H)
--   R3  f in H  =>  r (f , i) in H           (r maps H * I into H)
-- The problem: the line rho r, the start hs at r (id , e), the side on H
-- whose line at f is hs read along r (f - , -).  Its composite at e' lies
-- over rho r (id , e') = rho and extends hs (kside at (f , e'), R1).
--
-- Quarry: seg/model GHornRetr, one sieve.

level lv ;
constraint a <= lv ;
open Base ;
open Prelude[lv+] ;
open Paths[lv+] ;
module W0 = V[lv] ;
module GPR = GPre[lv] ;
open GPR.PS ;

module RF (G : PCtx) (A : PTy[G]) (e e' : IPt)
  (ca : CLine[lv].Lines[G, A].CompK[e, e'].Comp)
  (X : Ob) (rho : W0.Ix (G.ob X))
  (hs : CPartial[lv].Partials[G, A].Side[X, rho])
  (r : (W : Ob) -> Hom W X -> Hom W Iv -> Hom W X)
  (rn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
        -> Id (Hom V X) (compH V W X (r W f i) g) (r V (compH V W X f g) (compH V W Iv i g)))
  (R1 : (W : Ob) (f : Hom W X) -> Id (Hom W X) (r W f (ptH W e')) f)
  (R2 : (W : Ob) (f : Hom W X) -> Lands W X hs.pQ (r W f (ptH W e)))
  (R3 : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Lands W X hs.pQ f -> Lands W X hs.pQ (r W f i)) {
  module CK = CLine[lv].Lines[G, A].CompK[e, e'] ;
  module KA = CLine[lv].EndKit[G, A, e] ;
  module KB = CLine[lv].EndKit[G, A, e'] ;
  module FA = CLine[lv].FT[G, A] ;
  module TA = GPR.TyL[G, A] ;
  module TT = GPR.TyL[KA.TV.E, CK.Tend] ;
  module GL = GPR.PshL[G] ;
  module HP = CPartial[lv].Partials[G, A] ;

  ----------------------------------------------------------------------
  -- the line rho r in G and the start hs (r (id , e))

  gt (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (G.ob W) = G.act W X (r W f i) rho ;

  gn (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (G.ob V)) (G.act V W g (gt W f i)) (gt V (compH V W X f g) (compH V W Iv i g)) =
    transH (GL.actC V W X (r W f i) g rho) (apH (\ k -> G.act V X k rho) (rn V W g f i)) ;

  gam : W0.Ix (CLine[lv].FC[G].ob X) = (gt, gn) ;

  r0 : Hom X X = r X (idH X) (ptH X e) ;

  sE : TA.EI X = hs.pv X r0 (R2 X (idH X)) ;

  x0 : KA.TV.EI X = (gam, TA.fromE X (G.act X X r0 rho) sE (hs.ppt X r0 (R2 X (idH X)))) ;

  x0-E : Id (TA.EI X) (KA.endE X x0) sE = TA.fromE-eq X (G.act X X r0 rho) sE (hs.ppt X r0 (R2 X (idH X))) ;

  opaque x0-E ;

  ----------------------------------------------------------------------
  -- the side: at f, the line hs (r (f - , -))

  iS (V : Ob) (f : Hom V X) (i : Lands V X hs.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
    : Lands W X hs.pQ (r W (compH W V X f g) j) =
    R3 W (compH W V X f g) j (lands-comp W V X hs.pQ f g i) ;

  t (V : Ob) (f : Hom V X) (i : Lands V X hs.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv) : TA.EI W =
    hs.pv W (r W (compH W V X f g) j) (iS V f i W g j) ;

  tp (V : Ob) (f : Hom V X) (i : Lands V X hs.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
    : Id (W0.Ix (G.ob W)) (t V f i W g j).1 ((CLine[lv].FC[G].actF V X f gam).1 W g j) =
    hs.ppt W (r W (compH W V X f g) j) (iS V f i W g j) ;

  tnHom (V : Ob) (f : Hom V X) (W' W : Ob) (g' : Hom W' W) (g : Hom W V) (j : Hom W Iv)
    : Id (Hom W' X) (compH W' W X (r W (compH W V X f g) j) g') (r W' (compH W' V X f (compH W' W V g g')) (compH W' W Iv j g')) =
    transH (rn W' W g' (compH W V X f g) j) (apH (\ k -> r W' k (compH W' W Iv j g')) (comp-assoc W' W V X f g g')) ;

  tn (V : Ob) (f : Hom V X) (i : Lands V X hs.pQ f) (W' W : Ob) (g' : Hom W' W) (g : Hom W V) (j : Hom W Iv)
    : Id (TA.EI W') (TA.E.act W' W g' (t V f i W g j)) (t V f i W' (compH W' W V g g') (compH W' W Iv j g')) =
    transH (hs.pnat W' W g' (r W (compH W V X f g) j) (iS V f i W g j)
              (lands-comp W' W X hs.pQ (r W (compH W V X f g) j) g' (iS V f i W g j)))
           (HP.pv-hom X rho hs W' (compH W' W X (r W (compH W V X f g) j) g') (r W' (compH W' V X f (compH W' W V g g')) (compH W' W Iv j g'))
              (tnHom V f W' W g' g j)
              (lands-comp W' W X hs.pQ (r W (compH W V X f g) j) g' (iS V f i W g j))
              (iS V f i W' (compH W' W V g g') (compH W' W Iv j g'))) ;

  t1Hom (V : Ob) (f : Hom V X) : Id (Hom V X) (r V (compH V V X f (idH V)) (ptH V e)) (compH V X X r0 f) =
    transH (apH (\ k -> r V k (ptH V e)) (transH (comp-idr V X f) (symH (comp-idl V X f))))
      (transH (apH (\ k -> r V (compH V X X (idH X) f) k) (symH (ptH-nat V X f e)))
              (symH (rn V X f (idH X) (ptH X e)))) ;

  t1 (V : Ob) (f : Hom V X) (i : Lands V X hs.pQ f)
    : Id (TA.EI V) (t V f i V (idH V) (ptH V e)) (KA.endE V (KA.TV.E.act V X f x0)) =
    transH (HP.pv-hom X rho hs V (r V (compH V V X f (idH V)) (ptH V e)) (compH V X X r0 f) (t1Hom V f)
              (iS V f i V (idH V) (ptH V e)) (lands-comp V X X hs.pQ r0 f (R2 X (idH X))))
      (symH (transH (KA.endE-act V X f x0)
              (transH (apH (TA.E.act V X f) x0-E)
                      (hs.pnat V X f r0 (R2 X (idH X)) (lands-comp V X X hs.pQ r0 f (R2 X (idH X))))))) ;

  tr (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X hs.pQ f) (i' : Lands V' X hs.pQ (compH V' V X f chi))
    (W : Ob) (g : Hom W V') (j : Hom W Iv)
    : Id (TA.EI W) (t V' (compH V' V X f chi) i' W g j) (t V f i W (compH W V' V chi g) j) =
    HP.pv-hom X rho hs W (r W (compH W V' X (compH V' V X f chi) g) j) (r W (compH W V X f (compH W V' V chi g)) j)
      (apH (\ k -> r W k j) (comp-assoc W V' V X f chi g))
      (iS V' (compH V' V X f chi) i' W g j) (iS V f i W (compH W V' V chi g) j) ;

  module LS = CLineSide[lv].LineSide[G, A, e, X, x0, hs.pQ, t, tp, tn, t1, tr] ;

  ----------------------------------------------------------------------
  -- the composite at e' is the extension

  c : W0.Ix (CK.Tend.tob X x0) = ca.kop X x0 LS.side ;

  -- an element of the composite's type, read in A
  rd (W : Ob) (u : TT.EI W) : TA.EI W = KB.endE W (CK.SE.mV W u) ;

  rd-act (V W : Ob) (g : Hom V W) (u : TT.EI W) : Id (TA.EI V) (rd V (TT.E.act V W g u)) (TA.E.act V W g (rd W u)) =
    transH (apH (KB.endE V) (symH (CK.SE.mV-nat V W g u))) (KB.endE-act V W g (CK.SE.mV W u)) ;

  rhoEq : Id (W0.Ix (G.ob X)) (rd X (x0, c)).1 rho = GL.actId X (r X (idH X) (ptH X e')) (R1 X (idH X)) rho ;

  fill : TA.T X rho = TA.fromE X rho (rd X (x0, c)) rhoEq ;

  fill-E : Id (TA.EI X) (rho, fill) (rd X (x0, c)) = TA.fromE-eq X rho (rd X (x0, c)) rhoEq ;

  fill-side (W : Ob) (f : Hom W X) (i : Lands W X hs.pQ f) : Id (TA.EI W) (TA.E.act W X f (rho, fill)) (hs.pv W f i) =
    calc (TA.EI W) {
        TA.E.act W X f (rho, fill)
      =< apH (TA.E.act W X f) fill-E >
        TA.E.act W X f (rd X (x0, c))
      =< symH (rd-act W X f (x0, c)) >
        rd W (TT.E.act W X f (x0, c))
      =< apH (rd W) (ca.kside X x0 LS.side W f i) >
        rd W (CK.endL.mE W (LS.sv W f i))
      =< FA.Ev[e'].endB-E W (KA.lineL W (LS.sv W f i)) >
        (KA.lineL W (LS.sv W f i)).2.1.1 W (idH W) (ptH W e')
      =< LS.sv-val W f i W (idH W) (ptH W e') >
        t W f i W (idH W) (ptH W e')
      =< HP.pv-hom X rho hs W (r W (compH W W X f (idH W)) (ptH W e')) f
           (transH (apH (\ k -> r W k (ptH W e')) (comp-idr W X f)) (R1 W f))
           (iS W f i W (idH W) (ptH W e')) i >
        hs.pv W f i } ;

  opaque fill ;
} ;
