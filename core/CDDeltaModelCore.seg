-- The CwF, its products, and the lower universe.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module UF = Universes.CDUniverseFib[a] ;
module N = CDName[a] ;
module B = N.B ;
module DB = N.DB ;
module V0 = V[a] ;
module W = V[a+] ;
module K = CDCodeContext[a] ;
module X = CDUniverseLift[a] ;
module C = K.C ;
module O = K.Ops ;
module U0 = N.B.DC.DU ;
module U1 = N.U1 ;
module P = N.P ;
open P.PS ;
open SmallCat[a].Homs[DB.obV, DB.homV] ;
module F = CDStructPi[a, a+] ;
module Uv = CDCodeUniverse[a].Univ[Universes.M.Classical.CDeltaFinal[a].fibU nilP] ;
module Product = CDCodePi[a].Products[UF.fib1] ;

cwf : CwF.CwF[a++] = K.cwf ;
isSetCtx : isSet cwf.Ctx = K.isSetCtx ;
products : CwF.Formers[a++, cwf].PiStr = Product.CDCodePiTermNat.products ;

import CDCodeSmall ;
import CDNameSmall ;
import CDCodePic ;
