-- CUaOp.seg (L6, inside CB): the univalence operation (model.tex
-- Thm ua): kop = step (b) of step (a) at the top sieve; kunif from the
-- uniformity of both steps (CUaN, CUaBN) and the top sieve restricting to
-- the top sieve; kside by uniformity and the sides of both steps at a
-- side containing the identity (CUaSA, CUaSB).  The classifier enters
-- through smallCl, (C1) and (C2).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UaOp (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  -- the classifier of the small copy along maps into GD, and (C1)
  (smallCl : (D : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l))
  (smallCl-sub : (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D])
     -> Id ((A : PTy[D']) * Cl D' A)
           (subTy D' D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) t,
            clSub D' D t (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) (smallCl D l))
           (CSmall.xsub D' CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t),
            smallCl D' (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t)))
  -- (C2): at a full point, the code of SA along the Yoneda map is B's
  (smallCl-full : (W : Ob) (y : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 W) (q : IsT (CGlueD.fl W y.1.2.1 W (idH W)))
     -> Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W)
           (CSmall.xsub (yP W) CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y),
            smallCl (yP W) (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y))
           (y.1.2.2.1 W (idH W) q)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module PU = CPartial[a+].Partials[UU.UCtx, UA.UaTy] ;
  module TU = LP.TyL[UU.UCtx, UA.UaTy] ;

  fullTop (X : Ob) : IsT (allS X (topS X)) = allS-complete X (topS X) (top-lands X X (idH X)) ;

  -- the full datum built from a glue datum over a full sieve
  datF (X : Ob) (t : (d : GE.GD1 X) * (ph : Phi X) * IsT (allS X ph)) : GE.GD1 X =
    CUaB.UaB[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, X, t.1, t.2.1, t.2.2].GC.dat ;

  kop (X : Ob) (F : UU.U0 X) (u : PU.Side[X, F]) : UA.UaT0 X F =
    CUaB.UaB[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, X, CUaD.UaD[Cl, clSub, clSub-id, clSub-o, encCl, X, F, u].d, topS X, fullTop X].out ;

  pre-top (J X : Ob) (h : Hom J X) : Id (Phi J) (pre J X h (topS X)) (topS J) =
    phi-ext J (pre J X h (topS X)) (topS J) (\ W f i -> top-lands W J f)
      (\ W f i -> pre-lands W J X h (topS X) f (top-lands W X (compH W J X h f))) ;

  module KU (Y X : Ob) (h : Hom Y X) (F : UU.U0 X) (u : PU.Side[X, F]) {
    module D = CUaD.UaD[Cl, clSub, clSub-id, clSub-o, encCl, X, F, u] ;
    module BN = CUaBN.UaBN[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, X, D.d, topS X, fullTop X, Y, h] ;
    module DN = CUaN.UaN[Cl, clSub, clSub-id, clSub-o, encCl, X, F, u, Y, h] ;

    Ptrip : Id ((d : GE.GD1 Y) * (ph : Phi Y) * IsT (allS Y ph))
               (GE.act1 Y X h D.d, (pre Y X h (topS X), UA.fullAct Y X h (topS X) (fullTop X)))
               (DN.D'.d, (topS Y, fullTop Y)) =
      transH (apH {GE.GD1 Y} {(d : GE.GD1 Y) * (ph : Phi Y) * IsT (allS Y ph)}
                (\ d2 -> (d2, (pre Y X h (topS X), UA.fullAct Y X h (topS X) (fullTop X)))) DN.law)
             (apH {(ph : Phi Y) * IsT (allS Y ph)} {(d : GE.GD1 Y) * (ph : Phi Y) * IsT (allS Y ph)} (\ z -> (DN.D'.d, z))
                (Sigma-eq (Phi Y) (\ p -> IsT (allS Y p)) (pre Y X h (topS X)) (topS Y) (UA.fullAct Y X h (topS X) (fullTop X)) (fullTop Y)
                   (pre-top Y X h) (isProp-IsT' (allS Y (topS Y))))) ;

    res : Id (TU.EI Y) (TU.E.act Y X h (F, kop X F u)) (UU.uAct Y X h F, kop Y (UU.uAct Y X h F) (PU.rside Y X h F u)) =
      apH {UA.UaT0 Y (UU.uAct Y X h F)} {TU.EI Y} (\ z -> (UU.uAct Y X h F, z))
        (UA.uaExt Y (UU.uAct Y X h F) (UA.uaTact Y X h F (UU.uAct Y X h F) (refl (UU.uAct Y X h F)) (kop X F u))
           (kop Y (UU.uAct Y X h F) (PU.rside Y X h F u))
           (transH BN.N.law (apH (datF Y) Ptrip))) ;
  } ;

  kunif (Y X : Ob) (h : Hom Y X) (F : UU.U0 X) (u : PU.Side[X, F])
    : Id (TU.EI Y) (TU.E.act Y X h (F, kop X F u)) (UU.uAct Y X h F, kop Y (UU.uAct Y X h F) (PU.rside Y X h F u)) =
    KU[Y, X, h, F, u].res ;

  opaque kunif ;

  ----------------------------------------------------------------------
  -- the sides

  uaPair (W : Ob) (F1 F2 : UU.U0 W) (p : Id (UU.U0 W) F1 F2) (y1 : UA.UaT0 W F1) (y2 : UA.UaT0 W F2) (P : Id (GE.GD1 W) y1.1 y2.1)
    : Id (TU.EI W) (F1, y1) (F2, y2) =
    idJ (UU.U0 W) F1 (\ F3 p3 -> (y3 : UA.UaT0 W F3) -> Id (GE.GD1 W) y1.1 y3.1 -> Id (TU.EI W) (F1, y1) (F3, y3))
      (\ y3 P3 -> apH {UA.UaT0 W F1} {TU.EI W} (\ z -> (F1, z)) (UA.uaExt W F1 y1 y3 P3)) F2 p y2 P ;

  -- at a side containing the identity, the value is the side's
  module S (W : Ob) (F : UU.U0 W) (u : PU.Side[W, F]) (i0 : Lands W W u.pQ (idH W)) {
    module SA = CUaSA.UaSA[Cl, clSub, clSub-id, clSub-o, encCl, W, F, u, i0] ;
    x0 : TU.EI W = SA.x0 ;
    module SB = CUaSB.UaSB[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, smallCl-full, W, SA.xd, x0.2.2.2] ;

    Ptrip : Id ((d : GE.GD1 W) * (ph : Phi W) * IsT (allS W ph)) (SA.D.d, (topS W, fullTop W)) (SA.xd, (SA.xd.1.2.1, x0.2.2.2)) =
      transH (apH {GE.GD1 W} {(d : GE.GD1 W) * (ph : Phi W) * IsT (allS W ph)} (\ d2 -> (d2, (topS W, fullTop W))) (symH SA.law))
             (apH {(ph : Phi W) * IsT (allS W ph)} {(d : GE.GD1 W) * (ph : Phi W) * IsT (allS W ph)} (\ z -> (SA.xd, z))
                (Sigma-eq (Phi W) (\ p -> IsT (allS W p)) (topS W) SA.xd.1.2.1 (fullTop W) x0.2.2.2
                   (phi-ext W (topS W) SA.xd.1.2.1
                      (\ V f i -> SA.full-lands SA.xd.1.2.1 (allS-sound W SA.xd.1.2.1 x0.2.2.2) V f)
                      (\ V f i -> top-lands V W f))
                   (isProp-IsT' (allS W SA.xd.1.2.1)))) ;

    res : Id (TU.EI W) (F, kop W F u) x0 =
      uaPair W F x0.1 (symH (transH (u.ppt W (idH W) i0) (UU.uAct-id W F))) (kop W F u) x0.2
        (transH (apH (datF W) Ptrip) (symH SB.law)) ;
  } ;

  kside (X : Ob) (F : UU.U0 X) (u : PU.Side[X, F]) (W : Ob) (f : Hom W X) (i : Lands W X u.pQ f)
    : Id (TU.EI W) (TU.E.act W X f (F, kop X F u)) (u.pv W f i) =
    transH (kunif W X f F u)
     (transH (S[W, UU.uAct W X f F, PU.rside W X f F u,
                pre-lands W W X f u.pQ (idH W) (lands-eq W X u.pQ f (compH W W X f (idH W)) (symH (comp-idr W X f)) i)].res)
             (PU.pv-hom X F u W (compH W W X f (idH W)) f (comp-idr W X f)
                (lands-pre W W X f u.pQ (idH W) (pre-lands W W X f u.pQ (idH W) (lands-eq W X u.pQ f (compH W W X f (idH W)) (symH (comp-idr W X f)) i)))
                i)) ;

  opaque kside ;

  -- univalence: a contractibility structure on Ua (model.tex Thm ua)
  ua : CPartial[a+].ContrOp UU.UCtx UA.UaTy = new CPartial[a+].Rel[UU.UCtx, UA.UaTy, UA.UaTy, CPartial[a+].pmap-id UU.UCtx UA.UaTy].RC[kop, kside, kunif] ;
} ;
