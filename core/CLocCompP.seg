-- CLocCompP.seg (L9): the problem of DA read along f, as a problem of
-- filling of i*A on Delta (localisation.tex, Theorem DA).
--
-- Data as in CLocCompV.Pb: a point w of DA over a line of G at X (at the end
-- e), a side sd of the strict fibres of DA, and f : [n] -> X.
--
--   x0      the point: the line of G read along f, and w read at f
--   qD      the sieve of sd pulled back along f, as a sieve of Delta
--   pv      at g in qD: the element of the fibres of i*A whose line has the
--           Eilenberg-Zilber values of CLocCompV at the points of the prism
--   side    the side; prob = (x0 , side)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module DB = CDeltaBase[a].DB ;
module DS = CDeltaBase[a].DS ;
module SP = CPosBase[a].SP ;
module CV = CLocCompV[a, l] ;

-- a sieve of a poset pulled back along f : [n] -> X, as a sieve of Delta
qD (X : Ob) (n : Nat) (f : Hom (lin n) X) (Q : SP.Phi X) : DS.Phi n =
  (\ V g -> Q.1 (lin V) (compH (lin V) (lin n) X f g),
   \ V' V g g' i -> substH {Hom (lin V') X} (\ k -> IsT (Q.1 (lin V') k))
       {compH (lin V') (lin V) X (compH (lin V) (lin n) X f g) g'} {compH (lin V') (lin n) X f (compH (lin V') (lin V) (lin n) g g')}
       (comp-assoc (lin V') (lin V) (lin n) X f g g') (SP.lands-comp (lin V') (lin V) X Q (compH (lin V) (lin n) X f g) g' i)) ;

module PF (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (e : El Iv) (X : Ob)
  (w : CV.VA[G, A, e].KD.TV.EI X) (sd : CV.VA[G, A, e].KD.PT.Side[X, w]) (n : Nat) (f : Hom (lin n) X) {
  module VP = CV.Pb[G, A, e, X, w, sd, n, f] ;
  module DTm = VP.DTm ;
  module TA = VP.TA ;
  module KD = VP.KD ;
  module RG = CLocRestr[a, l].R[G] ;
  module RA = RG.T[A] ;
  module SAD = CDStageA[a, l].SA[RG.iG, RA.iA, e] ;
  module KAD = SAD.KA ;
  module FTD = SAD.FT ;

  E0 : VP.TD.EI X = KD.endE X w ;

  -- the point
  x0 : KAD.TV.EI n =
    (RG.rdG X n f w.1,
     TA.fromE (lin n) (w.1.1 (lin n) (compH (lin n) (lin n) X f (idH (lin n))) (constH (lin n) Iv e))
       (DTm.rd X E0.1 E0.2.1 n f) (symH (RG.FP.evN e (lin n) X f w.1))) ;

  x0-end : Id (TA.EI (lin n)) (KAD.endE n x0) (DTm.rd X E0.1 E0.2.1 n f) =
    TA.fromE-eq (lin n) (w.1.1 (lin n) (compH (lin n) (lin n) X f (idH (lin n))) (constH (lin n) Iv e))
       (DTm.rd X E0.1 E0.2.1 n f) (symH (RG.FP.evN e (lin n) X f w.1)) ;

  Q : DS.Phi n = qD X n f sd.pQ ;

  lhom (V : Nat) (k k' : Hom (lin V) X) (p : Id (Hom (lin V) X) k k') (i : SP.Lands (lin V) X sd.pQ k) : SP.Lands (lin V) X sd.pQ k' =
    substH {Hom (lin V) X} (\ z -> SP.Lands (lin V) X sd.pQ z) {k} {k'} p i ;

  -- the landing of the composite point
  lc (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n Q g) (V : Nat) (g' : Hom (lin V) (lin W))
    : SP.Lands (lin V) X sd.pQ (compH (lin V) (lin n) X f (compH (lin V) (lin W) (lin n) g g')) =
    (Q.2 V W g g' i) ;

  -- the line values at g
  module At (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n Q g) {
    xg : W0.Ix (FTD.FG.ob W) = (KAD.TV.E.act W n g x0).1 ;

    t (V : Nat) (g' : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) : TA.EI (lin V) =
      VP.Pt[V, compH (lin V) (lin W) (lin n) g g', j, lc W g i V g'].val ;

    tp (V : Nat) (g' : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) : Id (W0.Ix (G.ob (lin V))) (t V g' j).1 (xg.1 V g' j) =
      VP.Pt[V, compH (lin V) (lin W) (lin n) g g', j, lc W g i V g'].val-pt ;

    tn (V' V : Nat) (g'' : Hom (lin V') (lin V)) (g' : Hom (lin V) (lin W)) (j : Hom (lin V) Iv)
      : Id (TA.EI (lin V')) (TA.E.act (lin V') (lin V) g'' (t V g' j)) (t V' (compH (lin V') (lin V) (lin W) g' g'') (compH (lin V') (lin V) Iv j g'')) =
      transH (VP.NatV[V, V', compH (lin V) (lin W) (lin n) g g', j, lc W g i V g', g'',
                lhom V' _ _ (symH (apH (compH (lin V') (lin n) X f) (comp-assoc (lin V') (lin V) (lin W) (lin n) g g' g'')))
                  (lc W g i V' (compH (lin V') (lin V) (lin W) g' g''))].res)
        (VP.val-hom V' _ _ (comp-assoc (lin V') (lin V) (lin W) (lin n) g g' g'') (compH (lin V') (lin V) Iv j g'') _ _) ;

    L : KAD.TL.EI W = (xg, FTD.lamA W xg t tp tn) ;

    q : Id (TA.EI (lin W)) (KAD.endE W (FTD.Ev[e].evA.mE W L)) (KAD.endE W (KAD.TV.E.act W n g x0)) =
      calc (TA.EI (lin W)) {
          KAD.endE W (FTD.Ev[e].evA.mE W L)
        =< SAD.endL-lev W L >
          t W (idH (lin W)) (constH (lin W) Iv e)
        =< VP.EndC[W, compH (lin W) (lin W) (lin n) g (idH (lin W)), lc W g i W (idH (lin W))].res >
          TA.E.act (lin W) (lin n) (compH (lin W) (lin W) (lin n) g (idH (lin W))) (DTm.rd X E0.1 E0.2.1 n f)
        =< TA.PE.actEq (lin W) (lin n) _ g (comp-idr (lin W) (lin n) g) (DTm.rd X E0.1 E0.2.1 n f) >
          TA.E.act (lin W) (lin n) g (DTm.rd X E0.1 E0.2.1 n f)
        =< symH (apH (TA.E.act (lin W) (lin n) g) x0-end) >
          TA.E.act (lin W) (lin n) g (KAD.endE n x0)
        =< symH (KAD.endE-act W n g x0) >
          KAD.endE W (KAD.TV.E.act W n g x0) } ;

    u : KAD.TS.EI W = KAD.mkTS W (KAD.TV.E.act W n g x0) L (refl xg) q ;
    opaque tp ; opaque tn ; opaque q ;
  } ;

  pv (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n Q g) : KAD.TS.EI W = At[W, g, i].u ;

  ppt (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n Q g) : Id (KAD.TV.EI W) (pv W g i).1 (KAD.TV.E.act W n g x0) =
    KAD.mkTS-pt W (KAD.TV.E.act W n g x0) At[W, g, i].L (refl At[W, g, i].xg) At[W, g, i].q ;

  pnat (W' W : Nat) (chi : Hom (lin W') (lin W)) (g : Hom (lin W) (lin n)) (i : DS.Lands W n Q g)
    (i' : DS.Lands W' n Q (compH (lin W') (lin W) (lin n) g chi))
    : Id (KAD.TS.EI W') (KAD.TS.E.act W' W chi (pv W g i)) (pv W' (compH (lin W') (lin W) (lin n) g chi) i') =
    KAD.mkTS-act W' W chi (KAD.TV.E.act W n g x0) At[W, g, i].L (refl At[W, g, i].xg) At[W, g, i].q
      (KAD.TV.E.act W' n (compH (lin W') (lin W) (lin n) g chi) x0) At[W', compH (lin W') (lin W) (lin n) g chi, i'].L
      (refl At[W', compH (lin W') (lin W) (lin n) g chi, i'].xg) At[W', compH (lin W') (lin W) (lin n) g chi, i'].q
      (symH (KAD.TV.E.act-o W' W n g chi x0))
      (\ V'' g'' j -> VP.val-hom V'' _ _ (symH (comp-assoc (lin V'') (lin W') (lin W) (lin n) g chi g'')) j _ _) ;

  side : KAD.PT.Side[n, x0] = new KAD.PT.Side[n, x0, Q, pv, ppt, pnat] ;

  prob : SAD.Prob n = (x0, side) ;
  opaque x0-end ; opaque ppt ; opaque pnat ;
} ;

------------------------------------------------------------------------
-- along a strict h : [m] -> [n], the problem at f restricted is the
-- problem at f h

module RS (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (e : El Iv) (X : Ob)
  (w : CV.VA[G, A, e].KD.TV.EI X) (sd : CV.VA[G, A, e].KD.PT.Side[X, w])
  (m n : Nat) (f : Hom (lin n) X) (h : Hom (lin m) (lin n)) (hs : Strict (lin m) (lin n) h) {
  module F1 = PF[G, A, e, X, w, sd, n, f] ;
  module F2 = PF[G, A, e, X, w, sd, m, compH (lin m) (lin n) X f h] ;
  module SAD = F1.SAD ;
  module KAD = F1.KAD ;
  module TA = F1.TA ;

  x-eq : Id (KAD.TV.EI m) (KAD.TV.E.act m n h F1.x0) F2.x0 =
    KAD.tv-eq m (KAD.TV.E.act m n h F1.x0) F2.x0 (F1.RG.rdG-act X m n h f w.1)
      (calc (TA.EI (lin m)) {
          KAD.endE m (KAD.TV.E.act m n h F1.x0)
        =< KAD.endE-act m n h F1.x0 >
          TA.E.act (lin m) (lin n) h (KAD.endE n F1.x0)
        =< apH (TA.E.act (lin m) (lin n) h) F1.x0-end >
          TA.E.act (lin m) (lin n) h (F1.DTm.rd X F1.E0.1 F1.E0.2.1 n f)
        =< F1.E0.2.2 m n h hs f >
          F1.DTm.rd X F1.E0.1 F1.E0.2.1 m (compH (lin m) (lin n) X f h)
        =< symH F2.x0-end >
          KAD.endE m F2.x0 }) ;

  q-eq : Id (DS.Phi m) (DS.pre m n h F1.Q) F2.Q =
    DS.phi-ext m (DS.pre m n h F1.Q) F2.Q
      (\ W g i -> F1.lhom W (compH (lin W) (lin n) X f (compH (lin W) (lin m) (lin n) h g)) (compH (lin W) (lin m) X (compH (lin m) (lin n) X f h) g)
                    (symH (comp-assoc (lin W) (lin m) (lin n) X f h g)) i)
      (\ W g i -> F1.lhom W (compH (lin W) (lin m) X (compH (lin m) (lin n) X f h) g) (compH (lin W) (lin n) X f (compH (lin W) (lin m) (lin n) h g))
                    (comp-assoc (lin W) (lin m) (lin n) X f h g) i) ;

  pv-eq (W : Nat) (g : Hom (lin W) (lin m)) (i : DS.Lands W m (DS.pre m n h F1.Q) g) (i' : DS.Lands W m F2.Q g)
    : Id (KAD.TS.EI W) (F1.pv W (compH (lin W) (lin m) (lin n) h g) i) (F2.pv W g i') =
    KAD.mkTS-eq W (KAD.TV.E.act W n (compH (lin W) (lin m) (lin n) h g) F1.x0) (KAD.TV.E.act W m g F2.x0)
      F1.At[W, compH (lin W) (lin m) (lin n) h g, i].L F2.At[W, g, i'].L
      (refl F1.At[W, compH (lin W) (lin m) (lin n) h g, i].xg) F1.At[W, compH (lin W) (lin m) (lin n) h g, i].q
      (refl F2.At[W, g, i'].xg) F2.At[W, g, i'].q
      (transH (KAD.TV.E.act-o W m n h g F1.x0) (apH (KAD.TV.E.act W m g) x-eq))
      (\ V g' j -> transH {F1.TA.EI (lin V)} {F1.VP.Pt[V, compH (lin V) (lin W) (lin n) (compH (lin W) (lin m) (lin n) h g) g', j,
                                                   F1.lc W (compH (lin W) (lin m) (lin n) h g) i V g'].val}
                     {F1.VP.Pt[V, compH (lin V) (lin m) (lin n) h (compH (lin V) (lin W) (lin m) g g'), j, l1 V g' i].val}
          (F1.VP.val-hom V _ _ (comp-assoc (lin V) (lin W) (lin m) (lin n) h g g') j _ (l1 V g' i))
          (CV.SV[G, A, e, X, w, sd, m, n, f, h, hs, V, compH (lin V) (lin W) (lin m) g g', j, l1 V g' i,
                 F2.lc W g i' V g'].res))
   where { l1 (V : Nat) (g' : Hom (lin V) (lin W)) (i : DS.Lands W m (DS.pre m n h F1.Q) g)
             : SP.Lands (lin V) X sd.pQ (compH (lin V) (lin n) X f (compH (lin V) (lin m) (lin n) h (compH (lin V) (lin W) (lin m) g g'))) =
             F1.lhom V (compH (lin V) (lin n) X f (compH (lin V) (lin W) (lin n) (compH (lin W) (lin m) (lin n) h g) g'))
               (compH (lin V) (lin n) X f (compH (lin V) (lin m) (lin n) h (compH (lin V) (lin W) (lin m) g g')))
               (apH (compH (lin V) (lin n) X f) (comp-assoc (lin V) (lin W) (lin m) (lin n) h g g'))
               (F1.lc W (compH (lin W) (lin m) (lin n) h g) i V g') ; } ;

  res : Id (SAD.Prob m) (SAD.resP m n h F1.prob) F2.prob =
    Sigma-path (KAD.TV.EI m) (\ z -> KAD.PT.Side[m, z])
      (KAD.TV.E.act m n h F1.x0) F2.x0 (KAD.PT.rside m n h F1.x0 F1.side) F2.side x-eq
      (KAD.PT.side-extH m (KAD.TV.E.act m n h F1.x0) F2.x0 x-eq (KAD.PT.rside m n h F1.x0 F1.side) F2.side q-eq pv-eq) ;
  opaque x-eq ; opaque q-eq ; opaque pv-eq ; opaque res ;
} ;

------------------------------------------------------------------------
-- the problem of the restricted data along h : Y -> X, at f', is the
-- problem at h f'

module PRe (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (e : El Iv) (Y X : Ob) (h : Hom Y X)
  (w : CV.VA[G, A, e].KD.TV.EI X) (sd : CV.VA[G, A, e].KD.PT.Side[X, w]) (n : Nat) (f' : Hom (lin n) Y) {
  module VV = CV.VA[G, A, e] ;
  module F1 = PF[G, A, e, X, w, sd, n, compH (lin n) Y X h f'] ;
  module F2 = PF[G, A, e, Y, VV.KD.TV.E.act Y X h w, VV.KD.PT.rside Y X h w sd, n, f'] ;
  module SAD = F1.SAD ;
  module KAD = F1.KAD ;
  module TA = F1.TA ;

  x-eq : Id (KAD.TV.EI n) F1.x0 F2.x0 =
    KAD.tv-eq n F1.x0 F2.x0
      (F1.RG.FD.fam-eq n F1.x0.1 F2.x0.1 (\ W g j -> apH (\ k -> w.1.1 (lin W) k j) (comp-assoc (lin W) (lin n) Y X h f' g)))
      (calc (TA.EI (lin n)) {
          KAD.endE n F1.x0
        =< F1.x0-end >
          F1.DTm.rd X F1.E0.1 F1.E0.2.1 n (compH (lin n) Y X h f')
        =< symH (F1.DTm.rd-dtact Y X h F1.E0.1 (G.act Y X h F1.E0.1) (refl (G.act Y X h F1.E0.1)) F1.E0.2 n f') >
          F1.DTm.rd Y (VV.TD.E.act Y X h F1.E0).1 (VV.TD.E.act Y X h F1.E0).2.1 n f'
        =< symH (apH (\ z -> F1.DTm.rd Y z.1 z.2.1 n f') (VV.KD.endE-act Y X h w)) >
          F2.DTm.rd Y F2.E0.1 F2.E0.2.1 n f'
        =< symH F2.x0-end >
          KAD.endE n F2.x0 }) ;

  q-eq : Id (DS.Phi n) F1.Q F2.Q =
    DS.phi-ext n F1.Q F2.Q
      (\ W g i -> F1.lhom W (compH (lin W) (lin n) X (compH (lin n) Y X h f') g) (compH (lin W) Y X h (compH (lin W) (lin n) Y f' g))
                    (comp-assoc (lin W) (lin n) Y X h f' g) i)
      (\ W g i -> F1.lhom W (compH (lin W) Y X h (compH (lin W) (lin n) Y f' g)) (compH (lin W) (lin n) X (compH (lin n) Y X h f') g)
                    (symH (comp-assoc (lin W) (lin n) Y X h f' g)) i) ;

  pv-eq (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n F1.Q g) (i' : DS.Lands W n F2.Q g)
    : Id (KAD.TS.EI W) (F1.pv W g i) (F2.pv W g i') =
    KAD.mkTS-eq W (KAD.TV.E.act W n g F1.x0) (KAD.TV.E.act W n g F2.x0) F1.At[W, g, i].L F2.At[W, g, i'].L
      (refl F1.At[W, g, i].xg) F1.At[W, g, i].q (refl F2.At[W, g, i'].xg) F2.At[W, g, i'].q
      (apH (KAD.TV.E.act W n g) x-eq)
      (\ V g' j -> apH {VV.KD.TS.EI (lin V)} {TA.EI (lin V)} (\ u -> VV.rdS V F1.VP.Pt[V, compH (lin V) (lin W) (lin n) g g', j, F1.lc W g i V g'].Z.r
                                 ((VV.KD.lineL (lin V) u).2.1.1 (lin V) (idH (lin V)) j)
                                 F1.VP.Pt[V, compH (lin V) (lin W) (lin n) g g', j, F1.lc W g i V g'].Z.sgm
                                 F1.VP.Pt[V, compH (lin V) (lin W) (lin n) g g', j, F1.lc W g i V g'].Z.sec)
          (VV.KD.PT.pv-hom X w sd (lin V) (compH (lin V) (lin n) X (compH (lin n) Y X h f') (compH (lin V) (lin W) (lin n) g g'))
             (compH (lin V) Y X h (compH (lin V) (lin n) Y f' (compH (lin V) (lin W) (lin n) g g')))
             (comp-assoc (lin V) (lin n) Y X h f' (compH (lin V) (lin W) (lin n) g g'))
             (F1.lc W g i V g') (F2.lc W g i' V g'))) ;

  res : Id (SAD.Prob n) F1.prob F2.prob =
    Sigma-path (KAD.TV.EI n) (\ z -> KAD.PT.Side[n, z]) F1.x0 F2.x0 F1.side F2.side x-eq
      (KAD.PT.side-extH n F1.x0 F2.x0 x-eq F1.side F2.side q-eq pv-eq) ;
  opaque x-eq ; opaque q-eq ; opaque pv-eq ; opaque res ;
} ;
