-- CLocEq.seg (L9): Corollary (localisation.tex §5).
--
--   (i)  with no fibrancy: mu . D eta = id strictly (CLocD.Laws.mu-Deta),
--        and id ~ D eta . mu over DDA: Lemma eta-path (CLocEtaH) under D
--        (Lemma D-htpy, CLocHtpy), whiskered by mu_DA, retargeted along
--        mu_DA . D eta_DA = id and mu_DA . DD eta_A = D eta_A . mu_A
--   (ii) for fibrant A: D eta_A and eta_DA are homotopy equivalences
--        (CHtpyOps.HEq), with inverse mu; DDA is fibrant by Theorem DA twice
--        (CLocComp.OfFib), so homotopies into DDA invert and compose

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LD = CLocD[a, l] ;
module CH = CLocHtpy[a, l] ;
module HO = PB.CHtpyOps[l] ;

module Eq (G : PCtx) (A : PTy[G]) {
  module D1 = LD.DT[G, A] ;
  module D2 = LD.DT[G, D1.DA] ;
  module LA = LD.Laws[G, A] ;
  module LDA = LD.Laws[G, D1.DA] ;
  DA : PTy[G] = D1.DA ;
  DDA : PTy[G] = D2.DA ;
  DDDA : PTy[G] = LD.DT[G, DDA].DA ;

  eta : LD.NatMap[G, A, DA] = D1.etaN ;
  etaD : LD.NatMap[G, DA, DDA] = D2.etaN ;
  mu : LD.NatMap[G, DDA, DA] = LD.Mu[G, A].muN ;
  mu2 : LD.NatMap[G, DDDA, DDA] = LD.Mu[G, DA].muN ;
  Deta : LD.NatMap[G, DA, DDA] = LD.DMap[G, A, DA, eta].DN ;
  DetaD : LD.NatMap[G, DDA, DDDA] = LD.DMap[G, DA, DDA, etaD].DN ;
  DDeta : LD.NatMap[G, DDA, DDDA] = LD.DMap[G, DA, DDA, Deta].DN ;

  -- (i) mu . D eta = id, strictly
  muDeta (I : Ob) (x : W.Ix (G.ob I)) (u : D1.DEl I x) : Id (D1.DEl I x) (mu.nfun I x (Deta.nfun I x u)) u = LA.mu-Deta I x u ;

  -- (i) id ~ D eta . mu over DDA
  E0 : PEl[extP G DA, CH.HT[G, DA, DDA, etaD, Deta].PT.PathP] = CLocEtaH[a, l].EH[G, A].res ;
  E1 : PEl[extP G DDA, CH.HT[G, DDA, DDDA, DetaD, DDeta].PT.PathP] = CH.DH[G, DA, DDA, etaD, Deta, E0].res ;
  module WL2 = HO.WL[G, DDA, DDDA, DDA, CH.toN G DDA DDDA DetaD, CH.toN G DDA DDDA DDeta, CH.toN G DDDA DDA mu2, E1] ;

  idDM : PEl[extP G DDA, HO.HT[G, DDA, DDA, HO.idN G DDA, HO.compN G DDA DA DDA (CH.toN G DDA DA mu) (CH.toN G DA DDA Deta)].PT.PathP] =
    HO.Ret[G, DDA, DDA, WL2.T'.al, WL2.T'.be, HO.idN G DDA, HO.compN G DDA DA DDA (CH.toN G DDA DA mu) (CH.toN G DA DDA Deta),
      \ I x v -> symH (LDA.mu-Deta I x v), \ I x v -> LA.DMu[DA, eta].D-mu I x v, WL2.res].res ;

  opaque idDM ;

  ----------------------------------------------------------------------
  -- (ii) for fibrant A

  module Fib (c : PB.CLine[l].Lines[G, A].Fib) {
    fDA : PB.CLine[l].Lines[G, DA].Fib = CLocComp[a, l].OfFib[G, A, c].fib ;
    fDDA : PB.CLine[l].Lines[G, DDA].Fib = CLocComp[a, l].OfFib[G, DA, fDA].fib ;

    nMu : HO.NMap[G, DDA, DA] = CH.toN G DDA DA mu ;
    nDeta : HO.NMap[G, DA, DDA] = CH.toN G DA DDA Deta ;
    nEtaD : HO.NMap[G, DA, DDA] = CH.toN G DA DDA etaD ;

    -- D eta . mu ~ id
    DMid : PEl[extP G DDA, HO.HT[G, DDA, DDA, HO.compN G DDA DA DDA nMu nDeta, HO.idN G DDA].PT.PathP] =
      HO.Inv[G, DDA, DDA, HO.idN G DDA, HO.compN G DDA DA DDA nMu nDeta, fDDA.1, idDM].res ;

    -- D eta_A is a homotopy equivalence, with inverse mu
    hDeta : HO.HEq[G, DA, DDA, nDeta] =
      new HO.HEq[G, DA, DDA, nDeta, nMu,
        HO.strictH G DA DA (HO.compN G DA DDA DA nDeta nMu) (HO.idN G DA) (\ I x u -> symH (LA.mu-Deta I x u)),
        DMid] ;

    -- eta_DA . mu ~ D eta . mu ~ id
    EM : PEl[extP G DDA, HO.HT[G, DDA, DDA, HO.compN G DDA DA DDA nMu nEtaD, HO.compN G DDA DA DDA nMu nDeta].PT.PathP] =
      HO.WR[G, DA, DDA, DDA, nEtaD, nDeta, nMu, E0].res ;

    hEtaD : HO.HEq[G, DA, DDA, nEtaD] =
      new HO.HEq[G, DA, DDA, nEtaD, nMu,
        HO.strictH G DA DA (HO.compN G DA DDA DA nEtaD nMu) (HO.idN G DA) (\ I x u -> symH (LA.mu-eta I x u)),
        HO.Cat[G, DDA, DDA, HO.compN G DDA DA DDA nMu nEtaD, HO.compN G DDA DA DDA nMu nDeta, HO.idN G DDA, fDDA.1, EM, DMid].res] ;
  } ;
} ;
