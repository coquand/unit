-- CSmall.seg (L4, inside CB): small types over large contexts (model.tex
-- §5.1).  A type over a level-a+ context G whose fibres are level-a codes
-- (SPTy), the same type read at level a+ (up: the same fibres), maps from
-- a level-a context into G (XSub), and substitution along them (xsub),
-- with its composition law once for all small types (xsub-o: Voevodsky's
-- chosen pullback).  A fibration structure on up A moves to xsub A s
-- (SmallFib: the cartesian map (d , b) |-> (s d , b), CCart).
--
-- Quarry: seg/model GSmall; GSmallFib/GSmallFibI are CCart instances.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L1 = GPre[a+].PS ;

-- an iterative set of level a as one of level a+
smallF (v : W0.V) (z : W0.Ix v) : V1.V = (Encode[a, a+].encIx0 v).1 z ;

smallInj (v : W0.V) : V1.Inj (W0.Ix v) (smallF v) = (Encode[a, a+].encIx0 v).2 ;

opaque smallF ; opaque smallInj ;

smallC (v : W0.V) : V1.V = V1.mkV (W0.Ix v) (smallF v) (smallInj v) ;

module SPTy (G : L1.PCtx) {
  tob (I : Ob) (x : V1.Ix (G.ob I)) : W0.V ;
  tact (J I : Ob) (f : Hom J I) (x : V1.Ix (G.ob I)) (y : V1.Ix (G.ob J))
    (e : Id (V1.Ix (G.ob J)) (G.act J I f x) y) (a : W0.Ix (tob I x)) : W0.Ix (tob J y) ;
  tact-id (I : Ob) (x : V1.Ix (G.ob I)) (e : Id (V1.Ix (G.ob I)) (G.act I I (idH I) x) x)
    (a : W0.Ix (tob I x)) : Id (W0.Ix (tob I x)) (tact I I (idH I) x x e a) a ;
  tact-o (K J I : Ob) (f : Hom J I) (g : Hom K J)
    (x : V1.Ix (G.ob I)) (y : V1.Ix (G.ob J)) (z : V1.Ix (G.ob K))
    (e1 : Id (V1.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (V1.Ix (G.ob K)) (G.act K J g y) z)
    (e3 : Id (V1.Ix (G.ob K)) (G.act K I (compH K J I f g) x) z) (a : W0.Ix (tob I x))
    : Id (W0.Ix (tob K z)) (tact K I (compH K J I f g) x z e3 a) (tact K J g y z e2 (tact J I f x y e1 a)) ;
} ;

-- a small type read at level a+ (the same fibres and action)
up (G : L1.PCtx) (A : SPTy[G]) : L1.PTy[G] = new L1.PTy[G, \ I x -> smallC (A.tob I x), A.tact, A.tact-id, A.tact-o] ;

module XSub (D : PCtx) (G : L1.PCtx) {
  nt (I : Ob) (x : W0.Ix (D.ob I)) : V1.Ix (G.ob I) ;
  nt-nat (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) : Id (V1.Ix (G.ob J)) (nt J (D.act J I f x)) (G.act J I f (nt I x)) ;
} ;

xntEq (D : PCtx) (G : L1.PCtx) (s : XSub[D, G]) (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J))
  (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y) : Id (V1.Ix (G.ob J)) (G.act J I f (s.nt I x)) (s.nt J y) =
  transH (symH (s.nt-nat J I f x)) (apH (s.nt J) e) ;

-- substitution of a small type along a map into its context
xsub (D : PCtx) (G : L1.PCtx) (A : SPTy[G]) (s : XSub[D, G]) : PTy[D] =
  mkTy D (\ I x -> A.tob I (s.nt I x))
    (\ J I f x y e a -> A.tact J I f (s.nt I x) (s.nt J y) (xntEq D G s J I f x y e) a)
    (\ I x e a -> A.tact-id I (s.nt I x) (xntEq D G s I I (idH I) x x e) a)
    (\ K J I f g x y z e1 e2 e3 a -> A.tact-o K J I f g (s.nt I x) (s.nt J y) (s.nt K z)
       (xntEq D G s J I f x y e1) (xntEq D G s K J g y z e2) (xntEq D G s K I (compH K J I f g) x z e3) a) ;

-- a map into G after a map of level-a contexts
xoS (T D : PCtx) (G : L1.PCtx) (s : XSub[D, G]) (t : PSub[T, D]) : XSub[T, G] =
  new XSub[T, G, \ I x -> s.nt I (t.nt I x),
    \ J I f x -> transH (apH (s.nt J) (t.nt-nat J I f x)) (s.nt-nat J I f (t.nt I x))] ;

-- the action does not depend on the path (the context is a set)
tact-irr (G : L1.PCtx) (A : SPTy[G]) (J I : Ob) (f : Hom J I) (x : V1.Ix (G.ob I)) (y : V1.Ix (G.ob J))
  (e e' : Id (V1.Ix (G.ob J)) (G.act J I f x) y) (a : W0.Ix (A.tob I x))
  : Id (W0.Ix (A.tob J y)) (A.tact J I f x y e a) (A.tact J I f x y e' a) =
  apH (\ q -> A.tact J I f x y q a) (V1.isSetIx (G.ob J) (G.act J I f x) y e e') ;

-- the composition law, once for all small types
xsub-o (T D : PCtx) (G : L1.PCtx) (A : SPTy[G]) (s : XSub[D, G]) (t : PSub[T, D])
  : Id (PTy[T]) (subTy T D (xsub D G A s) t) (xsub T G A (xoS T D G s t)) =
  ty-ext2 T (subTy T D (xsub D G A s) t) (xsub T G A (xoS T D G s t))
    (refl (\ I x -> A.tob I (s.nt I (t.nt I x))))
    (\ J I f x y e a -> tact-irr G A J I f (s.nt I (t.nt I x)) (s.nt J (t.nt J y))
       (xntEq D G s J I f (t.nt I x) (t.nt J y) (ntEq T D t J I f x y e)) (xntEq T G (xoS T D G s t) J I f x y e) a) ;

opaque tact-irr ; opaque xsub-o ;

------------------------------------------------------------------------
-- a structure on up A moves to xsub A s

module SmallFib (G : L1.PCtx) (A : SPTy[G]) (D : PCtx) (s : XSub[D, G]) {
  module TE = GPre[a+].TyL[G, up G A] ;
  ElTy : PTy[D] = xsub D G A s ;
  module TB = GPR.TyL[D, ElTy] ;

  ta (W : Ob) (w : TB.EI W) : TE.EI W = (s.nt W w.1, w.2) ;

  -- an element of the total of A read at two equal points
  pairT (V W : Ob) (g : Hom V W) (x : V1.Ix (G.ob W)) (x' : V1.Ix (G.ob V)) (e : Id (V1.Ix (G.ob V)) (G.act V W g x) x')
    (z : W0.Ix (A.tob W x))
    : Id (TE.EI V) (G.act V W g x, A.tact V W g x (G.act V W g x) (refl (G.act V W g x)) z) (x', A.tact V W g x x' e z) =
    idJ (V1.Ix (G.ob V)) (G.act V W g x)
      (\ x2 e2 -> Id (TE.EI V) (G.act V W g x, A.tact V W g x (G.act V W g x) (refl (G.act V W g x)) z) (x2, A.tact V W g x x2 e2 z))
      (refl (G.act V W g x, A.tact V W g x (G.act V W g x) (refl (G.act V W g x)) z)) x' e ;

  tanat (V W : Ob) (g : Hom V W) (w : TB.EI W) : Id (TE.EI V) (TE.E.act V W g (ta W w)) (ta V (TB.E.act V W g w)) =
    pairT V W g (s.nt W w.1) (s.nt V (D.act V W g w.1)) (xntEq D G s V W g w.1 (D.act V W g w.1) (refl (D.act V W g w.1))) w.2 ;

  tainj (W : Ob) (v v' : TB.EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (TE.EI W) (ta W v) (ta W v')) : Id (TB.EI W) v v' =
    idJ (W0.Ix (D.ob W)) v.1
      (\ d2 P2 -> (b2 : W0.Ix (A.tob W (s.nt W d2))) -> Id (TE.EI W) (s.nt W v.1, v.2) (s.nt W d2, b2) -> Id (TB.EI W) v (d2, b2))
      (\ b2 Q2 -> apH {W0.Ix (A.tob W (s.nt W v.1))} {TB.EI W} (\ z -> (v.1, z)) (TE.pr-inj W (s.nt W v.1) v.2 b2 Q2))
      v'.1 P v'.2 Q ;

  opaque pairT ;

  module C = CCart[a+, a].Cart[D, ElTy, G, up G A, s.nt, s.nt-nat, ta, \ W w -> refl (s.nt W w.1), tanat, tainj,
    \ X x u -> u, \ X x u -> refl (s.nt X x, u)] ;

  fib (c : CLine[a+].Lines[G, up G A].Fib) : CLine[a].Lines[D, ElTy].Fib = C.moveFib c ;
} ;

------------------------------------------------------------------------
-- maps into G are determined by their points; the action moves along a
-- path of the target point

XNat (D : PCtx) (G : L1.PCtx) (n : (I : Ob) -> W0.Ix (D.ob I) -> V1.Ix (G.ob I)) : U a+ =
  (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) -> Id (V1.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x)) ;

isProp-XNat (D : PCtx) (G : L1.PCtx) (n : (I : Ob) -> W0.Ix (D.ob I) -> V1.Ix (G.ob I)) : isProp (XNat D G n) =
  Axioms[a+].FunExtLemmas[fe @(a+)].isProp-Pi Ob (\ J -> (I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) -> Id (V1.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ J ->
  Axioms[a+].FunExtLemmas[fe @(a+)].isProp-Pi Ob (\ I -> (f : Hom J I) (x : W0.Ix (D.ob I)) -> Id (V1.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ I ->
  Axioms[a+].FunExtLemmas[fe @(a+)].isProp-Pi (Hom J I) (\ f -> (x : W0.Ix (D.ob I)) -> Id (V1.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ f ->
  Axioms[a+].FunExtLemmas[fe @(a+)].isProp-Pi (W0.Ix (D.ob I)) (\ x -> Id (V1.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ x ->
  V1.isSetIx (G.ob J) (n J (D.act J I f x)) (G.act J I f (n I x)))))) ;

xs-ext (D : PCtx) (G : L1.PCtx) (s s' : XSub[D, G]) (P : (I : Ob) (x : W0.Ix (D.ob I)) -> Id (V1.Ix (G.ob I)) (s.nt I x) (s'.nt I x))
  : Id (XSub[D, G]) s s' =
  idJ ((I : Ob) -> W0.Ix (D.ob I) -> V1.Ix (G.ob I)) s.nt
    (\ n2 P2 -> (nn2 : XNat D G n2) -> Id (XSub[D, G]) s (new XSub[D, G, n2, nn2]))
    (\ nn2 -> apH {XNat D G s.nt} {XSub[D, G]} (\ z -> new XSub[D, G, s.nt, z]) (isProp-XNat D G s.nt s.nt-nat nn2))
    s'.nt
    (Axioms[a+].FunExtLemmas[fe @(a+)].funext Ob (\ I -> W0.Ix (D.ob I) -> V1.Ix (G.ob I)) s.nt s'.nt (\ I ->
       Axioms[a+].FunExtLemmas[fe @(a+)].funext (W0.Ix (D.ob I)) (\ x -> V1.Ix (G.ob I)) (s.nt I) (s'.nt I) (\ x -> P I x)))
    s'.nt-nat ;

tact-move (G : L1.PCtx) (A : SPTy[G]) (J I : Ob) (f : Hom J I) (x : V1.Ix (G.ob I)) (y y' : V1.Ix (G.ob J))
  (e : Id (V1.Ix (G.ob J)) (G.act J I f x) y) (e' : Id (V1.Ix (G.ob J)) (G.act J I f x) y') (p : Id (V1.Ix (G.ob J)) y y')
  (b : W0.Ix (A.tob I x))
  : Id (W0.Ix (A.tob J y')) (subst (V1.Ix (G.ob J)) (\ u -> W0.Ix (A.tob J u)) y y' p (A.tact J I f x y e b)) (A.tact J I f x y' e' b) =
  idJ (V1.Ix (G.ob J)) y
    (\ u q -> (q2 : Id (V1.Ix (G.ob J)) (G.act J I f x) u)
       -> Id (W0.Ix (A.tob J u)) (subst (V1.Ix (G.ob J)) (\ u' -> W0.Ix (A.tob J u')) y u q (A.tact J I f x y e b)) (A.tact J I f x u q2 b))
    (\ q2 -> tact-irr G A J I f x y e q2 b) y' p e' ;

opaque xs-ext ; opaque tact-move ;
