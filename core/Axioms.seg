-- Axioms.seg: MODEL/Axioms.agda.  Function extensionality and univalence
-- as TYPES, at a level l.  Agda states them once for all levels (Set
-- omega); here a development that needs them at every level takes
--     fe : [b] Axioms[b].FunExt
-- a level product, i.e. a large type, as a parameter.  They are never
-- postulated.

level l ;
open Base ;
open Prelude[l] ;

-- happly is an equivalence
FunExt : U l+ =
  (A : U l) (B : A -> U l) (f g : (x : A) -> B x) ->
  isEquiv (Id ((x : A) -> B x) f g) ((x : A) -> Id (B x) (f x) (g x)) (happly A B f g) ;

idtoeqv (A B : U l) (p : Id (U l) A B) : Equiv A B =
  idJ (U l) A (\ X q -> Equiv A X) (idEquiv A) B p ;

-- univalence for U l: the identity type of U l is in U l+
Univalence : U l+ =
  (A B : U l) -> Prelude[l+].isEquiv (Id (U l) A B) (Equiv A B) (idtoeqv A B) ;

------------------------------------------------------------------------
-- Consequences of function extensionality

module FunExtLemmas (fe : FunExt) {

  funext (A : U l) (B : A -> U l) (f g : (x : A) -> B x)
    (h : (x : A) -> Id (B x) (f x) (g x)) : Id ((x : A) -> B x) f g =
    (fe A B f g).sec h ;

  happly-funext (A : U l) (B : A -> U l) (f g : (x : A) -> B x)
    (h : (x : A) -> Id (B x) (f x) (g x))
    : Id ((x : A) -> Id (B x) (f x) (g x)) (happly A B f g (funext A B f g h)) h =
    (fe A B f g).sec-eq h ;

  funext-happly (A : U l) (B : A -> U l) (f g : (x : A) -> B x)
    (p : Id ((x : A) -> B x) f g)
    : Id (Id ((x : A) -> B x) f g) (funext A B f g (happly A B f g p)) p =
    sec-ret (Id ((x : A) -> B x) f g) ((x : A) -> Id (B x) (f x) (g x))
            (happly A B f g) (fe A B f g) p ;

  isProp-Pi (A : U l) (B : A -> U l) (pB : (x : A) -> isProp (B x))
    : isProp ((x : A) -> B x) =
    \ f g -> funext A B f g (\ x -> pB x (f x) (g x)) ;

  isProp-isProp (A : U l) : isProp (isProp A) = \ h h' ->
    funext A (\ x -> (y : A) -> Id A x y) h h' (\ x ->
      funext A (\ y -> Id A x y) (h x) (h' x) (\ y ->
        prop-to-set A h x y (h x y) (h' x y))) ;

  isSet-Pi (A : U l) (B : A -> U l) (sB : (x : A) -> isSet (B x))
    : isSet ((x : A) -> B x) = \ f g ->
    retract-prop (Id ((x : A) -> B x) f g) ((x : A) -> Id (B x) (f x) (g x))
      (happly A B f g) (funext A B f g) (funext-happly A B f g)
      (isProp-Pi A (\ x -> Id (B x) (f x) (g x)) (\ x -> sB x (f x) (g x))) ;
} ;

------------------------------------------------------------------------
-- Consequences of univalence

module UnivalenceLemmas (univ : Univalence) {

  ua (A B : U l) (e : Equiv A B) : Id (U l) A B = (univ A B).sec e ;

  fst-idtoeqv (A B : U l) (p : Id (U l) A B) (a : A)
    : Id B ((idtoeqv A B p).1 a) (coe A B p a) =
    idJ (U l) A (\ X q -> Id X ((idtoeqv A X q).1 a) (coe A X q a)) (refl a) B p ;

  -- transport along ua e is e
  ua-beta (A B : U l) (e : Equiv A B) (a : A) : Id B (coe A B (ua A B e) a) (e.1 a) =
    trans B (coe A B (ua A B e) a) ((idtoeqv A B (ua A B e)).1 a) (e.1 a)
      (sym B ((idtoeqv A B (ua A B e)).1 a) (coe A B (ua A B e) a) (fst-idtoeqv A B (ua A B e) a))
      (Prelude[l+].ap (Equiv A B) B (\ e' -> e'.1 a) (idtoeqv A B (ua A B e)) e ((univ A B).sec-eq e)) ;
} ;
