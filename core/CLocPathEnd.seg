-- CLocPathEnd.seg (L9): Lemma eta-path, part 2: its ends and its naturality; ported from seg/model DPathEnd.seg
-- onto core's poset instance (module names only).  Original header:
--
--   MODEL/Poset/DPathEnd.agda.  Lemma 3.1 of [S], continued:
-- the end points and the naturality of the path of DPath.
--
--   path-0    restricted to X * 0 it is eta_DA u   (the cut a = n+1)
--   path-1    restricted to X * 1 it is D eta_A u  (the cut a = 0)
--   path-nat  it commutes with the restriction along any h : Y -> X
--
-- Each is an instance of the reparametrisation principle RP, along the
-- identity on numbers between two presentations of the same [c].  The
-- where-blocks of R0, R1, RN are the segments F0, F1, FN.

level q l ;
constraint q <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[q] ;
open Arith[q] ;
open Sum[q] ;
open Cat[q] ;
open SmallCat[q].Objs[obV] ; open SmallCat[q].Homs[obV, homV] ;
open CPosC[q] ;
open CSimp[q] ;
module PB = CPosInst[q].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module DD = CLocD[q, l] ;
open CLocPath[q, l] ;

module LPE (G : PCtx) (A : PTy[G]) {
  open PR.TyL[G, A] ;
  open DD.DT[G, A] ;
  open LP[G, A] ;

  ----------------------------------------------------------------------
  -- The end points

  module Ends (X : Ob) (x : Pt X) (u : DEl X x) {
    open At[X, x, u] ;

    -- the end point maps, opaque: unfolding them inside the
    -- factorisation makes type checking very slow
    ltE (e : El Iv) (n : Nat) (f : Hom (lin n) X) : Hom (lin n) (prodP X Iv) = compH (lin n) X (prodP X Iv) (lid X e) f ;

    ltE-eq (e : El Iv) (n : Nat) (f : Hom (lin n) X) : Id (Hom (lin n) (prodP X Iv)) (compH (lin n) X (prodP X Iv) (lid X e) f) (ltE e n f) =
      refl (ltE e n f) ;

    -- the two coordinates of (lid e) f are f and e
    ltE-pX (e : El Iv) (n : Nat) (f : Hom (lin n) X) : PW (lin n) X (compH (lin n) (prodP X Iv) X (pX X) (ltE e n f)) f =
      pw-pX-lid-comp (lin n) X e f ;

    ltE-lev (e : El Iv) (n : Nat) (f : Hom (lin n) X) (i : Nat) (hi : IsT (leb i n))
      : Id Nat (Vals[n, suc zero, compH (lin n) (prodP X Iv) Iv (pr2 X Iv) (ltE e n f)].gam i) (vnum e.1) =
      transH (Vals[n, suc zero, compH (lin n) (prodP X Iv) Iv (pr2 X Iv) (ltE e n f)].gam-eq i hi)
             (apH vnum (pr2-lid-comp (lin n) X e f (leaf i, hi))) ;

    opaque ltE ; opaque ltE-eq ; opaque ltE-pX ; opaque ltE-lev ;

    -- reading the path at an end point
    atEnd (e : El Iv) (n : Nat) (f : Hom (lin n) X)
      : Id (W0.Ix (ED.ob (lin n))) (D2.rd (prodP X Iv) rho' pathD.1 n (compH (lin n) X (prodP X Iv) (lid X e) f))
                                   (D2.rd (prodP X Iv) rho' pathD.1 n (ltE e n f)) =
      apH (D2.rd (prodP X Iv) rho' pathD.1 n) (ltE-eq e n f) ;

    ctxEnd (e : El Iv) (n : Nat) (f : Hom (lin n) X) : Id (Pt (lin n)) (G.act (lin n) (prodP X Iv) (ltE e n f) rho') (G.act (lin n) X f x) =
      GL.actTri (lin n) (prodP X Iv) X (pX X) (ltE e n f) f (hom-eq (lin n) X (compH (lin n) (prodP X Iv) X (pX X) (ltE e n f)) f (ltE-pX e n f)) x ;

    -- the reading of u along f , through the first projection
    pFe (e : El Iv) (n : Nat) (f : Hom (lin n) X) (c : Nat) (k1 : Hom (lin c) (lin n)) (j : Nat) (h : IsT (leb j c))
      : Id Tree (app (lin c) X (compH (lin c) (lin n) X (compH (lin n) (prodP X Iv) X (pX X) (ltE e n f)) k1) (leaf j, h)).1
                (app (lin n) X f (app (lin c) (lin n) k1 (leaf j, h))).1 =
      transH (app-compH1 (lin c) (lin n) X (compH (lin n) (prodP X Iv) X (pX X) (ltE e n f)) k1 (leaf j, h))
             (ltE-pX e n f (app (lin c) (lin n) k1 (leaf j, h))) ;

    module F0 (n : Nat) (f : Hom (lin n) X) (m : Nat) (g : Hom (lin m) (lin n)) {
      module FF = Fac[X, n, ltE e0 n f, m, g] ;

      ea : Id Nat FF.C.a (suc n) = cnt-all (\ i -> isZ (FF.C.hv i)) n (\ i hi -> apH isZ (ltE-lev e0 n f i hi)) ;

      ec : Id Nat FF.O.c m = FF.O.c-top ea ;

      pF : PW (lin FF.O.c) X FF.F (compH (lin FF.O.c) (lin m) X (compH (lin m) (lin n) X f g) (idN FF.O.c m ec)) =
        pwl FF.O.c X FF.F (compH (lin FF.O.c) (lin m) X (compH (lin m) (lin n) X f g) (idN FF.O.c m ec))
          (\ j h -> transH (pFe e0 n f FF.O.c FF.k1H j h) (transH
             (apH (\ z -> (app (lin n) X f z).1)
               (el-eq (lin n) (leaf (FF.O.k1 j), FF.O.k1-rng j h) (app (lin m) (lin n) g (leaf j, idN-rng FF.O.c m ec j h))
                      (transH (apH (\ k -> leaf k) (FF.O.k1-top ea j h)) (symH (Vals[m, n, g].leaf-eq j (idN-rng FF.O.c m ec j h))))))
             (symH (transH (app-compH1 (lin FF.O.c) (lin m) X (compH (lin m) (lin n) X f g) (idN FF.O.c m ec) (leaf j, h))
                           (app-compH1 (lin m) (lin n) X f g (leaf j, idN-rng FF.O.c m ec j h)))))) ;

      pK : PW (lin m) (lin m) (idH (lin m)) (compH (lin m) (lin FF.O.c) (lin m) (idN FF.O.c m ec) FF.k2H) =
        pwl m (lin m) (idH (lin m)) (compH (lin m) (lin FF.O.c) (lin m) (idN FF.O.c m ec) FF.k2H)
          (\ j h -> transH (app-idH1 (lin m) (leaf j, h))
                   (transH (apH (\ k -> leaf k) (symH (FF.O.k2-top ea j h)))
                           (symH (app-compH1 (lin m) (lin FF.O.c) (lin m) (idN FF.O.c m ec) FF.k2H (leaf j, h))))) ;

      res : Id (EI (lin m)) (R n (ltE e0 n f) m g) (rd X x u.1 m (compH (lin m) (lin n) X f g)) =
        transH RAt[n, ltE e0 n f, m, g].R-def
         (transH (RP X x u m m FF.O.c (compH (lin m) (lin n) X f g) (idH (lin m)) FF.F FF.k2H
                     (idN FF.O.c m ec) (idN-strict FF.O.c m ec) pF pK)
                 (E.act-id (lin m) (rd X x u.1 m (compH (lin m) (lin n) X f g)))) ;
    } ;

    R0 (n : Nat) (f : Hom (lin n) X) (m : Nat) (g : Hom (lin m) (lin n))
      : Id (EI (lin m)) (R n (ltE e0 n f) m g) (rd X x u.1 m (compH (lin m) (lin n) X f g)) = F0[n, f, m, g].res ;

    module F1 (n : Nat) (f : Hom (lin n) X) (m : Nat) (g : Hom (lin m) (lin n)) {
      module FF = Fac[X, n, ltE e1 n f, m, g] ;

      ea : Id Nat FF.C.a zero = cnt-none (\ i -> isZ (FF.C.hv i)) n (\ i hi -> apH isZ (ltE-lev e1 n f i hi)) ;

      ec : Id Nat FF.O.c n = FF.O.c-bot ea ;

      pF : PW (lin FF.O.c) X FF.F (compH (lin FF.O.c) (lin n) X f (idN FF.O.c n ec)) =
        pwl FF.O.c X FF.F (compH (lin FF.O.c) (lin n) X f (idN FF.O.c n ec))
          (\ j h -> transH (pFe e1 n f FF.O.c FF.k1H j h) (transH
             (apH (\ z -> (app (lin n) X f z).1)
               (el-eq (lin n) (leaf (FF.O.k1 j), FF.O.k1-rng j h) (leaf j, idN-rng FF.O.c n ec j h)
                      (apH (\ k -> leaf k) (FF.O.k1-bot ea j))))
             (symH (app-compH1 (lin FF.O.c) (lin n) X f (idN FF.O.c n ec) (leaf j, h))))) ;

      pK : PW (lin m) (lin n) g (compH (lin m) (lin FF.O.c) (lin n) (idN FF.O.c n ec) FF.k2H) =
        pwl m (lin n) g (compH (lin m) (lin FF.O.c) (lin n) (idN FF.O.c n ec) FF.k2H)
          (\ j h -> transH (Vals[m, n, g].leaf-eq j h)
                   (transH (apH (\ k -> leaf k) (symH (FF.O.k2-bot ea j)))
                           (symH (app-compH1 (lin m) (lin FF.O.c) (lin n) (idN FF.O.c n ec) FF.k2H (leaf j, h))))) ;

      res : Id (EI (lin m)) (R n (ltE e1 n f) m g) (E.act (lin m) (lin n) g (rd X x u.1 n f)) =
        transH RAt[n, ltE e1 n f, m, g].R-def
               (RP X x u m n FF.O.c f g FF.F FF.k2H (idN FF.O.c n ec) (idN-strict FF.O.c n ec) pF pK) ;
    } ;

    R1 (n : Nat) (f : Hom (lin n) X) (m : Nat) (g : Hom (lin m) (lin n))
      : Id (EI (lin m)) (R n (ltE e1 n f) m g) (E.act (lin m) (lin n) g (rd X x u.1 n f)) = F1[n, f, m, g].res ;

    ctx0 (e : El Iv) : Id (Pt X) (G.act X (prodP X Iv) (lid X e) rho') x =
      transH (GL.actTri X (prodP X Iv) X (pX X) (lid X e) (idH X) (pX-lid X e) x) (G.act-id X x) ;

    -- restricted to X * 0, the path is eta_DA u
    path-0 : Id (W0.Ix (D2.ED.ob X)) (D2.ED.act X (prodP X Iv) (lid X e0) (rho', pathD)) (x, D2.etaF X x u) =
      DE2ext X (G.act X (prodP X Iv) (lid X e0) rho') x (D2.dtact X (prodP X Iv) (lid X e0) rho' (G.act X (prodP X Iv) (lid X e0) rho') (refl (G.act X (prodP X Iv) (lid X e0) rho')) pathD) (D2.etaF X x u) (ctx0 e0)
        (\ n f -> transH (D2.rd-dtact X (prodP X Iv) (lid X e0) rho' (G.act X (prodP X Iv) (lid X e0) rho') (refl (G.act X (prodP X Iv) (lid X e0) rho')) pathD n f)
                    (transH (atEnd e0 n f)
                      (DEext (lin n) (G.act (lin n) (prodP X Iv) (ltE e0 n f) rho') (G.act (lin n) X f x)
                         (vD n (ltE e0 n f)) (dtact (lin n) X f x (G.act (lin n) X f x) (refl (G.act (lin n) X f x)) u)
                         (ctxEnd e0 n f)
                         (\ m g -> transH (valE n (ltE e0 n f) m g)
                                     (transH (R0 n f m g) (symH (rd-dtact (lin n) X f x (G.act (lin n) X f x) (refl (G.act (lin n) X f x)) u m g))))))) ;

    -- restricted to X * 1, the path is D eta_A u
    path-1 : Id (W0.Ix (D2.ED.ob X)) (D2.ED.act X (prodP X Iv) (lid X e1) (rho', pathD)) (x, DD.DMap[G, A, DA, etaN].DF X x u) =
      DE2ext X (G.act X (prodP X Iv) (lid X e1) rho') x (D2.dtact X (prodP X Iv) (lid X e1) rho' (G.act X (prodP X Iv) (lid X e1) rho') (refl (G.act X (prodP X Iv) (lid X e1) rho')) pathD) (DD.DMap[G, A, DA, etaN].DF X x u) (ctx0 e1)
        (\ n f -> transH (D2.rd-dtact X (prodP X Iv) (lid X e1) rho' (G.act X (prodP X Iv) (lid X e1) rho') (refl (G.act X (prodP X Iv) (lid X e1) rho')) pathD n f)
                    (transH (atEnd e1 n f)
                      (DEext (lin n) (G.act (lin n) (prodP X Iv) (ltE e1 n f) rho') (G.act (lin n) X f x)
                         (vD n (ltE e1 n f)) (etaF (lin n) (G.act (lin n) X f x) (u.1 n f))
                         (ctxEnd e1 n f)
                         (\ m g -> transH (valE n (ltE e1 n f) m g) (R1 n f m g))))) ;
  } ;

  ----------------------------------------------------------------------
  -- Naturality

  module Nat' (Y X : Ob) (h : Hom Y X) (x : Pt X) (u : DEl X x) {

    uY : DEl Y (G.act Y X h x) = dtact Y X h x (G.act Y X h x) (refl (G.act Y X h x)) u ;

    module AX = At[X, x, u] ;
    module AY = At[Y, G.act Y X h x, uY] ;

    -- h * [1] commutes with the projections:  pX (h * 1) = h pX ,  pr2 (h * 1) = pr2
    pw-pX : PW (prodP Y Iv) X (compH (prodP Y Iv) (prodP X Iv) X (pX X) (cylH Y X h)) (compH (prodP Y Iv) Y X h (pX Y)) = \ w ->
      calc Tree {
          (app (prodP Y Iv) X (compH (prodP Y Iv) (prodP X Iv) X (pX X) (cylH Y X h)) w).1
        =< app-compH1 (prodP Y Iv) (prodP X Iv) X (pX X) (cylH Y X h) w >
          (p1 X Iv (app (prodP Y Iv) (prodP X Iv) (cylH Y X h) w)).1
        =< p1-node X Iv (app (prodP Y Iv) (prodP X Iv) (cylH Y X h) w) (app Y X h (p1 Y Iv w)).1 (p2 Y Iv w).1 (app-cylH1 Y X h w) >
          (app Y X h (p1 Y Iv w)).1
        =< symH (app-compH1 (prodP Y Iv) Y X h (pX Y) w) >
          (app (prodP Y Iv) X (compH (prodP Y Iv) Y X h (pX Y)) w).1 } ;

    pw-pr2 : PW (prodP Y Iv) Iv (compH (prodP Y Iv) (prodP X Iv) Iv (pr2 X Iv) (cylH Y X h)) (pr2 Y Iv) = \ w ->
      transH (app-compH1 (prodP Y Iv) (prodP X Iv) Iv (pr2 X Iv) (cylH Y X h) w)
             (p2-node X Iv (app (prodP Y Iv) (prodP X Iv) (cylH Y X h) w) (app Y X h (p1 Y Iv w)).1 (p2 Y Iv w).1 (app-cylH1 Y X h w)) ;

    lc (n : Nat) (phi : Hom (lin n) (prodP Y Iv)) : Hom (lin n) (prodP X Iv) = compH (lin n) (prodP Y Iv) (prodP X Iv) (cylH Y X h) phi ;

    lc-eq (n : Nat) (phi : Hom (lin n) (prodP Y Iv))
      : Id (Hom (lin n) (prodP X Iv)) (compH (lin n) (prodP Y Iv) (prodP X Iv) (cylH Y X h) phi) (lc n phi) = refl (lc n phi) ;

    lc-pX (n : Nat) (phi : Hom (lin n) (prodP Y Iv))
      : PW (lin n) X (compH (lin n) (prodP X Iv) X (pX X) (lc n phi)) (compH (lin n) Y X h (compH (lin n) (prodP Y Iv) Y (pX Y) phi)) =
      pw-trans (lin n) X _ (compH (lin n) (prodP Y Iv) X (compH (prodP Y Iv) (prodP X Iv) X (pX X) (cylH Y X h)) phi) _
        (pw-of-eq (lin n) X _ _ (symH (comp-assoc (lin n) (prodP Y Iv) (prodP X Iv) X (pX X) (cylH Y X h) phi)))
        (pw-trans (lin n) X _ (compH (lin n) (prodP Y Iv) X (compH (prodP Y Iv) Y X h (pX Y)) phi) _
           (pw-pre (lin n) (prodP Y Iv) X _ _ phi pw-pX)
           (pw-of-eq (lin n) X _ _ (comp-assoc (lin n) (prodP Y Iv) Y X h (pX Y) phi))) ;

    lc-lev (n : Nat) (phi : Hom (lin n) (prodP Y Iv)) (i : Nat) (hi : IsT (leb i n))
      : Id Nat (Vals[n, suc zero, compH (lin n) (prodP X Iv) Iv (pr2 X Iv) (lc n phi)].gam i)
               (Vals[n, suc zero, compH (lin n) (prodP Y Iv) Iv (pr2 Y Iv) phi].gam i) =
      transH (Vals[n, suc zero, compH (lin n) (prodP X Iv) Iv (pr2 X Iv) (lc n phi)].gam-eq i hi)
       (transH (apH vnum
                 (pw-trans (lin n) Iv _ (compH (lin n) (prodP Y Iv) Iv (compH (prodP Y Iv) (prodP X Iv) Iv (pr2 X Iv) (cylH Y X h)) phi) _
                    (pw-of-eq (lin n) Iv _ _ (symH (comp-assoc (lin n) (prodP Y Iv) (prodP X Iv) Iv (pr2 X Iv) (cylH Y X h) phi)))
                    (pw-pre (lin n) (prodP Y Iv) Iv _ _ phi pw-pr2) (leaf i, hi)))
               (symH (Vals[n, suc zero, compH (lin n) (prodP Y Iv) Iv (pr2 Y Iv) phi].gam-eq i hi))) ;

    opaque lc ; opaque lc-eq ; opaque lc-pX ; opaque lc-lev ;

    module FN (n : Nat) (phi : Hom (lin n) (prodP Y Iv)) (m : Nat) (g : Hom (lin m) (lin n)) {
      module FX = Fac[X, n, lc n phi, m, g] ;
      module FY = Fac[Y, n, phi, m, g] ;

      ea : Id Nat FX.C.a FY.C.a =
        cnt-ext (\ i -> isZ (FX.C.hv i)) (\ i -> isZ (FY.C.hv i)) n (\ i hi -> apH isZ (lc-lev n phi i hi)) ;

      module S = Same[n, FX.C.a, FY.C.a, m, FX.gv, FY.gv, FX.C.ha, FY.C.ha, Vals[m, n, g].rng, Vals[m, n, g].gmono,
                      Vals[m, n, g].rng, Vals[m, n, g].gmono, ea, \ j hj -> refl (FX.gv j)] ;

      ec : Id Nat FY.O.c FX.O.c = symH S.ec ;

      -- k1 of Y is k1 of X, read through the identity on numbers
      pk1N : PW (lin FY.O.c) (lin n) FY.k1H (compH (lin FY.O.c) (lin FX.O.c) (lin n) FX.k1H (idN FY.O.c FX.O.c ec)) =
        pwl FY.O.c (lin n) FY.k1H (compH (lin FY.O.c) (lin FX.O.c) (lin n) FX.k1H (idN FY.O.c FX.O.c ec))
          (\ j hj -> transH (apH (\ k -> leaf k) (symH (S.ek1 j (idN-rng FY.O.c FX.O.c ec j hj))))
                            (symH (app-compH1 (lin FY.O.c) (lin FX.O.c) (lin n) FX.k1H (idN FY.O.c FX.O.c ec) (leaf j, hj)))) ;

      -- h FY.F = (h fY) k1 ~ fX k1 ~ fX (k1' idN) = FX.F idN
      pF : PW (lin FY.O.c) X (compH (lin FY.O.c) Y X h FY.F) (compH (lin FY.O.c) (lin FX.O.c) X FX.F (idN FY.O.c FX.O.c ec)) =
        pw-trans (lin FY.O.c) X _ (compH (lin FY.O.c) (lin n) X (compH (lin n) Y X h FY.f) FY.k1H) _
          (pw-of-eq (lin FY.O.c) X _ _ (symH (comp-assoc (lin FY.O.c) (lin n) Y X h FY.f FY.k1H)))
          (pw-trans (lin FY.O.c) X _ (compH (lin FY.O.c) (lin n) X FX.f FY.k1H) _
             (pw-pre (lin FY.O.c) (lin n) X _ _ FY.k1H (pw-sym (lin n) X _ _ (lc-pX n phi)))
             (pw-trans (lin FY.O.c) X _ (compH (lin FY.O.c) (lin n) X FX.f (compH (lin FY.O.c) (lin FX.O.c) (lin n) FX.k1H (idN FY.O.c FX.O.c ec))) _
                (pw-post (lin FY.O.c) (lin n) X _ _ FX.f pk1N)
                (pw-of-eq (lin FY.O.c) X _ _ (symH (comp-assoc (lin FY.O.c) (lin FX.O.c) (lin n) X FX.f FX.k1H (idN FY.O.c FX.O.c ec)))))) ;

      pK : PW (lin m) (lin FX.O.c) FX.k2H (compH (lin m) (lin FY.O.c) (lin FX.O.c) (idN FY.O.c FX.O.c ec) FY.k2H) =
        pwl m (lin FX.O.c) FX.k2H (compH (lin m) (lin FY.O.c) (lin FX.O.c) (idN FY.O.c FX.O.c ec) FY.k2H)
          (\ j hj -> transH (apH (\ k -> leaf k) (S.ek2 j hj))
                            (symH (app-compH1 (lin m) (lin FY.O.c) (lin FX.O.c) (idN FY.O.c FX.O.c ec) FY.k2H (leaf j, hj)))) ;

      res : Id (EI (lin m)) (AX.R n (lc n phi) m g) (AY.R n phi m g) =
        transH AX.RAt[n, lc n phi, m, g].R-def
         (transH (transH (symH (RP X x u m FX.O.c FY.O.c FX.F FX.k2H (compH (lin FY.O.c) Y X h FY.F) FY.k2H
                                   (idN FY.O.c FX.O.c ec) (idN-strict FY.O.c FX.O.c ec) pF pK))
                         (symH (apH (E.act (lin m) (lin FY.O.c) FY.k2H)
                                    (rd-dtact Y X h x (G.act Y X h x) (refl (G.act Y X h x)) u FY.O.c FY.F))))
                 (symH AY.RAt[n, phi, m, g].R-def)) ;
    } ;

    RN (n : Nat) (phi : Hom (lin n) (prodP Y Iv)) (m : Nat) (g : Hom (lin m) (lin n))
      : Id (EI (lin m)) (AX.R n (lc n phi) m g) (AY.R n phi m g) = FN[n, phi, m, g].res ;

    fstEq : Id (Pt (prodP Y Iv)) (G.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho') AY.rho' =
      GL.actSq (prodP Y Iv) (prodP X Iv) Y X (pX X) (cylH Y X h) h (pX Y) (hom-eq (prodP Y Iv) X (compH (prodP Y Iv) (prodP X Iv) X (pX X) (cylH Y X h)) (compH (prodP Y Iv) Y X h (pX Y)) pw-pX) x ;

    path-nat : Id (W0.Ix (D2.ED.ob (prodP Y Iv))) (D2.ED.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) (AX.rho', AX.pathD)) (AY.rho', AY.pathD) =
      DE2ext (prodP Y Iv) (G.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho') AY.rho' (D2.dtact (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho' (G.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho') (refl (G.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho')) AX.pathD) AY.pathD fstEq
        (\ n phi -> transH (D2.rd-dtact (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho' (G.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho') (refl (G.act (prodP Y Iv) (prodP X Iv) (cylH Y X h) AX.rho')) AX.pathD n phi)
                     (transH (apH (D2.rd (prodP X Iv) AX.rho' AX.pathD.1 n) (lc-eq n phi))
                       (DEext (lin n) (G.act (lin n) (prodP X Iv) (lc n phi) AX.rho') (G.act (lin n) (prodP Y Iv) phi AY.rho')
                          (AX.vD n (lc n phi)) (AY.vD n phi)
                          (transH (symH (apH (\ k -> G.act (lin n) (prodP X Iv) k AX.rho') (lc-eq n phi)))
                                  (transH (symH (GL.actC (lin n) (prodP Y Iv) (prodP X Iv) (cylH Y X h) phi AX.rho'))
                                          (apH (G.act (lin n) (prodP Y Iv) phi) fstEq)))
                          (\ m g -> transH (AX.valE n (lc n phi) m g)
                                     (transH (RN n phi m g) (symH (AY.valE n phi m g))))))) ;
  } ;
} ;
