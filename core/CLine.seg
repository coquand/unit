-- CLine.seg (L3, inside CB, level l): lines, strict fibres, fillers and
-- compositions (model.tex Def "lines", §3.3, §4).
--
--   FC[G]        lines of G: natural families over the generalised points
--                (f , i) : W -> X * I (no product in the base); GI, ev e,
--                constF
--   FT[G , A]    lines in A over lines of G: AI over GI; Ev[e].evA the end
--   FMap         lines along a substitution
--   SFib, TrivFib  strict fibre of a map; trivial fibration = ContrOp on it
--   EndKit[G , A , e]  elements of the strict fibre of ev e (a line ending
--                at a given element): lineL, endE, mkTS
--   Lines[G , A]  Fill e = TrivFib (ev e); Comp e e' = RC (SF of ev e,
--                A[ev e'], the other end); fill gives comp (Post);
--                Fib = Comp e0 e1 * Comp e1 e0
--
-- Quarry: seg/model GFam (FC, FT, FMap), GLine (SFib, EndKit, CompAtP).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VL = VLift[a, l] ;
module GPR = GPre[l] ;
open GPR.PS ;

----------------------------------------------------------------------
-- lines in a context

-- Pi codes over the objects and maps of the base (level a), at level l
piO (B : Ob -> W0.V) : W0.V = VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) B ;
piH (W X : Ob) (B : Hom W X -> W0.V) : W0.V = VL.PiS (Hom W X) (VL.encIx (homV W X)) (VL.encIx-inj (homV W X)) B ;

module FC (G : PCtx) {
  ftV (X : Ob) : W0.V =
    piO (\ W -> piH W X (\ f -> piH W Iv (\ i -> G.ob W))) ;

  ntV (X : Ob) (t : W0.Ix (ftV X)) : W0.V =
    piO (\ V -> piO (\ W -> piH V W (\ g -> piH W X (\ f ->
      piH W Iv (\ i ->
        W0.IdV (G.ob V) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))))))) ;

  ob (X : Ob) : W0.V = W0.SigV (ftV X) (ntV X) ;

  -- naturality is a proposition
  nt-prop (X : Ob) (t : W0.Ix (ftV X)) : isProp (W0.Ix (ntV X t)) =
    isProp-Pi Ob (\ V -> (W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
                   -> Id (W0.Ix (G.ob V)) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))) (\ V ->
    isProp-Pi Ob (\ W -> (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
                   -> Id (W0.Ix (G.ob V)) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))) (\ W ->
    isProp-Pi (Hom V W) (\ g -> (f : Hom W X) (i : Hom W Iv)
                   -> Id (W0.Ix (G.ob V)) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))) (\ g ->
    isProp-Pi (Hom W X) (\ f -> (i : Hom W Iv)
                   -> Id (W0.Ix (G.ob V)) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))) (\ f ->
    isProp-Pi (Hom W Iv) (\ i -> Id (W0.Ix (G.ob V)) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))) (\ i ->
      W0.isSetIx (G.ob V) (G.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))))))) ;

  -- two lines with the same values are equal
  fam-eq (X : Ob) (x y : W0.Ix (ob X))
    (q : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (G.ob W)) (x.1 W f i) (y.1 W f i)) : Id (W0.Ix (ob X)) x y =
    Sigma-path (W0.Ix (ftV X)) (\ t -> W0.Ix (ntV X t)) x.1 y.1 x.2 y.2
      (funext Ob (\ W -> (f : Hom W X) -> Hom W Iv -> W0.Ix (G.ob W)) x.1 y.1 (\ W ->
        funext (Hom W X) (\ f -> Hom W Iv -> W0.Ix (G.ob W)) (x.1 W) (y.1 W) (\ f ->
          funext (Hom W Iv) (\ i -> W0.Ix (G.ob W)) (x.1 W f) (y.1 W f) (\ i -> q W f i))))
      (nt-prop X y.1 _ y.2) ;

  actF (Y X : Ob) (h : Hom Y X) (x : W0.Ix (ob X)) : W0.Ix (ob Y) =
    (\ W f i -> x.1 W (compH W Y X h f) i,
     \ V W g f i -> transH (x.2 V W g (compH W Y X h f) i)
                           (apH (\ k -> x.1 V k (compH V W Iv i g)) (comp-assoc V W Y X h f g))) ;

  actF-id (X : Ob) (x : W0.Ix (ob X)) : Id (W0.Ix (ob X)) (actF X X (idH X) x) x =
    fam-eq X (actF X X (idH X) x) x (\ W f i -> apH (\ k -> x.1 W k i) (comp-idl W X f)) ;

  actF-o (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : W0.Ix (ob I))
    : Id (W0.Ix (ob K)) (actF K I (compH K J I f g) x) (actF K J g (actF J I f x)) =
    fam-eq K (actF K I (compH K J I f g) x) (actF K J g (actF J I f x))
      (\ W f' i -> apH (\ k -> x.1 W k i) (comp-assoc W K J I f g f')) ;

  GI : PCtx = new PCtx[ob, actF, actF-id, actF-o] ;

  -- the constant line at a point
  constF (X : Ob) (u : W0.Ix (G.ob X)) : W0.Ix (ob X) =
    (\ W f i -> G.act W X f u, \ V W g f i -> GPR.PshL[G].actC V W X f g u) ;

  -- the end at e: the value at (id , e)
  evN (e : IPt) (Y X : Ob) (h : Hom Y X) (x : W0.Ix (ob X))
    : Id (W0.Ix (G.ob Y)) ((actF Y X h x).1 Y (idH Y) (ptH Y e)) (G.act Y X h (x.1 X (idH X) (ptH X e))) =
    symH (transH (x.2 Y X h (idH X) (ptH X e))
           (transH (apH (\ k -> x.1 Y k (compH Y X Iv (ptH X e) h)) (transH (comp-idl Y X h) (symH (comp-idr Y X h))))
                   (apH (\ k -> x.1 Y (compH Y Y X h (idH Y)) k) (ptH-nat Y X h e)))) ;

  ev (e : IPt) : PSub[GI, G] = new PSub[GI, G, \ X x -> x.1 X (idH X) (ptH X e), evN e] ;
} ;

----------------------------------------------------------------------
-- lines in a type: lines in its total presheaf over a line in G

module FT (G : PCtx) (A : PTy[G]) {
  module TA = GPR.TyL[G, A] ;
  module FG = FC[G] ;
  module FE = FC[TA.E] ;

  -- the line in G under a line in E
  piL (X : Ob) (L : W0.Ix (FE.ob X)) : W0.Ix (FG.ob X) =
    (\ W f i -> (TA.pr1 W (L.1 W f i)), \ V W g f i -> apH (\ z -> (TA.pr1 V z)) (L.2 V W g f i)) ;

  piL-act (Y X : Ob) (h : Hom Y X) (L : W0.Ix (FE.ob X))
    : Id (W0.Ix (FG.ob Y)) (piL Y (FE.actF Y X h L)) (FG.actF Y X h (piL X L)) =
    FG.fam-eq Y (piL Y (FE.actF Y X h L)) (FG.actF Y X h (piL X L)) (\ W f i -> refl (TA.pr1 W (L.1 W (compH W Y X h f) i))) ;

  tobF (X : Ob) (x : W0.Ix (FG.ob X)) : W0.V = W0.SigV (FE.ob X) (\ L -> W0.IdV (FG.ob X) (piL X L) x) ;

  -- an element is determined by its line in E
  tob-eq (X : Ob) (x : W0.Ix (FG.ob X)) (u v : W0.Ix (tobF X x)) (p : Id (W0.Ix (FE.ob X)) u.1 v.1)
    : Id (W0.Ix (tobF X x)) u v =
    Sigma-path (W0.Ix (FE.ob X)) (\ L -> Id (W0.Ix (FG.ob X)) (piL X L) x) u.1 v.1 u.2 v.2 p
      (W0.isSetIx (FG.ob X) (piL X v.1) x _ v.2) ;

  tactF : TactTy FG.GI tobF = \ J I h x y e u ->
    (FE.actF J I h u.1, transH (piL-act J I h u.1) (transH (apH (FG.actF J I h) u.2) e)) ;

  tactF-id : IdLaw FG.GI tobF tactF = \ I x e u ->
    tob-eq I x (tactF I I (idH I) x x e u) u (FE.actF-id I u.1) ;

  tactF-o : OLaw FG.GI tobF tactF = \ K J I f g x y z e1' e2 e3 u ->
    tob-eq K z (tactF K I (compH K J I f g) x z e3 u) (tactF K J g y z e2 (tactF J I f x y e1' u)) (FE.actF-o K J I f g u.1) ;

  AI : PTy[FG.GI] = (mkTy FG.GI tobF tactF tactF-id tactF-o) ;

  module TL = GPR.TyL[FG.GI, AI] ;

  -- the values of the line of an element of AI: at g : V -> X and j : V -> I
  lval (X : Ob) (w : TL.EI X) (V : Ob) (g : Hom V X) (j : Hom V Iv) : TA.EI V = (TL.pr2 X w).1.1 V g j ;

  ----------------------------------------------------------------------
  -- evaluation at an end point

  module Ev (e : IPt) {
    Aev : PTy[FG.GI] = subTy FG.GI G A (FG.ev e) ;
    module TV = GPR.TyL[FG.GI, Aev] ;

    -- the element of A at the end: the value of the line in E at (id , e)
    endB (X : Ob) (w : TL.EI X) : TV.T X (TL.pr1 X w) =
      TA.coeT X (TA.pr1 X (lval X w X (idH X) (ptH X e))) ((TL.pr1 X w).1 X (idH X) (ptH X e))
        (apH (\ y -> y.1 X (idH X) (ptH X e)) (TL.pr2 X w).2) (TA.pr2 X (lval X w X (idH X) (ptH X e))) ;

    endB-E (X : Ob) (w : TL.EI X)
      : Id (TA.EI X) (TA.pr X ((TL.pr1 X w).1 X (idH X) (ptH X e)) (endB X w)) (lval X w X (idH X) (ptH X e)) =
      symH (TA.pr-coe X (TA.pr1 X (lval X w X (idH X) (ptH X e))) ((TL.pr1 X w).1 X (idH X) (ptH X e))
              (apH (\ y -> y.1 X (idH X) (ptH X e)) (TL.pr2 X w).2) (TA.pr2 X (lval X w X (idH X) (ptH X e)))) ;

    mE (X : Ob) (w : TL.EI X) : TV.EI X = (TV.pr X (TL.pr1 X w) (endB X w)) ;

    -- the end of the restricted line, read in E
    endAct (Y X : Ob) (h : Hom Y X) (w : TL.EI X)
      : Id (TA.EI Y) (lval X w Y (compH Y Y X h (idH Y)) (ptH Y e)) (TA.E.act Y X h (lval X w X (idH X) (ptH X e))) =
      symH (transH ((TL.pr2 X w).1.2 Y X h (idH X) (ptH X e))
             (transH (apH (\ k -> lval X w Y k (compH Y X Iv (ptH X e) h)) (transH (comp-idl Y X h) (symH (comp-idr Y X h))))
                     (apH (\ k -> lval X w Y (compH Y Y X h (idH Y)) k) (ptH-nat Y X h e)))) ;

    mnat (Y X : Ob) (h : Hom Y X) (w : TL.EI X) : Id (TV.EI Y) (mE Y (TL.E.act Y X h w)) (TV.E.act Y X h (mE X w)) =
      apH {TV.T Y (FG.actF Y X h (TL.pr1 X w))} {TV.EI Y} (\ z -> (TV.pr Y (FG.actF Y X h (TL.pr1 X w)) z))
        (TA.pr-inj Y ((FG.ev e).nt Y (FG.actF Y X h (TL.pr1 X w))) _ _
          (calc (TA.EI Y) {
              (TA.pr Y ((FG.ev e).nt Y (FG.actF Y X h (TL.pr1 X w))) (endB Y (TL.E.act Y X h w)))
            =< endB-E Y (TL.E.act Y X h w) >
              lval X w Y (compH Y Y X h (idH Y)) (ptH Y e)
            =< endAct Y X h w >
              TA.E.act Y X h (lval X w X (idH X) (ptH X e))
            =< apH (TA.E.act Y X h) (symH (endB-E X w)) >
              TA.E.act Y X h (TA.pr X ((TL.pr1 X w).1 X (idH X) (ptH X e)) (endB X w))
            =< TA.pr-tact Y X h ((TL.pr1 X w).1 X (idH X) (ptH X e)) ((FG.ev e).nt Y (FG.actF Y X h (TL.pr1 X w)))
                 (ntEq FG.GI G (FG.ev e) Y X h (TL.pr1 X w) (FG.actF Y X h (TL.pr1 X w)) (refl (FG.actF Y X h (TL.pr1 X w)))) (endB X w) >
              (TA.pr Y ((FG.ev e).nt Y (FG.actF Y X h (TL.pr1 X w))) (Aev.tact Y X h (TL.pr1 X w) (FG.actF Y X h (TL.pr1 X w)) (refl (FG.actF Y X h (TL.pr1 X w))) (endB X w))) })) ;

    evA : CPartial[l].PMap[FG.GI, AI, Aev] = new CPartial[l].PMap[FG.GI, AI, Aev, mE, \ X w -> refl (TL.pr1 X w), mnat] ;
  } ;

  ----------------------------------------------------------------------
  -- lines in A from families in E

  lamA (X : Ob) (x : W0.Ix (FG.ob X)) (t : (W : Ob) -> Hom W X -> Hom W Iv -> TA.EI W)
    (tp : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (G.ob W)) (TA.pr1 W (t W f i)) (x.1 W f i))
    (tn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
          -> Id (TA.EI V) (TA.E.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g)))
    : W0.Ix (tobF X x) =
    ((t, tn), FG.fam-eq X (piL X (t, tn)) x tp) ;

  -- an element of TL is determined by its line in E
  tl-norm (X : Ob) (w : TL.EI X) : Id (TL.EI X) (TL.pr X (piL X (TL.pr2 X w).1) ((TL.pr2 X w).1, refl (piL X (TL.pr2 X w).1))) w =
    idJ (W0.Ix (FG.ob X)) (piL X (TL.pr2 X w).1)
      (\ x2 p2 -> Id (TL.EI X) (TL.pr X (piL X (TL.pr2 X w).1) ((TL.pr2 X w).1, refl (piL X (TL.pr2 X w).1))) (TL.pr X x2 ((TL.pr2 X w).1, p2)))
      (refl (TL.pr X (piL X (TL.pr2 X w).1) ((TL.pr2 X w).1, refl (piL X (TL.pr2 X w).1)))) (TL.pr1 X w) (TL.pr2 X w).2 ;

  tl-ext (X : Ob) (w w' : TL.EI X) (q : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI W) (lval X w W f i) (lval X w' W f i))
    : Id (TL.EI X) w w' =
    transH (symH (tl-norm X w))
      (transH (apH (\ L -> (TL.pr X (piL X L) (L, refl (piL X L)))) (FE.fam-eq X (TL.pr2 X w).1 (TL.pr2 X w').1 q)) (tl-norm X w')) ;
} ;

------------------------------------------------------------------------
-- lines along a substitution

module FMap (G1 G2 : PCtx) (m : PSub[G1, G2]) {
  module F1 = FC[G1] ;
  module F2 = FC[G2] ;

  mapF (X : Ob) (x : W0.Ix (F1.ob X)) : W0.Ix (F2.ob X) =
    (\ W f i -> m.nt W (x.1 W f i),
     \ V W g f i -> transH (symH (m.nt-nat V W g (x.1 W f i))) (apH (m.nt V) (x.2 V W g f i))) ;

  mapF-act (Y X : Ob) (h : Hom Y X) (x : W0.Ix (F1.ob X))
    : Id (W0.Ix (F2.ob Y)) (F2.actF Y X h (mapF X x)) (mapF Y (F1.actF Y X h x)) =
    F2.fam-eq Y (F2.actF Y X h (mapF X x)) (mapF Y (F1.actF Y X h x)) (\ W f i -> refl (m.nt W (x.1 W (compH W Y X h f) i))) ;

  map : PSub[F1.GI, F2.GI] = new PSub[F1.GI, F2.GI, mapF, \ Y X h x -> symH (mapF-act Y X h x)] ;
} ;

module SFib (D : PCtx) (B A : PTy[D]) (al : CPartial[l].PMap[D, B, A]) {
  module TA = GPR.TyL[D, A] ;
  module TB = GPR.TyL[D, B] ;

  EA : PCtx = TA.E ;
  EB : PCtx = TB.E ;

  sfOb (X : Ob) (w : TA.EI X) : W0.V = W0.SigV (B.tob X (TA.pr1 X w)) (\ b -> W0.IdV (EA.ob X) (al.mE X (TB.pr X (TA.pr1 X w) b)) w) ;

  -- al commutes with the action, read through the point of the fibre
  sfEq (J I : Ob) (f : Hom J I) (w : TA.EI I) (w' : TA.EI J) (e : Id (TA.EI J) (EA.act J I f w) w')
    (u : W0.Ix (sfOb I w))
    : Id (TA.EI J) (al.mE J (TB.pr J (TA.pr1 J w') (B.tact J I f (TA.pr1 I w) (TA.pr1 J w') (apH (\ z -> (TA.pr1 J z)) e) u.1))) w' =
    calc (TA.EI J) {
        al.mE J (TB.pr J (TA.pr1 J w') (B.tact J I f (TA.pr1 I w) (TA.pr1 J w') (apH (\ z -> (TA.pr1 J z)) e) u.1))
      =< apH (al.mE J) (symH (TB.pr-tact J I f (TA.pr1 I w) (TA.pr1 J w') (apH (\ z -> (TA.pr1 J z)) e) u.1)) >
        al.mE J (EB.act J I f (TB.pr I (TA.pr1 I w) u.1))
      =< al.mnat J I f (TB.pr I (TA.pr1 I w) u.1) >
        EA.act J I f (al.mE I (TB.pr I (TA.pr1 I w) u.1))
      =< apH (EA.act J I f) u.2 >
        EA.act J I f w
      =< e >
        w' } ;

  sfAct : TactTy EA sfOb = \ J I f w w' e u ->
    (B.tact J I f (TA.pr1 I w) (TA.pr1 J w') (apH (\ z -> (TA.pr1 J z)) e) u.1, sfEq J I f w w' e u) ;

  -- elements of a fibre are determined by their B component
  sf-eq (X : Ob) (w : TA.EI X) (u u' : W0.Ix (sfOb X w)) (P : Id (TB.T X (TA.pr1 X w)) u.1 u'.1) : Id (W0.Ix (sfOb X w)) u u' =
    idJ (TB.T X (TA.pr1 X w)) u.1
      (\ b2 E2 -> (q2 : Id (TA.EI X) (al.mE X (TB.pr X (TA.pr1 X w) b2)) w) -> Id (W0.Ix (sfOb X w)) u (b2, q2))
      (\ q2 -> apH {Id (TA.EI X) (al.mE X (TB.pr X (TA.pr1 X w) u.1)) w} {W0.Ix (sfOb X w)} (\ z -> (u.1, z))
                 (W0.isSetIx (EA.ob X) (al.mE X (TB.pr X (TA.pr1 X w) u.1)) w u.2 q2))
      u'.1 P u'.2 ;

  sfId : IdLaw EA sfOb sfAct = \ I w e u ->
    sf-eq I w (sfAct I I (idH I) w w e u) u (B.tact-id I (TA.pr1 I w) (apH (\ z -> (TA.pr1 I z)) e) u.1) ;

  sfO : OLaw EA sfOb sfAct = \ K J I f g w w' w'' e1' e2 e3 u ->
    sf-eq K w'' (sfAct K I (compH K J I f g) w w'' e3 u) (sfAct K J g w' w'' e2 (sfAct J I f w w' e1' u))
      (B.tact-o K J I f g (TA.pr1 I w) (TA.pr1 J w') (TA.pr1 K w'') (apH (\ z -> (TA.pr1 J z)) e1') (apH (\ z -> (TA.pr1 K z)) e2) (apH (\ z -> (TA.pr1 K z)) e3) u.1) ;

  SF : PTy[EA] = (mkTy EA sfOb sfAct sfId sfO) ;
} ;

-- a trivial fibration structure on al: uniform extension in its strict fibres
TrivFib (D : PCtx) (B A : PTy[D]) (al : CPartial[l].PMap[D, B, A]) : U l+ = CPartial[l].ContrOp (extP D A) SFib[D, B, A, al].SF ;

module EndKit (G : PCtx) (A : PTy[G]) (e : IPt) {
  module TA = GPR.TyL[G, A] ;
  module TL = GPR.TyL[FC[G].GI, FT[G, A].AI] ;
  module TV = GPR.TyL[FC[G].GI, FT[G, A].Ev[e].Aev] ;
  module SFm = SFib[FC[G].GI, FT[G, A].AI, FT[G, A].Ev[e].Aev, FT[G, A].Ev[e].evA] ;
  module PT = CPartial[l].Partials[TV.E, SFm.SF] ;
  module TS = GPR.TyL[TV.E, SFm.SF] ;

  -- the line of an element of the fibres
  lineL (W : Ob) (u : TS.EI W) : TL.EI W = (TL.pr W (TV.pr1 W (TS.pr1 W u)) ((TS.pr2 W u).1)) ;

  -- the values of that line
  lv (W : Ob) (u : TS.EI W) (V : Ob) (g : Hom V W) (j : Hom V Iv) : TA.EI V = FT[G, A].lval W (lineL W u) V g j ;

  -- the line of a restricted element is the restricted line
  lineL-act (W' W : Ob) (chi : Hom W' W) (u : TS.EI W) : Id (TL.EI W') (lineL W' (TS.E.act W' W chi u)) (TL.E.act W' W chi (lineL W u)) =
    symH (TL.pr-tact W' W chi (TV.pr1 W (TS.pr1 W u)) (FC[G].GI.act W' W chi (TV.pr1 W (TS.pr1 W u))) (apH (\ z -> (TV.pr1 W' z)) (refl (TV.E.act W' W chi (TS.pr1 W u)))) (TS.pr2 W u).1) ;

  endE (W : Ob) (z : TV.EI W) : TA.EI W = (TA.pr W ((FC[G].ev e).nt W (TV.pr1 W z)) (TV.pr2 W z)) ;

  endE-act (Y X : Ob) (h : Hom Y X) (z : TV.EI X) : Id (TA.EI Y) (endE Y (TV.E.act Y X h z)) (TA.E.act Y X h (endE X z)) =
    symH (TA.pr-tact Y X h ((FC[G].ev e).nt X (TV.pr1 X z)) ((FC[G].ev e).nt Y (FC[G].GI.act Y X h (TV.pr1 X z)))
            (ntEq FC[G].GI G (FC[G].ev e) Y X h (TV.pr1 X z) (FC[G].GI.act Y X h (TV.pr1 X z)) (refl (FC[G].GI.act Y X h (TV.pr1 X z)))) (TV.pr2 X z)) ;

  -- an element over the end is determined by its line and its reading in E
  tv-eq (W : Ob) (z z' : TV.EI W) (p : Id (W0.Ix (FC[G].GI.ob W)) (TV.pr1 W z) (TV.pr1 W z'))
    (q : Id (TA.EI W) (endE W z) (endE W z')) : Id (TV.EI W) z z' =
    idJ (W0.Ix (FC[G].GI.ob W)) (TV.pr1 W z)
      (\ w2 P2 -> (a2 : TV.T W w2) -> Id (TA.EI W) (endE W z) (endE W (TV.pr W w2 a2)) -> Id (TV.EI W) z (TV.pr W w2 a2))
      (\ a2 Q2 -> apH {TV.T W (TV.pr1 W z)} {TV.EI W} (\ v -> (TV.pr W (TV.pr1 W z) v))
                    (TA.pr-inj W ((FC[G].ev e).nt W (TV.pr1 W z)) (TV.pr2 W z) a2 Q2))
      (TV.pr1 W z') p (TV.pr2 W z') q ;

  mkTS (V : Ob) (w : TV.EI V) (L : TL.EI V) (p : Id (W0.Ix (FC[G].GI.ob V)) (TL.pr1 V L) (TV.pr1 V w))
    (q : Id (TA.EI V) (endE V (FT[G, A].Ev[e].evA.mE V L)) (endE V w)) : TS.EI V =
    (TS.pr V w (TL.coeT V (TL.pr1 V L) (TV.pr1 V w) p (TL.pr2 V L),
         tv-eq V (FT[G, A].Ev[e].evA.mE V (TL.pr V (TV.pr1 V w) (TL.coeT V (TL.pr1 V L) (TV.pr1 V w) p (TL.pr2 V L)))) w
           (FT[G, A].Ev[e].evA.mpt V (TL.pr V (TV.pr1 V w) (TL.coeT V (TL.pr1 V L) (TV.pr1 V w) p (TL.pr2 V L))))
           (transH (apH (\ L' -> endE V (FT[G, A].Ev[e].evA.mE V L')) (symH (TL.pr-coe V (TL.pr1 V L) (TV.pr1 V w) p (TL.pr2 V L)))) q))) ;
  mkTS-pt (V : Ob) (w : TV.EI V) (L : TL.EI V) (p : Id (W0.Ix (FC[G].GI.ob V)) (TL.pr1 V L) (TV.pr1 V w))
    (q : Id (TA.EI V) (endE V (FT[G, A].Ev[e].evA.mE V L)) (endE V w)) : Id (TV.EI V) (TS.pr1 V (mkTS V w L p q)) w = refl w ;
  mkTS-line (V : Ob) (w : TV.EI V) (L : TL.EI V) (p : Id (W0.Ix (FC[G].GI.ob V)) (TL.pr1 V L) (TV.pr1 V w))
    (q : Id (TA.EI V) (endE V (FT[G, A].Ev[e].evA.mE V L)) (endE V w)) : Id (TL.EI V) (lineL V (mkTS V w L p q)) L =
    symH (TL.pr-coe V (TL.pr1 V L) (TV.pr1 V w) p (TL.pr2 V L)) ;
  opaque mkTS ;

  -- an element of the fibres is determined by its point and the values of
  -- its line
  ts-ext (W : Ob) (u v : TS.EI W) (p : Id (TV.EI W) (TS.pr1 W u) (TS.pr1 W v))
    (q : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (lv W u V g j) (lv W v V g j))
    : Id (TS.EI W) u v =
    idJ (TV.EI W) (TS.pr1 W u)
      (\ w2 P2 -> (s2 : W0.Ix (SFm.sfOb W w2)) -> Id (TL.EI W) (lineL W u) (TL.pr W (TV.pr1 W w2) s2.1) -> Id (TS.EI W) u (TS.pr W w2 s2))
      (\ s2 Q2 -> apH {W0.Ix (SFm.sfOb W (TS.pr1 W u))} {TS.EI W} (\ z -> (TS.pr W (TS.pr1 W u) z))
                    (SFm.sf-eq W (TS.pr1 W u) (TS.pr2 W u) s2 (TL.pr-inj W (TV.pr1 W (TS.pr1 W u)) (TS.pr2 W u).1 s2.1 Q2)))
      (TS.pr1 W v) p (TS.pr2 W v) (FT[G, A].tl-ext W (lineL W u) (lineL W v) q) ;

  -- elements built by mkTS: equal, and restricted
  mkTS-eq (V : Ob) (w w' : TV.EI V) (L L' : TL.EI V)
    (p : Id (W0.Ix (FC[G].GI.ob V)) (TL.pr1 V L) (TV.pr1 V w)) (q : Id (TA.EI V) (endE V (FT[G, A].Ev[e].evA.mE V L)) (endE V w))
    (p' : Id (W0.Ix (FC[G].GI.ob V)) (TL.pr1 V L') (TV.pr1 V w')) (q' : Id (TA.EI V) (endE V (FT[G, A].Ev[e].evA.mE V L')) (endE V w'))
    (Pw : Id (TV.EI V) w w') (Lv : (V'' : Ob) (f : Hom V'' V) (j : Hom V'' Iv) -> Id (TA.EI V'') (FT[G, A].lval V L V'' f j) (FT[G, A].lval V L' V'' f j))
    : Id (TS.EI V) (mkTS V w L p q) (mkTS V w' L' p' q') =
    ts-ext V (mkTS V w L p q) (mkTS V w' L' p' q') (transH (mkTS-pt V w L p q) (transH Pw (symH (mkTS-pt V w' L' p' q'))))
      (\ V'' f j -> transH (apH (\ M -> FT[G, A].lval V M V'' f j) (mkTS-line V w L p q))
         (transH (Lv V'' f j) (symH (apH (\ M -> FT[G, A].lval V M V'' f j) (mkTS-line V w' L' p' q'))))) ;

  mkTS-act (V' V : Ob) (chi : Hom V' V) (w : TV.EI V) (L : TL.EI V)
    (p : Id (W0.Ix (FC[G].GI.ob V)) (TL.pr1 V L) (TV.pr1 V w)) (q : Id (TA.EI V) (endE V (FT[G, A].Ev[e].evA.mE V L)) (endE V w))
    (w' : TV.EI V') (L' : TL.EI V')
    (p' : Id (W0.Ix (FC[G].GI.ob V')) (TL.pr1 V' L') (TV.pr1 V' w')) (q' : Id (TA.EI V') (endE V' (FT[G, A].Ev[e].evA.mE V' L')) (endE V' w'))
    (Pw : Id (TV.EI V') (TV.E.act V' V chi w) w')
    (Lv : (V'' : Ob) (f : Hom V'' V') (j : Hom V'' Iv) -> Id (TA.EI V'') (FT[G, A].lval V L V'' (compH V'' V' V chi f) j) (FT[G, A].lval V' L' V'' f j))
    : Id (TS.EI V') (TS.E.act V' V chi (mkTS V w L p q)) (mkTS V' w' L' p' q') =
    ts-ext V' (TS.E.act V' V chi (mkTS V w L p q)) (mkTS V' w' L' p' q')
      (transH (apH (TV.E.act V' V chi) (mkTS-pt V w L p q)) (transH Pw (symH (mkTS-pt V' w' L' p' q'))))
      (\ V'' f j -> transH (apH (\ M -> FT[G, A].lval V' M V'' f j) (lineL-act V' V chi (mkTS V w L p q)))
         (transH (apH (\ M -> FT[G, A].lval V M V'' (compH V'' V' V chi f) j) (mkTS-line V w L p q))
           (transH (Lv V'' f j) (symH (apH (\ M -> FT[G, A].lval V' M V'' f j) (mkTS-line V' w' L' p' q')))))) ;

  -- a line is natural at the end point
  lineEnd (V' V : Ob) (f : Hom V' V) (L : TL.EI V)
    : Id (TA.EI V') (FT[G, A].lval V L V' f (ptH V' e)) (TA.E.act V' V f (FT[G, A].lval V L V (idH V) (ptH V e))) =
    symH (transH ((TL.pr2 V L).1.2 V' V f (idH V) (ptH V e))
           (transH (apH (\ k -> FT[G, A].lval V L V' k (compH V' V Iv (ptH V e) f)) (comp-idl V' V f))
                   (apH (\ k -> FT[G, A].lval V L V' f k) (ptH-nat V' V f e)))) ;
} ;

------------------------------------------------------------------------
-- fillers, compositions, fibrations

module Lines (G : PCtx) (A : PTy[G]) {
  module FG = FC[G] ;
  module FA = FT[G, A] ;

  -- filling at e: a partial line with a total end at e extends
  Fill (e : IPt) : U l+ = TrivFib FG.GI FA.AI FA.Ev[e].Aev FA.Ev[e].evA ;

  -- composition from e to e': the same partial lines, an element at e'
  module CompK (e e' : IPt) {
    module EK = EndKit[G, A, e] ;
    module EV' = FA.Ev[e'] ;
    module SE = CSub[l].SubE[EK.TV.E, FG.GI, pP FG.GI FA.Ev[e].Aev, EV'.Aev] ;

    Tend : PTy[EK.TV.E] = subTy EK.TV.E FG.GI EV'.Aev (pP FG.GI FA.Ev[e].Aev) ;

    -- the other end of the line
    endM (W : Ob) (u : EK.TS.EI W) : SE.TS.EI W = (SE.TS.pr W (EK.TS.pr1 W u) (EV'.endB W (EK.lineL W u))) ;

    endN (V W : Ob) (g : Hom V W) (u : EK.TS.EI W) : Id (SE.TS.EI V) (endM V (EK.TS.E.act V W g u)) (SE.TS.E.act V W g (endM W u)) =
      SE.mV-inj V (endM V (EK.TS.E.act V W g u)) (SE.TS.E.act V W g (endM W u)) (refl (EK.TV.E.act V W g (EK.TS.pr1 W u)))
        (transH (apH (EV'.evA.mE V) (EK.lineL-act V W g u))
          (transH (EV'.evA.mnat V W g (EK.lineL W u)) (SE.mV-nat V W g (endM W u)))) ;

    opaque endN ;

    endL : CPartial[l].PMap[EK.TV.E, EK.SFm.SF, Tend] = new CPartial[l].PMap[EK.TV.E, EK.SFm.SF, Tend, endM, \ W u -> refl (EK.TS.pr1 W u), endN] ;

    Comp : U l+ = CPartial[l].Rel[EK.TV.E, EK.SFm.SF, Tend, endL].RC ;

    -- a filler gives a composition: its other end
    fromFill (k : Fill e) : Comp =
      CPartial[l].Post[EK.TV.E, EK.SFm.SF, EK.SFm.SF, Tend, CPartial[l].pmap-id EK.TV.E EK.SFm.SF, endL, endL,
        \ W v -> refl (endM W v), k].rc ;
  } ;

  -- a fibration structure: the two compositions
  Fib : U l+ = CompK[e0, e1].Comp * CompK[e1, e0].Comp ;
} ;
