-- CLocEtaH.seg (L9): Lemma eta-path as a homotopy (localisation.tex §5):
-- eta_DA ~ D eta_A, an element of the path type over G.DA (CLocHtpy.HT).
-- At (x , u) its value at (f , i) : V -> X * [1] is the element pathD of
-- DDA over X * [1] (CLocPath) restricted along <f , i>; the ends are path-0
-- and path-1, the naturality path-nat (CLocPathEnd).  No composition or
-- filling of A is used.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LD = CLocD[a, l] ;
module CH = CLocHtpy[a, l] ;

-- maps into a cylinder
pair-comp (V' V X : Ob) (g : Hom V' V) (f : Hom V X) (i : Hom V Iv)
  : Id (Hom V' (prodP X Iv)) (compH V' V (prodP X Iv) (pairH X Iv V f i) g) (pairH X Iv V' (compH V' V X f g) (compH V' V Iv i g)) =
  hom-eq V' (prodP X Iv) (compH V' V (prodP X Iv) (pairH X Iv V f i) g) (pairH X Iv V' (compH V' V X f g) (compH V' V Iv i g))
    (\ z -> transH (app-compH1 V' V (prodP X Iv) (pairH X Iv V f i) g z)
       (symH (node-eq _ _ _ _ (app-compH1 V' V X f g z) (app-compH1 V' V Iv i g z)))) ;

cyl-pair (V J I : Ob) (h : Hom J I) (f : Hom V J) (i : Hom V Iv)
  : Id (Hom V (prodP I Iv)) (compH V (prodP J Iv) (prodP I Iv) (cylH J I h) (pairH J Iv V f i)) (pairH I Iv V (compH V J I h f) i) =
  hom-eq V (prodP I Iv) (compH V (prodP J Iv) (prodP I Iv) (cylH J I h) (pairH J Iv V f i)) (pairH I Iv V (compH V J I h f) i)
    (\ z -> transH (app-compH1 V (prodP J Iv) (prodP I Iv) (cylH J I h) (pairH J Iv V f i) z)
      (transH (app-cylH1 J I h (app V (prodP J Iv) (pairH J Iv V f i) z))
       (transH (node-eq _ _ _ _
          (apH (\ s -> (app J I h s).1)
             (el-eq J (p1 J Iv (app V (prodP J Iv) (pairH J Iv V f i) z)) (app V J f z)
                (p1-node J Iv (app V (prodP J Iv) (pairH J Iv V f i) z) (app V J f z).1 (app V Iv i z).1
                   (refl (node (app V J f z).1 (app V Iv i z).1)))))
          (p2-node J Iv (app V (prodP J Iv) (pairH J Iv V f i) z) (app V J f z).1 (app V Iv i z).1
             (refl (node (app V J f z).1 (app V Iv i z).1))))
        (symH (node-eq _ _ _ _ (app-compH1 V J I h f z) (refl (app V Iv i z).1)))))) ;

opaque pair-comp ; opaque cyl-pair ;

module EH (G : PCtx) (A : PTy[G]) {
  module D1 = LD.DT[G, A] ;
  module D2 = LD.DT[G, D1.DA] ;
  module DE = LD.DMap[G, A, D1.DA, D1.etaN] ;
  module T = CH.HT[G, D1.DA, D2.DA, D2.etaN, DE.DN] ;
  module LPm = CLocPath[a, l].LP[G, A] ;
  module LE = CLocPathEnd[a, l].LPE[G, A] ;
  module TE = PR.TyL[G, D2.DA] ;
  module EL = PR.PshL[D2.ED] ;
  module GL = PR.PshL[G] ;

  q (X : Ob) (x : W.Ix (G.ob X)) (u : D1.DEl X x) : TE.EI (prodP X Iv) = (LPm.At[X, x, u].rho', LPm.At[X, x, u].pathD) ;

  t (X : Ob) (x : W.Ix (G.ob X)) (u : D1.DEl X x) (V : Ob) (f : Hom V X) (i : Hom V Iv) : TE.EI V =
    D2.ED.act V (prodP X Iv) (pairH X Iv V f i) (q X x u) ;

  tp (X : Ob) (x : W.Ix (G.ob X)) (u : D1.DEl X x) (V : Ob) (f : Hom V X) (i : Hom V Iv)
    : Id (W.Ix (G.ob V)) (t X x u V f i).1 (G.act V X f x) =
    GL.actTri V (prodP X Iv) X (pr1 X Iv) (pairH X Iv V f i) f (pr1-pair X Iv V f i) x ;

  tn (X : Ob) (x : W.Ix (G.ob X)) (u : D1.DEl X x) (V' V : Ob) (g : Hom V' V) (f : Hom V X) (i : Hom V Iv)
    : Id (TE.EI V') (TE.E.act V' V g (t X x u V f i)) (t X x u V' (compH V' V X f g) (compH V' V Iv i g)) =
    transH (EL.actC V' V (prodP X Iv) (pairH X Iv V f i) g (q X x u))
      (EL.actEq V' (prodP X Iv) _ _ (pair-comp V' V X g f i) (q X x u)) ;

  path (X : Ob) (z : W.Ix (T.GA.ob X)) : W.Ix (T.PT.tobP X z) =
    T.PT.mkPath X z (t X z.1 z.2) (tn X z.1 z.2) (tp X z.1 z.2) (LE.Ends[X, z.1, z.2].path-0) (LE.Ends[X, z.1, z.2].path-1) ;

  -- naturality in (x , u): restrict along the cylinder of h (path-nat)
  vnat (J I : Ob) (h : Hom J I) (z : W.Ix (T.GA.ob I)) (V : Ob) (f : Hom V J) (i : Hom V Iv)
    : Id (TE.EI V) (t I z.1 z.2 V (compH V J I h f) i) (t J (T.GA.act J I h z).1 (T.GA.act J I h z).2 V f i) =
    calc (TE.EI V) {
        D2.ED.act V (prodP I Iv) (pairH I Iv V (compH V J I h f) i) (q I z.1 z.2)
      =< symH (EL.actEq V (prodP I Iv) _ _ (cyl-pair V J I h f i) (q I z.1 z.2)) >
        D2.ED.act V (prodP I Iv) (compH V (prodP J Iv) (prodP I Iv) (cylH J I h) (pairH J Iv V f i)) (q I z.1 z.2)
      =< symH (EL.actC V (prodP J Iv) (prodP I Iv) (cylH J I h) (pairH J Iv V f i) (q I z.1 z.2)) >
        D2.ED.act V (prodP J Iv) (pairH J Iv V f i) (D2.ED.act (prodP J Iv) (prodP I Iv) (cylH J I h) (q I z.1 z.2))
      =< apH (D2.ED.act V (prodP J Iv) (pairH J Iv V f i)) LE.Nat'[J, I, h, z.1, z.2].path-nat >
        t J (T.GA.act J I h z).1 (T.GA.act J I h z).2 V f i } ;

  enat (J I : Ob) (h : Hom J I) (z : W.Ix (T.GA.ob I)) (z' : W.Ix (T.GA.ob J)) (e : Id (W.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (W.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    idJ (W.Ix (T.GA.ob J)) (T.GA.act J I h z)
      (\ z2 e2 -> Id (W.Ix (T.PT.tobP J z2)) (T.PT.PathP.tact J I h z z2 e2 (path I z)) (path J z2))
      (T.PT.path-eq J (T.GA.act J I h z) (T.PT.PathP.tact J I h z (T.GA.act J I h z) (refl (T.GA.act J I h z)) (path I z))
         (path J (T.GA.act J I h z)) (\ V f i -> vnat J I h z V f i))
      z' e ;

  opaque tp ; opaque tn ; opaque vnat ; opaque enat ;

  -- Lemma eta-path: eta_DA ~ D eta_A
  res : PEl[T.GA, T.PT.PathP] = new PEl[T.GA, T.PT.PathP, path, enat] ;
} ;
