-- CGlueE.seg (L5, inside CB): the equivalence component of the glue data
-- (model.tex Def "glue data", the component e).  For data d at stage I
-- (CGlueD), the restricted representable RC(I , ph) of its sieve and the
-- triple (Bt , At , al) over it derived from d's codes.
--
-- Quarry: seg/model GGlueE (RCm, Tr).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;

-- the extent is stable under restriction
fl-act (I : Ob) (ph : Phi I) (Y' Y : Ob) (k : Hom Y' Y) (h : Hom Y I) (q : IsT (CGlueD.fl I ph Y h))
  : IsT (CGlueD.fl I ph Y' (compH Y' Y I h k)) =
  CEnc.landsChi Y' I ph (compH Y' Y I h k) (lands-comp Y' Y I ph h k (CEnc.chiLands Y I ph h q)) ;

opaque fl-act ;

-- the restricted representable: maps into I in the extent
module RCm (I : Ob) (ph : Phi I) {
  ob (Y : Ob) : W0.V = W0.SigV (homV Y I) (\ h -> W0.IsTV (CGlueD.fl I ph Y h)) ;

  act (Y' Y : Ob) (k : Hom Y' Y) (x : W0.Ix (ob Y)) : W0.Ix (ob Y') = (compH Y' Y I x.1 k, fl-act I ph Y' Y k x.1 x.2) ;

  pt-eq (Y : Ob) (x x' : W0.Ix (ob Y)) (P : Id (Hom Y I) x.1 x'.1) : Id (W0.Ix (ob Y)) x x' =
    Sigma-eq (Hom Y I) (\ h -> IsT (CGlueD.fl I ph Y h)) x.1 x'.1 x.2 x'.2 P (isProp-IsT' (CGlueD.fl I ph Y x'.1)) ;

  act-id (Y : Ob) (x : W0.Ix (ob Y)) : Id (W0.Ix (ob Y)) (act Y Y (idH Y) x) x = pt-eq Y (act Y Y (idH Y) x) x (comp-idr Y I x.1) ;

  act-o (Z Y' Y : Ob) (k : Hom Y' Y) (k' : Hom Z Y') (x : W0.Ix (ob Y))
    : Id (W0.Ix (ob Z)) (act Z Y (compH Z Y' Y k k') x) (act Z Y' k' (act Y' Y k x)) =
    pt-eq Z (act Z Y (compH Z Y' Y k k') x) (act Z Y' k' (act Y' Y k x)) (symH (comp-assoc Z Y' Y I x.1 k k')) ;

  opaque act-id ; opaque act-o ;

  RC : PCtx = new PCtx[ob, act, act-id, act-o] ;

  inclRC : PSub[RC, yP I] = new PSub[RC, yP I, \ Y x -> x.1, \ Y' Y k x -> refl (compH Y' Y I x.1 k)] ;
} ;

module GE (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;

  ----------------------------------------------------------------------
  -- the triple of data d at stage I, over RC

  -- El along the B-codes of glue data, over RC (depends on B and bn only)
  BtOf (I : Ob) (ph : Phi I) (B : DD.BTy I ph) (bn : DD.BNat I ph B) : PTy[RCm[I, ph].RC] =
    mkTy RCm[I, ph].RC (\ Y x -> UU.fib0 Y (B Y x.1 x.2))
      (\ Y' Y k x y e b -> UU.tactG Y' Y k (B Y x.1 x.2) (B Y' y.1 y.2) (bn Y' Y k x.1 x.2 y.1 (apH (\ z -> z.1) e) y.2) b)
      (\ Y x e b -> UU.tidC Y (B Y x.1 x.2) (bn Y Y (idH Y) x.1 x.2 x.1 (apH (\ z -> z.1) e) x.2) b)
      (\ K J I0 f g x y z e1' e2 e3 b -> UU.toC K J I0 f g (B I0 x.1 x.2) (B J y.1 y.2) (B K z.1 z.2)
         (bn J I0 f x.1 x.2 y.1 (apH (\ w -> w.1) e1') y.2) (bn K J g y.1 y.2 z.1 (apH (\ w -> w.1) e2) z.2)
         (bn K I0 (compH K J I0 f g) x.1 x.2 z.1 (apH (\ w -> w.1) e3) z.2) b) ;

  module Tr (I : Ob) (A : UU.U0 I) (ph : Phi I) (bd : DD.BD I A ph) {
    module R = RCm[I, ph] ;

    Bt : PTy[R.RC] = BtOf I ph bd.1 bd.2.1 ;

    At : PTy[R.RC] = subTy R.RC (yP I) A.1 R.inclRC ;

    module TBt = GPR.TyL[R.RC, Bt] ;
    module TAt = GPR.TyL[R.RC, At] ;

    alE (Y : Ob) (w : TBt.EI Y) : TAt.EI Y = (w.1, bd.2.2.1 Y w.1.1 w.1.2 w.2) ;

    alN (Y' Y : Ob) (k : Hom Y' Y) (w : TBt.EI Y) : Id (TAt.EI Y') (alE Y' (TBt.E.act Y' Y k w)) (TAt.E.act Y' Y k (alE Y w)) =
      apH {W0.Ix (A.1.tob Y' (compH Y' Y I w.1.1 k))} {TAt.EI Y'} (\ z -> (R.act Y' Y k w.1, z))
        (transH (bd.2.2.2 Y' Y k w.1.1 w.1.2 (compH Y' Y I w.1.1 k) (apH (\ z -> z.1) (refl (R.act Y' Y k w.1))) (fl-act I ph Y' Y k w.1.1 w.1.2) w.2)
           (tact-irr (yP I) A.1 Y' Y k w.1.1 (compH Y' Y I w.1.1 k) (apH (\ z -> z.1) (refl (R.act Y' Y k w.1)))
              (ntEq R.RC (yP I) R.inclRC Y' Y k w.1 (R.act Y' Y k w.1) (refl (R.act Y' Y k w.1))) (bd.2.2.1 Y w.1.1 w.1.2 w.2))) ;

    al : CPartial[a].PMap[R.RC, Bt, At] = new CPartial[a].PMap[R.RC, Bt, At, alE, \ Y w -> refl w.1, alN] ;

  } ;

  ----------------------------------------------------------------------
  -- the lift of RC along h

  lift (J I : Ob) (h : Hom J I) (ph : Phi I) : PSub[RCm[J, pre J I h ph].RC, RCm[I, ph].RC] =
    new PSub[RCm[J, pre J I h ph].RC, RCm[I, ph].RC,
      \ Y x -> (compH Y J I h x.1, CGlueD.fl-pre J I h ph Y x.1 x.2),
      \ Y' Y k x -> RCm[I, ph].pt-eq Y' _ _ (symH (comp-assoc Y' Y J I h x.1 k))] ;

  ----------------------------------------------------------------------
  -- the cart of triples over the lift: the triple of d h maps to the
  -- triple of d, the identity on fibres

  module Chi (J I : Ob) (h : Hom J I) (d : DD.GD0 I) {
    module M = DD.Act[J, I, h, d.1, d.2.1, d.2.2] ;
    module T0 = Tr[I, d.1, d.2.1, d.2.2] ;
    module T1 = Tr[J, M.A', M.ph', M.res.2.2] ;

    sl : PSub[T1.R.RC, T0.R.RC] = lift J I h d.2.1 ;

    eL (V W : Ob) (g : Hom V W) (x : W0.Ix (T1.R.RC.ob W)) : Id (W0.Ix (T0.R.RC.ob V)) (T0.R.RC.act V W g (sl.nt W x)) (sl.nt V (T1.R.RC.act V W g x)) =
      symH (sl.nt-nat V W g x) ;

    tA (W : Ob) (v : T1.TAt.EI W) : T0.TAt.EI W = (sl.nt W v.1, v.2) ;

    tAnat (V W : Ob) (g : Hom V W) (v : T1.TAt.EI W) : Id (T0.TAt.EI V) (T0.TAt.E.act V W g (tA W v)) (tA V (T1.TAt.E.act V W g v)) =
      transH (T0.TAt.pr-tact V W g (sl.nt W v.1) (sl.nt V (T1.R.RC.act V W g v.1)) (eL V W g v.1) v.2)
        (apH {W0.Ix (d.1.1.tob V (sl.nt V (T1.R.RC.act V W g v.1)).1)} {T0.TAt.EI V} (\ z -> (sl.nt V (T1.R.RC.act V W g v.1), z))
          (tact-irr (yP I) d.1.1 V W g (sl.nt W v.1).1 (sl.nt V (T1.R.RC.act V W g v.1)).1
             (ntEq T0.R.RC (yP I) T0.R.inclRC V W g (sl.nt W v.1) (sl.nt V (T1.R.RC.act V W g v.1)) (eL V W g v.1))
             (ntEq (yP J) (yP I) (yH J I h) V W g v.1.1 (T1.R.RC.act V W g v.1).1
                (ntEq T1.R.RC (yP J) T1.R.inclRC V W g v.1 (T1.R.RC.act V W g v.1) (refl (T1.R.RC.act V W g v.1))))
             v.2)) ;

    tAinj (W : Ob) (v v' : T1.TAt.EI W) (P : Id (W0.Ix (T1.R.RC.ob W)) v.1 v'.1) (Q : Id (T0.TAt.EI W) (tA W v) (tA W v'))
      : Id (T1.TAt.EI W) v v' =
      idJ (W0.Ix (T1.R.RC.ob W)) v.1
        (\ x2 P2 -> (b2 : W0.Ix (T1.At.tob W x2)) -> Id (T0.TAt.EI W) (tA W v) (sl.nt W x2, b2) -> Id (T1.TAt.EI W) v (x2, b2))
        (\ b2 Q2 -> apH {W0.Ix (T1.At.tob W v.1)} {T1.TAt.EI W} (\ z -> (v.1, z)) (T0.TAt.pr-inj W (sl.nt W v.1) v.2 b2 Q2))
        v'.1 P v'.2 Q ;

    tB (W : Ob) (v : T1.TBt.EI W) : T0.TBt.EI W = (sl.nt W v.1, v.2) ;

    tBnat (V W : Ob) (g : Hom V W) (v : T1.TBt.EI W) : Id (T0.TBt.EI V) (T0.TBt.E.act V W g (tB W v)) (tB V (T1.TBt.E.act V W g v)) =
      transH (T0.TBt.pr-tact V W g (sl.nt W v.1) (sl.nt V (T1.R.RC.act V W g v.1)) (eL V W g v.1) v.2)
        (apH {W0.Ix (T0.Bt.tob V (sl.nt V (T1.R.RC.act V W g v.1)))} {T0.TBt.EI V} (\ z -> (sl.nt V (T1.R.RC.act V W g v.1), z))
          (CSmall.tact-irr UU.UCtx UU.El V W g (d.2.2.1 W (sl.nt W v.1).1 (sl.nt W v.1).2)
             (d.2.2.1 V (sl.nt V (T1.R.RC.act V W g v.1)).1 (sl.nt V (T1.R.RC.act V W g v.1)).2)
             (d.2.2.2.1 V W g (sl.nt W v.1).1 (sl.nt W v.1).2 (sl.nt V (T1.R.RC.act V W g v.1)).1
                (apH (\ z -> z.1) (eL V W g v.1)) (sl.nt V (T1.R.RC.act V W g v.1)).2)
             (M.bn' V W g v.1.1 v.1.2 (T1.R.RC.act V W g v.1).1 (apH (\ z -> z.1) (refl (T1.R.RC.act V W g v.1))) (T1.R.RC.act V W g v.1).2)
             v.2)) ;

    tBinj (W : Ob) (v v' : T1.TBt.EI W) (P : Id (W0.Ix (T1.R.RC.ob W)) v.1 v'.1) (Q : Id (T0.TBt.EI W) (tB W v) (tB W v'))
      : Id (T1.TBt.EI W) v v' =
      idJ (W0.Ix (T1.R.RC.ob W)) v.1
        (\ x2 P2 -> (b2 : W0.Ix (T1.Bt.tob W x2)) -> Id (T0.TBt.EI W) (tB W v) (sl.nt W x2, b2) -> Id (T1.TBt.EI W) v (x2, b2))
        (\ b2 Q2 -> apH {W0.Ix (T1.Bt.tob W v.1)} {T1.TBt.EI W} (\ z -> (v.1, z)) (T0.TBt.pr-inj W (sl.nt W v.1) v.2 b2 Q2))
        v'.1 P v'.2 Q ;

    opaque tAnat ; opaque tAinj ; opaque tBnat ; opaque tBinj ;

    module H = CHFibCart[a, a].HCart[T1.R.RC, T1.Bt, T1.At, T1.al, T0.R.RC, T0.Bt, T0.At, T0.al, sl.nt, sl.nt-nat,
      tA, \ W v -> refl (sl.nt W v.1), tAnat, tAinj, \ X x u -> u, \ X x u -> refl (sl.nt X x, u),
      tB, \ W v -> refl (sl.nt W v.1), tBnat, tBinj, \ X x u -> u, \ X x u -> refl (sl.nt X x, u),
      \ W v -> refl (tA W (T1.al.mE W v))] ;
  } ;

  ----------------------------------------------------------------------
  -- glue data with an equivalence structure, and the action

  EqOn (I : Ob) (d : DD.GD0 I) : U a+ = CEquiv[a].EquivOp RCm[I, d.2.1].RC Tr[I, d.1, d.2.1, d.2.2].Bt Tr[I, d.1, d.2.1, d.2.2].At Tr[I, d.1, d.2.1, d.2.2].al ;

  GD1 (I : Ob) : U a+ = (d : DD.GD0 I) * EqOn I d ;

  act1 (J I : Ob) (h : Hom J I) (D : GD1 I) : GD1 J = (DD.gdAct J I h D.1, Chi[J, I, h, D.1].H.moveEq D.2) ;
} ;
