-- CExt3.seg (L5, inside CB; quarry seg/model GExt3, was Ext3.seg): MODEL/Poset/Ext.agda, part 3.  The total presheaf EX of Ext and
-- its elements of either form: fromB (an element of B), fromP (a pair),
-- toB, toP, and the action of EX on each form (actX-B, actX-PB, actX-PP),
-- so that the definition by cases is never unfolded downstream; the fibre
-- of Ext at a full / non-full point (extOb-B, extOb-P) and caseFull.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
open VCode[l] ;
module GP = CCof[l] ;

-- a proposition is a set
prop-set (P : U l) (pP : isProp P) : isSet P = \ x y p q ->
  transH (psL P pP x y p) (symH (psL P pP x y q))
 where {
  psL (P1 : U l) (pP1 : isProp P1) (x1 y1 : P1) (p1 : Id P1 x1 y1)
    : Id (Id P1 x1 y1) p1 (trans P1 x1 x1 y1 (sym P1 x1 x1 (pP1 x1 x1)) (pP1 x1 y1)) =
    idJ P1 x1 (\ y2 p2 -> Id (Id P1 x1 y2) p2 (trans P1 x1 x1 y2 (sym P1 x1 x1 (pP1 x1 x1)) (pP1 x1 y2)))
      (symH (trans-sym-l P1 x1 x1 (pP1 x1 x1))) y1 p1 ;
 } ;

module ExtB3 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR]) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;

  module TX = PR.TyL[G, ExtT] ;

  EX : PCtx = TX.E ;

  -- transport of a value of B along an equation of extent proofs
  substq (X : Ob) (rho : W0.Ix (G.ob X)) (q q' : IsT (full X rho)) (P : Id (IsT (full X rho)) q q') (b : TB.T X (rho, q)) : TB.T X (rho, q') =
    subst (IsT (full X rho)) (\ z -> TB.T X (rho, z)) q q' P b ;

  pp (X : Ob) (rho : W0.Ix (G.ob X)) (q q' : IsT (full X rho)) : Id (IsT (full X rho)) q q' = isProp-IsT' (full X rho) q q' ;

  inB' (X : Ob) (rho : W0.Ix (G.ob X)) : (c : Bool) (e : Id Bool (full X rho) c) (p : IsT (full X rho)) -> TB.T X (rho, p) -> W0.Ix (ExtV X rho c e) = split {
    true -> \ e p b -> substq X rho p e (pp X rho p e) b ;
    false -> \ e p b -> absurd _ (false-true (transH (symH e) p)) } ;

  outB' (X : Ob) (rho : W0.Ix (G.ob X)) : (c : Bool) (e : Id Bool (full X rho) c) (p : IsT (full X rho)) -> W0.Ix (ExtV X rho c e) -> TB.T X (rho, p) = split {
    true -> \ e p u -> substq X rho e p (pp X rho e p) u ;
    false -> \ e p u -> absurd _ (false-true (transH (symH e) p)) } ;

  inP' (X : Ob) (rho : W0.Ix (G.ob X)) : (c : Bool) (e : Id Bool (full X rho) c) (np : Id Bool (full X rho) false) -> Pairs X rho -> W0.Ix (ExtV X rho c e) = split {
    true -> \ e np u -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e np u -> u } ;

  outP' (X : Ob) (rho : W0.Ix (G.ob X)) : (c : Bool) (e : Id Bool (full X rho) c) (np : Id Bool (full X rho) false) -> W0.Ix (ExtV X rho c e) -> Pairs X rho = split {
    true -> \ e np u -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e np u -> u } ;

  fromB (X : Ob) (w : TB.EI X) : TX.EI X = (w.1.1, inB' X w.1.1 (full X w.1.1) (refl (full X w.1.1)) w.1.2 w.2) ;

  toB (X : Ob) (v : TX.EI X) (p : IsT (full X v.1)) : TB.EI X = ((v.1, p), outB' X v.1 (full X v.1) (refl (full X v.1)) p v.2) ;

  fromP (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho) : TX.EI X =
    (rho, inP' X rho (full X rho) (refl (full X rho)) np u) ;

  toP (X : Ob) (v : TX.EI X) (np : Id Bool (full X v.1) false) : Pairs X v.1 = outP' X v.1 (full X v.1) (refl (full X v.1)) np v.2 ;

  ioAux (X : Ob) (rho : W0.Ix (G.ob X)) (e p : IsT (full X rho)) (u : TB.T X (rho, e))
    : Id (TB.T X (rho, e)) (substq X rho p e (pp X rho p e) (substq X rho e p (pp X rho e p) u)) u =
    idJ (IsT (full X rho)) e
      (\ p2 P2 -> (P' : Id (IsT (full X rho)) p2 e) -> Id (TB.T X (rho, e)) (substq X rho p2 e P' (substq X rho e p2 P2 u)) u)
      (\ P' -> apH (\ z -> substq X rho e e z u) (prop-set (IsT (full X rho)) (isProp-IsT' (full X rho)) e e P' (refl e)))
      p (pp X rho e p) (pp X rho p e) ;

  io-B (X : Ob) (rho : W0.Ix (G.ob X))
    : (c : Bool) (e : Id Bool (full X rho) c) (p : IsT (full X rho)) (u : W0.Ix (ExtV X rho c e))
      -> Id (W0.Ix (ExtV X rho c e)) (inB' X rho c e p (outB' X rho c e p u)) u = split {
    true -> \ e p u -> ioAux X rho e p u ;
    false -> \ e p u -> absurd _ (false-true (transH (symH e) p)) } ;

  oi-B (X : Ob) (rho : W0.Ix (G.ob X))
    : (c : Bool) (e : Id Bool (full X rho) c) (p : IsT (full X rho)) (b : TB.T X (rho, p))
      -> Id (TB.T X (rho, p)) (outB' X rho c e p (inB' X rho c e p b)) b = split {
    true -> \ e p b -> ioAux X rho p e b ;
    false -> \ e p b -> absurd _ (false-true (transH (symH e) p)) } ;

  io-P (X : Ob) (rho : W0.Ix (G.ob X))
    : (c : Bool) (e : Id Bool (full X rho) c) (np : Id Bool (full X rho) false) (u : W0.Ix (ExtV X rho c e))
      -> Id (W0.Ix (ExtV X rho c e)) (inP' X rho c e np (outP' X rho c e np u)) u = split {
    true -> \ e np u -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e np u -> refl u } ;

  fromB-toB (X : Ob) (v : TX.EI X) (p : IsT (full X v.1)) : Id (TX.EI X) (fromB X (toB X v p)) v =
    apH {W0.Ix (extOb X v.1)} {TX.EI X} (\ z -> (v.1, z)) (io-B X v.1 (full X v.1) (refl (full X v.1)) p v.2) ;

  toB-fromB (X : Ob) (w : TB.EI X) : Id (TB.EI X) (toB X (fromB X w) w.1.2) w =
    apH {TB.T X w.1} {TB.EI X} (\ z -> (w.1, z)) (oi-B X w.1.1 (full X w.1.1) (refl (full X w.1.1)) w.1.2 w.2) ;

  fromP-toP (X : Ob) (v : TX.EI X) (np : Id Bool (full X v.1) false) : Id (TX.EI X) (fromP X v.1 np (toP X v np)) v =
    apH {W0.Ix (extOb X v.1)} {TX.EI X} (\ z -> (v.1, z)) (io-P X v.1 (full X v.1) (refl (full X v.1)) np v.2) ;

  tpAux (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    : (c : Bool) (e : Id Bool (full X rho) c) -> Id (Pairs X rho) (outP' X rho c e np (inP' X rho c e np u)) u = split {
    true -> \ e -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> refl u } ;

  toP-fromP (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    : Id (Pairs X rho) (toP X (fromP X rho np u) np) u = tpAux X rho np u (full X rho) (refl (full X rho)) ;

  -- case analysis on the extent
  toB-cong (X : Ob) (v v' : TX.EI X) (P : Id (TX.EI X) v v') (p : IsT (full X v.1)) (p' : IsT (full X v'.1))
    : Id (TB.EI X) (toB X v p) (toB X v' p') =
    idJ (TX.EI X) v (\ v2 P2 -> (p2 : IsT (full X v2.1)) -> Id (TB.EI X) (toB X v p) (toB X v2 p2))
      (\ p2 -> apH (toB X v) (isProp-IsT' (full X v.1) p p2)) v' P p' ;

  fromB-inj (X : Ob) (w w' : TB.EI X) (P : Id (TX.EI X) (fromB X w) (fromB X w')) : Id (TB.EI X) w w' =
    transH (symH (toB-fromB X w)) (transH (toB-cong X (fromB X w) (fromB X w') P w.1.2 w'.1.2) (toB-fromB X w')) ;

  ----------------------------------------------------------------------
  -- The action of EX on each form

  axB (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho)) (b : TB.T X (rho, p))
    : (c : Bool) (e : Id Bool (full X rho) c) (c' : Bool) (e' : Id Bool (full Y (G.act Y X h rho)) c')
      -> Id (W0.Ix (ExtV Y (G.act Y X h rho) c' e'))
            (TA2[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].tactS c e c' e' (inB' X rho c e p b))
            (inB' Y (G.act Y X h rho) c' e' (full-act Y X h rho p) (B.tact Y X h (rho, p) (G'.act Y X h (rho, p)) (refl (G'.act Y X h (rho, p))) b)) = split {
    true -> \ e -> split {
      true -> \ e' ->
        idJ (IsT (full X rho)) p
          (\ e2 P2 -> (e3 : IsT (full Y (G.act Y X h rho))) (P3 : Id (IsT (full Y (G.act Y X h rho))) (full-act Y X h rho p) e3)
             -> Id (TB.T Y (G.act Y X h rho, e3))
                   (B.tact Y X h (rho, e2) (G.act Y X h rho, e3) (res-eq Y (G'.act Y X h (rho, e2)) (G.act Y X h rho, e3) (refl (G.act Y X h rho)))
                      (substq X rho p e2 P2 b))
                   (substq Y (G.act Y X h rho) (full-act Y X h rho p) e3 P3 (B.tact Y X h (rho, p) (G'.act Y X h (rho, p)) (refl (G'.act Y X h (rho, p))) b)))
          (\ e3 P3 ->
             idJ (IsT (full Y (G.act Y X h rho))) (full-act Y X h rho p)
               (\ e4 P4 -> Id (TB.T Y (G.act Y X h rho, e4))
                              (B.tact Y X h (rho, p) (G.act Y X h rho, e4) (res-eq Y (G'.act Y X h (rho, p)) (G.act Y X h rho, e4) (refl (G.act Y X h rho))) b)
                              (substq Y (G.act Y X h rho) (full-act Y X h rho p) e4 P4 (B.tact Y X h (rho, p) (G'.act Y X h (rho, p)) (refl (G'.act Y X h (rho, p))) b)))
               (tact-irr G' B Y X h (rho, p) (G'.act Y X h (rho, p))
                  (res-eq Y (G'.act Y X h (rho, p)) (G'.act Y X h (rho, p)) (refl (G.act Y X h rho))) (refl (G'.act Y X h (rho, p))) b)
               e3 P3)
          e (pp X rho p e) e' (pp Y (G.act Y X h rho) (full-act Y X h rho p) e') ;
      false -> \ e' -> absurd _ (tf-absurd Y X h rho (G.act Y X h rho) (refl (G.act Y X h rho)) e e') } ;
    false -> \ e c' e' -> absurd _ (false-true (transH (symH e) p)) } ;

  actX-B (Y X : Ob) (h : Hom Y X) (w : TB.EI X) : Id (TX.EI Y) (EX.act Y X h (fromB X w)) (fromB Y (EB.act Y X h w)) =
    apH {W0.Ix (extOb Y (G.act Y X h w.1.1))} {TX.EI Y} (\ z -> (G.act Y X h w.1.1, z))
      (axB Y X h w.1.1 w.1.2 w.2 (full X w.1.1) (refl (full X w.1.1)) (full Y (G.act Y X h w.1.1)) (refl (full Y (G.act Y X h w.1.1)))) ;

  axPB (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho) (q : IsT (full Y (G.act Y X h rho)))
    : (c : Bool) (e : Id Bool (full X rho) c) (c' : Bool) (e' : Id Bool (full Y (G.act Y X h rho)) c')
      -> Id (W0.Ix (ExtV Y (G.act Y X h rho) c' e'))
            (TA2[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].tactS c e c' e' (inP' X rho c e np u))
            (inB' Y (G.act Y X h rho) c' e' q (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].toBv q u)) = split {
    true -> \ e c' e' -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> split {
      false -> \ e' -> absurd _ (false-true (transH (symH e') q)) ;
      true -> \ e' ->
        idJ (IsT (full Y (G.act Y X h rho))) q
          (\ e2 P2 -> Id (TB.T Y (G.act Y X h rho, e2)) (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].toBv e2 u)
                         (substq Y (G.act Y X h rho) q e2 P2 (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].toBv q u)))
          (refl (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].toBv q u))
          e' (pp Y (G.act Y X h rho) q e') } } ;

  actX-PB (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    (q : IsT (full Y (G.act Y X h rho))) : Id (TX.EI Y) (EX.act Y X h (fromP X rho np u)) (fromB Y (pb X rho u Y h q)) =
    transH (apH {W0.Ix (extOb Y (G.act Y X h rho))} {TX.EI Y} (\ z -> (G.act Y X h rho, z))
              (axPB Y X h rho np u q (full X rho) (refl (full X rho)) (full Y (G.act Y X h rho)) (refl (full Y (G.act Y X h rho)))))
           (apH (fromB Y) (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].toBv-E q u q)) ;

  axPP (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    (np' : Id Bool (full Y (G.act Y X h rho)) false)
    : (c : Bool) (e : Id Bool (full X rho) c) (c' : Bool) (e' : Id Bool (full Y (G.act Y X h rho)) c')
      -> Id (W0.Ix (ExtV Y (G.act Y X h rho) c' e'))
            (TA2[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].tactS c e c' e' (inP' X rho c e np u))
            (inP' Y (G.act Y X h rho) c' e' np' (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].pact u)) = split {
    true -> \ e c' e' -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> split {
      true -> \ e' -> absurd _ (false-true (transH (symH np') e')) ;
      false -> \ e' -> refl (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].pact u) } } ;

  actX-PP (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    (np' : Id Bool (full Y (G.act Y X h rho)) false)
    : Id (TX.EI Y) (EX.act Y X h (fromP X rho np u))
                   (fromP Y (G.act Y X h rho) np' (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].pact u)) =
    apH {W0.Ix (extOb Y (G.act Y X h rho))} {TX.EI Y} (\ z -> (G.act Y X h rho, z))
      (axPP Y X h rho np u np' (full X rho) (refl (full X rho)) (full Y (G.act Y X h rho)) (refl (full Y (G.act Y X h rho)))) ;

  -- toB commutes with the actions
  toB-act (Y X : Ob) (h : Hom Y X) (v : TX.EI X) (p : IsT (full X v.1)) (p' : IsT (full Y (EX.act Y X h v).1))
    : Id (TB.EI Y) (toB Y (EX.act Y X h v) p') (EB.act Y X h (toB X v p)) =
    transH (toB-cong Y (EX.act Y X h v) (fromB Y (EB.act Y X h (toB X v p)))
              (transH (apH (EX.act Y X h) (symH (fromB-toB X v p))) (actX-B Y X h (toB X v p))) p'
              (EB.act Y X h (toB X v p)).1.2)
           (toB-fromB Y (EB.act Y X h (toB X v p))) ;

  -- at a full point, the fibre of Ext is the fibre of B, and the transport
  -- along this identification is toB
  eBAux (X : Ob) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho)) : (c : Bool) (e : Id Bool (full X rho) c) -> Id W0.V (ExtV X rho c e) (B.tob X (rho, p)) = split {
    true -> \ e -> apH (\ z -> B.tob X (rho, z)) (pp X rho e p) ;
    false -> \ e -> absurd _ (false-true (transH (symH e) p)) } ;

  extOb-B (X : Ob) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho)) : Id W0.V (extOb X rho) (B.tob X (rho, p)) =
    eBAux X rho p (full X rho) (refl (full X rho)) ;

  substAp (X : Ob) (rho : W0.Ix (G.ob X)) (q q' : IsT (full X rho)) (P : Id (IsT (full X rho)) q q') (b : TB.T X (rho, q))
    : Id (TB.T X (rho, q')) (substIx (B.tob X (rho, q)) (B.tob X (rho, q')) (apH (\ z -> B.tob X (rho, z)) P) b) (substq X rho q q' P b) =
    idJ (IsT (full X rho)) q
      (\ q2 P2 -> Id (TB.T X (rho, q2)) (substIx (B.tob X (rho, q)) (B.tob X (rho, q2)) (apH (\ z -> B.tob X (rho, z)) P2) b) (substq X rho q q2 P2 b))
      (refl b) q' P ;

  ebsAux (X : Ob) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho))
    : (c : Bool) (e : Id Bool (full X rho) c) (u : W0.Ix (ExtV X rho c e)) (P : Id W0.V (ExtV X rho c e) (B.tob X (rho, p)))
      -> Id (TB.T X (rho, p)) (substIx (ExtV X rho c e) (B.tob X (rho, p)) P u) (outB' X rho c e p u) = split {
    true -> \ e u P ->
      transH (apH (\ P' -> substIx (B.tob X (rho, e)) (B.tob X (rho, p)) P' u)
                  (W0.isSetV (B.tob X (rho, e)) (B.tob X (rho, p)) P (apH (\ z -> B.tob X (rho, z)) (pp X rho e p))))
             (substAp X rho e p (pp X rho e p) u) ;
    false -> \ e u P -> absurd _ (false-true (transH (symH e) p)) } ;

  extOb-B-sub (X : Ob) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho)) (u : W0.Ix (extOb X rho))
    : Id (TB.T X (rho, p)) (substIx (extOb X rho) (B.tob X (rho, p)) (extOb-B X rho p) u) (toB X (rho, u) p).2 =
    ebsAux X rho p (full X rho) (refl (full X rho)) u (extOb-B X rho p) ;

  -- at a non-full point, the fibre of Ext is Pairs, and the transport is toP
  ePAux (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false)
    : (c : Bool) (e : Id Bool (full X rho) c) -> Id W0.V (ExtV X rho c e) (pairsV X rho) = split {
    true -> \ e -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> refl (pairsV X rho) } ;

  extOb-P (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) : Id W0.V (extOb X rho) (pairsV X rho) =
    ePAux X rho np (full X rho) (refl (full X rho)) ;

  epsAux (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false)
    : (c : Bool) (e : Id Bool (full X rho) c) (u : W0.Ix (ExtV X rho c e)) (P : Id W0.V (ExtV X rho c e) (pairsV X rho))
      -> Id (Pairs X rho) (substIx (ExtV X rho c e) (pairsV X rho) P u) (outP' X rho c e np u) = split {
    true -> \ e u P -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e u P -> substV-irr (pairsV X rho) (pairsV X rho) P (refl (pairsV X rho)) u } ;

  extOb-P-sub (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : W0.Ix (extOb X rho))
    : Id (Pairs X rho) (substIx (extOb X rho) (pairsV X rho) (extOb-P X rho np) u) (toP X (rho, u) np) =
    epsAux X rho np (full X rho) (refl (full X rho)) u (extOb-P X rho np) ;

  cfAux (X : Ob) (rho : W0.Ix (G.ob X)) (R : U l+) (k1 : IsT (full X rho) -> R) (k2 : Id Bool (full X rho) false -> R)
    : (c : Bool) -> Id Bool (full X rho) c -> R = split {
    true -> \ e -> k1 e ;
    false -> \ e -> k2 e } ;

  caseFull (X : Ob) (rho : W0.Ix (G.ob X)) (R : U l+) (k1 : IsT (full X rho) -> R) (k2 : Id Bool (full X rho) false -> R) : R =
    cfAux X rho R k1 k2 (full X rho) (refl (full X rho)) ;

  opaque ioAux ; opaque io-B ; opaque oi-B ; opaque io-P ; opaque fromB-toB ; opaque toB-fromB ; opaque fromP-toP ;
  opaque tpAux ; opaque toP-fromP ; opaque toB-cong ; opaque fromB-inj ; opaque axB ; opaque actX-B ; opaque axPB ;
  opaque actX-PB ; opaque axPP ; opaque actX-PP ; opaque toB-act ; opaque eBAux ; opaque extOb-B ; opaque substAp ;
  opaque ebsAux ; opaque extOb-B-sub ; opaque ePAux ; opaque extOb-P ; opaque epsAux ; opaque extOb-P-sub ;
} ;
