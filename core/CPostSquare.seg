-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostSquare.seg (L9): the squares of D_N A between the lines
-- (postnikov.tex, Theorem conv, the homotopy phi psi ~ id).
--
-- With the lines l_N of CPostLine, the square at the stage N is the element
-- of D_N A at (X * [1]_t) * [1]_s given by the family (CLocDNC.from)
--
--   w2 ((f , t) , s)  =  Theta_N(f) at (< id , t > , s)        n <= N
--
-- read in A: the square Ts N of the recursion for n < N (sq-low), the
-- value at the identity of the step-2 square Thm for n = N (sq-top).  It is
-- natural along the face maps (T-face below N, Thf-face of step 2 at N),
-- hence along all strict maps (CFacesGen.SGB).  Its edges:
--
--   sq-s0     s = 0 : r l_{N+1}            (r : D_{N+1} A -> D_N A)
--   sq-s1     s = 1 : l_N
--   sq-t0     t = 0 : the constant line at r_N psi(u , p)
--   sq-t1     t = 1 : p_N
--
-- With CPostLine.end0 , end1 these are the components of a path from
-- phi psi(u , p) to (u , p) in the internal limit.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module PK = CPostK[a, l] ;
module BD = CPostBdry[a, l] ;
module PR = CPostRec[a, l] ;
module PLm = CPostLine[a, l] ;

-- < id , s > is strict
pairid-strict (n : Nat) (s : Hom (lin n) Iv) : Strict (lin n) (prodP (lin n) Iv) (pairH (lin n) Iv (lin n) (idH (lin n)) s) =
  BD.strict-of-inj (lin n) (prodP (lin n) Iv) (pairH (lin n) Iv (lin n) (idH (lin n)) s) (\ a b q ->
    transH (symH (app-idH1 (lin n) a)) (transH (BD.pair-inj-l (lin n) Iv (lin n) (idH (lin n)) s a b q) (app-idH1 (lin n) b))) ;

module PS (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) (X : Ob) (x : W0.Ix (G.ob X))
  (u : (N : Nat) -> LD.DT[G, CK.KT[G, A, N].KA].DEl X x)
  (p : (N : Nat) -> LD.DT[G, CK.KT[G, A, N].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (N r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r (suc N))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  ((p N).1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc N].rd (lin r) (G.act (lin r) X q x) ((u (suc N)).1 r q).1 r hr' (idH (lin r))))
  (pe1 : (N r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  ((p N).1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) X q x) ((u N).1 r q).1 r hr (idH (lin r)))) {
  module P = PLm.PL[G, A, c, X, x, u, p, pe0, pe1] ;
  module LL = P.LL ;
  module TA = P.TA ;
  module GL = P.GL ;
  XI : Ob = P.XI ;
  xI : W0.Ix (G.ob XI) = P.xI ;
  XII : Ob = prodP XI Iv ;
  xII : W0.Ix (G.ob XII) = G.act XII XI (pr1 XI Iv) xI ;

  ----------------------------------------------------------------------
  -- the step-2 square Theta_n(f) in C_n, f : [n] -> X

  module HPn (n : Nat) {
    module H = EZ.HProd[lin n, EZ.HLin[n].ht, n, EZ.HLin[n].hB, EZ.HLin[n].hm, EZ.HLin[n].hi,
                        Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi] ;
  } ;

  -- p_n along f * [1], in K_n
  module DPn (n : Nat) (f : Hom (lin n) X) {
    module D = PK.DRK[G, A, n, XI, xI, p n, prodP (lin n) Iv, HPn[n].H.ht, plus n (suc zero), HPn[n].H.hB, HPn[n].H.hm, HPn[n].H.hi,
                      crossH (lin n) X Iv Iv f (idH Iv)] ;
  } ;

  ThmT : (n : Nat) (f : Hom (lin n) X) (W : Nat) -> Hom (lin W) (prodP (lin n) Iv) -> Hom (lin W) Iv -> CK.KT[G, A, n].TK.EI (lin W) = split {
    zero -> \ f -> P.St2Z[f].S.Thm ;
    suc m' -> \ f -> P.St2S[m', f].S.Thm } ;

  ThmTp : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (prodP (lin n) Iv)) (j : Hom (lin W) Iv)
    -> Id (W0.Ix (G.ob (lin W))) (ThmT n f W g j).1
          (G.act (lin W) (prodP (lin n) Iv) g (G.act (prodP (lin n) Iv) (lin n) (pr1 (lin n) Iv) (G.act (lin n) X f x))) = split {
    zero -> \ f -> P.St2Z[f].S.Sq.Bx.Fp ;
    suc m' -> \ f -> P.St2S[m', f].S.Sq.Thf-p } ;

  ThmTn : (n : Nat) (f : Hom (lin n) X) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin n) Iv)) (j : Hom (lin W) Iv)
    -> Id (CK.KT[G, A, n].TK.EI (lin V)) (CK.KT[G, A, n].TK.E.act (lin V) (lin W) h (ThmT n f W g j))
          (ThmT n f V (compH (lin V) (lin W) (prodP (lin n) Iv) g h) (compH (lin V) (lin W) Iv j h)) = split {
    zero -> \ f -> P.St2Z[f].S.Sq.Bx.Fn ;
    suc m' -> \ f -> P.St2S[m', f].S.Sq.Thf-n } ;

  -- at s = 1 it is H^n(f)
  ThmT-s1 : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (j : Hom (lin W) Iv)
    -> Id (CK.KT[G, A, n].TK.EI (lin W)) (P.HmT n f W g j) (ThmT n f W (pairH (lin n) Iv (lin W) g j) (constH (lin W) Iv e1)) = split {
    zero -> \ f W g j -> refl (P.St2Z[f].S.Thm W (pairH (lin zero) Iv (lin W) g j) (constH (lin W) Iv e1)) ;
    suc m' -> \ f W g j -> refl (P.St2S[m', f].S.Thm W (pairH (lin (suc m')) Iv (lin W) g j) (constH (lin W) Iv e1)) } ;

  -- at s = 0 it is eta H^{n+1}(f)
  ThmT-s0 : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (prodP (lin n) Iv))
    -> Id (CK.KT[G, A, n].TK.EI (lin W)) (ThmT n f W g (constH (lin W) Iv e0))
          (CK.KT[G, A, n].etaE (lin W) ((P.Rd n f).Hs (suc n) W (LL.p1g n W g) (LL.p2g n W g))) = split {
    zero -> \ f -> P.St2Z[f].S.Sq.Thf-e ;
    suc m' -> \ f -> P.St2S[m', f].S.Sq.Thf-e } ;

  ThmT-t0 : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (j : Hom (lin W) Iv)
    -> Id (CK.KT[G, A, n].TK.EI (lin W)) (ThmT n f W (pairH (lin n) Iv (lin W) g (constH (lin W) Iv e0)) j)
          (CK.KT[G, A, n].TK.E.act (lin W) (lin n) g (CK.KT[G, A, n].etaE (lin n) (P.Rd n f).psi)) = split {
    zero -> \ f -> P.St2Z[f].S.Sq.Thf-t0 ;
    suc m' -> \ f -> P.St2S[m', f].S.Sq.Thf-t0 } ;

  ThmT-t1 : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (j : Hom (lin W) Iv)
    -> Id (CK.KT[G, A, n].TK.EI (lin W)) (ThmT n f W (pairH (lin n) Iv (lin W) g (constH (lin W) Iv e1)) j)
          (DPn[n, f].D.val W (pairH (lin n) Iv (lin W) g j)) = split {
    zero -> \ f -> P.St2Z[f].S.Sq.Thf-t1 ;
    suc m' -> \ f -> P.St2S[m', f].S.Sq.Thf-t1 } ;

  ----------------------------------------------------------------------
  -- the family

  q1 (n : Nat) (F : Hom (lin n) XII) : Hom (lin n) XI = compH (lin n) XII XI (pr1 XI Iv) F ;
  fF (n : Nat) (F : Hom (lin n) XII) : Hom (lin n) X = P.p1F n (q1 n F) ;
  tF (n : Nat) (F : Hom (lin n) XII) : Hom (lin n) Iv = P.p2F n (q1 n F) ;
  sF (n : Nat) (F : Hom (lin n) XII) : Hom (lin n) Iv = compH (lin n) XII Iv (pr2 XI Iv) F ;

  pt (n : Nat) (t : Hom (lin n) Iv) : Hom (lin n) (prodP (lin n) Iv) = pairH (lin n) Iv (lin n) (idH (lin n)) t ;

  sq-low (N n : Nat) (f : Hom (lin n) X) (t s : Hom (lin n) Iv) : TA.EI (lin n) = (P.Rd n f).Ts N n (pt n t) s ;

  sq-top (n : Nat) (f : Hom (lin n) X) (t s : Hom (lin n) Iv) : TA.EI (lin n) =
    CK.KT[G, A, n].ev n (leb-refl n) (ThmT n f n (pt n t) s) ;

  val2 (N n : Nat) (F : Hom (lin n) XII) : TA.EI (lin n) =
    PR.bcaseL (TA.EI (lin n)) (leb (suc n) N) (\ hh -> sq-low N n (fF n F) (tF n F) (sF n F)) (\ nh -> sq-top n (fF n F) (tF n F) (sF n F)) ;

  -- the point
  ptB (n : Nat) (f : Hom (lin n) X) (t : Hom (lin n) Iv)
    : Id (W0.Ix (G.ob (lin n))) (G.act (lin n) (prodP (lin n) Iv) (pt n t) (G.act (prodP (lin n) Iv) (lin n) (pr1 (lin n) Iv) (G.act (lin n) X f x)))
                                (G.act (lin n) X f x) =
    transH (GL.actC (lin n) (prodP (lin n) Iv) (lin n) (pr1 (lin n) Iv) (pt n t) (G.act (lin n) X f x))
      (transH (apH (\ k -> G.act (lin n) (lin n) k (G.act (lin n) X f x)) (pr1-pair (lin n) Iv (lin n) (idH (lin n)) t))
              (G.act-id (lin n) (G.act (lin n) X f x))) ;

  ptF2 (n : Nat) (F : Hom (lin n) XII) : Id (W0.Ix (G.ob (lin n))) (G.act (lin n) X (fF n F) x) (G.act (lin n) XII F xII) =
    symH (transH (GL.actC (lin n) XII XI (pr1 XI Iv) F xI) (GL.actC (lin n) XI X (pr1 X Iv) (q1 n F) x)) ;

  vp2 (N n : Nat) (F : Hom (lin n) XII) : Id (W0.Ix (G.ob (lin n))) (val2 N n F).1 (G.act (lin n) XII F xII) =
    PR.bcaseD (TA.EI (lin n)) (\ w -> Id (W0.Ix (G.ob (lin n))) w.1 (G.act (lin n) XII F xII))
      (leb (suc n) N) (\ hh -> sq-low N n (fF n F) (tF n F) (sF n F)) (\ nh -> sq-top n (fF n F) (tF n F) (sF n F))
      (\ hh -> transH ((P.Rd n (fF n F)).Tp N n (pt n (tF n F)) (sF n F)) (transH (ptB n (fF n F) (tF n F)) (ptF2 n F)))
      (\ nh -> transH (CK.KT[G, A, n].ev-pt n (leb-refl n) (ThmT n (fF n F) n (pt n (tF n F)) (sF n F)))
                 (transH (ThmTp n (fF n F) n (pt n (tF n F)) (sF n F)) (transH (ptB n (fF n F) (tF n F)) (ptF2 n F)))) ;

  ----------------------------------------------------------------------
  -- naturality along the face maps

  -- < id , t > after d_y is d_y * [1] after < id , t d_y >
  ptd (n y : Nat) (t : Hom (lin (suc n)) Iv)
    : Id (Hom (lin n) (prodP (lin (suc n)) Iv)) (compH (lin n) (lin (suc n)) (prodP (lin (suc n)) Iv) (pt (suc n) t) (dl n y))
         (compH (lin n) (prodP (lin n) Iv) (prodP (lin (suc n)) Iv) (BD.BG[n, Iv].dY y) (pt n (compH (lin n) (lin (suc n)) Iv t (dl n y)))) =
    transH (BD.pair-h (lin (suc n)) Iv (lin n) (lin (suc n)) (idH (lin (suc n))) t (dl n y))
      (transH (apH (\ k -> pairH (lin (suc n)) Iv (lin n) k (compH (lin n) (lin (suc n)) Iv t (dl n y)))
                 (transH (comp-idl (lin n) (lin (suc n)) (dl n y)) (symH (comp-idr (lin n) (lin (suc n)) (dl n y)))))
        (transH (apH (pairH (lin (suc n)) Iv (lin n) (compH (lin n) (lin n) (lin (suc n)) (dl n y) (idH (lin n))))
                   (symH (comp-idl (lin n) Iv (compH (lin n) (lin (suc n)) Iv t (dl n y)))))
                (symH (BD.cross-pair (lin n) (lin (suc n)) Iv Iv (lin n) (dl n y) (idH Iv) (idH (lin n)) (compH (lin n) (lin (suc n)) Iv t (dl n y)))))) ;

  module TF (n : Nat) (f : Hom (lin (suc n)) X) (t s : Hom (lin (suc n)) Iv) (y : Nat) (hy : IsT (leb y (suc n))) {
    module T = P.St2S[n, f] ;
    module KS = CK.KT[G, A, suc n] ;
    td : Hom (lin n) Iv = compH (lin n) (lin (suc n)) Iv t (dl n y) ;
    sd : Hom (lin n) Iv = compH (lin n) (lin (suc n)) Iv s (dl n y) ;

    res : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (sq-top (suc n) f t s))
                             (sq-low (suc n) n (compH (lin n) (lin (suc n)) X f (dl n y)) td sd) =
      calc (TA.EI (lin n)) {
          TA.E.act (lin n) (lin (suc n)) (dl n y) (KS.ev (suc n) (leb-refl (suc n)) (T.S.Thm (suc n) (pt (suc n) t) s))
        =< KS.ev-nat n (suc n) (leb-suc n) (leb-refl (suc n)) (dl n y) (T.S.Thm (suc n) (pt (suc n) t) s) >
          KS.ev n (leb-suc n) (KS.TK.E.act (lin n) (lin (suc n)) (dl n y) (T.S.Thm (suc n) (pt (suc n) t) s))
        =< apH (KS.ev n (leb-suc n)) (T.S.Sq.Thf-n n (suc n) (dl n y) (pt (suc n) t) s) >
          KS.ev n (leb-suc n) (T.S.Thm n (compH (lin n) (lin (suc n)) (prodP (lin (suc n)) Iv) (pt (suc n) t) (dl n y)) sd)
        =< apH (\ k -> KS.ev n (leb-suc n) (T.S.Thm n k sd)) (ptd n y t) >
          KS.ev n (leb-suc n) (T.S.Thm n (compH (lin n) (prodP (lin n) Iv) (prodP (lin (suc n)) Iv) (BD.BG[n, Iv].dY y) (pt n td)) sd)
        =< apH (KS.ev n (leb-suc n)) (T.S.Sq.Thf-face y hy n (pt n td) sd) >
          KS.ev n (leb-suc n) (KS.etaE (lin n) (T.Th y hy n (pt n td) sd))
        =< KS.ev-eta n (leb-suc n) (T.Th y hy n (pt n td) sd) >
          T.Th y hy n (pt n td) sd } ;
  } ;

  module LF (N n : Nat) (h2 : IsT (leb (suc (suc n)) N)) (f : Hom (lin (suc n)) X) (t s : Hom (lin (suc n)) Iv) (y : Nat) (hy : IsT (leb y (suc n))) {
    module T = P.St2S[n, f] ;
    td : Hom (lin n) Iv = compH (lin n) (lin (suc n)) Iv t (dl n y) ;
    sd : Hom (lin n) Iv = compH (lin n) (lin (suc n)) Iv s (dl n y) ;

    res : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (sq-low N (suc n) f t s))
                             (sq-low N n (compH (lin n) (lin (suc n)) X f (dl n y)) td sd) =
      transH (T.R.Tn N n (suc n) (dl n y) (pt (suc n) t) s)
        (transH (apH (\ k -> T.R.Ts N n k sd) (ptd n y t))
                (T.DF.TF N h2 y hy n (pt n td) sd)) ;
  } ;

  module WF (N n : Nat) (o : IsT (leb (suc n) N)) (F : Hom (lin (suc n)) XII) (y : Nat) (hy : IsT (leb y (suc n))) {
    f : Hom (lin (suc n)) X = fF (suc n) F ;
    t : Hom (lin (suc n)) Iv = tF (suc n) F ;
    s : Hom (lin (suc n)) Iv = sF (suc n) F ;
    Fd : Hom (lin n) XII = compH (lin n) (lin (suc n)) XII F (dl n y) ;

    eq1 : Id (Hom (lin n) XI) (compH (lin n) (lin (suc n)) XI (q1 (suc n) F) (dl n y)) (q1 n Fd) =
      comp-assoc (lin n) (lin (suc n)) XII XI (pr1 XI Iv) F (dl n y) ;

    rw (M : Nat) : Id (TA.EI (lin n)) (sq-low M n (compH (lin n) (lin (suc n)) X f (dl n y)) (compH (lin n) (lin (suc n)) Iv t (dl n y))
                                               (compH (lin n) (lin (suc n)) Iv s (dl n y)))
                                      (sq-low M n (fF n Fd) (tF n Fd) (sF n Fd)) =
      transH (apH (\ k -> sq-low M n k (compH (lin n) (lin (suc n)) Iv t (dl n y)) (compH (lin n) (lin (suc n)) Iv s (dl n y)))
                (transH (comp-assoc (lin n) (lin (suc n)) XI X (pr1 X Iv) (q1 (suc n) F) (dl n y)) (apH (P.p1F n) eq1)))
        (transH (apH (\ k -> sq-low M n (fF n Fd) k (compH (lin n) (lin (suc n)) Iv s (dl n y)))
                   (transH (comp-assoc (lin n) (lin (suc n)) XI Iv (pr2 X Iv) (q1 (suc n) F) (dl n y)) (apH (P.p2F n) eq1)))
                (apH (sq-low M n (fF n Fd) (tF n Fd)) (comp-assoc (lin n) (lin (suc n)) XII Iv (pr2 XI Iv) F (dl n y)))) ;

    lhs : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (val2 N (suc n) F)) (sq-low N n (fF n Fd) (tF n Fd) (sF n Fd)) =
      PR.bcaseD (TA.EI (lin (suc n))) (\ w -> Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) w) (sq-low N n (fF n Fd) (tF n Fd) (sF n Fd)))
        (leb (suc (suc n)) N) (\ hh -> sq-low N (suc n) f t s) (\ nh -> sq-top (suc n) f t s)
        (\ h2 -> transH LF[N, n, h2, f, t, s, y, hy].res (rw N))
        (\ nh -> transH (substH {Nat} (\ M -> Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (sq-top (suc n) f t s))
                                                    (sq-low M n (compH (lin n) (lin (suc n)) X f (dl n y)) (compH (lin n) (lin (suc n)) Iv t (dl n y))
                                                            (compH (lin n) (lin (suc n)) Iv s (dl n y))))
                           (P.topEq N n o nh) TF[n, f, t, s, y, hy].res)
                        (rw N)) ;

    res : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (val2 N (suc n) F)) (val2 N n Fd) =
      transH lhs (symH (PR.bcase-t (TA.EI (lin n)) (leb (suc n) N) (\ hh -> sq-low N n (fF n Fd) (tF n Fd) (sF n Fd))
                                                                    (\ nh -> sq-top n (fF n Fd) (tF n Fd) (sF n Fd)) o)) ;
  } ;

  module FG (N : Nat) {
    module S = CFacesGen[a, l].SGB[CLocRestr[a, l].R[TA.E].iG, XII, \ n -> IsT (leb n N), \ n o -> leb-trans n (suc n) N (leb-suc n) o,
                                   \ n -> isProp-IsT' (leb n N), \ n o F -> val2 N n F, \ n o F y hy -> WF[N, n, o, F, y, hy].res] ;
  } ;

  ----------------------------------------------------------------------
  -- the square, an element of D_N A at (X * [1]) * [1]

  module DCS (N : Nat) {
    module D = CLocDNC[a, l].DC[G, A, N] ;
    module L = P.DCN[N] ;

    wF : D.CFam XII xII = \ n hn F -> TA.fromE (lin n) (G.act (lin n) XII F xII) (val2 N n F) (vp2 N n F) ;

    crdw (n : Nat) (hn : IsT (leb n N)) (F : Hom (lin n) XII) : Id (TA.EI (lin n)) (D.crd XII xII wF n hn F) (val2 N n F) =
      TA.fromE-eq (lin n) (G.act (lin n) XII F xII) (val2 N n F) (vp2 N n F) ;

    wC : D.CCompat XII xII wF = \ m n hm hn g s F ->
      transH (apH (TA.E.act (lin m) (lin n) g) (crdw n hn F))
        (transH (FG[N].S.fg n m g s F hn hm) (symH (crdw m hm (compH (lin m) (lin n) XII F g)))) ;

    w : D.CEl XII xII = (wF, wC) ;

    sq : D.DK.DEl XII xII = D.from XII xII w ;

    -- the square restricted along k : Y -> (X * [1]) * [1]
    endS (Y : Ob) (yy : W0.Ix (G.ob Y)) (k : Hom Y XII) (ek : Id (W0.Ix (G.ob Y)) (G.act Y XII k xII) yy) : D.DK.DEl Y yy =
      D.DK.dtact Y XII k xII yy ek sq ;

    end-rd (Y : Ob) (yy : W0.Ix (G.ob Y)) (k : Hom Y XII) (ek : Id (W0.Ix (G.ob Y)) (G.act Y XII k xII) yy)
      (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) Y)
      : Id (TA.EI (lin n)) (D.rdId Y yy (endS Y yy k ek) n hn q) (val2 N n (compH (lin n) Y XII k q)) =
      calc (TA.EI (lin n)) {
          D.rdId Y yy (endS Y yy k ek) n hn q
        =< symH (D.crd-toF Y yy (endS Y yy k ek) n hn q) >
          D.crd Y yy (D.toF Y yy (endS Y yy k ek)) n hn q
        =< D.to-nat Y XII k xII yy ek sq n hn q >
          D.crd XII xII (D.toF XII xII sq) n hn (compH (lin n) Y XII k q)
        =< apH (\ v -> D.crd XII xII v.1 n hn (compH (lin n) Y XII k q)) (D.to-from XII xII w) >
          D.crd XII xII wF n hn (compH (lin n) Y XII k q)
        =< crdw n hn (compH (lin n) Y XII k q) >
          val2 N n (compH (lin n) Y XII k q) } ;

    -- the line l_N, read at the identity
    line-rd (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) XI) : Id (TA.EI (lin n)) (D.rdId XI xI L.line n hn q) (P.val N n q) =
      transH (symH (D.crd-toF XI xI L.line n hn q))
        (transH (apH (\ v -> D.crd XI xI v.1 n hn q) (D.to-from XI xI L.w)) (L.crdw n hn q)) ;
  } ;

  ----------------------------------------------------------------------
  -- the lids s = e and the faces t = e

  slid (e : El Iv) : Hom XI XII = lid XI e ;

  eslid (e : El Iv) : Id (W0.Ix (G.ob XI)) (G.act XI XII (slid e) xII) xI =
    transH (GL.actC XI XII XI (pr1 XI Iv) (slid e) xI)
      (transH (apH (\ k -> G.act XI XI k xI) (pr1-pair XI Iv XI (idH XI) (constH XI Iv e))) (G.act-id XI xI)) ;

  tfc (e : El Iv) : Hom XI XII = crossH X XI Iv Iv (lid X e) (idH Iv) ;

  etfc (e : El Iv) : Id (W0.Ix (G.ob XI)) (G.act XI XII (tfc e) xII) xI =
    calc (W0.Ix (G.ob XI)) {
        G.act XI XII (tfc e) (G.act XII XI (pr1 XI Iv) (G.act XI X (pr1 X Iv) x))
      =< GL.actC XI XII XI (pr1 XI Iv) (tfc e) (G.act XI X (pr1 X Iv) x) >
        G.act XI XI (compH XI XII XI (pr1 XI Iv) (tfc e)) (G.act XI X (pr1 X Iv) x)
      =< GL.actC XI XI X (pr1 X Iv) (compH XI XII XI (pr1 XI Iv) (tfc e)) x >
        G.act XI X (compH XI XI X (pr1 X Iv) (compH XI XII XI (pr1 XI Iv) (tfc e))) x
      =< apH (\ k -> G.act XI X (compH XI XI X (pr1 X Iv) k) x)
           (pr1-pair XI Iv XI (compH XI X XI (lid X e) (pr1 X Iv)) (compH XI Iv Iv (idH Iv) (pr2 X Iv))) >
        G.act XI X (compH XI XI X (pr1 X Iv) (compH XI X XI (lid X e) (pr1 X Iv))) x
      =< apH (\ k -> G.act XI X k x)
           (transH (symH (comp-assoc XI X XI X (pr1 X Iv) (lid X e) (pr1 X Iv)))
             (transH (apH (\ k -> compH XI X X k (pr1 X Iv)) (pr1-pair X Iv X (idH X) (constH X Iv e))) (comp-idl XI X (pr1 X Iv)))) >
        G.act XI X (pr1 X Iv) x } ;

  -- the components of the chains through them
  module Lid (n : Nat) (e : El Iv) (q : Hom (lin n) XI) {
    F : Hom (lin n) XII = compH (lin n) XI XII (slid e) q ;
    eq : Id (Hom (lin n) XI) (q1 n F) q =
      transH (symH (comp-assoc (lin n) XI XII XI (pr1 XI Iv) (slid e) q))
        (transH (apH (\ k -> compH (lin n) XI XI k q) (pr1-pair XI Iv XI (idH XI) (constH XI Iv e))) (comp-idl (lin n) XI q)) ;
    es : Id (Hom (lin n) Iv) (sF n F) (constH (lin n) Iv e) =
      transH (symH (comp-assoc (lin n) XI XII Iv (pr2 XI Iv) (slid e) q))
        (transH (apH (\ k -> compH (lin n) XI Iv k q) (pr2-pair XI Iv XI (idH XI) (constH XI Iv e))) (BD.const-h (lin n) XI q e)) ;
    rw (M : Nat) : Id (TA.EI (lin n)) (sq-low M n (fF n F) (tF n F) (sF n F)) (sq-low M n (P.p1F n q) (P.p2F n q) (constH (lin n) Iv e)) =
      transH (apH (\ k -> sq-low M n (P.p1F n k) (P.p2F n k) (sF n F)) eq) (apH (sq-low M n (P.p1F n q) (P.p2F n q)) es) ;
    rwt : Id (TA.EI (lin n)) (sq-top n (fF n F) (tF n F) (sF n F)) (sq-top n (P.p1F n q) (P.p2F n q) (constH (lin n) Iv e)) =
      transH (apH (\ k -> sq-top n (P.p1F n k) (P.p2F n k) (sF n F)) eq) (apH (sq-top n (P.p1F n q) (P.p2F n q)) es) ;
  } ;

  module Tfc (n : Nat) (e : El Iv) (q : Hom (lin n) XI) {
    F : Hom (lin n) XII = compH (lin n) XI XII (tfc e) q ;
    f : Hom (lin n) X = P.p1F n q ;
    s : Hom (lin n) Iv = P.p2F n q ;
    eq : Id (Hom (lin n) XI) (q1 n F) (compH (lin n) X XI (lid X e) f) =
      transH (symH (comp-assoc (lin n) XI XII XI (pr1 XI Iv) (tfc e) q))
        (transH (apH (\ k -> compH (lin n) XI XI k q) (pr1-pair XI Iv XI (compH XI X XI (lid X e) (pr1 X Iv)) (compH XI Iv Iv (idH Iv) (pr2 X Iv))))
                (comp-assoc (lin n) XI X XI (lid X e) (pr1 X Iv) q)) ;
    es : Id (Hom (lin n) Iv) (sF n F) s =
      transH (symH (comp-assoc (lin n) XI XII Iv (pr2 XI Iv) (tfc e) q))
        (transH (apH (\ k -> compH (lin n) XI Iv k q) (pr2-pair XI Iv XI (compH XI X XI (lid X e) (pr1 X Iv)) (compH XI Iv Iv (idH Iv) (pr2 X Iv))))
          (transH (comp-assoc (lin n) XI Iv Iv (idH Iv) (pr2 X Iv) q) (comp-idl (lin n) Iv s))) ;
    rw (M : Nat) : Id (TA.EI (lin n)) (sq-low M n (fF n F) (tF n F) (sF n F)) (sq-low M n f (constH (lin n) Iv e) s) =
      transH (apH (\ k -> sq-low M n (P.p1F n k) (P.p2F n k) (sF n F)) eq)
        (transH (apH (\ k -> sq-low M n k (P.p2F n (compH (lin n) X XI (lid X e) f)) (sF n F)) (P.pl1 n e f))
          (transH (apH (\ k -> sq-low M n f k (sF n F)) (P.pl2 n e f)) (apH (sq-low M n f (constH (lin n) Iv e)) es))) ;
    rwt : Id (TA.EI (lin n)) (sq-top n (fF n F) (tF n F) (sF n F)) (sq-top n f (constH (lin n) Iv e) s) =
      transH (apH (\ k -> sq-top n (P.p1F n k) (P.p2F n k) (sF n F)) eq)
        (transH (apH (\ k -> sq-top n k (P.p2F n (compH (lin n) X XI (lid X e) f)) (sF n F)) (P.pl1 n e f))
          (transH (apH (\ k -> sq-top n f k (sF n F)) (P.pl2 n e f)) (apH (sq-top n f (constH (lin n) Iv e)) es))) ;
  } ;

  -- N = n from n <= N and not n + 1 <= N
  topEq0 (N n : Nat) (hn : IsT (leb n N)) (nh : Id Bool (leb (suc n) N) false) : Id Nat n N =
    symH (leb-anti N n (PR.nleb (suc n) N nh) hn) ;

  ----------------------------------------------------------------------
  -- s = 1: the line l_N

  module S1 (N n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) XI) {
    module LI = Lid[n, e1, q] ;
    f : Hom (lin n) X = P.p1F n q ;
    t : Hom (lin n) Iv = P.p2F n q ;

    low (hh : IsT (leb (suc n) N)) : Id (TA.EI (lin n)) (sq-low N n f t (constH (lin n) Iv e1)) (P.vlow N n f t) =
      transH ((P.Rd n f).Ts1 N hh n (pt n t))
        (transH (apH (\ k -> (P.Rd n f).Hs N n k (LL.p2g n n (pt n t))) (pr1-pair (lin n) Iv (lin n) (idH (lin n)) t))
                (apH ((P.Rd n f).Hs N n (idH (lin n))) (pr2-pair (lin n) Iv (lin n) (idH (lin n)) t))) ;

    top : Id (TA.EI (lin n)) (sq-top n f t (constH (lin n) Iv e1)) (P.vtop n f t) =
      symH (apH (CK.KT[G, A, n].ev n (leb-refl n)) (ThmT-s1 n f n (idH (lin n)) t)) ;

    res : Id (TA.EI (lin n)) (val2 N n LI.F) (P.val N n q) =
      PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) v (P.val N n q)) (leb (suc n) N)
        (\ hh -> sq-low N n (fF n LI.F) (tF n LI.F) (sF n LI.F)) (\ nh -> sq-top n (fF n LI.F) (tF n LI.F) (sF n LI.F))
        (\ hh -> transH (LI.rw N) (transH (low hh)
                   (symH (PR.bcase-t (TA.EI (lin n)) (leb (suc n) N) (\ h1 -> P.vlow N n f t) (\ nh1 -> P.vtop n f t) hh))))
        (\ nh -> transH LI.rwt (transH top
                   (symH (PR.bcase-f (TA.EI (lin n)) (leb (suc n) N) (\ h1 -> P.vlow N n f t) (\ nh1 -> P.vtop n f t) nh)))) ;
  } ;

  sq-s1 (N : Nat) : Id (LD.DT[G, CK.KT[G, A, N].KA].DEl XI xI) (DCS[N].endS XI xI (slid e1) (eslid e1)) P.DCN[N].line =
    P.DCN[N].to-inj XI xI (DCS[N].endS XI xI (slid e1) (eslid e1)) P.DCN[N].line (\ n hn q ->
      transH (DCS[N].end-rd XI xI (slid e1) (eslid e1) n hn q) (transH S1[N, n, hn, q].res (symH (DCS[N].line-rd n hn q)))) ;

  ----------------------------------------------------------------------
  -- s = 0: r l_{N+1}

  module RN (N : Nat) {
    module RS = CK.Res[G, A, N, suc N, leb-suc N] ;
    r : LD.DT[G, CK.KT[G, A, suc N].KA].DEl XI xI -> LD.DT[G, CK.KT[G, A, N].KA].DEl XI xI =
      LD.DMap[G, CK.KT[G, A, suc N].KA, CK.KT[G, A, N].KA, RS.resN].DF XI xI ;
  } ;

  module S0 (N n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) XI) {
    module LI = Lid[n, e0, q] ;
    f : Hom (lin n) X = P.p1F n q ;
    t : Hom (lin n) Iv = P.p2F n q ;
    hn1 : IsT (leb (suc n) (suc N)) = hn ;

    low (hh : IsT (leb (suc n) N)) : Id (TA.EI (lin n)) (sq-low N n f t (constH (lin n) Iv e0)) (P.vlow (suc N) n f t) =
      (P.Rd n f).Ts0 N hh n (idH (lin n)) t ;

    top : Id (TA.EI (lin n)) (sq-top n f t (constH (lin n) Iv e0)) (P.vlow (suc n) n f t) =
      transH (apH (CK.KT[G, A, n].ev n (leb-refl n)) (ThmT-s0 n f n (pt n t)))
        (transH (CK.KT[G, A, n].ev-eta n (leb-refl n) _)
          (transH (apH (\ k -> (P.Rd n f).Hs (suc n) n k (LL.p2g n n (pt n t))) (pr1-pair (lin n) Iv (lin n) (idH (lin n)) t))
                  (apH ((P.Rd n f).Hs (suc n) n (idH (lin n))) (pr2-pair (lin n) Iv (lin n) (idH (lin n)) t)))) ;

    res : Id (TA.EI (lin n)) (val2 N n LI.F) (P.val (suc N) n q) =
      transH (PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) v (P.vlow (suc N) n f t)) (leb (suc n) N)
                (\ hh -> sq-low N n (fF n LI.F) (tF n LI.F) (sF n LI.F)) (\ nh -> sq-top n (fF n LI.F) (tF n LI.F) (sF n LI.F))
                (\ hh -> transH (LI.rw N) (low hh))
                (\ nh -> transH LI.rwt (transH top (apH (\ M -> P.vlow (suc M) n f t) (topEq0 N n hn nh)))))
        (symH (PR.bcase-t (TA.EI (lin n)) (leb (suc n) (suc N)) (\ h1 -> P.vlow (suc N) n f t) (\ nh1 -> P.vtop n f t) hn1)) ;
  } ;

  sq-s0 (N : Nat) : Id (LD.DT[G, CK.KT[G, A, N].KA].DEl XI xI) (DCS[N].endS XI xI (slid e0) (eslid e0)) (RN[N].r P.DCN[suc N].line) =
    P.DCN[N].to-inj XI xI (DCS[N].endS XI xI (slid e0) (eslid e0)) (RN[N].r P.DCN[suc N].line) (\ n hn q ->
      transH (DCS[N].end-rd XI xI (slid e0) (eslid e0) n hn q)
        (transH S0[N, n, hn, q].res (symH (DCS[suc N].line-rd n (leb-trans n N (suc N) hn (leb-suc N)) q)))) ;

  ----------------------------------------------------------------------
  -- t = 0: the constant line at r_N psi

  constR (N : Nat) : LD.DT[G, CK.KT[G, A, N].KA].DEl XI xI =
    LD.DT[G, CK.KT[G, A, N].KA].dtact XI X (pr1 X Iv) x xI (refl xI) (P.rN N) ;

  module T0 (N n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) XI) {
    module TC = Tfc[n, e0, q] ;
    module KN = CK.KT[G, A, n] ;
    module D = DCS[N].D ;

    rhs : Id (TA.EI (lin n)) (D.rdId XI xI (constR N) n hn q) (TA.E.act (lin n) (lin n) (idH (lin n)) (P.Rd n TC.f).psi) =
      transH (symH (D.crd-toF XI xI (constR N) n hn q))
        (transH (D.to-nat XI X (pr1 X Iv) x xI (refl xI) (P.rN N) n hn q)
          (transH (D.crd-toF X x (P.rN N) n hn TC.f) P.E0[N, n, hn, TC.f].rhs)) ;

    top : Id (TA.EI (lin n)) (sq-top n TC.f (constH (lin n) Iv e0) TC.s) (TA.E.act (lin n) (lin n) (idH (lin n)) (P.Rd n TC.f).psi) =
      transH (apH (KN.ev n (leb-refl n)) (ThmT-t0 n TC.f n (idH (lin n)) TC.s))
        (transH (symH (KN.ev-nat n n (leb-refl n) (leb-refl n) (idH (lin n)) (KN.etaE (lin n) (P.Rd n TC.f).psi)))
                (apH (TA.E.act (lin n) (lin n) (idH (lin n))) (KN.ev-eta n (leb-refl n) (P.Rd n TC.f).psi))) ;

    res : Id (TA.EI (lin n)) (val2 N n TC.F) (D.rdId XI xI (constR N) n hn q) =
      transH (PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) v (TA.E.act (lin n) (lin n) (idH (lin n)) (P.Rd n TC.f).psi)) (leb (suc n) N)
                (\ hh -> sq-low N n (fF n TC.F) (tF n TC.F) (sF n TC.F)) (\ nh -> sq-top n (fF n TC.F) (tF n TC.F) (sF n TC.F))
                (\ hh -> transH (TC.rw N) ((P.Rd n TC.f).Tt0 N hh n (idH (lin n)) TC.s))
                (\ nh -> transH TC.rwt top))
             (symH rhs) ;
  } ;

  sq-t0 (N : Nat) : Id (LD.DT[G, CK.KT[G, A, N].KA].DEl XI xI) (DCS[N].endS XI xI (tfc e0) (etfc e0)) (constR N) =
    P.DCN[N].to-inj XI xI (DCS[N].endS XI xI (tfc e0) (etfc e0)) (constR N) (\ n hn q ->
      transH (DCS[N].end-rd XI xI (tfc e0) (etfc e0) n hn q) T0[N, n, hn, q].res) ;

  ----------------------------------------------------------------------
  -- t = 1: p_N

  module T1 (N n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) XI) {
    module TC = Tfc[n, e1, q] ;
    module KN = CK.KT[G, A, n] ;
    module D = DCS[N].D ;

    -- f * [1] after < id , s > is q
    fq : Id (Hom (lin n) XI) (compH (lin n) (prodP (lin n) Iv) XI (crossH (lin n) X Iv Iv TC.f (idH Iv)) (pt n TC.s)) q =
      transH (BD.cross-pair (lin n) X Iv Iv (lin n) TC.f (idH Iv) (idH (lin n)) TC.s)
        (transH (apH (\ k -> pairH X Iv (lin n) k (compH (lin n) Iv Iv (idH Iv) TC.s)) (comp-idr (lin n) X TC.f))
          (transH (apH (pairH X Iv (lin n) TC.f) (comp-idl (lin n) Iv TC.s)) (pair-eta X Iv (lin n) q))) ;

    low (hh : IsT (leb (suc n) N)) : Id (TA.EI (lin n)) (sq-low N n TC.f (constH (lin n) Iv e1) TC.s) (D.rdId XI xI (p N) n hn q) =
      transH ((P.Rd n TC.f).Tt1 N hh n (idH (lin n)) TC.s)
        (transH PK.DRS[G, A, N, XI, xI, p N, prodP (lin n) Iv, HPn[n].H.ht, plus n (suc zero), HPn[n].H.hB, HPn[n].H.hm, HPn[n].H.hi,
                       BD.leN n N hh, crossH (lin n) X Iv Iv TC.f (idH Iv), n, pt n TC.s, pairid-strict n TC.s, hn].res
                (apH (\ k -> D.rdId XI xI (p N) n hn k) fq)) ;

    top : Id (TA.EI (lin n)) (sq-top n TC.f (constH (lin n) Iv e1) TC.s) (CLocDNC[a, l].DC[G, A, n].rdId XI xI (p n) n (leb-refl n) q) =
      transH (apH (KN.ev n (leb-refl n)) (ThmT-t1 n TC.f n (idH (lin n)) TC.s))
        (transH (apH (KN.ev n (leb-refl n))
                   PK.DRKS[G, A, n, XI, xI, p n, prodP (lin n) Iv, HPn[n].H.ht, plus n (suc zero), HPn[n].H.hB, HPn[n].H.hm, HPn[n].H.hi,
                           crossH (lin n) X Iv Iv TC.f (idH Iv), n, pt n TC.s, pairid-strict n TC.s].res)
                (apH (\ k -> CLocDNC[a, l].DC[G, A, n].rdId XI xI (p n) n (leb-refl n) k) fq)) ;

    topM (M : Nat) (e : Id Nat n M) (hM : IsT (leb n M))
      : Id (TA.EI (lin n)) (sq-top n TC.f (constH (lin n) Iv e1) TC.s) (CLocDNC[a, l].DC[G, A, M].rdId XI xI (p M) n hM q) =
      idJ Nat n (\ M1 e' -> (hM1 : IsT (leb n M1))
                   -> Id (TA.EI (lin n)) (sq-top n TC.f (constH (lin n) Iv e1) TC.s) (CLocDNC[a, l].DC[G, A, M1].rdId XI xI (p M1) n hM1 q))
        (\ hM1 -> transH top (KN.rd-irr (lin n) (G.act (lin n) XI q xI) ((p n).1 n q).1 n (leb-refl n) hM1 (idH (lin n))))
        M e hM ;

    res : Id (TA.EI (lin n)) (val2 N n TC.F) (D.rdId XI xI (p N) n hn q) =
      PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) v (D.rdId XI xI (p N) n hn q)) (leb (suc n) N)
        (\ hh -> sq-low N n (fF n TC.F) (tF n TC.F) (sF n TC.F)) (\ nh -> sq-top n (fF n TC.F) (tF n TC.F) (sF n TC.F))
        (\ hh -> transH (TC.rw N) (low hh))
        (\ nh -> transH TC.rwt (topM N (topEq0 N n hn nh) hn)) ;
  } ;

  sq-t1 (N : Nat) : Id (LD.DT[G, CK.KT[G, A, N].KA].DEl XI xI) (DCS[N].endS XI xI (tfc e1) (etfc e1)) (p N) =
    P.DCN[N].to-inj XI xI (DCS[N].endS XI xI (tfc e1) (etfc e1)) (p N) (\ n hn q ->
      transH (DCS[N].end-rd XI xI (tfc e1) (etfc e1) n hn q) T1[N, n, hn, q].res) ;
} ;
