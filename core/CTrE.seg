-- CTrE.seg (L3, inside CB, level l): transport is an equivalence (model.tex
-- Prop "transport is an equivalence").  The extension of a side p of the
-- fibre of tr over w = (gamma , a) is (bnew , pnew read in SA) (CTrB,
-- CTrP); on p it is p's value (bside; pnew agrees with the side's path);
-- it is uniform (the B-problem and the path problem of the restricted data
-- are the restricted problems).  trEquiv is the equivalence structure, over
-- the universal lines GI; TrF packages it from a fibration structure.
--
-- Quarry: seg/model GTE10-GTE14 (one side, over GI).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module TrE (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp)
  (cb : CLine[l].Lines[G, A].CompK[tgt d, src d].Comp)
  (c01 : CLine[l].Lines[G, A].CompK[e0, e1].Comp) {
  module TP = CTrP[l].TrP[G, A, d, ca, cb, c01] ;
  module B = TP.B ;
  module O = TP.O ;
  module T1 = TP.T1 ;
  module HF = TP.HF ;
  module TA = TP.TA ;
  module KP = TP.KP ;
  module CP2 = TP.CP2 ;
  module E0 = TP.E0 ;
  module EK1 = TP.EKt ;
  module FP = B.FP ;
  module GIL = GPR.PshL[T1.FG.GI] ;
  module EVP2t = TP.FA2.Ev[tgt d] ;

  rdA (W : Ob) (z : HF.TA.EI W) : TA.EI W = EK1.endE W z ;

  ----------------------------------------------------------------------
  -- the extension

  module Bx (X : Ob) (w : HF.TA.EI X) (p : FP.Side[X, w]) {
    module P9 = TP.PN[X, w, p] ;
    module PX = P9.PX ;
    module BX = P9.BX ;

    yT : W0.Ix (KP.K2.ob X) = PX.L3.v3 X (idH X) (ptH X (tgt d)) ;

    pv (W : Ob) (f : Hom W X) (i : Hom W Iv) : TA.EI W = P9.pnew.1.1 W f i ;

    -- the point of ln at the end, along f
    peR (W : Ob) (f : Hom W X)
      : Id (W0.Ix (G.ob W)) (G.act W X f (PX.u X (idH X) (ptH X (tgt d))).1) ((T1.FG.ev (tgt d)).nt W (T1.FG.GI.act W X f w.1)) =
      transH (apH (G.act W X f) (apH (\ y -> y.1 X (idH X) (ptH X (tgt d))) (E0.lineL X PX.uS).2.2))
        (transH (w.1.2 W X f (idH X) (ptH X (tgt d)))
          (transH (apH (\ m -> w.1.1 W m (compH W X Iv (ptH X (tgt d)) f)) (transH (comp-idl W X f) (symH (comp-idr W X f))))
                  (apH (\ k -> w.1.1 W (compH W W X f (idH W)) k) (ptH-nat W X f (tgt d))))) ;

    pe (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (pv W f i).1 ((T1.FG.ev (tgt d)).nt W (T1.FG.GI.act W X f w.1)) =
      transH (P9.pnew.2.1 W f i) (peR W f) ;

    -- pnew read in SA over gamma
    t (W : Ob) (f : Hom W X) (i : Hom W Iv) : HF.TA.EI W =
      (T1.FG.GI.act W X f w.1, TA.coeT W (pv W f i).1 ((T1.FG.ev (tgt d)).nt W (T1.FG.GI.act W X f w.1)) (pe W f i) (pv W f i).2) ;

    t-rd (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (TA.EI W) (rdA W (t W f i)) (pv W f i) =
      symH (TA.pr-coe W (pv W f i).1 ((T1.FG.ev (tgt d)).nt W (T1.FG.GI.act W X f w.1)) (pe W f i) (pv W f i).2) ;

    tn (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
      : Id (HF.TA.EI V) (HF.TA.E.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g)) =
      EK1.tv-eq V (HF.TA.E.act V W g (t W f i)) (t V (compH V W X f g) (compH V W Iv i g))
        (GIL.actC V W X f g w.1)
        (transH (EK1.endE-act V W g (t W f i))
          (transH (apH (TA.E.act V W g) (t-rd W f i))
            (transH (P9.pnew.1.2 V W g f i) (symH (t-rd V (compH V W X f g) (compH V W Iv i g)))))) ;

    tp (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (W0.Ix (T1.FG.GI.ob W)) (t W f i).1 (T1.FG.GI.act W X f w.1) =
      refl (T1.FG.GI.act W X f w.1) ;

    t0 : Id (HF.TA.EI X) (t X (idH X) (ptH X e0)) (T1.trE X PX.xbn) =
      EK1.tv-eq X (t X (idH X) (ptH X e0)) (T1.trE X PX.xbn) (T1.FG.GI.act-id X w.1)
        (transH (t-rd X (idH X) (ptH X e0))
          (transH P9.pnew.2.2.1 (symH (T1.EVt.endB-E X (E0.lineL X PX.uS))))) ;

    t1 : Id (HF.TA.EI X) (t X (idH X) (ptH X e1)) w =
      EK1.tv-eq X (t X (idH X) (ptH X e1)) w (T1.FG.GI.act-id X w.1)
        (transH (t-rd X (idH X) (ptH X e1))
          (transH P9.pnew.2.2.2
            (transH (KP.mk3-b X (PX.u X (idH X) (ptH X (tgt d))) (PX.u' X (idH X) (ptH X (tgt d))) (PX.P X (idH X) (ptH X (tgt d))))
              (transH (symH (T1.EVt.endB-E X (EK1.lineL X BX.FbS))) (apH (EK1.endE X) BX.FbS.2.2))))) ;

    opaque pe ; opaque tn ; opaque t0 ; opaque t1 ;

    kop : HF.TF.T X w = (HF.mkFib X w BX.bnew t tn tp t0 t1).2 ;
  } ;

  ----------------------------------------------------------------------
  -- on the side, the extension is the side's value

  module Sd (X : Ob) (w : HF.TA.EI X) (p : FP.Side[X, w]) (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) {
    module XB = Bx[X, w, p] ;
    module P9 = XB.P9 ;
    module SL = P9.SL[W, f, h] ;
    module Q = SL.Q ;

    v : HF.TF.EI W = p.pv W f h ;

    kv : HF.TF.EI X = (w, XB.kop) ;

    -- the end of the side of the path problem, read at (g , i)
    sE (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : TA.EI W' = (EVP2t.endB W (CP2.lineL W SL.pv)).1.1 W' g i ;

    sE-v (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : Id (TA.EI W') (sE W' g i) (rdA W' (HF.fibL W v W' g i)) =
      calc (TA.EI W') {
          (EVP2t.endB W (CP2.lineL W SL.pv)).1.1 W' g i
        =< apH (\ z -> z.2.1.1 W' g i) (EVP2t.endB-E W (CP2.lineL W SL.pv)) >
          ((CP2.lineL W SL.pv).2.1.1 W (idH W) (ptH W (tgt d))).2.1.1 W' g i
        =< apH (\ z -> z.2.1.1 W' g i) (SL.pv-lev W (idH W) (ptH W (tgt d))) >
          (Q.sqV W' (compH W' W W (idH W) g) i).2.1.1 W' (idH W') (compH W' W Iv (ptH W (tgt d)) g)
        =< apH (\ k -> (Q.sqV W' (compH W' W W (idH W) g) i).2.1.1 W' (idH W') k) (ptH-nat W' W g (tgt d)) >
          (Q.sqV W' (compH W' W W (idH W) g) i).2.1.1 W' (idH W') (ptH W' (tgt d))
        =< O.PT.end1g W' (Q.sqV W' (compH W' W W (idH W) g) i).1 (Q.sqV W' (compH W' W W (idH W) g) i).2 W' (idH W') >
          O.bE W' (O.K.act W' W' (idH W') (Q.sqV W' (compH W' W W (idH W) g) i).1)
        =< apH (O.bE W') (transH (O.K.act-id W' (Q.sqV W' (compH W' W W (idH W) g) i).1)
                                  (apH (\ y -> y.1 W' (compH W' W W (idH W) g) i) Q.sqL.2.2)) >
          O.bE W' (Q.OW.L.lw W' (compH W' W W (idH W) g) i)
        =< apH (\ k -> rdA W' (HF.fibL W v W' k i)) (comp-idl W' W g) >
          rdA W' (HF.fibL W v W' g i) } ;

    ql (W' : Ob) (g : Hom W' W) (i : Hom W' Iv)
      : Id (HF.TA.EI W') (HF.fibL W (HF.TF.E.act W X f kv) W' g i) (HF.fibL W v W' g i) =
      EK1.tv-eq W' (XB.t W' (compH W' W X f g) i) (HF.fibL W v W' g i)
        (transH (symH (GIL.actC W' W X f g w.1))
          (transH (apH (T1.FG.GI.act W' W g) (symH (apH {HF.TA.EI W} {W0.Ix (T1.FG.GI.ob W)} (\ z -> z.1) (p.ppt W f h))))
                  (symH (HF.fibL-pt W v W' g i))))
        (transH (XB.t-rd W' (compH W' W X f g) i)
          (transH (apH (\ z -> z.2.1.1 W' g i) (KP.PC2.comp.kside X P9.PX.xh2 P9.side W f h)) (sE-v W' g i))) ;

    kside : Id (HF.TF.EI W) (HF.TF.E.act W X f kv) v =
      HF.fibE-eq W (HF.TF.E.act W X f kv) v (symH (p.ppt W f h))
        (transH (HF.fibB-act W X f kv) (B.Box[X, w, p].BS[W, f, h].bside))
        ql ;

    opaque sE-v ; opaque ql ;
  } ;

  ----------------------------------------------------------------------
  -- the B part is uniform

  module BU (Y X : Ob) (h : Hom Y X) (w : HF.TA.EI X) (p : FP.Side[X, w]) {
    module BX = B.Box[X, w, p] ;
    module BY = B.Box[Y, HF.TA.E.act Y X h w, FP.rside Y X h w p] ;

    sEq (W : Ob) (g : Hom W Y) (i : Lands W Y (pre Y X h p.pQ) g) (i' : Lands W Y (pre Y X h p.pQ) g)
      : Id (EK1.TS.EI W) (BX.pv W (compH W Y X h g) (lands-pre W Y X h p.pQ g i)) (BY.pv W g i') =
      EK1.ts-ext W (BX.pv W (compH W Y X h g) (lands-pre W Y X h p.pQ g i)) (BY.pv W g i')
        (transH (BX.pv-pt W (compH W Y X h g) (lands-pre W Y X h p.pQ g i))
          (transH (symH (EK1.TV.PE.actC W Y X h g BX.zt)) (symH (BY.pv-pt W g i'))))
        (\ V g' j ->
           transH (BX.pv-lev W (compH W Y X h g) (lands-pre W Y X h p.pQ g i) V g' j)
             (transH (apH (\ z -> O.W[W, z].omE.2.1.1 V g' j)
                          (FP.pv-irr X w p W (compH W Y X h g) (lands-pre W Y X h p.pQ g i) (lands-pre W Y X h p.pQ g i')))
                     (symH (BY.pv-lev W g i' V g' j)))) ;

    pBEq : Id (EK1.PT.Side[Y, BY.zt]) (EK1.PT.rside Y X h BX.zt BX.pB) BY.pB =
      EK1.PT.side-ext Y BY.zt (EK1.PT.rside Y X h BX.zt BX.pB) BY.pB (refl (pre Y X h p.pQ)) (\ W g i i' -> sEq W g i i') ;

    FbN : Id (EK1.TS.EI Y) (EK1.TS.E.act Y X h BX.FbS) BY.FbS =
      transH (B.kb.kunif Y X h BX.zt BX.pB)
        (CPartial[l].Rel[EK1.TV.E, EK1.SFm.SF, EK1.SFm.SF, CPartial[l].pmap-id EK1.TV.E EK1.SFm.SF].kop-cong B.kb Y
           (EK1.TV.E.act Y X h BX.zt) BY.zt (refl BY.zt) (EK1.PT.rside Y X h BX.zt BX.pB) BY.pB pBEq) ;

    bnN : Id (HF.TB.EI Y) (HF.TB.E.act Y X h (w.1, BX.bnew)) ((HF.TA.E.act Y X h w).1, BY.bnew) =
      transH (symH (T1.EVs.evA.mnat Y X h (EK1.lineL X BX.FbS)))
        (apH (\ z -> T1.EVs.evA.mE Y z) (transH (symH (EK1.lineL-act Y X h BX.FbS)) (apH (EK1.lineL Y) FbN))) ;

    opaque sEq ; opaque pBEq ; opaque FbN ; opaque bnN ;
  } ;

  ----------------------------------------------------------------------
  -- the path part is uniform

  module PU (Y X : Ob) (h : Hom Y X) (w : HF.TA.EI X) (p : FP.Side[X, w]) {
    module UB = BU[Y, X, h, w, p] ;
    module NX = TP.PN[X, w, p] ;
    module NY = TP.PN[Y, HF.TA.E.act Y X h w, FP.rside Y X h w p] ;
    module QX = NX.PX ;
    module QY = NY.PX ;

    uE (W : Ob) (g : Hom W Y) (i : Hom W Iv) : Id (TA.EI W) (QX.u W (compH W Y X h g) i) (QY.u W g i) =
      transH (symH (apH (\ M -> M.2.1.1 W g i) (E0.lineL-act Y X h QX.uS)))
        (transH (apH (\ z -> (E0.lineL Y z).2.1.1 W g i) (T1.uF-nat Y X h QX.xbn))
                (apH (\ z -> (E0.lineL Y (T1.uF Y z)).2.1.1 W g i) UB.bnN)) ;

    u'E (W : Ob) (g : Hom W Y) (i : Hom W Iv) : Id (TA.EI W) (QX.u' W (compH W Y X h g) i) (QY.u' W g i) =
      transH (symH (apH (\ M -> M.2.1.1 W g i) (EK1.lineL-act Y X h NX.BX.FbS)))
        (apH (\ z -> (EK1.lineL Y z).2.1.1 W g i) UB.FbN) ;

    ellE : Id (W0.Ix (KP.FK2.ob Y)) (KP.FK2.actF Y X h QX.ell2) QY.ell2 =
      KP.FK2.fam-eq Y (KP.FK2.actF Y X h QX.ell2) QY.ell2 (\ W g i ->
        KP.k2Ext W (QX.L3.v3 W (compH W Y X h g) i) (QY.L3.v3 W g i) (uE W g i)
          (transH (KP.mk3-b W (QX.u W (compH W Y X h g) i) (QX.u' W (compH W Y X h g) i) (QX.P W (compH W Y X h g) i))
            (transH (u'E W g i) (symH (KP.mk3-b W (QY.u W g i) (QY.u' W g i) (QY.P W g i)))))) ;

    bnE : Id (TA.EI Y) (TA.E.act Y X h QX.bnE) QY.bnE =
      transH (symH (E0.endE-act Y X h QX.xbn)) (apH (E0.endE Y) UB.bnN) ;

    xhE : Id (CP2.TV.EI Y) (CP2.TV.E.act Y X h QX.xh2) QY.xh2 =
      CP2.tv-eq Y (CP2.TV.E.act Y X h QX.xh2) QY.xh2 ellE
        (KP.PT2.tp-ext Y (CP2.endE Y (CP2.TV.E.act Y X h QX.xh2)) (CP2.endE Y QY.xh2)
           (apH (\ z -> (KP.FK2.ev (src d)).nt Y z) ellE)
           (\ W g j -> transH (symH (TA.PE.actC W Y X h g QX.bnE)) (apH (TA.E.act W Y g) bnE))) ;

    sEq (W : Ob) (g : Hom W Y) (i : Lands W Y (pre Y X h p.pQ) g) (i' : Lands W Y (pre Y X h p.pQ) g)
      : Id (CP2.TS.EI W) NX.SL[W, compH W Y X h g, lands-pre W Y X h p.pQ g i].pv NY.SL[W, g, i'].pv =
      CP2.ts-ext W NX.SL[W, compH W Y X h g, lands-pre W Y X h p.pQ g i].pv NY.SL[W, g, i'].pv
        (transH NX.SL[W, compH W Y X h g, lands-pre W Y X h p.pQ g i].pv-pt
          (transH (symH (CP2.TV.PE.actC W Y X h g QX.xh2))
            (transH (apH (CP2.TV.E.act W Y g) xhE) (symH NY.SL[W, g, i'].pv-pt))))
        (\ W' g' j ->
           transH (NX.SL[W, compH W Y X h g, lands-pre W Y X h p.pQ g i].pv-lev W' g' j)
             (transH
               (KP.PT2.tp-ext W' (NX.SL[W, compH W Y X h g, lands-pre W Y X h p.pQ g i].tt W' g' j) (NY.SL[W, g, i'].tt W' g' j)
                  (transH (apH (\ m -> QX.L3.v3 W' m j) (comp-assoc W' W Y X h g g'))
                          (apH (\ z -> z.1 W' (compH W' W Y g g') j) ellE))
                  (\ W'' g'' j' ->
                     apH (\ z -> ((O.CP.lineL W O.W[W, z].omSq).2.1.1 W'' (compH W'' W' W g' g'') j').2.1.1 W'' (idH W'') (compH W'' W' Iv j g''))
                         (FP.pv-irr X w p W (compH W Y X h g) (lands-pre W Y X h p.pQ g i) (lands-pre W Y X h p.pQ g i'))))
               (symH (NY.SL[W, g, i'].pv-lev W' g' j)))) ;

    pSE : Id (CP2.PT.Side[Y, QY.xh2])
             (subst (CP2.TV.EI Y) (\ z -> CP2.PT.Side[Y, z]) (CP2.TV.E.act Y X h QX.xh2) QY.xh2 xhE (CP2.PT.rside Y X h QX.xh2 NX.side))
             NY.side =
      CP2.PT.side-extH Y (CP2.TV.E.act Y X h QX.xh2) QY.xh2 xhE (CP2.PT.rside Y X h QX.xh2 NX.side) NY.side (refl (pre Y X h p.pQ))
        (\ W g i i' -> sEq W g i i') ;

    -- pnew is uniform
    pathN : Id (KP.PC2.TT.EI Y) (KP.PC2.TT.E.act Y X h (QX.xh2, NX.pnew)) (QY.xh2, NY.pnew) =
      transH (KP.PC2.comp.kunif Y X h QX.xh2 NX.side)
        (KP.PC2.RCP.kop-cong KP.PC2.comp Y (CP2.TV.E.act Y X h QX.xh2) QY.xh2 xhE (CP2.PT.rside Y X h QX.xh2 NX.side) NY.side pSE) ;

    opaque uE ; opaque u'E ; opaque ellE ; opaque bnE ; opaque xhE ; opaque sEq ; opaque pSE ; opaque pathN ;
  } ;

  ----------------------------------------------------------------------
  -- the equivalence structure of tr

  kop (X : Ob) (w : HF.TA.EI X) (p : FP.Side[X, w]) : HF.TF.T X w = Bx[X, w, p].kop ;

  kside (X : Ob) (w : HF.TA.EI X) (p : FP.Side[X, w]) (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f)
    : Id (HF.TF.EI W) (HF.TF.E.act W X f (w, kop X w p)) (p.pv W f h) = Sd[X, w, p, W, f, h].kside ;

  module Un (Y X : Ob) (h : Hom Y X) (w : HF.TA.EI X) (p : FP.Side[X, w]) {
    module XB = Bx[X, w, p] ;
    module YB = Bx[Y, HF.TA.E.act Y X h w, FP.rside Y X h w p] ;
    module UB = BU[Y, X, h, w, p] ;
    module UP = PU[Y, X, h, w, p] ;

    ql (W : Ob) (g : Hom W Y) (i : Hom W Iv) : Id (HF.TA.EI W) (XB.t W (compH W Y X h g) i) (YB.t W g i) =
      EK1.tv-eq W (XB.t W (compH W Y X h g) i) (YB.t W g i)
        (symH (GIL.actC W Y X h g w.1))
        (transH (XB.t-rd W (compH W Y X h g) i)
          (transH (apH (\ z -> z.2.1.1 W g i) UP.pathN) (symH (YB.t-rd W g i)))) ;

    res : Id (HF.TF.EI Y) (HF.TF.E.act Y X h (w, kop X w p)) (HF.TA.E.act Y X h w, kop Y (HF.TA.E.act Y X h w) (FP.rside Y X h w p)) =
      HF.fibE-eq Y (HF.TF.E.act Y X h (w, kop X w p)) (HF.TA.E.act Y X h w, kop Y (HF.TA.E.act Y X h w) (FP.rside Y X h w p))
        (refl (HF.TA.E.act Y X h w))
        (transH (HF.fibB-act Y X h (w, kop X w p)) UB.bnN)
        ql ;

    opaque ql ;
  } ;

  kunif (Y X : Ob) (h : Hom Y X) (w : HF.TA.EI X) (p : FP.Side[X, w])
    : Id (HF.TF.EI Y) (HF.TF.E.act Y X h (w, kop X w p)) (HF.TA.E.act Y X h w, kop Y (HF.TA.E.act Y X h w) (FP.rside Y X h w p)) =
    Un[Y, X, h, w, p].res ;

  opaque kside ; opaque kunif ;

  trEquiv : CEquiv[l].EquivOp T1.FG.GI T1.SB T1.SA T1.tr =
    new CPartial[l].Rel[HF.EA, HF.FibT, HF.FibT, CPartial[l].pmap-id HF.EA HF.FibT].RC[kop, kside, kunif] ;
} ;

-- the compositions of a fibration structure in the direction d and back
caOf (G : PCtx) (A : PTy[G]) : (d : Bool) -> CLine[l].Lines[G, A].Fib -> CLine[l].Lines[G, A].CompK[src d, tgt d].Comp = split {
  true -> \ c -> c.1 ;
  false -> \ c -> c.2 } ;

cbOf (G : PCtx) (A : PTy[G]) : (d : Bool) -> CLine[l].Lines[G, A].Fib -> CLine[l].Lines[G, A].CompK[tgt d, src d].Comp = split {
  true -> \ c -> c.2 ;
  false -> \ c -> c.1 } ;

-- transport along the universal line of a fibrant type, in the direction d
module TrF (G : PCtx) (A : PTy[G]) (c : CLine[l].Lines[G, A].Fib) (d : Bool) {
  module T = TrE[G, A, d, caOf G A d c, cbOf G A d c, c.1] ;
  SB : PTy[T.T1.FG.GI] = T.T1.SB ;
  SA : PTy[T.T1.FG.GI] = T.T1.SA ;
  tr : CPartial[l].PMap[T.T1.FG.GI, SB, SA] = T.T1.tr ;
  trEquiv : CEquiv[l].EquivOp T.T1.FG.GI SB SA tr = T.trEquiv ;
} ;
