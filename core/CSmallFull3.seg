-- CSmallFull3.seg (L6, inside CB, Cl = Fib): (C2), part 3, and the
-- classifier inputs of univalence for Cl = Fib (model.tex Construction
-- "universal univalence datum").  Given El's fibration and lem:el-yon
-- (El moved along the Yoneda cart of F is F's fibration):
--
--   smallCl       the small Ext's fibration along l (CExtSmall.fibExt)
--   smallCl-sub   (C1): CSmallSub
--   smallCl-full  (C2): (T , fibExt) = (Fb.1 , moved along the transport
--                 cart) (lem:tr-move); the composite of carts into Ext_U
--                 is Kb then fromB (P3); Ext's fibration along fromB is
--                 B's (lem:full-move (iii)); B's is El's along bmap; Kb
--                 then Sub is the Yoneda cart (P5); lem:el-yon.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module P2 = Paths[a++] ;
open Trees[a] ;
open Arith[a] ;
module W1 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L = GPre[a+].PS ;
open GYon[a] ;

module F3 (elFib : CLine[a+].Lines[CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].UCtx, CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].EGen].Fib)
  (yonH : (Z : Ob) (F : CUniv.Univ[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].U0 Z)
     -> Id (CLine[a].Lines[yP Z, F.1].Fib) (CYonCart.YC[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].Yc[Z, F].K.moveFib elFib) F.2)
  (W0 : Ob) (y : CGlueE.GE[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl].GD1 W0) (q : IsT (CGlueD.fl W0 y.1.2.1 W0 (idH W0))) {
  module B2 = CSmallFull2.F2[CFibCl.Cl, CFibCl.clSub, CFibCl.clSub-id, CFibCl.clSub-o, CFibCl.encCl, elFib, W0, y, q] ;
  module A = B2.A ;
  Fb1 : PTy[yP W0] = A.Fb.1 ;
  module TR = CTrFib[a].TR[yP W0, A.T] ;
  P : Id (PTy[yP W0]) A.T Fb1 = symH B2.tyEq ;
  c0 : CLine[a].Lines[yP W0, A.T].Fib = A.XS.fibExt (yP W0) A.l ;
  e : CLine[a+].Lines[A.UB.GDr, A.UB.ExtBig].Fib = A.XS.FU.extFibU ;

  module K = CCart[a, a].Cart[yP W0, Fb1, yP W0, A.T, \ W x -> x, \ V W g x -> refl ((yP W0).act V W g x), TR.ta Fb1 P, \ W v -> refl v.1, TR.tanat Fb1 P, TR.tainj Fb1 P, TR.fwV Fb1 P, TR.bkta Fb1 P] ;
  module K2 = CCartLaws2[a, a, a+].CC[yP W0, Fb1, yP W0, A.T, A.UB.GDr, A.UB.ExtBig, \ W x -> x, \ V W g x -> refl ((yP W0).act V W g x), TR.ta Fb1 P, \ W v -> refl v.1, TR.tanat Fb1 P, TR.tainj Fb1 P, TR.fwV Fb1 P, TR.bkta Fb1 P, B2.K1.s, B2.K1.s-nat, B2.K1.ta, B2.K1.tapt, B2.K1.tanat, B2.K1.tainj, B2.K1.bk, B2.K1.bkta] ;
  module KS = CCartLaws2[a, a+, a+].CC[yP W0, Fb1, A.RES, A.UB.BU, A.UU.UCtx, A.UU.EGen, A.sb, A.sb-nat, A.tb, \ W v -> refl (A.sb W v.1), A.tbnat, A.tbinj, A.bkb, A.bkbta, A.UB.bmap.nt, A.UB.bmap.nt-nat, A.Sub.SE.mV, \ W v -> refl (A.UB.bmap.nt W v.1), A.Sub.SE.mV-nat, A.Sub.SE.mV-inj, \ X x u -> u, \ X x u -> refl (A.UB.bmap.nt X x, u)] ;

  chain : Id (CLine[a].Lines[yP W0, Fb1].Fib) (K.moveFib c0) A.Fb.2 =
    calc (CLine[a].Lines[yP W0, Fb1].Fib) {
        K.moveFib c0
      =< apH K.moveFib (B2.K1.compFib e) >
        K2.C1.moveFib (K2.C2.moveFib e)
      =< K2.compFib e >
        K2.C12.moveFib e
      =< CCartLaws2[a, a, a+].CG[yP W0, Fb1, A.UB.GDr, A.UB.ExtBig, K2.s, K2.s-nat, K2.ta, K2.tapt, K2.tanat, K2.tainj, K2.bk, K2.bkta, B2.KB.s, B2.KB.s-nat, B2.KB.ta, B2.KB.tapt, B2.KB.tanat, B2.KB.tainj, B2.KB.bk, B2.KB.bkta,
           \ W x -> refl (K2.s W x),
           \ W v -> transH (apH (\ t -> B2.K1.ta W (v.1, t)) (TR.tr-pw Fb1 P W v.1 (B2.AtG[W, v.1].Po1) v.2)) (B2.AtG[W, v.1].P3 v.2)].congFib e >
        B2.KB.C12.moveFib e
      =< symH (B2.KB.compFib e) >
        B2.KB.C1.moveFib (B2.FF.Ca.moveFib B2.FF.T7.extFib)
      =< P2.apH B2.KB.C1.moveFib B2.FF.law >
        KS.C1.moveFib (KS.C2.moveFib elFib)
      =< KS.compFib elFib >
        KS.C12.moveFib elFib
      =< CCartLaws2[a, a, a+].CG[yP W0, Fb1, A.UU.UCtx, A.UU.EGen, KS.s, KS.s-nat, KS.ta, KS.tapt, KS.tanat, KS.tainj, KS.bk, KS.bkta, A.Y.s, A.Y.s-nat, A.Y.ta, \ W v -> refl (A.Y.s W v.1), A.Y.tanat, A.Y.tainj, A.Y.bk, A.Y.bkta,
           \ W g -> A.cc W g, \ W v -> A.P5 W v].congFib elFib >
        A.Y.K.moveFib elFib
      =< yonH W0 A.Fb >
        A.Fb.2 } ;

  -- (C2)
  law : Id (A.UU.U0 W0) (A.T, c0) A.Fb =
    transH (TR.law Fb1 P c0) (apH {CLine[a].Lines[yP W0, Fb1].Fib} {(T : PTy[yP W0]) * CLine[a].Lines[yP W0, T].Fib} (\ z -> (Fb1, z)) chain) ;
} ;
