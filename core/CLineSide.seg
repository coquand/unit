-- CLineSide.seg (L3, inside CB, level l): a side of a filling problem
-- (an element of the strict fibres of ev e over x) from a family of lines
-- t V f i over x f ending at x f, natural in (V , f).
--
-- Quarry: seg/model GMapLine.LineSide, on families.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module LineSide (G : PCtx) (A : PTy[G]) (e : IPt) (X : Ob)
  (x : CLine[l].EndKit[G, A, e].TV.EI X) (Q : Phi X)
  (t : (V : Ob) (f : Hom V X) (i : Lands V X Q f) (W : Ob) -> Hom W V -> Hom W Iv -> GPR.TyL[G, A].EI W)
  (tp : (V : Ob) (f : Hom V X) (i : Lands V X Q f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
        -> Id (W0.Ix (G.ob W)) (t V f i W g j).1 ((CLine[l].FC[G].actF V X f x.1).1 W g j))
  (tn : (V : Ob) (f : Hom V X) (i : Lands V X Q f) (W' W : Ob) (g' : Hom W' W) (g : Hom W V) (j : Hom W Iv)
        -> Id (GPR.TyL[G, A].EI W') (GPR.TyL[G, A].E.act W' W g' (t V f i W g j)) (t V f i W' (compH W' W V g g') (compH W' W Iv j g')))
  (t1 : (V : Ob) (f : Hom V X) (i : Lands V X Q f)
        -> Id (GPR.TyL[G, A].EI V) (t V f i V (idH V) (ptH V e))
              (CLine[l].EndKit[G, A, e].endE V (CLine[l].EndKit[G, A, e].TV.E.act V X f x)))
  (tr : (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X Q f) (i' : Lands V' X Q (compH V' V X f chi))
        (W : Ob) (g : Hom W V') (j : Hom W Iv)
        -> Id (GPR.TyL[G, A].EI W) (t V' (compH V' V X f chi) i' W g j) (t V f i W (compH W V' V chi g) j)) {
  module KA = CLine[l].EndKit[G, A, e] ;
  module FG = CLine[l].FC[G] ;
  module FA = CLine[l].FT[G, A] ;
  module TA = GPR.TyL[G, A] ;

  L (V : Ob) (f : Hom V X) (i : Lands V X Q f) : KA.TL.EI V =
    (FG.actF V X f x.1, FA.lamA V (FG.actF V X f x.1) (t V f i) (tp V f i) (tn V f i)) ;

  qE (V : Ob) (f : Hom V X) (i : Lands V X Q f)
    : Id (TA.EI V) (KA.endE V (FA.Ev[e].evA.mE V (L V f i))) (KA.endE V (KA.TV.E.act V X f x)) =
    transH (FA.Ev[e].endB-E V (L V f i)) (t1 V f i) ;

  sv (V : Ob) (f : Hom V X) (i : Lands V X Q f) : KA.TS.EI V =
    KA.mkTS V (KA.TV.E.act V X f x) (L V f i) (refl (FG.actF V X f x.1)) (qE V f i) ;

  sv-pt (V : Ob) (f : Hom V X) (i : Lands V X Q f) : Id (KA.TV.EI V) (sv V f i).1 (KA.TV.E.act V X f x) =
    KA.mkTS-pt V (KA.TV.E.act V X f x) (L V f i) (refl (FG.actF V X f x.1)) (qE V f i) ;

  -- the values of the line of a side are t
  sv-val (V : Ob) (f : Hom V X) (i : Lands V X Q f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
    : Id (TA.EI W) ((KA.lineL V (sv V f i)).2.1.1 W g j) (t V f i W g j) =
    apH (\ M -> M.2.1.1 W g j) (KA.mkTS-line V (KA.TV.E.act V X f x) (L V f i) (refl (FG.actF V X f x.1)) (qE V f i)) ;

  pnat (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X Q f) (i' : Lands V' X Q (compH V' V X f chi))
    : Id (KA.TS.EI V') (KA.TS.E.act V' V chi (sv V f i)) (sv V' (compH V' V X f chi) i') =
    KA.ts-ext V' (KA.TS.E.act V' V chi (sv V f i)) (sv V' (compH V' V X f chi) i')
      (transH (apH (KA.TV.E.act V' V chi) (sv-pt V f i))
        (transH (KA.TV.PE.actC V' V X f chi x) (symH (sv-pt V' (compH V' V X f chi) i'))))
      (\ W g j -> transH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act V' V chi (sv V f i)))
                   (transH (sv-val V f i W (compH W V' V chi g) j)
                     (transH (symH (tr V' V chi f i i' W g j)) (symH (sv-val V' (compH V' V X f chi) i' W g j))))) ;

  opaque sv-pt ; opaque sv-val ; opaque pnat ;

  side : KA.PT.Side[X, x] = new KA.PT.Side[X, x, Q, sv, sv-pt, pnat] ;
} ;
