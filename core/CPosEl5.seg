-- CPosEl5.seg (L8, posets): lem:el-yon, El along a Yoneda code.  For F in
-- U(Z), El's fibration moved along the Yoneda cart of F is F's.  By Move's
-- uniqueness: at a point x of F's line context, the glued extension of El
-- is that of the code at the generic point of X * [1], which is F along
-- the line L (L at the generic point), whose structure is F's moved
-- (kopMv); the Yoneda cart of F along L is the Yoneda cart of F after the
-- substitution cart (pointwise: uAct-o); and the moved point and side are
-- x and its side.
--
-- Quarry: seg/model PElYon, PElYonA, PElYonB, PElYon2.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module P2 = Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module E2 = CPosEl2[a] ;
module E4 = CPosEl4[a] ;
module PB = E1.PB ;
module UU = E1.UU ;
module YG = E1.YG ;

module EY (e e' : El Iv)
  (sel : (Z : Ob) (F : UU.U0 Z) -> PB.CLine[a].Lines[E1.yP Z, F.1].CompK[e, e'].Comp)
  (selEq : (Z' Z : Ob) (g : Hom Z' Z) (F : UU.U0 Z)
     -> Id (PB.CLine[a].Lines[E1.yP Z', (UU.uAct Z' Z g F).1].CompK[e, e'].Comp) (sel Z' (UU.uAct Z' Z g F))
           (PB.CFibSub[a].FibSub[E1.yP Z', E1.yP Z, PB.GYon[a].yH Z' Z g, F.1].C.MoveComp[e, e'].move (sel Z F)))
  (Z : Ob) (F : UU.U0 Z) (ce : PB.CLine[a].Lines[E1.yP Z, F.1].CompK[e, e'].Comp)
  (selF : (X' : Ob) (k : Hom X' Z)
     -> Id (PB.CLine[a].Lines[E1.yP X', (UU.uAct X' Z k F).1].CompK[e, e'].Comp) (sel X' (UU.uAct X' Z k F))
           (PB.CFibSub[a].FibSub[E1.yP X', E1.yP Z, PB.GYon[a].yH X' Z k, F.1].C.MoveComp[e, e'].move ce)) {
  module Y = YG.Yc[Z, F] ;
  module M = Y.K.MoveComp[e, e'] ;
  module EF = E4.EF[e, e', sel, selEq] ;
  module GL = EF.GL ;
  module TFZ = PB.GPre[a].TyL[E1.yP Z, F.1] ;
  module RF = PB.CPartial[a].Rel[M.E.EK'.TV.E, M.E.EK'.SFm.SF, M.CK'.Tend, M.CK'.endL] ;

  -- pairs of F.1 over a path of points, through any path of fibres
  pairV (W : Ob) (p p' : Hom W Z) (P : Id (Hom W Z) p p') (b : W0.Ix (F.1.tob W p)) (b' : W0.Ix (F.1.tob W p'))
    (c : Id W0.V (F.1.tob W p) (F.1.tob W p')) (H : Id (W0.Ix (F.1.tob W p')) (PB.CExtEq1.sV (F.1.tob W p) (F.1.tob W p') c b) b')
    : Id (TFZ.EI W) (p, b) (p', b') =
    idJ (Hom W Z) p
      (\ p2 P2 -> (b2 : W0.Ix (F.1.tob W p2)) (c2 : Id W0.V (F.1.tob W p) (F.1.tob W p2))
         -> Id (W0.Ix (F.1.tob W p2)) (PB.CExtEq1.sV (F.1.tob W p) (F.1.tob W p2) c2 b) b2 -> Id (TFZ.EI W) (p, b) (p2, b2))
      (\ b2 c2 H2 -> apH {W0.Ix (F.1.tob W p)} {TFZ.EI W} (\ z -> (p, z))
         (transH (symH (UU.loopV (F.1.tob W p) c2 b)) H2))
      p' P b' c H ;

  -- the substitution cart along k
  module CS (X' : Ob) (k : Hom X' Z) {
    module FS = PB.CFibSub[a].FibSub[E1.yP X', E1.yP Z, PB.GYon[a].yH X' Z k, F.1] ;
    s : PB.GPre[a].PS.PSub[E1.yP X', E1.yP Z] = PB.GYon[a].yH X' Z k ;
    module SE = FS.SE ;
  } ;

  module Pt (X : Ob) (x : M.E.EK'.TV.EI X) (sd : M.E.EK'.PT.Side[X, x]) {
    XI : Ob = prodP X Iv ;
    xi : M.E.EK.TV.EI X = M.E.sV X x ;
    ms : M.E.EK.PT.Side[X, xi] = M.mside EF.comp X x sd ;
    L : Hom XI Z = x.1.1 XI (pr1 X Iv) (pr2 X Iv) ;
    F' : UU.U0 XI = E2.FC X xi.1 ;
    module Y' = YG.Yc[XI, F'] ;
    module M' = Y'.K.MoveComp[e, e'] ;
    module P0 = E2.Pt[e, X, xi.1, F', E2.QdC X xi.1, xi.2] ;
    o : M'.E.EK'.TV.EI X = P0.o ;
    sLs : M'.E.EK'.PT.Side[X, o] = GL.sL X xi ms ;

    module CSp = PB.CCart[a, a].Cart[E1.yP XI, F'.1, E1.yP Z, F.1, (CS[XI, L].s.nt), (CS[XI, L].s.nt-nat), CS[XI, L].SE.mV, \ W v -> refl ((CS[XI, L].s).nt W v.1), CS[XI, L].SE.mV-nat, CS[XI, L].SE.mV-inj, \ X0 x0 u -> u, \ X0 x0 u -> refl ((CS[XI, L].s).nt X0 x0, u)] ;
    module Ms = CSp.MoveComp[e, e'] ;
    cong2 : Id (M'.CK'.Comp) (CS[XI, L].FS.C.MoveComp[e, e'].move ce) (Ms.move ce) =
      refl (Ms.move ce) ;

    module KC = PB.CCartLaws2[a, a, a+].CC[E1.yP XI, F'.1, E1.yP Z, F.1, UU.UCtx, UU.EGen, (CS[XI, L].s.nt), (CS[XI, L].s.nt-nat), CS[XI, L].SE.mV, \ W v -> refl ((CS[XI, L].s).nt W v.1), CS[XI, L].SE.mV-nat, CS[XI, L].SE.mV-inj, \ X0 x0 u -> u, \ X0 x0 u -> refl ((CS[XI, L].s).nt X0 x0, u),
      Y.s, Y.s-nat, Y.ta, \ W v -> refl (Y.s W v.1), Y.tanat, Y.tainj, Y.bk, Y.bkta] ;

    Ps (W : Ob) (h : Hom W XI) : Id (UU.U0 W) (Y'.s W h) (KC.s W h) = symH (UU.uAct-o W XI Z L h F) ;

    Pta (W : Ob) (v : PB.GPre[a].TyL[E1.yP XI, F'.1].EI W) : Id (YG.TE.EI W) (Y'.ta W v) (KC.ta W v) =
      YG.pairE W (Y'.s W v.1) (KC.s W v.1) (Ps W v.1) (Y'.ta W v).2 (KC.ta W v).2
        (transH (UU.substF W (Y'.s W v.1) (KC.s W v.1) (Ps W v.1) (Y'.ta W v).2)
          (PB.CExtEq1.sV-two (F'.1.tob W v.1) (UU.fib0 W (Y'.s W v.1)) (UU.fib0 W (KC.s W v.1))
             (symH (Y'.Po W v.1)) (apH (UU.fib0 W) (Ps W v.1)) (symH (Y.Po W (KC.s1 W v.1))) v.2)) ;

    module CG = PB.CCartLaws2[a, a, a+].CG[E1.yP XI, F'.1, UU.UCtx, UU.EGen,
      Y'.s, Y'.s-nat, Y'.ta, \ W v -> refl (Y'.s W v.1), Y'.tanat, Y'.tainj, Y'.bk, Y'.bkta,
      KC.s, KC.s-nat, KC.ta, KC.tapt, KC.tanat, KC.tainj, KC.bk, KC.bkta, Ps, Pta] ;

    -- the line of the moved point is x's line
    lineP (V : Ob) (g : Hom V X) (j : Hom V Iv) : Id (Hom V Z) (compH V XI Z L (pairH X Iv V g j)) (x.1.1 V g j) =
      transH (x.1.2 V XI (pairH X Iv V g j) (pr1 X Iv) (pr2 X Iv))
        (transH (apH (\ k -> x.1.1 V k (compH V XI Iv (pr2 X Iv) (pairH X Iv V g j))) (pr1-pair X Iv V g j))
                (apH (\ k -> x.1.1 V g k) (pr2-pair X Iv V g j))) ;

    -- xi's element is x's, read in El
    xi2 : Id (W0.Ix (UU.fib0 X (Y.s X (x.1.1 X (idH X) (constH X Iv e))))) xi.2
             (PB.CExtEq1.sV (F.1.tob X (x.1.1 X (idH X) (constH X Iv e))) (UU.fib0 X (Y.s X (x.1.1 X (idH X) (constH X Iv e))))
                (symH (Y.Po X (x.1.1 X (idH X) (constH X Iv e)))) (M.E.EK'.endE X x).2) =
      YG.TE.pr-inj X (Y.s X (x.1.1 X (idH X) (constH X Iv e))) xi.2 (PB.CExtEq1.sV (F.1.tob X (x.1.1 X (idH X) (constH X Iv e))) (UU.fib0 X (Y.s X (x.1.1 X (idH X) (constH X Iv e)))) (symH (Y.Po X (x.1.1 X (idH X) (constH X Iv e)))) (M.E.EK'.endE X x).2) (M.E.sVE X x) ;

    Px : Id (M.E.EK'.TV.EI X) (Ms.E.sV X o) x =
      M.E.EK'.tv-eq X (Ms.E.sV X o) x
        (PB.CLine[a].FC[E1.yP Z].fam-eq X (CSp.sI X o.1) x.1 (\ V g j -> lineP V g j))
        (transH (Ms.E.sVE X o)
          (pairV X (compH X XI Z L P0.pe) (x.1.1 X (idH X) (constH X Iv e)) (lineP X (idH X) (constH X Iv e)) P0.b0 x.2
             (apH (F.1.tob X) (lineP X (idH X) (constH X Iv e)))
             (transH (apH (PB.CExtEq1.sV (F.1.tob X (compH X XI Z L P0.pe)) (F.1.tob X (x.1.1 X (idH X) (constH X Iv e))) (apH (F.1.tob X) (lineP X (idH X) (constH X Iv e))))
                        (apH (PB.CExtEq1.sV (UU.fib0 X (xi.1.1 X (idH X) (constH X Iv e))) (F'.1.tob X P0.pe) P0.cA) xi2))
               (transH (apH (PB.CExtEq1.sV (F.1.tob X (compH X XI Z L P0.pe)) (F.1.tob X (x.1.1 X (idH X) (constH X Iv e))) (apH (F.1.tob X) (lineP X (idH X) (constH X Iv e))))
                          (PB.CExtEq1.sV-comp (F.1.tob X (x.1.1 X (idH X) (constH X Iv e))) (UU.fib0 X (xi.1.1 X (idH X) (constH X Iv e))) (F'.1.tob X P0.pe)
                             (symH (Y.Po X (x.1.1 X (idH X) (constH X Iv e)))) P0.cA x.2))
                 (transH (PB.CExtEq1.sV-comp (F.1.tob X (x.1.1 X (idH X) (constH X Iv e))) (F'.1.tob X P0.pe) (F.1.tob X (x.1.1 X (idH X) (constH X Iv e)))
                            (transH (symH (Y.Po X (x.1.1 X (idH X) (constH X Iv e)))) P0.cA) (apH (F.1.tob X) (lineP X (idH X) (constH X Iv e))) x.2)
                         (UU.loopV (F.1.tob X (x.1.1 X (idH X) (constH X Iv e)))
                            (transH (transH (symH (Y.Po X (x.1.1 X (idH X) (constH X Iv e)))) P0.cA) (apH (F.1.tob X) (lineP X (idH X) (constH X Iv e)))) x.2)))))) ;

    side' : M.E.EK'.PT.Side[X, Ms.E.sV X o] = Ms.mside ce X o sLs ;

    evS (V : Ob) (f : Hom V X) (i : PB.Lands V X sd.pQ f) (i' : PB.Lands V X sd.pQ f)
      : Id (M.E.EK'.TS.EI V) (side'.pv V f i) (sd.pv V f i') =
      M.E.mS-inj V (side'.pv V f i) (sd.pv V f i')
        (transH (Ms.E.mSpt V (sLs.pv V f i))
          (transH (Ms.E.sV-nat V X f o) (transH (apH (M.E.EK'.TV.E.act V X f) Px) (symH (sd.ppt V f i')))))
        (calc (M.E.EK.TS.EI V) {
            M.E.mS V (Ms.E.mS V (sLs.pv V f i))
          =< KC.E[e, e', EF.comp].PmS V (sLs.pv V f i) >
            KC.C12.AtEnd[e].mS V (sLs.pv V f i)
          =< symH {M.E.EK.TS.EI V} {CG.C1.AtEnd[e].mS V (sLs.pv V f i)} {KC.C12.AtEnd[e].mS V (sLs.pv V f i)} (CG.E[e, e', EF.comp].PmS V (sLs.pv V f i)) >
            CG.C1.AtEnd[e].mS V (sLs.pv V f i)
          =< GL.Loc[X, xi, X, xi, o, GL.oio X xi, ms].pv-S V f i >
            M.E.mS V (sd.pv V f i)
          =< apH (M.E.mS V) (M.E.EK'.PT.pv-irr X x sd V f i i') >
            M.E.mS V (sd.pv V f i') }) ;

    R : Id (M.E.EK'.PT.Side[X, x]) (subst (M.E.EK'.TV.EI X) (\ z -> M.E.EK'.PT.Side[X, z]) (Ms.E.sV X o) x Px side') sd =
      M.E.EK'.PT.side-extH X (Ms.E.sV X o) x Px side' sd (refl sd.pQ) evS ;

    stepC : Id (M.TT'.EI X) (Ms.E.sV X o, ce.kop X (Ms.E.sV X o) side') (x, ce.kop X x sd) =
      RF.kop-cong ce X (Ms.E.sV X o) x Px side' sd R ;

    qq1 : Ms.TT.EI X = Ms.mT X (o, (Ms.move ce).kop X o sLs) ;
    qq2 : M.TT.EI X = M.mT X (Ms.mT X (o, (Ms.move ce).kop X o sLs)) ;
    qq3 : Id (KC.C12.MoveComp[e, e'].TT.EI X) (M.mT X (Ms.mT X (o, (Ms.move ce).kop X o sLs))) (KC.C12.MoveComp[e, e'].mT X (o, (Ms.move ce).kop X o sLs)) = KC.E[e, e', EF.comp].PmT X (o, (Ms.move ce).kop X o sLs) ;

    qq4 : Id (Ms.TT.EI X) (Ms.mT X (o, (Ms.move ce).kop X o sLs)) (Ms.E.sV X o, ce.kop X (Ms.E.sV X o) side') = Ms.kopMv ce X o sLs ;
    qq5 : Id (M.TT.EI X) (M.mT X (Ms.E.sV X o, ce.kop X (Ms.E.sV X o) side')) (M.mT X (Ms.mT X (o, (Ms.move ce).kop X o sLs))) =
      apH (M.mT X) (symH qq4) ;

    qq6 : Id (M.TT.EI X) (M.mT X (Ms.mT X (o, (Ms.move ce).kop X o sLs))) (M'.mT X (o, (Ms.move ce).kop X o sLs)) =
      transH {M.TT.EI X} {M.mT X (Ms.mT X (o, (Ms.move ce).kop X o sLs))} {KC.C12.MoveComp[e, e'].mT X (o, (Ms.move ce).kop X o sLs)} {M'.mT X (o, (Ms.move ce).kop X o sLs)}
        qq3 (symH {M.TT.EI X} {M'.mT X (o, (Ms.move ce).kop X o sLs)} {KC.C12.MoveComp[e, e'].mT X (o, (Ms.move ce).kop X o sLs)} (CG.E[e, e', EF.comp].PmT X (o, (Ms.move ce).kop X o sLs))) ;
    qq7 : Id (M.TT.EI X) (M'.mT X (o, (Ms.move ce).kop X o sLs)) (xi, EF.comp.kop X xi ms) =
      transH (apH (\ k -> M'.mT X (o, k.kop X o sLs)) (symH (transH {M'.CK'.Comp} {sel XI F'} {CS[XI, L].FS.C.MoveComp[e, e'].move ce} {Ms.move ce} (selF XI L) cong2)))
             (symH (GL.kop-E X xi ms)) ;

    H : Id (M.TT.EI X) (M.mT X (x, ce.kop X x sd)) (xi, EF.comp.kop X xi ms) =
      transH (apH (M.mT X) (symH stepC)) (transH qq5 (transH qq6 qq7)) ;
  } ;

  law : Id (M.CK'.Comp) ce (M.move EF.comp) = M.unique EF.comp ce (\ X x sd -> Pt[X, x, sd].H) ;
} ;
