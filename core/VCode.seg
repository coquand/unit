-- VCode.seg: MODEL/Poset/VCode.agda.  A code re-presented with an
-- embedding that agrees with ev is the code itself: mkV (Ix c) f inj = c
-- when f = ev c pointwise.  Used to bridge the opaque-by-arguments fibre
-- codes (Cof.resOb, Equiv.FibO, Ext.pairsV) to their raw codes, so that
-- equality of fibres across substitution is propositional, through the
-- raw codes.
--
-- Then the opaque code formers PiO, SigO, IdO, PiO3 with their element
-- interfaces: comparing two codes stops at their arguments.  Agda's
-- `opaque ... unfolding X` lemmas are stated before X is made opaque.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module W = V[a] ;

-- mkVevA / mkV-ev / mkV-f (mkV with ev is the code): V.seg

------------------------------------------------------------------------
-- Congruences for the code formers, and transport along them.  V is a
-- set, so a transport along an equality of codes only depends on the end
-- points.

substIx (X0 X1 : W.V) (P : Id W.V X0 X1) (u : W.Ix X0) : W.Ix X1 = subst W.V (\ z -> W.Ix z) X0 X1 P u ;

substV-irr (X0 X1 : W.V) (P P' : Id W.V X0 X1) (u : W.Ix X0) : Id (W.Ix X1) (substIx X0 X1 P u) (substIx X0 X1 P' u) =
  apH (\ R -> substIx X0 X1 R u) (W.isSetV X0 X1 P P') ;

SigV-cong (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) : Id W.V (W.SigV A B) (W.SigV A' B') =
  idJ W.V A (\ A2 P2 -> (B2 : W.Ix A2 -> W.V) -> ((z : W.Ix A) -> Id W.V (B z) (B2 (substIx A A2 P2 z))) -> Id W.V (W.SigV A B) (W.SigV A2 B2))
    (\ B2 Q2 -> apH (W.SigV A) (funext (W.Ix A) (\ z -> W.V) B B2 Q2))
    A' P B' Q ;

PiV-cong (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) : Id W.V (W.PiV A B) (W.PiV A' B') =
  idJ W.V A (\ A2 P2 -> (B2 : W.Ix A2 -> W.V) -> ((z : W.Ix A) -> Id W.V (B z) (B2 (substIx A A2 P2 z))) -> Id W.V (W.PiV A B) (W.PiV A2 B2))
    (\ B2 Q2 -> apH (W.PiV A) (funext (W.Ix A) (\ z -> W.V) B B2 Q2))
    A' P B' Q ;

IdV-cong (A A' : W.V) (P : Id W.V A A') (x y : W.Ix A) (x' y' : W.Ix A')
  (ex : Id (W.Ix A') (substIx A A' P x) x') (ey : Id (W.Ix A') (substIx A A' P y) y') : Id W.V (W.IdV A x y) (W.IdV A' x' y') =
  idJ W.V A (\ A2 P2 -> (x2 y2 : W.Ix A2) -> Id (W.Ix A2) (substIx A A2 P2 x) x2 -> Id (W.Ix A2) (substIx A A2 P2 y) y2
                         -> Id W.V (W.IdV A x y) (W.IdV A2 x2 y2))
    (\ x2 y2 ex2 ey2 -> idJ (W.Ix A) x (\ x3 e3 -> Id W.V (W.IdV A x y) (W.IdV A x3 y2)) (apH (W.IdV A x) ey2) x2 ex2)
    A' P x' y' ex ey ;

substSigR (A : W.V) (B B' : W.Ix A -> W.V) (R : Id (W.Ix A -> W.V) B B') (w : W.Ix (W.SigV A B))
  : Id (W.Ix (W.SigV A B')) (substIx (W.SigV A B) (W.SigV A B') (apH (W.SigV A) R) w)
                           (w.1, substIx (B w.1) (B' w.1) (apH (\ F -> F w.1) R) w.2) =
  idJ (W.Ix A -> W.V) B
    (\ B2 R2 -> Id (W.Ix (W.SigV A B2)) (substIx (W.SigV A B) (W.SigV A B2) (apH (W.SigV A) R2) w)
                                       (w.1, substIx (B w.1) (B2 w.1) (apH (\ F -> F w.1) R2) w.2))
    (refl w) B' R ;

substPiR (A : W.V) (B B' : W.Ix A -> W.V) (R : Id (W.Ix A -> W.V) B B') (f : W.Ix (W.PiV A B))
  : Id (W.Ix (W.PiV A B')) (substIx (W.PiV A B) (W.PiV A B') (apH (W.PiV A) R) f)
                          (\ z -> substIx (B z) (B' z) (apH (\ F -> F z) R) (f z)) =
  idJ (W.Ix A -> W.V) B
    (\ B2 R2 -> Id (W.Ix (W.PiV A B2)) (substIx (W.PiV A B) (W.PiV A B2) (apH (W.PiV A) R2) f)
                                      (\ z -> substIx (B z) (B2 z) (apH (\ F -> F z) R2) (f z)))
    (refl f) B' R ;

subst-SigV (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) (P' : Id W.V (W.SigV A B) (W.SigV A' B')) (w : W.Ix (W.SigV A B))
  : Id (W.Ix (W.SigV A' B')) (substIx (W.SigV A B) (W.SigV A' B') P' w) (substIx A A' P w.1, substIx (B w.1) (B' (substIx A A' P w.1)) (Q w.1) w.2) =
  idJ W.V A
    (\ A2 P2 -> (B2 : W.Ix A2 -> W.V) (Q2 : (z : W.Ix A) -> Id W.V (B z) (B2 (substIx A A2 P2 z))) (P3 : Id W.V (W.SigV A B) (W.SigV A2 B2))
       -> Id (W.Ix (W.SigV A2 B2)) (substIx (W.SigV A B) (W.SigV A2 B2) P3 w)
                                  (substIx A A2 P2 w.1, substIx (B w.1) (B2 (substIx A A2 P2 w.1)) (Q2 w.1) w.2))
    (\ B2 Q2 P3 ->
       transH (substV-irr (W.SigV A B) (W.SigV A B2) P3 (apH (W.SigV A) (funext (W.Ix A) (\ z -> W.V) B B2 Q2)) w)
        (transH (substSigR A B B2 (funext (W.Ix A) (\ z -> W.V) B B2 Q2) w)
                (apH {W.Ix (B2 w.1)} {W.Ix (W.SigV A B2)} (\ v -> (w.1, v))
                   (substV-irr (B w.1) (B2 w.1) (apH (\ F -> F w.1) (funext (W.Ix A) (\ z -> W.V) B B2 Q2)) (Q2 w.1) w.2))))
    A' P B' Q P' ;

subst-PiV (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) (P' : Id W.V (W.PiV A B) (W.PiV A' B')) (f : W.Ix (W.PiV A B)) (z : W.Ix A)
  : Id (W.Ix (B' (substIx A A' P z))) ((substIx (W.PiV A B) (W.PiV A' B') P' f) (substIx A A' P z)) (substIx (B z) (B' (substIx A A' P z)) (Q z) (f z)) =
  idJ W.V A
    (\ A2 P2 -> (B2 : W.Ix A2 -> W.V) (Q2 : (z1 : W.Ix A) -> Id W.V (B z1) (B2 (substIx A A2 P2 z1))) (P3 : Id W.V (W.PiV A B) (W.PiV A2 B2))
       -> Id (W.Ix (B2 (substIx A A2 P2 z))) ((substIx (W.PiV A B) (W.PiV A2 B2) P3 f) (substIx A A2 P2 z))
                                            (substIx (B z) (B2 (substIx A A2 P2 z)) (Q2 z) (f z)))
    (\ B2 Q2 P3 ->
       transH (apH {W.Ix (W.PiV A B2)} {W.Ix (B2 z)} (\ g -> g z)
                 (transH (substV-irr (W.PiV A B) (W.PiV A B2) P3 (apH (W.PiV A) (funext (W.Ix A) (\ z1 -> W.V) B B2 Q2)) f)
                         (substPiR A B B2 (funext (W.Ix A) (\ z1 -> W.V) B B2 Q2) f)))
              (substV-irr (B z) (B2 z) (apH (\ F -> F z) (funext (W.Ix A) (\ z1 -> W.V) B B2 Q2)) (Q2 z) (f z)))
    A' P B' Q P' ;

-- transport along mkV-ev is the identity (the index sets are the same)
smeAux (m : W.M) (i : W.isIt m) : (i' : W.isIt m) (R : Id (W.isIt m) i i') (u : W.Idx m)
  -> Id (W.Idx m) (substIx (m, i) (m, i') (apH {W.isIt m} {W.V} (\ k -> (m, k)) R) u) u = \ i' R u ->
  idJ (W.isIt m) i (\ i2 R2 -> Id (W.Idx m) (substIx (m, i) (m, i2) (apH {W.isIt m} {W.V} (\ k -> (m, k)) R2) u) u) (refl u) i' R ;

smeA : (m : W.M) (it : W.isIt m) (inj : W.Inj (W.Ix (m, it)) (W.ev (m, it)))
  (P : Id W.V (W.mkV (W.Ix (m, it)) (W.ev (m, it)) inj) (m, it)) (u : W.Idx m)
  -> Id (W.Idx m) (substIx (W.mkV (W.Ix (m, it)) (W.ev (m, it)) inj) (m, it) P u) u = split {
  sup A f -> \ it inj P u ->
    transH (substV-irr (W.mkV (W.Ix (sup A f, it)) (W.ev (sup A f, it)) inj) (sup A f, it) P (W.mkV-ev (sup A f, it) inj) u)
           (smeAux (sup A f) (W.mkV (W.Ix (sup A f, it)) (W.ev (sup A f, it)) inj).2 it
              (W.isProp-isIt (sup A f) (W.mkV (W.Ix (sup A f, it)) (W.ev (sup A f, it)) inj).2 it) u) } ;

subst-mkV-ev (c : W.V) (inj : W.Inj (W.Ix c) (W.ev c)) (P : Id W.V (W.mkV (W.Ix c) (W.ev c) inj) c) (u : W.Ix c)
  : Id (W.Ix c) (substIx (W.mkV (W.Ix c) (W.ev c) inj) c P u) u = smeA c.1 c.2 inj P u ;

------------------------------------------------------------------------
-- Opaque code formers (Pi and Sigma), with their element interfaces.

PiO (A : W.V) (B : W.Ix A -> W.V) : W.V = W.PiV A B ;

lamO {A : W.V} {B : W.Ix A -> W.V} (f : (z : W.Ix A) -> W.Ix (B z)) : W.Ix (PiO A B) = f ;

appO {A : W.V} {B : W.Ix A -> W.V} (f : W.Ix (PiO A B)) (z : W.Ix A) : W.Ix (B z) = f z ;

appO-lamO {A : W.V} {B : W.Ix A -> W.V} (f : (z : W.Ix A) -> W.Ix (B z)) (z : W.Ix A)
  : Id (W.Ix (B z)) (appO {A} {B} (lamO {A} {B} f) z) (f z) = refl (f z) ;

PiO-ext {A : W.V} {B : W.Ix A -> W.V} (f g : W.Ix (PiO A B)) (P : (z : W.Ix A) -> Id (W.Ix (B z)) (appO {A} {B} f z) (appO {A} {B} g z))
  : Id (W.Ix (PiO A B)) f g = funext (W.Ix A) (\ z -> W.Ix (B z)) f g P ;

PiO-cong (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) : Id W.V (PiO A B) (PiO A' B') = PiV-cong A A' P B B' Q ;

subst-PiO (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) (P' : Id W.V (PiO A B) (PiO A' B')) (f : W.Ix (PiO A B)) (z : W.Ix A)
  : Id (W.Ix (B' (substIx A A' P z))) (appO {A'} {B'} (substIx (PiO A B) (PiO A' B') P' f) (substIx A A' P z))
                                     (substIx (B z) (B' (substIx A A' P z)) (Q z) (appO {A} {B} f z)) =
  subst-PiV A A' P B B' Q P' f z ;

PiO-def (A : W.V) (B : W.Ix A -> W.V) : Id W.V (PiO A B) (W.PiV A B) = refl (W.PiV A B) ;

PiO-prop {A : W.V} {B : W.Ix A -> W.V} (P : (z : W.Ix A) -> isProp (W.Ix (B z))) : isProp (W.Ix (PiO A B)) =
  isProp-Pi (W.Ix A) (\ z -> W.Ix (B z)) P ;

opaque PiO ; opaque lamO ; opaque appO ; opaque appO-lamO ; opaque PiO-ext ; opaque PiO-cong ; opaque subst-PiO ;
opaque PiO-def ; opaque PiO-prop ;

SigO (A : W.V) (B : W.Ix A -> W.V) : W.V = W.SigV A B ;

pairO {A : W.V} {B : W.Ix A -> W.V} (z : W.Ix A) (b : W.Ix (B z)) : W.Ix (SigO A B) = (z, b) ;

fstO {A : W.V} {B : W.Ix A -> W.V} (w : W.Ix (SigO A B)) : W.Ix A = w.1 ;

sndO {A : W.V} {B : W.Ix A -> W.V} (w : W.Ix (SigO A B)) : W.Ix (B (fstO {A} {B} w)) = w.2 ;

fstO-pair {A : W.V} {B : W.Ix A -> W.V} (z : W.Ix A) (b : W.Ix (B z)) : Id (W.Ix A) (fstO {A} {B} (pairO {A} {B} z b)) z = refl z ;

-- the pair of the components, read in a Sigma type
pairO-E {A : W.V} {B : W.Ix A -> W.V} (z : W.Ix A) (b : W.Ix (B z))
  : Id ((x : W.Ix A) * W.Ix (B x)) (fstO {A} {B} (pairO {A} {B} z b), sndO {A} {B} (pairO {A} {B} z b)) (z, b) = refl (z, b) ;

SigO-eta {A : W.V} {B : W.Ix A -> W.V} (w : W.Ix (SigO A B))
  : Id (W.Ix (SigO A B)) (pairO {A} {B} (fstO {A} {B} w) (sndO {A} {B} w)) w = refl w ;

SigO-cong (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) : Id W.V (SigO A B) (SigO A' B') = SigV-cong A A' P B B' Q ;

subst-SigO (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V)
  (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z))) (P' : Id W.V (SigO A B) (SigO A' B')) (w : W.Ix (SigO A B))
  : Id ((x : W.Ix A') * W.Ix (B' x))
       (fstO {A'} {B'} (substIx (SigO A B) (SigO A' B') P' w), sndO {A'} {B'} (substIx (SigO A B) (SigO A' B') P' w))
       (substIx A A' P (fstO {A} {B} w), substIx (B (fstO {A} {B} w)) (B' (substIx A A' P (fstO {A} {B} w))) (Q (fstO {A} {B} w)) (sndO {A} {B} w)) =
  subst-SigV A A' P B B' Q P' w ;

SigO-def (A : W.V) (B : W.Ix A -> W.V) : Id W.V (SigO A B) (W.SigV A B) = refl (W.SigV A B) ;

SigO-ext {A : W.V} {B : W.Ix A -> W.V} (w w' : W.Ix (SigO A B)) (P : Id (W.Ix A) (fstO {A} {B} w) (fstO {A} {B} w'))
  (Q : Id (W.Ix (B (fstO {A} {B} w'))) (subst (W.Ix A) (\ z -> W.Ix (B z)) (fstO {A} {B} w) (fstO {A} {B} w') P (sndO {A} {B} w)) (sndO {A} {B} w'))
  : Id (W.Ix (SigO A B)) w w' =
  idJ (W.Ix A) w.1
    (\ a2 P2 -> (b2 : W.Ix (B a2)) -> Id (W.Ix (B a2)) (subst (W.Ix A) (\ z -> W.Ix (B z)) w.1 a2 P2 w.2) b2 -> Id (W.Ix (SigO A B)) w (a2, b2))
    (\ b2 Q2 -> apH {W.Ix (B w.1)} {W.Ix (SigO A B)} (\ v -> (w.1, v)) Q2)
    w'.1 P w'.2 Q ;

SigO-prop {A : W.V} {B : W.Ix A -> W.V} (pA : isProp (W.Ix A)) (pB : (z : W.Ix A) -> isProp (W.Ix (B z))) : isProp (W.Ix (SigO A B)) =
  isProp-Sigma (W.Ix A) (\ z -> W.Ix (B z)) pA pB ;

-- the components of a pair (stated without the dependent first projection)
fstO-pairO {A : W.V} {B : W.Ix A -> W.V} (z : W.Ix A) (b : W.Ix (B z)) : Id (W.Ix A) (fstO {A} {B} (pairO {A} {B} z b)) z = refl z ;

-- the first component of the second component of a pair, when it does not depend on the first
fst2-pairO {A F : W.V} {C : W.Ix A -> W.Ix F -> W.V} (z : W.Ix A) (r : W.Ix (SigO F (C z)))
  : Id (W.Ix F) (fstO {F} {C (fstO {A} {\ x -> SigO F (C x)} (pairO {A} {\ x -> SigO F (C x)} z r))}
                      (sndO {A} {\ x -> SigO F (C x)} (pairO {A} {\ x -> SigO F (C x)} z r)))
                (fstO {F} {C z} r) = refl r.1 ;

-- a pair of the components
pairO-fst-snd {A : W.V} {B : W.Ix A -> W.V} (w : W.Ix (SigO A B))
  : Id (W.Ix (SigO A B)) (pairO {A} {B} (fstO {A} {B} w) (sndO {A} {B} w)) w = refl w ;

opaque SigO ; opaque pairO ; opaque fstO ; opaque sndO ; opaque fstO-pair ; opaque pairO-E ; opaque SigO-eta ;
opaque SigO-cong ; opaque subst-SigO ; opaque SigO-def ; opaque SigO-ext ; opaque SigO-prop ; opaque fstO-pairO ;
opaque fst2-pairO ; opaque pairO-fst-snd ;

IdO (A : W.V) (x y : W.Ix A) : W.V = W.IdV A x y ;

idO-in {A : W.V} {x y : W.Ix A} (e : Id (W.Ix A) x y) : W.Ix (IdO A x y) = e ;

idO-out {A : W.V} {x y : W.Ix A} (e : W.Ix (IdO A x y)) : Id (W.Ix A) x y = e ;

IdO-prop {A : W.V} {x y : W.Ix A} : isProp (W.Ix (IdO A x y)) = W.isSetIx A x y ;

IdO-cong (A A' : W.V) (P : Id W.V A A') (x y : W.Ix A) (x' y' : W.Ix A')
  (ex : Id (W.Ix A') (substIx A A' P x) x') (ey : Id (W.Ix A') (substIx A A' P y) y') : Id W.V (IdO A x y) (IdO A' x' y') =
  IdV-cong A A' P x y x' y' ex ey ;

opaque IdO ; opaque idO-in ; opaque idO-out ; opaque IdO-prop ; opaque IdO-cong ;

------------------------------------------------------------------------
-- Three nested Pi codes as one opaque former: families are flat
-- functions, so comparing two such codes compares small terms only.

-- the families of the nested codes
F3B (A : W.V) (B : W.Ix A -> W.V) (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V)
  (z : W.Ix A) : W.V = PiO (B z) (\ b -> PiO (C z b) (D z b)) ;

PiO3 (A : W.V) (B : W.Ix A -> W.V) (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) : W.V =
  PiO A (F3B A B C D) ;

app3 {A : W.V} {B : W.Ix A -> W.V} {C : (z : W.Ix A) -> W.Ix (B z) -> W.V} {D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V}
  (f : W.Ix (PiO3 A B C D)) (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) : W.Ix (D z b c) =
  appO {C z b} {D z b} (appO {B z} {\ b1 -> PiO (C z b1) (D z b1)} (appO {A} {F3B A B C D} f z) b) c ;

lam3 {A : W.V} {B : W.Ix A -> W.V} {C : (z : W.Ix A) -> W.Ix (B z) -> W.V} {D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V}
  (F : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> W.Ix (D z b c)) : W.Ix (PiO3 A B C D) =
  lamO {A} {F3B A B C D} (\ z -> lamO {B z} {\ b -> PiO (C z b) (D z b)} (\ b -> lamO {C z b} {D z b} (\ c -> F z b c))) ;

app3-lam3 {A : W.V} {B : W.Ix A -> W.V} {C : (z : W.Ix A) -> W.Ix (B z) -> W.V} {D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V}
  (F : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> W.Ix (D z b c)) (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
  : Id (W.Ix (D z b c)) (app3 {A} {B} {C} {D} (lam3 {A} {B} {C} {D} F) z b c) (F z b c) =
  transH (apH {W.Ix (F3B A B C D z)} {W.Ix (D z b c)} (\ y -> appO {C z b} {D z b} (appO {B z} {\ b1 -> PiO (C z b1) (D z b1)} y b) c)
           (appO-lamO {A} {F3B A B C D} (\ z1 -> lamO {B z1} {\ b1 -> PiO (C z1 b1) (D z1 b1)} (\ b1 -> lamO {C z1 b1} {D z1 b1} (\ c1 -> F z1 b1 c1))) z))
   (transH (apH {W.Ix (PiO (C z b) (D z b))} {W.Ix (D z b c)} (\ y -> appO {C z b} {D z b} y c)
              (appO-lamO {B z} {\ b1 -> PiO (C z b1) (D z b1)} (\ b1 -> lamO {C z b1} {D z b1} (\ c1 -> F z b1 c1)) b))
           (appO-lamO {C z b} {D z b} (\ c1 -> F z b c1) c)) ;

PiO3-ext {A : W.V} {B : W.Ix A -> W.V} {C : (z : W.Ix A) -> W.Ix (B z) -> W.V} {D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V}
  (f g : W.Ix (PiO3 A B C D))
  (P : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> Id (W.Ix (D z b c)) (app3 {A} {B} {C} {D} f z b c) (app3 {A} {B} {C} {D} g z b c))
  : Id (W.Ix (PiO3 A B C D)) f g =
  PiO-ext {A} {F3B A B C D} f g (\ z ->
    PiO-ext {B z} {\ b -> PiO (C z b) (D z b)} (appO {A} {F3B A B C D} f z) (appO {A} {F3B A B C D} g z) (\ b ->
      PiO-ext {C z b} {D z b} (appO {B z} {\ b1 -> PiO (C z b1) (D z b1)} (appO {A} {F3B A B C D} f z) b)
                              (appO {B z} {\ b1 -> PiO (C z b1) (D z b1)} (appO {A} {F3B A B C D} g z) b) (\ c -> P z b c))) ;

PiO3-prop {A : W.V} {B : W.Ix A -> W.V} {C : (z : W.Ix A) -> W.Ix (B z) -> W.V} {D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V}
  (P : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> isProp (W.Ix (D z b c))) : isProp (W.Ix (PiO3 A B C D)) =
  PiO-prop {A} {F3B A B C D} (\ z ->
    PiO-prop {B z} {\ b -> PiO (C z b) (D z b)} (\ b -> PiO-prop {C z b} {D z b} (\ c -> P z b c))) ;

-- Agda's where-block of subst-PiO3
Q2O (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V) (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z)))
  (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (C' : (z : W.Ix A') -> W.Ix (B' z) -> W.V)
  (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A') (b : W.Ix (B' z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
       -> Id W.V (D z b c) (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
                              (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c)))
  (z : W.Ix A) (b : W.Ix (B z))
  : Id W.V (PiO (C z b) (D z b)) (PiO (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b))
                                      (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b))) =
  PiO-cong (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) (D z b)
    (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (\ c -> S z b c) ;

Q1O (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V) (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z)))
  (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (C' : (z : W.Ix A') -> W.Ix (B' z) -> W.V)
  (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A') (b : W.Ix (B' z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
       -> Id W.V (D z b c) (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
                              (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c)))
  (z : W.Ix A)
  : Id W.V (F3B A B C D z) (F3B A' B' C' D' (substIx A A' P z)) =
  PiO-cong (B z) (B' (substIx A A' P z)) (Q z) (\ b -> PiO (C z b) (D z b))
    (\ b -> PiO (C' (substIx A A' P z) b) (D' (substIx A A' P z) b)) (Q2O A A' P B B' Q C C' R D D' S z) ;

PiO3-cong (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V) (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z)))
  (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (C' : (z : W.Ix A') -> W.Ix (B' z) -> W.V)
  (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A') (b : W.Ix (B' z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
       -> Id W.V (D z b c) (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
                              (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c)))
  : Id W.V (PiO3 A B C D) (PiO3 A' B' C' D') =
  PiO-cong A A' P (F3B A B C D) (F3B A' B' C' D') (Q1O A A' P B B' Q C C' R D D' S) ;

subst-PiO3 (A A' : W.V) (P : Id W.V A A') (B : W.Ix A -> W.V) (B' : W.Ix A' -> W.V) (Q : (z : W.Ix A) -> Id W.V (B z) (B' (substIx A A' P z)))
  (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (C' : (z : W.Ix A') -> W.Ix (B' z) -> W.V)
  (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A') (b : W.Ix (B' z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
       -> Id W.V (D z b c) (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
                              (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c)))
  (P' : Id W.V (PiO3 A B C D) (PiO3 A' B' C' D')) (f : W.Ix (PiO3 A B C D)) (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
  : Id (W.Ix (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
                 (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c)))
       (app3 {A'} {B'} {C'} {D'} (substIx (PiO3 A B C D) (PiO3 A' B' C' D') P' f) (substIx A A' P z)
             (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
             (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c))
       (substIx (D z b c) (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)
                              (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c))
                (S z b c) (app3 {A} {B} {C} {D} f z b c)) =
  transH (apH {W.Ix (F3B A' B' C' D' (substIx A A' P z))} {_}
              (\ y -> appO {C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)}
                           {D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)}
                           (appO {B' (substIx A A' P z)} {\ b1 -> PiO (C' (substIx A A' P z) b1) (D' (substIx A A' P z) b1)} y
                                 (substIx (B z) (B' (substIx A A' P z)) (Q z) b))
                           (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c))
              (subst-PiO A A' P (F3B A B C D) (F3B A' B' C' D') (Q1O A A' P B B' Q C C' R D D' S) P' f z))
   (transH (apH {W.Ix (PiO (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b))
                           (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)))} {_}
                (\ y -> appO {C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)}
                             {D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)} y
                             (substIx (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) c))
                (subst-PiO (B z) (B' (substIx A A' P z)) (Q z) (\ b1 -> PiO (C z b1) (D z b1))
                   (\ b1 -> PiO (C' (substIx A A' P z) b1) (D' (substIx A A' P z) b1)) (Q2O A A' P B B' Q C C' R D D' S z)
                   (Q1O A A' P B B' Q C C' R D D' S z) (appO {A} {F3B A B C D} f z) b))
           (subst-PiO (C z b) (C' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (R z b) (D z b)
              (D' (substIx A A' P z) (substIx (B z) (B' (substIx A A' P z)) (Q z) b)) (\ c1 -> S z b c1)
              (Q2O A A' P B B' Q C C' R D D' S z b)
              (appO {B z} {\ b1 -> PiO (C z b1) (D z b1)} (appO {A} {F3B A B C D} f z) b) c)) ;

opaque F3B ; opaque PiO3 ; opaque app3 ; opaque lam3 ; opaque app3-lam3 ; opaque PiO3-ext ; opaque PiO3-prop ;
opaque Q2O ; opaque Q1O ; opaque PiO3-cong ; opaque subst-PiO3 ;

-- the same with the first level (cong2) or the first two levels (cong1)
-- fixed: no transport along refl appears in the statements
PiO3-cong2 (A : W.V) (B B' : W.Ix A -> W.V) (Q : (z : W.Ix A) -> Id W.V (B z) (B' z))
  (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (C' : (z : W.Ix A) -> W.Ix (B' z) -> W.V)
  (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' z (substIx (B z) (B' z) (Q z) b)))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A) (b : W.Ix (B' z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
       -> Id W.V (D z b c) (D' z (substIx (B z) (B' z) (Q z) b) (substIx (C z b) (C' z (substIx (B z) (B' z) (Q z) b)) (R z b) c)))
  : Id W.V (PiO3 A B C D) (PiO3 A B' C' D') = PiO3-cong A A (refl A) B B' Q C C' R D D' S ;

subst-PiO3-2 (A : W.V) (B B' : W.Ix A -> W.V) (Q : (z : W.Ix A) -> Id W.V (B z) (B' z))
  (C : (z : W.Ix A) -> W.Ix (B z) -> W.V) (C' : (z : W.Ix A) -> W.Ix (B' z) -> W.V)
  (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' z (substIx (B z) (B' z) (Q z) b)))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A) (b : W.Ix (B' z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
       -> Id W.V (D z b c) (D' z (substIx (B z) (B' z) (Q z) b) (substIx (C z b) (C' z (substIx (B z) (B' z) (Q z) b)) (R z b) c)))
  (P' : Id W.V (PiO3 A B C D) (PiO3 A B' C' D')) (f : W.Ix (PiO3 A B C D)) (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
  : Id (W.Ix (D' z (substIx (B z) (B' z) (Q z) b) (substIx (C z b) (C' z (substIx (B z) (B' z) (Q z) b)) (R z b) c)))
       (app3 {A} {B'} {C'} {D'} (substIx (PiO3 A B C D) (PiO3 A B' C' D') P' f) z (substIx (B z) (B' z) (Q z) b)
             (substIx (C z b) (C' z (substIx (B z) (B' z) (Q z) b)) (R z b) c))
       (substIx (D z b c) (D' z (substIx (B z) (B' z) (Q z) b) (substIx (C z b) (C' z (substIx (B z) (B' z) (Q z) b)) (R z b) c))
                (S z b c) (app3 {A} {B} {C} {D} f z b c)) =
  subst-PiO3 A A (refl A) B B' Q C C' R D D' S P' f z b c ;

PiO3-cong1 (A : W.V) (B : W.Ix A -> W.V)
  (C C' : (z : W.Ix A) -> W.Ix (B z) -> W.V) (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' z b))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> Id W.V (D z b c) (D' z b (substIx (C z b) (C' z b) (R z b) c)))
  : Id W.V (PiO3 A B C D) (PiO3 A B C' D') = PiO3-cong A A (refl A) B B (\ z -> refl (B z)) C C' R D D' S ;

subst-PiO3-1 (A : W.V) (B : W.Ix A -> W.V)
  (C C' : (z : W.Ix A) -> W.Ix (B z) -> W.V) (R : (z : W.Ix A) (b : W.Ix (B z)) -> Id W.V (C z b) (C' z b))
  (D : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (D' : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C' z b) -> W.V)
  (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> Id W.V (D z b c) (D' z b (substIx (C z b) (C' z b) (R z b) c)))
  (P' : Id W.V (PiO3 A B C D) (PiO3 A B C' D')) (f : W.Ix (PiO3 A B C D)) (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
  : Id (W.Ix (D' z b (substIx (C z b) (C' z b) (R z b) c)))
       (app3 {A} {B} {C'} {D'} (substIx (PiO3 A B C D) (PiO3 A B C' D') P' f) z b (substIx (C z b) (C' z b) (R z b) c))
       (substIx (D z b c) (D' z b (substIx (C z b) (C' z b) (R z b) c)) (S z b c) (app3 {A} {B} {C} {D} f z b c)) =
  subst-PiO3 A A (refl A) B B (\ z1 -> refl (B z1)) C C' R D D' S P' f z b c ;

PiO3-cong0 (A : W.V) (B : W.Ix A -> W.V) (C : (z : W.Ix A) -> W.Ix (B z) -> W.V)
  (D D' : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> Id W.V (D z b c) (D' z b c))
  : Id W.V (PiO3 A B C D) (PiO3 A B C D') = PiO3-cong A A (refl A) B B (\ z -> refl (B z)) C C (\ z b -> refl (C z b)) D D' S ;

subst-PiO3-0 (A : W.V) (B : W.Ix A -> W.V) (C : (z : W.Ix A) -> W.Ix (B z) -> W.V)
  (D D' : (z : W.Ix A) (b : W.Ix (B z)) -> W.Ix (C z b) -> W.V) (S : (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b)) -> Id W.V (D z b c) (D' z b c))
  (P' : Id W.V (PiO3 A B C D) (PiO3 A B C D')) (f : W.Ix (PiO3 A B C D)) (z : W.Ix A) (b : W.Ix (B z)) (c : W.Ix (C z b))
  : Id (W.Ix (D' z b c)) (app3 {A} {B} {C} {D'} (substIx (PiO3 A B C D) (PiO3 A B C D') P' f) z b c)
                        (substIx (D z b c) (D' z b c) (S z b c) (app3 {A} {B} {C} {D} f z b c)) =
  subst-PiO3 A A (refl A) B B (\ z1 -> refl (B z1)) C C (\ z1 b1 -> refl (C z1 b1)) D D' S P' f z b c ;

opaque PiO3-cong2 ; opaque subst-PiO3-2 ; opaque PiO3-cong1 ; opaque subst-PiO3-1 ; opaque PiO3-cong0 ; opaque subst-PiO3-0 ;
