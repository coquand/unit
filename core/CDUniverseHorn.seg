-- The horn operations of El0 and El1 agree at the included codes.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module B = CDUniverseBase[a] ;
module I = CDUniverseLift[a] ;
module C = CDUniverseCart[a] ;
module U0 = B.DC.DU ;
module U1 = B.Univ ;
module D = C.D ;
module G = C.G ;
module V0 = V[a] ;
module V1 = V[a+] ;
module H0 = CDHornFib[a, a+].DH[U0.UCtx, U0.EGen] ;
module H1 = CDHornFib[a, a++].DH[B.U1, B.El1] ;
module E0 = CDElHorn[a] ;
module E1 = CDUniverseEl[a] ;
open SmallCat[a].Homs[B.DB.obV, B.DB.homV] ;

h0 : H0.isFib = E0.elFib ;
h1 : H1.isFib = E1.elFib ;

module At (m k : Nat) (hk : B.DC.hOk (m, k)) (F : U0.U0 (suc m)) (u : H0.HornData m k F) {
  n : Nat = suc m ;
  F' : U1.U0 n = I.inc n F ;
  module D0 = E0.HE[m, F] ;
  module D1 = E1.HE[m, F'] ;
  module S = B.DB.COp[a].OpS[B.DC.HIx, B.DC.hOk, B.DC.hOb, B.DC.hS, I.Y0.yP n, F.1] ;
  module Compare = B.DB.COpLaws[a++, a++, a++].OL[B.DC.HIx, B.DC.hOk, B.DC.hOb, B.DC.hS].At[B.U1, B.El1,
    \ i -> h1 i.1 i.2] ;

  points (W : Nat) (f : Hom W n) (j : B.DB.Lands W n (B.DC.hornS m k) f)
    : Id (U1.U0 W) (I.inc W (u.1 W f j).1) (U1.uAct W n f F') =
    transH (apH (I.inc W) (u.2.1 W f j)) (I.include-nat W n f F) ;

  hu : H1.HornData m k F' =
    (\ W f j -> C.ta W (u.1 W f j),
     (points, \ V W g f i j -> transH (C.tn V W g (u.1 W f i)) (apH (C.ta V) (u.2.2 V W g f i j)))) ;

  fibre (W : Nat) (f : Hom W n) (j : B.DB.Lands W n (B.DC.hornS m k) f)
    : Id (V0.Ix (U0.fib0 W (U0.uAct W n f F))) (D1.E.zE W f (hu.1 W f j) (points W f j)).2
        (D0.E.zE W f (u.1 W f j) (u.2.1 W f j)).2 =
    transH (U1.substF W (I.inc W (u.1 W f j).1) (U1.uAct W n f F') (points W f j) (u.1 W f j).2)
      (transH (I.read (U0.fib0 W (u.1 W f j).1) (U0.fib0 W (U0.uAct W n f F))
        (apH (U0.fib0 W) (u.2.1 W f j)) (apH (U1.fib0 W) (points W f j)) (u.1 W f j).2)
        (symH (U0.substF W (u.1 W f j).1 (U0.uAct W n f F) (u.2.1 W f j) (u.1 W f j).2))) ;

  opaque fibre ;

  -- The identity fibre of the restricted code is the same at both levels.
  values (W : Nat) (f : Hom W n) (j : B.DB.Lands W n (B.DC.hornS m k) f)
    : Id (D0.E.TA.EI W) ((D1.hA k hu).1 W f j) ((D0.hA k u).1 W f j) =
    transH (D1.E.toA-E W f (hu.1 W f j) (points W f j))
      (transH
        (apH {V0.Ix (U0.fib0 W (U0.uAct W n f F))} {D0.E.TA.EI W}
          (\ z -> (D0.E.TA.pr W ((I.Y0.yH W n f).nt W (B.DB.idH W)) z))
          {(D1.E.zE W f (hu.1 W f j) (points W f j)).2}
          {(D0.E.zE W f (u.1 W f j) (u.2.1 W f j)).2}
          (fibre W f j))
        (symH (D0.E.toA-E W f (u.1 W f j) (u.2.1 W f j)))) ;

  input : Id (S.HData (m, k) (B.DB.idH n)) (D1.hA k hu) (D0.hA k u) =
    S.hd-eq (m, k) (B.DB.idH n) (D1.hA k hu) (D0.hA k u)
      (funext Nat (\ W -> (f : Hom W n) -> B.DB.Lands W n (B.DC.hornS m k) f -> D0.E.TA.EI W)
        (D1.hA k hu).1 (D0.hA k u).1 (\ W ->
          funext (Hom W n) (\ f -> B.DB.Lands W n (B.DC.hornS m k) f -> D0.E.TA.EI W)
            ((D1.hA k hu).1 W) ((D0.hA k u).1 W) (\ f ->
              funext (B.DB.Lands W n (B.DC.hornS m k) f) (\ j -> D0.E.TA.EI W)
                ((D1.hA k hu).1 W f) ((D0.hA k u).1 W f) (values W f)))) ;

  image (y : U1.U0 n) (q : Id (U1.U0 n) F' y) (v : H1.HornData m k y)
    (r : (W : Nat) (f : Hom W n) (j : B.DB.Lands W n (B.DC.hornS m k) f)
      -> Id (G.EI W) (C.ta W (u.1 W f j)) (v.1 W f j))
    : Id (G.EI n) (C.ta n (D.pr n F (h0 m k hk F u).1)) (G.pr n y (h1 m k hk y v).1) =
    transH (apH {S.HData (m, k) (B.DB.idH n)} {G.EI n}
      (\ z -> G.pr n F' (F.2 (m, k) hk (B.DB.idH n) z).1) (symH input))
      (Compare.opAt (m, k) hk F' y q hu v r) ;

  opaque image ;
} ;
