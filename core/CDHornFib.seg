-- CDHornFib.seg (L8, Delta): seg/model DHornFib.seg ported (module names only).  Was: horn filling for a type over a simplicial set, at any level
-- lv >= a (the horns themselves are DeltaHorn, at level a):
--
--   HornData       an element of A on the horn at rho : G([m+1])
--   Ext            an extension of it to Delta[m+1]
--   isFib          a horn filling OPERATION (Thierry, 2026-10-15: fibrancy
--                  on Delta is a structure, untruncated, with no uniformity;
--                  C(A)(X , rho) = isFib(X , A rho) is a presheaf by
--                  precomposition).  The mere property "every horn has
--                  merely a filler" would give the operation only with the
--                  axiom of choice; it is not used.
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
open CDeltaCl[a] ;

------------------------------------------------------------------------
-- horn filling for a type A over a simplicial set G

module DH (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) {
  open DB.GPre[lz].TyL[G, A] ;
  module PT = DB.CPartial[lz].Partials[G, A] ;

  -- an element of A on the horn at rho: a section over the sieve hornS
  HornData (m k : Nat) (rho : Pt (suc m)) : U lz =
    (v : PT.PvTy (suc m) (hornS m k)) * (PT.PptTy (suc m) rho (hornS m k) v * PT.PnTy (suc m) (hornS m k) v) ;

  -- the horn as a partial element (one side)
  hornSide (m k : Nat) (rho : Pt (suc m)) (h : HornData m k rho) : PT.Side[suc m, rho] =
    new PT.Side[suc m, rho, hornS m k, h.1, h.2.1, h.2.2] ;

  -- an extension to Delta[m+1]
  Ext (m k : Nat) (rho : Pt (suc m)) (h : HornData m k rho) : U lz =
    (a0 : T (suc m) rho)
    * ((W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (hornS m k) f)
       -> Id (EI W) (E.act W (suc m) f (rho, a0)) (h.1 W f i)) ;

  -- the horn filling operation (no uniformity, as in [S])
  isFib : U lz = (m k : Nat) -> IsT (leb k (suc m)) -> (rho : Pt (suc m)) -> (h : HornData m k rho) -> Ext m k rho h ;
} ;

