-- CTrP.seg (L3, inside CB, level l): transport is an equivalence, the path
-- part.  For w = (gamma , a) and a side p of the fibre of tr over w:
--
--   K2      the points (g , c0 , c1), c0 c1 in A over g; PathP2 the paths
--           over the point g from c0 to c1, composed from src d to tgt d
--           (CPathComp, from ca)
--   xh2     the line i |-> (gamma i , U0 i , Fb i) in K2 (U0 the transport
--           filler of bnew, Fb the B-filler, CTrB), with the constant path
--           at bnew at src d
--   Sd.P    on p, the square of the side transposed: a path in j over the
--           point gamma (g , i), from U0 to Fb
--   side    these paths, as one side over xh2
--   pnew    the composite at tgt d: a path from tr bnew to a, which on p
--           is the side's path
--
-- Quarry: seg/model GTE6, GTE7, GTE8, GTE9 (one side, over GI).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module K2P (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp) {
  module TA = GPR.TyL[G, A] ;
  module GL = GPR.PshL[G] ;

  EA : PCtx = TA.E ;
  A1 : PTy[EA] = subTy EA G A (pP G A) ;
  K2 : PCtx = extP EA A1 ;
  module FK2 = CLine[l].FC[K2] ;

  s (X : Ob) (y : W0.Ix (K2.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (G.ob W) = G.act W X f y.1.1 ;

  sN (J I : Ob) (h : Hom J I) (x : W0.Ix (K2.ob I)) (y : W0.Ix (K2.ob J)) (e : Id (W0.Ix (K2.ob J)) (K2.act J I h x) y)
    (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (s I x W (compH W J I h f) i) (s J y W f i) =
    transH (symH (GL.actC W J I h f x.1.1)) (apH (\ z -> G.act W J f z.1.1) e) ;

  sF (X : Ob) (y : W0.Ix (K2.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (G.ob V)) (G.act V W g (s X y W f i)) (s X y V (compH V W X f g) (compH V W Iv i g)) =
    GL.actC V W X f g y.1.1 ;

  aE (W : Ob) (y : W0.Ix (K2.ob W)) : TA.EI W = y.1 ;
  bE (W : Ob) (y : W0.Ix (K2.ob W)) : TA.EI W = (y.1.1, y.2) ;

  aE-act (W X : Ob) (f : Hom W X) (x : W0.Ix (K2.ob X)) : Id (TA.EI W) (TA.E.act W X f (aE X x)) (aE W (K2.act W X f x)) =
    refl (TA.E.act W X f x.1) ;

  bE-act (W X : Ob) (f : Hom W X) (x : W0.Ix (K2.ob X)) : Id (TA.EI W) (TA.E.act W X f (bE X x)) (bE W (K2.act W X f x)) =
    apH {W0.Ix (A.tob W (G.act W X f x.1.1))} {TA.EI W} (\ v -> (G.act W X f x.1.1, v))
      (tact-irr G A W X f x.1.1 (G.act W X f x.1.1) (refl (G.act W X f x.1.1))
         (ntEq EA G (pP G A) W X f x.1 (EA.act W X f x.1) (refl (EA.act W X f x.1))) x.2) ;

  opaque bE-act ;

  aE-pt (W : Ob) (y : W0.Ix (K2.ob W)) : Id (W0.Ix (G.ob W)) (aE W y).1 (s W y W (idH W) (ptH W (src true))) =
    symH (G.act-id W y.1.1) ;
  bE-pt (W : Ob) (y : W0.Ix (K2.ob W)) : Id (W0.Ix (G.ob W)) (bE W y).1 (s W y W (idH W) (ptH W (tgt true))) =
    symH (G.act-id W y.1.1) ;

  module PC2 = CPathComp[l].PathC[K2, G, A, true, s, sN, sF, aE, bE, aE-act, bE-act, aE-pt, bE-pt, src d, tgt d, ca] ;
  module PT2 = PC2.PT ;

  -- points of K2 from two elements over equal points
  mk3 (W : Ob) (u u' : TA.EI W) (P : Id (W0.Ix (G.ob W)) u'.1 u.1) : W0.Ix (K2.ob W) = (u, TA.coeT W u'.1 u.1 P u'.2) ;

  mk3-b (W : Ob) (u u' : TA.EI W) (P : Id (W0.Ix (G.ob W)) u'.1 u.1) : Id (TA.EI W) (bE W (mk3 W u u' P)) u' =
    symH (TA.pr-coe W u'.1 u.1 P u'.2) ;

  k2Ext (W : Ob) (y y' : W0.Ix (K2.ob W)) (P : Id (TA.EI W) (aE W y) (aE W y')) (Q : Id (TA.EI W) (bE W y) (bE W y'))
    : Id (W0.Ix (K2.ob W)) y y' =
    idJ (TA.EI W) y.1
      (\ z P2 -> (c : W0.Ix (A.tob W z.1)) -> Id (TA.EI W) (bE W y) (z.1, c) -> Id (W0.Ix (K2.ob W)) y (z, c))
      (\ c Q2 -> apH {W0.Ix (A.tob W y.1.1)} {W0.Ix (K2.ob W)} (\ v -> (y.1, v)) (TA.pr-inj W y.1.1 y.2 c Q2))
      y'.1 P y'.2 Q ;

  opaque k2Ext ;

  -- a line in K2 from two natural families in E over the same line in G
  module Ln3 (X : Ob) (u u' : (W : Ob) -> Hom W X -> Hom W Iv -> TA.EI W)
    (un : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI V) (TA.E.act V W g (u W f i)) (u V (compH V W X f g) (compH V W Iv i g)))
    (un' : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv) -> Id (TA.EI V) (TA.E.act V W g (u' W f i)) (u' V (compH V W X f g) (compH V W Iv i g)))
    (P : (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (G.ob W)) (u' W f i).1 (u W f i).1) {
    v3 (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (K2.ob W) = mk3 W (u W f i) (u' W f i) (P W f i) ;

    vn (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
      : Id (W0.Ix (K2.ob V)) (K2.act V W g (v3 W f i)) (v3 V (compH V W X f g) (compH V W Iv i g)) =
      k2Ext V (K2.act V W g (v3 W f i)) (v3 V (compH V W X f g) (compH V W Iv i g))
        (un V W g f i)
        (transH (symH (bE-act V W g (v3 W f i)))
          (transH (apH (TA.E.act V W g) (mk3-b W (u W f i) (u' W f i) (P W f i)))
            (transH (un' V W g f i) (symH (mk3-b V (u V (compH V W X f g) (compH V W Iv i g)) (u' V (compH V W X f g) (compH V W Iv i g))
                                                  (P V (compH V W X f g) (compH V W Iv i g))))))) ;

    line : W0.Ix (FK2.ob X) = (v3, vn) ;
  } ;
} ;

module TrP (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp)
  (cb : CLine[l].Lines[G, A].CompK[tgt d, src d].Comp)
  (c01 : CLine[l].Lines[G, A].CompK[e0, e1].Comp) {
  module B = CTrB[l].BB[G, A, d, ca, cb, c01] ;
  module KP = K2P[G, A, d, ca] ;
  module O = B.O ;
  module T1 = B.T1 ;
  module HF = B.HF ;
  module TA = B.TA ;
  module E0 = B.E0 ;
  module EKt = B.EKt ;
  module CP2 = KP.PC2.CP ;
  module FA2 = CLine[l].FT[KP.K2, KP.PT2.PathP] ;
  module EVP2 = FA2.Ev[src d] ;
  module EKP0 = CLine[l].EndKit[O.K, O.PT.PathP, e0] ;
  module EKP1 = CLine[l].EndKit[O.K, O.PT.PathP, e1] ;
  module FGL = GPR.PshL[T1.FG.GI] ;

  ----------------------------------------------------------------------
  -- the point of the path problem

  module Bx (X : Ob) (w : HF.TA.EI X) (p : B.FP.Side[X, w]) {
    module BX = B.Box[X, w, p] ;

    xbn : HF.TB.EI X = (w.1, BX.bnew) ;

    uS : E0.TS.EI X = T1.uF X xbn ;

    u (W : Ob) (f : Hom W X) (i : Hom W Iv) : TA.EI W = (E0.lineL X uS).2.1.1 W f i ;
    u' (W : Ob) (f : Hom W X) (i : Hom W Iv) : TA.EI W = (EKt.lineL X BX.FbS).2.1.1 W f i ;

    un (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
      : Id (TA.EI V) (TA.E.act V W g (u W f i)) (u V (compH V W X f g) (compH V W Iv i g)) = (E0.lineL X uS).2.1.2 V W g f i ;
    un' (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
      : Id (TA.EI V) (TA.E.act V W g (u' W f i)) (u' V (compH V W X f g) (compH V W Iv i g)) = (EKt.lineL X BX.FbS).2.1.2 V W g f i ;

    P (W : Ob) (f : Hom W X) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (u' W f i).1 (u W f i).1 =
      transH (apH (\ y -> y.1 W f i) (EKt.lineL X BX.FbS).2.2) (symH (apH (\ y -> y.1 W f i) (E0.lineL X uS).2.2)) ;

    module L3 = KP.Ln3[X, u, u', un, un', P] ;

    ell2 : W0.Ix (KP.FK2.ob X) = L3.line ;

    y0 : W0.Ix (KP.K2.ob X) = L3.v3 X (idH X) (ptH X (src d)) ;

    bnE : TA.EI X = E0.endE X xbn ;

    -- both lines start at bnew
    U0start : Id (TA.EI X) (u X (idH X) (ptH X (src d))) bnE =
      transH (symH (T1.EVs.endB-E X (E0.lineL X uS))) (apH (E0.endE X) (T1.uF-start X xbn)) ;

    Fbstart : Id (TA.EI X) (u' X (idH X) (ptH X (src d))) bnE = symH (T1.EVs.endB-E X (EKt.lineL X BX.FbS)) ;

    -- the constant path at bnew
    cv (W : Ob) (f : Hom W X) (j : Hom W Iv) : TA.EI W = TA.E.act W X f bnE ;

    cvn (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
      : Id (TA.EI V) (TA.E.act V W g (cv W f j)) (cv V (compH V W X f g) (compH V W Iv j g)) =
      TA.PE.actC V W X f g bnE ;

    cvp (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (W0.Ix (G.ob W)) (cv W f j).1 (KP.s X y0 W f j) =
      apH (G.act W X f) (apH {TA.EI X} {W0.Ix (G.ob X)} (\ z -> z.1) (symH U0start)) ;

    cv0 : Id (TA.EI X) (cv X (idH X) (ptH X e0)) (KP.aE X y0) = transH (TA.E.act-id X bnE) (symH U0start) ;

    cv1 : Id (TA.EI X) (cv X (idH X) (ptH X e1)) (KP.bE X y0) =
      transH (TA.E.act-id X bnE)
        (transH (symH Fbstart) (symH (KP.mk3-b X (u X (idH X) (ptH X (src d))) (u' X (idH X) (ptH X (src d))) (P X (idH X) (ptH X (src d)))))) ;

    cp : W0.Ix (KP.PT2.tobP X y0) = KP.PT2.mkPath X y0 cv cvn cvp cv0 cv1 ;

    xh2 : CP2.TV.EI X = (ell2, cp) ;
  } ;

  ----------------------------------------------------------------------
  -- the square of the side, transposed

  module Sd (X : Ob) (w : HF.TA.EI X) (p : B.FP.Side[X, w]) (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) {
    module BX = B.Box[X, w, p] ;
    module PX = Bx[X, w, p] ;

    v : HF.TF.EI W = BX.v W f h ;

    module OW = O.W[W, v] ;

    sqL : O.CP.TL.EI W = O.CP.lineL W OW.omSq ;

    -- the square at (a , j): a path over gamma
    sqV (W1 : Ob) (a0 : Hom W1 W) (j : Hom W1 Iv) : O.PT.TP.EI W1 = sqL.2.1.1 W1 a0 j ;

    xv : Id (W0.Ix (T1.FG.GI.ob W)) v.1.1 (T1.FG.GI.act W X f w.1) = apH {HF.TA.EI W} {W0.Ix (T1.FG.GI.ob W)} (\ z -> z.1) (p.ppt W f h) ;

    kptEq (W1 : Ob) (a0 : Hom W1 W) (j : Hom W1 Iv)
      : Id (W0.Ix (T1.FG.GI.ob W1)) (sqV W1 a0 j).1.1.1 (T1.FG.GI.act W1 X (compH W1 W X f a0) w.1) =
      transH (apH (\ z -> z.1.1) (apH (\ y -> y.1 W1 a0 j) sqL.2.2))
        (transH (HF.fibL-pt W v W1 a0 j)
          (transH (apH (T1.FG.GI.act W1 W a0) xv) (FGL.actC W1 W X f a0 w.1))) ;

    -- the values of the transposed square
    tv (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) (W'' : Ob) (g'' : Hom W'' W') (j : Hom W'' Iv) : TA.EI W'' =
      (sqV W'' (compH W'' W' W g g'') j).2.1.1 W'' (idH W'') (compH W'' W' Iv i g'') ;

    tvPt (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) (W'' : Ob) (g'' : Hom W'' W') (j : Hom W'' Iv)
      : Id (W0.Ix (G.ob W'')) (tv W' g i W'' g'' j).1 (w.1.1 W'' (compH W'' W X f (compH W'' W' W g g'')) (compH W'' W' Iv i g'')) =
      transH ((sqV W'' (compH W'' W' W g g'') j).2.2.1 W'' (idH W'') (compH W'' W' Iv i g''))
        (transH (apH (\ y -> y.1 W'' (idH W'') (compH W'' W' Iv i g'')) (kptEq W'' (compH W'' W' W g g'') j))
                (apH (\ m -> w.1.1 W'' m (compH W'' W' Iv i g'')) (comp-idr W'' X (compH W'' W X f (compH W'' W' W g g''))))) ;

    -- the K2 point of the path problem at (f g , i)
    y2 (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : W0.Ix (KP.K2.ob W') = PX.L3.v3 W' (compH W' W X f g) i ;

    tvp (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) (W'' : Ob) (g'' : Hom W'' W') (j : Hom W'' Iv)
      : Id (W0.Ix (G.ob W'')) (tv W' g i W'' g'' j).1 (KP.s W' (y2 W' g i) W'' g'' j) =
      transH (tvPt W' g i W'' g'' j)
        (transH (apH (\ m -> w.1.1 W'' m (compH W'' W' Iv i g'')) (symH (comp-assoc W'' W' W X f g g'')))
          (transH (symH (w.1.2 W'' W' g'' (compH W' W X f g) i))
                  (apH (G.act W'' W' g'') (symH (apH (\ y -> y.1 W' (compH W' W X f g) i) (E0.lineL X PX.uS).2.2))))) ;

    tvn (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) (V W'' : Ob) (g3 : Hom V W'') (g'' : Hom W'' W') (j : Hom W'' Iv)
      : Id (TA.EI V) (TA.E.act V W'' g3 (tv W' g i W'' g'' j)) (tv W' g i V (compH V W'' W' g'' g3) (compH V W'' Iv j g3)) =
      calc (TA.EI V) {
          TA.E.act V W'' g3 ((sqV W'' (compH W'' W' W g g'') j).2.1.1 W'' (idH W'') (compH W'' W' Iv i g''))
        =< (sqV W'' (compH W'' W' W g g'') j).2.1.2 V W'' g3 (idH W'') (compH W'' W' Iv i g'') >
          (sqV W'' (compH W'' W' W g g'') j).2.1.1 V (compH V W'' W'' (idH W'') g3) (compH V W'' Iv (compH W'' W' Iv i g'') g3)
        =< apH (\ m -> (sqV W'' (compH W'' W' W g g'') j).2.1.1 V m (compH V W'' Iv (compH W'' W' Iv i g'') g3))
             (transH (comp-idl V W'' g3) (symH (comp-idr V W'' g3))) >
          (sqV W'' (compH W'' W' W g g'') j).2.1.1 V (compH V V W'' g3 (idH V)) (compH V W'' Iv (compH W'' W' Iv i g'') g3)
        =< apH (\ z -> z.2.1.1 V (idH V) (compH V W'' Iv (compH W'' W' Iv i g'') g3)) (sqL.2.1.2 V W'' g3 (compH W'' W' W g g'') j) >
          (sqV V (compH V W'' W (compH W'' W' W g g'') g3) (compH V W'' Iv j g3)).2.1.1 V (idH V) (compH V W'' Iv (compH W'' W' Iv i g'') g3)
        =< apH (\ m -> (sqV V m (compH V W'' Iv j g3)).2.1.1 V (idH V) (compH V W'' Iv (compH W'' W' Iv i g'') g3))
             (comp-assoc V W'' W' W g g'' g3) >
          (sqV V (compH V W' W g (compH V W'' W' g'' g3)) (compH V W'' Iv j g3)).2.1.1 V (idH V) (compH V W'' Iv (compH W'' W' Iv i g'') g3)
        =< apH (\ m -> (sqV V (compH V W' W g (compH V W'' W' g'' g3)) (compH V W'' Iv j g3)).2.1.1 V (idH V) m)
             (comp-assoc V W'' W' Iv i g'' g3) >
          tv W' g i V (compH V W'' W' g'' g3) (compH V W'' Iv j g3) } ;

    -- the square at its two ends (j = e0: the start xh ; j = e1: omega)
    sqStart (W1 : Ob) (a0 : Hom W1 W) : Id (O.PT.TP.EI W1) (sqV W1 a0 (ptH W1 e0)) (O.PT.TP.E.act W1 W a0 (O.CP.endE W OW.xh)) =
      transH (EKP0.lineEnd W1 W a0 sqL)
        (apH (O.PT.TP.E.act W1 W a0) (transH (symH (O.EVP0.endB-E W sqL)) (apH (O.CP.endE W) OW.omSq.2.2))) ;

    sqEnd (W1 : Ob) (a0 : Hom W1 W) : Id (O.PT.TP.EI W1) (sqV W1 a0 (ptH W1 e1)) (O.PT.TP.E.act W1 W a0 (EKP1.endE W OW.omE)) =
      transH (EKP1.lineEnd W1 W a0 sqL) (apH (O.PT.TP.E.act W1 W a0) (symH (O.EVP1.endB-E W sqL))) ;

    tv0 (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : Id (TA.EI W') (tv W' g i W' (idH W') (ptH W' e0)) (KP.aE W' (y2 W' g i)) =
      calc (TA.EI W') {
          (sqV W' (compH W' W' W g (idH W')) (ptH W' e0)).2.1.1 W' (idH W') (compH W' W' Iv i (idH W'))
        =< apH (\ z -> z.2.1.1 W' (idH W') (compH W' W' Iv i (idH W'))) (sqStart W' (compH W' W' W g (idH W'))) >
          OW.t W' (compH W' W' W (compH W' W' W g (idH W')) (idH W')) (compH W' W' Iv i (idH W'))
        =< apH (\ m -> OW.t W' m (compH W' W' Iv i (idH W'))) (transH (comp-idr W' W (compH W' W' W g (idH W'))) (comp-idr W' W g)) >
          OW.t W' g (compH W' W' Iv i (idH W'))
        =< apH (OW.t W' g) (comp-idr W' Iv i) >
          (E0.lineL W (T1.uF W OW.xb)).2.1.1 W' g i
        =< apH (\ z -> (E0.lineL W (T1.uF W z)).2.1.1 W' g i) (symH (BX.BS[W, f, h].bside)) >
          (E0.lineL W (T1.uF W (HF.TB.E.act W X f PX.xbn))).2.1.1 W' g i
        =< apH (\ z -> (E0.lineL W z).2.1.1 W' g i) (symH (T1.uF-nat W X f PX.xbn)) >
          (E0.lineL W (E0.TS.E.act W X f PX.uS)).2.1.1 W' g i
        =< apH (\ M -> M.2.1.1 W' g i) (E0.lineL-act W X f PX.uS) >
          PX.u W' (compH W' W X f g) i } ;

    tv1 (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : Id (TA.EI W') (tv W' g i W' (idH W') (ptH W' e1)) (KP.bE W' (y2 W' g i)) =
      calc (TA.EI W') {
          (sqV W' (compH W' W' W g (idH W')) (ptH W' e1)).2.1.1 W' (idH W') (compH W' W' Iv i (idH W'))
        =< apH (\ z -> z.2.1.1 W' (idH W') (compH W' W' Iv i (idH W'))) (sqEnd W' (compH W' W' W g (idH W'))) >
          BX.t W f h W' (compH W' W' W (compH W' W' W g (idH W')) (idH W')) (compH W' W' Iv i (idH W'))
        =< apH (\ m -> BX.t W f h W' m (compH W' W' Iv i (idH W'))) (transH (comp-idr W' W (compH W' W' W g (idH W'))) (comp-idr W' W g)) >
          BX.t W f h W' g (compH W' W' Iv i (idH W'))
        =< apH (BX.t W f h W' g) (comp-idr W' Iv i) >
          BX.t W f h W' g i
        =< symH (BX.pv-lev W f h W' g i) >
          (EKt.lineL W (BX.pv W f h)).2.1.1 W' g i
        =< apH (\ z -> (EKt.lineL W z).2.1.1 W' g i) (symH (B.kb.kside X BX.zt BX.pB W f h)) >
          (EKt.lineL W (EKt.TS.E.act W X f BX.FbS)).2.1.1 W' g i
        =< apH (\ M -> M.2.1.1 W' g i) (EKt.lineL-act W X f BX.FbS) >
          PX.u' W' (compH W' W X f g) i
        =< symH (KP.mk3-b W' (PX.u W' (compH W' W X f g) i) (PX.u' W' (compH W' W X f g) i) (PX.P W' (compH W' W X f g) i)) >
          KP.bE W' (y2 W' g i) } ;

    -- the transposed square at (g , i): a path in j over gamma (f g , i)
    P (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : W0.Ix (KP.PT2.tobP W' (y2 W' g i)) =
      KP.PT2.mkPath W' (y2 W' g i) (tv W' g i) (tvn W' g i) (tvp W' g i) (tv0 W' g i) (tv1 W' g i) ;

    opaque tvp ; opaque tvn ; opaque sqStart ; opaque sqEnd ; opaque tv0 ; opaque tv1 ;
  } ;

  ----------------------------------------------------------------------
  -- the side of the path problem, and its composite

  module PN (X : Ob) (w : HF.TA.EI X) (p : B.FP.Side[X, w]) {
    module PX = Bx[X, w, p] ;
    module BX = B.Box[X, w, p] ;

    module SL (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) {
      module Q = Sd[X, w, p, W, f, h] ;

      lK : W0.Ix (KP.FK2.ob W) = (CP2.TV.E.act W X f PX.xh2).1 ;

      tt (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : KP.PT2.TP.EI W' = (Q.y2 W' g i, Q.P W' g i) ;

      ttp (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : Id (W0.Ix (KP.K2.ob W')) (tt W' g i).1 (lK.1 W' g i) = refl (Q.y2 W' g i) ;

      ttn (V W' : Ob) (g' : Hom V W') (g : Hom W' W) (i : Hom W' Iv)
        : Id (KP.PT2.TP.EI V) (KP.PT2.TP.E.act V W' g' (tt W' g i)) (tt V (compH V W' W g g') (compH V W' Iv i g')) =
        KP.PT2.tp-ext V (KP.PT2.TP.E.act V W' g' (tt W' g i)) (tt V (compH V W' W g g') (compH V W' Iv i g'))
          (lK.2 V W' g' g i)
          (\ W'' g'' j ->
             transH (apH (\ m -> (Q.sqV W'' m j).2.1.1 W'' (idH W'') (compH W'' W' Iv i (compH W'' V W' g' g''))) (symH (comp-assoc W'' V W' W g g' g'')))
                    (apH (\ m -> (Q.sqV W'' (compH W'' V W (compH V W' W g g') g'') j).2.1.1 W'' (idH W'') m) (symH (comp-assoc W'' V W' Iv i g' g'')))) ;

      L2 : CP2.TL.EI W = (lK, FA2.lamA W lK tt ttp ttn) ;

      -- at i = src d, the transposed square is the constant path at bnew
      bfE (W'' : Ob) (a0 : Hom W'' W) (j : Hom W'' Iv)
        : Id (TA.EI W'') (O.aE W'' (Q.sqV W'' a0 j).1) (TA.E.act W'' X (compH W'' W X f a0) PX.bnE) =
        calc (TA.EI W'') {
            O.aE W'' (Q.sqV W'' a0 j).1
          =< apH (O.aE W'') (apH (\ y -> y.1 W'' a0 j) Q.sqL.2.2) >
            O.aE W'' (Q.OW.L.lw W'' a0 j)
          =< apH (E0.endE W'') (Q.OW.L.lvB W'' a0 j) >
            E0.endE W'' (Q.OW.L.bf W'' a0)
          =< apH (E0.endE W'')
               (transH (apH (HF.TB.E.act W'' W a0) (symH (BX.BS[W, f, h].bside))) (HF.TB.PE.actC W'' W X f a0 PX.xbn)) >
            E0.endE W'' (HF.TB.E.act W'' X (compH W'' W X f a0) PX.xbn)
          =< E0.endE-act W'' X (compH W'' W X f a0) PX.xbn >
            TA.E.act W'' X (compH W'' W X f a0) PX.bnE } ;

      Ql : Id (KP.PT2.TP.EI W) (CP2.endE W (EVP2.evA.mE W L2)) (CP2.endE W (CP2.TV.E.act W X f PX.xh2)) =
        transH (EVP2.endB-E W L2)
          (KP.PT2.tp-ext W (tt W (idH W) (ptH W (src d))) (CP2.endE W (CP2.TV.E.act W X f PX.xh2))
             (refl (Q.y2 W (idH W) (ptH W (src d))))
             (\ W'' g'' j ->
                calc (TA.EI W'') {
                    (Q.sqV W'' (compH W'' W W (idH W) g'') j).2.1.1 W'' (idH W'') (compH W'' W Iv (ptH W (src d)) g'')
                  =< apH (\ m -> (Q.sqV W'' (compH W'' W W (idH W) g'') j).2.1.1 W'' (idH W'') m) (ptH-nat W'' W g'' (src d)) >
                    (Q.sqV W'' (compH W'' W W (idH W) g'') j).2.1.1 W'' (idH W'') (ptH W'' (src d))
                  =< O.PT.end0g W'' (Q.sqV W'' (compH W'' W W (idH W) g'') j).1 (Q.sqV W'' (compH W'' W W (idH W) g'') j).2 W'' (idH W'') >
                    O.aE W'' (O.K.act W'' W'' (idH W'') (Q.sqV W'' (compH W'' W W (idH W) g'') j).1)
                  =< apH (O.aE W'') (O.K.act-id W'' (Q.sqV W'' (compH W'' W W (idH W) g'') j).1) >
                    O.aE W'' (Q.sqV W'' (compH W'' W W (idH W) g'') j).1
                  =< bfE W'' (compH W'' W W (idH W) g'') j >
                    TA.E.act W'' X (compH W'' W X f (compH W'' W W (idH W) g'')) PX.bnE
                  =< apH (\ m -> TA.E.act W'' X (compH W'' W X f m) PX.bnE) (comp-idl W'' W g'') >
                    TA.E.act W'' X (compH W'' W X f g'') PX.bnE })) ;

      pv : CP2.TS.EI W = CP2.mkTS W (CP2.TV.E.act W X f PX.xh2) L2 (refl lK) Ql ;

      pv-pt : Id (CP2.TV.EI W) pv.1 (CP2.TV.E.act W X f PX.xh2) = CP2.mkTS-pt W (CP2.TV.E.act W X f PX.xh2) L2 (refl lK) Ql ;

      pv-lev (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : Id (KP.PT2.TP.EI W') ((CP2.lineL W pv).2.1.1 W' g i) (tt W' g i) =
        apH (\ M -> M.2.1.1 W' g i) (CP2.mkTS-line W (CP2.TV.E.act W X f PX.xh2) L2 (refl lK) Ql) ;

      opaque bfE ; opaque Ql ;
    } ;

    -- the square of a restricted side is the restricted square
    sqVN (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) (W' : Ob) (g : Hom W' W)
      (h' : Lands W' X p.pQ (compH W' W X f g)) (W3 : Ob) (a0 : Hom W3 W') (j : Hom W3 Iv)
      : Id (O.PT.TP.EI W3) (SL[W', compH W' W X f g, h'].Q.sqV W3 a0 j) (SL[W, f, h].Q.sqV W3 (compH W3 W' W g a0) j) =
      transH (apH (\ z -> (O.CP.lineL W' O.W[W', z].omSq).2.1.1 W3 a0 j) (symH (p.pnat W' W g f h h')))
        (transH (apH (\ z -> (O.CP.lineL W' z).2.1.1 W3 a0 j) (symH O.R[W', W, g, SL[W, f, h].Q.v].omSqN))
                (apH (\ M -> M.2.1.1 W3 a0 j) (O.CP.lineL-act W' W g SL[W, f, h].Q.OW.omSq))) ;

    pnat (W' W : Ob) (g : Hom W' W) (f : Hom W X) (h : Lands W X p.pQ f) (h' : Lands W' X p.pQ (compH W' W X f g))
      : Id (CP2.TS.EI W') (CP2.TS.E.act W' W g SL[W, f, h].pv) SL[W', compH W' W X f g, h'].pv =
      CP2.ts-ext W' (CP2.TS.E.act W' W g SL[W, f, h].pv) SL[W', compH W' W X f g, h'].pv
        (transH (apH (CP2.TV.E.act W' W g) SL[W, f, h].pv-pt)
          (transH (CP2.TV.PE.actC W' W X f g PX.xh2) (symH SL[W', compH W' W X f g, h'].pv-pt)))
        (\ W3 g3 i ->
           transH (apH (\ M -> M.2.1.1 W3 g3 i) (CP2.lineL-act W' W g SL[W, f, h].pv))
             (transH (SL[W, f, h].pv-lev W3 (compH W3 W' W g g3) i)
               (transH
                 (KP.PT2.tp-ext W3 (SL[W, f, h].tt W3 (compH W3 W' W g g3) i) (SL[W', compH W' W X f g, h'].tt W3 g3 i)
                    (apH (\ m -> PX.L3.v3 W3 m i) (symH (comp-assoc W3 W' W X f g g3)))
                    (\ W4 g4 j ->
                       transH (apH (\ m -> (SL[W, f, h].Q.sqV W4 m j).2.1.1 W4 (idH W4) (compH W4 W3 Iv i g4))
                                   (comp-assoc W4 W3 W' W g g3 g4))
                              (apH (\ z -> z.2.1.1 W4 (idH W4) (compH W4 W3 Iv i g4))
                                   (symH (sqVN W f h W' g h' W4 (compH W4 W3 W' g3 g4) j)))))
                 (symH (SL[W', compH W' W X f g, h'].pv-lev W3 g3 i))))) ;

    opaque sqVN ; opaque pnat ;

    side : CP2.PT.Side[X, PX.xh2] =
      new CP2.PT.Side[X, PX.xh2, p.pQ, \ W f h -> SL[W, f, h].pv, \ W f h -> SL[W, f, h].pv-pt, pnat] ;

    -- the composite: a path over the end of gamma, from tr bnew to a
    pnew : W0.Ix (CLine[l].Lines[KP.K2, KP.PT2.PathP].CompK[src d, tgt d].Tend.tob X PX.xh2) = KP.PC2.comp.kop X PX.xh2 side ;
  } ;
} ;
