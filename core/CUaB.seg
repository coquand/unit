-- CUaB.seg (L6, inside CB): step (b) of univalence (model.tex Thm ua,
-- proof (b)), over a full sieve ph (top in ua; pre h top in its uniformity).  From a glue datum d at X, the full glue datum over A_d
-- built from the small copy SA along the Yoneda maps of d g: its code at
-- g is that of (d g)^ * SA (with smallCl), its alpha is ext read back to
-- F through the A-cart, its equivalence eqSA moved (CGlueCart at G = GD,
-- io (g , q) = (d g) id).  The classifier enters through smallCl and its
-- composition law (C1).
--
-- Quarry: seg/model GUaPt, GUaPtNat, GUaUniv.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UaB (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  -- the classifier of the small copy along maps into GD, and (C1)
  (smallCl : (D : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l))
  (smallCl-sub : (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D])
     -> Id ((A : PTy[D']) * Cl D' A)
           (subTy D' D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) t,
            clSub D' D t (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) (smallCl D l))
           (CSmall.xsub D' CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t),
            smallCl D' (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t)))
  (X : Ob) (d : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 X) (ph : Phi X) (full : IsT (allS X ph)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module XS = CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module R = CGlueE.RCm[X, ph] ;
  GDr : L.PCtx = UB.GDr ;

  F : UU.U0 X = d.1.1 ;

  -- the Yoneda map of a point of GD
  yhat (W : Ob) (x : V1.Ix (GDr.ob W)) : CSmall.XSub[yP W, GDr] = UB.yhat W x ;

  dg (W : Ob) (g : Hom W X) : V1.Ix (GDr.ob W) = GDr.act W X g d ;

  io (W : Ob) (r : W0.Ix (R.RC.ob W)) : V1.Ix (GDr.ob W) = GDr.act W W (idH W) (dg W r.1) ;

  io-nat (V W : Ob) (k : Hom V W) (r : W0.Ix (R.RC.ob W)) : Id (V1.Ix (GDr.ob V)) (io V (R.RC.act V W k r)) (GDr.act V W k (io W r)) =
    transH (GDr.act-id V (dg V (compH V W X r.1 k)))
      (transH (GDr.act-o V W X r.1 k d) (apH (GDr.act V W k) (symH (GDr.act-id W (dg W r.1))))) ;

  ----------------------------------------------------------------------
  -- B: the codes of SA along the Yoneda maps

  B (W : Ob) (g : Hom W X) (q : IsT (CGlueD.fl X (ph) W g)) : UU.U0 W =
    (CSmall.xsub (yP W) GDr XS.SA (yhat W (dg W g)), smallCl (yP W) (yhat W (dg W g))) ;

  bn : DD.BNat X (ph) B = \ W' W chi g q g2 E q2 ->
    transH (smallCl-sub (yP W) (yP W') (yhat W (dg W g)) (yH W' W chi))
      (apH {CSmall.XSub[yP W', GDr]} {UU.U0 W'} (\ l -> (CSmall.xsub (yP W') GDr XS.SA l, smallCl (yP W') l))
        (CSmall.xs-ext (yP W') GDr (CSmall.xoS (yP W') (yP W) GDr (yhat W (dg W g)) (yH W' W chi)) (yhat W' (dg W' g2))
           (\ V h -> transH (GDr.act-o V W' W chi h (dg W g))
                       (apH (GDr.act V W' h) (transH (symH (GDr.act-o W' W X g chi d)) (apH (\ k -> GDr.act W' X k d) E)))))) ;

  ----------------------------------------------------------------------
  -- the A-cart: F at g -> A_U at (d g) id, a transport along g = g (id id)

  At0 : PTy[R.RC] = subTy R.RC (yP X) F.1 R.inclRC ;
  module TAt = GPR.TyL[R.RC, At0] ;
  module TAU = LP.TyL[GDr, UB.AU] ;

  o (W : Ob) (k : Hom W X) : W0.V = F.1.tob W k ;

  trH (W : Ob) (k k' : Hom W X) (p : Id (Hom W X) k k') (z : W0.Ix (o W k)) : W0.Ix (o W k') =
    subst (Hom W X) (\ k2 -> W0.Ix (o W k2)) k k' p z ;

  trH-V (W : Ob) (k k' : Hom W X) (p : Id (Hom W X) k k') (z : W0.Ix (o W k))
    : Id (W0.Ix (o W k')) (trH W k k' p z) (CExtEq1.sV (o W k) (o W k') (apH (o W) p) z) =
    subst-ap (Hom W X) W0.V (o W) (\ v -> W0.Ix v) k k' p z ;

  kk (W : Ob) (g : Hom W X) : Hom W X = compH W W X g (compH W W W (idH W) (idH W)) ;

  Pk (W : Ob) (g : Hom W X) : Id (Hom W X) g (kk W g) =
    transH (symH (comp-idr W X g)) (apH (compH W W X g) (symH (comp-idl W W (idH W)))) ;

  tA (W : Ob) (v : TAt.EI W) : TAU.EI W = (TAU.pr W (io W (TAt.pr1 W v)) (trH W (TAt.pr1 W v).1 (kk W (TAt.pr1 W v).1) (Pk W (TAt.pr1 W v).1) (TAt.pr2 W v))) ;

  codeA (V : Ob) (y : V1.Ix (GDr.ob V)) : W0.V = UU.fib0 V y.1.1 ;



  module NA (V W : Ob) (k : Hom V W) (v : TAt.EI W) {
    g : Hom W X = (TAt.pr1 W v).1 ;
    r' : W0.Ix (R.RC.ob V) = R.RC.act V W k (TAt.pr1 W v) ;
    x : V1.Ix (GDr.ob V) = GDr.act V W k (io W (TAt.pr1 W v)) ;
    x' : V1.Ix (GDr.ob V) = io V r' ;
    y0 : Hom V W = compH V V W k (idH V) ;
    Ytgt : Hom V X = compH V W X g (compH V W W (idH W) y0) ;
    eP : Id (UU.U0 V) (UU.uAct V W k (io W (TAt.pr1 W v)).1.1) x.1.1 =
      L.ntEq GDr UU.UCtx UB.pA V W k (io W (TAt.pr1 W v)) x (refl x) ;
    pL : Id (Hom V X) (compH V W X (kk W g) k) Ytgt =
      ntEq (yP W) (yP X) (yH W X g) V W k (compH W W W (idH W) (idH W)) (compH V W W (idH W) y0)
        (ntEq (yP W) (yP W) (yH W W (idH W)) V W k (idH W) y0 (UU.idf-eq V W k)) ;
    eR : Id (Hom V X) (compH V W X g k) (compH V W X g k) =
      ntEq R.RC (yP X) R.inclRC V W k (TAt.pr1 W v) r' (refl r') ;
    e' : Id (Hom V X) (compH V W X g k) Ytgt =
      apH (compH V W X g) (symH (transH (comp-idl V W y0) (comp-idr V W k))) ;
    T : W0.Ix (o V (compH V W X g k)) = F.1.tact V W k g (compH V W X g k) eR (TAt.pr2 W v) ;
    Xin : W0.Ix (o V Ytgt) = F.1.tact V W k (kk W g) Ytgt pL (trH W g (kk W g) (Pk W g) (TAt.pr2 W v)) ;

    Xin-T : Id (W0.Ix (o V Ytgt)) Xin (CExtEq1.sV (o V (compH V W X g k)) (o V Ytgt) (apH (o V) e') T) =
      transH (UU.tact-src-move (yP X) F.1 V W k g (kk W g) Ytgt (Pk W g) pL e' (TAt.pr2 W v))
       (transH (symH (UU.tact-move (yP X) F.1 V W k g (compH V W X g k) Ytgt eR e' e' (TAt.pr2 W v)))
               (trH-V V (compH V W X g k) Ytgt e' T)) ;

    c1 : Id W0.V (o V Ytgt) (codeA V x) = apH (UU.fib0 V) eP ;
    c2 : Id W0.V (o V (compH V W X g k)) (o V Ytgt) = apH (o V) e' ;
    c3 : Id W0.V (o V (compH V W X g k)) (codeA V x') = apH (o V) (Pk V (compH V W X g k)) ;
    c : Id W0.V (codeA V x) (codeA V x') = transH (symH (transH c2 c1)) c3 ;

    res : Id (TAU.EI V) (TAU.E.act V W k (tA W v)) (tA V (TAt.E.act V W k v)) =
      apH (\ p -> TAU.pr V p.1 p.2) (CExtEq1.pair-eqV1 (V1.Ix (GDr.ob V)) (codeA V) x x' (symH (io-nat V W k (TAt.pr1 W v)))
        (UB.AU.tact V W k (io W (TAt.pr1 W v)) x (refl x) (TAU.pr2 W (tA W v))) (TAU.pr2 V (tA V (TAt.E.act V W k v))) c
        (transH (apH (CExtEq1.sV (codeA V x) (codeA V x') c)
                   (transH (UU.substF V (UU.uAct V W k (io W (TAt.pr1 W v)).1.1) x.1.1 eP Xin)
                           (apH (CExtEq1.sV (o V Ytgt) (codeA V x) c1) Xin-T)))
          (transH (apH (CExtEq1.sV (codeA V x) (codeA V x') c) (CExtEq1.sV-comp (o V (compH V W X g k)) (o V Ytgt) (codeA V x) c2 c1 T))
            (transH (CExtEq1.sV-two (o V (compH V W X g k)) (codeA V x) (codeA V x') (transH c2 c1) c c3 T)
                    (symH (trH-V V (compH V W X g k) (kk V (compH V W X g k)) (Pk V (compH V W X g k)) T)))))) ;
  } ;

  tAnat (V W : Ob) (k : Hom V W) (v : TAt.EI W) : Id (TAU.EI V) (TAU.E.act V W k (tA W v)) (tA V (TAt.E.act V W k v)) = NA[V, W, k, v].res ;

  bkA (Y : Ob) (r : W0.Ix (R.RC.ob Y)) (z : V1.Ix (UB.AU.tob Y (io Y r))) : W0.Ix (F.1.tob Y r.1) =
    trH Y (kk Y r.1) r.1 (symH (Pk Y r.1)) z ;

  bkAta (Y : Ob) (r : W0.Ix (R.RC.ob Y)) (z : V1.Ix (UB.AU.tob Y (io Y r))) : Id (TAU.EI Y) (tA Y (TAt.pr Y r (bkA Y r z))) (TAU.pr Y (io Y r) z) =
    apH {V1.Ix (UB.AU.tob Y (io Y r))} {TAU.EI Y} (\ w -> (TAU.pr Y (io Y r) w))
      (CExtEq1.subst-round' (Hom Y X) (\ k2 -> W0.Ix (o Y k2)) r.1 (kk Y r.1) (Pk Y r.1) z) ;

  tAinj (W : Ob) (v v' : TAt.EI W) (P : Id (W0.Ix (R.RC.ob W)) (TAt.pr1 W v) (TAt.pr1 W v')) (Qp : Id (TAU.EI W) (tA W v) (tA W v')) : Id (TAt.EI W) v v' =
    idJ (W0.Ix (R.RC.ob W)) (TAt.pr1 W v)
      (\ r2 P2 -> (b2 : W0.Ix (At0.tob W r2)) -> Id (TAU.EI W) (tA W v) (tA W (TAt.pr W r2 b2)) -> Id (TAt.EI W) v (TAt.pr W r2 b2))
      (\ b2 Q2 -> apH {W0.Ix (At0.tob W (TAt.pr1 W v))} {TAt.EI W} (\ z -> (TAt.pr W (TAt.pr1 W v) z))
         (transH (symH (CExtEq1.subst-round (Hom W X) (\ k2 -> W0.Ix (o W k2)) (TAt.pr1 W v).1 (kk W (TAt.pr1 W v).1) (Pk W (TAt.pr1 W v).1) (TAt.pr2 W v)))
           (transH (apH (trH W (kk W (TAt.pr1 W v).1) (TAt.pr1 W v).1 (symH (Pk W (TAt.pr1 W v).1))) (TAU.pr-inj W (io W (TAt.pr1 W v)) (TAU.pr2 W (tA W v)) (TAU.pr2 W (tA W (TAt.pr W (TAt.pr1 W v) b2))) Q2))
                   (CExtEq1.subst-round (Hom W X) (\ k2 -> W0.Ix (o W k2)) (TAt.pr1 W v).1 (kk W (TAt.pr1 W v).1) (Pk W (TAt.pr1 W v).1) b2))))
      (TAt.pr1 W v') P (TAt.pr2 W v') Qp ;

  opaque tAnat ; opaque bkAta ; opaque tAinj ;

  ----------------------------------------------------------------------
  -- the B-cart (identity on fibres)

  Bt0 : PTy[R.RC] = GE.BtOf X (ph) B bn ;
  module TBt = GPR.TyL[R.RC, Bt0] ;
  module TS = LP.TyL[GDr, XS.upSA] ;

  tB (W : Ob) (v : TBt.EI W) : TS.EI W = (TS.pr W (io W (TBt.pr1 W v)) (TBt.pr2 W v)) ;

  codeS (V : Ob) (y : V1.Ix (GDr.ob V)) : W0.V = XS.S0 V y ;

  module NB (V W : Ob) (k : Hom V W) (v : TBt.EI W) {
    g : Hom W X = (TBt.pr1 W v).1 ;
    r' : W0.Ix (R.RC.ob V) = R.RC.act V W k (TBt.pr1 W v) ;
    x : V1.Ix (GDr.ob V) = GDr.act V W k (io W (TBt.pr1 W v)) ;
    x' : V1.Ix (GDr.ob V) = io V r' ;
    y0 : Hom V W = compH V V W k (idH V) ;
    Y2 : V1.Ix (GDr.ob V) = GDr.act V W y0 (dg W g) ;
    xp : Id (V1.Ix (GDr.ob V)) (GDr.act V W k (io W (TBt.pr1 W v))) Y2 =
      CSmall.xntEq (yP W) GDr (yhat W (dg W g)) V W k (idH W) y0 (UU.idf-eq V W k) ;
    T2 : W0.Ix (codeS V Y2) = XS.SA.tact V W k (io W (TBt.pr1 W v)) Y2 xp (TBt.pr2 W v) ;
    ebn : Id (UU.U0 V) (UU.uAct V W k (B W g (TBt.pr1 W v).2)) (B V r'.1 r'.2) = bn V W k g (TBt.pr1 W v).2 r'.1 (apH (\ z -> z.1) (refl r')) r'.2 ;
    P2 : Id (V1.Ix (GDr.ob V)) Y2 x =
      transH (GDr.act-o V V W k (idH V) (dg W g))
        (transH (GDr.act-id V (GDr.act V W k (dg W g))) (symH (apH (GDr.act V W k) (GDr.act-id W (dg W g))))) ;
    c1 : Id W0.V (codeS V Y2) (codeS V x) = apH (codeS V) P2 ;
    c2 : Id W0.V (codeS V Y2) (codeS V x') = apH (UU.fib0 V) ebn ;

    lhs : Id (W0.Ix (codeS V x)) (XS.SA.tact V W k (io W (TBt.pr1 W v)) x (refl x) (TBt.pr2 W v)) (CExtEq1.sV (codeS V Y2) (codeS V x) c1 T2) =
      transH (symH (CSmall.tact-move GDr XS.SA V W k (io W (TBt.pr1 W v)) Y2 x xp (refl x) P2 (TBt.pr2 W v)))
             (subst-ap (V1.Ix (GDr.ob V)) W0.V (codeS V) (\ w -> W0.Ix w) Y2 x P2 T2) ;

    rhs : Id (W0.Ix (codeS V x')) (TS.pr2 V (tB V (TBt.E.act V W k v))) (CExtEq1.sV (codeS V Y2) (codeS V x') c2 T2) =
      UU.substF V (UU.uAct V W k (B W g (TBt.pr1 W v).2)) (B V r'.1 r'.2) ebn T2 ;

    res : Id (TS.EI V) (TS.E.act V W k (tB W v)) (tB V (TBt.E.act V W k v)) =
      apH (\ p -> TS.pr V p.1 p.2) (CExtEq1.pair-eqV1 (V1.Ix (GDr.ob V)) (codeS V) x x' (symH (io-nat V W k (TBt.pr1 W v)))
        (XS.SA.tact V W k (io W (TBt.pr1 W v)) x (refl x) (TBt.pr2 W v)) (TS.pr2 V (tB V (TBt.E.act V W k v))) (transH (symH c1) c2)
        (transH (apH (CExtEq1.sV (codeS V x) (codeS V x') (transH (symH c1) c2)) lhs)
          (transH (CExtEq1.sV-two (codeS V Y2) (codeS V x) (codeS V x') c1 (transH (symH c1) c2) c2 T2) (symH rhs)))) ;
  } ;

  tBnat (V W : Ob) (k : Hom V W) (v : TBt.EI W) : Id (TS.EI V) (TS.E.act V W k (tB W v)) (tB V (TBt.E.act V W k v)) = NB[V, W, k, v].res ;

  tBinj (W : Ob) (v v' : TBt.EI W) (P : Id (W0.Ix (R.RC.ob W)) (TBt.pr1 W v) (TBt.pr1 W v')) (Qp : Id (TS.EI W) (tB W v) (tB W v')) : Id (TBt.EI W) v v' =
    idJ (W0.Ix (R.RC.ob W)) (TBt.pr1 W v)
      (\ r2 P2 -> (b2 : W0.Ix (Bt0.tob W r2)) -> Id (TS.EI W) (tB W v) (tB W (TBt.pr W r2 b2)) -> Id (TBt.EI W) v (TBt.pr W r2 b2))
      (\ b2 Q2 -> apH {W0.Ix (Bt0.tob W (TBt.pr1 W v))} {TBt.EI W} (\ z -> (TBt.pr W (TBt.pr1 W v) z)) (TS.pr-inj W (io W (TBt.pr1 W v)) (TBt.pr2 W v) b2 Q2))
      (TBt.pr1 W v') P (TBt.pr2 W v') Qp ;

  opaque tBnat ; opaque tBinj ;

  ----------------------------------------------------------------------
  -- the full glue datum over F

  module GC = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn,
    GDr, XS.upSA, UB.AU, XS.extSA, XS.eqSA, io, io-nat,
    tA, \ W v -> refl (io W (TAt.pr1 W v)), tAnat, tAinj, bkA, bkAta,
    tB, \ W v -> refl (io W (TBt.pr1 W v)), tBnat, tBinj, \ Y x z -> z, \ Y x z -> refl (TS.pr Y (io Y x) z)] ;


  out : CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaT0 X F = (GC.dat, (refl F, full)) ;
} ;
