-- CTrB.seg (L3, inside CB, level l): transport is an equivalence, the B
-- part.  Given w = (gamma , a) and a side p of the fibre of tr over w
-- (values v = (b , q)):
--
--   kb      the filler at tgt d, from the reverse composition cb
--   pB      the partial line over gamma ending at a, with omega v on p
--   FbS     its filler: a line over gamma ending at a
--   bnew    its value at src d: the new B part
--   bside   on p, bnew is the B part of the side
--
-- Quarry: seg/model GTE5 (one side, over GI).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

-- the filler at the end tgt d from a composition from tgt d to src d
revK (G : PCtx) (A : PTy[G]) : (d : Bool) -> CLine[l].Lines[G, A].CompK[tgt d, src d].Comp -> CLine[l].Lines[G, A].Fill (tgt d) = split {
  true -> \ c -> CFill[l].FillC[G, A, false, c].fill ;
  false -> \ c -> CFill[l].FillC[G, A, true, c].fill } ;

module BB (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp)
  (cb : CLine[l].Lines[G, A].CompK[tgt d, src d].Comp)
  (c01 : CLine[l].Lines[G, A].CompK[e0, e1].Comp) {
  module O = CTrOm[l].Om[G, A, d, ca, c01] ;
  module T1 = O.T1 ;
  module HF = O.HF ;
  module TA = O.TA ;
  module EKt = T1.EK' ;
  module E0 = T1.EK ;
  module FA = T1.FA ;
  module FP = CPartial[l].Partials[HF.EA, HF.FibT] ;

  kb : CLine[l].Lines[G, A].Fill (tgt d) = revK G A d cb ;

  module Box (X : Ob) (w : HF.TA.EI X) (p : FP.Side[X, w]) {
    zt : EKt.TV.EI X = w ;

    v (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) : HF.TF.EI W = p.pv W f h ;

    om (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) : CLine[l].EndKit[O.K, O.PT.PathP, e1].TV.EI W = O.W[W, v W f h].omE ;

    t (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) (W' : Ob) (g : Hom W' W) (i : Hom W' Iv) : TA.EI W' =
      (om W f h).2.1.1 W' g i ;

    -- the point of K at the end e1 of the line of omega
    y1 (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) : W0.Ix (O.K.ob W) = (om W f h).1.1 W (idH W) (ptH W e1) ;

    xEq (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f)
      : Id (W0.Ix (T1.FG.GI.ob W)) (y1 W f h).1.1 (T1.FG.GI.act W X f w.1) =
      transH (HF.fibL-pt W (v W f h) W (idH W) (ptH W e1))
        (transH (T1.FG.GI.act-id W (v W f h).1.1) (apH (\ z -> z.1) (p.ppt W f h))) ;

    lG (W : Ob) (f : Hom W X) : W0.Ix (T1.FG.GI.ob W) = (EKt.TV.E.act W X f zt).1 ;

    tp (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) (W' : Ob) (g : Hom W' W) (i : Hom W' Iv)
      : Id (W0.Ix (G.ob W')) (t W f h W' g i).1 ((lG W f).1 W' g i) =
      transH ((om W f h).2.2.1 W' g i) (apH (\ z -> z.1 W' g i) (xEq W f h)) ;

    tn (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) (V' W' : Ob) (g' : Hom V' W') (g : Hom W' W) (i : Hom W' Iv)
      : Id (TA.EI V') (TA.E.act V' W' g' (t W f h W' g i)) (t W f h V' (compH V' W' W g g') (compH V' W' Iv i g')) =
      (om W f h).2.1.2 V' W' g' g i ;

    L (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) : EKt.TL.EI W =
      (lG W f, FA.lamA W (lG W f) (t W f h) (tp W f h) (tn W f h)) ;

    -- the line ends at a
    Ql (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f)
      : Id (TA.EI W) (EKt.endE W (T1.EVt.evA.mE W (L W f h))) (EKt.endE W (EKt.TV.E.act W X f zt)) =
      transH (T1.EVt.endB-E W (L W f h))
        (transH (om W f h).2.2.2.2
          (apH (EKt.endE W) (transH (HF.fibL-1 W (v W f h)) (p.ppt W f h)))) ;

    pv (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) : EKt.TS.EI W =
      EKt.mkTS W (EKt.TV.E.act W X f zt) (L W f h) (refl (lG W f)) (Ql W f h) ;

    pv-pt (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) : Id (EKt.TV.EI W) (pv W f h).1 (EKt.TV.E.act W X f zt) =
      EKt.mkTS-pt W (EKt.TV.E.act W X f zt) (L W f h) (refl (lG W f)) (Ql W f h) ;

    pv-lev (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) (W' : Ob) (g : Hom W' W) (i : Hom W' Iv)
      : Id (TA.EI W') ((EKt.lineL W (pv W f h)).2.1.1 W' g i) (t W f h W' g i) =
      apH (\ M -> M.2.1.1 W' g i) (EKt.mkTS-line W (EKt.TV.E.act W X f zt) (L W f h) (refl (lG W f)) (Ql W f h)) ;

    pnat (W' W : Ob) (g : Hom W' W) (f : Hom W X) (h : Lands W X p.pQ f) (h' : Lands W' X p.pQ (compH W' W X f g))
      : Id (EKt.TS.EI W') (EKt.TS.E.act W' W g (pv W f h)) (pv W' (compH W' W X f g) h') =
      EKt.ts-ext W' (EKt.TS.E.act W' W g (pv W f h)) (pv W' (compH W' W X f g) h')
        (transH (apH (EKt.TV.E.act W' W g) (pv-pt W f h))
          (transH (EKt.TV.PE.actC W' W X f g zt) (symH (pv-pt W' (compH W' W X f g) h'))))
        (\ V g' j ->
           transH (apH (\ M -> M.2.1.1 V g' j) (EKt.lineL-act W' W g (pv W f h)))
            (transH (pv-lev W f h V (compH V W' W g g') j)
             (transH (O.R[W', W, g, v W f h].omVN V g' j)
              (transH (apH (\ z -> O.W[W', z].omE.2.1.1 V g' j) (p.pnat W' W g f h h'))
                      (symH (pv-lev W' (compH W' W X f g) h' V g' j)))))) ;

    opaque pv-lev ; opaque pnat ;

    pB : EKt.PT.Side[X, zt] = new EKt.PT.Side[X, zt, p.pQ, pv, pv-pt, pnat] ;

    -- the B-filler: a line over gamma ending at a
    FbS : EKt.TS.EI X = (zt, kb.kop X zt pB) ;

    -- its value at src d: the new B part
    bnew : W0.Ix (T1.SB.tob X w.1) = (T1.EVs.evA.mE X (EKt.lineL X FbS)).2 ;

    -- on the side, bnew is the B part of the side
    module BS (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) {
      omS : Id (TA.EI W) (t W f h W (idH W) (ptH W (src d))) (E0.endE W (HF.fibB W (v W f h))) =
        transH (om W f h).2.2.2.1
          (apH (E0.endE W) (transH (O.W[W, v W f h].L.lvB W (idH W) (ptH W e1)) (HF.TB.E.act-id W (HF.fibB W (v W f h))))) ;

      bside : Id (HF.TB.EI W) (HF.TB.E.act W X f (w.1, bnew)) (HF.fibB W (v W f h)) =
        E0.tv-eq W (HF.TB.E.act W X f (w.1, bnew)) (HF.fibB W (v W f h))
          (symH (apH {HF.TA.EI W} {W0.Ix (T1.FG.GI.ob W)} (\ z -> z.1) (p.ppt W f h)))
          (transH (apH (E0.endE W) (symH (T1.EVs.evA.mnat W X f (EKt.lineL X FbS))))
           (transH (apH (\ z -> E0.endE W (T1.EVs.evA.mE W z))
                      (transH (symH (EKt.lineL-act W X f FbS)) (apH (EKt.lineL W) (kb.kside X zt pB W f h))))
            (transH (T1.EVs.endB-E W (EKt.lineL W (pv W f h)))
             (transH (pv-lev W f h W (idH W) (ptH W (src d))) omS)))) ;
    } ;
  } ;
} ;
