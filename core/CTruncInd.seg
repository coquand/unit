-- Dependent elimination for displayed seeded-extension algebras.
-- A displayed algebra is an algebra on Sigma(T,B) whose projection to T
-- preserves ext.  This is a condition on the dependent family, not a new
-- axiom or an assertion that every fibrant proposition already has it.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;
module PF = PresheafFormers[a,l].PFormers[PB.BC] ;

module Family (G : PCtx) (A : PTy[G]) (B : PTy[extP G CTrunc[a,l].Truncation[G,A].Ty]) {
  module T = CTrunc[a,l].Truncation[G,A] ;
  module S = PF.SigAB[G,T.Ty,B] ;
  module KT = CTruncAlg[a,l].Algebras[G,T.Ty] ;
  module KS = CTruncAlg[a,l].Algebras[G,S.SigP] ;
  module TT = PR.TyL[G,T.Ty] ;
  module TB = PR.TyL[TT.E,B] ;
  open CTruncRaw[a,l].Build[G,A] ;
  projection : HO.NMap[G,S.SigP,T.Ty] = new HO.NMap[G,S.SigP,T.Ty,
    \ X x u -> u.1,\ Y X h x y e u -> refl (T.Ty.tact Y X h x y e u.1)] ;
  module Proj = CTruncHom[a,l].Maps[G,S.SigP,T.Ty,projection] ;
  record Displayed {
    algebra : KS.Algebra ;
    projects : Proj.Preserves algebra T.algebra ;
  } ;
  record Generator {
    map : HO.NMap[G,A,S.SigP] ;
    over (z : Loc) (v : W.Ix (A.tob z.1 z.2)) : Id (TrEl z) (map.nfun z.1 z.2 v).1 (inc z v) ;
  } ;

  module Eliminate (d : Displayed) (f : Generator) {
    module R = T.Recursor[S.SigP,d.algebra,f.map] ;
    module RM = CTruncMorphism[a,l].Rec[G,A,S.SigP,d.algebra,f.map] ;
    module C = CTruncMorphism[a,l].Compose[G,T.Ty,S.SigP,T.Ty,
      T.algebra,d.algebra,T.algebra,R.map,projection,RM.preserves,d.projects] ;
    ci (z : Loc) (v : W.Ix (A.tob z.1 z.2)) :
      Id (TrEl z) (C.map.nfun z.1 z.2 (inc z v)) (inc z v) =
      transH (apH (\ u -> u.1) (R.beta-inc z v)) (f.over z v) ;
    module CU = CTruncUnique[a,l].Unique[G,A,T.Ty,T.algebra,T.inclusion,C.map,C.preserves,ci] ;
    module I = CTruncMorphism[a,l].Identity[G,T.Ty,T.algebra] ;
    module IU = CTruncUnique[a,l].Unique[G,A,T.Ty,T.algebra,T.inclusion,I.map,I.preserves,
      \ z v -> refl (inc z v)] ;
    retract (X : Ob) (x : W.Ix (G.ob X)) (t : TrEl (X,x)) :
      Id (TrEl (X,x)) (R.map.nfun X x t).1 t =
      transH (CU.unique (X,x) t) (symH (IU.unique (X,x) t)) ;
    opaque retract ;
    module Sec = CTruncSection[a,l].Section[G,T.Ty,B,R.map,retract] ;
    section : PEl[TT.E,B] = Sec.section ;
    generator (z : Loc) (v : W.Ix (A.tob z.1 z.2)) : TB.T z.1 (z.2,inc z v) =
      TB.fromE z.1 (z.2,inc z v)
        ((z.2,(f.map.nfun z.1 z.2 v).1),(f.map.nfun z.1 z.2 v).2)
        (apH (\ t -> (z.2,t)) (f.over z v)) ;
    beta-inc (z : Loc) (v : W.Ix (A.tob z.1 z.2)) :
      Id (TB.T z.1 (z.2,inc z v)) (section.eob z.1 (z.2,inc z v)) (generator z v) =
      TB.pr-inj z.1 (z.2,inc z v) _ _
        (transH (Sec.equation z.1 (z.2,inc z v))
          (transH (apH (\ u -> ((z.2,u.1),u.2)) (R.beta-inc z v))
            (symH (TB.fromE-eq z.1 (z.2,inc z v)
              ((z.2,(f.map.nfun z.1 z.2 v).1),(f.map.nfun z.1 z.2 v).2)
              (apH (\ t -> (z.2,t)) (f.over z v)))))) ;
    opaque beta-inc ;
  } ;
} ;
