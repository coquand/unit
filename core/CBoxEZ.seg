-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CBoxEZ.seg (L9): the image factorisation of a simplex of a poset
-- (postnikov.tex, Lemma box, prisms over a poset).
--
-- A height of a poset X is ht : El X -> Nat, bounded by B, monotone, and
-- injective on comparable elements.  For g : [W] -> X the image
-- factorisation of hH = ht g : [W] -> [B] (CLocEZ.EZH) is that of g:
--
--   EZX[.., W, g]       c = g sec : [r] -> X strict, sgm : [W] -> [r] with
--                       a section sec, and fac : c sgm = g; r <= B (rle)
--   EZXK[.., W, W', g, k]   along k : [W'] -> [W]: mu = sgm k sec' is
--                       strict, muEq : sgm k = mu sgm', cmu : c mu = c'
--   HLin, HProd         the heights of [n] (the number) and of a product
--                       (the sum)

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
open CDeltaNat[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module VF = CDeltaFact[a] ;
module EZm = CLocEZ[a] ;

------------------------------------------------------------------------
-- a strict map [p] -> [n] has p <= n

module SL (p n : Nat) (f : Hom (lin p) (lin n)) (st : Strict (lin p) (lin n) f) {
  ge : (i : Nat) -> IsT (leb i p) -> IsT (leb i (VF.valT p n f i)) = split {
    zero -> \ h -> refl true ;
    suc i | ih -> \ h -> leb-trans (suc i) (suc (VF.valT p n f i)) (VF.valT p n f (suc i))
                      (ih (leb-trans i (suc i) p (leb-suc i) h))
                      (EZm.VH.valT-of-strict p n f st i (suc i) (leb-refl i) h) } ;

  res : IsT (leb p n) = leb-trans p (VF.valT p n f p) n (ge p (leb-refl p)) (VF.valT-range p n f p) ;
} ;

------------------------------------------------------------------------
-- the factorisation

module EZX (X : Ob) (ht : El X -> Nat) (B : Nat) (hB : (x : El X) -> IsT (leb (ht x) B))
  (hm : (x y : El X) -> IsT (le X x.1 y.1) -> IsT (leb (ht x) (ht y)))
  (hi : (x y : El X) -> IsT (le X x.1 y.1) -> Id Nat (ht x) (ht y) -> Id Tree x.1 y.1)
  (W : Nat) (g : Hom (lin W) X) {

  cpt (i : Nat) : El (lin W) = (leaf (VF.clampN W i), VF.clamp-ok W i) ;

  hfun (i : Nat) : Nat = ht (app (lin W) X g (cpt i)) ;

  hH : Hom (lin W) (lin B) =
    linH W B hfun (\ i h -> hB (app (lin W) X g (cpt i)))
      (\ i j l -> hm (app (lin W) X g (cpt i)) (app (lin W) X g (cpt j)) (mono (lin W) X g (cpt i) (cpt j) (VF.clamp-mono W i j l))) ;

  -- the value of hH is the height
  hval (s : El (lin W)) : Id Nat (vnum (app (lin W) (lin B) hH s).1) (ht (app (lin W) X g s)) =
    VF.leafElim W (\ s1 -> Id Nat (vnum (app (lin W) (lin B) hH s1).1) (ht (app (lin W) X g s1)))
      (\ i h -> apH (\ s2 -> ht (app (lin W) X g s2)) (el-eq (lin W) (cpt i) (leaf i, h) (lf (VF.clampN W i) i (VF.clamp-eq W i h)))) s ;

  module Z = EZm.EZH[W, B, hH] ;
  r : Nat = Z.r ;

  -- the image has dimension at most B
  rle : IsT (leb r B) = SL[r, B, Z.mH, Z.strict].res ;
  sgm : Hom (lin W) (lin r) = Z.sigH ;
  sec : Hom (lin r) (lin W) = Z.secH ;
  c : Hom (lin r) X = compH (lin r) (lin W) X g sec ;
  ss : Hom (lin W) (lin W) = compH (lin W) (lin r) (lin W) sec sgm ;

  -- hH is constant along sec sgm, and hH sec = mH
  hss : Id (Hom (lin W) (lin B)) (compH (lin W) (lin W) (lin B) hH ss) hH =
    calc (Hom (lin W) (lin B)) {
        compH (lin W) (lin W) (lin B) hH ss
      =< apH (\ k -> compH (lin W) (lin W) (lin B) k ss) (symH Z.fac) >
        compH (lin W) (lin W) (lin B) (compH (lin W) (lin r) (lin B) Z.mH sgm) ss
      =< comp-assoc (lin W) (lin W) (lin r) (lin B) Z.mH sgm ss >
        compH (lin W) (lin r) (lin B) Z.mH (compH (lin W) (lin W) (lin r) sgm ss)
      =< apH (compH (lin W) (lin r) (lin B) Z.mH) (symH (comp-assoc (lin W) (lin r) (lin W) (lin r) sgm sec sgm)) >
        compH (lin W) (lin r) (lin B) Z.mH (compH (lin W) (lin r) (lin r) (compH (lin r) (lin W) (lin r) sgm sec) sgm)
      =< apH (\ k -> compH (lin W) (lin r) (lin B) Z.mH (compH (lin W) (lin r) (lin r) k sgm)) Z.sec >
        compH (lin W) (lin r) (lin B) Z.mH (compH (lin W) (lin r) (lin r) (idH (lin r)) sgm)
      =< apH (compH (lin W) (lin r) (lin B) Z.mH) (comp-idl (lin W) (lin r) sgm) >
        compH (lin W) (lin r) (lin B) Z.mH sgm
      =< Z.fac >
        hH } ;

  hsec : Id (Hom (lin r) (lin B)) (compH (lin r) (lin W) (lin B) hH sec) Z.mH =
    calc (Hom (lin r) (lin B)) {
        compH (lin r) (lin W) (lin B) hH sec
      =< apH (\ k -> compH (lin r) (lin W) (lin B) k sec) (symH Z.fac) >
        compH (lin r) (lin W) (lin B) (compH (lin W) (lin r) (lin B) Z.mH sgm) sec
      =< comp-assoc (lin r) (lin W) (lin r) (lin B) Z.mH sgm sec >
        compH (lin r) (lin r) (lin B) Z.mH (compH (lin r) (lin W) (lin r) sgm sec)
      =< apH (compH (lin r) (lin r) (lin B) Z.mH) Z.sec >
        compH (lin r) (lin r) (lin B) Z.mH (idH (lin r))
      =< comp-idr (lin r) (lin B) Z.mH >
        Z.mH } ;

  -- two points with the same height have the same image (they are comparable)
  same (s t : El (lin W)) (e : Id Nat (ht (app (lin W) X g s)) (ht (app (lin W) X g t)))
    : Id Tree (app (lin W) X g s).1 (app (lin W) X g t).1 =
    or-elim (Id Tree (app (lin W) X g s).1 (app (lin W) X g t).1) (le (lin W) s.1 t.1) (le (lin W) t.1 s.1) (lin-linear W s t)
      (\ l -> hi (app (lin W) X g s) (app (lin W) X g t) (mono (lin W) X g s t l) e)
      (\ l -> symH (hi (app (lin W) X g t) (app (lin W) X g s) (mono (lin W) X g t s l) (symH e))) ;

  fac : Id (Hom (lin W) X) (compH (lin W) (lin r) X c sgm) g =
    transH (comp-assoc (lin W) (lin r) (lin W) X g sec sgm)
      (hom-eq (lin W) X (compH (lin W) (lin W) X g ss) g (\ s ->
        transH (app-compH1 (lin W) (lin W) X g ss s)
          (same (app (lin W) (lin W) ss s) s
             (transH (symH (hval (app (lin W) (lin W) ss s)))
               (transH (apH vnum (symH (app-compH1 (lin W) (lin W) (lin B) hH ss s)))
                 (transH (apH (\ k -> vnum (app (lin W) (lin B) k s).1) hss) (hval s))))))) ;

  -- the height of c is mH
  htc (s : El (lin r)) : Id Nat (ht (app (lin r) X c s)) (vnum (app (lin r) (lin B) Z.mH s).1) =
    transH (apH ht (el-eq X (app (lin r) X c s) (app (lin W) X g (app (lin r) (lin W) sec s)) (app-compH1 (lin r) (lin W) X g sec s)))
      (transH (symH (hval (app (lin r) (lin W) sec s)))
        (transH (apH vnum (symH (app-compH1 (lin r) (lin W) (lin B) hH sec s)))
          (apH (\ k -> vnum (app (lin r) (lin B) k s).1) hsec))) ;

  contra (s t : El (lin r)) (l : IsT (lt (lin r) s.1 t.1)) (e : Id Tree (app (lin r) X c s).1 (app (lin r) X c t).1) : Empty =
    false-true (transH (symH (apH not (eqT-refl (app (lin r) (lin B) Z.mH s).1)))
      (substH (\ y -> IsT (not (eqT (app (lin r) (lin B) Z.mH s).1 y))) {(app (lin r) (lin B) Z.mH t).1} {(app (lin r) (lin B) Z.mH s).1}
         (transH (lin-leaf B (app (lin r) (lin B) Z.mH t).1 (app (lin r) (lin B) Z.mH t).2)
           (transH (lf (vnum (app (lin r) (lin B) Z.mH t).1) (vnum (app (lin r) (lin B) Z.mH s).1)
                      (transH (symH (htc t)) (transH (apH ht (el-eq X (app (lin r) X c t) (app (lin r) X c s) (symH e))) (htc s))))
                   (symH (lin-leaf B (app (lin r) (lin B) Z.mH s).1 (app (lin r) (lin B) Z.mH s).2))))
         (and-r (le (lin B) (app (lin r) (lin B) Z.mH s).1 (app (lin r) (lin B) Z.mH t).1)
                (not (eqT (app (lin r) (lin B) Z.mH s).1 (app (lin r) (lin B) Z.mH t).1))
                (Z.strict s t l)))) ;

  cstrict : Strict (lin r) X c = \ s t l ->
    and-i (le X (app (lin r) X c s).1 (app (lin r) X c t).1) (not (eqT (app (lin r) X c s).1 (app (lin r) X c t).1))
      (mono (lin r) X c s t (and-l (le (lin r) s.1 t.1) (not (eqT s.1 t.1)) l))
      (bcase (IsT (not (eqT (app (lin r) X c s).1 (app (lin r) X c t).1))) (eqT (app (lin r) X c s).1 (app (lin r) X c t).1)
         (\ q -> absurd _ (contra s t l (eqT-sound (app (lin r) X c s).1 (app (lin r) X c t).1 q)))
         (\ f -> apH not f)) ;
  opaque hss ; opaque hsec ; opaque fac ; opaque htc ;
} ;

------------------------------------------------------------------------
-- along k : [W'] -> [W]

module EZXK (X : Ob) (ht : El X -> Nat) (B : Nat) (hB : (x : El X) -> IsT (leb (ht x) B))
  (hm : (x y : El X) -> IsT (le X x.1 y.1) -> IsT (leb (ht x) (ht y)))
  (hi : (x y : El X) -> IsT (le X x.1 y.1) -> Id Nat (ht x) (ht y) -> Id Tree x.1 y.1)
  (W W' : Nat) (g : Hom (lin W) X) (k : Hom (lin W') (lin W)) {
  module Z1 = EZX[X, ht, B, hB, hm, hi, W, g] ;
  module Z2 = EZX[X, ht, B, hB, hm, hi, W', compH (lin W') (lin W) X g k] ;

  -- the heights of g k are those of g along k
  hk (v : Nat) (hv : IsT (leb v W')) : Id Nat (VF.valT W' B Z2.hH v) (VF.valT W B Z1.hH (VF.valT W' W k v)) =
    transH (VF.valT-eq W' B Z2.hH v hv)
     (transH (Z2.hval (leaf v, hv))
      (transH (apH ht (el-eq X (app (lin W') X (compH (lin W') (lin W) X g k) (leaf v, hv))
                              (app (lin W) X g (leaf (VF.valT W' W k v), VF.valT-range W' W k v))
                         (transH (app-compH1 (lin W') (lin W) X g k (leaf v, hv))
                            (apH (\ s -> (app (lin W) X g s).1)
                               (el-eq (lin W) (app (lin W') (lin W) k (leaf v, hv)) (leaf (VF.valT W' W k v), VF.valT-range W' W k v)
                                  (VF.valT-tree W' W k v hv))))))
       (transH (symH (Z1.hval (leaf (VF.valT W' W k v), VF.valT-range W' W k v)))
               (symH (VF.valT-eq W B Z1.hH (VF.valT W' W k v) (VF.valT-range W' W k v)))))) ;

  module K = EZm.EZK[W, W', B, B, Z1.hH, Z2.hH, k,
    \ v v' hv hv' e -> transH (symH (hk v hv)) (transH e (hk v' hv')),
    \ v v' hv hv' e -> transH (hk v hv) (transH e (symH (hk v' hv')))] ;

  -- mu = sgm k sec'
  mu : Hom (lin Z2.r) (lin Z1.r) = K.mu ;
  muStrict : Strict (lin Z2.r) (lin Z1.r) mu = K.muStrict ;
  muEq : Id (Hom (lin W') (lin Z1.r)) (compH (lin W') (lin W) (lin Z1.r) Z1.sgm k) (compH (lin W') (lin Z2.r) (lin Z1.r) mu Z2.sgm) = K.muEq ;

  cmu : Id (Hom (lin Z2.r) X) (compH (lin Z2.r) (lin Z1.r) X Z1.c mu) Z2.c =
    calc (Hom (lin Z2.r) X) {
        compH (lin Z2.r) (lin Z1.r) X Z1.c mu
      =< symH (comp-assoc (lin Z2.r) (lin W') (lin Z1.r) X Z1.c (compH (lin W') (lin W) (lin Z1.r) Z1.sgm k) Z2.sec) >
        compH (lin Z2.r) (lin W') X (compH (lin W') (lin Z1.r) X Z1.c (compH (lin W') (lin W) (lin Z1.r) Z1.sgm k)) Z2.sec
      =< apH (\ q -> compH (lin Z2.r) (lin W') X q Z2.sec) (symH (comp-assoc (lin W') (lin W) (lin Z1.r) X Z1.c Z1.sgm k)) >
        compH (lin Z2.r) (lin W') X (compH (lin W') (lin W) X (compH (lin W) (lin Z1.r) X Z1.c Z1.sgm) k) Z2.sec
      =< apH (\ q -> compH (lin Z2.r) (lin W') X (compH (lin W') (lin W) X q k) Z2.sec) Z1.fac >
        Z2.c } ;
  opaque hk ; opaque cmu ;
} ;

------------------------------------------------------------------------
-- heights

-- [n]: the number
module HLin (n : Nat) {
  ht (x : El (lin n)) : Nat = vnum x.1 ;

  hB (x : El (lin n)) : IsT (leb (ht x) n) = vnum-range n x.1 x.2 ;

  hmT : (s : Tree) (t : Tree) -> IsT (le (lin n) s t) -> IsT (leb (vnum s) (vnum t)) = split {
    leaf i -> split {
      leaf j -> \ l -> l ;
      node c d -> \ l -> absurd _ (false-true l) } ;
    node c d -> \ t l -> absurd _ (false-true l) } ;

  hm (x y : El (lin n)) (l : IsT (le (lin n) x.1 y.1)) : IsT (leb (ht x) (ht y)) = hmT x.1 y.1 l ;

  hi (x y : El (lin n)) (l : IsT (le (lin n) x.1 y.1)) (e : Id Nat (ht x) (ht y)) : Id Tree x.1 y.1 =
    transH (lin-leaf n x.1 x.2) (transH (lf (vnum x.1) (vnum y.1) e) (symH (lin-leaf n y.1 y.2))) ;
} ;

-- arithmetic for the sum
pm-l : (a1 b c : Nat) -> IsT (leb b c) -> IsT (leb (plus a1 b) (plus a1 c)) = split {
  zero -> \ b c h -> h ;
  suc a1 | ih -> \ b c h -> ih b c h } ;

le-plusR (b : Nat) : (a1 : Nat) -> IsT (leb b (plus a1 b)) = split {
  zero -> leb-refl b ;
  suc a1 | ih -> leb-step b (plus a1 b) ih } ;

pm-r : (a1 a' b : Nat) -> IsT (leb a1 a') -> IsT (leb (plus a1 b) (plus a' b)) = split {
  zero -> \ a' b h -> le-plusR b a' ;
  suc a1 | ih -> split {
    zero -> \ b h -> absurd _ (false-true h) ;
    suc a' -> \ b h -> ih a' b h } } ;

plus-mono2 (a a' b b' : Nat) (ha : IsT (leb a a')) (hb : IsT (leb b b')) : IsT (leb (plus a b) (plus a' b')) =
  leb-trans (plus a b) (plus a' b) (plus a' b') (pm-r a a' b ha) (pm-l a' b b' hb) ;

plus-canc : (a1 b b' : Nat) -> Id Nat (plus a1 b) (plus a1 b') -> Id Nat b b' = split {
  zero -> \ b b' e -> e ;
  suc a1 | ih -> \ b b' e -> ih b b' (suc-inj (plus a1 b) (plus a1 b') e) } ;

-- a <= a', b <= b' and a + b = a' + b' give a = a'
plus-split : (a1 a' b b' : Nat) -> IsT (leb a1 a') -> IsT (leb b b') -> Id Nat (plus a1 b) (plus a' b') -> Id Nat a1 a' = split {
  zero -> split {
    zero -> \ b b' ha hb e -> refl zero ;
    suc a' -> \ b b' ha hb e ->
      absurd _ (ltb-irr (plus a' b')
        (leb-trans (suc (plus a' b')) b (plus a' b')
           (substH (\ z -> IsT (leb z b)) {b} {suc (plus a' b')} e (leb-refl b))
           (leb-trans b b' (plus a' b') hb (le-plusR b' a')))) } ;
  suc a1 | ih -> split {
    zero -> \ b b' ha hb e -> absurd _ (false-true ha) ;
    suc a' -> \ b b' ha hb e -> apH (\ z -> suc z) (ih a' b b' ha hb (suc-inj (plus a1 b) (plus a' b') e)) } } ;

-- a product: the sum of the heights
module HProd (X : Ob) (htX : El X -> Nat) (BX : Nat) (hBX : (x : El X) -> IsT (leb (htX x) BX))
  (hmX : (x y : El X) -> IsT (le X x.1 y.1) -> IsT (leb (htX x) (htX y)))
  (hiX : (x y : El X) -> IsT (le X x.1 y.1) -> Id Nat (htX x) (htX y) -> Id Tree x.1 y.1)
  (Y : Ob) (htY : El Y -> Nat) (BY : Nat) (hBY : (y : El Y) -> IsT (leb (htY y) BY))
  (hmY : (x y : El Y) -> IsT (le Y x.1 y.1) -> IsT (leb (htY x) (htY y)))
  (hiY : (x y : El Y) -> IsT (le Y x.1 y.1) -> Id Nat (htY x) (htY y) -> Id Tree x.1 y.1) {
  P : Ob = prodP X Y ;

  ht (w : El P) : Nat = plus (htX (p1 X Y w)) (htY (p2 X Y w)) ;
  B : Nat = plus BX BY ;

  hB (w : El P) : IsT (leb (ht w) B) = plus-mono2 (htX (p1 X Y w)) BX (htY (p2 X Y w)) BY (hBX (p1 X Y w)) (hBY (p2 X Y w)) ;

  l1 (w w' : El P) (l : IsT (le P w.1 w'.1)) : IsT (le X (p1 X Y w).1 (p1 X Y w').1) = m1' X Y w.1 w.2 w'.1 w'.2 l ;
  l2 (w w' : El P) (l : IsT (le P w.1 w'.1)) : IsT (le Y (p2 X Y w).1 (p2 X Y w').1) = m2' X Y w.1 w.2 w'.1 w'.2 l ;

  hm (w w' : El P) (l : IsT (le P w.1 w'.1)) : IsT (leb (ht w) (ht w')) =
    plus-mono2 (htX (p1 X Y w)) (htX (p1 X Y w')) (htY (p2 X Y w)) (htY (p2 X Y w'))
      (hmX (p1 X Y w) (p1 X Y w') (l1 w w' l)) (hmY (p2 X Y w) (p2 X Y w') (l2 w w' l)) ;

  hi (w w' : El P) (l : IsT (le P w.1 w'.1)) (e : Id Nat (ht w) (ht w')) : Id Tree w.1 w'.1 =
    transH (symH (prod-eta X Y w))
      (transH (node-eq (p1 X Y w).1 (p2 X Y w).1 (p1 X Y w').1 (p2 X Y w').1
                 (hiX (p1 X Y w) (p1 X Y w') (l1 w w' l) e1)
                 (hiY (p2 X Y w) (p2 X Y w') (l2 w w' l)
                    (plus-canc (htX (p1 X Y w)) (htY (p2 X Y w)) (htY (p2 X Y w'))
                       (transH e (apH (\ z -> plus z (htY (p2 X Y w'))) (symH e1))))))
              (prod-eta X Y w'))
   where { e1 : Id Nat (htX (p1 X Y w)) (htX (p1 X Y w')) =
             plus-split (htX (p1 X Y w)) (htX (p1 X Y w')) (htY (p2 X Y w)) (htY (p2 X Y w'))
               (hmX (p1 X Y w) (p1 X Y w') (l1 w w' l)) (hmY (p2 X Y w) (p2 X Y w') (l2 w w' l)) e ; } ;
} ;

------------------------------------------------------------------------
-- along a strict iota : P' -> P the factorisation of iota g is iota of
-- that of g, up to the strict mu = sgm1 sec2

-- a strict map is injective on comparable points
strict-inj (P' P : Ob) (iota : Hom P' P) (ist : Strict P' P iota) (x x' : El P') (l : IsT (le P' x.1 x'.1))
  (e : Id Tree (app P' P iota x).1 (app P' P iota x').1) : Id Tree x.1 x'.1 =
  bcase (Id Tree x.1 x'.1) (eqT x.1 x'.1) (\ q -> eqT-sound x.1 x'.1 q)
    (\ f -> absurd _ (false-true (transH (symH (apH not (eqT-refl (app P' P iota x).1)))
              (substH (\ t -> IsT (not (eqT (app P' P iota x).1 t))) (symH e)
                 (and-r (le P (app P' P iota x).1 (app P' P iota x').1) (not (eqT (app P' P iota x).1 (app P' P iota x').1))
                    (ist x x' (and-i (le P' x.1 x'.1) (not (eqT x.1 x'.1)) l (apH not f)))))))) ;

module EZXI (P' : Ob) (ht' : El P' -> Nat) (B' : Nat) (hB' : (x : El P') -> IsT (leb (ht' x) B'))
  (hm' : (x y : El P') -> IsT (le P' x.1 y.1) -> IsT (leb (ht' x) (ht' y)))
  (hi' : (x y : El P') -> IsT (le P' x.1 y.1) -> Id Nat (ht' x) (ht' y) -> Id Tree x.1 y.1)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x y : El P) -> IsT (le P x.1 y.1) -> IsT (leb (ht x) (ht y)))
  (hi : (x y : El P) -> IsT (le P x.1 y.1) -> Id Nat (ht x) (ht y) -> Id Tree x.1 y.1)
  (iota : Hom P' P) (ist : Strict P' P iota) (W : Nat) (g : Hom (lin W) P') {
  module Z1 = EZX[P, ht, B, hB, hm, hi, W, compH (lin W) P' P iota g] ;
  module Z2 = EZX[P', ht', B', hB', hm', hi', W, g] ;

  vid (v : Nat) (hv : IsT (leb v W)) : Id Nat (VF.valT W W (idH (lin W)) v) v =
    apH vnum (transH (symH (VF.valT-tree W W (idH (lin W)) v hv)) (app-idH1 (lin W) (leaf v, hv))) ;

  ht1 (v : Nat) (hv : IsT (leb v W)) : Id Nat (VF.valT W B Z1.hH v) (ht (app (lin W) P (compH (lin W) P' P iota g) (leaf v, hv))) =
    transH (VF.valT-eq W B Z1.hH v hv) (Z1.hval (leaf v, hv)) ;

  ht2 (v : Nat) (hv : IsT (leb v W)) : Id Nat (VF.valT W B' Z2.hH v) (ht' (app (lin W) P' g (leaf v, hv))) =
    transH (VF.valT-eq W B' Z2.hH v hv) (Z2.hval (leaf v, hv)) ;

  -- iota g at a point is iota of g there
  ig (v : Nat) (hv : IsT (leb v W))
    : Id (El P) (app (lin W) P (compH (lin W) P' P iota g) (leaf v, hv)) (app P' P iota (app (lin W) P' g (leaf v, hv))) =
    el-eq P _ _ (app-compH1 (lin W) P' P iota g (leaf v, hv)) ;

  -- g v = g v'  iff  iota g v = iota g v'
  gg-ig (v v' : Nat) (hv : IsT (leb v W)) (hv' : IsT (leb v' W))
    (e : Id Tree (app (lin W) P' g (leaf v, hv)).1 (app (lin W) P' g (leaf v', hv')).1)
    : Id Nat (ht (app (lin W) P (compH (lin W) P' P iota g) (leaf v, hv))) (ht (app (lin W) P (compH (lin W) P' P iota g) (leaf v', hv'))) =
    transH (apH ht (ig v hv))
      (transH (apH (\ w -> ht (app P' P iota w)) (el-eq P' (app (lin W) P' g (leaf v, hv)) (app (lin W) P' g (leaf v', hv')) e))
              (symH (apH ht (ig v' hv')))) ;

  ig-gg (v v' : Nat) (hv : IsT (leb v W)) (hv' : IsT (leb v' W))
    (e : Id Tree (app (lin W) P (compH (lin W) P' P iota g) (leaf v, hv)).1 (app (lin W) P (compH (lin W) P' P iota g) (leaf v', hv')).1)
    : Id Tree (app (lin W) P' g (leaf v, hv)).1 (app (lin W) P' g (leaf v', hv')).1 =
    or-elim (Id Tree (app (lin W) P' g (leaf v, hv)).1 (app (lin W) P' g (leaf v', hv')).1) (leb v v') (leb v' v) (leb-total v v')
      (\ l -> strict-inj P' P iota ist (app (lin W) P' g (leaf v, hv)) (app (lin W) P' g (leaf v', hv'))
                (mono (lin W) P' g (leaf v, hv) (leaf v', hv') l) e')
      (\ l -> symH (strict-inj P' P iota ist (app (lin W) P' g (leaf v', hv')) (app (lin W) P' g (leaf v, hv))
                (mono (lin W) P' g (leaf v', hv') (leaf v, hv) l) (symH e')))
   where { e' : Id Tree (app P' P iota (app (lin W) P' g (leaf v, hv))).1 (app P' P iota (app (lin W) P' g (leaf v', hv'))).1 =
             transH (symH (app-compH1 (lin W) P' P iota g (leaf v, hv))) (transH e (app-compH1 (lin W) P' P iota g (leaf v', hv'))) ; } ;

  rel1 (v v' : Nat) (hv : IsT (leb v W)) (hv' : IsT (leb v' W)) (e : Id Nat (VF.valT W B' Z2.hH v) (VF.valT W B' Z2.hH v'))
    : Id Nat (VF.valT W B Z1.hH (VF.valT W W (idH (lin W)) v)) (VF.valT W B Z1.hH (VF.valT W W (idH (lin W)) v')) =
    transH (apH (VF.valT W B Z1.hH) (vid v hv))
      (transH (ht1 v hv)
        (transH (gg-ig v v' hv hv' (Z2.same (leaf v, hv) (leaf v', hv') (transH (symH (ht2 v hv)) (transH e (ht2 v' hv')))))
          (transH (symH (ht1 v' hv')) (symH (apH (VF.valT W B Z1.hH) (vid v' hv')))))) ;

  rel2 (v v' : Nat) (hv : IsT (leb v W)) (hv' : IsT (leb v' W))
    (e : Id Nat (VF.valT W B Z1.hH (VF.valT W W (idH (lin W)) v)) (VF.valT W B Z1.hH (VF.valT W W (idH (lin W)) v')))
    : Id Nat (VF.valT W B' Z2.hH v) (VF.valT W B' Z2.hH v') =
    transH (ht2 v hv)
      (transH (apH ht' (el-eq P' (app (lin W) P' g (leaf v, hv)) (app (lin W) P' g (leaf v', hv'))
                 (ig-gg v v' hv hv' (Z1.same (leaf v, hv) (leaf v', hv')
                    (transH (symH (ht1 v hv))
                      (transH (symH (apH (VF.valT W B Z1.hH) (vid v hv))) (transH e (transH (apH (VF.valT W B Z1.hH) (vid v' hv')) (ht1 v' hv')))))))))
              (symH (ht2 v' hv'))) ;

  module K = EZm.EZK[W, W, B, B', Z1.hH, Z2.hH, idH (lin W), rel1, rel2] ;

  mu : Hom (lin Z2.r) (lin Z1.r) = K.mu ;
  muStrict : Strict (lin Z2.r) (lin Z1.r) mu = K.muStrict ;

  muEq : Id (Hom (lin W) (lin Z1.r)) Z1.sgm (compH (lin W) (lin Z2.r) (lin Z1.r) mu Z2.sgm) =
    transH (symH (comp-idr (lin W) (lin Z1.r) Z1.sgm)) K.muEq ;

  cmu : Id (Hom (lin Z2.r) P) (compH (lin Z2.r) (lin Z1.r) P Z1.c mu) (compH (lin Z2.r) P' P iota Z2.c) =
    calc (Hom (lin Z2.r) P) {
        compH (lin Z2.r) (lin Z1.r) P Z1.c mu
      =< symH (comp-assoc (lin Z2.r) (lin W) (lin Z1.r) P Z1.c (compH (lin W) (lin W) (lin Z1.r) Z1.sgm (idH (lin W))) Z2.sec) >
        compH (lin Z2.r) (lin W) P (compH (lin W) (lin Z1.r) P Z1.c (compH (lin W) (lin W) (lin Z1.r) Z1.sgm (idH (lin W)))) Z2.sec
      =< apH (\ q -> compH (lin Z2.r) (lin W) P q Z2.sec)
           (transH (apH (compH (lin W) (lin Z1.r) P Z1.c) (comp-idr (lin W) (lin Z1.r) Z1.sgm)) Z1.fac) >
        compH (lin Z2.r) (lin W) P (compH (lin W) P' P iota g) Z2.sec
      =< comp-assoc (lin Z2.r) (lin W) P' P iota g Z2.sec >
        compH (lin Z2.r) P' P iota Z2.c } ;
  opaque rel1 ; opaque rel2 ; opaque cmu ;
} ;
