-- CDStageE.seg (L8, Delta): seg/model DStageE.seg ported (module names only).  Was: the stages of the filling, completed (FillStage.build and
-- cross, in line form).
--
--   fp            the filler of stage N'+1, restricted to the face y, is the
--                 filler of stage N' at the face problem (Case 1 by the
--                 sides of stage N'; Case 2 by construction of the prism)
--   cmp2-of-fp    the face property gives the agreement of the faces on
--                 codimension 2 (the simplicial identity dl dl = dl dl,
--                 DStageA.resP-sq, and the faces are mono)
--   stages        all the stages, by induction: the filler at [N], with
--                 its sides and its codimension-2 agreement
--   fill, sides, face   the result: FACE-UNIFORM fillers
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
open CDCapBase[a] ;
module DPm = CDPrism[a] ;
open CDStageD[a, lz] ;
open CDCapT[a] ;
open CDPrismPt[a] ;

------------------------------------------------------------------------
-- degeneracies and missed vertices

-- f misses y and z + 1 (y <= z): dgH y f misses z
dg-miss1 (n y z i : Nat) (hy : IsT (leb y (suc n))) (hi : IsT (leb i (suc n))) (ni : IsT (not (eqN i y))) (nz : IsT (not (eqN i (suc z))))
  (yz : IsT (leb y z)) : IsT (not (eqN (dg n y i) z)) =
  eqNDecL (IsT (not (eqN (dg n y i) z))) (dg n y i) z
    (\ e -> absurd _ (contra i (suc z) nz (transH (symH (skip-dg n y i hy hi ni)) (transH (apH (skip y) e) (skip-ge y z yz)))))
    (\ n' -> n') ;

-- f misses y and z + 1 (y <= z): dgH (z+1) f misses y
dg-miss2 (n y z i : Nat) (hz : IsT (leb (suc z) (suc n))) (hi : IsT (leb i (suc n))) (ni : IsT (not (eqN i y))) (nz : IsT (not (eqN i (suc z))))
  (yz : IsT (leb y z)) : IsT (not (eqN (dg n (suc z) i) y)) =
  eqNDecL (IsT (not (eqN (dg n (suc z) i) y))) (dg n (suc z) i) y
    (\ e -> absurd _ (contra i y ni (transH (symH (skip-dg n (suc z) i hz hi nz)) (transH (apH (skip (suc z)) e) (skip-lt (suc z) y yz)))))
    (\ n' -> n') ;

valT-dg (W n y : Nat) (f : Hom (lin W) (lin (suc n))) (v : Nat) (hv : IsT (leb v W))
  : Id Nat (valT W n (compH (lin W) (lin (suc n)) (lin n) (dgH n y) f) v) (dg n y (valT W (suc n) f v)) =
  transH (DPm.valT-comp W (suc n) n (dgH n y) f v hv) (apH vnum (symH (valT-tree (suc n) n (dgH n y) (valT W (suc n) f v) (valT-range W (suc n) f v)))) ;

miss-dg1 (W n y z : Nat) (hy : IsT (leb y (suc n))) (yz : IsT (leb y z)) (f : Hom (lin W) (lin (suc n)))
  (my : IsT (missB W (suc n) f y)) (mz : IsT (missB W (suc n) f (suc z)))
  : IsT (missB W n (compH (lin W) (lin (suc n)) (lin n) (dgH n y) f) z) =
  fa-i W (\ v -> not (eqN (valT W n (compH (lin W) (lin (suc n)) (lin n) (dgH n y) f) v) z))
    (\ v hv -> substH (\ x -> IsT (not (eqN x z))) (symH (valT-dg W n y f v hv))
                 (dg-miss1 n y z (valT W (suc n) f v) hy (valT-range W (suc n) f v) (miss-e W (suc n) y f my v hv) (miss-e W (suc n) (suc z) f mz v hv) yz)) ;

miss-dg2 (W n y z : Nat) (hz : IsT (leb (suc z) (suc n))) (yz : IsT (leb y z)) (f : Hom (lin W) (lin (suc n)))
  (my : IsT (missB W (suc n) f y)) (mz : IsT (missB W (suc n) f (suc z)))
  : IsT (missB W n (compH (lin W) (lin (suc n)) (lin n) (dgH n (suc z)) f) y) =
  fa-i W (\ v -> not (eqN (valT W n (compH (lin W) (lin (suc n)) (lin n) (dgH n (suc z)) f) v) y))
    (\ v hv -> substH (\ x -> IsT (not (eqN x y))) (symH (valT-dg W n (suc z) f v hv))
                 (dg-miss2 n y z (valT W (suc n) f v) hz (valT-range W (suc n) f v) (miss-e W (suc n) y f my v hv) (miss-e W (suc n) (suc z) f mz v hv) yz)) ;

-- a map missing y factors through dl y
fac (W n y : Nat) (hy : IsT (leb y (suc n))) (f : Hom (lin W) (lin (suc n))) (m : IsT (missB W (suc n) f y))
  : Id (Hom (lin W) (lin (suc n))) (compH (lin W) (lin n) (lin (suc n)) (dl n y) (compH (lin W) (lin (suc n)) (lin n) (dgH n y) f)) f =
  hom-eq (lin W) (lin (suc n)) _ f (pw-factor (lin W) n y f hy (miss-of W n y f m)) ;

module SE (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))  {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;
  module SBm = CDStageB[a, lz].SB[G, A, e, eN, eE] ;
  module SCm = CDStageC[a, lz].SC[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;
  module SDm = SD[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;

  ----------------------------------------------------------------------
  -- the face property of a step

  module FP (N' : Nat) (Fp : FillTy N') (sidesP : SDm.Sides N' Fp) (cmp2 : SBm.Cmp2 N' Fp) {
    module St = SDm.Step[N', Fp, sidesP, cmp2] ;
    module S = St.S ;

    fp-c1 (b : Prob (suc N')) (y : Nat) (hy : IsT (leb y (suc N'))) (i0 : IsT (SCm.fullB (suc N') b))
      : Id (KA.TS.EI N') (KA.TS.E.act N' (suc N') (dl N' y) (b.1, S.c1 b i0)) (fillE N' Fp (resP N' (suc N') (dl N' y) b)) =
      transH (S.side-c1 b i0 N' (dl N' y) i1)
        (symH (transH (symH (KA.TS.E.act-id N' (fillE N' Fp (resP N' (suc N') (dl N' y) b))))
          (transH (sidesP (resP N' (suc N') (dl N' y) b) N' (idH (lin N')) i3)
                  (KA.PT.pv-hom (suc N') b.1 b.2 N' _ (dl N' y) (comp-idr (lin N') (lin (suc N')) (dl N' y)) _ i1))))
     where {
       i1 : DB.Lands N' (suc N') b.2.pQ (dl N' y) =
         DB.lands-eq N' (suc N') b.2.pQ (compH (lin N') (lin (suc N')) (lin (suc N')) (idH (lin (suc N'))) (dl N' y)) (dl N' y)
           (comp-idl (lin N') (lin (suc N')) (dl N' y)) (DB.lands-comp N' (suc N') (suc N') b.2.pQ (idH (lin (suc N'))) (dl N' y) i0) ;
       i3 : DB.Lands N' N' (DB.pre N' (suc N') (dl N' y) b.2.pQ) (idH (lin N')) =
         DB.pre-lands N' N' (suc N') (dl N' y) b.2.pQ (idH (lin N'))
           (DB.lands-eq N' (suc N') b.2.pQ (dl N' y) (compH (lin N') (lin N') (lin (suc N')) (dl N' y) (idH (lin N')))
              (symH (comp-idr (lin N') (lin (suc N')) (dl N' y))) i1) ; } ;

    fp-c2 (b : Prob (suc N')) (y : Nat) (hy : IsT (leb y (suc N')))
      : Id (KA.TS.EI N') (KA.TS.E.act N' (suc N') (dl N' y) (b.1, S.c2 b)) (fillE N' Fp (resP N' (suc N') (dl N' y) b)) =
      ts-ext N' (KA.TS.E.act N' (suc N') (dl N' y) (b.1, S.c2 b)) (fillE N' Fp (resP N' (suc N') (dl N' y) b))
        (refl (KA.TV.E.act N' (suc N') (dl N' y) b.1))
        (\ W g j -> transH (lv-act N' (suc N') (dl N' y) (b.1, S.c2 b) W g j)
           (transH (St.c2-face b y hy W (compH (lin W) (lin N') (lin (suc N')) (dl N' y) g) j (dl-miss W N' y g))
                   (apH (\ k -> lv N' (St.u b y) W k j) (dgdl W N' y hy g)))) ;

    fpC (b : Prob (suc N')) (y : Nat) (hy : IsT (leb y (suc N'))) : (c : Bool) (ff : Id Bool (SCm.fullB (suc N') b) c)
      -> Id (KA.TS.EI N') (KA.TS.E.act N' (suc N') (dl N' y) (b.1, S.fillC b c ff)) (fillE N' Fp (resP N' (suc N') (dl N' y) b)) = split {
      true -> \ ff -> fp-c1 b y hy ff ;
      false -> \ ff -> fp-c2 b y hy } ;

    fp : SDm.FPr N' St.F Fp = \ b y hy -> fpC b y hy (SCm.fullB (suc N') b) (refl (SCm.fullB (suc N') b)) ;
  } ;
} ;
