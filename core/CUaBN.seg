-- CUaBN.seg (L6, inside CB): step (b) is uniform.  The full datum built
-- from d, restricted along h, is the one built from d restricted along h
-- (over pre h ph); CGlueCartNat, the B codes agreeing by act-o of GD.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UaBN (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  -- the classifier of the small copy along maps into GD, and (C1)
  (smallCl : (D : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l))
  (smallCl-sub : (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D])
     -> Id ((A : PTy[D']) * Cl D' A)
           (subTy D' D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) t,
            clSub D' D t (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) (smallCl D l))
           (CSmall.xsub D' CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t),
            smallCl D' (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t)))
  (X : Ob) (d : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 X) (ph : Phi X) (full : IsT (allS X ph))
  (J : Ob) (h : Hom J X) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module XS = CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  GDr : L.PCtx = UB.GDr ;

  module B = CUaB.UaB[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, X, d, ph, full] ;
  module B' = CUaB.UaB[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, J, GE.act1 J X h d, pre J X h ph, UA.fullAct J X h ph full] ;

  Pdg (W : Ob) (g : Hom W J) : Id (V1.Ix (GDr.ob W)) (B'.dg W g) (B.dg W (compH W J X h g)) = symH (GDr.act-o W J X h g d) ;

  Pio (W : Ob) (r : W0.Ix (B'.R.RC.ob W)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h r.1)))
    : Id (V1.Ix (GDr.ob W)) (B'.io W r) (B.io W (compH W J X h r.1, q2)) = apH (GDr.act W W (idH W)) (Pdg W r.1) ;

  PB (W : Ob) (g : Hom W J) (q : IsT (CGlueD.fl J (pre J X h ph) W g)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h g)))
    : Id (UU.U0 W) (B.B W (compH W J X h g) q2) (B'.B W g q) =
    apH {V1.Ix (GDr.ob W)} {UU.U0 W} (\ x -> (CSmall.xsub (yP W) GDr XS.SA (B.yhat W x), smallCl (yP W) (B.yhat W x))) (symH (Pdg W g)) ;

  PtA (W : Ob) (v : B'.TAt.EI W) (q2 : IsT (CGlueD.fl X ph W (compH W J X h v.1.1)))
    : Id (B.TAU.EI W) (B'.tA W v) (B.tA W ((compH W J X h v.1.1, q2), v.2)) =
    B.pair-eqV1 (V1.Ix (GDr.ob W)) (B.codeA W) (B'.io W v.1) (B.io W (compH W J X h v.1.1, q2)) (Pio W v.1 q2)
      (B'.tA W v).2 (B.tA W ((compH W J X h v.1.1, q2), v.2)).2 (apH (B.codeA W) (Pio W v.1 q2))
      (transH (apH (CExtEq1.sV (B.codeA W (B'.io W v.1)) (B.codeA W (B.io W (compH W J X h v.1.1, q2))) (apH (B.codeA W) (Pio W v.1 q2)))
                 (B'.trH-V W v.1.1 (B'.kk W v.1.1) (B'.Pk W v.1.1) v.2))
        (transH (CExtEq1.sV-two (B.o W (compH W J X h v.1.1)) (B.codeA W (B'.io W v.1)) (B.codeA W (B.io W (compH W J X h v.1.1, q2)))
                   (apH (B'.o W) (B'.Pk W v.1.1)) (apH (B.codeA W) (Pio W v.1 q2)) (apH (B.o W) (B.Pk W (compH W J X h v.1.1))) v.2)
                (symH (B.trH-V W (compH W J X h v.1.1) (B.kk W (compH W J X h v.1.1)) (B.Pk W (compH W J X h v.1.1)) v.2)))) ;

  PtB (W : Ob) (r : W0.Ix (B'.R.RC.ob W)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h r.1)))
    (b : W0.Ix (UU.fib0 W (B.B W (compH W J X h r.1) q2)))
    : Id (B.TS.EI W)
         (B'.tB W (r, subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (B.B W (compH W J X h r.1) q2) (B'.B W r.1 r.2) (PB W r.1 r.2 q2) b))
         (B.tB W ((compH W J X h r.1, q2), b)) =
    B.pair-eqV1 (V1.Ix (GDr.ob W)) (B.codeS W) (B'.io W r) (B.io W (compH W J X h r.1, q2)) (Pio W r q2)
      (subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (B.B W (compH W J X h r.1) q2) (B'.B W r.1 r.2) (PB W r.1 r.2 q2) b) b
      (apH (B.codeS W) (Pio W r q2))
      (transH (apH (CExtEq1.sV (B.codeS W (B'.io W r)) (B.codeS W (B.io W (compH W J X h r.1, q2))) (apH (B.codeS W) (Pio W r q2)))
                 (UU.substF W (B.B W (compH W J X h r.1) q2) (B'.B W r.1 r.2) (PB W r.1 r.2 q2) b))
              (CExtEq1.sV-two (B.codeS W (B.io W (compH W J X h r.1, q2))) (B.codeS W (B'.io W r)) (B.codeS W (B.io W (compH W J X h r.1, q2)))
                 (apH (UU.fib0 W) (PB W r.1 r.2 q2)) (apH (B.codeS W) (Pio W r q2)) (refl (B.codeS W (B.io W (compH W J X h r.1, q2)))) b)) ;

  opaque PtA ; opaque PtB ;

  module N = CGlueCartNat.GCN[Cl, clSub, clSub-id, clSub-o, encCl, X, B.F, ph, B.B, B.bn, GDr, XS.upSA, UB.AU, XS.extSA, XS.eqSA,
    B.io, B.io-nat, B.tA, \ W v -> refl (B.io W v.1), B.tAnat, B.tAinj, B.bkA, B.bkAta, B.tB, \ W v -> refl (B.io W v.1), B.tBnat, B.tBinj, \ Y x z -> z, \ Y x z -> refl (B.io Y x, z),
    J, h, B'.B, B'.bn,
    B'.io, B'.io-nat, B'.tA, \ W v -> refl (B'.io W v.1), B'.tAnat, B'.tAinj, B'.bkA, B'.bkAta, B'.tB, \ W v -> refl (B'.io W v.1), B'.tBnat, B'.tBinj, \ Y x z -> z, \ Y x z -> refl (B'.io Y x, z),
    PB, PtA, PtB] ;

  -- step (b) commutes with restriction
  law : Id (UA.UaT0 J (UU.uAct J X h B.F)) (UA.uaTact J X h B.F (UU.uAct J X h B.F) (refl (UU.uAct J X h B.F)) B.out) B'.out =
    UA.uaExt J (UU.uAct J X h B.F) (UA.uaTact J X h B.F (UU.uAct J X h B.F) (refl (UU.uAct J X h B.F)) B.out) B'.out N.law ;
} ;
