-- Ehrhard's equations, using the point maps of the presheaf CwF.
open CCodeOperations ;

subt-id (G : PCtx) (A : Ty G) (a : El G A)
  : Id (El G A) (subst (Ty G) (\ T -> El G T) (subT G G A (idS G)) A (subT-id G A)
      (subt G G A a (idS G))) a =
  term-subst G (subT G G A (idS G)) A (subT-id G A) (subt G G A a (idS G)) a
    (refl (decode G A).tob) (\ I x -> refl (a.eob I x)) ;

subt-o (T D G : PCtx) (A : Ty G) (a : El G A) (s : PSub[D, G]) (t : PSub[T, D])
  : Id (El T (subT T D (subT D G A s) t))
      (subst (Ty T) (\ X -> El T X) (subT T G A (oS T D G s t)) (subT T D (subT D G A s) t)
        (subT-o T D G A s t) (subt T G A a (oS T D G s t)))
      (subt T D (subT D G A s) (subt D G A a s) t) =
  term-subst T _ _ (subT-o T D G A s t) (subt T G A a (oS T D G s t)) (subt T D (subT D G A s) (subt D G A a s) t)
    (refl (\ I x -> F.ob I (A.1 I (s.nt I (t.nt I x))))) (\ I x -> refl (a.eob I (s.nt I (t.nt I x)))) ;

lift-id (G : PCtx) (A : Ty G)
  : Id (PSub[ext G A, ext G A])
      (subst (Ty G) (\ B -> PSub[ext G B, ext G A]) (subT G G A (idS G)) A (subT-id G A)
        (lift G G A (idS G))) (idS (ext G A)) =
  map-subst G (ext G A) (subT G G A (idS G)) A (subT-id G A) (lift G G A (idS G)) (idS (ext G A))
    (refl (decode G A).tob) (\ I x -> refl x) ;

module Two (T D G : PCtx) (A : Ty G) (s : PSub[D, G]) (t : PSub[T, D]) {
  A1 : Ty D = subT D G A s ;
  A2 : Ty T = subT T D A1 t ;
  A12 : Ty T = subT T G A (oS T D G s t) ;
  u : PSub[ext T A12, ext G A] = lift T G A (oS T D G s t) ;
  v : PSub[ext T A2, ext G A] = oS (ext T A2) (ext D A1) (ext G A) (lift D G A s) (lift T D A1 t) ;

  law : Id (PSub[ext T A2, ext G A]) (subst (Ty T) (\ B -> PSub[ext T B, ext G A]) A12 A2 (subT-o T D G A s t) u) v =
    map-subst T (ext G A) A12 A2 (subT-o T D G A s t) u v
      (refl (\ I x -> F.ob I (A.1 I (s.nt I (t.nt I x))))) (\ I x -> refl (v.nt I x)) ;
} ;

module Pullback (D G : PCtx) (A : Ty G) (s : PSub[D, G]) {
  A1 : Ty D = subT D G A s ;
  X : PCtx = ext D A1 ;
  Y : PCtx = ext G A ;
  sx : PSub[X, Y] = lift D G A s ;
  p1 : PSub[X, D] = p D A1 ;
  p0 : PSub[Y, G] = p G A ;

  proj : Id (PSub[X, G]) (oS X Y G p0 sx) (oS X D G s p1) =
    sub-ext X G (oS X Y G p0 sx) (oS X D G s p1) (\ I w -> refl (s.nt I w.1)) ;

  source : Ty X = subT X Y (subT Y G A p0) sx ;
  target : Ty X = subT X D A1 p1 ;

  path : Id (Ty X) source target =
    transH (symH (subT-o X Y G A p0 sx))
      (transH (apH (subT X G A) proj) (subT-o X D G A s p1)) ;

  var (P : Id (Ty X) source target)
    : Id (El X target) (subst (Ty X) (\ B -> El X B) source target P (subt X Y (subT Y G A p0) (q G A) sx))
        (q D A1) =
    term-subst X source target P (subt X Y (subT Y G A p0) (q G A) sx) (q D A1)
      (refl (\ I w -> F.ob I (A.1 I (s.nt I w.1)))) (\ I w -> refl w.2) ;
} ;

module Sections (G : PCtx) (A : Ty G) (a : El G A) {
  Y : PCtx = ext G A ;
  sa : PSub[G, Y] = sec G A a ;
  p0 : PSub[Y, G] = p G A ;

  proj : Id (PSub[G, G]) (oS G Y G p0 sa) (idS G) = pP-secP G (decode G A) a ;

  path : Id (Ty G) (subT G Y (subT Y G A p0) sa) A =
    transH (symH (subT-o G Y G A p0 sa))
      (transH (apH (subT G G A) proj) (subT-id G A)) ;

  var (P : Id (Ty G) (subT G Y (subT Y G A p0) sa) A)
    : Id (El G A) (subst (Ty G) (\ B -> El G B) (subT G Y (subT Y G A p0) sa) A P
        (subt G Y (subT Y G A p0) (q G A) sa)) a =
    term-subst G (subT G Y (subT Y G A p0) sa) A P (subt G Y (subT Y G A p0) (q G A) sa) a
      (refl (decode G A).tob) (\ I x -> refl (a.eob I x)) ;

  nat (D : PCtx) (s : PSub[D, G])
    : Id (PSub[D, Y]) (oS D G Y sa s) (oS D (ext D (subT D G A s)) Y (lift D G A s)
        (sec D (subT D G A s) (subt D G A a s))) =
    sub-ext D Y _ _ (\ I x -> refl (s.nt I x, a.eob I (s.nt I x))) ;
} ;

diagonal (G : PCtx) (A : Ty G)
  : Id (PSub[ext G A, ext G A])
      (oS (ext G A) (ext (ext G A) (subT (ext G A) G A (p G A))) (ext G A)
        (lift (ext G A) G A (p G A)) (sec (ext G A) (subT (ext G A) G A (p G A)) (q G A)))
      (idS (ext G A)) =
  sub-ext (ext G A) (ext G A) _ _ (\ I w -> refl w) ;

cwf : CwF.CwF[l+] =
  new CwF.CwF[l+,
    Ctx := PCtx, Sub := \ D G -> PSub[D, G], isSetSub := isSet-PSub, id := idS, o := oS,
    o-idl := S.PCwF.o-idl, o-idr := S.PCwF.o-idr, o-assoc := S.PCwF.o-assoc,
    nil := nilP, eps := epsP, eps-uniq := S.PCwF.eps-uniq,
    Ty := Ty, isSetTy := isSetTy, subT := subT, subT-id := subT-id, subT-o := subT-o,
    El := \ G A -> El G A, isSetEl := \ G A -> isSet-PEl G (decode G A),
    subt := subt, subt-id := subt-id, subt-o := subt-o, ext := ext, p := p, q := q, lift := lift, sec := sec,
    lift-id := lift-id, lift-o := \ T D G A s t -> Two[T, D, G, A, s, t].law,
    p-lift := \ D G A s -> Pullback[D, G, A, s].proj,
    p-sec := \ G A a -> Sections[G, A, a].proj,
    sec-o := \ D G A a s -> Sections[G, A, a].nat D s, lift-p-sec-q := diagonal,
    q-lift := \ D G A s -> Pullback[D, G, A, s].var Pullback[D, G, A, s].path,
    q-sec := \ G A a -> Sections[G, A, a].var Sections[G, A, a].path] ;
