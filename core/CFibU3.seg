-- CFibU3.seg (L7, inside CB): the universe is fibrant (model.tex Thm
-- "fibU").  A composition problem of U (the constant type UTy G) from
-- tgt d to src d gives a partial element of Ua at the start code: on its
-- sieve, at a side value (a line of codes), the side value of CFibU1
-- (transport along the line); natural by CFibU2.  The composite is the B
-- code at the identity of ua's extension; its sides are the sides' ends
-- (ua's kside) and it is uniform (ua's kunif).
--
-- Quarry: seg/model GCompU4, GCompU5.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module CU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  -- the classifier of the small copy along maps into GD, and (C1)
  (smallCl : (D : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l))
  (smallCl-sub : (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D])
     -> Id ((A : PTy[D']) * Cl D' A)
           (subTy D' D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) t,
            clSub D' D t (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) (smallCl D l))
           (CSmall.xsub D' CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t),
            smallCl D' (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t)))
  -- (C2): at a full point, the code of SA along the Yoneda map is B's
  (smallCl-full : (W : Ob) (y : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 W) (q : IsT (CGlueD.fl W y.1.2.1 W (idH W)))
     -> Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W)
           (CSmall.xsub (yP W) CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y),
            smallCl (yP W) (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y))
           (y.1.2.2.1 W (idH W) q))
  (G : L.PCtx) (d : Bool) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module OP = CUaOp.UaOp[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, smallCl-full] ;
  module PU = CPartial[a+].Partials[UU.UCtx, UA.UaTy] ;
  module TU = LP.TyL[UU.UCtx, UA.UaTy] ;
  module FGU = CLine[a+].FC[UU.UCtx] ;
  module UT = CLine[a+].Lines[G, UU.UTy G] ;
  module CK = UT.CompK[tgt d, src d] ;
  module EK = CK.EK ;
  module EVt = CLine[a+].FT[G, UU.UTy G].Ev[tgt d] ;
  module EVs = CLine[a+].FT[G, UU.UTy G].Ev[src d] ;
  module TT = LP.TyL[EK.TV.E, CK.Tend] ;

  -- the line of codes of a line in U
  lnC (V : Ob) (L : EK.TL.EI V) : V1.Ix (FGU.ob V) =
    (\ V' g j -> (L.2.1.1 V' g j).2, \ V'' V' g' g j -> apH (\ z -> z.2) (L.2.1.2 V'' V' g' g j)) ;

  lnC-act (V' V : Ob) (g : Hom V' V) (L : EK.TL.EI V) : Id (V1.Ix (FGU.ob V')) (lnC V' (EK.TL.E.act V' V g L)) (FGU.actF V' V g (lnC V L)) =
    FGU.fam-eq V' (lnC V' (EK.TL.E.act V' V g L)) (FGU.actF V' V g (lnC V L)) (\ W f j -> refl (L.2.1.1 W (compH W V' V g f) j).2) ;

  -- the tuples the side value depends on
  Tq (V : Ob) : U a+ = ((lam : V1.Ix (FGU.ob V)) * UU.U0 V) * ((ph : Phi V) * IsT (allS V ph)) ;
  Tup (V : Ob) : U a+ = (q : Tq V) * Id (UU.U0 V) ((FGU.ev (tgt d)).nt V q.1.1) q.1.2 ;

  svDat (V : Ob) (t : Tup V) : GE.GD1 V = CFibU1.SV[Cl, clSub, clSub-id, clSub-o, encCl, elFib, V, t.1.1.1, d, t.1.1.2, t.2, t.1.2.1, t.1.2.2].dat ;

  tup-eq (V : Ob) (t t' : Tup V) (P : Id (Tq V) t.1 t'.1) : Id (Tup V) t t' =
    Sigma-eq (Tq V) (\ q -> Id (UU.U0 V) ((FGU.ev (tgt d)).nt V q.1.1) q.1.2) t.1 t'.1 t.2 t'.2 P
      (DD.setU0 V ((FGU.ev (tgt d)).nt V t'.1.1.1) t'.1.1.2) ;

  flands (V : Ob) (Q : Phi V) (i : Lands V V Q (idH V)) (W : Ob) (f : Hom W V) : Lands W V Q f =
    lands-eq W V Q (compH W V V (idH V) f) f (comp-idl W V f) (lands-comp W V V Q (idH V) f i) ;

  fullEq (V : Ob) (ph ph' : Phi V) (f : IsT (allS V ph)) (f' : IsT (allS V ph'))
    : Id ((ph2 : Phi V) * IsT (allS V ph2)) (ph, f) (ph', f') =
    Sigma-eq (Phi V) (\ p -> IsT (allS V p)) ph ph' f f'
      (phi-ext V ph ph' (\ W g i -> flands V ph' (allS-sound V ph' f') W g) (\ W g i -> flands V ph (allS-sound V ph f) W g))
      (isProp-IsT' (allS V ph')) ;

  -- pairs of paths
  tq-eq (V : Ob) (l l' : V1.Ix (FGU.ob V)) (F F' : UU.U0 V) (ph ph' : Phi V) (f : IsT (allS V ph)) (f' : IsT (allS V ph'))
    (Pl : Id (V1.Ix (FGU.ob V)) l l') (PF : Id (UU.U0 V) F F') : Id (Tq V) ((l, F), (ph, f)) ((l', F'), (ph', f')) =
    transH (apH {V1.Ix (FGU.ob V)} {Tq V} (\ z -> ((z, F), (ph, f))) Pl)
      (transH (apH {UU.U0 V} {Tq V} (\ z -> ((l', z), (ph, f))) PF)
              (apH {(ph2 : Phi V) * IsT (allS V ph2)} {Tq V} (\ z -> ((l', F'), z)) (fullEq V ph ph' f f'))) ;

  ----------------------------------------------------------------------
  -- the partial element of Ua given by a problem of U

  module Pr (W : Ob) (x : EK.TV.EI W) (sd : EK.PT.Side[W, x]) {
    F0 : UU.U0 W = x.2 ;

    lamU (V : Ob) (f : Hom V W) (i : Lands V W sd.pQ f) : V1.Ix (FGU.ob V) = lnC V (EK.lineL V (sd.pv V f i)) ;

    -- the code of the line at tgt d is F0 f
    pFu (V : Ob) (f : Hom V W) (i : Lands V W sd.pQ f) : Id (UU.U0 V) ((FGU.ev (tgt d)).nt V (lamU V f i)) (UU.uAct V W f F0) =
      transH (apH {EK.TA.EI V} {UU.U0 V} (\ z -> z.2) (symH (EVt.endB-E V (EK.lineL V (sd.pv V f i)))))
        (transH (apH {EK.TV.EI V} {UU.U0 V} (\ z -> z.2) (sd.pv V f i).2.2)
                (apH {EK.TV.EI V} {UU.U0 V} (\ z -> z.2) (sd.ppt V f i))) ;

    tupU (V : Ob) (f : Hom V W) (i : Lands V W sd.pQ f) : Tup V =
      (((lamU V f i, UU.uAct V W f F0), (topS V, OP.fullTop V)), pFu V f i) ;

    pv (V : Ob) (f : Hom V W) (i : Lands V W sd.pQ f) : TU.EI V =
      (UU.uAct V W f F0, (svDat V (tupU V f i), (refl (UU.uAct V W f F0), OP.fullTop V))) ;

    module PN (V' V : Ob) (chi : Hom V' V) (f : Hom V W) (i : Lands V W sd.pQ f) (i' : Lands V' W sd.pQ (compH V' V W f chi)) {
      module N = CFibU2.SVN[Cl, clSub, clSub-id, clSub-o, encCl, elFib, V, lamU V f i, d, UU.uAct V W f F0, pFu V f i, topS V, OP.fullTop V, V', chi] ;

      t1 : Tup V' = (((FGU.actF V' V chi (lamU V f i), UU.uAct V' V chi (UU.uAct V W f F0)),
                      (pre V' V chi (topS V), UA.fullAct V' V chi (topS V) (OP.fullTop V))),
                     transH (FGU.evN (tgt d) V' V chi (lamU V f i)) (apH (UU.uAct V' V chi) (pFu V f i))) ;

      Pl : Id (V1.Ix (FGU.ob V')) (FGU.actF V' V chi (lamU V f i)) (lamU V' (compH V' V W f chi) i') =
        transH (symH (lnC-act V' V chi (EK.lineL V (sd.pv V f i))))
          (transH (apH (lnC V') (symH (EK.lineL-act V' V chi (sd.pv V f i))))
                  (apH (\ u -> lnC V' (EK.lineL V' u)) (sd.pnat V' V chi f i i'))) ;

      P : Id (GE.GD1 V') (GE.act1 V' V chi (svDat V (tupU V f i))) (svDat V' (tupU V' (compH V' V W f chi) i')) =
        transH N.law
          (apH (svDat V') (tup-eq V' t1 (tupU V' (compH V' V W f chi) i')
             (tq-eq V' (FGU.actF V' V chi (lamU V f i)) (lamU V' (compH V' V W f chi) i')
                (UU.uAct V' V chi (UU.uAct V W f F0)) (UU.uAct V' W (compH V' V W f chi) F0)
                (pre V' V chi (topS V)) (topS V') (UA.fullAct V' V chi (topS V) (OP.fullTop V)) (OP.fullTop V')
                Pl (symH (UU.uAct-o V' V W f chi F0))))) ;

      res : Id (TU.EI V') (TU.E.act V' V chi (pv V f i)) (pv V' (compH V' V W f chi) i') =
        OP.uaPair V' (UU.uAct V' V chi (UU.uAct V W f F0)) (UU.uAct V' W (compH V' V W f chi) F0) (symH (UU.uAct-o V' V W f chi F0))
          (TU.E.act V' V chi (pv V f i)).2 (pv V' (compH V' V W f chi) i').2 P ;
    } ;

    p' : PU.Side[W, F0] =
      new PU.Side[W, F0, sd.pQ, pv, \ V f i -> refl (UU.uAct V W f F0), \ V' V chi f i i' -> PN[V', V, chi, f, i, i'].res] ;

    -- the extension by ua, and its code: the composite
    ext : UA.UaT0 W F0 = OP.kop W F0 p' ;

    qId : IsT (CGlueD.fl W ext.1.1.2.1 W (idH W)) = UA.fullAct W W (idH W) ext.1.1.2.1 ext.2.2 ;

    Y : UU.U0 W = ext.1.1.2.2.1 W (idH W) qId ;
  } ;

  ----------------------------------------------------------------------
  -- B at the identity, along a path of glue data

  bEq (V : Ob) (D1 D2 : GE.GD1 V) (P : Id (GE.GD1 V) D1 D2) (q1 : IsT (CGlueD.fl V D1.1.2.1 V (idH V))) (q2 : IsT (CGlueD.fl V D2.1.2.1 V (idH V)))
    : Id (UU.U0 V) (D1.1.2.2.1 V (idH V) q1) (D2.1.2.2.1 V (idH V) q2) =
    idJ (GE.GD1 V) D1 (\ D3 P3 -> (q3 : IsT (CGlueD.fl V D3.1.2.1 V (idH V))) -> Id (UU.U0 V) (D1.1.2.2.1 V (idH V) q1) (D3.1.2.2.1 V (idH V) q3))
      (\ q3 -> apH (D1.1.2.2.1 V (idH V)) (isProp-IsT' (CGlueD.fl V D1.1.2.1 V (idH V)) q1 q3)) D2 P q2 ;

  -- B at the identity of a datum restricted along f: its B at f
  bAct (V W : Ob) (f : Hom V W) (D : GE.GD1 W) (q : IsT (CGlueD.fl W D.1.2.1 W (idH W)))
    (q' : IsT (CGlueD.fl V (GE.act1 V W f D).1.2.1 V (idH V)))
    : Id (UU.U0 V) (UU.uAct V W f (D.1.2.2.1 W (idH W) q)) ((GE.act1 V W f D).1.2.2.1 V (idH V) q') =
    D.1.2.2.2.1 V W f (idH W) q (compH V V W f (idH V)) (transH (comp-idl V W f) (symH (comp-idr V W f)))
      (CGlueD.fl-pre V W f D.1.2.1 V (idH V) q') ;

  -- an element of the composite type: its point and its code
  tt-ext (W : Ob) (z z' : TT.EI W) (P : Id (EK.TV.EI W) z.1 z'.1) (Q : Id (UU.U0 W) z.2 z'.2) : Id (TT.EI W) z z' =
    transH (apH {EK.TV.EI W} {TT.EI W} (\ a0 -> (a0, z.2)) P) (apH {UU.U0 W} {TT.EI W} (\ c -> (z'.1, c)) Q) ;

  kop (W : Ob) (x : EK.TV.EI W) (sd : EK.PT.Side[W, x]) : UU.U0 W = Pr[W, x, sd].Y ;

  module KS (W : Ob) (x : EK.TV.EI W) (sd : EK.PT.Side[W, x]) (W' : Ob) (f : Hom W' W) (i : Lands W' W sd.pQ f) {
    module P = Pr[W, x, sd] ;
    D : GE.GD1 W = P.ext.1 ;
    Ln : EK.TL.EI W' = EK.lineL W' (sd.pv W' f i) ;

    q' : IsT (CGlueD.fl W' (GE.act1 W' W f D).1.2.1 W' (idH W')) =
      UA.fullAct W' W' (idH W') (GE.act1 W' W f D).1.2.1 (UA.fullAct W' W f D.1.2.1 P.ext.2.2) ;

    qS : IsT (CGlueD.fl W' (svDat W' (P.tupU W' f i)).1.2.1 W' (idH W')) = UA.fullAct W' W' (idH W') (topS W') (OP.fullTop W') ;

    -- the restricted extension is the side value (ua's sides)
    C : Id (GE.GD1 W') (GE.act1 W' W f D) (svDat W' (P.tupU W' f i)) =
      apH {TU.EI W'} {GE.GD1 W'} (\ z -> z.2.1) (OP.kside W P.F0 P.p' W' f i) ;

    code : Id (UU.U0 W') (UU.uAct W' W f P.Y) (EVs.endB W' Ln) =
      transH (bAct W' W f D P.qId q')
        (transH (bEq W' (GE.act1 W' W f D) (svDat W' (P.tupU W' f i)) C q' qS)
          (transH (apH (\ l -> (FGU.ev (src d)).nt W' l) (FGU.actF-id W' (P.lamU W' f i)))
                  (apH {EK.TA.EI W'} {UU.U0 W'} (\ z -> z.2) (symH (EVs.endB-E W' Ln))))) ;

    res : Id (TT.EI W') (TT.E.act W' W f (x, kop W x sd)) (CK.endL.mE W' (sd.pv W' f i)) =
      tt-ext W' (TT.E.act W' W f (x, kop W x sd)) (CK.endL.mE W' (sd.pv W' f i)) (symH (sd.ppt W' f i)) code ;
  } ;

  kside (W : Ob) (x : EK.TV.EI W) (sd : EK.PT.Side[W, x]) (W' : Ob) (f : Hom W' W) (i : Lands W' W sd.pQ f)
    : Id (TT.EI W') (TT.E.act W' W f (x, kop W x sd)) (CK.endL.mE W' (sd.pv W' f i)) = KS[W, x, sd, W', f, i].res ;

  module KU (Y X : Ob) (h : Hom Y X) (x : EK.TV.EI X) (sd : EK.PT.Side[X, x]) {
    module PX = Pr[X, x, sd] ;
    module PY = Pr[Y, EK.TV.E.act Y X h x, EK.PT.rside Y X h x sd] ;
    D : GE.GD1 X = PX.ext.1 ;

    -- the restricted partial element is that of the restricted problem
    pvEq (V : Ob) (g : Hom V Y) (i : Lands V Y (pre Y X h sd.pQ) g) (i' : Lands V Y (pre Y X h sd.pQ) g)
      : Id (TU.EI V) ((PU.rside Y X h PX.F0 PX.p').pv V g i) (PY.p'.pv V g i') =
      OP.uaPair V (UU.uAct V X (compH V Y X h g) PX.F0) (UU.uAct V Y g (UU.uAct Y X h PX.F0)) (UU.uAct-o V Y X h g PX.F0)
        ((PU.rside Y X h PX.F0 PX.p').pv V g i).2 (PY.p'.pv V g i').2
        (apH (svDat V) (tup-eq V (PX.tupU V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i)) (PY.tupU V g i')
           (tq-eq V (PX.lamU V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i)) (PY.lamU V g i')
              (UU.uAct V X (compH V Y X h g) PX.F0) (UU.uAct V Y g (UU.uAct Y X h PX.F0))
              (topS V) (topS V) (OP.fullTop V) (OP.fullTop V)
              (apH (\ u -> lnC V (EK.lineL V u))
                 (EK.PT.pv-irr X x sd V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i) (lands-pre V Y X h sd.pQ g i')))
              (UU.uAct-o V Y X h g PX.F0)))) ;

    sdEq : Id (PU.Side[Y, UU.uAct Y X h PX.F0]) (PU.rside Y X h PX.F0 PX.p') PY.p' =
      PU.side-ext Y (UU.uAct Y X h PX.F0) (PU.rside Y X h PX.F0 PX.p') PY.p' (refl (pre Y X h sd.pQ)) pvEq ;

    E : Id (GE.GD1 Y) (GE.act1 Y X h D) PY.ext.1 =
      transH (apH {TU.EI Y} {GE.GD1 Y} (\ z -> z.2.1) (OP.kunif Y X h PX.F0 PX.p'))
        (apH {TU.EI Y} {GE.GD1 Y} (\ z -> z.2.1)
           (CPartial[a+].Rel[UU.UCtx, UA.UaTy, UA.UaTy, CPartial[a+].pmap-id UU.UCtx UA.UaTy].kop-cong OP.ua Y
              (UU.uAct Y X h PX.F0) (UU.uAct Y X h PX.F0) (refl (UU.uAct Y X h PX.F0)) (PU.rside Y X h PX.F0 PX.p') PY.p' sdEq)) ;

    q' : IsT (CGlueD.fl Y (GE.act1 Y X h D).1.2.1 Y (idH Y)) =
      UA.fullAct Y Y (idH Y) (GE.act1 Y X h D).1.2.1 (UA.fullAct Y X h D.1.2.1 PX.ext.2.2) ;

    res : Id (TT.EI Y) (TT.E.act Y X h (x, kop X x sd)) (EK.TV.E.act Y X h x, kop Y (EK.TV.E.act Y X h x) (EK.PT.rside Y X h x sd)) =
      tt-ext Y (TT.E.act Y X h (x, kop X x sd)) (EK.TV.E.act Y X h x, kop Y (EK.TV.E.act Y X h x) (EK.PT.rside Y X h x sd))
        (refl (EK.TV.E.act Y X h x))
        (transH (bAct Y X h D PX.qId q') (bEq Y (GE.act1 Y X h D) PY.ext.1 E q' PY.qId)) ;
  } ;

  kunif (Y X : Ob) (h : Hom Y X) (x : EK.TV.EI X) (sd : EK.PT.Side[X, x])
    : Id (TT.EI Y) (TT.E.act Y X h (x, kop X x sd)) (EK.TV.E.act Y X h x, kop Y (EK.TV.E.act Y X h x) (EK.PT.rside Y X h x sd)) =
    KU[Y, X, h, x, sd].res ;

  opaque kside ; opaque kunif ;

  -- the composition of U from tgt d to src d
  comp : CK.Comp = new CPartial[a+].Rel[EK.TV.E, EK.SFm.SF, CK.Tend, CK.endL].RC[kop, kside, kunif] ;
} ;


-- the universe is fibrant, in any context (model.tex Thm "fibU")
module FibU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  -- the classifier of the small copy along maps into GD, and (C1)
  (smallCl : (D : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l))
  (smallCl-sub : (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D])
     -> Id ((A : PTy[D']) * Cl D' A)
           (subTy D' D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) t,
            clSub D' D t (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) (smallCl D l))
           (CSmall.xsub D' CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t),
            smallCl D' (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t)))
  -- (C2): at a full point, the code of SA along the Yoneda map is B's
  (smallCl-full : (W : Ob) (y : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 W) (q : IsT (CGlueD.fl W y.1.2.1 W (idH W)))
     -> Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W)
           (CSmall.xsub (yP W) CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y),
            smallCl (yP W) (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y))
           (y.1.2.2.1 W (idH W) q)) (G : L.PCtx) {
  fibU : CLine[a+].Lines[G, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UTy G].Fib = (CU[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, smallCl-full, G, false].comp, CU[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, smallCl-full, G, true].comp) ;
} ;
