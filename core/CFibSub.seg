-- CFibSub.seg (L3, inside CB, level l): substitution of fibration
-- structures, the cartesian map of A[s] into A (CCart with the lift and
-- the identity on fibres).  Quarry: seg/model GSubst.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module GPR = GPre[l] ;
open GPR.PS ;

module FibSub (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) {
  module SE = CSub[l].SubE[D, G, s, A] ;

  module C = CCart[l, l].Cart[D, subTy D G A s, G, A, s.nt, s.nt-nat, SE.mV, \ W v -> refl (s.nt W v.1), SE.mV-nat, SE.mV-inj,
    \ X x u -> u, \ X x u -> refl (s.nt X x, u)] ;

  sub (c : CLine[l].Lines[G, A].Fib) : CLine[l].Lines[D, subTy D G A s].Fib = C.moveFib c ;
} ;
