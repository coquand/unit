-- CPostInput.seg: read a point of the internal limit in the cylinder
-- presentation used by CPostRec.  The endpoints are derived from Path;
-- they are not additional hypotheses on a point of the limit.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LM = CPostLimit[a, l] ;

module Read (G : PCtx) (B : Nat -> PTy[G]) (r : (N : Nat) -> PB.CHtpyOps[l].NMap[G, B (suc N), B N])
  (X : Ob) (x : W.Ix (G.ob X)) (z : W.Ix (LM.Tower[G, B, r].L.tob X x)) {
  module T = LM.Tower[G, B, r] ;
  XI : Ob = prodP X Iv ;
  xI : W.Ix (G.ob XI) = G.act XI X (pr1 X Iv) x ;
  module At (N : Nat) {
    module TB = PR.TyL[G, B N] ;
    raw : TB.EI XI = (z.2 N).1.1 XI (pr1 X Iv) (pr2 X Iv) ;
    pp : Id (W.Ix (G.ob XI)) raw.1 xI = (z.2 N).2.1 XI (pr1 X Iv) (pr2 X Iv) ;
    p : W.Ix ((B N).tob XI xI) = TB.fromE XI xI raw pp ;
    ep : Id (TB.EI XI) (xI, p) raw = TB.fromE-eq XI xI raw pp ;

    val (V : Ob) (f : Hom V X) (j : Hom V Iv)
      : Id (TB.EI V) (TB.E.act V XI (pairH X Iv V f j) (xI, p)) ((z.2 N).1.1 V f j) =
      transH (apH (TB.E.act V XI (pairH X Iv V f j)) ep)
        (transH ((z.2 N).1.2 V XI (pairH X Iv V f j) (pr1 X Iv) (pr2 X Iv))
          (transH (apH (\ k -> (z.2 N).1.1 V k (compH V XI Iv (pr2 X Iv) (pairH X Iv V f j))) (pr1-pair X Iv V f j))
            (apH ((z.2 N).1.1 V f) (pr2-pair X Iv V f j)))) ;
    end0 : Id (TB.EI X) (TB.E.act X XI (lid X e0) (xI, p)) (x, (r N).nfun X x (z.1 (suc N))) =
      transH (val X (idH X) (constH X Iv e0)) (z.2 N).2.2.1 ;
    end1 : Id (TB.EI X) (TB.E.act X XI (lid X e1) (xI, p)) (x, z.1 N) =
      transH (val X (idH X) (constH X Iv e1)) (z.2 N).2.2.2 ;
  } ;
  p (N : Nat) : W.Ix ((B N).tob XI xI) = At[N].p ;
} ;

module Input (G : PCtx) (A : PTy[G]) (X : Ob) (x : W.Ix (G.ob X))
  (z : W.Ix (LM.Post[G, A].L.tob X x)) {
  module P = LM.Post[G, A] ;
  module R = Read[G, P.B, P.r, X, x, z] ;
  module TA = PR.TyL[G, A] ;
  XI : Ob = R.XI ;
  xI : W.Ix (G.ob XI) = R.xI ;
  u (N : Nat) : P.Stage[N].D.DEl X x = z.1 N ;
  p (N : Nat) : P.Stage[N].D.DEl XI xI = R.p N ;

  module At (N : Nat) {
    module S = P.Stage[N] ;
    module TD = PR.TyL[G, P.B N] ;
    rd (Y : Ob) (w : TD.EI Y) (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) Y) : TA.EI (lin n) =
      S.K.ev n hn (S.D.rd Y w.1 w.2.1 n q) ;
    rd-act (Y Z : Ob) (h : Hom Y Z) (w : TD.EI Z) (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) Y)
      : Id (TA.EI (lin n)) (rd Y (TD.E.act Y Z h w) n hn q) (rd Z w n hn (compH (lin n) Y Z h q)) =
      apH (S.K.ev n hn) (S.D.rd-dtact Y Z h w.1 (G.act Y Z h w.1) (refl (G.act Y Z h w.1)) w.2 n q) ;
    pe0 (n : Nat) (hn : IsT (leb n N)) (hn' : IsT (leb n (suc N))) (q : Hom (lin n) X)
      : Id (TA.EI (lin n)) (rd XI (xI, p N) n hn (compH (lin n) X XI (lid X e0) q))
          (P.Stage[suc N].K.ev n hn' (P.Stage[suc N].D.rd X x (u (suc N)).1 n q)) =
      transH (symH (rd-act X XI (lid X e0) (xI, p N) n hn q))
        (transH (apH (\ w -> rd X w n hn q) R.At[N].end0)
          (P.Stage[suc N].K.rd-irr (lin n) (G.act (lin n) X q x) ((u (suc N)).1 n q).1 n
            (leb-trans n N (suc N) hn (leb-suc N)) hn' (idH (lin n)))) ;
    pe1 (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) X)
      : Id (TA.EI (lin n)) (rd XI (xI, p N) n hn (compH (lin n) X XI (lid X e1) q)) (rd X (x, u N) n hn q) =
      transH (symH (rd-act X XI (lid X e1) (xI, p N) n hn q)) (apH (\ w -> rd X w n hn q) R.At[N].end1) ;
  } ;

  module Construction (c : PB.CLine[l].Lines[G, A].Fib) {
    module Sq = CPostSquare[a, l].PS[G, A, c, X, x, u, p, \ N -> At[N].pe0, \ N -> At[N].pe1] ;
    module Rec = Sq.LL ;
    psi : P.DA.DEl X x = Rec.psi ;
  } ;
} ;

-- Evaluation on the cylinder commutes with restriction of a limit point.
module ReadNat (G : PCtx) (B : Nat -> PTy[G]) (r : (N : Nat) -> PB.CHtpyOps[l].NMap[G, B (suc N), B N])
  (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
  (z : W.Ix (LM.Tower[G, B, r].L.tob X x)) {
  module T = LM.Tower[G, B, r] ;
  z' : W.Ix (T.L.tob Y y) = T.L.tact Y X h x y e z ;
  module R1 = Read[G, B, r, X, x, z] ;
  module R2 = Read[G, B, r, Y, y, z'] ;
  pn (N : Nat) : Id (PR.TyL[G, B N].EI (prodP Y Iv))
    (PR.TyL[G, B N].E.act (prodP Y Iv) (prodP X Iv) (crossH Y X Iv Iv h (idH Iv)) (R1.xI, R1.p N))
    (R2.xI, R2.p N) =
    transH (apH (\ k -> PR.TyL[G, B N].E.act (prodP Y Iv) (prodP X Iv) k (R1.xI, R1.p N))
      (apH (pairH X Iv (prodP Y Iv) (compH (prodP Y Iv) Y X h (pr1 Y Iv))) (comp-idl (prodP Y Iv) Iv (pr2 Y Iv))))
      (transH (R1.At[N].val (prodP Y Iv) (compH (prodP Y Iv) Y X h (pr1 Y Iv)) (pr2 Y Iv)) (symH R2.At[N].ep)) ;
} ;
