-- The product of code maps names the generic fibrant product.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module DF = CDCodeFib[a] ;
module N = CDName[a] ;
module K = CDCodeContext[a] ;
module C = K.C ;
module O = K.Ops ;
module F = CDStructPi[a, a+] ;
module R = CDFibReindex[a, a+] ;
module P = N.P ;
module W = V[a+] ;
open P.PS ;
open SmallCat[a].Homs[N.DB.obV, N.DB.homV] ;

module Products (fU : N.DB.CLine[a++].Lines[N.B.U1, N.B.El1].Fib) {
  module D = DF.Model[fU] ;

  raw (G : PCtx) (A : C.C.Ty G) (B : C.C.Ty (O.ext G A)) : F.STy G =
    F.Pi G (D.decode G A) (D.decode (O.ext G A) B) ;

  named (G : PCtx) (X : F.STy G) : C.C.Ty G = N.name G X.1 X.2 ;

  Pi (G : PCtx) (A : C.C.Ty G) (B : C.C.Ty (O.ext G A)) : C.C.Ty G =
    named G (raw G A B) ;

  import CDCodePiNat ;
  import CDCodePiTerms ;
  import CDCodePiTermNat ;
} ;
