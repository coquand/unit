-- CExtEq1.seg (L5, inside CB): the cart from a glue point's own triple to
-- the universal triple (model.tex §6.2: the universal datum's e_U is the
-- points' e).  For D in GD1 at stage Z, iota_D : RC(Z , ph) -> resCtx,
-- (f , q) |-> (D f , q); the fibre maps are transports along comp-idr (A)
-- and along the B-codes (B).  Naturality of the maps reduces, through
-- tact-src-move / tact-move / tactG-cong, to transports in V of the same
-- element, which agree (V is a set).
--
-- Quarry: seg/model GExtEq (Pt).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

-- transport in V
sV (v w : W0.V) (c : Id W0.V v w) (z : W0.Ix v) : W0.Ix w = subst W0.V (\ u -> W0.Ix u) v w c z ;

sV-comp (u v w : W0.V) (c1 : Id W0.V u v) (c2 : Id W0.V v w) (z : W0.Ix u)
  : Id (W0.Ix w) (sV v w c2 (sV u v c1 z)) (sV u w (transH c1 c2) z) =
  idJ W0.V v (\ w2 c3 -> Id (W0.Ix w2) (sV v w2 c3 (sV u v c1 z)) (sV u w2 (transH c1 c3) z)) (refl (sV u v c1 z)) w c2 ;

sV-irr (v w : W0.V) (c c' : Id W0.V v w) (z : W0.Ix v) : Id (W0.Ix w) (sV v w c z) (sV v w c' z) =
  apH (\ q -> sV v w q z) (W0.isSetV v w c c') ;

-- two transports of the same element agree after any further transport
sV-two (u v w : W0.V) (c1 : Id W0.V u v) (c : Id W0.V v w) (c2 : Id W0.V u w) (z : W0.Ix u)
  : Id (W0.Ix w) (sV v w c (sV u v c1 z)) (sV u w c2 z) =
  transH (sV-comp u v w c1 c z) (sV-irr u w (transH c1 c) c2 z) ;

-- transport back and forth in any family
subst-round (A : U a+) (F : A -> U a+) (x y : A) (p : Id A x y) (z : F x) : Id (F x) (subst A F y x (symH p) (subst A F x y p z)) z =
  idJ A x (\ y2 p2 -> Id (F x) (subst A F y2 x (symH p2) (subst A F x y2 p2 z)) z) (refl z) y p ;

subst-round' (A : U a+) (F : A -> U a+) (x y : A) (p : Id A x y) (z : F y) : Id (F y) (subst A F x y p (subst A F y x (symH p) z)) z =
  idJ A x (\ y2 p2 -> (z2 : F y2) -> Id (F y2) (subst A F x y2 p2 (subst A F y2 x (symH p2) z2)) z2) (\ z2 -> refl z2) y p z ;

opaque sV-comp ; opaque sV-irr ; opaque sV-two ; opaque subst-round ; opaque subst-round' ;

module EQ1 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  RES : L.PCtx = UB.CU.resCtx ;

  -- El's action along paths of the source and target codes
  tactG-cong (V W : Ob) (g : Hom V W) (F1 F1' : UU.U0 W) (P : Id (UU.U0 W) F1 F1') (F2 F2' : UU.U0 V) (Q : Id (UU.U0 V) F2 F2')
    (e : Id (UU.U0 V) (UU.uAct V W g F1) F2) (e' : Id (UU.U0 V) (UU.uAct V W g F1') F2') (z : W0.Ix (UU.fib0 W F1))
    : Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                (UU.tactG V W g F1' F2' e' (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F1' P z)) =
    idJ (UU.U0 W) F1
      (\ F3 P3 -> (e3 : Id (UU.U0 V) (UU.uAct V W g F3) F2')
         -> Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                      (UU.tactG V W g F3 F2' e3 (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F3 P3 z)))
      (\ e3 -> idJ (UU.U0 V) F2
         (\ F4 Q4 -> (e4 : Id (UU.U0 V) (UU.uAct V W g F1) F4)
            -> Id (W0.Ix (UU.fib0 V F4)) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F4 Q4 (UU.tactG V W g F1 F2 e z))
                                        (UU.tactG V W g F1 F4 e4 z))
         (\ e4 -> CSmall.tact-irr UU.UCtx UU.El V W g F1 F2 e e4 z) F2' Q e3)
      F1' P e' ;

  opaque tactG-cong ;

  module Pt (Z : Ob) (D : GE.GD1 Z) {
    A0 : UU.U0 Z = D.1.1 ;
    module T0 = GE.Tr[Z, D.1.1, D.1.2.1, D.1.2.2] ;
    module RC = T0.R ;

    o (W : Ob) (k : Hom W Z) : W0.V = A0.1.tob W k ;

    trH (W : Ob) (k k' : Hom W Z) (p : Id (Hom W Z) k k') (z : W0.Ix (o W k)) : W0.Ix (o W k') =
      subst (Hom W Z) (\ k2 -> W0.Ix (o W k2)) k k' p z ;

    trH-V (W : Ob) (k k' : Hom W Z) (p : Id (Hom W Z) k k') (z : W0.Ix (o W k))
      : Id (W0.Ix (o W k')) (trH W k k' p z) (sV (o W k) (o W k') (apH (o W) p) z) =
      subst-ap (Hom W Z) W0.V (o W) (\ u -> W0.Ix u) k k' p z ;

    -- the map of contexts
    s (W : Ob) (r : W0.Ix (RC.RC.ob W)) : V1.Ix (RES.ob W) = (UB.GDr.act W Z r.1 D, r.2) ;

    s-nat (V W : Ob) (g : Hom V W) (r : W0.Ix (RC.RC.ob W)) : Id (V1.Ix (RES.ob V)) (s V (RC.RC.act V W g r)) (RES.act V W g (s W r)) =
      UB.CU.res-eq V (s V (RC.RC.act V W g r)) (RES.act V W g (s W r)) (UB.GDr.act-o V W Z r.1 g D) ;

    ----------------------------------------------------------------------
    -- A

    tA (W : Ob) (v : T0.TAt.EI W) : UB.TAU.EI W =
      (s W v.1, trH W v.1.1 (compH W W Z v.1.1 (idH W)) (symH (comp-idr W Z v.1.1)) v.2) ;

    -- pairs over codes, one level up
    pair-eqV1 (X : U a+) (code : X -> W0.V) (x x' : X) (R : Id X x x') (z : W0.Ix (code x)) (z' : W0.Ix (code x'))
      (c : Id W0.V (code x) (code x')) (H : Id (W0.Ix (code x')) (sV (code x) (code x') c z) z')
      : Id ((y : X) * W0.Ix (code y)) (x, z) (x', z') =
      idJ X x
        (\ x2 R2 -> (z2 : W0.Ix (code x2)) (c2 : Id W0.V (code x) (code x2))
           -> Id (W0.Ix (code x2)) (sV (code x) (code x2) c2 z) z2 -> Id ((y : X) * W0.Ix (code y)) (x, z) (x2, z2))
        (\ z2 c2 H2 -> apH {W0.Ix (code x)} {(y : X) * W0.Ix (code y)} (\ w -> (x, w))
           (transH (sV-irr (code x) (code x) (refl (code x)) c2 z) H2))
        x' R z' c H ;

    codeA (V : Ob) (y : V1.Ix (RES.ob V)) : W0.V = UU.fib0 V y.1.1.1 ;

    module NA (V W : Ob) (g : Hom V W) (v : T0.TAt.EI W) {
      f : Hom W Z = v.1.1 ;
      x : V1.Ix (RES.ob V) = RES.act V W g (s W v.1) ;
      x' : V1.Ix (RES.ob V) = s V (RC.RC.act V W g v.1) ;
      y0 : Hom V W = compH V V W g (idH V) ;
      eP : Id (UU.U0 V) (UU.uAct V W g (s W v.1).1.1.1) x.1.1.1 =
        L.ntEq UB.GDr UU.UCtx UB.pA V W g (s W v.1).1 x.1 (L.ntEq RES UB.GDr UB.CU.inclR V W g (s W v.1) x (refl x)) ;
      pL : Id (Hom V Z) (compH V W Z (compH W W Z f (idH W)) g) (compH V W Z f y0) =
        ntEq (yP W) (yP Z) (yH W Z f) V W g (idH W) y0 (UU.idf-eq V W g) ;
      eR : Id (Hom V Z) (compH V W Z f g) (compH V W Z f g) =
        ntEq RC.RC (yP Z) RC.inclRC V W g v.1 (RC.RC.act V W g v.1) (refl (RC.RC.act V W g v.1)) ;
      e' : Id (Hom V Z) (compH V W Z f g) (compH V W Z f y0) = apH (compH V W Z f) (symH (comp-idr V W g)) ;
      T : W0.Ix (o V (compH V W Z f g)) = A0.1.tact V W g f (compH V W Z f g) eR v.2 ;
      Xin : W0.Ix (o V (compH V W Z f y0)) =
        A0.1.tact V W g (compH W W Z f (idH W)) (compH V W Z f y0) pL (trH W f (compH W W Z f (idH W)) (symH (comp-idr W Z f)) v.2) ;

      Xin-T : Id (W0.Ix (o V (compH V W Z f y0))) Xin (sV (o V (compH V W Z f g)) (o V (compH V W Z f y0)) (apH (o V) e') T) =
        transH (UU.tact-src-move (yP Z) A0.1 V W g f (compH W W Z f (idH W)) (compH V W Z f y0) (symH (comp-idr W Z f)) pL e' v.2)
         (transH (symH (UU.tact-move (yP Z) A0.1 V W g f (compH V W Z f g) (compH V W Z f y0) eR e' e' v.2))
                 (trH-V V (compH V W Z f g) (compH V W Z f y0) e' T)) ;

      c3 : Id W0.V (o V (compH V W Z f g)) (codeA V x') = apH (o V) (symH (comp-idr V Z (compH V W Z f g))) ;
      c1 : Id W0.V (o V (compH V W Z f y0)) (codeA V x) = apH (UU.fib0 V) eP ;
      c2 : Id W0.V (o V (compH V W Z f g)) (o V (compH V W Z f y0)) = apH (o V) e' ;

      res : Id (UB.TAU.EI V) (UB.TAU.E.act V W g (tA W v)) (tA V (T0.TAt.E.act V W g v)) =
        pair-eqV1 (V1.Ix (RES.ob V)) (codeA V) x x' (symH (s-nat V W g v.1))
          (UB.AU'.tact V W g (s W v.1) x (refl x) (tA W v).2) (tA V (T0.TAt.E.act V W g v)).2
          (transH (symH c1) (transH (symH c2) c3))
          (transH (apH (sV (codeA V x) (codeA V x') (transH (symH c1) (transH (symH c2) c3)))
                     (transH (UU.substF V (UU.uAct V W g (s W v.1).1.1.1) x.1.1.1 eP Xin)
                             (apH (sV (o V (compH V W Z f y0)) (codeA V x) c1) Xin-T)))
           (transH (apH (sV (codeA V x) (codeA V x') (transH (symH c1) (transH (symH c2) c3)))
                      (sV-comp (o V (compH V W Z f g)) (o V (compH V W Z f y0)) (codeA V x) c2 c1 T))
            (transH (sV-two (o V (compH V W Z f g)) (codeA V x) (codeA V x') (transH c2 c1) (transH (symH c1) (transH (symH c2) c3)) c3 T)
                    (symH (trH-V V (compH V W Z f g) (compH V V Z (compH V W Z f g) (idH V)) (symH (comp-idr V Z (compH V W Z f g))) T))))) ;
    } ;

    tAnat (V W : Ob) (g : Hom V W) (v : T0.TAt.EI W) : Id (UB.TAU.EI V) (UB.TAU.E.act V W g (tA W v)) (tA V (T0.TAt.E.act V W g v)) =
      NA[V, W, g, v].res ;

    tAinj (W : Ob) (v v' : T0.TAt.EI W) (P : Id (W0.Ix (RC.RC.ob W)) v.1 v'.1) (Q : Id (UB.TAU.EI W) (tA W v) (tA W v'))
      : Id (T0.TAt.EI W) v v' =
      idJ (W0.Ix (RC.RC.ob W)) v.1
        (\ r2 P2 -> (b2 : W0.Ix (T0.At.tob W r2)) -> Id (UB.TAU.EI W) (tA W v) (tA W (r2, b2)) -> Id (T0.TAt.EI W) v (r2, b2))
        (\ b2 Q2 -> apH {W0.Ix (T0.At.tob W v.1)} {T0.TAt.EI W} (\ z -> (v.1, z))
           (transH (symH (subst-round (Hom W Z) (\ k -> W0.Ix (o W k)) v.1.1 (compH W W Z v.1.1 (idH W)) (symH (comp-idr W Z v.1.1)) v.2))
             (transH (apH (\ z -> subst (Hom W Z) (\ k -> W0.Ix (o W k)) (compH W W Z v.1.1 (idH W)) v.1.1 (symH (symH (comp-idr W Z v.1.1))) z)
                        (UB.TAU.pr-inj W (s W v.1) (tA W v).2 (tA W (v.1, b2)).2 Q2))
                     (subst-round (Hom W Z) (\ k -> W0.Ix (o W k)) v.1.1 (compH W W Z v.1.1 (idH W)) (symH (comp-idr W Z v.1.1)) b2))))
        v'.1 P v'.2 Q ;

    bkA (X : Ob) (r : W0.Ix (RC.RC.ob X)) (u : V1.Ix (UB.AU'.tob X (s X r))) : W0.Ix (T0.At.tob X r) =
      trH X (compH X X Z r.1 (idH X)) r.1 (symH (symH (comp-idr X Z r.1))) u ;

    bkAta (X : Ob) (r : W0.Ix (RC.RC.ob X)) (u : V1.Ix (UB.AU'.tob X (s X r))) : Id (UB.TAU.EI X) (tA X (r, bkA X r u)) (s X r, u) =
      apH {V1.Ix (UB.AU'.tob X (s X r))} {UB.TAU.EI X} (\ z -> (s X r, z))
        (subst-round' (Hom X Z) (\ k -> W0.Ix (o X k)) r.1 (compH X X Z r.1 (idH X)) (symH (comp-idr X Z r.1)) u) ;

    opaque tAinj ; opaque bkAta ;

    ----------------------------------------------------------------------
    -- B

    bd : DD.BD Z D.1.1 D.1.2.1 = D.1.2.2 ;

    q2 (W : Ob) (r : W0.Ix (RC.RC.ob W)) : IsT (CGlueD.fl Z D.1.2.1 W (compH W W Z r.1 (idH W))) =
      CGlueD.fl-pre W Z r.1 D.1.2.1 W (idH W) (UB.qU W (s W r).1 (s W r).2) ;

    PB (W : Ob) (r : W0.Ix (RC.RC.ob W)) : Id (UU.U0 W) (bd.1 W r.1 r.2) (bd.1 W (compH W W Z r.1 (idH W)) (q2 W r)) =
      DD.Bhom Z D.1.2.1 bd.1 W r.1 (compH W W Z r.1 (idH W)) (symH (comp-idr W Z r.1)) r.2 (q2 W r) ;

    trB (W : Ob) (F F' : UU.U0 W) (p : Id (UU.U0 W) F F') (b : W0.Ix (UU.fib0 W F)) : W0.Ix (UU.fib0 W F') =
      subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F F' p b ;

    tB (W : Ob) (v : T0.TBt.EI W) : UB.TBU.EI W = (s W v.1, trB W (bd.1 W v.1.1 v.1.2) (bd.1 W (compH W W Z v.1.1 (idH W)) (q2 W v.1)) (PB W v.1) v.2) ;

    codeB (V : Ob) (y : V1.Ix (RES.ob V)) : W0.V = UU.fib0 V (UB.bmap.nt V y) ;

    module NB (V W : Ob) (g : Hom V W) (v : T0.TBt.EI W) {
      f : Hom W Z = v.1.1 ;
      x : V1.Ix (RES.ob V) = RES.act V W g (s W v.1) ;
      x' : V1.Ix (RES.ob V) = s V (RC.RC.act V W g v.1) ;
      r' : W0.Ix (RC.RC.ob V) = RC.RC.act V W g v.1 ;
      F1 : UU.U0 W = bd.1 W f v.1.2 ;
      F1' : UU.U0 W = bd.1 W (compH W W Z f (idH W)) (q2 W v.1) ;
      F2 : UU.U0 V = bd.1 V r'.1 r'.2 ;
      F2' : UU.U0 V = UB.bmap.nt V x ;
      e : Id (UU.U0 V) (UU.uAct V W g F1) F2 = bd.2.1 V W g f v.1.2 r'.1 (apH (\ z -> z.1) (refl r')) r'.2 ;
      e2 : Id (UU.U0 V) (UU.uAct V W g F1') F2' = L.ntEq RES UU.UCtx UB.bmap V W g (s W v.1) x (refl x) ;
      Q : Id (UU.U0 V) F2 F2' = transH (symH e) (transH (apH (UU.uAct V W g) (PB W v.1)) e2) ;
      Y : W0.Ix (UU.fib0 V F2) = UU.tactG V W g F1 F2 e v.2 ;
      PB' : Id (UU.U0 V) F2 (bd.1 V (compH V V Z r'.1 (idH V)) (q2 V r')) = PB V r' ;
      c : Id W0.V (codeB V x) (codeB V x') = transH (symH (apH (UU.fib0 V) Q)) (apH (UU.fib0 V) PB') ;

      res : Id (UB.TBU.EI V) (UB.TBU.E.act V W g (tB W v)) (tB V (T0.TBt.E.act V W g v)) =
        pair-eqV1 (V1.Ix (RES.ob V)) (codeB V) x x' (symH (s-nat V W g v.1))
          (UB.BU.tact V W g (s W v.1) x (refl x) (tB W v).2) (tB V (T0.TBt.E.act V W g v)).2 c
          (transH (apH (sV (codeB V x) (codeB V x') c)
                     (transH (symH (tactG-cong V W g F1 F1' (PB W v.1) F2 F2' Q e e2 v.2))
                             (UU.substF V F2 F2' Q Y)))
            (transH (sV-two (UU.fib0 V F2) (codeB V x) (codeB V x') (apH (UU.fib0 V) Q) c (apH (UU.fib0 V) PB') Y)
                    (symH (UU.substF V F2 (bd.1 V (compH V V Z r'.1 (idH V)) (q2 V r')) PB' Y)))) ;
    } ;

    tBnat (V W : Ob) (g : Hom V W) (v : T0.TBt.EI W) : Id (UB.TBU.EI V) (UB.TBU.E.act V W g (tB W v)) (tB V (T0.TBt.E.act V W g v)) =
      NB[V, W, g, v].res ;

    tBinj (W : Ob) (v v' : T0.TBt.EI W) (P : Id (W0.Ix (RC.RC.ob W)) v.1 v'.1) (Q : Id (UB.TBU.EI W) (tB W v) (tB W v'))
      : Id (T0.TBt.EI W) v v' =
      idJ (W0.Ix (RC.RC.ob W)) v.1
        (\ r2 P2 -> (b2 : W0.Ix (T0.Bt.tob W r2)) -> Id (UB.TBU.EI W) (tB W v) (tB W (r2, b2)) -> Id (T0.TBt.EI W) v (r2, b2))
        (\ b2 Q2 -> apH {W0.Ix (T0.Bt.tob W v.1)} {T0.TBt.EI W} (\ z -> (v.1, z))
           (transH (symH (subst-round (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) (bd.1 W v.1.1 v.1.2) (bd.1 W (compH W W Z v.1.1 (idH W)) (q2 W v.1)) (PB W v.1) v.2))
             (transH (apH (\ z -> subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) (bd.1 W (compH W W Z v.1.1 (idH W)) (q2 W v.1)) (bd.1 W v.1.1 v.1.2) (symH (PB W v.1)) z)
                        (UB.TBU.pr-inj W (s W v.1) (tB W v).2 (tB W (v.1, b2)).2 Q2))
                     (subst-round (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) (bd.1 W v.1.1 v.1.2) (bd.1 W (compH W W Z v.1.1 (idH W)) (q2 W v.1)) (PB W v.1) b2))))
        v'.1 P v'.2 Q ;

    bkB (X : Ob) (r : W0.Ix (RC.RC.ob X)) (u : V1.Ix (UB.BU.tob X (s X r))) : W0.Ix (T0.Bt.tob X r) =
      trB X (bd.1 X (compH X X Z r.1 (idH X)) (q2 X r)) (bd.1 X r.1 r.2) (symH (PB X r)) u ;

    bkBta (X : Ob) (r : W0.Ix (RC.RC.ob X)) (u : V1.Ix (UB.BU.tob X (s X r))) : Id (UB.TBU.EI X) (tB X (r, bkB X r u)) (s X r, u) =
      apH {V1.Ix (UB.BU.tob X (s X r))} {UB.TBU.EI X} (\ z -> (s X r, z))
        (subst-round' (UU.U0 X) (\ G' -> W0.Ix (UU.fib0 X G')) (bd.1 X r.1 r.2) (bd.1 X (compH X X Z r.1 (idH X)) (q2 X r)) (PB X r) u) ;

    -- alpha commutes
    comm (W : Ob) (v : T0.TBt.EI W) : Id (UB.TAU.EI W) (tA W (T0.al.mE W v)) (UB.alU.mE W (tB W v)) =
      apH {V1.Ix (UB.AU'.tob W (s W v.1))} {UB.TAU.EI W} (\ z -> (s W v.1, z))
        (DD.alHom Z D.1.1 D.1.2.1 bd W v.1.1 (compH W W Z v.1.1 (idH W)) (symH (comp-idr W Z v.1.1)) v.1.2 (q2 W v.1) v.2) ;

    opaque tBnat ; opaque tBinj ; opaque bkBta ; opaque comm ;

    -- the cart, and D's equivalence moved to the universal triple
    module H = CHFibCart[a+, a].HCart[RC.RC, T0.Bt, T0.At, T0.al, RES, UB.BU, UB.AU', UB.alU, s, s-nat,
      tA, \ W v -> refl (s W v.1), tAnat, tAinj, bkA, bkAta,
      tB, \ W v -> refl (s W v.1), tBnat, tBinj, bkB, bkBta, comm] ;
  } ;
} ;
