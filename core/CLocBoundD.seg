-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- The first conclusion of Theorem 12.3: spheres bound => DA has a
-- uniform extension operation.  This part does not require composition.
level a l ;
constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ; open CSimp[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ; module B = CLocBound[a, l] ;

module Extension (G : PCtx) (A : PTy[G]) (spheres : B.Bounds[G, A].SpheresBound) {
  open B.Problems[G, A] ;
  open PR.TyL[G, A] ;
  module S = CLocBoundStage[a, l].Build[G, A, spheres] ;
  module R = CP.Rel[G, D.DA, D.DA, CP.pmap-id G D.DA] ;

  fam (X : Ob) (b : Prob X) : D.Fam X b.1 = \ n f -> S.fill n (resP (lin n) X f b) ;
  faces (X : Ob) (b : Prob X) : D.FaceCompat X b.1 (fam X b) = \ n f y hy ->
    transH (S.face n (resP (lin (suc n)) X f b) y hy)
      (apH (S.fillE n (S.fill n)) (symH (resP-o (lin n) (lin (suc n)) X (dl n y) f b))) ;
  kop (X : Ob) (x : Pt X) (s : P.Side[X, x]) : D.DEl X x =
    (fam X (x,s), D.FacesGen[X, x, fam X (x,s), faces X (x,s)].facesGen) ;

  kunif (Y X : Ob) (h : Hom Y X) (x : Pt X) (s : P.Side[X, x])
    : Id (TD.EI Y) (TD.E.act Y X h (x, kop X x s)) (G.act Y X h x, kop Y (G.act Y X h x) (P.rside Y X h x s)) =
    read-ext Y _ _ (refl (G.act Y X h x)) (\ n f ->
      transH (read-act Y X h (x, kop X x s) n f)
        (apH (S.fillE n (S.fill n)) (resP-o (lin n) Y X f h (x,s)))) ;

  kside (X : Ob) (x : Pt X) (s : P.Side[X, x]) (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f)
    : Id (TD.EI Y) (TD.E.act Y X f (x, kop X x s)) (s.pv Y f i) =
    read-ext Y _ _ (symH (s.ppt Y f i)) (\ n g -> at n g)
    where {
      j (n : Nat) (g : Hom (lin n) Y) : PB.Lands (lin n) X s.pQ (compH (lin n) Y X f g) =
        PB.lands-comp (lin n) Y X s.pQ f g i ;
      q (n : Nat) (g : Hom (lin n) Y) : IsT (fullB n (resP (lin n) X (compH (lin n) Y X f g) (x,s))) =
        land-res n X (compH (lin n) Y X f g) (x,s) (j n g) ;
      at (n : Nat) (g : Hom (lin n) Y) :
        Id (EI (lin n)) (read Y (TD.E.act Y X f (x, kop X x s)) n g) (read Y (s.pv Y f i) n g) =
        transH (read-act Y X f (x, kop X x s) n g)
          (transH (S.full n (resP (lin n) X (compH (lin n) Y X f g) (x,s)) (q n g))
            (transH (forced-res n X (compH (lin n) Y X f g) (x,s) (j n g) (q n g))
              (side-read X (x,s) Y f i n g (j n g)))) ;
    } ;
  opaque kside ; opaque kunif ;
  extension : CP.ContrOp G D.DA = new R.RC[kop, kside, kunif] ;
} ;
