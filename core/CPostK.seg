-- CPostK.seg (L9): reading an element of D_N A into i*K_N A (postnikov.tex,
-- Theorem conv, step 2: the prism p_N(f) in C_N).
--
-- z is an element of D_N A = D (K_N A) at (Y , y) and phi : P -> Y a map
-- from a poset with a height.  The reading of z along phi is the map
-- P -> i*K_N A
--
--   val W g  =  sgm^* (z at phi c)          g = c sgm  (CBoxEZ)
--
-- with no bound on the height: z at phi c is an element of K_N A.  As in
-- CPostMap.DR it is natural along every map of Delta (vn).
--
--   DRK               the reading
--   DRKI              along a strict iota, the reading along phi iota
--   DRKE              if z' agrees with z on the chains of P (read in A),
--                     the reading of z is eta after the A-reading of z'
--                     (CPostMap.DR), when the height is <= N , N'

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;

------------------------------------------------------------------------
-- the reading

module DRK (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (phi : Hom P Y) {
  module KM = CK.KT[G, A, N] ;
  module TK = KM.TK ;
  module DK = LD.DT[G, KM.KA] ;
  module GL = PB.GPre[l].PshL[G] ;

  yP : W0.Ix (G.ob P) = G.act P Y phi y ;

  -- z at a chain q : [r] -> Y
  zk (r : Nat) (q : Hom (lin r) Y) : TK.EI (lin r) = DK.rd Y y z.1 r q ;

  zk-mu (r1 r2 : Nat) (q : Hom (lin r1) Y) (mu : Hom (lin r2) (lin r1)) (ms : Strict (lin r2) (lin r1) mu)
    : Id (TK.EI (lin r2)) (TK.E.act (lin r2) (lin r1) mu (zk r1 q)) (zk r2 (compH (lin r2) (lin r1) Y q mu)) =
    z.2 r2 r1 mu ms q ;

  module At (W : Nat) (g : Hom (lin W) P) {
    module Z = EZ.EZX[P, ht, B, hB, hm, hi, W, g] ;
    pc : Hom (lin Z.r) Y = compH (lin Z.r) P Y phi Z.c ;
    val : TK.EI (lin W) = TK.E.act (lin W) (lin Z.r) Z.sgm (zk Z.r pc) ;

    vp : Id (W0.Ix (G.ob (lin W))) val.1 (G.act (lin W) P g yP) =
      calc (W0.Ix (G.ob (lin W))) {
          G.act (lin W) (lin Z.r) Z.sgm (G.act (lin Z.r) Y pc y)
        =< GL.actC (lin W) (lin Z.r) Y pc Z.sgm y >
          G.act (lin W) Y (compH (lin W) (lin Z.r) Y pc Z.sgm) y
        =< apH (\ k -> G.act (lin W) Y k y)
             (transH (comp-assoc (lin W) (lin Z.r) P Y phi Z.c Z.sgm) (apH (compH (lin W) P Y phi) Z.fac)) >
          G.act (lin W) Y (compH (lin W) P Y phi g) y
        =< G.act-o (lin W) P Y phi g y >
          G.act (lin W) P g yP } ;
  } ;

  val (W : Nat) (g : Hom (lin W) P) : TK.EI (lin W) = At[W, g].val ;

  vp (W : Nat) (g : Hom (lin W) P) : Id (W0.Ix (G.ob (lin W))) (val W g).1 (G.act (lin W) P g yP) = At[W, g].vp ;

  module VN (V W : Nat) (k : Hom (lin V) (lin W)) (g : Hom (lin W) P) {
    module K = EZ.EZXK[P, ht, B, hB, hm, hi, W, V, g, k] ;
    r1 : Nat = K.Z1.r ;
    r2 : Nat = K.Z2.r ;
    pc1 : Hom (lin r1) Y = compH (lin r1) P Y phi K.Z1.c ;
    pc2 : Hom (lin r2) Y = compH (lin r2) P Y phi K.Z2.c ;

    pcmu : Id (Hom (lin r2) Y) (compH (lin r2) (lin r1) Y pc1 K.mu) pc2 =
      transH (comp-assoc (lin r2) (lin r1) P Y phi K.Z1.c K.mu) (apH (compH (lin r2) P Y phi) K.cmu) ;

    mu-z : Id (TK.EI (lin r2)) (TK.E.act (lin r2) (lin r1) K.mu (zk r1 pc1)) (zk r2 pc2) =
      transH (zk-mu r1 r2 pc1 K.mu K.muStrict) (apH (zk r2) pcmu) ;

    res : Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) k (val W g)) (val V (compH (lin V) (lin W) P g k)) =
      calc (TK.EI (lin V)) {
          TK.E.act (lin V) (lin W) k (TK.E.act (lin W) (lin r1) K.Z1.sgm (zk r1 pc1))
        =< TK.PE.actC (lin V) (lin W) (lin r1) K.Z1.sgm k (zk r1 pc1) >
          TK.E.act (lin V) (lin r1) (compH (lin V) (lin W) (lin r1) K.Z1.sgm k) (zk r1 pc1)
        =< TK.PE.actEq (lin V) (lin r1) (compH (lin V) (lin W) (lin r1) K.Z1.sgm k) (compH (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm)
             K.muEq (zk r1 pc1) >
          TK.E.act (lin V) (lin r1) (compH (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm) (zk r1 pc1)
        =< TK.E.act-o (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm (zk r1 pc1) >
          TK.E.act (lin V) (lin r2) K.Z2.sgm (TK.E.act (lin r2) (lin r1) K.mu (zk r1 pc1))
        =< apH (TK.E.act (lin V) (lin r2) K.Z2.sgm) mu-z >
          TK.E.act (lin V) (lin r2) K.Z2.sgm (zk r2 pc2) } ;
    opaque mu-z ;
  } ;

  vn (V W : Nat) (k : Hom (lin V) (lin W)) (g : Hom (lin W) P)
    : Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) k (val W g)) (val V (compH (lin V) (lin W) P g k)) = VN[V, W, k, g].res ;
  opaque vp ; opaque vn ;
} ;

------------------------------------------------------------------------
-- along a strict iota : P' -> P, the reading along phi iota is the
-- reading along phi, precomposed with iota

module DRKI (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P' : Ob) (ht' : El P' -> Nat) (B' : Nat) (hB' : (x : El P') -> IsT (leb (ht' x) B'))
  (hm' : (x x' : El P') -> IsT (le P' x.1 x'.1) -> IsT (leb (ht' x) (ht' x')))
  (hi' : (x x' : El P') -> IsT (le P' x.1 x'.1) -> Id Nat (ht' x) (ht' x') -> Id Tree x.1 x'.1)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (phi : Hom P Y) (iota : Hom P' P) (ist : Strict P' P iota) (W : Nat) (g : Hom (lin W) P') {
  module D1 = DRK[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, phi] ;
  module D2 = DRK[G, A, N, Y, y, z, P', ht', B', hB', hm', hi', compH P' P Y phi iota] ;
  module E = EZ.EZXI[P', ht', B', hB', hm', hi', P, ht, B, hB, hm, hi, iota, ist, W, g] ;
  module TK = D1.TK ;
  r1 : Nat = E.Z1.r ;
  r2 : Nat = E.Z2.r ;

  res : Id (TK.EI (lin W)) (D2.val W g) (D1.val W (compH (lin W) P' P iota g)) =
    symH (calc (TK.EI (lin W)) {
        TK.E.act (lin W) (lin r1) E.Z1.sgm (D1.zk r1 (compH (lin r1) P Y phi E.Z1.c))
      =< TK.PE.actEq (lin W) (lin r1) E.Z1.sgm (compH (lin W) (lin r2) (lin r1) E.mu E.Z2.sgm) E.muEq
           (D1.zk r1 (compH (lin r1) P Y phi E.Z1.c)) >
        TK.E.act (lin W) (lin r1) (compH (lin W) (lin r2) (lin r1) E.mu E.Z2.sgm) (D1.zk r1 (compH (lin r1) P Y phi E.Z1.c))
      =< TK.E.act-o (lin W) (lin r2) (lin r1) E.mu E.Z2.sgm (D1.zk r1 (compH (lin r1) P Y phi E.Z1.c)) >
        TK.E.act (lin W) (lin r2) E.Z2.sgm (TK.E.act (lin r2) (lin r1) E.mu (D1.zk r1 (compH (lin r1) P Y phi E.Z1.c)))
      =< apH (TK.E.act (lin W) (lin r2) E.Z2.sgm) (D1.zk-mu r1 r2 (compH (lin r1) P Y phi E.Z1.c) E.mu E.muStrict) >
        TK.E.act (lin W) (lin r2) E.Z2.sgm (D1.zk r2 (compH (lin r2) (lin r1) Y (compH (lin r1) P Y phi E.Z1.c) E.mu))
      =< apH (\ q -> TK.E.act (lin W) (lin r2) E.Z2.sgm (D1.zk r2 q))
           (transH (comp-assoc (lin r2) (lin r1) P Y phi E.Z1.c E.mu)
             (transH (apH (compH (lin r2) P Y phi) E.cmu) (symH (comp-assoc (lin r2) P' P Y phi iota E.Z2.c)))) >
        TK.E.act (lin W) (lin r2) E.Z2.sgm (D1.zk r2 (compH (lin r2) P' Y (compH P' P Y phi iota) E.Z2.c)) }) ;
} ;

------------------------------------------------------------------------
-- if z' (in K_N') agrees with z on the chains of P, read in A, then the
-- reading of z in K_N is eta after the A-reading of z'

module DRKE (G : PP.PCtx) (A : PP.PTy[G]) (N N' : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (Y' : Ob) (y' : W0.Ix (G.ob Y')) (z' : LD.DT[G, CK.KT[G, A, N'].KA].DEl Y' y')
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (hBN : IsT (leb B N)) (hBN' : IsT (leb B N')) (phi : Hom P Y) (phi' : Hom P Y')
  (ch : (r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r N')) (c : Hom (lin r) P)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin r)) (PM.DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN, phi].zc r hr (compH (lin r) P Y phi c))
                                                 (PM.DR[G, A, N', Y', y', z', P, ht, B, hB, hm, hi, hBN', phi'].zc r hr' (compH (lin r) P Y' phi' c)))
  (W : Nat) (g : Hom (lin W) P) {
  module D1 = DRK[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, phi] ;
  module D2 = PM.DR[G, A, N', Y', y', z', P, ht, B, hB, hm, hi, hBN', phi'] ;
  module ET = CK.KT[G, A, N] ;
  module Z = EZ.EZX[P, ht, B, hB, hm, hi, W, g] ;
  module TK = D1.TK ;
  hr : IsT (leb Z.r N) = leb-trans Z.r B N Z.rle hBN ;
  hr' : IsT (leb Z.r N') = leb-trans Z.r B N' Z.rle hBN' ;
  pc : Hom (lin Z.r) Y = compH (lin Z.r) P Y phi Z.c ;

  res : Id (TK.EI (lin W)) (D1.val W g) (ET.etaE (lin W) (D2.val W g)) =
    calc (TK.EI (lin W)) {
        TK.E.act (lin W) (lin Z.r) Z.sgm (D1.zk Z.r pc)
      =< apH (TK.E.act (lin W) (lin Z.r) Z.sgm) (symH (ET.eta-ev Z.r hr (D1.zk Z.r pc))) >
        TK.E.act (lin W) (lin Z.r) Z.sgm (ET.etaE (lin Z.r) (ET.ev Z.r hr (D1.zk Z.r pc)))
      =< apH (\ w -> TK.E.act (lin W) (lin Z.r) Z.sgm (ET.etaE (lin Z.r) w)) (ch Z.r hr hr' Z.c) >
        TK.E.act (lin W) (lin Z.r) Z.sgm (ET.etaE (lin Z.r) (D2.zc Z.r hr' (compH (lin Z.r) P Y' phi' Z.c)))
      =< symH (ET.etaE-act (lin W) (lin Z.r) Z.sgm (D2.zc Z.r hr' (compH (lin Z.r) P Y' phi' Z.c))) >
        ET.etaE (lin W) (D2.val W g) } ;
} ;

------------------------------------------------------------------------
-- along a strict chain g, the image factorisation has a strict sgm

module SgS (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (W : Nat) (g : Hom (lin W) P) (gs : Strict (lin W) P g) {
  module Z = EZ.EZX[P, ht, B, hB, hm, hi, W, g] ;

  -- g read through c sgm
  gc (s : El (lin W)) : Id Tree (app (lin W) P g s).1 (app (lin Z.r) P Z.c (app (lin W) (lin Z.r) Z.sgm s)).1 =
    transH (apH (\ k -> (app (lin W) P k s).1) (symH Z.fac)) (app-compH1 (lin W) (lin Z.r) P Z.c Z.sgm s) ;

  ss : Strict (lin W) (lin Z.r) Z.sgm =
    BD.strict-of-inj (lin W) (lin Z.r) Z.sgm (\ s t e ->
      BD.lin-inj W P g gs s t
        (transH (gc s)
          (transH (apH (\ w -> (app (lin Z.r) P Z.c w).1) (el-eq (lin Z.r) (app (lin W) (lin Z.r) Z.sgm s) (app (lin W) (lin Z.r) Z.sgm t) e))
                  (symH (gc t))))) ;
} ;

------------------------------------------------------------------------
-- the reading along a strict chain g is z at phi g

module DRS (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (hBN : IsT (leb B N)) (phi : Hom P Y) (W : Nat) (g : Hom (lin W) P) (gs : Strict (lin W) P g) (hW : IsT (leb W N)) {
  module D = PM.DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN, phi] ;
  module S = SgS[P, ht, B, hB, hm, hi, W, g, gs] ;
  module Z = S.Z ;
  rN : IsT (leb Z.r N) = leb-trans Z.r B N Z.rle hBN ;

  res : Id (D.TA.EI (lin W)) (D.val W g) (D.zc W hW (compH (lin W) P Y phi g)) =
    transH (D.zc-mu Z.r W rN hW (compH (lin Z.r) P Y phi Z.c) Z.sgm S.ss)
      (apH (D.zc W hW) (transH (comp-assoc (lin W) (lin Z.r) P Y phi Z.c Z.sgm) (apH (compH (lin W) P Y phi) Z.fac))) ;
} ;

------------------------------------------------------------------------
-- the K-reading along a strict chain g is z at phi g

module DRKS (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (phi : Hom P Y) (W : Nat) (g : Hom (lin W) P) (gs : Strict (lin W) P g) {
  module D = DRK[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, phi] ;
  module S = SgS[P, ht, B, hB, hm, hi, W, g, gs] ;
  module Z = S.Z ;

  res : Id (D.TK.EI (lin W)) (D.val W g) (D.zk W (compH (lin W) P Y phi g)) =
    transH (D.zk-mu Z.r W (compH (lin Z.r) P Y phi Z.c) Z.sgm S.ss)
      (apH (D.zk W) (transH (comp-assoc (lin W) (lin Z.r) P Y phi Z.c Z.sgm) (apH (compH (lin W) P Y phi) Z.fac))) ;
} ;
