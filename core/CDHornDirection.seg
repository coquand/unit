-- The two endpoints and their simplex-vertex numbers.
level a ;
open Base ;
open Prelude[a] ;
open Paths[a] ;
open Trees[a] ;
module DB = CDeltaBase[a].DB ;

end-number : Bool -> Nat = split { true -> zero ; false -> suc zero } ;

end-leaf : (d : Bool) -> Id Tree (DB.src d).1 (leaf (end-number d)) = split {
  true -> refl (leaf zero) ;
  false -> refl (leaf (suc zero)) } ;

