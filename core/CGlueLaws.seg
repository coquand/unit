-- CGlueLaws.seg (L5, inside CB): the laws of the action on glue data with
-- their equivalence structure (model.tex Def "glue data": "restriction is
-- precomposition; its laws are equalities of codes").  On the codes the
-- laws are CGlueD.gd-id / gd-o; on the equivalence component, transport
-- along them is a move (CTrEq.lemT), moving twice is moving along the
-- composite (CHFibLaws.HComp), and the composite carts are pointwise the
-- identity / each other (HCong, HId): pointwise, transport keeps the map
-- into I (L1) and moves the fibre along a path of codes (L2A / L2B), and
-- pairs over equal codes are equal (pair-eqV).
--
-- Quarry: seg/model GGlueE (gd1-id, gd1-o).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;

-- transport back and forth
subst-inv (v w : W0.V) (c : Id W0.V v w) (z : W0.Ix v)
  : Id (W0.Ix v) (subst W0.V (\ u -> W0.Ix u) w v (symH c) (subst W0.V (\ u -> W0.Ix u) v w c z)) z =
  idJ W0.V v (\ w2 c2 -> Id (W0.Ix v) (subst W0.V (\ u -> W0.Ix u) w2 v (symH c2) (subst W0.V (\ u -> W0.Ix u) v w2 c2 z)) z)
    (refl z) w c ;

-- pairs over a family of codes are equal over equal points, through ANY
-- path of codes (V is a set)
pair-eqV (X : U a) (code : X -> W0.V) (x x' : X) (R : Id X x x') (z : W0.Ix (code x)) (z' : W0.Ix (code x'))
  (c : Id W0.V (code x) (code x')) (H : Id (W0.Ix (code x')) (subst W0.V (\ u -> W0.Ix u) (code x) (code x') c z) z')
  : Id ((y : X) * W0.Ix (code y)) (x, z) (x', z') =
  idJ X x
    (\ x2 R2 -> (z2 : W0.Ix (code x2)) (c2 : Id W0.V (code x) (code x2))
       -> Id (W0.Ix (code x2)) (subst W0.V (\ u -> W0.Ix u) (code x) (code x2) c2 z) z2 -> Id ((y : X) * W0.Ix (code y)) (x, z) (x2, z2))
    (\ z2 c2 H2 -> apH {W0.Ix (code x)} {(y : X) * W0.Ix (code y)} (\ w -> (x, w))
       (transH (apH (\ q -> subst W0.V (\ u -> W0.Ix u) (code x) (code x) q z) (W0.isSetV (code x) (code x) (refl (code x)) c2)) H2))
    x' R z' c H ;

opaque subst-inv ; opaque pair-eqV ;

module GL (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;

  -- the family of triples over the glue data at stage I
  Gf (I : Ob) (c : DD.GD0 I) : PCtx = CGlueE.RCm[I, c.2.1].RC ;
  Bf (I : Ob) (c : DD.GD0 I) : PTy[Gf I c] = GE.Tr[I, c.1, c.2.1, c.2.2].Bt ;
  Af (I : Ob) (c : DD.GD0 I) : PTy[Gf I c] = GE.Tr[I, c.1, c.2.1, c.2.2].At ;
  alf (I : Ob) (c : DD.GD0 I) : CPartial[a].PMap[Gf I c, Bf I c, Af I c] = GE.Tr[I, c.1, c.2.1, c.2.2].al ;

  ----------------------------------------------------------------------
  -- the transport cart, pointwise

  module Pw (I : Ob) (c1 : DD.GD0 I) {
    module TR = CTrEq.TrEq[DD.GD0 I, Gf I, Bf I, Af I, alf I, c1] ;

    L1 (c : DD.GD0 I) (P : Id (DD.GD0 I) c1 c) (W : Ob) (x : W0.Ix ((Gf I c).ob W)) : Id (Hom W I) (TR.s c P W x).1 x.1 =
      idJ (DD.GD0 I) c1 (\ c' P' -> (y : W0.Ix ((Gf I c').ob W)) -> Id (Hom W I) (TR.s c' P' W y).1 y.1) (\ y -> refl y.1) c P x ;

    QA (c : DD.GD0 I) (P : Id (DD.GD0 I) c1 c) (W : Ob) (x : W0.Ix ((Gf I c).ob W))
      : Id W0.V ((Af I c).tob W x) ((Af I c1).tob W (TR.s c P W x)) =
      idJ (DD.GD0 I) c1 (\ c' P' -> (y : W0.Ix ((Gf I c').ob W)) -> Id W0.V ((Af I c').tob W y) ((Af I c1).tob W (TR.s c' P' W y)))
        (\ y -> refl ((Af I c1).tob W y)) c P x ;

    L2A (c : DD.GD0 I) (P : Id (DD.GD0 I) c1 c) (W : Ob) (x : W0.Ix ((Gf I c).ob W)) (z : W0.Ix ((Af I c).tob W x))
      : Id (TR.TA c1 W) (TR.tA c P W (x, z)) (TR.s c P W x, subst W0.V (\ u -> W0.Ix u) ((Af I c).tob W x) ((Af I c1).tob W (TR.s c P W x)) (QA c P W x) z) =
      idJ (DD.GD0 I) c1
        (\ c' P' -> (y : W0.Ix ((Gf I c').ob W)) (z' : W0.Ix ((Af I c').tob W y))
           -> Id (TR.TA c1 W) (TR.tA c' P' W (y, z'))
                 (TR.s c' P' W y, subst W0.V (\ u -> W0.Ix u) ((Af I c').tob W y) ((Af I c1).tob W (TR.s c' P' W y)) (QA c' P' W y) z'))
        (\ y z' -> refl (y, z')) c P x z ;

    QB (c : DD.GD0 I) (P : Id (DD.GD0 I) c1 c) (W : Ob) (x : W0.Ix ((Gf I c).ob W))
      : Id W0.V ((Bf I c).tob W x) ((Bf I c1).tob W (TR.s c P W x)) =
      idJ (DD.GD0 I) c1 (\ c' P' -> (y : W0.Ix ((Gf I c').ob W)) -> Id W0.V ((Bf I c').tob W y) ((Bf I c1).tob W (TR.s c' P' W y)))
        (\ y -> refl ((Bf I c1).tob W y)) c P x ;

    L2B (c : DD.GD0 I) (P : Id (DD.GD0 I) c1 c) (W : Ob) (x : W0.Ix ((Gf I c).ob W)) (z : W0.Ix ((Bf I c).tob W x))
      : Id (TR.TB c1 W) (TR.tB c P W (x, z)) (TR.s c P W x, subst W0.V (\ u -> W0.Ix u) ((Bf I c).tob W x) ((Bf I c1).tob W (TR.s c P W x)) (QB c P W x) z) =
      idJ (DD.GD0 I) c1
        (\ c' P' -> (y : W0.Ix ((Gf I c').ob W)) (z' : W0.Ix ((Bf I c').tob W y))
           -> Id (TR.TB c1 W) (TR.tB c' P' W (y, z'))
                 (TR.s c' P' W y, subst W0.V (\ u -> W0.Ix u) ((Bf I c').tob W y) ((Bf I c1).tob W (TR.s c' P' W y)) (QB c' P' W y) z'))
        (\ y z' -> refl (y, z')) c P x z ;

    opaque L1 ; opaque L2A ; opaque L2B ;
  } ;

  ----------------------------------------------------------------------
  -- the identity law

  module LId (I : Ob) (D : GE.GD1 I) {
    module CH = GE.Chi[I, I, idH I, D.1] ;
    module PW = Pw[I, (DD.gdAct I I (idH I) D.1)] ;
    module TR = PW.TR ;

    P : Id (DD.GD0 I) (DD.gdAct I I (idH I) D.1) D.1 = DD.gd-id I D.1 ;

    module HC = CHFibLaws[a, a, a].HComp[Gf I D.1, Bf I D.1, Af I D.1, alf I D.1,
      Gf I (DD.gdAct I I (idH I) D.1), Bf I (DD.gdAct I I (idH I) D.1), Af I (DD.gdAct I I (idH I) D.1), alf I (DD.gdAct I I (idH I) D.1),
      Gf I D.1, Bf I D.1, Af I D.1, alf I D.1,
      TR.s D.1 P, TR.s-nat D.1 P, TR.tA D.1 P, TR.tApt D.1 P, TR.tAnat D.1 P, TR.tAinj D.1 P, TR.bkA D.1 P, TR.bkAta D.1 P, TR.tB D.1 P, TR.tBpt D.1 P, TR.tBnat D.1 P, TR.tBinj D.1 P, TR.bkB D.1 P, TR.bkBta D.1 P, TR.comm D.1 P,
      CH.sl.nt, CH.sl.nt-nat, CH.tA, \ W v -> refl (CH.sl.nt W v.1), CH.tAnat, CH.tAinj, \ X x u -> u, \ X x u -> refl (CH.sl.nt X x, u), CH.tB, \ W v -> refl (CH.sl.nt W v.1), CH.tBnat, CH.tBinj, \ X x u -> u, \ X x u -> refl (CH.sl.nt X x, u), \ W v -> refl (CH.tA W (CH.T1.al.mE W v)), D.2] ;

    rP (W : Ob) (x : W0.Ix ((Gf I D.1).ob W)) : Id (W0.Ix ((Gf I D.1).ob W)) (CH.sl.nt W (TR.s D.1 P W x)) x =
      CGlueE.RCm[I, D.1.2.1].pt-eq W (CH.sl.nt W (TR.s D.1 P W x)) x (transH (comp-idl W I (TR.s D.1 P W x).1) (PW.L1 D.1 P W x)) ;

    PtA (W : Ob) (v : TR.TA D.1 W) : Id (TR.TA D.1 W) (HC.tA W v) v =
      transH (apH (CH.tA W) (PW.L2A D.1 P W v.1 v.2))
        (pair-eqV (W0.Ix ((Gf I D.1).ob W)) (\ y -> (Af I D.1).tob W y) (CH.sl.nt W (TR.s D.1 P W v.1)) v.1 (rP W v.1)
           (subst W0.V (\ u -> W0.Ix u) ((Af I D.1).tob W v.1) ((Af I (DD.gdAct I I (idH I) D.1)).tob W (TR.s D.1 P W v.1)) (PW.QA D.1 P W v.1) v.2) v.2
           (symH (PW.QA D.1 P W v.1)) (subst-inv ((Af I D.1).tob W v.1) ((Af I (DD.gdAct I I (idH I) D.1)).tob W (TR.s D.1 P W v.1)) (PW.QA D.1 P W v.1) v.2)) ;

    PtB (W : Ob) (v : TR.TB D.1 W) : Id (TR.TB D.1 W) (HC.tB W v) v =
      transH (apH (CH.tB W) (PW.L2B D.1 P W v.1 v.2))
        (pair-eqV (W0.Ix ((Gf I D.1).ob W)) (\ y -> (Bf I D.1).tob W y) (CH.sl.nt W (TR.s D.1 P W v.1)) v.1 (rP W v.1)
           (subst W0.V (\ u -> W0.Ix u) ((Bf I D.1).tob W v.1) ((Bf I (DD.gdAct I I (idH I) D.1)).tob W (TR.s D.1 P W v.1)) (PW.QB D.1 P W v.1) v.2) v.2
           (symH (PW.QB D.1 P W v.1)) (subst-inv ((Bf I D.1).tob W v.1) ((Bf I (DD.gdAct I I (idH I) D.1)).tob W (TR.s D.1 P W v.1)) (PW.QB D.1 P W v.1) v.2)) ;

    module HI = CHFibLaws[a, a, a].HId[Gf I D.1, Bf I D.1, Af I D.1, alf I D.1, D.2] ;

    eqPart : Id (GE.EqOn I D.1) (subst (DD.GD0 I) (GE.EqOn I) (DD.gdAct I I (idH I) D.1) D.1 P (CH.H.moveEq D.2)) D.2 =
      transH (TR.lemT D.1 P (CH.H.moveEq D.2))
       (transH HC.comp
        (transH (CHFibLaws[a, a, a].HCong[Gf I D.1, Bf I D.1, Af I D.1, alf I D.1, Gf I D.1, Bf I D.1, Af I D.1, alf I D.1,
                   HC.s, HC.s-nat, HC.tA, HC.tApt, HC.tAnat, HC.tAinj, HC.bkA, HC.bkAta, HC.tB, HC.tBpt, HC.tBnat, HC.tBinj, HC.bkB, HC.bkBta, HC.comm,
                   \ W d -> d, \ V W g d -> refl ((Gf I D.1).act V W g d), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (GPR.TyL[(Gf I D.1), (Af I D.1)].E.act V W g v), \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (GPR.TyL[(Gf I D.1), (Bf I D.1)].E.act V W g v), \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> refl ((alf I D.1).mE W v),
                   PtA, PtB, D.2].cong)
                HI.idm)) ;

    law : Id (GE.GD1 I) (GE.act1 I I (idH I) D) D =
      Sigma-path (DD.GD0 I) (GE.EqOn I) (DD.gdAct I I (idH I) D.1) D.1 (CH.H.moveEq D.2) D.2 P eqPart ;
  } ;

  ----------------------------------------------------------------------
  -- the composition law

  module LO (K J I : Ob) (h : Hom J I) (k : Hom K J) (D : GE.GD1 I) {
    module CHhk = GE.Chi[K, I, compH K J I h k, D.1] ;
    module CHh = GE.Chi[J, I, h, D.1] ;
    module CHk = GE.Chi[K, J, k, (DD.gdAct J I h D.1)] ;
    module PW = Pw[K, (DD.gdAct K I (compH K J I h k) D.1)] ;
    module TR = PW.TR ;

    P : Id (DD.GD0 K) (DD.gdAct K I (compH K J I h k) D.1) (DD.gdAct K J k (DD.gdAct J I h D.1)) = DD.gd-o K J I h k D.1 ;

    module HCA = CHFibLaws[a, a, a].HComp[Gf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Bf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Af K (DD.gdAct K J k (DD.gdAct J I h D.1)), alf K (DD.gdAct K J k (DD.gdAct J I h D.1)),
      Gf K (DD.gdAct K I (compH K J I h k) D.1), Bf K (DD.gdAct K I (compH K J I h k) D.1), Af K (DD.gdAct K I (compH K J I h k) D.1), alf K (DD.gdAct K I (compH K J I h k) D.1),
      Gf I D.1, Bf I D.1, Af I D.1, alf I D.1,
      TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.s-nat (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tA (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tApt (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tAnat (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tAinj (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.bkA (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.bkAta (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tB (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tBpt (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tBnat (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.tBinj (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.bkB (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.bkBta (DD.gdAct K J k (DD.gdAct J I h D.1)) P, TR.comm (DD.gdAct K J k (DD.gdAct J I h D.1)) P,
      CHhk.sl.nt, CHhk.sl.nt-nat, CHhk.tA, \ W v -> refl (CHhk.sl.nt W v.1), CHhk.tAnat, CHhk.tAinj, \ X x u -> u, \ X x u -> refl (CHhk.sl.nt X x, u), CHhk.tB, \ W v -> refl (CHhk.sl.nt W v.1), CHhk.tBnat, CHhk.tBinj, \ X x u -> u, \ X x u -> refl (CHhk.sl.nt X x, u), \ W v -> refl (CHhk.tA W (CHhk.T1.al.mE W v)), D.2] ;

    module HCB = CHFibLaws[a, a, a].HComp[Gf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Bf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Af K (DD.gdAct K J k (DD.gdAct J I h D.1)), alf K (DD.gdAct K J k (DD.gdAct J I h D.1)),
      Gf J (DD.gdAct J I h D.1), Bf J (DD.gdAct J I h D.1), Af J (DD.gdAct J I h D.1), alf J (DD.gdAct J I h D.1),
      Gf I D.1, Bf I D.1, Af I D.1, alf I D.1,
      CHk.sl.nt, CHk.sl.nt-nat, CHk.tA, \ W v -> refl (CHk.sl.nt W v.1), CHk.tAnat, CHk.tAinj, \ X x u -> u, \ X x u -> refl (CHk.sl.nt X x, u), CHk.tB, \ W v -> refl (CHk.sl.nt W v.1), CHk.tBnat, CHk.tBinj, \ X x u -> u, \ X x u -> refl (CHk.sl.nt X x, u), \ W v -> refl (CHk.tA W (CHk.T1.al.mE W v)),
      CHh.sl.nt, CHh.sl.nt-nat, CHh.tA, \ W v -> refl (CHh.sl.nt W v.1), CHh.tAnat, CHh.tAinj, \ X x u -> u, \ X x u -> refl (CHh.sl.nt X x, u), CHh.tB, \ W v -> refl (CHh.sl.nt W v.1), CHh.tBnat, CHh.tBinj, \ X x u -> u, \ X x u -> refl (CHh.sl.nt X x, u), \ W v -> refl (CHh.tA W (CHh.T1.al.mE W v)), D.2] ;

    rP (W : Ob) (x : W0.Ix ((Gf K (DD.gdAct K J k (DD.gdAct J I h D.1))).ob W))
      : Id (W0.Ix ((Gf I D.1).ob W)) (CHhk.sl.nt W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W x)) (CHh.sl.nt W (CHk.sl.nt W x)) =
      CGlueE.RCm[I, D.1.2.1].pt-eq W (CHhk.sl.nt W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W x)) (CHh.sl.nt W (CHk.sl.nt W x))
        (transH (apH (compH W K I (compH K J I h k)) (PW.L1 (DD.gdAct K J k (DD.gdAct J I h D.1)) P W x)) (comp-assoc W K J I h k x.1)) ;

    PtA (W : Ob) (v : TR.TA (DD.gdAct K J k (DD.gdAct J I h D.1)) W) : Id (GPR.TyL[Gf I D.1, Af I D.1].EI W) (HCA.tA W v) (HCB.tA W v) =
      transH (apH (CHhk.tA W) (PW.L2A (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1 v.2))
        (pair-eqV (W0.Ix ((Gf I D.1).ob W)) (\ y -> (Af I D.1).tob W y) (CHhk.sl.nt W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (CHh.sl.nt W (CHk.sl.nt W v.1)) (rP W v.1)
           (subst W0.V (\ u -> W0.Ix u) ((Af K (DD.gdAct K J k (DD.gdAct J I h D.1))).tob W v.1) ((Af K (DD.gdAct K I (compH K J I h k) D.1)).tob W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (PW.QA (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1) v.2) v.2
           (symH (PW.QA (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (subst-inv ((Af K (DD.gdAct K J k (DD.gdAct J I h D.1))).tob W v.1) ((Af K (DD.gdAct K I (compH K J I h k) D.1)).tob W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (PW.QA (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1) v.2)) ;

    PtB (W : Ob) (v : TR.TB (DD.gdAct K J k (DD.gdAct J I h D.1)) W) : Id (GPR.TyL[Gf I D.1, Bf I D.1].EI W) (HCA.tB W v) (HCB.tB W v) =
      transH (apH (CHhk.tB W) (PW.L2B (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1 v.2))
        (pair-eqV (W0.Ix ((Gf I D.1).ob W)) (\ y -> (Bf I D.1).tob W y) (CHhk.sl.nt W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (CHh.sl.nt W (CHk.sl.nt W v.1)) (rP W v.1)
           (subst W0.V (\ u -> W0.Ix u) ((Bf K (DD.gdAct K J k (DD.gdAct J I h D.1))).tob W v.1) ((Bf K (DD.gdAct K I (compH K J I h k) D.1)).tob W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (PW.QB (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1) v.2) v.2
           (symH (PW.QB (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (subst-inv ((Bf K (DD.gdAct K J k (DD.gdAct J I h D.1))).tob W v.1) ((Bf K (DD.gdAct K I (compH K J I h k) D.1)).tob W (TR.s (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1)) (PW.QB (DD.gdAct K J k (DD.gdAct J I h D.1)) P W v.1) v.2)) ;

    eqPart : Id (GE.EqOn K (DD.gdAct K J k (DD.gdAct J I h D.1))) (subst (DD.GD0 K) (GE.EqOn K) (DD.gdAct K I (compH K J I h k) D.1) (DD.gdAct K J k (DD.gdAct J I h D.1)) P (CHhk.H.moveEq D.2)) (CHk.H.moveEq (CHh.H.moveEq D.2)) =
      transH (TR.lemT (DD.gdAct K J k (DD.gdAct J I h D.1)) P (CHhk.H.moveEq D.2))
       (transH HCA.comp
        (transH (CHFibLaws[a, a, a].HCong[Gf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Bf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Af K (DD.gdAct K J k (DD.gdAct J I h D.1)), alf K (DD.gdAct K J k (DD.gdAct J I h D.1)), Gf I D.1, Bf I D.1, Af I D.1, alf I D.1,
                   HCA.s, HCA.s-nat, HCA.tA, HCA.tApt, HCA.tAnat, HCA.tAinj, HCA.bkA, HCA.bkAta, HCA.tB, HCA.tBpt, HCA.tBnat, HCA.tBinj, HCA.bkB, HCA.bkBta, HCA.comm,
                   HCB.s, HCB.s-nat, HCB.tA, HCB.tApt, HCB.tAnat, HCB.tAinj, HCB.bkA, HCB.bkAta, HCB.tB, HCB.tBpt, HCB.tBnat, HCB.tBinj, HCB.bkB, HCB.bkBta, HCB.comm,
                   PtA, PtB, D.2].cong)
                (symH HCB.comp))) ;

    law : Id (GE.GD1 K) (GE.act1 K I (compH K J I h k) D) (GE.act1 K J k (GE.act1 J I h D)) =
      Sigma-path (DD.GD0 K) (GE.EqOn K) (DD.gdAct K I (compH K J I h k) D.1) (DD.gdAct K J k (DD.gdAct J I h D.1)) (CHhk.H.moveEq D.2) (CHk.H.moveEq (CHh.H.moveEq D.2)) P eqPart ;
  } ;

  gd1-id (I : Ob) (D : GE.GD1 I) : Id (GE.GD1 I) (GE.act1 I I (idH I) D) D = LId[I, D].law ;

  gd1-o (K J I : Ob) (h : Hom J I) (k : Hom K J) (D : GE.GD1 I)
    : Id (GE.GD1 K) (GE.act1 K I (compH K J I h k) D) (GE.act1 K J k (GE.act1 J I h D)) = LO[K, J, I, h, k, D].law ;

  opaque gd1-id ; opaque gd1-o ;

  ----------------------------------------------------------------------
  -- the code, and the presheaf of glue data with their equivalences

  encGD1 (I : Ob) : Enc (GE.GD1 I) =
    encSig (DD.GD0 I) (\ d -> GE.EqOn I d) (DD.encGD I) (\ d -> CEnc.encEq (Gf I d) (Bf I d) (Af I d) (alf I d)) ;

  encGD1f (I : Ob) (D : GE.GD1 I) : V1.V = (encGD1 I).1 D ;

  encGD1inj (I : Ob) : V1.Inj (GE.GD1 I) (encGD1f I) = (encGD1 I).2 ;

  opaque encGD1f ; opaque encGD1inj ;

  codeGD1 (I : Ob) : V1.V = V1.mkV (GE.GD1 I) (encGD1f I) (encGD1inj I) ;

  GD1Ctx : GPre[a+].PS.PCtx = new GPre[a+].PS.PCtx[codeGD1, GE.act1, gd1-id, gd1-o] ;
} ;
