-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostNat.seg: naturality of the inverse construction.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LM = CPostLimit[a, l] ;


module EX = CPostExt[a, l] ;
module PM = CPostMap[a, l] ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module RC = CPostRec[a, l] ;

module Nat (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
  (z : W.Ix (LM.Post[G, A].L.tob X x)) {
  module P = LM.Post[G, A] ;
  module RN = CPostInput[a, l].ReadNat[G, P.B, P.r, Y, X, h, x, y, e, z] ;
  module I1 = CPostInput[a, l].Input[G, A, X, x, z] ;
  module I2 = CPostInput[a, l].Input[G, A, Y, y, RN.z'] ;
  module R1 = I1.Construction[c].Rec ;
  module R2 = I2.Construction[c].Rec ;
  module TA = PR.TyL[G, A] ;

  hf (m : Nat) (f : Hom (lin m) Y) : Hom (lin m) X = compH (lin m) Y X h f ;
  xf (m : Nat) (f : Hom (lin m) Y) : Id (W.Ix (G.ob (lin m))) (R1.xf m (hf m f)) (R2.xf m f) =
    transH (G.act-o (lin m) Y X h f x) (apH (G.act (lin m) Y f) e) ;
  module UR (m N : Nat) (f : Hom (lin m) Y) {
    module D = EX.Reading[G, A, N, Y, X, h, PR.TyL[G, P.B N].pr X x (I1.u N), PR.TyL[G, P.B N].pr Y y (I2.u N),
      PR.TyL[G, P.B N].pr-tact Y X h x y e (I1.u N),
      lin m, EZ.HLin[m].ht, m, EZ.HLin[m].hB, EZ.HLin[m].hm, EZ.HLin[m].hi, hf m f, f, refl (hf m f)] ;
  } ;
  module PRd (m N : Nat) (f : Hom (lin m) Y) {
    PI : Ob = prodP (lin m) Iv ;
    fI : Hom PI (prodP Y Iv) = crossH (lin m) Y Iv Iv f (idH Iv) ;
    hI : Hom (prodP Y Iv) (prodP X Iv) = crossH Y X Iv Iv h (idH Iv) ;
    hfI : Hom PI (prodP X Iv) = crossH (lin m) X Iv Iv (hf m f) (idH Iv) ;
    ce : Id (Hom PI (prodP X Iv)) hfI (compH PI (prodP Y Iv) (prodP X Iv) hI fI) =
      transH (apH (\ k -> pairH X Iv PI k (compH PI Iv Iv (idH Iv) (pr2 (lin m) Iv)))
        (comp-assoc PI (lin m) Y X h f (pr1 (lin m) Iv)))
      (symH (transH (BD.cross-pair Y X Iv Iv PI h (idH Iv)
        (compH PI (lin m) Y f (pr1 (lin m) Iv)) (compH PI Iv Iv (idH Iv) (pr2 (lin m) Iv)))
        (apH (pairH X Iv PI (compH PI Y X h (compH PI (lin m) Y f (pr1 (lin m) Iv))))
          (comp-idl PI Iv (compH PI Iv Iv (idH Iv) (pr2 (lin m) Iv)))))) ;
    opaque ce ;
    module H = R1.HPm[m].H ;
    module D = EX.Reading[G, A, N, prodP Y Iv, prodP X Iv, hI, PR.TyL[G, P.B N].pr (prodP X Iv) I1.xI (I1.p N), PR.TyL[G, P.B N].pr (prodP Y Iv) I2.xI (I2.p N), RN.pn N,
      PI, H.ht, plus m (suc zero), H.hB, H.hm, H.hi, hfI, fI, ce] ;
  } ;

  hext (m : Nat) (H H' : R1.HFam m)
    (q : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) -> Id (TA.EI (lin W)) (H W g j) (H' W g j))
    : Id (R1.HFam m) H H' =
    Axioms[l+].FunExtLemmas[fe @(l+)].funext Nat (\ W -> Hom (lin W) (lin m) -> Hom (lin W) Iv -> TA.EI (lin W)) H H'
      (\ W -> Axioms[l+].FunExtLemmas[fe @(l+)].funext (Hom (lin W) (lin m)) (\ g -> Hom (lin W) Iv -> TA.EI (lin W)) (H W) (H' W)
        (\ g -> Axioms[l+].FunExtLemmas[fe @(l+)].funext (Hom (lin W) Iv) (\ j -> TA.EI (lin W)) (H W g) (H' W g) (q W g))) ;
  opaque hext ;
  text (m : Nat) (T T' : R1.TFam m)
    (q : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv) -> Id (TA.EI (lin W)) (T W g j) (T' W g j))
    : Id (R1.TFam m) T T' =
    Axioms[l+].FunExtLemmas[fe @(l+)].funext Nat (\ W -> Hom (lin W) (prodP (lin m) Iv) -> Hom (lin W) Iv -> TA.EI (lin W)) T T'
      (\ W -> Axioms[l+].FunExtLemmas[fe @(l+)].funext (Hom (lin W) (prodP (lin m) Iv)) (\ g -> Hom (lin W) Iv -> TA.EI (lin W)) (T W) (T' W)
        (\ g -> Axioms[l+].FunExtLemmas[fe @(l+)].funext (Hom (lin W) Iv) (\ j -> TA.EI (lin W)) (T W g) (T' W g) (q W g))) ;
  opaque text ;

  -- two records of data at f, over h f and f, agree
  record EqR (m : Nat) (f : Hom (lin m) Y) (r1 : R1.Rec[m, hf m f]) (r2 : R2.Rec[m, f]) {
    ps : Id (TA.EI (lin m)) r1.psi r2.psi ;
    hs : (N : Nat) -> Id (R1.HFam m) (r1.Hs N) (r2.Hs N) ;
    ts : (N : Nat) -> Id (R1.TFam m) (r1.Ts N) (r2.Ts N) ;
  } ;
  module Z (f : Hom (lin zero) Y) {
    module Z1 = R1.R0[hf zero f] ; module Z2 = R2.R0[f] ;
    module B1 = Z1.Sz.Bx ; module B2 = Z2.Sz.Bx ;
    module C0 = CBoxFill[a, l].Compare[B1.G, B1.A, B1.e, B1.fill, B1.sides, B1.face, B1.X, B1.ht, B1.B, B1.hB, B1.hm, B1.hi, B1.x, B1.a0, B1.a0p, B1.a0n, B1.Q, B1.sv, B1.svp, B1.svn, B1.sve,
      B2.x, B2.a0, B2.a0p, B2.a0n, B2.sv, B2.svp, B2.svn, B2.sve,
      apH (G.act Z1.Sz.P.BX.XB (lin zero) Z1.Sz.P.BX.p1B) (xf zero f),
      \ W g -> UR[zero, suc zero, f].D.Bounded[leb-suc zero, leb-suc zero].anat W (compH (lin W) Z1.Sz.P.BX.XB (lin zero) Z1.Sz.P.BX.p1B g),
      \ W g i i2 j -> absurd _ (false-true i)] ;
    hb : Id (R1.HFam zero) Z1.b1.Hv Z2.b1.Hv = hext zero _ _ (\ W g j -> C0.fv W (Z1.Sz.O.i0 W g) j) ;
    opaque hb ;
    ps : Id (TA.EI (lin zero)) Z1.psi Z2.psi = apH (\ H -> H zero (idH (lin zero)) (constH (lin zero) Iv e0)) hb ;
    opaque ps ;

    module Next (N : Nat) (hN : IsT (leb (suc zero) N))
      (he : Id (R1.HFam zero) (Z1.SR.trec N).Hv (Z2.SR.trec N).Hv) {
      module N1 = Z1.NX[N, hN, Z1.SR.trec N] ; module N2 = Z2.NX[N, hN, Z2.SR.trec N] ;
      module S1 = N1.S.Sq ; module S2 = N2.S.Sq ;
      module C = CPostSqNat[a, l].SqZCmp[S1.G, S1.B, S1.e, S1.fill, S1.sides, S1.face, S1.xf, S1.psi, S1.psi-pt, S1.L, S1.Lp, S1.Ln, S1.Pl, S1.Plp, S1.Pln, S1.L0, S1.L1,
        S2.xf, S2.psi, S2.psi-pt, S2.L, S2.Lp, S2.Ln, S2.Pl, S2.Plp, S2.Pln, S2.L0, S2.L1,
        xf zero f, ps, \ W g j -> apH (\ H -> H W g j) he,
        PRd[zero, N, f].D.Bounded[BD.leN zero N hN, BD.leN zero N hN].anat] ;
      eq : Id (R1.TFam zero) N1.res.Tv N2.res.Tv = text zero _ _ C.eq ;
      opaque eq ;
      eh : Id (R1.HFam zero) N1.res.H'.Hv N2.res.H'.Hv =
        hext zero _ _ (\ W g j -> C.eq W (pairH (lin zero) Iv (lin W) g j) (constH (lin W) Iv e0)) ;
      opaque eh ;
    } ;
    hs : (N : Nat) -> Id (R1.HFam zero) (Z1.rec.Hs N) (Z2.rec.Hs N) = split {
      zero -> hb ;
      suc N | ihN -> RC.bcaseL (Id (R1.HFam zero) (Z1.rec.Hs (suc N)) (Z2.rec.Hs (suc N))) (leb (suc zero) N)
        (\ hN -> transH (Z1.SR.Hs-eq N hN) (transH Next[N, hN, ihN].eh (symH (Z2.SR.Hs-eq N hN))))
        (\ nh -> transH (Z1.SR.Hs-low N nh) (transH hb (symH (Z2.SR.Hs-low N nh)))) } ;
    opaque hs ;
    ts (N : Nat) : Id (R1.TFam zero) (Z1.rec.Ts N) (Z2.rec.Ts N) =
      RC.bcaseL (Id (R1.TFam zero) (Z1.rec.Ts N) (Z2.rec.Ts N)) (leb (suc zero) N)
        (\ hN -> transH (Z1.SR.Ts-eq N hN) (transH Next[N, hN, hs N].eq (symH (Z2.SR.Ts-eq N hN))))
        (\ nh -> transH (RC.bcase-f (R1.TFam zero) (leb (suc zero) N) (\ hN -> (Z1.SR.tr N hN).Tv) (\ nh1 -> Z1.SR.junkT N) nh)
          (transH (text zero _ _ (\ W g j -> apH (\ H -> H W (R1.p1g zero W g) (R1.p2g zero W g)) (hs N)))
            (symH (RC.bcase-f (R1.TFam zero) (leb (suc zero) N) (\ hN -> (Z2.SR.tr N hN).Tv) (\ nh1 -> Z2.SR.junkT N) nh)))) ;
    opaque ts ;
    res : EqR[zero, f, Z1.rec, Z2.rec] = new EqR[zero, f, Z1.rec, Z2.rec, ps, hs, ts] ;
  } ;

  module Step (m : Nat) (ih : (f : Hom (lin m) Y) -> EqR[m, f, (R1.Drec m).R (hf m f), (R2.Drec m).R f]) (f : Hom (lin (suc m)) Y) {
    module Z1 = R1.ST[m, (R1.Drec m).R, (R1.Drec m).FFH, (R1.Drec m).FFT, hf (suc m) f] ;
    module Z2 = R2.ST[m, (R2.Drec m).R, (R2.Drec m).FFH, (R2.Drec m).FFT, f] ;
    module First1 = Z1.S1i ; module First2 = Z2.S1i ;
    module B1 = First1.Bx ; module B2 = First2.Bx ;
    fd (k : Nat) : Hom (lin m) Y = compH (lin m) (lin (suc m)) Y f (dl m k) ;
    fh (N k : Nat) (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (((R1.Drec m).R (Z1.Fd k)).Hs N W g j) (((R2.Drec m).R (Z2.Fd k)).Hs N W g j) =
      transH (apH (\ q -> ((R1.Drec m).R q).Hs N W g j) (comp-assoc (lin m) (lin (suc m)) Y X h f (dl m k)))
        (apH (\ H -> H W g j) ((ih (fd k)).hs N)) ;
    opaque fh ;
    ft (N k : Nat) (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (((R1.Drec m).R (Z1.Fd k)).Ts N W g j) (((R2.Drec m).R (Z2.Fd k)).Ts N W g j) =
      transH (apH (\ q -> ((R1.Drec m).R q).Ts N W g j) (comp-assoc (lin m) (lin (suc m)) Y X h f (dl m k)))
        (apH (\ T -> T W g j) ((ih (fd k)).ts N)) ;
    opaque ft ;
    module SE = EX.SideEq[G, A, m, lin zero, CPosBase[a].SP.emptyS (lin zero), First1.BSm.sv, First2.BSm.sv,
      \ k hk W g i i2 ms j -> transH (First1.BSm.sv-F k hk W g i ms j)
        (transH (fh (suc (suc m)) k W (compH (lin W) First1.BG.Xf (lin m) (pr1 (lin m) (lin zero)) (First1.BG.gy k W g)) j)
          (symH (First2.BSm.sv-F k hk W g i2 ms j))),
      \ W g i i2 b j -> absurd _ (false-true b)] ;
    -- the shared data of the two boxes, written out (not read from one of them)
    module C0 = CBoxFill[a, l].Compare[B1.G, B1.A, B1.e, B1.fill, B1.sides, B1.face, prodP (lin (suc m)) (lin zero), B1.ht, B1.B, B1.hB, B1.hm, B1.hi, B1.x, B1.a0, B1.a0p, B1.a0n,
      BD.BG[m, lin zero].bdS (CPosBase[a].SP.emptyS (lin zero)), B1.sv, B1.svp, B1.svn, B1.sve,
      B2.x, B2.a0, B2.a0p, B2.a0n, B2.sv, B2.svp, B2.svn, B2.sve,
      apH (G.act First1.P.BX.XB (lin (suc m)) First1.P.BX.p1B) (xf (suc m) f),
      \ W g -> UR[suc m, suc (suc m), f].D.Bounded[First1.P.DU.hBN, First2.P.DU.hBN].anat W (compH (lin W) First1.P.BX.XB (lin (suc m)) First1.P.BX.p1B g), SE.eq] ;
    -- the two problems are read at the same points
    ip (W : Nat) (g : Hom (lin W) (lin (suc m))) : Hom (lin W) (prodP (lin (suc m)) (lin zero)) =
      pairH (lin (suc m)) (lin zero) (lin W) g (constH (lin W) (lin zero) CPostStep1[a, l].z0) ;
    t1 (W : Nat) (g : Hom (lin W) (lin (suc m))) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (Z1.b1.Hv W g j) (B1.Fv W (ip W g) j) = refl (B1.Fv W (ip W g) j) ;
    t3 (W : Nat) (g : Hom (lin W) (lin (suc m))) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (B2.Fv W (ip W g) j) (Z2.b1.Hv W g j) = refl (B2.Fv W (ip W g) j) ;
    hb : Id (R1.HFam (suc m)) Z1.b1.Hv Z2.b1.Hv =
      hext (suc m) Z1.b1.Hv Z2.b1.Hv (\ W g j -> transH (t1 W g j) (transH (C0.fv W (ip W g) j) (t3 W g j))) ;
    opaque hb ;
    ps : Id (TA.EI (lin (suc m))) Z1.psi Z2.psi = apH (\ H -> H (suc m) (idH (lin (suc m))) (constH (lin (suc m)) Iv e0)) hb ;
    opaque ps ;
    module Next (N : Nat) (hN : IsT (leb (suc (suc m)) N))
      (he : Id (R1.HFam (suc m)) (Z1.SR.trec N).Hv (Z2.SR.trec N).Hv) {
      module N1 = Z1.NX[N, hN, Z1.SR.trec N] ; module N2 = Z2.NX[N, hN, Z2.SR.trec N] ;
      module S1 = N1.S.Sq ; module S2 = N2.S.Sq ;
      module C = CPostSqNat[a, l].SqSCmp[S1.G, S1.B, S1.e, S1.fill, S1.sides, S1.face, m, S1.xf, S1.psi, S1.psi-pt, S1.L, S1.Lp, S1.Ln, S1.Pl, S1.Plp, S1.Pln, S1.L0, S1.L1, S1.Th, S1.Thp, S1.Thn, S1.Th-e, S1.Th-t0, S1.Th-t1, S1.FFt,
        S2.xf, S2.psi, S2.psi-pt, S2.L, S2.Lp, S2.Ln, S2.Pl, S2.Plp, S2.Pln, S2.L0, S2.L1, S2.Th, S2.Thp, S2.Thn, S2.Th-e, S2.Th-t0, S2.Th-t1, S2.FFt,
        xf (suc m) f, ps, \ W g j -> apH (\ H -> H W g j) he,
        PRd[(suc m), N, f].D.Bounded[BD.leN (suc m) N hN, BD.leN (suc m) N hN].anat, \ k hk W g j -> ft N k W g j] ;
      eq : Id (R1.TFam (suc m)) N1.res.Tv N2.res.Tv = text (suc m) _ _ C.eq ;
      opaque eq ;
      eh : Id (R1.HFam (suc m)) N1.res.H'.Hv N2.res.H'.Hv =
        hext (suc m) _ _ (\ W g j -> C.eq W (pairH (lin (suc m)) Iv (lin W) g j) (constH (lin W) Iv e0)) ;
      opaque eh ;
    } ;
    hs : (N : Nat) -> Id (R1.HFam (suc m)) (Z1.rec.Hs N) (Z2.rec.Hs N) = split {
      zero -> hb ;
      suc N | ihN -> RC.bcaseL (Id (R1.HFam (suc m)) (Z1.rec.Hs (suc N)) (Z2.rec.Hs (suc N))) (leb (suc (suc m)) N)
        (\ hN -> transH (Z1.SR.Hs-eq N hN) (transH Next[N, hN, ihN].eh (symH (Z2.SR.Hs-eq N hN))))
        (\ nh -> transH (Z1.SR.Hs-low N nh) (transH hb (symH (Z2.SR.Hs-low N nh)))) } ;
    opaque hs ;
    ts (N : Nat) : Id (R1.TFam (suc m)) (Z1.rec.Ts N) (Z2.rec.Ts N) =
      RC.bcaseL (Id (R1.TFam (suc m)) (Z1.rec.Ts N) (Z2.rec.Ts N)) (leb (suc (suc m)) N)
        (\ hN -> transH (Z1.SR.Ts-eq N hN) (transH Next[N, hN, hs N].eq (symH (Z2.SR.Ts-eq N hN))))
        (\ nh -> transH (RC.bcase-f (R1.TFam (suc m)) (leb (suc (suc m)) N) (\ hN -> (Z1.SR.tr N hN).Tv) (\ nh1 -> Z1.SR.junkT N) nh)
          (transH (text (suc m) _ _ (\ W g j -> apH (\ H -> H W (R1.p1g (suc m) W g) (R1.p2g (suc m) W g)) (hs N)))
            (symH (RC.bcase-f (R1.TFam (suc m)) (leb (suc (suc m)) N) (\ hN -> (Z2.SR.tr N hN).Tv) (\ nh1 -> Z2.SR.junkT N) nh)))) ;
    opaque ts ;
    res : EqR[suc m, f, Z1.rec, Z2.rec] = new EqR[suc m, f, Z1.rec, Z2.rec, ps, hs, ts] ;
  } ;

  -- the two recursions, read through Drec zero = D0 and Drec (suc m) = Dstep m (Drec m)
  zeroEq (f : Hom (lin zero) Y) (r : EqR[zero, f, (R1.D0).R (hf zero f), (R2.D0).R f])
    : EqR[zero, f, (R1.Drec zero).R (hf zero f), (R2.Drec zero).R f] =
    substH {R1.Dm[zero]} (\ d -> EqR[zero, f, d.R (hf zero f), (R2.Drec zero).R f]) (symH R1.drec0)
      (substH {R2.Dm[zero]} (\ d -> EqR[zero, f, (R1.D0).R (hf zero f), d.R f]) (symH R2.drec0) r) ;
  stepEq (m : Nat) (f : Hom (lin (suc m)) Y)
    (r : EqR[suc m, f, (R1.Dstep m (R1.Drec m)).R (hf (suc m) f), (R2.Dstep m (R2.Drec m)).R f])
    : EqR[suc m, f, (R1.Drec (suc m)).R (hf (suc m) f), (R2.Drec (suc m)).R f] =
    substH {R1.Dm[suc m]} (\ d -> EqR[suc m, f, d.R (hf (suc m) f), (R2.Drec (suc m)).R f]) (symH (R1.drecD m))
      (substH {R2.Dm[suc m]} (\ d -> EqR[suc m, f, (R1.Dstep m (R1.Drec m)).R (hf (suc m) f), d.R f]) (symH (R2.drecD m)) r) ;
  opaque zeroEq ; opaque stepEq ;

  recNat : (m : Nat) (f : Hom (lin m) Y) -> EqR[m, f, (R1.Drec m).R (hf m f), (R2.Drec m).R f] = split {
    zero -> \ f -> zeroEq f Z[f].res ;
    suc m | ih -> \ f -> stepEq m f Step[m, ih, f].res } ;

  psi-nat : Id (P.DA.DEl Y y) (P.DA.DA.tact Y X h x y e R1.psi) R2.psi =
    P.DA.Dext Y y _ _ (\ n f -> transH (P.DA.rd-dtact Y X h x y e R1.psi n f)
      (transH (R1.rdE n (hf n f)) (transH (recNat n f).ps (symH (R2.rdE n f))))) ;
  opaque psi-nat ;
} ;

module Inverse (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  module P = LM.Post[G, A] ;
  val (X : Ob) (x : W.Ix (G.ob X)) (z : W.Ix (P.L.tob X x)) : P.DA.DEl X x =
    CPostInput[a, l].Input[G, A, X, x, z].Construction[c].psi ;
  psi : PB.CHtpyOps[l].NMap[G, P.L, P.DA.DA] =
    new PB.CHtpyOps[l].NMap[G, P.L, P.DA.DA, val, \ Y X h x y e z -> Nat[G, A, c, Y, X, h, x, y, e, z].psi-nat] ;
} ;
