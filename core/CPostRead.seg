-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostRead.seg (L9): readings of a full element u of DA (POSTNIKOV-INFORMAL.md,
-- "Boundary data supplied by a full element of DA").
--
-- u is natural only along the strict maps, so its reading along a map
-- phi : P -> X (on a strict chain c the value u(phi c), extended by
-- Eilenberg-Zilber) need not commute with projections.  We read u
-- through the stages: Rd = CPostMap.DR of v_N u, with N >= the height
-- bound.
--
--   zcU           the reading at a chain is u at that chain
--   RdZ           two readings over the same P along equal maps agree
--   RdI           reading along phi iota is reading along phi at iota g
--   RdS           on [n] along f the reading is the simplex u_n(f)
--   beta          [1] * [1] -> [2]: (s , 0) |-> s, (1 , v) |-> 1 + v,
--                 (0 , v) |-> 2 v, (s , 1) |-> 2
--   Sq m f        R (on [m] * [1]), R2 (on [m] * [2]) and the square
--                 Q = R2 . (id * beta), with its edges Q-v0, Q-s1, Q-s0
--                 (R) and Q-v1 (the simplex U_f); the ends of R (U_f)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;
module LM = CPostLimit[a, l] ;

------------------------------------------------------------------------
-- beta : [1] * [1] -> [2]

two : Nat = suc (suc zero) ;

bn (i : Nat) : Nat -> Nat = split { zero -> i ; suc j -> two } ;

bn-range (i : Nat) (h : IsT (leb i (suc zero))) : (j : Nat) -> IsT (leb (bn i j) two) = split {
  zero -> leb-trans i (suc zero) two h (leb-suc (suc zero)) ;
  suc j -> refl true } ;

bn-mono (i i' : Nat) (hi : IsT (leb i i')) (hi' : IsT (leb i' (suc zero)))
  : (j j' : Nat) -> IsT (leb j j') -> IsT (leb (bn i j) (bn i' j')) = split {
  zero -> split {
    zero -> \ h -> hi ;
    suc j' -> \ h -> leb-trans i (suc zero) two (leb-trans i i' (suc zero) hi hi') (leb-suc (suc zero)) } ;
  suc j -> split {
    zero -> \ h -> absurd _ (false-true h) ;
    suc j' -> \ h -> refl true } } ;

IvIv : Ob = prodP Iv Iv ;

module HI = EZ.HLin[suc zero] ;

bfun (w : El IvIv) : El (lin two) =
  (leaf (bn (HI.ht (p1 Iv Iv w)) (HI.ht (p2 Iv Iv w))),
   bn-range (HI.ht (p1 Iv Iv w)) (HI.hB (p1 Iv Iv w)) (HI.ht (p2 Iv Iv w))) ;

betaH : Hom IvIv (lin two) =
  mkHom IvIv (lin two) bfun (\ w w' l ->
    bn-mono (HI.ht (p1 Iv Iv w)) (HI.ht (p1 Iv Iv w')) (HI.hm (p1 Iv Iv w) (p1 Iv Iv w') (m1' Iv Iv w.1 w.2 w'.1 w'.2 l))
      (HI.hB (p1 Iv Iv w'))
      (HI.ht (p2 Iv Iv w)) (HI.ht (p2 Iv Iv w')) (HI.hm (p2 Iv Iv w) (p2 Iv Iv w') (m2' Iv Iv w.1 w.2 w'.1 w'.2 l))) ;

-- a map k on {0 , 1} agreeing with skip y is dl 1 y on trees
dlvS (y : Nat) (k : Nat -> Nat) (hk1 : Id Nat (k (suc zero)) (skip y (suc zero)))
  : (i : Nat) -> IsT (leb (suc i) (suc zero)) -> Id Tree (leaf (k (suc i))) (leaf (skip y (suc i))) = split {
  zero -> \ h -> apH (\ n -> leaf n) hk1 ;
  suc i' -> \ h -> absurd _ (false-true h) } ;

dlvN (y : Nat) (k : Nat -> Nat) (hk0 : Id Nat (k zero) (skip y zero)) (hk1 : Id Nat (k (suc zero)) (skip y (suc zero)))
  : (i : Nat) -> IsT (leb i (suc zero)) -> Id Tree (leaf (k i)) (leaf (skip y i)) = split {
  zero -> \ h -> apH (\ n -> leaf n) hk0 ;
  suc i -> dlvS y k hk1 i } ;

dlv (y : Nat) (k : Nat -> Nat) (hk0 : Id Nat (k zero) (skip y zero)) (hk1 : Id Nat (k (suc zero)) (skip y (suc zero)))
  : (t : Tree) (h : IsT (car Iv t)) -> Id Tree (leaf (k (vnum t))) (app Iv (lin two) (dl (suc zero) y) (t, h)).1 = split {
  leaf i -> \ h -> dlvN y k hk0 hk1 i h ;
  node s t -> \ h -> absurd _ (false-true h) } ;

module BetaEdges (Z : Ob) {
  pr (s v : Hom Z Iv) : Hom Z IvIv = pairH Iv Iv Z s v ;

  v0 (s : Hom Z Iv) : Id (Hom Z (lin two)) (compH Z IvIv (lin two) betaH (pr s (constH Z Iv e0))) (compH Z Iv (lin two) (dl (suc zero) two) s) =
    hom-eq Z (lin two) _ _ (\ z ->
      transH (app-compH1 Z IvIv (lin two) betaH (pr s (constH Z Iv e0)) z)
        (transH (dlv two (\ i -> bn i zero) (refl zero) (refl (suc zero)) (app Z Iv s z).1 (app Z Iv s z).2)
                (symH (app-compH1 Z Iv (lin two) (dl (suc zero) two) s z)))) ;

  s1 (v : Hom Z Iv) : Id (Hom Z (lin two)) (compH Z IvIv (lin two) betaH (pr (constH Z Iv e1) v)) (compH Z Iv (lin two) (dl (suc zero) zero) v) =
    hom-eq Z (lin two) _ _ (\ z ->
      transH (app-compH1 Z IvIv (lin two) betaH (pr (constH Z Iv e1) v) z)
        (transH (dlv zero (\ j -> bn (suc zero) j) (refl (suc zero)) (refl two) (app Z Iv v z).1 (app Z Iv v z).2)
                (symH (app-compH1 Z Iv (lin two) (dl (suc zero) zero) v z)))) ;

  s0 (v : Hom Z Iv) : Id (Hom Z (lin two)) (compH Z IvIv (lin two) betaH (pr (constH Z Iv e0) v)) (compH Z Iv (lin two) (dl (suc zero) (suc zero)) v) =
    hom-eq Z (lin two) _ _ (\ z ->
      transH (app-compH1 Z IvIv (lin two) betaH (pr (constH Z Iv e0) v) z)
        (transH (dlv (suc zero) (\ j -> bn zero j) (refl zero) (refl two) (app Z Iv v z).1 (app Z Iv v z).2)
                (symH (app-compH1 Z Iv (lin two) (dl (suc zero) (suc zero)) v z)))) ;

  v1 (s : Hom Z Iv) : Id (Hom Z (lin two)) (compH Z IvIv (lin two) betaH (pr s (constH Z Iv e1))) (constH Z (lin two) (leaf two, refl true)) =
    hom-eq Z (lin two) (compH Z IvIv (lin two) betaH (pr s (constH Z Iv e1))) (constH Z (lin two) (leaf two, refl true))
      (\ z -> app-compH1 Z IvIv (lin two) betaH (pr s (constH Z Iv e1)) z) ;
} ;

leb-plus : (m k : Nat) -> IsT (leb m (plus m k)) = split {
  zero -> \ k -> refl true ;
  suc m | ih -> ih } ;

------------------------------------------------------------------------
-- strict maps used below

-- id * d : P * [n] -> P * [n'] for a strict d
crossid-strict (P : Ob) (n n' : Nat) (d : Hom (lin n) (lin n')) (st : Strict (lin n) (lin n') d)
  : Strict (prodP P (lin n)) (prodP P (lin n')) (crossH P P (lin n) (lin n') (idH P) d) =
  BD.strict-of-inj (prodP P (lin n)) (prodP P (lin n')) (crossH P P (lin n) (lin n') (idH P) d) (\ s t e ->
    transH (symH (prod-eta P (lin n) s))
      (transH (node-eq (p1 P (lin n) s).1 (p2 P (lin n) s).1 (p1 P (lin n) t).1 (p2 P (lin n) t).1
                 (transH (symH (app-idH1 P (app (prodP P (lin n)) P (pr1 P (lin n)) s)))
                   (transH (symH (app-compH1 (prodP P (lin n)) P P (idH P) (pr1 P (lin n)) s))
                     (transH (BD.pair-inj-l P (lin n') (prodP P (lin n)) (compH (prodP P (lin n)) P P (idH P) (pr1 P (lin n))) (compH (prodP P (lin n)) (lin n) (lin n') d (pr2 P (lin n))) s t e)
                       (transH (app-compH1 (prodP P (lin n)) P P (idH P) (pr1 P (lin n)) t)
                               (app-idH1 P (app (prodP P (lin n)) P (pr1 P (lin n)) t))))))
                 (BD.lin-inj n (lin n') d st (p2 P (lin n) s) (p2 P (lin n) t)
                    (transH (symH (app-compH1 (prodP P (lin n)) (lin n) (lin n') d (pr2 P (lin n)) s))
                      (transH (BD.pair-inj-r P (lin n') (prodP P (lin n)) (compH (prodP P (lin n)) P P (idH P) (pr1 P (lin n))) (compH (prodP P (lin n)) (lin n) (lin n') d (pr2 P (lin n))) s t e) (app-compH1 (prodP P (lin n)) (lin n) (lin n') d (pr2 P (lin n)) t)))))
              (prod-eta P (lin n) t))) ;

-- < id , const c > : P -> P * Y
pairc-strict (P Y : Ob) (c : El Y) : Strict P (prodP P Y) (pairH P Y P (idH P) (constH P Y c)) =
  BD.strict-of-inj P (prodP P Y) (pairH P Y P (idH P) (constH P Y c)) (\ s t q ->
    transH (symH (app-idH1 P s)) (transH (BD.pair-inj-l P Y P (idH P) (constH P Y c) s t q) (app-idH1 P t))) ;

-- d * id : [n] * Y -> [n'] * Y for a strict d
crossd-strict (n n' : Nat) (Y : Ob) (d : Hom (lin n) (lin n')) (st : Strict (lin n) (lin n') d)
  : Strict (prodP (lin n) Y) (prodP (lin n') Y) (crossH (lin n) (lin n') Y Y d (idH Y)) =
  BD.strict-of-inj (prodP (lin n) Y) (prodP (lin n') Y) (crossH (lin n) (lin n') Y Y d (idH Y)) (\ s t e ->
    transH (symH (prod-eta (lin n) Y s))
      (transH (node-eq (p1 (lin n) Y s).1 (p2 (lin n) Y s).1 (p1 (lin n) Y t).1 (p2 (lin n) Y t).1
                 (BD.lin-inj n (lin n') d st (p1 (lin n) Y s) (p1 (lin n) Y t)
                    (transH (symH (app-compH1 (prodP (lin n) Y) (lin n) (lin n') d (pr1 (lin n) Y) s))
                      (transH (BD.pair-inj-l (lin n') Y (prodP (lin n) Y) (compH (prodP (lin n) Y) (lin n) (lin n') d (pr1 (lin n) Y)) (compH (prodP (lin n) Y) Y Y (idH Y) (pr2 (lin n) Y)) s t e) (app-compH1 (prodP (lin n) Y) (lin n) (lin n') d (pr1 (lin n) Y) t))))
                 (transH (symH (app-idH1 Y (app (prodP (lin n) Y) Y (pr2 (lin n) Y) s)))
                   (transH (symH (app-compH1 (prodP (lin n) Y) Y Y (idH Y) (pr2 (lin n) Y) s))
                     (transH (BD.pair-inj-r (lin n') Y (prodP (lin n) Y) (compH (prodP (lin n) Y) (lin n) (lin n') d (pr1 (lin n) Y)) (compH (prodP (lin n) Y) Y Y (idH Y) (pr2 (lin n) Y)) s t e)
                       (transH (app-compH1 (prodP (lin n) Y) Y Y (idH Y) (pr2 (lin n) Y) t)
                               (app-idH1 Y (app (prodP (lin n) Y) Y (pr2 (lin n) Y) t)))))))
              (prod-eta (lin n) Y t))) ;

------------------------------------------------------------------------
-- reading a full element u of DA

module RU (G : PP.PCtx) (A : PP.PTy[G]) (X : Ob) (x : W0.Ix (G.ob X)) (u : LD.DT[G, A].DEl X x) {
  module P = LM.Post[G, A] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module DA = LD.DT[G, A] ;

  w (N : Nat) : LD.DT[G, CK.KT[G, A, N].KA].DEl X x = (P.v N).nfun X x u ;

  -- the simplex of u at f
  Uf (n : Nat) (f : Hom (lin n) X) : TA.EI (lin n) = DA.rd X x u.1 n f ;

  module Rd (Q : Ob) (ht : El Q -> Nat) (B : Nat) (hB : (q : El Q) -> IsT (leb (ht q) B))
    (hm : (q q' : El Q) -> IsT (le Q q.1 q'.1) -> IsT (leb (ht q) (ht q')))
    (hi : (q q' : El Q) -> IsT (le Q q.1 q'.1) -> Id Nat (ht q) (ht q') -> Id Tree q.1 q'.1)
    (N : Nat) (hBN : IsT (leb B N)) (phi : Hom Q X) {
    module D = PM.DR[G, A, N, X, x, w N, Q, ht, B, hB, hm, hi, hBN, phi] ;

    zcU (r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) X) : Id (TA.EI (lin r)) (D.zc r hr q) (Uf r q) =
      TA.E.act-id (lin r) (Uf r q) ;
  } ;

  -- two readings over the same Q along equal maps agree
  module RdZ (Q : Ob) (ht : El Q -> Nat) (B : Nat) (hB : (q : El Q) -> IsT (leb (ht q) B))
    (hm : (q q' : El Q) -> IsT (le Q q.1 q'.1) -> IsT (leb (ht q) (ht q')))
    (hi : (q q' : El Q) -> IsT (le Q q.1 q'.1) -> Id Nat (ht q) (ht q') -> Id Tree q.1 q'.1)
    (N N' : Nat) (hBN : IsT (leb B N)) (hBN' : IsT (leb B N')) (phi phi' : Hom Q X) (ep : Id (Hom Q X) phi phi')
    (W : Nat) (g : Hom (lin W) Q) {
    module R1 = Rd[Q, ht, B, hB, hm, hi, N, hBN, phi] ;
    module R2 = Rd[Q, ht, B, hB, hm, hi, N', hBN', phi'] ;
    res : Id (TA.EI (lin W)) (R1.D.val W g) (R2.D.val W g) =
      PM.DRZ[G, A, N, N', X, x, w N, X, x, w N', Q, ht, B, hB, hm, hi, hBN, hBN', phi, phi',
        \ r hr hr' c -> transH (R1.zcU r hr (compH (lin r) Q X phi c))
          (transH (apH (\ k -> Uf r (compH (lin r) Q X k c)) ep) (symH (R2.zcU r hr' (compH (lin r) Q X phi' c)))), W, g].res ;
  } ;

  -- along a strict iota
  module RdI (Q' : Ob) (ht' : El Q' -> Nat) (B' : Nat) (hB' : (q : El Q') -> IsT (leb (ht' q) B'))
    (hm' : (q q' : El Q') -> IsT (le Q' q.1 q'.1) -> IsT (leb (ht' q) (ht' q')))
    (hi' : (q q' : El Q') -> IsT (le Q' q.1 q'.1) -> Id Nat (ht' q) (ht' q') -> Id Tree q.1 q'.1)
    (Q : Ob) (ht : El Q -> Nat) (B : Nat) (hB : (q : El Q) -> IsT (leb (ht q) B))
    (hm : (q q' : El Q) -> IsT (le Q q.1 q'.1) -> IsT (leb (ht q) (ht q')))
    (hi : (q q' : El Q) -> IsT (le Q q.1 q'.1) -> Id Nat (ht q) (ht q') -> Id Tree q.1 q'.1)
    (N : Nat) (hBN' : IsT (leb B' N)) (hBN : IsT (leb B N)) (phi : Hom Q X) (iota : Hom Q' Q) (ist : Strict Q' Q iota)
    (W : Nat) (g : Hom (lin W) Q') {
    res : Id (TA.EI (lin W)) (Rd[Q', ht', B', hB', hm', hi', N, hBN', compH Q' Q X phi iota].D.val W g)
                             (Rd[Q, ht, B, hB, hm, hi, N, hBN, phi].D.val W (compH (lin W) Q' Q iota g)) =
      PM.DRI[G, A, N, X, x, w N, Q', ht', B', hB', hm', hi', hBN', Q, ht, B, hB, hm, hi, hBN, phi, iota, ist, W, g].res ;
  } ;

  -- on [n] along f, the reading is the simplex U_f
  module RdS (n N : Nat) (hBN : IsT (leb n N)) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) {
    module R = Rd[lin n, EZ.HLin[n].ht, n, EZ.HLin[n].hB, EZ.HLin[n].hm, EZ.HLin[n].hi, N, hBN, f] ;
    module Z = EZ.EZX[lin n, EZ.HLin[n].ht, n, EZ.HLin[n].hB, EZ.HLin[n].hm, EZ.HLin[n].hi, W, g] ;
    rN : IsT (leb Z.r N) = leb-trans Z.r n N Z.rle hBN ;
    res : Id (TA.EI (lin W)) (R.D.val W g) (TA.E.act (lin W) (lin n) g (Uf n f)) =
      calc (TA.EI (lin W)) {
          TA.E.act (lin W) (lin Z.r) Z.sgm (R.D.zc Z.r rN (compH (lin Z.r) (lin n) X f Z.c))
        =< apH (TA.E.act (lin W) (lin Z.r) Z.sgm) (R.zcU Z.r rN (compH (lin Z.r) (lin n) X f Z.c)) >
          TA.E.act (lin W) (lin Z.r) Z.sgm (Uf Z.r (compH (lin Z.r) (lin n) X f Z.c))
        =< apH (TA.E.act (lin W) (lin Z.r) Z.sgm) (symH (u.2 Z.r n Z.c Z.cstrict f)) >
          TA.E.act (lin W) (lin Z.r) Z.sgm (TA.E.act (lin Z.r) (lin n) Z.c (Uf n f))
        =< TA.PE.actC (lin W) (lin Z.r) (lin n) Z.c Z.sgm (Uf n f) >
          TA.E.act (lin W) (lin n) (compH (lin W) (lin Z.r) (lin n) Z.c Z.sgm) (Uf n f)
        =< TA.PE.actEq (lin W) (lin n) _ _ Z.fac (Uf n f) >
          TA.E.act (lin W) (lin n) g (Uf n f) } ;
  } ;
  ----------------------------------------------------------------------
  -- the prism R, the reading R2 on [m] * [2], and the square Q at f

  module Sq (m : Nat) (f : Hom (lin m) X) {
    module GL = PB.GPre[l].PshL[G] ;
    xf : W0.Ix (G.ob (lin m)) = G.act (lin m) X f x ;
    Uf0 : TA.EI (lin m) = Uf m f ;
    module HM = EZ.HLin[m] ;
    module H1 = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi] ;
    module H2 = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, lin two, EZ.HLin[two].ht, two, EZ.HLin[two].hB, EZ.HLin[two].hm, EZ.HLin[two].hi] ;
    P1 : Ob = prodP (lin m) Iv ;
    P2 : Ob = prodP (lin m) (lin two) ;
    N1 : Nat = plus m (suc zero) ;
    N2 : Nat = plus m two ;
    phi1 : Hom P1 X = compH P1 (lin m) X f (pr1 (lin m) Iv) ;
    phi2 : Hom P2 X = compH P2 (lin m) X f (pr1 (lin m) (lin two)) ;
    module R = Rd[P1, H1.ht, H1.B, H1.hB, H1.hm, H1.hi, N1, leb-refl N1, phi1] ;
    module R2 = Rd[P2, H2.ht, H2.B, H2.hB, H2.hm, H2.hi, N2, leb-refl N2, phi2] ;

    h12 : IsT (leb N1 N2) = EZ.plus-mono2 m m (suc zero) two (leb-refl m) (refl true) ;
    hm2 : IsT (leb m N2) = leb-plus m two ;
    hm1 : IsT (leb m N1) = leb-plus m (suc zero) ;

    -- the strict inclusions [m] * [1] -> [m] * [2]
    io (y : Nat) : Hom P1 P2 = crossH (lin m) (lin m) Iv (lin two) (idH (lin m)) (dl (suc zero) y) ;
    io-st (y : Nat) : Strict P1 P2 (io y) = crossid-strict (lin m) (suc zero) two (dl (suc zero) y) (dl-strict (suc zero) y) ;

    pr1-cross (Y Y' : Ob) (d : Hom Y Y') : Id (Hom (prodP (lin m) Y) (lin m))
      (compH (prodP (lin m) Y) (prodP (lin m) Y') (lin m) (pr1 (lin m) Y') (crossH (lin m) (lin m) Y Y' (idH (lin m)) d)) (pr1 (lin m) Y) =
      transH (pr1-pair (lin m) Y' (prodP (lin m) Y) (compH (prodP (lin m) Y) (lin m) (lin m) (idH (lin m)) (pr1 (lin m) Y))
                (compH (prodP (lin m) Y) Y Y' d (pr2 (lin m) Y)))
             (comp-idl (prodP (lin m) Y) (lin m) (pr1 (lin m) Y)) ;

    phi-io (y : Nat) : Id (Hom P1 X) (compH P1 P2 X phi2 (io y)) phi1 =
      transH (comp-assoc P1 P2 (lin m) X f (pr1 (lin m) (lin two)) (io y))
             (apH (compH P1 (lin m) X f) (pr1-cross Iv (lin two) (dl (suc zero) y))) ;

    -- R2 on the edge y is R
    R2io (y W : Nat) (g : Hom (lin W) P1) : Id (TA.EI (lin W)) (R2.D.val W (compH (lin W) P1 P2 (io y) g)) (R.D.val W g) =
      transH (symH (RdI[P1, H1.ht, H1.B, H1.hB, H1.hm, H1.hi, P2, H2.ht, H2.B, H2.hB, H2.hm, H2.hi, N2, h12, leb-refl N2,
                        phi2, io y, io-st y, W, g].res))
             (RdZ[P1, H1.ht, H1.B, H1.hB, H1.hm, H1.hi, N2, N1, h12, leb-refl N1, compH P1 P2 X phi2 (io y), phi1, phi-io y, W, g].res) ;

    pair-io (y W : Nat) (a : Hom (lin W) (lin m)) (s : Hom (lin W) Iv)
      : Id (Hom (lin W) P2) (pairH (lin m) (lin two) (lin W) a (compH (lin W) Iv (lin two) (dl (suc zero) y) s))
                            (compH (lin W) P1 P2 (io y) (pairH (lin m) Iv (lin W) a s)) =
      symH (transH (BD.cross-pair (lin m) (lin m) Iv (lin two) (lin W) (idH (lin m)) (dl (suc zero) y) a s)
                   (apH (\ k -> pairH (lin m) (lin two) (lin W) k (compH (lin W) Iv (lin two) (dl (suc zero) y) s)) (comp-idl (lin W) (lin m) a))) ;

    -- a map [m] -> [m] * Y' at a constant point
    module Pt (Y' : Ob) (c : El Y') {
      lam : Hom (lin m) (prodP (lin m) Y') = pairH (lin m) Y' (lin m) (idH (lin m)) (constH (lin m) Y' c) ;
      lam-a (W : Nat) (a : Hom (lin W) (lin m))
        : Id (Hom (lin W) (prodP (lin m) Y')) (pairH (lin m) Y' (lin W) a (constH (lin W) Y' c)) (compH (lin W) (lin m) (prodP (lin m) Y') lam a) =
        symH (transH (BD.pair-h (lin m) Y' (lin W) (lin m) (idH (lin m)) (constH (lin m) Y' c) a)
               (transH (apH (\ k -> pairH (lin m) Y' (lin W) k (compH (lin W) (lin m) Y' (constH (lin m) Y' c) a)) (comp-idl (lin W) (lin m) a))
                       (apH (pairH (lin m) Y' (lin W) a)
                          (hom-eq (lin W) Y' (compH (lin W) (lin m) Y' (constH (lin m) Y' c) a) (constH (lin W) Y' c)
                             (\ z -> app-compH1 (lin W) (lin m) Y' (constH (lin m) Y' c) a z))))) ;
      pr1-lam : Id (Hom (lin m) (lin m)) (compH (lin m) (prodP (lin m) Y') (lin m) (pr1 (lin m) Y') lam) (idH (lin m)) =
        pr1-pair (lin m) Y' (lin m) (idH (lin m)) (constH (lin m) Y' c) ;
      phi-lam (phi : Hom (prodP (lin m) Y') X) (ep : Id (Hom (prodP (lin m) Y') X) phi (compH (prodP (lin m) Y') (lin m) X f (pr1 (lin m) Y')))
        : Id (Hom (lin m) X) (compH (lin m) (prodP (lin m) Y') X phi lam) f =
        transH (apH (\ k -> compH (lin m) (prodP (lin m) Y') X k lam) ep)
          (transH (comp-assoc (lin m) (prodP (lin m) Y') (lin m) X f (pr1 (lin m) Y') lam)
            (transH (apH (compH (lin m) (lin m) X f) pr1-lam) (comp-idr (lin m) X f))) ;
    } ;

    module P1e (e : El Iv) { module L = Pt[Iv, e] ; } ;
    module P2t { module L = Pt[lin two, (leaf two, refl true)] ; } ;

    -- the ends of R are the simplex U_f
    Rend (e : El Iv) (W : Nat) (a : Hom (lin W) (lin m))
      : Id (TA.EI (lin W)) (R.D.val W (pairH (lin m) Iv (lin W) a (constH (lin W) Iv e))) (TA.E.act (lin W) (lin m) a Uf0) =
      transH (apH (R.D.val W) (P1e[e].L.lam-a W a))
        (transH (symH (RdI[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, P1, H1.ht, H1.B, H1.hB, H1.hm, H1.hi, N1, hm1, leb-refl N1,
                            phi1, P1e[e].L.lam, pairc-strict (lin m) Iv e, W, a].res))
          (transH (RdZ[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, N1, N1, hm1, hm1, compH (lin m) P1 X phi1 P1e[e].L.lam, f,
                       P1e[e].L.phi-lam phi1 (refl phi1), W, a].res)
                  (RdS[m, N1, hm1, f, W, a].res))) ;

    -- the square
    bp (W : Nat) (s v : Hom (lin W) Iv) : Hom (lin W) (lin two) = compH (lin W) IvIv (lin two) betaH (pairH Iv Iv (lin W) s v) ;

    Q (W : Nat) (a : Hom (lin W) (lin m)) (s v : Hom (lin W) Iv) : TA.EI (lin W) =
      R2.D.val W (pairH (lin m) (lin two) (lin W) a (bp W s v)) ;

    Qp (W : Nat) (a : Hom (lin W) (lin m)) (s v : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (Q W a s v)) (G.act (lin W) (lin m) a xf) =
      transH (R2.D.vp W (pairH (lin m) (lin two) (lin W) a (bp W s v)))
        (transH (GL.actTri (lin W) P2 X phi2 (pairH (lin m) (lin two) (lin W) a (bp W s v)) (compH (lin W) (lin m) X f a)
                  (transH (comp-assoc (lin W) P2 (lin m) X f (pr1 (lin m) (lin two)) (pairH (lin m) (lin two) (lin W) a (bp W s v)))
                          (apH (compH (lin W) (lin m) X f) (pr1-pair (lin m) (lin two) (lin W) a (bp W s v)))) x)
                (symH (GL.actC (lin W) (lin m) X f a x))) ;

    bp-h (V W : Nat) (h : Hom (lin V) (lin W)) (s v : Hom (lin W) Iv)
      : Id (Hom (lin V) (lin two)) (compH (lin V) (lin W) (lin two) (bp W s v) h) (bp V (compH (lin V) (lin W) Iv s h) (compH (lin V) (lin W) Iv v h)) =
      transH (comp-assoc (lin V) (lin W) IvIv (lin two) betaH (pairH Iv Iv (lin W) s v) h)
             (apH (compH (lin V) IvIv (lin two) betaH) (BD.pair-h Iv Iv (lin V) (lin W) s v h)) ;

    Qn (V W : Nat) (h : Hom (lin V) (lin W)) (a : Hom (lin W) (lin m)) (s v : Hom (lin W) Iv)
      : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Q W a s v))
           (Q V (compH (lin V) (lin W) (lin m) a h) (compH (lin V) (lin W) Iv s h) (compH (lin V) (lin W) Iv v h)) =
      transH (R2.D.vn V W h (pairH (lin m) (lin two) (lin W) a (bp W s v)))
        (apH (R2.D.val V)
           (transH (BD.pair-h (lin m) (lin two) (lin V) (lin W) a (bp W s v) h)
                   (apH (pairH (lin m) (lin two) (lin V) (compH (lin V) (lin W) (lin m) a h)) (bp-h V W h s v)))) ;

    -- its edges
    Qe (y W : Nat) (a : Hom (lin W) (lin m)) (s : Hom (lin W) Iv) (k : Hom (lin W) (lin two))
      (ek : Id (Hom (lin W) (lin two)) k (compH (lin W) Iv (lin two) (dl (suc zero) y) s))
      : Id (TA.EI (lin W)) (R2.D.val W (pairH (lin m) (lin two) (lin W) a k)) (R.D.val W (pairH (lin m) Iv (lin W) a s)) =
      transH (apH (\ k1 -> R2.D.val W (pairH (lin m) (lin two) (lin W) a k1)) ek)
        (transH (apH (R2.D.val W) (pair-io y W a s)) (R2io y W (pairH (lin m) Iv (lin W) a s))) ;

    Q-v0 (W : Nat) (a : Hom (lin W) (lin m)) (s : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (Q W a s (constH (lin W) Iv e0)) (R.D.val W (pairH (lin m) Iv (lin W) a s)) =
      Qe two W a s _ (BetaEdges[lin W].v0 s) ;

    Q-s1 (W : Nat) (a : Hom (lin W) (lin m)) (v : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (Q W a (constH (lin W) Iv e1) v) (R.D.val W (pairH (lin m) Iv (lin W) a v)) =
      Qe zero W a v _ (BetaEdges[lin W].s1 v) ;

    Q-s0 (W : Nat) (a : Hom (lin W) (lin m)) (v : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (Q W a (constH (lin W) Iv e0) v) (R.D.val W (pairH (lin m) Iv (lin W) a v)) =
      Qe (suc zero) W a v _ (BetaEdges[lin W].s0 v) ;

    Q-v1 (W : Nat) (a : Hom (lin W) (lin m)) (s : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (Q W a s (constH (lin W) Iv e1)) (TA.E.act (lin W) (lin m) a Uf0) =
      transH (apH (\ k -> R2.D.val W (pairH (lin m) (lin two) (lin W) a k)) (BetaEdges[lin W].v1 s))
        (transH (apH (R2.D.val W) (P2t.L.lam-a W a))
          (transH (symH (RdI[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, P2, H2.ht, H2.B, H2.hB, H2.hm, H2.hi, N2, hm2, leb-refl N2,
                              phi2, P2t.L.lam, pairc-strict (lin m) (lin two) (leaf two, refl true), W, a].res))
            (transH (RdZ[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, N2, N2, hm2, hm2, compH (lin m) P2 X phi2 P2t.L.lam, f,
                         P2t.L.phi-lam phi2 (refl phi2), W, a].res)
                    (RdS[m, N2, hm2, f, W, a].res)))) ;

    opaque Qp ; opaque Qn ; opaque Q-v0 ; opaque Q-s1 ; opaque Q-s0 ; opaque Q-v1 ; opaque Rend ;
  } ;
  ----------------------------------------------------------------------
  -- the data at a face are the data at the composite

  module Face (m : Nat) (F : Hom (lin (suc m)) X) (y : Nat) {
    Fd : Hom (lin m) X = compH (lin m) (lin (suc m)) X F (dl m y) ;
    module SF = Sq[suc m, F] ;
    module Sd = Sq[m, Fd] ;

    Uf-face : Id (TA.EI (lin m)) (TA.E.act (lin m) (lin (suc m)) (dl m y) (Uf (suc m) F)) (Uf m Fd) =
      u.2 m (suc m) (dl m y) (dl-strict m y) F ;

    -- d * id on [m] * Y'
    module DY (Y' : Ob) {
      io : Hom (prodP (lin m) Y') (prodP (lin (suc m)) Y') = crossH (lin m) (lin (suc m)) Y' Y' (dl m y) (idH Y') ;
      io-st : Strict (prodP (lin m) Y') (prodP (lin (suc m)) Y') io = crossd-strict m (suc m) Y' (dl m y) (dl-strict m y) ;
      io-pair (W : Nat) (a : Hom (lin W) (lin m)) (b : Hom (lin W) Y')
        : Id (Hom (lin W) (prodP (lin (suc m)) Y')) (pairH (lin (suc m)) Y' (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m y) a) b)
                                                    (compH (lin W) (prodP (lin m) Y') (prodP (lin (suc m)) Y') io (pairH (lin m) Y' (lin W) a b)) =
        symH (transH (BD.cross-pair (lin m) (lin (suc m)) Y' Y' (lin W) (dl m y) (idH Y') a b)
                     (apH (pairH (lin (suc m)) Y' (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m y) a)) (comp-idl (lin W) Y' b))) ;
      phi-io : Id (Hom (prodP (lin m) Y') X)
        (compH (prodP (lin m) Y') (prodP (lin (suc m)) Y') X (compH (prodP (lin (suc m)) Y') (lin (suc m)) X F (pr1 (lin (suc m)) Y')) io)
        (compH (prodP (lin m) Y') (lin m) X Fd (pr1 (lin m) Y')) =
        transH (comp-assoc (prodP (lin m) Y') (prodP (lin (suc m)) Y') (lin (suc m)) X F (pr1 (lin (suc m)) Y') io)
          (transH (apH (compH (prodP (lin m) Y') (lin (suc m)) X F)
                     (pr1-pair (lin (suc m)) Y' (prodP (lin m) Y') (compH (prodP (lin m) Y') (lin m) (lin (suc m)) (dl m y) (pr1 (lin m) Y'))
                        (compH (prodP (lin m) Y') Y' Y' (idH Y') (pr2 (lin m) Y'))))
                  (symH (comp-assoc (prodP (lin m) Y') (lin m) (lin (suc m)) X F (dl m y) (pr1 (lin m) Y')))) ;
    } ;
    module D1 = DY[Iv] ;
    module D2 = DY[lin two] ;

    R-face (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (SF.R.D.val W (pairH (lin (suc m)) Iv (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m y) a) j))
                           (Sd.R.D.val W (pairH (lin m) Iv (lin W) a j)) =
      transH (apH (SF.R.D.val W) (D1.io-pair W a j))
        (transH (symH (RdI[Sd.P1, Sd.H1.ht, Sd.H1.B, Sd.H1.hB, Sd.H1.hm, Sd.H1.hi, SF.P1, SF.H1.ht, SF.H1.B, SF.H1.hB, SF.H1.hm, SF.H1.hi,
                           SF.N1, leb-suc Sd.N1, leb-refl SF.N1, SF.phi1, D1.io, D1.io-st, W, pairH (lin m) Iv (lin W) a j].res))
                (RdZ[Sd.P1, Sd.H1.ht, Sd.H1.B, Sd.H1.hB, Sd.H1.hm, Sd.H1.hi, SF.N1, Sd.N1, leb-suc Sd.N1, leb-refl Sd.N1,
                     compH Sd.P1 SF.P1 X SF.phi1 D1.io, Sd.phi1, D1.phi-io, W, pairH (lin m) Iv (lin W) a j].res)) ;

    Q-face (W : Nat) (a : Hom (lin W) (lin m)) (s v : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (SF.Q W (compH (lin W) (lin m) (lin (suc m)) (dl m y) a) s v) (Sd.Q W a s v) =
      transH (apH (SF.R2.D.val W) (D2.io-pair W a (SF.bp W s v)))
        (transH (symH (RdI[Sd.P2, Sd.H2.ht, Sd.H2.B, Sd.H2.hB, Sd.H2.hm, Sd.H2.hi, SF.P2, SF.H2.ht, SF.H2.B, SF.H2.hB, SF.H2.hm, SF.H2.hi,
                           SF.N2, leb-suc Sd.N2, leb-refl SF.N2, SF.phi2, D2.io, D2.io-st, W, pairH (lin m) (lin two) (lin W) a (SF.bp W s v)].res))
                (RdZ[Sd.P2, Sd.H2.ht, Sd.H2.B, Sd.H2.hB, Sd.H2.hm, Sd.H2.hi, SF.N2, Sd.N2, leb-suc Sd.N2, leb-refl Sd.N2,
                     compH Sd.P2 SF.P2 X SF.phi2 D2.io, Sd.phi2, D2.phi-io, W, pairH (lin m) (lin two) (lin W) a (SF.bp W s v)].res)) ;

    opaque R-face ; opaque Q-face ;
  } ;
} ;
