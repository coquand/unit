-- CSieve.seg: DECIDABLE SIEVES over a small category, in canonical form
-- (cours6: Phi(X) is a lattice of decidable sieves).  A sieve on X is a
-- Boolean predicate on the maps into X, closed under precomposition; two
-- sieves landing the same maps are equal (funext: phi-ext), so a sieve is
-- its own presentation.  The operations of the base interface (IvBase):
-- pre (pullback), Lands, the empty and the total sieve, binary union (or),
-- decision on the identity (allS).  One home for every instance (Delta:
-- DeltaBase; posets: to come).

level k ;
open Base ;
open Prelude[k+] ;
open Paths[k+] ;
open Axioms[k+].FunExtLemmas[fe @(k+)] ;
module W = V[k] ;
open Trees[k] ;
open Arith[k] ;

module Sieves (obV : W.V) (homV : SmallCat[k].Objs[obV].Ob -> SmallCat[k].Objs[obV].Ob -> W.V)
  (idH : (X : SmallCat[k].Objs[obV].Ob) -> SmallCat[k].Homs[obV, homV].Hom X X)
  (compH : (X Y Z : SmallCat[k].Objs[obV].Ob) (g : SmallCat[k].Homs[obV, homV].Hom Y Z) (f : SmallCat[k].Homs[obV, homV].Hom X Y)
           -> SmallCat[k].Homs[obV, homV].Hom X Z)
  (comp-assoc : (L K J I : SmallCat[k].Objs[obV].Ob) (f : SmallCat[k].Homs[obV, homV].Hom J I) (g : SmallCat[k].Homs[obV, homV].Hom K J)
                (h : SmallCat[k].Homs[obV, homV].Hom L K)
                -> Id (SmallCat[k].Homs[obV, homV].Hom L I) (compH L K I (compH K J I f g) h) (compH L J I f (compH L K J g h))) {
  open SmallCat[k].Objs[obV] ;
  open SmallCat[k].Homs[obV, homV] ;

  -- closure under precomposition
  ClosTy (X : Ob) (P : (W : Ob) -> Hom W X -> Bool) : U k =
    (W' W : Ob) (f : Hom W X) (g : Hom W' W) -> IsT (P W f) -> IsT (P W' (compH W' W X f g)) ;

  Phi (X : Ob) : U k = (P : (W : Ob) -> Hom W X -> Bool) * ClosTy X P ;

  Lands (W X : Ob) (Q : Phi X) (f : Hom W X) : U k = IsT (Q.1 W f) ;

  isProp-Lands (W X : Ob) (Q : Phi X) (f : Hom W X) : isProp (Lands W X Q f) = isProp-IsT' (Q.1 W f) ;

  lands-comp (W' W X : Ob) (Q : Phi X) (f : Hom W X) (chi : Hom W' W) (i : Lands W X Q f) : Lands W' X Q (compH W' W X f chi) =
    Q.2 W' W f chi i ;

  pre (Y X : Ob) (h : Hom Y X) (Q : Phi X) : Phi Y =
    (\ W g -> Q.1 W (compH W Y X h g),
     \ W' W g g' i -> substH (\ m -> IsT (Q.1 W' m)) (comp-assoc W' W Y X h g g') (Q.2 W' W (compH W Y X h g) g' i)) ;

  -- pulling back is precomposing: both directions are the identity
  lands-pre (W Y X : Ob) (h : Hom Y X) (Q : Phi X) (g : Hom W Y) (i : Lands W Y (pre Y X h Q) g) : Lands W X Q (compH W Y X h g) = i ;
  pre-lands (W Y X : Ob) (h : Hom Y X) (Q : Phi X) (g : Hom W Y) (i : Lands W X Q (compH W Y X h g)) : Lands W Y (pre Y X h Q) g = i ;

  isProp-clos (X : Ob) (P : (W : Ob) -> Hom W X -> Bool) : isProp (ClosTy X P) =
    isProp-Pi Ob (\ W' -> (W : Ob) (f : Hom W X) (g : Hom W' W) -> IsT (P W f) -> IsT (P W' (compH W' W X f g))) (\ W' ->
    isProp-Pi Ob (\ W -> (f : Hom W X) (g : Hom W' W) -> IsT (P W f) -> IsT (P W' (compH W' W X f g))) (\ W ->
    isProp-Pi (Hom W X) (\ f -> (g : Hom W' W) -> IsT (P W f) -> IsT (P W' (compH W' W X f g))) (\ f ->
    isProp-Pi (Hom W' W) (\ g -> IsT (P W f) -> IsT (P W' (compH W' W X f g))) (\ g ->
    isProp-Pi (IsT (P W f)) (\ i -> IsT (P W' (compH W' W X f g))) (\ i -> isProp-IsT' (P W' (compH W' W X f g))))))) ;

  -- a sieve is determined by the maps landing in it
  phi-ext (X : Ob) (Q Q' : Phi X)
    (p : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Lands W X Q' f)
    (q : (W : Ob) (f : Hom W X) -> Lands W X Q' f -> Lands W X Q f) : Id (Phi X) Q Q' =
    Sigma-eq ((W : Ob) -> Hom W X -> Bool) (\ P -> ClosTy X P) Q.1 Q'.1 Q.2 Q'.2
      (funext Ob (\ W -> Hom W X -> Bool) Q.1 Q'.1 (\ W ->
         funext (Hom W X) (\ f -> Bool) (Q.1 W) (Q'.1 W) (\ f -> bool-ext (Q.1 W f) (Q'.1 W f) (p W f) (q W f))))
      (isProp-clos X Q'.1) ;

  -- the empty and the total sieve
  emptyS (X : Ob) : Phi X = (\ W f -> false, \ W' W f g i -> i) ;

  empty-lands (W X : Ob) (f : Hom W X) (i : Lands W X (emptyS X) f) : Empty = false-true i ;

  topS (X : Ob) : Phi X = (\ W f -> true, \ W' W f g i -> i) ;

  top-lands (W X : Ob) (f : Hom W X) : Lands W X (topS X) f = refl true ;

  -- binary union
  unionS (X : Ob) (Q Q' : Phi X) : Phi X =
    (\ W f -> or (Q.1 W f) (Q'.1 W f),
     \ W' W f g i -> or-elim (IsT (or (Q.1 W' (compH W' W X f g)) (Q'.1 W' (compH W' W X f g)))) (Q.1 W f) (Q'.1 W f) i
                       (\ a -> or-l (Q.1 W' (compH W' W X f g)) (Q'.1 W' (compH W' W X f g)) (Q.2 W' W f g a))
                       (\ b -> or-r (Q.1 W' (compH W' W X f g)) (Q'.1 W' (compH W' W X f g)) (Q'.2 W' W f g b))) ;

  lands-union-l (W X : Ob) (Q Q' : Phi X) (f : Hom W X) (i : Lands W X Q f) : Lands W X (unionS X Q Q') f =
    or-l (Q.1 W f) (Q'.1 W f) i ;

  lands-union-r (W X : Ob) (Q Q' : Phi X) (f : Hom W X) (i : Lands W X Q' f) : Lands W X (unionS X Q Q') f =
    or-r (Q.1 W f) (Q'.1 W f) i ;

  union-lands (W X : Ob) (Q Q' : Phi X) (f : Hom W X) (i : Lands W X (unionS X Q Q') f)
    : Plus (Lands W X Q f) (Lands W X Q' f) =
    or-elim (Plus (Lands W X Q f) (Lands W X Q' f)) (Q.1 W f) (Q'.1 W f) i (\ a -> inl a) (\ b -> inr b) ;

  -- the union of a list of sieves
  bigU (X : Ob) (r : Nat) (Q : Fin r -> Phi X) : Phi X =
    (\ W f -> anyF r (\ k -> (Q k).1 W f),
     \ W' W f g t -> anyF-complete r (\ k -> (Q k).1 W' (compH W' W X f g)) (anyF-sound r (\ k -> (Q k).1 W f) t).1
                       ((Q (anyF-sound r (\ k -> (Q k).1 W f) t).1).2 W' W f g (anyF-sound r (\ k -> (Q k).1 W f) t).2)) ;

  bigU-in (W X : Ob) (r : Nat) (Q : Fin r -> Phi X) (f : Hom W X) (k : Fin r) (i : Lands W X (Q k) f) : Lands W X (bigU X r Q) f =
    anyF-complete r (\ k' -> (Q k').1 W f) k i ;

  bigU-out (W X : Ob) (r : Nat) (Q : Fin r -> Phi X) (f : Hom W X) (i : Lands W X (bigU X r Q) f) : (k : Fin r) * Lands W X (Q k) f =
    anyF-sound r (\ k -> (Q k).1 W f) i ;

  -- decided on the identity
  allS (X : Ob) (Q : Phi X) : Bool = Q.1 X (idH X) ;
  allS-sound (X : Ob) (Q : Phi X) (h : IsT (allS X Q)) : Lands X X Q (idH X) = h ;
  allS-complete (X : Ob) (Q : Phi X) (i : Lands X X Q (idH X)) : IsT (allS X Q) = i ;
} ;

------------------------------------------------------------------------
-- dependent conjunction (model.tex §9.1, Hypothesis "dependent
-- conjunction"): decidable sieves have it.  For Q and a natural family F f
-- of sieves on Q, the sieve of the f in Q with the identity in F f.

module DConjS (obV : W.V) (homV : SmallCat[k].Objs[obV].Ob -> SmallCat[k].Objs[obV].Ob -> W.V)
  (idH : (X : SmallCat[k].Objs[obV].Ob) -> SmallCat[k].Homs[obV, homV].Hom X X)
  (compH : (X Y Z : SmallCat[k].Objs[obV].Ob) (g : SmallCat[k].Homs[obV, homV].Hom Y Z) (f : SmallCat[k].Homs[obV, homV].Hom X Y)
           -> SmallCat[k].Homs[obV, homV].Hom X Z)
  (comp-assoc : (L K J I : SmallCat[k].Objs[obV].Ob) (f : SmallCat[k].Homs[obV, homV].Hom J I) (g : SmallCat[k].Homs[obV, homV].Hom K J)
                (h : SmallCat[k].Homs[obV, homV].Hom L K)
                -> Id (SmallCat[k].Homs[obV, homV].Hom L I) (compH L K I (compH K J I f g) h) (compH L J I f (compH L K J g h)))
  (comp-idl : (J I : SmallCat[k].Objs[obV].Ob) (f : SmallCat[k].Homs[obV, homV].Hom J I)
              -> Id (SmallCat[k].Homs[obV, homV].Hom J I) (compH J I I (idH I) f) f)
  (comp-idr : (J I : SmallCat[k].Objs[obV].Ob) (f : SmallCat[k].Homs[obV, homV].Hom J I)
              -> Id (SmallCat[k].Homs[obV, homV].Hom J I) (compH J J I f (idH J)) f) {
  open SmallCat[k].Objs[obV] ;
  open SmallCat[k].Homs[obV, homV] ;
  module S = Sieves[obV, homV, idH, compH, comp-assoc] ;
  open S ;

  dand : (b : Bool) -> (IsT b -> Bool) -> Bool = split { true -> \ c -> c (refl true) ; false -> \ c -> false } ;

  dand-sound : (b : Bool) (c : IsT b -> Bool) -> IsT (dand b c) -> (i : IsT b) * IsT (c i) = split {
    true -> \ c h -> (refl true, h) ;
    false -> \ c h -> absurd ((i : IsT false) * IsT (c i)) (false-true h) } ;

  dand-complete : (b : Bool) (c : IsT b -> Bool) (i : IsT b) -> IsT (c i) -> IsT (dand b c) = split {
    true -> \ c i h -> substH (\ i' -> IsT (c i')) (isProp-IsT' true i (refl true)) h ;
    false -> \ c i h -> absurd (IsT (dand false c)) (false-true i) } ;

  FamTy (X : Ob) (Q : Phi X) : U k = (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W ;

  FnTy (X : Ob) (Q : Phi X) (F : FamTy X Q) : U k =
    (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
    -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i') ;

  dpred (X : Ob) (Q : Phi X) (F : FamTy X Q) (W : Ob) (f : Hom W X) : Bool = dand (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) ;

  dclos (X : Ob) (Q : Phi X) (F : FamTy X Q) (Fn : FnTy X Q F) (W' W : Ob) (f : Hom W X) (g : Hom W' W)
    (t : IsT (dpred X Q F W f)) : IsT (dpred X Q F W' (compH W' W X f g)) =
    dand-complete (Q.1 W' (compH W' W X f g)) (\ i' -> (F W' (compH W' W X f g) i').1 W' (idH W'))
      (Q.2 W' W f g (dand-sound (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) t).1)
      (substH (\ R -> IsT (R.1 W' (idH W')))
         (Fn W' W g f (dand-sound (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) t).1 (Q.2 W' W f g (dand-sound (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) t).1))
         (substH (\ m -> IsT ((F W f (dand-sound (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) t).1).1 W' m))
            (transH (comp-idl W' W g) (symH (comp-idr W' W g)))
            ((F W f (dand-sound (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) t).1).2 W' W (idH W) g
               (dand-sound (Q.1 W f) (\ i -> (F W f i).1 W (idH W)) t).2))) ;

  dconj (X : Ob) (Q : Phi X) (F : FamTy X Q) (Fn : FnTy X Q F) : Phi X = (dpred X Q F, dclos X Q F Fn) ;

  dc-in (W X : Ob) (Q : Phi X) (F : FamTy X Q) (Fn : FnTy X Q F) (f : Hom W X) (i : Lands W X Q f) (j : Lands W W (F W f i) (idH W))
    : Lands W X (dconj X Q F Fn) f = dand-complete (Q.1 W f) (\ i2 -> (F W f i2).1 W (idH W)) i j ;

  dc-out (W X : Ob) (Q : Phi X) (F : FamTy X Q) (Fn : FnTy X Q F) (f : Hom W X) (i : Lands W X (dconj X Q F Fn) f)
    : (i' : Lands W X Q f) * Lands W W (F W f i') (idH W) = dand-sound (Q.1 W f) (\ i2 -> (F W f i2).1 W (idH W)) i ;
} ;
