-- Strict decoding and its injectivity reduce code naturality to
-- product naturality. The binder is transported along decode-nat.
module R = Uv.CDCodeUniverseSub ;

module NatLaw (D G : PCtx) (s : PSub[D, G]) (a0 : O.El G (Uv.universe G))
  (b : O.El (O.ext G (Uv.decode G a0)) (Uv.universe (O.ext G (Uv.decode G a0)))) {
  AG : C.C.Ty G = Uv.decode G a0 ;
  E : PCtx = O.ext G AG ;
  BG : C.C.Ty E = Uv.decode E b ;

  a' : O.El D (Uv.universe D) = R.Sub[D, G, a0, s].code-sub ;
  A0 : C.C.Ty D = C.C.subT D G AG s ;
  A1 : C.C.Ty D = Uv.decode D a' ;
  p : Id (C.C.Ty D) A0 A1 = R.Sub[D, G, a0, s].law ;
  lift0 : PSub[O.ext D A0, E] = O.lift D G AG s ;

  Lift (T : C.C.Ty D) : U a+ = PSub[O.ext D T, E] ;
  lift1 : Lift A1 = subst (C.C.Ty D) (\ T -> Lift T) A0 A1 p lift0 ;
  b' : O.El (O.ext D A1) (Uv.universe (O.ext D A1)) = R.Sub[O.ext D A1, E, b, lift1].code-sub ;

  change : Id (C.C.Ty D) (products.Pi D A0 (C.C.subT (O.ext D A0) E BG lift0))
      (products.Pi D A1 (C.C.subT (O.ext D A1) E BG lift1)) =
    idJ (C.C.Ty D) A0 (\ T q -> Id (C.C.Ty D)
      (products.Pi D A0 (C.C.subT (O.ext D A0) E BG lift0))
      (products.Pi D T (C.C.subT (O.ext D T) E BG (subst (C.C.Ty D) (\ X -> Lift X) A0 T q lift0))))
      (refl (products.Pi D A0 (C.C.subT (O.ext D A0) E BG lift0))) A1 p ;

  lhs : O.El D (Uv.universe D) = R.Sub[D, G, pic G a0 b, s].code-sub ;
  rhs : O.El D (Uv.universe D) = pic D a' b' ;

  decoded : Id (C.C.Ty D) (Uv.decode D lhs) (Uv.decode D rhs) =
    transH (symH R.Sub[D, G, pic G a0 b, s].law)
      (transH (apH (\ A -> C.C.subT D G A s) (dec-pic G a0 b))
        (transH (products.Pi-nat D G AG BG s)
          (transH change
            (transH (apH (products.Pi D A1) R.Sub[O.ext D A1, E, b, lift1].law)
              (symH (dec-pic D a' b')))))) ;

  law : Id (O.El D (Uv.universe D)) lhs rhs = Uv.decode-inj D lhs rhs decoded ;

  opaque law ;
} ;
