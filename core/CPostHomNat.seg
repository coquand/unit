-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostHomNat.seg: naturality of step 2 and of the inverse homotopy.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LM = CPostLimit[a, l] ;


module EX = CPostExt[a, l] ;
module PM = CPostMap[a, l] ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module RC = CPostRec[a, l] ;

module Nat (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
  (z : W.Ix (LM.Post[G, A].L.tob X x)) {
  module R = CPostNat[a, l].Nat[G, A, c, Y, X, h, x, y, e, z] ;
  module P = R.P ;
  module S1 = R.I1.Construction[c].Sq ; module S2 = R.I2.Construction[c].Sq ;
  module L1 = S1.P ; module L2 = S2.P ;
  module TA = PR.TyL[G, A] ;
  module HC = EX.Cross[Y, X, h] ;
  module HCC = EX.Cross[HC.YI, HC.XI, HC.hI] ;
  eI : Id (W.Ix (G.ob HC.YI)) (G.act HC.YI HC.XI HC.hI L1.xI) L2.xI = HC.base G x y e ;
  eII : Id (W.Ix (G.ob S2.XII)) (G.act S2.XII S1.XII HCC.hI S1.xII) S2.xII = HCC.base G L1.xI L2.xI eI ;

  module TopZ (f : Hom (lin (zero)) Y) {
    module K = CCosk[a, l].KT[G, A, zero] ;
    module T1 = L1.St2Z[R.hf (zero) f].S.Sq ;
    module T2 = L2.St2Z[f].S.Sq ;
    module C = CPostSqNat[a, l].SqZCmp[T1.G, T1.B, T1.e, T1.fill, T1.sides, T1.face, T1.xf, T1.psi, T1.psi-pt, T1.L, T1.Lp, T1.Ln, T1.Pl, T1.Plp, T1.Pln, T1.L0, T1.L1,
      T2.xf, T2.psi, T2.psi-pt, T2.L, T2.Lp, T2.Ln, T2.Pl, T2.Plp, T2.Pln, T2.L0, T2.L1,
      R.xf (zero) f, apH (K.etaE (lin (zero))) (R.recNat (zero) f).ps,
      \ W g j -> apH (K.etaE (lin W)) (apH (\ H -> H W g j) ((R.recNat (zero) f).hs (suc (zero)))),
      R.PRd[zero, zero, f].D.knat] ;
    -- the square of C read as ThmT, one side at a time
    eqT (W : Nat) (g : Hom (lin W) (prodP (lin (zero)) Iv)) (j : Hom (lin W) Iv)
      : Id (K.TK.EI (lin W)) (S1.ThmT (zero) (R.hf (zero) f) W g j) (S2.ThmT (zero) f W g j) =
      transH {K.TK.EI (lin W)} {S1.ThmT (zero) (R.hf (zero) f) W g j} {C.S1.Thf W g j} {S2.ThmT (zero) f W g j} (refl (C.S1.Thf W g j))
        (transH {K.TK.EI (lin W)} {C.S1.Thf W g j} {C.S2.Thf W g j} {S2.ThmT (zero) f W g j} (C.eq W g j) (refl (C.S2.Thf W g j))) ;
  } ;

  module TopS (m : Nat) (f : Hom (lin (suc m)) Y) {
    module K = CCosk[a, l].KT[G, A, suc m] ;
    module T1 = L1.St2S[m, R.hf (suc m) f].S.Sq ;
    module T2 = L2.St2S[m, f].S.Sq ;

    ft (k : Nat) (hk : IsT (leb k (suc m))) (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
      : Id (K.TK.EI (lin W)) (T1.Th k hk W g j) (T2.Th k hk W g j) =
      apH (K.etaE (lin W))
        (transH (apH (\ q -> (L1.Rd m q).Ts (suc m) W g j) (comp-assoc (lin m) (lin (suc m)) Y X h f (dl m k)))
          (apH (\ T -> T W g j) ((R.recNat m (compH (lin m) (lin (suc m)) Y f (dl m k))).ts (suc m)))) ;
    opaque ft ;
    module C = CPostSqNat[a, l].SqSCmp[T1.G, T1.B, T1.e, T1.fill, T1.sides, T1.face, m, T1.xf, T1.psi, T1.psi-pt, T1.L, T1.Lp, T1.Ln, T1.Pl, T1.Plp, T1.Pln, T1.L0, T1.L1, T1.Th, T1.Thp, T1.Thn, T1.Th-e, T1.Th-t0, T1.Th-t1, T1.FFt,
      T2.xf, T2.psi, T2.psi-pt, T2.L, T2.Lp, T2.Ln, T2.Pl, T2.Plp, T2.Pln, T2.L0, T2.L1, T2.Th, T2.Thp, T2.Thn, T2.Th-e, T2.Th-t0, T2.Th-t1, T2.FFt,
      R.xf (suc m) f, apH (K.etaE (lin (suc m))) (R.recNat (suc m) f).ps,
      \ W g j -> apH (K.etaE (lin W)) (apH (\ H -> H W g j) ((R.recNat (suc m) f).hs (suc (suc m)))),
      R.PRd[suc m, suc m, f].D.knat, ft] ;
    -- the square of C read as ThmT, one side at a time
    -- by definition of ThmT at suc m: the square of St2S, which C compares
    rd1 (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Iv)) (j : Hom (lin W) Iv)
      : Id (K.TK.EI (lin W)) (S1.ThmT (suc m) (R.hf (suc m) f) W g j) (C.S1.Thf W g j) = refl (C.S1.Thf W g j) ;
    rd2 (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Iv)) (j : Hom (lin W) Iv)
      : Id (K.TK.EI (lin W)) (C.S2.Thf W g j) (S2.ThmT (suc m) f W g j) = refl (C.S2.Thf W g j) ;
    eqT (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Iv)) (j : Hom (lin W) Iv)
      : Id (K.TK.EI (lin W)) (S1.ThmT (suc m) (R.hf (suc m) f) W g j) (S2.ThmT (suc m) f W g j) =
      transH (rd1 W g j) (transH (C.eq W g j) (rd2 W g j)) ;
  } ;

  top : (n : Nat) (f : Hom (lin n) Y) (W : Nat) (g : Hom (lin W) (prodP (lin n) Iv)) (j : Hom (lin W) Iv)
    -> Id (CCosk[a, l].KT[G, A, n].TK.EI (lin W)) (S1.ThmT n (R.hf n f) W g j) (S2.ThmT n f W g j) = split {
    zero -> \ f -> TopZ[f].eqT ;
    suc m -> \ f -> TopS[m, f].eqT } ;
  opaque top ;
  hm (n : Nat) (f : Hom (lin n) Y) (W : Nat) (g : Hom (lin W) (lin n)) (j : Hom (lin W) Iv)
    : Id (CCosk[a, l].KT[G, A, n].TK.EI (lin W)) (L1.HmT n (R.hf n f) W g j) (L2.HmT n f W g j) =
    transH (S1.ThmT-s1 n (R.hf n f) W g j)
      (transH (top n f W (pairH (lin n) Iv (lin W) g j) (constH (lin W) Iv e1)) (symH (S2.ThmT-s1 n f W g j))) ;
  opaque hm ;

  module LineVal (N n : Nat) (q : Hom (lin n) HC.YI) {
    hq : Hom (lin n) HC.XI = compH (lin n) HC.YI HC.XI HC.hI q ;
    f : Hom (lin n) Y = L2.p1F n q ; t : Hom (lin n) Iv = L2.p2F n q ;
    low : Id (TA.EI (lin n)) (L1.vlow N n (L1.p1F n hq) (L1.p2F n hq)) (L2.vlow N n f t) =
      transH (apH (\ k -> L1.vlow N n k (L1.p2F n hq)) (HC.one (lin n) q))
        (transH (apH (L1.vlow N n (R.hf n f)) (HC.two (lin n) q))
          (apH (\ H -> H n (idH (lin n)) t) ((R.recNat n f).hs N))) ;
    high : Id (TA.EI (lin n)) (L1.vtop n (L1.p1F n hq) (L1.p2F n hq)) (L2.vtop n f t) =
      transH (apH (\ k -> L1.vtop n k (L1.p2F n hq)) (HC.one (lin n) q))
        (transH (apH (L1.vtop n (R.hf n f)) (HC.two (lin n) q))
          (apH (CCosk[a, l].KT[G, A, n].ev n (leb-refl n)) (hm n f n (idH (lin n)) t))) ;
    eq : Id (TA.EI (lin n)) (L1.val N n hq) (L2.val N n q) =
      EX.bcong (TA.EI (lin n)) (leb (suc n) N)
        (\ hh -> L1.vlow N n (L1.p1F n hq) (L1.p2F n hq)) (\ hh -> L2.vlow N n f t)
        (\ nh -> L1.vtop n (L1.p1F n hq) (L1.p2F n hq)) (\ nh -> L2.vtop n f t) (\ hh -> low) (\ nh -> high) ;
    opaque eq ;
  } ;

  module SquareVal (N n : Nat) (q : Hom (lin n) S2.XII) {
    hq : Hom (lin n) S1.XII = compH (lin n) S2.XII S1.XII HCC.hI q ;
    f : Hom (lin n) Y = S2.fF n q ; t : Hom (lin n) Iv = S2.tF n q ; s : Hom (lin n) Iv = S2.sF n q ;
    ef : Id (Hom (lin n) X) (S1.fF n hq) (R.hf n f) =
      transH (apH (L1.p1F n) (HCC.one (lin n) q)) (HC.one (lin n) (S2.q1 n q)) ;
    et : Id (Hom (lin n) Iv) (S1.tF n hq) t =
      transH (apH (L1.p2F n) (HCC.one (lin n) q)) (HC.two (lin n) (S2.q1 n q)) ;
    es : Id (Hom (lin n) Iv) (S1.sF n hq) s = HCC.two (lin n) q ;
    low : Id (TA.EI (lin n)) (S1.sq-low N n (S1.fF n hq) (S1.tF n hq) (S1.sF n hq)) (S2.sq-low N n f t s) =
      transH (apH (\ k -> S1.sq-low N n k (S1.tF n hq) (S1.sF n hq)) ef)
        (transH (apH (\ k -> S1.sq-low N n (R.hf n f) k (S1.sF n hq)) et)
          (transH (apH (S1.sq-low N n (R.hf n f) t) es)
            (apH (\ T -> T n (pairH (lin n) Iv (lin n) (idH (lin n)) t) s) ((R.recNat n f).ts N)))) ;
    high : Id (TA.EI (lin n)) (S1.sq-top n (S1.fF n hq) (S1.tF n hq) (S1.sF n hq)) (S2.sq-top n f t s) =
      transH (apH (\ k -> S1.sq-top n k (S1.tF n hq) (S1.sF n hq)) ef)
        (transH (apH (\ k -> S1.sq-top n (R.hf n f) k (S1.sF n hq)) et)
          (transH (apH (S1.sq-top n (R.hf n f) t) es)
            (apH (CCosk[a, l].KT[G, A, n].ev n (leb-refl n)) (top n f n (pairH (lin n) Iv (lin n) (idH (lin n)) t) s)))) ;
    eq : Id (TA.EI (lin n)) (S1.val2 N n hq) (S2.val2 N n q) =
      EX.bcong (TA.EI (lin n)) (leb (suc n) N)
        (\ hh -> S1.sq-low N n (S1.fF n hq) (S1.tF n hq) (S1.sF n hq)) (\ hh -> S2.sq-low N n f t s)
        (\ nh -> S1.sq-top n (S1.fF n hq) (S1.tF n hq) (S1.sF n hq)) (\ nh -> S2.sq-top n f t s) (\ hh -> low) (\ nh -> high) ;
    opaque eq ;
  } ;

  module At (N : Nat) {
    module D = CLocDNC[a, l].DC[G, A, N] ;
    module TD = PR.TyL[G, P.B N] ;
    linerd (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) HC.YI)
      : Id (TA.EI (lin n))
        (D.rdId HC.YI L2.xI (D.DK.dtact HC.YI HC.XI HC.hI L1.xI L2.xI eI L1.DCN[N].line) n hn q)
        (L1.val N n (compH (lin n) HC.YI HC.XI HC.hI q)) =
      transH (symH (D.crd-toF HC.YI L2.xI (D.DK.dtact HC.YI HC.XI HC.hI L1.xI L2.xI eI L1.DCN[N].line) n hn q))
        (transH (D.to-nat HC.YI HC.XI HC.hI L1.xI L2.xI eI L1.DCN[N].line n hn q)
          (transH (D.crd-toF HC.XI L1.xI L1.DCN[N].line n hn (compH (lin n) HC.YI HC.XI HC.hI q))
            (S1.DCS[N].line-rd n hn (compH (lin n) HC.YI HC.XI HC.hI q)))) ;
    line : Id (D.DK.DEl HC.YI L2.xI)
      (D.DK.dtact HC.YI HC.XI HC.hI L1.xI L2.xI eI L1.DCN[N].line) L2.DCN[N].line =
      L2.DCN[N].to-inj HC.YI L2.xI _ _ (\ n hn q ->
        transH (linerd n hn q) (transH LineVal[N, n, q].eq (symH (S2.DCS[N].line-rd n hn q)))) ;
    lineE : Id (TD.EI HC.YI) (TD.E.act HC.YI HC.XI HC.hI (L1.xI, L1.DCN[N].line)) (L2.xI, L2.DCN[N].line) =
      transH (TD.pr-tact HC.YI HC.XI HC.hI L1.xI L2.xI eI L1.DCN[N].line)
        (apH {D.DK.DEl HC.YI L2.xI} {TD.EI HC.YI} (\ v -> (L2.xI, v)) line) ;
    sqrd (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) S2.XII)
      : Id (TA.EI (lin n)) (D.rdId S2.XII S2.xII S2.DCS[N].sq n hn q) (S2.val2 N n q) =
      transH (symH (D.crd-toF S2.XII S2.xII S2.DCS[N].sq n hn q))
        (transH (apH (\ v -> D.crd S2.XII S2.xII v.1 n hn q) (D.to-from S2.XII S2.xII S2.DCS[N].w)) (S2.DCS[N].crdw n hn q)) ;
    square : Id (D.DK.DEl S2.XII S2.xII)
      (D.DK.dtact S2.XII S1.XII HCC.hI S1.xII S2.xII eII S1.DCS[N].sq) S2.DCS[N].sq =
      L2.DCN[N].to-inj S2.XII S2.xII _ _ (\ n hn q ->
        transH (S1.DCS[N].end-rd S2.XII S2.xII HCC.hI eII n hn q)
          (transH SquareVal[N, n, q].eq (symH (sqrd n hn q)))) ;
    squareE : Id (TD.EI S2.XII) (TD.E.act S2.XII S1.XII HCC.hI (S1.xII, S1.DCS[N].sq)) (S2.xII, S2.DCS[N].sq) =
      transH (TD.pr-tact S2.XII S1.XII HCC.hI S1.xII S2.xII eII S1.DCS[N].sq)
        (apH {D.DK.DEl S2.XII S2.xII} {TD.EI S2.XII} (\ v -> (S2.xII, v)) square) ;
    opaque linerd ; opaque line ; opaque lineE ; opaque sqrd ; opaque square ; opaque squareE ;
  } ;

  module H1 = CPostAssemble[a, l].Homotopy[G, A, c, X, x, z] ;
  module H2 = CPostAssemble[a, l].Homotopy[G, A, c, Y, y, R.RN.z'] ;

  etaII : Id (Hom S2.XII S2.XII) (pairH HC.YI Iv S2.XII (pr1 HC.YI Iv) (pr2 HC.YI Iv)) (idH S2.XII) =
    transH (apH (\ k -> pairH HC.YI Iv S2.XII k (pr2 HC.YI Iv)) (symH (comp-idr S2.XII HC.YI (pr1 HC.YI Iv))))
      (transH (apH (pairH HC.YI Iv S2.XII (compH S2.XII S2.XII HC.YI (pr1 HC.YI Iv) (idH S2.XII))) (symH (comp-idr S2.XII Iv (pr2 HC.YI Iv))))
        (pair-eta HC.YI Iv S2.XII (idH S2.XII))) ;
  nat : Id (W.Ix (P.L.tob HC.YI L2.xI))
    (P.L.tact HC.YI HC.XI HC.hI L1.xI L2.xI eI H1.line) H2.line =
    H1.H.Restrict[HC.YI, HC.hI, L2.xI, eI, H2.line, \ N -> At[N].line,
      \ N -> transH At[N].squareE (symH (PR.TyL[G, P.B N].PE.actId S2.XII (pairH HC.YI Iv S2.XII (pr1 HC.YI Iv) (pr2 HC.YI Iv)) etaII (S2.xII, S2.DCS[N].sq)))].eq ;
} ;
