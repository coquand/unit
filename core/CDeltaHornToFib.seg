-- CDeltaHornToFib.seg (L8, Delta, inside CClassical.Cl): model.tex
-- Theorem hornbox (2): a horn filling operation gives a fibration
-- structure.  In each direction the normalised fillers (CDNormE, with the
-- classical decision CDeltaHornBox.deg) are a filling structure at the
-- start; the composition is its other end (CLine.CompK.fromFill).
--
-- Quarry: seg/model DeltaFibIff (hornToFib).

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DHn = CDHornFib[a, lz] ;
module PFm = CDPrismFill[a, lz] ;

module HF (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (hf : DHn.DH[G, A].isFib) {
  module N01 = CDNormE[a, lz].NE[G, A, e0, zero, refl (leaf zero),
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot-pt,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot-nat,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot-S0,
    CDeltaHornBox[a, lz].HB1[G, A, e0].deg] ;
  module N10 = CDNormE[a, lz].NE[G, A, e1, suc zero, refl (leaf (suc zero)),
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot-pt,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot-nat,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot-S0,
    CDeltaHornBox[a, lz].HB1[G, A, e1].deg] ;

  fib : DB.CLine[lz].Lines[G, A].Fib =
    (DB.CLine[lz].Lines[G, A].CompK[e0, e1].fromFill N01.fibAt, DB.CLine[lz].Lines[G, A].CompK[e1, e0].fromFill N10.fibAt) ;
} ;

hornToFib (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (hf : DHn.DH[G, A].isFib) : DB.CLine[lz].Lines[G, A].Fib =
  HF[G, A, hf].fib ;
