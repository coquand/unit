-- Small decoding uses El0. Its lifted fibration is the one obtained
-- by decoding the included code in El1.
module S = DB.CSmall ;
module UC = CDUniverseCart[a] ;
module SP = CDSmallPi[a] ;

module Along (G : PCtx) (h : PSub[G, U0.UCtx]) {
  A : C.C.Ty G = Uv.lift-code G h ;
  T : PTy[G] = C.decode G A ;
  small : S.SPTy[G] =
    new S.SPTy[G, \ I x -> U0.fib0 I (h.nt I x), T.tact, T.tact-id, T.tact-o] ;

  module TG = P.TyL[G, T] ;
  module Up = CDCodeFib[a].Decode[G, A] ;

  ta (I : Nat) (x : TG.EI I) : UC.D.EI I = (h.nt I x.1, x.2) ;

  tn (J I : Nat) (f : Hom J I) (x : TG.EI I)
    : Id (UC.D.EI J) (UC.D.E.act J I f (ta I x)) (ta J (TG.E.act J I f x)) =
    UC.ti J (UC.D.E.act J I f (ta I x)) (ta J (TG.E.act J I f x)) (symH (h.nt-nat J I f x.1))
      (transH (symH (UC.tn J I f (ta I x))) (Up.tn J I f x)) ;

  ti (I : Nat) (x y : TG.EI I) (q : Id (TG.Pt I) x.1 y.1) (r : Id (UC.D.EI I) (ta I x) (ta I y)) : Id (TG.EI I) x y =
    Up.ti I x y q (apH (UC.ta I) r) ;

  module L = DB.CCartLaws2[a+, a+, a++].CC[G, T, U0.UCtx, U0.EGen, B.U1, B.El1,
    h.nt, h.nt-nat, ta, \ I x -> refl (h.nt I x.1), tn, ti, \ I x z -> z, \ I x z -> refl (h.nt I x, z),
    X.inc, X.include-nat, UC.ta, \ I x -> refl (X.inc I x.1), UC.tn, UC.ti, \ I x z -> z, \ I x z -> refl (X.inc I x, z)] ;

  module Eq = DB.CCartLaws2[a+, a++, a++].CG[G, T, B.U1, B.El1,
    L.s, L.s-nat, L.ta, L.tapt, L.tanat, L.tainj, L.bk, L.bkta,
    A.1, A.2, Up.ta, \ I v -> refl (A.1 I v.1), Up.tn, Up.ti, \ I x z -> z, \ I x z -> refl (A.1 I x, z),
    \ I x -> refl (A.1 I x), \ I v -> refl (Up.ta I v)] ;

  fib : N.Fib G T = L.C1.moveFib UF.fib0 ;
  smallFib : SP.SmallFib G = (small, fib) ;

  fib-law : Id (N.Fib G T) fib (Product.D.decode G A).2 =
    transH (apH L.C1.moveFib UF.restrict-fib)
      (transH (L.compFib UF.fib1) (Eq.congFib UF.fib1)) ;

  opaque fib-law ;
} ;
