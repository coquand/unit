-- CPosInst.seg (L8, posets): the base CB at posets (model.tex §8.1).  Every
-- generic construction (L2-L7) is now a member of PB: PB.CThm7, PB.CUaOp,
-- PB.CFibU3, ...
--
-- Quarry: seg/model PosS (PSB, PSCn, PSFa).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;

-- the interval as a presheaf (maps into [1]) and its end sieves
endS (W : Ob) (i : Hom W Iv) (e : El Iv) : SP.Phi W = SP.pre W Iv i (sptS e) ;
endPre (Y X : Ob) (g : Hom Y X) (i : Hom X Iv) (e : El Iv)
  : Id (SP.Phi Y) (SP.pre Y X g (endS X i e)) (endS Y (compH Y X Iv i g) e) =
  SP.phi-ext Y (SP.pre Y X g (endS X i e)) (endS Y (compH Y X Iv i g) e)
    (\ W f l -> SP.pre-lands W Y Iv (compH Y X Iv i g) (sptS e) f
       (substH (\ k -> SP.Lands W Iv (sptS e) k) (symH (comp-assoc W Y X Iv i g f))
          (SP.lands-pre W X Iv i (sptS e) (compH W Y X g f) (SP.lands-pre W Y X g (endS X i e) f l))))
    (\ W f l -> SP.pre-lands W Y X g (endS X i e) f
       (SP.pre-lands W X Iv i (sptS e) (compH W Y X g f)
          (substH (\ k -> SP.Lands W Iv (sptS e) k) (comp-assoc W Y X Iv i g f)
             (SP.lands-pre W Y Iv (compH Y X Iv i g) (sptS e) f l)))) ;
endPt (W : Ob) (e : El Iv) (g : Hom W Iv) (i : SP.Lands W W (endS W g e) (idH W)) : Id (Hom W Iv) g (constH W Iv e) =
  transH (symH (comp-idr W Iv g)) (slands-pt W e (compH W W Iv g (idH W)) (SP.lands-pre W W Iv g (sptS e) (idH W) i)) ;
ptEnd (W : Ob) (e : El Iv) : SP.Lands W W (endS W (constH W Iv e) e) (idH W) =
  SP.pre-lands W W Iv (constH W Iv e) (sptS e) (idH W)
    (substH (\ k -> SP.Lands W Iv (sptS e) k) (symH (comp-idr W Iv (constH W Iv e))) (spt-lands W e)) ;
endDisj (W : Ob) (g : Hom W Iv) (i : SP.Lands W W (endS W g e0) (idH W)) (i' : SP.Lands W W (endS W g e1) (idH W)) : Empty =
  spt-disj W (compH W W Iv g (idH W)) (SP.lands-pre W W Iv g (sptS e0) (idH W) i) (SP.lands-pre W W Iv g (sptS e1) (idH W) i') ;

module PB = CBase[a].CB[obV, homV, idH, compH, comp-idl, comp-idr, comp-assoc,
  \ X -> homV X Iv, \ Y X g i -> compH Y X Iv i g, \ X i -> comp-idr X Iv i, \ L K J g h i -> comp-assoc L K J Iv i g h,
  El Iv, e0, e1, \ X e -> constH X Iv e, constH-nat,
  SP.Phi, SP.pre, SP.Lands, SP.isProp-Lands, SP.lands-comp, SP.lands-pre, SP.pre-lands, SP.phi-ext,
  SP.emptyS, SP.empty-lands, SP.topS, SP.top-lands,
  endS, endPre, endPt, ptEnd, endDisj,
  SP.allS, SP.allS-sound, SP.allS-complete,
  SP.bigU, SP.bigU-in, SP.bigU-out,
  forallS, lands-forall, forall-lands,
  cIp, cIp-nat, cI-jsrc-t, cI-jsrc-f, cI-jtgt-t, cI-jtgt-f, cI-isrc-t, cI-isrc-f, cI-itgt-t, cI-itgt-f] ;

-- the interval of the poset base as an object, and its point sieves: the
-- form used by the files written at this base (PB.IvP W is Hom W ivO,
-- PB.endS W i e is PB.pre W ivO i (ptSO e), by definition)
ivO : Ob = Iv ;
ptSO (e : El Iv) : SP.Phi Iv = sptS e ;
lands-ptO (W : Ob) (e : El Iv) (g : Hom W Iv) (i : SP.Lands W Iv (sptS e) g) : Id (Hom W Iv) g (constH W Iv e) = slands-pt W e g i ;
pt-landsO (W : Ob) (e : El Iv) : SP.Lands W Iv (sptS e) (constH W Iv e) = spt-lands W e ;
pt-disjO (W : Ob) (g : Hom W Iv) (i : SP.Lands W Iv (sptS e0) g) (i' : SP.Lands W Iv (sptS e1) g) : Empty = spt-disj W g i i' ;
