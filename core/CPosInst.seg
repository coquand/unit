-- CPosInst.seg (L8, posets): the base CB at posets (model.tex §8.1).  Every
-- generic construction (L2-L7) is now a member of PB: PB.CThm7, PB.CUaOp,
-- PB.CFibU3, ...
--
-- Quarry: seg/model PosS (PSB, PSCn, PSFa).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;

module PB = CBase[a].CB[obV, homV, idH, compH, comp-idl, comp-idr, comp-assoc,
  Iv, El Iv, e0, e1, \ X e -> constH X Iv e, constH-nat,
  SP.Phi, SP.pre, SP.Lands, SP.isProp-Lands, SP.lands-comp, SP.lands-pre, SP.pre-lands, SP.phi-ext,
  SP.emptyS, SP.empty-lands, SP.topS, SP.top-lands,
  sptS, slands-pt, spt-lands, spt-disj,
  SP.allS, SP.allS-sound, SP.allS-complete,
  SP.bigU, SP.bigU-in, SP.bigU-out,
  forallS, lands-forall, forall-lands,
  cIp, cIp-nat, cI-jsrc-t, cI-jsrc-f, cI-jtgt-t, cI-jtgt-f, cI-isrc-t, cI-isrc-f, cI-itgt-t, cI-itgt-f] ;
