-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- Theorem 12.3 of poset-model.pdf: the boundary-filling hypothesis.
-- [n] has n+1 vertices.  Facets of [n+1] are indexed by y <= n+1.
-- For [1] their intersections are empty; for [n+2] the intersection of
-- facets y and z+1 (y <= z) is [n], with inclusions dl z and dl y.
-- SpheresBound is a CHOSEN filling operation, with no naturality assumed.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module CP = PB.CPartial[l] ;
module LD = CLocD[a, l] ;

module Bounds (G : PCtx) (A : PTy[G]) {
  open PR.TyL[G, A] ;
  Facets (n : Nat) (x : Pt (lin (suc n))) : U l =
    (y : Nat) -> IsT (leb y (suc n)) -> T (lin n) (G.act (lin n) (lin (suc n)) (dl n y) x) ;
  facetE (n : Nat) (x : Pt (lin (suc n))) (b : Facets n x) (y : Nat) (hy : IsT (leb y (suc n))) : EI (lin n) =
    (G.act (lin n) (lin (suc n)) (dl n y) x, b y hy) ;
  Overlap : (n : Nat) (x : Pt (lin (suc n))) -> Facets n x -> U l = split {
    zero -> \ x b -> Top ;
    suc n -> \ x b -> (y z : Nat) (yz : IsT (leb y z)) (hz : IsT (leb z (suc n))) ->
      Id (EI (lin n))
        (E.act (lin n) (lin (suc n)) (dl n z)
          (facetE (suc n) x b y (leb-trans y z (suc (suc n)) yz (leb-step z (suc n) hz))))
        (E.act (lin n) (lin (suc n)) (dl n y)
          (facetE (suc n) x b (suc z) hz)) } ;
  record SpheresBound {
    point (x : Pt (lin zero)) : T (lin zero) x ;
    fill (n : Nat) (x : Pt (lin (suc n))) (b : Facets n x) (c : Overlap n x b) : T (lin (suc n)) x ;
    face (n : Nat) (x : Pt (lin (suc n))) (b : Facets n x) (c : Overlap n x b)
      (y : Nat) (hy : IsT (leb y (suc n))) :
      Id (EI (lin n)) (E.act (lin n) (lin (suc n)) (dl n y) (x, fill n x b c)) (facetE n x b y hy) ;
  } ;
} ;

-- A partial DA-element, including its base point.  Packaging both makes
-- restriction functorial in ordinary (non-dependent) equality.
module Problems (G : PCtx) (A : PTy[G]) {
  module D = LD.DT[G, A] ;
  module TA = PR.TyL[G, A] ;
  module TD = PR.TyL[G, D.DA] ;
  module P = CP.Partials[G, D.DA] ;
  open TA ;
  Prob (X : Ob) : U l = (x : Pt X) * P.Side[X, x] ;
  resP (Y X : Ob) (h : Hom Y X) (b : Prob X) : Prob Y =
    (G.act Y X h b.1, P.rside Y X h b.1 b.2) ;
  resP-o (Z Y X : Ob) (g : Hom Z Y) (h : Hom Y X) (b : Prob X)
    : Id (Prob Z) (resP Z X (compH Z Y X h g) b) (resP Z Y g (resP Y X h b)) =
    Sigma-path (Pt Z) (\ z -> P.Side[Z, z]) _ _ _ _ (G.act-o Z Y X h g b.1) (P.rside-o Z Y X g h b.1 b.2) ;
  resP-id (X : Ob) (b : Prob X) : Id (Prob X) (resP X X (idH X) b) b =
    Sigma-path (Pt X) (\ z -> P.Side[X, z]) _ _ _ _ (G.act-id X b.1) (P.rside-id X b.1 b.2) ;
  resP-sq (Z Y Y' X : Ob) (g : Hom Z Y) (h : Hom Y X) (g' : Hom Z Y') (h' : Hom Y' X)
    (q : Id (Hom Z X) (compH Z Y X h g) (compH Z Y' X h' g')) (b : Prob X)
    : Id (Prob Z) (resP Z Y g (resP Y X h b)) (resP Z Y' g' (resP Y' X h' b)) =
    transH (symH (resP-o Z Y X g h b))
      (transH (apH (\ k -> resP Z X k b) q) (resP-o Z Y' X g' h' b)) ;
  opaque resP-o ; opaque resP-id ; opaque resP-sq ;

  read (X : Ob) (v : TD.EI X) (n : Nat) (f : Hom (lin n) X) : EI (lin n) = D.rd X v.1 v.2.1 n f ;
  read-act (Y X : Ob) (h : Hom Y X) (v : TD.EI X) (n : Nat) (f : Hom (lin n) Y)
    : Id (EI (lin n)) (read Y (TD.E.act Y X h v) n f) (read X v n (compH (lin n) Y X h f)) =
    D.rd-dtact Y X h v.1 (G.act Y X h v.1) (refl (G.act Y X h v.1)) v.2 n f ;
  read-ext (X : Ob) (v w : TD.EI X) (p : Id (Pt X) v.1 w.1)
    (q : (n : Nat) (f : Hom (lin n) X) -> Id (EI (lin n)) (read X v n f) (read X w n f)) : Id (TD.EI X) v w =
    idJ (Pt X) v.1 (\ x e -> (u : TD.T X x) ->
       ((n : Nat) (f : Hom (lin n) X) -> Id (EI (lin n)) (read X v n f) (read X (x,u) n f)) -> Id (TD.EI X) v (x,u))
      (\ u r -> apH {TD.T X v.1} {TD.EI X} (\ t -> (v.1,t)) (D.Dext X v.1 v.2 u r)) w.1 p w.2 q ;
  opaque read-act ; opaque read-ext ;

  fullB (n : Nat) (b : Prob (lin n)) : Bool = b.2.pQ.1 (lin n) (idH (lin n)) ;
  ev (n : Nat) (v : TD.EI (lin n)) : EI (lin n) = read (lin n) v n (idH (lin n)) ;
  raw (n : Nat) (b : Prob (lin n)) (i : IsT (fullB n b)) : EI (lin n) = ev n (b.2.pv (lin n) (idH (lin n)) i) ;
  raw-pt (n : Nat) (b : Prob (lin n)) (i : IsT (fullB n b)) : Id (Pt (lin n)) (raw n b i).1 b.1 =
    transH (G.act-id (lin n) (b.2.pv (lin n) (idH (lin n)) i).1)
      (transH (b.2.ppt (lin n) (idH (lin n)) i) (G.act-id (lin n) b.1)) ;
  forced (n : Nat) (b : Prob (lin n)) (i : IsT (fullB n b)) : T (lin n) b.1 = fromE (lin n) b.1 (raw n b i) (raw-pt n b i) ;
  forced-eq (n : Nat) (b : Prob (lin n)) (i : IsT (fullB n b)) : Id (EI (lin n)) (b.1, forced n b i) (raw n b i) =
    fromE-eq (lin n) b.1 (raw n b i) (raw-pt n b i) ;

  side-read (X : Ob) (b : Prob X) (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X b.2.pQ f)
    (n : Nat) (g : Hom (lin n) Y) (j : PB.Lands (lin n) X b.2.pQ (compH (lin n) Y X f g))
    : Id (EI (lin n)) (ev n (b.2.pv (lin n) (compH (lin n) Y X f g) j)) (read Y (b.2.pv Y f i) n g) =
    transH (apH (ev n) (symH (b.2.pnat (lin n) Y g f i j)))
      (transH (read-act (lin n) Y g v n (idH (lin n))) (apH (read Y v n) (comp-idr (lin n) Y g)))
    where { v : TD.EI Y = b.2.pv Y f i ; } ;

  land-res (n : Nat) (X : Ob) (f : Hom (lin n) X) (b : Prob X) (i : PB.Lands (lin n) X b.2.pQ f)
    : IsT (fullB n (resP (lin n) X f b)) =
    substH (\ k -> PB.Lands (lin n) X b.2.pQ k) (symH (comp-idr (lin n) X f)) i ;
  forced-res (n : Nat) (X : Ob) (f : Hom (lin n) X) (b : Prob X)
    (i : PB.Lands (lin n) X b.2.pQ f) (j : IsT (fullB n (resP (lin n) X f b)))
    : Id (EI (lin n)) ((resP (lin n) X f b).1, forced n (resP (lin n) X f b) j) (ev n (b.2.pv (lin n) f i)) =
    transH (forced-eq n (resP (lin n) X f b) j)
      (apH (ev n) (P.pv-hom X b.1 b.2 (lin n) (compH (lin n) (lin n) X f (idH (lin n))) f (comp-idr (lin n) X f) j i)) ;
  full-at (n : Nat) (b : Prob (lin n)) (i : IsT (fullB n b)) (Y : Ob) (f : Hom Y (lin n))
    : PB.Lands Y (lin n) b.2.pQ f =
    substH (\ k -> PB.Lands Y (lin n) b.2.pQ k) (comp-idl Y (lin n) f)
      (PB.lands-comp Y (lin n) (lin n) b.2.pQ (idH (lin n)) f i) ;
  forced-face (n : Nat) (b : Prob (lin (suc n))) (i : IsT (fullB (suc n) b)) (y : Nat) (hy : IsT (leb y (suc n)))
    (j : IsT (fullB n (resP (lin n) (lin (suc n)) (dl n y) b)))
    : Id (EI (lin n)) (E.act (lin n) (lin (suc n)) (dl n y) (b.1, forced (suc n) b i))
        ((resP (lin n) (lin (suc n)) (dl n y) b).1, forced n (resP (lin n) (lin (suc n)) (dl n y) b) j) =
    transH (apH (E.act (lin n) (lin (suc n)) (dl n y)) (forced-eq (suc n) b i))
      (transH (v.2.2 n (suc n) (dl n y) (dl-strict n y) (idH (lin (suc n))))
        (transH (apH (read (lin (suc n)) v n) (comp-idl (lin n) (lin (suc n)) (dl n y)))
        (transH (symH (side-read (lin (suc n)) b (lin (suc n)) (idH (lin (suc n))) i n (dl n y) k))
          (transH (apH (ev n) (P.pv-hom (lin (suc n)) b.1 b.2 (lin n) _ _ (comp-idl (lin n) (lin (suc n)) (dl n y)) k i'))
            (symH (forced-res n (lin (suc n)) (dl n y) b i' j))))))
    where {
      v : TD.EI (lin (suc n)) = b.2.pv (lin (suc n)) (idH (lin (suc n))) i ;
      k : PB.Lands (lin n) (lin (suc n)) b.2.pQ (compH (lin n) (lin (suc n)) (lin (suc n)) (idH (lin (suc n))) (dl n y)) =
        PB.lands-comp (lin n) (lin (suc n)) (lin (suc n)) b.2.pQ (idH (lin (suc n))) (dl n y) i ;
      i' : PB.Lands (lin n) (lin (suc n)) b.2.pQ (dl n y) = full-at (suc n) b i (lin n) (dl n y) ;
    } ;
  opaque side-read ; opaque forced-res ; opaque forced-face ;
} ;
