-- CDeltaCl.seg (L8, Delta): horns and the classifier (model.tex §8.2,
-- Definition "horn filling").  faceS m y: the maps into [m+1] missing y;
-- hornS m k: the horn, one decidable sieve; Cl = isFib = the generic
-- classifier of filling operations (COpCl) at the family of horns; the
-- universe of Delta.  Constructive.
--
-- Quarry: seg/model DeltaHorn, DeltaClassifier.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
module PBs = CPosBase[a] ;
module DBs = CDeltaBase[a] ;
module DB = DBs.DB ;

------------------------------------------------------------------------
-- faces and horns

-- the vertices of [m+1] other than y
missQ (m y : Nat) : Subset (lin (suc m)) = \ t -> not (eqN (vnum t.1) y) ;

-- the maps missing y (on the poset side this is Simp.Miss, by definition)
faceS (m y : Nat) : DBs.DS.Phi (suc m) = DBs.subS (suc m) (lin (suc m)) (idH (lin (suc m))) (missQ m y) ;

face-miss (V m y : Nat) (g : Hom (lin V) (lin (suc m))) (i : DBs.DS.Lands V (suc m) (faceS m y) g) : Miss (lin V) m y g =
  PBs.plands-eq (lin V) (lin (suc m)) (missQ m y) (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g) g
    (comp-idl (lin V) (lin (suc m)) g)
    (PBs.isIn-sound (lin V) (lin (suc m)) (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g) (missQ m y) i) ;

miss-face (V m y : Nat) (g : Hom (lin V) (lin (suc m))) (ms : Miss (lin V) m y g) : DBs.DS.Lands V (suc m) (faceS m y) g =
  PBs.isIn-complete (lin V) (lin (suc m)) (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g) (missQ m y)
    (PBs.plands-eq (lin V) (lin (suc m)) (missQ m y) g (compH (lin V) (lin (suc m)) (lin (suc m)) (idH (lin (suc m))) g)
       (symH (comp-idl (lin V) (lin (suc m)) g)) ms) ;

-- the face y counts for the horn at k when y /= k
hfB (m k : Nat) (V : Nat) (g : Hom (lin V) (lin (suc m))) (y : Nat) : Bool = and (not (eqN y k)) ((faceS m y).1 V g) ;

hornS (m k : Nat) : DBs.DS.Phi (suc m) =
  (\ V g -> existsUp (suc m) (hfB m k V g),
   \ V' V g h i ->
     ex-i (suc m) (hfB m k V' (compH (lin V') (lin V) (lin (suc m)) g h)) (ex-e (suc m) (hfB m k V g) i).1
       (ex-e (suc m) (hfB m k V g) i).2.1
       (and-i (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k))
              ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V' (compH (lin V') (lin V) (lin (suc m)) g h))
          (and-l (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
             (ex-e (suc m) (hfB m k V g) i).2.2)
          ((faceS m (ex-e (suc m) (hfB m k V g) i).1).2 V' V g h
             (and-r (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
                (ex-e (suc m) (hfB m k V g) i).2.2)))) ;

-- a map missing a face y /= k lands in the horn
lands-horn (V m k y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k)))
  (g : Hom (lin V) (lin (suc m))) (ms : Miss (lin V) m y g) : DBs.DS.Lands V (suc m) (hornS m k) g =
  ex-i (suc m) (hfB m k V g) y hy (and-i (not (eqN y k)) ((faceS m y).1 V g) ky (miss-face V m y g ms)) ;

-- a map in the horn misses a face y /= k
HornWit (V m k : Nat) (g : Hom (lin V) (lin (suc m))) : U a =
  (y : Nat) * (IsT (leb y (suc m)) * (IsT (not (eqN y k)) * Miss (lin V) m y g)) ;

horn-lands (V m k : Nat) (g : Hom (lin V) (lin (suc m))) (i : DBs.DS.Lands V (suc m) (hornS m k) g) : HornWit V m k g =
  ((ex-e (suc m) (hfB m k V g) i).1,
   ((ex-e (suc m) (hfB m k V g) i).2.1,
    (and-l (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
       (ex-e (suc m) (hfB m k V g) i).2.2,
     face-miss V m (ex-e (suc m) (hfB m k V g) i).1 g
       (and-r (not (eqN (ex-e (suc m) (hfB m k V g) i).1 k)) ((faceS m (ex-e (suc m) (hfB m k V g) i).1).1 V g)
          (ex-e (suc m) (hfB m k V g) i).2.2)))) ;

opaque hornS ;

------------------------------------------------------------------------
-- the classifier: horn filling operations

HIx : U a = (m : Nat) * Nat ;
hOk (i : HIx) : U a = IsT (leb i.2 (suc i.1)) ;
hOb (i : HIx) : Nat = suc i.1 ;
hS (i : HIx) : DBs.DS.Phi (hOb i) = hornS i.1 i.2 ;

encHIx : Encode[a, a+].Enc HIx =
  Encode[a, a+].encSig Nat (\ m -> Nat) (Encode[a, a+].encIx0 W0.natV) (\ m -> Encode[a, a+].encIx0 W0.natV) ;

module CL = DB.COpCl.OC[HIx, hOk, hOb, hS, encHIx, \ i -> isProp-IsT' (leb i.2 (suc i.1))] ;

-- the universe of Delta
module DU = DB.CUniv.Univ[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl] ;
