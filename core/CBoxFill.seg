-- CBoxFill.seg (L9): prisms over a poset (postnikov.tex, Lemma box).
--
-- A is a type over the posets with face-uniform fillers on i*A at the end e
-- (CDFill: fill, sides, face, as in CLocComp.CO).  X is a poset with a
-- height (CBoxEZ), x a point of G at X.  A prism problem over X is
--
--   a0 W g      the lid: a map X -> i*A over x, natural along all maps
--   Q , sv      a sieve of X and a map Q * [1] -> i*A over x, natural, equal
--               to a0 at the end e (sve)
--
-- and BF builds a map X * [1] -> i*A extending it:
--
--   prob n c    the problem read along c : [n] -> X (the constant line at
--               x, the lid read at c, the side on the sieve c^* Q)
--   RS.res      read along c then restricted along any h : the problem at c h
--   fl n c      its filler (CDFill); along strict maps fl n c restricts to
--               fl at the composite (CFacesGen from the face property)
--   Fv W g j    the value at (g , j) : [W] -> X * [1]: with g = c sgm
--               (CBoxEZ), the line of fl r c at (sgm , j)
--   Fp, Fn      over x, natural along every map of Delta
--   Fe, Fs      it is the lid at e, and the side on Q

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module DB = CDeltaBase[a].DB ;
module DS = CDeltaBase[a].DS ;
module SP = CPosBase[a].SP ;
module CP = CLocCompP[a, l] ;
module EZ = CBoxEZ[a] ;

module BF (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].resP N' (suc N') (dl N' y) b)))
  (X : Ob) (ht : El X -> Nat) (B : Nat) (hB : (x : El X) -> IsT (leb (ht x) B))
  (hm : (x y : El X) -> IsT (le X x.1 y.1) -> IsT (leb (ht x) (ht y)))
  (hi : (x y : El X) -> IsT (le X x.1 y.1) -> Id Nat (ht x) (ht y) -> Id Tree x.1 y.1)
  (x : W0.Ix (G.ob X))
  (a0 : (W : Nat) -> Hom (lin W) X -> PB.GPre[l].TyL[G, A].EI (lin W))
  (a0p : (W : Nat) (g : Hom (lin W) X) -> Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) X g x))
  (a0n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) X g h)))
  (Q : SP.Phi X)
  (sv : (W : Nat) (g : Hom (lin W) X) -> SP.Lands (lin W) X Q g -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (svp : (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (sv W g i j).1 (G.act (lin W) X g x))
  (svn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
         (i' : SP.Lands (lin V) X Q (compH (lin V) (lin W) X g h)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (sv W g i j))
                                                  (sv V (compH (lin V) (lin W) X g h) i' (compH (lin V) (lin W) Iv j h)))
  (sve : (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (sv W g i (constH (lin W) Iv e)) (a0 W g)) {
  module RG = CLocRestr[a, l].R[G] ;
  module RA = RG.T[A] ;
  module SAD = CDStageA[a, l].SA[RG.iG, RA.iA, e] ;
  module KAD = SAD.KA ;
  module FTD = SAD.FT ;
  module TA = PB.GPre[l].TyL[G, A] ;

  -- a side value depends only on the map
  sv-eq (W : Nat) (g g' : Hom (lin W) X) (p : Id (Hom (lin W) X) g g') (i : SP.Lands (lin W) X Q g) (i' : SP.Lands (lin W) X Q g')
    (j : Hom (lin W) Iv) : Id (TA.EI (lin W)) (sv W g i j) (sv W g' i' j) =
    idJ (Hom (lin W) X) g (\ g2 p2 -> (i2 : SP.Lands (lin W) X Q g2) -> Id (TA.EI (lin W)) (sv W g i j) (sv W g2 i2 j))
      (\ i2 -> apH (\ q -> sv W g q j) (SP.isProp-Lands (lin W) X Q g i i2)) g' p i' ;

  ----------------------------------------------------------------------
  -- the problem read along c : [n] -> X

  L0 (n : Nat) (c : Hom (lin n) X) : W0.Ix (RG.FD.ob n) = RG.rdG X n c (RG.FP.constF X x) ;

  x0 (n : Nat) (c : Hom (lin n) X) : KAD.TV.EI n =
    (L0 n c,
     TA.fromE (lin n) (G.act (lin n) X (compH (lin n) (lin n) X c (idH (lin n))) x) (a0 n c)
       (transH (a0p n c) (apH (\ k -> G.act (lin n) X k x) (symH (comp-idr (lin n) X c))))) ;

  x0-end (n : Nat) (c : Hom (lin n) X) : Id (TA.EI (lin n)) (KAD.endE n (x0 n c)) (a0 n c) =
    TA.fromE-eq (lin n) (G.act (lin n) X (compH (lin n) (lin n) X c (idH (lin n))) x) (a0 n c)
       (transH (a0p n c) (apH (\ k -> G.act (lin n) X k x) (symH (comp-idr (lin n) X c)))) ;

  Qc (n : Nat) (c : Hom (lin n) X) : DS.Phi n = CP.qD X n c Q ;

  module At (n : Nat) (c : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n (Qc n c) g) {
    xg : W0.Ix (FTD.FG.ob W) = (KAD.TV.E.act W n g (x0 n c)).1 ;

    lc (V : Nat) (g' : Hom (lin V) (lin W)) : SP.Lands (lin V) X Q (compH (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g')) =
      (Qc n c).2 V W g g' i ;

    t (V : Nat) (g' : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) : TA.EI (lin V) =
      sv V (compH (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g')) (lc V g') j ;

    tp (V : Nat) (g' : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) : Id (W0.Ix (G.ob (lin V))) (t V g' j).1 (xg.1 V g' j) =
      svp V (compH (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g')) (lc V g') j ;

    tn (V' V : Nat) (g'' : Hom (lin V') (lin V)) (g' : Hom (lin V) (lin W)) (j : Hom (lin V) Iv)
      : Id (TA.EI (lin V')) (TA.E.act (lin V') (lin V) g'' (t V g' j)) (t V' (compH (lin V') (lin V) (lin W) g' g'') (compH (lin V') (lin V) Iv j g'')) =
      transH (svn V' V g'' (compH (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g')) (lc V g')
                (SP.lands-comp (lin V') (lin V) X Q (compH (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g')) g'' (lc V g')) j)
        (sv-eq V' _ _
           (transH (comp-assoc (lin V') (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g') g'')
                   (apH (compH (lin V') (lin n) X c) (comp-assoc (lin V') (lin V) (lin W) (lin n) g g' g'')))
           _ (lc V' (compH (lin V') (lin V) (lin W) g' g'')) (compH (lin V') (lin V) Iv j g'')) ;

    L : KAD.TL.EI W = (xg, FTD.lamA W xg t tp tn) ;

    q : Id (TA.EI (lin W)) (KAD.endE W (FTD.Ev[e].evA.mE W L)) (KAD.endE W (KAD.TV.E.act W n g (x0 n c))) =
      calc (TA.EI (lin W)) {
          KAD.endE W (FTD.Ev[e].evA.mE W L)
        =< SAD.endL-lev W L >
          t W (idH (lin W)) (constH (lin W) Iv e)
        =< sve W (compH (lin W) (lin n) X c (compH (lin W) (lin W) (lin n) g (idH (lin W)))) (lc W (idH (lin W))) >
          a0 W (compH (lin W) (lin n) X c (compH (lin W) (lin W) (lin n) g (idH (lin W))))
        =< apH (\ k -> a0 W (compH (lin W) (lin n) X c k)) (comp-idr (lin W) (lin n) g) >
          a0 W (compH (lin W) (lin n) X c g)
        =< symH (a0n W n g c) >
          TA.E.act (lin W) (lin n) g (a0 n c)
        =< symH (apH (TA.E.act (lin W) (lin n) g) (x0-end n c)) >
          TA.E.act (lin W) (lin n) g (KAD.endE n (x0 n c))
        =< symH (KAD.endE-act W n g (x0 n c)) >
          KAD.endE W (KAD.TV.E.act W n g (x0 n c)) } ;

    u : KAD.TS.EI W = KAD.mkTS W (KAD.TV.E.act W n g (x0 n c)) L (refl xg) q ;
    opaque tp ; opaque tn ; opaque q ;
  } ;

  pv (n : Nat) (c : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n (Qc n c) g) : KAD.TS.EI W = At[n, c, W, g, i].u ;

  ppt (n : Nat) (c : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (i : DS.Lands W n (Qc n c) g)
    : Id (KAD.TV.EI W) (pv n c W g i).1 (KAD.TV.E.act W n g (x0 n c)) =
    KAD.mkTS-pt W (KAD.TV.E.act W n g (x0 n c)) At[n, c, W, g, i].L (refl At[n, c, W, g, i].xg) At[n, c, W, g, i].q ;

  pnat (n : Nat) (c : Hom (lin n) X) (W' W : Nat) (chi : Hom (lin W') (lin W)) (g : Hom (lin W) (lin n)) (i : DS.Lands W n (Qc n c) g)
    (i' : DS.Lands W' n (Qc n c) (compH (lin W') (lin W) (lin n) g chi))
    : Id (KAD.TS.EI W') (KAD.TS.E.act W' W chi (pv n c W g i)) (pv n c W' (compH (lin W') (lin W) (lin n) g chi) i') =
    KAD.mkTS-act W' W chi (KAD.TV.E.act W n g (x0 n c)) At[n, c, W, g, i].L (refl At[n, c, W, g, i].xg) At[n, c, W, g, i].q
      (KAD.TV.E.act W' n (compH (lin W') (lin W) (lin n) g chi) (x0 n c)) At[n, c, W', compH (lin W') (lin W) (lin n) g chi, i'].L
      (refl At[n, c, W', compH (lin W') (lin W) (lin n) g chi, i'].xg) At[n, c, W', compH (lin W') (lin W) (lin n) g chi, i'].q
      (symH (KAD.TV.E.act-o W' W n g chi (x0 n c)))
      (\ V'' g'' j -> sv-eq V'' _ _
          (apH (compH (lin V'') (lin n) X c) (symH (comp-assoc (lin V'') (lin W') (lin W) (lin n) g chi g'')))
          (At[n, c, W, g, i].lc V'' (compH (lin V'') (lin W') (lin W) chi g''))
          (At[n, c, W', compH (lin W') (lin W) (lin n) g chi, i'].lc V'' g'') j) ;

  side (n : Nat) (c : Hom (lin n) X) : KAD.PT.Side[n, x0 n c] = new KAD.PT.Side[n, x0 n c, Qc n c, pv n c, ppt n c, pnat n c] ;

  prob (n : Nat) (c : Hom (lin n) X) : SAD.Prob n = (x0 n c, side n c) ;
  opaque x0-end ; opaque ppt ; opaque pnat ;

  ----------------------------------------------------------------------
  -- read along c, restricted along any h : the problem at c h

  module RS (m n : Nat) (c : Hom (lin n) X) (h : Hom (lin m) (lin n)) {
    ch : Hom (lin m) X = compH (lin m) (lin n) X c h ;

    x-eq : Id (KAD.TV.EI m) (KAD.TV.E.act m n h (x0 n c)) (x0 m ch) =
      KAD.tv-eq m (KAD.TV.E.act m n h (x0 n c)) (x0 m ch) (RG.rdG-act X m n h c (RG.FP.constF X x))
        (calc (TA.EI (lin m)) {
            KAD.endE m (KAD.TV.E.act m n h (x0 n c))
          =< KAD.endE-act m n h (x0 n c) >
            TA.E.act (lin m) (lin n) h (KAD.endE n (x0 n c))
          =< apH (TA.E.act (lin m) (lin n) h) (x0-end n c) >
            TA.E.act (lin m) (lin n) h (a0 n c)
          =< a0n m n h c >
            a0 m ch
          =< symH (x0-end m ch) >
            KAD.endE m (x0 m ch) }) ;

    q-eq : Id (DS.Phi m) (DS.pre m n h (Qc n c)) (Qc m ch) =
      DS.phi-ext m (DS.pre m n h (Qc n c)) (Qc m ch)
        (\ W g i -> CPosBase[a].slands-hom (lin W) X Q (compH (lin W) (lin n) X c (compH (lin W) (lin m) (lin n) h g)) (compH (lin W) (lin m) X ch g)
                      (symH (comp-assoc (lin W) (lin m) (lin n) X c h g)) i)
        (\ W g i -> CPosBase[a].slands-hom (lin W) X Q (compH (lin W) (lin m) X ch g) (compH (lin W) (lin n) X c (compH (lin W) (lin m) (lin n) h g))
                      (comp-assoc (lin W) (lin m) (lin n) X c h g) i) ;

    pv-eq (W : Nat) (g : Hom (lin W) (lin m)) (i : DS.Lands W m (DS.pre m n h (Qc n c)) g) (i' : DS.Lands W m (Qc m ch) g)
      : Id (KAD.TS.EI W) (pv n c W (compH (lin W) (lin m) (lin n) h g) i) (pv m ch W g i') =
      KAD.mkTS-eq W (KAD.TV.E.act W n (compH (lin W) (lin m) (lin n) h g) (x0 n c)) (KAD.TV.E.act W m g (x0 m ch))
        At[n, c, W, compH (lin W) (lin m) (lin n) h g, i].L At[m, ch, W, g, i'].L
        (refl At[n, c, W, compH (lin W) (lin m) (lin n) h g, i].xg) At[n, c, W, compH (lin W) (lin m) (lin n) h g, i].q
        (refl At[m, ch, W, g, i'].xg) At[m, ch, W, g, i'].q
        (transH (KAD.TV.E.act-o W m n h g (x0 n c)) (apH (KAD.TV.E.act W m g) x-eq))
        (\ V g' j -> sv-eq V _ _
           (transH (apH (compH (lin V) (lin n) X c) (comp-assoc (lin V) (lin W) (lin m) (lin n) h g g'))
                   (symH (comp-assoc (lin V) (lin m) (lin n) X c h (compH (lin V) (lin W) (lin m) g g'))))
           (At[n, c, W, compH (lin W) (lin m) (lin n) h g, i].lc V g') (At[m, ch, W, g, i'].lc V g') j) ;

    res : Id (SAD.Prob m) (SAD.resP m n h (prob n c)) (prob m ch) =
      Sigma-path (KAD.TV.EI m) (\ z -> KAD.PT.Side[m, z])
        (KAD.TV.E.act m n h (x0 n c)) (x0 m ch) (KAD.PT.rside m n h (x0 n c) (side n c)) (side m ch) x-eq
        (KAD.PT.side-extH m (KAD.TV.E.act m n h (x0 n c)) (x0 m ch) x-eq (KAD.PT.rside m n h (x0 n c) (side n c)) (side m ch) q-eq pv-eq) ;
    opaque x-eq ; opaque q-eq ; opaque pv-eq ; opaque res ;
  } ;

  ----------------------------------------------------------------------
  -- the filled prisms, natural along strict maps

  fl (n : Nat) (c : Hom (lin n) X) : KAD.TS.EI n = SAD.fillE n (fill n) (prob n c) ;

  fc (n : Nat) (c : Hom (lin (suc n)) X) (y : Nat) (hy : IsT (leb y (suc n)))
    : Id (KAD.TS.EI n) (KAD.TS.E.act n (suc n) (dl n y) (fl (suc n) c)) (fl n (compH (lin n) (lin (suc n)) X c (dl n y))) =
    transH (face n (prob (suc n) c) y hy) (apH (SAD.fillE n (fill n)) RS[n, suc n, c, dl n y].res) ;

  module SGm = CFacesGen[a, l].SG[KAD.TS.E, X, fl, fc] ;

  ----------------------------------------------------------------------
  -- the map X * [1] -> i*A

  module Ft (W : Nat) (g : Hom (lin W) X) {
    module Z = EZ.EZX[X, ht, B, hB, hm, hi, W, g] ;
    u : KAD.TS.EI Z.r = fl Z.r Z.c ;
    val (j : Hom (lin W) Iv) : TA.EI (lin W) = SAD.lv Z.r u W Z.sgm j ;
  } ;

  Fv (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : TA.EI (lin W) = Ft[W, g].val j ;

  Fp (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (Fv W g j).1 (G.act (lin W) X g x) =
    transH (SAD.lv-pt Ft[W, g].Z.r Ft[W, g].u W Ft[W, g].Z.sgm j)
           (apH (\ k -> G.act (lin W) X k x) Ft[W, g].Z.fac) ;

  module FN (V W : Nat) (k : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv) {
    module K = EZ.EZXK[X, ht, B, hB, hm, hi, W, V, g, k] ;
    r1 : Nat = K.Z1.r ;
    r2 : Nat = K.Z2.r ;
    jk : Hom (lin V) Iv = compH (lin V) (lin W) Iv j k ;

    res : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) k (Fv W g j)) (Fv V (compH (lin V) (lin W) X g k) jk) =
      calc (TA.EI (lin V)) {
          TA.E.act (lin V) (lin W) k (SAD.lv r1 (fl r1 K.Z1.c) W K.Z1.sgm j)
        =< SAD.lv-nat r1 (fl r1 K.Z1.c) V W k K.Z1.sgm j >
          SAD.lv r1 (fl r1 K.Z1.c) V (compH (lin V) (lin W) (lin r1) K.Z1.sgm k) jk
        =< apH (\ q -> SAD.lv r1 (fl r1 K.Z1.c) V q jk) K.muEq >
          SAD.lv r1 (fl r1 K.Z1.c) V (compH (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm) jk
        =< symH (SAD.lv-act r2 r1 K.mu (fl r1 K.Z1.c) V K.Z2.sgm jk) >
          SAD.lv r2 (KAD.TS.E.act r2 r1 K.mu (fl r1 K.Z1.c)) V K.Z2.sgm jk
        =< apH (\ w -> SAD.lv r2 w V K.Z2.sgm jk) (transH (SGm.fg r1 r2 K.mu K.muStrict K.Z1.c) (apH (fl r2) K.cmu)) >
          SAD.lv r2 (fl r2 K.Z2.c) V K.Z2.sgm jk } ;
  } ;

  Fn (V W : Nat) (k : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) k (Fv W g j)) (Fv V (compH (lin V) (lin W) X g k) (compH (lin V) (lin W) Iv j k)) =
    FN[V, W, k, g, j].res ;

  -- at the end e it is the lid
  Fe (W : Nat) (g : Hom (lin W) X) : Id (TA.EI (lin W)) (Fv W g (constH (lin W) Iv e)) (a0 W g) =
    calc (TA.EI (lin W)) {
        SAD.lv r u W sgm (constH (lin W) Iv e)
      =< apH (\ q -> SAD.lv r u W q (constH (lin W) Iv e)) (symH (comp-idl (lin W) (lin r) sgm)) >
        SAD.lv r u W (compH (lin W) (lin r) (lin r) (idH (lin r)) sgm) (constH (lin W) Iv e)
      =< apH (\ q -> SAD.lv r u W (compH (lin W) (lin r) (lin r) (idH (lin r)) sgm) q) (symH (constH-nat (lin W) (lin r) sgm e)) >
        SAD.lv r u W (compH (lin W) (lin r) (lin r) (idH (lin r)) sgm) (compH (lin W) (lin r) Iv (constH (lin r) Iv e) sgm)
      =< symH (SAD.lv-nat r u W r sgm (idH (lin r)) (constH (lin r) Iv e)) >
        TA.E.act (lin W) (lin r) sgm (SAD.lv r u r (idH (lin r)) (constH (lin r) Iv e))
      =< apH (TA.E.act (lin W) (lin r) sgm) (SAD.lv-end r u) >
        TA.E.act (lin W) (lin r) sgm (KAD.endE r (x0 r Ft[W, g].Z.c))
      =< apH (TA.E.act (lin W) (lin r) sgm) (x0-end r Ft[W, g].Z.c) >
        TA.E.act (lin W) (lin r) sgm (a0 r Ft[W, g].Z.c)
      =< a0n W r sgm Ft[W, g].Z.c >
        a0 W (compH (lin W) (lin r) X Ft[W, g].Z.c sgm)
      =< apH (a0 W) Ft[W, g].Z.fac >
        a0 W g }
   where { r : Nat = Ft[W, g].Z.r ;
           u : KAD.TS.EI Ft[W, g].Z.r = Ft[W, g].u ;
           sgm : Hom (lin W) (lin Ft[W, g].Z.r) = Ft[W, g].Z.sgm ; } ;

  -- on Q it is the side
  module FS (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv) {
    module Z = Ft[W, g].Z ;
    r : Nat = Z.r ;
    ic : SP.Lands (lin r) X Q Z.c = SP.lands-comp (lin r) (lin W) X Q g Z.sec i ;
    i0 : DS.Lands r r (Qc r Z.c) (idH (lin r)) = SP.lands-comp (lin r) (lin r) X Q Z.c (idH (lin r)) ic ;

    res : Id (TA.EI (lin W)) (Fv W g j) (sv W g i j) =
      calc (TA.EI (lin W)) {
          SAD.lv r (fl r Z.c) W Z.sgm j
        =< apH (\ q -> SAD.lv r (fl r Z.c) W q j) (symH (comp-idl (lin W) (lin r) Z.sgm)) >
          SAD.lv r (fl r Z.c) W (compH (lin W) (lin r) (lin r) (idH (lin r)) Z.sgm) j
        =< symH (SAD.lv-act r r (idH (lin r)) (fl r Z.c) W Z.sgm j) >
          SAD.lv r (KAD.TS.E.act r r (idH (lin r)) (fl r Z.c)) W Z.sgm j
        =< apH (\ w -> SAD.lv r w W Z.sgm j) (sides r (prob r Z.c) r (idH (lin r)) i0) >
          SAD.lv r (pv r Z.c r (idH (lin r)) i0) W Z.sgm j
        =< SAD.mkTS-lev r (KAD.TV.E.act r r (idH (lin r)) (x0 r Z.c)) At[r, Z.c, r, idH (lin r), i0].L
             (refl At[r, Z.c, r, idH (lin r), i0].xg) At[r, Z.c, r, idH (lin r), i0].q W Z.sgm j >
          At[r, Z.c, r, idH (lin r), i0].t W Z.sgm j
        =< sv-eq W _ g
             (transH (apH (compH (lin W) (lin r) X Z.c) (comp-idl (lin W) (lin r) Z.sgm)) Z.fac)
             (At[r, Z.c, r, idH (lin r), i0].lc W Z.sgm) i j >
          sv W g i j } ;
  } ;

  Fs (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Fv W g j) (sv W g i j) = FS[W, g, i, j].res ;
  -- the value is the filler of the problem read at the chain of g
  Fv-prob (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Fv W g j) (SAD.lv Ft[W, g].Z.r (SAD.fillE Ft[W, g].Z.r (fill Ft[W, g].Z.r) (prob Ft[W, g].Z.r Ft[W, g].Z.c)) W Ft[W, g].Z.sgm j) =
    refl (Fv W g j) ;
  opaque Fp ; opaque Fn ; opaque Fe ; opaque Fs ; opaque Fv-prob ; opaque Fv ;

} ;

-- Extensionality in the input data, independent of proof fields.
module Compare (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].resP N' (suc N') (dl N' y) b)))
  (X : Ob) (ht : El X -> Nat) (B : Nat) (hB : (x : El X) -> IsT (leb (ht x) B))
  (hm : (x y : El X) -> IsT (le X x.1 y.1) -> IsT (leb (ht x) (ht y)))
  (hi : (x y : El X) -> IsT (le X x.1 y.1) -> Id Nat (ht x) (ht y) -> Id Tree x.1 y.1)
  (x : W0.Ix (G.ob X))
  (a0 : (W : Nat) -> Hom (lin W) X -> PB.GPre[l].TyL[G, A].EI (lin W))
  (a0p : (W : Nat) (g : Hom (lin W) X) -> Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) X g x))
  (a0n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) X g h)))
  (Q : SP.Phi X)
  (sv : (W : Nat) (g : Hom (lin W) X) -> SP.Lands (lin W) X Q g -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (svp : (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (sv W g i j).1 (G.act (lin W) X g x))
  (svn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
         (i' : SP.Lands (lin V) X Q (compH (lin V) (lin W) X g h)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (sv W g i j))
                                                  (sv V (compH (lin V) (lin W) X g h) i' (compH (lin V) (lin W) Iv j h)))
  (sve : (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (sv W g i (constH (lin W) Iv e)) (a0 W g))
  (x2 : W0.Ix (G.ob X))
  (a02 : (W : Nat) -> Hom (lin W) X -> PB.GPre[l].TyL[G, A].EI (lin W))
  (a0p2 : (W : Nat) (g : Hom (lin W) X) -> Id (W0.Ix (G.ob (lin W))) (a02 W g).1 (G.act (lin W) X g x2))
  (a0n2 : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (a02 W g)) (a02 V (compH (lin V) (lin W) X g h)))
  (sv2 : (W : Nat) (g : Hom (lin W) X) -> SP.Lands (lin W) X Q g -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (svp2 : (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (sv2 W g i j).1 (G.act (lin W) X g x2))
  (svn2 : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
         (i' : SP.Lands (lin V) X Q (compH (lin V) (lin W) X g h)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (sv2 W g i j))
                                                  (sv2 V (compH (lin V) (lin W) X g h) i' (compH (lin V) (lin W) Iv j h)))
  (sve2 : (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (sv2 W g i (constH (lin W) Iv e)) (a02 W g))
    (xe : Id (W0.Ix (G.ob X)) x x2)
    (ae : (W : Nat) (g : Hom (lin W) X) -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (a0 W g) (a02 W g))
    (se : (W : Nat) (g : Hom (lin W) X) (i i2 : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv)
      -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (sv W g i j) (sv2 W g i2 j)) {
    module B1 = BF[G, A, e, fill, sides, face, X, ht, B, hB, hm, hi,
      x, a0, a0p, a0n, Q, sv, svp, svn, sve] ;
    open B1 ;
    module B2 = BF[G, A, e, fill, sides, face, X, ht, B, hB, hm, hi,
      x2, a02, a0p2, a0n2, Q, sv2, svp2, svn2, sve2] ;

    module AtC (n : Nat) (c : Hom (lin n) X) {
      xx : Id (KAD.TV.EI n) (x0 n c) (B2.x0 n c) =
        KAD.tv-eq n (x0 n c) (B2.x0 n c)
          (RG.FD.fam-eq n (x0 n c).1 (B2.x0 n c).1
            (\ W g j -> apH (G.act (lin W) X (compH (lin W) (lin n) X c g)) xe))
          (transH (x0-end n c) (transH (ae n c) (symH (B2.x0-end n c)))) ;
      pv-eq (W : Nat) (g : Hom (lin W) (lin n)) (i i2 : DS.Lands W n (Qc n c) g)
        : Id (KAD.TS.EI W) (pv n c W g i) (B2.pv n c W g i2) =
        KAD.mkTS-eq W (KAD.TV.E.act W n g (x0 n c)) (KAD.TV.E.act W n g (B2.x0 n c))
          At[n, c, W, g, i].L B2.At[n, c, W, g, i2].L
          (refl At[n, c, W, g, i].xg) At[n, c, W, g, i].q
          (refl B2.At[n, c, W, g, i2].xg) B2.At[n, c, W, g, i2].q
          (apH (KAD.TV.E.act W n g) xx)
          (\ V g' j -> se V (compH (lin V) (lin n) X c (compH (lin V) (lin W) (lin n) g g'))
            (At[n, c, W, g, i].lc V g') (B2.At[n, c, W, g, i2].lc V g') j) ;
      eq : Id (SAD.Prob n) (prob n c) (B2.prob n c) =
        Sigma-path (KAD.TV.EI n) (\ z -> KAD.PT.Side[n, z]) (x0 n c) (B2.x0 n c) (side n c) (B2.side n c) xx
          (KAD.PT.side-extH n (x0 n c) (B2.x0 n c) xx (side n c) (B2.side n c) (refl (Qc n c)) pv-eq) ;
    } ;
    fv (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
      : Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Fv W g j) (B2.Fv W g j) =
      transH (Fv-prob W g j)
        (transH (apH (\ b -> SAD.lv Ft[W, g].Z.r (SAD.fillE Ft[W, g].Z.r (fill Ft[W, g].Z.r) b) W Ft[W, g].Z.sgm j)
                   AtC[Ft[W, g].Z.r, Ft[W, g].Z.c].eq)
                (symH (B2.Fv-prob W g j))) ;
    opaque fv ;
  } ;
