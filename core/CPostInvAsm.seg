-- CPostInvAsm.seg (L9): the cylinders G_f assembled into an element of
-- DA(X * [1]) (POSTNIKOV-INFORMAL.md, "Assembly and naturality"): at
-- (f , t) : [n] -> X * [1] the value is G_f at (id , t).  Its ends are
-- psi phi (u) (end0) and u (end1).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LM = CPostLimit[a, l] ;
module BD = CPostBdry[a, l] ;
module CI = CPostInv[a, l] ;

module Cyl (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) (X : Ob) (x : W.Ix (G.ob X))
  (u : LM.Post[G, A].DA.DEl X x) {
  module I = CI.Inv[G, A, c, X, x, u] ;
  module P = LM.Post[G, A] ;
  module DTA = P.DA ;
  module TA = PR.TyL[G, A] ;
  module GL = PR.PshL[G] ;
  module TL = PR.TyL[G, DTA.DA] ;
  XI : Ob = prodP X Iv ;
  xI : W.Ix (G.ob XI) = G.act XI X (pr1 X Iv) x ;

  Rg (n : Nat) (f : Hom (lin n) X) : I.GRec[n, f] = (I.Drec n).R f ;
  hf (n : Nat) (h : Hom (lin n) XI) : Hom (lin n) X = compH (lin n) XI X (pr1 X Iv) h ;
  ht (n : Nat) (h : Hom (lin n) XI) : Hom (lin n) Iv = compH (lin n) XI Iv (pr2 X Iv) h ;

  cE (n : Nat) (h : Hom (lin n) XI) : TA.EI (lin n) = (Rg n (hf n h)).Cy n (idH (lin n)) (ht n h) ;

  cEp (n : Nat) (h : Hom (lin n) XI) : Id (W.Ix (G.ob (lin n))) (cE n h).1 (G.act (lin n) XI h xI) =
    transH ((Rg n (hf n h)).Cyp n (idH (lin n)) (ht n h))
      (transH (G.act-id (lin n) (I.xf n (hf n h))) (symH (GL.actC (lin n) XI X (pr1 X Iv) h x))) ;

  cF : DTA.Fam XI xI = \ n h -> TA.fromE (lin n) (G.act (lin n) XI h xI) (cE n h) (cEp n h) ;

  rdE (n : Nat) (h : Hom (lin n) XI) : Id (TA.EI (lin n)) (DTA.rd XI xI cF n h) (cE n h) =
    TA.fromE-eq (lin n) (G.act (lin n) XI h xI) (cE n h) (cEp n h) ;

  -- on a face, the value is that of the face
  FC (n : Nat) (h : Hom (lin (suc n)) XI) (y : Nat) (hy : IsT (leb y (suc n)))
    : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (cE (suc n) h)) (cE n (compH (lin n) (lin (suc n)) XI h (dl n y))) =
    transH ((Rg (suc n) (hf (suc n) h)).Cyn n (suc n) (dl n y) (idH (lin (suc n))) (ht (suc n) h))
      (transH (apH (\ k -> (Rg (suc n) (hf (suc n) h)).Cy n k (compH (lin n) (lin (suc n)) Iv (ht (suc n) h) (dl n y)))
                 (transH (comp-idl (lin n) (lin (suc n)) (dl n y)) (symH (comp-idr (lin n) (lin (suc n)) (dl n y)))))
        (transH (I.cyFace n (I.Drec n) (hf (suc n) h) y hy n (idH (lin n))
                   (compH (lin n) (lin (suc n)) Iv (ht (suc n) h) (dl n y)))
          (transH (apH (\ k -> (Rg n k).Cy n (idH (lin n)) (compH (lin n) (lin (suc n)) Iv (ht (suc n) h) (dl n y)))
                     (comp-assoc (lin n) (lin (suc n)) XI X (pr1 X Iv) h (dl n y)))
                  (apH (\ k -> (Rg n (hf n (compH (lin n) (lin (suc n)) XI h (dl n y)))).Cy n (idH (lin n)) k)
                     (comp-assoc (lin n) (lin (suc n)) XI Iv (pr2 X Iv) h (dl n y)))))) ;

  fc : DTA.FaceCompat XI xI cF = \ n h y hy ->
    transH (apH (TA.E.act (lin n) (lin (suc n)) (dl n y)) (rdE (suc n) h))
      (transH (FC n h y hy) (symH (rdE n (compH (lin n) (lin (suc n)) XI h (dl n y))))) ;

  cyl : DTA.DEl XI xI = (cF, DTA.FacesGen[XI, xI, cF, fc].facesGen) ;

  p : TL.EI XI = (xI, cyl) ;

  ----------------------------------------------------------------------
  -- the ends

  elid (e : El Iv) : Id (W.Ix (G.ob X)) (G.act X XI (lid X e) xI) x =
    transH (GL.actTri X XI X (pr1 X Iv) (lid X e) (idH X) (pr1-pair X Iv X (idH X) (constH X Iv e)) x) (G.act-id X x) ;

  pr1lid (n : Nat) (e : El Iv) (f : Hom (lin n) X) : Id (Hom (lin n) X) (hf n (compH (lin n) X XI (lid X e) f)) f =
    transH (symH (comp-assoc (lin n) X XI X (pr1 X Iv) (lid X e) f))
      (transH (apH (\ k -> compH (lin n) X X k f) (pr1-pair X Iv X (idH X) (constH X Iv e))) (comp-idl (lin n) X f)) ;

  pr2lid (n : Nat) (e : El Iv) (f : Hom (lin n) X) : Id (Hom (lin n) Iv) (ht n (compH (lin n) X XI (lid X e) f)) (constH (lin n) Iv e) =
    transH (symH (comp-assoc (lin n) X XI Iv (pr2 X Iv) (lid X e) f))
      (transH (apH (\ k -> compH (lin n) X Iv k f) (pr2-pair X Iv X (idH X) (constH X Iv e))) (BD.const-h (lin n) X f e)) ;

  endv (e : El Iv) (n : Nat) (f : Hom (lin n) X)
    : Id (TA.EI (lin n)) (DTA.rd X x (DTA.dtact X XI (lid X e) xI x (elid e) cyl).1 n f) ((Rg n f).Cy n (idH (lin n)) (constH (lin n) Iv e)) =
    transH (DTA.rd-dtact X XI (lid X e) xI x (elid e) cyl n f)
      (transH (rdE n (compH (lin n) X XI (lid X e) f))
        (transH (apH (\ k -> (Rg n k).Cy n (idH (lin n)) (ht n (compH (lin n) X XI (lid X e) f))) (pr1lid n e f))
                (apH ((Rg n f).Cy n (idH (lin n))) (pr2lid n e f)))) ;

  end0 : Id (DTA.DEl X x) (DTA.dtact X XI (lid X e0) xI x (elid e0) cyl) I.IN.C.psi =
    DTA.Dext X x _ _ (\ n f -> transH (endv e0 n f)
      (transH ((Rg n f).Cy0 n (idH (lin n)))
        (transH (TA.E.act-id (lin n) (I.Rf n f).psi) (symH (I.Lr.rdE n f))))) ;

  end1 : Id (DTA.DEl X x) (DTA.dtact X XI (lid X e1) xI x (elid e1) cyl) u =
    DTA.Dext X x _ _ (\ n f -> transH (endv e1 n f)
      (transH ((Rg n f).Cy1 n (idH (lin n))) (TA.E.act-id (lin n) (I.UR.Uf n f)))) ;

  p0 : Id (TL.EI X) (TL.E.act X XI (lid X e0) p) (x, I.IN.C.psi) =
    transH (TL.pr-tact X XI (lid X e0) xI x (elid e0) cyl) (apH {DTA.DEl X x} {TL.EI X} (\ v -> (x, v)) end0) ;

  p1 : Id (TL.EI X) (TL.E.act X XI (lid X e1) p) (x, u) =
    transH (TL.pr-tact X XI (lid X e1) xI x (elid e1) cyl) (apH {DTA.DEl X x} {TL.EI X} (\ v -> (x, v)) end1) ;
} ;
