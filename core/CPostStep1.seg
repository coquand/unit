-- CPostStep1.seg (L9): step 1 of the construction of psi (postnikov.tex,
-- Theorem conv), at a simplex f : [m] -> X with m = m' + 1.
--
-- Given the prisms H(f d_y , 1) of the faces (Hf: maps [m'] * [1] -> i*A
-- over f d_y, from psi(f d_y) at 0 (Hf0) to the reading of u_{m+1} at 1
-- (Hf1), agreeing on common faces (FF1)), the open box of [m] * [1] with
-- lid the reading of u_{m+1} along f at 1 and sides Hf is filled
-- (CBoxFill from e1, on the base [m] * [0], sides CPostBdry):
--
--   H0v W g j     the prism H(f , 0) : [m] * [1] -> i*A over f
--   H0p, H0n      over f, natural
--   H0-e1         at 1 it is the reading of u_{m+1} along f
--   psi           its value at (id , 0): an element of A([m]) over f
--   H0-e0         at 0 it is psi
--   H0-face       on the face y it is Hf y
--   psi-face      psi restricted to the face y is psi(f d_y)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;

-- the face dl y misses y
dl-miss (m' y W : Nat) (g : Hom (lin W) (lin m')) : Miss (lin W) m' y (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) = \ s ->
  substH {Tree} (\ t -> IsT (not (eqN (vnum t) y))) (symH (app-compH1 (lin W) (lin m') (lin (suc m')) (dl m' y) g s))
    (CDeltaFact[a].leafElim m' (\ s1 -> IsT (not (eqN (vnum (app (lin m') (lin (suc m')) (dl m' y) s1).1) y)))
       (\ j h -> skip-miss y j) (app (lin W) (lin m') g s)) ;

z0 : El (lin zero) = (leaf zero, refl true) ;

QY0 : SP.Phi (lin zero) = SP.emptyS (lin zero) ;

module P1 (G : PP.PCtx) (A : PP.PTy[G]) (X : Ob) (x : W0.Ix (G.ob X)) (m : Nat)
  (u : LD.DT[G, CK.KT[G, A, suc m].KA].DEl X x) (f : Hom (lin m) X) {
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;

  xf : W0.Ix (G.ob (lin m)) = G.act (lin m) X f x ;

  -- the base [m] * [0]
  module BX = BD.BXm[m, (lin zero)] ;
  module HM = EZ.HLin[m] ;
  module H0 = EZ.HLin[zero] ;
  module HP = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, lin zero, H0.ht, zero, H0.hB, H0.hm, H0.hi] ;
  xB : W0.Ix (G.ob BX.XB) = G.act BX.XB (lin m) BX.p1B xf ;

  -- the lid: u_{m+1} read along f, at 1
  module DU = PM.DR[G, A, suc m, X, x, u, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-suc m, f] ;

  a0 (W : Nat) (g : Hom (lin W) BX.XB) : TA.EI (lin W) = DU.val W (compH (lin W) BX.XB (lin m) BX.p1B g) ;

  a0p (W : Nat) (g : Hom (lin W) BX.XB) : Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) BX.XB g xB) =
    transH (DU.vp W (compH (lin W) BX.XB (lin m) BX.p1B g)) (symH (GL.actC (lin W) BX.XB (lin m) BX.p1B g xf)) ;

  a0n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) BX.XB g h)) =
    transH (DU.vn V W h (compH (lin W) BX.XB (lin m) BX.p1B g))
           (apH (DU.val V) (comp-assoc (lin V) (lin W) BX.XB (lin m) BX.p1B g h)) ;

  ----------------------------------------------------------------------
  -- from the filled prism: H(f , 0) on [m] * [1] and psi(f)

  module Out (Fv : (W : Nat) -> Hom (lin W) BX.XB -> Hom (lin W) Iv -> TA.EI (lin W))
    (Fp : (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Fv W g j).1 (G.act (lin W) BX.XB g xB))
    (Fn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
          -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Fv W g j)) (Fv V (compH (lin V) (lin W) BX.XB g h) (compH (lin V) (lin W) Iv j h)))
    (Fe : (W : Nat) (g : Hom (lin W) BX.XB) -> Id (TA.EI (lin W)) (Fv W g (constH (lin W) Iv e1)) (a0 W g)) {
    i0 (W : Nat) (g : Hom (lin W) (lin m)) : Hom (lin W) BX.XB = pairH (lin m) (lin zero) (lin W) g (constH (lin W) (lin zero) z0) ;

    p1i0 (W : Nat) (g : Hom (lin W) (lin m)) : Id (Hom (lin W) (lin m)) (compH (lin W) BX.XB (lin m) BX.p1B (i0 W g)) g =
      pr1-pair (lin m) (lin zero) (lin W) g (constH (lin W) (lin zero) z0) ;

    i0-h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m))
      : Id (Hom (lin V) BX.XB) (compH (lin V) (lin W) BX.XB (i0 W g) h) (i0 V (compH (lin V) (lin W) (lin m) g h)) =
      BD.pair-ext (lin m) (lin zero) (lin V) (compH (lin V) (lin W) BX.XB (i0 W g) h) (i0 V (compH (lin V) (lin W) (lin m) g h))
        (transH (symH (comp-assoc (lin V) (lin W) BX.XB (lin m) BX.p1B (i0 W g) h))
          (transH (apH (\ k -> compH (lin V) (lin W) (lin m) k h) (p1i0 W g)) (symH (p1i0 V (compH (lin V) (lin W) (lin m) g h)))))
        (transH (symH (comp-assoc (lin V) (lin W) BX.XB (lin zero) (pr2 (lin m) (lin zero)) (i0 W g) h))
          (transH (apH (\ k -> compH (lin V) (lin W) (lin zero) k h) (pr2-pair (lin m) (lin zero) (lin W) g (constH (lin W) (lin zero) z0)))
            (transH (hom-eq (lin V) (lin zero) (compH (lin V) (lin W) (lin zero) (constH (lin W) (lin zero) z0) h) (constH (lin V) (lin zero) z0)
                       (\ s -> app-compH1 (lin V) (lin W) (lin zero) (constH (lin W) (lin zero) z0) h s))
                    (symH (pr2-pair (lin m) (lin zero) (lin V) (compH (lin V) (lin W) (lin m) g h) (constH (lin V) (lin zero) z0)))))) ;

    H0v (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TA.EI (lin W) = Fv W (i0 W g) j ;

    H0p (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (H0v W g j).1 (G.act (lin W) (lin m) g xf) =
      transH (Fp W (i0 W g) j)
        (transH (GL.actC (lin W) BX.XB (lin m) BX.p1B (i0 W g) xf) (apH (\ k -> G.act (lin W) (lin m) k xf) (p1i0 W g))) ;

    H0n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (H0v W g j)) (H0v V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)) =
      transH (Fn V W h (i0 W g) j) (apH (\ k -> Fv V k (compH (lin V) (lin W) Iv j h)) (i0-h V W h g)) ;

    H0-e1 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TA.EI (lin W)) (H0v W g (constH (lin W) Iv e1)) (DU.val W g) =
      transH (Fe W (i0 W g)) (apH (DU.val W) (p1i0 W g)) ;

    psi : TA.EI (lin m) = H0v m (idH (lin m)) (constH (lin m) Iv e0) ;

    psi-pt : Id (W0.Ix (G.ob (lin m))) psi.1 xf = transH (H0p m (idH (lin m)) (constH (lin m) Iv e0)) (G.act-id (lin m) xf) ;

    H0-e0 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TA.EI (lin W)) (H0v W g (constH (lin W) Iv e0)) (TA.E.act (lin W) (lin m) g psi) =
      symH (transH (H0n W m g (idH (lin m)) (constH (lin m) Iv e0))
             (transH (apH (\ k -> H0v W k (compH (lin W) (lin m) Iv (constH (lin m) Iv e0) g)) (comp-idl (lin W) (lin m) g))
                     (apH (H0v W g) (constH-nat (lin W) (lin m) g e0)))) ;

    opaque H0p ; opaque H0n ; opaque H0-e1 ; opaque H0-e0 ;
  } ;
} ;

module S1 (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W0.Ix (G.ob X)) (m' : Nat) (u : LD.DT[G, CK.KT[G, A, suc (suc m')].KA].DEl X x)
  (f : Hom (lin (suc m')) X)
  (psiF : (y : Nat) -> IsT (leb y (suc m')) -> PB.GPre[l].TyL[G, A].EI (lin m'))
  (Hf : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (lin m') -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hfp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Hf y hy W g j).1 (G.act (lin W) (lin m') g (G.act (lin m') X (compH (lin m') (lin (suc m')) X f (dl m' y)) x)))
  (Hfn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (Hf y hy W g j))
               (Hf y hy V (compH (lin V) (lin W) (lin m') g h) (compH (lin V) (lin W) Iv j h)))
  (Hf0 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m'))
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Hf y hy W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin m') g (psiF y hy)))
  (Hf1 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m'))
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Hf y hy W g (constH (lin W) Iv e1))
               (PM.DR[G, A, suc (suc m'), X, x, u, lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                      leb-step m' (suc m') (leb-suc m'), compH (lin m') (lin (suc m')) X f (dl m' y)].val W g))
  (FF1 : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
         (W : Nat) (g : Hom (lin W) (lin (suc m'))) (msy : Miss (lin W) m' y g) (msz : Miss (lin W) m' z g) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Hf y hy W (compH (lin W) (lin (suc m')) (lin m') (dgH m' y) g) j)
                                                  (Hf z hz W (compH (lin W) (lin (suc m')) (lin m') (dgH m' z) g) j)) {
  m : Nat = suc m' ;
  module RG = CLocRestr[a, l].R[G] ;
  module FF = CDFill[a, l].FF[RG.iG, RG.T[A].iA, CLocHorn[a, l].HornOfFib[G, A, c].horn] ;

  module P = P1[G, A, X, x, suc m', u, f] ;
  module TA = P.TA ;
  module GL = P.GL ;

  -- the base [m] * [0]
  module BG = BD.BG[m', lin zero] ;
  -- the sides

  F (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) BG.Xf) (j : Hom (lin W) Iv) : TA.EI (lin W) =
    Hf y hy W (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g) j ;

  -- the point of a face, in the base
  ptF (y : Nat) (W : Nat) (g : Hom (lin W) BG.Xf)
    : Id (W0.Ix (G.ob (lin W))) (G.act (lin W) (lin m') (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g)
                                    (G.act (lin m') X (compH (lin m') (lin m) X f (dl m' y)) x))
                                 (G.act (lin W) BG.Xf g (G.act BG.Xf P.BX.XB (BG.dY y) P.xB)) =
    calc (W0.Ix (G.ob (lin W))) {
        G.act (lin W) (lin m') (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g) (G.act (lin m') X (compH (lin m') (lin m) X f (dl m' y)) x)
      =< apH (G.act (lin W) (lin m') (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g)) (G.act-o (lin m') (lin m) X f (dl m' y) x) >
        G.act (lin W) (lin m') (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g) (G.act (lin m') (lin m) (dl m' y) P.xf)
      =< GL.actC (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g) P.xf >
        G.act (lin W) (lin m) (compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g)) P.xf
      =< apH (\ k -> G.act (lin W) (lin m) k P.xf)
           (transH (symH (comp-assoc (lin W) BG.Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') (lin zero)) g))
             (transH (apH (\ k -> compH (lin W) BG.Xf (lin m) k g) (symH (BG.pr1-dY y)))
                     (comp-assoc (lin W) BG.Xf P.BX.XB (lin m) P.BX.p1B (BG.dY y) g))) >
        G.act (lin W) (lin m) (compH (lin W) P.BX.XB (lin m) P.BX.p1B (compH (lin W) BG.Xf P.BX.XB (BG.dY y) g)) P.xf
      =< symH (GL.actC (lin W) P.BX.XB (lin m) P.BX.p1B (compH (lin W) BG.Xf P.BX.XB (BG.dY y) g) P.xf) >
        G.act (lin W) P.BX.XB (compH (lin W) BG.Xf P.BX.XB (BG.dY y) g) P.xB
      =< symH (GL.actC (lin W) BG.Xf P.BX.XB (BG.dY y) g P.xB) >
        G.act (lin W) BG.Xf g (G.act BG.Xf P.BX.XB (BG.dY y) P.xB) } ;

  Fp (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) BG.Xf) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob (lin W))) (F y hy W g j).1 (G.act (lin W) BG.Xf g (G.act BG.Xf P.BX.XB (BG.dY y) P.xB)) =
    transH (Hfp y hy W (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g) j) (ptF y W g) ;

  Fn (y : Nat) (hy : IsT (leb y m)) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BG.Xf) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (F y hy W g j)) (F y hy V (compH (lin V) (lin W) BG.Xf g h) (compH (lin V) (lin W) Iv j h)) =
    transH (Hfn y hy V W h (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g) j)
           (apH (\ k -> Hf y hy V k (compH (lin V) (lin W) Iv j h)) (comp-assoc (lin V) (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) g h)) ;

  -- no end data
  Ev (W : Nat) (g : Hom (lin W) P.BX.XB) (b : SP.Lands (lin W) P.BX.XB (BG.endS QY0) g) (j : Hom (lin W) Iv) : TA.EI (lin W) =
    absurd _ (false-true b) ;

  -- the face y of g, read in [m']
  pr1gy (y W : Nat) (g : Hom (lin W) P.BX.XB)
    : Id (Hom (lin W) (lin m')) (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) (BG.gy y W g))
                                (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) =
    pr1-pair (lin m') (lin zero) (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (BG.p2g W g) ;

  module BSm = BD.BS[G, A, m', lin zero, QY0, P.xB, F, Fp, Fn, Ev,
    \ W g b j -> absurd _ (false-true b),
    \ V W h g b b' j -> absurd _ (false-true b),
    \ y z hy hz lt W g msy msz j ->
      transH (apH (\ k -> Hf y hy W k j) (pr1gy y W g))
        (transH (FF1 y z hy hz lt W (BG.p1g W g) msy msz j) (symH (apH (\ k -> Hf z hz W k j) (pr1gy z W g)))),
    \ y hy W g ms b j -> absurd _ (false-true b)] ;

  -- the sides start at the lid
  aF (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) P.BX.XB) (ms : Miss (lin W) m' y (BG.p1g W g))
    : Id (TA.EI (lin W)) (F y hy W (BG.gy y W g) (constH (lin W) Iv e1)) (P.a0 W g) =
    calc (TA.EI (lin W)) {
        Hf y hy W (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) (BG.gy y W g)) (constH (lin W) Iv e1)
      =< apH (\ k -> Hf y hy W k (constH (lin W) Iv e1)) (pr1gy y W g) >
        Hf y hy W (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (constH (lin W) Iv e1)
      =< Hf1 y hy W (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) >
        PM.DR[G, A, suc m, X, x, u, lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
              leb-step m' m (leb-suc m'), compH (lin m') (lin m) X f (dl m' y)].val W (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g))
      =< PM.DRI[G, A, suc m, X, x, u, lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
               leb-step m' m (leb-suc m'), lin m, P.HM.ht, m, P.HM.hB, P.HM.hm, P.HM.hi, leb-suc m, f, dl m' y, dl-strict m' y,
               W, compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)].res >
        P.DU.val W (compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)))
      =< apH (P.DU.val W) (hom-eq (lin W) (lin m) _ _ (pw-factor (lin W) m' y (BG.p1g W g) hy ms)) >
        P.DU.val W (BG.p1g W g) } ;

  module LidM = BSm.Lid[e1, P.a0, aF, \ W g b -> absurd _ (false-true b)] ;

  -- the filled prism
  module Bx = CBoxFill[a, l].BF[G, A, e1, FF.S.fill, FF.S.sides, FF.S.face,
    P.BX.XB, P.HP.ht, P.HP.B, P.HP.hB, P.HP.hm, P.HP.hi, P.xB, P.a0, P.a0p, P.a0n, BSm.Q, BSm.sv, BSm.svp, BSm.svn, LidM.sve] ;

  module O = P.Out[Bx.Fv, Bx.Fp, Bx.Fn, Bx.Fe] ;

  -- the outputs
  H0v (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TA.EI (lin W) = O.H0v W g j ;
  psi : TA.EI (lin m) = O.psi ;

  -- on the face y, H(f , 0) is Hf y
  H0-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (O.H0v W (compH (lin W) (lin m') (lin m) (dl m' y) g) j) (Hf y hy W g j) =
    calc (TA.EI (lin W)) {
        Bx.Fv W gi j
      =< Bx.Fs W gi li j >
        BSm.sv W gi li j
      =< BSm.sv-F y hy W gi li ms j >
        Hf y hy W (compH (lin W) BG.Xf (lin m') (pr1 (lin m') (lin zero)) (BG.gy y W gi)) j
      =< apH (\ k -> Hf y hy W k j)
           (transH (pr1gy y W gi)
             (transH (apH (compH (lin W) (lin m) (lin m') (dgH m' y)) (O.p1i0 W (compH (lin W) (lin m') (lin m) (dl m' y) g)))
               (transH (symH (comp-assoc (lin W) (lin m') (lin m) (lin m') (dgH m' y) (dl m' y) g))
                 (transH (apH (\ k -> compH (lin W) (lin m') (lin m') k g) (hom-eq (lin m') (lin m') _ _ (pw-dg-dl m' y hy)))
                         (comp-idl (lin W) (lin m') g))))) >
        Hf y hy W g j }
   where { gi : Hom (lin W) P.BX.XB = O.i0 W (compH (lin W) (lin m') (lin m) (dl m' y) g) ;
           ms : Miss (lin W) m' y (BG.p1g W gi) =
             substH {Hom (lin W) (lin m)} (\ k -> Miss (lin W) m' y k) (symH (O.p1i0 W (compH (lin W) (lin m') (lin m) (dl m' y) g)))
               (dl-miss m' y W g) ;
           li : SP.Lands (lin W) P.BX.XB BSm.Q gi = SP.lands-union-l (lin W) P.BX.XB BG.facesS (BG.endS QY0) gi (BG.in-faces W gi y hy ms) ; } ;


  psi-face (y : Nat) (hy : IsT (leb y m)) : Id (TA.EI (lin m')) (TA.E.act (lin m') (lin m) (dl m' y) O.psi) (psiF y hy) =
    calc (TA.EI (lin m')) {
        TA.E.act (lin m') (lin m) (dl m' y) O.psi
      =< symH (O.H0-e0 m' (dl m' y)) >
        O.H0v m' (dl m' y) (constH (lin m') Iv e0)
      =< apH (\ k -> O.H0v m' k (constH (lin m') Iv e0)) (symH (comp-idr (lin m') (lin m) (dl m' y))) >
        O.H0v m' (compH (lin m') (lin m') (lin m) (dl m' y) (idH (lin m'))) (constH (lin m') Iv e0)
      =< H0-face y hy m' (idH (lin m')) (constH (lin m') Iv e0) >
        Hf y hy m' (idH (lin m')) (constH (lin m') Iv e0)
      =< Hf0 y hy m' (idH (lin m')) >
        TA.E.act (lin m') (lin m') (idH (lin m')) (psiF y hy)
      =< TA.E.act-id (lin m') (psiF y hy) >
        psiF y hy } ;
  opaque H0-face ; opaque psi-face ;
} ;
