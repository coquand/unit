-- COpMove.seg (L2, inside CB, levels k l): operations pulled back
-- along a cartesian map.  D (level k >= a) and G (level l >= k), A' over D and A
-- over G, a map of points pts : D -> G and fibrewise bijections cf / cb
-- between A' at x and A at pts x, the induced map of totals mV natural
-- (mnat).  A filling operation for A gives one for A': move the data along
-- mV, fill in A, read the filler back by cb (Pull.op).
--
-- Instances: substitution (identity on fibres), a small type over a
-- large context (L4), Delta's classifier (L8).  Quarry: seg/model GFillX.

level k l ;
constraint a <= k ;
constraint k <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[k] ;
module WL = V[l] ;
module GPR = GPre[k] ;
module GPL = GPre[l] ;

module Pull (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (i : I) -> Phi (ob i))
  (D : GPR.PS.PCtx) (A' : GPR.PS.PTy[D]) (G : GPL.PS.PCtx) (A : GPL.PS.PTy[G])
  (pts : (W : Ob) -> W0.Ix (D.ob W) -> WL.Ix (G.ob W))
  (pnat : (V W : Ob) (g : Hom V W) (x : W0.Ix (D.ob W)) -> Id (WL.Ix (G.ob V)) (pts V (D.act V W g x)) (G.act V W g (pts W x)))
  (cf : (W : Ob) (x : W0.Ix (D.ob W)) -> W0.Ix (A'.tob W x) -> WL.Ix (A.tob W (pts W x)))
  (cb : (W : Ob) (x : W0.Ix (D.ob W)) -> WL.Ix (A.tob W (pts W x)) -> W0.Ix (A'.tob W x))
  (cbf : (W : Ob) (x : W0.Ix (D.ob W)) (b : W0.Ix (A'.tob W x)) -> Id (W0.Ix (A'.tob W x)) (cb W x (cf W x b)) b)
  (cfb : (W : Ob) (x : W0.Ix (D.ob W)) (b : WL.Ix (A.tob W (pts W x))) -> Id (WL.Ix (A.tob W (pts W x))) (cf W x (cb W x b)) b)
  (mnat : (V W : Ob) (g : Hom V W) (w : GPR.TyL[D, A'].EI W)
     -> Id (GPL.TyL[G, A].EI V) (GPL.TyL[G, A].E.act V W g (pts W w.1, cf W w.1 w.2))
                                (pts V (GPR.TyL[D, A'].E.act V W g w).1, cf V (GPR.TyL[D, A'].E.act V W g w).1 (GPR.TyL[D, A'].E.act V W g w).2))
  (c : COp[l].OpS[I, ok, ob, S, G, A].Op) {
  module TD = GPR.TyL[D, A'] ;
  module TG = GPL.TyL[G, A] ;
  module FD = COp[k].OpS[I, ok, ob, S, D, A'] ;
  module FG = COp[l].OpS[I, ok, ob, S, G, A] ;

  mV (W : Ob) (w : TD.EI W) : TG.EI W = (pts W w.1, cf W w.1 w.2) ;

  -- an element of A' is determined by its point and its image
  mInj (W : Ob) (w w' : TD.EI W) (p : Id (W0.Ix (D.ob W)) w.1 w'.1) (q : Id (TG.EI W) (mV W w) (mV W w')) : Id (TD.EI W) w w' =
    idJ (W0.Ix (D.ob W)) w.1
      (\ d P -> (b2 : W0.Ix (A'.tob W d)) -> Id (TG.EI W) (mV W w) (pts W d, cf W d b2) -> Id (TD.EI W) w (d, b2))
      (\ b2 Q -> apH {W0.Ix (A'.tob W w.1)} {TD.EI W} (\ z -> (w.1, z))
          (transH (symH (cbf W w.1 w.2))
             (transH (apH (cb W w.1) (TG.pr-inj W (pts W w.1) (cf W w.1 w.2) (cf W w.1 b2) Q)) (cbf W w.1 b2))))
      w'.1 p w'.2 q ;

  opaque mInj ;

  -- the data moved along mV
  mv (i : I) (rho : W0.Ix (D.ob (ob i))) (h : FD.HData i rho) : FG.HData i (pts (ob i) rho) =
    (\ W f j -> mV W (h.1 W f j),
     (\ W f j -> transH (apH (pts W) (h.2.1 W f j)) (pnat W (ob i) f rho),
      \ W' W chi f j j' -> transH (mnat W' W chi (h.1 W f j)) (apH (mV W') (h.2.2 W' W chi f j j')))) ;

  module E1 (i : I) (o : ok i) (rho : W0.Ix (D.ob (ob i))) (h : FD.HData i rho) {
    ex : FG.FExt i (pts (ob i) rho) (mv i rho h) = c i o (pts (ob i) rho) (mv i rho h) ;

    a0 : W0.Ix (A'.tob (ob i) rho) = cb (ob i) rho ex.1 ;

    cond (W : Ob) (f : Hom W (ob i)) (j : Lands W (ob i) (S i) f) : Id (TD.EI W) (TD.E.act W (ob i) f (rho, a0)) (h.1 W f j) =
      mInj W (TD.E.act W (ob i) f (rho, a0)) (h.1 W f j) (symH (h.2.1 W f j))
        (transH (symH (mnat W (ob i) f (rho, a0)))
          (transH (apH (\ z -> TG.E.act W (ob i) f (pts (ob i) rho, z)) (cfb (ob i) rho ex.1)) (ex.2 W f j))) ;

    res : FD.FExt i rho h = (a0, cond) ;
  } ;

  op : FD.Op = \ i o rho h -> E1[i, o, rho, h].res ;

  -- its filler is the filler of the moved data, read back
  op-val (i : I) (o : ok i) (rho : W0.Ix (D.ob (ob i))) (h : FD.HData i rho)
    : Id (W0.Ix (A'.tob (ob i) rho)) (op i o rho h).1 (cb (ob i) rho (c i o (pts (ob i) rho) (mv i rho h)).1) =
    refl (cb (ob i) rho (c i o (pts (ob i) rho) (mv i rho h)).1) ;
} ;
