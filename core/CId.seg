-- CId.seg (L3, inside CB, level l): Swan's identity type (model.tex §9.1,
-- Def "Id").  Over the data of a path type (CPath.PathOverE, direction
-- e0 -> e1), at x : K(X) an element is a pair (u , q): a path u from aE x to
-- bE x and a sieve q of X on which u is constant at aE:
--     u (W , f , j) = aE (x f)   for f landing in q.
-- Restriction is (u , q) h = (u h , h^* q).
--
--   orS            the union of two sieves (bigU of two)
--   IdT            the type; idI-eq: equal paths and equal sieves
--   tpI-ext        an element of the total presheaf is determined by its
--                  point, the values of its path and its sieve
--   proj           the projection to the path type
--   constPath      the constant path at x (when aE x = bE x and s is
--                  constant at the point of aE: sC)
--   reflI          (constPath , top); reflI-nat: it is natural
--
-- The sieve is coded by its characteristic map (encPhiL, as CEnc.encPhi).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
module EP = Encode[a, l] ;
module GPR = GPre[l] ;
open GPR.PS ;

------------------------------------------------------------------------
-- the union of two sieves

pick2 (X : Ob) (Q Q' : Phi X) : Nat -> Phi X = split { zero -> Q ; suc m -> Q' } ;

orS (X : Ob) (Q Q' : Phi X) : Phi X = bigU X (suc (suc zero)) (\ k -> pick2 X Q Q' k.1) ;

or-l (W X : Ob) (Q Q' : Phi X) (f : Hom W X) (i : Lands W X Q f) : Lands W X (orS X Q Q') f =
  bigU-in W X (suc (suc zero)) (\ k -> pick2 X Q Q' k.1) f (zero, refl true) i ;

or-r (W X : Ob) (Q Q' : Phi X) (f : Hom W X) (i : Lands W X Q' f) : Lands W X (orS X Q Q') f =
  bigU-in W X (suc (suc zero)) (\ k -> pick2 X Q Q' k.1) f (suc zero, refl true) i ;

-- eliminating a map landing in the union
or-elim (W X : Ob) (Q Q' : Phi X) (f : Hom W X) (P : U l) (i : Lands W X (orS X Q Q') f)
  (pl : Lands W X Q f -> P) (pr : Lands W X Q' f -> P) : P =
  el (bigU-out W X (suc (suc zero)) (\ k -> pick2 X Q Q' k.1) f i).1.1 (bigU-out W X (suc (suc zero)) (\ k -> pick2 X Q Q' k.1) f i).2
 where {
   el : (n : Nat) -> Lands W X (pick2 X Q Q' n) f -> P = split { zero -> pl ; suc m -> \ h -> pr h } ; } ;

pre-or (Y X : Ob) (h : Hom Y X) (Q Q' : Phi X) : Id (Phi Y) (pre Y X h (orS X Q Q')) (orS Y (pre Y X h Q) (pre Y X h Q')) =
  phi-ext Y (pre Y X h (orS X Q Q')) (orS Y (pre Y X h Q) (pre Y X h Q'))
    (\ W f i -> or-elim W X Q Q' (compH W Y X h f) (Lands W Y (orS Y (pre Y X h Q) (pre Y X h Q')) f) (lands-pre W Y X h (orS X Q Q') f i)
       (\ a -> or-l W Y (pre Y X h Q) (pre Y X h Q') f (pre-lands W Y X h Q f a))
       (\ b -> or-r W Y (pre Y X h Q) (pre Y X h Q') f (pre-lands W Y X h Q' f b)))
    (\ W f i -> pre-lands W Y X h (orS X Q Q') f
       (or-elim W Y (pre Y X h Q) (pre Y X h Q') f (Lands W X (orS X Q Q') (compH W Y X h f)) i
          (\ a -> or-l W X Q Q' (compH W Y X h f) (lands-pre W Y X h Q f a))
          (\ b -> or-r W X Q Q' (compH W Y X h f) (lands-pre W Y X h Q' f b)))) ;

------------------------------------------------------------------------
-- dependent conjunction (model.tex Hypothesis "dependent conjunction"):
-- for Q and a natural family F f of sieves for f landing in Q, the sieve of
-- the f in Q with F f total

module DConj {
  dconj (X : Ob) (Q : Phi X) (F : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W)
    (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
          -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i')) : Phi X ;
  dc-in (W X : Ob) (Q : Phi X) (F : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W)
    (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
          -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i'))
    (f : Hom W X) (i : Lands W X Q f) (j : Lands W W (F W f i) (idH W)) : Lands W X (dconj X Q F Fn) f ;
  dc-out (W X : Ob) (Q : Phi X) (F : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W)
    (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
          -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i'))
    (f : Hom W X) (i : Lands W X (dconj X Q F Fn) f) : (i' : Lands W X Q f) * Lands W W (F W f i') (idH W) ;
} ;

module DCL (dc : DConj) (X : Ob) (Q : Phi X) (F : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W)
  (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
        -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i')) {
  DQ : Phi X = dc.dconj X Q F Fn ;

  -- F does not depend on the proof, nor on the presentation of the map
  Firr (W : Ob) (f : Hom W X) (i i' : Lands W X Q f) : Id (Phi W) (F W f i) (F W f i') = apH (F W f) (isProp-Lands W X Q f i i') ;

  Fhom (W : Ob) (f f' : Hom W X) (E : Id (Hom W X) f f') (i : Lands W X Q f) (i' : Lands W X Q f') : Id (Phi W) (F W f i) (F W f' i') =
    idJ (Hom W X) f (\ f2 E2 -> (i2 : Lands W X Q f2) -> Id (Phi W) (F W f i) (F W f2 i2)) (\ i2 -> Firr W f i i2) f' E i' ;

  -- the identity lands in a restricted sieve iff the map lands in it
  idPre (V W : Ob) (g : Hom V W) (R : Phi W) (l : Lands V V (pre V W g R) (idH V)) : Lands V W R g =
    lands-eq V W R (compH V V W g (idH V)) g (comp-idr V W g) (lands-pre V V W g R (idH V) l) ;
  preId (V W : Ob) (g : Hom V W) (R : Phi W) (l : Lands V W R g) : Lands V V (pre V W g R) (idH V) =
    pre-lands V V W g R (idH V) (lands-eq V W R g (compH V V W g (idH V)) (symH (comp-idr V W g)) l) ;

  -- on Q, the dependent conjunction restricts to F
  dc-at (W : Ob) (f : Hom W X) (i : Lands W X Q f) : Id (Phi W) (pre W X f DQ) (F W f i) =
    phi-ext W (pre W X f DQ) (F W f i)
      (\ V g l -> idPre V W g (F W f i)
         (lands-sub V V (F V (compH V W X f g) (lands-comp V W X Q f g i)) (pre V W g (F W f i))
            (symH (Fn V W g f i (lands-comp V W X Q f g i))) (idH V)
            (lands-sub V V (F V (compH V W X f g) (dc.dc-out V X Q F Fn (compH V W X f g) (lands-pre V W X f DQ g l)).1)
               (F V (compH V W X f g) (lands-comp V W X Q f g i))
               (Firr V (compH V W X f g) (dc.dc-out V X Q F Fn (compH V W X f g) (lands-pre V W X f DQ g l)).1 (lands-comp V W X Q f g i))
               (idH V) (dc.dc-out V X Q F Fn (compH V W X f g) (lands-pre V W X f DQ g l)).2)))
      (\ V g l -> pre-lands V W X f DQ g
         (dc.dc-in V X Q F Fn (compH V W X f g) (lands-comp V W X Q f g i)
            (lands-sub V V (pre V W g (F W f i)) (F V (compH V W X f g) (lands-comp V W X Q f g i))
               (Fn V W g f i (lands-comp V W X Q f g i)) (idH V) (preId V W g (F W f i) l)))) ;

  -- restricted data
  Fr (Y : Ob) (h : Hom Y X) (W : Ob) (g : Hom W Y) (i : Lands W Y (pre Y X h Q) g) : Phi W =
    F W (compH W Y X h g) (lands-pre W Y X h Q g i) ;

  -- (for any proof Frn of the naturality of the restricted data)
  dc-restr (Y : Ob) (h : Hom Y X)
    (Frn : (V W : Ob) (g' : Hom V W) (g : Hom W Y) (i : Lands W Y (pre Y X h Q) g) (i' : Lands V Y (pre Y X h Q) (compH V W Y g g'))
           -> Id (Phi V) (pre V W g' (Fr Y h W g i)) (Fr Y h V (compH V W Y g g') i'))
    : Id (Phi Y) (pre Y X h DQ) (dc.dconj Y (pre Y X h Q) (Fr Y h) Frn) =
    phi-ext Y (pre Y X h DQ) (dc.dconj Y (pre Y X h Q) (Fr Y h) Frn)
      (\ W g l -> dc.dc-in W Y (pre Y X h Q) (Fr Y h) Frn g
         (pre-lands W Y X h Q g (dc.dc-out W X Q F Fn (compH W Y X h g) (lands-pre W Y X h DQ g l)).1)
         (lands-sub W W (F W (compH W Y X h g) (dc.dc-out W X Q F Fn (compH W Y X h g) (lands-pre W Y X h DQ g l)).1)
            (Fr Y h W g (pre-lands W Y X h Q g (dc.dc-out W X Q F Fn (compH W Y X h g) (lands-pre W Y X h DQ g l)).1))
            (Firr W (compH W Y X h g) (dc.dc-out W X Q F Fn (compH W Y X h g) (lands-pre W Y X h DQ g l)).1
               (lands-pre W Y X h Q g (pre-lands W Y X h Q g (dc.dc-out W X Q F Fn (compH W Y X h g) (lands-pre W Y X h DQ g l)).1)))
            (idH W) (dc.dc-out W X Q F Fn (compH W Y X h g) (lands-pre W Y X h DQ g l)).2))
      (\ W g l -> pre-lands W Y X h DQ g
         (dc.dc-in W X Q F Fn (compH W Y X h g) (lands-pre W Y X h Q g (dc.dc-out W Y (pre Y X h Q) (Fr Y h) Frn g l).1)
            (dc.dc-out W Y (pre Y X h Q) (Fr Y h) Frn g l).2)) ;
} ;

-- the dependent conjunction of pointwise equal families
dconj-cong (dc : DConj) (X : Ob) (Q : Phi X) (F F' : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W)
  (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
        -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i'))
  (Fn' : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
        -> Id (Phi V) (pre V W g (F' W f i)) (F' V (compH V W X f g) i'))
  (E : (W : Ob) (f : Hom W X) (i : Lands W X Q f) -> Id (Phi W) (F W f i) (F' W f i))
  : Id (Phi X) (dc.dconj X Q F Fn) (dc.dconj X Q F' Fn') =
  phi-ext X (dc.dconj X Q F Fn) (dc.dconj X Q F' Fn')
    (\ W f l -> dc.dc-in W X Q F' Fn' f (dc.dc-out W X Q F Fn f l).1
       (lands-sub W W (F W f (dc.dc-out W X Q F Fn f l).1) (F' W f (dc.dc-out W X Q F Fn f l).1) (E W f (dc.dc-out W X Q F Fn f l).1)
          (idH W) (dc.dc-out W X Q F Fn f l).2))
    (\ W f l -> dc.dc-in W X Q F Fn f (dc.dc-out W X Q F' Fn' f l).1
       (lands-sub W W (F' W f (dc.dc-out W X Q F' Fn' f l).1) (F W f (dc.dc-out W X Q F' Fn' f l).1) (symH (E W f (dc.dc-out W X Q F' Fn' f l).1))
          (idH W) (dc.dc-out W X Q F' Fn' f l).2)) ;

------------------------------------------------------------------------
-- sieves, coded at level l by their characteristic map

encPhiL (X : Ob) : EP.Enc (Phi X) =
  EP.encInj (Phi X) ((W : Ob) -> Hom W X -> Bool) (CEnc.chiS X) (\ Q Q' P -> CEnc.chiS-inj X Q Q' P)
    (EP.encPi0 Ob (\ W -> Hom W X -> Bool) (EP.encIx0 obV) (\ W ->
       EP.encPi0 (Hom W X) (\ f -> Bool) (EP.encIx0 (homV W X)) (\ f -> EP.encIx0 VA.boolV))) ;

phiV (X : Ob) : W0.V = EP.codeOf (Phi X) (encPhiL X) ;

------------------------------------------------------------------------
-- the identity type over the data of a path type

module IdOver (K H : PCtx) (A : PTy[H])
  (s : (X : Ob) -> W0.Ix (K.ob X) -> (W : Ob) -> Hom W X -> Hom W Iv -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (aE bE : (W : Ob) -> W0.Ix (K.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (K.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (K.act W X f x))) {
  module PT = CPath[l].PathOverE[K, H, A, true, s, sN, aE, bE, aE-act, bE-act] ;
  module TA = PT.TA ;

  -- u is constant at aE on q
  ConstC (X : Ob) (x : W0.Ix (K.ob X)) (u : W0.Ix (PT.tobP X x)) (q : Phi X) : U l =
    (W : Ob) (f : Hom W X) (i : Lands W X q f) (j : Hom W Iv) -> Id (TA.EI W) (u.1.1 W f j) (aE W (K.act W X f x)) ;

  constC-prop (X : Ob) (x : W0.Ix (K.ob X)) (u : W0.Ix (PT.tobP X x)) (q : Phi X) : isProp (ConstC X x u q) =
    isProp-Pi Ob (\ W -> (f : Hom W X) (i : Lands W X q f) (j : Hom W Iv) -> Id (TA.EI W) (u.1.1 W f j) (aE W (K.act W X f x))) (\ W ->
    isProp-Pi (Hom W X) (\ f -> (i : Lands W X q f) (j : Hom W Iv) -> Id (TA.EI W) (u.1.1 W f j) (aE W (K.act W X f x))) (\ f ->
    isProp-Pi (Lands W X q f) (\ i -> (j : Hom W Iv) -> Id (TA.EI W) (u.1.1 W f j) (aE W (K.act W X f x))) (\ i ->
    isProp-Pi (Hom W Iv) (\ j -> Id (TA.EI W) (u.1.1 W f j) (aE W (K.act W X f x))) (\ j ->
      W0.isSetIx (TA.E.ob W) (u.1.1 W f j) (aE W (K.act W X f x)))))) ;

  constV (X : Ob) (x : W0.Ix (K.ob X)) (u : W0.Ix (PT.tobP X x)) (q : Phi X) : W0.V =
    EP.codeOf (ConstC X x u q) (EP.encProp (ConstC X x u q) (constC-prop X x u q)) ;

  innerV (X : Ob) (x : W0.Ix (K.ob X)) (u : W0.Ix (PT.tobP X x)) : W0.V = W0.SigV (phiV X) (constV X x u) ;

  tobI (X : Ob) (x : W0.Ix (K.ob X)) : W0.V = W0.SigV (PT.tobP X x) (innerV X x) ;

  -- equal paths and equal sieves
  idI-eq (X : Ob) (x : W0.Ix (K.ob X)) (w w' : W0.Ix (tobI X x)) (P : Id (W0.Ix (PT.tobP X x)) w.1 w'.1)
    (Q : Id (Phi X) w.2.1 w'.2.1) : Id (W0.Ix (tobI X x)) w w' =
    idJ (W0.Ix (PT.tobP X x)) w.1
      (\ u2 P2 -> (r2 : W0.Ix (innerV X x u2)) -> Id (Phi X) w.2.1 r2.1 -> Id (W0.Ix (tobI X x)) w (u2, r2))
      (\ r2 Q2 -> apH {W0.Ix (innerV X x w.1)} {W0.Ix (tobI X x)} (\ r -> (w.1, r))
         (Sigma-eq (Phi X) (\ q -> ConstC X x w.1 q) w.2.1 r2.1 w.2.2 r2.2 Q2 (constC-prop X x w.1 r2.1)))
      w'.1 P w'.2 Q ;

  ----------------------------------------------------------------------
  -- the action

  aEq (W J I : Ob) (h : Hom J I) (f : Hom W J) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
    : Id (TA.EI W) (aE W (K.act W I (compH W J I h f) x)) (aE W (K.act W J f y)) =
    apH (aE W) (transH (K.act-o W J I h f x) (apH (K.act W J f) e)) ;

  tactI : TactTy K tobI = \ J I h x y e w ->
    (PT.tactP J I h x y e w.1,
     (pre J I h w.2.1,
      \ W f i j -> transH (w.2.2 W (compH W J I h f) (lands-pre W J I h w.2.1 f i) j) (aEq W J I h f x y e))) ;

  tactI-id : IdLaw K tobI tactI = \ I x e w ->
    idI-eq I x (tactI I I (idH I) x x e w) w (PT.tactP-id I x e w.1) (pre-id I w.2.1) ;

  tactI-o : OLaw K tobI tactI = \ K' J I f g x y z e1 e2 e3 w ->
    idI-eq K' z (tactI K' I (compH K' J I f g) x z e3 w) (tactI K' J g y z e2 (tactI J I f x y e1 w))
      (PT.tactP-o K' J I f g x y z e1 e2 e3 w.1) (symH (pre-comp K' J I g f w.2.1)) ;

  IdT : PTy[K] = mkTy K tobI tactI tactI-id tactI-o ;

  module TI = GPR.TyL[K, IdT] ;

  -- an element of the total presheaf is determined by its point, the
  -- values of its path and its sieve
  tpI-ext (W : Ob) (z z' : TI.EI W) (P : Id (W0.Ix (K.ob W)) z.1 z'.1)
    (v : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (z.2.1.1.1 V g j) (z'.2.1.1.1 V g j))
    (Q : Id (Phi W) z.2.2.1 z'.2.2.1) : Id (TI.EI W) z z' =
    idJ (W0.Ix (K.ob W)) z.1
      (\ y2 P2 -> (w2 : W0.Ix (tobI W y2)) -> ((V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (z.2.1.1.1 V g j) (w2.1.1.1 V g j))
         -> Id (Phi W) z.2.2.1 w2.2.1 -> Id (TI.EI W) z (y2, w2))
      (\ w2 v2 Q2 -> apH {W0.Ix (tobI W z.1)} {TI.EI W} (\ w -> (z.1, w)) (idI-eq W z.1 z.2 w2 (PT.path-eq W z.1 z.2.1 w2.1 v2) Q2))
      z'.1 P z'.2 v Q ;

  ----------------------------------------------------------------------
  -- the projection to the path type

  proj : CPartial[l].PMap[K, IdT, PT.PathP] =
    new CPartial[l].PMap[K, IdT, PT.PathP, \ X w -> (w.1, w.2.1), \ X w -> refl w.1,
      \ Y X h w -> refl ((extP K PT.PathP).act Y X h (w.1, w.2.1))] ;

  ----------------------------------------------------------------------
  -- reflexivity, when aE x = bE x and s is constant at the point of aE

  module Refl
    (sC : (X : Ob) (x : W0.Ix (K.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s X x W f i) (aE W (K.act W X f x)).1) {

    cv (X : Ob) (x : W0.Ix (K.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv) : TA.EI W = aE W (K.act W X f x) ;

    cn (X : Ob) (x : W0.Ix (K.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
      : Id (TA.EI V) (TA.E.act V W g (cv X x W f i)) (cv X x V (compH V W X f g) (compH V W Iv i g)) =
      transH (aE-act V W g (K.act W X f x)) (apH (aE V) (symH (K.act-o V W X f g x))) ;

    constPath (X : Ob) (x : W0.Ix (K.ob X)) (eq : Id (TA.EI X) (aE X x) (bE X x)) : W0.Ix (PT.tobP X x) =
      PT.mkPath X x (cv X x) (cn X x) (\ W f i -> symH (sC X x W f i))
        (apH (aE X) (K.act-id X x)) (transH (apH (aE X) (K.act-id X x)) eq) ;

    reflI (X : Ob) (x : W0.Ix (K.ob X)) (eq : Id (TA.EI X) (aE X x) (bE X x)) : W0.Ix (tobI X x) =
      (constPath X x eq, (topS X, \ W f i j -> refl (aE W (K.act W X f x)))) ;

    reflI-nat (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
      (eq : Id (TA.EI I) (aE I x) (bE I x)) (eq' : Id (TA.EI J) (aE J y) (bE J y))
      : Id (W0.Ix (tobI J y)) (tactI J I h x y e (reflI I x eq)) (reflI J y eq') =
      idI-eq J y (tactI J I h x y e (reflI I x eq)) (reflI J y eq')
        (PT.path-eq J y (PT.tactP J I h x y e (constPath I x eq)) (constPath J y eq') (\ W f i -> aEq W J I h f x y e))
        (phi-ext J (pre J I h (topS I)) (topS J) (\ W f i -> top-lands W J f)
           (\ W f i -> pre-lands W J I h (topS I) f (top-lands W I (compH W J I h f)))) ;
  } ;
} ;
