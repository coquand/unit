-- CDNormB.seg (L8, Delta): seg/model DNormB.seg ported (module names only).  Was: one step of the NORMALISED fillers (Eilenberg-Zilber, done
-- by recursion).  From the fillers K at [N] (with their sides, their
-- codimension-2 agreement, and their relation to the stage below), the
-- fillers K' at [N+1]:
--
--   K' b = s_i^* (K (d_i^* b))   if b = s_i^* (d_i^* b), i the first such
--   K' b = the 4a step at b       otherwise (DStageD.Step with Fp = K)
--
-- The decision (deg) is a parameter: it is the classical step
-- (DeltaHornBox.decDeg).  Proved here, by the simplicial identities:
--   sides'   K' agrees with the sides
--   fp'      (A) d_y^* (K' b) = K (d_y^* b)
--   degP     (B) K' (s_j^* c) = s_j^* (K c)
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
open CDSimpId[a] ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
open CDCapBase[a] ;

module NB (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))
  (deg : (N : Nat) (b : CDStageA[a, lz].SA[G, A, e].Prob (suc N)) -> CDNormA[a, lz].NA[G, A, e].DegFound N b) {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;
  module NAm = CDNormA[a, lz].NA[G, A, e] ;
  open NAm ;
  module SBm = CDStageB[a, lz].SB[G, A, e, eN, eE] ;
  module SDm = CDStageD[a, lz].SD[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;
  module SEm = CDStageE[a, lz].SE[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;
  module SFm = CDStageF[a, lz].SF[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;

  DegPr (N' : Nat) (K : FillTy (suc N')) (Kp : FillTy N') : U lz =
    (c : Prob N') (j : Nat) (hj : IsT (leb j N'))
    -> Id (KA.TS.EI (suc N')) (fillE (suc N') K (resP (suc N') N' (dgH N' j) c)) (KA.TS.E.act (suc N') N' (dgH N' j) (fillE N' Kp c)) ;

  LowRel : (N : Nat) -> FillTy N -> U lz = split {
    zero -> \ K -> Top ;
    suc N' -> \ K -> (Kp : FillTy N') * (SDm.FPr N' K Kp * DegPr N' K Kp) } ;

  -- uniformity of K along h, at c
  UAt (N : Nat) (K : FillTy N) (c : Prob N) (h : Hom (lin N) (lin N)) : U lz =
    Id (KA.TS.EI N) (KA.TS.E.act N N h (fillE N K c)) (fillE N K (resP N N h c)) ;

  uat-tr (N : Nat) (K : FillTy N) (c : Prob N) (h h' : Hom (lin N) (lin N)) (E : Id (Hom (lin N) (lin N)) h' h) (u : UAt N K c h')
    : UAt N K c h = subst (Hom (lin N) (lin N)) (\ k -> UAt N K c k) h' h E u ;

  uat-id (N : Nat) (K : FillTy N) (c : Prob N) : UAt N K c (idH (lin N)) =
    transH (KA.TS.E.act-id N (fillE N K c)) (symH (fill-cong N K (resP N N (idH (lin N)) c) c (resP-id N c))) ;

  -- along d_y s_i, from the relation to the stage below
  U1 (N' : Nat) (K : FillTy (suc N')) (low : LowRel (suc N') K) (y i : Nat) (hy : IsT (leb y (suc N'))) (hi : IsT (leb i N')) (c : Prob (suc N'))
    : UAt (suc N') K c (compH (lin (suc N')) (lin N') (lin (suc N')) (dl N' y) (dgH N' i)) =
    calc (KA.TS.EI (suc N')) {
        KA.TS.E.act (suc N') (suc N') (compH (lin (suc N')) (lin N') (lin (suc N')) (dl N' y) (dgH N' i)) (fillE (suc N') K c)
      =< symH (KA.TS.PE.actC (suc N') N' (suc N') (dl N' y) (dgH N' i) (fillE (suc N') K c)) >
        KA.TS.E.act (suc N') N' (dgH N' i) (KA.TS.E.act N' (suc N') (dl N' y) (fillE (suc N') K c))
      =< apH (KA.TS.E.act (suc N') N' (dgH N' i)) (low.2.1 c y hy) >
        KA.TS.E.act (suc N') N' (dgH N' i) (fillE N' low.1 (resP N' (suc N') (dl N' y) c))
      =< symH (low.2.2 (resP N' (suc N') (dl N' y) c) i hi) >
        fillE (suc N') K (resP (suc N') N' (dgH N' i) (resP N' (suc N') (dl N' y) c))
      =< fill-cong (suc N') K _ _ (symH (resP-o (suc N') N' (suc N') (dgH N' i) (dl N' y) c)) >
        fillE (suc N') K (resP (suc N') (suc N') (compH (lin (suc N')) (lin N') (lin (suc N')) (dl N' y) (dgH N' i)) c) } ;

  -- along s_i d_y on [N]
  uLo : (N : Nat) (K : FillTy N) (low : LowRel N K) (c : Prob N) (i y : Nat) (hi : IsT (leb i N)) (hy : IsT (leb y (suc N)))
    -> IsT (ltb y i) -> UAt N K c (compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N y)) = split {
    zero -> \ K low c i y hi hy lt -> absurd _ (false-true (leb-trans (suc y) i zero lt hi)) ;
    suc N' -> \ K low c -> split {
      zero -> \ y hi hy lt -> absurd _ (false-true lt) ;
      suc i' -> \ y hi hy lt -> uat-tr (suc N') K c _ _ (symH (sd-lo N' i' y lt hi)) (U1 N' K low y i' (leb-trans y i' (suc N') lt (leb-step i' N' hi)) hi c) } } ;

  uHi : (N : Nat) (K : FillTy N) (low : LowRel N K) (c : Prob N) (i y : Nat) (hi : IsT (leb i N)) (hy : IsT (leb y (suc N)))
    -> IsT (ltb (suc i) y) -> UAt N K c (compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N y)) = split {
    zero -> \ K low c i y hi hy lt -> absurd _ (false-true (leb-trans (suc (suc i)) y (suc zero) lt hy)) ;
    suc N' -> \ K low c i -> split {
      zero -> \ hi hy lt -> absurd _ (false-true lt) ;
      suc y' -> \ hi hy lt -> uat-tr (suc N') K c _ _ (symH (sd-hi N' i y' lt hy))
                                 (U1 N' K low y' i hy (leb-trans (suc i) y' (suc N') lt hy) c) } } ;

  uSD (N : Nat) (K : FillTy N) (low : LowRel N K) (c : Prob N) (i y : Nat) (hi : IsT (leb i N)) (hy : IsT (leb y (suc N)))
    : UAt N K c (compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N y)) =
    eqNDecL (UAt N K c (compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N y))) y i
      (\ q -> uat-tr N K c _ _ (symH (transH (apH (\ z -> compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N z)) q) (sd-id0 N i (leb-step i N hi))))
                (uat-id N K c))
      (\ nq -> eqNDecL (UAt N K c (compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N y))) y (suc i)
         (\ q -> uat-tr N K c _ _ (symH (transH (apH (\ z -> compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N z)) q) (sd-id1 N i hi)))
                    (uat-id N K c))
         (\ nq2 -> ltbDecL (UAt N K c (compH (lin N) (lin (suc N)) (lin N) (dgH N i) (dl N y))) y i
            (\ lt -> uLo N K low c i y hi hy lt)
            (\ ge -> uHi N K low c i y hi hy (leb-neq (suc i) y (leb-neq i y ge (neq-sym y i nq)) (neq-sym y (suc i) nq2))))) ;
} ;
