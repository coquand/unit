-- CHSub.seg (L3, inside CB, level l): substitution of an equivalence
-- structure along s : D -> G, moveEq along the lifts (identity on fibres).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module GPR = GPre[l] ;
open GPR.PS ;

------------------------------------------------------------------------
-- substitution of an equivalence structure along s : D -> G: moveEq along
-- the lifts (identity on fibres)

module HSub (D G : PCtx) (s : PSub[D, G]) (B A : PTy[G]) (al : CPartial[l].PMap[G, B, A]) {
  module SA = CSub[l].SubE[D, G, s, A] ;
  module SB = CSub[l].SubE[D, G, s, B] ;
  module SM = CSub[l].SubMap[D, G, s, B, A, al] ;

  module H = CHFibCart[l, l].HCart[D, subTy D G B s, subTy D G A s, SM.subMap, G, B, A, al, s.nt, s.nt-nat,
    SA.mV, \ W v -> refl (s.nt W v.1), SA.mV-nat, SA.mV-inj, \ X x u -> u, \ X x u -> refl (s.nt X x, u),
    SB.mV, \ W v -> refl (s.nt W v.1), SB.mV-nat, SB.mV-inj, \ X x u -> u, \ X x u -> refl (s.nt X x, u),
    SM.mE-V] ;

  subEq (e : CEquiv[l].EquivOp G B A al) : CEquiv[l].EquivOp D (subTy D G B s) (subTy D G A s) SM.subMap = H.moveEq e ;
} ;
