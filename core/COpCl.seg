-- COpCl.seg (L4, inside CB): the classifier of filling operations without
-- uniformity, for a family of sieves (model.tex §8.2: Cl = isFib).  Cl G A
-- is the type of operations (COp.OpS.Op); substitution moves the data
-- along s, fills, and reads the filler back (COpMove.Pull with the
-- identity on fibres); the laws, by extensionality (COp.OpExt): the same
-- objects part, and the fillers of data with the same values; the code
-- one level up.  Delta's horn filling is the instance (CDeltaCl).
--
-- Quarry: seg/model DeltaClassifier (Sub, FExt, clSub-idD, clSub-oD, EncD).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;

module OC (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (i : I) -> Phi (ob i))
  (encI : Enc I) (okP : (i : I) -> isProp (ok i)) {
  Cl (G : PCtx) (A : PTy[G]) : U a+ = COp[a].OpS[I, ok, ob, S, G, A].Op ;

  module P (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) {
    module SE = CSub[a].SubE[D, G, s, A] ;
    module Pl = COpMove[a, a].Pull[I, ok, ob, S, D, subTy D G A s, G, A, s.nt, s.nt-nat,
      \ W x b -> b, \ W x b -> b, \ W x b -> refl b, \ W x b -> refl b, SE.mV-nat, c] ;
  } ;

  clSub (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) : Cl D (subTy D G A s) = P[D, G, s, A, c].Pl.op ;

  clSub-id (G : PCtx) (A : PTy[G]) (c : Cl G A)
    : Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c) =
    COp[a].OpExtE[I, ok, ob, S, G].isOpExt A c
      ((subTy G G A (idS G)).tact, ((subTy G G A (idS G)).tact-id, (subTy G G A (idS G)).tact-o))
      (\ J I0 f x y e x' -> tact-irr G A J I0 f x y e (ntEq G G (idS G) J I0 f x y e) x')
      (clSub G G (idS G) A c)
      (\ i o rho v pp pnA pnB ->
         apH {COp[a].OpS[I, ok, ob, S, G, A].HData i rho} {W0.Ix (A.tob (ob i) rho)} (\ hd -> (c i o rho hd).1)
           (COp[a].OpS[I, ok, ob, S, G, A].hd-eq i rho (v, (pp, pnA)) (P[G, G, idS G, A, c].Pl.mv i rho (v, (pp, pnB))) (refl v))) ;

  clSub-o (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
    : Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                   (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)) =
    COp[a].OpExtE[I, ok, ob, S, T].isOpExt (subTy T G A (oS T D G s s')) (clSub T G (oS T D G s s') A c)
      ((subTy T D (subTy D G A s) s').tact, ((subTy T D (subTy D G A s) s').tact-id, (subTy T D (subTy D G A s) s').tact-o))
      (\ J I0 f x y e x' -> tact-irr G A J I0 f (s.nt I0 (s'.nt I0 x)) (s.nt J (s'.nt J y)) (ntEq T G (oS T D G s s') J I0 f x y e)
                              (ntEq D G s J I0 f (s'.nt I0 x) (s'.nt J y) (ntEq T D s' J I0 f x y e)) x')
      (clSub T D s' (subTy D G A s) (clSub D G s A c))
      (\ i o rho v pp pnA pnB ->
         apH {COp[a].OpS[I, ok, ob, S, G, A].HData i (s.nt (ob i) (s'.nt (ob i) rho))} {W0.Ix (A.tob (ob i) (s.nt (ob i) (s'.nt (ob i) rho)))}
           (\ hd -> (c i o (s.nt (ob i) (s'.nt (ob i) rho)) hd).1)
           (COp[a].OpS[I, ok, ob, S, G, A].hd-eq i (s.nt (ob i) (s'.nt (ob i) rho))
              (P[T, G, oS T D G s s', A, c].Pl.mv i rho (v, (pp, pnA)))
              (P[D, G, s, A, c].Pl.mv i (s'.nt (ob i) rho) (P[T, D, s', subTy D G A s, clSub D G s A c].Pl.mv i rho (v, (pp, pnB))))
              (refl (\ W f j -> (s.nt W (s'.nt W (v W f j).1), (v W f j).2))))) ;

  -- the code one level up
  module En (G : PCtx) (A : PTy[G]) {
    module F = COp[a].OpS[I, ok, ob, S, G, A] ;
    module EP = CEnc.EncP[G, A] ;
    module TA = GPR.TyL[G, A] ;

    encHD (i : I) (rho : W0.Ix (G.ob (ob i))) : Enc (F.HData i rho) =
      encSig (F.PT.PvTy (ob i) (S i)) (\ v -> F.PT.PptTy (ob i) rho (S i) v * F.PT.PnTy (ob i) (S i) v)
        (EP.encPv (ob i) (S i))
        (\ v -> encProp (F.PT.PptTy (ob i) rho (S i) v * F.PT.PnTy (ob i) (S i) v)
                  (isProp-Sigma (F.PT.PptTy (ob i) rho (S i) v) (\ z -> F.PT.PnTy (ob i) (S i) v)
                     (F.PT.isProp-Ppt (ob i) rho (S i) v) (\ z -> F.PT.isProp-Pn (ob i) (S i) v))) ;

    encExt (i : I) (rho : W0.Ix (G.ob (ob i))) (h : F.HData i rho) : Enc (F.FExt i rho h) =
      encSig (W0.Ix (A.tob (ob i) rho)) (\ a0 -> F.Cond i rho h a0) (encIx0 (A.tob (ob i) rho))
        (\ a0 -> encProp (F.Cond i rho h a0) (F.isProp-Cond i rho h a0)) ;

    enc : Enc (Cl G A) =
      encPi0 I (\ i -> ok i -> (rho : W0.Ix (G.ob (ob i))) -> (h : F.HData i rho) -> F.FExt i rho h) encI (\ i ->
      encPi0 (ok i) (\ o -> (rho : W0.Ix (G.ob (ob i))) -> (h : F.HData i rho) -> F.FExt i rho h) (encProp (ok i) (okP i)) (\ o ->
      encPi0 (W0.Ix (G.ob (ob i))) (\ rho -> (h : F.HData i rho) -> F.FExt i rho h) (encIx0 (G.ob (ob i))) (\ rho ->
      encPi0 (F.HData i rho) (\ h -> F.FExt i rho h) (encHD i rho) (\ h -> encExt i rho h)))) ;
  } ;

  encCl (X : Ob) (A : PTy[yP X]) : Enc (Cl (yP X) A) = En[yP X, A].enc ;

  opaque encCl ;
} ;
