-- CDeltaFinal.seg (L8, Delta, inside CClassical.Cl): the final statements
-- for simplicial sets.  El is fibrant (CDeltaElFib: hornbox (2) applied to
-- El's horn filling, the one use of excluded middle); smallCl / (C1) /
-- (C2) for the classifier isFib (CDSmallCl, CDSmallFull); univalence
-- (CUaOp.ua) and the universe fibrant (CFibU3.fibU).  Theorem 7 is
-- DB.CThm7.Thm7.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DCl = CDeltaCl[a] ;
module CL = DCl.CL ;
module DU = DCl.DU ;
module SC = CDSmallCl[a].SC[CDeltaElFib[a].elFibD] ;

smallCl-full (W : Nat) (y : DB.CGlueE.GE[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl].GD1 W)
  (q : IsT (DB.CGlueD.fl W y.1.2.1 W (DB.idH W)))
  : Id (DU.U0 W) (DB.CSmall.xsub (DB.GYon[a].yP W) SC.UB.GDr SC.XS.SA (SC.UB.yhat W y), SC.smallCl (DB.GYon[a].yP W) (SC.UB.yhat W y))
                 (y.1.2.2.1 W (DB.idH W) q) =
  CDSmallFull2[a].SFD2[CDeltaElFib[a].elFibD, W, y, q].law ;

module UO = DB.CUaOp.UaOp[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl, CDeltaElFib[a].elFibD, SC.smallCl, SC.smallCl-sub, smallCl-full] ;

-- univalence for the universe of simplicial sets
ua : DB.CPartial[a+].ContrOp UO.UU.UCtx UO.UA.UaTy = UO.ua ;

-- the universe of simplicial sets is fibrant, in any context
fibU (G : DB.GPre[a+].PS.PCtx) : DB.CLine[a+].Lines[G, DU.UTy G].Fib =
  DB.CFibU3.FibU[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl, CDeltaElFib[a].elFibD, SC.smallCl, SC.smallCl-sub, smallCl-full, G].fibU ;
