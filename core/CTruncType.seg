-- The normal forms as an actual V-valued type in the presheaf model.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module Trunc (G : PCtx) (A : PTy[G]) {
  open PR.TyL[G, A] ;
  open CTruncRaw[a, l].Build[G, A] ;
  open CTruncGood[a, l].GoodSets[G, A] ;
  open CTruncLaws[a, l].Laws[G, A] ;
  tob (X : Ob) (x : Pt X) : W.V = truncV (X,x) ;
  tact (Y X : Ob) (f : Hom Y X) (x : Pt X) (y : Pt Y)
    (e : Id (Pt Y) (G.act Y X f x) y) (t : TrEl (X,x)) : TrEl (Y,y) =
    tr-res (Y,y) (X,x) (f,e) t ;
  tid (X : Ob) (x : Pt X) (e : Id (Pt X) (G.act X X (idH X) x) x) (t : TrEl (X,x))
    : Id (TrEl (X,x)) (tact X X (idH X) x x e t) t =
    transH (apH (\ h -> tr-res (X,x) (X,x) h t)
      (arr-eq (X,x) (X,x) (idH X,e) (ident (X,x)) (refl (idH X)))) (tr-res-id (X,x) t) ;
  to (Z Y X : Ob) (f : Hom Y X) (g : Hom Z Y) (x : Pt X) (y : Pt Y) (z : Pt Z)
    (e1 : Id (Pt Y) (G.act Y X f x) y) (e2 : Id (Pt Z) (G.act Z Y g y) z)
    (e3 : Id (Pt Z) (G.act Z X (compH Z Y X f g) x) z) (t : TrEl (X,x))
    : Id (TrEl (Z,z)) (tact Z X (compH Z Y X f g) x z e3 t) (tact Z Y g y z e2 (tact Y X f x y e1 t)) =
    transH (apH (\ h -> tr-res (Z,z) (X,x) h t)
      (arr-eq (Z,z) (X,x) (compH Z Y X f g,e3) (compose (Z,z) (Y,y) (X,x) (f,e1) (g,e2))
        (refl (compH Z Y X f g))))
      (symH (tr-res-o (Z,z) (Y,y) (X,x) (f,e1) (g,e2) t)) ;
  opaque tid ; opaque to ;
  truncTy : PTy[G] = mkTy G tob tact tid to ;
  inc-nat (Y X : Ob) (f : Hom Y X) (x : Pt X) (y : Pt Y)
    (e : Id (Pt Y) (G.act Y X f x) y) (v : T X x)
    : Id (TrEl (Y,y)) (tact Y X f x y e (inc (X,x) v)) (inc (Y,y) (A.tact Y X f x y e v)) =
    tr-eq (Y,y) _ _ (refl (leaf (Y,y) (A.tact Y X f x y e v))) ;
  opaque inc-nat ;
} ;
