-- CPostFib.seg: fibrancy of the coded products and internal tower limit.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LD = CLocD[a, l] ;
module HO = PB.CHtpyOps[l] ;


module ProductC (G : PCtx) (B : Nat -> PTy[G]) (e e' : PB.IPt)
  (cs : (N : Nat) -> PB.CLine[l].Lines[G, B N].CompK[e, e'].Comp) {
  module P = CPostLimit[a, l].Product[G, B] ;
  module TP = PR.TyL[G, P.T] ;
  module FS = PB.CLine[l].FT[G, P.T] ;
  module CS = PB.CLine[l].Lines[G, P.T].CompK[e, e'] ;
  module KS = CS.EK ;
  module TT = PR.TyL[KS.TV.E, CS.Tend] ;
  module RS = PB.CPartial[l].Rel[KS.TV.E, KS.SFm.SF, CS.Tend, CS.endL] ;
  module At (N : Nat) {
    module TA = PR.TyL[G, B N] ;
    module FA = PB.CLine[l].FT[G, B N] ;
    module CA = PB.CLine[l].Lines[G, B N].CompK[e, e'] ;
    module KA = CA.EK ;
    module TTA = PR.TyL[KA.TV.E, CA.Tend] ;
    module RA = PB.CPartial[l].Rel[KA.TV.E, KA.SFm.SF, CA.Tend, CA.endL] ;
    pN : PSub[TP.E, TA.E] = new PSub[TP.E, TA.E, \ X z -> (z.1, z.2 N), \ Y X f z -> refl (TA.E.act Y X f (z.1, z.2 N))] ;
    module MA = PB.CLine[l].FMap[TP.E, TA.E, pN] ;
    tvA (X : Ob) (w : KS.TV.EI X) : KA.TV.EI X = (w.1, w.2 N) ;
  -- of a line in Sigma over x: a line in A over x
  lineA (X : Ob) (x : W.Ix (FS.FG.ob X)) (L : W.Ix (FS.tobF X x)) : W.Ix (FA.tobF X x) =
    (MA.mapF X L.1, transH (FA.FG.fam-eq X (FA.piL X (MA.mapF X L.1)) (FS.piL X L.1) (\ W f i -> refl (L.1.1 W f i).1)) L.2) ;

  -- its end is the A part of the end
  endA (W : Ob) (u : KS.TS.EI W)
    : Id (KA.TV.EI W) (FA.Ev[e].evA.mE W (u.1.1, lineA W u.1.1 u.2.1)) (tvA W u.1) =
    KA.tv-eq W (FA.Ev[e].evA.mE W (u.1.1, lineA W u.1.1 u.2.1)) (tvA W u.1) (refl u.1.1)
      (calc (TA.EI W) {
          KA.endE W (FA.Ev[e].evA.mE W (u.1.1, lineA W u.1.1 u.2.1))
        =< FA.Ev[e].endB-E W (u.1.1, lineA W u.1.1 u.2.1) >
          pN.nt W (u.2.1.1.1 W (idH W) (PB.ptH W (e)))
        =< apH (pN.nt W) (symH (FS.Ev[e].endB-E W (u.1.1, u.2.1))) >
          pN.nt W (KS.endE W (FS.Ev[e].evA.mE W (u.1.1, u.2.1)))
        =< apH (\ z -> pN.nt W (KS.endE W z)) u.2.2 >
          KA.endE W (tvA W u.1) }) ;

  tsA (W : Ob) (u : KS.TS.EI W) : KA.TS.EI W = (tvA W u.1, (lineA W u.1.1 u.2.1, endA W u)) ;

  tsA-act (V W : Ob) (g : Hom V W) (u : KS.TS.EI W)
    : Id (KA.TS.EI V) (KA.TS.E.act V W g (tsA W u)) (tsA V (KS.TS.E.act V W g u)) =
    KA.ts-ext V (KA.TS.E.act V W g (tsA W u)) (tsA V (KS.TS.E.act V W g u)) (refl (KA.TV.E.act V W g (tvA W u.1)))
      (\ V' g' j -> refl (pN.nt V' (u.2.1.1.1 V' (compH V' V W g g') j))) ;

  opaque endA ;

  -- the A part of a side
  sideA (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) : KA.PT.Side[X, tvA X w] =
    new KA.PT.Side[X, tvA X w, sd.pQ, \ V f i -> tsA V (sd.pv V f i),
      \ V f i -> apH (tvA V) (sd.ppt V f i),
      \ V' V chi f i i' -> transH (tsA-act V' V chi (sd.pv V f i)) (apH (tsA V') (sd.pnat V' V chi f i i'))] ;

  sideA-restr (Y X : Ob) (h : Hom Y X) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w])
    : Id (KA.PT.Side[Y, tvA Y (KS.TV.E.act Y X h w)])
         (subst (KA.TV.EI Y) (\ z -> KA.PT.Side[Y, z]) (KA.TV.E.act Y X h (tvA X w)) (tvA Y (KS.TV.E.act Y X h w))
            (refl (tvA Y (KS.TV.E.act Y X h w))) (KA.PT.rside Y X h (tvA X w) (sideA X w sd)))
         (sideA Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd)) =
    KA.PT.side-extH Y (KA.TV.E.act Y X h (tvA X w)) (tvA Y (KS.TV.E.act Y X h w)) (refl (tvA Y (KS.TV.E.act Y X h w)))
      (KA.PT.rside Y X h (tvA X w) (sideA X w sd)) (sideA Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))
      (refl (PB.pre Y X h sd.pQ))
      (\ V g i i' -> apH (tsA V) (KS.PT.pv-irr X w sd V (compH V Y X h g) (PB.lands-pre V Y X h sd.pQ g i) (PB.lands-pre V Y X h sd.pQ g i'))) ;

  opaque sideA-restr ;


    proj (X : Ob) (u : TT.EI X) : TTA.EI X = (tvA X u.1, u.2 N) ;
    proj-act (Y X : Ob) (h : Hom Y X) (u : TT.EI X)
      : Id (TTA.EI Y) (proj Y (TT.E.act Y X h u)) (TTA.E.act Y X h (proj X u)) = refl (proj Y (TT.E.act Y X h u)) ;
    proj-end (X : Ob) (u : KS.TS.EI X)
      : Id (TTA.EI X) (proj X (CS.endL.mE X u)) (CA.endL.mE X (tsA X u)) =
      CA.SE.mV-inj X _ _ (refl (tvA X u.1))
        (PB.CLine[l].EndKit[G, B N, e'].tv-eq X _ _ (refl u.1.1)
          (transH (apH (pN.nt X) (FS.Ev[e'].endB-E X (KS.lineL X u)))
            (symH (FA.Ev[e'].endB-E X (KA.lineL X (tsA X u)))))) ;
    proj-endS (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) (V : Ob) (f : Hom V X) (i : PB.Lands V X sd.pQ f)
      : Id (TTA.EI V) (CA.endL.mE V ((sideA X w sd).pv V f i)) (proj V (CS.endL.mE V (sd.pv V f i))) =
      symH (proj-end V (sd.pv V f i)) ;
    opaque proj-end ;
  } ;
  ext (X : Ob) (u v : TT.EI X) (ep : Id (KS.TV.EI X) u.1 v.1)
    (eq : (N : Nat) -> Id (At[N].TTA.EI X) (At[N].proj X u) (At[N].proj X v)) : Id (TT.EI X) u v =
    idJ (KS.TV.EI X) u.1
      (\ z p -> (w : TT.T X z) -> ((N : Nat) -> Id (At[N].TTA.EI X) (At[N].proj X u) (At[N].proj X (z, w))) -> Id (TT.EI X) u (z, w))
      (\ w q -> apH {TT.T X u.1} {TT.EI X} (\ v1 -> (u.1, v1))
        (funext Nat (\ N -> At[N].TTA.T X (At[N].tvA X u.1)) u.2 w
          (\ N -> At[N].TTA.pr-inj X (At[N].tvA X u.1) (u.2 N) (w N) (q N)))) v.1 ep v.2 eq ;
  opaque ext ;
  kop (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) : TT.T X w =
    \ N -> (cs N).kop X (At[N].tvA X w) (At[N].sideA X w sd) ;
  kside (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) (V : Ob) (f : Hom V X) (i : PB.Lands V X sd.pQ f)
    : Id (TT.EI V) (TT.E.act V X f (w, kop X w sd)) (CS.endL.mE V (sd.pv V f i)) =
    ext V _ _ (symH (sd.ppt V f i)) (\ N ->
      transH {At[N].TTA.EI V} {At[N].proj V (TT.E.act V X f (w, kop X w sd))}
             {At[N].CA.endL.mE V ((At[N].sideA X w sd).pv V f i)} {At[N].proj V (CS.endL.mE V (sd.pv V f i))}
        ((cs N).kside X (At[N].tvA X w) (At[N].sideA X w sd) V f i)
        (At[N].proj-endS X w sd V f i)) ;
  opaque kside ;
  kunif (Y X : Ob) (h : Hom Y X) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w])
    : Id (TT.EI Y) (TT.E.act Y X h (w, kop X w sd)) (KS.TV.E.act Y X h w, kop Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd)) =
    ext Y _ _ (refl (KS.TV.E.act Y X h w)) (\ N ->
      transH {At[N].TTA.EI Y} {At[N].proj Y (TT.E.act Y X h (w, kop X w sd))}
             {(At[N].KA.TV.E.act Y X h (At[N].tvA X w),
               (cs N).kop Y (At[N].KA.TV.E.act Y X h (At[N].tvA X w)) (At[N].KA.PT.rside Y X h (At[N].tvA X w) (At[N].sideA X w sd)))}
             {At[N].proj Y (KS.TV.E.act Y X h w, kop Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))}
        ((cs N).kunif Y X h (At[N].tvA X w) (At[N].sideA X w sd))
        (At[N].RA.kop-cong (cs N) Y (At[N].KA.TV.E.act Y X h (At[N].tvA X w)) (At[N].tvA Y (KS.TV.E.act Y X h w))
          (refl (At[N].tvA Y (KS.TV.E.act Y X h w)))
          (At[N].KA.PT.rside Y X h (At[N].tvA X w) (At[N].sideA X w sd))
          (At[N].sideA Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))
          (At[N].sideA-restr Y X h w sd))) ;
  opaque kunif ;
  comp : CS.Comp = new RS.RC[kop, kside, kunif] ;
} ;
module ProductFib (G : PCtx) (B : Nat -> PTy[G]) (cs : (N : Nat) -> PB.CLine[l].Lines[G, B N].Fib) {
  fib : PB.CLine[l].Lines[G, CPostLimit[a, l].Product[G, B].T].Fib =
    (ProductC[G, B, e0, e1, \ N -> (cs N).1].comp, ProductC[G, B, e1, e0, \ N -> (cs N).2].comp) ;
} ;

------------------------------------------------------------------------
-- the path type of a homotopy between two maps is fibrant

module HTFib (G : PCtx) (A B : PTy[G]) (al be : HO.NMap[G, A, B]) (fB : PB.CLine[l].Lines[G, B].Fib) {
  module T = HO.HT[G, A, B, al, be] ;
  sF (X : Ob) (z : W.Ix (T.GA.ob X)) (V W1 : Ob) (g : Hom V W1) (f : Hom W1 X) (i : Hom W1 Iv)
    : Id (W.Ix (G.ob V)) (G.act V W1 g (T.s X z W1 f i)) (T.s X z V (compH V W1 X f g) (compH V W1 Iv i g)) =
    symH (G.act-o V W1 X f g z.1) ;
  aE-pt (W1 : Ob) (z : W.Ix (T.GA.ob W1)) : Id (W.Ix (G.ob W1)) (T.aE W1 z).1 (T.s W1 z W1 (idH W1) (PB.ptH W1 PB.e0)) =
    symH (G.act-id W1 z.1) ;
  bE-pt (W1 : Ob) (z : W.Ix (T.GA.ob W1)) : Id (W.Ix (G.ob W1)) (T.bE W1 z).1 (T.s W1 z W1 (idH W1) (PB.ptH W1 PB.e1)) =
    symH (G.act-id W1 z.1) ;
  module C (e e' : PB.IPt) (cB : PB.CLine[l].Lines[G, B].CompK[e, e'].Comp) {
    module PC = PB.CPathComp[l].PathC[T.GA, G, B, true, T.s, T.sN, sF, T.aE, T.bE, T.aE-act, T.bE-act, aE-pt, bE-pt, e, e', cB] ;
  } ;
  fib : PB.CLine[l].Lines[T.GA, T.PT.PathP].Fib = (C[PB.e0, PB.e1, fB.1].PC.comp, C[PB.e1, PB.e0, fB.2].PC.comp) ;
} ;

------------------------------------------------------------------------
-- the internal limit of a tower of fibrant types is fibrant

module TowerFib (G : PCtx) (B : Nat -> PTy[G]) (r : (N : Nat) -> HO.NMap[G, B (suc N), B N])
  (fB : (N : Nat) -> PB.CLine[l].Lines[G, B N].Fib) {
  module T = CPostLimit[a, l].Tower[G, B, r] ;
  seqFib : PB.CLine[l].Lines[G, T.Seq.T].Fib = ProductFib[G, B, fB].fib ;
  edgeFib (N : Nat) : PB.CLine[l].Lines[T.GS, T.Edge[N].P.PathP].Fib =
    HTFib[G, T.Seq.T, B N, T.Edge[N].left, T.Seq.ev N, fB N].fib ;
  edgesFib : PB.CLine[l].Lines[T.GS, T.Edges.T].Fib = ProductFib[T.GS, \ N -> T.Edge[N].P.PathP, edgeFib].fib ;
  fib : PB.CLine[l].Lines[G, T.L].Fib = PB.CSig[l].SigFib[G, T.Seq.T, T.Edges.T, seqFib, edgesFib].fib ;
} ;

-- the internal limit of the D_N A
module PostFib (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  module P = CPostLimit[a, l].Post[G, A] ;
  fib : PB.CLine[l].Lines[G, P.L].Fib = TowerFib[G, P.B, P.r, \ N -> CLocDN[a, l].DN[G, A, N, c].fib].fib ;
} ;
