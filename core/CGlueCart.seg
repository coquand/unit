-- CGlueCart.seg (L5/L6, inside CB): a glue datum read through carts.
-- Given, at stage X, the code F, a sieve ph, B-codes with their
-- naturality over RC(X , ph), a triple (Bg , Ag , alg) over a level-a+
-- context G with an equivalence structure eg, a map io : RC(X , ph) -> G,
-- and carts B -> Bg and A -> Ag over io (A = F over RC), the glue datum
-- (F , ph , B , alpha , e) has alpha = alg read back through the A-cart
-- and e = eg moved along the cart of triples (CHFibCart).  Its
-- naturality is that of the carts.
--
-- Instances: step (a) of univalence (G the full extent of GD, the
-- universal triple, e_U), step (b) (G = GD, the small copy SA).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module GC (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (X : Ob) (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) (ph : Phi X)
  (B : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BTy X ph)
  (bn : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BNat X ph B)
  (G : L.PCtx) (Bg Ag : L.PTy[G]) (alg : CPartial[a+].PMap[G, Bg, Ag]) (eg : CEquiv[a+].EquivOp G Bg Ag alg)
  (io : (W : Ob) -> W0.Ix ((CGlueE.RCm[X, ph].RC).ob W) -> V1.Ix (G.ob W))
  (io-nat : (V W : Ob) (g : Hom V W) (r : W0.Ix ((CGlueE.RCm[X, ph].RC).ob W))
     -> Id (V1.Ix (G.ob V)) (io V ((CGlueE.RCm[X, ph].RC).act V W g r)) (G.act V W g (io W r)))
  -- the A-cart
  (tA : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W -> LP.TyL[G, Ag].EI W)
  (tApt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (V1.Ix (G.ob W)) (tA W v).1 (io W v.1))
  (tAnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (tA W v))
          (tA V (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].E.act V W g v)))
  (tAinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (tA W v) (tA W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W) v v')
  (bkA : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x))) -> W0.Ix (F.1.tob Y x.1))
  (bkAta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x)))
     -> Id (LP.TyL[G, Ag].EI Y) (tA Y (x, bkA Y x z)) (io Y x, z))
  -- the B-cart
  (tB : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W -> LP.TyL[G, Bg].EI W)
  (tBpt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (V1.Ix (G.ob W)) (tB W v).1 (io W v.1))
  (tBnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (tB W v))
          (tB V (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].E.act V W g v)))
  (tBinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (tB W v) (tB W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W) v v')
  (bkB : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> W0.Ix ((CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn).tob Y x))
  (bkBta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> Id (LP.TyL[G, Bg].EI Y) (tB Y (x, bkB Y x z)) (io Y x, z)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module R = CGlueE.RCm[X, ph] ;
  At0 : PTy[R.RC] = subTy R.RC (yP X) F.1 R.inclRC ;
  Bt0 : PTy[R.RC] = GE.BtOf X ph B bn ;
  module TAt = GPR.TyL[R.RC, At0] ;
  module TBt = GPR.TyL[R.RC, Bt0] ;
  module TAg = LP.TyL[G, Ag] ;
  module TBg = LP.TyL[G, Bg] ;

  ----------------------------------------------------------------------
  -- alpha: alg read back through the A-cart

  gv (W : Ob) (r : W0.Ix (R.RC.ob W)) (b : W0.Ix (Bt0.tob W r)) : V1.Ix (Ag.tob W (io W r)) =
    TAg.fromE W (io W r) (alg.mE W (tB W (r, b))) (transH (alg.mpt W (tB W (r, b))) (tBpt W (r, b))) ;

  gv-E (W : Ob) (r : W0.Ix (R.RC.ob W)) (b : W0.Ix (Bt0.tob W r)) : Id (TAg.EI W) (io W r, gv W r b) (alg.mE W (tB W (r, b))) =
    TAg.fromE-eq W (io W r) (alg.mE W (tB W (r, b))) (transH (alg.mpt W (tB W (r, b))) (tBpt W (r, b))) ;

  al (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X ph W f)) (b : W0.Ix (UU.fib0 W (B W f q))) : W0.Ix (F.1.tob W f) =
    bkA W (f, q) (gv W (f, q) b) ;

  -- read in Ag, alpha is alg
  al-g (W : Ob) (r : W0.Ix (R.RC.ob W)) (b : W0.Ix (Bt0.tob W r)) : Id (TAg.EI W) (tA W (r, al W r.1 r.2 b)) (alg.mE W (tB W (r, b))) =
    transH (bkAta W r (gv W r b)) (gv-E W r b) ;

  opaque al-g ;

  module AN (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (CGlueD.fl X ph W f)) (q2 : IsT (CGlueD.fl X ph W' (compH W' W X f chi)))
    (b : W0.Ix (UU.fib0 W (B W f q))) {
    fc : Hom W' X = compH W' W X f chi ;
    r : W0.Ix (R.RC.ob W) = (f, q) ;
    r2 : W0.Ix (R.RC.ob W') = (fc, q2) ;
    e2 : Id (W0.Ix (R.RC.ob W')) (R.RC.act W' W chi r) r2 = R.pt-eq W' (R.RC.act W' W chi r) r2 (refl fc) ;
    tg : W0.Ix (UU.fib0 W' (B W' fc q2)) = UU.tactG W' W chi (B W f q) (B W' fc q2) (bn W' W chi f q fc (refl fc) q2) b ;
    lhs : W0.Ix (F.1.tob W' fc) = al W' fc q2 tg ;
    rhs : W0.Ix (F.1.tob W' fc) = F.1.tact W' W chi f fc (refl fc) (al W f q b) ;

    PV : Id (TAt.EI W') (TAt.E.act W' W chi (r, al W f q b)) (r2, rhs) =
      transH (TAt.pr-tact W' W chi r r2 e2 (al W f q b))
        (apH {W0.Ix (F.1.tob W' fc)} {TAt.EI W'} (\ z -> (r2, z))
           (tact-irr (yP X) F.1 W' W chi f fc (ntEq R.RC (yP X) R.inclRC W' W chi r r2 e2) (refl fc) (al W f q b))) ;

    PB : Id (TBt.EI W') (TBt.E.act W' W chi (r, b)) (r2, tg) =
      transH (TBt.pr-tact W' W chi r r2 e2 b)
        (apH {W0.Ix (UU.fib0 W' (B W' fc q2))} {TBt.EI W'} (\ z -> (r2, z))
           (CSmall.tact-irr UU.UCtx UU.El W' W chi (B W f q) (B W' fc q2) (bn W' W chi f q fc (apH (\ z -> z.1) e2) q2)
              (bn W' W chi f q fc (refl fc) q2) b)) ;

    chainR : Id (TAg.EI W') (tA W' (r2, rhs)) (alg.mE W' (tB W' (r2, tg))) =
      transH (apH (tA W') (symH PV))
       (transH (symH (tAnat W' W chi (r, al W f q b)))
        (transH (apH (TAg.E.act W' W chi) (al-g W r b))
         (transH (symH (alg.mnat W' W chi (tB W (r, b))))
          (apH (alg.mE W') (transH (tBnat W' W chi (r, b)) (apH (tB W') PB)))))) ;

    res : Id (W0.Ix (F.1.tob W' fc)) lhs rhs =
      TAt.pr-inj W' r2 lhs rhs (tAinj W' (r2, lhs) (r2, rhs) (refl r2) (transH (al-g W' r2 tg) (symH chainR))) ;
  } ;

  aln : DD.AlNat X F ph B bn al = \ W' W chi f q f2 E q2 b ->
    idJ (Hom W' X) (compH W' W X f chi)
      (\ f3 E3 -> (q3 : IsT (CGlueD.fl X ph W' f3))
         -> Id (W0.Ix (F.1.tob W' f3)) (al W' f3 q3 (UU.tactG W' W chi (B W f q) (B W' f3 q3) (bn W' W chi f q f3 E3 q3) b))
                                     (F.1.tact W' W chi f f3 E3 (al W f q b)))
      (\ q3 -> AN[W', W, chi, f, q, q3, b].res) f2 E q2 ;

  opaque aln ;

  ----------------------------------------------------------------------
  -- the glue datum, with eg moved along the cart of triples

  bd0 : DD.BD X F ph = (B, (bn, (al, aln))) ;

  module T0 = GE.Tr[X, F, ph, bd0] ;

  comm (W : Ob) (v : T0.TBt.EI W) : Id (TAg.EI W) (tA W (T0.al.mE W v)) (alg.mE W (tB W v)) = al-g W v.1 v.2 ;

  module H = CHFibCart[a+, a].HCart[R.RC, T0.Bt, T0.At, T0.al, G, Bg, Ag, alg, io, io-nat,
    tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta, comm] ;

  dat : GE.GD1 X = ((F, (ph, bd0)), H.moveEq eg) ;
} ;
