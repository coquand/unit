-- CFibU1.seg (L7, inside CB): the fibrancy of the universe, the side
-- value (model.tex Thm "fibU", proof).  For a line of codes lam at X, the
-- full glue datum over its code F at tgt d (given with a path pF, so that
-- restriction lands on F h) whose B is the code at src d and
-- whose alpha and equivalence are transport along lam from src d to tgt d:
-- CGlueCart through the map RC(X , top) -> lines of codes, (f , q) |->
-- lam f, from transport's equivalence on El over the lines of codes
-- (CTrE.TrF).  Same construction as CUaD with this point map.
--
-- Quarry: seg/model GCompU1, GCompU3.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module SV (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  (X : Ob) (lam : V1.Ix (CLine[a+].FC[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx].ob X)) (d : Bool)
  (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) (pF : Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) ((CLine[a+].FC[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx].ev (tgt d)).nt X lam) F)
  (ph : Phi X) (full : IsT (allS X ph)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module FGU = CLine[a+].FC[UU.UCtx] ;
  module TF = CTrE[a+].TrF[UU.UCtx, UU.EGen, elFib, d] ;
  GIU : L.PCtx = FGU.GI ;
  module TAg = LP.TyL[GIU, TF.SA] ;
  module TBg = LP.TyL[GIU, TF.SB] ;
  module R = CGlueE.RCm[X, ph] ;

  -- the codes of a line at the ends
  cT (W : Ob) (y : V1.Ix (GIU.ob W)) : UU.U0 W = (FGU.ev (tgt d)).nt W y ;
  cS (W : Ob) (y : V1.Ix (GIU.ob W)) : UU.U0 W = (FGU.ev (src d)).nt W y ;

  -- the line at r
  ell (W : Ob) (r : W0.Ix (R.RC.ob W)) : V1.Ix (GIU.ob W) = FGU.actF W X r.1 lam ;

  ell-nat (V W : Ob) (k : Hom V W) (r : W0.Ix (R.RC.ob W)) : Id (V1.Ix (GIU.ob V)) (ell V (R.RC.act V W k r)) (GIU.act V W k (ell W r)) =
    FGU.actF-o V W X r.1 k lam ;

  -- the A-code at r is F r
  PF (W : Ob) (r : W0.Ix (R.RC.ob W)) : Id (UU.U0 W) (cT W (ell W r)) (UU.uAct W X r.1 F) =
    transH (FGU.evN (tgt d) W X r.1 lam) (apH (UU.uAct W X r.1) pF) ;

  ----------------------------------------------------------------------
  -- B: the universal B along ell

  B (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X ph W f)) : UU.U0 W = cS W (ell W (f, q)) ;

  bn : DD.BNat X ph B = \ W' W chi f q f2 E q2 ->
    transH (symH (FGU.evN (src d) W' W chi (ell W (f, q))))
      (transH (apH (cS W') (symH (ell-nat W' W chi (f, q))))
              (apH (\ r -> cS W' (ell W' r)) (R.pt-eq W' (R.RC.act W' W chi (f, q)) (f2, q2) E))) ;

  ----------------------------------------------------------------------
  -- the A-cart: At(d) over RC(X , ph) -> A_U over ell

  At0 : PTy[R.RC] = subTy R.RC (yP X) F.1 R.inclRC ;
  module TAt = GPR.TyL[R.RC, At0] ;

  o (W : Ob) (k : Hom W X) : W0.V = F.1.tob W k ;

  trH (W : Ob) (k k' : Hom W X) (p : Id (Hom W X) k k') (z : W0.Ix (o W k)) : W0.Ix (o W k') =
    subst (Hom W X) (\ k2 -> W0.Ix (o W k2)) k k' p z ;

  trH-V (W : Ob) (k k' : Hom W X) (p : Id (Hom W X) k k') (z : W0.Ix (o W k))
    : Id (W0.Ix (o W k')) (trH W k k' p z) (CExtEq1.sV (o W k) (o W k') (apH (o W) p) z) =
    subst-ap (Hom W X) W0.V (o W) (\ v -> W0.Ix v) k k' p z ;

  trB (W : Ob) (G G' : UU.U0 W) (p : Id (UU.U0 W) G G') (b : W0.Ix (UU.fib0 W G)) : W0.Ix (UU.fib0 W G') =
    subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) G G' p b ;

  -- a value of F at f, read in u_f's A-code at the identity
  toA (W : Ob) (r : W0.Ix (R.RC.ob W)) (a0 : W0.Ix (o W r.1)) : W0.Ix (UU.fib0 W (cT W (ell W r))) =
    trB W (UU.uAct W X r.1 F) (cT W (ell W r)) (symH (PF W r)) (trH W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a0) ;

  fromA (W : Ob) (r : W0.Ix (R.RC.ob W)) (z : W0.Ix (UU.fib0 W (cT W (ell W r)))) : W0.Ix (o W r.1) =
    trH W (compH W W X r.1 (idH W)) r.1 (symH (symH (comp-idr W X r.1)))
      (trB W (cT W (ell W r)) (UU.uAct W X r.1 F) (symH (symH (PF W r))) z) ;

  fromA-toA (W : Ob) (r : W0.Ix (R.RC.ob W)) (a0 : W0.Ix (o W r.1)) : Id (W0.Ix (o W r.1)) (fromA W r (toA W r a0)) a0 =
    transH (apH (trH W (compH W W X r.1 (idH W)) r.1 (symH (symH (comp-idr W X r.1))))
              (CExtEq1.subst-round (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (UU.uAct W X r.1 F) (cT W (ell W r)) (symH (PF W r))
                 (trH W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a0)))
           (CExtEq1.subst-round (Hom W X) (\ k2 -> W0.Ix (o W k2)) r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a0) ;

  toA-fromA (W : Ob) (r : W0.Ix (R.RC.ob W)) (z : W0.Ix (UU.fib0 W (cT W (ell W r)))) : Id (W0.Ix (UU.fib0 W (cT W (ell W r)))) (toA W r (fromA W r z)) z =
    transH (apH (trB W (UU.uAct W X r.1 F) (cT W (ell W r)) (symH (PF W r)))
              (CExtEq1.subst-round' (Hom W X) (\ k2 -> W0.Ix (o W k2)) r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1))
                 (trB W (cT W (ell W r)) (UU.uAct W X r.1 F) (symH (symH (PF W r))) z)))
           (CExtEq1.subst-round' (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (UU.uAct W X r.1 F) (cT W (ell W r)) (symH (PF W r)) z) ;

  opaque fromA-toA ; opaque toA-fromA ;

  -- toA is a transport along a path of codes
  toAV (W : Ob) (r : W0.Ix (R.RC.ob W)) (a0 : W0.Ix (o W r.1))
    : Id (W0.Ix (UU.fib0 W (cT W (ell W r)))) (toA W r a0)
         (CExtEq1.sV (o W r.1) (UU.fib0 W (cT W (ell W r)))
            (transH (apH (o W) (symH (comp-idr W X r.1))) (apH (UU.fib0 W) (symH (PF W r)))) a0) =
    transH (UU.substF W (UU.uAct W X r.1 F) (cT W (ell W r)) (symH (PF W r)) (trH W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a0))
      (transH (apH (CExtEq1.sV (o W (compH W W X r.1 (idH W))) (UU.fib0 W (cT W (ell W r))) (apH (UU.fib0 W) (symH (PF W r))))
                 (trH-V W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a0))
              (CExtEq1.sV-comp (o W r.1) (o W (compH W W X r.1 (idH W))) (UU.fib0 W (cT W (ell W r)))
                 (apH (o W) (symH (comp-idr W X r.1))) (apH (UU.fib0 W) (symH (PF W r))) a0)) ;

  opaque toAV ;

  tA (W : Ob) (v : TAt.EI W) : TAg.EI W = (ell W v.1, toA W v.1 v.2) ;

  codeA (V : Ob) (y : V1.Ix (GIU.ob V)) : W0.V = UU.fib0 V (cT V y) ;

  -- pairs over codes, one level up
  pair-eqV1 (Xt : U a+) (code : Xt -> W0.V) (x x' : Xt) (Rp : Id Xt x x') (z : W0.Ix (code x)) (z' : W0.Ix (code x'))
    (c : Id W0.V (code x) (code x')) (H : Id (W0.Ix (code x')) (CExtEq1.sV (code x) (code x') c z) z')
    : Id ((y : Xt) * W0.Ix (code y)) (x, z) (x', z') =
    idJ Xt x
      (\ x2 R2 -> (z2 : W0.Ix (code x2)) (c2 : Id W0.V (code x) (code x2))
         -> Id (W0.Ix (code x2)) (CExtEq1.sV (code x) (code x2) c2 z) z2 -> Id ((y : Xt) * W0.Ix (code y)) (x, z) (x2, z2))
      (\ z2 c2 H2 -> apH {W0.Ix (code x)} {(y : Xt) * W0.Ix (code y)} (\ w -> (x, w))
         (transH (CExtEq1.sV-irr (code x) (code x) (refl (code x)) c2 z) H2))
      x' Rp z' c H ;

  opaque pair-eqV1 ;

  module NA (V W : Ob) (g : Hom V W) (v : TAt.EI W) {
    f : Hom W X = v.1.1 ;
    x : V1.Ix (GIU.ob V) = GIU.act V W g (ell W v.1) ;
    x' : V1.Ix (GIU.ob V) = ell V (R.RC.act V W g v.1) ;
    G : UU.U0 W = cT W (ell W v.1) ;
    y0 : Hom V W = compH V V W g (idH V) ;
    eP : Id (UU.U0 V) (UU.uAct V W g G) (cT V x) =
      L.ntEq GIU UU.UCtx (FGU.ev (tgt d)) V W g (ell W v.1) x (refl x) ;
    pL : Id (Hom V X) (compH V W X (compH W W X f (idH W)) g) (compH V W X f y0) =
      ntEq (yP W) (yP X) (yH W X f) V W g (idH W) y0 (UU.idf-eq V W g) ;
    eR : Id (Hom V X) (compH V W X f g) (compH V W X f g) =
      ntEq R.RC (yP X) R.inclRC V W g v.1 (R.RC.act V W g v.1) (refl (R.RC.act V W g v.1)) ;
    e' : Id (Hom V X) (compH V W X f g) (compH V W X f y0) = apH (compH V W X f) (symH (comp-idr V W g)) ;
    T : W0.Ix (o V (compH V W X f g)) = F.1.tact V W g f (compH V W X f g) eR v.2 ;
    z0 : W0.Ix (o W (compH W W X f (idH W))) = trH W f (compH W W X f (idH W)) (symH (comp-idr W X f)) v.2 ;
    Xin : W0.Ix (o V (compH V W X f y0)) = F.1.tact V W g (compH W W X f (idH W)) (compH V W X f y0) pL z0 ;

    Xin-T : Id (W0.Ix (o V (compH V W X f y0))) Xin (CExtEq1.sV (o V (compH V W X f g)) (o V (compH V W X f y0)) (apH (o V) e') T) =
      transH (UU.tact-src-move (yP X) F.1 V W g f (compH W W X f (idH W)) (compH V W X f y0) (symH (comp-idr W X f)) pL e' v.2)
       (transH (symH (UU.tact-move (yP X) F.1 V W g f (compH V W X f g) (compH V W X f y0) eR e' e' v.2))
               (trH-V V (compH V W X f g) (compH V W X f y0) e' T)) ;

    Q : Id (UU.U0 V) (UU.uAct V W g (UU.uAct W X f F)) (cT V x) = transH (apH (UU.uAct V W g) (symH (PF W v.1))) eP ;

    -- the two sides as transports of T
    LHS2 : Id (W0.Ix (codeA V x)) (TF.SA.tact V W g (ell W v.1) x (refl x) (tA W v).2)
                                 (CExtEq1.sV (o V (compH V W X f y0)) (codeA V x) (apH (UU.fib0 V) Q) Xin) =
      transH (symH (E1.tactG-cong V W g (UU.uAct W X f F) G (symH (PF W v.1)) (UU.uAct V W g (UU.uAct W X f F)) (cT V x) Q
                      (refl (UU.uAct V W g (UU.uAct W X f F))) eP z0))
             (UU.substF V (UU.uAct V W g (UU.uAct W X f F)) (cT V x) Q Xin) ;

    c2 : Id W0.V (o V (compH V W X f g)) (o V (compH V W X f y0)) = apH (o V) e' ;
    q1 : Id W0.V (o V (compH V W X f y0)) (codeA V x) = apH (UU.fib0 V) Q ;
    c3 : Id W0.V (o V (compH V W X f g)) (o V (compH V V X (compH V W X f g) (idH V))) = apH (o V) (symH (comp-idr V X (compH V W X f g))) ;
    q2 : Id W0.V (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') = apH (UU.fib0 V) (symH (PF V (R.RC.act V W g v.1))) ;
    c : Id W0.V (codeA V x) (codeA V x') = transH (symH (transH c2 q1)) (transH c3 q2) ;

    RHS2 : Id (W0.Ix (codeA V x')) (tA V (TAt.E.act V W g v)).2
                                  (CExtEq1.sV (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') q2
                                     (CExtEq1.sV (o V (compH V W X f g)) (o V (compH V V X (compH V W X f g) (idH V))) c3 T)) =
      transH (UU.substF V (UU.uAct V X (compH V W X f g) F) (cT V x') (symH (PF V (R.RC.act V W g v.1)))
                (trH V (compH V W X f g) (compH V V X (compH V W X f g) (idH V)) (symH (comp-idr V X (compH V W X f g))) T))
             (apH (CExtEq1.sV (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') q2)
                (trH-V V (compH V W X f g) (compH V V X (compH V W X f g) (idH V)) (symH (comp-idr V X (compH V W X f g))) T)) ;

    res : Id (TAg.EI V) (TAg.E.act V W g (tA W v)) (tA V (TAt.E.act V W g v)) =
      pair-eqV1 (V1.Ix (GIU.ob V)) (codeA V) x x' (symH (ell-nat V W g v.1))
        (TF.SA.tact V W g (ell W v.1) x (refl x) (tA W v).2) (tA V (TAt.E.act V W g v)).2 c
        (transH (apH (CExtEq1.sV (codeA V x) (codeA V x') c)
                   (transH LHS2 (apH (CExtEq1.sV (o V (compH V W X f y0)) (codeA V x) q1) Xin-T)))
          (transH (apH (CExtEq1.sV (codeA V x) (codeA V x') c) (CExtEq1.sV-comp (o V (compH V W X f g)) (o V (compH V W X f y0)) (codeA V x) c2 q1 T))
            (transH (CExtEq1.sV-two (o V (compH V W X f g)) (codeA V x) (codeA V x') (transH c2 q1) c (transH c3 q2) T)
              (transH (symH (CExtEq1.sV-comp (o V (compH V W X f g)) (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') c3 q2 T))
                      (symH RHS2))))) ;
  } ;

  tAnat (V W : Ob) (g : Hom V W) (v : TAt.EI W) : Id (TAg.EI V) (TAg.E.act V W g (tA W v)) (tA V (TAt.E.act V W g v)) =
    NA[V, W, g, v].res ;

  opaque tAnat ;

  tAinj (W : Ob) (v v' : TAt.EI W) (P : Id (W0.Ix (R.RC.ob W)) v.1 v'.1) (Qp : Id (TAg.EI W) (tA W v) (tA W v')) : Id (TAt.EI W) v v' =
    idJ (W0.Ix (R.RC.ob W)) v.1
      (\ r2 P2 -> (b2 : W0.Ix (At0.tob W r2)) -> Id (TAg.EI W) (tA W v) (tA W (r2, b2)) -> Id (TAt.EI W) v (r2, b2))
      (\ b2 Q2 -> apH {W0.Ix (At0.tob W v.1)} {TAt.EI W} (\ z -> (v.1, z))
         (transH (symH (fromA-toA W v.1 v.2))
           (transH (apH (fromA W v.1) (TAg.pr-inj W (ell W v.1) (toA W v.1 v.2) (toA W v.1 b2) Q2)) (fromA-toA W v.1 b2))))
      v'.1 P v'.2 Qp ;

  bkAta (Y : Ob) (r : W0.Ix (R.RC.ob Y)) (z : V1.Ix (TF.SA.tob Y (ell Y r))) : Id (TAg.EI Y) (tA Y (r, fromA Y r z)) (ell Y r, z) =
    apH {W0.Ix (UU.fib0 Y (cT Y (ell Y r)))} {TAg.EI Y} (\ w -> (ell Y r, w)) (toA-fromA Y r z) ;

  opaque tAinj ; opaque bkAta ;

  -- the universal B action at a moved point
  tbU (V W : Ob) (g : Hom V W) (x : V1.Ix (GIU.ob W)) (y : V1.Ix (GIU.ob V)) (P : Id (V1.Ix (GIU.ob V)) (GIU.act V W g x) y)
    (ep : Id (UU.U0 V) (UU.uAct V W g (cS W x)) (cS V y)) (b : W0.Ix (UU.fib0 W (cS W x)))
    : Id (TBg.EI V) (TBg.E.act V W g (x, b)) (y, UU.tactG V W g (cS W x) (cS V y) ep b) =
    idJ (V1.Ix (GIU.ob V)) (GIU.act V W g x)
      (\ y2 P2 -> (ep2 : Id (UU.U0 V) (UU.uAct V W g (cS W x)) (cS V y2))
         -> Id (TBg.EI V) (TBg.E.act V W g (x, b)) (y2, UU.tactG V W g (cS W x) (cS V y2) ep2 b))
      (\ ep2 -> apH {W0.Ix (UU.fib0 V (cS V (GIU.act V W g x)))} {TBg.EI V} (\ z -> (GIU.act V W g x, z))
         (CSmall.tact-irr UU.UCtx UU.El V W g (cS W x) (cS V (GIU.act V W g x))
            (L.ntEq GIU UU.UCtx (FGU.ev (src d)) V W g x (GIU.act V W g x) (refl (GIU.act V W g x))) ep2 b))
      y P ep ;

  opaque tbU ;

  ----------------------------------------------------------------------
  -- the B-cart (identity on fibres) and the glue datum

  Bt0 : PTy[R.RC] = GE.BtOf X ph B bn ;
  module TBt = GPR.TyL[R.RC, Bt0] ;

  tB (W : Ob) (v : TBt.EI W) : TBg.EI W = (ell W v.1, v.2) ;

  tBnat (V W : Ob) (g : Hom V W) (v : TBt.EI W) : Id (TBg.EI V) (TBg.E.act V W g (tB W v)) (tB V (TBt.E.act V W g v)) =
    tbU V W g (ell W v.1) (ell V (R.RC.act V W g v.1)) (symH (ell-nat V W g v.1))
      (bn V W g v.1.1 v.1.2 (R.RC.act V W g v.1).1 (apH (\ z -> z.1) (refl (R.RC.act V W g v.1))) (R.RC.act V W g v.1).2) v.2 ;

  tBinj (W : Ob) (v v' : TBt.EI W) (P : Id (W0.Ix (R.RC.ob W)) v.1 v'.1) (Qp : Id (TBg.EI W) (tB W v) (tB W v')) : Id (TBt.EI W) v v' =
    idJ (W0.Ix (R.RC.ob W)) v.1
      (\ r2 P2 -> (b2 : W0.Ix (Bt0.tob W r2)) -> Id (TBg.EI W) (tB W v) (tB W (r2, b2)) -> Id (TBt.EI W) v (r2, b2))
      (\ b2 Q2 -> apH {W0.Ix (Bt0.tob W v.1)} {TBt.EI W} (\ z -> (v.1, z)) (TBg.pr-inj W (ell W v.1) v.2 b2 Q2))
      v'.1 P v'.2 Qp ;

  opaque tBnat ; opaque tBinj ;

  module GC = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn,
    GIU, TF.SB, TF.SA, TF.tr, TF.trEquiv, ell, ell-nat,
    tA, \ W v -> refl (ell W v.1), tAnat, tAinj, fromA, bkAta,
    tB, \ W v -> refl (ell W v.1), tBnat, tBinj, \ Y x z -> z, \ Y x z -> refl (ell Y x, z)] ;

  -- the side value: a full glue datum over F
  dat : GE.GD1 X = GC.dat ;

  out : UA.UaT0 X F = (dat, (refl F, full)) ;
} ;
