-- CCosk.seg (L9): the coskeleton (postnikov.tex §2).  For A a type over G
-- and a bound N, an element c of KA at (X , x) is a family
--
--   c n f  in  A([n] , f^* x)       for n <= N and f : [n] -> X
--
-- with  c(f) g = c(f g)  for every g : [m] -> [n], m , n <= N (Compat).
-- Read on the linear posets, KA is the N-coskeleton of i*A.  The family
-- and the condition are V-small, so KA is a type.
--
--   rd-irr      the value does not depend on the proof of n <= N
--   etaK        A -> KA, (etaK a)(f) = a f
--   rd-eta      the value of etaK a at f is a f
--   EKext       elements of the total presheaf of KA, by first component
--               and reading

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
module LD = CLocD[a, l] ;
open PR.PS ;

module KT (G : PCtx) (A : PTy[G]) (N : Nat) {
  open PR.TyL[G, A] ;

  Fam (X : Ob) (x : Pt X) : U l =
    (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) -> T (lin n) (G.act (lin n) X f x) ;

  rd (X : Ob) (x : Pt X) (u : Fam X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) : EI (lin n) =
    (G.act (lin n) X f x, u n hn f) ;

  Compat (X : Ob) (x : Pt X) (u : Fam X x) : U l =
    (m n : Nat) (hm : IsT (leb m N)) (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) (f : Hom (lin n) X)
    -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g)) ;

  famV (X : Ob) (x : Pt X) : W.V =
    W.PiV W.natV (\ n -> W.PiV (W.IsTV (leb n N)) (\ hn ->
      LD.piH (lin n) X (\ f -> A.tob (lin n) (G.act (lin n) X f x)))) ;

  compatV (X : Ob) (x : Pt X) (u : Fam X x) : W.V =
    W.PiV W.natV (\ m -> W.PiV W.natV (\ n -> W.PiV (W.IsTV (leb m N)) (\ hm -> W.PiV (W.IsTV (leb n N)) (\ hn ->
      LD.piH (lin m) (lin n) (\ g -> LD.piH (lin n) X (\ f ->
        W.IdV (E.ob (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g)))))))) ;

  kob (X : Ob) (x : Pt X) : W.V = W.SigV (famV X x) (compatV X x) ;

  KEl (X : Ob) (x : Pt X) : U l = W.Ix (kob X x) ;

  isProp-Compat (X : Ob) (x : Pt X) (u : Fam X x) : isProp (Compat X x u) =
    isProp-Pi Nat (\ m -> (n : Nat) (hm : IsT (leb m N)) (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) (f : Hom (lin n) X)
      -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g))) (\ m ->
    isProp-Pi Nat (\ n -> (hm : IsT (leb m N)) (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) (f : Hom (lin n) X)
      -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g))) (\ n ->
    isProp-Pi (IsT (leb m N)) (\ hm -> (hn : IsT (leb n N)) (g : Hom (lin m) (lin n)) (f : Hom (lin n) X)
      -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g))) (\ hm ->
    isProp-Pi (IsT (leb n N)) (\ hn -> (g : Hom (lin m) (lin n)) (f : Hom (lin n) X)
      -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g))) (\ hn ->
    isProp-Pi (Hom (lin m) (lin n)) (\ g -> (f : Hom (lin n) X)
      -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g))) (\ g ->
    isProp-Pi (Hom (lin n) X) (\ f
      -> Id (EI (lin m)) (E.act (lin m) (lin n) g (rd X x u n hn f)) (rd X x u m hm (compH (lin m) (lin n) X f g))) (\ f ->
      W.isSetIx (E.ob (lin m)) _ _)))))) ;

  -- the value does not depend on the proof of n <= N
  rd-irr (X : Ob) (x : Pt X) (u : Fam X x) (n : Nat) (hn hn' : IsT (leb n N)) (f : Hom (lin n) X)
    : Id (EI (lin n)) (rd X x u n hn f) (rd X x u n hn' f) =
    apH (\ p -> rd X x u n p f) (isProp-IsT' (leb n N) hn hn') ;

  -- elements of KA are determined by their reading in E
  Kext (X : Ob) (x : Pt X) (u v : KEl X x)
    (h : (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) -> Id (EI (lin n)) (rd X x u.1 n hn f) (rd X x v.1 n hn f))
    : Id (KEl X x) u v =
    Sigma-eq (Fam X x) (\ w -> Compat X x w) u.1 v.1 u.2 v.2
      (funext Nat (\ n -> (hn : IsT (leb n N)) (f : Hom (lin n) X) -> T (lin n) (G.act (lin n) X f x)) u.1 v.1 (\ n ->
         funext (IsT (leb n N)) (\ hn -> (f : Hom (lin n) X) -> T (lin n) (G.act (lin n) X f x)) (u.1 n) (v.1 n) (\ hn ->
           funext (Hom (lin n) X) (\ f -> T (lin n) (G.act (lin n) X f x)) (u.1 n hn) (v.1 n hn) (\ f ->
             pr-inj (lin n) _ (u.1 n hn f) (v.1 n hn f) (h n hn f)))))
      (isProp-Compat X x v.1) ;

  ----------------------------------------------------------------------
  -- The action

  module Act (Y X : Ob) (h : Hom Y X) (x : Pt X) (y : Pt Y) (e : Id (Pt Y) (G.act Y X h x) y) {

    eqh (n : Nat) (f : Hom (lin n) Y)
      : Id (Pt (lin n)) (G.act (lin n) X (compH (lin n) Y X h f) x) (G.act (lin n) Y f y) =
      transH (G.act-o (lin n) Y X h f x) (apH (G.act (lin n) Y f) e) ;

    kfam (u : Fam X x) : Fam Y y = \ n hn f -> coeT (lin n) _ _ (eqh n f) (u n hn (compH (lin n) Y X h f)) ;

    rd-kfam (u : Fam X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) Y)
      : Id (EI (lin n)) (rd Y y (kfam u) n hn f) (rd X x u n hn (compH (lin n) Y X h f)) =
      symH (pr-coe (lin n) _ _ (eqh n f) (u n hn (compH (lin n) Y X h f))) ;

    kcompat (u : Fam X x) (c : Compat X x u) : Compat Y y (kfam u) = \ m n hm hn g f ->
      calc (EI (lin m)) {
          E.act (lin m) (lin n) g (rd Y y (kfam u) n hn f)
        =< apH (E.act (lin m) (lin n) g) (rd-kfam u n hn f) >
          E.act (lin m) (lin n) g (rd X x u n hn (compH (lin n) Y X h f))
        =< c m n hm hn g (compH (lin n) Y X h f) >
          rd X x u m hm (compH (lin m) (lin n) X (compH (lin n) Y X h f) g)
        =< apH (\ k -> rd X x u m hm k) (comp-assoc (lin m) (lin n) Y X h f g) >
          rd X x u m hm (compH (lin m) Y X h (compH (lin m) (lin n) Y f g))
        =< symH (rd-kfam u m hm (compH (lin m) (lin n) Y f g)) >
          rd Y y (kfam u) m hm (compH (lin m) (lin n) Y f g) } ;

    kact (u : KEl X x) : KEl Y y = (kfam u.1, kcompat u.1 u.2) ;
  } ;

  ktact (J I : Ob) (f : Hom J I) (x : Pt I) (y : Pt J) (e : Id (Pt J) (G.act J I f x) y) (u : KEl I x) : KEl J y =
    Act[J, I, f, x, y, e].kact u ;

  rd-ktact (J I : Ob) (f : Hom J I) (x : Pt I) (y : Pt J) (e : Id (Pt J) (G.act J I f x) y)
    (u : KEl I x) (n : Nat) (hn : IsT (leb n N)) (k : Hom (lin n) J)
    : Id (EI (lin n)) (rd J y (ktact J I f x y e u).1 n hn k) (rd I x u.1 n hn (compH (lin n) J I f k)) =
    Act[J, I, f, x, y, e].rd-kfam u.1 n hn k ;

  ktact-id (I : Ob) (x : Pt I) (e : Id (Pt I) (G.act I I (idH I) x) x) (u : KEl I x)
    : Id (KEl I x) (ktact I I (idH I) x x e u) u =
    Kext I x (ktact I I (idH I) x x e u) u (\ n hn k ->
      transH (rd-ktact I I (idH I) x x e u n hn k) (apH (\ k1 -> rd I x u.1 n hn k1) (comp-idl (lin n) I k))) ;

  ktact-o (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : Pt I) (y : Pt J) (z : Pt K)
    (e1 : Id (Pt J) (G.act J I f x) y) (e2 : Id (Pt K) (G.act K J g y) z)
    (e3 : Id (Pt K) (G.act K I (compH K J I f g) x) z) (u : KEl I x)
    : Id (KEl K z) (ktact K I (compH K J I f g) x z e3 u) (ktact K J g y z e2 (ktact J I f x y e1 u)) =
    Kext K z _ _ (\ n hn k ->
      transH (rd-ktact K I (compH K J I f g) x z e3 u n hn k)
      (transH (apH (\ k1 -> rd I x u.1 n hn k1) (comp-assoc (lin n) K J I f g k))
             (symH (transH (rd-ktact K J g y z e2 (ktact J I f x y e1 u) n hn k)
                           (rd-ktact J I f x y e1 u n hn (compH (lin n) K J g k)))))) ;

  opaque ktact-id ; opaque ktact-o ;

  KA : PTy[G] = (mkTy G kob ktact ktact-id ktact-o) ;

  module TK = PR.TyL[G, KA] ;

  -- elements of the total presheaf of KA, by their first component and reading
  EKext (X : Ob) (w w' : TK.EI X) (e1 : Id (Pt X) w.1 w'.1)
    (h : (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) -> Id (EI (lin n)) (rd X w.1 w.2.1 n hn f) (rd X w'.1 w'.2.1 n hn f))
    : Id (TK.EI X) w w' =
    idJ (Pt X) w.1
      (\ y e -> (v : KEl X y)
         -> ((n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X) -> Id (EI (lin n)) (rd X w.1 w.2.1 n hn f) (rd X y v.1 n hn f))
         -> Id (TK.EI X) (w.1, w.2) (y, v))
      (\ v hh -> apH {KEl X w.1} {TK.EI X} (\ u -> (w.1, u)) (Kext X w.1 w.2 v hh))
      w'.1 e1 w'.2 h ;

  ----------------------------------------------------------------------
  -- eta : A -> KA,  (etaK a)(f) = a f

  etaF (I : Ob) (x : Pt I) (a : T I x) : KEl I x =
    (\ n hn f -> A.tact (lin n) I f x (G.act (lin n) I f x) (refl (G.act (lin n) I f x)) a,
     \ m n hm hn g f -> PE.actC (lin m) (lin n) I f g (x, a)) ;

  -- the value of etaK a at f is a f
  rd-eta (I : Ob) (x : Pt I) (a : T I x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) I)
    : Id (EI (lin n)) (rd I x (etaF I x a).1 n hn f) (E.act (lin n) I f (x, a)) =
    refl (rd I x (etaF I x a).1 n hn f) ;

  eta-nat (J I : Ob) (h : Hom J I) (x : Pt I) (y : Pt J) (e : Id (Pt J) (G.act J I h x) y) (a : T I x)
    : Id (KEl J y) (ktact J I h x y e (etaF I x a)) (etaF J y (A.tact J I h x y e a)) =
    Kext J y _ _ (\ n hn f ->
      transH (rd-ktact J I h x y e (etaF I x a) n hn f)
             (transH (symH (PE.actC (lin n) J I h f (x, a))) (apH (E.act (lin n) J f) (pr-tact J I h x y e a)))) ;

  opaque eta-nat ;

  etaN : LD.NatMap[G, A, KA] = new LD.NatMap[G, A, KA, etaF, eta-nat] ;

  ----------------------------------------------------------------------
  -- eta on the total presheaves; in dimensions <= N it is inverse to the
  -- value at the identity (Lemma cosk (1))

  module DM = LD.DMap[G, A, KA, etaN] ;

  etaE (Z : Ob) (w : EI Z) : TK.EI Z = DM.alE Z w ;

  etaE-act (J I : Ob) (f : Hom J I) (w : EI I) : Id (TK.EI J) (etaE J (E.act J I f w)) (TK.E.act J I f (etaE I w)) =
    DM.alE-act J I f w ;

  -- an element of KA at [n], n <= N, read at the identity
  ev (n : Nat) (hn : IsT (leb n N)) (w : TK.EI (lin n)) : EI (lin n) = rd (lin n) w.1 w.2.1 n hn (idH (lin n)) ;

  ev-pt (n : Nat) (hn : IsT (leb n N)) (w : TK.EI (lin n)) : Id (Pt (lin n)) (ev n hn w).1 w.1 = G.act-id (lin n) w.1 ;

  -- reading at the identity commutes with the action, in dimensions <= N
  ev-nat (j n : Nat) (hj : IsT (leb j N)) (hn : IsT (leb n N)) (p : Hom (lin j) (lin n)) (w : TK.EI (lin n))
    : Id (EI (lin j)) (E.act (lin j) (lin n) p (ev n hn w)) (ev j hj (TK.E.act (lin j) (lin n) p w)) =
    transH (w.2.2 j n hj hn p (idH (lin n)))
      (transH (apH (\ q -> rd (lin n) w.1 w.2.1 j hj q) (transH (comp-idl (lin j) (lin n) p) (symH (comp-idr (lin j) (lin n) p))))
              (symH (rd-ktact (lin j) (lin n) p w.1 (G.act (lin j) (lin n) p w.1) (refl (G.act (lin j) (lin n) p w.1)) w.2 j hj (idH (lin j))))) ;

  -- the reading of an element of the total presheaf at [W], at g, is ev of its restriction
  rd-ev (W n : Nat) (hn : IsT (leb n N)) (g : Hom (lin n) (lin W)) (w : TK.EI (lin W))
    : Id (EI (lin n)) (rd (lin W) w.1 w.2.1 n hn g) (ev n hn (TK.E.act (lin n) (lin W) g w)) =
    symH (transH (rd-ktact (lin n) (lin W) g w.1 (G.act (lin n) (lin W) g w.1) (refl (G.act (lin n) (lin W) g w.1)) w.2 n hn (idH (lin n)))
                 (apH (\ q -> rd (lin W) w.1 w.2.1 n hn q) (comp-idr (lin n) (lin W) g))) ;

  eta-ev (r : Nat) (hr : IsT (leb r N)) (w : TK.EI (lin r)) : Id (TK.EI (lin r)) (etaE (lin r) (ev r hr w)) w =
    EKext (lin r) (etaE (lin r) (ev r hr w)) w (G.act-id (lin r) w.1) (\ n hn k ->
      transH (w.2.2 n r hn hr k (idH (lin r)))
             (apH (\ q -> rd (lin r) w.1 w.2.1 n hn q) (comp-idl (lin n) (lin r) k))) ;

  ev-eta (r : Nat) (hr : IsT (leb r N)) (w : EI (lin r)) : Id (EI (lin r)) (ev r hr (etaE (lin r) w)) w = E.act-id (lin r) w ;

  -- ev does not depend on the proof of n <= N
  ev-irr (n : Nat) (hn hn' : IsT (leb n N)) (w : TK.EI (lin n)) : Id (EI (lin n)) (ev n hn w) (ev n hn' w) =
    rd-irr (lin n) w.1 w.2.1 n hn hn' (idH (lin n)) ;
  opaque eta-ev ;
} ;

------------------------------------------------------------------------
-- restriction K_M A -> K_N A for N <= M: forget the values above N

module Res (G : PCtx) (A : PTy[G]) (N M : Nat) (hNM : IsT (leb N M)) {
  module KN = KT[G, A, N] ;
  module KMm = KT[G, A, M] ;

  up (n : Nat) (hn : IsT (leb n N)) : IsT (leb n M) = leb-trans n N M hn hNM ;

  rf (I : Ob) (x : W.Ix (G.ob I)) (u : KMm.KEl I x) : KN.KEl I x =
    (\ n hn f -> u.1 n (up n hn) f, \ m n hm hn g f -> u.2 m n (up m hm) (up n hn) g f) ;

  rf-nat (J I : Ob) (h : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (e : Id (W.Ix (G.ob J)) (G.act J I h x) y) (u : KMm.KEl I x)
    : Id (KN.KEl J y) (KN.ktact J I h x y e (rf I x u)) (rf J y (KMm.ktact J I h x y e u)) =
    KN.Kext J y _ _ (\ n hn k ->
      transH (KN.rd-ktact J I h x y e (rf I x u) n hn k) (symH (KMm.rd-ktact J I h x y e u n (up n hn) k))) ;

  opaque rf-nat ;

  resN : LD.NatMap[G, KMm.KA, KN.KA] = new LD.NatMap[G, KMm.KA, KN.KA, rf, rf-nat] ;
} ;
