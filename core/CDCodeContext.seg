-- The code-map CwF for El1 over the original simplex category.
level a ;
open Base ;
module B = CDUniverseBase[a] ;
module O = CCodeCwF[a, a+].Over[B.DB.BC] ;
module U0 = B.DC.DU ;
module U1 = B.Univ ;

family : O.Family[B.U1] =
  new O.Family[B.U1, U1.fib0, U1.tactG, U1.tidC, U1.toC] ;
module C = O.Build[B.U1, family] ;
module Ops = C.CCodeOperations ;

cwf : CwF.CwF[a++] = C.CCodeLaws.cwf ;
isSetCtx : Prelude[a++].isSet cwf.Ctx = O.CCodeContextSet.isSet-PCtx ;
