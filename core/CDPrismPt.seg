-- CDPrismPt.seg (L8, Delta): seg/model DPrismPt.seg ported (module names only).  Was: the vertices of the shuffle P_k of [N] * [1] (pc / pl),
-- the arithmetic behind the horns of the shuffle chains (FillCell's
-- "faces of P_k", in numbers).  i is a vertex of [N+1], k <= N.
--
--   P_k i = (i , 0) for i <= k,  (i - 1 , 1) for i > k.
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
open CDeltaNat[a] ;
module DPm = CDPrism[a] ;

-- the two kinds of vertex
pkCase (R : U a) (N k i : Nat) (hk : IsT (leb k N)) (hi : IsT (leb i (suc N)))
  (lo : IsT (leb i k) -> R) (up : (x : Nat) -> Id Nat i (suc x) -> IsT (leb k x) -> IsT (leb x N) -> R) : R =
  ltb-dec R k i (\ lt -> aux i lt hi (refl i)) lo
 where { aux : (i' : Nat) -> IsT (ltb k i') -> IsT (leb i' (suc N)) -> Id Nat i i' -> R = split {
           zero -> \ lt h e -> absurd R (false-true lt) ;
           suc x -> \ lt h e -> up x e lt h } ; } ;

neq-of-lt (y x : Nat) (h : IsT (ltb y x)) : IsT (not (eqN x y)) = neq-sym y x (ltb-neq y x h) ;

-- transport of "differs from y" along an equality
neqT (a b y : Nat) (e : Id Nat a b) (h : IsT (not (eqN b y))) : IsT (not (eqN a y)) =
  substH (\ z -> IsT (not (eqN z y))) (symH e) h ;

------------------------------------------------------------------------
-- the first coordinate

-- A: below k, pc misses what i misses
ptA (N k i y : Nat) (hk : IsT (leb k N)) (hi : IsT (leb i (suc N))) (hy : IsT (ltb y k)) (ni : IsT (not (eqN i y)))
  : IsT (not (eqN (pc N k i) y)) =
  pkCase (IsT (not (eqN (pc N k i) y))) N k i hk hi
    (\ lo -> neqT (pc N k i) i y (pc-low k N i lo (leb-trans i k N lo hk)) ni)
    (\ x e kx xN -> neqT (pc N k i) x y (transH (apH (pc N k) e) (pc-high k N x kx xN)) (neq-of-lt y x (ltb-leb-trans y k x hy kx))) ;

-- D: above k + 1, pc misses y' when i misses y' + 1
ptD (N k i y' : Nat) (hk : IsT (leb k N)) (hi : IsT (leb i (suc N))) (hy : IsT (ltb k y')) (ni : IsT (not (eqN i (suc y'))))
  : IsT (not (eqN (pc N k i) y')) =
  pkCase (IsT (not (eqN (pc N k i) y'))) N k i hk hi
    (\ lo -> neqT (pc N k i) i y' (pc-low k N i lo (leb-trans i k N lo hk)) (neq-sym y' i (neq-of-lt i y' (leb-trans (suc i) (suc k) y' lo hy))))
    (\ x e kx xN -> neqT (pc N k i) x y' (transH (apH (pc N k) e) (pc-high k N x kx xN)) (substH (\ z -> IsT (not (eqN z (suc y')))) e ni)) ;

-- E: below k, pc fixes z
ptE (N k z : Nat) (hk : IsT (leb k N)) (hz : IsT (ltb z k)) : Id Nat (pc N k z) z =
  pc-low k N z (ltb-leb z k hz) (leb-trans z k N (ltb-leb z k hz) hk) ;

-- F: from k on, pc (z + 1) = z ; and pc k = k
ptF (N k z : Nat) (kz : IsT (leb k z)) (zN : IsT (leb z N)) : Id Nat (pc N k (suc z)) z = pc-high k N z kz zN ;

ptF0 (N k : Nat) (hk : IsT (leb k N)) : Id Nat (pc N k k) k = pc-low k N k (leb-refl k) hk ;

------------------------------------------------------------------------
-- the second coordinate

-- G: the last vertex is at level 1, the first at level 0
ptG (N k : Nat) (hk : IsT (leb k N)) : Id Nat (pl N k (suc N)) (suc zero) = pl-high k N N hk (leb-refl N) ;

ptG0 (N k : Nat) : Id Nat (pl N k zero) zero = pl-low k N zero (refl true) (refl true) ;

-- C: for k = N, every vertex but the last is at level 0
ptC (N i : Nat) (hi : IsT (leb i (suc N))) (ni : IsT (not (eqN i (suc N)))) : Id Nat (pl N N i) zero =
  pl-low N N i (leb-suc-neq i N hi ni) (leb-suc-neq i N hi ni) ;

-- C': for k = 0, every vertex but the first is at level 1
ptC0 (N i : Nat) (hi : IsT (leb i (suc N))) (ni : IsT (not (eqN i zero))) : Id Nat (pl N zero i) (suc zero) =
  aux i hi ni
 where { aux : (i' : Nat) -> IsT (leb i' (suc N)) -> IsT (not (eqN i' zero)) -> Id Nat (pl N zero i') (suc zero) = split {
           zero -> \ h n -> absurd _ (false-true n) ;
           suc x -> \ h n -> pl-high zero N x (refl true) h } ; } ;

------------------------------------------------------------------------
-- membership of a vertex of P_k in a neighbouring shuffle

-- B: the vertices of P_k other than (k , 1) are in P_{k+1}
ptB (N k i : Nat) (hk1 : IsT (leb (suc k) N)) (hi : IsT (leb i (suc N))) (ni : IsT (not (eqN i (suc k))))
  : IsT (DPm.memK (suc k) (pc N k i) (pl N k i)) =
  pkCase (IsT (DPm.memK (suc k) (pc N k i) (pl N k i))) N k i (leb-trans k (suc k) N (leb-suc k) hk1) hi
    (\ lo -> substH (\ c -> IsT (DPm.memK (suc k) c (pl N k i))) (symH (pc-low k N i lo (leb-trans i k N lo (leb-trans k (suc k) N (leb-suc k) hk1))))
               (substH (\ e -> IsT (DPm.memK (suc k) i e)) (symH (pl-low k N i lo (leb-trans i k N lo (leb-trans k (suc k) N (leb-suc k) hk1))))
                  (leb-trans i k (suc k) lo (leb-suc k))))
    (\ x e kx xN -> substH (\ c -> IsT (DPm.memK (suc k) c (pl N k i))) (symH (transH (apH (pc N k) e) (pc-high k N x kx xN)))
                      (substH (\ c -> IsT (DPm.memK (suc k) x c)) (symH (transH (apH (pl N k) e) (pl-high k N x kx xN)))
                         (leb-suc-neq' x k kx (substH (\ z -> IsT (not (eqN z (suc k)))) e ni))))
 where { -- k <= x and x + 1 /= k + 1 give k + 1 <= x
         leb-suc-neq' (x k : Nat) (kx : IsT (leb k x)) (n : IsT (not (eqN (suc x) (suc k)))) : IsT (leb (suc k) x) =
           leb-neq k x kx (neq-sym x k n) ; } ;

-- B': the vertices of P_{k+1} other than (k+1 , 0) are in P_k
ptB' (N k i : Nat) (hk1 : IsT (leb (suc k) N)) (hi : IsT (leb i (suc N))) (ni : IsT (not (eqN i (suc k))))
  : IsT (DPm.memK k (pc N (suc k) i) (pl N (suc k) i)) =
  pkCase (IsT (DPm.memK k (pc N (suc k) i) (pl N (suc k) i))) N (suc k) i hk1 hi
    (\ lo -> substH (\ c -> IsT (DPm.memK k c (pl N (suc k) i))) (symH (pc-low (suc k) N i lo (leb-trans i (suc k) N lo hk1)))
               (substH (\ e -> IsT (DPm.memK k i e)) (symH (pl-low (suc k) N i lo (leb-trans i (suc k) N lo hk1)))
                  (leb-suc-neq i k lo ni)))
    (\ x e kx xN -> substH (\ c -> IsT (DPm.memK k c (pl N (suc k) i))) (symH (transH (apH (pc N (suc k)) e) (pc-high (suc k) N x kx xN)))
                      (substH (\ c -> IsT (DPm.memK k x c)) (symH (transH (apH (pl N (suc k)) e) (pl-high (suc k) N x kx xN)))
                         (leb-trans k (suc k) x (leb-suc k) kx))) ;

-- k' < k gives not (k <= k')
lt-not-le : (k' k : Nat) -> IsT (ltb k' k) -> IsT (not (leb k k')) = split {
  zero -> split { zero -> \ h -> absurd _ (false-true h) ; suc k -> \ h -> refl true } ;
  suc k' -> split { zero -> \ h -> absurd _ (false-true h) ; suc k -> \ h -> lt-not-le k' k h } } ;

-- H: (k , 1) = P_k (k+1) is in no P_{k'} with k < k'
ptH (N k k' : Nat) (hk : IsT (leb k N)) (hkk : IsT (ltb k k')) (kN : IsT (leb (suc k) (suc N)))
  : Id Bool (DPm.memK k' (pc N k (suc k)) (pl N k (suc k))) false =
  transH (apH (\ c -> DPm.memK k' c (pl N k (suc k))) (pc-high k N k (leb-refl k) hk))
    (transH (apH (\ e -> DPm.memK k' k e) (pl-high k N k (leb-refl k) hk))
            (not-t-f (leb k' k) (lt-not-le k k' hkk))) ;

-- H': (k , 0) = P_k k is in no P_{k'} with k' < k
ptH' (N k k' : Nat) (hk : IsT (leb k N)) (hkk : IsT (ltb k' k))
  : Id Bool (DPm.memK k' (pc N k k) (pl N k k)) false =
  transH (apH (\ c -> DPm.memK k' c (pl N k k)) (pc-low k N k (leb-refl k) hk))
    (transH (apH (\ e -> DPm.memK k' k e) (pl-low k N k (leb-refl k) hk))
            (not-t-f (leb k k') (lt-not-le k' k hkk))) ;

