-- The step filler either reads a full side or fills the oriented prism.
module DD = D'.NDm ;
module GG = G'.NDm ;

module Stage (N : Nat)
  (LD : (b : SD.Prob N) -> Boundary.AtProblem[N, b].LD.P.PLine[S0 N eN])
  (LG : (b : SG.Prob N) -> Boundary.BG.Lines[N, b].P.PLine[S0 N eN])
  (ld : (b : SD.Prob N) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
    (p : IsT ((S0 N eN).1 W f j)) (i : IsT (lidB eN W j))
    -> Id (TA'.EI W) ((LD b).v W f j p) (Boundary.BD.Lines[N, b].lidV W f))
  (lg : (b : SG.Prob N) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
    (p : IsT ((S0 N eN).1 W f j)) (i : IsT (lidB eN W j))
    -> Id (TA.EI W) ((LG b).v W f j p) (Boundary.BG.Lines[N, b].lidV W f))
  (rel : (b : SD.Prob N) -> Boundary.AtProblem[N, b].Related (LD b) (LG (image N b))) {
  module StageD = DD.NCm.NBm.SDm.SCm.Stage[N, LD, ld] ;
  module StageG = GG.NCm.NBm.SDm.SCm.Stage[N, LG, lg] ;

  module AtB (b : SD.Prob N) {
    g : SG.Prob N = image N b ;
    module P = AtLine[N, SD.KA.TV.pr1 N b.1] ;

    absent : Id (SG.KA.TS.EI N) (E.mS N (SD.KA.TS.pr N b.1 (StageD.c2 b))) (SG.KA.TS.pr N g.1 (StageG.c2 g)) =
      SG.ts-ext N (E.mS N (SD.KA.TS.pr N b.1 (StageD.c2 b))) (SG.KA.TS.pr N g.1 (StageG.c2 g))
        (E.mSpt N (SD.KA.TS.pr N b.1 (StageD.c2 b))) (\ W f j ->
          transH (E.mS-val N (SD.KA.TS.pr N b.1 (StageD.c2 b)) W f j)
            (transH (apH (ta W) (StageD.c2-lv b W f j))
              (transH (P.total d (LD b) (LG g) (rel b) W f j) (symH (StageG.c2-lv g W f j))))) ;

    present (i : IsT (DD.NCm.NBm.SDm.SCm.fullB N b))
      : Id (SG.KA.TS.EI N) (E.mS N (SD.KA.TS.pr N b.1 (StageD.c1 b i))) (SG.KA.TS.pr N g.1 (StageG.c1 g i)) =
      transH (apH (E.mS N) (StageD.c1-E b i)) (symH (StageG.c1-E g i)) ;

    by-full : (c : Bool) (q : Id Bool (DD.NCm.NBm.SDm.SCm.fullB N b) c)
      -> Id (SG.KA.TS.EI N) (E.mS N (SD.KA.TS.pr N b.1 (StageD.fillC b c q))) (SG.KA.TS.pr N g.1 (StageG.fillC g c q)) = split {
      true -> present ;
      false -> \ q -> absent } ;
  } ;

  related : FillRel N StageD.fillF StageG.fillF = \ b ->
    AtB[b].by-full (DD.NCm.NBm.SDm.SCm.fullB N b) (refl (DD.NCm.NBm.SDm.SCm.fullB N b)) ;

  opaque related ;
} ;

module Start = Stage[zero, \ b -> Boundary.BD.Bd0[b].L0, \ b -> Boundary.BG.Bd0[b].L0,
  \ b W f j p i -> refl (Boundary.BD.Lines[zero, b].lidV W f),
  \ b W f j p i -> refl (Boundary.BG.Lines[zero, b].lidV W f),
  Boundary.zero-related] ;

module Step (N : Nat) (FD : SD.FillTy N) (FG : SG.FillTy N) (ih : FillRel N FD FG)
  (cD : Boundary.BD.Cmp2 N FD) (cG : Boundary.BG.Cmp2 N FG) {
  module F = Stage[suc N, \ b -> Boundary.BD.Bd[N, FD, cD, b].L0, \ b -> Boundary.BG.Bd[N, FG, cG, b].L0,
    \ b -> Boundary.BD.Bd[N, FD, cD, b].L0-lid,
    \ b -> Boundary.BG.Bd[N, FG, cG, b].L0-lid,
    \ b -> Boundary.Step[N, FD, FG, ih, cD, cG, b].related] ;
} ;
