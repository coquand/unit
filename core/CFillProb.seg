-- CFillProb.seg (L3, inside CB, level l): the composition problem whose
-- composite is the value of the filler (model.tex Prop "filling from
-- composition").  At a stage W, for an element w over the end src d of a
-- line, a partial line sd ending at w, and i : W -> I:
--
--   w'      the connection line j |-> line (c_d (i , j)), starting at w
--   v0      on (i = src d): the constant line at the start
--   v1      on the sieve of sd: the connected partial line
--   side    their join (they agree on the overlap: ov)
--
-- Quarry: seg/model GFill (Prob), on families and one sieve.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module FillP (G : PCtx) (A : PTy[G]) (d : Bool) {
  module K = CConn[l].Conn[G, A, d] ;
  module FG = K.FG ;
  module FA = K.FA ;
  module EK = CLine[l].EndKit[G, A, src d] ;
  module TA = EK.TA ;
  module TL = EK.TL ;
  module TV = EK.TV ;
  module TS = EK.TS ;
  module EV = FA.Ev[src d] ;
  module PT = CPartial[l].Partials[TV.E, EK.SFm.SF] ;

  -- a map landing in (i = src d): the connection is at src d
  cIpt (V W : Ob) (i : Hom W Iv) (g : Hom V W) (h : Lands V W (pre W Iv i (ptS (src d))) g) (j : Hom V Iv)
    : Id (Hom V Iv) (cI d V (compH V W Iv i g) j) (ptH V (src d)) =
    transH (apH (\ k -> cI d V k j) (lands-pt V (src d) (compH V W Iv i g) (lands-pre V W Iv i (ptS (src d)) g h)))
           (cI-isrc d V j) ;

  module Prob (W : Ob) (w : TV.EI W) (sd : PT.Side[W, w]) (i : Hom W Iv) {
    gl : W0.Ix (FG.ob W) = K.connG W w.1 i ;

    w' : TV.EI W = (gl, TA.fromE W ((FG.ev (src d)).nt W gl) (EK.endE W w) (symH (K.connG-src W w.1 i))) ;

    w'-E : Id (TA.EI W) (EK.endE W w') (EK.endE W w) =
      TA.fromE-eq W ((FG.ev (src d)).nt W gl) (EK.endE W w) (symH (K.connG-src W w.1 i)) ;

    -- w' restricted, read at the end
    endG (V : Ob) (g : Hom V W) : Id (TA.EI V) (EK.endE V (TV.E.act V W g w')) (EK.endE V (TV.E.act V W g w)) =
      transH (EK.endE-act V W g w') (transH (apH (TA.E.act V W g) w'-E) (symH (EK.endE-act V W g w))) ;

    --------------------------------------------------------------------
    -- the side on (i = src d)

    Q0 : Phi W = pre W Iv i (ptS (src d)) ;

    z0 (V : Ob) (g : Hom V W) : TA.EI V = EK.endE V (TV.E.act V W g w') ;

    p0 (V : Ob) (g : Hom V W) (h : Lands V W Q0 g)
      : Id (W0.Ix (FG.ob V)) (K.constA V (z0 V g)).1 (TV.E.act V W g w').1 =
      FG.fam-eq V (K.constA V (z0 V g)).1 (TV.E.act V W g w').1 (\ V' f j ->
        transH (gl.2 V' V f (compH V V W g (idH V)) (ptH V (src d)))
         (transH (apH (\ k -> gl.1 V' (compH V' V W k f) (compH V' V Iv (ptH V (src d)) f)) (comp-idr V W g))
          (transH (apH (\ k -> gl.1 V' (compH V' V W g f) k) (ptH-nat V' V f (src d)))
           (transH (apH (\ k -> w.1.1 V' (compH V' V W g f) k) (cIpt V' W i (compH V' V W g f) (lands-comp V' V W Q0 g f h) (ptH V' (src d))))
                   (symH (apH (\ k -> w.1.1 V' (compH V' V W g f) k) (cIpt V' W i (compH V' V W g f) (lands-comp V' V W Q0 g f h) j))))))) ;

    q0 (V : Ob) (g : Hom V W) : Id (TA.EI V) (EK.endE V (EV.evA.mE V (K.constA V (z0 V g)))) (EK.endE V (TV.E.act V W g w')) =
      transH (EV.endB-E V (K.constA V (z0 V g))) (TA.E.act-id V (z0 V g)) ;

    v0 (V : Ob) (g : Hom V W) (h : Lands V W Q0 g) : TS.EI V =
      EK.mkTS V (TV.E.act V W g w') (K.constA V (z0 V g)) (p0 V g h) (q0 V g) ;

    --------------------------------------------------------------------
    -- the connected sides

    -- the end of a side, read at the start
    uEnd (V : Ob) (g : Hom V W) (h : Lands V W sd.pQ g)
      : Id (TA.EI V) ((EK.lineL V (sd.pv V g h)).2.1.1 V (idH V) (ptH V (src d))) (z0 V g) =
      transH (symH (EV.endB-E V (EK.lineL V (sd.pv V g h))))
       (transH (apH (EK.endE V) (sd.pv V g h).2.2)
        (transH (apH (EK.endE V) (sd.ppt V g h)) (symH (endG V g)))) ;

    p1 (V : Ob) (g : Hom V W) (h : Lands V W sd.pQ g)
      : Id (W0.Ix (FG.ob V)) (K.connA V (EK.lineL V (sd.pv V g h)) (compH V W Iv i g)).1 (TV.E.act V W g w').1 =
      transH (apH (\ z -> K.connG V z.1 (compH V W Iv i g)) (sd.ppt V g h)) (symH (K.connG-act V W g w.1 i)) ;

    q1 (V : Ob) (g : Hom V W) (h : Lands V W sd.pQ g)
      : Id (TA.EI V) (EK.endE V (EV.evA.mE V (K.connA V (EK.lineL V (sd.pv V g h)) (compH V W Iv i g)))) (EK.endE V (TV.E.act V W g w')) =
      transH (EV.endB-E V (K.connA V (EK.lineL V (sd.pv V g h)) (compH V W Iv i g)))
       (transH (apH {Hom V Iv} {TA.EI V} (\ k -> (EK.lineL V (sd.pv V g h)).2.1.1 V (idH V) k) (cI-jsrc d V (compH V V Iv (compH V W Iv i g) (idH V))))
               (uEnd V g h)) ;

    v1 (V : Ob) (g : Hom V W) (h : Lands V W sd.pQ g) : TS.EI V =
      EK.mkTS V (TV.E.act V W g w') (K.connA V (EK.lineL V (sd.pv V g h)) (compH V W Iv i g)) (p1 V g h) (q1 V g h) ;

    --------------------------------------------------------------------
    -- the two sides

    -- restricting a side is the side at the restricted map
    pw (V' V : Ob) (chi : Hom V' V) (g : Hom V W)
      : Id (TV.EI V') (TV.E.act V' V chi (TV.E.act V W g w')) (TV.E.act V' W (compH V' V W g chi) w') =
      TV.PE.actC V' V W g chi w' ;

    n0 (V' V : Ob) (chi : Hom V' V) (g : Hom V W) (h : Lands V W Q0 g) (h' : Lands V' W Q0 (compH V' V W g chi))
      : Id (TS.EI V') (TS.E.act V' V chi (v0 V g h)) (v0 V' (compH V' V W g chi) h') =
      EK.mkTS-act V' V chi (TV.E.act V W g w') (K.constA V (z0 V g)) (p0 V g h) (q0 V g)
        (TV.E.act V' W (compH V' V W g chi) w') (K.constA V' (z0 V' (compH V' V W g chi))) (p0 V' (compH V' V W g chi) h') (q0 V' (compH V' V W g chi))
        (pw V' V chi g)
        (\ V'' f j -> transH (symH (TA.PE.actC V'' V' V chi f (z0 V g)))
           (apH (TA.E.act V'' V' f) (transH (symH (EK.endE-act V' V chi (TV.E.act V W g w'))) (apH (EK.endE V') (pw V' V chi g))))) ;

    n1 (V' V : Ob) (chi : Hom V' V) (g : Hom V W) (h : Lands V W sd.pQ g) (h' : Lands V' W sd.pQ (compH V' V W g chi))
      : Id (TS.EI V') (TS.E.act V' V chi (v1 V g h)) (v1 V' (compH V' V W g chi) h') =
      EK.mkTS-act V' V chi (TV.E.act V W g w') (K.connA V (EK.lineL V (sd.pv V g h)) (compH V W Iv i g)) (p1 V g h) (q1 V g h)
        (TV.E.act V' W (compH V' V W g chi) w') (K.connA V' (EK.lineL V' (sd.pv V' (compH V' V W g chi) h')) (compH V' W Iv i (compH V' V W g chi)))
        (p1 V' (compH V' V W g chi) h') (q1 V' (compH V' V W g chi) h')
        (pw V' V chi g)
        (\ V'' f j -> transH (symH (apH (\ M -> M.2.1.1 V'' f (cI d V'' (compH V'' V Iv (compH V W Iv i g) (compH V'' V' V chi f)) j))
                                      (EK.lineL-act V' V chi (sd.pv V g h))))
           (transH (apH (\ u -> (EK.lineL V' u).2.1.1 V'' f (cI d V'' (compH V'' V Iv (compH V W Iv i g) (compH V'' V' V chi f)) j))
                        (sd.pnat V' V chi g h h'))
                   (apH (\ k -> (EK.lineL V' (sd.pv V' (compH V' V W g chi) h')).2.1.1 V'' f (cI d V'' k j))
                        (transH (symH (comp-assoc V'' V' V Iv (compH V W Iv i g) chi f))
                                (apH (\ k -> compH V'' V' Iv k f) (comp-assoc V' V W Iv i g chi)))))) ;

    opaque n0 ; opaque n1 ;

    side0 : PT.Side[W, w'] =
      new PT.Side[W, w', Q0, v0, \ V g h -> EK.mkTS-pt V (TV.E.act V W g w') (K.constA V (z0 V g)) (p0 V g h) (q0 V g), n0] ;

    side1 : PT.Side[W, w'] =
      new PT.Side[W, w', sd.pQ, v1, \ V g h -> EK.mkTS-pt V (TV.E.act V W g w') (K.connA V (EK.lineL V (sd.pv V g h)) (compH V W Iv i g)) (p1 V g h) (q1 V g h), n1] ;

    --------------------------------------------------------------------
    -- they agree on the overlap: the connected line is constant there

    ig (V : Ob) (g : Hom V W) (h : Lands V W Q0 g) : Id (Hom V Iv) (compH V W Iv i g) (ptH V (src d)) =
      lands-pt V (src d) (compH V W Iv i g) (lands-pre V W Iv i (ptS (src d)) g h) ;

    ov (V : Ob) (g : Hom V W) (h0 : Lands V W Q0 g) (h1 : Lands V W sd.pQ g) : Id (TS.EI V) (v0 V g h0) (v1 V g h1) =
      EK.mkTS-eq V (TV.E.act V W g w') (TV.E.act V W g w')
        (K.constA V (z0 V g)) (K.connA V (EK.lineL V (sd.pv V g h1)) (compH V W Iv i g))
        (p0 V g h0) (q0 V g) (p1 V g h1) (q1 V g h1) (refl (TV.E.act V W g w'))
        (\ V'' f j -> transH (apH (TA.E.act V'' V f) (symH (uEnd V g h1)))
           (transH (symH (EK.lineEnd V'' V f (EK.lineL V (sd.pv V g h1))))
             (symH (apH {Hom V'' Iv} {TA.EI V''} (\ k -> (EK.lineL V (sd.pv V g h1)).2.1.1 V'' f k)
                (transH (apH (\ k -> cI d V'' (compH V'' V Iv k f) j) (ig V g h0))
                  (transH (apH (\ k -> cI d V'' k j) (ptH-nat V'' V f (src d))) (cI-isrc d V'' j))))))) ;

    opaque ov ;

    pick : Nat -> PT.Side[W, w'] = split { zero -> side0 ; suc m -> side1 } ;

    CTy (n n' : Nat) : U l = (V : Ob) (g : Hom V W) (h : Lands V W (pick n).pQ g) (h' : Lands V W (pick n').pQ g)
      -> Id (TS.EI V) ((pick n).pv V g h) ((pick n').pv V g h') ;

    cc0 : (n' : Nat) -> CTy zero n' = split {
      zero -> \ V g h h' -> PT.pv-irr W w' side0 V g h h' ;
      suc m -> \ V g h h' -> ov V g h h' } ;

    cc1 : (n' : Nat) -> CTy (suc zero) n' = split {
      zero -> \ V g h h' -> symH (ov V g h' h) ;
      suc m -> \ V g h h' -> PT.pv-irr W w' side1 V g h h' } ;

    cc : (n n' : Nat) -> CTy n n' = split { zero -> cc0 ; suc m -> cc1 } ;

    module J = CPartial[l].Join[TV.E, EK.SFm.SF, W, w', suc (suc zero), \ k -> pick k.1, \ k k' -> cc k.1 k'.1] ;

    -- the problem: one side on the union
    side : PT.Side[W, w'] = J.side ;
  } ;

  ----------------------------------------------------------------------
  -- the problem is uniform: restricting the problem at (w , sd , i) along
  -- chi is the problem at the restricted data

  module PU (W' W : Ob) (chi : Hom W' W) (w : TV.EI W) (sd : PT.Side[W, w]) (i : Hom W Iv) {
    module P = Prob[W, w, sd, i] ;
    module P' = Prob[W', TV.E.act W' W chi w, PT.rside W' W chi w sd, compH W' W Iv i chi] ;

    pt : Id (TV.EI W') (TV.E.act W' W chi P.w') P'.w' =
      EK.tv-eq W' (TV.E.act W' W chi P.w') P'.w' (K.connG-act W' W chi w.1 i)
        (transH (EK.endE-act W' W chi P.w')
          (transH (apH (TA.E.act W' W chi) P.w'-E)
            (transH (symH (EK.endE-act W' W chi w)) (symH P'.w'-E)))) ;

    -- the sieves, side by side
    Qe : (n : Nat) -> Id (Phi W') (pre W' W chi (P.pick n).pQ) (P'.pick n).pQ = split {
      zero -> pre-comp W' W Iv chi i (ptS (src d)) ;
      suc m -> refl (pre W' W chi sd.pQ) } ;

    eQ : Id (Phi W') (pre W' W chi P.side.pQ) P'.side.pQ =
      transH (pre-bigU W' W chi (suc (suc zero)) P.J.Qs)
        (apH (\ F -> bigU W' (suc (suc zero)) F)
          (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Arith[a].Fin (suc (suc zero))) (\ k -> Phi W')
             (\ k -> pre W' W chi (P.J.Qs k)) P'.J.Qs (\ k -> Qe k.1))) ;

    -- a map landing in a side of P' lands, composed with chi, in that of P
    back (n : Nat) (V : Ob) (f : Hom V W') (b : Lands V W' (P'.pick n).pQ f) : Lands V W (P.pick n).pQ (compH V W' W chi f) =
      lands-pre V W' W chi (P.pick n).pQ f (lands-sub V W' (P'.pick n).pQ (pre W' W chi (P.pick n).pQ) (symH (Qe n)) f b) ;

    -- the points of the restricted sides
    ptV (V : Ob) (f : Hom V W') : Id (TV.EI V) (TV.E.act V W (compH V W' W chi f) P.w') (TV.E.act V W' f P'.w') =
      transH (symH (TV.PE.actC V W' W chi f P.w')) (apH (TV.E.act V W' f) pt) ;

    vEq : (n : Nat) (V : Ob) (f : Hom V W') (a' : Lands V W (P.pick n).pQ (compH V W' W chi f)) (b : Lands V W' (P'.pick n).pQ f)
      -> Id (TS.EI V) ((P.pick n).pv V (compH V W' W chi f) a') ((P'.pick n).pv V f b) = split {
      zero -> \ V f a' b ->
        EK.mkTS-eq V (TV.E.act V W (compH V W' W chi f) P.w') (TV.E.act V W' f P'.w')
          (K.constA V (P.z0 V (compH V W' W chi f))) (K.constA V (P'.z0 V f))
          (P.p0 V (compH V W' W chi f) a') (P.q0 V (compH V W' W chi f)) (P'.p0 V f b) (P'.q0 V f)
          (ptV V f) (\ V'' g j -> apH (\ z -> TA.E.act V'' V g (EK.endE V z)) (ptV V f)) ;
      suc m -> \ V f a' b ->
        EK.mkTS-eq V (TV.E.act V W (compH V W' W chi f) P.w') (TV.E.act V W' f P'.w')
          (K.connA V (EK.lineL V (sd.pv V (compH V W' W chi f) a')) (compH V W Iv i (compH V W' W chi f)))
          (K.connA V (EK.lineL V ((PT.rside W' W chi w sd).pv V f b)) (compH V W' Iv (compH W' W Iv i chi) f))
          (P.p1 V (compH V W' W chi f) a') (P.q1 V (compH V W' W chi f) a') (P'.p1 V f b) (P'.q1 V f b)
          (ptV V f)
          (\ V'' g j -> transH
             (apH (\ u -> (EK.lineL V u).2.1.1 V'' g (cI d V'' (compH V'' V Iv (compH V W Iv i (compH V W' W chi f)) g) j))
                  (PT.pv-irr W w sd V (compH V W' W chi f) a' (lands-pre V W' W chi sd.pQ f b)))
             (apH (\ k -> (EK.lineL V ((PT.rside W' W chi w sd).pv V f b)).2.1.1 V'' g (cI d V'' (compH V'' V Iv k g) j))
                  (symH (comp-assoc V W' W Iv i chi f)))) } ;

    sd-eq : Id (PT.Side[W', P'.w']) (subst (TV.EI W') (\ z -> PT.Side[W', z]) (TV.E.act W' W chi P.w') P'.w' pt (PT.rside W' W chi P.w' P.side)) P'.side =
      PT.side-extH W' (TV.E.act W' W chi P.w') P'.w' pt (PT.rside W' W chi P.w' P.side) P'.side eQ
        (\ V f h h' ->
          transH (P.J.pv-in (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').1 V (compH V W' W chi f)
                    (back (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').1.1 V f (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').2)
                    (lands-pre V W' W chi P.side.pQ f h))
                 (vEq (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').1.1 V f
                    (back (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').1.1 V f (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').2)
                    (bigU-out V W' (suc (suc zero)) P'.J.Qs f h').2)) ;

    opaque pt ; opaque sd-eq ;
  } ;
} ;
