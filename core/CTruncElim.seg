-- Dependent elimination into any fibrant family of operational
-- propositions (SAG's seeded-extension definition of proposition).
-- The displayed algebra is constructed here, not supplied by the caller.
-- The result is a model section, with a checked computation rule on inc.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module Elimination (G : PCtx) (A : PTy[G])
  (B : PTy[extP G CTrunc[a,l].Truncation[G,A].Ty])
  (kb : CTruncAlg[a,l].Algebras[extP G CTrunc[a,l].Truncation[G,A].Ty,B].Algebra)
  (cb : PB.CLine[l].Lines[extP G CTrunc[a,l].Truncation[G,A].Ty,B].CompK[e0,e1].Comp) {
  module T = CTrunc[a,l].Truncation[G,A] ;
  module F = CTruncInd[a,l].Family[G,A,B] ;
  module L = CTruncLift[a,l].Lift[G,T.Ty,T.algebra,B,kb,cb] ;
  module TA = PR.TyL[G,A] ;
  module I = CLocBoundRetr[a,l].Map[G,A,T.Ty,T.inclusion] ;
  inclusion : PSub[TA.E,F.TT.E] = new PSub[TA.E,F.TT.E,I.onE,\ Y X h u -> symH (I.act Y X h u)] ;
  atInc : PTy[TA.E] = subTy TA.E F.TT.E B inclusion ;
  displayed : F.Displayed = new F.Displayed[L.algebra,L.projects] ;

  module On (b : PEl[TA.E,atInc]) {
    total : PSub[TA.E,F.TB.E] = oS TA.E (extP TA.E atInc) F.TB.E
      (liftP TA.E F.TT.E B inclusion) (secP TA.E atInc b) ;
    value (X : Ob) (x : TA.Pt X) (v : TA.T X x) : L.TS.T X x =
      (T.inclusion.nfun X x v,b.eob X (x,v)) ;
    natural (Y X : Ob) (h : Hom Y X) (x : TA.Pt X) (y : TA.Pt Y)
      (e : Id (TA.Pt Y) (G.act Y X h x) y) (v : TA.T X x) :
      Id (L.TS.T Y y) (L.S.SigP.tact Y X h x y e (value X x v)) (value Y y (A.tact Y X h x y e v)) =
      L.TS.pr-inj Y y _ _
        (transH (symH (L.TS.pr-tact Y X h x y e (value X x v)))
          (transH (apH (L.unassoc Y) (symH (L.assoc-nat Y X h (x,value X x v))))
            (transH (apH (L.unassoc Y) (symH (total.nt-nat Y X h (x,v))))
              (apH (\ w -> L.unassoc Y (total.nt Y w)) (TA.pr-tact Y X h x y e v))))) ;
    opaque natural ;
    map : HO.NMap[G,A,F.S.SigP] = new HO.NMap[G,A,F.S.SigP,value,natural] ;
    generator : F.Generator = new F.Generator[map,\ z v -> refl (T.inclusion.nfun z.1 z.2 v)] ;
    module E = F.Eliminate[displayed,generator] ;
    section : PEl[F.TT.E,B] = E.section ;
    beta-inc (X : Ob) (x : TA.Pt X) (v : TA.T X x) :
      Id (W.Ix (B.tob X (x,T.inclusion.nfun X x v)))
        (section.eob X (x,T.inclusion.nfun X x v)) (b.eob X (x,v)) =
      transH (E.beta-inc (X,x) v)
        (F.TB.pr-inj X (x,T.inclusion.nfun X x v) _ _
          (F.TB.fromE-eq X (x,T.inclusion.nfun X x v) (total.nt X (x,v))
            (apH (\ t -> (x,t)) (generator.over (X,x) v)))) ;
    opaque beta-inc ;
  } ;
} ;
