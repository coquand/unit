-- CTruncIsProp (SAG section 8.3): a seeded extension operation gives paths between any two maps.
-- This uses the model's existing interval and path type.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ; module HO = PB.CHtpyOps[l] ;

two : Nat = suc (suc zero) ;
f0 : Fin two = (zero,refl true) ; f1 : Fin two = (suc zero,refl true) ;
endpoint : Nat -> El Iv = split { zero -> e0 ; suc n -> e1 } ;

module Connect (G : PCtx) (A B : PTy[G]) (al be : HO.NMap[G,A,B]) (k : CTruncAlg[a, l].Algebras[G,B].Algebra) {
  module K = CTruncSeeded[a, l].FromAlgebra[G, A, B, k] ;
  module T = HO.HT[G,A,B,al,be] ; module TB = T.TB ;
  module P = CP.Partials[G,B] ; module R = CP.Rel[G,B,B,CP.pmap-id G B] ;
  module GAL = PR.PshL[T.GA] ;
  val (X : Ob) (z : W.Ix (T.GA.ob X)) : Nat -> TB.EI X = split { zero -> T.aE X z ; suc n -> T.bE X z } ;
  val-pt (X : Ob) (z : W.Ix (T.GA.ob X)) : (n : Nat) -> Id (TB.Pt X) (val X z n).1 z.1 = split {
    zero -> refl z.1 ; suc n -> refl z.1 } ;
  val-act (Y X : Ob) (h : Hom Y X) (z : W.Ix (T.GA.ob X)) (z' : W.Ix (T.GA.ob Y))
    (e : Id (W.Ix (T.GA.ob Y)) (T.GA.act Y X h z) z') : (n : Nat) ->
      Id (TB.EI Y) (TB.E.act Y X h (val X z n)) (val Y z' n) = split {
    zero -> transH (T.aE-act Y X h z) (apH (T.aE Y) e) ;
    suc n -> transH (T.bE-act Y X h z) (apH (T.bE Y) e) } ;

  module Ends (X : Ob) (z : W.Ix (T.GA.ob X)) (j : Hom X Iv) {
    Q (n : Nat) : PB.Phi X = PB.pre X Iv j (PB.ptS (endpoint n)) ;
    side (n : Nat) : P.Side[X,z.1] =
      new P.Side[X,z.1,Q n, \ Y h i -> TB.E.act Y X h (val X z n),
        \ Y h i -> apH (G.act Y X h) (val-pt X z n),
        \ Z Y g h i i' -> TB.PE.actC Z Y X h g (val X z n)] ;
    CT (n m : Nat) : U l = (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X (Q n) h) (i' : PB.Lands Y X (Q m) h) ->
      Id (TB.EI Y) ((side n).pv Y h i) ((side m).pv Y h i') ;
    cc0 : (m : Nat) -> CT zero m = split {
      zero -> \ Y h i i' -> refl (TB.E.act Y X h (T.aE X z)) ;
      suc m -> \ Y h i i' -> absurd _ (PB.pt-disj Y (compH Y X Iv j h) i i') } ;
    cc1 : (m : Nat) -> CT (suc zero) m = split {
      zero -> \ Y h i i' -> absurd _ (PB.pt-disj Y (compH Y X Iv j h) i' i) ;
      suc m -> \ Y h i i' -> refl (TB.E.act Y X h (T.bE X z)) } ;
    cc : (n m : Nat) -> CT n m = split { zero -> cc0 ; suc n -> cc1 } ;
    module J = CP.Join[G,B,X,z.1,two,\ q -> side q.1,\ q r -> cc q.1 r.1] ;
    value : TB.EI X = (z.1,K.kop X z.1 (al.nfun X z.1 z.2) J.side) ;
  } ;

  module Uniform (Y X : Ob) (h : Hom Y X) (z : W.Ix (T.GA.ob X)) (z' : W.Ix (T.GA.ob Y))
    (e : Id (W.Ix (T.GA.ob Y)) (T.GA.act Y X h z) z') (j : Hom X Iv) {
    module E0 = Ends[X,z,j] ; module E1 = Ends[Y,z',compH Y X Iv j h] ;
    Qe (n : Nat) : Id (PB.Phi Y) (PB.pre Y X h (E0.Q n)) (E1.Q n) = PB.pre-comp Y X Iv h j (PB.ptS (endpoint n)) ;
    eQ : Id (PB.Phi Y) (PB.pre Y X h E0.J.side.pQ) E1.J.side.pQ =
      transH (PB.pre-bigU Y X h two E0.J.Qs)
        (apH (PB.bigU Y two) (funext (Fin two) (\ q -> PB.Phi Y) (\ q -> PB.pre Y X h (E0.J.Qs q)) E1.J.Qs (\ q -> Qe q.1))) ;
    back (n : Nat) (Z : Ob) (f : Hom Z Y) (i : PB.Lands Z Y (E1.Q n) f) : PB.Lands Z X (E0.Q n) (compH Z Y X h f) =
      PB.lands-pre Z Y X h (E0.Q n) f (PB.lands-sub Z Y (E1.Q n) (PB.pre Y X h (E0.Q n)) (symH (Qe n)) f i) ;
    veq (n : Nat) (Z : Ob) (f : Hom Z Y) (i : PB.Lands Z X (E0.Q n) (compH Z Y X h f)) (i' : PB.Lands Z Y (E1.Q n) f) :
      Id (TB.EI Z) ((E0.side n).pv Z (compH Z Y X h f) i) ((E1.side n).pv Z f i') =
      transH (TB.E.act-o Z Y X h f (val X z n)) (apH (TB.E.act Z Y f) (val-act Y X h z z' e n)) ;
    ev (Z : Ob) (f : Hom Z Y) (i : PB.Lands Z X E0.J.side.pQ (compH Z Y X h f)) (i' : PB.Lands Z Y E1.J.side.pQ f) :
      Id (TB.EI Z) (E0.J.side.pv Z (compH Z Y X h f) i) (E1.J.side.pv Z f i') =
      transH (E0.J.pv-in q.1 Z (compH Z Y X h f) (back q.1.1 Z f q.2) i)
        (transH (veq q.1.1 Z f (back q.1.1 Z f q.2) q.2) (symH (E1.J.pv-in q.1 Z f q.2 i')))
      where { q : (q : Fin two) * PB.Lands Z Y (E1.Q q.1) f = PB.bigU-out Z Y two E1.J.Qs f i' ; } ;
    sd : Id (P.Side[Y,z'.1])
      (substH (\ x -> P.Side[Y,x]) (apH (\ v -> v.1) e) (P.rside Y X h z.1 E0.J.side)) E1.J.side =
      P.side-extH Y (G.act Y X h z.1) z'.1 (apH (\ v -> v.1) e) (P.rside Y X h z.1 E0.J.side) E1.J.side eQ ev ;
    value-nat : Id (TB.EI Y) (TB.E.act Y X h E0.value) E1.value =
      transH (K.kunif Y X h z.1 (al.nfun X z.1 z.2) E0.J.side)
        (K.kop-cong Y (G.act Y X h z.1) z'.1 (apH (\ v -> v.1) e)
          (B.tact Y X h z.1 (G.act Y X h z.1) (refl (G.act Y X h z.1)) (al.nfun X z.1 z.2))
          (al.nfun Y z'.1 z'.2) (val-act Y X h z z' e zero) (P.rside Y X h z.1 E0.J.side) E1.J.side sd) ;
  } ;

  end-value (X : Ob) (z : W.Ix (T.GA.ob X)) (q : Fin two) :
    Id (TB.EI X) Ends[X,z,PB.ptH X (endpoint q.1)].value (val X z q.1) =
    transH (K.kfull X z.1 (al.nfun X z.1 z.2) Ends[X,z,PB.ptH X (endpoint q.1)].J.side
      (Ends[X,z,PB.ptH X (endpoint q.1)].J.inS q X (idH X) lands))
      (transH (Ends[X,z,PB.ptH X (endpoint q.1)].J.pv-in q X (idH X) lands
        (Ends[X,z,PB.ptH X (endpoint q.1)].J.inS q X (idH X) lands)) (TB.E.act-id X (val X z q.1)))
    where {
      lands : PB.Lands X X (Ends[X,z,PB.ptH X (endpoint q.1)].J.Qs q) (idH X) =
        substH (\ h -> PB.Lands X Iv (PB.ptS (endpoint q.1)) h)
          (symH (comp-idr X Iv (PB.ptH X (endpoint q.1)))) (PB.pt-lands X (endpoint q.1)) ;
    } ;

  pv (X : Ob) (z : W.Ix (T.GA.ob X)) (Y : Ob) (f : Hom Y X) (j : Hom Y Iv) : TB.EI Y = Ends[Y,T.GA.act Y X f z,j].value ;
  pn (X : Ob) (z : W.Ix (T.GA.ob X)) (Z Y : Ob) (g : Hom Z Y) (f : Hom Y X) (j : Hom Y Iv) :
    Id (TB.EI Z) (TB.E.act Z Y g (pv X z Y f j)) (pv X z Z (compH Z Y X f g) (compH Z Y Iv j g)) =
    Uniform[Z,Y,g,T.GA.act Y X f z,T.GA.act Z X (compH Z Y X f g) z,GAL.actC Z Y X f g z,j].value-nat ;
  path (X : Ob) (z : W.Ix (T.GA.ob X)) : W.Ix (T.PT.tobP X z) =
    T.PT.mkPath X z (pv X z) (pn X z) (\ Y f j -> refl (G.act Y X f z.1))
      (transH (end-value X (T.GA.act X X (idH X) z) f0) (apH (T.aE X) (T.GA.act-id X z)))
      (transH (end-value X (T.GA.act X X (idH X) z) f1) (apH (T.bE X) (T.GA.act-id X z))) ;
  enat (Y X : Ob) (h : Hom Y X) (z : W.Ix (T.GA.ob X)) (z' : W.Ix (T.GA.ob Y)) (e : Id (W.Ix (T.GA.ob Y)) (T.GA.act Y X h z) z') :
    Id (W.Ix (T.PT.tobP Y z')) (T.PT.PathP.tact Y X h z z' e (path X z)) (path Y z') =
    T.PT.path-eq Y z' _ _ (\ Z f j -> apH (\ v -> Ends[Z,v,j].value)
      (transH (T.GA.act-o Z Y X h f z) (apH (T.GA.act Z Y f) e))) ;
  homotopy : PEl[T.GA,T.PT.PathP] = new PEl[T.GA,T.PT.PathP,path,enat] ;
} ;

-- A witness of internal propositionality: a natural path for every pair.
module IsProp (G : PCtx) (B : PTy[G]) (k : CTruncAlg[a, l].Algebras[G,B].Algebra) {
  open PR.TyL[G,B] ;
  pair-eq (S : U l) (u v u' v' : S) (p : Id S u u') (q : Id S v v') : Id (S * S) (u,v) (u',v') =
    trans (S * S) (u,v) (u',v) (u',v') (apH (\ t -> (t,v)) p) (apH (\ t -> (u',t)) q) ;
  pob (X : Ob) (x : Pt X) : W.V = W.SigV (B.tob X x) (\ b -> B.tob X x) ;
  pact (Y X : Ob) (h : Hom Y X) (x : Pt X) (y : Pt Y) (e : Id (Pt Y) (G.act Y X h x) y)
    (v : T X x * T X x) : T Y y * T Y y = (B.tact Y X h x y e v.1, B.tact Y X h x y e v.2) ;
  pid (X : Ob) (x : Pt X) (e : Id (Pt X) (G.act X X (idH X) x) x) (v : T X x * T X x)
    : Id (T X x * T X x) (pact X X (idH X) x x e v) v =
    pair-eq (T X x) _ _ _ _ (B.tact-id X x e v.1) (B.tact-id X x e v.2) ;
  po (Z Y X : Ob) (h : Hom Y X) (g : Hom Z Y) (x : Pt X) (y : Pt Y) (z : Pt Z)
    (e : Id (Pt Y) (G.act Y X h x) y) (e' : Id (Pt Z) (G.act Z Y g y) z)
    (e'' : Id (Pt Z) (G.act Z X (compH Z Y X h g) x) z) (v : T X x * T X x) :
    Id (T Z z * T Z z) (pact Z X (compH Z Y X h g) x z e'' v) (pact Z Y g y z e' (pact Y X h x y e v)) =
    pair-eq (T Z z) _ _ _ _ (B.tact-o Z Y X h g x y z e e' e'' v.1) (B.tact-o Z Y X h g x y z e e' e'' v.2) ;
  pairTy : PTy[G] = mkTy G pob pact pid po ;
  first : HO.NMap[G,pairTy,B] = new HO.NMap[G,pairTy,B,\ X x v -> v.1,\ Y X h x y e v -> refl (B.tact Y X h x y e v.1)] ;
  second : HO.NMap[G,pairTy,B] = new HO.NMap[G,pairTy,B,\ X x v -> v.2,\ Y X h x y e v -> refl (B.tact Y X h x y e v.2)] ;
  module Pth = HO.HT[G,pairTy,B,first,second] ;
  module KA = CTruncAlg[a, l].Algebras[G,B] ;
  ka : KA.Algebra = new KA.Algebra[k.extend,k.boundary,k.uniform] ;
  proposition : PEl[Pth.GA,Pth.PT.PathP] = Connect[G,pairTy,B,first,second,ka].homotopy ;
} ;
