-- CFillEnd.seg (L3, inside CB, level l): the end of the filler (model.tex
-- lem:fill-end).  The filler built from a composition ca, at j = tgt d, is
-- ca's composite: there the extra side (j = src d) lands nowhere, so the
-- problem's sieve is the original one, and the connection law gives back
-- the original line.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

-- the two ends of [1] are disjoint
ptdisj : (d : Bool) (W : Ob) (g : Hom W Iv) (i : Lands W Iv (ptS (src d)) g) (i' : Lands W Iv (ptS (tgt d)) g) -> Empty = split {
  true -> \ W g i i' -> pt-disj W g i i' ;
  false -> \ W g i i' -> pt-disj W g i' i } ;

module FE (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp) {
  module FC = CFill[l].FillC[G, A, d, ca] ;
  module FP = FC.FP ;
  module EK = FC.EK ;
  module TV = FC.TV ;
  module PT = FC.PT ;

  -- (pt tgt) g = pt tgt
  ptg (V W X : Ob) (f : Hom W X) (g : Hom V W)
    : Id (Hom V Iv) (compH V W Iv (compH W X Iv (ptH X (tgt d)) f) g) (ptH V (tgt d)) =
    transH (apH (\ k -> compH V W Iv k g) (ptH-nat W X f (tgt d))) (ptH-nat V W g (tgt d)) ;

  module P (X : Ob) (w : TV.EI X) (sd : PT.Side[X, w]) {
    module Pr = FP.Prob[X, w, sd, ptH X (tgt d)] ;

    Pw : Id (TV.EI X) Pr.w' w =
      EK.tv-eq X Pr.w' w
        (FP.FG.fam-eq X Pr.w'.1 w.1 (\ V g j -> apH (\ k -> w.1.1 V g k)
           (transH (apH (\ k -> cI d V k j) (ptH-nat V X g (tgt d))) (cI-itgt d V j))))
        Pr.w'-E ;

    -- the extra side lands nowhere
    into : (n : Nat) (W : Ob) (f : Hom W X) -> Lands W X (Pr.pick n).pQ f -> Lands W X sd.pQ f = split {
      zero -> \ W f h -> absurd (Lands W X sd.pQ f)
        (ptdisj d W (compH W X Iv (ptH X (tgt d)) f) (lands-pre W X Iv (ptH X (tgt d)) (ptS (src d)) f h)
           (lands-eq W Iv (ptS (tgt d)) (ptH W (tgt d)) (compH W X Iv (ptH X (tgt d)) f) (symH (ptH-nat W X f (tgt d)))
              (pt-lands W (tgt d)))) ;
      suc m -> \ W f h -> h } ;

    eQ : Id (Phi X) Pr.side.pQ sd.pQ =
      phi-ext X Pr.side.pQ sd.pQ
        (\ W f h -> into (bigU-out W X (suc (suc zero)) Pr.J.Qs f h).1.1 W f (bigU-out W X (suc (suc zero)) Pr.J.Qs f h).2)
        (\ W f h -> bigU-in W X (suc (suc zero)) Pr.J.Qs f (suc zero, refl true) h) ;

    -- on the original sieve the connected side is the side
    v1eq (W : Ob) (f : Hom W X) (h : Lands W X sd.pQ f) : Id (FC.TS.EI W) (Pr.v1 W f h) (sd.pv W f h) =
      EK.ts-ext W (Pr.v1 W f h) (sd.pv W f h)
        (transH (EK.mkTS-pt W (TV.E.act W X f Pr.w') (FP.K.connA W (EK.lineL W (sd.pv W f h)) (compH W X Iv (ptH X (tgt d)) f)) (Pr.p1 W f h) (Pr.q1 W f h))
          (transH (apH (TV.E.act W X f) Pw) (symH (sd.ppt W f h))))
        (\ V g j -> transH (apH (\ M -> M.2.1.1 V g j)
              (EK.mkTS-line W (TV.E.act W X f Pr.w') (FP.K.connA W (EK.lineL W (sd.pv W f h)) (compH W X Iv (ptH X (tgt d)) f)) (Pr.p1 W f h) (Pr.q1 W f h)))
           (apH (\ k -> (EK.lineL W (sd.pv W f h)).2.1.1 V g k)
              (transH (apH (\ k -> cI d V k j) (ptg V W X f g)) (cI-itgt d V j)))) ;

    R : Id (PT.Side[X, w]) (subst (TV.EI X) (\ z -> PT.Side[X, z]) Pr.w' w Pw Pr.side) sd =
      PT.side-extH X Pr.w' w Pw Pr.side sd eQ
        (\ W f i i' -> transH (Pr.J.pv-in (suc zero, refl true) W f i' i) (v1eq W f i')) ;

    res : Id (FC.TT.EI X) (Pr.w', ca.kop X Pr.w' Pr.side) (w, ca.kop X w sd) =
      FC.RC.kop-cong ca X Pr.w' w Pw Pr.side sd R ;

    opaque Pw ; opaque eQ ; opaque R ;
  } ;

  -- the filler at tgt d is the composite
  endT (X : Ob) (w0 : TV.EI X) (sd0 : PT.Side[X, w0])
    : Id (FC.TA.EI X) (FC.F[X, w0, sd0].t X (idH X) (ptH X (tgt d))) (FC.rd X (w0, ca.kop X w0 sd0)) =
    apH (FC.rd X)
      (transH P[X, TV.E.act X X (idH X) w0, PT.rside X X (idH X) w0 sd0].res
         (FC.RC.kop-cong ca X (TV.E.act X X (idH X) w0) w0 (TV.E.act-id X w0)
            (PT.rside X X (idH X) w0 sd0) sd0 (PT.rside-id X w0 sd0))) ;

  opaque endT ;
} ;
