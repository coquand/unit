-- The recursion preserves the relation on fill values. The proofs of
-- sides and codimension-two agreement enter through CDNormD.states.
open CDHornStage ;

module Next (N : Nat) (ih : FillRel N (DD.K N) (GG.K N)) {
  module DS = DD.Step2[N, DD.K N, (DD.states N).2.1, (DD.states N).2.2.1, (DD.states N).2.2.2].S ;
  module GS = GG.Step2[N, GG.K N, (GG.states N).2.1, (GG.states N).2.2.1, (GG.states N).2.2.2].S ;
  module Raw = Step[N, DD.K N, GG.K N, ih, (DD.states N).2.2.1, (GG.states N).2.2.1].F ;

  module Compare (b : SD.Prob (suc N)) {
    module I = Deg[N, b] ;

    Value (x : ND.DegFound N b) (y : NG.DegFound N I.gb) : U l =
      Id (SG.KA.TS.EI (suc N)) (E.mS (suc N) (SD.KA.TS.pr (suc N) b.1 (DS.KC b x)))
        (SG.KA.TS.pr (suc N) I.gb.1 (GS.KC I.gb y)) ;

    restricted (i : Nat) : SG.KA.TS.EI (suc N) =
      SG.KA.TS.E.act (suc N) N (dgH N i) (SG.fillE N (GG.K N) (SG.resP N (suc N) (dl N i) I.gb)) ;

    fromD (x : I.FirstD)
      : Id (SG.KA.TS.EI (suc N)) (E.mS (suc N) (SD.KA.TS.pr (suc N) b.1 (DS.KC b (inl x)))) (restricted x.1) =
      transH (apH (E.mS (suc N)) (DS.dv-E b x.1 x.2.2.1))
        (transH (symH (E.mSnat (suc N) N (dgH N x.1) (SD.fillE N (DD.K N) (SD.resP N (suc N) (dl N x.1) b))))
          (apH (SG.KA.TS.E.act (suc N) N (dgH N x.1)) (fill-res N (suc N) (DD.K N) (GG.K N) ih (dl N x.1) b))) ;

    withD (x : I.FirstD) : (y : NG.DegFound N I.gb) -> Value (inl x) y = split {
      inl y -> transH (fromD x) (transH (apH restricted (I.same-index x y)) (symH (GS.dv-E I.gb y.1 y.2.2.1))) ;
      inr n -> absurd _ (n x.1 x.2.1 (I.forth x.1 x.2.2.1)) } ;

    withoutD (n : (i : Nat) -> IsT (leb i N) -> ND.DegId N b i -> Empty)
      : (y : NG.DegFound N I.gb) -> Value (inr n) y = split {
      inl y -> absurd _ (n y.1 y.2.1 (I.back y.1 y.2.2.1)) ;
      inr n' -> Raw.related b } ;

    compare : (x : ND.DegFound N b) (y : NG.DegFound N I.gb) -> Value x y = split {
      inl x -> withD x ;
      inr n -> withoutD n } ;
  } ;

  related : FillRel (suc N) (DD.K (suc N)) (GG.K (suc N)) = \ b ->
    Compare[b].compare (HD.deg N b) (HG.deg N (image (suc N) b)) ;

  opaque related ;
} ;

related : (N : Nat) -> FillRel N (DD.K N) (GG.K N) = split {
  zero -> Start.related ;
  suc N | ih-N -> Next[N, ih-N].related } ;

opaque related ;
