-- CUaSA.seg (L6, inside CB): the sides of step (a) (model.tex Thm ua,
-- sides).  If the side u contains the identity, the glue datum of u is
-- u's own datum at the identity: CGlueUniq.GU2 with u_id's point cart
-- (CExtEq1.Pt) and part (i) of lem:full-move (CUaFull1); the points agree
-- by the uniformity of u.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UaSA (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (X : Ob) (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X)
  (u : CPartial[a+].Partials[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx,
                             CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].Side[X, F])
  (i0 : Lands X X u.pQ (idH X)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module PU = CPartial[a+].Partials[UU.UCtx, UA.UaTy] ;
  module D = CUaD.UaD[Cl, clSub, clSub-id, clSub-o, encCl, X, F, u] ;
  RES : L.PCtx = UB.CU.resCtx ;
  GDr : L.PCtx = UB.GDr ;

  x0 : LP.TyL[UU.UCtx, UA.UaTy].EI X = u.pv X (idH X) i0 ;
  xd : GE.GD1 X = x0.2.1 ;
  module PD = E1.Pt[X, xd] ;

  -- full sieves are equal
  full-lands (Q : Phi X) (i : Lands X X Q (idH X)) (W : Ob) (f : Hom W X) : Lands W X Q f =
    lands-eq W X Q (compH W X X (idH X) f) f (comp-idl W X f) (lands-comp W X X Q (idH X) f i) ;

  PA : Id (UU.U0 X) xd.1.1 F = transH x0.2.2.1 (transH (u.ppt X (idH X) i0) (UU.uAct-id X F)) ;

  Pph : Id (Phi X) xd.1.2.1 u.pQ =
    phi-ext X xd.1.2.1 u.pQ (\ W f i -> full-lands u.pQ i0 W f)
      (\ W f i -> full-lands xd.1.2.1 (allS-sound X xd.1.2.1 x0.2.2.2) W f) ;

  -- u at r is x0 restricted along r.1 (uniformity of u)
  Pg (W : Ob) (k : Hom W X) (r : W0.Ix (D.R.RC.ob W)) (Er : Id (Hom W X) k r.1) : Id (GE.GD1 W) (GDr.act W X k xd) (D.ell W r).1 =
    transH (apH (\ k2 -> GDr.act W X k2 xd) Er)
      (apH {LP.TyL[UU.UCtx, UA.UaTy].EI W} {GE.GD1 W} (\ z -> z.2.1)
        (transH (u.pnat W X r.1 (idH X) i0 (lands-comp W X X u.pQ (idH X) r.1 i0))
                (PU.pv-hom X F u W (compH W X X (idH X) r.1) r.1 (comp-idl W X r.1)
                   (lands-comp W X X u.pQ (idH X) r.1 i0) (D.lnd W r.1 r.2)))) ;

  Pe (W : Ob) (r : W0.Ix (D.R.RC.ob W)) (r' : W0.Ix (PD.RC.RC.ob W)) (Er : Id (Hom W X) r'.1 r.1)
    : Id (V1.Ix (RES.ob W)) (PD.s W r') (D.ell W r) =
    UB.CU.res-eq W (PD.s W r') (D.ell W r) (Pg W r'.1 r Er) ;

  -- B: the codes
  PB (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X xd.1.2.1 W f)) (q' : IsT (CGlueD.fl X u.pQ W f))
    : Id (UU.U0 W) (xd.1.2.2.1 W f q) (D.B W f q') =
    transH (apH {W0.Ix (PD.RC.RC.ob W)} {UU.U0 W} (\ r -> xd.1.2.2.1 W r.1 r.2)
              (PD.RC.pt-eq W (f, q) (compH W W X f (idH W), CGlueD.fl-pre W X f xd.1.2.1 W (idH W) (UB.qU W (GDr.act W X f xd) q))
                 (symH (comp-idr W X f))))
           (apH (UB.bmap.nt W) (Pe W (f, q') (f, q) (refl f))) ;

  -- the carts agree
  PtAp (W : Ob) (r : W0.Ix (D.R.RC.ob W)) (r' : W0.Ix (PD.RC.RC.ob W)) (Er : Id (Hom W X) r'.1 r.1)
    (z : W0.Ix (F.1.tob W r.1)) (cz : Id W0.V (F.1.tob W r.1) (xd.1.1.1.tob W r'.1))
    : Id (UB.TAU.EI W) (PD.tA W (r', CExtEq1.sV (F.1.tob W r.1) (xd.1.1.1.tob W r'.1) cz z)) (D.tA W (r, z)) =
    D.pair-eqV1 (V1.Ix (RES.ob W)) (D.codeA W) (PD.s W r') (D.ell W r) (Pe W r r' Er)
      (PD.tA W (r', CExtEq1.sV (F.1.tob W r.1) (xd.1.1.1.tob W r'.1) cz z)).2 (D.toA W r z) (apH (D.codeA W) (Pe W r r' Er))
      (transH (apH (CExtEq1.sV (D.codeA W (PD.s W r')) (D.codeA W (D.ell W r)) (apH (D.codeA W) (Pe W r r' Er)))
                 (transH (PD.trH-V W r'.1 (compH W W X r'.1 (idH W)) (symH (comp-idr W X r'.1)) (CExtEq1.sV (F.1.tob W r.1) (xd.1.1.1.tob W r'.1) cz z))
                         (CExtEq1.sV-comp (F.1.tob W r.1) (xd.1.1.1.tob W r'.1) (D.codeA W (PD.s W r')) cz
                            (apH (PD.o W) (symH (comp-idr W X r'.1))) z)))
        (transH (CExtEq1.sV-two (F.1.tob W r.1) (D.codeA W (PD.s W r')) (D.codeA W (D.ell W r))
                   (transH cz (apH (PD.o W) (symH (comp-idr W X r'.1)))) (apH (D.codeA W) (Pe W r r' Er))
                   (transH (apH (D.o W) (symH (comp-idr W X r.1))) (apH (UU.fib0 W) (symH (D.PF W r)))) z)
                (symH (D.toAV W r z)))) ;

  PtBp (W : Ob) (r : W0.Ix (D.R.RC.ob W)) (r' : W0.Ix (PD.RC.RC.ob W)) (Er : Id (Hom W X) r'.1 r.1)
    (z : W0.Ix (UU.fib0 W (D.B W r.1 r.2))) (cz : Id W0.V (UU.fib0 W (D.B W r.1 r.2)) (UU.fib0 W (xd.1.2.2.1 W r'.1 r'.2)))
    : Id (UB.TBU.EI W) (PD.tB W (r', CExtEq1.sV (UU.fib0 W (D.B W r.1 r.2)) (UU.fib0 W (xd.1.2.2.1 W r'.1 r'.2)) cz z)) (D.tB W (r, z)) =
    D.pair-eqV1 (V1.Ix (RES.ob W)) (PD.codeB W) (PD.s W r') (D.ell W r) (Pe W r r' Er)
      (PD.tB W (r', CExtEq1.sV (UU.fib0 W (D.B W r.1 r.2)) (UU.fib0 W (xd.1.2.2.1 W r'.1 r'.2)) cz z)).2 z (apH (PD.codeB W) (Pe W r r' Er))
      (transH (apH (CExtEq1.sV (PD.codeB W (PD.s W r')) (PD.codeB W (D.ell W r)) (apH (PD.codeB W) (Pe W r r' Er)))
                 (transH (UU.substF W (PD.bd.1 W r'.1 r'.2) (PD.bd.1 W (compH W W X r'.1 (idH W)) (PD.q2 W r')) (PD.PB W r')
                            (CExtEq1.sV (UU.fib0 W (D.B W r.1 r.2)) (UU.fib0 W (xd.1.2.2.1 W r'.1 r'.2)) cz z))
                         (CExtEq1.sV-comp (UU.fib0 W (D.B W r.1 r.2)) (UU.fib0 W (xd.1.2.2.1 W r'.1 r'.2)) (PD.codeB W (PD.s W r')) cz
                            (apH (UU.fib0 W) (PD.PB W r')) z)))
        (CExtEq1.sV-two (UU.fib0 W (D.B W r.1 r.2)) (PD.codeB W (PD.s W r')) (PD.codeB W (D.ell W r))
           (transH cz (apH (UU.fib0 W) (PD.PB W r'))) (apH (PD.codeB W) (Pe W r r' Er)) (refl (UU.fib0 W (D.B W r.1 r.2))) z)) ;

  opaque PB ; opaque PtAp ; opaque PtBp ;

  module G2 = CGlueUniq.GU2[Cl, clSub, clSub-id, clSub-o, encCl, X, F, u.pQ, D.B, D.bn, RES, UB.BU, UB.AU', UB.alU, CExtEq2.EQ2[Cl, clSub, clSub-id, clSub-o, encCl].eqU,
    D.ell, D.ell-nat, D.tA, \ W v -> refl (D.ell W v.1), D.tAnat, D.tAinj, D.fromA, D.bkAta, D.tB, \ W v -> refl (D.ell W v.1), D.tBnat, D.tBinj, \ Y x z -> z, \ Y x z -> refl (D.ell Y x, z),
    xd, PA, Pph, PB,
    PD.s, PD.s-nat, PD.tA, \ W v -> refl (PD.s W v.1), PD.tAnat, PD.tAinj, PD.bkA, PD.bkAta, PD.tB, \ W v -> refl (PD.s W v.1), PD.tBnat, PD.tBinj, PD.bkB, PD.bkBta, PD.comm,
    CUaFull1.FI[Cl, clSub, clSub-id, clSub-o, encCl, X, xd].law, PtAp, PtBp] ;

  -- (a) at a side containing the identity: the datum is u's at the identity
  law : Id (GE.GD1 X) xd D.d = G2.law ;
} ;
