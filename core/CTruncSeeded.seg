-- Seeded extension algebras in the model's existing partial-element interface.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ;

module FromAlgebra (G : PCtx) (A B : PTy[G]) (k : CTruncAlg[a, l].Algebras[G,B].Algebra) {
  open CTruncRaw[a, l].Build[G, A] ;
  open CTruncAlg[a, l].Algebras[G,B] ;
  open PR.TyL[G, B] ;
  module P = CP.Partials[G, B] ;
  module Side (X : Ob) (x : Pt X) (s : P.Side[X,x]) {
    pv (r : Loc) (h : Arr r (X,x)) (i : PB.Lands r.1 X s.pQ h.1) : F r =
      fromE r.1 r.2 (s.pv r.1 h.1 i) (transH (s.ppt r.1 h.1 i) h.2) ;
    pv-eq (r : Loc) (h : Arr r (X,x)) (i : PB.Lands r.1 X s.pQ h.1)
      : Id (EI r.1) (r.2,pv r h i) (s.pv r.1 h.1 i) =
      fromE-eq r.1 r.2 (s.pv r.1 h.1 i) (transH (s.ppt r.1 h.1 i) h.2) ;
    pn : Natural (X,x) s.pQ pv = \ r h i q g j -> pr-inj q.1 q.2 _ _
      (transH (symH (pr-tact q.1 r.1 g.1 r.2 q.2 g.2 (pv r h i)))
        (transH (apH (E.act q.1 r.1 g.1) (pv-eq r h i))
          (transH (s.pnat q.1 r.1 g.1 h.1 i j) (symH (pv-eq q (compose q r (X,x) h g) j))))) ;
    opaque pv-eq ; opaque pn ;
  } ;
  kop (X : Ob) (x : Pt X) (u : T X x) (s : P.Side[X,x]) : T X x =
    k.extend (X,x) s.pQ u Side[X,x,s].pv Side[X,x,s].pn ;
  kside (X : Ob) (x : Pt X) (u : T X x) (s : P.Side[X,x]) (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h)
    : Id (EI Y) (E.act Y X h (x,kop X x u s)) (s.pv Y h i) =
    transH (pr-tact Y X h x (G.act Y X h x) (refl (G.act Y X h x)) (kop X x u s))
      (transH (apH (\ b -> (G.act Y X h x,b))
        (k.boundary (X,x) s.pQ u Side[X,x,s].pv Side[X,x,s].pn
          (Y,G.act Y X h x) (h,refl (G.act Y X h x)) i))
        (Side[X,x,s].pv-eq (Y,G.act Y X h x) (h,refl (G.act Y X h x)) i)) ;
  opaque kside ;

  module Uniform (Y X : Ob) (h : Hom Y X) (x : Pt X) (u : T X x) (s : P.Side[X,x]) {
    y : Pt Y = G.act Y X h x ;
    hh : Arr (Y,y) (X,x) = (h,refl y) ;
    rs : P.Side[Y,y] = P.rside Y X h x s ;
    module S = Side[X,x,s] ; module R = Side[Y,y,rs] ;
    vp : Id (Partial (Y,y) rs.pQ) (rv (X,x) s.pQ S.pv (Y,y) hh) R.pv =
      funext Loc (\ r -> (g : Arr r (Y,y)) -> PB.Lands r.1 Y rs.pQ g.1 -> F r) _ R.pv (\ r ->
      funext (Arr r (Y,y)) (\ g -> PB.Lands r.1 Y rs.pQ g.1 -> F r) _ (R.pv r) (\ g ->
      funext (PB.Lands r.1 Y rs.pQ g.1) (\ i -> F r) _ (R.pv r g) (\ i ->
        pr-inj r.1 r.2 _ _ (transH (S.pv-eq r (compose r (Y,y) (X,x) hh g) i) (symH (R.pv-eq r g i)))))) ;
    result : Id (EI Y) (E.act Y X h (x,kop X x u s))
      (y,kop Y y (B.tact Y X h x y (refl y) u) rs) =
      transH (pr-tact Y X h x y (refl y) (kop X x u s))
        (apH (\ b -> (y,b)) (transH (k.uniform (X,x) s.pQ u S.pv S.pn (Y,y) hh)
          (ext-cong k (Y,y) rs.pQ _ _ (refl (act (Y,y) (X,x) hh u)) _ R.pv vp
            (rvn (X,x) s.pQ S.pv S.pn (Y,y) hh) R.pn))) ;
  } ;
  kunif (Y X : Ob) (h : Hom Y X) (x : Pt X) (u : T X x) (s : P.Side[X,x]) :
    Id (EI Y) (E.act Y X h (x,kop X x u s))
      (G.act Y X h x, kop Y (G.act Y X h x) (B.tact Y X h x (G.act Y X h x) (refl (G.act Y X h x)) u)
        (P.rside Y X h x s)) = Uniform[Y,X,h,x,u,s].result ;
  opaque kunif ;
  kfull (X : Ob) (x : Pt X) (u : T X x) (s : P.Side[X,x]) (i : PB.Lands X X s.pQ (idH X))
    : Id (EI X) (x,kop X x u s) (s.pv X (idH X) i) =
    transH (symH (E.act-id X (x,kop X x u s))) (kside X x u s X (idH X) i) ;
  opaque kfull ;
  kop-cong (X : Ob) (x x' : Pt X) (p : Id (Pt X) x x') (u : T X x) (u' : T X x')
    (q : Id (EI X) (x,u) (x',u')) (s : P.Side[X,x]) (s' : P.Side[X,x'])
    (e : Id (P.Side[X,x']) (substH (\ y -> P.Side[X,y]) p s) s')
    : Id (EI X) (x,kop X x u s) (x',kop X x' u' s') =
    idJ (Pt X) x (\ y py -> (v : T X y) -> Id (EI X) (x,u) (y,v) -> (r : P.Side[X,y]) ->
      Id (P.Side[X,y]) (substH (\ y' -> P.Side[X,y']) py s) r ->
      Id (EI X) (x,kop X x u s) (y,kop X y v r))
      (\ v pv r er -> trans (EI X) (x,kop X x u s) (x,kop X x v s) (x,kop X x v r) (apH (\ b -> (x,kop X x b s)) (pr-inj X x u v pv))
        (apH (\ side -> (x,kop X x v side)) er)) x' p u' q s' e ;
  opaque kop-cong ;
} ;
