-- CPosFinal.seg (L8, posets): the final statements for the poset model.
-- lem:el-yon in both directions (CPosEl5), then CFibFinal: univalence
-- (ua, a ContrOp on Sigma (X : U) Equiv (X , A)) and the universe fibrant
-- (fibU); Theorem 7 is PB.CThm7.Thm7 at any level.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module E4 = CPosEl4[a] ;
module E5 = CPosEl5[a] ;
module PB = E1.PB ;
module UU = E1.UU ;

-- El along a Yoneda code is the code
module YD (Z : Ob) (F : UU.U0 Z) {
  module D01 = E5.EY[e0, e1, \ Z1 F1 -> F1.2.1, \ Z' Z1 g F1 -> refl ((UU.uAct Z' Z1 g F1).2.1), Z, F, F.2.1,
                     \ X' k -> refl ((UU.uAct X' Z k F).2.1)] ;
  module D10 = E5.EY[e1, e0, \ Z1 F1 -> F1.2.2, \ Z' Z1 g F1 -> refl ((UU.uAct Z' Z1 g F1).2.2), Z, F, F.2.2,
                     \ X' k -> refl ((UU.uAct X' Z k F).2.2)] ;
  module FL = PB.CLine[a].Lines[E1.yP Z, F.1] ;

  yon : Id (FL.Fib) (F.2.1, F.2.2) (D01.M.move D01.EF.comp, D10.M.move D10.EF.comp) =
    transH {FL.Fib} {(F.2.1, F.2.2)} {(D01.M.move D01.EF.comp, F.2.2)} {(D01.M.move D01.EF.comp, D10.M.move D10.EF.comp)}
      (apH {FL.CompK[e0, e1].Comp} {FL.Fib} (\ z -> (z, F.2.2)) {F.2.1} {D01.M.move D01.EF.comp} D01.law)
      (apH {FL.CompK[e1, e0].Comp} {FL.Fib} (\ z -> (D01.M.move D01.EF.comp, z)) {F.2.2} {D10.M.move D10.EF.comp} D10.law) ;
} ;

yonP (Z : Ob) (F : UU.U0 Z)
  : Id (PB.CLine[a].Lines[E1.yP Z, F.1].Fib) (E1.YG.Yc[Z, F].K.moveFib E4.elFib) F.2 =
  symH {PB.CLine[a].Lines[E1.yP Z, F.1].Fib} {(F.2.1, F.2.2)}
    {(YD[Z, F].D01.M.move YD[Z, F].D01.EF.comp, YD[Z, F].D10.M.move YD[Z, F].D10.EF.comp)} YD[Z, F].yon ;

module UF = PB.CFibFinal.UF[E4.elFib, yonP] ;

-- univalence for the poset universe
ua : PB.CPartial[a+].ContrOp UF.UO.UU.UCtx UF.UO.UA.UaTy = UF.ua ;

-- the poset universe is fibrant, in any context
fibU (G : PB.GPre[a+].PS.PCtx) : PB.CLine[a+].Lines[G, UU.UTy G].Fib = UF.fibU G ;
