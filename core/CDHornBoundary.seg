-- The lid and the faces of the 4a step commute with the map of problems.
open CDCapBase[a] ;
open CDeltaNat[a] ;

module Boundary (eN : Nat) (eE : Id Tree e.1 (leaf eN)) {
  module BD = CDStageB[a, k].SB[D, A', e, eN, eE] ;
  module BG = CDStageB[a, l].SB[G, A, e, eN, eE] ;

  module AtProblem (N : Nat) (b : SD.Prob N) {
    bG : SG.Prob N = image N b ;
    module LD = BD.Lines[N, b] ;
    module LG = BG.Lines[N, bG] ;

    lid (W : Nat) (f : Hom (lin W) (lin N)) : Id (TA.EI W) (ta W (LD.lidV W f)) (LG.lidV W f) =
      transH (symH (tn W N f (SD.KA.endE N b.1)))
        (apH (TA.E.act W N f) (symH (E.sVE N b.1))) ;

    Related (L' : LD.P.PLine[S0 N eN]) (L : LG.P.PLine[S0 N eN]) : U l =
      (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (p : IsT ((S0 N eN).1 W f j))
      -> Id (TA.EI W) (ta W (L'.v W f j p)) (L.v W f j p) ;
  } ;

  zero-related (b : SD.Prob zero) : AtProblem[zero, b].Related BD.Bd0[b].L0 BG.Bd0[image zero b].L0 =
    \ W f j p -> AtProblem[zero, b].lid W f ;

  module Step (N : Nat) (FD : SD.FillTy N) (FG : SG.FillTy N) (ih : FillRel N FD FG)
    (cmpD : BD.Cmp2 N FD) (cmpG : BG.Cmp2 N FG) (b : SD.Prob (suc N)) {
    module P = AtProblem[suc N, b] ;
    module L' = BD.Bd[N, FD, cmpD, b] ;
    module L = BG.Bd[N, FG, cmpG, P.bG] ;

    face (i W : Nat) (f : Hom (lin W) (lin (suc N))) (j : Hom (lin W) Iv)
      : Id (TA.EI W) (ta W (L'.Fc.faceV i W f j)) (L.Fc.faceV i W f j) =
      transH (symH (E.mS-val N (L'.Fc.u i) W (compH (lin W) (lin (suc N)) (lin N) (dgH N i) f) j))
        (apH (\ z -> SG.lv N z W (compH (lin W) (lin (suc N)) (lin N) (dgH N i) f) j)
          (fill-res N (suc N) FD FG ih (dl N i) b)) ;

    related : P.Related L'.L0 L.L0 = \ W f j p ->
      orE _ (bdB (suc N) W f) (lidB eN W j) p
        (\ bd -> from-face W f j p (ex-e (suc N) (\ i -> missB W (suc N) f i) bd))
        (\ ld -> transH (apH (ta W) (L'.L0-lid W f j p ld))
          (transH (P.lid W f) (symH (L.L0-lid W f j p ld))))
     where {
      from-face (W : Nat) (f : Hom (lin W) (lin (suc N))) (j : Hom (lin W) Iv)
        (p : IsT ((S0 (suc N) eN).1 W f j))
        (w : (i : Nat) * (IsT (leb i (suc N)) * IsT (missB W (suc N) f i)))
        : Id (TA.EI W) (ta W (L'.L0.v W f j p)) (L.L0.v W f j p) =
        transH (apH (ta W) (L'.L0-face w.1 w.2.1 W f j p w.2.2))
          (transH (face w.1 W f j) (symH (L.L0-face w.1 w.2.1 W f j p w.2.2))) ;
     } ;

    opaque related ;
  } ;
} ;
