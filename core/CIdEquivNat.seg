-- CIdEquivNat.seg (L3, inside CB, level l): the equivalence Id -> Path is
-- natural (model.tex §9.1, Prop "Id and Path", natural in Gamma), in move
-- form.  For r : D -> G, the equivalence structure of proj over D, built
-- from the filling kP' of the path type over D, is the move of that of proj
-- over G along the cart of triples (CIdCart on Id, CPathCart on Path),
-- provided kP' is the moved filling (kmv).
--
--   IENat[kP, kP', dc, kmv].nat   the general statement (HCart.uniqueEq):
--     the base point x0 and the side S1 move (x0eq, sdEq), so the fillers
--     agree (kmv); the start a0 and the sieve ph move (a0v, phEq: the
--     families of sieves agree through bm-E, dconj-cong)
--   IdEquivNat[.., fA, dc].nat    for CIdEquiv.IdEquiv: kmv from
--     CFillMove.fill-mv, and the filling of the substituted path type is
--     that of the moved one by CPathNat.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module IENat0 (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a1 b : PEl[G, A]) {
  module IC = CIdCart[l].IdCart[D, G, r, A, a1, b] ;
  module PC = IC.PC ;
  module PF = PC.PF ;
  module PF' = PC.PF' ;
  module EP = PC.C.AtEnd[e1] ;

  -- a1 side moved along the cart of the strict fibres at e1
  msdP (X : Ob) (z : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, z]) : EP.EK.PT.Side[X, EP.sV X z] =
    new EP.EK.PT.Side[X, EP.sV X z, sd.pQ, \ V f i -> EP.mS V (sd.pv V f i),
      \ V f i -> transH (EP.mSpt V (sd.pv V f i)) (transH (apH (EP.sV V) (sd.ppt V f i)) (EP.sV-nat V X f z)),
      \ W' W chi f i i' -> transH (EP.mSnat W' W chi (sd.pv W f i)) (apH (EP.mS W') (sd.pnat W' W chi f i i'))] ;

  module IENat (kP : CLine[l].Lines[G, PF.PathT].Fill e1) (kP' : CLine[l].Lines[D, PF'.PathT].Fill e1) (dc : CId[l].DConj)
    (kmv : (X : Ob) (z : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, z])
       -> Id (EP.EK.TS.EI X) (EP.mS X (z, kP'.kop X z sd)) (EP.sV X z, kP.kop X (EP.sV X z) (msdP X z sd))) {
    module E' = CIdEquiv[l].IE[D, D, PC.A', PF'.s, PF'.sN, PF'.PE.aE, PF'.PE.bE, PF'.PE.aE-act, PF'.PE.bE-act, kP', dc] ;
    module E = CIdEquiv[l].IE[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act, kP, dc] ;

    module HT = CHFibCart[l, l].HCart[D, IC.IdT', PF'.PathT, E'.IO.proj, G, IC.IdT, PF.PathT, E.IO.proj, r.nt, r.nt-nat,
      PC.ta, \ W v -> refl (r.nt W v.1), PC.tanat, PC.tainj, PC.bk, PC.bkta,
      IC.taI, \ W v -> refl (r.nt W v.1), IC.tanatI, IC.tainjI, IC.bkI, IC.bktaI,
      \ W v -> refl (PC.ta W (E'.IO.proj.mE W v))] ;

    module H (X : Ob) (x : E'.TP.EI X) (sd : E'.PX.Side[X, x]) {
      module T' = E'.Th[X, x, sd] ;
      module T = E.Th[X, PC.ta X x, HT.C.mside E.equiv X x sd] ;

      -- the base point moves
      x0eq : Id (EP.EK.TV.EI X) (EP.sV X T'.x0) T.x0 =
        EP.EK.tv-eq X (EP.sV X T'.x0) T.x0 (PC.C.FG.fam-eq X (EP.sV X T'.x0).1 T.x0.1 (\ W f i -> r.nt-nat W X f T'.y))
          (calc (E.TP.EI X) {
              EP.EK.endE X (EP.sV X T'.x0)
            =< EP.sVE X T'.x0 >
              PC.ta X (EP.EK'.endE X T'.x0)
            =< apH (PC.ta X) T'.x0-E >
              PC.ta X x
            =< symH T.x0-E >
              EP.EK.endE X T.x0 }) ;

      -- the side moves
      sdEq : Id (EP.EK.PT.Side[X, T.x0])
                (subst (EP.EK.TV.EI X) (\ z -> EP.EK.PT.Side[X, z]) (EP.sV X T'.x0) T.x0 x0eq (msdP X T'.x0 T'.S1.side)) T.S1.side =
        EP.EK.PT.side-extH X (EP.sV X T'.x0) T.x0 x0eq (msdP X T'.x0 T'.S1.side) T.S1.side (refl sd.pQ)
          (\ V f h h' ->
            EP.EK.ts-ext V (EP.mS V (T'.S1.sv V f h)) (T.S1.sv V f h')
              (transH (EP.mSpt V (T'.S1.sv V f h))
                (transH (apH (EP.sV V) (T'.S1.sv-pt V f h))
                  (transH (EP.sV-nat V X f T'.x0)
                    (transH (apH (EP.EK.TV.E.act V X f) x0eq) (symH (T.S1.sv-pt V f h'))))))
              (\ W g j ->
                transH (apH (\ M -> M.2.1.1 W g j) (EP.mS-line V (T'.S1.sv V f h)))
                  (transH (apH (PC.ta W) (T'.S1.sv-val V f h W g j))
                    (transH (apH (\ u -> PC.ta W (E'.HF.fibL V u W g j)) (E'.PX.pv-irr X x sd V f h h'))
                            (symH (T.S1.sv-val V f h' W g j)))))) ;

      -- the fillers
      fillEq : Id (EP.EK.TS.EI X) (EP.mS X (T'.x0, T'.fill)) (T.x0, T.fill) =
        transH (kmv X T'.x0 T'.S1.side)
          (E.RK.kop-cong kP X (EP.sV X T'.x0) T.x0 x0eq (msdP X T'.x0 T'.S1.side) T.S1.side sdEq) ;

      FvEq (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (E.TP.EI W) (PC.ta W (T'.Fv W f j)) (T.Fv W f j) =
        transH (symH (apH (\ M -> M.2.1.1 W f j) (EP.mS-line X (T'.x0, T'.fill)))) (apH (\ z -> z.2.1.1.1 W f j) fillEq) ;

      opaque x0eq ; opaque sdEq ; opaque fillEq ;

      -- the start and the sieve
      a0v (V : Ob) (g : Hom V X) (k : Hom V Iv) : Id (E.TA.EI V) (PC.SEA.mV V (T'.a0.1.1 V g k)) (T.a0.1.1 V g k) =
        transH (apH (\ z -> PC.SEA.mV V (z.2.1.1 V g k)) T'.a0-E)
          (transH (apH (\ z -> z.2.1.1 V g k) (FvEq X (idH X) (ptH X e0)))
                  (symH (apH (\ z -> z.2.1.1 V g k) T.a0-E))) ;

      phEq : Id (Phi X) T'.ph T.ph =
        CId[l].dconj-cong dc X sd.pQ T'.Fs T.Fs T'.Fn' T.Fn'
          (\ W f i -> symH (apH (\ z -> z.2.2.1) (HT.bm-E W (sd.pv W f i)))) ;

      bEq : Id (E.TI.EI X) (IC.taI X (T'.y, T'.b)) (T.y, T.b) =
        E.IO.tpI-ext X (IC.taI X (T'.y, T'.b)) (T.y, T.b) (refl (r.nt X T'.y)) a0v phEq ;

      res : Id (HT.F.TF.EI X) (HT.mS X (x, E'.equiv.kop X x sd)) (PC.ta X x, E.equiv.kop X (PC.ta X x) (HT.C.mside E.equiv X x sd)) =
        E.HF.fibE-eq X (HT.mS X (x, E'.equiv.kop X x sd)) (PC.ta X x, E.equiv.kop X (PC.ta X x) (HT.C.mside E.equiv X x sd))
          (refl (PC.ta X x))
          (transH (HT.bm-E X (x, E'.equiv.kop X x sd)) bEq)
          FvEq ;
    } ;

    nat : Id (CEquiv[l].EquivOp D IC.IdT' PF'.PathT E'.IO.proj) E'.equiv (HT.moveEq E.equiv) =
      HT.uniqueEq E.equiv E'.equiv (\ X x sd -> H[X, x, sd].res) ;
  } ;
} ;

------------------------------------------------------------------------
-- for CIdEquiv.IdEquiv: the filling from the composition from e1 to e0

module IdEquivNat (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a0 b : PEl[G, A]) (fA : CLine[l].Lines[G, A].Fib) (dc : CId[l].DConj) {
  module N0 = IENat0[D, G, r, A, a0, b] ;
  module PC = N0.PC ;
  module PF = N0.PF ;
  module PF' = N0.PF' ;
  module PN = CPathNat[l].PathNat[D, G, r, A, a0, b, fA] ;

  ca : CLine[l].Lines[G, PF.PathT].CompK[e1, e0].Comp = (PF.fib fA).2 ;

  module FM = CFillMove[l, l].FillMv[D, PF'.PathT, G, PF.PathT, r.nt, r.nt-nat, PC.ta, \ W v -> refl (r.nt W v.1), PC.tanat, PC.tainj,
    PC.bk, PC.bkta, false, ca] ;

  -- the moved filling moves (fill-mv), with the side moved by msdP
  kmv (X : Ob) (z : N0.EP.EK'.TV.EI X) (sd : N0.EP.EK'.PT.Side[X, z])
    : Id (N0.EP.EK.TS.EI X) (N0.EP.mS X (z, FM.FC'.fill.kop X z sd)) (N0.EP.sV X z, FM.FC.fill.kop X (N0.EP.sV X z) (N0.msdP X z sd)) =
    transH (FM.fill-mv X z sd)
      (apH (\ q -> (N0.EP.sV X z, FM.FC.fill.kop X (N0.EP.sV X z) q))
        (N0.EP.EK.PT.side-ext X (N0.EP.sV X z) (FM.msd X z sd) (N0.msdP X z sd) (refl sd.pQ)
           (\ V f i i' -> apH (N0.EP.mS V) (N0.EP.EK'.PT.pv-irr X z sd V f i i')))) ;

  module N = N0.IENat[FM.FC.fill, FM.FC'.fill, dc, kmv] ;

  fA' : CLine[l].Lines[D, PC.A'].Fib = CFibSub[l].FibSub[D, G, r, A].sub fA ;

  -- the equivalence over D of CIdEquiv, from the substituted fibration
  eq' : CEquiv[l].EquivOp D N0.IC.IdT' PF'.PathT N.E'.IO.proj = CIdEquiv[l].IdEquiv[D, PC.A', PC.a', PC.b'].equiv fA' dc ;

  -- its filling is the moved one (CPathNat)
  fillP : Id (CLine[l].Lines[D, PF'.PathT].CompK[e1, e0].Comp) (PF'.fib fA').2 (PC.C.moveFib (PF.fib fA)).2 =
    apH (\ F -> F.2) PN.nat ;

  nat : Id (CEquiv[l].EquivOp D N0.IC.IdT' PF'.PathT N.E'.IO.proj) eq' (N.HT.moveEq (CIdEquiv[l].IdEquiv[G, A, a0, b].equiv fA dc)) =
    transH (apH (\ c -> CIdEquiv[l].IE[D, D, PC.A', PF'.s, PF'.sN, PF'.PE.aE, PF'.PE.bE, PF'.PE.aE-act, PF'.PE.bE-act,
                          CFill[l].FillC[D, PF'.PathT, false, c].fill, dc].equiv) fillP)
           N.nat ;
} ;
