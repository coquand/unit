-- CPostInvNat.seg (L9): naturality of the second inverse homotopy, and the
-- homotopy psi phi ~ id as a term of the model's Path type
-- (POSTNIKOV-INFORMAL.md, "Assembly and naturality").
--
-- For h : Y -> X, the recursion of CPostInv for u at h f and the one for
-- h^* u at f have equal inputs (CPostNat for psi, H, Theta; rd-dtact for
-- the readings R, Q), hence equal fillers (CBoxFill.Compare), by induction
-- on the dimension (recG) and on the stage (xiR).  Then the cylinders of
-- CPostInvAsm are natural (Nat.nat) and CPostConvergence.Cylinder gives
-- LeftInverse.homotopy.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module HO = PB.CHtpyOps[l] ;
module LM = CPostLimit[a, l] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;
module CB = CPostCube[a, l] ;
module CI = CPostInv[a, l] ;
module CA = CPostInvAsm[a, l] ;
module BX = CPostBox[a, l] ;

module Nat (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
  (u : LM.Post[G, A].DA.DEl X x) {
  module P = LM.Post[G, A] ;
  u2 : P.DA.DEl Y y = P.DA.DA.tact Y X h x y e u ;
  module I1 = CI.Inv[G, A, c, X, x, u] ;
  module I2 = CI.Inv[G, A, c, Y, y, u2] ;
  module TA = PR.TyL[G, A] ;

  -- the recursion of CPostRec: CPostNat, transported along phi's naturality
  module PN = CPostNat[a, l].Nat[G, A, c, Y, X, h, x, y, e, P.phi.nfun X x u] ;
  zeq : Id (W.Ix (P.L.tob Y y)) PN.RN.z' (P.phi.nfun Y y u2) = P.phi.nnat Y X h x y e u ;
  module RZ (z : W.Ix (P.L.tob Y y)) { module L = CPostInput[a, l].Input[G, A, Y, y, z].Construction[c].Rec ; } ;

  hf (m : Nat) (f : Hom (lin m) Y) : Hom (lin m) X = compH (lin m) Y X h f ;

  xfe (m : Nat) (f : Hom (lin m) Y) : Id (W.Ix (G.ob (lin m))) (I1.xf m (hf m f)) (I2.xf m f) = PN.xf m f ;

  ps (m : Nat) (f : Hom (lin m) Y) : Id (TA.EI (lin m)) (I1.Rf m (hf m f)).psi (I2.Rf m f).psi =
    transH (PN.recNat m f).ps (apH (\ z -> ((RZ[z].L.Drec m).R f).psi) zeq) ;

  hs (m : Nat) (f : Hom (lin m) Y) (N W1 : Nat) (g : Hom (lin W1) (lin m)) (j : Hom (lin W1) Iv)
    : Id (TA.EI (lin W1)) ((I1.Rf m (hf m f)).Hs N W1 g j) ((I2.Rf m f).Hs N W1 g j) =
    transH (apH (\ H -> H W1 g j) ((PN.recNat m f).hs N)) (apH (\ z -> ((RZ[z].L.Drec m).R f).Hs N W1 g j) zeq) ;

  ts (m : Nat) (f : Hom (lin m) Y) (N W1 : Nat) (g : Hom (lin W1) (prodP (lin m) Iv)) (j : Hom (lin W1) Iv)
    : Id (TA.EI (lin W1)) ((I1.Rf m (hf m f)).Ts N W1 g j) ((I2.Rf m f).Ts N W1 g j) =
    transH (apH (\ T -> T W1 g j) ((PN.recNat m f).ts N)) (apH (\ z -> ((RZ[z].L.Drec m).R f).Ts N W1 g j) zeq) ;

  -- the readings of u and of h^* u
  Ufe (n : Nat) (f : Hom (lin n) Y) : Id (TA.EI (lin n)) (I1.UR.Uf n (hf n f)) (I2.UR.Uf n f) =
    symH (P.DA.rd-dtact Y X h x y e u n f) ;

  module RE (m : Nat) (f : Hom (lin m) Y) {
    module S1 = I1.UR.Sq[m, hf m f] ;
    module S2 = I2.UR.Sq[m, f] ;
    ch (Q' : Ob) (phiX : Hom Q' X) (phiY : Hom Q' Y) (ep : Id (Hom Q' X) phiX (compH Q' Y X h phiY)) (r : Nat) (c1 : Hom (lin r) Q')
      : Id (TA.EI (lin r)) (I1.UR.Uf r (compH (lin r) Q' X phiX c1)) (I2.UR.Uf r (compH (lin r) Q' Y phiY c1)) =
      transH (apH (I1.UR.Uf r) (transH (apH (\ k -> compH (lin r) Q' X k c1) ep) (comp-assoc (lin r) Q' Y X h phiY c1)))
             (Ufe r (compH (lin r) Q' Y phiY c1)) ;

    R (W1 : Nat) (g : Hom (lin W1) S1.P1) : Id (TA.EI (lin W1)) (S1.R.D.val W1 g) (S2.R.D.val W1 g) =
      PM.DRZ[G, A, S1.N1, S2.N1, X, x, I1.UR.w S1.N1, Y, y, I2.UR.w S2.N1, S1.P1, S1.H1.ht, S1.H1.B, S1.H1.hB, S1.H1.hm, S1.H1.hi,
        leb-refl S1.N1, leb-refl S2.N1, S1.phi1, S2.phi1,
        \ r hr hr' c1 -> transH (S1.R.zcU r hr (compH (lin r) S1.P1 X S1.phi1 c1))
          (transH (ch S1.P1 S1.phi1 S2.phi1 (comp-assoc S1.P1 (lin m) Y X h f (pr1 (lin m) Iv)) r c1)
                  (symH (S2.R.zcU r hr' (compH (lin r) S1.P1 Y S2.phi1 c1)))),
        W1, g].res ;

    Q (W1 : Nat) (a1 : Hom (lin W1) (lin m)) (s v : Hom (lin W1) Iv) : Id (TA.EI (lin W1)) (S1.Q W1 a1 s v) (S2.Q W1 a1 s v) =
      PM.DRZ[G, A, S1.N2, S2.N2, X, x, I1.UR.w S1.N2, Y, y, I2.UR.w S2.N2, S1.P2, S1.H2.ht, S1.H2.B, S1.H2.hB, S1.H2.hm, S1.H2.hi,
        leb-refl S1.N2, leb-refl S2.N2, S1.phi2, S2.phi2,
        \ r hr hr' c1 -> transH (S1.R2.zcU r hr (compH (lin r) S1.P2 X S1.phi2 c1))
          (transH (ch S1.P2 S1.phi2 S2.phi2 (comp-assoc S1.P2 (lin m) Y X h f (pr1 (lin m) (lin (CPostRead[a, l].two)))) r c1)
                  (symH (S2.R2.zcU r hr' (compH (lin r) S1.P2 Y S2.phi2 c1)))),
        W1, pairH (lin m) (lin (CPostRead[a, l].two)) (lin W1) a1 (S1.bp W1 s v)].res ;
  } ;

  ----------------------------------------------------------------------
  -- the data of CPostInv agree

  -- the data at h f for u and at f for h^* u agree (a relation between two
  -- given data, so that the step below is stated for any lower dimension)
  record EqG (m : Nat) (f : Hom (lin m) Y) (r1 : I1.GRec[m, hf m f]) (r2 : I2.GRec[m, f]) {
    cy : (W1 : Nat) (g : Hom (lin W1) (lin m)) (j : Hom (lin W1) Iv)
         -> Id (TA.EI (lin W1)) (r1.Cy W1 g j) (r2.Cy W1 g j) ;
    xi : (k W1 : Nat) (g : Hom (lin W1) (prodP (lin m) Iv)) (j : Hom (lin W1) Iv)
         -> Id (TA.EI (lin W1)) (r1.Xi k W1 g j) (r2.Xi k W1 g j) ;
    cu : (k W1 : Nat) (g : Hom (lin W1) (CB.Geo[m].X)) (j : Hom (lin W1) Iv)
         -> Id (TA.EI (lin W1)) (r1.Cu k W1 g j) (r2.Cu k W1 g j) ;
  } ;

  -- dimension 0
  module Z (f : Hom (lin zero) Y) {
    module D1 = I1.D0[hf zero f] ; module D2 = I2.D0[f] ;
    module S1 = D1.Sq ; module S2 = D2.Sq ;
    module SC = CPostSqNat[a, l].SqZCmp[S1.G, S1.B, S1.e, S1.fill, S1.sides, S1.face, S1.xf, S1.psi, S1.psi-pt, S1.L, S1.Lp, S1.Ln, S1.Pl, S1.Plp, S1.Pln, S1.L0, S1.L1,
      S2.xf, S2.psi, S2.psi-pt, S2.L, S2.Lp, S2.Ln, S2.Pl, S2.Plp, S2.Pln, S2.L0, S2.L1,
      xfe zero f, ps zero f, \ W1 g j -> hs zero f (I1.St zero zero) W1 g j, RE[zero, f].R] ;

    cy (W1 : Nat) (g : Hom (lin W1) (lin zero)) (j : Hom (lin W1) Iv)
      : Id (TA.EI (lin W1)) (D1.CyD W1 g j) (D2.CyD W1 g j) =
      transH (D1.CyD-def W1 g j)
        (transH (SC.eq W1 (pairH (lin zero) Iv (lin W1) g j) (constH (lin W1) Iv e1)) (symH (D2.CyD-def W1 g j))) ;

    XiE (k : Nat) : U l = (W1 : Nat) (g : Hom (lin W1) (prodP (lin zero) Iv)) (j : Hom (lin W1) Iv)
      -> Id (TA.EI (lin W1)) (D1.XiD k W1 g j) (D2.XiD k W1 g j) ;

    module KC (k : Nat) (xk : XiE k) {
      module C1 = D1.CA[k, D1.SRz.trec k] ; module C2 = D2.CA[k, D2.SRz.trec k] ;
      module K1 = C1.K ; module K2 = C2.K ;
      module EC = CB.E4Cmp[G, A, zero, K1.E.xf, K1.E.T0, K1.E.T1, K1.E.V0, K1.E.V1, K1.E.c00, K1.E.c01, K1.E.c10, K1.E.c11,
        K2.E.xf, K2.E.T0, K2.E.T1, K2.E.V0, K2.E.V1, K2.E.c00, K2.E.c01, K2.E.c10, K2.E.c11,
        \ W1 a1 v j -> apH (TA.E.act (lin W1) (lin zero) a1) (ps zero f),
        \ W1 a1 v j -> RE[zero, f].Q W1 a1 j v,
        \ W1 a1 t j -> ts zero f (I1.St zero k) W1 (pairH (lin zero) Iv (lin W1) a1 t) j,
        \ W1 a1 t j -> transH (symH (D1.CyD-def W1 a1 t)) (transH (cy W1 a1 t) (D2.CyD-def W1 a1 t))] ;
      module X1 = C1.Bx ; module X2 = C2.Bx ;
      xeC : Id (W.Ix (G.ob (lin zero))) (I1.xf zero (hf zero f)) (I2.xf zero f) = xfe zero f ;
      aeC (W1 : Nat) (g : Hom (lin W1) (CB.Geo[zero].X)) : Id (TA.EI (lin W1)) (X1.a0 W1 g) (X2.a0 W1 g) =
        transH (symH (D1.XiD-def k W1 (pairH (lin zero) Iv (lin W1) (CB.Geo[zero].p1g W1 g) (CB.Geo[zero].pt W1 g)) (CB.Geo[zero].pv W1 g)))
          (transH (xk W1 (pairH (lin zero) Iv (lin W1) (CB.Geo[zero].p1g W1 g) (CB.Geo[zero].pt W1 g)) (CB.Geo[zero].pv W1 g)) (D2.XiD-def k W1 (pairH (lin zero) Iv (lin W1) (CB.Geo[zero].p1g W1 g) (CB.Geo[zero].pt W1 g)) (CB.Geo[zero].pv W1 g))) ;
      -- the two cubes have equal data (BoxZCmp: equal data, equal fillers)
      module BC = BX.BoxZCmp[X1.G, X1.B, X1.e, X1.fill, X1.sides, X1.face, X1.Y, X1.htY, X1.BY, X1.hBY, X1.hmY, X1.hiY, X1.QY, X1.xf, X1.a0, X1.a0p, X1.a0n, X1.Ev, X1.Evp, X1.Evn, X1.aE, X2.xf, X2.a0, X2.a0p, X2.a0n, X2.Ev, X2.Evp, X2.Evn, X2.aE, xeC, aeC, EC.endEq] ;
      cu (W1 : Nat) (g : Hom (lin W1) (CB.Geo[zero].X)) (j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (D1.CuD k W1 g j) (D2.CuD k W1 g j) =
        transH (D1.CuD-def k W1 g j) (transH (BC.eq W1 g j) (symH (D2.CuD-def k W1 g j))) ;
      -- the next square is the cube at s = 0 (the field Cs0 of the data)
      xn : XiE (suc k) = \ W1 g v ->
        transH (apH (\ q -> D1.XiD (suc k) W1 q v) (symH (pair-eta (lin zero) Iv (lin W1) g)))
          (transH (symH (D1.rec.Cs0 k W1 (CI.p1gI zero W1 g) (CI.p2gI zero W1 g) v))
            (transH (cu W1 (CB.Geo[zero].pt3 W1 (CI.p1gI zero W1 g) (CI.p2gI zero W1 g) v) (constH (lin W1) Iv e0))
              (transH (D2.rec.Cs0 k W1 (CI.p1gI zero W1 g) (CI.p2gI zero W1 g) v)
                      (apH (\ q -> D2.XiD (suc k) W1 q v) (pair-eta (lin zero) Iv (lin W1) g))))) ;
    } ;

    xiR : (k : Nat) -> XiE k = split {
      zero -> \ W1 g j -> transH (D1.XiD-def zero W1 g j) (transH (SC.eq W1 g j) (symH (D2.XiD-def zero W1 g j))) ;
      suc k | ih -> KC[k, ih].xn } ;

    res : EqG[zero, f, (I1.Drec zero).R (hf zero f), (I2.Drec zero).R f] =
      new EqG[zero, f, (I1.Drec zero).R (hf zero f), (I2.Drec zero).R f, cy, xiR, \ k -> KC[k, xiR k].cu] ;
  } ;

  -- dimension m + 1
  module S (m : Nat) (d1 : I1.Dm[m]) (d2 : I2.Dm[m]) (ih : (f : Hom (lin m) Y) -> EqG[m, f, d1.R (hf m f), d2.R f])
    (F : Hom (lin (suc m)) Y) {
    module D1 = I1.DS[m, d1.R, d1.FFX, d1.FFC, hf (suc m) F] ;
    module D2 = I2.DS[m, d2.R, d2.FFX, d2.FFC, F] ;
    fd (y1 : Nat) : Hom (lin m) Y = compH (lin m) (lin (suc m)) Y F (dl m y1) ;
    ad (y1 : Nat) : Id (Hom (lin m) X) (D1.Fd y1) (hf m (fd y1)) = comp-assoc (lin m) (lin (suc m)) Y X h F (dl m y1) ;

    fxi (y1 k W1 : Nat) (g : Hom (lin W1) (prodP (lin m) Iv)) (j : Hom (lin W1) Iv)
      : Id (TA.EI (lin W1)) ((d1.R (D1.Fd y1)).Xi k W1 g j) ((d2.R (D2.Fd y1)).Xi k W1 g j) =
      transH (apH (\ q -> (d1.R q).Xi k W1 g j) (ad y1)) ((ih (fd y1)).xi k W1 g j) ;
    fcu (y1 k W1 : Nat) (g : Hom (lin W1) (CB.Geo[m].X)) (j : Hom (lin W1) Iv)
      : Id (TA.EI (lin W1)) ((d1.R (D1.Fd y1)).Cu k W1 g j) ((d2.R (D2.Fd y1)).Cu k W1 g j) =
      transH (apH (\ q -> (d1.R q).Cu k W1 g j) (ad y1)) ((ih (fd y1)).cu k W1 g j) ;

    module S1 = D1.Sq ; module S2 = D2.Sq ;
    module SC = CPostSqNat[a, l].SqSCmp[S1.G, S1.B, S1.e, S1.fill, S1.sides, S1.face, m, S1.xf, S1.psi, S1.psi-pt, S1.L, S1.Lp, S1.Ln, S1.Pl, S1.Plp, S1.Pln, S1.L0, S1.L1,
      S1.Th, S1.Thp, S1.Thn, S1.Th-e, S1.Th-t0, S1.Th-t1, S1.FFt,
      S2.xf, S2.psi, S2.psi-pt, S2.L, S2.Lp, S2.Ln, S2.Pl, S2.Plp, S2.Pln, S2.L0, S2.L1,
      S2.Th, S2.Thp, S2.Thn, S2.Th-e, S2.Th-t0, S2.Th-t1, S2.FFt,
      xfe (suc m) F, ps (suc m) F, \ W1 g j -> hs (suc m) F (I1.St (suc m) zero) W1 g j, RE[suc m, F].R,
      \ y1 hy W1 g j -> fxi y1 (suc zero) W1 g j] ;

    cy (W1 : Nat) (g : Hom (lin W1) (lin (suc m))) (j : Hom (lin W1) Iv)
      : Id (TA.EI (lin W1)) (D1.CyD W1 g j) (D2.CyD W1 g j) =
      transH (D1.CyD-def W1 g j)
        (transH (SC.eq W1 (pairH (lin (suc m)) Iv (lin W1) g j) (constH (lin W1) Iv e1)) (symH (D2.CyD-def W1 g j))) ;

    XiE (k : Nat) : U l = (W1 : Nat) (g : Hom (lin W1) (prodP (lin (suc m)) Iv)) (j : Hom (lin W1) Iv)
      -> Id (TA.EI (lin W1)) (D1.XiD k W1 g j) (D2.XiD k W1 g j) ;

    module KCqq (k : Nat) (xk : XiE k) {
      module C1 = D1.CA[k, D1.SRs.trec k] ; module C2 = D2.CA[k, D2.SRs.trec k] ;
      module K1 = C1.K ; module K2 = C2.K ;
      -- the pieces of the end data agree (named, with explicit arguments)
      eT0 (W1 : Nat) (a1 : Hom (lin W1) (lin (suc m))) (v j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (K1.E.T0.v W1 a1 v j) (K2.E.T0.v W1 a1 v j) =
        apH {TA.EI (lin (suc m))} {TA.EI (lin W1)} (TA.E.act (lin W1) (lin (suc m)) a1)
          {(I1.Rf (suc m) (hf (suc m) F)).psi} {(I2.Rf (suc m) F).psi} (ps (suc m) F) ;
      eT1 (W1 : Nat) (a1 : Hom (lin W1) (lin (suc m))) (v j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (K1.E.T1.v W1 a1 v j) (K2.E.T1.v W1 a1 v j) = RE[suc m, F].Q W1 a1 j v ;
      eV0 (W1 : Nat) (a1 : Hom (lin W1) (lin (suc m))) (t j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (K1.E.V0.v W1 a1 t j) (K2.E.V0.v W1 a1 t j) =
        ts (suc m) F (I1.St (suc m) k) W1 (pairH (lin (suc m)) Iv (lin W1) a1 t) j ;
      eV1 (W1 : Nat) (a1 : Hom (lin W1) (lin (suc m))) (t j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (K1.E.V1.v W1 a1 t j) (K2.E.V1.v W1 a1 t j) =
        transH (symH (D1.CyD-def W1 a1 t)) (transH (cy W1 a1 t) (D2.CyD-def W1 a1 t)) ;
      module EC = CB.E4Cmp[G, A, suc m, K1.E.xf, K1.E.T0, K1.E.T1, K1.E.V0, K1.E.V1, K1.E.c00, K1.E.c01, K1.E.c10, K1.E.c11,
        K2.E.xf, K2.E.T0, K2.E.T1, K2.E.V0, K2.E.V1, K2.E.c00, K2.E.c01, K2.E.c10, K2.E.c11, eT0, eT1, eV0, eV1] ;
      module X1 = C1.Bx ; module X2 = C2.Bx ;
      feC (y1 : Nat) (hy : IsT (leb y1 (suc m))) (W1 : Nat) (g : Hom (lin W1) (prodP (lin m) CB.IvIv)) (j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (X1.F y1 hy W1 g j) (X2.F y1 hy W1 g j) = fcu y1 (suc k) W1 g j ;
      xeC : Id (W.Ix (G.ob (lin (suc m)))) (I1.xf (suc m) (hf (suc m) F)) (I2.xf (suc m) F) = xfe (suc m) F ;
      aeC (W1 : Nat) (g : Hom (lin W1) (CB.Geo[suc m].X)) : Id (TA.EI (lin W1)) (X1.a0 W1 g) (X2.a0 W1 g) =
        transH (symH (D1.XiD-def k W1 (pairH (lin (suc m)) Iv (lin W1) (CB.Geo[suc m].p1g W1 g) (CB.Geo[suc m].pt W1 g)) (CB.Geo[suc m].pv W1 g)))
          (transH (xk W1 (pairH (lin (suc m)) Iv (lin W1) (CB.Geo[suc m].p1g W1 g) (CB.Geo[suc m].pt W1 g)) (CB.Geo[suc m].pv W1 g)) (D2.XiD-def k W1 (pairH (lin (suc m)) Iv (lin W1) (CB.Geo[suc m].p1g W1 g) (CB.Geo[suc m].pt W1 g)) (CB.Geo[suc m].pv W1 g))) ;
      -- the two cubes have equal data (BoxSCmp: equal data, equal fillers)
      module BC = BX.BoxSCmp[X1.G, X1.B, X1.e, X1.fill, X1.sides, X1.face, X1.m', X1.Y, X1.htY, X1.BY, X1.hBY, X1.hmY, X1.hiY, X1.QY, X1.xf, X1.a0, X1.a0p, X1.a0n, X1.F, X1.Fp, X1.Fn, X1.Ev, X1.Evp, X1.Evn, X1.FF, X1.FE, X1.aF, X1.aE, X2.xf, X2.a0, X2.a0p, X2.a0n, X2.F, X2.Fp, X2.Fn, X2.Ev, X2.Evp, X2.Evn, X2.FF, X2.FE, X2.aF, X2.aE, xeC, aeC, feC, EC.endEq] ;
      cu (W1 : Nat) (g : Hom (lin W1) (CB.Geo[suc m].X)) (j : Hom (lin W1) Iv)
        : Id (TA.EI (lin W1)) (D1.CuD k W1 g j) (D2.CuD k W1 g j) =
        transH (D1.CuD-def k W1 g j) (transH (BC.eq W1 g j) (symH (D2.CuD-def k W1 g j))) ;
      -- the next square is the cube at s = 0 (the field Cs0 of the data)
      xn : XiE (suc k) = \ W1 g v ->
        transH (apH (\ q -> D1.XiD (suc k) W1 q v) (symH (pair-eta (lin (suc m)) Iv (lin W1) g)))
          (transH (symH (D1.rec.Cs0 k W1 (CI.p1gI (suc m) W1 g) (CI.p2gI (suc m) W1 g) v))
            (transH (cu W1 (CB.Geo[suc m].pt3 W1 (CI.p1gI (suc m) W1 g) (CI.p2gI (suc m) W1 g) v) (constH (lin W1) Iv e0))
              (transH (D2.rec.Cs0 k W1 (CI.p1gI (suc m) W1 g) (CI.p2gI (suc m) W1 g) v)
                      (apH (\ q -> D2.XiD (suc k) W1 q v) (pair-eta (lin (suc m)) Iv (lin W1) g))))) ;
    } ;

    xiR : (k : Nat) -> XiE k = split {
      zero -> \ W1 g j -> transH (D1.XiD-def zero W1 g j) (transH (SC.eq W1 g j) (symH (D2.XiD-def zero W1 g j))) ;
      suc k | ih -> KCqq[k, ih].xn } ;

    res : EqG[suc m, F, (I1.Dstep m d1).R (hf (suc m) F), (I2.Dstep m d2).R F] =
      new EqG[suc m, F, (I1.Dstep m d1).R (hf (suc m) F), (I2.Dstep m d2).R F, cy, xiR, \ k -> KCqq[k, xiR k].cu] ;
  } ;

  -- the step of the recursions, read through Drec (suc m) = Dstep m (Drec m)
  stepEq (m : Nat) (f : Hom (lin (suc m)) Y)
    (r : EqG[suc m, f, (I1.Dstep m (I1.Drec m)).R (hf (suc m) f), (I2.Dstep m (I2.Drec m)).R f])
    : EqG[suc m, f, (I1.Drec (suc m)).R (hf (suc m) f), (I2.Drec (suc m)).R f] =
    substH {I1.Dm[suc m]} (\ d -> EqG[suc m, f, d.R (hf (suc m) f), (I2.Drec (suc m)).R f]) (symH (I1.drecS m))
      (substH {I2.Dm[suc m]} (\ d -> EqG[suc m, f, (I1.Dstep m (I1.Drec m)).R (hf (suc m) f), d.R f]) (symH (I2.drecS m)) r) ;

  recG : (m : Nat) (f : Hom (lin m) Y) -> EqG[m, f, (I1.Drec m).R (hf m f), (I2.Drec m).R f] = split {
    zero -> \ f -> Z[f].res ;
    suc m | ih -> \ f -> stepEq m f S[m, I1.Drec m, I2.Drec m, ih, f].res } ;

  ----------------------------------------------------------------------
  -- the cylinders are natural

  module C1 = CA.Cyl[G, A, c, X, x, u] ;
  module C2 = CA.Cyl[G, A, c, Y, y, u2] ;
  module HC = CPostExt[a, l].Cross[Y, X, h] ;

  cEe (n : Nat) (q : Hom (lin n) HC.YI) : Id (TA.EI (lin n)) (C1.cE n (compH (lin n) HC.YI HC.XI HC.hI q)) (C2.cE n q) =
    transH (apH (\ k -> (C1.Rg n k).Cy n (idH (lin n)) (C1.ht n (compH (lin n) HC.YI HC.XI HC.hI q))) (HC.one (lin n) q))
      (transH (apH (\ k -> (C1.Rg n (hf n (C2.hf n q))).Cy n (idH (lin n)) k) (HC.two (lin n) q))
              ((recG n (C2.hf n q)).cy n (idH (lin n)) (C2.ht n q))) ;

  eb : Id (W.Ix (G.ob HC.YI)) (G.act HC.YI HC.XI HC.hI C1.xI) C2.xI = HC.base G x y e ;

  cylN : Id (P.DA.DEl HC.YI C2.xI) (P.DA.dtact HC.YI HC.XI HC.hI C1.xI C2.xI eb C1.cyl) C2.cyl =
    P.DA.Dext HC.YI C2.xI _ _ (\ n q -> transH (P.DA.rd-dtact HC.YI HC.XI HC.hI C1.xI C2.xI eb C1.cyl n q)
      (transH (C1.rdE n (compH (lin n) HC.YI HC.XI HC.hI q)) (transH (cEe n q) (symH (C2.rdE n q))))) ;

  nat : Id (C2.TL.EI HC.YI) (C1.TL.E.act HC.YI HC.XI HC.hI C1.p) C2.p =
    transH (C1.TL.pr-tact HC.YI HC.XI HC.hI C1.xI C2.xI eb C1.cyl)
           (apH {P.DA.DEl HC.YI C2.xI} {C2.TL.EI HC.YI} (\ v -> (C2.xI, v)) cylN) ;
  opaque nat ;
} ;

------------------------------------------------------------------------
-- psi phi ~ id in the model

module LeftInverse (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  module P = LM.Post[G, A] ;
  module RI = CPostConvergence[a, l].RightInverse[G, A, c] ;
  al : HO.NMap[G, P.DA.DA, P.DA.DA] = HO.compN G P.DA.DA P.L P.DA.DA RI.phi RI.psi ;
  be : HO.NMap[G, P.DA.DA, P.DA.DA] = HO.idN G P.DA.DA ;
  module H = CPostConvergence[a, l].Cylinder[G, P.DA.DA, P.DA.DA, al, be,
    \ X x u -> CA.Cyl[G, A, c, X, x, u].p,
    \ X x u -> refl (G.act (prodP X Iv) X (pr1 X Iv) x),
    \ X x u -> CA.Cyl[G, A, c, X, x, u].p0,
    \ X x u -> CA.Cyl[G, A, c, X, x, u].p1,
    \ Y X h x y e u -> Nat[G, A, c, Y, X, h, x, y, e, u].nat] ;
  homotopy : PEl[extP G P.DA.DA, HO.HT[G, P.DA.DA, P.DA.DA, al, be].PT.PathP] = H.res ;
} ;
