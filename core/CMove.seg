-- CMove.seg (L2, inside CB, levels k l): relative contractibility
-- structures move along cartesian maps.  Source m : S -> T over D (level l),
-- target m0 : S0 -> T0 over D0 (level k); a map of points s : D -> D0;
-- maps of totals mS : S -> S0 and mT : T -> T0 over s, natural, the square
-- mT m = m0 mS commuting; mT injective over equal points with a lift back
-- bk of its fibres.  A side of S is moved to S0 (mside), extended by k0
-- there, and the extension lifted back:
--
--   kop / kside / kunif   the moved structure (rc)
--   mside-restr           moving commutes with restriction
--   unique                a structure whose extensions move to k0's is rc
--
-- One lemma for every transfer: line fillers and equivalence structures
-- (ContrOps on derived types), line compositions (m the end map), across
-- levels (a small type over a large context: identity fibre maps).
-- Quarry: seg/model GTransfer, GTransferEq, GContrMove (step7), GFillX.

level k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
module P0 = GPre[k] ;
module P1 = GPre[l] ;

module Mv (D : P1.PS.PCtx) (S T : P1.PS.PTy[D]) (m : CPartial[l].PMap[D, S, T])
  (D0 : P0.PS.PCtx) (S0 T0 : P0.PS.PTy[D0]) (m0 : CPartial[k].PMap[D0, S0, T0])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (D0.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (D0.ob V)) (s V (D.act V W g d)) (D0.act V W g (s W d)))
  (mS : (W : Ob) -> P1.TyL[D, S].EI W -> P0.TyL[D0, S0].EI W)
  (mSpt : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (W0.Ix (D0.ob W)) (mS W v).1 (s W v.1))
  (mSnat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, S].EI W)
     -> Id (P0.TyL[D0, S0].EI V) (P0.TyL[D0, S0].E.act V W g (mS W v)) (mS V (P1.TyL[D, S].E.act V W g v)))
  (mT : (W : Ob) -> P1.TyL[D, T].EI W -> P0.TyL[D0, T0].EI W)
  (mTpt : (W : Ob) (v : P1.TyL[D, T].EI W) -> Id (W0.Ix (D0.ob W)) (mT W v).1 (s W v.1))
  (mTnat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, T].EI W)
     -> Id (P0.TyL[D0, T0].EI V) (P0.TyL[D0, T0].E.act V W g (mT W v)) (mT V (P1.TyL[D, T].E.act V W g v)))
  (mTinj : (W : Ob) (v v' : P1.TyL[D, T].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[D0, T0].EI W) (mT W v) (mT W v'))
     -> Id (P1.TyL[D, T].EI W) v v')
  (bk : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s X x))) -> W1.Ix (T.tob X x))
  (bkMv : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (T0.tob X (s X x))) -> Id (P0.TyL[D0, T0].EI X) (mT X (x, bk X x u)) (s X x, u))
  (sq : (W : Ob) (v : P1.TyL[D, S].EI W) -> Id (P0.TyL[D0, T0].EI W) (mT W (m.mE W v)) (m0.mE W (mS W v)))
  (k0 : CPartial[k].Rel[D0, S0, T0, m0].RC) {
  module TS = P1.TyL[D, S] ;
  module TT = P1.TyL[D, T] ;
  module TS0 = P0.TyL[D0, S0] ;
  module TT0 = P0.TyL[D0, T0] ;
  module PD = CPartial[l].Partials[D, S] ;
  module PG = CPartial[k].Partials[D0, S0] ;
  module RD = CPartial[l].Rel[D, S, T, m] ;
  module RG = CPartial[k].Rel[D0, S0, T0, m0] ;

  ----------------------------------------------------------------------
  -- sides moved

  mside (X : Ob) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x]) : PG.Side[X, s X x] =
    new PG.Side[X, s X x, sd.pQ, \ W f i -> mS W (sd.pv W f i),
      \ W f i -> transH (mSpt W (sd.pv W f i)) (transH (apH (s W) (sd.ppt W f i)) (s-nat W X f x)),
      \ W' W chi f i i' -> transH (mSnat W' W chi (sd.pv W f i)) (apH (mS W') (sd.pnat W' W chi f i i'))] ;

  mside-restr (Y X : Ob) (h : Hom Y X) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x])
    : Id (PG.Side[Y, s Y (D.act Y X h x)])
         (subst (W0.Ix (D0.ob Y)) (\ z -> PG.Side[Y, z]) (D0.act Y X h (s X x)) (s Y (D.act Y X h x))
            (symH (s-nat Y X h x)) (PG.rside Y X h (s X x) (mside X x sd)))
         (mside Y (D.act Y X h x) (PD.rside Y X h x sd)) =
    PG.side-extH Y (D0.act Y X h (s X x)) (s Y (D.act Y X h x)) (symH (s-nat Y X h x))
      (PG.rside Y X h (s X x) (mside X x sd)) (mside Y (D.act Y X h x) (PD.rside Y X h x sd))
      (refl (pre Y X h sd.pQ))
      (\ W g i i' -> apH (mS W) (PD.pv-irr X x sd W (compH W Y X h g) (lands-pre W Y X h sd.pQ g i) (lands-pre W Y X h sd.pQ g i'))) ;

  opaque mside-restr ;

  ----------------------------------------------------------------------
  -- the moved structure

  kop (X : Ob) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x]) : W1.Ix (T.tob X x) = bk X x (k0.kop X (s X x) (mside X x sd)) ;

  kopMv (X : Ob) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x])
    : Id (TT0.EI X) (mT X (x, kop X x sd)) (s X x, k0.kop X (s X x) (mside X x sd)) =
    bkMv X x (k0.kop X (s X x) (mside X x sd)) ;

  kside (X : Ob) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f)
    : Id (TT.EI W) (TT.E.act W X f (x, kop X x sd)) (m.mE W (sd.pv W f i)) =
    mTinj W (TT.E.act W X f (x, kop X x sd)) (m.mE W (sd.pv W f i))
      (transH (symH (sd.ppt W f i)) (symH (m.mpt W (sd.pv W f i))))
      (transH (symH (mTnat W X f (x, kop X x sd)))
        (transH (apH (TT0.E.act W X f) (kopMv X x sd))
          (transH (k0.kside X (s X x) (mside X x sd) W f i) (symH (sq W (sd.pv W f i)))))) ;

  kunif (Y X : Ob) (h : Hom Y X) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x])
    : Id (TT.EI Y) (TT.E.act Y X h (x, kop X x sd)) (D.act Y X h x, kop Y (D.act Y X h x) (PD.rside Y X h x sd)) =
    mTinj Y (TT.E.act Y X h (x, kop X x sd)) (D.act Y X h x, kop Y (D.act Y X h x) (PD.rside Y X h x sd))
      (refl (D.act Y X h x))
      (transH (symH (mTnat Y X h (x, kop X x sd)))
       (transH (apH (TT0.E.act Y X h) (kopMv X x sd))
        (transH (k0.kunif Y X h (s X x) (mside X x sd))
         (transH (RG.kop-cong k0 Y (D0.act Y X h (s X x)) (s Y (D.act Y X h x)) (symH (s-nat Y X h x))
                    (PG.rside Y X h (s X x) (mside X x sd)) (mside Y (D.act Y X h x) (PD.rside Y X h x sd)) (mside-restr Y X h x sd))
                 (symH (kopMv Y (D.act Y X h x) (PD.rside Y X h x sd))))))) ;

  opaque kside ; opaque kunif ;

  rc : RD.RC = new RD.RC[kop, kside, kunif] ;

  -- a structure whose extensions move to k0's is the moved one
  unique (k' : RD.RC)
    (H : (X : Ob) (x : W1.Ix (D.ob X)) (sd : PD.Side[X, x]) -> Id (TT0.EI X) (mT X (x, k'.kop X x sd)) (s X x, k0.kop X (s X x) (mside X x sd)))
    : Id (RD.RC) k' rc =
    RD.rc-ext k' rc (\ X x sd ->
      TT.pr-inj X x (k'.kop X x sd) (kop X x sd)
        (mTinj X (x, k'.kop X x sd) (x, kop X x sd) (refl x) (transH (H X x sd) (symH (kopMv X x sd))))) ;

  opaque unique ;
} ;
