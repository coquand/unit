-- CDFactor.seg (L8, Delta): seg/model DFactor.seg ported (module names only).  Was: every map h : [Y] -> [X] of Delta is
--   the identity, or
--   d_y (s_y h)          (h injective, missing y: Simp.missing), or
--   (h d_j) s_j          (h not injective: h j = h (j+1))
-- (the cases decrease Y + X; DNormE uses them for the uniformity).
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
open CDSimpId[a] ;
module DPm = CDPrism[a] ;
open CDCapBase[a] ;
open CDSurj[a] ;
open CDCapT[a] ;

------------------------------------------------------------------------
-- strictly increasing from adjacent steps

adjStr (m : Nat) (g : Nat -> Nat) (adj : (j : Nat) -> IsT (ltb j m) -> IsT (ltb (g j) (g (suc j)))) : Str m g = \ i j hj lt -> go i j hj lt
 where {
   -- i < j + 1 gives i = j or i < j
   leb-split' (i j : Nat) (h : IsT (ltb i (suc j))) : IsT (or (eqN i j) (ltb i j)) =
     ltb-dec (IsT (or (eqN i j) (ltb i j))) i j (\ l -> or-r (eqN i j) (ltb i j) l)
       (\ ge -> or-l (eqN i j) (ltb i j) (substH (\ z -> IsT (eqN i z)) (le-antisym i j h ge) (eqN-refl i))) ;
   go (i : Nat) : (j : Nat) -> IsT (leb j m) -> IsT (ltb i j) -> IsT (ltb (g i) (g j)) = split {
     zero -> \ hj lt -> absurd _ (false-true (leb-trans (suc i) zero zero lt (refl true))) ;
     suc j | ih-j -> \ hj lt -> or-elim (IsT (ltb (g i) (g (suc j)))) (eqN i j) (ltb i j) (leb-split' i j lt)
                           (\ e -> substH (\ z -> IsT (ltb (g z) (g (suc j)))) (symH (eqN-sound i j e)) (adj j hj))
                           (\ l -> leb-trans (suc (g i)) (g j) (g (suc j)) (ih-j (leb-trans j (suc j) m (leb-suc j) hj) l)
                                     (ltb-leb (g j) (g (suc j)) (adj j hj))) } ;
 } ;

------------------------------------------------------------------------
-- injective or not

strictB (Y' X : Nat) (h : Hom (lin (suc Y')) (lin X)) : Bool =
  forallUp Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) ;

strict-Str (Y' X : Nat) (h : Hom (lin (suc Y')) (lin X)) (t : IsT (strictB Y' X h)) : Str (suc Y') (valT (suc Y') X h) =
  adjStr (suc Y') (valT (suc Y') X h) (\ j hj -> fa-e Y' (\ j' -> ltb (valT (suc Y') X h j') (valT (suc Y') X h (suc j'))) t j hj) ;

-- not injective: two consecutive vertices have the same image
notStrict (Y' X : Nat) (h : Hom (lin (suc Y')) (lin X)) (nf : Id Bool (strictB Y' X h) false)
  : (j : Nat) * (IsT (leb j Y') * Id Nat (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) =
  ((fa-false Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) nf).1,
   ((fa-false Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) nf).2.1,
    le-antisym _ _ (valT-mono (suc Y') X h _ _ (leb-suc (fa-false Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) nf).1))
      (not-ltb-leb (valT (suc Y') X h (fa-false Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) nf).1)
                   (valT (suc Y') X h (suc (fa-false Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) nf).1))
                   (fa-false Y' (\ j -> ltb (valT (suc Y') X h j) (valT (suc Y') X h (suc j))) nf).2.2))) ;

-- h = (h d_j) s_j when h j = h (j+1)
degFac (Y' X : Nat) (h : Hom (lin (suc Y')) (lin X)) (j : Nat) (hj : IsT (leb j Y'))
  (eqv : Id Nat (valT (suc Y') X h j) (valT (suc Y') X h (suc j)))
  : Id (Hom (lin (suc Y')) (lin X)) (compH (lin (suc Y')) (lin Y') (lin X) (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' j)) (dgH Y' j)) h =
  homVal (suc Y') X _ h (\ x hx ->
    transH (DPm.valT-comp (suc Y') Y' X (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' j)) (dgH Y' j) x hx)
      (transH (apH (valT Y' X (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' j))) (valT-dgx Y' j x hx))
        (transH (DPm.valT-comp Y' (suc Y') X h (dl Y' j) (dg Y' j x) (dg-range Y' j x hx))
          (transH (apH (valT (suc Y') X h) (valT-dlx Y' j (dg Y' j x) (dg-range Y' j x hx)))
             (eqN-dec (Id Nat (valT (suc Y') X h (skip j (dg Y' j x))) (valT (suc Y') X h x)) x j
                (\ q -> transH (apH (\ z -> valT (suc Y') X h (skip j (dg Y' j z))) q)
                          (transH (apH (valT (suc Y') X h) (transH (apH (skip j) (dg-lo Y' j j (leb-refl j) hj)) (skip-ge j j (leb-refl j))))
                                  (transH (symH eqv) (apH (valT (suc Y') X h) (symH q)))))
                (\ nq -> apH (valT (suc Y') X h) (skip-dg Y' j x (leb-step j Y' hj) hx nq))))))) ;

-- h = d_y (s_y h) when h misses y
faceFac (Y X' y : Nat) (hy : IsT (leb y (suc X'))) (h : Hom (lin Y) (lin (suc X'))) (m : IsT (missB Y (suc X') h y))
  : Id (Hom (lin Y) (lin (suc X'))) (compH (lin Y) (lin X') (lin (suc X')) (dl X' y) (compH (lin Y) (lin (suc X')) (lin X') (dgH X' y) h)) h =
  hom-eq (lin Y) (lin (suc X')) _ h (pw-factor (lin Y) X' y h hy (miss-of Y X' y h m)) ;

-- a map with identity values is the identity
idVal (X : Nat) (h : Hom (lin X) (lin X)) (v : (i : Nat) -> IsT (leb i X) -> Id Nat (valT X X h i) i) : Id (Hom (lin X) (lin X)) h (idH (lin X)) =
  homVal X X h (idH (lin X)) (\ i hi -> transH (v i hi) (symH (valT-id X i hi))) ;
