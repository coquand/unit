-- CExt4.seg (L5, inside CB; quarry seg/model GExt4, was Ext4.seg): MODEL/Poset/Ext.agda, part 4.  ext(alpha) : Ext -> A (extE on
-- the total presheaves: alpha on the B part, the first component on
-- pairs), the PMap extMap; glue: a pair at any point gives an element of
-- Ext (its B part at the identity when the point is full); ext-det: an
-- element of Ext is determined by its image in A and by its restrictions
-- to the full points.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
open VCode[l] ;
module GP = CCof[l] ;

module ExtB4 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR]) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;

  ----------------------------------------------------------------------
  -- ext(alpha) : Ext -> A

  extE' (X : Ob) (rho : W0.Ix (G.ob X)) : (c : Bool) (e : Id Bool (full X rho) c) -> W0.Ix (ExtV X rho c e) -> TA.EI X = split {
    true -> \ e u -> toEA X (al.mE X ((rho, e), u)) ;
    false -> \ e u -> (rho, pa X rho u) } ;

  extE (X : Ob) (v : TX.EI X) : TA.EI X = extE' X v.1 (full X v.1) (refl (full X v.1)) v.2 ;

  epAux (X : Ob) (rho : W0.Ix (G.ob X))
    : (c : Bool) (e : Id Bool (full X rho) c) (u : W0.Ix (ExtV X rho c e)) -> Id (W0.Ix (G.ob X)) (extE' X rho c e u).1 rho = split {
    true -> \ e u -> apH (\ z -> z.1) (al.mpt X ((rho, e), u)) ;
    false -> \ e u -> refl rho } ;

  extE-pt (X : Ob) (v : TX.EI X) : Id (W0.Ix (G.ob X)) (extE X v).1 v.1 = epAux X v.1 (full X v.1) (refl (full X v.1)) v.2 ;

  ebAux (X : Ob) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho)) (b : TB.T X (rho, p))
    : (c : Bool) (e : Id Bool (full X rho) c) -> Id (TA.EI X) (extE' X rho c e (inB' X rho c e p b)) (toEA X (al.mE X ((rho, p), b))) = split {
    true -> \ e ->
      idJ (IsT (full X rho)) p
        (\ e2 P2 -> Id (TA.EI X) (toEA X (al.mE X ((rho, e2), substq X rho p e2 P2 b))) (toEA X (al.mE X ((rho, p), b))))
        (refl (toEA X (al.mE X ((rho, p), b)))) e (pp X rho p e) ;
    false -> \ e -> absurd _ (false-true (transH (symH e) p)) } ;

  extE-B (X : Ob) (w : TB.EI X) : Id (TA.EI X) (extE X (fromB X w)) (toEA X (al.mE X w)) =
    ebAux X w.1.1 w.1.2 w.2 (full X w.1.1) (refl (full X w.1.1)) ;

  epPAux (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    : (c : Bool) (e : Id Bool (full X rho) c) -> Id (TA.EI X) (extE' X rho c e (inP' X rho c e np u)) (rho, pa X rho u) = split {
    true -> \ e -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> refl (rho, pa X rho u) } ;

  extE-P (X : Ob) (rho : W0.Ix (G.ob X)) (np : Id Bool (full X rho) false) (u : Pairs X rho)
    : Id (TA.EI X) (extE X (fromP X rho np u)) (rho, pa X rho u) = epPAux X rho np u (full X rho) (refl (full X rho)) ;

  module EN (Y X : Ob) (h : Hom Y X) (v : TX.EI X) {
    module PA = PAct[Y, X, h, v.1, G.act Y X h v.1, refl (G.act Y X h v.1)] ;

    full-case (p : IsT (full X v.1)) : Id (TA.EI Y) (extE Y (EX.act Y X h v)) (EA.act Y X h (extE X v)) =
      transH (apH (\ z -> extE Y (EX.act Y X h z)) (symH (fromB-toB X v p)))
       (transH (apH (extE Y) (actX-B Y X h (toB X v p)))
        (transH (extE-B Y (EB.act Y X h (toB X v p)))
         (transH (apH (toEA Y) (al.mnat Y X h (toB X v p)))
          (transH (toEA-act Y X h (al.mE X (toB X v p)))
           (transH (apH (EA.act Y X h) (symH (extE-B X (toB X v p))))
                   (apH (\ z -> EA.act Y X h (extE X z)) (fromB-toB X v p))))))) ;

    nonfull-case (np : Id Bool (full X v.1) false) : Id (TA.EI Y) (extE Y (EX.act Y X h v)) (EA.act Y X h (extE X v)) =
      transH (apH (\ z -> extE Y (EX.act Y X h z)) (symH (fromP-toP X v np)))
       (transH (caseFull Y (G.act Y X h v.1)
                 (Id (TA.EI Y) (extE Y (EX.act Y X h (fromP X v.1 np (toP X v np)))) (EA.act Y X h (v.1, pa X v.1 (toP X v np))))
                 (\ q -> transH (apH (extE Y) (actX-PB Y X h v.1 np (toP X v np) q))
                          (transH (extE-B Y (pb X v.1 (toP X v np) Y h q)) (pal X v.1 (toP X v np) Y h q)))
                 (\ np' -> transH (apH (extE Y) (actX-PP Y X h v.1 np (toP X v np) np'))
                            (transH (extE-P Y (G.act Y X h v.1) np' (PA.pact (toP X v np)))
                             (transH (apH {TA.T Y (G.act Y X h v.1)} {TA.EI Y} (\ z -> (G.act Y X h v.1, z)) (PA.pact-a (toP X v np)))
                                     (symH (TA.pr-tact Y X h v.1 (G.act Y X h v.1) (refl (G.act Y X h v.1)) (pa X v.1 (toP X v np))))))))
        (transH (apH (EA.act Y X h) (symH (extE-P X v.1 np (toP X v np))))
                (apH (\ z -> EA.act Y X h (extE X z)) (fromP-toP X v np)))) ;

    res : Id (TA.EI Y) (extE Y (EX.act Y X h v)) (EA.act Y X h (extE X v)) =
      caseFull X v.1 (Id (TA.EI Y) (extE Y (EX.act Y X h v)) (EA.act Y X h (extE X v))) full-case nonfull-case ;
  } ;

  extE-nat (Y X : Ob) (h : Hom Y X) (v : TX.EI X) : Id (TA.EI Y) (extE Y (EX.act Y X h v)) (EA.act Y X h (extE X v)) = EN[Y, X, h, v].res ;

  opaque epAux ; opaque extE-pt ; opaque ebAux ; opaque extE-B ; opaque epPAux ; opaque extE-P ; opaque extE-nat ;

  extMap : CPartial[l].PMap[G, ExtT, A] = new CPartial[l].PMap[G, ExtT, A, extE, extE-pt, extE-nat] ;

  ----------------------------------------------------------------------
  -- glue: a pair at any point gives an element of Ext

  qId (X : Ob) (rho : W0.Ix (G.ob X)) (p : IsT (full X rho)) : IsT (full X (G.act X X (idH X) rho)) =
    full-eq X rho (G.act X X (idH X) rho) (symH (G.act-id X rho)) p ;

  glue' (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : (c : Bool) (e : Id Bool (full X rho) c) -> TX.EI X = split {
    true -> \ e -> fromB X (pb X rho u X (idH X) (qId X rho e)) ;
    false -> \ e -> fromP X rho e u } ;

  glue (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : TX.EI X = glue' X rho u (full X rho) (refl (full X rho)) ;

  gbAux (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (p : IsT (full X rho)) (q : IsT (full X (G.act X X (idH X) rho)))
    : (c : Bool) (e : Id Bool (full X rho) c) -> Id (TX.EI X) (glue' X rho u c e) (fromB X (pb X rho u X (idH X) q)) = split {
    true -> \ e -> apH (\ z -> fromB X (pb X rho u X (idH X) z)) (isProp-IsT' (full X (G.act X X (idH X) rho)) (qId X rho e) q) ;
    false -> \ e -> absurd _ (false-true (transH (symH e) p)) } ;

  glue-B (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (p : IsT (full X rho)) (q : IsT (full X (G.act X X (idH X) rho)))
    : Id (TX.EI X) (glue X rho u) (fromB X (pb X rho u X (idH X) q)) = gbAux X rho u p q (full X rho) (refl (full X rho)) ;

  gpAux (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (np : Id Bool (full X rho) false)
    : (c : Bool) (e : Id Bool (full X rho) c) -> Id (TX.EI X) (glue' X rho u c e) (fromP X rho np u) = split {
    true -> \ e -> absurd _ (false-true (transH (symH np) e)) ;
    false -> \ e -> apH (\ z -> fromP X rho z u) (W0.isSetIx W0.boolV (full X rho) false e np) } ;

  glue-P (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (np : Id Bool (full X rho) false)
    : Id (TX.EI X) (glue X rho u) (fromP X rho np u) = gpAux X rho u np (full X rho) (refl (full X rho)) ;

  glue-pt (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : Id (W0.Ix (G.ob X)) (glue X rho u).1 rho =
    caseFull X rho (Id (W0.Ix (G.ob X)) (glue X rho u).1 rho)
      (\ p -> transH (apH (\ z -> z.1) (glue-B X rho u p (qId X rho p))) (G.act-id X rho))
      (\ np -> apH (\ z -> z.1) (glue-P X rho u np)) ;

  glue-ext (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) : Id (TA.EI X) (extE X (glue X rho u)) (rho, pa X rho u) =
    caseFull X rho (Id (TA.EI X) (extE X (glue X rho u)) (rho, pa X rho u))
      (\ p -> transH (apH (extE X) (glue-B X rho u p (qId X rho p)))
               (transH (extE-B X (pb X rho u X (idH X) (qId X rho p)))
                (transH (pal X rho u X (idH X) (qId X rho p)) (EA.act-id X (rho, pa X rho u)))))
      (\ np -> transH (apH (extE X) (glue-P X rho u np)) (extE-P X rho np u)) ;

  module GA (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) {
    module PA = PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)] ;

    gB (q : IsT (full Y (G.act Y X h rho)))
      : Id (TX.EI Y) (fromB Y (pb X rho u Y h q)) (glue Y (G.act Y X h rho) (PA.pact u)) =
      transH (apH (fromB Y)
                (transH (pb-hom X rho u Y h (compH Y Y X h (idH Y)) (symH (comp-idr Y X h)) q (PA.qTr Y (idH Y) (qId Y (G.act Y X h rho) q)))
                        (symH (PA.pact-b u Y (idH Y) (qId Y (G.act Y X h rho) q)))))
             (symH (glue-B Y (G.act Y X h rho) (PA.pact u) q (qId Y (G.act Y X h rho) q))) ;

    -- the point idH h = h of a full rho is full
    qIdl (p : IsT (full X rho)) : IsT (full Y (G.act Y X (compH Y X X (idH X) h) rho)) =
      full-eq Y (G.act Y X h rho) (G.act Y X (compH Y X X (idH X) h) rho)
        (apH (\ k -> G.act Y X k rho) (symH (comp-idl Y X h))) (full-act Y X h rho p) ;

    res : Id (TX.EI Y) (EX.act Y X h (glue X rho u)) (glue Y (G.act Y X h rho) (PA.pact u)) =
      caseFull X rho (Id (TX.EI Y) (EX.act Y X h (glue X rho u)) (glue Y (G.act Y X h rho) (PA.pact u)))
        (\ p -> transH (apH (EX.act Y X h) (glue-B X rho u p (qId X rho p)))
                 (transH (actX-B Y X h (pb X rho u X (idH X) (qId X rho p)))
                  (transH (apH (fromB Y) (transH (pnatF X rho u Y X h (idH X) (qId X rho p) (qIdl p))
                                                 (pb-hom X rho u Y (compH Y X X (idH X) h) h (comp-idl Y X h) (qIdl p) (full-act Y X h rho p))))
                          (gB (full-act Y X h rho p)))))
        (\ np -> transH (apH (EX.act Y X h) (glue-P X rho u np))
                  (caseFull Y (G.act Y X h rho) (Id (TX.EI Y) (EX.act Y X h (fromP X rho np u)) (glue Y (G.act Y X h rho) (PA.pact u)))
                     (\ q -> transH (actX-PB Y X h rho np u q) (gB q))
                     (\ np' -> transH (actX-PP Y X h rho np u np') (symH (glue-P Y (G.act Y X h rho) (PA.pact u) np'))))) ;
  } ;

  glue-act (Y X : Ob) (h : Hom Y X) (rho : W0.Ix (G.ob X)) (u : Pairs X rho)
    : Id (TX.EI Y) (EX.act Y X h (glue X rho u)) (glue Y (G.act Y X h rho) (PAct[Y, X, h, rho, G.act Y X h rho, refl (G.act Y X h rho)].pact u)) =
    GA[Y, X, h, rho, u].res ;

  ----------------------------------------------------------------------
  -- An element of Ext is determined by its image in A and by its
  -- restrictions to the full points

  ExtEfTy (X : Ob) (v v' : TX.EI X) : U l =
    (W : Ob) (f : Hom W X) -> IsT (full W (G.act W X f v.1)) -> Id (TX.EI W) (EX.act W X f v) (EX.act W X f v') ;

  module ED (X : Ob) (v : TX.EI X) (u2 : W0.Ix (extOb X v.1))
    (ee : Id (TA.EI X) (extE X v) (extE X (v.1, u2))) (ef : ExtEfTy X v (v.1, u2)) {
    rho : W0.Ix (G.ob X) = v.1 ;
    w2 : TX.EI X = (v.1, u2) ;

    epa (np : Id Bool (full X rho) false) : Id (TA.T X rho) (pa X rho (toP X v np)) (pa X rho (toP X w2 np)) =
      TA.pr-inj X rho (pa X rho (toP X v np)) (pa X rho (toP X w2 np))
        (transH (symH (extE-P X rho np (toP X v np)))
         (transH (apH (extE X) (fromP-toP X v np))
          (transH ee
           (transH (apH (extE X) (symH (fromP-toP X w2 np))) (extE-P X rho np (toP X w2 np)))))) ;

    epb (np : Id Bool (full X rho) false) (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      : Id (TB.EI W) (pb X rho (toP X v np) W f q) (pb X rho (toP X w2 np) W f q) =
      fromB-inj W (pb X rho (toP X v np) W f q) (pb X rho (toP X w2 np) W f q)
        (transH (symH (actX-PB W X f rho np (toP X v np) q))
         (transH (apH (EX.act W X f) (fromP-toP X v np))
          (transH (ef W f q)
           (transH (apH (EX.act W X f) (symH (fromP-toP X w2 np))) (actX-PB W X f rho np (toP X w2 np) q))))) ;

    res : Id (TX.EI X) v w2 =
      caseFull X rho (Id (TX.EI X) v w2)
        (\ p -> transH (symH (EX.act-id X v)) (transH (ef X (idH X) (qId X rho p)) (EX.act-id X w2)))
        (\ np -> transH (symH (fromP-toP X v np))
                  (transH (apH (fromP X rho np) (pairs-eq X rho (toP X v np) (toP X w2 np) (epa np) (epb np)))
                          (fromP-toP X w2 np))) ;
  } ;

  ext-det (X : Ob) (v v' : TX.EI X) (P : Id (W0.Ix (G.ob X)) v.1 v'.1) (ee : Id (TA.EI X) (extE X v) (extE X v'))
    (ef : ExtEfTy X v v') : Id (TX.EI X) v v' =
    idJ (W0.Ix (G.ob X)) v.1
      (\ r2 P2 -> (u2 : W0.Ix (extOb X r2)) -> Id (TA.EI X) (extE X v) (extE X (r2, u2)) -> ExtEfTy X v (r2, u2) -> Id (TX.EI X) v (r2, u2))
      (\ u2 ee2 ef2 -> ED[X, v, u2, ee2, ef2].res)
      v'.1 P v'.2 ee ef ;

  opaque gbAux ; opaque glue-B ; opaque gpAux ; opaque glue-P ; opaque glue-pt ; opaque glue-ext ; opaque glue-act ; opaque ext-det ;
} ;

-- the codes of Ext are reached through extOb-B / extOb-P (GExt3) from here on
opaque CExt2[l].ExtB2.extOb ;
