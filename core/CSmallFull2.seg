-- CSmallFull2.seg (L6, inside CB, any classifier): (C2), part 2.  Po1 (Fb's
-- fibres are those of the small Ext along yhat y), P3 (read in Ext_U the
-- transport along Po1 is Kb followed by fromB: PF, extOb-B, V a set), the
-- transport is natural (Ext_U's cart is injective), hence Fb.1 = T (tyEq).
--
-- Quarry: seg/model GUaFullT (Po, cmp, PhNphi, TP).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;
open GYon[a] ;
open Encode[a, a+] ;

module F2 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx,
                                    CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  (W : Ob) (y : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 W)
  (q : IsT (CGlueD.fl W y.1.2.1 W (idH W))) {
  module A = CSmallFull1.F1[Cl, clSub, clSub-id, clSub-o, encCl, elFib, W, y, q] ;
  module UU = A.UU ;
  Fb1 : PTy[yP W] = A.Fb.1 ;
  module SFl = CSmall.SmallFib[A.UB.GDr, A.XS.SA, yP W, A.l] ;
  module FF = CExtFullFib[a+].FF[A.UB.GDr, A.UB.AU, A.UB.psiU, A.UB.BU, A.UB.alU, A.XS.FU.cAU, A.XS.FU.cBU, A.XS.FU.E2.eqU] ;
  module K1 = CCartLaws2[a, a+, a+].CC[yP W, A.T, A.UB.GDr, A.XS.upSA, A.UB.GDr, A.UB.ExtBig, A.l.nt, A.l.nt-nat, SFl.ta, \ W w -> refl (A.l.nt W w.1), SFl.tanat, SFl.tainj, \ X x u -> u, \ X x u -> refl (A.l.nt X x, u), \ W x -> x, \ V W g x -> refl (A.UB.GDr.act V W g x), A.XS.ta, \ W v -> refl v.1, A.XS.tanat, A.XS.tainj, A.XS.bk, A.XS.bkta] ;
  module KB = CCartLaws2[a, a+, a+].CC[yP W, Fb1, A.RES, A.UB.BU, A.UB.GDr, A.UB.ExtBig, A.sb, A.sb-nat, A.tb, \ W v -> refl (A.sb W v.1), A.tbnat, A.tbinj, A.bkb, A.bkbta, FF.FC.cs, FF.FC.cs-nat, FF.FC.ctB, FF.FC.ctBpt, FF.FC.ctBnat, FF.FC.ctBinj, FF.FC.bkB, FF.FC.cbkBta] ;

  ----------------------------------------------------------------------
  -- the fibres

  module AtG (V : Ob) (g : Hom V W) {
    w' : V1.Ix (A.UB.GDr.ob V) = (A.sb V g).1 ;
    module At = A.XS.CM.At[V, w'] ;
    e' : IsT (A.UB.CU.full V w') = (A.sb V g).2 ;
    e : IsT (At.DT.CL.full V (idH V)) = At.fU2D e' ;

    c1 : Id W0.V (At.obD) (UU.fib0 V (At.cD e)) = At.E3d.extOb-B V (idH V) e ;
    c2 : Id W0.V (UU.fib0 V (At.cD e)) (UU.fib0 V (At.cU e')) = apH (UU.fib0 V) (At.PDU e e') ;
    c3 : Id W0.V (UU.fib0 V (At.cU e')) (UU.fib0 V (UU.uAct V W g A.Fb)) = apH (UU.fib0 V) (A.cc V g) ;
    c4 : Id W0.V (UU.fib0 V (UU.uAct V W g A.Fb)) (Fb1.tob V g) = A.Y.Po V g ;

    Po1 : Id W0.V (Fb1.tob V g) (A.T.tob V g) = symH (transH c1 (transH c2 (transH c3 c4))) ;

    z (b : W0.Ix (Fb1.tob V g)) : W0.Ix (A.T.tob V g) = CExtEq1.sV (Fb1.tob V g) (A.T.tob V g) Po1 b ;

    -- ph z read in B is kb b
    X (b : W0.Ix (Fb1.tob V g)) : Id (W0.Ix (UU.fib0 V (At.cU e'))) (At.E3u.toB V (w', At.ph (z b)) e').2 (A.kb V g b) =
      calc (W0.Ix (UU.fib0 V (At.cU e'))) {
          (At.E3u.toB V (w', At.ph (z b)) e').2
        =< At.PF[e, e', z b].res >
          A.DD.trB V (At.cD e) (At.cU e') (At.PDU e e') (At.E3d.toB V (idH V, z b) e).2
        =< UU.substF V (At.cD e) (At.cU e') (At.PDU e e') (At.E3d.toB V (idH V, z b) e).2 >
          CExtEq1.sV (UU.fib0 V (At.cD e)) (UU.fib0 V (At.cU e')) c2 (At.E3d.toB V (idH V, z b) e).2
        =< apH (CExtEq1.sV (UU.fib0 V (At.cD e)) (UU.fib0 V (At.cU e')) c2) (symH (At.E3d.extOb-B-sub V (idH V) e (z b))) >
          CExtEq1.sV (UU.fib0 V (At.cD e)) (UU.fib0 V (At.cU e')) c2 (CExtEq1.sV At.obD (UU.fib0 V (At.cD e)) c1 (z b))
        =< CExtEq1.sV-comp At.obD (UU.fib0 V (At.cD e)) (UU.fib0 V (At.cU e')) c1 c2 (z b) >
          CExtEq1.sV At.obD (UU.fib0 V (At.cU e')) (transH c1 c2) (z b)
        =< CExtEq1.sV-comp (Fb1.tob V g) At.obD (UU.fib0 V (At.cU e')) Po1 (transH c1 c2) b >
          CExtEq1.sV (Fb1.tob V g) (UU.fib0 V (At.cU e')) (transH Po1 (transH c1 c2)) b
        =< CExtEq1.sV-irr (Fb1.tob V g) (UU.fib0 V (At.cU e')) (transH Po1 (transH c1 c2)) (transH (symH c4) (symH c3)) b >
          CExtEq1.sV (Fb1.tob V g) (UU.fib0 V (At.cU e')) (transH (symH c4) (symH c3)) b
        =< symH (CExtEq1.sV-comp (Fb1.tob V g) (UU.fib0 V (UU.uAct V W g A.Fb)) (UU.fib0 V (At.cU e')) (symH c4) (symH c3) b) >
          CExtEq1.sV (UU.fib0 V (UU.uAct V W g A.Fb)) (UU.fib0 V (At.cU e')) (symH c3) (A.Y.ta V (g, b)).2
        =< CExtEq1.sV-irr (UU.fib0 V (UU.uAct V W g A.Fb)) (UU.fib0 V (At.cU e')) (symH c3)
             (apH (UU.fib0 V) (symH (A.cc V g))) (A.Y.ta V (g, b)).2 >
          CExtEq1.sV (UU.fib0 V (UU.uAct V W g A.Fb)) (UU.fib0 V (At.cU e')) (apH (UU.fib0 V) (symH (A.cc V g))) (A.Y.ta V (g, b)).2
        =< symH (UU.substF V (UU.uAct V W g A.Fb) (A.UB.bmap.nt V (A.sb V g)) (symH (A.cc V g)) (A.Y.ta V (g, b)).2) >
          A.kb V g b } ;

    P3 (b : W0.Ix (Fb1.tob V g)) : Id (A.XS.TX.EI V) (K1.ta V (g, z b)) (A.E3u.fromB V (A.tb V (g, b))) =
      transH (symH (At.E3u.fromB-toB V (w', At.ph (z b)) e')) (apH (\ t -> At.E3u.fromB V ((w', e'), t)) (X b)) ;

    opaque X ; opaque P3 ;
  } ;

  ----------------------------------------------------------------------
  -- the transport along Po1 is natural, so Fb.1 = T

  module TF = GPR.TyL[yP W, Fb1] ;
  module TT = GPR.TyL[yP W, A.T] ;

  f (V : Ob) (v : TF.EI V) : TT.EI V = (v.1, AtG[V, v.1].z v.2) ;

  fnat (V' V : Ob) (k : Hom V' V) (v : TF.EI V) : Id (TT.EI V') (TT.E.act V' V k (f V v)) (f V' (TF.E.act V' V k v)) =
    K1.tainj V' (TT.E.act V' V k (f V v)) (f V' (TF.E.act V' V k v)) (refl ((yP W).act V' V k v.1))
      (calc (A.XS.TX.EI V') {
          K1.ta V' (TT.E.act V' V k (f V v))
        =< symH (K1.tanat V' V k (f V v)) >
          A.XS.TX.E.act V' V k (K1.ta V (f V v))
        =< apH (A.XS.TX.E.act V' V k) (AtG[V, v.1].P3 v.2) >
          A.XS.TX.E.act V' V k (KB.ta V v)
        =< KB.tanat V' V k v >
          KB.ta V' (TF.E.act V' V k v)
        =< symH (AtG[V', (TF.E.act V' V k v).1].P3 (TF.E.act V' V k v).2) >
          K1.ta V' (f V' (TF.E.act V' V k v)) }) ;

  H1 (J I : Ob) (k : Hom J I) (x : Hom I W) (y' : Hom J W) (e : Id (Hom J W) ((yP W).act J I k x) y') (a0 : W0.Ix (Fb1.tob I x))
    : Id (W0.Ix (A.T.tob J y')) (subst W0.V (\ z -> W0.Ix z) (Fb1.tob J y') (A.T.tob J y') (AtG[J, y'].Po1) (Fb1.tact J I k x y' e a0))
                                (A.T.tact J I k x y' e (subst W0.V (\ z -> W0.Ix z) (Fb1.tob I x) (A.T.tob I x) (AtG[I, x].Po1) a0)) =
    TT.pr-inj J y' (AtG[J, y'].z (Fb1.tact J I k x y' e a0)) (A.T.tact J I k x y' e (AtG[I, x].z a0))
      (calc (TT.EI J) {
          f J (y', Fb1.tact J I k x y' e a0)
        =< apH (f J) (symH (TF.pr-tact J I k x y' e a0)) >
          f J (TF.E.act J I k (x, a0))
        =< symH (fnat J I k (x, a0)) >
          TT.E.act J I k (f I (x, a0))
        =< TT.pr-tact J I k x y' e (AtG[I, x].z a0) >
          (y', A.T.tact J I k x y' e (AtG[I, x].z a0)) }) ;

  opaque fnat ; opaque H1 ;

  tyEq : Id (PTy[yP W]) Fb1 A.T = CElC.TyEqPw[yP W, Fb1, A.T, \ V g -> AtG[V, g].Po1, H1].tyEq ;
} ;
