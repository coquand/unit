-- Hornbox(2) commutes with substitution along a stagewise injection.
level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module B = CDeltaBase[a].DB ;
module Cl = CDeltaCl[a] ;
module W = V[lz] ;
module P = B.GPre[lz] ;
open P.PS ;

module AlongMono (lem : [b] (X : U b) -> Prelude[b].isProp X -> Arith[b].Plus X (X -> Empty))
  (D G : PCtx) (s : PSub[D, G])
  (inj : (I : Nat) (x y : W.Ix (D.ob I)) -> Id (W.Ix (G.ob I)) (s.nt I x) (s.nt I y) -> Id (W.Ix (D.ob I)) x y)
  (A : PTy[G]) (h : CDHornFib[a, lz].DH[G, A].isFib) {
  module M = CDDeltaRussell.Delta[lem] ;
  A' : PTy[D] = subTy D G A s ;
  module S = B.CFibSub[lz].FibSub[D, G, s, A] ;
  module H = M.CDHornNat[a, lz, lz].Along[D, A', G, A, s.nt, s.nt-nat,
    S.SE.mV, \ I v -> refl (s.nt I v.1), S.SE.mV-nat, S.SE.mV-inj,
    \ I x v -> v, \ I x v -> refl (s.nt I x, v), inj] ;
  module Pull = B.COpMove[lz, lz].Pull[Cl.HIx, Cl.hOk, Cl.hOb, Cl.hS,
    D, A', G, A, s.nt, s.nt-nat, \ I x b -> b, \ I x b -> b,
    \ I x b -> refl b, \ I x b -> refl b, S.SE.mV-nat, \ i -> h i.1 i.2] ;
  module Eq = B.COpLaws[lz, lz, lz].OL[Cl.HIx, Cl.hOk, Cl.hOb, Cl.hS].At[G, A, \ i -> h i.1 i.2] ;

  restrict-horn : H.DH'.isFib = \ m i -> Pull.op (m, i) ;

  preserves : H.HornLaw restrict-horn h = \ m i hi x y p u v q ->
    Eq.opAt (m, i) hi (s.nt (suc m) x) y p (Pull.mv (m, i) x u) v q ;

  module Fill = H.CDHornNormal.Normal[restrict-horn, h, preserves] ;

  law : Id (B.CLine[lz].Lines[D, A'].Fib)
      (M.Classical.CDeltaHornToFib[a, lz].hornToFib D A' restrict-horn)
      (S.sub (M.Classical.CDeltaHornToFib[a, lz].hornToFib G A h)) =
    Fill.nat ;
} ;
