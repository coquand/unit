-- CExtFull.seg (L5, inside CB, level l): Theorem 7 at full points
-- (model.tex Thm 7: "on full points the composition of Ext(alpha) is that
-- of B and the equivalence structure of ext is e_alpha").
--
--   C5.Full   on a problem whose line is full everywhere, the composite is
--             the top of the B-filler (beta, CExtComp1), read in Ext: the
--             identity lands in delta, so the extension is that side
--   At        at a point w with psi full at w.1, the extension extEquiv
--             gives at w is e_alpha's, translated (fromFA)
--
-- Quarry: seg/model GExtComp5, GExtFullPt.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module C5 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (eS eT : IPt) (kAS : CLine[l].Lines[G, A].Fill eS)
  (kBS : CLine[l].Lines[GP.CofL[G, psi].resCtx, B].Fill eS)
  (kA1 : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  open CExtComp1[l].C1[G, A, psi, B, al, eS, kBS] ;
  open CExtComp2[l].C2[G, A, psi, B, al, eS, kAS, kBS] ;
  open CExtComp3[l].C3[G, A, psi, B, al, eS, eT, kAS, kBS, kA1, eal] ;

  module RFX = CPartial[l].Rel[EA, FX.FibT, FX.FibT, CPartial[l].pmap-id EA FX.FibT] ;

  module Full (X : Ob) (x : KX.TV.EI X) (p : KX.PT.Side[X, x]) (fl : FlTy X x) {
    module CX = Cop[X, x, p] ;

    -- the identity lands in delta
    dI : Lands X X CX.PB.dl (idH X) =
      forall-lands X X CX.PB.Lk (idH X) (\ V g j -> full-id V (x.1.1 V (compH V X X (idH X) g) j) (fl V (compH V X X (idH X) g) j)) ;

    fin1 : Arith[a].Fin (suc (suc zero)) = (suc zero, refl true) ;

    -- the extension is the side on delta at the identity
    vE-full : Id (FX.TF.EI X) CX.vE (CX.fe2 X (idH X) dI) =
      transH (RFX.kfull E3.extEquiv X CX.w1 CX.J2.side (CX.J2.inS fin1 X (idH X) dI))
             (CX.J2.pv-in fin1 X (idH X) dI (CX.J2.inS fin1 X (idH X) dI)) ;

    -- the composite is the top of the B-filler of the problem, read in Ext
    full : Id (TX.EI X) (x.1.1 X (idH X) (ptH X eT), CX.cop) (fromB X (Beta[X, x, p, fl].FBv X (idH X) (ptH X eT))) =
      transH CX.cop-E
       (transH (apH (FX.fibB X) vE-full)
        (transH (cfib-B X (TA.E.act X X (idH X) CX.w1) (CX.el2 X (idH X) dI) (CX.eq2 X (idH X) dI))
                (apH (fromB X)
                   (FBv-cong X (KX.TV.E.act X X (idH X) x) x (KX.TV.E.act-id X x) (KX.PT.rside X X (idH X) x p) p
                      (KX.PT.rside-id X x p) (CX.PB.flAt X (idH X) (CX.PB.hOf X (idH X) dI)) fl X (idH X) (ptH X eT))))) ;
  } ;
} ;

module At (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (kA : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al)
  (X : Ob) (w : PR.TyL[G, A].EI X) (p : CExtEquiv[l].ExtEq[G, A, psi, B, al, kA, eal].PX.Side[X, w])
  (q : IsT (GP.CofL[G, psi].full X w.1)) {
  module CL = GP.CofL[G, psi] ;
  module E1 = CExtEquiv[l].ExtEq[G, A, psi, B, al, kA, eal] ;
  module EE3 = CExtEquiv3[l].ExtEq3[G, A, psi, B, al, kA, eal] ;
  module E3 = CExt3[l].ExtB3[G, A, psi, B, al] ;
  module E4 = CExt4[l].ExtB4[G, A, psi, B, al] ;
  module ED = CExt[l].ExtDef[G, A, psi] ;
  module T = CExtEquiv2[l].ExtEq2[G, A, psi, B, al, kA, eal].Th[X, w, p] ;

  qi : IsT (CL.full X (G.act X X (idH X) w.1)) = CL.full-eq X w.1 (G.act X X (idH X) w.1) (symH (G.act-id X w.1)) q ;

  kk : Lands X X (CL.Q X w.1) (idH X) = CL.full-id X w.1 q ;

  thE : Id (E1.FA.TF.EI X) (T.th X (idH X) qi) (E1.kE X w q p) =
    E1.kE-cong X (ED.EA.act X X (idH X) w) w (ED.EA.act-id X w) qi q
      (E1.PX.rside X X (idH X) w p) p (E1.PX.rside-id X w p) ;

  thE' : Id (E1.FA.TF.EI X) (T.th X (idH X) (T.qOf X (idH X) kk)) (E1.kE X w q p) =
    transH (T.th-cong X (idH X) (T.qOf X (idH X) kk) qi) thE ;

  Bpart : Id (PR.TyL[G, CExt2[l].ExtB2[G, A, psi, B, al].ExtT].EI X) (E1.FX.fibB X T.v0) (E1.FX.fibB X (E1.fromFA X (E1.kE X w q p))) =
    transH T.gb-E
      (transH (E4.glue-B X w.1 T.u q qi)
        (transH (apH (E3.fromB X) (T.u-b X (idH X) qi))
          (transH (apH (\ z -> E3.fromB X (E1.FA.fibB X z)) thE)
                  (symH (E1.fromFA-B X (E1.kE X w q p)))))) ;

  Lpart (W : Ob) (f : Hom W X) (i : Hom W Iv)
    : Id (PR.TyL[G, A].EI W) (E1.FX.fibL X T.v0 W f i) (E1.FX.fibL X (E1.fromFA X (E1.kE X w q p)) W f i) =
    transH (T.Fv-eq W f (compH W X X (idH X) f) i i (symH (comp-idl W X f)) (refl i))
      (transH (T.F-S2 X (idH X) kk W f i)
        (transH (apH (\ z -> ED.toEA W (E1.FA.fibL X z W f i)) thE')
                (symH (E1.fromFA-L X (E1.kE X w q p) W f i)))) ;

  -- the extension at a full point is e_alpha's
  extEqFull : Id (E1.FX.TF.EI X) (w, EE3.extEquiv.kop X w p) (E1.fromFA X (E1.kE X w q p)) =
    E1.FX.fibE-eq X (w, EE3.extEquiv.kop X w p) (E1.fromFA X (E1.kE X w q p))
      (symH (E1.fromFA-pt X (E1.kE X w q p))) Bpart Lpart ;

  opaque thE ; opaque thE' ; opaque Bpart ; opaque Lpart ; opaque extEqFull ;
} ;
