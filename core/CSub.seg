-- CSub.seg (L2, inside CB, level l): substitution and joins.
--
--   SubE      the lift of C[s] into C (mV), natural, injective over equal
--             points
--   SubMap    a map of types substituted along s
--   RcSub     a relative structure substituted along s: Move with the
--             identity on fibres (CMove); its laws are CMoveLaws.Comp
--
-- Quarry: seg/model GCofib (SubE, ContrSub), GEquivSub (SubMap).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module SubE (D G : PCtx) (s : PSub[D, G]) (C : PTy[G]) {
  module TC = GPR.TyL[G, C] ;
  module TS = GPR.TyL[D, subTy D G C s] ;

  mV (W : Ob) (v : TS.EI W) : TC.EI W = (liftP D G C s).nt W v ;

  mV-nat (V W : Ob) (g : Hom V W) (v : TS.EI W) : Id (TC.EI V) (TC.E.act V W g (mV W v)) (mV V (TS.E.act V W g v)) =
    symH ((liftP D G C s).nt-nat V W g v) ;

  mV-inj (W : Ob) (v v' : TS.EI W) (P : Id (TS.Pt W) v.1 v'.1) (Q : Id (TC.EI W) (mV W v) (mV W v')) : Id (TS.EI W) v v' =
    idJ (TS.Pt W) v.1
      (\ d2 P2 -> (c2 : TS.T W d2) -> Id (TC.EI W) (mV W v) (s.nt W d2, c2) -> Id (TS.EI W) v (d2, c2))
      (\ c2 Q2 -> apH {TS.T W v.1} {TS.EI W} (\ z -> (v.1, z)) (TC.pr-inj W (s.nt W v.1) v.2 c2 Q2))
      v'.1 P v'.2 Q ;

  opaque mV-inj ;
} ;

module SubMap (D G : PCtx) (s : PSub[D, G]) (B A : PTy[G]) (al : CPartial[l].PMap[G, B, A]) {
  module SB = SubE[D, G, s, B] ;
  module SA = SubE[D, G, s, A] ;

  mE (X : Ob) (w : SB.TS.EI X) : SA.TS.EI X =
    (w.1, SA.TC.fromE X (s.nt X w.1) (al.mE X (SB.mV X w)) (al.mpt X (SB.mV X w))) ;

  -- read in A, the map is al
  mE-V (X : Ob) (w : SB.TS.EI X) : Id (SA.TC.EI X) (SA.mV X (mE X w)) (al.mE X (SB.mV X w)) =
    SA.TC.fromE-eq X (s.nt X w.1) (al.mE X (SB.mV X w)) (al.mpt X (SB.mV X w)) ;

  mnat (Y X : Ob) (h : Hom Y X) (w : SB.TS.EI X)
    : Id (SA.TS.EI Y) (mE Y (SB.TS.E.act Y X h w)) (SA.TS.E.act Y X h (mE X w)) =
    SA.mV-inj Y (mE Y (SB.TS.E.act Y X h w)) (SA.TS.E.act Y X h (mE X w)) (refl (D.act Y X h w.1))
      (transH (mE-V Y (SB.TS.E.act Y X h w))
       (transH (apH (al.mE Y) (symH (SB.mV-nat Y X h w)))
        (transH (al.mnat Y X h (SB.mV X w))
         (transH (apH (SA.TC.E.act Y X h) (symH (mE-V X w)))
                 (SA.mV-nat Y X h (mE X w)))))) ;

  opaque mE-V ; opaque mnat ;

  subMap : CPartial[l].PMap[D, subTy D G B s, subTy D G A s] =
    new CPartial[l].PMap[D, subTy D G B s, subTy D G A s, mE, \ X w -> refl w.1, mnat] ;
} ;

-- a relative structure substituted along s : D -> G
module RcSub (D G : PCtx) (s : PSub[D, G]) (S T : PTy[G]) (m : CPartial[l].PMap[G, S, T])
  (k : CPartial[l].Rel[G, S, T, m].RC) {
  module SS = SubE[D, G, s, S] ;
  module ST = SubE[D, G, s, T] ;
  module SM = SubMap[D, G, s, S, T, m] ;

  module M = CMove[l, l].Mv[D, subTy D G S s, subTy D G T s, SM.subMap, G, S, T, m, s.nt, s.nt-nat,
    SS.mV, \ W v -> refl (s.nt W v.1), SS.mV-nat, ST.mV, \ W v -> refl (s.nt W v.1), ST.mV-nat, ST.mV-inj,
    \ X x u -> u, \ X x u -> refl (s.nt X x, u), SM.mE-V, k] ;

  rc : CPartial[l].Rel[D, subTy D G S s, subTy D G T s, SM.subMap].RC = M.rc ;
} ;
