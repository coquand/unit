-- Seeded extension algebras, the operational notion of proposition in SAG.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module Algebras (G : PCtx) (B : PTy[G]) {
  open CTruncRaw[a, l].Build[G, B] ;
  F (z : Loc) : U l = W.Ix (B.tob z.1 z.2) ;
  act (s z : Loc) (h : Arr s z) (b : F z) : F s = B.tact s.1 z.1 h.1 z.2 s.2 h.2 b ;
  Total : U l = (z : Loc) * F z ;
  fibre-inj (z : Loc) (b c : F z) (p : Id Total (z,b) (z,c)) : Id (F z) b c =
    transH (symH (apH (\ e -> substH (\ w -> F w) e b) (loc-set z z q.1 (refl z)))) q.2
    where { q : (e : Id Loc z z) * Id (F z) (substH (\ w -> F w) e b) c =
      sPath Loc (\ w -> F w) (z,b) (z,c) p ; } ;
  opaque fibre-inj ;
  Seed (z : Loc) : U l = (s : Loc) -> Arr s z -> F s ;
  SeedNat (z : Loc) (u : Seed z) : U l =
    (s : Loc) (h : Arr s z) (r : Loc) (g : Arr r s) ->
    Id (F r) (act r s g (u s h)) (u r (compose r s z h g)) ;
  Partial (z : Loc) (Q : PB.Phi z.1) : U l =
    (s : Loc) (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> F s ;
  Natural (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q) : U l =
    (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) (r : Loc) (g : Arr r s)
    (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) ->
    Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j) ;
  partial-cong (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q)
    (s : Loc) (h k : Arr s z) (p : Id (Arr s z) h k)
    (i : PB.Lands s.1 z.1 Q h.1) (j : PB.Lands s.1 z.1 Q k.1)
    : Id (F s) (v s h i) (v s k j) =
    apH (\ t -> v s t.1 t.2)
      (Sigma-eq (Arr s z) (\ f -> PB.Lands s.1 z.1 Q f.1) h k i j p (isProp-IsT' (Q.1 s.1 k.1))) ;
  opaque partial-cong ;
  natural-prop (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q) : isProp (Natural z Q v) =
    isProp-Pi Loc (\ s -> (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) (r : Loc) (g : Arr r s)
      (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j)) (\ s ->
    isProp-Pi (Arr s z) (\ h -> (i : PB.Lands s.1 z.1 Q h.1) (r : Loc) (g : Arr r s)
      (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j)) (\ h ->
    isProp-Pi (PB.Lands s.1 z.1 Q h.1) (\ i -> (r : Loc) (g : Arr r s)
      (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j)) (\ i ->
    isProp-Pi Loc (\ r -> (g : Arr r s) (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) ->
      Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j)) (\ r ->
    isProp-Pi (Arr r s) (\ g -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) ->
      Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j)) (\ g ->
    isProp-Pi (PB.Lands r.1 z.1 Q (compose r s z h g).1) (\ j ->
      Id (F r) (act r s g (v s h i)) (v r (compose r s z h g) j)) (\ j -> W.isSetIx (B.tob r.1 r.2) _ _)))))) ;
  opaque natural-prop ;

  rv (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q) (s : Loc) (h : Arr s z)
    (r : Loc) (g : Arr r s) (i : PB.Lands r.1 s.1 (PB.pre s.1 z.1 h.1 Q) g.1) : F r =
    v r (compose r s z h g) i ;
  rvn (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q) (vn : Natural z Q v) (s : Loc) (h : Arr s z)
    : Natural s (PB.pre s.1 z.1 h.1 Q) (rv z Q v s h) = \ r g i q f j ->
    transH (vn r (compose r s z h g) i q f
      (PB.lands-comp q.1 r.1 z.1 Q (compose r s z h g).1 f.1 i))
      (partial-cong z Q v q _ _ (compose-assoc q r s z h g f) _ j) ;
  opaque rvn ;

  record Algebra {
    extend (z : Loc) (Q : PB.Phi z.1) (u : F z) (v : Partial z Q) (vn : Natural z Q v) : F z ;
    boundary (z : Loc) (Q : PB.Phi z.1) (u : F z) (v : Partial z Q) (vn : Natural z Q v)
      (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1)
      : Id (F s) (act s z h (extend z Q u v vn)) (v s h i) ;
    uniform (z : Loc) (Q : PB.Phi z.1) (u : F z) (v : Partial z Q) (vn : Natural z Q v)
      (s : Loc) (h : Arr s z) : Id (F s) (act s z h (extend z Q u v vn))
      (extend s (PB.pre s.1 z.1 h.1 Q) (act s z h u) (rv z Q v s h) (rvn z Q v vn s h)) ;
  } ;
  ext-cong (k : Algebra) (z : Loc) (Q : PB.Phi z.1) (u u' : F z) (p : Id (F z) u u')
    (v v' : Partial z Q) (q : Id (Partial z Q) v v') (vn : Natural z Q v) (vn' : Natural z Q v')
    : Id (F z) (k.extend z Q u v vn) (k.extend z Q u' v' vn') =
    transH (apH (\ b -> k.extend z Q b v vn) p)
      (apH (\ d -> k.extend z Q u' d.1 d.2)
        (Sigma-eq (Partial z Q) (\ f -> Natural z Q f) v v' vn vn' q (natural-prop z Q v'))) ;
  opaque ext-cong ;
} ;
