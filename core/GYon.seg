-- GYon.seg (inside IvBase, any base; generic home of Yon.seg): the
-- representable presheaves y X and the maps y f, and y as a functor
-- (y id = id, y (f g) = y f y g, as substitutions: sub-ext).

level lv ;
constraint a <= lv ;
open Base ;
open Prelude[lv+] ;
open Paths[lv+] ;
module GPR = GPre[lv] ;

-- the base's Hom codes at level lv
homY (I X : Ob) : V[lv].V = V[lv].mkV (Hom I X) (Encode[a, lv].encIx0 (homV I X)).1 (Encode[a, lv].encIx0 (homV I X)).2 ;

open GPR.PS ;

yP (X : Ob) : PCtx = new PCtx[\ I -> homY I X, \ J I f g -> compH J I X g f, \ I g -> comp-idr I X g,
  \ K J I f g x -> symH (comp-assoc K J I X x f g)] ;

yH (Y X : Ob) (f : Hom Y X) : PSub[yP Y, yP X] =
  new PSub[yP Y, yP X, \ I g -> compH I Y X f g, \ J I h g -> symH (comp-assoc J I Y X f g h)] ;

-- y sends the identity to the identity substitution ...
yH-idH (X : Ob) : Id (PSub[yP X, yP X]) (yH X X (idH X)) (idS (yP X)) =
  sub-ext (yP X) (yP X) (yH X X (idH X)) (idS (yP X)) (\ I g -> comp-idl I X g) ;

-- ... and a composite to the composite substitution
yH-compH (Z Y X : Ob) (f : Hom Y X) (g : Hom Z Y)
  : Id (PSub[yP Z, yP X]) (yH Z X (compH Z Y X f g)) (oS (yP Z) (yP Y) (yP X) (yH Y X f) (yH Z Y g)) =
  sub-ext (yP Z) (yP X) (yH Z X (compH Z Y X f g)) (oS (yP Z) (yP Y) (yP X) (yH Y X f) (yH Z Y g))
    (\ I x -> comp-assoc I Z Y X f g x) ;

-- the Yoneda map of a point x of D at stage Z: f |-> x f
yPt (D : PCtx) (Z : Ob) (x : V[lv].Ix (D.ob Z)) : PSub[yP Z, D] =
  new PSub[yP Z, D, \ W f -> D.act W Z f x, \ J I f g -> D.act-o J I Z g f x] ;
