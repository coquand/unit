-- Context comprehension and terms of code maps.
El (G : PCtx) (A : Ty G) : U l = PEl[G, decode G A] ;

ext (G : PCtx) (A : Ty G) : PCtx = extP G (decode G A) ;
p (G : PCtx) (A : Ty G) : PSub[ext G A, G] = pP G (decode G A) ;
sec (G : PCtx) (A : Ty G) (a : El G A) : PSub[G, ext G A] = secP G (decode G A) a ;

module Substitution (D G : PCtx) (A : Ty G) (s : PSub[D, G]) {
  A0 : PTy[G] = decode G A ;
  As : Ty D = subT D G A s ;
  D0 : PTy[D] = decode D As ;
  Ds : PTy[D] = subTy D G A0 s ;

  read-term (u : PEl[D, Ds]) : El D As =
    new PEl[D, D0, u.eob, \ J I f x y e ->
      transH (symH (action-sub D G A s J I f x y e (u.eob I x))) (u.enat J I f x y e)] ;

  lift-nat (J I : Ob) (f : Hom J I) (w : W.Ix ((ext D As).ob I))
    : Id (W.Ix ((ext G A).ob J)) (s.nt J (D.act J I f w.1), ((ext D As).act J I f w).2)
        ((ext G A).act J I f (s.nt I w.1, w.2)) =
    transH (S.pairE-snd G A0 J (s.nt J (D.act J I f w.1)) ((ext D As).act J I f w).2
      (Ds.tact J I f w.1 (D.act J I f w.1) (refl (D.act J I f w.1)) w.2)
      (symH (action-sub D G A s J I f w.1 (D.act J I f w.1) (refl (D.act J I f w.1)) w.2)))
      (liftP-nat D G A0 s J I f w.1 w.2) ;

  lift : PSub[ext D As, ext G A] =
    new PSub[ext D As, ext G A, \ I w -> (s.nt I w.1, w.2), lift-nat] ;
} ;

subt (D G : PCtx) (A : Ty G) (a : El G A) (s : PSub[D, G]) : El D (subT D G A s) =
  Substitution[D, G, A, s].read-term (subEl D G (decode G A) a s) ;

q (G : PCtx) (A : Ty G) : El (ext G A) (subT (ext G A) G A (p G A)) =
  Substitution[ext G A, G, A, p G A].read-term (qP G (decode G A)) ;

lift (D G : PCtx) (A : Ty G) (s : PSub[D, G]) : PSub[ext D (subT D G A s), ext G A] =
  Substitution[D, G, A, s].lift ;

term-subst (G : PCtx) (A B : Ty G) (p0 : Id (Ty G) A B) (u : El G A) (v : El G B)
  (same : Id (TOb G) (decode G A).tob (decode G B).tob)
  (h : (I : Ob) (x : W.Ix (G.ob I)) -> Id (W.Ix ((decode G B).tob I x))
     (subst (TOb G) (\ o -> elObs G o) (decode G A).tob (decode G B).tob same u.eob I x) (v.eob I x))
  : Id (El G B) (subst (Ty G) (\ T -> El G T) A B p0 u) v =
  transH (subst-ap (Ty G) (PTy[G]) (decode G) (\ T -> PEl[G, T]) A B p0 u)
    (el-subst G (decode G A) (decode G B) (apH (decode G) p0) same u v h) ;

map-subst (G K : PCtx) (A B : Ty G) (p0 : Id (Ty G) A B) (u : PSub[ext G A, K]) (v : PSub[ext G B, K])
  (same : Id (TOb G) (decode G A).tob (decode G B).tob)
  (h : (I : Ob) (w : W.Ix ((ext G B).ob I)) -> Id (W.Ix (K.ob I))
    (subst (TOb G) (\ o -> subObs G K o) (decode G A).tob (decode G B).tob same u.nt I w) (v.nt I w))
  : Id (PSub[ext G B, K]) (subst (Ty G) (\ T -> PSub[ext G T, K]) A B p0 u) v =
  transH (subst-ap (Ty G) (PTy[G]) (decode G) (\ T -> PSub[extP G T, K]) A B p0 u)
    (sub-subst G K (decode G A) (decode G B) (apH (decode G) p0) same u v h) ;

opaque term-subst ; opaque map-subst ;
