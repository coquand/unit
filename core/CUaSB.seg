-- CUaSB.seg (L6, inside CB): the sides of step (b) (model.tex Thm ua,
-- sides).  For a full datum x, the full datum built from SA along the
-- Yoneda maps of x is x: CGlueUniq.GU2 with x's cart into SA = its point
-- cart (CExtEq1.Pt), then Ext = B at full points (CExtFullCart), then
-- the inverse of the comparison (Inv).  Its equivalence is eqSA's by
-- lem:full-move (i) and (ii); its codes by (C2).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module P2 = Paths[a++] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UaSB (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  -- the classifier of the small copy along maps into GD, and (C1)
  (smallCl : (D : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr])
     -> Cl D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l))
  (smallCl-sub : (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D])
     -> Id ((A : PTy[D']) * Cl D' A)
           (subTy D' D (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) t,
            clSub D' D t (CSmall.xsub D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA l) (smallCl D l))
           (CSmall.xsub D' CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t),
            smallCl D' (CSmall.xoS D' D CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr l t)))
  -- (C2): at a full point, the code of SA along the Yoneda map is B's
  (smallCl-full : (W : Ob) (y : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 W) (q : IsT (CGlueD.fl W y.1.2.1 W (idH W)))
     -> Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W)
           (CSmall.xsub (yP W) CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib].SA
              (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y),
            smallCl (yP W) (CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].yhat W y))
           (y.1.2.2.1 W (idH W) q))
  (X : Ob) (x : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 X) (full : IsT (allS X x.1.2.1)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E2 = CExtEq2.EQ2[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module XS = CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  module FU = XS.FU ;
  module E4 = XS.E4 ;
  RES : L.PCtx = UB.CU.resCtx ;
  GDr : L.PCtx = UB.GDr ;
  module TAU = XS.TAU ;
  module TX = XS.TX ;
  module TS = XS.TS ;

  module B = CUaB.UaB[Cl, clSub, clSub-id, clSub-o, encCl, elFib, smallCl, smallCl-sub, X, x, x.1.2.1, full] ;
  module PD = E1.Pt[X, x] ;
  module FCm = CExtFullCart[a+].FC[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU, FU.T7.fA1, E2.eqU] ;

  ----------------------------------------------------------------------
  -- Inv: Ext_U back to SA (the inverse of the comparison)

  invB (W : Ob) (v : TX.EI W) : TS.EI W = (v.1, XS.bk W v.1 v.2) ;

  invBnat (V W : Ob) (g : Hom V W) (v : TX.EI W) : Id (TS.EI V) (TS.E.act V W g (invB W v)) (invB V (TX.E.act V W g v)) =
    XS.tainj V (TS.E.act V W g (invB W v)) (invB V (TX.E.act V W g v)) (refl (GDr.act V W g v.1))
      (transH (symH (XS.tanat V W g (invB W v)))
        (transH (apH (TX.E.act V W g) (XS.bkta W v.1 v.2)) (symH (XS.bkta V (TX.E.act V W g v).1 (TX.E.act V W g v).2)))) ;

  invBinj (W : Ob) (v v' : TX.EI W) (P : Id (V1.Ix (GDr.ob W)) v.1 v'.1) (Q : Id (TS.EI W) (invB W v) (invB W v')) : Id (TX.EI W) v v' =
    transH (symH (XS.bkta W v.1 v.2)) (transH (apH (XS.ta W) Q) (XS.bkta W v'.1 v'.2)) ;

  invbk (Y : Ob) (y : V1.Ix (GDr.ob Y)) (u : W0.Ix (XS.S0 Y y)) : V1.Ix (UB.ExtBig.tob Y y) = XS.phS Y y u ;

  invBta (Y : Ob) (y : V1.Ix (GDr.ob Y)) (u : W0.Ix (XS.S0 Y y)) : Id (TS.EI Y) (invB Y (y, invbk Y y u)) (y, u) =
    apH {W0.Ix (XS.S0 Y y)} {TS.EI Y} (\ z -> (y, z)) (XS.CM.At[Y, y].ps-ph u) ;

  invComm (W : Ob) (v : TX.EI W) : Id (TAU.EI W) (E4.extMap.mE W v) (XS.extSA.mE W (invB W v)) =
    apH (E4.extMap.mE W) (symH (XS.bkta W v.1 v.2)) ;

  opaque invBnat ; opaque invBinj ; opaque invBta ; opaque invComm ;

  module HInv = CHFibCart[a+, a+].HCart[GDr, UB.ExtBig, UB.AU, E4.extMap, GDr, XS.upSA, UB.AU, XS.extSA, \ W y -> y, \ V W g y -> refl (GDr.act V W g y), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (XS.TAU.E.act V W g v), \ W v v' P Q -> Q, \ Y y u -> u, \ Y y u -> refl (y, u), invB, \ W v -> refl v.1, invBnat, invBinj, invbk, invBta, invComm] ;

  -- Inv after the comparison is the identity
  module HC0 = CHFibLaws[a+, a+, a+].HComp[GDr, UB.ExtBig, UB.AU, E4.extMap, GDr, XS.upSA, UB.AU, XS.extSA, GDr, UB.ExtBig, UB.AU, E4.extMap, \ W y -> y, \ V W g y -> refl (GDr.act V W g y), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (XS.TAU.E.act V W g v), \ W v v' P Q -> Q, \ Y y u -> u, \ Y y u -> refl (y, u), invB, \ W v -> refl v.1, invBnat, invBinj, invbk, invBta, invComm, \ W x -> x, \ V W g x -> refl (UB.GDr.act V W g x), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (TAU.E.act V W g v), \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), XS.ta, \ W v -> refl v.1, XS.tanat, XS.tainj, XS.bk, XS.bkta, \ W v -> refl (E4.extMap.mE W (XS.ta W v)), FU.extEquivU] ;

  invLaw : Id (CEquiv[a+].EquivOp GDr UB.ExtBig UB.AU E4.extMap) (HInv.moveEq XS.eqSA) FU.extEquivU =
    P2.transH HC0.comp
      (P2.transH (CHFibLaws[a+, a+, a+].HCong[GDr, UB.ExtBig, UB.AU, E4.extMap, GDr, UB.ExtBig, UB.AU, E4.extMap, HC0.s, HC0.s-nat, HC0.tA, HC0.tApt, HC0.tAnat, HC0.tAinj, HC0.bkA, HC0.bkAta, HC0.tB, HC0.tBpt, HC0.tBnat, HC0.tBinj, HC0.bkB, HC0.bkBta, HC0.comm, \ W d -> d, \ V W g d -> refl (GDr.act V W g d), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (LP.TyL[GDr, UB.AU].E.act V W g v), \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (LP.TyL[GDr, UB.ExtBig].E.act V W g v), \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u), \ W v -> refl (E4.extMap.mE W v),
                 \ W v -> refl v, \ W v -> XS.bkta W v.1 v.2, FU.extEquivU].cong)
              (CHFibLaws[a+, a+, a+].HId[GDr, UB.ExtBig, UB.AU, E4.extMap, FU.extEquivU].idm)) ;

  ----------------------------------------------------------------------
  -- x's cart into SA: its point cart, then Ext = B at full points, then Inv

  module HCa = CHFibLaws[a, a+, a+].HComp[PD.RC.RC, PD.T0.Bt, PD.T0.At, PD.T0.al, RES, UB.BU, UB.AU', UB.alU, GDr, UB.ExtBig, UB.AU, E4.extMap, PD.s, PD.s-nat, PD.tA, \ W v -> refl (PD.s W v.1), PD.tAnat, PD.tAinj, PD.bkA, PD.bkAta, PD.tB, \ W v -> refl (PD.s W v.1), PD.tBnat, PD.tBinj, PD.bkB, PD.bkBta, PD.comm, FCm.cs, FCm.cs-nat, FCm.ctA, FCm.ctApt, FCm.ctAnat, FCm.ctAinj, FCm.cbkA, FCm.cbkAta, FCm.ctB, FCm.ctBpt, FCm.ctBnat, FCm.ctBinj, FCm.bkB, FCm.cbkBta, FCm.ccomm, HInv.moveEq XS.eqSA] ;
  module HCb = CHFibLaws[a, a+, a+].HComp[PD.RC.RC, PD.T0.Bt, PD.T0.At, PD.T0.al, GDr, UB.ExtBig, UB.AU, E4.extMap, GDr, XS.upSA, UB.AU, XS.extSA, HCa.s, HCa.s-nat, HCa.tA, HCa.tApt, HCa.tAnat, HCa.tAinj, HCa.bkA, HCa.bkAta, HCa.tB, HCa.tBpt, HCa.tBnat, HCa.tBinj, HCa.bkB, HCa.bkBta, HCa.comm, \ W y -> y, \ V W g y -> refl (GDr.act V W g y), \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (XS.TAU.E.act V W g v), \ W v v' P Q -> Q, \ Y y u -> u, \ Y y u -> refl (y, u), invB, \ W v -> refl v.1, invBnat, invBinj, invbk, invBta, invComm, XS.eqSA] ;

  Hx : Id (GE.EqOn X x.1) x.2 (CHFibCart[a+, a].HCart[PD.RC.RC, PD.T0.Bt, PD.T0.At, PD.T0.al, GDr, XS.upSA, UB.AU, XS.extSA, HCb.s, HCb.s-nat, HCb.tA, HCb.tApt, HCb.tAnat, HCb.tAinj, HCb.bkA, HCb.bkAta, HCb.tB, HCb.tBpt, HCb.tBnat, HCb.tBinj, HCb.bkB, HCb.bkBta, HCb.comm].moveEq XS.eqSA) =
    P2.transH (CUaFull1.FI[Cl, clSub, clSub-id, clSub-o, encCl, X, x].law)
     (P2.transH (P2.apH PD.H.moveEq FCm.law)
      (P2.transH (P2.apH (\ e -> PD.H.moveEq (FCm.H.moveEq e)) (P2.symH invLaw))
       (P2.transH HCa.comp HCb.comp))) ;

  ----------------------------------------------------------------------
  -- the codes, by (C2)

  qI (W : Ob) (f : Hom W X) : IsT (CGlueD.fl W (B.dg W f).1.2.1 W (idH W)) =
    UA.fullAct W W (idH W) (pre W X f x.1.2.1) (UA.fullAct W X f x.1.2.1 full) ;

  PB (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X x.1.2.1 W f)) (q' : IsT (CGlueD.fl X x.1.2.1 W f))
    : Id (UU.U0 W) (x.1.2.2.1 W f q) (B.B W f q') =
    transH (apH {W0.Ix (PD.RC.RC.ob W)} {UU.U0 W} (\ r -> x.1.2.2.1 W r.1 r.2)
              (PD.RC.pt-eq W (f, q) (compH W W X f (idH W), CGlueD.fl-pre W X f x.1.2.1 W (idH W) (qI W f))
                 (symH (comp-idr W X f))))
           (symH (smallCl-full W (B.dg W f) (qI W f))) ;

  ----------------------------------------------------------------------
  -- the carts agree

  Pp (W : Ob) (r : W0.Ix (B.R.RC.ob W)) (k : Hom W X) (Er : Id (Hom W X) k r.1)
    : Id (V1.Ix (GDr.ob W)) (GDr.act W X k x) (B.io W r) =
    transH (apH (\ k2 -> GDr.act W X k2 x) Er) (symH (GDr.act-id W (B.dg W r.1))) ;

  PtAp (W : Ob) (r : W0.Ix (B.R.RC.ob W)) (r' : W0.Ix (PD.RC.RC.ob W)) (Er : Id (Hom W X) r'.1 r.1)
    (z : W0.Ix (x.1.1.1.tob W r.1)) (cz : Id W0.V (x.1.1.1.tob W r.1) (x.1.1.1.tob W r'.1))
    : Id (TAU.EI W) (HCb.tA W (r', CExtEq1.sV (x.1.1.1.tob W r.1) (x.1.1.1.tob W r'.1) cz z)) (B.tA W (r, z)) =
    B.pair-eqV1 (V1.Ix (GDr.ob W)) (B.codeA W) (GDr.act W X r'.1 x) (B.io W r) (Pp W r r'.1 Er)
      (HCb.tA W (r', CExtEq1.sV (x.1.1.1.tob W r.1) (x.1.1.1.tob W r'.1) cz z)).2 (B.tA W (r, z)).2 (apH (B.codeA W) (Pp W r r'.1 Er))
      (transH (apH (CExtEq1.sV (B.codeA W (GDr.act W X r'.1 x)) (B.codeA W (B.io W r)) (apH (B.codeA W) (Pp W r r'.1 Er)))
                 (transH (PD.trH-V W r'.1 (compH W W X r'.1 (idH W)) (symH (comp-idr W X r'.1)) (CExtEq1.sV (x.1.1.1.tob W r.1) (x.1.1.1.tob W r'.1) cz z))
                         (CExtEq1.sV-comp (x.1.1.1.tob W r.1) (x.1.1.1.tob W r'.1) (B.codeA W (GDr.act W X r'.1 x)) cz
                            (apH (PD.o W) (symH (comp-idr W X r'.1))) z)))
        (transH (CExtEq1.sV-two (x.1.1.1.tob W r.1) (B.codeA W (GDr.act W X r'.1 x)) (B.codeA W (B.io W r))
                   (transH cz (apH (PD.o W) (symH (comp-idr W X r'.1)))) (apH (B.codeA W) (Pp W r r'.1 Er))
                   (apH (B.o W) (B.Pk W r.1)) z)
                (symH (B.trH-V W r.1 (B.kk W r.1) (B.Pk W r.1) z)))) ;

  module E3u = CExt3[a+].ExtB3[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU] ;

  module NB (W : Ob) (r : W0.Ix (B.R.RC.ob W)) (r' : W0.Ix (PD.RC.RC.ob W)) (Er : Id (Hom W X) r'.1 r.1)
    (z : W0.Ix (UU.fib0 W (B.B W r.1 r.2))) (cz : Id W0.V (UU.fib0 W (B.B W r.1 r.2)) (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2))) {
    y : V1.Ix (GDr.ob W) = B.io W r ;
    module At = XS.CM.At[W, y] ;
    e2 : IsT (UB.CU.full W y) = UA.fullAct W W (idH W) (pre W X r.1 x.1.2.1) r.2 ;
    e : IsT (At.DT.CL.full W (idH W)) = At.fU2D e2 ;
    Z0 : W0.V = UU.fib0 W (B.B W r.1 r.2) ;
    b : W0.Ix (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2)) = CExtEq1.sV Z0 (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2)) cz z ;
    yr : V1.Ix (RES.ob W) = (y, e2) ;
    Pr : Id (V1.Ix (RES.ob W)) (PD.s W r') yr = UB.CU.res-eq W (PD.s W r') yr (Pp W r r'.1 Er) ;
    cP : Id W0.V (PD.codeB W (PD.s W r')) (PD.codeB W yr) = apH (PD.codeB W) Pr ;
    cb : Id W0.V (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2)) (PD.codeB W (PD.s W r')) = apH (UU.fib0 W) (PD.PB W r') ;
    ce : Id W0.V Z0 (UU.fib0 W (At.cD e)) = At.E3d.extOb-B W (idH W) e ;
    cp : Id W0.V (UU.fib0 W (At.cD e)) (PD.codeB W yr) = apH (UU.fib0 W) (At.PDU e e2) ;

    -- ph z read in B
    phB : Id (W0.Ix (PD.codeB W yr)) (E3u.toB W (y, At.ph z) e2).2 (CExtEq1.sV Z0 (PD.codeB W yr) (transH ce cp) z) =
      transH At.PF[e, e2, z].res
       (transH (UU.substF W (At.cD e) (UB.bmap.nt W yr) (At.PDU e e2) (At.E3d.toB W (idH W, z) e).2)
        (transH (apH (CExtEq1.sV (UU.fib0 W (At.cD e)) (PD.codeB W yr) cp) (symH (At.E3d.extOb-B-sub W (idH W) e z)))
                (CExtEq1.sV-comp Z0 (UU.fib0 W (At.cD e)) (PD.codeB W yr) ce cp z))) ;

    M1 : Id (UB.TBU.EI W) (PD.tB W (r', b)) (E3u.toB W (y, At.ph z) e2) =
      PD.pair-eqV1 (V1.Ix (RES.ob W)) (PD.codeB W) (PD.s W r') yr Pr (PD.tB W (r', b)).2 (E3u.toB W (y, At.ph z) e2).2 cP
        (transH (apH (CExtEq1.sV (PD.codeB W (PD.s W r')) (PD.codeB W yr) cP)
                   (transH (UU.substF W (PD.bd.1 W r'.1 r'.2) (PD.bd.1 W (compH W W X r'.1 (idH W)) (PD.q2 W r')) (PD.PB W r') b)
                           (CExtEq1.sV-comp Z0 (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2)) (PD.codeB W (PD.s W r')) cz cb z)))
          (transH (CExtEq1.sV-two Z0 (PD.codeB W (PD.s W r')) (PD.codeB W yr) (transH cz cb) cP (transH ce cp) z) (symH phB))) ;

    M : Id (TX.EI W) (E3u.fromB W (PD.tB W (r', b))) (XS.ta W (y, z)) =
      transH (apH (E3u.fromB W) M1) (E3u.fromB-toB W (y, At.ph z) e2) ;

    res : Id (TS.EI W) (HCb.tB W (r', b)) (B.tB W (r, z)) =
      XS.tainj W (HCb.tB W (r', b)) (B.tB W (r, z)) (Pp W r r'.1 Er)
        (transH (XS.bkta W (E3u.fromB W (PD.tB W (r', b))).1 (E3u.fromB W (PD.tB W (r', b))).2) M) ;
  } ;

  PtBp (W : Ob) (r : W0.Ix (B.R.RC.ob W)) (r' : W0.Ix (PD.RC.RC.ob W)) (Er : Id (Hom W X) r'.1 r.1)
    (z : W0.Ix (UU.fib0 W (B.B W r.1 r.2))) (cz : Id W0.V (UU.fib0 W (B.B W r.1 r.2)) (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2)))
    : Id (TS.EI W) (HCb.tB W (r', CExtEq1.sV (UU.fib0 W (B.B W r.1 r.2)) (UU.fib0 W (x.1.2.2.1 W r'.1 r'.2)) cz z)) (B.tB W (r, z)) =
    NB[W, r, r', Er, z, cz].res ;

  opaque PB ; opaque PtAp ; opaque PtBp ;

  module G2 = CGlueUniq.GU2[Cl, clSub, clSub-id, clSub-o, encCl, X, x.1.1, x.1.2.1, B.B, B.bn, GDr, XS.upSA, UB.AU, XS.extSA, XS.eqSA,
    B.io, B.io-nat, B.tA, \ W v -> refl (B.io W v.1), B.tAnat, B.tAinj, B.bkA, B.bkAta, B.tB, \ W v -> refl (B.io W v.1), B.tBnat, B.tBinj, \ Y x z -> z, \ Y x z -> refl (B.io Y x, z),
    x, refl x.1.1, refl x.1.2.1, PB,
    HCb.s, HCb.s-nat, HCb.tA, HCb.tApt, HCb.tAnat, HCb.tAinj, HCb.bkA, HCb.bkAta, HCb.tB, HCb.tBpt, HCb.tBnat, HCb.tBinj, HCb.bkB, HCb.bkBta, HCb.comm,
    Hx, PtAp, PtBp] ;

  -- (b) at a full datum: the full datum built from SA is the datum itself
  law : Id (GE.GD1 X) x B.GC.dat = G2.law ;
} ;
