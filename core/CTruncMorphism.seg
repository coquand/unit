-- Identity, composition, and the recursor preserve seeded extensions.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module Rec (G : PCtx) (A B : PTy[G])
  (k : CTruncAlg[a,l].Algebras[G,B].Algebra) (f : HO.NMap[G,A,B]) {
  module T = CTrunc[a,l].Truncation[G,A] ;
  module R = T.Recursor[B,k,f] ;
  module M = CTruncHom[a,l].Maps[G,T.Ty,B,R.map] ;
  module K = CTruncAlg[a,l].Algebras[G,B] ;
  preserves : M.Preserves T.algebra k = \ z Q u v vn ->
    transH R.Beta.Ext[z,Q,u,v,vn].rec-ext
      (K.ext-cong k z Q _ _ (refl (R.R.rec z u)) _ _ (refl (M.partial z Q v))
        R.Beta.Ext[z,Q,u,v,vn].bvn (M.natural z Q v vn)) ;
  opaque preserves ;
} ;

module Identity (G : PCtx) (B : PTy[G]) (k : CTruncAlg[a,l].Algebras[G,B].Algebra) {
  map : HO.NMap[G,B,B] = new HO.NMap[G,B,B,\ X x b -> b,\ Y X h x y e b -> refl (B.tact Y X h x y e b)] ;
  module M = CTruncHom[a,l].Maps[G,B,B,map] ;
  module K = CTruncAlg[a,l].Algebras[G,B] ;
  preserves : M.Preserves k k = \ z Q u v vn ->
    K.ext-cong k z Q u u (refl u) v v (refl v) vn (M.natural z Q v vn) ;
  opaque preserves ;
} ;

module Compose (G : PCtx) (B C D : PTy[G])
  (b : CTruncAlg[a,l].Algebras[G,B].Algebra)
  (c : CTruncAlg[a,l].Algebras[G,C].Algebra)
  (d : CTruncAlg[a,l].Algebras[G,D].Algebra)
  (f : HO.NMap[G,B,C]) (g : HO.NMap[G,C,D])
  (fp : CTruncHom[a,l].Maps[G,B,C,f].Preserves b c)
  (gp : CTruncHom[a,l].Maps[G,C,D,g].Preserves c d) {
  map : HO.NMap[G,B,D] = new HO.NMap[G,B,D,\ X x u -> g.nfun X x (f.nfun X x u),
    \ Y X h x y e u -> transH (g.nnat Y X h x y e (f.nfun X x u))
      (apH (g.nfun Y y) (f.nnat Y X h x y e u))] ;
  module F = CTruncHom[a,l].Maps[G,B,C,f] ;
  module H = CTruncHom[a,l].Maps[G,C,D,g] ;
  module M = CTruncHom[a,l].Maps[G,B,D,map] ;
  module K = CTruncAlg[a,l].Algebras[G,D] ;
  preserves : M.Preserves b d = \ z Q u v vn ->
    transH (apH (H.at z) (fp z Q u v vn))
      (transH (gp z Q (F.at z u) (F.partial z Q v) (F.natural z Q v vn))
        (K.ext-cong d z Q _ _ (refl (M.at z u)) _ _ (refl (M.partial z Q v))
          (H.natural z Q (F.partial z Q v) (F.natural z Q v vn)) (M.natural z Q v vn))) ;
  opaque preserves ;
} ;
