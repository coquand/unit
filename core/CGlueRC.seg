-- CGlueRC.seg (L2, inside CB, levels k l n): relative contractibility
-- structures glue.  A structure on m : S -> T over D (level k) is given
-- by local structures: for each point x of D at Z, a context C x (level
-- l) with a map iota x into D and a point o x of C x over x, and a
-- structure Lk x on m restricted along iota x; coherent: along any g into
-- Z, the extension of Lk x at a point c over x g agrees, in T, with the
-- extension of Lk (x g) at o (x g) on the same side.  The glued extension
-- at (x , s) is Lk x's at o x, read in T.
--
-- (Voevodsky: a structure on a presheaf is determined by its restrictions
-- along a covering family.)  Used for the universal equivalence e_U from
-- the points' own equivalences (CExtEq).

level k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
module P0 = GPre[k] ;
module P1 = GPre[l] ;

module Glue (D : P0.PS.PCtx) (S T : P0.PS.PTy[D]) (m : CPartial[k].PMap[D, S, T])
  -- the local contexts, maps and points
  (C : (Z : Ob) -> W0.Ix (D.ob Z) -> P1.PS.PCtx)
  (io : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) -> W1.Ix ((C Z x).ob W) -> W0.Ix (D.ob W))
  (io-nat : (Z : Ob) (x : W0.Ix (D.ob Z)) (V W : Ob) (g : Hom V W) (c : W1.Ix ((C Z x).ob W))
     -> Id (W0.Ix (D.ob V)) (io Z x V ((C Z x).act V W g c)) (D.act V W g (io Z x W c)))
  (o : (Z : Ob) (x : W0.Ix (D.ob Z)) -> W1.Ix ((C Z x).ob Z))
  (oio : (Z : Ob) (x : W0.Ix (D.ob Z)) -> Id (W0.Ix (D.ob Z)) (io Z x Z (o Z x)) x)
  -- the local structures: on the restriction along io, read through maps
  -- of totals over io (the fibres of S and T at io c)
  (Sl Tl : (Z : Ob) (x : W0.Ix (D.ob Z)) -> P1.PS.PTy[C Z x])
  (ml : (Z : Ob) (x : W0.Ix (D.ob Z)) -> CPartial[l].PMap[C Z x, Sl Z x, Tl Z x])
  (sS : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) -> P1.TyL[C Z x, Sl Z x].EI W -> P0.TyL[D, S].EI W)
  (sSpt : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) (v : P1.TyL[C Z x, Sl Z x].EI W) -> Id (W0.Ix (D.ob W)) (sS Z x W v).1 (io Z x W v.1))
  (sSnat : (Z : Ob) (x : W0.Ix (D.ob Z)) (V W : Ob) (g : Hom V W) (v : P1.TyL[C Z x, Sl Z x].EI W)
     -> Id (P0.TyL[D, S].EI V) (P0.TyL[D, S].E.act V W g (sS Z x W v)) (sS Z x V (P1.TyL[C Z x, Sl Z x].E.act V W g v)))
  (sSinj : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) (v v' : P1.TyL[C Z x, Sl Z x].EI W) (P : Id (W1.Ix ((C Z x).ob W)) v.1 v'.1)
     (Q : Id (P0.TyL[D, S].EI W) (sS Z x W v) (sS Z x W v')) -> Id (P1.TyL[C Z x, Sl Z x].EI W) v v')
  (lS : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) (c : W1.Ix ((C Z x).ob W)) (u : W0.Ix (S.tob W (io Z x W c))) -> W1.Ix ((Sl Z x).tob W c))
  (lSs : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) (c : W1.Ix ((C Z x).ob W)) (u : W0.Ix (S.tob W (io Z x W c)))
     -> Id (P0.TyL[D, S].EI W) (sS Z x W (c, lS Z x W c u)) (io Z x W c, u))
  (sT : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) -> P1.TyL[C Z x, Tl Z x].EI W -> P0.TyL[D, T].EI W)
  (sTpt : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) (v : P1.TyL[C Z x, Tl Z x].EI W) -> Id (W0.Ix (D.ob W)) (sT Z x W v).1 (io Z x W v.1))
  (sTnat : (Z : Ob) (x : W0.Ix (D.ob Z)) (V W : Ob) (g : Hom V W) (v : P1.TyL[C Z x, Tl Z x].EI W)
     -> Id (P0.TyL[D, T].EI V) (P0.TyL[D, T].E.act V W g (sT Z x W v)) (sT Z x V (P1.TyL[C Z x, Tl Z x].E.act V W g v)))
  (sq : (Z : Ob) (x : W0.Ix (D.ob Z)) (W : Ob) (v : P1.TyL[C Z x, Sl Z x].EI W)
     -> Id (P0.TyL[D, T].EI W) (sT Z x W ((ml Z x).mE W v)) (m.mE W (sS Z x W v)))
  (Lk : (Z : Ob) (x : W0.Ix (D.ob Z)) -> CPartial[l].Rel[C Z x, Sl Z x, Tl Z x, ml Z x].RC)
  -- coherence, read in T
  (Coh : (Z : Ob) (x : W0.Ix (D.ob Z)) (Y : Ob) (g : Hom Y Z)
     (sg : CPartial[l].Partials[C Z x, Sl Z x].Side[Y, (C Z x).act Y Z g (o Z x)])
     (sg' : CPartial[l].Partials[C Y (D.act Y Z g x), Sl Y (D.act Y Z g x)].Side[Y, o Y (D.act Y Z g x)])
     (HQ : Id (Phi Y) sg.pQ sg'.pQ)
     (Hv : (V : Ob) (f : Hom V Y) (i : Lands V Y sg.pQ f) (i' : Lands V Y sg'.pQ f)
           -> Id (P0.TyL[D, S].EI V) (sS Z x V (sg.pv V f i)) (sS Y (D.act Y Z g x) V (sg'.pv V f i')))
     -> Id (P0.TyL[D, T].EI Y) (sT Z x Y ((C Z x).act Y Z g (o Z x), (Lk Z x).kop Y ((C Z x).act Y Z g (o Z x)) sg))
                              (sT Y (D.act Y Z g x) Y (o Y (D.act Y Z g x), (Lk Y (D.act Y Z g x)).kop Y (o Y (D.act Y Z g x)) sg'))) {
  module TS = P0.TyL[D, S] ;
  module TT = P0.TyL[D, T] ;
  module PD = CPartial[k].Partials[D, S] ;
  module R = CPartial[k].Rel[D, S, T, m] ;

  ----------------------------------------------------------------------
  -- a side at y, read locally at a point c over y

  module Loc (Z : Ob) (x : W0.Ix (D.ob Z)) (Y : Ob) (y : W0.Ix (D.ob Y)) (c : W1.Ix ((C Z x).ob Y))
    (cP : Id (W0.Ix (D.ob Y)) (io Z x Y c) y) (s : PD.Side[Y, y]) {
    module PL = CPartial[l].Partials[C Z x, Sl Z x] ;
    module TL = P1.TyL[C Z x, Sl Z x] ;

    ptV (V : Ob) (f : Hom V Y) (i : Lands V Y s.pQ f) : Id (W0.Ix (D.ob V)) (s.pv V f i).1 (io Z x V ((C Z x).act V Y f c)) =
      transH (s.ppt V f i) (transH (apH (D.act V Y f) (symH cP)) (symH (io-nat Z x V Y f c))) ;

    pv (V : Ob) (f : Hom V Y) (i : Lands V Y s.pQ f) : TL.EI V =
      ((C Z x).act V Y f c, lS Z x V ((C Z x).act V Y f c) (TS.fromE V (io Z x V ((C Z x).act V Y f c)) (s.pv V f i) (ptV V f i))) ;

    pv-S (V : Ob) (f : Hom V Y) (i : Lands V Y s.pQ f) : Id (TS.EI V) (sS Z x V (pv V f i)) (s.pv V f i) =
      transH (lSs Z x V ((C Z x).act V Y f c) (TS.fromE V (io Z x V ((C Z x).act V Y f c)) (s.pv V f i) (ptV V f i)))
             (TS.fromE-eq V (io Z x V ((C Z x).act V Y f c)) (s.pv V f i) (ptV V f i)) ;

    pnat (V' V : Ob) (chi : Hom V' V) (f : Hom V Y) (i : Lands V Y s.pQ f) (i' : Lands V' Y s.pQ (compH V' V Y f chi))
      : Id (TL.EI V') (TL.E.act V' V chi (pv V f i)) (pv V' (compH V' V Y f chi) i') =
      sSinj Z x V' (TL.E.act V' V chi (pv V f i)) (pv V' (compH V' V Y f chi) i')
        (symH ((C Z x).act-o V' V Y f chi c))
        (transH (symH (sSnat Z x V' V chi (pv V f i)))
          (transH (apH (TS.E.act V' V chi) (pv-S V f i))
            (transH (s.pnat V' V chi f i i') (symH (pv-S V' (compH V' V Y f chi) i'))))) ;

    opaque pv-S ; opaque pnat ;

    side : PL.Side[Y, c] = new PL.Side[Y, c, s.pQ, pv, \ V f i -> refl ((C Z x).act V Y f c), pnat] ;
  } ;

  ----------------------------------------------------------------------
  -- the glued structure

  sL (Z : Ob) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x]) : CPartial[l].Partials[C Z x, Sl Z x].Side[Z, o Z x] =
    Loc[Z, x, Z, x, o Z x, oio Z x, s].side ;

  lv (Z : Ob) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x]) : TT.EI Z =
    sT Z x Z (o Z x, (Lk Z x).kop Z (o Z x) (sL Z x s)) ;

  lv-pt (Z : Ob) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x]) : Id (W0.Ix (D.ob Z)) (lv Z x s).1 x =
    transH (sTpt Z x Z (o Z x, (Lk Z x).kop Z (o Z x) (sL Z x s))) (oio Z x) ;

  kop (Z : Ob) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x]) : W0.Ix (T.tob Z x) = TT.fromE Z x (lv Z x s) (lv-pt Z x s) ;

  kop-E (Z : Ob) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x]) : Id (TT.EI Z) (x, kop Z x s) (lv Z x s) =
    TT.fromE-eq Z x (lv Z x s) (lv-pt Z x s) ;

  kside (Z : Ob) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x]) (W : Ob) (f : Hom W Z) (i : Lands W Z s.pQ f)
    : Id (TT.EI W) (TT.E.act W Z f (x, kop Z x s)) (m.mE W (s.pv W f i)) =
    transH (apH (TT.E.act W Z f) (kop-E Z x s))
     (transH (sTnat Z x W Z f (o Z x, (Lk Z x).kop Z (o Z x) (sL Z x s)))
      (transH (apH (sT Z x W) ((Lk Z x).kside Z (o Z x) (sL Z x s) W f i))
       (transH (sq Z x W ((sL Z x s).pv W f i))
               (apH (m.mE W) (Loc[Z, x, Z, x, o Z x, oio Z x, s].pv-S W f i))))) ;

  kunif (Y Z : Ob) (h : Hom Y Z) (x : W0.Ix (D.ob Z)) (s : PD.Side[Z, x])
    : Id (TT.EI Y) (TT.E.act Y Z h (x, kop Z x s)) (D.act Y Z h x, kop Y (D.act Y Z h x) (PD.rside Y Z h x s)) =
    transH (apH (TT.E.act Y Z h) (kop-E Z x s))
     (transH (sTnat Z x Y Z h (o Z x, (Lk Z x).kop Z (o Z x) (sL Z x s)))
      (transH (apH (sT Z x Y) ((Lk Z x).kunif Y Z h (o Z x) (sL Z x s)))
       (transH (Coh Z x Y h
                  (CPartial[l].Partials[C Z x, Sl Z x].rside Y Z h (o Z x) (sL Z x s))
                  (sL Y (D.act Y Z h x) (PD.rside Y Z h x s))
                  (refl (pre Y Z h s.pQ))
                  (\ V f i i' -> transH (Loc[Z, x, Z, x, o Z x, oio Z x, s].pv-S V (compH V Y Z h f) (lands-pre V Y Z h s.pQ f i))
                     (transH (PD.pv-irr Z x s V (compH V Y Z h f) (lands-pre V Y Z h s.pQ f i) (lands-pre V Y Z h s.pQ f i'))
                             (symH (Loc[Y, D.act Y Z h x, Y, D.act Y Z h x, o Y (D.act Y Z h x), oio Y (D.act Y Z h x), PD.rside Y Z h x s].pv-S V f i')))))
               (symH (kop-E Y (D.act Y Z h x) (PD.rside Y Z h x s)))))) ;

  opaque kside ; opaque kunif ;

  rc : R.RC = new R.RC[kop, kside, kunif] ;
} ;
