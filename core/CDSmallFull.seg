-- CDSmallFull.seg (L8, Delta): (C2) for Delta (model.tex §8.2): at a point
-- y of GD full at the identity, the small Ext along yhat y with smallCl is
-- B's code.  Along the derived type equality (CSmallFull2.tyEq), as moves
-- of operations (COpTr, COpLaws):
--   transport, then the pull-back to Ext_U  =  along Kb then fromB   (P3)
--   along fromB the universal operation is hB      (CDOpFull, the case split)
--   hB is El's along bmap; Kb then Sub is the Yoneda cart   (P5)
--   El's operation along the Yoneda cart of Fb is Fb's     (CDOpYon)
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W1 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module PS = DB.GPre[a].PS ;
module DCl = CDeltaCl[a] ;
module CL = DCl.CL ;
module DU = DCl.DU ;
module YO = DB.GYon[a] ;

module SFD (elFib : DB.CLine[a+].Lines[DU.UCtx, DU.EGen].Fib)
  (W0 : Nat) (y : DB.CGlueE.GE[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl].GD1 W0)
  (q : IsT (DB.CGlueD.fl W0 y.1.2.1 W0 (idH (lin W0)))) {
  module SC = CDSmallCl[a].SC[elFib] ;
  module OFm = CDOpFull[a].OF[elFib] ;
  module B2 = DB.CSmallFull2.F2[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl, elFib, W0, y, q] ;
  module A = B2.A ;
  Fb1 : PS.PTy[YO.yP W0] = A.Fb.1 ;
  module OYm = CDOpYon[a].OY[W0, A.Fb] ;
  module TO = DB.COpTr[a].TO[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, YO.yP W0, A.T] ;
  module OL0 = DB.COpLaws[a, a, a+].OL[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS] ;
  module OL1 = DB.COpLaws[a, a+, a+].OL[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS] ;
  P : Id (PS.PTy[YO.yP W0]) A.T Fb1 = symH B2.tyEq ;
  c0 : CL.Cl (YO.yP W0) A.T = SC.smallCl (YO.yP W0) A.l ;

  -- Kb's fibre maps are inverse
  trU2 (V : Nat) (F F' : DU.U0 V) (p : Id (DU.U0 V) F F') (z : W1.Ix (DU.fib0 V F))
    : Id (W1.Ix (DU.fib0 V F)) (A.trU V F' F (symH p) (A.trU V F F' p z)) z =
    idJ (DU.U0 V) F (\ F2 p2 -> Id (W1.Ix (DU.fib0 V F)) (A.trU V F2 F (symH p2) (A.trU V F F2 p2 z)) z) (refl z) F' p ;

  cbfK (V : Nat) (g : Hom (lin V) (lin W0)) (b : W1.Ix (Fb1.tob V g)) : Id (W1.Ix (Fb1.tob V g)) (A.bkb V g (A.kb V g b)) b =
    transH (apH (A.Y.bk V g) (A.trU-round V (SC.UB.bmap.nt V (A.sb V g)) (DU.uAct V W0 g A.Fb) (A.cc V g) (A.Y.ta V (g, b)).2))
      (OYm.YG.sV-round (DU.fib0 V (A.Y.s V g)) (Fb1.tob V g) (A.Y.Po V g) b) ;

  cfbK (V : Nat) (g : Hom (lin V) (lin W0)) (u : W1.Ix (DU.fib0 V (SC.UB.bmap.nt V (A.sb V g))))
    : Id (W1.Ix (DU.fib0 V (SC.UB.bmap.nt V (A.sb V g)))) (A.kb V g (A.bkb V g u)) u =
    transH (apH (A.trU V (DU.uAct V W0 g A.Fb) (SC.UB.bmap.nt V (A.sb V g)) (symH (A.cc V g)))
              (OYm.YG.sV-round' (DU.fib0 V (A.Y.s V g)) (Fb1.tob V g) (A.Y.Po V g)
                 (A.trU V (SC.UB.bmap.nt V (A.sb V g)) (DU.uAct V W0 g A.Fb) (A.cc V g) u)))
      (trU2 V (SC.UB.bmap.nt V (A.sb V g)) (DU.uAct V W0 g A.Fb) (A.cc V g) u) ;

  module C1 = OL0.PC[YO.yP W0, Fb1, YO.yP W0, A.T, SC.UB.GDr, SC.UB.ExtBig, \ W x -> x, \ V W g x -> refl ((YO.yP W0).act V W g x), TO.TR.trV Fb1 P, TO.TR.fwV Fb1 P, TO.bf Fb1 P, TO.fb Fb1 P, TO.TR.tanat Fb1 P, A.l.nt, A.l.nt-nat, \ W x b -> SC.XS.phS W (A.l.nt W x) b, \ W x b -> SC.XS.psS W (A.l.nt W x) b, \ W x b -> SC.XS.CM.At[W, A.l.nt W x].ps-ph b, \ W x b -> SC.XS.CM.At[W, A.l.nt W x].ph-ps b, \ V W g w -> transH (SC.XS.tanat V W g (SC.PA[YO.yP W0, A.l].SF.ta W w)) (apH (SC.XS.ta V) (SC.PA[YO.yP W0, A.l].SF.tanat V W g w)), SC.hBig] ;
  module C2 = OL1.PC[YO.yP W0, Fb1, SC.UB.CU.resCtx, SC.UB.BU, SC.UB.GDr, SC.UB.ExtBig, A.sb, A.sb-nat, A.kb, A.bkb, cbfK, cfbK, A.tbnat, OFm.FC.cs, OFm.FC.cs-nat, OFm.cf, OFm.FC.bkB, OFm.cbf, OFm.cfb, OFm.FC.ctBnat, SC.hBig] ;
  module C3 = OL1.PC[YO.yP W0, Fb1, SC.UB.CU.resCtx, SC.UB.BU, DU.UCtx, DU.EGen, A.sb, A.sb-nat, A.kb, A.bkb, cbfK, cfbK, A.tbnat, SC.UB.bmap.nt, SC.UB.bmap.nt-nat, \ W x b -> b, \ W x b -> b, \ W x b -> refl b, \ W x b -> refl b, DB.CSub[a+].SubE[SC.UB.CU.resCtx, DU.UCtx, SC.UB.bmap, DU.EGen].mV-nat, SC.elOp] ;

  module G1 = OL1.PG[YO.yP W0, Fb1, SC.UB.GDr, SC.UB.ExtBig, C1.pts, C1.pnat, C1.cf, C1.cb, C1.cbf, C1.cfb, C1.mnat, C2.pts, C2.pnat, C2.cf, C2.cb, C2.cbf, C2.cfb, C2.mnat,
    \ W x -> refl (A.l.nt W x),
    \ W w -> transH (apH (\ t -> (A.l.nt W w.1, SC.XS.phS W (A.l.nt W w.1) t)) (TO.TR.tr-pw Fb1 P W w.1 (B2.AtG[W, w.1].Po1) w.2))
                    (B2.AtG[W, w.1].P3 w.2),
    SC.hBig] ;

  module G2 = OL1.PG[YO.yP W0, Fb1, DU.UCtx, DU.EGen, C3.pts, C3.pnat, C3.cf, C3.cb, C3.cbf, C3.cfb, C3.mnat, OYm.Y.s, OYm.Y.s-nat, OYm.cf, OYm.cb, \ W k b -> OYm.YG.sV-round (DU.fib0 W (OYm.Y.s W k)) (Fb1.tob W k) (OYm.Y.Po W k) b, \ W k u -> OYm.YG.sV-round' (DU.fib0 W (OYm.Y.s W k)) (Fb1.tob W k) (OYm.Y.Po W k) u, OYm.Y.tanat, \ W g -> A.cc W g, \ W v -> A.P5 W v, SC.elOp] ;
} ;
