-- CHFibCart.seg (L3, inside CB, levels k l n): equivalence structures move
-- along cartesian maps of triples (model.tex §3.4: "substitution ... of an
-- equivalence structure", "a type isomorphic fibrewise to another").  For
-- al' : B' -> A' over D (level l) and al : B -> A over G (level k), with
-- cartesian maps tB : B' -> B and tA : A' -> A over s : D -> G commuting
-- with al' and al, the map of homotopy fibres (point, B part and line
-- values mapped) is cartesian over tA; so CCart moves EquivOp al to
-- EquivOp al' (moveEq).
--
-- Quarry: seg/model GTransferEq*, GEquivSub*, GEqExt, GEqLaws (as one
-- instance of CCart).

level k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
module P0 = GPre[k] ;
module P1 = GPre[l] ;

module HCart (D : P1.PS.PCtx) (B' A' : P1.PS.PTy[D]) (al' : CPartial[l].PMap[D, B', A'])
  (G : P0.PS.PCtx) (B A : P0.PS.PTy[G]) (al : CPartial[k].PMap[G, B, A])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s V (D.act V W g d)) (G.act V W g (s W d)))
  (tA : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tApt : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (tA W v).1 (s W v.1))
  (tAnat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (tA W v)) (tA V (P1.TyL[D, A'].E.act V W g v)))
  (tAinj : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (tA W v) (tA W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bkA : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> W1.Ix (A'.tob X x))
  (bkAta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> Id (P0.TyL[G, A].EI X) (tA X (x, bkA X x u)) (s X x, u))
  (tB : (W : Ob) -> P1.TyL[D, B'].EI W -> P0.TyL[G, B].EI W)
  (tBpt : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (W0.Ix (G.ob W)) (tB W v).1 (s W v.1))
  (tBnat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, B'].EI W)
     -> Id (P0.TyL[G, B].EI V) (P0.TyL[G, B].E.act V W g (tB W v)) (tB V (P1.TyL[D, B'].E.act V W g v)))
  (tBinj : (W : Ob) (v v' : P1.TyL[D, B'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, B].EI W) (tB W v) (tB W v'))
     -> Id (P1.TyL[D, B'].EI W) v v')
  (bkB : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (B.tob X (s X x))) -> W1.Ix (B'.tob X x))
  (bkBta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (B.tob X (s X x))) -> Id (P0.TyL[G, B].EI X) (tB X (x, bkB X x u)) (s X x, u))
  (comm : (W : Ob) (v : P1.TyL[D, B'].EI W) -> Id (P0.TyL[G, A].EI W) (tA W (al'.mE W v)) (al.mE W (tB W v))) {
  module F' = CEquiv[l].HFib[D, B', A', al'] ;
  module F = CEquiv[k].HFib[G, B, A, al] ;
  module TA' = P1.TyL[D, A'] ;
  module TA = P0.TyL[G, A] ;
  module TB' = P1.TyL[D, B'] ;
  module TB = P0.TyL[G, B] ;

  -- the point map of the contexts E_A' -> E_A
  sE-nat (V W : Ob) (g : Hom V W) (w : TA'.EI W) : Id (TA.EI V) (tA V (TA'.E.act V W g w)) (TA.E.act V W g (tA W w)) =
    symH (tAnat V W g w) ;

  ----------------------------------------------------------------------
  -- the map of fibre elements

  bpt (W : Ob) (v : F'.TF.EI W) : Id (W0.Ix (G.ob W)) (tB W (F'.fibB W v)).1 (tA W v.1).1 =
    transH (tBpt W (F'.fibB W v)) (symH (tApt W v.1)) ;

  bm (W : Ob) (v : F'.TF.EI W) : W0.Ix (B.tob W (tA W v.1).1) = TB.fromE W (tA W v.1).1 (tB W (F'.fibB W v)) (bpt W v) ;

  bm-E (W : Ob) (v : F'.TF.EI W) : Id (TB.EI W) ((tA W v.1).1, bm W v) (tB W (F'.fibB W v)) =
    TB.fromE-eq W (tA W v.1).1 (tB W (F'.fibB W v)) (bpt W v) ;

  mS (W : Ob) (v : F'.TF.EI W) : F.TF.EI W =
    F.mkFib W (tA W v.1) (bm W v) (\ V f i -> tA V (F'.fibL W v V f i))
      (\ V V' g f i -> transH (tAnat V V' g (F'.fibL W v V' f i)) (apH (tA V) (F'.fibL-nat W v V V' g f i)))
      (\ V f i -> transH (tApt V (F'.fibL W v V f i))
         (transH (apH (s V) (F'.fibL-pt W v V f i)) (transH (s-nat V W f v.1.1) (apH (G.act V W f) (symH (tApt W v.1))))))
      (transH (apH (tA W) (F'.fibL-0 W v)) (transH (comm W (F'.fibB W v)) (apH (al.mE W) (symH (bm-E W v)))))
      (apH (tA W) (F'.fibL-1 W v)) ;

  mSnat (V W : Ob) (g : Hom V W) (v : F'.TF.EI W) : Id (F.TF.EI V) (F.TF.E.act V W g (mS W v)) (mS V (F'.TF.E.act V W g v)) =
    F.fibE-eq V (F.TF.E.act V W g (mS W v)) (mS V (F'.TF.E.act V W g v)) (tAnat V W g v.1)
      (transH (F.fibB-act V W g (mS W v))
        (transH (apH (TB.E.act V W g) (bm-E W v))
          (transH (tBnat V W g (F'.fibB W v))
            (transH (apH (tB V) (symH (F'.fibB-act V W g v))) (symH (bm-E V (F'.TF.E.act V W g v)))))))
      (\ W' f i -> refl (tA W' (F'.fibL W v W' (compH W' V W g f) i))) ;

  mSinj (W : Ob) (v v' : F'.TF.EI W) (P : Id (TA'.EI W) v.1 v'.1) (Q : Id (F.TF.EI W) (mS W v) (mS W v')) : Id (F'.TF.EI W) v v' =
    F'.fibE-eq W v v' P
      (tBinj W (F'.fibB W v) (F'.fibB W v') (apH (\ z -> z.1) P)
         (transH (symH (bm-E W v)) (transH (apH (F.fibB W) Q) (bm-E W v'))))
      (\ W' f i -> tAinj W' (F'.fibL W v W' f i) (F'.fibL W v' W' f i)
         (transH (F'.fibL-pt W v W' f i) (transH (apH (\ z -> D.act W' W f z.1) P) (symH (F'.fibL-pt W v' W' f i))))
         (apH (\ z -> F.fibL W z W' f i) Q)) ;

  opaque mSnat ; opaque mSinj ;

  ----------------------------------------------------------------------
  -- the lift back of a fibre

  module Bk (X : Ob) (w : TA'.EI X) (u : W0.Ix (F.FibT.tob X (tA X w))) {
    uE : F.TF.EI X = (tA X w, u) ;

    upt (V : Ob) (f : Hom V X) (i : Hom V Iv) : Id (W0.Ix (G.ob V)) (F.fibL X uE V f i).1 (s V (D.act V X f w.1)) =
      transH (F.fibL-pt X uE V f i) (transH (apH (G.act V X f) (tApt X w)) (symH (s-nat V X f w.1))) ;

    val (V : Ob) (f : Hom V X) (i : Hom V Iv) : TA'.EI V =
      (D.act V X f w.1, bkA V (D.act V X f w.1) (TA.fromE V (s V (D.act V X f w.1)) (F.fibL X uE V f i) (upt V f i))) ;

    val-t (V : Ob) (f : Hom V X) (i : Hom V Iv) : Id (TA.EI V) (tA V (val V f i)) (F.fibL X uE V f i) =
      transH (bkAta V (D.act V X f w.1) (TA.fromE V (s V (D.act V X f w.1)) (F.fibL X uE V f i) (upt V f i)))
             (TA.fromE-eq V (s V (D.act V X f w.1)) (F.fibL X uE V f i) (upt V f i)) ;

    b0 : W1.Ix (B'.tob X w.1) = bkB X w.1 (TB.fromE X (s X w.1) (F.fibB X uE) (tApt X w)) ;

    b0-t : Id (TB.EI X) (tB X (w.1, b0)) (F.fibB X uE) =
      transH (bkBta X w.1 (TB.fromE X (s X w.1) (F.fibB X uE) (tApt X w))) (TB.fromE-eq X (s X w.1) (F.fibB X uE) (tApt X w)) ;

    tn (V V' : Ob) (g : Hom V V') (f : Hom V' X) (i : Hom V' Iv)
      : Id (TA'.EI V) (TA'.E.act V V' g (val V' f i)) (val V (compH V V' X f g) (compH V V' Iv i g)) =
      tAinj V (TA'.E.act V V' g (val V' f i)) (val V (compH V V' X f g) (compH V V' Iv i g))
        (symH (D.act-o V V' X f g w.1))
        (transH (symH (tAnat V V' g (val V' f i)))
          (transH (apH (TA.E.act V V' g) (val-t V' f i))
            (transH (F.fibL-nat X uE V V' g f i) (symH (val-t V (compH V V' X f g) (compH V V' Iv i g)))))) ;

    t0 : Id (TA'.EI X) (val X (idH X) (ptH X e0)) (al'.mE X (w.1, b0)) =
      tAinj X (val X (idH X) (ptH X e0)) (al'.mE X (w.1, b0))
        (transH (D.act-id X w.1) (symH (al'.mpt X (w.1, b0))))
        (transH (val-t X (idH X) (ptH X e0))
          (transH (F.fibL-0 X uE) (transH (apH (al.mE X) (symH b0-t)) (symH (comm X (w.1, b0)))))) ;

    t1 : Id (TA'.EI X) (val X (idH X) (ptH X e1)) w =
      tAinj X (val X (idH X) (ptH X e1)) w (D.act-id X w.1) (transH (val-t X (idH X) (ptH X e1)) (F.fibL-1 X uE)) ;

    res : W1.Ix (F'.FibT.tob X w) =
      (F'.mkFib X w b0 val tn (\ V f i -> refl (D.act V X f w.1)) t0 t1).2 ;

    res-t : Id (F.TF.EI X) (mS X (w, res)) uE =
      F.fibE-eq X (mS X (w, res)) uE (refl (tA X w))
        (transH (bm-E X (w, res)) b0-t)
        (\ V f i -> val-t V f i) ;

    opaque res-t ;
  } ;

  ----------------------------------------------------------------------
  -- the cartesian map of homotopy fibres, and the move

  module C = CCart[k, l].Cart[F'.EA, F'.FibT, F.EA, F.FibT, tA, sE-nat, mS, \ W v -> refl (tA W v.1), mSnat, mSinj,
    \ X w u -> Bk[X, w, u].res, \ X w u -> Bk[X, w, u].res-t] ;

  moveEq (e : CEquiv[k].EquivOp G B A al) : CEquiv[l].EquivOp D B' A' al' = C.moveContr e ;

  uniqueEq (e : CEquiv[k].EquivOp G B A al) (e' : CEquiv[l].EquivOp D B' A' al')
    (H : (X : Ob) (x : W1.Ix (F'.EA.ob X)) (sd : CPartial[l].Partials[F'.EA, F'.FibT].Side[X, x])
       -> Id (P0.TyL[F.EA, F.FibT].EI X) (mS X (x, e'.kop X x sd)) (tA X x, e.kop X (tA X x) (C.mside e X x sd)))
    : Id (CEquiv[l].EquivOp D B' A' al') e' (moveEq e) = C.uniqueContr e e' H ;
} ;
