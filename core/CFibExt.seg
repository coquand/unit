-- CFibExt.seg (L3, inside CB, level l): extensionality for types with a
-- fibration structure.  A type B with the same fibres as A and an action
-- equal to A's pointwise carries A's structure moved along the identity
-- cart, and (A , c) = (B , c moved).  By induction on the action pack;
-- at A's own pack the cart moves nothing (CCartLaws.CI).
--
-- Quarry: seg/model GFibExt.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module FX (G : PCtx) {
  Pack (o : TOb G) : U l = (h : TactTy G o) * (IdLaw G o h * OLaw G o h) ;

  packOf (A : PTy[G]) : Pack A.tob = (A.tact, (A.tact-id, A.tact-o)) ;

  tyOf (A : PTy[G]) (q : Pack A.tob) : PTy[G] = mkTy G A.tob q.1 q.2.1 q.2.2 ;

  -- the identity on data is natural from tyOf A q to A
  NatTy (A : PTy[G]) (q : Pack A.tob) : U l =
    (V W : Ob) (g : Hom V W) (v : GPR.TyL[G, tyOf A q].EI W)
      -> Id (GPR.TyL[G, A].EI V) (GPR.TyL[G, A].E.act V W g v) (GPR.TyL[G, tyOf A q].E.act V W g v) ;

  moveK (A : PTy[G]) (q : Pack A.tob) (mn : NatTy A q) (c : CLine[l].Lines[G, A].Fib) : CLine[l].Lines[G, tyOf A q].Fib =
    CCart[l, l].Cart[G, tyOf A q, G, A, \ W x -> x, \ V W g x -> refl (G.act V W g x),
      \ W v -> v, \ W v -> refl v.1, mn, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u)].moveFib c ;

  base (A : PTy[G]) (c : CLine[l].Lines[G, A].Fib) (mn : NatTy A (packOf A))
    : Id ((B : PTy[G]) * CLine[l].Lines[G, B].Fib) (A, c) (A, moveK A (packOf A) mn c) =
    apH {CLine[l].Lines[G, A].Fib} {(B : PTy[G]) * CLine[l].Lines[G, B].Fib} (\ z -> (A, z)) (CCartLaws[l].CI[G, A, mn].idFib c) ;

  core (A : PTy[G]) (c : CLine[l].Lines[G, A].Fib) (q : Pack A.tob) (Q : Id (Pack A.tob) (packOf A) q) (mn : NatTy A q)
    : Id ((B : PTy[G]) * CLine[l].Lines[G, B].Fib) (A, c) (tyOf A q, moveK A q mn c) =
    idJ (Pack A.tob) (packOf A)
      (\ q2 Q2 -> (mn2 : NatTy A q2) -> Id ((B : PTy[G]) * CLine[l].Lines[G, B].Fib) (A, c) (tyOf A q2, moveK A q2 mn2 c))
      (\ mn2 -> base A c mn2) q Q mn ;

  -- the principle
  fibExt (A : PTy[G]) (c : CLine[l].Lines[G, A].Fib) (q : Pack A.tob) (Ht : PtEq G A.tob A.tact q.1) (mn : NatTy A q)
    : Id ((B : PTy[G]) * CLine[l].Lines[G, B].Fib) (A, c) (tyOf A q, moveK A q mn c) =
    core A c q
      (Sigma-eq (TactTy G A.tob) (\ h -> IdLaw G A.tob h * OLaw G A.tob h) A.tact q.1 (A.tact-id, A.tact-o) q.2
         (tact-funext G A.tob A.tact q.1 Ht)
         (isProp-Sigma (IdLaw G A.tob q.1) (\ z -> OLaw G A.tob q.1) (idLaw-prop G A.tob q.1) (\ z -> oLaw-prop G A.tob q.1)))
      mn ;
} ;
