-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- poset-model.pdf, Theorem 12.3 (chosen-operation formulation).
-- Hypotheses and conclusions use the existing poset model at levels a <= l:
--   CLocBound.Bounds.SpheresBound: Definition 12.2, with chosen fillers;
--   CLine.Lines.Fib: composition in both directions;
--   CLocUniv.isModal: eta_A is a homotopy equivalence;
--   CPartial.ContrOp: uniform extension on every decidable sieve;
--   CLocBoundContr.Contractible: a section and a path from it to each point.
-- ContrOp includes the finite unions of subset inclusions in Definition
-- 12.1.  SpheresBound includes dimension zero (a point in each fibre over
-- [0]); the higher boundary data are facets with pairwise overlap equations.
-- No naturality is demanded of the chosen sphere fillers.
--
-- The first part follows the paper's dimension induction.  For the modal
-- part, CLocBoundRetr uses composition directly to correct the extension
-- along the inverse homotopy; CLocBoundContr then constructs the contraction
-- by extending the empty side and the two endpoint sides.  Thus the quoted
-- external contractibility lemmas in the paper are proved here in the form
-- needed for this conclusion, rather than assumed.
--
-- All recursion is the eliminator on dimension in CLocBoundStage.
-- No new axioms: the surrounding Model's existing funext/univalence
-- parameters and the theorem's composition, boundary fillers and
-- (for the second conclusion) D-modality are the only assumptions.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ; module HO = PB.CHtpyOps[l] ;
module LD = CLocD[a,l] ; module CH = CLocHtpy[a,l] ;
module SB = CLocBound[a,l] ; module BC = CLocBoundContr[a,l] ;
module BR = CLocBoundRetr[a,l] ;

module Theorem (G : PCtx) (A : PTy[G]) (spheres : SB.Bounds[G,A].SpheresBound) {
  module D = LD.DT[G,A] ;
  -- Composition is unnecessary for this first conclusion.
  dTrivial : CP.ContrOp G D.DA = CLocBoundD[a,l].Extension[G,A,spheres].extension ;
  dContractible : BC.Contractible[G,D.DA] = BC.Contract[G,D.DA,dTrivial].result ;

  module Modal (c : PB.CLine[l].Lines[G,A].Fib) (modal : CLocUniv[a,l].isModal G A) {
    eta : HO.NMap[G,A,D.DA] = CH.toN G A D.DA D.etaN ;
    m : HO.NMap[G,A,A] = HO.compN G A D.DA A eta modal.inv ;
    module R = BR.Relative[G,A,D.DA,eta,modal.inv,dTrivial] ;
    trivial : CP.ContrOp G A = BR.Correct[G,A,m,R.extension,modal.hl,c.1].extension ;
    contractible : BC.Contractible[G,A] = BC.Contract[G,A,trivial].result ;
  } ;
} ;

-- A single declaration containing all conclusions in the paper.
theorem12-3 (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G,A].Fib)
  (spheres : SB.Bounds[G,A].SpheresBound) :
  CP.ContrOp G (LD.DT[G,A].DA) *
    ((modal : CLocUniv[a,l].isModal G A) -> CP.ContrOp G A * BC.Contractible[G,A]) =
  (Theorem[G,A,spheres].dTrivial,
   \ modal -> (Theorem[G,A,spheres].Modal[c,modal].trivial,Theorem[G,A,spheres].Modal[c,modal].contractible)) ;
