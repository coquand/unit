-- Transport in a fibrant family between any two points of a seeded
-- extension algebra.  Only the family's composition is used.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CL = PB.CLine[l] ;

module Transport (G : PCtx) (T : PTy[G])
  (k : CTruncAlg[a,l].Algebras[G,T].Algebra) (B : PTy[extP G T])
  (c : CL.Lines[extP G T,B].CompK[e0,e1].Comp) {
  module TT = PR.TyL[G,T] ; module TB = PR.TyL[TT.E,B] ;
  module P = CTruncIsProp[a,l].IsProp[G,T,k] ;
  module FG = CL.FC[TT.E] ;
  module EK = CL.EndKit[TT.E,B,e0] ; module EK' = CL.EndKit[TT.E,B,e1] ;
  module Tr = PB.CTr[l].Tr[TT.E,B,true,c] ;
  module At (X : Ob) (x : TT.Pt X) (u v : TT.T X x) (b : TB.T X (x,u)) {
    ph : W.Ix (P.Pth.PT.tobP X (x,(u,v))) = P.proposition.eob X (x,(u,v)) ;
    start : EK.TV.EI X = (ph.1,TB.fromE X ((FG.ev e0).nt X ph.1) ((x,u),b) (symH ph.2.2.1)) ;
    start-eq : Id (TB.EI X) (EK.endE X start) ((x,u),b) =
      TB.fromE-eq X ((FG.ev e0).nt X ph.1) ((x,u),b) (symH ph.2.2.1) ;
    raw : TB.EI X = EK'.endE X (Tr.tr.mE X start) ;
    over : Id (TT.EI X) raw.1 (x,v) =
      transH (apH ((FG.ev e1).nt X) (Tr.tr.mpt X start)) ph.2.2.2 ;
    value : TB.T X (x,v) = TB.fromE X (x,v) raw over ;
    equation : Id (TB.EI X) ((x,v),value) raw = TB.fromE-eq X (x,v) raw over ;
    opaque start-eq ; opaque over ; opaque equation ;
  } ;
  module Natural (Y X : Ob) (h : Hom Y X) (x : TT.Pt X) (y : TT.Pt Y)
    (u v : TT.T X x) (u' v' : TT.T Y y)
    (p : Id (W.Ix (P.Pth.GA.ob Y)) (P.Pth.GA.act Y X h (x,(u,v))) (y,(u',v')))
    (b : TB.T X (x,u)) (b' : TB.T Y (y,u'))
    (q : Id (TB.EI Y) (TB.E.act Y X h ((x,u),b)) ((y,u'),b')) {
    module P0 = At[X,x,u,v,b] ; module V' = At[Y,y,u',v',b'] ;
    lines : Id (W.Ix (FG.ob Y)) (FG.actF Y X h P0.ph.1) V'.ph.1 =
      apH (\ ph -> ph.1) (P.proposition.enat Y X h (x,(u,v)) (y,(u',v')) p) ;
    starts : Id (EK.TV.EI Y) (EK.TV.E.act Y X h P0.start) V'.start =
      EK.tv-eq Y _ _ lines (transH (EK.endE-act Y X h P0.start)
        (transH (apH (TB.E.act Y X h) P0.start-eq) (transH q (symH V'.start-eq)))) ;
    result : Id (TB.EI Y) (TB.E.act Y X h ((x,v),P0.value)) ((y,v'),V'.value) =
      transH (apH (TB.E.act Y X h) P0.equation)
        (transH (symH (EK'.endE-act Y X h (Tr.tr.mE X P0.start)))
          (transH (apH (EK'.endE Y) (symH (Tr.tr.mnat Y X h P0.start)))
            (transH (apH (\ w -> EK'.endE Y (Tr.tr.mE Y w)) starts) (symH V'.equation)))) ;
    opaque result ;
  } ;
} ;
