-- CMapLine.seg (L3, inside CB, level l): partial lines moved along a map
-- of types al : A -> B over G.  A point over the end e goes to the image
-- of its value (tvM); an element of the fibres of ev e (a line ending at
-- the point) goes to the line of the images of its values (tsM); both
-- commute with restriction, so sides move (mapS).  Used by Theorem 7 to
-- unglue a partial line of Ext(alpha) along ext(alpha).
--
-- Quarry: seg/model GMapLine.MapLine, on families and one sieve.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module MapLine (G : PCtx) (A B : PTy[G]) (al : CPartial[l].PMap[G, A, B]) (e : IPt) {
  module KA = CLine[l].EndKit[G, A, e] ;
  module KB = CLine[l].EndKit[G, B, e] ;
  module FG = CLine[l].FC[G] ;
  module FA = CLine[l].FT[G, A] ;
  module FB = CLine[l].FT[G, B] ;
  module TA = GPR.TyL[G, A] ;
  module TB = GPR.TyL[G, B] ;

  ----------------------------------------------------------------------
  -- points over the end

  tvM (W : Ob) (z : KA.TV.EI W) : KB.TV.EI W =
    (KB.TV.pr W (KA.TV.pr1 W z) (TB.fromE W ((FG.ev e).nt W (KA.TV.pr1 W z)) (al.mE W (KA.endE W z)) (al.mpt W (KA.endE W z)))) ;

  tvM-E (W : Ob) (z : KA.TV.EI W) : Id (TB.EI W) (KB.endE W (tvM W z)) (al.mE W (KA.endE W z)) =
    TB.fromE-eq W ((FG.ev e).nt W (KA.TV.pr1 W z)) (al.mE W (KA.endE W z)) (al.mpt W (KA.endE W z)) ;

  tvM-act (Y X : Ob) (h : Hom Y X) (z : KA.TV.EI X) : Id (KB.TV.EI Y) (tvM Y (KA.TV.E.act Y X h z)) (KB.TV.E.act Y X h (tvM X z)) =
    KB.tv-eq Y (tvM Y (KA.TV.E.act Y X h z)) (KB.TV.E.act Y X h (tvM X z)) (refl (FG.actF Y X h (KA.TV.pr1 X z)))
      (transH (tvM-E Y (KA.TV.E.act Y X h z))
        (transH (apH (al.mE Y) (KA.endE-act Y X h z))
          (transH (al.mnat Y X h (KA.endE X z))
            (transH (apH (TB.E.act Y X h) (symH (tvM-E X z))) (symH (KB.endE-act Y X h (tvM X z))))))) ;

  ----------------------------------------------------------------------
  -- elements of the fibres: the line of the images of the values

  module Ln (W : Ob) (u : KA.TS.EI W) {
    t (V : Ob) (g : Hom V W) (j : Hom V Iv) : TB.EI V = al.mE V (FA.lval W (KA.lineL W u) V g j) ;

    L : KB.TL.EI W =
      (KB.TL.pr W (KA.TV.pr1 W (KA.TS.pr1 W u)) (FB.lamA W (KA.TV.pr1 W (KA.TS.pr1 W u)) t
        (\ V g j -> transH (al.mpt V (FA.lval W (KA.lineL W u) V g j)) (apH (\ y -> y.1 V g j) (KA.TL.pr2 W (KA.lineL W u)).2))
        (\ V' V g' g j -> transH (symH (al.mnat V' V g' (FA.lval W (KA.lineL W u) V g j)))
                                 (apH (al.mE V') ((KA.TL.pr2 W (KA.lineL W u)).1.2 V' V g' g j))))) ;

    q : Id (TB.EI W) (KB.endE W (FB.Ev[e].evA.mE W L)) (KB.endE W (tvM W (KA.TS.pr1 W u))) =
      transH (FB.Ev[e].endB-E W L)
        (transH (apH (al.mE W) (symH (FA.Ev[e].endB-E W (KA.lineL W u))))
          (transH (apH (\ z -> al.mE W (KA.endE W z)) (KA.TS.pr2 W u).2) (symH (tvM-E W (KA.TS.pr1 W u))))) ;
  } ;

  tsM (W : Ob) (u : KA.TS.EI W) : KB.TS.EI W = KB.mkTS W (tvM W (KA.TS.pr1 W u)) Ln[W, u].L (refl (KA.TV.pr1 W (KA.TS.pr1 W u))) Ln[W, u].q ;

  tsM-pt (W : Ob) (u : KA.TS.EI W) : Id (KB.TV.EI W) (KB.TS.pr1 W (tsM W u)) (tvM W (KA.TS.pr1 W u)) =
    KB.mkTS-pt W (tvM W (KA.TS.pr1 W u)) Ln[W, u].L (refl (KA.TV.pr1 W (KA.TS.pr1 W u))) Ln[W, u].q ;

  -- the values of the moved line are the images of the values
  tsM-val (W : Ob) (u : KA.TS.EI W) (V : Ob) (g : Hom V W) (j : Hom V Iv)
    : Id (TB.EI V) (FB.lval W (KB.lineL W (tsM W u)) V g j) (al.mE V (FA.lval W (KA.lineL W u) V g j)) =
    apH (\ M -> FB.lval W M V g j) (KB.mkTS-line W (tvM W (KA.TS.pr1 W u)) Ln[W, u].L (refl (KA.TV.pr1 W (KA.TS.pr1 W u))) Ln[W, u].q) ;

  opaque tsM-pt ; opaque tsM-val ;

  tsM-act (V W : Ob) (g : Hom V W) (u : KA.TS.EI W) : Id (KB.TS.EI V) (KB.TS.E.act V W g (tsM W u)) (tsM V (KA.TS.E.act V W g u)) =
    KB.ts-ext V (KB.TS.E.act V W g (tsM W u)) (tsM V (KA.TS.E.act V W g u))
      (transH (apH (KB.TV.E.act V W g) (tsM-pt W u))
        (transH (symH (tvM-act V W g (KA.TS.pr1 W u))) (symH (tsM-pt V (KA.TS.E.act V W g u)))))
      (\ V' g' j -> transH (apH (\ M -> FB.lval V M V' g' j) (KB.lineL-act V W g (tsM W u)))
         (transH (tsM-val W u V' (compH V' V W g g') j)
           (transH (apH (al.mE V') (symH (apH (\ M -> FA.lval V M V' g' j) (KA.lineL-act V W g u))))
                   (symH (tsM-val V (KA.TS.E.act V W g u) V' g' j))))) ;

  opaque tsM-act ;

  -- sides move
  mapS (X : Ob) (x : KA.TV.EI X) (s : KA.PT.Side[X, x]) : KB.PT.Side[X, tvM X x] =
    new KB.PT.Side[X, tvM X x, s.pQ, \ V f i -> tsM V (s.pv V f i),
      \ V f i -> transH (tsM-pt V (s.pv V f i)) (transH (apH (tvM V) (s.ppt V f i)) (tvM-act V X f x)),
      \ W' W chi f i i' -> transH (tsM-act W' W chi (s.pv W f i)) (apH (tsM W') (s.pnat W' W chi f i i'))] ;
} ;
