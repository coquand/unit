-- CPosEl2.seg (L8, posets): El is fibrant, part 2: the point of a line of
-- codes.  A line of codes l at Z, with a code F over Z * [1] and paths Qd
-- (F along (g , j) is l (g , j)), and an element a of El at the end e of
-- l: the generic line of Z * [1] with a read in F is a point o of F's line
-- context over (l , a): its image along the Yoneda cart is (l , a) (oio).
--
-- Quarry: seg/model PElL (QdC), GLocal (dg, Pull).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module PB = E1.PB ;
module UU = E1.UU ;
module FGU = E1.FGU ;
module GPR = PB.GPre[a] ;
module L = PB.GPre[a+].PS ;

-- (f , i) g = (f g , i g)
pair-comp (V W X : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
  : Id (Hom V (prodP X Iv)) (compH V W (prodP X Iv) (pairH X Iv W f i) g) (pairH X Iv V (compH V W X f g) (compH V W Iv i g)) =
  hom-eq V (prodP X Iv) (compH V W (prodP X Iv) (pairH X Iv W f i) g) (pairH X Iv V (compH V W X f g) (compH V W Iv i g))
    (\ s -> calc Tree {
        (app V (prodP X Iv) (compH V W (prodP X Iv) (pairH X Iv W f i) g) s).1
      =< app-compH1 V W (prodP X Iv) (pairH X Iv W f i) g s >
        node (app W X f (app V W g s)).1 (app W Iv i (app V W g s)).1
      =< apH (\ t -> node t (app W Iv i (app V W g s)).1) (symH (app-compH1 V W X f g s)) >
        node (app V X (compH V W X f g) s).1 (app W Iv i (app V W g s)).1
      =< apH (\ t -> node (app V X (compH V W X f g) s).1 t) (symH (app-compH1 V W Iv i g s)) >
        (app V (prodP X Iv) (pairH X Iv V (compH V W X f g) (compH V W Iv i g)) s).1 }) ;

-- the canonical code of a line: l at the generic point of Z * [1]
FC (Z : Ob) (l : V1.Ix (FGU.ob Z)) : UU.U0 (prodP Z Iv) = l.1 (prodP Z Iv) (pr1 Z Iv) (pr2 Z Iv) ;

QdC (Z : Ob) (l : V1.Ix (FGU.ob Z)) (W : Ob) (g : Hom W Z) (j : Hom W Iv)
  : Id (UU.U0 W) (UU.uAct W (prodP Z Iv) (pairH Z Iv W g j) (FC Z l)) (l.1 W g j) =
  transH (l.2 W (prodP Z Iv) (pairH Z Iv W g j) (pr1 Z Iv) (pr2 Z Iv))
    (transH (apH (\ k -> l.1 W k (compH W (prodP Z Iv) Iv (pr2 Z Iv) (pairH Z Iv W g j))) (pr1-pair Z Iv W g j))
            (apH (\ k -> l.1 W g k) (pr2-pair Z Iv W g j))) ;

module Pt (e : El Iv) (Z : Ob) (l : V1.Ix (FGU.ob Z)) (F : UU.U0 (prodP Z Iv))
  (Qd : (W : Ob) (g : Hom W Z) (j : Hom W Iv) -> Id (UU.U0 W) (UU.uAct W (prodP Z Iv) (pairH Z Iv W g j) F) (l.1 W g j))
  (a0 : W0.Ix (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e)))) {
  module Y = E1.YG.Yc[prodP Z Iv, F] ;
  module Ae = Y.K.AtEnd[e] ;
  module FZ = PB.CLine[a].FC[E1.yP (prodP Z Iv)] ;

  -- the generic line of Z * [1]
  ell : W0.Ix (FZ.ob Z) = (\ V g j -> pairH Z Iv V g j, \ V' V g' g j -> pair-comp V' V Z g' g j) ;

  pe : Hom Z (prodP Z Iv) = pairH Z Iv Z (idH Z) (constH Z Iv e) ;

  cA : Id W0.V (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e))) (F.1.tob Z pe) =
    transH (apH (UU.fib0 Z) (symH (Qd Z (idH Z) (constH Z Iv e)))) (Y.Po Z pe) ;

  b0 : W0.Ix (F.1.tob Z pe) = E1.YG.sV (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e))) (F.1.tob Z pe) cA a0 ;

  o : Ae.EK'.TV.EI Z = (ell, b0) ;

  -- its image is (l , a0)
  oio : Id (Ae.EK.TV.EI Z) (Ae.sV Z o) (l, a0) =
    Ae.EK.tv-eq Z (Ae.sV Z o) (l, a0) (FGU.fam-eq Z (Y.K.sI Z ell) l (\ V g j -> Qd V g j))
      (transH (Ae.sVE Z o)
        (E1.YG.pairE Z (Y.s Z pe) (l.1 Z (idH Z) (constH Z Iv e)) (Qd Z (idH Z) (constH Z Iv e))
           (E1.YG.sV (F.1.tob Z pe) (UU.fib0 Z (Y.s Z pe)) (symH (Y.Po Z pe)) b0) a0
           (transH (UU.substF Z (Y.s Z pe) (l.1 Z (idH Z) (constH Z Iv e)) (Qd Z (idH Z) (constH Z Iv e))
                      (E1.YG.sV (F.1.tob Z pe) (UU.fib0 Z (Y.s Z pe)) (symH (Y.Po Z pe)) b0))
             (transH (apH (PB.CExtEq1.sV (UU.fib0 Z (Y.s Z pe)) (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e)))
                            (ap (UU.U0 Z) W0.V (UU.fib0 Z) (Y.s Z pe) (l.1 Z (idH Z) (constH Z Iv e)) (Qd Z (idH Z) (constH Z Iv e))))
                        (PB.CExtEq1.sV-two (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e))) (F.1.tob Z pe) (UU.fib0 Z (Y.s Z pe))
                           cA (symH (Y.Po Z pe)) (transH cA (symH (Y.Po Z pe))) a0))
               (PB.CExtEq1.sV-two (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e))) (UU.fib0 Z (Y.s Z pe)) (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e)))
                  (transH cA (symH (Y.Po Z pe)))
                  (ap (UU.U0 Z) W0.V (UU.fib0 Z) (Y.s Z pe) (l.1 Z (idH Z) (constH Z Iv e)) (Qd Z (idH Z) (constH Z Iv e)))
                  (refl (UU.fib0 Z (l.1 Z (idH Z) (constH Z Iv e)))) a0))))) ;

  opaque oio ;
} ;
