-- CPostExt.seg: locality tools for the Postnikov construction.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;


module Reading (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y X : Ob) (h : Hom Y X)
  (z : PB.GPre[l].TyL[G, LD.DT[G, CK.KT[G, A, N].KA].DA].EI X)
  (z' : PB.GPre[l].TyL[G, LD.DT[G, CK.KT[G, A, N].KA].DA].EI Y)
  (ez : Id (PB.GPre[l].TyL[G, LD.DT[G, CK.KT[G, A, N].KA].DA].EI Y)
    (PB.GPre[l].TyL[G, LD.DT[G, CK.KT[G, A, N].KA].DA].E.act Y X h z) z')
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (f : Hom P X) (f' : Hom P Y) (ef : Id (Hom P X) f (compH P Y X h f')) {
  module K = CK.KT[G, A, N] ;
  module D = LD.DT[G, K.KA] ;
  module TK = K.TK ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module TD = PB.GPre[l].TyL[G, D.DA] ;
  module R1 = CPostK[a, l].DRK[G, A, N, X, z.1, z.2, P, ht, B, hB, hm, hi, f] ;
  module R2 = CPostK[a, l].DRK[G, A, N, Y, z'.1, z'.2, P, ht, B, hB, hm, hi, f'] ;
  rd (n : Nat) (q : Hom (lin n) P) : Id (TK.EI (lin n))
    (D.rd X z.1 z.2.1 n (compH (lin n) P X f q)) (D.rd Y z'.1 z'.2.1 n (compH (lin n) P Y f' q)) =
    transH (apH (\ k -> D.rd X z.1 z.2.1 n k)
      (transH (apH (\ k -> compH (lin n) P X k q) ef) (comp-assoc (lin n) P Y X h f' q)))
      (transH (symH (D.rd-dtact Y X h z.1 (G.act Y X h z.1) (refl (G.act Y X h z.1)) z.2 n (compH (lin n) P Y f' q)))
        (apH (\ w -> D.rd Y w.1 w.2.1 n (compH (lin n) P Y f' q)) ez)) ;
  opaque rd ;
  knat (W : Nat) (g : Hom (lin W) P) : Id (TK.EI (lin W)) (R1.val W g) (R2.val W g) =
    apH {TK.EI (lin R1.At[W, g].Z.r)} {TK.EI (lin W)} (TK.E.act (lin W) (lin R1.At[W, g].Z.r) R1.At[W, g].Z.sgm) (rd R1.At[W, g].Z.r R1.At[W, g].Z.c) ;
  opaque knat ;
  module Bounded (hN hN' : IsT (leb B N)) {
    module A1 = CPostMap[a, l].DR[G, A, N, X, z.1, z.2, P, ht, B, hB, hm, hi, hN, f] ;
    module A2 = CPostMap[a, l].DR[G, A, N, Y, z'.1, z'.2, P, ht, B, hB, hm, hi, hN', f'] ;
    anat (W : Nat) (g : Hom (lin W) P) : Id (TA.EI (lin W)) (A1.val W g) (A2.val W g) =
      apH (TA.E.act (lin W) (lin A1.At[W, g].Z.r) A1.At[W, g].Z.sgm)
        (transH (apH (K.ev A1.At[W, g].Z.r A1.At[W, g].rN) (rd A1.At[W, g].Z.r A1.At[W, g].Z.c))
          (K.ev-irr A1.At[W, g].Z.r A1.At[W, g].rN A2.At[W, g].rN
            (D.rd Y z'.1 z'.2.1 A2.At[W, g].Z.r A2.At[W, g].pc))) ;
  } ;
} ;

-- Equality on the generating pieces of the boundary sieve suffices.
module SideEq (G : PP.PCtx) (A : PP.PTy[G]) (m : Nat) (Y : Ob) (QY : CPosBase[a].SP.Phi Y)
  (v v' : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Y))
    -> CPosBase[a].SP.Lands (lin W) (prodP (lin (suc m)) Y) (CPostBdry[a, l].BG[m, Y].bdS QY) g
    -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (hf : (k : Nat) (hk : IsT (leb k (suc m))) (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Y))
    (i i' : CPosBase[a].SP.Lands (lin W) (prodP (lin (suc m)) Y) (CPostBdry[a, l].BG[m, Y].bdS QY) g)
    -> Miss (lin W) m k (CPostBdry[a, l].BG[m, Y].p1g W g) -> (j : Hom (lin W) Iv)
    -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (v W g i j) (v' W g i' j))
  (he : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Y))
    (i i' : CPosBase[a].SP.Lands (lin W) (prodP (lin (suc m)) Y) (CPostBdry[a, l].BG[m, Y].bdS QY) g)
    -> CPosBase[a].SP.Lands (lin W) (prodP (lin (suc m)) Y) (CPostBdry[a, l].BG[m, Y].endS QY) g -> (j : Hom (lin W) Iv)
    -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (v W g i j) (v' W g i' j)) {
  module SP = CPosBase[a].SP ;
  module BG = CPostBdry[a, l].BG[m, Y] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  aux (W : Nat) (g : Hom (lin W) BG.X) (i i' : SP.Lands (lin W) BG.X (BG.bdS QY) g) (j : Hom (lin W) Iv)
    : Plus (SP.Lands (lin W) BG.X BG.facesS g) (SP.Lands (lin W) BG.X (BG.endS QY) g)
      -> Id (TA.EI (lin W)) (v W g i j) (v' W g i' j) = split {
    inl b -> hf (SP.bigU-out (lin W) BG.X (suc (suc m)) (\ k -> BG.faceS k.1) g b).1.1
      (SP.bigU-out (lin W) BG.X (suc (suc m)) (\ k -> BG.faceS k.1) g b).1.2 W g i i'
      (BG.miss-of W g (SP.bigU-out (lin W) BG.X (suc (suc m)) (\ k -> BG.faceS k.1) g b).1.1
        (SP.bigU-out (lin W) BG.X (suc (suc m)) (\ k -> BG.faceS k.1) g b).2) j ;
    inr b -> he W g i i' b j } ;
  eq (W : Nat) (g : Hom (lin W) BG.X) (i i' : SP.Lands (lin W) BG.X (BG.bdS QY) g) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (v W g i j) (v' W g i' j) =
    aux W g i i' j (SP.union-lands (lin W) BG.X BG.facesS (BG.endS QY) g i) ;
} ;

-- Coordinates of restriction along h * I.
module Cross (Y X : Ob) (h : Hom Y X) {
  YI : Ob = prodP Y Iv ; XI : Ob = prodP X Iv ;
  hI : Hom YI XI = crossH Y X Iv Iv h (idH Iv) ;
  p1 : Id (Hom YI X) (compH YI XI X (pr1 X Iv) hI) (compH YI Y X h (pr1 Y Iv)) =
    pr1-pair X Iv YI (compH YI Y X h (pr1 Y Iv)) (compH YI Iv Iv (idH Iv) (pr2 Y Iv)) ;
  p2 : Id (Hom YI Iv) (compH YI XI Iv (pr2 X Iv) hI) (pr2 Y Iv) =
    transH (pr2-pair X Iv YI (compH YI Y X h (pr1 Y Iv)) (compH YI Iv Iv (idH Iv) (pr2 Y Iv))) (comp-idl YI Iv (pr2 Y Iv)) ;
  one (V : Ob) (q : Hom V YI) : Id (Hom V X)
    (compH V XI X (pr1 X Iv) (compH V YI XI hI q)) (compH V Y X h (compH V YI Y (pr1 Y Iv) q)) =
    transH (symH (comp-assoc V YI XI X (pr1 X Iv) hI q))
      (transH (apH (\ k -> compH V YI X k q) p1) (comp-assoc V YI Y X h (pr1 Y Iv) q)) ;
  two (V : Ob) (q : Hom V YI) : Id (Hom V Iv)
    (compH V XI Iv (pr2 X Iv) (compH V YI XI hI q)) (compH V YI Iv (pr2 Y Iv) q) =
    transH (symH (comp-assoc V YI XI Iv (pr2 X Iv) hI q)) (apH (\ k -> compH V YI Iv k q) p2) ;
  base (G : PP.PCtx) (x : W0.Ix (G.ob X)) (y : W0.Ix (G.ob Y)) (e : Id (W0.Ix (G.ob Y)) (G.act Y X h x) y)
    : Id (W0.Ix (G.ob YI)) (G.act YI XI hI (G.act XI X (pr1 X Iv) x)) (G.act YI Y (pr1 Y Iv) y) =
    transH (PB.GPre[l].PshL[G].actC YI XI X (pr1 X Iv) hI x)
      (transH (apH (\ k -> G.act YI X k x) p1)
        (transH (G.act-o YI Y X h (pr1 Y Iv) x) (apH (G.act YI Y (pr1 Y Iv)) e))) ;
  opaque one ; opaque two ; opaque base ;
} ;

bcong (T : U l) : (b : Bool) (t t' : IsT b -> T) (f f' : Id Bool b false -> T)
  -> ((h : IsT b) -> Id T (t h) (t' h)) -> ((h : Id Bool b false) -> Id T (f h) (f' h))
  -> Id T (CPostRec[a, l].bcaseL T b t f) (CPostRec[a, l].bcaseL T b t' f') = split {
  true -> \ t t' f f' ht hf -> ht (refl true) ;
  false -> \ t t' f f' ht hf -> hf (refl false) } ;
