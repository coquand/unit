-- General dependent elimination into fibrant propositions in the model.
-- Hypotheses on B are composition and the ordinary internal statement
-- (u v : B) -> Path B u v.  No seeded/displayed algebra is assumed:
-- CTruncFromProp constructs one, and CTruncLift constructs its displayed
-- lifting.  Given b(a) : B(inc a), section(t) : B(t) is natural, and
-- beta-inc proves section(inc a) = b(a) in the metatheory.
-- This theorem does not assert fibrancy or substitution stability of T.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module Elimination (G : PCtx) (A : PTy[G])
  (B : PTy[extP G CTrunc[a,l].Truncation[G,A].Ty])
  (c : PB.CLine[l].Lines[extP G CTrunc[a,l].Truncation[G,A].Ty,B].CompK[e0,e1].Comp)
  (p : CTruncHProp[a,l].Proposition[extP G CTrunc[a,l].Truncation[G,A].Ty,B].isProp) {
  module T = CTrunc[a,l].Truncation[G,A] ;
  module K = CTruncFromProp[a,l].Fibrant[extP G T.Ty,B,c,p] ;
  module E = CTruncElim[a,l].Elimination[G,A,B,K.algebra,c] ;
  atInc : PTy[extP G A] = E.atInc ;
  eliminate (b : PEl[extP G A,atInc]) : PEl[extP G T.Ty,B] = E.On[b].section ;
  beta-inc (b : PEl[extP G A,atInc]) (X : Ob) (x : W.Ix (G.ob X)) (v : W.Ix (A.tob X x)) :
    Id (W.Ix (B.tob X (x,T.inclusion.nfun X x v)))
      ((eliminate b).eob X (x,T.inclusion.nfun X x v)) (b.eob X (x,v)) = E.On[b].beta-inc X x v ;
  opaque beta-inc ;
} ;
