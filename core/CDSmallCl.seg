-- CDSmallCl.seg (L8, Delta): the classifier inputs of univalence for Delta
-- (model.tex §8.2, "The classifier of Ext"): ONE horn filling operation on
-- Ext of the universal glue data, by cases on fullness (CDGlueCl: B's own
-- on the extent, box -> horn of Ext_U's composition off it), pulled back
-- along every map into GD (its fibres read in SA by ph / ps):
--
--   elOp / hB    El's horn filling, and B's (El's along bmap)
--   hBig         the universal operation
--   smallCl      along l : D -> GD
--   smallCl-sub  (C1): the moved data have the same values (COp.OpExt)
--
-- Constructive; El's fibration elFib is a parameter (CDeltaElFib).
-- Quarry: seg/model DSmallCl.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module PS = DB.GPre[a].PS ;
module PL = DB.GPre[a+].PS ;
module DCl = CDeltaCl[a] ;
module CL = DCl.CL ;
module DU = DCl.DU ;
module YO = DB.GYon[a] ;

module SC (elFib : DB.CLine[a+].Lines[DU.UCtx, DU.EGen].Fib) {
  module UB = DB.CExtBig.UB[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl] ;
  module XS = DB.CExtSmall.XS[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl, elFib] ;
  module FSB = DB.COp[a+].OpS[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, UB.GDr, UB.ExtBig] ;

  -- El's horn filling, as a filling operation
  elOp : DB.COp[a+].OpS[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, DU.UCtx, DU.EGen].Op =
    \ i o F h -> CDElHorn[a].elFib i.1 i.2 o F h ;

  -- B's: El's along the code map
  module PB = DB.COpMove[a+, a+].Pull[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, UB.CU.resCtx, UB.BU, DU.UCtx, DU.EGen,
    UB.bmap.nt, UB.bmap.nt-nat, \ W x b -> b, \ W x b -> b, \ W x b -> refl b, \ W x b -> refl b,
    DB.CSub[a+].SubE[UB.CU.resCtx, DU.UCtx, UB.bmap, DU.EGen].mV-nat, elOp] ;

  hB : CDHornFib[a, a+].DH[UB.CU.resCtx, UB.BU].isFib = \ m k o rho h -> PB.op (m, k) o rho h ;

  -- Ext's, once, on the universal data
  module GC = CDGlueCl[a, a+].GC[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU, hB, XS.FU.extFibU] ;

  hBig : FSB.Op = \ i o w h -> GC.clExt i.1 i.2 o w h ;

  -- along a map into the universal data
  module PA (D : PS.PCtx) (al : DB.CSmall.XSub[D, UB.GDr]) {
    module SF = DB.CSmall.SmallFib[UB.GDr, XS.SA, D, al] ;
    module P = DB.COpMove[a, a+].Pull[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, D, DB.CSmall.xsub D UB.GDr XS.SA al, UB.GDr, UB.ExtBig,
      al.nt, al.nt-nat, \ W x b -> XS.phS W (al.nt W x) b, \ W x b -> XS.psS W (al.nt W x) b,
      \ W x b -> XS.CM.At[W, al.nt W x].ps-ph b, \ W x b -> XS.CM.At[W, al.nt W x].ph-ps b,
      \ V W g w -> transH (XS.tanat V W g (SF.ta W w)) (apH (XS.ta V) (SF.tanat V W g w)), hBig] ;
  } ;

  smallCl (D : PS.PCtx) (al : DB.CSmall.XSub[D, UB.GDr]) : CL.Cl D (DB.CSmall.xsub D UB.GDr XS.SA al) = PA[D, al].P.op ;

  -- the substitution law: the moved data have the same values
  module Sb (D D' : PS.PCtx) (t : PS.PSub[D', D]) (al : DB.CSmall.XSub[D, UB.GDr]) {
    T1 : PS.PTy[D'] = PS.subTy D' D (DB.CSmall.xsub D UB.GDr XS.SA al) t ;
    al' : DB.CSmall.XSub[D', UB.GDr] = DB.CSmall.xoS D' D UB.GDr al t ;
    T2 : PS.PTy[D'] = DB.CSmall.xsub D' UB.GDr XS.SA al' ;
    module FX = DB.COp[a].OpExt[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, D', T1] ;
    module PPT = DB.CPartial[a].Partials[D', T1] ;

    q : FX.Pack = (T2.tact, (T2.tact-id, T2.tact-o)) ;

    Ht : PS.PtEq D' T1.tob T1.tact q.1 = \ J I f x y e b ->
      DB.CSmall.tact-irr UB.GDr XS.SA J I f (al.nt I (t.nt I x)) (al.nt J (t.nt J y))
        (DB.CSmall.xntEq D UB.GDr al J I f (t.nt I x) (t.nt J y) (PS.ntEq D' D t J I f x y e))
        (DB.CSmall.xntEq D' UB.GDr al' J I f x y e) b ;

    -- the data moved both ways
    hdL (i : DCl.HIx) (rho : W0.Ix (D'.ob (DCl.hOb i))) (v : PPT.PvTy (DCl.hOb i) (DCl.hS i))
      (pp : PPT.PptTy (DCl.hOb i) rho (DCl.hS i) v) (pn : PPT.PnTy (DCl.hOb i) (DCl.hS i) v)
      : FSB.HData i (al'.nt (DCl.hOb i) rho) =
      PA[D, al].P.mv i (t.nt (DCl.hOb i) rho)
        (CL.P[D', D, t, DB.CSmall.xsub D UB.GDr XS.SA al, smallCl D al].Pl.mv i rho (v, (pp, pn))) ;

    hdR (i : DCl.HIx) (rho : W0.Ix (D'.ob (DCl.hOb i))) (v : PPT.PvTy (DCl.hOb i) (DCl.hS i))
      (pp : PPT.PptTy (DCl.hOb i) rho (DCl.hS i) v) (pn : DB.CPartial[a].Partials[D', T2].PnTy (DCl.hOb i) (DCl.hS i) v)
      : FSB.HData i (al'.nt (DCl.hOb i) rho) =
      PA[D', al'].P.mv i rho (v, (pp, pn)) ;

    H : FX.Agree q (CL.clSub D' D t (DB.CSmall.xsub D UB.GDr XS.SA al) (smallCl D al)) (smallCl D' al') =
      \ i o rho v pp pnA pnB ->
        apH {FSB.HData i (al'.nt (DCl.hOb i) rho)} {W0.Ix (XS.S0 (DCl.hOb i) (al'.nt (DCl.hOb i) rho))}
          (\ hd -> XS.psS (DCl.hOb i) (al'.nt (DCl.hOb i) rho) (hBig i o (al'.nt (DCl.hOb i) rho) hd).1)
          (FSB.hd-eq i (al'.nt (DCl.hOb i) rho) (hdL i rho v pp pnA) (hdR i rho v pp pnB) (refl (hdR i rho v pp pnB).1)) ;

    res : Id ((T : PS.PTy[D']) * CL.Cl D' T) (T1, CL.clSub D' D t (DB.CSmall.xsub D UB.GDr XS.SA al) (smallCl D al)) (T2, smallCl D' al') =
      DB.COp[a].OpExtE[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, D'].isOpExt T1
        (CL.clSub D' D t (DB.CSmall.xsub D UB.GDr XS.SA al) (smallCl D al)) q Ht (smallCl D' al') H ;
  } ;

  smallCl-sub (D D' : PS.PCtx) (al : DB.CSmall.XSub[D, UB.GDr]) (t : PS.PSub[D', D])
    : Id ((T : PS.PTy[D']) * CL.Cl D' T)
         (PS.subTy D' D (DB.CSmall.xsub D UB.GDr XS.SA al) t, CL.clSub D' D t (DB.CSmall.xsub D UB.GDr XS.SA al) (smallCl D al))
         (DB.CSmall.xsub D' UB.GDr XS.SA (DB.CSmall.xoS D' D UB.GDr al t), smallCl D' (DB.CSmall.xoS D' D UB.GDr al t)) =
    Sb[D, D', t, al].res ;
} ;
