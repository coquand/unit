-- GPre.seg: the presheaf helpers over the base (inside IvBase); posets:
-- Constr[a].PosB.GPre (the former PreL).
-- From MODEL/Lv/Pre.agda (MODEL/Poset/Pre.agda is its instance at
-- lzero).  Helpers for presheaves over finite non empty posets.
--
-- * PshL[P] : acting along pointwise equal maps, and commuting squares.
-- * TyL[G, B] : the total presheaf E = G.B of a type B over G.  An element
--   b of B at (I , x) is read as the pair (x , b) in E(I).  Equations
--   between elements in different fibres are stated in E: the first
--   components agree automatically, and no transport is needed.
--
-- The posets live at level a, the presheaves at l >= a.  Agda's
-- `open Psh PosetCat public` is the instance PS; users open it too.
-- Stated over a base B : IvBase (segment L).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
module W = V[l] ;


module PS = Presheaf[a, l].Psh[BC] ;
open PS ;

------------------------------------------------------------------------
-- Contexts

module PshL (P : PCtx) {

  Pt (I : Ob) : U l = W.Ix (P.ob I) ;

  -- act along equal maps
  actEq (J I : Ob) (f g : Hom J I) (h : Id (Hom J I) f g) (x : Pt I) : Id (Pt J) (P.act J I f x) (P.act J I g x) =
    ap (Hom J I) (Pt J) (\ f' -> P.act J I f' x) f g h ;

  -- act along a composite
  actC (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : Pt I)
    : Id (Pt K) (P.act K J g (P.act J I f x)) (P.act K I (compH K J I f g) x) =
    sym (Pt K) (P.act K I (compH K J I f g) x) (P.act K J g (P.act J I f x)) (P.act-o K J I f g x) ;

  -- a commuting square:  f g = f' g'  gives  g^* f^* = g'^* f'^*
  actSq (K J J' I : Ob) (f : Hom J I) (g : Hom K J) (f' : Hom J' I) (g' : Hom K J')
    (h : Id (Hom K I) (compH K J I f g) (compH K J' I f' g')) (x : Pt I)
    : Id (Pt K) (P.act K J g (P.act J I f x)) (P.act K J' g' (P.act J' I f' x)) =
    trans (Pt K) (P.act K J g (P.act J I f x)) (P.act K I (compH K J I f g) x) (P.act K J' g' (P.act J' I f' x))
      (actC K J I f g x)
      (trans (Pt K) (P.act K I (compH K J I f g) x) (P.act K I (compH K J' I f' g') x)
                    (P.act K J' g' (P.act J' I f' x))
         (actEq K I (compH K J I f g) (compH K J' I f' g') h x) (P.act-o K J' I f' g' x)) ;

  -- a triangle:  f g = h  gives  g^* f^* = h^*
  actTri (K J I : Ob) (f : Hom J I) (g : Hom K J) (h : Hom K I) (p : Id (Hom K I) (compH K J I f g) h) (x : Pt I)
    : Id (Pt K) (P.act K J g (P.act J I f x)) (P.act K I h x) =
    trans (Pt K) (P.act K J g (P.act J I f x)) (P.act K I (compH K J I f g) x) (P.act K I h x)
      (actC K J I f g x) (actEq K I (compH K J I f g) h p x) ;

  -- the identity
  actId (I : Ob) (f : Hom I I) (p : Id (Hom I I) f (idH I)) (x : Pt I) : Id (Pt I) (P.act I I f x) x =
    trans (Pt I) (P.act I I f x) (P.act I I (idH I) x) x (actEq I I f (idH I) p x) (P.act-id I x) ;
} ;

------------------------------------------------------------------------
-- Types, read in the total presheaf

module TyL (G : PCtx) (B : PTy[G]) {

  E : PCtx = extP G B ;

  Pt (I : Ob) : U l = W.Ix (G.ob I) ;
  T (I : Ob) (x : Pt I) : U l = W.Ix (B.tob I x) ;
  EI (I : Ob) : U l = W.Ix (E.ob I) ;

  coeT (I : Ob) (x y : Pt I) (e : Id (Pt I) x y) (b : T I x) : T I y = subst (Pt I) (\ z -> T I z) x y e b ;

  pr-coe (I : Ob) (x y : Pt I) (e : Id (Pt I) x y) (b : T I x) : Id (EI I) (x, b) (y, coeT I x y e b) =
    idJ (Pt I) x (\ y1 e1 -> Id (EI I) (x, b) (y1, coeT I x y1 e1 b)) (refl (x, b)) y e ;

  pr-tact (J I : Ob) (f : Hom J I) (x : Pt I) (y : Pt J) (e : Id (Pt J) (G.act J I f x) y) (b : T I x)
    : Id (EI J) (E.act J I f (x, b)) (y, B.tact J I f x y e b) = pair-act G B J I f x y e b ;

  -- two elements of the same fibre which are equal in E are equal
  pr-inj (I : Ob) (x : Pt I) (b b' : T I x) (Q : Id (EI I) (x, b) (x, b')) : Id (T I x) b b' =
    trans (T I x) b (subst (Pt I) (\ z -> T I z) x x Qf b) b'
      (ap (Id (Pt I) x x) (T I x) (\ p -> subst (Pt I) (\ z -> T I z) x x p b) (refl x) Qf
          (sym (Id (Pt I) x x) Qf (refl x) (loop-refl (Pt I) (W.isSetIx (G.ob I)) x Qf)))
      (Sigma-snd (Pt I) (\ z -> T I z) x x b b' Q)
   where { Qf : Id (Pt I) x x = ap (EI I) (Pt I) (\ w -> w.1) (x, b) (x, b') Q ; } ;

  -- equality in E, read through a common first component
  pr-eq (I : Ob) (x y : Pt I) (e : Id (Pt I) x y) (b : T I x) (b' : T I y) (Q : Id (EI I) (x, b) (y, b'))
    : Id (T I y) (coeT I x y e b) b' =
    idJ (Pt I) x (\ y1 e1 -> (b1 : T I y1) -> Id (EI I) (x, b) (y1, b1) -> Id (T I y1) (coeT I x y1 e1 b) b1)
        (\ b1 Q1 -> pr-inj I x b b1 Q1) y e b' Q ;

  -- tact, as the action of E
  tactE (J I : Ob) (f : Hom J I) (x : Pt I) (y : Pt J) (e : Id (Pt J) (G.act J I f x) y) (b : T I x)
    : Id (T J y) (B.tact J I f x y e b) (coeT J (G.act J I f x) y e (B.tact J I f x (G.act J I f x) (refl (G.act J I f x)) b)) =
    idJ (Pt J) (G.act J I f x)
      (\ y1 e1 -> Id (T J y1) (B.tact J I f x y1 e1 b)
                              (coeT J (G.act J I f x) y1 e1 (B.tact J I f x (G.act J I f x) (refl (G.act J I f x)) b)))
      (refl (B.tact J I f x (G.act J I f x) (refl (G.act J I f x)) b)) y e ;

  -- an element of E over x, as an element of the fibre at x (locked:
  -- known through fromE-eq)
  fromE (I : Ob) (x : Pt I) (w : EI I) (p : Id (Pt I) w.1 x) : T I x = coeT I w.1 x p w.2 ;

  fromE-eq (I : Ob) (x : Pt I) (w : EI I) (p : Id (Pt I) w.1 x) : Id (EI I) (x, fromE I x w p) w =
    sym (EI I) (w.1, w.2) (x, coeT I w.1 x p w.2) (pr-coe I w.1 x p w.2) ;

  opaque fromE ; opaque fromE-eq ;

  -- Agda's  open PshL E public
  module PE = PshL[E] ;
} ;
