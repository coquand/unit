-- CBoxSq.seg (L9): open boxes of squares (postnikov.tex, Lemma box with
-- k = 2), the test of CBoxFill.  The base is X = [m] * [1], its boundary
-- sieve bdry is the union of the faces d_i [m] * [1] (i <= m) and the two
-- ends [m] * {0}, [m] * {1}.  An open box of Delta[m] * Delta[1] * Delta[1]
-- missing the face {1 - e} in the last coordinate is a prism problem over
-- (X , bdry) at e; CBoxFill fills it.
--
--   SqX[m].bdry, face-lands, end-lands   the sieve and its pieces
--   Sq[...].Fv, Fp, Fn, Fe, Fs           the filled square
--   Sq[...].other                        its free face, at e', a map
--                                        X -> i*A, natural (oN)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module DS = CDeltaBase[a].DS ;
module SP = CPosBase[a].SP ;
module PBs = CPosBase[a] ;
module EZ = CBoxEZ[a] ;

module SqX (m : Nat) {
  X : Ob = prodP (lin m) Iv ;

  module HM = EZ.HLin[m] ;
  module H1 = EZ.HLin[suc zero] ;
  module HP = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, Iv, H1.ht, suc zero, H1.hB, H1.hm, H1.hi] ;

  -- the face i of [m] times [1], and the end e of [1]
  Fm (i : Nat) : Subset X = \ w -> not (eqN (vnum (p1 (lin m) Iv w).1) i) ;
  En (k : Nat) : Subset X = \ w -> eqN (vnum (p2 (lin m) Iv w).1) k ;

  -- a subset holds at (id g) s when it holds at g s
  idg (P : Subset X) (W : Ob) (g : Hom W X) (s : El W) (h : IsT (P (app W X g s))) : IsT (P (app W X (compH W X X (idH X) g) s)) =
    substH {El X} (\ w -> IsT (P w)) (symH (el-eq X (app W X (compH W X X (idH X) g) s) (app W X g s) (transH (app-compH1 W X X (idH X) g s) (app-idH1 X (app W X g s))))) h ;

  faces : SP.Phi X = SP.bigU X (suc m) (\ k -> PBs.subS X X (idH X) (Fm k.1)) ;
  ends : SP.Phi X = SP.unionS X (PBs.subS X X (idH X) (En zero)) (PBs.subS X X (idH X) (En (suc zero))) ;
  bdry : SP.Phi X = SP.unionS X faces ends ;

  face-lands (W : Ob) (g : Hom W X) (i : Nat) (hi : IsT (leb i m))
    (ms : (s : El W) -> IsT (not (eqN (vnum (p1 (lin m) Iv (app W X g s)).1) i))) : SP.Lands W X bdry g =
    SP.lands-union-l W X faces ends g
      (SP.bigU-in W X (suc m) (\ k -> PBs.subS X X (idH X) (Fm k.1)) g (i, hi)
         (PBs.isIn-complete W X (compH W X X (idH X) g) (Fm i) (\ s -> idg (Fm i) W g s (ms s)))) ;

  end0-lands (W : Ob) (g : Hom W X) (p : (s : El W) -> IsT (eqN (vnum (p2 (lin m) Iv (app W X g s)).1) zero))
    : SP.Lands W X bdry g =
    SP.lands-union-r W X faces ends g
      (SP.lands-union-l W X (PBs.subS X X (idH X) (En zero)) (PBs.subS X X (idH X) (En (suc zero))) g
         (PBs.isIn-complete W X (compH W X X (idH X) g) (En zero) (\ s -> idg (En zero) W g s (p s)))) ;

  end1-lands (W : Ob) (g : Hom W X) (p : (s : El W) -> IsT (eqN (vnum (p2 (lin m) Iv (app W X g s)).1) (suc zero)))
    : SP.Lands W X bdry g =
    SP.lands-union-r W X faces ends g
      (SP.lands-union-r W X (PBs.subS X X (idH X) (En zero)) (PBs.subS X X (idH X) (En (suc zero))) g
         (PBs.isIn-complete W X (compH W X X (idH X) g) (En (suc zero)) (\ s -> idg (En (suc zero)) W g s (p s)))) ;
} ;

-- the square filled from the open box missing its face at e'
module Sq (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G])
  (hf : CDHornFib[a, l].DH[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA].isFib)
  (m : Nat) (x : W0.Ix (G.ob (prodP (lin m) Iv)))
  (a0 : (W : Nat) -> Hom (lin W) (prodP (lin m) Iv) -> PB.GPre[l].TyL[G, A].EI (lin W))
  (a0p : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) -> Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) (prodP (lin m) Iv) g x))
  (a0n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m) Iv))
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (a0 W g))
                                                  (a0 V (compH (lin V) (lin W) (prodP (lin m) Iv) g h)))
  (sv : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) -> SP.Lands (lin W) (prodP (lin m) Iv) SqX[m].bdry g
        -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (svp : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (i : SP.Lands (lin W) (prodP (lin m) Iv) SqX[m].bdry g) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (sv W g i j).1 (G.act (lin W) (prodP (lin m) Iv) g x))
  (svn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m) Iv)) (i : SP.Lands (lin W) (prodP (lin m) Iv) SqX[m].bdry g)
         (i' : SP.Lands (lin V) (prodP (lin m) Iv) SqX[m].bdry (compH (lin V) (lin W) (prodP (lin m) Iv) g h)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (sv W g i j))
                                                  (sv V (compH (lin V) (lin W) (prodP (lin m) Iv) g h) i' (compH (lin V) (lin W) Iv j h)))
  (sve : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (i : SP.Lands (lin W) (prodP (lin m) Iv) SqX[m].bdry g)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (sv W g i (constH (lin W) Iv e0)) (a0 W g)) {
  module S = SqX[m] ;
  module RG = CLocRestr[a, l].R[G] ;
  module FT = CDFill[a, l].FT[RG.iG, RG.T[A].iA, hf] ;
  module TA = PB.GPre[l].TyL[G, A] ;

  -- from the lid at 0 (CDFill.FT)
  module F = CBoxFill[a, l].BF[G, A, e0, FT.S.fill, FT.S.sides, FT.S.face,
    S.X, S.HP.ht, S.HP.B, S.HP.hB, S.HP.hm, S.HP.hi, x, a0, a0p, a0n, S.bdry, sv, svp, svn, sve] ;

  -- the free face, at 1
  other (W : Nat) (g : Hom (lin W) S.X) : TA.EI (lin W) = F.Fv W g (constH (lin W) Iv e1) ;

  oP (W : Nat) (g : Hom (lin W) S.X) : Id (W0.Ix (G.ob (lin W))) (other W g).1 (G.act (lin W) S.X g x) = F.Fp W g (constH (lin W) Iv e1) ;

  oN (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) S.X)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (other W g)) (other V (compH (lin V) (lin W) S.X g h)) =
    transH (F.Fn V W h g (constH (lin W) Iv e1))
           (apH (F.Fv V (compH (lin V) (lin W) S.X g h)) (constH-nat (lin V) (lin W) h e1)) ;

  -- the free face agrees with the sides on the boundary of X
  oS (W : Nat) (g : Hom (lin W) S.X) (i : SP.Lands (lin W) S.X S.bdry g)
    : Id (TA.EI (lin W)) (other W g) (sv W g i (constH (lin W) Iv e1)) = F.Fs W g i (constH (lin W) Iv e1) ;
} ;
