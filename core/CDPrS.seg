-- CDPrS.seg (L8, Delta): seg/model DPrS.seg ported (module names only).  Was: decidable sieves of the prism y[N] * Delta[1] (generalised
-- points (f , j) : [W] -> [N] * [1]): a Boolean predicate closed under
-- precomposition (PrS), and the union with a closed predicate (unionPr).
-- At level a: they only talk about maps of Delta.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;

------------------------------------------------------------------------
-- decidable sieves of the prism

PrClos (N : Nat) (P : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> Bool) : U a =
  (W' W : Nat) (g : Hom (lin W') (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
  -> IsT (P W f j) -> IsT (P W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g)) ;

PrS (N : Nat) : U a = (P : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> Bool) * PrClos N P ;

-- the union of a prism sieve with a predicate closed under precomposition
unionPr (N : Nat) (S : PrS N) (M : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> Bool) (Mc : PrClos N M) : PrS N =
  (\ W f j -> or (S.1 W f j) (M W f j),
   \ W' W g f j i -> or-elim (IsT (or (S.1 W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g))
                                      (M W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g))))
                      (S.1 W f j) (M W f j) i
       (\ s -> or-l (S.1 W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g))
                    (M W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g)) (S.2 W' W g f j s))
       (\ s -> or-r (S.1 W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g))
                    (M W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g)) (Mc W' W g f j s))) ;

