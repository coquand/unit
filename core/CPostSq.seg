-- CPostSq.seg (L9): the open box of a square over a simplex (postnikov.tex,
-- Theorem conv, steps 2 and 3), for any type B with face-uniform fillers
-- at the end e (CDFill).
--
-- Over [m] * [1]_t, with the line s of the filling:
--
--   L W g j        the lid at s = e, a prism [m] * [1]_t -> i*B
--   psi            the edge t = 0 (constant in s)
--   Pl W g         the edge t = 1, a prism [m] * [1]_s -> i*B
--   L0 , L1        the corners: L at t = 0 is psi, at t = 1 is Pl at s = e
--   Th y           (m = m' + 1) the sides: squares over the faces, with
--                  Th-e (L on the face at s = e), Th-t0 (psi), Th-t1 (Pl on
--                  the face) and FFt (two faces agree where they meet)
--
-- SqE: the lid and the end data (the sieve QY = the two ends of [1]_t);
-- SqS (m = m' + 1) and SqZ (m = 0) fill the box (CBoxFill, sides
-- CPostBdry): the square Thf with its edges Thf-e , Thf-t0 , Thf-t1 and
-- faces Thf-face, and the prism H' = Thf at s = e' (HT).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module S1m = CPostStep1[a, l] ;

-- the two ends of [1], and the end sieve of [m] * [1] (top level: no
-- instance data)
QYsq : SP.Phi Iv = SP.unionS Iv (PBs.sptS e0) (PBs.sptS e1) ;

module EndSq (m : Nat) {
  endS : SP.Phi (prodP (lin m) Iv) = SP.pre (prodP (lin m) Iv) Iv (pr2 (lin m) Iv) QYsq ;
} ;

module SqE (G : PP.PCtx) (B : PP.PTy[G]) (m : Nat) (xf : W0.Ix (G.ob (lin m))) (e : El Iv)
  (psi : PB.GPre[l].TyL[G, B].EI (lin m)) (psi-pt : Id (W0.Ix (G.ob (lin m))) psi.1 xf)
  (L : (W : Nat) -> Hom (lin W) (lin m) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L W g j).1 (G.act (lin W) (lin m) g xf))
  (Ln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L W g j))
              (L V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl : (W : Nat) -> Hom (lin W) (prodP (lin m) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl W g).1 (G.act (lin W) (prodP (lin m) Iv) g (G.act (prodP (lin m) Iv) (lin m) (pr1 (lin m) Iv) xf)))
  (Pln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl W g))
               (Pl V (compH (lin V) (lin W) (prodP (lin m) Iv) g h)))
  (L0 : (W : Nat) (g : Hom (lin W) (lin m))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin m) g psi))
  (L1 : (W : Nat) (g : Hom (lin W) (lin m))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e1)) (Pl W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e)))) {
  module TB = PB.GPre[l].TyL[G, B] ;
  module GL = PB.GPre[l].PshL[G] ;

  module BX = BD.BXm[m, Iv] ;
  module HM = EZ.HLin[m] ;
  module H1v = EZ.HLin[suc zero] ;
  module HP = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, Iv, H1v.ht, suc zero, H1v.hB, H1v.hm, H1v.hi] ;
  xB : W0.Ix (G.ob BX.XB) = G.act BX.XB (lin m) BX.p1B xf ;

  p1g (W : Nat) (g : Hom (lin W) BX.XB) : Hom (lin W) (lin m) = compH (lin W) BX.XB (lin m) (pr1 (lin m) Iv) g ;
  p2g (W : Nat) (g : Hom (lin W) BX.XB) : Hom (lin W) Iv = compH (lin W) BX.XB Iv (pr2 (lin m) Iv) g ;

  ctxPair (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob (lin W))) (G.act (lin W) BX.XB (pairH (lin m) Iv (lin W) a j) xB) (G.act (lin W) (lin m) a xf) =
    transH (GL.actC (lin W) BX.XB (lin m) BX.p1B (pairH (lin m) Iv (lin W) a j) xf)
           (apH (\ k -> G.act (lin W) (lin m) k xf) (pr1-pair (lin m) Iv (lin W) a j)) ;

  ----------------------------------------------------------------------
  -- the lid at s = e

  a0 (W : Nat) (g : Hom (lin W) BX.XB) : TB.EI (lin W) = L W (p1g W g) (p2g W g) ;

  a0p (W : Nat) (g : Hom (lin W) BX.XB) : Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) BX.XB g xB) =
    transH (Lp W (p1g W g) (p2g W g)) (symH (GL.actC (lin W) BX.XB (lin m) BX.p1B g xf)) ;

  a0n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) BX.XB g h)) =
    transH (Ln V W h (p1g W g) (p2g W g))
      (transH (apH (\ k -> L V k (compH (lin V) (lin W) Iv (p2g W g) h)) (comp-assoc (lin V) (lin W) BX.XB (lin m) BX.p1B g h))
              (apH (L V (p1g V (compH (lin V) (lin W) BX.XB g h))) (comp-assoc (lin V) (lin W) BX.XB Iv (pr2 (lin m) Iv) g h))) ;

  ----------------------------------------------------------------------
  -- the end data: psi at t = 0, Pl at t = 1

  module ES = EndSq[m] ;

  EvC (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
    : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)) -> TB.EI (lin W) = split {
    inl i -> TB.E.act (lin W) (lin m) (p1g W g) psi ;
    inr i -> Pl W (pairH (lin m) Iv (lin W) (p1g W g) j) } ;

  cut (W : Nat) (g : Hom (lin W) BX.XB) (b : SP.Lands (lin W) BX.XB ES.endS g)
    : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)) =
    SP.union-lands (lin W) Iv (PBs.sptS e0) (PBs.sptS e1) (p2g W g) b ;

  Ev (W : Nat) (g : Hom (lin W) BX.XB) (b : SP.Lands (lin W) BX.XB ES.endS g) (j : Hom (lin W) Iv) : TB.EI (lin W) =
    EvC W g j (cut W g b) ;

  -- the value at t = 0, t = 1, whatever the case
  EvC-0 (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv) (i0 : SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g))
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)))
    -> Id (TB.EI (lin W)) (EvC W g j cc) (TB.E.act (lin W) (lin m) (p1g W g) psi) = split {
    inl i -> refl (TB.E.act (lin W) (lin m) (p1g W g) psi) ;
    inr i -> absurd _ (PBs.spt-disj (lin W) (p2g W g) i0 i) } ;

  EvC-1 (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv) (i1 : SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g))
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)))
    -> Id (TB.EI (lin W)) (EvC W g j cc) (Pl W (pairH (lin m) Iv (lin W) (p1g W g) j)) = split {
    inl i -> absurd _ (PBs.spt-disj (lin W) (p2g W g) i i1) ;
    inr i -> refl (Pl W (pairH (lin m) Iv (lin W) (p1g W g) j)) } ;

  EvpC (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)))
    -> Id (W0.Ix (G.ob (lin W))) (EvC W g j cc).1 (G.act (lin W) BX.XB g xB) = split {
    inl i -> transH (apH (G.act (lin W) (lin m) (p1g W g)) psi-pt) (symH (GL.actC (lin W) BX.XB (lin m) BX.p1B g xf)) ;
    inr i -> transH (Plp W (pairH (lin m) Iv (lin W) (p1g W g) j))
               (transH (ctxPair W (p1g W g) j) (symH (GL.actC (lin W) BX.XB (lin m) BX.p1B g xf))) } ;

  -- restricting the pieces
  p1h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB)
    : Id (Hom (lin V) (lin m)) (compH (lin V) (lin W) (lin m) (p1g W g) h) (p1g V (compH (lin V) (lin W) BX.XB g h)) =
    comp-assoc (lin V) (lin W) BX.XB (lin m) BX.p1B g h ;

  p2h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB)
    : Id (Hom (lin V) Iv) (compH (lin V) (lin W) Iv (p2g W g) h) (p2g V (compH (lin V) (lin W) BX.XB g h)) =
    comp-assoc (lin V) (lin W) BX.XB Iv (pr2 (lin m) Iv) g h ;

  l0h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB) (e' : El Iv) (i : SP.Lands (lin W) Iv (PBs.sptS e') (p2g W g))
    : SP.Lands (lin V) Iv (PBs.sptS e') (p2g V (compH (lin V) (lin W) BX.XB g h)) =
    PBs.slands-hom (lin V) Iv (PBs.sptS e') _ _ (p2h V W h g) (SP.lands-comp (lin V) (lin W) Iv (PBs.sptS e') (p2g W g) h i) ;

  EvnC (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)))
      (cc' : Plus (SP.Lands (lin V) Iv (PBs.sptS e0) (p2g V (compH (lin V) (lin W) BX.XB g h)))
                  (SP.Lands (lin V) Iv (PBs.sptS e1) (p2g V (compH (lin V) (lin W) BX.XB g h))))
    -> Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (EvC W g j cc)) (EvC V (compH (lin V) (lin W) BX.XB g h) (compH (lin V) (lin W) Iv j h) cc') = split {
    inl i -> split {
      inl i' -> transH (TB.PE.actC (lin V) (lin W) (lin m) (p1g W g) h psi)
                  (TB.PE.actEq (lin V) (lin m) _ _ (p1h V W h g) psi) ;
      inr i' -> absurd _ (PBs.spt-disj (lin V) (p2g V (compH (lin V) (lin W) BX.XB g h)) (l0h V W h g e0 i) i') } ;
    inr i -> split {
      inl i' -> absurd _ (PBs.spt-disj (lin V) (p2g V (compH (lin V) (lin W) BX.XB g h)) i' (l0h V W h g e1 i)) ;
      inr i' -> transH (Pln V W h (pairH (lin m) Iv (lin W) (p1g W g) j))
                  (apH (Pl V)
                     (transH (BD.pair-h (lin m) Iv (lin V) (lin W) (p1g W g) j h)
                             (apH (\ k -> pairH (lin m) Iv (lin V) k (compH (lin V) (lin W) Iv j h)) (p1h V W h g)))) } } ;

  -- at s = e the end data are the lid
  aEC (W : Nat) (g : Hom (lin W) BX.XB)
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (p2g W g)))
    -> Id (TB.EI (lin W)) (EvC W g (constH (lin W) Iv e) cc) (a0 W g) = split {
    inl i -> transH (symH (L0 W (p1g W g))) (apH (L W (p1g W g)) (symH (PBs.slands-pt (lin W) e0 (p2g W g) i))) ;
    inr i -> transH (symH (L1 W (p1g W g))) (apH (L W (p1g W g)) (symH (PBs.slands-pt (lin W) e1 (p2g W g) i))) } ;

  -- the pair (g , e') lands at the end e'
  pe-lands (W : Nat) (g : Hom (lin W) (lin m)) (e' : El Iv)
    : SP.Lands (lin W) Iv (PBs.sptS e') (p2g W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e'))) =
    PBs.slands-hom (lin W) Iv (PBs.sptS e') (constH (lin W) Iv e') _ (symH (pr2-pair (lin m) Iv (lin W) g (constH (lin W) Iv e')))
      (PBs.spt-lands (lin W) e') ;

  end-lands0 (W : Nat) (g : Hom (lin W) (lin m)) : SP.Lands (lin W) BX.XB ES.endS (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) =
    SP.lands-union-l (lin W) Iv (PBs.sptS e0) (PBs.sptS e1) _ (pe-lands W g e0) ;

  end-lands1 (W : Nat) (g : Hom (lin W) (lin m)) : SP.Lands (lin W) BX.XB ES.endS (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) =
    SP.lands-union-r (lin W) Iv (PBs.sptS e0) (PBs.sptS e1) _ (pe-lands W g e1) ;

  ----------------------------------------------------------------------
  -- the prism at s = e' of a filled square

  module HT (Thf : (W : Nat) -> Hom (lin W) BX.XB -> Hom (lin W) Iv -> TB.EI (lin W))
    (Thf-p : (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) BX.XB g xB))
    (Thf-n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
             -> Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) BX.XB g h) (compH (lin V) (lin W) Iv j h)))
    (Thf-t0 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TB.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j) (TB.E.act (lin W) (lin m) g psi))
    (Thf-t1 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TB.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j) (Pl W (pairH (lin m) Iv (lin W) g j)))
    (e' : El Iv) {

    H' (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TB.EI (lin W) =
      Thf W (pairH (lin m) Iv (lin W) g j) (constH (lin W) Iv e') ;

    H'p (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (H' W g j).1 (G.act (lin W) (lin m) g xf) =
      transH (Thf-p W (pairH (lin m) Iv (lin W) g j) (constH (lin W) Iv e')) (ctxPair W g j) ;

    H'n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (H' W g j)) (H' V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)) =
      transH (Thf-n V W h (pairH (lin m) Iv (lin W) g j) (constH (lin W) Iv e'))
        (transH (apH (\ k -> Thf V k (compH (lin V) (lin W) Iv (constH (lin W) Iv e') h)) (BD.pair-h (lin m) Iv (lin V) (lin W) g j h))
                (apH (Thf V (pairH (lin m) Iv (lin V) (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h))) (BD.const-h (lin V) (lin W) h e'))) ;

    H'0 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TB.EI (lin W)) (H' W g (constH (lin W) Iv e0)) (TB.E.act (lin W) (lin m) g psi) =
      Thf-t0 W g (constH (lin W) Iv e') ;

    H'1 (W : Nat) (g : Hom (lin W) (lin m))
      : Id (TB.EI (lin W)) (H' W g (constH (lin W) Iv e1)) (Pl W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e'))) =
      Thf-t1 W g (constH (lin W) Iv e') ;

    opaque H'p ; opaque H'n ;
  } ;
  opaque EvnC ; opaque aEC ;
} ;

------------------------------------------------------------------------
-- m = m' + 1: the box with its sides

module SqS (G : PP.PCtx) (B : PP.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : CDeltaBase[a].DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].resP N' (suc N') (dl N' y) b)))
  (m' : Nat) (xf : W0.Ix (G.ob (lin (suc m'))))
  (psi : PB.GPre[l].TyL[G, B].EI (lin (suc m'))) (psi-pt : Id (W0.Ix (G.ob (lin (suc m')))) psi.1 xf)
  (L : (W : Nat) -> Hom (lin W) (lin (suc m')) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp : (W : Nat) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L W g j).1 (G.act (lin W) (lin (suc m')) g xf))
  (Ln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L W g j))
              (L V (compH (lin V) (lin W) (lin (suc m')) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl : (W : Nat) -> Hom (lin W) (prodP (lin (suc m')) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl W g).1
               (G.act (lin W) (prodP (lin (suc m')) Iv) g (G.act (prodP (lin (suc m')) Iv) (lin (suc m')) (pr1 (lin (suc m')) Iv) xf)))
  (Pln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl W g))
               (Pl V (compH (lin V) (lin W) (prodP (lin (suc m')) Iv) g h)))
  (L0 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin (suc m')) g psi))
  (L1 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e1)) (Pl W (pairH (lin (suc m')) Iv (lin W) g (constH (lin W) Iv e))))
  (Th : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Iv) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Thp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Th y hy W g j).1
               (G.act (lin W) (prodP (lin m') Iv) g
                  (G.act (prodP (lin m') Iv) (prodP (lin (suc m')) Iv) (BD.BG[m', Iv].dY y)
                     (G.act (prodP (lin (suc m')) Iv) (lin (suc m')) (pr1 (lin (suc m')) Iv) xf))))
  (Thn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Th y hy W g j))
               (Th y hy V (compH (lin V) (lin W) (prodP (lin m') Iv) g h) (compH (lin V) (lin W) Iv j h)))
  (Th-e : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv))
          -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W g (constH (lin W) Iv e))
                (L W (compH (lin W) (lin m') (lin (suc m')) (dl m' y) (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g))
                     (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)))
  (Th-t0 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                 (PB.GPre[l].TyL[G, B].E.act (lin W) (lin (suc m')) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) psi))
  (Th-t1 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                 (Pl W (pairH (lin (suc m')) Iv (lin W) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) j)))
  (FFt : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
         (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         (msy : Miss (lin W) m' y (BD.BG[m', Iv].p1g W g)) (msz : Miss (lin W) m' z (BD.BG[m', Iv].p1g W g)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W (BD.BG[m', Iv].gy y W g) j) (Th z hz W (BD.BG[m', Iv].gy z W g) j)) {
  m : Nat = suc m' ;
  module TB = PB.GPre[l].TyL[G, B] ;
  module E = SqE[G, B, suc m', xf, e, psi, psi-pt, L, Lp, Ln, Pl, Plp, Pln, L0, L1] ;
  module BG = BD.BG[m', Iv] ;
  Xf : Ob = BG.Xf ;

  -- the face y of g, read in [m'] * [1]
  pr1gy (y W : Nat) (g : Hom (lin W) E.BX.XB)
    : Id (Hom (lin W) (lin m')) (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) (BG.gy y W g)) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) =
    pr1-pair (lin m') Iv (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (BG.p2g W g) ;

  pr2gy (y W : Nat) (g : Hom (lin W) E.BX.XB) : Id (Hom (lin W) Iv) (compH (lin W) Xf Iv (pr2 (lin m') Iv) (BG.gy y W g)) (BG.p2g W g) =
    pr2-pair (lin m') Iv (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (BG.p2g W g) ;

  gy-end (y W : Nat) (g : Hom (lin W) E.BX.XB) (e' : El Iv) (pe : Id (Hom (lin W) Iv) (BG.p2g W g) (constH (lin W) Iv e'))
    : Id (Hom (lin W) Xf) (BG.gy y W g) (pairH (lin m') Iv (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) (constH (lin W) Iv e')) =
    apH (pairH (lin m') Iv (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g))) pe ;

  dldg (y W : Nat) (hy : IsT (leb y m)) (g : Hom (lin W) E.BX.XB) (ms : Miss (lin W) m' y (BG.p1g W g))
    : Id (Hom (lin W) (lin m)) (compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g))) (BG.p1g W g) =
    hom-eq (lin W) (lin m) _ _ (pw-factor (lin W) m' y (BG.p1g W g) hy ms) ;

  FEC (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) E.BX.XB) (ms : Miss (lin W) m' y (BG.p1g W g)) (j : Hom (lin W) Iv)
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (BG.p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (BG.p2g W g)))
    -> Id (TB.EI (lin W)) (Th y hy W (BG.gy y W g) j) (E.EvC W g j cc) = split {
    inl i -> transH (apH (\ k -> Th y hy W k j) (gy-end y W g e0 (PBs.slands-pt (lin W) e0 (BG.p2g W g) i)))
               (transH (Th-t0 y hy W (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) j)
                       (TB.PE.actEq (lin W) (lin m) _ _ (dldg y W hy g ms) psi)) ;
    inr i -> transH (apH (\ k -> Th y hy W k j) (gy-end y W g e1 (PBs.slands-pt (lin W) e1 (BG.p2g W g) i)))
               (transH (Th-t1 y hy W (compH (lin W) (lin m) (lin m') (dgH m' y) (BG.p1g W g)) j)
                       (apH (\ k -> Pl W (pairH (lin m) Iv (lin W) k j)) (dldg y W hy g ms))) } ;

  module BSm = BD.BS[G, B, m', Iv, QYsq, E.xB, Th, Thp, Thn, E.Ev,
    \ W g b j -> E.EvpC W g j (E.cut W g b),
    \ V W h g b b' j -> E.EvnC V W h g j (E.cut W g b) (E.cut V (compH (lin V) (lin W) E.BX.XB g h) b'),
    FFt,
    \ y hy W g ms b j -> FEC y hy W g ms j (E.cut W g b)] ;

  -- the sides start at the lid
  aF (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) E.BX.XB) (ms : Miss (lin W) m' y (BG.p1g W g))
    : Id (TB.EI (lin W)) (Th y hy W (BG.gy y W g) (constH (lin W) Iv e)) (E.a0 W g) =
    transH (Th-e y hy W (BG.gy y W g))
      (transH (apH (\ k -> L W (compH (lin W) (lin m') (lin m) (dl m' y) k) (compH (lin W) Xf Iv (pr2 (lin m') Iv) (BG.gy y W g))) (pr1gy y W g))
        (transH (apH (\ k -> L W k (compH (lin W) Xf Iv (pr2 (lin m') Iv) (BG.gy y W g))) (dldg y W hy g ms))
                (apH (L W (BG.p1g W g)) (pr2gy y W g)))) ;

  module LidM = BSm.Lid[e, E.a0, aF, \ W g b -> E.aEC W g (E.cut W g b)] ;

  module Bx = CBoxFill[a, l].BF[G, B, e, fill, sides, face,
    E.BX.XB, E.HP.ht, E.HP.B, E.HP.hB, E.HP.hm, E.HP.hi, E.xB, E.a0, E.a0p, E.a0n, BSm.Q, BSm.sv, BSm.svp, BSm.svn, LidM.sve] ;

  ----------------------------------------------------------------------
  -- the filled square and its edges

  Thf (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : TB.EI (lin W) = Bx.Fv W g j ;

  Thf-p (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) E.BX.XB g E.xB) = Bx.Fp W g j ;

  Thf-n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) E.BX.XB g h) (compH (lin V) (lin W) Iv j h)) =
    Bx.Fn V W h g j ;

  Thf-e (W : Nat) (g : Hom (lin W) E.BX.XB) : Id (TB.EI (lin W)) (Thf W g (constH (lin W) Iv e)) (L W (E.p1g W g) (E.p2g W g)) = Bx.Fe W g ;

  Thf-t0 (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j) (TB.E.act (lin W) (lin m) g psi) =
    transH (Bx.Fs W _ (SP.lands-union-r (lin W) E.BX.XB BG.facesS (BG.endS QYsq) _ (E.end-lands0 W g)) j)
      (transH (BSm.sv-E W _ (SP.lands-union-r (lin W) E.BX.XB BG.facesS (BG.endS QYsq) _ (E.end-lands0 W g)) (E.end-lands0 W g) j)
        (transH (E.EvC-0 W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j (E.pe-lands W g e0) (E.cut W _ (E.end-lands0 W g)))
                (TB.PE.actEq (lin W) (lin m) _ _ (pr1-pair (lin m) Iv (lin W) g (constH (lin W) Iv e0)) psi))) ;

  Thf-t1 (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j) (Pl W (pairH (lin m) Iv (lin W) g j)) =
    transH (Bx.Fs W _ (SP.lands-union-r (lin W) E.BX.XB BG.facesS (BG.endS QYsq) _ (E.end-lands1 W g)) j)
      (transH (BSm.sv-E W _ (SP.lands-union-r (lin W) E.BX.XB BG.facesS (BG.endS QYsq) _ (E.end-lands1 W g)) (E.end-lands1 W g) j)
        (transH (E.EvC-1 W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j (E.pe-lands W g e1) (E.cut W _ (E.end-lands1 W g)))
                (apH (\ k -> Pl W (pairH (lin m) Iv (lin W) k j)) (pr1-pair (lin m) Iv (lin W) g (constH (lin W) Iv e1))))) ;

  -- on the face y it is Th y
  Thf-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W (compH (lin W) Xf E.BX.XB (BG.dY y) g) j) (Th y hy W g j) =
    transH (Bx.Fs W gd li j)
      (transH (BSm.sv-F y hy W gd li ms j)
              (apH (\ k -> Th y hy W k j)
                 (BD.pair-ext (lin m') Iv (lin W) (BG.gy y W gd) g
                    (transH (pr1gy y W gd)
                      (transH (apH (compH (lin W) (lin m) (lin m') (dgH m' y)) p1d)
                        (transH (symH (comp-assoc (lin W) (lin m') (lin m) (lin m') (dgH m' y) (dl m' y) (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) g)))
                          (transH (apH (\ k -> compH (lin W) (lin m') (lin m') k (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) g))
                                     (hom-eq (lin m') (lin m') _ _ (pw-dg-dl m' y hy)))
                                  (comp-idl (lin W) (lin m') (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) g))))))
                    (transH (pr2gy y W gd)
                      (transH (symH (comp-assoc (lin W) Xf E.BX.XB Iv (pr2 (lin m) Iv) (BG.dY y) g))
                              (apH (\ k -> compH (lin W) Xf Iv k g) (BG.pr2-dY y)))))))
   where { gd : Hom (lin W) E.BX.XB = compH (lin W) Xf E.BX.XB (BG.dY y) g ;
           p1d : Id (Hom (lin W) (lin m)) (BG.p1g W gd) (compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) g)) =
             transH (symH (comp-assoc (lin W) Xf E.BX.XB (lin m) E.BX.p1B (BG.dY y) g))
               (transH (apH (\ k -> compH (lin W) Xf (lin m) k g) (BG.pr1-dY y))
                       (comp-assoc (lin W) Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Iv) g)) ;
           ms : Miss (lin W) m' y (BG.p1g W gd) =
             substH {Hom (lin W) (lin m)} (\ k -> Miss (lin W) m' y k) (symH p1d) (S1m.dl-miss m' y W (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) g)) ;
           li : SP.Lands (lin W) E.BX.XB BSm.Q gd = SP.lands-union-l (lin W) E.BX.XB BG.facesS (BG.endS QYsq) gd (BG.in-faces W gd y hy ms) ; } ;

  ----------------------------------------------------------------------
  -- the prism at s = e'

  module HT (e' : El Iv) {
    module HH = E.HT[Thf, Thf-p, Thf-n, Thf-t0, Thf-t1, e'] ;

    -- on the face y, it is Th y at s = e'
    H'-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
      : Id (TB.EI (lin W)) (HH.H' W (compH (lin W) (lin m') (lin m) (dl m' y) g) j)
                           (Th y hy W (pairH (lin m') Iv (lin W) g j) (constH (lin W) Iv e')) =
      transH (apH (\ k -> Thf W k (constH (lin W) Iv e'))
                (transH (apH (pairH (lin m) Iv (lin W) (compH (lin W) (lin m') (lin m) (dl m' y) g)) (symH (comp-idl (lin W) Iv j)))
                        (symH (BD.cross-pair (lin m') (lin m) Iv Iv (lin W) (dl m' y) (idH Iv) g j))))
             (Thf-face y hy W (pairH (lin m') Iv (lin W) g j) (constH (lin W) Iv e')) ;
  } ;
  opaque Thf-t0 ; opaque Thf-t1 ; opaque Thf-face ;
} ;

------------------------------------------------------------------------
-- m = 0: the box has the ends only

module SqZ (G : PP.PCtx) (B : PP.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : CDeltaBase[a].DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].resP N' (suc N') (dl N' y) b)))
  (xf : W0.Ix (G.ob (lin zero)))
  (psi : PB.GPre[l].TyL[G, B].EI (lin zero)) (psi-pt : Id (W0.Ix (G.ob (lin zero))) psi.1 xf)
  (L : (W : Nat) -> Hom (lin W) (lin zero) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp : (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L W g j).1 (G.act (lin W) (lin zero) g xf))
  (Ln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L W g j))
              (L V (compH (lin V) (lin W) (lin zero) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl : (W : Nat) -> Hom (lin W) (prodP (lin zero) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl W g).1
               (G.act (lin W) (prodP (lin zero) Iv) g (G.act (prodP (lin zero) Iv) (lin zero) (pr1 (lin zero) Iv) xf)))
  (Pln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin zero) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl W g))
               (Pl V (compH (lin V) (lin W) (prodP (lin zero) Iv) g h)))
  (L0 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin zero) g psi))
  (L1 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e1)) (Pl W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e)))) {
  module TB = PB.GPre[l].TyL[G, B] ;
  module E = SqE[G, B, zero, xf, e, psi, psi-pt, L, Lp, Ln, Pl, Plp, Pln, L0, L1] ;

  module Bx = CBoxFill[a, l].BF[G, B, e, fill, sides, face,
    E.BX.XB, E.HP.ht, E.HP.B, E.HP.hB, E.HP.hm, E.HP.hi, E.xB, E.a0, E.a0p, E.a0n, E.ES.endS, E.Ev,
    \ W g i j -> E.EvpC W g j (E.cut W g i),
    \ V W h g i i' j -> E.EvnC V W h g j (E.cut W g i) (E.cut V (compH (lin V) (lin W) E.BX.XB g h) i'),
    \ W g i -> E.aEC W g (E.cut W g i)] ;

  Thf (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : TB.EI (lin W) = Bx.Fv W g j ;

  Thf-e (W : Nat) (g : Hom (lin W) E.BX.XB) : Id (TB.EI (lin W)) (Thf W g (constH (lin W) Iv e)) (L W (E.p1g W g) (E.p2g W g)) = Bx.Fe W g ;

  Thf-t0 (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e0)) j) (TB.E.act (lin W) (lin zero) g psi) =
    transH (Bx.Fs W _ (E.end-lands0 W g) j)
      (transH (E.EvC-0 W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e0)) j (E.pe-lands W g e0) (E.cut W _ (E.end-lands0 W g)))
              (TB.PE.actEq (lin W) (lin zero) _ _ (pr1-pair (lin zero) Iv (lin W) g (constH (lin W) Iv e0)) psi)) ;

  Thf-t1 (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (Thf W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e1)) j) (Pl W (pairH (lin zero) Iv (lin W) g j)) =
    transH (Bx.Fs W _ (E.end-lands1 W g) j)
      (transH (E.EvC-1 W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e1)) j (E.pe-lands W g e1) (E.cut W _ (E.end-lands1 W g)))
              (apH (\ k -> Pl W (pairH (lin zero) Iv (lin W) k j)) (pr1-pair (lin zero) Iv (lin W) g (constH (lin W) Iv e1)))) ;

  module HT (e' : El Iv) {
    module HH = E.HT[Thf, Bx.Fp, Bx.Fn, Thf-t0, Thf-t1, e'] ;
  } ;
  opaque Thf-t0 ; opaque Thf-t1 ;
} ;
