-- CSmallSub.seg (L4, inside CB): (C1) in general (model.tex Construction
-- "universal univalence datum" (C1)): a small type along a code map l,
-- with its moved fibration, substituted along t, is the small type along
-- l t with its moved fibration (the move laws, CCartLaws2, and fibExt).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L1 = GPre[a+].PS ;

module SS (G : L1.PCtx) (A : CSmall.SPTy[G]) (D D' : PCtx) (l : CSmall.XSub[D, G]) (t : PSub[D', D])
  (c : CLine[a+].Lines[G, CSmall.up G A].Fib) {
  module SFl = CSmall.SmallFib[G, A, D, l] ;
  module SFlt = CSmall.SmallFib[G, A, D', CSmall.xoS D' D G l t] ;
  module FX = CFibExt[a].FX[D'] ;

  B : PTy[D'] = subTy D' D (CSmall.xsub D G A l) t ;
  B2 : PTy[D'] = CSmall.xsub D' G A (CSmall.xoS D' D G l t) ;

  q : FX.Pack B.tob = (B2.tact, (B2.tact-id, B2.tact-o)) ;

  Ht : PtEq D' B.tob B.tact q.1 = \ J I f x y e z ->
    CSmall.tact-irr G A J I f (l.nt I (t.nt I x)) (l.nt J (t.nt J y))
      (CSmall.xntEq D G l J I f (t.nt I x) (t.nt J y) (ntEq D' D t J I f x y e))
      (CSmall.xntEq D' G (CSmall.xoS D' D G l t) J I f x y e) z ;

  mn : FX.NatTy B q = \ V W g v ->
    apH {W0.Ix (B.tob V (D'.act V W g (GPR.TyL[D', B].pr1 W v)))} {GPR.TyL[D', B].EI V} (\ z -> GPR.TyL[D', B].pr V (D'.act V W g (GPR.TyL[D', B].pr1 W v)) z)
      (Ht V W g (GPR.TyL[D', B].pr1 W v) (D'.act V W g (GPR.TyL[D', B].pr1 W v)) (refl (D'.act V W g (GPR.TyL[D', B].pr1 W v))) (GPR.TyL[D', B].pr2 W v)) ;

  module K1 = CCartLaws2[a, a, a].CC[D', B2, D', B, D, CSmall.xsub D G A l,
    \ W x -> x, \ V W g x -> refl (D'.act V W g x), \ W v -> v, \ W v -> refl (GPR.TyL[D', B2].pr1 W v), mn, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (GPR.TyL[D', B].pr X x u),
    t.nt, t.nt-nat, CSub[a].SubE[D', D, t, (CSmall.xsub D G A l)].mV, \ W v -> refl (t.nt W (CSub[a].SubE[D', D, t, (CSmall.xsub D G A l)].TS.pr1 W v)), CSub[a].SubE[D', D, t, (CSmall.xsub D G A l)].mV-nat, CSub[a].SubE[D', D, t, (CSmall.xsub D G A l)].mV-inj, \ X x u -> u, \ X x u -> refl (CSub[a].SubE[D', D, t, (CSmall.xsub D G A l)].TC.pr X (t.nt X x) u)] ;

  module K2 = CCartLaws2[a, a, a+].CC[D', B2, D, CSmall.xsub D G A l, G, CSmall.up G A,
    K1.s, K1.s-nat, K1.ta, K1.tapt, K1.tanat, K1.tainj, K1.bk, K1.bkta,
    l.nt, l.nt-nat, SFl.ta, \ W w -> refl (l.nt W (SFl.TB.pr1 W w)), SFl.tanat, SFl.tainj, \ X x u -> u, \ X x u -> refl (SFl.TE.pr X (l.nt X x) u)] ;

  law : Id ((A' : PTy[D']) * CLine[a].Lines[D', A'].Fib)
           (B, CFibSub[a].FibSub[D', D, t, CSmall.xsub D G A l].sub (SFl.fib c)) (B2, SFlt.fib c) =
    transH (FX.fibExt B (CFibSub[a].FibSub[D', D, t, CSmall.xsub D G A l].sub (SFl.fib c)) q Ht mn)
      (apH {CLine[a].Lines[D', B2].Fib} {(A' : PTy[D']) * CLine[a].Lines[D', A'].Fib} (\ z -> (B2, z))
        (calc (CLine[a].Lines[D', B2].Fib) {
            K1.C1.moveFib (K1.C2.moveFib (SFl.fib c))
          =< K1.compFib (SFl.fib c) >
            K1.C12.moveFib (SFl.fib c)
          =< K2.compFib c >
            K2.C12.moveFib c
          =< CCartLaws2[a, a+, a+].CG[D', B2, G, CSmall.up G A,
               K2.s, K2.s-nat, K2.ta, K2.tapt, K2.tanat, K2.tainj, K2.bk, K2.bkta,
               (CSmall.xoS D' D G l t).nt, (CSmall.xoS D' D G l t).nt-nat, SFlt.ta, \ W w -> refl ((CSmall.xoS D' D G l t).nt W (SFlt.TB.pr1 W w)), SFlt.tanat, SFlt.tainj, \ X x u -> u, \ X x u -> refl (SFlt.TE.pr X ((CSmall.xoS D' D G l t).nt X x) u),
               \ W x -> refl (l.nt W (t.nt W x)), \ W v -> refl (SFl.TE.pr W (l.nt W (t.nt W (GPR.TyL[D', B2].pr1 W v))) (GPR.TyL[D', B2].pr2 W v))].congFib c >
            SFlt.fib c })) ;

} ;
