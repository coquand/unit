-- CExtFullCart.seg (L5, inside CB, level l): Theorem 7 at full points as
-- one equation of structures (model.tex lem:full-move (ii)).  On the
-- full points, (B , A' , alpha) maps into (Ext , A , ext) by a cart
-- (fromB , toEA) over the inclusion; e_alpha is extEquiv moved along it.
-- Proof: Move's uniqueness, the extension at a full point being e_alpha's
-- (CExtFull.extEqFull), and the translated side of a moved side being the
-- side itself.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module FC (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (kA : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  module E1 = CExtEquiv[l].ExtEq[G, A, psi, B, al, kA, eal] ;
  module EE3 = CExtEquiv3[l].ExtEq3[G, A, psi, B, al, kA, eal] ;

  -- the cart
  bkB (X : Ob) (x : W0.Ix (G'.ob X)) (u : W0.Ix (ExtT.tob X x.1)) : W0.Ix (B.tob X x) = (toB X (x.1, u) x.2).2 ;

  -- its fields, named for composites
  cs (W : Ob) (x : W0.Ix (G'.ob W)) : W0.Ix (G.ob W) = x.1 ;
  cs-nat (V W : Ob) (g : Hom V W) (x : W0.Ix (G'.ob W)) : Id (W0.Ix (G.ob V)) (cs V (G'.act V W g x)) (G.act V W g (cs W x)) =
    refl (G.act V W g x.1) ;
  ctA (W : Ob) (v : TA'.EI W) : TA.EI W = toEA W v ;
  ctB (W : Ob) (v : TB.EI W) : TX.EI W = fromB W v ;
  ctApt (W : Ob) (v : TA'.EI W) : Id (W0.Ix (G.ob W)) (toEA W v).1 (cs W v.1) = refl v.1.1 ;
  ctAnat (V W : Ob) (g : Hom V W) (v : TA'.EI W) : Id (TA.EI V) (EA.act V W g (toEA W v)) (toEA V (EA'.act V W g v)) =
    refl (EA.act V W g (toEA W v)) ;
  ctAinj (W : Ob) (v v' : TA'.EI W) (P : Id (W0.Ix (G'.ob W)) v.1 v'.1) (Q : Id (TA.EI W) (toEA W v) (toEA W v')) : Id (TA'.EI W) v v' =
    toEA-inj W v v' Q ;
  cbkA (X : Ob) (x : W0.Ix (G'.ob X)) (u : W0.Ix (A.tob X x.1)) : W0.Ix (A.tob X x.1) = u ;
  cbkAta (X : Ob) (x : W0.Ix (G'.ob X)) (u : W0.Ix (A.tob X x.1)) : Id (TA.EI X) (toEA X (x, u)) (x.1, u) = refl (x.1, u) ;
  ctBpt (W : Ob) (v : TB.EI W) : Id (W0.Ix (G.ob W)) (fromB W v).1 (cs W v.1) = refl v.1.1 ;
  ctBnat (V W : Ob) (g : Hom V W) (v : TB.EI W) : Id (TX.EI V) (EX.act V W g (fromB W v)) (fromB V (EB.act V W g v)) = actX-B V W g v ;
  ctBinj (W : Ob) (v v' : TB.EI W) (P : Id (W0.Ix (G'.ob W)) v.1 v'.1) (Q : Id (TX.EI W) (fromB W v) (fromB W v')) : Id (TB.EI W) v v' =
    fromB-inj W v v' Q ;
  cbkBta (X : Ob) (x : W0.Ix (G'.ob X)) (u : W0.Ix (ExtT.tob X x.1)) : Id (TX.EI X) (fromB X (x, bkB X x u)) (x.1, u) =
    fromB-toB X (x.1, u) x.2 ;
  ccomm (W : Ob) (v : TB.EI W) : Id (TA.EI W) (toEA W (al.mE W v)) (extMap.mE W (fromB W v)) = symH (extE-B W v) ;

  module H = CHFibCart[l, l].HCart[G', B, A', al, G, ExtT, A, extMap,
    cs, cs-nat, ctA, ctApt, ctAnat, ctAinj, cbkA, cbkAta, ctB, ctBpt, ctBnat, ctBinj, bkB, cbkBta, ccomm] ;

  -- the cart's map of fibre elements is fromFA
  mS-from (W : Ob) (v : E1.FA.TF.EI W) : Id (E1.FX.TF.EI W) (H.mS W v) (E1.fromFA W v) =
    E1.FX.fibE-eq W (H.mS W v) (E1.fromFA W v) (symH (E1.fromFA-pt W v))
      (transH (H.bm-E W v) (symH (E1.fromFA-B W v)))
      (\ V f i -> symH (E1.fromFA-L W v V f i)) ;

  qF (W : Ob) (v : E1.FA.TF.EI W) : IsT (full W (E1.fromFA W v).1.1) =
    subst (TA.EI W) (\ z -> IsT (full W z.1)) (toEA W v.1) (E1.fromFA W v).1 (symH (E1.fromFA-pt W v)) v.1.1.2 ;

  toFA-fromFA (W : Ob) (v : E1.FA.TF.EI W) (q : IsT (full W (E1.fromFA W v).1.1)) : Id (E1.FA.TF.EI W) (E1.toFA W (E1.fromFA W v) q) v =
    E1.fromFA-inj W (E1.toFA W (E1.fromFA W v) q) v (E1.fromFA-toFA W (E1.fromFA W v) q) ;

  opaque mS-from ; opaque toFA-fromFA ;

  module Pt (X : Ob) (x : TA'.EI X) (sd : E1.PA.Side[X, x]) {
    ms : E1.PX.Side[X, toEA X x] = H.C.mside EE3.extEquiv X x sd ;

    -- the translated moved side is the side
    R : Id (E1.PA.Side[X, x]) (E1.Tr[X, toEA X x, x.1.2].tside ms) sd =
      E1.PA.side-extH X x x (refl x) (E1.Tr[X, toEA X x, x.1.2].tside ms) sd (refl sd.pQ)
        (\ V f i i' -> transH (E1.toFA-cong V (H.mS V (sd.pv V f i)) (E1.fromFA V (sd.pv V f i)) (mS-from V (sd.pv V f i))
                                 (E1.Tr[X, toEA X x, x.1.2].qv ms V f i) (qF V (sd.pv V f i)))
                         (transH (toFA-fromFA V (sd.pv V f i) (qF V (sd.pv V f i))) (E1.PA.pv-irr X x sd V f i i'))) ;

    res : Id (E1.FX.TF.EI X) (H.mS X (x, eal.kop X x sd)) (toEA X x, EE3.extEquiv.kop X (toEA X x) ms) =
      transH (mS-from X (x, eal.kop X x sd))
        (transH (apH (\ z -> E1.fromFA X (x, eal.kop X x z)) (symH R))
                (symH (CExtFull[l].At[G, A, psi, B, al, kA, eal, X, toEA X x, ms, x.1.2].extEqFull))) ;
  } ;

  -- e_alpha is extEquiv moved along the cart
  law : Id (CEquiv[l].EquivOp G' B A' al) eal (H.moveEq EE3.extEquiv) =
    H.uniqueEq EE3.extEquiv eal (\ X x sd -> Pt[X, x, sd].res) ;
} ;
