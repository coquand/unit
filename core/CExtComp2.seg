-- CExtComp2.seg (L5, inside CB, level l): Theorem 7, composition, step
-- (2) (model.tex §6.1): delta = forall along the line of psi (ONE sieve,
-- forallS); on delta the problem is B's (CExtComp1); the partial line of
-- Ext moved along ext (CMapLine) joined with alpha of the B-filler on
-- delta is filled in A.
--
-- Quarry: seg/model GExtComp2, one sieve per side and one forall.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module C2 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (eS : IPt) (kAS : CLine[l].Lines[G, A].Fill eS)
  (kBS : CLine[l].Lines[GP.CofL[G, psi].resCtx, B].Fill eS) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  open CExtComp1[l].C1[G, A, psi, B, al, eS, kBS] ;

  module KA = CLine[l].EndKit[G, A, eS] ;
  module FTA = CLine[l].FT[G, A] ;
  module ML = CMapLine[l].MapLine[G, ExtT, A, extMap, eS] ;
  module RKA = CPartial[l].Rel[KA.TV.E, KA.SFm.SF, KA.SFm.SF, CPartial[l].pmap-id KA.TV.E KA.SFm.SF] ;
  module GL = PR.PshL[G] ;

  -- alpha of a value of B read in Ext is ext of that value
  aB-ext (W : Ob) (z : TX.EI W) (q : IsT (full W z.1)) : Id (TA.EI W) (toEA W (al.mE W (toB W z q))) (extE W z) =
    transH (symH (extE-B W (toB W z q))) (apH (extE W) (fromB-toB W z q)) ;

  module Pb (X : Ob) (x : KX.TV.EI X) (p : KX.PT.Side[X, x]) {

    ------------------------------------------------------------------
    -- delta: where the line is full everywhere

    Lk : PhiL X =
      (\ W f j -> Q W (x.1.1 W f j),
       \ V W g f j -> transH (symH (psi.cnat V W g (x.1.1 W f j))) (apH (\ z -> Q V z) (x.1.2 V W g f j))) ;

    dl : Phi X = forallS X Lk ;

    flAt (W : Ob) (f : Hom W X) (h : HoldsL X Lk W f) : FlTy W (KX.TV.E.act W X f x) =
      \ V g j -> full-of-id V (x.1.1 V (compH V W X f g) j) (h V g j) ;

    hOf (W : Ob) (f : Hom W X) (i : Lands W X dl f) : HoldsL X Lk W f = lands-forall W X Lk f i ;

    -- the B-filler along f in delta
    module BW (W : Ob) (f : Hom W X) (i : Lands W X dl f) {
      module BB = Beta[W, KX.TV.E.act W X f x, KX.PT.rside W X f x p, flAt W f (hOf W f i)] ;
    } ;

    ------------------------------------------------------------------
    -- the unglued problem

    xA : KA.TV.EI X = ML.tvM X x ;

    pA : KA.PT.Side[X, xA] = ML.mapS X x p ;

    -- along f chi: the B-filler of the restriction (BR) of the problem
    -- restricted along f (FBv-cong: f chi versus f then chi)
    FBv-tr (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X dl f)
      (i' : Lands V' X dl (compH V' V X f chi)) (W : Ob) (g : Hom W V') (j : Hom W Iv)
      : Id (TB.EI W) (BW[V', compH V' V X f chi, i'].BB.FBv W g j) (BW[V, f, i].BB.FBv W (compH W V' V chi g) j) =
      transH (FBv-cong V' (KX.TV.E.act V' X (compH V' V X f chi) x) (KX.TV.E.act V' V chi (KX.TV.E.act V X f x))
                (KX.TV.E.act-o V' V X f chi x)
                (KX.PT.rside V' X (compH V' V X f chi) x p) (KX.PT.rside V' V chi (KX.TV.E.act V X f x) (KX.PT.rside V X f x p))
                (KX.PT.rside-o V' V X chi f x p)
                (flAt V' (compH V' V X f chi) (hOf V' (compH V' V X f chi) i'))
                (\ W2 f2 j2 -> flAt V f (hOf V f i) W2 (compH W2 V' V chi f2) j2) W g j)
             (symH (BR[V', V, chi, KX.TV.E.act V X f x, KX.PT.rside V X f x p, flAt V f (hOf V f i)].FBv-R W g j)) ;

    ------------------------------------------------------------------
    -- the side on delta: alpha of the B-filler

    module SD {
      t (V : Ob) (f : Hom V X) (i : Lands V X dl f) (W : Ob) (g : Hom W V) (j : Hom W Iv) : TA.EI W =
        toEA W (al.mE W (BW[V, f, i].BB.FBv W g j)) ;

      tp (V : Ob) (f : Hom V X) (i : Lands V X dl f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
        : Id (W0.Ix (G.ob W)) (t V f i W g j).1 (x.1.1 W (compH W V X f g) j) =
        transH (apH (\ z -> z.1) (al.mpt W (BW[V, f, i].BB.FBv W g j)))
               (apH (\ y -> (y.1 W g j).1) BW[V, f, i].BB.fillB.1.2) ;

      tn (V : Ob) (f : Hom V X) (i : Lands V X dl f) (W' W : Ob) (g' : Hom W' W) (g : Hom W V) (j : Hom W Iv)
        : Id (TA.EI W') (TA.E.act W' W g' (t V f i W g j)) (t V f i W' (compH W' W V g g') (compH W' W Iv j g')) =
        apH (toEA W') (transH (symH (al.mnat W' W g' (BW[V, f, i].BB.FBv W g j)))
                              (apH (al.mE W') (BW[V, f, i].BB.fillB.1.1.2 W' W g' g j))) ;

      t1 (V : Ob) (f : Hom V X) (i : Lands V X dl f)
        : Id (TA.EI V) (t V f i V (idH V) (ptH V eS)) (KA.endE V (KA.TV.E.act V X f xA)) =
        transH (apH (\ z -> toEA V (al.mE V z)) BW[V, f, i].BB.FB-start)
         (transH (aB-ext V (KX.endE V (KX.TV.E.act V X f x)) (flAt V f (hOf V f i) V (idH V) (ptH V eS)))
          (transH (apH (extE V) (KX.endE-act V X f x))
           (transH (extE-nat V X f (KX.endE X x))
            (transH (apH (TA.E.act V X f) (symH (ML.tvM-E X x))) (symH (KA.endE-act V X f xA)))))) ;

      tr (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X dl f) (i' : Lands V' X dl (compH V' V X f chi))
        (W : Ob) (g : Hom W V') (j : Hom W Iv)
        : Id (TA.EI W) (t V' (compH V' V X f chi) i' W g j) (t V f i W (compH W V' V chi g) j) =
        apH (\ z -> toEA W (al.mE W z)) (FBv-tr V' V chi f i i' W g j) ;

      module LS = CLineSide[l].LineSide[G, A, eS, X, xA, dl, t, tp, tn, t1, tr] ;
    } ;

    ------------------------------------------------------------------
    -- the joined partial line in A and its filler

    -- p at (V , f) is p f at (V , id)
    i0 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) : Lands V V (pre V X f p.pQ) (idH V) =
      pre-lands V V X f p.pQ (idH V) (lands-eq V X p.pQ f (compH V V X f (idH V)) (symH (comp-idr V X f)) i) ;

    pv-id (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f)
      : Id (KX.TS.EI V) ((KX.PT.rside V X f x p).pv V (idH V) (i0 V f i)) (p.pv V f i) =
      KX.PT.pv-hom X x p V (compH V V X f (idH V)) f (comp-idr V X f) (lands-pre V V X f p.pQ (idH V) (i0 V f i)) i ;

    -- on p's sieve, alpha of the B-filler is ext of p
    aFB (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (i' : Lands V X dl f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (SD.t V f i' W g j) (extE W (lvX V (p.pv V f i) W g j)) =
      transH (apH (\ z -> toEA W (al.mE W z))
                (transH (apH (\ k -> BW[V, f, i'].BB.FBv W k j) (symH (comp-idl W V g)))
                        (BW[V, f, i'].BB.FB-side V (idH V) (i0 V f i) W g j)))
        (transH (aB-ext W (lvX V ((KX.PT.rside V X f x p).pv V (idH V) (i0 V f i)) W g j)
                   (BW[V, f, i'].BB.SV[V, idH V, (KX.PT.rside V X f x p).pv V (idH V) (i0 V f i),
                                       (KX.PT.rside V X f x p).ppt V (idH V) (i0 V f i)].qv W g j))
                (apH (\ u -> extE W (lvX V u W g j)) (pv-id V f i))) ;

    c12 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (i' : Lands V X dl f) : Id (KA.TS.EI V) (pA.pv V f i) (SD.LS.sv V f i') =
      KA.ts-ext V (pA.pv V f i) (SD.LS.sv V f i')
        (transH (ML.tsM-pt V (p.pv V f i))
          (transH (apH (ML.tvM V) (p.ppt V f i))
            (transH (ML.tvM-act V X f x) (symH (SD.LS.sv-pt V f i')))))
        (\ W g j -> transH (ML.tsM-val V (p.pv V f i) W g j)
                     (transH (symH (aFB V f i i' W g j)) (symH (SD.LS.sv-val V f i' W g j)))) ;

    pick : Nat -> KA.PT.Side[X, xA] = split { zero -> pA ; suc m -> SD.LS.side } ;

    CTy (n n' : Nat) : U l = (V : Ob) (f : Hom V X) (h : Lands V X (pick n).pQ f) (h' : Lands V X (pick n').pQ f)
      -> Id (KA.TS.EI V) ((pick n).pv V f h) ((pick n').pv V f h') ;

    cc0 : (n' : Nat) -> CTy zero n' = split {
      zero -> \ V f h h' -> KA.PT.pv-irr X xA pA V f h h' ;
      suc m -> \ V f h h' -> c12 V f h h' } ;

    cc1 : (n' : Nat) -> CTy (suc zero) n' = split {
      zero -> \ V f h h' -> symH (c12 V f h' h) ;
      suc m -> \ V f h h' -> KA.PT.pv-irr X xA SD.LS.side V f h h' } ;

    cc : (n n' : Nat) -> CTy n n' = split { zero -> cc0 ; suc m -> cc1 } ;

    module J = CPartial[l].Join[KA.TV.E, KA.SFm.SF, X, xA, suc (suc zero), \ k -> pick k.1, \ k k' -> cc k.1 k'.1] ;

    fin0 : Arith[a].Fin (suc (suc zero)) = (zero, refl true) ;
    fin1 : Arith[a].Fin (suc (suc zero)) = (suc zero, refl true) ;

    fill : W0.Ix (KA.SFm.SF.tob X xA) = kAS.kop X xA J.side ;

    FAv (W : Ob) (f : Hom W X) (j : Hom W Iv) : TA.EI W = fill.1.1.1 W f j ;

    FAn (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
      : Id (TA.EI V) (TA.E.act V W g (FAv W f j)) (FAv V (compH V W X f g) (compH V W Iv j g)) = fill.1.1.2 V W g f j ;

    FApt (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (W0.Ix (G.ob W)) (FAv W f j).1 (x.1.1 W f j) =
      apH (\ y -> y.1 W f j) fill.1.2 ;

    Fside (V : Ob) (f : Hom V X) (i : Lands V X J.side.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (FAv W (compH W V X f g) j) ((KA.lineL V (J.side.pv V f i)).2.1.1 W g j) =
      transH (symH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act V X f (xA, fill))))
             (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (kAS.kside X xA J.side V f i)) ;

    -- on p's sieve, the filler is ext of p
    F-S1 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (FAv W (compH W V X f g) j) (extE W (lvX V (p.pv V f i) W g j)) =
      transH (Fside V f (J.inS fin0 V f i) W g j)
        (transH (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (J.pv-in fin0 V f i (J.inS fin0 V f i)))
                (ML.tsM-val V (p.pv V f i) W g j)) ;

    -- on delta, the filler is alpha of the B-filler
    F-S2 (V : Ob) (f : Hom V X) (i : Lands V X dl f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (FAv W (compH W V X f g) j) (SD.t V f i W g j) =
      transH (Fside V f (J.inS fin1 V f i) W g j)
        (transH (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (J.pv-in fin1 V f i (J.inS fin1 V f i)))
                (SD.LS.sv-val V f i W g j)) ;

    -- at (id , eS) the filler is ext of x
    FA-start : Id (TA.EI X) (FAv X (idH X) (ptH X eS)) (extE X (KX.endE X x)) =
      transH (symH (FTA.Ev[eS].endB-E X (xA.1, fill.1))) (transH (apH (KA.endE X) fill.2) (ML.tvM-E X x)) ;

    opaque Fside ; opaque F-S1 ; opaque F-S2 ; opaque FA-start ;
  } ;
} ;
