-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostCube.seg (L9): end data on the boundary of a square (POSTNIKOV-INFORMAL.md,
-- the successor cube).  Over [m] * Y, Y = [1]_t * [1]_v, with the line s
-- of the filling, the sieve QY of Y is the boundary of the square and the
-- end data are four pieces
--
--   T0 W a v j , T1 W a v j      at t = 0 , t = 1  (a : [W] -> [m], v , j = s)
--   V0 W a t j , V1 W a t j      at v = 0 , v = 1
--
-- agreeing at the four corners (c00 , c01 , c10 , c11).  E4 builds the
-- partial line Ev (case analysis on the landing), over the point (Evp),
-- natural (Evn), equal to each piece where that piece applies (Ev-T0 ..),
-- and its agreement with a lid (Lid).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module BD = CPostBdry[a, l] ;

IvIv : Ob = prodP Iv Iv ;

-- the boundary of the square
sqT (e : El Iv) : SP.Phi IvIv = SP.pre IvIv Iv (pr1 Iv Iv) (PBs.sptS e) ;
sqV (e : El Iv) : SP.Phi IvIv = SP.pre IvIv Iv (pr2 Iv Iv) (PBs.sptS e) ;
QT : SP.Phi IvIv = SP.unionS IvIv (sqT e0) (sqT e1) ;
QV : SP.Phi IvIv = SP.unionS IvIv (sqV e0) (sqV e1) ;
QY : SP.Phi IvIv = SP.unionS IvIv QT QV ;

module Geo (m : Nat) {
  X : Ob = prodP (lin m) IvIv ;
  endS : SP.Phi X = SP.pre X IvIv (pr2 (lin m) IvIv) QY ;
  p1g (W : Nat) (g : Hom (lin W) X) : Hom (lin W) (lin m) = compH (lin W) X (lin m) (pr1 (lin m) IvIv) g ;
  p2g (W : Nat) (g : Hom (lin W) X) : Hom (lin W) IvIv = compH (lin W) X IvIv (pr2 (lin m) IvIv) g ;
  pt (W : Nat) (g : Hom (lin W) X) : Hom (lin W) Iv = compH (lin W) IvIv Iv (pr1 Iv Iv) (p2g W g) ;
  pv (W : Nat) (g : Hom (lin W) X) : Hom (lin W) Iv = compH (lin W) IvIv Iv (pr2 Iv Iv) (p2g W g) ;

  L (W : Nat) (e : El Iv) (k : Hom (lin W) Iv) : U a = SP.Lands (lin W) Iv (PBs.sptS e) k ;
  CT (W : Nat) (g : Hom (lin W) X) : U a = Plus (L W e0 (pt W g)) (L W e1 (pt W g)) ;
  CV (W : Nat) (g : Hom (lin W) X) : U a = Plus (L W e0 (pv W g)) (L W e1 (pv W g)) ;
  C4 (W : Nat) (g : Hom (lin W) X) : U a = Plus (CT W g) (CV W g) ;

  -- reading a landing
  cutT' (W : Nat) (g : Hom (lin W) X)
    : Plus (SP.Lands (lin W) IvIv (sqT e0) (p2g W g)) (SP.Lands (lin W) IvIv (sqT e1) (p2g W g)) -> CT W g = split {
    inl i -> inl (SP.lands-pre (lin W) IvIv Iv (pr1 Iv Iv) (PBs.sptS e0) (p2g W g) i) ;
    inr i -> inr (SP.lands-pre (lin W) IvIv Iv (pr1 Iv Iv) (PBs.sptS e1) (p2g W g) i) } ;

  cutV' (W : Nat) (g : Hom (lin W) X)
    : Plus (SP.Lands (lin W) IvIv (sqV e0) (p2g W g)) (SP.Lands (lin W) IvIv (sqV e1) (p2g W g)) -> CV W g = split {
    inl i -> inl (SP.lands-pre (lin W) IvIv Iv (pr2 Iv Iv) (PBs.sptS e0) (p2g W g) i) ;
    inr i -> inr (SP.lands-pre (lin W) IvIv Iv (pr2 Iv Iv) (PBs.sptS e1) (p2g W g) i) } ;

  cut' (W : Nat) (g : Hom (lin W) X)
    : Plus (SP.Lands (lin W) IvIv QT (p2g W g)) (SP.Lands (lin W) IvIv QV (p2g W g)) -> C4 W g = split {
    inl i -> inl (cutT' W g (SP.union-lands (lin W) IvIv (sqT e0) (sqT e1) (p2g W g) i)) ;
    inr i -> inr (cutV' W g (SP.union-lands (lin W) IvIv (sqV e0) (sqV e1) (p2g W g) i)) } ;

  cut (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X endS g) : C4 W g =
    cut' W g (SP.union-lands (lin W) IvIv QT QV (p2g W g) (SP.lands-pre (lin W) X IvIv (pr2 (lin m) IvIv) QY g b)) ;

  -- making a landing
  inQY (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) IvIv QY (p2g W g)) : SP.Lands (lin W) X endS g =
    SP.pre-lands (lin W) X IvIv (pr2 (lin m) IvIv) QY g i ;

  inT (W : Nat) (g : Hom (lin W) X) (e : El Iv) (i : L W e (pt W g)) : SP.Lands (lin W) IvIv (sqT e) (p2g W g) =
    SP.pre-lands (lin W) IvIv Iv (pr1 Iv Iv) (PBs.sptS e) (p2g W g) i ;
  inV (W : Nat) (g : Hom (lin W) X) (e : El Iv) (i : L W e (pv W g)) : SP.Lands (lin W) IvIv (sqV e) (p2g W g) =
    SP.pre-lands (lin W) IvIv Iv (pr2 Iv Iv) (PBs.sptS e) (p2g W g) i ;

  inT0 (W : Nat) (g : Hom (lin W) X) (i : L W e0 (pt W g)) : SP.Lands (lin W) X endS g =
    inQY W g (SP.lands-union-l (lin W) IvIv QT QV (p2g W g) (SP.lands-union-l (lin W) IvIv (sqT e0) (sqT e1) (p2g W g) (inT W g e0 i))) ;
  inT1 (W : Nat) (g : Hom (lin W) X) (i : L W e1 (pt W g)) : SP.Lands (lin W) X endS g =
    inQY W g (SP.lands-union-l (lin W) IvIv QT QV (p2g W g) (SP.lands-union-r (lin W) IvIv (sqT e0) (sqT e1) (p2g W g) (inT W g e1 i))) ;
  inV0 (W : Nat) (g : Hom (lin W) X) (i : L W e0 (pv W g)) : SP.Lands (lin W) X endS g =
    inQY W g (SP.lands-union-r (lin W) IvIv QT QV (p2g W g) (SP.lands-union-l (lin W) IvIv (sqV e0) (sqV e1) (p2g W g) (inV W g e0 i))) ;
  inV1 (W : Nat) (g : Hom (lin W) X) (i : L W e1 (pv W g)) : SP.Lands (lin W) X endS g =
    inQY W g (SP.lands-union-r (lin W) IvIv QT QV (p2g W g) (SP.lands-union-r (lin W) IvIv (sqV e0) (sqV e1) (p2g W g) (inV W g e1 i))) ;

  -- the coordinates of a point a , (t , v)
  pt3 (W : Nat) (a : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) : Hom (lin W) X = pairH (lin m) IvIv (lin W) a (pairH Iv Iv (lin W) t v) ;

  p2-pt3 (W : Nat) (a : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) : Id (Hom (lin W) IvIv) (p2g W (pt3 W a t v)) (pairH Iv Iv (lin W) t v) =
    pr2-pair (lin m) IvIv (lin W) a (pairH Iv Iv (lin W) t v) ;
  p1-pt3 (W : Nat) (a : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) : Id (Hom (lin W) (lin m)) (p1g W (pt3 W a t v)) a =
    pr1-pair (lin m) IvIv (lin W) a (pairH Iv Iv (lin W) t v) ;
  t-pt3 (W : Nat) (a : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) : Id (Hom (lin W) Iv) (pt W (pt3 W a t v)) t =
    transH (apH (compH (lin W) IvIv Iv (pr1 Iv Iv)) (p2-pt3 W a t v)) (pr1-pair Iv Iv (lin W) t v) ;
  v-pt3 (W : Nat) (a : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) : Id (Hom (lin W) Iv) (pv W (pt3 W a t v)) v =
    transH (apH (compH (lin W) IvIv Iv (pr2 Iv Iv)) (p2-pt3 W a t v)) (pr2-pair Iv Iv (lin W) t v) ;

  -- every map is the point of its coordinates
  pt3-eta (W : Nat) (g : Hom (lin W) X) : Id (Hom (lin W) X) (pt3 W (p1g W g) (pt W g) (pv W g)) g =
    transH (apH (pairH (lin m) IvIv (lin W) (p1g W g)) (pair-eta Iv Iv (lin W) (p2g W g))) (pair-eta (lin m) IvIv (lin W) g) ;

  -- restriction
  p1h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
    : Id (Hom (lin V) (lin m)) (compH (lin V) (lin W) (lin m) (p1g W g) h) (p1g V (compH (lin V) (lin W) X g h)) =
    comp-assoc (lin V) (lin W) X (lin m) (pr1 (lin m) IvIv) g h ;
  p2h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
    : Id (Hom (lin V) IvIv) (compH (lin V) (lin W) IvIv (p2g W g) h) (p2g V (compH (lin V) (lin W) X g h)) =
    comp-assoc (lin V) (lin W) X IvIv (pr2 (lin m) IvIv) g h ;
  pth (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
    : Id (Hom (lin V) Iv) (compH (lin V) (lin W) Iv (pt W g) h) (pt V (compH (lin V) (lin W) X g h)) =
    transH (comp-assoc (lin V) (lin W) IvIv Iv (pr1 Iv Iv) (p2g W g) h) (apH (compH (lin V) IvIv Iv (pr1 Iv Iv)) (p2h V W h g)) ;
  pvh (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
    : Id (Hom (lin V) Iv) (compH (lin V) (lin W) Iv (pv W g) h) (pv V (compH (lin V) (lin W) X g h)) =
    transH (comp-assoc (lin V) (lin W) IvIv Iv (pr2 Iv Iv) (p2g W g) h) (apH (compH (lin V) IvIv Iv (pr2 Iv Iv)) (p2h V W h g)) ;

  Lh (V W : Nat) (h : Hom (lin V) (lin W)) (e : El Iv) (k : Hom (lin W) Iv) (k' : Hom (lin V) Iv)
    (p : Id (Hom (lin V) Iv) (compH (lin V) (lin W) Iv k h) k') (i : L W e k) : L V e k' =
    PBs.slands-hom (lin V) Iv (PBs.sptS e) _ _ p (SP.lands-comp (lin V) (lin W) Iv (PBs.sptS e) k h i) ;

  resT (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) : CT W g -> CT V (compH (lin V) (lin W) X g h) = split {
    inl i -> inl (Lh V W h e0 (pt W g) _ (pth V W h g) i) ;
    inr i -> inr (Lh V W h e1 (pt W g) _ (pth V W h g) i) } ;
  resV (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) : CV W g -> CV V (compH (lin V) (lin W) X g h) = split {
    inl i -> inl (Lh V W h e0 (pv W g) _ (pvh V W h g) i) ;
    inr i -> inr (Lh V W h e1 (pv W g) _ (pvh V W h g) i) } ;
  res4 (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) : C4 W g -> C4 V (compH (lin V) (lin W) X g h) = split {
    inl c -> inl (resT V W h g c) ;
    inr c -> inr (resV V W h g c) } ;
} ;

------------------------------------------------------------------------
-- a piece of end data: a family over [m] * [1] * [1], over the point, natural

record Pc (G : PP.PCtx) (B : PP.PTy[G]) (m : Nat) (xf : W0.Ix (G.ob (lin m))) {
  v : (W : Nat) -> Hom (lin W) (lin m) -> Hom (lin W) Iv -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W) ;
  vp : (W : Nat) (a : Hom (lin W) (lin m)) (k j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (v W a k j).1 (G.act (lin W) (lin m) a xf) ;
  vn : (V W : Nat) (h : Hom (lin V) (lin W)) (a : Hom (lin W) (lin m)) (k j : Hom (lin W) Iv)
       -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (v W a k j))
             (v V (compH (lin V) (lin W) (lin m) a h) (compH (lin V) (lin W) Iv k h) (compH (lin V) (lin W) Iv j h)) ;
} ;

------------------------------------------------------------------------
-- the end data from four pieces

module E4 (G : PP.PCtx) (B : PP.PTy[G]) (m : Nat) (xf : W0.Ix (G.ob (lin m)))
  (T0 T1 V0 V1 : Pc[G, B, m, xf])
  (c00 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T0.v W a (constH (lin W) Iv e0) j) (V0.v W a (constH (lin W) Iv e0) j))
  (c01 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T0.v W a (constH (lin W) Iv e1) j) (V1.v W a (constH (lin W) Iv e0) j))
  (c10 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T1.v W a (constH (lin W) Iv e0) j) (V0.v W a (constH (lin W) Iv e1) j))
  (c11 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T1.v W a (constH (lin W) Iv e1) j) (V1.v W a (constH (lin W) Iv e1) j)) {
  module Gm = Geo[m] ;
  module TB = PB.GPre[l].TyL[G, B] ;
  module GL = PB.GPre[l].PshL[G] ;
  X : Ob = Gm.X ;
  xX : W0.Ix (G.ob X) = G.act X (lin m) (pr1 (lin m) IvIv) xf ;

  EvT (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : Gm.CT W g -> TB.EI (lin W) = split {
    inl i -> T0.v W (Gm.p1g W g) (Gm.pv W g) j ;
    inr i -> T1.v W (Gm.p1g W g) (Gm.pv W g) j } ;
  EvV (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : Gm.CV W g -> TB.EI (lin W) = split {
    inl i -> V0.v W (Gm.p1g W g) (Gm.pt W g) j ;
    inr i -> V1.v W (Gm.p1g W g) (Gm.pt W g) j } ;
  EvC (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : Gm.C4 W g -> TB.EI (lin W) = split {
    inl c -> EvT W g j c ;
    inr c -> EvV W g j c } ;

  Ev (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) (j : Hom (lin W) Iv) : TB.EI (lin W) =
    EvC W g j (Gm.cut W g b) ;

  ----------------------------------------------------------------------
  -- the value does not depend on the piece

  agTT (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c c' : Gm.CT W g) -> Id (TB.EI (lin W)) (EvT W g j c) (EvT W g j c') = split {
    inl i -> split {
      inl i' -> refl (T0.v W (Gm.p1g W g) (Gm.pv W g) j) ;
      inr i' -> absurd _ (PBs.spt-disj (lin W) (Gm.pt W g) i i') } ;
    inr i -> split {
      inl i' -> absurd _ (PBs.spt-disj (lin W) (Gm.pt W g) i' i) ;
      inr i' -> refl (T1.v W (Gm.p1g W g) (Gm.pv W g) j) } } ;

  agVV (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c c' : Gm.CV W g) -> Id (TB.EI (lin W)) (EvV W g j c) (EvV W g j c') = split {
    inl i -> split {
      inl i' -> refl (V0.v W (Gm.p1g W g) (Gm.pt W g) j) ;
      inr i' -> absurd _ (PBs.spt-disj (lin W) (Gm.pv W g) i i') } ;
    inr i -> split {
      inl i' -> absurd _ (PBs.spt-disj (lin W) (Gm.pv W g) i' i) ;
      inr i' -> refl (V1.v W (Gm.p1g W g) (Gm.pt W g) j) } } ;

  agTV (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c : Gm.CT W g) (c' : Gm.CV W g) -> Id (TB.EI (lin W)) (EvT W g j c) (EvV W g j c') = split {
    inl i -> split {
      inl i' -> transH (apH (\ k -> T0.v W (Gm.p1g W g) k j) (PBs.slands-pt (lin W) e0 (Gm.pv W g) i'))
                  (transH (c00 W (Gm.p1g W g) j) (apH (\ k -> V0.v W (Gm.p1g W g) k j) (symH (PBs.slands-pt (lin W) e0 (Gm.pt W g) i)))) ;
      inr i' -> transH (apH (\ k -> T0.v W (Gm.p1g W g) k j) (PBs.slands-pt (lin W) e1 (Gm.pv W g) i'))
                  (transH (c01 W (Gm.p1g W g) j) (apH (\ k -> V1.v W (Gm.p1g W g) k j) (symH (PBs.slands-pt (lin W) e0 (Gm.pt W g) i)))) } ;
    inr i -> split {
      inl i' -> transH (apH (\ k -> T1.v W (Gm.p1g W g) k j) (PBs.slands-pt (lin W) e0 (Gm.pv W g) i'))
                  (transH (c10 W (Gm.p1g W g) j) (apH (\ k -> V0.v W (Gm.p1g W g) k j) (symH (PBs.slands-pt (lin W) e1 (Gm.pt W g) i)))) ;
      inr i' -> transH (apH (\ k -> T1.v W (Gm.p1g W g) k j) (PBs.slands-pt (lin W) e1 (Gm.pv W g) i'))
                  (transH (c11 W (Gm.p1g W g) j) (apH (\ k -> V1.v W (Gm.p1g W g) k j) (symH (PBs.slands-pt (lin W) e1 (Gm.pt W g) i)))) } } ;

  agree (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c c' : Gm.C4 W g) -> Id (TB.EI (lin W)) (EvC W g j c) (EvC W g j c') = split {
    inl c -> split {
      inl c' -> agTT W g j c c' ;
      inr c' -> agTV W g j c c' } ;
    inr c -> split {
      inl c' -> symH (agTV W g j c' c) ;
      inr c' -> agVV W g j c c' } } ;

  ----------------------------------------------------------------------
  -- over the point, natural

  ctx (W : Nat) (g : Hom (lin W) X) : Id (W0.Ix (G.ob (lin W))) (G.act (lin W) (lin m) (Gm.p1g W g) xf) (G.act (lin W) X g xX) =
    symH (GL.actC (lin W) X (lin m) (pr1 (lin m) IvIv) g xf) ;

  EvpC (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c : Gm.C4 W g) -> Id (W0.Ix (G.ob (lin W))) (EvC W g j c).1 (G.act (lin W) X g xX) = split {
    inl c -> EvpT W g j c ;
    inr c -> EvpV W g j c }
   where {
    EvpT (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c : Gm.CT W g) -> Id (W0.Ix (G.ob (lin W))) (EvT W g j c).1 (G.act (lin W) X g xX) = split {
      inl i -> transH (T0.vp W (Gm.p1g W g) (Gm.pv W g) j) (ctx W g) ;
      inr i -> transH (T1.vp W (Gm.p1g W g) (Gm.pv W g) j) (ctx W g) } ;
    EvpV (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv) : (c : Gm.CV W g) -> Id (W0.Ix (G.ob (lin W))) (EvV W g j c).1 (G.act (lin W) X g xX) = split {
      inl i -> transH (V0.vp W (Gm.p1g W g) (Gm.pt W g) j) (ctx W g) ;
      inr i -> transH (V1.vp W (Gm.p1g W g) (Gm.pt W g) j) (ctx W g) } ; } ;

  Evp (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob (lin W))) (Ev W g b j).1 (G.act (lin W) X g xX) = EvpC W g j (Gm.cut W g b) ;

  -- a piece restricted, as the piece at the restriction
  pnT (P : Pc[G, B, m, xf]) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (P.v W (Gm.p1g W g) (Gm.pv W g) j))
         (P.v V (Gm.p1g V (compH (lin V) (lin W) X g h)) (Gm.pv V (compH (lin V) (lin W) X g h)) (compH (lin V) (lin W) Iv j h)) =
    transH (P.vn V W h (Gm.p1g W g) (Gm.pv W g) j)
      (transH (apH (\ k -> P.v V k (compH (lin V) (lin W) Iv (Gm.pv W g) h) (compH (lin V) (lin W) Iv j h)) (Gm.p1h V W h g))
              (apH (\ k -> P.v V (Gm.p1g V (compH (lin V) (lin W) X g h)) k (compH (lin V) (lin W) Iv j h)) (Gm.pvh V W h g))) ;
  pnV (P : Pc[G, B, m, xf]) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (P.v W (Gm.p1g W g) (Gm.pt W g) j))
         (P.v V (Gm.p1g V (compH (lin V) (lin W) X g h)) (Gm.pt V (compH (lin V) (lin W) X g h)) (compH (lin V) (lin W) Iv j h)) =
    transH (P.vn V W h (Gm.p1g W g) (Gm.pt W g) j)
      (transH (apH (\ k -> P.v V k (compH (lin V) (lin W) Iv (Gm.pt W g) h) (compH (lin V) (lin W) Iv j h)) (Gm.p1h V W h g))
              (apH (\ k -> P.v V (Gm.p1g V (compH (lin V) (lin W) X g h)) k (compH (lin V) (lin W) Iv j h)) (Gm.pth V W h g))) ;

  nat4 (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : (c : Gm.C4 W g) -> Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (EvC W g j c))
                           (EvC V (compH (lin V) (lin W) X g h) (compH (lin V) (lin W) Iv j h) (Gm.res4 V W h g c)) = split {
    inl c -> natT c ;
    inr c -> natV c }
   where {
    natT : (c : Gm.CT W g) -> Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (EvT W g j c))
                               (EvT V (compH (lin V) (lin W) X g h) (compH (lin V) (lin W) Iv j h) (Gm.resT V W h g c)) = split {
      inl i -> pnT T0 V W h g j ;
      inr i -> pnT T1 V W h g j } ;
    natV : (c : Gm.CV W g) -> Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (EvV W g j c))
                               (EvV V (compH (lin V) (lin W) X g h) (compH (lin V) (lin W) Iv j h) (Gm.resV V W h g c)) = split {
      inl i -> pnV V0 V W h g j ;
      inr i -> pnV V1 V W h g j } ; } ;

  Evn (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g)
    (b' : SP.Lands (lin V) X Gm.endS (compH (lin V) (lin W) X g h)) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (Ev W g b j)) (Ev V (compH (lin V) (lin W) X g h) b' (compH (lin V) (lin W) Iv j h)) =
    transH (nat4 V W h g j (Gm.cut W g b))
           (agree V (compH (lin V) (lin W) X g h) (compH (lin V) (lin W) Iv j h) (Gm.res4 V W h g (Gm.cut W g b)) (Gm.cut V (compH (lin V) (lin W) X g h) b')) ;

  ----------------------------------------------------------------------
  -- each piece where it applies

  Ev-T0 (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) (j : Hom (lin W) Iv) (i : Gm.L W e0 (Gm.pt W g))
    : Id (TB.EI (lin W)) (Ev W g b j) (T0.v W (Gm.p1g W g) (Gm.pv W g) j) = agree W g j (Gm.cut W g b) (inl (inl i)) ;
  Ev-T1 (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) (j : Hom (lin W) Iv) (i : Gm.L W e1 (Gm.pt W g))
    : Id (TB.EI (lin W)) (Ev W g b j) (T1.v W (Gm.p1g W g) (Gm.pv W g) j) = agree W g j (Gm.cut W g b) (inl (inr i)) ;
  Ev-V0 (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) (j : Hom (lin W) Iv) (i : Gm.L W e0 (Gm.pv W g))
    : Id (TB.EI (lin W)) (Ev W g b j) (V0.v W (Gm.p1g W g) (Gm.pt W g) j) = agree W g j (Gm.cut W g b) (inr (inl i)) ;
  Ev-V1 (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) (j : Hom (lin W) Iv) (i : Gm.L W e1 (Gm.pv W g))
    : Id (TB.EI (lin W)) (Ev W g b j) (V1.v W (Gm.p1g W g) (Gm.pt W g) j) = agree W g j (Gm.cut W g b) (inr (inr i)) ;

  ----------------------------------------------------------------------
  -- the end data start at a lid when the pieces do

  module Lid (e : El Iv) (a0 : (W : Nat) -> Hom (lin W) X -> TB.EI (lin W))
    (lT0 : (W : Nat) (g : Hom (lin W) X) (i : Gm.L W e0 (Gm.pt W g))
           -> Id (TB.EI (lin W)) (T0.v W (Gm.p1g W g) (Gm.pv W g) (constH (lin W) Iv e)) (a0 W g))
    (lT1 : (W : Nat) (g : Hom (lin W) X) (i : Gm.L W e1 (Gm.pt W g))
           -> Id (TB.EI (lin W)) (T1.v W (Gm.p1g W g) (Gm.pv W g) (constH (lin W) Iv e)) (a0 W g))
    (lV0 : (W : Nat) (g : Hom (lin W) X) (i : Gm.L W e0 (Gm.pv W g))
           -> Id (TB.EI (lin W)) (V0.v W (Gm.p1g W g) (Gm.pt W g) (constH (lin W) Iv e)) (a0 W g))
    (lV1 : (W : Nat) (g : Hom (lin W) X) (i : Gm.L W e1 (Gm.pv W g))
           -> Id (TB.EI (lin W)) (V1.v W (Gm.p1g W g) (Gm.pt W g) (constH (lin W) Iv e)) (a0 W g)) {
    aEC (W : Nat) (g : Hom (lin W) X) : (c : Gm.C4 W g) -> Id (TB.EI (lin W)) (EvC W g (constH (lin W) Iv e) c) (a0 W g) = split {
      inl c -> aT c ;
      inr c -> aV c }
     where {
      aT : (c : Gm.CT W g) -> Id (TB.EI (lin W)) (EvT W g (constH (lin W) Iv e) c) (a0 W g) = split {
        inl i -> lT0 W g i ;
        inr i -> lT1 W g i } ;
      aV : (c : Gm.CV W g) -> Id (TB.EI (lin W)) (EvV W g (constH (lin W) Iv e) c) (a0 W g) = split {
        inl i -> lV0 W g i ;
        inr i -> lV1 W g i } ; } ;

    aE (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X Gm.endS g) : Id (TB.EI (lin W)) (Ev W g b (constH (lin W) Iv e)) (a0 W g) =
      aEC W g (Gm.cut W g b) ;
  } ;

  opaque agree ; opaque Evp ; opaque Evn ;
} ;

------------------------------------------------------------------------
-- two end data with equal pieces are equal

module E4Cmp (G : PP.PCtx) (B : PP.PTy[G]) (m : Nat) (xf : W0.Ix (G.ob (lin m)))
  (T0 T1 V0 V1 : Pc[G, B, m, xf])
  (c00 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T0.v W a (constH (lin W) Iv e0) j) (V0.v W a (constH (lin W) Iv e0) j))
  (c01 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T0.v W a (constH (lin W) Iv e1) j) (V1.v W a (constH (lin W) Iv e0) j))
  (c10 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T1.v W a (constH (lin W) Iv e0) j) (V0.v W a (constH (lin W) Iv e1) j))
  (c11 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T1.v W a (constH (lin W) Iv e1) j) (V1.v W a (constH (lin W) Iv e1) j))
  (xf2 : W0.Ix (G.ob (lin m)))
  (T02 T12 V02 V12 : Pc[G, B, m, xf2])
  (c002 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T02.v W a (constH (lin W) Iv e0) j) (V02.v W a (constH (lin W) Iv e0) j))
  (c012 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T02.v W a (constH (lin W) Iv e1) j) (V12.v W a (constH (lin W) Iv e0) j))
  (c102 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T12.v W a (constH (lin W) Iv e0) j) (V02.v W a (constH (lin W) Iv e1) j))
  (c112 : (W : Nat) (a : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T12.v W a (constH (lin W) Iv e1) j) (V12.v W a (constH (lin W) Iv e1) j))
  (eT0 : (W : Nat) (a : Hom (lin W) (lin m)) (k j : Hom (lin W) Iv) -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T0.v W a k j) (T02.v W a k j))
  (eT1 : (W : Nat) (a : Hom (lin W) (lin m)) (k j : Hom (lin W) Iv) -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (T1.v W a k j) (T12.v W a k j))
  (eV0 : (W : Nat) (a : Hom (lin W) (lin m)) (k j : Hom (lin W) Iv) -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (V0.v W a k j) (V02.v W a k j))
  (eV1 : (W : Nat) (a : Hom (lin W) (lin m)) (k j : Hom (lin W) Iv) -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (V1.v W a k j) (V12.v W a k j)) {
  module E1 = E4[G, B, m, xf, T0, T1, V0, V1, c00, c01, c10, c11] ;
  module E2 = E4[G, B, m, xf2, T02, T12, V02, V12, c002, c012, c102, c112] ;
  module Gm = Geo[m] ;
  module TB = PB.GPre[l].TyL[G, B] ;

  endC (W : Nat) (g : Hom (lin W) Gm.X) (j : Hom (lin W) Iv)
    : (cc : Gm.C4 W g) -> Id (TB.EI (lin W)) (E1.EvC W g j cc) (E2.EvC W g j cc) = split {
    inl cc -> eT cc ;
    inr cc -> eV cc }
   where {
    eT : (cc : Gm.CT W g) -> Id (TB.EI (lin W)) (E1.EvT W g j cc) (E2.EvT W g j cc) = split {
      inl i -> eT0 W (Gm.p1g W g) (Gm.pv W g) j ;
      inr i -> eT1 W (Gm.p1g W g) (Gm.pv W g) j } ;
    eV : (cc : Gm.CV W g) -> Id (TB.EI (lin W)) (E1.EvV W g j cc) (E2.EvV W g j cc) = split {
      inl i -> eV0 W (Gm.p1g W g) (Gm.pt W g) j ;
      inr i -> eV1 W (Gm.p1g W g) (Gm.pt W g) j } ; } ;

  endEq (W : Nat) (g : Hom (lin W) Gm.X) (b b2 : SP.Lands (lin W) Gm.X Gm.endS g) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (E1.Ev W g b j) (E2.Ev W g b2 j) =
    transH (endC W g j (Gm.cut W g b)) (apH (\ i -> E2.Ev W g i j) (SP.isProp-Lands (lin W) Gm.X Gm.endS g b b2)) ;
} ;
