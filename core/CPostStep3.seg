-- CPostStep3.seg (L9): step 3 of the construction of psi (postnikov.tex,
-- Theorem conv), at a simplex f : [m] -> X, m = m' + 1, and a stage
-- N >= m + 1.
--
-- Data: psi(f); the prism H = H^N(f) : [m] * [1] -> i*A from psi(f) at 0
-- (H0) to the reading of u_N along f at 1 (H1); the squares
-- Th y = Theta^{N+1}(f d_y) : [m'] * [1] * [1] -> i*A of the faces, with
-- their edges (Th-s1: H on the face at s = 1, Th-t0: psi at t = 0,
-- Th-t1: the reading of p_N at t = 1) and agreeing on common faces (FFt);
-- the ends of p_N (pe0 , pe1: at chains, p_N at 0 and 1 is u_{N+1} , u_N).
--
-- The open box of [m] * [1]_t * [1]_s with lid H at s = 1, sides Th y, psi
-- at t = 0 and p_N(f) at t = 1, is filled from e1: S3 is the instance of
-- CPostSq.SqS for B = A (S3z of SqZ, in CPostStep0).  E3 holds the
-- readings of p_N , u_N , u_{N+1} along f and the corners (End0 , End1):
--
--   Thf W g j      the square Theta^{N+1}(f) over [m] * [1]_t, line s
--   Thf-s1, -t0, -t1, -face     its edges and its faces
--   H' W g j       H^{N+1}(f) = Thf at s = 0, with H'0 , H'1 (u_{N+1}) , H'-face

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;
module SQ = CPostSq[a, l] ;

module E3 (G : PP.PCtx) (A : PP.PTy[G])
  (X : Ob) (x : W0.Ix (G.ob X)) (m : Nat) (f : Hom (lin m) X) (N : Nat) (hN : IsT (leb (suc m) N))
  (uN : LD.DT[G, CK.KT[G, A, N].KA].DEl X x) (uN1 : LD.DT[G, CK.KT[G, A, suc N].KA].DEl X x)
  (pN : LD.DT[G, CK.KT[G, A, N].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r (suc N))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pN.1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc N].rd (lin r) (G.act (lin r) X q x) (uN1.1 r q).1 r hr' (idH (lin r))))
  (pe1 : (r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pN.1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) X q x) (uN.1 r q).1 r hr (idH (lin r))))
  (psi : PB.GPre[l].TyL[G, A].EI (lin m)) (psi-pt : Id (W0.Ix (G.ob (lin m))) psi.1 (G.act (lin m) X f x))
  (H : (W : Nat) -> Hom (lin W) (lin m) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hp : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (H W g j).1 (G.act (lin W) (lin m) g (G.act (lin m) X f x)))
  (Hn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (H W g j))
              (H V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)))
  (H0 : (W : Nat) (g : Hom (lin W) (lin m))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin m) g psi))
  (H1 : (W : Nat) (g : Hom (lin W) (lin m))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e1))
              (PM.DR[G, A, N, X, x, uN, lin (m), EZ.HLin[m].ht, m, EZ.HLin[m].hB, EZ.HLin[m].hm, EZ.HLin[m].hi,
                     leb-trans (m) (suc (m)) N (leb-suc (m)) hN, f].val W g)) {
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;

  xf : W0.Ix (G.ob (lin m)) = G.act (lin m) X f x ;
  XI : Ob = prodP X Iv ;
  xI : W0.Ix (G.ob XI) = G.act XI X (pr1 X Iv) x ;

  module BX = BD.BXm[m, Iv] ;
  module HM = EZ.HLin[m] ;
  module H1v = EZ.HLin[suc zero] ;
  module HP = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, Iv, H1v.ht, suc zero, H1v.hB, H1v.hm, H1v.hi] ;
  xB : W0.Ix (G.ob BX.XB) = G.act BX.XB (lin m) BX.p1B xf ;

  -- the readings of p_N along f * [1], of u_N and u_{N+1} along f
  module DP = PM.DR[G, A, N, XI, xI, pN, BX.XB, HP.ht, plus m (suc zero), HP.hB, HP.hm, HP.hi, BD.leN m N hN, crossH (lin m) X Iv Iv f (idH Iv)] ;
  module DU = PM.DR[G, A, N, X, x, uN, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-trans m (suc m) N (leb-suc m) hN, f] ;
  module DU1 = PM.DR[G, A, suc N, X, x, uN1, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-trans m N (suc N) (leb-trans m (suc m) N (leb-suc m) hN) (leb-suc N), f] ;

  ----------------------------------------------------------------------
  -- points of the context

  -- f * [1] maps the point of X * [1] to the point of [m] * [1]
  ctxP : Id (W0.Ix (G.ob BX.XB)) (G.act BX.XB XI (crossH (lin m) X Iv Iv f (idH Iv)) xI) xB =
    calc (W0.Ix (G.ob BX.XB)) {
        G.act BX.XB XI (crossH (lin m) X Iv Iv f (idH Iv)) xI
      =< GL.actC BX.XB XI X (pr1 X Iv) (crossH (lin m) X Iv Iv f (idH Iv)) x >
        G.act BX.XB X (compH BX.XB XI X (pr1 X Iv) (crossH (lin m) X Iv Iv f (idH Iv))) x
      =< apH (\ k -> G.act BX.XB X k x) (pr1-pair X Iv BX.XB (compH BX.XB (lin m) X f BX.p1B) (compH BX.XB Iv Iv (idH Iv) (pr2 (lin m) Iv))) >
        G.act BX.XB X (compH BX.XB (lin m) X f BX.p1B) x
      =< G.act-o BX.XB (lin m) X f BX.p1B x >
        xB } ;

  -- p_N at s = 1 is u_N
  module End1 (W : Nat) (g : Hom (lin W) (lin m)) {
    module D1 = PM.DRI[G, A, N, XI, xI, pN, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-trans m (suc m) N (leb-suc m) hN,
                       BX.XB, HP.ht, plus m (suc zero), HP.hB, HP.hm, HP.hi, BD.leN m N hN,
                       crossH (lin m) X Iv Iv f (idH Iv), lid (lin m) e1, BD.lid-strict (lin m) e1, W, g] ;
    module Z = PM.DRZ[G, A, N, N, XI, xI, pN, X, x, uN, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi,
                      leb-trans m (suc m) N (leb-suc m) hN, leb-trans m (suc m) N (leb-suc m) hN,
                      compH (lin m) BX.XB XI (crossH (lin m) X Iv Iv f (idH Iv)) (lid (lin m) e1), f,
                      \ r hr hr' cc -> transH (apH (\ k -> D1.D1.zc r hr k)
                                         (transH (apH (\ k -> compH (lin r) (lin m) XI k cc) (BD.cross-lid (lin m) X f e1))
                                                 (comp-assoc (lin r) (lin m) X XI (lid X e1) f cc)))
                                       (transH (pe1 r hr (compH (lin r) (lin m) X f cc))
                                               (CK.KT[G, A, N].rd-irr (lin r) (G.act (lin r) X (compH (lin r) (lin m) X f cc) x)
                                                  (uN.1 r (compH (lin r) (lin m) X f cc)).1 r hr hr' (idH (lin r)))),
                      W, g] ;
    res : Id (TA.EI (lin W)) (DP.val W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1))) (DU.val W g) =
      transH (apH (DP.val W) (transH (apH (\ k -> pairH (lin m) Iv (lin W) k (constH (lin W) Iv e1)) (symH (comp-idl (lin W) (lin m) g)))
                                (transH (apH (pairH (lin m) Iv (lin W) (compH (lin W) (lin m) (lin m) (idH (lin m)) g)) (symH (BD.const-h (lin W) (lin m) g e1)))
                                        (symH (BD.pair-h (lin m) Iv (lin W) (lin m) (idH (lin m)) (constH (lin m) Iv e1) g)))))
        (transH (symH D1.res) Z.res) ;
  } ;

  -- p_N at s = 0 is u_{N+1}
  module End0 (W : Nat) (g : Hom (lin W) (lin m)) {
    module D1 = PM.DRI[G, A, N, XI, xI, pN, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-trans m (suc m) N (leb-suc m) hN,
                       BX.XB, HP.ht, plus m (suc zero), HP.hB, HP.hm, HP.hi, BD.leN m N hN,
                       crossH (lin m) X Iv Iv f (idH Iv), lid (lin m) e0, BD.lid-strict (lin m) e0, W, g] ;
    hm1 : IsT (leb m (suc N)) = leb-trans m N (suc N) (leb-trans m (suc m) N (leb-suc m) hN) (leb-suc N) ;
    module Z = PM.DRZ[G, A, N, suc N, XI, xI, pN, X, x, uN1, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi,
                      leb-trans m (suc m) N (leb-suc m) hN, hm1,
                      compH (lin m) BX.XB XI (crossH (lin m) X Iv Iv f (idH Iv)) (lid (lin m) e0), f,
                      \ r hr hr' cc -> transH (apH (\ k -> D1.D1.zc r hr k)
                                         (transH (apH (\ k -> compH (lin r) (lin m) XI k cc) (BD.cross-lid (lin m) X f e0))
                                                 (comp-assoc (lin r) (lin m) X XI (lid X e0) f cc)))
                                       (pe0 r hr hr' (compH (lin r) (lin m) X f cc)),
                      W, g] ;
    res : Id (TA.EI (lin W)) (DP.val W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0))) (DU1.val W g) =
      transH (apH (DP.val W) (transH (apH (\ k -> pairH (lin m) Iv (lin W) k (constH (lin W) Iv e0)) (symH (comp-idl (lin W) (lin m) g)))
                                (transH (apH (pairH (lin m) Iv (lin W) (compH (lin W) (lin m) (lin m) (idH (lin m)) g)) (symH (BD.const-h (lin W) (lin m) g e0)))
                                        (symH (BD.pair-h (lin m) Iv (lin W) (lin m) (idH (lin m)) (constH (lin m) Iv e0) g)))))
        (transH (symH D1.res) Z.res) ;
  } ;


  -- the t = 1 edge: p_N(f) over the point of [m] * [1]
  Plp (W : Nat) (g : Hom (lin W) BX.XB) : Id (W0.Ix (G.ob (lin W))) (DP.val W g).1 (G.act (lin W) BX.XB g xB) =
    transH (DP.vp W g) (apH (G.act (lin W) BX.XB g) ctxP) ;

  -- the corner t = 1 of the lid
  L1 (W : Nat) (g : Hom (lin W) (lin m))
    : Id (TA.EI (lin W)) (H W g (constH (lin W) Iv e1)) (DP.val W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1))) =
    transH (H1 W g) (symH End1[W, g].res) ;

  module SE = SQ.SqE[G, A, m, xf, e1, psi, psi-pt, H, Hp, Hn, DP.val, Plp, DP.vn, H0, L1] ;

  -- H^{N+1}(f) = Theta at s = 0, from the edges of the filled square
  module HT (Thf : (W : Nat) -> Hom (lin W) BX.XB -> Hom (lin W) Iv -> TA.EI (lin W))
    (Thf-p : (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) BX.XB g xB))
    (Thf-n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
             -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) BX.XB g h) (compH (lin V) (lin W) Iv j h)))
    (Thf-t0 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TA.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin m) g psi))
    (Thf-t1 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TA.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j) (DP.val W (pairH (lin m) Iv (lin W) g j))) {
    module Q = SE.HT[Thf, Thf-p, Thf-n, Thf-t0, Thf-t1, e0] ;

    H' (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TA.EI (lin W) = Q.H' W g j ;

    H'p (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (H' W g j).1 (G.act (lin W) (lin m) g xf) =
      Q.H'p W g j ;

    H'n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (H' W g j)) (H' V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)) =
      Q.H'n V W h g j ;

    H'0 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TA.EI (lin W)) (H' W g (constH (lin W) Iv e0)) (TA.E.act (lin W) (lin m) g psi) =
      Q.H'0 W g ;

    H'1 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TA.EI (lin W)) (H' W g (constH (lin W) Iv e1)) (DU1.val W g) =
      transH (Q.H'1 W g) End0[W, g].res ;

    opaque H'1 ;
  } ;
} ;

module S3 (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W0.Ix (G.ob X)) (m' : Nat) (f : Hom (lin (suc m')) X) (N : Nat) (hN : IsT (leb (suc (suc m')) N))
  (uN : LD.DT[G, CK.KT[G, A, N].KA].DEl X x) (uN1 : LD.DT[G, CK.KT[G, A, suc N].KA].DEl X x)
  (pN : LD.DT[G, CK.KT[G, A, N].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r (suc N))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pN.1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc N].rd (lin r) (G.act (lin r) X q x) (uN1.1 r q).1 r hr' (idH (lin r))))
  (pe1 : (r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pN.1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) X q x) (uN.1 r q).1 r hr (idH (lin r))))
  (psi : PB.GPre[l].TyL[G, A].EI (lin (suc m'))) (psi-pt : Id (W0.Ix (G.ob (lin (suc m')))) psi.1 (G.act (lin (suc m')) X f x))
  (H : (W : Nat) -> Hom (lin W) (lin (suc m')) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hp : (W : Nat) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (H W g j).1 (G.act (lin W) (lin (suc m')) g (G.act (lin (suc m')) X f x)))
  (Hn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (H W g j))
              (H V (compH (lin V) (lin W) (lin (suc m')) g h) (compH (lin V) (lin W) Iv j h)))
  (H0 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin (suc m')) g psi))
  (H1 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e1))
              (PM.DR[G, A, N, X, x, uN, lin (suc m'), EZ.HLin[suc m'].ht, suc m', EZ.HLin[suc m'].hB, EZ.HLin[suc m'].hm, EZ.HLin[suc m'].hi,
                     leb-trans (suc m') (suc (suc m')) N (leb-suc (suc m')) hN, f].val W g))
  (Th : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Iv) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Thp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Th y hy W g j).1
               (G.act (lin W) (prodP (lin m') Iv) g (G.act (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv)
                  (G.act (lin m') X (compH (lin m') (lin (suc m')) X f (dl m' y)) x))))
  (Thn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (Th y hy W g j))
               (Th y hy V (compH (lin V) (lin W) (prodP (lin m') Iv) g h) (compH (lin V) (lin W) Iv j h)))
  (Th-s1 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv))
           -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W g (constH (lin W) Iv e1))
                 (H W (compH (lin W) (lin m') (lin (suc m')) (dl m' y) (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g))
                      (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)))
  (Th-t0 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                 (PB.GPre[l].TyL[G, A].E.act (lin W) (lin (suc m')) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) psi))
  (Th-t1 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                 (PM.DR[G, A, N, prodP X Iv, G.act (prodP X Iv) X (pr1 X Iv) x, pN,
                        prodP (lin m') Iv, EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                                     Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].ht,
                        plus m' (suc zero),
                        EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                 Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].hB,
                        EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                 Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].hm,
                        EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                 Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].hi,
                        BD.leN m' N (leb-trans (suc m') (suc (suc m')) N (leb-suc (suc m')) hN),
                        crossH (lin m') X Iv Iv (compH (lin m') (lin (suc m')) X f (dl m' y)) (idH Iv)].val W (pairH (lin m') Iv (lin W) g j)))
  (FFt : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
         (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         (msy : Miss (lin W) m' y (BD.BG[m', Iv].p1g W g)) (msz : Miss (lin W) m' z (BD.BG[m', Iv].p1g W g)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W (BD.BG[m', Iv].gy y W g) j) (Th z hz W (BD.BG[m', Iv].gy z W g) j)) {
  m : Nat = suc m' ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;
  module RG = CLocRestr[a, l].R[G] ;
  module FF = CDFill[a, l].FF[RG.iG, RG.T[A].iA, CLocHorn[a, l].HornOfFib[G, A, c].horn] ;

  module E = E3[G, A, X, x, suc m', f, N, hN, uN, uN1, pN, pe0, pe1, psi, psi-pt, H, Hp, Hn, H0, H1] ;
  module BG = BD.BG[m', Iv] ;
  Xf : Ob = BG.Xf ;
  module HMf = EZ.HLin[m'] ;

  -- the point of a face
  ptD (y : Nat) : Id (W0.Ix (G.ob Xf)) (G.act Xf (lin m') (pr1 (lin m') Iv) (G.act (lin m') X (compH (lin m') (lin m) X f (dl m' y)) x))
                                       (G.act Xf E.BX.XB (BG.dY y) E.xB) =
    calc (W0.Ix (G.ob Xf)) {
        G.act Xf (lin m') (pr1 (lin m') Iv) (G.act (lin m') X (compH (lin m') (lin m) X f (dl m' y)) x)
      =< apH (G.act Xf (lin m') (pr1 (lin m') Iv)) (G.act-o (lin m') (lin m) X f (dl m' y) x) >
        G.act Xf (lin m') (pr1 (lin m') Iv) (G.act (lin m') (lin m) (dl m' y) E.xf)
      =< GL.actC Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Iv) E.xf >
        G.act Xf (lin m) (compH Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Iv)) E.xf
      =< apH (\ k -> G.act Xf (lin m) k E.xf) (symH (BG.pr1-dY y)) >
        G.act Xf (lin m) (compH Xf E.BX.XB (lin m) E.BX.p1B (BG.dY y)) E.xf
      =< G.act-o Xf E.BX.XB (lin m) E.BX.p1B (BG.dY y) E.xf >
        G.act Xf E.BX.XB (BG.dY y) E.xB } ;

  ----------------------------------------------------------------------
  -- the box (CPostSq.SqS): lid H at s = 1, sides Th y

  Thp' (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob (lin W))) (Th y hy W g j).1 (G.act (lin W) Xf g (G.act Xf E.BX.XB (BG.dY y) E.xB)) =
    transH (Thp y hy W g j) (apH (G.act (lin W) Xf g) (ptD y)) ;

  -- d_y * [1] is strict, and f * [1] after it is (f d_y) * [1]
  dIst (y : Nat) : Strict Xf E.BX.XB (crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv)) = BD.cross-strict m' m (dl m' y) (dl-strict m' y) ;

  fd1 (y : Nat) : Id (Hom Xf E.XI) (compH Xf E.BX.XB E.XI (crossH (lin m) X Iv Iv f (idH Iv)) (crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv)))
                                 (crossH (lin m') X Iv Iv (compH (lin m') (lin m) X f (dl m' y)) (idH Iv)) =
    transH (BD.cross-comp (lin m') (lin m) X Iv Iv Iv f (idH Iv) (dl m' y) (idH Iv))
           (apH (crossH (lin m') X Iv Iv (compH (lin m') (lin m) X f (dl m' y))) (comp-idl Iv Iv (idH Iv))) ;

  -- the face reading of p_N is the reading along f * [1], on the face
  module FaceP (y : Nat) (W : Nat) (g : Hom (lin W) Xf) {
    module HPf = EZ.HProd[lin m', HMf.ht, m', HMf.hB, HMf.hm, HMf.hi, Iv, E.H1v.ht, suc zero, E.H1v.hB, E.H1v.hm, E.H1v.hi] ;
    phiF (k : Hom Xf E.XI) : TA.EI (lin W) =
      PM.DR[G, A, N, E.XI, E.xI, pN, Xf, HPf.ht, plus m' (suc zero), HPf.hB, HPf.hm, HPf.hi, BD.leN m' N (leb-trans (suc m') (suc (suc m')) N (leb-suc (suc m')) hN), k].val W g ;
    module D1 = PM.DRI[G, A, N, E.XI, E.xI, pN, Xf, HPf.ht, plus m' (suc zero), HPf.hB, HPf.hm, HPf.hi, BD.leN m' N (leb-trans (suc m') (suc (suc m')) N (leb-suc (suc m')) hN),
                       E.BX.XB, E.HP.ht, plus m (suc zero), E.HP.hB, E.HP.hm, E.HP.hi, BD.leN m N hN,
                       crossH (lin m) X Iv Iv f (idH Iv), crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv), dIst y, W, g] ;
    res : Id (TA.EI (lin W)) (phiF (crossH (lin m') X Iv Iv (compH (lin m') (lin m) X f (dl m' y)) (idH Iv)))
                                (E.DP.val W (compH (lin W) Xf E.BX.XB (crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv)) g)) =
      transH (apH phiF (symH (fd1 y))) D1.res ;
  } ;

  -- the side at t = 1 is p_N(f) on the face
  Th-t1' (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                         (E.DP.val W (pairH (lin m) Iv (lin W) (compH (lin W) (lin m') (lin m) (dl m' y) g) j)) =
    transH (Th-t1 y hy W g j)
      (transH FaceP[y, W, pairH (lin m') Iv (lin W) g j].res
        (apH (E.DP.val W)
           (transH (BD.cross-pair (lin m') (lin m) Iv Iv (lin W) (dl m' y) (idH Iv) g j)
                   (apH (pairH (lin m) Iv (lin W) (compH (lin W) (lin m') (lin m) (dl m' y) g)) (comp-idl (lin W) Iv j))))) ;

  module Sq = SQ.SqS[G, A, e1, FF.S.fill, FF.S.sides, FF.S.face, m', E.xf, psi, psi-pt, H, Hp, Hn, E.DP.val, E.Plp, E.DP.vn, H0, E.L1,
                     Th, Thp', Thn, Th-s1, Th-t0, Th-t1', FFt] ;

  ----------------------------------------------------------------------
  -- Theta^{N+1}(f) and its edges

  Thf (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : TA.EI (lin W) = Sq.Thf W g j ;

  Thf-p (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) E.BX.XB g E.xB) = Sq.Thf-p W g j ;

  Thf-n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) E.BX.XB g h) (compH (lin V) (lin W) Iv j h)) =
    Sq.Thf-n V W h g j ;

  Thf-s1 (W : Nat) (g : Hom (lin W) E.BX.XB) : Id (TA.EI (lin W)) (Thf W g (constH (lin W) Iv e1)) (H W (BG.p1g W g) (BG.p2g W g)) = Sq.Thf-e W g ;

  Thf-t0 (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin m) g psi) = Sq.Thf-t0 W g j ;

  Thf-t1 (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j) (E.DP.val W (pairH (lin m) Iv (lin W) g j)) = Sq.Thf-t1 W g j ;

  -- on the face y it is Th y
  Thf-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (Thf W (compH (lin W) Xf E.BX.XB (BG.dY y) g) j) (Th y hy W g j) = Sq.Thf-face y hy W g j ;

  module HH = E.HT[Thf, Thf-p, Thf-n, Thf-t0, Thf-t1] ;
  H' (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TA.EI (lin W) = HH.H' W g j ;

  -- on the face y, H^{N+1}(f) is Th y at s = 0
  H'-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (H' W (compH (lin W) (lin m') (lin m) (dl m' y) g) j)
                         (Th y hy W (pairH (lin m') Iv (lin W) g j) (constH (lin W) Iv e0)) = Sq.HT[e0].H'-face y hy W g j ;
} ;
