-- CGlueCartNat.seg (L6, inside CB): a glue datum read through carts is
-- natural.  For data at X (CGlueCart) and data at J for the restriction
-- along h : J -> X (the same target triple and equivalence), whose B-codes
-- are those of X at h g (PB) and whose carts agree with X's at h g (PtA ,
-- PtB), the restriction along h of the first glue datum is the second.
-- The codes agree by gdExt; the equivalence by transport = move
-- (CTrEq.lemT), moving twice = moving along the composite (HComp), and
-- the composite carts agree pointwise (HCong).
--
-- Instances: the uniformity of univalence, steps (a) and (b).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module GCN
  (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (X : Ob) (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) (ph : Phi X)
  (B : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BTy X ph)
  (bn : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BNat X ph B)
  (G : L.PCtx) (Bg Ag : L.PTy[G]) (alg : CPartial[a+].PMap[G, Bg, Ag]) (eg : CEquiv[a+].EquivOp G Bg Ag alg)
  (io : (W : Ob) -> W0.Ix ((CGlueE.RCm[X, ph].RC).ob W) -> V1.Ix (G.ob W))
  (io-nat : (V W : Ob) (g : Hom V W) (r : W0.Ix ((CGlueE.RCm[X, ph].RC).ob W))
     -> Id (V1.Ix (G.ob V)) (io V ((CGlueE.RCm[X, ph].RC).act V W g r)) (G.act V W g (io W r)))
  -- the A-cart
  (tA : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W -> LP.TyL[G, Ag].EI W)
  (tApt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (V1.Ix (G.ob W)) (tA W v).1 (io W v.1))
  (tAnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (tA W v))
          (tA V (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].E.act V W g v)))
  (tAinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (tA W v) (tA W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W) v v')
  (bkA : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x))) -> W0.Ix (F.1.tob Y x.1))
  (bkAta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x)))
     -> Id (LP.TyL[G, Ag].EI Y) (tA Y (x, bkA Y x z)) (io Y x, z))
  -- the B-cart
  (tB : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W -> LP.TyL[G, Bg].EI W)
  (tBpt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (V1.Ix (G.ob W)) (tB W v).1 (io W v.1))
  (tBnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (tB W v))
          (tB V (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].E.act V W g v)))
  (tBinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (tB W v) (tB W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W) v v')
  (bkB : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> W0.Ix ((CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn).tob Y x))
  (bkBta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> Id (LP.TyL[G, Bg].EI Y) (tB Y (x, bkB Y x z)) (io Y x, z))
  (J : Ob) (h : Hom J X)
  (B' : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BTy J (pre J X h ph))
  (bn' : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BNat J (pre J X h ph) B')
  (io' : (W : Ob) -> W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob W) -> V1.Ix (G.ob W))
  (io-nat' : (V W : Ob) (g : Hom V W) (r : W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob W))
     -> Id (V1.Ix (G.ob V)) (io' V ((CGlueE.RCm[J, pre J X h ph].RC).act V W g r)) (G.act V W g (io' W r)))
  -- the A-cart
  (tA' : (W : Ob) -> GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].EI W -> LP.TyL[G, Ag].EI W)
  (tApt' : (W : Ob) (v : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].EI W)
     -> Id (V1.Ix (G.ob W)) (tA' W v).1 (io' W v.1))
  (tAnat' : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (tA' W v))
          (tA' V (GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].E.act V W g v)))
  (tAinj' : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (tA' W v) (tA' W v'))
     -> Id (GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].EI W) v v')
  (bkA' : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io' Y x))) -> W0.Ix ((CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1.tob Y x.1))
  (bkAta' : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io' Y x)))
     -> Id (LP.TyL[G, Ag].EI Y) (tA' Y (x, bkA' Y x z)) (io' Y x, z))
  -- the B-cart
  (tB' : (W : Ob) -> GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn'].EI W -> LP.TyL[G, Bg].EI W)
  (tBpt' : (W : Ob) (v : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn'].EI W)
     -> Id (V1.Ix (G.ob W)) (tB' W v).1 (io' W v.1))
  (tBnat' : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn'].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (tB' W v))
          (tB' V (GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn'].E.act V W g v)))
  (tBinj' : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn'].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (tB' W v) (tB' W v'))
     -> Id (GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn'].EI W) v v')
  (bkB' : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io' Y x)))
     -> W0.Ix ((CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf J (pre J X h ph) B' bn').tob Y x))
  (bkBta' : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io' Y x)))
     -> Id (LP.TyL[G, Bg].EI Y) (tB' Y (x, bkB' Y x z)) (io' Y x, z))
  -- the comparison of the two data
  (PB : (W : Ob) (g : Hom W J) (q : IsT (CGlueD.fl J (pre J X h ph) W g)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h g)))
     -> Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W) (B W (compH W J X h g) q2) (B' W g q))
  (PtA : (W : Ob) (v : GPR.TyL[CGlueE.RCm[J, pre J X h ph].RC, subTy (CGlueE.RCm[J, pre J X h ph].RC) (yP J) (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].uAct J X h F).1 CGlueE.RCm[J, pre J X h ph].inclRC].EI W)
     (q2 : IsT (CGlueD.fl X ph W (compH W J X h v.1.1)))
     -> Id (LP.TyL[G, Ag].EI W) (tA' W v) (tA W ((compH W J X h v.1.1, q2), v.2)))
  (PtB : (W : Ob) (r : W0.Ix ((CGlueE.RCm[J, pre J X h ph].RC).ob W)) (q2 : IsT (CGlueD.fl X ph W (compH W J X h r.1)))
     (b : W0.Ix (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].fib0 W (B W (compH W J X h r.1) q2)))
     -> Id (LP.TyL[G, Bg].EI W)
           (tB' W (r, subst (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W) (\ G2 -> W0.Ix (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].fib0 W G2)) (B W (compH W J X h r.1) q2) (B' W r.1 r.2) (PB W r.1 r.2 q2) b))
           (tB W ((compH W J X h r.1, q2), b))) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GLw = CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module D = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta] ;
  module D' = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, J, UU.uAct J X h F, pre J X h ph, B', bn', G, Bg, Ag, alg, eg, io', io-nat', tA', tApt', tAnat', tAinj', bkA', bkAta', tB', tBpt', tBnat', tBinj', bkB', bkBta'] ;
  module RX = CGlueE.RCm[X, ph] ;
  module RJ = CGlueE.RCm[J, pre J X h ph] ;
  module TAg = LP.TyL[G, Ag] ;
  module TBg = LP.TyL[G, Bg] ;

  d0 : DD.GD0 X = (F, (ph, D.bd0)) ;
  c1 : DD.GD0 J = DD.gdAct J X h d0 ;
  c : DD.GD0 J = (UU.uAct J X h F, (pre J X h ph, D'.bd0)) ;

  qh (W : Ob) (g : Hom W J) (q : IsT (CGlueD.fl J (pre J X h ph) W g)) : IsT (CGlueD.fl X ph W (compH W J X h g)) =
    CGlueD.fl-pre J X h ph W g q ;

  -- alpha agrees
  Palx (W : Ob) (g : Hom W J) (q q' : IsT (CGlueD.fl J (pre J X h ph) W g)) (b : W0.Ix (UU.fib0 W (B W (compH W J X h g) (qh W g q))))
    : Id (W0.Ix (F.1.tob W (compH W J X h g))) (D.al W (compH W J X h g) (qh W g q) b)
         (D'.al W g q' (DD.trB W (B W (compH W J X h g) (qh W g q)) (B' W g q') (PB W g q' (qh W g q)) b)) =
    D'.TAt.pr-inj W (g, q') (D.al W (compH W J X h g) (qh W g q) b)
      (D'.al W g q' (DD.trB W (B W (compH W J X h g) (qh W g q)) (B' W g q') (PB W g q' (qh W g q)) b))
      (tAinj' W ((g, q'), D.al W (compH W J X h g) (qh W g q) b)
         ((g, q'), D'.al W g q' (DD.trB W (B W (compH W J X h g) (qh W g q)) (B' W g q') (PB W g q' (qh W g q)) b))
         (refl (g, q'))
         (transH (PtA W ((g, q'), D.al W (compH W J X h g) (qh W g q) b) (qh W g q))
           (transH (D.al-g W (compH W J X h g, qh W g q) b)
             (symH (transH (D'.al-g W (g, q') (DD.trB W (B W (compH W J X h g) (qh W g q)) (B' W g q') (PB W g q' (qh W g q)) b))
                           (apH (alg.mE W) (PtB W (g, q') (qh W g q) b))))))) ;

  P : Id (DD.GD0 J) c1 c =
    DD.gdExt J (UU.uAct J X h F) (UU.uAct J X h F) (refl (UU.uAct J X h F)) (pre J X h ph) (pre J X h ph) (refl (pre J X h ph))
      (DD.gdAct J X h d0).2.2 D'.bd0
      (\ W g q q' -> PB W g q' (qh W g q))
      (\ W g q q' b -> Palx W g q q' b) ;

  ----------------------------------------------------------------------
  -- the equivalence component

  module PW = GLw.Pw[J, c1] ;
  module TR = PW.TR ;
  module CH = GE.Chi[J, X, h, d0] ;

  module HC1 = CHFibLaws[a, a, a].HComp[GLw.Gf J c, GLw.Bf J c, GLw.Af J c, GLw.alf J c, GLw.Gf J c1, GLw.Bf J c1, GLw.Af J c1, GLw.alf J c1, GLw.Gf X d0, GLw.Bf X d0, GLw.Af X d0, GLw.alf X d0,
    TR.s c P, TR.s-nat c P, TR.tA c P, TR.tApt c P, TR.tAnat c P, TR.tAinj c P, TR.bkA c P, TR.bkAta c P, TR.tB c P, TR.tBpt c P, TR.tBnat c P, TR.tBinj c P, TR.bkB c P, TR.bkBta c P, TR.comm c P,
    CH.sl.nt, CH.sl.nt-nat, CH.tA, \ W v -> refl (CH.sl.nt W v.1), CH.tAnat, CH.tAinj, \ X0 x u -> u, \ X0 x u -> refl (CH.sl.nt X0 x, u), CH.tB, \ W v -> refl (CH.sl.nt W v.1), CH.tBnat, CH.tBinj, \ X0 x u -> u, \ X0 x u -> refl (CH.sl.nt X0 x, u), \ W v -> refl (CH.tA W (CH.T1.al.mE W v)), D.H.moveEq eg] ;

  module HC2 = CHFibLaws[a, a, a+].HComp[GLw.Gf J c, GLw.Bf J c, GLw.Af J c, GLw.alf J c, GLw.Gf X d0, GLw.Bf X d0, GLw.Af X d0, GLw.alf X d0, G, Bg, Ag, alg,
    HC1.s, HC1.s-nat, HC1.tA, HC1.tApt, HC1.tAnat, HC1.tAinj, HC1.bkA, HC1.bkAta, HC1.tB, HC1.tBpt, HC1.tBnat, HC1.tBinj, HC1.bkB, HC1.bkBta, HC1.comm,
    io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta, D.comm, eg] ;

  liftR (W : Ob) (r : W0.Ix (RJ.RC.ob W)) : W0.Ix (RX.RC.ob W) = (compH W J X h r.1, qh W r.1 r.2) ;

  -- the transported point, lifted, is the lift
  ptE (W : Ob) (r : W0.Ix (RJ.RC.ob W)) : Id (W0.Ix (RX.RC.ob W)) (CH.sl.nt W (TR.s c P W r)) (liftR W r) =
    RX.pt-eq W (CH.sl.nt W (TR.s c P W r)) (liftR W r) (apH (compH W J X h) (PW.L1 c P W r)) ;

  PtA2 (W : Ob) (v : TR.TA c W) : Id (TAg.EI W) (HC2.tA W v) (tA' W v) =
    transH (apH (\ z -> tA W (CH.tA W z)) (PW.L2A c P W v.1 v.2))
      (transH (apH (tA W)
         (CGlueLaws.pair-eqV (W0.Ix (RX.RC.ob W)) (\ y -> F.1.tob W y.1) (CH.sl.nt W (TR.s c P W v.1)) (liftR W v.1) (ptE W v.1)
            (subst W0.V (\ u -> W0.Ix u) ((GLw.Af J c).tob W v.1) ((GLw.Af J c1).tob W (TR.s c P W v.1)) (PW.QA c P W v.1) v.2) v.2
            (symH (PW.QA c P W v.1))
            (CGlueLaws.subst-inv ((GLw.Af J c).tob W v.1) ((GLw.Af J c1).tob W (TR.s c P W v.1)) (PW.QA c P W v.1) v.2)))
        (symH (PtA W v (qh W v.1.1 v.1.2)))) ;

  PtB2 (W : Ob) (v : TR.TB c W) : Id (TBg.EI W) (HC2.tB W v) (tB' W v) =
    transH (apH (\ z -> tB W (CH.tB W z)) (PW.L2B c P W v.1 v.2))
     (transH (apH (tB W)
        (CGlueLaws.pair-eqV (W0.Ix (RX.RC.ob W)) (\ y -> UU.fib0 W (B W y.1 y.2)) (CH.sl.nt W (TR.s c P W v.1)) (liftR W v.1) (ptE W v.1)
           (subst W0.V (\ u -> W0.Ix u) ((GLw.Bf J c).tob W v.1) ((GLw.Bf J c1).tob W (TR.s c P W v.1)) (PW.QB c P W v.1) v.2)
           (DD.trB W (B' W v.1.1 v.1.2) (B W (compH W J X h v.1.1) (qh W v.1.1 v.1.2)) (symH (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2))) v.2)
           (transH (symH (PW.QB c P W v.1)) (apH (UU.fib0 W) (symH (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2)))))
           (transH (CExtEq1.sV-two ((GLw.Bf J c).tob W v.1) ((GLw.Bf J c1).tob W (TR.s c P W v.1)) (UU.fib0 W (B W (compH W J X h v.1.1) (qh W v.1.1 v.1.2)))
                      (PW.QB c P W v.1) (transH (symH (PW.QB c P W v.1)) (apH (UU.fib0 W) (symH (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2)))))
                      (apH (UU.fib0 W) (symH (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2)))) v.2)
                   (symH (UU.substF W (B' W v.1.1 v.1.2) (B W (compH W J X h v.1.1) (qh W v.1.1 v.1.2)) (symH (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2))) v.2)))))
      (transH (symH (PtB W v.1 (qh W v.1.1 v.1.2)
                 (DD.trB W (B' W v.1.1 v.1.2) (B W (compH W J X h v.1.1) (qh W v.1.1 v.1.2)) (symH (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2))) v.2)))
              (apH (\ z -> tB' W (v.1, z))
                 (CExtEq1.subst-round' (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (B W (compH W J X h v.1.1) (qh W v.1.1 v.1.2)) (B' W v.1.1 v.1.2)
                    (PB W v.1.1 v.1.2 (qh W v.1.1 v.1.2)) v.2)))) ;

  opaque ptE ; opaque PtA2 ; opaque PtB2 ;

  eqPart : Id (GE.EqOn J c) (subst (DD.GD0 J) (GE.EqOn J) c1 c P (CH.H.moveEq (D.H.moveEq eg))) (D'.H.moveEq eg) =
    transH (TR.lemT c P (CH.H.moveEq (D.H.moveEq eg)))
     (transH HC1.comp
      (transH HC2.comp
       (CHFibLaws[a, a, a+].HCong[GLw.Gf J c, GLw.Bf J c, GLw.Af J c, GLw.alf J c, G, Bg, Ag, alg,
          HC2.s, HC2.s-nat, HC2.tA, HC2.tApt, HC2.tAnat, HC2.tAinj, HC2.bkA, HC2.bkAta, HC2.tB, HC2.tBpt, HC2.tBnat, HC2.tBinj, HC2.bkB, HC2.bkBta, HC2.comm,
          io', io-nat', tA', tApt', tAnat', tAinj', bkA', bkAta', tB', tBpt', tBnat', tBinj', bkB', bkBta', D'.comm,
          PtA2, PtB2, eg].cong))) ;

  -- the restriction along h of the glue datum is the glue datum of the restriction
  law : Id (GE.GD1 J) (GE.act1 J X h D.dat) D'.dat =
    Sigma-path (DD.GD0 J) (GE.EqOn J) c1 c (CH.H.moveEq (D.H.moveEq eg)) (D'.H.moveEq eg) P eqPart ;
} ;
