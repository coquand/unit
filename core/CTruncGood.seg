-- Hereditary naturality is a proposition; normal forms have small set codes.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ; module EN = Encode[l, l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module GoodSets (G : PCtx) (A : PTy[G]) {
  open CTruncRaw[a, l].Build[G, A] ;
  module C = CTruncCode[a, l].Code[G, A] ;
  module NodeProps (z : Loc) (Q : PB.Phi z.1)
    (u : (s : Loc) -> Arr s z -> Raw)
    (v : (s : Loc) (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> Raw)
    (pu : (s : Loc) (h : Arr s z) -> isProp (Good (u s h)))
    (pv : (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) -> isProp (Good (v s h i))) {
    GU : U l = (s : Loc) -> (h : Arr s z) -> Good (u s h) * Id Loc (root (u s h)) s ;
    pGU : isProp GU =
      isProp-Pi (Loc) (\ s -> (h : Arr s z) -> Good (u s h) * Id Loc (root (u s h)) s) (\ s ->
        isProp-Pi (Arr s z) (\ h -> Good (u s h) * Id Loc (root (u s h)) s) (\ h ->
        isProp-Sigma (Good (u s h)) (\ unused -> Id Loc (root (u s h)) s) (pu s h) (\ unused -> loc-set (root (u s h)) s))) ;
    GV : U l = (s : Loc) -> (h : Arr s z) -> (i : PB.Lands s.1 z.1 Q h.1) -> Good (v s h i) * Id Loc (root (v s h i)) s ;
    pGV : isProp GV =
      isProp-Pi (Loc) (\ s -> (h : Arr s z) -> (i : PB.Lands s.1 z.1 Q h.1) -> Good (v s h i) * Id Loc (root (v s h i)) s) (\ s ->
        isProp-Pi (Arr s z) (\ h -> (i : PB.Lands s.1 z.1 Q h.1) -> Good (v s h i) * Id Loc (root (v s h i)) s) (\ h ->
        isProp-Pi (PB.Lands s.1 z.1 Q h.1) (\ i -> Good (v s h i) * Id Loc (root (v s h i)) s) (\ i ->
        isProp-Sigma (Good (v s h i)) (\ unused -> Id Loc (root (v s h i)) s) (pv s h i) (\ unused -> loc-set (root (v s h i)) s)))) ;
    NU : U l = (s : Loc) -> (h : Arr s z) -> (r : Loc) -> (g : Arr r s) -> (e : Id Loc (root (u s h)) s) -> Id Raw (at (u s h) s e r g) (u r (compose r s z h g)) ;
    pNU : isProp NU =
      isProp-Pi (Loc) (\ s -> (h : Arr s z) -> (r : Loc) -> (g : Arr r s) -> (e : Id Loc (root (u s h)) s) -> Id Raw (at (u s h) s e r g) (u r (compose r s z h g))) (\ s ->
        isProp-Pi (Arr s z) (\ h -> (r : Loc) -> (g : Arr r s) -> (e : Id Loc (root (u s h)) s) -> Id Raw (at (u s h) s e r g) (u r (compose r s z h g))) (\ h ->
        isProp-Pi (Loc) (\ r -> (g : Arr r s) -> (e : Id Loc (root (u s h)) s) -> Id Raw (at (u s h) s e r g) (u r (compose r s z h g))) (\ r ->
        isProp-Pi (Arr r s) (\ g -> (e : Id Loc (root (u s h)) s) -> Id Raw (at (u s h) s e r g) (u r (compose r s z h g))) (\ g ->
        isProp-Pi (Id Loc (root (u s h)) s) (\ e -> Id Raw (at (u s h) s e r g) (u r (compose r s z h g))) (\ e ->
        C.raw-set _ _))))) ;
    NV : U l = (s : Loc) -> (h : Arr s z) -> (i : PB.Lands s.1 z.1 Q h.1) -> (r : Loc) -> (g : Arr r s) -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j) ;
    pNV : isProp NV =
      isProp-Pi (Loc) (\ s -> (h : Arr s z) -> (i : PB.Lands s.1 z.1 Q h.1) -> (r : Loc) -> (g : Arr r s) -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ s ->
        isProp-Pi (Arr s z) (\ h -> (i : PB.Lands s.1 z.1 Q h.1) -> (r : Loc) -> (g : Arr r s) -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ h ->
        isProp-Pi (PB.Lands s.1 z.1 Q h.1) (\ i -> (r : Loc) -> (g : Arr r s) -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ i ->
        isProp-Pi (Loc) (\ r -> (g : Arr r s) -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ r ->
        isProp-Pi (Arr r s) (\ g -> (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ g ->
        isProp-Pi (PB.Lands r.1 z.1 Q (compose r s z h g).1) (\ j -> (e : Id Loc (root (v s h i)) s) -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ j ->
        isProp-Pi (Id Loc (root (v s h i)) s) (\ e -> Id Raw (at (v s h i) s e r g) (v r (compose r s z h g) j)) (\ e ->
        C.raw-set _ _))))))) ;
    result : isProp (Good (node z Q u v)) =
      isProp-Sigma (Id Bool (Q.1 z.1 (idH z.1)) false) (\ no -> GU * GV * NU * NV) (isSet-Bool _ false) (\ no ->
      isProp-Sigma GU (\ gu -> GV * NU * NV) pGU (\ gu ->
      isProp-Sigma GV (\ gv -> NU * NV) pGV (\ gv ->
      isProp-Sigma NU (\ nu -> NV) pNU (\ nu -> pNV)))) ;
  } ;
  good-prop : (t : Raw) -> isProp (Good t) = split {
    leaf z v -> isTop ;
    node z Q u v | pu pv -> NodeProps[z,Q,u,v,pu,pv].result
  } ;
  opaque good-prop ;
  witness-prop (z : Loc) (t : Raw) : isProp (Good t * Id Loc (root t) z) =
    isProp-Sigma (Good t) (\ good -> Id Loc (root t) z) (good-prop t) (\ good -> loc-set (root t) z) ;
  tr-eq (z : Loc) (t u : TrEl z) (p : Id Raw t.1 u.1) : Id (TrEl z) t u =
    Sigma-eq Raw (\ v -> Good v * Id Loc (root v) z) t.1 u.1 t.2 u.2 p (witness-prop z u.1) ;
  opaque tr-eq ;
  elEncoding (z : Loc) : EN.Enc (TrEl z) = EN.encSig Raw (\ t -> Good t * Id Loc (root t) z)
    C.rawEncoding (\ t -> EN.encProp _ (witness-prop z t)) ;
  truncV (z : Loc) : W.V = EN.codeOf (TrEl z) (elEncoding z) ;
} ;
