-- CLocHtpy.seg (L9): homotopies, and Lemma D-htpy (localisation.tex §5).
-- A homotopy between alpha , beta : A -> B over G is an element of the path
-- type over G.A: at (rho , a) a path in B over the constant line at rho from
-- alpha(a) to beta(a) (CPath.PathOverE), natural in (rho , a).
--
--   HT[G, A, B, al, be].PT.PathP   the type of homotopies, over G.A
--                                  (CHtpyOps.HT, for the maps of CLocD)
--   DH[..., H].res                 Lemma D-htpy: D alpha ~ D beta, by
--                                  H'(u)(f , i)(g) = H(u(f g)) at (id , i g)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LD = CLocD[a, l] ;

-- the maps of CLocD as maps of CHtpyOps
toN (G : PCtx) (A B : PTy[G]) (al : LD.NatMap[G, A, B]) : PB.CHtpyOps[l].NMap[G, A, B] =
  new PB.CHtpyOps[l].NMap[G, A, B, al.nfun, al.nnat] ;

-- the type of homotopies (CHtpyOps.HT)
module HT (G : PCtx) (A B : PTy[G]) (al be : LD.NatMap[G, A, B]) {
  module H0 = PB.CHtpyOps[l].HT[G, A, B, toN G A B al, toN G A B be] ;
  module TB = H0.TB ;
  module PT = H0.PT ;
  GA : PCtx = H0.GA ;
  aE (V : Ob) (z : W.Ix (GA.ob V)) : TB.EI V = H0.aE V z ;
  bE (V : Ob) (z : W.Ix (GA.ob V)) : TB.EI V = H0.bE V z ;

  pv (H : PEl[GA, PT.PathP]) (X : Ob) (z : W.Ix (GA.ob X)) (V : Ob) (g : Hom V X) (j : Hom V Iv) : TB.EI V = H0.pv H X z V g j ;

  pv-res (H : PEl[GA, PT.PathP]) (m n : Ob) (k : Hom m n) (z : W.Ix (GA.ob n)) (z' : W.Ix (GA.ob m))
    (e : Id (W.Ix (GA.ob m)) (GA.act m n k z) z') (V : Ob) (g : Hom V m) (j : Hom V Iv)
    : Id (TB.EI V) (pv H n z V (compH V m n k g) j) (pv H m z' V g j) = H0.pv-res H m n k z z' e V g j ;
} ;

------------------------------------------------------------------------
-- Lemma D-htpy

module DH (G : PCtx) (A B : PTy[G]) (al be : LD.NatMap[G, A, B]) (H : PEl[extP G A, HT[G, A, B, al, be].PT.PathP]) {
  module T1 = HT[G, A, B, al, be] ;
  module DA = LD.DT[G, A] ;
  module DB = LD.DT[G, B] ;
  module Dal = LD.DMap[G, A, B, al] ;
  module Dbe = LD.DMap[G, A, B, be] ;
  module T2 = HT[G, DA.DA, DB.DA, Dal.DN, Dbe.DN] ;
  module TA = PR.TyL[G, A] ;
  module TB = T1.TB ;
  module TDB = PR.TyL[G, DB.DA] ;
  module GL = PR.PshL[G] ;

  -- the value at (F , J) : [n] -> X * [1]
  vF (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho) (n : Nat) (F : Hom (lin n) X) (J : Hom (lin n) Iv) : TB.EI (lin n) =
    T1.pv H (lin n) (DA.rd X rho u.1 n F) (lin n) (idH (lin n)) J ;

  vF-cong (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho) (n : Nat) (F F' : Hom (lin n) X) (P : Id (Hom (lin n) X) F F')
    (J J' : Hom (lin n) Iv) (Q : Id (Hom (lin n) Iv) J J') : Id (TB.EI (lin n)) (vF X rho u n F J) (vF X rho u n F' J') =
    transH (apH (\ k -> vF X rho u n k J) P) (apH (\ k -> vF X rho u n F' k) Q) ;

  vF-pt (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho) (n : Nat) (F : Hom (lin n) X) (J : Hom (lin n) Iv)
    : Id (W.Ix (G.ob (lin n))) (vF X rho u n F J).1 (G.act (lin n) X F rho) =
    transH ((H.eob (lin n) (DA.rd X rho u.1 n F)).2.1 (lin n) (idH (lin n)) J) (G.act-id (lin n) (G.act (lin n) X F rho)) ;

  module At (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho) (V : Ob) (f : Hom V X) (i : Hom V Iv) {
    y : W.Ix (G.ob V) = G.act V X f rho ;

    pe (n : Nat) (g : Hom (lin n) V) : Id (W.Ix (G.ob (lin n))) (vF X rho u n (compH (lin n) V X f g) (compH (lin n) V Iv i g)).1 (G.act (lin n) V g y) =
      transH (vF-pt X rho u n (compH (lin n) V X f g) (compH (lin n) V Iv i g)) (G.act-o (lin n) V X f g rho) ;

    fam : DB.Fam V y = \ n g -> TB.fromE (lin n) (G.act (lin n) V g y) (vF X rho u n (compH (lin n) V X f g) (compH (lin n) V Iv i g)) (pe n g) ;

    rdv (n : Nat) (g : Hom (lin n) V) : Id (TB.EI (lin n)) (DB.rd V y fam n g) (vF X rho u n (compH (lin n) V X f g) (compH (lin n) V Iv i g)) =
      TB.fromE-eq (lin n) (G.act (lin n) V g y) (vF X rho u n (compH (lin n) V X f g) (compH (lin n) V Iv i g)) (pe n g) ;

    compat : DB.Compat V y fam = \ m n k st g -> calc (TB.EI (lin m)) {
        TB.E.act (lin m) (lin n) k (DB.rd V y fam n g)
      =< apH (TB.E.act (lin m) (lin n) k) (rdv n g) >
        TB.E.act (lin m) (lin n) k (T1.pv H (lin n) (DA.rd X rho u.1 n (compH (lin n) V X f g)) (lin n) (idH (lin n)) (compH (lin n) V Iv i g))
      =< (H.eob (lin n) (DA.rd X rho u.1 n (compH (lin n) V X f g))).1.2 (lin m) (lin n) k (idH (lin n)) (compH (lin n) V Iv i g) >
        T1.pv H (lin n) (DA.rd X rho u.1 n (compH (lin n) V X f g)) (lin m) (compH (lin m) (lin n) (lin n) (idH (lin n)) k)
          (compH (lin m) (lin n) Iv (compH (lin n) V Iv i g) k)
      =< apH (\ q -> T1.pv H (lin n) (DA.rd X rho u.1 n (compH (lin n) V X f g)) (lin m) q (compH (lin m) (lin n) Iv (compH (lin n) V Iv i g) k))
           (transH (comp-idl (lin m) (lin n) k) (symH (comp-idr (lin m) (lin n) k))) >
        T1.pv H (lin n) (DA.rd X rho u.1 n (compH (lin n) V X f g)) (lin m) (compH (lin m) (lin m) (lin n) k (idH (lin m)))
          (compH (lin m) (lin n) Iv (compH (lin n) V Iv i g) k)
      =< T1.pv-res H (lin m) (lin n) k (DA.rd X rho u.1 n (compH (lin n) V X f g)) (DA.rd X rho u.1 m (compH (lin m) V X f (compH (lin m) (lin n) V g k)))
           (transH (u.2 m n k st (compH (lin n) V X f g))
              (apH (\ q -> DA.rd X rho u.1 m q) (comp-assoc (lin m) (lin n) V X f g k)))
           (lin m) (idH (lin m)) (compH (lin m) (lin n) Iv (compH (lin n) V Iv i g) k) >
        vF X rho u m (compH (lin m) V X f (compH (lin m) (lin n) V g k)) (compH (lin m) (lin n) Iv (compH (lin n) V Iv i g) k)
      =< vF-cong X rho u m _ _ (refl (compH (lin m) V X f (compH (lin m) (lin n) V g k)))
           _ _ (comp-assoc (lin m) (lin n) V Iv i g k) >
        vF X rho u m (compH (lin m) V X f (compH (lin m) (lin n) V g k)) (compH (lin m) V Iv i (compH (lin m) (lin n) V g k))
      =< symH (rdv m (compH (lin m) (lin n) V g k)) >
        DB.rd V y fam m (compH (lin m) (lin n) V g k) } ;

    el : DB.DEl V y = (fam, compat) ;
    t : TDB.EI V = (y, el) ;
  } ;

  -- equality in the total of DB
  extB (V : Ob) (q q' : TDB.EI V) (P : Id (W.Ix (G.ob V)) q.1 q'.1)
    (R : (n : Nat) (f : Hom (lin n) V) -> Id (TB.EI (lin n)) (DB.rd V q.1 q.2.1 n f) (DB.rd V q'.1 q'.2.1 n f)) : Id (TDB.EI V) q q' =
    idJ (W.Ix (G.ob V)) q.1
      (\ p2 P2 -> (a2 : DB.DEl V p2) -> ((n : Nat) (f : Hom (lin n) V) -> Id (TB.EI (lin n)) (DB.rd V q.1 q.2.1 n f) (DB.rd V p2 a2.1 n f))
         -> Id (TDB.EI V) q (p2, a2))
      (\ a2 R2 -> apH {DB.DEl V q.1} {TDB.EI V} (\ a3 -> (q.1, a3)) (DB.Dext V q.1 q.2 a2 R2))
      q'.1 P q'.2 R ;

  -- the values of t: functions of the composite point
  t-rd (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho) (V : Ob) (f : Hom V X) (i : Hom V Iv) (n : Nat) (g : Hom (lin n) V)
    : Id (TB.EI (lin n)) (DB.rd V At[X, rho, u, V, f, i].y At[X, rho, u, V, f, i].el.1 n g)
                         (vF X rho u n (compH (lin n) V X f g) (compH (lin n) V Iv i g)) = At[X, rho, u, V, f, i].rdv n g ;

  tn (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho) (V' V : Ob) (g : Hom V' V) (f : Hom V X) (i : Hom V Iv)
    : Id (TDB.EI V') (TDB.E.act V' V g At[X, rho, u, V, f, i].t) At[X, rho, u, V', compH V' V X f g, compH V' V Iv i g].t =
    extB V' (TDB.E.act V' V g At[X, rho, u, V, f, i].t) At[X, rho, u, V', compH V' V X f g, compH V' V Iv i g].t
      (GL.actC V' V X f g rho)
      (\ n g' -> calc (TB.EI (lin n)) {
          DB.rd V' (TDB.E.act V' V g At[X, rho, u, V, f, i].t).1 (TDB.E.act V' V g At[X, rho, u, V, f, i].t).2.1 n g'
        =< DB.rd-dtact V' V g At[X, rho, u, V, f, i].y (G.act V' V g At[X, rho, u, V, f, i].y)
             (refl (G.act V' V g At[X, rho, u, V, f, i].y)) At[X, rho, u, V, f, i].el n g' >
          DB.rd V At[X, rho, u, V, f, i].y At[X, rho, u, V, f, i].el.1 n (compH (lin n) V' V g g')
        =< t-rd X rho u V f i n (compH (lin n) V' V g g') >
          vF X rho u n (compH (lin n) V X f (compH (lin n) V' V g g')) (compH (lin n) V Iv i (compH (lin n) V' V g g'))
        =< vF-cong X rho u n _ _ (symH (comp-assoc (lin n) V' V X f g g')) _ _ (symH (comp-assoc (lin n) V' V Iv i g g')) >
          vF X rho u n (compH (lin n) V' X (compH V' V X f g) g') (compH (lin n) V' Iv (compH V' V Iv i g) g')
        =< symH (t-rd X rho u V' (compH V' V X f g) (compH V' V Iv i g) n g') >
          DB.rd V' At[X, rho, u, V', compH V' V X f g, compH V' V Iv i g].y At[X, rho, u, V', compH V' V X f g, compH V' V Iv i g].el.1 n g' }) ;

  -- the ends
  t0 (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho)
    : Id (TDB.EI X) At[X, rho, u, X, idH X, constH X Iv e0].t (T2.aE X (rho, u)) =
    extB X At[X, rho, u, X, idH X, constH X Iv e0].t (T2.aE X (rho, u)) (G.act-id X rho)
      (\ n g -> calc (TB.EI (lin n)) {
          DB.rd X At[X, rho, u, X, idH X, constH X Iv e0].y At[X, rho, u, X, idH X, constH X Iv e0].el.1 n g
        =< t-rd X rho u X (idH X) (constH X Iv e0) n g >
          vF X rho u n (compH (lin n) X X (idH X) g) (compH (lin n) X Iv (constH X Iv e0) g)
        =< vF-cong X rho u n _ _ (comp-idl (lin n) X g) _ _ (constH-nat (lin n) X g e0) >
          vF X rho u n g (constH (lin n) Iv e0)
        =< (H.eob (lin n) (DA.rd X rho u.1 n g)).2.2.1 >
          T1.aE (lin n) (DA.rd X rho u.1 n g) } ) ;

  t1 (X : Ob) (rho : W.Ix (G.ob X)) (u : DA.DEl X rho)
    : Id (TDB.EI X) At[X, rho, u, X, idH X, constH X Iv e1].t (T2.bE X (rho, u)) =
    extB X At[X, rho, u, X, idH X, constH X Iv e1].t (T2.bE X (rho, u)) (G.act-id X rho)
      (\ n g -> calc (TB.EI (lin n)) {
          DB.rd X At[X, rho, u, X, idH X, constH X Iv e1].y At[X, rho, u, X, idH X, constH X Iv e1].el.1 n g
        =< t-rd X rho u X (idH X) (constH X Iv e1) n g >
          vF X rho u n (compH (lin n) X X (idH X) g) (compH (lin n) X Iv (constH X Iv e1) g)
        =< vF-cong X rho u n _ _ (comp-idl (lin n) X g) _ _ (constH-nat (lin n) X g e1) >
          vF X rho u n g (constH (lin n) Iv e1)
        =< (H.eob (lin n) (DA.rd X rho u.1 n g)).2.2.2 >
          T1.bE (lin n) (DA.rd X rho u.1 n g) } ) ;

  path (X : Ob) (z : W.Ix (T2.GA.ob X)) : W.Ix (T2.PT.tobP X z) =
    T2.PT.mkPath X z (\ V f i -> At[X, z.1, z.2, V, f, i].t) (\ V' V g f i -> tn X z.1 z.2 V' V g f i)
      (\ V f i -> refl (G.act V X f z.1)) (t0 X z.1 z.2) (t1 X z.1 z.2) ;

  -- naturality in (rho , u)
  enat (J I : Ob) (h : Hom J I) (z : W.Ix (T2.GA.ob I)) (z' : W.Ix (T2.GA.ob J)) (e : Id (W.Ix (T2.GA.ob J)) (T2.GA.act J I h z) z')
    : Id (W.Ix (T2.PT.tobP J z')) (T2.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    idJ (W.Ix (T2.GA.ob J)) (T2.GA.act J I h z)
      (\ z2 e2 -> Id (W.Ix (T2.PT.tobP J z2)) (T2.PT.PathP.tact J I h z z2 e2 (path I z)) (path J z2))
      (T2.PT.path-eq J (T2.GA.act J I h z) (T2.PT.PathP.tact J I h z (T2.GA.act J I h z) (refl (T2.GA.act J I h z)) (path I z))
         (path J (T2.GA.act J I h z))
         (\ V f i -> extB V At[I, z.1, z.2, V, compH V J I h f, i].t At[J, G.act J I h z.1, (T2.GA.act J I h z).2, V, f, i].t
            (G.act-o V J I h f z.1)
            (\ n g -> calc (TB.EI (lin n)) {
                DB.rd V At[I, z.1, z.2, V, compH V J I h f, i].y At[I, z.1, z.2, V, compH V J I h f, i].el.1 n g
              =< t-rd I z.1 z.2 V (compH V J I h f) i n g >
                vF I z.1 z.2 n (compH (lin n) V I (compH V J I h f) g) (compH (lin n) V Iv i g)
              =< apH (\ w -> T1.pv H (lin n) w (lin n) (idH (lin n)) (compH (lin n) V Iv i g))
                   (transH (apH (\ q -> DA.rd I z.1 z.2.1 n q) (comp-assoc (lin n) V J I h f g))
                     (symH (DA.rd-dtact J I h z.1 (G.act J I h z.1) (refl (G.act J I h z.1)) z.2 n (compH (lin n) V J f g)))) >
                vF J (G.act J I h z.1) (T2.GA.act J I h z).2 n (compH (lin n) V J f g) (compH (lin n) V Iv i g)
              =< symH (t-rd J (G.act J I h z.1) (T2.GA.act J I h z).2 V f i n g) >
                DB.rd V At[J, G.act J I h z.1, (T2.GA.act J I h z).2, V, f, i].y At[J, G.act J I h z.1, (T2.GA.act J I h z).2, V, f, i].el.1 n g })))
      z' e ;

  opaque vF-pt ; opaque extB ; opaque t-rd ; opaque tn ; opaque t0 ; opaque t1 ; opaque enat ;

  res : PEl[T2.GA, T2.PT.PathP] = new PEl[T2.GA, T2.PT.PathP, path, enat] ;
} ;
