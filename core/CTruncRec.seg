-- Recursion out of truncation into any seeded extension algebra.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module Rec (G : PCtx) (A B : PTy[G]) (k : CTruncAlg[a, l].Algebras[G,B].Algebra)
  (f : (z : CTruncRaw[a, l].Build[G, A].Loc) -> W.Ix (A.tob z.1 z.2) -> W.Ix (B.tob z.1 z.2))
  (fn : (s z : CTruncRaw[a, l].Build[G, A].Loc) (h : CTruncRaw[a, l].Build[G, A].Arr s z)
    (v : W.Ix (A.tob z.1 z.2)) -> Id (W.Ix (B.tob s.1 s.2))
      (B.tact s.1 z.1 h.1 z.2 s.2 h.2 (f z v)) (f s (A.tact s.1 z.1 h.1 z.2 s.2 h.2 v))) {
  open CTruncRaw[a, l].Build[G, A] ;
  open CTruncAlg[a, l].Algebras[G,B] ;
  open CTruncGraph[a, l].Graph[G, A, B, k, f] ;
  open CTruncGraphNat[a, l].Stable[G, A, B, k, f, fn] ;
  Exists (t : Raw) (z : Loc) : U l = (b : F z) * Eval t (z,b) ;
  relocate (t : Raw) (z : Loc) (e : Id Loc (root t) z) (d : Exists t (root t)) : Exists t z =
    substH (\ w -> Exists t w) e d ;

  module Node (z : Loc) (Q : PB.Phi z.1)
    (u : (s : Loc) -> Arr s z -> Raw)
    (v : (s : Loc) (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> Raw)
    (iu : (s : Loc) (h : Arr s z) -> Good (u s h) -> Exists (u s h) (root (u s h)))
    (iv : (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1)
      -> Good (v s h i) -> Exists (v s h i) (root (v s h i)))
    (good : Good (node z Q u v)) {
    du (s : Loc) (h : Arr s z) : Exists (u s h) s =
      relocate (u s h) s (good.2.1 s h).2 (iu s h (good.2.1 s h).1) ;
    dv (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) : Exists (v s h i) s =
      relocate (v s h i) s (good.2.2.1 s h i).2 (iv s h i (good.2.2.1 s h i).1) ;
    bu (s : Loc) (h : Arr s z) : F s = (du s h).1 ;
    bv (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) : F s = (dv s h i).1 ;
    bn : SeedNat z bu = \ s h r g ->
      fibre-inj r _ _ (unique (u r (compose r s z h g)) _ _
        (change-tree (at (u s h) s (good.2.1 s h).2 r g) (u r (compose r s z h g))
          (good.2.2.2.1 s h r g (good.2.1 s h).2) _
          (stable (u s h) (s,bu s h) (du s h).2 (good.2.1 s h).2 r g))
        (du r (compose r s z h g)).2) ;
    vn : Natural z Q bv = \ s h i r g j ->
      fibre-inj r _ _ (unique (v r (compose r s z h g) j) _ _
        (change-tree (at (v s h i) s (good.2.2.1 s h i).2 r g) (v r (compose r s z h g) j)
          (good.2.2.2.2 s h i r g j (good.2.2.1 s h i).2) _
          (stable (v s h i) (s,bv s h i) (dv s h i).2 (good.2.2.1 s h i).2 r g))
        (dv r (compose r s z h g) j).2) ;
    opaque bn ; opaque vn ;
    b : F z = k.extend z Q (bu z (ident z)) bv vn ;
    result : Exists (node z Q u v) z = (b,
      new NodeGraph[z, Q, \ s h -> Eval (u s h), \ s h i -> Eval (v s h i), (z,b),
        bu, bv, bn, vn, \ s h -> (du s h).2, \ s h i -> (dv s h i).2, refl (z,b)]) ;
  } ;
  exists : (t : Raw) -> Good t -> Exists t (root t) = split {
    leaf z v -> \ good -> (f z v, refl (z,f z v)) ;
    node z Q u v | iu iv -> \ good -> Node[z, Q, u, v, iu, iv, good].result
  } ;
  opaque exists ;
  evaluated (z : Loc) (t : TrEl z) : Exists t.1 z = relocate t.1 z t.2.2 (exists t.1 t.2.1) ;
  rec (z : Loc) (t : TrEl z) : F z = (evaluated z t).1 ;
  rec-graph (z : Loc) (t : TrEl z) : Eval t.1 (z,rec z t) = (evaluated z t).2 ;
  rec-nat (s z : Loc) (h : Arr s z) (t : TrEl z)
    : Id (F s) (act s z h (rec z t)) (rec s (tr-res s z h t)) =
    fibre-inj s _ _ (unique (tr-res s z h t).1 _ _
      (stable t.1 (z,rec z t) (rec-graph z t) t.2.2 s h) (rec-graph s (tr-res s z h t))) ;
  opaque rec-nat ;
  rec-inc (z : Loc) (v : W.Ix (A.tob z.1 z.2)) : Id (F z) (rec z (inc z v)) (f z v) =
    fibre-inj z _ _ (unique (leaf z v) _ _ (rec-graph z (inc z v)) (refl (z,f z v))) ;
  opaque rec-inc ;
} ;
