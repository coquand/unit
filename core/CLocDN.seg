-- CLocDN.seg (L9): the finite approximations D_N A = D (K_N A)
-- (postnikov.tex §3).  K_N A is the coskeleton of CCosk; D_N A is D of it
-- (CLocD.DT), so its families are indexed by all the maps [n] -> X, but are
-- determined by those with n <= N.
--
--   DN.DNA      the type D_N A
--   DN.fib      if A is fibrant so is D_N A: Theorem DA (CLocComp.Thm)
--               applied to the horn filling of i*(K_N A) (CCoskHorn.HK)
--   DN.res      the map D A -> D_N A, D of etaK : A -> K_N A
--   Lim         D A is the limit of the tower (postnikov.tex, Proposition
--               lim): a sequence v N in D_N A(X , x), each the restriction
--               of the next, comes from a unique u in D A(X , x)
--     stab        v N and v M agree below N, for N <= M
--     u, res-u    the element: its value at f : [n] -> X is v n at f, read
--                 at the identity; its restrictions are the v N
--     uniq        any u' with these restrictions is u

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;

module DN (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat) (c : PB.CLine[l].Lines[G, A].Fib) {
  module KM = CCosk[a, l].KT[G, A, N] ;
  module DK = LD.DT[G, KM.KA] ;

  DNA : PP.PTy[G] = DK.DA ;

  fib : PB.CLine[l].Lines[G, DNA].Fib = CLocComp[a, l].Thm[G, KM.KA, CCoskHorn[a, l].HK[G, A, N, c].horn].fib ;

  res : LD.NatMap[G, LD.DT[G, A].DA, DNA] = LD.DMap[G, A, KM.KA, KM.etaN].DN ;
} ;

------------------------------------------------------------------------
-- the strict limit

leb-plusR : (m n : Nat) -> IsT (leb n (plus m n)) = split {
  zero -> \ n -> leb-refl n ;
  suc m | ih -> \ n -> leb-step n (plus m n) (ih n) } ;

orL : (b c : Bool) -> IsT (or b c) -> (R : U l) -> (IsT b -> R) -> (IsT c -> R) -> R = split {
  true -> \ c h R k1 k2 -> k1 (refl true) ;
  false -> \ c h R k1 k2 -> k2 h } ;

module CKm = CCosk[a, l] ;

module Lim (G : PP.PCtx) (A : PP.PTy[G]) (X : Ob) (x : W.Ix (G.ob X))
  (v : (N : Nat) -> LD.DT[G, CKm.KT[G, A, N].KA].DEl X x)
  (tw : (N : Nat) -> Id (LD.DT[G, CKm.KT[G, A, N].KA].DEl X x)
                        (LD.DMap[G, CKm.KT[G, A, suc N].KA, CKm.KT[G, A, N].KA, CKm.Res[G, A, N, suc N, leb-suc N].resN].DF X x (v (suc N)))
                        (v N)) {
  module TA = PB.GPre[l].TyL[G, A] ;
  module DA = LD.DT[G, A] ;

  -- v N at f : [n] -> X, read at g : [j] -> [n]
  ent (N n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n)) : TA.EI (lin j) =
    CKm.KT[G, A, N].rd (lin n) (G.act (lin n) X f x) ((v N).1 n f).1 j hj g ;

  ent-irr (N n : Nat) (f : Hom (lin n) X) (j : Nat) (hj hj' : IsT (leb j N)) (g : Hom (lin j) (lin n))
    : Id (TA.EI (lin j)) (ent N n f j hj g) (ent N n f j hj' g) =
    apH (\ p -> ent N n f j p g) (isProp-IsT' (leb j N) hj hj') ;

  -- one step of the tower
  step (N n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (g : Hom (lin j) (lin n))
    : Id (TA.EI (lin j)) (ent N n f j hj g) (ent (suc N) n f j (leb-step j N hj) g) =
    symH (apH (\ z -> CKm.KT[G, A, N].rd (lin n) (G.act (lin n) X f x) (z.1 n f).1 j hj g) (tw N)) ;

  stab-eq (N M : Nat) (e : Id Nat N M) (n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (hj' : IsT (leb j M))
    (g : Hom (lin j) (lin n)) : Id (TA.EI (lin j)) (ent N n f j hj g) (ent M n f j hj' g) =
    idJ Nat N (\ M1 e1 -> (h1 : IsT (leb j M1)) -> Id (TA.EI (lin j)) (ent N n f j hj g) (ent M1 n f j h1 g))
      (\ h1 -> ent-irr N n f j hj h1 g) M e hj' ;

  -- v N and v M agree below N
  stab (N : Nat) : (M : Nat) (hNM : IsT (leb N M)) (n : Nat) (f : Hom (lin n) X) (j : Nat) (hj : IsT (leb j N)) (hj' : IsT (leb j M))
    (g : Hom (lin j) (lin n)) -> Id (TA.EI (lin j)) (ent N n f j hj g) (ent M n f j hj' g) = split {
    zero -> \ hNM n f j hj hj' g -> stab-eq N zero (leb-zero N hNM) n f j hj hj' g ;
    suc M | ih -> \ hNM n f j hj hj' g ->
      orL (eqN N (suc M)) (leb N M) (leb-suc-split N M hNM) (Id (TA.EI (lin j)) (ent N n f j hj g) (ent (suc M) n f j hj' g))
        (\ q -> stab-eq N (suc M) (eqN-sound N (suc M) q) n f j hj hj' g)
        (\ q -> transH (ih q n f j hj (leb-trans j N M hj q) g)
                  (transH (step M n f j (leb-trans j N M hj q) g) (ent-irr (suc M) n f j (leb-step j M (leb-trans j N M hj q)) hj' g))) } ;

  ----------------------------------------------------------------------
  -- the element of D A

  val (n : Nat) (f : Hom (lin n) X) : TA.EI (lin n) = ent n n f n (leb-refl n) (idH (lin n)) ;

  val-pt (n : Nat) (f : Hom (lin n) X) : Id (W.Ix (G.ob (lin n))) (val n f).1 (G.act (lin n) X f x) =
    G.act-id (lin n) (G.act (lin n) X f x) ;

  uF : DA.Fam X x = \ n f -> TA.fromE (lin n) (G.act (lin n) X f x) (val n f) (val-pt n f) ;

  rd-uF (n : Nat) (f : Hom (lin n) X) : Id (TA.EI (lin n)) (DA.rd X x uF n f) (val n f) =
    TA.fromE-eq (lin n) (G.act (lin n) X f x) (val n f) (val-pt n f) ;

  -- val restricted along g is v M read at g, at any stage M above n and j
  valAt (M n : Nat) (f : Hom (lin n) X) (hn : IsT (leb n M)) (j : Nat) (hj : IsT (leb j M)) (g : Hom (lin j) (lin n))
    : Id (TA.EI (lin j)) (TA.E.act (lin j) (lin n) g (val n f)) (ent M n f j hj g) =
    transH (apH (TA.E.act (lin j) (lin n) g) (stab n M hn n f n (leb-refl n) hn (idH (lin n))))
      (transH (((v M).1 n f).2 j n hj hn g (idH (lin n)))
              (apH (\ q -> ent M n f j hj q) (comp-idl (lin j) (lin n) g))) ;

  -- the faces of v M at f, read at the identity
  vface (M n : Nat) (f : Hom (lin (suc n)) X) (y : Nat) (hn : IsT (leb n M))
    : Id (TA.EI (lin n)) (ent M (suc n) f n hn (dl n y)) (ent M n (compH (lin n) (lin (suc n)) X f (dl n y)) n hn (idH (lin n))) =
    transH (apH (\ q -> ent M (suc n) f n hn q) (symH (comp-idr (lin n) (lin (suc n)) (dl n y))))
      (transH (symH (CKm.KT[G, A, M].rd-ktact (lin n) (lin (suc n)) (dl n y) (G.act (lin (suc n)) X f x)
                       (G.act (lin n) (lin (suc n)) (dl n y) (G.act (lin (suc n)) X f x))
                       (refl (G.act (lin n) (lin (suc n)) (dl n y) (G.act (lin (suc n)) X f x)))
                       ((v M).1 (suc n) f) n hn (idH (lin n))))
              (apH (\ w -> CKm.KT[G, A, M].rd (lin n) w.1 w.2.1 n hn (idH (lin n)))
                   ((v M).2 n (suc n) (dl n y) (dl-strict n y) f))) ;

  fc : DA.FaceCompat X x uF = \ n f y hy ->
    transH (apH (TA.E.act (lin n) (lin (suc n)) (dl n y)) (rd-uF (suc n) f))
     (transH (valAt (suc n) (suc n) f (leb-refl n) n (leb-step n n (leb-refl n)) (dl n y))
      (transH (vface (suc n) n f y (leb-step n n (leb-refl n)))
       (transH (symH (stab n (suc n) (leb-step n n (leb-refl n)) n (compH (lin n) (lin (suc n)) X f (dl n y)) n (leb-refl n)
                        (leb-step n n (leb-refl n)) (idH (lin n))))
               (symH (rd-uF n (compH (lin n) (lin (suc n)) X f (dl n y))))))) ;

  u : DA.DEl X x = (uF, DA.FacesGen[X, x, uF, fc].facesGen) ;

  -- the restrictions of u are the v N
  module RN (N : Nat) {
    module KN = CKm.KT[G, A, N] ;
    module DN' = LD.DT[G, KN.KA] ;
    module RM = LD.DMap[G, A, KN.KA, KN.etaN] ;

    res-u : Id (DN'.DEl X x) (RM.DF X x u) (v N) =
      DN'.Dext X x (RM.DF X x u) (v N) (\ n f ->
        KN.EKext (lin n) (DN'.rd X x (RM.DF X x u).1 n f) (DN'.rd X x (v N).1 n f) (refl (G.act (lin n) X f x)) (\ j hj g ->
          transH (apH (TA.E.act (lin j) (lin n) g) (rd-uF n f))
           (transH (valAt (plus n N) n f (leb-plus n N) j (leb-trans j N (plus n N) hj (leb-plusR n N)) g)
                   (symH (stab N (plus n N) (leb-plusR n N) n f j hj (leb-trans j N (plus n N) hj (leb-plusR n N)) g))))) ;
  } ;

  -- uniqueness
  uniq (u' : DA.DEl X x)
    (r : (N : Nat) -> Id (LD.DT[G, CKm.KT[G, A, N].KA].DEl X x)
                        (LD.DMap[G, A, CKm.KT[G, A, N].KA, CKm.KT[G, A, N].etaN].DF X x u') (v N))
    : Id (DA.DEl X x) u' u =
    DA.Dext X x u' u (\ n f ->
      transH (symH (TA.E.act-id (lin n) (DA.rd X x u'.1 n f)))
        (transH (apH (\ z -> CKm.KT[G, A, n].rd (lin n) (G.act (lin n) X f x) (z.1 n f).1 n (leb-refl n) (idH (lin n))) (r n))
                (symH (rd-uF n f)))) ;
} ;
