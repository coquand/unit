-- CLocHorn.seg (L9): horn filling from composition (localisation.tex,
-- Lemma comp-horn).  A fibration structure on a type A over the posets
-- gives a horn filling operation on i*A over i*G (CDHornFib.DH.isFib).
--
-- A horn of i*A at the vertex k of [m+1] over rho is a section h on the
-- Delta sieve hornS m k.  On the posets it becomes a partial element of A
-- at rho on the poset horn hornP m k (the maps missing some face y /= k):
-- at g : W -> [m+1] missing y its value is that of the face y,
--     vF y g = (h at delta_y) restricted along sigma_y g,
-- independent of the face (vF-compat, from the naturality of h).  It is
-- filled along CBoxHorn's retraction lines by PB.CHornRetr (Gabriel-Zisman):
--   k = 0    the constant 0, composition from e0 to e1
--   k >= 1   max(- , k), composition from e1 to e0
-- and the filler extends h (fromP, the face factorisation).
--
-- Quarry: seg/model HornFace, BoxHorn (CH).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module AL = Arith[l] ;
module TL = Trees[l] ;

-- leb at the two levels a and l agrees (the decisions are taken at level l)
leb-lvl : (m : Nat) -> (n : Nat) -> Id Bool (TL.leb m n) (leb m n) = split {
  zero -> \ n -> refl true ;
  suc m | ih-m -> split { zero -> refl false ; suc n -> ih-m n } } ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module PB = CPosInst[a].PB ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
module PP = PB.GPre[l].PS ;
module BH = CBoxHorn[a] ;
module DHm = CDeltaCl[a] ;
module DHn = CDHornFib[a, l] ;
module RS = CLocRestr[a, l] ;

------------------------------------------------------------------------
-- arithmetic (HornFace)

-- dg_y j = z  and  y <= z  give  j = z + 1  (for j /= y)
dg-hit (n y z j : Nat) (hy : IsT (leb y (suc n))) (hj : IsT (leb j (suc n))) (kj : IsT (not (eqN j y)))
  (hyz : IsT (leb y z)) (e : Id Nat (dg n y j) z) : Id Nat j (suc z) =
  transH (symH (skip-dg n y j hy hj kj)) (transH (apH (skip y) e) (skip-ge y z hyz)) ;

neq-of (x y : Nat) (k : Id Nat x y -> Empty) : IsT (not (eqN x y)) =
  eqN-dec (IsT (not (eqN x y))) x y (\ e -> absurd _ (k e)) (\ ne -> ne) ;

neq-elim (x : Nat) (k : IsT (not (eqN x x))) : Empty = false-true (transH (symH (apH not (eqN-refl x))) k) ;

c0aux1 : (k : Nat) -> IsT (not (eqN zero (suc k))) -> IsT (not (eqN (suc zero) (suc k))) -> IsT (leb (suc k) (suc zero)) -> Empty = split {
  zero -> \ x y z -> false-true y ;
  suc k -> \ x y z -> false-true z } ;

c0aux : (k : Nat) -> IsT (not (eqN zero k)) -> IsT (not (eqN (suc zero) k)) -> IsT (leb k (suc zero)) -> Empty = split {
  zero -> \ x y z -> false-true x ;
  suc k -> c0aux1 k } ;

c0z (k : Nat) : (z : Nat) -> IsT (ltb zero (suc z)) -> IsT (leb (suc z) (suc zero))
  -> IsT (not (eqN zero k)) -> IsT (not (eqN (suc z) k)) -> IsT (leb k (suc zero)) -> Empty = split {
  zero -> \ hyz hz ky kz hk -> c0aux k ky kz hk ;
  suc z -> \ hyz hz ky kz hk -> false-true hz } ;

c0s (k y : Nat) : (z : Nat) -> IsT (ltb (suc y) (suc z)) -> IsT (leb (suc z) (suc zero))
  -> IsT (not (eqN (suc y) k)) -> IsT (not (eqN (suc z) k)) -> IsT (leb k (suc zero)) -> Empty = split {
  zero -> \ hyz hz ky kz hk -> false-true hyz ;
  suc z -> \ hyz hz ky kz hk -> false-true hz } ;

-- m = 0: two distinct faces of [1] cannot both differ from k
compat-0 (k : Nat) : (y z : Nat) -> IsT (ltb y z) -> IsT (leb z (suc zero))
  -> IsT (not (eqN y k)) -> IsT (not (eqN z k)) -> IsT (leb k (suc zero)) -> Empty = split {
  zero -> split {
    zero -> \ hyz hz ky kz hk -> false-true hyz ;
    suc z -> c0z k z } ;
  suc y -> split {
    zero -> \ hyz hz ky kz hk -> false-true hyz ;
    suc z -> c0s k y z } } ;

------------------------------------------------------------------------
-- the poset horn

module PH (m k : Nat) {
  X : Ob = lin (suc m) ;

  Qy (y : Fin (suc (suc m))) : SP.Phi X = PBs.subS X X (idH X) (BH.QH m k y.1) ;

  hornP : SP.Phi X = SP.bigU X (suc (suc m)) Qy ;

  inQ (y : Fin (suc (suc m))) (W : Ob) (g : Hom W X) (i : SP.Lands W X (Qy y) g) : PosetSub.Lands W X (BH.QH m k y.1) g =
    PBs.plands-eq W X (BH.QH m k y.1) (compH W X X (idH X) g) g (comp-idl W X g)
      (PBs.isIn-sound W X (compH W X X (idH X) g) (BH.QH m k y.1) i) ;

  Qin (y : Fin (suc (suc m))) (W : Ob) (g : Hom W X) (l0 : PosetSub.Lands W X (BH.QH m k y.1) g) : SP.Lands W X (Qy y) g =
    PBs.isIn-complete W X (compH W X X (idH X) g) (BH.QH m k y.1)
      (PBs.plands-eq W X (BH.QH m k y.1) g (compH W X X (idH X) g) (symH (comp-idl W X g)) l0) ;

  inqK (y : Nat) (W : Ob) (g : Hom W X) (i : PosetSub.Lands W X (BH.QH m k y) g) : IsT (not (eqN y k)) =
    and-l (not (eqN y k)) (not (eqN (vnum (app W X g (pt W, pt-car W)).1) y)) (i (pt W, pt-car W)) ;

  inqM (y : Nat) (W : Ob) (g : Hom W X) (i : PosetSub.Lands W X (BH.QH m k y) g) : Miss W m y g = \ s ->
    and-r (not (eqN y k)) (not (eqN (vnum (app W X g s).1) y)) (i s) ;

  -- a map missing a face y /= k lands in the poset horn
  inHorn (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) (W : Ob) (g : Hom W X) (ms : Miss W m y g)
    : SP.Lands W X hornP g =
    SP.bigU-in W X (suc (suc m)) Qy g (y, hy) (Qin (y, hy) W g (\ s -> and-i (not (eqN y k)) (not (eqN (vnum (app W X g s).1) y)) ky (ms s))) ;

  -- the face delta_y misses y
  dlMiss (y : Nat) (ky : IsT (not (eqN y k))) : Miss (lin m) m y (dl m y) = \ s ->
    and-r (not (eqN y k)) (not (eqN (vnum (app (lin m) X (dl m y) s).1) y)) (BH.i1-dl m k y ky s.1 s.2) ;
} ;

------------------------------------------------------------------------
-- a Delta horn of i*A, read on the poset maps missing a face

module HS (G : PP.PCtx) (A : PP.PTy[G]) (m k : Nat) (rho : W0.Ix (G.ob (lin (suc m))))
  (h : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].HornData m k rho) {
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;
  module DH = DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA] ;
  module H = PH[m, k] ;
  X : Ob = H.X ;

  hS : DH.PT.Side[suc m, rho] = DH.hornSide m k rho h ;

  -- the value of the horn on the face y
  Lf (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) : DS.Lands m (suc m) (DHm.hornS m k) (dl m y) =
    DHm.lands-horn m m k y hy ky (dl m y) (H.dlMiss y ky) ;

  fE (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) : TA.EI (lin m) = h.1 m (dl m y) (Lf y hy ky) ;

  vF (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) (W : Ob) (g : Hom W X) : TA.EI W =
    TA.E.act W (lin m) (compH W X (lin m) (dgH m y) g) (fE y hy ky) ;

  vF-pt (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) (W : Ob) (g : Hom W X) (ms : Miss W m y g)
    : Id (W0.Ix (G.ob W)) (vF y hy ky W g).1 (G.act W X g rho) =
    transH (apH (G.act W (lin m) (compH W X (lin m) (dgH m y) g)) (h.2.1 m (dl m y) (Lf y hy ky)))
      (GL.actTri W (lin m) X (dl m y) (compH W X (lin m) (dgH m y) g) g
         (hom-eq W X (compH W (lin m) X (dl m y) (compH W X (lin m) (dgH m y) g)) g (pw-factor W m y g hy ms)) rho) ;

  vF-nat (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) (W' W : Ob) (chi : Hom W' W) (g : Hom W X)
    : Id (TA.EI W') (TA.E.act W' W chi (vF y hy ky W g)) (vF y hy ky W' (compH W' W X g chi)) =
    TA.PE.actTri W' W (lin m) (compH W X (lin m) (dgH m y) g) chi (compH W' X (lin m) (dgH m y) (compH W' W X g chi))
      (comp-assoc W' W X (lin m) (dgH m y) g chi) (fE y hy ky) ;

  vF-irr (y : Nat) (hy hy' : IsT (leb y (suc m))) (ky ky' : IsT (not (eqN y k))) (W : Ob) (g : Hom W X)
    : Id (TA.EI W) (vF y hy ky W g) (vF y hy' ky' W g) =
    transH (apH (\ h1 -> vF y h1 ky W g) (isProp-IsT' _ hy hy'))
           (apH (\ h1 -> vF y hy' h1 W g) (isProp-IsT' _ ky ky')) ;

  -- on a Delta map in the horn, vF is the value of the horn
  vF-h (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) (W : Nat) (f : Hom (lin W) X) (ms : Miss (lin W) m y f)
    (i : DS.Lands W (suc m) (DHm.hornS m k) f) : Id (TA.EI (lin W)) (vF y hy ky (lin W) f) (h.1 W f i) =
    transH (h.2.2 W m (compH (lin W) X (lin m) (dgH m y) f) (dl m y) (Lf y hy ky)
              (DS.lands-comp W m (suc m) (DHm.hornS m k) (dl m y) (compH (lin W) X (lin m) (dgH m y) f) (Lf y hy ky)))
      (DH.PT.pv-hom (suc m) rho hS W (compH (lin W) (lin m) X (dl m y) (compH (lin W) X (lin m) (dgH m y) f)) f
         (hom-eq (lin W) X _ _ (pw-factor (lin W) m y f hy ms))
         (DS.lands-comp W m (suc m) (DHm.hornS m k) (dl m y) (compH (lin W) X (lin m) (dgH m y) f) (Lf y hy ky)) i) ;
} ;

------------------------------------------------------------------------
-- the values of two faces agree (HornFace.HC)

module HC (G : PP.PCtx) (A : PP.PTy[G]) {
  module TA = PB.GPre[l].TyL[G, A] ;

  VF (m k : Nat) (rho : W0.Ix (G.ob (lin (suc m)))) (h : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].HornData m k rho)
    (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k))) (W : Ob) (g : Hom W (lin (suc m))) : TA.EI W =
    HS[G, A, m, k, rho, h].vF y hy ky W g ;

  -- the case  m = n+1 , y < z+1
  module CL (n k : Nat) (rho : W0.Ix (G.ob (lin (suc (suc n)))))
    (h : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].HornData (suc n) k rho)
    (y z : Nat) (hyz : IsT (ltb y (suc z))) (hy : IsT (leb y (suc (suc n)))) (hz : IsT (leb (suc z) (suc (suc n))))
    (ky : IsT (not (eqN y k))) (kz : IsT (not (eqN (suc z) k)))
    (W : Ob) (g : Hom W (lin (suc (suc n)))) (msy : Miss W (suc n) y g) (msz : Miss W (suc n) (suc z) g) {
    m : Nat = suc n ;
    X : Ob = lin (suc m) ;
    module S = HS[G, A, m, k, rho, h] ;

    -- the two faces agree on their common face (naturality of h)
    hc : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin m) (dl n z) (S.fE y hy ky)) (TA.E.act (lin n) (lin m) (dl n y) (S.fE (suc z) hz kz)) =
      transH (h.2.2 n m (dl n z) (dl m y) (S.Lf y hy ky)
                (DS.lands-comp n m (suc m) (DHm.hornS m k) (dl m y) (dl n z) (S.Lf y hy ky)))
        (transH (S.DH.PT.pv-hom (suc m) rho S.hS n (compH (lin n) (lin m) X (dl m y) (dl n z)) (compH (lin n) (lin m) X (dl m (suc z)) (dl n y))
                   (hom-eq (lin n) X _ _ (pw-sym (lin n) X _ _ (pw-dl-dl n y z hyz)))
                   (DS.lands-comp n m (suc m) (DHm.hornS m k) (dl m y) (dl n z) (S.Lf y hy ky))
                   (DS.lands-comp n m (suc m) (DHm.hornS m k) (dl m (suc z)) (dl n y) (S.Lf (suc z) hz kz)))
                (symH (h.2.2 n m (dl n y) (dl m (suc z)) (S.Lf (suc z) hz kz)
                         (DS.lands-comp n m (suc m) (DHm.hornS m k) (dl m (suc z)) (dl n y) (S.Lf (suc z) hz kz))))) ;

    g' : Hom W (lin m) = compH W X (lin m) (dgH m y) g ;

    msaux : (t : Tree) (hh : IsT (car X t)) -> IsT (not (eqN (vnum t) y)) -> IsT (not (eqN (vnum t) (suc z)))
      -> IsT (not (eqN (vnum (app X (lin m) (dgH m y) (t, hh)).1) z)) = split {
      leaf j -> \ hh kj kz' -> neq-of (dg m y j) z
        (\ e -> neq-elim (suc z) (substH (\ v -> IsT (not (eqN v (suc z)))) (dg-hit m y z j hy hh kj hyz e) kz')) ;
      node c d -> \ hh kj kz' -> absurd _ (false-true hh) } ;

    ms' : Miss W n z g' = \ s ->
      substH (\ t -> IsT (not (eqN (vnum t) z))) (symH (app-compH1 W X (lin m) (dgH m y) g s))
             (msaux (app W X g s).1 (app W X g s).2 (msy s) (msz s)) ;

    hh : Hom W (lin n) = compH W (lin m) (lin n) (dgH n z) g' ;

    eq-ddh : Id (Hom W X) (compH W (lin m) X (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh)) g =
      calc (Hom W X) {
          compH W (lin m) X (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh)
        =< symH (comp-assoc W (lin n) (lin m) X (dl m (suc z)) (dl n y) hh) >
          compH W (lin n) X (compH (lin n) (lin m) X (dl m (suc z)) (dl n y)) hh
        =< apH (\ k' -> compH W (lin n) X k' hh) (hom-eq (lin n) X _ _ (pw-dl-dl n y z hyz)) >
          compH W (lin n) X (compH (lin n) (lin m) X (dl m y) (dl n z)) hh
        =< comp-assoc W (lin n) (lin m) X (dl m y) (dl n z) hh >
          compH W (lin m) X (dl m y) (compH W (lin n) (lin m) (dl n z) hh)
        =< apH (compH W (lin m) X (dl m y)) (hom-eq W (lin m) _ _ (pw-factor W n z g' hz ms')) >
          compH W (lin m) X (dl m y) g'
        =< hom-eq W X _ _ (pw-factor W m y g hy msy) >
          g } ;

    eq-dlh : Id (Hom W (lin m)) (compH W (lin n) (lin m) (dl n y) hh) (compH W X (lin m) (dgH m (suc z)) g) =
      calc (Hom W (lin m)) {
          compH W (lin n) (lin m) (dl n y) hh
        =< symH (comp-idl W (lin m) (compH W (lin n) (lin m) (dl n y) hh)) >
          compH W (lin m) (lin m) (idH (lin m)) (compH W (lin n) (lin m) (dl n y) hh)
        =< apH (\ k' -> compH W (lin m) (lin m) k' (compH W (lin n) (lin m) (dl n y) hh))
               (symH (hom-eq (lin m) (lin m) _ _ (pw-dg-dl m (suc z) hz))) >
          compH W (lin m) (lin m) (compH (lin m) X (lin m) (dgH m (suc z)) (dl m (suc z))) (compH W (lin n) (lin m) (dl n y) hh)
        =< comp-assoc W (lin m) X (lin m) (dgH m (suc z)) (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh) >
          compH W X (lin m) (dgH m (suc z)) (compH W (lin m) X (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh))
        =< apH (compH W X (lin m) (dgH m (suc z))) eq-ddh >
          compH W X (lin m) (dgH m (suc z)) g } ;

    res : Id (TA.EI W) (S.vF y hy ky W g) (S.vF (suc z) hz kz W g) =
      transH (TA.PE.actEq W (lin m) g' (compH W (lin n) (lin m) (dl n z) hh)
                (hom-eq W (lin m) g' (compH W (lin n) (lin m) (dl n z) hh) (pw-sym W (lin m) (compH W (lin n) (lin m) (dl n z) hh) g' (pw-factor W n z g' hz ms')))
                (S.fE y hy ky))
       (transH (symH (TA.PE.actC W (lin n) (lin m) (dl n z) hh (S.fE y hy ky)))
        (transH (apH (TA.E.act W (lin n) hh) hc)
         (transH (TA.PE.actC W (lin n) (lin m) (dl n y) hh (S.fE (suc z) hz kz))
                 (TA.PE.actEq W (lin m) _ _ eq-dlh (S.fE (suc z) hz kz))))) ;
  } ;

  compat-lt : (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (lin (suc m))))
    (h : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].HornData m k rho)
    (y z : Nat) (hyz : IsT (ltb y z)) (hy : IsT (leb y (suc m))) (hz : IsT (leb z (suc m)))
    (ky : IsT (not (eqN y k))) (kz : IsT (not (eqN z k)))
    (W : Ob) (g : Hom W (lin (suc m))) -> Miss W m y g -> Miss W m z g
    -> Id (TA.EI W) (VF m k rho h y hy ky W g) (VF m k rho h z hz kz W g) = split {
    zero -> \ k hk rho h y z hyz hy hz ky kz W g msy msz -> absurd _ (compat-0 k y z hyz hz ky kz hk) ;
    suc n -> \ k hk rho h y -> split {
      zero -> \ hyz hy hz ky kz W g msy msz -> absurd _ (false-true hyz) ;
      suc z -> \ hyz hy hz ky kz W g msy msz -> CL[n, k, rho, h, y, z, hyz, hy, hz, ky, kz, W, g, msy, msz].res } } ;

  vF-compat (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (lin (suc m))))
    (h : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].HornData m k rho)
    (y z : Nat) (hy : IsT (leb y (suc m))) (hz : IsT (leb z (suc m)))
    (ky : IsT (not (eqN y k))) (kz : IsT (not (eqN z k)))
    (W : Ob) (g : Hom W (lin (suc m))) (msy : Miss W m y g) (msz : Miss W m z g)
    : Id (TA.EI W) (VF m k rho h y hy ky W g) (VF m k rho h z hz kz W g) =
    AL.eqN-dec (Id (TA.EI W) (VF m k rho h y hy ky W g) (VF m k rho h z hz kz W g)) y z
      (\ e -> idJ Nat y
                (\ z1 e1 -> (hz1 : IsT (leb z1 (suc m))) (kz1 : IsT (not (eqN z1 k)))
                   -> Id (TA.EI W) (VF m k rho h y hy ky W g) (VF m k rho h z1 hz1 kz1 W g))
                (\ hz1 kz1 -> HS[G, A, m, k, rho, h].vF-irr y hy hz1 ky kz1 W g) z e hz kz)
      (\ ne -> AL.ltb-dec (Id (TA.EI W) (VF m k rho h y hy ky W g) (VF m k rho h z hz kz W g)) y z
         (\ lt -> compat-lt m k hk rho h y z (transH (symH (leb-lvl (suc y) z)) lt) hy hz ky kz W g msy msz)
         (\ ge -> symH (compat-lt m k hk rho h z y (transH (symH (leb-lvl (suc z) y)) (AL.leb-neq z y ge (AL.neq-sym y z ne))) hz hy kz ky W g msz msy))) ;
} ;

------------------------------------------------------------------------
-- the horn as a partial element of A on the poset horn, and its filling

module HP (G : PP.PCtx) (A : PP.PTy[G]) (m k : Nat) (hk : IsT (leb k (suc m))) (rho : W0.Ix (G.ob (lin (suc m))))
  (h : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].HornData m k rho) {
  module S = HS[G, A, m, k, rho, h] ;
  module C = HC[G, A] ;
  module H = PH[m, k] ;
  module TA = S.TA ;
  module PT = PB.CPartial[l].Partials[G, A] ;
  X : Ob = H.X ;

  -- the face chosen by a proof that g is in the poset horn
  wy (W : Ob) (g : Hom W X) (i : SP.Lands W X H.hornP g) : Fin (suc (suc m)) = (SP.bigU-out W X (suc (suc m)) H.Qy g i).1 ;

  wq (W : Ob) (g : Hom W X) (i : SP.Lands W X H.hornP g) : PosetSub.Lands W X (BH.QH m k (wy W g i).1) g =
    H.inQ (wy W g i) W g (SP.bigU-out W X (suc (suc m)) H.Qy g i).2 ;

  pv (W : Ob) (g : Hom W X) (i : SP.Lands W X H.hornP g) : TA.EI W =
    S.vF (wy W g i).1 (wy W g i).2 (H.inqK (wy W g i).1 W g (wq W g i)) W g ;

  pv-any (W : Ob) (g : Hom W X) (i : SP.Lands W X H.hornP g) (y : Nat) (hy : IsT (leb y (suc m))) (ky : IsT (not (eqN y k)))
    (ms : Miss W m y g) : Id (TA.EI W) (pv W g i) (S.vF y hy ky W g) =
    C.vF-compat m k hk rho h (wy W g i).1 y (wy W g i).2 hy (H.inqK (wy W g i).1 W g (wq W g i)) ky W g
      (H.inqM (wy W g i).1 W g (wq W g i)) ms ;

  side : PT.Side[X, rho] =
    new PT.Side[X, rho, H.hornP, pv,
      \ W g i -> S.vF-pt (wy W g i).1 (wy W g i).2 (H.inqK (wy W g i).1 W g (wq W g i)) W g (H.inqM (wy W g i).1 W g (wq W g i)),
      \ W' W chi g i i' ->
        transH (S.vF-nat (wy W g i).1 (wy W g i).2 (H.inqK (wy W g i).1 W g (wq W g i)) W' W chi g)
          (symH (pv-any W' (compH W' W X g chi) i' (wy W g i).1 (wy W g i).2 (H.inqK (wy W g i).1 W g (wq W g i))
                   (\ s -> substH (\ t -> IsT (not (eqN (vnum t) (wy W g i).1))) (symH (app-compH1 W' W X g chi s))
                             (H.inqM (wy W g i).1 W g (wq W g i) (app W' W chi s)))))] ;

  -- R3: the retraction lines map the horn into the horn
  r3 (rN : Nat -> Nat -> Nat) (rD : (W : Ob) -> Hom W X -> Hom W Iv -> Hom W X)
    (rmiss : (y : Nat) -> (P : (j e : Nat) -> IsT (leb e (suc zero)) -> IsT (not (eqN j y)) -> IsT (not (eqN (rN j e) y)))
             -> (W : Ob) (f : Hom W X) (i : Hom W Iv) -> Miss W m y f -> Miss W m y (rD W f i))
    (P : (y : Nat) -> IsT (not (eqN y k)) -> (j e : Nat) -> IsT (leb e (suc zero)) -> IsT (not (eqN j y)) -> IsT (not (eqN (rN j e) y)))
    (W : Ob) (f : Hom W X) (i : Hom W Iv) (l0 : SP.Lands W X H.hornP f) : SP.Lands W X H.hornP (rD W f i) =
    H.inHorn (wy W f l0).1 (wy W f l0).2 (H.inqK (wy W f l0).1 W f (wq W f l0)) W (rD W f i)
      (rmiss (wy W f l0).1 (P (wy W f l0).1 (H.inqK (wy W f l0).1 W f (wq W f l0))) W f i (H.inqM (wy W f l0).1 W f (wq W f l0))) ;

  -- a filler of the poset horn extends the Delta horn
  ext (a0 : TA.T X rho)
    (fs : (W : Ob) (f : Hom W X) (i : SP.Lands W X H.hornP f) -> Id (TA.EI W) (TA.E.act W X f (rho, a0)) (pv W f i))
    : DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA].Ext m k rho h =
    (a0, \ W f i ->
      transH (fs (lin W) f (H.inHorn (DHm.horn-lands W m k f i).1 (DHm.horn-lands W m k f i).2.1 (DHm.horn-lands W m k f i).2.2.1
                              (lin W) f (DHm.horn-lands W m k f i).2.2.2))
        (transH (pv-any (lin W) f (H.inHorn (DHm.horn-lands W m k f i).1 (DHm.horn-lands W m k f i).2.1 (DHm.horn-lands W m k f i).2.2.1
                                     (lin W) f (DHm.horn-lands W m k f i).2.2.2)
                   (DHm.horn-lands W m k f i).1 (DHm.horn-lands W m k f i).2.1 (DHm.horn-lands W m k f i).2.2.1 (DHm.horn-lands W m k f i).2.2.2)
                (S.vF-h (DHm.horn-lands W m k f i).1 (DHm.horn-lands W m k f i).2.1 (DHm.horn-lands W m k f i).2.2.1 W f
                   (DHm.horn-lands W m k f i).2.2.2 i))) ;
} ;

------------------------------------------------------------------------
-- a fibration of A gives a horn filling operation on i*A

module HornOfFib (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  module DH = DHn.DH[RS.R[G].iG, RS.R[G].T[A].iA] ;

  -- k = 0: the constant 0 at e0 misses m+1; composition from e0 to e1
  module K0 (m : Nat) (rho : W0.Ix (G.ob (lin (suc m)))) (h : DH.HornData m zero rho) {
    module P = HP[G, A, m, zero, refl true, rho, h] ;
    module RD = BH.DT[m].RD ;
    module F = PB.CHornRetr[l].RF[G, A, e0, e1, c.1, P.X, rho, P.side,
      RD.rD, RD.rDn, RD.rD-end e1 (\ j -> refl j),
      \ W f -> P.H.inHorn (suc m) (leb-refl m) (refl true) W (RD.rD W f (constH W Iv e0))
                 (\ s -> substH (\ t -> IsT (not (eqN (vnum t) (suc m)))) (symH (RD.rD-app W f (constH W Iv e0) s)) (refl true)),
      P.r3 (\ j e -> BH.rTN j e) RD.rD RD.rD-miss BH.PT] ;
    ext : DH.Ext m zero rho h = P.ext F.fill F.fill-side ;
  } ;

  -- k = k'+1: max(- , k) at e1 misses 0; composition from e1 to e0
  module K1 (m k : Nat) (hk : IsT (leb (suc k) (suc m))) (rho : W0.Ix (G.ob (lin (suc m)))) (h : DH.HornData m (suc k) rho) {
    module P = HP[G, A, m, suc k, hk, rho, h] ;
    module RD = BH.DF[m, k, hk].RD ;
    module F = PB.CHornRetr[l].RF[G, A, e1, e0, c.2, P.X, rho, P.side,
      RD.rD, RD.rDn, RD.rD-end e0 (\ j -> refl j),
      \ W f -> P.H.inHorn zero (refl true) (refl true) W (RD.rD W f (constH W Iv e1))
                 (\ s -> substH (\ t -> IsT (not (eqN (vnum t) zero))) (symH (RD.rD-app W f (constH W Iv e1) s))
                           (BH.max-pos (vnum (app W P.X f s).1) k)),
      P.r3 (\ j e -> BH.rFN (suc k) j e) RD.rD RD.rD-miss (BH.PF k)] ;
    ext : DH.Ext m (suc k) rho h = P.ext F.fill F.fill-side ;
  } ;

  extK (m : Nat) : (k : Nat) -> IsT (leb k (suc m)) -> (rho : W0.Ix (G.ob (lin (suc m)))) -> (h : DH.HornData m k rho) -> DH.Ext m k rho h = split {
    zero -> \ hk rho h -> K0[m, rho, h].ext ;
    suc k -> \ hk rho h -> K1[m, k, hk, rho, h].ext } ;

  horn : DH.isFib = \ m k hk rho h -> extK m k hk rho h ;
} ;
