-- CGlueUniq.seg (L6, inside CB): a glue datum read through carts is
-- unique (model.tex lem:glue-unique).  A datum x whose codes are the
-- construction's (P) and whose equivalence is eg moved along carts of
-- its own triple (Hx), agreeing pointwise with the construction's after
-- any path of codes (PtAp, PtBp: the transport along P is the identity up
-- to such paths, CGlueLaws.Pw), is the construction's datum.  Proof:
-- transport = move (lemT), moving twice = moving along the composite
-- (HComp), pointwise equal carts move alike (HCong).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module GU
  (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (X : Ob) (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) (ph : Phi X)
  (B : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BTy X ph)
  (bn : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BNat X ph B)
  (G : L.PCtx) (Bg Ag : L.PTy[G]) (alg : CPartial[a+].PMap[G, Bg, Ag]) (eg : CEquiv[a+].EquivOp G Bg Ag alg)
  (io : (W : Ob) -> W0.Ix ((CGlueE.RCm[X, ph].RC).ob W) -> V1.Ix (G.ob W))
  (io-nat : (V W : Ob) (g : Hom V W) (r : W0.Ix ((CGlueE.RCm[X, ph].RC).ob W))
     -> Id (V1.Ix (G.ob V)) (io V ((CGlueE.RCm[X, ph].RC).act V W g r)) (G.act V W g (io W r)))
  -- the A-cart
  (tA : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W -> LP.TyL[G, Ag].EI W)
  (tApt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (V1.Ix (G.ob W)) (tA W v).1 (io W v.1))
  (tAnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (tA W v))
          (tA V (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].E.act V W g v)))
  (tAinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (tA W v) (tA W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W) v v')
  (bkA : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x))) -> W0.Ix (F.1.tob Y x.1))
  (bkAta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x)))
     -> Id (LP.TyL[G, Ag].EI Y) (tA Y (x, bkA Y x z)) (io Y x, z))
  -- the B-cart
  (tB : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W -> LP.TyL[G, Bg].EI W)
  (tBpt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (V1.Ix (G.ob W)) (tB W v).1 (io W v.1))
  (tBnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (tB W v))
          (tB V (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].E.act V W g v)))
  (tBinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (tB W v) (tB W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W) v v')
  (bkB : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> W0.Ix ((CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn).tob Y x))
  (bkBta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> Id (LP.TyL[G, Bg].EI Y) (tB Y (x, bkB Y x z)) (io Y x, z))
  (x : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 X)
  (P : Id (CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].GD0 X) x.1 (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0)))
  (xs : (W : Ob) -> W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W) -> V1.Ix (G.ob W))
  (xs-nat : (V W : Ob) (g : Hom V W) (d : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) -> Id (V1.Ix (G.ob V)) (xs V ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).act V W g d)) (G.act V W g (xs W d)))
  (xtA : (W : Ob) -> GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W -> LP.TyL[G, Ag].EI W)
  (xtApt : (W : Ob) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W) -> Id (V1.Ix (G.ob W)) (xtA W v).1 (xs W v.1))
  (xtAnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (xtA W v)) (xtA V (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].E.act V W g v)))
  (xtAinj : (W : Ob) (v v' : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W) (P : Id (W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (xtA W v) (xtA W v'))
     -> Id (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W) v v')
  (xbkA : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Ag.tob Y (xs Y y))) -> W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1).tob Y y))
  (xbkAta : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Ag.tob Y (xs Y y))) -> Id (LP.TyL[G, Ag].EI Y) (xtA Y (y, xbkA Y y u)) (xs Y y, u))
  (xtB : (W : Ob) -> GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W -> LP.TyL[G, Bg].EI W)
  (xtBpt : (W : Ob) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) -> Id (V1.Ix (G.ob W)) (xtB W v).1 (xs W v.1))
  (xtBnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (xtB W v)) (xtB V (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].E.act V W g v)))
  (xtBinj : (W : Ob) (v v' : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) (P : Id (W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (xtB W v) (xtB W v'))
     -> Id (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) v v')
  (xbkB : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Bg.tob Y (xs Y y))) -> W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1).tob Y y))
  (xbkBta : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Bg.tob Y (xs Y y))) -> Id (LP.TyL[G, Bg].EI Y) (xtB Y (y, xbkB Y y u)) (xs Y y, u))
  (xcomm : (W : Ob) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) -> Id (LP.TyL[G, Ag].EI W) (xtA W ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].alf X x.1).mE W v)) (alg.mE W (xtB W v)))
  (Hx : Id (CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].EqOn X x.1) x.2 (CHFibCart[a+, a].HCart[CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1, CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1, CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1, CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].alf X x.1, G, Bg, Ag, alg, xs, xs-nat, xtA, xtApt, xtAnat, xtAinj, xbkA, xbkAta, xtB, xtBpt, xtBnat, xtBinj, xbkB, xbkBta, xcomm].moveEq eg))
  (PtAp : (W : Ob) (r : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).ob W)) (r' : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) (Er : Id (Hom W X) r'.1 r.1)
     (z : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r)) (cz : Id W0.V ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1).tob W r'))
     -> Id (LP.TyL[G, Ag].EI W) (xtA W (r', CExtEq1.sV ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1).tob W r') cz z)) (tA W (r, z)))
  (PtBp : (W : Ob) (r : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).ob W)) (r' : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) (Er : Id (Hom W X) r'.1 r.1)
     (z : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r)) (cz : Id W0.V ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1).tob W r'))
     -> Id (LP.TyL[G, Bg].EI W) (xtB W (r', CExtEq1.sV ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1).tob W r') cz z)) (tB W (r, z))) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GLw = CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module D = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta] ;
  c : DD.GD0 X = (F, (ph, D.bd0)) ;
  module TR = GLw.Pw[X, x.1].TR ;
  module HX = CHFibCart[a+, a].HCart[GLw.Gf X x.1, GLw.Bf X x.1, GLw.Af X x.1, GLw.alf X x.1, G, Bg, Ag, alg, xs, xs-nat, xtA, xtApt, xtAnat, xtAinj, xbkA, xbkAta, xtB, xtBpt, xtBnat, xtBinj, xbkB, xbkBta, xcomm] ;

  module PW = GLw.Pw[X, x.1] ;

  PtA (W : Ob) (v : GPR.TyL[GLw.Gf X c, GLw.Af X c].EI W) : Id (LP.TyL[G, Ag].EI W) (xtA W (TR.tA c P W v)) (tA W v) =
    transH (apH (xtA W) (PW.L2A c P W v.1 v.2))
      (PtAp W v.1 (TR.s c P W v.1) (PW.L1 c P W v.1) v.2 (PW.QA c P W v.1)) ;

  PtB (W : Ob) (v : GPR.TyL[GLw.Gf X c, GLw.Bf X c].EI W) : Id (LP.TyL[G, Bg].EI W) (xtB W (TR.tB c P W v)) (tB W v) =
    transH (apH (xtB W) (PW.L2B c P W v.1 v.2))
      (PtBp W v.1 (TR.s c P W v.1) (PW.L1 c P W v.1) v.2 (PW.QB c P W v.1)) ;

  module HC = CHFibLaws[a, a, a+].HComp[GLw.Gf X c, GLw.Bf X c, GLw.Af X c, GLw.alf X c, GLw.Gf X x.1, GLw.Bf X x.1, GLw.Af X x.1, GLw.alf X x.1, G, Bg, Ag, alg,
    TR.s c P, TR.s-nat c P, TR.tA c P, TR.tApt c P, TR.tAnat c P, TR.tAinj c P, TR.bkA c P, TR.bkAta c P, TR.tB c P, TR.tBpt c P, TR.tBnat c P, TR.tBinj c P, TR.bkB c P, TR.bkBta c P, TR.comm c P,
    xs, xs-nat, xtA, xtApt, xtAnat, xtAinj, xbkA, xbkAta, xtB, xtBpt, xtBnat, xtBinj, xbkB, xbkBta, xcomm, eg] ;

  eqPart : Id (GE.EqOn X c) (subst (DD.GD0 X) (GE.EqOn X) x.1 c P x.2) (D.H.moveEq eg) =
    transH (apH (subst (DD.GD0 X) (GE.EqOn X) x.1 c P) Hx)
     (transH (TR.lemT c P (HX.moveEq eg))
      (transH HC.comp
       (CHFibLaws[a, a, a+].HCong[GLw.Gf X c, GLw.Bf X c, GLw.Af X c, GLw.alf X c, G, Bg, Ag, alg,
          HC.s, HC.s-nat, HC.tA, HC.tApt, HC.tAnat, HC.tAinj, HC.bkA, HC.bkAta, HC.tB, HC.tBpt, HC.tBnat, HC.tBinj, HC.bkB, HC.bkBta, HC.comm,
          io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta, D.comm,
          PtA, PtB, eg].cong))) ;

  -- the datum is the construction's
  law : Id (GE.GD1 X) x D.dat =
    Sigma-path (DD.GD0 X) (GE.EqOn X) x.1 c x.2 (D.H.moveEq eg) P eqPart ;
} ;

-- the same, with the path of codes built here: A and the sieve are given,
-- B by its codes (PB); alpha agrees because both alphas are read off the
-- carts (al-g, xcomm, PtAp, PtBp, tAinj).
module GU2
  (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (X : Ob) (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) (ph : Phi X)
  (B : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BTy X ph)
  (bn : CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl].BNat X ph B)
  (G : L.PCtx) (Bg Ag : L.PTy[G]) (alg : CPartial[a+].PMap[G, Bg, Ag]) (eg : CEquiv[a+].EquivOp G Bg Ag alg)
  (io : (W : Ob) -> W0.Ix ((CGlueE.RCm[X, ph].RC).ob W) -> V1.Ix (G.ob W))
  (io-nat : (V W : Ob) (g : Hom V W) (r : W0.Ix ((CGlueE.RCm[X, ph].RC).ob W))
     -> Id (V1.Ix (G.ob V)) (io V ((CGlueE.RCm[X, ph].RC).act V W g r)) (G.act V W g (io W r)))
  -- the A-cart
  (tA : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W -> LP.TyL[G, Ag].EI W)
  (tApt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (V1.Ix (G.ob W)) (tA W v).1 (io W v.1))
  (tAnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (tA W v))
          (tA V (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].E.act V W g v)))
  (tAinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (tA W v) (tA W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, subTy (CGlueE.RCm[X, ph].RC) (yP X) F.1 CGlueE.RCm[X, ph].inclRC].EI W) v v')
  (bkA : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x))) -> W0.Ix (F.1.tob Y x.1))
  (bkAta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Ag.tob Y (io Y x)))
     -> Id (LP.TyL[G, Ag].EI Y) (tA Y (x, bkA Y x z)) (io Y x, z))
  -- the B-cart
  (tB : (W : Ob) -> GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W -> LP.TyL[G, Bg].EI W)
  (tBpt : (W : Ob) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (V1.Ix (G.ob W)) (tB W v).1 (io W v.1))
  (tBnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (tB W v))
          (tB V (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].E.act V W g v)))
  (tBinj : (W : Ob) (v v' : GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W)
     (P : Id (W0.Ix ((CGlueE.RCm[X, ph].RC).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (tB W v) (tB W v'))
     -> Id (GPR.TyL[CGlueE.RCm[X, ph].RC, CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn].EI W) v v')
  (bkB : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> W0.Ix ((CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].BtOf X ph B bn).tob Y x))
  (bkBta : (Y : Ob) (x : W0.Ix ((CGlueE.RCm[X, ph].RC).ob Y)) (z : V1.Ix (Bg.tob Y (io Y x)))
     -> Id (LP.TyL[G, Bg].EI Y) (tB Y (x, bkB Y x z)) (io Y x, z))
  (x : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 X)
  (PA : Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X) x.1.1 F)
  (Pph : Id (Phi X) x.1.2.1 ph)
  (PB : (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X x.1.2.1 W f)) (q' : IsT (CGlueD.fl X ph W f))
     -> Id (CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 W) (x.1.2.2.1 W f q) (B W f q'))
  (xs : (W : Ob) -> W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W) -> V1.Ix (G.ob W))
  (xs-nat : (V W : Ob) (g : Hom V W) (d : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) -> Id (V1.Ix (G.ob V)) (xs V ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).act V W g d)) (G.act V W g (xs W d)))
  (xtA : (W : Ob) -> GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W -> LP.TyL[G, Ag].EI W)
  (xtApt : (W : Ob) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W) -> Id (V1.Ix (G.ob W)) (xtA W v).1 (xs W v.1))
  (xtAnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W)
     -> Id (LP.TyL[G, Ag].EI V) (LP.TyL[G, Ag].E.act V W g (xtA W v)) (xtA V (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].E.act V W g v)))
  (xtAinj : (W : Ob) (v v' : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W) (P : Id (W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Ag].EI W) (xtA W v) (xtA W v'))
     -> Id (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1)].EI W) v v')
  (xbkA : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Ag.tob Y (xs Y y))) -> W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1).tob Y y))
  (xbkAta : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Ag.tob Y (xs Y y))) -> Id (LP.TyL[G, Ag].EI Y) (xtA Y (y, xbkA Y y u)) (xs Y y, u))
  (xtB : (W : Ob) -> GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W -> LP.TyL[G, Bg].EI W)
  (xtBpt : (W : Ob) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) -> Id (V1.Ix (G.ob W)) (xtB W v).1 (xs W v.1))
  (xtBnat : (V W : Ob) (g : Hom V W) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W)
     -> Id (LP.TyL[G, Bg].EI V) (LP.TyL[G, Bg].E.act V W g (xtB W v)) (xtB V (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].E.act V W g v)))
  (xtBinj : (W : Ob) (v v' : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) (P : Id (W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) v.1 v'.1) (Q : Id (LP.TyL[G, Bg].EI W) (xtB W v) (xtB W v'))
     -> Id (GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) v v')
  (xbkB : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Bg.tob Y (xs Y y))) -> W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1).tob Y y))
  (xbkBta : (Y : Ob) (y : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob Y)) (u : V1.Ix (Bg.tob Y (xs Y y))) -> Id (LP.TyL[G, Bg].EI Y) (xtB Y (y, xbkB Y y u)) (xs Y y, u))
  (xcomm : (W : Ob) (v : GPR.TyL[(CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1), (CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1)].EI W) -> Id (LP.TyL[G, Ag].EI W) (xtA W ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].alf X x.1).mE W v)) (alg.mE W (xtB W v)))
  (Hx : Id (CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].EqOn X x.1) x.2 (CHFibCart[a+, a].HCart[CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1, CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1, CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1, CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].alf X x.1, G, Bg, Ag, alg, xs, xs-nat, xtA, xtApt, xtAnat, xtAinj, xbkA, xbkAta, xtB, xtBpt, xtBnat, xtBinj, xbkB, xbkBta, xcomm].moveEq eg))
  (PtAp : (W : Ob) (r : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).ob W)) (r' : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) (Er : Id (Hom W X) r'.1 r.1)
     (z : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r)) (cz : Id W0.V ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1).tob W r'))
     -> Id (LP.TyL[G, Ag].EI W) (xtA W (r', CExtEq1.sV ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Af X x.1).tob W r') cz z)) (tA W (r, z)))
  (PtBp : (W : Ob) (r : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).ob W)) (r' : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Gf X x.1).ob W)) (Er : Id (Hom W X) r'.1 r.1)
     (z : W0.Ix ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r)) (cz : Id W0.V ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1).tob W r'))
     -> Id (LP.TyL[G, Bg].EI W) (xtB W (r', CExtEq1.sV ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X (F, (ph, CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta].bd0))).tob W r) ((CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl].Bf X x.1).tob W r') cz z)) (tB W (r, z))) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module D = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta] ;

  module PL (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X x.1.2.1 W f)) (q' : IsT (CGlueD.fl X ph W f))
    (b : W0.Ix (UU.fib0 W (x.1.2.2.1 W f q))) {
    r : W0.Ix ((CGlueE.RCm[X, ph].RC).ob W) = (f, q') ;
    r' : W0.Ix ((CGlueE.RCm[X, x.1.2.1].RC).ob W) = (f, q) ;
    Bx : W0.V = UU.fib0 W (x.1.2.2.1 W f q) ;
    Bc : W0.V = UU.fib0 W (B W f q') ;
    b' : W0.Ix Bc = DD.trB W (x.1.2.2.1 W f q) (B W f q') (PB W f q q') b ;
    cz : Id W0.V Bc Bx = symH (apH (UU.fib0 W) (PB W f q q')) ;
    eB : Id (W0.Ix Bx) (CExtEq1.sV Bc Bx cz b') b =
      transH (apH (CExtEq1.sV Bc Bx cz) (UU.substF W (x.1.2.2.1 W f q) (B W f q') (PB W f q q') b))
             (CExtEq1.sV-two Bx Bc Bx (apH (UU.fib0 W) (PB W f q q')) cz (refl Bx) b) ;
    Ax : W0.V = x.1.1.1.tob W f ;
    Ac : W0.V = F.1.tob W f ;
    alx : W0.Ix Ax = x.1.2.2.2.2.1 W f q b ;
    aL : W0.Ix Ac = DD.trA X x.1.1 F PA W f alx ;
    cA : Id W0.V Ax Ac = apH {UU.U0 X} {W0.V} (\ A2 -> A2.1.tob W f) PA ;
    czA : Id W0.V Ac Ax = symH cA ;
    eA : Id (W0.Ix Ax) (CExtEq1.sV Ac Ax czA aL) alx =
      transH (apH (CExtEq1.sV Ac Ax czA) (subst-ap (UU.U0 X) W0.V (\ A2 -> A2.1.tob W f) (\ v -> W0.Ix v) x.1.1 F PA alx))
             (CExtEq1.sV-two Ax Ac Ax cA czA (refl Ax) alx) ;
    Q : Id (LP.TyL[G, Ag].EI W) (D.tA W (r, aL)) (D.tA W (r, D.al W f q' b')) =
      transH (symH (PtAp W r r' (refl f) aL czA))
       (transH (apH (\ z -> xtA W (r', z)) eA)
        (transH (xcomm W (r', b))
         (transH (apH (\ z -> alg.mE W (xtB W (r', z))) (symH eB))
          (transH (apH (alg.mE W) (PtBp W r r' (refl f) b' cz))
                  (symH (D.al-g W r b')))))) ;
    Pal : Id (W0.Ix Ac) aL (D.al W f q' b') =
      D.TAt.pr-inj W r aL (D.al W f q' b') (D.tAinj W (r, aL) (r, D.al W f q' b') (refl r) Q) ;
  } ;

  opaque PL.Pal ;

  P : Id (DD.GD0 X) x.1 (F, (ph, D.bd0)) =
    DD.gdExt X x.1.1 F PA x.1.2.1 ph Pph x.1.2.2 D.bd0 PB (\ W f q q' b -> PL[W, f, q, q', b].Pal) ;

  module G1 = GU[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn, G, Bg, Ag, alg, eg, io, io-nat, tA, tApt, tAnat, tAinj, bkA, bkAta, tB, tBpt, tBnat, tBinj, bkB, bkBta, x, P, xs, xs-nat, xtA, xtApt, xtAnat, xtAinj, xbkA, xbkAta, xtB, xtBpt, xtBnat, xtBinj, xbkB, xbkBta, xcomm, Hx, PtAp, PtBp] ;

  -- the datum is the construction's
  law : Id (CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 X) x D.dat = G1.law ;
} ;
