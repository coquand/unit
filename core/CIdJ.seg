-- CIdJ.seg (L3, inside CB, level l): J for Swan's identity type, with its
-- computation rule (model.tex §9.1, Thm "J, strictly").  Over G.A the type
-- Id(a , q) (CId.IdOver, paths from aE (x , b) = (x , a x) to
-- bE (x , b) = (x , b)); D = G.A.Id(a , q), its centre c x = (x , a x , refl).
-- The contraction of a point z = ((x , b) , (u , ph)) is the line
--     lam z (f , j) = ((x f , u (f , j)) , (u^{f , j} , f^* ph u (j = e0))),
--     u^{f , j} (g , k) = u (f g , c (j g , k))      (c = cI true: min),
-- constant at the centre on ph.  CJ.JC gives J and beta.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module IJ (G : PCtx) (A : PTy[G]) (a : PEl[G, A]) {
  module TA = GPR.TyL[G, A] ;

  K : PCtx = extP G A ;

  sJ (X : Ob) (w : W0.Ix (K.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (G.ob W) = G.act W X f w.1 ;

  sNJ (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
    (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (sJ I x W (compH W J I h f) i) (sJ J y W f i) =
    transH (G.act-o W J I h f x.1) (apH (\ z -> G.act W J f z.1) e) ;

  aEJ (W : Ob) (w : W0.Ix (K.ob W)) : TA.EI W = (w.1, a.eob W w.1) ;
  bEJ (W : Ob) (w : W0.Ix (K.ob W)) : TA.EI W = w ;

  -- aE at equal points of G
  aEq (W : Ob) (y y' : W0.Ix (G.ob W)) (p : Id (W0.Ix (G.ob W)) y y') : Id (TA.EI W) (y, a.eob W y) (y', a.eob W y') =
    apH (\ v -> (v, a.eob W v)) p ;

  aEJ-act (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X)) : Id (TA.EI W) (TA.E.act W X f (aEJ X x)) (aEJ W (K.act W X f x)) =
    CPath[l].PathEnds[G, A, a, a].aE-act W X f x.1 ;

  bEJ-act (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X)) : Id (TA.EI W) (TA.E.act W X f (bEJ X x)) (bEJ W (K.act W X f x)) =
    refl (TA.E.act W X f x) ;

  module IO = CId[l].IdOver[K, G, A, sJ, sNJ, aEJ, bEJ, aEJ-act, bEJ-act] ;
  module RF = IO.Refl[\ X x W f i -> refl (G.act W X f x.1)] ;
  module PT = IO.PT ;
  module TI = IO.TI ;

  IdTy : PTy[K] = IO.IdT ;

  D : PCtx = extP K IdTy ;

  module FD = CLine[l].FC[D] ;

  ----------------------------------------------------------------------
  -- the base and the centre

  pr : PSub[D, G] = new PSub[D, G, \ X z -> z.1.1, \ J I f z -> refl (G.act J I f z.1.1)] ;

  sa : PSub[G, K] = secP G A a ;

  reflEl : PEl[G, subTy G K IdTy sa] =
    new PEl[G, subTy G K IdTy sa, \ X x -> RF.reflI X (x, a.eob X x) (refl (x, a.eob X x)),
      \ J I f x y e -> RF.reflI-nat J I f (sa.nt I x) (sa.nt J y) (ntEq G K sa J I f x y e)
                         (refl (x, a.eob I x)) (refl (y, a.eob J y))] ;

  c : PSub[G, D] = oS G (extP G (subTy G K IdTy sa)) D (liftP G K IdTy sa) (secP G (subTy G K IdTy sa) reflEl) ;

  prc (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (G.ob X)) (pr.nt X (c.nt X x)) x = refl x ;

  ----------------------------------------------------------------------
  -- the contraction

  module LV (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (j : Hom W Iv) {
    x : W0.Ix (G.ob X) = z.1.1 ;
    u : W0.Ix (PT.tobP X z.1) = z.2.1 ;
    ph : Phi X = z.2.2.1 ;

    kp : W0.Ix (K.ob W) = (G.act W X f x, TA.fromE W (G.act W X f x) (u.1.1 W f j) (u.2.1 W f j)) ;

    kp-E : Id (TA.EI W) kp (u.1.1 W f j) = TA.fromE-eq W (G.act W X f x) (u.1.1 W f j) (u.2.1 W f j) ;

    t (W' : Ob) (g : Hom W' W) (k : Hom W' Iv) : TA.EI W' =
      u.1.1 W' (compH W' W X f g) (cI true W' (compH W' W Iv j g) k) ;

    tn (V W' : Ob) (g' : Hom V W') (g : Hom W' W) (k : Hom W' Iv)
      : Id (TA.EI V) (TA.E.act V W' g' (t W' g k)) (t V (compH V W' W g g') (compH V W' Iv k g')) =
      transH (u.1.2 V W' g' (compH W' W X f g) (cI true W' (compH W' W Iv j g) k))
       (transH (apH (\ m -> u.1.1 V m (compH V W' Iv (cI true W' (compH W' W Iv j g) k) g')) (comp-assoc V W' W X f g g'))
         (apH (\ m -> u.1.1 V (compH V W X f (compH V W' W g g')) m)
            (transH (cI-nat true V W' g' (compH W' W Iv j g) k)
               (apH (\ m -> cI true V m (compH V W' Iv k g')) (comp-assoc V W' W Iv j g g'))))) ;

    tp (W' : Ob) (g : Hom W' W) (k : Hom W' Iv) : Id (W0.Ix (G.ob W')) (t W' g k).1 (G.act W' W g (G.act W X f x)) =
      transH (u.2.1 W' (compH W' W X f g) (cI true W' (compH W' W Iv j g) k)) (G.act-o W' W X f g x) ;

    t0 : Id (TA.EI W) (t W (idH W) (ptH W e0)) (aEJ W kp) =
      transH (apH (\ m -> u.1.1 W (compH W W X f (idH W)) m) (cI-jsrc-t W (compH W W Iv j (idH W))))
        (transH (apH (\ m -> u.1.1 W m (ptH W e0)) (comp-idr W X f)) (PT.end0g X z.1 u W f)) ;

    t1 : Id (TA.EI W) (t W (idH W) (ptH W e1)) (bEJ W kp) =
      transH (apH (\ m -> u.1.1 W (compH W W X f (idH W)) m) (transH (cI-jtgt-t W (compH W W Iv j (idH W))) (comp-idr W Iv j)))
        (transH (apH (\ m -> u.1.1 W m j) (comp-idr W X f)) (symH kp-E)) ;

    pth : W0.Ix (PT.tobP W kp) = PT.mkPath W kp t tn tp t0 t1 ;

    Qs : Phi W = CId[l].orS W (pre W X f ph) (pre W Iv j (ptS e0)) ;

    -- the end: aE at the point of the restricted line
    fin (W'' : Ob) (g : Hom W'' W)
      : Id (TA.EI W'') (aEJ W'' (K.act W'' X (compH W'' W X f g) z.1)) (aEJ W'' (K.act W'' W g kp)) =
      aEq W'' (G.act W'' X (compH W'' W X f g) x) (G.act W'' W g (G.act W X f x)) (G.act-o W'' W X f g x) ;

    cond (W'' : Ob) (g : Hom W'' W) (i : Lands W'' W Qs g) (k : Hom W'' Iv)
      : Id (TA.EI W'') (pth.1.1 W'' g k) (aEJ W'' (K.act W'' W g kp)) =
      CId[l].or-elim W'' W (pre W X f ph) (pre W Iv j (ptS e0)) g
        (Id (TA.EI W'') (pth.1.1 W'' g k) (aEJ W'' (K.act W'' W g kp))) i
        (\ l1 -> transH (z.2.2.2 W'' (compH W'' W X f g) (lands-pre W'' W X f ph g l1) (cI true W'' (compH W'' W Iv j g) k)) (fin W'' g))
        (\ l2 -> transH (apH (\ m -> u.1.1 W'' (compH W'' W X f g) m)
                           (transH (apH (\ m -> cI true W'' m k) (lands-pt W'' e0 (compH W'' W Iv j g) (lands-pre W'' W Iv j (ptS e0) g l2)))
                                   (cI-isrc-t W'' k)))
                   (transH (PT.end0g X z.1 u W'' (compH W'' W X f g)) (fin W'' g))) ;

    v : W0.Ix (D.ob W) = (kp, (pth, (Qs, cond))) ;
  } ;

  lamV (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (j : Hom W Iv) : W0.Ix (D.ob W) = LV[X, z, W, f, j].v ;

  lamN (X : Ob) (z : W0.Ix (D.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
    : Id (W0.Ix (D.ob V)) (D.act V W g (lamV X z W f j)) (lamV X z V (compH V W X f g) (compH V W Iv j g)) =
    IO.tpI-ext V (D.act V W g (lamV X z W f j)) (lamV X z V (compH V W X f g) (compH V W Iv j g))
      (transH (apH (TA.E.act V W g) LV[X, z, W, f, j].kp-E)
        (transH (z.2.1.1.2 V W g f j) (symH LV[X, z, V, compH V W X f g, compH V W Iv j g].kp-E)))
      (\ V' g' k -> transH (apH (\ m -> z.2.1.1.1 V' m (cI true V' (compH V' W Iv j (compH V' V W g g')) k)) (symH (comp-assoc V' V W X f g g')))
                      (apH (\ m -> z.2.1.1.1 V' (compH V' V X (compH V W X f g) g') (cI true V' m k)) (symH (comp-assoc V' V W Iv j g g'))))
      (transH (CId[l].pre-or V W g (pre W X f z.2.2.1) (pre W Iv j (ptS e0)))
        (transH (apH (\ Q -> CId[l].orS V Q (pre V W g (pre W Iv j (ptS e0)))) (pre-comp V W X g f z.2.2.1))
                (apH (\ Q -> CId[l].orS V (pre V X (compH V W X f g) z.2.2.1) Q) (pre-comp V W Iv g j (ptS e0))))) ;

  lam (X : Ob) (z : W0.Ix (D.ob X)) : W0.Ix (FD.ob X) = (lamV X z, lamN X z) ;

  lam-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) : Id (W0.Ix (FD.ob Y)) (lam Y (D.act Y X h z)) (FD.actF Y X h (lam X z)) =
    FD.fam-eq Y (lam Y (D.act Y X h z)) (FD.actF Y X h (lam X z)) (\ W f j ->
      IO.tpI-ext W (lamV Y (D.act Y X h z) W f j) (lamV X z W (compH W Y X h f) j)
        (transH LV[Y, D.act Y X h z, W, f, j].kp-E (symH LV[X, z, W, compH W Y X h f, j].kp-E))
        (\ V g k -> apH (\ m -> z.2.1.1.1 V m (cI true V (compH V W Iv j g) k)) (symH (comp-assoc V W Y X h f g)))
        (apH (\ Q -> CId[l].orS W Q (pre W Iv j (ptS e0))) (pre-comp W Y X f h z.2.2.1))) ;

  -- at e0: the centre
  lam0 (X : Ob) (z : W0.Ix (D.ob X)) : Id (W0.Ix (D.ob X)) ((lam X z).1 X (idH X) (ptH X e0)) (c.nt X (pr.nt X z)) =
    IO.tpI-ext X ((lam X z).1 X (idH X) (ptH X e0)) (c.nt X (pr.nt X z))
      (transH LV[X, z, X, idH X, ptH X e0].kp-E
        (transH (PT.end0g X z.1 z.2.1 X (idH X)) (aEq X (G.act X X (idH X) z.1.1) z.1.1 (G.act-id X z.1.1))))
      (\ V g k -> transH (apH (\ m -> z.2.1.1.1 V (compH V X X (idH X) g) m)
                           (transH (apH (\ m -> cI true V m k) (ptH-nat V X g e0)) (cI-isrc-t V k)))
                   (transH (PT.end0g X z.1 z.2.1 V (compH V X X (idH X) g))
                     (aEq V (G.act V X (compH V X X (idH X) g) z.1.1) (G.act V X g z.1.1) (apH (\ m -> G.act V X m z.1.1) (comp-idl V X g)))))
      (phi-ext X LV[X, z, X, idH X, ptH X e0].Qs (topS X) (\ W f i -> top-lands W X f)
         (\ W f i -> CId[l].or-r W X (pre X X (idH X) z.2.2.1) (pre X Iv (ptH X e0) (ptS e0)) f
            (pre-lands W X Iv (ptH X e0) (ptS e0) f
               (lands-eq W Iv (ptS e0) (ptH W e0) (compH W X Iv (ptH X e0) f) (symH (ptH-nat W X f e0)) (pt-lands W e0))))) ;

  -- at e1: the point itself
  lam1 (X : Ob) (z : W0.Ix (D.ob X)) : Id (W0.Ix (D.ob X)) ((lam X z).1 X (idH X) (ptH X e1)) z =
    IO.tpI-ext X ((lam X z).1 X (idH X) (ptH X e1)) z
      (transH LV[X, z, X, idH X, ptH X e1].kp-E z.2.1.2.2.2)
      (\ V g k -> transH (apH (\ m -> z.2.1.1.1 V (compH V X X (idH X) g) m)
                           (transH (apH (\ m -> cI true V m k) (ptH-nat V X g e1)) (cI-itgt-t V k)))
                   (apH (\ m -> z.2.1.1.1 V m k) (comp-idl V X g)))
      (phi-ext X LV[X, z, X, idH X, ptH X e1].Qs z.2.2.1
         (\ W f i -> CId[l].or-elim W X (pre X X (idH X) z.2.2.1) (pre X Iv (ptH X e1) (ptS e0)) f (Lands W X z.2.2.1 f) i
            (\ l1 -> lands-sub W X (pre X X (idH X) z.2.2.1) z.2.2.1 (pre-id X z.2.2.1) f l1)
            (\ l2 -> absurd (Lands W X z.2.2.1 f)
               (pt-disj W (ptH W e1)
                  (lands-eq W Iv (ptS e0) (compH W X Iv (ptH X e1) f) (ptH W e1) (ptH-nat W X f e1) (lands-pre W X Iv (ptH X e1) (ptS e0) f l2))
                  (pt-lands W e1))))
         (\ W f i -> CId[l].or-l W X (pre X X (idH X) z.2.2.1) (pre X Iv (ptH X e1) (ptS e0)) f
            (lands-sub W X z.2.2.1 (pre X X (idH X) z.2.2.1) (symH (pre-id X z.2.2.1)) f i))) ;

  psi (X : Ob) (z : W0.Ix (D.ob X)) : Phi X = z.2.2.1 ;

  psi-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) : Id (Phi Y) (pre Y X h (psi X z)) (psi Y (D.act Y X h z)) =
    refl (pre Y X h z.2.2.1) ;

  psi-c (X : Ob) (x : W0.Ix (G.ob X)) : Lands X X (psi X (c.nt X x)) (idH X) = top-lands X X (idH X) ;

  -- on ph, the line is the centre
  lam-c (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (i : Lands W X (psi X z) f) (j : Hom W Iv)
    : Id (W0.Ix (D.ob W)) ((lam X z).1 W f j) (c.nt W (pr.nt W (D.act W X f z))) =
    IO.tpI-ext W ((lam X z).1 W f j) (c.nt W (pr.nt W (D.act W X f z)))
      (transH LV[X, z, W, f, j].kp-E (z.2.2.2 W f i j))
      (\ V g k -> transH (z.2.2.2 V (compH V W X f g) (lands-comp V W X z.2.2.1 f g i) (cI true V (compH V W Iv j g) k))
                   (aEq V (G.act V X (compH V W X f g) z.1.1) (G.act V W g (G.act W X f z.1.1)) (G.act-o V W X f g z.1.1)))
      (phi-ext W LV[X, z, W, f, j].Qs (topS W) (\ W' g h -> top-lands W' W g)
         (\ W' g h -> CId[l].or-l W' W (pre W X f z.2.2.1) (pre W Iv j (ptS e0)) g
            (pre-lands W' W X f z.2.2.1 g (lands-comp W' W X z.2.2.1 f g i)))) ;

  ----------------------------------------------------------------------
  -- J and its computation rule

  module JJ (C : PTy[D]) (cC : CLine[l].Lines[D, C].CompK[e0, e1].Comp) (d : PEl[G, subTy G D C c]) {
    module J0 = CJ[l].JC[G, D, pr, c, prc, lam, lam-nat, lam0, lam1, psi, psi-nat, psi-c, lam-c, C, cC, d] ;

    J : PEl[D, C] = J0.J ;

    -- J d (x , a x , refl) = d x
    beta (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (C.tob X (c.nt X x))) (J.eob X (c.nt X x)) (d.eob X x) = J0.beta X x ;
  } ;
} ;
