-- CPosBase.seg (L8, posets): the category of posets as an instance of the
-- base CB (model.tex §8.1).  Phi X: the decidable sieves of X (CSieve),
-- closed under finite unions; the end points of [1] as sieves of [1];
-- forall along the interval decided at the generic point (pr1 , pr2) of
-- W * [1] (one test; stable under precomposition by the naturality of the
-- line alone); the connections min / max of [1], pointwise.
--
-- Quarry: seg/model PosS (sieves), Conn (the arithmetic of min / max).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;

------------------------------------------------------------------------
-- the canonical decidable sieves of the category of posets

module SP = CSieve[a].Sieves[obV, homV, idH, compH, comp-assoc] ;

plands-eq (W X : Ob) (Q : Subset X) (f f' : Hom W X) (p : Id (Hom W X) f f') (i : PosetSub.Lands W X Q f) : PosetSub.Lands W X Q f' =
  subst (Hom W X) (\ k -> PosetSub.Lands W X Q k) f f' p i ;

isIn (V Y : Ob) (k : Hom V Y) (Q : Subset Y) : Bool = allIn V (PosetSub.pre V Y k Q) ;

isIn-sound (V Y : Ob) (k : Hom V Y) (Q : Subset Y) (h : IsT (isIn V Y k Q)) : PosetSub.Lands V Y Q k =
  plands-eq V Y Q (compH V V Y k (idH V)) k (comp-idr V Y k)
    (PosetSub.lands-pre V V Y k Q (idH V) (PosetSub.allS-sound V (PosetSub.pre V Y k Q) h)) ;

isIn-complete (V Y : Ob) (k : Hom V Y) (Q : Subset Y) (i : PosetSub.Lands V Y Q k) : IsT (isIn V Y k Q) =
  PosetSub.allS-complete V (PosetSub.pre V Y k Q)
    (PosetSub.pre-lands V V Y k Q (idH V) (plands-eq V Y Q k (compH V V Y k (idH V)) (symH (comp-idr V Y k)) i)) ;

subS (W Y : Ob) (k : Hom W Y) (Q : Subset Y) : SP.Phi W =
  (\ V g -> isIn V Y (compH V W Y k g) Q,
   \ V' V g g' i -> isIn-complete V' Y (compH V' W Y k (compH V' V W g g')) Q
       (plands-eq V' Y Q (compH V' V Y (compH V W Y k g) g') (compH V' W Y k (compH V' V W g g'))
          (comp-assoc V' V W Y k g g')
          (PosetSub.lands-comp V' V Y Q (compH V W Y k g) g' (isIn-sound V Y (compH V W Y k g) Q i)))) ;

-- the two end points of [1]
sptS (e : El Iv) : SP.Phi Iv = subS Iv Iv (idH Iv) (PosetSub.ptS e) ;

slands-pt (W : Ob) (e : El Iv) (g : Hom W Iv) (i : SP.Lands W Iv (sptS e) g) : Id (Hom W Iv) g (constH W Iv e) =
  transH (symH (comp-idl W Iv g))
    (PosetSub.lands-pt W e (compH W Iv Iv (idH Iv) g) (isIn-sound W Iv (compH W Iv Iv (idH Iv) g) (PosetSub.ptS e) i)) ;

spt-lands (W : Ob) (e : El Iv) : SP.Lands W Iv (sptS e) (constH W Iv e) =
  isIn-complete W Iv (compH W Iv Iv (idH Iv) (constH W Iv e)) (PosetSub.ptS e)
    (plands-eq W Iv (PosetSub.ptS e) (constH W Iv e) (compH W Iv Iv (idH Iv) (constH W Iv e))
       (symH (comp-idl W Iv (constH W Iv e))) (PosetSub.pt-lands W e)) ;

spt-disj (W : Ob) (g : Hom W Iv) (i : SP.Lands W Iv (sptS e0) g) (i' : SP.Lands W Iv (sptS e1) g) : Empty =
  PosetSub.pt-disj W (compH W Iv Iv (idH Iv) g)
    (isIn-sound W Iv (compH W Iv Iv (idH Iv) g) (PosetSub.ptS e0) i)
    (isIn-sound W Iv (compH W Iv Iv (idH Iv) g) (PosetSub.ptS e1) i') ;

------------------------------------------------------------------------
-- forall along the interval, at the generic point of W * [1]

PhiLP (X : Ob) : U a =
  (L : (W : Ob) -> Hom W X -> Hom W Iv -> SP.Phi W)
  * ((V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
     -> Id (SP.Phi V) (SP.pre V W g (L W f j)) (L V (compH V W X f g) (compH V W Iv j g))) ;

HoldsLP (X : Ob) (L : PhiLP X) (W : Ob) (f : Hom W X) : U a =
  (V : Ob) (g : Hom V W) (j : Hom V Iv) -> SP.Lands V V (L.1 V (compH V W X f g) j) (idH V) ;

slands-sub (W X : Ob) (Q Q' : SP.Phi X) (e : Id (SP.Phi X) Q Q') (f : Hom W X) (i : SP.Lands W X Q f) : SP.Lands W X Q' f =
  subst (SP.Phi X) (\ q -> SP.Lands W X q f) Q Q' e i ;

slands-hom (W X : Ob) (Q : SP.Phi X) (f f' : Hom W X) (p : Id (Hom W X) f f') (i : SP.Lands W X Q f) : SP.Lands W X Q f' =
  subst (Hom W X) (\ k -> SP.Lands W X Q k) f f' p i ;

gen (X : Ob) (L : PhiLP X) (W : Ob) (f : Hom W X) : SP.Phi (prodP W Iv) =
  L.1 (prodP W Iv) (compH (prodP W Iv) W X f (pr1 W Iv)) (pr2 W Iv) ;

test (X : Ob) (L : PhiLP X) (W : Ob) (f : Hom W X) : Bool = (gen X L W f).1 (prodP W Iv) (idH (prodP W Iv)) ;

-- the generic sieve along (g , j) is L at (f g , j)
genAt (X : Ob) (L : PhiLP X) (W : Ob) (f : Hom W X) (V : Ob) (g : Hom V W) (j : Hom V Iv)
  : Id (SP.Phi V) (SP.pre V (prodP W Iv) (pairH W Iv V g j) (gen X L W f)) (L.1 V (compH V W X f g) j) =
  transH (L.2 V (prodP W Iv) (pairH W Iv V g j) (compH (prodP W Iv) W X f (pr1 W Iv)) (pr2 W Iv))
    (transH (apH (\ k -> L.1 V k (compH V (prodP W Iv) Iv (pr2 W Iv) (pairH W Iv V g j)))
               (transH (comp-assoc V (prodP W Iv) W X f (pr1 W Iv) (pairH W Iv V g j)) (apH (compH V W X f) (pr1-pair W Iv V g j))))
            (apH (\ k -> L.1 V (compH V W X f g) k) (pr2-pair W Iv V g j))) ;

-- the test gives every instance
holds-of-test (W X : Ob) (L : PhiLP X) (f : Hom W X) (t : IsT (test X L W f)) : HoldsLP X L W f = \ V g j ->
  slands-sub V V (SP.pre V (prodP W Iv) (pairH W Iv V g j) (gen X L W f)) (L.1 V (compH V W X f g) j) (genAt X L W f V g j) (idH V)
    (SP.pre-lands V V (prodP W Iv) (pairH W Iv V g j) (gen X L W f) (idH V)
      (slands-hom V (prodP W Iv) (gen X L W f) (compH V (prodP W Iv) (prodP W Iv) (idH (prodP W Iv)) (pairH W Iv V g j))
         (compH V V (prodP W Iv) (pairH W Iv V g j) (idH V))
         (transH (comp-idl V (prodP W Iv) (pairH W Iv V g j)) (symH (comp-idr V (prodP W Iv) (pairH W Iv V g j))))
         (SP.lands-comp V (prodP W Iv) (prodP W Iv) (gen X L W f) (idH (prodP W Iv)) (pairH W Iv V g j) t))) ;

-- the instance at the generic point is the test
test-of-holds (W X : Ob) (L : PhiLP X) (f : Hom W X) (h : HoldsLP X L W f) : IsT (test X L W f) =
  h (prodP W Iv) (pr1 W Iv) (pr2 W Iv) ;

test-pre (X : Ob) (L : PhiLP X) (W' W : Ob) (f : Hom W X) (g : Hom W' W) (t : IsT (test X L W f)) : IsT (test X L W' (compH W' W X f g)) =
  test-of-holds W' X L (compH W' W X f g) (\ V g' j ->
    slands-sub V V (L.1 V (compH V W X f (compH V W' W g g')) j) (L.1 V (compH V W' X (compH W' W X f g) g') j)
      (apH (\ k -> L.1 V k j) (symH (comp-assoc V W' W X f g g'))) (idH V)
      (holds-of-test W X L f t V (compH V W' W g g') j)) ;

forallS (X : Ob) (L : PhiLP X) : SP.Phi X = (test X L, \ W' W f g t -> test-pre X L W' W f g t) ;

lands-forall (W X : Ob) (L : PhiLP X) (f : Hom W X) (i : SP.Lands W X (forallS X L) f) : HoldsLP X L W f = holds-of-test W X L f i ;

forall-lands (W X : Ob) (L : PhiLP X) (f : Hom W X) (h : HoldsLP X L W f) : SP.Lands W X (forallS X L) f = test-of-holds W X L f h ;

------------------------------------------------------------------------
-- min and max on {0 , 1} (Conn.seg)

-- End points of a direction

sN : Bool -> Nat = split { true -> zero ; false -> suc zero } ;
tN : Bool -> Nat = split { true -> suc zero ; false -> zero } ;

sN-iv : (d : Bool) -> IsT (leb (sN d) (suc zero)) = split { true -> refl true ; false -> refl true } ;
tN-iv : (d : Bool) -> IsT (leb (tN d) (suc zero)) = split { true -> refl true ; false -> refl true } ;

srcP (d : Bool) : El Iv = (leaf (sN d), sN-iv d) ;
tgtP (d : Bool) : El Iv = (leaf (tN d), tN-iv d) ;

------------------------------------------------------------------------
-- min and max on {0 , 1}

cN : Bool -> Nat -> Nat -> Nat = split {
  true -> split { zero -> \ b -> zero ; suc x -> \ b -> b } ;
  false -> split { zero -> \ b -> b ; suc x -> \ b -> suc x } } ;

le1-zero : (x : Nat) -> IsT (leb (suc x) (suc zero)) -> Id Nat x zero = split {
  zero -> \ h -> refl zero ;
  suc x -> \ h -> absurd _ (false-true h) } ;

cN-iv : (d : Bool) (x y : Nat) -> IsT (leb x (suc zero)) -> IsT (leb y (suc zero)) -> IsT (leb (cN d x y) (suc zero)) = split {
  true -> split { zero -> \ y hx hy -> refl true ; suc x -> \ y hx hy -> hy } ;
  false -> split { zero -> \ y hx hy -> hy ; suc x -> \ y hx hy -> hx } } ;

-- the case  false , zero , suc b , suc a'  of cN-mono (b <= 1 forces b = 0)
cnm-f0 (x' : Nat) : (y : Nat) -> IsT (leb (suc y) (suc zero)) -> IsT (leb (suc y) (suc x')) = split {
  zero -> \ hb -> refl true ;
  suc y -> \ hb -> absurd _ (false-true hb) } ;

cN-mono : (d : Bool) (x y x' y' : Nat) -> IsT (leb y (suc zero))
  -> IsT (leb x x') -> IsT (leb y y') -> IsT (leb (cN d x y) (cN d x' y')) = split {
  true -> split {
    zero -> \ y x' y' hb ha hbb -> refl true ;
    suc x -> \ y -> split {
      zero -> \ y' hb ha hbb -> absurd _ (false-true ha) ;
      suc x' -> \ y' hb ha hbb -> hbb } } ;
  false -> split {
    zero -> \ y -> split {
      zero -> \ y' hb ha hbb -> hbb ;
      suc x' -> \ y' hb ha hbb -> cnm-f1 x' y hb } ;
    suc x -> \ y -> split {
      zero -> \ y' hb ha hbb -> absurd _ (false-true ha) ;
      suc x' -> \ y' hb ha hbb -> ha } } } ;

cnm-f1 (x' : Nat) : (y : Nat) -> IsT (leb y (suc zero)) -> IsT (leb y (suc x')) = split {
  zero -> \ hb -> refl true ;
  suc y -> \ hb -> cnm-f0 x' y hb } ;

-- at j = src d : constant
cN-src : (d : Bool) (x : Nat) -> IsT (leb x (suc zero)) -> Id Nat (cN d x (sN d)) (sN d) = split {
  true -> split { zero -> \ h -> refl zero ; suc x -> \ h -> refl zero } ;
  false -> split { zero -> \ h -> refl (suc zero) ; suc x -> \ h -> apH (\ n -> suc n) (le1-zero x h) } } ;

-- at j = tgt d : the identity
cN-tgt : (d : Bool) (x : Nat) -> IsT (leb x (suc zero)) -> Id Nat (cN d x (tN d)) x = split {
  true -> split { zero -> \ h -> refl zero ; suc x -> \ h -> apH (\ n -> suc n) (symH (le1-zero x h)) } ;
  false -> split { zero -> \ h -> refl zero ; suc x -> \ h -> refl (suc x) } } ;

-- on i = src d : constant
cN-on : (d : Bool) (y : Nat) -> Id Nat (cN d (sN d) y) (sN d) = split {
  true -> \ y -> refl zero ;
  false -> \ y -> refl (suc zero) } ;

------------------------------------------------------------------------
-- the connections, pointwise

ivN : Tree -> Nat = split { leaf n -> n ; node s t -> zero } ;

ivLeaf : (t : Tree) -> IsT (car Iv t) -> Id Tree t (leaf (ivN t)) = split {
  leaf n -> \ h -> refl (leaf n) ;
  node s t -> \ h -> absurd _ (false-true h) } ;

ivLe : (t : Tree) -> IsT (car Iv t) -> IsT (leb (ivN t) (suc zero)) = split {
  leaf n -> \ h -> h ;
  node s t -> \ h -> absurd _ (false-true h) } ;

leIvT : (t u : Tree) -> IsT (car Iv t) -> IsT (car Iv u) -> IsT (le Iv t u) -> IsT (leb (ivN t) (ivN u)) = split {
  leaf n -> split {
    leaf m -> \ ht hu h -> h ;
    node s t -> \ ht hu h -> absurd _ (false-true hu) } ;
  node s t -> \ u ht hu h -> absurd _ (false-true ht) } ;

nI (W : Ob) (i : Hom W Iv) (s : El W) : Nat = ivN (app W Iv i s).1 ;

cval (d : Bool) (W : Ob) (i j : Hom W Iv) (s : El W) : El Iv =
  (leaf (cN d (nI W i s) (nI W j s)),
   cN-iv d (nI W i s) (nI W j s) (ivLe (app W Iv i s).1 (app W Iv i s).2) (ivLe (app W Iv j s).1 (app W Iv j s).2)) ;

cIp (d : Bool) (W : Ob) (i j : Hom W Iv) : Hom W Iv =
  mkHom W Iv (cval d W i j) (\ s t h ->
    cN-mono d (nI W i s) (nI W j s) (nI W i t) (nI W j t) (ivLe (app W Iv j s).1 (app W Iv j s).2)
      (leIvT (app W Iv i s).1 (app W Iv i t).1 (app W Iv i s).2 (app W Iv i t).2 (mono W Iv i s t h))
      (leIvT (app W Iv j s).1 (app W Iv j t).1 (app W Iv j s).2 (app W Iv j t).2 (mono W Iv j s t h))) ;

cIp-nat (d : Bool) (V W : Ob) (g : Hom V W) (i j : Hom W Iv)
  : Id (Hom V Iv) (compH V W Iv (cIp d W i j) g) (cIp d V (compH V W Iv i g) (compH V W Iv j g)) =
  hom-eq V Iv (compH V W Iv (cIp d W i j) g) (cIp d V (compH V W Iv i g) (compH V W Iv j g))
    (\ s -> calc Tree {
        (app V Iv (compH V W Iv (cIp d W i j) g) s).1
      =< app-compH1 V W Iv (cIp d W i j) g s >
        leaf (cN d (nI W i (app V W g s)) (nI W j (app V W g s)))
      =< apH (\ t -> leaf (cN d (ivN t) (nI W j (app V W g s)))) (symH (app-compH1 V W Iv i g s)) >
        leaf (cN d (nI V (compH V W Iv i g) s) (nI W j (app V W g s)))
      =< apH (\ t -> leaf (cN d (nI V (compH V W Iv i g) s) (ivN t))) (symH (app-compH1 V W Iv j g s)) >
        (app V Iv (cIp d V (compH V W Iv i g) (compH V W Iv j g)) s).1 }) ;

-- the leaf of a map into [1] at s
lf (W : Ob) (i : Hom W Iv) (s : El W) : Id Tree (leaf (nI W i s)) (app W Iv i s).1 =
  symH (ivLeaf (app W Iv i s).1 (app W Iv i s).2) ;

cI-jsrc-t (W : Ob) (i : Hom W Iv) : Id (Hom W Iv) (cIp true W i (constH W Iv e0)) (constH W Iv e0) =
  hom-eq W Iv (cIp true W i (constH W Iv e0)) (constH W Iv e0)
    (\ s -> apH (\ n -> leaf n) (cN-src true (nI W i s) (ivLe (app W Iv i s).1 (app W Iv i s).2))) ;
cI-jsrc-f (W : Ob) (i : Hom W Iv) : Id (Hom W Iv) (cIp false W i (constH W Iv e1)) (constH W Iv e1) =
  hom-eq W Iv (cIp false W i (constH W Iv e1)) (constH W Iv e1)
    (\ s -> apH (\ n -> leaf n) (cN-src false (nI W i s) (ivLe (app W Iv i s).1 (app W Iv i s).2))) ;
cI-jtgt-t (W : Ob) (i : Hom W Iv) : Id (Hom W Iv) (cIp true W i (constH W Iv e1)) i =
  hom-eq W Iv (cIp true W i (constH W Iv e1)) i
    (\ s -> transH (apH (\ n -> leaf n) (cN-tgt true (nI W i s) (ivLe (app W Iv i s).1 (app W Iv i s).2))) (lf W i s)) ;
cI-jtgt-f (W : Ob) (i : Hom W Iv) : Id (Hom W Iv) (cIp false W i (constH W Iv e0)) i =
  hom-eq W Iv (cIp false W i (constH W Iv e0)) i
    (\ s -> transH (apH (\ n -> leaf n) (cN-tgt false (nI W i s) (ivLe (app W Iv i s).1 (app W Iv i s).2))) (lf W i s)) ;
cI-isrc-t (W : Ob) (j : Hom W Iv) : Id (Hom W Iv) (cIp true W (constH W Iv e0) j) (constH W Iv e0) =
  hom-eq W Iv (cIp true W (constH W Iv e0) j) (constH W Iv e0) (\ s -> apH (\ n -> leaf n) (cN-on true (nI W j s))) ;
cI-isrc-f (W : Ob) (j : Hom W Iv) : Id (Hom W Iv) (cIp false W (constH W Iv e1) j) (constH W Iv e1) =
  hom-eq W Iv (cIp false W (constH W Iv e1) j) (constH W Iv e1) (\ s -> apH (\ n -> leaf n) (cN-on false (nI W j s))) ;
cI-itgt-t (W : Ob) (j : Hom W Iv) : Id (Hom W Iv) (cIp true W (constH W Iv e1) j) j =
  hom-eq W Iv (cIp true W (constH W Iv e1) j) j (\ s -> lf W j s) ;
cI-itgt-f (W : Ob) (j : Hom W Iv) : Id (Hom W Iv) (cIp false W (constH W Iv e0) j) j =
  hom-eq W Iv (cIp false W (constH W Iv e0) j) j (\ s -> lf W j s) ;
