-- CTrFib.seg (L3, inside CB, level l): transport is a move (model.tex
-- lem:tr-move).  A path P : A = A' of types over D gives a cart A' -> A
-- over the identity (fibre maps: transport along P); a fibration c of A
-- transported along P is c moved along this cart.  Proof: J on P and the
-- identity law.  tr-pw: the fibre maps are transport along any path of
-- the fibres in V (V is a set).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module TR (D : PCtx) (A : PTy[D]) {
  module TA = GPR.TyL[D, A] ;

  -- the fibre maps, back and forth
  trV (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (W : Ob) (x : W0.Ix (D.ob W)) : W0.Ix (A2.tob W x) -> W0.Ix (A.tob W x) =
    idJ (PTy[D]) A (\ A3 P3 -> W0.Ix (A3.tob W x) -> W0.Ix (A.tob W x)) (\ u -> u) A2 P2 ;

  fwV (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (W : Ob) (x : W0.Ix (D.ob W)) : W0.Ix (A.tob W x) -> W0.Ix (A2.tob W x) =
    idJ (PTy[D]) A (\ A3 P3 -> W0.Ix (A.tob W x) -> W0.Ix (A3.tob W x)) (\ u -> u) A2 P2 ;

  ta (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (W : Ob) (v : GPR.TyL[D, A2].EI W) : TA.EI W = (v.1, trV A2 P2 W v.1 v.2) ;

  tanat (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) : (V W : Ob) (g : Hom V W) (v : GPR.TyL[D, A2].EI W)
      -> Id (TA.EI V) (TA.E.act V W g (ta A2 P2 W v)) (ta A2 P2 V (GPR.TyL[D, A2].E.act V W g v)) =
    idJ (PTy[D]) A
      (\ A3 P3 -> (V W : Ob) (g : Hom V W) (v : GPR.TyL[D, A3].EI W)
         -> Id (TA.EI V) (TA.E.act V W g (ta A3 P3 W v)) (ta A3 P3 V (GPR.TyL[D, A3].E.act V W g v)))
      (\ V W g v -> refl (TA.E.act V W g v)) A2 P2 ;

  tainj (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) : (W : Ob) (v v' : GPR.TyL[D, A2].EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1)
      (Q : Id (TA.EI W) (ta A2 P2 W v) (ta A2 P2 W v')) -> Id (GPR.TyL[D, A2].EI W) v v' =
    idJ (PTy[D]) A
      (\ A3 P3 -> (W : Ob) (v v' : GPR.TyL[D, A3].EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1)
         (Q : Id (TA.EI W) (ta A3 P3 W v) (ta A3 P3 W v')) -> Id (GPR.TyL[D, A3].EI W) v v')
      (\ W v v' P Q -> Q) A2 P2 ;

  bkta (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) : (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X x))
      -> Id (TA.EI X) (ta A2 P2 X (x, fwV A2 P2 X x u)) (x, u) =
    idJ (PTy[D]) A
      (\ A3 P3 -> (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (A.tob X x)) -> Id (TA.EI X) (ta A3 P3 X (x, fwV A3 P3 X x u)) (x, u))
      (\ X x u -> refl (x, u)) A2 P2 ;

  module C (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) {
    module K = CCart[l, l].Cart[D, A2, D, A, \ W x -> x, \ V W g x -> refl (D.act V W g x),
      ta A2 P2, \ W v -> refl v.1, tanat A2 P2, tainj A2 P2, fwV A2 P2, bkta A2 P2] ;
  } ;

  -- transport is the move
  law (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) : (c : CLine[l].Lines[D, A].Fib)
      -> Id ((T : PTy[D]) * CLine[l].Lines[D, T].Fib) (A, c) (A2, C[A2, P2].K.moveFib c) =
    idJ (PTy[D]) A
      (\ A3 P3 -> (c : CLine[l].Lines[D, A].Fib) -> Id ((T : PTy[D]) * CLine[l].Lines[D, T].Fib) (A, c) (A3, C[A3, P3].K.moveFib c))
      (\ c -> apH {CLine[l].Lines[D, A].Fib} {(T : PTy[D]) * CLine[l].Lines[D, T].Fib} (\ z -> (A, z))
         (CCartLaws[l].CI[D, A, tanat A (refl A)].idFib c))
      A2 P2 ;

  -- the fibre map is transport along any path of the fibres
  tr-pw (A2 : PTy[D]) (P2 : Id (PTy[D]) A A2) (W : Ob) (x : W0.Ix (D.ob W)) (Po : Id W0.V (A2.tob W x) (A.tob W x)) (u : W0.Ix (A2.tob W x))
    : Id (W0.Ix (A.tob W x)) (trV A2 P2 W x u) (subst W0.V (\ z -> W0.Ix z) (A2.tob W x) (A.tob W x) Po u) =
    idJ (PTy[D]) A
      (\ A3 P3 -> (Po3 : Id W0.V (A3.tob W x) (A.tob W x)) (u3 : W0.Ix (A3.tob W x))
         -> Id (W0.Ix (A.tob W x)) (trV A3 P3 W x u3) (subst W0.V (\ z -> W0.Ix z) (A3.tob W x) (A.tob W x) Po3 u3))
      (\ Po3 u3 -> apH (\ q -> subst W0.V (\ z -> W0.Ix z) (A.tob W x) (A.tob W x) q u3)
                     (W0.isSetV (A.tob W x) (A.tob W x) (refl (A.tob W x)) Po3))
      A2 P2 Po u ;

  opaque tanat ; opaque tainj ; opaque bkta ; opaque law ; opaque tr-pw ;
} ;
