-- CExtFullFib.seg (L5, inside CB, level l): Theorem 7 at full points for
-- the composition (model.tex lem:full-move (iii)).  On the full points,
-- B maps into Ext(alpha) by the cart fromB; Ext's fibration moved along it
-- is B's.  Proof: Move's uniqueness; on a full line the composite is the
-- top of the B-filler of the problem read in B (CExtFull.C5.Full), the
-- problem read in B is the original one, and the top of the filler is the
-- composite (CFillEnd).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module FF (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (cA : CLine[l].Lines[G, A].Fib) (cB : CLine[l].Lines[GP.CofL[G, psi].resCtx, B].Fib)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  module T7 = CThm7[l].Thm7[G, A, psi, B, al, cA, cB, eal] ;
  module FC = CExtFullCart[l].FC[G, A, psi, B, al, T7.fA1, eal] ;

  -- the cart B -> Ext on the full points
  module Ca = CCart[l, l].Cart[G', B, G, ExtT, FC.cs, FC.cs-nat, FC.ctB, FC.ctBpt, FC.ctBnat, FC.ctBinj, FC.bkB, FC.cbkBta] ;

  module Dir (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp) (cb : CLine[l].Lines[G', B].CompK[src d, tgt d].Comp) {
    module FB = CFill[l].FillC[G', B, d, cb] ;
    module FE = CFillEnd[l].FE[G', B, d, cb] ;
    module C1 = CExtComp1[l].C1[G, A, psi, B, al, src d, FB.fill] ;
    module C4 = CExtComp4[l].C4[G, A, psi, B, al, src d, tgt d, CFill[l].FillC[G, A, d, ca].fill, FB.fill, T7.fA1, eal] ;
    module C5 = CExtFull[l].C5[G, A, psi, B, al, src d, tgt d, CFill[l].FillC[G, A, d, ca].fill, FB.fill, T7.fA1, eal] ;
    module M = Ca.MoveComp[src d, tgt d] ;
    module KB = C1.KB ;
    module KX = C1.KX ;

    module Pt (X : Ob) (x : KB.TV.EI X) (sd : KB.PT.Side[X, x]) {
      xX : KX.TV.EI X = M.E.sV X x ;
      ms : KX.PT.Side[X, xX] = M.mside C4.extComp X x sd ;
      fl : C1.FlTy X xX = \ W f j -> (x.1.1 W f j).2 ;
      module Be = C1.Beta[X, xX, ms, fl] ;

      -- the problem read in B is the original one
      xBeq : Id (KB.TV.EI X) Be.xB x =
        KB.tv-eq X Be.xB x
          (C1.FG'.fam-eq X Be.gB x.1 (\ W f j -> res-eq W (Be.gB.1 W f j) (x.1.1 W f j) (refl (x.1.1 W f j).1)))
          (transH (toB-cong X (KX.endE X xX) (fromB X (KB.endE X x)) (M.E.sVE X x) (fl X (idH X) (ptH X (src d))) (KB.endE X x).1.2)
                  (toB-fromB X (KB.endE X x))) ;

      ev (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f) (i' : Lands W X sd.pQ f)
        : Id (KB.TS.EI W) (Be.SB[ms].v W f i) (sd.pv W f i') =
        KB.ts-ext W (Be.SB[ms].v W f i) (sd.pv W f i')
          (transH (Be.SB[ms].ppt W f i) (transH (apH (KB.TV.E.act W X f) xBeq) (symH (sd.ppt W f i'))))
          (\ V g j -> transH (Be.SV[W, f, ms.pv W f i, ms.ppt W f i].sv-lev V g j)
             (transH (toB-cong V (C1.lvX W (ms.pv W f i) V g j) (fromB V ((KB.lineL W (sd.pv W f i)).2.1.1 V g j))
                        (apH (\ L -> L.2.1.1 V g j) (M.E.mS-line W (sd.pv W f i)))
                        (Be.SV[W, f, ms.pv W f i, ms.ppt W f i].qv V g j) ((KB.lineL W (sd.pv W f i)).2.1.1 V g j).1.2)
               (transH (toB-fromB V ((KB.lineL W (sd.pv W f i)).2.1.1 V g j))
                       (apH (\ u -> (KB.lineL W u).2.1.1 V g j) (KB.PT.pv-irr X x sd W f i i'))))) ;

      pBeq : Id (KB.PT.Side[X, x]) (subst (KB.TV.EI X) (\ z -> KB.PT.Side[X, z]) Be.xB x xBeq Be.pB) sd =
        KB.PT.side-extH X Be.xB x xBeq Be.pB sd (refl sd.pQ) ev ;

      -- the top of the B-filler is cb's composite
      endB : Id (PR.TyL[G', B].EI X) (Be.FBv X (idH X) (ptH X (tgt d))) (FB.rd X (x, cb.kop X x sd)) =
        transH (FE.endT X Be.xB Be.pB) (apH (FB.rd X) (FB.RC.kop-cong cb X Be.xB x xBeq Be.pB sd pBeq)) ;

      H : Id (M.TT.EI X) (M.mT X (x, cb.kop X x sd)) (xX, C4.extComp.kop X xX ms) =
        M.CK.SE.mV-inj X (M.mT X (x, cb.kop X x sd)) (xX, C4.extComp.kop X xX ms) (refl xX)
          (M.E'.EK.tv-eq X (M.CK.SE.mV X (M.mT X (x, cb.kop X x sd))) (M.CK.SE.mV X (xX, C4.extComp.kop X xX ms)) (refl xX.1)
             (calc (PR.TyL[G, ExtT].EI X) {
                 M.E'.EK.endE X (M.CK.SE.mV X (M.mT X (x, cb.kop X x sd)))
               =< M.E'.sVE X (M.CK'.SE.mV X (x, cb.kop X x sd)) >
                 fromB X (FB.rd X (x, cb.kop X x sd))
               =< apH (fromB X) (symH endB) >
                 fromB X (Be.FBv X (idH X) (ptH X (tgt d)))
               =< symH C5.Full[X, xX, ms, fl].full >
                 M.E'.EK.endE X (M.CK.SE.mV X (xX, C4.extComp.kop X xX ms)) })) ;

      opaque xBeq ; opaque pBeq ; opaque endB ; opaque H ;
    } ;

    law : Id (M.CK'.Comp) (M.move C4.extComp) cb = symH (M.unique C4.extComp cb (\ X x sd -> Pt[X, x, sd].H)) ;
  } ;

  -- (iii): Ext's fibration moved along B -> Ext is B's
  law : Id (CLine[l].Lines[G', B].Fib) (Ca.moveFib T7.extFib) cB =
    transH (apH {CLine[l].Lines[G', B].CompK[e0, e1].Comp} {CLine[l].Lines[G', B].Fib} (\ z -> (z, Ca.MoveComp[e1, e0].move T7.extFib.2))
              Dir[true, cA.1, cB.1].law)
           (apH {CLine[l].Lines[G', B].CompK[e1, e0].Comp} {CLine[l].Lines[G', B].Fib} (\ z -> (cB.1, z)) Dir[false, cA.2, cB.2].law) ;
} ;
