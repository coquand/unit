-- CExtSmall.seg (L5, inside CB): the small copy SA of Ext_U (model.tex
-- §6.2, Construction "the small copy").  SA is the small type over GD
-- whose fibre at w is the fibre at the identity of Ext of w's own data
-- over y I (CExtCmp.obD); its action is Ext_U's through the comparison
-- (ph , ps).  (d , z) |-> (d , ph z) is a cart from up SA to Ext_U, so
-- Ext_U's fibration, map to A_U and equivalence move onto SA (CCart,
-- CHFibCart); along any l : D -> GD, xsub SA l is fibrant (CSmall).
--
-- Quarry: seg/model GExtSmall, GSmallFibI.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module XS (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib) {
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module CM = CExtCmp.CM[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module FU = CExtFibU.FU[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  module E4 = CExt4[a+].ExtB4[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU] ;
  module TX = LP.TyL[UB.GDr, UB.ExtBig] ;
  module TAU = LP.TyL[UB.GDr, UB.AU] ;

  S0 (I : Ob) (w : V1.Ix (UB.GDr.ob I)) : W0.V = CM.At[I, w].obD ;

  phS (I : Ob) (w : V1.Ix (UB.GDr.ob I)) (z : W0.Ix (S0 I w)) : V1.Ix (UB.ExtBig.tob I w) = CM.At[I, w].ph z ;

  psS (I : Ob) (w : V1.Ix (UB.GDr.ob I)) (y : V1.Ix (UB.ExtBig.tob I w)) : W0.Ix (S0 I w) = CM.At[I, w].ps y ;

  -- the small copy of Ext_U
  tactS (J I : Ob) (f : Hom J I) (x : V1.Ix (UB.GDr.ob I)) (y : V1.Ix (UB.GDr.ob J)) (e : Id (V1.Ix (UB.GDr.ob J)) (UB.GDr.act J I f x) y)
    (z : W0.Ix (S0 I x)) : W0.Ix (S0 J y) = psS J y (UB.ExtBig.tact J I f x y e (phS I x z)) ;

  SA : CSmall.SPTy[UB.GDr] =
    new CSmall.SPTy[UB.GDr, S0, tactS,
      \ I x e z -> transH (apH (psS I x) (UB.ExtBig.tact-id I x e (phS I x z))) (CM.At[I, x].ps-ph z),
      \ K J I f g x y z e1' e2 e3 a0 -> apH (psS K z)
          (transH (UB.ExtBig.tact-o K J I f g x y z e1' e2 e3 (phS I x a0))
                  (apH (UB.ExtBig.tact K J g y z e2) (symH (CM.At[J, y].ph-ps (UB.ExtBig.tact J I f x y e1' (phS I x a0))))))] ;

  upSA : L.PTy[UB.GDr] = CSmall.up UB.GDr SA ;
  module TS = LP.TyL[UB.GDr, upSA] ;

  ----------------------------------------------------------------------
  -- the cart from up SA to Ext_U

  ta (W : Ob) (v : TS.EI W) : TX.EI W = (v.1, phS W v.1 v.2) ;

  tanat (V W : Ob) (g : Hom V W) (v : TS.EI W) : Id (TX.EI V) (TX.E.act V W g (ta W v)) (ta V (TS.E.act V W g v)) =
    apH {V1.Ix (UB.ExtBig.tob V (UB.GDr.act V W g v.1))} {TX.EI V} (\ z -> (UB.GDr.act V W g v.1, z))
      (symH (CM.At[V, UB.GDr.act V W g v.1].ph-ps (UB.ExtBig.tact V W g v.1 (UB.GDr.act V W g v.1) (refl (UB.GDr.act V W g v.1)) (phS W v.1 v.2)))) ;

  tainj (W : Ob) (v v' : TS.EI W) (P : Id (V1.Ix (UB.GDr.ob W)) v.1 v'.1) (Q : Id (TX.EI W) (ta W v) (ta W v')) : Id (TS.EI W) v v' =
    idJ (V1.Ix (UB.GDr.ob W)) v.1
      (\ x2 P2 -> (b2 : W0.Ix (S0 W x2)) -> Id (TX.EI W) (ta W v) (ta W (x2, b2)) -> Id (TS.EI W) v (x2, b2))
      (\ b2 Q2 -> apH {W0.Ix (S0 W v.1)} {TS.EI W} (\ z -> (v.1, z))
         (transH (symH (CM.At[W, v.1].ps-ph v.2))
           (transH (apH (psS W v.1) (TX.pr-inj W v.1 (phS W v.1 v.2) (phS W v.1 b2) Q2)) (CM.At[W, v.1].ps-ph b2))))
      v'.1 P v'.2 Q ;

  bk (X : Ob) (x : V1.Ix (UB.GDr.ob X)) (u : V1.Ix (UB.ExtBig.tob X x)) : W0.Ix (S0 X x) = psS X x u ;

  bkta (X : Ob) (x : V1.Ix (UB.GDr.ob X)) (u : V1.Ix (UB.ExtBig.tob X x)) : Id (TX.EI X) (ta X (x, bk X x u)) (x, u) =
    apH {V1.Ix (UB.ExtBig.tob X x)} {TX.EI X} (\ z -> (x, z)) (CM.At[X, x].ph-ps u) ;

  opaque tanat ; opaque tainj ; opaque bkta ;

  module C = CCart[a+, a+].Cart[UB.GDr, upSA, UB.GDr, UB.ExtBig, \ W x -> x, \ V W g x -> refl (UB.GDr.act V W g x),
    ta, \ W v -> refl v.1, tanat, tainj, bk, bkta] ;

  -- the fibration of SA
  fibSA : CLine[a+].Lines[UB.GDr, upSA].Fib = C.moveFib FU.extFibU ;

  -- the map to A_U, and its equivalence structure
  extSA : CPartial[a+].PMap[UB.GDr, upSA, UB.AU] =
    new CPartial[a+].PMap[UB.GDr, upSA, UB.AU, \ W v -> E4.extMap.mE W (ta W v), \ W v -> E4.extMap.mpt W (ta W v),
      \ Y X h v -> transH (apH (E4.extMap.mE Y) (symH (tanat Y X h v))) (E4.extMap.mnat Y X h (ta X v))] ;

  module H = CHFibCart[a+, a+].HCart[UB.GDr, upSA, UB.AU, extSA, UB.GDr, UB.ExtBig, UB.AU, E4.extMap,
    \ W x -> x, \ V W g x -> refl (UB.GDr.act V W g x),
    \ W v -> v, \ W v -> refl v.1, \ V W g v -> refl (TAU.E.act V W g v), \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u),
    ta, \ W v -> refl v.1, tanat, tainj, bk, bkta,
    \ W v -> refl (E4.extMap.mE W (ta W v))] ;

  eqSA : CEquiv[a+].EquivOp UB.GDr upSA UB.AU extSA = H.moveEq FU.extEquivU ;

  -- Ext over any glue data l : D -> GD, with its fibration
  fibExt (D : PCtx) (l : CSmall.XSub[D, UB.GDr]) : CLine[a].Lines[D, CSmall.xsub D UB.GDr SA l].Fib =
    CSmall.SmallFib[UB.GDr, SA, D, l].fib fibSA ;
} ;
