-- CDeltaRetr.seg (L8, Delta): seg/model DeltaRetr.seg on core (one-sieve horn, CHornRetr).  Was: box filling gives horn filling on Delta, constructively:
-- CompAt (e0 -> e1 and e1 -> e0, line form at the family path object)
-- gives the horn filling operation DeltaHorn.DH.isFib.
--
-- The generic argument is IvBase.GHornRetr.RF (a retraction line); here
-- its Delta instance.  The retractions are BoxHorn's (Gabriel-Zisman):
--
--   k = 0      e = e0, e' = e1:  r (j , 0) = 0 ,  r (j , 1) = j
--   k = k'+1   e = e1, e' = e0:  r (j , 0) = j ,  r (j , 1) = max j k
--
-- as maps [m+1] * [1] -> [m+1] of posets (BoxHorn.Retr), read on a
-- generalised point (f , i) : [W] -> [m+1] * [1] by composing with the pair
-- (BoxHorn.DRet.rD, one home with the poset instance): a natural family,
-- no product object in Delta.  R1 (r at e' is the
-- identity) is pointwise; R2 (r at e misses the face y0 = m+1, resp. 0) and
-- R3 (r maps the complement of a face y /= k into itself, BoxHorn.PT /
-- PF) give the horn conditions through DeltaHorn.lands-horn / horn-lands.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DHn = CDHornFib[a, lz] ;
module DS = DBm.DS ;
module DHm = CDeltaCl[a] ;
module BHm = CBoxHorn[a] ;

------------------------------------------------------------------------
-- the retractions of BoxHorn (DRet, read on (f , i) at W = [V]) and the
-- horn conditions

-- R3 on Delta: a map in the horn at k goes to the horn
module DHorn (m : Nat) (rN : Nat -> Nat -> Nat)
  (rD : (W : Ob) -> Hom W (lin (suc m)) -> Hom W Iv -> Hom W (lin (suc m)))
  (rmiss : (y : Nat) -> (P : (j e : Nat) -> IsT (leb e (suc zero)) -> IsT (not (eqN j y)) -> IsT (not (eqN (rN j e) y)))
           -> (W : Ob) (f : Hom W (lin (suc m))) (i : Hom W Iv) -> Miss W m y f -> Miss W m y (rD W f i))
  (k : Nat)
  (P : (y : Nat) -> IsT (not (eqN y k)) -> (j e : Nat) -> IsT (leb e (suc zero)) -> IsT (not (eqN j y)) -> IsT (not (eqN (rN j e) y))) {
  rD-horn (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : Hom (lin W) Iv) (h : DS.Lands W (suc m) (DHm.hornS m k) f)
    : DS.Lands W (suc m) (DHm.hornS m k) (rD (lin W) f i) =
    DHm.lands-horn W m k (DHm.horn-lands W m k f h).1 (DHm.horn-lands W m k f h).2.1 (DHm.horn-lands W m k f h).2.2.1 (rD (lin W) f i)
      (rmiss (DHm.horn-lands W m k f h).1 (P (DHm.horn-lands W m k f h).1 (DHm.horn-lands W m k f h).2.2.1) (lin W) f i
         (DHm.horn-lands W m k f h).2.2.2) ;
} ;

-- k = 0: r at e0 is the constant 0, which misses m+1
module DT (m : Nat) {
  module RD = BHm.DT[m].RD ;
  module HH = DHorn[m, \ j e -> BHm.rTN j e, RD.rD, RD.rD-miss, zero, BHm.PT] ;

  r2 (W : Nat) (f : Hom (lin W) (lin (suc m))) : DS.Lands W (suc m) (DHm.hornS m zero) (RD.rD (lin W) f (constH (lin W) Iv e0)) =
    DHm.lands-horn W m zero (suc m) (leb-refl m) (refl true) (RD.rD (lin W) f (constH (lin W) Iv e0)) (\ s ->
      substH (\ t -> IsT (not (eqN (vnum t) (suc m)))) (symH (RD.rD-app (lin W) f (constH (lin W) Iv e0) s)) (refl true)) ;
} ;

-- k = k'+1: r at e1 is max j (k+1), which misses 0
module DF (m k : Nat) (hk : IsT (leb (suc k) (suc m))) {
  module RD = BHm.DF[m, k, hk].RD ;
  module HH = DHorn[m, \ j e -> BHm.rFN (suc k) j e, RD.rD, RD.rD-miss, suc k, BHm.PF k] ;

  r2 (W : Nat) (f : Hom (lin W) (lin (suc m))) : DS.Lands W (suc m) (DHm.hornS m (suc k)) (RD.rD (lin W) f (constH (lin W) Iv e1)) =
    DHm.lands-horn W m (suc k) zero (refl true) (refl true) (RD.rD (lin W) f (constH (lin W) Iv e1)) (\ s ->
      substH (\ t -> IsT (not (eqN (vnum t) zero))) (symH (RD.rD-app (lin W) f (constH (lin W) Iv e1) s))
        (BHm.max-pos (vnum (app (lin W) (lin (suc m)) f s).1) k)) ;
} ;

------------------------------------------------------------------------
-- composition gives the horn filling operation

module BoxToHorn (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G])
  (c01 : DB.CLine[lz].Lines[G, A].CompK[DB.e0, DB.e1].Comp)
  (c10 : DB.CLine[lz].Lines[G, A].CompK[DB.e1, DB.e0].Comp) {
  open DHn.DH[G, A] ;

  module K0 (m : Nat) (rho : W0.Ix (G.ob (suc m))) (h : HornData m zero rho) {
    module F = DB.CHornRetr[lz].RF[G, A, DB.e0, DB.e1, c01, suc m, rho, hornSide m zero rho h,
      \ W -> DT[m].RD.rD (lin W), \ V W -> DT[m].RD.rDn (lin V) (lin W),
      \ W -> DT[m].RD.rD-end e1 (\ j -> refl j) (lin W),
      DT[m].r2, DT[m].HH.rD-horn] ;

    ext : Ext m zero rho h = (F.fill, \ W f i -> F.fill-side W f i) ;
  } ;

  module K1 (m k : Nat) (hk : IsT (leb (suc k) (suc m))) (rho : W0.Ix (G.ob (suc m))) (h : HornData m (suc k) rho) {
    module F = DB.CHornRetr[lz].RF[G, A, DB.e1, DB.e0, c10, suc m, rho, hornSide m (suc k) rho h,
      \ W -> DF[m, k, hk].RD.rD (lin W), \ V W -> DF[m, k, hk].RD.rDn (lin V) (lin W),
      \ W -> DF[m, k, hk].RD.rD-end e0 (\ j -> refl j) (lin W),
      DF[m, k, hk].r2, DF[m, k, hk].HH.rD-horn] ;

    ext : Ext m (suc k) rho h = (F.fill, \ W f i -> F.fill-side W f i) ;
  } ;

  extK (m : Nat) : (k : Nat) -> IsT (leb k (suc m)) -> (rho : W0.Ix (G.ob (suc m))) -> (h : HornData m k rho) -> Ext m k rho h = split {
    zero -> \ hk rho h -> K0[m, rho, h].ext ;
    suc k -> \ hk rho h -> K1[m, k, hk, rho, h].ext } ;

  isFib-of-comp : isFib = \ m k hk rho h -> extK m k hk rho h ;
} ;

-- a fibration structure gives a horn filling operation (constructive)
fibToHorn (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (c : DB.CLine[lz].Lines[G, A].Fib) : DHn.DH[G, A].isFib =
  BoxToHorn[G, A, c.1, c.2].isFib-of-comp ;
