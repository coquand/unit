-- The small and large raw Pi codes have the same index type. Their
-- members agree by lifting the graph, pair and identity encodings.
-- Adapted from sag-model/FibPiCode.seg for the simplex base.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module W0 = V[a] ;
module W1 = V[a+] ;
module VL0 = VLift[a, a] ;
module VL = VLift[a, a+] ;
module L = CDPiLift[a] ;
module P0 = CDPiParts[a, a] ;
module P1 = CDPiParts[a, a+] ;
module S = CDeltaBase[a].DB.CSmall ;
module PB = CDeltaBase[a].DB ;
open PB ;
open SmallCat[a].Objs[PB.obV] ;
open SmallCat[a].Homs[PB.obV, PB.homV] ;

lift-self : (m : W0.M) -> Id W0.M (VL0.liftM m) m =
  split { sup X f | paths ->
    apH (\ k -> sup X k) (funext X (\ _ -> W0.M) (\ x -> VL0.liftM (f x)) f paths) } ;
opaque lift-self ;

transparent PresheafPi.PPi.RawPi.rawF ;

module Raw (I : Ob) (Af : P0.PP.RawPi[I].AfT) (Bf : P0.PP.RawPi[I].BfT Af)
  (Aact : P0.PP.RawPi[I].AactT Af) (Bact : P0.PP.RawPi[I].BactT Af Bf Aact) {
  module R0 = P0.PP.RawPi[I] ;
  module R1 = P1.PP.RawPi[I] ;
  Af' : R1.AfT = \ J f -> S.smallC (Af J f) ;
  Bf' : R1.BfT Af' = \ J f u -> S.smallC (Bf J f u) ;
  module D0 = P0.Parts[I, Af, Bf, Aact, Bact] ;
  module D1 = P1.Parts[I, Af', Bf', Aact, Bact] ;

  arg-read (J : Ob) (f : Hom J I) (u : W0.Ix (Af J f))
    : Id W1.M (VL.liftM (W0.ev (Af J f) u).1) (W1.ev (Af' J f) u).1 =
    symH (L.read-small (Af J f) u) ;

  -- The base indices of the graphs are the same in the two encodings.
  enc (v : W0.V) (u : W0.Ix v) : Id W1.M (VL.liftM (VL0.encIx v u).1) (VL.encIx v u).1 =
    apH VL.liftM (lift-self (W0.ev v u).1) ;

  fun-arg (J : Ob) (f : Hom J I) (phi : W0.Ix (D0.FunArg J f))
    : Id W1.M (VL.liftM (W0.ev (D0.FunArg J f) phi).1) (W1.ev (D1.FunArg J f) phi).1 =
    L.graph-value (W0.Ix (Af J f)) (W0.ev (Af J f)) (\ u -> W0.ev (Bf J f u) (phi u))
      (W1.ev (Af' J f)) (\ u -> W1.ev (Bf' J f u) (phi u))
      (arg-read J f) (\ u -> symH (L.read-small (Bf J f u) (phi u))) ;

  fun-hom (J : Ob) (phi : W0.Ix (D0.FunHom J))
    : Id W1.M (VL.liftM (W0.ev (D0.FunHom J) phi).1) (W1.ev (D1.FunHom J) phi).1 =
    L.graph-value (Hom J I) (VL0.encIx (homV J I)) (\ f -> W0.ev (D0.FunArg J f) (phi f))
      (VL.encIx (homV J I)) (\ f -> W1.ev (D1.FunArg J f) (phi f))
      (enc (homV J I)) (\ f -> fun-arg J f (phi f)) ;

  fun-read (phi : W0.Ix D0.Fun) : Id W1.M (VL.liftM (W0.ev D0.Fun phi).1) (W1.ev D1.Fun phi).1 =
    L.graph-value Ob (VL0.encIx obV) (\ J -> W0.ev (D0.FunHom J) (phi J))
      (VL.encIx obV) (\ J -> W1.ev (D1.FunHom J) (phi J))
      (enc obV) (\ J -> fun-hom J (phi J)) ;
  opaque fun-read ;

  module Nat (phi : W0.Ix D0.Fun) {
    module N0 = D0.Nat[phi] ;
    module N1 = D1.Nat[phi] ;

    arg (J K : Ob) (f : Hom J I) (g : Hom K J) (r : W0.Ix (N0.Arg J K f g))
      : Id W1.M (VL.liftM (W0.ev (N0.Arg J K f g) r).1) (W1.ev (N1.Arg J K f g) r).1 =
      L.graph-value (W0.Ix (Af J f)) (W0.ev (Af J f)) (\ u -> W0.ev (N0.IdCode J K f g u) (r u))
        (W1.ev (Af' J f)) (\ u -> W1.ev (N1.IdCode J K f g u) (r u))
        (arg-read J f) (\ u -> L.empty-lift) ;

    homK (J K : Ob) (f : Hom J I) (r : W0.Ix (N0.HomK J K f))
      : Id W1.M (VL.liftM (W0.ev (N0.HomK J K f) r).1) (W1.ev (N1.HomK J K f) r).1 =
      L.graph-value (Hom K J) (VL0.encIx (homV K J)) (\ g -> W0.ev (N0.Arg J K f g) (r g))
        (VL.encIx (homV K J)) (\ g -> W1.ev (N1.Arg J K f g) (r g))
        (enc (homV K J)) (\ g -> arg J K f g (r g)) ;

    homJ (J K : Ob) (r : W0.Ix (N0.HomJ J K))
      : Id W1.M (VL.liftM (W0.ev (N0.HomJ J K) r).1) (W1.ev (N1.HomJ J K) r).1 =
      L.graph-value (Hom J I) (VL0.encIx (homV J I)) (\ f -> W0.ev (N0.HomK J K f) (r f))
        (VL.encIx (homV J I)) (\ f -> W1.ev (N1.HomK J K f) (r f))
        (enc (homV J I)) (\ f -> homK J K f (r f)) ;

    objK (J : Ob) (r : W0.Ix (N0.ObjK J))
      : Id W1.M (VL.liftM (W0.ev (N0.ObjK J) r).1) (W1.ev (N1.ObjK J) r).1 =
      L.graph-value Ob (VL0.encIx obV) (\ K -> W0.ev (N0.HomJ J K) (r K))
        (VL.encIx obV) (\ K -> W1.ev (N1.HomJ J K) (r K))
        (enc obV) (\ K -> homJ J K (r K)) ;

    read (r : W0.Ix N0.Code) : Id W1.M (VL.liftM (W0.ev N0.Code r).1) (W1.ev N1.Code r).1 =
      L.graph-value Ob (VL0.encIx obV) (\ J -> W0.ev (N0.ObjK J) (r J))
        (VL.encIx obV) (\ J -> W1.ev (N1.ObjK J) (r J))
        (enc obV) (\ J -> objK J (r J)) ;
    opaque read ;
  } ;

  lo : W0.V = R0.code Af Bf Aact Bact ;
  hi : W1.V = R1.code Af' Bf' Aact Bact ;
  Index : U a = W0.Ix lo ;

  member (r : Index) : Id W1.M (VL.liftM (W0.ev lo r).1) (W1.ev hi r).1 =
    L.pair-value (W0.ev D0.Fun r.1) (W0.ev Nat[r.1].N0.Code r.2)
      (W1.ev D1.Fun r.1) (W1.ev Nat[r.1].N1.Code r.2) (fun-read r.1) (Nat[r.1].read r.2) ;
  opaque member ;

  f0 (r : Index) : W1.M = (W1.ev (S.smallC lo) r).1 ;
  f1 (r : Index) : W1.M = (W1.ev hi r).1 ;
  eq : Id (Index -> W1.M) f0 f1 =
    funext Index (\ _ -> W1.M) f0 f1 (\ r -> transH (L.read-small lo r) (member r)) ;
  opaque eq ;

  module F = L.Fixed[Index, f0, f1, eq] ;

  law : Id W1.V (S.smallC lo) hi = L.code-eq (S.smallC lo) hi F.m ;
  cast (p : Id W1.V (S.smallC lo) hi) (r : Index)
    : Id Index (subst W1.V (\ v -> W1.Ix v) (S.smallC lo) hi p r) r =
    F.cast (S.smallC lo).2 hi.2 p r ;
  opaque law ; opaque cast ;
} ;

opaque PresheafPi.PPi.RawPi.rawF ;
