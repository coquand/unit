-- CExtFibU.seg (L5, inside CB): Theorem 7 once, at level a+, on the
-- universal glue data (model.tex §6.2).  The fibrations of AU and BU are
-- El's (the hypothesis elFib) substituted along the code maps pA and bmap;
-- the equivalence is the glued e_U (CExtEq2).  Theorem 7 (CThm7) gives
-- the fibration of Ext_U and the equivalence structure of ext_U.
--
-- Quarry: seg/model GExtFibU.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;

module FU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E2 = CExtEq2.EQ2[Cl, clSub, clSub-id, clSub-o, encCl] ;

  cAU : CLine[a+].Lines[UB.GDr, UB.AU].Fib = CFibSub[a+].FibSub[UB.GDr, UU.UCtx, UB.pA, UU.EGen].sub elFib ;

  cBU : CLine[a+].Lines[UB.CU.resCtx, UB.BU].Fib = CFibSub[a+].FibSub[UB.CU.resCtx, UU.UCtx, UB.bmap, UU.EGen].sub elFib ;

  module T7 = CThm7[a+].Thm7[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU, cAU, cBU, E2.eqU] ;

  -- Ext_U, its fibration, and the equivalence structure of ext_U
  extFibU : CLine[a+].Lines[UB.GDr, UB.ExtBig].Fib = T7.extFib ;

  extEquivU : CEquiv[a+].EquivOp UB.GDr UB.ExtBig UB.AU CExt4[a+].ExtB4[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU].extMap = T7.extEquiv ;
} ;
