-- CExtEquiv3.seg (L5, inside CB, level l): Theorem 7, ext is an
-- equivalence (model.tex §6.1): the extension of a side p of the fibre of
-- ext over w is v0 (CExtEquiv2), whose point is w on the nose.
--   KS   it agrees with p: the B part by ext-det (its image in A is the
--        filler at e0, its full restrictions are theta, which on p's sieve
--        is p), the line by the sides of the filler;
--   KU   it is uniform: the base point, the joined side and so the filler
--        commute with restriction (Fill's uniformity + kop-cong).
--
-- Quarry: seg/model GExtEquiv3, one sieve per side.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module ExtEq3 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (kA : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  open CExtEquiv[l].ExtEq[G, A, psi, B, al, kA, eal] ;
  open CExtEquiv2[l].ExtEq2[G, A, psi, B, al, kA, eal] ;

  kopX (X : Ob) (w : TA.EI X) (p : PX.Side[X, w]) : FX.TF.T X w = Th[X, w, p].v0.2 ;

  -- pb only depends on the map (equal maps, any proofs of fullness)
  pb-hom (X : Ob) (rho : W0.Ix (G.ob X)) (u : Pairs X rho) (W : Ob) (f f' : Hom W X) (E : Id (Hom W X) f f')
    (q : IsT (full W (G.act W X f rho))) (q' : IsT (full W (G.act W X f' rho)))
    : Id (TB.EI W) (pb X rho u W f q) (pb X rho u W f' q') =
    idJ (Hom W X) f (\ f2 E2 -> (q2 : IsT (full W (G.act W X f2 rho))) -> Id (TB.EI W) (pb X rho u W f q) (pb X rho u W f2 q2))
      (\ q2 -> apH (pb X rho u W f) (isProp-IsT' (full W (G.act W X f rho)) q q2)) f' E q' ;

  ----------------------------------------------------------------------
  -- The sides

  module KS (X : Ob) (w : TA.EI X) (p : PX.Side[X, w]) (W : Ob) (f : Hom W X) (i : Lands W X p.pQ f) {
    module T = Th[X, w, p] ;

    s : PX.Side[X, w] = p ;
    rho : W0.Ix (G.ob X) = w.1 ;
    gl : TX.EI X = glue X rho T.u ;

    module RB (V : Ob) (g : Hom V W) (q : IsT (full V (G.act V W g (EX.act W X f gl).1))) {
      fg : Hom V X = compH V W X f g ;
      rfg : W0.Ix (G.ob V) = G.act V X fg rho ;
      module PAc = PAct[V, X, fg, rho, rfg, refl rfg] ;

      qfg : IsT (full V rfg) =
        full-eq V (G.act V W g (EX.act W X f gl).1) rfg
          (transH (apH (G.act V W g) (apH (G.act W X f) (glue-pt X rho T.u))) (symH (G.act-o V W X f g rho))) q ;
      ifg : Lands V X s.pQ fg = lands-comp V W X s.pQ f g i ;
      qq : IsT (full V (s.pv V fg ifg).1.1) = full-eq V rfg (s.pv V fg ifg).1.1 (symH (apH (\ z -> z.1) (s.ppt V fg ifg))) qfg ;

      res : Id (TX.EI V) (EX.act V W g (EX.act W X f gl)) (EX.act V W g (FX.fibB W (s.pv W f i))) =
        transH (TX.PE.actC V W X f g gl)
         (transH (glue-act V X fg rho T.u)
          (transH (glue-B V rfg (PAc.pact T.u) qfg (qId V rfg qfg))
           -- pact-b reads u at  fg (idH V) , which is fg (comp-idr)
           (transH (apH (fromB V) (transH (PAc.pact-b T.u V (idH V) (qId V rfg qfg))
                                  (transH (pb-hom X rho T.u V (compH V V X fg (idH V)) fg (comp-idr V X fg)
                                             (PAc.qTr V (idH V) (qId V rfg qfg)) qfg)
                                          (T.u-b V fg qfg))))
            (transH (apH (\ z -> fromB V (FA.fibB V z)) (T.th-full V fg qfg ifg))
             (transH (apH (fromB V) (toFA-B V (s.pv V fg ifg) qq))
              (transH (fromB-toB V (FX.fibB V (s.pv V fg ifg)) qq)
               (transH (apH (FX.fibB V) (symH (s.pnat V W g f i ifg)))
                       (FX.fibB-act V W g (s.pv W f i))))))))) ;
    } ;

    extB : Id (TA.EI W) (extE W (EX.act W X f gl)) (extE W (FX.fibB W (s.pv W f i))) =
      calc (TA.EI W) {
          extE W (EX.act W X f gl)
        =< extE-nat W X f gl >
          EA.act W X f (extE X gl)
        =< apH (EA.act W X f) (transH T.u-ext T.a0-E) >
          EA.act W X f T.a0E
        =< T.F0-act W f >
          T.Fv W (compH W W X f (idH W)) (ptH W e0)
        =< T.F-S1 W f i W (idH W) (ptH W e0) >
          FX.fibL W (s.pv W f i) W (idH W) (ptH W e0)
        =< FX.fibL-0 W (s.pv W f i) >
          extE W (FX.fibB W (s.pv W f i)) } ;

    eB : Id (TX.EI W) (FX.fibB W (EFX.act W X f T.v0)) (FX.fibB W (s.pv W f i)) =
      transH (FX.fibB-act W X f T.v0)
       (transH (apH (EX.act W X f) T.gb-E)
               (ext-det W (EX.act W X f gl) (FX.fibB W (s.pv W f i))
                  (transH (apH (G.act W X f) (glue-pt X rho T.u)) (symH (apH (\ z -> z.1) (s.ppt W f i))))
                  extB (\ V g q -> RB[V, g, q].res))) ;

    side : Id (FX.TF.EI W) (EFX.act W X f (w, kopX X w p)) (s.pv W f i) =
      FX.fibE-eq W (EFX.act W X f T.v0) (s.pv W f i) (symH (s.ppt W f i)) eB
        (\ V g j -> T.F-S1 W f i V g j) ;
  } ;

  ----------------------------------------------------------------------
  -- Uniformity

  module KU (Y X : Ob) (h : Hom Y X) (w : TA.EI X) (p : PX.Side[X, w]) {
    rho : W0.Ix (G.ob X) = w.1 ;
    wY : TA.EI Y = EA.act Y X h w ;
    pY : PX.Side[Y, wY] = PX.rside Y X h w p ;
    rY : W0.Ix (G.ob Y) = G.act Y X h rho ;

    module ThX = Th[X, w, p] ;
    module ThY = Th[Y, wY, pY] ;
    module PAc = PAct[Y, X, h, rho, rY, refl rY] ;

    thR (V : Ob) (g : Hom V Y) (q1 : IsT (full V (G.act V X (compH V Y X h g) rho))) (q : IsT (full V (G.act V Y g rY)))
      : Id (FA.TF.EI V) (ThX.th V (compH V Y X h g) q1) (ThY.th V g q) =
      kE-cong V (EA.act V X (compH V Y X h g) w) (EA.act V Y g wY) (EA.act-o V Y X h g w) q1 q
        (PX.rside V X (compH V Y X h g) w p) (PX.rside V Y g wY pY) (PX.rside-o V Y X g h w p) ;

    -- the base points
    x0eq : Id (KA.TV.EI Y) (KA.TV.E.act Y X h ThX.x0) ThY.x0 =
      KA.tv-eq Y (KA.TV.E.act Y X h ThX.x0) ThY.x0
        (FG.fam-eq Y (FG.actF Y X h ThX.cL) ThY.cL (\ W f i -> symH (GL.actC W Y X h f rho)))
        (transH (KA.endE-act Y X h ThX.x0) (transH (apH (TA.E.act Y X h) ThX.x0-E) (symH ThY.x0-E))) ;

    -- two elements of the fibres at W over the same point (Y-side)
    tsY (W : Ob) (g : Hom W Y) (u v : KA.TS.EI W)
      (pu : Id (KA.TV.EI W) u.1 (KA.TV.E.act W X (compH W Y X h g) ThX.x0))
      (pv : Id (KA.TV.EI W) v.1 (KA.TV.E.act W Y g ThY.x0))
      (q : (V : Ob) (g' : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) ((KA.lineL W u).2.1.1 V g' j) ((KA.lineL W v).2.1.1 V g' j))
      : Id (KA.TS.EI W) u v =
      KA.ts-ext W u v
        (transH pu (transH (symH (KA.TV.PE.actC W Y X h g ThX.x0)) (transH (apH (KA.TV.E.act W Y g) x0eq) (symH pv)))) q ;

    -- the restricted joined side is the joined side of the restriction
    Qe : (n : Nat) -> Id (Phi Y) (pre Y X h (ThX.pick n).pQ) (ThY.pick n).pQ = split {
      zero -> refl (pre Y X h p.pQ) ;
      suc m -> symH (psi.cnat Y X h rho) } ;

    eQ : Id (Phi Y) (pre Y X h ThX.J.side.pQ) ThY.J.side.pQ =
      transH (pre-bigU Y X h (suc (suc zero)) ThX.J.Qs)
        (apH (\ F -> bigU Y (suc (suc zero)) F)
          (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Arith[a].Fin (suc (suc zero))) (\ k -> Phi Y)
             (\ k -> pre Y X h (ThX.J.Qs k)) ThY.J.Qs (\ k -> Qe k.1))) ;

    back (n : Nat) (W : Ob) (g : Hom W Y) (b : Lands W Y (ThY.pick n).pQ g) : Lands W X (ThX.pick n).pQ (compH W Y X h g) =
      lands-pre W Y X h (ThX.pick n).pQ g (lands-sub W Y (ThY.pick n).pQ (pre Y X h (ThX.pick n).pQ) (symH (Qe n)) g b) ;

    evs : (n : Nat) (W : Ob) (g : Hom W Y) (i : Lands W X (ThX.pick n).pQ (compH W Y X h g)) (i' : Lands W Y (ThY.pick n).pQ g)
      -> Id (KA.TS.EI W) ((ThX.pick n).pv W (compH W Y X h g) i) ((ThY.pick n).pv W g i') = split {
      zero -> \ W g i i' ->
        tsY W g (ThX.S1.sv W (compH W Y X h g) i) (ThY.S1.sv W g i')
          (ThX.S1.sv-pt W (compH W Y X h g) i) (ThY.S1.sv-pt W g i')
          (\ V g' j -> transH (ThX.S1.sv-val W (compH W Y X h g) i V g' j)
                       (transH (apH (\ z -> FX.fibL W z V g' j)
                                  (PX.pv-irr X w p W (compH W Y X h g) i (lands-pre W Y X h p.pQ g i')))
                               (symH (ThY.S1.sv-val W g i' V g' j)))) ;
      suc m -> \ W g i i' ->
        tsY W g (ThX.S2.sv W (compH W Y X h g) i) (ThY.S2.sv W g i')
          (ThX.S2.sv-pt W (compH W Y X h g) i) (ThY.S2.sv-pt W g i')
          (\ V g' j -> transH (ThX.S2.sv-val W (compH W Y X h g) i V g' j)
                       (transH (apH (\ z -> toEA V (FA.fibL W z V g' j))
                                  (thR W g (ThX.qOf W (compH W Y X h g) i) (ThY.qOf W g i')))
                               (symH (ThY.S2.sv-val W g i' V g' j)))) } ;

    ppR : Id (KA.PT.Side[Y, ThY.x0])
             (subst (KA.TV.EI Y) (\ z -> KA.PT.Side[Y, z]) (KA.TV.E.act Y X h ThX.x0) ThY.x0 x0eq
                    (KA.PT.rside Y X h ThX.x0 ThX.J.side))
             ThY.J.side =
      KA.PT.side-extH Y (KA.TV.E.act Y X h ThX.x0) ThY.x0 x0eq (KA.PT.rside Y X h ThX.x0 ThX.J.side) ThY.J.side eQ
        (\ W g i i' ->
          transH (ThX.J.pv-in (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').1 W (compH W Y X h g)
                    (back (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').1.1 W g (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').2)
                    (lands-pre W Y X h ThX.J.side.pQ g i))
                 (evs (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').1.1 W g
                    (back (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').1.1 W g (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').2)
                    (bigU-out W Y (suc (suc zero)) ThY.J.Qs g i').2)) ;

    -- the restricted filler is the filler of the restriction
    fillR : Id (KA.TS.EI Y) (KA.TS.E.act Y X h (ThX.x0, ThX.fill)) (ThY.x0, ThY.fill) =
      transH (kA.kunif Y X h ThX.x0 ThX.J.side)
        (RK.kop-cong kA Y (KA.TV.E.act Y X h ThX.x0) ThY.x0 x0eq (KA.PT.rside Y X h ThX.x0 ThX.J.side) ThY.J.side ppR) ;

    FvR (W : Ob) (g : Hom W Y) (j : Hom W Iv) : Id (TA.EI W) (ThX.Fv W (compH W Y X h g) j) (ThY.Fv W g j) =
      transH (symH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act Y X h (ThX.x0, ThX.fill))))
             (apH (\ u -> (KA.lineL Y u).2.1.1 W g j) fillR) ;

    opaque ppR ; opaque fillR ;

    a0eq : Id (TA.EI Y) (EA.act Y X h ThX.a0E) ThY.a0E =
      transH (ThX.F0-act Y h) (FvR Y (idH Y) (ptH Y e0)) ;

    Pa : Id (TA.T Y rY) (pa Y rY (PAc.pact ThX.u)) (pa Y rY ThY.u) =
      transH (PAc.pact-a ThX.u)
       (transH (apH (A.tact Y X h rho rY (refl rY)) ThX.u-a)
        (transH (TA.pr-inj Y rY (A.tact Y X h rho rY (refl rY) ThX.a0) ThY.a0
                   (transH (symH (TA.pr-tact Y X h rho rY (refl rY) ThX.a0))
                    (transH (apH (EA.act Y X h) ThX.a0-E) (transH a0eq (symH ThY.a0-E)))))
                (symH ThY.u-a))) ;

    Pb (V : Ob) (g : Hom V Y) (q : IsT (full V (G.act V Y g rY))) : Id (TB.EI V) (pb Y rY (PAc.pact ThX.u) V g q) (pb Y rY ThY.u V g q) =
      transH (PAc.pact-b ThX.u V g q)
       (transH (ThX.u-b V (compH V Y X h g) (PAc.qTr V g q))
        (transH (apH (FA.fibB V) (thR V g (PAc.qTr V g q) q))
                (symH (ThY.u-b V g q)))) ;

    pairsEq : Id (Pairs Y rY) (PAc.pact ThX.u) ThY.u = pairs-eq Y rY (PAc.pact ThX.u) ThY.u Pa Pb ;

    unif : Id (FX.TF.EI Y) (EFX.act Y X h (w, kopX X w p)) (wY, kopX Y wY pY) =
      FX.fibE-eq Y (EFX.act Y X h ThX.v0) ThY.v0 (refl wY)
        (transH (FX.fibB-act Y X h ThX.v0)
         (transH (apH (EX.act Y X h) ThX.gb-E)
          (transH (glue-act Y X h rho ThX.u)
           (transH (apH (glue Y rY) pairsEq) (symH ThY.gb-E)))))
        (\ W g j -> FvR W g j) ;
  } ;

  extEquiv : CEquiv[l].EquivOp G ExtT A extMap =
    new CPartial[l].Rel[EA, FX.FibT, FX.FibT, CPartial[l].pmap-id EA FX.FibT].RC[kopX,
      \ X w p W f i -> KS[X, w, p, W, f, i].side, \ Y X h w p -> KU[Y, X, h, w, p].unif] ;
} ;
