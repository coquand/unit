-- CCartLaws2.seg (L3, inside CB, levels i j k n): CCartLaws' composite
-- and congruence laws across levels (source, middle and target contexts
-- at their own levels), as CHFibLaws does for equivalences.

level i j k ;
constraint a <= i ;
constraint a <= j ;
constraint a <= k ;
open Base ;
open Prelude[(i \/ j \/ k)+] ;
open Paths[(i \/ j \/ k)+] ;
module W1 = V[i] ;
module W2 = V[j] ;
module W0 = V[k] ;
module P1 = GPre[i] ;
module P2 = GPre[j] ;
module P0 = GPre[k] ;

module CC (D1 : P1.PS.PCtx) (A1 : P1.PS.PTy[D1]) (D : P2.PS.PCtx) (A' : P2.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s1 : (W : Ob) -> W1.Ix (D1.ob W) -> W2.Ix (D.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D1.ob W)) -> Id (W2.Ix (D.ob V)) (s1 V (D1.act V W g d)) (D.act V W g (s1 W d)))
  (ta1 : (W : Ob) -> P1.TyL[D1, A1].EI W -> P2.TyL[D, A'].EI W)
  (tapt1 : (W : Ob) (v : P1.TyL[D1, A1].EI W) -> Id (W2.Ix (D.ob W)) (P2.TyL[D, A'].pr1 W (ta1 W v)) (s1 W (P1.TyL[D1, A1].pr1 W v)))
  (tanat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, A1].EI W)
     -> Id (P2.TyL[D, A'].EI V) (P2.TyL[D, A'].E.act V W g (ta1 W v)) (ta1 V (P1.TyL[D1, A1].E.act V W g v)))
  (tainj1 : (W : Ob) (v v' : P1.TyL[D1, A1].EI W) (P : Id (W1.Ix (D1.ob W)) (P1.TyL[D1, A1].pr1 W v) (P1.TyL[D1, A1].pr1 W v')) (Q : Id (P2.TyL[D, A'].EI W) (ta1 W v) (ta1 W v'))
     -> Id (P1.TyL[D1, A1].EI W) v v')
  (bk1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (A'.tob X (s1 X x))) -> W1.Ix (A1.tob X x))
  (bkta1 : (X : Ob) (x : W1.Ix (D1.ob X)) (u : W2.Ix (A'.tob X (s1 X x))) -> Id (P2.TyL[D, A'].EI X) (ta1 X (P1.TyL[D1, A1].pr X x (bk1 X x u))) (P2.TyL[D, A'].pr X (s1 X x) u))
  (s2 : (W : Ob) -> W2.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W2.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s2 V (D.act V W g d)) (G.act V W g (s2 W d)))
  (ta2 : (W : Ob) -> P2.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt2 : (W : Ob) (v : P2.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (P0.TyL[G, A].pr1 W (ta2 W v)) (s2 W (P2.TyL[D, A'].pr1 W v)))
  (tanat2 : (V W : Ob) (g : Hom V W) (v : P2.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta2 W v)) (ta2 V (P2.TyL[D, A'].E.act V W g v)))
  (tainj2 : (W : Ob) (v v' : P2.TyL[D, A'].EI W) (P : Id (W2.Ix (D.ob W)) (P2.TyL[D, A'].pr1 W v) (P2.TyL[D, A'].pr1 W v')) (Q : Id (P0.TyL[G, A].EI W) (ta2 W v) (ta2 W v'))
     -> Id (P2.TyL[D, A'].EI W) v v')
  (bk2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> W2.Ix (A'.tob X x))
  (bkta2 : (X : Ob) (x : W2.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> Id (P0.TyL[G, A].EI X) (ta2 X (P2.TyL[D, A'].pr X x (bk2 X x u))) (P0.TyL[G, A].pr X (s2 X x) u)) {
  module C1 = CCart[j, i].Cart[D1, A1, D, A', s1, s-nat1, ta1, tapt1, tanat1, tainj1, bk1, bkta1] ;
  module C2 = CCart[k, j].Cart[D, A', G, A, s2, s-nat2, ta2, tapt2, tanat2, tainj2, bk2, bkta2] ;

  -- the composite cart
  s (W : Ob) (d : W1.Ix (D1.ob W)) : W0.Ix (G.ob W) = s2 W (s1 W d) ;
  s-nat (V W : Ob) (g : Hom V W) (d : W1.Ix (D1.ob W)) : Id (W0.Ix (G.ob V)) (s V (D1.act V W g d)) (G.act V W g (s W d)) =
    transH (apH (s2 V) (s-nat1 V W g d)) (s-nat2 V W g (s1 W d)) ;
  ta (W : Ob) (v : P1.TyL[D1, A1].EI W) : P0.TyL[G, A].EI W = ta2 W (ta1 W v) ;
  tapt (W : Ob) (v : P1.TyL[D1, A1].EI W) : Id (W0.Ix (G.ob W)) (P0.TyL[G, A].pr1 W (ta W v)) (s W (P1.TyL[D1, A1].pr1 W v)) = transH (tapt2 W (ta1 W v)) (apH (s2 W) (tapt1 W v)) ;
  tanat (V W : Ob) (g : Hom V W) (v : P1.TyL[D1, A1].EI W)
    : Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta W v)) (ta V (P1.TyL[D1, A1].E.act V W g v)) =
    transH (tanat2 V W g (ta1 W v)) (apH (ta2 V) (tanat1 V W g v)) ;
  tainj (W : Ob) (v v' : P1.TyL[D1, A1].EI W) (P : Id (W1.Ix (D1.ob W)) (P1.TyL[D1, A1].pr1 W v) (P1.TyL[D1, A1].pr1 W v')) (Q : Id (P0.TyL[G, A].EI W) (ta W v) (ta W v'))
    : Id (P1.TyL[D1, A1].EI W) v v' =
    tainj1 W v v' P (tainj2 W (ta1 W v) (ta1 W v') (transH (tapt1 W v) (transH (apH (s1 W) P) (symH (tapt1 W v')))) Q) ;
  bk (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (A.tob X (s X x))) : W1.Ix (A1.tob X x) = bk1 X x (bk2 X (s1 X x) u) ;
  bkta (X : Ob) (x : W1.Ix (D1.ob X)) (u : W0.Ix (A.tob X (s X x))) : Id (P0.TyL[G, A].EI X) (ta X (P1.TyL[D1, A1].pr X x (bk X x u))) (P0.TyL[G, A].pr X (s X x) u) =
    transH (apH (ta2 X) (bkta1 X x (bk2 X (s1 X x) u))) (bkta2 X (s1 X x) u) ;

  module C12 = CCart[k, i].Cart[D1, A1, G, A, s, s-nat, ta, tapt, tanat, tainj, bk, bkta] ;

  -- the moved ends agree
  Ps (e : IPt) (W : Ob) (z : C1.AtEnd[e].EK'.TV.EI W) : Id (C12.AtEnd[e].EK.TV.EI W) (C2.AtEnd[e].sV W (C1.AtEnd[e].sV W z)) (C12.AtEnd[e].sV W z) =
    C12.AtEnd[e].EK.tv-eq W (C2.AtEnd[e].sV W (C1.AtEnd[e].sV W z)) (C12.AtEnd[e].sV W z)
      (C12.FG.fam-eq W (C2.sI W (C1.sI W (C1.AtEnd[e].EK'.TV.pr1 W z))) (C12.sI W (C1.AtEnd[e].EK'.TV.pr1 W z)) (\ V g j0 -> refl (s2 V (s1 V ((C1.AtEnd[e].EK'.TV.pr1 W z).1 V g j0)))))
      (transH (C2.AtEnd[e].sVE W (C1.AtEnd[e].sV W z)) (transH (apH (ta2 W) (C1.AtEnd[e].sVE W z)) (symH (C12.AtEnd[e].sVE W z)))) ;

  module E (e e' : IPt) (c : CLine[k].Lines[G, A].CompK[e, e'].Comp) {
    module M1 = C1.MoveComp[e, e'] ;
    module M2 = C2.MoveComp[e, e'] ;
    module M12 = C12.MoveComp[e, e'] ;
    module A1e = C1.AtEnd[e] ;
    module A2e = C2.AtEnd[e] ;
    module A12e = C12.AtEnd[e] ;

    module CP = CMoveLaws[i, j, k].Comp[A1e.EK'.TV.E, A1e.EK'.SFm.SF, M1.CK'.Tend, M1.CK'.endL,
      A2e.EK'.TV.E, A2e.EK'.SFm.SF, M2.CK'.Tend, M2.CK'.endL,
      A2e.EK.TV.E, A2e.EK.SFm.SF, M2.CK.Tend, M2.CK.endL,
      A1e.sV, A1e.sV-nat, A1e.mS, A1e.mSpt, A1e.mSnat, M1.mT, \ W v -> refl (A1e.sV W (M1.TT'.pr1 W v)), M1.mTnat, M1.mTinj, M1.bkT, M1.bkMv, M1.sq,
      A2e.sV, A2e.sV-nat, A2e.mS, A2e.mSpt, A2e.mSnat, M2.mT, \ W v -> refl (A2e.sV W (M2.TT'.pr1 W v)), M2.mTnat, M2.mTinj, M2.bkT, M2.bkMv, M2.sq, c] ;

    PmS (W : Ob) (u : A1e.EK'.TS.EI W) : Id (A12e.EK.TS.EI W) (A2e.mS W (A1e.mS W u)) (A12e.mS W u) =
      A12e.EK.ts-ext W (A2e.mS W (A1e.mS W u)) (A12e.mS W u)
        (transH (A2e.mSpt W (A1e.mS W u)) (transH (apH (A2e.sV W) (A1e.mSpt W u)) (transH (Ps e W (A1e.EK'.TS.pr1 W u)) (symH (A12e.mSpt W u)))))
        (\ V g j0 -> transH (apH (\ M -> C2.FA.lval W M V g j0) (A2e.mS-line W (A1e.mS W u)))
           (transH (apH (\ M -> ta2 V (C1.FA.lval W M V g j0)) (A1e.mS-line W u)) (symH (apH (\ M -> C12.FA.lval W M V g j0) (A12e.mS-line W u))))) ;

    PmT (W : Ob) (v : M1.TT'.EI W) : Id (M12.TT.EI W) (M2.mT W (M1.mT W v)) (M12.mT W v) =
      M12.CK.SE.mV-inj W (M2.mT W (M1.mT W v)) (M12.mT W v) (Ps e W (M1.TT'.pr1 W v)) (Ps e' W (M1.CK'.SE.mV W v)) ;

    comp : Id (M1.CK'.Comp) (M1.move (M2.move c)) (M12.move c) =
      transH CP.comp
        (CMoveLaws[i, i, k].Cong[A1e.EK'.TV.E, A1e.EK'.SFm.SF, M1.CK'.Tend, M1.CK'.endL,
          A2e.EK.TV.E, A2e.EK.SFm.SF, M2.CK.Tend, M2.CK.endL,
          CP.s, CP.s-nat, CP.mS, CP.mSpt, CP.mSnat, CP.mT, CP.mTpt, CP.mTnat, CP.mTinj, CP.bk, CP.bkMv, CP.sq,
          A12e.sV, A12e.sV-nat, A12e.mS, A12e.mSpt, A12e.mSnat, M12.mT, \ W v -> refl (A12e.sV W (M12.TT'.pr1 W v)), M12.mTnat, M12.mTinj, M12.bkT, M12.bkMv, M12.sq,
          Ps e, PmS, PmT, c].cong) ;
  } ;

  -- fibration structures
  compFib (c : CLine[k].Lines[G, A].Fib) : Id (CLine[i].Lines[D1, A1].Fib) (C1.moveFib (C2.moveFib c)) (C12.moveFib c) =
    transH (apH {CLine[i].Lines[D1, A1].CompK[e0, e1].Comp} {CLine[i].Lines[D1, A1].Fib} (\ z -> (z, (C1.moveFib (C2.moveFib c)).2)) E[e0, e1, c.1].comp)
           (apH {CLine[i].Lines[D1, A1].CompK[e1, e0].Comp} {CLine[i].Lines[D1, A1].Fib} (\ z -> ((C12.moveFib c).1, z)) E[e1, e0, c.2].comp) ;
} ;


module CG (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s1 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat1 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s1 V (D.act V W g d)) (G.act V W g (s1 W d)))
  (ta1 : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt1 : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (P0.TyL[G, A].pr1 W (ta1 W v)) (s1 W (P1.TyL[D, A'].pr1 W v)))
  (tanat1 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta1 W v)) (ta1 V (P1.TyL[D, A'].E.act V W g v)))
  (tainj1 : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) (P1.TyL[D, A'].pr1 W v) (P1.TyL[D, A'].pr1 W v')) (Q : Id (P0.TyL[G, A].EI W) (ta1 W v) (ta1 W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bk1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s1 X x))) -> W1.Ix (A'.tob X x))
  (bkta1 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s1 X x))) -> Id (P0.TyL[G, A].EI X) (ta1 X (P1.TyL[D, A'].pr X x (bk1 X x u))) (P0.TyL[G, A].pr X (s1 X x) u))
  (s2 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat2 : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s2 V (D.act V W g d)) (G.act V W g (s2 W d)))
  (ta2 : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt2 : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (P0.TyL[G, A].pr1 W (ta2 W v)) (s2 W (P1.TyL[D, A'].pr1 W v)))
  (tanat2 : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta2 W v)) (ta2 V (P1.TyL[D, A'].E.act V W g v)))
  (tainj2 : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) (P1.TyL[D, A'].pr1 W v) (P1.TyL[D, A'].pr1 W v')) (Q : Id (P0.TyL[G, A].EI W) (ta2 W v) (ta2 W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bk2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> W1.Ix (A'.tob X x))
  (bkta2 : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s2 X x))) -> Id (P0.TyL[G, A].EI X) (ta2 X (P1.TyL[D, A'].pr X x (bk2 X x u))) (P0.TyL[G, A].pr X (s2 X x) u))
  (Ps : (W : Ob) (x : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob W)) (s1 W x) (s2 W x))
  (Pta : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (P0.TyL[G, A].EI W) (ta1 W v) (ta2 W v)) {
  module C1 = CCart[k, i].Cart[D, A', G, A, s1, s-nat1, ta1, tapt1, tanat1, tainj1, bk1, bkta1] ;
  module C2 = CCart[k, i].Cart[D, A', G, A, s2, s-nat2, ta2, tapt2, tanat2, tainj2, bk2, bkta2] ;

  PsV (e : IPt) (W : Ob) (z : C1.AtEnd[e].EK'.TV.EI W) : Id (C1.AtEnd[e].EK.TV.EI W) (C1.AtEnd[e].sV W z) (C2.AtEnd[e].sV W z) =
    C1.AtEnd[e].EK.tv-eq W (C1.AtEnd[e].sV W z) (C2.AtEnd[e].sV W z)
      (C1.FG.fam-eq W (C1.sI W (C1.AtEnd[e].EK'.TV.pr1 W z)) (C2.sI W (C1.AtEnd[e].EK'.TV.pr1 W z)) (\ V g j0 -> Ps V ((C1.AtEnd[e].EK'.TV.pr1 W z).1 V g j0)))
      (transH (C1.AtEnd[e].sVE W z) (transH (Pta W (C1.AtEnd[e].EK'.endE W z)) (symH (C2.AtEnd[e].sVE W z)))) ;

  module E (e e' : IPt) (c : CLine[k].Lines[G, A].CompK[e, e'].Comp) {
    module M1 = C1.MoveComp[e, e'] ;
    module M2 = C2.MoveComp[e, e'] ;
    module A1e = C1.AtEnd[e] ;
    module A2e = C2.AtEnd[e] ;

    PmS (W : Ob) (u : A1e.EK'.TS.EI W) : Id (A1e.EK.TS.EI W) (A1e.mS W u) (A2e.mS W u) =
      A1e.EK.ts-ext W (A1e.mS W u) (A2e.mS W u)
        (transH (A1e.mSpt W u) (transH (PsV e W (A1e.EK'.TS.pr1 W u)) (symH (A2e.mSpt W u))))
        (\ V g j0 -> transH (apH (\ M -> C1.FA.lval W M V g j0) (A1e.mS-line W u))
           (transH (Pta V (C1.FA'.lval W (A1e.EK'.lineL W u) V g j0)) (symH (apH (\ M -> C2.FA.lval W M V g j0) (A2e.mS-line W u))))) ;

    PmT (W : Ob) (v : M1.TT'.EI W) : Id (M1.TT.EI W) (M1.mT W v) (M2.mT W v) =
      M1.CK.SE.mV-inj W (M1.mT W v) (M2.mT W v) (PsV e W (M1.TT'.pr1 W v)) (PsV e' W (M1.CK'.SE.mV W v)) ;

    cong : Id (M1.CK'.Comp) (M1.move c) (M2.move c) =
      CMoveLaws[i, i, k].Cong[A1e.EK'.TV.E, A1e.EK'.SFm.SF, M1.CK'.Tend, M1.CK'.endL,
        A1e.EK.TV.E, A1e.EK.SFm.SF, M1.CK.Tend, M1.CK.endL,
        A1e.sV, A1e.sV-nat, A1e.mS, A1e.mSpt, A1e.mSnat, M1.mT, \ W v -> refl (A1e.sV W (M1.TT'.pr1 W v)), M1.mTnat, M1.mTinj, M1.bkT, M1.bkMv, M1.sq,
        A2e.sV, A2e.sV-nat, A2e.mS, A2e.mSpt, A2e.mSnat, M2.mT, \ W v -> refl (A2e.sV W (M2.TT'.pr1 W v)), M2.mTnat, M2.mTinj, M2.bkT, M2.bkMv, M2.sq,
        PsV e, PmS, PmT, c].cong ;
  } ;

  congFib (c : CLine[k].Lines[G, A].Fib) : Id (CLine[i].Lines[D, A'].Fib) (C1.moveFib c) (C2.moveFib c) =
    transH (apH {CLine[i].Lines[D, A'].CompK[e0, e1].Comp} {CLine[i].Lines[D, A'].Fib} (\ z -> (z, (C1.moveFib c).2)) E[e0, e1, c.1].cong)
           (apH {CLine[i].Lines[D, A'].CompK[e1, e0].Comp} {CLine[i].Lines[D, A'].Fib} (\ z -> ((C2.moveFib c).1, z)) E[e1, e0, c.2].cong) ;
} ;

