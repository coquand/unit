-- CDSmallFull2.seg (L8, Delta): (C2) for Delta, the chain (CDSmallFull has the moves).  As there: (model.tex §8.2): at a point
-- y of GD full at the identity, the small Ext along yhat y with smallCl is
-- B's code.  Along the derived type equality (CSmallFull2.tyEq), as moves
-- of operations (COpTr, COpLaws):
--   transport, then the pull-back to Ext_U  =  along Kb then fromB   (P3)
--   along fromB the universal operation is hB      (CDOpFull, the case split)
--   hB is El's along bmap; Kb then Sub is the Yoneda cart   (P5)
--   El's operation along the Yoneda cart of Fb is Fb's     (CDOpYon)
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W1 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module PS = DB.GPre[a].PS ;
module DCl = CDeltaCl[a] ;
module CL = DCl.CL ;
module DU = DCl.DU ;
module YO = DB.GYon[a] ;

module SFD2 (elFib : DB.CLine[a+].Lines[DU.UCtx, DU.EGen].Fib)
  (W0 : Nat) (y : DB.CGlueE.GE[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl].GD1 W0)
  (q : IsT (DB.CGlueD.fl W0 y.1.2.1 W0 (idH (lin W0)))) {
  module S = CDSmallFull[a].SFD[elFib, W0, y, q] ;
  module SC = S.SC ;
  module OFm = S.OFm ;
  module A = S.A ;
  module TO = S.TO ;
  module OYm = S.OYm ;
  module C1 = S.C1 ;
  module C2 = S.C2 ;
  module C3 = S.C3 ;
  module G1 = S.G1 ;
  module G2 = S.G2 ;
  Fb1 : PS.PTy[YO.yP W0] = A.Fb.1 ;
  P : Id (PS.PTy[YO.yP W0]) A.T Fb1 = S.P ;
  c0 : CL.Cl (YO.yP W0) A.T = S.c0 ;
  cbfK (V : Nat) (g : Hom (lin V) (lin W0)) (b : W1.Ix (Fb1.tob V g)) : Id (W1.Ix (Fb1.tob V g)) (A.bkb V g (A.kb V g b)) b = S.cbfK V g b ;
  cfbK (V : Nat) (g : Hom (lin V) (lin W0)) (u : W1.Ix (DU.fib0 V (SC.UB.bmap.nt V (A.sb V g))))
    : Id (W1.Ix (DU.fib0 V (SC.UB.bmap.nt V (A.sb V g)))) (A.kb V g (A.bkb V g u)) u = S.cfbK V g u ;

  st1 : Id (CL.Cl (YO.yP W0) Fb1) TO.Pl[Fb1, P, c0].P.op C1.M12.op = C1.law ;
  st2 : Id (CL.Cl (YO.yP W0) Fb1) C1.M12.op C2.M12.op = G1.law ;
  st3 : Id (CL.Cl (YO.yP W0) Fb1) C2.M12.op C2.M1.op = symH C2.law ;
  st4 : Id (CL.Cl (YO.yP W0) Fb1) C2.M1.op C3.M1.op = apH {DB.COp[a+].OpS[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, SC.UB.CU.resCtx, SC.UB.BU].Op} {CL.Cl (YO.yP W0) Fb1} (\ cB -> DB.COpMove[a, a+].Pull[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, YO.yP W0, Fb1, SC.UB.CU.resCtx, SC.UB.BU, A.sb, A.sb-nat, A.kb, A.bkb, cbfK, cfbK, A.tbnat, cB].op) {OFm.P.op} {\ i o x h -> SC.hB i.1 i.2 o x h} OFm.law ;
  st5 : Id (CL.Cl (YO.yP W0) Fb1) C3.M1.op C3.M12.op = C3.law ;
  st6 : Id (CL.Cl (YO.yP W0) Fb1) C3.M12.op OYm.P.op = G2.law ;
  st7 : Id (CL.Cl (YO.yP W0) Fb1) OYm.P.op A.Fb.2 = OYm.law ;

  chain : Id (CL.Cl (YO.yP W0) Fb1) TO.Pl[Fb1, P, c0].P.op A.Fb.2 =
    transH {CL.Cl (YO.yP W0) Fb1} {TO.Pl[Fb1, P, c0].P.op} {C1.M12.op} {A.Fb.2} st1
     (transH {CL.Cl (YO.yP W0) Fb1} {C1.M12.op} {C2.M12.op} {A.Fb.2} st2
      (transH {CL.Cl (YO.yP W0) Fb1} {C2.M12.op} {C2.M1.op} {A.Fb.2} st3
       (transH {CL.Cl (YO.yP W0) Fb1} {C2.M1.op} {C3.M1.op} {A.Fb.2} st4
        (transH {CL.Cl (YO.yP W0) Fb1} {C3.M1.op} {C3.M12.op} {A.Fb.2} st5
         (transH {CL.Cl (YO.yP W0) Fb1} {C3.M12.op} {OYm.P.op} {A.Fb.2} st6 st7))))) ;

  opaque st1 ; opaque st2 ; opaque st3 ; opaque st4 ; opaque st5 ; opaque st6 ; opaque st7 ;

  -- (C2)
  law : Id (DU.U0 W0) (A.T, c0) A.Fb =
    transH (TO.law Fb1 P c0) (apH {CL.Cl (YO.yP W0) Fb1} {(T : PS.PTy[YO.yP W0]) * CL.Cl (YO.yP W0) T} (\ z -> (Fb1, z)) chain) ;
} ;
