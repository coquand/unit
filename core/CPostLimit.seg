-- CPostLimit.seg (L9): the coded internal limit of a countable tower.
-- A point is a sequence u and paths r_N(u_{N+1}) -> u_N.  Products
-- over the constant natural numbers are computed pointwise; paths are
-- the model's CPath.PathOverE, and the outer pair is its Sigma type.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LD = CLocD[a, l] ;
module HO = PB.CHtpyOps[l] ;

module Product (G : PCtx) (B : Nat -> PTy[G]) {
  ob (X : Ob) (x : W.Ix (G.ob X)) : W.V = W.PiV W.natV (\ N -> (B N).tob X x) ;
  act : TactTy G ob = \ J I f x y e u N -> (B N).tact J I f x y e (u N) ;
  aid : IdLaw G ob act = \ I x e u ->
    funext Nat (\ N -> W.Ix ((B N).tob I x)) _ _ (\ N -> (B N).tact-id I x e (u N)) ;
  ao : OLaw G ob act = \ K J I f g x y z e1 e2 e3 u ->
    funext Nat (\ N -> W.Ix ((B N).tob K z)) _ _ (\ N -> (B N).tact-o K J I f g x y z e1 e2 e3 (u N)) ;
  T : PTy[G] = mkTy G ob act aid ao ;
  ev (N : Nat) : HO.NMap[G, T, B N] = new HO.NMap[G, T, B N, \ I x u -> u N, \ J I f x y e u -> refl ((B N).tact J I f x y e (u N))] ;
} ;

module Tower (G : PCtx) (B : Nat -> PTy[G]) (r : (N : Nat) -> HO.NMap[G, B (suc N), B N]) {
  module Seq = Product[G, B] ;
  GS : PCtx = extP G Seq.T ;
  module Edge (N : Nat) {
    left : HO.NMap[G, Seq.T, B N] = HO.compN G Seq.T (B (suc N)) (B N) (Seq.ev (suc N)) (r N) ;
    module H = HO.HT[G, Seq.T, B N, left, Seq.ev N] ;
    module P = H.PT ;
  } ;
  module Edges = Product[GS, \ N -> Edge[N].P.PathP] ;
  module S = PresheafFormers[a, l].PFormers[PB.BC].SigAB[G, Seq.T, Edges.T] ;
  L : PTy[G] = S.SigP ;
  module TL = PR.TyL[G, L] ;

  -- Equality is determined by the sequence and the values of its paths.
  lext (X : Ob) (x : W.Ix (G.ob X)) (z z' : W.Ix (L.tob X x))
    (h : Id (W.Ix (Seq.ob X x)) z.1 z'.1)
    (q : (N : Nat) (V : Ob) (f : Hom V X) (j : Hom V Iv)
       -> Id (PR.TyL[G, B N].EI V) ((z.2 N).1.1 V f j) ((z'.2 N).1.1 V f j))
    : Id (W.Ix (L.tob X x)) z z' =
    idJ (W.Ix (Seq.ob X x)) z.1
      (\ u h1 -> (p : W.Ix (Edges.ob X (x, u)))
        -> ((N : Nat) (V : Ob) (f : Hom V X) (j : Hom V Iv)
          -> Id (PR.TyL[G, B N].EI V) ((z.2 N).1.1 V f j) ((p N).1.1 V f j))
        -> Id (W.Ix (L.tob X x)) z (u, p))
      (\ p q1 -> apH {W.Ix (Edges.ob X (x, z.1))} {W.Ix (L.tob X x)} (\ p1 -> (z.1, p1))
        (funext Nat (\ N -> W.Ix (Edge[N].P.tobP X (x, z.1))) z.2 p
          (\ N -> Edge[N].P.path-eq X (x, z.1) (z.2 N) (p N) (q1 N)))) z'.1 h z'.2 q ;

  -- A strictly commuting cone has constant coherence paths.
  module Cone (C : PTy[G]) (v : (N : Nat) -> HO.NMap[G, C, B N])
    (comm : (N : Nat) (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x))
      -> Id (W.Ix ((B N).tob X x)) ((r N).nfun X x ((v (suc N)).nfun X x u)) ((v N).nfun X x u)) {
    seq (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x)) : W.Ix (Seq.ob X x) = \ N -> (v N).nfun X x u ;
    module At (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x)) (N : Nat) {
      module T = PR.TyL[G, B N] ;
      b : T.EI X = (x, (v N).nfun X x u) ;
      path : W.Ix (Edge[N].P.tobP X (x, seq X x u)) =
        Edge[N].P.mkPath X (x, seq X x u)
          (\ V f j -> T.E.act V X f b)
          (\ V W k f j -> T.PE.actC V W X f k b)
          (\ V f j -> refl (G.act V X f x))
          (transH (T.E.act-id X b) (apH {W.Ix ((B N).tob X x)} {T.EI X} (\ w -> (x, w)) (symH (comm N X x u))))
          (T.E.act-id X b) ;
    } ;
    val (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x)) : W.Ix (L.tob X x) =
      (seq X x u, \ N -> At[X, x, u, N].path) ;
    nat (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (e : Id (W.Ix (G.ob J)) (G.act J I f x) y)
      (u : W.Ix (C.tob I x)) : Id (W.Ix (L.tob J y)) (L.tact J I f x y e (val I x u)) (val J y (C.tact J I f x y e u)) =
      lext J y _ _ (funext Nat (\ N -> W.Ix ((B N).tob J y)) _ _ (\ N -> (v N).nnat J I f x y e u))
        (\ N V g j -> transH (PR.TyL[G, B N].E.act-o V J I f g (x, (v N).nfun I x u))
          (apH (PR.TyL[G, B N].E.act V J g)
            (transH (PR.TyL[G, B N].pr-tact J I f x y e ((v N).nfun I x u))
              (apH {W.Ix ((B N).tob J y)} {PR.TyL[G, B N].EI J} (\ w -> (y, w)) ((v N).nnat J I f x y e u))))) ;
    map : HO.NMap[G, C, L] = new HO.NMap[G, C, L, val, nat] ;
  } ;
} ;

module Post (G : PCtx) (A : PTy[G]) {
  module CK = CCosk[a, l] ;
  module DA = LD.DT[G, A] ;
  module Stage (N : Nat) {
    module K = CK.KT[G, A, N] ;
    module D = LD.DT[G, K.KA] ;
    module R = LD.DMap[G, A, K.KA, K.etaN] ;
    module Down = LD.DMap[G, CK.KT[G, A, suc N].KA, K.KA, CK.Res[G, A, N, suc N, leb-suc N].resN] ;
  } ;
  B (N : Nat) : PTy[G] = Stage[N].D.DA ;
  r (N : Nat) : HO.NMap[G, B (suc N), B N] = new HO.NMap[G, B (suc N), B N, Stage[N].Down.DF, Stage[N].Down.DF-nat] ;
  v (N : Nat) : HO.NMap[G, DA.DA, B N] = new HO.NMap[G, DA.DA, B N, Stage[N].R.DF, Stage[N].R.DF-nat] ;
  module T = Tower[G, B, r] ;
  comm (N : Nat) (X : Ob) (x : W.Ix (G.ob X)) (u : DA.DEl X x)
    : Id (W.Ix ((B N).tob X x)) ((r N).nfun X x ((v (suc N)).nfun X x u)) ((v N).nfun X x u) =
    Stage[N].D.Dext X x _ _ (\ n f -> Stage[N].K.EKext (lin n) _ _ (refl (G.act (lin n) X f x))
      (\ j hj g -> refl (PR.TyL[G, A].E.act (lin j) (lin n) g (DA.rd X x u.1 n f)))) ;
  module Phi = T.Cone[DA.DA, v, comm] ;
  L : PTy[G] = T.L ;
  phi : HO.NMap[G, DA.DA, L] = Phi.map ;
} ;
