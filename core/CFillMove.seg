-- CFillMove.seg (L3, inside CB, levels k l): filling commutes with moves
-- (model.tex Prop "filling from composition", last clause).  For a
-- cartesian map A' -> A over s (CCart) and a composition ca of A, the
-- filler of A' from the moved composition, moved by mS, is the filler of
-- A at the moved data:
--
--   fill-mv   mS (x , fill'(x , sd)) = (sV x , fill(sV x , mside sd))
--
-- The problem at a point is formed from the data at that point only
-- (PM: its point and its side move to those of the moved data), so the
-- composites agree by kopMv; the values of the fillers are such
-- composites at restricted data (inpEq: restriction commutes with mside).

level k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
module P0 = GPre[k] ;
module P1 = GPre[l] ;

module FillMv (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s V (D.act V W g d)) (G.act V W g (s W d)))
  (ta : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta W v).1 (s W v.1))
  (tanat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta W v)) (ta V (P1.TyL[D, A'].E.act V W g v)))
  (tainj : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (ta W v) (ta W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bk : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> W1.Ix (A'.tob X x))
  (bkta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> Id (P0.TyL[G, A].EI X) (ta X (x, bk X x u)) (s X x, u))
  (dd : Bool) (ca : CLine[k].Lines[G, A].CompK[src dd, tgt dd].Comp) {
  module C = CCart[k, l].Cart[D, A', G, A, s, s-nat, ta, tapt, tanat, tainj, bk, bkta] ;
  module E = C.AtEnd[src dd] ;
  module MC = C.MoveComp[src dd, tgt dd] ;
  module TA' = P1.TyL[D, A'] ;
  module TA = P0.TyL[G, A] ;
  module FP' = CFillProb[l].FillP[D, A', dd] ;
  module FP = CFillProb[k].FillP[G, A, dd] ;
  module FC' = CFill[l].FillC[D, A', dd, MC.move ca] ;
  module FC = CFill[k].FillC[G, A, dd, ca] ;
  module RCk = CPartial[k].Rel[E.EK.TV.E, E.EK.SFm.SF, MC.CK.Tend, MC.CK.endL] ;

  -- the moved side
  msd (X : Ob) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x]) : E.EK.PT.Side[X, E.sV X x] = MC.mside ca X x sd ;

  -- moving commutes with restriction
  msd-restr (Y X : Ob) (h : Hom Y X) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x])
    : Id (E.EK.PT.Side[Y, E.sV Y (E.EK'.TV.E.act Y X h x)])
         (subst (E.EK.TV.EI Y) (\ z -> E.EK.PT.Side[Y, z]) (E.EK.TV.E.act Y X h (E.sV X x)) (E.sV Y (E.EK'.TV.E.act Y X h x))
            (symH (E.sV-nat Y X h x)) (E.EK.PT.rside Y X h (E.sV X x) (msd X x sd)))
         (msd Y (E.EK'.TV.E.act Y X h x) (E.EK'.PT.rside Y X h x sd)) =
    CMove[k, l].Mv[E.EK'.TV.E, E.EK'.SFm.SF, MC.CK'.Tend, MC.CK'.endL,
      E.EK.TV.E, E.EK.SFm.SF, MC.CK.Tend, MC.CK.endL, E.sV, E.sV-nat, E.mS, E.mSpt, E.mSnat,
      MC.mT, \ W v -> refl (E.sV W v.1), MC.mTnat, MC.mTinj, MC.bkT, MC.bkMv, MC.sq, ca].mside-restr Y X h x sd ;

  -- a composite of A', moved and read in A, is the composite read in A
  rd-mT (V : Ob) (v : FC'.TT.EI V) : Id (TA.EI V) (ta V (FC'.rd V v)) (FC.rd V (MC.mT V v)) =
    symH (MC.E'.sVE V (MC.CK'.SE.mV V v)) ;

  ----------------------------------------------------------------------
  -- the problem moves

  module PM (V : Ob) (w : E.EK'.TV.EI V) (sd : E.EK'.PT.Side[V, w]) (j : Hom V Iv) {
    module P' = FP'.Prob[V, w, sd, j] ;
    module P = FP.Prob[V, E.sV V w, msd V w sd, j] ;

    pt : Id (E.EK.TV.EI V) (E.sV V P'.w') P.w' =
      E.EK.tv-eq V (E.sV V P'.w') P.w'
        (C.FG.fam-eq V (E.sV V P'.w').1 P.w'.1 (\ V' f i -> refl (s V' (w.1.1 V' f (cI dd V' (compH V' V Iv j f) i)))))
        (calc (TA.EI V) {
            E.EK.endE V (E.sV V P'.w')
          =< E.sVE V P'.w' >
            ta V (E.EK'.endE V P'.w')
          =< apH (ta V) P'.w'-E >
            ta V (E.EK'.endE V w)
          =< symH (E.sVE V w) >
            E.EK.endE V (E.sV V w)
          =< symH P.w'-E >
            E.EK.endE V P.w' }) ;

    -- the sieves, side by side
    Qe : (n : Nat) -> Id (Phi V) (P'.pick n).pQ (P.pick n).pQ = split {
      zero -> refl (pre V Iv j (ptS (src dd))) ;
      suc m -> refl sd.pQ } ;

    eQ : Id (Phi V) P'.side.pQ P.side.pQ =
      apH (\ F -> bigU V (suc (suc zero)) F)
        (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Arith[a].Fin (suc (suc zero))) (\ q -> Phi V) P'.J.Qs P.J.Qs (\ q -> Qe q.1)) ;

    -- the points of the sides
    ptG (n : Nat) (V' : Ob) (f : Hom V' V) (b : Lands V' V (P'.pick n).pQ f) (b' : Lands V' V (P.pick n).pQ f)
      : Id (E.EK.TV.EI V') (E.mS V' ((P'.pick n).pv V' f b)).1 ((P.pick n).pv V' f b').1 =
      transH (E.mSpt V' ((P'.pick n).pv V' f b))
        (transH (apH (E.sV V') ((P'.pick n).ppt V' f b))
          (transH (E.sV-nat V' V f P'.w')
            (transH (apH (E.EK.TV.E.act V' V f) pt) (symH ((P.pick n).ppt V' f b'))))) ;

    -- the start, restricted, read in A
    z0E (V' : Ob) (f : Hom V' V) : Id (TA.EI V') (ta V' (P'.z0 V' f)) (P.z0 V' f) =
      transH (symH (E.sVE V' (E.EK'.TV.E.act V' V f P'.w')))
        (apH (E.EK.endE V') (transH (E.sV-nat V' V f P'.w') (apH (E.EK.TV.E.act V' V f) pt))) ;

    vEq : (n : Nat) (V' : Ob) (f : Hom V' V) (b : Lands V' V (P'.pick n).pQ f) (b' : Lands V' V (P.pick n).pQ f)
      -> Id (E.EK.TS.EI V') (E.mS V' ((P'.pick n).pv V' f b)) ((P.pick n).pv V' f b') = split {
      zero -> \ V' f b b' ->
        E.EK.ts-ext V' (E.mS V' (P'.v0 V' f b)) (P.v0 V' f b') (ptG zero V' f b b')
          (\ V'' g i ->
            calc (TA.EI V'') {
                (E.EK.lineL V' (E.mS V' (P'.v0 V' f b))).2.1.1 V'' g i
              =< apH (\ M -> M.2.1.1 V'' g i) (E.mS-line V' (P'.v0 V' f b)) >
                ta V'' ((E.EK'.lineL V' (P'.v0 V' f b)).2.1.1 V'' g i)
              =< apH (\ M -> ta V'' (M.2.1.1 V'' g i))
                   (E.EK'.mkTS-line V' (E.EK'.TV.E.act V' V f P'.w') (FP'.K.constA V' (P'.z0 V' f)) (P'.p0 V' f b) (P'.q0 V' f)) >
                ta V'' (TA'.E.act V'' V' g (P'.z0 V' f))
              =< symH (tanat V'' V' g (P'.z0 V' f)) >
                TA.E.act V'' V' g (ta V' (P'.z0 V' f))
              =< apH (TA.E.act V'' V' g) (z0E V' f) >
                TA.E.act V'' V' g (P.z0 V' f)
              =< symH (apH (\ M -> M.2.1.1 V'' g i)
                   (E.EK.mkTS-line V' (E.EK.TV.E.act V' V f P.w') (FP.K.constA V' (P.z0 V' f)) (P.p0 V' f b') (P.q0 V' f))) >
                (E.EK.lineL V' (P.v0 V' f b')).2.1.1 V'' g i }) ;
      suc m -> \ V' f b b' ->
        E.EK.ts-ext V' (E.mS V' (P'.v1 V' f b)) (P.v1 V' f b') (ptG (suc m) V' f b b')
          (\ V'' g i ->
            calc (TA.EI V'') {
                (E.EK.lineL V' (E.mS V' (P'.v1 V' f b))).2.1.1 V'' g i
              =< apH (\ M -> M.2.1.1 V'' g i) (E.mS-line V' (P'.v1 V' f b)) >
                ta V'' ((E.EK'.lineL V' (P'.v1 V' f b)).2.1.1 V'' g i)
              =< apH (\ M -> ta V'' (M.2.1.1 V'' g i))
                   (E.EK'.mkTS-line V' (E.EK'.TV.E.act V' V f P'.w') (FP'.K.connA V' (E.EK'.lineL V' (sd.pv V' f b)) (compH V' V Iv j f))
                      (P'.p1 V' f b) (P'.q1 V' f b)) >
                ta V'' ((E.EK'.lineL V' (sd.pv V' f b)).2.1.1 V'' g (cI dd V'' (compH V'' V' Iv (compH V' V Iv j f) g) i))
              =< symH (apH (\ M -> M.2.1.1 V'' g (cI dd V'' (compH V'' V' Iv (compH V' V Iv j f) g) i)) (E.mS-line V' (sd.pv V' f b))) >
                (E.EK.lineL V' (E.mS V' (sd.pv V' f b))).2.1.1 V'' g (cI dd V'' (compH V'' V' Iv (compH V' V Iv j f) g) i)
              =< apH (\ u -> (E.EK.lineL V' (E.mS V' u)).2.1.1 V'' g (cI dd V'' (compH V'' V' Iv (compH V' V Iv j f) g) i))
                   (E.EK'.PT.pv-irr V w sd V' f b b') >
                (E.EK.lineL V' (E.mS V' (sd.pv V' f b'))).2.1.1 V'' g (cI dd V'' (compH V'' V' Iv (compH V' V Iv j f) g) i)
              =< symH (apH (\ M -> M.2.1.1 V'' g i)
                   (E.EK.mkTS-line V' (E.EK.TV.E.act V' V f P.w') (FP.K.connA V' (E.EK.lineL V' ((msd V w sd).pv V' f b')) (compH V' V Iv j f))
                      (P.p1 V' f b') (P.q1 V' f b'))) >
                (E.EK.lineL V' (P.v1 V' f b')).2.1.1 V'' g i }) } ;

    sd-eq : Id (E.EK.PT.Side[V, P.w'])
               (subst (E.EK.TV.EI V) (\ z -> E.EK.PT.Side[V, z]) (E.sV V P'.w') P.w' pt (msd V P'.w' P'.side)) P.side =
      E.EK.PT.side-extH V (E.sV V P'.w') P.w' pt (msd V P'.w' P'.side) P.side eQ
        (\ V' f h h' ->
          transH (vEq (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1 V' f (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).2
                    (lands-sub V' V (P'.pick (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1).pQ
                       (P.pick (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1).pQ (Qe (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1) f
                       (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).2))
            (symH (P.J.pv-in (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1 V' f
                    (lands-sub V' V (P'.pick (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1).pQ
                       (P.pick (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1).pQ (Qe (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).1.1) f
                       (bigU-out V' V (suc (suc zero)) P'.J.Qs f h).2) h'))) ;

    opaque pt ; opaque sd-eq ;

    -- the composites agree
    out : Id (TA.EI V) (ta V (FC'.rd V (FC'.out V (w, sd) j))) (FC.rd V (FC.out V (E.sV V w, msd V w sd) j)) =
      transH (rd-mT V (FC'.out V (w, sd) j))
        (apH (FC.rd V)
          (transH (MC.kopMv ca V P'.w' P'.side)
            (RCk.kop-cong ca V (E.sV V P'.w') P.w' pt (msd V P'.w' P'.side) P.side sd-eq))) ;
  } ;

  ----------------------------------------------------------------------
  -- the fillers agree

  -- the restricted data, moved, are the restricted moved data
  inpEq (X : Ob) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x]) (V : Ob) (g : Hom V X)
    : Id (FC.In V) (E.sV V (FC'.F[X, x, sd].inp V g).1, msd V (FC'.F[X, x, sd].inp V g).1 (FC'.F[X, x, sd].inp V g).2)
                   (FC.F[X, E.sV X x, msd X x sd].inp V g) =
    symH (Sigma-path (E.EK.TV.EI V) (\ z -> E.EK.PT.Side[V, z]) (E.EK.TV.E.act V X g (E.sV X x)) (E.sV V (E.EK'.TV.E.act V X g x))
            (E.EK.PT.rside V X g (E.sV X x) (msd X x sd)) (msd V (E.EK'.TV.E.act V X g x) (E.EK'.PT.rside V X g x sd))
            (symH (E.sV-nat V X g x)) (msd-restr V X g x sd)) ;

  fill-mv (X : Ob) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x])
    : Id (E.EK.TS.EI X) (E.mS X (x, FC'.fill.kop X x sd)) (E.sV X x, FC.fill.kop X (E.sV X x) (msd X x sd)) =
    E.EK.ts-ext X (E.mS X (x, FC'.fill.kop X x sd)) (E.sV X x, FC.fill.kop X (E.sV X x) (msd X x sd)) (E.mSpt X (x, FC'.fill.kop X x sd))
      (\ V g j ->
        transH (apH (\ M -> M.2.1.1 V g j) (E.mS-line X (x, FC'.fill.kop X x sd)))
          (transH (PM[V, (FC'.F[X, x, sd].inp V g).1, (FC'.F[X, x, sd].inp V g).2, j].out)
                  (apH (\ z -> FC.rd V (FC.out V z j)) (inpEq X x sd V g)))) ;

  opaque fill-mv ;
} ;
