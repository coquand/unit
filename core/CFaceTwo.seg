-- CFaceTwo.seg (L9): a map g : W -> [n+2] missing two vertices y < z+1
-- factors through the codimension-2 face dl (z+1) dl y = dl y dl z
-- (the simplicial identity), as  g = dl (z+1) (dl y hh)  with
-- hh = dg z (dg y g).  Used to compare face data on two faces
-- (CLocHorn.HC, the boundary sides of CPostBdry).
--
--   TW[..].g'      dg y g, which misses z (ms')
--   TW[..].hh      dg z (dg y g)
--   eq-ddh         dl (z+1) (dl y hh) = g
--   eq-dlh         dl y hh = dg (z+1) g

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;

-- dg_y j = z  and  y <= z  give  j = z + 1  (for j /= y)
dg-hit (n y z j : Nat) (hy : IsT (leb y (suc n))) (hj : IsT (leb j (suc n))) (kj : IsT (not (eqN j y)))
  (hyz : IsT (leb y z)) (e : Id Nat (dg n y j) z) : Id Nat j (suc z) =
  transH (symH (skip-dg n y j hy hj kj)) (transH (apH (skip y) e) (skip-ge y z hyz)) ;

neq-of (x y : Nat) (k : Id Nat x y -> Empty) : IsT (not (eqN x y)) =
  eqN-dec (IsT (not (eqN x y))) x y (\ e -> absurd _ (k e)) (\ ne -> ne) ;

neq-elim (x : Nat) (k : IsT (not (eqN x x))) : Empty = false-true (transH (symH (apH not (eqN-refl x))) k) ;


module TW (n y z : Nat) (hyz : IsT (ltb y (suc z))) (hy : IsT (leb y (suc (suc n)))) (hz : IsT (leb (suc z) (suc (suc n))))
  (W : Ob) (g : Hom W (lin (suc (suc n)))) (msy : Miss W (suc n) y g) (msz : Miss W (suc n) (suc z) g) {
  m : Nat = suc n ;
  X : Ob = lin (suc m) ;

  g' : Hom W (lin m) = compH W X (lin m) (dgH m y) g ;

  msaux : (t : Tree) (hh : IsT (car X t)) -> IsT (not (eqN (vnum t) y)) -> IsT (not (eqN (vnum t) (suc z)))
    -> IsT (not (eqN (vnum (app X (lin m) (dgH m y) (t, hh)).1) z)) = split {
    leaf j -> \ hh kj kz' -> neq-of (dg m y j) z
      (\ e -> neq-elim (suc z) (substH (\ v -> IsT (not (eqN v (suc z)))) (dg-hit m y z j hy hh kj hyz e) kz')) ;
    node c d -> \ hh kj kz' -> absurd _ (false-true hh) } ;

  ms' : Miss W n z g' = \ s ->
    substH (\ t -> IsT (not (eqN (vnum t) z))) (symH (app-compH1 W X (lin m) (dgH m y) g s))
           (msaux (app W X g s).1 (app W X g s).2 (msy s) (msz s)) ;

  hh : Hom W (lin n) = compH W (lin m) (lin n) (dgH n z) g' ;

  eq-ddh : Id (Hom W X) (compH W (lin m) X (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh)) g =
    calc (Hom W X) {
        compH W (lin m) X (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh)
      =< symH (comp-assoc W (lin n) (lin m) X (dl m (suc z)) (dl n y) hh) >
        compH W (lin n) X (compH (lin n) (lin m) X (dl m (suc z)) (dl n y)) hh
      =< apH (\ k' -> compH W (lin n) X k' hh) (hom-eq (lin n) X _ _ (pw-dl-dl n y z hyz)) >
        compH W (lin n) X (compH (lin n) (lin m) X (dl m y) (dl n z)) hh
      =< comp-assoc W (lin n) (lin m) X (dl m y) (dl n z) hh >
        compH W (lin m) X (dl m y) (compH W (lin n) (lin m) (dl n z) hh)
      =< apH (compH W (lin m) X (dl m y)) (hom-eq W (lin m) _ _ (pw-factor W n z g' hz ms')) >
        compH W (lin m) X (dl m y) g'
      =< hom-eq W X _ _ (pw-factor W m y g hy msy) >
        g } ;

  eq-dlh : Id (Hom W (lin m)) (compH W (lin n) (lin m) (dl n y) hh) (compH W X (lin m) (dgH m (suc z)) g) =
    calc (Hom W (lin m)) {
        compH W (lin n) (lin m) (dl n y) hh
      =< symH (comp-idl W (lin m) (compH W (lin n) (lin m) (dl n y) hh)) >
        compH W (lin m) (lin m) (idH (lin m)) (compH W (lin n) (lin m) (dl n y) hh)
      =< apH (\ k' -> compH W (lin m) (lin m) k' (compH W (lin n) (lin m) (dl n y) hh))
             (symH (hom-eq (lin m) (lin m) _ _ (pw-dg-dl m (suc z) hz))) >
        compH W (lin m) (lin m) (compH (lin m) X (lin m) (dgH m (suc z)) (dl m (suc z))) (compH W (lin n) (lin m) (dl n y) hh)
      =< comp-assoc W (lin m) X (lin m) (dgH m (suc z)) (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh) >
        compH W X (lin m) (dgH m (suc z)) (compH W (lin m) X (dl m (suc z)) (compH W (lin n) (lin m) (dl n y) hh))
      =< apH (compH W X (lin m) (dgH m (suc z))) eq-ddh >
        compH W X (lin m) (dgH m (suc z)) g } ;
} ;
