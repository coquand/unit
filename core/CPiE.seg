-- CPiE.seg (L3, inside CB, level l): elements of Pi A B, read in the total
-- presheaf EB of B over G.A (copied from seg/model FibPiE).
--
--   valE x u K f v    = ((x f , v) , u f v)            in EB(K)
--   apW  x u K f w p  = (w , u f w)  for w in EA(K) over x f, the value
--                       transported to the point w itself (so that its
--                       first component is w on the nose)
--
-- and the laws used by the composition for Pi:
--   valE-cong   values depend only on the argument read in EA
--   valE-act    naturality of u, in EB
--   valE-tact   the action of Pi A B along h
--   valE-PiE    values depend only on (x , u) read in the total presheaf
--               of Pi A B
--   piE-eq      extensionality, in the total presheaf of Pi A B
--
-- PPi.bk moves an argument back along a path of points.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module PR = GPre[l] ;
open PR.PS ;
module PP = PresheafPi[a, l].PPi[BC] ;

module PiE (G : PCtx) (A : PTy[G]) (B : PTy[extP G A]) {

  module PC = PP.PiCode[G, A, B] ;

  P : PTy[G] = PC.PiP ;

  GA : PCtx = extP G A ;

  module TA = PR.TyL[G, A] ;
  module TB = PR.TyL[GA, B] ;
  module TP = PR.TyL[G, P] ;

  FA (K : Ob) (y : TA.Pt K) : U l = W0.Ix (A.tob K y) ;

  -- a point of A over y', moved back to y
  bk (K : Ob) (y y' : TA.Pt K) (q : Id (TA.Pt K) y y') (a0 : FA K y') : FA K y = PP.bk G A K y y' q a0 ;

  pp (K : Ob) (y y' : TA.Pt K) (q : Id (TA.Pt K) y y') (a0 : FA K y') : Id (TA.EI K) (TA.pr K y (bk K y y' q a0)) (TA.pr K y' a0) =
    PP.pairpath G A K y y' q a0 ;

  valE (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K I) (v : FA K (G.act K I f x)) : TB.EI K =
    (TB.pr K (TA.pr K (G.act K I f x) v) (u.1 K f v)) ;

  valE-cong (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f f' : Hom K I) (F : Id (Hom K I) f f')
    (v : FA K (G.act K I f x)) (v' : FA K (G.act K I f' x))
    (Q : Id (TA.EI K) (TA.pr K (G.act K I f x) v) (TA.pr K (G.act K I f' x) v'))
    : Id (TB.EI K) (valE I x u K f v) (valE I x u K f' v') =
    idJ (Hom K I) f
      (\ f2 F2 -> (v2 : FA K (G.act K I f2 x)) -> Id (TA.EI K) (TA.pr K (G.act K I f x) v) (TA.pr K (G.act K I f2 x) v2)
         -> Id (TB.EI K) (valE I x u K f v) (valE I x u K f2 v2))
      (\ v2 Q2 -> apH (valE I x u K f) (TA.pr-inj K (G.act K I f x) v v2 Q2))
      f' F v' Q ;

  -- naturality of u
  valE-act (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (J K : Ob) (f : Hom J I) (g : Hom K J)
    (v : FA J (G.act J I f x))
    : Id (TB.EI K) (TB.E.act K J g (valE I x u J f v))
                   (valE I x u K (compH K J I f g) (A.tact K J g (G.act J I f x) (G.act K I (compH K J I f g) x) (PC.cOf I x J K f g) v)) =
    transH (TB.pr-tact K J g (TA.pr J (G.act J I f x) v)
              (TA.pr K (G.act K I (compH K J I f g) x) (A.tact K J g (G.act J I f x) (G.act K I (compH K J I f g) x) (PC.cOf I x J K f g) v))
              (PC.eOf I x J K f g v) (u.1 J f v))
           (apH {W0.Ix (B.tob K (TA.pr K (G.act K I (compH K J I f g) x) (A.tact K J g (G.act J I f x) (G.act K I (compH K J I f g) x) (PC.cOf I x J K f g) v)))}
                {TB.EI K}
                (\ z -> (TB.pr K (TA.pr K (G.act K I (compH K J I f g) x) (A.tact K J g (G.act J I f x) (G.act K I (compH K J I f g) x) (PC.cOf I x J K f g) v)) z))
                (u.2 J K f g v)) ;

  -- the action of Pi along h
  valE-tact (J I : Ob) (h : Hom J I) (x : TA.Pt I) (x' : TA.Pt J) (e : Id (TA.Pt J) (G.act J I h x) x')
    (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K J) (v : FA K (G.act K J f x'))
    : Id (TB.EI K) (valE J x' (P.tact J I h x x' e u) K f v)
                   (valE I x u K (compH K J I h f) (bk K (G.act K I (compH K J I h f) x) (G.act K J f x') (PC.piPt J I h x x' e K f) v)) =
    symH (TB.pr-coe K (TA.pr K (G.act K I (compH K J I h f) x) (bk K (G.act K I (compH K J I h f) x) (G.act K J f x') (PC.piPt J I h x x' e K f) v))
                      (TA.pr K (G.act K J f x') v)
                      (pp K (G.act K I (compH K J I h f) x) (G.act K J f x') (PC.piPt J I h x x' e K f) v)
                      (u.1 K (compH K J I h f) (bk K (G.act K I (compH K J I h f) x) (G.act K J f x') (PC.piPt J I h x x' e K f) v))) ;

  -- values depend only on the element of the total presheaf of Pi
  valE-PiE (I : Ob) (x x' : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (u' : W0.Ix (PC.PiO I x'))
    (Q : Id (TP.EI I) (TP.pr I x u) (TP.pr I x' u'))
    (K : Ob) (f : Hom K I) (v : FA K (G.act K I f x)) (v' : FA K (G.act K I f x'))
    (R : Id (TA.EI K) (TA.pr K (G.act K I f x) v) (TA.pr K (G.act K I f x') v'))
    : Id (TB.EI K) (valE I x u K f v) (valE I x' u' K f v') =
    idJ (TP.EI I) (TP.pr I x u)
      (\ z2 Q2 -> (v2 : FA K (G.act K I f (TP.pr1 I z2))) -> Id (TA.EI K) (TA.pr K (G.act K I f x) v) (TA.pr K (G.act K I f (TP.pr1 I z2)) v2)
         -> Id (TB.EI K) (valE I x u K f v) (valE I (TP.pr1 I z2) (TP.pr2 I z2) K f v2))
      (\ v2 R2 -> valE-cong I x u K f f (refl f) v v2 R2)
      (TP.pr I x' u') Q v' R ;

  -- extensionality in the total presheaf of Pi
  PiExtH (I : Ob) (w : TP.EI I) (x2 : TA.Pt I) (u2 : W0.Ix (PC.PiO I x2)) : U l =
    (K : Ob) (f : Hom K I) (v : FA K (G.act K I f (TP.pr1 I w))) (v' : FA K (G.act K I f x2))
    -> Id (TA.EI K) (TA.pr K (G.act K I f (TP.pr1 I w)) v) (TA.pr K (G.act K I f x2) v')
    -> Id (TB.EI K) (valE I (TP.pr1 I w) (TP.pr2 I w) K f v) (valE I x2 u2 K f v') ;

  piE-eq (I : Ob) (w w' : TP.EI I) (X : Id (TA.Pt I) (TP.pr1 I w) (TP.pr1 I w')) (H : PiExtH I w (TP.pr1 I w') (TP.pr2 I w')) : Id (TP.EI I) w w' =
    idJ (TA.Pt I) (TP.pr1 I w)
      (\ x2 X2 -> (u2 : W0.Ix (PC.PiO I x2)) -> PiExtH I w x2 u2 -> Id (TP.EI I) w (TP.pr I x2 u2))
      (\ u2 H2 -> apH {W0.Ix (PC.PiO I (TP.pr1 I w))} {TP.EI I} (\ z -> (TP.pr I (TP.pr1 I w) z))
         (PC.piCode-eq I (PC.ptOf I (TP.pr1 I w)) (PC.cOf I (TP.pr1 I w)) (PC.eOf I (TP.pr1 I w)) (TP.pr2 I w) u2
            (\ K f v -> TB.pr-inj K (TA.pr K (G.act K I f (TP.pr1 I w)) v) ((TP.pr2 I w).1 K f v) (u2.1 K f v)
                          (H2 K f v v (refl (TA.pr K (G.act K I f (TP.pr1 I w)) v))))))
      (TP.pr1 I w') X (TP.pr2 I w') H ;

  ----------------------------------------------------------------------
  -- Values at a point of EA

  apW (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K I) (w : TA.EI K)
    (p : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) : W0.Ix (B.tob K w) =
    TB.coeT K (TB.pr1 K (valE I x u K f (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)))) w (pp K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)) (TB.pr2 K (valE I x u K f (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)))) ;

  apW-E (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K I) (w : TA.EI K)
    (p : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (v : FA K (G.act K I f x))
    (R : Id (TA.EI K) (TA.pr K (G.act K I f x) v) w)
    : Id (TB.EI K) (TB.pr K w (apW I x u K f w p)) (valE I x u K f v) =
    transH (symH (TB.pr-coe K (TB.pr1 K (valE I x u K f (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)))) w (pp K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)) (TB.pr2 K (valE I x u K f (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w))))))
           (valE-cong I x u K f f (refl f) (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)) v (transH (pp K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)) (symH R))) ;

  opaque apW ; opaque apW-E ;

  apW-E' (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K I) (w : TA.EI K)
    (p : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w))
    : Id (TB.EI K) (TB.pr K w (apW I x u K f w p)) (valE I x u K f (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w))) =
    apW-E I x u K f w p (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)) (pp K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)) ;

  -- naturality
  apW-act (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K I) (w : TA.EI K)
    (p : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (L : Ob) (g : Hom L K) (w' : TA.EI L)
    (p' : Id (TA.Pt L) (G.act L I (compH L K I f g) x) (TA.pr1 L w')) (Hw : Id (TA.EI L) (TA.E.act L K g w) w')
    : Id (TB.EI L) (TB.E.act L K g (TB.pr K w (apW I x u K f w p))) (TB.pr L w' (apW I x u L (compH L K I f g) w' p')) =
    transH (apH (TB.E.act L K g) (apW-E' I x u K f w p))
     (transH (valE-act I x u K L f g (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)))
             (symH (apW-E I x u L (compH L K I f g) w' p'
                      (A.tact L K g (G.act K I f x) (G.act L I (compH L K I f g) x) (PC.cOf I x K L f g) (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w)))
                      (transH (symH (TA.pr-tact L K g (G.act K I f x) (G.act L I (compH L K I f g) x) (PC.cOf I x K L f g) (bk K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w))))
                              (transH (apH (TA.E.act L K g) (pp K (G.act K I f x) (TA.pr1 K w) p (TA.pr2 K w))) Hw))))) ;

  -- the action of Pi
  apW-tact (J I : Ob) (h : Hom J I) (x : TA.Pt I) (x' : TA.Pt J) (e : Id (TA.Pt J) (G.act J I h x) x')
    (u : W0.Ix (PC.PiO I x)) (K : Ob) (f : Hom K J) (w : TA.EI K)
    (p : Id (TA.Pt K) (G.act K J f x') (TA.pr1 K w)) (p' : Id (TA.Pt K) (G.act K I (compH K J I h f) x) (TA.pr1 K w))
    : Id (TB.EI K) (TB.pr K w (apW J x' (P.tact J I h x x' e u) K f w p)) (TB.pr K w (apW I x u K (compH K J I h f) w p')) =
    transH (apW-E' J x' (P.tact J I h x x' e u) K f w p)
     (transH (valE-tact J I h x x' e u K f (bk K (G.act K J f x') (TA.pr1 K w) p (TA.pr2 K w)))
             (symH (apW-E I x u K (compH K J I h f) w p'
                      (bk K (G.act K I (compH K J I h f) x) (G.act K J f x') (PC.piPt J I h x x' e K f) (bk K (G.act K J f x') (TA.pr1 K w) p (TA.pr2 K w)))
                      (transH (pp K (G.act K I (compH K J I h f) x) (G.act K J f x') (PC.piPt J I h x x' e K f) (bk K (G.act K J f x') (TA.pr1 K w) p (TA.pr2 K w)))
                              (pp K (G.act K J f x') (TA.pr1 K w) p (TA.pr2 K w)))))) ;

  -- equal maps
  apW-f (I : Ob) (x : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (K : Ob) (f f' : Hom K I) (F : Id (Hom K I) f f')
    (w : TA.EI K) (p : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (p' : Id (TA.Pt K) (G.act K I f' x) (TA.pr1 K w))
    : Id (TB.EI K) (TB.pr K w (apW I x u K f w p)) (TB.pr K w (apW I x u K f' w p')) =
    idJ (Hom K I) f
      (\ f2 F2 -> (q : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (q' : Id (TA.Pt K) (G.act K I f2 x) (TA.pr1 K w))
         -> Id (TB.EI K) (TB.pr K w (apW I x u K f w q)) (TB.pr K w (apW I x u K f2 w q')))
      (\ q q' -> apH {Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)} {TB.EI K} (\ r -> (TB.pr K w (apW I x u K f w r)))
                     (W0.isSetIx (G.ob K) (G.act K I f x) (TA.pr1 K w) q q'))
      f' F p p' ;

  -- equal elements of Pi, at equal points
  apW-gen (I : Ob) (x x' : TA.Pt I) (u : W0.Ix (PC.PiO I x)) (u' : W0.Ix (PC.PiO I x'))
    (Q : Id (TP.EI I) (TP.pr I x u) (TP.pr I x' u'))
    (K : Ob) (f : Hom K I) (w w' : TA.EI K) (Hw : Id (TA.EI K) w w')
    (p : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (p' : Id (TA.Pt K) (G.act K I f x') (TA.pr1 K w'))
    : Id (TB.EI K) (TB.pr K w (apW I x u K f w p)) (TB.pr K w' (apW I x' u' K f w' p')) =
    idJ (TP.EI I) (TP.pr I x u)
      (\ z2 Q2 -> (w2 : TA.EI K) -> Id (TA.EI K) w w2 -> (q : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (q' : Id (TA.Pt K) (G.act K I f (TP.pr1 I z2)) (TA.pr1 K w2))
         -> Id (TB.EI K) (TB.pr K w (apW I x u K f w q)) (TB.pr K w2 (apW I (TP.pr1 I z2) (TP.pr2 I z2) K f w2 q')))
      (\ w2 Hw2 ->
         idJ (TA.EI K) w
           (\ w3 H3 -> (q : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)) (q' : Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w3))
              -> Id (TB.EI K) (TB.pr K w (apW I x u K f w q)) (TB.pr K w3 (apW I x u K f w3 q')))
           (\ q q' -> apH {Id (TA.Pt K) (G.act K I f x) (TA.pr1 K w)} {TB.EI K} (\ r -> (TB.pr K w (apW I x u K f w r)))
                          (W0.isSetIx (G.ob K) (G.act K I f x) (TA.pr1 K w) q q'))
           w2 Hw2)
      (TP.pr I x' u') Q w' Hw p p' ;
} ;
