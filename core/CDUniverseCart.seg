-- The generic family at the higher level restricted to the included
-- codes has the same fibres and restriction maps as the lower one.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module B = CDUniverseBase[a] ;
module I = CDUniverseLift[a] ;
module U0 = B.DC.DU ;
module U1 = B.Univ ;
module V0 = V[a] ;
module V1 = V[a+] ;
module D = B.P1.TyL[U0.UCtx, U0.EGen] ;
module G = B.P2.TyL[B.U1, B.El1] ;
open SmallCat[a].Homs[B.DB.obV, B.DB.homV] ;

ta (X : Nat) (w : D.EI X) : G.EI X = (I.inc X w.1, w.2) ;

module Action (J X : Nat) (f : Hom J X) (w : D.EI X) {
  x : U0.U0 J = U0.uAct J X f w.1 ;
  l : U1.U0 J = I.inc J x ;
  r : U1.U0 J = U1.uAct J X f (I.inc X w.1) ;
  p : Id (U1.U0 J) r l = symH (I.include-nat J X f w.1) ;
  Fib (z : U1.U0 J) : U a+ = V1.Ix (U1.fib0 J z) ;

  high : Fib r = (G.E.act J X f (ta X w)).2 ;
  low : Fib l = (D.E.act J X f w).2 ;
  move (b : Fib r) : Fib l = subst (U1.U0 J) (\ z -> Fib z) r l p b ;

  -- The input to the final transport is the same restriction of w.
  raw : Fib r = low ;

  restriction : Id (Fib r) high raw =
    I.P.PS.tact-irr (I.Y0.yP X) w.1.1 J X f (B.DB.idH X) ((I.Y0.yH J X f).nt J (B.DB.idH J))
      (U1.idf-eq J X f) (U0.idf-eq J X f) w.2 ;

  opaque restriction ;

  fixed : Id (Fib l) (move raw) low =
    transH (U1.substF J r l p raw)
      (I.read (U0.fib0 J x) (U0.fib0 J x) (refl (U0.fib0 J x)) (apH (U1.fib0 J) p) raw) ;

  opaque fixed ;

  law : Id (G.EI J) (G.E.act J X f (ta X w)) (ta J (D.E.act J X f w)) =
    Sigma-path (U1.U0 J) (\ z -> Fib z) r l high low p
      (transH (apH {Fib r} {Fib l} move {high} {raw} restriction) fixed) ;

  opaque law ;
} ;

tn (J X : Nat) (f : Hom J X) (w : D.EI X) : Id (G.EI J) (G.E.act J X f (ta X w)) (ta J (D.E.act J X f w)) =
  Action[J, X, f, w].law ;

ti (X : Nat) (u v : D.EI X) (p : Id (U0.U0 X) u.1 v.1) (q : Id (G.EI X) (ta X u) (ta X v)) : Id (D.EI X) u v =
  idJ (U0.U0 X) u.1
    (\ y r -> (b : V0.Ix (U0.fib0 X y)) -> Id (G.EI X) (ta X u) (ta X (y, b)) -> Id (D.EI X) u (y, b))
    (\ b r -> apH {V0.Ix (U0.fib0 X u.1)} {D.EI X} (\ z -> (u.1, z))
      (G.pr-inj X (I.inc X u.1) u.2 b r)) v.1 p v.2 q ;

opaque tn ; opaque ti ;
