-- CIdFib.seg (L3, inside CB, level l): Swan's identity type is fibrant
-- (model.tex §9.1, Prop "Id is fibrant").  From a composition cP of the
-- path type and a dependent conjunction dc: a problem of Id at (w0 , sd)
-- is read in the path type along the projection (sP, mS, mside); its
-- composite path p1 is the composite of cP, and its sieve is
--     ph1 = sd.pQ /\ (f |-> the sieve of the end of sd's line at f).
-- p1 is constant on ph1 by the sides of cP; the sides and the uniformity
-- of Id's composition are cP's on the paths and DCL.dc-at / dc-restr on
-- the sieves.
--
--   IF[.., e, e', cP, dc].comp     the composition of IdT from e to e'
--   IdFib[G, A, a, b].fib          Id(a , b) over G is fibrant

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module IF (K H : PCtx) (A : PTy[H])
  (s : (X : Ob) -> W0.Ix (K.ob X) -> (W : Ob) -> Hom W X -> Hom W Iv -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (aE bE : (W : Ob) -> W0.Ix (K.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (K.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (K.act W X f x)))
  (e e' : IPt)
  (cP : CLine[l].Lines[K, CPath[l].PathOverE[K, H, A, true, s, sN, aE, bE, aE-act, bE-act].PathP].CompK[e, e'].Comp)
  (dc : CId[l].DConj) {
  module IO = CId[l].IdOver[K, H, A, s, sN, aE, bE, aE-act, bE-act] ;
  module PT = IO.PT ;
  module TA = PT.TA ;
  module TI = IO.TI ;
  module TP = PT.TP ;
  module FK = CLine[l].FC[K] ;
  module CKI = CLine[l].Lines[K, IO.IdT].CompK[e, e'] ;
  module CKP = CLine[l].Lines[K, PT.PathP].CompK[e, e'] ;
  module EKI = CKI.EK ;
  module EKP = CKP.EK ;
  module EKI' = CLine[l].EndKit[K, IO.IdT, e'] ;
  module EKP' = CLine[l].EndKit[K, PT.PathP, e'] ;
  module EVI = CLine[l].FT[K, IO.IdT].Ev[e] ;
  module EVP = CLine[l].FT[K, PT.PathP].Ev[e] ;
  module EVI' = CLine[l].FT[K, IO.IdT].Ev[e'] ;
  module EVP' = CLine[l].FT[K, PT.PathP].Ev[e'] ;
  module TVI = EKI.TV ;
  module TVP = EKP.TV ;
  module TSI = EKI.TS ;
  module TSP = EKP.TS ;
  module PTI = EKI.PT ;
  module PTP = EKP.PT ;
  module TTI = GPR.TyL[TVI.E, CKI.Tend] ;
  module TTP = GPR.TyL[TVP.E, CKP.Tend] ;
  module RCI = CPartial[l].Rel[TVI.E, EKI.SFm.SF, CKI.Tend, CKI.endL] ;
  module RCP = CPartial[l].Rel[TVP.E, EKP.SFm.SF, CKP.Tend, CKP.endL] ;

  projS : PSub[TI.E, TP.E] = new PSub[TI.E, TP.E, IO.proj.mE, IO.proj.mnat] ;
  module FM = CLine[l].FMap[TI.E, TP.E, projS] ;

  ----------------------------------------------------------------------
  -- problems of Id read in the path type

  sP (W : Ob) (w : TVI.EI W) : TVP.EI W = (w.1, w.2.1) ;

  lineMap (W : Ob) (L : EKI.TL.EI W) : EKP.TL.EI W =
    (L.1, (FM.mapF W L.2.1, FK.fam-eq W (CLine[l].FT[K, PT.PathP].piL W (FM.mapF W L.2.1)) L.1 (\ V g j -> apH (\ y -> y.1 V g j) L.2.2))) ;

  mS (W : Ob) (v : TSI.EI W) : TSP.EI W =
    EKP.mkTS W (sP W v.1) (lineMap W (EKI.lineL W v)) (refl v.1.1)
      (transH (EVP.endB-E W (lineMap W (EKI.lineL W v)))
        (transH (apH (IO.proj.mE W) (symH (EVI.endB-E W (EKI.lineL W v))))
                (apH (\ w -> IO.proj.mE W (EKI.endE W w)) v.2.2))) ;

  mS-pt (W : Ob) (v : TSI.EI W) : Id (TVP.EI W) (mS W v).1 (sP W v.1) =
    EKP.mkTS-pt W (sP W v.1) (lineMap W (EKI.lineL W v)) (refl v.1.1)
      (transH (EVP.endB-E W (lineMap W (EKI.lineL W v)))
        (transH (apH (IO.proj.mE W) (symH (EVI.endB-E W (EKI.lineL W v))))
                (apH (\ w -> IO.proj.mE W (EKI.endE W w)) v.2.2))) ;

  mS-line (W : Ob) (v : TSI.EI W) : Id (EKP.TL.EI W) (EKP.lineL W (mS W v)) (lineMap W (EKI.lineL W v)) =
    EKP.mkTS-line W (sP W v.1) (lineMap W (EKI.lineL W v)) (refl v.1.1)
      (transH (EVP.endB-E W (lineMap W (EKI.lineL W v)))
        (transH (apH (IO.proj.mE W) (symH (EVI.endB-E W (EKI.lineL W v))))
                (apH (\ w -> IO.proj.mE W (EKI.endE W w)) v.2.2))) ;

  mS-nat (V W : Ob) (g : Hom V W) (v : TSI.EI W) : Id (TSP.EI V) (TSP.E.act V W g (mS W v)) (mS V (TSI.E.act V W g v)) =
    EKP.mkTS-act V W g (sP W v.1) (lineMap W (EKI.lineL W v)) (refl v.1.1)
      (transH (EVP.endB-E W (lineMap W (EKI.lineL W v)))
        (transH (apH (IO.proj.mE W) (symH (EVI.endB-E W (EKI.lineL W v))))
                (apH (\ w -> IO.proj.mE W (EKI.endE W w)) v.2.2)))
      (sP V (TSI.E.act V W g v).1) (lineMap V (EKI.lineL V (TSI.E.act V W g v))) (refl (TSI.E.act V W g v).1.1)
      (transH (EVP.endB-E V (lineMap V (EKI.lineL V (TSI.E.act V W g v))))
        (transH (apH (IO.proj.mE V) (symH (EVI.endB-E V (EKI.lineL V (TSI.E.act V W g v)))))
                (apH (\ w -> IO.proj.mE V (EKI.endE V w)) (TSI.E.act V W g v).2.2)))
      (refl (sP V (TVI.E.act V W g v.1)))
      (\ V'' f j -> apH (\ M -> IO.proj.mE V'' (M.2.1.1 V'' f j)) (symH (EKI.lineL-act V W g v))) ;

  mside (X : Ob) (x : TVI.EI X) (sd : PTI.Side[X, x]) : PTP.Side[X, sP X x] =
    new PTP.Side[X, sP X x, sd.pQ, \ W f i -> mS W (sd.pv W f i),
      \ W f i -> transH (mS-pt W (sd.pv W f i)) (apH (sP W) (sd.ppt W f i)),
      \ W' W chi f i i' -> transH (mS-nat W' W chi (sd.pv W f i)) (apH (mS W') (sd.pnat W' W chi f i i'))] ;

  mside-restr (Y X : Ob) (h : Hom Y X) (x : TVI.EI X) (sd : PTI.Side[X, x])
    : Id (PTP.Side[Y, sP Y (TVI.E.act Y X h x)])
         (subst (TVP.EI Y) (\ z -> PTP.Side[Y, z]) (TVP.E.act Y X h (sP X x)) (sP Y (TVI.E.act Y X h x))
            (refl (sP Y (TVI.E.act Y X h x))) (PTP.rside Y X h (sP X x) (mside X x sd)))
         (mside Y (TVI.E.act Y X h x) (PTI.rside Y X h x sd)) =
    PTP.side-extH Y (TVP.E.act Y X h (sP X x)) (sP Y (TVI.E.act Y X h x)) (refl (sP Y (TVI.E.act Y X h x)))
      (PTP.rside Y X h (sP X x) (mside X x sd)) (mside Y (TVI.E.act Y X h x) (PTI.rside Y X h x sd))
      (refl (pre Y X h sd.pQ))
      (\ W g i i' -> apH (mS W) (PTI.pv-irr X x sd W (compH W Y X h g) (lands-pre W Y X h sd.pQ g i) (lands-pre W Y X h sd.pQ g i'))) ;

  ----------------------------------------------------------------------
  -- composites, read in E

  mT (W : Ob) (u : TTI.EI W) : TTP.EI W = (sP W u.1, u.2.1) ;

  rdI (W : Ob) (u : TTI.EI W) : TI.EI W = EKI'.endE W (CKI.SE.mV W u) ;
  rdP (W : Ob) (u : TTP.EI W) : TP.EI W = EKP'.endE W (CKP.SE.mV W u) ;

  rdI-act (V W : Ob) (g : Hom V W) (u : TTI.EI W) : Id (TI.EI V) (rdI V (TTI.E.act V W g u)) (TI.E.act V W g (rdI W u)) =
    transH (apH (EKI'.endE V) (symH (CKI.SE.mV-nat V W g u))) (EKI'.endE-act V W g (CKI.SE.mV W u)) ;
  rdP-act (V W : Ob) (g : Hom V W) (u : TTP.EI W) : Id (TP.EI V) (rdP V (TTP.E.act V W g u)) (TP.E.act V W g (rdP W u)) =
    transH (apH (EKP'.endE V) (symH (CKP.SE.mV-nat V W g u))) (EKP'.endE-act V W g (CKP.SE.mV W u)) ;

  -- an element of the composite type is determined by its point and its
  -- reading in E
  ttI-ext (W : Ob) (u v : TTI.EI W) (P : Id (TVI.EI W) u.1 v.1) (Q : Id (TI.EI W) (rdI W u) (rdI W v)) : Id (TTI.EI W) u v =
    CKI.SE.mV-inj W u v P (EKI'.tv-eq W (CKI.SE.mV W u) (CKI.SE.mV W v) (apH (\ w -> w.1) P) Q) ;

  -- the end of a line of Id, read in the path type
  sq (W : Ob) (v : TSI.EI W) : Id (TP.EI W) (rdP W (CKP.endL.mE W (mS W v))) (IO.proj.mE W (rdI W (CKI.endL.mE W v))) =
    calc (TP.EI W) {
        rdP W (CKP.endL.mE W (mS W v))
      =< EVP'.endB-E W (EKP.lineL W (mS W v)) >
        (EKP.lineL W (mS W v)).2.1.1 W (idH W) (ptH W e')
      =< apH (\ L -> L.2.1.1 W (idH W) (ptH W e')) (mS-line W v) >
        IO.proj.mE W ((EKI.lineL W v).2.1.1 W (idH W) (ptH W e'))
      =< apH (IO.proj.mE W) (symH (EVI'.endB-E W (EKI.lineL W v))) >
        IO.proj.mE W (rdI W (CKI.endL.mE W v)) } ;

  ----------------------------------------------------------------------
  -- the composite at (X , w0 , sd)

  -- the sieve of the end of a line of Id
  endPhi (W : Ob) (v : TSI.EI W) : Phi W = (rdI W (CKI.endL.mE W v)).2.2.1 ;

  endPhi-act (V W : Ob) (g : Hom V W) (v : TSI.EI W) : Id (Phi V) (pre V W g (endPhi W v)) (endPhi V (TSI.E.act V W g v)) =
    apH (\ z -> z.2.2.1)
      (transH (symH (rdI-act V W g (CKI.endL.mE W v))) (apH (rdI V) (symH (CKI.endL.mnat V W g v)))) ;

  module F (X : Ob) (w0 : TVI.EI X) (sd : PTI.Side[X, w0]) {
    y1 : W0.Ix (K.ob X) = (FK.ev e').nt X w0.1 ;

    pk : TTP.EI X = (sP X w0, cP.kop X (sP X w0) (mside X w0 sd)) ;

    Fs (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f) : Phi W = endPhi W (sd.pv W f i) ;

    Fn (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X sd.pQ f) (i' : Lands V X sd.pQ (compH V W X f g))
      : Id (Phi V) (pre V W g (Fs W f i)) (Fs V (compH V W X f g) i') =
      transH (endPhi-act V W g (sd.pv W f i)) (apH (endPhi V) (sd.pnat V W g f i i')) ;

    module DL = CId[l].DCL[dc, X, sd.pQ, Fs, Fn] ;

    ph1 : Phi X = DL.DQ ;

    -- the path part of the sides
    pside (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f)
      : Id (TP.EI W) (TP.E.act W X f (rdP X pk)) (IO.proj.mE W (rdI W (CKI.endL.mE W (sd.pv W f i)))) =
      transH (symH (rdP-act W X f pk))
        (transH (apH (rdP W) (cP.kside X (sP X w0) (mside X w0 sd) W f i)) (sq W (sd.pv W f i))) ;

    p1 : W0.Ix (PT.tobP X y1) = pk.2 ;

    c1 (W : Ob) (f : Hom W X) (l : Lands W X ph1 f) (k : Hom W Iv)
      : Id (TA.EI W) (p1.1.1 W f k) (aE W (K.act W X f y1)) =
      calc (TA.EI W) {
          p1.1.1 W f k
        =< apH (\ m -> p1.1.1 W m k) (symH (comp-idr W X f)) >
          (TP.E.act W X f (rdP X pk)).2.1.1 W (idH W) k
        =< apH (\ z -> z.2.1.1 W (idH W) k) (pside W f (dc.dc-out W X sd.pQ Fs Fn f l).1) >
          (rdI W (CKI.endL.mE W (sd.pv W f (dc.dc-out W X sd.pQ Fs Fn f l).1))).2.1.1.1 W (idH W) k
        =< (rdI W (CKI.endL.mE W (sd.pv W f (dc.dc-out W X sd.pQ Fs Fn f l).1))).2.2.2 W (idH W) (dc.dc-out W X sd.pQ Fs Fn f l).2 k >
          aE W (K.act W W (idH W) (rdI W (CKI.endL.mE W (sd.pv W f (dc.dc-out W X sd.pQ Fs Fn f l).1))).1)
        =< apH (aE W) (transH (K.act-id W (rdI W (CKI.endL.mE W (sd.pv W f (dc.dc-out W X sd.pQ Fs Fn f l).1))).1)
                         (symH (apH (\ z -> z.1) (pside W f (dc.dc-out W X sd.pQ Fs Fn f l).1)))) >
          aE W (K.act W X f y1) } ;

    kop : W0.Ix (CKI.Tend.tob X w0) = (p1, (ph1, c1)) ;
  } ;

  kop (X : Ob) (w0 : TVI.EI X) (sd : PTI.Side[X, w0]) : W0.Ix (CKI.Tend.tob X w0) = F[X, w0, sd].kop ;

  -- the reading in E of Id's composite, projected, is the path composite
  rd-pk (X : Ob) (w0 : TVI.EI X) (sd : PTI.Side[X, w0]) (W : Ob) (f : Hom W X)
    : Id (TP.EI W) (IO.proj.mE W (rdI W (TTI.E.act W X f (w0, kop X w0 sd)))) (TP.E.act W X f (rdP X F[X, w0, sd].pk)) =
    apH (IO.proj.mE W) (rdI-act W X f (w0, kop X w0 sd)) ;

  kside (X : Ob) (w0 : TVI.EI X) (sd : PTI.Side[X, w0]) (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f)
    : Id (TTI.EI W) (TTI.E.act W X f (w0, kop X w0 sd)) (CKI.endL.mE W (sd.pv W f i)) =
    ttI-ext W (TTI.E.act W X f (w0, kop X w0 sd)) (CKI.endL.mE W (sd.pv W f i)) (symH (sd.ppt W f i))
      (IO.tpI-ext W (rdI W (TTI.E.act W X f (w0, kop X w0 sd))) (rdI W (CKI.endL.mE W (sd.pv W f i)))
         (apH (\ z -> z.1) (transH (rd-pk X w0 sd W f) (F[X, w0, sd].pside W f i)))
         (\ V g j -> apH (\ z -> z.2.1.1 V g j) (transH (rd-pk X w0 sd W f) (F[X, w0, sd].pside W f i)))
         (transH (apH (\ z -> z.2.2.1) (rdI-act W X f (w0, kop X w0 sd))) (F[X, w0, sd].DL.dc-at W f i))) ;

  kunif (Y X : Ob) (h : Hom Y X) (w0 : TVI.EI X) (sd : PTI.Side[X, w0])
    : Id (TTI.EI Y) (TTI.E.act Y X h (w0, kop X w0 sd)) (TVI.E.act Y X h w0, kop Y (TVI.E.act Y X h w0) (PTI.rside Y X h w0 sd)) =
    ttI-ext Y (TTI.E.act Y X h (w0, kop X w0 sd)) (TVI.E.act Y X h w0, kop Y (TVI.E.act Y X h w0) (PTI.rside Y X h w0 sd))
      (refl (TVI.E.act Y X h w0))
      (IO.tpI-ext Y (rdI Y (TTI.E.act Y X h (w0, kop X w0 sd))) (rdI Y (TVI.E.act Y X h w0, kop Y (TVI.E.act Y X h w0) (PTI.rside Y X h w0 sd)))
         (apH (\ z -> z.1) PU)
         (\ V g j -> apH (\ z -> z.2.1.1 V g j) PU)
         (transH (apH (\ z -> z.2.2.1) (rdI-act Y X h (w0, kop X w0 sd))) (F[X, w0, sd].DL.dc-restr Y h F[Y, TVI.E.act Y X h w0, PTI.rside Y X h w0 sd].Fn)))
   where {
     PU : Id (TP.EI Y) (IO.proj.mE Y (rdI Y (TTI.E.act Y X h (w0, kop X w0 sd))))
                       (IO.proj.mE Y (rdI Y (TVI.E.act Y X h w0, kop Y (TVI.E.act Y X h w0) (PTI.rside Y X h w0 sd)))) =
       transH (apH (IO.proj.mE Y) (rdI-act Y X h (w0, kop X w0 sd)))
         (transH (symH (rdP-act Y X h F[X, w0, sd].pk))
           (apH (rdP Y)
              (transH (cP.kunif Y X h (sP X w0) (mside X w0 sd))
                 (RCP.kop-cong cP Y (TVP.E.act Y X h (sP X w0)) (sP Y (TVI.E.act Y X h w0)) (refl (sP Y (TVI.E.act Y X h w0)))
                    (PTP.rside Y X h (sP X w0) (mside X w0 sd)) (mside Y (TVI.E.act Y X h w0) (PTI.rside Y X h w0 sd))
                    (mside-restr Y X h w0 sd))))) ; } ;

  opaque kside ; opaque kunif ;

  comp : CKI.Comp = new RCI.RC[kop, kside, kunif] ;
} ;

------------------------------------------------------------------------
-- Id(a , b) over G is fibrant

module IdFib (G : PCtx) (A : PTy[G]) (a b : PEl[G, A]) {
  module PF = CPathFib[l].PathFib[G, A, a, b] ;

  module IFm (e e' : IPt) (cP : CLine[l].Lines[G, PF.PathT].CompK[e, e'].Comp) (dc : CId[l].DConj) {
    module I = IF[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act, e, e', cP, dc] ;
  } ;

  IdT : PTy[G] = CId[l].IdOver[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act].IdT ;

  fib (fA : CLine[l].Lines[G, A].Fib) (dc : CId[l].DConj) : CLine[l].Lines[G, IdT].Fib =
    (IFm[e0, e1, (PF.fib fA).1, dc].I.comp, IFm[e1, e0, (PF.fib fA).2, dc].I.comp) ;
} ;
