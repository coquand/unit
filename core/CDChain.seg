-- CDChain.seg (L8, Delta): seg/model DChain.seg ported (module names only).  Was: a chain of DGlue steps (the shuffle chains of FillCell, in
-- line form, for any sequence of simplices).  Given prism sieves S d
-- (d = 0 .. N+1), a partial line on S 0, and for each d <= N a simplex
-- sigma_d : [N+1] -> [N] * [1] whose horn at kv d is S d along sigma_d,
-- with S (d+1) contained in S d u sigma_d, the partial line extends to
-- S (N+1).  Both directions of composition are instances (DPrismFill).
--
--   restrPL   a partial line on S restricts to any S2 contained in S
--   chain     the partial lines on S 0 .. S (N+1)
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DHn = CDHornFib[a, lz] ;
module DS = DBm.DS ;
module DHm = CDeltaCl[a] ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;

module DC (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (N : Nat)
  (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
  (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g))) {
  module P = DGm.PL[G, A, N, gt, gn] ;
  open DB.GPre[lz].TyL[G, A] ;

  -- restriction of a partial line to a smaller sieve
  restrPL (S S2 : DPS.PrS N) (inc : (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> IsT (S2.1 W f j) -> IsT (S.1 W f j))
    (L : P.PLine[S]) : P.PLine[S2] =
    new P.PLine[S2, \ W f j s -> L.v W f j (inc W f j s),
                    \ W f j s -> L.vpt W f j (inc W f j s),
                    \ V W g f j s s' -> L.vnat V W g f j (inc W f j s)
                                          (inc V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s')] ;

  module Chain (S : Nat -> DPS.PrS N) (L0 : P.PLine[S zero])
    (kv : Nat -> Nat) (hkv : (d : Nat) -> IsT (leb d N) -> IsT (leb (kv d) (suc N)))
    (s1 : Nat -> Hom (lin (suc N)) (lin N)) (s2 : Nat -> Hom (lin (suc N)) Iv)
    (Mem : Nat -> (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> Bool) (Mc : (d : Nat) -> DPS.PrClos N (Mem d))
    (fac : (d W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> IsT (Mem d W f j) -> Hom (lin W) (lin (suc N)))
    (fac1 : (d W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (Mem d W f j))
            -> Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc N)) (lin N) (s1 d) (fac d W f j u)) f)
    (fac2 : (d W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (Mem d W f j))
            -> Id (Hom (lin W) Iv) (compH (lin W) (lin (suc N)) Iv (s2 d) (fac d W f j u)) j)
    (uniq : (d W : Nat) (h h' : Hom (lin W) (lin (suc N)))
            -> Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc N)) (lin N) (s1 d) h) (compH (lin W) (lin (suc N)) (lin N) (s1 d) h')
            -> Id (Hom (lin W) Iv) (compH (lin W) (lin (suc N)) Iv (s2 d) h) (compH (lin W) (lin (suc N)) Iv (s2 d) h')
            -> Id (Hom (lin W) (lin (suc N))) h h')
    (cap1 : (d : Nat) -> IsT (leb d N) -> (W : Nat) (g : Hom (lin W) (lin (suc N)))
            -> IsT ((S d).1 W (compH (lin W) (lin (suc N)) (lin N) (s1 d) g) (compH (lin W) (lin (suc N)) Iv (s2 d) g))
            -> DS.Lands W (suc N) (DHm.hornS N (kv d)) g)
    (cap2 : (d : Nat) -> IsT (leb d N) -> (W : Nat) (g : Hom (lin W) (lin (suc N))) -> DS.Lands W (suc N) (DHm.hornS N (kv d)) g
            -> IsT ((S d).1 W (compH (lin W) (lin (suc N)) (lin N) (s1 d) g) (compH (lin W) (lin (suc N)) Iv (s2 d) g)))
    (inc : (d : Nat) -> IsT (leb d N) -> (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
           -> IsT ((S (suc d)).1 W f j) -> IsT (or ((S d).1 W f j) (Mem d W f j)))
    (hf : DHn.DH[G, A].isFib) {

    -- the step d -> d+1
    module Step (d : Nat) (hd : IsT (leb d N)) (L : P.PLine[S d]) {
      module Gl = P.Glue[S d, L, N, kv d, hkv d hd, s1 d, s2 d, Mem d, Mc d, fac d, fac1 d, fac2 d, uniq d, cap1 d hd, cap2 d hd, hf] ;
      next : P.PLine[S (suc d)] = restrPL Gl.S' (S (suc d)) (inc d hd) Gl.L' ;
    } ;

    chain : (d : Nat) -> IsT (leb d (suc N)) -> P.PLine[S d] = split {
      zero -> \ hd -> L0 ;
      suc d -> \ hd -> Step[d, hd, chain d (leb-step d N hd)].next } ;
  } ;
} ;
