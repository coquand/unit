-- CPostAssemble.seg: assemble cylinder data into the internal limit.
-- In particular the checked lines and squares of CPostLine/CPostSquare
-- give an element of L at X * I with the required two endpoints.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LM = CPostLimit[a, l] ;
module BD = CPostBdry[a, l] ;

module Pack (G : PCtx) (B : Nat -> PTy[G]) (r : (N : Nat) -> PB.CHtpyOps[l].NMap[G, B (suc N), B N])
  (X : Ob) (x : W.Ix (G.ob X)) (u : (N : Nat) -> W.Ix ((B N).tob X x))
  (p : (N : Nat) -> PR.TyL[G, B N].EI (prodP X Iv))
  (pp : (N : Nat) -> Id (W.Ix (G.ob (prodP X Iv))) (p N).1 (G.act (prodP X Iv) X (pr1 X Iv) x))
  (p0 : (N : Nat) -> Id (PR.TyL[G, B N].EI X) (PR.TyL[G, B N].E.act X (prodP X Iv) (lid X e0) (p N)) (x, (r N).nfun X x (u (suc N))))
  (p1 : (N : Nat) -> Id (PR.TyL[G, B N].EI X) (PR.TyL[G, B N].E.act X (prodP X Iv) (lid X e1) (p N)) (x, u N)) {
  module T = LM.Tower[G, B, r] ;
  module GL = PR.PshL[G] ;
  XI : Ob = prodP X Iv ;
  module At (N : Nat) {
    module TB = PR.TyL[G, B N] ;
    v (V : Ob) (f : Hom V X) (j : Hom V Iv) : TB.EI V = TB.E.act V XI (pairH X Iv V f j) (p N) ;
    vn (V W1 : Ob) (h : Hom V W1) (f : Hom W1 X) (j : Hom W1 Iv)
      : Id (TB.EI V) (TB.E.act V W1 h (v W1 f j)) (v V (compH V W1 X f h) (compH V W1 Iv j h)) =
      transH (TB.PE.actC V W1 XI (pairH X Iv W1 f j) h (p N))
        (apH (\ k -> TB.E.act V XI k (p N)) (BD.pair-h X Iv V W1 f j h)) ;
    vp (V : Ob) (f : Hom V X) (j : Hom V Iv) : Id (W.Ix (G.ob V)) (v V f j).1 (G.act V X f x) =
      transH (apH (G.act V XI (pairH X Iv V f j)) (pp N))
        (GL.actTri V XI X (pr1 X Iv) (pairH X Iv V f j) f (pr1-pair X Iv V f j) x) ;
    path : W.Ix (T.Edge[N].P.tobP X (x, u)) = T.Edge[N].P.mkPath X (x, u) v vn vp (p0 N) (p1 N) ;
  } ;
  point : W.Ix (T.L.tob X x) = (u, \ N -> At[N].path) ;

  -- Compare the restriction of a packed point with any point of L.
  -- A sequence equation and a cylinder equation suffice.
  module Restrict (Y : Ob) (h : Hom Y X) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
    (z : W.Ix (T.L.tob Y y))
    (hu : (N : Nat) -> Id (W.Ix ((B N).tob Y y)) ((B N).tact Y X h x y e (u N)) (z.1 N))
    (hp : (N : Nat) -> Id (PR.TyL[G, B N].EI (prodP Y Iv))
       (PR.TyL[G, B N].E.act (prodP Y Iv) XI (crossH Y X Iv Iv h (idH Iv)) (p N))
       ((z.2 N).1.1 (prodP Y Iv) (pr1 Y Iv) (pr2 Y Iv))) {
    module ZR = CPostInput[a, l].Read[G, B, r, Y, y, z] ;
    eq : Id (W.Ix (T.L.tob Y y)) (T.L.tact Y X h x y e point) z =
      T.lext Y y _ _ (funext Nat (\ N -> W.Ix ((B N).tob Y y)) _ _ hu)
        (\ N V f j -> transH
          (apH (\ k -> PR.TyL[G, B N].E.act V XI k (p N))
            (symH (transH (BD.cross-pair Y X Iv Iv V h (idH Iv) f j)
              (apH (pairH X Iv V (compH V Y X h f)) (comp-idl V Iv j)))))
          (transH (PR.TyL[G, B N].E.act-o V (prodP Y Iv) XI (crossH Y X Iv Iv h (idH Iv)) (pairH Y Iv V f j) (p N))
            (transH (apH (PR.TyL[G, B N].E.act V (prodP Y Iv) (pairH Y Iv V f j)) (hp N))
              (transH (symH (apH (PR.TyL[G, B N].E.act V (prodP Y Iv) (pairH Y Iv V f j)) ZR.At[N].ep))
                (ZR.At[N].val V f j))))) ;
  } ;
} ;

module Homotopy (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W.Ix (G.ob X)) (z : W.Ix (LM.Post[G, A].L.tob X x)) {
  module P = LM.Post[G, A] ;
  module I = CPostInput[a, l].Input[G, A, X, x, z] ;
  module C = I.Construction[c] ;
  module S = C.Sq ;
  module L = S.P ;
  XI : Ob = S.XI ;
  XII : Ob = S.XII ;
  xI : W.Ix (G.ob XI) = S.xI ;
  xII : W.Ix (G.ob XII) = S.xII ;
  lines (N : Nat) : W.Ix ((P.B N).tob XI xI) = L.DCN[N].line ;
  squares (N : Nat) : PR.TyL[G, P.B N].EI XII = (xII, S.DCS[N].sq) ;

  module At (N : Nat) {
    module TD = PR.TyL[G, P.B N] ;
    s0 : Id (TD.EI XI) (TD.E.act XI XII (lid XI e0) (squares N)) (xI, (P.r N).nfun XI xI (lines (suc N))) =
      transH (TD.pr-tact XI XII (S.slid e0) xII xI (S.eslid e0) S.DCS[N].sq)
        (apH {W.Ix ((P.B N).tob XI xI)} {TD.EI XI} (\ w -> (xI, w)) (S.sq-s0 N)) ;
    s1 : Id (TD.EI XI) (TD.E.act XI XII (lid XI e1) (squares N)) (xI, lines N) =
      transH (TD.pr-tact XI XII (S.slid e1) xII xI (S.eslid e1) S.DCS[N].sq)
        (apH {W.Ix ((P.B N).tob XI xI)} {TD.EI XI} (\ w -> (xI, w)) (S.sq-s1 N)) ;
    t0 : Id (TD.EI XI) (TD.E.act XI XII (S.tfc e0) (squares N))
      (TD.E.act XI X (pr1 X Iv) (x, (P.v N).nfun X x C.psi)) =
      transH (TD.pr-tact XI XII (S.tfc e0) xII xI (S.etfc e0) S.DCS[N].sq)
        (apH {W.Ix ((P.B N).tob XI xI)} {TD.EI XI} (\ w -> (xI, w)) (S.sq-t0 N)) ;
    t1 : Id (TD.EI XI) (TD.E.act XI XII (S.tfc e1) (squares N))
      ((z.2 N).1.1 XI (pr1 X Iv) (pr2 X Iv)) =
      transH (TD.pr-tact XI XII (S.tfc e1) xII xI (S.etfc e1) S.DCS[N].sq)
        (transH (apH {W.Ix ((P.B N).tob XI xI)} {TD.EI XI} (\ w -> (xI, w)) (S.sq-t1 N)) I.R.At[N].ep) ;
  } ;
  module H = Pack[G, P.B, P.r, XI, xI, lines, squares, \ N -> refl xII, \ N -> At[N].s0, \ N -> At[N].s1] ;
  line : W.Ix (P.L.tob XI xI) = H.point ;
  elid (e : El Iv) : Id (W.Ix (G.ob X)) (G.act X XI (lid X e) xI) x = L.DCN[zero].elid e ;
  end0 : Id (W.Ix (P.L.tob X x)) (P.L.tact X XI (lid X e0) xI x (elid e0) line) (P.phi.nfun X x C.psi) =
    H.Restrict[X, lid X e0, x, elid e0, P.phi.nfun X x C.psi, L.end0, \ N -> At[N].t0].eq ;
  end1 : Id (W.Ix (P.L.tob X x)) (P.L.tact X XI (lid X e1) xI x (elid e1) line) z =
    H.Restrict[X, lid X e1, x, elid e1, z, L.end1, \ N -> At[N].t1].eq ;
} ;
