-- CPosId.seg (L8, posets): identity types for the poset model (model.tex
-- §9.1).  Decidable sieves have dependent conjunction (CSieve.DConjS), so
-- Swan's identity type Id(a , b) is fibrant, equivalent to the path type,
-- and has J with its computation rule (J needs no dependent conjunction).
-- At levels a and a+ (types and the universe).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ;
module DSm = CSieve[a].DConjS[obV, homV, idH, compH, comp-assoc, comp-idl, comp-idr] ;

dc : PB.CId[a].DConj = new PB.CId[a].DConj[DSm.dconj, DSm.dc-in, DSm.dc-out] ;
dc1 : PB.CId[a+].DConj = new PB.CId[a+].DConj[DSm.dconj, DSm.dc-in, DSm.dc-out] ;

module IdA (G : PB.GPre[a].PS.PCtx) (A : PB.GPre[a].PS.PTy[G]) (a0 b0 : PB.GPre[a].PS.PEl[G, A]) {
  module IFb = PB.CIdFib[a].IdFib[G, A, a0, b0] ;
  module IEq = PB.CIdEquiv[a].IdEquiv[G, A, a0, b0] ;

  -- Id(a , b) is fibrant
  fib (fA : PB.CLine[a].Lines[G, A].Fib) : PB.CLine[a].Lines[G, IFb.IdT].Fib = IFb.fib fA dc ;

  -- the projection to the path type is an equivalence
  equiv (fA : PB.CLine[a].Lines[G, A].Fib)
    : PB.CEquiv[a].EquivOp G IFb.IdT IEq.PF.PathT PB.CId[a].IdOver[G, G, A, IEq.PF.s, IEq.PF.sN, IEq.PF.PE.aE, IEq.PF.PE.bE, IEq.PF.PE.aE-act, IEq.PF.PE.bE-act].proj =
    IEq.equiv fA dc ;
} ;

-- J, with J d (x , a x , refl) = d x
module JA (G : PB.GPre[a].PS.PCtx) (A : PB.GPre[a].PS.PTy[G]) (a0 : PB.GPre[a].PS.PEl[G, A]) {
  module IJ = PB.CIdJ[a].IJ[G, A, a0] ;

  J (C : PB.GPre[a].PS.PTy[IJ.D]) (cC : PB.CLine[a].Lines[IJ.D, C].CompK[e0, e1].Comp)
    (d : PB.GPre[a].PS.PEl[G, PB.GPre[a].PS.subTy G IJ.D C IJ.c]) : PB.GPre[a].PS.PEl[IJ.D, C] = IJ.JJ[C, cC, d].J ;

  beta (C : PB.GPre[a].PS.PTy[IJ.D]) (cC : PB.CLine[a].Lines[IJ.D, C].CompK[e0, e1].Comp)
    (d : PB.GPre[a].PS.PEl[G, PB.GPre[a].PS.subTy G IJ.D C IJ.c]) (X : Ob) (x : V[a].Ix (G.ob X))
    : Id (V[a].Ix (C.tob X (IJ.c.nt X x))) ((J C cC d).eob X (IJ.c.nt X x)) (d.eob X x) = IJ.JJ[C, cC, d].beta X x ;
} ;
