-- CElC.seg (L4, inside CB): El along a code map (model.tex §5.2:
-- Hypothesis "El is fibrant" and the code map).  For a classifier with a
-- fibration structure elFib on up El over the universe (the hypothesis),
-- a level-a context D and a natural code map c : D -> U:
--
--   Fam[D , c].ElTy   El substituted along c (xsub), by definition
--   Fam[D , c].fib    its fibration: elFib moved along c (CSmall.SmallFib)
--   elSub / ElCong / Yon / elCnat   El along codes: substitution, pointwise
--                     equal codes, Yoneda (El along the code of F over y Z
--                     is F), independence of the naturality proof
--
-- Quarry: seg/model GElC (ElC), GEqLaws.TyEqPw.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L1 = GPre[a+].PS ;
module LP1 = GPre[a+] ;
open GYon[a] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
open Encode[a, a+] ;

-- a type is determined by its codes and its action, read through a
-- pointwise equation of codes
module TyEqPw (D : PCtx) (A A' : PTy[D])
  (Po : (I : Ob) (x : W0.Ix (D.ob I)) -> Id W0.V (A.tob I x) (A'.tob I x))
  (H1 : (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J)) (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y)
        (a0 : W0.Ix (A.tob I x))
        -> Id (W0.Ix (A'.tob J y)) (subst W0.V (\ z -> W0.Ix z) (A.tob J y) (A'.tob J y) (Po J y) (A.tact J I f x y e a0))
                                   (A'.tact J I f x y e (subst W0.V (\ z -> W0.Ix z) (A.tob I x) (A'.tob I x) (Po I x) a0))) {
  P : Id (TOb D) A.tob A'.tob =
    funext Ob (\ I -> W0.Ix (D.ob I) -> W0.V) A.tob A'.tob
      (\ I -> funext (W0.Ix (D.ob I)) (\ x -> W0.V) (A.tob I) (A'.tob I) (\ x -> Po I x)) ;

  -- transport along P is transport along Po (V is a set)
  substP (I : Ob) (x : W0.Ix (D.ob I)) (a0 : W0.Ix (A.tob I x))
    : Id (W0.Ix (A'.tob I x)) (subst (TOb D) (\ o -> W0.Ix (o I x)) A.tob A'.tob P a0)
                              (subst W0.V (\ z -> W0.Ix z) (A.tob I x) (A'.tob I x) (Po I x) a0) =
    transH (subst-ap (TOb D) W0.V (\ o -> o I x) (\ z -> W0.Ix z) A.tob A'.tob P a0)
           (apH (\ q -> subst W0.V (\ z -> W0.Ix z) (A.tob I x) (A'.tob I x) q a0)
                (W0.isSetV (A.tob I x) (A'.tob I x) (ap (TOb D) W0.V (\ o -> o I x) A.tob A'.tob P) (Po I x))) ;

  tyEq : Id (PTy[D]) A A' =
    ty-ext2 D A A' P (\ J I f x y e a0 ->
      transH (substP J y (A.tact J I f x y e a0))
       (transH (H1 J I f x y e a0) (apH (A'.tact J I f x y e) (symH (substP I x a0))))) ;

  opaque substP ; opaque tyEq ;
} ;

module ElC (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module TE = LP1.TyL[UU.UCtx, UU.EGen] ;

  setU0 (Y : Ob) : isSet (UU.U0 Y) = V1.isSetIx (UU.codeU Y) ;

  -- the action of El does not depend on the path of codes
  tactG-irr (V W : Ob) (g : Hom V W) (F : UU.U0 W) (F' : UU.U0 V) (e e' : Id (UU.U0 V) (UU.uAct V W g F) F') (z : W0.Ix (UU.fib0 W F))
    : Id (W0.Ix (UU.fib0 V F')) (UU.tactG V W g F F' e z) (UU.tactG V W g F F' e' z) =
    CSmall.tact-irr UU.UCtx UU.El V W g F F' e e' z ;

  -- ... and moves along paths of the source and target codes
  tactG-cong (V W : Ob) (g : Hom V W) (F1 F1' : UU.U0 W) (P : Id (UU.U0 W) F1 F1') (F2 F2' : UU.U0 V) (Q : Id (UU.U0 V) F2 F2')
    (e : Id (UU.U0 V) (UU.uAct V W g F1) F2) (e' : Id (UU.U0 V) (UU.uAct V W g F1') F2') (z : W0.Ix (UU.fib0 W F1))
    : Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                (UU.tactG V W g F1' F2' e' (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F1' P z)) =
    idJ (UU.U0 W) F1
      (\ F3 P3 -> (e3 : Id (UU.U0 V) (UU.uAct V W g F3) F2')
         -> Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                      (UU.tactG V W g F3 F2' e3 (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F3 P3 z)))
      (\ e3 -> idJ (UU.U0 V) F2
         (\ F4 Q4 -> (e4 : Id (UU.U0 V) (UU.uAct V W g F1) F4)
            -> Id (W0.Ix (UU.fib0 V F4)) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F4 Q4 (UU.tactG V W g F1 F2 e z))
                                        (UU.tactG V W g F1 F4 e4 z))
         (\ e4 -> tactG-irr V W g F1 F2 e e4 z) F2' Q e3)
      F1' P e' ;

  opaque setU0 ; opaque tactG-cong ;

  -- a natural code map, as a map into UCtx
  cx (D : PCtx) (c : (Y : Ob) -> W0.Ix (D.ob Y) -> UU.U0 Y)
    (cnat : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y') (c Y' (D.act Y' Y h x)) (UU.uAct Y' Y h (c Y x)))
    : CSmall.XSub[D, UU.UCtx] = new CSmall.XSub[D, UU.UCtx, c, cnat] ;

  -- El along c: El substituted along c, with its fibration (GSmallFib)
  module Fam (D : PCtx) (c : (Y : Ob) -> W0.Ix (D.ob Y) -> UU.U0 Y)
    (cnat : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y') (c Y' (D.act Y' Y h x)) (UU.uAct Y' Y h (c Y x))) {
    module X = CSmall.SmallFib[UU.UCtx, UU.El, D, cx D c cnat] ;

    ep (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J)) (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y)
      : Id (UU.U0 J) (UU.uAct J I f (c I x)) (c J y) =
      CSmall.xntEq D UU.UCtx (cx D c cnat) J I f x y e ;

    ElTy : PTy[D] = X.ElTy ;

    fib : CLine[a].Lines[D, ElTy].Fib = X.fib elFib ;
  } ;

  ----------------------------------------------------------------------
  -- El along codes: substitution, pointwise equal codes, and Yoneda

  -- El along c, substituted along s, is El along c o s
  elSub (D : PCtx) (c : (Y : Ob) -> W0.Ix (D.ob Y) -> UU.U0 Y)
    (cnat : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y') (c Y' (D.act Y' Y h x)) (UU.uAct Y' Y h (c Y x)))
    (D' : PCtx) (s : PSub[D', D])
    : Id (PTy[D']) (subTy D' D Fam[D, c, cnat].ElTy s)
                   Fam[D', \ Y x -> c Y (s.nt Y x), \ Y' Y h x -> transH (apH (c Y') (s.nt-nat Y' Y h x)) (cnat Y' Y h (s.nt Y x))].ElTy =
    CSmall.xsub-o D' D UU.UCtx UU.El (cx D c cnat) s ;

  -- El along pointwise equal code maps
  module ElCong (D : PCtx) (c c' : (Y : Ob) -> W0.Ix (D.ob Y) -> UU.U0 Y)
    (cnat : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y') (c Y' (D.act Y' Y h x)) (UU.uAct Y' Y h (c Y x)))
    (cnat' : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y') (c' Y' (D.act Y' Y h x)) (UU.uAct Y' Y h (c' Y x)))
    (Pc : (Y : Ob) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y) (c Y x) (c' Y x)) {
    Po (I : Ob) (x : W0.Ix (D.ob I)) : Id W0.V (UU.fib0 I (c I x)) (UU.fib0 I (c' I x)) =
      ap (UU.U0 I) W0.V (UU.fib0 I) (c I x) (c' I x) (Pc I x) ;

    H1 (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J)) (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y)
      (a0 : W0.Ix (UU.fib0 I (c I x)))
      : Id (W0.Ix (UU.fib0 J (c' J y)))
           (subst W0.V (\ z -> W0.Ix z) (UU.fib0 J (c J y)) (UU.fib0 J (c' J y)) (Po J y) (Fam[D, c, cnat].ElTy.tact J I f x y e a0))
           (Fam[D, c', cnat'].ElTy.tact J I f x y e (subst W0.V (\ z -> W0.Ix z) (UU.fib0 I (c I x)) (UU.fib0 I (c' I x)) (Po I x) a0)) =
      transH (symH (UU.substF J (c J y) (c' J y) (Pc J y) (Fam[D, c, cnat].ElTy.tact J I f x y e a0)))
        (transH (tactG-cong J I f (c I x) (c' I x) (Pc I x) (c J y) (c' J y) (Pc J y)
                   (Fam[D, c, cnat].ep J I f x y e) (Fam[D, c', cnat'].ep J I f x y e) a0)
                (apH (\ z -> Fam[D, c', cnat'].ElTy.tact J I f x y e z) (UU.substF I (c I x) (c' I x) (Pc I x) a0))) ;

    elCong : Id (PTy[D]) Fam[D, c, cnat].ElTy Fam[D, c', cnat'].ElTy = TyEqPw[D, Fam[D, c, cnat].ElTy, Fam[D, c', cnat'].ElTy, Po, H1].tyEq ;
  } ;

  -- Yoneda: El along g |-> uAct g F over y Z is F (the same codes)
  module Yon (Z : Ob) (F : UU.U0 Z)
    (cYnat : (Y' Y : Ob) (h : Hom Y' Y) (g : Hom Y Z) -> Id (UU.U0 Y') (UU.uAct Y' Z (compH Y' Y Z g h) F) (UU.uAct Y' Y h (UU.uAct Y Z g F))) {
    cY (Y : Ob) (g : Hom Y Z) : UU.U0 Y = UU.uAct Y Z g F ;

    Po (I : Ob) (x : Hom I Z) : Id W0.V (UU.fib0 I (cY I x)) (F.1.tob I x) = apH (F.1.tob I) (comp-idr I Z x) ;

    H1 (J I : Ob) (f : Hom J I) (x : Hom I Z) (y : Hom J Z) (e : Id (Hom J Z) (compH J I Z x f) y) (a0 : W0.Ix (UU.fib0 I (cY I x)))
      : Id (W0.Ix (F.1.tob J y))
           (subst W0.V (\ z -> W0.Ix z) (UU.fib0 J (cY J y)) (F.1.tob J y) (Po J y) (Fam[yP Z, cY, cYnat].ElTy.tact J I f x y e a0))
           (F.1.tact J I f x y e (subst W0.V (\ z -> W0.Ix z) (UU.fib0 I (cY I x)) (F.1.tob I x) (Po I x) a0)) =
      calc (W0.Ix (F.1.tob J y)) {
          subst W0.V (\ z -> W0.Ix z) (UU.fib0 J (cY J y)) (F.1.tob J y) (Po J y)
            (UU.tactG J I f (cY I x) (cY J y) e' a0)
        =< apH (subst W0.V (\ z -> W0.Ix z) (UU.fib0 J (cY J y)) (F.1.tob J y) (Po J y))
             (transH (UU.substF J (UU.uAct J I f (cY I x)) (cY J y) e' t)
               (UU.fib-move (Hom J Z) (F.1.tob J) y1 y0 pH (ap (UU.U0 J) W0.V (UU.fib0 J) (UU.uAct J I f (cY I x)) (cY J y) e') t)) >
          subst W0.V (\ z -> W0.Ix z) (F.1.tob J y0) (F.1.tob J y) (Po J y)
            (subst (Hom J Z) (\ k -> W0.Ix (F.1.tob J k)) y1 y0 pH t)
        =< apH (subst W0.V (\ z -> W0.Ix z) (F.1.tob J y0) (F.1.tob J y) (Po J y))
             (UU.tact-move (yP Z) F.1 J I f x0 y1 y0 n (transH n pH) pH a0) >
          subst W0.V (\ z -> W0.Ix z) (F.1.tob J y0) (F.1.tob J y) (Po J y) (F.1.tact J I f x0 y0 (transH n pH) a0)
        =< UU.fib-move (Hom J Z) (F.1.tob J) y0 y (comp-idr J Z y) (Po J y) (F.1.tact J I f x0 y0 (transH n pH) a0) >
          subst (Hom J Z) (\ k -> W0.Ix (F.1.tob J k)) y0 y (comp-idr J Z y) (F.1.tact J I f x0 y0 (transH n pH) a0)
        =< UU.tact-move (yP Z) F.1 J I f x0 y0 y (transH n pH) eY (comp-idr J Z y) a0 >
          F.1.tact J I f x0 y eY a0
        =< symH (UU.tact-src-move (yP Z) F.1 J I f x0 x y (comp-idr I Z x) e eY a0) >
          F.1.tact J I f x y e (subst (Hom I Z) (\ k -> W0.Ix (F.1.tob I k)) x0 x (comp-idr I Z x) a0)
        =< apH (F.1.tact J I f x y e) (symH (UU.fib-move (Hom I Z) (F.1.tob I) x0 x (comp-idr I Z x) (Po I x) a0)) >
          F.1.tact J I f x y e (subst W0.V (\ z -> W0.Ix z) (UU.fib0 I (cY I x)) (F.1.tob I x) (Po I x) a0) }
     where {
       x0 : Hom I Z = compH I I Z x (idH I) ;
       y1 : Hom J Z = compH J I Z x (compH J J I f (idH J)) ;
       y0 : Hom J Z = compH J J Z y (idH J) ;
       n : Id (Hom J Z) (compH J I Z x0 f) y1 =
         ntEq (yP I) (yP Z) (yH I Z x) J I f (idH I) (compH J J I f (idH J)) (UU.idf-eq J I f) ;
       pH : Id (Hom J Z) y1 y0 =
         transH (apH (compH J I Z x) (comp-idr J I f)) (transH e (symH (comp-idr J Z y))) ;
       eY : Id (Hom J Z) (compH J I Z x0 f) y = transH (transH n pH) (comp-idr J Z y) ;
       e' : Id (UU.U0 J) (UU.uAct J I f (cY I x)) (cY J y) = Fam[yP Z, cY, cYnat].ep J I f x y e ;
       t : W0.Ix (F.1.tob J y1) = F.1.tact J I f x0 y1 n a0 ; } ;

    elYon : Id (PTy[yP Z]) Fam[yP Z, cY, cYnat].ElTy F.1 = TyEqPw[yP Z, Fam[yP Z, cY, cYnat].ElTy, F.1, Po, H1].tyEq ;
  } ;

  -- El does not depend on the naturality proof of the codes
  elCnat (D : PCtx) (c : (Y : Ob) -> W0.Ix (D.ob Y) -> UU.U0 Y)
    (cnat cnat' : (Y' Y : Ob) (h : Hom Y' Y) (x : W0.Ix (D.ob Y)) -> Id (UU.U0 Y') (c Y' (D.act Y' Y h x)) (UU.uAct Y' Y h (c Y x)))
    : Id (PTy[D]) Fam[D, c, cnat].ElTy Fam[D, c, cnat'].ElTy =
    ty-ext2 D Fam[D, c, cnat].ElTy Fam[D, c, cnat'].ElTy (refl (\ I x -> UU.fib0 I (c I x)))
      (\ J I f x y e b -> tactG-irr J I f (c I x) (c J y) (Fam[D, c, cnat].ep J I f x y e) (Fam[D, c, cnat'].ep J I f x y e) b) ;

  opaque elCnat ;
} ;
