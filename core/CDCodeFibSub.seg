-- Decode composition of code maps by composing the cartesian maps.
module Sub (D G : PCtx) (A : Code.C.Ty G) (s : PSub[D, G]) {
  A' : Code.C.Ty D = Code.C.subT D G A s ;
  T : PTy[G] = Code.decode G A ;
  R : PTy[D] = subTy D G T s ;
  R' : PTy[D] = Code.decode D A' ;
  module E = DB.CFibExt[a+].FX[D] ;
  module X = Decode[G, A] ;
  module Y = Decode[D, A'] ;
  module S = DB.CFibSub[a+].FibSub[D, G, s, T] ;
  module TR = P.TyL[D, R] ;

  pack : E.Pack R.tob = (R'.tact, (R'.tact-id, R'.tact-o)) ;
  act : PtEq D R.tob R.tact pack.1 = Code.action-sub D G A s ;
  nat : E.NatTy R pack = \ J I f v ->
    apH {W.Ix (R.tob J (D.act J I f v.1))} {TR.EI J} (TR.pr J (D.act J I f v.1))
      (act J I f v.1 (D.act J I f v.1) (refl (D.act J I f v.1)) v.2) ;

  module K = DB.CCartLaws2[a+, a+, a+].CC[D, R', D, R, G, T,
    \ I x -> x, \ J I f x -> refl (D.act J I f x), \ I v -> v, \ I v -> refl v.1, nat,
    \ I u v p q -> q, \ I x b -> b, \ I x b -> refl (x, b),
    s.nt, s.nt-nat, S.SE.mV, \ I v -> refl (s.nt I v.1), S.SE.mV-nat, S.SE.mV-inj, \ I x b -> b, \ I x b -> refl (s.nt I x, b)] ;

  module L = DB.CCartLaws2[a+, a+, a++].CC[D, R', G, T, B.U1, B.El1,
    K.s, K.s-nat, K.ta, K.tapt, K.tanat, K.tainj, K.bk, K.bkta,
    A.1, A.2, X.ta, \ I v -> refl (A.1 I v.1), X.tn, X.ti, \ I x b -> b, \ I x b -> refl (A.1 I x, b)] ;

  module Cong = DB.CCartLaws2[a+, a++, a++].CG[D, R', B.U1, B.El1,
    L.s, L.s-nat, L.ta, L.tapt, L.tanat, L.tainj, L.bk, L.bkta,
    A'.1, A'.2, Y.ta, \ I v -> refl (A'.1 I v.1), Y.tn, Y.ti, \ I x b -> b, \ I x b -> refl (A'.1 I x, b),
    \ I x -> refl (A'.1 I x), \ I v -> refl (Y.ta I v)] ;

  source : Type D = restrict D G s (decode G A) ;
  target : Type D = decode D A' ;

  law : Id (Type D) source target =
    transH (E.fibExt R source.2 pack act nat)
      (apH {CDName[a].Fib D R'} {Type D} (\ z -> (R', z))
        (transH (K.compFib (X.Cart.moveFib fU)) (transH (L.compFib fU) (Cong.congFib fU)))) ;

  opaque law ;
} ;
