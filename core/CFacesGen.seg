-- CFacesGen.seg (L9): faces suffice, for any presheaf on Delta
-- (localisation.tex §3; postnikov.tex, Lemma box).  A family u n f in
-- D([n]) for f : [n] -> X, natural along the face maps, is natural along
-- every strictly monotone map: such a map is the identity or misses a
-- vertex, so it factors through a face (CSimp.missing), and one recurses.
-- The combinatorics are those of CLocD.FacesGen, with D any presheaf on
-- Delta.
--
--   SG[D, X, u, fc].fg n m g s f    D.act g (u n f) = u m (f g),  g strict
--   SGB                              the same for a family given only in the
--                                    dimensions n with Ok n (Ok closed under
--                                    n+1 -> n, a proposition); SG is SGB at Top

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module DB = CDeltaBase[a].DB ;
module DP = DB.GPre[l].PS ;

module SGB (D : DP.PCtx) (X : Ob) (Ok : Nat -> U l) (okp : (n : Nat) -> Ok (suc n) -> Ok n)
  (okirr : (n : Nat) (h h' : Ok n) -> Id (Ok n) h h')
  (u : (n : Nat) -> Ok n -> Hom (lin n) X -> W0.Ix (D.ob n))
  (fc : (n : Nat) (o : Ok (suc n)) (f : Hom (lin (suc n)) X) (y : Nat) -> IsT (leb y (suc n))
        -> Id (W0.Ix (D.ob n)) (D.act n (suc n) (dl n y) (u (suc n) o f)) (u n (okp n o) (compH (lin n) (lin (suc n)) X f (dl n y)))) {
  module PD = DB.GPre[l].PshL[D] ;

  -- the vertices of a map [m] -> [n], as numbers
  module Vx (m n : Nat) (g : Hom (lin m) (lin n)) {

    aux (i : Nat) : (b : Bool) -> Id Bool (leb i m) b -> Nat = split {
      true -> \ e -> vnum (app (lin m) (lin n) g (leaf i, e)).1 ;
      false -> \ e -> zero } ;

    gam (i : Nat) : Nat = aux i (leb i m) (refl (leb i m)) ;

    aux-eq (i : Nat) (h : IsT (leb i m))
      : (b : Bool) (e : Id Bool (leb i m) b) -> Id Nat (aux i b e) (vnum (app (lin m) (lin n) g (leaf i, h)).1) = split {
      true -> \ e -> apH (\ p -> vnum (app (lin m) (lin n) g (leaf i, p)).1) (isProp-IsT' (leb i m) e h) ;
      false -> \ e -> absurd _ (false-true (transH (symH e) h)) } ;

    gam-eq (i : Nat) (h : IsT (leb i m)) : Id Nat (gam i) (vnum (app (lin m) (lin n) g (leaf i, h)).1) =
      aux-eq i h (leb i m) (refl (leb i m)) ;

    leaf-eq (i : Nat) (h : IsT (leb i m)) : Id Tree (app (lin m) (lin n) g (leaf i, h)).1 (leaf (gam i)) =
      transH (lin-leaf n (app (lin m) (lin n) g (leaf i, h)).1 (app (lin m) (lin n) g (leaf i, h)).2)
             (apH (\ k -> leaf k) (symH (gam-eq i h))) ;

    rng : Rng m n gam = \ i h ->
      substH (\ v -> IsT (leb v n)) (symH (gam-eq i h))
             (vnum-range n (app (lin m) (lin n) g (leaf i, h)).1 (app (lin m) (lin n) g (leaf i, h)).2) ;

    hi (i j : Nat) (hj : IsT (leb j m)) (l0 : IsT (ltb i j)) : IsT (leb i m) = leb-trans i j m (ltb-leb i j l0) hj ;

    str (s : Strict (lin m) (lin n) g) : Str m gam = \ i j hj l0 ->
      lt-lin (gam i) (gam j)
        (substH (\ t -> IsT (lt (lin n) t (leaf (gam j)))) (leaf-eq i (hi i j hj l0))
          (substH (\ t -> IsT (lt (lin n) (app (lin m) (lin n) g (leaf i, hi i j hj l0)).1 t)) (leaf-eq j hj)
            (s (leaf i, hi i j hj l0) (leaf j, hj) (lin-lt i j l0)))) ;

  } ;

  -- dg restricted to the vertices other than y is strict
  dg-str (n y : Nat) (hy : IsT (leb y (suc n)))
    : (t t' : Tree) (h : IsT (car (lin (suc n)) t)) (h' : IsT (car (lin (suc n)) t'))
    -> IsT (not (eqN (vnum t) y)) -> IsT (not (eqN (vnum t') y)) -> IsT (lt (lin (suc n)) t t')
    -> IsT (lt (lin n) (app (lin (suc n)) (lin n) (dgH n y) (t, h)).1 (app (lin (suc n)) (lin n) (dgH n y) (t', h')).1) = split {
    leaf j -> split {
      leaf j' -> \ h h' k k' l0 -> lin-lt (dg n y j) (dg n y j') (dg-strict n y j j' hy h' k k' (lt-lin j j' l0)) ;
      node c d -> \ h h' k k' l0 -> absurd _ (false-true h') } ;
    node s t -> \ t' h h' k k' l0 -> absurd _ (false-true h) } ;

  Goal (m n : Nat) (g : Hom (lin m) (lin n)) (f : Hom (lin n) X) (on : Ok n) (om : Ok m) : U l =
    Id (W0.Ix (D.ob m)) (D.act m n g (u n on f)) (u m om (compH (lin m) (lin n) X f g)) ;

  idcase (m' n : Nat) (f : Hom (lin n) X) (e : Id Nat m' n) (g' : Hom (lin m') (lin n))
    (p : PW (lin m') (lin n) g' (substH (\ k -> Hom (lin m') (lin k)) e (idH (lin m')))) (on : Ok n) (om : Ok m') : Goal m' n g' f on om =
    idJ Nat m' (\ k e1 -> (f1 : Hom (lin k) X) (g1 : Hom (lin m') (lin k))
                 -> PW (lin m') (lin k) g1 (substH (\ k1 -> Hom (lin m') (lin k1)) e1 (idH (lin m'))) -> (on1 : Ok k) -> Goal m' k g1 f1 on1 om)
      (\ f1 g1 p1 on1 ->
         transH (PD.actId m' g1 (hom-eq (lin m') (lin m') g1 (idH (lin m')) p1) (u m' on1 f1))
           (transH (apH (\ o -> u m' o f1) (okirr m' on1 om))
                   (apH (\ f2 -> u m' om f2)
                        (symH (transH (apH (compH (lin m') (lin m') X f1) (hom-eq (lin m') (lin m') g1 (idH (lin m')) p1))
                                      (comp-idr (lin m') X f1))))))
      n e f g' p on ;

  pw-id (m n : Nat) (g : Hom (lin m) (lin n)) (e : Id Nat m n)
    (d : (i : Nat) -> IsT (leb i m) -> Id Nat (Vx[m, n, g].gam i) i)
    : PW (lin m) (lin n) g (substH (\ k -> Hom (lin m) (lin k)) e (idH (lin m))) =
    idJ Nat m (\ k e1 -> (g1 : Hom (lin m) (lin k)) -> ((i : Nat) -> IsT (leb i m) -> Id Nat (Vx[m, k, g1].gam i) i)
                 -> PW (lin m) (lin k) g1 (substH (\ k1 -> Hom (lin m) (lin k1)) e1 (idH (lin m))))
      (\ g1 d1 -> pwl m (lin m) g1 (idH (lin m)) (\ i h -> transH (Vx[m, m, g1].leaf-eq i h)
                                        (transH (apH (\ k1 -> leaf k1) (d1 i h)) (symH (app-idH1 (lin m) (leaf i, h))))))
      n e g d ;

  g' (m n' : Nat) (g : Hom (lin m) (lin (suc n'))) (y : Nat) : Hom (lin m) (lin n') =
    compH (lin m) (lin (suc n')) (lin n') (dgH n' y) g ;

  msT (m n' : Nat) (g : Hom (lin m) (lin (suc n'))) (gam : Nat -> Nat)
    (le : (i : Nat) (h : IsT (leb i m)) -> Id Tree (app (lin m) (lin (suc n')) g (leaf i, h)).1 (leaf (gam i)))
    (y : Nat) (ms : (i : Nat) -> IsT (leb i m) -> IsT (not (eqN (gam i) y))) : Miss (lin m) n' y g =
    \ s -> aux s.1 s.2
   where { aux : (t : Tree) (h : IsT (car (lin m) t))
             -> IsT (not (eqN (vnum (app (lin m) (lin (suc n')) g (t, h)).1) y)) = split {
             leaf i -> \ h -> substH (\ t -> IsT (not (eqN (vnum t) y))) (symH (le i h)) (ms i h) ;
             node c d -> \ h -> absurd _ (false-true h) } ; } ;

  pwf (m n' : Nat) (g : Hom (lin m) (lin (suc n'))) (gam : Nat -> Nat)
    (le : (i : Nat) (h : IsT (leb i m)) -> Id Tree (app (lin m) (lin (suc n')) g (leaf i, h)).1 (leaf (gam i)))
    (y : Nat) (hy : IsT (leb y (suc n'))) (ms : (i : Nat) -> IsT (leb i m) -> IsT (not (eqN (gam i) y)))
    : PW (lin m) (lin (suc n')) (compH (lin m) (lin n') (lin (suc n')) (dl n' y) (g' m n' g y)) g =
    pw-factor (lin m) n' y g hy (msT m n' g gam le y ms) ;

  s' (m n' : Nat) (g : Hom (lin m) (lin (suc n'))) (s : Strict (lin m) (lin (suc n')) g) (gam : Nat -> Nat)
    (le : (i : Nat) (h : IsT (leb i m)) -> Id Tree (app (lin m) (lin (suc n')) g (leaf i, h)).1 (leaf (gam i)))
    (y : Nat) (hy : IsT (leb y (suc n'))) (ms : (i : Nat) -> IsT (leb i m) -> IsT (not (eqN (gam i) y)))
    : Strict (lin m) (lin n') (g' m n' g y) = \ s1 t1 l ->
    substH (\ t -> IsT (lt (lin n') t (app (lin m) (lin n') (g' m n' g y) t1).1))
           (symH (app-compH1 (lin m) (lin (suc n')) (lin n') (dgH n' y) g s1))
    (substH (\ t -> IsT (lt (lin n') (app (lin (suc n')) (lin n') (dgH n' y) (app (lin m) (lin (suc n')) g s1)).1 t))
           (symH (app-compH1 (lin m) (lin (suc n')) (lin n') (dgH n' y) g t1))
    (dg-str n' y hy (app (lin m) (lin (suc n')) g s1).1 (app (lin m) (lin (suc n')) g t1).1
      (app (lin m) (lin (suc n')) g s1).2 (app (lin m) (lin (suc n')) g t1).2
      (msT m n' g gam le y ms s1) (msT m n' g gam le y ms t1) (s s1 t1 l))) ;
  -- the type of miss at m, n: given to fgM and cases, which miss calls on n'
  -- at suc n' (its recursive result)
  MissT (m n : Nat) : U l =
    (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X) (on : Ok n) (om : Ok m)
    (gam : Nat -> Nat) (le : (i : Nat) (h : IsT (leb i m)) -> Id Tree (app (lin m) (lin n) g (leaf i, h)).1 (leaf (gam i)))
    (y : Nat) (hy : IsT (leb y n)) (ms : (i : Nat) -> IsT (leb i m) -> IsT (not (eqN (gam i) y)))
    -> Goal m n g f on om ;

  cases (n m : Nat) (mi : MissT m n) (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X) (on : Ok n) (om : Ok m)
    : Arith[a].Plus (IsId m n Vx[m, n, g].gam) (Misses m n Vx[m, n, g].gam) -> Goal m n g f on om = split {
    inl d -> idcase m n f d.1 g (pw-id m n g d.1 d.2) on om ;
    inr w -> mi g s f on om Vx[m, n, g].gam Vx[m, n, g].leaf-eq w.1 w.2.1 w.2.2 } ;

  fgM (n m : Nat) (mi : MissT m n) (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X) (on : Ok n) (om : Ok m)
    : Goal m n g f on om =
    cases n m mi g s f on om (missing n m Vx[m, n, g].gam Vx[m, n, g].rng (Vx[m, n, g].str s)) ;

  miss (m : Nat) : (n : Nat) (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X) (on : Ok n) (om : Ok m)
    (gam : Nat -> Nat) (le : (i : Nat) (h : IsT (leb i m)) -> Id Tree (app (lin m) (lin n) g (leaf i, h)).1 (leaf (gam i)))
    (y : Nat) (hy : IsT (leb y n)) (ms : (i : Nat) -> IsT (leb i m) -> IsT (not (eqN (gam i) y)))
    -> Goal m n g f on om = split {
    zero -> \ g s f on om gam le y hy ms ->
      absurd _ (false-true (substH (\ w -> IsT (not (eqN zero w))) (leb-zero y hy)
                             (substH (\ v -> IsT (not (eqN v y)))
                                (leb-zero (gam zero)
                                   (substH (\ t -> IsT (car (lin zero) t)) (le zero (refl true))
                                           (app (lin m) (lin zero) g (leaf zero, refl true)).2))
                                (ms zero (refl true))))) ;
    suc n' | ih-n' -> \ g s f on om gam le y hy ms ->
      transH (symH (PD.actEq m (suc n') (compH (lin m) (lin n') (lin (suc n')) (dl n' y) (g' m n' g y)) g
                      (hom-eq (lin m) (lin (suc n')) (compH (lin m) (lin n') (lin (suc n')) (dl n' y) (g' m n' g y)) g (pwf m n' g gam le y hy ms))
                      (u (suc n') on f)))
       (transH (D.act-o m n' (suc n') (dl n' y) (g' m n' g y) (u (suc n') on f))
        (transH (apH (D.act m n' (g' m n' g y)) (fc n' on f y hy))
         (transH (fgM n' m ih-n' (g' m n' g y) (s' m n' g s gam le y hy ms) (compH (lin n') (lin (suc n')) X f (dl n' y)) (okp n' on) om)
          (transH (apH (\ f2 -> u m om f2) (comp-assoc (lin m) (lin n') (lin (suc n')) X f (dl n' y) (g' m n' g y)))
                 (apH (\ f2 -> u m om f2)
                      (hom-eq (lin m) X _ _
                         (pw-post (lin m) (lin (suc n')) X (compH (lin m) (lin n') (lin (suc n')) (dl n' y) (g' m n' g y)) g f
                                  (pwf m n' g gam le y hy ms)))))))) } ;

  fg (n m : Nat) (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X) (on : Ok n) (om : Ok m) : Goal m n g f on om =
    fgM n m (miss m n) g s f on om ;
} ;

------------------------------------------------------------------------
-- with no bound

module SG (D : DP.PCtx) (X : Ob) (u : (n : Nat) -> Hom (lin n) X -> W0.Ix (D.ob n))
  (fc : (n : Nat) (f : Hom (lin (suc n)) X) (y : Nat) -> IsT (leb y (suc n))
        -> Id (W0.Ix (D.ob n)) (D.act n (suc n) (dl n y) (u (suc n) f)) (u n (compH (lin n) (lin (suc n)) X f (dl n y)))) {
  module B = SGB[D, X, \ n -> Top, \ n o -> o, \ n -> isTop, \ n o f -> u n f, \ n o f y hy -> fc n f y hy] ;

  fg (n m : Nat) (g : Hom (lin m) (lin n)) (s : Strict (lin m) (lin n) g) (f : Hom (lin n) X)
    : Id (W0.Ix (D.ob m)) (D.act m n g (u n f)) (u m (compH (lin m) (lin n) X f g)) = B.fg n m g s f tt tt ;
} ;
