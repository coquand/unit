-- CSmallFull1.seg (L6, inside CB, any classifier): (C2), part 1 (model.tex
-- Construction "universal univalence datum" (C2)); any classifier.  At a point y of GD
-- full at the identity, with B's code Fb at the identity:
--
--   Kb      the cart from Fb.1 into BU over g |-> y g (fibre maps: the
--           Yoneda transport, then along the code path bmap (y g) = Fb g)
--   Po1     Fb's fibres are those of the small Ext along yhat y (the
--           Yoneda path, the code path, PDU, extOb-B)
--   P3      read in Ext_U, the transport along Po1 is Kb followed by fromB
--   tyEq    hence Fb.1 = xsub yhat SA (its action: Ext_U's cart is
--           injective)
--
-- Quarry: seg/model GUaFullT, GUaFullL1.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;
open GYon[a] ;
open Encode[a, a+] ;

module F1 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx,
                                    CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  (W : Ob) (y : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 W)
  (q : IsT (CGlueD.fl W y.1.2.1 W (idH W))) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module XS = CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  module YG = CYonCart.YC[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E3u = CExt3[a+].ExtB3[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU] ;
  module Sub = CFibSub[a+].FibSub[UB.CU.resCtx, UU.UCtx, UB.bmap, UU.EGen] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  RES : L.PCtx = UB.CU.resCtx ;

  -- B's code at the identity
  Fb : UU.U0 W = y.1.2.2.1 W (idH W) q ;
  module Y = YG.Yc[W, Fb] ;
  module TF = GPR.TyL[yP W, Fb.1] ;

  -- the small Ext along the Yoneda map of y
  l : CSmall.XSub[yP W, UB.GDr] = UB.yhat W y ;
  T : PTy[yP W] = CSmall.xsub (yP W) UB.GDr XS.SA l ;
  module TT = GPR.TyL[yP W, T] ;

  eW : IsT (UB.CU.full W y) = substH (\ R -> IsT (allS W R)) (pre-id W y.1.2.1) q ;

  cW : Id (UU.U0 W) (UB.bmap.nt W (y, eW)) Fb =
    apH (y.1.2.2.1 W (idH W)) (isProp-IsT' (CGlueD.fl W y.1.2.1 W (idH W)) (UB.qU W y eW) q) ;

  ----------------------------------------------------------------------
  -- the cart Kb : Fb.1 -> BU over g |-> y g

  sb (V : Ob) (g : Hom V W) : V1.Ix (RES.ob V) = RES.act V W g (y, eW) ;

  sb-nat (V' V : Ob) (k : Hom V' V) (g : Hom V W) : Id (V1.Ix (RES.ob V')) (sb V' (compH V' V W g k)) (RES.act V' V k (sb V g)) =
    RES.act-o V' V W g k (y, eW) ;

  -- the codes along sb are Fb's
  cc (V : Ob) (g : Hom V W) : Id (UU.U0 V) (UB.bmap.nt V (sb V g)) (UU.uAct V W g Fb) =
    transH (UB.bmap.nt-nat V W g (y, eW)) (apH (UU.uAct V W g) cW) ;

  trU (V : Ob) (F F' : UU.U0 V) (p : Id (UU.U0 V) F F') (z : W0.Ix (UU.fib0 V F)) : W0.Ix (UU.fib0 V F') =
    subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F F' p z ;

  trU-round (V : Ob) (F F' : UU.U0 V) (p : Id (UU.U0 V) F F') (z : W0.Ix (UU.fib0 V F'))
    : Id (W0.Ix (UU.fib0 V F')) (trU V F F' p (trU V F' F (symH p) z)) z =
    idJ (UU.U0 V) F (\ F2 p2 -> (z2 : W0.Ix (UU.fib0 V F2)) -> Id (W0.Ix (UU.fib0 V F2)) (trU V F F2 p2 (trU V F2 F (symH p2) z2)) z2)
      (\ z2 -> refl z2) F' p z ;

  kb (V : Ob) (g : Hom V W) (b : W0.Ix (Fb.1.tob V g)) : W0.Ix (UU.fib0 V (UB.bmap.nt V (sb V g))) =
    trU V (UU.uAct V W g Fb) (UB.bmap.nt V (sb V g)) (symH (cc V g)) (Y.ta V (g, b)).2 ;

  module TBU = LP.TyL[RES, UB.BU] ;

  tb (V : Ob) (v : TF.EI V) : TBU.EI V = (sb V v.1, kb V v.1 v.2) ;

  -- Kb read in El is the Yoneda cart
  P5 (V : Ob) (v : TF.EI V) : Id (YG.TE.EI V) (Sub.SE.mV V (tb V v)) (Y.ta V v) =
    YG.pairE V (UB.bmap.nt V (sb V v.1)) (UU.uAct V W v.1 Fb) (cc V v.1) (kb V v.1 v.2) (Y.ta V v).2
      (trU-round V (UB.bmap.nt V (sb V v.1)) (UU.uAct V W v.1 Fb) (cc V v.1) (Y.ta V v).2) ;

  tbnat (V' V : Ob) (k : Hom V' V) (v : TF.EI V) : Id (TBU.EI V') (TBU.E.act V' V k (tb V v)) (tb V' (TF.E.act V' V k v)) =
    Sub.SE.mV-inj V' (TBU.E.act V' V k (tb V v)) (tb V' (TF.E.act V' V k v)) (symH (sb-nat V' V k v.1))
      (transH (symH (Sub.SE.mV-nat V' V k (tb V v)))
        (transH (apH (YG.TE.E.act V' V k) (P5 V v))
          (transH (Y.tanat V' V k v) (symH (P5 V' (TF.E.act V' V k v)))))) ;

  tbinj (V : Ob) (v v' : TF.EI V) (P : Id (Hom V W) v.1 v'.1) (Q : Id (TBU.EI V) (tb V v) (tb V v')) : Id (TF.EI V) v v' =
    Y.tainj V v v' P (transH (symH (P5 V v)) (transH (apH (Sub.SE.mV V) Q) (P5 V v'))) ;

  bkb (X : Ob) (g : Hom X W) (u : W0.Ix (UU.fib0 X (UB.bmap.nt X (sb X g)))) : W0.Ix (Fb.1.tob X g) =
    Y.bk X g (trU X (UB.bmap.nt X (sb X g)) (UU.uAct X W g Fb) (cc X g) u) ;

  bkbta (X : Ob) (g : Hom X W) (u : W0.Ix (UU.fib0 X (UB.bmap.nt X (sb X g)))) : Id (TBU.EI X) (tb X (g, bkb X g u)) (sb X g, u) =
    Sub.SE.mV-inj X (tb X (g, bkb X g u)) (sb X g, u) (refl (sb X g))
      (transH (P5 X (g, bkb X g u))
        (transH (Y.bkta X g (trU X (UB.bmap.nt X (sb X g)) (UU.uAct X W g Fb) (cc X g) u))
          (symH (YG.pairE X (UB.bmap.nt X (sb X g)) (UU.uAct X W g Fb) (cc X g) u
                   (trU X (UB.bmap.nt X (sb X g)) (UU.uAct X W g Fb) (cc X g) u) (refl (trU X (UB.bmap.nt X (sb X g)) (UU.uAct X W g Fb) (cc X g) u)))))) ;

  opaque P5 ; opaque tbnat ; opaque tbinj ; opaque bkbta ;
} ;
