-- The seeded operation in the existing Side interface, and its conversion
-- to the algebra interface used by the truncation recursor.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ;

module Seeded (G : PCtx) (B : PTy[G]) {
  open PR.TyL[G,B] ; module P = CP.Partials[G,B] ;
  record Op {
    kop (X : Ob) (x : Pt X) (u : T X x) (s : P.Side[X,x]) : T X x ;
    kside (X : Ob) (x : Pt X) (u : T X x) (s : P.Side[X,x])
      (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h) :
      Id (EI Y) (E.act Y X h (x,kop X x u s)) (s.pv Y h i) ;
    kunif (Y X : Ob) (h : Hom Y X) (x : Pt X) (u : T X x) (s : P.Side[X,x]) :
      Id (EI Y) (E.act Y X h (x,kop X x u s))
        (G.act Y X h x,kop Y (G.act Y X h x)
          (B.tact Y X h x (G.act Y X h x) (refl (G.act Y X h x)) u) (P.rside Y X h x s)) ;
  } ;
  module Laws (k : Op) {
    cong (X : Ob) (x x' : Pt X) (p : Id (Pt X) x x') (u : T X x) (u' : T X x')
      (q : Id (EI X) (x,u) (x',u')) (s : P.Side[X,x]) (s' : P.Side[X,x'])
      (e : Id (P.Side[X,x']) (substH (\ y -> P.Side[X,y]) p s) s') :
      Id (EI X) (x,k.kop X x u s) (x',k.kop X x' u' s') =
      idJ (Pt X) x (\ y py -> (v : T X y) -> Id (EI X) (x,u) (y,v) -> (r : P.Side[X,y]) ->
        Id (P.Side[X,y]) (substH (\ y' -> P.Side[X,y']) py s) r ->
        Id (EI X) (x,k.kop X x u s) (y,k.kop X y v r))
        (\ v pv r er -> trans (EI X) (x,k.kop X x u s) (x,k.kop X x v s) (x,k.kop X x v r)
          (apH (\ b -> (x,k.kop X x b s)) (pr-inj X x u v pv))
          (apH (\ side -> (x,k.kop X x v side)) er)) x' p u' q s' e ;
    opaque cong ;
  } ;

  module Algebra (k : Op) {
    open CTruncRaw[a,l].Build[G,B] ;
    module K = CTruncAlg[a,l].Algebras[G,B] ;
    module L = Laws[k] ;
    module Side (z : Loc) (Q : PB.Phi z.1) (v : K.Partial z Q) (vn : K.Natural z Q v) {
      pv (Y : Ob) (h : Hom Y z.1) (i : PB.Lands Y z.1 Q h) : EI Y =
        (G.act Y z.1 h z.2,v (Y,G.act Y z.1 h z.2) (h,refl (G.act Y z.1 h z.2)) i) ;
      any (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) :
        Id (EI s.1) (s.2,v s h i) (pv s.1 h.1 i) =
        idJ (Pt s.1) (G.act s.1 z.1 h.1 z.2)
          (\ y e -> Id (EI s.1) (y,v (s.1,y) (h.1,e) i) (pv s.1 h.1 i))
          (refl (pv s.1 h.1 i)) s.2 h.2 ;
      pn (Z Y : Ob) (g : Hom Z Y) (h : Hom Y z.1) (i : PB.Lands Y z.1 Q h)
        (j : PB.Lands Z z.1 Q (compH Z Y z.1 h g)) :
        Id (EI Z) (E.act Z Y g (pv Y h i)) (pv Z (compH Z Y z.1 h g) j) =
        transH (pr-tact Z Y g (G.act Y z.1 h z.2) (G.act Z z.1 (compH Z Y z.1 h g) z.2)
          (symH (G.act-o Z Y z.1 h g z.2)) (pv Y h i).2)
          (apH {T Z (G.act Z z.1 (compH Z Y z.1 h g) z.2)} {EI Z} (\ b -> (G.act Z z.1 (compH Z Y z.1 h g) z.2,b))
            (transH (vn (Y,G.act Y z.1 h z.2) (h,refl (G.act Y z.1 h z.2)) i
              (Z,G.act Z z.1 (compH Z Y z.1 h g) z.2) (g,symH (G.act-o Z Y z.1 h g z.2)) j)
              (K.partial-cong z Q v (Z,G.act Z z.1 (compH Z Y z.1 h g) z.2)
                (compose (Z,G.act Z z.1 (compH Z Y z.1 h g) z.2) (Y,G.act Y z.1 h z.2) z
                  (h,refl (G.act Y z.1 h z.2)) (g,symH (G.act-o Z Y z.1 h g z.2)))
                (compH Z Y z.1 h g,refl (G.act Z z.1 (compH Z Y z.1 h g) z.2))
                (arr-eq (Z,G.act Z z.1 (compH Z Y z.1 h g) z.2) z _ _ (refl (compH Z Y z.1 h g))) j j))) ;
      opaque any ; opaque pn ;
      side : P.Side[z.1,z.2] = new P.Side[z.1,z.2,Q,pv,\ Y h i -> refl (G.act Y z.1 h z.2),pn] ;
    } ;
    extend (z : Loc) (Q : PB.Phi z.1) (u : K.F z) (v : K.Partial z Q) (vn : K.Natural z Q v) : K.F z =
      k.kop z.1 z.2 u Side[z,Q,v,vn].side ;
    boundary (z : Loc) (Q : PB.Phi z.1) (u : K.F z) (v : K.Partial z Q) (vn : K.Natural z Q v)
      (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) :
      Id (K.F s) (K.act s z h (extend z Q u v vn)) (v s h i) =
      pr-inj s.1 s.2 _ _ (transH (symH (pr-tact s.1 z.1 h.1 z.2 s.2 h.2 (extend z Q u v vn)))
        (transH (k.kside z.1 z.2 u Side[z,Q,v,vn].side s.1 h.1 i) (symH (Side[z,Q,v,vn].any s h i)))) ;
    module Uniform (z : Loc) (Q : PB.Phi z.1) (u : K.F z) (v : K.Partial z Q) (vn : K.Natural z Q v)
      (s : Loc) (h : Arr s z) {
      module S0 = Side[z,Q,v,vn] ;
      module S1 = Side[s,PB.pre s.1 z.1 h.1 Q,K.rv z Q v s h,K.rvn z Q v vn s h] ;
      veq (Y : Ob) (g : Hom Y s.1) (i j : PB.Lands Y s.1 S1.side.pQ g) :
        Id (EI Y) (S0.pv Y (compH Y s.1 z.1 h.1 g) i) (S1.pv Y g j) =
        transH (P.pv-irr z.1 z.2 S0.side Y (compH Y s.1 z.1 h.1 g) i j)
          (symH (S0.any (Y,G.act Y s.1 g s.2)
            (compose (Y,G.act Y s.1 g s.2) s z h (g,refl (G.act Y s.1 g s.2))) j)) ;
      seq : Id (P.Side[s.1,s.2])
        (substH (\ x -> P.Side[s.1,x]) h.2 (P.rside s.1 z.1 h.1 z.2 S0.side)) S1.side =
        P.side-extH s.1 (G.act s.1 z.1 h.1 z.2) s.2 h.2 (P.rside s.1 z.1 h.1 z.2 S0.side) S1.side (refl S1.side.pQ) veq ;
      result : Id (K.F s) (K.act s z h (extend z Q u v vn))
        (extend s S1.side.pQ (K.act s z h u) (K.rv z Q v s h) (K.rvn z Q v vn s h)) =
        pr-inj s.1 s.2 _ _ (transH (symH (pr-tact s.1 z.1 h.1 z.2 s.2 h.2 (extend z Q u v vn)))
          (transH (k.kunif s.1 z.1 h.1 z.2 u S0.side)
            (L.cong s.1 (G.act s.1 z.1 h.1 z.2) s.2 h.2 _ _
              (pr-tact s.1 z.1 h.1 z.2 s.2 h.2 u) _ S1.side seq))) ;
    } ;
    algebra : K.Algebra = new K.Algebra[extend,boundary,\ z Q u v vn s h -> Uniform[z,Q,u,v,vn,s,h].result] ;
  } ;
  module RoundTrip (k : CTruncAlg[a,l].Algebras[G,B].Algebra) {
    open CTruncRaw[a,l].Build[G,B] ;
    module K = CTruncAlg[a,l].Algebras[G,B] ;
    module F = CTruncSeeded[a,l].FromAlgebra[G,B,B,k] ;
    op : Op = new Op[F.kop,F.kside,F.kunif] ;
    module Back = Algebra[op] ;
    module At (z : Loc) (Q : PB.Phi z.1) (u : K.F z) (v : K.Partial z Q) (vn : K.Natural z Q v) {
      module S0 = Back.Side[z,Q,v,vn] ;
      module S1 = F.Side[z.1,z.2,S0.side] ;
      values : Id (K.Partial z Q) S1.pv v =
        funext Loc (\ s -> (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> K.F s) S1.pv v (\ s ->
        funext (Arr s z) (\ h -> PB.Lands s.1 z.1 Q h.1 -> K.F s) (S1.pv s) (v s) (\ h ->
        funext (PB.Lands s.1 z.1 Q h.1) (\ i -> K.F s) (S1.pv s h) (v s h) (\ i ->
          pr-inj s.1 s.2 _ _ (transH (S1.pv-eq s h i) (symH (S0.any s h i)))))) ;
      result : Id (K.F z) (Back.algebra.extend z Q u v vn) (k.extend z Q u v vn) =
        K.ext-cong k z Q u u (refl u) S1.pv v values S1.pn vn ;
      opaque result ;
    } ;
  } ;
} ;
