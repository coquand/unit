-- CDElHorn.seg (L8, Delta): seg/model DElHorn.seg ported (module names; the code's operation is a COp operation).  Was: El of the universe of Delta has a horn filling operation
-- (cours6: "pour montrer que T A est fibrant, on doit utiliser isFib").
-- A code F = (A , c) in U0 [n] is a type A over y[n] with a horn filling
-- operation c; the fibre of El at F is A at the identity.  A horn of El at
-- F is read as a horn of A at the identity (toA: the fibre of El at
-- uAct f F is A at f id, moved to f), c fills it, and the filler is the
-- extension.
--
--   zE / toA      the fibres of El over F, read in A
--   zE-act        they commute with the actions (El's action is A's, read
--                 at the identity: GUniv.tactG, substF, fib-move)
--   elFib         the horn filling operation of El (level a+)
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
module DU = CDeltaCl[a].DU ;
module YO = DB.GYon[a] ;

module EH (n : Nat) (F : DU.U0 n) {
  module TA = DB.GPre[a].TyL[YO.yP n, F.1] ;
  module TE = DB.GPre[a+].TyL[DU.UCtx, DU.EGen] ;

  -- the fibre of El at w (lying over uAct f F), as an element of A
  zE (W : Nat) (f : Hom (lin W) (lin n)) (w : TE.EI W) (ew : Id (DU.U0 W) w.1 (DU.uAct W n f F)) : TA.EI W =
    ((YO.yH W n f).nt W (idH (lin W)), subst (DU.U0 W) (\ G -> W0.Ix (DU.fib0 W G)) w.1 (DU.uAct W n f F) ew w.2) ;

  -- at the point (yP n) f id
  toA (W : Nat) (f : Hom (lin W) (lin n)) (w : TE.EI W) (ew : Id (DU.U0 W) w.1 (DU.uAct W n f F)) : TA.EI W =
    ((YO.yP n).act W n f (idH (lin n)),
     TA.coeT W ((YO.yH W n f).nt W (idH (lin W))) ((YO.yP n).act W n f (idH (lin n))) (symH (DU.idf-eq W n f)) (zE W f w ew).2) ;

  toA-E (W : Nat) (f : Hom (lin W) (lin n)) (w : TE.EI W) (ew : Id (DU.U0 W) w.1 (DU.uAct W n f F))
    : Id (TA.EI W) (toA W f w ew) (zE W f w ew) =
    symH (TA.pr-coe W ((YO.yH W n f).nt W (idH (lin W))) ((YO.yP n).act W n f (idH (lin n))) (symH (DU.idf-eq W n f)) (zE W f w ew).2) ;

  -- (f g) id and f (g id)
  pfg (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin n))
    : Id (Hom (lin V) (lin n)) ((YO.yH W n f).nt V ((YO.yH V W g).nt V (idH (lin V)))) ((YO.yH V n (compH (lin V) (lin W) (lin n) f g)).nt V (idH (lin V))) =
    symH (comp-assoc (lin V) (lin V) (lin W) (lin n) f g (idH (lin V))) ;

  -- the base case of zE-act: w = (uAct f F , z)
  zE-act0 (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin n)) (z : W0.Ix (DU.fib0 W (DU.uAct W n f F)))
    (ew' : Id (DU.U0 V) (TE.E.act V W g (DU.uAct W n f F, z)).1 (DU.uAct V n (compH (lin V) (lin W) (lin n) f g) F))
    : Id (TA.EI V) (TA.E.act V W g (zE W f (DU.uAct W n f F, z) (refl (DU.uAct W n f F))))
                   (zE V (compH (lin V) (lin W) (lin n) f g) (TE.E.act V W g (DU.uAct W n f F, z)) ew') =
    calc (TA.EI V) {
        TA.E.act V W g ((YO.yH W n f).nt W (idH (lin W)), z)
      =< TA.pr-tact V W g ((YO.yH W n f).nt W (idH (lin W))) ((YO.yH W n f).nt V ((YO.yH V W g).nt V (idH (lin V))))
           (DB.GPre[a].PS.ntEq (YO.yP W) (YO.yP n) (YO.yH W n f) V W g (idH (lin W)) ((YO.yH V W g).nt V (idH (lin V))) (DU.idf-eq V W g)) z >
        ((YO.yH W n f).nt V ((YO.yH V W g).nt V (idH (lin V))), (TE.E.act V W g (DU.uAct W n f F, z)).2)
      =< TA.pr-coe V ((YO.yH W n f).nt V ((YO.yH V W g).nt V (idH (lin V)))) ((YO.yH V n (compH (lin V) (lin W) (lin n) f g)).nt V (idH (lin V)))
           (pfg V W g f) (TE.E.act V W g (DU.uAct W n f F, z)).2 >
        ((YO.yH V n (compH (lin V) (lin W) (lin n) f g)).nt V (idH (lin V)),
         subst (Hom (lin V) (lin n)) (\ x -> W0.Ix (F.1.tob V x)) ((YO.yH W n f).nt V ((YO.yH V W g).nt V (idH (lin V)))) ((YO.yH V n (compH (lin V) (lin W) (lin n) f g)).nt V (idH (lin V))) (pfg V W g f) (TE.E.act V W g (DU.uAct W n f F, z)).2)
      =< apH {W0.Ix (DU.fib0 V (DU.uAct V n (compH (lin V) (lin W) (lin n) f g) F))} {TA.EI V}
           (\ q -> ((YO.yH V n (compH (lin V) (lin W) (lin n) f g)).nt V (idH (lin V)), q))
           (symH (transH (DU.substF V (TE.E.act V W g (DU.uAct W n f F, z)).1 (DU.uAct V n (compH (lin V) (lin W) (lin n) f g) F) ew'
                            (TE.E.act V W g (DU.uAct W n f F, z)).2)
                         (DU.fib-move (Hom (lin V) (lin n)) (F.1.tob V) ((YO.yH W n f).nt V ((YO.yH V W g).nt V (idH (lin V)))) ((YO.yH V n (compH (lin V) (lin W) (lin n) f g)).nt V (idH (lin V))) (pfg V W g f) (ap (DU.U0 V) W0.V (DU.fib0 V) (TE.E.act V W g (DU.uAct W n f F, z)).1 (DU.uAct V n (compH (lin V) (lin W) (lin n) f g) F) ew') (TE.E.act V W g (DU.uAct W n f F, z)).2))) >
        zE V (compH (lin V) (lin W) (lin n) f g) (TE.E.act V W g (DU.uAct W n f F, z)) ew' } ;

  -- zE does not depend on the proof that w lies over uAct f F (U0 is a set)
  zE-irr (W : Nat) (f : Hom (lin W) (lin n)) (w : TE.EI W) (ew ew' : Id (DU.U0 W) w.1 (DU.uAct W n f F))
    : Id (TA.EI W) (zE W f w ew) (zE W f w ew') =
    apH (zE W f w) (V1.isSetIx (DU.codeU W) w.1 (DU.uAct W n f F) ew ew') ;

  zE-wcong (W : Nat) (f : Hom (lin W) (lin n)) (w w' : TE.EI W) (P : Id (TE.EI W) w w')
    (ew : Id (DU.U0 W) w.1 (DU.uAct W n f F)) (ew' : Id (DU.U0 W) w'.1 (DU.uAct W n f F))
    : Id (TA.EI W) (zE W f w ew) (zE W f w' ew') =
    idJ (TE.EI W) w (\ w2 P2 -> (ew2 : Id (DU.U0 W) w2.1 (DU.uAct W n f F)) -> Id (TA.EI W) (zE W f w ew) (zE W f w2 ew2))
      (\ ew2 -> zE-irr W f w ew ew2) w' P ew' ;

  -- the fibres of El commute with the actions
  zE-act (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin n)) (w : TE.EI W) (ew : Id (DU.U0 W) w.1 (DU.uAct W n f F))
    (ew' : Id (DU.U0 V) (TE.E.act V W g w).1 (DU.uAct V n (compH (lin V) (lin W) (lin n) f g) F))
    : Id (TA.EI V) (TA.E.act V W g (zE W f w ew)) (zE V (compH (lin V) (lin W) (lin n) f g) (TE.E.act V W g w) ew') =
    transH (apH (TA.E.act V W g) (zE-irr W f (w.1, w.2) ew (symH (symH ew))))
      (idJ (DU.U0 W) (DU.uAct W n f F)
         (\ G e -> (z : W0.Ix (DU.fib0 W G)) (e2 : Id (DU.U0 V) (TE.E.act V W g (G, z)).1 (DU.uAct V n (compH (lin V) (lin W) (lin n) f g) F))
            -> Id (TA.EI V) (TA.E.act V W g (zE W f (G, z) (symH e))) (zE V (compH (lin V) (lin W) (lin n) f g) (TE.E.act V W g (G, z)) e2))
         (\ z e2 -> zE-act0 V W g f z e2)
         w.1 (symH ew) w.2 ew') ;

  -- subst along a path is injective
  subst-inj (W : Nat) (G G' : DU.U0 W) (e : Id (DU.U0 W) G G') (u v : W0.Ix (DU.fib0 W G))
    (Q : Id (W0.Ix (DU.fib0 W G')) (subst (DU.U0 W) (\ H -> W0.Ix (DU.fib0 W H)) G G' e u) (subst (DU.U0 W) (\ H -> W0.Ix (DU.fib0 W H)) G G' e v))
    : Id (W0.Ix (DU.fib0 W G)) u v =
    idJ (DU.U0 W) G
      (\ G2 e2 -> Id (W0.Ix (DU.fib0 W G2)) (subst (DU.U0 W) (\ H -> W0.Ix (DU.fib0 W H)) G G2 e2 u) (subst (DU.U0 W) (\ H -> W0.Ix (DU.fib0 W H)) G G2 e2 v)
                   -> Id (W0.Ix (DU.fib0 W G)) u v)
      (\ Q2 -> Q2) G' e Q ;

  -- zE is injective on the fibres
  zE-inj (W : Nat) (f : Hom (lin W) (lin n)) (w w' : TE.EI W) (P : Id (DU.U0 W) w.1 w'.1)
    (ew : Id (DU.U0 W) w.1 (DU.uAct W n f F)) (ew' : Id (DU.U0 W) w'.1 (DU.uAct W n f F))
    (Q : Id (TA.EI W) (zE W f w ew) (zE W f w' ew')) : Id (TE.EI W) w w' =
    idJ (DU.U0 W) w.1
      (\ G2 P2 -> (b2 : W0.Ix (DU.fib0 W G2)) (ew2 : Id (DU.U0 W) G2 (DU.uAct W n f F))
         -> Id (TA.EI W) (zE W f w ew) (zE W f (G2, b2) ew2) -> Id (TE.EI W) w (G2, b2))
      (\ b2 ew2 Q2 -> apH {W0.Ix (DU.fib0 W w.1)} {TE.EI W} (\ z -> (w.1, z))
         (subst-inj W w.1 (DU.uAct W n f F) ew w.2 b2
            (transH (TA.pr-inj W ((YO.yH W n f).nt W (idH (lin W))) _ _ (transH Q2 (zE-irr W f (w.1, b2) ew2 ew)))
                    (refl (subst (DU.U0 W) (\ H -> W0.Ix (DU.fib0 W H)) w.1 (DU.uAct W n f F) ew b2)))))
      w'.1 P w'.2 ew' Q ;
} ;

------------------------------------------------------------------------
-- the horn filling operation of El

module HE (m : Nat) (F : DU.U0 (suc m)) {
  module E = EH[suc m, F] ;
  module HA = CDHornFib[a, a].DH[YO.yP (suc m), F.1] ;
  module HEl = CDHornFib[a, a+].DH[DU.UCtx, DU.EGen] ;

  -- a horn of El at F, read in A at the identity
  hA (k : Nat) (h : HEl.HornData m k F) : HA.HornData m k (idH (lin (suc m))) =
    (\ W f i -> E.toA W f (h.1 W f i) (h.2.1 W f i),
     (\ W f i -> refl ((YO.yP (suc m)).act W (suc m) f (idH (lin (suc m)))),
      \ W' W chi f i i' ->
        calc (E.TA.EI W') {
            E.TA.E.act W' W chi (E.toA W f (h.1 W f i) (h.2.1 W f i))
          =< apH (E.TA.E.act W' W chi) (E.toA-E W f (h.1 W f i) (h.2.1 W f i)) >
            E.TA.E.act W' W chi (E.zE W f (h.1 W f i) (h.2.1 W f i))
          =< E.zE-act W' W chi f (h.1 W f i) (h.2.1 W f i) (ew' W' W chi f i) >
            E.zE W' (compH (lin W') (lin W) (lin (suc m)) f chi) (E.TE.E.act W' W chi (h.1 W f i)) (ew' W' W chi f i)
          =< E.zE-wcong W' (compH (lin W') (lin W) (lin (suc m)) f chi) _ _ (h.2.2 W' W chi f i i') (ew' W' W chi f i) (h.2.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i') >
            E.zE W' (compH (lin W') (lin W) (lin (suc m)) f chi) (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')
              (h.2.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')
          =< symH (E.toA-E W' (compH (lin W') (lin W) (lin (suc m)) f chi) (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')
                     (h.2.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')) >
            E.toA W' (compH (lin W') (lin W) (lin (suc m)) f chi) (h.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i')
              (h.2.1 W' (compH (lin W') (lin W) (lin (suc m)) f chi) i') }))
   where {
     ew' (W' W : Nat) (chi : Hom (lin W') (lin W)) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (CDeltaCl[a].hornS m k) f)
       : Id (DU.U0 W') (E.TE.E.act W' W chi (h.1 W f i)).1 (DU.uAct W' (suc m) (compH (lin W') (lin W) (lin (suc m)) f chi) F) =
       transH (apH (DU.uAct W' W chi) (h.2.1 W f i)) (symH (DU.uAct-o W' W (suc m) f chi F)) ; } ;

  module X (k : Nat) (hk : IsT (leb k (suc m))) (h : HEl.HornData m k F) {
    ex : HA.Ext m k (idH (lin (suc m))) (hA k h) = F.2 (m, k) hk (idH (lin (suc m))) (hA k h) ;

    cond (W : Nat) (f : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (CDeltaCl[a].hornS m k) f)
      : Id (E.TE.EI W) (E.TE.E.act W (suc m) f (F, ex.1)) (h.1 W f i) =
      E.zE-inj W f (E.TE.E.act W (suc m) f (F, ex.1)) (h.1 W f i) (symH (h.2.1 W f i))
        (refl (DU.uAct W (suc m) f F)) (h.2.1 W f i)
        (calc (E.TA.EI W) {
            E.zE W f (E.TE.E.act W (suc m) f (F, ex.1)) (refl (DU.uAct W (suc m) f F))
          =< symH (E.TA.pr-tact W (suc m) f (idH (lin (suc m))) ((YO.yH W (suc m) f).nt W (idH (lin W))) (DU.idf-eq W (suc m) f) ex.1) >
            E.TA.E.act W (suc m) f (idH (lin (suc m)), ex.1)
          =< ex.2 W f i >
            E.toA W f (h.1 W f i) (h.2.1 W f i)
          =< E.toA-E W f (h.1 W f i) (h.2.1 W f i) >
            E.zE W f (h.1 W f i) (h.2.1 W f i) }) ;

    res : HEl.Ext m k F h = (ex.1, cond) ;
  } ;
} ;

elFib : CDHornFib[a, a+].DH[DU.UCtx, DU.EGen].isFib = \ m k hk F h -> HE[m, F].X[k, hk, h].res ;
