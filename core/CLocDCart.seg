-- CLocDCart.seg (L9): D preserves cartesian maps (localisation.tex §3).
-- A cartesian map A' -> A over s : D -> G (CCart: a map of totals over s,
-- injective over equal points, with a lift back of its fibres; D and G at
-- their own levels) gives one D A' -> D A over s, whose fibre maps send the
-- values through the given one, transported along the naturality of s.
--
--   DK.fw, DK.bw    the fibre maps; fw-rd, bw-rd their values
--   DK.C            the cart (CCart.Cart): moveFib moves a fibration of DA
--                   to one of DA'
-- Instances: substitution D(A[s]) -> DA (ta = SubE.mV, as for Pi,
-- CPiCart), and El along a code map (CSmall.SmallFib.C), in CLocDUniv.

level a k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module P0 = PB.GPre[k] ;
module P1 = PB.GPre[l] ;

module DK (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s V (D.act V W g d)) (G.act V W g (s W d)))
  (ta : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta W v).1 (s W v.1))
  (tanat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta W v)) (ta V (P1.TyL[D, A'].E.act V W g v)))
  (tainj : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (ta W v) (ta W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bk : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> W1.Ix (A'.tob X x))
  (bkta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> Id (P0.TyL[G, A].EI X) (ta X (x, bk X x u)) (s X x, u)) {
  module DG = CLocD[a, k].DT[G, A] ;
  module DD = CLocD[a, l].DT[D, A'] ;
  module TA = P0.TyL[G, A] ;
  module TA' = P1.TyL[D, A'] ;
  module TDG = P0.TyL[G, DG.DA] ;
  module TDD = P1.TyL[D, DD.DA] ;
  module PD = P1.PshL[D] ;

  -- the forward fibre map
  fw (X : Ob) (x : W1.Ix (D.ob X)) (u : DD.Fam X x) : DG.Fam X (s X x) =
    \ n f -> TA.fromE (lin n) (G.act (lin n) X f (s X x)) (ta (lin n) (DD.rd X x u n f))
               (transH (tapt (lin n) (DD.rd X x u n f)) (s-nat (lin n) X f x)) ;

  fw-rd (X : Ob) (x : W1.Ix (D.ob X)) (u : DD.Fam X x) (n : Nat) (f : Hom (lin n) X)
    : Id (TA.EI (lin n)) (DG.rd X (s X x) (fw X x u) n f) (ta (lin n) (DD.rd X x u n f)) =
    TA.fromE-eq (lin n) (G.act (lin n) X f (s X x)) (ta (lin n) (DD.rd X x u n f))
      (transH (tapt (lin n) (DD.rd X x u n f)) (s-nat (lin n) X f x)) ;

  fw-compat (X : Ob) (x : W1.Ix (D.ob X)) (u : DD.DEl X x) : DG.Compat X (s X x) (fw X x u.1) =
    \ m n g st f -> calc (TA.EI (lin m)) {
        TA.E.act (lin m) (lin n) g (DG.rd X (s X x) (fw X x u.1) n f)
      =< apH (TA.E.act (lin m) (lin n) g) (fw-rd X x u.1 n f) >
        TA.E.act (lin m) (lin n) g (ta (lin n) (DD.rd X x u.1 n f))
      =< tanat (lin m) (lin n) g (DD.rd X x u.1 n f) >
        ta (lin m) (TA'.E.act (lin m) (lin n) g (DD.rd X x u.1 n f))
      =< apH (ta (lin m)) (u.2 m n g st f) >
        ta (lin m) (DD.rd X x u.1 m (compH (lin m) (lin n) X f g))
      =< symH (fw-rd X x u.1 m (compH (lin m) (lin n) X f g)) >
        DG.rd X (s X x) (fw X x u.1) m (compH (lin m) (lin n) X f g) } ;

  fwD (X : Ob) (x : W1.Ix (D.ob X)) (u : DD.DEl X x) : DG.DEl X (s X x) = (fw X x u.1, fw-compat X x u) ;

  -- the backward fibre map
  bw (X : Ob) (x : W1.Ix (D.ob X)) (c : DG.Fam X (s X x)) : DD.Fam X x =
    \ n f -> bk (lin n) (D.act (lin n) X f x)
               (TA.coeT (lin n) (G.act (lin n) X f (s X x)) (s (lin n) (D.act (lin n) X f x)) (symH (s-nat (lin n) X f x)) (c n f)) ;

  bw-rd (X : Ob) (x : W1.Ix (D.ob X)) (c : DG.Fam X (s X x)) (n : Nat) (f : Hom (lin n) X)
    : Id (TA.EI (lin n)) (ta (lin n) (DD.rd X x (bw X x c) n f)) (DG.rd X (s X x) c n f) =
    transH (bkta (lin n) (D.act (lin n) X f x)
              (TA.coeT (lin n) (G.act (lin n) X f (s X x)) (s (lin n) (D.act (lin n) X f x)) (symH (s-nat (lin n) X f x)) (c n f)))
      (symH (TA.pr-coe (lin n) (G.act (lin n) X f (s X x)) (s (lin n) (D.act (lin n) X f x)) (symH (s-nat (lin n) X f x)) (c n f))) ;

  bw-compat (X : Ob) (x : W1.Ix (D.ob X)) (c : DG.DEl X (s X x)) : DD.Compat X x (bw X x c.1) =
    \ m n g st f -> tainj (lin m) (TA'.E.act (lin m) (lin n) g (DD.rd X x (bw X x c.1) n f)) (DD.rd X x (bw X x c.1) m (compH (lin m) (lin n) X f g))
      (PD.actC (lin m) (lin n) X f g x)
      (calc (TA.EI (lin m)) {
          ta (lin m) (TA'.E.act (lin m) (lin n) g (DD.rd X x (bw X x c.1) n f))
        =< symH (tanat (lin m) (lin n) g (DD.rd X x (bw X x c.1) n f)) >
          TA.E.act (lin m) (lin n) g (ta (lin n) (DD.rd X x (bw X x c.1) n f))
        =< apH (TA.E.act (lin m) (lin n) g) (bw-rd X x c.1 n f) >
          TA.E.act (lin m) (lin n) g (DG.rd X (s X x) c.1 n f)
        =< c.2 m n g st f >
          DG.rd X (s X x) c.1 m (compH (lin m) (lin n) X f g)
        =< symH (bw-rd X x c.1 m (compH (lin m) (lin n) X f g)) >
          ta (lin m) (DD.rd X x (bw X x c.1) m (compH (lin m) (lin n) X f g)) }) ;

  bwD (X : Ob) (x : W1.Ix (D.ob X)) (c : DG.DEl X (s X x)) : DD.DEl X x = (bw X x c.1, bw-compat X x c) ;

  ----------------------------------------------------------------------
  -- totals

  rdG (W : Ob) (q : TDG.EI W) (n : Nat) (f : Hom (lin n) W) : TA.EI (lin n) = DG.rd W q.1 q.2.1 n f ;
  rdD (W : Ob) (q : TDD.EI W) (n : Nat) (f : Hom (lin n) W) : TA'.EI (lin n) = DD.rd W q.1 q.2.1 n f ;

  extG (W : Ob) (q q' : TDG.EI W) (P : Id (W0.Ix (G.ob W)) q.1 q'.1)
    (R : (n : Nat) (f : Hom (lin n) W) -> Id (TA.EI (lin n)) (rdG W q n f) (rdG W q' n f)) : Id (TDG.EI W) q q' =
    idJ (W0.Ix (G.ob W)) q.1
      (\ p2 P2 -> (a2 : DG.DEl W p2) -> ((n : Nat) (f : Hom (lin n) W) -> Id (TA.EI (lin n)) (rdG W q n f) (DG.rd W p2 a2.1 n f))
         -> Id (TDG.EI W) q (p2, a2))
      (\ a2 R2 -> apH {DG.DEl W q.1} {TDG.EI W} (\ a3 -> (q.1, a3)) (DG.Dext W q.1 q.2 a2 R2))
      q'.1 P q'.2 R ;

  extD (W : Ob) (q q' : TDD.EI W) (P : Id (W1.Ix (D.ob W)) q.1 q'.1)
    (R : (n : Nat) (f : Hom (lin n) W) -> Id (TA'.EI (lin n)) (rdD W q n f) (rdD W q' n f)) : Id (TDD.EI W) q q' =
    idJ (W1.Ix (D.ob W)) q.1
      (\ p2 P2 -> (a2 : DD.DEl W p2) -> ((n : Nat) (f : Hom (lin n) W) -> Id (TA'.EI (lin n)) (rdD W q n f) (DD.rd W p2 a2.1 n f))
         -> Id (TDD.EI W) q (p2, a2))
      (\ a2 R2 -> apH {DD.DEl W q.1} {TDD.EI W} (\ a3 -> (q.1, a3)) (DD.Dext W q.1 q.2 a2 R2))
      q'.1 P q'.2 R ;

  tD (W : Ob) (v : TDD.EI W) : TDG.EI W = (s W v.1, fwD W v.1 v.2) ;

  tDpt (W : Ob) (v : TDD.EI W) : Id (W0.Ix (G.ob W)) (tD W v).1 (s W v.1) = refl (s W v.1) ;

  -- the values of tD v are those of v, through ta
  tD-rd (W : Ob) (v : TDD.EI W) (n : Nat) (f : Hom (lin n) W) : Id (TA.EI (lin n)) (rdG W (tD W v) n f) (ta (lin n) (rdD W v n f)) =
    fw-rd W v.1 v.2.1 n f ;

  tDnat (V W : Ob) (g : Hom V W) (v : TDD.EI W) : Id (TDG.EI V) (TDG.E.act V W g (tD W v)) (tD V (TDD.E.act V W g v)) =
    extG V (TDG.E.act V W g (tD W v)) (tD V (TDD.E.act V W g v)) (symH (s-nat V W g v.1))
      (\ n f -> calc (TA.EI (lin n)) {
          rdG V (TDG.E.act V W g (tD W v)) n f
        =< DG.rd-dtact V W g (s W v.1) (G.act V W g (s W v.1)) (refl (G.act V W g (s W v.1))) (fwD W v.1 v.2) n f >
          DG.rd W (s W v.1) (fw W v.1 v.2.1) n (compH (lin n) V W g f)
        =< fw-rd W v.1 v.2.1 n (compH (lin n) V W g f) >
          ta (lin n) (DD.rd W v.1 v.2.1 n (compH (lin n) V W g f))
        =< symH (apH (ta (lin n)) (DD.rd-dtact V W g v.1 (D.act V W g v.1) (refl (D.act V W g v.1)) v.2 n f)) >
          ta (lin n) (rdD V (TDD.E.act V W g v) n f)
        =< symH (fw-rd V (TDD.E.act V W g v).1 (TDD.E.act V W g v).2.1 n f) >
          rdG V (tD V (TDD.E.act V W g v)) n f }) ;

  tDinj (W : Ob) (v v' : TDD.EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (TDG.EI W) (tD W v) (tD W v')) : Id (TDD.EI W) v v' =
    extD W v v' P (\ n f -> tainj (lin n) (rdD W v n f) (rdD W v' n f) (apH (D.act (lin n) W f) P)
      (transH (symH (fw-rd W v.1 v.2.1 n f)) (transH (apH (\ q -> rdG W q n f) Q) (fw-rd W v'.1 v'.2.1 n f)))) ;

  bkD (X : Ob) (x : W1.Ix (D.ob X)) (c : DG.DEl X (s X x)) : DD.DEl X x = bwD X x c ;

  bkDta (X : Ob) (x : W1.Ix (D.ob X)) (c : DG.DEl X (s X x)) : Id (TDG.EI X) (tD X (x, bkD X x c)) (s X x, c) =
    extG X (tD X (x, bkD X x c)) (s X x, c) (refl (s X x))
      (\ n f -> transH (fw-rd X x (bw X x c.1) n f) (bw-rd X x c.1 n f)) ;

  opaque fw-rd ; opaque fw-compat ; opaque bw-rd ; opaque bw-compat ;
  opaque extG ; opaque extD ; opaque tD-rd ; opaque tDnat ; opaque tDinj ; opaque bkDta ;

  module C = PB.CCart[k, l].Cart[D, DD.DA, G, DG.DA, s, s-nat, tD, tDpt, tDnat, tDinj, bkD, bkDta] ;
} ;
