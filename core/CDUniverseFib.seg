-- El1 is fibrant, and its structure restricts to the structure of El0.
level a ;
open Base ;
open Prelude[a++] ;
module B = CDUniverseBase[a] ;
module I = CDUniverseLift[a] ;
module C = CDUniverseCart[a] ;
module H = CDUniverseHorn[a] ;
module U0 = B.DC.DU ;
module U1 = B.Univ ;

module Along = M.CDHornNat[a, a+, a++].Along[U0.UCtx, U0.EGen, B.U1, B.El1,
  I.inc, I.include-nat, C.ta, \ W z -> refl (I.inc W z.1), C.tn, C.ti,
  \ W x b -> b, \ W x b -> refl (C.G.pr W (I.inc W x) b), I.include-inj] ;

module F = Along.CDHornNormal.Normal[H.h0, H.h1, \ m k hk x y q u v r -> H.At[m, k, hk, x, u].image y q v r] ;

fib0 : B.DB.CLine[a+].Lines[U0.UCtx, U0.EGen].Fib = M.Classical.CDeltaElFib[a].elFibD ;
fib1 : B.DB.CLine[a++].Lines[B.U1, B.El1].Fib =
  M.Classical.CDeltaHornToFib[a, a++].hornToFib B.U1 B.El1 H.h1 ;

restrict-fib : Id (B.DB.CLine[a+].Lines[U0.UCtx, U0.EGen].Fib) fib0 (Along.C.moveFib fib1) = F.nat ;
