-- CDNormE.seg (L8, Delta): seg/model DNormE.seg ported (module names only).  Was: the normalised fillers are UNIFORM along every map of Delta,
-- hence a filling structure (FibAt e, family path object).
--
--   u-id / u-face / u-deg   uniformity along the identity, a face (A), an
--                           elementary degeneracy (B)
--   u-comp, u-eq            along composites, along equal maps
--   unif                    every h : [Y] -> [X], by induction on Y + X
--                           (DFactor: identity, d_y (s_y h), (h d_j) s_j)
--   fibAt                   FibAt e: the extension of partial lines,
--                           kside (DNormD.sidesK) and kunif (unif)
--
-- Constructive (the decision deg is a parameter).

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
open CDSimpId[a] ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
open CDCapBase[a] ;
open CDFactor[a] ;
open CDCapT[a] ;

module NE (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))
  (deg : (N : Nat) (b : CDStageA[a, lz].SA[G, A, e].Prob (suc N)) -> CDNormA[a, lz].NA[G, A, e].DegFound N b) {
  module NDm = CDNormD[a, lz].ND[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0, deg] ;
  open NDm ;
  open CDStageA[a, lz].SA[G, A, e] ;
  open CDNormA[a, lz].NA[G, A, e] ;

  UAtH (Y X : Nat) (h : Hom (lin Y) (lin X)) (b : Prob X) : U lz =
    Id (KA.TS.EI Y) (fillE Y (K Y) (resP Y X h b)) (KA.TS.E.act Y X h (fillE X (K X) b)) ;

  UnifT (Y X : Nat) : U lz = (h : Hom (lin Y) (lin X)) (b : Prob X) -> UAtH Y X h b ;

  u-eq (Y X : Nat) (h h' : Hom (lin Y) (lin X)) (E : Id (Hom (lin Y) (lin X)) h' h) (b : Prob X) (u : UAtH Y X h' b) : UAtH Y X h b =
    subst (Hom (lin Y) (lin X)) (\ k -> UAtH Y X k b) h' h E u ;

  u-id (X : Nat) (b : Prob X) : UAtH X X (idH (lin X)) b =
    transH (fill-cong X (K X) (resP X X (idH (lin X)) b) b (resP-id X b)) (symH (KA.TS.E.act-id X (fillE X (K X) b))) ;

  u-face (X' y : Nat) (hy : IsT (leb y (suc X'))) (b : Prob (suc X')) : UAtH X' (suc X') (dl X' y) b = symH (faceK X' b y hy) ;

  u-deg (Y' j : Nat) (hj : IsT (leb j Y')) (c : Prob Y') : UAtH (suc Y') Y' (dgH Y' j) c = degK Y' c j hj ;

  u-comp (Y Z X : Nat) (h1 : Hom (lin Y) (lin Z)) (h2 : Hom (lin Z) (lin X)) (b : Prob X)
    (u1 : UAtH Y Z h1 (resP Z X h2 b)) (u2 : UAtH Z X h2 b) : UAtH Y X (compH (lin Y) (lin Z) (lin X) h2 h1) b =
    calc (KA.TS.EI Y) {
        fillE Y (K Y) (resP Y X (compH (lin Y) (lin Z) (lin X) h2 h1) b)
      =< fill-cong Y (K Y) (resP Y X (compH (lin Y) (lin Z) (lin X) h2 h1) b) (resP Y Z h1 (resP Z X h2 b)) (resP-o Y Z X h1 h2 b) >
        fillE Y (K Y) (resP Y Z h1 (resP Z X h2 b))
      =< u1 >
        KA.TS.E.act Y Z h1 (fillE Z (K Z) (resP Z X h2 b))
      =< apH (KA.TS.E.act Y Z h1) u2 >
        KA.TS.E.act Y Z h1 (KA.TS.E.act Z X h2 (fillE X (K X) b))
      =< KA.TS.PE.actC Y Z X h2 h1 (fillE X (K X) b) >
        KA.TS.E.act Y X (compH (lin Y) (lin Z) (lin X) h2 h1) (fillE X (K X) b) } ;

  ----------------------------------------------------------------------
  -- the induction on Y + X

  -- the identity, up to the dimension
  u-isid (Y X : Nat) (E : Id Nat Y X) : (h : Hom (lin Y) (lin X)) -> ((i : Nat) -> IsT (leb i Y) -> Id Nat (valT Y X h i) i)
    -> (b : Prob X) -> UAtH Y X h b =
    idJ Nat Y (\ X2 E2 -> (h : Hom (lin Y) (lin X2)) -> ((i : Nat) -> IsT (leb i Y) -> Id Nat (valT Y X2 h i) i) -> (b : Prob X2) -> UAtH Y X2 h b)
      (\ h v b -> u-eq Y Y h (idH (lin Y)) (symH (idVal Y h v)) b (u-id Y b)) X E ;

  IH (n : Nat) : U lz = (Y X : Nat) -> IsT (ltb (plus Y X) n) -> UnifT Y X ;

  -- h injective, into [0]: the identity
  zeroCase (Y : Nat) (h : Hom (lin Y) (lin zero)) (b : Prob zero)
    : Arith[a].Plus (IsId Y zero (valT Y zero h)) (Misses Y zero (valT Y zero h)) -> UAtH Y zero h b = split {
    inl w -> u-isid Y zero w.1 h w.2 b ;
    inr w -> absurd _ (contra (valT Y zero h zero) w.1 (w.2.2 zero (refl true))
                          (transH (leb-zero (valT Y zero h zero) (valT-range Y zero h zero)) (symH (leb-zero w.1 w.2.1)))) } ;

  -- h injective, into [X'+1]: the identity, or through a face
  sucCase (n : Nat) (ih : IH n) (Y X' : Nat) (le : IsT (leb (plus Y (suc X')) n)) (h : Hom (lin Y) (lin (suc X'))) (b : Prob (suc X'))
    : Arith[a].Plus (IsId Y (suc X') (valT Y (suc X') h)) (Misses Y (suc X') (valT Y (suc X') h)) -> UAtH Y (suc X') h b = split {
    inl w -> u-isid Y (suc X') w.1 h w.2 b ;
    inr w -> u-eq Y (suc X') h (compH (lin Y) (lin X') (lin (suc X')) (dl X' w.1) (compH (lin Y) (lin (suc X')) (lin X') (dgH X' w.1) h))
                (faceFac Y X' w.1 w.2.1 h (CDeltaNat[a].fa-i Y (\ v -> not (eqN (valT Y (suc X') h v) w.1)) w.2.2)) b
                (u-comp Y X' (suc X') (compH (lin Y) (lin (suc X')) (lin X') (dgH X' w.1) h) (dl X' w.1) b
                   (ih Y X' (substH (\ z -> IsT (leb z n)) (plus-suc Y X') le) (compH (lin Y) (lin (suc X')) (lin X') (dgH X' w.1) h)
                      (resP X' (suc X') (dl X' w.1) b))
                   (u-face X' w.1 w.2.1 b)) } ;

  strictPath (n : Nat) (ih : IH n) (Y : Nat) : (X : Nat) -> IsT (leb (plus Y X) n) -> (h : Hom (lin Y) (lin X))
    -> Str Y (valT Y X h) -> (b : Prob X) -> UAtH Y X h b = split {
    zero -> \ le h str b -> zeroCase Y h b (missing zero Y (valT Y zero h) (\ i hi -> valT-range Y zero h i) str) ;
    suc X' -> \ le h str b -> sucCase n ih Y X' le h b (missing (suc X') Y (valT Y (suc X') h) (\ i hi -> valT-range Y (suc X') h i) str) } ;

  str0 (X : Nat) (h : Hom (lin zero) (lin X)) : Str zero (valT zero X h) = \ i j hj lt ->
    absurd _ (false-true (leb-trans (suc i) j zero lt hj)) ;

  body (n : Nat) (ih : IH n) : (Y X : Nat) -> IsT (leb (plus Y X) n) -> UnifT Y X = split {
    zero -> \ X le h b -> strictPath n ih zero X le h (str0 X h) b ;
    suc Y' -> \ X le h b ->
      bcaseL (UAtH (suc Y') X h b) (strictB Y' X h)
        (\ t -> strictPath n ih (suc Y') X le h (strict-Str Y' X h t) b)
        (\ nf -> u-eq (suc Y') X h
                   (compH (lin (suc Y')) (lin Y') (lin X) (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' (notStrict Y' X h nf).1)) (dgH Y' (notStrict Y' X h nf).1))
                   (degFac Y' X h (notStrict Y' X h nf).1 (notStrict Y' X h nf).2.1 (notStrict Y' X h nf).2.2) b
                   (u-comp (suc Y') Y' X (dgH Y' (notStrict Y' X h nf).1) (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' (notStrict Y' X h nf).1)) b
                      (u-deg Y' (notStrict Y' X h nf).1 (notStrict Y' X h nf).2.1 (resP Y' X (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' (notStrict Y' X h nf).1)) b))
                      (ih Y' X le (compH (lin Y') (lin (suc Y')) (lin X) h (dl Y' (notStrict Y' X h nf).1)) b))) } ;

  unifS : (n : Nat) -> IH n = split {
    zero -> \ Y X lt -> absurd _ (false-true lt) ;
    suc n | ih-n -> \ Y X lt -> body n (ih-n) Y X lt } ;

  unif (Y X : Nat) : UnifT Y X = unifS (suc (plus Y X)) Y X (leb-refl (plus Y X)) ;

  ----------------------------------------------------------------------
  -- the filling structure

  fibAt : DB.CLine[lz].Lines[G, A].Fill e =
    new DB.CPartial[lz].Rel[KA.TV.E, KA.SFm.SF, KA.SFm.SF, DB.CPartial[lz].pmap-id KA.TV.E KA.SFm.SF].RC[\ X x p -> K X (x, p),
                      \ X x p W f i -> sidesK X (x, p) W f i,
                      \ Y X h x p -> symH (unif Y X h (x, p))] ;
} ;
