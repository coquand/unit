-- SAG section 8.3: the underlying presheaf construction for truncation,
-- inside the poset model.  The constructors are inc and seeded ext, with
-- boundary and naturality laws and a natural recursor into seeded extension
-- algebras.  CTruncFinal supplies paths between every pair of elements.
--
-- CTruncElimProp supplies dependent elimination into arbitrary fibrant
-- families of internal propositions, with an inc computation rule.
-- CTruncUnique supplies algebra initiality.
-- Scope: composition on truncation and substitution stability of the type
-- construction remain unproved.  This is not yet a complete CwF former.
-- All definitions are library terms; the prototype has no new primitives.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module Truncation (G : PCtx) (A : PTy[G]) {
  open CTruncRaw[a, l].Build[G, A] ;
  open CTruncGood[a, l].GoodSets[G, A] ;
  module T = CTruncType[a, l].Trunc[G, A] ;
  module O = CTruncExt[a, l].Ops[G, A] ;
  module N = CTruncNat[a, l].Nat[G, A] ;
  Ty : PTy[G] = T.truncTy ;
  inclusion : HO.NMap[G, A, Ty] = new HO.NMap[G, A, Ty,
    \ X x v -> inc (X,x) v, \ Y X h x y e v -> T.inc-nat Y X h x y e v] ;
  module K = CTruncAlg[a, l].Algebras[G,Ty] ;
  extend (z : Loc) (Q : PB.Phi z.1) (u : TrEl z) (v : K.Partial z Q) (vn : K.Natural z Q v) : TrEl z =
    O.Extend[z, Q, u, v, vn].value ;
  boundary (z : Loc) (Q : PB.Phi z.1) (u : TrEl z) (v : K.Partial z Q) (vn : K.Natural z Q v)
    (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1)
    : Id (TrEl s) (tr-res s z h (extend z Q u v vn)) (v s h i) =
    O.Extend[z, Q, u, v, vn].boundary s h i ;
  uniform (z : Loc) (Q : PB.Phi z.1) (u : TrEl z) (v : K.Partial z Q) (vn : K.Natural z Q v)
    (s : Loc) (h : Arr s z) : Id (TrEl s) (tr-res s z h (extend z Q u v vn))
    (extend s (PB.pre s.1 z.1 h.1 Q) (tr-res s z h u) (K.rv z Q v s h) (K.rvn z Q v vn s h)) =
    transH N.Restrict[z, Q, u, v, vn, s, h].uniform
      (tr-eq s _ _ (refl N.Restrict[z, Q, u, v, vn, s, h].F.tree)) ;
  opaque boundary ; opaque uniform ;
  algebra : K.Algebra = new K.Algebra[extend, boundary, uniform] ;

  module Recursor (B : PTy[G]) (k : CTruncAlg[a, l].Algebras[G,B].Algebra) (f : HO.NMap[G, A, B]) {
    ff (z : Loc) (v : W.Ix (A.tob z.1 z.2)) : W.Ix (B.tob z.1 z.2) = f.nfun z.1 z.2 v ;
    fn (s z : Loc) (h : Arr s z) (v : W.Ix (A.tob z.1 z.2)) :
      Id (W.Ix (B.tob s.1 s.2)) (B.tact s.1 z.1 h.1 z.2 s.2 h.2 (ff z v))
        (ff s (A.tact s.1 z.1 h.1 z.2 s.2 h.2 v)) = f.nnat s.1 z.1 h.1 z.2 s.2 h.2 v ;
    module R = CTruncRec[a, l].Rec[G, A, B, k, ff, fn] ;
    module Beta = CTruncRecExt[a, l].Beta[G, A, B, k, ff, fn] ;
    map : HO.NMap[G, Ty, B] = new HO.NMap[G, Ty, B, \ X x t -> R.rec (X,x) t,
      \ Y X h x y e t -> R.rec-nat (Y,y) (X,x) (h,e) t] ;
    beta-inc (z : Loc) (v : W.Ix (A.tob z.1 z.2)) :
      Id (W.Ix (B.tob z.1 z.2)) (map.nfun z.1 z.2 (inc z v)) (f.nfun z.1 z.2 v) = R.rec-inc z v ;
  } ;
} ;
