-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- Extension operations transfer across a homotopy retraction when the
-- target has composition.  Used for the D-modal conclusion of Thm 12.3.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ; module HO = PB.CHtpyOps[l] ; module CL = PB.CLine[l] ;

module Map (G : PCtx) (A B : PTy[G]) (f : HO.NMap[G, A, B]) {
  module TA = PR.TyL[G, A] ; module TB = PR.TyL[G, B] ;
  module PA = CP.Partials[G, A] ; module PB' = CP.Partials[G, B] ;
  onE (X : Ob) (u : TA.EI X) : TB.EI X = (u.1, f.nfun X u.1 u.2) ;
  act (Y X : Ob) (h : Hom Y X) (u : TA.EI X) : Id (TB.EI Y) (TB.E.act Y X h (onE X u)) (onE Y (TA.E.act Y X h u)) =
    apH {TB.T Y (G.act Y X h u.1)} {TB.EI Y} (\ b -> (G.act Y X h u.1,b))
      (f.nnat Y X h u.1 (G.act Y X h u.1) (refl (G.act Y X h u.1)) u.2) ;
  pmap : CP.PMap[G, A, B] = new CP.PMap[G, A, B, onE, \ X u -> refl u.1, \ Y X h u -> symH (act Y X h u)] ;
  side (X : Ob) (x : TA.Pt X) (s : PA.Side[X,x]) : PB'.Side[X,x] =
    new PB'.Side[X,x,s.pQ, \ Y h i -> onE Y (s.pv Y h i), s.ppt,
      \ Z Y g h i j -> transH (act Z Y g (s.pv Y h i)) (apH (onE Z) (s.pnat Z Y g h i j))] ;
  side-res (Y X : Ob) (h : Hom Y X) (x : TA.Pt X) (s : PA.Side[X,x]) :
    Id (PB'.Side[Y,G.act Y X h x]) (PB'.rside Y X h x (side X x s)) (side Y (G.act Y X h x) (PA.rside Y X h x s)) =
    PB'.side-ext Y (G.act Y X h x) _ _ (refl (PB.pre Y X h s.pQ))
      (\ Z g i j -> apH (onE Z) (PA.pv-irr X x s Z (compH Z Y X h g) i j)) ;
  opaque act ; opaque side-res ;
}
;

module Relative (G : PCtx) (A B : PTy[G]) (f : HO.NMap[G,A,B]) (g : HO.NMap[G,B,A]) (k : CP.ContrOp G B) {
  module F = Map[G,A,B,f] ; module Gm = Map[G,B,A,g] ;
  module M = Map[G,A,A,HO.compN G A B A f g] ;
  module R = CP.Rel[G,A,A,M.pmap] ; module RB = CP.Rel[G,B,B,CP.pmap-id G B] ;
  module TA = F.TA ; module TB = F.TB ; module P = F.PA ;
  kop (X : Ob) (x : TA.Pt X) (s : P.Side[X,x]) : TA.T X x = g.nfun X x (k.kop X x (F.side X x s)) ;
  kside (X : Ob) (x : TA.Pt X) (s : P.Side[X,x]) (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h)
    : Id (TA.EI Y) (TA.E.act Y X h (x,kop X x s)) (M.onE Y (s.pv Y h i)) =
    transH (Gm.act Y X h (x,k.kop X x (F.side X x s))) (apH (Gm.onE Y) (k.kside X x (F.side X x s) Y h i)) ;
  kunif (Y X : Ob) (h : Hom Y X) (x : TA.Pt X) (s : P.Side[X,x]) :
    Id (TA.EI Y) (TA.E.act Y X h (x,kop X x s)) (G.act Y X h x,kop Y (G.act Y X h x) (P.rside Y X h x s)) =
    transH (Gm.act Y X h (x,k.kop X x (F.side X x s)))
      (apH (Gm.onE Y) (transH (k.kunif Y X h x (F.side X x s))
        (apH {F.PB'.Side[Y,G.act Y X h x]} {TB.EI Y} (\ t -> (G.act Y X h x,k.kop Y (G.act Y X h x) t)) (F.side-res Y X h x s)))) ;
  extension : R.RC = new R.RC[kop,kside,kunif] ;
} ;

-- Correct the extension of m(s) to an extension of s, using the homotopy
-- m ~ id on the side as the wall of a composition problem.
module Correct (G : PCtx) (A : PTy[G]) (m : HO.NMap[G,A,A])
  (k : CP.Rel[G,A,A,Map[G,A,A,m].pmap].RC)
  (H : PEl[extP G A, HO.HT[G,A,A,m,HO.idN G A].PT.PathP])
  (c : CL.Lines[G,A].CompK[e0,e1].Comp) {
  module TA = PR.TyL[G,A] ; open TA ;
  module P = CP.Partials[G,A] ; module M = Map[G,A,A,m] ;
  module HT = HO.HT[G,A,A,m,HO.idN G A] ;
  module FG = CL.FC[G] ; module FA = CL.FT[G,A] ;
  module EK = CL.EndKit[G,A,e0] ; module EK' = CL.EndKit[G,A,e1] ;
  module CK = CL.Lines[G,A].CompK[e0,e1] ; module TT = CK.SE.TS ;
  module RC = CP.Rel[EK.TV.E,EK.SFm.SF,CK.Tend,CK.endL] ;

  module Problem (X : Ob) (x : Pt X) (s : P.Side[X,x]) {
    start : EI X = (x,k.kop X x s) ;
    w : EK.TV.EI X = (FG.constF X x,fromE X (G.act X X (idH X) x) start (symH (G.act-id X x))) ;
    w-E : Id (EI X) (EK.endE X w) start = fromE-eq X (G.act X X (idH X) x) start (symH (G.act-id X x)) ;
    t (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f) (Z : Ob) (g : Hom Z Y) (j : Hom Z Iv) : EI Z = HT.pv H Y (s.pv Y f i) Z g j ;
    tp (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f) (Z : Ob) (g : Hom Z Y) (j : Hom Z Iv)
      : Id (Pt Z) (t Y f i Z g j).1 ((FG.actF Y X f w.1).1 Z g j) =
      transH ((H.eob Y (s.pv Y f i)).2.1 Z g j)
        (transH (apH (G.act Z Y g) (s.ppt Y f i)) (symH (G.act-o Z Y X f g x))) ;
    tn (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f) (Z' Z : Ob) (g' : Hom Z' Z) (g : Hom Z Y) (j : Hom Z Iv)
      : Id (EI Z') (E.act Z' Z g' (t Y f i Z g j)) (t Y f i Z' (compH Z' Z Y g g') (compH Z' Z Iv j g')) =
      (H.eob Y (s.pv Y f i)).1.2 Z' Z g' g j ;
    t0 (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f)
      : Id (EI Y) (t Y f i Y (idH Y) (PB.ptH Y e0)) (EK.endE Y (EK.TV.E.act Y X f w)) =
      transH (H.eob Y (s.pv Y f i)).2.2.1
        (transH (symH (k.kside X x s Y f i))
          (transH (apH (E.act Y X f) (symH w-E)) (symH (EK.endE-act Y X f w)))) ;
    tr (Y' Y : Ob) (h : Hom Y' Y) (f : Hom Y X) (i : PB.Lands Y X s.pQ f) (i' : PB.Lands Y' X s.pQ (compH Y' Y X f h))
      (Z : Ob) (g : Hom Z Y') (j : Hom Z Iv)
      : Id (EI Z) (t Y' (compH Y' Y X f h) i' Z g j) (t Y f i Z (compH Z Y' Y h g) j) =
      symH (HT.pv-res H Y' Y h (s.pv Y f i) (s.pv Y' (compH Y' Y X f h) i') (s.pnat Y' Y h f i i') Z g j) ;
    module LS = PB.CLineSide[l].LineSide[G,A,e0,X,w,s.pQ,t,tp,tn,t0,tr] ;
    out : TT.EI X = (w,c.kop X w LS.side) ;
  } ;

  rd (X : Ob) (v : TT.EI X) : EI X = EK'.endE X (CK.SE.mV X v) ;
  rd-act (Y X : Ob) (h : Hom Y X) (v : TT.EI X) : Id (EI Y) (rd Y (TT.E.act Y X h v)) (E.act Y X h (rd X v)) =
    transH (apH (EK'.endE Y) (symH (CK.SE.mV-nat Y X h v))) (EK'.endE-act Y X h (CK.SE.mV X v)) ;
  kop (X : Ob) (x : Pt X) (s : P.Side[X,x]) : T X x = fromE X x (rd X Problem[X,x,s].out) (G.act-id X x) ;
  kop-E (X : Ob) (x : Pt X) (s : P.Side[X,x]) : Id (EI X) (x,kop X x s) (rd X Problem[X,x,s].out) =
    fromE-eq X x (rd X Problem[X,x,s].out) (G.act-id X x) ;
  kside (X : Ob) (x : Pt X) (s : P.Side[X,x]) (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f) :
    Id (EI Y) (E.act Y X f (x,kop X x s)) (s.pv Y f i) =
    transH (apH (E.act Y X f) (kop-E X x s))
      (transH (symH (rd-act Y X f Problem[X,x,s].out))
        (transH (apH (rd Y) (c.kside X Problem[X,x,s].w Problem[X,x,s].LS.side Y f i))
          (transH (FA.Ev[e1].endB-E Y (EK.lineL Y (Problem[X,x,s].LS.sv Y f i)))
            (transH (Problem[X,x,s].LS.sv-val Y f i Y (idH Y) (PB.ptH Y e1)) (H.eob Y (s.pv Y f i)).2.2.2)))) ;

  module Uniform (Y X : Ob) (h : Hom Y X) (x : Pt X) (s : P.Side[X,x]) {
    module P0 = Problem[X,x,s] ;
    module P1 = Problem[Y,G.act Y X h x,P.rside Y X h x s] ;
    wp : Id (EK.TV.EI Y) (EK.TV.E.act Y X h P0.w) P1.w =
      EK.tv-eq Y _ _
        (FG.fam-eq Y _ _ (\ Z f j -> G.act-o Z Y X h f x))
        (transH (EK.endE-act Y X h P0.w)
          (transH (apH (E.act Y X h) P0.w-E)
            (transH (k.kunif Y X h x s) (symH P1.w-E)))) ;
    vp (Z : Ob) (f : Hom Z Y) (i j : PB.Lands Z X s.pQ (compH Z Y X h f))
      : Id (EK.TS.EI Z) (P0.LS.sv Z (compH Z Y X h f) i) (P1.LS.sv Z f j) =
      EK.ts-ext Z _ _
        (transH (P0.LS.sv-pt Z (compH Z Y X h f) i)
          (transH (EK.TV.E.act-o Z Y X h f P0.w)
            (transH (apH (EK.TV.E.act Z Y f) wp) (symH (P1.LS.sv-pt Z f j)))))
        (\ V g r -> transH (P0.LS.sv-val Z (compH Z Y X h f) i V g r)
          (transH (apH (\ v -> HT.pv H Z v V g r) (P.pv-irr X x s Z (compH Z Y X h f) i j))
            (symH (P1.LS.sv-val Z f j V g r)))) ;
    sd : Id (EK.PT.Side[Y,P1.w])
      (substH (\ w -> EK.PT.Side[Y,w]) wp (EK.PT.rside Y X h P0.w P0.LS.side)) P1.LS.side =
      EK.PT.side-extH Y (EK.TV.E.act Y X h P0.w) P1.w wp
        (EK.PT.rside Y X h P0.w P0.LS.side) P1.LS.side (refl (PB.pre Y X h s.pQ)) vp ;
    out-nat : Id (TT.EI Y) (TT.E.act Y X h P0.out) P1.out =
      transH (c.kunif Y X h P0.w P0.LS.side)
        (RC.kop-cong c Y _ _ wp (EK.PT.rside Y X h P0.w P0.LS.side) P1.LS.side sd) ;
  } ;
  kunif (Y X : Ob) (h : Hom Y X) (x : Pt X) (s : P.Side[X,x]) :
    Id (EI Y) (E.act Y X h (x,kop X x s)) (G.act Y X h x,kop Y (G.act Y X h x) (P.rside Y X h x s)) =
    transH (apH (E.act Y X h) (kop-E X x s))
      (transH (symH (rd-act Y X h Problem[X,x,s].out))
        (transH (apH (rd Y) Uniform[Y,X,h,x,s].out-nat)
          (symH (kop-E Y (G.act Y X h x) (P.rside Y X h x s))))) ;
  opaque kside ; opaque kunif ;
  extension : CP.ContrOp G A = new CP.Rel[G,A,A,CP.pmap-id G A].RC[kop,kside,kunif] ;
} ;
