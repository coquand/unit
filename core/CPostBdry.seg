-- CPostBdry.seg (L9): the side of a box over [m] * Y (postnikov.tex,
-- Lemma box and Theorem conv).  For m = m' + 1, a poset Y and a sieve QY of
-- Y, the sieve of X = [m] * Y
--
--   bdS  =  (faces of [m]) * Y   u   [m] * QY
--
-- carries a partial line built from face data F y (a line over
-- [m'] * Y, for each face y <= m) and end data Ev (a partial line on
-- [m] * QY):
--
--   sv W g i j     at g in the face y: F y at (dg_y g1 , g2); on QY: Ev
--   sv-F, sv-E     sv is F y on any face y that g misses, Ev on QY
--   svp, svn       over the point, natural along every map of Delta
--   sve-of         sv at the end e is a lid a0 if F and Ev are
--
-- The hypotheses are the agreement of two faces (FF, for y < z, both
-- missed) and of a face with the end data (FE).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module AL = Arith[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;

------------------------------------------------------------------------
-- products

pair-ext (X Y Z : Ob) (f f' : Hom Z (prodP X Y))
  (e1 : Id (Hom Z X) (compH Z (prodP X Y) X (pr1 X Y) f) (compH Z (prodP X Y) X (pr1 X Y) f'))
  (e2 : Id (Hom Z Y) (compH Z (prodP X Y) Y (pr2 X Y) f) (compH Z (prodP X Y) Y (pr2 X Y) f')) : Id (Hom Z (prodP X Y)) f f' =
  transH (symH (pair-eta X Y Z f))
    (transH (apH (\ k -> pairH X Y Z k (compH Z (prodP X Y) Y (pr2 X Y) f)) e1)
      (transH (apH (pairH X Y Z (compH Z (prodP X Y) X (pr1 X Y) f')) e2) (pair-eta X Y Z f'))) ;

-- pairing after a map
pair-h (X Y V W : Ob) (a : Hom W X) (b : Hom W Y) (h : Hom V W)
  : Id (Hom V (prodP X Y)) (compH V W (prodP X Y) (pairH X Y W a b) h) (pairH X Y V (compH V W X a h) (compH V W Y b h)) =
  pair-ext X Y V (compH V W (prodP X Y) (pairH X Y W a b) h) (pairH X Y V (compH V W X a h) (compH V W Y b h))
    (transH (symH (comp-assoc V W (prodP X Y) X (pr1 X Y) (pairH X Y W a b) h))
      (transH (apH (\ k -> compH V W X k h) (pr1-pair X Y W a b)) (symH (pr1-pair X Y V (compH V W X a h) (compH V W Y b h)))))
    (transH (symH (comp-assoc V W (prodP X Y) Y (pr2 X Y) (pairH X Y W a b) h))
      (transH (apH (\ k -> compH V W Y k h) (pr2-pair X Y W a b)) (symH (pr2-pair X Y V (compH V W X a h) (compH V W Y b h))))) ;

-- a product of maps after a pair
cross-pair (X X' Y Y' Z : Ob) (f : Hom X X') (g : Hom Y Y') (a : Hom Z X) (b : Hom Z Y)
  : Id (Hom Z (prodP X' Y')) (compH Z (prodP X Y) (prodP X' Y') (crossH X X' Y Y' f g) (pairH X Y Z a b))
                             (pairH X' Y' Z (compH Z X X' f a) (compH Z Y Y' g b)) =
  pair-ext X' Y' Z (compH Z (prodP X Y) (prodP X' Y') (crossH X X' Y Y' f g) (pairH X Y Z a b)) (pairH X' Y' Z (compH Z X X' f a) (compH Z Y Y' g b))
    (calc (Hom Z X') {
        compH Z (prodP X' Y') X' (pr1 X' Y') (compH Z (prodP X Y) (prodP X' Y') (crossH X X' Y Y' f g) (pairH X Y Z a b))
      =< symH (comp-assoc Z (prodP X Y) (prodP X' Y') X' (pr1 X' Y') (crossH X X' Y Y' f g) (pairH X Y Z a b)) >
        compH Z (prodP X Y) X' (compH (prodP X Y) (prodP X' Y') X' (pr1 X' Y') (crossH X X' Y Y' f g)) (pairH X Y Z a b)
      =< apH (\ k -> compH Z (prodP X Y) X' k (pairH X Y Z a b))
           (pr1-pair X' Y' (prodP X Y) (compH (prodP X Y) X X' f (pr1 X Y)) (compH (prodP X Y) Y Y' g (pr2 X Y))) >
        compH Z (prodP X Y) X' (compH (prodP X Y) X X' f (pr1 X Y)) (pairH X Y Z a b)
      =< comp-assoc Z (prodP X Y) X X' f (pr1 X Y) (pairH X Y Z a b) >
        compH Z X X' f (compH Z (prodP X Y) X (pr1 X Y) (pairH X Y Z a b))
      =< apH (compH Z X X' f) (pr1-pair X Y Z a b) >
        compH Z X X' f a
      =< symH (pr1-pair X' Y' Z (compH Z X X' f a) (compH Z Y Y' g b)) >
        compH Z (prodP X' Y') X' (pr1 X' Y') (pairH X' Y' Z (compH Z X X' f a) (compH Z Y Y' g b)) })
    (calc (Hom Z Y') {
        compH Z (prodP X' Y') Y' (pr2 X' Y') (compH Z (prodP X Y) (prodP X' Y') (crossH X X' Y Y' f g) (pairH X Y Z a b))
      =< symH (comp-assoc Z (prodP X Y) (prodP X' Y') Y' (pr2 X' Y') (crossH X X' Y Y' f g) (pairH X Y Z a b)) >
        compH Z (prodP X Y) Y' (compH (prodP X Y) (prodP X' Y') Y' (pr2 X' Y') (crossH X X' Y Y' f g)) (pairH X Y Z a b)
      =< apH (\ k -> compH Z (prodP X Y) Y' k (pairH X Y Z a b))
           (pr2-pair X' Y' (prodP X Y) (compH (prodP X Y) X X' f (pr1 X Y)) (compH (prodP X Y) Y Y' g (pr2 X Y))) >
        compH Z (prodP X Y) Y' (compH (prodP X Y) Y Y' g (pr2 X Y)) (pairH X Y Z a b)
      =< comp-assoc Z (prodP X Y) Y Y' g (pr2 X Y) (pairH X Y Z a b) >
        compH Z Y Y' g (compH Z (prodP X Y) Y (pr2 X Y) (pairH X Y Z a b))
      =< apH (compH Z Y Y' g) (pr2-pair X Y Z a b) >
        compH Z Y Y' g b
      =< symH (pr2-pair X' Y' Z (compH Z X X' f a) (compH Z Y Y' g b)) >
        compH Z (prodP X' Y') Y' (pr2 X' Y') (pairH X' Y' Z (compH Z X X' f a) (compH Z Y Y' g b)) }) ;

-- a constant map into [1] after any map
const-h (V W : Ob) (h : Hom V W) (e : El Iv) : Id (Hom V Iv) (compH V W Iv (constH W Iv e) h) (constH V Iv e) = constH-nat V W h e ;

-- products of maps compose
cross-comp (X X' X'' Y Y' Y'' : Ob) (f : Hom X' X'') (g : Hom Y' Y'') (f' : Hom X X') (g' : Hom Y Y')
  : Id (Hom (prodP X Y) (prodP X'' Y'')) (compH (prodP X Y) (prodP X' Y') (prodP X'' Y'') (crossH X' X'' Y' Y'' f g) (crossH X X' Y Y' f' g'))
                                         (crossH X X'' Y Y'' (compH X X' X'' f f') (compH Y Y' Y'' g g')) =
  transH (cross-pair X' X'' Y' Y'' (prodP X Y) f g (compH (prodP X Y) X X' f' (pr1 X Y)) (compH (prodP X Y) Y Y' g' (pr2 X Y)))
    (transH (apH (\ k -> pairH X'' Y'' (prodP X Y) k (compH (prodP X Y) Y' Y'' g (compH (prodP X Y) Y Y' g' (pr2 X Y))))
               (symH (comp-assoc (prodP X Y) X X' X'' f f' (pr1 X Y))))
            (apH (pairH X'' Y'' (prodP X Y) (compH (prodP X Y) X X'' (compH X X' X'' f f') (pr1 X Y)))
               (symH (comp-assoc (prodP X Y) Y Y' Y'' g g' (pr2 X Y))))) ;

-- the components of a pair of maps are injective when the pair is
pair-inj-l (X Y Z : Ob) (f : Hom Z X) (g : Hom Z Y) (s t : El Z)
  (e : Id Tree (app Z (prodP X Y) (pairH X Y Z f g) s).1 (app Z (prodP X Y) (pairH X Y Z f g) t).1)
  : Id Tree (app Z X f s).1 (app Z X f t).1 =
  node-inj-l (app Z X f s).1 (app Z Y g s).1 (app Z X f t).1 (app Z Y g t).1 e ;

pair-inj-r (X Y Z : Ob) (f : Hom Z X) (g : Hom Z Y) (s t : El Z)
  (e : Id Tree (app Z (prodP X Y) (pairH X Y Z f g) s).1 (app Z (prodP X Y) (pairH X Y Z f g) t).1)
  : Id Tree (app Z Y g s).1 (app Z Y g t).1 =
  node-inj-r (app Z X f s).1 (app Z Y g s).1 (app Z X f t).1 (app Z Y g t).1 e ;

-- an injective monotone map is strict
strict-of-inj (X Y : Ob) (f : Hom X Y) (inj : (s t : El X) -> Id Tree (app X Y f s).1 (app X Y f t).1 -> Id Tree s.1 t.1) : Strict X Y f =
  \ s t l -> and-i (le Y (app X Y f s).1 (app X Y f t).1) (not (eqT (app X Y f s).1 (app X Y f t).1))
    (mono X Y f s t (and-l (le X s.1 t.1) (not (eqT s.1 t.1)) l))
    (CDeltaNat[a].bcase (IsT (not (eqT (app X Y f s).1 (app X Y f t).1))) (eqT (app X Y f s).1 (app X Y f t).1)
       (\ q -> absurd _ (false-true (transH (symH (apH not (eqT-refl s.1)))
                 (substH (\ u -> IsT (not (eqT s.1 u))) (symH (inj s t (eqT-sound (app X Y f s).1 (app X Y f t).1 q)))
                    (and-r (le X s.1 t.1) (not (eqT s.1 t.1)) l)))))
       (\ q -> apH not q)) ;

-- a strict map from [n] is injective
lin-inj (n : Nat) (Y : Ob) (f : Hom (lin n) Y) (st : Strict (lin n) Y f) (s t : El (lin n))
  (e : Id Tree (app (lin n) Y f s).1 (app (lin n) Y f t).1) : Id Tree s.1 t.1 =
  or-elim (Id Tree s.1 t.1) (le (lin n) s.1 t.1) (le (lin n) t.1 s.1) (lin-linear n s t)
    (\ l -> CBoxEZ[a].strict-inj (lin n) Y f st s t l e)
    (\ l -> symH (CBoxEZ[a].strict-inj (lin n) Y f st t s l (symH e))) ;

-- d * [1] and the lids are strict
cross-strict (n m : Nat) (d : Hom (lin n) (lin m)) (st : Strict (lin n) (lin m) d)
  : Strict (prodP (lin n) Iv) (prodP (lin m) Iv) (crossH (lin n) (lin m) Iv Iv d (idH Iv)) =
  strict-of-inj (prodP (lin n) Iv) (prodP (lin m) Iv) (crossH (lin n) (lin m) Iv Iv d (idH Iv)) (\ s t e ->
    transH (symH (prod-eta (lin n) Iv s))
      (transH (node-eq (p1 (lin n) Iv s).1 (p2 (lin n) Iv s).1 (p1 (lin n) Iv t).1 (p2 (lin n) Iv t).1
                 (lin-inj n (lin m) d st (p1 (lin n) Iv s) (p1 (lin n) Iv t)
                    (transH (symH (app-compH1 (prodP (lin n) Iv) (lin n) (lin m) d (pr1 (lin n) Iv) s))
                      (transH (pair-inj-l (lin m) Iv (prodP (lin n) Iv) (compH (prodP (lin n) Iv) (lin n) (lin m) d (pr1 (lin n) Iv)) (compH (prodP (lin n) Iv) Iv Iv (idH Iv) (pr2 (lin n) Iv)) s t e) (app-compH1 (prodP (lin n) Iv) (lin n) (lin m) d (pr1 (lin n) Iv) t))))
                 (transH (symH (app-idH1 Iv (app (prodP (lin n) Iv) Iv (pr2 (lin n) Iv) s)))
                   (transH (symH (app-compH1 (prodP (lin n) Iv) Iv Iv (idH Iv) (pr2 (lin n) Iv) s))
                     (transH (pair-inj-r (lin m) Iv (prodP (lin n) Iv) (compH (prodP (lin n) Iv) (lin n) (lin m) d (pr1 (lin n) Iv)) (compH (prodP (lin n) Iv) Iv Iv (idH Iv) (pr2 (lin n) Iv)) s t e)
                       (transH (app-compH1 (prodP (lin n) Iv) Iv Iv (idH Iv) (pr2 (lin n) Iv) t)
                               (app-idH1 Iv (app (prodP (lin n) Iv) Iv (pr2 (lin n) Iv) t)))))))
              (prod-eta (lin n) Iv t))) ;

lid-strict (X : Ob) (e : El Iv) : Strict X (prodP X Iv) (lid X e) =
  strict-of-inj X (prodP X Iv) (lid X e) (\ s t q ->
    transH (symH (app-idH1 X s)) (transH (pair-inj-l X Iv X (idH X) (constH X Iv e) s t q) (app-idH1 X t))) ;

-- the lid of f * [1] is f followed by the lid
cross-lid (P X : Ob) (f : Hom P X) (e : El Iv)
  : Id (Hom P (prodP X Iv)) (compH P (prodP P Iv) (prodP X Iv) (crossH P X Iv Iv f (idH Iv)) (lid P e)) (compH P X (prodP X Iv) (lid X e) f) =
  transH (cross-pair P X Iv Iv P f (idH Iv) (idH P) (constH P Iv e))
    (transH (apH (\ k -> pairH X Iv P k (compH P Iv Iv (idH Iv) (constH P Iv e)))
               (transH (comp-idr P X f) (symH (comp-idl P X f))))
      (transH (apH (pairH X Iv P (compH P X X (idH X) f))
                 (transH (comp-idl P Iv (constH P Iv e)) (symH (const-h P X f e))))
              (symH (pair-h X Iv P X (idH X) (constH X Iv e) f)))) ;

-- plus m 1 = m + 1
plus-one : (m : Nat) -> Id Nat (plus m (suc zero)) (suc m) = split {
  zero -> refl (suc zero) ;
  suc m | ih -> apH (\ k -> suc k) ih } ;

leN (m N : Nat) (h : IsT (leb (suc m) N)) : IsT (leb (plus m (suc zero)) N) =
  substH {Nat} (\ z -> IsT (leb z N)) (symH (plus-one m)) h ;

------------------------------------------------------------------------
-- the base [m] * Y and its projection, as a module of m and Y only (so
-- that the bases of two instances are compared through m and Y)

module BXm (m : Nat) (Y : Ob) {
  XB : Ob = prodP (lin m) Y ;
  p1B : Hom XB (lin m) = pr1 (lin m) Y ;
} ;

------------------------------------------------------------------------
-- the geometry of [m] * Y

module BG (m' : Nat) (Y : Ob) {
  m : Nat = suc m' ;
  X : Ob = prodP (lin m) Y ;
  Xf : Ob = prodP (lin m') Y ;

  dY (y : Nat) : Hom Xf X = crossH (lin m') (lin m) Y Y (dl m' y) (idH Y) ;

  p1g (W : Nat) (g : Hom (lin W) X) : Hom (lin W) (lin m) = compH (lin W) X (lin m) (pr1 (lin m) Y) g ;
  p2g (W : Nat) (g : Hom (lin W) X) : Hom (lin W) Y = compH (lin W) X Y (pr2 (lin m) Y) g ;

  -- g in the face y, read on [m'] * Y
  gy (y W : Nat) (g : Hom (lin W) X) : Hom (lin W) Xf =
    pairH (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g)) (p2g W g) ;

  pr1-dY (y : Nat) : Id (Hom Xf (lin m)) (compH Xf X (lin m) (pr1 (lin m) Y) (dY y)) (compH Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Y)) =
    pr1-pair (lin m) Y Xf (compH Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Y)) (compH Xf Y Y (idH Y) (pr2 (lin m') Y)) ;

  pr2-dY (y : Nat) : Id (Hom Xf Y) (compH Xf X Y (pr2 (lin m) Y) (dY y)) (pr2 (lin m') Y) =
    transH (pr2-pair (lin m) Y Xf (compH Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Y)) (compH Xf Y Y (idH Y) (pr2 (lin m') Y)))
           (comp-idl Xf Y (pr2 (lin m') Y)) ;

  dYgy (y W : Nat) (g : Hom (lin W) X) (hy : IsT (leb y m)) (ms : Miss (lin W) m' y (p1g W g))
    : Id (Hom (lin W) X) (compH (lin W) Xf X (dY y) (gy y W g)) g =
    pair-ext (lin m) Y (lin W) (compH (lin W) Xf X (dY y) (gy y W g)) g
      (calc (Hom (lin W) (lin m)) {
          compH (lin W) X (lin m) (pr1 (lin m) Y) (compH (lin W) Xf X (dY y) (gy y W g))
        =< symH (comp-assoc (lin W) Xf X (lin m) (pr1 (lin m) Y) (dY y) (gy y W g)) >
          compH (lin W) Xf (lin m) (compH Xf X (lin m) (pr1 (lin m) Y) (dY y)) (gy y W g)
        =< apH (\ k -> compH (lin W) Xf (lin m) k (gy y W g)) (pr1-dY y) >
          compH (lin W) Xf (lin m) (compH Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Y)) (gy y W g)
        =< comp-assoc (lin W) Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Y) (gy y W g) >
          compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) Xf (lin m') (pr1 (lin m') Y) (gy y W g))
        =< apH (compH (lin W) (lin m') (lin m) (dl m' y))
             (pr1-pair (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g)) (p2g W g)) >
          compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g))
        =< hom-eq (lin W) (lin m) _ _ (pw-factor (lin W) m' y (p1g W g) hy ms) >
          p1g W g })
      (calc (Hom (lin W) Y) {
          compH (lin W) X Y (pr2 (lin m) Y) (compH (lin W) Xf X (dY y) (gy y W g))
        =< symH (comp-assoc (lin W) Xf X Y (pr2 (lin m) Y) (dY y) (gy y W g)) >
          compH (lin W) Xf Y (compH Xf X Y (pr2 (lin m) Y) (dY y)) (gy y W g)
        =< apH (\ k -> compH (lin W) Xf Y k (gy y W g)) (pr2-dY y) >
          compH (lin W) Xf Y (pr2 (lin m') Y) (gy y W g)
        =< pr2-pair (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g)) (p2g W g) >
          p2g W g }) ;

  -- reading in the face commutes with restriction
  gy-h (y V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X)
    : Id (Hom (lin V) Xf) (compH (lin V) (lin W) Xf (gy y W g) h) (gy y V (compH (lin V) (lin W) X g h)) =
    pair-ext (lin m') Y (lin V) (compH (lin V) (lin W) Xf (gy y W g) h) (gy y V (compH (lin V) (lin W) X g h))
      (calc (Hom (lin V) (lin m')) {
          compH (lin V) Xf (lin m') (pr1 (lin m') Y) (compH (lin V) (lin W) Xf (gy y W g) h)
        =< symH (comp-assoc (lin V) (lin W) Xf (lin m') (pr1 (lin m') Y) (gy y W g) h) >
          compH (lin V) (lin W) (lin m') (compH (lin W) Xf (lin m') (pr1 (lin m') Y) (gy y W g)) h
        =< apH (\ k -> compH (lin V) (lin W) (lin m') k h)
             (pr1-pair (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g)) (p2g W g)) >
          compH (lin V) (lin W) (lin m') (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g)) h
        =< comp-assoc (lin V) (lin W) (lin m) (lin m') (dgH m' y) (p1g W g) h >
          compH (lin V) (lin m) (lin m') (dgH m' y) (compH (lin V) (lin W) (lin m) (p1g W g) h)
        =< apH (compH (lin V) (lin m) (lin m') (dgH m' y)) (comp-assoc (lin V) (lin W) X (lin m) (pr1 (lin m) Y) g h) >
          compH (lin V) (lin m) (lin m') (dgH m' y) (p1g V (compH (lin V) (lin W) X g h))
        =< symH (pr1-pair (lin m') Y (lin V) (compH (lin V) (lin m) (lin m') (dgH m' y) (p1g V (compH (lin V) (lin W) X g h)))
                   (p2g V (compH (lin V) (lin W) X g h))) >
          compH (lin V) Xf (lin m') (pr1 (lin m') Y) (gy y V (compH (lin V) (lin W) X g h)) })
      (calc (Hom (lin V) Y) {
          compH (lin V) Xf Y (pr2 (lin m') Y) (compH (lin V) (lin W) Xf (gy y W g) h)
        =< symH (comp-assoc (lin V) (lin W) Xf Y (pr2 (lin m') Y) (gy y W g) h) >
          compH (lin V) (lin W) Y (compH (lin W) Xf Y (pr2 (lin m') Y) (gy y W g)) h
        =< apH (\ k -> compH (lin V) (lin W) Y k h)
             (pr2-pair (lin m') Y (lin W) (compH (lin W) (lin m) (lin m') (dgH m' y) (p1g W g)) (p2g W g)) >
          compH (lin V) (lin W) Y (p2g W g) h
        =< comp-assoc (lin V) (lin W) X Y (pr2 (lin m) Y) g h >
          p2g V (compH (lin V) (lin W) X g h)
        =< symH (pr2-pair (lin m') Y (lin V) (compH (lin V) (lin m) (lin m') (dgH m' y) (p1g V (compH (lin V) (lin W) X g h)))
                   (p2g V (compH (lin V) (lin W) X g h))) >
          compH (lin V) Xf Y (pr2 (lin m') Y) (gy y V (compH (lin V) (lin W) X g h)) }) ;

  ----------------------------------------------------------------------
  -- the faces as a sieve

  Fm (y : Nat) : Subset X = \ w -> not (eqN (vnum (p1 (lin m) Y w).1) y) ;

  faceS (y : Nat) : SP.Phi X = PBs.subS X X (idH X) (Fm y) ;

  facesS : SP.Phi X = SP.bigU X (suc m) (\ k -> faceS k.1) ;

  -- the points of g and of id g
  idg (P : Subset X) (W : Nat) (g : Hom (lin W) X) (s : El (lin W))
    : Id (El X) (app (lin W) X (compH (lin W) X X (idH X) g) s) (app (lin W) X g s) =
    el-eq X (app (lin W) X (compH (lin W) X X (idH X) g) s) (app (lin W) X g s)
      (transH (app-compH1 (lin W) X X (idH X) g s) (app-idH1 X (app (lin W) X g s))) ;

  p1t (W : Nat) (g : Hom (lin W) X) (s : El (lin W)) : Id Tree (app (lin W) (lin m) (p1g W g) s).1 (p1 (lin m) Y (app (lin W) X g s)).1 =
    app-compH1 (lin W) X (lin m) (pr1 (lin m) Y) g s ;

  miss-of (W : Nat) (g : Hom (lin W) X) (y : Nat) (l : SP.Lands (lin W) X (faceS y) g) : Miss (lin W) m' y (p1g W g) = \ s ->
    substH {Tree} (\ t -> IsT (not (eqN (vnum t) y))) (symH (p1t W g s))
      (substH {El X} (\ w -> IsT (Fm y w)) (idg (Fm y) W g s)
         (PBs.isIn-sound (lin W) X (compH (lin W) X X (idH X) g) (Fm y) l s)) ;

  lands-of (W : Nat) (g : Hom (lin W) X) (y : Nat) (ms : Miss (lin W) m' y (p1g W g)) : SP.Lands (lin W) X (faceS y) g =
    PBs.isIn-complete (lin W) X (compH (lin W) X X (idH X) g) (Fm y) (\ s ->
      substH {El X} (\ w -> IsT (Fm y w)) (symH (idg (Fm y) W g s))
        (substH {Tree} (\ t -> IsT (not (eqN (vnum t) y))) (p1t W g s) (ms s))) ;

  in-faces (W : Nat) (g : Hom (lin W) X) (y : Nat) (hy : IsT (leb y m)) (ms : Miss (lin W) m' y (p1g W g))
    : SP.Lands (lin W) X facesS g =
    SP.bigU-in (lin W) X (suc m) (\ k -> faceS k.1) g (y, hy) (lands-of W g y ms) ;

  -- the sieve of the side
  endS (QY : SP.Phi Y) : SP.Phi X = SP.pre X Y (pr2 (lin m) Y) QY ;

  bdS (QY : SP.Phi Y) : SP.Phi X = SP.unionS X facesS (endS QY) ;
} ;

------------------------------------------------------------------------
-- the side

module BS (G : PP.PCtx) (A : PP.PTy[G]) (m' : Nat) (Y : Ob) (QY : SP.Phi Y)
  (xX : W0.Ix (G.ob (prodP (lin (suc m')) Y)))
  (F : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Y) -> Hom (lin W) Iv
       -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Fp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Y)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (F y hy W g j).1
              (G.act (lin W) (prodP (lin m') Y) g (G.act (prodP (lin m') Y) (prodP (lin (suc m')) Y) (BG[m', Y].dY y) xX)))
  (Fn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Y)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (F y hy W g j))
              (F y hy V (compH (lin V) (lin W) (prodP (lin m') Y) g h) (compH (lin V) (lin W) Iv j h)))
  (Ev : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y)) -> SP.Lands (lin W) (prodP (lin (suc m')) Y) (BG[m', Y].endS QY) g
        -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Evp : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y)) (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BG[m', Y].endS QY) g)
         (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Ev W g b j).1 (G.act (lin W) (prodP (lin (suc m')) Y) g xX))
  (Evn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin (suc m')) Y))
         (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BG[m', Y].endS QY) g)
         (b' : SP.Lands (lin V) (prodP (lin (suc m')) Y) (BG[m', Y].endS QY) (compH (lin V) (lin W) (prodP (lin (suc m')) Y) g h))
         (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (Ev W g b j))
               (Ev V (compH (lin V) (lin W) (prodP (lin (suc m')) Y) g h) b' (compH (lin V) (lin W) Iv j h)))
  (FF : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
        (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y))
        (msy : Miss (lin W) m' y (BG[m', Y].p1g W g)) (msz : Miss (lin W) m' z (BG[m', Y].p1g W g)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (F y hy W (BG[m', Y].gy y W g) j) (F z hz W (BG[m', Y].gy z W g) j))
  (FE : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Y))
        (ms : Miss (lin W) m' y (BG[m', Y].p1g W g)) (b : SP.Lands (lin W) (prodP (lin (suc m')) Y) (BG[m', Y].endS QY) g)
        (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (F y hy W (BG[m', Y].gy y W g) j) (Ev W g b j)) {
  module B = BG[m', Y] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;
  m : Nat = suc m' ;
  X : Ob = B.X ;
  Q : SP.Phi X = B.bdS QY ;

  -- F does not depend on the proof of y <= m
  F-irr (y : Nat) (hy hy' : IsT (leb y m)) (W : Nat) (g : Hom (lin W) B.Xf) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (F y hy W g j) (F y hy' W g j) = apH (\ p -> F y p W g j) (isProp-IsT' (leb y m) hy hy') ;

  -- two missed faces give the same value
  FFa (y z : Nat) (hy : IsT (leb y m)) (hz : IsT (leb z m)) (W : Nat) (g : Hom (lin W) X)
    (msy : Miss (lin W) m' y (B.p1g W g)) (msz : Miss (lin W) m' z (B.p1g W g)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (F y hy W (B.gy y W g) j) (F z hz W (B.gy z W g) j) =
    AL.eqN-dec (Id (TA.EI (lin W)) (F y hy W (B.gy y W g) j) (F z hz W (B.gy z W g) j)) y z
      (\ e -> idJ Nat y (\ z1 e1 -> (hz1 : IsT (leb z1 m)) -> Id (TA.EI (lin W)) (F y hy W (B.gy y W g) j) (F z1 hz1 W (B.gy z1 W g) j))
                (\ hz1 -> F-irr y hy hz1 W (B.gy y W g) j) z e hz)
      (\ ne -> AL.ltb-dec (Id (TA.EI (lin W)) (F y hy W (B.gy y W g) j) (F z hz W (B.gy z W g) j)) y z
         (\ lt -> FF y z hy hz lt W g msy msz j)
         (\ ge -> symH (FF z y hz hy (leb-neq z y ge (neq-sym y z ne)) W g msz msy j))) ;

  -- the value
  svC (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : Plus (SP.Lands (lin W) X B.facesS g) (SP.Lands (lin W) X (B.endS QY) g) -> TA.EI (lin W) = split {
    inl a -> F (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2
               W (B.gy (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 W g) j ;
    inr b -> Ev W g b j } ;

  sv (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv) : TA.EI (lin W) =
    svC W g j (SP.union-lands (lin W) X B.facesS (B.endS QY) g i) ;

  -- sv is F on any missed face, Ev on QY
  svC-F (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) X) (ms : Miss (lin W) m' y (B.p1g W g)) (j : Hom (lin W) Iv)
    : (c : Plus (SP.Lands (lin W) X B.facesS g) (SP.Lands (lin W) X (B.endS QY) g)) -> Id (TA.EI (lin W)) (svC W g j c) (F y hy W (B.gy y W g) j) = split {
    inl a -> FFa (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 y (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2 hy W g
               (B.miss-of W g (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).2)
               ms j ;
    inr b -> symH (FE y hy W g ms b j) } ;

  svC-E (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X (B.endS QY) g) (j : Hom (lin W) Iv)
    : (c : Plus (SP.Lands (lin W) X B.facesS g) (SP.Lands (lin W) X (B.endS QY) g)) -> Id (TA.EI (lin W)) (svC W g j c) (Ev W g b j) = split {
    inl a -> FE (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2 W g
               (B.miss-of W g (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).2)
               b j ;
    inr b' -> apH (\ p -> Ev W g p j) (SP.isProp-Lands (lin W) X (B.endS QY) g b' b) } ;

  sv-F (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (ms : Miss (lin W) m' y (B.p1g W g))
    (j : Hom (lin W) Iv) : Id (TA.EI (lin W)) (sv W g i j) (F y hy W (B.gy y W g) j) =
    svC-F y hy W g ms j (SP.union-lands (lin W) X B.facesS (B.endS QY) g i) ;

  sv-E (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (b : SP.Lands (lin W) X (B.endS QY) g) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (sv W g i j) (Ev W g b j) =
    svC-E W g b j (SP.union-lands (lin W) X B.facesS (B.endS QY) g i) ;

  ----------------------------------------------------------------------
  -- over the point, natural

  svpC (W : Nat) (g : Hom (lin W) X) (j : Hom (lin W) Iv)
    : (c : Plus (SP.Lands (lin W) X B.facesS g) (SP.Lands (lin W) X (B.endS QY) g))
    -> Id (W0.Ix (G.ob (lin W))) (svC W g j c).1 (G.act (lin W) X g xX) = split {
    inl a -> transH (Fp (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2
                        W (B.gy (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 W g) j)
               (transH (GL.actC (lin W) B.Xf X (B.dY (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1)
                          (B.gy (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 W g) xX)
                       (apH (\ k -> G.act (lin W) X k xX)
                          (B.dYgy (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 W g
                             (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2
                             (B.miss-of W g (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1
                                (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).2)))) ;
    inr b -> Evp W g b j } ;

  svp (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob (lin W))) (sv W g i j).1 (G.act (lin W) X g xX) =
    svpC W g j (SP.union-lands (lin W) X B.facesS (B.endS QY) g i) ;

  -- a missed face stays missed after restriction
  miss-h (y V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (ms : Miss (lin W) m' y (B.p1g W g))
    : Miss (lin V) m' y (B.p1g V (compH (lin V) (lin W) X g h)) = \ s ->
    substH {Tree} (\ t -> IsT (not (eqN (vnum t) y)))
      (transH (symH (app-compH1 (lin V) (lin W) (lin m) (B.p1g W g) h s))
              (apH (\ k -> (app (lin V) (lin m) k s).1) (comp-assoc (lin V) (lin W) X (lin m) (pr1 (lin m) Y) g h)))
      (ms (app (lin V) (lin W) h s)) ;

  svnC (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (i' : SP.Lands (lin V) X Q (compH (lin V) (lin W) X g h)) (j : Hom (lin W) Iv)
    : (c : Plus (SP.Lands (lin W) X B.facesS g) (SP.Lands (lin W) X (B.endS QY) g))
    -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (svC W g j c)) (sv V (compH (lin V) (lin W) X g h) i' (compH (lin V) (lin W) Iv j h)) = split {
    inl a ->
      transH (Fn (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2
                 V W h (B.gy (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 W g) j)
        (transH (apH (\ k -> F (SP.bigU-out (lin W) X (suc m) (\ k1 -> B.faceS k1.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k1 -> B.faceS k1.1) g a).1.2
                               V k (compH (lin V) (lin W) Iv j h))
                    (B.gy-h (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 V W h g))
                (symH (sv-F (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2
                         V (compH (lin V) (lin W) X g h) i'
                         (miss-h (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 V W h g
                            (B.miss-of W g (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1
                               (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).2))
                         (compH (lin V) (lin W) Iv j h)))) ;
    inr b ->
      transH (Evn V W h g b (SP.lands-comp (lin V) (lin W) X (B.endS QY) g h b) j)
             (symH (sv-E V (compH (lin V) (lin W) X g h) i' (SP.lands-comp (lin V) (lin W) X (B.endS QY) g h b) (compH (lin V) (lin W) Iv j h))) } ;

  svn (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
    (i' : SP.Lands (lin V) X Q (compH (lin V) (lin W) X g h)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (sv W g i j)) (sv V (compH (lin V) (lin W) X g h) i' (compH (lin V) (lin W) Iv j h)) =
    svnC V W h g i' j (SP.union-lands (lin W) X B.facesS (B.endS QY) g i) ;

  ----------------------------------------------------------------------
  -- the side starts at a lid a0 when its pieces do

  module Lid (e : El Iv) (a0 : (W : Nat) -> Hom (lin W) X -> TA.EI (lin W))
    (aF : (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) X) (ms : Miss (lin W) m' y (B.p1g W g))
          -> Id (TA.EI (lin W)) (F y hy W (B.gy y W g) (constH (lin W) Iv e)) (a0 W g))
    (aE : (W : Nat) (g : Hom (lin W) X) (b : SP.Lands (lin W) X (B.endS QY) g)
          -> Id (TA.EI (lin W)) (Ev W g b (constH (lin W) Iv e)) (a0 W g)) {

    sveC (W : Nat) (g : Hom (lin W) X)
      : (c : Plus (SP.Lands (lin W) X B.facesS g) (SP.Lands (lin W) X (B.endS QY) g))
      -> Id (TA.EI (lin W)) (svC W g (constH (lin W) Iv e) c) (a0 W g) = split {
      inl a -> aF (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.2 W g
                 (B.miss-of W g (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).1.1 (SP.bigU-out (lin W) X (suc m) (\ k -> B.faceS k.1) g a).2) ;
      inr b -> aE W g b } ;

    sve (W : Nat) (g : Hom (lin W) X) (i : SP.Lands (lin W) X Q g)
      : Id (TA.EI (lin W)) (sv W g i (constH (lin W) Iv e)) (a0 W g) =
      sveC W g (SP.union-lands (lin W) X B.facesS (B.endS QY) g i) ;
  } ;
} ;
