-- CTrOm.seg (L3, inside CB, level l): transport is an equivalence, the
-- square omega of a fibre element (model.tex Prop "transport is an
-- equivalence", proof).  Over the universal lines GI:
--
--   K       the points ((gamma , a) , b) of the fibres of tr (HFib.EAB)
--   PathP   paths over gamma from b (at src d) to a (at tgt d), over K;
--           composition from e0 to e1 (CPathComp, from A's c01), filler kS
--   ell v   the line in K of a fibre element v = (b , q) over (gamma , a):
--           j |-> ((gamma , q j) , b), from (tr b , b) to (a , b)
--   omSq v  the filler in PathP along ell v, with no side, from the
--           transport filler of b (a path over gamma from b to tr b)
--   omE v   its end: a path over gamma from b to a
--   omVN    omega is natural in v
--
-- Quarry: seg/model GTE2, GTE3, GTE4 (over GI, ln = id).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module Om (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp)
  (c01 : CLine[l].Lines[G, A].CompK[e0, e1].Comp) {
  module T1 = CTr[l].Tr[G, A, d, ca] ;
  module FG = T1.FG ;
  module HF = CEquiv[l].HFib[FG.GI, T1.SB, T1.SA, T1.tr] ;
  module TA = T1.TA ;
  module EK0 = T1.EK ;
  module EK1 = T1.EK' ;

  K : PCtx = HF.EAB ;
  module FK = CLine[l].FC[K] ;

  -- the point of G at (f , i): the value of the line
  s (X : Ob) (y : W0.Ix (K.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (G.ob W) = y.1.1.1 W f i ;

  sN (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
    (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (s I x W (compH W J I h f) i) (s J y W f i) =
    apH (\ z -> s J z W f i) e ;

  sF (X : Ob) (y : W0.Ix (K.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (G.ob V)) (G.act V W g (s X y W f i)) (s X y V (compH V W X f g) (compH V W Iv i g)) =
    y.1.1.2 V W g f i ;

  -- the ends: b at src d, a at tgt d, read in E
  aE (W : Ob) (y : W0.Ix (K.ob W)) : TA.EI W = EK0.endE W (y.1.1, y.2) ;
  bE (W : Ob) (y : W0.Ix (K.ob W)) : TA.EI W = EK1.endE W y.1 ;

  aE-act (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X)) : Id (TA.EI W) (TA.E.act W X f (aE X x)) (aE W (K.act W X f x)) =
    transH (symH (EK0.endE-act W X f (x.1.1, x.2))) (apH (EK0.endE W) (HF.bAct W X f x)) ;

  bE-act (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X)) : Id (TA.EI W) (TA.E.act W X f (bE X x)) (bE W (K.act W X f x)) =
    symH (EK1.endE-act W X f x.1) ;

  opaque aE-act ; opaque bE-act ;

  aE-pt (W : Ob) (y : W0.Ix (K.ob W)) : Id (W0.Ix (G.ob W)) (aE W y).1 (s W y W (idH W) (ptH W (src d))) = refl (aE W y).1 ;
  bE-pt (W : Ob) (y : W0.Ix (K.ob W)) : Id (W0.Ix (G.ob W)) (bE W y).1 (s W y W (idH W) (ptH W (tgt d))) = refl (bE W y).1 ;

  module PC = CPathComp[l].PathC[K, G, A, d, s, sN, sF, aE, bE, aE-act, bE-act, aE-pt, bE-pt, e0, e1, c01] ;
  module PT = PC.PT ;
  module CP = PC.CP ;
  module EVP1 = CLine[l].FT[K, PT.PathP].Ev[e1] ;
  module EVP0 = CLine[l].FT[K, PT.PathP].Ev[e0] ;

  kS : CLine[l].Lines[K, PT.PathP].Fill e0 = CFill[l].FillC[K, PT.PathP, true, PC.comp].fill ;

  ----------------------------------------------------------------------
  -- points of K: determined by their A part and their B part

  eabExt (W : Ob) (y y' : W0.Ix (K.ob W)) (P : Id (HF.TA.EI W) y.1 y'.1)
    (Q : Id (HF.TB.EI W) (y.1.1, y.2) (y'.1.1, y'.2)) : Id (W0.Ix (K.ob W)) y y' =
    idJ (HF.TA.EI W) y.1
      (\ z P2 -> (c : W0.Ix (T1.SB.tob W z.1)) -> Id (HF.TB.EI W) (y.1.1, y.2) (z.1, c) -> Id (W0.Ix (K.ob W)) y (z, c))
      (\ c Q2 -> apH {W0.Ix (T1.SB.tob W y.1.1)} {W0.Ix (K.ob W)} (\ u -> (y.1, u)) (HF.TB.pr-inj W y.1.1 y.2 c Q2))
      y'.1 P y'.2 Q ;

  opaque eabExt ;

  ----------------------------------------------------------------------
  -- the line in K of a fibre element

  module FL (V : Ob) (v : HF.TF.EI V) {
    q (W : Ob) (f : Hom W V) (j : Hom W Iv) : HF.TA.EI W = HF.fibL V v W f j ;

    bf (W : Ob) (f : Hom W V) : HF.TB.EI W = HF.TB.E.act W V f (HF.fibB V v) ;

    ptq (W : Ob) (f : Hom W V) (j : Hom W Iv) : Id (W0.Ix (FG.GI.ob W)) (q W f j).1 (bf W f).1 = HF.fibL-pt V v W f j ;

    lw (W : Ob) (f : Hom W V) (j : Hom W Iv) : W0.Ix (K.ob W) =
      (q W f j, HF.TB.coeT W (bf W f).1 (q W f j).1 (symH (ptq W f j)) (bf W f).2) ;

    lvB (W : Ob) (f : Hom W V) (j : Hom W Iv) : Id (HF.TB.EI W) ((lw W f j).1.1, (lw W f j).2) (bf W f) =
      symH (HF.TB.pr-coe W (bf W f).1 (q W f j).1 (symH (ptq W f j)) (bf W f).2) ;

    lvN (V' W : Ob) (g : Hom V' W) (f : Hom W V) (j : Hom W Iv)
      : Id (W0.Ix (K.ob V')) (K.act V' W g (lw W f j)) (lw V' (compH V' W V f g) (compH V' W Iv j g)) =
      eabExt V' (K.act V' W g (lw W f j)) (lw V' (compH V' W V f g) (compH V' W Iv j g))
        (HF.fibL-nat V v V' W g f j)
        (transH (symH (HF.bAct V' W g (lw W f j)))
          (transH (apH (HF.TB.E.act V' W g) (lvB W f j))
            (transH (HF.TB.PE.actC V' W V f g (HF.fibB V v))
                    (symH (lvB V' (compH V' W V f g) (compH V' W Iv j g)))))) ;

    ell : W0.Ix (FK.ob V) = (lw, lvN) ;
  } ;

  ----------------------------------------------------------------------
  -- the square of a fibre element

  module W (V : Ob) (v : HF.TF.EI V) {
    module L = FL[V, v] ;

    xb : HF.TB.EI V = HF.fibB V v ;

    y0 : W0.Ix (K.ob V) = L.lw V (idH V) (ptH V e0) ;

    u : EK0.TS.EI V = T1.uF V xb ;

    t (W : Ob) (f : Hom W V) (i : Hom W Iv) : TA.EI W = (EK0.lineL V u).2.1.1 W f i ;

    tn (V' W : Ob) (g : Hom V' W) (f : Hom W V) (i : Hom W Iv)
      : Id (TA.EI V') (TA.E.act V' W g (t W f i)) (t V' (compH V' W V f g) (compH V' W Iv i g)) =
      (EK0.lineL V u).2.1.2 V' W g f i ;

    -- the line of v at e0 is over the line of b
    xq : Id (W0.Ix (FG.GI.ob V)) xb.1 y0.1.1 = symH (transH (HF.fibL-pt V v V (idH V) (ptH V e0)) (FG.GI.act-id V xb.1)) ;

    tp (W : Ob) (f : Hom W V) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (t W f i).1 (s V y0 W f i) =
      transH (apH (\ y -> y.1 W f i) (EK0.lineL V u).2.2) (apH (\ z -> z.1 W f i) xq) ;

    -- the B part of the start point is xb
    yB : Id (HF.TB.EI V) (y0.1.1, y0.2) xb = transH (L.lvB V (idH V) (ptH V e0)) (HF.TB.E.act-id V xb) ;

    t0 : Id (TA.EI V) (t V (idH V) (ptH V (src d))) (aE V y0) =
      transH (symH (T1.EVs.endB-E V (EK0.lineL V u)))
        (transH (apH (EK0.endE V) (T1.uF-start V xb)) (apH (EK0.endE V) (symH yB))) ;

    t1 : Id (TA.EI V) (t V (idH V) (ptH V (tgt d))) (bE V y0) =
      transH (symH (T1.EVt.endB-E V (EK0.lineL V u))) (apH (EK1.endE V) (symH (HF.fibL-0 V v))) ;

    -- the transport filler of b, as a path over gamma from b to tr b
    uFP : W0.Ix (PT.tobP V y0) = PT.mkPath V y0 t tn tp t0 t1 ;

    xh : CP.TV.EI V = (L.ell, uFP) ;

    noSide : CP.PT.Side[V, xh] =
      new CP.PT.Side[V, xh, emptyS V, \ W f i -> absurd _ (empty-lands W V f i), \ W f i -> absurd _ (empty-lands W V f i),
        \ W' W chi f i i' -> absurd _ (empty-lands W V f i)] ;

    -- the square: a line (in j) of paths over gamma, from uFP
    omSq : CP.TS.EI V = (xh, kS.kop V xh noSide) ;

    -- its end at e1: a path over gamma from b to a
    omE : CLine[l].EndKit[K, PT.PathP, e1].TV.EI V = EVP1.evA.mE V (CP.lineL V omSq) ;
  } ;

  ----------------------------------------------------------------------
  -- omega is natural in the fibre element

  module R (Y X : Ob) (g : Hom Y X) (v : HF.TF.EI X) {
    module WX = W[X, v] ;
    module WY = W[Y, HF.TF.E.act Y X g v] ;

    bN (W' : Ob) (f : Hom W' Y) : Id (HF.TB.EI W') (WX.L.bf W' (compH W' Y X g f)) (WY.L.bf W' f) =
      transH (symH (HF.TB.PE.actC W' Y X g f (HF.fibB X v)))
             (apH (HF.TB.E.act W' Y f) (symH (HF.fibB-act Y X g v))) ;

    ellN : Id (W0.Ix (FK.ob Y)) (FK.actF Y X g WX.L.ell) WY.L.ell =
      FK.fam-eq Y (FK.actF Y X g WX.L.ell) WY.L.ell (\ W' f j ->
        eabExt W' (WX.L.lw W' (compH W' Y X g f) j) (WY.L.lw W' f j) (refl (WX.L.lw W' (compH W' Y X g f) j).1)
          (transH (WX.L.lvB W' (compH W' Y X g f) j) (transH (bN W' f) (symH (WY.L.lvB W' f j))))) ;

    uN (W' : Ob) (f : Hom W' Y) (i : Hom W' Iv) : Id (TA.EI W') (WX.t W' (compH W' Y X g f) i) (WY.t W' f i) =
      transH (symH (apH (\ M -> M.2.1.1 W' f i) (EK0.lineL-act Y X g WX.u)))
        (transH (apH (\ z -> (EK0.lineL Y z).2.1.1 W' f i) (T1.uF-nat Y X g WX.xb))
                (apH (\ z -> (EK0.lineL Y (T1.uF Y z)).2.1.1 W' f i) (symH (HF.fibB-act Y X g v)))) ;

    xhN : Id (CP.TV.EI Y) (CP.TV.E.act Y X g WX.xh) WY.xh =
      CP.tv-eq Y (CP.TV.E.act Y X g WX.xh) WY.xh ellN
        (PT.tp-ext Y (CP.endE Y (CP.TV.E.act Y X g WX.xh)) (CP.endE Y WY.xh) (apH (\ z -> (FK.ev e0).nt Y z) ellN)
           (\ W' f i -> uN W' f i)) ;

    noSideR : Id (CP.PT.Side[Y, WY.xh])
                (subst (CP.TV.EI Y) (\ z -> CP.PT.Side[Y, z]) (CP.TV.E.act Y X g WX.xh) WY.xh xhN (CP.PT.rside Y X g WX.xh WX.noSide))
                WY.noSide =
      CP.PT.side-extH Y (CP.TV.E.act Y X g WX.xh) WY.xh xhN (CP.PT.rside Y X g WX.xh WX.noSide) WY.noSide (pre-empty Y X g)
        (\ W' f i i' -> absurd _ (empty-lands W' Y f i')) ;

    omSqN : Id (CP.TS.EI Y) (CP.TS.E.act Y X g WX.omSq) WY.omSq =
      transH (kS.kunif Y X g WX.xh WX.noSide)
        (CPartial[l].Rel[CP.TV.E, CP.SFm.SF, CP.SFm.SF, CPartial[l].pmap-id CP.TV.E CP.SFm.SF].kop-cong kS Y
           (CP.TV.E.act Y X g WX.xh) WY.xh xhN (CP.PT.rside Y X g WX.xh WX.noSide) WY.noSide noSideR) ;

    omEN : Id (CLine[l].EndKit[K, PT.PathP, e1].TV.EI Y) (CLine[l].EndKit[K, PT.PathP, e1].TV.E.act Y X g WX.omE) WY.omE =
      transH (symH (EVP1.evA.mnat Y X g (CP.lineL X WX.omSq)))
        (transH (apH (EVP1.evA.mE Y) (symH (CP.lineL-act Y X g WX.omSq))) (apH (\ z -> EVP1.evA.mE Y (CP.lineL Y z)) omSqN)) ;

    -- pointwise
    omVN (W' : Ob) (f : Hom W' Y) (i : Hom W' Iv) : Id (TA.EI W') (WX.omE.2.1.1 W' (compH W' Y X g f) i) (WY.omE.2.1.1 W' f i) =
      apH (\ z -> z.2.1.1 W' f i) omEN ;

    opaque ellN ; opaque xhN ; opaque noSideR ; opaque omSqN ; opaque omEN ;
  } ;
} ;
