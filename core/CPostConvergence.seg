-- CPostConvergence.seg: the comparison, its natural right inverse, and
-- the first inverse homotopy as a term of the model's Path type.
-- The second inverse homotopy is not asserted here.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module HO = PB.CHtpyOps[l] ;
module BD = CPostBdry[a, l] ;

-- Convert a natural family of cylinders to an internal homotopy.
module Cylinder (G : PCtx) (C B : PTy[G]) (al be : HO.NMap[G, C, B])
  (p : (X : Ob) (x : W.Ix (G.ob X)) -> W.Ix (C.tob X x) -> PR.TyL[G, B].EI (prodP X Iv))
  (pp : (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x))
    -> Id (W.Ix (G.ob (prodP X Iv))) (p X x u).1 (G.act (prodP X Iv) X (pr1 X Iv) x))
  (p0 : (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x))
    -> Id (PR.TyL[G, B].EI X) (PR.TyL[G, B].E.act X (prodP X Iv) (lid X e0) (p X x u)) (x, al.nfun X x u))
  (p1 : (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x))
    -> Id (PR.TyL[G, B].EI X) (PR.TyL[G, B].E.act X (prodP X Iv) (lid X e1) (p X x u)) (x, be.nfun X x u))
  (pn : (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
    (u : W.Ix (C.tob X x)) -> Id (PR.TyL[G, B].EI (prodP Y Iv))
      (PR.TyL[G, B].E.act (prodP Y Iv) (prodP X Iv) (crossH Y X Iv Iv h (idH Iv)) (p X x u))
      (p Y y (C.tact Y X h x y e u))) {
  module T = HO.HT[G, C, B, al, be] ;
  module TB = PR.TyL[G, B] ;
  module GL = PR.PshL[G] ;
  module At (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (C.tob X x)) {
    XI : Ob = prodP X Iv ;
    v (V : Ob) (f : Hom V X) (j : Hom V Iv) : TB.EI V = TB.E.act V XI (pairH X Iv V f j) (p X x u) ;
    vn (V W1 : Ob) (h : Hom V W1) (f : Hom W1 X) (j : Hom W1 Iv)
      : Id (TB.EI V) (TB.E.act V W1 h (v W1 f j)) (v V (compH V W1 X f h) (compH V W1 Iv j h)) =
      transH (TB.PE.actC V W1 XI (pairH X Iv W1 f j) h (p X x u))
        (apH (\ k -> TB.E.act V XI k (p X x u)) (BD.pair-h X Iv V W1 f j h)) ;
    vp (V : Ob) (f : Hom V X) (j : Hom V Iv) : Id (W.Ix (G.ob V)) (v V f j).1 (G.act V X f x) =
      transH (apH (G.act V XI (pairH X Iv V f j)) (pp X x u))
        (GL.actTri V XI X (pr1 X Iv) (pairH X Iv V f j) f (pr1-pair X Iv V f j) x) ;
    path : W.Ix (T.PT.tobP X (x, u)) = T.PT.mkPath X (x, u) v vn vp (p0 X x u) (p1 X x u) ;
  } ;
  path (X : Ob) (w : W.Ix (T.GA.ob X)) : W.Ix (T.PT.tobP X w) = At[X, w.1, w.2].path ;
  pvnat (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
    (u : W.Ix (C.tob X x)) (V : Ob) (f : Hom V Y) (j : Hom V Iv)
    : Id (TB.EI V) (At[X, x, u].v V (compH V Y X h f) j) (At[Y, y, C.tact Y X h x y e u].v V f j) =
    transH (apH (\ k -> TB.E.act V (prodP X Iv) k (p X x u))
      (symH (transH (BD.cross-pair Y X Iv Iv V h (idH Iv) f j)
        (apH (pairH X Iv V (compH V Y X h f)) (comp-idl V Iv j)))))
      (transH (TB.E.act-o V (prodP Y Iv) (prodP X Iv) (crossH Y X Iv Iv h (idH Iv)) (pairH Y Iv V f j) (p X x u))
        (apH (TB.E.act V (prodP Y Iv) (pairH Y Iv V f j)) (pn Y X h x y e u))) ;
  enat (Y X : Ob) (h : Hom Y X) (w : W.Ix (T.GA.ob X)) (w' : W.Ix (T.GA.ob Y)) (e : Id (W.Ix (T.GA.ob Y)) (T.GA.act Y X h w) w')
    : Id (W.Ix (T.PT.tobP Y w')) (T.PT.PathP.tact Y X h w w' e (path X w)) (path Y w') =
    idJ (W.Ix (T.GA.ob Y)) (T.GA.act Y X h w)
      (\ w2 e2 -> Id (W.Ix (T.PT.tobP Y w2)) (T.PT.PathP.tact Y X h w w2 e2 (path X w)) (path Y w2))
      (T.PT.path-eq Y (T.GA.act Y X h w) _ _
        (\ V f j -> pvnat Y X h w.1 (G.act Y X h w.1) (refl (G.act Y X h w.1)) w.2 V f j)) w' e ;
  opaque pvnat ; opaque enat ;
  res : PEl[T.GA, T.PT.PathP] = new PEl[T.GA, T.PT.PathP, path, enat] ;
} ;

module RightInverse (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  module P = CPostLimit[a, l].Post[G, A] ;
  module I = CPostNat[a, l].Inverse[G, A, c] ;
  module TL = PR.TyL[G, P.L] ;
  phi : HO.NMap[G, P.DA.DA, P.L] = P.phi ;
  psi : HO.NMap[G, P.L, P.DA.DA] = I.psi ;
  al : HO.NMap[G, P.L, P.L] = HO.compN G P.L P.DA.DA P.L psi phi ;
  be : HO.NMap[G, P.L, P.L] = HO.idN G P.L ;
  module At (X : Ob) (x : W.Ix (G.ob X)) (z : W.Ix (P.L.tob X x)) {
    module H = CPostAssemble[a, l].Homotopy[G, A, c, X, x, z] ;
    p : TL.EI H.XI = (H.xI, H.line) ;
    p0 : Id (TL.EI X) (TL.E.act X H.XI (lid X e0) p) (x, al.nfun X x z) =
      transH (TL.pr-tact X H.XI (lid X e0) H.xI x (H.elid e0) H.line)
        (apH {W.Ix (P.L.tob X x)} {TL.EI X} (\ v -> (x, v)) H.end0) ;
    p1 : Id (TL.EI X) (TL.E.act X H.XI (lid X e1) p) (x, z) =
      transH (TL.pr-tact X H.XI (lid X e1) H.xI x (H.elid e1) H.line)
        (apH {W.Ix (P.L.tob X x)} {TL.EI X} (\ v -> (x, v)) H.end1) ;
  } ;
  pn (Y X : Ob) (h : Hom Y X) (x : W.Ix (G.ob X)) (y : W.Ix (G.ob Y)) (e : Id (W.Ix (G.ob Y)) (G.act Y X h x) y)
    (z : W.Ix (P.L.tob X x)) : Id (TL.EI (prodP Y Iv))
      (TL.E.act (prodP Y Iv) (prodP X Iv) (crossH Y X Iv Iv h (idH Iv)) At[X, x, z].p)
      At[Y, y, P.L.tact Y X h x y e z].p =
    transH (TL.pr-tact (prodP Y Iv) (prodP X Iv) (crossH Y X Iv Iv h (idH Iv)) At[X, x, z].H.xI At[Y, y, P.L.tact Y X h x y e z].H.xI
      (CPostExt[a, l].Cross[Y, X, h].base G x y e) At[X, x, z].H.line)
      (apH {W.Ix (P.L.tob (prodP Y Iv) (G.act (prodP Y Iv) Y (pr1 Y Iv) y))} {TL.EI (prodP Y Iv)}
        (\ v -> (G.act (prodP Y Iv) Y (pr1 Y Iv) y, v)) (CPostHomNat[a, l].Nat[G, A, c, Y, X, h, x, y, e, z].nat)) ;
  module H = Cylinder[G, P.L, P.L, al, be, \ X x z -> At[X, x, z].p,
    \ X x z -> refl (G.act (prodP X Iv) X (pr1 X Iv) x), \ X x z -> At[X, x, z].p0, \ X x z -> At[X, x, z].p1, pn] ;
  homotopy : PEl[extP G P.L, HO.HT[G, P.L, P.L, al, be].PT.PathP] = H.res ;
} ;
