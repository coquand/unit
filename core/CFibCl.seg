-- CFibCl.seg (L4/L8, inside CB): the classifier Cl = Fib (model.tex §8.1:
-- "the classifier is Cl(G , A) = Fib(G , A)").  Substitution moves the
-- structure along the cart of A[s] into A (CFibSub); its laws are fibExt
-- (CFibExt) and the cart laws (CCartLaws): c[id] = c, c[s s'] = c[s][s'].
-- Coded because a composition is determined by its composites (CEnc).
--
-- Quarry: seg/model GUnivL (ClL, clSubL, clSub-idL, clSub-oL, encClL).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module GPR = GPre[a] ;
open GPR.PS ;
open Encode[a, a+] ;

Cl (G : PCtx) (A : PTy[G]) : U a+ = CLine[a].Lines[G, A].Fib ;

clSub (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) : Cl D (subTy D G A s) = CFibSub[a].FibSub[D, G, s, A].sub c ;

module FX = CFibExt[a] ;

-- the identity
module Sid (G : PCtx) (A : PTy[G]) (c : Cl G A) {
  q : FX.FX[G].Pack A.tob = ((subTy G G A (idS G)).tact, ((subTy G G A (idS G)).tact-id, (subTy G G A (idS G)).tact-o)) ;

  Ht : PtEq G A.tob A.tact q.1 = \ J I f x y e x' -> tact-irr G A J I f x y e (ntEq G G (idS G) J I f x y e) x' ;

  mn : FX.FX[G].NatTy A q = \ V W g v ->
    apH {W0.Ix (A.tob V (G.act V W g v.1))} {GPR.TyL[G, A].EI V} (\ z -> (G.act V W g v.1, z))
      (tact-irr G A V W g v.1 (G.act V W g v.1) (refl (G.act V W g v.1)) (ntEq G G (idS G) V W g v.1 (G.act V W g v.1) (refl (G.act V W g v.1))) v.2) ;

  law : Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c) =
    transH (FX.FX[G].fibExt A c q Ht mn)
      (apH {Cl G (subTy G G A (idS G))} {(A' : PTy[G]) * Cl G A'} (\ z -> (subTy G G A (idS G), z))
        (CCartLaws[a].CG[G, subTy G G A (idS G), G, A,
           \ W x -> x, \ V W g x -> refl (G.act V W g x), \ W v -> v, \ W v -> refl v.1, mn, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u),
           (idS G).nt, (idS G).nt-nat, CSub[a].SubE[G, G, (idS G), A].mV, \ W v -> refl ((idS G).nt W v.1), CSub[a].SubE[G, G, (idS G), A].mV-nat, CSub[a].SubE[G, G, (idS G), A].mV-inj, \ X x u -> u, \ X x u -> refl ((idS G).nt X x, u),
           \ W x -> refl x, \ W v -> refl v].congFib c)) ;
} ;

clSub-id (G : PCtx) (A : PTy[G]) (c : Cl G A) : Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c) =
  Sid[G, A, c].law ;

-- composition
module So (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A) {
  B : PTy[T] = subTy T G A (oS T D G s s') ;
  B2 : PTy[T] = subTy T D (subTy D G A s) s' ;

  q : FX.FX[T].Pack B.tob = (B2.tact, (B2.tact-id, B2.tact-o)) ;

  Ht : PtEq T B.tob B.tact q.1 = \ J I f x y e x' ->
    tact-irr G A J I f (s.nt I (s'.nt I x)) (s.nt J (s'.nt J y)) (ntEq T G (oS T D G s s') J I f x y e)
      (ntEq D G s J I f (s'.nt I x) (s'.nt J y) (ntEq T D s' J I f x y e)) x' ;

  mn : FX.FX[T].NatTy B q = \ V W g v ->
    apH {W0.Ix (B.tob V (T.act V W g v.1))} {GPR.TyL[T, B].EI V} (\ z -> (T.act V W g v.1, z))
      (Ht V W g v.1 (T.act V W g v.1) (refl (T.act V W g v.1)) v.2) ;

  module K1 = CCartLaws[a].CC[T, B2, T, B, G, A,
    \ W x -> x, \ V W g x -> refl (T.act V W g x), \ W v -> v, \ W v -> refl v.1, mn, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (x, u),
    (oS T D G s s').nt, (oS T D G s s').nt-nat, CSub[a].SubE[T, G, (oS T D G s s'), A].mV, \ W v -> refl ((oS T D G s s').nt W v.1), CSub[a].SubE[T, G, (oS T D G s s'), A].mV-nat, CSub[a].SubE[T, G, (oS T D G s s'), A].mV-inj, \ X x u -> u, \ X x u -> refl ((oS T D G s s').nt X x, u)] ;

  module K2 = CCartLaws[a].CC[T, B2, D, subTy D G A s, G, A,
    s'.nt, s'.nt-nat, CSub[a].SubE[T, D, s', (subTy D G A s)].mV, \ W v -> refl (s'.nt W v.1), CSub[a].SubE[T, D, s', (subTy D G A s)].mV-nat, CSub[a].SubE[T, D, s', (subTy D G A s)].mV-inj, \ X x u -> u, \ X x u -> refl (s'.nt X x, u),
    s.nt, s.nt-nat, CSub[a].SubE[D, G, s, A].mV, \ W v -> refl (s.nt W v.1), CSub[a].SubE[D, G, s, A].mV-nat, CSub[a].SubE[D, G, s, A].mV-inj, \ X x u -> u, \ X x u -> refl (s.nt X x, u)] ;

  law : Id ((A' : PTy[T]) * Cl T A') (B, clSub T G (oS T D G s s') A c) (B2, clSub T D s' (subTy D G A s) (clSub D G s A c)) =
    transH (FX.FX[T].fibExt B (clSub T G (oS T D G s s') A c) q Ht mn)
      (apH {Cl T B2} {(A' : PTy[T]) * Cl T A'} (\ z -> (B2, z))
        (calc (Cl T B2) {
            K1.C1.moveFib (K1.C2.moveFib c)
          =< K1.compFib c >
            K1.C12.moveFib c
          =< (CCartLaws[a].CG[T, B2, G, A,
                     K1.s, K1.s-nat, K1.ta, K1.tapt, K1.tanat, K1.tainj, K1.bk, K1.bkta,
                     K2.s, K2.s-nat, K2.ta, K2.tapt, K2.tanat, K2.tainj, K2.bk, K2.bkta,
                     \ W x -> refl (s.nt W (s'.nt W x)), \ W v -> refl (s.nt W (s'.nt W v.1), v.2)].congFib c) >
            K2.C12.moveFib c
          =< symH (K2.compFib c) >
            K2.C1.moveFib (K2.C2.moveFib c) })) ;
} ;

clSub-o (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
  : Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                  (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)) =
  So[T, D, G, s, s', A, c].law ;

-- the code: two compositions, each determined by its composites
encCl (X : Ob) (A : PTy[GYon[a].yP X]) : Enc (Cl (GYon[a].yP X) A) =
  encSig (CLine[a].Lines[GYon[a].yP X, A].CompK[e0, e1].Comp) (\ z -> CLine[a].Lines[GYon[a].yP X, A].CompK[e1, e0].Comp)
    (CEnc.encRC (CLine[a].Lines[GYon[a].yP X, A].CompK[e0, e1].EK.TV.E) (CLine[a].Lines[GYon[a].yP X, A].CompK[e0, e1].EK.SFm.SF)
       (CLine[a].Lines[GYon[a].yP X, A].CompK[e0, e1].Tend) (CLine[a].Lines[GYon[a].yP X, A].CompK[e0, e1].endL))
    (\ z -> CEnc.encRC (CLine[a].Lines[GYon[a].yP X, A].CompK[e1, e0].EK.TV.E) (CLine[a].Lines[GYon[a].yP X, A].CompK[e1, e0].EK.SFm.SF)
       (CLine[a].Lines[GYon[a].yP X, A].CompK[e1, e0].Tend) (CLine[a].Lines[GYon[a].yP X, A].CompK[e1, e0].endL)) ;

opaque encCl ;
