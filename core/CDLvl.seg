-- CDLvl.seg (L8, Delta): seg/model DLvl.seg ported (module names only).  Was: case analyses on Booleans and numbers (Trees / Arith at level
-- a) with values in a type of any level lv >= a (the level-generic Delta
-- files use them: Trees[a].or-elim and Arith[a].ltb-dec eliminate into U a
-- only).

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
open Trees[a] ;
open Arith[a] ;

orE (R : U lz) : (x y : Bool) -> IsT (or x y) -> (IsT x -> R) -> (IsT y -> R) -> R = split {
  true -> \ y h f g -> f (refl true) ;
  false -> \ y h f g -> g h } ;

bcaseL (R : U lz) : (b : Bool) -> (IsT b -> R) -> (Id Bool b false -> R) -> R = split {
  true -> \ kt kf -> kt (refl true) ;
  false -> \ kt kf -> kf (refl false) } ;

-- m < n , or n <= m
ltbDecL (R : U lz) (m n : Nat) (k1 : IsT (ltb m n) -> R) (k2 : IsT (leb n m) -> R) : R =
  bcaseL R (ltb m n) k1 (\ f -> k2 (lnl m n f))
 where { lnl (m' n' : Nat) (f : Id Bool (ltb m' n') false) : IsT (leb n' m') =
           ltb-dec (IsT (leb n' m')) m' n' (\ t -> absurd (IsT (leb n' m')) (false-true (transH (symH f) t))) (\ l -> l) ; } ;

-- m = n , or m /= n
eqNDecL (R : U lz) (m n : Nat) (k1 : Id Nat m n -> R) (k2 : IsT (not (eqN m n)) -> R) : R =
  bcaseL R (eqN m n) (\ t -> k1 (eqN-sound m n t)) (\ f -> k2 (substH (\ b -> IsT (not b)) (symH f) (refl true))) ;

