-- CFill.seg (L3, inside CB, level l): filling from composition (model.tex
-- Prop "filling from composition").  The value of the filler at (V , g , j)
-- is the composite of the problem CFillProb.Prob at the restricted data
-- and j; its end at src d is the start (the side on (j = src d)), it
-- agrees with the sides (the connected sides at j), and it is uniform
-- (the problem is, CFillProb.PU).
--
-- Quarry: seg/model GFill, GFillFib.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module FillC (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp) {
  module FP = CFillProb[l].FillP[G, A, d] ;
  module CK = CLine[l].Lines[G, A].CompK[src d, tgt d] ;
  module K = FP.K ;
  module FG = FP.FG ;
  module FA = FP.FA ;
  module EK = FP.EK ;
  module TA = FP.TA ;
  module TV = FP.TV ;
  module TS = FP.TS ;
  module PT = FP.PT ;
  module EK' = CLine[l].EndKit[G, A, tgt d] ;
  module EV' = FA.Ev[tgt d] ;
  module EV = FA.Ev[src d] ;
  module TT = GPR.TyL[TV.E, CK.Tend] ;
  module RC = CPartial[l].Rel[TV.E, EK.SFm.SF, CK.Tend, CK.endL] ;

  ----------------------------------------------------------------------
  -- composites of problems

  fin0 : Arith[a].Fin (suc (suc zero)) = (zero, refl true) ;
  fin1 : Arith[a].Fin (suc (suc zero)) = (suc zero, refl true) ;

  In (V : Ob) : U l = (w : TV.EI V) * PT.Side[V, w] ;

  rIn (V' V : Ob) (g : Hom V' V) (z : In V) : In V' = (TV.E.act V' V g z.1, PT.rside V' V g z.1 z.2) ;

  out (V : Ob) (z : In V) (j : Hom V Iv) : TT.EI V =
    (FP.Prob[V, z.1, z.2, j].w', ca.kop V FP.Prob[V, z.1, z.2, j].w' FP.Prob[V, z.1, z.2, j].side) ;

  -- read in A
  rd (V : Ob) (u : TT.EI V) : TA.EI V = EK'.endE V (CK.SE.mV V u) ;

  rd-act (V' V : Ob) (g : Hom V' V) (u : TT.EI V) : Id (TA.EI V') (rd V' (TT.E.act V' V g u)) (TA.E.act V' V g (rd V u)) =
    transH (apH (EK'.endE V') (symH (CK.SE.mV-nat V' V g u))) (EK'.endE-act V' V g (CK.SE.mV V u)) ;

  outU (V' V : Ob) (g : Hom V' V) (z : In V) (j : Hom V Iv)
    : Id (TT.EI V') (TT.E.act V' V g (out V z j)) (out V' (rIn V' V g z) (compH V' V Iv j g)) =
    transH (ca.kunif V' V g FP.Prob[V, z.1, z.2, j].w' FP.Prob[V, z.1, z.2, j].side)
      (RC.kop-cong ca V' (TV.E.act V' V g FP.Prob[V, z.1, z.2, j].w') FP.PU[V', V, g, z.1, z.2, j].P'.w'
         FP.PU[V', V, g, z.1, z.2, j].pt
         (PT.rside V' V g FP.Prob[V, z.1, z.2, j].w' FP.Prob[V, z.1, z.2, j].side) FP.PU[V', V, g, z.1, z.2, j].P'.side
         FP.PU[V', V, g, z.1, z.2, j].sd-eq) ;

  -- on a side containing the identity, the composite is the other end of
  -- that side's line
  compId (V : Ob) (z : In V) (j : Hom V Iv) (k : Arith[a].Fin (suc (suc zero)))
    (lk : Lands V V (FP.Prob[V, z.1, z.2, j].pick k.1).pQ (idH V))
    : Id (TA.EI V) (rd V (out V z j))
         ((EK.lineL V ((FP.Prob[V, z.1, z.2, j].pick k.1).pv V (idH V) lk)).2.1.1 V (idH V) (ptH V (tgt d))) =
    transH (apH (rd V)
      (transH (symH (TT.E.act-id V (out V z j)))
        (transH (ca.kside V FP.Prob[V, z.1, z.2, j].w' FP.Prob[V, z.1, z.2, j].side V (idH V) (FP.Prob[V, z.1, z.2, j].J.inS k V (idH V) lk))
                (apH (CK.endL.mE V) (FP.Prob[V, z.1, z.2, j].J.pv-in k V (idH V) lk (FP.Prob[V, z.1, z.2, j].J.inS k V (idH V) lk))))))
      (EV'.endB-E V (EK.lineL V ((FP.Prob[V, z.1, z.2, j].pick k.1).pv V (idH V) lk))) ;

  ----------------------------------------------------------------------
  -- the filler at (X , w0 , sd0)

  module F (X : Ob) (w0 : TV.EI X) (sd0 : PT.Side[X, w0]) {
    inp (V : Ob) (g : Hom V X) : In V = (TV.E.act V X g w0, PT.rside V X g w0 sd0) ;

    inp-o (V' V : Ob) (g : Hom V' V) (f : Hom V X) : Id (In V') (rIn V' V g (inp V f)) (inp V' (compH V' V X f g)) =
      symH (Sigma-path (TV.EI V') (\ z -> PT.Side[V', z]) (TV.E.act V' X (compH V' V X f g) w0) (TV.E.act V' V g (TV.E.act V X f w0))
              (PT.rside V' X (compH V' V X f g) w0 sd0) (PT.rside V' V g (TV.E.act V X f w0) (PT.rside V X f w0 sd0))
              (TV.E.act-o V' V X f g w0) (PT.rside-o V' V X g f w0 sd0)) ;

    t (V : Ob) (g : Hom V X) (j : Hom V Iv) : TA.EI V = rd V (out V (inp V g) j) ;

    tp (V : Ob) (g : Hom V X) (j : Hom V Iv) : Id (W0.Ix (G.ob V)) (t V g j).1 (w0.1.1 V g j) =
      transH (K.connG-tgt V (TV.E.act V X g w0).1 j) (apH (\ k -> w0.1.1 V k j) (comp-idr V X g)) ;

    tn (V' V : Ob) (g : Hom V' V) (f : Hom V X) (j : Hom V Iv)
      : Id (TA.EI V') (TA.E.act V' V g (t V f j)) (t V' (compH V' V X f g) (compH V' V Iv j g)) =
      transH (symH (rd-act V' V g (out V (inp V f) j)))
        (apH (rd V') (transH (outU V' V g (inp V f) j) (apH (\ z -> out V' z (compH V' V Iv j g)) (inp-o V' V g f)))) ;

    line : W0.Ix (FA.tobF X w0.1) = FA.lamA X w0.1 t tp tn ;

    -- at src d the filler is the start: the side on (j = src d) contains id
    l0 : Lands X X (pre X Iv (ptH X (src d)) (ptS (src d))) (idH X) =
      pre-lands X X Iv (ptH X (src d)) (ptS (src d)) (idH X)
        (lands-eq X Iv (ptS (src d)) (ptH X (src d)) (compH X X Iv (ptH X (src d)) (idH X)) (symH (comp-idr X Iv (ptH X (src d))))
           (pt-lands X (src d))) ;

    module P0 = FP.Prob[X, (inp X (idH X)).1, (inp X (idH X)).2, ptH X (src d)] ;

    endEq : Id (TA.EI X) (t X (idH X) (ptH X (src d))) (EK.endE X w0) =
      transH (compId X (inp X (idH X)) (ptH X (src d)) fin0 l0)
       (transH (apH (\ L -> L.2.1.1 X (idH X) (ptH X (tgt d)))
                  (EK.mkTS-line X (TV.E.act X X (idH X) P0.w') (K.constA X (P0.z0 X (idH X))) (P0.p0 X (idH X) l0) (P0.q0 X (idH X))))
        (transH (TA.E.act-id X (P0.z0 X (idH X)))
         (transH (apH (EK.endE X) (TV.E.act-id X P0.w'))
          (transH P0.w'-E (apH (EK.endE X) (TV.E.act-id X w0)))))) ;

    kopv : W0.Ix (EK.SFm.sfOb X w0) =
      (line, EK.tv-eq X (EV.evA.mE X (w0.1, line)) w0 (refl w0.1)
               (transH (EV.endB-E X (w0.1, line)) endEq)) ;

    -- on the sieve of sd0 the filler is sd0: there the connected side
    -- contains id

    lk (W : Ob) (f : Hom W X) (i : Lands W X sd0.pQ f) (V : Ob) (g : Hom V W)
      : Lands V V (pre V X (compH V W X f g) sd0.pQ) (idH V) =
      pre-lands V V X (compH V W X f g) sd0.pQ (idH V)
        (lands-eq V X sd0.pQ (compH V W X f g) (compH V V X (compH V W X f g) (idH V)) (symH (comp-idr V X (compH V W X f g)))
          (lands-comp V W X sd0.pQ f g i)) ;

    sideVal (W : Ob) (f : Hom W X) (i : Lands W X sd0.pQ f) (V : Ob) (g : Hom V W) (j : Hom V Iv)
      : Id (TA.EI V) (t V (compH V W X f g) j) ((EK.lineL W (sd0.pv W f i)).2.1.1 V g j) =
      transH (compId V (inp V (compH V W X f g)) j fin1 (lk W f i V g))
       (transH (apH (\ L -> L.2.1.1 V (idH V) (ptH V (tgt d)))
                  (EK.mkTS-line V (TV.E.act V V (idH V) FP.Prob[V, (inp V (compH V W X f g)).1, (inp V (compH V W X f g)).2, j].w')
                     (K.connA V (EK.lineL V (sd0.pv V (compH V V X (compH V W X f g) (idH V)) (lands-pre V V X (compH V W X f g) sd0.pQ (idH V) (lk W f i V g))))
                        (compH V V Iv j (idH V)))
                     (FP.Prob[V, (inp V (compH V W X f g)).1, (inp V (compH V W X f g)).2, j].p1 V (idH V) (lk W f i V g))
                     (FP.Prob[V, (inp V (compH V W X f g)).1, (inp V (compH V W X f g)).2, j].q1 V (idH V) (lk W f i V g))))
        (transH (apH {Hom V Iv} {TA.EI V}
                   (\ k -> (EK.lineL V (sd0.pv V (compH V V X (compH V W X f g) (idH V)) (lands-pre V V X (compH V W X f g) sd0.pQ (idH V) (lk W f i V g)))).2.1.1 V (idH V) k)
                   (transH (cI-jtgt d V (compH V V Iv (compH V V Iv j (idH V)) (idH V)))
                     (transH (comp-idr V Iv (compH V V Iv j (idH V))) (comp-idr V Iv j))))
         (transH (apH (\ u -> (EK.lineL V u).2.1.1 V (idH V) j)
                    (transH (PT.pv-hom X w0 sd0 V (compH V V X (compH V W X f g) (idH V)) (compH V W X f g) (comp-idr V X (compH V W X f g))
                               (lands-pre V V X (compH V W X f g) sd0.pQ (idH V) (lk W f i V g)) (lands-comp V W X sd0.pQ f g i))
                            (symH (sd0.pnat V W g f i (lands-comp V W X sd0.pQ f g i)))))
          (transH (apH (\ L -> L.2.1.1 V (idH V) j) (EK.lineL-act V W g (sd0.pv W f i)))
                  (apH (\ k -> (EK.lineL W (sd0.pv W f i)).2.1.1 V k j) (comp-idr V W g)))))) ;
  } ;

  kop (X : Ob) (w0 : TV.EI X) (sd0 : PT.Side[X, w0]) : W0.Ix (EK.SFm.sfOb X w0) = F[X, w0, sd0].kopv ;

  kside (X : Ob) (w0 : TV.EI X) (sd0 : PT.Side[X, w0]) (W : Ob) (f : Hom W X) (i : Lands W X sd0.pQ f)
    : Id (TS.EI W) (TS.E.act W X f (w0, kop X w0 sd0)) (sd0.pv W f i) =
    EK.ts-ext W (TS.E.act W X f (w0, kop X w0 sd0)) (sd0.pv W f i) (symH (sd0.ppt W f i))
      (\ V g j -> transH (apH (\ L -> L.2.1.1 V g j) (EK.lineL-act W X f (w0, kop X w0 sd0))) (F[X, w0, sd0].sideVal W f i V g j)) ;

  kunif (Y X : Ob) (h : Hom Y X) (w0 : TV.EI X) (sd0 : PT.Side[X, w0])
    : Id (TS.EI Y) (TS.E.act Y X h (w0, kop X w0 sd0)) (TV.E.act Y X h w0, kop Y (TV.E.act Y X h w0) (PT.rside Y X h w0 sd0)) =
    EK.ts-ext Y (TS.E.act Y X h (w0, kop X w0 sd0)) (TV.E.act Y X h w0, kop Y (TV.E.act Y X h w0) (PT.rside Y X h w0 sd0))
      (refl (TV.E.act Y X h w0))
      (\ V g j -> transH (apH (\ L -> L.2.1.1 V g j) (EK.lineL-act Y X h (w0, kop X w0 sd0)))
         (apH (\ z -> rd V (out V z j)) (symH (F[X, w0, sd0].inp-o V Y g h)))) ;

  opaque kside ; opaque kunif ;

  -- the filler
  fill : CLine[l].Lines[G, A].Fill (src d) =
    new CPartial[l].Rel[TV.E, EK.SFm.SF, EK.SFm.SF, CPartial[l].pmap-id TV.E EK.SFm.SF].RC[kop, kside, kunif] ;
} ;
