-- CUaD.seg (L6, inside CB): step (a) of univalence (model.tex Thm ua,
-- proof (a)).  A partial element u of Ua at F on the sieve ph is a family
-- of full glue data u_f over F f, natural.  The glue datum d at X with
-- d f = u_f: through the map ell : RC(X , ph) -> resCtx, (f , q) |->
-- (u_f , full), its B is El of the universal B along ell, its alpha the
-- universal alpha read back through the A-cart At(d) -> A_U over ell, and
-- its equivalence the universal e_U moved along the cart of triples (so
-- the gluing of the e_f is e_U's).
--
-- Quarry: seg/model GUaPt, GUaUniv (the data of a partial element).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module UaD (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (X : Ob) (F : CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].U0 X)
  (u : CPartial[a+].Partials[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx,
                             CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl].UaTy].Side[X, F]) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UA = CUa.UaU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module PU = CPartial[a+].Partials[UU.UCtx, UA.UaTy] ;
  module R = CGlueE.RCm[X, u.pQ] ;
  RES : L.PCtx = UB.CU.resCtx ;

  ph : Phi X = u.pQ ;

  lnd (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X ph W f)) : Lands W X ph f = CEnc.chiLands W X ph f q ;

  vv (W : Ob) (r : W0.Ix (R.RC.ob W)) : LP.TyL[UU.UCtx, UA.UaTy].EI W = u.pv W r.1 (lnd W r.1 r.2) ;

  -- the point of the full extent at r
  ell (W : Ob) (r : W0.Ix (R.RC.ob W)) : V1.Ix (RES.ob W) = ((vv W r).2.1, (vv W r).2.2.2) ;

  ell-nat (V W : Ob) (k : Hom V W) (r : W0.Ix (R.RC.ob W)) : Id (V1.Ix (RES.ob V)) (ell V (R.RC.act V W k r)) (RES.act V W k (ell W r)) =
    UB.CU.res-eq V (ell V (R.RC.act V W k r)) (RES.act V W k (ell W r))
      (symH (apH (\ z -> z.2.1) (u.pnat V W k r.1 (lnd W r.1 r.2) (lnd V (R.RC.act V W k r).1 (R.RC.act V W k r).2)))) ;

  ellS : CSmall.XSub[R.RC, RES] = new CSmall.XSub[R.RC, RES, ell, ell-nat] ;

  -- the A-code of u_f is F f
  PF (W : Ob) (r : W0.Ix (R.RC.ob W)) : Id (UU.U0 W) (ell W r).1.1.1 (UU.uAct W X r.1 F) =
    transH (vv W r).2.2.1 (u.ppt W r.1 (lnd W r.1 r.2)) ;

  ----------------------------------------------------------------------
  -- B: the universal B along ell

  B (W : Ob) (f : Hom W X) (q : IsT (CGlueD.fl X ph W f)) : UU.U0 W = UB.bmap.nt W (ell W (f, q)) ;

  bn : DD.BNat X ph B = \ W' W chi f q f2 E q2 ->
    transH (symH (UB.bmap.nt-nat W' W chi (ell W (f, q))))
      (transH (apH (UB.bmap.nt W') (symH (ell-nat W' W chi (f, q))))
              (apH (\ r -> UB.bmap.nt W' (ell W' r)) (R.pt-eq W' (R.RC.act W' W chi (f, q)) (f2, q2) E))) ;

  ----------------------------------------------------------------------
  -- the A-cart: At(d) over RC(X , ph) -> A_U over ell

  At0 : PTy[R.RC] = subTy R.RC (yP X) F.1 R.inclRC ;
  module TAt = GPR.TyL[R.RC, At0] ;

  o (W : Ob) (k : Hom W X) : W0.V = F.1.tob W k ;

  trH (W : Ob) (k k' : Hom W X) (p : Id (Hom W X) k k') (z : W0.Ix (o W k)) : W0.Ix (o W k') =
    subst (Hom W X) (\ k2 -> W0.Ix (o W k2)) k k' p z ;

  trH-V (W : Ob) (k k' : Hom W X) (p : Id (Hom W X) k k') (z : W0.Ix (o W k))
    : Id (W0.Ix (o W k')) (trH W k k' p z) (CExtEq1.sV (o W k) (o W k') (apH (o W) p) z) =
    subst-ap (Hom W X) W0.V (o W) (\ v -> W0.Ix v) k k' p z ;

  trB (W : Ob) (G G' : UU.U0 W) (p : Id (UU.U0 W) G G') (b : W0.Ix (UU.fib0 W G)) : W0.Ix (UU.fib0 W G') =
    subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) G G' p b ;

  -- a value of F at f, read in u_f's A-code at the identity
  toA (W : Ob) (r : W0.Ix (R.RC.ob W)) (a : W0.Ix (o W r.1)) : W0.Ix (UU.fib0 W (ell W r).1.1.1) =
    trB W (UU.uAct W X r.1 F) (ell W r).1.1.1 (symH (PF W r)) (trH W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a) ;

  fromA (W : Ob) (r : W0.Ix (R.RC.ob W)) (z : W0.Ix (UU.fib0 W (ell W r).1.1.1)) : W0.Ix (o W r.1) =
    trH W (compH W W X r.1 (idH W)) r.1 (symH (symH (comp-idr W X r.1)))
      (trB W (ell W r).1.1.1 (UU.uAct W X r.1 F) (symH (symH (PF W r))) z) ;

  fromA-toA (W : Ob) (r : W0.Ix (R.RC.ob W)) (a : W0.Ix (o W r.1)) : Id (W0.Ix (o W r.1)) (fromA W r (toA W r a)) a =
    transH (apH (trH W (compH W W X r.1 (idH W)) r.1 (symH (symH (comp-idr W X r.1))))
              (CExtEq1.subst-round (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (UU.uAct W X r.1 F) (ell W r).1.1.1 (symH (PF W r))
                 (trH W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a)))
           (CExtEq1.subst-round (Hom W X) (\ k2 -> W0.Ix (o W k2)) r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a) ;

  toA-fromA (W : Ob) (r : W0.Ix (R.RC.ob W)) (z : W0.Ix (UU.fib0 W (ell W r).1.1.1)) : Id (W0.Ix (UU.fib0 W (ell W r).1.1.1)) (toA W r (fromA W r z)) z =
    transH (apH (trB W (UU.uAct W X r.1 F) (ell W r).1.1.1 (symH (PF W r)))
              (CExtEq1.subst-round' (Hom W X) (\ k2 -> W0.Ix (o W k2)) r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1))
                 (trB W (ell W r).1.1.1 (UU.uAct W X r.1 F) (symH (symH (PF W r))) z)))
           (CExtEq1.subst-round' (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (UU.uAct W X r.1 F) (ell W r).1.1.1 (symH (PF W r)) z) ;

  opaque fromA-toA ; opaque toA-fromA ;

  -- toA is a transport along a path of codes
  toAV (W : Ob) (r : W0.Ix (R.RC.ob W)) (a : W0.Ix (o W r.1))
    : Id (W0.Ix (UU.fib0 W (ell W r).1.1.1)) (toA W r a)
         (CExtEq1.sV (o W r.1) (UU.fib0 W (ell W r).1.1.1)
            (transH (apH (o W) (symH (comp-idr W X r.1))) (apH (UU.fib0 W) (symH (PF W r)))) a) =
    transH (UU.substF W (UU.uAct W X r.1 F) (ell W r).1.1.1 (symH (PF W r)) (trH W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a))
      (transH (apH (CExtEq1.sV (o W (compH W W X r.1 (idH W))) (UU.fib0 W (ell W r).1.1.1) (apH (UU.fib0 W) (symH (PF W r))))
                 (trH-V W r.1 (compH W W X r.1 (idH W)) (symH (comp-idr W X r.1)) a))
              (CExtEq1.sV-comp (o W r.1) (o W (compH W W X r.1 (idH W))) (UU.fib0 W (ell W r).1.1.1)
                 (apH (o W) (symH (comp-idr W X r.1))) (apH (UU.fib0 W) (symH (PF W r))) a)) ;

  opaque toAV ;

  tA (W : Ob) (v : TAt.EI W) : UB.TAU.EI W = (ell W v.1, toA W v.1 v.2) ;

  codeA (V : Ob) (y : V1.Ix (RES.ob V)) : W0.V = UU.fib0 V y.1.1.1 ;

  -- pairs over codes, one level up
  pair-eqV1 (Xt : U a+) (code : Xt -> W0.V) (x x' : Xt) (Rp : Id Xt x x') (z : W0.Ix (code x)) (z' : W0.Ix (code x'))
    (c : Id W0.V (code x) (code x')) (H : Id (W0.Ix (code x')) (CExtEq1.sV (code x) (code x') c z) z')
    : Id ((y : Xt) * W0.Ix (code y)) (x, z) (x', z') =
    idJ Xt x
      (\ x2 R2 -> (z2 : W0.Ix (code x2)) (c2 : Id W0.V (code x) (code x2))
         -> Id (W0.Ix (code x2)) (CExtEq1.sV (code x) (code x2) c2 z) z2 -> Id ((y : Xt) * W0.Ix (code y)) (x, z) (x2, z2))
      (\ z2 c2 H2 -> apH {W0.Ix (code x)} {(y : Xt) * W0.Ix (code y)} (\ w -> (x, w))
         (transH (CExtEq1.sV-irr (code x) (code x) (refl (code x)) c2 z) H2))
      x' Rp z' c H ;

  opaque pair-eqV1 ;

  module NA (V W : Ob) (g : Hom V W) (v : TAt.EI W) {
    f : Hom W X = v.1.1 ;
    x : V1.Ix (RES.ob V) = RES.act V W g (ell W v.1) ;
    x' : V1.Ix (RES.ob V) = ell V (R.RC.act V W g v.1) ;
    G : UU.U0 W = (ell W v.1).1.1.1 ;
    y0 : Hom V W = compH V V W g (idH V) ;
    eP : Id (UU.U0 V) (UU.uAct V W g G) x.1.1.1 =
      L.ntEq UB.GDr UU.UCtx UB.pA V W g (ell W v.1).1 x.1 (L.ntEq RES UB.GDr UB.CU.inclR V W g (ell W v.1) x (refl x)) ;
    pL : Id (Hom V X) (compH V W X (compH W W X f (idH W)) g) (compH V W X f y0) =
      ntEq (yP W) (yP X) (yH W X f) V W g (idH W) y0 (UU.idf-eq V W g) ;
    eR : Id (Hom V X) (compH V W X f g) (compH V W X f g) =
      ntEq R.RC (yP X) R.inclRC V W g v.1 (R.RC.act V W g v.1) (refl (R.RC.act V W g v.1)) ;
    e' : Id (Hom V X) (compH V W X f g) (compH V W X f y0) = apH (compH V W X f) (symH (comp-idr V W g)) ;
    T : W0.Ix (o V (compH V W X f g)) = F.1.tact V W g f (compH V W X f g) eR v.2 ;
    z0 : W0.Ix (o W (compH W W X f (idH W))) = trH W f (compH W W X f (idH W)) (symH (comp-idr W X f)) v.2 ;
    Xin : W0.Ix (o V (compH V W X f y0)) = F.1.tact V W g (compH W W X f (idH W)) (compH V W X f y0) pL z0 ;

    Xin-T : Id (W0.Ix (o V (compH V W X f y0))) Xin (CExtEq1.sV (o V (compH V W X f g)) (o V (compH V W X f y0)) (apH (o V) e') T) =
      transH (UU.tact-src-move (yP X) F.1 V W g f (compH W W X f (idH W)) (compH V W X f y0) (symH (comp-idr W X f)) pL e' v.2)
       (transH (symH (UU.tact-move (yP X) F.1 V W g f (compH V W X f g) (compH V W X f y0) eR e' e' v.2))
               (trH-V V (compH V W X f g) (compH V W X f y0) e' T)) ;

    Q : Id (UU.U0 V) (UU.uAct V W g (UU.uAct W X f F)) x.1.1.1 = transH (apH (UU.uAct V W g) (symH (PF W v.1))) eP ;

    -- the two sides as transports of T
    LHS2 : Id (W0.Ix (codeA V x)) (UB.AU'.tact V W g (ell W v.1) x (refl x) (tA W v).2)
                                 (CExtEq1.sV (o V (compH V W X f y0)) (codeA V x) (apH (UU.fib0 V) Q) Xin) =
      transH (symH (E1.tactG-cong V W g (UU.uAct W X f F) G (symH (PF W v.1)) (UU.uAct V W g (UU.uAct W X f F)) x.1.1.1 Q
                      (refl (UU.uAct V W g (UU.uAct W X f F))) eP z0))
             (UU.substF V (UU.uAct V W g (UU.uAct W X f F)) x.1.1.1 Q Xin) ;

    c2 : Id W0.V (o V (compH V W X f g)) (o V (compH V W X f y0)) = apH (o V) e' ;
    q1 : Id W0.V (o V (compH V W X f y0)) (codeA V x) = apH (UU.fib0 V) Q ;
    c3 : Id W0.V (o V (compH V W X f g)) (o V (compH V V X (compH V W X f g) (idH V))) = apH (o V) (symH (comp-idr V X (compH V W X f g))) ;
    q2 : Id W0.V (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') = apH (UU.fib0 V) (symH (PF V (R.RC.act V W g v.1))) ;
    c : Id W0.V (codeA V x) (codeA V x') = transH (symH (transH c2 q1)) (transH c3 q2) ;

    RHS2 : Id (W0.Ix (codeA V x')) (tA V (TAt.E.act V W g v)).2
                                  (CExtEq1.sV (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') q2
                                     (CExtEq1.sV (o V (compH V W X f g)) (o V (compH V V X (compH V W X f g) (idH V))) c3 T)) =
      transH (UU.substF V (UU.uAct V X (compH V W X f g) F) x'.1.1.1 (symH (PF V (R.RC.act V W g v.1)))
                (trH V (compH V W X f g) (compH V V X (compH V W X f g) (idH V)) (symH (comp-idr V X (compH V W X f g))) T))
             (apH (CExtEq1.sV (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') q2)
                (trH-V V (compH V W X f g) (compH V V X (compH V W X f g) (idH V)) (symH (comp-idr V X (compH V W X f g))) T)) ;

    res : Id (UB.TAU.EI V) (UB.TAU.E.act V W g (tA W v)) (tA V (TAt.E.act V W g v)) =
      pair-eqV1 (V1.Ix (RES.ob V)) (codeA V) x x' (symH (ell-nat V W g v.1))
        (UB.AU'.tact V W g (ell W v.1) x (refl x) (tA W v).2) (tA V (TAt.E.act V W g v)).2 c
        (transH (apH (CExtEq1.sV (codeA V x) (codeA V x') c)
                   (transH LHS2 (apH (CExtEq1.sV (o V (compH V W X f y0)) (codeA V x) q1) Xin-T)))
          (transH (apH (CExtEq1.sV (codeA V x) (codeA V x') c) (CExtEq1.sV-comp (o V (compH V W X f g)) (o V (compH V W X f y0)) (codeA V x) c2 q1 T))
            (transH (CExtEq1.sV-two (o V (compH V W X f g)) (codeA V x) (codeA V x') (transH c2 q1) c (transH c3 q2) T)
              (transH (symH (CExtEq1.sV-comp (o V (compH V W X f g)) (o V (compH V V X (compH V W X f g) (idH V))) (codeA V x') c3 q2 T))
                      (symH RHS2))))) ;
  } ;

  tAnat (V W : Ob) (g : Hom V W) (v : TAt.EI W) : Id (UB.TAU.EI V) (UB.TAU.E.act V W g (tA W v)) (tA V (TAt.E.act V W g v)) =
    NA[V, W, g, v].res ;

  opaque tAnat ;

  tAinj (W : Ob) (v v' : TAt.EI W) (P : Id (W0.Ix (R.RC.ob W)) v.1 v'.1) (Qp : Id (UB.TAU.EI W) (tA W v) (tA W v')) : Id (TAt.EI W) v v' =
    idJ (W0.Ix (R.RC.ob W)) v.1
      (\ r2 P2 -> (b2 : W0.Ix (At0.tob W r2)) -> Id (UB.TAU.EI W) (tA W v) (tA W (r2, b2)) -> Id (TAt.EI W) v (r2, b2))
      (\ b2 Q2 -> apH {W0.Ix (At0.tob W v.1)} {TAt.EI W} (\ z -> (v.1, z))
         (transH (symH (fromA-toA W v.1 v.2))
           (transH (apH (fromA W v.1) (UB.TAU.pr-inj W (ell W v.1) (toA W v.1 v.2) (toA W v.1 b2) Q2)) (fromA-toA W v.1 b2))))
      v'.1 P v'.2 Qp ;

  bkAta (Y : Ob) (r : W0.Ix (R.RC.ob Y)) (z : V1.Ix (UB.AU'.tob Y (ell Y r))) : Id (UB.TAU.EI Y) (tA Y (r, fromA Y r z)) (ell Y r, z) =
    apH {W0.Ix (UU.fib0 Y (ell Y r).1.1.1)} {UB.TAU.EI Y} (\ w -> (ell Y r, w)) (toA-fromA Y r z) ;

  opaque tAinj ; opaque bkAta ;

  -- the universal B action at a moved point
  tbU (V W : Ob) (g : Hom V W) (x : V1.Ix (RES.ob W)) (y : V1.Ix (RES.ob V)) (P : Id (V1.Ix (RES.ob V)) (RES.act V W g x) y)
    (ep : Id (UU.U0 V) (UU.uAct V W g (UB.bmap.nt W x)) (UB.bmap.nt V y)) (b : W0.Ix (UU.fib0 W (UB.bmap.nt W x)))
    : Id (UB.TBU.EI V) (UB.TBU.E.act V W g (x, b)) (y, UU.tactG V W g (UB.bmap.nt W x) (UB.bmap.nt V y) ep b) =
    idJ (V1.Ix (RES.ob V)) (RES.act V W g x)
      (\ y2 P2 -> (ep2 : Id (UU.U0 V) (UU.uAct V W g (UB.bmap.nt W x)) (UB.bmap.nt V y2))
         -> Id (UB.TBU.EI V) (UB.TBU.E.act V W g (x, b)) (y2, UU.tactG V W g (UB.bmap.nt W x) (UB.bmap.nt V y2) ep2 b))
      (\ ep2 -> apH {W0.Ix (UU.fib0 V (UB.bmap.nt V (RES.act V W g x)))} {UB.TBU.EI V} (\ z -> (RES.act V W g x, z))
         (CSmall.tact-irr UU.UCtx UU.El V W g (UB.bmap.nt W x) (UB.bmap.nt V (RES.act V W g x))
            (L.ntEq RES UU.UCtx UB.bmap V W g x (RES.act V W g x) (refl (RES.act V W g x))) ep2 b))
      y P ep ;

  opaque tbU ;

  ----------------------------------------------------------------------
  -- the B-cart (identity on fibres) and the glue datum

  Bt0 : PTy[R.RC] = GE.BtOf X ph B bn ;
  module TBt = GPR.TyL[R.RC, Bt0] ;

  tB (W : Ob) (v : TBt.EI W) : UB.TBU.EI W = (ell W v.1, v.2) ;

  tBnat (V W : Ob) (g : Hom V W) (v : TBt.EI W) : Id (UB.TBU.EI V) (UB.TBU.E.act V W g (tB W v)) (tB V (TBt.E.act V W g v)) =
    tbU V W g (ell W v.1) (ell V (R.RC.act V W g v.1)) (symH (ell-nat V W g v.1))
      (bn V W g v.1.1 v.1.2 (R.RC.act V W g v.1).1 (apH (\ z -> z.1) (refl (R.RC.act V W g v.1))) (R.RC.act V W g v.1).2) v.2 ;

  tBinj (W : Ob) (v v' : TBt.EI W) (P : Id (W0.Ix (R.RC.ob W)) v.1 v'.1) (Qp : Id (UB.TBU.EI W) (tB W v) (tB W v')) : Id (TBt.EI W) v v' =
    idJ (W0.Ix (R.RC.ob W)) v.1
      (\ r2 P2 -> (b2 : W0.Ix (Bt0.tob W r2)) -> Id (UB.TBU.EI W) (tB W v) (tB W (r2, b2)) -> Id (TBt.EI W) v (r2, b2))
      (\ b2 Q2 -> apH {W0.Ix (Bt0.tob W v.1)} {TBt.EI W} (\ z -> (v.1, z)) (UB.TBU.pr-inj W (ell W v.1) v.2 b2 Q2))
      v'.1 P v'.2 Qp ;

  opaque tBnat ; opaque tBinj ;

  module GC = CGlueCart.GC[Cl, clSub, clSub-id, clSub-o, encCl, X, F, ph, B, bn,
    RES, UB.BU, UB.AU', UB.alU, CExtEq2.EQ2[Cl, clSub, clSub-id, clSub-o, encCl].eqU, ell, ell-nat,
    tA, \ W v -> refl (ell W v.1), tAnat, tAinj, fromA, bkAta,
    tB, \ W v -> refl (ell W v.1), tBnat, tBinj, \ Y x z -> z, \ Y x z -> refl (ell Y x, z)] ;

  -- the glue datum of the partial element: e_U along ell
  d : GE.GD1 X = GC.dat ;
} ;
