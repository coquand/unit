-- CExtU.seg (L5, inside CB; quarry seg/model GExtU): the local Ext data of a
-- point of the glue data.  A point D at stage I gives Ext data over y I:
--   psiD   the cofibration of y I given by D's sieve (mkCof)
--   BD     D's B over the extent (Bt of GGlueE along toRC)
--   alD    D's alpha as a map of types over the extent
-- (GExtCmp compares the fibre of Ext of these data with ExtBig's.)

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module GP = CCof[a] ;

-- the cofibration of y I given by a sieve of I
psiD (I : Ob) (ph : Phi I) : GP.Cof[yP I] =
  GP.mkCof (yP I) (\ X g -> pre X I g ph) (\ Y X k g -> symH (pre-comp Y X I k g ph)) ;

-- a map in the extent of psiD lands in the sieve
toFl (I : Ob) (ph : Phi I) (Y : Ob) (g : Hom Y I) (p : IsT (GP.CofL[yP I, psiD I ph].full Y g))
  : IsT (CGlueD.fl I ph Y g) =
  allS-complete Y (pre Y I g ph) (GP.CofL[yP I, psiD I ph].full-id Y g p) ;

opaque toFl ;

toRC (I : Ob) (ph : Phi I) : PSub[GP.CofL[yP I, psiD I ph].resCtx, CGlueE.RCm[I, ph].RC] =
  new PSub[GP.CofL[yP I, psiD I ph].resCtx, CGlueE.RCm[I, ph].RC, \ Y w -> (w.1, toFl I ph Y w.1 w.2),
    \ Y' Y k w -> CGlueE.RCm[I, ph].pt-eq Y' _ _ (refl (compH Y' Y I w.1 k))] ;

module XU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module EE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;

  ----------------------------------------------------------------------
  -- the Ext data over y I of glue data at stage I

  module Dat (I : Ob) (A : UU.U0 I) (ph : Phi I) (bd : DD.BD I A ph) {
    module CL = GP.CofL[yP I, psiD I ph] ;
    module T = EE.Tr[I, A, ph, bd] ;

    BD : PTy[CL.resCtx] = subTy CL.resCtx T.R.RC T.Bt (toRC I ph) ;

    AD : PTy[CL.resCtx] = subTy CL.resCtx (yP I) A.1 CL.inclR ;

    module TBD = GPR.TyL[CL.resCtx, BD] ;
    module TAD = GPR.TyL[CL.resCtx, AD] ;

    alE (Y : Ob) (w : TBD.EI Y) : TAD.EI Y = (w.1, bd.2.2.1 Y w.1.1 (toFl I ph Y w.1.1 w.1.2) w.2) ;

    alN (Y' Y : Ob) (k : Hom Y' Y) (w : TBD.EI Y) : Id (TAD.EI Y') (alE Y' (TBD.E.act Y' Y k w)) (TAD.E.act Y' Y k (alE Y w)) =
      apH {W0.Ix (A.1.tob Y' (compH Y' Y I w.1.1 k))} {TAD.EI Y'} (\ z -> (CL.resCtx.act Y' Y k w.1, z))
        (transH (bd.2.2.2 Y' Y k w.1.1 (toFl I ph Y w.1.1 w.1.2) (compH Y' Y I w.1.1 k)
                   (apH (\ z -> z.1) (ntEq CL.resCtx T.R.RC (toRC I ph) Y' Y k w.1 (CL.resCtx.act Y' Y k w.1) (refl (CL.resCtx.act Y' Y k w.1))))
                   (toFl I ph Y' (compH Y' Y I w.1.1 k) (CL.resCtx.act Y' Y k w.1).2) w.2)
           (tact-irr (yP I) A.1 Y' Y k w.1.1 (compH Y' Y I w.1.1 k)
              (apH (\ z -> z.1) (ntEq CL.resCtx T.R.RC (toRC I ph) Y' Y k w.1 (CL.resCtx.act Y' Y k w.1) (refl (CL.resCtx.act Y' Y k w.1))))
              (ntEq CL.resCtx (yP I) CL.inclR Y' Y k w.1 (CL.resCtx.act Y' Y k w.1) (refl (CL.resCtx.act Y' Y k w.1)))
              (bd.2.2.1 Y w.1.1 (toFl I ph Y w.1.1 w.1.2) w.2))) ;

    alD : CPartial[a].PMap[CL.resCtx, BD, AD] = new CPartial[a].PMap[CL.resCtx, BD, AD, alE, \ Y w -> refl w.1, alN] ;

    ExtD : PTy[yP I] = CExt2[a].ExtB2[yP I, A.1, psiD I ph, BD, alD].ExtT ;
  } ;

  tactGcong (V W : Ob) (g : Hom V W) (F1 F1' : UU.U0 W) (P : Id (UU.U0 W) F1 F1') (F2 F2' : UU.U0 V) (Q : Id (UU.U0 V) F2 F2')
    (e : Id (UU.U0 V) (UU.uAct V W g F1) F2) (e' : Id (UU.U0 V) (UU.uAct V W g F1') F2') (z : W0.Ix (UU.fib0 W F1))
    : Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                (UU.tactG V W g F1' F2' e' (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F1' P z)) =
    idJ (UU.U0 W) F1
      (\ F3 P3 -> (e3 : Id (UU.U0 V) (UU.uAct V W g F3) F2')
         -> Id (W0.Ix (UU.fib0 V F2')) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F2' Q (UU.tactG V W g F1 F2 e z))
                                      (UU.tactG V W g F3 F2' e3 (subst (UU.U0 W) (\ G' -> W0.Ix (UU.fib0 W G')) F1 F3 P3 z)))
      (\ e3 -> idJ (UU.U0 V) F2
         (\ F4 Q4 -> (e4 : Id (UU.U0 V) (UU.uAct V W g F1) F4)
            -> Id (W0.Ix (UU.fib0 V F4)) (subst (UU.U0 V) (\ G' -> W0.Ix (UU.fib0 V G')) F2 F4 Q4 (UU.tactG V W g F1 F2 e z))
                                        (UU.tactG V W g F1 F4 e4 z))
         (\ e4 -> CSmall.tact-irr UU.UCtx UU.El V W g F1 F2 e e4 z) F2' Q e3)
      F1' P e' ;

  opaque tactGcong ;
} ;
