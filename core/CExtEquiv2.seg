-- CExtEquiv2.seg (L5, inside CB, level l): Theorem 7, ext is an
-- equivalence, steps (2)-(3) (model.tex §6.1): ONE partial line in A over
-- the constant line at rho, total at e1, whose side is the join of the
-- lines of p (on its sieve) and the lines of theta (on psi rho); filled by
-- Fill e1 of A; a0 the filler at e0, u the pair (a0 , B parts of theta),
-- v0 the fibre element (glue (a0 , u) , filler) of ext over w.
--
-- Quarry: seg/model GExtEquiv2, with one sieve per side (Join of two).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module ExtEq2 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (kA : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  open CExtEquiv[l].ExtEq[G, A, psi, B, al, kA, eal] ;

  module FG = CLine[l].FC[G] ;
  module FTA = CLine[l].FT[G, A] ;
  module KA = CLine[l].EndKit[G, A, e1] ;
  module RK = CPartial[l].Rel[KA.TV.E, KA.SFm.SF, KA.SFm.SF, CPartial[l].pmap-id KA.TV.E KA.SFm.SF] ;
  module GL = PR.PshL[G] ;

  module Th (X : Ob) (w : TA.EI X) (p : PX.Side[X, w]) {
    rho : W0.Ix (G.ob X) = w.1 ;

    ------------------------------------------------------------------
    -- theta: the extension in the fibre of alpha at the full maps

    th (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : FA.TF.EI W =
      kE W (EA.act W X f w) q (PX.rside W X f w p) ;

    th-nat (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (q : IsT (full W (G.act W X f rho)))
      (q' : IsT (full W' (G.act W' X (compH W' W X f chi) rho)))
      : Id (FA.TF.EI W') (EFA.act W' W chi (th W f q)) (th W' (compH W' W X f chi) q') =
      transH (kE-act W' W chi (EA.act W X f w) q (full-act W' W chi (G.act W X f rho) q) (PX.rside W X f w p))
             (symH (kE-cong W' (EA.act W' X (compH W' W X f chi) w) (EA.act W' W chi (EA.act W X f w)) (EA.act-o W' W X f chi w)
                      q' (full-act W' W chi (G.act W X f rho) q)
                      (PX.rside W' X (compH W' W X f chi) w p)
                      (PX.rside W' W chi (EA.act W X f w) (PX.rside W X f w p))
                      (PX.rside-o W' W X chi f w p))) ;

    -- f is f after the identity: the full map f, as a map into the
    -- restriction of p along f, is the identity of W
    lands-idr (W : Ob) (f : Hom W X) (i : Lands W X p.pQ f) : Lands W W (pre W X f p.pQ) (idH W) =
      pre-lands W W X f p.pQ (idH W) (lands-eq W X p.pQ f (compH W W X f (idH W)) (symH (comp-idr W X f)) i) ;

    -- on a side of p, theta is that side
    th-full (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) (i : Lands W X p.pQ f)
      : Id (FA.TF.EI W) (th W f q)
           (toFA W (p.pv W f i) (full-eq W (G.act W X f rho) (p.pv W f i).1.1 (symH (apH (\ z -> z.1) (p.ppt W f i))) q)) =
      transH (kE-full W (EA.act W X f w) q (PX.rside W X f w p) (lands-idr W f i))
             (toFA-cong W (p.pv W (compH W W X f (idH W)) (lands-pre W W X f p.pQ (idH W) (lands-idr W f i)))
                          (p.pv W f i)
                (PX.pv-hom X w p W (compH W W X f (idH W)) f (comp-idr W X f) (lands-pre W W X f p.pQ (idH W) (lands-idr W f i)) i)
                (Tr[W, EA.act W X f w, q].qv (PX.rside W X f w p) W (idH W) (lands-idr W f i))
                (full-eq W (G.act W X f rho) (p.pv W f i).1.1 (symH (apH (\ z -> z.1) (p.ppt W f i))) q)) ;

    th-cong (W : Ob) (f : Hom W X) (q q' : IsT (full W (G.act W X f rho))) : Id (FA.TF.EI W) (th W f q) (th W f q') =
      apH (th W f) (isProp-IsT' (full W (G.act W X f rho)) q q') ;

    opaque th-nat ; opaque th-full ; opaque th-cong ;

    -- the full maps are the maps landing in a generator of psi rho
    qOf (W : Ob) (f : Hom W X) (i : Lands W X (Q X rho) f) : IsT (full W (G.act W X f rho)) =
      lands-full W X f rho i ;

    kOf (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : Lands W X (Q X rho) f =
      full-lands W X f rho q ;

    ------------------------------------------------------------------
    -- the base point: the constant line at rho, with w at e1

    cL : W0.Ix (FG.ob X) = FG.constF X rho ;

    x0 : KA.TV.EI X = (cL, TA.fromE X (G.act X X (idH X) rho) w (symH (G.act-id X rho))) ;

    x0-E : Id (TA.EI X) (KA.endE X x0) w = TA.fromE-eq X (G.act X X (idH X) rho) w (symH (G.act-id X rho)) ;

    -- the end of the base point, restricted, as LineSide wants it
    x0-act (V : Ob) (f : Hom V X) : Id (TA.EI V) (TA.E.act V X f w) (KA.endE V (KA.TV.E.act V X f x0)) =
      transH (apH (TA.E.act V X f) (symH x0-E)) (symH (KA.endE-act V X f x0)) ;

    ------------------------------------------------------------------
    -- the two families of sides

    -- from p: the lines of its fibre elements
    module S1 = CLineSide[l].LineSide[G, A, e1, X, x0, p.pQ, \ V f i W g j -> FX.fibL V (p.pv V f i) W g j,
        \ V f i W g j -> transH (FX.fibL-pt V (p.pv V f i) W g j)
                           (transH (apH (\ z -> G.act W V g z.1) (p.ppt V f i)) (GL.actC W V X f g rho)),
        \ V f i W' W g' g j -> FX.fibL-nat V (p.pv V f i) W' W g' g j,
        \ V f i -> transH (FX.fibL-1 V (p.pv V f i)) (transH (p.ppt V f i) (x0-act V f)),
        \ V' V chi f i i' W g j -> transH (apH (\ z -> FX.fibL V' z W g j) (symH (p.pnat V' V chi f i i')))
                                          (FX.fibL-act V' V chi (p.pv V f i) W g j)] ;

    -- from theta, on the sieve of psi rho
    module S2 = CLineSide[l].LineSide[G, A, e1, X, x0, Q X rho, \ V f i W g j -> toEA W (FA.fibL V (th V f (qOf V f i)) W g j),
        \ V f i W g j -> transH (apH (\ z -> z.1) (FA.fibL-pt V (th V f (qOf V f i)) W g j)) (GL.actC W V X f g rho),
        \ V f i W' W g' g j -> apH (toEA W') (FA.fibL-nat V (th V f (qOf V f i)) W' W g' g j),
        \ V f i -> transH (apH (toEA V) (FA.fibL-1 V (th V f (qOf V f i)))) (x0-act V f),
        \ V' V chi f i i' W g j ->
          transH (apH (\ z -> toEA W (FA.fibL V' z W g j))
                      (symH (th-nat V' V chi f (qOf V f i) (qOf V' (compH V' V X f chi) i'))))
                 (apH (toEA W) (FA.fibL-act V' V chi (th V f (qOf V f i)) W g j))] ;

    -- two elements of the fibres over the same point with the same line values
    tsEq (V : Ob) (f : Hom V X) (u v : KA.TS.EI V) (pu : Id (KA.TV.EI V) u.1 (KA.TV.E.act V X f x0))
      (pv : Id (KA.TV.EI V) v.1 (KA.TV.E.act V X f x0))
      (q : (W : Ob) (g : Hom W V) (j : Hom W Iv) -> Id (TA.EI W) ((KA.lineL V u).2.1.1 W g j) ((KA.lineL V v).2.1.1 W g j))
      : Id (KA.TS.EI V) u v = KA.ts-ext V u v (transH pu (symH pv)) q ;

    -- on the overlap theta is p
    c12 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (i' : Lands V X (Q X rho) f) : Id (KA.TS.EI V) (S1.sv V f i) (S2.sv V f i') =
      tsEq V f (S1.sv V f i) (S2.sv V f i') (S1.sv-pt V f i) (S2.sv-pt V f i')
        (\ W g j -> transH (S1.sv-val V f i W g j)
                     (transH (symH (transH (apH (\ z -> toEA W (FA.fibL V z W g j)) (th-full V f (qOf V f i') i))
                                           (toFA-L V (p.pv V f i)
                                              (full-eq V (G.act V X f rho) (p.pv V f i).1.1
                                                 (symH (apH (\ z -> z.1) (p.ppt V f i))) (qOf V f i')) W g j)))
                             (symH (S2.sv-val V f i' W g j)))) ;

    pick : Nat -> KA.PT.Side[X, x0] = split { zero -> S1.side ; suc m -> S2.side } ;

    CTy (n n' : Nat) : U l = (V : Ob) (f : Hom V X) (h : Lands V X (pick n).pQ f) (h' : Lands V X (pick n').pQ f)
      -> Id (KA.TS.EI V) ((pick n).pv V f h) ((pick n').pv V f h') ;

    cc0 : (n' : Nat) -> CTy zero n' = split {
      zero -> \ V f h h' -> KA.PT.pv-irr X x0 S1.side V f h h' ;
      suc m -> \ V f h h' -> c12 V f h h' } ;

    cc1 : (n' : Nat) -> CTy (suc zero) n' = split {
      zero -> \ V f h h' -> symH (c12 V f h' h) ;
      suc m -> \ V f h h' -> KA.PT.pv-irr X x0 S2.side V f h h' } ;

    cc : (n n' : Nat) -> CTy n n' = split { zero -> cc0 ; suc m -> cc1 } ;

    module J = CPartial[l].Join[KA.TV.E, KA.SFm.SF, X, x0, suc (suc zero), \ k -> pick k.1, \ k k' -> cc k.1 k'.1] ;

    fin0 : Arith[a].Fin (suc (suc zero)) = (zero, refl true) ;
    fin1 : Arith[a].Fin (suc (suc zero)) = (suc zero, refl true) ;

    ------------------------------------------------------------------
    -- the filler

    fill : W0.Ix (KA.SFm.SF.tob X x0) = kA.kop X x0 J.side ;

    Fv (W : Ob) (f : Hom W X) (j : Hom W Iv) : TA.EI W = fill.1.1.1 W f j ;

    Fn (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
      : Id (TA.EI V) (TA.E.act V W g (Fv W f j)) (Fv V (compH V W X f g) (compH V W Iv j g)) = fill.1.1.2 V W g f j ;

    Fpt (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (W0.Ix (G.ob W)) (Fv W f j).1 (G.act W X f rho) =
      apH (\ y -> y.1 W f j) fill.1.2 ;

    F1 : Id (TA.EI X) (Fv X (idH X) (ptH X e1)) w =
      transH (symH (FTA.Ev[e1].endB-E X (cL, fill.1))) (transH (apH (KA.endE X) fill.2) x0-E) ;

    -- the values of the filler on the joined side
    Fside (V : Ob) (f : Hom V X) (i : Lands V X J.side.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (Fv W (compH W V X f g) j) ((KA.lineL V (J.side.pv V f i)).2.1.1 W g j) =
      transH (symH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act V X f (x0, fill))))
             (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (kA.kside X x0 J.side V f i)) ;

    -- on the side of p, and of theta
    F-S1 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (Fv W (compH W V X f g) j) (FX.fibL V (p.pv V f i) W g j) =
      transH (Fside V f (J.inS fin0 V f i) W g j)
        (transH (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (J.pv-in fin0 V f i (J.inS fin0 V f i)))
                (S1.sv-val V f i W g j)) ;

    F-S2 (V : Ob) (f : Hom V X) (i : Lands V X (Q X rho) f) (W : Ob) (g : Hom W V) (j : Hom W Iv)
      : Id (TA.EI W) (Fv W (compH W V X f g) j) (toEA W (FA.fibL V (th V f (qOf V f i)) W g j)) =
      transH (Fside V f (J.inS fin1 V f i) W g j)
        (transH (apH (\ u -> (KA.lineL V u).2.1.1 W g j) (J.pv-in fin1 V f i (J.inS fin1 V f i)))
                (S2.sv-val V f i W g j)) ;

    opaque F1 ; opaque Fside ; opaque F-S1 ; opaque F-S2 ;

    -- the filler at a point given two ways
    Fv-eq (W : Ob) (f f' : Hom W X) (j j' : Hom W Iv) (pf : Id (Hom W X) f f') (pj : Id (Hom W Iv) j j')
      : Id (TA.EI W) (Fv W f j) (Fv W f' j') =
      transH (apH (\ k -> Fv W k j) pf) (apH (\ k -> Fv W f' k) pj) ;

    -- the restriction of the end at e0 is the value at (f , e0)
    F0-act (W : Ob) (f : Hom W X)
      : Id (TA.EI W) (TA.E.act W X f (Fv X (idH X) (ptH X e0))) (Fv W (compH W W X f (idH W)) (ptH W e0)) =
      transH (Fn W X f (idH X) (ptH X e0))
             (Fv-eq W (compH W X X (idH X) f) (compH W W X f (idH W)) (compH W X Iv (ptH X e0) f) (ptH W e0)
                (transH (comp-idl W X f) (symH (comp-idr W X f))) (ptH-nat W X f e0)) ;

    ------------------------------------------------------------------
    -- the pair (a0 , B parts of theta) and the fibre element

    a0E : TA.EI X = Fv X (idH X) (ptH X e0) ;

    a0pt : Id (W0.Ix (G.ob X)) a0E.1 rho = transH (Fpt X (idH X) (ptH X e0)) (G.act-id X rho) ;

    a0 : TA.T X rho = TA.fromE X rho a0E a0pt ;

    a0-E : Id (TA.EI X) (rho, a0) a0E = TA.fromE-eq X rho a0E a0pt ;

    bE : BETy X rho = \ W f q -> FA.fibB W (th W f q) ;

    bpt : BptTy X rho bE = \ W f q -> refl (G.act W X f rho, q) ;

    pal0 : BalTy X rho a0 bE = \ W f q ->
      calc (TA.EI W) {
          toEA W (al.mE W (FA.fibB W (th W f q)))
        =< apH (toEA W) (symH (FA.fibL-0 W (th W f q))) >
          toEA W (FA.fibL W (th W f q) W (idH W) (ptH W e0))
        =< apH (\ z -> toEA W (FA.fibL W z W (idH W) (ptH W e0))) (th-cong W f q (qOf W f (kOf W f q))) >
          toEA W (FA.fibL W (th W f (qOf W f (kOf W f q))) W (idH W) (ptH W e0))
        =< symH (F-S2 W f (kOf W f q) W (idH W) (ptH W e0)) >
          Fv W (compH W W X f (idH W)) (ptH W e0)
        =< symH (F0-act W f) >
          TA.E.act W X f a0E
        =< apH (TA.E.act W X f) (symH a0-E) >
          EA.act W X f (rho, a0) } ;

    pnat0 : BnatTy X rho bE = \ W' W chi f q q' ->
      transH (symH (FA.fibB-act W' W chi (th W f q))) (apH (FA.fibB W') (th-nat W' W chi f q q')) ;

    u : Pairs X rho = mkPairs X rho a0 bE bpt pal0 pnat0 ;

    u-a : Id (TA.T X rho) (pa X rho u) a0 = mkPairs-a X rho a0 bE bpt pal0 pnat0 ;

    u-b (W : Ob) (f : Hom W X) (q : IsT (full W (G.act W X f rho))) : Id (TB.EI W) (pb X rho u W f q) (FA.fibB W (th W f q)) =
      mkPairs-b X rho a0 bE bpt pal0 pnat0 W f q ;

    u-ext : Id (TA.EI X) (extE X (glue X rho u)) (rho, a0) =
      transH (glue-ext X rho u) (apH {TA.T X rho} {TA.EI X} (\ z -> (rho, z)) u-a) ;

    gb : TX.T X rho = TX.fromE X rho (glue X rho u) (glue-pt X rho u) ;

    gb-E : Id (TX.EI X) (rho, gb) (glue X rho u) = TX.fromE-eq X rho (glue X rho u) (glue-pt X rho u) ;

    F0 : Id (TA.EI X) (Fv X (idH X) (ptH X e0)) (extE X (rho, gb)) =
      transH (symH a0-E) (transH (symH u-ext) (apH (extE X) (symH gb-E))) ;

    v0 : FX.TF.EI X = FX.mkFib X w gb Fv Fn Fpt F0 F1 ;

    opaque pal0 ; opaque pnat0 ; opaque u-a ; opaque u-b ; opaque u-ext ; opaque F0 ;
  } ;
} ;
