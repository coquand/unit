-- CDFill.seg (L8, Delta): seg/model DFill.seg ported (module names only).  Was: FACE-UNIFORM filling on Delta from a horn filling operation,
-- in both directions (Lemma 2.1 of [S] in line form; constructive).
--
--   FT[G, A, hf]   from e0: the prism chain P_N, ..., P_0 (DPrismFill.FT)
--   FF[G, A, hf]   from e1: the prism chain P_0, ..., P_N (DPrismFill.FF)
--
-- Each gives, for every problem b at [N] (a point over the end and a
-- partial line, DStageA.Prob), a filler fill N b with
--   sides   it agrees with the sides of b
--   face    restricted to the face y it is the filler of the face problem
-- The fillers are uniform along the FACE maps only; uniformity along all
-- maps is DeltaHornBox (Eilenberg-Zilber, classical).

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DHn = CDHornFib[a, lz] ;
module DHm = CDeltaCl[a] ;
module PFm = CDPrismFill[a, lz] ;

module FT (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (hf : DHn.DH[G, A].isFib) {
  module S = CDStageF[a, lz].SF[G, A, e0, zero, refl (leaf zero),
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot-pt,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot-nat,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FT[L0].tot-S0] ;
} ;

module FF (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (hf : DHn.DH[G, A].isFib) {
  module S = CDStageF[a, lz].SF[G, A, e1, suc zero, refl (leaf (suc zero)),
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot-pt,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot-nat,
    \ N gt gn L0 -> PFm.PF[G, A, hf, N, gt, gn].FF[L0].tot-S0] ;
} ;
