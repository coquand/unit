-- CPi.seg (L3, inside CB, level l): Pi types are fibrant (model.tex Thm
-- "type formers": Pi).  The composite from src d to tgt d of a partial
-- line of functions, at an argument v at the end tgt d: fill v backwards
-- in A (a line La ending at v, no side), apply the partial line of
-- functions along La (a partial line in B over La), compose in B.
--
--   ApL      a line in Pi applied along a line in A: a line in B over it
--   Prob     the problem at (K , w , side , v); value its composite
--   ProbR    the problem, restricted, is the problem at the restricted data
--   CopX     the composite: the element of Pi whose value at (f , v) is the
--            value of the problem at the restricted data
--   CS , CU  it agrees with the sides and is uniform
--
-- Quarry: seg/model GPi, GPiFib (there with lists of sides).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PiLines (G : PCtx) (A : PTy[G]) (B : PTy[extP G A]) {
  module PE = CPiE[l].PiE[G, A, B] ;
  module TA = PE.TA ;
  module TB = PE.TB ;
  module TP = PE.TP ;
  module FG = CLine[l].FC[G] ;
  module FA = CLine[l].FT[G, A] ;
  module FP = CLine[l].FT[G, PE.P] ;
  module FB = CLine[l].FT[extP G A, B] ;

  module ApL (V : Ob) (z : W0.Ix (FG.ob V)) (Lp : W0.Ix (FP.tobF V z)) (La : W0.Ix (FA.tobF V z)) {
    -- the two lines lie over z
    pz (W : Ob) (g : Hom W V) (i : Hom W Iv)
      : Id (W0.Ix (G.ob W)) (G.act W W (idH W) (Lp.1.1 W g i).1) (La.1.1 W g i).1 =
      transH (G.act-id W (Lp.1.1 W g i).1)
        (transH (apH (\ q -> q.1 W g i) Lp.2) (symH (apH (\ q -> q.1 W g i) La.2))) ;

    val (W : Ob) (g : Hom W V) (i : Hom W Iv) : TB.EI W =
      (La.1.1 W g i, PE.apW W (Lp.1.1 W g i).1 (Lp.1.1 W g i).2 W (idH W) (La.1.1 W g i) (pz W g i)) ;

    module VN (W' W : Ob) (g' : Hom W' W) (g : Hom W V) (i : Hom W Iv) {
      x : TA.Pt W = (Lp.1.1 W g i).1 ;
      u : W0.Ix (PE.PC.PiO W x) = (Lp.1.1 W g i).2 ;
      w : TA.EI W = La.1.1 W g i ;
      w' : TA.EI W' = La.1.1 W' (compH W' W V g g') (compH W' W Iv i g') ;
      Lp' : TP.EI W' = Lp.1.1 W' (compH W' W V g g') (compH W' W Iv i g') ;

      -- the restricted argument and the restricted element of Pi
      Hw : Id (TA.EI W') (TA.E.act W' W g' w) w' = La.1.2 W' W g' g i ;
      Hp : Id (TP.EI W') (TP.E.act W' W g' (x, u)) Lp' = Lp.1.2 W' W g' g i ;

      p1 : Id (TA.Pt W') (G.act W' W (compH W' W W (idH W) g') x) w'.1 =
        transH (G.act-o W' W W (idH W) g' x) (transH (apH (G.act W' W g') (pz W g i)) (apH (\ q -> q.1) Hw)) ;

      p2 : Id (TA.Pt W') (G.act W' W (compH W' W' W g' (idH W')) x) w'.1 =
        transH (apH (\ k -> G.act W' W k x) (transH (comp-idr W' W g') (symH (comp-idl W' W g')))) p1 ;

      p3 : Id (TA.Pt W') (G.act W' W' (idH W') (TP.E.act W' W g' (x, u)).1) w'.1 =
        transH (G.act-id W' (G.act W' W g' x))
          (transH (apH (G.act W' W g') (transH (symH (G.act-id W x)) (pz W g i))) (apH (\ q -> q.1) Hw)) ;

      res : Id (TB.EI W') (TB.E.act W' W g' (val W g i)) (val W' (compH W' W V g g') (compH W' W Iv i g')) =
        calc (TB.EI W') {
            TB.E.act W' W g' (w, PE.apW W x u W (idH W) w (pz W g i))
          =< PE.apW-act W x u W (idH W) w (pz W g i) W' g' w' p1 Hw >
            (w', PE.apW W x u W' (compH W' W W (idH W) g') w' p1)
          =< PE.apW-f W x u W' (compH W' W W (idH W) g') (compH W' W' W g' (idH W'))
               (transH (comp-idl W' W g') (symH (comp-idr W' W g'))) w' p1 p2 >
            (w', PE.apW W x u W' (compH W' W' W g' (idH W')) w' p2)
          =< symH (PE.apW-tact W' W g' x (TP.E.act W' W g' (x, u)).1 (refl (TP.E.act W' W g' (x, u)).1) u W' (idH W') w' p3 p2) >
            (w', PE.apW W' (TP.E.act W' W g' (x, u)).1 (TP.E.act W' W g' (x, u)).2 W' (idH W') w' p3)
          =< PE.apW-gen W' (TP.E.act W' W g' (x, u)).1 Lp'.1 (TP.E.act W' W g' (x, u)).2 Lp'.2 Hp W' (idH W') w' w' (refl w')
               p3 (pz W' (compH W' W V g g') (compH W' W Iv i g')) >
            val W' (compH W' W V g g') (compH W' W Iv i g') } ;
    } ;

    -- the line in B, over the line La.1 of G.A
    bl : W0.Ix (FB.FE.ob V) = (val, \ W' W g' g i -> VN[W', W, g', g, i].res) ;

    line : W0.Ix (FB.tobF V La.1) = (bl, FB.FG.fam-eq V (FB.piL V bl) La.1 (\ W g i -> refl (La.1.1 W g i))) ;
  } ;

  -- a restricted element of Pi, applied: along g, as the original at g
  apW-restr (K : Ob) (x : TA.Pt K) (u : W0.Ix (PE.PC.PiO K x)) (V : Ob) (g : Hom V K) (w : TA.EI V)
    (p : Id (TA.Pt V) (G.act V V (idH V) (TP.E.act V K g (x, u)).1) w.1) (p' : Id (TA.Pt V) (G.act V K g x) w.1)
    : Id (TB.EI V) (w, PE.apW V (TP.E.act V K g (x, u)).1 (TP.E.act V K g (x, u)).2 V (idH V) w p) (w, PE.apW K x u V g w p') =
    transH (PE.apW-tact V K g x (TP.E.act V K g (x, u)).1 (refl (TP.E.act V K g (x, u)).1) u V (idH V) w p
              (transH (apH (\ k -> G.act V K k x) (comp-idr V K g)) p'))
           (PE.apW-f K x u V (compH V V K g (idH V)) g (comp-idr V K g) w
              (transH (apH (\ k -> G.act V K k x) (comp-idr V K g)) p') p') ;
} ;

------------------------------------------------------------------------
-- composition for Pi A B, from src d to tgt d

module PiC (G : PCtx) (A : PTy[G]) (B : PTy[extP G A]) (d : Bool)
  (kA : CLine[l].Lines[G, A].Fill (tgt d))
  (cB : CLine[l].Lines[extP G A, B].CompK[src d, tgt d].Comp) {
  module PL = PiLines[G, A, B] ;
  module PE = PL.PE ;
  module TA = PE.TA ;
  module TB = PE.TB ;
  module TP = PE.TP ;
  module FG = PL.FG ;
  module FA = PL.FA ;
  module FP = PL.FP ;
  module FB = PL.FB ;
  module CP = CLine[l].Lines[G, PE.P].CompK[src d, tgt d] ;
  module CB = CLine[l].Lines[extP G A, B].CompK[src d, tgt d] ;
  module KP = CP.EK ;
  module KB = CB.EK ;
  module KAe = CLine[l].EndKit[G, A, tgt d] ;
  module KPe = CLine[l].EndKit[G, PE.P, tgt d] ;
  module KBe = CLine[l].EndKit[extP G A, B, tgt d] ;
  module TTP = GPR.TyL[KP.TV.E, CP.Tend] ;
  module TTB = GPR.TyL[KB.TV.E, CB.Tend] ;
  module RCP = CPartial[l].Rel[KP.TV.E, KP.SFm.SF, CP.Tend, CP.endL] ;
  module RCB = CPartial[l].Rel[KB.TV.E, KB.SFm.SF, CB.Tend, CB.endL] ;
  module RCA = CPartial[l].Rel[KAe.TV.E, KAe.SFm.SF, KAe.SFm.SF, CPartial[l].pmap-id KAe.TV.E KAe.SFm.SF] ;

  -- the other ends, read in E
  rdP (V : Ob) (u : TTP.EI V) : TP.EI V = KPe.endE V (CP.SE.mV V u) ;
  rdB (V : Ob) (u : TTB.EI V) : TB.EI V = KBe.endE V (CB.SE.mV V u) ;

  rdP-act (V' V : Ob) (g : Hom V' V) (u : TTP.EI V) : Id (TP.EI V') (rdP V' (TTP.E.act V' V g u)) (TP.E.act V' V g (rdP V u)) =
    transH (apH (KPe.endE V') (symH (CP.SE.mV-nat V' V g u))) (KPe.endE-act V' V g (CP.SE.mV V u)) ;

  rdB-act (V' V : Ob) (g : Hom V' V) (u : TTB.EI V) : Id (TB.EI V') (rdB V' (TTB.E.act V' V g u)) (TB.E.act V' V g (rdB V u)) =
    transH (apH (KBe.endE V') (symH (CB.SE.mV-nat V' V g u))) (KBe.endE-act V' V g (CB.SE.mV V u)) ;

  tt-ext (W : Ob) (u v : TTP.EI W) (p : Id (KP.TV.EI W) u.1 v.1) (q : Id (TP.EI W) (rdP W u) (rdP W v)) : Id (TTP.EI W) u v =
    CP.SE.mV-inj W u v p (KPe.tv-eq W (CP.SE.mV W u) (CP.SE.mV W v) (apH (\ z -> z.1) p) q) ;

  -- the empty side
  emptyP (K : Ob) (z : KAe.TV.EI K) : KAe.PT.Side[K, z] =
    new KAe.PT.Side[K, z, emptyS K, \ V f i -> absurd _ (empty-lands V K f i), \ V f i -> absurd _ (empty-lands V K f i),
      \ W' W chi f i i' -> absurd _ (empty-lands W K f i)] ;

  ----------------------------------------------------------------------
  -- the problem at K, for an argument v at the end tgt d

  module Prob (K : Ob) (wK : KP.TV.EI K) (pK : KP.PT.Side[K, wK]) (v : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K wK.1))) {
    xA : KAe.TV.EI K = (wK.1, v) ;

    -- the A line ending at v: reverse filling, no side
    La : W0.Ix (FA.tobF K wK.1) = (kA.kop K xA (emptyP K xA)).1 ;

    La-pt (W : Ob) (g : Hom W K) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (La.1.1 W g i).1 (wK.1.1 W g i) =
      apH (\ q -> q.1 W g i) La.2 ;

    -- the start of the B part: the start of the Pi line applied at the start of La
    ps : Id (TA.Pt K) (G.act K K (idH K) ((FG.ev (src d)).nt K wK.1)) (La.1.1 K (idH K) (ptH K (src d))).1 =
      transH (G.act-id K ((FG.ev (src d)).nt K wK.1)) (symH (La-pt K (idH K) (ptH K (src d)))) ;

    wB : KB.TV.EI K = (La.1, PE.apW K ((FG.ev (src d)).nt K wK.1) wK.2 K (idH K) (La.1.1 K (idH K) (ptH K (src d))) ps) ;

    -- the end of La at tgt d is v
    eE : Id (TA.EI K) (La.1.1 K (idH K) (ptH K (tgt d))) ((FG.ev (tgt d)).nt K wK.1, v) =
      transH (symH (FA.Ev[tgt d].endB-E K (wK.1, La))) (apH (KAe.endE K) (kA.kop K xA (emptyP K xA)).2) ;

    -- the side: the line of the side applied along La
    module SB {
      s : KP.PT.Side[K, wK] = pK ;

      LaV (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g) : W0.Ix (FA.tobF V (s.pv V g h).1.1) =
        (FA.FE.actF V K g La.1,
         transH (transH (FA.piL-act V K g La.1) (apH (FG.actF V K g) La.2)) (symH (apH (\ z -> z.1) (s.ppt V g h)))) ;

      Lb (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g) : KB.TL.EI V =
        ((LaV V g h).1, PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].line) ;

      -- the end at src d of the line of the side is the start, restricted
      eP (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g)
        : Id (TP.EI V) ((s.pv V g h).2.1.1.1 V (idH V) (ptH V (src d))) (TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2)) =
        calc (TP.EI V) {
            (s.pv V g h).2.1.1.1 V (idH V) (ptH V (src d))
          =< symH (FP.Ev[src d].endB-E V ((s.pv V g h).1.1, (s.pv V g h).2.1)) >
            KP.endE V (FP.Ev[src d].evA.mE V ((s.pv V g h).1.1, (s.pv V g h).2.1))
          =< apH (KP.endE V) (s.pv V g h).2.2 >
            KP.endE V (s.pv V g h).1
          =< apH (KP.endE V) (s.ppt V g h) >
            KP.endE V (KP.TV.E.act V K g wK)
          =< KP.endE-act V K g wK >
            TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2) } ;

      -- the start of La, restricted
      Hw (V : Ob) (g : Hom V K) : Id (TA.EI V) (TA.E.act V K g (La.1.1 K (idH K) (ptH K (src d)))) (La.1.1 V (compH V V K g (idH V)) (ptH V (src d))) =
        transH (La.1.2 V K g (idH K) (ptH K (src d)))
          (transH (apH (\ k -> La.1.1 V k (compH V K Iv (ptH K (src d)) g)) (transH (comp-idl V K g) (symH (comp-idr V K g))))
                  (apH (\ k -> La.1.1 V (compH V V K g (idH V)) k) (ptH-nat V K g (src d)))) ;

      -- the point of the start of La along g
      pg (V : Ob) (g : Hom V K) : Id (TA.Pt V) (G.act V K g ((FG.ev (src d)).nt K wK.1)) (La.1.1 V (compH V V K g (idH V)) (ptH V (src d))).1 =
        transH (apH (G.act V K g) (symH (G.act-id K ((FG.ev (src d)).nt K wK.1)))) (transH (apH (G.act V K g) ps) (apH (\ z -> z.1) (Hw V g))) ;

      -- the point of the start of La at V, read through the side
      pq (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g)
        : Id (TA.Pt V) (G.act V V (idH V) (TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2)).1) ((LaV V g h).1.1 V (idH V) (ptH V (src d))).1 =
        transH (apH (\ z -> G.act V V (idH V) z.1) (symH (eP V g h)))
               (PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].pz V (idH V) (ptH V (src d))) ;

      Qb (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g)
        : Id (TB.EI V) (KB.endE V (FB.Ev[src d].evA.mE V (Lb V g h))) (KB.endE V (KB.TV.E.act V K g wB)) =
        calc (TB.EI V) {
            KB.endE V (FB.Ev[src d].evA.mE V (Lb V g h))
          =< FB.Ev[src d].endB-E V (Lb V g h) >
            PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].val V (idH V) (ptH V (src d))
          =< PE.apW-gen V ((s.pv V g h).2.1.1.1 V (idH V) (ptH V (src d))).1 (TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2)).1
               ((s.pv V g h).2.1.1.1 V (idH V) (ptH V (src d))).2 (TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2)).2 (eP V g h)
               V (idH V) ((LaV V g h).1.1 V (idH V) (ptH V (src d))) ((LaV V g h).1.1 V (idH V) (ptH V (src d)))
               (refl ((LaV V g h).1.1 V (idH V) (ptH V (src d))))
               (PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].pz V (idH V) (ptH V (src d)))
               (pq V g h) >
            ((LaV V g h).1.1 V (idH V) (ptH V (src d)),
             PE.apW V (TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2)).1 (TP.E.act V K g (((FG.ev (src d)).nt K wK.1), wK.2)).2 V (idH V)
               ((LaV V g h).1.1 V (idH V) (ptH V (src d))) (pq V g h))
          =< PL.apW-restr K ((FG.ev (src d)).nt K wK.1) wK.2 V g ((LaV V g h).1.1 V (idH V) (ptH V (src d))) (pq V g h) (pg V g) >
            ((LaV V g h).1.1 V (idH V) (ptH V (src d)), PE.apW K ((FG.ev (src d)).nt K wK.1) wK.2 V g ((LaV V g h).1.1 V (idH V) (ptH V (src d))) (pg V g))
          =< symH (transH (PE.apW-act K ((FG.ev (src d)).nt K wK.1) wK.2 K (idH K) (La.1.1 K (idH K) (ptH K (src d))) ps V g ((LaV V g h).1.1 V (idH V) (ptH V (src d)))
                             (transH (apH (\ k -> G.act V K k ((FG.ev (src d)).nt K wK.1)) (comp-idl V K g)) (pg V g))
                             (Hw V g))
                     (PE.apW-f K ((FG.ev (src d)).nt K wK.1) wK.2 V (compH V K K (idH K) g) g (comp-idl V K g) ((LaV V g h).1.1 V (idH V) (ptH V (src d))) _ _)) >
            TB.E.act V K g (KB.endE K wB)
          =< symH (KB.endE-act V K g wB) >
            KB.endE V (KB.TV.E.act V K g wB) } ;

      pv : KB.PT.PvTy K s.pQ = \ V g h -> KB.mkTS V (KB.TV.E.act V K g wB) (Lb V g h) (refl (KB.TV.E.act V K g wB).1) (Qb V g h) ;

      pv-pt (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g) : Id (KB.TV.EI V) (pv V g h).1 (KB.TV.E.act V K g wB) =
        KB.mkTS-pt V (KB.TV.E.act V K g wB) (Lb V g h) (refl (KB.TV.E.act V K g wB).1) (Qb V g h) ;

      -- the values of its line: the line of the side applied along La
      pv-lev (V : Ob) (g : Hom V K) (h : Lands V K s.pQ g) (W' : Ob) (g' : Hom W' V) (j : Hom W' Iv)
        : Id (TB.EI W') ((KB.lineL V (pv V g h)).2.1.1 W' g' j)
                        (PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].val W' g' j) =
        apH (\ M -> M.2.1.1 W' g' j) (KB.mkTS-line V (KB.TV.E.act V K g wB) (Lb V g h) (refl (KB.TV.E.act V K g wB).1) (Qb V g h)) ;

      -- the values depend only on the value of the Pi line and the point of La
      val-eq (V V' : Ob) (g : Hom V K) (h : Lands V K s.pQ g) (g2 : Hom V' K) (h2 : Lands V' K s.pQ g2) (W' : Ob)
        (g' : Hom W' V) (j : Hom W' Iv) (g2' : Hom W' V') (j2 : Hom W' Iv)
        (Q : Id (TP.EI W') ((s.pv V g h).2.1.1.1 W' g' j) ((s.pv V' g2 h2).2.1.1.1 W' g2' j2))
        (H : Id (TA.EI W') ((LaV V g h).1.1 W' g' j) ((LaV V' g2 h2).1.1 W' g2' j2))
        : Id (TB.EI W') (PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].val W' g' j)
                        (PL.ApL[V', (s.pv V' g2 h2).1.1, (s.pv V' g2 h2).2.1, LaV V' g2 h2].val W' g2' j2) =
        PE.apW-gen W' ((s.pv V g h).2.1.1.1 W' g' j).1 ((s.pv V' g2 h2).2.1.1.1 W' g2' j2).1
          ((s.pv V g h).2.1.1.1 W' g' j).2 ((s.pv V' g2 h2).2.1.1.1 W' g2' j2).2 Q
          W' (idH W') ((LaV V g h).1.1 W' g' j) ((LaV V' g2 h2).1.1 W' g2' j2) H
          (PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].pz W' g' j)
          (PL.ApL[V', (s.pv V' g2 h2).1.1, (s.pv V' g2 h2).2.1, LaV V' g2 h2].pz W' g2' j2) ;

      pnat : KB.PT.PnTy K s.pQ pv = \ V' V g' g h h' ->
        KB.ts-ext V' (KB.TS.E.act V' V g' (pv V g h)) (pv V' (compH V' V K g g') h')
          (transH (apH (KB.TV.E.act V' V g') (pv-pt V g h))
            (transH (KB.TV.PE.actC V' V K g g' wB) (symH (pv-pt V' (compH V' V K g g') h'))))
          (\ W' g'' j ->
            calc (TB.EI W') {
                (KB.lineL V' (KB.TS.E.act V' V g' (pv V g h))).2.1.1 W' g'' j
              =< apH (\ M -> M.2.1.1 W' g'' j) (KB.lineL-act V' V g' (pv V g h)) >
                (KB.lineL V (pv V g h)).2.1.1 W' (compH W' V' V g' g'') j
              =< pv-lev V g h W' (compH W' V' V g' g'') j >
                PL.ApL[V, (s.pv V g h).1.1, (s.pv V g h).2.1, LaV V g h].val W' (compH W' V' V g' g'') j
              =< val-eq V V' g h (compH V' V K g g') h' W' (compH W' V' V g' g'') j g'' j
                   (apH (\ z -> z.2.1.1.1 W' g'' j) (s.pnat V' V g' g h h'))
                   (apH (\ k -> La.1.1 W' k j) (symH (comp-assoc W' V' V K g g' g''))) >
                PL.ApL[V', (s.pv V' (compH V' V K g g') h').1.1, (s.pv V' (compH V' V K g g') h').2.1, LaV V' (compH V' V K g g') h'].val W' g'' j
              =< symH (pv-lev V' (compH V' V K g g') h' W' g'' j) >
                (KB.lineL V' (pv V' (compH V' V K g g') h')).2.1.1 W' g'' j }) ;

      side : KB.PT.Side[K, wB] = new KB.PT.Side[K, wB, s.pQ, pv, pv-pt, pnat] ;

      opaque pv ;
    } ;

    pB : KB.PT.Side[K, wB] = SB.side ;

    bB : TTB.T K wB = cB.kop K wB pB ;

    -- the composite, read at ((x (tgt d)) , v)
    value : W0.Ix (B.tob K ((FG.ev (tgt d)).nt K wK.1, v)) =
      TB.coeT K (La.1.1 K (idH K) (ptH K (tgt d))) ((FG.ev (tgt d)).nt K wK.1, v) eE bB ;

    value-E : Id (TB.EI K) (((FG.ev (tgt d)).nt K wK.1, v), value) (rdB K (wB, bB)) =
      symH (TB.pr-coe K (La.1.1 K (idH K) (ptH K (tgt d))) ((FG.ev (tgt d)).nt K wK.1, v) eE bB) ;
  } ;

  ----------------------------------------------------------------------
  -- the problem, restricted along g : K' -> K, is the problem at the
  -- restricted data

  module ProbR (K : Ob) (wK : KP.TV.EI K) (pK : KP.PT.Side[K, wK]) (v : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K wK.1)))
    (K' : Ob) (g : Hom K' K) {
    module PW = Prob[K, wK, pK, v] ;
    module PV = Prob[K', KP.TV.E.act K' K g wK, KP.PT.rside K' K g wK pK, (KAe.TV.E.act K' K g PW.xA).2] ;

    -- the empty side, restricted, is empty
    emptyR : Id (KAe.PT.Side[K', PV.xA]) (subst (KAe.TV.EI K') (\ z -> KAe.PT.Side[K', z]) (KAe.TV.E.act K' K g PW.xA) PV.xA
                                            (refl PV.xA) (KAe.PT.rside K' K g PW.xA (emptyP K PW.xA)))
                                         (emptyP K' PV.xA) =
      KAe.PT.side-extH K' (KAe.TV.E.act K' K g PW.xA) PV.xA (refl PV.xA) (KAe.PT.rside K' K g PW.xA (emptyP K PW.xA)) (emptyP K' PV.xA)
        (pre-empty K' K g) (\ V f i i' -> absurd _ (empty-lands V K' f i')) ;

    -- the reverse A filler, restricted
    eA : Id (KAe.TS.EI K') (KAe.TS.E.act K' K g (PW.xA, kA.kop K PW.xA (emptyP K PW.xA))) (PV.xA, kA.kop K' PV.xA (emptyP K' PV.xA)) =
      transH (kA.kunif K' K g PW.xA (emptyP K PW.xA))
        (RCA.kop-cong kA K' (KAe.TV.E.act K' K g PW.xA) PV.xA (refl PV.xA) (KAe.PT.rside K' K g PW.xA (emptyP K PW.xA))
           (emptyP K' PV.xA) emptyR) ;

    eLa : Id (W0.Ix (FA.FE.ob K')) (FA.FE.actF K' K g PW.La.1) PV.La.1 = apH (\ z -> z.2.1.1) eA ;

    eLaV (W' : Ob) (g' : Hom W' K') (j : Hom W' Iv)
      : Id (TA.EI W') (PW.La.1.1 W' (compH W' K' K g g') j) (PV.La.1.1 W' g' j) = apH (\ q -> q.1 W' g' j) eLa ;

    -- the start of the B part, restricted
    w0' : TA.EI K' = PV.La.1.1 K' (idH K') (ptH K' (src d)) ;

    Hw0 : Id (TA.EI K') (TA.E.act K' K g (PW.La.1.1 K (idH K) (ptH K (src d)))) w0' =
      transH (PW.La.1.2 K' K g (idH K) (ptH K (src d)))
        (transH (apH (\ k -> PW.La.1.1 K' k (compH K' K Iv (ptH K (src d)) g)) (transH (comp-idl K' K g) (symH (comp-idr K' K g))))
          (transH (apH (\ k -> PW.La.1.1 K' (compH K' K' K g (idH K')) k) (ptH-nat K' K g (src d))) (eLaV K' (idH K') (ptH K' (src d))))) ;

    x0 : TA.Pt K = (FG.ev (src d)).nt K wK.1 ;

    pG : Id (TA.Pt K') (G.act K' K g x0) w0'.1 =
      transH (apH (G.act K' K g) (symH (G.act-id K x0))) (transH (apH (G.act K' K g) PW.ps) (apH (\ z -> z.1) Hw0)) ;

    pG' : Id (TA.Pt K') (G.act K' K (compH K' K K (idH K) g) x0) w0'.1 =
      transH (apH (\ k -> G.act K' K k x0) (comp-idl K' K g)) pG ;

    eP0 : Id (TP.EI K') (TP.E.act K' K g (x0, wK.2)) (((FG.ev (src d)).nt K' (KP.TV.E.act K' K g wK).1), (KP.TV.E.act K' K g wK).2) =
      symH (KP.endE-act K' K g wK) ;

    pq : Id (TA.Pt K') (G.act K' K' (idH K') (TP.E.act K' K g (x0, wK.2)).1) w0'.1 =
      transH (apH (\ z -> G.act K' K' (idH K') z.1) eP0)
        (transH (G.act-id K' ((FG.ev (src d)).nt K' (KP.TV.E.act K' K g wK).1)) (symH (PV.La-pt K' (idH K') (ptH K' (src d))))) ;

    eW : Id (KB.TV.EI K') (KB.TV.E.act K' K g PW.wB) PV.wB =
      KB.tv-eq K' (KB.TV.E.act K' K g PW.wB) PV.wB eLa
        (calc (TB.EI K') {
            KB.endE K' (KB.TV.E.act K' K g PW.wB)
          =< KB.endE-act K' K g PW.wB >
            TB.E.act K' K g (PW.La.1.1 K (idH K) (ptH K (src d)), PE.apW K x0 wK.2 K (idH K) (PW.La.1.1 K (idH K) (ptH K (src d))) PW.ps)
          =< PE.apW-act K x0 wK.2 K (idH K) (PW.La.1.1 K (idH K) (ptH K (src d))) PW.ps K' g w0' pG' Hw0 >
            (w0', PE.apW K x0 wK.2 K' (compH K' K K (idH K) g) w0' pG')
          =< PE.apW-f K x0 wK.2 K' (compH K' K K (idH K) g) g (comp-idl K' K g) w0' pG' pG >
            (w0', PE.apW K x0 wK.2 K' g w0' pG)
          =< symH (PL.apW-restr K x0 wK.2 K' g w0' pq pG) >
            (w0', PE.apW K' (TP.E.act K' K g (x0, wK.2)).1 (TP.E.act K' K g (x0, wK.2)).2 K' (idH K') w0' pq)
          =< PE.apW-gen K' (TP.E.act K' K g (x0, wK.2)).1 ((FG.ev (src d)).nt K' (KP.TV.E.act K' K g wK).1) (TP.E.act K' K g (x0, wK.2)).2
               (KP.TV.E.act K' K g wK).2 eP0 K' (idH K') w0' w0' (refl w0') pq PV.ps >
            KB.endE K' PV.wB }) ;

    -- the side, restricted
    eR : Id (KB.PT.Side[K', PV.wB])
            (subst (KB.TV.EI K') (\ z -> KB.PT.Side[K', z]) (KB.TV.E.act K' K g PW.wB) PV.wB eW (KB.PT.rside K' K g PW.wB PW.pB))
            PV.pB =
      KB.PT.side-extH K' (KB.TV.E.act K' K g PW.wB) PV.wB eW (KB.PT.rside K' K g PW.wB PW.pB) PV.pB (refl (pre K' K g pK.pQ))
        (\ V g2 i i' ->
          KB.ts-ext V (PW.SB.pv V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)) (PV.SB.pv V g2 i')
            (transH (PW.SB.pv-pt V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i))
              (transH (symH (KB.TV.PE.actC V K' K g g2 PW.wB))
                (transH (apH (KB.TV.E.act V K' g2) eW) (symH (PV.SB.pv-pt V g2 i')))))
            (\ W' g' j ->
              transH (PW.SB.pv-lev V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i) W' g' j)
                (transH (PE.apW-gen W'
                           ((pK.pv V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)).2.1.1.1 W' g' j).1
                           ((PV.pK.pv V g2 i').2.1.1.1 W' g' j).1
                           ((pK.pv V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)).2.1.1.1 W' g' j).2
                           ((PV.pK.pv V g2 i').2.1.1.1 W' g' j).2
                           (apH (\ z -> z.2.1.1.1 W' g' j)
                              (KP.PT.pv-irr K wK pK V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)
                                 (lands-pre V K' K g pK.pQ g2 i')))
                           W' (idH W') (PW.La.1.1 W' (compH W' V K (compH V K' K g g2) g') j) (PV.La.1.1 W' (compH W' V K' g2 g') j)
                           (transH (apH (\ k -> PW.La.1.1 W' k j) (comp-assoc W' V K' K g g2 g')) (eLaV W' (compH W' V K' g2 g') j))
                           (PL.ApL[V, (pK.pv V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)).1.1,
                                   (pK.pv V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)).2.1,
                                   PW.SB.LaV V (compH V K' K g g2) (lands-pre V K' K g pK.pQ g2 i)].pz W' g' j)
                           (PL.ApL[V, (PV.pK.pv V g2 i').1.1, (PV.pK.pv V g2 i').2.1, PV.SB.LaV V g2 i'].pz W' g' j))
                        (symH (PV.SB.pv-lev V g2 i' W' g' j))))) ;

    -- the composite, restricted
    eC : Id (TTB.EI K') (TTB.E.act K' K g (PW.wB, PW.bB)) (PV.wB, PV.bB) =
      transH (cB.kunif K' K g PW.wB PW.pB)
        (RCB.kop-cong cB K' (KB.TV.E.act K' K g PW.wB) PV.wB eW (KB.PT.rside K' K g PW.wB PW.pB) PV.pB eR) ;

    res : Id (TB.EI K') (TB.E.act K' K g (((FG.ev (tgt d)).nt K wK.1, v), PW.value))
                        (((FG.ev (tgt d)).nt K' (KP.TV.E.act K' K g wK).1, (KAe.TV.E.act K' K g PW.xA).2), PV.value) =
      calc (TB.EI K') {
          TB.E.act K' K g (((FG.ev (tgt d)).nt K wK.1, v), PW.value)
        =< apH (TB.E.act K' K g) PW.value-E >
          TB.E.act K' K g (rdB K (PW.wB, PW.bB))
        =< symH (rdB-act K' K g (PW.wB, PW.bB)) >
          rdB K' (TTB.E.act K' K g (PW.wB, PW.bB))
        =< apH (rdB K') eC >
          rdB K' (PV.wB, PV.bB)
        =< symH PV.value-E >
          (((FG.ev (tgt d)).nt K' (KP.TV.E.act K' K g wK).1, (KAe.TV.E.act K' K g PW.xA).2), PV.value) } ;

    opaque eA ; opaque eW ; opaque eR ; opaque eC ;
  } ;

  ----------------------------------------------------------------------
  -- equal data, equal values

  Prob-cong (K : Ob) (wK wK' : KP.TV.EI K) (P : Id (KP.TV.EI K) wK wK') (pK : KP.PT.Side[K, wK]) (pK' : KP.PT.Side[K, wK'])
    (R : Id (KP.PT.Side[K, wK']) (subst (KP.TV.EI K) (\ z -> KP.PT.Side[K, z]) wK wK' P pK) pK')
    (v : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K wK.1))) (v' : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K wK'.1)))
    (Vv : Id (KAe.TV.EI K) (wK.1, v) (wK'.1, v'))
    : Id (TB.EI K) (((FG.ev (tgt d)).nt K wK.1, v), Prob[K, wK, pK, v].value)
                   (((FG.ev (tgt d)).nt K wK'.1, v'), Prob[K, wK', pK', v'].value) =
    idJ (KP.TV.EI K) wK
      (\ w2 P2 -> (p2 : KP.PT.Side[K, w2]) -> Id (KP.PT.Side[K, w2]) (subst (KP.TV.EI K) (\ z -> KP.PT.Side[K, z]) wK w2 P2 pK) p2
         -> (v2 : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K w2.1))) -> Id (KAe.TV.EI K) (wK.1, v) (w2.1, v2)
         -> Id (TB.EI K) (((FG.ev (tgt d)).nt K wK.1, v), Prob[K, wK, pK, v].value)
                         (((FG.ev (tgt d)).nt K w2.1, v2), Prob[K, w2, p2, v2].value))
      (\ p2 R2 ->
         idJ (KP.PT.Side[K, wK]) pK
           (\ p3 R3 -> (v2 : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K wK.1))) -> Id (KAe.TV.EI K) (wK.1, v) (wK.1, v2)
              -> Id (TB.EI K) (((FG.ev (tgt d)).nt K wK.1, v), Prob[K, wK, pK, v].value)
                              (((FG.ev (tgt d)).nt K wK.1, v2), Prob[K, wK, p3, v2].value))
           (\ v2 V2 ->
              idJ (W0.Ix (A.tob K ((FG.ev (tgt d)).nt K wK.1))) v
                (\ v3 E3 -> Id (TB.EI K) (((FG.ev (tgt d)).nt K wK.1, v), Prob[K, wK, pK, v].value)
                                          (((FG.ev (tgt d)).nt K wK.1, v3), Prob[K, wK, pK, v3].value))
                (refl (((FG.ev (tgt d)).nt K wK.1, v), Prob[K, wK, pK, v].value))
                v2 (KAe.TV.pr-inj K wK.1 v v2 V2))
           p2 R2)
      wK' P pK' R v' Vv ;

  -- transport back along a path
  subst-inv (T : U l+) (F : T -> U l+) (x y : T) (Q : Id T x y) (u : F x) (u' : F y) (R : Id (F y) (subst T F x y Q u) u')
    : Id (F x) (subst T F y x (symH Q) u') u =
    idJ T x (\ y2 Q2 -> (u2 : F y2) -> Id (F y2) (subst T F x y2 Q2 u) u2 -> Id (F x) (subst T F y2 x (symH Q2) u2) u)
      (\ u2 R2 -> idJ (F x) u (\ u3 R3 -> Id (F x) (subst T F x x (symH (refl x)) u3) u) (refl u) u2 R2)
      y Q u' R ;

  ----------------------------------------------------------------------
  -- the composite: the element of Pi whose value at (f , v) is the value
  -- of the problem at the restricted data

  module CopX (X : Ob) (w : KP.TV.EI X) (p : KP.PT.Side[X, w]) {
    xT : TA.Pt X = (FG.ev (tgt d)).nt X w.1 ;

    qf (K : Ob) (f : Hom K X) : Id (TA.Pt K) (G.act K X f xT) ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1) =
      symH (FG.evN (tgt d) K X f w.1) ;

    vK (K : Ob) (f : Hom K X) (v : W0.Ix (A.tob K (G.act K X f xT))) : W0.Ix (A.tob K ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1)) =
      TA.coeT K (G.act K X f xT) ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1) (qf K f) v ;

    -- characterisation of the moved argument
    vK-E (K : Ob) (f : Hom K X) (v : W0.Ix (A.tob K (G.act K X f xT)))
      : Id (TA.EI K) (G.act K X f xT, v) ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1, vK K f v) =
      TA.pr-coe K (G.act K X f xT) ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1) (qf K f) v ;

    opaque vK ;

    phiT : PE.PC.FunT X (PE.PC.ptOf X xT) = \ K f v ->
      TB.coeT K ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1, vK K f v) (G.act K X f xT, v)
        (symH (vK-E K f v))
        Prob[K, KP.TV.E.act K X f w, KP.PT.rside K X f w p, vK K f v].value ;

    phiT-E (K : Ob) (f : Hom K X) (v : W0.Ix (A.tob K (G.act K X f xT)))
      : Id (TB.EI K) ((G.act K X f xT, v), phiT K f v)
                     (((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1, vK K f v),
                      Prob[K, KP.TV.E.act K X f w, KP.PT.rside K X f w p, vK K f v].value) =
      symH (TB.pr-coe K ((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1, vK K f v) (G.act K X f xT, v)
              (symH (vK-E K f v))
              Prob[K, KP.TV.E.act K X f w, KP.PT.rside K X f w p, vK K f v].value) ;

    module NT (J K : Ob) (f : Hom J X) (g : Hom K J) (v : W0.Ix (A.tob J (G.act J X f xT))) {
      aa : W0.Ix (A.tob K (G.act K X (compH K J X f g) xT)) = A.tact K J g (G.act J X f xT) (G.act K X (compH K J X f g) xT) (PE.PC.cOf X xT J K f g) v ;

      Pw : Id (KP.TV.EI K) (KP.TV.E.act K J g (KP.TV.E.act J X f w)) (KP.TV.E.act K X (compH K J X f g) w) = symH (KP.TV.E.act-o K J X f g w) ;

      Rp : Id (KP.PT.Side[K, KP.TV.E.act K X (compH K J X f g) w])
              (subst (KP.TV.EI K) (\ z -> KP.PT.Side[K, z]) (KP.TV.E.act K J g (KP.TV.E.act J X f w)) (KP.TV.E.act K X (compH K J X f g) w) Pw
                     (KP.PT.rside K J g (KP.TV.E.act J X f w) (KP.PT.rside J X f w p)))
              (KP.PT.rside K X (compH K J X f g) w p) =
        subst-inv (KP.TV.EI K) (\ z -> KP.PT.Side[K, z]) (KP.TV.E.act K X (compH K J X f g) w) (KP.TV.E.act K J g (KP.TV.E.act J X f w)) (KP.TV.E.act-o K J X f g w)
          (KP.PT.rside K X (compH K J X f g) w p) (KP.PT.rside K J g (KP.TV.E.act J X f w) (KP.PT.rside J X f w p)) (KP.PT.rside-o K J X g f w p) ;

      module PJ = Prob[J, KP.TV.E.act J X f w, KP.PT.rside J X f w p, vK J f v] ;

      Vv : Id (KAe.TV.EI K) ((KP.TV.E.act K J g (KP.TV.E.act J X f w)).1, (KAe.TV.E.act K J g PJ.xA).2) ((KP.TV.E.act K X (compH K J X f g) w).1, vK K (compH K J X f g) aa) =
        KAe.tv-eq K ((KP.TV.E.act K J g (KP.TV.E.act J X f w)).1, (KAe.TV.E.act K J g PJ.xA).2) ((KP.TV.E.act K X (compH K J X f g) w).1, vK K (compH K J X f g) aa)
          (apH (\ z -> z.1) Pw)
          (calc (TA.EI K) {
              KAe.endE K (KAe.TV.E.act K J g PJ.xA)
            =< KAe.endE-act K J g ((KP.TV.E.act J X f w).1, vK J f v) >
              TA.E.act K J g ((FG.ev (tgt d)).nt J (KP.TV.E.act J X f w).1, vK J f v)
            =< apH (TA.E.act K J g) (symH (vK-E J f v)) >
              TA.E.act K J g (G.act J X f xT, v)
            =< TA.pr-tact K J g (G.act J X f xT) (G.act K X (compH K J X f g) xT) (PE.PC.cOf X xT J K f g) v >
              (G.act K X (compH K J X f g) xT, aa)
            =< vK-E K (compH K J X f g) aa >
              ((FG.ev (tgt d)).nt K (KP.TV.E.act K X (compH K J X f g) w).1, vK K (compH K J X f g) aa) }) ;

      res : Id (W0.Ix (B.tob K (G.act K X (compH K J X f g) xT, aa)))
               (B.tact K J g (G.act J X f xT, v) (G.act K X (compH K J X f g) xT, aa) (PE.PC.eOf X xT J K f g v) (phiT J f v))
               (phiT K (compH K J X f g) aa) =
        TB.pr-inj K (G.act K X (compH K J X f g) xT, aa)
          (B.tact K J g (G.act J X f xT, v) (G.act K X (compH K J X f g) xT, aa) (PE.PC.eOf X xT J K f g v) (phiT J f v)) (phiT K (compH K J X f g) aa)
          (calc (TB.EI K) {
              ((G.act K X (compH K J X f g) xT, aa), B.tact K J g (G.act J X f xT, v) (G.act K X (compH K J X f g) xT, aa) (PE.PC.eOf X xT J K f g v) (phiT J f v))
            =< symH (TB.pr-tact K J g (G.act J X f xT, v) (G.act K X (compH K J X f g) xT, aa) (PE.PC.eOf X xT J K f g v) (phiT J f v)) >
              TB.E.act K J g ((G.act J X f xT, v), phiT J f v)
            =< apH (TB.E.act K J g) (phiT-E J f v) >
              TB.E.act K J g (((FG.ev (tgt d)).nt J (KP.TV.E.act J X f w).1, vK J f v), PJ.value)
            =< ProbR[J, (KP.TV.E.act J X f w), KP.PT.rside J X f w p, vK J f v, K, g].res >
              (((FG.ev (tgt d)).nt K (KP.TV.E.act K J g (KP.TV.E.act J X f w)).1, (KAe.TV.E.act K J g PJ.xA).2),
               Prob[K, KP.TV.E.act K J g (KP.TV.E.act J X f w), KP.PT.rside K J g (KP.TV.E.act J X f w) (KP.PT.rside J X f w p), (KAe.TV.E.act K J g PJ.xA).2].value)
            =< Prob-cong K (KP.TV.E.act K J g (KP.TV.E.act J X f w)) (KP.TV.E.act K X (compH K J X f g) w) Pw
                 (KP.PT.rside K J g (KP.TV.E.act J X f w) (KP.PT.rside J X f w p)) (KP.PT.rside K X (compH K J X f g) w p) Rp
                 (KAe.TV.E.act K J g PJ.xA).2 (vK K (compH K J X f g) aa) Vv >
              (((FG.ev (tgt d)).nt K (KP.TV.E.act K X (compH K J X f g) w).1, vK K (compH K J X f g) aa),
               Prob[K, KP.TV.E.act K X (compH K J X f g) w, KP.PT.rside K X (compH K J X f g) w p, vK K (compH K J X f g) aa].value)
            =< symH (phiT-E K (compH K J X f g) aa) >
              ((G.act K X (compH K J X f g) xT, aa), phiT K (compH K J X f g) aa) }) ;
    } ;

    natT : PE.PC.NatT X (PE.PC.ptOf X xT) (PE.PC.cOf X xT) (PE.PC.eOf X xT) phiT = \ J K f g v -> NT[J, K, f, g, v].res ;

    cop : TTP.T X w = (phiT, natT) ;

    -- characterisation of the composite: its values
    cop-val (K : Ob) (f : Hom K X) (v : W0.Ix (A.tob K (G.act K X f xT)))
      : Id (TB.EI K) (PE.valE X xT cop K f v)
                     (((FG.ev (tgt d)).nt K (KP.TV.E.act K X f w).1, vK K f v),
                      Prob[K, KP.TV.E.act K X f w, KP.PT.rside K X f w p, vK K f v].value) = phiT-E K f v ;
  } ;

  ----------------------------------------------------------------------
  -- the composite agrees with the ends at tgt d of the side

  module CS (X : Ob) (w : KP.TV.EI X) (p : KP.PT.Side[X, w]) (W : Ob) (f : Hom W X) (h : Lands W X p.pQ f) {
    module CX = CopX[X, w, p] ;
    s : KP.PT.Side[X, w] = p ;
    xT : TA.Pt X = CX.xT ;

    P1' : Id (W0.Ix (FG.ob W)) (s.pv W f h).1.1 (FG.actF W X f w.1) = apH (\ z -> z.1) (s.ppt W f h) ;

    pE : Id (TA.Pt W) (G.act W X f xT) ((s.pv W f h).2.1.1.1 W (idH W) (ptH W (tgt d))).1 =
      symH (transH (apH (\ q -> q.1 W (idH W) (ptH W (tgt d))) (s.pv W f h).2.1.2)
                   (transH (apH (\ z -> z.1 W (idH W) (ptH W (tgt d))) P1') (FG.evN (tgt d) W X f w.1))) ;

    module CH (K : Ob) (g : Hom K W) (v : W0.Ix (A.tob K (G.act K W g (G.act W X f xT))))
      (v' : W0.Ix (A.tob K (G.act K W g ((s.pv W f h).2.1.1.1 W (idH W) (ptH W (tgt d))).1)))
      (R : Id (TA.EI K) (G.act K W g (G.act W X f xT), v) (G.act K W g ((s.pv W f h).2.1.1.1 W (idH W) (ptH W (tgt d))).1, v')) {
      rhsE : TP.EI W = (s.pv W f h).2.1.1.1 W (idH W) (ptH W (tgt d)) ;

      vb : W0.Ix (A.tob K (G.act K X (compH K W X f g) xT)) =
        PE.bk K (G.act K X (compH K W X f g) xT) (G.act K W g (G.act W X f xT)) (PE.PC.piPt W X f xT (G.act W X f xT) (refl (G.act W X f xT)) K g) v ;

      module Q = Prob[K, KP.TV.E.act K X (compH K W X f g) w, KP.PT.rside K X (compH K W X f g) w p, CX.vK K (compH K W X f g) vb] ;

      -- the identity lands in the restricted side
      iK : Lands K K (pre K X (compH K W X f g) s.pQ) (idH K) =
        pre-lands K K X (compH K W X f g) s.pQ (idH K)
          (lands-eq K X s.pQ (compH K W X f g) (compH K K X (compH K W X f g) (idH K)) (symH (comp-idr K X (compH K W X f g)))
             (lands-comp K W X s.pQ f g h)) ;

      -- the line of the restricted side at (id , tgt d) is the side's end, restricted
      Lp : TP.EI K = (Q.pK.pv K (idH K) iK).2.1.1.1 K (idH K) (ptH K (tgt d)) ;

      eLp : Id (TP.EI K) Lp (TP.E.act K W g rhsE) =
        calc (TP.EI K) {
            Lp
          =< apH (\ z -> z.2.1.1.1 K (idH K) (ptH K (tgt d)))
                 (KP.PT.pv-hom X w s K (compH K K X (compH K W X f g) (idH K)) (compH K W X f g) (comp-idr K X (compH K W X f g))
                    (lands-pre K K X (compH K W X f g) s.pQ (idH K) iK) (lands-comp K W X s.pQ f g h)) >
            (s.pv K (compH K W X f g) (lands-comp K W X s.pQ f g h)).2.1.1.1 K (idH K) (ptH K (tgt d))
          =< apH (\ z -> z.2.1.1.1 K (idH K) (ptH K (tgt d))) (symH (s.pnat K W g f h (lands-comp K W X s.pQ f g h))) >
            (s.pv W f h).2.1.1.1 K (compH K K W g (idH K)) (ptH K (tgt d))
          =< apH (\ k -> (s.pv W f h).2.1.1.1 K k (ptH K (tgt d))) (transH (comp-idr K W g) (symH (comp-idl K W g))) >
            (s.pv W f h).2.1.1.1 K (compH K W W (idH W) g) (ptH K (tgt d))
          =< apH (\ k -> (s.pv W f h).2.1.1.1 K (compH K W W (idH W) g) k) (symH (ptH-nat K W g (tgt d))) >
            (s.pv W f h).2.1.1.1 K (compH K W W (idH W) g) (compH K W Iv (ptH W (tgt d)) g)
          =< symH ((s.pv W f h).2.1.1.2 K W g (idH W) (ptH W (tgt d))) >
            TP.E.act K W g rhsE } ;

      -- the end of La at tgt d is the argument
      w' : TA.EI K = (G.act K W g rhsE.1, v') ;

      eLa : Id (TA.EI K) (Q.La.1.1 K (compH K K K (idH K) (idH K)) (ptH K (tgt d))) w' =
        calc (TA.EI K) {
            Q.La.1.1 K (compH K K K (idH K) (idH K)) (ptH K (tgt d))
          =< apH (\ k -> Q.La.1.1 K k (ptH K (tgt d))) (comp-idl K K (idH K)) >
            Q.La.1.1 K (idH K) (ptH K (tgt d))
          =< Q.eE >
            ((FG.ev (tgt d)).nt K (KP.TV.E.act K X (compH K W X f g) w).1, CX.vK K (compH K W X f g) vb)
          =< symH (CX.vK-E K (compH K W X f g) vb) >
            (G.act K X (compH K W X f g) xT, vb)
          =< PE.pp K (G.act K X (compH K W X f g) xT) (G.act K W g (G.act W X f xT))
               (PE.PC.piPt W X f xT (G.act W X f xT) (refl (G.act W X f xT)) K g) v >
            (G.act K W g (G.act W X f xT), v)
          =< R >
            w' } ;

      pw' : Id (TA.Pt K) (G.act K W g rhsE.1) w'.1 = refl w'.1 ;

      res : Id (TB.EI K) (PE.valE W (G.act W X f xT) (PE.P.tact W X f xT (G.act W X f xT) (refl (G.act W X f xT)) CX.cop) K g v)
                         (PE.valE W rhsE.1 rhsE.2 K g v') =
        calc (TB.EI K) {
            PE.valE W (G.act W X f xT) (PE.P.tact W X f xT (G.act W X f xT) (refl (G.act W X f xT)) CX.cop) K g v
          =< PE.valE-tact W X f xT (G.act W X f xT) (refl (G.act W X f xT)) CX.cop K g v >
            PE.valE X xT CX.cop K (compH K W X f g) vb
          =< CX.cop-val K (compH K W X f g) vb >
            (((FG.ev (tgt d)).nt K (KP.TV.E.act K X (compH K W X f g) w).1, CX.vK K (compH K W X f g) vb), Q.value)
          =< Q.value-E >
            rdB K (Q.wB, Q.bB)
          =< symH (TB.E.act-id K (rdB K (Q.wB, Q.bB))) >
            TB.E.act K K (idH K) (rdB K (Q.wB, Q.bB))
          =< symH (rdB-act K K (idH K) (Q.wB, Q.bB)) >
            rdB K (TTB.E.act K K (idH K) (Q.wB, Q.bB))
          =< apH (rdB K) (cB.kside K Q.wB Q.pB K (idH K) iK) >
            rdB K (CB.endL.mE K (Q.SB.pv K (idH K) iK))
          =< FB.Ev[tgt d].endB-E K (KB.lineL K (Q.SB.pv K (idH K) iK)) >
            (KB.lineL K (Q.SB.pv K (idH K) iK)).2.1.1 K (idH K) (ptH K (tgt d))
          =< Q.SB.pv-lev K (idH K) iK K (idH K) (ptH K (tgt d)) >
            PL.ApL[K, (Q.pK.pv K (idH K) iK).1.1, (Q.pK.pv K (idH K) iK).2.1, Q.SB.LaV K (idH K) iK].val K (idH K) (ptH K (tgt d))
          =< PE.apW-gen K Lp.1 (TP.E.act K W g rhsE).1 Lp.2 (TP.E.act K W g rhsE).2 eLp K (idH K)
               (Q.La.1.1 K (compH K K K (idH K) (idH K)) (ptH K (tgt d))) w' eLa
               (PL.ApL[K, (Q.pK.pv K (idH K) iK).1.1, (Q.pK.pv K (idH K) iK).2.1, Q.SB.LaV K (idH K) iK].pz K (idH K) (ptH K (tgt d)))
               (G.act-id K (G.act K W g rhsE.1)) >
            (w', PE.apW K (TP.E.act K W g rhsE).1 (TP.E.act K W g rhsE).2 K (idH K) w' (G.act-id K (G.act K W g rhsE.1)))
          =< PL.apW-restr W rhsE.1 rhsE.2 K g w' (G.act-id K (G.act K W g rhsE.1)) pw' >
            (w', PE.apW W rhsE.1 rhsE.2 K g w' pw')
          =< PE.apW-E W rhsE.1 rhsE.2 K g w' pw' v' (refl w') >
            PE.valE W rhsE.1 rhsE.2 K g v' } ;
    } ;

    -- the ends agree, as elements of Pi in E
    EP : Id (TP.EI W) (TP.E.act W X f (xT, CX.cop)) ((s.pv W f h).2.1.1.1 W (idH W) (ptH W (tgt d))) =
      PE.piE-eq W (TP.E.act W X f (xT, CX.cop)) ((s.pv W f h).2.1.1.1 W (idH W) (ptH W (tgt d))) pE
        (\ K g v v' R -> CH[K, g, v, v', R].res) ;

    res : Id (TTP.EI W) (TTP.E.act W X f (w, CX.cop)) (CP.endL.mE W (s.pv W f h)) =
      tt-ext W (TTP.E.act W X f (w, CX.cop)) (CP.endL.mE W (s.pv W f h)) (symH (s.ppt W f h))
        (transH (rdP-act W X f (w, CX.cop))
          (transH EP (symH (FP.Ev[tgt d].endB-E W (KP.lineL W (s.pv W f h)))))) ;
  } ;

  ----------------------------------------------------------------------
  -- the composite is uniform

  module CU (Y X : Ob) (h : Hom Y X) (w : KP.TV.EI X) (p : KP.PT.Side[X, w]) {
    module CX = CopX[X, w, p] ;
    module CY = CopX[Y, KP.TV.E.act Y X h w, KP.PT.rside Y X h w p] ;
    xT : TA.Pt X = CX.xT ;
    yT : TA.Pt Y = CY.xT ;

    pE : Id (TA.Pt Y) (G.act Y X h xT) yT = symH (FG.evN (tgt d) Y X h w.1) ;

    module CH (K : Ob) (g : Hom K Y) (v : W0.Ix (A.tob K (G.act K Y g (G.act Y X h xT)))) (v' : W0.Ix (A.tob K (G.act K Y g yT)))
      (R : Id (TA.EI K) (G.act K Y g (G.act Y X h xT), v) (G.act K Y g yT, v')) {
      vb : W0.Ix (A.tob K (G.act K X (compH K Y X h g) xT)) =
        PE.bk K (G.act K X (compH K Y X h g) xT) (G.act K Y g (G.act Y X h xT)) (PE.PC.piPt Y X h xT (G.act Y X h xT) (refl (G.act Y X h xT)) K g) v ;

      Pw : Id (KP.TV.EI K) (KP.TV.E.act K X (compH K Y X h g) w) (KP.TV.E.act K Y g (KP.TV.E.act Y X h w)) = KP.TV.E.act-o K Y X h g w ;

      Rp : Id (KP.PT.Side[K, KP.TV.E.act K Y g (KP.TV.E.act Y X h w)])
              (subst (KP.TV.EI K) (\ z -> KP.PT.Side[K, z]) (KP.TV.E.act K X (compH K Y X h g) w) (KP.TV.E.act K Y g (KP.TV.E.act Y X h w)) Pw
                     (KP.PT.rside K X (compH K Y X h g) w p))
              (KP.PT.rside K Y g (KP.TV.E.act Y X h w) (KP.PT.rside Y X h w p)) =
        KP.PT.rside-o K Y X g h w p ;

      Vv : Id (KAe.TV.EI K) ((KP.TV.E.act K X (compH K Y X h g) w).1, CX.vK K (compH K Y X h g) vb)
                            ((KP.TV.E.act K Y g (KP.TV.E.act Y X h w)).1, CY.vK K g v') =
        KAe.tv-eq K ((KP.TV.E.act K X (compH K Y X h g) w).1, CX.vK K (compH K Y X h g) vb)
          ((KP.TV.E.act K Y g (KP.TV.E.act Y X h w)).1, CY.vK K g v') (apH (\ z -> z.1) Pw)
          (calc (TA.EI K) {
              ((FG.ev (tgt d)).nt K (KP.TV.E.act K X (compH K Y X h g) w).1, CX.vK K (compH K Y X h g) vb)
            =< symH (CX.vK-E K (compH K Y X h g) vb) >
              (G.act K X (compH K Y X h g) xT, vb)
            =< PE.pp K (G.act K X (compH K Y X h g) xT) (G.act K Y g (G.act Y X h xT))
                 (PE.PC.piPt Y X h xT (G.act Y X h xT) (refl (G.act Y X h xT)) K g) v >
              (G.act K Y g (G.act Y X h xT), v)
            =< R >
              (G.act K Y g yT, v')
            =< CY.vK-E K g v' >
              ((FG.ev (tgt d)).nt K (KP.TV.E.act K Y g (KP.TV.E.act Y X h w)).1, CY.vK K g v') }) ;

      res : Id (TB.EI K) (PE.valE Y (G.act Y X h xT) (PE.P.tact Y X h xT (G.act Y X h xT) (refl (G.act Y X h xT)) CX.cop) K g v)
                         (PE.valE Y yT CY.cop K g v') =
        calc (TB.EI K) {
            PE.valE Y (G.act Y X h xT) (PE.P.tact Y X h xT (G.act Y X h xT) (refl (G.act Y X h xT)) CX.cop) K g v
          =< PE.valE-tact Y X h xT (G.act Y X h xT) (refl (G.act Y X h xT)) CX.cop K g v >
            PE.valE X xT CX.cop K (compH K Y X h g) vb
          =< CX.cop-val K (compH K Y X h g) vb >
            (((FG.ev (tgt d)).nt K (KP.TV.E.act K X (compH K Y X h g) w).1, CX.vK K (compH K Y X h g) vb),
             Prob[K, KP.TV.E.act K X (compH K Y X h g) w, KP.PT.rside K X (compH K Y X h g) w p, CX.vK K (compH K Y X h g) vb].value)
          =< Prob-cong K (KP.TV.E.act K X (compH K Y X h g) w) (KP.TV.E.act K Y g (KP.TV.E.act Y X h w)) Pw
               (KP.PT.rside K X (compH K Y X h g) w p) (KP.PT.rside K Y g (KP.TV.E.act Y X h w) (KP.PT.rside Y X h w p)) Rp
               (CX.vK K (compH K Y X h g) vb) (CY.vK K g v') Vv >
            (((FG.ev (tgt d)).nt K (KP.TV.E.act K Y g (KP.TV.E.act Y X h w)).1, CY.vK K g v'),
             Prob[K, KP.TV.E.act K Y g (KP.TV.E.act Y X h w), KP.PT.rside K Y g (KP.TV.E.act Y X h w) (KP.PT.rside Y X h w p), CY.vK K g v'].value)
          =< symH (CY.cop-val K g v') >
            PE.valE Y yT CY.cop K g v' } ;
    } ;

    EP : Id (TP.EI Y) (TP.E.act Y X h (xT, CX.cop)) (yT, CY.cop) =
      PE.piE-eq Y (TP.E.act Y X h (xT, CX.cop)) (yT, CY.cop) pE (\ K g v v' R -> CH[K, g, v, v', R].res) ;

    res : Id (TTP.EI Y) (TTP.E.act Y X h (w, CX.cop)) (KP.TV.E.act Y X h w, CY.cop) =
      tt-ext Y (TTP.E.act Y X h (w, CX.cop)) (KP.TV.E.act Y X h w, CY.cop) (refl (KP.TV.E.act Y X h w))
        (transH (rdP-act Y X h (w, CX.cop)) EP) ;
  } ;

  -- composition for Pi A B from src d to tgt d
  comp : CP.Comp =
    new RCP.RC[\ X w p -> CopX[X, w, p].cop, \ X w p W f h -> CS[X, w, p, W, f, h].res, \ Y X h w p -> CU[Y, X, h, w, p].res] ;
} ;

-- Pi of fibrant types is fibrant: each direction fills A backwards (from
-- its composition in the other direction, CFill) and composes B
module PiFib (G : PCtx) (A : PTy[G]) (B : PTy[extP G A])
  (fA : CLine[l].Lines[G, A].Fib) (fB : CLine[l].Lines[extP G A, B].Fib) {
  fib : CLine[l].Lines[G, CPiE[l].PiE[G, A, B].P].Fib =
    (PiC[G, A, B, true, CFill[l].FillC[G, A, false, fA.2].fill, fB.1].comp,
     PiC[G, A, B, false, CFill[l].FillC[G, A, true, fA.1].fill, fB.2].comp) ;
} ;
