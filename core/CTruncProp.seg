-- CTruncProp.seg (L9): D_0 A is a D-modal proposition (postnikov.tex,
-- Section trunc, the case n = -1).
--
--   IsPropE[G, B]   B is a proposition: any two elements w , w' over the same
--                   point have a path pth (an element at X * [1] with ends w ,
--                   w'), natural in X.  This is a section of the type
--                   Pi (b b' : B) Path b b' over G, read in the total presheaf.
--   pth-eq          pth depends only on w , w'
--   D0P             D_0 A is a proposition: the path is u on X * 0 and v on
--                   X * 1 (Example low; D_0 A(X) is a family over the points)
--   D0M             D_0 A is fibrant and D-modal

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module BD = CPostBdry[a, l] ;
module PR = CPostRec[a, l] ;

record IsPropE (G : PP.PCtx) (B : PP.PTy[G]) {
  pth : (X : Ob) (w w' : PB.GPre[l].TyL[G, B].EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1) -> PB.GPre[l].TyL[G, B].EI (prodP X Iv) ;
  pp : (X : Ob) (w w' : PB.GPre[l].TyL[G, B].EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1)
       -> Id (W0.Ix (G.ob (prodP X Iv))) (pth X w w' e).1 (G.act (prodP X Iv) X (pr1 X Iv) w.1) ;
  p0 : (X : Ob) (w w' : PB.GPre[l].TyL[G, B].EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1)
       -> Id (PB.GPre[l].TyL[G, B].EI X) (PB.GPre[l].TyL[G, B].E.act X (prodP X Iv) (lid X e0) (pth X w w' e)) w ;
  p1 : (X : Ob) (w w' : PB.GPre[l].TyL[G, B].EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1)
       -> Id (PB.GPre[l].TyL[G, B].EI X) (PB.GPre[l].TyL[G, B].E.act X (prodP X Iv) (lid X e1) (pth X w w' e)) w' ;
  pnat : (Y X : Ob) (h : Hom Y X) (w w' : PB.GPre[l].TyL[G, B].EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1)
       -> Id (PB.GPre[l].TyL[G, B].EI (prodP Y Iv))
             (PB.GPre[l].TyL[G, B].E.act (prodP Y Iv) (prodP X Iv) (crossH Y X Iv Iv h (idH Iv)) (pth X w w' e))
             (pth Y (PB.GPre[l].TyL[G, B].E.act Y X h w) (PB.GPre[l].TyL[G, B].E.act Y X h w') (apH (G.act Y X h) e)) ;
} ;

-- pth depends only on its two ends
pth-eq (G : PP.PCtx) (B : PP.PTy[G]) (P : IsPropE[G, B]) (X : Ob) (w1 w1' w2 w2' : PB.GPre[l].TyL[G, B].EI X)
  (e1 : Id (W0.Ix (G.ob X)) w1.1 w1'.1) (e2 : Id (W0.Ix (G.ob X)) w2.1 w2'.1)
  (q : Id (PB.GPre[l].TyL[G, B].EI X) w1 w2) (q' : Id (PB.GPre[l].TyL[G, B].EI X) w1' w2')
  : Id (PB.GPre[l].TyL[G, B].EI (prodP X Iv)) (P.pth X w1 w1' e1) (P.pth X w2 w2' e2) =
  idJ (PB.GPre[l].TyL[G, B].EI X) w1
    (\ v q1 -> (v' : PB.GPre[l].TyL[G, B].EI X) (e3 : Id (W0.Ix (G.ob X)) v.1 v'.1) -> Id (PB.GPre[l].TyL[G, B].EI X) w1' v'
               -> Id (PB.GPre[l].TyL[G, B].EI (prodP X Iv)) (P.pth X w1 w1' e1) (P.pth X v v' e3))
    (\ v' e3 q2 -> idJ (PB.GPre[l].TyL[G, B].EI X) w1'
        (\ v'' q3 -> (e4 : Id (W0.Ix (G.ob X)) w1.1 v''.1)
                     -> Id (PB.GPre[l].TyL[G, B].EI (prodP X Iv)) (P.pth X w1 w1' e1) (P.pth X w1 v'' e4))
        (\ e4 -> apH (P.pth X w1 w1') (W0.isSetIx (G.ob X) w1.1 w1'.1 e1 e4))
        v' q2 e3)
    w2 q w2' e2 q' ;

------------------------------------------------------------------------
-- D_0 A is a proposition

module D0P (G : PP.PCtx) (A : PP.PTy[G]) {
  module D = CLocDNC[a, l].DC[G, A, zero] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module TD = PB.GPre[l].TyL[G, D.DK.DA] ;
  module GL = PB.GPre[l].PshL[G] ;

  pt0 (n : Nat) : El (lin n) = (leaf zero, refl true) ;

  -- the value of the path at a chain F : [n] -> X * [1], n <= 0: u if F
  -- starts at 0, v otherwise
  module Pth (X : Ob) (w w' : TD.EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1) {
    XI : Ob = prodP X Iv ;
    xI : W0.Ix (G.ob XI) = G.act XI X (pr1 X Iv) w.1 ;

    p1F (n : Nat) (F : Hom (lin n) XI) : Hom (lin n) X = compH (lin n) XI X (pr1 X Iv) F ;
    p2F (n : Nat) (F : Hom (lin n) XI) : Hom (lin n) Iv = compH (lin n) XI Iv (pr2 X Iv) F ;

    bF (n : Nat) (F : Hom (lin n) XI) : Bool = eqT (app (lin n) Iv (p2F n F) (pt0 n)).1 e0.1 ;

    vTF (n : Nat) (hn : IsT (leb n zero)) (b : Bool) (f : Hom (lin n) X) : TA.EI (lin n) =
      PR.bcaseL (TA.EI (lin n)) b (\ h -> D.rdId X w.1 w.2 n hn f) (\ h -> D.rdId X w'.1 w'.2 n hn f) ;

    val (n : Nat) (hn : IsT (leb n zero)) (F : Hom (lin n) XI) : TA.EI (lin n) = vTF n hn (bF n F) (p1F n F) ;

    ptF (n : Nat) (F : Hom (lin n) XI)
      : Id (W0.Ix (G.ob (lin n))) (G.act (lin n) (lin n) (idH (lin n)) (G.act (lin n) X (p1F n F) w.1)) (G.act (lin n) XI F xI) =
      transH (G.act-id (lin n) (G.act (lin n) X (p1F n F) w.1)) (symH (GL.actC (lin n) XI X (pr1 X Iv) F w.1)) ;

    vp (n : Nat) (hn : IsT (leb n zero)) (F : Hom (lin n) XI) : Id (W0.Ix (G.ob (lin n))) (val n hn F).1 (G.act (lin n) XI F xI) =
      PR.bcaseD (TA.EI (lin n)) (\ v -> Id (W0.Ix (G.ob (lin n))) v.1 (G.act (lin n) XI F xI)) (bF n F)
        (\ h -> D.rdId X w.1 w.2 n hn (p1F n F)) (\ h -> D.rdId X w'.1 w'.2 n hn (p1F n F))
        (\ h -> ptF n F)
        (\ h -> transH (apH (\ y -> G.act (lin n) (lin n) (idH (lin n)) (G.act (lin n) X (p1F n F) y)) (symH e)) (ptF n F)) ;

    wF : D.CFam XI xI = \ n hn F -> TA.fromE (lin n) (G.act (lin n) XI F xI) (val n hn F) (vp n hn F) ;

    crdw (n : Nat) (hn : IsT (leb n zero)) (F : Hom (lin n) XI) : Id (TA.EI (lin n)) (D.crd XI xI wF n hn F) (val n hn F) =
      TA.fromE-eq (lin n) (G.act (lin n) XI F xI) (val n hn F) (vp n hn F) ;

    -- below the bound 0 there are no faces
    module FG = CFacesGen[a, l].SGB[CLocRestr[a, l].R[TA.E].iG, XI, \ n -> IsT (leb n zero), \ n o -> leb-trans n (suc n) zero (leb-suc n) o,
                                    \ n -> isProp-IsT' (leb n zero), \ n o F -> val n o F, \ n o F y hy -> absurd _ (false-true o)] ;

    wC : D.CCompat XI xI wF = \ m n hm hn g s F ->
      transH (apH (TA.E.act (lin m) (lin n) g) (crdw n hn F))
        (transH (FG.fg n m g s F hn hm) (symH (crdw m hm (compH (lin m) (lin n) XI F g)))) ;

    line : D.DK.DEl XI xI = D.from XI xI (wF, wC) ;

    res : TD.EI XI = (xI, line) ;

    line-rd (n : Nat) (hn : IsT (leb n zero)) (q : Hom (lin n) XI) : Id (TA.EI (lin n)) (D.rdId XI xI line n hn q) (val n hn q) =
      transH (symH (D.crd-toF XI xI line n hn q))
        (transH (apH (\ v -> D.crd XI xI v.1 n hn q) (D.to-from XI xI (wF, wC))) (crdw n hn q)) ;

    -- the values of a restriction of the line at the identity
    end-rd (Y : Ob) (yy : W0.Ix (G.ob Y)) (k : Hom Y XI) (ek : Id (W0.Ix (G.ob Y)) (G.act Y XI k xI) yy)
      (n : Nat) (hn : IsT (leb n zero)) (q : Hom (lin n) Y)
      : Id (TA.EI (lin n)) (D.rdId Y yy (D.DK.dtact Y XI k xI yy ek line) n hn q) (val n hn (compH (lin n) Y XI k q)) =
      calc (TA.EI (lin n)) {
          D.rdId Y yy (D.DK.dtact Y XI k xI yy ek line) n hn q
        =< symH (D.crd-toF Y yy (D.DK.dtact Y XI k xI yy ek line) n hn q) >
          D.crd Y yy (D.toF Y yy (D.DK.dtact Y XI k xI yy ek line)) n hn q
        =< D.to-nat Y XI k xI yy ek line n hn q >
          D.crd XI xI (D.toF XI xI line) n hn (compH (lin n) Y XI k q)
        =< apH (\ v -> D.crd XI xI v.1 n hn (compH (lin n) Y XI k q)) (D.to-from XI xI (wF, wC)) >
          D.crd XI xI wF n hn (compH (lin n) Y XI k q)
        =< crdw n hn (compH (lin n) Y XI k q) >
          val n hn (compH (lin n) Y XI k q) } ;
  } ;

  -- elements of D_0 A are determined by their values at the identity
  to-inj (Y : Ob) (yy : W0.Ix (G.ob Y)) (v v' : D.DK.DEl Y yy)
    (h : (n : Nat) (hn : IsT (leb n zero)) (q : Hom (lin n) Y) -> Id (TA.EI (lin n)) (D.rdId Y yy v n hn q) (D.rdId Y yy v' n hn q))
    : Id (D.DK.DEl Y yy) v v' =
    transH (symH (D.from-to Y yy v))
      (transH (apH (D.from Y yy) (D.Cext Y yy (D.to Y yy v) (D.to Y yy v') (\ n hn q ->
                 transH (D.crd-toF Y yy v n hn q) (transH (h n hn q) (symH (D.crd-toF Y yy v' n hn q))))))
              (D.from-to Y yy v')) ;

  pth (X : Ob) (w w' : TD.EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1) : TD.EI (prodP X Iv) = Pth[X, w, w', e].res ;

  ----------------------------------------------------------------------
  -- the ends

  -- the lid e after a chain
  pl1 (X : Ob) (n : Nat) (e : El Iv) (q : Hom (lin n) X)
    : Id (Hom (lin n) X) (compH (lin n) (prodP X Iv) X (pr1 X Iv) (compH (lin n) X (prodP X Iv) (lid X e) q)) q =
    transH (symH (comp-assoc (lin n) X (prodP X Iv) X (pr1 X Iv) (lid X e) q))
      (transH (apH (\ k -> compH (lin n) X X k q) (pr1-pair X Iv X (idH X) (constH X Iv e))) (comp-idl (lin n) X q)) ;

  pl2 (X : Ob) (n : Nat) (e : El Iv) (q : Hom (lin n) X)
    : Id (Hom (lin n) Iv) (compH (lin n) (prodP X Iv) Iv (pr2 X Iv) (compH (lin n) X (prodP X Iv) (lid X e) q)) (constH (lin n) Iv e) =
    transH (symH (comp-assoc (lin n) X (prodP X Iv) Iv (pr2 X Iv) (lid X e) q))
      (transH (apH (\ k -> compH (lin n) X Iv k q) (pr2-pair X Iv X (idH X) (constH X Iv e))) (BD.const-h (lin n) X q e)) ;

  -- the test at the lid e
  bl (X : Ob) (n : Nat) (e : El Iv) (q : Hom (lin n) X)
    : Id Bool (eqT (app (lin n) Iv (compH (lin n) (prodP X Iv) Iv (pr2 X Iv) (compH (lin n) X (prodP X Iv) (lid X e) q)) (pt0 n)).1 e0.1)
              (eqT e.1 e0.1) =
    apH (\ k -> eqT (app (lin n) Iv k (pt0 n)).1 e0.1) (pl2 X n e q) ;

  elid (X : Ob) (x : W0.Ix (G.ob X)) (e : El Iv) : Id (W0.Ix (G.ob X)) (G.act X (prodP X Iv) (lid X e) (G.act (prodP X Iv) X (pr1 X Iv) x)) x =
    transH (GL.actC X (prodP X Iv) X (pr1 X Iv) (lid X e) x)
      (transH (apH (\ k -> G.act X X k x) (pr1-pair X Iv X (idH X) (constH X Iv e))) (G.act-id X x)) ;

  module End (X : Ob) (w w' : TD.EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1) {
    module P = Pth[X, w, w', e] ;

    r0 (n : Nat) (hn : IsT (leb n zero)) (q : Hom (lin n) X)
      : Id (TA.EI (lin n)) (P.val n hn (compH (lin n) X (prodP X Iv) (lid X e0) q)) (D.rdId X w.1 w.2 n hn q) =
      transH (apH (\ b -> P.vTF n hn b (P.p1F n (compH (lin n) X (prodP X Iv) (lid X e0) q))) (bl X n e0 q))
        (apH (D.rdId X w.1 w.2 n hn) (pl1 X n e0 q)) ;

    r1 (n : Nat) (hn : IsT (leb n zero)) (q : Hom (lin n) X)
      : Id (TA.EI (lin n)) (P.val n hn (compH (lin n) X (prodP X Iv) (lid X e1) q)) (D.rdId X w'.1 w'.2 n hn q) =
      transH (apH (\ b -> P.vTF n hn b (P.p1F n (compH (lin n) X (prodP X Iv) (lid X e1) q))) (bl X n e1 q))
        (apH (D.rdId X w'.1 w'.2 n hn) (pl1 X n e1 q)) ;

    p0 : Id (TD.EI X) (TD.E.act X (prodP X Iv) (lid X e0) P.res) w =
      transH (TD.pr-tact X (prodP X Iv) (lid X e0) P.xI w.1 (elid X w.1 e0) P.line)
        (apH (\ v -> (w.1, v))
          (to-inj X w.1 (D.DK.dtact X (prodP X Iv) (lid X e0) P.xI w.1 (elid X w.1 e0) P.line) w.2 (\ n hn q ->
             transH (P.end-rd X w.1 (lid X e0) (elid X w.1 e0) n hn q) (r0 n hn q)))) ;

    p1 : Id (TD.EI X) (TD.E.act X (prodP X Iv) (lid X e1) P.res) w' =
      transH (TD.pr-tact X (prodP X Iv) (lid X e1) P.xI w'.1 (transH (elid X w.1 e1) e) P.line)
        (apH (\ v -> (w'.1, v))
          (to-inj X w'.1 (D.DK.dtact X (prodP X Iv) (lid X e1) P.xI w'.1 (transH (elid X w.1 e1) e) P.line) w'.2 (\ n hn q ->
             transH (P.end-rd X w'.1 (lid X e1) (transH (elid X w.1 e1) e) n hn q) (r1 n hn q)))) ;
  } ;

  ----------------------------------------------------------------------
  -- naturality

  module Nat1 (Y X : Ob) (h : Hom Y X) (w w' : TD.EI X) (e : Id (W0.Ix (G.ob X)) w.1 w'.1) {
    module PX = Pth[X, w, w', e] ;
    module PY = Pth[Y, TD.E.act Y X h w, TD.E.act Y X h w', apH (G.act Y X h) e] ;
    hI : Hom (prodP Y Iv) (prodP X Iv) = crossH Y X Iv Iv h (idH Iv) ;

    pr1h : Id (Hom (prodP Y Iv) X) (compH (prodP Y Iv) (prodP X Iv) X (pr1 X Iv) hI) (compH (prodP Y Iv) Y X h (pr1 Y Iv)) =
      pr1-pair X Iv (prodP Y Iv) (compH (prodP Y Iv) Y X h (pr1 Y Iv)) (compH (prodP Y Iv) Iv Iv (idH Iv) (pr2 Y Iv)) ;

    pr2h : Id (Hom (prodP Y Iv) Iv) (compH (prodP Y Iv) (prodP X Iv) Iv (pr2 X Iv) hI) (pr2 Y Iv) =
      transH (pr2-pair X Iv (prodP Y Iv) (compH (prodP Y Iv) Y X h (pr1 Y Iv)) (compH (prodP Y Iv) Iv Iv (idH Iv) (pr2 Y Iv)))
             (comp-idl (prodP Y Iv) Iv (pr2 Y Iv)) ;

    ept : Id (W0.Ix (G.ob (prodP Y Iv))) (G.act (prodP Y Iv) (prodP X Iv) hI PX.xI) PY.xI =
      transH (GL.actC (prodP Y Iv) (prodP X Iv) X (pr1 X Iv) hI w.1)
        (transH (apH (\ k -> G.act (prodP Y Iv) X k w.1) pr1h) (G.act-o (prodP Y Iv) Y X h (pr1 Y Iv) w.1)) ;

    -- reading the restriction of an element at f is reading it at h f
    rdh (u : TD.EI X) (n : Nat) (hn : IsT (leb n zero)) (f : Hom (lin n) Y)
      : Id (TA.EI (lin n)) (D.rdId Y (TD.E.act Y X h u).1 (TD.E.act Y X h u).2 n hn f) (D.rdId X u.1 u.2 n hn (compH (lin n) Y X h f)) =
      transH (symH (D.crd-toF Y (G.act Y X h u.1) (D.DK.dtact Y X h u.1 (G.act Y X h u.1) (refl (G.act Y X h u.1)) u.2) n hn f))
        (transH (D.to-nat Y X h u.1 (G.act Y X h u.1) (refl (G.act Y X h u.1)) u.2 n hn f)
                (D.crd-toF X u.1 u.2 n hn (compH (lin n) Y X h f))) ;

    vTFh (n : Nat) (hn : IsT (leb n zero)) (f : Hom (lin n) Y) (b : Bool)
      : Id (TA.EI (lin n)) (PX.vTF n hn b (compH (lin n) Y X h f)) (PY.vTF n hn b f) =
      PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) (PX.vTF n hn b (compH (lin n) Y X h f)) v) b
        (\ hh -> D.rdId Y (TD.E.act Y X h w).1 (TD.E.act Y X h w).2 n hn f) (\ hh -> D.rdId Y (TD.E.act Y X h w').1 (TD.E.act Y X h w').2 n hn f)
        (\ hh -> transH (PR.bcase-t (TA.EI (lin n)) b (\ h1 -> D.rdId X w.1 w.2 n hn (compH (lin n) Y X h f))
                                                    (\ h1 -> D.rdId X w'.1 w'.2 n hn (compH (lin n) Y X h f)) hh)
                        (symH (rdh w n hn f)))
        (\ hh -> transH (PR.bcase-f (TA.EI (lin n)) b (\ h1 -> D.rdId X w.1 w.2 n hn (compH (lin n) Y X h f))
                                                    (\ h1 -> D.rdId X w'.1 w'.2 n hn (compH (lin n) Y X h f)) hh)
                        (symH (rdh w' n hn f))) ;

    rd (n : Nat) (hn : IsT (leb n zero)) (q : Hom (lin n) (prodP Y Iv))
      : Id (TA.EI (lin n)) (PX.val n hn (compH (lin n) (prodP Y Iv) (prodP X Iv) hI q)) (PY.val n hn q) =
      transH (apH (\ b -> PX.vTF n hn b (PX.p1F n (compH (lin n) (prodP Y Iv) (prodP X Iv) hI q)))
                (apH (\ k -> eqT (app (lin n) Iv k (pt0 n)).1 e0.1)
                   (transH (symH (comp-assoc (lin n) (prodP Y Iv) (prodP X Iv) Iv (pr2 X Iv) hI q))
                           (apH (\ k -> compH (lin n) (prodP Y Iv) Iv k q) pr2h))))
        (transH (apH (PX.vTF n hn (PY.bF n q))
                   (transH (symH (comp-assoc (lin n) (prodP Y Iv) (prodP X Iv) X (pr1 X Iv) hI q))
                     (transH (apH (\ k -> compH (lin n) (prodP Y Iv) X k q) pr1h)
                             (comp-assoc (lin n) (prodP Y Iv) Y X h (pr1 Y Iv) q))))
                (vTFh n hn (PY.p1F n q) (PY.bF n q))) ;

    res : Id (TD.EI (prodP Y Iv)) (TD.E.act (prodP Y Iv) (prodP X Iv) hI PX.res) PY.res =
      transH (TD.pr-tact (prodP Y Iv) (prodP X Iv) hI PX.xI PY.xI ept PX.line)
        (apH (\ v -> (PY.xI, v))
          (to-inj (prodP Y Iv) PY.xI (D.DK.dtact (prodP Y Iv) (prodP X Iv) hI PX.xI PY.xI ept PX.line) PY.line (\ n hn q ->
             transH (PX.end-rd (prodP Y Iv) PY.xI hI ept n hn q) (transH (rd n hn q) (symH (PY.line-rd n hn q)))))) ;
  } ;

  ----------------------------------------------------------------------
  -- D_0 A is a proposition

  isProp : IsPropE[G, D.DK.DA] =
    new IsPropE[G, D.DK.DA, pth, \ X w w' e -> refl (G.act (prodP X Iv) X (pr1 X Iv) w.1),
      \ X w w' e -> End[X, w, w', e].p0, \ X w w' e -> End[X, w, w', e].p1, \ Y X h w w' e -> Nat1[Y, X, h, w, w', e].res] ;
} ;

------------------------------------------------------------------------
-- D_0 A is fibrant and D-modal

module D0M (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  module KM = CK.KT[G, A, zero] ;
  fib : PB.CLine[l].Lines[G, LD.DT[G, KM.KA].DA].Fib = CLocDN[a, l].DN[G, A, zero, c].fib ;
  modal : CLocUniv[a, l].isModal G (LD.DT[G, KM.KA].DA) = CLocUniv[a, l].dModalH G KM.KA (CCoskHorn[a, l].HK[G, A, zero, c].horn) ;
} ;
