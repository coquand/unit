-- CCoskCart.seg (L9): the coskeleton preserves cartesian maps
-- (postnikov.tex, Corollary fib, naturality).  As CLocDCart for D: a
-- cartesian map A' -> A over s : D -> G gives one K_N A' -> K_N A over s,
-- whose fibre maps send the values through the given one, transported
-- along the naturality of s.
--
--   KK.fw, KK.bw    the fibre maps; fw-rd, bw-rd their values
--   KK.tK ..        the data of the cart; KK.C the cart (CCart.Cart)

level a k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module P0 = PB.GPre[k] ;
module P1 = PB.GPre[l] ;

module KK (N : Nat) (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s V (D.act V W g d)) (G.act V W g (s W d)))
  (ta : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta W v).1 (s W v.1))
  (tanat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta W v)) (ta V (P1.TyL[D, A'].E.act V W g v)))
  (tainj : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (ta W v) (ta W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bk : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> W1.Ix (A'.tob X x))
  (bkta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> Id (P0.TyL[G, A].EI X) (ta X (x, bk X x u)) (s X x, u)) {
  module KG = CCosk[a, k].KT[G, A, N] ;
  module KD = CCosk[a, l].KT[D, A', N] ;
  module TA = P0.TyL[G, A] ;
  module TA' = P1.TyL[D, A'] ;
  module TKG = KG.TK ;
  module TKD = KD.TK ;
  module PD = P1.PshL[D] ;

  -- the forward fibre map
  fw (X : Ob) (x : W1.Ix (D.ob X)) (u : KD.Fam X x) : KG.Fam X (s X x) =
    \ n hn f -> TA.fromE (lin n) (G.act (lin n) X f (s X x)) (ta (lin n) (KD.rd X x u n hn f))
                  (transH (tapt (lin n) (KD.rd X x u n hn f)) (s-nat (lin n) X f x)) ;

  fw-rd (X : Ob) (x : W1.Ix (D.ob X)) (u : KD.Fam X x) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X)
    : Id (TA.EI (lin n)) (KG.rd X (s X x) (fw X x u) n hn f) (ta (lin n) (KD.rd X x u n hn f)) =
    TA.fromE-eq (lin n) (G.act (lin n) X f (s X x)) (ta (lin n) (KD.rd X x u n hn f))
      (transH (tapt (lin n) (KD.rd X x u n hn f)) (s-nat (lin n) X f x)) ;

  fw-compat (X : Ob) (x : W1.Ix (D.ob X)) (u : KD.KEl X x) : KG.Compat X (s X x) (fw X x u.1) =
    \ m n hm hn g f -> calc (TA.EI (lin m)) {
        TA.E.act (lin m) (lin n) g (KG.rd X (s X x) (fw X x u.1) n hn f)
      =< apH (TA.E.act (lin m) (lin n) g) (fw-rd X x u.1 n hn f) >
        TA.E.act (lin m) (lin n) g (ta (lin n) (KD.rd X x u.1 n hn f))
      =< tanat (lin m) (lin n) g (KD.rd X x u.1 n hn f) >
        ta (lin m) (TA'.E.act (lin m) (lin n) g (KD.rd X x u.1 n hn f))
      =< apH (ta (lin m)) (u.2 m n hm hn g f) >
        ta (lin m) (KD.rd X x u.1 m hm (compH (lin m) (lin n) X f g))
      =< symH (fw-rd X x u.1 m hm (compH (lin m) (lin n) X f g)) >
        KG.rd X (s X x) (fw X x u.1) m hm (compH (lin m) (lin n) X f g) } ;

  fwK (X : Ob) (x : W1.Ix (D.ob X)) (u : KD.KEl X x) : KG.KEl X (s X x) = (fw X x u.1, fw-compat X x u) ;

  -- the backward fibre map
  bw (X : Ob) (x : W1.Ix (D.ob X)) (c : KG.Fam X (s X x)) : KD.Fam X x =
    \ n hn f -> bk (lin n) (D.act (lin n) X f x)
                  (TA.coeT (lin n) (G.act (lin n) X f (s X x)) (s (lin n) (D.act (lin n) X f x)) (symH (s-nat (lin n) X f x)) (c n hn f)) ;

  bw-rd (X : Ob) (x : W1.Ix (D.ob X)) (c : KG.Fam X (s X x)) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) X)
    : Id (TA.EI (lin n)) (ta (lin n) (KD.rd X x (bw X x c) n hn f)) (KG.rd X (s X x) c n hn f) =
    transH (bkta (lin n) (D.act (lin n) X f x)
              (TA.coeT (lin n) (G.act (lin n) X f (s X x)) (s (lin n) (D.act (lin n) X f x)) (symH (s-nat (lin n) X f x)) (c n hn f)))
      (symH (TA.pr-coe (lin n) (G.act (lin n) X f (s X x)) (s (lin n) (D.act (lin n) X f x)) (symH (s-nat (lin n) X f x)) (c n hn f))) ;

  bw-compat (X : Ob) (x : W1.Ix (D.ob X)) (c : KG.KEl X (s X x)) : KD.Compat X x (bw X x c.1) =
    \ m n hm hn g f -> tainj (lin m) (TA'.E.act (lin m) (lin n) g (KD.rd X x (bw X x c.1) n hn f)) (KD.rd X x (bw X x c.1) m hm (compH (lin m) (lin n) X f g))
      (PD.actC (lin m) (lin n) X f g x)
      (calc (TA.EI (lin m)) {
          ta (lin m) (TA'.E.act (lin m) (lin n) g (KD.rd X x (bw X x c.1) n hn f))
        =< symH (tanat (lin m) (lin n) g (KD.rd X x (bw X x c.1) n hn f)) >
          TA.E.act (lin m) (lin n) g (ta (lin n) (KD.rd X x (bw X x c.1) n hn f))
        =< apH (TA.E.act (lin m) (lin n) g) (bw-rd X x c.1 n hn f) >
          TA.E.act (lin m) (lin n) g (KG.rd X (s X x) c.1 n hn f)
        =< c.2 m n hm hn g f >
          KG.rd X (s X x) c.1 m hm (compH (lin m) (lin n) X f g)
        =< symH (bw-rd X x c.1 m hm (compH (lin m) (lin n) X f g)) >
          ta (lin m) (KD.rd X x (bw X x c.1) m hm (compH (lin m) (lin n) X f g)) }) ;

  bwK (X : Ob) (x : W1.Ix (D.ob X)) (c : KG.KEl X (s X x)) : KD.KEl X x = (bw X x c.1, bw-compat X x c) ;

  ----------------------------------------------------------------------
  -- totals

  tK (W : Ob) (v : TKD.EI W) : TKG.EI W = (s W v.1, fwK W v.1 v.2) ;

  tKpt (W : Ob) (v : TKD.EI W) : Id (W0.Ix (G.ob W)) (tK W v).1 (s W v.1) = refl (s W v.1) ;

  -- the values of tK v are those of v, through ta
  tK-rd (W : Ob) (v : TKD.EI W) (n : Nat) (hn : IsT (leb n N)) (f : Hom (lin n) W)
    : Id (TA.EI (lin n)) (KG.rd W (tK W v).1 (tK W v).2.1 n hn f) (ta (lin n) (KD.rd W v.1 v.2.1 n hn f)) =
    fw-rd W v.1 v.2.1 n hn f ;

  tKnat (V W : Ob) (g : Hom V W) (v : TKD.EI W) : Id (TKG.EI V) (TKG.E.act V W g (tK W v)) (tK V (TKD.E.act V W g v)) =
    KG.EKext V (TKG.E.act V W g (tK W v)) (tK V (TKD.E.act V W g v)) (symH (s-nat V W g v.1))
      (\ n hn f -> calc (TA.EI (lin n)) {
          KG.rd V (TKG.E.act V W g (tK W v)).1 (TKG.E.act V W g (tK W v)).2.1 n hn f
        =< KG.rd-ktact V W g (s W v.1) (G.act V W g (s W v.1)) (refl (G.act V W g (s W v.1))) (fwK W v.1 v.2) n hn f >
          KG.rd W (s W v.1) (fw W v.1 v.2.1) n hn (compH (lin n) V W g f)
        =< fw-rd W v.1 v.2.1 n hn (compH (lin n) V W g f) >
          ta (lin n) (KD.rd W v.1 v.2.1 n hn (compH (lin n) V W g f))
        =< symH (apH (ta (lin n)) (KD.rd-ktact V W g v.1 (D.act V W g v.1) (refl (D.act V W g v.1)) v.2 n hn f)) >
          ta (lin n) (KD.rd V (TKD.E.act V W g v).1 (TKD.E.act V W g v).2.1 n hn f)
        =< symH (fw-rd V (TKD.E.act V W g v).1 (TKD.E.act V W g v).2.1 n hn f) >
          KG.rd V (tK V (TKD.E.act V W g v)).1 (tK V (TKD.E.act V W g v)).2.1 n hn f }) ;

  tKinj (W : Ob) (v v' : TKD.EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (TKG.EI W) (tK W v) (tK W v')) : Id (TKD.EI W) v v' =
    KD.EKext W v v' P (\ n hn f -> tainj (lin n) (KD.rd W v.1 v.2.1 n hn f) (KD.rd W v'.1 v'.2.1 n hn f) (apH (D.act (lin n) W f) P)
      (transH (symH (fw-rd W v.1 v.2.1 n hn f))
        (transH (apH (\ q -> KG.rd W q.1 q.2.1 n hn f) Q) (fw-rd W v'.1 v'.2.1 n hn f)))) ;

  bkK (X : Ob) (x : W1.Ix (D.ob X)) (c : KG.KEl X (s X x)) : KD.KEl X x = bwK X x c ;

  bkKta (X : Ob) (x : W1.Ix (D.ob X)) (c : KG.KEl X (s X x)) : Id (TKG.EI X) (tK X (x, bkK X x c)) (s X x, c) =
    KG.EKext X (tK X (x, bkK X x c)) (s X x, c) (refl (s X x))
      (\ n hn f -> transH (fw-rd X x (bw X x c.1) n hn f) (bw-rd X x c.1 n hn f)) ;

  opaque fw-rd ; opaque fw-compat ; opaque bw-rd ; opaque bw-compat ;
  opaque tK-rd ; opaque tKnat ; opaque tKinj ; opaque bkKta ;

  module C = PB.CCart[k, l].Cart[D, KD.KA, G, KG.KA, s, s-nat, tK, tKpt, tKnat, tKinj, bkK, bkKta] ;
} ;
