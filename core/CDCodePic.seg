-- The code of the small product and its equations.
module SP = CDSmallPi[a] ;
module SmallDecode = CDCodeSmall ;
module NS = CDNameSmall ;

module At (G : PCtx) (a0 : O.El G (Uv.universe G)) {
  A : C.C.Ty G = Uv.decode G a0 ;
  E : PCtx = O.ext G A ;
  module D0 = SmallDecode.Along[G, Uv.Read[G].code a0] ;

  module Body (b : O.El E (Uv.universe E)) {
    B0 : C.C.Ty E = Uv.decode E b ;
    module E0 = SmallDecode.Along[E, Uv.Read[E].code b] ;
    module P0 = SP.Pi[G, D0.smallFib, E0.smallFib] ;
    module Names = NS.Naming[G, P0.small] ;

    code : O.El G (Uv.universe G) = Uv.Read[G].section Names.name ;

    decoded-name : Id (C.C.Ty G) (Uv.decode G code) (Uv.lift-code G Names.name) =
      C.C.ty-ext G _ _ (\ I x -> apH (X.inc I)
        (transH (Uv.Read[G].code-point code I x) (Uv.Read[G].section-point Names.name I x))) ;

    raw : Id (F.STy G) P0.Big (Product.raw G A B0) =
      transH
        (apH {N.Fib G D0.T} {F.STy G} (\ c -> F.Pi G (D0.T, c) (E0.T, E0.fib)) D0.fib-law)
        (apH {N.Fib E E0.T} {F.STy G} (\ c -> F.Pi G (Product.D.decode G A) (E0.T, c)) E0.fib-law) ;

    law : Id (C.C.Ty G) (Uv.decode G code) (products.Pi G A B0) =
      transH decoded-name (transH Names.lift-name (apH (Product.named G) (transH P0.law raw))) ;

    opaque law ;
  } ;
} ;

pic (G : PCtx) (a0 : O.El G (Uv.universe G)) (b : O.El (O.ext G (Uv.decode G a0)) (Uv.universe (O.ext G (Uv.decode G a0))))
  : O.El G (Uv.universe G) = At[G, a0].Body[b].code ;

dec-pic (G : PCtx) (a0 : O.El G (Uv.universe G)) (b : O.El (O.ext G (Uv.decode G a0)) (Uv.universe (O.ext G (Uv.decode G a0))))
  : Id (C.C.Ty G) (Uv.decode G (pic G a0 b)) (products.Pi G (Uv.decode G a0) (Uv.decode (O.ext G (Uv.decode G a0)) b)) =
  At[G, a0].Body[b].law ;

import CDCodePicNat ;
