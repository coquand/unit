-- Raise the codes of Delta's base category while keeping the points,
-- restrictions, interval and sieves. This lets CUniv be used at the next
-- level over the original simplex category.
level a ;
open Base ;
module DB = CDeltaBase[a].DB ;
module DC = CDeltaCl[a] ;
module Lift = DB.CSmall ;

module High = CBase[a+].CB[Lift.smallC DB.obV, \ J I -> Lift.smallC (DB.homV J I),
  DB.idH, DB.compH, DB.comp-idl, DB.comp-idr, DB.comp-assoc,
  \ I -> Lift.smallC (DB.ivV I), DB.ivA, DB.ivA-id, DB.ivA-comp, DB.IPt, DB.e0, DB.e1, DB.ptH, DB.ptH-nat,
  \ X -> DB.Phi X, DB.pre, \ W X Q f -> DB.Lands W X Q f, DB.isProp-Lands, DB.lands-comp, DB.lands-pre, DB.pre-lands, DB.phi-ext,
  DB.emptyS, DB.empty-lands, DB.topS, DB.top-lands, DB.endS, DB.end-pre, DB.lands-pt, DB.pt-lands, DB.pt-disj,
  DB.allS, DB.allS-sound, DB.allS-complete, DB.bigU, DB.bigU-in, DB.bigU-out,
  DB.forallS, DB.lands-forall, DB.forall-lands,
  DB.cI, DB.cI-nat, DB.cI-jsrc-t, DB.cI-jsrc-f, DB.cI-jtgt-t, DB.cI-jtgt-f,
  DB.cI-isrc-t, DB.cI-isrc-f, DB.cI-itgt-t, DB.cI-itgt-f] ;

module Cl = High.COpCl.OC[DC.HIx, \ i -> DC.hOk i, DC.hOb, DC.hS, CDeltaCl[a+].encHIx,
  \ i -> Arith[a+].isProp-IsT' (Base.leb i.2 (suc i.1))] ;
module Univ = High.CUniv.Univ[Cl.Cl, Cl.clSub, Cl.clSub-id, Cl.clSub-o, Cl.encCl] ;
module P1 = DB.GPre[a+] ;
module P2 = DB.GPre[a++] ;
module Q1 = High.GPre[a+] ;
module Q2 = High.GPre[a++] ;

toLow : Q2.PS.PCtx -> P2.PS.PCtx = \ G -> new P2.PS.PCtx[G.ob, G.act, G.act-id, G.act-o] ;
U1 : P2.PS.PCtx = toLow Univ.UCtx ;
El1 : P2.PS.PTy[U1] = new P2.PS.PTy[U1, Univ.EGen.tob, Univ.EGen.tact, Univ.EGen.tact-id, Univ.EGen.tact-o] ;
