-- CUniv.seg (L4, inside CB): the universe at a fibrancy classifier
-- (model.tex §5.2, Defs "classifier" and "the universe").  Fields: Cl,
-- its substitution clSub with the laws clSub-id / clSub-o (equalities in
-- Sigma A. Cl G A) and its code encCl one level up.  Derived once: U0 X =
-- Sigma (A : Ty(y X)) Cl (y X) A with the action by substitution along
-- y f, its code, the presheaf UCtx, the constant type UTy, and El, the
-- small type of fibres at the identity.
--
-- Quarry: seg/model GUniv (unchanged).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L1 = GPre[a+].PS ;
open GYon[a] ;
open Encode[a, a+] ;

module Univ {
  Cl (G : PCtx) (A : PTy[G]) : U a+ ;
  clSub (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) : Cl D (subTy D G A s) ;
  clSub-id (G : PCtx) (A : PTy[G]) (c : Cl G A)
    : Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c) ;
  clSub-o (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
    : Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                   (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)) ;
  encCl (X : Ob) (A : PTy[yP X]) : Enc (Cl (yP X) A) ;

  ----------------------------------------------------------------------
  -- the fibres of the universe and its action

  U0 (X : Ob) : U a+ = (A : PTy[yP X]) * Cl (yP X) A ;

  -- substitution along a substitution of representables
  uActS (Y X : Ob) (s : PSub[yP Y, yP X]) (F : U0 X) : U0 Y = (subTy (yP Y) (yP X) F.1 s, clSub (yP Y) (yP X) s F.1 F.2) ;

  uAct (Y X : Ob) (f : Hom Y X) (F : U0 X) : U0 Y = uActS Y X (yH Y X f) F ;

  uAct-id (X : Ob) (F : U0 X) : Id (U0 X) (uAct X X (idH X) F) F =
    transH (apH (\ s -> uActS X X s F) (yH-idH X)) (symH (clSub-id (yP X) F.1 F.2)) ;

  uAct-o (Z Y X : Ob) (f : Hom Y X) (g : Hom Z Y) (F : U0 X)
    : Id (U0 Z) (uAct Z X (compH Z Y X f g) F) (uAct Z Y g (uAct Y X f F)) =
    transH (apH (\ s -> uActS Z X s F) (yH-compH Z Y X f g))
           (clSub-o (yP Z) (yP Y) (yP X) (yH Y X f) (yH Z Y g) F.1 F.2) ;

  opaque uAct-id ; opaque uAct-o ;

  ----------------------------------------------------------------------
  -- the code: a type is determined by (tob , tact) (the laws are
  -- propositions), and the classifier has its code encCl

  encOb : Enc Ob = encIx0 obV ;

  encHom (Y X : Ob) : Enc (Hom Y X) = encIx0 (homV Y X) ;

  module EncTy (X : Ob) {
    G : PCtx = yP X ;

      TyD : U a+ = (o : TOb G) * TactTy G o ;

      tyD (A : PTy[G]) : TyD = (A.tob, A.tact) ;

      encTyD : Enc TyD =
        encSig (TOb G) (\ o -> TactTy G o)
          (encPi0 Ob (\ I -> W0.Ix (G.ob I) -> W0.V) encOb (\ I -> encPi0 (W0.Ix (G.ob I)) (\ x -> W0.V) (encIx0 (G.ob I)) (\ x -> encV0)))
          (\ o ->
            encPi0 Ob (\ J -> (I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J))
                              -> Id (W0.Ix (G.ob J)) (G.act J I f x) y -> W0.Ix (o I x) -> W0.Ix (o J y)) encOb (\ J ->
            encPi0 Ob (\ I -> (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J))
                              -> Id (W0.Ix (G.ob J)) (G.act J I f x) y -> W0.Ix (o I x) -> W0.Ix (o J y)) encOb (\ I ->
            encPi0 (Hom J I) (\ f -> (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J))
                              -> Id (W0.Ix (G.ob J)) (G.act J I f x) y -> W0.Ix (o I x) -> W0.Ix (o J y)) (encHom J I) (\ f ->
            encPi0 (W0.Ix (G.ob I)) (\ x -> (y : W0.Ix (G.ob J))
                              -> Id (W0.Ix (G.ob J)) (G.act J I f x) y -> W0.Ix (o I x) -> W0.Ix (o J y)) (encIx0 (G.ob I)) (\ x ->
            encPi0 (W0.Ix (G.ob J)) (\ y -> Id (W0.Ix (G.ob J)) (G.act J I f x) y -> W0.Ix (o I x) -> W0.Ix (o J y)) (encIx0 (G.ob J)) (\ y ->
            encPi0 (Id (W0.Ix (G.ob J)) (G.act J I f x) y) (\ e -> W0.Ix (o I x) -> W0.Ix (o J y))
                   (encProp (Id (W0.Ix (G.ob J)) (G.act J I f x) y) (W0.isSetIx (G.ob J) (G.act J I f x) y)) (\ e ->
            encPi0 (W0.Ix (o I x)) (\ z -> W0.Ix (o J y)) (encIx0 (o I x)) (\ z -> encIx0 (o J y))))))))) ;

      tyInj (A A' : PTy[G]) (P : Id TyD (tyD A) (tyD A')) : Id (PTy[G]) A A' =
        idJ TyD (tyD A)
          (\ w Q -> (hi : IdLaw G w.1 w.2) (ho : OLaw G w.1 w.2) -> Id (PTy[G]) A ((mkTy G w.1 w.2 hi ho)))
          (\ hi ho -> ty-ext G A.tob A.tact A.tact A.tact-id hi A.tact-o ho (\ J I f x y e z -> refl (A.tact J I f x y e z)))
          (tyD A') P A'.tact-id A'.tact-o ;

      encTy : Enc (PTy[G]) = encInj (PTy[G]) TyD tyD tyInj encTyD ;
  } ;

  encU (X : Ob) : Enc (U0 X) = encSig (PTy[yP X]) (\ A -> Cl (yP X) A) EncTy[X].encTy (encCl X) ;

  -- the embedding is opaque: two codes are then compared by their
  -- arguments only, never by unfolding the (large) encoding
  encUf (X : Ob) (F : U0 X) : V1.V = (encU X).1 F ;

  encUinj (X : Ob) : V1.Inj (U0 X) (encUf X) = (encU X).2 ;

  opaque encUf ; opaque encUinj ;

  codeU (X : Ob) : V1.V = V1.mkV (U0 X) (encUf X) (encUinj X) ;

  ------------------------------------------------------------------------
  -- The universe as a presheaf, and as a type

  -- the identity and the composition of the category BC are idH and
  -- compH; the presheaf laws are stated with the former, uAct-id and uAct-o
  -- with the latter
  idC-idH (I : Ob) : Id (Hom I I) (BC.idC I) (idH I) = refl (idH I) ;

  oC-compH (K J I : Ob) (f : Hom J I) (g : Hom K J) : Id (Hom K I) (BC.oC K J I f g) (compH K J I f g) =
    refl (compH K J I f g) ;

  uAct-idC (I : Ob) (F : U0 I) : Id (U0 I) (uAct I I (BC.idC I) F) F =
    transH (apH (\ h -> uAct I I h F) (idC-idH I)) (uAct-id I F) ;

  uAct-oC (K J I : Ob) (f : Hom J I) (g : Hom K J) (F : U0 I)
    : Id (U0 K) (uAct K I (BC.oC K J I f g) F) (uAct K J g (uAct J I f F)) =
    transH (apH (\ h -> uAct K I h F) (oC-compH K J I f g)) (uAct-o K J I f g F) ;

  opaque uAct-idC ; opaque uAct-oC ;

  UCtx : L1.PCtx = new L1.PCtx[codeU, \ J I f F -> uAct J I f F, uAct-idC, uAct-oC] ;

  UTy (G : L1.PCtx) : L1.PTy[G] = new L1.PTy[G, \ I x -> codeU I, \ J I f x y e F -> uAct J I f F,
    \ I x e F -> uAct-idC I F, \ K J I f g x y z q1 q2 q3 F -> uAct-oC K J I f g F] ;

  ------------------------------------------------------------------------
  -- The generic family

  -- an iterative set of level a as one of level a+ (GSmall)
  smallC (v : W0.V) : V1.V = CSmall.smallC v ;

  -- the fibre at the identity
  fib0 (I : Ob) (F : U0 I) : W0.V = F.1.tob I (idH I) ;

  -- a loop in V transports trivially
  loopV (v : W0.V) (q : Id W0.V v v) (z : W0.Ix v) : Id (W0.Ix v) (subst W0.V (\ w -> W0.Ix w) v v q z) z =
    apH (\ q' -> subst W0.V (\ w -> W0.Ix w) v v q' z) (W0.isSetV v v q (refl v)) ;

  -- transport along an equation of fibrant types with the same fibre
  substF (J : Ob) (G1 G2 : U0 J) (e : Id (U0 J) G1 G2) (z : W0.Ix (fib0 J G1))
    : Id (W0.Ix (fib0 J G2)) (subst (U0 J) (\ G' -> W0.Ix (fib0 J G')) G1 G2 e z)
                            (subst W0.V (\ w -> W0.Ix w) (fib0 J G1) (fib0 J G2) (ap (U0 J) W0.V (fib0 J) G1 G2 e) z) =
    subst-ap (U0 J) W0.V (fib0 J) (\ w -> W0.Ix w) G1 G2 e z ;

  -- the restriction of the identity of I along f, seen in two ways
  idf-eq (J I : Ob) (f : Hom J I) : Id (Hom J I) ((yP I).act J I f (idH I)) ((yH J I f).nt J (idH J)) =
    calc (Hom J I) {
      compH J I I (idH I) f =< comp-idl J I f >
      f                     =< symH (comp-idr J I f) >
      compH J J I f (idH J) } ;

  -- transport of a fibre element does not depend on the path (V is a set)
  substFib-irr (v w : W0.V) (q q' : Id W0.V v w) (z : W0.Ix v)
    : Id (W0.Ix w) (subst W0.V (\ u -> W0.Ix u) v w q z) (subst W0.V (\ u -> W0.Ix u) v w q' z) =
    apH (\ q'' -> subst W0.V (\ u -> W0.Ix u) v w q'' z) (W0.isSetV v w q q') ;

  -- a path between two fibres of a family o is the image of a path of indices
  fib-move (X : U a) (o : X -> W0.V) (y y' : X) (p : Id X y y') (q : Id W0.V (o y) (o y')) (z : W0.Ix (o y))
    : Id (W0.Ix (o y')) (subst W0.V (\ u -> W0.Ix u) (o y) (o y') q z) (subst X (\ x -> W0.Ix (o x)) y y' p z) =
    transH (substFib-irr (o y) (o y') q (ap X W0.V o y y' p) z)
           (symH (subst-ap X W0.V o (\ u -> W0.Ix u) y y' p z)) ;

  -- moving the target of an action along a path of points
  tact-move (G : PCtx) (A : PTy[G]) (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y y' : W0.Ix (G.ob J))
    (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (e' : Id (W0.Ix (G.ob J)) (G.act J I f x) y')
    (p : Id (W0.Ix (G.ob J)) y y') (b : W0.Ix (A.tob I x))
    : Id (W0.Ix (A.tob J y')) (subst (W0.Ix (G.ob J)) (\ u -> W0.Ix (A.tob J u)) y y' p (A.tact J I f x y e b))
                             (A.tact J I f x y' e' b) =
    idJ (W0.Ix (G.ob J)) y
      (\ u q -> (q2 : Id (W0.Ix (G.ob J)) (G.act J I f x) u)
         -> Id (W0.Ix (A.tob J u)) (subst (W0.Ix (G.ob J)) (\ u' -> W0.Ix (A.tob J u')) y u q (A.tact J I f x y e b))
                                  (A.tact J I f x u q2 b))
      (\ q2 -> tact-irr G A J I f x y e q2 b) y' p e' ;

  -- moving the source of an action along a path of points
  tact-src-move (G : PCtx) (A : PTy[G]) (J I : Ob) (f : Hom J I) (x x' : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J))
    (p : Id (W0.Ix (G.ob I)) x x') (e : Id (W0.Ix (G.ob J)) (G.act J I f x') y) (e' : Id (W0.Ix (G.ob J)) (G.act J I f x) y)
    (b : W0.Ix (A.tob I x))
    : Id (W0.Ix (A.tob J y)) (A.tact J I f x' y e (subst (W0.Ix (G.ob I)) (\ u -> W0.Ix (A.tob I u)) x x' p b))
                            (A.tact J I f x y e' b) =
    idJ (W0.Ix (G.ob I)) x
      (\ u q -> (q2 : Id (W0.Ix (G.ob J)) (G.act J I f u) y)
         -> Id (W0.Ix (A.tob J y)) (A.tact J I f u y q2 (subst (W0.Ix (G.ob I)) (\ u' -> W0.Ix (A.tob I u')) x u q b))
                                  (A.tact J I f x y e' b))
      (\ q2 -> tact-irr G A J I f x y q2 e' b) x' p e ;

  -- the action of the generic family: act on the fibre of F, at the point f id
  tactG (J I : Ob) (f : Hom J I) (F : U0 I) (F' : U0 J) (e : Id (U0 J) (uAct J I f F) F') (z : W0.Ix (fib0 I F)) : W0.Ix (fib0 J F') =
    subst (U0 J) (\ G' -> W0.Ix (fib0 J G')) (uAct J I f F) F' e
      (F.1.tact J I f (idH I) ((yH J I f).nt J (idH J)) (idf-eq J I f) z) ;

  -- along the identity: the fibre moves back along comp-idl, then tact-id
  tidG (I : Ob) (F : U0 I) (e : Id (U0 I) (uAct I I (idH I) F) F) (z : W0.Ix (fib0 I F))
    : Id (W0.Ix (fib0 I F)) (tactG I I (idH I) F F e z) z =
    calc (W0.Ix (fib0 I F)) {
      tactG I I (idH I) F F e z
        =< substF I (uAct I I (idH I) F) F e tz >
      subst W0.V (\ u -> W0.Ix u) (fib0 I (uAct I I (idH I) F)) (fib0 I F) (ap (U0 I) W0.V (fib0 I) (uAct I I (idH I) F) F e) tz
        =< fib-move (Hom I I) (F.1.tob I) y0 (idH I) (comp-idl I I (idH I))
                    (ap (U0 I) W0.V (fib0 I) (uAct I I (idH I) F) F e) tz >
      subst (Hom I I) (\ x -> W0.Ix (F.1.tob I x)) y0 (idH I) (comp-idl I I (idH I)) tz
        =< tact-move (yP I) F.1 I I (idH I) (idH I) y0 (idH I) (idf-eq I I (idH I)) (comp-idl I I (idH I)) (comp-idl I I (idH I)) z >
      F.1.tact I I (idH I) (idH I) (idH I) (comp-idl I I (idH I)) z
        =< F.1.tact-id I (idH I) (comp-idl I I (idH I)) z >
      z }
   where {
     y0 : Hom I I = (yH I I (idH I)).nt I (idH I) ;
     tz : W0.Ix (F.1.tob I y0) = F.1.tact I I (idH I) (idH I) y0 (idf-eq I I (idH I)) z ; } ;

  module TO (K J I : Ob) (f : Hom J I) (g : Hom K J) (F : U0 I) (z : W0.Ix (fib0 I F)) {
    Ff : U0 J = uAct J I f F ;

    Ffg : U0 K = uAct K J g Ff ;

    -- the two target points: (compH K J I f g) id, and f (g id)
    y1 : Hom K I = (yH K I (compH K J I f g)).nt K (idH K) ;
    y2 : Hom K I = (yH J I f).nt K ((yH K J g).nt K (idH K)) ;

    -- they agree by associativity
    p12 : Id (Hom K I) y1 y2 = comp-assoc K K J I f g (idH K) ;

    -- the actions by f then g, read in F
    q1 : Id (Hom J I) ((yP I).act J I f (idH I)) ((yH J I f).nt J (idH J)) = idf-eq J I f ;
    q2 : Id (Hom K I) ((yP I).act K J g ((yH J I f).nt J (idH J))) y2 =
      ntEq (yP J) (yP I) (yH J I f) K J g (idH J) ((yH K J g).nt K (idH K)) (idf-eq K J g) ;

    tz : W0.Ix (F.1.tob K y1) = F.1.tact K I (compH K J I f g) (idH I) y1 (idf-eq K I (compH K J I f g)) z ;

    base (Q3 : Id (U0 K) (uAct K I (compH K J I f g) F) Ffg)
      : Id (W0.Ix (fib0 K Ffg)) (tactG K I (compH K J I f g) F Ffg Q3 z) (tactG K J g Ff Ffg (refl Ffg) (tactG J I f F Ff (refl Ff) z)) =
      calc (W0.Ix (fib0 K Ffg)) {
        tactG K I (compH K J I f g) F Ffg Q3 z
          =< substF K (uAct K I (compH K J I f g) F) Ffg Q3 tz >
        subst W0.V (\ u -> W0.Ix u) (fib0 K (uAct K I (compH K J I f g) F)) (fib0 K Ffg) (ap (U0 K) W0.V (fib0 K) (uAct K I (compH K J I f g) F) Ffg Q3) tz
          =< fib-move (Hom K I) (F.1.tob K) y1 y2 p12 (ap (U0 K) W0.V (fib0 K) (uAct K I (compH K J I f g) F) Ffg Q3) tz >
        subst (Hom K I) (\ x -> W0.Ix (F.1.tob K x)) y1 y2 p12 tz
          =< tact-move (yP I) F.1 K I (compH K J I f g) (idH I) y1 y2 (idf-eq K I (compH K J I f g)) (transH (idf-eq K I (compH K J I f g)) p12) p12 z >
        F.1.tact K I (compH K J I f g) (idH I) y2 (transH (idf-eq K I (compH K J I f g)) p12) z
          =< F.1.tact-o K J I f g (idH I) ((yH J I f).nt J (idH J)) y2 q1 q2 (transH (idf-eq K I (compH K J I f g)) p12) z >
        F.1.tact K J g ((yH J I f).nt J (idH J)) y2 q2 (F.1.tact J I f (idH I) ((yH J I f).nt J (idH J)) q1 z) } ;

    res (F' : U0 J) (F'' : U0 K) (q1 : Id (U0 J) Ff F') (q2 : Id (U0 K) (uAct K J g F') F'') (q3 : Id (U0 K) (uAct K I (compH K J I f g) F) F'')
      : Id (W0.Ix (fib0 K F'')) (tactG K I (compH K J I f g) F F'' q3 z) (tactG K J g F' F'' q2 (tactG J I f F F' q1 z)) =
      idJ (U0 J) Ff
        (\ F2 Q1 -> (F3 : U0 K) (Q2 : Id (U0 K) (uAct K J g F2) F3) (Q3 : Id (U0 K) (uAct K I (compH K J I f g) F) F3)
           -> Id (W0.Ix (fib0 K F3)) (tactG K I (compH K J I f g) F F3 Q3 z) (tactG K J g F2 F3 Q2 (tactG J I f F F2 Q1 z)))
        (\ F3 Q2 ->
           idJ (U0 K) Ffg
             (\ F4 E4 -> (Q3 : Id (U0 K) (uAct K I (compH K J I f g) F) F4)
                -> Id (W0.Ix (fib0 K F4)) (tactG K I (compH K J I f g) F F4 Q3 z) (tactG K J g Ff F4 E4 (tactG J I f F Ff (refl Ff) z)))
             base F3 Q2)
        F' q1 F'' q2 q3 ;
  } ;

  toG (K J I : Ob) (f : Hom J I) (g : Hom K J) (F : U0 I) (F' : U0 J) (F'' : U0 K)
    (q1 : Id (U0 J) (uAct J I f F) F') (q2 : Id (U0 K) (uAct K J g F') F'') (q3 : Id (U0 K) (uAct K I (compH K J I f g) F) F'')
    (z : W0.Ix (fib0 I F))
    : Id (W0.Ix (fib0 K F'')) (tactG K I (compH K J I f g) F F'' q3 z) (tactG K J g F' F'' q2 (tactG J I f F F' q1 z)) =
    TO[K, J, I, f, g, F, z].res F' F'' q1 q2 q3 ;

  opaque tidG ; opaque toG ;

  -- the same, at the identity and composition of BC
  tidC (I : Ob) (F : U0 I) (e : Id (U0 I) (uAct I I (BC.idC I) F) F) (z : W0.Ix (fib0 I F))
    : Id (W0.Ix (fib0 I F)) (tactG I I (BC.idC I) F F e z) z =
    substH (\ h -> (e' : Id (U0 I) (uAct I I h F) F) -> Id (W0.Ix (fib0 I F)) (tactG I I h F F e' z) z)
      (symH (idC-idH I)) (\ e' -> tidG I F e' z) e ;

  toC (K J I : Ob) (f : Hom J I) (g : Hom K J) (F : U0 I) (F' : U0 J) (F'' : U0 K)
    (q1 : Id (U0 J) (uAct J I f F) F') (q2 : Id (U0 K) (uAct K J g F') F'') (q3 : Id (U0 K) (uAct K I (BC.oC K J I f g) F) F'')
    (z : W0.Ix (fib0 I F))
    : Id (W0.Ix (fib0 K F'')) (tactG K I (BC.oC K J I f g) F F'' q3 z) (tactG K J g F' F'' q2 (tactG J I f F F' q1 z)) =
    substH (\ h -> (e' : Id (U0 K) (uAct K I h F) F'')
              -> Id (W0.Ix (fib0 K F'')) (tactG K I h F F'' e' z) (tactG K J g F' F'' q2 (tactG J I f F F' q1 z)))
      (symH (oC-compH K J I f g)) (\ e' -> toG K J I f g F F' F'' q1 q2 e' z) q3 ;

  opaque tidC ; opaque toC ;

  -- El, once, as a small type over the universe's context, and the
  -- generic family as El read at level a+
  El : CSmall.SPTy[UCtx] = new CSmall.SPTy[UCtx, \ I F -> fib0 I F, tactG, tidC, toC] ;

  EGen : L1.PTy[UCtx] = CSmall.up UCtx El ;
} ;
