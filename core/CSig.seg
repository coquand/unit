-- CSig.seg (L3, inside CB, level l): Sigma types are fibrant (model.tex
-- Thm "type formers": Sigma).  A partial line in Sigma A B ending at w at
-- src d is composed to tgt d by
--
--   1. its A part, filled in A by fa (a line LA in A over the line of G);
--   2. its B part, a partial line in B over LA (a line in A over a line in
--      G is a line in G.A), composed in B by cb;
--   3. the two ends put together (jn).
--
-- Quarry: seg/model GSig (there for fillers; here for compositions).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;
module PFm = PresheafFormers[a, l].PFormers[BC] ;

module SigC (G : PCtx) (A : PTy[G]) (B : PTy[extP G A]) (d : Bool)
  (fa : CLine[l].Lines[G, A].Fill (src d))
  (cb : CLine[l].Lines[extP G A, B].CompK[src d, tgt d].Comp) {
  module SG = PFm.SigAB[G, A, B] ;
  module TA = GPR.TyL[G, A] ;
  module TB = GPR.TyL[extP G A, B] ;
  module TSg = GPR.TyL[G, SG.SigP] ;
  module FS = CLine[l].FT[G, SG.SigP] ;
  module FA = CLine[l].FT[G, A] ;
  module FB = CLine[l].FT[extP G A, B] ;
  module CS = CLine[l].Lines[G, SG.SigP].CompK[src d, tgt d] ;
  module CB = CLine[l].Lines[extP G A, B].CompK[src d, tgt d] ;
  module KS = CS.EK ;
  module KB = CB.EK ;
  module KA = CLine[l].EndKit[G, A, src d] ;
  module KS' = CLine[l].EndKit[G, SG.SigP, tgt d] ;
  module KB' = CLine[l].EndKit[extP G A, B, tgt d] ;
  module TTS = GPR.TyL[KS.TV.E, CS.Tend] ;
  module TTB = GPR.TyL[KB.TV.E, CB.Tend] ;
  module RCS = CPartial[l].Rel[KS.TV.E, KS.SFm.SF, CS.Tend, CS.endL] ;
  module RCB = CPartial[l].Rel[KB.TV.E, KB.SFm.SF, CB.Tend, CB.endL] ;
  module RCA = CPartial[l].Rel[KA.TV.E, KA.SFm.SF, KA.SFm.SF, CPartial[l].pmap-id KA.TV.E KA.SFm.SF] ;

  ----------------------------------------------------------------------
  -- the parts of an element of Sigma, in E

  pA : PSub[TSg.E, TA.E] = new PSub[TSg.E, TA.E, \ W z -> TA.pr W (TSg.pr1 W z) (TSg.pr2 W z).1, \ J I f z -> refl (TA.E.act J I f (TA.pr I (TSg.pr1 I z) (TSg.pr2 I z).1))] ;

  pB : PSub[TSg.E, TB.E] = new PSub[TSg.E, TB.E, \ W z -> TB.pr W (TA.pr W (TSg.pr1 W z) (TSg.pr2 W z).1) (TSg.pr2 W z).2,
    \ J I f z -> refl (TB.E.act J I f (TB.pr I (TA.pr I (TSg.pr1 I z) (TSg.pr2 I z).1) (TSg.pr2 I z).2))] ;

  jn : PSub[TB.E, TSg.E] = new PSub[TB.E, TSg.E, \ W z -> TSg.pr W (TA.pr1 W (TB.pr1 W z)) (TA.pr2 W (TB.pr1 W z), TB.pr2 W z),
    \ J I f z -> refl (TSg.E.act J I f (TSg.pr I (TA.pr1 I (TB.pr1 I z)) (TA.pr2 I (TB.pr1 I z), TB.pr2 I z)))] ;

  module MA = CLine[l].FMap[TSg.E, TA.E, pA] ;
  module MB = CLine[l].FMap[TSg.E, TB.E, pB] ;

  ----------------------------------------------------------------------
  -- step 1: the A part of the data

  tvA (W : Ob) (w : KS.TV.EI W) : KA.TV.EI W = (KA.TV.pr W (KS.TV.pr1 W w) ((KS.TV.pr2 W w).1)) ;

  -- of a line in Sigma over x: a line in A over x
  lineA (X : Ob) (x : W0.Ix (FS.FG.ob X)) (L : W0.Ix (FS.tobF X x)) : W0.Ix (FA.tobF X x) =
    (MA.mapF X L.1, transH (FA.FG.fam-eq X (FA.piL X (MA.mapF X L.1)) (FS.piL X L.1) (\ W f i -> refl (TSg.pr1 W (L.1.1 W f i)))) L.2) ;

  -- its end is the A part of the end
  endA (W : Ob) (u : KS.TS.EI W)
    : Id (KA.TV.EI W) (FA.Ev[src d].evA.mE W (FA.TL.pr W (KS.TV.pr1 W (KS.TS.pr1 W u)) (lineA W (KS.TV.pr1 W (KS.TS.pr1 W u)) (KS.TS.pr2 W u).1))) (tvA W (KS.TS.pr1 W u)) =
    KA.tv-eq W (FA.Ev[src d].evA.mE W (FA.TL.pr W (KS.TV.pr1 W (KS.TS.pr1 W u)) (lineA W (KS.TV.pr1 W (KS.TS.pr1 W u)) (KS.TS.pr2 W u).1))) (tvA W (KS.TS.pr1 W u)) (refl (KS.TV.pr1 W (KS.TS.pr1 W u)))
      (calc (TA.EI W) {
          KA.endE W (FA.Ev[src d].evA.mE W (FA.TL.pr W (KS.TV.pr1 W (KS.TS.pr1 W u)) (lineA W (KS.TV.pr1 W (KS.TS.pr1 W u)) (KS.TS.pr2 W u).1)))
        =< FA.Ev[src d].endB-E W (FA.TL.pr W (KS.TV.pr1 W (KS.TS.pr1 W u)) (lineA W (KS.TV.pr1 W (KS.TS.pr1 W u)) (KS.TS.pr2 W u).1)) >
          pA.nt W ((KS.TS.pr2 W u).1.1.1 W (idH W) (ptH W (src d)))
        =< apH (pA.nt W) (symH (FS.Ev[src d].endB-E W (FS.TL.pr W (KS.TV.pr1 W (KS.TS.pr1 W u)) ((KS.TS.pr2 W u).1)))) >
          pA.nt W (KS.endE W (FS.Ev[src d].evA.mE W (FS.TL.pr W (KS.TV.pr1 W (KS.TS.pr1 W u)) ((KS.TS.pr2 W u).1))))
        =< apH (\ z -> pA.nt W (KS.endE W z)) (KS.TS.pr2 W u).2 >
          KA.endE W (tvA W (KS.TS.pr1 W u)) }) ;

  tsA (W : Ob) (u : KS.TS.EI W) : KA.TS.EI W = (KA.TS.pr W (tvA W (KS.TS.pr1 W u)) (lineA W (KS.TV.pr1 W (KS.TS.pr1 W u)) (KS.TS.pr2 W u).1, endA W u)) ;

  tsA-act (V W : Ob) (g : Hom V W) (u : KS.TS.EI W)
    : Id (KA.TS.EI V) (KA.TS.E.act V W g (tsA W u)) (tsA V (KS.TS.E.act V W g u)) =
    KA.ts-ext V (KA.TS.E.act V W g (tsA W u)) (tsA V (KS.TS.E.act V W g u)) (refl (KA.TV.E.act V W g (tvA W (KS.TS.pr1 W u))))
      (\ V' g' j -> refl (pA.nt V' ((KS.TS.pr2 W u).1.1.1 V' (compH V' V W g g') j))) ;

  opaque endA ;

  -- the A part of a side
  sideA (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) : KA.PT.Side[X, tvA X w] =
    new KA.PT.Side[X, tvA X w, sd.pQ, \ V f i -> tsA V (sd.pv V f i),
      \ V f i -> apH (tvA V) (sd.ppt V f i),
      \ V' V chi f i i' -> transH (tsA-act V' V chi (sd.pv V f i)) (apH (tsA V') (sd.pnat V' V chi f i i'))] ;

  sideA-restr (Y X : Ob) (h : Hom Y X) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w])
    : Id (KA.PT.Side[Y, tvA Y (KS.TV.E.act Y X h w)])
         (subst (KA.TV.EI Y) (\ z -> KA.PT.Side[Y, z]) (KA.TV.E.act Y X h (tvA X w)) (tvA Y (KS.TV.E.act Y X h w))
            (refl (tvA Y (KS.TV.E.act Y X h w))) (KA.PT.rside Y X h (tvA X w) (sideA X w sd)))
         (sideA Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd)) =
    KA.PT.side-extH Y (KA.TV.E.act Y X h (tvA X w)) (tvA Y (KS.TV.E.act Y X h w)) (refl (tvA Y (KS.TV.E.act Y X h w)))
      (KA.PT.rside Y X h (tvA X w) (sideA X w sd)) (sideA Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))
      (refl (pre Y X h sd.pQ))
      (\ V g i i' -> apH (tsA V) (KS.PT.pv-irr X w sd V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i) (lands-pre V Y X h sd.pQ g i'))) ;

  opaque sideA-restr ;

  ----------------------------------------------------------------------
  -- the other ends, read in E

  rdS (V : Ob) (u : TTS.EI V) : TSg.EI V = KS'.endE V (CS.SE.mV V u) ;
  rdB (V : Ob) (u : TTB.EI V) : TB.EI V = KB'.endE V (CB.SE.mV V u) ;

  rdS-act (V' V : Ob) (g : Hom V' V) (u : TTS.EI V) : Id (TSg.EI V') (rdS V' (TTS.E.act V' V g u)) (TSg.E.act V' V g (rdS V u)) =
    transH (apH (KS'.endE V') (symH (CS.SE.mV-nat V' V g u))) (KS'.endE-act V' V g (CS.SE.mV V u)) ;

  rdB-act (V' V : Ob) (g : Hom V' V) (u : TTB.EI V) : Id (TB.EI V') (rdB V' (TTB.E.act V' V g u)) (TB.E.act V' V g (rdB V u)) =
    transH (apH (KB'.endE V') (symH (CB.SE.mV-nat V' V g u))) (KB'.endE-act V' V g (CB.SE.mV V u)) ;

  -- an element of the composite type is determined by its point and its
  -- reading in E
  tt-ext (W : Ob) (u v : TTS.EI W) (p : Id (KS.TV.EI W) (TTS.pr1 W u) (TTS.pr1 W v)) (q : Id (TSg.EI W) (rdS W u) (rdS W v)) : Id (TTS.EI W) u v =
    CS.SE.mV-inj W u v p (KS'.tv-eq W (CS.SE.mV W u) (CS.SE.mV W v) (apH (\ z -> KS.TV.pr1 W z) p) q) ;

  -- the end of a line of the strict fibres, read in E, is its value
  rdS-end (W : Ob) (u : KS.TS.EI W)
    : Id (TSg.EI W) (rdS W (CS.endL.mE W u)) (FS.lval W (KS.lineL W u) W (idH W) (ptH W (tgt d))) =
    FS.Ev[tgt d].endB-E W (KS.lineL W u) ;

  rdB-end (W : Ob) (u : KB.TS.EI W)
    : Id (TB.EI W) (rdB W (CB.endL.mE W u)) (FB.lval W (KB.lineL W u) W (idH W) (ptH W (tgt d))) =
    FB.Ev[tgt d].endB-E W (KB.lineL W u) ;

  ----------------------------------------------------------------------
  -- step 2: the B part, over the filled A line; step 3: together

  module Cm (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) {
    LA : KA.TS.T X (tvA X w) = fa.kop X (tvA X w) (sideA X w sd) ;

    -- the filled A line LA.1.1 is a line in G.A

    yE : Id (TA.EI X) (LA.1.1.1 X (idH X) (ptH X (src d))) (KA.endE X (tvA X w)) =
      transH (symH (FA.Ev[src d].endB-E X (FA.TL.pr X (KS.TV.pr1 X w) LA.1))) (apH (KA.endE X) LA.2) ;

    b' : W0.Ix (B.tob X (LA.1.1.1 X (idH X) (ptH X (src d)))) =
      TB.coeT X (KA.endE X (tvA X w)) (LA.1.1.1 X (idH X) (ptH X (src d))) (symH yE) (KS.TV.pr2 X w).2 ;

    -- the start of the B part
    wB : KB.TV.EI X = (KB.TV.pr X LA.1.1 b') ;

    wB-E : Id (TB.EI X) (KB.endE X wB) (pB.nt X (KS.endE X w)) =
      symH (TB.pr-coe X (KA.endE X (tvA X w)) (LA.1.1.1 X (idH X) (ptH X (src d))) (symH yE) (KS.TV.pr2 X w).2) ;

    -- the A part of the side is the A filler, restricted
    kA-side (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f)
      : Id (KA.TS.EI V) (KA.TS.E.act V X f (KA.TS.pr X (tvA X w) LA)) (tsA V (sd.pv V f h)) =
      fa.kside X (tvA X w) (sideA X w sd) V f h ;

    -- the B part of the line of the side
    Lb (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f) : KB.TL.EI V =
      (KB.TL.pr V (FB.piL V (MB.mapF V (KS.TS.pr2 V (sd.pv V f h)).1.1)) (MB.mapF V (KS.TS.pr2 V (sd.pv V f h)).1.1, refl (FB.piL V (MB.mapF V (KS.TS.pr2 V (sd.pv V f h)).1.1)))) ;

    Pb (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f) : Id (W0.Ix (FB.FG.ob V)) (KB.TL.pr1 V (Lb V f h)) (KB.TV.pr1 V (KB.TV.E.act V X f wB)) =
      FB.FG.fam-eq V (KB.TL.pr1 V (Lb V f h)) (FB.FG.actF V X f LA.1.1) (\ W' g i -> symH (apH (\ z -> (KA.TS.pr2 V z).1.1.1 W' g i) (kA-side V f h))) ;

    Qb (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f)
      : Id (TB.EI V) (KB.endE V (FB.Ev[src d].evA.mE V (Lb V f h))) (KB.endE V (KB.TV.E.act V X f wB)) =
      calc (TB.EI V) {
          KB.endE V (FB.Ev[src d].evA.mE V (Lb V f h))
        =< FB.Ev[src d].endB-E V (Lb V f h) >
          pB.nt V ((KS.TS.pr2 V (sd.pv V f h)).1.1.1 V (idH V) (ptH V (src d)))
        =< apH (pB.nt V) (symH (FS.Ev[src d].endB-E V (FS.TL.pr V (KS.TV.pr1 V (KS.TS.pr1 V (sd.pv V f h))) ((KS.TS.pr2 V (sd.pv V f h)).1)))) >
          pB.nt V (KS.endE V (FS.Ev[src d].evA.mE V (FS.TL.pr V (KS.TV.pr1 V (KS.TS.pr1 V (sd.pv V f h))) ((KS.TS.pr2 V (sd.pv V f h)).1))))
        =< apH (\ z -> pB.nt V (KS.endE V z)) (KS.TS.pr2 V (sd.pv V f h)).2 >
          pB.nt V (KS.endE V (KS.TS.pr1 V (sd.pv V f h)))
        =< apH (\ z -> pB.nt V (KS.endE V z)) (sd.ppt V f h) >
          pB.nt V (KS.endE V (KS.TV.E.act V X f w))
        =< apH (pB.nt V) (KS.endE-act V X f w) >
          TB.E.act V X f (pB.nt X (KS.endE X w))
        =< apH (TB.E.act V X f) (symH wB-E) >
          TB.E.act V X f (KB.endE X wB)
        =< symH (KB.endE-act V X f wB) >
          KB.endE V (KB.TV.E.act V X f wB) } ;

    pvB (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f) : KB.TS.EI V = KB.mkTS V (KB.TV.E.act V X f wB) (Lb V f h) (Pb V f h) (Qb V f h) ;

    pvB-pt (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f) : Id (KB.TV.EI V) (KB.TS.pr1 V (pvB V f h)) (KB.TV.E.act V X f wB) =
      KB.mkTS-pt V (KB.TV.E.act V X f wB) (Lb V f h) (Pb V f h) (Qb V f h) ;

    -- the values of its line: the B parts of the values of the side
    pv-lev (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f) (W' : Ob) (g : Hom W' V) (j : Hom W' Iv)
      : Id (TB.EI W') (FB.lval V (KB.lineL V (pvB V f h)) W' g j) (pB.nt W' ((KS.TS.pr2 V (sd.pv V f h)).1.1.1 W' g j)) =
      apH (\ M -> FB.lval V M W' g j) (KB.mkTS-line V (KB.TV.E.act V X f wB) (Lb V f h) (Pb V f h) (Qb V f h)) ;

    pnatB : KB.PT.PnTy X sd.pQ pvB = \ V' V g f h h' ->
      KB.ts-ext V' (KB.TS.E.act V' V g (pvB V f h)) (pvB V' (compH V' V X f g) h')
        (transH (apH (KB.TV.E.act V' V g) (pvB-pt V f h))
          (transH (KB.TV.PE.actC V' V X f g wB) (symH (pvB-pt V' (compH V' V X f g) h'))))
        (\ W' g' j ->
          calc (TB.EI W') {
              (FB.lval V' (KB.lineL V' (KB.TS.E.act V' V g (pvB V f h)))) W' g' j
            =< apH (\ M -> FB.lval V' M W' g' j) (KB.lineL-act V' V g (pvB V f h)) >
              (FB.lval V (KB.lineL V (pvB V f h))) W' (compH W' V' V g g') j
            =< pv-lev V f h W' (compH W' V' V g g') j >
              pB.nt W' ((KS.TS.pr2 V (sd.pv V f h)).1.1.1 W' (compH W' V' V g g') j)
            =< apH (\ z -> pB.nt W' ((KS.TS.pr2 V' z).1.1.1 W' g' j)) (sd.pnat V' V g f h h') >
              pB.nt W' ((KS.TS.pr2 V' (sd.pv V' (compH V' V X f g) h')).1.1.1 W' g' j)
            =< symH (pv-lev V' (compH V' V X f g) h' W' g' j) >
              (FB.lval V' (KB.lineL V' (pvB V' (compH V' V X f g) h'))) W' g' j }) ;

    sideB : KB.PT.Side[X, wB] = new KB.PT.Side[X, wB, sd.pQ, pvB, pvB-pt, pnatB] ;

    opaque pvB ;

    -- the B composite and the composite in Sigma
    bB : TTB.T X wB = cb.kop X wB sideB ;

    kE : TSg.EI X = jn.nt X (rdB X (TTB.pr X wB bB)) ;

    pK : Id (TSg.Pt X) (TSg.pr1 X kE) ((FS.FG.ev (tgt d)).nt X (KS.TV.pr1 X w)) = apH (\ q -> q.1 X (idH X) (ptH X (tgt d))) LA.1.2 ;

    kop : TTS.T X w = TSg.fromE X ((FS.FG.ev (tgt d)).nt X (KS.TV.pr1 X w)) kE pK ;

    rdK : Id (TSg.EI X) (rdS X (TTS.pr X w kop)) kE = TSg.fromE-eq X ((FS.FG.ev (tgt d)).nt X (KS.TV.pr1 X w)) kE pK ;
  } ;

  kop (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) : TTS.T X w = Cm[X, w, sd].kop ;

  ----------------------------------------------------------------------
  -- the composite agrees with the sides

  kside (X : Ob) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f)
    : Id (TTS.EI W) (TTS.E.act W X f (TTS.pr X w (kop X w sd))) (CS.endL.mE W (sd.pv W f i)) =
    tt-ext W (TTS.E.act W X f (TTS.pr X w (kop X w sd))) (CS.endL.mE W (sd.pv W f i)) (symH (sd.ppt W f i))
      (calc (TSg.EI W) {
          rdS W (TTS.E.act W X f (TTS.pr X w (kop X w sd)))
        =< rdS-act W X f (TTS.pr X w (kop X w sd)) >
          TSg.E.act W X f (rdS X (TTS.pr X w (kop X w sd)))
        =< apH (TSg.E.act W X f) Cm[X, w, sd].rdK >
          jn.nt W (TB.E.act W X f (rdB X (TTB.pr X (Cm[X, w, sd].wB) (Cm[X, w, sd].bB))))
        =< apH (jn.nt W) (symH (rdB-act W X f (TTB.pr X (Cm[X, w, sd].wB) (Cm[X, w, sd].bB)))) >
          jn.nt W (rdB W (TTB.E.act W X f (TTB.pr X (Cm[X, w, sd].wB) (Cm[X, w, sd].bB))))
        =< apH (\ z -> jn.nt W (rdB W z)) (cb.kside X Cm[X, w, sd].wB Cm[X, w, sd].sideB W f i) >
          jn.nt W (rdB W (CB.endL.mE W (Cm[X, w, sd].pvB W f i)))
        =< apH (jn.nt W) (rdB-end W (Cm[X, w, sd].pvB W f i)) >
          jn.nt W (FB.lval W (KB.lineL W (Cm[X, w, sd].pvB W f i)) W (idH W) (ptH W (tgt d)))
        =< apH (jn.nt W) (Cm[X, w, sd].pv-lev W f i W (idH W) (ptH W (tgt d))) >
          (FS.lval W (KS.lineL W (sd.pv W f i))) W (idH W) (ptH W (tgt d))
        =< symH (rdS-end W (sd.pv W f i)) >
          rdS W (CS.endL.mE W (sd.pv W f i)) }) ;

  ----------------------------------------------------------------------
  -- the composite is uniform: the restricted problem is the problem at the
  -- restricted data (A part by sideA-restr and fa.kunif, then B part)

  module Unif (Y X : Ob) (h : Hom Y X) (w : KS.TV.EI X) (sd : KS.PT.Side[X, w]) {
    module FX = Cm[X, w, sd] ;
    module FY = Cm[Y, KS.TV.E.act Y X h w, KS.PT.rside Y X h w sd] ;

    -- the A filler, restricted
    eA : Id (KA.TS.EI Y) (KA.TS.E.act Y X h (KA.TS.pr X (tvA X w) FX.LA)) (KA.TS.pr Y (tvA Y (KS.TV.E.act Y X h w)) FY.LA) =
      transH (fa.kunif Y X h (tvA X w) (sideA X w sd))
        (RCA.kop-cong fa Y (KA.TV.E.act Y X h (tvA X w)) (tvA Y (KS.TV.E.act Y X h w)) (refl (tvA Y (KS.TV.E.act Y X h w)))
           (KA.PT.rside Y X h (tvA X w) (sideA X w sd)) (sideA Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))
           (sideA-restr Y X h w sd)) ;

    -- the start of the B part, restricted
    eW : Id (KB.TV.EI Y) (KB.TV.E.act Y X h FX.wB) FY.wB =
      KB.tv-eq Y (KB.TV.E.act Y X h FX.wB) FY.wB (apH (\ z -> (KA.TS.pr2 Y z).1.1) eA)
        (calc (TB.EI Y) {
            KB.endE Y (KB.TV.E.act Y X h FX.wB)
          =< KB.endE-act Y X h FX.wB >
            TB.E.act Y X h (KB.endE X FX.wB)
          =< apH (TB.E.act Y X h) FX.wB-E >
            TB.E.act Y X h (pB.nt X (KS.endE X w))
          =< apH (pB.nt Y) (symH (KS.endE-act Y X h w)) >
            pB.nt Y (KS.endE Y (KS.TV.E.act Y X h w))
          =< symH FY.wB-E >
            KB.endE Y FY.wB }) ;

    -- the B side, restricted
    eR : Id (KB.PT.Side[Y, FY.wB])
            (subst (KB.TV.EI Y) (\ z -> KB.PT.Side[Y, z]) (KB.TV.E.act Y X h FX.wB) FY.wB eW (KB.PT.rside Y X h FX.wB FX.sideB))
            FY.sideB =
      KB.PT.side-extH Y (KB.TV.E.act Y X h FX.wB) FY.wB eW (KB.PT.rside Y X h FX.wB FX.sideB) FY.sideB
        (refl (pre Y X h sd.pQ))
        (\ V g i i' ->
          KB.ts-ext V (FX.pvB V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i)) (FY.pvB V g i')
            (transH (FX.pvB-pt V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i))
              (transH (symH (KB.TV.PE.actC V Y X h g FX.wB))
                (transH (apH (KB.TV.E.act V Y g) eW) (symH (FY.pvB-pt V g i')))))
            (\ W' g' j ->
              transH (FX.pv-lev V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i) W' g' j)
                (transH (apH (\ z -> pB.nt W' ((KS.TS.pr2 V z).1.1.1 W' g' j))
                           (KS.PT.pv-irr X w sd V (compH V Y X h g) (lands-pre V Y X h sd.pQ g i) (lands-pre V Y X h sd.pQ g i')))
                        (symH (FY.pv-lev V g i' W' g' j))))) ;

    -- the B composite, restricted
    eB : Id (TTB.EI Y) (TTB.E.act Y X h (TTB.pr X FX.wB FX.bB)) (TTB.pr Y FY.wB FY.bB) =
      transH (cb.kunif Y X h FX.wB FX.sideB)
        (RCB.kop-cong cb Y (KB.TV.E.act Y X h FX.wB) FY.wB eW (KB.PT.rside Y X h FX.wB FX.sideB) FY.sideB eR) ;

    res : Id (TTS.EI Y) (TTS.E.act Y X h (TTS.pr X w (kop X w sd))) (TTS.pr Y (KS.TV.E.act Y X h w) (kop Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))) =
      tt-ext Y (TTS.E.act Y X h (TTS.pr X w (kop X w sd))) (TTS.pr Y (KS.TV.E.act Y X h w) (kop Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd)))
        (refl (KS.TV.E.act Y X h w))
        (calc (TSg.EI Y) {
            rdS Y (TTS.E.act Y X h (TTS.pr X w (kop X w sd)))
          =< rdS-act Y X h (TTS.pr X w (kop X w sd)) >
            TSg.E.act Y X h (rdS X (TTS.pr X w (kop X w sd)))
          =< apH (TSg.E.act Y X h) FX.rdK >
            jn.nt Y (TB.E.act Y X h (rdB X (TTB.pr X FX.wB FX.bB)))
          =< apH (jn.nt Y) (symH (rdB-act Y X h (TTB.pr X FX.wB FX.bB))) >
            jn.nt Y (rdB Y (TTB.E.act Y X h (TTB.pr X FX.wB FX.bB)))
          =< apH (\ z -> jn.nt Y (rdB Y z)) eB >
            FY.kE
          =< symH FY.rdK >
            rdS Y (TTS.pr Y (KS.TV.E.act Y X h w) (kop Y (KS.TV.E.act Y X h w) (KS.PT.rside Y X h w sd))) }) ;

    opaque eA ; opaque eW ; opaque eR ;
  } ;

  opaque kside ;

  -- the composition of Sigma A B from src d to tgt d
  comp : CS.Comp = new RCS.RC[kop, kside, \ Y X h w sd -> Unif[Y, X, h, w, sd].res] ;
} ;

-- Sigma of fibrant types is fibrant: each direction fills A (from its
-- composition, CFill) and composes B
module SigFib (G : PCtx) (A : PTy[G]) (B : PTy[extP G A])
  (fA : CLine[l].Lines[G, A].Fib) (fB : CLine[l].Lines[extP G A, B].Fib) {
  fib : CLine[l].Lines[G, PFm.SigAB[G, A, B].SigP].Fib =
    (SigC[G, A, B, true, CFill[l].FillC[G, A, true, fA.1].fill, fB.1].comp,
     SigC[G, A, B, false, CFill[l].FillC[G, A, false, fA.2].fill, fB.2].comp) ;
} ;
