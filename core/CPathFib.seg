-- CPathFib.seg (L3, inside CB, level l): path types are fibrant (model.tex
-- Thm "type formers": Path).  Path A a b over G is the path type over the
-- constant line, s x (f , i) = x f (CPath.PathOverE with the ends of
-- PathEnds); its two compositions are those of CPathComp, from the
-- compositions of A.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PathFib (G : PCtx) (A : PTy[G]) (a b : PEl[G, A]) {
  module PE = CPath[l].PathEnds[G, A, a, b] ;

  -- the constant line
  s (X : Ob) (x : W0.Ix (G.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv) : W0.Ix (G.ob W) = G.act W X f x ;

  sN (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (W : Ob) (f : Hom W J) (i : Hom W Iv) : Id (W0.Ix (G.ob W)) (s I x W (compH W J I h f) i) (s J y W f i) =
    transH (G.act-o W J I h f x) (apH (G.act W J f) e) ;

  sF (X : Ob) (y : W0.Ix (G.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (G.ob V)) (G.act V W g (s X y W f i)) (s X y V (compH V W X f g) (compH V W Iv i g)) =
    symH (G.act-o V W X f g y) ;

  aE-pt (W : Ob) (y : W0.Ix (G.ob W)) : Id (W0.Ix (G.ob W)) (PE.aE W y).1 (s W y W (idH W) (ptH W e0)) = symH (G.act-id W y) ;
  bE-pt (W : Ob) (y : W0.Ix (G.ob W)) : Id (W0.Ix (G.ob W)) (PE.bE W y).1 (s W y W (idH W) (ptH W e1)) = symH (G.act-id W y) ;

  module PT = CPath[l].PathOverE[G, G, A, true, s, sN, PE.aE, PE.bE, PE.aE-act, PE.bE-act] ;

  PathT : PTy[G] = PT.PathP ;

  module C (e e' : IPt) (ca : CLine[l].Lines[G, A].CompK[e, e'].Comp) {
    module PC = CPathComp[l].PathC[G, G, A, true, s, sN, sF, PE.aE, PE.bE, PE.aE-act, PE.bE-act, aE-pt, bE-pt, e, e', ca] ;
  } ;

  -- Path A a b is fibrant
  fib (fA : CLine[l].Lines[G, A].Fib) : CLine[l].Lines[G, PathT].Fib = (C[e0, e1, fA.1].PC.comp, C[e1, e0, fA.2].PC.comp) ;
} ;
