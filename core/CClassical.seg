-- CClassical.seg (L8, Delta): classical logic, as ONE segment parameter:
-- excluded middle for propositions, at every level.  Only the files
-- imported inside this segment can use it; it is used at exactly one
-- point, CDeltaHornBox.decDeg (deciding whether a filling problem is
-- degenerate along an elementary degeneracy).
--
-- Quarry: seg/model Classical.

open Base ;

module Cl (lem : [b] (P : U b) -> Prelude[b].isProp P -> Arith[b].Plus P (P -> Empty)) {
  import CDeltaHornBox ;
  import CDeltaHornToFib ;
  import CDeltaElFib ;
  import CDeltaFinal ;
} ;
