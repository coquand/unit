-- CTr.seg (L3, inside CB, level l): transport along a line (model.tex
-- Prop "transport is an equivalence", the map).  Built once over the
-- universal context of lines GI: the transport filler of b at a line
-- gamma is the filler (CFill) of the problem with no side starting at b;
-- tr b is its other end.  tr is a map Aev(src d) -> Aev(tgt d) over GI,
-- natural by the uniformity of the filler.
--
-- Quarry: seg/model GTE1 (over GI, ln = id).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module Tr (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp) {
  module FG = CLine[l].FC[G] ;
  module FA = CLine[l].FT[G, A] ;
  module EK = CLine[l].EndKit[G, A, src d] ;
  module EK' = CLine[l].EndKit[G, A, tgt d] ;
  module EVs = FA.Ev[src d] ;
  module EVt = FA.Ev[tgt d] ;
  module TA = EK.TA ;
  module TB = EK.TV ;
  module TA' = EK'.TV ;
  module PT = EK.PT ;

  k : CLine[l].Lines[G, A].Fill (src d) = CFill[l].FillC[G, A, d, ca].fill ;

  SB : PTy[FG.GI] = EVs.Aev ;
  SA : PTy[FG.GI] = EVt.Aev ;

  -- the side with the empty sieve
  noSide (X : Ob) (z : TB.EI X) : PT.Side[X, z] =
    new PT.Side[X, z, emptyS X, \ W f i -> absurd _ (empty-lands W X f i), \ W f i -> absurd _ (empty-lands W X f i),
      \ W' W chi f i i' -> absurd _ (empty-lands W X f i)] ;

  noSideR (Y X : Ob) (h : Hom Y X) (z : TB.EI X)
    : Id (PT.Side[Y, TB.E.act Y X h z]) (PT.rside Y X h z (noSide X z)) (noSide Y (TB.E.act Y X h z)) =
    PT.side-ext Y (TB.E.act Y X h z) (PT.rside Y X h z (noSide X z)) (noSide Y (TB.E.act Y X h z)) (pre-empty Y X h)
      (\ W f i i' -> absurd _ (empty-lands W Y f i')) ;

  opaque noSideR ;

  ----------------------------------------------------------------------
  -- the transport filler and the map

  uF (X : Ob) (w : TB.EI X) : EK.TS.EI X = (w, k.kop X w (noSide X w)) ;

  -- it starts at b
  uF-start (X : Ob) (w : TB.EI X) : Id (TB.EI X) (EVs.evA.mE X (EK.lineL X (uF X w))) w = (uF X w).2.2 ;

  -- it is natural
  uF-nat (Y X : Ob) (h : Hom Y X) (w : TB.EI X) : Id (EK.TS.EI Y) (EK.TS.E.act Y X h (uF X w)) (uF Y (TB.E.act Y X h w)) =
    transH (k.kunif Y X h w (noSide X w))
      (CPartial[l].Rel[TB.E, EK.SFm.SF, EK.SFm.SF, CPartial[l].pmap-id TB.E EK.SFm.SF].kop-cong k Y (TB.E.act Y X h w) (TB.E.act Y X h w)
         (refl (TB.E.act Y X h w)) (PT.rside Y X h w (noSide X w)) (noSide Y (TB.E.act Y X h w)) (noSideR Y X h w)) ;

  opaque uF-nat ;

  trE (X : Ob) (w : TB.EI X) : TA'.EI X = EVt.evA.mE X (EK.lineL X (uF X w)) ;

  trNat (Y X : Ob) (h : Hom Y X) (w : TB.EI X) : Id (TA'.EI Y) (trE Y (TB.E.act Y X h w)) (TA'.E.act Y X h (trE X w)) =
    transH (apH (\ u -> EVt.evA.mE Y (EK.lineL Y u)) (symH (uF-nat Y X h w)))
      (transH (apH (EVt.evA.mE Y) (EK.lineL-act Y X h (uF X w))) (EVt.evA.mnat Y X h (EK.lineL X (uF X w)))) ;

  opaque trNat ;

  tr : CPartial[l].PMap[FG.GI, SB, SA] = new CPartial[l].PMap[FG.GI, SB, SA, trE, \ X w -> refl w.1, trNat] ;
} ;
