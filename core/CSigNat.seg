-- CSigNat.seg (L3, inside CB, level l): the fibration of Sigma is natural
-- (model.tex Thm "type formers", naturality).  For s : D -> G, the
-- fibration of Sigma A[s] B[s] built from the substituted fibrations of A
-- and B is the move of that of Sigma A B along the cartesian map
-- Sigma A[s] B[s] -> Sigma A B over s (same fibres, ta = the lift).
--
-- Proof, per direction, by MoveComp.unique: the composite at the moved
-- data is built from the moved pieces.  The A filler moves (CFillMove,
-- with the A part of the moved side, sideEq); then the start and the side
-- of the B part move (PW, PS), so the B composites agree by kopMv.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;
module PFm = PresheafFormers[a, l].PFormers[BC] ;

-- the cartesian map Sigma A[s] B[s] -> Sigma A B
module SigCart (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[extP G A]) {
  A' : PTy[D] = subTy D G A s ;
  B' : PTy[extP D A'] = subTy (extP D A') (extP G A) B (liftP D G A s) ;
  module SG = PFm.SigAB[G, A, B] ;
  module SD = PFm.SigAB[D, A', B'] ;
  module SES = CSub[l].SubE[D, G, s, SG.SigP] ;
  module TSg = GPR.TyL[G, SG.SigP] ;
  module TSd = GPR.TyL[D, SD.SigP] ;

  -- the action of Sigma A[s] B[s] is that of Sigma A B
  module Tn (V W : Ob) (g : Hom V W) (v : TSd.EI W) {
    y : W0.Ix (D.ob V) = D.act V W g v.1 ;
    eP : Id (W0.Ix (G.ob V)) (G.act V W g (s.nt W v.1)) (s.nt V y) = ntEq D G s V W g v.1 y (refl y) ;
    a' : W0.Ix (A.tob V (s.nt V y)) = A'.tact V W g v.1 y (refl y) v.2.1 ;

    eB : Id (W0.Ix (B.tob V (s.nt V y, a')))
            (B.tact V W g (s.nt W v.1, v.2.1) (s.nt V y, a') (pair-act G A V W g (s.nt W v.1) (s.nt V y) eP v.2.1) v.2.2)
            (SD.SigP.tact V W g v.1 y (refl y) v.2).2 =
      tact-irr (extP G A) B V W g (s.nt W v.1, v.2.1) (s.nt V y, a')
        (pair-act G A V W g (s.nt W v.1) (s.nt V y) eP v.2.1)
        (ntEq (extP D A') (extP G A) (liftP D G A s) V W g (v.1, v.2.1) (y, a') (pair-act D A' V W g v.1 y (refl y) v.2.1))
        v.2.2 ;

    res : Id (TSg.EI V) (TSg.E.act V W g (SES.mV W v)) (SES.mV V (TSd.E.act V W g v)) =
      transH (TSg.pr-tact V W g (s.nt W v.1) (s.nt V y) eP v.2)
        (apH {W0.Ix (B.tob V (s.nt V y, a'))} {TSg.EI V} (\ b -> (s.nt V y, (a', b))) eB) ;
  } ;

  tanat (V W : Ob) (g : Hom V W) (v : TSd.EI W)
    : Id (TSg.EI V) (TSg.E.act V W g (SES.mV W v)) (SES.mV V (TSd.E.act V W g v)) = Tn[V, W, g, v].res ;

  module C = CCart[l, l].Cart[D, SD.SigP, G, SG.SigP, s.nt, s.nt-nat, SES.mV, \ W v -> refl (s.nt W v.1), tanat, SES.mV-inj,
    \ X x u -> u, \ X x u -> refl (s.nt X x, u)] ;
} ;

module SigNatC (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[extP G A]) (d : Bool)
  (ca : CLine[l].Lines[G, A].CompK[src d, tgt d].Comp) (cb : CLine[l].Lines[extP G A, B].CompK[src d, tgt d].Comp) {
  module SC = SigCart[D, G, s, A, B] ;
  module SEA = CSub[l].SubE[D, G, s, A] ;
  module SEB = CSub[l].SubE[extP D SC.A', extP G A, liftP D G A s, B] ;
  module FA_ = CFibSub[l].FibSub[D, G, s, A] ;
  module FB_ = CFibSub[l].FibSub[extP D SC.A', extP G A, liftP D G A s, B] ;
  module MB = FB_.C.MoveComp[src d, tgt d] ;
  module EB = FB_.C.AtEnd[src d] ;
  module MS = SC.C.MoveComp[src d, tgt d] ;
  module ES = SC.C.AtEnd[src d] ;
  module FM = CFillMove[l, l].FillMv[D, SC.A', G, A, s.nt, s.nt-nat, SEA.mV, \ W v -> refl (s.nt W v.1), SEA.mV-nat, SEA.mV-inj,
    \ X x u -> u, \ X x u -> refl (s.nt X x, u), d, ca] ;
  module EA = FM.E ;
  module S' = CSig[l].SigC[D, SC.A', SC.B', d, FM.FC'.fill, MB.move cb] ;
  module S = CSig[l].SigC[G, A, B, d, FM.FC.fill, cb] ;

  module H (X : Ob) (x : ES.EK'.TV.EI X) (sd : ES.EK'.PT.Side[X, x]) {
    module C' = S'.Cm[X, x, sd] ;
    module C = S.Cm[X, ES.sV X x, MS.mside S.comp X x sd] ;

    --------------------------------------------------------------------
    -- the A part of the moved side is the moved A part

    -- the A part of a moved point is the moved A part
    ptA (V : Ob) (z : ES.EK'.TV.EI V) : Id (EA.EK.TV.EI V) (EA.sV V (S'.tvA V z)) (S.tvA V (ES.sV V z)) =
      EA.EK.tv-eq V (EA.sV V (S'.tvA V z)) (S.tvA V (ES.sV V z)) (refl (SC.C.sI V z.1))
        (transH (EA.sVE V (S'.tvA V z)) (apH (S.pA.nt V) (symH (ES.sVE V z)))) ;

    sideEq : Id (EA.EK.PT.Side[X, S.tvA X (ES.sV X x)])
                (subst (EA.EK.TV.EI X) (\ z -> EA.EK.PT.Side[X, z]) (EA.sV X (S'.tvA X x)) (S.tvA X (ES.sV X x)) (ptA X x)
                   (FM.msd X (S'.tvA X x) (S'.sideA X x sd)))
                (S.sideA X (ES.sV X x) (MS.mside S.comp X x sd)) =
      EA.EK.PT.side-extH X (EA.sV X (S'.tvA X x)) (S.tvA X (ES.sV X x)) (ptA X x)
        (FM.msd X (S'.tvA X x) (S'.sideA X x sd)) (S.sideA X (ES.sV X x) (MS.mside S.comp X x sd))
        (refl sd.pQ)
        (\ V f h h' ->
          EA.EK.ts-ext V (EA.mS V (S'.tsA V (sd.pv V f h))) (S.tsA V (ES.mS V (sd.pv V f h')))
            (transH (EA.mSpt V (S'.tsA V (sd.pv V f h)))
              (transH (ptA V (sd.pv V f h).1)
                (transH (apH (\ z -> S.tvA V (ES.sV V z.1)) (ES.EK'.PT.pv-irr X x sd V f h h'))
                        (symH (apH (S.tvA V) (ES.mSpt V (sd.pv V f h')))))))
            (\ V' g j ->
              transH (apH (\ M -> M.2.1.1 V' g j) (EA.mS-line V (S'.tsA V (sd.pv V f h))))
                (transH (apH (\ z -> S.pA.nt V' (SC.SES.mV V' (z.2.1.1.1 V' g j))) (ES.EK'.PT.pv-irr X x sd V f h h'))
                        (symH (apH (\ M -> S.pA.nt V' (M.2.1.1 V' g j)) (ES.mS-line V (sd.pv V f h'))))))) ;

    -- the A fillers
    LAeq : Id (EA.EK.TS.EI X) (EA.mS X (S'.tvA X x, C'.LA)) (S.tvA X (ES.sV X x), C.LA) =
      transH (FM.fill-mv X (S'.tvA X x) (S'.sideA X x sd))
        (S.RCA.kop-cong FM.FC.fill X (EA.sV X (S'.tvA X x)) (S.tvA X (ES.sV X x)) (ptA X x)
           (FM.msd X (S'.tvA X x) (S'.sideA X x sd)) (S.sideA X (ES.sV X x) (MS.mside S.comp X x sd)) sideEq) ;

    LAv (V : Ob) (g : Hom V X) (j : Hom V Iv) : Id (S.TA.EI V) (SEA.mV V (C'.LA.1.1.1 V g j)) (C.LA.1.1.1 V g j) =
      transH (symH (apH (\ M -> M.2.1.1 V g j) (EA.mS-line X (S'.tvA X x, C'.LA)))) (apH (\ z -> z.2.1.1.1 V g j) LAeq) ;

    --------------------------------------------------------------------
    -- the start and the side of the B part move

    PW : Id (EB.EK.TV.EI X) (EB.sV X C'.wB) C.wB =
      EB.EK.tv-eq X (EB.sV X C'.wB) C.wB (FB_.C.FG.fam-eq X (EB.sV X C'.wB).1 C.wB.1 LAv)
        (calc (S.TB.EI X) {
            EB.EK.endE X (EB.sV X C'.wB)
          =< EB.sVE X C'.wB >
            SEB.mV X (EB.EK'.endE X C'.wB)
          =< apH (SEB.mV X) C'.wB-E >
            S.pB.nt X (SC.SES.mV X (S'.KS.endE X x))
          =< apH (S.pB.nt X) (symH (ES.sVE X x)) >
            S.pB.nt X (S.KS.endE X (ES.sV X x))
          =< symH C.wB-E >
            EB.EK.endE X C.wB }) ;

    vB (V : Ob) (f : Hom V X) (h : Lands V X sd.pQ f) (h' : Lands V X sd.pQ f)
      : Id (EB.EK.TS.EI V) (EB.mS V (C'.pvB V f h)) (C.pvB V f h') =
      EB.EK.ts-ext V (EB.mS V (C'.pvB V f h)) (C.pvB V f h')
        (transH (EB.mSpt V (C'.pvB V f h))
          (transH (apH (EB.sV V) (C'.pvB-pt V f h))
            (transH (EB.sV-nat V X f C'.wB)
              (transH (apH (EB.EK.TV.E.act V X f) PW) (symH (C.pvB-pt V f h'))))))
        (\ W' g j ->
          calc (S.TB.EI W') {
              (EB.EK.lineL V (EB.mS V (C'.pvB V f h))).2.1.1 W' g j
            =< apH (\ M -> M.2.1.1 W' g j) (EB.mS-line V (C'.pvB V f h)) >
              SEB.mV W' ((EB.EK'.lineL V (C'.pvB V f h)).2.1.1 W' g j)
            =< apH (SEB.mV W') (C'.pv-lev V f h W' g j) >
              S.pB.nt W' (SC.SES.mV W' ((sd.pv V f h).2.1.1.1 W' g j))
            =< apH (\ u -> S.pB.nt W' (SC.SES.mV W' (u.2.1.1.1 W' g j))) (ES.EK'.PT.pv-irr X x sd V f h h') >
              S.pB.nt W' (SC.SES.mV W' ((sd.pv V f h').2.1.1.1 W' g j))
            =< symH (apH (\ M -> S.pB.nt W' (M.2.1.1 W' g j)) (ES.mS-line V (sd.pv V f h'))) >
              S.pB.nt W' ((ES.EK.lineL V (ES.mS V (sd.pv V f h'))).2.1.1 W' g j)
            =< symH (C.pv-lev V f h' W' g j) >
              (EB.EK.lineL V (C.pvB V f h')).2.1.1 W' g j }) ;

    PS : Id (EB.EK.PT.Side[X, C.wB])
            (subst (EB.EK.TV.EI X) (\ z -> EB.EK.PT.Side[X, z]) (EB.sV X C'.wB) C.wB PW (MB.mside cb X C'.wB C'.sideB)) C.sideB =
      EB.EK.PT.side-extH X (EB.sV X C'.wB) C.wB PW (MB.mside cb X C'.wB C'.sideB) C.sideB (refl sd.pQ) vB ;

    opaque PW ; opaque PS ;

    --------------------------------------------------------------------
    -- the composites agree

    kE-eq : Id (S.TSg.EI X) (SC.SES.mV X C'.kE) C.kE =
      transH (apH (S.jn.nt X) (symH (MB.E'.sVE X (MB.CK'.SE.mV X (C'.wB, C'.bB)))))
        (apH (\ z -> S.jn.nt X (S.rdB X z))
          (transH (MB.kopMv cb X C'.wB C'.sideB)
            (S.RCB.kop-cong cb X (EB.sV X C'.wB) C.wB PW (MB.mside cb X C'.wB C'.sideB) C.sideB PS))) ;

    res : Id (MS.TT.EI X) (MS.mT X (x, S'.comp.kop X x sd)) (ES.sV X x, S.comp.kop X (ES.sV X x) (MS.mside S.comp X x sd)) =
      MS.CK.SE.mV-inj X (MS.mT X (x, S'.comp.kop X x sd)) (ES.sV X x, S.comp.kop X (ES.sV X x) (MS.mside S.comp X x sd))
        (refl (ES.sV X x))
        (MS.E'.EK.tv-eq X (MS.CK.SE.mV X (MS.mT X (x, S'.comp.kop X x sd))) (MS.CK.SE.mV X (ES.sV X x, S.comp.kop X (ES.sV X x) (MS.mside S.comp X x sd)))
          (refl (SC.C.sI X x.1))
          (transH (MS.E'.sVE X (MS.CK'.SE.mV X (x, S'.comp.kop X x sd)))
            (transH (apH (SC.SES.mV X) C'.rdK) (transH kE-eq (symH C.rdK))))) ;
  } ;

  nat : Id (MS.CK'.Comp) S'.comp (MS.move S.comp) = MS.unique S.comp S'.comp (\ X x sd -> H[X, x, sd].res) ;
} ;

-- the fibration of Sigma along s is the move of the fibration of Sigma
module SigNat (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[extP G A])
  (fA : CLine[l].Lines[G, A].Fib) (fB : CLine[l].Lines[extP G A, B].Fib) {
  module SC = SigCart[D, G, s, A, B] ;
  module N1 = SigNatC[D, G, s, A, B, true, fA.1, fB.1] ;
  module N2 = SigNatC[D, G, s, A, B, false, fA.2, fB.2] ;

  fib' : CLine[l].Lines[D, SC.SD.SigP].Fib =
    CSig[l].SigFib[D, SC.A', SC.B', CFibSub[l].FibSub[D, G, s, A].sub fA,
                   CFibSub[l].FibSub[extP D SC.A', extP G A, liftP D G A s, B].sub fB].fib ;

  F : CLine[l].Lines[G, SC.SG.SigP].Fib = CSig[l].SigFib[G, A, B, fA, fB].fib ;

  nat : Id (CLine[l].Lines[D, SC.SD.SigP].Fib) fib' (SC.C.moveFib F) =
    transH {CLine[l].Lines[D, SC.SD.SigP].Fib} {fib'} {((SC.C.moveFib F).1, fib'.2)} {SC.C.moveFib F}
      (apH (\ c -> (c, fib'.2)) N1.nat) (apH (\ c -> ((SC.C.moveFib F).1, c)) N2.nat) ;
} ;
