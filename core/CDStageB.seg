-- CDStageB.seg (L8, Delta): seg/model DStageB.seg ported (module names only).  Was: the starting partial line of the prism of a problem b at
-- [N] (S0 N e: the boundary and the lid at e), glued from
--   the lid       the point of b, read along f
--   the face y    the filler of the face problem resP (dl y) b at the
--                 stage below, read along dgH y f
-- (DUnion).  The faces agree on the codimension-2 faces (Cmp2, a property
-- of the stage below, from its face property); the lid and a face agree
-- because a filler starts at its point.  N = 0 has no faces.
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
open CDCapBase[a] ;
module DUm = CDUnion[a, lz] ;

module SB (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN)) {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;
  module GLm = DB.GPre[lz].PshL[G] ;

  -- the faces of a problem at [N'+1] agree on codimension 2
  Cmp2 (N' : Nat) (F : FillTy N') : U lz =
    (b : Prob (suc N')) (y y' : Nat) (hy : IsT (leb y (suc N'))) (hy' : IsT (leb y' (suc N')))
    (W : Nat) (f : Hom (lin W) (lin (suc N'))) (my : IsT (missB W (suc N') f y)) (my' : IsT (missB W (suc N') f y')) (j : Hom (lin W) Iv)
    -> Id (TA.EI W) (lv N' (fillE N' F (resP N' (suc N') (dl N' y) b)) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) j)
                    (lv N' (fillE N' F (resP N' (suc N') (dl N' y') b)) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y') f) j) ;

  -- the lid at e is the constant map e
  lid-eq (W : Nat) (j : Hom (lin W) Iv) (l : IsT (lidB eN W j)) : Id (Hom (lin W) Iv) j (constH (lin W) Iv e) =
    hom-eq (lin W) Iv j (constH (lin W) Iv e) (pwl W Iv j (constH (lin W) Iv e) (\ i hi ->
      transH (valT-tree W (suc zero) j i hi)
        (transH (lf (valT W (suc zero) j i) eN (eqN-sound (valT W (suc zero) j i) eN (fa-e W (\ v -> eqN (valT W (suc zero) j v) eN) l i hi)))
                (symH eE)))) ;

  lidS (N : Nat) : DPS.PrS N = (\ W f j -> lidB eN W j, \ W' W g f j l -> lid-clos eN W' W g j l) ;

  missS (N y : Nat) : DPS.PrS N = (\ W f j -> missB W N f y, \ W' W g f j m -> miss-clos W' W N y g f m) ;

  ----------------------------------------------------------------------
  module Lines (N : Nat) (b : Prob N) {
    module P = DGm.PL[G, A, N, b.1.1.1, b.1.1.2] ;

    lidV (W : Nat) (f : Hom (lin W) (lin N)) : TA.EI W = TA.E.act W N f (KA.endE N b.1) ;

    lidPt (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (l : IsT (lidB eN W j))
      : Id (W0.Ix (G.ob W)) (lidV W f).1 (b.1.1.1 W f j) =
      transH (b.1.1.2 W N f (idH (lin N)) (constH (lin N) Iv e))
        (transH (apH (\ k -> b.1.1.1 W k (compH (lin W) (lin N) Iv (constH (lin N) Iv e) f)) (comp-idl (lin W) (lin N) f))
          (transH (apH (b.1.1.1 W f) (constH-nat (lin W) (lin N) f e))
                  (apH (b.1.1.1 W f) (symH (lid-eq W j l))))) ;

    lidL : P.PLine[lidS N] =
      new P.PLine[lidS N, \ W f j l -> lidV W f, lidPt,
                  \ V W g f j l l' -> TA.PE.actC V W N f g (KA.endE N b.1)] ;
  } ;

  module Faces (N' : Nat) (Fp : FillTy N') (b : Prob (suc N')) {
    module L = Lines[suc N', b] ;
    module P = L.P ;

    u (y : Nat) : KA.TS.EI N' = fillE N' Fp (resP N' (suc N') (dl N' y) b) ;

    faceV (y : Nat) (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv) : TA.EI W =
      lv N' (u y) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) j ;

    -- dl y (dgH y f) = f for f missing y
    fac-eq (y : Nat) (hy : IsT (leb y (suc N'))) (W : Nat) (f : Hom (lin W) (lin (suc N'))) (m : IsT (missB W (suc N') f y))
      : Id (Hom (lin W) (lin (suc N'))) (compH (lin W) (lin N') (lin (suc N')) (dl N' y) (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f)) f =
      hom-eq (lin W) (lin (suc N')) _ f (pw-factor (lin W) N' y f hy (miss-of W N' y f m)) ;

    facePt (y : Nat) (hy : IsT (leb y (suc N'))) (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv) (m : IsT (missB W (suc N') f y))
      : Id (W0.Ix (G.ob W)) (faceV y W f j).1 (b.1.1.1 W f j) =
      transH (lv-pt N' (u y) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) j)
             (apH (\ k -> b.1.1.1 W k j) (fac-eq y hy W f m)) ;

    faceNat (y : Nat) (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv)
      : Id (TA.EI V) (TA.E.act V W g (faceV y W f j)) (faceV y V (compH (lin V) (lin W) (lin (suc N')) f g) (compH (lin V) (lin W) Iv j g)) =
      transH (lv-nat N' (u y) V W g (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) j)
             (apH (\ k -> lv N' (u y) V k (compH (lin V) (lin W) Iv j g)) (comp-assoc (lin V) (lin W) (lin (suc N')) (lin N') (dgH N' y) f g)) ;

    faceL (y : Nat) (hy : IsT (leb y (suc N'))) : P.PLine[missS (suc N') y] =
      new P.PLine[missS (suc N') y, \ W f j m -> faceV y W f j, \ W f j m -> facePt y hy W f j m,
                  \ V W g f j m m' -> faceNat y V W g f j] ;

    -- the lid and a face agree: the filler starts at its point
    lidFace (y : Nat) (hy : IsT (leb y (suc N'))) (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv)
      (l : IsT (lidB eN W j)) (m : IsT (missB W (suc N') f y)) : Id (TA.EI W) (L.lidV W f) (faceV y W f j) =
      symH (calc (TA.EI W) {
          lv N' (u y) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) j
        =< apH (lv N' (u y) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f)) (lid-eq W j l) >
          lv N' (u y) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) (constH (lin W) Iv e)
        =< symH (levA-ptAct N' (KA.lineL N' (u y)) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f)) >
          TA.E.act W N' (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) (lv N' (u y) N' (idH (lin N')) (constH (lin N') Iv e))
        =< apH (TA.E.act W N' (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f)) (lv-end N' (u y)) >
          TA.E.act W N' (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) (KA.endE N' (u y).1)
        =< apH (TA.E.act W N' (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f)) (KA.endE-act N' (suc N') (dl N' y) b.1) >
          TA.E.act W N' (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) (TA.E.act N' (suc N') (dl N' y) (KA.endE (suc N') b.1))
        =< TA.PE.actC W N' (suc N') (dl N' y) (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) (KA.endE (suc N') b.1) >
          TA.E.act W (suc N') (compH (lin W) (lin N') (lin (suc N')) (dl N' y) (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f)) (KA.endE (suc N') b.1)
        =< apH (\ k -> TA.E.act W (suc N') k (KA.endE (suc N') b.1)) (fac-eq y hy W f m) >
          L.lidV W f }) ;
  } ;

  ----------------------------------------------------------------------
  -- the glued partial line on S0 at [N'+1]

  module Bd (N' : Nat) (Fp : FillTy N') (cmp2 : Cmp2 N' Fp) (b : Prob (suc N')) {
    module Fc = Faces[N', Fp, b] ;
    module P = Fc.P ;

    SsN : Nat -> DPS.PrS (suc N') = split { zero -> lidS (suc N') ; suc y -> missS (suc N') y } ;

    LsN : (n : Nat) -> IsT (ltb n (suc (suc (suc N')))) -> P.PLine[SsN n] = split {
      zero -> \ hn -> Fc.L.lidL ;
      suc y -> \ hn -> Fc.faceL y hn } ;

    cmpN : (n n' : Nat) (hn : IsT (ltb n (suc (suc (suc N'))))) (hn' : IsT (ltb n' (suc (suc (suc N')))))
      (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv) (t : IsT ((SsN n).1 W f j)) (t' : IsT ((SsN n').1 W f j))
      -> Id (TA.EI W) ((LsN n hn).v W f j t) ((LsN n' hn').v W f j t') = split {
      zero -> split {
        zero -> \ hn hn' W f j t t' -> refl (Fc.L.lidV W f) ;
        suc y' -> \ hn hn' W f j t t' -> Fc.lidFace y' hn' W f j t t' } ;
      suc y -> split {
        zero -> \ hn hn' W f j t t' -> symH (Fc.lidFace y hn W f j t' t) ;
        suc y' -> \ hn hn' W f j t t' -> cmp2 b y y' hn hn' W f t t' j } } ;

    module UB = DUm.UN[G, A, suc N', b.1.1.1, b.1.1.2, suc (suc (suc N')), \ l -> SsN l.1, \ l -> LsN l.1 l.2,
                     \ l l' -> cmpN l.1 l'.1 l.2 l'.2] ;

    inc (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv) (s : IsT ((S0 (suc N') eN).1 W f j)) : IsT (UB.S.1 W f j) =
      orE (IsT (UB.S.1 W f j)) (bdB (suc N') W f) (lidB eN W j) s
        (\ bd -> DUm.un-in (suc N') (suc (suc (suc N'))) (\ l -> SsN l.1) (suc (ex-e (suc N') (\ y -> missB W (suc N') f y) bd).1,
                    (ex-e (suc N') (\ y -> missB W (suc N') f y) bd).2.1) W f j (ex-e (suc N') (\ y -> missB W (suc N') f y) bd).2.2)
        (\ l -> DUm.un-in (suc N') (suc (suc (suc N'))) (\ l' -> SsN l'.1) (zero, refl true) W f j l) ;

    L0 : P.PLine[S0 (suc N') eN] = CDChain[a, lz].DC[G, A, suc N', b.1.1.1, b.1.1.2].restrPL UB.S (S0 (suc N') eN) inc UB.L ;

    L0-lid (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv) (s : IsT ((S0 (suc N') eN).1 W f j)) (l : IsT (lidB eN W j))
      : Id (TA.EI W) (L0.v W f j s) (Fc.L.lidV W f) = UB.un-val W f j (inc W f j s) (zero, refl true) l ;

    L0-face (y : Nat) (hy : IsT (leb y (suc N'))) (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv)
      (s : IsT ((S0 (suc N') eN).1 W f j)) (m : IsT (missB W (suc N') f y))
      : Id (TA.EI W) (L0.v W f j s) (Fc.faceV y W f j) = UB.un-val W f j (inc W f j s) (suc y, hy) m ;
  } ;

  -- [0] has no boundary
  module Bd0 (b : Prob zero) {
    module L = Lines[zero, b] ;
    module P = L.P ;

    nobd (W : Nat) (f : Hom (lin W) (lin zero)) (bd : IsT (bdB zero W f)) : Empty =
      false-true (transH (symH (apH not (eqN-refl' (valT W zero f zero) (leb-zero (valT W zero f zero) (valT-range W zero f zero)))))
                         (miss-e W zero zero f bd zero (refl true)))
     where { eqN-refl' (x : Nat) (e' : Id Nat x zero) : Id Bool (eqN x zero) true = substH (\ z -> Id Bool (eqN z zero) true) (symH e') (refl true) ; } ;

    inc (W : Nat) (f : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv) (s : IsT ((S0 zero eN).1 W f j)) : IsT ((lidS zero).1 W f j) =
      orE (IsT (lidB eN W j)) (bdB zero W f) (lidB eN W j) s (\ bd -> absurd _ (nobd W f bd)) (\ l -> l) ;

    L0 : P.PLine[S0 zero eN] = CDChain[a, lz].DC[G, A, zero, b.1.1.1, b.1.1.2].restrPL (lidS zero) (S0 zero eN) inc L.lidL ;
  } ;
} ;
