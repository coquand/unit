-- CDSimpId.seg (L8, Delta): seg/model DSimpId.seg ported (module names only).  Was: the simplicial identities between the elementary faces
-- d_y = dl n y : [n] -> [n+1] and degeneracies s_i = dgH n i : [n+1] -> [n]
-- of Delta, as equalities of maps (from the values: dg / skip):
--
--   sd-id0   s_i d_i = id            (Simp.pw-dg-dl)
--   sd-id1   s_i d_{i+1} = id
--   sd-lo    s_{i+1} d_y = d_y s_i            (y <= i)
--   sd-hi    s_i d_{y+1} = d_y s_i            (i < y)
--   ss       s_j s_i = s_i s_{j+1}            (i <= j)
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DPm = CDPrism[a] ;

------------------------------------------------------------------------
-- dg below and above y

dgLoY : (y n j : Nat) -> IsT (leb j y) -> IsT (leb j n) -> Id Nat (dg n y j) j = split {
  zero -> \ n j hjy hjn -> substH (\ x -> Id Nat (dg n zero x) x) (symH (leb-zero j hjy)) (refl zero) ;
  suc y -> split {
    zero -> \ j hjy hjn -> substH (\ x -> Id Nat (dg zero (suc y) x) x) (symH (leb-zero j hjn)) (refl zero) ;
    suc n -> split {
      zero -> \ hjy hjn -> refl zero ;
      suc j -> \ hjy hjn -> apH (\ k -> suc k) (dgLoY y n j hjy hjn) } } } ;

dg-lo (n y j : Nat) (hjy : IsT (leb j y)) (hjn : IsT (leb j n)) : Id Nat (dg n y j) j = dgLoY y n j hjy hjn ;

dgHiY : (y n x : Nat) -> IsT (leb y x) -> IsT (leb x n) -> Id Nat (dg n y (suc x)) x = split {
  zero -> \ n x h1 h2 -> refl x ;
  suc y -> split {
    zero -> \ x h1 h2 -> absurd _ (false-true (substH (\ z -> IsT (leb (suc y) z)) (leb-zero x h2) h1)) ;
    suc n -> split {
      zero -> \ h1 h2 -> absurd _ (false-true h1) ;
      suc x -> \ h1 h2 -> apH (\ k -> suc k) (dgHiY y n x h1 h2) } } } ;

dg-hi (n y x : Nat) (h1 : IsT (leb y x)) (h2 : IsT (leb x n)) : Id Nat (dg n y (suc x)) x = dgHiY y n x h1 h2 ;

skipGeSelf : (y x : Nat) -> IsT (leb x (skip y x)) = split {
  zero -> \ x -> leb-suc x ;
  suc y -> split { zero -> refl true ; suc x -> skipGeSelf y x } } ;

------------------------------------------------------------------------
-- maps through their values

valT-lin (m n : Nat) (phi : Nat -> Nat) (rng : (i : Nat) -> IsT (leb i m) -> IsT (leb (phi i) n))
  (mon : (i j : Nat) -> IsT (leb i j) -> IsT (leb (phi i) (phi j))) (x : Nat) (hx : IsT (leb x m))
  : Id Nat (valT m n (linH m n phi rng mon) x) (phi x) =
  apH vnum (symH (valT-tree m n (linH m n phi rng mon) x hx)) ;

valT-id (n x : Nat) (hx : IsT (leb x n)) : Id Nat (valT n n (idH (lin n)) x) x =
  apH vnum (symH (transH (symH (app-idH1 (lin n) (leaf x, hx))) (valT-tree n n (idH (lin n)) x hx))) ;

homVal (m n : Nat) (f g : Hom (lin m) (lin n)) (h : (i : Nat) -> IsT (leb i m) -> Id Nat (valT m n f i) (valT m n g i))
  : Id (Hom (lin m) (lin n)) f g =
  hom-eq (lin m) (lin n) f g (pwl m (lin n) f g (\ i hi ->
    transH (valT-tree m n f i hi) (transH (lf (valT m n f i) (valT m n g i) (h i hi)) (symH (valT-tree m n g i hi))))) ;

-- the value of s f, s a degeneracy, and of d f, d a face
valT-sg (W n y : Nat) (f : Hom (lin W) (lin (suc n))) (v : Nat) (hv : IsT (leb v W))
  : Id Nat (valT W n (compH (lin W) (lin (suc n)) (lin n) (dgH n y) f) v) (dg n y (valT W (suc n) f v)) =
  transH (DPm.valT-comp W (suc n) n (dgH n y) f v hv)
         (valT-lin (suc n) n (dg n y) (dg-range n y) (dg-mono n y) (valT W (suc n) f v) (valT-range W (suc n) f v)) ;

valT-dl (W n y : Nat) (f : Hom (lin W) (lin n)) (v : Nat) (hv : IsT (leb v W))
  : Id Nat (valT W (suc n) (compH (lin W) (lin n) (lin (suc n)) (dl n y) f) v) (skip y (valT W n f v)) =
  transH (DPm.valT-comp W n (suc n) (dl n y) f v hv)
         (valT-lin n (suc n) (skip y) (\ i h -> skip-range y i n h) (skip-mono y) (valT W n f v) (valT-range W n f v)) ;

valT-dlx (n y x : Nat) (hx : IsT (leb x n)) : Id Nat (valT n (suc n) (dl n y) x) (skip y x) =
  valT-lin n (suc n) (skip y) (\ i h -> skip-range y i n h) (skip-mono y) x hx ;

valT-dgx (n y x : Nat) (hx : IsT (leb x (suc n))) : Id Nat (valT (suc n) n (dgH n y) x) (dg n y x) =
  valT-lin (suc n) n (dg n y) (dg-range n y) (dg-mono n y) x hx ;

------------------------------------------------------------------------
-- the identities, in numbers

nm-id1 (n i x : Nat) (hi : IsT (leb i n)) (hx : IsT (leb x n)) : Id Nat (dg n i (skip (suc i) x)) x =
  ltb-dec (Id Nat (dg n i (skip (suc i) x)) x) i x
    (\ lt -> transH (apH (dg n i) (skip-ge (suc i) x lt)) (dg-hi n i x (ltb-leb i x lt) hx))
    (\ ge -> transH (apH (dg n i) (skip-lt (suc i) x ge)) (dg-lo n i x ge hx)) ;

nm-lo (n i y x : Nat) (yi : IsT (leb y i)) (hi : IsT (leb i n)) (hx : IsT (leb x (suc n)))
  : Id Nat (dg (suc n) (suc i) (skip y x)) (skip y (dg n i x)) =
  ltb-dec (Id Nat (dg (suc n) (suc i) (skip y x)) (skip y (dg n i x))) x y
    (\ lt -> transH (apH (dg (suc n) (suc i)) (skip-lt y x lt))
               (transH (dg-lo (suc n) (suc i) x (leb-trans x i (suc i) (leb-trans x y i (ltb-leb x y lt) yi) (leb-suc i)) hx)
                 (symH (transH (apH (skip y) (dg-lo n i x (leb-trans x y i (ltb-leb x y lt) yi) (leb-trans x i n (leb-trans x y i (ltb-leb x y lt) yi) hi)))
                               (skip-lt y x lt)))))
    (\ ge -> transH (apH (dg (suc n) (suc i)) (skip-ge y x ge))
               (ltb-dec (Id Nat (dg (suc n) (suc i) (suc x)) (skip y (dg n i x))) i x
                  (\ lt2 -> up x lt2 hx ge)
                  (\ ge2 -> transH (dg-lo (suc n) (suc i) (suc x) ge2 (leb-trans x i n ge2 hi))
                              (symH (transH (apH (skip y) (dg-lo n i x ge2 (leb-trans x i n ge2 hi))) (skip-ge y x ge))))))
 where { up : (x' : Nat) -> IsT (ltb i x') -> IsT (leb x' (suc n)) -> IsT (leb y x') -> Id Nat (dg (suc n) (suc i) (suc x')) (skip y (dg n i x')) = split {
           zero -> \ lt h g -> absurd _ (false-true lt) ;
           suc z -> \ lt h g -> transH (dg-hi (suc n) (suc i) (suc z) lt h)
                                  (symH (transH (apH (skip y) (dg-hi n i z lt h)) (skip-ge y z (leb-trans y i z yi lt)))) } ; } ;

nm-hi (n i y x : Nat) (iy : IsT (ltb i y)) (hy : IsT (leb y (suc n))) (hx : IsT (leb x (suc n)))
  : Id Nat (dg (suc n) i (skip (suc y) x)) (skip y (dg n i x)) =
  ltb-dec (Id Nat (dg (suc n) i (skip (suc y) x)) (skip y (dg n i x))) i x
    (\ lt -> up x lt hx)
    (\ ge -> transH (apH (dg (suc n) i) (skip-lt (suc y) x (leb-trans x i y ge (ltb-leb i y iy))))
               (transH (dg-lo (suc n) i x ge hx)
                 (symH (transH (apH (skip y) (dg-lo n i x ge (lowN x ge))) (skip-lt y x (leb-trans (suc x) (suc i) y ge iy))))))
 where {
   lowN (x : Nat) (ge : IsT (leb x i)) : IsT (leb x n) = leb-trans (suc x) y (suc n) (leb-trans (suc x) (suc i) y ge iy) hy ;
   up : (x' : Nat) -> IsT (ltb i x') -> IsT (leb x' (suc n)) -> Id Nat (dg (suc n) i (skip (suc y) x')) (skip y (dg n i x')) = split {
     zero -> \ lt h -> absurd _ (false-true lt) ;
     suc z -> \ lt h -> transH (dg-hi (suc n) i (skip y z) (leb-trans i z (skip y z) lt (skipGeSelf y z)) (skip-range y z n h))
                          (symH (apH (skip y) (dg-hi n i z lt h))) } ; } ;

nm-ss (n i j x : Nat) (ij : IsT (leb i j)) (jn : IsT (leb j n)) (hx : IsT (leb x (suc (suc n))))
  : Id Nat (dg n j (dg (suc n) i x)) (dg n i (dg (suc n) (suc j) x)) =
  ltb-dec (Id Nat (dg n j (dg (suc n) i x)) (dg n i (dg (suc n) (suc j) x))) i x
    (\ lt -> up x lt hx)
    (\ ge -> transH (apH (dg n j) (dg-lo (suc n) i x ge (leb-trans x n (suc n) (xn x ge) (leb-suc n))))
               (transH (dg-lo n j x (leb-trans x i j ge ij) (xn x ge))
                 (symH (transH (apH (dg n i) (dg-lo (suc n) (suc j) x (leb-trans x j (suc j) (leb-trans x i j ge ij) (leb-suc j))
                                                (leb-trans x n (suc n) (xn x ge) (leb-suc n))))
                               (dg-lo n i x ge (xn x ge))))))
 where {
   xn (x : Nat) (ge : IsT (leb x i)) : IsT (leb x n) = leb-trans x j n (leb-trans x i j ge ij) jn ;
   up : (x' : Nat) -> IsT (ltb i x') -> IsT (leb x' (suc (suc n))) -> Id Nat (dg n j (dg (suc n) i x')) (dg n i (dg (suc n) (suc j) x')) = split {
     zero -> \ lt h -> absurd _ (false-true lt) ;
     suc z -> \ lt h -> transH (apH (dg n j) (dg-hi (suc n) i z lt h))
       (ltb-dec (Id Nat (dg n j z) (dg n i (dg (suc n) (suc j) (suc z)))) j z
          (\ lt2 -> up2 z lt2 lt h)
          (\ ge2 -> transH (dg-lo n j z ge2 (leb-trans z j n ge2 jn))
                      (symH (transH (apH (dg n i) (dg-lo (suc n) (suc j) (suc z) ge2 (leb-trans z j n ge2 jn)))
                                    (dg-hi n i z lt (leb-trans z j n ge2 jn)))))) } ;
   up2 : (z : Nat) -> IsT (ltb j z) -> IsT (leb i z) -> IsT (leb z (suc n)) -> Id Nat (dg n j z) (dg n i (dg (suc n) (suc j) (suc z))) = split {
     zero -> \ lt2 lt h -> absurd _ (false-true lt2) ;
     suc w -> \ lt2 lt h -> transH (dg-hi n j w lt2 h)
                (symH (transH (apH (dg n i) (dg-hi (suc n) (suc j) (suc w) lt2 h)) (dg-hi n i w (leb-trans i j w ij lt2) h))) } ; } ;

------------------------------------------------------------------------
-- the identities, as maps

valT-dgdl (n i y x : Nat) (hx : IsT (leb x n))
  : Id Nat (valT n n (compH (lin n) (lin (suc n)) (lin n) (dgH n i) (dl n y)) x) (dg n i (skip y x)) =
  transH (DPm.valT-comp n (suc n) n (dgH n i) (dl n y) x hx)
    (transH (apH (valT (suc n) n (dgH n i)) (valT-dlx n y x hx)) (valT-dgx n i (skip y x) (skip-range y x n hx))) ;

valT-dldg (n i y x : Nat) (hx : IsT (leb x (suc n)))
  : Id Nat (valT (suc n) (suc n) (compH (lin (suc n)) (lin n) (lin (suc n)) (dl n y) (dgH n i)) x) (skip y (dg n i x)) =
  transH (DPm.valT-comp (suc n) n (suc n) (dl n y) (dgH n i) x hx)
    (transH (apH (valT n (suc n) (dl n y)) (valT-dgx n i x hx)) (valT-dlx n y (dg n i x) (dg-range n i x hx))) ;

valT-dgdg (n i j x : Nat) (hx : IsT (leb x (suc (suc n))))
  : Id Nat (valT (suc (suc n)) n (compH (lin (suc (suc n))) (lin (suc n)) (lin n) (dgH n j) (dgH (suc n) i)) x) (dg n j (dg (suc n) i x)) =
  transH (DPm.valT-comp (suc (suc n)) (suc n) n (dgH n j) (dgH (suc n) i) x hx)
    (transH (apH (valT (suc n) n (dgH n j)) (valT-dgx (suc n) i x hx)) (valT-dgx n j (dg (suc n) i x) (dg-range (suc n) i x hx))) ;

-- s_i d_i = id
sd-id0 (n i : Nat) (hi : IsT (leb i (suc n)))
  : Id (Hom (lin n) (lin n)) (compH (lin n) (lin (suc n)) (lin n) (dgH n i) (dl n i)) (idH (lin n)) =
  hom-eq (lin n) (lin n) _ _ (pw-dg-dl n i hi) ;

-- s_i d_{i+1} = id
sd-id1 (n i : Nat) (hi : IsT (leb i n))
  : Id (Hom (lin n) (lin n)) (compH (lin n) (lin (suc n)) (lin n) (dgH n i) (dl n (suc i))) (idH (lin n)) =
  homVal n n _ _ (\ x hx -> transH (valT-dgdl n i (suc i) x hx) (transH (nm-id1 n i x hi hx) (symH (valT-id n x hx)))) ;

-- s_{i+1} d_y = d_y s_i  (y <= i)
sd-lo (n i y : Nat) (yi : IsT (leb y i)) (hi : IsT (leb i n))
  : Id (Hom (lin (suc n)) (lin (suc n)))
       (compH (lin (suc n)) (lin (suc (suc n))) (lin (suc n)) (dgH (suc n) (suc i)) (dl (suc n) y))
       (compH (lin (suc n)) (lin n) (lin (suc n)) (dl n y) (dgH n i)) =
  homVal (suc n) (suc n) _ _ (\ x hx -> transH (valT-dgdl (suc n) (suc i) y x hx)
    (transH (nm-lo n i y x yi hi hx) (symH (valT-dldg n i y x hx)))) ;

-- s_i d_{y+1} = d_y s_i  (i < y)
sd-hi (n i y : Nat) (iy : IsT (ltb i y)) (hy : IsT (leb y (suc n)))
  : Id (Hom (lin (suc n)) (lin (suc n)))
       (compH (lin (suc n)) (lin (suc (suc n))) (lin (suc n)) (dgH (suc n) i) (dl (suc n) (suc y)))
       (compH (lin (suc n)) (lin n) (lin (suc n)) (dl n y) (dgH n i)) =
  homVal (suc n) (suc n) _ _ (\ x hx -> transH (valT-dgdl (suc n) i (suc y) x hx)
    (transH (nm-hi n i y x iy hy hx) (symH (valT-dldg n i y x hx)))) ;

-- s_j s_i = s_i s_{j+1}  (i <= j)
ss (n i j : Nat) (ij : IsT (leb i j)) (jn : IsT (leb j n))
  : Id (Hom (lin (suc (suc n))) (lin n))
       (compH (lin (suc (suc n))) (lin (suc n)) (lin n) (dgH n j) (dgH (suc n) i))
       (compH (lin (suc (suc n))) (lin (suc n)) (lin n) (dgH n i) (dgH (suc n) (suc j))) =
  homVal (suc (suc n)) n _ _ (\ x hx -> transH (valT-dgdg n i j x hx)
    (transH (nm-ss n i j x ij jn hx) (symH (valT-dgdg n (suc j) i x hx)))) ;

opaque sd-id1 ; opaque sd-lo ; opaque sd-hi ; opaque ss ;
