-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostStep2.seg (L9): step 2 of the construction (postnikov.tex, Theorem
-- conv): at f : [m] -> X, the prism H^m(f) and the square Theta_m(f) in
-- C_m = i*K_m A.
--
-- The open box of [m] * [1]_t * [1]_s in C_m, filled from s = 0 (CDFill.FT
-- with the horn fillers of CCoskHorn.HK):
--
--   lid    eta H^{m+1}(f) at s = 0          (H = Hs (m+1) of the recursion)
--   t = 0  eta psi(f)
--   t = 1  p_m(f), the reading of p_m along f * [1] in K_m (CPostK.DRK)
--   sides  eta Theta(f d_y , m+1)           (Th y = Ts m of the faces)
--
-- E2 holds the lid and the ends (End0K: p_m at s = 0 is eta of u_{m+1},
-- End1K: at s = 1 it is eta of u_m); S2 (m = m' + 1) and S2z (m = 0) fill
-- the box (CPostSq) and give
--
--   Thm , Hm      Theta_m(f) and H^m(f) = Thm at s = 1, in C_m
--   Hm-0 , Hm-1   H^m(f) goes from eta psi(f) to eta of u_m along f
--   Hm-face       on the face y, H^m(f) is eta Th y at s = 1

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module PK = CPostK[a, l] ;
module BD = CPostBdry[a, l] ;
module SQ = CPostSq[a, l] ;

module E2 (G : PP.PCtx) (A : PP.PTy[G]) (X : Ob) (x : W0.Ix (G.ob X)) (m : Nat) (f : Hom (lin m) X)
  (um : LD.DT[G, CK.KT[G, A, m].KA].DEl X x) (um1 : LD.DT[G, CK.KT[G, A, suc m].KA].DEl X x)
  (pm : LD.DT[G, CK.KT[G, A, m].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (r : Nat) (hr : IsT (leb r m)) (hr' : IsT (leb r (suc m))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, m].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pm.1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc m].rd (lin r) (G.act (lin r) X q x) (um1.1 r q).1 r hr' (idH (lin r))))
  (pe1 : (r : Nat) (hr : IsT (leb r m)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, m].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pm.1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, m].rd (lin r) (G.act (lin r) X q x) (um.1 r q).1 r hr (idH (lin r))))
  (psi : PB.GPre[l].TyL[G, A].EI (lin m)) (psi-pt : Id (W0.Ix (G.ob (lin m))) (PB.GPre[l].TyL[G, A].pr1 (lin m) psi) (G.act (lin m) X f x))
  (H : (W : Nat) -> Hom (lin W) (lin m) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hp : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (H W g j)) (G.act (lin W) (lin m) g (G.act (lin m) X f x)))
  (Hn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (H W g j))
              (H V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)))
  (H0 : (W : Nat) (g : Hom (lin W) (lin m))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin m) g psi))
  (H1 : (W : Nat) (g : Hom (lin W) (lin m))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e1))
              (PM.DR[G, A, suc m, X, x, um1, lin m, EZ.HLin[m].ht, m, EZ.HLin[m].hB, EZ.HLin[m].hm, EZ.HLin[m].hi,
                     leb-trans m (suc m) (suc m) (leb-suc m) (leb-refl (suc m)), f].val W g)) {
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;
  module KM = CK.KT[G, A, m] ;
  module TK = KM.TK ;
  module ET = KM ;

  xf : W0.Ix (G.ob (lin m)) = G.act (lin m) X f x ;
  XI : Ob = prodP X Iv ;
  xI : W0.Ix (G.ob XI) = G.act XI X (pr1 X Iv) x ;
  module BX = BD.BXm[m, Iv] ;
  module HM = EZ.HLin[m] ;
  module H1v = EZ.HLin[suc zero] ;
  module HP = EZ.HProd[lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, Iv, H1v.ht, suc zero, H1v.hB, H1v.hm, H1v.hi] ;
  xB : W0.Ix (G.ob BX.XB) = G.act BX.XB (lin m) BX.p1B xf ;
  f1 : Hom BX.XB XI = crossH (lin m) X Iv Iv f (idH Iv) ;

  -- f * [1] maps the point of X * [1] to the point of [m] * [1]
  ctxP : Id (W0.Ix (G.ob BX.XB)) (G.act BX.XB XI f1 xI) xB =
    calc (W0.Ix (G.ob BX.XB)) {
        G.act BX.XB XI f1 xI
      =< GL.actC BX.XB XI X (pr1 X Iv) f1 x >
        G.act BX.XB X (compH BX.XB XI X (pr1 X Iv) f1) x
      =< apH (\ k -> G.act BX.XB X k x) (pr1-pair X Iv BX.XB (compH BX.XB (lin m) X f BX.p1B) (compH BX.XB Iv Iv (idH Iv) (pr2 (lin m) Iv))) >
        G.act BX.XB X (compH BX.XB (lin m) X f BX.p1B) x
      =< G.act-o BX.XB (lin m) X f BX.p1B x >
        xB } ;

  ----------------------------------------------------------------------
  -- the reading of p_m along f * [1], in K_m

  module DPK = PK.DRK[G, A, m, XI, xI, pm, BX.XB, HP.ht, plus m (suc zero), HP.hB, HP.hm, HP.hi, f1] ;

  Pl (W : Nat) (g : Hom (lin W) BX.XB) : TK.EI (lin W) = DPK.val W g ;

  Plp (W : Nat) (g : Hom (lin W) BX.XB) : Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (Pl W g)) (G.act (lin W) BX.XB g xB) =
    transH (DPK.vp W g) (apH (G.act (lin W) BX.XB g) ctxP) ;

  Pln (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB)
    : Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) h (Pl W g)) (Pl V (compH (lin V) (lin W) BX.XB g h)) = DPK.vn V W h g ;

  -- the pair (g , e) is the lid e after g
  pair-lid (W : Nat) (g : Hom (lin W) (lin m)) (e : El Iv)
    : Id (Hom (lin W) BX.XB) (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e)) (compH (lin W) (lin m) BX.XB (lid (lin m) e) g) =
    transH (apH (\ k -> pairH (lin m) Iv (lin W) k (constH (lin W) Iv e)) (symH (comp-idl (lin W) (lin m) g)))
      (transH (apH (pairH (lin m) Iv (lin W) (compH (lin W) (lin m) (lin m) (idH (lin m)) g)) (symH (BD.const-h (lin W) (lin m) g e)))
              (symH (BD.pair-h (lin m) Iv (lin W) (lin m) (idH (lin m)) (constH (lin m) Iv e) g))) ;

  -- f * [1] after the lid e, after a chain
  lidq (r : Nat) (e : El Iv) (cc : Hom (lin r) (lin m))
    : Id (Hom (lin r) XI) (compH (lin r) (lin m) XI (compH (lin m) BX.XB XI f1 (lid (lin m) e)) cc)
                          (compH (lin r) X XI (lid X e) (compH (lin r) (lin m) X f cc)) =
    transH (apH (\ k -> compH (lin r) (lin m) XI k cc) (BD.cross-lid (lin m) X f e)) (comp-assoc (lin r) (lin m) X XI (lid X e) f cc) ;

  -- p_m at s = 0 is eta of u_{m+1}
  module DU1 = PM.DR[G, A, suc m, X, x, um1, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-trans m (suc m) (suc m) (leb-suc m) (leb-refl (suc m)), f] ;
  module DZ0 = PM.DR[G, A, m, XI, xI, pm, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-refl m, compH (lin m) BX.XB XI f1 (lid (lin m) e0)] ;

  module End0K (W : Nat) (g : Hom (lin W) (lin m)) {
    module D1 = PK.DRKI[G, A, m, XI, xI, pm, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi,
                        BX.XB, HP.ht, plus m (suc zero), HP.hB, HP.hm, HP.hi, f1, lid (lin m) e0, BD.lid-strict (lin m) e0, W, g] ;
    module Z = PK.DRKE[G, A, m, suc m, XI, xI, pm, X, x, um1, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi,
                       leb-refl m, leb-trans m (suc m) (suc m) (leb-suc m) (leb-refl (suc m)), compH (lin m) BX.XB XI f1 (lid (lin m) e0), f,
                       \ r hr hr' cc -> transH (apH (\ k -> DZ0.zc r hr k) (lidq r e0 cc)) (pe0 r hr hr' (compH (lin r) (lin m) X f cc)),
                       W, g] ;
    res : Id (TK.EI (lin W)) (Pl W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0))) (ET.etaE (lin W) (DU1.val W g)) =
      transH (apH (Pl W) (pair-lid W g e0)) (transH (symH D1.res) Z.res) ;
  } ;

  -- p_m at s = 1 is eta of u_m
  module DU = PM.DR[G, A, m, X, x, um, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-refl m, f] ;
  module DZ1 = PM.DR[G, A, m, XI, xI, pm, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi, leb-refl m, compH (lin m) BX.XB XI f1 (lid (lin m) e1)] ;

  module End1K (W : Nat) (g : Hom (lin W) (lin m)) {
    module D1 = PK.DRKI[G, A, m, XI, xI, pm, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi,
                        BX.XB, HP.ht, plus m (suc zero), HP.hB, HP.hm, HP.hi, f1, lid (lin m) e1, BD.lid-strict (lin m) e1, W, g] ;
    module Z = PK.DRKE[G, A, m, m, XI, xI, pm, X, x, um, lin m, HM.ht, m, HM.hB, HM.hm, HM.hi,
                       leb-refl m, leb-refl m, compH (lin m) BX.XB XI f1 (lid (lin m) e1), f,
                       \ r hr hr' cc -> transH (apH (\ k -> DZ1.zc r hr k) (lidq r e1 cc))
                                          (transH (pe1 r hr (compH (lin r) (lin m) X f cc))
                                                  (KM.rd-irr (lin r) (G.act (lin r) X (compH (lin r) (lin m) X f cc) x)
                                                     (um.1 r (compH (lin r) (lin m) X f cc)).1 r hr hr' (idH (lin r)))),
                       W, g] ;
    res : Id (TK.EI (lin W)) (Pl W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1))) (ET.etaE (lin W) (DU.val W g)) =
      transH (apH (Pl W) (pair-lid W g e1)) (transH (symH D1.res) Z.res) ;
  } ;

  ----------------------------------------------------------------------
  -- the lid eta H^{m+1}(f) and the edge eta psi

  psiK : TK.EI (lin m) = ET.etaE (lin m) psi ;

  L (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TK.EI (lin W) = ET.etaE (lin W) (H W g j) ;

  Ln (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
    : Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) h (L W g j)) (L V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)) =
    transH (symH (ET.etaE-act (lin V) (lin W) h (H W g j))) (apH (ET.etaE (lin V)) (Hn V W h g j)) ;

  L0 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TK.EI (lin W)) (L W g (constH (lin W) Iv e0)) (TK.E.act (lin W) (lin m) g psiK) =
    transH (apH (ET.etaE (lin W)) (H0 W g)) (ET.etaE-act (lin W) (lin m) g psi) ;

  L1 (W : Nat) (g : Hom (lin W) (lin m))
    : Id (TK.EI (lin W)) (L W g (constH (lin W) Iv e1)) (Pl W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0))) =
    transH (apH (ET.etaE (lin W)) (H1 W g)) (symH End0K[W, g].res) ;

  module SE = SQ.SqE[G, KM.KA, m, xf, e0, psiK, psi-pt, L, Hp, Ln, Pl, Plp, Pln, L0, L1] ;

  -- H^m(f) = Theta_m(f) at s = 1
  module HT (Thf : (W : Nat) -> Hom (lin W) BX.XB -> Hom (lin W) Iv -> TK.EI (lin W))
    (Thf-p : (W : Nat) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (Thf W g j)) (G.act (lin W) BX.XB g xB))
    (Thf-n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) BX.XB) (j : Hom (lin W) Iv)
             -> Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) BX.XB g h) (compH (lin V) (lin W) Iv j h)))
    (Thf-t0 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TK.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j) (TK.E.act (lin W) (lin m) g psiK))
    (Thf-t1 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TK.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j) (Pl W (pairH (lin m) Iv (lin W) g j))) {
    module Q = SE.HT[Thf, Thf-p, Thf-n, Thf-t0, Thf-t1, e1] ;

    Hm (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TK.EI (lin W) = Q.H' W g j ;

    Hmp (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (Hm W g j)) (G.act (lin W) (lin m) g xf) =
      Q.H'p W g j ;

    Hmn (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) h (Hm W g j)) (Hm V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)) =
      Q.H'n V W h g j ;

    Hm-0 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TK.EI (lin W)) (Hm W g (constH (lin W) Iv e0)) (TK.E.act (lin W) (lin m) g psiK) =
      Q.H'0 W g ;

    Hm-1 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TK.EI (lin W)) (Hm W g (constH (lin W) Iv e1)) (ET.etaE (lin W) (DU.val W g)) =
      transH (Q.H'1 W g) End1K[W, g].res ;

    opaque Hm-1 ;
  } ;
} ;

------------------------------------------------------------------------
-- m = m' + 1

module S2 (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W0.Ix (G.ob X)) (m' : Nat) (f : Hom (lin (suc m')) X)
  (um : LD.DT[G, CK.KT[G, A, suc m'].KA].DEl X x) (um1 : LD.DT[G, CK.KT[G, A, suc (suc m')].KA].DEl X x)
  (pm : LD.DT[G, CK.KT[G, A, suc m'].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (r : Nat) (hr : IsT (leb r (suc m'))) (hr' : IsT (leb r (suc (suc m')))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, suc m'].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pm.1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc (suc m')].rd (lin r) (G.act (lin r) X q x) (um1.1 r q).1 r hr' (idH (lin r))))
  (pe1 : (r : Nat) (hr : IsT (leb r (suc m'))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, suc m'].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pm.1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc m'].rd (lin r) (G.act (lin r) X q x) (um.1 r q).1 r hr (idH (lin r))))
  (psi : PB.GPre[l].TyL[G, A].EI (lin (suc m'))) (psi-pt : Id (W0.Ix (G.ob (lin (suc m')))) (PB.GPre[l].TyL[G, A].pr1 (lin (suc m')) psi) (G.act (lin (suc m')) X f x))
  (H : (W : Nat) -> Hom (lin W) (lin (suc m')) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hp : (W : Nat) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (H W g j)) (G.act (lin W) (lin (suc m')) g (G.act (lin (suc m')) X f x)))
  (Hn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (H W g j))
              (H V (compH (lin V) (lin W) (lin (suc m')) g h) (compH (lin V) (lin W) Iv j h)))
  (H0 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin (suc m')) g psi))
  (H1 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e1))
              (PM.DR[G, A, suc (suc m'), X, x, um1, lin (suc m'), EZ.HLin[suc m'].ht, suc m', EZ.HLin[suc m'].hB, EZ.HLin[suc m'].hm, EZ.HLin[suc m'].hi,
                     leb-trans (suc m') (suc (suc m')) (suc (suc m')) (leb-suc (suc m')) (leb-refl (suc (suc m'))), f].val W g))
  (Th : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Iv) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Thp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (Th y hy W g j))
               (G.act (lin W) (prodP (lin m') Iv) g (G.act (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv)
                  (G.act (lin m') X (compH (lin m') (lin (suc m')) X f (dl m' y)) x))))
  (Thn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (Th y hy W g j))
               (Th y hy V (compH (lin V) (lin W) (prodP (lin m') Iv) g h) (compH (lin V) (lin W) Iv j h)))
  (Th-s0 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv))
           -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W g (constH (lin W) Iv e0))
                 (H W (compH (lin W) (lin m') (lin (suc m')) (dl m' y) (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g))
                      (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)))
  (Th-t0 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                 (PB.GPre[l].TyL[G, A].E.act (lin W) (lin (suc m')) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) psi))
  (Th-t1 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                 (PM.DR[G, A, suc m', prodP X Iv, G.act (prodP X Iv) X (pr1 X Iv) x, pm,
                        prodP (lin m') Iv, EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                                     Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].ht,
                        plus m' (suc zero),
                        EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                 Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].hB,
                        EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                 Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].hm,
                        EZ.HProd[lin m', EZ.HLin[m'].ht, m', EZ.HLin[m'].hB, EZ.HLin[m'].hm, EZ.HLin[m'].hi,
                                 Iv, EZ.HLin[suc zero].ht, suc zero, EZ.HLin[suc zero].hB, EZ.HLin[suc zero].hm, EZ.HLin[suc zero].hi].hi,
                        BD.leN m' (suc m') (leb-refl (suc m')),
                        crossH (lin m') X Iv Iv (compH (lin m') (lin (suc m')) X f (dl m' y)) (idH Iv)].val W (pairH (lin m') Iv (lin W) g j)))
  (FFt : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
         (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         (msy : Miss (lin W) m' y (BD.BG[m', Iv].p1g W g)) (msz : Miss (lin W) m' z (BD.BG[m', Iv].p1g W g)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (Th y hy W (BD.BG[m', Iv].gy y W g) j) (Th z hz W (BD.BG[m', Iv].gy z W g) j)) {
  m : Nat = suc m' ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;
  module RG = CLocRestr[a, l].R[G] ;
  module E = E2[G, A, X, x, suc m', f, um, um1, pm, pe0, pe1, psi, psi-pt, H, Hp, Hn, H0, H1] ;
  module KM = E.KM ;
  module TK = E.TK ;
  module ET = E.ET ;
  module FT = CDFill[a, l].FT[RG.iG, RG.T[KM.KA].iA, CCoskHorn[a, l].HK[G, A, m, c].horn] ;
  module BG = BD.BG[m', Iv] ;
  Xf : Ob = BG.Xf ;
  module HMf = EZ.HLin[m'] ;
  module HPf = EZ.HProd[lin m', HMf.ht, m', HMf.hB, HMf.hm, HMf.hi, Iv, E.H1v.ht, suc zero, E.H1v.hB, E.H1v.hm, E.H1v.hi] ;

  -- the point of a face
  ptD (y : Nat) : Id (W0.Ix (G.ob Xf)) (G.act Xf (lin m') (pr1 (lin m') Iv) (G.act (lin m') X (compH (lin m') (lin m) X f (dl m' y)) x))
                                       (G.act Xf E.BX.XB (BG.dY y) E.xB) =
    calc (W0.Ix (G.ob Xf)) {
        G.act Xf (lin m') (pr1 (lin m') Iv) (G.act (lin m') X (compH (lin m') (lin m) X f (dl m' y)) x)
      =< apH (G.act Xf (lin m') (pr1 (lin m') Iv)) (G.act-o (lin m') (lin m) X f (dl m' y) x) >
        G.act Xf (lin m') (pr1 (lin m') Iv) (G.act (lin m') (lin m) (dl m' y) E.xf)
      =< GL.actC Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Iv) E.xf >
        G.act Xf (lin m) (compH Xf (lin m') (lin m) (dl m' y) (pr1 (lin m') Iv)) E.xf
      =< apH (\ k -> G.act Xf (lin m) k E.xf) (symH (BG.pr1-dY y)) >
        G.act Xf (lin m) (compH Xf E.BX.XB (lin m) E.BX.p1B (BG.dY y)) E.xf
      =< G.act-o Xf E.BX.XB (lin m) E.BX.p1B (BG.dY y) E.xf >
        G.act Xf E.BX.XB (BG.dY y) E.xB } ;

  ----------------------------------------------------------------------
  -- the sides eta Th y

  ThK (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv) : TK.EI (lin W) = ET.etaE (lin W) (Th y hy W g j) ;

  ThKp (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (ThK y hy W g j)) (G.act (lin W) Xf g (G.act Xf E.BX.XB (BG.dY y) E.xB)) =
    transH (Thp y hy W g j) (apH (G.act (lin W) Xf g) (ptD y)) ;

  ThKn (y : Nat) (hy : IsT (leb y m)) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
    : Id (TK.EI (lin V)) (TK.E.act (lin V) (lin W) h (ThK y hy W g j)) (ThK y hy V (compH (lin V) (lin W) Xf g h) (compH (lin V) (lin W) Iv j h)) =
    transH (symH (ET.etaE-act (lin V) (lin W) h (Th y hy W g j))) (apH (ET.etaE (lin V)) (Thn y hy V W h g j)) ;

  ThK-e (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf)
    : Id (TK.EI (lin W)) (ThK y hy W g (constH (lin W) Iv e0))
                         (E.L W (compH (lin W) (lin m') (lin m) (dl m' y) (compH (lin W) Xf (lin m') (pr1 (lin m') Iv) g))
                                (compH (lin W) Xf Iv (pr2 (lin m') Iv) g)) =
    apH (ET.etaE (lin W)) (Th-s0 y hy W g) ;

  ThK-t0 (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
    : Id (TK.EI (lin W)) (ThK y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                         (TK.E.act (lin W) (lin m) (compH (lin W) (lin m') (lin m) (dl m' y) g) E.psiK) =
    transH (apH (ET.etaE (lin W)) (Th-t0 y hy W g j)) (ET.etaE-act (lin W) (lin m) (compH (lin W) (lin m') (lin m) (dl m' y) g) psi) ;

  -- d_y * [1] is strict, and f * [1] after it is (f d_y) * [1]
  dIst (y : Nat) : Strict Xf E.BX.XB (crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv)) = BD.cross-strict m' m (dl m' y) (dl-strict m' y) ;

  fd1 (y : Nat) : Id (Hom Xf E.XI) (compH Xf E.BX.XB E.XI E.f1 (crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv)))
                                 (crossH (lin m') X Iv Iv (compH (lin m') (lin m) X f (dl m' y)) (idH Iv)) =
    transH (BD.cross-comp (lin m') (lin m) X Iv Iv Iv f (idH Iv) (dl m' y) (idH Iv))
           (apH (crossH (lin m') X Iv Iv (compH (lin m') (lin m) X f (dl m' y))) (comp-idl Iv Iv (idH Iv))) ;

  -- eta of the face reading of p_m is the K-reading along f * [1], on the face
  module FaceK (y : Nat) (W : Nat) (g : Hom (lin W) Xf) {
    hBf : IsT (leb (plus m' (suc zero)) m) = BD.leN m' (suc m') (leb-refl (suc m')) ;
    kf : Hom Xf E.XI = crossH (lin m') X Iv Iv (compH (lin m') (lin m) X f (dl m' y)) (idH Iv) ;
    phiK (k : Hom Xf E.XI) : TK.EI (lin W) = PK.DRK[G, A, m, E.XI, E.xI, pm, Xf, HPf.ht, plus m' (suc zero), HPf.hB, HPf.hm, HPf.hi, k].val W g ;
    module Z = PK.DRKE[G, A, m, m, E.XI, E.xI, pm, E.XI, E.xI, pm, Xf, HPf.ht, plus m' (suc zero), HPf.hB, HPf.hm, HPf.hi, hBf, hBf,
                       kf, kf,
                       \ r hr hr' cc -> KM.rd-irr (lin r) (G.act (lin r) E.XI (compH (lin r) Xf E.XI kf cc) E.xI)
                                          (pm.1 r (compH (lin r) Xf E.XI kf cc)).1 r hr hr' (idH (lin r)), W, g] ;
    module D1 = PK.DRKI[G, A, m, E.XI, E.xI, pm, Xf, HPf.ht, plus m' (suc zero), HPf.hB, HPf.hm, HPf.hi,
                        E.BX.XB, E.HP.ht, plus m (suc zero), E.HP.hB, E.HP.hm, E.HP.hi,
                        E.f1, crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv), dIst y, W, g] ;
    res : Id (TK.EI (lin W)) (ET.etaE (lin W) (Z.D2.val W g)) (E.Pl W (compH (lin W) Xf E.BX.XB (crossH (lin m') (lin m) Iv Iv (dl m' y) (idH Iv)) g)) =
      transH (symH Z.res) (transH (apH phiK (symH (fd1 y))) D1.res) ;
  } ;

  ThK-t1 (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
    : Id (TK.EI (lin W)) (ThK y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                         (E.Pl W (pairH (lin m) Iv (lin W) (compH (lin W) (lin m') (lin m) (dl m' y) g) j)) =
    transH (apH (ET.etaE (lin W)) (Th-t1 y hy W g j))
      (transH FaceK[y, W, pairH (lin m') Iv (lin W) g j].res
        (apH (E.Pl W)
           (transH (BD.cross-pair (lin m') (lin m) Iv Iv (lin W) (dl m' y) (idH Iv) g j)
                   (apH (pairH (lin m) Iv (lin W) (compH (lin W) (lin m') (lin m) (dl m' y) g)) (comp-idl (lin W) Iv j))))) ;

  FFtK (y z : Nat) (hy : IsT (leb y m)) (hz : IsT (leb z m)) (lt : IsT (ltb y z))
    (W : Nat) (g : Hom (lin W) E.BX.XB) (msy : Miss (lin W) m' y (BG.p1g W g)) (msz : Miss (lin W) m' z (BG.p1g W g)) (j : Hom (lin W) Iv)
    : Id (TK.EI (lin W)) (ThK y hy W (BG.gy y W g) j) (ThK z hz W (BG.gy z W g) j) =
    apH (ET.etaE (lin W)) (FFt y z hy hz lt W g msy msz j) ;

  ----------------------------------------------------------------------
  -- the box in C_m

  module Sq = SQ.SqS[G, KM.KA, e0, FT.S.fill, FT.S.sides, FT.S.face, m', E.xf, E.psiK, psi-pt, E.L, Hp, E.Ln, E.Pl, E.Plp, E.Pln, E.L0, E.L1,
                     ThK, ThKp, ThKn, ThK-e, ThK-t0, ThK-t1, FFtK] ;

  -- Theta_m(f)
  Thm (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : TK.EI (lin W) = Sq.Thf W g j ;

  module HH = E.HT[Sq.Thf, Sq.Thf-p, Sq.Thf-n, Sq.Thf-t0, Sq.Thf-t1] ;

  -- H^m(f)
  Hm (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) : TK.EI (lin W) = HH.Hm W g j ;

  -- on the face y, H^m(f) is eta Th y at s = 1
  Hm-face (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
    : Id (TK.EI (lin W)) (Hm W (compH (lin W) (lin m') (lin m) (dl m' y) g) j)
                         (ET.etaE (lin W) (Th y hy W (pairH (lin m') Iv (lin W) g j) (constH (lin W) Iv e1))) =
    Sq.HT[e1].H'-face y hy W g j ;
} ;

------------------------------------------------------------------------
-- m = 0

module S2z (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib)
  (X : Ob) (x : W0.Ix (G.ob X)) (f : Hom (lin zero) X)
  (um : LD.DT[G, CK.KT[G, A, zero].KA].DEl X x) (um1 : LD.DT[G, CK.KT[G, A, suc zero].KA].DEl X x)
  (pm : LD.DT[G, CK.KT[G, A, zero].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (r : Nat) (hr : IsT (leb r zero)) (hr' : IsT (leb r (suc zero))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, zero].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pm.1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc zero].rd (lin r) (G.act (lin r) X q x) (um1.1 r q).1 r hr' (idH (lin r))))
  (pe1 : (r : Nat) (hr : IsT (leb r zero)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, zero].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  (pm.1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, zero].rd (lin r) (G.act (lin r) X q x) (um.1 r q).1 r hr (idH (lin r))))
  (psi : PB.GPre[l].TyL[G, A].EI (lin zero)) (psi-pt : Id (W0.Ix (G.ob (lin zero))) (PB.GPre[l].TyL[G, A].pr1 (lin zero) psi) (G.act (lin zero) X f x))
  (H : (W : Nat) -> Hom (lin W) (lin zero) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, A].EI (lin W))
  (Hp : (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob (lin W))) (PB.GPre[l].TyL[G, A].pr1 (lin W) (H W g j)) (G.act (lin W) (lin zero) g (G.act (lin zero) X f x)))
  (Hn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin V)) (PB.GPre[l].TyL[G, A].E.act (lin V) (lin W) h (H W g j))
              (H V (compH (lin V) (lin W) (lin zero) g h) (compH (lin V) (lin W) Iv j h)))
  (H0 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, A].E.act (lin W) (lin zero) g psi))
  (H1 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, A].EI (lin W)) (H W g (constH (lin W) Iv e1))
              (PM.DR[G, A, suc zero, X, x, um1, lin zero, EZ.HLin[zero].ht, zero, EZ.HLin[zero].hB, EZ.HLin[zero].hm, EZ.HLin[zero].hi,
                     leb-trans zero (suc zero) (suc zero) (leb-suc zero) (leb-refl (suc zero)), f].val W g)) {
  module RG = CLocRestr[a, l].R[G] ;
  module E = E2[G, A, X, x, zero, f, um, um1, pm, pe0, pe1, psi, psi-pt, H, Hp, Hn, H0, H1] ;
  module TK = E.TK ;
  module FT = CDFill[a, l].FT[RG.iG, RG.T[E.KM.KA].iA, CCoskHorn[a, l].HK[G, A, zero, c].horn] ;

  module Sq = SQ.SqZ[G, E.KM.KA, e0, FT.S.fill, FT.S.sides, FT.S.face, E.xf, E.psiK, psi-pt, E.L, Hp, E.Ln, E.Pl, E.Plp, E.Pln, E.L0, E.L1] ;

  Thm (W : Nat) (g : Hom (lin W) E.BX.XB) (j : Hom (lin W) Iv) : TK.EI (lin W) = Sq.Thf W g j ;

  module HH = E.HT[Sq.Thf, Sq.Bx.Fp, Sq.Bx.Fn, Sq.Thf-t0, Sq.Thf-t1] ;

  Hm (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv) : TK.EI (lin W) = HH.Hm W g j ;
} ;
