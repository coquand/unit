-- CUa.seg (L6, inside CB): the type of univalence over the universe
-- (model.tex Def Ua: at F in U(X), the triples (B , alpha , e) with e an
-- equivalence structure on alpha : El B -> El F).  Represented as the
-- FULL glue data over F: points D of GD1 at X with A_D = F and phi_D full
-- (by Yoneda a full glue datum is a code B over y X with alpha and e).
-- The action is GD1's (CGlueE.act1: e moves along the cart of triples),
-- moved to the given code F' through the path; its laws are gd1-id /
-- gd1-o (CGlueLaws) and the irrelevance of the paths in the set U(X).
--
-- Quarry: seg/model GUnivEq (UaU).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L1 = GPre[a+].PS ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;

module UaU (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GL = CGlueLaws.GL[Cl, clSub, clSub-id, clSub-o, encCl] ;

  setU0 (X : Ob) : isSet (UU.U0 X) = V1.isSetIx (UU.codeU X) ;

  -- the full glue data over F
  Prp (X : Ob) (F : UU.U0 X) (D : GE.GD1 X) : U a+ = Id (UU.U0 X) D.1.1 F * IsT (allS X D.1.2.1) ;

  isProp-Prp (X : Ob) (F : UU.U0 X) (D : GE.GD1 X) : isProp (Prp X F D) =
    isProp-Sigma (Id (UU.U0 X) D.1.1 F) (\ p -> IsT (allS X D.1.2.1)) (setU0 X D.1.1 F) (\ p -> isProp-IsT' (allS X D.1.2.1)) ;

  UaT0 (X : Ob) (F : UU.U0 X) : U a+ = (D : GE.GD1 X) * Prp X F D ;

  -- two elements with the same glue datum are equal
  uaExt (X : Ob) (F : UU.U0 X) (y y' : UaT0 X F) (P : Id (GE.GD1 X) y.1 y'.1) : Id (UaT0 X F) y y' =
    Sigma-eq (GE.GD1 X) (Prp X F) y.1 y'.1 y.2 y'.2 P (isProp-Prp X F y'.1) ;

  opaque uaExt ;

  -- a full sieve stays full under restriction
  fullAct (J I : Ob) (f : Hom J I) (ph : Phi I) (h : IsT (allS I ph)) : IsT (allS J (pre J I f ph)) =
    allS-complete J (pre J I f ph)
      (pre-lands J J I f ph (idH J)
        (lands-eq J I ph f (compH J J I f (idH J)) (symH (comp-idr J I f))
          (lands-eq J I ph (compH J I I (idH I) f) f (comp-idl J I f) (lands-comp J I I ph (idH I) f (allS-sound I ph h))))) ;

  opaque fullAct ;

  -- the action: GD1's, moved to F' along e
  uaTact (J I : Ob) (f : Hom J I) (F : UU.U0 I) (F' : UU.U0 J) (e : Id (UU.U0 J) (UU.uAct J I f F) F') (y : UaT0 I F) : UaT0 J F' =
    (GL.GD1Ctx.act J I f y.1, (transH (apH (UU.uAct J I f) y.2.1) e, fullAct J I f y.1.1.2.1 y.2.2)) ;

  uaTid (I : Ob) (F : UU.U0 I) (e : Id (UU.U0 I) (UU.uAct I I (idH I) F) F) (y : UaT0 I F) : Id (UaT0 I F) (uaTact I I (idH I) F F e y) y =
    uaExt I F (uaTact I I (idH I) F F e y) y (GL.GD1Ctx.act-id I y.1) ;

  uaTo (K J I : Ob) (f : Hom J I) (g : Hom K J) (F : UU.U0 I) (F' : UU.U0 J) (F'' : UU.U0 K)
    (e1' : Id (UU.U0 J) (UU.uAct J I f F) F') (e2 : Id (UU.U0 K) (UU.uAct K J g F') F'')
    (e3 : Id (UU.U0 K) (UU.uAct K I (compH K J I f g) F) F'') (y : UaT0 I F)
    : Id (UaT0 K F'') (uaTact K I (compH K J I f g) F F'' e3 y) (uaTact K J g F' F'' e2 (uaTact J I f F F' e1' y)) =
    uaExt K F'' (uaTact K I (compH K J I f g) F F'' e3 y) (uaTact K J g F' F'' e2 (uaTact J I f F F' e1' y)) (GL.GD1Ctx.act-o K J I f g y.1) ;

  opaque uaTid ; opaque uaTo ;

  -- the code, and the type over the universe
  encUa (X : Ob) (F : UU.U0 X) : Enc (UaT0 X F) =
    encSig (GE.GD1 X) (\ D -> Prp X F D) (GL.encGD1 X) (\ D -> encProp (Prp X F D) (isProp-Prp X F D)) ;

  encUaf (X : Ob) (F : UU.U0 X) (z : UaT0 X F) : V1.V = (encUa X F).1 z ;

  encUainj (X : Ob) (F : UU.U0 X) : V1.Inj (UaT0 X F) (encUaf X F) = (encUa X F).2 ;

  opaque encUaf ; opaque encUainj ;

  codeUa (X : Ob) (F : UU.U0 X) : V1.V = V1.mkV (UaT0 X F) (encUaf X F) (encUainj X F) ;

  UaTy : L1.PTy[UU.UCtx] =
    new L1.PTy[UU.UCtx, \ I F -> codeUa I F, uaTact, uaTid, \ K J I f g x y z e1' e2 e3 a0 -> uaTo K J I f g x y z e1' e2 e3 a0] ;
} ;
