-- CThm7.seg (L5, inside CB, level l): Theorem 7 (model.tex §6.1).  For A
-- fibrant over G, psi a cofibration, B fibrant over G|psi and an
-- equivalence structure on alpha : B -> A|psi, Ext(alpha) is fibrant and
-- ext : Ext(alpha) -> A has an equivalence structure.  The fillers are
-- derived from the compositions (CFill).
--
-- Quarry: seg/model GExtFib.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module Thm7 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (cA : CLine[l].Lines[G, A].Fib) (cB : CLine[l].Lines[GP.CofL[G, psi].resCtx, B].Fib)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;

  -- the fillers of A and B at both ends
  fA0 : CLine[l].Lines[G, A].Fill e0 = CFill[l].FillC[G, A, true, cA.1].fill ;
  fA1 : CLine[l].Lines[G, A].Fill e1 = CFill[l].FillC[G, A, false, cA.2].fill ;
  fB0 : CLine[l].Lines[resCtx, B].Fill e0 = CFill[l].FillC[resCtx, B, true, cB.1].fill ;
  fB1 : CLine[l].Lines[resCtx, B].Fill e1 = CFill[l].FillC[resCtx, B, false, cB.2].fill ;

  extEquiv : CEquiv[l].EquivOp G ExtT A extMap = CExtEquiv3[l].ExtEq3[G, A, psi, B, al, fA1, eal].extEquiv ;

  extFib : CLine[l].Lines[G, ExtT].Fib =
    (CExtComp4[l].C4[G, A, psi, B, al, e0, e1, fA0, fB0, fA1, eal].extComp,
     CExtComp4[l].C4[G, A, psi, B, al, e1, e0, fA1, fB1, fA1, eal].extComp) ;
} ;
