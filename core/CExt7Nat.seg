-- CExt7Nat.seg (L5, inside CB): naturality of Theorem 7 (model.tex
-- thm:7-nat), in move form.  For glue data l : D -> GD and t : D' -> D,
-- Ext(l t) has the same fibres as Ext(l) at t (identity cart KE over t,
-- likewise KA for A), and its structures are the moves of Ext(l)'s:
--
--   fib-nat   fib(l t) = KE.moveFib fib(l)     (CCartLaws2: composite + congruence)
--   ext-nat   ext(l t) and ext(l) commute with the carts
--   eq-nat    eq(l t) = moveEq eq(l) along (KA , KE)   (CHFibLaws: HComp + HCong)
--
-- The substitution form of fib-nat is CSmallSub.SS.law; the moves are
-- the substitutions by tr-move (CTrFib) and its analogue CTrEq.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module N7 (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib)
  (D D' : PCtx) (l : CSmall.XSub[D, CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl].GDr]) (t : PSub[D', D]) {
  module EL = CExtL.EL[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  module UB = EL.UB ;
  module XS = EL.XS ;

  lt : CSmall.XSub[D', UB.GDr] = CSmall.xoS D' D UB.GDr l t ;

  module E = EL.At[D, l] ;
  module E' = EL.At[D', lt] ;

  ----------------------------------------------------------------------
  -- the cart S(l t) -> S(l) over t, the identity on fibres

  module Ct (S : CSmall.SPTy[UB.GDr]) {
    B1 : PTy[D'] = CSmall.xsub D' UB.GDr S lt ;
    B0 : PTy[D] = CSmall.xsub D UB.GDr S l ;
    module T1 = GPR.TyL[D', B1] ;
    module T0 = GPR.TyL[D, B0] ;

    ta (W : Ob) (v : T1.EI W) : T0.EI W = (t.nt W v.1, v.2) ;

    tanat (V W : Ob) (g : Hom V W) (v : T1.EI W) : Id (T0.EI V) (T0.E.act V W g (ta W v)) (ta V (T1.E.act V W g v)) =
      transH (T0.pr-tact V W g (t.nt W v.1) (t.nt V (D'.act V W g v.1)) (ntEq D' D t V W g v.1 (D'.act V W g v.1) (refl (D'.act V W g v.1))) v.2)
        (apH {W0.Ix (B0.tob V (t.nt V (D'.act V W g v.1)))} {T0.EI V} (\ z -> (t.nt V (D'.act V W g v.1), z))
          (CSmall.tact-irr UB.GDr S V W g (l.nt W (t.nt W v.1)) (l.nt V (t.nt V (D'.act V W g v.1)))
             (CSmall.xntEq D UB.GDr l V W g (t.nt W v.1) (t.nt V (D'.act V W g v.1)) (ntEq D' D t V W g v.1 (D'.act V W g v.1) (refl (D'.act V W g v.1))))
             (CSmall.xntEq D' UB.GDr lt V W g v.1 (D'.act V W g v.1) (refl (D'.act V W g v.1)))
             v.2)) ;

    tainj (W : Ob) (v v' : T1.EI W) (P : Id (W0.Ix (D'.ob W)) v.1 v'.1) (Q : Id (T0.EI W) (ta W v) (ta W v')) : Id (T1.EI W) v v' =
      idJ (W0.Ix (D'.ob W)) v.1
        (\ d2 P2 -> (b2 : W0.Ix (B1.tob W d2)) -> Id (T0.EI W) (t.nt W v.1, v.2) (t.nt W d2, b2) -> Id (T1.EI W) v (d2, b2))
        (\ b2 Q2 -> apH {W0.Ix (B1.tob W v.1)} {T1.EI W} (\ z -> (v.1, z)) (T0.pr-inj W (t.nt W v.1) v.2 b2 Q2))
        v'.1 P v'.2 Q ;

    opaque tanat ; opaque tainj ;
  } ;

  module CE = Ct[XS.SA] ;
  module CA = Ct[EL.AS] ;

  module KE = CCart[a, a].Cart[D', E'.ExtT, D, E.ExtT, t.nt, t.nt-nat, CE.ta, \ W v -> refl (t.nt W v.1), CE.tanat, CE.tainj,
    \ X x u -> u, \ X x u -> refl (t.nt X x, u)] ;

  ----------------------------------------------------------------------
  -- the fibration

  module CC = CCartLaws2[a, a, a+].CC[D', E'.ExtT, D, E.ExtT, UB.GDr, XS.upSA,
    t.nt, t.nt-nat, CE.ta, \ W v -> refl (t.nt W v.1), CE.tanat, CE.tainj, \ X x u -> u, \ X x u -> refl (t.nt X x, u),
    l.nt, l.nt-nat, E.SFT.ta, \ W w -> refl (l.nt W w.1), E.SFT.tanat, E.SFT.tainj, \ X x u -> u, \ X x u -> refl (l.nt X x, u)] ;

  module CG = CCartLaws2[a, a+, a+].CG[D', E'.ExtT, UB.GDr, XS.upSA,
    CC.s, CC.s-nat, CC.ta, CC.tapt, CC.tanat, CC.tainj, CC.bk, CC.bkta,
    lt.nt, lt.nt-nat, E'.SFT.ta, \ W w -> refl (lt.nt W w.1), E'.SFT.tanat, E'.SFT.tainj, \ X x u -> u, \ X x u -> refl (lt.nt X x, u),
    \ W x -> refl (l.nt W (t.nt W x)), \ W v -> refl (l.nt W (t.nt W v.1), v.2)] ;

  fib-nat : Id (CLine[a].Lines[D', E'.ExtT].Fib) E'.fib (KE.moveFib E.fib) =
    symH (transH (CC.compFib XS.fibSA) (CG.congFib XS.fibSA)) ;

  ----------------------------------------------------------------------
  -- the map ext

  ext-nat (W : Ob) (v : E'.TE.EI W) : Id (E.TA.EI W) (CA.ta W (E'.ext.mE W v)) (E.ext.mE W (CE.ta W v)) =
    E.SFA.tainj W (CA.ta W (E'.ext.mE W v)) (E.ext.mE W (CE.ta W v)) (refl (t.nt W v.1))
      (transH (E'.extE-ta W v) (symH (E.extE-ta W (CE.ta W v)))) ;

  ----------------------------------------------------------------------
  -- the equivalence structure

  module HT = CHFibCart[a, a].HCart[D', E'.ExtT, E'.AT, E'.ext, D, E.ExtT, E.AT, E.ext, t.nt, t.nt-nat,
    CA.ta, \ W v -> refl (t.nt W v.1), CA.tanat, CA.tainj, \ X x u -> u, \ X x u -> refl (t.nt X x, u),
    CE.ta, \ W v -> refl (t.nt W v.1), CE.tanat, CE.tainj, \ X x u -> u, \ X x u -> refl (t.nt X x, u),
    ext-nat] ;

  module HC = CHFibLaws[a, a, a+].HComp[D', E'.ExtT, E'.AT, E'.ext, D, E.ExtT, E.AT, E.ext, UB.GDr, XS.upSA, UB.AU, XS.extSA,
    t.nt, t.nt-nat,
    CA.ta, \ W v -> refl (t.nt W v.1), CA.tanat, CA.tainj, \ X x u -> u, \ X x u -> refl (t.nt X x, u),
    CE.ta, \ W v -> refl (t.nt W v.1), CE.tanat, CE.tainj, \ X x u -> u, \ X x u -> refl (t.nt X x, u),
    ext-nat,
    l.nt, l.nt-nat,
    E.SFA.ta, \ W v -> refl (l.nt W v.1), E.SFA.tanat, E.SFA.tainj, \ X x u -> u, \ X x u -> refl (l.nt X x, u),
    E.SFT.ta, \ W v -> refl (l.nt W v.1), E.SFT.tanat, E.SFT.tainj, \ X x u -> u, \ X x u -> refl (l.nt X x, u),
    E.extE-ta, XS.eqSA] ;

  module HG = CHFibLaws[a, a, a+].HCong[D', E'.ExtT, E'.AT, E'.ext, UB.GDr, XS.upSA, UB.AU, XS.extSA,
    HC.s, HC.s-nat, HC.tA, HC.tApt, HC.tAnat, HC.tAinj, HC.bkA, HC.bkAta, HC.tB, HC.tBpt, HC.tBnat, HC.tBinj, HC.bkB, HC.bkBta, HC.comm,
    lt.nt, lt.nt-nat,
    E'.SFA.ta, \ W v -> refl (lt.nt W v.1), E'.SFA.tanat, E'.SFA.tainj, \ X x u -> u, \ X x u -> refl (lt.nt X x, u),
    E'.SFT.ta, \ W v -> refl (lt.nt W v.1), E'.SFT.tanat, E'.SFT.tainj, \ X x u -> u, \ X x u -> refl (lt.nt X x, u),
    E'.extE-ta,
    \ W v -> refl (l.nt W (t.nt W v.1), v.2), \ W v -> refl (l.nt W (t.nt W v.1), v.2), XS.eqSA] ;

  eq-nat : Id (CEquiv[a].EquivOp D' E'.ExtT E'.AT E'.ext) E'.eq (HT.moveEq E.eq) =
    symH (transH HC.comp HG.cong) ;
} ;
