-- CDOpYon.seg (L8, Delta): El along a Yoneda code, for operations (the
-- analogue of lem:el-yon for the classifier isFib): El's horn filling
-- operation pulled back along the Yoneda cart of F (CYonCart) is F's own.
-- At a point rho, El's operation at the code F rho is F's at rho id
-- (CDElHorn, the code's operation, and uAct = substitution); rho id = rho,
-- and the data have the same values (the Yoneda transports, V a set).
--
-- Quarry: seg/model DTautYon.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DCl = CDeltaCl[a] ;
module CL = DCl.CL ;
module DU = DCl.DU ;
module YO = DB.GYon[a] ;
module EH = CDElHorn[a] ;

module OY (Z : Nat) (F : DU.U0 Z) {
  module YG = DB.CYonCart.YC[CL.Cl, CL.clSub, CL.clSub-id, CL.clSub-o, CL.encCl] ;
  module Y = YG.Yc[Z, F] ;
  module TF = DB.GPre[a].TyL[YO.yP Z, F.1] ;
  module TE = DB.GPre[a+].TyL[DU.UCtx, DU.EGen] ;
  module FF = DB.COp[a].OpS[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, YO.yP Z, F.1] ;

  cf (W : Nat) (k : Hom (lin W) (lin Z)) (b : W0.Ix (F.1.tob W k)) : W0.Ix (DU.fib0 W (Y.s W k)) = (Y.ta W (k, b)).2 ;
  cb (W : Nat) (k : Hom (lin W) (lin Z)) (u : W0.Ix (DU.fib0 W (Y.s W k))) : W0.Ix (F.1.tob W k) = Y.bk W k u ;

  module P = DB.COpMove[a, a+].Pull[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, YO.yP Z, F.1, DU.UCtx, DU.EGen, Y.s, Y.s-nat, cf, cb,
    \ W k b -> YG.sV-round (DU.fib0 W (Y.s W k)) (F.1.tob W k) (Y.Po W k) b,
    \ W k u -> YG.sV-round' (DU.fib0 W (Y.s W k)) (F.1.tob W k) (Y.Po W k) u,
    Y.tanat, \ i o F' h' -> EH.elFib i.1 i.2 o F' h'] ;

  -- pairs of F.1 over a path of points, through any path of fibres
  pairVF (W : Nat) (p p' : Hom (lin W) (lin Z)) (Pp : Id (Hom (lin W) (lin Z)) p p') (b : W0.Ix (F.1.tob W p)) (b' : W0.Ix (F.1.tob W p'))
    (c : Id W0.V (F.1.tob W p) (F.1.tob W p')) (H : Id (W0.Ix (F.1.tob W p')) (DB.CExtEq1.sV (F.1.tob W p) (F.1.tob W p') c b) b')
    : Id (TF.EI W) (p, b) (p', b') =
    idJ (Hom (lin W) (lin Z)) p
      (\ p2 P2 -> (b2 : W0.Ix (F.1.tob W p2)) (c2 : Id W0.V (F.1.tob W p) (F.1.tob W p2))
         -> Id (W0.Ix (F.1.tob W p2)) (DB.CExtEq1.sV (F.1.tob W p) (F.1.tob W p2) c2 b) b2 -> Id (TF.EI W) (p, b) (p2, b2))
      (\ b2 c2 H2 -> apH {W0.Ix (F.1.tob W p)} {TF.EI W} (\ z -> (p, z)) (transH (symH (DU.loopV (F.1.tob W p) c2 b)) H2))
      p' Pp b' c H ;

  -- the data read at the identity of the code F rho, then along rho
  module At (i : DCl.HIx) (o : DCl.hOk i) (rho : Hom (lin (DCl.hOb i)) (lin Z)) (h : FF.HData i rho) {
    n : Nat = DCl.hOb i ;
    F' : DU.U0 n = Y.s n rho ;
    module HE = EH.HE[i.1, F'] ;
    module E = HE.E ;
    hE : HE.HEl.HornData i.1 i.2 F' = P.mv i rho h ;
    module SP = CL.P[YO.yP n, YO.yP Z, YO.yH n Z rho, F.1, F.2] ;
    hF : FF.HData i ((YO.yH n Z rho).nt n (idH (lin n))) = SP.Pl.mv i (idH (lin n)) (HE.hA i.2 hE) ;

    -- the values agree
    vals (W : Nat) (f : Hom (lin W) (lin n)) (q : DBm.DS.Lands W n (DCl.hS i) f) : Id (TF.EI W) (hF.1 W f q) (h.1 W f q) =
      transH (apH (SP.SE.mV W) (E.toA-E W f (hE.1 W f q) (hE.2.1 W f q)))
        (pairVF W ((YO.yH n Z rho).nt W ((YO.yH W n f).nt W (idH (lin W)))) (h.1 W f q).1
           (transH (apH (compH (lin W) (lin n) (lin Z) rho) (comp-idr (lin W) (lin n) f)) (symH (h.2.1 W f q)))
           (E.zE W f (hE.1 W f q) (hE.2.1 W f q)).2 (h.1 W f q).2
           (apH (F.1.tob W) (transH (apH (compH (lin W) (lin n) (lin Z) rho) (comp-idr (lin W) (lin n) f)) (symH (h.2.1 W f q))))
           (transH (apH (DB.CExtEq1.sV (F.1.tob W ((YO.yH n Z rho).nt W ((YO.yH W n f).nt W (idH (lin W))))) (F.1.tob W (h.1 W f q).1)
                          (apH (F.1.tob W) (transH (apH (compH (lin W) (lin n) (lin Z) rho) (comp-idr (lin W) (lin n) f)) (symH (h.2.1 W f q)))))
                      (DU.substF W (Y.s W (h.1 W f q).1) (DU.uAct W n f F') (hE.2.1 W f q) (Y.ta W (h.1 W f q)).2))
             (transH (apH (DB.CExtEq1.sV (F.1.tob W ((YO.yH n Z rho).nt W ((YO.yH W n f).nt W (idH (lin W))))) (F.1.tob W (h.1 W f q).1)
                            (apH (F.1.tob W) (transH (apH (compH (lin W) (lin n) (lin Z) rho) (comp-idr (lin W) (lin n) f)) (symH (h.2.1 W f q)))))
                        (DB.CExtEq1.sV-comp (F.1.tob W (h.1 W f q).1) (DU.fib0 W (Y.s W (h.1 W f q).1)) (DU.fib0 W (DU.uAct W n f F'))
                           (symH (Y.Po W (h.1 W f q).1)) (apH (DU.fib0 W) (hE.2.1 W f q)) (h.1 W f q).2))
               (transH (DB.CExtEq1.sV-comp (F.1.tob W (h.1 W f q).1) (DU.fib0 W (DU.uAct W n f F')) (F.1.tob W (h.1 W f q).1)
                          (transH (symH (Y.Po W (h.1 W f q).1)) (apH (DU.fib0 W) (hE.2.1 W f q)))
                          (apH (F.1.tob W) (transH (apH (compH (lin W) (lin n) (lin Z) rho) (comp-idr (lin W) (lin n) f)) (symH (h.2.1 W f q))))
                          (h.1 W f q).2)
                       (DU.loopV (F.1.tob W (h.1 W f q).1)
                          (transH (transH (symH (Y.Po W (h.1 W f q).1)) (apH (DU.fib0 W) (hE.2.1 W f q)))
                                  (apH (F.1.tob W) (transH (apH (compH (lin W) (lin n) (lin Z) rho) (comp-idr (lin W) (lin n) f)) (symH (h.2.1 W f q)))))
                          (h.1 W f q).2))))) ;

    tot : Id (TF.EI n) ((YO.yH n Z rho).nt n (idH (lin n)), (F.2 i o ((YO.yH n Z rho).nt n (idH (lin n))) hF).1) (rho, (F.2 i o rho h).1) =
      DB.COpLaws[a, a, a].OL[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS].At[YO.yP Z, F.1, F.2].opAt i o
        ((YO.yH n Z rho).nt n (idH (lin n))) rho (comp-idr (lin n) (lin Z) rho) hF h vals ;

    fill : Id (W0.Ix (F.1.tob n rho)) (P.op i o rho h).1 (F.2 i o rho h).1 =
      transH (symH (subst-ap (Hom (lin n) (lin Z)) W0.V (F.1.tob n) (\ z -> W0.Ix z) ((YO.yH n Z rho).nt n (idH (lin n))) rho
                      (comp-idr (lin n) (lin Z) rho) (F.2 i o ((YO.yH n Z rho).nt n (idH (lin n))) hF).1))
             (TF.pr-eq n ((YO.yH n Z rho).nt n (idH (lin n))) rho (comp-idr (lin n) (lin Z) rho)
                (F.2 i o ((YO.yH n Z rho).nt n (idH (lin n))) hF).1 (F.2 i o rho h).1 tot) ;
  } ;

  law : Id (FF.Op) P.op F.2 = FF.op-ext P.op F.2 (\ i o rho h -> At[i, o, rho, h].fill) ;
} ;
