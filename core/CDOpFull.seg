-- CDOpFull.seg (L8, Delta): the universal horn operation at full points
-- (model.tex lem:full-move (iii), for operations): pulled back along
-- B -> Ext_U (fromB, on the full points) it is B's operation hB.  By the
-- case split (CDGlueCl.clExt-full) the filler is fromB of hB's filler on
-- the data read in B, and reading fromB-data in B gives the data back.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DCl = CDeltaCl[a] ;
module DU = DCl.DU ;

module OF (elFib : DB.CLine[a+].Lines[DU.UCtx, DU.EGen].Fib) {
  module SC = CDSmallCl[a].SC[elFib] ;
  module UB = SC.UB ;
  module X3 = DB.CExt3[a+].ExtB3[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU] ;
  module FC = DB.CExtFullCart[a+].FC[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU, SC.XS.FU.T7.fA1, SC.XS.FU.E2.eqU] ;
  RES : DB.GPre[a+].PS.PCtx = UB.CU.resCtx ;
  module TB = DB.GPre[a+].TyL[RES, UB.BU] ;
  module TXB = DB.GPre[a+].TyL[UB.GDr, UB.ExtBig] ;
  module FB = DB.COp[a+].OpS[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, RES, UB.BU] ;

  cf (W : Nat) (x : V1.Ix (RES.ob W)) (b : V1.Ix (UB.BU.tob W x)) : V1.Ix (UB.ExtBig.tob W x.1) = (X3.fromB W (x, b)).2 ;

  cbf (W : Nat) (x : V1.Ix (RES.ob W)) (b : V1.Ix (UB.BU.tob W x)) : Id (V1.Ix (UB.BU.tob W x)) (FC.bkB W x (cf W x b)) b =
    TB.pr-inj W x (FC.bkB W x (cf W x b)) b
      (transH (X3.toB-cong W (X3.fromB W (x, b)) (X3.fromB W (x, b)) (refl (X3.fromB W (x, b))) x.2 x.2) (X3.toB-fromB W (x, b))) ;

  cfb (W : Nat) (x : V1.Ix (RES.ob W)) (u : V1.Ix (UB.ExtBig.tob W x.1)) : Id (V1.Ix (UB.ExtBig.tob W x.1)) (cf W x (FC.bkB W x u)) u =
    TXB.pr-inj W x.1 (cf W x (FC.bkB W x u)) u (FC.cbkBta W x u) ;

  module P = DB.COpMove[a+, a+].Pull[DCl.HIx, DCl.hOk, DCl.hOb, DCl.hS, RES, UB.BU, UB.GDr, UB.ExtBig,
    FC.cs, FC.cs-nat, cf, FC.bkB, cbf, cfb, FC.ctBnat, SC.hBig] ;

  module At (i : DCl.HIx) (o : DCl.hOk i) (x : V1.Ix (RES.ob (DCl.hOb i))) (h : FB.HData i x) {
    module Fu = SC.GC.Full[i.1, i.2, o, x.1, x.2, P.mv i x h] ;

    hdEq : Id (FB.HData i x) Fu.hd h =
      FB.hd-eq i x Fu.hd h
        (funext Nat (\ W -> (f : Hom (lin W) (lin (DCl.hOb i))) -> DBm.DS.Lands W (DCl.hOb i) (DCl.hS i) f -> TB.EI W) Fu.hd.1 h.1 (\ W ->
          funext (Hom (lin W) (lin (DCl.hOb i))) (\ f -> DBm.DS.Lands W (DCl.hOb i) (DCl.hS i) f -> TB.EI W) (Fu.hd.1 W) (h.1 W) (\ f ->
            funext (DBm.DS.Lands W (DCl.hOb i) (DCl.hS i) f) (\ q -> TB.EI W) (Fu.hd.1 W f) (h.1 W f) (\ q ->
              transH (X3.toB-cong W (X3.fromB W (h.1 W f q)) (X3.fromB W (h.1 W f q)) (refl (X3.fromB W (h.1 W f q))) (Fu.pW W f q) (h.1 W f q).1.2)
                     (X3.toB-fromB W (h.1 W f q)))))) ;

    s1 : Id (TXB.EI (DCl.hOb i)) (X3.fromB (DCl.hOb i) (x, (P.op i o x h).1)) (x.1, (SC.hBig i o x.1 (P.mv i x h)).1) = X3.fromB-toB (DCl.hOb i) (x.1, (SC.hBig i o x.1 (P.mv i x h)).1) x.2 ;
    s2 : Id (TXB.EI (DCl.hOb i)) (x.1, (SC.hBig i o x.1 (P.mv i x h)).1) (x.1, Fu.res.1) =
      apH {SC.GC.HX.Ext i.1 i.2 x.1 (P.mv i x h)} {TXB.EI (DCl.hOb i)} (\ z -> (x.1, z.1)) {SC.GC.clExt i.1 i.2 o x.1 (P.mv i x h)} {Fu.res}
        (SC.GC.clExt-full i.1 i.2 o x.1 x.2 (P.mv i x h)) ;
    s3 : Id (TXB.EI (DCl.hOb i)) (x.1, Fu.res.1) (X3.fromB (DCl.hOb i) ((x.1, x.2), Fu.r.1)) = Fu.res-E ;
    s4 : Id (TXB.EI (DCl.hOb i)) (X3.fromB (DCl.hOb i) ((x.1, x.2), Fu.r.1)) (X3.fromB (DCl.hOb i) (x, (SC.hB i.1 i.2 o x h).1)) =
      apH {FB.HData i x} {TXB.EI (DCl.hOb i)} (\ hd -> X3.fromB (DCl.hOb i) (x, (SC.hB i.1 i.2 o x hd).1)) {Fu.hd} {h} hdEq ;

    tot : Id (TXB.EI (DCl.hOb i)) (X3.fromB (DCl.hOb i) (x, (P.op i o x h).1)) (X3.fromB (DCl.hOb i) (x, (SC.hB i.1 i.2 o x h).1)) =
      transH s1 (transH s2 (transH s3 s4)) ;

    fill : Id (V1.Ix (UB.BU.tob (DCl.hOb i) x)) (P.op i o x h).1 (SC.hB i.1 i.2 o x h).1 =
      TB.pr-inj (DCl.hOb i) x (P.op i o x h).1 (SC.hB i.1 i.2 o x h).1
        (X3.fromB-inj (DCl.hOb i) (x, (P.op i o x h).1) (x, (SC.hB i.1 i.2 o x h).1) tot) ;
  } ;

  law : Id (FB.Op) P.op (\ i o x h -> SC.hB i.1 i.2 o x h) =
    FB.op-ext P.op (\ i o x h -> SC.hB i.1 i.2 o x h) (\ i o x h -> At[i, o, x, h].fill) ;
} ;

