-- Compare the stages of CDNormD in either direction, and take the ends.
open CDHornPrism ;
open CDCapBase[a] ;
open CDHornDirection[a] ;
module TD = CDHornTotalData[a, k] ;
module TG = CDHornTotalData[a, l] ;

module Normal (hD : DH'.isFib) (hG : DH.isFib) (hl : HornLaw hD hG) {
  module T0 = TD.Totals[D, A', hD] ;
  module T1 = TG.Totals[G, A, hG] ;

  module AtLine (N : Nat) (x : WD.Ix (C.FD.ob N)) {
    y : WG.Ix (C.FG.ob N) = C.sI N x ;
    module T' = T0.AtLine[N, x] ;
    module T = T1.AtLine[N, y] ;
    module P = Prism[hD, hG, hl, N, x, y, \ W f j -> refl (s W (x.1 W f j))] ;

    total : (d : Bool) (L' : T'.P.PLine[S0 N (end-number d)]) (L : T.P.PLine[S0 N (end-number d)])
      -> P.Related (S0 N (end-number d)) L' L
      -> (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      -> Id (TA.EI W) (ta W ((T'.total d L').v W f j)) ((T.total d L).v W f j) = split {
      true -> \ L' L r -> P.FT[L', L, r].total ;
      false -> \ L' L r -> P.FF[L', L, r].total } ;
  } ;

  module Direction (d : Bool) {
    e : El Iv = DB.src d ;
    eN : Nat = end-number d ;
    eE : Id Tree e.1 (leaf eN) = end-leaf d ;
    module B = At[e] ;
    open B ;
    open B.CDHornProb ;
    module Boundary = B.CDHornBoundary.Boundary[eN, eE] ;

    module D' = CDNormE[a, k].NE[D, A', e, eN, eE,
      \ N x xn L -> (T0.AtLine[N, (x, xn)].total d L).v,
      \ N x xn L -> (T0.AtLine[N, (x, xn)].total d L).pt,
      \ N x xn L -> (T0.AtLine[N, (x, xn)].total d L).nat,
      \ N x xn L -> (T0.AtLine[N, (x, xn)].total d L).side,
      HD.deg] ;
    module G' = CDNormE[a, l].NE[G, A, e, eN, eE,
      \ N x xn L -> (T1.AtLine[N, (x, xn)].total d L).v,
      \ N x xn L -> (T1.AtLine[N, (x, xn)].total d L).pt,
      \ N x xn L -> (T1.AtLine[N, (x, xn)].total d L).nat,
      \ N x xn L -> (T1.AtLine[N, (x, xn)].total d L).side,
      HG.deg] ;

    import CDHornStage ;

    import CDHornInduction ;

    module Result = End[DB.tgt d, D'.fibAt, G'.fibAt] ;
    law : Id (Result.M.CK'.Comp) Result.cD (Result.M.move Result.cG) =
      Result.law CDHornInduction.related ;
  } ;

  module Forward = Direction[true] ;
  module Backward = Direction[false] ;

  Fib : U k+ = DB.CLine[k].Lines[D, A'].Fib ;

  nat : Id Fib (CDeltaHornToFib[a, k].hornToFib D A' hD)
         (C.moveFib (CDeltaHornToFib[a, l].hornToFib G A hG)) =
    transH
      (apH {Forward.Result.M.CK'.Comp} {Fib} (\ z -> (z, Backward.Result.cD)) Forward.law)
      (apH {Backward.Result.M.CK'.Comp} {Fib} (\ z -> (Forward.Result.M.move Forward.Result.cG, z)) Backward.law) ;

  opaque nat ;
} ;
