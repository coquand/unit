-- CLocDNUniv.seg (L9): the fibration of D_N on the universal family, and
-- its naturality (postnikov.tex, Corollary fib; as CLocDUniv for D).
--
--   DNElFib       D_N El over the universe is fibrant (CLocDN.DN)
--   DF[N, D, c]   for a code map c : D -> U, the fibration of D_N(El along c):
--                 that of D_N El moved along the cart
--                 D (K_N (c^* El)) -> D (K_N El) over c, D (CLocDCart) of the
--                 cart K_N (c^* El) -> K_N El (CCoskCart) of CSmall.SmallFib.C
--   Nat           for t : D' -> D, DF at c t is DF at c moved along the cart
--                 over t; the carts compose (CCartLaws2.CC, CG)

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module E4 = CPosEl4[a] ;
module PB = E1.PB ;
module UU = E1.UU ;
module PP = PB.GPre[a].PS ;

module AtN (N : Nat) {
  module KU = CCosk[a, a+].KT[UU.UCtx, UU.EGen, N] ;
  module DU = CLocD[a, a+].DT[UU.UCtx, KU.KA] ;

  DNElFib : PB.CLine[a+].Lines[UU.UCtx, DU.DA].Fib = CLocDN[a, a+].DN[UU.UCtx, UU.EGen, N, E4.elFib].fib ;

  module DF (D : PP.PCtx) (c : PB.CSmall.XSub[D, UU.UCtx]) {
    module X = PB.CSmall.SmallFib[UU.UCtx, UU.El, D, c] ;
    module KC = CCoskCart[a, a+, a].KK[N, D, X.ElTy, UU.UCtx, UU.EGen, c.nt, c.nt-nat, X.ta, \ W w -> refl (c.nt W w.1), X.tanat, X.tainj,
      \ Y x u -> u, \ Y x u -> refl (c.nt Y x, u)] ;
    module K = CLocDCart[a, a+, a].DK[D, KC.KD.KA, UU.UCtx, KU.KA, c.nt, c.nt-nat, KC.tK, KC.tKpt, KC.tKnat, KC.tKinj, KC.bkK, KC.bkKta] ;
    module DA = CLocD[a, a].DT[D, KC.KD.KA] ;

    fib : PB.CLine[a].Lines[D, DA.DA].Fib = K.C.moveFib DNElFib ;
  } ;

  ----------------------------------------------------------------------
  -- naturality

  module Nat (D' D : PP.PCtx) (t : PP.PSub[D', D]) (c : PB.CSmall.XSub[D, UU.UCtx]) {
    c' : PB.CSmall.XSub[D', UU.UCtx] = PB.CSmall.xoS D' D UU.UCtx c t ;
    module F = DF[D, c] ;
    module F' = DF[D', c'] ;
    module TX = PB.GPre[a].TyL[D, F.X.ElTy] ;
    module TX' = PB.GPre[a].TyL[D', F'.X.ElTy] ;

    -- the cart El along c t -> El along c over t
    tt (W : Ob) (w : TX'.EI W) : TX.EI W = (t.nt W w.1, w.2) ;

    ttnat (V W : Ob) (g : Hom V W) (w : TX'.EI W) : Id (TX.EI V) (TX.E.act V W g (tt W w)) (tt V (TX'.E.act V W g w)) =
      F.X.tainj V (TX.E.act V W g (tt W w)) (tt V (TX'.E.act V W g w)) (symH (t.nt-nat V W g w.1))
        (transH (symH (F.X.tanat V W g (tt W w))) (F'.X.tanat V W g w)) ;

    ttinj (W : Ob) (v v' : TX'.EI W) (P : Id (W0.Ix (D'.ob W)) v.1 v'.1) (Q : Id (TX.EI W) (tt W v) (tt W v')) : Id (TX'.EI W) v v' =
      F'.X.tainj W v v' P (apH (F.X.ta W) Q) ;

    opaque ttnat ; opaque ttinj ;

    module KT = CCoskCart[a, a, a].KK[N, D', F'.X.ElTy, D, F.X.ElTy, t.nt, t.nt-nat, tt, \ W w -> refl (t.nt W w.1), ttnat, ttinj,
      \ Y x u -> u, \ Y x u -> refl (t.nt Y x, u)] ;
    module DT = CLocDCart[a, a, a].DK[D', F'.KC.KD.KA, D, F.KC.KD.KA, t.nt, t.nt-nat, KT.tK, KT.tKpt, KT.tKnat, KT.tKinj, KT.bkK, KT.bkKta] ;

    -- moving along DT then along F.K is moving along the composite
    module CC = PB.CCartLaws2[a, a, a+].CC[D', F'.DA.DA, D, F.DA.DA, UU.UCtx, DU.DA,
      t.nt, t.nt-nat, DT.tD, DT.tDpt, DT.tDnat, DT.tDinj, DT.bkD, DT.bkDta,
      c.nt, c.nt-nat, F.K.tD, F.K.tDpt, F.K.tDnat, F.K.tDinj, F.K.bkD, F.K.bkDta] ;

    -- on the coskeleta, the composite of the carts is the cart of c t
    PtaK (W : Ob) (v : PB.GPre[a].TyL[D', F'.KC.KD.KA].EI W)
      : Id (PB.GPre[a+].TyL[UU.UCtx, KU.KA].EI W) (F.KC.tK W (KT.tK W v)) (F'.KC.tK W v) =
      KU.EKext W (F.KC.tK W (KT.tK W v)) (F'.KC.tK W v) (refl (c.nt W (t.nt W v.1)))
        (\ n hn f -> transH (F.KC.tK-rd W (KT.tK W v) n hn f)
           (transH (apH (F.X.ta (lin n)) (KT.tK-rd W v n hn f)) (symH (F'.KC.tK-rd W v n hn f)))) ;

    -- the composite has the totals of F'.K
    Pta (W : Ob) (v : PB.GPre[a].TyL[D', F'.DA.DA].EI W) : Id (PB.GPre[a+].TyL[UU.UCtx, DU.DA].EI W) (CC.ta W v) (F'.K.tD W v) =
      F'.K.extG W (CC.ta W v) (F'.K.tD W v) (refl (c.nt W (t.nt W v.1)))
        (\ n f -> transH (F.K.tD-rd W (DT.tD W v) n f)
           (transH (apH (F.KC.tK (lin n)) (DT.tD-rd W v n f))
             (transH (PtaK (lin n) (F'.DA.rd W v.1 v.2.1 n f)) (symH (F'.K.tD-rd W v n f))))) ;

    opaque PtaK ; opaque Pta ;

    module CG = PB.CCartLaws2[a, a, a+].CG[D', F'.DA.DA, UU.UCtx, DU.DA,
      CC.s, CC.s-nat, CC.ta, CC.tapt, CC.tanat, CC.tainj, CC.bk, CC.bkta,
      c'.nt, c'.nt-nat, F'.K.tD, F'.K.tDpt, F'.K.tDnat, F'.K.tDinj, F'.K.bkD, F'.K.bkDta,
      \ W x -> refl (c.nt W (t.nt W x)), Pta] ;

    nat : Id (PB.CLine[a].Lines[D', F'.DA.DA].Fib) (DT.C.moveFib F.fib) F'.fib =
      transH (CC.compFib DNElFib) (CG.congFib DNElFib) ;
  } ;
} ;
