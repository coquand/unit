-- Naturality of universe terms and decoding.
module Sub (D G : PCtx) (a0 : O.El G (universe G)) (s : PSub[D, G]) {
  pre : C.C.Ty D = C.C.subT D G (universe G) s ;
  term : O.El D pre = O.subt D G (universe G) a0 s ;
  code-sub : O.El D (universe D) = subst (C.C.Ty D) (\ T -> O.El D T) pre (universe D) (univ-nat D G s) term ;

  values : Id (elObs D (C.decode D (universe D)).tob) code-sub.eob term.eob =
    transH (apH (\ t -> t.eob)
      (subst-ap (C.C.Ty D) (PTy[D]) (C.decode D) (\ T -> PEl[D, T]) pre (universe D) (univ-nat D G s) term))
      (tob-same D (\ T -> PEl[D, T]) (\ o -> elObs D o) (\ T t -> t.eob) (C.decode D pre) (C.decode D (universe D))
        (apH (C.decode D) (univ-nat D G s)) (refl (C.decode D (universe D)).tob) term) ;

  points (I : Nat) (x : W.Ix (D.ob I)) : Id (U0.U0 I) ((Read[D].code code-sub).nt I x) ((Read[G].code a0).nt I (s.nt I x)) =
    transH (Read[D].code-point code-sub I x)
      (transH (apH (\ t -> t I x) values) (symH (Read[G].code-point a0 I (s.nt I x)))) ;

  law : Id (C.C.Ty D) (C.C.subT D G (decode G a0) s) (decode D code-sub) =
    C.C.ty-ext D _ _ (\ I x -> apH (X.inc I) (symH (points I x))) ;

  opaque law ;
} ;
