-- CEnc.seg (L4, inside CB): codes one level up (Encode[a, a+]) for the
-- data of the universal glue data: a sieve by its characteristic map
-- (encPhi), a side by its sieve and values (encSide), a map of types by
-- its action on totals (encPMap), a relative contractibility structure by
-- its extensions (encRC), an equivalence structure (encEq).
--
-- Quarry: seg/model GUnivL (encPhi, EncP), GUnivEq (encPMap, encContr).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open Encode[a, a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;

encOb : Enc Ob = encIx0 obV ;

encHom (Y X : Ob) : Enc (Hom Y X) = encIx0 (homV Y X) ;

encBool : Enc Bool = encIx0 W0.boolV ;

------------------------------------------------------------------------
-- a sieve is determined by its characteristic map

chiS (X : Ob) (Q : Phi X) (W : Ob) (f : Hom W X) : Bool = allS W (pre W X f Q) ;

landsChi (W X : Ob) (Q : Phi X) (f : Hom W X) (i : Lands W X Q f) : Id Bool (chiS X Q W f) true =
  allS-complete W (pre W X f Q)
    (pre-lands W W X f Q (idH W) (lands-eq W X Q f (compH W W X f (idH W)) (symH (comp-idr W X f)) i)) ;

chiLands (W X : Ob) (Q : Phi X) (f : Hom W X) (h : Id Bool (chiS X Q W f) true) : Lands W X Q f =
  lands-eq W X Q (compH W W X f (idH W)) f (comp-idr W X f) (lands-pre W W X f Q (idH W) (allS-sound W (pre W X f Q) h)) ;

chiS-inj (X : Ob) (Q Q' : Phi X) (P : Id ((W : Ob) -> Hom W X -> Bool) (chiS X Q) (chiS X Q')) : Id (Phi X) Q Q' =
  phi-ext X Q Q' (\ W f i -> chiLands W X Q' f (transH (symH (apH (\ k -> k W f) P)) (landsChi W X Q f i)))
                 (\ W f i -> chiLands W X Q f (transH (apH (\ k -> k W f) P) (landsChi W X Q' f i))) ;

encPhi (X : Ob) : Enc (Phi X) =
  encInj (Phi X) ((W : Ob) -> Hom W X -> Bool) (chiS X) (\ Q Q' P -> chiS-inj X Q Q' P)
    (encPi0 Ob (\ W -> Hom W X -> Bool) encOb (\ W -> encPi0 (Hom W X) (\ f -> Bool) (encHom W X) (\ f -> encBool))) ;

------------------------------------------------------------------------
-- sides are determined by their sieve and values

module EncP (D : PCtx) (C : PTy[D]) {
  module PP = CPartial[a].Partials[D, C] ;
  module TC = GPR.TyL[D, C] ;

  encPv (X : Ob) (q : Phi X) : Enc (PP.PvTy X q) =
    encPi0 Ob (\ W -> (f : Hom W X) -> Lands W X q f -> TC.EI W) encOb (\ W ->
    encPi0 (Hom W X) (\ f -> Lands W X q f -> TC.EI W) (encHom W X) (\ f ->
    encPi0 (Lands W X q f) (\ i -> TC.EI W) (encProp (Lands W X q f) (isProp-Lands W X q f)) (\ i ->
      encIx0 (TC.E.ob W)))) ;

  SideD (X : Ob) : U a = (q : Phi X) * PP.PvTy X q ;

  sideD (X : Ob) (x : TC.Pt X) (s : PP.Side[X, x]) : SideD X = (s.pQ, s.pv) ;

  sideInj (X : Ob) (x : TC.Pt X) (s s' : PP.Side[X, x]) (P : Id (SideD X) (sideD X x s) (sideD X x s'))
    : Id (PP.Side[X, x]) s s' =
    transH
    (idJ (SideD X) (s.pQ, s.pv)
      (\ w Q -> (pp : PP.PptTy X x w.1 w.2) (pn : PP.PnTy X w.1 w.2) -> Id (PP.Side[X, x]) s ((PP.mkSide X x w.1 w.2 pp pn)))
      (\ pp pn -> PP.side-ext X x s ((PP.mkSide X x s.pQ s.pv pp pn)) (refl s.pQ) (\ W f i i' -> PP.pv-irr X x s W f i i'))
      (s'.pQ, s'.pv) P s'.ppt s'.pnat)
    (symH (PP.side-eta X x s')) ;

  encSide (X : Ob) (x : TC.Pt X) : Enc (PP.Side[X, x]) =
    encInj (PP.Side[X, x]) (SideD X) (sideD X x) (sideInj X x) (encSig (Phi X) (\ q -> PP.PvTy X q) (encPhi X) (encPv X)) ;
} ;

------------------------------------------------------------------------
-- maps of types, and relative contractibility structures

METy (G : PCtx) (B A : PTy[G]) : U a = (X : Ob) -> GPR.TyL[G, B].EI X -> GPR.TyL[G, A].EI X ;

MptTy (G : PCtx) (B A : PTy[G]) (m : METy G B A) : U a =
  (X : Ob) (w : GPR.TyL[G, B].EI X) -> Id (W0.Ix (G.ob X)) (m X w).1 w.1 ;

MnatTy (G : PCtx) (B A : PTy[G]) (m : METy G B A) : U a =
  (Y X : Ob) (h : Hom Y X) (w : GPR.TyL[G, B].EI X)
  -> Id (GPR.TyL[G, A].EI Y) (m Y (GPR.TyL[G, B].E.act Y X h w)) (GPR.TyL[G, A].E.act Y X h (m X w)) ;

isProp-Mpt (G : PCtx) (B A : PTy[G]) (m : METy G B A) : isProp (MptTy G B A m) =
  isProp-Pi Ob (\ X -> (w : GPR.TyL[G, B].EI X) -> Id (W0.Ix (G.ob X)) (m X w).1 w.1) (\ X ->
  isProp-Pi (GPR.TyL[G, B].EI X) (\ w -> Id (W0.Ix (G.ob X)) (m X w).1 w.1) (\ w ->
  W0.isSetIx (G.ob X) (m X w).1 w.1)) ;

isProp-Mnat (G : PCtx) (B A : PTy[G]) (m : METy G B A) : isProp (MnatTy G B A m) =
  isProp-Pi Ob (\ Y -> (X : Ob) (h : Hom Y X) (w : GPR.TyL[G, B].EI X)
                 -> Id (GPR.TyL[G, A].EI Y) (m Y (GPR.TyL[G, B].E.act Y X h w)) (GPR.TyL[G, A].E.act Y X h (m X w))) (\ Y ->
  isProp-Pi Ob (\ X -> (h : Hom Y X) (w : GPR.TyL[G, B].EI X)
                 -> Id (GPR.TyL[G, A].EI Y) (m Y (GPR.TyL[G, B].E.act Y X h w)) (GPR.TyL[G, A].E.act Y X h (m X w))) (\ X ->
  isProp-Pi (Hom Y X) (\ h -> (w : GPR.TyL[G, B].EI X)
                 -> Id (GPR.TyL[G, A].EI Y) (m Y (GPR.TyL[G, B].E.act Y X h w)) (GPR.TyL[G, A].E.act Y X h (m X w))) (\ h ->
  isProp-Pi (GPR.TyL[G, B].EI X) (\ w -> Id (GPR.TyL[G, A].EI Y) (m Y (GPR.TyL[G, B].E.act Y X h w)) (GPR.TyL[G, A].E.act Y X h (m X w))) (\ w ->
  W0.isSetIx ((extP G A).ob Y) (m Y (GPR.TyL[G, B].E.act Y X h w)) (GPR.TyL[G, A].E.act Y X h (m X w)))))) ;

pmap-ext (G : PCtx) (B A : PTy[G]) (al al2 : CPartial[a].PMap[G, B, A])
  (q : (X : Ob) (w : GPR.TyL[G, B].EI X) -> Id (GPR.TyL[G, A].EI X) (al.mE X w) (al2.mE X w))
  : Id (CPartial[a].PMap[G, B, A]) al al2 =
  transH (CPartial[a].pmap-eta G B A al) (transH
  (idJ (METy G B A) al.mE
    (\ m2 P2 -> (mp2 : MptTy G B A m2) (mn2 : MnatTy G B A m2)
       -> Id (CPartial[a].PMap[G, B, A]) (CPartial[a].mkPMap G B A al.mE al.mpt al.mnat) ((CPartial[a].mkPMap G B A m2 mp2 mn2)))
    (\ mp2 mn2 ->
       transH (apH {MptTy G B A al.mE} {CPartial[a].PMap[G, B, A]} (\ z -> (CPartial[a].mkPMap G B A al.mE z al.mnat))
                 (isProp-Mpt G B A al.mE al.mpt mp2))
              (apH {MnatTy G B A al.mE} {CPartial[a].PMap[G, B, A]} (\ z -> (CPartial[a].mkPMap G B A al.mE mp2 z))
                 (isProp-Mnat G B A al.mE al.mnat mn2)))
    al2.mE (funext Ob (\ X -> GPR.TyL[G, B].EI X -> GPR.TyL[G, A].EI X) al.mE al2.mE (\ X ->
              funext (GPR.TyL[G, B].EI X) (\ w -> GPR.TyL[G, A].EI X) (al.mE X) (al2.mE X) (\ w -> q X w)))
    al2.mpt al2.mnat)
  (symH (CPartial[a].pmap-eta G B A al2))) ;

opaque pmap-ext ;

encPMap (G : PCtx) (B A : PTy[G]) : Enc (CPartial[a].PMap[G, B, A]) =
  encInj (CPartial[a].PMap[G, B, A]) (METy G B A) (\ al -> al.mE)
    (\ al al2 P -> pmap-ext G B A al al2 (\ X w -> apH (\ m -> m X w) P))
    (encPi0 Ob (\ X -> GPR.TyL[G, B].EI X -> GPR.TyL[G, A].EI X) encOb (\ X ->
       encPi0 (GPR.TyL[G, B].EI X) (\ w -> GPR.TyL[G, A].EI X) (encIx0 ((extP G B).ob X)) (\ w -> encIx0 ((extP G A).ob X)))) ;

encRC (D : PCtx) (S T : PTy[D]) (m : CPartial[a].PMap[D, S, T]) : Enc (CPartial[a].Rel[D, S, T, m].RC) =
  encInj (CPartial[a].Rel[D, S, T, m].RC) (CPartial[a].Rel[D, S, T, m].KopTy) (\ k -> k.kop)
    (\ k k' Q -> CPartial[a].Rel[D, S, T, m].rc-ext k k' (\ X x s -> apH (\ kk -> kk X x s) Q))
    (encPi0 Ob (\ X -> (x : W0.Ix (D.ob X)) (s : CPartial[a].Partials[D, S].Side[X, x]) -> W0.Ix (T.tob X x)) encOb (\ X ->
     encPi0 (W0.Ix (D.ob X)) (\ x -> (s : CPartial[a].Partials[D, S].Side[X, x]) -> W0.Ix (T.tob X x)) (encIx0 (D.ob X)) (\ x ->
     encPi0 (CPartial[a].Partials[D, S].Side[X, x]) (\ s -> W0.Ix (T.tob X x)) (EncP[D, S].encSide X x) (\ s -> encIx0 (T.tob X x))))) ;

encEq (G : PCtx) (B A : PTy[G]) (al : CPartial[a].PMap[G, B, A]) : Enc (CEquiv[a].EquivOp G B A al) =
  encRC (extP G A) CEquiv[a].HFib[G, B, A, al].FibT CEquiv[a].HFib[G, B, A, al].FibT
    (CPartial[a].pmap-id (extP G A) CEquiv[a].HFib[G, B, A, al].FibT) ;

opaque encPMap ; opaque encRC ; opaque encEq ;
