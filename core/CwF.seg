-- CwF.seg: MODEL/CwF.agda.  Categories with families in Ehrhard's
-- presentation (cwf2.pdf): substitutions generated by id, p, s o s',
-- lift s, sec a.  Then the type formers, each natural in the substitution.
--
-- Agda's  record CwF  is a SEGMENT used as a type (Arend's record): its
-- fields are the parameters, and its derived members (p-lift-T, p-sec-T,
-- extS) sit between the fields, as in Agda, and are used in the types of
-- later fields.  An element C : CwF[l] is an instance; C.p-lift-T is the
-- member evaluated in it -- one name, no copy.
--
-- One level instead of Agda's four (lc ls lt le): with cumulative
-- universes the maximum serves for all.  Implicit arguments are explicit;
-- Agda's mixfix  A [ s ]T, a [ s ]t, s o s', G & A  are  subT, subt, o, ext.

open Base ;

record CwF (l : Level) {
  open Prelude[l] ;

  -- contexts and substitutions
  Ctx : U l ;
  Sub (D G : Ctx) : U l ;
  isSetSub (D G : Ctx) : isSet (Sub D G) ;
  id (G : Ctx) : Sub G G ;
  o (T D G : Ctx) (s : Sub D G) (s' : Sub T D) : Sub T G ;
  o-idl (D G : Ctx) (s : Sub D G) : Id (Sub D G) (o D G G (id G) s) s ;
  o-idr (D G : Ctx) (s : Sub D G) : Id (Sub D G) (o D D G s (id D)) s ;
  o-assoc (Q T D G : Ctx) (s : Sub D G) (s' : Sub T D) (s'' : Sub Q T)
    : Id (Sub Q G) (o Q T G (o T D G s s') s'') (o Q D G s (o Q T D s' s'')) ;

  -- empty context
  nil : Ctx ;
  eps (G : Ctx) : Sub G nil ;
  eps-uniq (G : Ctx) (s : Sub G nil) : Id (Sub G nil) s (eps G) ;

  -- types
  Ty (G : Ctx) : U l ;
  isSetTy (G : Ctx) : isSet (Ty G) ;
  subT (D G : Ctx) (A : Ty G) (s : Sub D G) : Ty D ;
  subT-id (G : Ctx) (A : Ty G) : Id (Ty G) (subT G G A (id G)) A ;
  subT-o (T D G : Ctx) (A : Ty G) (s : Sub D G) (s' : Sub T D)
    : Id (Ty T) (subT T G A (o T D G s s')) (subT T D (subT D G A s) s') ;

  -- elements
  El (G : Ctx) (A : Ty G) : U l ;
  isSetEl (G : Ctx) (A : Ty G) : isSet (El G A) ;
  subt (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) : El D (subT D G A s) ;
  subt-id (G : Ctx) (A : Ty G) (a : El G A)
    : Id (El G A) (subst (Ty G) (El G) (subT G G A (id G)) A (subT-id G A) (subt G G A a (id G))) a ;
  subt-o (T D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (s' : Sub T D)
    : Id (El T (subT T D (subT D G A s) s'))
         (subst (Ty T) (El T) (subT T G A (o T D G s s')) (subT T D (subT D G A s) s')
                (subT-o T D G A s s') (subt T G A a (o T D G s s')))
         (subt T D (subT D G A s) (subt D G A a s) s') ;

  -- context extension, Ehrhard style
  ext (G : Ctx) (A : Ty G) : Ctx ;
  p (G : Ctx) (A : Ty G) : Sub (ext G A) G ;
  q (G : Ctx) (A : Ty G) : El (ext G A) (subT (ext G A) G A (p G A)) ;
  lift (D G : Ctx) (A : Ty G) (s : Sub D G) : Sub (ext D (subT D G A s)) (ext G A) ;
  sec (G : Ctx) (A : Ty G) (a : El G A) : Sub G (ext G A) ;

  lift-id (G : Ctx) (A : Ty G)
    : Id (Sub (ext G A) (ext G A))
         (subst (Ty G) (\ B -> Sub (ext G B) (ext G A)) (subT G G A (id G)) A (subT-id G A)
                (lift G G A (id G)))
         (id (ext G A)) ;
  lift-o (T D G : Ctx) (A : Ty G) (s : Sub D G) (s' : Sub T D)
    : Id (Sub (ext T (subT T D (subT D G A s) s')) (ext G A))
         (subst (Ty T) (\ B -> Sub (ext T B) (ext G A))
                (subT T G A (o T D G s s')) (subT T D (subT D G A s) s')
                (subT-o T D G A s s') (lift T G A (o T D G s s')))
         (o (ext T (subT T D (subT D G A s) s')) (ext D (subT D G A s)) (ext G A)
            (lift D G A s) (lift T D (subT D G A s) s')) ;
  p-lift (D G : Ctx) (A : Ty G) (s : Sub D G)
    : Id (Sub (ext D (subT D G A s)) G)
         (o (ext D (subT D G A s)) (ext G A) G (p G A) (lift D G A s))
         (o (ext D (subT D G A s)) D G s (p D (subT D G A s))) ;
  p-sec (G : Ctx) (A : Ty G) (a : El G A)
    : Id (Sub G G) (o G (ext G A) G (p G A) (sec G A a)) (id G) ;
  sec-o (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G)
    : Id (Sub D (ext G A)) (o D G (ext G A) (sec G A a) s)
         (o D (ext D (subT D G A s)) (ext G A) (lift D G A s)
            (sec D (subT D G A s) (subt D G A a s))) ;
  lift-p-sec-q (G : Ctx) (A : Ty G)
    : Id (Sub (ext G A) (ext G A))
         (o (ext G A) (ext (ext G A) (subT (ext G A) G A (p G A))) (ext G A)
            (lift (ext G A) G A (p G A))
            (sec (ext G A) (subT (ext G A) G A (p G A)) (q G A)))
         (id (ext G A)) ;

  -- the type equations needed to state the equations for q: DERIVED
  -- members, between the fields
  p-lift-T (D G : Ctx) (A B : Ty G) (s : Sub D G)
    : Id (Ty (ext D (subT D G A s)))
         (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
         (subT (ext D (subT D G A s)) D (subT D G B s) (p D (subT D G A s))) =
    trans (Ty E)
      (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
      (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
      (subT E D (subT D G B s) (p D (subT D G A s)))
      (sym (Ty E) (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
                  (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
                  (subT-o E (ext G A) G B (p G A) (lift D G A s)))
      (trans (Ty E)
         (subT E G B (o E (ext G A) G (p G A) (lift D G A s)))
         (subT E G B (o E D G s (p D (subT D G A s))))
         (subT E D (subT D G B s) (p D (subT D G A s)))
         (ap (Sub E G) (Ty E) (\ s' -> subT E G B s')
             (o E (ext G A) G (p G A) (lift D G A s)) (o E D G s (p D (subT D G A s)))
             (p-lift D G A s))
         (subT-o E D G B s (p D (subT D G A s))))
   where { E : Ctx = ext D (subT D G A s) ; } ;

  p-sec-T (G : Ctx) (A B : Ty G) (a : El G A)
    : Id (Ty G) (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a)) B =
    trans (Ty G)
      (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
      (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
      B
      (sym (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
                  (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
                  (subT-o G (ext G A) G B (p G A) (sec G A a)))
      (trans (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a))) (subT G G B (id G)) B
         (ap (Sub G G) (Ty G) (\ s' -> subT G G B s')
             (o G (ext G A) G (p G A) (sec G A a)) (id G) (p-sec G A a))
         (subT-id G B)) ;

  -- fields whose types use the derived members
  q-lift (D G : Ctx) (A : Ty G) (s : Sub D G)
    : Id (El (ext D (subT D G A s)) (subT (ext D (subT D G A s)) D (subT D G A s) (p D (subT D G A s))))
         (subst (Ty (ext D (subT D G A s))) (El (ext D (subT D G A s)))
                (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G A (p G A)) (lift D G A s))
                (subT (ext D (subT D G A s)) D (subT D G A s) (p D (subT D G A s)))
                (p-lift-T D G A A s)
                (subt (ext D (subT D G A s)) (ext G A) (subT (ext G A) G A (p G A)) (q G A) (lift D G A s)))
         (q D (subT D G A s)) ;
  q-sec (G : Ctx) (A : Ty G) (a : El G A)
    : Id (El G A)
         (subst (Ty G) (El G) (subT G (ext G A) (subT (ext G A) G A (p G A)) (sec G A a)) A
                (p-sec-T G A A a)
                (subt G (ext G A) (subT (ext G A) G A (p G A)) (q G A) (sec G A a)))
         a ;

  -- the usual extension of a substitution
  extS (D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s)) : Sub D (ext G A) =
    o D (ext D (subT D G A s)) (ext G A) (lift D G A s) (sec D (subT D G A s) a) ;
} ;

------------------------------------------------------------------------
-- Type formers.  Agda's  module Formers (C : CwF ..)  whose records are
-- UnitStr, ZeroStr, ..: here a segment over an element C, whose records
-- are again segments used as types.

module Formers (l : Level) (C : CwF[l]) {
  open Prelude[l] ;
  open C ;

  record UnitStr {
    Unit (G : Ctx) : Ty G ;
    Unit-nat (D G : Ctx) (s : Sub D G) : Id (Ty D) (subT D G (Unit G) s) (Unit D) ;
    Unit-iso (G : Ctx) : Iso (El G (Unit G)) Top ;
    Unit-iso-nat (D G : Ctx) (t : Top) (s : Sub D G)
      : Id (El D (Unit D))
           (subst (Ty D) (El D) (subT D G (Unit G) s) (Unit D) (Unit-nat D G s)
                  (subt D G (Unit G) ((Unit-iso G).inv t) s))
           ((Unit-iso D).inv t) ;
  } ;

  record ZeroStr {
    Zero (G : Ctx) : Ty G ;
    Zero-nat (D G : Ctx) (s : Sub D G) : Id (Ty D) (subT D G (Zero G) s) (Zero D) ;
    Zero-elim (G : Ctx) (A : Ty (ext G (Zero G))) : El (ext G (Zero G)) A ;

    up (D G : Ctx) (s : Sub D G) : Sub (ext D (Zero D)) (ext G (Zero G)) =
      subst (Ty D) (\ X -> Sub (ext D X) (ext G (Zero G))) (subT D G (Zero G) s) (Zero D)
            (Zero-nat D G s) (lift D G (Zero G) s) ;

    Zero-elim-nat (D G : Ctx) (A : Ty (ext G (Zero G))) (s : Sub D G)
      : Id (El (ext D (Zero D)) (subT (ext D (Zero D)) (ext G (Zero G)) A (up D G s)))
           (Zero-elim D (subT (ext D (Zero D)) (ext G (Zero G)) A (up D G s)))
           (subt (ext D (Zero D)) (ext G (Zero G)) A (Zero-elim G A) (up D G s)) ;
  } ;

  record TwoStr {
    Two (G : Ctx) : Ty G ;
    Two-nat (D G : Ctx) (s : Sub D G) : Id (Ty D) (subT D G (Two G) s) (Two D) ;
    Btrue (G : Ctx) : El G (Two G) ;
    Bfalse (G : Ctx) : El G (Two G) ;
    Btrue-nat (D G : Ctx) (s : Sub D G)
      : Id (El D (Two D)) (subst (Ty D) (El D) (subT D G (Two G) s) (Two D) (Two-nat D G s)
                                 (subt D G (Two G) (Btrue G) s)) (Btrue D) ;
    Bfalse-nat (D G : Ctx) (s : Sub D G)
      : Id (El D (Two D)) (subst (Ty D) (El D) (subT D G (Two G) s) (Two D) (Two-nat D G s)
                                 (subt D G (Two G) (Bfalse G) s)) (Bfalse D) ;

    -- the two instances of a family over Two
    Pair (G : Ctx) (A : Ty (ext G (Two G))) : U l =
      El G (subT G (ext G (Two G)) A (sec G (Two G) (Btrue G)))
      * El G (subT G (ext G (Two G)) A (sec G (Two G) (Bfalse G))) ;

    cases (G : Ctx) (A : Ty (ext G (Two G))) (a : El (ext G (Two G)) A) : Pair G A =
      (subt G (ext G (Two G)) A a (sec G (Two G) (Btrue G)),
       subt G (ext G (Two G)) A a (sec G (Two G) (Bfalse G))) ;

    up (D G : Ctx) (s : Sub D G) : Sub (ext D (Two D)) (ext G (Two G)) =
      subst (Ty D) (\ X -> Sub (ext D X) (ext G (Two G))) (subT D G (Two G) s) (Two D)
            (Two-nat D G s) (lift D G (Two G) s) ;

    Two-elim (G : Ctx) (A : Ty (ext G (Two G))) : Pair G A -> El (ext G (Two G)) A ;
    Two-beta (G : Ctx) (A : Ty (ext G (Two G))) (tf : Pair G A)
      : Id (Pair G A) (cases G A (Two-elim G A tf)) tf ;
    -- naturality, without transport as in fun-with-cwf
    Two-elim-nat (D G : Ctx) (A : Ty (ext G (Two G))) (s : Sub D G) (tf : Pair G A)
      : Id (El (ext D (Two D)) (subT (ext D (Two D)) (ext G (Two G)) A (up D G s)))
           (Two-elim D (subT (ext D (Two D)) (ext G (Two G)) A (up D G s))
              (cases D (subT (ext D (Two D)) (ext G (Two G)) A (up D G s))
                 (subt (ext D (Two D)) (ext G (Two G)) A (Two-elim G A tf) (up D G s))))
           (subt (ext D (Two D)) (ext G (Two G)) A (Two-elim G A tf) (up D G s)) ;
  } ;

  record SigStr {
    Sig (G : Ctx) (A : Ty G) (B : Ty (ext G A)) : Ty G ;
    Sig-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G)
      : Id (Ty D) (subT D G (Sig G A B) s)
                  (Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) ;
    Sig-iso (G : Ctx) (A : Ty G) (B : Ty (ext G A))
      : Iso (El G (Sig G A B)) ((a : El G A) * El G (subT G (ext G A) B (sec G A a))) ;

    coerce (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (a : El G A) (s : Sub D G)
      : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s)
                  (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
                        (sec D (subT D G A s) (subt D G A a s))) =
      trans (Ty D) X (subT D (ext G A) B (o D G (ext G A) (sec G A a) s)) Z
        (sym (Ty D) (subT D (ext G A) B (o D G (ext G A) (sec G A a) s)) X
                    (subT-o D G (ext G A) B (sec G A a) s))
        (trans (Ty D) (subT D (ext G A) B (o D G (ext G A) (sec G A a) s))
                      (subT D (ext G A) B (o D (ext D (subT D G A s)) (ext G A) (lift D G A s)
                                             (sec D (subT D G A s) (subt D G A a s))))
                      Z
           (ap (Sub D (ext G A)) (Ty D) (\ s' -> subT D (ext G A) B s')
               (o D G (ext G A) (sec G A a) s)
               (o D (ext D (subT D G A s)) (ext G A) (lift D G A s) (sec D (subT D G A s) (subt D G A a s)))
               (sec-o D G A a s))
           (subT-o D (ext D (subT D G A s)) (ext G A) B (lift D G A s) (sec D (subT D G A s) (subt D G A a s))))
     where {
      X : Ty D = subT D G (subT G (ext G A) B (sec G A a)) s ;
      Z : Ty D = subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
                      (sec D (subT D G A s) (subt D G A a s)) ;
     } ;

    Sig-iso-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A))
      (a : El G A) (b : El G (subT G (ext G A) B (sec G A a))) (s : Sub D G)
      : Id (El D (Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))))
           (subst (Ty D) (El D) (subT D G (Sig G A B) s)
                  (Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)))
                  (Sig-nat D G A B s)
                  (subt D G (Sig G A B) ((Sig-iso G A B).inv (a, b)) s))
           ((Sig-iso D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))).inv
              (subt D G A a s,
               subst (Ty D) (El D) (subT D G (subT G (ext G A) B (sec G A a)) s)
                     (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
                           (sec D (subT D G A s) (subt D G A a s)))
                     (coerce D G A B a s) (subt D G (subT G (ext G A) B (sec G A a)) b s))) ;
  } ;

  record PiStr {
    Pi (G : Ctx) (A : Ty G) (B : Ty (ext G A)) : Ty G ;
    Pi-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G)
      : Id (Ty D) (subT D G (Pi G A B) s)
                  (Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) ;
    Pi-iso (G : Ctx) (A : Ty G) (B : Ty (ext G A)) : Iso (El G (Pi G A B)) (El (ext G A) B) ;
    Pi-iso-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El (ext G A) B) (s : Sub D G)
      : Id (El D (Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))))
           (subst (Ty D) (El D) (subT D G (Pi G A B) s)
                  (Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)))
                  (Pi-nat D G A B s)
                  (subt D G (Pi G A B) ((Pi-iso G A B).inv f) s))
           ((Pi-iso D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))).inv
              (subt (ext D (subT D G A s)) (ext G A) B f (lift D G A s))) ;
  } ;

  record IdStr {
    IdT (G : Ctx) (A : Ty G) (a b : El G A) : Ty G ;
    IdT-nat (D G : Ctx) (A : Ty G) (a b : El G A) (s : Sub D G)
      : Id (Ty D) (subT D G (IdT G A a b) s)
                  (IdT D (subT D G A s) (subt D G A a s) (subt D G A b s)) ;
    IdT-iso (G : Ctx) (A : Ty G) (a b : El G A) : Iso (El G (IdT G A a b)) (Id (El G A) a b) ;
    IdT-iso-nat (D G : Ctx) (A : Ty G) (a b : El G A) (e : Id (El G A) a b) (s : Sub D G)
      : Id (El D (IdT D (subT D G A s) (subt D G A a s) (subt D G A b s)))
           (subst (Ty D) (El D) (subT D G (IdT G A a b) s)
                  (IdT D (subT D G A s) (subt D G A a s) (subt D G A b s))
                  (IdT-nat D G A a b s)
                  (subt D G (IdT G A a b) ((IdT-iso G A a b).inv e) s))
           ((IdT-iso D (subT D G A s) (subt D G A a s) (subt D G A b s)).inv
              (ap (El G A) (El D (subT D G A s)) (\ c -> subt D G A c s) a b e)) ;
  } ;

  -- Agda's  G & N , G & N & A , sucS o p  are the members GN, GNA, sp
  module NatStr {
    N (G : Ctx) : Ty G ;
    N-nat (D G : Ctx) (s : Sub D G) : Id (Ty D) (subT D G (N G) s) (N D) ;

    GN (G : Ctx) : Ctx = ext G (N G) ;

    zeroS (G : Ctx) : Sub G (GN G) ;
    sucS (G : Ctx) : Sub (GN G) (GN G) ;
    p-zeroS (G : Ctx) : Id (Sub G G) (o G (GN G) G (p G (N G)) (zeroS G)) (id G) ;
    p-sucS (G : Ctx) : Id (Sub (GN G) G) (o (GN G) (GN G) G (p G (N G)) (sucS G)) (p G (N G)) ;

    up (D G : Ctx) (s : Sub D G) : Sub (GN D) (GN G) =
      subst (Ty D) (\ X -> Sub (ext D X) (GN G)) (subT D G (N G) s) (N D)
            (N-nat D G s) (lift D G (N G) s) ;

    zeroS-nat (D G : Ctx) (s : Sub D G)
      : Id (Sub D (GN G)) (o D (GN D) (GN G) (up D G s) (zeroS D)) (o D G (GN G) (zeroS G) s) ;
    sucS-nat (D G : Ctx) (s : Sub D G)
      : Id (Sub (GN D) (GN G)) (o (GN D) (GN D) (GN G) (up D G s) (sucS D))
                               (o (GN D) (GN G) (GN G) (sucS G) (up D G s)) ;

    GNA (G : Ctx) (A : Ty (GN G)) : Ctx = ext (GN G) A ;
    sp (G : Ctx) (A : Ty (GN G)) : Sub (GNA G A) (GN G) =
      o (GNA G A) (GN G) (GN G) (sucS G) (p (GN G) A) ;

    N-elim (G : Ctx) (A : Ty (GN G)) (z : El G (subT G (GN G) A (zeroS G)))
      (st : El (GNA G A) (subT (GNA G A) (GN G) A (sp G A))) : El (GN G) A ;
    N-beta-zero (G : Ctx) (A : Ty (GN G)) (z : El G (subT G (GN G) A (zeroS G)))
      (st : El (GNA G A) (subT (GNA G A) (GN G) A (sp G A)))
      : Id (El G (subT G (GN G) A (zeroS G))) (subt G (GN G) A (N-elim G A z st) (zeroS G)) z ;

    step-T (G : Ctx) (A : Ty (GN G)) (e : El (GN G) A)
      : Id (Ty (GN G)) (subT (GN G) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) (sec (GN G) A e))
                       (subT (GN G) (GN G) A (sucS G)) =
      trans (Ty (GN G))
        (subT (GN G) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) (sec (GN G) A e))
        (subT (GN G) (GNA G A) (subT (GNA G A) (GN G) (subT (GN G) (GN G) A (sucS G)) (p (GN G) A)) (sec (GN G) A e))
        (subT (GN G) (GN G) A (sucS G))
        (ap (Ty (GNA G A)) (Ty (GN G)) (\ B -> subT (GN G) (GNA G A) B (sec (GN G) A e))
            (subT (GNA G A) (GN G) A (sp G A))
            (subT (GNA G A) (GN G) (subT (GN G) (GN G) A (sucS G)) (p (GN G) A))
            (subT-o (GNA G A) (GN G) (GN G) A (sucS G) (p (GN G) A)))
        (p-sec-T (GN G) A (subT (GN G) (GN G) A (sucS G)) e) ;

    zero-T (D G : Ctx) (A : Ty (GN G)) (s : Sub D G)
      : Id (Ty D) (subT D G (subT G (GN G) A (zeroS G)) s)
                  (subT D (GN D) (subT (GN D) (GN G) A (up D G s)) (zeroS D)) =
      trans (Ty D) X0 X1 X3
        (sym (Ty D) X1 X0 (subT-o D G (GN G) A (zeroS G) s))
        (trans (Ty D) X1 X2 X3
           (ap (Sub D (GN G)) (Ty D) (\ s' -> subT D (GN G) A s')
               (o D G (GN G) (zeroS G) s) (o D (GN D) (GN G) (up D G s) (zeroS D))
               (sym (Sub D (GN G)) (o D (GN D) (GN G) (up D G s) (zeroS D)) (o D G (GN G) (zeroS G) s)
                    (zeroS-nat D G s)))
           (subT-o D (GN D) (GN G) A (up D G s) (zeroS D)))
     where {
      X0 : Ty D = subT D G (subT G (GN G) A (zeroS G)) s ;
      X1 : Ty D = subT D (GN G) A (o D G (GN G) (zeroS G) s) ;
      X2 : Ty D = subT D (GN G) A (o D (GN D) (GN G) (up D G s) (zeroS D)) ;
      X3 : Ty D = subT D (GN D) (subT (GN D) (GN G) A (up D G s)) (zeroS D) ;
     } ;

    -- the context  D & N & A [ up s ]T
    EU (D G : Ctx) (A : Ty (GN G)) (s : Sub D G) : Ctx = GNA D (subT (GN D) (GN G) A (up D G s)) ;

    suc-p-lift (D G : Ctx) (A : Ty (GN G)) (s : Sub D G)
      : Id (Sub (EU D G A s) (GN G))
           (o (EU D G A s) (GNA G A) (GN G) (sp G A) (lift (GN D) (GN G) A (up D G s)))
           (o (EU D G A s) (GN D) (GN G) (up D G s) (sp D (subT (GN D) (GN G) A (up D G s)))) =
      trans (Sub E (GN G)) S1 S2 S6
        (o-assoc E (GNA G A) (GN G) (GN G) (sucS G) (p (GN G) A) L)
      (trans (Sub E (GN G)) S2 S3 S6
        (ap (Sub E (GN G)) (Sub E (GN G)) (\ t -> o E (GN G) (GN G) (sucS G) t)
            (o E (GNA G A) (GN G) (p (GN G) A) L) (o E (GN D) (GN G) (up D G s) P)
            (p-lift (GN D) (GN G) A (up D G s)))
      (trans (Sub E (GN G)) S3 S4 S6
        (sym (Sub E (GN G)) S4 S3 (o-assoc E (GN D) (GN G) (GN G) (sucS G) (up D G s) P))
      (trans (Sub E (GN G)) S4 S5 S6
        (ap (Sub (GN D) (GN G)) (Sub E (GN G)) (\ t -> o E (GN D) (GN G) t P)
            (o (GN D) (GN G) (GN G) (sucS G) (up D G s)) (o (GN D) (GN D) (GN G) (up D G s) (sucS D))
            (sym (Sub (GN D) (GN G)) (o (GN D) (GN D) (GN G) (up D G s) (sucS D))
                 (o (GN D) (GN G) (GN G) (sucS G) (up D G s)) (sucS-nat D G s)))
        (o-assoc E (GN D) (GN D) (GN G) (up D G s) (sucS D) P))))
     where {
      E : Ctx = EU D G A s ;
      L : Sub E (GNA G A) = lift (GN D) (GN G) A (up D G s) ;
      P : Sub E (GN D) = p (GN D) (subT (GN D) (GN G) A (up D G s)) ;
      S1 : Sub E (GN G) = o E (GNA G A) (GN G) (sp G A) L ;
      S2 : Sub E (GN G) = o E (GN G) (GN G) (sucS G) (o E (GNA G A) (GN G) (p (GN G) A) L) ;
      S3 : Sub E (GN G) = o E (GN G) (GN G) (sucS G) (o E (GN D) (GN G) (up D G s) P) ;
      S4 : Sub E (GN G) = o E (GN D) (GN G) (o (GN D) (GN G) (GN G) (sucS G) (up D G s)) P ;
      S5 : Sub E (GN G) = o E (GN D) (GN G) (o (GN D) (GN D) (GN G) (up D G s) (sucS D)) P ;
      S6 : Sub E (GN G) = o E (GN D) (GN G) (up D G s) (sp D (subT (GN D) (GN G) A (up D G s))) ;
     } ;

    suc-T (D G : Ctx) (A : Ty (GN G)) (s : Sub D G)
      : Id (Ty (EU D G A s))
           (subT (EU D G A s) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) (lift (GN D) (GN G) A (up D G s)))
           (subT (EU D G A s) (GN D) (subT (GN D) (GN G) A (up D G s)) (sp D (subT (GN D) (GN G) A (up D G s)))) =
      trans (Ty E) Y0 Y1 Y3
        (sym (Ty E) Y1 Y0 (subT-o E (GNA G A) (GN G) A (sp G A) L))
        (trans (Ty E) Y1 Y2 Y3
           (ap (Sub E (GN G)) (Ty E) (\ s' -> subT E (GN G) A s')
               (o E (GNA G A) (GN G) (sp G A) L)
               (o E (GN D) (GN G) (up D G s) (sp D A'))
               (suc-p-lift D G A s))
           (subT-o E (GN D) (GN G) A (up D G s) (sp D A')))
     where {
      E : Ctx = EU D G A s ;
      A' : Ty (GN D) = subT (GN D) (GN G) A (up D G s) ;
      L : Sub E (GNA G A) = lift (GN D) (GN G) A (up D G s) ;
      Y0 : Ty E = subT E (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) L ;
      Y1 : Ty E = subT E (GN G) A (o E (GNA G A) (GN G) (sp G A) L) ;
      Y2 : Ty E = subT E (GN G) A (o E (GN D) (GN G) (up D G s) (sp D A')) ;
      Y3 : Ty E = subT E (GN D) A' (sp D A') ;
     } ;

    N-beta-suc (G : Ctx) (A : Ty (GN G)) (z : El G (subT G (GN G) A (zeroS G)))
      (st : El (GNA G A) (subT (GNA G A) (GN G) A (sp G A)))
      : Id (El (GN G) (subT (GN G) (GN G) A (sucS G)))
           (subst (Ty (GN G)) (El (GN G))
              (subT (GN G) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) (sec (GN G) A (N-elim G A z st)))
              (subT (GN G) (GN G) A (sucS G))
              (step-T G A (N-elim G A z st))
              (subt (GN G) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) st (sec (GN G) A (N-elim G A z st))))
           (subt (GN G) (GN G) A (N-elim G A z st) (sucS G)) ;

    N-elim-nat (D G : Ctx) (A : Ty (GN G)) (z : El G (subT G (GN G) A (zeroS G)))
      (st : El (GNA G A) (subT (GNA G A) (GN G) A (sp G A))) (s : Sub D G)
      : Id (El (GN D) (subT (GN D) (GN G) A (up D G s)))
           (N-elim D (subT (GN D) (GN G) A (up D G s))
              (subst (Ty D) (El D) (subT D G (subT G (GN G) A (zeroS G)) s)
                     (subT D (GN D) (subT (GN D) (GN G) A (up D G s)) (zeroS D))
                     (zero-T D G A s) (subt D G (subT G (GN G) A (zeroS G)) z s))
              (subst (Ty (EU D G A s)) (El (EU D G A s))
                     (subT (EU D G A s) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) (lift (GN D) (GN G) A (up D G s)))
                     (subT (EU D G A s) (GN D) (subT (GN D) (GN G) A (up D G s)) (sp D (subT (GN D) (GN G) A (up D G s))))
                     (suc-T D G A s)
                     (subt (EU D G A s) (GNA G A) (subT (GNA G A) (GN G) A (sp G A)) st (lift (GN D) (GN G) A (up D G s)))))
           (subt (GN D) (GN G) A (N-elim G A z st) (up D G s)) ;
  } ;
} ;

------------------------------------------------------------------------
-- With the extensional identity type, the eliminators of Two and Zero
-- are unique (eta), by reasoning in the model as in fun-with-cwf.

module Eta (l : Level) (C : CwF[l]) (I : Formers[l, C].IdStr) {
  open Prelude[l] ;
  open C ;

  Two-eta (T : Formers[l, C].TwoStr) (G : Ctx) (A : Ty (ext G (T.Two G)))
    (a : El (ext G (T.Two G)) A)
    : Id (El (ext G (T.Two G)) A) (T.Two-elim G A (T.cases G A a)) a =
    (I.IdT-iso (ext G (T.Two G)) A a' a).fun
      (T.Two-elim G (I.IdT (ext G (T.Two G)) A a' a)
         (case (T.Btrue G) (ap (T.Pair G A) (El G (subT G (ext G (T.Two G)) A (sec G (T.Two G) (T.Btrue G))))
                                (\ w -> w.1) (T.cases G A a') (T.cases G A a) beta),
          case (T.Bfalse G) (ap (T.Pair G A) (El G (subT G (ext G (T.Two G)) A (sec G (T.Two G) (T.Bfalse G))))
                                (\ w -> w.2) (T.cases G A a') (T.cases G A a) beta)))
   where {
    a' : El (ext G (T.Two G)) A = T.Two-elim G A (T.cases G A a) ;
    beta : Id (T.Pair G A) (T.cases G A a') (T.cases G A a) = T.Two-beta G A (T.cases G A a) ;
    case (b : El G (T.Two G))
      (e : Id (El G (subT G (ext G (T.Two G)) A (sec G (T.Two G) b)))
              (subt G (ext G (T.Two G)) A a' (sec G (T.Two G) b))
              (subt G (ext G (T.Two G)) A a (sec G (T.Two G) b)))
      : El G (subT G (ext G (T.Two G)) (I.IdT (ext G (T.Two G)) A a' a) (sec G (T.Two G) b)) =
      subst (Ty G) (El G)
        (I.IdT G (subT G (ext G (T.Two G)) A (sec G (T.Two G) b))
               (subt G (ext G (T.Two G)) A a' (sec G (T.Two G) b))
               (subt G (ext G (T.Two G)) A a (sec G (T.Two G) b)))
        (subT G (ext G (T.Two G)) (I.IdT (ext G (T.Two G)) A a' a) (sec G (T.Two G) b))
        (sym (Ty G) (subT G (ext G (T.Two G)) (I.IdT (ext G (T.Two G)) A a' a) (sec G (T.Two G) b))
                    (I.IdT G (subT G (ext G (T.Two G)) A (sec G (T.Two G) b))
                           (subt G (ext G (T.Two G)) A a' (sec G (T.Two G) b))
                           (subt G (ext G (T.Two G)) A a (sec G (T.Two G) b)))
                    (I.IdT-nat G (ext G (T.Two G)) A a' a (sec G (T.Two G) b)))
        ((I.IdT-iso G (subT G (ext G (T.Two G)) A (sec G (T.Two G) b))
                    (subt G (ext G (T.Two G)) A a' (sec G (T.Two G) b))
                    (subt G (ext G (T.Two G)) A a (sec G (T.Two G) b))).inv e) ;
   } ;

  Zero-eta (Z : Formers[l, C].ZeroStr) (G : Ctx) (A : Ty (ext G (Z.Zero G)))
    (a : El (ext G (Z.Zero G)) A) : Id (El (ext G (Z.Zero G)) A) a (Z.Zero-elim G A) =
    (I.IdT-iso (ext G (Z.Zero G)) A a (Z.Zero-elim G A)).fun
      (Z.Zero-elim G (I.IdT (ext G (Z.Zero G)) A a (Z.Zero-elim G A))) ;
} ;
