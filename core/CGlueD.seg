-- CGlueD.seg (L5, inside CB; quarry seg/model GGlueD): the presheaf of local glue data, at level a+ like UCtx.  A point at
-- stage I is glue data over y I, coded:
--
--   A    a code (U0 I)
--   ph   a cofibration of y I: ONE sieve of I (Yoneda: no proof field);
--        fl I ph W f decides "f lands in it"
--   B    a partial code: at each f : W -> I in the extent, a code of U0 W,
--        natural (bn, a proposition)
--   al   alpha on fibres: fib0 (B f) -> A at f, natural (aln, a proposition)
--
-- The action along h : J -> I precomposes with h (gdAct); its laws are
-- equations of codes in sets.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
module L1 = GPre[a+].PS ;
open GYon[a] ;
open Encode[a, a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;

-- the extent of the cofibration of y I given by a sieve of I
fl (I : Ob) (ph : Phi I) (W : Ob) (f : Hom W I) : Bool = allS W (pre W I f ph) ;

fl-pre (J I : Ob) (h : Hom J I) (ph : Phi I) (W : Ob) (g : Hom W J) (q : IsT (fl J (pre J I h ph) W g))
  : IsT (fl I ph W (compH W J I h g)) =
  substH (\ Q -> IsT (allS W Q)) (pre-comp W J I g h ph) q ;

opaque fl-pre ;

module GD (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;

  ----------------------------------------------------------------------
  -- the components

  BTy (I : Ob) (ph : Phi I) : U a+ = (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) -> UU.U0 W ;

  BNat (I : Ob) (ph : Phi I) (B : BTy I ph) : U a+ =
    (W' W : Ob) (chi : Hom W' W) (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
    (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2))
    -> Id (UU.U0 W') (UU.uAct W' W chi (B W f q)) (B W' f2 q2) ;

  AlTy (I : Ob) (A : UU.U0 I) (ph : Phi I) (B : BTy I ph) : U a+ =
    (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) -> W0.Ix (UU.fib0 W (B W f q)) -> W0.Ix (A.1.tob W f) ;

  AlNat (I : Ob) (A : UU.U0 I) (ph : Phi I) (B : BTy I ph) (bn : BNat I ph B) (al : AlTy I A ph B) : U a+ =
    (W' W : Ob) (chi : Hom W' W) (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
    (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) (b : W0.Ix (UU.fib0 W (B W f q)))
    -> Id (W0.Ix (A.1.tob W' f2)) (al W' f2 q2 (UU.tactG W' W chi (B W f q) (B W' f2 q2) (bn W' W chi f q f2 E q2) b))
                                  (A.1.tact W' W chi f f2 E (al W f q b)) ;

  -- the data at stage I
  AlD (I : Ob) (A : UU.U0 I) (ph : Phi I) (B : BTy I ph) (bn : BNat I ph B) : U a+ =
    (al : AlTy I A ph B) * AlNat I A ph B bn al ;

  BD (I : Ob) (A : UU.U0 I) (ph : Phi I) : U a+ =
    (B : BTy I ph) * ((bn : BNat I ph B) * AlD I A ph B bn) ;

  GD0 (I : Ob) : U a+ = (A : UU.U0 I) * ((ph : Phi I) * BD I A ph) ;

  ----------------------------------------------------------------------
  -- the action along h : J -> I

  module Act (J I : Ob) (h : Hom J I) (A : UU.U0 I) (ph : Phi I) (bd : BD I A ph) {
    A' : UU.U0 J = UU.uAct J I h A ;
    ph' : Phi J = pre J I h ph ;

    qU (W : Ob) (g : Hom W J) (q : IsT (fl J ph' W g)) : IsT (fl I ph W (compH W J I h g)) = fl-pre J I h ph W g q ;

    aE (W' W : Ob) (chi : Hom W' W) (g : Hom W J) (g2 : Hom W' J) (E : Id (Hom W' J) (compH W' W J g chi) g2)
      : Id (Hom W' I) (compH W' W I (compH W J I h g) chi) (compH W' J I h g2) =
      transH (comp-assoc W' W J I h g chi) (apH (compH W' J I h) E) ;

    B' : BTy J ph' = \ W g q -> bd.1 W (compH W J I h g) (qU W g q) ;

    bn' : BNat J ph' B' = \ W' W chi g q g2 E q2 ->
      bd.2.1 W' W chi (compH W J I h g) (qU W g q) (compH W' J I h g2) (aE W' W chi g g2 E) (qU W' g2 q2) ;

    al' : AlTy J A' ph' B' = \ W g q b -> bd.2.2.1 W (compH W J I h g) (qU W g q) b ;

    aln' : AlNat J A' ph' B' bn' al' = \ W' W chi g q g2 E q2 b ->
      transH (bd.2.2.2 W' W chi (compH W J I h g) (qU W g q) (compH W' J I h g2) (aE W' W chi g g2 E) (qU W' g2 q2) b)
        (apH (\ p -> A.1.tact W' W chi (compH W J I h g) (compH W' J I h g2) p (bd.2.2.1 W (compH W J I h g) (qU W g q) b))
           (W0.isSetIx (homV W' I) (compH W' W I (compH W J I h g) chi) (compH W' J I h g2)
              (aE W' W chi g g2 E) (ntEq (yP J) (yP I) (yH J I h) W' W chi g g2 E))) ;

    res : GD0 J = (A', (ph', (B', (bn', (al', aln'))))) ;
  } ;

  gdAct (J I : Ob) (h : Hom J I) (d : GD0 I) : GD0 J = Act[J, I, h, d.1, d.2.1, d.2.2].res ;

  ----------------------------------------------------------------------
  -- the naturality components are propositions

  setU0 (W : Ob) : isSet (UU.U0 W) = V1.isSetIx (UU.codeU W) ;

  -- the binders of BNat / AlNat after (W' , W)
  NatB (I : Ob) (ph : Phi I) (W' W : Ob) (C : (chi : Hom W' W) (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
      (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> U a+) : U a+ =
    (chi : Hom W' W) (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
    (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> C chi f q f2 E q2 ;

  isProp-NatB (I : Ob) (ph : Phi I) (W' W : Ob) (C : (chi : Hom W' W) (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
      (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> U a+)
    (pC : (chi : Hom W' W) (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
      (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> isProp (C chi f q f2 E q2))
    : isProp (NatB I ph W' W C) =
    isProp-Pi (Hom W' W) (\ chi -> (f : Hom W I) (q : IsT (fl I ph W f)) (f2 : Hom W' I)
      (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> C chi f q f2 E q2) (\ chi ->
    isProp-Pi (Hom W I) (\ f -> (q : IsT (fl I ph W f)) (f2 : Hom W' I)
      (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> C chi f q f2 E q2) (\ f ->
    isProp-Pi (IsT (fl I ph W f)) (\ q -> (f2 : Hom W' I)
      (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> C chi f q f2 E q2) (\ q ->
    isProp-Pi (Hom W' I) (\ f2 -> (E : Id (Hom W' I) (compH W' W I f chi) f2) (q2 : IsT (fl I ph W' f2)) -> C chi f q f2 E q2) (\ f2 ->
    isProp-Pi (Id (Hom W' I) (compH W' W I f chi) f2) (\ E -> (q2 : IsT (fl I ph W' f2)) -> C chi f q f2 E q2) (\ E ->
    isProp-Pi (IsT (fl I ph W' f2)) (\ q2 -> C chi f q f2 E q2) (\ q2 -> pC chi f q f2 E q2)))))) ;

  isProp-BNat (I : Ob) (ph : Phi I) (B : BTy I ph) : isProp (BNat I ph B) =
    isProp-Pi Ob (\ W' -> (W : Ob) -> NatB I ph W' W (\ chi f q f2 E q2 -> Id (UU.U0 W') (UU.uAct W' W chi (B W f q)) (B W' f2 q2))) (\ W' ->
    isProp-Pi Ob (\ W -> NatB I ph W' W (\ chi f q f2 E q2 -> Id (UU.U0 W') (UU.uAct W' W chi (B W f q)) (B W' f2 q2))) (\ W ->
    isProp-NatB I ph W' W (\ chi f q f2 E q2 -> Id (UU.U0 W') (UU.uAct W' W chi (B W f q)) (B W' f2 q2))
      (\ chi f q f2 E q2 -> setU0 W' (UU.uAct W' W chi (B W f q)) (B W' f2 q2)))) ;

  isProp-AlNat (I : Ob) (A : UU.U0 I) (ph : Phi I) (B : BTy I ph) (bn : BNat I ph B) (al : AlTy I A ph B)
    : isProp (AlNat I A ph B bn al) =
    isProp-Pi Ob (\ W' -> (W : Ob) -> NatB I ph W' W (\ chi f q f2 E q2 -> (b : W0.Ix (UU.fib0 W (B W f q)))
        -> Id (W0.Ix (A.1.tob W' f2)) (al W' f2 q2 (UU.tactG W' W chi (B W f q) (B W' f2 q2) (bn W' W chi f q f2 E q2) b))
                                      (A.1.tact W' W chi f f2 E (al W f q b)))) (\ W' ->
    isProp-Pi Ob (\ W -> NatB I ph W' W (\ chi f q f2 E q2 -> (b : W0.Ix (UU.fib0 W (B W f q)))
        -> Id (W0.Ix (A.1.tob W' f2)) (al W' f2 q2 (UU.tactG W' W chi (B W f q) (B W' f2 q2) (bn W' W chi f q f2 E q2) b))
                                      (A.1.tact W' W chi f f2 E (al W f q b)))) (\ W ->
    isProp-NatB I ph W' W (\ chi f q f2 E q2 -> (b : W0.Ix (UU.fib0 W (B W f q)))
        -> Id (W0.Ix (A.1.tob W' f2)) (al W' f2 q2 (UU.tactG W' W chi (B W f q) (B W' f2 q2) (bn W' W chi f q f2 E q2) b))
                                      (A.1.tact W' W chi f f2 E (al W f q b)))
      (\ chi f q f2 E q2 -> isProp-Pi (W0.Ix (UU.fib0 W (B W f q)))
         (\ b -> Id (W0.Ix (A.1.tob W' f2)) (al W' f2 q2 (UU.tactG W' W chi (B W f q) (B W' f2 q2) (bn W' W chi f q f2 E q2) b))
                                           (A.1.tact W' W chi f f2 E (al W f q b)))
         (\ b -> W0.isSetIx (A.1.tob W' f2) _ _)))) ;

  opaque setU0 ; opaque isProp-BNat ; opaque isProp-AlNat ;

  ----------------------------------------------------------------------
  -- extensionality: data are equal when their codes are, and alpha agrees
  -- through the paths of codes (the naturality parts are propositions)

  trB (W : Ob) (F F' : UU.U0 W) (p : Id (UU.U0 W) F F') (b : W0.Ix (UU.fib0 W F)) : W0.Ix (UU.fib0 W F') =
    subst (UU.U0 W) (\ G -> W0.Ix (UU.fib0 W G)) F F' p b ;

  -- same A, same list
  bdExt (I : Ob) (A : UU.U0 I) (ph : Phi I) (bd bd' : BD I A ph)
    (PB : (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) -> Id (UU.U0 W) (bd.1 W f q) (bd'.1 W f q))
    (Pal : (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (b : W0.Ix (UU.fib0 W (bd.1 W f q)))
       -> Id (W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q b) (bd'.2.2.1 W f q (trB W (bd.1 W f q) (bd'.1 W f q) (PB W f q) b)))
    : Id (BD I A ph) bd bd' =
    idJ (BTy I ph) bd.1
      (\ B3 P3 -> (rest : (bn : BNat I ph B3) * AlD I A ph B3 bn)
         -> ((W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (p : Id (UU.U0 W) (bd.1 W f q) (B3 W f q)) (b : W0.Ix (UU.fib0 W (bd.1 W f q)))
             -> Id (W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q b) (rest.2.1 W f q (trB W (bd.1 W f q) (B3 W f q) p b)))
         -> Id (BD I A ph) bd (B3, rest))
      (\ rest H ->
         apH {(bn : BNat I ph bd.1) * AlD I A ph bd.1 bn} {BD I A ph} (\ z -> (bd.1, z))
           (idJ (BNat I ph bd.1) bd.2.1
              (\ bn3 P4 -> (ad : AlD I A ph bd.1 bn3)
                 -> ((W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (b : W0.Ix (UU.fib0 W (bd.1 W f q)))
                     -> Id (W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q b) (ad.1 W f q b))
                 -> Id ((bn : BNat I ph bd.1) * AlD I A ph bd.1 bn) bd.2 (bn3, ad))
              (\ ad H2 -> apH {AlD I A ph bd.1 bd.2.1} {(bn : BNat I ph bd.1) * AlD I A ph bd.1 bn} (\ z -> (bd.2.1, z))
                 (Sigma-eq (AlTy I A ph bd.1) (AlNat I A ph bd.1 bd.2.1) bd.2.2.1 ad.1 bd.2.2.2 ad.2
                    (funext Ob (\ W -> (f : Hom W I) (q : IsT (fl I ph W f)) -> W0.Ix (UU.fib0 W (bd.1 W f q)) -> W0.Ix (A.1.tob W f)) bd.2.2.1 ad.1 (\ W ->
                       funext (Hom W I) (\ f -> (q : IsT (fl I ph W f)) -> W0.Ix (UU.fib0 W (bd.1 W f q)) -> W0.Ix (A.1.tob W f)) (bd.2.2.1 W) (ad.1 W) (\ f ->
                       funext (IsT (fl I ph W f)) (\ q -> W0.Ix (UU.fib0 W (bd.1 W f q)) -> W0.Ix (A.1.tob W f)) (bd.2.2.1 W f) (ad.1 W f) (\ q ->
                       funext (W0.Ix (UU.fib0 W (bd.1 W f q))) (\ b -> W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q) (ad.1 W f q) (\ b -> H2 W f q b)))))
                    (isProp-AlNat I A ph bd.1 bd.2.1 ad.1)))
              rest.1 (isProp-BNat I ph bd.1 bd.2.1 rest.1) rest.2 (\ W f q b -> H W f q (refl (bd.1 W f q)) b)))
      bd'.1
      (funext Ob (\ W -> (f : Hom W I) (q : IsT (fl I ph W f)) -> UU.U0 W) bd.1 bd'.1 (\ W ->
         funext (Hom W I) (\ f -> (q : IsT (fl I ph W f)) -> UU.U0 W) (bd.1 W) (bd'.1 W) (\ f ->
         funext (IsT (fl I ph W f)) (\ q -> UU.U0 W) (bd.1 W f) (bd'.1 W f) (\ q -> PB W f q))))
      bd'.2
      (\ W f q p b -> transH (Pal W f q b)
         (apH {Id (UU.U0 W) (bd.1 W f q) (bd'.1 W f q)} {W0.Ix (A.1.tob W f)} (\ p' -> bd'.2.2.1 W f q (trB W (bd.1 W f q) (bd'.1 W f q) p' b)) {PB W f q} {p} (setU0 W (bd.1 W f q) (bd'.1 W f q) (PB W f q) p))) ;

  trA (I : Ob) (A A' : UU.U0 I) (P : Id (UU.U0 I) A A') (W : Ob) (f : Hom W I) (a0 : W0.Ix (A.1.tob W f)) : W0.Ix (A'.1.tob W f) =
    subst (UU.U0 I) (\ F -> W0.Ix (F.1.tob W f)) A A' P a0 ;

  -- the general case
  gdExt (I : Ob) (A A' : UU.U0 I) (PA : Id (UU.U0 I) A A') (ph ph' : Phi I)
    (Pph : Id (Phi I) ph ph') (bd : BD I A ph) (bd' : BD I A' ph')
    (PB : (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (q' : IsT (fl I ph' W f)) -> Id (UU.U0 W) (bd.1 W f q) (bd'.1 W f q'))
    (Pal : (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (q' : IsT (fl I ph' W f)) (b : W0.Ix (UU.fib0 W (bd.1 W f q)))
       -> Id (W0.Ix (A'.1.tob W f)) (trA I A A' PA W f (bd.2.2.1 W f q b)) (bd'.2.2.1 W f q' (trB W (bd.1 W f q) (bd'.1 W f q') (PB W f q q') b)))
    : Id (GD0 I) (A, (ph, bd)) (A', (ph', bd')) =
    idJ (UU.U0 I) A
      (\ A2 PA2 -> (bd2 : BD I A2 ph')
         -> (PB2 : (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (q' : IsT (fl I ph' W f)) -> Id (UU.U0 W) (bd.1 W f q) (bd2.1 W f q'))
         -> ((W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (q' : IsT (fl I ph' W f)) (b : W0.Ix (UU.fib0 W (bd.1 W f q)))
             -> Id (W0.Ix (A2.1.tob W f)) (trA I A A2 PA2 W f (bd.2.2.1 W f q b)) (bd2.2.2.1 W f q' (trB W (bd.1 W f q) (bd2.1 W f q') (PB2 W f q q') b)))
         -> Id (GD0 I) (A, (ph, bd)) (A2, (ph', bd2)))
      (\ bd2 PB2 Pal2 ->
         apH {(ph2 : Phi I) * BD I A ph2} {GD0 I} (\ z -> (A, z))
           (idJ (Phi I) ph
              (\ ph2 P2 -> (bd3 : BD I A ph2)
                 -> (PB3 : (W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (q' : IsT (fl I ph2 W f)) -> Id (UU.U0 W) (bd.1 W f q) (bd3.1 W f q'))
                 -> ((W : Ob) (f : Hom W I) (q : IsT (fl I ph W f)) (q' : IsT (fl I ph2 W f)) (b : W0.Ix (UU.fib0 W (bd.1 W f q)))
                     -> Id (W0.Ix (A.1.tob W f)) (bd.2.2.1 W f q b) (bd3.2.2.1 W f q' (trB W (bd.1 W f q) (bd3.1 W f q') (PB3 W f q q') b)))
                 -> Id ((ph2' : Phi I) * BD I A ph2') (ph, bd) (ph2, bd3))
              (\ bd3 PB3 Pal3 -> apH {BD I A ph} {(ph2 : Phi I) * BD I A ph2} (\ z -> (ph, z))
                 (bdExt I A ph bd bd3 (\ W f q -> PB3 W f q q) (\ W f q b -> Pal3 W f q q b)))
              ph' Pph bd2 PB2 Pal2))
      A' PA bd' PB Pal ;

  opaque bdExt ; opaque gdExt ;

  ----------------------------------------------------------------------
  -- B and alpha at equal maps

  Bhom (I : Ob) (ph : Phi I) (B : BTy I ph) (W : Ob) (f1 f2 : Hom W I) (E : Id (Hom W I) f1 f2)
    (q1 : IsT (fl I ph W f1)) (q2 : IsT (fl I ph W f2)) : Id (UU.U0 W) (B W f1 q1) (B W f2 q2) =
    idJ (Hom W I) f1 (\ f3 E3 -> (q3 : IsT (fl I ph W f3)) -> Id (UU.U0 W) (B W f1 q1) (B W f3 q3))
      (\ q3 -> apH (B W f1) (isProp-IsT' (fl I ph W f1) q1 q3)) f2 E q2 ;

  alHom (I : Ob) (A : UU.U0 I) (ph : Phi I) (bd : BD I A ph) (W : Ob) (f1 f2 : Hom W I) (E : Id (Hom W I) f1 f2)
    (q1 : IsT (fl I ph W f1)) (q2 : IsT (fl I ph W f2)) (b : W0.Ix (UU.fib0 W (bd.1 W f1 q1)))
    : Id (W0.Ix (A.1.tob W f2)) (subst (Hom W I) (\ k -> W0.Ix (A.1.tob W k)) f1 f2 E (bd.2.2.1 W f1 q1 b))
                                (bd.2.2.1 W f2 q2 (trB W (bd.1 W f1 q1) (bd.1 W f2 q2) (Bhom I ph bd.1 W f1 f2 E q1 q2) b)) =
    idJ (Hom W I) f1
      (\ f3 E3 -> (q3 : IsT (fl I ph W f3))
         -> Id (W0.Ix (A.1.tob W f3)) (subst (Hom W I) (\ k -> W0.Ix (A.1.tob W k)) f1 f3 E3 (bd.2.2.1 W f1 q1 b))
                                      (bd.2.2.1 W f3 q3 (trB W (bd.1 W f1 q1) (bd.1 W f3 q3) (Bhom I ph bd.1 W f1 f3 E3 q1 q3) b)))
      (\ q3 -> idJ (IsT (fl I ph W f1)) q1
         (\ q4 P4 -> Id (W0.Ix (A.1.tob W f1)) (bd.2.2.1 W f1 q1 b)
                                               (bd.2.2.1 W f1 q4 (trB W (bd.1 W f1 q1) (bd.1 W f1 q4) (apH (bd.1 W f1) P4) b)))
         (refl (bd.2.2.1 W f1 q1 b)) q3 (isProp-IsT' (fl I ph W f1) q1 q3))
      f2 E q2 ;

  opaque Bhom ; opaque alHom ;

  ----------------------------------------------------------------------
  -- the laws of the action

  gd-id (I : Ob) (d : GD0 I) : Id (GD0 I) (gdAct I I (idH I) d) d =
    gdExt I (UU.uAct I I (idH I) d.1) d.1 (UU.uAct-id I d.1) (pre I I (idH I) d.2.1) d.2.1
      (pre-id I d.2.1) (gdAct I I (idH I) d).2.2 d.2.2
      (\ W f q q' -> Bhom I d.2.1 d.2.2.1 W (compH W I I (idH I) f) f (comp-idl W I f) (fl-pre I I (idH I) d.2.1 W f q) q')
      (\ W f q q' b -> transH
         (transH (subst-ap (UU.U0 I) W0.V (\ F -> F.1.tob W f) (\ v -> W0.Ix v) (UU.uAct I I (idH I) d.1) d.1 (UU.uAct-id I d.1)
                    (d.2.2.2.2.1 W (compH W I I (idH I) f) (fl-pre I I (idH I) d.2.1 W f q) b))
                 (UU.fib-move (Hom W I) (d.1.1.tob W) (compH W I I (idH I) f) f (comp-idl W I f)
                    (ap (UU.U0 I) W0.V (\ F -> F.1.tob W f) (UU.uAct I I (idH I) d.1) d.1 (UU.uAct-id I d.1))
                    (d.2.2.2.2.1 W (compH W I I (idH I) f) (fl-pre I I (idH I) d.2.1 W f q) b)))
         (alHom I d.1 d.2.1 d.2.2 W (compH W I I (idH I) f) f (comp-idl W I f) (fl-pre I I (idH I) d.2.1 W f q) q' b)) ;

  gd-o (K J I : Ob) (h : Hom J I) (k : Hom K J) (d : GD0 I)
    : Id (GD0 K) (gdAct K I (compH K J I h k) d) (gdAct K J k (gdAct J I h d)) =
    gdExt K (UU.uAct K I (compH K J I h k) d.1) (UU.uAct K J k (UU.uAct J I h d.1)) (UU.uAct-o K J I h k d.1) 
      (pre K I (compH K J I h k) d.2.1) (pre K J k (pre J I h d.2.1))
      (symH (pre-comp K J I k h d.2.1))
      (gdAct K I (compH K J I h k) d).2.2 (gdAct K J k (gdAct J I h d)).2.2
      (\ W g q q' -> Bhom I d.2.1 d.2.2.1 W (compH W K I (compH K J I h k) g) (compH W J I h (compH W K J k g))
         (comp-assoc W K J I h k g) (fl-pre K I (compH K J I h k) d.2.1 W g q) (fl-pre J I h d.2.1 W (compH W K J k g) (fl-pre K J k (pre J I h d.2.1) W g q')))
      (\ W g q q' b -> transH
         (transH (subst-ap (UU.U0 K) W0.V (\ F -> F.1.tob W g) (\ v -> W0.Ix v)
                    (UU.uAct K I (compH K J I h k) d.1) (UU.uAct K J k (UU.uAct J I h d.1)) (UU.uAct-o K J I h k d.1)
                    (d.2.2.2.2.1 W (compH W K I (compH K J I h k) g) (fl-pre K I (compH K J I h k) d.2.1 W g q) b))
                 (UU.fib-move (Hom W I) (d.1.1.tob W) (compH W K I (compH K J I h k) g) (compH W J I h (compH W K J k g))
                    (comp-assoc W K J I h k g)
                    (ap (UU.U0 K) W0.V (\ F -> F.1.tob W g) (UU.uAct K I (compH K J I h k) d.1) (UU.uAct K J k (UU.uAct J I h d.1))
                       (UU.uAct-o K J I h k d.1))
                    (d.2.2.2.2.1 W (compH W K I (compH K J I h k) g) (fl-pre K I (compH K J I h k) d.2.1 W g q) b)))
         (alHom I d.1 d.2.1 d.2.2 W (compH W K I (compH K J I h k) g) (compH W J I h (compH W K J k g))
            (comp-assoc W K J I h k g) (fl-pre K I (compH K J I h k) d.2.1 W g q) (fl-pre J I h d.2.1 W (compH W K J k g) (fl-pre K J k (pre J I h d.2.1) W g q')) b)) ;

  opaque gd-id ; opaque gd-o ;

  ----------------------------------------------------------------------
  -- the code, and the presheaf of glue data

  encB (I : Ob) (ph : Phi I) : Enc (BTy I ph) =
    encPi0 Ob (\ W -> (f : Hom W I) (q : IsT (fl I ph W f)) -> UU.U0 W) CEnc.encOb (\ W ->
    encPi0 (Hom W I) (\ f -> (q : IsT (fl I ph W f)) -> UU.U0 W) (CEnc.encHom W I) (\ f ->
    encPi0 (IsT (fl I ph W f)) (\ q -> UU.U0 W) (encProp (IsT (fl I ph W f)) (isProp-IsT' (fl I ph W f))) (\ q ->
      UU.encU W))) ;

  encAl (I : Ob) (A : UU.U0 I) (ph : Phi I) (B : BTy I ph) : Enc (AlTy I A ph B) =
    encPi0 Ob (\ W -> (f : Hom W I) (q : IsT (fl I ph W f)) -> W0.Ix (UU.fib0 W (B W f q)) -> W0.Ix (A.1.tob W f)) CEnc.encOb (\ W ->
    encPi0 (Hom W I) (\ f -> (q : IsT (fl I ph W f)) -> W0.Ix (UU.fib0 W (B W f q)) -> W0.Ix (A.1.tob W f)) (CEnc.encHom W I) (\ f ->
    encPi0 (IsT (fl I ph W f)) (\ q -> W0.Ix (UU.fib0 W (B W f q)) -> W0.Ix (A.1.tob W f))
      (encProp (IsT (fl I ph W f)) (isProp-IsT' (fl I ph W f))) (\ q ->
    encPi0 (W0.Ix (UU.fib0 W (B W f q))) (\ b -> W0.Ix (A.1.tob W f)) (encIx0 (UU.fib0 W (B W f q))) (\ b ->
      encIx0 (A.1.tob W f))))) ;

  encBD (I : Ob) (A : UU.U0 I) (ph : Phi I) : Enc (BD I A ph) =
    encSig (BTy I ph) (\ B -> (bn : BNat I ph B) * AlD I A ph B bn) (encB I ph) (\ B ->
    encSig (BNat I ph B) (\ bn -> AlD I A ph B bn) (encProp (BNat I ph B) (isProp-BNat I ph B)) (\ bn ->
    encSig (AlTy I A ph B) (\ al -> AlNat I A ph B bn al) (encAl I A ph B) (\ al ->
      encProp (AlNat I A ph B bn al) (isProp-AlNat I A ph B bn al)))) ;

  encGD (I : Ob) : Enc (GD0 I) =
    encSig (UU.U0 I) (\ A -> (ph : Phi I) * BD I A ph) (UU.encU I) (\ A ->
    encSig (Phi I) (\ ph -> BD I A ph) (CEnc.encPhi I) (\ ph ->
      encBD I A ph)) ;

  encGDf (I : Ob) (d : GD0 I) : V1.V = (encGD I).1 d ;

  encGDinj (I : Ob) : V1.Inj (GD0 I) (encGDf I) = (encGD I).2 ;

  opaque encGDf ; opaque encGDinj ;

  codeGD (I : Ob) : V1.V = V1.mkV (GD0 I) (encGDf I) (encGDinj I) ;

  GDCtx : L1.PCtx = new L1.PCtx[codeGD, gdAct, gd-id, gd-o] ;
} ;
