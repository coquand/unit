-- CDStageD.seg (L8, Delta): seg/model DStageD.seg ported (module names only).  Was: the stages of the filling (FillStage.build in line form).
--
--   St0             stage 0: Case 1 or the prism of [0] (no boundary)
--   Step            stage N'+1 from stage N' (its filler Fp, its sides,
--                   its codimension-2 agreement): the filler F, with
--   sides           F agrees with every side (Case 2: through the faces)
--   fp              F restricted to the face y is Fp of the face problem
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
open CDCapBase[a] ;
module DPm = CDPrism[a] ;

-- the face dl y misses y
dl-miss (W N' y : Nat) (g : Hom (lin W) (lin N')) : IsT (missB W (suc N') (compH (lin W) (lin N') (lin (suc N')) (dl N' y) g) y) =
  fa-i W (\ v -> not (eqN (valT W (suc N') (compH (lin W) (lin N') (lin (suc N')) (dl N' y) g) v) y))
    (\ v hv -> substH (\ x -> IsT (not (eqN x y)))
                 (symH (transH (DPm.valT-comp W N' (suc N') (dl N' y) g v hv)
                               (apH vnum (symH (valT-tree N' (suc N') (dl N' y) (valT W N' g v) (valT-range W N' g v))))))
                 (skip-miss y (valT W N' g v))) ;

-- dgH y (dl y g) = g
dgdl (W N' y : Nat) (hy : IsT (leb y (suc N'))) (g : Hom (lin W) (lin N'))
  : Id (Hom (lin W) (lin N')) (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) (compH (lin W) (lin N') (lin (suc N')) (dl N' y) g)) g =
  transH (symH (comp-assoc (lin W) (lin N') (lin (suc N')) (lin N') (dgH N' y) (dl N' y) g))
    (transH (apH (\ k -> compH (lin W) (lin N') (lin N') k g)
               (hom-eq (lin N') (lin N') (compH (lin N') (lin (suc N')) (lin N') (dgH N' y) (dl N' y)) (idH (lin N')) (pw-dg-dl N' y hy)))
            (comp-idl (lin W) (lin N') g)) ;

module SD (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))  {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;
  module SBm = CDStageB[a, lz].SB[G, A, e, eN, eE] ;
  module SCm = CDStageC[a, lz].SC[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;

  Sides (N : Nat) (F : FillTy N) : U lz =
    (b : Prob N) (W : Nat) (f : Hom (lin W) (lin N)) (i : DB.Lands W N b.2.pQ f)
    -> Id (KA.TS.EI W) (KA.TS.E.act W N f (fillE N F b)) (b.2.pv W f i) ;

  FPr (N' : Nat) (F : FillTy (suc N')) (Fp : FillTy N') : U lz =
    (b : Prob (suc N')) (y : Nat) (hy : IsT (leb y (suc N')))
    -> Id (KA.TS.EI N') (KA.TS.E.act N' (suc N') (dl N' y) (fillE (suc N') F b)) (fillE N' Fp (resP N' (suc N') (dl N' y) b)) ;

  -- the lines of the restriction of the Case 2 filler
  c2-act (N : Nat) (C2 : (b : Prob N) -> KA.TS.T N b.1) (b : Prob N) (W : Nat) (f : Hom (lin W) (lin N)) (V : Nat) (g : Hom (lin V) (lin W)) (j : Hom (lin V) Iv)
    : Id (TA.EI V) (lv W (KA.TS.E.act W N f (b.1, C2 b)) V g j) (lv N (b.1, C2 b) V (compH (lin V) (lin W) (lin N) f g) j) =
    lv-act W N f (b.1, C2 b) V g j ;

  -- the line of a side element at f, read at (g , j), is the side at f g read at (id , j)
  side-lv (N : Nat) (b : Prob N) (W : Nat) (f : Hom (lin W) (lin N)) (i : DB.Lands W N b.2.pQ f)
    (V : Nat) (g : Hom (lin V) (lin W)) (j : Hom (lin V) Iv)
    : Id (TA.EI V) (lv V (b.2.pv V (compH (lin V) (lin W) (lin N) f g) (DB.lands-comp V W N b.2.pQ f g i)) V (idH (lin V)) j)
                   (lv W (b.2.pv W f i) V g j) =
    transH (apH (\ u -> lv V u V (idH (lin V)) j) (symH (b.2.pnat V W g f i (DB.lands-comp V W N b.2.pQ f g i))))
      (transH (lv-act V W g (b.2.pv W f i) V (idH (lin V)) j)
              (apH (\ k -> lv W (b.2.pv W f i) V k j) (comp-idr (lin V) (lin W) g))) ;

  ----------------------------------------------------------------------
  -- stage 0

  module St0 {
    module S = SCm.Stage[zero, \ b -> SBm.Bd0[b].L0, \ b W f j s l -> refl (SBm.Lines[zero, b].lidV W f)] ;

    F : FillTy zero = S.fillF ;

    sidesC (b : Prob zero) : (c : Bool) (ff : Id Bool (SCm.fullB zero b) c) (W : Nat) (f : Hom (lin W) (lin zero))
      (i : DB.Lands W zero b.2.pQ f) -> Id (KA.TS.EI W) (KA.TS.E.act W zero f (b.1, S.fillC b c ff)) (b.2.pv W f i) = split {
      true -> \ ff W f i -> S.side-c1 b ff W f i ;
      false -> \ k W f i -> absurd _ (SBm.Bd0[b].nobd W f (CDSurj[a].in-bd zero W b.2.pQ f i k)) } ;

    sides : Sides zero F = \ b -> sidesC b (SCm.fullB zero b) (refl (SCm.fullB zero b)) ;
  } ;

  ----------------------------------------------------------------------
  -- stage N'+1 from stage N'

  module Step (N' : Nat) (Fp : FillTy N') (sidesP : Sides N' Fp) (cmp2 : SBm.Cmp2 N' Fp) {
    module S = SCm.Stage[suc N', \ b -> SBm.Bd[N', Fp, cmp2, b].L0, \ b -> SBm.Bd[N', Fp, cmp2, b].L0-lid] ;

    F : FillTy (suc N') = S.fillF ;

    u (b : Prob (suc N')) (y : Nat) : KA.TS.EI N' = fillE N' Fp (resP N' (suc N') (dl N' y) b) ;

    -- in Case 2 the filler, read at a point of the boundary missing y, is the filler of the face y
    c2-face (b : Prob (suc N')) (y : Nat) (hy : IsT (leb y (suc N'))) (W : Nat) (f : Hom (lin W) (lin (suc N'))) (j : Hom (lin W) Iv)
      (m : IsT (missB W (suc N') f y))
      : Id (TA.EI W) (lv (suc N') (b.1, S.c2 b) W f j) (lv N' (u b y) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) f) j) =
      transH (S.c2-lv b W f j)
        (transH (tot-S0 (suc N') b.1.1.1 b.1.1.2 SBm.Bd[N', Fp, cmp2, b].L0 W f j
                   (or-l (bdB (suc N') W f) (lidB eN W j) (ex-i (suc N') (\ y' -> missB W (suc N') f y') y hy m)))
                (SBm.Bd[N', Fp, cmp2, b].L0-face y hy W f j
                   (or-l (bdB (suc N') W f) (lidB eN W j) (ex-i (suc N') (\ y' -> missB W (suc N') f y') y hy m)) m)) ;

    --------------------------------------------------------------------
    -- Case 2 agrees with every side, through a face

    side-c2 (b : Prob (suc N')) (k : Id Bool (SCm.fullB (suc N') b) false)
      (W : Nat) (f : Hom (lin W) (lin (suc N'))) (i : DB.Lands W (suc N') b.2.pQ f)
      : Id (KA.TS.EI W) (KA.TS.E.act W (suc N') f (b.1, S.c2 b)) (b.2.pv W f i) =
      ts-ext W (KA.TS.E.act W (suc N') f (b.1, S.c2 b)) (b.2.pv W f i) (symH (b.2.ppt W f i))
        (\ V g j -> lineEq V g j
           (ex-e (suc N') (\ y -> missB V (suc N') (compH (lin V) (lin W) (lin (suc N')) f g) y)
              (CDSurj[a].in-bd (suc N') V b.2.pQ (compH (lin V) (lin W) (lin (suc N')) f g) (DB.lands-comp V W (suc N') b.2.pQ f g i) k)))
       where {
         fg (V : Nat) (g : Hom (lin V) (lin W)) : Hom (lin V) (lin (suc N')) = compH (lin V) (lin W) (lin (suc N')) f g ;
         ifg (V : Nat) (g : Hom (lin V) (lin W)) : DB.Lands V (suc N') b.2.pQ (fg V g) = DB.lands-comp V W (suc N') b.2.pQ f g i ;
         lineEq (V : Nat) (g : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) (w : (y : Nat) * (IsT (leb y (suc N')) * IsT (missB V (suc N') (fg V g) y)))
           : Id (TA.EI V) (lv W (KA.TS.E.act W (suc N') f (b.1, S.c2 b)) V g j) (lv W (b.2.pv W f i) V g j) =
           calc (TA.EI V) {
               lv W (KA.TS.E.act W (suc N') f (b.1, S.c2 b)) V g j
             =< c2-act (suc N') S.c2 b W f V g j >
               lv (suc N') (b.1, S.c2 b) V (fg V g) j
             =< c2-face b w.1 w.2.1 V (fg V g) j w.2.2 >
               lv N' (u b w.1) V (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g)) j
             =< apH (\ k' -> lv N' (u b w.1) V k' j) (symH (comp-idr (lin V) (lin N') (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g)))) >
               lv N' (u b w.1) V (compH (lin V) (lin V) (lin N') (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g)) (idH (lin V))) j
             =< symH (lv-act V N' (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g)) (u b w.1) V (idH (lin V)) j) >
               lv V (KA.TS.E.act V N' (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g)) (u b w.1)) V (idH (lin V)) j
             =< apH {KA.TS.EI V} {TA.EI V} (\ z -> lv V z V (idH (lin V)) j)
                  (sidesP (resP N' (suc N') (dl N' w.1) b) V (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g))
                     (DB.pre-lands V N' (suc N') (dl N' w.1) b.2.pQ (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g))
                        (DB.lands-eq V (suc N') b.2.pQ (fg V g) _ (symH (SBm.Bd[N', Fp, cmp2, b].Fc.fac-eq w.1 w.2.1 V (fg V g) w.2.2)) (ifg V g)))) >
               lv V (b.2.pv V (compH (lin V) (lin N') (lin (suc N')) (dl N' w.1) (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g)))
                       (DB.lands-pre V N' (suc N') (dl N' w.1) b.2.pQ (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g))
                          (DB.pre-lands V N' (suc N') (dl N' w.1) b.2.pQ (compH (lin V) (lin (suc N')) (lin N') (dgH N' w.1) (fg V g))
                             (DB.lands-eq V (suc N') b.2.pQ (fg V g) _ (symH (SBm.Bd[N', Fp, cmp2, b].Fc.fac-eq w.1 w.2.1 V (fg V g) w.2.2)) (ifg V g)))))
                    V (idH (lin V)) j
             =< apH {KA.TS.EI V} {TA.EI V} (\ z -> lv V z V (idH (lin V)) j)
                  (KA.PT.pv-hom (suc N') b.1 b.2 V _ (fg V g) (SBm.Bd[N', Fp, cmp2, b].Fc.fac-eq w.1 w.2.1 V (fg V g) w.2.2) _ (ifg V g)) >
               lv V (b.2.pv V (fg V g) (ifg V g)) V (idH (lin V)) j
             =< side-lv (suc N') b W f i V g j >
               lv W (b.2.pv W f i) V g j } ; } ;

    sidesC (b : Prob (suc N')) : (c : Bool) (ff : Id Bool (SCm.fullB (suc N') b) c) (W : Nat) (f : Hom (lin W) (lin (suc N')))
      (i : DB.Lands W (suc N') b.2.pQ f) -> Id (KA.TS.EI W) (KA.TS.E.act W (suc N') f (b.1, S.fillC b c ff)) (b.2.pv W f i) = split {
      true -> \ ff W f i -> S.side-c1 b ff W f i ;
      false -> \ k W f i -> side-c2 b k W f i } ;

    sides : Sides (suc N') F = \ b -> sidesC b (SCm.fullB (suc N') b) (refl (SCm.fullB (suc N') b)) ;
  } ;
} ;
