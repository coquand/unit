-- CDUnion.seg (L8, Delta): seg/model DUnion.seg ported (module names only).  Was: the union of finitely many partial lines on prism sieves,
-- pairwise compatible: one partial line on the union of the sieves (the
-- value at a point is read in the first sieve found; any other sieve
-- containing the point gives the same value: un-val).
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CDeltaNat[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;

-- the union of n prism sieves
unionN (N n : Nat) (Ss : Fin n -> DPS.PrS N) : DPS.PrS N =
  (\ W f j -> existsF n (\ l hl -> (Ss (l, hl)).1 W f j),
   \ W' W g f j s ->
     exF-i n (\ l hl -> (Ss (l, hl)).1 W' (compH (lin W') (lin W) (lin N) f g) (compH (lin W') (lin W) Iv j g))
       (exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).1 (exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).2.1
       ((Ss ((exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).1, (exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).2.1)).2 W' W g f j
          (exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).2.2)) ;

un-in (N n : Nat) (Ss : Fin n -> DPS.PrS N) (l : Fin n) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
  (t : IsT ((Ss l).1 W f j)) : IsT ((unionN N n Ss).1 W f j) =
  exF-i n (\ l' hl -> (Ss (l', hl)).1 W f j) l.1 l.2 t ;

module UN (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (N : Nat)
  (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
  (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (n : Nat) (Ss : Fin n -> DPS.PrS N) (Ls : (l : Fin n) -> DGm.PL[G, A, N, gt, gn].PLine[Ss l])
  (cmp : (l l' : Fin n) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((Ss l).1 W f j)) (t' : IsT ((Ss l').1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) ((Ls l).v W f j t) ((Ls l').v W f j t')) {
  module P = DGm.PL[G, A, N, gt, gn] ;
  open DB.GPre[lz].TyL[G, A] ;

  S : DPS.PrS N = unionN N n Ss ;

  pick (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) : Fin n =
    ((exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).1, (exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).2.1) ;

  pickIn (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) : IsT ((Ss (pick W f j s)).1 W f j) =
    (exF-e n (\ l hl -> (Ss (l, hl)).1 W f j) s).2.2 ;

  v (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) : EI W =
    (Ls (pick W f j s)).v W f j (pickIn W f j s) ;

  -- the value is that of any sieve containing the point
  un-val (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) (l : Fin n) (t : IsT ((Ss l).1 W f j))
    : Id (EI W) (v W f j s) ((Ls l).v W f j t) = cmp (pick W f j s) l W f j (pickIn W f j s) t ;

  opaque v ;

  vpt (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) : Id (Pt W) (v W f j s).1 (gt W f j) =
    transH (apH (\ z -> z.1) (un-val W f j s (pick W f j s) (pickIn W f j s))) ((Ls (pick W f j s)).vpt W f j (pickIn W f j s)) ;

  vnat (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j))
    (s' : IsT (S.1 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
    : Id (EI V) (E.act V W g (v W f j s)) (v V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s') =
    transH (apH (E.act V W g) (un-val W f j s (pick W f j s) (pickIn W f j s)))
      (transH ((Ls (pick W f j s)).vnat V W g f j (pickIn W f j s) ((Ss (pick W f j s)).2 V W g f j (pickIn W f j s)))
              (symH (un-val V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' (pick W f j s)
                       ((Ss (pick W f j s)).2 V W g f j (pickIn W f j s))))) ;

  L : P.PLine[S] = new P.PLine[S, v, vpt, vnat] ;
} ;
