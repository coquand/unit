-- A presheaf is determined by its object codes and restriction maps.
Objects : U l+ = Ob -> W.V ;
Actions (o : Objects) : U l =
  (J I : Ob) -> Hom J I -> W.Ix (o I) -> W.Ix (o J) ;

module Laws (o : Objects) (act : Actions o) {
  IdAt (I : Ob) (x : W.Ix (o I)) : U l =
    Id (W.Ix (o I)) (act I I (idC I) x) x ;
  CompAt (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : W.Ix (o I)) : U l =
    Id (W.Ix (o K)) (act K I (oC K J I f g) x) (act K J g (act J I f x)) ;

  Identity : U l = (I : Ob) (x : W.Ix (o I)) -> IdAt I x ;
  Composition : U l =
    (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : W.Ix (o I)) -> CompAt K J I f g x ;

  id-prop : isProp Identity =
    isProp-Pi Ob (\ I -> (x : W.Ix (o I)) -> IdAt I x) (\ I ->
      isProp-Pi (W.Ix (o I)) (\ x -> IdAt I x) (\ x -> W.isSetIx (o I) (act I I (idC I) x) x)) ;

  comp-prop : isProp Composition =
    isProp-Pi Ob (\ K -> (J I : Ob) (f : Hom J I) (g : Hom K J) (x : W.Ix (o I)) -> CompAt K J I f g x) (\ K ->
    isProp-Pi Ob (\ J -> (I : Ob) (f : Hom J I) (g : Hom K J) (x : W.Ix (o I)) -> CompAt K J I f g x) (\ J ->
    isProp-Pi Ob (\ I -> (f : Hom J I) (g : Hom K J) (x : W.Ix (o I)) -> CompAt K J I f g x) (\ I ->
    isProp-Pi (Hom J I) (\ f -> (g : Hom K J) (x : W.Ix (o I)) -> CompAt K J I f g x) (\ f ->
    isProp-Pi (Hom K J) (\ g -> (x : W.Ix (o I)) -> CompAt K J I f g x) (\ g ->
    isProp-Pi (W.Ix (o I)) (\ x -> CompAt K J I f g x) (\ x ->
      W.isSetIx (o K) (act K I (oC K J I f g) x) (act K J g (act J I f x)))))))) ;
} ;

LawsOf (o : Objects) (act : Actions o) : U l =
  Laws[o, act].Identity * Laws[o, act].Composition ;

actions-set (o : Objects) : isSet (Actions o) =
  isSet-Pi Ob (\ J -> (I : Ob) -> Hom J I -> W.Ix (o I) -> W.Ix (o J)) (\ J ->
  isSet-Pi Ob (\ I -> Hom J I -> W.Ix (o I) -> W.Ix (o J)) (\ I ->
  isSet-Pi (Hom J I) (\ _ -> W.Ix (o I) -> W.Ix (o J)) (\ _ ->
  isSet-Pi (W.Ix (o I)) (\ _ -> W.Ix (o J)) (\ _ -> W.isSetIx (o J))))) ;

Data : U l+ = (o : Objects) * (act : Actions o) * LawsOf o act ;

pack (G : PCtx) : Data = (G.ob, G.act, (G.act-id, G.act-o)) ;
unpack (d : Data) : PCtx = new PCtx[d.1, d.2.1, d.2.2.1, d.2.2.2] ;
round : (G : PCtx) -> Id PCtx (unpack (pack G)) G =
  split { PCtx o act hi ho -> refl (unpack (o, act, (hi, ho))) } ;

isSet-PCtx : isSet PCtx =
  isSet-retract PCtx Data pack unpack round
    (isSet-Sigma Objects (\ o -> (act : Actions o) * LawsOf o act)
      (isSet-Pi Ob (\ _ -> W.V) (\ _ -> W.isSetV))
      (\ o -> isSet-Sigma (Actions o) (\ act -> LawsOf o act) (actions-set o) (\ act ->
        prop-to-set (LawsOf o act) (isProp-Sigma Laws[o, act].Identity (\ _ -> Laws[o, act].Composition)
          Laws[o, act].id-prop (\ _ -> Laws[o, act].comp-prop))))) ;
opaque isSet-PCtx ;
