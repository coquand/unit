-- The inclusion on codes lifts each fibre and retains its horn operation.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module B = CDUniverseBase[a] ;
module P = B.DB.GPre[a] ;
module Q = B.Q1 ;
module U0 = B.DC.DU ;
module U1 = B.Univ ;
module Y0 = B.DB.GYon[a] ;
module Y1 = B.High.GYon[a+] ;
module V0 = V[a] ;
module V1 = V[a+] ;
module VL = VLift[a, a+] ;
open SmallCat[a].Homs[B.DB.obV, B.DB.homV] ;

-- The code of the same set at the higher level is the lift of its tree.
transparent CBase.CB.CSmall.smallF ;
lift-tree : (m : V0.M) (p : V0.isIt m) -> Id V1.M (B.Lift.smallC (m, p)).1 (VL.liftM m) =
  split { sup X f -> \ p -> refl (sup X (\ x -> VL.liftM (f x))) } ;
opaque CBase.CB.CSmall.smallF ;

lift-inj (v w : V0.V) (p : Id V1.V (B.Lift.smallC v) (B.Lift.smallC w)) : Id V0.V v w =
  Sigma-eq V0.M (\ m -> V0.isIt m) v.1 w.1 v.2 w.2
    (VL.liftV-inj v w (transH (symH (lift-tree v.1 v.2)) (transH (apH (\ z -> z.1) p) (lift-tree w.1 w.2))))
    (V0.isProp-isIt w.1) ;

opaque lift-inj ;

L (X : Nat) (A : P.PS.PTy[Y0.yP X]) : Q.PS.PTy[Y1.yP X] =
  new Q.PS.PTy[Y1.yP X, \ J x -> B.Lift.smallC (A.tob J x), A.tact, A.tact-id, A.tact-o] ;

op (X : Nat) (A : P.PS.PTy[Y0.yP X]) (h : B.DC.CL.Cl (Y0.yP X) A)
  : B.Cl.Cl (Y1.yP X) (L X A) = h ;

lower-op (X : Nat) (A : P.PS.PTy[Y0.yP X]) (h : B.Cl.Cl (Y1.yP X) (L X A))
  : B.DC.CL.Cl (Y0.yP X) A = h ;

inc (X : Nat) (F : U0.U0 X) : U1.U0 X = (L X F.1, op X F.1 F.2) ;

module Restrict (J I : Nat) (f : Hom J I) (F : U0.U0 I) {
  left : U1.U0 J = inc J (U0.uAct J I f F) ;
  right : U1.U0 J = U1.uAct J I f (inc I F) ;
  module O = B.High.COp[a+].OpExtE[B.DC.HIx, \ i -> B.DC.hOk i, B.DC.hOb, B.DC.hS, Y1.yP J] ;
  module H = B.DB.COp[a].OpS[B.DC.HIx, B.DC.hOk, B.DC.hOb, B.DC.hS, Y0.yP I, F.1] ;

  law : Id (U1.U0 J) left right =
    O.isOpExt left.1 left.2 (right.1.tact, (right.1.tact-id, right.1.tact-o))
      (\ K N g x y e z -> P.PS.tact-irr (Y0.yP I) F.1 K N g ((Y0.yH J I f).nt N x) ((Y0.yH J I f).nt K y)
        (P.PS.ntEq (Y0.yP J) (Y0.yP I) (Y0.yH J I f) K N g x y e)
        (Q.PS.ntEq (Y1.yP J) (Y1.yP I) (Y1.yH J I f) K N g x y e) z)
      right.2
      (\ i o rho v pp p q -> classifier i o rho v pp p q)
   where {
    classifier (i : B.DC.HIx) (o : B.DC.hOk i) (rho : Hom (B.DC.hOb i) J)
      (v : B.High.COp[a+].OpS[B.DC.HIx, \ n -> B.DC.hOk n, B.DC.hOb, B.DC.hS, Y1.yP J, left.1].PT.PvTy (B.DC.hOb i) (B.DC.hS i))
      (pp : B.High.COp[a+].OpS[B.DC.HIx, \ n -> B.DC.hOk n, B.DC.hOb, B.DC.hS, Y1.yP J, left.1].PT.PptTy (B.DC.hOb i) rho (B.DC.hS i) v)
      (p : B.High.COp[a+].OpS[B.DC.HIx, \ n -> B.DC.hOk n, B.DC.hOb, B.DC.hS, Y1.yP J, left.1].PT.PnTy (B.DC.hOb i) (B.DC.hS i) v)
      (q : B.High.COp[a+].OpS[B.DC.HIx, \ n -> B.DC.hOk n, B.DC.hOb, B.DC.hS, Y1.yP J, right.1].PT.PnTy (B.DC.hOb i) (B.DC.hS i) v)
      : Id (V1.Ix (left.1.tob (B.DC.hOb i) rho)) (left.2 i o rho (v, (pp, p))).1 (right.2 i o rho (v, (pp, q))).1 =
      apH {H.HData i ((Y0.yH J I f).nt (B.DC.hOb i) rho)} {V0.Ix (F.1.tob (B.DC.hOb i) ((Y0.yH J I f).nt (B.DC.hOb i) rho))} (\ hd -> (F.2 i o ((Y0.yH J I f).nt (B.DC.hOb i) rho) hd).1)
        (H.hd-eq i ((Y0.yH J I f).nt (B.DC.hOb i) rho) (B.DC.CL.P[Y0.yP J, Y0.yP I, Y0.yH J I f, F.1, F.2].Pl.mv i rho (v, (pp, p)))
          (B.Cl.P[Y1.yP J, Y1.yP I, Y1.yH J I f, L I F.1, op I F.1 F.2].Pl.mv i rho (v, (pp, q)))
          (refl (B.DC.CL.P[Y0.yP J, Y0.yP I, Y0.yH J I f, F.1, F.2].Pl.mv i rho (v, (pp, p))).1)) ;
   } ;

  opaque law ;
} ;

include-nat (J I : Nat) (f : Hom J I) (F : U0.U0 I)
  : Id (U1.U0 J) (inc J (U0.uAct J I f F)) (U1.uAct J I f (inc I F)) =
  Restrict[J, I, f, F].law ;

-- Read a path of lifted codes back in the original fibre. Both levels
-- have proof-irrelevant paths between codes.
read (v w : V0.V) (p : Id V0.V v w) (q : Id V1.V (B.Lift.smallC v) (B.Lift.smallC w)) (z : V0.Ix v)
  : Id (V0.Ix w) (subst V1.V (\ t -> V1.Ix t) (B.Lift.smallC v) (B.Lift.smallC w) q z)
                (subst V0.V (\ t -> V0.Ix t) v w p z) =
  idJ V0.V v
    (\ t r -> (q' : Id V1.V (B.Lift.smallC v) (B.Lift.smallC t)) ->
      Id (V0.Ix t) (subst V1.V (\ y -> V1.Ix y) (B.Lift.smallC v) (B.Lift.smallC t) q' z)
                  (subst V0.V (\ y -> V0.Ix y) v t r z))
    (\ q' -> apH (\ r -> subst V1.V (\ t -> V1.Ix t) (B.Lift.smallC v) (B.Lift.smallC v) r z)
      (V1.isSetV (B.Lift.smallC v) (B.Lift.smallC v) q' (refl (B.Lift.smallC v)))) w p q ;

opaque read ;

module TypeInj (X : Nat) (A A' : P.PS.PTy[Y0.yP X]) (q : Id (Q.PS.PTy[Y1.yP X]) (L X A) (L X A')) {
  open Axioms[a++].FunExtLemmas[fe @(a++)] ;
  module S = P.PS ;

  high (I : Nat) (x : Hom I X) : Id V1.V (B.Lift.smallC (A.tob I x)) (B.Lift.smallC (A'.tob I x)) =
    apH (\ T -> T.tob I x) q ;

  objs : Id (S.TOb (Y0.yP X)) A.tob A'.tob =
    funext Nat (\ I -> Hom I X -> V0.V) A.tob A'.tob (\ I ->
      funext (Hom I X) (\ _ -> V0.V) (A.tob I) (A'.tob I) (\ x -> lift-inj (A.tob I x) (A'.tob I x) (high I x))) ;

  cast (I : Nat) (x : Hom I X) (z : V0.Ix (A.tob I x)) : V0.Ix (A'.tob I x) =
    subst (S.TOb (Y0.yP X)) (\ o -> V0.Ix (o I x)) A.tob A'.tob objs z ;

  high-cast (I : Nat) (x : Hom I X) (z : V0.Ix (A.tob I x)) : V0.Ix (A'.tob I x) =
    subst V1.V (\ t -> V1.Ix t) (B.Lift.smallC (A.tob I x)) (B.Lift.smallC (A'.tob I x)) (high I x) z ;

  casts (I : Nat) (x : Hom I X) (z : V0.Ix (A.tob I x)) : Id (V0.Ix (A'.tob I x)) (high-cast I x z) (cast I x z) =
    transH (read (A.tob I x) (A'.tob I x) (apH (\ o -> o I x) objs) (high I x) z)
      (symH (subst-ap (S.TOb (Y0.yP X)) V0.V (\ o -> o I x) (\ t -> V0.Ix t) A.tob A'.tob objs z)) ;

  move-act (J I : Nat) (f : Hom J I) (x : Hom I X) (y : Hom J X)
    (e : Id (Hom J X) ((Y0.yP X).act J I f x) y) (z : V0.Ix (A.tob I x))
    : Id (V0.Ix (A'.tob J y)) (high-cast J y (A.tact J I f x y e z)) (A'.tact J I f x y e (high-cast I x z)) =
    idJ (Q.PS.PTy[Y1.yP X]) (L X A)
      (\ T Q ->
        Id (V1.Ix (T.tob J y))
          (subst V1.V (\ t -> V1.Ix t) (B.Lift.smallC (A.tob J y)) (T.tob J y) (apH (\ C -> C.tob J y) Q) (A.tact J I f x y e z))
          (T.tact J I f x y e (subst V1.V (\ t -> V1.Ix t) (B.Lift.smallC (A.tob I x)) (T.tob I x) (apH (\ C -> C.tob I x) Q) z)))
      (refl (A.tact J I f x y e z)) (L X A') q ;

  law : Id (S.PTy[Y0.yP X]) A A' =
    S.ty-ext2 (Y0.yP X) A A' objs (\ J I f x y e z ->
      transH (symH (casts J y (A.tact J I f x y e z)))
        (transH (move-act J I f x y e z) (apH (A'.tact J I f x y e) (casts I x z)))) ;

  opaque law ;
} ;

Op0 (X : Nat) (A : P.PS.PTy[Y0.yP X]) : U a+ = B.DC.CL.Cl (Y0.yP X) A ;
Op1 (X : Nat) (A : Q.PS.PTy[Y1.yP X]) : U a++ = B.Cl.Cl (Y1.yP X) A ;

op-inj (X : Nat) (A : P.PS.PTy[Y0.yP X]) (h h' : Op0 X A)
  (q : Id (U1.U0 X) (inc X (A, h)) (inc X (A, h'))) : Id (Op0 X A) h h' =
  apH {Op1 X (L X A)} {Op0 X A} (lower-op X A) {op X A h} {op X A h'} (transH
    (apH (\ e -> subst (Q.PS.PTy[Y1.yP X]) (Op1 X) (L X A) (L X A) e (op X A h))
      (Q.PS.isSet-PTy (Y1.yP X) (L X A) (L X A) (refl (L X A))
        (sPath (Q.PS.PTy[Y1.yP X]) (Op1 X) (inc X (A, h)) (inc X (A, h')) q).1))
    (sPath (Q.PS.PTy[Y1.yP X]) (Op1 X) (inc X (A, h)) (inc X (A, h')) q).2) ;

include-inj (X : Nat) (v w : U0.U0 X) (q : Id (U1.U0 X) (inc X v) (inc X w)) : Id (U0.U0 X) v w =
  idJ (P.PS.PTy[Y0.yP X]) v.1
    (\ T p -> (h : Op0 X T) -> Id (U1.U0 X) (inc X v) (inc X (T, h)) -> Id (U0.U0 X) v (T, h))
    (\ h r -> apH {Op0 X v.1} {U0.U0 X} (\ z -> (v.1, z)) (op-inj X v.1 v.2 h r))
    w.1 (TypeInj[X, v.1, w.1, apH (\ z -> z.1) q].law) w.2 q ;

opaque include-inj ;
