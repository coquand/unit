-- CExtCmp.seg (L5, inside CB; quarry seg/model GExtCmp): the comparison of
-- Ext at a point of the universal glue data.  For w a point of GDr at
-- stage I (data D), the fibre of Ext of D's data over
-- y I at the identity (level a) and the fibre of ExtBig at w (level a+)
-- are isomorphic.  Here: the extents (fullDU / fullUD).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;

module CM (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A)) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module XU = CExtU.XU[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module DD = CGlueD.GD[Cl, clSub, clSub-id, clSub-o, encCl] ;

  -- transport between codes of a set: along any path, composed
  trC-irr (W : Ob) (F F' : UU.U0 W) (P P' : Id (UU.U0 W) F F') (z : W0.Ix (UU.fib0 W F))
    : Id (W0.Ix (UU.fib0 W F')) (DD.trB W F F' P z) (DD.trB W F F' P' z) =
    apH (\ p -> DD.trB W F F' p z) (V1.isSetIx (UU.codeU W) F F' P P') ;

  trC-comp (W : Ob) (F F' F'' : UU.U0 W) (P : Id (UU.U0 W) F F') (P' : Id (UU.U0 W) F' F'') (z : W0.Ix (UU.fib0 W F))
    : Id (W0.Ix (UU.fib0 W F'')) (DD.trB W F' F'' P' (DD.trB W F F' P z)) (DD.trB W F F'' (transH P P') z) =
    idJ (UU.U0 W) F' (\ F3 P3 -> Id (W0.Ix (UU.fib0 W F3)) (DD.trB W F' F3 P3 (DD.trB W F F' P z)) (DD.trB W F F3 (transH P P3) z))
      (refl (DD.trB W F F' P z)) F'' P' ;

  -- elements of the total of BU from a path of points and the values through the codes
  tbEqU (W : Ob) (x x' : V1.Ix (UB.CU.resCtx.ob W)) (P : Id (V1.Ix (UB.CU.resCtx.ob W)) x x')
    (b : W0.Ix (UU.fib0 W (UB.bmap.nt W x))) (b' : W0.Ix (UU.fib0 W (UB.bmap.nt W x')))
    (Q : Id (W0.Ix (UU.fib0 W (UB.bmap.nt W x'))) (DD.trB W (UB.bmap.nt W x) (UB.bmap.nt W x') (apH (UB.bmap.nt W) P) b) b')
    : Id (UB.TBU.EI W) (x, b) (x', b') =
    idJ (V1.Ix (UB.CU.resCtx.ob W)) x
      (\ x2 P2 -> (b2 : W0.Ix (UU.fib0 W (UB.bmap.nt W x2)))
         -> Id (W0.Ix (UU.fib0 W (UB.bmap.nt W x2))) (DD.trB W (UB.bmap.nt W x) (UB.bmap.nt W x2) (apH (UB.bmap.nt W) P2) b) b2
         -> Id (UB.TBU.EI W) (x, b) (x2, b2))
      (\ b2 Q2 -> apH {W0.Ix (UU.fib0 W (UB.bmap.nt W x))} {UB.TBU.EI W} (\ z -> (x, z)) Q2)
      x' P b' Q ;

  opaque trC-irr ; opaque trC-comp ; opaque tbEqU ;

  module At (I : Ob) (w : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 I) {
    module DT = XU.Dat[I, w.1.1, w.1.2.1, w.1.2.2] ;

    fullDU (W : Ob) (f : Hom W I) (q : IsT (DT.CL.full W (compH W I I (idH I) f))) : IsT (UB.CU.full W (UB.GDr.act W I f w)) =
      UB.CU.full-of-id W (UB.GDr.act W I f w)
        (lands-sub W W (pre W I (compH W I I (idH I) f) w.1.2.1) (pre W I f w.1.2.1)
           (apH (\ g -> pre W I g w.1.2.1) (comp-idl W I f)) (idH W) (DT.CL.full-id W (compH W I I (idH I) f) q)) ;

    fullUD (W : Ob) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w))) : IsT (DT.CL.full W (compH W I I (idH I) f)) =
      DT.CL.full-of-id W (compH W I I (idH I) f)
        (lands-sub W W (pre W I f w.1.2.1) (pre W I (compH W I I (idH I) f) w.1.2.1)
           (apH (\ g -> pre W I g w.1.2.1) (symH (comp-idl W I f))) (idH W) (UB.CU.full-id W (UB.GDr.act W I f w) q)) ;

    opaque fullDU ; opaque fullUD ;

    ------------------------------------------------------------------
    -- pairs of the data over y I, as pairs of the universal data

    module ED = CExt[a].ExtDef[yP I, w.1.1.1, CExtU.psiD I w.1.2.1] ;
    module EBd = ED.ExtB[DT.BD, DT.alD] ;
    module EU = CExt[a+].ExtDef[UB.GDr, UB.AU, UB.psiU] ;
    module EBu = EU.ExtB[UB.BU, UB.alU] ;

    Eb (W : Ob) (f : Hom W I) : Id (Hom W I) (compH W I I (idH I) f) (compH W W I f (idH W)) =
      transH (comp-idl W I f) (symH (comp-idr W I f)) ;

    qa (W : Ob) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w))) : IsT (CGlueD.fl I w.1.2.1 W (compH W I I (idH I) f)) =
      CExtU.toFl I w.1.2.1 W (compH W I I (idH I) f) (fullUD W f q) ;

    qb (W : Ob) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w))) : IsT (CGlueD.fl I w.1.2.1 W (compH W W I f (idH W))) =
      CGlueD.fl-pre W I f w.1.2.1 W (idH W) (UB.qU W (UB.GDr.act W I f w) q) ;

    Bh (W : Ob) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w)))
      : Id (UU.U0 W) (w.1.2.2.1 W (compH W I I (idH I) f) (qa W f q)) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q)) =
      DD.Bhom I w.1.2.1 w.1.2.2.1 W (compH W I I (idH I) f) (compH W W I f (idH W)) (Eb W f) (qa W f q) (qb W f q) ;

    -- the codes of B at points of the extent over y I
    codeD (W : Ob) (x : W0.Ix (DT.CL.resCtx.ob W)) : UU.U0 W = w.1.2.2.1 W x.1 (CExtU.toFl I w.1.2.1 W x.1 x.2) ;

    sndD (W : Ob) (z1 z2 : EBd.TB.EI W) (R : Id (EBd.TB.EI W) z1 z2)
      : Id (W0.Ix (UU.fib0 W (codeD W z2.1))) (DD.trB W (codeD W z1.1) (codeD W z2.1) (apH (codeD W) (apH (\ z -> z.1) R)) z1.2) z2.2 =
      idJ (EBd.TB.EI W) z1
        (\ z3 R3 -> Id (W0.Ix (UU.fib0 W (codeD W z3.1))) (DD.trB W (codeD W z1.1) (codeD W z3.1) (apH (codeD W) (apH (\ z -> z.1) R3)) z1.2) z3.2)
        (refl z1.2) z2 R ;

    opaque sndD ;

    module PH (u : EBd.Pairs I (idH I)) {
      a0 : W0.Ix (w.1.1.1.tob I (idH I)) = EBd.pa I (idH I) u ;

      bv (W : Ob) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w))) : W0.Ix (UU.fib0 W (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q))) =
        DD.trB W (w.1.2.2.1 W (compH W I I (idH I) f) (qa W f q)) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q)) (Bh W f q)
          (EBd.pbF I (idH I) u W f (fullUD W f q)) ;

      bEU : EBu.BETy I w = \ W f q -> ((UB.GDr.act W I f w, q), bv W f q) ;

      bptU : EBu.BptTy I w bEU = \ W f q -> refl (UB.GDr.act W I f w, q) ;

      balU : EBu.BalTy I w a0 bEU = \ W f q ->
        apH {W0.Ix (w.1.1.1.tob W (compH W W I f (idH W)))} {EU.TA.EI W} (\ z -> (UB.GDr.act W I f w, z))
          (calc (W0.Ix (w.1.1.1.tob W (compH W W I f (idH W)))) {
              w.1.2.2.2.2.1 W (compH W W I f (idH W)) (qb W f q) (bv W f q)
            =< symH (DD.alHom I w.1.1 w.1.2.1 w.1.2.2 W (compH W I I (idH I) f) (compH W W I f (idH W)) (Eb W f)
                       (qa W f q) (qb W f q) (EBd.pbF I (idH I) u W f (fullUD W f q))) >
              subst (Hom W I) (\ k -> W0.Ix (w.1.1.1.tob W k)) (compH W I I (idH I) f) (compH W W I f (idH W)) (Eb W f)
                (w.1.2.2.2.2.1 W (compH W I I (idH I) f) (qa W f q) (EBd.pbF I (idH I) u W f (fullUD W f q)))
            =< apH (subst (Hom W I) (\ k -> W0.Ix (w.1.1.1.tob W k)) (compH W I I (idH I) f) (compH W W I f (idH W)) (Eb W f))
                 (ED.TA.pr-inj W (compH W I I (idH I) f)
                    (w.1.2.2.2.2.1 W (compH W I I (idH I) f) (qa W f q) (EBd.pbF I (idH I) u W f (fullUD W f q)))
                    (w.1.1.1.tact W I f (idH I) (compH W I I (idH I) f) (refl (compH W I I (idH I) f)) a0)
                    (EBd.pal I (idH I) u W f (fullUD W f q))) >
              subst (Hom W I) (\ k -> W0.Ix (w.1.1.1.tob W k)) (compH W I I (idH I) f) (compH W W I f (idH W)) (Eb W f)
                (w.1.1.1.tact W I f (idH I) (compH W I I (idH I) f) (refl (compH W I I (idH I) f)) a0)
            =< UU.tact-move (yP I) w.1.1.1 W I f (idH I) (compH W I I (idH I) f) (compH W W I f (idH W))
                 (refl (compH W I I (idH I) f)) (UU.idf-eq W I f) (Eb W f) a0 >
              w.1.1.1.tact W I f (idH I) (compH W W I f (idH W)) (UU.idf-eq W I f) a0
            =< symH (UB.substLoop W (UU.uAct W I f w.1.1)
                 (L.ntEq UB.GDr UU.UCtx UB.pA W I f w (UB.GDr.act W I f w) (refl (UB.GDr.act W I f w)))
                 (w.1.1.1.tact W I f (idH I) (compH W W I f (idH W)) (UU.idf-eq W I f) a0)) >
              (EU.EA.act W I f (w, a0)).2 }) ;

      -- the point of y I under f
      pt (W : Ob) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w))) : W0.Ix (DT.CL.resCtx.ob W) =
        (compH W I I (idH I) f, fullUD W f q) ;

      module BN (W' W : Ob) (chi : Hom W' W) (f : Hom W I) (q : IsT (UB.CU.full W (UB.GDr.act W I f w)))
        (q' : IsT (UB.CU.full W' (UB.GDr.act W' I (compH W' W I f chi) w))) {
        x : V1.Ix (UB.CU.resCtx.ob W') = UB.CU.resCtx.act W' W chi (UB.GDr.act W I f w, q) ;
        x' : V1.Ix (UB.CU.resCtx.ob W') = (UB.GDr.act W' I (compH W' W I f chi) w, q') ;
        P : Id (V1.Ix (UB.CU.resCtx.ob W')) x x' = UB.CU.res-eq W' x x' (symH (UB.GDr.act-o W' W I f chi w)) ;
        b0 : W0.Ix (UU.fib0 W' (UB.bmap.nt W' x)) = UB.BU.tact W' W chi (UB.GDr.act W I f w, q) x (refl x) (bv W f q) ;

        -- the data side: naturality of the family of u
        R : Id (EBd.TB.EI W') (EBd.EB.act W' W chi (EBd.pb I (idH I) u W f (fullUD W f q)))
                              (EBd.pb I (idH I) u W' (compH W' W I f chi) (fullUD W' (compH W' W I f chi) q')) =
          EBd.pnatF I (idH I) u W' W chi f (fullUD W f q) (fullUD W' (compH W' W I f chi) q') ;
        z1 : EBd.TB.EI W' = EBd.EB.act W' W chi (EBd.pb I (idH I) u W f (fullUD W f q)) ;
        z2 : EBd.TB.EI W' = EBd.pb I (idH I) u W' (compH W' W I f chi) (fullUD W' (compH W' W I f chi) q') ;

        F1 : UU.U0 W = w.1.2.2.1 W (compH W I I (idH I) f) (qa W f q) ;
        F1' : UU.U0 W = w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q) ;
        F2 : UU.U0 W' = codeD W' z1.1 ;
        F2x : UU.U0 W' = UB.bmap.nt W' x ;
        F3 : UU.U0 W' = UB.bmap.nt W' x' ;
        F4 : UU.U0 W' = codeD W' z2.1 ;

        PD : Id (UU.U0 W') F2 F4 = apH (codeD W') (apH (\ z -> z.1) R) ;
        PP : Id (UU.U0 W') F2x F3 = apH (UB.bmap.nt W') P ;
        Bh2 : Id (UU.U0 W') F4 F3 = Bh W' (compH W' W I f chi) q' ;
        Q2 : Id (UU.U0 W') F2 F2x = transH (transH PD Bh2) (symH PP) ;

        ea2 : Id (UU.U0 W') (UU.uAct W' W chi F1) F2 =
          w.1.2.2.2.1 W' W chi (compH W I I (idH I) f) (qa W f q) z1.1.1
            (apH (\ z -> z.1) (ntEq DT.CL.resCtx DT.T.R.RC (CExtU.toRC I w.1.2.1) W' W chi (pt W f q) z1.1 (refl z1.1)))
            (CExtU.toFl I w.1.2.1 W' z1.1.1 z1.1.2) ;
        ea1 : Id (UU.U0 W') (UU.uAct W' W chi F1') F2x = L.ntEq UB.CU.resCtx UU.UCtx UB.bmap W' W chi (UB.GDr.act W I f w, q) x (refl x) ;

        Qp : Id (W0.Ix (UU.fib0 W' F3)) (DD.trB W' F2x F3 PP b0) (bv W' (compH W' W I f chi) q') =
          calc (W0.Ix (UU.fib0 W' F3)) {
              DD.trB W' F2x F3 PP (UU.tactG W' W chi F1' F2x ea1 (DD.trB W F1 F1' (Bh W f q) (EBd.pbF I (idH I) u W f (fullUD W f q))))
            =< apH (DD.trB W' F2x F3 PP)
                 (symH (XU.tactGcong W' W chi F1 F1' (Bh W f q) F2 F2x Q2 ea2 ea1 (EBd.pbF I (idH I) u W f (fullUD W f q)))) >
              DD.trB W' F2x F3 PP (DD.trB W' F2 F2x Q2 z1.2)
            =< trC-comp W' F2 F2x F3 Q2 PP z1.2 >
              DD.trB W' F2 F3 (transH Q2 PP) z1.2
            =< trC-irr W' F2 F3 (transH Q2 PP) (transH PD Bh2) z1.2 >
              DD.trB W' F2 F3 (transH PD Bh2) z1.2
            =< symH (trC-comp W' F2 F4 F3 PD Bh2 z1.2) >
              DD.trB W' F4 F3 Bh2 (DD.trB W' F2 F4 PD z1.2)
            =< apH (DD.trB W' F4 F3 Bh2) (sndD W' z1 z2 R) >
              bv W' (compH W' W I f chi) q' } ;

        res : Id (EBu.TB.EI W') (EBu.EB.act W' W chi (bEU W f q)) (bEU W' (compH W' W I f chi) q') =
          tbEqU W' x x' P b0 (bv W' (compH W' W I f chi) q') Qp ;
      } ;

      bnatU : EBu.BnatTy I w bEU = \ W' W chi f q q' -> BN[W', W, chi, f, q, q'].res ;

      phiP : EBu.Pairs I w = EBu.mkPairs I w a0 bEU bptU balU bnatU ;
    } ;

    -- elements of the total of B over y I from a path of points and the values through the codes
    tbEqD (W : Ob) (x x' : W0.Ix (DT.CL.resCtx.ob W)) (P : Id (W0.Ix (DT.CL.resCtx.ob W)) x x')
      (b : W0.Ix (UU.fib0 W (codeD W x))) (b' : W0.Ix (UU.fib0 W (codeD W x')))
      (Q : Id (W0.Ix (UU.fib0 W (codeD W x'))) (DD.trB W (codeD W x) (codeD W x') (apH (codeD W) P) b) b')
      : Id (EBd.TB.EI W) (x, b) (x', b') =
      idJ (W0.Ix (DT.CL.resCtx.ob W)) x
        (\ x2 P2 -> (b2 : W0.Ix (UU.fib0 W (codeD W x2)))
           -> Id (W0.Ix (UU.fib0 W (codeD W x2))) (DD.trB W (codeD W x) (codeD W x2) (apH (codeD W) P2) b) b2
           -> Id (EBd.TB.EI W) (x, b) (x2, b2))
        (\ b2 Q2 -> apH {W0.Ix (UU.fib0 W (codeD W x))} {EBd.TB.EI W} (\ z -> (x, z)) Q2)
        x' P b' Q ;

    sndU (W : Ob) (z1 z2 : EBu.TB.EI W) (R : Id (EBu.TB.EI W) z1 z2)
      : Id (W0.Ix (UU.fib0 W (UB.bmap.nt W z2.1)))
           (DD.trB W (UB.bmap.nt W z1.1) (UB.bmap.nt W z2.1) (apH (UB.bmap.nt W) (apH (\ z -> z.1) R)) z1.2) z2.2 =
      idJ (EBu.TB.EI W) z1
        (\ z3 R3 -> Id (W0.Ix (UU.fib0 W (UB.bmap.nt W z3.1)))
                       (DD.trB W (UB.bmap.nt W z1.1) (UB.bmap.nt W z3.1) (apH (UB.bmap.nt W) (apH (\ z -> z.1) R3)) z1.2) z3.2)
        (refl z1.2) z2 R ;

    opaque tbEqD ; opaque sndU ;

    module PS (u : EBu.Pairs I w) {
      a0 : W0.Ix (w.1.1.1.tob I (idH I)) = EBu.pa I w u ;

      ptD (W : Ob) (f : Hom W I) (qD : IsT (DT.CL.full W (compH W I I (idH I) f))) : W0.Ix (DT.CL.resCtx.ob W) =
        (compH W I I (idH I) f, qD) ;

      Bh' (W : Ob) (f : Hom W I) (qD : IsT (DT.CL.full W (compH W I I (idH I) f)))
        : Id (UU.U0 W) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD))) (codeD W (ptD W f qD)) =
        DD.Bhom I w.1.2.1 w.1.2.2.1 W (compH W W I f (idH W)) (compH W I I (idH I) f) (symH (Eb W f))
          (qb W f (fullDU W f qD)) (CExtU.toFl I w.1.2.1 W (compH W I I (idH I) f) qD) ;

      bv (W : Ob) (f : Hom W I) (qD : IsT (DT.CL.full W (compH W I I (idH I) f))) : W0.Ix (UU.fib0 W (codeD W (ptD W f qD))) =
        DD.trB W (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD))) (codeD W (ptD W f qD)) (Bh' W f qD)
          (EBu.pbF I w u W f (fullDU W f qD)) ;

      bED : EBd.BETy I (idH I) = \ W f qD -> (ptD W f qD, bv W f qD) ;

      bptD : EBd.BptTy I (idH I) bED = \ W f qD -> refl (ptD W f qD) ;

      balD : EBd.BalTy I (idH I) a0 bED = \ W f qD ->
        apH {W0.Ix (w.1.1.1.tob W (compH W I I (idH I) f))} {ED.TA.EI W} (\ z -> (compH W I I (idH I) f, z))
          (calc (W0.Ix (w.1.1.1.tob W (compH W I I (idH I) f))) {
              w.1.2.2.2.2.1 W (compH W I I (idH I) f) (CExtU.toFl I w.1.2.1 W (compH W I I (idH I) f) qD) (bv W f qD)
            =< symH (DD.alHom I w.1.1 w.1.2.1 w.1.2.2 W (compH W W I f (idH W)) (compH W I I (idH I) f) (symH (Eb W f))
                       (qb W f (fullDU W f qD)) (CExtU.toFl I w.1.2.1 W (compH W I I (idH I) f) qD) (EBu.pbF I w u W f (fullDU W f qD))) >
              subst (Hom W I) (\ k -> W0.Ix (w.1.1.1.tob W k)) (compH W W I f (idH W)) (compH W I I (idH I) f) (symH (Eb W f))
                (w.1.2.2.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD)) (EBu.pbF I w u W f (fullDU W f qD)))
            =< apH (subst (Hom W I) (\ k -> W0.Ix (w.1.1.1.tob W k)) (compH W W I f (idH W)) (compH W I I (idH I) f) (symH (Eb W f)))
                 (transH (EU.TA.pr-inj W (UB.GDr.act W I f w)
                            (w.1.2.2.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD)) (EBu.pbF I w u W f (fullDU W f qD)))
                            (EU.EA.act W I f (w, a0)).2
                            (EBu.pal I w u W f (fullDU W f qD)))
                    (UB.substLoop W (UU.uAct W I f w.1.1)
                       (L.ntEq UB.GDr UU.UCtx UB.pA W I f w (UB.GDr.act W I f w) (refl (UB.GDr.act W I f w)))
                       (w.1.1.1.tact W I f (idH I) (compH W W I f (idH W)) (UU.idf-eq W I f) a0))) >
              subst (Hom W I) (\ k -> W0.Ix (w.1.1.1.tob W k)) (compH W W I f (idH W)) (compH W I I (idH I) f) (symH (Eb W f))
                (w.1.1.1.tact W I f (idH I) (compH W W I f (idH W)) (UU.idf-eq W I f) a0)
            =< UU.tact-move (yP I) w.1.1.1 W I f (idH I) (compH W W I f (idH W)) (compH W I I (idH I) f)
                 (UU.idf-eq W I f) (refl (compH W I I (idH I) f)) (symH (Eb W f)) a0 >
              w.1.1.1.tact W I f (idH I) (compH W I I (idH I) f) (refl (compH W I I (idH I) f)) a0 }) ;

      module BN (W' W : Ob) (chi : Hom W' W) (f : Hom W I) (qD : IsT (DT.CL.full W (compH W I I (idH I) f)))
        (qD' : IsT (DT.CL.full W' (compH W' I I (idH I) (compH W' W I f chi)))) {
        x : W0.Ix (DT.CL.resCtx.ob W') = DT.CL.resCtx.act W' W chi (ptD W f qD) ;
        x' : W0.Ix (DT.CL.resCtx.ob W') = ptD W' (compH W' W I f chi) qD' ;
        P : Id (W0.Ix (DT.CL.resCtx.ob W')) x x' = DT.CL.res-eq W' x x' (comp-assoc W' W I I (idH I) f chi) ;
        b0 : W0.Ix (UU.fib0 W' (codeD W' x)) = DT.BD.tact W' W chi (ptD W f qD) x (refl x) (bv W f qD) ;

        R : Id (EBu.TB.EI W') (EBu.EB.act W' W chi (EBu.pb I w u W f (fullDU W f qD)))
                              (EBu.pb I w u W' (compH W' W I f chi) (fullDU W' (compH W' W I f chi) qD')) =
          EBu.pnatF I w u W' W chi f (fullDU W f qD) (fullDU W' (compH W' W I f chi) qD') ;
        z1 : EBu.TB.EI W' = EBu.EB.act W' W chi (EBu.pb I w u W f (fullDU W f qD)) ;
        z2 : EBu.TB.EI W' = EBu.pb I w u W' (compH W' W I f chi) (fullDU W' (compH W' W I f chi) qD') ;

        F1 : UU.U0 W = w.1.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD)) ;
        F1' : UU.U0 W = codeD W (ptD W f qD) ;
        F2 : UU.U0 W' = UB.bmap.nt W' z1.1 ;
        F2x : UU.U0 W' = codeD W' x ;
        F3 : UU.U0 W' = codeD W' x' ;
        F4 : UU.U0 W' = UB.bmap.nt W' z2.1 ;

        PD : Id (UU.U0 W') F2 F4 = apH (UB.bmap.nt W') (apH (\ z -> z.1) R) ;
        PP : Id (UU.U0 W') F2x F3 = apH (codeD W') P ;
        Bh2 : Id (UU.U0 W') F4 F3 = Bh' W' (compH W' W I f chi) qD' ;
        Q2 : Id (UU.U0 W') F2 F2x = transH (transH PD Bh2) (symH PP) ;

        ea2 : Id (UU.U0 W') (UU.uAct W' W chi F1) F2 =
          L.ntEq UB.CU.resCtx UU.UCtx UB.bmap W' W chi (UB.GDr.act W I f w, fullDU W f qD) z1.1 (refl z1.1) ;
        ea1 : Id (UU.U0 W') (UU.uAct W' W chi F1') F2x =
          w.1.2.2.2.1 W' W chi (compH W I I (idH I) f) (CExtU.toFl I w.1.2.1 W (compH W I I (idH I) f) qD) x.1
            (apH (\ z -> z.1) (ntEq DT.CL.resCtx DT.T.R.RC (CExtU.toRC I w.1.2.1) W' W chi (ptD W f qD) x (refl x)))
            (CExtU.toFl I w.1.2.1 W' x.1 x.2) ;

        Qp : Id (W0.Ix (UU.fib0 W' F3)) (DD.trB W' F2x F3 PP b0) (bv W' (compH W' W I f chi) qD') =
          calc (W0.Ix (UU.fib0 W' F3)) {
              DD.trB W' F2x F3 PP (UU.tactG W' W chi F1' F2x ea1 (DD.trB W F1 F1' (Bh' W f qD) (EBu.pbF I w u W f (fullDU W f qD))))
            =< apH (DD.trB W' F2x F3 PP)
                 (symH (XU.tactGcong W' W chi F1 F1' (Bh' W f qD) F2 F2x Q2 ea2 ea1 (EBu.pbF I w u W f (fullDU W f qD)))) >
              DD.trB W' F2x F3 PP (DD.trB W' F2 F2x Q2 z1.2)
            =< trC-comp W' F2 F2x F3 Q2 PP z1.2 >
              DD.trB W' F2 F3 (transH Q2 PP) z1.2
            =< trC-irr W' F2 F3 (transH Q2 PP) (transH PD Bh2) z1.2 >
              DD.trB W' F2 F3 (transH PD Bh2) z1.2
            =< symH (trC-comp W' F2 F4 F3 PD Bh2 z1.2) >
              DD.trB W' F4 F3 Bh2 (DD.trB W' F2 F4 PD z1.2)
            =< apH (DD.trB W' F4 F3 Bh2) (sndU W' z1 z2 R) >
              bv W' (compH W' W I f chi) qD' } ;

        res : Id (EBd.TB.EI W') (EBd.EB.act W' W chi (bED W f qD)) (bED W' (compH W' W I f chi) qD') =
          tbEqD W' x x' P b0 (bv W' (compH W' W I f chi) qD') Qp ;
      } ;

      bnatD : EBd.BnatTy I (idH I) bED = \ W' W chi f qD qD' -> BN[W', W, chi, f, qD, qD'].res ;

      psiP : EBd.Pairs I (idH I) = EBd.mkPairs I (idH I) a0 bED bptD balD bnatD ;
    } ;

    -- a family value at two proofs of fullness
    pbqD (u : EBd.Pairs I (idH I)) (W : Ob) (f : Hom W I) (q2 q : IsT (DT.CL.full W (compH W I I (idH I) f)))
      (P : Id (IsT (DT.CL.full W (compH W I I (idH I) f))) q2 q)
      : Id (W0.Ix (UU.fib0 W (codeD W (compH W I I (idH I) f, q))))
           (DD.trB W (codeD W (compH W I I (idH I) f, q2)) (codeD W (compH W I I (idH I) f, q))
              (apH (\ z -> codeD W (compH W I I (idH I) f, z)) P) (EBd.pbF I (idH I) u W f q2))
           (EBd.pbF I (idH I) u W f q) =
      idJ (IsT (DT.CL.full W (compH W I I (idH I) f))) q2
        (\ q3 P3 -> Id (W0.Ix (UU.fib0 W (codeD W (compH W I I (idH I) f, q3))))
                       (DD.trB W (codeD W (compH W I I (idH I) f, q2)) (codeD W (compH W I I (idH I) f, q3))
                          (apH (\ z -> codeD W (compH W I I (idH I) f, z)) P3) (EBd.pbF I (idH I) u W f q2))
                       (EBd.pbF I (idH I) u W f q3))
        (refl (EBd.pbF I (idH I) u W f q2)) q P ;

    pbqU (v : EBu.Pairs I w) (W : Ob) (f : Hom W I) (q2 q : IsT (UB.CU.full W (UB.GDr.act W I f w)))
      (P : Id (IsT (UB.CU.full W (UB.GDr.act W I f w))) q2 q)
      : Id (W0.Ix (UU.fib0 W (UB.bmap.nt W (UB.GDr.act W I f w, q))))
           (DD.trB W (UB.bmap.nt W (UB.GDr.act W I f w, q2)) (UB.bmap.nt W (UB.GDr.act W I f w, q))
              (apH (\ z -> UB.bmap.nt W (UB.GDr.act W I f w, z)) P) (EBu.pbF I w v W f q2))
           (EBu.pbF I w v W f q) =
      idJ (IsT (UB.CU.full W (UB.GDr.act W I f w))) q2
        (\ q3 P3 -> Id (W0.Ix (UU.fib0 W (UB.bmap.nt W (UB.GDr.act W I f w, q3))))
                       (DD.trB W (UB.bmap.nt W (UB.GDr.act W I f w, q2)) (UB.bmap.nt W (UB.GDr.act W I f w, q3))
                          (apH (\ z -> UB.bmap.nt W (UB.GDr.act W I f w, z)) P3) (EBu.pbF I w v W f q2))
                       (EBu.pbF I w v W f q3))
        (refl (EBu.pbF I w v W f q2)) q P ;

    opaque pbqD ; opaque pbqU ;

    -- the round trips
    psiphi (u : EBd.Pairs I (idH I)) : Id (EBd.Pairs I (idH I)) PS[PH[u].phiP].psiP u =
      EBd.pairs-eq I (idH I) PS[PH[u].phiP].psiP u
        (transH (EBd.mkPairs-a I (idH I) PS[PH[u].phiP].a0 PS[PH[u].phiP].bED PS[PH[u].phiP].bptD PS[PH[u].phiP].balD PS[PH[u].phiP].bnatD)
                (EBu.mkPairs-a I w PH[u].a0 PH[u].bEU PH[u].bptU PH[u].balU PH[u].bnatU))
        (\ W f qD -> transH
           (EBd.mkPairs-b I (idH I) PS[PH[u].phiP].a0 PS[PH[u].phiP].bED PS[PH[u].phiP].bptD PS[PH[u].phiP].balD PS[PH[u].phiP].bnatD W f qD)
           (apH {W0.Ix (UU.fib0 W (codeD W (compH W I I (idH I) f, qD)))} {EBd.TB.EI W} (\ z -> ((compH W I I (idH I) f, qD), z))
             (calc (W0.Ix (UU.fib0 W (codeD W (compH W I I (idH I) f, qD)))) {
                 PS[PH[u].phiP].bv W f qD
               =< apH (DD.trB W (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD))) (codeD W (compH W I I (idH I) f, qD))
                         (PS[PH[u].phiP].Bh' W f qD))
                    (EBu.TB.pr-inj W (UB.GDr.act W I f w, fullDU W f qD) (EBu.pbF I w PH[u].phiP W f (fullDU W f qD)) (PH[u].bv W f (fullDU W f qD))
                       (EBu.mkPairs-b I w PH[u].a0 PH[u].bEU PH[u].bptU PH[u].balU PH[u].bnatU W f (fullDU W f qD))) >
                 DD.trB W (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD))) (codeD W (compH W I I (idH I) f, qD))
                   (PS[PH[u].phiP].Bh' W f qD) (PH[u].bv W f (fullDU W f qD))
               =< trC-comp W (codeD W (compH W I I (idH I) f, fullUD W f (fullDU W f qD))) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f (fullDU W f qD)))
                    (codeD W (compH W I I (idH I) f, qD)) (Bh W f (fullDU W f qD)) (PS[PH[u].phiP].Bh' W f qD)
                    (EBd.pbF I (idH I) u W f (fullUD W f (fullDU W f qD))) >
                 DD.trB W (codeD W (compH W I I (idH I) f, fullUD W f (fullDU W f qD))) (codeD W (compH W I I (idH I) f, qD))
                   (transH (Bh W f (fullDU W f qD)) (PS[PH[u].phiP].Bh' W f qD)) (EBd.pbF I (idH I) u W f (fullUD W f (fullDU W f qD)))
               =< trC-irr W (codeD W (compH W I I (idH I) f, fullUD W f (fullDU W f qD))) (codeD W (compH W I I (idH I) f, qD))
                    (transH (Bh W f (fullDU W f qD)) (PS[PH[u].phiP].Bh' W f qD))
                    (apH (\ z -> codeD W (compH W I I (idH I) f, z)) (isProp-IsT' (DT.CL.full W (compH W I I (idH I) f)) (fullUD W f (fullDU W f qD)) qD))
                    (EBd.pbF I (idH I) u W f (fullUD W f (fullDU W f qD))) >
                 DD.trB W (codeD W (compH W I I (idH I) f, fullUD W f (fullDU W f qD))) (codeD W (compH W I I (idH I) f, qD))
                   (apH (\ z -> codeD W (compH W I I (idH I) f, z)) (isProp-IsT' (DT.CL.full W (compH W I I (idH I) f)) (fullUD W f (fullDU W f qD)) qD))
                   (EBd.pbF I (idH I) u W f (fullUD W f (fullDU W f qD)))
               =< pbqD u W f (fullUD W f (fullDU W f qD)) qD (isProp-IsT' (DT.CL.full W (compH W I I (idH I) f)) (fullUD W f (fullDU W f qD)) qD) >
                 EBd.pbF I (idH I) u W f qD }))) ;

    phipsi (v : EBu.Pairs I w) : Id (EBu.Pairs I w) PH[PS[v].psiP].phiP v =
      EBu.pairs-eq I w PH[PS[v].psiP].phiP v
        (transH (EBu.mkPairs-a I w PH[PS[v].psiP].a0 PH[PS[v].psiP].bEU PH[PS[v].psiP].bptU PH[PS[v].psiP].balU PH[PS[v].psiP].bnatU)
                (EBd.mkPairs-a I (idH I) PS[v].a0 PS[v].bED PS[v].bptD PS[v].balD PS[v].bnatD))
        (\ W f q -> transH
           (EBu.mkPairs-b I w PH[PS[v].psiP].a0 PH[PS[v].psiP].bEU PH[PS[v].psiP].bptU PH[PS[v].psiP].balU PH[PS[v].psiP].bnatU W f q)
           (apH {W0.Ix (UU.fib0 W (UB.bmap.nt W (UB.GDr.act W I f w, q)))} {EBu.TB.EI W} (\ z -> ((UB.GDr.act W I f w, q), z))
             (calc (W0.Ix (UU.fib0 W (UB.bmap.nt W (UB.GDr.act W I f w, q)))) {
                 PH[PS[v].psiP].bv W f q
               =< apH (DD.trB W (codeD W (compH W I I (idH I) f, fullUD W f q)) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q)) (Bh W f q))
                    (EBd.TB.pr-inj W (compH W I I (idH I) f, fullUD W f q) (EBd.pbF I (idH I) PS[v].psiP W f (fullUD W f q)) (PS[v].bv W f (fullUD W f q))
                       (EBd.mkPairs-b I (idH I) PS[v].a0 PS[v].bED PS[v].bptD PS[v].balD PS[v].bnatD W f (fullUD W f q))) >
                 DD.trB W (codeD W (compH W I I (idH I) f, fullUD W f q)) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q)) (Bh W f q) (PS[v].bv W f (fullUD W f q))
               =< trC-comp W (UB.bmap.nt W (UB.GDr.act W I f w, fullDU W f (fullUD W f q))) (codeD W (compH W I I (idH I) f, fullUD W f q))
                    (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q)) (PS[v].Bh' W f (fullUD W f q)) (Bh W f q)
                    (EBu.pbF I w v W f (fullDU W f (fullUD W f q))) >
                 DD.trB W (UB.bmap.nt W (UB.GDr.act W I f w, fullDU W f (fullUD W f q))) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q))
                   (transH (PS[v].Bh' W f (fullUD W f q)) (Bh W f q)) (EBu.pbF I w v W f (fullDU W f (fullUD W f q)))
               =< trC-irr W (UB.bmap.nt W (UB.GDr.act W I f w, fullDU W f (fullUD W f q))) (w.1.2.2.1 W (compH W W I f (idH W)) (qb W f q))
                    (transH (PS[v].Bh' W f (fullUD W f q)) (Bh W f q))
                    (apH (\ z -> UB.bmap.nt W (UB.GDr.act W I f w, z)) (isProp-IsT' (UB.CU.full W (UB.GDr.act W I f w)) (fullDU W f (fullUD W f q)) q))
                    (EBu.pbF I w v W f (fullDU W f (fullUD W f q))) >
                 DD.trB W (UB.bmap.nt W (UB.GDr.act W I f w, fullDU W f (fullUD W f q))) (UB.bmap.nt W (UB.GDr.act W I f w, q))
                   (apH (\ z -> UB.bmap.nt W (UB.GDr.act W I f w, z)) (isProp-IsT' (UB.CU.full W (UB.GDr.act W I f w)) (fullDU W f (fullUD W f q)) q))
                   (EBu.pbF I w v W f (fullDU W f (fullUD W f q)))
               =< pbqU v W f (fullDU W f (fullUD W f q)) q (isProp-IsT' (UB.CU.full W (UB.GDr.act W I f w)) (fullDU W f (fullUD W f q)) q) >
                 EBu.pbF I w v W f q }))) ;

    opaque psiphi ; opaque phipsi ;

    ------------------------------------------------------------------
    -- the fibres of Ext, by cases on the extent at the identity

    module E3d = CExt3[a].ExtB3[yP I, w.1.1.1, CExtU.psiD I w.1.2.1, DT.BD, DT.alD] ;
    module E3u = CExt3[a+].ExtB3[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU] ;

    obD : W0.V = CExt2[a].ExtB2[yP I, w.1.1.1, CExtU.psiD I w.1.2.1, DT.BD, DT.alD].extOb I (idH I) ;
    obU : V1.V = CExt2[a+].ExtB2[UB.GDr, UB.AU, UB.psiU, UB.BU, UB.alU].extOb I w ;

    fD2U (e : IsT (DT.CL.full I (idH I))) : IsT (UB.CU.full I w) =
      UB.CU.full-eq I (UB.GDr.act I I (idH I) w) w (UB.GDr.act-id I w)
        (fullDU I (idH I) (DT.CL.full-eq I (idH I) (compH I I I (idH I) (idH I)) (symH (comp-idl I I (idH I))) e)) ;

    fU2D (e : IsT (UB.CU.full I w)) : IsT (DT.CL.full I (idH I)) =
      DT.CL.full-eq I (compH I I I (idH I) (idH I)) (idH I) (comp-idl I I (idH I))
        (fullUD I (idH I) (UB.CU.full-eq I w (UB.GDr.act I I (idH I) w) (symH (UB.GDr.act-id I w)) e)) ;

    falseOf : (b : Bool) -> (IsT b -> Empty) -> Id Bool b false = split {
      true -> \ h -> absurd _ (h (refl true)) ;
      false -> \ h -> refl false } ;

    npU (np : Id Bool (DT.CL.full I (idH I)) false) : Id Bool (UB.CU.full I w) false =
      falseOf (UB.CU.full I w) (\ e -> false-true (transH (symH np) (fU2D e))) ;

    npD (np : Id Bool (UB.CU.full I w) false) : Id Bool (DT.CL.full I (idH I)) false =
      falseOf (DT.CL.full I (idH I)) (\ e -> false-true (transH (symH np) (fD2U e))) ;

    -- the two codes of B at the identity
    cD (e : IsT (DT.CL.full I (idH I))) : UU.U0 I = codeD I (idH I, e) ;
    cU (e : IsT (UB.CU.full I w)) : UU.U0 I = UB.bmap.nt I (w, e) ;

    PDU (e : IsT (DT.CL.full I (idH I))) (e' : IsT (UB.CU.full I w)) : Id (UU.U0 I) (cD e) (cU e') =
      apH (w.1.2.2.1 I (idH I))
        (isProp-IsT' (CGlueD.fl I w.1.2.1 I (idH I)) (CExtU.toFl I w.1.2.1 I (idH I) e) (UB.qU I w e')) ;

    phA : (c : Bool) (e : Id Bool (DT.CL.full I (idH I)) c) (z : W0.Ix obD) -> V1.Ix obU = split {
      true -> \ e z -> (E3u.fromB I ((w, fD2U e), DD.trB I (cD e) (cU (fD2U e)) (PDU e (fD2U e)) (E3d.toB I (idH I, z) e).2)).2 ;
      false -> \ e z -> (E3u.fromP I w (npU e) PH[E3d.toP I (idH I, z) e].phiP).2 } ;

    psA : (c : Bool) (e : Id Bool (UB.CU.full I w) c) (y : V1.Ix obU) -> W0.Ix obD = split {
      true -> \ e y -> (E3d.fromB I ((idH I, fU2D e), DD.trB I (cU e) (cD (fU2D e)) (symH (PDU (fU2D e) e)) (E3u.toB I (w, y) e).2)).2 ;
      false -> \ e y -> (E3d.fromP I (idH I) (npD e) PS[E3u.toP I (w, y) e].psiP).2 } ;

    ph (z : W0.Ix obD) : V1.Ix obU = phA (DT.CL.full I (idH I)) (refl (DT.CL.full I (idH I))) z ;
    ps (y : V1.Ix obU) : W0.Ix obD = psA (UB.CU.full I w) (refl (UB.CU.full I w)) y ;

    -- a transport and its inverse
    trRound (W : Ob) (F F' : UU.U0 W) (P : Id (UU.U0 W) F F') (Q : Id (UU.U0 W) F' F) (z : W0.Ix (UU.fib0 W F))
      : Id (W0.Ix (UU.fib0 W F)) (DD.trB W F' F Q (DD.trB W F F' P z)) z =
      transH (trC-comp W F F' F P Q z) (trC-irr W F F (transH P Q) (refl F) z) ;

    -- ps o ph, the B case
    module RB (e : IsT (DT.CL.full I (idH I))) (e' : IsT (UB.CU.full I w)) (z : W0.Ix obD) {
      pU : IsT (UB.CU.full I w) = fD2U e ;
      e2 : IsT (DT.CL.full I (idH I)) = fU2D e' ;
      b0 : W0.Ix (UU.fib0 I (cD e)) = (E3d.toB I (idH I, z) e).2 ;
      b' : W0.Ix (UU.fib0 I (cU pU)) = DD.trB I (cD e) (cU pU) (PDU e pU) b0 ;
      R1 : Id (EBu.TB.EI I) (E3u.toB I (E3u.fromB I ((w, pU), b')) e') ((w, pU), b') =
        transH (E3u.toB-cong I (E3u.fromB I ((w, pU), b')) (E3u.fromB I ((w, pU), b')) (refl (E3u.fromB I ((w, pU), b'))) e' pU)
               (E3u.toB-fromB I ((w, pU), b')) ;
      s0 : W0.Ix (UU.fib0 I (cU e')) = (E3u.toB I (E3u.fromB I ((w, pU), b')) e').2 ;
      Q : Id (UU.U0 I) (cU e') (cU pU) = apH (UB.bmap.nt I) (apH (\ zz -> zz.1) R1) ;
      Pc : Id (UU.U0 I) (cD e) (cD e2) = apH (\ q -> cD q) (isProp-IsT' (DT.CL.full I (idH I)) e e2) ;

      sEq : Id (W0.Ix (UU.fib0 I (cD e2))) (DD.trB I (cU e') (cD e2) (symH (PDU e2 e')) s0) (DD.trB I (cD e) (cD e2) Pc b0) =
        calc (W0.Ix (UU.fib0 I (cD e2))) {
            DD.trB I (cU e') (cD e2) (symH (PDU e2 e')) s0
          =< apH (DD.trB I (cU e') (cD e2) (symH (PDU e2 e'))) (symH (trRound I (cU e') (cU pU) Q (symH Q) s0)) >
            DD.trB I (cU e') (cD e2) (symH (PDU e2 e')) (DD.trB I (cU pU) (cU e') (symH Q) (DD.trB I (cU e') (cU pU) Q s0))
          =< apH (\ t -> DD.trB I (cU e') (cD e2) (symH (PDU e2 e')) (DD.trB I (cU pU) (cU e') (symH Q) t))
               (sndU I (E3u.toB I (E3u.fromB I ((w, pU), b')) e') ((w, pU), b') R1) >
            DD.trB I (cU e') (cD e2) (symH (PDU e2 e')) (DD.trB I (cU pU) (cU e') (symH Q) b')
          =< trC-comp I (cU pU) (cU e') (cD e2) (symH Q) (symH (PDU e2 e')) b' >
            DD.trB I (cU pU) (cD e2) (transH (symH Q) (symH (PDU e2 e'))) b'
          =< trC-comp I (cD e) (cU pU) (cD e2) (PDU e pU) (transH (symH Q) (symH (PDU e2 e'))) b0 >
            DD.trB I (cD e) (cD e2) (transH (PDU e pU) (transH (symH Q) (symH (PDU e2 e')))) b0
          =< trC-irr I (cD e) (cD e2) (transH (PDU e pU) (transH (symH Q) (symH (PDU e2 e')))) Pc b0 >
            DD.trB I (cD e) (cD e2) Pc b0 } ;

      res : Id (W0.Ix obD) (psA true e' (phA true e z)) z =
        E3d.TX.pr-inj I (idH I) (psA true e' (phA true e z)) z
          (calc (E3d.TX.EI I) {
              E3d.fromB I ((idH I, e2), DD.trB I (cU e') (cD e2) (symH (PDU e2 e')) s0)
            =< apH (\ t -> E3d.fromB I ((idH I, e2), t)) sEq >
              E3d.fromB I ((idH I, e2), DD.trB I (cD e) (cD e2) Pc b0)
            =< apH (E3d.fromB I)
                 (symH (tbEqD I (idH I, e) (idH I, e2) (DT.CL.res-eq I (idH I, e) (idH I, e2) (refl (idH I))) b0 (DD.trB I (cD e) (cD e2) Pc b0)
                    (trC-irr I (cD e) (cD e2) (apH (codeD I) (DT.CL.res-eq I (idH I, e) (idH I, e2) (refl (idH I)))) Pc b0))) >
              E3d.fromB I ((idH I, e), b0)
            =< E3d.fromB-toB I (idH I, z) e >
              (idH I, z) }) ;
    } ;

    -- ph at a full point, read in B: toB after ph is B's value moved
    -- along the code paths (PDU)
    module PF (e : IsT (DT.CL.full I (idH I))) (e' : IsT (UB.CU.full I w)) (z : W0.Ix obD) {
      pU : IsT (UB.CU.full I w) = fD2U e ;
      b0 : W0.Ix (UU.fib0 I (cD e)) = (E3d.toB I (idH I, z) e).2 ;
      b' : W0.Ix (UU.fib0 I (cU pU)) = DD.trB I (cD e) (cU pU) (PDU e pU) b0 ;
      R1 : Id (EBu.TB.EI I) (E3u.toB I (E3u.fromB I ((w, pU), b')) e') ((w, pU), b') =
        transH (E3u.toB-cong I (E3u.fromB I ((w, pU), b')) (E3u.fromB I ((w, pU), b')) (refl (E3u.fromB I ((w, pU), b'))) e' pU)
               (E3u.toB-fromB I ((w, pU), b')) ;
      Q : Id (UU.U0 I) (cU e') (cU pU) = apH (UB.bmap.nt I) (apH (\ zz -> zz.1) R1) ;
      phT : Id (V1.Ix obU) (ph z) (phA true e z) =
        idJ Bool (DT.CL.full I (idH I)) (\ c ec -> Id (V1.Ix obU) (ph z) (phA c ec z)) (refl (ph z)) true e ;

      res : Id (W0.Ix (UU.fib0 I (cU e'))) (E3u.toB I (w, ph z) e').2 (DD.trB I (cD e) (cU e') (PDU e e') b0) =
        calc (W0.Ix (UU.fib0 I (cU e'))) {
            (E3u.toB I (w, ph z) e').2
          =< apH (\ t -> (E3u.toB I (w, t) e').2) phT >
            (E3u.toB I (E3u.fromB I ((w, pU), b')) e').2
          =< symH (trRound I (cU e') (cU pU) Q (symH Q) (E3u.toB I (E3u.fromB I ((w, pU), b')) e').2) >
            DD.trB I (cU pU) (cU e') (symH Q) (DD.trB I (cU e') (cU pU) Q (E3u.toB I (E3u.fromB I ((w, pU), b')) e').2)
          =< apH (DD.trB I (cU pU) (cU e') (symH Q)) (sndU I (E3u.toB I (E3u.fromB I ((w, pU), b')) e') ((w, pU), b') R1) >
            DD.trB I (cU pU) (cU e') (symH Q) b'
          =< trC-comp I (cD e) (cU pU) (cU e') (PDU e pU) (symH Q) b0 >
            DD.trB I (cD e) (cU e') (transH (PDU e pU) (symH Q)) b0
          =< trC-irr I (cD e) (cU e') (transH (PDU e pU) (symH Q)) (PDU e e') b0 >
            DD.trB I (cD e) (cU e') (PDU e e') b0 } ;
    } ;

    -- ps o ph, the pairs case
    module RP (e : Id Bool (DT.CL.full I (idH I)) false) (e' : Id Bool (UB.CU.full I w) false) (z : W0.Ix obD) {
      u : EBd.Pairs I (idH I) = E3d.toP I (idH I, z) e ;
      tp : Id (EBu.Pairs I w) (E3u.toP I (E3u.fromP I w (npU e) PH[u].phiP) e') PH[u].phiP =
        transH (apH (E3u.toP I (E3u.fromP I w (npU e) PH[u].phiP)) (isSet-Bool (UB.CU.full I w) false e' (npU e)))
               (E3u.toP-fromP I w (npU e) PH[u].phiP) ;
      res : Id (W0.Ix obD) (psA false e' (phA false e z)) z =
        E3d.TX.pr-inj I (idH I) (psA false e' (phA false e z)) z
          (calc (E3d.TX.EI I) {
              E3d.fromP I (idH I) (npD e') PS[E3u.toP I (E3u.fromP I w (npU e) PH[u].phiP) e'].psiP
            =< apH (\ v -> E3d.fromP I (idH I) (npD e') PS[v].psiP) tp >
              E3d.fromP I (idH I) (npD e') PS[PH[u].phiP].psiP
            =< apH (E3d.fromP I (idH I) (npD e')) (psiphi u) >
              E3d.fromP I (idH I) (npD e') u
            =< apH (\ n -> E3d.fromP I (idH I) n u) (isSet-Bool (DT.CL.full I (idH I)) false (npD e') e) >
              E3d.fromP I (idH I) e (E3d.toP I (idH I, z) e)
            =< E3d.fromP-toP I (idH I, z) e >
              (idH I, z) }) ;
    } ;

    rtD : (c : Bool) (e : Id Bool (DT.CL.full I (idH I)) c) (c' : Bool) (e' : Id Bool (UB.CU.full I w) c') (z : W0.Ix obD)
      -> Id (W0.Ix obD) (psA c' e' (phA c e z)) z = split {
      true -> \ e -> split {
        true -> \ e' z -> RB[e, e', z].res ;
        false -> \ e' z -> absurd _ (false-true (transH (symH e') (fD2U e))) } ;
      false -> \ e -> split {
        true -> \ e' z -> absurd _ (false-true (transH (symH e) (fU2D e'))) ;
        false -> \ e' z -> RP[e, e', z].res } } ;

    ps-ph (z : W0.Ix obD) : Id (W0.Ix obD) (ps (ph z)) z =
      rtD (DT.CL.full I (idH I)) (refl (DT.CL.full I (idH I))) (UB.CU.full I w) (refl (UB.CU.full I w)) z ;

    -- ph o ps, the B case
    module RB' (e : IsT (UB.CU.full I w)) (e' : IsT (DT.CL.full I (idH I))) (y : V1.Ix obU) {
      pD : IsT (DT.CL.full I (idH I)) = fU2D e ;
      e2 : IsT (UB.CU.full I w) = fD2U e' ;
      b0 : W0.Ix (UU.fib0 I (cU e)) = (E3u.toB I (w, y) e).2 ;
      b' : W0.Ix (UU.fib0 I (cD pD)) = DD.trB I (cU e) (cD pD) (symH (PDU pD e)) b0 ;
      R1 : Id (EBd.TB.EI I) (E3d.toB I (E3d.fromB I ((idH I, pD), b')) e') ((idH I, pD), b') =
        transH (E3d.toB-cong I (E3d.fromB I ((idH I, pD), b')) (E3d.fromB I ((idH I, pD), b')) (refl (E3d.fromB I ((idH I, pD), b'))) e' pD)
               (E3d.toB-fromB I ((idH I, pD), b')) ;
      s0 : W0.Ix (UU.fib0 I (cD e')) = (E3d.toB I (E3d.fromB I ((idH I, pD), b')) e').2 ;
      Q : Id (UU.U0 I) (cD e') (cD pD) = apH (codeD I) (apH (\ zz -> zz.1) R1) ;
      Pc : Id (UU.U0 I) (cU e) (cU e2) = apH (\ q -> cU q) (isProp-IsT' (UB.CU.full I w) e e2) ;

      sEq : Id (W0.Ix (UU.fib0 I (cU e2))) (DD.trB I (cD e') (cU e2) (PDU e' e2) s0) (DD.trB I (cU e) (cU e2) Pc b0) =
        calc (W0.Ix (UU.fib0 I (cU e2))) {
            DD.trB I (cD e') (cU e2) (PDU e' e2) s0
          =< apH (DD.trB I (cD e') (cU e2) (PDU e' e2)) (symH (trRound I (cD e') (cD pD) Q (symH Q) s0)) >
            DD.trB I (cD e') (cU e2) (PDU e' e2) (DD.trB I (cD pD) (cD e') (symH Q) (DD.trB I (cD e') (cD pD) Q s0))
          =< apH (\ t -> DD.trB I (cD e') (cU e2) (PDU e' e2) (DD.trB I (cD pD) (cD e') (symH Q) t))
               (sndD I (E3d.toB I (E3d.fromB I ((idH I, pD), b')) e') ((idH I, pD), b') R1) >
            DD.trB I (cD e') (cU e2) (PDU e' e2) (DD.trB I (cD pD) (cD e') (symH Q) b')
          =< trC-comp I (cD pD) (cD e') (cU e2) (symH Q) (PDU e' e2) b' >
            DD.trB I (cD pD) (cU e2) (transH (symH Q) (PDU e' e2)) b'
          =< trC-comp I (cU e) (cD pD) (cU e2) (symH (PDU pD e)) (transH (symH Q) (PDU e' e2)) b0 >
            DD.trB I (cU e) (cU e2) (transH (symH (PDU pD e)) (transH (symH Q) (PDU e' e2))) b0
          =< trC-irr I (cU e) (cU e2) (transH (symH (PDU pD e)) (transH (symH Q) (PDU e' e2))) Pc b0 >
            DD.trB I (cU e) (cU e2) Pc b0 } ;

      res : Id (V1.Ix obU) (phA true e' (psA true e y)) y =
        E3u.TX.pr-inj I w (phA true e' (psA true e y)) y
          (calc (E3u.TX.EI I) {
              E3u.fromB I ((w, e2), DD.trB I (cD e') (cU e2) (PDU e' e2) s0)
            =< apH (\ t -> E3u.fromB I ((w, e2), t)) sEq >
              E3u.fromB I ((w, e2), DD.trB I (cU e) (cU e2) Pc b0)
            =< apH (E3u.fromB I)
                 (symH (tbEqU I (w, e) (w, e2) (UB.CU.res-eq I (w, e) (w, e2) (refl w)) b0 (DD.trB I (cU e) (cU e2) Pc b0)
                    (trC-irr I (cU e) (cU e2) (apH (UB.bmap.nt I) (UB.CU.res-eq I (w, e) (w, e2) (refl w))) Pc b0))) >
              E3u.fromB I ((w, e), b0)
            =< E3u.fromB-toB I (w, y) e >
              (w, y) }) ;
    } ;

    -- ph o ps, the pairs case
    module RP' (e : Id Bool (UB.CU.full I w) false) (e' : Id Bool (DT.CL.full I (idH I)) false) (y : V1.Ix obU) {
      v : EBu.Pairs I w = E3u.toP I (w, y) e ;
      tp : Id (EBd.Pairs I (idH I)) (E3d.toP I (E3d.fromP I (idH I) (npD e) PS[v].psiP) e') PS[v].psiP =
        transH (apH (E3d.toP I (E3d.fromP I (idH I) (npD e) PS[v].psiP)) (isSet-Bool (DT.CL.full I (idH I)) false e' (npD e)))
               (E3d.toP-fromP I (idH I) (npD e) PS[v].psiP) ;
      res : Id (V1.Ix obU) (phA false e' (psA false e y)) y =
        E3u.TX.pr-inj I w (phA false e' (psA false e y)) y
          (calc (E3u.TX.EI I) {
              E3u.fromP I w (npU e') PH[E3d.toP I (E3d.fromP I (idH I) (npD e) PS[v].psiP) e'].phiP
            =< apH (\ u -> E3u.fromP I w (npU e') PH[u].phiP) tp >
              E3u.fromP I w (npU e') PH[PS[v].psiP].phiP
            =< apH (E3u.fromP I w (npU e')) (phipsi v) >
              E3u.fromP I w (npU e') v
            =< apH (\ n -> E3u.fromP I w n v) (isSet-Bool (UB.CU.full I w) false (npU e') e) >
              E3u.fromP I w e (E3u.toP I (w, y) e)
            =< E3u.fromP-toP I (w, y) e >
              (w, y) }) ;
    } ;

    rtU : (c : Bool) (e : Id Bool (UB.CU.full I w) c) (c' : Bool) (e' : Id Bool (DT.CL.full I (idH I)) c') (y : V1.Ix obU)
      -> Id (V1.Ix obU) (phA c' e' (psA c e y)) y = split {
      true -> \ e -> split {
        true -> \ e' y -> RB'[e, e', y].res ;
        false -> \ e' y -> absurd _ (false-true (transH (symH e') (fU2D e))) } ;
      false -> \ e -> split {
        true -> \ e' y -> absurd _ (false-true (transH (symH e) (fD2U e'))) ;
        false -> \ e' y -> RP'[e, e', y].res } } ;

    ph-ps (y : V1.Ix obU) : Id (V1.Ix obU) (ph (ps y)) y =
      rtU (UB.CU.full I w) (refl (UB.CU.full I w)) (DT.CL.full I (idH I)) (refl (DT.CL.full I (idH I))) y ;

    opaque ps-ph ; opaque ph-ps ;
  } ;
} ;