-- FunExtUA.seg: function extensionality from univalence (HoTT book §4.9),
-- at a level l, using only (univ A B).sec and .sec-eq; no funext.
--
--   cf        the fibres of postcomposition with an equivalence are
--             contractible: by sec-eq the equivalence is idtoeqv (ua e),
--             and along a path it is J, with the identity (eta) at refl
--   pr1E      pr1 : Sigma P -> A is an equivalence if every P x is
--             contractible
--   wfe       weak funext: Pi P is a retract of the fibre over id of
--             postcomposition with pr1, hence contractible
--   FE.fe     full funext, in the form of Axioms.FunExt: Sigma (g) Pi (x)
--             f x = g x is contractible (a retract of Pi (x) Sigma (y)
--             f x = y), and funext h is the first component of its paths

level l ;
open Base ;
open Prelude[l] ;

isContr (T : U l) : U l = (c : T) * ((y : T) -> Id T c y) ;

-- in a contractible type any two points are joined, and a point to itself
-- by refl
pathC (T : U l) (k : isContr T) (u v : T) : Id T u v = trans T u k.1 v (sym T k.1 u (k.2 u)) (k.2 v) ;

pathC-refl (T : U l) (k : isContr T) (u : T) : Id (Id T u u) (pathC T k u u) (refl u) = trans-sym-l T k.1 u (k.2 u) ;

-- singletons
sing (T : U l) (t : T) : isContr ((y : T) * Id T y t) =
  ((t, refl t), \ w -> idJ T w.1 (\ t' q' -> Id ((y : T) * Id T y t') (t', refl t') (w.1, q')) (refl (w.1, refl w.1)) t w.2) ;

-- postcomposition and its fibres
post (X C D : U l) (f : C -> D) (h : X -> C) : X -> D = \ x -> f (h x) ;

fibP (X C D : U l) (f : C -> D) (t : X -> D) : U l = (h : X -> C) * Id (X -> D) (post X C D f h) t ;

cfp (X C : U l) : (D : U l) (p : Id (U l) C D) (t : X -> D) -> isContr (fibP X C D (Axioms[l].idtoeqv C D p).1 t) =
  \ D p -> idJ (U l) C (\ D' p' -> (t : X -> D') -> isContr (fibP X C D' (Axioms[l].idtoeqv C D' p').1 t)) (\ t -> sing (X -> C) t) D p ;

module FE (univ : Axioms[l].Univalence) {

  cf (X C D : U l) (e : Equiv C D) (t : X -> D) : isContr (fibP X C D e.1 t) =
    subst (Equiv C D) (\ e' -> isContr (fibP X C D e'.1 t)) (Axioms[l].idtoeqv C D ((univ C D).sec e)) e
      ((univ C D).sec-eq e) (cfp X C D ((univ C D).sec e) t) ;

  -- pr1 is an equivalence when the fibres are contractible
  pr1E (A : U l) (P : A -> U l) (c : (x : A) -> isContr (P x)) : Equiv ((x : A) * P x) A =
    (\ w -> w.1,
     qinv ((x : A) * P x) A (\ w -> w.1) (\ a -> (a, (c a).1)) (\ a -> refl a)
       (\ w -> Sigma-path A P w.1 w.1 (c w.1).1 w.2 (refl w.1) ((c w.1).2 w.2))) ;

  -- weak funext
  wfe (A : U l) (P : A -> U l) (c : (x : A) -> isContr (P x)) : isContr ((x : A) -> P x) =
    (r k0.1, \ g -> ap (fibP A ((x : A) * P x) A (\ w -> w.1) (\ x -> x)) ((x : A) -> P x) r k0.1 (s g) (k0.2 (s g)))
   where {
     k0 : isContr (fibP A ((x : A) * P x) A (\ w -> w.1) (\ x -> x)) = cf A ((x : A) * P x) A (pr1E A P c) (\ x -> x) ;
     s (g : (x : A) -> P x) : fibP A ((x : A) * P x) A (\ w -> w.1) (\ x -> x) = (\ x -> (x, g x), refl (\ x -> x)) ;
     r (w : fibP A ((x : A) * P x) A (\ w -> w.1) (\ x -> x)) : (x : A) -> P x =
       \ x1 -> subst A P (w.1 x1).1 x1 (happly A (\ x0 -> A) (\ x'' -> (w.1 x'').1) (\ x' -> x') w.2 x1) (w.1 x1).2 ;
   } ;

  -- the based total space of pointwise paths is contractible
  totC (A : U l) (B : A -> U l) (f : (x : A) -> B x)
    : isContr ((g : (x : A) -> B x) * ((x : A) -> Id (B x) (f x) (g x))) =
    ((\ x -> (k1.1 x).1, \ x -> (k1.1 x).2),
     \ w -> ap ((x : A) -> (y : B x) * Id (B x) (f x) y) ((g : (x : A) -> B x) * ((x : A) -> Id (B x) (f x) (g x)))
              (\ t -> (\ x -> (t x).1, \ x -> (t x).2)) k1.1 (\ x -> (w.1 x, w.2 x)) (k1.2 (\ x -> (w.1 x, w.2 x))))
   where {
     singL (T : U l) (t : T) : isContr ((y : T) * Id T t y) =
       ((t, refl t), \ w -> idJ T t (\ y' q' -> Id ((y : T) * Id T t y) (t, refl t) (y', q')) (refl (t, refl t)) w.1 w.2) ;
     k1 : isContr ((x : A) -> (y : B x) * Id (B x) (f x) y) =
       wfe A (\ x'' -> (y : B x'') * Id (B x'') (f x'') y) (\ x' -> singL (B x') (f x')) ;
   } ;

  fe : Axioms[l].FunExt = \ A B f g ->
      struct {
        sec = fx A B f g ;
        sec-eq = \ h -> hx A B f g h ;
        ret = fx A B f g ;
        ret-eq = \ p -> rx A B f g p
      }
     where {
       T (A : U l) (B : A -> U l) (f : (x : A) -> B x) : U l = (g : (x : A) -> B x) * ((x : A) -> Id (B x) (f x) (g x)) ;
       rf (A : U l) (B : A -> U l) (f : (x : A) -> B x) : T A B f = (f, \ x -> refl (f x)) ;
       pth (A : U l) (B : A -> U l) (f g : (x : A) -> B x) (h : (x : A) -> Id (B x) (f x) (g x)) : Id (T A B f) (rf A B f) (g, h) =
         pathC (T A B f) (totC A B f) (rf A B f) (g, h) ;
       fx (A : U l) (B : A -> U l) (f g : (x : A) -> B x) (h : (x : A) -> Id (B x) (f x) (g x)) : Id ((x : A) -> B x) f g =
         ap (T A B f) ((x : A) -> B x) (\ w -> w.1) (rf A B f) (g, h) (pth A B f g h) ;
       -- happly of the first component of a path from rf is its second component
       hP (A : U l) (B : A -> U l) (f : (x : A) -> B x) (w : T A B f) (P : Id (T A B f) (rf A B f) w)
         : Id ((x : A) -> Id (B x) (f x) (w.1 x)) (happly A B f w.1 (ap (T A B f) ((x : A) -> B x) (\ w' -> w'.1) (rf A B f) w P)) w.2 =
         idJ (T A B f) (rf A B f)
           (\ w2 P2 -> Id ((x : A) -> Id (B x) (f x) (w2.1 x)) (happly A B f w2.1 (ap (T A B f) ((x : A) -> B x) (\ w' -> w'.1) (rf A B f) w2 P2)) w2.2)
           (refl (\ x -> refl (f x))) w P ;
       hx (A : U l) (B : A -> U l) (f g : (x : A) -> B x) (h : (x : A) -> Id (B x) (f x) (g x))
         : Id ((x : A) -> Id (B x) (f x) (g x)) (happly A B f g (fx A B f g h)) h = hP A B f (g, h) (pth A B f g h) ;
       rx (A : U l) (B : A -> U l) (f g : (x : A) -> B x) (p : Id ((x : A) -> B x) f g)
         : Id (Id ((x : A) -> B x) f g) (fx A B f g (happly A B f g p)) p =
         idJ ((x : A) -> B x) f (\ g2 p2 -> Id (Id ((x : A) -> B x) f g2) (fx A B f g2 (happly A B f g2 p2)) p2)
           (ap (Id (T A B f) (rf A B f) (rf A B f)) (Id ((x : A) -> B x) f f) (\ P -> ap (T A B f) ((x : A) -> B x) (\ w -> w.1) (rf A B f) (rf A B f) P)
              (pth A B f f (\ x -> refl (f x))) (refl (rf A B f)) (pathC-refl (T A B f) (totC A B f) (rf A B f)))
           g p ;
     } ;
} ;
