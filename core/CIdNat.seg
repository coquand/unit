-- CIdNat.seg (L3, inside CB, level l): the composition of Swan's identity
-- type commutes with moves (model.tex Prop "Id is fibrant", naturality).
-- For r : D -> G and a composition cP of Path A a b, the composition of
-- Id(a[r] , b[r]) built from the moved path composition is the move of the
-- composition of Id(a , b) along the cart of CIdCart.  With CPathNat
-- (the moved path composition is the substituted one) this is the
-- naturality of Thm "type formers" for Id.
--
-- Proof by MoveComp.unique, value by value: the point is r of the point;
-- the path is the path composite (kopMv of the path move, and the problem
-- read in the path type moves: ptEq, sideEq); the sieve is the dependent
-- conjunction of equal families (dconj-cong: the cart keeps the sieves).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module IdNatC (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a0 b : PEl[G, A]) (e e' : IPt)
  (cP : CLine[l].Lines[G, CPathFib[l].PathFib[G, A, a0, b].PathT].CompK[e, e'].Comp) (dc : CId[l].DConj) {
  module IC = CIdCart[l].IdCart[D, G, r, A, a0, b] ;
  module PC = IC.PC ;
  module PF = PC.PF ;
  module PF' = PC.PF' ;
  module MP = PC.C.MoveComp[e, e'] ;
  module MI = IC.C.MoveComp[e, e'] ;
  module I = CIdFib[l].IF[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act, e, e', cP, dc] ;
  module I' = CIdFib[l].IF[D, D, PC.A', PF'.s, PF'.sN, PF'.PE.aE, PF'.PE.bE, PF'.PE.aE-act, PF'.PE.bE-act, e, e', MP.move cP, dc] ;

  -- a0 composite of Id(a0[r] , b[r]), moved and read in E, is the cart of its reading
  R1 (W : Ob) (v : I'.TTI.EI W) : Id (I.TI.EI W) (I.rdI W (MI.mT W v)) (IC.taI W (I'.rdI W v)) =
    MI.E'.sVE W (I'.CKI.SE.mV W v) ;

  -- the point of a0 problem, read in the path type, moves
  ptEq (W : Ob) (z : I'.TVI.EI W) : Id (I.TVP.EI W) (MP.E.sV W (I'.sP W z)) (I.sP W (MI.E.sV W z)) =
    I.EKP.tv-eq W (MP.E.sV W (I'.sP W z)) (I.sP W (MI.E.sV W z)) (refl (MP.E.sV W (I'.sP W z)).1)
      (transH (MP.E.sVE W (I'.sP W z)) (apH (I.IO.proj.mE W) (symH (MI.E.sVE W z)))) ;

  -- and so does its side
  sideV (W : Ob) (v v' : I'.TSI.EI W) (P : Id (I'.TVI.EI W) v.1 v'.1)
    (L : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (I'.TI.EI V) ((I'.EKI.lineL W v).2.1.1 V g j) ((I'.EKI.lineL W v').2.1.1 V g j))
    : Id (I.TSP.EI W) (MP.E.mS W (I'.mS W v)) (I.mS W (MI.E.mS W v')) =
    I.EKP.ts-ext W (MP.E.mS W (I'.mS W v)) (I.mS W (MI.E.mS W v'))
      (transH (MP.E.mSpt W (I'.mS W v))
        (transH (apH (MP.E.sV W) (I'.mS-pt W v))
          (transH (apH (\ z -> MP.E.sV W (I'.sP W z)) P)
            (transH (ptEq W v'.1) (symH (transH (I.mS-pt W (MI.E.mS W v')) (apH (I.sP W) (MI.E.mSpt W v'))))))))
      (\ V g j -> transH (apH (\ M -> M.2.1.1 V g j) (MP.E.mS-line W (I'.mS W v)))
         (transH (apH (\ M -> PC.ta V (M.2.1.1 V g j)) (I'.mS-line W v))
           (transH (apH (\ z -> I.IO.proj.mE V (IC.taI V z)) (L V g j))
             (symH (transH (apH (\ M -> M.2.1.1 V g j) (I.mS-line W (MI.E.mS W v')))
                      (apH (\ M -> I.IO.proj.mE V (M.2.1.1 V g j)) (MI.E.mS-line W v'))))))) ;

  module H (X : Ob) (x : I'.TVI.EI X) (sd : I'.PTI.Side[X, x]) {
    sdG : I.PTI.Side[X, MI.E.sV X x] = MI.mside I.comp X x sd ;

    sideEq : Id (I.PTP.Side[X, I.sP X (MI.E.sV X x)])
                (subst (I.TVP.EI X) (\ z -> I.PTP.Side[X, z]) (MP.E.sV X (I'.sP X x)) (I.sP X (MI.E.sV X x)) (ptEq X x)
                   (MP.mside cP X (I'.sP X x) (I'.mside X x sd)))
                (I.mside X (MI.E.sV X x) sdG) =
      I.PTP.side-extH X (MP.E.sV X (I'.sP X x)) (I.sP X (MI.E.sV X x)) (ptEq X x)
        (MP.mside cP X (I'.sP X x) (I'.mside X x sd)) (I.mside X (MI.E.sV X x) sdG)
        (refl sd.pQ)
        (\ W f i i' -> sideV W (sd.pv W f i) (sd.pv W f i') (apH (\ z -> z.1) (I'.PTI.pv-irr X x sd W f i i'))
           (\ V g j -> apH (\ z -> (I'.EKI.lineL W z).2.1.1 V g j) (I'.PTI.pv-irr X x sd W f i i'))) ;

    -- the path composites
    pathEq : Id (I.TP.EI X) (PC.ta X (I'.rdP X I'.F[X, x, sd].pk)) (I.rdP X I.F[X, MI.E.sV X x, sdG].pk) =
      transH (symH (MP.E'.sVE X (MP.CK'.SE.mV X I'.F[X, x, sd].pk)))
        (apH (I.rdP X)
           (transH (MP.kopMv cP X (I'.sP X x) (I'.mside X x sd))
              (I.RCP.kop-cong cP X (MP.E.sV X (I'.sP X x)) (I.sP X (MI.E.sV X x)) (ptEq X x)
                 (MP.mside cP X (I'.sP X x) (I'.mside X x sd)) (I.mside X (MI.E.sV X x) sdG) sideEq))) ;

    -- the families of sieves agree
    famEq (W : Ob) (f : Hom W X) (i : Lands W X sd.pQ f) : Id (Phi W) (I'.F[X, x, sd].Fs W f i) (I.F[X, MI.E.sV X x, sdG].Fs W f i) =
      apH (\ z -> z.2.2.1)
        (symH (transH (apH (I.rdI W) (symH (MI.sq W (sd.pv W f i)))) (R1 W (I'.CKI.endL.mE W (sd.pv W f i))))) ;

    val : Id (MI.TT.EI X) (MI.mT X (x, I'.comp.kop X x sd)) (MI.E.sV X x, I.comp.kop X (MI.E.sV X x) sdG) =
      I.ttI-ext X (MI.mT X (x, I'.comp.kop X x sd)) (MI.E.sV X x, I.comp.kop X (MI.E.sV X x) sdG) (refl (MI.E.sV X x))
        (transH (R1 X (x, I'.comp.kop X x sd))
          (I.IO.tpI-ext X (IC.taI X (I'.rdI X (x, I'.comp.kop X x sd))) (I.rdI X (MI.E.sV X x, I.comp.kop X (MI.E.sV X x) sdG))
             (refl ((IC.taI X (I'.rdI X (x, I'.comp.kop X x sd))).1))
             (\ V g j -> apH (\ z -> z.2.1.1 V g j) pathEq)
             (CId[l].dconj-cong dc X sd.pQ I'.F[X, x, sd].Fs I.F[X, MI.E.sV X x, sdG].Fs
                I'.F[X, x, sd].Fn I.F[X, MI.E.sV X x, sdG].Fn famEq))) ;
  } ;

  -- Id's composition from the moved path composition is the moved one
  nat : Id (I'.CKI.Comp) I'.comp (MI.move I.comp) = MI.unique I.comp I'.comp (\ X x sd -> H[X, x, sd].val) ;
} ;
