-- Naturality of the normalised Delta fillers along cartesian maps over
-- stagewise injective maps of contexts, including a change of level.
level a k l ;
constraint a <= k ;
constraint k <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ;
open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDSimpId[a] ;
open CDLvl[a, l] ;
module DB = CDeltaBase[a].DB ;
module WD = V[k] ;
module WG = V[l] ;
module PD = DB.GPre[k] ;
module PG = DB.GPre[l] ;

module Along
  (D : PD.PS.PCtx) (A' : PD.PS.PTy[D]) (G : PG.PS.PCtx) (A : PG.PS.PTy[G])
  (s : (W : Nat) -> WD.Ix (D.ob W) -> WG.Ix (G.ob W))
  (sn : (V W : Nat) (g : Hom (lin V) (lin W)) (x : WD.Ix (D.ob W))
     -> Id (WG.Ix (G.ob V)) (s V (D.act V W g x)) (G.act V W g (s W x)))
  (ta : (W : Nat) -> PD.TyL[D, A'].EI W -> PG.TyL[G, A].EI W)
  (tp : (W : Nat) (u : PD.TyL[D, A'].EI W)
     -> Id (WG.Ix (G.ob W)) (PG.TyL[G, A].pr1 W (ta W u)) (s W u.1))
  (tn : (V W : Nat) (g : Hom (lin V) (lin W)) (u : PD.TyL[D, A'].EI W)
     -> Id (PG.TyL[G, A].EI V) (PG.TyL[G, A].E.act V W g (ta W u)) (ta V (PD.TyL[D, A'].E.act V W g u)))
  (ti : (W : Nat) (u v : PD.TyL[D, A'].EI W)
     -> Id (WD.Ix (D.ob W)) u.1 v.1 -> Id (PG.TyL[G, A].EI W) (ta W u) (ta W v)
     -> Id (PD.TyL[D, A'].EI W) u v)
  (bk : (W : Nat) (x : WD.Ix (D.ob W)) -> WG.Ix (A.tob W (s W x)) -> WD.Ix (A'.tob W x))
  (bt : (W : Nat) (x : WD.Ix (D.ob W)) (u : WG.Ix (A.tob W (s W x)))
     -> Id (PG.TyL[G, A].EI W) (ta W (x, bk W x u)) (s W x, u))
  (si : (W : Nat) (x y : WD.Ix (D.ob W)) -> Id (WG.Ix (G.ob W)) (s W x) (s W y) -> Id (WD.Ix (D.ob W)) x y) {
  module C = DB.CCart[l, k].Cart[D, A', G, A, s, sn, ta, tp, tn, ti, bk, bt] ;

  module TA' = C.TA' ;
  module TA = C.TA ;
  module DH' = CDHornFib[a, k].DH[D, A'] ;
  module DH = CDHornFib[a, l].DH[G, A] ;
  open CDeltaCl[a] ;

  -- A cartesian map of horn operations sends the chosen filler to the
  -- chosen filler whenever the base points and horn values correspond.
  HornLaw (h' : DH'.isFib) (h : DH.isFib) : U l =
    (m i : Nat) (hi : IsT (leb i (suc m)))
    (x : TA'.Pt (suc m)) (y : TA.Pt (suc m)) (q : Id (TA.Pt (suc m)) (s (suc m) x) y)
    (u : DH'.HornData m i x) (v : DH.HornData m i y)
    (r : (W : Nat) (f : Hom (lin W) (lin (suc m))) (j : DB.Lands W (suc m) (hornS m i) f)
       -> Id (TA.EI W) (ta W (u.1 W f j)) (v.1 W f j))
    -> Id (TA.EI (suc m)) (ta (suc m) (TA'.pr (suc m) x (h' m i hi x u).1))
                          (TA.pr (suc m) y (h m i hi y v).1) ;

  import CDHornPrism ;

  module At (e : El Iv) {
    module E = C.AtEnd[e] ;
    module SD = CDStageA[a, k].SA[D, A', e] ;
    module SG = CDStageA[a, l].SA[G, A, e] ;
    module HD = CDeltaHornBox[a, k].HB1[D, A', e] ;
    module HG = CDeltaHornBox[a, l].HB1[G, A, e] ;

    line-inj (N : Nat) (x y : WD.Ix (C.FD.ob N)) (q : Id (WG.Ix (C.FG.ob N)) (C.sI N x) (C.sI N y))
      : Id (WD.Ix (C.FD.ob N)) x y =
      C.FD.fam-eq N x y (\ W f j -> si W (x.1 W f j) (y.1 W f j) (apH (\ z -> z.1 W f j) q)) ;

    point-inj (N : Nat) (x y : SD.KA.TV.EI N) (q : Id (SG.KA.TV.EI N) (E.sV N x) (E.sV N y))
      : Id (SD.KA.TV.EI N) x y =
      E.sV-inj N x y (line-inj N (SD.KA.TV.pr1 N x) (SD.KA.TV.pr1 N y) (apH (SG.KA.TV.pr1 N) q)) q ;

    fibre-inj (N : Nat) (x y : SD.KA.TS.EI N) (q : Id (SG.KA.TS.EI N) (E.mS N x) (E.mS N y))
      : Id (SD.KA.TS.EI N) x y =
      E.mS-inj N x y (point-inj N (SD.KA.TS.pr1 N x) (SD.KA.TS.pr1 N y)
        (transH (symH (E.mSpt N x)) (transH (apH (SG.KA.TS.pr1 N) q) (E.mSpt N y)))) q ;

    image (N : Nat) (b : SD.Prob N) : SG.Prob N =
      (E.sV N b.1, new SG.KA.PT.Side[N, E.sV N b.1, b.2.pQ,
        \ W f i -> E.mS W (b.2.pv W f i),
        \ W f i -> transH (E.mSpt W (b.2.pv W f i))
          (transH (apH (E.sV W) (b.2.ppt W f i)) (E.sV-nat W N f b.1)),
        \ V W g f i j -> transH (E.mSnat V W g (b.2.pv W f i)) (apH (E.mS V) (b.2.pnat V W g f i j))]) ;

    image-inj (N : Nat) (b c : SD.Prob N) (q : Id (SG.Prob N) (image N b) (image N c)) : Id (SD.Prob N) b c =
      HD.rel-id N b c
        (point-inj N b.1 c.1 (apH (\ z -> z.1) q),
         ((HG.id-rel N (image N b) (image N c) q).2.1,
          \ W f i j -> fibre-inj W (b.2.pv W f i) (c.2.pv W f j)
            ((HG.id-rel N (image N b) (image N c) q).2.2 W f i j))) ;

    image-res (M N : Nat) (f : Hom (lin M) (lin N)) (b : SD.Prob N)
      : Id (SG.Prob M) (image M (SD.resP M N f b)) (SG.resP M N f (image N b)) =
      HG.rel-id M _ _ (E.sV-nat M N f b.1, (refl (DB.pre M N f b.2.pQ),
        \ W g i j -> apH (E.mS W) (SD.KA.PT.pv-irr N b.1 b.2 W
          (compH (lin W) (lin M) (lin N) f g)
          (DB.lands-pre W M N f b.2.pQ g i) (DB.lands-pre W M N f b.2.pQ g j)))) ;

    opaque image-inj ; opaque image-res ;
    import CDHornProb ;
    open CDHornProb ;
    import CDHornBoundary ;
  } ;
  import CDHornNormal ;
} ;
