-- Initiality: a natural map preserving inc and ext equals the recursor.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module Unique (G : PCtx) (A B : PTy[G])
  (k : CTruncAlg[a,l].Algebras[G,B].Algebra) (f : HO.NMap[G,A,B])
  (g : HO.NMap[G,CTrunc[a,l].Truncation[G,A].Ty,B])
  (ge : CTruncHom[a,l].Maps[G,CTrunc[a,l].Truncation[G,A].Ty,B,g].Preserves
    CTrunc[a,l].Truncation[G,A].algebra k)
  (gi : (z : CTruncRaw[a,l].Build[G,A].Loc) (v : W.Ix (A.tob z.1 z.2)) ->
    Id (W.Ix (B.tob z.1 z.2))
      (g.nfun z.1 z.2 (CTruncRaw[a,l].Build[G,A].inc z v)) (f.nfun z.1 z.2 v)) {
  open CTruncRaw[a,l].Build[G,A] ;
  open CTruncGood[a,l].GoodSets[G,A] ;
  module T = CTrunc[a,l].Truncation[G,A] ;
  module R = T.Recursor[B,k,f] ;
  module K = CTruncAlg[a,l].Algebras[G,B] ;
  module M = CTruncHom[a,l].Maps[G,T.Ty,B,g] ;
  module E = CTruncEta[a,l].Eta[G,A] ;
  module Gr = CTruncGraph[a,l].Graph[G,A,B,k,R.ff] ;
  Pred (t : Raw) : U l = (good : Good t) (z : Loc) (e : Id Loc (root t) z) ->
    Gr.Eval t (z,M.at z (t,(good,e))) ;
  reroot (t : Raw) (good : Good t)
    (d : Gr.Eval t (root t,M.at (root t) (t,(good,refl (root t)))))
    (z : Loc) (e : Id Loc (root t) z) : Gr.Eval t (z,M.at z (t,(good,e))) =
    idJ Loc (root t) (\ w p -> Gr.Eval t (w,M.at w (t,(good,p)))) d z e ;
  module Node (z : Loc) (Q : PB.Phi z.1)
    (u : (s : Loc) -> Arr s z -> Raw)
    (v : (s : Loc) (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> Raw)
    (iu : (s : Loc) (h : Arr s z) -> Pred (u s h))
    (iv : (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) -> Pred (v s h i))
    (good : Good (node z Q u v)) {
    module N = E.Node[z,Q,u,v,good] ;
    bu (s : Loc) (h : Arr s z) : K.F s = M.at s (N.tu s h) ;
    bv : K.Partial z Q = M.partial z Q N.tv ;
    bn : K.SeedNat z bu = \ s h r q ->
      transH (M.nat r s q (N.tu s h)) (apH (M.at r) (N.un s h r q)) ;
    vn : K.Natural z Q bv = M.natural z Q N.tv N.vn ;
    eqn : Id (K.F z) (k.extend z Q (bu z (ident z)) bv vn)
      (M.at z (node z Q u v,(good,refl z))) =
      transH (symH (ge z Q (N.tu z (ident z)) N.tv N.vn)) (apH (M.at z) N.eta) ;
    result : Gr.Eval (node z Q u v) (z,M.at z (node z Q u v,(good,refl z))) =
      new Gr.NodeGraph[z,Q,\ s h -> Gr.Eval (u s h),\ s h i -> Gr.Eval (v s h i),
        (z,M.at z (node z Q u v,(good,refl z))),bu,bv,bn,vn,
        \ s h -> iu s h (N.tu s h).2.1 s (N.tu s h).2.2,
        \ s h i -> iv s h i (N.tv s h i).2.1 s (N.tv s h i).2.2,
        apH (\ b -> (z,b)) eqn] ;
  } ;
  graph : (t : Raw) -> Pred t = split {
    leaf z v -> \ good w e -> reroot (leaf z v) good
      (apH (\ b -> (z,b)) (transH (symH (gi z v))
        (apH (M.at z) (tr-eq z (inc z v) (leaf z v,(good,refl z)) (refl (leaf z v)))))) w e ;
    node z Q u v | iu iv -> \ good w e ->
      reroot (node z Q u v) good Node[z,Q,u,v,iu,iv,good].result w e
  } ;
  opaque graph ;
  unique (z : Loc) (t : TrEl z) : Id (K.F z) (M.at z t) (R.map.nfun z.1 z.2 t) =
    K.fibre-inj z _ _ (Gr.unique t.1 _ _ (graph t.1 t.2.1 z t.2.2) (R.R.rec-graph z t)) ;
  opaque unique ;
} ;
