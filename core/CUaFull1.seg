-- CUaFull1.seg (L6, inside CB): full points, part (i) (model.tex
-- lem:full-move (i)).  For every glue datum D, e_D is e_U moved along D's
-- point cart (CExtEq1.Pt).  At a local point x the glued extension is
-- read at the image y of x through the point o y; CExtEq2's coherence,
-- stated there at o g, holds at every x (ChG, same proof); then Move's
-- uniqueness.

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module FI (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (Z : Ob) (D : CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl].GD1 Z) {
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module GE = CGlueE.GE[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E1 = CExtEq1.EQ1[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module E2 = CExtEq2.EQ2[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module PD = E1.Pt[Z, D] ;
  module PU = CPartial[a].Partials[PD.H.F'.EA, PD.H.F'.FibT] ;

  -- the coherence of the gluing (CExtEq2.Ch) at an arbitrary local point x
  module ChG (X : Ob) (x : W0.Ix (PD.H.F'.EA.ob X)) {
    g : Hom X Z = x.1.1 ;
    y : UB.TAU.EI X = PD.tA X x ;
    module C0 = E2.Co[Z, D, X, g] ;
    module PD' = C0.PD' ;
    module CHI = C0.CHI ;
    module RD = CPartial[a].Rel[PD.H.F'.EA, PD.H.F'.FibT, PD.H.F'.FibT, CPartial[a].pmap-id PD.H.F'.EA PD.H.F'.FibT] ;

    c' : W0.Ix (PD.H.F'.EA.ob X) = CHI.tA X (E2.o X y) ;

    P : Id (W0.Ix (PD.H.F'.EA.ob X)) x c' =
      PD.tAinj X x c'
        (CGlueE.RCm[Z, D.1.2.1].pt-eq X x.1 c'.1 (symH (comp-idr X Z g)))
        (transH (symH (E2.oio X y)) (C0.CompatA X (E2.o X y))) ;

    module K (sg : PU.Side[X, x])
      (sg' : CPartial[a].Partials[PD'.H.F'.EA, PD'.H.F'.FibT].Side[X, E2.o X y])
      (HQ : Id (Phi X) sg.pQ sg'.pQ)
      (Hv : (V : Ob) (f : Hom V X) (i : Lands V X sg.pQ f) (i' : Lands V X sg'.pQ f)
            -> Id (E2.F.TF.EI V) (PD.H.mS V (sg.pv V f i)) (PD'.H.mS V (sg'.pv V f i'))) {
      R : Id (PU.Side[X, c']) (subst (W0.Ix (PD.H.F'.EA.ob X)) (\ z -> PU.Side[X, z]) x c' P sg) (CHI.H.C.mside D.2 X (E2.o X y) sg') =
        PU.side-extH X x c' P sg (CHI.H.C.mside D.2 X (E2.o X y) sg') HQ
          (\ V f i i' -> PD.H.mSinj V (sg.pv V f i) (CHI.H.mS V (sg'.pv V f i'))
             (transH (sg.ppt V f i) (transH (apH ((PD.H.F'.EA).act V X f) P)
                (transH (CHI.tAnat V X f (E2.o X y)) (symH (apH (CHI.tA V) (sg'.ppt V f i'))))))
             (transH (Hv V f i i') (C0.CompatMS V (sg'.pv V f i')))) ;

      coh : Id (E2.F.TF.EI X) (PD.H.mS X (x, D.2.kop X x sg)) (PD'.H.mS X (E2.o X y, (CHI.H.moveEq D.2).kop X (E2.o X y) sg')) =
        transH (apH (PD.H.mS X) (RD.kop-cong D.2 X x c' P sg (CHI.H.C.mside D.2 X (E2.o X y) sg') R))
          (symH (transH (C0.CompatMS X (E2.o X y, (CHI.H.moveEq D.2).kop X (E2.o X y) sg'))
                        (apH (PD.H.mS X) (CHI.H.C.kopMv D.2 X (E2.o X y) sg')))) ;
    } ;

    -- at x, D's extension is e_U's at the image of x
    H (sd : PU.Side[X, x])
      : Id (E2.F.TF.EI X) (PD.H.mS X (x, D.2.kop X x sd)) (PD.tA X x, E2.eqU.kop X (PD.tA X x) (PD.H.C.mside E2.eqU X x sd)) =
      transH (K[sd, E2.GL.sL X y (PD.H.C.mside E2.eqU X x sd), refl sd.pQ,
                \ V f i i' -> transH (apH (PD.H.mS V) (PU.pv-irr X x sd V f i i'))
                   (symH (E2.GL.Loc[X, y, X, y, E2.o X y, E2.oio X y, PD.H.C.mside E2.eqU X x sd].pv-S V f i'))].coh)
             (symH (E2.GL.kop-E X y (PD.H.C.mside E2.eqU X x sd))) ;
  } ;

  -- (i): e_D is e_U moved along D's point cart
  law : Id (GE.EqOn Z D.1) D.2 (PD.H.moveEq E2.eqU) =
    PD.H.uniqueEq E2.eqU D.2 (\ X x sd -> ChG[X, x].H sd) ;
} ;
