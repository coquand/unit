-- CExtL.seg (L5, inside CB): Ext of glue data over a context (model.tex
-- §6.2, def:ext-ell and lem:ext-cmp, Voevodsky's form).  Glue data over D
-- ARE a map l : D -> GD; Ext(l) = l*SA, with the fibration, the map ext to
-- A(l) = l*AS and the equivalence structure of SA moved along l (the carts
-- (d , z) |-> (l d , z), CSmall.SmallFib).  Theorem 7 is thereby proved
-- once, at the universal data.
--
--   AS        A_U as a small type over GD (the fields of A_U), cart AT -> A_U
--   ExtT      Ext(l); fib its fibration; ext; eq the equivalence of ext
--   cmp-full  lem:ext-cmp: on the extent the fibre is B of the datum l rho
--   cmp-not   and off it the glued pairs

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module GPR = GPre[a] ;
open GPR.PS ;
open GYon[a] ;
open Encode[a, a+] ;
module L = GPre[a+].PS ;
module LP = GPre[a+] ;

module EL (Cl : (G : PCtx) -> PTy[G] -> U a+)
  (clSub : (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) -> Cl D (subTy D G A s))
  (clSub-id : (G : PCtx) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c))
  (clSub-o : (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
     -> Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                     (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)))
  (encCl : (X : Ob) (A : PTy[yP X]) -> Enc (Cl (yP X) A))
  (elFib : CLine[a+].Lines[CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].UCtx, CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl].EGen].Fib) {
  module UU = CUniv.Univ[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module UB = CExtBig.UB[Cl, clSub, clSub-id, clSub-o, encCl] ;
  module XS = CExtSmall.XS[Cl, clSub, clSub-id, clSub-o, encCl, elFib] ;
  module TAU = LP.TyL[UB.GDr, UB.AU] ;

  -- A_U as a small type over GD: the fields of subTy, so that l*AS has A_U's fibres
  AS : CSmall.SPTy[UB.GDr] =
    new CSmall.SPTy[UB.GDr, \ I x -> UU.El.tob I (UB.pA.nt I x),
      \ J I f x y e a0 -> UU.El.tact J I f (UB.pA.nt I x) (UB.pA.nt J y) (L.ntEq UB.GDr UU.UCtx UB.pA J I f x y e) a0,
      \ I x e a0 -> UU.El.tact-id I (UB.pA.nt I x) (L.ntEq UB.GDr UU.UCtx UB.pA I I (idH I) x x e) a0,
      \ K J I f g x y z e1' e2 e3 a0 ->
        UU.El.tact-o K J I f g (UB.pA.nt I x) (UB.pA.nt J y) (UB.pA.nt K z)
          (L.ntEq UB.GDr UU.UCtx UB.pA J I f x y e1') (L.ntEq UB.GDr UU.UCtx UB.pA K J g y z e2)
          (L.ntEq UB.GDr UU.UCtx UB.pA K I (compH K J I f g) x z e3) a0] ;

  module At (D : PCtx) (l : CSmall.XSub[D, UB.GDr]) {
    ExtT : PTy[D] = CSmall.xsub D UB.GDr XS.SA l ;
    AT : PTy[D] = CSmall.xsub D UB.GDr AS l ;

    module SFT = CSmall.SmallFib[UB.GDr, XS.SA, D, l] ;
    module TE = GPR.TyL[D, ExtT] ;
    module TA = GPR.TyL[D, AT] ;

    -- the cart AT -> A_U over l
    module SFA {
      ta (W : Ob) (v : TA.EI W) : TAU.EI W = (l.nt W v.1, v.2) ;

      tanat (V W : Ob) (g : Hom V W) (v : TA.EI W) : Id (TAU.EI V) (TAU.E.act V W g (ta W v)) (ta V (TA.E.act V W g v)) =
        TAU.pr-tact V W g (l.nt W v.1) (l.nt V (D.act V W g v.1)) (CSmall.xntEq D UB.GDr l V W g v.1 (D.act V W g v.1) (refl (D.act V W g v.1))) v.2 ;

      tainj (W : Ob) (v v' : TA.EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (TAU.EI W) (ta W v) (ta W v')) : Id (TA.EI W) v v' =
        idJ (W0.Ix (D.ob W)) v.1
          (\ d2 P2 -> (b2 : W0.Ix (AT.tob W d2)) -> Id (TAU.EI W) (l.nt W v.1, v.2) (l.nt W d2, b2) -> Id (TA.EI W) v (d2, b2))
          (\ b2 Q2 -> apH {W0.Ix (AT.tob W v.1)} {TA.EI W} (\ z -> (v.1, z)) (TAU.pr-inj W (l.nt W v.1) v.2 b2 Q2))
          v'.1 P v'.2 Q ;
    } ;

    -- the fibration
    fib : CLine[a].Lines[D, ExtT].Fib = XS.fibExt D l ;

    -- the map to A
    extE (W : Ob) (v : TE.EI W) : TA.EI W =
      (v.1, TAU.fromE W (l.nt W v.1) (XS.extSA.mE W (SFT.ta W v)) (XS.extSA.mpt W (SFT.ta W v))) ;

    extE-ta (W : Ob) (v : TE.EI W) : Id (TAU.EI W) (SFA.ta W (extE W v)) (XS.extSA.mE W (SFT.ta W v)) =
      TAU.fromE-eq W (l.nt W v.1) (XS.extSA.mE W (SFT.ta W v)) (XS.extSA.mpt W (SFT.ta W v)) ;

    extN (V W : Ob) (g : Hom V W) (v : TE.EI W) : Id (TA.EI V) (extE V (TE.E.act V W g v)) (TA.E.act V W g (extE W v)) =
      SFA.tainj V (extE V (TE.E.act V W g v)) (TA.E.act V W g (extE W v)) (refl (D.act V W g v.1))
        (calc (TAU.EI V) {
            SFA.ta V (extE V (TE.E.act V W g v))
          =< extE-ta V (TE.E.act V W g v) >
            XS.extSA.mE V (SFT.ta V (TE.E.act V W g v))
          =< apH (XS.extSA.mE V) (symH (SFT.tanat V W g v)) >
            XS.extSA.mE V (XS.TS.E.act V W g (SFT.ta W v))
          =< XS.extSA.mnat V W g (SFT.ta W v) >
            TAU.E.act V W g (XS.extSA.mE W (SFT.ta W v))
          =< apH (TAU.E.act V W g) (symH (extE-ta W v)) >
            TAU.E.act V W g (SFA.ta W (extE W v))
          =< SFA.tanat V W g (extE W v) >
            SFA.ta V (TA.E.act V W g (extE W v)) }) ;

    opaque extN ;

    ext : CPartial[a].PMap[D, ExtT, AT] = new CPartial[a].PMap[D, ExtT, AT, extE, \ W v -> refl v.1, extN] ;

    -- the equivalence structure: SA's, moved along l
    module H = CHFibCart[a+, a].HCart[D, ExtT, AT, ext, UB.GDr, XS.upSA, UB.AU, XS.extSA, l.nt, l.nt-nat,
      SFA.ta, \ W v -> refl (l.nt W v.1), SFA.tanat, SFA.tainj, \ X x u -> u, \ X x u -> refl (l.nt X x, u),
      SFT.ta, \ W v -> refl (l.nt W v.1), SFT.tanat, SFT.tainj, \ X x u -> u, \ X x u -> refl (l.nt X x, u),
      extE-ta] ;

    eq : CEquiv[a].EquivOp D ExtT AT ext = H.moveEq XS.eqSA ;

    ------------------------------------------------------------------
    -- lem:ext-cmp: the fibre at rho is the direct one for the datum l rho

    module Cmp (X : Ob) (rho : W0.Ix (D.ob X)) {
      module CA = XS.CM.At[X, l.nt X rho] ;
      module EB = CExt[a].ExtDef[yP X, (l.nt X rho).1.1.1, CExtU.psiD X (l.nt X rho).1.2.1].ExtB[CA.DT.BD, CA.DT.alD] ;

      -- on the extent: B of the datum at the identity
      cmp-full (p : IsT (CA.DT.CL.full X (idH X))) : Id W0.V (ExtT.tob X rho) (CA.DT.BD.tob X (idH X, p)) =
        CA.E3d.extOb-B X (idH X) p ;

      -- off the extent: the glued pairs
      cmp-not (np : Id Bool (CA.DT.CL.full X (idH X)) false) : Id W0.V (ExtT.tob X rho) (EB.pairsV X (idH X)) =
        CA.E3d.extOb-P X (idH X) np ;
    } ;
  } ;
} ;
