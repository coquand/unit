-- CDStageC.seg (L8, Delta): seg/model DStageC.seg ported (module names only).  Was: one stage of the filling (FillStage's Case 1 / Case 2, in
-- line form).  For a problem b = (x , p) at [N]:
--
--   Case 1  some side of p contains the identity: the filler is that
--           side's element at the identity (c1)
--   Case 2  no side is full: the prism is filled from its starting partial
--           line L0 b (boundary and lid, DStageB) by the shuffle chain;
--           the filler is the total line, which ends at x (c2)
--
-- The prism filler (tot, for the direction of e) is a parameter: DFill
-- instantiates it with DPrismFill.PF.FT (from e0) and PF.FF (from e1).
--
--   fillF       the filler, by searching for a full side (FillBase.searchFin)
--   fillF-c1    in Case 1 it is the full side
--   fillF-lv    in Case 2 its line is tot
--   Sides       the filler agrees with every side (side-c1 here; Case 2
--               with the faces below: DStageD)
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
open CDCapBase[a] ;

module SC (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t)) {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;
  module SBm = CDStageB[a, lz].SB[G, A, e, eN, eE] ;

  -- the sides of a problem which are full
  fullB (N : Nat) (b : Prob N) : Bool = b.2.pQ.1 N (idH (lin N)) ;

  -- the lid point (id , e) of the prism
  lidc (N : Nat) : IsT (lidB eN N (constH (lin N) Iv e)) =
    fa-i N (\ v -> eqN (valT N (suc zero) (constH (lin N) Iv e) v) eN)
      (\ v hv -> substH (\ t -> IsT (eqN (vnum t) eN)) (transH (symH eE) (valT-tree N (suc zero) (constH (lin N) Iv e) v hv))
                   (eqN-refl eN)) ;

  lid-id (N : Nat) : IsT ((S0 N eN).1 N (idH (lin N)) (constH (lin N) Iv e)) =
    or-r (bdB N N (idH (lin N))) (lidB eN N (constH (lin N) Iv e)) (lidc N) ;

  module Stage (N : Nat) (L0 : (b : Prob N) -> DGm.PL[G, A, N, b.1.1.1, b.1.1.2].PLine[S0 N eN])
    (L0-lid : (b : Prob N) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT ((S0 N eN).1 W f j)) (l : IsT (lidB eN W j))
              -> Id (TA.EI W) ((L0 b).v W f j s) (SBm.Lines[N, b].lidV W f)) {

    --------------------------------------------------------------------
    -- Case 1: a full side

    c1 (b : Prob N) (i : IsT (fullB N b)) : KA.TS.T N b.1 =
      KA.TS.fromE N b.1 (b.2.pv N (idH (lin N)) i) (transH (b.2.ppt N (idH (lin N)) i) (KA.TV.E.act-id N b.1)) ;

    c1-E (b : Prob N) (i : IsT (fullB N b)) : Id (KA.TS.EI N) (b.1, c1 b i) (b.2.pv N (idH (lin N)) i) =
      KA.TS.fromE-eq N b.1 (b.2.pv N (idH (lin N)) i) (transH (b.2.ppt N (idH (lin N)) i) (KA.TV.E.act-id N b.1)) ;

    --------------------------------------------------------------------
    -- Case 2: the prism, from L0

    line (b : Prob N) : KA.TL.EI N =
      (b.1.1, SAm.FT.lamA N b.1.1 (tot N b.1.1.1 b.1.1.2 (L0 b)) (tot-pt N b.1.1.1 b.1.1.2 (L0 b)) (tot-nat N b.1.1.1 b.1.1.2 (L0 b))) ;

    -- the line starts at the point of b
    line-start (b : Prob N) : Id (TA.EI N) (KA.endE N ((SAm.FT.Ev[e].evA).mE N (line b))) (KA.endE N b.1) =
      calc (TA.EI N) {
          KA.endE N ((SAm.FT.Ev[e].evA).mE N (line b))
        =< endL-lev N (line b) >
          levA N (line b) N (idH (lin N)) (constH (lin N) Iv e)
        =< levA-lam N b.1.1 (tot N b.1.1.1 b.1.1.2 (L0 b)) (tot-pt N b.1.1.1 b.1.1.2 (L0 b)) (tot-nat N b.1.1.1 b.1.1.2 (L0 b))
             N (idH (lin N)) (constH (lin N) Iv e) >
          tot N b.1.1.1 b.1.1.2 (L0 b) N (idH (lin N)) (constH (lin N) Iv e)
        =< tot-S0 N b.1.1.1 b.1.1.2 (L0 b) N (idH (lin N)) (constH (lin N) Iv e) (lid-id N) >
          (L0 b).v N (idH (lin N)) (constH (lin N) Iv e) (lid-id N)
        =< L0-lid b N (idH (lin N)) (constH (lin N) Iv e) (lid-id N) (lidc N) >
          TA.E.act N N (idH (lin N)) (KA.endE N b.1)
        =< TA.E.act-id N (KA.endE N b.1) >
          KA.endE N b.1 } ;

    ts2 (b : Prob N) : KA.TS.EI N = KA.mkTS N b.1 (line b) (refl b.1.1) (line-start b) ;

    c2 (b : Prob N) : KA.TS.T N b.1 = KA.TS.fromE N b.1 (ts2 b) (KA.mkTS-pt N b.1 (line b) (refl b.1.1) (line-start b)) ;

    c2-E (b : Prob N) : Id (KA.TS.EI N) (b.1, c2 b) (ts2 b) =
      KA.TS.fromE-eq N b.1 (ts2 b) (KA.mkTS-pt N b.1 (line b) (refl b.1.1) (line-start b)) ;

    c2-lv (b : Prob N) (W : Nat) (g : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      : Id (TA.EI W) (lv N (b.1, c2 b) W g j) (tot N b.1.1.1 b.1.1.2 (L0 b) W g j) =
      transH (apH (\ u -> lv N u W g j) (c2-E b))
        (transH (mkTS-lev N b.1 (line b) (refl b.1.1) (line-start b) W g j)
                (levA-lam N b.1.1 (tot N b.1.1.1 b.1.1.2 (L0 b)) (tot-pt N b.1.1.1 b.1.1.2 (L0 b)) (tot-nat N b.1.1.1 b.1.1.2 (L0 b)) W g j)) ;

    --------------------------------------------------------------------
    -- the filler

    fillC (b : Prob N) : (c : Bool) -> Id Bool (fullB N b) c -> KA.TS.T N b.1 = split {
      true -> \ e -> c1 b e ;
      false -> \ e -> c2 b } ;

    fillF : FillTy N = \ b -> fillC b (fullB N b) (refl (fullB N b)) ;

    --------------------------------------------------------------------
    -- Case 1 agrees with the side

    side-c1 (b : Prob N) (i0 : IsT (fullB N b)) (W : Nat) (f : Hom (lin W) (lin N))
      (i : DB.Lands W N b.2.pQ f) : Id (KA.TS.EI W) (KA.TS.E.act W N f (b.1, c1 b i0)) (b.2.pv W f i) =
      calc (KA.TS.EI W) {
          KA.TS.E.act W N f (b.1, c1 b i0)
        =< apH (KA.TS.E.act W N f) (c1-E b i0) >
          KA.TS.E.act W N f (b.2.pv N (idH (lin N)) i0)
        =< b.2.pnat W N f (idH (lin N)) i0 (DB.lands-comp W N N b.2.pQ (idH (lin N)) f i0) >
          b.2.pv W (compH (lin W) (lin N) (lin N) (idH (lin N)) f) (DB.lands-comp W N N b.2.pQ (idH (lin N)) f i0)
        =< KA.PT.pv-hom N b.1 b.2 W (compH (lin W) (lin N) (lin N) (idH (lin N)) f) f (comp-idl (lin W) (lin N) f)
             (DB.lands-comp W N N b.2.pQ (idH (lin N)) f i0) i >
          b.2.pv W f i } ;
  } ;
} ;
