-- A natural section of the projection Sigma(T,B) -> T is a dependent
-- element of B.  All transports here are equalities in the metatheory.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;
module PF = PresheafFormers[a,l].PFormers[PB.BC] ;

module Section (G : PCtx) (T : PTy[G]) (B : PTy[extP G T])
  (r : HO.NMap[G,T,PF.SigAB[G,T,B].SigP])
  (p : (X : Ob) (x : W.Ix (G.ob X)) (t : W.Ix (T.tob X x)) ->
    Id (W.Ix (T.tob X x)) (r.nfun X x t).1 t) {
  module S = PF.SigAB[G,T,B] ;
  module TT = PR.TyL[G,T] ;
  module TB = PR.TyL[TT.E,B] ;
  total (X : Ob) (w : TT.EI X) : TB.EI X =
    ((w.1,(r.nfun X w.1 w.2).1),(r.nfun X w.1 w.2).2) ;
  over (X : Ob) (w : TT.EI X) : Id (TT.EI X) (total X w).1 w =
    apH (\ t -> (w.1,t)) (p X w.1 w.2) ;
  value (X : Ob) (w : TT.EI X) : TB.T X w = TB.fromE X w (total X w) (over X w) ;
  equation (X : Ob) (w : TT.EI X) : Id (TB.EI X) (w,value X w) (total X w) =
    TB.fromE-eq X w (total X w) (over X w) ;
  total-nat (Y X : Ob) (h : Hom Y X) (w : TT.EI X) :
    Id (TB.EI Y) (TB.E.act Y X h (total X w)) (total Y (TT.E.act Y X h w)) =
    transH (TB.pr-tact Y X h (total X w).1
      (G.act Y X h w.1,T.tact Y X h w.1 (G.act Y X h w.1) (refl (G.act Y X h w.1)) (r.nfun X w.1 w.2).1)
      (TT.pr-tact Y X h w.1 (G.act Y X h w.1) (refl (G.act Y X h w.1)) (r.nfun X w.1 w.2).1)
      (r.nfun X w.1 w.2).2)
      (apH (\ u -> ((G.act Y X h w.1,u.1),u.2))
        (r.nnat Y X h w.1 (G.act Y X h w.1) (refl (G.act Y X h w.1)) w.2)) ;
  opaque total-nat ;
  natural (Y X : Ob) (h : Hom Y X) (w : TT.EI X) (w' : TT.EI Y)
    (e : Id (TT.EI Y) (TT.E.act Y X h w) w') :
    Id (TB.T Y w') (B.tact Y X h w w' e (value X w)) (value Y w') =
    TB.pr-inj Y w' _ _
      (transH (symH (TB.pr-tact Y X h w w' e (value X w)))
        (transH (apH (TB.E.act Y X h) (equation X w))
          (transH (total-nat Y X h w)
            (transH (apH (total Y) e) (symH (equation Y w')))))) ;
  opaque natural ;
  section : PEl[TT.E,B] = new PEl[TT.E,B,value,natural] ;
} ;
