-- CPathComp.seg (L3, inside CB, level l): composition of a path type over
-- a line from a composition of A (model.tex Thm "type formers": Path).
-- The composite path at (V , g , i) is the composite of A at the problem
-- of the restricted input at i (CPathProb); its ends are aE , bE (the
-- sides on i = e0 , e1 contain the identity there), its sides are P's
-- (P's side contains the identity), and it is uniform (CPathProb.PU).
--
-- Quarry: seg/model GPathComp, GPathRes.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PathC (K H : PCtx) (A : PTy[H]) (dd : Bool)
  (s : (X : Ob) -> W0.Ix (K.ob X) -> (W : Ob) -> Hom W X -> Hom W Iv -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (sF : (X : Ob) (y : W0.Ix (K.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
        -> Id (W0.Ix (H.ob V)) (H.act V W g (s X y W f i)) (s X y V (compH V W X f g) (compH V W Iv i g)))
  (aE bE : (W : Ob) -> W0.Ix (K.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (K.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (K.act W X f x)))
  (aE-pt : (W : Ob) (y : W0.Ix (K.ob W)) -> Id (W0.Ix (H.ob W)) (aE W y).1 (s W y W (idH W) (ptH W (src dd))))
  (bE-pt : (W : Ob) (y : W0.Ix (K.ob W)) -> Id (W0.Ix (H.ob W)) (bE W y).1 (s W y W (idH W) (ptH W (tgt dd))))
  (e e' : IPt) (ca : CLine[l].Lines[H, A].CompK[e, e'].Comp) {
  module PR = CPathProb[l].PathPr[K, H, A, dd, s, sN, sF, aE, bE, aE-act, bE-act, aE-pt, bE-pt, e] ;
  module PT = PR.PT ;
  module CP = PR.CP ;
  module CA = PR.CA ;
  module TA = PR.TA ;
  module FK = PR.FK ;
  module CK = CLine[l].Lines[H, A].CompK[e, e'] ;
  module CKP = CLine[l].Lines[K, PT.PathP].CompK[e, e'] ;
  module EKA' = CLine[l].EndKit[H, A, e'] ;
  module EVA' = PR.FA.Ev[e'] ;
  module EVP' = CLine[l].FT[K, PT.PathP].Ev[e'] ;
  module TTA = GPR.TyL[CK.EK.TV.E, CK.Tend] ;
  module TT = GPR.TyL[CP.TV.E, CKP.Tend] ;
  module RCA = CPartial[l].Rel[CK.EK.TV.E, CK.EK.SFm.SF, CK.Tend, CK.endL] ;
  module RCP = CPartial[l].Rel[CP.TV.E, CP.SFm.SF, CKP.Tend, CKP.endL] ;

  ----------------------------------------------------------------------
  -- composites of problems (as in CFill)

  In (V : Ob) : U l = (xh : CP.TV.EI V) * CP.PT.Side[V, xh] ;

  rIn (V' V : Ob) (g : Hom V' V) (z : In V) : In V' = (CP.TV.E.act V' V g z.1, CP.PT.rside V' V g z.1 z.2) ;

  out (V : Ob) (z : In V) (j : Hom V Iv) : TTA.EI V =
    (PR.Prob[V, z.1, z.2, j].x', ca.kop V PR.Prob[V, z.1, z.2, j].x' PR.Prob[V, z.1, z.2, j].side) ;

  rd (V : Ob) (u : TTA.EI V) : TA.EI V = EKA'.endE V (CK.SE.mV V u) ;

  rd-act (V' V : Ob) (g : Hom V' V) (u : TTA.EI V) : Id (TA.EI V') (rd V' (TTA.E.act V' V g u)) (TA.E.act V' V g (rd V u)) =
    transH (apH (EKA'.endE V') (symH (CK.SE.mV-nat V' V g u))) (EKA'.endE-act V' V g (CK.SE.mV V u)) ;

  outU (V' V : Ob) (g : Hom V' V) (z : In V) (j : Hom V Iv)
    : Id (TTA.EI V') (TTA.E.act V' V g (out V z j)) (out V' (rIn V' V g z) (compH V' V Iv j g)) =
    transH (ca.kunif V' V g PR.Prob[V, z.1, z.2, j].x' PR.Prob[V, z.1, z.2, j].side)
      (RCA.kop-cong ca V' (CA.TV.E.act V' V g PR.Prob[V, z.1, z.2, j].x') PR.PU[V', V, g, z.1, z.2, j].P'.x'
         PR.PU[V', V, g, z.1, z.2, j].pt
         (CA.PT.rside V' V g PR.Prob[V, z.1, z.2, j].x' PR.Prob[V, z.1, z.2, j].side) PR.PU[V', V, g, z.1, z.2, j].P'.side
         PR.PU[V', V, g, z.1, z.2, j].sd-eq) ;

  -- on a side containing the identity, the composite is the other end of
  -- that side's line
  compId (V : Ob) (z : In V) (j : Hom V Iv) (k : Arith[a].Fin (suc (suc (suc zero))))
    (lk : Lands V V (PR.Prob[V, z.1, z.2, j].pick k.1).pQ (idH V))
    : Id (TA.EI V) (rd V (out V z j))
         ((CA.lineL V ((PR.Prob[V, z.1, z.2, j].pick k.1).pv V (idH V) lk)).2.1.1 V (idH V) (ptH V e')) =
    transH (apH (rd V)
      (transH (symH (TTA.E.act-id V (out V z j)))
        (transH (ca.kside V PR.Prob[V, z.1, z.2, j].x' PR.Prob[V, z.1, z.2, j].side V (idH V) (PR.Prob[V, z.1, z.2, j].J.inS k V (idH V) lk))
                (apH (CK.endL.mE V) (PR.Prob[V, z.1, z.2, j].J.pv-in k V (idH V) lk (PR.Prob[V, z.1, z.2, j].J.inS k V (idH V) lk))))))
      (EVA'.endB-E V (CA.lineL V ((PR.Prob[V, z.1, z.2, j].pick k.1).pv V (idH V) lk))) ;

  fin0 : Arith[a].Fin (suc (suc (suc zero))) = (zero, refl true) ;
  fin1 : Arith[a].Fin (suc (suc (suc zero))) = (suc zero, refl true) ;
  fin2 : Arith[a].Fin (suc (suc (suc zero))) = (suc (suc zero), refl true) ;

  -- an element of the composite type is determined by its point and the
  -- values of its path
  tt-ext (W : Ob) (u v : TT.EI W) (p : Id (CP.TV.EI W) u.1 v.1)
    (q : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (u.2.1.1 V g j) (v.2.1.1 V g j)) : Id (TT.EI W) u v =
    idJ (CP.TV.EI W) u.1
      (\ w2 P2 -> (z2 : W0.Ix (CKP.Tend.tob W w2)) -> ((V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) (u.2.1.1 V g j) (z2.1.1 V g j))
         -> Id (TT.EI W) u (w2, z2))
      (\ z2 q2 -> apH {W0.Ix (CKP.Tend.tob W u.1)} {TT.EI W} (\ z -> (u.1, z)) (PT.path-eq W ((FK.ev e').nt W u.1.1) u.2 z2 q2))
      v.1 p v.2 q ;

  ----------------------------------------------------------------------
  -- the composite at (W , xh , P)

  module F (W : Ob) (xh : CP.TV.EI W) (P : CP.PT.Side[W, xh]) {
    y1 : W0.Ix (K.ob W) = (FK.ev e').nt W xh.1 ;

    inp (V : Ob) (g : Hom V W) : In V = (CP.TV.E.act V W g xh, CP.PT.rside V W g xh P) ;

    inp-o (V' V : Ob) (g : Hom V' V) (f : Hom V W) : Id (In V') (rIn V' V g (inp V f)) (inp V' (compH V' V W f g)) =
      symH (Sigma-path (CP.TV.EI V') (\ z -> CP.PT.Side[V', z]) (CP.TV.E.act V' W (compH V' V W f g) xh) (CP.TV.E.act V' V g (CP.TV.E.act V W f xh))
              (CP.PT.rside V' W (compH V' V W f g) xh P) (CP.PT.rside V' V g (CP.TV.E.act V W f xh) (CP.PT.rside V W f xh P))
              (CP.TV.E.act-o V' V W f g xh) (CP.PT.rside-o V' V W g f xh P)) ;

    t (V : Ob) (g : Hom V W) (j : Hom V Iv) : TA.EI V = rd V (out V (inp V g) j) ;

    tp (V : Ob) (g : Hom V W) (j : Hom V Iv) : Id (W0.Ix (H.ob V)) (t V g j).1 (s W y1 V g j) =
      transH (apH (\ k -> s V (xh.1.1 V (compH V V W g (idH V)) (ptH V e')) V (idH V) k) (comp-idr V Iv j))
        (transH (apH (\ y -> s V y V (idH V) j) (FK.evN e' V W g xh.1)) (symH (PR.sAt W y1 V g j))) ;

    tn (V' V : Ob) (g : Hom V' V) (f : Hom V W) (j : Hom V Iv)
      : Id (TA.EI V') (TA.E.act V' V g (t V f j)) (t V' (compH V' V W f g) (compH V' V Iv j g)) =
      transH (symH (rd-act V' V g (out V (inp V f) j)))
        (apH (rd V') (transH (outU V' V g (inp V f) j) (apH (\ z -> out V' z (compH V' V Iv j g)) (inp-o V' V g f)))) ;

    -- the identity lands in the side on {i = eb} at i = eb
    lb (eb : IPt) : Lands W W (pre W Iv (ptH W eb) (ptS eb)) (idH W) =
      pre-lands W W Iv (ptH W eb) (ptS eb) (idH W)
        (lands-eq W Iv (ptS eb) (ptH W eb) (compH W W Iv (ptH W eb) (idH W)) (symH (comp-idr W Iv (ptH W eb))) (pt-lands W eb)) ;

    -- the K-line at the identity
    kId : Id (W0.Ix (K.ob W)) (xh.1.1 W (compH W W W (idH W) (compH W W W (idH W) (idH W))) (ptH W e')) y1 =
      apH (\ k -> xh.1.1 W k (ptH W e')) (transH (comp-idl W W (compH W W W (idH W) (idH W))) (comp-idl W W (idH W))) ;

    t0 : Id (TA.EI W) (t W (idH W) (ptH W (src dd))) (aE W y1) =
      transH (compId W (inp W (idH W)) (ptH W (src dd)) fin0 (lb (src dd)))
        (transH (PR.Prob[W, (inp W (idH W)).1, (inp W (idH W)).2, ptH W (src dd)].B0.pv-lev W (idH W) (lb (src dd)) W (idH W) (ptH W e'))
                (PT.aE-eq W _ _ kId)) ;

    t1 : Id (TA.EI W) (t W (idH W) (ptH W (tgt dd))) (bE W y1) =
      transH (compId W (inp W (idH W)) (ptH W (tgt dd)) fin1 (lb (tgt dd)))
        (transH (PR.Prob[W, (inp W (idH W)).1, (inp W (idH W)).2, ptH W (tgt dd)].B1.pv-lev W (idH W) (lb (tgt dd)) W (idH W) (ptH W e'))
                (PT.bE-eq W _ _ kId)) ;

    path : W0.Ix (PT.tobP W y1) = PT.mkPath W y1 t tn tp t0 t1 ;

    -- on the sieve of P the composite is P's end: there the side of P
    -- contains the identity
    lk (W' : Ob) (f : Hom W' W) (i : Lands W' W P.pQ f) (V : Ob) (g : Hom V W')
      : Lands V V (pre V W (compH V W' W f g) P.pQ) (idH V) =
      pre-lands V V W (compH V W' W f g) P.pQ (idH V)
        (lands-eq V W P.pQ (compH V W' W f g) (compH V V W (compH V W' W f g) (idH V)) (symH (comp-idr V W (compH V W' W f g)))
          (lands-comp V W' W P.pQ f g i)) ;

    sideVal (W' : Ob) (f : Hom W' W) (i : Lands W' W P.pQ f) (V : Ob) (g : Hom V W') (j : Hom V Iv)
      : Id (TA.EI V) (t V (compH V W' W f g) j) ((PR.lvP W' (P.pv W' f i) W' (idH W') (ptH W' e')).2.1.1 V g j) =
      calc (TA.EI V) {
          t V (compH V W' W f g) j
        =< compId V (inp V (compH V W' W f g)) j fin2 (lk W' f i V g) >
          (CA.lineL V (PR.Prob[V, (inp V (compH V W' W f g)).1, (inp V (compH V W' W f g)).2, j].SL.pv V (idH V) (lk W' f i V g))).2.1.1 V (idH V) (ptH V e')
        =< PR.Prob[V, (inp V (compH V W' W f g)).1, (inp V (compH V W' W f g)).2, j].SL.pv-lev V (idH V) (lk W' f i V g) V (idH V) (ptH V e') >
          (PR.lvP V (P.pv V (compH V V W (compH V W' W f g) (idH V)) (lands-pre V V W (compH V W' W f g) P.pQ (idH V) (lk W' f i V g))) V (idH V) (ptH V e')).2.1.1 V (idH V)
            (compH V V Iv (compH V V Iv j (idH V)) (idH V))
        =< apH (\ k -> (PR.lvP V (P.pv V (compH V V W (compH V W' W f g) (idH V)) (lands-pre V V W (compH V W' W f g) P.pQ (idH V) (lk W' f i V g))) V (idH V) (ptH V e')).2.1.1 V (idH V) k)
             (transH (comp-idr V Iv (compH V V Iv j (idH V))) (comp-idr V Iv j)) >
          (PR.lvP V (P.pv V (compH V V W (compH V W' W f g) (idH V)) (lands-pre V V W (compH V W' W f g) P.pQ (idH V) (lk W' f i V g))) V (idH V) (ptH V e')).2.1.1 V (idH V) j
        =< apH (\ u -> (PR.lvP V u V (idH V) (ptH V e')).2.1.1 V (idH V) j)
             (transH (CP.PT.pv-hom W xh P V (compH V V W (compH V W' W f g) (idH V)) (compH V W' W f g) (comp-idr V W (compH V W' W f g))
                        (lands-pre V V W (compH V W' W f g) P.pQ (idH V) (lk W' f i V g)) (lands-comp V W' W P.pQ f g i))
                     (symH (P.pnat V W' g f i (lands-comp V W' W P.pQ f g i)))) >
          (PR.lvP V (CP.TS.E.act V W' g (P.pv W' f i)) V (idH V) (ptH V e')).2.1.1 V (idH V) j
        =< apH (\ M -> (M.2.1.1 V (idH V) (ptH V e')).2.1.1 V (idH V) j) (CP.lineL-act V W' g (P.pv W' f i)) >
          (PR.lvP W' (P.pv W' f i) V (compH V V W' g (idH V)) (ptH V e')).2.1.1 V (idH V) j
        =< apH (\ k -> (PR.lvP W' (P.pv W' f i) V k (ptH V e')).2.1.1 V (idH V) j) (comp-idr V W' g) >
          (PR.lvP W' (P.pv W' f i) V g (ptH V e')).2.1.1 V (idH V) j
        =< apH (\ z -> z.2.1.1 V (idH V) j) (CLine[l].EndKit[K, PT.PathP, e'].lineEnd V W' g (CP.lineL W' (P.pv W' f i))) >
          (PR.TP.E.act V W' g (PR.lvP W' (P.pv W' f i) W' (idH W') (ptH W' e'))).2.1.1 V (idH V) j
        =< apH (\ k -> (PR.lvP W' (P.pv W' f i) W' (idH W') (ptH W' e')).2.1.1 V k j) (comp-idr V W' g) >
          (PR.lvP W' (P.pv W' f i) W' (idH W') (ptH W' e')).2.1.1 V g j } ;
  } ;

  kop (W : Ob) (xh : CP.TV.EI W) (P : CP.PT.Side[W, xh]) : W0.Ix (CKP.Tend.tob W xh) = F[W, xh, P].path ;

  kside (W : Ob) (xh : CP.TV.EI W) (P : CP.PT.Side[W, xh]) (W' : Ob) (f : Hom W' W) (i : Lands W' W P.pQ f)
    : Id (TT.EI W') (TT.E.act W' W f (xh, kop W xh P)) (CKP.endL.mE W' (P.pv W' f i)) =
    tt-ext W' (TT.E.act W' W f (xh, kop W xh P)) (CKP.endL.mE W' (P.pv W' f i)) (symH (P.ppt W' f i))
      (\ V g j -> transH (F[W, xh, P].sideVal W' f i V g j)
         (symH (apH (\ z -> z.2.1.1 V g j) (EVP'.endB-E W' (CP.lineL W' (P.pv W' f i)))))) ;

  kunif (Y W : Ob) (h : Hom Y W) (xh : CP.TV.EI W) (P : CP.PT.Side[W, xh])
    : Id (TT.EI Y) (TT.E.act Y W h (xh, kop W xh P)) (CP.TV.E.act Y W h xh, kop Y (CP.TV.E.act Y W h xh) (CP.PT.rside Y W h xh P)) =
    tt-ext Y (TT.E.act Y W h (xh, kop W xh P)) (CP.TV.E.act Y W h xh, kop Y (CP.TV.E.act Y W h xh) (CP.PT.rside Y W h xh P))
      (refl (CP.TV.E.act Y W h xh))
      (\ V g j -> apH (\ z -> rd V (out V z j)) (symH (F[W, xh, P].inp-o V Y g h))) ;

  opaque kside ; opaque kunif ;

  -- the composition of the path type
  comp : CKP.Comp = new RCP.RC[kop, kside, kunif] ;
} ;
