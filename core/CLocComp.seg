-- CLocComp.seg (L9): the composition of DA from a horn filling operation
-- on i*A (localisation.tex, Theorem DA).
--
-- Given face-uniform fillers of i*A on Delta (CDFill: fill, sides, face) at
-- the end e, the composition of DA from e to e' at a point w and a side sd
-- is, at f : [n] -> X, the end at e' of the filler of the problem
-- CLocCompP.PF[w, sd, n, f]:
--
--   kop     the family; Compat along the faces from face and RS (the
--           problem at f restricted along a face is the problem at f dl),
--           along all strict maps by CLocD.FacesGen

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module DB = CDeltaBase[a].DB ;
module DS = CDeltaBase[a].DS ;
module SP = CPosBase[a].SP ;
module CV = CLocCompV[a, l] ;
module CP = CLocCompP[a, l] ;

module CO (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (e e' : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA, e].resP N' (suc N') (dl N' y) b))) {
  module VV = CV.VA[G, A, e] ;
  module DTm = VV.DTm ;
  module TA = VV.TA ;
  module TD = VV.TD ;
  module KD = VV.KD ;
  module RG = CLocRestr[a, l].R[G] ;
  module SAD = CDStageA[a, l].SA[RG.iG, RG.T[A].iA, e] ;
  module KAD = SAD.KA ;

  -- the end at e' of a fibre element, read at the identity
  endT (M : Nat) (u : KAD.TS.EI M) : TA.EI (lin M) = SAD.lv M u M (idH (lin M)) (constH (lin M) Iv e') ;

  endT-act (M' M : Nat) (g : Hom (lin M') (lin M)) (u : KAD.TS.EI M)
    : Id (TA.EI (lin M')) (TA.E.act (lin M') (lin M) g (endT M u)) (endT M' (KAD.TS.E.act M' M g u)) =
    calc (TA.EI (lin M')) {
        TA.E.act (lin M') (lin M) g (endT M u)
      =< SAD.lv-nat M u M' M g (idH (lin M)) (constH (lin M) Iv e') >
        SAD.lv M u M' (compH (lin M') (lin M) (lin M) (idH (lin M)) g) (compH (lin M') (lin M) Iv (constH (lin M) Iv e') g)
      =< apH (\ k -> SAD.lv M u M' k (compH (lin M') (lin M) Iv (constH (lin M) Iv e') g))
           (transH (comp-idl (lin M') (lin M) g) (symH (comp-idr (lin M') (lin M) g))) >
        SAD.lv M u M' (compH (lin M') (lin M') (lin M) g (idH (lin M'))) (compH (lin M') (lin M) Iv (constH (lin M) Iv e') g)
      =< apH (\ k -> SAD.lv M u M' (compH (lin M') (lin M') (lin M) g (idH (lin M'))) k) (constH-nat (lin M') (lin M) g e') >
        SAD.lv M u M' (compH (lin M') (lin M') (lin M) g (idH (lin M'))) (constH (lin M') Iv e')
      =< symH (SAD.lv-act M' M g u M' (idH (lin M')) (constH (lin M') Iv e')) >
        endT M' (KAD.TS.E.act M' M g u) } ;

  opaque endT-act ;

  module Op (X : Ob) (w : KD.TV.EI X) (sd : KD.PT.Side[X, w]) {
    y : W0.Ix (G.ob X) = w.1.1 X (idH X) (constH X Iv e') ;

    fl (n : Nat) (f : Hom (lin n) X) : KAD.TS.EI n = SAD.fillE n (fill n) CP.PF[G, A, e, X, w, sd, n, f].prob ;

    pp (n : Nat) (f : Hom (lin n) X) : Id (W0.Ix (G.ob (lin n))) (endT n (fl n f)).1 (G.act (lin n) X f y) =
      transH (SAD.lv-pt n (fl n f) n (idH (lin n)) (constH (lin n) Iv e')) (RG.FP.evN e' (lin n) X f w.1) ;

    fam : DTm.Fam X y = \ n f -> TA.fromE (lin n) (G.act (lin n) X f y) (endT n (fl n f)) (pp n f) ;

    rdE (n : Nat) (f : Hom (lin n) X) : Id (TA.EI (lin n)) (DTm.rd X y fam n f) (endT n (fl n f)) =
      TA.fromE-eq (lin n) (G.act (lin n) X f y) (endT n (fl n f)) (pp n f) ;

    fcomp : DTm.FaceCompat X y fam = \ n f yy hy ->
      calc (TA.EI (lin n)) {
          TA.E.act (lin n) (lin (suc n)) (dl n yy) (DTm.rd X y fam (suc n) f)
        =< apH (TA.E.act (lin n) (lin (suc n)) (dl n yy)) (rdE (suc n) f) >
          TA.E.act (lin n) (lin (suc n)) (dl n yy) (endT (suc n) (fl (suc n) f))
        =< endT-act n (suc n) (dl n yy) (fl (suc n) f) >
          endT n (KAD.TS.E.act n (suc n) (dl n yy) (fl (suc n) f))
        =< apH (endT n) (face n CP.PF[G, A, e, X, w, sd, suc n, f].prob yy hy) >
          endT n (SAD.fillE n (fill n) (SAD.resP n (suc n) (dl n yy) CP.PF[G, A, e, X, w, sd, suc n, f].prob))
        =< apH (\ b -> endT n (SAD.fillE n (fill n) b))
             CP.RS[G, A, e, X, w, sd, n, suc n, f, dl n yy, dl-strict n yy].res >
          endT n (fl n (compH (lin n) (lin (suc n)) X f (dl n yy)))
        =< symH (rdE n (compH (lin n) (lin (suc n)) X f (dl n yy))) >
          DTm.rd X y fam n (compH (lin n) (lin (suc n)) X f (dl n yy)) } ;

    kop : DTm.DEl X y = (fam, DTm.FacesGen[X, y, fam, fcomp].facesGen) ;

    ----------------------------------------------------------------------
    -- on the sieve of sd the filler is the side: its end at f' is the end
    -- of the side at g, read at f'

    module KS (W : Ob) (g : Hom W X) (i : SP.Lands W X sd.pQ g) (n : Nat) (f' : Hom (lin n) W) {
      module PFf = CP.PF[G, A, e, X, w, sd, n, compH (lin n) W X g f'] ;
      u : KD.TS.EI W = sd.pv W g i ;
      L : KD.TL.EI W = KD.lineL W u ;
      Z : TD.EI W = L.2.1.1 W (idH W) (constH W Iv e') ;
      gf : Hom (lin n) X = compH (lin n) W X g f' ;
      cn : Hom (lin n) Iv = constH (lin n) Iv e' ;
      ii : Hom (lin n) (lin n) = compH (lin n) (lin n) (lin n) (idH (lin n)) (idH (lin n)) ;

      l' : SP.Lands (lin n) X sd.pQ gf = SP.lands-comp (lin n) W X sd.pQ g f' i ;
      i0 : DS.Lands n n PFf.Q (idH (lin n)) =
        PFf.lhom n gf (compH (lin n) (lin n) X gf (idH (lin n))) (symH (comp-idr (lin n) X gf)) l' ;
      lc : SP.Lands (lin n) X sd.pQ (compH (lin n) (lin n) X gf ii) = PFf.lc n (idH (lin n)) i0 n (idH (lin n)) ;
      st : Strict (lin n) (lin n) ii =
        substH {Hom (lin n) (lin n)} (\ k -> Strict (lin n) (lin n) k) {idH (lin n)} {ii}
          (symH (comp-idl (lin n) (lin n) (idH (lin n))))
          (\ s t l -> substH {Tree} (\ z -> IsT (lt (lin n) z (app (lin n) (lin n) (idH (lin n)) t).1)) {s.1} {(app (lin n) (lin n) (idH (lin n)) s).1}
             (symH (app-idH1 (lin n) s))
             (substH {Tree} (\ z -> IsT (lt (lin n) s.1 z)) {t.1} {(app (lin n) (lin n) (idH (lin n)) t).1} (symH (app-idH1 (lin n) t)) l)) ;
      module P = PFf.VP.Pt[n, ii, cn, lc] ;

      zEq : Id (TD.EI (lin n)) P.zz (TD.E.act (lin n) W f' Z) =
        calc (TD.EI (lin n)) {
            P.zz
          =< apH (\ v -> (KD.lineL (lin n) v).2.1.1 (lin n) (idH (lin n)) cn)
               (transH (KD.PT.pv-hom X w sd (lin n) (compH (lin n) (lin n) X gf ii) gf
                          (transH (apH (compH (lin n) (lin n) X gf) (comp-idl (lin n) (lin n) (idH (lin n)))) (comp-idr (lin n) X gf)) lc l')
                       (symH (sd.pnat (lin n) W f' g i l'))) >
            (KD.lineL (lin n) (KD.TS.E.act (lin n) W f' u)).2.1.1 (lin n) (idH (lin n)) cn
          =< apH (\ M -> M.2.1.1 (lin n) (idH (lin n)) cn) (KD.lineL-act (lin n) W f' u) >
            L.2.1.1 (lin n) (compH (lin n) (lin n) W f' (idH (lin n))) cn
          =< apH (\ k -> L.2.1.1 (lin n) k cn) (transH (comp-idr (lin n) W f') (symH (comp-idl (lin n) W f'))) >
            L.2.1.1 (lin n) (compH (lin n) W W (idH W) f') cn
          =< apH (\ k -> L.2.1.1 (lin n) (compH (lin n) W W (idH W) f') k) (symH (constH-nat (lin n) W f' e')) >
            L.2.1.1 (lin n) (compH (lin n) W W (idH W) f') (compH (lin n) W Iv (constH W Iv e') f')
          =< symH (L.2.1.2 (lin n) W f' (idH W) (constH W Iv e')) >
            TD.E.act (lin n) W f' Z } ;

      res : Id (TA.EI (lin n)) (endT n (fl n gf)) (DTm.rd W Z.1 Z.2.1 n f') =
        calc (TA.EI (lin n)) {
            endT n (fl n gf)
          =< symH (TA.PE.actId (lin n) (idH (lin n)) (refl (idH (lin n))) (endT n (fl n gf))) >
            TA.E.act (lin n) (lin n) (idH (lin n)) (endT n (fl n gf))
          =< endT-act n n (idH (lin n)) (fl n gf) >
            endT n (KAD.TS.E.act n n (idH (lin n)) (fl n gf))
          =< apH (endT n) (sides n PFf.prob n (idH (lin n)) i0) >
            endT n (PFf.pv n (idH (lin n)) i0)
          =< SAD.mkTS-lev n (KAD.TV.E.act n n (idH (lin n)) PFf.x0) PFf.At[n, idH (lin n), i0].L
               (refl PFf.At[n, idH (lin n), i0].xg) PFf.At[n, idH (lin n), i0].q n (idH (lin n)) cn >
            P.val
          =< PFf.VP.VInj[n, ii, cn, lc, PFf.VP.StP[n, ii, cn, lc, st].sst].res >
            DTm.rd (lin n) P.zz.1 P.zz.2.1 n (idH (lin n))
          =< apH (\ z -> DTm.rd (lin n) z.1 z.2.1 n (idH (lin n))) zEq >
            DTm.rd (lin n) (TD.E.act (lin n) W f' Z).1 (TD.E.act (lin n) W f' Z).2.1 n (idH (lin n))
          =< DTm.rd-dtact (lin n) W f' Z.1 (G.act (lin n) W f' Z.1) (refl (G.act (lin n) W f' Z.1)) Z.2 n (idH (lin n)) >
            DTm.rd W Z.1 Z.2.1 n (compH (lin n) (lin n) W f' (idH (lin n)))
          =< apH (\ k -> DTm.rd W Z.1 Z.2.1 n k) (comp-idr (lin n) W f') >
            DTm.rd W Z.1 Z.2.1 n f' } ;
      opaque st ; opaque zEq ; opaque res ;
    } ;
    opaque rdE ; opaque fcomp ;
  } ;

  ----------------------------------------------------------------------
  -- the composition structure of DA from e to e'

  module CK = PB.CLine[l].Lines[G, DTm.DA].CompK[e, e'] ;
  module RL = PB.CPartial[l].Rel[CK.EK.TV.E, CK.EK.SFm.SF, CK.Tend, CK.endL] ;
  module KE' = PB.CLine[l].EndKit[G, DTm.DA, e'] ;

  rdT (W : Ob) (q : TD.EI W) (n : Nat) (f' : Hom (lin n) W) : TA.EI (lin n) = DTm.rd W q.1 q.2.1 n f' ;

  tdExt (W : Ob) (q q' : TD.EI W) (P : Id (W0.Ix (G.ob W)) q.1 q'.1)
    (R : (n : Nat) (f' : Hom (lin n) W) -> Id (TA.EI (lin n)) (rdT W q n f') (rdT W q' n f')) : Id (TD.EI W) q q' =
    idJ (W0.Ix (G.ob W)) q.1
      (\ p2 P2 -> (a2 : DTm.DEl W p2) -> ((n : Nat) (f' : Hom (lin n) W) -> Id (TA.EI (lin n)) (rdT W q n f') (DTm.rd W p2 a2.1 n f'))
         -> Id (TD.EI W) q (p2, a2))
      (\ a2 R2 -> apH {DTm.DEl W q.1} {TD.EI W} (\ a3 -> (q.1, a3)) (DTm.Dext W q.1 q.2 a2 R2))
      q'.1 P q'.2 R ;

  ttExt (W : Ob) (z z' : RL.TT.EI W) (P : Id (KD.TV.EI W) z.1 z'.1)
    (R : (n : Nat) (f' : Hom (lin n) W)
         -> Id (TA.EI (lin n)) (rdT W (KE'.endE W (CK.SE.mV W z)) n f') (rdT W (KE'.endE W (CK.SE.mV W z')) n f'))
    : Id (RL.TT.EI W) z z' =
    CK.SE.mV-inj W z z' P
      (KE'.tv-eq W (CK.SE.mV W z) (CK.SE.mV W z') (apH (\ v -> v.1) P)
         (tdExt W (KE'.endE W (CK.SE.mV W z)) (KE'.endE W (CK.SE.mV W z')) (apH (\ v -> v.1.1 W (idH W) (constH W Iv e')) P) R)) ;

  -- the reading of a restricted pair
  rdAct (W X : Ob) (g : Hom W X) (x : KD.TV.EI X) (c : RL.TT.T X x) (n : Nat) (f' : Hom (lin n) W)
    : Id (TA.EI (lin n)) (rdT W (KE'.endE W (CK.SE.mV W (RL.TT.E.act W X g (x, c)))) n f')
                         (DTm.rd X (x.1.1 X (idH X) (constH X Iv e')) c.1 n (compH (lin n) W X g f')) =
    transH (apH (\ q -> rdT W q n f')
              (transH (apH (KE'.endE W) (symH (CK.SE.mV-nat W X g (x, c)))) (KE'.endE-act W X g (CK.SE.mV X (x, c)))))
      (DTm.rd-dtact W X g (x.1.1 X (idH X) (constH X Iv e')) (G.act W X g (x.1.1 X (idH X) (constH X Iv e')))
         (refl (G.act W X g (x.1.1 X (idH X) (constH X Iv e')))) c n f') ;

  kopR (X : Ob) (x : RL.TS.Pt X) (s : RL.PS'.Side[X, x]) : RL.TT.T X x = Op[X, x, s].kop ;

  ksideR (X : Ob) (x : RL.TS.Pt X) (s : RL.PS'.Side[X, x]) (W : Ob) (f : Hom W X) (i : SP.Lands W X s.pQ f)
    : Id (RL.TT.EI W) (RL.TT.E.act W X f (x, kopR X x s)) (CK.endL.mE W (s.pv W f i)) =
    ttExt W (RL.TT.E.act W X f (x, kopR X x s)) (CK.endL.mE W (s.pv W f i)) (symH (s.ppt W f i))
      (\ n f' -> transH (rdAct W X f x (kopR X x s) n f')
         (transH (Op[X, x, s].rdE n (compH (lin n) W X f f'))
           (transH (Op[X, x, s].KS[W, f, i, n, f'].res)
             (symH (apH (\ q -> rdT W q n f') (CK.EV'.endB-E W (KD.lineL W (s.pv W f i)))))))) ;

  kunifR (Y X : Ob) (h : Hom Y X) (x : RL.TS.Pt X) (s : RL.PS'.Side[X, x])
    : Id (RL.TT.EI Y) (RL.TT.E.act Y X h (x, kopR X x s))
                      (KD.TV.E.act Y X h x, kopR Y (KD.TV.E.act Y X h x) (RL.PS'.rside Y X h x s)) =
    ttExt Y (RL.TT.E.act Y X h (x, kopR X x s)) (KD.TV.E.act Y X h x, kopR Y (KD.TV.E.act Y X h x) (RL.PS'.rside Y X h x s))
      (refl (KD.TV.E.act Y X h x))
      (\ n f' -> transH (rdAct Y X h x (kopR X x s) n f')
         (transH (Op[X, x, s].rdE n (compH (lin n) Y X h f'))
           (transH (apH (\ b -> endT n (SAD.fillE n (fill n) b)) CP.PRe[G, A, e, Y, X, h, x, s, n, f'].res)
             (symH (Op[Y, KD.TV.E.act Y X h x, RL.PS'.rside Y X h x s].rdE n f'))))) ;

  comp : CK.Comp = new RL.RC[kopR, ksideR, kunifR] ;
  opaque tdExt ; opaque ttExt ; opaque rdAct ; opaque ksideR ; opaque kunifR ;
} ;

------------------------------------------------------------------------
-- Theorem DA: a horn filling operation on i*A gives a fibration of DA

module Thm (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G])
  (hf : CDHornFib[a, l].DH[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[A].iA].isFib) {
  module RG = CLocRestr[a, l].R[G] ;
  module FT = CDFill[a, l].FT[RG.iG, RG.T[A].iA, hf] ;
  module FF = CDFill[a, l].FF[RG.iG, RG.T[A].iA, hf] ;
  module C01 = CO[G, A, e0, e1, FT.S.fill, FT.S.sides, FT.S.face] ;
  module C10 = CO[G, A, e1, e0, FF.S.fill, FF.S.sides, FF.S.face] ;

  fib : PB.CLine[l].Lines[G, CLocD[a, l].DT[G, A].DA].Fib = (C01.comp, C10.comp) ;
} ;

-- in particular from a fibration structure of A
module OfFib (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) {
  fib : PB.CLine[l].Lines[G, CLocD[a, l].DT[G, A].DA].Fib = Thm[G, A, CLocHorn[a, l].HornOfFib[G, A, c].horn].fib ;
} ;
