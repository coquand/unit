-- CPostMap.seg (L9): reading an element of D_N A into i*A (postnikov.tex,
-- Theorem conv: the lids sigma_N(f) and the prisms p_N(f)).
--
-- z is an element of D_N A = D (K_N A) at (Y , y) and phi : P -> Y a map
-- from a poset with a height bounded by B <= N.  The reading of z along
-- phi is the map P -> i*A
--
--   val W g  =  sgm^* (z at phi c , read at the identity)      g = c sgm
--
-- (CBoxEZ; the chain c has dimension r <= B <= N, so z at phi c is read in
-- A).  It is natural along every map of Delta (vn), although z is natural
-- only along the strict ones: two factorisations are compared by the strict
-- mu of CBoxEZ.EZXK, as in Theorem DA.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;

module DR (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (hBN : IsT (leb B N)) (phi : Hom P Y) {
  module KM = CK.KT[G, A, N] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;

  yP : W0.Ix (G.ob P) = G.act P Y phi y ;

  -- z at a chain q : [r] -> Y, read at the identity
  zc (r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) Y) : TA.EI (lin r) =
    KM.rd (lin r) (G.act (lin r) Y q y) (z.1 r q).1 r hr (idH (lin r)) ;

  -- z at q restricted along a strict mu is z at q mu
  zc-mu (r1 r2 : Nat) (rN1 : IsT (leb r1 N)) (rN2 : IsT (leb r2 N)) (q : Hom (lin r1) Y) (mu : Hom (lin r2) (lin r1))
    (ms : Strict (lin r2) (lin r1) mu)
    : Id (TA.EI (lin r2)) (TA.E.act (lin r2) (lin r1) mu (zc r1 rN1 q)) (zc r2 rN2 (compH (lin r2) (lin r1) Y q mu)) =
    calc (TA.EI (lin r2)) {
        TA.E.act (lin r2) (lin r1) mu (zc r1 rN1 q)
      =< (z.1 r1 q).2 r2 r1 rN2 rN1 mu (idH (lin r1)) >
        KM.rd (lin r1) (G.act (lin r1) Y q y) (z.1 r1 q).1 r2 rN2 (compH (lin r2) (lin r1) (lin r1) (idH (lin r1)) mu)
      =< apH (\ k -> KM.rd (lin r1) (G.act (lin r1) Y q y) (z.1 r1 q).1 r2 rN2 k)
           (transH (comp-idl (lin r2) (lin r1) mu) (symH (comp-idr (lin r2) (lin r1) mu))) >
        KM.rd (lin r1) (G.act (lin r1) Y q y) (z.1 r1 q).1 r2 rN2 (compH (lin r2) (lin r2) (lin r1) mu (idH (lin r2)))
      =< symH (KM.rd-ktact (lin r2) (lin r1) mu (G.act (lin r1) Y q y) (G.act (lin r2) (lin r1) mu (G.act (lin r1) Y q y))
                 (refl (G.act (lin r2) (lin r1) mu (G.act (lin r1) Y q y))) (z.1 r1 q) r2 rN2 (idH (lin r2))) >
        KM.rd (lin r2) (G.act (lin r2) (lin r1) mu (G.act (lin r1) Y q y))
          (KM.ktact (lin r2) (lin r1) mu (G.act (lin r1) Y q y) (G.act (lin r2) (lin r1) mu (G.act (lin r1) Y q y))
             (refl (G.act (lin r2) (lin r1) mu (G.act (lin r1) Y q y))) (z.1 r1 q)).1 r2 rN2 (idH (lin r2))
      =< apH (\ w -> KM.rd (lin r2) w.1 w.2.1 r2 rN2 (idH (lin r2))) (z.2 r2 r1 mu ms q) >
        zc r2 rN2 (compH (lin r2) (lin r1) Y q mu) } ;

  module At (W : Nat) (g : Hom (lin W) P) {
    module Z = EZ.EZX[P, ht, B, hB, hm, hi, W, g] ;
    rN : IsT (leb Z.r N) = leb-trans Z.r B N Z.rle hBN ;
    pc : Hom (lin Z.r) Y = compH (lin Z.r) P Y phi Z.c ;
    val : TA.EI (lin W) = TA.E.act (lin W) (lin Z.r) Z.sgm (zc Z.r rN pc) ;

    vp : Id (W0.Ix (G.ob (lin W))) val.1 (G.act (lin W) P g yP) =
      calc (W0.Ix (G.ob (lin W))) {
          G.act (lin W) (lin Z.r) Z.sgm (G.act (lin Z.r) (lin Z.r) (idH (lin Z.r)) (G.act (lin Z.r) Y pc y))
        =< apH (G.act (lin W) (lin Z.r) Z.sgm) (G.act-id (lin Z.r) (G.act (lin Z.r) Y pc y)) >
          G.act (lin W) (lin Z.r) Z.sgm (G.act (lin Z.r) Y pc y)
        =< GL.actC (lin W) (lin Z.r) Y pc Z.sgm y >
          G.act (lin W) Y (compH (lin W) (lin Z.r) Y pc Z.sgm) y
        =< apH (\ k -> G.act (lin W) Y k y)
             (transH (comp-assoc (lin W) (lin Z.r) P Y phi Z.c Z.sgm) (apH (compH (lin W) P Y phi) Z.fac)) >
          G.act (lin W) Y (compH (lin W) P Y phi g) y
        =< G.act-o (lin W) P Y phi g y >
          G.act (lin W) P g yP } ;
  } ;

  val (W : Nat) (g : Hom (lin W) P) : TA.EI (lin W) = At[W, g].val ;

  vp (W : Nat) (g : Hom (lin W) P) : Id (W0.Ix (G.ob (lin W))) (val W g).1 (G.act (lin W) P g yP) = At[W, g].vp ;

  module VN (V W : Nat) (k : Hom (lin V) (lin W)) (g : Hom (lin W) P) {
    module K = EZ.EZXK[P, ht, B, hB, hm, hi, W, V, g, k] ;
    r1 : Nat = K.Z1.r ;
    r2 : Nat = K.Z2.r ;
    rN1 : IsT (leb r1 N) = leb-trans r1 B N K.Z1.rle hBN ;
    rN2 : IsT (leb r2 N) = leb-trans r2 B N K.Z2.rle hBN ;
    pc1 : Hom (lin r1) Y = compH (lin r1) P Y phi K.Z1.c ;
    pc2 : Hom (lin r2) Y = compH (lin r2) P Y phi K.Z2.c ;

    pcmu : Id (Hom (lin r2) Y) (compH (lin r2) (lin r1) Y pc1 K.mu) pc2 =
      transH (comp-assoc (lin r2) (lin r1) P Y phi K.Z1.c K.mu) (apH (compH (lin r2) P Y phi) K.cmu) ;

    mu-z : Id (TA.EI (lin r2)) (TA.E.act (lin r2) (lin r1) K.mu (zc r1 rN1 pc1)) (zc r2 rN2 pc2) =
      transH (zc-mu r1 r2 rN1 rN2 pc1 K.mu K.muStrict) (apH (\ q -> zc r2 rN2 q) pcmu) ;

    res : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) k (val W g)) (val V (compH (lin V) (lin W) P g k)) =
      calc (TA.EI (lin V)) {
          TA.E.act (lin V) (lin W) k (TA.E.act (lin W) (lin r1) K.Z1.sgm (zc r1 rN1 pc1))
        =< TA.PE.actC (lin V) (lin W) (lin r1) K.Z1.sgm k (zc r1 rN1 pc1) >
          TA.E.act (lin V) (lin r1) (compH (lin V) (lin W) (lin r1) K.Z1.sgm k) (zc r1 rN1 pc1)
        =< TA.PE.actEq (lin V) (lin r1) (compH (lin V) (lin W) (lin r1) K.Z1.sgm k) (compH (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm)
             K.muEq (zc r1 rN1 pc1) >
          TA.E.act (lin V) (lin r1) (compH (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm) (zc r1 rN1 pc1)
        =< TA.E.act-o (lin V) (lin r2) (lin r1) K.mu K.Z2.sgm (zc r1 rN1 pc1) >
          TA.E.act (lin V) (lin r2) K.Z2.sgm (TA.E.act (lin r2) (lin r1) K.mu (zc r1 rN1 pc1))
        =< apH (TA.E.act (lin V) (lin r2) K.Z2.sgm) mu-z >
          TA.E.act (lin V) (lin r2) K.Z2.sgm (zc r2 rN2 pc2) } ;
    opaque mu-z ;
  } ;

  vn (V W : Nat) (k : Hom (lin V) (lin W)) (g : Hom (lin W) P)
    : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) k (val W g)) (val V (compH (lin V) (lin W) P g k)) = VN[V, W, k, g].res ;
  opaque vp ; opaque vn ; opaque zc-mu ;
} ;

------------------------------------------------------------------------
-- along a strict iota : P' -> P, the reading along phi iota is the
-- reading along phi, precomposed with iota

module DRI (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P' : Ob) (ht' : El P' -> Nat) (B' : Nat) (hB' : (x : El P') -> IsT (leb (ht' x) B'))
  (hm' : (x x' : El P') -> IsT (le P' x.1 x'.1) -> IsT (leb (ht' x) (ht' x')))
  (hi' : (x x' : El P') -> IsT (le P' x.1 x'.1) -> Id Nat (ht' x) (ht' x') -> Id Tree x.1 x'.1)
  (hBN' : IsT (leb B' N))
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (hBN : IsT (leb B N)) (phi : Hom P Y) (iota : Hom P' P) (ist : Strict P' P iota) (W : Nat) (g : Hom (lin W) P') {
  module D1 = DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN, phi] ;
  module D2 = DR[G, A, N, Y, y, z, P', ht', B', hB', hm', hi', hBN', compH P' P Y phi iota] ;
  module E = EZ.EZXI[P', ht', B', hB', hm', hi', P, ht, B, hB, hm, hi, iota, ist, W, g] ;
  module TA = D1.TA ;
  r1 : Nat = E.Z1.r ;
  r2 : Nat = E.Z2.r ;
  rN1 : IsT (leb r1 N) = leb-trans r1 B N E.Z1.rle hBN ;
  rN2 : IsT (leb r2 N) = leb-trans r2 B' N E.Z2.rle hBN' ;

  res : Id (TA.EI (lin W)) (D2.val W g) (D1.val W (compH (lin W) P' P iota g)) =
    symH (calc (TA.EI (lin W)) {
        TA.E.act (lin W) (lin r1) E.Z1.sgm (D1.zc r1 rN1 (compH (lin r1) P Y phi E.Z1.c))
      =< TA.PE.actEq (lin W) (lin r1) E.Z1.sgm (compH (lin W) (lin r2) (lin r1) E.mu E.Z2.sgm) E.muEq
           (D1.zc r1 rN1 (compH (lin r1) P Y phi E.Z1.c)) >
        TA.E.act (lin W) (lin r1) (compH (lin W) (lin r2) (lin r1) E.mu E.Z2.sgm) (D1.zc r1 rN1 (compH (lin r1) P Y phi E.Z1.c))
      =< TA.E.act-o (lin W) (lin r2) (lin r1) E.mu E.Z2.sgm (D1.zc r1 rN1 (compH (lin r1) P Y phi E.Z1.c)) >
        TA.E.act (lin W) (lin r2) E.Z2.sgm (TA.E.act (lin r2) (lin r1) E.mu (D1.zc r1 rN1 (compH (lin r1) P Y phi E.Z1.c)))
      =< apH (TA.E.act (lin W) (lin r2) E.Z2.sgm) (D1.zc-mu r1 r2 rN1 rN2 (compH (lin r1) P Y phi E.Z1.c) E.mu E.muStrict) >
        TA.E.act (lin W) (lin r2) E.Z2.sgm (D1.zc r2 rN2 (compH (lin r2) (lin r1) Y (compH (lin r1) P Y phi E.Z1.c) E.mu))
      =< apH (\ q -> TA.E.act (lin W) (lin r2) E.Z2.sgm (D1.zc r2 rN2 q))
           (transH (comp-assoc (lin r2) (lin r1) P Y phi E.Z1.c E.mu)
             (transH (apH (compH (lin r2) P Y phi) E.cmu) (symH (comp-assoc (lin r2) P' P Y phi iota E.Z2.c)))) >
        TA.E.act (lin W) (lin r2) E.Z2.sgm (D1.zc r2 rN2 (compH (lin r2) P' Y (compH P' P Y phi iota) E.Z2.c)) }) ;
} ;

------------------------------------------------------------------------
-- two readings over the same P that agree on the chains of P agree

module DRZ (G : PP.PCtx) (A : PP.PTy[G]) (N N' : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (Y' : Ob) (y' : W0.Ix (G.ob Y')) (z' : LD.DT[G, CK.KT[G, A, N'].KA].DEl Y' y')
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (hBN : IsT (leb B N)) (hBN' : IsT (leb B N')) (phi : Hom P Y) (phi' : Hom P Y')
  (ch : (r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r N')) (c : Hom (lin r) P)
        -> Id (PB.GPre[l].TyL[G, A].EI (lin r)) (DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN, phi].zc r hr (compH (lin r) P Y phi c))
                                                 (DR[G, A, N', Y', y', z', P, ht, B, hB, hm, hi, hBN', phi'].zc r hr' (compH (lin r) P Y' phi' c)))
  (W : Nat) (g : Hom (lin W) P) {
  module D1 = DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN, phi] ;
  module D2 = DR[G, A, N', Y', y', z', P, ht, B, hB, hm, hi, hBN', phi'] ;
  module Z = EZ.EZX[P, ht, B, hB, hm, hi, W, g] ;

  res : Id (D1.TA.EI (lin W)) (D1.val W g) (D2.val W g) =
    apH (D1.TA.E.act (lin W) (lin Z.r) Z.sgm) (ch Z.r (leb-trans Z.r B N Z.rle hBN) (leb-trans Z.r B N' Z.rle hBN') Z.c) ;
} ;

------------------------------------------------------------------------
-- the reading does not depend on the proof of B <= N

module DRP (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (P : Ob) (ht : El P -> Nat) (B : Nat) (hB : (x : El P) -> IsT (leb (ht x) B))
  (hm : (x x' : El P) -> IsT (le P x.1 x'.1) -> IsT (leb (ht x) (ht x')))
  (hi : (x x' : El P) -> IsT (le P x.1 x'.1) -> Id Nat (ht x) (ht x') -> Id Tree x.1 x'.1)
  (hBN hBN' : IsT (leb B N)) (phi : Hom P Y) (W : Nat) (g : Hom (lin W) P) {
  res : Id (PB.GPre[l].TyL[G, A].EI (lin W)) (DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN, phi].val W g)
                                              (DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, hBN', phi].val W g) =
    apH (\ q -> DR[G, A, N, Y, y, z, P, ht, B, hB, hm, hi, q, phi].val W g) (isProp-IsT' (leb B N) hBN hBN') ;
} ;

------------------------------------------------------------------------
-- on P = [n], the reading at the identity is z at phi

module DRId (G : PP.PCtx) (A : PP.PTy[G]) (N : Nat)
  (Y : Ob) (y : W0.Ix (G.ob Y)) (z : LD.DT[G, CK.KT[G, A, N].KA].DEl Y y)
  (n : Nat) (hBN : IsT (leb n N)) (phi : Hom (lin n) Y) (hr : IsT (leb n N)) {
  module D = DR[G, A, N, Y, y, z, lin n, EZ.HLin[n].ht, n, EZ.HLin[n].hB, EZ.HLin[n].hm, EZ.HLin[n].hi, hBN, phi] ;
  module Z = EZ.EZX[lin n, EZ.HLin[n].ht, n, EZ.HLin[n].hB, EZ.HLin[n].hm, EZ.HLin[n].hi, n, idH (lin n)] ;
  module TA = D.TA ;

  res : Id (TA.EI (lin n)) (D.val n (idH (lin n))) (D.zc n hr phi) =
    calc (TA.EI (lin n)) {
        TA.E.act (lin n) (lin Z.r) Z.sgm (D.zc Z.r (leb-trans Z.r n N Z.rle hBN) (compH (lin Z.r) (lin n) Y phi Z.c))
      =< apH (TA.E.act (lin n) (lin Z.r) Z.sgm) (symH (D.zc-mu n Z.r hr (leb-trans Z.r n N Z.rle hBN) phi Z.c Z.cstrict)) >
        TA.E.act (lin n) (lin Z.r) Z.sgm (TA.E.act (lin Z.r) (lin n) Z.c (D.zc n hr phi))
      =< TA.PE.actC (lin n) (lin Z.r) (lin n) Z.c Z.sgm (D.zc n hr phi) >
        TA.E.act (lin n) (lin n) (compH (lin n) (lin Z.r) (lin n) Z.c Z.sgm) (D.zc n hr phi)
      =< TA.PE.actEq (lin n) (lin n) _ _ Z.fac (D.zc n hr phi) >
        TA.E.act (lin n) (lin n) (idH (lin n)) (D.zc n hr phi)
      =< TA.E.act-id (lin n) (D.zc n hr phi) >
        D.zc n hr phi } ;
} ;
