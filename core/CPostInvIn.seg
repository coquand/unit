-- CPostInvIn.seg (L9): the recursion of CPostRec run on phi(u), for u in
-- DA (POSTNIKOV-INFORMAL.md, "Boundary data"): its readings are those of u.
--
--   DUv     the reading of u_N along f (the end H(f , N) at t = 1) is the
--           simplex U_f
--   zcP     the path p_N of phi(u) at a chain q of X * [1] is u at pr1 q
--   DPv     the reading of p_N along f * [1] (the edge Theta(f , N) at
--           t = 1) is the prism R of CPostRead

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LM = CPostLimit[a, l] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;
module RD = CPostRead[a, l] ;

module In (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) (X : Ob) (x : W.Ix (G.ob X))
  (u : LM.Post[G, A].DA.DEl X x) {
  module P = LM.Post[G, A] ;
  z : W.Ix (P.L.tob X x) = P.phi.nfun X x u ;
  module I = CPostInput[a, l].Input[G, A, X, x, z] ;
  module C = I.Construction[c] ;
  module Lr = C.Rec ;
  module UR = RD.RU[G, A, X, x, u] ;
  module TA = PR.TyL[G, A] ;

  -- the end H(f , N) at t = 1
  DUv (m N : Nat) (hN : IsT (leb (suc m) N)) (f : Hom (lin m) X) (W1 : Nat) (g : Hom (lin W1) (lin m))
    : Id (TA.EI (lin W1)) (Lr.DU[m, N, hN, f].D.val W1 g) (TA.E.act (lin W1) (lin m) g (UR.Uf m f)) =
    UR.RdS[m, N, leb-trans m (suc m) N (leb-suc m) hN, f, W1, g].res ;

  -- p_N at a chain of X * [1]
  zcP (N r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) I.XI)
    : Id (TA.EI (lin r)) (I.At[N].rd I.XI (I.xI, I.p N) r hr q) (UR.Uf r (compH (lin r) I.XI X (pr1 X Iv) q)) =
    transH (apH (\ w -> I.At[N].rd I.XI w r hr q) I.R.At[N].ep)
      (transH (I.At[N].rd-act I.XI X (pr1 X Iv) (x, (P.v N).nfun X x u) r hr q)
              (TA.E.act-id (lin r) (UR.Uf r (compH (lin r) I.XI X (pr1 X Iv) q)))) ;

  -- the edge Theta(f , N) at t = 1
  module DP (m N : Nat) (hN : IsT (leb (suc m) N)) (f : Hom (lin m) X) {
    module S = UR.Sq[m, f] ;
    fI : Hom S.P1 I.XI = crossH (lin m) X Iv Iv f (idH Iv) ;
    pr1-fI : Id (Hom S.P1 X) (compH S.P1 I.XI X (pr1 X Iv) fI) S.phi1 =
      pr1-pair X Iv S.P1 (compH S.P1 (lin m) X f (pr1 (lin m) Iv)) (compH S.P1 Iv Iv (idH Iv) (pr2 (lin m) Iv)) ;

    val (W1 : Nat) (g : Hom (lin W1) S.P1) : Id (TA.EI (lin W1)) (Lr.DP[m, N, hN, f].D.val W1 g) (S.R.D.val W1 g) =
      PM.DRZ[G, A, N, S.N1, I.XI, I.xI, I.p N, X, x, UR.w S.N1, S.P1, S.H1.ht, S.H1.B, S.H1.hB, S.H1.hm, S.H1.hi,
        BD.leN m N hN, leb-refl S.N1, fI, S.phi1,
        \ r hr hr' c1 -> transH (zcP N r hr (compH (lin r) S.P1 I.XI fI c1))
          (transH (apH (UR.Uf r)
                    (transH (symH (comp-assoc (lin r) S.P1 I.XI X (pr1 X Iv) fI c1))
                            (apH (\ k -> compH (lin r) S.P1 X k c1) pr1-fI)))
                  (symH (S.R.zcU r hr' (compH (lin r) S.P1 X S.phi1 c1)))),
        W1, g].res ;
  } ;
} ;
