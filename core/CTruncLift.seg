-- A fibrant family of seeded propositions over a seeded proposition has
-- a seeded algebra on its total space.  Transport supplies the new seed;
-- the family's extension operation fills the boundary over the base ext.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ; module HO = PB.CHtpyOps[l] ;
module PF = PresheafFormers[a,l].PFormers[PB.BC] ;

module Lift (G : PCtx) (T : PTy[G]) (kt : CTruncAlg[a,l].Algebras[G,T].Algebra)
  (B : PTy[extP G T]) (kb : CTruncAlg[a,l].Algebras[extP G T,B].Algebra)
  (cb : PB.CLine[l].Lines[extP G T,B].CompK[e0,e1].Comp) {
  module S = PF.SigAB[G,T,B] ;
  module TT = PR.TyL[G,T] ; module TS = PR.TyL[G,S.SigP] ; module TB = PR.TyL[TT.E,B] ;
  module PS = CP.Partials[G,S.SigP] ; module PT = CP.Partials[G,T] ; module PB' = CP.Partials[TT.E,B] ;
  module KT = CTruncSeeded[a,l].FromAlgebra[G,T,T,kt] ;
  module KB = CTruncSeeded[a,l].FromAlgebra[TT.E,B,B,kb] ;
  module Tr = CTruncTransport[a,l].Transport[G,T,kt,B,cb] ;
  module KS = CTruncSeededBack[a,l].Seeded[G,S.SigP] ;
  projection : HO.NMap[G,S.SigP,T] = new HO.NMap[G,S.SigP,T,
    \ X x u -> u.1,\ Y X h x y e u -> refl (T.tact Y X h x y e u.1)] ;
  module P = CLocBoundRetr[a,l].Map[G,S.SigP,T,projection] ;
  assoc (X : Ob) (v : TS.EI X) : TB.EI X = ((v.1,v.2.1),v.2.2) ;
  unassoc (X : Ob) (v : TB.EI X) : TS.EI X = (v.1.1,(v.1.2,v.2)) ;
  assoc-nat (Y X : Ob) (h : Hom Y X) (v : TS.EI X) :
    Id (TB.EI Y) (TB.E.act Y X h (assoc X v)) (assoc Y (TS.E.act Y X h v)) =
    TB.pr-tact Y X h (v.1,v.2.1)
      (G.act Y X h v.1,T.tact Y X h v.1 (G.act Y X h v.1) (refl (G.act Y X h v.1)) v.2.1)
      (TT.pr-tact Y X h v.1 (G.act Y X h v.1) (refl (G.act Y X h v.1)) v.2.1) v.2.2 ;
  opaque assoc-nat ;
  module At (X : Ob) (x : TS.Pt X) (u : TS.T X x) (s : PS.Side[X,x]) {
    ts : PT.Side[X,x] = P.side X x s ;
    t : TT.T X x = KT.kop X x u.1 ts ;
    module Seed = Tr.At[X,x,u.1,t,u.2] ;
    side : PB'.Side[X,(x,t)] = new PB'.Side[X,(x,t),s.pQ,
      \ Y h i -> assoc Y (s.pv Y h i),
      \ Y h i -> symH (KT.kside X x u.1 ts Y h i),
      \ Z Y g h i j -> transH (assoc-nat Z Y g (s.pv Y h i)) (apH (assoc Z) (s.pnat Z Y g h i j))] ;
    value : TS.T X x = (t,KB.kop X (x,t) Seed.value side) ;
  } ;
  kop (X : Ob) (x : TS.Pt X) (u : TS.T X x) (s : PS.Side[X,x]) : TS.T X x = At[X,x,u,s].value ;
  kside (X : Ob) (x : TS.Pt X) (u : TS.T X x) (s : PS.Side[X,x])
    (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h) :
    Id (TS.EI Y) (TS.E.act Y X h (x,kop X x u s)) (s.pv Y h i) =
    apH (unassoc Y) (transH (symH (assoc-nat Y X h (x,kop X x u s)))
      (KB.kside X (x,At[X,x,u,s].t) At[X,x,u,s].Seed.value At[X,x,u,s].side Y h i)) ;
  opaque kside ;
  module Uniform (Y X : Ob) (h : Hom Y X) (x : TS.Pt X) (u : TS.T X x) (s : PS.Side[X,x]) {
    y : TS.Pt Y = G.act Y X h x ;
    ru : TS.T Y y = S.SigP.tact Y X h x y (refl y) u ;
    rs : PS.Side[Y,y] = PS.rside Y X h x s ;
    module A0 = At[X,x,u,s] ; module A1 = At[Y,y,ru,rs] ;
    te : Id (TT.EI Y) (TT.E.act Y X h (x,A0.t)) (y,A1.t) =
      transH (KT.kunif Y X h x u.1 A0.ts)
        (KT.kop-cong Y y y (refl y) ru.1 ru.1 (refl (y,ru.1))
          (PT.rside Y X h x A0.ts) A1.ts (P.side-res Y X h x s)) ;
    pe : Id (W.Ix (Tr.P.Pth.GA.ob Y)) (Tr.P.Pth.GA.act Y X h (x,(u.1,A0.t))) (y,(ru.1,A1.t)) =
      apH (\ t -> (y,(ru.1,t))) (TT.pr-inj Y y _ _ te) ;
    seed-eq : Id (TB.EI Y) (TB.E.act Y X h ((x,A0.t),A0.Seed.value)) ((y,A1.t),A1.Seed.value) =
      Tr.Natural[Y,X,h,x,y,u.1,A0.t,ru.1,A1.t,pe,u.2,ru.2,assoc-nat Y X h (x,u)].result ;
    se : Id (PB'.Side[Y,(y,A1.t)])
      (substH (\ w -> PB'.Side[Y,w]) te (PB'.rside Y X h (x,A0.t) A0.side)) A1.side =
      PB'.side-extH Y (TT.E.act Y X h (x,A0.t)) (y,A1.t) te
        (PB'.rside Y X h (x,A0.t) A0.side) A1.side (refl (PB.pre Y X h s.pQ))
        (\ Z g i j -> apH (assoc Z) (PS.pv-irr X x s Z (compH Z Y X h g) i j)) ;
    result : Id (TS.EI Y) (TS.E.act Y X h (x,kop X x u s)) (y,kop Y y ru rs) =
      apH (unassoc Y) (transH (symH (assoc-nat Y X h (x,kop X x u s)))
        (transH (KB.kunif Y X h (x,A0.t) A0.Seed.value A0.side)
          (KB.kop-cong Y (TT.E.act Y X h (x,A0.t)) (y,A1.t) te
            (B.tact Y X h (x,A0.t) (TT.E.act Y X h (x,A0.t)) (refl (TT.E.act Y X h (x,A0.t))) A0.Seed.value)
            A1.Seed.value seed-eq (PB'.rside Y X h (x,A0.t) A0.side) A1.side se))) ;
    opaque result ;
  } ;
  op : KS.Op = new KS.Op[kop,kside,\ Y X h x u s -> Uniform[Y,X,h,x,u,s].result] ;
  module Back = KS.Algebra[op] ;
  algebra : CTruncAlg[a,l].Algebras[G,S.SigP].Algebra = Back.algebra ;
  module M = CTruncHom[a,l].Maps[G,S.SigP,T,projection] ;
  module RT = CTruncSeededBack[a,l].Seeded[G,T].RoundTrip[kt] ;
  open CTruncRaw[a,l].Build[G,T] ;
  module Projects (z : Loc) (Q : PB.Phi z.1) (u : TS.T z.1 z.2)
    (v : CTruncAlg[a,l].Algebras[G,S.SigP].Partial z Q)
    (vn : CTruncAlg[a,l].Algebras[G,S.SigP].Natural z Q v) {
    module S0 = Back.Side[z,Q,v,vn] ;
    module S1 = RT.Back.Side[z,Q,M.partial z Q v,M.natural z Q v vn] ;
    sides : Id (PT.Side[z.1,z.2]) (P.side z.1 z.2 S0.side) S1.side =
      PT.side-ext z.1 z.2 (P.side z.1 z.2 S0.side) S1.side (refl Q)
        (\ Y h i j -> apH (\ w -> (G.act Y z.1 h z.2,w.1))
          (CTruncAlg[a,l].Algebras[G,S.SigP].partial-cong z Q v
            (Y,G.act Y z.1 h z.2) (h,refl (G.act Y z.1 h z.2))
            (h,refl (G.act Y z.1 h z.2)) (refl (h,refl (G.act Y z.1 h z.2))) i j)) ;
    result : Id (TT.T z.1 z.2) (algebra.extend z Q u v vn).1
      (kt.extend z Q u.1 (M.partial z Q v) (M.natural z Q v vn)) =
      transH (TT.pr-inj z.1 z.2 _ _
        (KT.kop-cong z.1 z.2 z.2 (refl z.2) u.1 u.1 (refl (z.2,u.1))
          (P.side z.1 z.2 S0.side) S1.side sides))
        RT.At[z,Q,u.1,M.partial z Q v,M.natural z Q v vn].result ;
    opaque result ;
  } ;
  projects : M.Preserves algebra kt = \ z Q u v vn -> Projects[z,Q,u,v,vn].result ;
  opaque projects ;
} ;
