-- The ordinary internal isProp statement, with two variables u,v:A:
-- in context Gamma.A the first is the centre, and every second point is
-- connected to it by a path in the pulled-back family.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ; module CP = PB.CPartial[l] ;

module Proposition (G : PCtx) (A : PTy[G]) {
  D : PCtx = extP G A ;
  C : PTy[D] = subTy D G A (pP G A) ;
  centre : PEl[D,C] = qP G A ;
  constant : HO.NMap[D,C,C] = CLocBoundContr[a,l].constant D C centre ;
  module H = HO.HT[D,C,C,constant,HO.idN D C] ;
  isProp : U l+ = PEl[H.GA,H.PT.PathP] ;

  module Fibrant (c : PB.CLine[l].Lines[G,A].CompK[e0,e1].Comp) (prop : isProp) {
    module TC = PR.TyL[D,C] ; module P = CP.Partials[D,C] ;
    module M = CLocBoundRetr[a,l].Map[D,C,C,constant] ;
    module R = CP.Rel[D,C,C,M.pmap] ;
    sec : PSub[D,TC.E] = secP D C centre ;
    initial (X : Ob) (x : TC.Pt X) (s : P.Side[X,x]) : TC.T X x = centre.eob X x ;
    sides (X : Ob) (x : TC.Pt X) (s : P.Side[X,x]) (Y : Ob) (h : Hom Y X)
      (i : PB.Lands Y X s.pQ h) :
      Id (TC.EI Y) (TC.E.act Y X h (x,initial X x s)) (M.onE Y (s.pv Y h i)) =
      transH (symH (sec.nt-nat Y X h x)) (apH (sec.nt Y) (symH (s.ppt Y h i))) ;
    uniform (Y X : Ob) (h : Hom Y X) (x : TC.Pt X) (s : P.Side[X,x]) :
      Id (TC.EI Y) (TC.E.act Y X h (x,initial X x s))
        (D.act Y X h x,initial Y (D.act Y X h x) (P.rside Y X h x s)) =
      symH (sec.nt-nat Y X h x) ;
    relative : R.RC = new R.RC[initial,sides,uniform] ;
    comp : PB.CLine[l].Lines[D,C].CompK[e0,e1].Comp =
      PB.CFibSub[l].FibSub[D,G,pP G A,A].C.MoveComp[e0,e1].move c ;
    contract : CP.ContrOp D C = CLocBoundRetr[a,l].Correct[D,C,constant,relative,prop,comp].extension ;
  } ;
} ;
