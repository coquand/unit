-- CExtComp3.seg (L5, inside CB, level l): Theorem 7, composition, steps
-- (3)-(5) (model.tex §6.1): w1 = the A-filler at eT; the side of the
-- fibre of ext over w1 with constant paths, joined from the ends of p (on
-- p's sieve) and the top of the B-filler (on delta), is extended by the
-- equivalence half (CExtEquiv3); the composite is the B-part of the
-- extension.  cside: on p's sieve the composite is the end of p.
--
-- Quarry: seg/model GExtComp3, one sieve per side.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module C3 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (eS eT : IPt) (kAS : CLine[l].Lines[G, A].Fill eS)
  (kBS : CLine[l].Lines[GP.CofL[G, psi].resCtx, B].Fill eS)
  (kA1 : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  open CExtComp1[l].C1[G, A, psi, B, al, eS, kBS] ;
  open CExtComp2[l].C2[G, A, psi, B, al, eS, kAS, kBS] ;

  module FX = CEquiv[l].HFib[G, ExtT, A, extMap] ;
  module PX = CPartial[l].Partials[EA, FX.FibT] ;
  module E3 = CExtEquiv3[l].ExtEq3[G, A, psi, B, al, kA1, eal] ;
  module KX' = CLine[l].EndKit[G, ExtT, eT] ;
  module CK = CLine[l].Lines[G, ExtT].CompK[eS, eT] ;
  module TT = PR.TyL[KX.TV.E, CK.Tend] ;

  -- the fibre element over wf with the constant path, at an element el of
  -- Ext whose ext is wf
  cfib (V : Ob) (wf : TA.EI V) (el : TX.EI V) (eq : Id (TA.EI V) wf (extE V el)) : FX.TF.EI V =
    FX.mkFib V wf (TX.fromE V wf.1 el (transH (symH (extE-pt V el)) (apH (\ z -> z.1) (symH eq))))
      (\ W g j -> TA.E.act W V g wf)
      (\ W' W g' g j -> TA.PE.actC W' W V g g' wf)
      (\ W g j -> refl (G.act W V g wf.1))
      (transH (TA.E.act-id V wf)
        (transH eq (apH (extE V) (symH (TX.fromE-eq V wf.1 el (transH (symH (extE-pt V el)) (apH (\ z -> z.1) (symH eq))))))))
      (TA.E.act-id V wf) ;

  cfib-B (V : Ob) (wf : TA.EI V) (el : TX.EI V) (eq : Id (TA.EI V) wf (extE V el)) : Id (TX.EI V) (FX.fibB V (cfib V wf el eq)) el =
    TX.fromE-eq V wf.1 el (transH (symH (extE-pt V el)) (apH (\ z -> z.1) (symH eq))) ;

  -- two constant fibre elements over related points with related elements
  cfib-eq (V : Ob) (wf wf' : TA.EI V) (P : Id (TA.EI V) wf wf') (el el' : TX.EI V) (Q : Id (TX.EI V) el el')
    (eq : Id (TA.EI V) wf (extE V el)) (eq' : Id (TA.EI V) wf' (extE V el'))
    : Id (FX.TF.EI V) (cfib V wf el eq) (cfib V wf' el' eq') =
    FX.fibE-eq V (cfib V wf el eq) (cfib V wf' el' eq') P
      (transH (cfib-B V wf el eq) (transH Q (symH (cfib-B V wf' el' eq'))))
      (\ W g j -> apH (TA.E.act W V g) P) ;

  -- the restriction of a constant fibre element
  cfib-act (V' V : Ob) (chi : Hom V' V) (wf : TA.EI V) (el : TX.EI V) (eq : Id (TA.EI V) wf (extE V el))
    (el' : TX.EI V') (Q : Id (TX.EI V') (TX.E.act V' V chi el) el') (eq' : Id (TA.EI V') (TA.E.act V' V chi wf) (extE V' el'))
    : Id (FX.TF.EI V') (FX.TF.E.act V' V chi (cfib V wf el eq)) (cfib V' (TA.E.act V' V chi wf) el' eq') =
    FX.fibE-eq V' (FX.TF.E.act V' V chi (cfib V wf el eq)) (cfib V' (TA.E.act V' V chi wf) el' eq') (refl (TA.E.act V' V chi wf))
      (transH (FX.fibB-act V' V chi (cfib V wf el eq))
        (transH (apH (TX.E.act V' V chi) (cfib-B V wf el eq)) (transH Q (symH (cfib-B V' (TA.E.act V' V chi wf) el' eq')))))
      (\ W g j -> symH (TA.PE.actC W V' V chi g wf)) ;

  opaque cfib-B ; opaque cfib-eq ; opaque cfib-act ;



  module Cop (X : Ob) (x : KX.TV.EI X) (p : KX.PT.Side[X, x]) {
    module PB = Pb[X, x, p] ;

    w1 : TA.EI X = PB.FAv X (idH X) (ptH X eT) ;

    -- the restriction of w1 along f is the filler at (f , eT)
    w1-act (V : Ob) (f : Hom V X) : Id (TA.EI V) (TA.E.act V X f w1) (PB.FAv V (compH V V X f (idH V)) (ptH V eT)) =
      transH (PB.FAn V X f (idH X) (ptH X eT))
        (transH (apH (\ k -> PB.FAv V k (compH V X Iv (ptH X eT) f)) (transH (comp-idl V X f) (symH (comp-idr V X f))))
                (apH (\ k -> PB.FAv V (compH V V X f (idH V)) k) (ptH-nat V X f eT))) ;

    ------------------------------------------------------------------
    -- the side on p's sieve: the ends at eT of p

    el1 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) : TX.EI V = lvX V (p.pv V f i) V (idH V) (ptH V eT) ;

    eq1 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) : Id (TA.EI V) (TA.E.act V X f w1) (extE V (el1 V f i)) =
      transH (w1-act V f) (PB.F-S1 V f i V (idH V) (ptH V eT)) ;

    fe1 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) : FX.TF.EI V = cfib V (TA.E.act V X f w1) (el1 V f i) (eq1 V f i) ;

    -- the end at eT, restricted, is the end of the restricted side
    el1-act (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X p.pQ f) (i' : Lands V' X p.pQ (compH V' V X f chi))
      : Id (TX.EI V') (TX.E.act V' V chi (el1 V f i)) (el1 V' (compH V' V X f chi) i') =
      transH ((KX.lineL V (p.pv V f i)).2.1.2 V' V chi (idH V) (ptH V eT))
       (transH (transH (apH (\ k -> lvX V (p.pv V f i) V' k (compH V' V Iv (ptH V eT) chi)) (transH (comp-idl V' V chi) (symH (comp-idr V' V chi))))
                       (apH (\ k -> lvX V (p.pv V f i) V' (compH V' V' V chi (idH V')) k) (ptH-nat V' V chi eT)))
        (transH (symH (apH (\ M -> M.2.1.1 V' (idH V') (ptH V' eT)) (KX.lineL-act V' V chi (p.pv V f i))))
                (apH (\ u -> lvX V' u V' (idH V') (ptH V' eT)) (p.pnat V' V chi f i i')))) ;

    S1 : PX.Side[X, w1] =
      new PX.Side[X, w1, p.pQ, fe1, \ V f i -> refl (TA.E.act V X f w1),
        \ V' V chi f i i' ->
          transH (cfib-act V' V chi (TA.E.act V X f w1) (el1 V f i) (eq1 V f i)
                    (el1 V' (compH V' V X f chi) i') (el1-act V' V chi f i i')
                    (transH (TA.PE.actC V' V X f chi w1) (eq1 V' (compH V' V X f chi) i')))
                 (cfib-eq V' (TA.E.act V' V chi (TA.E.act V X f w1)) (TA.E.act V' X (compH V' V X f chi) w1) (TA.PE.actC V' V X f chi w1)
                    (el1 V' (compH V' V X f chi) i') (el1 V' (compH V' V X f chi) i') (refl (el1 V' (compH V' V X f chi) i'))
                    (transH (TA.PE.actC V' V X f chi w1) (eq1 V' (compH V' V X f chi) i')) (eq1 V' (compH V' V X f chi) i'))] ;

    ------------------------------------------------------------------
    -- the side on delta: the top of the B-filler, read in Ext

    tB (V : Ob) (f : Hom V X) (i : Lands V X PB.dl f) : TB.EI V = PB.BW[V, f, i].BB.FBv V (idH V) (ptH V eT) ;

    el2 (V : Ob) (f : Hom V X) (i : Lands V X PB.dl f) : TX.EI V = fromB V (tB V f i) ;

    eq2 (V : Ob) (f : Hom V X) (i : Lands V X PB.dl f) : Id (TA.EI V) (TA.E.act V X f w1) (extE V (el2 V f i)) =
      transH (w1-act V f) (transH (PB.F-S2 V f i V (idH V) (ptH V eT)) (symH (extE-B V (tB V f i)))) ;

    fe2 (V : Ob) (f : Hom V X) (i : Lands V X PB.dl f) : FX.TF.EI V = cfib V (TA.E.act V X f w1) (el2 V f i) (eq2 V f i) ;

    el2-act (V' V : Ob) (chi : Hom V' V) (f : Hom V X) (i : Lands V X PB.dl f) (i' : Lands V' X PB.dl (compH V' V X f chi))
      : Id (TX.EI V') (TX.E.act V' V chi (el2 V f i)) (el2 V' (compH V' V X f chi) i') =
      transH (actX-B V' V chi (tB V f i))
        (apH (fromB V')
          (transH (PB.BW[V, f, i].BB.fillB.1.1.2 V' V chi (idH V) (ptH V eT))
            (transH (transH (apH (\ k -> PB.BW[V, f, i].BB.FBv V' k (compH V' V Iv (ptH V eT) chi))
                                 (transH (comp-idl V' V chi) (symH (comp-idr V' V chi))))
                            (apH (\ k -> PB.BW[V, f, i].BB.FBv V' (compH V' V' V chi (idH V')) k) (ptH-nat V' V chi eT)))
                    (symH (PB.FBv-tr V' V chi f i i' V' (idH V') (ptH V' eT)))))) ;

    S2 : PX.Side[X, w1] =
      new PX.Side[X, w1, PB.dl, fe2, \ V f i -> refl (TA.E.act V X f w1),
        \ V' V chi f i i' ->
          transH (cfib-act V' V chi (TA.E.act V X f w1) (el2 V f i) (eq2 V f i)
                    (el2 V' (compH V' V X f chi) i') (el2-act V' V chi f i i')
                    (transH (TA.PE.actC V' V X f chi w1) (eq2 V' (compH V' V X f chi) i')))
                 (cfib-eq V' (TA.E.act V' V chi (TA.E.act V X f w1)) (TA.E.act V' X (compH V' V X f chi) w1) (TA.PE.actC V' V X f chi w1)
                    (el2 V' (compH V' V X f chi) i') (el2 V' (compH V' V X f chi) i') (refl (el2 V' (compH V' V X f chi) i'))
                    (transH (TA.PE.actC V' V X f chi w1) (eq2 V' (compH V' V X f chi) i')) (eq2 V' (compH V' V X f chi) i'))] ;

    ------------------------------------------------------------------
    -- on the overlap: the end of p is the top of the B-filler

    e12 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (i' : Lands V X PB.dl f) : Id (TX.EI V) (el1 V f i) (el2 V f i') =
      symH (transH (apH (\ z -> fromB V z)
                      (transH (apH (\ k -> PB.BW[V, f, i'].BB.FBv V k (ptH V eT)) (symH (comp-idl V V (idH V))))
                              (PB.BW[V, f, i'].BB.FB-side V (idH V) (PB.i0 V f i) V (idH V) (ptH V eT))))
             (transH (fromB-toB V (lvX V ((KX.PT.rside V X f x p).pv V (idH V) (PB.i0 V f i)) V (idH V) (ptH V eT))
                        (PB.BW[V, f, i'].BB.SV[V, idH V, (KX.PT.rside V X f x p).pv V (idH V) (PB.i0 V f i),
                                               (KX.PT.rside V X f x p).ppt V (idH V) (PB.i0 V f i)].qv V (idH V) (ptH V eT)))
                     (apH (\ u -> lvX V u V (idH V) (ptH V eT)) (PB.pv-id V f i)))) ;

    c12 (V : Ob) (f : Hom V X) (i : Lands V X p.pQ f) (i' : Lands V X PB.dl f) : Id (FX.TF.EI V) (fe1 V f i) (fe2 V f i') =
      cfib-eq V (TA.E.act V X f w1) (TA.E.act V X f w1) (refl (TA.E.act V X f w1)) (el1 V f i) (el2 V f i')
        (e12 V f i i') (eq1 V f i) (eq2 V f i') ;

    pick : Nat -> PX.Side[X, w1] = split { zero -> S1 ; suc m -> S2 } ;

    CTy (n n' : Nat) : U l = (V : Ob) (f : Hom V X) (h : Lands V X (pick n).pQ f) (h' : Lands V X (pick n').pQ f)
      -> Id (FX.TF.EI V) ((pick n).pv V f h) ((pick n').pv V f h') ;

    cc0 : (n' : Nat) -> CTy zero n' = split {
      zero -> \ V f h h' -> PX.pv-irr X w1 S1 V f h h' ;
      suc m -> \ V f h h' -> c12 V f h h' } ;

    cc1 : (n' : Nat) -> CTy (suc zero) n' = split {
      zero -> \ V f h h' -> symH (c12 V f h' h) ;
      suc m -> \ V f h h' -> PX.pv-irr X w1 S2 V f h h' } ;

    cc : (n n' : Nat) -> CTy n n' = split { zero -> cc0 ; suc m -> cc1 } ;

    module J2 = CPartial[l].Join[EA, FX.FibT, X, w1, suc (suc zero), \ k -> pick k.1, \ k k' -> cc k.1 k'.1] ;

    fin0 : Arith[a].Fin (suc (suc zero)) = (zero, refl true) ;

    ------------------------------------------------------------------
    -- the extension, and the composite

    kop : FX.TF.T X w1 = E3.extEquiv.kop X w1 J2.side ;

    vE : FX.TF.EI X = (w1, kop) ;

    cop : TX.T X (x.1.1 X (idH X) (ptH X eT)) = TX.fromE X (x.1.1 X (idH X) (ptH X eT)) (FX.fibB X vE) (PB.FApt X (idH X) (ptH X eT)) ;

    cop-E : Id (TX.EI X) (x.1.1 X (idH X) (ptH X eT), cop) (FX.fibB X vE) =
      TX.fromE-eq X (x.1.1 X (idH X) (ptH X eT)) (FX.fibB X vE) (PB.FApt X (idH X) (ptH X eT)) ;

    -- on p's sieve, the composite restricted is the end of p
    side-B (W : Ob) (f : Hom W X) (i : Lands W X p.pQ f)
      : Id (TX.EI W) (TX.E.act W X f (x.1.1 X (idH X) (ptH X eT), cop)) (el1 W f i) =
      transH (apH (TX.E.act W X f) cop-E)
       (transH (symH (FX.fibB-act W X f vE))
        (transH (apH (FX.fibB W) (E3.extEquiv.kside X w1 J2.side W f (J2.inS fin0 W f i)))
         (transH (apH (FX.fibB W) (J2.pv-in fin0 W f i (J2.inS fin0 W f i)))
                 (cfib-B W (TA.E.act W X f w1) (el1 W f i) (eq1 W f i))))) ;
  } ;

  ----------------------------------------------------------------------
  -- the side law of the composition

  cside (X : Ob) (x : KX.TV.EI X) (p : KX.PT.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X p.pQ f)
    : Id (TT.EI W) (TT.E.act W X f (x, Cop[X, x, p].cop)) (CK.endL.mE W (p.pv W f i)) =
    CK.SE.mV-inj W (TT.E.act W X f (x, Cop[X, x, p].cop)) (CK.endL.mE W (p.pv W f i)) (symH (p.ppt W f i))
      (KX'.tv-eq W (CK.SE.mV W (TT.E.act W X f (x, Cop[X, x, p].cop))) (CK.SE.mV W (CK.endL.mE W (p.pv W f i)))
         (apH (\ z -> z.1) (symH (p.ppt W f i)))
         (transH (apH (KX'.endE W) (symH (CK.SE.mV-nat W X f (x, Cop[X, x, p].cop))))
           (transH (KX'.endE-act W X f (CK.SE.mV X (x, Cop[X, x, p].cop)))
             (transH (Cop[X, x, p].side-B W f i)
                     (symH (CLine[l].FT[G, ExtT].Ev[eT].endB-E W (KX.lineL W (p.pv W f i)))))))) ;
} ;
