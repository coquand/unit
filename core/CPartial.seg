-- CPartial.seg (L2, inside CB, any level l): partial elements on ONE sieve
-- and relative contractibility structures.
--
--   Side[X , x]   a partial element of C at x : D(X): a sieve pQ of X and a
--                 section pv of C over it, lying over x (ppt), natural (pnat)
--   rside         restriction along h : Y -> X (functorial up to the point)
--   side-ext      two sides are equal when their sieves and values are
--   PMap          a map of types over D (on totals, over the identity)
--   RC[S , T , m] a relative contractibility structure for m : S -> T:
--                 every side of S at x has an extension in T at x agreeing
--                 with m on the sieve, uniformly
--   ContrOp       RC at the identity map; rc-ext: equal extensions, equal
--                 structures
--
-- Quarry: seg/model GCofib (Partials, ContrOp, kop-cong, contr-ext),
-- GLine.PMap.  No lists of sides: a list is notation for its union (bigU).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

------------------------------------------------------------------------
-- maps of types over a context

module PMap (D : PCtx) (B A : PTy[D]) {
  mE (X : Ob) (w : W0.Ix ((extP D B).ob X)) : W0.Ix ((extP D A).ob X) ;
  mpt (X : Ob) (w : W0.Ix ((extP D B).ob X)) : Id (W0.Ix (D.ob X)) (mE X w).1 w.1 ;
  mnat (Y X : Ob) (h : Hom Y X) (w : W0.Ix ((extP D B).ob X))
    : Id (W0.Ix ((extP D A).ob Y)) (mE Y ((extP D B).act Y X h w)) ((extP D A).act Y X h (mE X w)) ;
} ;

pmap-id (D : PCtx) (B : PTy[D]) : PMap[D, B, B] =
  new PMap[D, B, B, \ X w -> w, \ X w -> refl w.1, \ Y X h w -> refl ((extP D B).act Y X h w)] ;

------------------------------------------------------------------------
-- partial elements

module Partials (D : PCtx) (C : PTy[D]) {
  open GPR.TyL[D, C] ;

  PvTy (X : Ob) (q : Phi X) : U l = (W : Ob) (f : Hom W X) -> Lands W X q f -> EI W ;

  PptTy (X : Ob) (x : Pt X) (q : Phi X) (v : PvTy X q) : U l =
    (W : Ob) (f : Hom W X) (i : Lands W X q f) -> Id (Pt W) (v W f i).1 (D.act W X f x) ;

  PnTy (X : Ob) (q : Phi X) (v : PvTy X q) : U l =
    (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (i : Lands W X q f) (i' : Lands W' X q (compH W' W X f chi))
    -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i') ;

  -- a partial element: one sieve, a section of C over it, lying over x
  module Side (X : Ob) (x : Pt X) {
    pQ : Phi X ;
    pv : PvTy X pQ ;
    ppt : PptTy X x pQ pv ;
    pnat : PnTy X pQ pv ;
  } ;

  -- a side does not depend on the proof that the map lands, nor on the
  -- presentation of the map
  pv-irr (X : Ob) (x : Pt X) (s : Side[X, x]) (W : Ob) (f : Hom W X) (i i' : Lands W X s.pQ f)
    : Id (EI W) (s.pv W f i) (s.pv W f i') = apH (\ k -> s.pv W f k) (isProp-Lands W X s.pQ f i i') ;

  pv-hom (X : Ob) (x : Pt X) (s : Side[X, x]) (W : Ob) (f g : Hom W X) (E : Id (Hom W X) f g)
    (i : Lands W X s.pQ f) (i' : Lands W X s.pQ g) : Id (EI W) (s.pv W f i) (s.pv W g i') =
    idJ (Hom W X) f (\ g2 E2 -> (i2 : Lands W X s.pQ g2) -> Id (EI W) (s.pv W f i) (s.pv W g2 i2))
      (\ i2 -> pv-irr X x s W f i i2) g E i' ;

  ----------------------------------------------------------------------
  -- restriction along h : Y -> X

  module Restr (Y X : Ob) (h : Hom Y X) (x : Pt X) {
    x' : Pt Y = D.act Y X h x ;

    rppt (s : Side[X, x]) : PptTy Y x' (pre Y X h s.pQ) (\ W g i -> s.pv W (compH W Y X h g) (lands-pre W Y X h s.pQ g i)) =
      \ W g i -> transH (s.ppt W (compH W Y X h g) (lands-pre W Y X h s.pQ g i)) (D.act-o W Y X h g x) ;

    rpnat (s : Side[X, x]) : PnTy Y (pre Y X h s.pQ) (\ W g i -> s.pv W (compH W Y X h g) (lands-pre W Y X h s.pQ g i)) =
      \ W' W chi g i i' ->
        transH (s.pnat W' W chi (compH W Y X h g) (lands-pre W Y X h s.pQ g i)
                  (lands-comp W' W X s.pQ (compH W Y X h g) chi (lands-pre W Y X h s.pQ g i)))
               (pv-hom X x s W' (compH W' W X (compH W Y X h g) chi) (compH W' Y X h (compH W' W Y g chi))
                  (comp-assoc W' W Y X h g chi)
                  (lands-comp W' W X s.pQ (compH W Y X h g) chi (lands-pre W Y X h s.pQ g i))
                  (lands-pre W' Y X h s.pQ (compH W' W Y g chi) i')) ;

    opaque rppt ; opaque rpnat ;

    rside (s : Side[X, x]) : Side[Y, x'] =
      new Side[Y, x', pre Y X h s.pQ, \ W g i -> s.pv W (compH W Y X h g) (lands-pre W Y X h s.pQ g i), rppt s, rpnat s] ;
  } ;

  rside (Y X : Ob) (h : Hom Y X) (x : Pt X) (s : Side[X, x]) : Side[Y, D.act Y X h x] = Restr[Y, X, h, x].rside s ;

  ----------------------------------------------------------------------
  -- equality of sides

  isProp-Ppt (X : Ob) (x : Pt X) (q : Phi X) (v : PvTy X q) : isProp (PptTy X x q v) =
    isProp-Pi Ob (\ W -> (f : Hom W X) (i : Lands W X q f) -> Id (Pt W) (v W f i).1 (D.act W X f x)) (\ W ->
    isProp-Pi (Hom W X) (\ f -> (i : Lands W X q f) -> Id (Pt W) (v W f i).1 (D.act W X f x)) (\ f ->
    isProp-Pi (Lands W X q f) (\ i -> Id (Pt W) (v W f i).1 (D.act W X f x)) (\ i ->
      W0.isSetIx (D.ob W) (v W f i).1 (D.act W X f x)))) ;

  isProp-Pn (X : Ob) (q : Phi X) (v : PvTy X q) : isProp (PnTy X q v) =
    isProp-Pi Ob (\ W' -> (W : Ob) (chi : Hom W' W) (f : Hom W X) (i : Lands W X q f) (i' : Lands W' X q (compH W' W X f chi))
                          -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i')) (\ W' ->
    isProp-Pi Ob (\ W -> (chi : Hom W' W) (f : Hom W X) (i : Lands W X q f) (i' : Lands W' X q (compH W' W X f chi))
                         -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i')) (\ W ->
    isProp-Pi (Hom W' W) (\ chi -> (f : Hom W X) (i : Lands W X q f) (i' : Lands W' X q (compH W' W X f chi))
                         -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i')) (\ chi ->
    isProp-Pi (Hom W X) (\ f -> (i : Lands W X q f) (i' : Lands W' X q (compH W' W X f chi))
                         -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i')) (\ f ->
    isProp-Pi (Lands W X q f) (\ i -> (i' : Lands W' X q (compH W' W X f chi))
                         -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i')) (\ i ->
    isProp-Pi (Lands W' X q (compH W' W X f chi)) (\ i' -> Id (EI W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i')) (\ i' ->
      W0.isSetIx (E.ob W') (E.act W' W chi (v W f i)) (v W' (compH W' W X f chi) i'))))))) ;

  PvEq (X : Ob) (q q' : Phi X) (v : PvTy X q) (v' : PvTy X q') : U l =
    (W : Ob) (f : Hom W X) (i : Lands W X q f) (i' : Lands W X q' f) -> Id (EI W) (v W f i) (v' W f i') ;

  side-ext (X : Ob) (x : Pt X) (s s' : Side[X, x]) (eQ : Id (Phi X) s.pQ s'.pQ)
    (ev : PvEq X s.pQ s'.pQ s.pv s'.pv) : Id (Side[X, x]) s s' =
    idJ (Phi X) s.pQ
      (\ q2 P2 -> (v2 : PvTy X q2) (pp2 : PptTy X x q2 v2) (pn2 : PnTy X q2 v2) -> PvEq X s.pQ q2 s.pv v2
         -> Id (Side[X, x]) s (new Side[X, x, q2, v2, pp2, pn2]))
      (\ v2 pp2 pn2 ev2 ->
         idJ (PvTy X s.pQ) s.pv
           (\ v3 P3 -> (pp3 : PptTy X x s.pQ v3) (pn3 : PnTy X s.pQ v3) -> Id (Side[X, x]) s (new Side[X, x, s.pQ, v3, pp3, pn3]))
           (\ pp3 pn3 ->
              trans (Side[X, x]) s (new Side[X, x, s.pQ, s.pv, pp3, s.pnat]) (new Side[X, x, s.pQ, s.pv, pp3, pn3])
                (ap (PptTy X x s.pQ s.pv) (Side[X, x]) (\ z -> new Side[X, x, s.pQ, s.pv, z, s.pnat]) s.ppt pp3
                    (isProp-Ppt X x s.pQ s.pv s.ppt pp3))
                (ap (PnTy X s.pQ s.pv) (Side[X, x]) (\ z -> new Side[X, x, s.pQ, s.pv, pp3, z]) s.pnat pn3
                    (isProp-Pn X s.pQ s.pv s.pnat pn3)))
           v2
           (funext Ob (\ W -> (f : Hom W X) -> Lands W X s.pQ f -> EI W) s.pv v2 (\ W ->
              funext (Hom W X) (\ f -> Lands W X s.pQ f -> EI W) (s.pv W) (v2 W) (\ f ->
                funext (Lands W X s.pQ f) (\ i -> EI W) (s.pv W f) (v2 W f) (\ i -> ev2 W f i i))))
           pp2 pn2)
      s'.pQ eQ s'.pv s'.ppt s'.pnat ev ;

  opaque isProp-Ppt ; opaque isProp-Pn ; opaque side-ext ;

  -- sides at two equal points
  side-extH (X : Ob) (x x' : Pt X) (P : Id (Pt X) x x') (s : Side[X, x]) (s' : Side[X, x'])
    (eQ : Id (Phi X) s.pQ s'.pQ) (ev : PvEq X s.pQ s'.pQ s.pv s'.pv)
    : Id (Side[X, x']) (subst (Pt X) (\ z -> Side[X, z]) x x' P s) s' =
    idJ (Pt X) x
      (\ x2 P2 -> (s2 : Side[X, x2]) -> Id (Phi X) s.pQ s2.pQ -> PvEq X s.pQ s2.pQ s.pv s2.pv
         -> Id (Side[X, x2]) (subst (Pt X) (\ z -> Side[X, z]) x x2 P2 s) s2)
      (\ s2 eQ2 ev2 -> side-ext X x s s2 eQ2 ev2)
      x' P s' eQ ev ;

  opaque side-extH ;

  -- restriction is functorial, up to the point
  rside-o (Z Y X : Ob) (g : Hom Z Y) (h : Hom Y X) (x : Pt X) (s : Side[X, x])
    : Id (Side[Z, D.act Z Y g (D.act Y X h x)])
         (subst (Pt Z) (\ z -> Side[Z, z]) (D.act Z X (compH Z Y X h g) x) (D.act Z Y g (D.act Y X h x)) (D.act-o Z Y X h g x)
                (rside Z X (compH Z Y X h g) x s))
         (rside Z Y g (D.act Y X h x) (rside Y X h x s)) =
    side-extH Z (D.act Z X (compH Z Y X h g) x) (D.act Z Y g (D.act Y X h x)) (D.act-o Z Y X h g x)
      (rside Z X (compH Z Y X h g) x s) (rside Z Y g (D.act Y X h x) (rside Y X h x s))
      (symH (pre-comp Z Y X g h s.pQ))
      (\ W f i i' -> pv-hom X x s W (compH W Z X (compH Z Y X h g) f) (compH W Y X h (compH W Z Y g f))
                       (comp-assoc W Z Y X h g f)
                       (lands-pre W Z X (compH Z Y X h g) s.pQ f i)
                       (lands-pre W Y X h s.pQ (compH W Z Y g f) (lands-pre W Z Y g (pre Y X h s.pQ) f i'))) ;

  rside-id (X : Ob) (x : Pt X) (s : Side[X, x])
    : Id (Side[X, x]) (subst (Pt X) (\ z -> Side[X, z]) (D.act X X (idH X) x) x (D.act-id X x) (rside X X (idH X) x s)) s =
    side-extH X (D.act X X (idH X) x) x (D.act-id X x) (rside X X (idH X) x s) s
      (pre-id X s.pQ)
      (\ W f i i' -> pv-hom X x s W (compH W X X (idH X) f) f (comp-idl W X f) (lands-pre W X X (idH X) s.pQ f i) i') ;

  opaque rside-o ; opaque rside-id ;
} ;

------------------------------------------------------------------------
-- relative contractibility structures

module Rel (D : PCtx) (S T : PTy[D]) (m : PMap[D, S, T]) {
  module TS = GPR.TyL[D, S] ;
  module TT = GPR.TyL[D, T] ;
  module PS' = Partials[D, S] ;

  module RC {
    kop (X : Ob) (x : TS.Pt X) (s : PS'.Side[X, x]) : TT.T X x ;
    -- the extension agrees with m on the side's sieve
    kside (X : Ob) (x : TS.Pt X) (s : PS'.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X s.pQ f)
      : Id (TT.EI W) (TT.E.act W X f (x, kop X x s)) (m.mE W (s.pv W f i)) ;
    -- and is uniform
    kunif (Y X : Ob) (h : Hom Y X) (x : TS.Pt X) (s : PS'.Side[X, x])
      : Id (TT.EI Y) (TT.E.act Y X h (x, kop X x s)) (D.act Y X h x, kop Y (D.act Y X h x) (PS'.rside Y X h x s)) ;
  } ;

  -- the extension at equal points and equal sides
  kop-cong (k : RC) (X : Ob) (x x' : TS.Pt X) (P : Id (TS.Pt X) x x') (s : PS'.Side[X, x]) (s' : PS'.Side[X, x'])
    (R : Id (PS'.Side[X, x']) (subst (TS.Pt X) (\ z -> PS'.Side[X, z]) x x' P s) s')
    : Id (TT.EI X) (x, k.kop X x s) (x', k.kop X x' s') =
    idJ (TS.Pt X) x
      (\ x2 P2 -> (s2 : PS'.Side[X, x2]) -> Id (PS'.Side[X, x2]) (subst (TS.Pt X) (\ z -> PS'.Side[X, z]) x x2 P2 s) s2
         -> Id (TT.EI X) (x, k.kop X x s) (x2, k.kop X x2 s2))
      (\ s2 R2 -> apH {PS'.Side[X, x]} {TT.EI X} (\ z -> (x, k.kop X x z)) R2)
      x' P s' R ;

  -- a structure is determined by its extensions (kside and kunif are
  -- propositions)
  KopTy : U l = (X : Ob) (x : TS.Pt X) (s : PS'.Side[X, x]) -> TT.T X x ;

  KsideTy (kp : KopTy) : U l =
    (X : Ob) (x : TS.Pt X) (s : PS'.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X s.pQ f)
    -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i)) ;

  KunifTy (kp : KopTy) : U l =
    (Y X : Ob) (h : Hom Y X) (x : TS.Pt X) (s : PS'.Side[X, x])
    -> Id (TT.EI Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s)) ;

  isProp-Kside (kp : KopTy) : isProp (KsideTy kp) =
    isProp-Pi Ob (\ X -> (x : TS.Pt X) (s : PS'.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X s.pQ f)
                         -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i))) (\ X ->
    isProp-Pi (TS.Pt X) (\ x -> (s : PS'.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X s.pQ f)
                         -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i))) (\ x ->
    isProp-Pi (PS'.Side[X, x]) (\ s -> (W : Ob) (f : Hom W X) (i : Lands W X s.pQ f)
                         -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i))) (\ s ->
    isProp-Pi Ob (\ W -> (f : Hom W X) (i : Lands W X s.pQ f)
                         -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i))) (\ W ->
    isProp-Pi (Hom W X) (\ f -> (i : Lands W X s.pQ f)
                         -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i))) (\ f ->
    isProp-Pi (Lands W X s.pQ f) (\ i -> Id (TT.EI W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i))) (\ i ->
      W0.isSetIx (TT.E.ob W) (TT.E.act W X f (x, kp X x s)) (m.mE W (s.pv W f i)))))))) ;

  isProp-Kunif (kp : KopTy) : isProp (KunifTy kp) =
    isProp-Pi Ob (\ Y -> (X : Ob) (h : Hom Y X) (x : TS.Pt X) (s : PS'.Side[X, x])
      -> Id (TT.EI Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s))) (\ Y ->
    isProp-Pi Ob (\ X -> (h : Hom Y X) (x : TS.Pt X) (s : PS'.Side[X, x])
      -> Id (TT.EI Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s))) (\ X ->
    isProp-Pi (Hom Y X) (\ h -> (x : TS.Pt X) (s : PS'.Side[X, x])
      -> Id (TT.EI Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s))) (\ h ->
    isProp-Pi (TS.Pt X) (\ x -> (s : PS'.Side[X, x])
      -> Id (TT.EI Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s))) (\ x ->
    isProp-Pi (PS'.Side[X, x]) (\ s
      -> Id (TT.EI Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s))) (\ s ->
      W0.isSetIx (TT.E.ob Y) (TT.E.act Y X h (x, kp X x s)) (D.act Y X h x, kp Y (D.act Y X h x) (PS'.rside Y X h x s))))))) ;

  opaque isProp-Kside ; opaque isProp-Kunif ;

  rc-ext (k k' : RC) (H : (X : Ob) (x : TS.Pt X) (s : PS'.Side[X, x]) -> Id (TT.T X x) (k.kop X x s) (k'.kop X x s))
    : Id RC k k' =
    idJ KopTy k.kop
      (\ kp Q -> (ks : KsideTy kp) (ku : KunifTy kp) -> Id RC k (new RC[kp, ks, ku]))
      (\ ks ku -> transH (apH {KsideTy k.kop} {RC} (\ z -> new RC[k.kop, z, k.kunif]) (isProp-Kside k.kop k.kside ks))
                         (apH {KunifTy k.kop} {RC} (\ z -> new RC[k.kop, ks, z]) (isProp-Kunif k.kop k.kunif ku)))
      k'.kop
      (funext Ob (\ X -> (x : TS.Pt X) (s : PS'.Side[X, x]) -> TT.T X x) k.kop k'.kop (\ X ->
         funext (TS.Pt X) (\ x -> (s : PS'.Side[X, x]) -> TT.T X x) (k.kop X) (k'.kop X) (\ x ->
           funext (PS'.Side[X, x]) (\ s -> TT.T X x) (k.kop X x) (k'.kop X x) (H X x))))
      k'.kside k'.kunif ;

  opaque rc-ext ;

  -- on a side containing the identity, the extension is that side
  kfull (k : RC) (X : Ob) (x : TS.Pt X) (s : PS'.Side[X, x]) (i : Lands X X s.pQ (idH X))
    : Id (TT.EI X) (x, k.kop X x s) (m.mE X (s.pv X (idH X) i)) =
    transH (symH (TT.E.act-id X (x, k.kop X x s))) (k.kside X x s X (idH X) i) ;
} ;

-- contractibility structures: RC at the identity map
ContrOp (D : PCtx) (C : PTy[D]) : U l+ = Rel[D, C, C, pmap-id D C].RC ;

------------------------------------------------------------------------
-- post-composition: a structure for m followed by n : T -> T' is one for
-- any m' equal to n m

module Post (D : PCtx) (S T T' : PTy[D]) (m : PMap[D, S, T]) (n : PMap[D, T, T']) (m' : PMap[D, S, T'])
  (nm : (W : Ob) (v : W0.Ix ((extP D S).ob W)) -> Id (W0.Ix ((extP D T').ob W)) (n.mE W (m.mE W v)) (m'.mE W v))
  (k : Rel[D, S, T, m].RC) {
  module R = Rel[D, S, T, m] ;
  module R' = Rel[D, S, T', m'] ;
  module TT' = GPR.TyL[D, T'] ;

  kop (X : Ob) (x : R.TS.Pt X) (s : R.PS'.Side[X, x]) : TT'.T X x =
    TT'.fromE X x (n.mE X (x, k.kop X x s)) (n.mpt X (x, k.kop X x s)) ;

  kop-E (X : Ob) (x : R.TS.Pt X) (s : R.PS'.Side[X, x]) : Id (TT'.EI X) (x, kop X x s) (n.mE X (x, k.kop X x s)) =
    TT'.fromE-eq X x (n.mE X (x, k.kop X x s)) (n.mpt X (x, k.kop X x s)) ;

  kside (X : Ob) (x : R.TS.Pt X) (s : R.PS'.Side[X, x]) (W : Ob) (f : Hom W X) (i : Lands W X s.pQ f)
    : Id (TT'.EI W) (TT'.E.act W X f (x, kop X x s)) (m'.mE W (s.pv W f i)) =
    transH (apH (TT'.E.act W X f) (kop-E X x s))
     (transH (symH (n.mnat W X f (x, k.kop X x s)))
      (transH (apH (n.mE W) (k.kside X x s W f i)) (nm W (s.pv W f i)))) ;

  kunif (Y X : Ob) (h : Hom Y X) (x : R.TS.Pt X) (s : R.PS'.Side[X, x])
    : Id (TT'.EI Y) (TT'.E.act Y X h (x, kop X x s)) (D.act Y X h x, kop Y (D.act Y X h x) (R.PS'.rside Y X h x s)) =
    transH (apH (TT'.E.act Y X h) (kop-E X x s))
     (transH (symH (n.mnat Y X h (x, k.kop X x s)))
      (transH (apH (n.mE Y) (k.kunif Y X h x s)) (symH (kop-E Y (D.act Y X h x) (R.PS'.rside Y X h x s))))) ;

  opaque kside ; opaque kunif ;

  rc : R'.RC = new R'.RC[kop, kside, kunif] ;
} ;

------------------------------------------------------------------------
-- the join of finitely many sides that agree where they overlap: one side
-- on the union of their sieves

module Join (D : PCtx) (C : PTy[D]) (X : Ob) (x : W0.Ix (D.ob X)) (r : Nat)
  (S : Arith[a].Fin r -> Partials[D, C].Side[X, x])
  (c : (k k' : Arith[a].Fin r) (W : Ob) (f : Hom W X) (i : Lands W X (S k).pQ f) (i' : Lands W X (S k').pQ f)
       -> Id (GPR.TyL[D, C].EI W) ((S k).pv W f i) ((S k').pv W f i')) {
  module P = Partials[D, C] ;
  module TC = GPR.TyL[D, C] ;

  Qs (k : Arith[a].Fin r) : Phi X = (S k).pQ ;
  Q : Phi X = bigU X r Qs ;

  pv (W : Ob) (f : Hom W X) (i : Lands W X Q f) : TC.EI W =
    (S (bigU-out W X r Qs f i).1).pv W f (bigU-out W X r Qs f i).2 ;

  side : P.Side[X, x] =
    new P.Side[X, x, Q, pv,
      \ W f i -> (S (bigU-out W X r Qs f i).1).ppt W f (bigU-out W X r Qs f i).2,
      \ W' W chi f i i' ->
        transH ((S (bigU-out W X r Qs f i).1).pnat W' W chi f (bigU-out W X r Qs f i).2
                  (lands-comp W' W X (Qs (bigU-out W X r Qs f i).1) f chi (bigU-out W X r Qs f i).2))
          (c (bigU-out W X r Qs f i).1 (bigU-out W' X r Qs (compH W' W X f chi) i').1 W' (compH W' W X f chi)
             (lands-comp W' W X (Qs (bigU-out W X r Qs f i).1) f chi (bigU-out W X r Qs f i).2)
             (bigU-out W' X r Qs (compH W' W X f chi) i').2)] ;

  -- on the sieve of a side, the join is that side
  inS (k : Arith[a].Fin r) (W : Ob) (f : Hom W X) (i : Lands W X (S k).pQ f) : Lands W X Q f = bigU-in W X r Qs f k i ;

  pv-in (k : Arith[a].Fin r) (W : Ob) (f : Hom W X) (i : Lands W X (S k).pQ f) (i' : Lands W X Q f)
    : Id (TC.EI W) (side.pv W f i') ((S k).pv W f i) =
    c (bigU-out W X r Qs f i').1 k W f (bigU-out W X r Qs f i').2 i ;
} ;
