-- The restricted ext constructor of SAG section 8.3, on normal forms.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
open CTruncRaw[a, l] ;

module Ops (G : PCtx) (A : PTy[G]) {
  open Build[G, A] ;
  open CTruncGood[a, l].GoodSets[G, A] ;
  open CTruncLaws[a, l].Laws[G, A] ;

  Partial (z : Loc) (Q : PB.Phi z.1) : U l =
    (s : Loc) (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> TrEl s ;
  Natural (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q) : U l =
    (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) (r : Loc) (g : Arr r s)
    (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) ->
    Id (TrEl r) (tr-res r s g (v s h i)) (v r (compose r s z h g) j) ;
  partial-cong (z : Loc) (Q : PB.Phi z.1) (v : Partial z Q)
    (s : Loc) (h k : Arr s z) (p : Id (Arr s z) h k)
    (i : PB.Lands s.1 z.1 Q h.1) (j : PB.Lands s.1 z.1 Q k.1)
    : Id (TrEl s) (v s h i) (v s k j) =
    tr-eq s _ _ (boundary-cong z Q (\ r f n -> (v r f n).1) s h k p i j) ;
  opaque partial-cong ;

  module Extend (z : Loc) (Q : PB.Phi z.1) (u : TrEl z) (v : Partial z Q) (vn : Natural z Q v) {
    us (s : Loc) (h : Arr s z) : Raw = (tr-res s z h u).1 ;
    vs (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) : Raw = (v s h i).1 ;
    tree : Raw = ext z Q us vs ;
    us-nat (s : Loc) (h : Arr s z) (r : Loc) (g : Arr r s) (e : Id Loc (root (us s h)) s)
      : Id Raw (at (us s h) s e r g) (us r (compose r s z h g)) =
      transH (at-irr (us s h) s e (tr-res s z h u).2.2 r g)
        (apH (\ t -> t.1) (tr-res-o r s z h g u)) ;
    vs-nat (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) (r : Loc) (g : Arr r s)
      (j : PB.Lands r.1 z.1 Q (compose r s z h g).1) (e : Id Loc (root (vs s h i)) s)
      : Id Raw (at (vs s h i) s e r g) (vs r (compose r s z h g) j) =
      transH (at-irr (vs s h i) s e (v s h i).2.2 r g)
        (apH (\ t -> t.1) (vn s h i r g j)) ;
    opaque us-nat ; opaque vs-nat ;
    node-good (no : Id Bool (Q.1 z.1 (idH z.1)) false) : Good (node z Q us vs) =
      (no, (\ s h -> (tr-res s z h u).2), (\ s h i -> (v s h i).2), us-nat, vs-nat) ;
    witness : Good tree * Id Loc (root tree) z =
      decide-ind Raw (Q.1 z.1 (idH z.1)) (\ i -> vs z (ident z) i) (\ no -> node z Q us vs)
        (\ t -> Good t * Id Loc (root t) z)
        (\ i -> (v z (ident z) i).2) (\ no -> (node-good no, refl z)) ;
    value : TrEl z = (tree, witness) ;
    full (i : PB.Lands z.1 z.1 Q (idH z.1)) : Id (TrEl z) value (v z (ident z) i) =
      tr-eq z _ _ (ext-full z Q us vs i) ;
    outside (no : Id Bool (Q.1 z.1 (idH z.1)) false) : Id Raw tree (node z Q us vs) =
      decide-no Raw (Q.1 z.1 (idH z.1)) (\ i -> vs z (ident z) i) (\ n -> node z Q us vs) no ;
    opaque full ; opaque outside ;

    module Boundary (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) {
      goal : U l = Id Raw (tr-res s z h value).1 (vs s h i) ;
      total (j : PB.Lands z.1 z.1 Q (idH z.1)) : goal =
        transH (at-cong tree (vs z (ident z) j) (ext-full z Q us vs j) z witness.2 (v z (ident z) j).2.2 s h)
          (transH (apH (\ t -> t.1) (vn z (ident z) j s h k))
            (boundary-cong z Q vs s _ h (compose-idl s z h) k i))
        where { k : PB.Lands s.1 z.1 Q (compose s z z (ident z) h).1 =
          PB.lands-comp s.1 z.1 z.1 Q (idH z.1) h.1 j ; } ;
      proper (no : Id Bool (Q.1 z.1 (idH z.1)) false) : goal =
        transH (at-cong tree (node z Q us vs) (outside no) z witness.2 (refl z) s h)
          (node-boundary z Q us vs s h i) ;
      result : Id (TrEl s) (tr-res s z h value) (v s h i) =
        tr-eq s _ _ (decide goal (Q.1 z.1 (idH z.1)) total proper) ;
    } ;
    boundary (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1)
      : Id (TrEl s) (tr-res s z h value) (v s h i) = Boundary[s, h, i].result ;
    opaque boundary ;
  } ;
} ;
