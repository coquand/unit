-- Taking a horn filler by retraction commutes with cartesian moves,
-- without an injectivity assumption on the base map.
level a k l ;
constraint a <= k ;
constraint k <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ;
open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDSimpId[a] ;
open CDLvl[a, l] ;
module DB = CDeltaBase[a].DB ;
module WD = V[k] ;
module WG = V[l] ;
module PD = DB.GPre[k] ;
module PG = DB.GPre[l] ;

module Along
  (D : PD.PS.PCtx) (A' : PD.PS.PTy[D]) (G : PG.PS.PCtx) (A : PG.PS.PTy[G])
  (s : (W : Nat) -> WD.Ix (D.ob W) -> WG.Ix (G.ob W))
  (sn : (V W : Nat) (g : Hom (lin V) (lin W)) (x : WD.Ix (D.ob W))
     -> Id (WG.Ix (G.ob V)) (s V (D.act V W g x)) (G.act V W g (s W x)))
  (ta : (W : Nat) -> PD.TyL[D, A'].EI W -> PG.TyL[G, A].EI W)
  (tp : (W : Nat) (u : PD.TyL[D, A'].EI W)
     -> Id (WG.Ix (G.ob W)) (PG.TyL[G, A].pr1 W (ta W u)) (s W u.1))
  (tn : (V W : Nat) (g : Hom (lin V) (lin W)) (u : PD.TyL[D, A'].EI W)
     -> Id (PG.TyL[G, A].EI V) (PG.TyL[G, A].E.act V W g (ta W u)) (ta V (PD.TyL[D, A'].E.act V W g u)))
  (ti : (W : Nat) (u v : PD.TyL[D, A'].EI W)
     -> Id (WD.Ix (D.ob W)) u.1 v.1 -> Id (PG.TyL[G, A].EI W) (ta W u) (ta W v)
     -> Id (PD.TyL[D, A'].EI W) u v)
  (bk : (W : Nat) (x : WD.Ix (D.ob W)) -> WG.Ix (A.tob W (s W x)) -> WD.Ix (A'.tob W x))
  (bt : (W : Nat) (x : WD.Ix (D.ob W)) (u : WG.Ix (A.tob W (s W x)))
     -> Id (PG.TyL[G, A].EI W) (ta W (x, bk W x u)) (s W x, u)) {
  module C = DB.CCart[l, k].Cart[D, A', G, A, s, sn, ta, tp, tn, ti, bk, bt] ;
  module TD = C.TA' ;
  module TG = C.TA ;
  open CDeltaCl[a] ;
  import CDBoxRetrNat ;

  module D'= CDHornFib[a, k].DH[D, A'] ;
  module G'= CDHornFib[a, l].DH[G, A] ;
  module R = CDeltaRetr[a, l] ;

  module Fib (c : DB.CLine[l].Lines[G, A].Fib) {
    cD : DB.CLine[k].Lines[D, A'].Fib = C.moveFib c ;
    hnD : D'.isFib = CDeltaRetr[a, k].fibToHorn D A' cD ;
    hnG : G'.isFib = R.fibToHorn G A c ;

    module At (m i : Nat) (x : TD.Pt (suc m)) (y : TG.Pt (suc m)) (p : Id (TG.Pt (suc m)) (s (suc m) x) y)
      (u : D'.HornData m i x) (v : G'.HornData m i y)
      (r : (W : Nat) (f : Hom (lin W) (lin (suc m))) (pD pG : DB.Lands W (suc m) (hornS m i) f)
        -> Id (TG.EI W) (ta W (u.1 W f pD)) (v.1 W f pG)) {
      n : Nat = suc m ;
      sd : D'.PT.Side[n, x] = D'.hornSide m i x u ;
      sg : G'.PT.Side[n, y] = G'.hornSide m i y v ;
    } ;

    module Zero (m : Nat) (x : TD.Pt (suc m)) (y : TG.Pt (suc m)) (p : Id (TG.Pt (suc m)) (s (suc m) x) y)
      (u : D'.HornData m zero x) (v : G'.HornData m zero y)
      (r : (W : Nat) (f : Hom (lin W) (lin (suc m))) (pD pG : DB.Lands W (suc m) (hornS m zero) f)
        -> Id (TG.EI W) (ta W (u.1 W f pD)) (v.1 W f pG)) {
      module H = At[m, zero, x, y, p, u, v, r] ;
      module J = R.DT[m] ;
      module M = CDBoxRetrNat.Compare[e0, e1, c.1, H.n, x, y, p, hornS m zero, H.sd, H.sg,
        refl (hornS m zero), refl (hornS m zero), r,
        \ W -> J.RD.rD (lin W), \ V W -> J.RD.rDn (lin V) (lin W),
        \ W -> J.RD.rD-end e1 (\ j -> refl j) (lin W),
        J.r2, J.r2, J.HH.rD-horn, J.HH.rD-horn] ;

      law (hi : IsT (leb zero (suc m)))
        : Id (TG.EI H.n) (ta H.n (TD.pr H.n x (hnD m zero hi x u).1)) (TG.pr H.n y (hnG m zero hi y v).1) = M.law ;
    } ;

    module Suc (m i : Nat) (hi : IsT (leb (suc i) (suc m))) (x : TD.Pt (suc m)) (y : TG.Pt (suc m))
      (p : Id (TG.Pt (suc m)) (s (suc m) x) y)
      (u : D'.HornData m (suc i) x) (v : G'.HornData m (suc i) y)
      (r : (W : Nat) (f : Hom (lin W) (lin (suc m))) (pD pG : DB.Lands W (suc m) (hornS m (suc i)) f)
        -> Id (TG.EI W) (ta W (u.1 W f pD)) (v.1 W f pG)) {
      module H = At[m, suc i, x, y, p, u, v, r] ;
      module J = R.DF[m, i, hi] ;
      module M = CDBoxRetrNat.Compare[e1, e0, c.2, H.n, x, y, p, hornS m (suc i), H.sd, H.sg,
        refl (hornS m (suc i)), refl (hornS m (suc i)), r,
        \ W -> J.RD.rD (lin W), \ V W -> J.RD.rDn (lin V) (lin W),
        \ W -> J.RD.rD-end e0 (\ j -> refl j) (lin W),
        J.r2, J.r2, J.HH.rD-horn, J.HH.rD-horn] ;

      law : Id (TG.EI H.n) (ta H.n (TD.pr H.n x (hnD m (suc i) hi x u).1)) (TG.pr H.n y (hnG m (suc i) hi y v).1) = M.law ;
    } ;

    law (m : Nat) : (i : Nat) (hi : IsT (leb i (suc m))) (x : TD.Pt (suc m)) (y : TG.Pt (suc m))
      (p : Id (TG.Pt (suc m)) (s (suc m) x) y)
      (u : D'.HornData m i x) (v : G'.HornData m i y)
      (r : (W : Nat) (f : Hom (lin W) (lin (suc m))) (pD pG : DB.Lands W (suc m) (hornS m i) f)
        -> Id (TG.EI W) (ta W (u.1 W f pD)) (v.1 W f pG))
      -> Id (TG.EI (suc m)) (ta (suc m) (TD.pr (suc m) x (hnD m i hi x u).1))
                            (TG.pr (suc m) y (hnG m i hi y v).1) = split {
      zero -> \ hi x y p u v r -> Zero[m, x, y, p, u, v, r].law hi ;
      suc i -> \ hi x y p u v r -> Suc[m, i, hi, x, y, p, u, v, r].law } ;
  } ;
} ;
