-- The underlying presheaf has a natural path between every pair, and a
-- natural recursor into seeded extension algebras with inc/ext equations.
-- Dependent elimination is in CTruncElimProp (fibrant proposition
-- families); composition on truncation and substitution stability remain
-- unproved.  See CTrunc for the scope of the construction.
level a l ; constraint a <= l ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module Theorem (G : PCtx) (A : PTy[G]) {
  module T = CTrunc[a, l].Truncation[G,A] ;
  module KA = CTruncAlg[a, l].Algebras[G,T.Ty] ;
  ka : KA.Algebra = new KA.Algebra[T.algebra.extend,T.algebra.boundary,T.algebra.uniform] ;
  module P = CTruncIsProp[a, l].IsProp[G,T.Ty,ka] ;
  truncation : PTy[G] = T.Ty ;
  proposition : PEl[P.Pth.GA,P.Pth.PT.PathP] = P.proposition ;
} ;
