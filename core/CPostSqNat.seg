-- CPostSqNat.seg: extensionality of the square fillers.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module S1m = CPostStep1[a, l] ;

module SQ = CPostSq[a, l] ;
module SqZCmp (G : PP.PCtx) (B : PP.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : CDeltaBase[a].DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].resP N' (suc N') (dl N' y) b)))
  (xf : W0.Ix (G.ob (lin zero)))
  (psi : PB.GPre[l].TyL[G, B].EI (lin zero)) (psi-pt : Id (W0.Ix (G.ob (lin zero))) psi.1 xf)
  (L : (W : Nat) -> Hom (lin W) (lin zero) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp : (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L W g j).1 (G.act (lin W) (lin zero) g xf))
  (Ln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L W g j))
              (L V (compH (lin V) (lin W) (lin zero) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl : (W : Nat) -> Hom (lin W) (prodP (lin zero) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl W g).1
               (G.act (lin W) (prodP (lin zero) Iv) g (G.act (prodP (lin zero) Iv) (lin zero) (pr1 (lin zero) Iv) xf)))
  (Pln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin zero) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl W g))
               (Pl V (compH (lin V) (lin W) (prodP (lin zero) Iv) g h)))
  (L0 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin zero) g psi))
  (L1 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e1)) (Pl W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e))))
  (xf2 : W0.Ix (G.ob (lin zero)))
  (psi2 : PB.GPre[l].TyL[G, B].EI (lin zero)) (psi-pt2 : Id (W0.Ix (G.ob (lin zero))) psi2.1 xf2)
  (L2 : (W : Nat) -> Hom (lin W) (lin zero) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp2 : (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L2 W g j).1 (G.act (lin W) (lin zero) g xf2))
  (Ln2 : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L2 W g j))
              (L2 V (compH (lin V) (lin W) (lin zero) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl2 : (W : Nat) -> Hom (lin W) (prodP (lin zero) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp2 : (W : Nat) (g : Hom (lin W) (prodP (lin zero) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl2 W g).1
               (G.act (lin W) (prodP (lin zero) Iv) g (G.act (prodP (lin zero) Iv) (lin zero) (pr1 (lin zero) Iv) xf2)))
  (Pln2 : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin zero) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl2 W g))
               (Pl2 V (compH (lin V) (lin W) (prodP (lin zero) Iv) g h)))
  (L02 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L2 W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin zero) g psi2))
  (L12 : (W : Nat) (g : Hom (lin W) (lin zero))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L2 W g (constH (lin W) Iv e1)) (Pl2 W (pairH (lin zero) Iv (lin W) g (constH (lin W) Iv e))))
  (xe : Id (W0.Ix (G.ob (lin (zero)))) xf xf2)
  (psie : Id (PB.GPre[l].TyL[G, B].EI (lin (zero))) psi psi2)
  (le : (W : Nat) (g : Hom (lin W) (lin (zero))) (j : Hom (lin W) Iv)
    -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g j) (L2 W g j))
  (ple : (W : Nat) (g : Hom (lin W) (prodP (lin (zero)) Iv))
    -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Pl W g) (Pl2 W g)) {
  module S1 = SQ.SqZ[G, B, e, fill, sides, face, xf, psi, psi-pt, L, Lp, Ln, Pl, Plp, Pln, L0, L1] ;
  module S2 = SQ.SqZ[G, B, e, fill, sides, face, xf2, psi2, psi-pt2, L2, Lp2, Ln2, Pl2, Plp2, Pln2, L02, L12] ;
  module E1 = S1.E ; module E2 = S2.E ;
  module TB = PB.GPre[l].TyL[G, B] ;
  module B1 = S1.Bx ; module B2 = S2.Bx ;
  endC (W : Nat) (g : Hom (lin W) E1.BX.XB) (j : Hom (lin W) Iv)
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (E1.p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (E1.p2g W g)))
      -> Id (TB.EI (lin W)) (E1.EvC W g j cc) (E2.EvC W g j cc) = split {
    inl i -> apH (TB.E.act (lin W) (lin (zero)) (E1.p1g W g)) psie ;
    inr i -> ple W (pairH (lin (zero)) Iv (lin W) (E1.p1g W g) j) } ;
  endEq (W : Nat) (g : Hom (lin W) E1.BX.XB) (b b2 : SP.Lands (lin W) E1.BX.XB E1.ES.endS g) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (E1.Ev W g b j) (E2.Ev W g b2 j) =
    transH (endC W g j (E1.cut W g b)) (apH (\ i -> E2.Ev W g i j) (SP.isProp-Lands (lin W) E1.BX.XB E1.ES.endS g b b2)) ;
  module C = CBoxFill[a, l].Compare[B1.G, B1.A, B1.e, B1.fill, B1.sides, B1.face, B1.X, B1.ht, B1.B, B1.hB, B1.hm, B1.hi, B1.x, B1.a0, B1.a0p, B1.a0n, B1.Q, B1.sv, B1.svp, B1.svn, B1.sve,
    B2.x, B2.a0, B2.a0p, B2.a0n, B2.sv, B2.svp, B2.svn, B2.sve,
    apH (G.act E1.BX.XB (lin (zero)) E1.BX.p1B) xe,
    \ W g -> le W (E1.p1g W g) (E1.p2g W g), endEq] ;
  eq (W : Nat) (g : Hom (lin W) E1.BX.XB) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (S1.Thf W g j) (S2.Thf W g j) = C.fv W g j ;
  opaque eq ;
} ;
module SqSCmp (G : PP.PCtx) (B : PP.PTy[G]) (e : El Iv)
  (fill : (N : Nat) -> CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].FillTy N)
  (sides : (N : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob N)
           (W : Nat) (f : Hom (lin W) (lin N)) (i : CDeltaBase[a].DS.Lands W N b.2.pQ f)
           -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI W)
                 (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act W N f
                    (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N (fill N) b))
                 (b.2.pv W f i))
  (face : (N' : Nat) (b : CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].Prob (suc N'))
          (y : Nat) (hy : IsT (leb y (suc N')))
          -> Id (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.EI N')
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].KA.TS.E.act N' (suc N') (dl N' y)
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE (suc N') (fill (suc N')) b))
                (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].fillE N' (fill N')
                   (CDStageA[a, l].SA[CLocRestr[a, l].R[G].iG, CLocRestr[a, l].R[G].T[B].iA, e].resP N' (suc N') (dl N' y) b)))
  (m' : Nat) (xf : W0.Ix (G.ob (lin (suc m'))))
  (psi : PB.GPre[l].TyL[G, B].EI (lin (suc m'))) (psi-pt : Id (W0.Ix (G.ob (lin (suc m')))) psi.1 xf)
  (L : (W : Nat) -> Hom (lin W) (lin (suc m')) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp : (W : Nat) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L W g j).1 (G.act (lin W) (lin (suc m')) g xf))
  (Ln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L W g j))
              (L V (compH (lin V) (lin W) (lin (suc m')) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl : (W : Nat) -> Hom (lin W) (prodP (lin (suc m')) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl W g).1
               (G.act (lin W) (prodP (lin (suc m')) Iv) g (G.act (prodP (lin (suc m')) Iv) (lin (suc m')) (pr1 (lin (suc m')) Iv) xf)))
  (Pln : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl W g))
               (Pl V (compH (lin V) (lin W) (prodP (lin (suc m')) Iv) g h)))
  (L0 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin (suc m')) g psi))
  (L1 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g (constH (lin W) Iv e1)) (Pl W (pairH (lin (suc m')) Iv (lin W) g (constH (lin W) Iv e))))
  (Th : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Iv) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Thp : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Th y hy W g j).1
               (G.act (lin W) (prodP (lin m') Iv) g
                  (G.act (prodP (lin m') Iv) (prodP (lin (suc m')) Iv) (BD.BG[m', Iv].dY y)
                     (G.act (prodP (lin (suc m')) Iv) (lin (suc m')) (pr1 (lin (suc m')) Iv) xf))))
  (Thn : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Th y hy W g j))
               (Th y hy V (compH (lin V) (lin W) (prodP (lin m') Iv) g h) (compH (lin V) (lin W) Iv j h)))
  (Th-e : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv))
          -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W g (constH (lin W) Iv e))
                (L W (compH (lin W) (lin m') (lin (suc m')) (dl m' y) (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g))
                     (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)))
  (Th-t0 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                 (PB.GPre[l].TyL[G, B].E.act (lin W) (lin (suc m')) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) psi))
  (Th-t1 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                 (Pl W (pairH (lin (suc m')) Iv (lin W) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) j)))
  (FFt : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
         (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         (msy : Miss (lin W) m' y (BD.BG[m', Iv].p1g W g)) (msz : Miss (lin W) m' z (BD.BG[m', Iv].p1g W g)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W (BD.BG[m', Iv].gy y W g) j) (Th z hz W (BD.BG[m', Iv].gy z W g) j))
  (xf2 : W0.Ix (G.ob (lin (suc m'))))
  (psi2 : PB.GPre[l].TyL[G, B].EI (lin (suc m'))) (psi-pt2 : Id (W0.Ix (G.ob (lin (suc m')))) psi2.1 xf2)
  (L2 : (W : Nat) -> Hom (lin W) (lin (suc m')) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Lp2 : (W : Nat) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (L2 W g j).1 (G.act (lin W) (lin (suc m')) g xf2))
  (Ln2 : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
        -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (L2 W g j))
              (L2 V (compH (lin V) (lin W) (lin (suc m')) g h) (compH (lin V) (lin W) Iv j h)))
  (Pl2 : (W : Nat) -> Hom (lin W) (prodP (lin (suc m')) Iv) -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Plp2 : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         -> Id (W0.Ix (G.ob (lin W))) (Pl2 W g).1
               (G.act (lin W) (prodP (lin (suc m')) Iv) g (G.act (prodP (lin (suc m')) Iv) (lin (suc m')) (pr1 (lin (suc m')) Iv) xf2)))
  (Pln2 : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Pl2 W g))
               (Pl2 V (compH (lin V) (lin W) (prodP (lin (suc m')) Iv) g h)))
  (L02 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L2 W g (constH (lin W) Iv e0)) (PB.GPre[l].TyL[G, B].E.act (lin W) (lin (suc m')) g psi2))
  (L12 : (W : Nat) (g : Hom (lin W) (lin (suc m')))
        -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L2 W g (constH (lin W) Iv e1)) (Pl2 W (pairH (lin (suc m')) Iv (lin W) g (constH (lin W) Iv e))))
  (Th2 : (y : Nat) -> IsT (leb y (suc m')) -> (W : Nat) -> Hom (lin W) (prodP (lin m') Iv) -> Hom (lin W) Iv -> PB.GPre[l].TyL[G, B].EI (lin W))
  (Thp2 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Th2 y hy W g j).1
               (G.act (lin W) (prodP (lin m') Iv) g
                  (G.act (prodP (lin m') Iv) (prodP (lin (suc m')) Iv) (BD.BG[m', Iv].dY y)
                     (G.act (prodP (lin (suc m')) Iv) (lin (suc m')) (pr1 (lin (suc m')) Iv) xf2))))
  (Thn2 : (y : Nat) (hy : IsT (leb y (suc m'))) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin V)) (PB.GPre[l].TyL[G, B].E.act (lin V) (lin W) h (Th2 y hy W g j))
               (Th2 y hy V (compH (lin V) (lin W) (prodP (lin m') Iv) g h) (compH (lin V) (lin W) Iv j h)))
  (Th-e2 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv))
          -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th2 y hy W g (constH (lin W) Iv e))
                (L2 W (compH (lin W) (lin m') (lin (suc m')) (dl m' y) (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g))
                     (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)))
  (Th-t02 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th2 y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                 (PB.GPre[l].TyL[G, B].E.act (lin W) (lin (suc m')) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) psi2))
  (Th-t12 : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
           -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th2 y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e1)) j)
                 (Pl2 W (pairH (lin (suc m')) Iv (lin W) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) j)))
  (FFt2 : (y z : Nat) (hy : IsT (leb y (suc m'))) (hz : IsT (leb z (suc m'))) (lt : IsT (ltb y z))
         (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
         (msy : Miss (lin W) m' y (BD.BG[m', Iv].p1g W g)) (msz : Miss (lin W) m' z (BD.BG[m', Iv].p1g W g)) (j : Hom (lin W) Iv)
         -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th2 y hy W (BD.BG[m', Iv].gy y W g) j) (Th2 z hz W (BD.BG[m', Iv].gy z W g) j))
  (xe : Id (W0.Ix (G.ob (lin (suc m')))) xf xf2)
  (psie : Id (PB.GPre[l].TyL[G, B].EI (lin (suc m'))) psi psi2)
  (le : (W : Nat) (g : Hom (lin W) (lin (suc m'))) (j : Hom (lin W) Iv)
    -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (L W g j) (L2 W g j))
  (ple : (W : Nat) (g : Hom (lin W) (prodP (lin (suc m')) Iv))
    -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Pl W g) (Pl2 W g))
  (the : (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv)) (j : Hom (lin W) Iv)
    -> Id (PB.GPre[l].TyL[G, B].EI (lin W)) (Th y hy W g j) (Th2 y hy W g j)) {
  module S1 = SQ.SqS[G, B, e, fill, sides, face, m', xf, psi, psi-pt, L, Lp, Ln, Pl, Plp, Pln, L0, L1, Th, Thp, Thn, Th-e, Th-t0, Th-t1, FFt] ;
  module S2 = SQ.SqS[G, B, e, fill, sides, face, m', xf2, psi2, psi-pt2, L2, Lp2, Ln2, Pl2, Plp2, Pln2, L02, L12, Th2, Thp2, Thn2, Th-e2, Th-t02, Th-t12, FFt2] ;
  module E1 = S1.E ; module E2 = S2.E ;
  module TB = PB.GPre[l].TyL[G, B] ;
  module B1 = S1.Bx ; module B2 = S2.Bx ;
  endC (W : Nat) (g : Hom (lin W) E1.BX.XB) (j : Hom (lin W) Iv)
    : (cc : Plus (SP.Lands (lin W) Iv (PBs.sptS e0) (E1.p2g W g)) (SP.Lands (lin W) Iv (PBs.sptS e1) (E1.p2g W g)))
      -> Id (TB.EI (lin W)) (E1.EvC W g j cc) (E2.EvC W g j cc) = split {
    inl i -> apH (TB.E.act (lin W) (lin (suc m')) (E1.p1g W g)) psie ;
    inr i -> ple W (pairH (lin (suc m')) Iv (lin W) (E1.p1g W g) j) } ;
  endEq (W : Nat) (g : Hom (lin W) E1.BX.XB) (b b2 : SP.Lands (lin W) E1.BX.XB E1.ES.endS g) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (E1.Ev W g b j) (E2.Ev W g b2 j) =
    transH (endC W g j (E1.cut W g b)) (apH (\ i -> E2.Ev W g i j) (SP.isProp-Lands (lin W) E1.BX.XB E1.ES.endS g b b2)) ;
  module SE = CPostExt[a, l].SideEq[G, B, m', Iv, SQ.QYsq, S1.BSm.sv, S2.BSm.sv,
    \ y hy W g i i2 ms j -> transH (S1.BSm.sv-F y hy W g i ms j)
      (transH (the y hy W (S1.BG.gy y W g) j) (symH (S2.BSm.sv-F y hy W g i2 ms j))),
    \ W g i i2 b j -> transH (S1.BSm.sv-E W g i b j)
      (transH (endEq W g b b j) (symH (S2.BSm.sv-E W g i2 b j)))] ;
  module C = CBoxFill[a, l].Compare[B1.G, B1.A, B1.e, B1.fill, B1.sides, B1.face, B1.X, B1.ht, B1.B, B1.hB, B1.hm, B1.hi, B1.x, B1.a0, B1.a0p, B1.a0n, B1.Q, B1.sv, B1.svp, B1.svn, B1.sve,
    B2.x, B2.a0, B2.a0p, B2.a0n, B2.sv, B2.svp, B2.svn, B2.sve,
    apH (G.act E1.BX.XB (lin (suc m')) E1.BX.p1B) xe,
    \ W g -> le W (E1.p1g W g) (E1.p2g W g), SE.eq] ;
  eq (W : Nat) (g : Hom (lin W) E1.BX.XB) (j : Hom (lin W) Iv)
    : Id (TB.EI (lin W)) (S1.Thf W g j) (S2.Thf W g j) = C.fv W g j ;
  opaque eq ;
} ;
