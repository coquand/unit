-- Restricting the name is the same as naming the moved structure.
module Natural (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Fib G A) {
  A' : PTy[D] = subTy D G A s ;
  module F = DB.CFibSub[a+].FibSub[D, G, s, A] ;
  module H = CDBoxNat[a, a+, a+].Along[D, A', G, A, s.nt, s.nt-nat, F.SE.mV, \ W w -> refl (s.nt W w.1),
    F.SE.mV-nat, F.SE.mV-inj, \ W x b -> b, \ W x b -> refl (s.nt W x, b)].Fib[c] ;
  c' : Fib D A' = F.sub c ;
  h : Op G A = horn G A c ;
  h' : Op D A' = horn D A' c' ;
  s1 : Q.PS.PSub[high D, high G] = highSub D G s ;
  module HF = B.Cl.P[high D, high G, s1, highTy G A, h] ;
  module HG = B.DB.CPartial[a+].Partials[D, A'] ;
  module DOp = B.High.COp[a+].OpS[B.DC.HIx, \ i -> B.DC.hOk i, B.DC.hOb, B.DC.hS, high D, highTy D A'] ;

  classifiers : Id (Op D A') h' HF.Pl.op =
    DOp.op-ext h' HF.Pl.op (\ i o x v ->
      F.SE.TC.pr-inj (B.DC.hOb i) (s.nt (B.DC.hOb i) x) _ _
        (H.law i.1 i.2 o x (s.nt (B.DC.hOb i) x) (refl (s.nt (B.DC.hOb i) x)) v (HF.Pl.mv i x v)
          (\ W f p q -> apH (F.SE.mV W)
            (apH (v.1 W f) (DB.isProp-Lands W (B.DC.hOb i) (B.DC.hS i) f p q))))) ;

  opaque classifiers ;

  module At (X : Nat) (x : W.Ix (D.ob X)) {
    module Left = Naming[D, A', h'] ;
    module Right = Naming[G, A, h] ;
    t : Left.Local X = Left.loc X x ;
    composed : Right.Local X = Q.PS.oS (Y.yP X) (high D) (high G) s1 t ;

    compared : Id (Right.Local X) composed (Right.loc X (s.nt X x)) =
      Q.PS.sub-ext (Y.yP X) (high G) composed (Right.loc X (s.nt X x)) (\ W f -> s.nt-nat W X f x) ;

    law : Id (U1.U0 X) (Left.code X t) (Right.code X (Right.loc X (s.nt X x))) =
      transH (apH (\ op -> Naming[D, A', op].code X t) classifiers)
        (transH (symH (B.Cl.clSub-o (Y.yP X) (high D) (high G) s1 t (highTy G A) h))
          (apH (Right.code X) compared)) ;
  } ;

  law : Id (C.C.Ty D) (C.C.subT D G (name G A c) s) (name D A' c') =
    C.C.ty-ext D _ _ (\ X x -> symH At[X, x].law) ;

  opaque law ;
} ;
