-- CIdCart.seg (L3, inside CB, level l): the cartesian map
-- Id(a[r] , b[r]) -> Id(a , b) over r : D -> G (model.tex Prop "Id is
-- fibrant", naturality).  On the path it is CPathCart's fibre map; the
-- sieve is unchanged.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module IdCart (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a b : PEl[G, A]) {
  module PC = CPathCart[l].PathCart[D, G, r, A, a, b] ;
  module PF = PC.PF ;
  module PF' = PC.PF' ;
  module IO = CId[l].IdOver[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act] ;
  module IO' = CId[l].IdOver[D, D, PC.A', PF'.s, PF'.sN, PF'.PE.aE, PF'.PE.bE, PF'.PE.aE-act, PF'.PE.bE-act] ;
  module TI = IO.TI ;
  module TI' = IO'.TI ;
  module SEA = PC.SEA ;

  IdT : PTy[G] = IO.IdT ;
  IdT' : PTy[D] = IO'.IdT ;

  tauI (X : Ob) (x : W0.Ix (D.ob X)) (w : W0.Ix (IO'.tobI X x)) : W0.Ix (IO.tobI X (r.nt X x)) =
    (PC.tau X x w.1,
     (w.2.1, \ W f i j -> transH (apH (SEA.mV W) (w.2.2 W f i j)) (apH (PF.PE.aE W) (r.nt-nat W X f x)))) ;

  taI (W : Ob) (v : TI'.EI W) : TI.EI W = (r.nt W v.1, tauI W v.1 v.2) ;

  tanatI (V W : Ob) (g : Hom V W) (v : TI'.EI W) : Id (TI.EI V) (TI.E.act V W g (taI W v)) (taI V (TI'.E.act V W g v)) =
    IO.tpI-ext V (TI.E.act V W g (taI W v)) (taI V (TI'.E.act V W g v)) (symH (r.nt-nat V W g v.1))
      (\ V' g' j -> refl (SEA.mV V' (v.2.1.1.1 V' (compH V' V W g g') j)))
      (refl (pre V W g v.2.2.1)) ;

  tainjI (W : Ob) (v v' : TI'.EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (TI.EI W) (taI W v) (taI W v')) : Id (TI'.EI W) v v' =
    IO'.tpI-ext W v v' P
      (\ V g j -> SEA.mV-inj V (v.2.1.1.1 V g j) (v'.2.1.1.1 V g j)
         (transH (v.2.1.2.1 V g j) (transH (apH (D.act V W g) P) (symH (v'.2.1.2.1 V g j))))
         (apH (\ z -> z.2.1.1.1 V g j) Q))
      (apH (\ z -> z.2.2.1) Q) ;

  bkI (X : Ob) (x : W0.Ix (D.ob X)) (w : W0.Ix (IO.tobI X (r.nt X x))) : W0.Ix (IO'.tobI X x) =
    (PC.bk X x w.1,
     (w.2.1, \ W f i j -> SEA.mV-inj W (PC.Bk[X, x, w.1].bv W f j) (PF'.PE.aE W (D.act W X f x)) (refl (D.act W X f x))
                            (transH (PC.Bk[X, x, w.1].bvE W f j)
                              (transH (w.2.2 W f i j) (apH (PF.PE.aE W) (symH (r.nt-nat W X f x))))))) ;

  bktaI (X : Ob) (x : W0.Ix (D.ob X)) (w : W0.Ix (IO.tobI X (r.nt X x))) : Id (TI.EI X) (taI X (x, bkI X x w)) (r.nt X x, w) =
    IO.tpI-ext X (taI X (x, bkI X x w)) (r.nt X x, w) (refl (r.nt X x)) (\ V g j -> PC.Bk[X, x, w.1].bvE V g j) (refl w.2.1) ;

  opaque tainjI ; opaque bktaI ;

  module C = CCart[l, l].Cart[D, IdT', G, IdT, r.nt, r.nt-nat, taI, \ W v -> refl (r.nt W v.1), tanatI, tainjI, bkI, bktaI] ;
} ;
