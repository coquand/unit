-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CPostInv.seg (L9): the second inverse homotopy psi phi ~ id
-- (POSTNIKOV-INFORMAL.md, "The second inverse homotopy").
--
-- For u in DA at (X , x), run the recursion of CPostRec on phi(u)
-- (CPostInvIn).  At f : [m] -> X the data are a record GRec m f:
--
--   Cy            the prism G_f : [m] * [1]_t -> i*A, from psi(f) to U_f
--   Xi k          the square Xi^N_f, N = k + m + 1, over [m] * [1]_t with
--                 the line v: Xi(t , 0) = H^N, Xi(t , 1) = G, Xi(0 , v) =
--                 psi, Xi(1 , v) = R(v)
--   Cu k          the cube from Xi^N to Xi^(N+1) over [m] * [1]_t * [1]_v,
--                 line s: s = 1 is Xi^N, s = 0 is Xi^(N+1); t = 0 psi,
--                 t = 1 Q(s , v), v = 0 Theta_N(t , s), v = 1 G(t)
--
-- The stages are indexed from m + 1 (St m k = k + m + 1), so the recursion
-- over k has no stages below m + 1.  SR runs it from the initial square
-- (base) and the cubes (next); FFY: two faces agree, from the face
-- relation one dimension lower (any Y).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module LM = CPostLimit[a, l] ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module RD = CPostRead[a, l] ;
module IV = CPostInvIn[a, l] ;
module CB = CPostCube[a, l] ;
module BX = CPostBox[a, l] ;
module SQ = CPostSq[a, l] ;

-- the coordinates of [m] * [1], and the families, at the top level (they
-- depend on m only: an instance of Inv would carry its whole input)
p1gI (m W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) : Hom (lin W) (lin m) = compH (lin W) (prodP (lin m) Iv) (lin m) (pr1 (lin m) Iv) g ;
p2gI (m W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) : Hom (lin W) Iv = compH (lin W) (prodP (lin m) Iv) Iv (pr2 (lin m) Iv) g ;

module FamI (G : PCtx) (A : PTy[G]) {
  module TA = PR.TyL[G, A] ;
  HFam (m : Nat) : U l = (W : Nat) -> Hom (lin W) (lin m) -> Hom (lin W) Iv -> TA.EI (lin W) ;
  TFam (m : Nat) : U l = (W : Nat) -> Hom (lin W) (prodP (lin m) Iv) -> Hom (lin W) Iv -> TA.EI (lin W) ;
  YFam (m : Nat) (Y : Ob) : U l = (W : Nat) -> Hom (lin W) (prodP (lin m) Y) -> Hom (lin W) Iv -> TA.EI (lin W) ;
  CFam (m : Nat) : U l = YFam m CB.IvIv ;
} ;

module Inv (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) (X : Ob) (x : W0.Ix (G.ob X))
  (u : LM.Post[G, A].DA.DEl X x) {
  module IN = IV.In[G, A, c, X, x, u] ;
  module Lr = IN.Lr ;
  module UR = IN.UR ;
  module TA = PR.TyL[G, A] ;
  module GL = PR.PshL[G] ;
  module RG = CLocRestr[a, l].R[G] ;
  module FT = CDFill[a, l].FT[RG.iG, RG.T[A].iA, CLocHorn[a, l].HornOfFib[G, A, c].horn] ;
  module FF = CDFill[a, l].FF[RG.iG, RG.T[A].iA, CLocHorn[a, l].HornOfFib[G, A, c].horn] ;

  Rf (m : Nat) (f : Hom (lin m) X) : Lr.Rec[m, f] = (Lr.Drec m).R f ;
  xf (m : Nat) (f : Hom (lin m) X) : W0.Ix (G.ob (lin m)) = G.act (lin m) X f x ;

  -- the stages
  St (m k : Nat) : Nat = plus k (suc m) ;
  hSt (m : Nat) : (k : Nat) -> IsT (leb (suc m) (St m k)) = split {
    zero -> leb-refl (suc m) ;
    suc k | ih -> leb-trans (suc m) (St m k) (suc (St m k)) ih (leb-suc (St m k)) } ;
  stE (m k : Nat) : Id Nat (St (suc m) k) (St m (suc k)) = plus-suc k (suc m) ;

  -- families over [m] * Y with a line
  module FI = FamI[G, A] ;
  xX (m : Nat) (f : Hom (lin m) X) : W0.Ix (G.ob (prodP (lin m) CB.IvIv)) = G.act (prodP (lin m) CB.IvIv) (lin m) (pr1 (lin m) CB.IvIv) (xf m f) ;

  ----------------------------------------------------------------------
  -- the data at f

  record GRec (m : Nat) (f : Hom (lin m) X) {
    Cy : FI.HFam m ;
    Cyp : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Cy W g j).1 (G.act (lin W) (lin m) g (xf m f)) ;
    Cyn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
          -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Cy W g j)) (Cy V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)) ;
    Cy0 : (W : Nat) (g : Hom (lin W) (lin m)) -> Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e0)) (TA.E.act (lin W) (lin m) g (Rf m f).psi) ;
    Cy1 : (W : Nat) (g : Hom (lin W) (lin m)) -> Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e1)) (TA.E.act (lin W) (lin m) g (UR.Uf m f)) ;
    Xi : Nat -> FI.TFam m ;
    Xp : (k W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Xi k W g j).1 (G.act (lin W) (prodP (lin m) Iv) g (Lr.xB m f)) ;
    Xn : (k V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
         -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Xi k W g j))
               (Xi k V (compH (lin V) (lin W) (prodP (lin m) Iv) g h) (compH (lin V) (lin W) Iv j h)) ;
    Xv0 : (k W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
          -> Id (TA.EI (lin W)) (Xi k W g (constH (lin W) Iv e0)) ((Rf m f).Hs (St m k) W (p1gI m W g) (p2gI m W g)) ;
    Xv1 : (k W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
          -> Id (TA.EI (lin W)) (Xi k W g (constH (lin W) Iv e1)) (Cy W (p1gI m W g) (p2gI m W g)) ;
    Xt0 : (k W : Nat) (a1 : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
          -> Id (TA.EI (lin W)) (Xi k W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin m) a1 (Rf m f).psi) ;
    Xt1 : (k W : Nat) (a1 : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
          -> Id (TA.EI (lin W)) (Xi k W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e1)) j) (UR.Sq[m, f].R.D.val W (pairH (lin m) Iv (lin W) a1 j)) ;
    Cu : Nat -> FI.CFam m ;
    Cp : (k W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Cu k W g j).1 (G.act (lin W) (CB.Geo[m].X) g (xX m f)) ;
    Cn : (k V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv)
         -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Cu k W g j))
               (Cu k V (compH (lin V) (lin W) (CB.Geo[m].X) g h) (compH (lin V) (lin W) Iv j h)) ;
    Cs1 : (k W : Nat) (g : Hom (lin W) (CB.Geo[m].X))
          -> Id (TA.EI (lin W)) (Cu k W g (constH (lin W) Iv e1))
                (Xi k W (pairH (lin m) Iv (lin W) (CB.Geo[m].p1g W g) (CB.Geo[m].pt W g)) (CB.Geo[m].pv W g)) ;
    Cs0 : (k W : Nat) (a1 : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv)
          -> Id (TA.EI (lin W)) (Cu k W (CB.Geo[m].pt3 W a1 t v) (constH (lin W) Iv e0)) (Xi (suc k) W (pairH (lin m) Iv (lin W) a1 t) v) ;
    CT0 : (k W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e0 (CB.Geo[m].pt W g))
          -> Id (TA.EI (lin W)) (Cu k W g j) (TA.E.act (lin W) (lin m) (CB.Geo[m].p1g W g) (Rf m f).psi) ;
    CT1 : (k W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e1 (CB.Geo[m].pt W g))
          -> Id (TA.EI (lin W)) (Cu k W g j) (UR.Sq[m, f].Q W (CB.Geo[m].p1g W g) j (CB.Geo[m].pv W g)) ;
    CV0 : (k W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e0 (CB.Geo[m].pv W g))
          -> Id (TA.EI (lin W)) (Cu k W g j)
                ((Rf m f).Ts (St m k) W (pairH (lin m) Iv (lin W) (CB.Geo[m].p1g W g) (CB.Geo[m].pt W g)) j) ;
    CV1 : (k W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e1 (CB.Geo[m].pv W g))
          -> Id (TA.EI (lin W)) (Cu k W g j) (Cy W (CB.Geo[m].p1g W g) (CB.Geo[m].pt W g)) ;
  } ;

  ----------------------------------------------------------------------
  -- the recursion over the stages at f

  record XSt (m : Nat) (f : Hom (lin m) X) (Cy : FI.HFam m) (ExP : Nat -> FI.TFam m -> U l) (k : Nat) {
    Xi : FI.TFam m ;
    Xp : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Xi W g j).1 (G.act (lin W) (prodP (lin m) Iv) g (Lr.xB m f)) ;
    Xn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
         -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Xi W g j))
               (Xi V (compH (lin V) (lin W) (prodP (lin m) Iv) g h) (compH (lin V) (lin W) Iv j h)) ;
    Xv0 : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
          -> Id (TA.EI (lin W)) (Xi W g (constH (lin W) Iv e0)) ((Rf m f).Hs (St m k) W (p1gI m W g) (p2gI m W g)) ;
    Xv1 : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
          -> Id (TA.EI (lin W)) (Xi W g (constH (lin W) Iv e1)) (Cy W (p1gI m W g) (p2gI m W g)) ;
    Xt0 : (W : Nat) (a1 : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
          -> Id (TA.EI (lin W)) (Xi W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin m) a1 (Rf m f).psi) ;
    Xt1 : (W : Nat) (a1 : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
          -> Id (TA.EI (lin W)) (Xi W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e1)) j) (UR.Sq[m, f].R.D.val W (pairH (lin m) Iv (lin W) a1 j)) ;
    ex : ExP k Xi ;
  } ;

  record CPk (m : Nat) (f : Hom (lin m) X) (Cy : FI.HFam m) (ExP : Nat -> FI.TFam m -> U l) (ExC : Nat -> FI.CFam m -> U l)
    (k : Nat) (prev : XSt[m, f, Cy, ExP, k]) {
    Cu : FI.CFam m ;
    Cp : (W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv)
         -> Id (W0.Ix (G.ob (lin W))) (Cu W g j).1 (G.act (lin W) (CB.Geo[m].X) g (xX m f)) ;
    Cn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv)
         -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Cu W g j))
               (Cu V (compH (lin V) (lin W) (CB.Geo[m].X) g h) (compH (lin V) (lin W) Iv j h)) ;
    Cs1 : (W : Nat) (g : Hom (lin W) (CB.Geo[m].X))
          -> Id (TA.EI (lin W)) (Cu W g (constH (lin W) Iv e1))
                (prev.Xi W (pairH (lin m) Iv (lin W) (CB.Geo[m].p1g W g) (CB.Geo[m].pt W g)) (CB.Geo[m].pv W g)) ;
    CT0 : (W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e0 (CB.Geo[m].pt W g))
          -> Id (TA.EI (lin W)) (Cu W g j) (TA.E.act (lin W) (lin m) (CB.Geo[m].p1g W g) (Rf m f).psi) ;
    CT1 : (W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e1 (CB.Geo[m].pt W g))
          -> Id (TA.EI (lin W)) (Cu W g j) (UR.Sq[m, f].Q W (CB.Geo[m].p1g W g) j (CB.Geo[m].pv W g)) ;
    CV0 : (W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e0 (CB.Geo[m].pv W g))
          -> Id (TA.EI (lin W)) (Cu W g j)
                ((Rf m f).Ts (St m k) W (pairH (lin m) Iv (lin W) (CB.Geo[m].p1g W g) (CB.Geo[m].pt W g)) j) ;
    CV1 : (W : Nat) (g : Hom (lin W) (CB.Geo[m].X)) (j : Hom (lin W) Iv) (i : CB.Geo[m].L W e1 (CB.Geo[m].pv W g))
          -> Id (TA.EI (lin W)) (Cu W g j) (Cy W (CB.Geo[m].p1g W g) (CB.Geo[m].pt W g)) ;
    nx : XSt[m, f, Cy, ExP, suc k] ;
    Cs0 : (W : Nat) (a1 : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv)
          -> Id (TA.EI (lin W)) (Cu W (CB.Geo[m].pt3 W a1 t v) (constH (lin W) Iv e0)) (nx.Xi W (pairH (lin m) Iv (lin W) a1 t) v) ;
    exC : ExC k Cu ;
  } ;

  module SR (m : Nat) (f : Hom (lin m) X) (Cy : FI.HFam m)
    (Cyp : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Cy W g j).1 (G.act (lin W) (lin m) g (xf m f)))
    (Cyn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
           -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Cy W g j)) (Cy V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)))
    (Cy0 : (W : Nat) (g : Hom (lin W) (lin m)) -> Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e0)) (TA.E.act (lin W) (lin m) g (Rf m f).psi))
    (Cy1 : (W : Nat) (g : Hom (lin W) (lin m)) -> Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e1)) (TA.E.act (lin W) (lin m) g (UR.Uf m f)))
    (ExP : Nat -> FI.TFam m -> U l) (ExC : Nat -> FI.CFam m -> U l)
    (b0 : XSt[m, f, Cy, ExP, zero])
    (next : (k : Nat) (prev : XSt[m, f, Cy, ExP, k]) -> CPk[m, f, Cy, ExP, ExC, k, prev]) {
    trec : (k : Nat) -> XSt[m, f, Cy, ExP, k] = split {
      zero -> b0 ;
      suc k | ih -> (next k ih).nx } ;

    cp (k : Nat) : CPk[m, f, Cy, ExP, ExC, k, trec k] = next k (trec k) ;

    rec : GRec[m, f] =
      new GRec[m, f, Cy, Cyp, Cyn, Cy0, Cy1,
        \ k -> (trec k).Xi, \ k -> (trec k).Xp, \ k -> (trec k).Xn, \ k -> (trec k).Xv0, \ k -> (trec k).Xv1,
        \ k -> (trec k).Xt0, \ k -> (trec k).Xt1,
        \ k -> (cp k).Cu, \ k -> (cp k).Cp, \ k -> (cp k).Cn, \ k -> (cp k).Cs1, \ k -> (cp k).Cs0,
        \ k -> (cp k).CT0, \ k -> (cp k).CT1, \ k -> (cp k).CV0, \ k -> (cp k).CV1] ;

    ex (k : Nat) : ExP k (trec k).Xi = (trec k).ex ;
    exC (k : Nat) : ExC k (cp k).Cu = (cp k).exC ;
  } ;

  ----------------------------------------------------------------------
  -- two faces agree where they meet

  FFYty (m : Nat) (Y : Ob) (P : (f : Hom (lin m) X) -> FI.YFam m Y) : U l =
    (F : Hom (lin (suc m)) X) (y z : Nat) (hy : IsT (leb y (suc m))) (hz : IsT (leb z (suc m)))
    (lt : IsT (ltb y z)) (W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Y))
    (msy : Miss (lin W) m y (BD.BG[m, Y].p1g W g)) (msz : Miss (lin W) m z (BD.BG[m, Y].p1g W g)) (j : Hom (lin W) Iv)
    -> Id (TA.EI (lin W)) (P (compH (lin m) (lin (suc m)) X F (dl m y)) W (BD.BG[m, Y].gy y W g) j)
                          (P (compH (lin m) (lin (suc m)) X F (dl m z)) W (BD.BG[m, Y].gy z W g) j) ;

  -- dimension 0: no map into [1] misses two vertices
  FFY0 (Y : Ob) (P : (f : Hom (lin zero) X) -> FI.YFam zero Y) : FFYty zero Y P =
    \ F y z hy hz lt W g msy msz j -> absurd _ (Lr.no2 W (BD.BG[zero, Y].p1g W g) y z hy hz lt msy msz) ;

  -- the two compositions of faces
  dd (m : Nat) (F' : Hom (lin (suc (suc m))) X) (y z' : Nat) (hyz : IsT (leb y z'))
    : Id (Hom (lin m) X) (compH (lin m) (lin (suc m)) X (compH (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) y)) (dl m z'))
                         (compH (lin m) (lin (suc m)) X (compH (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) (suc z'))) (dl m y)) =
    transH (comp-assoc (lin m) (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) y) (dl m z'))
      (transH (apH (compH (lin m) (lin (suc (suc m))) X F') (symH (hom-eq (lin m) (lin (suc (suc m))) _ _ (pw-dl-dl m y z' hyz))))
              (symH (comp-assoc (lin m) (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) (suc z')) (dl m y)))) ;

  -- dimension m + 1, from the face relation of P1 (to P0)
  module FFY (Y : Ob) (m : Nat) (P0 : (f : Hom (lin m) X) -> FI.YFam m Y) (P1 : (F : Hom (lin (suc m)) X) -> FI.YFam (suc m) Y)
    (face : (F : Hom (lin (suc m)) X) (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) (prodP (lin m) Y)) (j : Hom (lin W) Iv)
            -> Id (TA.EI (lin W)) (P1 F W (compH (lin W) (prodP (lin m) Y) (prodP (lin (suc m)) Y) (BD.BG[m, Y].dY y) g) j)
                                  (P0 (compH (lin m) (lin (suc m)) X F (dl m y)) W g j)) {
    module FT2 (F' : Hom (lin (suc (suc m))) X) (y : Nat) (hy : IsT (leb y (suc (suc m))))
      (z' : Nat) (hz : IsT (leb (suc z') (suc (suc m)))) (lt : IsT (ltb y (suc z'))) (W : Nat) (g : Hom (lin W) (prodP (lin (suc (suc m))) Y))
      (msy : Miss (lin W) (suc m) y (BD.BG[suc m, Y].p1g W g)) (msz : Miss (lin W) (suc m) (suc z') (BD.BG[suc m, Y].p1g W g)) (j : Hom (lin W) Iv) {
      module BG' = BD.BG[suc m, Y] ;
      module BGf = BD.BG[m, Y] ;
      Fy : Hom (lin (suc m)) X = compH (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) y) ;
      Fz : Hom (lin (suc m)) X = compH (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) (suc z')) ;
      q : Hom (lin W) (lin (suc (suc m))) = BG'.p1g W g ;
      t2 : Hom (lin W) Y = BG'.p2g W g ;
      module T = CFaceTwo[a].TW[m, y, z', lt, hy, hz, lin W, q, msy, msz] ;

      pq (d : Hom (lin m) (lin (suc m))) (k : Hom (lin W) (lin m))
        : Id (Hom (lin W) (prodP (lin (suc m)) Y))
             (compH (lin W) (prodP (lin m) Y) (prodP (lin (suc m)) Y) (crossH (lin m) (lin (suc m)) Y Y d (idH Y)) (pairH (lin m) Y (lin W) k t2))
             (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin m) (lin (suc m)) d k) t2) =
        transH (BD.cross-pair (lin m) (lin (suc m)) Y Y (lin W) d (idH Y) k t2)
               (apH (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin m) (lin (suc m)) d k)) (comp-idl (lin W) Y t2)) ;

      ph : Hom (lin W) (prodP (lin m) Y) = pairH (lin m) Y (lin W) T.hh t2 ;

      res : Id (TA.EI (lin W)) (P1 Fy W (BG'.gy y W g) j) (P1 Fz W (BG'.gy (suc z') W g) j) =
        calc (TA.EI (lin W)) {
            P1 Fy W (pairH (lin (suc m)) Y (lin W) T.g' t2) j
          =< apH (\ k -> P1 Fy W (pairH (lin (suc m)) Y (lin W) k t2) j)
               (symH (hom-eq (lin W) (lin (suc m)) _ _ (pw-factor (lin W) m z' T.g' hz T.ms'))) >
            P1 Fy W (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m z') T.hh) t2) j
          =< apH (\ k -> P1 Fy W k j) (symH (pq (dl m z') T.hh)) >
            P1 Fy W (compH (lin W) (prodP (lin m) Y) (prodP (lin (suc m)) Y) (BGf.dY z') ph) j
          =< face Fy z' hz W ph j >
            P0 (compH (lin m) (lin (suc m)) X Fy (dl m z')) W ph j
          =< apH (\ k -> P0 k W ph j) (dd m F' y z' lt) >
            P0 (compH (lin m) (lin (suc m)) X Fz (dl m y)) W ph j
          =< symH (face Fz y (leb-trans y z' (suc m) lt hz) W ph j) >
            P1 Fz W (compH (lin W) (prodP (lin m) Y) (prodP (lin (suc m)) Y) (BGf.dY y) ph) j
          =< apH (\ k -> P1 Fz W k j) (pq (dl m y) T.hh) >
            P1 Fz W (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m y) T.hh) t2) j
          =< apH (\ k -> P1 Fz W (pairH (lin (suc m)) Y (lin W) k t2) j) T.eq-dlh >
            P1 Fz W (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin (suc (suc m))) (lin (suc m)) (dgH (suc m) (suc z')) q) t2) j } ;
    } ;

    resS (F' : Hom (lin (suc (suc m))) X) (y : Nat) (hy : IsT (leb y (suc (suc m))))
      : (z : Nat) (hz : IsT (leb z (suc (suc m)))) (lt : IsT (ltb y z)) (W : Nat) (g : Hom (lin W) (prodP (lin (suc (suc m))) Y))
        (msy : Miss (lin W) (suc m) y (BD.BG[suc m, Y].p1g W g)) (msz : Miss (lin W) (suc m) z (BD.BG[suc m, Y].p1g W g)) (j : Hom (lin W) Iv)
      -> Id (TA.EI (lin W)) (P1 (compH (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) y)) W (BD.BG[suc m, Y].gy y W g) j)
                            (P1 (compH (lin (suc m)) (lin (suc (suc m))) X F' (dl (suc m) z)) W (BD.BG[suc m, Y].gy z W g) j) = split {
      zero -> \ hz lt -> absurd _ (false-true lt) ;
      suc z' -> \ hz lt W g msy msz j -> FT2[F', y, hy, z', hz, lt, W, g, msy, msz, j].res } ;

    res : FFYty (suc m) Y P1 = \ F' y z hy hz lt W g msy msz j -> resS F' y hy z hz lt W g msy msz j ;
  } ;
  ----------------------------------------------------------------------
  -- the data at f common to all dimensions: the inputs of the initial square

  module Com (m : Nat) (f : Hom (lin m) X) {
    module S = UR.Sq[m, f] ;
    module Ge = CB.Geo[m] ;
    psi : TA.EI (lin m) = (Rf m f).psi ;
    P1 : Ob = prodP (lin m) Iv ;

    L : FI.HFam m = (Rf m f).Hs (St m zero) ;

    Plp (W : Nat) (g : Hom (lin W) P1)
      : Id (W0.Ix (G.ob (lin W))) (S.R.D.val W g).1 (G.act (lin W) P1 g (G.act P1 (lin m) (pr1 (lin m) Iv) (xf m f))) =
      transH (S.R.D.vp W g) (apH (G.act (lin W) P1 g) (symH (GL.actC P1 (lin m) X f (pr1 (lin m) Iv) x))) ;

    L1 (W : Nat) (g : Hom (lin W) (lin m))
      : Id (TA.EI (lin W)) (L W g (constH (lin W) Iv e1)) (S.R.D.val W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0))) =
      transH ((Rf m f).H1 (St m zero) (hSt m zero) W g)
        (transH (IN.DUv m (St m zero) (hSt m zero) f W g) (symH (S.Rend e0 W g))) ;

    module E = SQ.SqE[G, A, m, xf m f, e0, psi, (Rf m f).psi-pt, L, (Rf m f).Hp (St m zero), (Rf m f).Hn (St m zero),
                      S.R.D.val, Plp, S.R.D.vn, (Rf m f).H0 (St m zero), L1] ;
  } ;

  ----------------------------------------------------------------------
  -- the filled initial square gives G_f and Xi^(m+1)

  module SqOut (m : Nat) (f : Hom (lin m) X) (ExP : Nat -> FI.TFam m -> U l)
    (Thf : FI.TFam m)
    (Thf-p : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
             -> Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) (prodP (lin m) Iv) g (Lr.xB m f)))
    (Thf-n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
             -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Thf W g j))
                   (Thf V (compH (lin V) (lin W) (prodP (lin m) Iv) g h) (compH (lin V) (lin W) Iv j h)))
    (Thf-e : (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
             -> Id (TA.EI (lin W)) (Thf W g (constH (lin W) Iv e0)) (Com[m, f].L W (p1gI m W g) (p2gI m W g)))
    (Thf-t0 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TA.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin m) g (Rf m f).psi))
    (Thf-t1 : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
              -> Id (TA.EI (lin W)) (Thf W (pairH (lin m) Iv (lin W) g (constH (lin W) Iv e1)) j) (UR.Sq[m, f].R.D.val W (pairH (lin m) Iv (lin W) g j)))
    (exb : ExP zero Thf) {
    module C = Com[m, f] ;
    module HH = C.E.HT[Thf, Thf-p, Thf-n, Thf-t0, Thf-t1, e1] ;
    Cy : FI.HFam m = HH.H' ;
    Cy1 (W : Nat) (g : Hom (lin W) (lin m)) : Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e1)) (TA.E.act (lin W) (lin m) g (UR.Uf m f)) =
      transH (HH.H'1 W g) (C.S.Rend e1 W g) ;
    Xv1 (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv))
      : Id (TA.EI (lin W)) (Thf W g (constH (lin W) Iv e1)) (Cy W (p1gI m W g) (p2gI m W g)) =
      apH (\ q -> Thf W q (constH (lin W) Iv e1)) (symH (pair-eta (lin m) Iv (lin W) g)) ;
    b0 : XSt[m, f, Cy, ExP, zero] = new XSt[m, f, Cy, ExP, zero, Thf, Thf-p, Thf-n, Thf-e, Xv1, Thf-t0, Thf-t1, exb] ;
  } ;

  ----------------------------------------------------------------------
  -- the cube at (f , k): its end data, its lid, and what its filling gives

  module CubeAt (m : Nat) (f : Hom (lin m) X) (Cy : FI.HFam m)
    (Cyp : (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Cy W g j).1 (G.act (lin W) (lin m) g (xf m f)))
    (Cyn : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
           -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Cy W g j)) (Cy V (compH (lin V) (lin W) (lin m) g h) (compH (lin V) (lin W) Iv j h)))
    (Cy0 : (W : Nat) (g : Hom (lin W) (lin m)) -> Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e0)) (TA.E.act (lin W) (lin m) g (Rf m f).psi))
    (Cy1 : (W : Nat) (g : Hom (lin W) (lin m)) -> Id (TA.EI (lin W)) (Cy W g (constH (lin W) Iv e1)) (TA.E.act (lin W) (lin m) g (UR.Uf m f)))
    (ExP : Nat -> FI.TFam m -> U l) (k : Nat) (prev : XSt[m, f, Cy, ExP, k]) {
    module C = Com[m, f] ;
    module S = C.S ;
    module Ge = CB.Geo[m] ;
    P1 : Ob = prodP (lin m) Iv ;
    N : Nat = St m k ;
    hN : IsT (leb (suc m) N) = hSt m k ;

    -- the four pieces
    T0 : CB.Pc[G, A, m, xf m f] = new CB.Pc[G, A, m, xf m f,
      \ W a1 v j -> TA.E.act (lin W) (lin m) a1 C.psi,
      \ W a1 v j -> apH (G.act (lin W) (lin m) a1) (Rf m f).psi-pt,
      \ V W h a1 v j -> TA.PE.actC (lin V) (lin W) (lin m) a1 h C.psi] ;
    T1 : CB.Pc[G, A, m, xf m f] = new CB.Pc[G, A, m, xf m f,
      \ W a1 v j -> S.Q W a1 j v,
      \ W a1 v j -> S.Qp W a1 j v,
      \ V W h a1 v j -> S.Qn V W h a1 j v] ;
    V0 : CB.Pc[G, A, m, xf m f] = new CB.Pc[G, A, m, xf m f,
      \ W a1 t j -> (Rf m f).Ts N W (pairH (lin m) Iv (lin W) a1 t) j,
      \ W a1 t j -> transH ((Rf m f).Tp N W (pairH (lin m) Iv (lin W) a1 t) j)
                      (GL.actTri (lin W) P1 (lin m) (pr1 (lin m) Iv) (pairH (lin m) Iv (lin W) a1 t) a1 (pr1-pair (lin m) Iv (lin W) a1 t) (xf m f)),
      \ V W h a1 t j -> transH ((Rf m f).Tn N V W h (pairH (lin m) Iv (lin W) a1 t) j)
                          (apH (\ q -> (Rf m f).Ts N V q (compH (lin V) (lin W) Iv j h)) (BD.pair-h (lin m) Iv (lin V) (lin W) a1 t h))] ;
    V1 : CB.Pc[G, A, m, xf m f] = new CB.Pc[G, A, m, xf m f,
      \ W a1 t j -> Cy W a1 t,
      \ W a1 t j -> Cyp W a1 t,
      \ V W h a1 t j -> Cyn V W h a1 t] ;

    module E = CB.E4[G, A, m, xf m f, T0, T1, V0, V1,
      \ W a1 j -> symH ((Rf m f).Tt0 N hN W a1 j),
      \ W a1 j -> symH (Cy0 W a1),
      \ W a1 j -> transH (S.Q-v0 W a1 j)
                    (symH (transH ((Rf m f).Tt1 N hN W a1 j) (IN.DP[m, N, hN, f].val W (pairH (lin m) Iv (lin W) a1 j)))),
      \ W a1 j -> transH (S.Q-v1 W a1 j) (symH (Cy1 W a1))] ;

    -- the lid: Xi^N read on [m] * [1]_t * [1]_v
    gq (W : Nat) (g : Hom (lin W) Ge.X) : Hom (lin W) P1 = pairH (lin m) Iv (lin W) (Ge.p1g W g) (Ge.pt W g) ;

    a0 (W : Nat) (g : Hom (lin W) Ge.X) : TA.EI (lin W) = prev.Xi W (gq W g) (Ge.pv W g) ;

    a0p (W : Nat) (g : Hom (lin W) Ge.X) : Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) Ge.X g (xX m f)) =
      transH (prev.Xp W (gq W g) (Ge.pv W g))
        (transH (GL.actTri (lin W) P1 (lin m) (pr1 (lin m) Iv) (gq W g) (Ge.p1g W g) (pr1-pair (lin m) Iv (lin W) (Ge.p1g W g) (Ge.pt W g)) (xf m f))
                (E.ctx W g)) ;

    gq-h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) Ge.X)
      : Id (Hom (lin V) P1) (compH (lin V) (lin W) P1 (gq W g) h) (gq V (compH (lin V) (lin W) Ge.X g h)) =
      transH (BD.pair-h (lin m) Iv (lin V) (lin W) (Ge.p1g W g) (Ge.pt W g) h)
        (transH (apH (\ q -> pairH (lin m) Iv (lin V) q (compH (lin V) (lin W) Iv (Ge.pt W g) h)) (Ge.p1h V W h g))
                (apH (pairH (lin m) Iv (lin V) (Ge.p1g V (compH (lin V) (lin W) Ge.X g h))) (Ge.pth V W h g))) ;

    a0n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) Ge.X)
      : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) Ge.X g h)) =
      transH (prev.Xn V W h (gq W g) (Ge.pv W g))
        (transH (apH (\ q -> prev.Xi V q (compH (lin V) (lin W) Iv (Ge.pv W g) h)) (gq-h V W h g))
                (apH (prev.Xi V (gq V (compH (lin V) (lin W) Ge.X g h))) (Ge.pvh V W h g))) ;

    -- the pieces at s = 1 are the lid
    module Ld = E.Lid[e1, a0,
      \ W g i -> transH (symH (prev.Xt0 W (Ge.p1g W g) (Ge.pv W g)))
                   (apH (\ q -> prev.Xi W (pairH (lin m) Iv (lin W) (Ge.p1g W g) q) (Ge.pv W g)) (symH (PBs.slands-pt (lin W) e0 (Ge.pt W g) i))),
      \ W g i -> transH (S.Q-s1 W (Ge.p1g W g) (Ge.pv W g))
                   (transH (symH (prev.Xt1 W (Ge.p1g W g) (Ge.pv W g)))
                     (apH (\ q -> prev.Xi W (pairH (lin m) Iv (lin W) (Ge.p1g W g) q) (Ge.pv W g)) (symH (PBs.slands-pt (lin W) e1 (Ge.pt W g) i)))),
      \ W g i -> transH ((Rf m f).Ts1 N hN W (gq W g))
                   (transH (symH (prev.Xv0 W (gq W g))) (apH (prev.Xi W (gq W g)) (symH (PBs.slands-pt (lin W) e0 (Ge.pv W g) i)))),
      \ W g i -> transH (apH (\ q -> Cy W q (Ge.pt W g)) (symH (pr1-pair (lin m) Iv (lin W) (Ge.p1g W g) (Ge.pt W g))))
                   (transH (apH (Cy W (p1gI m W (gq W g))) (symH (pr2-pair (lin m) Iv (lin W) (Ge.p1g W g) (Ge.pt W g))))
                     (transH (symH (prev.Xv1 W (gq W g))) (apH (prev.Xi W (gq W g)) (symH (PBs.slands-pt (lin W) e1 (Ge.pv W g) i)))))] ;

    ----------------------------------------------------------------------
    -- reading the filled cube

    module Out (Thf : FI.CFam m)
      (Thf-p : (W : Nat) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob (lin W))) (Thf W g j).1 (G.act (lin W) Ge.X g (xX m f)))
      (Thf-n : (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv)
               -> Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Thf W g j)) (Thf V (compH (lin V) (lin W) Ge.X g h) (compH (lin V) (lin W) Iv j h)))
      (Thf-e : (W : Nat) (g : Hom (lin W) Ge.X) -> Id (TA.EI (lin W)) (Thf W g (constH (lin W) Iv e1)) (a0 W g))
      (Thf-E : (W : Nat) (g : Hom (lin W) Ge.X) (b : SP.Lands (lin W) Ge.X Ge.endS g) (j : Hom (lin W) Iv)
               -> Id (TA.EI (lin W)) (Thf W g j) (E.Ev W g b j)) {

      -- at a point a , (t , v) in a piece
      lt3 (W : Nat) (a1 : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) (e : El Iv) (i : Ge.L W e t) : Ge.L W e (Ge.pt W (Ge.pt3 W a1 t v)) =
        PBs.slands-hom (lin W) Iv (PBs.sptS e) t _ (symH (Ge.t-pt3 W a1 t v)) i ;
      lv3 (W : Nat) (a1 : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv) (e : El Iv) (i : Ge.L W e v) : Ge.L W e (Ge.pv W (Ge.pt3 W a1 t v)) =
        PBs.slands-hom (lin W) Iv (PBs.sptS e) v _ (symH (Ge.v-pt3 W a1 t v)) i ;

      hT (P : CB.Pc[G, A, m, xf m f]) (W : Nat) (a1 : Hom (lin W) (lin m)) (t v j : Hom (lin W) Iv)
        (q : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j)
                (P.v W (Ge.p1g W (Ge.pt3 W a1 t v)) (Ge.pv W (Ge.pt3 W a1 t v)) j))
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j) (P.v W a1 v j) =
        transH q (transH (apH (\ k1 -> P.v W k1 (Ge.pv W (Ge.pt3 W a1 t v)) j) (Ge.p1-pt3 W a1 t v))
                         (apH (\ k1 -> P.v W a1 k1 j) (Ge.v-pt3 W a1 t v))) ;
      hV (P : CB.Pc[G, A, m, xf m f]) (W : Nat) (a1 : Hom (lin W) (lin m)) (t v j : Hom (lin W) Iv)
        (q : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j)
                (P.v W (Ge.p1g W (Ge.pt3 W a1 t v)) (Ge.pt W (Ge.pt3 W a1 t v)) j))
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j) (P.v W a1 t j) =
        transH q (transH (apH (\ k1 -> P.v W k1 (Ge.pt W (Ge.pt3 W a1 t v)) j) (Ge.p1-pt3 W a1 t v))
                         (apH (\ k1 -> P.v W a1 k1 j) (Ge.t-pt3 W a1 t v))) ;

      hT0 (W : Nat) (a1 : Hom (lin W) (lin m)) (t v j : Hom (lin W) Iv) (i : Ge.L W e0 t)
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j) (T0.v W a1 v j) =
        hT T0 W a1 t v j (transH (Thf-E W (Ge.pt3 W a1 t v) (Ge.inT0 W (Ge.pt3 W a1 t v) (lt3 W a1 t v e0 i)) j)
                                 (E.Ev-T0 W (Ge.pt3 W a1 t v) (Ge.inT0 W (Ge.pt3 W a1 t v) (lt3 W a1 t v e0 i)) j (lt3 W a1 t v e0 i))) ;
      hT1 (W : Nat) (a1 : Hom (lin W) (lin m)) (t v j : Hom (lin W) Iv) (i : Ge.L W e1 t)
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j) (T1.v W a1 v j) =
        hT T1 W a1 t v j (transH (Thf-E W (Ge.pt3 W a1 t v) (Ge.inT1 W (Ge.pt3 W a1 t v) (lt3 W a1 t v e1 i)) j)
                                 (E.Ev-T1 W (Ge.pt3 W a1 t v) (Ge.inT1 W (Ge.pt3 W a1 t v) (lt3 W a1 t v e1 i)) j (lt3 W a1 t v e1 i))) ;
      hV0 (W : Nat) (a1 : Hom (lin W) (lin m)) (t v j : Hom (lin W) Iv) (i : Ge.L W e0 v)
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j) (V0.v W a1 t j) =
        hV V0 W a1 t v j (transH (Thf-E W (Ge.pt3 W a1 t v) (Ge.inV0 W (Ge.pt3 W a1 t v) (lv3 W a1 t v e0 i)) j)
                                 (E.Ev-V0 W (Ge.pt3 W a1 t v) (Ge.inV0 W (Ge.pt3 W a1 t v) (lv3 W a1 t v e0 i)) j (lv3 W a1 t v e0 i))) ;
      hV1 (W : Nat) (a1 : Hom (lin W) (lin m)) (t v j : Hom (lin W) Iv) (i : Ge.L W e1 v)
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) j) (V1.v W a1 t j) =
        hV V1 W a1 t v j (transH (Thf-E W (Ge.pt3 W a1 t v) (Ge.inV1 W (Ge.pt3 W a1 t v) (lv3 W a1 t v e1 i)) j)
                                 (E.Ev-V1 W (Ge.pt3 W a1 t v) (Ge.inV1 W (Ge.pt3 W a1 t v) (lv3 W a1 t v e1 i)) j (lv3 W a1 t v e1 i))) ;

      -- the next square: the cube at s = 0
      g3 (W : Nat) (g : Hom (lin W) P1) (v : Hom (lin W) Iv) : Hom (lin W) Ge.X = Ge.pt3 W (p1gI m W g) (p2gI m W g) v ;

      Xi' : FI.TFam m = \ W g v -> Thf W (g3 W g v) (constH (lin W) Iv e0) ;

      Xp' (W : Nat) (g : Hom (lin W) P1) (v : Hom (lin W) Iv)
        : Id (W0.Ix (G.ob (lin W))) (Xi' W g v).1 (G.act (lin W) P1 g (Lr.xB m f)) =
        transH (Thf-p W (g3 W g v) (constH (lin W) Iv e0))
          (transH (symH (E.ctx W (g3 W g v)))
            (transH (apH (\ q -> G.act (lin W) (lin m) q (xf m f)) (Ge.p1-pt3 W (p1gI m W g) (p2gI m W g) v))
                    (symH (GL.actC (lin W) P1 (lin m) (pr1 (lin m) Iv) g (xf m f))))) ;

      g3-h (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) P1) (v : Hom (lin W) Iv)
        : Id (Hom (lin V) Ge.X) (compH (lin V) (lin W) Ge.X (g3 W g v) h)
             (g3 V (compH (lin V) (lin W) P1 g h) (compH (lin V) (lin W) Iv v h)) =
        transH (BD.pair-h (lin m) CB.IvIv (lin V) (lin W) (p1gI m W g) (pairH Iv Iv (lin W) (p2gI m W g) v) h)
          (transH (apH (pairH (lin m) CB.IvIv (lin V) (compH (lin V) (lin W) (lin m) (p1gI m W g) h))
                     (BD.pair-h Iv Iv (lin V) (lin W) (p2gI m W g) v h))
            (transH (apH (\ q -> pairH (lin m) CB.IvIv (lin V) q (pairH Iv Iv (lin V) (compH (lin V) (lin W) Iv (p2gI m W g) h) (compH (lin V) (lin W) Iv v h)))
                       (comp-assoc (lin V) (lin W) P1 (lin m) (pr1 (lin m) Iv) g h))
                    (apH (\ q -> pairH (lin m) CB.IvIv (lin V) (p1gI m V (compH (lin V) (lin W) P1 g h)) (pairH Iv Iv (lin V) q (compH (lin V) (lin W) Iv v h)))
                       (comp-assoc (lin V) (lin W) P1 Iv (pr2 (lin m) Iv) g h)))) ;

      Xn' (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) P1) (v : Hom (lin W) Iv)
        : Id (TA.EI (lin V)) (TA.E.act (lin V) (lin W) h (Xi' W g v)) (Xi' V (compH (lin V) (lin W) P1 g h) (compH (lin V) (lin W) Iv v h)) =
        transH (Thf-n V W h (g3 W g v) (constH (lin W) Iv e0))
          (transH (apH (Thf V (compH (lin V) (lin W) Ge.X (g3 W g v) h)) (BD.const-h (lin V) (lin W) h e0))
                  (apH (\ q -> Thf V q (constH (lin V) Iv e0)) (g3-h V W h g v))) ;

      Xv0' (W : Nat) (g : Hom (lin W) P1)
        : Id (TA.EI (lin W)) (Xi' W g (constH (lin W) Iv e0)) ((Rf m f).Hs (St m (suc k)) W (p1gI m W g) (p2gI m W g)) =
        transH (hV0 W (p1gI m W g) (p2gI m W g) (constH (lin W) Iv e0) (constH (lin W) Iv e0) (PBs.spt-lands (lin W) e0))
               ((Rf m f).Ts0 N hN W (p1gI m W g) (p2gI m W g)) ;

      Xv1' (W : Nat) (g : Hom (lin W) P1)
        : Id (TA.EI (lin W)) (Xi' W g (constH (lin W) Iv e1)) (Cy W (p1gI m W g) (p2gI m W g)) =
        hV1 W (p1gI m W g) (p2gI m W g) (constH (lin W) Iv e1) (constH (lin W) Iv e0) (PBs.spt-lands (lin W) e1) ;

      -- a point (a , e) of [m] * [1]_t
      pe1 (W : Nat) (a1 : Hom (lin W) (lin m)) (e : El Iv) : Ge.L W e (p2gI m W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e))) =
        PBs.slands-hom (lin W) Iv (PBs.sptS e) (constH (lin W) Iv e) _ (symH (pr2-pair (lin m) Iv (lin W) a1 (constH (lin W) Iv e))) (PBs.spt-lands (lin W) e) ;

      Xt0' (W : Nat) (a1 : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        : Id (TA.EI (lin W)) (Xi' W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e0)) j) (TA.E.act (lin W) (lin m) a1 (Rf m f).psi) =
        transH (hT0 W (p1gI m W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e0))) (p2gI m W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e0)))
                  j (constH (lin W) Iv e0) (pe1 W a1 e0))
               (apH (\ q -> TA.E.act (lin W) (lin m) q (Rf m f).psi) (pr1-pair (lin m) Iv (lin W) a1 (constH (lin W) Iv e0))) ;

      Xt1' (W : Nat) (a1 : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
        : Id (TA.EI (lin W)) (Xi' W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e1)) j) (S.R.D.val W (pairH (lin m) Iv (lin W) a1 j)) =
        transH (hT1 W (p1gI m W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e1))) (p2gI m W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e1)))
                  j (constH (lin W) Iv e0) (pe1 W a1 e1))
          (transH (S.Q-s0 W (p1gI m W (pairH (lin m) Iv (lin W) a1 (constH (lin W) Iv e1))) j)
                  (apH (\ q -> S.R.D.val W (pairH (lin m) Iv (lin W) q j)) (pr1-pair (lin m) Iv (lin W) a1 (constH (lin W) Iv e1)))) ;

      Cs0' (W : Nat) (a1 : Hom (lin W) (lin m)) (t v : Hom (lin W) Iv)
        : Id (TA.EI (lin W)) (Thf W (Ge.pt3 W a1 t v) (constH (lin W) Iv e0)) (Xi' W (pairH (lin m) Iv (lin W) a1 t) v) =
        apH (\ q -> Thf W q (constH (lin W) Iv e0))
          (transH (apH (\ q -> Ge.pt3 W q t v) (symH (pr1-pair (lin m) Iv (lin W) a1 t)))
                  (apH (\ q -> Ge.pt3 W (p1gI m W (pairH (lin m) Iv (lin W) a1 t)) q v) (symH (pr2-pair (lin m) Iv (lin W) a1 t)))) ;

      CT0' (W : Nat) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv) (i : Ge.L W e0 (Ge.pt W g))
        : Id (TA.EI (lin W)) (Thf W g j) (TA.E.act (lin W) (lin m) (Ge.p1g W g) (Rf m f).psi) =
        transH (Thf-E W g (Ge.inT0 W g i) j) (E.Ev-T0 W g (Ge.inT0 W g i) j i) ;
      CT1' (W : Nat) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv) (i : Ge.L W e1 (Ge.pt W g))
        : Id (TA.EI (lin W)) (Thf W g j) (S.Q W (Ge.p1g W g) j (Ge.pv W g)) =
        transH (Thf-E W g (Ge.inT1 W g i) j) (E.Ev-T1 W g (Ge.inT1 W g i) j i) ;
      CV0' (W : Nat) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv) (i : Ge.L W e0 (Ge.pv W g))
        : Id (TA.EI (lin W)) (Thf W g j) ((Rf m f).Ts N W (pairH (lin m) Iv (lin W) (Ge.p1g W g) (Ge.pt W g)) j) =
        transH (Thf-E W g (Ge.inV0 W g i) j) (E.Ev-V0 W g (Ge.inV0 W g i) j i) ;
      CV1' (W : Nat) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv) (i : Ge.L W e1 (Ge.pv W g))
        : Id (TA.EI (lin W)) (Thf W g j) (Cy W (Ge.p1g W g) (Ge.pt W g)) =
        transH (Thf-E W g (Ge.inV1 W g i) j) (E.Ev-V1 W g (Ge.inV1 W g i) j i) ;

      module Fin (ExC : Nat -> FI.CFam m -> U l) (exn : ExP (suc k) Xi') (exc : ExC k Thf) {
        nx : XSt[m, f, Cy, ExP, suc k] = new XSt[m, f, Cy, ExP, suc k, Xi', Xp', Xn', Xv0', Xv1', Xt0', Xt1', exn] ;
        res : CPk[m, f, Cy, ExP, ExC, k, prev] =
          new CPk[m, f, Cy, ExP, ExC, k, prev, Thf, Thf-p, Thf-n, Thf-e, CT0', CT1', CV0', CV1', nx, Cs0', exc] ;
      } ;
    } ;
  } ;
  ----------------------------------------------------------------------
  -- heights on [1] * [1]

  module HI = EZ.HLin[suc zero] ;
  module HY = EZ.HProd[Iv, HI.ht, suc zero, HI.hB, HI.hm, HI.hi, Iv, HI.ht, suc zero, HI.hB, HI.hm, HI.hi] ;

  ----------------------------------------------------------------------
  -- dimension 0

  module D0 (f : Hom (lin zero) X) {
    module C = Com[zero, f] ;
    ExP (k : Nat) (Xi : FI.TFam zero) : U l = Top ;
    ExC (k : Nat) (Cu : FI.CFam zero) : U l = Top ;

    module Sq = SQ.SqZ[G, A, e0, FT.S.fill, FT.S.sides, FT.S.face, xf zero f, C.psi, (Rf zero f).psi-pt, C.L,
      (Rf zero f).Hp (St zero zero), (Rf zero f).Hn (St zero zero), C.S.R.D.val, C.Plp, C.S.R.D.vn, (Rf zero f).H0 (St zero zero), C.L1] ;
    module SO = SqOut[zero, f, ExP, Sq.Thf, Sq.Bx.Fp, Sq.Bx.Fn, Sq.Thf-e, Sq.Thf-t0, Sq.Thf-t1, tt] ;

    module CA (k : Nat) (prev : XSt[zero, f, SO.Cy, ExP, k]) {
      module K = CubeAt[zero, f, SO.Cy, SO.HH.H'p, SO.HH.H'n, SO.HH.H'0, SO.Cy1, ExP, k, prev] ;
      module Bx = BX.BoxZ[G, A, e1, FF.S.fill, FF.S.sides, FF.S.face, CB.IvIv, HY.ht, HY.B, HY.hB, HY.hm, HY.hi, CB.QY, xf zero f,
        K.a0, K.a0p, K.a0n, K.E.Ev, K.E.Evp, K.E.Evn, K.Ld.aE] ;
      module O = K.Out[Bx.Thf, Bx.Thf-p, Bx.Thf-n, Bx.Thf-e, Bx.Thf-E] ;
      res : CPk[zero, f, SO.Cy, ExP, ExC, k, prev] = O.Fin[ExC, tt, tt].res ;
    } ;

    module SRz = SR[zero, f, SO.Cy, SO.HH.H'p, SO.HH.H'n, SO.HH.H'0, SO.Cy1, ExP, ExC, SO.b0, \ k prev -> CA[k, prev].res] ;

    -- the data at f, named at the level of D0 (its environment is f)
    CyD : FI.HFam zero = SO.Cy ;
    XiD (k : Nat) : FI.TFam zero = (SRz.trec k).Xi ;
    CuD (k : Nat) : FI.CFam zero = (SRz.cp k).Cu ;
    rec : GRec[zero, f] =
      new GRec[zero, f, CyD, SRz.rec.Cyp, SRz.rec.Cyn, SRz.rec.Cy0, SRz.rec.Cy1,
        XiD, SRz.rec.Xp, SRz.rec.Xn, SRz.rec.Xv0, SRz.rec.Xv1, SRz.rec.Xt0, SRz.rec.Xt1,
        CuD, SRz.rec.Cp, SRz.rec.Cn, SRz.rec.Cs1, SRz.rec.Cs0, SRz.rec.CT0, SRz.rec.CT1, SRz.rec.CV0, SRz.rec.CV1] ;

    -- the characterising lemmas of the named data, then the names are locked
    CyD-def (W : Nat) (g : Hom (lin W) (lin zero)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (CyD W g j) (Sq.Thf W (pairH (lin zero) Iv (lin W) g j) (constH (lin W) Iv e1)) = refl (CyD W g j) ;
    XiD-def (k W : Nat) (g : Hom (lin W) (prodP (lin zero) Iv)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (XiD k W g j) ((SRz.trec k).Xi W g j) = refl (XiD k W g j) ;
    CuD-def (k W : Nat) (g : Hom (lin W) (CB.Geo[zero].X)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (CuD k W g j) (CA[k, SRz.trec k].Bx.Thf W g j) = refl (CuD k W g j) ;
    opaque CyD-def ; opaque XiD-def ; opaque CuD-def ;
    opaque CyD ; opaque XiD ; opaque CuD ;
  } ;

  ----------------------------------------------------------------------
  -- dimension m + 1

  module DS (m : Nat) (R : (f : Hom (lin m) X) -> GRec[m, f])
    (FFX : (k : Nat) -> FFYty m Iv (\ f -> (R f).Xi k)) (FFC : (k : Nat) -> FFYty m CB.IvIv (\ f -> (R f).Cu k))
    (F : Hom (lin (suc m)) X) {
    Fd (y : Nat) : Hom (lin m) X = compH (lin m) (lin (suc m)) X F (dl m y) ;
    module C = Com[suc m, F] ;
    module ST = Lr.DF[m, F] ;
    module BG1 = BD.BG[m, Iv] ;
    module BG3 = BD.BG[m, CB.IvIv] ;
    module Ge = CB.Geo[suc m] ;
    module Gd = CB.Geo[m] ;

    -- the point of a face
    ctxY (Y : Ob) (y : Nat)
      : Id (W0.Ix (G.ob (prodP (lin m) Y)))
           (G.act (prodP (lin m) Y) (prodP (lin (suc m)) Y) (BD.BG[m, Y].dY y) (G.act (prodP (lin (suc m)) Y) (lin (suc m)) (pr1 (lin (suc m)) Y) (xf (suc m) F)))
           (G.act (prodP (lin m) Y) (lin m) (pr1 (lin m) Y) (xf m (Fd y))) =
      transH (GL.actC (prodP (lin m) Y) (prodP (lin (suc m)) Y) (lin (suc m)) (pr1 (lin (suc m)) Y) (BD.BG[m, Y].dY y) (xf (suc m) F))
        (transH (GL.actEq (prodP (lin m) Y) (lin (suc m)) _ _ (BD.BG[m, Y].pr1-dY y) (xf (suc m) F))
          (transH (symH (GL.actC (prodP (lin m) Y) (lin m) (lin (suc m)) (dl m y) (pr1 (lin m) Y) (xf (suc m) F)))
                  (apH (G.act (prodP (lin m) Y) (lin m) (pr1 (lin m) Y)) (GL.actC (lin m) (lin (suc m)) X F (dl m y) x)))) ;

    -- the initial square, with the sides Xi^(m+2) at the faces
    Th (y : Nat) (hy : IsT (leb y (suc m))) : FI.TFam m = (R (Fd y)).Xi (suc zero) ;

    module Sq = SQ.SqS[G, A, e0, FT.S.fill, FT.S.sides, FT.S.face, m, xf (suc m) F, C.psi, (Rf (suc m) F).psi-pt, C.L,
      (Rf (suc m) F).Hp (St (suc m) zero), (Rf (suc m) F).Hn (St (suc m) zero), C.S.R.D.val, C.Plp, C.S.R.D.vn,
      (Rf (suc m) F).H0 (St (suc m) zero), C.L1, Th,
      \ y hy W g j -> transH ((R (Fd y)).Xp (suc zero) W g j) (apH (G.act (lin W) (prodP (lin m) Iv) g) (symH (ctxY Iv y))),
      \ y hy -> (R (Fd y)).Xn (suc zero),
      \ y hy W g -> transH ((R (Fd y)).Xv0 (suc zero) W g)
                      (symH (ST.HF (suc (suc m)) (leb-refl (suc (suc m))) y hy W (p1gI m W g) (p2gI m W g))),
      \ y hy W a1 j -> transH ((R (Fd y)).Xt0 (suc zero) W a1 j)
                         (transH (apH (TA.E.act (lin W) (lin m) a1) (symH (ST.psiF y hy)))
                                 (TA.PE.actC (lin W) (lin m) (lin (suc m)) (dl m y) a1 C.psi)),
      \ y hy W a1 j -> transH ((R (Fd y)).Xt1 (suc zero) W a1 j) (symH (UR.Face[m, F, y].R-face W a1 j)),
      \ y z hy hz lt W g msy msz j -> FFX (suc zero) F y z hy hz lt W g msy msz j] ;

    ExP (k : Nat) (Xi : FI.TFam (suc m)) : U l =
      (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (j : Hom (lin W) Iv)
      -> Id (TA.EI (lin W)) (Xi W (compH (lin W) (prodP (lin m) Iv) (prodP (lin (suc m)) Iv) (BG1.dY y) g) j) ((R (Fd y)).Xi (suc k) W g j) ;
    ExC (k : Nat) (Cu : FI.CFam (suc m)) : U l =
      (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) (prodP (lin m) CB.IvIv)) (j : Hom (lin W) Iv)
      -> Id (TA.EI (lin W)) (Cu W (compH (lin W) (prodP (lin m) CB.IvIv) (prodP (lin (suc m)) CB.IvIv) (BG3.dY y) g) j) ((R (Fd y)).Cu (suc k) W g j) ;

    module SO = SqOut[suc m, F, ExP, Sq.Thf, Sq.Thf-p, Sq.Thf-n, Sq.Thf-e, Sq.Thf-t0, Sq.Thf-t1, Sq.Thf-face] ;

    -- G on a face
    Cy-face (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (SO.Cy W (compH (lin W) (lin m) (lin (suc m)) (dl m y) g) j) ((R (Fd y)).Cy W g j) =
      transH (Sq.HT[e1].H'-face y hy W g j)
        (transH ((R (Fd y)).Xv1 (suc zero) W (pairH (lin m) Iv (lin W) g j))
          (transH (apH (\ q -> (R (Fd y)).Cy W q (p2gI m W (pairH (lin m) Iv (lin W) g j))) (pr1-pair (lin m) Iv (lin W) g j))
                  (apH ((R (Fd y)).Cy W g) (pr2-pair (lin m) Iv (lin W) g j)))) ;

    -- the face y of a point g of [m+1] * [1] * [1]
    p1gy (y W : Nat) (g : Hom (lin W) Ge.X)
      : Id (Hom (lin W) (lin m)) (Gd.p1g W (BG3.gy y W g)) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) =
      pr1-pair (lin m) CB.IvIv (lin W) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) (Ge.p2g W g) ;
    p2gy (y W : Nat) (g : Hom (lin W) Ge.X) : Id (Hom (lin W) CB.IvIv) (Gd.p2g W (BG3.gy y W g)) (Ge.p2g W g) =
      pr2-pair (lin m) CB.IvIv (lin W) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) (Ge.p2g W g) ;
    ptgy (y W : Nat) (g : Hom (lin W) Ge.X) : Id (Hom (lin W) Iv) (Gd.pt W (BG3.gy y W g)) (Ge.pt W g) =
      apH (compH (lin W) CB.IvIv Iv (pr1 Iv Iv)) (p2gy y W g) ;
    pvgy (y W : Nat) (g : Hom (lin W) Ge.X) : Id (Hom (lin W) Iv) (Gd.pv W (BG3.gy y W g)) (Ge.pv W g) =
      apH (compH (lin W) CB.IvIv Iv (pr2 Iv Iv)) (p2gy y W g) ;
    dldg (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) Ge.X) (ms : Miss (lin W) m y (Ge.p1g W g))
      : Id (Hom (lin W) (lin (suc m))) (compH (lin W) (lin m) (lin (suc m)) (dl m y) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g))) (Ge.p1g W g) =
      hom-eq (lin W) (lin (suc m)) _ _ (pw-factor (lin W) m y (Ge.p1g W g) hy ms) ;
    -- d * id after a pair
    dYp (Y : Ob) (y W : Nat) (a1 : Hom (lin W) (lin m)) (b : Hom (lin W) Y)
      : Id (Hom (lin W) (prodP (lin (suc m)) Y))
           (compH (lin W) (prodP (lin m) Y) (prodP (lin (suc m)) Y) (BD.BG[m, Y].dY y) (pairH (lin m) Y (lin W) a1 b))
           (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m y) a1) b) =
      transH (BD.cross-pair (lin m) (lin (suc m)) Y Y (lin W) (dl m y) (idH Y) a1 b)
             (apH (pairH (lin (suc m)) Y (lin W) (compH (lin W) (lin m) (lin (suc m)) (dl m y) a1)) (comp-idl (lin W) Y b)) ;

    -- the cube at (F , k), with the sides the cubes at the faces
    module CA (k : Nat) (prev : XSt[suc m, F, SO.Cy, ExP, k]) {
      module K = CubeAt[suc m, F, SO.Cy, SO.HH.H'p, SO.HH.H'n, SO.HH.H'0, SO.Cy1, ExP, k, prev] ;
      Nk : Nat = St (suc m) k ;

      Fc (y : Nat) (hy : IsT (leb y (suc m))) : FI.CFam m = (R (Fd y)).Cu (suc k) ;

      -- the side at the face y agrees with the end data
      FEC (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) Ge.X) (ms : Miss (lin W) m y (Ge.p1g W g)) (j : Hom (lin W) Iv)
        : (cc : Ge.C4 W g) -> Id (TA.EI (lin W)) (Fc y hy W (BG3.gy y W g) j) (K.E.EvC W g j cc) = split {
        inl cc -> fT cc ;
        inr cc -> fV cc }
       where {
        a2 : Hom (lin W) (lin m) = compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g) ;
        gy : Hom (lin W) Gd.X = BG3.gy y W g ;
        lnd (e : El Iv) (k1 k2 : Hom (lin W) Iv) (p : Id (Hom (lin W) Iv) k1 k2) (i : Gd.L W e k2) : Gd.L W e k1 =
          PBs.slands-hom (lin W) Iv (PBs.sptS e) k2 k1 (symH p) i ;
        fT : (cc : Ge.CT W g) -> Id (TA.EI (lin W)) (Fc y hy W gy j) (K.E.EvT W g j cc) = split {
          inl i -> transH ((R (Fd y)).CT0 (suc k) W gy j (lnd e0 _ _ (ptgy y W g) i))
                     (transH (apH (\ q -> TA.E.act (lin W) (lin m) q (Rf m (Fd y)).psi) (p1gy y W g))
                       (transH (apH (TA.E.act (lin W) (lin m) a2) (symH (ST.psiF y hy)))
                         (transH (TA.PE.actC (lin W) (lin m) (lin (suc m)) (dl m y) a2 C.psi)
                                 (TA.PE.actEq (lin W) (lin (suc m)) _ _ (dldg y hy W g ms) C.psi)))) ;
          inr i -> transH ((R (Fd y)).CT1 (suc k) W gy j (lnd e1 _ _ (ptgy y W g) i))
                     (transH (apH (\ q -> UR.Sq[m, Fd y].Q W q j (Gd.pv W gy)) (p1gy y W g))
                       (transH (apH (UR.Sq[m, Fd y].Q W a2 j) (pvgy y W g))
                         (transH (symH (UR.Face[m, F, y].Q-face W a2 j (Ge.pv W g)))
                                 (apH (\ q -> C.S.Q W q j (Ge.pv W g)) (dldg y hy W g ms))))) } ;
        fV : (cc : Ge.CV W g) -> Id (TA.EI (lin W)) (Fc y hy W gy j) (K.E.EvV W g j cc) = split {
          inl i -> transH ((R (Fd y)).CV0 (suc k) W gy j (lnd e0 _ _ (pvgy y W g) i))
                     (transH (apH (\ q -> (Rf m (Fd y)).Ts (St m (suc k)) W (pairH (lin m) Iv (lin W) q (Gd.pt W gy)) j) (p1gy y W g))
                       (transH (apH (\ q -> (Rf m (Fd y)).Ts (St m (suc k)) W (pairH (lin m) Iv (lin W) a2 q) j) (ptgy y W g))
                         (transH (apH (\ n -> (Rf m (Fd y)).Ts n W (pairH (lin m) Iv (lin W) a2 (Ge.pt W g)) j) (symH (stE m k)))
                           (transH (symH (ST.TF Nk (hSt (suc m) k) y hy W (pairH (lin m) Iv (lin W) a2 (Ge.pt W g)) j))
                             (apH (\ q -> (Rf (suc m) F).Ts Nk W q j)
                                (transH (dYp Iv y W a2 (Ge.pt W g))
                                        (apH (\ q -> pairH (lin (suc m)) Iv (lin W) q (Ge.pt W g)) (dldg y hy W g ms)))))))) ;
          inr i -> transH ((R (Fd y)).CV1 (suc k) W gy j (lnd e1 _ _ (pvgy y W g) i))
                     (transH (apH (\ q -> (R (Fd y)).Cy W q (Gd.pt W gy)) (p1gy y W g))
                       (transH (apH ((R (Fd y)).Cy W a2) (ptgy y W g))
                         (transH (symH (Cy-face y hy W a2 (Ge.pt W g)))
                                 (apH (\ q -> SO.Cy W q (Ge.pt W g)) (dldg y hy W g ms))))) } ; } ;

      -- the side at the face y starts at the lid
      aF (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) Ge.X) (ms : Miss (lin W) m y (Ge.p1g W g))
        : Id (TA.EI (lin W)) (Fc y hy W (BG3.gy y W g) (constH (lin W) Iv e1)) (K.a0 W g) =
        transH ((R (Fd y)).Cs1 (suc k) W (BG3.gy y W g))
          (transH (apH (\ q -> (R (Fd y)).Xi (suc k) W (pairH (lin m) Iv (lin W) q (Gd.pt W (BG3.gy y W g))) (Gd.pv W (BG3.gy y W g))) (p1gy y W g))
            (transH (apH (\ q -> (R (Fd y)).Xi (suc k) W (pairH (lin m) Iv (lin W) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) q) (Gd.pv W (BG3.gy y W g))) (ptgy y W g))
              (transH (apH ((R (Fd y)).Xi (suc k) W (pairH (lin m) Iv (lin W) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) (Ge.pt W g))) (pvgy y W g))
                (transH (symH (prev.ex y hy W (pairH (lin m) Iv (lin W) (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) (Ge.pt W g)) (Ge.pv W g)))
                        (apH (\ q -> prev.Xi W q (Ge.pv W g))
                           (transH (dYp Iv y W (compH (lin W) (lin (suc m)) (lin m) (dgH m y) (Ge.p1g W g)) (Ge.pt W g))
                                   (apH (\ q -> pairH (lin (suc m)) Iv (lin W) q (Ge.pt W g)) (dldg y hy W g ms)))))))) ;

      module Bx = BX.BoxS[G, A, e1, FF.S.fill, FF.S.sides, FF.S.face, m, CB.IvIv, HY.ht, HY.B, HY.hB, HY.hm, HY.hi, CB.QY, xf (suc m) F,
        K.a0, K.a0p, K.a0n, Fc,
        \ y hy W g j -> transH ((R (Fd y)).Cp (suc k) W g j) (apH (G.act (lin W) (prodP (lin m) CB.IvIv) g) (symH (ctxY CB.IvIv y))),
        \ y hy -> (R (Fd y)).Cn (suc k),
        K.E.Ev, K.E.Evp, K.E.Evn,
        \ y z hy hz lt W g msy msz j -> FFC (suc k) F y z hy hz lt W g msy msz j,
        \ y hy W g ms b j -> FEC y hy W g ms j (Ge.cut W g b),
        aF, K.Ld.aE] ;

      module O = K.Out[Bx.Thf, Bx.Thf-p, Bx.Thf-n, Bx.Thf-e, Bx.Thf-E] ;

      -- the next square on a face
      g3dY (y W : Nat) (g : Hom (lin W) (prodP (lin m) Iv)) (v : Hom (lin W) Iv)
        : Id (Hom (lin W) Ge.X) (O.g3 W (compH (lin W) (prodP (lin m) Iv) (prodP (lin (suc m)) Iv) (BG1.dY y) g) v)
             (compH (lin W) Gd.X Ge.X (BG3.dY y) (Gd.pt3 W (p1gI m W g) (p2gI m W g) v)) =
        transH (apH (\ q -> Ge.pt3 W q (p2gI (suc m) W (compH (lin W) (prodP (lin m) Iv) (prodP (lin (suc m)) Iv) (BG1.dY y) g)) v)
                   (transH (symH (comp-assoc (lin W) (prodP (lin m) Iv) (prodP (lin (suc m)) Iv) (lin (suc m)) (pr1 (lin (suc m)) Iv) (BG1.dY y) g))
                     (transH (apH (\ q -> compH (lin W) (prodP (lin m) Iv) (lin (suc m)) q g) (BG1.pr1-dY y))
                             (comp-assoc (lin W) (prodP (lin m) Iv) (lin m) (lin (suc m)) (dl m y) (pr1 (lin m) Iv) g))))
          (transH (apH (\ q -> Ge.pt3 W (compH (lin W) (lin m) (lin (suc m)) (dl m y) (p1gI m W g)) q v)
                     (transH (symH (comp-assoc (lin W) (prodP (lin m) Iv) (prodP (lin (suc m)) Iv) Iv (pr2 (lin (suc m)) Iv) (BG1.dY y) g))
                             (apH (\ q -> compH (lin W) (prodP (lin m) Iv) Iv q g) (BG1.pr2-dY y))))
                  (symH (dYp CB.IvIv y W (p1gI m W g) (pairH Iv Iv (lin W) (p2gI m W g) v)))) ;

      exn : ExP (suc k) O.Xi' = \ y hy W g v ->
        transH (apH (\ q -> Bx.Thf W q (constH (lin W) Iv e0)) (g3dY y W g v))
          (transH (Bx.Thf-face y hy W (Gd.pt3 W (p1gI m W g) (p2gI m W g) v) (constH (lin W) Iv e0))
            (transH ((R (Fd y)).Cs0 (suc k) W (p1gI m W g) (p2gI m W g) v)
                    (apH (\ q -> (R (Fd y)).Xi (suc (suc k)) W q v) (pair-eta (lin m) Iv (lin W) g)))) ;

      res : CPk[suc m, F, SO.Cy, ExP, ExC, k, prev] = O.Fin[ExC, exn, Bx.Thf-face].res ;
    } ;

    module SRs = SR[suc m, F, SO.Cy, SO.HH.H'p, SO.HH.H'n, SO.HH.H'0, SO.Cy1, ExP, ExC, SO.b0, \ k prev -> CA[k, prev].res] ;

    -- the cube at k, named at the level of DS (its environment is the five
    -- parameters of DS), and the data at F with that name
    CyD : FI.HFam (suc m) = SO.Cy ;
    XiD (k : Nat) : FI.TFam (suc m) = (SRs.trec k).Xi ;
    CuD (k : Nat) : FI.CFam (suc m) = (SRs.cp k).Cu ;
    rec : GRec[suc m, F] =
      new GRec[suc m, F, CyD, SRs.rec.Cyp, SRs.rec.Cyn, SRs.rec.Cy0, SRs.rec.Cy1,
        XiD, SRs.rec.Xp, SRs.rec.Xn, SRs.rec.Xv0, SRs.rec.Xv1, SRs.rec.Xt0, SRs.rec.Xt1,
        CuD, SRs.rec.Cp, SRs.rec.Cn, SRs.rec.Cs1, SRs.rec.Cs0, SRs.rec.CT0, SRs.rec.CT1, SRs.rec.CV0, SRs.rec.CV1] ;

    -- the face relations, stated on rec
    exR (k : Nat) : ExP k (rec.Xi k) = SRs.ex k ;
    exCR (k : Nat) : ExC k (rec.Cu k) = SRs.exC k ;

    -- the characterising lemmas of the named data, then the names are locked
    CyD-def (W : Nat) (g : Hom (lin W) (lin (suc m))) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (CyD W g j) (Sq.Thf W (pairH (lin (suc m)) Iv (lin W) g j) (constH (lin W) Iv e1)) = refl (CyD W g j) ;
    XiD-def (k W : Nat) (g : Hom (lin W) (prodP (lin (suc m)) Iv)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (XiD k W g j) ((SRs.trec k).Xi W g j) = refl (XiD k W g j) ;
    CuD-def (k W : Nat) (g : Hom (lin W) Ge.X) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (CuD k W g j) (CA[k, SRs.trec k].Bx.Thf W g j) = refl (CuD k W g j) ;
    Cy-faceD (y : Nat) (hy : IsT (leb y (suc m))) (W : Nat) (g : Hom (lin W) (lin m)) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (CyD W (compH (lin W) (lin m) (lin (suc m)) (dl m y) g) j) ((R (Fd y)).Cy W g j) = Cy-face y hy W g j ;
    opaque CyD-def ; opaque XiD-def ; opaque CuD-def ; opaque Cy-faceD ;
    opaque CyD ; opaque XiD ; opaque CuD ;
  } ;

  ----------------------------------------------------------------------
  -- the recursion over the dimensions

  record Dm (m : Nat) {
    R : (f : Hom (lin m) X) -> GRec[m, f] ;
    FFX : (k : Nat) -> FFYty m Iv (\ f -> (R f).Xi k) ;
    FFC : (k : Nat) -> FFYty m CB.IvIv (\ f -> (R f).Cu k) ;
  } ;

  D0s : Dm[zero] = new Dm[zero, \ f -> D0[f].rec, \ k -> FFY0 Iv (\ f -> (D0[f].rec).Xi k), \ k -> FFY0 CB.IvIv (\ f -> (D0[f].rec).Cu k)] ;

  Dstep (m : Nat) (d : Dm[m]) : Dm[suc m] =
    new Dm[suc m, \ F -> DS[m, d.R, d.FFX, d.FFC, F].rec,
      \ k -> FFY[Iv, m, \ f -> (d.R f).Xi (suc k), \ F -> (DS[m, d.R, d.FFX, d.FFC, F].rec).Xi k,
                 \ F y hy W g j -> DS[m, d.R, d.FFX, d.FFC, F].exR k y hy W g j].res,
      \ k -> FFY[CB.IvIv, m, \ f -> (d.R f).Cu (suc k), \ F -> (DS[m, d.R, d.FFX, d.FFC, F].rec).Cu k,
                 \ F y hy W g j -> DS[m, d.R, d.FFX, d.FFC, F].exCR k y hy W g j].res] ;

  -- G on a face, for the data one dimension lower given as a parameter
  cyFace (n : Nat) (d : Dm[n]) (F : Hom (lin (suc n)) X) (y : Nat) (hy : IsT (leb y (suc n)))
    (W : Nat) (g : Hom (lin W) (lin n)) (j : Hom (lin W) Iv)
    : Id (TA.EI (lin W)) (((Dstep n d).R F).Cy W (compH (lin W) (lin n) (lin (suc n)) (dl n y) g) j)
                         ((d.R (compH (lin n) (lin (suc n)) X F (dl n y))).Cy W g j) =
    DS[n, d.R, d.FFX, d.FFC, F].Cy-faceD y hy W g j ;

  Drec : (m : Nat) -> Dm[m] = split {
    zero -> D0s ;
    suc m | ih -> Dstep m ih } ;

  -- the step of Drec, named once
  drecS (m : Nat) : Id (Dm[suc m]) (Drec (suc m)) (Dstep m (Drec m)) = refl (Drec (suc m)) ;
} ;
