-- The fibration of a decoded type is the move of the universal one
-- along the code map. This construction is natural in substitution.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module B = CDUniverseBase[a] ;
module DB = B.DB ;
module Code = CDCodeContext[a].C ;
module W = V[a+] ;
module P = B.P1 ;
open P.PS ;
open SmallCat[a].Homs[DB.obV, DB.homV] ;

module Decode (G : PCtx) (A : Code.C.Ty G) {
  T : PTy[G] = Code.decode G A ;
  module S = P.TyL[G, T] ;
  module E = B.P2.TyL[B.U1, B.El1] ;

  ta (W0 : Nat) (u : S.EI W0) : E.EI W0 = (A.1 W0 u.1, u.2) ;

  tn (J I : Nat) (f : Hom J I) (v : S.EI I)
    : Id (E.EI J) (E.E.act J I f (ta I v)) (ta J (S.E.act J I f v)) =
    B.P2.PS.pair-act B.U1 B.El1 J I f (A.1 I v.1) (A.1 J (G.act J I f v.1))
      (Code.eq G A J I f v.1 (G.act J I f v.1) (refl (G.act J I f v.1))) v.2 ;

  ti (I : Nat) (v w : S.EI I) (p : Id (S.Pt I) v.1 w.1) (q : Id (E.EI I) (ta I v) (ta I w)) : Id (S.EI I) v w =
    idJ (S.Pt I) v.1
      (\ x r -> (b : S.T I x) -> Id (E.EI I) (ta I v) (ta I (x, b)) -> Id (S.EI I) v (x, b))
      (\ b r -> apH {S.T I v.1} {S.EI I} (\ z -> (v.1, z)) (E.pr-inj I (A.1 I v.1) v.2 b r)) w.1 p w.2 q ;

  module Cart = DB.CCart[a++, a+].Cart[G, T, B.U1, B.El1, A.1, A.2, ta, \ W0 v -> refl (A.1 W0 v.1),
    tn, ti, \ W0 x b -> b, \ W0 x b -> refl (A.1 W0 x, b)] ;
} ;

Type (G : PCtx) : U a++ = (T : PTy[G]) * CDName[a].Fib G T ;

module Model (fU : DB.CLine[a++].Lines[B.U1, B.El1].Fib) {
  decode (G : PCtx) (A : Code.C.Ty G) : Type G = (Code.decode G A, Decode[G, A].Cart.moveFib fU) ;

  restrict (D G : PCtx) (s : PSub[D, G]) (A : Type G) : Type D =
    (subTy D G A.1 s, DB.CFibSub[a+].FibSub[D, G, s, A.1].sub A.2) ;

  import CDCodeFibSub ;
} ;
