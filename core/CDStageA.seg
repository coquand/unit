-- CDStageA.seg (L8, Delta): seg/model DStageA.seg ported (module names only).  Was: problems of filling (FibAt at e, family path object) on
-- Delta, their restriction, and the values of the lines of fillers (the
-- set-up of FillStage, in line form).
--
--   Prob M        a point x over the end e and a partial line p at x
--   resP h b      the problem restricted along h
--   resP-o        restriction is functorial (GCofib.rside-o)
--   resP-eq       restriction along equal maps
--   lv u W g j    the value of the line of a fibre element u at (g , j)
--   lv-act        lines of restricted elements are restricted lines
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;

module SA (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) {
  module KA = DB.CLine[lz].EndKit[G, A, e] ;
  module FT = DB.CLine[lz].FT[G, A] ;
  module TA = DB.GPre[lz].TyL[G, A] ;

  Prob (M : Nat) : U lz = (x : KA.TV.EI M) * KA.PT.Side[M, x] ;

  resP (M' M : Nat) (h : Hom (lin M') (lin M)) (b : Prob M) : Prob M' =
    (KA.TV.E.act M' M h b.1, KA.PT.rside M' M h b.1 b.2) ;

  resP-o (M'' M' M : Nat) (g : Hom (lin M'') (lin M')) (h : Hom (lin M') (lin M)) (b : Prob M)
    : Id (Prob M'') (resP M'' M (compH (lin M'') (lin M') (lin M) h g) b) (resP M'' M' g (resP M' M h b)) =
    Sigma-path (KA.TV.EI M'') (\ z -> KA.PT.Side[M'', z])
      (KA.TV.E.act M'' M (compH (lin M'') (lin M') (lin M) h g) b.1) (KA.TV.E.act M'' M' g (KA.TV.E.act M' M h b.1))
      (KA.PT.rside M'' M (compH (lin M'') (lin M') (lin M) h g) b.1 b.2)
      (KA.PT.rside M'' M' g (KA.TV.E.act M' M h b.1) (KA.PT.rside M' M h b.1 b.2))
      (KA.TV.E.act-o M'' M' M h g b.1)
      (KA.PT.rside-o M'' M' M g h b.1 b.2) ;

  resP-eq (M' M : Nat) (h h' : Hom (lin M') (lin M)) (E : Id (Hom (lin M') (lin M)) h h') (b : Prob M)
    : Id (Prob M') (resP M' M h b) (resP M' M h' b) = apH (\ k -> resP M' M k b) E ;

  -- two composites that agree give the same twice-restricted problem
  resP-sq (M'' M1 M2 M : Nat) (h1 : Hom (lin M1) (lin M)) (g1 : Hom (lin M'') (lin M1))
    (h2 : Hom (lin M2) (lin M)) (g2 : Hom (lin M'') (lin M2))
    (E : Id (Hom (lin M'') (lin M)) (compH (lin M'') (lin M1) (lin M) h1 g1) (compH (lin M'') (lin M2) (lin M) h2 g2)) (b : Prob M)
    : Id (Prob M'') (resP M'' M1 g1 (resP M1 M h1 b)) (resP M'' M2 g2 (resP M2 M h2 b)) =
    transH (symH (resP-o M'' M1 M g1 h1 b)) (transH (resP-eq M'' M _ _ E b) (resP-o M'' M2 M g2 h2 b)) ;

  -- fillings at a stage, and their values in E at equal problems
  FillTy (M : Nat) : U lz = (b : Prob M) -> KA.TS.T M b.1 ;

  fillE (M : Nat) (F : FillTy M) (b : Prob M) : KA.TS.EI M = (b.1, F b) ;

  fill-cong (M : Nat) (F : FillTy M) (b b' : Prob M) (P : Id (Prob M) b b') : Id (KA.TS.EI M) (fillE M F b) (fillE M F b') =
    apH (fillE M F) P ;

  -- the value of the line of a fibre element
  lv (M : Nat) (u : KA.TS.EI M) (W : Nat) (g : Hom (lin W) (lin M)) (j : Hom (lin W) Iv) : TA.EI W =
    (KA.lineL M u).2.1.1 W g j ;

  lv-act (M' M : Nat) (h : Hom (lin M') (lin M)) (u : KA.TS.EI M) (W : Nat) (g : Hom (lin W) (lin M')) (j : Hom (lin W) Iv)
    : Id (TA.EI W) (lv M' (KA.TS.E.act M' M h u) W g j) (lv M u W (compH (lin W) (lin M') (lin M) h g) j) =
    apH (\ L -> L.2.1.1 W g j) (KA.lineL-act M' M h u) ;

  lv-nat (M : Nat) (u : KA.TS.EI M) (V W : Nat) (g' : Hom (lin V) (lin W)) (g : Hom (lin W) (lin M)) (j : Hom (lin W) Iv)
    : Id (TA.EI V) (TA.E.act V W g' (lv M u W g j)) (lv M u V (compH (lin V) (lin W) (lin M) g g') (compH (lin V) (lin W) Iv j g')) =
    (KA.lineL M u).2.1.2 V W g' g j ;

  lv-pt (M : Nat) (u : KA.TS.EI M) (W : Nat) (g : Hom (lin W) (lin M)) (j : Hom (lin W) Iv)
    : Id (W0.Ix (G.ob W)) (lv M u W g j).1 (u.1.1.1 W g j) =
    apH (\ y -> y.1 W g j) (KA.lineL M u).2.2 ;

  -- at (id , e) the line is the point
  lv-end (M : Nat) (u : KA.TS.EI M) : Id (TA.EI M) (lv M u M (idH (lin M)) (constH (lin M) Iv e)) (KA.endE M u.1) =
    transH (symH (FT.Ev[e].endB-E M (KA.lineL M u))) (apH (KA.endE M) u.2.2) ;

  -- two fibre elements with the same point and the same line values are equal
  ts-ext (M : Nat) (u v : KA.TS.EI M) (p : Id (KA.TV.EI M) u.1 v.1)
    (q : (W : Nat) (g : Hom (lin W) (lin M)) (j : Hom (lin W) Iv) -> Id (TA.EI W) (lv M u W g j) (lv M v W g j)) : Id (KA.TS.EI M) u v =
    KA.ts-ext M u v p q ;

  -- line helpers (seg/model GLine.LevKit, GFam.famConn)
  levA (M : Nat) (L : KA.TL.EI M) (W : Nat) (g : Hom (lin W) (lin M)) (j : Hom (lin W) Iv) : TA.EI W = L.2.1.1 W g j ;

  levA-lam (X : Nat) (x : W0.Ix (FT.FG.ob X)) (t : (W : Nat) -> Hom (lin W) (lin X) -> Hom (lin W) Iv -> TA.EI W)
    (tp : (W : Nat) (f : Hom (lin W) (lin X)) (i : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (t W f i).1 (x.1 W f i))
    (tn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin X)) (i : Hom (lin W) Iv)
          -> Id (TA.EI V) (TA.E.act V W g (t W f i)) (t V (compH (lin V) (lin W) (lin X) f g) (compH (lin V) (lin W) Iv i g)))
    (W : Nat) (g : Hom (lin W) (lin X)) (j : Hom (lin W) Iv) : Id (TA.EI W) ((FT.lamA X x t tp tn).1.1 W g j) (t W g j) =
    refl (t W g j) ;

  endL-lev (M : Nat) (L : KA.TL.EI M) : Id (TA.EI M) (KA.endE M (FT.Ev[e].evA.mE M L)) (L.2.1.1 M (idH (lin M)) (constH (lin M) Iv e)) =
    FT.Ev[e].endB-E M L ;

  mkTS-lev (M : Nat) (w : KA.TV.EI M) (L : KA.TL.EI M) (p : Id (W0.Ix (FT.FG.ob M)) L.1 w.1)
    (q : Id (TA.EI M) (KA.endE M (FT.Ev[e].evA.mE M L)) (KA.endE M w)) (V : Nat) (g : Hom (lin V) (lin M)) (j : Hom (lin V) Iv)
    : Id (TA.EI V) (lv M (KA.mkTS M w L p q) V g j) (L.2.1.1 V g j) =
    apH (\ L' -> L'.2.1.1 V g j) (KA.mkTS-line M w L p q) ;

  levA-ptAct (M : Nat) (L : KA.TL.EI M) (V : Nat) (g : Hom (lin V) (lin M))
    : Id (TA.EI V) (TA.E.act V M g (L.2.1.1 M (idH (lin M)) (constH (lin M) Iv e))) (L.2.1.1 V g (constH (lin V) Iv e)) =
    transH (L.2.1.2 V M g (idH (lin M)) (constH (lin M) Iv e))
      (transH (apH (\ k -> L.2.1.1 V k (compH (lin V) (lin M) Iv (constH (lin M) Iv e) g)) (comp-idl (lin V) (lin M) g))
              (apH (\ k -> L.2.1.1 V g k) (constH-nat (lin V) (lin M) g e))) ;
} ;
