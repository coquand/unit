-- CLocUniv.seg (L9): the universal property of eta (localisation.tex,
-- Proposition prop:univ; [CRS] Theorem 1.10, (2) => (1), for maps over G).
--
--   isModal B      eta_B is a homotopy equivalence (CHtpyOps.HEq); DA is
--                  modal for fibrant A (dModal, from CLocEq (ii))
--   etaU           eta is natural in the map, strictly: D u . eta_A = eta_B . u
--   Dcomp          D (f . g) = D f . D g, strictly
--   UP.PA[u].resA   G(u) . eta_A ~ u,          G(u) = p_B . D u
--   UP.PBm[f].resB  G(f . eta_A) ~ f           (composed in B, fibrant)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module LD = CLocD[a, l] ;
module CH = CLocHtpy[a, l] ;
module HO = PB.CHtpyOps[l] ;

-- B is D-modal: eta_B is a homotopy equivalence
isModal (G : PCtx) (B : PTy[G]) : U l+ =
  HO.HEq[G, B, LD.DT[G, B].DA, CH.toN G B (LD.DT[G, B].DA) (LD.DT[G, B].etaN)] ;

-- DA is modal for fibrant A (CLocEq (ii))
dModal (G : PCtx) (A : PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) : isModal G (LD.DT[G, A].DA) =
  CLocEq[a, l].Eq[G, A].Fib[c].hEtaD ;

-- the composite of two maps of CLocD
compL (G : PCtx) (A B C : PTy[G]) (al : LD.NatMap[G, A, B]) (be : LD.NatMap[G, B, C]) : LD.NatMap[G, A, C] =
  new LD.NatMap[G, A, C, \ I x a0 -> be.nfun I x (al.nfun I x a0),
    \ J I f x y e a0 -> transH (be.nnat J I f x y e (al.nfun I x a0)) (apH (be.nfun J y) (al.nnat J I f x y e a0))] ;

-- eta is natural in the map: D u (eta_A a) = eta_B (u a)
etaU (G : PCtx) (A B : PTy[G]) (u : LD.NatMap[G, A, B]) (I : Ob) (x : W.Ix (G.ob I)) (a0 : W.Ix (A.tob I x))
  : Id (W.Ix (LD.DT[G, B].DA.tob I x)) (LD.DMap[G, A, B, u].DF I x (LD.DT[G, A].etaF I x a0)) (LD.DT[G, B].etaF I x (u.nfun I x a0)) =
  LD.DT[G, B].Dext I x _ _ (\ n f -> LD.DMap[G, A, B, u].alE-act (lin n) I f (x, a0)) ;

-- D (be . al) = D be . D al
Dcomp (G : PCtx) (A B C : PTy[G]) (al : LD.NatMap[G, A, B]) (be : LD.NatMap[G, B, C]) (I : Ob) (x : W.Ix (G.ob I))
  (v : W.Ix (LD.DT[G, A].DA.tob I x))
  : Id (W.Ix (LD.DT[G, C].DA.tob I x)) (LD.DMap[G, A, C, compL G A B C al be].DF I x v)
                                      (LD.DMap[G, B, C, be].DF I x (LD.DMap[G, A, B, al].DF I x v)) =
  LD.DT[G, C].Dext I x _ _ (\ n f -> refl (LD.DT[G, C].rd I x (LD.DMap[G, A, C, compL G A B C al be].DF I x v).1 n f)) ;

opaque etaU ; opaque Dcomp ;

module UP (G : PCtx) (A B : PTy[G]) (cB : PB.CLine[l].Lines[G, B].Fib) (mB : isModal G B) {
  module DA = LD.DT[G, A] ;
  module DB = LD.DT[G, B] ;
  etaA : LD.NatMap[G, A, DA.DA] = DA.etaN ;
  etaB : LD.NatMap[G, B, DB.DA] = DB.etaN ;
  nEtaB : HO.NMap[G, B, DB.DA] = CH.toN G B DB.DA etaB ;
  p : HO.NMap[G, DB.DA, B] = mB.inv ;

  -- p . eta_B ~ id
  hl : PEl[extP G B, HO.HT[G, B, B, HO.compN G B DB.DA B nEtaB p, HO.idN G B].PT.PathP] = mB.hl ;

  -- G(u) = p . D u
  Gm (u : LD.NatMap[G, A, B]) : HO.NMap[G, DA.DA, B] = HO.compN G DA.DA DB.DA B (CH.toN G DA.DA DB.DA (LD.DMap[G, A, B, u].DN)) p ;

  ----------------------------------------------------------------------
  -- (a) G(u) . eta_A ~ u

  module PA (u : LD.NatMap[G, A, B]) {
    nu : HO.NMap[G, A, B] = CH.toN G A B u ;
    module W1 = HO.WR[G, B, B, A, HO.compN G B DB.DA B nEtaB p, HO.idN G B, nu, hl] ;

    resA : PEl[extP G A, HO.HT[G, A, B, HO.compN G A DA.DA B (CH.toN G A DA.DA etaA) (Gm u), nu].PT.PathP] =
      HO.Ret[G, A, B, W1.T'.al, W1.T'.be, HO.compN G A DA.DA B (CH.toN G A DA.DA etaA) (Gm u), nu,
        \ I x a0 -> apH (p.nfun I x) (etaU G A B u I x a0), \ I x a0 -> refl (u.nfun I x a0), W1.res].res ;
  } ;

  ----------------------------------------------------------------------
  -- (b) G(f . eta_A) ~ f

  module PBm (f : LD.NatMap[G, DA.DA, B]) {
    module D2 = LD.DT[G, DA.DA] ;
    nf : HO.NMap[G, DA.DA, B] = CH.toN G DA.DA B f ;
    Df : LD.NatMap[G, D2.DA, DB.DA] = LD.DMap[G, DA.DA, B, f].DN ;
    pDf : HO.NMap[G, D2.DA, B] = HO.compN G D2.DA DB.DA B (CH.toN G D2.DA DB.DA Df) p ;
    Deta : LD.NatMap[G, DA.DA, D2.DA] = LD.DMap[G, A, DA.DA, etaA].DN ;
    fEta : LD.NatMap[G, A, B] = compL G A DA.DA B etaA f ;

    -- p Df eta_DA ~ p Df D eta_A   (eta-path, whiskered)
    module W1 = HO.WL[G, DA.DA, D2.DA, B, CH.toN G DA.DA D2.DA D2.etaN, CH.toN G DA.DA D2.DA Deta, pDf, CLocEtaH[a, l].EH[G, A].res] ;

    -- ... retargeted: f . (p eta_B) ~ G(f . eta_A)
    K1 : PEl[extP G DA.DA, HO.HT[G, DA.DA, B, HO.compN G DA.DA B B nf (HO.compN G B DB.DA B nEtaB p), Gm fEta].PT.PathP] =
      HO.Ret[G, DA.DA, B, W1.T'.al, W1.T'.be, HO.compN G DA.DA B B nf (HO.compN G B DB.DA B nEtaB p), Gm fEta,
        \ I x v -> symH (apH (p.nfun I x) (etaU G DA.DA B f I x v)),
        \ I x v -> apH (p.nfun I x) (Dcomp G A DA.DA B etaA f I x v), W1.res].res ;

    -- f . (p eta_B) ~ f   (hl, whiskered)
    module W2 = HO.WR[G, B, B, DA.DA, HO.compN G B DB.DA B nEtaB p, HO.idN G B, nf, hl] ;

    K2 : PEl[extP G DA.DA, HO.HT[G, DA.DA, B, HO.compN G DA.DA B B nf (HO.compN G B DB.DA B nEtaB p), nf].PT.PathP] =
      HO.Ret[G, DA.DA, B, W2.T'.al, W2.T'.be, HO.compN G DA.DA B B nf (HO.compN G B DB.DA B nEtaB p), nf,
        \ I x v -> refl (p.nfun I x (etaB.nfun I x (f.nfun I x v))), \ I x v -> refl (f.nfun I x v), W2.res].res ;

    resB : PEl[extP G DA.DA, HO.HT[G, DA.DA, B, Gm fEta, nf].PT.PathP] =
      HO.Cat[G, DA.DA, B, Gm fEta, HO.compN G DA.DA B B nf (HO.compN G B DB.DA B nEtaB p), nf, cB.1,
        HO.Inv[G, DA.DA, B, HO.compN G DA.DA B B nf (HO.compN G B DB.DA B nEtaB p), Gm fEta, cB.1, K1].res, K2].res ;
  } ;
} ;
