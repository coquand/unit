-- Reading a named type at the identity gives the original type.
open Axioms[a++].FunExtLemmas[fe @(a++)] ;

module Read (G : PCtx) (A : PTy[G]) (h : Op G A) {
  module N = Naming[G, A, h] ;
  module PN = PresheafPi[a, a+].PPi[DB.BC] ;
  T : PTy[G] = C.decode G N.name ;

  vpath (I : Nat) (x : W.Ix (G.ob I)) : Id W.V (T.tob I x) (A.tob I x) =
    apH (A.tob I) (G.act-id I x) ;

  cast (I : Nat) (x : W.Ix (G.ob I)) (z : W.Ix (T.tob I x)) : W.Ix (A.tob I x) =
    subst W.V (\ v -> W.Ix v) (T.tob I x) (A.tob I x) (vpath I x) z ;

  module Action (J I : Nat) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
    (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) (z : W.Ix (T.tob I x)) {
    x0 : W.Ix (G.ob I) = G.act I I (DB.idH I) x ;
    y0 : W.Ix (G.ob J) = G.act J I (DB.compH J J I f (DB.idH J)) x ;
    ex : Id (W.Ix (G.ob J)) (G.act J I f x0) y0 =
      Q.PS.ntEq (Y.yP I) (high G) (N.loc I x) J I f (DB.idH I) (DB.compH J J I f (DB.idH J)) (U1.idf-eq J I f) ;
    ey : Id (W.Ix (G.ob J)) y0 y = transH (apH (\ g -> G.act J I g x) (DB.comp-idr J I f)) e ;
    P0 : U1.U0 J = U1.uAct J I f (N.name.1 I x) ;
    P1 : U1.U0 J = N.name.1 J y ;
    path : Id (U1.U0 J) P0 P1 = C.eq G N.name J I f x y e ;
    raw : W.Ix (A.tob J y0) = A.tact J I f x0 y0 ex z ;
    fibre : Id W.V (A.tob J y0) (T.tob J y) = apH (U1.fib0 J) path ;
    moved : W.Ix (T.tob J y) = T.tact J I f x y e z ;

    move : Id (W.Ix (T.tob J y)) moved (subst W.V (\ v -> W.Ix v) (A.tob J y0) (T.tob J y) fibre raw) =
      U1.substF J P0 P1 path raw ;

    opaque move ;

    ending : Id (W.Ix (A.tob J y)) (cast J y moved)
      (subst (W.Ix (G.ob J)) (\ q -> W.Ix (A.tob J q)) y0 y ey raw) =
      transH (apH (cast J y) move)
        (transH (symH (PN.subst-trans W.V (\ v -> W.Ix v) (A.tob J y0) (T.tob J y) (A.tob J y) fibre (vpath J y) raw))
          (U1.fib-move (W.Ix (G.ob J)) (A.tob J) y0 y ey (transH fibre (vpath J y)) raw)) ;

    law : Id (W.Ix (A.tob J y)) (cast J y (T.tact J I f x y e z)) (A.tact J I f x y e (cast I x z)) =
      transH ending
        (transH (U1.tact-move (high G) (highTy G A) J I f x0 y0 y ex (transH ex ey) ey z)
          (transH (symH (U1.tact-src-move (high G) (highTy G A) J I f x0 x y (G.act-id I x) e (transH ex ey) z))
            (apH (A.tact J I f x y e)
              (symH (U1.fib-move (W.Ix (G.ob I)) (A.tob I) x0 x (G.act-id I x) (vpath I x) z))))) ;

    opaque law ;
  } ;

  objs : Id (TOb G) T.tob A.tob =
    funext Nat (\ I -> W.Ix (G.ob I) -> W.V) T.tob A.tob (\ I ->
      funext (W.Ix (G.ob I)) (\ _ -> W.V) (T.tob I) (A.tob I) (vpath I)) ;

  index (I : Nat) (x : W.Ix (G.ob I)) (z : W.Ix (T.tob I x))
    : Id (W.Ix (A.tob I x)) (subst (TOb G) (\ o -> W.Ix (o I x)) T.tob A.tob objs z) (cast I x z) =
    transH (subst-ap (TOb G) W.V (\ o -> o I x) (\ v -> W.Ix v) T.tob A.tob objs z)
      (U1.substFib-irr (T.tob I x) (A.tob I x) (apH (\ o -> o I x) objs) (vpath I x) z) ;

  law : Id (PTy[G]) T A =
    P.PS.ty-ext2 G T A objs (\ J I f x y e z ->
      transH (index J y (T.tact J I f x y e z))
        (transH (Action[J, I, f, x, y, e, z].law) (apH (A.tact J I f x y e) (symH (index I x z))))) ;

  opaque index ; opaque law ;
} ;
