-- CLocPath.seg (L9): Lemma eta-path (localisation.tex §5), part 1: the element of DDA over X * [1]; ported from seg/model DPath.seg
-- onto core's poset instance (module names only).  Original header:
--
--   MODEL/Poset/DPath.agda.  Lemma 3.1 of [S]: a path between
-- eta_DA and D eta_A, built without the composition of A.  For u in
-- DA(X , x), an element v of DDA at X * [1] over x p:
--
--   v (f , h) (g) = u (f (g0 + A1)) (B0 + g1)
--
-- where h : [n] -> [1] cuts [n] = A0 + A1, and g : [m] -> [n] cuts
-- [m] = B0 + B1 accordingly (Sum).  Read in the total presheaf, every
-- condition on v is an instance of one principle: u(F) K does not change
-- when (F , K) is reparametrised along a strictly monotone map (RP).
--
--   pathD      the element v
--
-- Agda's  opaque R / opaque unfolding R  is the segment RAt with
-- `opaque R` after R-def and eqR; the where-blocks of inner and outerR are
-- the segments ID and OR.

level q l ;
constraint q <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[q] ;
open Arith[q] ;
open Sum[q] ;
open Cat[q] ;
open SmallCat[q].Objs[obV] ; open SmallCat[q].Homs[obV, homV] ;
open CPosC[q] ;
open CSimp[q] ;
module PB = CPosInst[q].PB ;
module PR = PB.GPre[l] ;
open PR.PS ;
module DD = CLocD[q, l] ;

-- the projection of the cylinder (seg/model CylCat)
pX (X : Ob) : Hom (prodP X Iv) X = pr1 X Iv ;

pX-lid (X : Ob) (e : El Iv) : Id (Hom X X) (compH X (prodP X Iv) X (pX X) (lid X e)) (idH X) =
  pr1-pair X Iv X (idH X) (constH X Iv e) ;

-- (seg/model PropD)
-- the projection after a lid
pw-pX-lid (X : Ob) (e : El Iv) : PW X X (compH X (prodP X Iv) X (pX X) (lid X e)) (idH X) = \ s ->
  apH (\ k -> (app X X k s).1) (pX-lid X e) ;

-- the two coordinates of lid e x
pX-lid1 (X : Ob) (e : El Iv) (x : El X) : Id Tree (app (prodP X Iv) X (pX X) (app X (prodP X Iv) (lid X e) x)).1 x.1 =
  p1-node X Iv (app X (prodP X Iv) (lid X e) x) x.1 e.1 (app-lid1 X e x) ;

pr2-lid1 (X : Ob) (e : El Iv) (x : El X) : Id Tree (app (prodP X Iv) Iv (pr2 X Iv) (app X (prodP X Iv) (lid X e) x)).1 e.1 =
  p2-node X Iv (app X (prodP X Iv) (lid X e) x) x.1 e.1 (app-lid1 X e x) ;

-- the projection of a map through a lid is the map
pw-pX-lid-comp (W X : Ob) (e : El Iv) (phi : Hom W X)
  : PW W X (compH W (prodP X Iv) X (pX X) (compH W X (prodP X Iv) (lid X e) phi)) phi = \ x ->
  calc Tree {
      (app W X (compH W (prodP X Iv) X (pX X) (compH W X (prodP X Iv) (lid X e) phi)) x).1
    =< app-compH1 W (prodP X Iv) X (pX X) (compH W X (prodP X Iv) (lid X e) phi) x >
      (app (prodP X Iv) X (pX X) (app W (prodP X Iv) (compH W X (prodP X Iv) (lid X e) phi) x)).1
    =< apH (\ w -> (app (prodP X Iv) X (pX X) w).1) (app-compH W X (prodP X Iv) (lid X e) phi x) >
      (app (prodP X Iv) X (pX X) (app X (prodP X Iv) (lid X e) (app W X phi x))).1
    =< pX-lid1 X e (app W X phi x) >
      (app W X phi x).1 } ;

-- the second coordinate of a map through a lid is constant
pr2-lid-comp (W X : Ob) (e : El Iv) (phi : Hom W X) (x : El W)
  : Id Tree (app W Iv (compH W (prodP X Iv) Iv (pr2 X Iv) (compH W X (prodP X Iv) (lid X e) phi)) x).1 e.1 =
  calc Tree {
      (app W Iv (compH W (prodP X Iv) Iv (pr2 X Iv) (compH W X (prodP X Iv) (lid X e) phi)) x).1
    =< app-compH1 W (prodP X Iv) Iv (pr2 X Iv) (compH W X (prodP X Iv) (lid X e) phi) x >
      (app (prodP X Iv) Iv (pr2 X Iv) (app W (prodP X Iv) (compH W X (prodP X Iv) (lid X e) phi) x)).1
    =< apH (\ w -> (app (prodP X Iv) Iv (pr2 X Iv) w).1) (app-compH W X (prodP X Iv) (lid X e) phi x) >
      (app (prodP X Iv) Iv (pr2 X Iv) (app X (prodP X Iv) (lid X e) (app W X phi x))).1
    =< pr2-lid1 X e (app W X phi x) >
      e.1 } ;


------------------------------------------------------------------------
-- Equal maps are pointwise equal

pw-of-eq (X Y : Ob) (f g : Hom X Y) (e : Id (Hom X Y) f g) : PW X Y f g = \ s -> apH (\ k -> (app X Y k s).1) e ;

------------------------------------------------------------------------
-- Maps [m] -> [n] from numbers, monotone on [0 .. m]

module LinMap' (m n : Nat) (phi : Nat -> Nat)
  (rng : (i : Nat) -> IsT (leb i m) -> IsT (leb (phi i) n))
  (mon : (i j : Nat) -> IsT (leb i j) -> IsT (leb j m) -> IsT (leb (phi i) (phi j))) {

  fun' : (t : Tree) -> IsT (car (lin m) t) -> El (lin n) = split {
    leaf i -> \ h -> (leaf (phi i), rng i h) ;
    node s t -> \ h -> absurd _ (false-true h) } ;

  fun (s : El (lin m)) : El (lin n) = fun' s.1 s.2 ;

  mo' : (x : Tree) (hx : IsT (car (lin m) x)) (y : Tree) (hy : IsT (car (lin m) y))
    -> IsT (le (lin m) x y) -> IsT (le (lin n) (fun' x hx).1 (fun' y hy).1) = split {
    leaf i -> \ hx -> split {
      leaf j -> \ hy l -> mon i j l hy ;
      node c d -> \ hy l -> absurd _ (false-true hy) } ;
    node s t -> \ hx y hy l -> absurd _ (false-true hx) } ;

  mo : Mono (lin m) (lin n) fun = \ s t l -> mo' s.1 s.2 t.1 t.2 l ;

  str' (st : (i j : Nat) -> IsT (leb j m) -> IsT (ltb i j) -> IsT (ltb (phi i) (phi j)))
    : (x : Tree) (hx : IsT (car (lin m) x)) (y : Tree) (hy : IsT (car (lin m) y))
    -> IsT (lt (lin m) x y) -> IsT (lt (lin n) (fun' x hx).1 (fun' y hy).1) = split {
    leaf i -> \ hx -> split {
      leaf j -> \ hy l -> lin-lt (phi i) (phi j) (st i j hy (lt-lin i j l)) ;
      node c d -> \ hy l -> absurd _ (false-true hy) } ;
    node s t -> \ hx y hy l -> absurd _ (false-true hx) } ;
} ;

linH' (m n : Nat) (phi : Nat -> Nat)
  (rng : (i : Nat) -> IsT (leb i m) -> IsT (leb (phi i) n))
  (mon : (i j : Nat) -> IsT (leb i j) -> IsT (leb j m) -> IsT (leb (phi i) (phi j))) : Hom (lin m) (lin n) =
  mkHom (lin m) (lin n) LinMap'[m, n, phi, rng, mon].fun LinMap'[m, n, phi, rng, mon].mo ;

strictLin (m n : Nat) (phi : Nat -> Nat)
  (rng : (i : Nat) -> IsT (leb i m) -> IsT (leb (phi i) n))
  (mon : (i j : Nat) -> IsT (leb i j) -> IsT (leb j m) -> IsT (leb (phi i) (phi j)))
  (st : (i j : Nat) -> IsT (leb j m) -> IsT (ltb i j) -> IsT (ltb (phi i) (phi j)))
  : Strict (lin m) (lin n) (linH' m n phi rng mon) = \ s t l -> LinMap'[m, n, phi, rng, mon].str' st s.1 s.2 t.1 t.2 l ;

-- the identity on numbers, between two presentations of the same [c]
idN-rng (c c' : Nat) (e : Id Nat c c') (j : Nat) (hj : IsT (leb j c)) : IsT (leb j c') = substH (\ v -> IsT (leb j v)) e hj ;

idN-mon (c : Nat) (i j : Nat) (hij : IsT (leb i j)) (hj : IsT (leb j c)) : IsT (leb i j) = hij ;

idN (c c' : Nat) (e : Id Nat c c') : Hom (lin c) (lin c') = linH' c c' (\ j -> j) (idN-rng c c' e) (idN-mon c) ;

idN-strict (c c' : Nat) (e : Id Nat c c') : Strict (lin c) (lin c') (idN c c' e) =
  strictLin c c' (\ j -> j) (idN-rng c c' e) (idN-mon c) (\ i j hj h -> h) ;

------------------------------------------------------------------------
-- The values of a map [m] -> [n]

module Vals (m n : Nat) (g : Hom (lin m) (lin n)) {

  aux (i : Nat) : (b : Bool) -> Id Bool (leb i m) b -> Nat = split {
    true -> \ e -> vnum (app (lin m) (lin n) g (leaf i, e)).1 ;
    false -> \ e -> zero } ;

  gam (i : Nat) : Nat = aux i (leb i m) (refl (leb i m)) ;

  aux-eq (i : Nat) (h : IsT (leb i m))
    : (b : Bool) (e : Id Bool (leb i m) b) -> Id Nat (aux i b e) (vnum (app (lin m) (lin n) g (leaf i, h)).1) = split {
    true -> \ e -> apH (\ p -> vnum (app (lin m) (lin n) g (leaf i, p)).1) (isProp-IsT' (leb i m) e h) ;
    false -> \ e -> absurd _ (false-true (transH (symH e) h)) } ;

  gam-eq (i : Nat) (h : IsT (leb i m)) : Id Nat (gam i) (vnum (app (lin m) (lin n) g (leaf i, h)).1) =
    aux-eq i h (leb i m) (refl (leb i m)) ;

  leaf-eq (i : Nat) (h : IsT (leb i m)) : Id Tree (app (lin m) (lin n) g (leaf i, h)).1 (leaf (gam i)) =
    transH (lin-leaf n (app (lin m) (lin n) g (leaf i, h)).1 (app (lin m) (lin n) g (leaf i, h)).2)
           (apH (\ k -> leaf k) (symH (gam-eq i h))) ;

  rng (i : Nat) (h : IsT (leb i m)) : IsT (leb (gam i) n) =
    substH (\ v -> IsT (leb v n)) (symH (gam-eq i h))
           (vnum-range n (app (lin m) (lin n) g (leaf i, h)).1 (app (lin m) (lin n) g (leaf i, h)).2) ;

  gmono (i j : Nat) (hij : IsT (leb i j)) (hj : IsT (leb j m)) : IsT (leb (gam i) (gam j)) =
    substH (\ t -> IsT (le (lin n) t (leaf (gam j)))) (leaf-eq i (leb-trans i j m hij hj))
      (substH (\ t -> IsT (le (lin n) (app (lin m) (lin n) g (leaf i, leb-trans i j m hij hj)).1 t)) (leaf-eq j hj)
        (mono (lin m) (lin n) g (leaf i, leb-trans i j m hij hj) (leaf j, hj) hij)) ;

  gstr (s : Strict (lin m) (lin n) g) (i j : Nat) (hj : IsT (leb j m)) (l : IsT (ltb i j)) : IsT (ltb (gam i) (gam j)) =
    lt-lin (gam i) (gam j)
      (substH (\ t -> IsT (lt (lin n) t (leaf (gam j)))) (leaf-eq i (leb-trans i j m (ltb-leb i j l) hj))
        (substH (\ t -> IsT (lt (lin n) (app (lin m) (lin n) g (leaf i, leb-trans i j m (ltb-leb i j l) hj)).1 t)) (leaf-eq j hj)
          (s (leaf i, leb-trans i j m (ltb-leb i j l) hj) (leaf j, hj) (lin-lt i j l)))) ;
} ;

-- the values of a composite
vals-comp (m' m n : Nat) (g : Hom (lin m) (lin n)) (h : Hom (lin m') (lin m)) (j : Nat) (hj : IsT (leb j m'))
  : Id Nat (Vals[m', n, compH (lin m') (lin m) (lin n) g h].gam j) (Vals[m, n, g].gam (Vals[m', m, h].gam j)) =
  calc Nat {
      Vals[m', n, compH (lin m') (lin m) (lin n) g h].gam j
    =< Vals[m', n, compH (lin m') (lin m) (lin n) g h].gam-eq j hj >
      vnum (app (lin m') (lin n) (compH (lin m') (lin m) (lin n) g h) (leaf j, hj)).1
    =< apH vnum (app-compH1 (lin m') (lin m) (lin n) g h (leaf j, hj)) >
      vnum (app (lin m) (lin n) g (app (lin m') (lin m) h (leaf j, hj))).1
    =< apH (\ z -> vnum (app (lin m) (lin n) g z).1)
         (el-eq (lin m) (app (lin m') (lin m) h (leaf j, hj)) (leaf (Vals[m', m, h].gam j), Vals[m', m, h].rng j hj)
                (Vals[m', m, h].leaf-eq j hj)) >
      vnum (app (lin m) (lin n) g (leaf (Vals[m', m, h].gam j), Vals[m', m, h].rng j hj)).1
    =< symH (Vals[m, n, g].gam-eq (Vals[m', m, h].gam j) (Vals[m', m, h].rng j hj)) >
      Vals[m, n, g].gam (Vals[m', m, h].gam j) } ;

-- the values of a map built from numbers
vals-lin (m n : Nat) (phi : Nat -> Nat)
  (rng : (i : Nat) -> IsT (leb i m) -> IsT (leb (phi i) n))
  (mon : (i j : Nat) -> IsT (leb i j) -> IsT (leb j m) -> IsT (leb (phi i) (phi j))) (j : Nat) (hj : IsT (leb j m))
  : Id Nat (Vals[m, n, linH' m n phi rng mon].gam j) (phi j) = Vals[m, n, linH' m n phi rng mon].gam-eq j hj ;

------------------------------------------------------------------------
-- The cut of a map [n] -> [1]

isZ : Nat -> Bool = split { zero -> true ; suc k -> false } ;

cut (n : Nat) (hv : Nat -> Nat) : Nat = cnt (\ i -> isZ (hv i)) n ;

cutAux : (x y : Nat) -> IsT (leb x y) -> IsT (isZ y) -> IsT (isZ x) = split {
  zero -> \ y l z -> refl true ;
  suc x -> split {
    zero -> \ l z -> absurd _ (false-true l) ;
    suc y -> \ l z -> absurd _ (false-true z) } } ;

module Cut (n : Nat) (h : Hom (lin n) Iv) {
  hv (i : Nat) : Nat = Vals[n, suc zero, h].gam i ;

  a : Nat = cut n hv ;

  ha : IsT (leb a (suc n)) = cnt-le (\ i -> isZ (hv i)) n ;

  dc : DownC (\ i -> isZ (hv i)) n = \ i j hij hj z -> cutAux (hv i) (hv j) (Vals[n, suc zero, h].gmono i j hij hj) z ;

  char (i : Nat) (hi : IsT (leb i n)) : Id Bool (ltb i a) (isZ (hv i)) = cnt-char (\ i1 -> isZ (hv i1)) n dc i hi ;
} ;

-- monotone from strictly monotone
monOfStr (m : Nat) (phi : Nat -> Nat) (str : (i j : Nat) -> IsT (leb j m) -> IsT (ltb i j) -> IsT (ltb (phi i) (phi j)))
  (i j : Nat) (hij : IsT (leb i j)) (hj : IsT (leb j m)) : IsT (leb (phi i) (phi j)) =
  eqN-dec (IsT (leb (phi i) (phi j))) i j (\ e -> substH (\ v -> IsT (leb (phi i) (phi v))) e (leb-refl (phi i)))
          (\ k -> ltb-leb (phi i) (phi j) (str i j hj (leb-neq i j hij k))) ;

------------------------------------------------------------------------
-- The factorisation attached to (f , h) : [n] -> X * [1] and g : [m] -> [n]

module Fac (X : Ob) (n : Nat) (phi : Hom (lin n) (prodP X Iv)) (m : Nat) (g : Hom (lin m) (lin n)) {

  f : Hom (lin n) X = compH (lin n) (prodP X Iv) X (pX X) phi ;

  module C = Cut[n, compH (lin n) (prodP X Iv) Iv (pr2 X Iv) phi] ;

  gv (j : Nat) : Nat = Vals[m, n, g].gam j ;

  module O = OSum[n, C.a, m, gv, C.ha, Vals[m, n, g].rng, Vals[m, n, g].gmono] ;

  k1H : Hom (lin O.c) (lin n) = linH' O.c n O.k1 O.k1-rng O.k1-mono ;
  k2H : Hom (lin m) (lin O.c) = linH' m O.c O.k2 O.k2-rng O.k2-mono ;

  F : Hom (lin O.c) X = compH (lin O.c) (lin n) X f k1H ;

  pw12 : PW (lin m) (lin n) (compH (lin m) (lin O.c) (lin n) k1H k2H) g =
    pwl m (lin n) (compH (lin m) (lin O.c) (lin n) k1H k2H) g
      (\ j h -> transH (app-compH1 (lin m) (lin O.c) (lin n) k1H k2H (leaf j, h))
                 (transH (apH (\ k -> leaf k) (O.k12 j h)) (symH (Vals[m, n, g].leaf-eq j h)))) ;
} ;

------------------------------------------------------------------------
-- The path

module LP (G : PCtx) (A : PTy[G]) {
  open PR.TyL[G, A] ;
  open DD.DT[G, A] ;
  module D2 = DD.DT[G, DA] ;
  module GL = PR.PshL[G] ;

  -- u(F) K is invariant under strictly monotone reparametrisation
  RP (X : Ob) (x : Pt X) (u : DEl X x) (m c c' : Nat)
    (F : Hom (lin c) X) (K : Hom (lin m) (lin c)) (F' : Hom (lin c') X) (K' : Hom (lin m) (lin c'))
    (s : Hom (lin c') (lin c)) (ss : Strict (lin c') (lin c) s)
    (pF : PW (lin c') X F' (compH (lin c') (lin c) X F s))
    (pK : PW (lin m) (lin c) K (compH (lin m) (lin c') (lin c) s K'))
    : Id (EI (lin m)) (E.act (lin m) (lin c') K' (rd X x u.1 c' F')) (E.act (lin m) (lin c) K (rd X x u.1 c F)) =
    transH (apH (E.act (lin m) (lin c') K') (apH (rd X x u.1 c') (hom-eq (lin c') X F' (compH (lin c') (lin c) X F s) pF)))
     (transH (apH (E.act (lin m) (lin c') K') (symH (u.2 c' c s ss F)))
      (transH (PE.actC (lin m) (lin c') (lin c) s K' (rd X x u.1 c F))
              (symH (PE.actEq (lin m) (lin c) K (compH (lin m) (lin c') (lin c) s K') (hom-eq (lin m) (lin c) K (compH (lin m) (lin c') (lin c) s K') pK) (rd X x u.1 c F))))) ;

  DEext (Z : Ob) (z z' : Pt Z) (w : DEl Z z) (w' : DEl Z z') (e : Id (Pt Z) z z')
    (h : (m : Nat) (c : Hom (lin m) Z) -> Id (EI (lin m)) (rd Z z w.1 m c) (rd Z z' w'.1 m c))
    : Id (W0.Ix (ED.ob Z)) (z, w) (z', w') =
    idJ (Pt Z) z
      (\ z2 e2 -> (w2 : DEl Z z2) -> ((m : Nat) (c : Hom (lin m) Z) -> Id (EI (lin m)) (rd Z z w.1 m c) (rd Z z2 w2.1 m c))
         -> Id (W0.Ix (ED.ob Z)) (z, w) (z2, w2))
      (\ w2 h2 -> apH {DEl Z z} (\ v -> (z, v)) (Dext Z z w w2 h2)) z' e w' h ;

  DE2ext (Z : Ob) (z z' : Pt Z) (w : D2.DEl Z z) (w' : D2.DEl Z z') (e : Id (Pt Z) z z')
    (h : (n : Nat) (c : Hom (lin n) Z) -> Id (W0.Ix (ED.ob (lin n))) (D2.rd Z z w.1 n c) (D2.rd Z z' w'.1 n c))
    : Id (W0.Ix (D2.ED.ob Z)) (z, w) (z', w') =
    idJ (Pt Z) z
      (\ z2 e2 -> (w2 : D2.DEl Z z2) -> ((n : Nat) (c : Hom (lin n) Z) -> Id (W0.Ix (ED.ob (lin n))) (D2.rd Z z w.1 n c) (D2.rd Z z2 w2.1 n c))
         -> Id (W0.Ix (D2.ED.ob Z)) (z, w) (z2, w2))
      (\ w2 h2 -> apH {D2.DEl Z z} (\ v -> (z, v)) (D2.Dext Z z w w2 h2)) z' e w' h ;

  module At (X : Ob) (x : Pt X) (u : DEl X x) {

    rho' : Pt (prodP X Iv) = G.act (prodP X Iv) X (pX X) x ;

    module RAt (n : Nat) (phi : Hom (lin n) (prodP X Iv)) (m : Nat) (g : Hom (lin m) (lin n)) {
      module Fc = Fac[X, n, phi, m, g] ;

      R : EI (lin m) = E.act (lin m) (lin Fc.O.c) Fc.k2H (rd X x u.1 Fc.O.c Fc.F) ;

      R-def : Id (EI (lin m)) R (E.act (lin m) (lin Fc.O.c) Fc.k2H (rd X x u.1 Fc.O.c Fc.F)) = refl R ;

      eqR : Id (Pt (lin m)) R.1 (G.act (lin m) (lin n) g (G.act (lin n) (prodP X Iv) phi rho')) =
        transH (GL.actC (lin m) (lin Fc.O.c) X Fc.F Fc.k2H x)
         (transH (apH (\ k -> G.act (lin m) X k x) (comp-assoc (lin m) (lin Fc.O.c) (lin n) X Fc.f Fc.k1H Fc.k2H))
         (transH (GL.actEq (lin m) X (compH (lin m) (lin n) X Fc.f (compH (lin m) (lin Fc.O.c) (lin n) Fc.k1H Fc.k2H)) (compH (lin m) (lin n) X Fc.f g) (hom-eq (lin m) X (compH (lin m) (lin n) X Fc.f (compH (lin m) (lin Fc.O.c) (lin n) Fc.k1H Fc.k2H)) (compH (lin m) (lin n) X Fc.f g) (pw-post (lin m) (lin n) X (compH (lin m) (lin Fc.O.c) (lin n) Fc.k1H Fc.k2H) g Fc.f Fc.pw12)) x)
                 (symH (transH (apH (G.act (lin m) (lin n) g) (GL.actC (lin n) (prodP X Iv) X (pX X) phi x))
                               (GL.actC (lin m) (lin n) X Fc.f g x))))) ;

      opaque R ;
    } ;

    R (n : Nat) (phi : Hom (lin n) (prodP X Iv)) (m : Nat) (g : Hom (lin m) (lin n)) : EI (lin m) = RAt[n, phi, m, g].R ;

    -- the family, and its reading; opaque, so that it is never unfolded
    vfam (n : Nat) (phi : Hom (lin n) (prodP X Iv)) : Fam (lin n) (G.act (lin n) (prodP X Iv) phi rho') = \ m g ->
      coeT (lin m) _ _ RAt[n, phi, m, g].eqR (R n phi m g).2 ;

    valE (n : Nat) (phi : Hom (lin n) (prodP X Iv)) (m : Nat) (g : Hom (lin m) (lin n))
      : Id (EI (lin m)) (rd (lin n) (G.act (lin n) (prodP X Iv) phi rho') (vfam n phi) m g) (R n phi m g) =
      symH (pr-coe (lin m) _ _ RAt[n, phi, m, g].eqR (R n phi m g).2) ;

    opaque vfam ; opaque valE ;

    module ID (n : Nat) (phi : Hom (lin n) (prodP X Iv)) (m' m : Nat) (h' : Hom (lin m') (lin m))
      (sh : Strict (lin m') (lin m) h') (g : Hom (lin m) (lin n)) {
      module F1 = Fac[X, n, phi, m, g] ;
      module F2 = Fac[X, n, phi, m', compH (lin m') (lin m) (lin n) g h'] ;
      module I = Inner[n, F1.C.a, m, m', F1.gv, Vals[m', m, h'].gam, F1.C.ha, Vals[m, n, g].rng, Vals[m, n, g].gmono,
                       Vals[m', m, h'].rng, Vals[m', m, h'].gstr sh,
                       Vals[m', n, compH (lin m') (lin m) (lin n) g h'].gam, vals-comp m' m n g h'] ;

      sH : Hom (lin F2.O.c) (lin F1.O.c) = linH' F2.O.c F1.O.c I.s I.s-rng (monOfStr F2.O.c I.s I.s-str) ;

      sS : Strict (lin F2.O.c) (lin F1.O.c) sH = strictLin F2.O.c F1.O.c I.s I.s-rng (monOfStr F2.O.c I.s I.s-str) I.s-str ;

      pk1 : PW (lin F2.O.c) (lin n) F2.k1H (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H sH) =
        pwl F2.O.c (lin n) F2.k1H (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H sH)
          (\ j h -> transH (apH (\ k -> leaf k) (symH (I.s-k1 j h)))
                           (symH (app-compH1 (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H sH (leaf j, h)))) ;

      -- f k1' = f (k1 s) = (f k1) s
      pF : PW (lin F2.O.c) X F2.F (compH (lin F2.O.c) (lin F1.O.c) X F1.F sH) =
        pw-trans (lin F2.O.c) X F2.F (compH (lin F2.O.c) (lin n) X F1.f (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H sH))
                 (compH (lin F2.O.c) (lin F1.O.c) X F1.F sH)
          (pw-post (lin F2.O.c) (lin n) X F2.k1H (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H sH) F1.f pk1)
          (pw-of-eq (lin F2.O.c) X _ _ (symH (comp-assoc (lin F2.O.c) (lin F1.O.c) (lin n) X F1.f F1.k1H sH))) ;

      pK : PW (lin m') (lin F1.O.c) (compH (lin m') (lin m) (lin F1.O.c) F1.k2H h') (compH (lin m') (lin F2.O.c) (lin F1.O.c) sH F2.k2H) =
        pwl m' (lin F1.O.c) (compH (lin m') (lin m) (lin F1.O.c) F1.k2H h') (compH (lin m') (lin F2.O.c) (lin F1.O.c) sH F2.k2H)
          (\ j h -> calc Tree {
              (app (lin m') (lin F1.O.c) (compH (lin m') (lin m) (lin F1.O.c) F1.k2H h') (leaf j, h)).1
            =< app-compH1 (lin m') (lin m) (lin F1.O.c) F1.k2H h' (leaf j, h) >
              (app (lin m) (lin F1.O.c) F1.k2H (app (lin m') (lin m) h' (leaf j, h))).1
            =< apH (\ z -> (app (lin m) (lin F1.O.c) F1.k2H z).1)
                 (el-eq (lin m) (app (lin m') (lin m) h' (leaf j, h)) (leaf (Vals[m', m, h'].gam j), Vals[m', m, h'].rng j h)
                        (Vals[m', m, h'].leaf-eq j h)) >
              leaf (I.O.k2 (Vals[m', m, h'].gam j))
            =< apH (\ k -> leaf k) (I.s-k2 j h) >
              leaf (I.s (I.O'.k2 j))
            =< symH (app-compH1 (lin m') (lin F2.O.c) (lin F1.O.c) sH F2.k2H (leaf j, h)) >
              (app (lin m') (lin F1.O.c) (compH (lin m') (lin F2.O.c) (lin F1.O.c) sH F2.k2H) (leaf j, h)).1 }) ;

      rp : Id (EI (lin m')) (E.act (lin m') (lin F2.O.c) F2.k2H (rd X x u.1 F2.O.c F2.F))
                            (E.act (lin m') (lin F1.O.c) (compH (lin m') (lin m) (lin F1.O.c) F1.k2H h') (rd X x u.1 F1.O.c F1.F)) =
        RP X x u m' F1.O.c F2.O.c F1.F (compH (lin m') (lin m) (lin F1.O.c) F1.k2H h') F2.F F2.k2H sH sS pF pK ;

      inner : Id (EI (lin m')) (E.act (lin m') (lin m) h' (rd (lin n) (G.act (lin n) (prodP X Iv) phi rho') (vfam n phi) m g))
                               (rd (lin n) (G.act (lin n) (prodP X Iv) phi rho') (vfam n phi) m' (compH (lin m') (lin m) (lin n) g h')) =
        transH (apH (E.act (lin m') (lin m) h') (transH (valE n phi m g) RAt[n, phi, m, g].R-def))
         (transH (PE.actC (lin m') (lin m) (lin F1.O.c) F1.k2H h' (rd X x u.1 F1.O.c F1.F))
          (transH (symH rp)
                  (symH (transH (valE n phi m' (compH (lin m') (lin m) (lin n) g h')) RAt[n, phi, m', compH (lin m') (lin m) (lin n) g h'].R-def)))) ;
    } ;

    -- the condition inside: restriction along a strictly monotone h'
    inner (n : Nat) (phi : Hom (lin n) (prodP X Iv)) : Compat (lin n) (G.act (lin n) (prodP X Iv) phi rho') (vfam n phi) =
      \ m' m h' sh g -> ID[n, phi, m', m, h', sh, g].inner ;

    opaque inner ;

    vD (n : Nat) (phi : Hom (lin n) (prodP X Iv)) : DEl (lin n) (G.act (lin n) (prodP X Iv) phi rho') = (vfam n phi, inner n phi) ;

    -- the condition outside: precomposition with a strictly monotone g''
    module OR (n' n : Nat) (g'' : Hom (lin n') (lin n)) (sg : Strict (lin n') (lin n) g'')
      (phi : Hom (lin n) (prodP X Iv)) (m : Nat) (k : Hom (lin m) (lin n')) {
      module F1 = Fac[X, n, phi, m, compH (lin m) (lin n') (lin n) g'' k] ;
      module F2 = Fac[X, n', compH (lin n') (lin n) (prodP X Iv) phi g'', m, k] ;

      achar (i : Nat) (hi : IsT (leb i n')) : Id Bool (ltb i F2.C.a) (ltb (Vals[n', n, g''].gam i) F1.C.a) =
        transH (F2.C.char i hi)
         (transH (apH (\ k -> isZ (Vals[n', suc zero, k].gam i))
                      (symH (comp-assoc (lin n') (lin n) (prodP X Iv) Iv (pr2 X Iv) phi g'')))
         (transH (apH isZ (vals-comp n' n (suc zero) (compH (lin n) (prodP X Iv) Iv (pr2 X Iv) phi) g'' i hi))
                 (symH (F1.C.char (Vals[n', n, g''].gam i) (Vals[n', n, g''].rng i hi))))) ;

      module Ou = Outer[n, n', F1.C.a, F2.C.a, m, Vals[n', n, g''].gam, Vals[m, n', k].gam, F1.C.ha, F2.C.ha,
                        Vals[n', n, g''].rng, Vals[n', n, g''].gstr sg, achar, Vals[m, n', k].rng, Vals[m, n', k].gmono,
                        Vals[m, n, compH (lin m) (lin n') (lin n) g'' k].gam, vals-comp m n' n g'' k] ;

      tH : Hom (lin F2.O.c) (lin F1.O.c) = linH' F2.O.c F1.O.c Ou.t Ou.t-rng (monOfStr F2.O.c Ou.t Ou.t-str) ;

      tS : Strict (lin F2.O.c) (lin F1.O.c) tH = strictLin F2.O.c F1.O.c Ou.t Ou.t-rng (monOfStr F2.O.c Ou.t Ou.t-str) Ou.t-str ;

      pg : PW (lin F2.O.c) (lin n) (compH (lin F2.O.c) (lin n') (lin n) g'' F2.k1H) (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H tH) =
        pwl F2.O.c (lin n) (compH (lin F2.O.c) (lin n') (lin n) g'' F2.k1H) (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H tH)
          (\ j h -> transH (app-compH1 (lin F2.O.c) (lin n') (lin n) g'' F2.k1H (leaf j, h))
                   (transH (Vals[n', n, g''].leaf-eq (F2.O.k1 j) (F2.O.k1-rng j h))
                   (transH (apH (\ q -> leaf q) (Ou.t-k1 j h))
                           (symH (app-compH1 (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H tH (leaf j, h)))))) ;

      -- the map underlying phi g'' is f g'', so  F2 = f (g'' k1') ~ f (k1 t) = F1 t
      f-res : Id (Hom (lin n') X) F2.f (compH (lin n') (lin n) X F1.f g'') =
        symH (comp-assoc (lin n') (lin n) (prodP X Iv) X (pX X) phi g'') ;

      pF : PW (lin F2.O.c) X F2.F (compH (lin F2.O.c) (lin F1.O.c) X F1.F tH) =
        pw-trans (lin F2.O.c) X F2.F (compH (lin F2.O.c) (lin n) X F1.f (compH (lin F2.O.c) (lin n') (lin n) g'' F2.k1H))
                 (compH (lin F2.O.c) (lin F1.O.c) X F1.F tH)
          (pw-of-eq (lin F2.O.c) X _ _
             (transH (apH (\ k -> compH (lin F2.O.c) (lin n') X k F2.k1H) f-res)
                     (comp-assoc (lin F2.O.c) (lin n') (lin n) X F1.f g'' F2.k1H)))
          (pw-trans (lin F2.O.c) X _ (compH (lin F2.O.c) (lin n) X F1.f (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H tH)) _
             (pw-post (lin F2.O.c) (lin n) X (compH (lin F2.O.c) (lin n') (lin n) g'' F2.k1H)
                      (compH (lin F2.O.c) (lin F1.O.c) (lin n) F1.k1H tH) F1.f pg)
             (pw-of-eq (lin F2.O.c) X _ _ (symH (comp-assoc (lin F2.O.c) (lin F1.O.c) (lin n) X F1.f F1.k1H tH)))) ;

      pK : PW (lin m) (lin F1.O.c) F1.k2H (compH (lin m) (lin F2.O.c) (lin F1.O.c) tH F2.k2H) =
        pwl m (lin F1.O.c) F1.k2H (compH (lin m) (lin F2.O.c) (lin F1.O.c) tH F2.k2H)
          (\ j h -> transH (apH (\ q -> leaf q) (symH (Ou.t-k2 j h)))
                           (symH (app-compH1 (lin m) (lin F2.O.c) (lin F1.O.c) tH F2.k2H (leaf j, h)))) ;

      res : Id (EI (lin m)) (R n phi m (compH (lin m) (lin n') (lin n) g'' k)) (R n' (compH (lin n') (lin n) (prodP X Iv) phi g'') m k) =
        transH RAt[n, phi, m, compH (lin m) (lin n') (lin n) g'' k].R-def
         (transH (symH (RP X x u m F1.O.c F2.O.c F1.F F1.k2H F2.F F2.k2H tH tS pF pK))
                 (symH RAt[n', compH (lin n') (lin n) (prodP X Iv) phi g'', m, k].R-def)) ;
    } ;

    outerR (n' n : Nat) (g'' : Hom (lin n') (lin n)) (sg : Strict (lin n') (lin n) g'')
      (phi : Hom (lin n) (prodP X Iv)) (m : Nat) (k : Hom (lin m) (lin n'))
      : Id (EI (lin m)) (R n phi m (compH (lin m) (lin n') (lin n) g'' k)) (R n' (compH (lin n') (lin n) (prodP X Iv) phi g'') m k) =
      OR[n', n, g'', sg, phi, m, k].res ;

    opaque outerR ;

    outer : D2.Compat (prodP X Iv) rho' vD = \ n' n g'' sg phi ->
      DEext (lin n') (G.act (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho'))
            (G.act (lin n') (prodP X Iv) (compH (lin n') (lin n) (prodP X Iv) phi g'') rho')
            (dtact (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho') (G.act (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho'))
                   (refl (G.act (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho'))) (vD n phi))
            (vD n' (compH (lin n') (lin n) (prodP X Iv) phi g''))
            (GL.actC (lin n') (lin n) (prodP X Iv) phi g'' rho')
            (\ m k -> transH (rd-dtact (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho')
                               (G.act (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho'))
                               (refl (G.act (lin n') (lin n) g'' (G.act (lin n) (prodP X Iv) phi rho'))) (vD n phi) m k)
                       (transH (valE n phi m (compH (lin m) (lin n') (lin n) g'' k))
                        (transH (outerR n' n g'' sg phi m k)
                                (symH (valE n' (compH (lin n') (lin n) (prodP X Iv) phi g'') m k))))) ;

    -- the path
    pathD : D2.DEl (prodP X Iv) rho' = (vD, outer) ;
  } ;
} ;
