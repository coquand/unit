-- CDSurj.seg (L8, Delta): seg/model DSurj.seg ported (module names only).  Was: on Delta a surjection has a section (the first preimage), so
-- a sieve containing a surjective map contains the identity.  Hence a
-- decidable sieve without the identity lies in the boundary (in-bd).
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DS = DBm.DS ;
module DPm = CDPrism[a] ;
open CDCapBase[a] ;
open CDCapT[a] ;

------------------------------------------------------------------------
-- the first v <= W with P v

first : Nat -> (Nat -> Bool) -> Nat = split {
  zero -> \ P -> zero ;
  suc W | ih-W -> \ P -> ifB (P zero) zero (suc (ih-W (\ v -> P (suc v)))) } ;

first-le : (W : Nat) (P : Nat -> Bool) -> IsT (leb (first W P) W) = split {
  zero -> \ P -> refl true ;
  suc W | ih-W -> \ P -> bcase (IsT (leb (first (suc W) P) (suc W))) (P zero)
    (\ t -> substH (\ x -> IsT (leb x (suc W))) (symH (ifB-t (P zero) zero (suc (first W (\ v -> P (suc v)))) t)) (refl true))
    (\ f -> substH (\ x -> IsT (leb x (suc W))) (symH (ifB-f (P zero) zero (suc (first W (\ v -> P (suc v)))) f))
               (ih-W (\ v -> P (suc v)))) } ;

-- if some v <= W has P v, the first one has P and is below v
first-spec : (W : Nat) (P : Nat -> Bool) (v : Nat) -> IsT (leb v W) -> IsT (P v)
  -> IsT (P (first W P)) * IsT (leb (first W P) v) = split {
  zero -> \ P v hv pv -> (substH (\ x -> IsT (P x)) (leb-zero v hv) pv, refl true) ;
  suc W | ih-W -> \ P v hv pv -> bcase (IsT (P (first (suc W) P)) * IsT (leb (first (suc W) P) v)) (P zero)
    (\ t -> substH (\ x -> IsT (P x) * IsT (leb x v)) (symH (ifB-t (P zero) zero (suc (first W (\ v' -> P (suc v')))) t)) (t, refl true))
    (\ f -> substH (\ x -> IsT (P x) * IsT (leb x v)) (symH (ifB-f (P zero) zero (suc (first W (\ v' -> P (suc v')))) f))
              (sucCase W P f ih-W v hv pv)) }
 where { sucCase (W : Nat) (P : Nat -> Bool) (f : Id Bool (P zero) false)
           (ih : (P' : Nat -> Bool) (v' : Nat) -> IsT (leb v' W) -> IsT (P' v') -> IsT (P' (first W P')) * IsT (leb (first W P') v'))
           : (v : Nat) -> IsT (leb v (suc W)) -> IsT (P v)
           -> IsT (P (suc (first W (\ v' -> P (suc v'))))) * IsT (leb (suc (first W (\ v' -> P (suc v')))) v) = split {
           zero -> \ hv pv -> absurd _ (false-true (transH (symH f) pv)) ;
           suc v -> \ hv pv -> ih (\ v' -> P (suc v')) v hv pv } ; } ;

-- a false forall has a counterexample
fa-false : (W : Nat) (P : Nat -> Bool) -> Id Bool (forallUp W P) false -> (v : Nat) * (IsT (leb v W) * Id Bool (P v) false) = split {
  zero -> \ P h -> (zero, (refl true, h)) ;
  suc W | ih-W -> \ P h -> bcase ((v : Nat) * (IsT (leb v (suc W)) * Id Bool (P v) false)) (P (suc W))
    (\ t -> ((ih-W P (andFl (forallUp W P) (P (suc W)) h t)).1,
             (leb-step (ih-W P (andFl (forallUp W P) (P (suc W)) h t)).1 W (ih-W P (andFl (forallUp W P) (P (suc W)) h t)).2.1,
              (ih-W P (andFl (forallUp W P) (P (suc W)) h t)).2.2)))
    (\ f -> (suc W, (leb-refl W, f))) }
 where { andFl : (x y : Bool) -> Id Bool (and x y) false -> IsT y -> Id Bool x false = split {
           true -> \ y h t -> absurd _ (false-true (transH (symH h) t)) ;
           false -> \ y h t -> refl false } ; } ;

------------------------------------------------------------------------
-- the section of a surjection

module Sec (W N : Nat) (f : Hom (lin W) (lin N)) (nb : Id Bool (bdB N W f) false) {
  P (y : Nat) (v : Nat) : Bool = eqN (valT W N f v) y ;

  -- every y <= N is hit
  hit (y : Nat) (hy : IsT (leb y N)) : (v : Nat) * (IsT (leb v W) * IsT (P y v)) =
    bcase ((v : Nat) * (IsT (leb v W) * IsT (P y v))) (missB W N f y)
      (\ m -> absurd _ (false-true (transH (symH nb) (ex-i N (\ y' -> missB W N f y') y hy m))))
      (\ m -> ((fa-false W (\ v -> not (eqN (valT W N f v) y)) m).1,
               ((fa-false W (\ v -> not (eqN (valT W N f v) y)) m).2.1,
                notF (eqN (valT W N f (fa-false W (\ v -> not (eqN (valT W N f v) y)) m).1) y)
                     (fa-false W (\ v -> not (eqN (valT W N f v) y)) m).2.2)))
   where { notF : (b : Bool) -> Id Bool (not b) false -> IsT b = split { true -> \ h -> refl true ; false -> \ h -> absurd _ (false-true (symH h)) } ; } ;

  sg (y : Nat) : Nat = first W (P y) ;

  sg-le (y : Nat) : IsT (leb (sg y) W) = first-le W (P y) ;

  sg-val (y : Nat) (hy : IsT (leb y N)) : Id Nat (valT W N f (sg y)) y =
    eqN-sound (valT W N f (sg y)) y (first-spec W (P y) (hit y hy).1 (hit y hy).2.1 (hit y hy).2.2).1 ;

  sg-min (y : Nat) (v : Nat) (hv : IsT (leb v W)) (pv : IsT (P y v)) : IsT (leb (sg y) v) = (first-spec W (P y) v hv pv).2 ;

  -- clamped to [0 , N], monotone
  sgC (y : Nat) : Nat = sg (clampN N y) ;

  sgC-mono (y y' : Nat) (l : IsT (leb y y')) : IsT (leb (sgC y) (sgC y')) =
    ltb-dec (IsT (leb (sgC y) (sgC y'))) (sgC y') (sgC y)
      (\ lt -> absurd _ (ltb-irr (sgC y') (substH (\ x -> IsT (ltb (sgC y') x)) (sg-eq lt) lt)))
      (\ ge -> ge)
   where {
     -- if sg y' < sg y then f (sg y') <= f (sg y), so y' <= y, so y = y' (clamped) and sg y = sg y'
     sg-eq (lt : IsT (ltb (sgC y') (sgC y))) : Id Nat (sgC y) (sgC y') =
       apH sg (le-antisym (clampN N y) (clampN N y') (clamp-mono N y y' l)
         (substH (\ x -> IsT (leb (clampN N y') x)) (sg-val (clampN N y) (clamp-ok N y))
           (substH (\ x -> IsT (leb x (valT W N f (sgC y)))) (sg-val (clampN N y') (clamp-ok N y'))
              (valT-mono W N f (sgC y') (sgC y) (ltb-leb (sgC y') (sgC y) lt))))) ; } ;

  sigma : Hom (lin N) (lin W) = linH N W sgC (\ y hy -> sg-le (clampN N y)) sgC-mono ;

  sec : Id (Hom (lin N) (lin N)) (compH (lin N) (lin W) (lin N) f sigma) (idH (lin N)) =
    hom-eq (lin N) (lin N) (compH (lin N) (lin W) (lin N) f sigma) (idH (lin N))
      (pwl N (lin N) (compH (lin N) (lin W) (lin N) f sigma) (idH (lin N)) (\ y hy ->
         transH (app-compH1 (lin N) (lin W) (lin N) f sigma (leaf y, hy))
           (transH (valT-tree W N f (sgC y) (sg-le (clampN N y)))
             (transH (lf (valT W N f (sgC y)) y (transH (sg-val (clampN N y) (clamp-ok N y)) (clamp-eq N y hy))) (symH (app-idH1 (lin N) (leaf y, hy))))))) ;
} ;

-- a map in a sieve without the identity is not surjective
in-bd (N W : Nat) (Q : DS.Phi N) (f : Hom (lin W) (lin N)) (i : DS.Lands W N Q f) (nf : Id Bool (Q.1 N (idH (lin N))) false)
  : IsT (bdB N W f) =
  bcase (IsT (bdB N W f)) (bdB N W f) (\ t -> t)
    (\ nb -> absurd _ (false-true (transH (symH nf)
               (substH (\ k -> IsT (Q.1 N k)) (Sec[W, N, f, nb].sec) (Q.2 N W f Sec[W, N, f, nb].sigma i))))) ;
