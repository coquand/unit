-- CPathProb.seg (L3, inside CB, level l): the composition problem of a
-- path type over a line (CPath.PathOverE), at a path coordinate i : W -> I,
-- as a problem for A at W (model.tex Thm "type formers": Path).
--
-- A problem at W for the path type: a point xh (a line in K with a path p
-- at its end e) and one side P; and a path coordinate i : W -> I.
--   x'    the line in H  (g , j) |-> s (xh (g , j)) (id , i g), with the
--         value p (id , i) at e
--   B0    on (i = src dd): the end aE along the K-line
--   B1    on (i = tgt dd): the end bE along the K-line
--   SL    on P: the paths of P evaluated at the path coordinate
--   side  their join (B0 , B1 disjoint; P's paths have the ends aE , bE)
--
-- Quarry: seg/model GPathProb (one side for P, a join of three).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PathPr (K H : PCtx) (A : PTy[H]) (dd : Bool)
  (s : (X : Ob) -> W0.Ix (K.ob X) -> (W : Ob) -> Hom W X -> Hom W Iv -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : Hom W Iv) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (sF : (X : Ob) (y : W0.Ix (K.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Hom W Iv)
        -> Id (W0.Ix (H.ob V)) (H.act V W g (s X y W f i)) (s X y V (compH V W X f g) (compH V W Iv i g)))
  (aE bE : (W : Ob) -> W0.Ix (K.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (K.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (K.act W X f x)))
  (aE-pt : (W : Ob) (y : W0.Ix (K.ob W)) -> Id (W0.Ix (H.ob W)) (aE W y).1 (s W y W (idH W) (ptH W (src dd))))
  (bE-pt : (W : Ob) (y : W0.Ix (K.ob W)) -> Id (W0.Ix (H.ob W)) (bE W y).1 (s W y W (idH W) (ptH W (tgt dd))))
  (e : IPt) {
  module PT = CPath[l].PathOverE[K, H, A, dd, s, sN, aE, bE, aE-act, bE-act] ;
  module FG = CLine[l].FC[H] ;
  module FK = CLine[l].FC[K] ;
  module FA = CLine[l].FT[H, A] ;
  module CA = CLine[l].EndKit[H, A, e] ;
  module CP = CLine[l].EndKit[K, PT.PathP, e] ;
  module EVA = FA.Ev[e] ;
  module EVP = CLine[l].FT[K, PT.PathP].Ev[e] ;
  module TA = PT.TA ;
  module TP = PT.TP ;

  -- the value of the line of an element of the fibres of the path type
  lvP (V : Ob) (u : CP.TS.EI V) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv) : TP.EI V' = (CP.lineL V u).2.1.1 V' g' j ;

  lvP-pt (V : Ob) (u : CP.TS.EI V) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
    : Id (W0.Ix (K.ob V')) (lvP V u V' g' j).1 ((CP.lineL V u).1.1 V' g' j) =
    apH (\ y -> y.1 V' g' j) (CP.lineL V u).2.2 ;

  -- s at equal points and equal path coordinates
  sEq (W : Ob) (y y' : W0.Ix (K.ob W)) (P : Id (W0.Ix (K.ob W)) y y') (i i' : Hom W Iv) (Q : Id (Hom W Iv) i i')
    : Id (W0.Ix (H.ob W)) (s W y W (idH W) i) (s W y' W (idH W) i') =
    transH (apH (\ z -> s W z W (idH W) i) P) (apH (\ k -> s W y' W (idH W) k) Q) ;

  -- s y (f , i) is s (y f) (id , i)
  sAt (X : Ob) (y : W0.Ix (K.ob X)) (W : Ob) (f : Hom W X) (i : Hom W Iv)
    : Id (W0.Ix (H.ob W)) (s X y W f i) (s W (K.act W X f y) W (idH W) i) =
    transH (apH (\ k -> s X y W k i) (symH (comp-idr W X f))) (sN W X f y (K.act W X f y) (refl (K.act W X f y)) W (idH W) i) ;

  -- a line in H read at the path coordinate c from a line k in K
  module RdL (W : Ob) (k : W0.Ix (FK.ob W)) (c : Hom W Iv) {
    v (V : Ob) (g : Hom V W) (j : Hom V Iv) : W0.Ix (H.ob V) = s V (k.1 V g j) V (idH V) (compH V W Iv c g) ;

    vn (V' V : Ob) (g' : Hom V' V) (g : Hom V W) (j : Hom V Iv)
      : Id (W0.Ix (H.ob V')) (H.act V' V g' (v V g j)) (v V' (compH V' V W g g') (compH V' V Iv j g')) =
      calc (W0.Ix (H.ob V')) {
          H.act V' V g' (s V (k.1 V g j) V (idH V) (compH V W Iv c g))
        =< sF V (k.1 V g j) V' V g' (idH V) (compH V W Iv c g) >
          s V (k.1 V g j) V' (compH V' V V (idH V) g') (compH V' V Iv (compH V W Iv c g) g')
        =< apH (\ h -> s V (k.1 V g j) V' h (compH V' V Iv (compH V W Iv c g) g')) (transH (comp-idl V' V g') (symH (comp-idr V' V g'))) >
          s V (k.1 V g j) V' (compH V' V' V g' (idH V')) (compH V' V Iv (compH V W Iv c g) g')
        =< sN V' V g' (k.1 V g j) (k.1 V' (compH V' V W g g') (compH V' V Iv j g')) (k.2 V' V g' g j) V' (idH V') (compH V' V Iv (compH V W Iv c g) g') >
          s V' (k.1 V' (compH V' V W g g') (compH V' V Iv j g')) V' (idH V') (compH V' V Iv (compH V W Iv c g) g')
        =< apH (\ h -> s V' (k.1 V' (compH V' V W g g') (compH V' V Iv j g')) V' (idH V') h) (comp-assoc V' V W Iv c g g') >
          s V' (k.1 V' (compH V' V W g g') (compH V' V Iv j g')) V' (idH V') (compH V' W Iv c (compH V' V W g g')) } ;

    line : W0.Ix (FG.ob W) = (v, vn) ;
  } ;

  module Prob (W : Ob) (xh : CP.TV.EI W) (P : CP.PT.Side[W, xh]) (i : Hom W Iv) {
    p : W0.Ix (PT.tobP W ((FK.ev e).nt W xh.1)) = xh.2 ;
    y0 : W0.Ix (K.ob W) = (FK.ev e).nt W xh.1 ;

    -- the K-line of the problem, and the line in H
    kW : W0.Ix (FK.ob W) = xh.1 ;
    kL (V : Ob) (g : Hom V W) (j : Hom V Iv) : W0.Ix (K.ob V) = kW.1 V g j ;
    gW : W0.Ix (FG.ob W) = RdL[W, kW, i].line ;

    qx : Id (W0.Ix (H.ob W)) (p.1.1 W (idH W) i).1 ((FG.ev e).nt W gW) =
      transH (p.2.1 W (idH W) i) (apH (\ k -> s W y0 W (idH W) k) (symH (comp-idr W Iv i))) ;

    x' : CA.TV.EI W = (gW, TA.coeT W (p.1.1 W (idH W) i).1 ((FG.ev e).nt W gW) qx (p.1.1 W (idH W) i).2) ;

    x'-E : Id (TA.EI W) (CA.endE W x') (p.1.1 W (idH W) i) =
      symH (TA.pr-coe W (p.1.1 W (idH W) i).1 ((FG.ev e).nt W gW) qx (p.1.1 W (idH W) i).2) ;

    -- the end of x' restricted, as a value of p
    endP (V : Ob) (g : Hom V W)
      : Id (TA.EI V) (CA.endE V (CA.TV.E.act V W g x')) (p.1.1 V g (compH V W Iv i g)) =
      transH (CA.endE-act V W g x')
        (transH (apH (TA.E.act V W g) x'-E)
          (transH (p.1.2 V W g (idH W) i) (apH (\ k -> p.1.1 V k (compH V W Iv i g)) (comp-idl V W g)))) ;

    -- the points of all sides: x' restricted
    ptN (V' V : Ob) (g : Hom V' V) (f2 : Hom V W) (u : CA.TS.EI V) (u' : CA.TS.EI V')
      (pu : Id (CA.TV.EI V) u.1 (CA.TV.E.act V W f2 x')) (pu' : Id (CA.TV.EI V') u'.1 (CA.TV.E.act V' W (compH V' V W f2 g) x'))
      : Id (CA.TV.EI V') (CA.TS.E.act V' V g u).1 u'.1 =
      transH (apH (CA.TV.E.act V' V g) pu) (transH (CA.TV.PE.actC V' V W f2 g x') (symH pu')) ;

    -- the path coordinate of a side at (V , g) then (V' , g')
    ic (V : Ob) (g : Hom V W) (V' : Ob) (g' : Hom V' V) : Hom V' Iv = compH V' V Iv (compH V W Iv i g) g' ;

    cAss (V' V : Ob) (g : Hom V' V) (f2 : Hom V W) (V'' : Ob) (g' : Hom V'' V')
      : Id (Hom V'' Iv) (ic V' (compH V' V W f2 g) V'' g') (ic V f2 V'' (compH V'' V' V g g')) =
      calc (Hom V'' Iv) {
          compH V'' V' Iv (compH V' W Iv i (compH V' V W f2 g)) g'
        =< comp-assoc V'' V' W Iv i (compH V' V W f2 g) g' >
          compH V'' W Iv i (compH V'' V' W (compH V' V W f2 g) g')
        =< apH (\ k -> compH V'' W Iv i k) (comp-assoc V'' V' V W f2 g g') >
          compH V'' W Iv i (compH V'' V W f2 (compH V'' V' V g g'))
        =< symH (comp-assoc V'' V W Iv i f2 (compH V'' V' V g g')) >
          compH V'' V Iv (compH V W Iv i f2) (compH V'' V' V g g') } ;

    -- on {i g = eb}, the path coordinate at (V' , g g') is eb
    icPt (eb : IPt) (V : Ob) (g : Hom V W) (h : Lands V W (pre W Iv i (ptS eb)) g) (V' : Ob) (g' : Hom V' V)
      : Id (Hom V' Iv) (compH V' W Iv i (compH V' V W g g')) (ptH V' eb) =
      transH (symH (comp-assoc V' V W Iv i g g'))
        (transH (apH (\ k -> compH V' V Iv k g') (lands-pt V eb (compH V W Iv i g) (lands-pre V W Iv i (ptS eb) g h)))
                (ptH-nat V' V g' eb)) ;

    -- the values of the line of a side's element
    lv (S : CA.PT.Side[W, x']) (V : Ob) (g : Hom V W) (h : Lands V W S.pQ g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv) : TA.EI V' =
      (CA.lineL V (S.pv V g h)).2.1.1 V' g' j ;

    --------------------------------------------------------------------
    -- a side on {i = eb}: the end cE along the K-line

    module BS (eb : IPt) (cE : (V : Ob) -> W0.Ix (K.ob V) -> TA.EI V)
      (cE-eq : (V : Ob) (y y' : W0.Ix (K.ob V)) -> Id (W0.Ix (K.ob V)) y y' -> Id (TA.EI V) (cE V y) (cE V y'))
      (cE-act : (V' V : Ob) (g : Hom V' V) (y : W0.Ix (K.ob V)) -> Id (TA.EI V') (TA.E.act V' V g (cE V y)) (cE V' (K.act V' V g y)))
      (cE-pt : (V : Ob) (y : W0.Ix (K.ob V)) -> Id (W0.Ix (H.ob V)) (cE V y).1 (s V y V (idH V) (ptH V eb)))
      (endc : (V : Ob) (f' : Hom V W) -> Id (TA.EI V) (p.1.1 V f' (ptH V eb)) (cE V (K.act V W f' y0))) {

      Q : Phi W = pre W Iv i (ptS eb) ;

      ig (V : Ob) (g : Hom V W) (h : Lands V W Q g) : Id (Hom V Iv) (compH V W Iv i g) (ptH V eb) =
        lands-pt V eb (compH V W Iv i g) (lands-pre V W Iv i (ptS eb) g h) ;

      cv (V : Ob) (g : Hom V W) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv) : TA.EI V' = cE V' (kL V' (compH V' V W g g') j) ;

      cp (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
        : Id (W0.Ix (H.ob V')) (cv V g V' g' j).1 ((FG.actF V W g gW).1 V' g' j) =
        transH (cE-pt V' (kL V' (compH V' V W g g') j))
          (apH (\ k -> s V' (kL V' (compH V' V W g g') j) V' (idH V') k) (symH (icPt eb V g h V' g'))) ;

      cn (V : Ob) (g : Hom V W) (V'' V' : Ob) (g'' : Hom V'' V') (g' : Hom V' V) (j : Hom V' Iv)
        : Id (TA.EI V'') (TA.E.act V'' V' g'' (cv V g V' g' j)) (cv V g V'' (compH V'' V' V g' g'') (compH V'' V' Iv j g'')) =
        transH (cE-act V'' V' g'' (kL V' (compH V' V W g g') j))
          (cE-eq V'' _ _ (transH (kW.2 V'' V' g'' (compH V' V W g g') j)
                                 (apH (\ k -> kL V'' k (compH V'' V' Iv j g'')) (comp-assoc V'' V' V W g g' g'')))) ;

      cL (V : Ob) (g : Hom V W) (h : Lands V W Q g) : CA.TL.EI V =
        ((CA.TV.E.act V W g x').1, FA.lamA V (CA.TV.E.act V W g x').1 (cv V g) (cp V g h) (cn V g)) ;

      Ql (V : Ob) (g : Hom V W) (h : Lands V W Q g)
        : Id (TA.EI V) (CA.endE V (EVA.evA.mE V (cL V g h))) (CA.endE V (CA.TV.E.act V W g x')) =
        calc (TA.EI V) {
            CA.endE V (EVA.evA.mE V (cL V g h))
          =< EVA.endB-E V (cL V g h) >
            cE V (kL V (compH V V W g (idH V)) (ptH V e))
          =< cE-eq V _ _ (FK.evN e V W g xh.1) >
            cE V (K.act V W g y0)
          =< symH (endc V g) >
            p.1.1 V g (ptH V eb)
          =< apH (\ k -> p.1.1 V g k) (symH (ig V g h)) >
            p.1.1 V g (compH V W Iv i g)
          =< symH (endP V g) >
            CA.endE V (CA.TV.E.act V W g x') } ;

      pv (V : Ob) (g : Hom V W) (h : Lands V W Q g) : CA.TS.EI V =
        CA.mkTS V (CA.TV.E.act V W g x') (cL V g h) (refl (CA.TV.E.act V W g x').1) (Ql V g h) ;

      pv-pt (V : Ob) (g : Hom V W) (h : Lands V W Q g) : Id (CA.TV.EI V) (pv V g h).1 (CA.TV.E.act V W g x') =
        CA.mkTS-pt V (CA.TV.E.act V W g x') (cL V g h) (refl (CA.TV.E.act V W g x').1) (Ql V g h) ;

      pv-lev (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
        : Id (TA.EI V') ((CA.lineL V (pv V g h)).2.1.1 V' g' j) (cE V' (kL V' (compH V' V W g g') j)) =
        apH (\ M -> M.2.1.1 V' g' j) (CA.mkTS-line V (CA.TV.E.act V W g x') (cL V g h) (refl (CA.TV.E.act V W g x').1) (Ql V g h)) ;

      pnat (V' V : Ob) (g : Hom V' V) (f2 : Hom V W) (h : Lands V W Q f2) (h' : Lands V' W Q (compH V' V W f2 g))
        : Id (CA.TS.EI V') (CA.TS.E.act V' V g (pv V f2 h)) (pv V' (compH V' V W f2 g) h') =
        CA.ts-ext V' (CA.TS.E.act V' V g (pv V f2 h)) (pv V' (compH V' V W f2 g) h')
          (ptN V' V g f2 (pv V f2 h) (pv V' (compH V' V W f2 g) h') (pv-pt V f2 h) (pv-pt V' (compH V' V W f2 g) h'))
          (\ V'' g' j ->
             transH (apH (\ M -> M.2.1.1 V'' g' j) (CA.lineL-act V' V g (pv V f2 h)))
               (transH (pv-lev V f2 h V'' (compH V'' V' V g g') j)
                 (transH (cE-eq V'' _ _ (apH (\ k -> kL V'' k j) (symH (comp-assoc V'' V' V W f2 g g'))))
                         (symH (pv-lev V' (compH V' V W f2 g) h' V'' g' j))))) ;

      opaque pv-lev ; opaque pnat ;

      side : CA.PT.Side[W, x'] = new CA.PT.Side[W, x', Q, pv, pv-pt, pnat] ;
    } ;

    module B0 = BS[src dd, PT.aE, PT.aE-eq, aE-act, aE-pt, \ V f' -> PT.end0g W y0 p V f'] ;
    module B1 = BS[tgt dd, PT.bE, PT.bE-eq, bE-act, bE-pt, \ V f' -> PT.end1g W y0 p V f'] ;

    --------------------------------------------------------------------
    -- the side of P, along f, its paths evaluated at the path coordinate

    module SL {
      Q : Phi W = P.pQ ;

      u (V : Ob) (g : Hom V W) (h : Lands V W Q g) : CP.TS.EI V = P.pv V g h ;

      -- the K-line of the side is the K-line of the problem restricted
      kEq (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
        : Id (W0.Ix (K.ob V')) ((CP.lineL V (u V g h)).1.1 V' g' j) (kW.1 V' (compH V' V W g g') j) =
        apH (\ z -> z.1.1 V' g' j) (P.ppt V g h) ;

      t (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv) : TA.EI V' =
        (lvP V (u V g h) V' g' j).2.1.1 V' (idH V') (ic V g V' g') ;

      hL (V : Ob) (g : Hom V W) (h : Lands V W Q g) : W0.Ix (FG.ob V) = RdL[V, (CP.lineL V (u V g h)).1, compH V W Iv i g].line ;

      tp (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
        : Id (W0.Ix (H.ob V')) (t V g h V' g' j).1 ((hL V g h).1 V' g' j) =
        transH ((lvP V (u V g h) V' g' j).2.2.1 V' (idH V') (ic V g V' g'))
          (sEq V' (lvP V (u V g h) V' g' j).1 ((CP.lineL V (u V g h)).1.1 V' g' j)
             (lvP-pt V (u V g h) V' g' j) (ic V g V' g') (ic V g V' g') (refl (ic V g V' g'))) ;

      tn (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V'' V' : Ob) (g'' : Hom V'' V') (g' : Hom V' V) (j : Hom V' Iv)
        : Id (TA.EI V'') (TA.E.act V'' V' g'' (t V g h V' g' j)) (t V g h V'' (compH V'' V' V g' g'') (compH V'' V' Iv j g'')) =
        calc (TA.EI V'') {
            TA.E.act V'' V' g'' ((lvP V (u V g h) V' g' j).2.1.1 V' (idH V') (ic V g V' g'))
          =< (lvP V (u V g h) V' g' j).2.1.2 V'' V' g'' (idH V') (ic V g V' g') >
            (lvP V (u V g h) V' g' j).2.1.1 V'' (compH V'' V' V' (idH V') g'') (compH V'' V' Iv (ic V g V' g') g'')
          =< apH (\ k -> (lvP V (u V g h) V' g' j).2.1.1 V'' k (compH V'' V' Iv (ic V g V' g') g''))
               (transH (comp-idl V'' V' g'') (symH (comp-idr V'' V' g''))) >
            (lvP V (u V g h) V' g' j).2.1.1 V'' (compH V'' V'' V' g'' (idH V'')) (compH V'' V' Iv (ic V g V' g') g'')
          =< apH (\ z -> z.2.1.1 V'' (idH V'') (compH V'' V' Iv (ic V g V' g') g''))
               ((CP.lineL V (u V g h)).2.1.2 V'' V' g'' g' j) >
            (lvP V (u V g h) V'' (compH V'' V' V g' g'') (compH V'' V' Iv j g'')).2.1.1 V'' (idH V'') (compH V'' V' Iv (ic V g V' g') g'')
          =< apH (\ k -> (lvP V (u V g h) V'' (compH V'' V' V g' g'') (compH V'' V' Iv j g'')).2.1.1 V'' (idH V'') k)
               (comp-assoc V'' V' V Iv (compH V W Iv i g) g' g'') >
            t V g h V'' (compH V'' V' V g' g'') (compH V'' V' Iv j g'') } ;

      L (V : Ob) (g : Hom V W) (h : Lands V W Q g) : CA.TL.EI V =
        (hL V g h, FA.lamA V (hL V g h) (t V g h) (tp V g h) (tn V g h)) ;

      Pl (V : Ob) (g : Hom V W) (h : Lands V W Q g) : Id (W0.Ix (FG.ob V)) (L V g h).1 (CA.TV.E.act V W g x').1 =
        FG.fam-eq V (hL V g h) (FG.actF V W g gW)
          (\ V' g' j -> sEq V' _ _ (kEq V g h V' g' j) (compH V' V Iv (compH V W Iv i g) g') (compH V' W Iv i (compH V' V W g g'))
                           (comp-assoc V' V W Iv i g g')) ;

      -- the end at e of the line of the side: the end of xh restricted
      Ee (V : Ob) (g : Hom V W) (h : Lands V W Q g)
        : Id (TP.EI V) (lvP V (u V g h) V (idH V) (ptH V e)) (CP.endE V (CP.TV.E.act V W g xh)) =
        transH (symH (EVP.endB-E V (CP.lineL V (u V g h))))
          (transH (apH (CP.endE V) (u V g h).2.2) (apH (CP.endE V) (P.ppt V g h))) ;

      Ql (V : Ob) (g : Hom V W) (h : Lands V W Q g)
        : Id (TA.EI V) (CA.endE V (EVA.evA.mE V (L V g h))) (CA.endE V (CA.TV.E.act V W g x')) =
        calc (TA.EI V) {
            CA.endE V (EVA.evA.mE V (L V g h))
          =< EVA.endB-E V (L V g h) >
            t V g h V (idH V) (ptH V e)
          =< apH (\ z -> z.2.1.1 V (idH V) (ic V g V (idH V))) (Ee V g h) >
            p.1.1 V (compH V V W g (idH V)) (ic V g V (idH V))
          =< apH (\ k -> p.1.1 V k (ic V g V (idH V))) (comp-idr V W g) >
            p.1.1 V g (ic V g V (idH V))
          =< apH (\ k -> p.1.1 V g k) (comp-idr V Iv (compH V W Iv i g)) >
            p.1.1 V g (compH V W Iv i g)
          =< symH (endP V g) >
            CA.endE V (CA.TV.E.act V W g x') } ;

      pv (V : Ob) (g : Hom V W) (h : Lands V W Q g) : CA.TS.EI V =
        CA.mkTS V (CA.TV.E.act V W g x') (L V g h) (Pl V g h) (Ql V g h) ;

      pv-pt (V : Ob) (g : Hom V W) (h : Lands V W Q g) : Id (CA.TV.EI V) (pv V g h).1 (CA.TV.E.act V W g x') =
        CA.mkTS-pt V (CA.TV.E.act V W g x') (L V g h) (Pl V g h) (Ql V g h) ;

      pv-lev (V : Ob) (g : Hom V W) (h : Lands V W Q g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
        : Id (TA.EI V') ((CA.lineL V (pv V g h)).2.1.1 V' g' j) (t V g h V' g' j) =
        apH (\ M -> M.2.1.1 V' g' j) (CA.mkTS-line V (CA.TV.E.act V W g x') (L V g h) (Pl V g h) (Ql V g h)) ;

      uNat (V' V : Ob) (g : Hom V' V) (f2 : Hom V W) (h : Lands V W Q f2) (h' : Lands V' W Q (compH V' V W f2 g))
        : Id (CP.TS.EI V') (CP.TS.E.act V' V g (u V f2 h)) (u V' (compH V' V W f2 g) h') =
        P.pnat V' V g f2 h h' ;

      pnat (V' V : Ob) (g : Hom V' V) (f2 : Hom V W) (h : Lands V W Q f2) (h' : Lands V' W Q (compH V' V W f2 g))
        : Id (CA.TS.EI V') (CA.TS.E.act V' V g (pv V f2 h)) (pv V' (compH V' V W f2 g) h') =
        CA.ts-ext V' (CA.TS.E.act V' V g (pv V f2 h)) (pv V' (compH V' V W f2 g) h')
          (ptN V' V g f2 (pv V f2 h) (pv V' (compH V' V W f2 g) h') (pv-pt V f2 h) (pv-pt V' (compH V' V W f2 g) h'))
          (\ V'' g' j ->
            calc (TA.EI V'') {
                (CA.lineL V' (CA.TS.E.act V' V g (pv V f2 h))).2.1.1 V'' g' j
              =< apH (\ M -> M.2.1.1 V'' g' j) (CA.lineL-act V' V g (pv V f2 h)) >
                (CA.lineL V (pv V f2 h)).2.1.1 V'' (compH V'' V' V g g') j
              =< pv-lev V f2 h V'' (compH V'' V' V g g') j >
                (lvP V (u V f2 h) V'' (compH V'' V' V g g') j).2.1.1 V'' (idH V'') (ic V f2 V'' (compH V'' V' V g g'))
              =< apH (\ z -> z.2.1.1 V'' (idH V'') (ic V f2 V'' (compH V'' V' V g g')))
                   (transH (symH (apH (\ M -> M.2.1.1 V'' g' j) (CP.lineL-act V' V g (u V f2 h))))
                           (apH (\ w -> lvP V' w V'' g' j) (uNat V' V g f2 h h'))) >
                (lvP V' (u V' (compH V' V W f2 g) h') V'' g' j).2.1.1 V'' (idH V'') (ic V f2 V'' (compH V'' V' V g g'))
              =< apH (\ k -> (lvP V' (u V' (compH V' V W f2 g) h') V'' g' j).2.1.1 V'' (idH V'') k) (symH (cAss V' V g f2 V'' g')) >
                t V' (compH V' V W f2 g) h' V'' g' j
              =< symH (pv-lev V' (compH V' V W f2 g) h' V'' g' j) >
                (CA.lineL V' (pv V' (compH V' V W f2 g) h')).2.1.1 V'' g' j }) ;

      opaque pv-lev ; opaque pnat ;

      side : CA.PT.Side[W, x'] = new CA.PT.Side[W, x', Q, pv, pv-pt, pnat] ;

      -- on {i g = eb} the side is the end along the K-line
      module On (eb : IPt) (cE : (V : Ob) -> W0.Ix (K.ob V) -> TA.EI V)
        (cE-eq : (V : Ob) (y y' : W0.Ix (K.ob V)) -> Id (W0.Ix (K.ob V)) y y' -> Id (TA.EI V) (cE V y) (cE V y'))
        (endg : (Y : Ob) (y : W0.Ix (K.ob Y)) (w : W0.Ix (PT.tobP Y y)) (V : Ob) (f' : Hom V Y)
                -> Id (TA.EI V) (w.1.1 V f' (ptH V eb)) (cE V (K.act V Y f' y))) {
        on (V : Ob) (g : Hom V W) (h : Lands V W Q g) (h0 : Lands V W (pre W Iv i (ptS eb)) g) (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv)
          : Id (TA.EI V') ((CA.lineL V (pv V g h)).2.1.1 V' g' j) (cE V' (kW.1 V' (compH V' V W g g') j)) =
          calc (TA.EI V') {
              (CA.lineL V (pv V g h)).2.1.1 V' g' j
            =< pv-lev V g h V' g' j >
              (lvP V (u V g h) V' g' j).2.1.1 V' (idH V') (ic V g V' g')
            =< apH (\ k -> (lvP V (u V g h) V' g' j).2.1.1 V' (idH V') k)
                 (transH (apH (\ k -> compH V' V Iv k g') (lands-pt V eb (compH V W Iv i g) (lands-pre V W Iv i (ptS eb) g h0)))
                         (ptH-nat V' V g' eb)) >
              (lvP V (u V g h) V' g' j).2.1.1 V' (idH V') (ptH V' eb)
            =< endg V' (lvP V (u V g h) V' g' j).1 (lvP V (u V g h) V' g' j).2 V' (idH V') >
              cE V' (K.act V' V' (idH V') (lvP V (u V g h) V' g' j).1)
            =< cE-eq V' _ _ (transH (K.act-id V' (lvP V (u V g h) V' g' j).1)
                              (transH (lvP-pt V (u V g h) V' g' j) (kEq V g h V' g' j))) >
              cE V' (kW.1 V' (compH V' V W g g') j) } ;
      } ;

      module O0 = On[src dd, PT.aE, PT.aE-eq, PT.end0g] ;
      module O1 = On[tgt dd, PT.bE, PT.bE-eq, PT.end1g] ;
    } ;

    --------------------------------------------------------------------
    -- the problem: the join of B0 , B1 and SL

    pick1 : Nat -> CA.PT.Side[W, x'] = split { zero -> B1.side ; suc m -> SL.side } ;
    pick : Nat -> CA.PT.Side[W, x'] = split { zero -> B0.side ; suc m -> pick1 m } ;

    CTy (n n' : Nat) : U l = (V : Ob) (g : Hom V W) (h : Lands V W (pick n).pQ g) (h' : Lands V W (pick n').pQ g)
      -> Id (CA.TS.EI V) ((pick n).pv V g h) ((pick n').pv V g h') ;

    -- two sides agree when their lines have the same values
    agree (n n' : Nat) (V : Ob) (g : Hom V W) (h : Lands V W (pick n).pQ g) (h' : Lands V W (pick n').pQ g)
      (q : (V' : Ob) (g' : Hom V' V) (j : Hom V' Iv) -> Id (TA.EI V') (lv (pick n) V g h V' g' j) (lv (pick n') V g h' V' g' j))
      : Id (CA.TS.EI V) ((pick n).pv V g h) ((pick n').pv V g h') =
      CA.ts-ext V ((pick n).pv V g h) ((pick n').pv V g h') (transH ((pick n).ppt V g h) (symH ((pick n').ppt V g h'))) q ;

    disj (V : Ob) (g : Hom V W) (h : Lands V W B0.Q g) (h' : Lands V W B1.Q g) : Empty =
      CPath[l].disjD dd V (compH V W Iv i g) (lands-pre V W Iv i (ptS (src dd)) g h) (lands-pre V W Iv i (ptS (tgt dd)) g h') ;

    c1s : (m : Nat) -> CTy (suc zero) (suc m) = split {
      zero -> \ V g h h' -> CA.PT.pv-irr W x' B1.side V g h h' ;
      suc k -> \ V g h h' -> agree (suc zero) (suc (suc k)) V g h h'
         (\ V' g' j -> transH (B1.pv-lev V g h V' g' j) (symH (SL.O1.on V g h' h V' g' j))) } ;

    c1 : (n' : Nat) -> CTy (suc zero) n' = split {
      zero -> \ V g h h' -> absurd _ (disj V g h' h) ;
      suc m -> c1s m } ;
    c2s : (m : Nat) -> CTy (suc (suc zero)) (suc m) = split {
      zero -> \ V g h h' -> agree (suc (suc zero)) (suc zero) V g h h'
         (\ V' g' j -> transH (SL.O1.on V g h h' V' g' j) (symH (B1.pv-lev V g h' V' g' j))) ;
      suc k -> \ V g h h' -> CA.PT.pv-irr W x' SL.side V g h h' } ;

    c2 : (n' : Nat) -> CTy (suc (suc zero)) n' = split {
      zero -> \ V g h h' -> agree (suc (suc zero)) zero V g h h'
         (\ V' g' j -> transH (SL.O0.on V g h h' V' g' j) (symH (B0.pv-lev V g h' V' g' j))) ;
      suc m -> c2s m } ;
    c0s : (m : Nat) -> CTy zero (suc m) = split {
      zero -> \ V g h h' -> absurd _ (disj V g h h') ;
      suc k -> \ V g h h' -> agree zero (suc (suc k)) V g h h'
         (\ V' g' j -> transH (B0.pv-lev V g h V' g' j) (symH (SL.O0.on V g h' h V' g' j))) } ;

    c0 : (n' : Nat) -> CTy zero n' = split {
      zero -> \ V g h h' -> CA.PT.pv-irr W x' B0.side V g h h' ;
      suc m -> c0s m } ;
    ccs : (m : Nat) -> (n' : Nat) -> CTy (suc m) n' = split {
      zero -> c1 ;
      suc k -> c2 } ;

    cc : (n n' : Nat) -> CTy n n' = split {
      zero -> c0 ;
      suc m -> ccs m } ;
    module J = CPartial[l].Join[CA.TV.E, CA.SFm.SF, W, x', suc (suc (suc zero)), \ k -> pick k.1, \ k k' -> cc k.1 k'.1] ;

    side : CA.PT.Side[W, x'] = J.side ;
  } ;

  ----------------------------------------------------------------------
  -- the problem is uniform: restricting the problem at (xh , P , i) along
  -- chi is the problem at the restricted data

  module PU (W' W : Ob) (chi : Hom W' W) (xh : CP.TV.EI W) (P0 : CP.PT.Side[W, xh]) (i : Hom W Iv) {
    module P = Prob[W, xh, P0, i] ;
    module P' = Prob[W', CP.TV.E.act W' W chi xh, CP.PT.rside W' W chi xh P0, compH W' W Iv i chi] ;

    pt : Id (CA.TV.EI W') (CA.TV.E.act W' W chi P.x') P'.x' =
      CA.tv-eq W' (CA.TV.E.act W' W chi P.x') P'.x'
        (FG.fam-eq W' (FG.actF W' W chi P.gW) P'.gW (\ V g j ->
           apH (\ k -> s V (xh.1.1 V (compH V W' W chi g) j) V (idH V) k) (symH (comp-assoc V W' W Iv i chi g))))
        (transH (P.endP W' chi)
          (transH (apH (\ k -> P.p.1.1 W' k (compH W' W Iv i chi)) (symH (comp-idr W' W chi))) (symH P'.x'-E))) ;

    Qe1 : (n : Nat) -> Id (Phi W') (pre W' W chi (P.pick1 n).pQ) (P'.pick1 n).pQ = split {
      zero -> pre-comp W' W Iv chi i (ptS (tgt dd)) ;
      suc m -> refl (pre W' W chi P0.pQ) } ;

    Qe : (n : Nat) -> Id (Phi W') (pre W' W chi (P.pick n).pQ) (P'.pick n).pQ = split {
      zero -> pre-comp W' W Iv chi i (ptS (src dd)) ;
      suc m -> Qe1 m } ;

    eQ : Id (Phi W') (pre W' W chi P.side.pQ) P'.side.pQ =
      transH (pre-bigU W' W chi (suc (suc (suc zero))) P.J.Qs)
        (apH (\ F -> bigU W' (suc (suc (suc zero))) F)
          (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Arith[a].Fin (suc (suc (suc zero)))) (\ k -> Phi W')
             (\ k -> pre W' W chi (P.J.Qs k)) P'.J.Qs (\ k -> Qe k.1))) ;

    back (n : Nat) (V : Ob) (f : Hom V W') (b : Lands V W' (P'.pick n).pQ f) : Lands V W (P.pick n).pQ (compH V W' W chi f) =
      lands-pre V W' W chi (P.pick n).pQ f (lands-sub V W' (P'.pick n).pQ (pre W' W chi (P.pick n).pQ) (symH (Qe n)) f b) ;

    ptV (V : Ob) (f : Hom V W') : Id (CA.TV.EI V) (CA.TV.E.act V W (compH V W' W chi f) P.x') (CA.TV.E.act V W' f P'.x') =
      transH (symH (CA.TV.PE.actC V W' W chi f P.x')) (apH (CA.TV.E.act V W' f) pt) ;

    -- a side on {i = eb}, compared
    vB (V : Ob) (f : Hom V W') (cE : (V2 : Ob) -> W0.Ix (K.ob V2) -> TA.EI V2)
      (cE-eq : (V2 : Ob) (y y' : W0.Ix (K.ob V2)) -> Id (W0.Ix (K.ob V2)) y y' -> Id (TA.EI V2) (cE V2 y) (cE V2 y'))
      (L L' : CA.TL.EI V) (p : Id (W0.Ix (FG.ob V)) L.1 (CA.TV.E.act V W (compH V W' W chi f) P.x').1)
      (q : Id (TA.EI V) (CA.endE V (EVA.evA.mE V L)) (CA.endE V (CA.TV.E.act V W (compH V W' W chi f) P.x')))
      (p' : Id (W0.Ix (FG.ob V)) L'.1 (CA.TV.E.act V W' f P'.x').1)
      (q' : Id (TA.EI V) (CA.endE V (EVA.evA.mE V L')) (CA.endE V (CA.TV.E.act V W' f P'.x')))
      (Lv : (V'' : Ob) (g : Hom V'' V) (j : Hom V'' Iv) -> Id (TA.EI V'') (L.2.1.1 V'' g j) (cE V'' (xh.1.1 V'' (compH V'' V W (compH V W' W chi f) g) j)))
      (Lv' : (V'' : Ob) (g : Hom V'' V) (j : Hom V'' Iv) -> Id (TA.EI V'') (L'.2.1.1 V'' g j) (cE V'' (xh.1.1 V'' (compH V'' W' W chi (compH V'' V W' f g)) j)))
      : Id (CA.TS.EI V) (CA.mkTS V (CA.TV.E.act V W (compH V W' W chi f) P.x') L p q) (CA.mkTS V (CA.TV.E.act V W' f P'.x') L' p' q') =
      CA.mkTS-eq V (CA.TV.E.act V W (compH V W' W chi f) P.x') (CA.TV.E.act V W' f P'.x') L L' p q p' q' (ptV V f)
        (\ V'' g j -> transH (Lv V'' g j)
           (transH (cE-eq V'' _ _ (apH (\ k -> xh.1.1 V'' k j) (comp-assoc V'' V W' W chi f g))) (symH (Lv' V'' g j)))) ;

    vEq1 : (n : Nat) (V : Ob) (f : Hom V W') (a' : Lands V W (P.pick1 n).pQ (compH V W' W chi f)) (b : Lands V W' (P'.pick1 n).pQ f)
      -> Id (CA.TS.EI V) ((P.pick1 n).pv V (compH V W' W chi f) a') ((P'.pick1 n).pv V f b) = split {
      zero -> \ V f a' b ->
        vB V f PT.bE PT.bE-eq (P.B1.cL V (compH V W' W chi f) a') (P'.B1.cL V f b)
          (refl (CA.TV.E.act V W (compH V W' W chi f) P.x').1) (P.B1.Ql V (compH V W' W chi f) a')
          (refl (CA.TV.E.act V W' f P'.x').1) (P'.B1.Ql V f b)
          (\ V'' g j -> refl (PT.bE V'' (xh.1.1 V'' (compH V'' V W (compH V W' W chi f) g) j)))
          (\ V'' g j -> refl (PT.bE V'' (xh.1.1 V'' (compH V'' W' W chi (compH V'' V W' f g)) j))) ;
      suc m -> \ V f a' b ->
        CA.mkTS-eq V (CA.TV.E.act V W (compH V W' W chi f) P.x') (CA.TV.E.act V W' f P'.x')
          (P.SL.L V (compH V W' W chi f) a') (P'.SL.L V f b)
          (P.SL.Pl V (compH V W' W chi f) a') (P.SL.Ql V (compH V W' W chi f) a') (P'.SL.Pl V f b) (P'.SL.Ql V f b)
          (ptV V f)
          (\ V'' g j -> transH
             (apH (\ w -> (lvP V w V'' g j).2.1.1 V'' (idH V'') (P.ic V (compH V W' W chi f) V'' g))
                  (CP.PT.pv-irr W xh P0 V (compH V W' W chi f) a' (lands-pre V W' W chi P0.pQ f b)))
             (apH (\ k -> (lvP V ((CP.PT.rside W' W chi xh P0).pv V f b) V'' g j).2.1.1 V'' (idH V'') (compH V'' V Iv k g))
                  (symH (comp-assoc V W' W Iv i chi f)))) } ;

    vEq : (n : Nat) (V : Ob) (f : Hom V W') (a' : Lands V W (P.pick n).pQ (compH V W' W chi f)) (b : Lands V W' (P'.pick n).pQ f)
      -> Id (CA.TS.EI V) ((P.pick n).pv V (compH V W' W chi f) a') ((P'.pick n).pv V f b) = split {
      zero -> \ V f a' b ->
        vB V f PT.aE PT.aE-eq (P.B0.cL V (compH V W' W chi f) a') (P'.B0.cL V f b)
          (refl (CA.TV.E.act V W (compH V W' W chi f) P.x').1) (P.B0.Ql V (compH V W' W chi f) a')
          (refl (CA.TV.E.act V W' f P'.x').1) (P'.B0.Ql V f b)
          (\ V'' g j -> refl (PT.aE V'' (xh.1.1 V'' (compH V'' V W (compH V W' W chi f) g) j)))
          (\ V'' g j -> refl (PT.aE V'' (xh.1.1 V'' (compH V'' W' W chi (compH V'' V W' f g)) j))) ;
      suc m -> vEq1 m } ;

    sd-eq : Id (CA.PT.Side[W', P'.x']) (subst (CA.TV.EI W') (\ z -> CA.PT.Side[W', z]) (CA.TV.E.act W' W chi P.x') P'.x' pt (CA.PT.rside W' W chi P.x' P.side)) P'.side =
      CA.PT.side-extH W' (CA.TV.E.act W' W chi P.x') P'.x' pt (CA.PT.rside W' W chi P.x' P.side) P'.side eQ
        (\ V f h h' ->
          transH (P.J.pv-in (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').1 V (compH V W' W chi f)
                    (back (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').1.1 V f (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').2)
                    (lands-pre V W' W chi P.side.pQ f h))
                 (vEq (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').1.1 V f
                    (back (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').1.1 V f (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').2)
                    (bigU-out V W' (suc (suc (suc zero))) P'.J.Qs f h').2)) ;

    opaque pt ; opaque sd-eq ;
  } ;
} ;
