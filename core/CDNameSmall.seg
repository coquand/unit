-- The name of a small fibrant type lifts to the name of its large
-- reading. The chosen horn extension agrees by CDBoxNat.
module S = DB.CSmall ;
module SP = CDSmallPi[a] ;
module Y = DB.GYon[a] ;
module Q = B.Q1.PS ;

module Naming (G : PCtx) (T : SP.SmallFib G) {
  A : F.STy G = SP.large G T ;
  module Big = N.Naming[G, A.1, N.horn G A.1 A.2] ;

  module At (Z : Nat) (z : W.Ix (G.ob Z)) {
    YZ : X.P.PS.PCtx = Y.yP Z ;
    local : S.XSub[YZ, G] = new S.XSub[YZ, G, (Big.loc Z z).nt, (Big.loc Z z).nt-nat] ;
    module Small = S.SmallFib[G, T.1, YZ, local] ;
    module H = CDBoxNat[a, a, a+].Along[YZ, Small.ElTy, G, A.1, local.nt, local.nt-nat,
      Small.ta, \ I v -> refl (local.nt I v.1), Small.tanat, Small.tainj, \ I x u -> u, \ I x u -> refl (local.nt I x, u)].Fib[A.2] ;

    lower : U0.U0 Z = (Small.ElTy, \ i -> H.hnD i.1 i.2) ;
    lift : U1.U0 Z = X.inc Z lower ;
    upper : U1.U0 Z = Big.code Z (Big.loc Z z) ;

    module Sub = B.Cl.P[N.Y.yP Z, N.high G, Big.loc Z z, Big.A1, N.horn G A.1 A.2] ;
    module E = B.High.COp[a+].OpExtE[B.DC.HIx, \ i -> B.DC.hOk i, B.DC.hOb, B.DC.hS, N.Y.yP Z] ;
    module R = B.High.COp[a+].OpExt[B.DC.HIx, \ i -> B.DC.hOk i, B.DC.hOb, B.DC.hS, N.Y.yP Z, lift.1] ;

    pack : R.Pack = (upper.1.tact, (upper.1.tact-id, upper.1.tact-o)) ;

    action : Q.PtEq (N.Y.yP Z) lift.1.tob lift.1.tact pack.1 =
      \ J I f x y e u -> S.tact-irr G T.1 J I f (local.nt I x) (local.nt J y)
        (S.xntEq YZ G local J I f x y e)
        (Q.ntEq (N.Y.yP Z) (N.high G) (Big.loc Z z) J I f x y e) u ;

    fillers : R.Agree pack lift.2 upper.2 =
      \ i o x v pp pd pg ->
        Small.TE.pr-inj (B.DC.hOb i) (local.nt (B.DC.hOb i) x) _ _
          (H.law i.1 i.2 o x (local.nt (B.DC.hOb i) x) (refl (local.nt (B.DC.hOb i) x))
            (v, (pp, pd)) (Sub.Pl.mv i x (v, (pp, pg))) (\ I f j k ->
              apH (\ b -> Small.ta I (v I f b)) (DB.isProp-Lands I (B.DC.hOb i) (B.DC.hS i) f j k))) ;

    law : Id (U1.U0 Z) lift upper = E.isOpExt lift.1 lift.2 pack action upper.2 fillers ;

    opaque law ;
  } ;

  code (I : Nat) (x : W.Ix (G.ob I)) : U0.U0 I = At[I, x].lower ;

  nat (J I : Nat) (f : Hom J I) (x : W.Ix (G.ob I))
    : Id (U0.U0 J) (code J (G.act J I f x)) (U0.uAct J I f (code I x)) =
    X.include-inj J (code J (G.act J I f x)) (U0.uAct J I f (code I x))
      (transH At[J, G.act J I f x].law (transH (Big.nat J I f x)
        (transH (apH (U1.uAct J I f) (symH At[I, x].law)) (symH (X.include-nat J I f (code I x)))))) ;

  name : PSub[G, U0.UCtx] = new PSub[G, U0.UCtx, code, nat] ;

  lift-name : Id (C.C.Ty G) (Uv.lift-code G name) (Product.named G A) =
    C.C.ty-ext G _ _ (\ I x -> At[I, x].law) ;

  opaque nat ; opaque lift-name ;
} ;
