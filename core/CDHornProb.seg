-- Restriction, degeneracy and the end of a moved filling problem.
module ND = CDNormA[a, k].NA[D, A', e] ;
module NG = CDNormA[a, l].NA[G, A, e] ;

FillRel (N : Nat) (KD : SD.FillTy N) (KG : SG.FillTy N) : U l =
  (b : SD.Prob N) -> Id (SG.KA.TS.EI N) (E.mS N (SD.fillE N KD b)) (SG.fillE N KG (image N b)) ;

fill-res (M N : Nat) (KD : SD.FillTy M) (KG : SG.FillTy M) (ih : FillRel M KD KG)
  (f : Hom (lin M) (lin N)) (b : SD.Prob N)
  : Id (SG.KA.TS.EI M) (E.mS M (SD.fillE M KD (SD.resP M N f b)))
      (SG.fillE M KG (SG.resP M N f (image N b))) =
  transH (ih (SD.resP M N f b)) (apH (SG.fillE M KG) (image-res M N f b)) ;

module Deg (N : Nat) (b : SD.Prob (suc N)) {
  db : SD.Prob (suc N) = b ;
  gb : SG.Prob (suc N) = image (suc N) b ;

  square (i : Nat)
    : Id (SG.Prob (suc N))
        (image (suc N) (SD.resP (suc N) N (dgH N i) (SD.resP N (suc N) (dl N i) b)))
        (SG.resP (suc N) N (dgH N i) (SG.resP N (suc N) (dl N i) gb)) =
    transH (image-res (suc N) N (dgH N i) (SD.resP N (suc N) (dl N i) b))
           (apH (SG.resP (suc N) N (dgH N i)) (image-res N (suc N) (dl N i) b)) ;

  forth (i : Nat) (q : ND.DegId N db i) : NG.DegId N gb i =
    transH (apH (image (suc N)) q) (square i) ;

  back (i : Nat) (q : NG.DegId N gb i) : ND.DegId N db i =
    image-inj (suc N) b _ (transH q (symH (square i))) ;

  FirstD : U k = (i : Nat) * (IsT (leb i N) * (ND.DegId N db i *
    ((j : Nat) -> IsT (ltb j i) -> ND.DegId N db j -> Empty))) ;
  FirstG : U l = (i : Nat) * (IsT (leb i N) * (NG.DegId N gb i *
    ((j : Nat) -> IsT (ltb j i) -> NG.DegId N gb j -> Empty))) ;

  same-index (u : FirstD) (v : FirstG) : Id Nat u.1 v.1 =
    ltbDecL (Id Nat u.1 v.1) u.1 v.1
      (\ lt -> absurd _ (v.2.2.2 u.1 lt (forth u.1 u.2.2.1)))
      (\ le -> eqNDecL (Id Nat u.1 v.1) u.1 v.1 (\ q -> q)
         (\ ne -> absurd _ (u.2.2.2 v.1 (leb-neq v.1 u.1 le (neq-sym u.1 v.1 ne)) (back v.1 v.2.2.1)))) ;
} ;

module End (e' : El Iv) (fD : DB.CLine[k].Lines[D, A'].Fill e) (fG : DB.CLine[l].Lines[G, A].Fill e) {
  module M = C.MoveComp[e, e'] ;
  cD : M.CK'.Comp = M.CK'.fromFill fD ;
  cG : M.CK.Comp = M.CK.fromFill fG ;

  law (r : (N : Nat) -> FillRel N (\ b -> fD.kop N b.1 b.2) (\ b -> fG.kop N b.1 b.2))
    : Id (M.CK'.Comp) cD (M.move cG) =
    M.unique cG cD (\ N x sd ->
      transH (apH (M.mT N)
        (M.TT'.fromE-eq N x (M.CK'.endM N (SD.KA.TS.pr N x (fD.kop N x sd))) (refl x)))
        (transH (M.sq N (SD.KA.TS.pr N x (fD.kop N x sd)))
          (transH (apH (M.CK.endM N) (r N (x, sd)))
            (symH (M.TT.fromE-eq N (E.sV N x)
               (M.CK.endM N (SG.KA.TS.pr N (E.sV N x) (fG.kop N (E.sV N x) (image N (x, sd)).2)))
               (refl (E.sV N x))))))) ;

  opaque law ;
} ;
