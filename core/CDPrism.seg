-- CDPrism.seg (L8, Delta): seg/model DPrism.seg ported (module names only).  Was: the shuffles P_k : [N+1] -> [N] * [1] of the prism, in line
-- form (s1 = gkD N k, s2 = jkD N k: DeltaForall), as simplices for
-- DGlue.Glue:
--
--   memP N k        the points (f , j) of P_k: every vertex v has
--                   (f v , j v) = (a , 0) with a <= k, or (a , 1) with k <= a
--   facP            the factorisation through P_k: v |-> f v + j v (the map
--                   h of DeltaForall.Fact, which does not depend on k)
--   uniqP           P_k is mono: i = pl i + pc i
--   memP-sigma      P_k g is a point of P_k
--
-- Constructive.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DPS = CDPrS[a] ;

------------------------------------------------------------------------
-- values of maps

valT-comp (V W N : Nat) (f : Hom (lin W) (lin N)) (g : Hom (lin V) (lin W)) (i : Nat) (hi : IsT (leb i V))
  : Id Nat (valT V N (compH (lin V) (lin W) (lin N) f g) i) (valT W N f (valT V W g i)) =
  apH vnum (transH (symH (valT-tree V N (compH (lin V) (lin W) (lin N) f g) i hi))
    (transH (app-compH1 (lin V) (lin W) (lin N) f g (leaf i, hi))
      (transH (apH (\ s -> (app (lin W) (lin N) f s).1)
                 (el-eq (lin W) (app (lin V) (lin W) g (leaf i, hi)) (leaf (valT V W g i), valT-range V W g i) (valT-tree V W g i hi)))
              (valT-tree W N f (valT V W g i) (valT-range V W g i))))) ;

-- the values of the shuffle maps
valT-gk (N k x : Nat) (hx : IsT (leb x (suc N))) : Id Nat (valT (suc N) N (gkD N k) x) (pc N k x) =
  apH vnum (symH (valT-tree (suc N) N (gkD N k) x hx)) ;
valT-jk (N k x : Nat) (hx : IsT (leb x (suc N))) : Id Nat (valT (suc N) (suc zero) (jkD N k) x) (pl N k x) =
  apH vnum (symH (valT-tree (suc N) (suc zero) (jkD N k) x hx)) ;

-- a point of the shuffle is determined by its two coordinates
pcpl : (k n i : Nat) -> Id Nat (plus (pl n k i) (pc n k i)) i = split {
  zero -> \ n -> split { zero -> refl zero ; suc i -> refl (suc i) } ;
  suc k | ih-k -> split {
    zero -> split { zero -> refl zero ; suc i -> refl (suc i) } ;
    suc n -> split {
      zero -> refl zero ;
      suc i -> transH (plus-suc (pl n k i) (pc n k i)) (apH (\ x -> suc x) (ih-k n i)) } } } ;

------------------------------------------------------------------------
-- the points of P_k

memK (k a0 e : Nat) : Bool = ifBB (eqN e zero) (leb a0 k) (leb k a0) ;

memP (N k : Nat) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : Bool =
  forallUp W (\ v -> memK k (valT W N f v) (valT W (suc zero) j v)) ;

memP-clos (N k : Nat) : DPS.PrClos N (memP N k) = \ W' W g f j u ->
  fa-i W' (\ v -> memK k (valT W' N (compH (lin W') (lin W) (lin N) f g) v) (valT W' (suc zero) (compH (lin W') (lin W) Iv j g) v))
    (\ v hv -> substH (\ x -> IsT (memK k x (valT W' (suc zero) (compH (lin W') (lin W) Iv j g) v))) (symH (valT-comp W' W N f g v hv))
                 (substH (\ x -> IsT (memK k (valT W N f (valT W' W g v)) x)) (symH (valT-comp W' W (suc zero) j g v hv))
                    (fa-e W (\ v' -> memK k (valT W N f v') (valT W (suc zero) j v')) u (valT W' W g v) (valT-range W' W g v)))) ;

-- the vertices of P_k are points of P_k
memK-pk (N k i : Nat) (hk : IsT (leb k N)) (hi : IsT (leb i (suc N))) : IsT (memK k (pc N k i) (pl N k i)) =
  ltb-dec (IsT (memK k (pc N k i) (pl N k i))) k i
    (\ lt -> mkHi i lt hi)
    (\ ge -> substH (\ x -> IsT (memK k x (pl N k i))) (symH (pc-low k N i ge (leb-trans i k N ge hk)))
               (substH (\ e -> IsT (memK k i e)) (symH (pl-low k N i ge (leb-trans i k N ge hk))) ge))
 where { mkHi : (i' : Nat) -> IsT (ltb k i') -> IsT (leb i' (suc N)) -> IsT (memK k (pc N k i') (pl N k i')) = split {
           zero -> \ lt hi'' -> absurd _ (false-true lt) ;
           suc x -> \ lt hi' -> substH (\ y -> IsT (memK k y (pl N k (suc x)))) (symH (pc-high k N x lt hi'))
                                 (substH (\ e -> IsT (memK k x e)) (symH (pl-high k N x lt hi')) lt) } ; } ;

memP-sigma (N k : Nat) (hk : IsT (leb k N)) (W : Nat) (g : Hom (lin W) (lin (suc N)))
  : IsT (memP N k W (compH (lin W) (lin (suc N)) (lin N) (gkD N k) g) (compH (lin W) (lin (suc N)) Iv (jkD N k) g)) =
  fa-i W (\ v -> memK k (valT W N (compH (lin W) (lin (suc N)) (lin N) (gkD N k) g) v) (valT W (suc zero) (compH (lin W) (lin (suc N)) Iv (jkD N k) g) v))
    (\ v hv -> substH (\ x -> IsT (memK k x (valT W (suc zero) (compH (lin W) (lin (suc N)) Iv (jkD N k) g) v)))
                 (symH (transH (valT-comp W (suc N) N (gkD N k) g v hv) (valT-gk N k (valT W (suc N) g v) (valT-range W (suc N) g v))))
                 (substH (\ e -> IsT (memK k (pc N k (valT W (suc N) g v)) e))
                    (symH (transH (valT-comp W (suc N) (suc zero) (jkD N k) g v hv) (valT-jk N k (valT W (suc N) g v) (valT-range W (suc N) g v))))
                    (memK-pk N k (valT W (suc N) g v) hk (valT-range W (suc N) g v)))) ;

------------------------------------------------------------------------
-- the factorisation through P_k

module FacP (N k W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (memP N k W f j)) {
  module F = Fact[N, W, f, j] ;

  mu (i : Nat) (hi : IsT (leb i W)) : IsT (memK k (F.gn i) (F.jn i)) =
    fa-e W (\ v -> memK k (valT W N f v) (valT W (suc zero) j v)) u i hi ;

  pcE (i : Nat) (hi : IsT (leb i W)) : Id Nat (pc N k (F.hfN i)) (F.gn i) =
    bcase (Id Nat (pc N k (F.hfN i)) (F.gn i)) (eqN (F.jn i) zero)
      (\ t -> transH (apH (pc N k) (ifB-t (eqN (F.jn i) zero) (F.gn i) (suc (F.gn i)) t))
                (pc-low k N (F.gn i) (substH (\ c -> IsT c) (ifBB-t (eqN (F.jn i) zero) (leb (F.gn i) k) (leb k (F.gn i)) t) (mu i hi))
                   (valT-range W N f i)))
      (\ nf -> transH (apH (pc N k) (ifB-f (eqN (F.jn i) zero) (F.gn i) (suc (F.gn i)) nf))
                (pc-high k N (F.gn i) (substH (\ c -> IsT c) (ifBB-f (eqN (F.jn i) zero) (leb (F.gn i) k) (leb k (F.gn i)) nf) (mu i hi))
                   (valT-range W N f i))) ;

  plE (i : Nat) (hi : IsT (leb i W)) : Id Nat (pl N k (F.hfN i)) (F.jn i) =
    bcase (Id Nat (pl N k (F.hfN i)) (F.jn i)) (eqN (F.jn i) zero)
      (\ t -> transH (apH (pl N k) (ifB-t (eqN (F.jn i) zero) (F.gn i) (suc (F.gn i)) t))
                (transH (pl-low k N (F.gn i) (substH (\ c -> IsT c) (ifBB-t (eqN (F.jn i) zero) (leb (F.gn i) k) (leb k (F.gn i)) t) (mu i hi))
                           (valT-range W N f i))
                        (symH (eqN-sound (F.jn i) zero t))))
      (\ nf -> transH (apH (pl N k) (ifB-f (eqN (F.jn i) zero) (F.gn i) (suc (F.gn i)) nf))
                (transH (pl-high k N (F.gn i) (substH (\ c -> IsT c) (ifBB-f (eqN (F.jn i) zero) (leb (F.gn i) k) (leb k (F.gn i)) nf) (mu i hi))
                           (valT-range W N f i))
                        (symH (one-of (F.jn i) (valT-range W (suc zero) j i) nf)))) ;

  e1 : Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc N)) (lin N) (gkD N k) F.h) f =
    hom-eq (lin W) (lin N) (compH (lin W) (lin (suc N)) (lin N) (gkD N k) F.h) f
      (pwl W (lin N) (compH (lin W) (lin (suc N)) (lin N) (gkD N k) F.h) f (\ i hi ->
         transH (app-compH1 (lin W) (lin (suc N)) (lin N) (gkD N k) F.h (leaf i, hi))
           (transH (lf (pc N k (F.hfN i)) (F.gn i) (pcE i hi)) (symH (valT-tree W N f i hi))))) ;

  e2 : Id (Hom (lin W) Iv) (compH (lin W) (lin (suc N)) Iv (jkD N k) F.h) j =
    hom-eq (lin W) Iv (compH (lin W) (lin (suc N)) Iv (jkD N k) F.h) j
      (pwl W Iv (compH (lin W) (lin (suc N)) Iv (jkD N k) F.h) j (\ i hi ->
         transH (app-compH1 (lin W) (lin (suc N)) Iv (jkD N k) F.h (leaf i, hi))
           (transH (lf (pl N k (F.hfN i)) (F.jn i) (plE i hi)) (symH (valT-tree W (suc zero) j i hi))))) ;
} ;

facP (N k W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (memP N k W f j)) : Hom (lin W) (lin (suc N)) =
  Fact[N, W, f, j].h ;

-- P_k is mono
uniqP (N k W : Nat) (h h' : Hom (lin W) (lin (suc N)))
  (e1 : Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc N)) (lin N) (gkD N k) h) (compH (lin W) (lin (suc N)) (lin N) (gkD N k) h'))
  (e2 : Id (Hom (lin W) Iv) (compH (lin W) (lin (suc N)) Iv (jkD N k) h) (compH (lin W) (lin (suc N)) Iv (jkD N k) h'))
  : Id (Hom (lin W) (lin (suc N))) h h' =
  hom-eq (lin W) (lin (suc N)) h h' (pwl W (lin (suc N)) h h' (\ i hi ->
    transH (valT-tree W (suc N) h i hi)
      (transH (lf (valT W (suc N) h i) (valT W (suc N) h' i) (vEq i hi)) (symH (valT-tree W (suc N) h' i hi)))))
 where {
   -- a value of h is pl + pc of it, i.e. its values under jk and gk
   vOf (h2 : Hom (lin W) (lin (suc N))) (i : Nat) (hi : IsT (leb i W))
     : Id Nat (valT W (suc N) h2 i)
              (plus (valT W (suc zero) (compH (lin W) (lin (suc N)) Iv (jkD N k) h2) i) (valT W N (compH (lin W) (lin (suc N)) (lin N) (gkD N k) h2) i)) =
     symH (transH (apH (\ x -> plus x (valT W N (compH (lin W) (lin (suc N)) (lin N) (gkD N k) h2) i))
                     (transH (valT-comp W (suc N) (suc zero) (jkD N k) h2 i hi) (valT-jk N k (valT W (suc N) h2 i) (valT-range W (suc N) h2 i))))
            (transH (apH (\ x -> plus (pl N k (valT W (suc N) h2 i)) x)
                       (transH (valT-comp W (suc N) N (gkD N k) h2 i hi) (valT-gk N k (valT W (suc N) h2 i) (valT-range W (suc N) h2 i))))
                    (pcpl k N (valT W (suc N) h2 i)))) ;
   vEq (i : Nat) (hi : IsT (leb i W)) : Id Nat (valT W (suc N) h i) (valT W (suc N) h' i) =
     transH (vOf h i hi)
       (transH (apH (\ z -> plus (valT W (suc zero) z i) (valT W N (compH (lin W) (lin (suc N)) (lin N) (gkD N k) h) i)) e2)
         (transH (apH (\ z -> plus (valT W (suc zero) (compH (lin W) (lin (suc N)) Iv (jkD N k) h') i) (valT W N z i)) e1)
                 (symH (vOf h' i hi)))) ; } ;
