-- CPiCart.seg (L3, inside CB, level l): the cartesian map Pi A[s] B[s] ->
-- Pi A B over s (model.tex Thm "type formers", naturality).  Unlike Sigma
-- the fibres are not the same codes: the fibre map tau is transport along
-- PiNat.PiP-nat (CTrFib), followed by the lift of the substitution (CSub).
--
--   tau-val   the values of tau u are those of u, read in G
--   apW-tau   tau u applied at a moved point is u applied, moved

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;
module PP = PresheafPi[a, l].PPi[BC] ;

module PiCart (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[extP G A]) {
  module PN = PP.PiNat[D, G, A, B, s] ;
  A' : PTy[D] = PN.A' ;
  B' : PTy[extP D A'] = PN.B' ;
  module PEG = CPiE[l].PiE[G, A, B] ;
  module PED = CPiE[l].PiE[D, A', B'] ;
  module SEP = CSub[l].SubE[D, G, s, PEG.P] ;
  module SEA = CSub[l].SubE[D, G, s, A] ;
  module SEB = CSub[l].SubE[extP D A', extP G A, liftP D G A s, B] ;
  module TRm = CTrFib[l].TR[D, subTy D G PEG.P s] ;

  P2 : Id (PTy[D]) (subTy D G PEG.P s) PED.P = PN.PiP-nat ;

  ta (W : Ob) (v : PED.TP.EI W) : PEG.TP.EI W = SEP.mV W (TRm.ta PED.P P2 W v) ;

  tanat (V W : Ob) (g : Hom V W) (v : PED.TP.EI W)
    : Id (PEG.TP.EI V) (PEG.TP.E.act V W g (ta W v)) (ta V (PED.TP.E.act V W g v)) =
    transH (SEP.mV-nat V W g (TRm.ta PED.P P2 W v)) (apH (SEP.mV V) (TRm.tanat PED.P P2 V W g v)) ;

  tainj (W : Ob) (v v' : PED.TP.EI W) (P : Id (W0.Ix (D.ob W)) v.1 v'.1) (Q : Id (PEG.TP.EI W) (ta W v) (ta W v'))
    : Id (PED.TP.EI W) v v' =
    TRm.tainj PED.P P2 W v v' P (SEP.mV-inj W (TRm.ta PED.P P2 W v) (TRm.ta PED.P P2 W v') P Q) ;

  bk (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (PEG.P.tob X (s.nt X x))) : W0.Ix (PED.P.tob X x) = TRm.fwV PED.P P2 X x u ;

  bkta (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (PEG.P.tob X (s.nt X x))) : Id (PEG.TP.EI X) (ta X (x, bk X x u)) (s.nt X x, u) =
    apH (SEP.mV X) (TRm.bkta PED.P P2 X x u) ;

  module C = CCart[l, l].Cart[D, PED.P, G, PEG.P, s.nt, s.nt-nat, ta, \ W v -> refl (s.nt W v.1), tanat, tainj, bk, bkta] ;

  ----------------------------------------------------------------------
  -- the fibre map and its values

  tau (I : Ob) (x : W0.Ix (D.ob I)) (u : W0.Ix (PED.PC.PiO I x)) : W0.Ix (PEG.PC.PiO I (s.nt I x)) = TRm.trV PED.P P2 I x u ;

  -- coercion along R undoes the transport back along it
  coe-back (X Y : W0.V) (R : Id W0.V X Y) (u : W0.Ix Y) : Id (W0.Ix Y) (PP.coeIx X Y R (subst W0.V (\ z -> W0.Ix z) Y X (symH R) u)) u =
    idJ W0.V X (\ Y2 R2 -> (u2 : W0.Ix Y2) -> Id (W0.Ix Y2) (PP.coeIx X Y2 R2 (subst W0.V (\ z -> W0.Ix z) Y2 X (symH R2) u2)) u2)
      (\ u2 -> refl u2) Y R u ;

  inv (I : Ob) (x : W0.Ix (D.ob I)) (u : W0.Ix (PED.PC.PiO I x))
    : Id (W0.Ix (PED.PC.PiO I x)) (PP.coeIx (PEG.PC.PiO I (s.nt I x)) (PED.PC.PiO I x) (PN.RJ I x) (tau I x u)) u =
    transH (apH (PP.coeIx (PEG.PC.PiO I (s.nt I x)) (PED.PC.PiO I x) (PN.RJ I x)) (TRm.tr-pw PED.P P2 I x (symH (PN.RJ I x)) u))
           (coe-back (PEG.PC.PiO I (s.nt I x)) (PED.PC.PiO I x) (PN.RJ I x) u) ;

  module TV (I : Ob) (x : W0.Ix (D.ob I)) (u : W0.Ix (PED.PC.PiO I x)) (K : Ob) (k : Hom K I) (a : W0.Ix (A'.tob K (D.act K I k x))) {
    y : W0.Ix (G.ob K) = G.act K I k (s.nt I x) ;
    y' : W0.Ix (G.ob K) = s.nt K (D.act K I k x) ;
    ba : W0.Ix (A.tob K y) = PEG.bk K y y' (PN.hs I x K k) a ;

    res : Id (PEG.TB.EI K) ((y', a), u.1 K k a) (PEG.valE I (s.nt I x) (tau I x u) K k ba) =
      transH (apH (\ c -> ((y', a), c.1 K k a)) (symH (inv I x u)))
        (transH (apH {W0.Ix (B.tob K (y', a))} {PEG.TB.EI K} (\ b -> ((y', a), b)) (PN.trS I x (tau I x u) K k a))
                (symH (PEG.TB.pr-coe K (y, ba) (y', a) (PP.pairpath G A K y y' (PN.hs I x K k) a) ((tau I x u).1 K k ba)))) ;
  } ;

  -- the values of tau u, read in G
  tau-val (I : Ob) (x : W0.Ix (D.ob I)) (u : W0.Ix (PED.PC.PiO I x)) (K : Ob) (k : Hom K I) (a : W0.Ix (A'.tob K (D.act K I k x)))
    : Id (PEG.TB.EI K) (SEB.mV K (PED.valE I x u K k a)) (PEG.valE I (s.nt I x) (tau I x u) K k (TV[I, x, u, K, k, a].ba)) =
    TV[I, x, u, K, k, a].res ;

  -- tau u applied at a moved point
  apW-tau (I : Ob) (x : W0.Ix (D.ob I)) (u : W0.Ix (PED.PC.PiO I x)) (K : Ob) (f : Hom K I) (w' : PED.TA.EI K)
    (p' : Id (W0.Ix (D.ob K)) (D.act K I f x) w'.1) (p : Id (W0.Ix (G.ob K)) (G.act K I f (s.nt I x)) (s.nt K w'.1))
    : Id (PEG.TB.EI K) (SEB.mV K (w', PED.apW I x u K f w' p')) (SEA.mV K w', PEG.apW I (s.nt I x) (tau I x u) K f (SEA.mV K w') p) =
    transH (apH (SEB.mV K) (PED.apW-E' I x u K f w' p'))
      (transH (tau-val I x u K f (PED.bk K (D.act K I f x) w'.1 p' w'.2))
        (symH (PEG.apW-E I (s.nt I x) (tau I x u) K f (SEA.mV K w') p (TV[I, x, u, K, f, PED.bk K (D.act K I f x) w'.1 p' w'.2].ba)
                 (transH (PEG.pp K (G.act K I f (s.nt I x)) (s.nt K (D.act K I f x)) (PN.hs I x K f) (PED.bk K (D.act K I f x) w'.1 p' w'.2))
                         (apH (SEA.mV K) (PED.pp K (D.act K I f x) w'.1 p' w'.2)))))) ;

  opaque inv ; opaque tau-val ; opaque apW-tau ;
} ;
