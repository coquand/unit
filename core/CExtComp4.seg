-- CExtComp4.seg (L5, inside CB, level l): Theorem 7, composition,
-- uniformity (model.tex §6.1): along h every piece restricts side by side:
-- delta (forall-pre), the B-fillers on delta (FBv-cong), the A-filler
-- (Fill's uniformity + kop-cong on the joined side), the side of the fibre
-- of ext over w1 and its extension (the equivalence's uniformity).  The
-- composition structure extComp : Comp eS eT of Ext(alpha).
--
-- Quarry: seg/model GExtComp4, one sieve per side and one forall.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module PR = GPre[l] ;
open PR.PS ;
module GP = CCof[l] ;

module C4 (G : PCtx) (A : PTy[G]) (psi : GP.Cof[G]) (B : PTy[GP.CofL[G, psi].resCtx])
  (al : CPartial[l].PMap[GP.CofL[G, psi].resCtx, B, subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR])
  (eS eT : IPt) (kAS : CLine[l].Lines[G, A].Fill eS)
  (kBS : CLine[l].Lines[GP.CofL[G, psi].resCtx, B].Fill eS)
  (kA1 : CLine[l].Lines[G, A].Fill e1)
  (eal : CEquiv[l].EquivOp GP.CofL[G, psi].resCtx B (subTy GP.CofL[G, psi].resCtx G A GP.CofL[G, psi].inclR) al) {
  open GP.CofL[G, psi] ;
  open CExt[l].ExtDef[G, A, psi] ;
  open ExtB[B, al] ;
  open CExt2[l].ExtB2[G, A, psi, B, al] ;
  open CExt3[l].ExtB3[G, A, psi, B, al] ;
  open CExt4[l].ExtB4[G, A, psi, B, al] ;
  open CExtComp1[l].C1[G, A, psi, B, al, eS, kBS] ;
  open CExtComp2[l].C2[G, A, psi, B, al, eS, kAS, kBS] ;
  open CExtComp3[l].C3[G, A, psi, B, al, eS, eT, kAS, kBS, kA1, eal] ;

  module RFX = CPartial[l].Rel[EA, FX.FibT, FX.FibT, CPartial[l].pmap-id EA FX.FibT] ;

  two : Nat = suc (suc zero) ;

  module Un (Y X : Ob) (h : Hom Y X) (x : KX.TV.EI X) (p : KX.PT.Side[X, x]) {
    xY : KX.TV.EI Y = KX.TV.E.act Y X h x ;
    pY : KX.PT.Side[Y, xY] = KX.PT.rside Y X h x p ;

    module PX' = Pb[X, x, p] ;
    module PY' = Pb[Y, xY, pY] ;
    module CX = Cop[X, x, p] ;
    module CY = Cop[Y, xY, pY] ;

    ------------------------------------------------------------------
    -- delta restricts

    dlEq : Id (Phi Y) (pre Y X h PX'.dl) PY'.dl =
      transH (forall-pre Y X h PX'.Lk)
             (apH (forallS Y) (phiL-ext Y (restrL Y X h PX'.Lk) PY'.Lk (\ W f j -> refl (Q W (x.1.1 W (compH W Y X h f) j))))) ;

    -- the B-filler on delta at h g is the one of the restriction at g
    fbR (W : Ob) (g : Hom W Y) (i : Lands W X PX'.dl (compH W Y X h g)) (i' : Lands W Y PY'.dl g)
      (V : Ob) (g' : Hom V W) (j : Hom V Iv)
      : Id (TB.EI V) (PX'.BW[W, compH W Y X h g, i].BB.FBv V g' j) (PY'.BW[W, g, i'].BB.FBv V g' j) =
      FBv-cong W (KX.TV.E.act W X (compH W Y X h g) x) (KX.TV.E.act W Y g xY) (KX.TV.E.act-o W Y X h g x)
        (KX.PT.rside W X (compH W Y X h g) x p) (KX.PT.rside W Y g xY pY) (KX.PT.rside-o W Y X g h x p)
        (PX'.flAt W (compH W Y X h g) (PX'.hOf W (compH W Y X h g) i)) (PY'.flAt W g (PY'.hOf W g i')) V g' j ;

    -- the sieves of the two joins restrict side by side
    Qe : (n : Nat) -> Id (Phi Y) (pre Y X h (PX'.pick n).pQ) (PY'.pick n).pQ = split {
      zero -> refl (pre Y X h p.pQ) ;
      suc m -> dlEq } ;

    Qe2 : (n : Nat) -> Id (Phi Y) (pre Y X h (CX.pick n).pQ) (CY.pick n).pQ = split {
      zero -> refl (pre Y X h p.pQ) ;
      suc m -> dlEq } ;

    eQ : Id (Phi Y) (pre Y X h PX'.J.side.pQ) PY'.J.side.pQ =
      transH (pre-bigU Y X h two PX'.J.Qs)
        (apH (\ F -> bigU Y two F)
          (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Arith[a].Fin two) (\ k -> Phi Y) (\ k -> pre Y X h (PX'.J.Qs k)) PY'.J.Qs (\ k -> Qe k.1))) ;

    eQ2 : Id (Phi Y) (pre Y X h CX.J2.side.pQ) CY.J2.side.pQ =
      transH (pre-bigU Y X h two CX.J2.Qs)
        (apH (\ F -> bigU Y two F)
          (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Arith[a].Fin two) (\ k -> Phi Y) (\ k -> pre Y X h (CX.J2.Qs k)) CY.J2.Qs (\ k -> Qe2 k.1))) ;

    back (n : Nat) (W : Ob) (g : Hom W Y) (b : Lands W Y (PY'.pick n).pQ g) : Lands W X (PX'.pick n).pQ (compH W Y X h g) =
      lands-pre W Y X h (PX'.pick n).pQ g (lands-sub W Y (PY'.pick n).pQ (pre Y X h (PX'.pick n).pQ) (symH (Qe n)) g b) ;

    back2 (n : Nat) (W : Ob) (g : Hom W Y) (b : Lands W Y (CY.pick n).pQ g) : Lands W X (CX.pick n).pQ (compH W Y X h g) =
      lands-pre W Y X h (CX.pick n).pQ g (lands-sub W Y (CY.pick n).pQ (pre Y X h (CX.pick n).pQ) (symH (Qe2 n)) g b) ;

    ------------------------------------------------------------------
    -- the A-filler restricts

    xAeq : Id (KA.TV.EI Y) (KA.TV.E.act Y X h PX'.xA) PY'.xA = symH (ML.tvM-act Y X h x) ;

    tsA (W : Ob) (g : Hom W Y) (u v : KA.TS.EI W)
      (pu : Id (KA.TV.EI W) u.1 (KA.TV.E.act W X (compH W Y X h g) PX'.xA))
      (pv : Id (KA.TV.EI W) v.1 (KA.TV.E.act W Y g PY'.xA))
      (q : (V : Ob) (g' : Hom V W) (j : Hom V Iv) -> Id (TA.EI V) ((KA.lineL W u).2.1.1 V g' j) ((KA.lineL W v).2.1.1 V g' j))
      : Id (KA.TS.EI W) u v =
      KA.ts-ext W u v
        (transH pu (transH (symH (KA.TV.PE.actC W Y X h g PX'.xA)) (transH (apH (KA.TV.E.act W Y g) xAeq) (symH pv)))) q ;

    evs : (n : Nat) (W : Ob) (g : Hom W Y) (i : Lands W X (PX'.pick n).pQ (compH W Y X h g)) (i' : Lands W Y (PY'.pick n).pQ g)
      -> Id (KA.TS.EI W) ((PX'.pick n).pv W (compH W Y X h g) i) ((PY'.pick n).pv W g i') = split {
      zero -> \ W g i i' ->
        apH (ML.tsM W) (KX.PT.pv-irr X x p W (compH W Y X h g) i (lands-pre W Y X h p.pQ g i')) ;
      suc m -> \ W g i i' ->
        tsA W g (PX'.SD.LS.sv W (compH W Y X h g) i) (PY'.SD.LS.sv W g i')
          (PX'.SD.LS.sv-pt W (compH W Y X h g) i) (PY'.SD.LS.sv-pt W g i')
          (\ V g' j -> transH (PX'.SD.LS.sv-val W (compH W Y X h g) i V g' j)
             (transH (apH (\ z -> toEA V (al.mE V z)) (fbR W g i i' V g' j))
                     (symH (PY'.SD.LS.sv-val W g i' V g' j)))) } ;

    ppA : Id (KA.PT.Side[Y, PY'.xA])
             (subst (KA.TV.EI Y) (\ z -> KA.PT.Side[Y, z]) (KA.TV.E.act Y X h PX'.xA) PY'.xA xAeq (KA.PT.rside Y X h PX'.xA PX'.J.side))
             PY'.J.side =
      KA.PT.side-extH Y (KA.TV.E.act Y X h PX'.xA) PY'.xA xAeq (KA.PT.rside Y X h PX'.xA PX'.J.side) PY'.J.side eQ
        (\ W g i i' ->
          transH (PX'.J.pv-in (bigU-out W Y two PY'.J.Qs g i').1 W (compH W Y X h g)
                    (back (bigU-out W Y two PY'.J.Qs g i').1.1 W g (bigU-out W Y two PY'.J.Qs g i').2)
                    (lands-pre W Y X h PX'.J.side.pQ g i))
                 (evs (bigU-out W Y two PY'.J.Qs g i').1.1 W g
                    (back (bigU-out W Y two PY'.J.Qs g i').1.1 W g (bigU-out W Y two PY'.J.Qs g i').2)
                    (bigU-out W Y two PY'.J.Qs g i').2)) ;

    fillA-R : Id (KA.TS.EI Y) (KA.TS.E.act Y X h (PX'.xA, PX'.fill)) (PY'.xA, PY'.fill) =
      transH (kAS.kunif Y X h PX'.xA PX'.J.side)
        (RKA.kop-cong kAS Y (KA.TV.E.act Y X h PX'.xA) PY'.xA xAeq (KA.PT.rside Y X h PX'.xA PX'.J.side) PY'.J.side ppA) ;

    FAv-R (W : Ob) (g : Hom W Y) (j : Hom W Iv) : Id (TA.EI W) (PX'.FAv W (compH W Y X h g) j) (PY'.FAv W g j) =
      transH (symH (apH (\ M -> M.2.1.1 W g j) (KA.lineL-act Y X h (PX'.xA, PX'.fill))))
             (apH (\ u -> (KA.lineL Y u).2.1.1 W g j) fillA-R) ;

    opaque ppA ; opaque fillA-R ;

    ------------------------------------------------------------------
    -- the side of the fibre restricts

    w1eq : Id (TA.EI Y) (TA.E.act Y X h CX.w1) CY.w1 = transH (CX.w1-act Y h) (FAv-R Y (idH Y) (ptH Y eT)) ;

    wf-eq (W : Ob) (g : Hom W Y) : Id (TA.EI W) (TA.E.act W X (compH W Y X h g) CX.w1) (TA.E.act W Y g CY.w1) =
      transH (symH (TA.PE.actC W Y X h g CX.w1)) (apH (TA.E.act W Y g) w1eq) ;

    ev2 : (n : Nat) (W : Ob) (g : Hom W Y) (i : Lands W X (CX.pick n).pQ (compH W Y X h g)) (i' : Lands W Y (CY.pick n).pQ g)
      -> Id (FX.TF.EI W) ((CX.pick n).pv W (compH W Y X h g) i) ((CY.pick n).pv W g i') = split {
      zero -> \ W g i i' ->
        cfib-eq W (TA.E.act W X (compH W Y X h g) CX.w1) (TA.E.act W Y g CY.w1) (wf-eq W g)
          (CX.el1 W (compH W Y X h g) i) (CY.el1 W g i')
          (apH (\ u -> lvX W u W (idH W) (ptH W eT)) (KX.PT.pv-irr X x p W (compH W Y X h g) i (lands-pre W Y X h p.pQ g i')))
          (CX.eq1 W (compH W Y X h g) i) (CY.eq1 W g i') ;
      suc m -> \ W g i i' ->
        cfib-eq W (TA.E.act W X (compH W Y X h g) CX.w1) (TA.E.act W Y g CY.w1) (wf-eq W g)
          (CX.el2 W (compH W Y X h g) i) (CY.el2 W g i')
          (apH {TB.EI W} {TX.EI W} (fromB W) (fbR W g i i' W (idH W) (ptH W eT)))
          (CX.eq2 W (compH W Y X h g) i) (CY.eq2 W g i') } ;

    ppP : Id (PX.Side[Y, CY.w1])
             (subst (TA.EI Y) (\ z -> PX.Side[Y, z]) (TA.E.act Y X h CX.w1) CY.w1 w1eq (PX.rside Y X h CX.w1 CX.J2.side))
             CY.J2.side =
      PX.side-extH Y (TA.E.act Y X h CX.w1) CY.w1 w1eq (PX.rside Y X h CX.w1 CX.J2.side) CY.J2.side eQ2
        (\ W g i i' ->
          transH (CX.J2.pv-in (bigU-out W Y two CY.J2.Qs g i').1 W (compH W Y X h g)
                    (back2 (bigU-out W Y two CY.J2.Qs g i').1.1 W g (bigU-out W Y two CY.J2.Qs g i').2)
                    (lands-pre W Y X h CX.J2.side.pQ g i))
                 (ev2 (bigU-out W Y two CY.J2.Qs g i').1.1 W g
                    (back2 (bigU-out W Y two CY.J2.Qs g i').1.1 W g (bigU-out W Y two CY.J2.Qs g i').2)
                    (bigU-out W Y two CY.J2.Qs g i').2)) ;

    vEeq : Id (FX.TF.EI Y) (FX.TF.E.act Y X h CX.vE) CY.vE =
      transH (E3.extEquiv.kunif Y X h CX.w1 CX.J2.side)
        (RFX.kop-cong E3.extEquiv Y (TA.E.act Y X h CX.w1) CY.w1 w1eq (PX.rside Y X h CX.w1 CX.J2.side) CY.J2.side ppP) ;

    opaque ppP ; opaque vEeq ;

    unif : Id (TT.EI Y) (TT.E.act Y X h (x, CX.cop)) (xY, CY.cop) =
      CK.SE.mV-inj Y (TT.E.act Y X h (x, CX.cop)) (xY, CY.cop) (refl xY)
        (KX'.tv-eq Y (CK.SE.mV Y (TT.E.act Y X h (x, CX.cop))) (CK.SE.mV Y (xY, CY.cop)) (refl xY.1)
          (transH (apH (KX'.endE Y) (symH (CK.SE.mV-nat Y X h (x, CX.cop))))
            (transH (KX'.endE-act Y X h (CK.SE.mV X (x, CX.cop)))
              (transH (apH (TX.E.act Y X h) CX.cop-E)
                (transH (symH (FX.fibB-act Y X h CX.vE))
                  (transH (apH (FX.fibB Y) vEeq) (symH CY.cop-E))))))) ;
  } ;

  ----------------------------------------------------------------------
  -- Theorem 7: the composition of Ext(alpha) from eS to eT

  extComp : CK.Comp =
    new CPartial[l].Rel[KX.TV.E, KX.SFm.SF, CK.Tend, CK.endL].RC[\ X x p -> Cop[X, x, p].cop, cside, \ Y X h x p -> Un[Y, X, h, x, p].unif] ;
} ;
