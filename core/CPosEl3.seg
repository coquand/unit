-- CPosEl3.seg (L8, posets): El is fibrant, part 3: the coherence of the
-- local compositions (CGlueRC's Coh).  At x = (l , a) and g : Y -> Z, the
-- composite at the restricted point o x g of F_x's composition and that
-- at o (x g) of F_(x g)'s agree, read in El.  F_(x g) is F_x along
-- g * [1] (R); by J on R the second is F_x's composition moved along
-- g * [1] (selEq: the code's structure IS the moved one), whose composite
-- is F_x's at the moved point (kopMv); the moved point is o x g
-- (pointwise, and read in El through the Yoneda cart, oio), and the sides
-- agree since their images in El do (the Yoneda cart is injective).
--
-- Quarry: seg/model PElL2a (Coh), PElL2.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module E2 = CPosEl2[a] ;
module PB = E1.PB ;
module UU = E1.UU ;
module FGU = E1.FGU ;
module TE = E1.TE ;

module Coh (e e' : El Iv)
  (sel : (Z : Ob) (F : UU.U0 Z) -> PB.CLine[a].Lines[E1.yP Z, F.1].CompK[e, e'].Comp)
  (selEq : (Z' Z : Ob) (g : Hom Z' Z) (F : UU.U0 Z)
     -> Id (PB.CLine[a].Lines[E1.yP Z', (UU.uAct Z' Z g F).1].CompK[e, e'].Comp) (sel Z' (UU.uAct Z' Z g F))
           (PB.CFibSub[a].FibSub[E1.yP Z', E1.yP Z, PB.GYon[a].yH Z' Z g, F.1].C.MoveComp[e, e'].move (sel Z F)))
  (Z : Ob) (x : PB.CLine[a+].EndKit[UU.UCtx, UU.EGen, e].TV.EI Z) (Y : Ob) (g : Hom Y Z) {
  module DE = PB.CLine[a+].EndKit[UU.UCtx, UU.EGen, e] ;
  lam : V1.Ix (FGU.ob Z) = x.1 ;
  ZI : Ob = prodP Z Iv ;
  YI : Ob = prodP Y Iv ;

  cyl : Hom YI ZI = pairH Z Iv YI (compH YI Y Z g (pr1 Y Iv)) (pr2 Y Iv) ;

  cylp (V : Ob) (f : Hom V Y) (j : Hom V Iv)
    : Id (Hom V ZI) (pairH Z Iv V (compH V Y Z g f) j) (compH V YI ZI cyl (pairH Y Iv V f j)) =
    symH (transH (E2.pair-comp V YI Z (pairH Y Iv V f j) (compH YI Y Z g (pr1 Y Iv)) (pr2 Y Iv))
           (transH (apH (\ k -> pairH Z Iv V k (compH V YI Iv (pr2 Y Iv) (pairH Y Iv V f j)))
                      (transH (comp-assoc V YI Y Z g (pr1 Y Iv) (pairH Y Iv V f j)) (apH (compH V Y Z g) (pr1-pair Y Iv V f j))))
                   (apH (\ k -> pairH Z Iv V (compH V Y Z g f) k) (pr2-pair Y Iv V f j)))) ;

  Fx : UU.U0 ZI = E2.FC Z lam ;
  lg : V1.Ix (FGU.ob Y) = FGU.actF Y Z g lam ;
  Fg : UU.U0 YI = UU.uAct YI ZI cyl Fx ;

  module YX = E1.YG.Yc[ZI, Fx] ;
  module AX = YX.K.AtEnd[e] ;
  module MX = YX.K.MoveComp[e, e'] ;
  module PX = E2.Pt[e, Z, lam, Fx, E2.QdC Z lam, x.2] ;
  module FZ = PB.CLine[a].FC[E1.yP ZI] ;
  module RelX = PB.CPartial[a].Rel[AX.EK'.TV.E, AX.EK'.SFm.SF, MX.CK'.Tend, MX.CK'.endL] ;

  xg : DE.TV.EI Y = DE.TV.E.act Y Z g x ;

  module FS = PB.CFibSub[a].FibSub[E1.yP YI, E1.yP ZI, PB.GYon[a].yH YI ZI cyl, Fx.1] ;
  module SC = FS.C ;
  module SA = SC.AtEnd[e] ;
  module SM = SC.MoveComp[e, e'] ;

  c : MX.CK'.Comp = sel ZI Fx ;

  -- F_(x g) is F_x along g * [1]
  R : Id (UU.U0 YI) Fg (E2.FC Y lg) =
    transH (lam.2 YI ZI cyl (pr1 Z Iv) (pr2 Z Iv))
      (transH (apH (\ k -> lam.1 YI k (compH YI ZI Iv (pr2 Z Iv) cyl)) (pr1-pair Z Iv YI (compH YI Y Z g (pr1 Y Iv)) (pr2 Y Iv)))
              (apH (\ k -> lam.1 YI (compH YI Y Z g (pr1 Y Iv)) k) (pr2-pair Z Iv YI (compH YI Y Z g (pr1 Y Iv)) (pr2 Y Iv)))) ;

  -- the left-hand side
  lhs (sg : AX.EK'.PT.Side[Y, AX.EK'.TV.E.act Y Z g PX.o]) : MX.TT.EI Y =
    MX.mT Y (AX.EK'.TV.E.act Y Z g PX.o, c.kop Y (AX.EK'.TV.E.act Y Z g PX.o) sg) ;

  module B (Qd' : (W : Ob) (g' : Hom W Y) (j : Hom W Iv) -> Id (UU.U0 W) (UU.uAct W YI (pairH Y Iv W g' j) Fg) (lg.1 W g' j)) {
    module YG = E1.YG.Yc[YI, Fg] ;
    module AG = YG.K.AtEnd[e] ;
    module MG = YG.K.MoveComp[e, e'] ;
    module PG = E2.Pt[e, Y, lg, Fg, Qd', xg.2] ;

    Ps (W : Ob) (k : Hom W YI) : Id (UU.U0 W) (YG.s W k) (YX.s W (compH W YI ZI cyl k)) = symH (UU.uAct-o W YI ZI cyl k Fx) ;

    Pta (W : Ob) (v : YG.TF.EI W) : Id (TE.EI W) (YG.ta W v) (YX.ta W (FS.SE.mV W v)) =
      E1.YG.pairE W (YG.s W v.1) (YX.s W (compH W YI ZI cyl v.1)) (Ps W v.1) (YG.ta W v).2 (YX.ta W (FS.SE.mV W v)).2
        (transH (UU.substF W (YG.s W v.1) (YX.s W (compH W YI ZI cyl v.1)) (Ps W v.1) (YG.ta W v).2)
           (PB.CExtEq1.sV-two (Fg.1.tob W v.1) (UU.fib0 W (YG.s W v.1)) (UU.fib0 W (YX.s W (compH W YI ZI cyl v.1)))
              (symH (YG.Po W v.1)) (ap (UU.U0 W) W0.V (UU.fib0 W) (YG.s W v.1) (YX.s W (compH W YI ZI cyl v.1)) (Ps W v.1))
              (symH (YX.Po W (compH W YI ZI cyl v.1))) v.2)) ;

    PsV (e2 : El Iv) (W : Ob) (z : YG.K.AtEnd[e2].EK'.TV.EI W)
      : Id (YX.K.AtEnd[e2].EK.TV.EI W) (YG.K.AtEnd[e2].sV W z) (YX.K.AtEnd[e2].sV W (SC.AtEnd[e2].sV W z)) =
      YX.K.AtEnd[e2].EK.tv-eq W (YG.K.AtEnd[e2].sV W z) (YX.K.AtEnd[e2].sV W (SC.AtEnd[e2].sV W z))
        (FGU.fam-eq W (YG.K.sI W z.1) (YX.K.sI W (SC.sI W z.1)) (\ V f j -> Ps V (z.1.1 V f j)))
        (transH (YG.K.AtEnd[e2].sVE W z)
          (transH (Pta W (YG.K.AtEnd[e2].EK'.endE W z))
            (symH (transH (YX.K.AtEnd[e2].sVE W (SC.AtEnd[e2].sV W z)) (apH (YX.ta W) (SC.AtEnd[e2].sVE W z)))))) ;

    PmS (W : Ob) (u : AG.EK'.TS.EI W) : Id (AX.EK.TS.EI W) (AG.mS W u) (AX.mS W (SA.mS W u)) =
      AX.EK.ts-ext W (AG.mS W u) (AX.mS W (SA.mS W u))
        (transH (AG.mSpt W u) (transH (PsV e W u.1) (symH (transH (AX.mSpt W (SA.mS W u)) (apH (AX.sV W) (SA.mSpt W u))))))
        (\ V f j -> transH (apH (\ M -> M.2.1.1 V f j) (AG.mS-line W u))
           (transH (Pta V ((AG.EK'.lineL W u).2.1.1 V f j))
             (symH (transH (apH (\ M -> M.2.1.1 V f j) (AX.mS-line W (SA.mS W u)))
                           (apH (\ M -> YX.ta V (M.2.1.1 V f j)) (SA.mS-line W u)))))) ;

    PmT (W : Ob) (v : MG.TT'.EI W) : Id (MX.TT.EI W) (MG.mT W v) (MX.mT W (SM.mT W v)) =
      MX.CK.SE.mV-inj W (MG.mT W v) (MX.mT W (SM.mT W v)) (PsV e W v.1) (PsV e' W (MG.CK'.SE.mV W v)) ;

    -- the moved point is the restricted point
    Pl : Id (W0.Ix (FZ.ob Y)) (FZ.actF Y Z g PX.ell) (SC.sI Y PG.ell) =
      FZ.fam-eq Y (FZ.actF Y Z g PX.ell) (SC.sI Y PG.ell) (\ V f j -> cylp V f j) ;

    P : Id (AX.EK'.TV.EI Y) (AX.EK'.TV.E.act Y Z g PX.o) (SA.sV Y PG.o) =
      AX.EK'.tv-eq Y (AX.EK'.TV.E.act Y Z g PX.o) (SA.sV Y PG.o) Pl
        (YX.tainj Y (AX.EK'.endE Y (AX.EK'.TV.E.act Y Z g PX.o)) (AX.EK'.endE Y (SA.sV Y PG.o))
           (apH (\ y -> y.1 Y (idH Y) (constH Y Iv e)) Pl)
           (transH (symH (AX.sVE Y (AX.EK'.TV.E.act Y Z g PX.o)))
             (transH (apH (DE.endE Y) (AX.sV-nat Y Z g PX.o))
               (transH (apH (\ w -> DE.endE Y (DE.TV.E.act Y Z g w)) PX.oio)
                 (transH (symH (apH (DE.endE Y) PG.oio))
                   (transH (AG.sVE Y PG.o)
                     (transH (Pta Y (AG.EK'.endE Y PG.o)) (symH (apH (YX.ta Y) (SA.sVE Y PG.o)))))))))) ;

    module M (sg : AX.EK'.PT.Side[Y, AX.EK'.TV.E.act Y Z g PX.o]) (sg' : AG.EK'.PT.Side[Y, PG.o])
      (HQ : Id (PB.Phi Y) sg.pQ sg'.pQ)
      (Hv : (V : Ob) (f : Hom V Y) (i : PB.Lands V Y sg.pQ f) (i' : PB.Lands V Y sg'.pQ f)
            -> Id (AX.EK.TS.EI V) (AX.mS V (sg.pv V f i)) (AG.mS V (sg'.pv V f i'))) {
      Rs : Id (AX.EK'.PT.Side[Y, SA.sV Y PG.o])
              (subst (AX.EK'.TV.EI Y) (\ z -> AX.EK'.PT.Side[Y, z]) (AX.EK'.TV.E.act Y Z g PX.o) (SA.sV Y PG.o) P sg)
              (SM.mside c Y PG.o sg') =
        AX.EK'.PT.side-extH Y (AX.EK'.TV.E.act Y Z g PX.o) (SA.sV Y PG.o) P sg (SM.mside c Y PG.o sg') HQ
          (\ V f i i' -> AX.mS-inj V (sg.pv V f i) ((SM.mside c Y PG.o sg').pv V f i')
             (transH (sg.ppt V f i) (transH (apH (AX.EK'.TV.E.act V Y f) P) (symH ((SM.mside c Y PG.o sg').ppt V f i'))))
             (transH (Hv V f i i') (PmS V (sg'.pv V f i')))) ;

      res : Id (MX.TT.EI Y) (lhs sg) (MG.mT Y (PG.o, (sel YI Fg).kop Y PG.o sg')) =
        transH (apH (MX.mT Y) (RelX.kop-cong c Y (AX.EK'.TV.E.act Y Z g PX.o) (SA.sV Y PG.o) P sg (SM.mside c Y PG.o sg') Rs))
          (transH (symH (apH (MX.mT Y) (SM.kopMv c Y PG.o sg')))
            (transH (symH (PmT Y (PG.o, (SM.move c).kop Y PG.o sg')))
              (apH (\ c2 -> MG.mT Y (PG.o, c2.kop Y PG.o sg')) (symH (selEq YI ZI cyl Fx))))) ;
    } ;
  } ;

  -- by J on R
  cohG (F' : UU.U0 YI) (R' : Id (UU.U0 YI) Fg F')
    : (Qd' : (W : Ob) (g' : Hom W Y) (j : Hom W Iv) -> Id (UU.U0 W) (UU.uAct W YI (pairH Y Iv W g' j) F') (lg.1 W g' j))
      (sg : AX.EK'.PT.Side[Y, AX.EK'.TV.E.act Y Z g PX.o])
      (sg' : E1.YG.Yc[YI, F'].K.AtEnd[e].EK'.PT.Side[Y, E2.Pt[e, Y, lg, F', Qd', xg.2].o])
      (HQ : Id (PB.Phi Y) sg.pQ sg'.pQ)
      (Hv : (V : Ob) (f : Hom V Y) (i : PB.Lands V Y sg.pQ f) (i' : PB.Lands V Y sg'.pQ f)
            -> Id (AX.EK.TS.EI V) (AX.mS V (sg.pv V f i)) (E1.YG.Yc[YI, F'].K.AtEnd[e].mS V (sg'.pv V f i')))
      -> Id (MX.TT.EI Y) (lhs sg)
            (E1.YG.Yc[YI, F'].K.MoveComp[e, e'].mT Y (E2.Pt[e, Y, lg, F', Qd', xg.2].o, (sel YI F').kop Y E2.Pt[e, Y, lg, F', Qd', xg.2].o sg')) =
    idJ (UU.U0 YI) Fg
      (\ F2 R2 -> (Qd' : (W : Ob) (g' : Hom W Y) (j : Hom W Iv) -> Id (UU.U0 W) (UU.uAct W YI (pairH Y Iv W g' j) F2) (lg.1 W g' j))
         (sg : AX.EK'.PT.Side[Y, AX.EK'.TV.E.act Y Z g PX.o])
         (sg' : E1.YG.Yc[YI, F2].K.AtEnd[e].EK'.PT.Side[Y, E2.Pt[e, Y, lg, F2, Qd', xg.2].o])
         (HQ : Id (PB.Phi Y) sg.pQ sg'.pQ)
         (Hv : (V : Ob) (f : Hom V Y) (i : PB.Lands V Y sg.pQ f) (i' : PB.Lands V Y sg'.pQ f)
               -> Id (AX.EK.TS.EI V) (AX.mS V (sg.pv V f i)) (E1.YG.Yc[YI, F2].K.AtEnd[e].mS V (sg'.pv V f i')))
         -> Id (MX.TT.EI Y) (lhs sg)
               (E1.YG.Yc[YI, F2].K.MoveComp[e, e'].mT Y (E2.Pt[e, Y, lg, F2, Qd', xg.2].o, (sel YI F2).kop Y E2.Pt[e, Y, lg, F2, Qd', xg.2].o sg')))
      (\ Qd' sg sg' HQ Hv -> B[Qd'].M[sg, sg', HQ, Hv].res)
      F' R' ;
} ;
