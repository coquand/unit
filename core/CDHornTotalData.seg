-- The two prism-chain directions with a common dependent interface.
level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
open Trees[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ;
open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CDCapBase[a] ;
module DB = CDeltaBase[a].DB ;
module W0 = V[lz] ;

open CDHornDirection[a] ;

module Totals (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (h : CDHornFib[a, lz].DH[G, A].isFib) {
  module TA = DB.GPre[lz].TyL[G, A] ;
  module FC = DB.CLine[lz].FC[G] ;

  module AtLine (N : Nat) (x : W0.Ix (FC.ob N)) {
    module P = CDGlue[a, lz].PL[G, A, N, x.1, x.2] ;
    module PF = CDPrismFill[a, lz].PF[G, A, h, N, x.1, x.2] ;

    record Total (d : Bool) (L : P.PLine[S0 N (end-number d)]) {
      v (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : TA.EI W ;
      pt (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : Id (TA.Pt W) (TA.pr1 W (v W f j)) (x.1 W f j) ;
      nat (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
        : Id (TA.EI V) (TA.E.act V W g (v W f j))
            (v V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)) ;
      side (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (p : IsT ((S0 N (end-number d)).1 W f j))
        : Id (TA.EI W) (v W f j) (L.v W f j p) ;
    } ;

    total : (d : Bool) (L : P.PLine[S0 N (end-number d)]) -> Total[d, L] = split {
      true -> \ L -> new Total[true, L, PF.FT[L].tot, PF.FT[L].tot-pt, PF.FT[L].tot-nat, PF.FT[L].tot-S0] ;
      false -> \ L -> new Total[false, L, PF.FF[L].tot, PF.FF[L].tot-pt, PF.FF[L].tot-nat, PF.FF[L].tot-S0] } ;
  } ;
} ;
