-- CDNormA.seg (L8, Delta): seg/model DNormA.seg ported (module names only).  Was: degenerate problems on Delta (the set-up of the normalised
-- fillers, DNormB / DNormC; the decision is a parameter, supplied
-- classically by DeltaHornBox).
--
--   DegId N b i     b = s_i^* (d_i^* b): b is degenerate along s_i
--   DegFound N b    the first such i <= N (with its minimality), or none
--   deg-of          s_j^* c is degenerate along j
--   SidesAt         an element agrees with the sides of a problem;
--                   sides-tr (along an equality of problems), sides-pull
--                   (restriction)
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
open CDSimpId[a] ;

module NA (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;

  DegId (N : Nat) (b : Prob (suc N)) (i : Nat) : U lz =
    Id (Prob (suc N)) b (resP (suc N) N (dgH N i) (resP N (suc N) (dl N i) b)) ;

  DegFound (N : Nat) (b : Prob (suc N)) : U lz =
    Arith[lz].Plus ((i : Nat) * (IsT (leb i N) * (DegId N b i * ((i' : Nat) -> IsT (ltb i' i) -> DegId N b i' -> Empty))))
          ((i : Nat) -> IsT (leb i N) -> DegId N b i -> Empty) ;

  ----------------------------------------------------------------------
  -- restriction along the identity and along composites

  resP-id (M : Nat) (b : Prob M) : Id (Prob M) (resP M M (idH (lin M)) b) b =
    Sigma-path (KA.TV.EI M) (\ z -> KA.PT.Side[M, z]) (KA.TV.E.act M M (idH (lin M)) b.1) b.1
      (KA.PT.rside M M (idH (lin M)) b.1 b.2) b.2 (KA.TV.E.act-id M b.1) (KA.PT.rside-id M b.1 b.2) ;

  resP-comp (M'' M' M : Nat) (g : Hom (lin M'') (lin M')) (h : Hom (lin M') (lin M)) (k : Hom (lin M'') (lin M))
    (E : Id (Hom (lin M'') (lin M)) (compH (lin M'') (lin M') (lin M) h g) k) (b : Prob M)
    : Id (Prob M'') (resP M'' M' g (resP M' M h b)) (resP M'' M k b) =
    transH (symH (resP-o M'' M' M g h b)) (resP-eq M'' M (compH (lin M'') (lin M') (lin M) h g) k E b) ;

  -- d_j^* s_j^* c = c ,  d_{j+1}^* s_j^* c = c
  ds-id0 (N j : Nat) (hj : IsT (leb j (suc N))) (c : Prob N)
    : Id (Prob N) (resP N (suc N) (dl N j) (resP (suc N) N (dgH N j) c)) c =
    transH (resP-comp N (suc N) N (dl N j) (dgH N j) (idH (lin N)) (sd-id0 N j hj) c) (resP-id N c) ;

  ds-id1 (N j : Nat) (hj : IsT (leb j N)) (c : Prob N)
    : Id (Prob N) (resP N (suc N) (dl N (suc j)) (resP (suc N) N (dgH N j) c)) c =
    transH (resP-comp N (suc N) N (dl N (suc j)) (dgH N j) (idH (lin N)) (sd-id1 N j hj) c) (resP-id N c) ;

  -- s_j^* c is degenerate along j
  deg-of (N j : Nat) (hj : IsT (leb j N)) (c : Prob N) : DegId N (resP (suc N) N (dgH N j) c) j =
    symH (apH (resP (suc N) N (dgH N j)) (ds-id0 N j (leb-step j N hj) c)) ;

  ----------------------------------------------------------------------
  -- agreement with the sides

  SidesAt (M : Nat) (b : Prob M) (u : KA.TS.EI M) : U lz =
    (W : Nat) (f : Hom (lin W) (lin M)) (i : DB.Lands W M b.2.pQ f)
    -> Id (KA.TS.EI W) (KA.TS.E.act W M f u) (b.2.pv W f i) ;

  sides-tr (M : Nat) (b b' : Prob M) (E : Id (Prob M) b b') (u : KA.TS.EI M) (s : SidesAt M b' u) : SidesAt M b u =
    idJ (Prob M) b (\ c E2 -> SidesAt M c u -> SidesAt M b u) (\ s0 -> s0) b' E s ;

  sides-pull (M' M : Nat) (h : Hom (lin M') (lin M)) (c : Prob M) (u : KA.TS.EI M) (s : SidesAt M c u)
    : SidesAt M' (resP M' M h c) (KA.TS.E.act M' M h u) = \ W f i ->
    transH (KA.TS.PE.actC W M' M h f u)
      (s W (compH (lin W) (lin M') (lin M) h f) (DB.lands-pre W M' M h c.2.pQ f i)) ;

  ----------------------------------------------------------------------
  -- two degeneracies (i <= j', j = j'+1): for b = s_j^* c,
  --   d_i^* b = s_{j'}^* (d_i^* c)                         (one1)
  -- and if b is also degenerate along i, then so is c   (degTwo)

  one1 (N' i j' : Nat) (ij : IsT (leb i j')) (jN : IsT (leb j' N')) (c : Prob (suc N'))
    : Id (Prob (suc N')) (resP (suc N') (suc (suc N')) (dl (suc N') i) (resP (suc (suc N')) (suc N') (dgH (suc N') (suc j')) c))
                         (resP (suc N') N' (dgH N' j') (resP N' (suc N') (dl N' i) c)) =
    transH (resP-comp (suc N') (suc (suc N')) (suc N') (dl (suc N') i) (dgH (suc N') (suc j'))
              (compH (lin (suc N')) (lin N') (lin (suc N')) (dl N' i) (dgH N' j')) (sd-lo N' j' i ij jN) c)
           (resP-o (suc N') N' (suc N') (dgH N' j') (dl N' i) c) ;

  -- the case split of degTwo, at an abstract problem z over N'
  dsd (N' i j' : Nat) (ij : IsT (leb i j')) (jN : IsT (leb j' N')) (z : Prob N')
    : Id (Prob (suc N')) (resP (suc N') (suc (suc N')) (dl (suc N') (suc j')) (resP (suc (suc N')) (suc N') (dgH (suc N') i) (resP (suc N') N' (dgH N' j') z)))
                         (resP (suc N') N' (dgH N' i) z) =
    eqNDecL (Id (Prob (suc N')) (resP (suc N') (suc (suc N')) (dl (suc N') (suc j')) (resP (suc (suc N')) (suc N') (dgH (suc N') i) (resP (suc N') N' (dgH N' j') z)))
                                (resP (suc N') N' (dgH N' i) z)) i j'
      (\ q -> transH (apH (\ x -> resP (suc N') (suc (suc N')) (dl (suc N') (suc x)) (resP (suc (suc N')) (suc N') (dgH (suc N') i) (resP (suc N') N' (dgH N' j') z))) (symH q))
                (transH (ds-id1 (suc N') i (leb-trans i j' (suc N') ij (leb-step j' N' jN)) (resP (suc N') N' (dgH N' j') z))
                        (apH (\ x -> resP (suc N') N' (dgH N' x) z) (symH q))))
      (\ nq -> transH (resP-comp (suc N') (suc (suc N')) (suc N') (dl (suc N') (suc j')) (dgH (suc N') i)
                         (compH (lin (suc N')) (lin N') (lin (suc N')) (dl N' j') (dgH N' i))
                         (sd-hi N' i j' (leb-neq i j' ij nq) (leb-step j' N' jN)) (resP (suc N') N' (dgH N' j') z))
                  (transH (resP-o (suc N') N' (suc N') (dgH N' i) (dl N' j') (resP (suc N') N' (dgH N' j') z))
                          (apH (resP (suc N') N' (dgH N' i)) (ds-id0 N' j' (leb-step j' N' jN) z)))) ;

  opaque dsd ;

  degTwo (N' i j' : Nat) (ij : IsT (leb i j')) (jN : IsT (leb j' N')) (c : Prob (suc N'))
    (E : DegId (suc N') (resP (suc (suc N')) (suc N') (dgH (suc N') (suc j')) c) i) : DegId N' c i =
    calc (Prob (suc N')) {
        c
      =< symH (ds-id0 (suc N') (suc j') (leb-step j' N' jN) c) >
        resP (suc N') (suc (suc N')) (dl (suc N') (suc j')) (resP (suc (suc N')) (suc N') (dgH (suc N') (suc j')) c)
      =< apH (resP (suc N') (suc (suc N')) (dl (suc N') (suc j'))) E >
        resP (suc N') (suc (suc N')) (dl (suc N') (suc j')) (resP (suc (suc N')) (suc N') (dgH (suc N') i) (resP (suc N') (suc (suc N')) (dl (suc N') i) (resP (suc (suc N')) (suc N') (dgH (suc N') (suc j')) c)))
      =< apH (\ z -> resP (suc N') (suc (suc N')) (dl (suc N') (suc j')) (resP (suc (suc N')) (suc N') (dgH (suc N') i) z)) (one1 N' i j' ij jN c) >
        resP (suc N') (suc (suc N')) (dl (suc N') (suc j')) (resP (suc (suc N')) (suc N') (dgH (suc N') i) (resP (suc N') N' (dgH N' j') (resP N' (suc N') (dl N' i) c)))
      =< dsd N' i j' ij jN (resP N' (suc N') (dl N' i) c) >
        resP (suc N') N' (dgH N' i) (resP N' (suc N') (dl N' i) c) } ;

  opaque one1 ; opaque degTwo ;
} ;
