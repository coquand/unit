-- CDeltaBase.seg (L8, Delta): the simplex category as an instance of the
-- base CB (model.tex §8.2).  Objects n : Nat for [n] = lin n, maps the
-- monotone maps; Phi [n] the decidable sieves (CSieve), closed under finite
-- unions; the end points of [1] as sieves; forall along the interval
-- decided on the shuffles P_k : [W+1] -> [W] * [1] (every simplex of the
-- prism factors through one: CDeltaFact.Fact); the connections min / max
-- of [1], pointwise (CPosBase).
--
-- Quarry: seg/model DeltaBase, DeltaForall.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CDeltaNat[a] ;
module PBs = CPosBase[a] ;
module DF = CDeltaFact[a] ;

------------------------------------------------------------------------
-- the canonical decidable sieves of Delta

module DS = CSieve[a].Sieves[W0.natV, \ n m -> homV (lin n) (lin m), \ n -> idH (lin n),
  \ X Y Z g f -> compH (lin X) (lin Y) (lin Z) g f, \ L K J I f g h -> comp-assoc (lin L) (lin K) (lin J) (lin I) f g h] ;

subS (W : Nat) (Y : Ob) (k : Hom (lin W) Y) (Q : Subset Y) : DS.Phi W =
  (\ V g -> PBs.isIn (lin V) Y (compH (lin V) (lin W) Y k g) Q,
   \ V' V g g' i -> PBs.isIn-complete (lin V') Y (compH (lin V') (lin W) Y k (compH (lin V') (lin V) (lin W) g g')) Q
       (PBs.plands-eq (lin V') Y Q (compH (lin V') (lin V) Y (compH (lin V) (lin W) Y k g) g') (compH (lin V') (lin W) Y k (compH (lin V') (lin V) (lin W) g g'))
          (comp-assoc (lin V') (lin V) (lin W) Y k g g')
          (PosetSub.lands-comp (lin V') (lin V) Y Q (compH (lin V) (lin W) Y k g) g' (PBs.isIn-sound (lin V) Y (compH (lin V) (lin W) Y k g) Q i)))) ;

-- the two end points of [1]
dptS (e : El Iv) : DS.Phi (suc zero) = subS (suc zero) Iv (idH Iv) (PosetSub.ptS e) ;

dlands-pt (W : Nat) (e : El Iv) (g : Hom (lin W) Iv) (i : DS.Lands W (suc zero) (dptS e) g) : Id (Hom (lin W) Iv) g (constH (lin W) Iv e) =
  transH (symH (comp-idl (lin W) Iv g))
    (PosetSub.lands-pt (lin W) e (compH (lin W) Iv Iv (idH Iv) g) (PBs.isIn-sound (lin W) Iv (compH (lin W) Iv Iv (idH Iv) g) (PosetSub.ptS e) i)) ;

dpt-lands (W : Nat) (e : El Iv) : DS.Lands W (suc zero) (dptS e) (constH (lin W) Iv e) =
  PBs.isIn-complete (lin W) Iv (compH (lin W) Iv Iv (idH Iv) (constH (lin W) Iv e)) (PosetSub.ptS e)
    (PBs.plands-eq (lin W) Iv (PosetSub.ptS e) (constH (lin W) Iv e) (compH (lin W) Iv Iv (idH Iv) (constH (lin W) Iv e))
       (symH (comp-idl (lin W) Iv (constH (lin W) Iv e))) (PosetSub.pt-lands (lin W) e)) ;

dpt-disj (W : Nat) (g : Hom (lin W) Iv) (i : DS.Lands W (suc zero) (dptS e0) g) (i' : DS.Lands W (suc zero) (dptS e1) g) : Empty =
  PosetSub.pt-disj (lin W) (compH (lin W) Iv Iv (idH Iv) g)
    (PBs.isIn-sound (lin W) Iv (compH (lin W) Iv Iv (idH Iv) g) (PosetSub.ptS e0) i)
    (PBs.isIn-sound (lin W) Iv (compH (lin W) Iv Iv (idH Iv) g) (PosetSub.ptS e1) i') ;

------------------------------------------------------------------------
-- forall along the interval, decided on the shuffles

PhiLD (X : Nat) : U a =
  (L : (W : Nat) -> Hom (lin W) (lin X) -> Hom (lin W) Iv -> DS.Phi W)
  * ((V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin X)) (j : Hom (lin W) Iv)
     -> Id (DS.Phi V) (DS.pre V W g (L W f j)) (L V (compH (lin V) (lin W) (lin X) f g) (compH (lin V) (lin W) Iv j g))) ;

HoldsLD (X : Nat) (L : PhiLD X) (W : Nat) (f : Hom (lin W) (lin X)) : U a =
  (V : Nat) (g : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) -> DS.Lands V V (L.1 V (compH (lin V) (lin W) (lin X) f g) j) (idH (lin V)) ;

dlands-sub (W X : Nat) (Q Q' : DS.Phi X) (e : Id (DS.Phi X) Q Q') (f : Hom (lin W) (lin X)) (i : DS.Lands W X Q f) : DS.Lands W X Q' f =
  subst (DS.Phi X) (\ q -> DS.Lands W X q f) Q Q' e i ;

dlands-hom (W X : Nat) (Q : DS.Phi X) (f f' : Hom (lin W) (lin X)) (p : Id (Hom (lin W) (lin X)) f f') (i : DS.Lands W X Q f) : DS.Lands W X Q f' =
  subst (Hom (lin W) (lin X)) (\ k -> DS.Lands W X Q k) f f' p i ;

-- the line at the shuffle k
atK (X : Nat) (L : PhiLD X) (W : Nat) (f : Hom (lin W) (lin X)) (k : Nat) : Bool =
  (L.1 (suc W) (compH (lin (suc W)) (lin W) (lin X) f (DF.gkD W k)) (DF.jkD W k)).1 (suc W) (idH (lin (suc W))) ;

testD (X : Nat) (L : PhiLD X) (W : Nat) (f : Hom (lin W) (lin X)) : Bool = forallUp W (atK X L W f) ;

-- a line holding at the identity of [Vk] holds along h : [V] -> [Vk]
pullD (X : Nat) (L : PhiLD X) (Vk V : Nat) (f' : Hom (lin Vk) (lin X)) (jk : Hom (lin Vk) Iv) (h : Hom (lin V) (lin Vk))
  (i : DS.Lands Vk Vk (L.1 Vk f' jk) (idH (lin Vk)))
  : DS.Lands V V (L.1 V (compH (lin V) (lin Vk) (lin X) f' h) (compH (lin V) (lin Vk) Iv jk h)) (idH (lin V)) =
  dlands-sub V V (DS.pre V Vk h (L.1 Vk f' jk)) (L.1 V (compH (lin V) (lin Vk) (lin X) f' h) (compH (lin V) (lin Vk) Iv jk h))
    (L.2 V Vk h f' jk) (idH (lin V))
    (DS.pre-lands V V Vk h (L.1 Vk f' jk) (idH (lin V))
      (dlands-hom V Vk (L.1 Vk f' jk) (compH (lin V) (lin Vk) (lin Vk) (idH (lin Vk)) h) (compH (lin V) (lin V) (lin Vk) h (idH (lin V)))
         (transH (comp-idl (lin V) (lin Vk) h) (symH (comp-idr (lin V) (lin Vk) h)))
         (DS.lands-comp V Vk Vk (L.1 Vk f' jk) (idH (lin Vk)) h i))) ;

module Snd (X : Nat) (L : PhiLD X) (W : Nat) (f : Hom (lin W) (lin X)) (t : IsT (testD X L W f))
  (V : Nat) (g : Hom (lin V) (lin W)) (j : Hom (lin V) Iv) {
  module Fc = DF.Fact[W, V, g, j] ;
  k : Nat = Fc.kk ;
  h : Hom (lin V) (lin (suc W)) = Fc.h ;

  atk : DS.Lands (suc W) (suc W) (L.1 (suc W) (compH (lin (suc W)) (lin W) (lin X) f (DF.gkD W k)) (DF.jkD W k)) (idH (lin (suc W))) =
    fa-e W (atK X L W f) t k Fc.kk-le ;

  res : DS.Lands V V (L.1 V (compH (lin V) (lin W) (lin X) f g) j) (idH (lin V)) =
    dlands-sub V V
      (L.1 V (compH (lin V) (lin (suc W)) (lin X) (compH (lin (suc W)) (lin W) (lin X) f (DF.gkD W k)) h) (compH (lin V) (lin (suc W)) Iv (DF.jkD W k) h))
      (L.1 V (compH (lin V) (lin W) (lin X) f g) j)
      (transH (apH (\ m -> L.1 V m (compH (lin V) (lin (suc W)) Iv (DF.jkD W k) h))
                 (transH (comp-assoc (lin V) (lin (suc W)) (lin W) (lin X) f (DF.gkD W k) h) (apH (compH (lin V) (lin W) (lin X) f) Fc.eqG)))
              (apH (\ m -> L.1 V (compH (lin V) (lin W) (lin X) f g) m) Fc.eqJ))
      (idH (lin V))
      (pullD X L (suc W) V (compH (lin (suc W)) (lin W) (lin X) f (DF.gkD W k)) (DF.jkD W k) h atk) ;
} ;

holds-of-test (W X : Nat) (L : PhiLD X) (f : Hom (lin W) (lin X)) (t : IsT (testD X L W f)) : HoldsLD X L W f =
  \ V g j -> Snd[X, L, W, f, t, V, g, j].res ;

test-of-holds (W X : Nat) (L : PhiLD X) (f : Hom (lin W) (lin X)) (h : HoldsLD X L W f) : IsT (testD X L W f) =
  fa-i W (atK X L W f) (\ k hk -> h (suc W) (DF.gkD W k) (DF.jkD W k)) ;

test-pre (X : Nat) (L : PhiLD X) (W' W : Nat) (f : Hom (lin W) (lin X)) (g : Hom (lin W') (lin W)) (t : IsT (testD X L W f))
  : IsT (testD X L W' (compH (lin W') (lin W) (lin X) f g)) =
  test-of-holds W' X L (compH (lin W') (lin W) (lin X) f g) (\ V g' j ->
    dlands-sub V V (L.1 V (compH (lin V) (lin W) (lin X) f (compH (lin V) (lin W') (lin W) g g')) j)
      (L.1 V (compH (lin V) (lin W') (lin X) (compH (lin W') (lin W) (lin X) f g) g') j)
      (apH (\ k -> L.1 V k j) (symH (comp-assoc (lin V) (lin W') (lin W) (lin X) f g g'))) (idH (lin V))
      (holds-of-test W X L f t V (compH (lin V) (lin W') (lin W) g g') j)) ;

forallS (X : Nat) (L : PhiLD X) : DS.Phi X = (testD X L, \ W' W f g t -> test-pre X L W' W f g t) ;

lands-forall (W X : Nat) (L : PhiLD X) (f : Hom (lin W) (lin X)) (i : DS.Lands W X (forallS X L) f) : HoldsLD X L W f = holds-of-test W X L f i ;

forall-lands (W X : Nat) (L : PhiLD X) (f : Hom (lin W) (lin X)) (h : HoldsLD X L W f) : DS.Lands W X (forallS X L) f = test-of-holds W X L f h ;

------------------------------------------------------------------------
-- Delta as an instance of the base

module DB = CBase[a].CB[W0.natV, \ n m -> homV (lin n) (lin m), \ n -> idH (lin n),
  \ X Y Z g f -> compH (lin X) (lin Y) (lin Z) g f,
  \ J I f -> comp-idl (lin J) (lin I) f, \ J I f -> comp-idr (lin J) (lin I) f,
  \ L K J I f g h -> comp-assoc (lin L) (lin K) (lin J) (lin I) f g h,
  suc zero, El Iv, e0, e1, \ n e -> constH (lin n) Iv e, \ Y X f e -> constH-nat (lin Y) (lin X) f e,
  DS.Phi, DS.pre, DS.Lands, DS.isProp-Lands, DS.lands-comp, DS.lands-pre, DS.pre-lands, DS.phi-ext,
  DS.emptyS, DS.empty-lands, DS.topS, DS.top-lands,
  dptS, dlands-pt, dpt-lands, dpt-disj,
  DS.allS, DS.allS-sound, DS.allS-complete, DS.bigU, DS.bigU-in, DS.bigU-out,
  forallS, lands-forall, forall-lands,
  \ d W i j -> PBs.cIp d (lin W) i j, \ d V W g i j -> PBs.cIp-nat d (lin V) (lin W) g i j,
  \ W i -> PBs.cI-jsrc-t (lin W) i, \ W i -> PBs.cI-jsrc-f (lin W) i, \ W i -> PBs.cI-jtgt-t (lin W) i, \ W i -> PBs.cI-jtgt-f (lin W) i,
  \ W j -> PBs.cI-isrc-t (lin W) j, \ W j -> PBs.cI-isrc-f (lin W) j, \ W j -> PBs.cI-itgt-t (lin W) j, \ W j -> PBs.cI-itgt-f (lin W) j] ;
