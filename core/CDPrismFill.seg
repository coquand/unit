-- CDPrismFill.seg (L8, Delta): seg/model DPrismFill.seg ported (module names only).  Was: filling the prism [N] * [1] by horns (Lemma 2.1 of [S],
-- the chains of FillCell, in line form on Delta).  From a partial line L0
-- on the boundary and one lid (S0 N e), the shuffle chain extends it to the
-- whole prism:
--
--   from e0 (FT): P_N, ..., P_0, P_k by the horn at its vertex k
--   from e1 (FF): P_0, ..., P_N, P_d by the horn at its vertex d + 1
--
--   tot        the total line (every (f , j) is a point of some P_k:
--              DeltaForall.Fact)
--   tot-S0     it extends L0
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DHn = CDHornFib[a, lz] ;
module DHm = CDeltaCl[a] ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
module DPm = CDPrism[a] ;
open CDCapBase[a] ;
module DT = CDCapT[a] ;
module DF = CDCapF[a] ;

-- every point of the prism is a point of a shuffle
memFact (N W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : IsT (DPm.memP N (Fact[N, W, f, j].res.1.1) W f j) =
  substH (\ z -> IsT (DPm.memP N (Fact[N, W, f, j].res.1.1) W z j)) Fact[N, W, f, j].eqG
    (substH (\ z -> IsT (DPm.memP N (Fact[N, W, f, j].res.1.1) W (compH (lin W) (lin (suc N)) (lin N) (gkD N Fact[N, W, f, j].res.1.1) Fact[N, W, f, j].h) z))
       Fact[N, W, f, j].eqJ
       (DPm.memP-sigma N Fact[N, W, f, j].res.1.1 Fact[N, W, f, j].kk-le W Fact[N, W, f, j].h)) ;

module PF (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (hf : DHn.DH[G, A].isFib) (N : Nat)
  (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
  (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g))) {
  module P = DGm.PL[G, A, N, gt, gn] ;
  module DCm = CDChain[a, lz].DC[G, A, N, gt, gn] ;
  open DB.GPre[lz].TyL[G, A] ;

  ----------------------------------------------------------------------
  -- from e0

  module FT (L0 : P.PLine[S0 N zero]) {
    -- no shuffle is filled at the start
    inc0 (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT ((ST N zero).1 W f j)) : IsT ((S0 N zero).1 W f j) =
      orE (IsT ((S0 N zero).1 W f j)) ((S0 N zero).1 W f j) (Stg[N, zero, condT N zero].shB W f j) s (\ t -> t)
        (\ u -> absurd _ (ltb-irr N (leb-trans (suc N) (ex-e N (\ k' -> and (condT N zero k') (DPm.memP N k' W f j)) u).1 N
                   (substH (\ x -> IsT (leb (suc N) x)) (plus-zero (ex-e N (\ k' -> and (condT N zero k') (DPm.memP N k' W f j)) u).1)
                      (and-l (condT N zero (ex-e N (\ k' -> and (condT N zero k') (DPm.memP N k' W f j)) u).1)
                             (DPm.memP N (ex-e N (\ k' -> and (condT N zero k') (DPm.memP N k' W f j)) u).1 W f j)
                             (ex-e N (\ k' -> and (condT N zero k') (DPm.memP N k' W f j)) u).2.2))
                   (ex-e N (\ k' -> and (condT N zero k') (DPm.memP N k' W f j)) u).2.1))) ;

    module C = DCm.Chain[\ d -> ST N d, DCm.restrPL (S0 N zero) (ST N zero) inc0 L0,
      \ d -> subN N d, \ d hd -> leb-step (subN N d) N (sub-le N d),
      \ d -> gkD N (subN N d), \ d -> jkD N (subN N d),
      \ d -> DPm.memP N (subN N d), \ d -> DPm.memP-clos N (subN N d),
      \ d -> DPm.facP N (subN N d), \ d W f j u -> DPm.FacP[N, subN N d, W, f, j, u].e1, \ d W f j u -> DPm.FacP[N, subN N d, W, f, j, u].e2,
      \ d -> DPm.uniqP N (subN N d),
      \ d hd -> DT.CT[N, d, hd].capT1, \ d hd -> DT.CT[N, d, hd].capT2, \ d hd -> DT.CT[N, d, hd].incT,
      hf] ;

    final : P.PLine[ST N (suc N)] = C.chain (suc N) (leb-refl N) ;

    -- every point is in the last stage
    inAll (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : IsT ((ST N (suc N)).1 W f j) =
      or-r ((S0 N zero).1 W f j) (Stg[N, zero, condT N (suc N)].shB W f j)
        (ex-i N (\ k' -> and (condT N (suc N) k') (DPm.memP N k' W f j)) Fact[N, W, f, j].res.1.1 Fact[N, W, f, j].kk-le
           (and-i (condT N (suc N) Fact[N, W, f, j].res.1.1) (DPm.memP N Fact[N, W, f, j].res.1.1 W f j)
              (substH (\ x -> IsT (leb (suc N) x)) (symH (Sum[a].plus-comm' (suc N) Fact[N, W, f, j].res.1.1)) (leb-plus (suc N) Fact[N, W, f, j].res.1.1))
              (memFact N W f j))) ;

    tot (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : EI W = final.v W f j (inAll W f j) ;

    -- the boundary and the lid stay in every stage
    in0 (d : Nat) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N zero).1 W f j)) : IsT ((ST N d).1 W f j) =
      or-l ((S0 N zero).1 W f j) (Stg[N, zero, condT N d].shB W f j) t ;

    pres : (d : Nat) (hd : IsT (leb d (suc N))) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      (s : IsT ((ST N d).1 W f j)) (t : IsT ((S0 N zero).1 W f j)) -> Id (EI W) ((C.chain d hd).v W f j s) (L0.v W f j t) = split {
      zero -> \ hd W f j s t -> apH (L0.v W f j) (isProp-IsT' ((S0 N zero).1 W f j) (inc0 W f j s) t) ;
      suc d -> \ hd W f j s t ->
        transH (C.Step[d, hd, C.chain d (leb-step d N hd)].Gl.vS W f j (DT.CT[N, d, hd].incT W f j s) (in0 d W f j t))
               (pres d (leb-step d N hd) W f j (in0 d W f j t) t) } ;

    tot-S0 (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N zero).1 W f j)) : Id (EI W) (tot W f j) (L0.v W f j t) =
      pres (suc N) (leb-refl N) W f j (inAll W f j) t ;

    tot-pt (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : Id (Pt W) (tot W f j).1 (gt W f j) = final.vpt W f j (inAll W f j) ;

    tot-nat (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      : Id (EI V) (E.act V W g (tot W f j)) (tot V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)) =
      final.vnat V W g f j (inAll W f j) (inAll V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)) ;
  } ;

  ----------------------------------------------------------------------
  -- from e1

  module FF (L0 : P.PLine[S0 N (suc zero)]) {
    inc0 (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT ((SF N zero).1 W f j)) : IsT ((S0 N (suc zero)).1 W f j) =
      orE (IsT ((S0 N (suc zero)).1 W f j)) ((S0 N (suc zero)).1 W f j) (Stg[N, suc zero, condF zero].shB W f j) s (\ t -> t)
        (\ u -> absurd _ (false-true (and-l (condF zero (ex-e N (\ k' -> and (condF zero k') (DPm.memP N k' W f j)) u).1)
                                            (DPm.memP N (ex-e N (\ k' -> and (condF zero k') (DPm.memP N k' W f j)) u).1 W f j)
                                            (ex-e N (\ k' -> and (condF zero k') (DPm.memP N k' W f j)) u).2.2))) ;

    module C = DCm.Chain[\ d -> SF N d, DCm.restrPL (S0 N (suc zero)) (SF N zero) inc0 L0,
      \ d -> suc d, \ d hd -> hd,
      \ d -> gkD N d, \ d -> jkD N d,
      \ d -> DPm.memP N d, \ d -> DPm.memP-clos N d,
      \ d -> DPm.facP N d, \ d W f j u -> DPm.FacP[N, d, W, f, j, u].e1, \ d W f j u -> DPm.FacP[N, d, W, f, j, u].e2,
      \ d -> DPm.uniqP N d,
      \ d hd -> DF.CF[N, d, hd].capF1, \ d hd -> DF.CF[N, d, hd].capF2, \ d hd -> DF.CF[N, d, hd].incF,
      hf] ;

    final : P.PLine[SF N (suc N)] = C.chain (suc N) (leb-refl N) ;

    inAll (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : IsT ((SF N (suc N)).1 W f j) =
      or-r ((S0 N (suc zero)).1 W f j) (Stg[N, suc zero, condF (suc N)].shB W f j)
        (ex-i N (\ k' -> and (condF (suc N) k') (DPm.memP N k' W f j)) Fact[N, W, f, j].res.1.1 Fact[N, W, f, j].kk-le
           (and-i (condF (suc N) Fact[N, W, f, j].res.1.1) (DPm.memP N Fact[N, W, f, j].res.1.1 W f j)
              Fact[N, W, f, j].kk-le (memFact N W f j))) ;

    tot (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : EI W = final.v W f j (inAll W f j) ;

    in0 (d : Nat) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N (suc zero)).1 W f j)) : IsT ((SF N d).1 W f j) =
      or-l ((S0 N (suc zero)).1 W f j) (Stg[N, suc zero, condF d].shB W f j) t ;

    pres : (d : Nat) (hd : IsT (leb d (suc N))) (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      (s : IsT ((SF N d).1 W f j)) (t : IsT ((S0 N (suc zero)).1 W f j)) -> Id (EI W) ((C.chain d hd).v W f j s) (L0.v W f j t) = split {
      zero -> \ hd W f j s t -> apH (L0.v W f j) (isProp-IsT' ((S0 N (suc zero)).1 W f j) (inc0 W f j s) t) ;
      suc d -> \ hd W f j s t ->
        transH (C.Step[d, hd, C.chain d (leb-step d N hd)].Gl.vS W f j (DF.CF[N, d, hd].incF W f j s) (in0 d W f j t))
               (pres d (leb-step d N hd) W f j (in0 d W f j t) t) } ;

    tot-S0 (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N (suc zero)).1 W f j)) : Id (EI W) (tot W f j) (L0.v W f j t) =
      pres (suc N) (leb-refl N) W f j (inAll W f j) t ;

    tot-pt (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : Id (Pt W) (tot W f j).1 (gt W f j) = final.vpt W f j (inAll W f j) ;

    tot-nat (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      : Id (EI V) (E.act V W g (tot W f j)) (tot V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)) =
      final.vnat V W g f j (inAll W f j) (inAll V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)) ;
  } ;
} ;
