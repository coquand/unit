-- Fibrancy plus ordinary internal isProp gives SAG's seeded extension
-- operation.  Thus the dependent eliminator need not assume extra
-- extension structure on its target proposition family.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ;

module FromPointed (G : PCtx) (A : PTy[G])
  (k : CP.ContrOp (extP G A) (subTy (extP G A) G A (pP G A))) {
  module Pr = CTruncHProp[a,l].Proposition[G,A] ;
  module TA = PR.TyL[G,A] ; module TC = PR.TyL[Pr.D,Pr.C] ;
  module PA = CP.Partials[G,A] ; module PC = CP.Partials[Pr.D,Pr.C] ;
  module RC = CP.Rel[Pr.D,Pr.C,Pr.C,CP.pmap-id Pr.D Pr.C] ;
  module SE = PB.CSub[l].SubE[Pr.D,G,pP G A,A] ;
  module K = CTruncSeededBack[a,l].Seeded[G,A] ;

  module Side (X : Ob) (x : TA.Pt X) (u : TA.T X x) (s : PA.Side[X,x]) {
    pv (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h) : TC.EI Y =
      (Pr.D.act Y X h (x,u),TA.fromE Y (G.act Y X h x) (s.pv Y h i) (s.ppt Y h i)) ;
    equation (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h) :
      Id (TA.EI Y) (SE.mV Y (pv Y h i)) (s.pv Y h i) =
      TA.fromE-eq Y (G.act Y X h x) (s.pv Y h i) (s.ppt Y h i) ;
    pn (Z Y : Ob) (g : Hom Z Y) (h : Hom Y X) (i : PB.Lands Y X s.pQ h)
      (j : PB.Lands Z X s.pQ (compH Z Y X h g)) :
      Id (TC.EI Z) (TC.E.act Z Y g (pv Y h i)) (pv Z (compH Z Y X h g) j) =
      SE.mV-inj Z _ _ (symH (Pr.D.act-o Z Y X h g (x,u)))
        (transH (symH (SE.mV-nat Z Y g (pv Y h i)))
          (transH (apH (TA.E.act Z Y g) (equation Y h i))
            (transH (s.pnat Z Y g h i j) (symH (equation Z (compH Z Y X h g) j))))) ;
    opaque equation ; opaque pn ;
    side : PC.Side[X,(x,u)] = new PC.Side[X,(x,u),s.pQ,pv,
      \ Y h i -> refl (Pr.D.act Y X h (x,u)),pn] ;
  } ;
  kop (X : Ob) (x : TA.Pt X) (u : TA.T X x) (s : PA.Side[X,x]) : TA.T X x =
    k.kop X (x,u) Side[X,x,u,s].side ;
  kside (X : Ob) (x : TA.Pt X) (u : TA.T X x) (s : PA.Side[X,x])
    (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X s.pQ h) :
    Id (TA.EI Y) (TA.E.act Y X h (x,kop X x u s)) (s.pv Y h i) =
    transH (SE.mV-nat Y X h ((x,u),kop X x u s))
      (transH (apH (SE.mV Y) (k.kside X (x,u) Side[X,x,u,s].side Y h i)) (Side[X,x,u,s].equation Y h i)) ;
  opaque kside ;
  module Uniform (Y X : Ob) (h : Hom Y X) (x : TA.Pt X) (u : TA.T X x) (s : PA.Side[X,x]) {
    y : TA.Pt Y = G.act Y X h x ;
    ru : TA.T Y y = A.tact Y X h x y (refl y) u ;
    rs : PA.Side[Y,y] = PA.rside Y X h x s ;
    module S0 = Side[X,x,u,s] ; module S1 = Side[Y,y,ru,rs] ;
    values (Z : Ob) (g : Hom Z Y) (i j : PB.Lands Z Y (PB.pre Y X h s.pQ) g) :
      Id (TC.EI Z) (S0.pv Z (compH Z Y X h g) i) (S1.pv Z g j) =
      SE.mV-inj Z _ _ (Pr.D.act-o Z Y X h g (x,u))
        (transH (S0.equation Z (compH Z Y X h g) i)
          (transH (PA.pv-irr X x s Z (compH Z Y X h g) i j) (symH (S1.equation Z g j)))) ;
    sides : Id (PC.Side[Y,(y,ru)]) (PC.rside Y X h (x,u) S0.side) S1.side =
      PC.side-ext Y (y,ru) (PC.rside Y X h (x,u) S0.side) S1.side (refl (PB.pre Y X h s.pQ)) values ;
    result : Id (TA.EI Y) (TA.E.act Y X h (x,kop X x u s)) (y,kop Y y ru rs) =
      transH (SE.mV-nat Y X h ((x,u),kop X x u s))
        (apH (SE.mV Y) (transH (k.kunif Y X h (x,u) S0.side)
          (RC.kop-cong k Y (y,ru) (y,ru) (refl (y,ru)) (PC.rside Y X h (x,u) S0.side) S1.side sides))) ;
    opaque result ;
  } ;
  op : K.Op = new K.Op[kop,kside,\ Y X h x u s -> Uniform[Y,X,h,x,u,s].result] ;
  algebra : CTruncAlg[a,l].Algebras[G,A].Algebra = K.Algebra[op].algebra ;
} ;

module Fibrant (G : PCtx) (A : PTy[G])
  (c : PB.CLine[l].Lines[G,A].CompK[e0,e1].Comp)
  (p : CTruncHProp[a,l].Proposition[G,A].isProp) {
  module P = CTruncHProp[a,l].Proposition[G,A].Fibrant[c,p] ;
  algebra : CTruncAlg[a,l].Algebras[G,A].Algebra = FromPointed[G,A,P.contract].algebra ;
} ;
