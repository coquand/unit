-- CDeltaElFib.seg (L8, Delta, inside CClassical.Cl): El of the universe of
-- Delta is fibrant (model.tex: Hypothesis El is Theorem hornbox (2) applied
-- once, to El, whose horn filling operation is the classifier's,
-- CDElHorn).
--
-- Quarry: seg/model DeltaElFib.

level a ;
open Base ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DU = CDeltaCl[a].DU ;

elFibD : DB.CLine[a+].Lines[DU.UCtx, DU.EGen].Fib = CDeltaHornToFib[a, a+].hornToFib DU.UCtx DU.EGen CDElHorn[a].elFib ;
