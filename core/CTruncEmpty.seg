-- Regression: the construction cannot create an inhabitant from no seed.
-- In every context, truncation of the empty type maps back to the empty type.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module EmptyTrunc (G : PCtx) {
  emptyTy : PTy[G] = mkTy G (\ X x -> W.emptyV)
    (\ Y X h x y e u -> absurd Empty u)
    (\ X x e u -> absurd _ u) (\ Z Y X h g x y z e e' e'' u -> absurd _ u) ;
  module K = CTruncAlg[a, l].Algebras[G,emptyTy] ;
  emptyAlg : K.Algebra = new K.Algebra[
    \ z Q u v vn -> absurd Empty u,
    \ z Q u v vn s h i -> absurd _ u,
    \ z Q u v vn s h -> absurd _ u] ;
  module T = CTrunc[a, l].Truncation[G,emptyTy] ;
  module R = T.Recursor[emptyTy,emptyAlg,HO.idN G emptyTy] ;
  no-inhabitant (X : Ob) (x : W.Ix (G.ob X)) (u : W.Ix (T.Ty.tob X x)) : Empty = R.map.nfun X x u ;
} ;
