-- The recursor preserves ext, including its boundary reduction.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
open CTruncRaw[a, l] ;

module Beta (G : PCtx) (A B : PTy[G]) (k : CTruncAlg[a, l].Algebras[G,B].Algebra)
  (f : (z : Build[G, A].Loc) -> W.Ix (A.tob z.1 z.2) -> W.Ix (B.tob z.1 z.2))
  (fn : (s z : Build[G, A].Loc) (h : Build[G, A].Arr s z) (v : W.Ix (A.tob z.1 z.2)) ->
    Id (W.Ix (B.tob s.1 s.2)) (B.tact s.1 z.1 h.1 z.2 s.2 h.2 (f z v))
      (f s (A.tact s.1 z.1 h.1 z.2 s.2 h.2 v))) {
  open Build[G, A] ;
  open CTruncAlg[a, l].Algebras[G,B] ;
  open CTruncGraph[a, l].Graph[G, A, B, k, f] ;
  open CTruncRec[a, l].Rec[G, A, B, k, f, fn] ;
  open CTruncLaws[a, l].Laws[G, A] ;
  module O = CTruncExt[a, l].Ops[G, A] ;

  module Ext (z : Loc) (Q : PB.Phi z.1) (u : TrEl z) (v : O.Partial z Q) (vn : O.Natural z Q v) {
    module E = O.Extend[z, Q, u, v, vn] ;
    bu (s : Loc) (h : Arr s z) : F s = rec s (tr-res s z h u) ;
    bv (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) : F s = rec s (v s h i) ;
    bn : SeedNat z bu = \ s h r g -> transH (rec-nat r s g (tr-res s z h u))
      (apH (rec r) (tr-res-o r s z h g u)) ;
    bvn : Natural z Q bv = \ s h i r g j -> transH (rec-nat r s g (v s h i))
      (apH (rec r) (vn s h i r g j)) ;
    opaque bn ; opaque bvn ;
    target : F z = k.extend z Q (rec z u) bv bvn ;
    proper (no : Id Bool (Q.1 z.1 (idH z.1)) false) : Eval (node z Q E.us E.vs) (z,target) =
      new NodeGraph[z, Q, \ s h -> Eval (E.us s h), \ s h i -> Eval (E.vs s h i), (z,target),
        bu, bv, bn, bvn, \ s h -> rec-graph s (tr-res s z h u), \ s h i -> rec-graph s (v s h i),
        apH (\ b -> (z,b))
          (ext-cong k z Q (bu z (ident z)) (rec z u) (apH (rec z) (tr-res-id z u))
            bv bv (refl bv) bvn bvn)] ;
    total (i : PB.Lands z.1 z.1 Q (idH z.1)) : Eval (E.vs z (ident z) i) (z,target) =
      move (E.vs z (ident z) i) (z,bv z (ident z) i) (z,target)
        (apH (\ b -> (z,b)) (transH (symH (k.boundary z Q (rec z u) bv bvn z (ident z) i))
          (B.tact-id z.1 z.2 (G.act-id z.1 z.2) target)))
        (rec-graph z (v z (ident z) i)) ;
    graph : Eval E.tree (z,target) =
      decide-ind Raw (Q.1 z.1 (idH z.1)) (\ i -> E.vs z (ident z) i) (\ no -> node z Q E.us E.vs)
        (\ t -> Eval t (z,target)) total proper ;
    rec-ext : Id (F z) (rec z E.value) target =
      fibre-inj z _ _ (unique E.tree _ _ (rec-graph z E.value) graph) ;
    opaque rec-ext ;
  } ;
} ;
