-- CCart.seg (L3, inside CB, levels k l n): compositions move along
-- cartesian maps of types (model.tex Prop "substitution", and §5: "a
-- structure on up A moves to s*A").  A cartesian map from A' over D
-- (level l) to A over G (level k) is a map of points s : D -> G and a map
-- ta of totals over s, injective over equal points, with a lift back of
-- its fibres.  It induces maps of lines (sI, tL), of elements over an end
-- (sV), and the Move data (CMove) for Comp; so Comp(A) gives Comp(A').
--
-- Instances: substitution (ta = the lift, bk = id), a small type over a
-- large context (L4), a type isomorphic fibrewise to another (L5).
-- Quarry: seg/model GSubst, GTransfer*, GSmallFib.

level k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
module W0 = V[k] ;
module W1 = V[l] ;
module P0 = GPre[k] ;
module P1 = GPre[l] ;

module Cart (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (s V (D.act V W g d)) (G.act V W g (s W d)))
  (ta : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt : (W : Ob) (v : P1.TyL[D, A'].EI W) -> Id (W0.Ix (G.ob W)) (ta W v).1 (s W v.1))
  (tanat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
     -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta W v)) (ta V (P1.TyL[D, A'].E.act V W g v)))
  (tainj : (W : Ob) (v v' : P1.TyL[D, A'].EI W) (P : Id (W1.Ix (D.ob W)) v.1 v'.1) (Q : Id (P0.TyL[G, A].EI W) (ta W v) (ta W v'))
     -> Id (P1.TyL[D, A'].EI W) v v')
  (bk : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> W1.Ix (A'.tob X x))
  (bkta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> Id (P0.TyL[G, A].EI X) (ta X (x, bk X x u)) (s X x, u)) {
  module TA' = P1.TyL[D, A'] ;
  module TA = P0.TyL[G, A] ;
  module FD = CLine[l].FC[D] ;
  module FG = CLine[k].FC[G] ;
  module FA' = CLine[l].FT[D, A'] ;
  module FA = CLine[k].FT[G, A] ;

  ----------------------------------------------------------------------
  -- lines

  sI (W : Ob) (z : W1.Ix (FD.ob W)) : W0.Ix (FG.ob W) =
    (\ V g j -> s V (z.1 V g j),
     \ V' V g f j -> transH (symH (s-nat V' V g (z.1 V f j))) (apH (s V') (z.2 V' V g f j))) ;

  sI-act (V W : Ob) (g : Hom V W) (z : W1.Ix (FD.ob W)) : Id (W0.Ix (FG.ob V)) (sI V (FD.actF V W g z)) (FG.actF V W g (sI W z)) =
    FG.fam-eq V (sI V (FD.actF V W g z)) (FG.actF V W g (sI W z)) (\ V' f j -> refl (s V' (z.1 V' (compH V' V W g f) j))) ;

  tL (W : Ob) (L : FA'.TL.EI W) : FA.TL.EI W =
    (sI W L.1,
     FA.lamA W (sI W L.1) (\ V g j -> ta V (L.2.1.1 V g j))
       (\ V g j -> transH (tapt V (L.2.1.1 V g j)) (apH (s V) (apH (\ y -> y.1 V g j) L.2.2)))
       (\ V' V g f j -> transH (tanat V' V g (L.2.1.1 V f j)) (apH (ta V') (L.2.1.2 V' V g f j)))) ;

  ----------------------------------------------------------------------
  -- elements over an end

  module AtEnd (e : IPt) {
    module EK' = CLine[l].EndKit[D, A', e] ;
    module EK = CLine[k].EndKit[G, A, e] ;

    sV (W : Ob) (z : EK'.TV.EI W) : EK.TV.EI W =
      (sI W z.1, TA.fromE W (s W ((FD.ev e).nt W z.1)) (ta W (EK'.endE W z)) (tapt W (EK'.endE W z))) ;

    sVE (W : Ob) (z : EK'.TV.EI W) : Id (TA.EI W) (EK.endE W (sV W z)) (ta W (EK'.endE W z)) =
      TA.fromE-eq W (s W ((FD.ev e).nt W z.1)) (ta W (EK'.endE W z)) (tapt W (EK'.endE W z)) ;

    sV-nat (V W : Ob) (g : Hom V W) (z : EK'.TV.EI W) : Id (EK.TV.EI V) (sV V (EK'.TV.E.act V W g z)) (EK.TV.E.act V W g (sV W z)) =
      EK.tv-eq V (sV V (EK'.TV.E.act V W g z)) (EK.TV.E.act V W g (sV W z)) (sI-act V W g z.1)
        (transH (sVE V (EK'.TV.E.act V W g z))
          (transH (apH (ta V) (EK'.endE-act V W g z))
            (transH (symH (tanat V W g (EK'.endE W z)))
              (transH (apH (TA.E.act V W g) (symH (sVE W z))) (symH (EK.endE-act V W g (sV W z))))))) ;

    sV-inj (W : Ob) (z z' : EK'.TV.EI W) (P : Id (W1.Ix (FD.ob W)) z.1 z'.1) (Q : Id (EK.TV.EI W) (sV W z) (sV W z'))
      : Id (EK'.TV.EI W) z z' =
      EK'.tv-eq W z z' P
        (tainj W (EK'.endE W z) (EK'.endE W z') (apH ((FD.ev e).nt W) P)
           (transH (symH (sVE W z)) (transH (apH (EK.endE W) Q) (sVE W z')))) ;

    -- the end of a moved line is the moved end
    evT (W : Ob) (L : FA'.TL.EI W) : Id (EK.TV.EI W) (sV W (FA'.Ev[e].evA.mE W L)) (FA.Ev[e].evA.mE W (tL W L)) =
      EK.tv-eq W (sV W (FA'.Ev[e].evA.mE W L)) (FA.Ev[e].evA.mE W (tL W L)) (refl (sI W L.1))
        (transH (sVE W (FA'.Ev[e].evA.mE W L))
          (transH (apH (ta W) (FA'.Ev[e].endB-E W L)) (symH (FA.Ev[e].endB-E W (tL W L))))) ;

    opaque sV-nat ; opaque sV-inj ; opaque evT ;

    -- elements of the strict fibres of ev e
    mS (W : Ob) (u : EK'.TS.EI W) : EK.TS.EI W =
      EK.mkTS W (sV W u.1) (tL W (EK'.lineL W u)) (refl (sI W u.1.1))
        (transH (apH (EK.endE W) (symH (evT W (EK'.lineL W u)))) (apH (\ z -> EK.endE W (sV W z)) u.2.2)) ;

    mSpt (W : Ob) (u : EK'.TS.EI W) : Id (EK.TV.EI W) (mS W u).1 (sV W u.1) =
      EK.mkTS-pt W (sV W u.1) (tL W (EK'.lineL W u)) (refl (sI W u.1.1))
        (transH (apH (EK.endE W) (symH (evT W (EK'.lineL W u)))) (apH (\ z -> EK.endE W (sV W z)) u.2.2)) ;

    mS-line (W : Ob) (u : EK'.TS.EI W) : Id (FA.TL.EI W) (EK.lineL W (mS W u)) (tL W (EK'.lineL W u)) =
      EK.mkTS-line W (sV W u.1) (tL W (EK'.lineL W u)) (refl (sI W u.1.1))
        (transH (apH (EK.endE W) (symH (evT W (EK'.lineL W u)))) (apH (\ z -> EK.endE W (sV W z)) u.2.2)) ;

    mSnat (V W : Ob) (g : Hom V W) (u : EK'.TS.EI W) : Id (EK.TS.EI V) (EK.TS.E.act V W g (mS W u)) (mS V (EK'.TS.E.act V W g u)) =
      EK.mkTS-act V W g (sV W u.1) (tL W (EK'.lineL W u)) (refl (sI W u.1.1))
        (transH (apH (EK.endE W) (symH (evT W (EK'.lineL W u)))) (apH (\ z -> EK.endE W (sV W z)) u.2.2))
        (sV V (EK'.TS.E.act V W g u).1) (tL V (EK'.lineL V (EK'.TS.E.act V W g u))) (refl (sI V (EK'.TS.E.act V W g u).1.1))
        (transH (apH (EK.endE V) (symH (evT V (EK'.lineL V (EK'.TS.E.act V W g u))))) (apH (\ z -> EK.endE V (sV V z)) (EK'.TS.E.act V W g u).2.2))
        (symH (sV-nat V W g u.1))
        (\ V'' f j -> symH (apH (\ M -> ta V'' (M.2.1.1 V'' f j)) (EK'.lineL-act V W g u))) ;


    -- mS is injective over equal points
    mS-inj (W : Ob) (u u' : EK'.TS.EI W) (P : Id (EK'.TV.EI W) u.1 u'.1) (Q : Id (EK.TS.EI W) (mS W u) (mS W u'))
      : Id (EK'.TS.EI W) u u' =
      EK'.ts-ext W u u' P (\ V g j ->
        tainj V ((EK'.lineL W u).2.1.1 V g j) ((EK'.lineL W u').2.1.1 V g j)
          (transH (apH (\ y -> y.1 V g j) (EK'.lineL W u).2.2)
            (transH (apH (\ z -> z.1.1 V g j) P) (symH (apH (\ y -> y.1 V g j) (EK'.lineL W u').2.2))))
          (transH (symH (apH (\ M -> M.2.1.1 V g j) (mS-line W u)))
            (transH (apH (\ w -> (EK.lineL W w).2.1.1 V g j) Q) (apH (\ M -> M.2.1.1 V g j) (mS-line W u'))))) ;

    -- a strict-fibre element over a moved point lifts back
    module BkS (X : Ob) (c : EK'.TV.EI X) (u : W0.Ix (EK.SFm.sfOb X (sV X c))) {
      Lv (V : Ob) (g : Hom V X) (j : Hom V Iv) : TA.EI V = u.1.1.1 V g j ;

      pth (V : Ob) (g : Hom V X) (j : Hom V Iv) : Id (W0.Ix (G.ob V)) (Lv V g j).1 (s V (c.1.1 V g j)) =
        apH (\ y -> y.1 V g j) u.1.2 ;

      t (V : Ob) (g : Hom V X) (j : Hom V Iv) : TA'.EI V =
        (c.1.1 V g j, bk V (c.1.1 V g j) (TA.fromE V (s V (c.1.1 V g j)) (Lv V g j) (pth V g j))) ;

      tE (V : Ob) (g : Hom V X) (j : Hom V Iv) : Id (TA.EI V) (ta V (t V g j)) (Lv V g j) =
        transH (bkta V (c.1.1 V g j) (TA.fromE V (s V (c.1.1 V g j)) (Lv V g j) (pth V g j)))
               (TA.fromE-eq V (s V (c.1.1 V g j)) (Lv V g j) (pth V g j)) ;

      tn (V' V : Ob) (g' : Hom V' V) (g : Hom V X) (j : Hom V Iv)
        : Id (TA'.EI V') (TA'.E.act V' V g' (t V g j)) (t V' (compH V' V X g g') (compH V' V Iv j g')) =
        tainj V' (TA'.E.act V' V g' (t V g j)) (t V' (compH V' V X g g') (compH V' V Iv j g')) (c.1.2 V' V g' g j)
          (transH (symH (tanat V' V g' (t V g j)))
            (transH (apH (TA.E.act V' V g') (tE V g j))
              (transH (u.1.1.2 V' V g' g j) (symH (tE V' (compH V' V X g g') (compH V' V Iv j g')))))) ;

      L' : W1.Ix (FA'.tobF X c.1) = FA'.lamA X c.1 t (\ V g j -> refl (c.1.1 V g j)) tn ;

      endc : Id (EK'.TV.EI X) (FA'.Ev[e].evA.mE X (c.1, L')) c =
        EK'.tv-eq X (FA'.Ev[e].evA.mE X (c.1, L')) c (refl c.1)
          (transH (FA'.Ev[e].endB-E X (c.1, L'))
            (tainj X (t X (idH X) (ptH X e)) (EK'.endE X c) (refl (c.1.1 X (idH X) (ptH X e)))
              (transH (tE X (idH X) (ptH X e))
                (transH (symH (FA.Ev[e].endB-E X ((sV X c).1, u.1)))
                  (transH (apH (EK.endE X) u.2) (sVE X c)))))) ;

      res : W1.Ix (EK'.SFm.sfOb X c) = (L', endc) ;

      res-mS : Id (EK.TS.EI X) (mS X (c, res)) (sV X c, u) =
        EK.ts-ext X (mS X (c, res)) (sV X c, u) (mSpt X (c, res))
          (\ V g j -> transH (apH (\ M -> M.2.1.1 V g j) (mS-line X (c, res))) (tE V g j)) ;
    } ;

    opaque mS-inj ;

    opaque mSpt ; opaque mS-line ; opaque mSnat ;
  } ;

  ----------------------------------------------------------------------
  -- compositions move

  module MoveComp (e e' : IPt) {
    module E = AtEnd[e] ;
    module E' = AtEnd[e'] ;
    module CK' = CLine[l].Lines[D, A'].CompK[e, e'] ;
    module CK = CLine[k].Lines[G, A].CompK[e, e'] ;
    module TT' = P1.TyL[E.EK'.TV.E, CK'.Tend] ;
    module TT = P0.TyL[E.EK.TV.E, CK.Tend] ;

    mT (W : Ob) (v : TT'.EI W) : TT.EI W = (E.sV W v.1, (E'.sV W (CK'.SE.mV W v)).2) ;

    mTnat (V W : Ob) (g : Hom V W) (v : TT'.EI W) : Id (TT.EI V) (TT.E.act V W g (mT W v)) (mT V (TT'.E.act V W g v)) =
      CK.SE.mV-inj V (TT.E.act V W g (mT W v)) (mT V (TT'.E.act V W g v)) (symH (E.sV-nat V W g v.1))
        (transH (symH (CK.SE.mV-nat V W g (mT W v)))
          (transH (symH (E'.sV-nat V W g (CK'.SE.mV W v))) (apH (E'.sV V) (CK'.SE.mV-nat V W g v)))) ;

    mTinj (W : Ob) (v v' : TT'.EI W) (P : Id (E.EK'.TV.EI W) v.1 v'.1) (Q : Id (TT.EI W) (mT W v) (mT W v')) : Id (TT'.EI W) v v' =
      CK'.SE.mV-inj W v v' P (E'.sV-inj W (CK'.SE.mV W v) (CK'.SE.mV W v') (apH (\ z -> z.1) P) (apH (CK.SE.mV W) Q)) ;

    bkT (X : Ob) (x : E.EK'.TV.EI X) (u : W0.Ix (CK.Tend.tob X (E.sV X x))) : W1.Ix (CK'.Tend.tob X x) =
      bk X ((FD.ev e').nt X x.1) u ;

    bkMv (X : Ob) (x : E.EK'.TV.EI X) (u : W0.Ix (CK.Tend.tob X (E.sV X x))) : Id (TT.EI X) (mT X (x, bkT X x u)) (E.sV X x, u) =
      CK.SE.mV-inj X (mT X (x, bkT X x u)) (E.sV X x, u) (refl (E.sV X x))
        (E'.EK.tv-eq X (E'.sV X (x.1, bkT X x u)) (sI X x.1, u) (refl (sI X x.1))
           (transH (E'.sVE X (x.1, bkT X x u)) (bkta X ((FD.ev e').nt X x.1) u))) ;

    sq (W : Ob) (u : E.EK'.TS.EI W) : Id (TT.EI W) (mT W (CK'.endL.mE W u)) (CK.endL.mE W (E.mS W u)) =
      CK.SE.mV-inj W (mT W (CK'.endL.mE W u)) (CK.endL.mE W (E.mS W u)) (symH (E.mSpt W u))
        (transH (E'.evT W (E.EK'.lineL W u)) (apH (CK.EV'.evA.mE W) (symH (E.mS-line W u)))) ;

    opaque mTnat ; opaque mTinj ; opaque bkMv ; opaque sq ;

    move (c : CK.Comp) : CK'.Comp = CMove[k, l].Mv[E.EK'.TV.E, E.EK'.SFm.SF, CK'.Tend, CK'.endL,
      E.EK.TV.E, E.EK.SFm.SF, CK.Tend, CK.endL, E.sV, E.sV-nat, E.mS, E.mSpt, E.mSnat,
      mT, \ W v -> refl (E.sV W v.1), mTnat, mTinj, bkT, bkMv, sq, c].rc ;

    -- the moved side, and the moved extension read through mT
    mside (c : CK.Comp) (X : Ob) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x]) : E.EK.PT.Side[X, E.sV X x] =
      CMove[k, l].Mv[E.EK'.TV.E, E.EK'.SFm.SF, CK'.Tend, CK'.endL,
        E.EK.TV.E, E.EK.SFm.SF, CK.Tend, CK.endL, E.sV, E.sV-nat, E.mS, E.mSpt, E.mSnat,
        mT, \ W v -> refl (E.sV W v.1), mTnat, mTinj, bkT, bkMv, sq, c].mside X x sd ;

    kopMv (c : CK.Comp) (X : Ob) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x])
      : Id (TT.EI X) (mT X (x, (move c).kop X x sd)) (E.sV X x, c.kop X (E.sV X x) (mside c X x sd)) =
      CMove[k, l].Mv[E.EK'.TV.E, E.EK'.SFm.SF, CK'.Tend, CK'.endL,
        E.EK.TV.E, E.EK.SFm.SF, CK.Tend, CK.endL, E.sV, E.sV-nat, E.mS, E.mSpt, E.mSnat,
        mT, \ W v -> refl (E.sV W v.1), mTnat, mTinj, bkT, bkMv, sq, c].kopMv X x sd ;

    -- a composition whose extensions move to c's is the moved one
    unique (c : CK.Comp) (k' : CK'.Comp)
      (H : (X : Ob) (x : E.EK'.TV.EI X) (sd : E.EK'.PT.Side[X, x])
         -> Id (TT.EI X) (mT X (x, k'.kop X x sd)) (E.sV X x, c.kop X (E.sV X x) (mside c X x sd)))
      : Id (CK'.Comp) k' (move c) =
      CMove[k, l].Mv[E.EK'.TV.E, E.EK'.SFm.SF, CK'.Tend, CK'.endL,
        E.EK.TV.E, E.EK.SFm.SF, CK.Tend, CK.endL, E.sV, E.sV-nat, E.mS, E.mSpt, E.mSnat,
        mT, \ W v -> refl (E.sV W v.1), mTnat, mTinj, bkT, bkMv, sq, c].unique k' H ;
  } ;

  -- contractibility structures move (m the identity)
  moveContr (c : CPartial[k].ContrOp G A) : CPartial[l].ContrOp D A' =
    CMove[k, l].Mv[D, A', A', CPartial[l].pmap-id D A', G, A, A, CPartial[k].pmap-id G A, s, s-nat,
      ta, tapt, tanat, ta, tapt, tanat, tainj, bk, bkta, \ W v -> refl (ta W v), c].rc ;

  -- the moved side, and the moved extension read through ta
  mside (c : CPartial[k].ContrOp G A) (X : Ob) (x : W1.Ix (D.ob X)) (sd : CPartial[l].Partials[D, A'].Side[X, x])
    : CPartial[k].Partials[G, A].Side[X, s X x] =
    CMove[k, l].Mv[D, A', A', CPartial[l].pmap-id D A', G, A, A, CPartial[k].pmap-id G A, s, s-nat,
      ta, tapt, tanat, ta, tapt, tanat, tainj, bk, bkta, \ W v -> refl (ta W v), c].mside X x sd ;

  kopMv (c : CPartial[k].ContrOp G A) (X : Ob) (x : W1.Ix (D.ob X)) (sd : CPartial[l].Partials[D, A'].Side[X, x])
    : Id (TA.EI X) (ta X (x, (moveContr c).kop X x sd)) (s X x, c.kop X (s X x) (mside c X x sd)) =
    CMove[k, l].Mv[D, A', A', CPartial[l].pmap-id D A', G, A, A, CPartial[k].pmap-id G A, s, s-nat,
      ta, tapt, tanat, ta, tapt, tanat, tainj, bk, bkta, \ W v -> refl (ta W v), c].kopMv X x sd ;

  -- a structure whose extensions move to c's is the moved one
  uniqueContr (c : CPartial[k].ContrOp G A) (k' : CPartial[l].ContrOp D A')
    (H : (X : Ob) (x : W1.Ix (D.ob X)) (sd : CPartial[l].Partials[D, A'].Side[X, x])
       -> Id (TA.EI X) (ta X (x, k'.kop X x sd)) (s X x, c.kop X (s X x) (mside c X x sd)))
    : Id (CPartial[l].ContrOp D A') k' (moveContr c) =
    CMove[k, l].Mv[D, A', A', CPartial[l].pmap-id D A', G, A, A, CPartial[k].pmap-id G A, s, s-nat,
      ta, tapt, tanat, ta, tapt, tanat, tainj, bk, bkta, \ W v -> refl (ta W v), c].unique k' H ;

  -- fibration structures move
  moveFib (c : CLine[k].Lines[G, A].Fib) : CLine[l].Lines[D, A'].Fib =
    (MoveComp[e0, e1].move c.1, MoveComp[e1, e0].move c.2) ;
} ;
