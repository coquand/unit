-- the development from univalence alone: funext derived (FunExtUA)
module ModelUA (univ : [b] Axioms[b].Univalence) {
  feU : [b] Axioms[b].FunExt = <b> FunExtUA[b].FE[univ @b].fe ;
  module M = Model[feU, univ] ;
  -- a final statement through it: univalence for the poset universe
  module Final (a : Level) {
    #type M.CPosFinal[a].ua ;
  } ;
} ;
