-- All.seg: seg/core, the generic core rebuilt (DESIGN.md).  Layers in
-- dependency order; the metatheory (L0) is copied unchanged from seg/model.
import Base ;
import Prelude ;
import Paths ;
import Axioms ;
import FunExtUA ;
import CwF ;
import Trees ;
import Arith ;
import Sum ;

-- funext and univalence: parameters of ONE segment, stated once
module Model (fe : [b] Axioms[b].FunExt) (univ : [b] Axioms[b].Univalence) {
  -- L0  metatheory
  import V ;
  import SmallCat ;
  import VLift ;
  import VCode ;
  import Encode ;
  import Presheaf ;
  import PresheafFormers ;
  import PresheafPi ;
  import CSieve ;

  -- L1  base
  import CBase ;

  -- L8  instances: posets
  import Cat ;
  import CPosC ;
  import CPosBase ;
  import CPosInst ;
  import CPosEl1 ;
  import CPosEl2 ;
  import CPosEl3 ;
  import CPosEl4 ;
  import CPosEl5 ;
  import CPosFinal ;
  import CPosId ;
  -- L8 instances: Delta
  import CSimp ;
  import CDeltaNat ;
  import CDeltaFact ;
  import CDeltaBase ;
  import CDeltaCl ;
  import CDLvl ;
  import CDHornFib ;
  import CDPrS ;
  import CDGlue ;
  import CDPrism ;
  import CDChain ;
  import CDPrismPt ;
  import CDCapBase ;
  import CDCapT ;
  import CDCapF ;
  import CDUnion ;
  import CDPrismFill ;
  import CDStageA ;
  import CDSurj ;
  import CDStageB ;
  import CDStageC ;
  import CDStageD ;
  import CDStageE ;
  import CDStageF ;
  import CDFill ;
  import CDSimpId ;
  import CDNormA ;
  import CDNormB ;
  import CDNormC ;
  import CDNormD ;
  import CDFactor ;
  import CDNormE ;
  import CBoxHorn ;
  import CDeltaRetr ;
  import CDElHorn ;
  import CDGlueCl ;
  import CDSmallCl ;
  import CDOpYon ;
  import CDOpFull ;
  import CDSmallFull ;
  import CDSmallFull2 ;
  import CClassical ;
  -- L9 the localisation of the poset model (localisation.tex)
  import CLocRestr ;
  import CLocHorn ;
  import CLocD ;
  import CLocPath ;
  import CLocPathEnd ;
  import CLocEZ ;
  import CLocCompV ;
  import CLocCompP ;
  import CLocComp ;
  import CLocDCart ;
  import CLocDUniv ;
  import CLocHtpy ;
  import CLocEtaH ;
  import CLocEq ;
  import CLocUniv ;
  import CDeltaId ;
