-- Naturality of naming and of the generic fibrant product.
module Reindex (H G : PCtx) (A : C.C.Ty G) (B : C.C.Ty (O.ext G A)) (s : PSub[H, G]) {
  AG : F.STy G = D.decode G A ;
  E : PCtx = O.ext G A ;
  BG : F.STy E = D.decode E B ;
  A0 : F.STy H = F.subS H G AG s ;
  A' : C.C.Ty H = C.C.subT H G A s ;
  AH : F.STy H = D.decode H A' ;
  q : Id (F.STy H) A0 AH = D.CDCodeFibSub.Sub[H, G, A, s].law ;

  L0 : PCtx = extP H A0.1 ;
  L1 : PCtx = O.ext H A' ;
  l0 : PSub[L0, E] = liftP H G AG.1 s ;
  l1 : PSub[L1, E] = O.lift H G A s ;
  module Back = CDPiReindex[a].Back[H, A0.1, AH.1, apH (\ z -> z.1) q] ;
  back : PSub[L1, L0] = Back.map ;
  l01 : PSub[L1, E] = oS L1 L0 E l0 back ;

  points (I : Nat) (x : W.Ix (L1.ob I)) : Id (W.Ix (L0.ob I)) (back.nt I x) x =
    Back.fixed (refl A0.1.tob) I x ;
  opaque points ;

  lift-eq : Id (PSub[L1, E]) l01 l1 =
    sub-ext L1 E l01 l1 (\ I x -> apH (l0.nt I) (points I x)) ;

  B0 : F.STy L0 = F.subS L0 E BG l0 ;
  B' : C.C.Ty L1 = C.C.subT L1 E B l1 ;
  BH : F.STy L1 = D.decode L1 B' ;

  dependent : Id (F.STy L1) (F.subS L1 L0 B0 back) BH =
    transH (symH (R.clSub-o L1 L0 E l0 back BG.1 BG.2))
      (transH (apH (F.subS L1 E BG) lift-eq) D.CDCodeFibSub.Sub[L1, E, B, l1].law) ;

  module Dom = CDPiReindex[a].Domain[H, A0, B0] ;
  arguments : Id Dom.Pair (A0, B0) (AH, BH) =
    transH (Dom.pair AH q) (apH {F.STy L1} {Dom.Pair} (\ z -> (AH, z)) dependent) ;

  pi-path : Id (F.STy H) (F.subS H G (raw G A B) s) (raw H A' B') =
    transH F.PiN[H, G, s, AG, BG].law (apH (\ z -> F.Pi H z.1 z.2) arguments) ;

  law : Id (C.C.Ty H) (C.C.subT H G (Pi G A B) s) (Pi H A' B') =
    transH N.CDNameSub.Natural[H, G, s, (raw G A B).1, (raw G A B).2].law (apH (named H) pi-path) ;

  opaque arguments ; opaque pi-path ; opaque law ;
} ;
