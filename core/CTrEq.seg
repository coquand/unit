-- CTrEq.seg (L3, inside CB): transport of an equivalence structure along a
-- path of triples is moveEq along the transport cart.  For a family of
-- triples c |-> (G c , B c , A c , al c) over a type T and P : c1 = c2,
-- the maps of points and totals from c2 back to c1 (transport, by idJ)
-- form a cart; at refl it is the identity cart (CHFibLaws.HId), so
--   lemT : subst P e = moveEq along the transport cart
-- by path induction.
--
-- Quarry: seg/model GEqExt (EqDat.Psi / PhiF).

open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module GPR = GPre[a] ;
open GPR.PS ;

module TrEq (T : U a+) (Gf : T -> PCtx) (Bf Af : (c : T) -> PTy[Gf c]) (alf : (c : T) -> CPartial[a].PMap[Gf c, Bf c, Af c]) (c1 : T) {
  EqF (c : T) : U a+ = CEquiv[a].EquivOp (Gf c) (Bf c) (Af c) (alf c) ;

  TA (c : T) (W : Ob) : U a = GPR.TyL[Gf c, Af c].EI W ;
  TB (c : T) (W : Ob) : U a = GPR.TyL[Gf c, Bf c].EI W ;

  s (c : T) (P : Id T c1 c) (W : Ob) (x : W0.Ix ((Gf c).ob W)) : W0.Ix ((Gf c1).ob W) =
    idJ T c1 (\ c' P' -> W0.Ix ((Gf c').ob W) -> W0.Ix ((Gf c1).ob W)) (\ y -> y) c P x ;

  s-nat (c : T) (P : Id T c1 c) (V W : Ob) (g : Hom V W) (x : W0.Ix ((Gf c).ob W))
    : Id (W0.Ix ((Gf c1).ob V)) (s c P V ((Gf c).act V W g x)) ((Gf c1).act V W g (s c P W x)) =
    idJ T c1 (\ c' P' -> (y : W0.Ix ((Gf c').ob W)) -> Id (W0.Ix ((Gf c1).ob V)) (s c' P' V ((Gf c').act V W g y)) ((Gf c1).act V W g (s c' P' W y)))
      (\ y -> refl ((Gf c1).act V W g y)) c P x ;

  tA (c : T) (P : Id T c1 c) (W : Ob) (v : TA c W) : TA c1 W =
    idJ T c1 (\ c' P' -> TA c' W -> TA c1 W) (\ y -> y) c P v ;

  tApt (c : T) (P : Id T c1 c) (W : Ob) (v : TA c W) : Id (W0.Ix ((Gf c1).ob W)) (tA c P W v).1 (s c P W v.1) =
    idJ T c1 (\ c' P' -> (y : TA c' W) -> Id (W0.Ix ((Gf c1).ob W)) (tA c' P' W y).1 (s c' P' W y.1)) (\ y -> refl y.1) c P v ;

  tAnat (c : T) (P : Id T c1 c) (V W : Ob) (g : Hom V W) (v : TA c W)
    : Id (TA c1 V) (GPR.TyL[Gf c1, Af c1].E.act V W g (tA c P W v)) (tA c P V (GPR.TyL[Gf c, Af c].E.act V W g v)) =
    idJ T c1 (\ c' P' -> (y : TA c' W) -> Id (TA c1 V) (GPR.TyL[Gf c1, Af c1].E.act V W g (tA c' P' W y)) (tA c' P' V (GPR.TyL[Gf c', Af c'].E.act V W g y)))
      (\ y -> refl (GPR.TyL[Gf c1, Af c1].E.act V W g y)) c P v ;

  tAinj (c : T) (P : Id T c1 c) (W : Ob) (v v' : TA c W) (Q0 : Id (W0.Ix ((Gf c).ob W)) v.1 v'.1) (Q : Id (TA c1 W) (tA c P W v) (tA c P W v'))
    : Id (TA c W) v v' =
    idJ T c1 (\ c' P' -> (y y' : TA c' W) -> Id (TA c1 W) (tA c' P' W y) (tA c' P' W y') -> Id (TA c' W) y y')
      (\ y y' Q' -> Q') c P v v' Q ;

  bkA (c : T) (P : Id T c1 c) (X : Ob) (x : W0.Ix ((Gf c).ob X)) (u : W0.Ix ((Af c1).tob X (s c P X x))) : W0.Ix ((Af c).tob X x) =
    idJ T c1 (\ c' P' -> (y : W0.Ix ((Gf c').ob X)) -> W0.Ix ((Af c1).tob X (s c' P' X y)) -> W0.Ix ((Af c').tob X y))
      (\ y u' -> u') c P x u ;

  bkAta (c : T) (P : Id T c1 c) (X : Ob) (x : W0.Ix ((Gf c).ob X)) (u : W0.Ix ((Af c1).tob X (s c P X x)))
    : Id (TA c1 X) (tA c P X (x, bkA c P X x u)) (s c P X x, u) =
    idJ T c1 (\ c' P' -> (y : W0.Ix ((Gf c').ob X)) (u' : W0.Ix ((Af c1).tob X (s c' P' X y)))
                 -> Id (TA c1 X) (tA c' P' X (y, bkA c' P' X y u')) (s c' P' X y, u'))
      (\ y u' -> refl (y, u')) c P x u ;

  tB (c : T) (P : Id T c1 c) (W : Ob) (v : TB c W) : TB c1 W =
    idJ T c1 (\ c' P' -> TB c' W -> TB c1 W) (\ y -> y) c P v ;

  tBpt (c : T) (P : Id T c1 c) (W : Ob) (v : TB c W) : Id (W0.Ix ((Gf c1).ob W)) (tB c P W v).1 (s c P W v.1) =
    idJ T c1 (\ c' P' -> (y : TB c' W) -> Id (W0.Ix ((Gf c1).ob W)) (tB c' P' W y).1 (s c' P' W y.1)) (\ y -> refl y.1) c P v ;

  tBnat (c : T) (P : Id T c1 c) (V W : Ob) (g : Hom V W) (v : TB c W)
    : Id (TB c1 V) (GPR.TyL[Gf c1, Bf c1].E.act V W g (tB c P W v)) (tB c P V (GPR.TyL[Gf c, Bf c].E.act V W g v)) =
    idJ T c1 (\ c' P' -> (y : TB c' W) -> Id (TB c1 V) (GPR.TyL[Gf c1, Bf c1].E.act V W g (tB c' P' W y)) (tB c' P' V (GPR.TyL[Gf c', Bf c'].E.act V W g y)))
      (\ y -> refl (GPR.TyL[Gf c1, Bf c1].E.act V W g y)) c P v ;

  tBinj (c : T) (P : Id T c1 c) (W : Ob) (v v' : TB c W) (Q0 : Id (W0.Ix ((Gf c).ob W)) v.1 v'.1) (Q : Id (TB c1 W) (tB c P W v) (tB c P W v'))
    : Id (TB c W) v v' =
    idJ T c1 (\ c' P' -> (y y' : TB c' W) -> Id (TB c1 W) (tB c' P' W y) (tB c' P' W y') -> Id (TB c' W) y y')
      (\ y y' Q' -> Q') c P v v' Q ;

  bkB (c : T) (P : Id T c1 c) (X : Ob) (x : W0.Ix ((Gf c).ob X)) (u : W0.Ix ((Bf c1).tob X (s c P X x))) : W0.Ix ((Bf c).tob X x) =
    idJ T c1 (\ c' P' -> (y : W0.Ix ((Gf c').ob X)) -> W0.Ix ((Bf c1).tob X (s c' P' X y)) -> W0.Ix ((Bf c').tob X y))
      (\ y u' -> u') c P x u ;

  bkBta (c : T) (P : Id T c1 c) (X : Ob) (x : W0.Ix ((Gf c).ob X)) (u : W0.Ix ((Bf c1).tob X (s c P X x)))
    : Id (TB c1 X) (tB c P X (x, bkB c P X x u)) (s c P X x, u) =
    idJ T c1 (\ c' P' -> (y : W0.Ix ((Gf c').ob X)) (u' : W0.Ix ((Bf c1).tob X (s c' P' X y)))
                 -> Id (TB c1 X) (tB c' P' X (y, bkB c' P' X y u')) (s c' P' X y, u'))
      (\ y u' -> refl (y, u')) c P x u ;

  comm (c : T) (P : Id T c1 c) (W : Ob) (v : TB c W) : Id (TA c1 W) (tA c P W ((alf c).mE W v)) ((alf c1).mE W (tB c P W v)) =
    idJ T c1 (\ c' P' -> (y : TB c' W) -> Id (TA c1 W) (tA c' P' W ((alf c').mE W y)) ((alf c1).mE W (tB c' P' W y)))
      (\ y -> refl ((alf c1).mE W y)) c P v ;

  -- moving along the transport cart
  moveP (c : T) (P : Id T c1 c) (e : EqF c1) : EqF c =
    CHFibCart[a, a].HCart[Gf c, Bf c, Af c, alf c, Gf c1, Bf c1, Af c1, alf c1,
      s c P, s-nat c P, tA c P, tApt c P, tAnat c P, tAinj c P, bkA c P, bkAta c P,
      tB c P, tBpt c P, tBnat c P, tBinj c P, bkB c P, bkBta c P, comm c P].moveEq e ;

  -- transport is moving along the transport cart
  lemT (c : T) (P : Id T c1 c) (e : EqF c1) : Id (EqF c) (subst T EqF c1 c P e) (moveP c P e) =
    idJ T c1 (\ c' P' -> Id (EqF c') (subst T EqF c1 c' P' e) (moveP c' P' e))
      (symH (CHFibLaws[a, a, a].HId[Gf c1, Bf c1, Af c1, alf c1, e].idm)) c P ;

  opaque lemT ;
} ;
