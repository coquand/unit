-- CPathNat.seg (L3, inside CB, level l): the fibration of Path is natural
-- (model.tex Thm "type formers", naturality).  For r : D -> G, the
-- fibration of Path A[r] a[r] b[r] built from the substituted fibration of
-- A is the move of that of Path A a b along the cart of CPathCart.
--
-- Proof, per direction, by MoveComp.unique, value by value:
--   PM     the problem (CPathProb: the 3-sieve join of B0 , B1 , SL) at the
--          moved data is the moved problem, so the composites of A agree
--          by kopMv (out)
--   inpEq  restriction commutes with mside (Mv.mside-restr)

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Trees[a] ;
open Arith[a] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PathNatC (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a b : PEl[G, A]) (e e' : IPt)
  (ca : CLine[l].Lines[G, A].CompK[e, e'].Comp) {
  module PC = CPathCart[l].PathCart[D, G, r, A, a, b] ;
  module FA_ = CFibSub[l].FibSub[D, G, r, A] ;
  module MA = FA_.C.MoveComp[e, e'] ;
  module EA = FA_.C.AtEnd[e] ;
  module MP = PC.C.MoveComp[e, e'] ;
  module EP = PC.C.AtEnd[e] ;
  module P' = PC.PF'.C[e, e', MA.move ca].PC ;
  module P = PC.PF.C[e, e', ca].PC ;
  module TA = PC.TA ;

  -- moving commutes with restriction (for the path composition)
  mside-restr (Y X : Ob) (h : Hom Y X) (x : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, x])
    : Id (EP.EK.PT.Side[Y, EP.sV Y (EP.EK'.TV.E.act Y X h x)])
         (subst (EP.EK.TV.EI Y) (\ z -> EP.EK.PT.Side[Y, z]) (EP.EK.TV.E.act Y X h (EP.sV X x)) (EP.sV Y (EP.EK'.TV.E.act Y X h x))
            (symH (EP.sV-nat Y X h x)) (EP.EK.PT.rside Y X h (EP.sV X x) (MP.mside P.comp X x sd)))
         (MP.mside P.comp Y (EP.EK'.TV.E.act Y X h x) (EP.EK'.PT.rside Y X h x sd)) =
    CMove[l, l].Mv[EP.EK'.TV.E, EP.EK'.SFm.SF, MP.CK'.Tend, MP.CK'.endL,
      EP.EK.TV.E, EP.EK.SFm.SF, MP.CK.Tend, MP.CK.endL, EP.sV, EP.sV-nat, EP.mS, EP.mSpt, EP.mSnat,
      MP.mT, \ W v -> refl (EP.sV W v.1), MP.mTnat, MP.mTinj, MP.bkT, MP.bkMv, MP.sq, P.comp].mside-restr Y X h x sd ;

  -- a composite of A[r], moved and read in A, is the composite read in A
  rd-mT (V : Ob) (v : P'.TTA.EI V) : Id (TA.EI V) (PC.SEA.mV V (P'.rd V v)) (P.rd V (MA.mT V v)) =
    symH (MA.E'.sVE V (MA.CK'.SE.mV V v)) ;

  ----------------------------------------------------------------------
  -- the problem moves

  module PM (V : Ob) (w : EP.EK'.TV.EI V) (p : EP.EK'.PT.Side[V, w]) (i : Hom V Iv) {
    module Q' = P'.PR.Prob[V, w, p, i] ;
    module Q = P.PR.Prob[V, EP.sV V w, MP.mside P.comp V w p, i] ;

    pt : Id (EA.EK.TV.EI V) (EA.sV V Q'.x') Q.x' =
      EA.EK.tv-eq V (EA.sV V Q'.x') Q.x'
        (FA_.C.FG.fam-eq V (EA.sV V Q'.x').1 Q.x'.1 (\ V' f j -> r.nt-nat V' V' (idH V') (w.1.1 V' f j)))
        (calc (TA.EI V) {
            EA.EK.endE V (EA.sV V Q'.x')
          =< EA.sVE V Q'.x' >
            PC.SEA.mV V (EA.EK'.endE V Q'.x')
          =< apH (PC.SEA.mV V) Q'.x'-E >
            PC.SEA.mV V (Q'.p.1.1 V (idH V) i)
          =< symH (apH (\ z -> z.2.1.1 V (idH V) i) (EP.sVE V w)) >
            Q.p.1.1 V (idH V) i
          =< symH Q.x'-E >
            EA.EK.endE V Q.x' }) ;

    -- the sieves, side by side
    Qe1 : (n : Nat) -> Id (Phi V) (Q'.pick1 n).pQ (Q.pick1 n).pQ = split {
      zero -> refl (pre V Iv i (ptS e1)) ;
      suc m -> refl p.pQ } ;

    Qe : (n : Nat) -> Id (Phi V) (Q'.pick n).pQ (Q.pick n).pQ = split {
      zero -> refl (pre V Iv i (ptS e0)) ;
      suc m -> Qe1 m } ;

    eQ : Id (Phi V) Q'.side.pQ Q.side.pQ =
      apH (\ F -> bigU V (suc (suc (suc zero))) F)
        (Axioms[l+].FunExtLemmas[fe @(l+)].funext (Fin (suc (suc (suc zero)))) (\ q -> Phi V) Q'.J.Qs Q.J.Qs (\ q -> Qe q.1)) ;

    -- the points of the sides
    ptG (S' : EA.EK'.PT.Side[V, Q'.x']) (S : EA.EK.PT.Side[V, Q.x']) (V' : Ob) (f : Hom V' V)
      (b : Lands V' V S'.pQ f) (b' : Lands V' V S.pQ f)
      : Id (EA.EK.TV.EI V') (EA.mS V' (S'.pv V' f b)).1 (S.pv V' f b').1 =
      transH (EA.mSpt V' (S'.pv V' f b))
        (transH (apH (EA.sV V') (S'.ppt V' f b))
          (transH (EA.sV-nat V' V f Q'.x')
            (transH (apH (EA.EK.TV.E.act V' V f) pt) (symH (S.ppt V' f b'))))) ;

    -- a side on {i = eb}: the values are the ends along the K-line, moved
    vB (S' : EA.EK'.PT.Side[V, Q'.x']) (S : EA.EK.PT.Side[V, Q.x']) (V' : Ob) (f : Hom V' V)
      (b : Lands V' V S'.pQ f) (b' : Lands V' V S.pQ f)
      (cE' : (V2 : Ob) -> W0.Ix (D.ob V2) -> PC.TA'.EI V2) (cE : (V2 : Ob) -> W0.Ix (G.ob V2) -> TA.EI V2)
      (cM : (V2 : Ob) (y : W0.Ix (D.ob V2)) -> Id (TA.EI V2) (PC.SEA.mV V2 (cE' V2 y)) (cE V2 (r.nt V2 y)))
      (lv' : (V'' : Ob) (g' : Hom V'' V') (j : Hom V'' Iv)
         -> Id (PC.TA'.EI V'') ((EA.EK'.lineL V' (S'.pv V' f b)).2.1.1 V'' g' j) (cE' V'' (Q'.kL V'' (compH V'' V' V f g') j)))
      (lv : (V'' : Ob) (g' : Hom V'' V') (j : Hom V'' Iv)
         -> Id (TA.EI V'') ((EA.EK.lineL V' (S.pv V' f b')).2.1.1 V'' g' j) (cE V'' (Q.kL V'' (compH V'' V' V f g') j)))
      : Id (EA.EK.TS.EI V') (EA.mS V' (S'.pv V' f b)) (S.pv V' f b') =
      EA.EK.ts-ext V' (EA.mS V' (S'.pv V' f b)) (S.pv V' f b') (ptG S' S V' f b b')
        (\ V'' g' j ->
          transH (apH (\ M -> M.2.1.1 V'' g' j) (EA.mS-line V' (S'.pv V' f b)))
            (transH (apH (PC.SEA.mV V'') (lv' V'' g' j))
              (transH (cM V'' (Q'.kL V'' (compH V'' V' V f g') j)) (symH (lv V'' g' j))))) ;

    -- the side of P, moved
    vS (V' : Ob) (f : Hom V' V) (b : Lands V' V p.pQ f) (b' : Lands V' V p.pQ f)
      : Id (EA.EK.TS.EI V') (EA.mS V' (Q'.SL.pv V' f b)) (Q.SL.pv V' f b') =
      EA.EK.ts-ext V' (EA.mS V' (Q'.SL.pv V' f b)) (Q.SL.pv V' f b') (ptG Q'.SL.side Q.SL.side V' f b b')
        (\ V'' g' j ->
          calc (TA.EI V'') {
              (EA.EK.lineL V' (EA.mS V' (Q'.SL.pv V' f b))).2.1.1 V'' g' j
            =< apH (\ M -> M.2.1.1 V'' g' j) (EA.mS-line V' (Q'.SL.pv V' f b)) >
              PC.SEA.mV V'' ((EA.EK'.lineL V' (Q'.SL.pv V' f b)).2.1.1 V'' g' j)
            =< apH (PC.SEA.mV V'') (Q'.SL.pv-lev V' f b V'' g' j) >
              PC.SEA.mV V'' ((P'.PR.lvP V' (p.pv V' f b) V'' g' j).2.1.1 V'' (idH V'') (Q'.ic V' f V'' g'))
            =< apH (\ u -> PC.SEA.mV V'' ((P'.PR.lvP V' u V'' g' j).2.1.1 V'' (idH V'') (Q'.ic V' f V'' g'))) (EP.EK'.PT.pv-irr V w p V' f b b') >
              PC.SEA.mV V'' ((P'.PR.lvP V' (p.pv V' f b') V'' g' j).2.1.1 V'' (idH V'') (Q'.ic V' f V'' g'))
            =< symH (apH (\ M -> (M.2.1.1 V'' g' j).2.1.1 V'' (idH V'') (Q.ic V' f V'' g')) (EP.mS-line V' (p.pv V' f b'))) >
              (P.PR.lvP V' ((MP.mside P.comp V w p).pv V' f b') V'' g' j).2.1.1 V'' (idH V'') (Q.ic V' f V'' g')
            =< symH (Q.SL.pv-lev V' f b' V'' g' j) >
              (EA.EK.lineL V' (Q.SL.pv V' f b')).2.1.1 V'' g' j }) ;

    vEq1 : (n : Nat) (V' : Ob) (f : Hom V' V) (b : Lands V' V (Q'.pick1 n).pQ f) (b' : Lands V' V (Q.pick1 n).pQ f)
      -> Id (EA.EK.TS.EI V') (EA.mS V' ((Q'.pick1 n).pv V' f b)) ((Q.pick1 n).pv V' f b') = split {
      zero -> \ V' f b b' ->
        vB Q'.B1.side Q.B1.side V' f b b' PC.PF'.PE.bE PC.PF.PE.bE (\ V2 y -> refl (PC.PF.PE.bE V2 (r.nt V2 y)))
          (\ V'' g' j -> Q'.B1.pv-lev V' f b V'' g' j) (\ V'' g' j -> Q.B1.pv-lev V' f b' V'' g' j) ;
      suc m -> \ V' f b b' -> vS V' f b b' } ;

    vEq : (n : Nat) (V' : Ob) (f : Hom V' V) (b : Lands V' V (Q'.pick n).pQ f) (b' : Lands V' V (Q.pick n).pQ f)
      -> Id (EA.EK.TS.EI V') (EA.mS V' ((Q'.pick n).pv V' f b)) ((Q.pick n).pv V' f b') = split {
      zero -> \ V' f b b' ->
        vB Q'.B0.side Q.B0.side V' f b b' PC.PF'.PE.aE PC.PF.PE.aE (\ V2 y -> refl (PC.PF.PE.aE V2 (r.nt V2 y)))
          (\ V'' g' j -> Q'.B0.pv-lev V' f b V'' g' j) (\ V'' g' j -> Q.B0.pv-lev V' f b' V'' g' j) ;
      suc m -> vEq1 m } ;

    sd-eq : Id (EA.EK.PT.Side[V, Q.x'])
               (subst (EA.EK.TV.EI V) (\ z -> EA.EK.PT.Side[V, z]) (EA.sV V Q'.x') Q.x' pt (MA.mside ca V Q'.x' Q'.side)) Q.side =
      EA.EK.PT.side-extH V (EA.sV V Q'.x') Q.x' pt (MA.mside ca V Q'.x' Q'.side) Q.side eQ
        (\ V' f h h' ->
          transH (vEq (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1 V' f (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).2
                    (lands-sub V' V (Q'.pick (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1).pQ
                       (Q.pick (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1).pQ (Qe (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1) f
                       (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).2))
            (symH (Q.J.pv-in (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1 V' f
                    (lands-sub V' V (Q'.pick (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1).pQ
                       (Q.pick (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1).pQ (Qe (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).1.1) f
                       (bigU-out V' V (suc (suc (suc zero))) Q'.J.Qs f h).2) h'))) ;

    opaque pt ; opaque sd-eq ;

    -- the composites agree
    out : Id (TA.EI V) (PC.SEA.mV V (P'.rd V (P'.out V (w, p) i))) (P.rd V (P.out V (EP.sV V w, MP.mside P.comp V w p) i)) =
      transH (rd-mT V (P'.out V (w, p) i))
        (apH (P.rd V)
          (transH (MA.kopMv ca V Q'.x' Q'.side)
            (P.RCA.kop-cong ca V (EA.sV V Q'.x') Q.x' pt (MA.mside ca V Q'.x' Q'.side) Q.side sd-eq))) ;
  } ;

  ----------------------------------------------------------------------
  -- the composites of the path type agree

  inpEq (X : Ob) (x : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, x]) (V : Ob) (g : Hom V X)
    : Id (P.In V) (EP.sV V (P'.F[X, x, sd].inp V g).1, MP.mside P.comp V (P'.F[X, x, sd].inp V g).1 (P'.F[X, x, sd].inp V g).2)
                  (P.F[X, EP.sV X x, MP.mside P.comp X x sd].inp V g) =
    symH (Sigma-path (EP.EK.TV.EI V) (\ z -> EP.EK.PT.Side[V, z]) (EP.EK.TV.E.act V X g (EP.sV X x)) (EP.sV V (EP.EK'.TV.E.act V X g x))
            (EP.EK.PT.rside V X g (EP.sV X x) (MP.mside P.comp X x sd)) (MP.mside P.comp V (EP.EK'.TV.E.act V X g x) (EP.EK'.PT.rside V X g x sd))
            (symH (EP.sV-nat V X g x)) (mside-restr V X g x sd)) ;

  module H (X : Ob) (x : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, x]) {
    val (V : Ob) (g : Hom V X) (j : Hom V Iv)
      : Id (TA.EI V) (PC.SEA.mV V (P'.F[X, x, sd].t V g j)) (P.F[X, EP.sV X x, MP.mside P.comp X x sd].t V g j) =
      transH (PM[V, (P'.F[X, x, sd].inp V g).1, (P'.F[X, x, sd].inp V g).2, j].out)
             (apH (\ z -> P.rd V (P.out V z j)) (inpEq X x sd V g)) ;

    res : Id (MP.TT.EI X) (MP.mT X (x, P'.comp.kop X x sd)) (EP.sV X x, P.comp.kop X (EP.sV X x) (MP.mside P.comp X x sd)) =
      MP.CK.SE.mV-inj X (MP.mT X (x, P'.comp.kop X x sd)) (EP.sV X x, P.comp.kop X (EP.sV X x) (MP.mside P.comp X x sd))
        (refl (EP.sV X x))
        (MP.E'.EK.tv-eq X (MP.CK.SE.mV X (MP.mT X (x, P'.comp.kop X x sd))) (MP.CK.SE.mV X (EP.sV X x, P.comp.kop X (EP.sV X x) (MP.mside P.comp X x sd)))
          (refl (PC.C.sI X x.1))
          (transH (MP.E'.sVE X (MP.CK'.SE.mV X (x, P'.comp.kop X x sd)))
            (PC.PF.PT.tp-ext X (PC.ta X (MP.E'.EK'.endE X (MP.CK'.SE.mV X (x, P'.comp.kop X x sd))))
               (MP.E'.EK.endE X (MP.CK.SE.mV X (EP.sV X x, P.comp.kop X (EP.sV X x) (MP.mside P.comp X x sd))))
               (refl (r.nt X ((P'.FK.ev e').nt X x.1)))
               val))) ;
  } ;

  nat : Id (MP.CK'.Comp) P'.comp (MP.move P.comp) = MP.unique P.comp P'.comp (\ X x sd -> H[X, x, sd].res) ;
} ;

-- the fibration of Path along r is the move of the fibration of Path
module PathNat (D G : PCtx) (r : PSub[D, G]) (A : PTy[G]) (a b : PEl[G, A]) (fA : CLine[l].Lines[G, A].Fib) {
  module PC = CPathCart[l].PathCart[D, G, r, A, a, b] ;
  module N1 = PathNatC[D, G, r, A, a, b, e0, e1, fA.1] ;
  module N2 = PathNatC[D, G, r, A, a, b, e1, e0, fA.2] ;

  fib' : CLine[l].Lines[D, PC.PF'.PathT].Fib = PC.PF'.fib (CFibSub[l].FibSub[D, G, r, A].sub fA) ;
  F : CLine[l].Lines[G, PC.PF.PathT].Fib = PC.PF.fib fA ;

  nat : Id (CLine[l].Lines[D, PC.PF'.PathT].Fib) fib' (PC.C.moveFib F) =
    transH {CLine[l].Lines[D, PC.PF'.PathT].Fib} {fib'} {((PC.C.moveFib F).1, fib'.2)} {PC.C.moveFib F}
      (apH (\ c -> (c, fib'.2)) N1.nat) (apH (\ c -> ((PC.C.moveFib F).1, c)) N2.nat) ;
} ;
