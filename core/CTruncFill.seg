-- Mathematical attribution: Christian Sattler.
-- All mathematical results concerning the D modality and the D_n
-- modalities in this file, including their supporting constructions
-- and proofs, are due to Christian Sattler.
-- This file records their formalisation in Unit.

-- CTruncFill.seg (L9): the universal property of D_0 A among the D-modal
-- propositions (postnikov.tex, Section trunc, the case n = -1).
--
-- A fibrant proposition B has face-uniform sphere fillers.  For an element
-- w of D_0 B over [k] (k+1 vertices of B over a simplex rho of G) we build
-- fl w in B([k]) over rho, by recursion on k, with
--
--   face       its face y is fl of the face y of w
--
-- At k + 1 the faces s y = fl (w d_y) form a sphere.  A lid c0 over rho
-- is a filler of the horn at 0 (CLocHorn.FaceFill), and the box over
-- [k+1] with lid c0 at s = 1 and, on the boundary, the paths of B from the
-- sphere to c0 (IsPropE) is filled (CBoxFill, sides CPostBdry over
-- [k+1] * [0]); fl w is the filler at s = 0.  The faces agree on their
-- common faces (FFm) through the codimension-2 face (CFaceTwo).
--
--   SF.sN      the map D_0 B -> D B, f |-> fl (w f)
--   KMap       K_N on maps
--   UP0.k      for B fibrant, D-modal and a proposition and g : A -> B, the
--              map D_0 A -> B:  inv_B . sN . D_0 g

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
module AL = Arith[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module PBs = CPosBase[a] ;
module SP = PBs.SP ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module BD = CPostBdry[a, l] ;
module S1m = CPostStep1[a, l] ;
module TP = CTruncProp[a, l] ;
module HO = PB.CHtpyOps[l] ;
module CH = CLocHtpy[a, l] ;

module SF (G : PP.PCtx) (B : PP.PTy[G]) (cB : PB.CLine[l].Lines[G, B].Fib) (pB : TP.IsPropE[G, B]) {
  module D = CLocDNC[a, l].DC[G, B, zero] ;
  module TB = PB.GPre[l].TyL[G, B] ;
  module TD = PB.GPre[l].TyL[G, D.DK.DA] ;
  module GL = PB.GPre[l].PshL[G] ;
  module RG = CLocRestr[a, l].R[G] ;
  module FFB = CDFill[a, l].FF[RG.iG, RG.T[B].iA, CLocHorn[a, l].HornOfFib[G, B, cB].horn] ;
  module FFace = CLocHorn[a, l].FaceFill[G, B, cB] ;
  module DB = LD.DT[G, B] ;

  pt0 (W : Nat) : El (lin W) = (leaf zero, refl true) ;

  -- the faces of a simplex over [k+1] missed by g agree
  FFmTy (k : Nat) (fl : TD.EI (lin k) -> TB.EI (lin k)) : U l =
    (w : TD.EI (lin (suc k))) (y z : Nat) (hy : IsT (leb y (suc k))) (hz : IsT (leb z (suc k))) (lt : IsT (ltb y z))
    (W : Nat) (g : Hom (lin W) (lin (suc k))) (msy : Miss (lin W) k y g) (msz : Miss (lin W) k z g)
    -> Id (TB.EI (lin W)) (TB.E.act (lin W) (lin k) (compH (lin W) (lin (suc k)) (lin k) (dgH k y) g) (fl (TD.E.act (lin k) (lin (suc k)) (dl k y) w)))
                          (TB.E.act (lin W) (lin k) (compH (lin W) (lin (suc k)) (lin k) (dgH k z) g) (fl (TD.E.act (lin k) (lin (suc k)) (dl k z) w))) ;

  record Lv (k : Nat) {
    fl : TD.EI (lin k) -> TB.EI (lin k) ;
    flp : (w : TD.EI (lin k)) -> Id (W0.Ix (G.ob (lin k))) (fl w).1 w.1 ;
    FFm : FFmTy k fl ;
  } ;

  -- d_y then its degeneracy
  dgdl (k y : Nat) (hy : IsT (leb y (suc k))) (j : Nat) (p : Hom (lin j) (lin k))
    : Id (Hom (lin j) (lin k)) (compH (lin j) (lin (suc k)) (lin k) (dgH k y) (compH (lin j) (lin k) (lin (suc k)) (dl k y) p)) p =
    transH (symH (comp-assoc (lin j) (lin k) (lin (suc k)) (lin k) (dgH k y) (dl k y) p))
      (transH (apH (\ h -> compH (lin j) (lin k) (lin k) h p) (hom-eq (lin k) (lin k) _ _ (pw-dg-dl k y hy))) (comp-idl (lin j) (lin k) p)) ;

  ----------------------------------------------------------------------
  -- the step: from the faces to the simplex

  module ST (k : Nat) (L : Lv[k]) (w : TD.EI (lin (suc k))) {
    m : Nat = suc k ;

    s (y : Nat) : TB.EI (lin k) = L.fl (TD.E.act (lin k) (lin m) (dl k y) w) ;

    sp (y : Nat) : Id (W0.Ix (G.ob (lin k))) (s y).1 (G.act (lin k) (lin m) (dl k y) w.1) = L.flp (TD.E.act (lin k) (lin m) (dl k y) w) ;

    -- two faces agree along maps identified in [m]
    glLT (j y y' : Nat) (hy : IsT (leb y m)) (hy' : IsT (leb y' m)) (lt : IsT (ltb y y')) (p q : Hom (lin j) (lin k))
      (e : Id (Hom (lin j) (lin m)) (compH (lin j) (lin k) (lin m) (dl k y) p) (compH (lin j) (lin k) (lin m) (dl k y') q))
      : Id (TB.EI (lin j)) (TB.E.act (lin j) (lin k) p (s y)) (TB.E.act (lin j) (lin k) q (s y')) =
      transH (apH (\ h -> TB.E.act (lin j) (lin k) h (s y)) (symH (dgdl k y hy j p)))
        (transH (L.FFm w y y' hy hy' lt j (compH (lin j) (lin k) (lin m) (dl k y) p) (S1m.dl-miss k y j p)
                   (substH {Hom (lin j) (lin m)} (\ h -> Miss (lin j) k y' h) (symH e) (S1m.dl-miss k y' j q)))
          (transH (apH (\ h -> TB.E.act (lin j) (lin k) (compH (lin j) (lin m) (lin k) (dgH k y') h) (s y')) e)
                  (apH (\ h -> TB.E.act (lin j) (lin k) h (s y')) (dgdl k y' hy' j q)))) ;

    glEQ (j y : Nat) (hy : IsT (leb y m)) (p q : Hom (lin j) (lin k))
      (e : Id (Hom (lin j) (lin m)) (compH (lin j) (lin k) (lin m) (dl k y) p) (compH (lin j) (lin k) (lin m) (dl k y) q))
      : Id (TB.EI (lin j)) (TB.E.act (lin j) (lin k) p (s y)) (TB.E.act (lin j) (lin k) q (s y)) =
      apH (\ h -> TB.E.act (lin j) (lin k) h (s y))
        (transH (symH (dgdl k y hy j p)) (transH (apH (compH (lin j) (lin m) (lin k) (dgH k y)) e) (dgdl k y hy j q))) ;

    gl (j y y' : Nat) (hy : IsT (leb y m)) (hy' : IsT (leb y' m)) (p q : Hom (lin j) (lin k))
      (e : Id (Hom (lin j) (lin m)) (compH (lin j) (lin k) (lin m) (dl k y) p) (compH (lin j) (lin k) (lin m) (dl k y') q))
      : Id (TB.EI (lin j)) (TB.E.act (lin j) (lin k) p (s y)) (TB.E.act (lin j) (lin k) q (s y')) =
      AL.eqN-dec (Id (TB.EI (lin j)) (TB.E.act (lin j) (lin k) p (s y)) (TB.E.act (lin j) (lin k) q (s y'))) y y'
        (\ ee -> (idJ Nat y (\ y2 e2 -> (hy2 : IsT (leb y2 m)) (q2 : Hom (lin j) (lin k))
                               -> Id (Hom (lin j) (lin m)) (compH (lin j) (lin k) (lin m) (dl k y) p) (compH (lin j) (lin k) (lin m) (dl k y2) q2)
                               -> Id (TB.EI (lin j)) (TB.E.act (lin j) (lin k) p (s y)) (TB.E.act (lin j) (lin k) q2 (s y2)))
                  (\ hy2 q2 e2 -> glEQ j y hy p q2 e2) y' ee) hy' q e)
        (\ ne -> AL.ltb-dec (Id (TB.EI (lin j)) (TB.E.act (lin j) (lin k) p (s y)) (TB.E.act (lin j) (lin k) q (s y'))) y y'
           (\ lt -> glLT j y y' hy hy' lt p q e)
           (\ ge -> symH (glLT j y' y hy' hy (leb-neq y' y ge (neq-sym y y' ne)) q p (symH e)))) ;

    -- the lid: a filler of the horn at 0
    module HF = FFace.K0[k, w.1, \ y hy ky -> s y, \ y hy ky -> sp y,
                        \ j y y' hj hy hy' ky ky' p q e -> gl j y y' hy hy' p q e].F ;

    c0 : TB.EI (lin m) = (w.1, HF.fill) ;

    ----------------------------------------------------------------------
    -- the box over [m] * [0]

    X0 : Ob = prodP (lin m) (lin zero) ;
    xX : W0.Ix (G.ob X0) = G.act X0 (lin m) (pr1 (lin m) (lin zero)) w.1 ;
    module BG = BD.BG[k, lin zero] ;
    Xf : Ob = BG.Xf ;
    module HP = EZ.HProd[lin m, EZ.HLin[m].ht, m, EZ.HLin[m].hB, EZ.HLin[m].hm, EZ.HLin[m].hi,
                         lin zero, EZ.HLin[zero].ht, zero, EZ.HLin[zero].hB, EZ.HLin[zero].hm, EZ.HLin[zero].hi] ;

    p1f (W : Nat) (g : Hom (lin W) Xf) : Hom (lin W) (lin k) = compH (lin W) Xf (lin k) (pr1 (lin k) (lin zero)) g ;

    sq (y W : Nat) (q : Hom (lin W) (lin k)) : TB.EI (lin W) = TB.E.act (lin W) (lin k) q (s y) ;
    cq (y W : Nat) (q : Hom (lin W) (lin k)) : TB.EI (lin W) = TB.E.act (lin W) (lin m) (compH (lin W) (lin k) (lin m) (dl k y) q) c0 ;

    eqp (y W : Nat) (q : Hom (lin W) (lin k)) : Id (W0.Ix (G.ob (lin W))) (sq y W q).1 (cq y W q).1 =
      transH (apH (G.act (lin W) (lin k) q) (sp y)) (GL.actC (lin W) (lin k) (lin m) (dl k y) q w.1) ;

    -- the path from the sphere to the lid
    PT (y W : Nat) (q : Hom (lin W) (lin k)) : TB.EI (prodP (lin W) Iv) = pB.pth (lin W) (sq y W q) (cq y W q) (eqp y W q) ;

    rdj (W : Nat) (j : Hom (lin W) Iv) : Hom (lin W) (prodP (lin W) Iv) = pairH (lin W) Iv (lin W) (idH (lin W)) j ;

    Fs (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv) : TB.EI (lin W) =
      TB.E.act (lin W) (prodP (lin W) Iv) (rdj W j) (PT y W (p1f W g)) ;

    Fsp (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
      : Id (W0.Ix (G.ob (lin W))) (Fs y hy W g j).1 (G.act (lin W) Xf g (G.act Xf X0 (BG.dY y) xX)) =
      calc (W0.Ix (G.ob (lin W))) {
          G.act (lin W) (prodP (lin W) Iv) (rdj W j) (PT y W (p1f W g)).1
        =< apH (G.act (lin W) (prodP (lin W) Iv) (rdj W j)) (pB.pp (lin W) (sq y W (p1f W g)) (cq y W (p1f W g)) (eqp y W (p1f W g))) >
          G.act (lin W) (prodP (lin W) Iv) (rdj W j) (G.act (prodP (lin W) Iv) (lin W) (pr1 (lin W) Iv) (sq y W (p1f W g)).1)
        =< GL.actC (lin W) (prodP (lin W) Iv) (lin W) (pr1 (lin W) Iv) (rdj W j) (sq y W (p1f W g)).1 >
          G.act (lin W) (lin W) (compH (lin W) (prodP (lin W) Iv) (lin W) (pr1 (lin W) Iv) (rdj W j)) (sq y W (p1f W g)).1
        =< apH (\ h -> G.act (lin W) (lin W) h (sq y W (p1f W g)).1) (pr1-pair (lin W) Iv (lin W) (idH (lin W)) j) >
          G.act (lin W) (lin W) (idH (lin W)) (sq y W (p1f W g)).1
        =< G.act-id (lin W) (sq y W (p1f W g)).1 >
          (sq y W (p1f W g)).1
        =< eqp y W (p1f W g) >
          G.act (lin W) (lin m) (compH (lin W) (lin k) (lin m) (dl k y) (p1f W g)) w.1
        =< apH (\ h -> G.act (lin W) (lin m) h w.1)
             (transH (symH (comp-assoc (lin W) Xf (lin k) (lin m) (dl k y) (pr1 (lin k) (lin zero)) g))
               (transH (apH (\ h -> compH (lin W) Xf (lin m) h g) (symH (BG.pr1-dY y)))
                       (comp-assoc (lin W) Xf X0 (lin m) (pr1 (lin m) (lin zero)) (BG.dY y) g))) >
          G.act (lin W) (lin m) (compH (lin W) X0 (lin m) (pr1 (lin m) (lin zero)) (compH (lin W) Xf X0 (BG.dY y) g)) w.1
        =< symH (GL.actC (lin W) X0 (lin m) (pr1 (lin m) (lin zero)) (compH (lin W) Xf X0 (BG.dY y) g) w.1) >
          G.act (lin W) X0 (compH (lin W) Xf X0 (BG.dY y) g) xX
        =< symH (GL.actC (lin W) Xf X0 (BG.dY y) g xX) >
          G.act (lin W) Xf g (G.act Xf X0 (BG.dY y) xX) } ;

    -- < id , j > after h is h * [1] after < id , j h >
    rdjh (V W : Nat) (h : Hom (lin V) (lin W)) (j : Hom (lin W) Iv)
      : Id (Hom (lin V) (prodP (lin W) Iv)) (compH (lin V) (lin W) (prodP (lin W) Iv) (rdj W j) h)
           (compH (lin V) (prodP (lin V) Iv) (prodP (lin W) Iv) (crossH (lin V) (lin W) Iv Iv h (idH Iv)) (rdj V (compH (lin V) (lin W) Iv j h))) =
      transH (BD.pair-h (lin W) Iv (lin V) (lin W) (idH (lin W)) j h)
        (transH (apH (\ q -> pairH (lin W) Iv (lin V) q (compH (lin V) (lin W) Iv j h))
                   (transH (comp-idl (lin V) (lin W) h) (symH (comp-idr (lin V) (lin W) h))))
          (transH (apH (pairH (lin W) Iv (lin V) (compH (lin V) (lin V) (lin W) h (idH (lin V)))) (symH (comp-idl (lin V) Iv (compH (lin V) (lin W) Iv j h))))
                  (symH (BD.cross-pair (lin V) (lin W) Iv Iv (lin V) h (idH Iv) (idH (lin V)) (compH (lin V) (lin W) Iv j h))))) ;

    -- the path restricted along h is the path of the restrictions
    PTh (y V W : Nat) (h : Hom (lin V) (lin W)) (q : Hom (lin W) (lin k))
      : Id (TB.EI (prodP (lin V) Iv)) (TB.E.act (prodP (lin V) Iv) (prodP (lin W) Iv) (crossH (lin V) (lin W) Iv Iv h (idH Iv)) (PT y W q))
                                      (PT y V (compH (lin V) (lin W) (lin k) q h)) =
      transH (pB.pnat (lin V) (lin W) h (sq y W q) (cq y W q) (eqp y W q))
        (TP.pth-eq G B pB (lin V) _ _ _ _ _ (eqp y V (compH (lin V) (lin W) (lin k) q h))
           (TB.PE.actC (lin V) (lin W) (lin k) q h (s y))
           (transH (TB.PE.actC (lin V) (lin W) (lin m) (compH (lin W) (lin k) (lin m) (dl k y) q) h c0)
                   (TB.PE.actEq (lin V) (lin m) _ _ (comp-assoc (lin V) (lin W) (lin k) (lin m) (dl k y) q h) c0))) ;

    Fsn (y : Nat) (hy : IsT (leb y m)) (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) Xf) (j : Hom (lin W) Iv)
      : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (Fs y hy W g j)) (Fs y hy V (compH (lin V) (lin W) Xf g h) (compH (lin V) (lin W) Iv j h)) =
      calc (TB.EI (lin V)) {
          TB.E.act (lin V) (lin W) h (TB.E.act (lin W) (prodP (lin W) Iv) (rdj W j) (PT y W (p1f W g)))
        =< TB.PE.actC (lin V) (lin W) (prodP (lin W) Iv) (rdj W j) h (PT y W (p1f W g)) >
          TB.E.act (lin V) (prodP (lin W) Iv) (compH (lin V) (lin W) (prodP (lin W) Iv) (rdj W j) h) (PT y W (p1f W g))
        =< TB.PE.actEq (lin V) (prodP (lin W) Iv) _ _ (rdjh V W h j) (PT y W (p1f W g)) >
          TB.E.act (lin V) (prodP (lin W) Iv)
            (compH (lin V) (prodP (lin V) Iv) (prodP (lin W) Iv) (crossH (lin V) (lin W) Iv Iv h (idH Iv)) (rdj V (compH (lin V) (lin W) Iv j h)))
            (PT y W (p1f W g))
        =< TB.E.act-o (lin V) (prodP (lin V) Iv) (prodP (lin W) Iv) (crossH (lin V) (lin W) Iv Iv h (idH Iv)) (rdj V (compH (lin V) (lin W) Iv j h))
             (PT y W (p1f W g)) >
          TB.E.act (lin V) (prodP (lin V) Iv) (rdj V (compH (lin V) (lin W) Iv j h))
            (TB.E.act (prodP (lin V) Iv) (prodP (lin W) Iv) (crossH (lin V) (lin W) Iv Iv h (idH Iv)) (PT y W (p1f W g)))
        =< apH (TB.E.act (lin V) (prodP (lin V) Iv) (rdj V (compH (lin V) (lin W) Iv j h))) (PTh y V W h (p1f W g)) >
          TB.E.act (lin V) (prodP (lin V) Iv) (rdj V (compH (lin V) (lin W) Iv j h)) (PT y V (compH (lin V) (lin W) (lin k) (p1f W g) h))
        =< apH (\ q -> TB.E.act (lin V) (prodP (lin V) Iv) (rdj V (compH (lin V) (lin W) Iv j h)) (PT y V q))
             (comp-assoc (lin V) (lin W) Xf (lin k) (pr1 (lin k) (lin zero)) g h) >
          TB.E.act (lin V) (prodP (lin V) Iv) (rdj V (compH (lin V) (lin W) Iv j h)) (PT y V (p1f V (compH (lin V) (lin W) Xf g h))) } ;

    -- the first component of g in the face y
    p1gy (y W : Nat) (g : Hom (lin W) X0)
      : Id (Hom (lin W) (lin k)) (p1f W (BG.gy y W g)) (compH (lin W) (lin m) (lin k) (dgH k y) (BG.p1g W g)) =
      pr1-pair (lin k) (lin zero) (lin W) (compH (lin W) (lin m) (lin k) (dgH k y) (BG.p1g W g)) (BG.p2g W g) ;

    -- d_y dg_y g = g for g missing y
    dlg (y W : Nat) (hy : IsT (leb y m)) (g : Hom (lin W) X0) (ms : Miss (lin W) k y (BG.p1g W g))
      : Id (Hom (lin W) (lin m)) (compH (lin W) (lin k) (lin m) (dl k y) (compH (lin W) (lin m) (lin k) (dgH k y) (BG.p1g W g))) (BG.p1g W g) =
      hom-eq (lin W) (lin m) _ _ (pw-factor (lin W) k y (BG.p1g W g) hy ms) ;

    FFs (y z : Nat) (hy : IsT (leb y m)) (hz : IsT (leb z m)) (lt : IsT (ltb y z))
      (W : Nat) (g : Hom (lin W) X0) (msy : Miss (lin W) k y (BG.p1g W g)) (msz : Miss (lin W) k z (BG.p1g W g)) (j : Hom (lin W) Iv)
      : Id (TB.EI (lin W)) (Fs y hy W (BG.gy y W g) j) (Fs z hz W (BG.gy z W g) j) =
      apH (TB.E.act (lin W) (prodP (lin W) Iv) (rdj W j))
        (TP.pth-eq G B pB (lin W) _ _ _ _ (eqp y W (p1f W (BG.gy y W g))) (eqp z W (p1f W (BG.gy z W g)))
           (transH (apH (\ q -> sq y W q) (p1gy y W g))
             (transH (L.FFm w y z hy hz lt W (BG.p1g W g) msy msz) (apH (\ q -> sq z W q) (symH (p1gy z W g)))))
           (transH (apH (\ q -> cq y W q) (p1gy y W g))
             (transH (apH (\ q -> TB.E.act (lin W) (lin m) q c0) (transH (dlg y W hy g msy) (symH (dlg z W hz g msz))))
                     (apH (\ q -> cq z W q) (symH (p1gy z W g)))))) ;

    module BSm = BD.BS[G, B, k, lin zero, SP.emptyS (lin zero), xX, Fs, Fsp, Fsn,
      \ W g b j -> absurd _ (false-true b), \ W g b j -> absurd _ (false-true b), \ V W h g b b' j -> absurd _ (false-true b),
      FFs, \ y hy W g ms b j -> absurd _ (false-true b)] ;

    -- the lid c0 at s = 1
    a0 (W : Nat) (g : Hom (lin W) X0) : TB.EI (lin W) = TB.E.act (lin W) (lin m) (BG.p1g W g) c0 ;

    a0p (W : Nat) (g : Hom (lin W) X0) : Id (W0.Ix (G.ob (lin W))) (a0 W g).1 (G.act (lin W) X0 g xX) =
      symH (GL.actC (lin W) X0 (lin m) (pr1 (lin m) (lin zero)) g w.1) ;

    a0n (V W : Nat) (h : Hom (lin V) (lin W)) (g : Hom (lin W) X0)
      : Id (TB.EI (lin V)) (TB.E.act (lin V) (lin W) h (a0 W g)) (a0 V (compH (lin V) (lin W) X0 g h)) =
      transH (TB.PE.actC (lin V) (lin W) (lin m) (BG.p1g W g) h c0)
             (TB.PE.actEq (lin V) (lin m) _ _ (comp-assoc (lin V) (lin W) X0 (lin m) (pr1 (lin m) (lin zero)) g h) c0) ;

    aF (y : Nat) (hy : IsT (leb y m)) (W : Nat) (g : Hom (lin W) X0) (ms : Miss (lin W) k y (BG.p1g W g))
      : Id (TB.EI (lin W)) (Fs y hy W (BG.gy y W g) (constH (lin W) Iv e1)) (a0 W g) =
      transH (pB.p1 (lin W) (sq y W (p1f W (BG.gy y W g))) (cq y W (p1f W (BG.gy y W g))) (eqp y W (p1f W (BG.gy y W g))))
        (apH (\ q -> TB.E.act (lin W) (lin m) q c0)
           (transH (apH (compH (lin W) (lin k) (lin m) (dl k y)) (p1gy y W g)) (dlg y W hy g ms))) ;

    module LidM = BSm.Lid[e1, a0, aF, \ W g b -> absurd _ (false-true b)] ;

    module Bx = CBoxFill[a, l].BF[G, B, e1, FFB.S.fill, FFB.S.sides, FFB.S.face,
      X0, HP.ht, HP.B, HP.hB, HP.hm, HP.hi, xX, a0, a0p, a0n, BSm.Q, BSm.sv, BSm.svp, BSm.svn, LidM.sve] ;

    ----------------------------------------------------------------------
    -- the filler: the box at s = 0, on [m] * 0

    cg : Hom (lin m) X0 = pairH (lin m) (lin zero) (lin m) (idH (lin m)) (constH (lin m) (lin zero) (pt0 zero)) ;

    fl' : TB.EI (lin m) = Bx.Fv m cg (constH (lin m) Iv e0) ;

    fl'p : Id (W0.Ix (G.ob (lin m))) fl'.1 w.1 =
      transH (Bx.Fp m cg (constH (lin m) Iv e0))
        (transH (GL.actC (lin m) X0 (lin m) (pr1 (lin m) (lin zero)) cg w.1)
          (transH (apH (\ h -> G.act (lin m) (lin m) h w.1) (pr1-pair (lin m) (lin zero) (lin m) (idH (lin m)) (constH (lin m) (lin zero) (pt0 zero))))
                  (G.act-id (lin m) w.1))) ;

    -- its faces are the sphere
    module Face (y : Nat) (hy : IsT (leb y m)) {
      cgd : Hom (lin k) X0 = compH (lin k) (lin m) X0 cg (dl k y) ;

      p1d : Id (Hom (lin k) (lin m)) (BG.p1g k cgd) (compH (lin k) (lin k) (lin m) (dl k y) (idH (lin k))) =
        transH (symH (comp-assoc (lin k) (lin m) X0 (lin m) (pr1 (lin m) (lin zero)) cg (dl k y)))
          (transH (apH (\ h -> compH (lin k) (lin m) (lin m) h (dl k y)) (pr1-pair (lin m) (lin zero) (lin m) (idH (lin m)) (constH (lin m) (lin zero) (pt0 zero))))
            (transH (comp-idl (lin k) (lin m) (dl k y)) (symH (comp-idr (lin k) (lin m) (dl k y))))) ;

      ms : Miss (lin k) k y (BG.p1g k cgd) =
        substH {Hom (lin k) (lin m)} (\ h -> Miss (lin k) k y h) (symH p1d) (S1m.dl-miss k y k (idH (lin k))) ;

      li : SP.Lands (lin k) X0 BSm.Q cgd = SP.lands-union-l (lin k) X0 BG.facesS (BG.endS (SP.emptyS (lin zero))) cgd (BG.in-faces k cgd y hy ms) ;

      res : Id (TB.EI (lin k)) (TB.E.act (lin k) (lin m) (dl k y) fl') (s y) =
        calc (TB.EI (lin k)) {
            TB.E.act (lin k) (lin m) (dl k y) (Bx.Fv m cg (constH (lin m) Iv e0))
          =< Bx.Fn k m (dl k y) cg (constH (lin m) Iv e0) >
            Bx.Fv k cgd (compH (lin k) (lin m) Iv (constH (lin m) Iv e0) (dl k y))
          =< apH (Bx.Fv k cgd) (BD.const-h (lin k) (lin m) (dl k y) e0) >
            Bx.Fv k cgd (constH (lin k) Iv e0)
          =< Bx.Fs k cgd li (constH (lin k) Iv e0) >
            BSm.sv k cgd li (constH (lin k) Iv e0)
          =< BSm.sv-F y hy k cgd li ms (constH (lin k) Iv e0) >
            Fs y hy k (BG.gy y k cgd) (constH (lin k) Iv e0)
          =< pB.p0 (lin k) (sq y k (p1f k (BG.gy y k cgd))) (cq y k (p1f k (BG.gy y k cgd))) (eqp y k (p1f k (BG.gy y k cgd))) >
            sq y k (p1f k (BG.gy y k cgd))
          =< apH (\ q -> sq y k q)
               (transH (p1gy y k cgd) (transH (apH (compH (lin k) (lin m) (lin k) (dgH k y)) p1d) (dgdl k y hy k (idH (lin k))))) >
            TB.E.act (lin k) (lin k) (idH (lin k)) (s y)
          =< TB.E.act-id (lin k) (s y) >
            s y } ;
    } ;
    opaque fl'p ;
  } ;

  ----------------------------------------------------------------------
  -- the recursion over the dimensions

  -- dimension 0: the vertex
  fl0 (w : TD.EI (lin zero)) : TB.EI (lin zero) =
    (w.1, TB.fromE (lin zero) w.1 (D.rdId (lin zero) w.1 w.2 zero (refl true) (idH (lin zero)))
       (transH (G.act-id (lin zero) (G.act (lin zero) (lin zero) (idH (lin zero)) w.1)) (G.act-id (lin zero) w.1))) ;

  FFm0 : FFmTy zero fl0 = \ w y z hy hz lt W g msy msz ->
    absurd _ (CDStageF[a, l].two-miss (vnum (app (lin W) (lin (suc zero)) g (pt0 W)).1) y z
                (vnum-range (suc zero) (app (lin W) (lin (suc zero)) g (pt0 W)).1 (app (lin W) (lin (suc zero)) g (pt0 W)).2) hy hz
                (msy (pt0 W)) (msz (pt0 W)) (ltb-neq y z lt)) ;

  L0 : Lv[zero] = new Lv[zero, fl0, \ w -> refl w.1, FFm0] ;

  -- the faces at the next dimension agree, through the codimension-2 face
  module FS (k : Nat) (L : Lv[k]) {
    fl1 (v : TD.EI (lin (suc k))) : TB.EI (lin (suc k)) = ST[k, L, v].fl' ;

    module FH (w : TD.EI (lin (suc (suc k)))) (y : Nat) (hy : IsT (leb y (suc (suc k))))
      (z' : Nat) (hz : IsT (leb (suc z') (suc (suc k)))) (lt : IsT (ltb y (suc z'))) (W : Nat) (g : Hom (lin W) (lin (suc (suc k))))
      (msy : Miss (lin W) (suc k) y g) (msz : Miss (lin W) (suc k) (suc z') g) {
      module T = CFaceTwo[a].TW[k, y, z', lt, hy, hz, lin W, g, msy, msz] ;
      Fy : TD.EI (lin (suc k)) = TD.E.act (lin (suc k)) (lin (suc (suc k))) (dl (suc k) y) w ;
      Fz : TD.EI (lin (suc k)) = TD.E.act (lin (suc k)) (lin (suc (suc k))) (dl (suc k) (suc z')) w ;

      dd : Id (TD.EI (lin k)) (TD.E.act (lin k) (lin (suc k)) (dl k z') Fy) (TD.E.act (lin k) (lin (suc k)) (dl k y) Fz) =
        transH (TD.PE.actC (lin k) (lin (suc k)) (lin (suc (suc k))) (dl (suc k) y) (dl k z') w)
          (transH (TD.PE.actEq (lin k) (lin (suc (suc k))) _ _ (symH (hom-eq (lin k) (lin (suc (suc k))) _ _ (pw-dl-dl k y z' lt))) w)
                  (symH (TD.PE.actC (lin k) (lin (suc k)) (lin (suc (suc k))) (dl (suc k) (suc z')) (dl k y) w))) ;

      res : Id (TB.EI (lin W)) (TB.E.act (lin W) (lin (suc k)) T.g' (fl1 Fy))
                               (TB.E.act (lin W) (lin (suc k)) (compH (lin W) (lin (suc (suc k))) (lin (suc k)) (dgH (suc k) (suc z')) g) (fl1 Fz)) =
        calc (TB.EI (lin W)) {
            TB.E.act (lin W) (lin (suc k)) T.g' (fl1 Fy)
          =< apH (\ h -> TB.E.act (lin W) (lin (suc k)) h (fl1 Fy)) (symH (hom-eq (lin W) (lin (suc k)) _ _ (pw-factor (lin W) k z' T.g' hz T.ms'))) >
            TB.E.act (lin W) (lin (suc k)) (compH (lin W) (lin k) (lin (suc k)) (dl k z') T.hh) (fl1 Fy)
          =< TB.E.act-o (lin W) (lin k) (lin (suc k)) (dl k z') T.hh (fl1 Fy) >
            TB.E.act (lin W) (lin k) T.hh (TB.E.act (lin k) (lin (suc k)) (dl k z') (fl1 Fy))
          =< apH (TB.E.act (lin W) (lin k) T.hh) ST[k, L, Fy].Face[z', hz].res >
            TB.E.act (lin W) (lin k) T.hh (L.fl (TD.E.act (lin k) (lin (suc k)) (dl k z') Fy))
          =< apH (\ v -> TB.E.act (lin W) (lin k) T.hh (L.fl v)) dd >
            TB.E.act (lin W) (lin k) T.hh (L.fl (TD.E.act (lin k) (lin (suc k)) (dl k y) Fz))
          =< apH (TB.E.act (lin W) (lin k) T.hh) (symH ST[k, L, Fz].Face[y, leb-trans y z' (suc k) lt hz].res) >
            TB.E.act (lin W) (lin k) T.hh (TB.E.act (lin k) (lin (suc k)) (dl k y) (fl1 Fz))
          =< symH (TB.E.act-o (lin W) (lin k) (lin (suc k)) (dl k y) T.hh (fl1 Fz)) >
            TB.E.act (lin W) (lin (suc k)) (compH (lin W) (lin k) (lin (suc k)) (dl k y) T.hh) (fl1 Fz)
          =< apH (\ h -> TB.E.act (lin W) (lin (suc k)) h (fl1 Fz)) T.eq-dlh >
            TB.E.act (lin W) (lin (suc k)) (compH (lin W) (lin (suc (suc k))) (lin (suc k)) (dgH (suc k) (suc z')) g) (fl1 Fz) } ;
    } ;

    ffS (w : TD.EI (lin (suc (suc k)))) (y : Nat) (hy : IsT (leb y (suc (suc k))))
      : (z : Nat) (hz : IsT (leb z (suc (suc k)))) (lt : IsT (ltb y z)) (W : Nat) (g : Hom (lin W) (lin (suc (suc k))))
        (msy : Miss (lin W) (suc k) y g) (msz : Miss (lin W) (suc k) z g)
      -> Id (TB.EI (lin W)) (TB.E.act (lin W) (lin (suc k)) (compH (lin W) (lin (suc (suc k))) (lin (suc k)) (dgH (suc k) y) g)
                               (fl1 (TD.E.act (lin (suc k)) (lin (suc (suc k))) (dl (suc k) y) w)))
                            (TB.E.act (lin W) (lin (suc k)) (compH (lin W) (lin (suc (suc k))) (lin (suc k)) (dgH (suc k) z) g)
                               (fl1 (TD.E.act (lin (suc k)) (lin (suc (suc k))) (dl (suc k) z) w))) = split {
      zero -> \ hz lt -> absurd _ (false-true lt) ;
      suc z' -> \ hz lt W g msy msz -> FH[w, y, hy, z', hz, lt, W, g, msy, msz].res } ;

    ff : FFmTy (suc k) fl1 = \ w y z hy hz lt W g msy msz -> ffS w y hy z hz lt W g msy msz ;

    next : Lv[suc k] = new Lv[suc k, fl1, \ v -> ST[k, L, v].fl'p, ff] ;
  } ;

  Lrec : (k : Nat) -> Lv[k] = split {
    zero -> L0 ;
    suc k | ih -> FS[k, ih].next } ;

  ----------------------------------------------------------------------
  -- the map D_0 B -> D B

  FL (n : Nat) (w : TD.EI (lin n)) : TB.EI (lin n) = (Lrec n).fl w ;

  sF (I : Ob) (x : W0.Ix (G.ob I)) (z : W0.Ix (D.DK.DA.tob I x)) : DB.Fam I x = \ n f ->
    TB.fromE (lin n) (G.act (lin n) I f x) (FL n (TD.E.act (lin n) I f (x, z))) ((Lrec n).flp (TD.E.act (lin n) I f (x, z))) ;

  rdF (I : Ob) (x : W0.Ix (G.ob I)) (z : W0.Ix (D.DK.DA.tob I x)) (n : Nat) (f : Hom (lin n) I)
    : Id (TB.EI (lin n)) (DB.rd I x (sF I x z) n f) (FL n (TD.E.act (lin n) I f (x, z))) =
    TB.fromE-eq (lin n) (G.act (lin n) I f x) (FL n (TD.E.act (lin n) I f (x, z))) ((Lrec n).flp (TD.E.act (lin n) I f (x, z))) ;

  fc (I : Ob) (x : W0.Ix (G.ob I)) (z : W0.Ix (D.DK.DA.tob I x)) : DB.FaceCompat I x (sF I x z) = \ n f y hy ->
    transH (apH (TB.E.act (lin n) (lin (suc n)) (dl n y)) (rdF I x z (suc n) f))
      (transH ST[n, Lrec n, TD.E.act (lin (suc n)) I f (x, z)].Face[y, hy].res
        (transH (apH (FL n) (TD.PE.actC (lin n) (lin (suc n)) I f (dl n y) (x, z)))
                (symH (rdF I x z n (compH (lin n) (lin (suc n)) I f (dl n y)))))) ;

  sv (I : Ob) (x : W0.Ix (G.ob I)) (z : W0.Ix (D.DK.DA.tob I x)) : DB.DEl I x = (sF I x z, DB.FacesGen[I, x, sF I x z, fc I x z].facesGen) ;

  snat (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (z : W0.Ix (D.DK.DA.tob I x))
    : Id (DB.DEl J y) (DB.dtact J I h x y e (sv I x z)) (sv J y (D.DK.DA.tact J I h x y e z)) =
    DB.Dext J y _ _ (\ n f ->
      transH (DB.rd-dtact J I h x y e (sv I x z) n f)
        (transH (rdF I x z n (compH (lin n) J I h f))
          (transH (apH (FL n) (transH (symH (TD.PE.actC (lin n) J I h f (x, z)))
                                      (apH (TD.E.act (lin n) J f) (TD.pr-tact J I h x y e z))))
                  (symH (rdF J y (D.DK.DA.tact J I h x y e z) n f))))) ;

  sN : LD.NatMap[G, D.DK.DA, DB.DA] = new LD.NatMap[G, D.DK.DA, DB.DA, sv, snat] ;
} ;

------------------------------------------------------------------------
-- K_N on maps

module KMap (G : PP.PCtx) (A B : PP.PTy[G]) (al : LD.NatMap[G, A, B]) (N : Nat) {
  module KA = CK.KT[G, A, N] ;
  module KB = CK.KT[G, B, N] ;
  module DM = LD.DMap[G, A, B, al] ;

  kf (I : Ob) (x : W0.Ix (G.ob I)) (u : KA.KEl I x) : KB.KEl I x =
    (\ n hn f -> al.nfun (lin n) (G.act (lin n) I f x) (u.1 n hn f),
     \ m n hm hn g f -> transH (symH (DM.alE-act (lin m) (lin n) g (KA.rd I x u.1 n hn f))) (apH (DM.alE (lin m)) (u.2 m n hm hn g f))) ;

  kn (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y) (u : KA.KEl I x)
    : Id (KB.KEl J y) (KB.ktact J I h x y e (kf I x u)) (kf J y (KA.ktact J I h x y e u)) =
    KB.Kext J y _ _ (\ n hn k ->
      transH (KB.rd-ktact J I h x y e (kf I x u) n hn k) (apH (DM.alE (lin n)) (symH (KA.rd-ktact J I h x y e u n hn k)))) ;

  kN : LD.NatMap[G, KA.KA, KB.KA] = new LD.NatMap[G, KA.KA, KB.KA, kf, kn] ;
} ;

------------------------------------------------------------------------
-- the universal property: a map D_0 A -> B for B a fibrant D-modal
-- proposition and g : A -> B

module UP0 (G : PP.PCtx) (A B : PP.PTy[G]) (cB : PB.CLine[l].Lines[G, B].Fib) (mB : CLocUniv[a, l].isModal G B)
  (pB : TP.IsPropE[G, B]) (g : LD.NatMap[G, A, B]) {
  module S = SF[G, B, cB, pB] ;
  module KG = KMap[G, A, B, g, zero] ;
  D0A : PP.PTy[G] = LD.DT[G, KG.KA.KA].DA ;
  D0B : PP.PTy[G] = LD.DT[G, KG.KB.KA].DA ;
  DB : PP.PTy[G] = LD.DT[G, B].DA ;

  D0g : LD.NatMap[G, D0A, D0B] = LD.DMap[G, KG.KA.KA, KG.KB.KA, KG.kN].DN ;

  k : HO.NMap[G, D0A, B] =
    HO.compN G D0A DB B (CH.toN G D0A DB (CLocUniv[a, l].compL G D0A D0B DB D0g S.sN)) mB.inv ;
} ;
