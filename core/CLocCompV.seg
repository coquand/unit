-- CLocCompV.seg (L9): the values of the problem of DA read along f
-- (localisation.tex, Theorem DA: the Eilenberg-Zilber extension).
--
-- Data: a point w of DA over a line of G at X (at the end e), a side sd of
-- the strict fibres of DA, and f : [n] -> X.  At a point (G' , J) of the
-- prism [n] * [1] at stage W with f G' in the sieve of sd:
--
--   zz       the value of the line of sd at the stage f G', at (id , J):
--            an element of E_DA at [W]
--   val      sigma^* (zz read at sec): the image factorisation
--            (G' , J) = (c1 , c2) sigma (CLocEZ.EZP), and zz is read on the
--            image chain only
--   fc       zz is constant along sec sigma (f G' sec sigma = f G')
--   ind      two factorisations through k : [W'] -> [W] give the same value:
--            k^* (sigma^* zz(sec)) = sigma2^* zz(k sec2), by Compat along the
--            strict mu = sigma k sec2 only

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module SP = CPosBase[a].SP ;
module EZm = CLocEZ[a] ;

module VA (G : PP.PCtx) (A : PP.PTy[G]) (e : El Iv) {
  module DTm = CLocD[a, l].DT[G, A] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module TD = PB.GPre[l].TyL[G, DTm.DA] ;
  module KD = PB.CLine[l].EndKit[G, DTm.DA, e] ;
  module GL = PB.GPre[l].PshL[G] ;

  -- the value of a DA-element zz at stage [W], read at sec, restricted along sgm
  rdS (W r : Nat) (zz : TD.EI (lin W)) (sgm : Hom (lin W) (lin r)) (sec : Hom (lin r) (lin W)) : TA.EI (lin W) =
    TA.E.act (lin W) (lin r) sgm (DTm.rd (lin W) zz.1 zz.2.1 r sec) ;

  ----------------------------------------------------------------------
  -- two factorisations through k

  module Ind (W W' : Nat) (zz : TD.EI (lin W)) (r r2 : Nat)
    (sgm : Hom (lin W) (lin r)) (sec : Hom (lin r) (lin W))
    (sgm2 : Hom (lin W') (lin r2)) (sec2 : Hom (lin r2) (lin W')) (k : Hom (lin W') (lin W))
    (mus : Strict (lin r2) (lin r) (compH (lin r2) (lin W') (lin r) (compH (lin W') (lin W) (lin r) sgm k) sec2))
    (muEq : Id (Hom (lin W') (lin r)) (compH (lin W') (lin W) (lin r) sgm k)
               (compH (lin W') (lin r2) (lin r) (compH (lin r2) (lin W') (lin r) (compH (lin W') (lin W) (lin r) sgm k) sec2) sgm2))
    (fc : Id (TD.EI (lin W)) (TD.E.act (lin W) (lin W) (compH (lin W) (lin r) (lin W) sec sgm) zz) zz) {

    sk : Hom (lin W') (lin r) = compH (lin W') (lin W) (lin r) sgm k ;
    mu : Hom (lin r2) (lin r) = compH (lin r2) (lin W') (lin r) sk sec2 ;
    ss : Hom (lin W) (lin W) = compH (lin W) (lin r) (lin W) sec sgm ;
    ks : Hom (lin r2) (lin W) = compH (lin r2) (lin W') (lin W) k sec2 ;
    X0 : TA.EI (lin r) = DTm.rd (lin W) zz.1 zz.2.1 r sec ;

    -- zz read at sec mu is zz read at k sec2 (fc)
    secmu : Id (TA.EI (lin r2)) (DTm.rd (lin W) zz.1 zz.2.1 r2 (compH (lin r2) (lin r) (lin W) sec mu))
                              (DTm.rd (lin W) zz.1 zz.2.1 r2 ks) =
      calc (TA.EI (lin r2)) {
          DTm.rd (lin W) zz.1 zz.2.1 r2 (compH (lin r2) (lin r) (lin W) sec mu)
        =< apH (\ q -> DTm.rd (lin W) zz.1 zz.2.1 r2 q)
             (transH (apH (compH (lin r2) (lin r) (lin W) sec) (comp-assoc (lin r2) (lin W') (lin W) (lin r) sgm k sec2))
                     (symH (comp-assoc (lin r2) (lin W) (lin r) (lin W) sec sgm ks))) >
          DTm.rd (lin W) zz.1 zz.2.1 r2 (compH (lin r2) (lin W) (lin W) ss ks)
        =< symH (DTm.rd-dtact (lin W) (lin W) ss zz.1 (G.act (lin W) (lin W) ss zz.1) (refl (G.act (lin W) (lin W) ss zz.1)) zz.2 r2 ks) >
          DTm.rd (lin W) (TD.E.act (lin W) (lin W) ss zz).1 (TD.E.act (lin W) (lin W) ss zz).2.1 r2 ks
        =< DTm.evalE (lin W) (TD.E.act (lin W) (lin W) ss zz).1 zz.1 (TD.E.act (lin W) (lin W) ss zz).2 zz.2 fc r2 ks >
          DTm.rd (lin W) zz.1 zz.2.1 r2 ks } ;

    res : Id (TA.EI (lin W')) (TA.E.act (lin W') (lin W) k (rdS W r zz sgm sec))
                              (rdS W' r2 (TD.E.act (lin W') (lin W) k zz) sgm2 sec2) =
      calc (TA.EI (lin W')) {
          TA.E.act (lin W') (lin W) k (TA.E.act (lin W) (lin r) sgm X0)
        =< TA.PE.actC (lin W') (lin W) (lin r) sgm k X0 >
          TA.E.act (lin W') (lin r) sk X0
        =< TA.PE.actEq (lin W') (lin r) sk (compH (lin W') (lin r2) (lin r) mu sgm2) muEq X0 >
          TA.E.act (lin W') (lin r) (compH (lin W') (lin r2) (lin r) mu sgm2) X0
        =< symH (TA.PE.actC (lin W') (lin r2) (lin r) mu sgm2 X0) >
          TA.E.act (lin W') (lin r2) sgm2 (TA.E.act (lin r2) (lin r) mu X0)
        =< apH (TA.E.act (lin W') (lin r2) sgm2) (zz.2.2 r2 r mu mus sec) >
          TA.E.act (lin W') (lin r2) sgm2 (DTm.rd (lin W) zz.1 zz.2.1 r2 (compH (lin r2) (lin r) (lin W) sec mu))
        =< apH (TA.E.act (lin W') (lin r2) sgm2) secmu >
          TA.E.act (lin W') (lin r2) sgm2 (DTm.rd (lin W) zz.1 zz.2.1 r2 ks)
        =< apH (TA.E.act (lin W') (lin r2) sgm2)
             (symH (DTm.rd-dtact (lin W') (lin W) k zz.1 (G.act (lin W') (lin W) k zz.1) (refl (G.act (lin W') (lin W) k zz.1)) zz.2 r2 sec2)) >
          rdS W' r2 (TD.E.act (lin W') (lin W) k zz) sgm2 sec2 } ;

    opaque secmu ; opaque res ;
  } ;
} ;

------------------------------------------------------------------------
-- the values of the problem at (X , w , sd) read along f : [n] -> X

module Pb (G : PP.PCtx) (A : PP.PTy[G]) (e : El Iv) (X : Ob)
  (w : VA[G, A, e].KD.TV.EI X) (sd : VA[G, A, e].KD.PT.Side[X, w])
  (n : Nat) (f : Hom (lin n) X) {
  module VV = VA[G, A, e] ;
  module DTm = VV.DTm ;
  module TA = VV.TA ;
  module TD = VV.TD ;
  module KD = VV.KD ;

  -- the value at a point (G' , J) of the prism at stage W
  module Pt (W : Nat) (G' : Hom (lin W) (lin n)) (J : Hom (lin W) Iv) (lG : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G')) {
    module Z = EZm.EZP[n, W, G', J] ;
    fG : Hom (lin W) X = compH (lin W) (lin n) X f G' ;
    u : KD.TS.EI (lin W) = sd.pv (lin W) fG lG ;
    zz : TD.EI (lin W) = (KD.lineL (lin W) u).2.1.1 (lin W) (idH (lin W)) J ;
    val : TA.EI (lin W) = VV.rdS W Z.r zz Z.sgm Z.sec ;

    ss : Hom (lin W) (lin W) = compH (lin W) (lin Z.r) (lin W) Z.sec Z.sgm ;

    Gss : Id (Hom (lin W) (lin n)) (compH (lin W) (lin W) (lin n) G' ss) G' =
      transH (symH (comp-assoc (lin W) (lin Z.r) (lin W) (lin n) G' Z.sec Z.sgm)) Z.facG ;
    Jss : Id (Hom (lin W) Iv) (compH (lin W) (lin W) Iv J ss) J =
      transH (symH (comp-assoc (lin W) (lin Z.r) (lin W) Iv J Z.sec Z.sgm)) Z.facJ ;
    fGss : Id (Hom (lin W) X) (compH (lin W) (lin W) X fG ss) fG =
      transH (comp-assoc (lin W) (lin W) (lin n) X f G' ss) (apH (compH (lin W) (lin n) X f) Gss) ;

    lss : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin W) X fG ss) = SP.lands-comp (lin W) (lin W) X sd.pQ fG ss lG ;

    -- zz is constant along sec sigma
    fc : Id (TD.EI (lin W)) (TD.E.act (lin W) (lin W) ss zz) zz =
      calc (TD.EI (lin W)) {
          TD.E.act (lin W) (lin W) ss zz
        =< (KD.lineL (lin W) u).2.1.2 (lin W) (lin W) ss (idH (lin W)) J >
          (KD.lineL (lin W) u).2.1.1 (lin W) (compH (lin W) (lin W) (lin W) (idH (lin W)) ss) (compH (lin W) (lin W) Iv J ss)
        =< apH (\ q -> (KD.lineL (lin W) u).2.1.1 (lin W) q (compH (lin W) (lin W) Iv J ss))
             (transH (comp-idl (lin W) (lin W) ss) (symH (comp-idr (lin W) (lin W) ss))) >
          (KD.lineL (lin W) u).2.1.1 (lin W) (compH (lin W) (lin W) (lin W) ss (idH (lin W))) (compH (lin W) (lin W) Iv J ss)
        =< apH (\ q -> (KD.lineL (lin W) u).2.1.1 (lin W) (compH (lin W) (lin W) (lin W) ss (idH (lin W))) q) Jss >
          (KD.lineL (lin W) u).2.1.1 (lin W) (compH (lin W) (lin W) (lin W) ss (idH (lin W))) J
        =< symH (apH (\ M -> M.2.1.1 (lin W) (idH (lin W)) J) (KD.lineL-act (lin W) (lin W) ss u)) >
          (KD.lineL (lin W) (KD.TS.E.act (lin W) (lin W) ss u)).2.1.1 (lin W) (idH (lin W)) J
        =< apH (\ v -> (KD.lineL (lin W) v).2.1.1 (lin W) (idH (lin W)) J)
             (transH (sd.pnat (lin W) (lin W) ss fG lG lss)
                     (KD.PT.pv-hom X w sd (lin W) (compH (lin W) (lin W) X fG ss) fG fGss lss lG)) >
          zz } ;

    -- the point of the value: the line of G at (f G' , J)
    eqF : Id (Hom (lin W) X) (compH (lin W) (lin Z.r) X (compH (lin Z.r) (lin W) X (compH (lin W) (lin W) X fG (idH (lin W))) Z.sec) Z.sgm) fG =
      transH (apH (\ q -> compH (lin W) (lin Z.r) X (compH (lin Z.r) (lin W) X q Z.sec) Z.sgm) (comp-idr (lin W) X fG))
             (transH (comp-assoc (lin W) (lin Z.r) (lin W) X fG Z.sec Z.sgm) fGss) ;

    val-pt : Id (W0.Ix (G.ob (lin W))) val.1 (w.1.1 (lin W) fG J) =
      calc (W0.Ix (G.ob (lin W))) {
          G.act (lin W) (lin Z.r) Z.sgm (G.act (lin Z.r) (lin W) Z.sec zz.1)
        =< apH (\ x -> G.act (lin W) (lin Z.r) Z.sgm (G.act (lin Z.r) (lin W) Z.sec x))
             (transH (apH (\ y -> y.1 (lin W) (idH (lin W)) J) (KD.lineL (lin W) u).2.2)
                     (apH (\ z -> z.1.1 (lin W) (idH (lin W)) J) (sd.ppt (lin W) fG lG))) >
          G.act (lin W) (lin Z.r) Z.sgm (G.act (lin Z.r) (lin W) Z.sec (w.1.1 (lin W) (compH (lin W) (lin W) X fG (idH (lin W))) J))
        =< apH (G.act (lin W) (lin Z.r) Z.sgm) (w.1.2 (lin Z.r) (lin W) Z.sec (compH (lin W) (lin W) X fG (idH (lin W))) J) >
          G.act (lin W) (lin Z.r) Z.sgm (w.1.1 (lin Z.r) (compH (lin Z.r) (lin W) X (compH (lin W) (lin W) X fG (idH (lin W))) Z.sec) (compH (lin Z.r) (lin W) Iv J Z.sec))
        =< w.1.2 (lin W) (lin Z.r) Z.sgm (compH (lin Z.r) (lin W) X (compH (lin W) (lin W) X fG (idH (lin W))) Z.sec) (compH (lin Z.r) (lin W) Iv J Z.sec) >
          w.1.1 (lin W) (compH (lin W) (lin Z.r) X (compH (lin Z.r) (lin W) X (compH (lin W) (lin W) X fG (idH (lin W))) Z.sec) Z.sgm)
                        (compH (lin W) (lin Z.r) Iv (compH (lin Z.r) (lin W) Iv J Z.sec) Z.sgm)
        =< apH (\ q -> w.1.1 (lin W) q (compH (lin W) (lin Z.r) Iv (compH (lin Z.r) (lin W) Iv J Z.sec) Z.sgm)) eqF >
          w.1.1 (lin W) fG (compH (lin W) (lin Z.r) Iv (compH (lin Z.r) (lin W) Iv J Z.sec) Z.sgm)
        =< apH (\ q -> w.1.1 (lin W) fG q) Z.facJ >
          w.1.1 (lin W) fG J } ;

    opaque val-pt ;
    opaque fc ;
  } ;

  -- the value at two equal maps
  val-hom (W : Nat) (G1 G2 : Hom (lin W) (lin n)) (E : Id (Hom (lin W) (lin n)) G1 G2) (J : Hom (lin W) Iv)
    (l1 : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G1)) (l2 : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G2))
    : Id (TA.EI (lin W)) (Pt[W, G1, J, l1].val) (Pt[W, G2, J, l2].val) =
    idJ (Hom (lin W) (lin n)) G1
      (\ G3 E3 -> (l3 : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G3)) -> Id (TA.EI (lin W)) (Pt[W, G1, J, l1].val) (Pt[W, G3, J, l3].val))
      (\ l3 -> apH (\ q -> Pt[W, G1, J, q].val) (SP.isProp-Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G1) l1 l3))
      G2 E l2 ;

  opaque val-hom ;

  ----------------------------------------------------------------------
  -- when sigma is strict the value is zz read at the identity

  module VInj (W : Nat) (G' : Hom (lin W) (lin n)) (J : Hom (lin W) Iv) (lG : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G'))
    (sst : Strict (lin W) (lin Pt[W, G', J, lG].Z.r) Pt[W, G', J, lG].Z.sgm) {
    module P = Pt[W, G', J, lG] ;

    res : Id (TA.EI (lin W)) P.val (DTm.rd (lin W) P.zz.1 P.zz.2.1 W (idH (lin W))) =
      calc (TA.EI (lin W)) {
          TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (DTm.rd (lin W) P.zz.1 P.zz.2.1 P.Z.r P.Z.sec)
        =< P.zz.2.2 W P.Z.r P.Z.sgm sst P.Z.sec >
          DTm.rd (lin W) P.zz.1 P.zz.2.1 W (compH (lin W) (lin P.Z.r) (lin W) P.Z.sec P.Z.sgm)
        =< apH (\ q -> DTm.rd (lin W) P.zz.1 P.zz.2.1 W q) (symH (comp-idr (lin W) (lin W) P.ss)) >
          DTm.rd (lin W) P.zz.1 P.zz.2.1 W (compH (lin W) (lin W) (lin W) P.ss (idH (lin W)))
        =< symH (DTm.rd-dtact (lin W) (lin W) P.ss P.zz.1 (G.act (lin W) (lin W) P.ss P.zz.1) (refl (G.act (lin W) (lin W) P.ss P.zz.1)) P.zz.2 W (idH (lin W))) >
          DTm.rd (lin W) (TD.E.act (lin W) (lin W) P.ss P.zz).1 (TD.E.act (lin W) (lin W) P.ss P.zz).2.1 W (idH (lin W))
        =< DTm.evalE (lin W) (TD.E.act (lin W) (lin W) P.ss P.zz).1 P.zz.1 (TD.E.act (lin W) (lin W) P.ss P.zz).2 P.zz.2 P.fc W (idH (lin W)) >
          DTm.rd (lin W) P.zz.1 P.zz.2.1 W (idH (lin W)) } ;
    opaque res ;
  } ;

  ----------------------------------------------------------------------
  -- at a strict G' the factor sigma is strict

  module StP (W : Nat) (G' : Hom (lin W) (lin n)) (J : Hom (lin W) Iv) (lG : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G'))
    (st : Strict (lin W) (lin n) G') {
    module P = Pt[W, G', J, lG] ;
    module H = EZm.HPr[n, W, G', J] ;

    inj (i j : Nat) (hi : IsT (leb i W)) (hj : IsT (leb j W)) (q : Id Nat (H.hN i) (H.hN j)) : Id Nat i j =
      EZm.VH.valT-inj W n G' st i j hi hj (H.to-pair i j (transH (symH (H.hN-eq i hi)) (transH q (H.hN-eq j hj)))).1 ;

    sst : Strict (lin W) (lin P.Z.r) P.Z.sgm = P.Z.Z.SigS[inj].sigStrict ;
    opaque inj ; opaque sst ;
  } ;

  ----------------------------------------------------------------------
  -- the end condition: at (G' , e) the value is G'^* of the end of w at f

  module EndC (W : Nat) (G' : Hom (lin W) (lin n)) (lG : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G')) {
    module VF = CDeltaFact[a] ;
    module P = Pt[W, G', constH (lin W) Iv e, lG] ;
    module H = EZm.HPr[n, W, G', constH (lin W) Iv e] ;
    module E = P.Z.Z.E ;
    module FA = PB.CLine[l].FT[G, DTm.DA] ;
    E0 : TD.EI X = KD.endE X w ;

    -- the side value at the end is the end of w, restricted
    zEnd : Id (TD.EI (lin W)) P.zz (TD.E.act (lin W) X P.fG E0) =
      calc (TD.EI (lin W)) {
          P.zz
        =< symH (FA.Ev[e].endB-E (lin W) (KD.lineL (lin W) P.u)) >
          KD.endE (lin W) (FA.Ev[e].evA.mE (lin W) (KD.lineL (lin W) P.u))
        =< apH (KD.endE (lin W)) P.u.2.2 >
          KD.endE (lin W) P.u.1
        =< apH (KD.endE (lin W)) (sd.ppt (lin W) P.fG lG) >
          KD.endE (lin W) (KD.TV.E.act (lin W) X P.fG w)
        =< KD.endE-act (lin W) X P.fG w >
          TD.E.act (lin W) X P.fG E0 } ;

    c1 : Hom (lin P.Z.r) (lin n) = P.Z.c1 ;

    -- c1 = G' sec is strict, since J is constant
    c1-strict : Strict (lin P.Z.r) (lin n) c1 =
      EZm.VH.strict-of-valT P.Z.r n c1 (\ i j l0 hj ->
        substH {Nat} (\ z -> IsT (ltb z (VF.valT P.Z.r n c1 j))) {VF.valT W n G' (E.secC i)} {VF.valT P.Z.r n c1 i}
          (symH (transH (CDPrism[a].valT-comp P.Z.r W n G' P.Z.sec i (leb-trans i j P.Z.r (ltb-leb i j l0) hj))
                        (apH {Nat} {Nat} (\ z -> VF.valT W n G' (E.secC z)) (VF.clamp-eq P.Z.r i (leb-trans i j P.Z.r (ltb-leb i j l0) hj)))))
          (substH {Nat} (\ z -> IsT (ltb (VF.valT W n G' (E.secC i)) z)) {VF.valT W n G' (E.secC j)} {VF.valT P.Z.r n c1 j}
             (symH (transH (CDPrism[a].valT-comp P.Z.r W n G' P.Z.sec j hj)
                           (apH {Nat} {Nat} (\ z -> VF.valT W n G' (E.secC z)) (VF.clamp-eq P.Z.r j hj))))
             (leb-neq (VF.valT W n G' (E.secC i)) (VF.valT W n G' (E.secC j))
                (VF.valT-mono W n G' (E.secC i) (E.secC j) (E.secC-mono i j (ltb-leb i j l0)))
                (neqOf (VF.valT W n G' (E.secC i)) (VF.valT W n G' (E.secC j)) (\ q ->
                   EZm.ltb-irr' (E.mC i) (substH {Nat} (\ z -> IsT (ltb (E.mC i) z)) {E.mC j} {E.mC i}
                     (symH (transH (H.hN-eq (E.secC i) (E.secC-le i))
                       (transH (EZm.hf-cong (H.F.gn (E.secC i)) (H.F.jn (E.secC i)) (H.F.gn (E.secC j)) (H.F.jn (E.secC j)) q (refl (H.F.jn (E.secC i))))
                               (symH (H.hN-eq (E.secC j) (E.secC-le j))))))
                     (E.mC-strict j i l0 hj)))))))
     where { neqOf (x y : Nat) (k : Id Nat x y -> Empty) : IsT (not (eqN x y)) =
               eqN-dec (IsT (not (eqN x y))) x y (\ q -> absurd _ (k q)) (\ ne -> ne) ; } ;

    res : Id (TA.EI (lin W)) P.val (TA.E.act (lin W) (lin n) G' (DTm.rd X E0.1 E0.2.1 n f)) =
      calc (TA.EI (lin W)) {
          TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (DTm.rd (lin W) P.zz.1 P.zz.2.1 P.Z.r P.Z.sec)
        =< apH (TA.E.act (lin W) (lin P.Z.r) P.Z.sgm)
             (DTm.evalE (lin W) P.zz.1 (TD.E.act (lin W) X P.fG E0).1 P.zz.2 (TD.E.act (lin W) X P.fG E0).2 zEnd P.Z.r P.Z.sec) >
          TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (DTm.rd (lin W) (TD.E.act (lin W) X P.fG E0).1 (TD.E.act (lin W) X P.fG E0).2.1 P.Z.r P.Z.sec)
        =< apH (TA.E.act (lin W) (lin P.Z.r) P.Z.sgm)
             (DTm.rd-dtact (lin W) X P.fG E0.1 (G.act (lin W) X P.fG E0.1) (refl (G.act (lin W) X P.fG E0.1)) E0.2 P.Z.r P.Z.sec) >
          TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (DTm.rd X E0.1 E0.2.1 P.Z.r (compH (lin P.Z.r) (lin W) X P.fG P.Z.sec))
        =< apH (\ q -> TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (DTm.rd X E0.1 E0.2.1 P.Z.r q)) (comp-assoc (lin P.Z.r) (lin W) (lin n) X f G' P.Z.sec) >
          TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (DTm.rd X E0.1 E0.2.1 P.Z.r (compH (lin P.Z.r) (lin n) X f c1))
        =< apH (TA.E.act (lin W) (lin P.Z.r) P.Z.sgm) (symH (E0.2.2 P.Z.r n c1 c1-strict f)) >
          TA.E.act (lin W) (lin P.Z.r) P.Z.sgm (TA.E.act (lin P.Z.r) (lin n) c1 (DTm.rd X E0.1 E0.2.1 n f))
        =< TA.PE.actC (lin W) (lin P.Z.r) (lin n) c1 P.Z.sgm (DTm.rd X E0.1 E0.2.1 n f) >
          TA.E.act (lin W) (lin n) (compH (lin W) (lin P.Z.r) (lin n) c1 P.Z.sgm) (DTm.rd X E0.1 E0.2.1 n f)
        =< TA.PE.actEq (lin W) (lin n) (compH (lin W) (lin P.Z.r) (lin n) c1 P.Z.sgm) G' P.Z.facG (DTm.rd X E0.1 E0.2.1 n f) >
          TA.E.act (lin W) (lin n) G' (DTm.rd X E0.1 E0.2.1 n f) } ;
    opaque zEnd ; opaque c1-strict ; opaque res ;
  } ;

  ----------------------------------------------------------------------
  -- naturality along h' : [W'] -> [W]

  module NatV (W W' : Nat) (G' : Hom (lin W) (lin n)) (J : Hom (lin W) Iv) (lG : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f G'))
    (h' : Hom (lin W') (lin W)) (lG2 : SP.Lands (lin W') X sd.pQ (compH (lin W') (lin n) X f (compH (lin W') (lin W) (lin n) G' h'))) {
    module VF = CDeltaFact[a] ;
    module P1 = Pt[W, G', J, lG] ;
    module P2 = Pt[W', compH (lin W') (lin W) (lin n) G' h', compH (lin W') (lin W) Iv J h', lG2] ;
    module H1 = EZm.HPr[n, W, G', J] ;
    module H2 = EZm.HPr[n, W', compH (lin W') (lin W) (lin n) G' h', compH (lin W') (lin W) Iv J h'] ;

    hv (v : Nat) : Nat = VF.valT W' W h' v ;

    -- the shuffle factor of the restricted point is that of the point, restricted
    pe (v : Nat) (hv' : IsT (leb v W')) : Id Nat (H2.hN v) (H1.hN (hv v)) =
      transH (H2.hN-eq v hv')
        (transH (EZm.hf-cong (H2.F.gn v) (H2.F.jn v) (H1.F.gn (hv v)) (H1.F.jn (hv v))
                   (CDPrism[a].valT-comp W' W n G' h' v hv') (CDPrism[a].valT-comp W' W (suc zero) J h' v hv'))
                (symH (H1.hN-eq (hv v) (VF.valT-range W' W h' v)))) ;

    module K = EZm.EZK[W, W', suc n, suc n, H1.F.h, H2.F.h, h',
      \ v v' a0 b q -> transH (symH (pe v a0)) (transH q (pe v' b)),
      \ v v' a0 b q -> transH (pe v a0) (transH q (symH (pe v' b)))] ;

    -- the side value at the restricted stage is the side value restricted
    zEq : Id (TD.EI (lin W')) P2.zz (TD.E.act (lin W') (lin W) h' P1.zz) =
      calc (TD.EI (lin W')) {
          P2.zz
        =< apH (\ v -> (KD.lineL (lin W') v).2.1.1 (lin W') (idH (lin W')) (compH (lin W') (lin W) Iv J h'))
             (symH (transH (sd.pnat (lin W') (lin W) h' P1.fG lG (SP.lands-comp (lin W') (lin W) X sd.pQ P1.fG h' lG))
                     (KD.PT.pv-hom X w sd (lin W') (compH (lin W') (lin W) X P1.fG h') P2.fG
                        (comp-assoc (lin W') (lin W) (lin n) X f G' h') (SP.lands-comp (lin W') (lin W) X sd.pQ P1.fG h' lG) lG2))) >
          (KD.lineL (lin W') (KD.TS.E.act (lin W') (lin W) h' P1.u)).2.1.1 (lin W') (idH (lin W')) (compH (lin W') (lin W) Iv J h')
        =< apH (\ M -> M.2.1.1 (lin W') (idH (lin W')) (compH (lin W') (lin W) Iv J h')) (KD.lineL-act (lin W') (lin W) h' P1.u) >
          (KD.lineL (lin W) P1.u).2.1.1 (lin W') (compH (lin W') (lin W') (lin W) h' (idH (lin W'))) (compH (lin W') (lin W) Iv J h')
        =< apH (\ q -> (KD.lineL (lin W) P1.u).2.1.1 (lin W') q (compH (lin W') (lin W) Iv J h'))
             (transH (comp-idr (lin W') (lin W) h') (symH (comp-idl (lin W') (lin W) h'))) >
          (KD.lineL (lin W) P1.u).2.1.1 (lin W') (compH (lin W') (lin W) (lin W) (idH (lin W)) h') (compH (lin W') (lin W) Iv J h')
        =< symH ((KD.lineL (lin W) P1.u).2.1.2 (lin W') (lin W) h' (idH (lin W)) J) >
          TD.E.act (lin W') (lin W) h' P1.zz } ;

    module I = VV.Ind[W, W', P1.zz, P1.Z.r, P2.Z.r, P1.Z.sgm, P1.Z.sec, P2.Z.sgm, P2.Z.sec, h', K.muStrict, K.muEq, P1.fc] ;

    res : Id (TA.EI (lin W')) (TA.E.act (lin W') (lin W) h' P1.val) P2.val =
      transH I.res (apH (\ q -> VV.rdS W' P2.Z.r q P2.Z.sgm P2.Z.sec) (symH zEq)) ;
    opaque pe ; opaque zEq ; opaque res ;
  } ;
} ;

------------------------------------------------------------------------
-- along a strict h : [m] -> [n], the value at f of (h G'' , J) is the value
-- at f h of (G'' , J): the two factorisations meet through k = id

module SV (G : PP.PCtx) (A : PP.PTy[G]) (e : El Iv) (X : Ob)
  (w : VA[G, A, e].KD.TV.EI X) (sd : VA[G, A, e].KD.PT.Side[X, w])
  (m n : Nat) (f : Hom (lin n) X) (h : Hom (lin m) (lin n)) (hs : Strict (lin m) (lin n) h)
  (W : Nat) (G'' : Hom (lin W) (lin m)) (J : Hom (lin W) Iv)
  (l1 : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin n) X f (compH (lin W) (lin m) (lin n) h G'')))
  (l2 : SP.Lands (lin W) X sd.pQ (compH (lin W) (lin m) X (compH (lin m) (lin n) X f h) G'')) {
  module VV = VA[G, A, e] ;
  module VF = CDeltaFact[a] ;
  module B1 = Pb[G, A, e, X, w, sd, n, f] ;
  module B2 = Pb[G, A, e, X, w, sd, m, compH (lin m) (lin n) X f h] ;
  module P1 = B1.Pt[W, compH (lin W) (lin m) (lin n) h G'', J, l1] ;
  module P2 = B2.Pt[W, G'', J, l2] ;
  module H1 = EZm.HPr[n, W, compH (lin W) (lin m) (lin n) h G'', J] ;
  module H2 = EZm.HPr[m, W, G'', J] ;

  vid (v : Nat) (hv : IsT (leb v W)) : Id Nat (VF.valT W W (idH (lin W)) v) v =
    apH {Tree} {Nat} vnum (symH (transH (symH (app-idH1 (lin W) (leaf v, hv))) (VF.valT-tree W W (idH (lin W)) v hv))) ;

  g1 (v : Nat) (hv : IsT (leb v W)) : Id Nat (H1.F.gn v) (VF.valT m n h (H2.F.gn v)) =
    CDPrism[a].valT-comp W m n h G'' v hv ;

  rel1 (v v' : Nat) (hv : IsT (leb v W)) (hv' : IsT (leb v' W)) (q : Id Nat (H2.hN v) (H2.hN v'))
    : Id Nat (H1.hN (VF.valT W W (idH (lin W)) v)) (H1.hN (VF.valT W W (idH (lin W)) v')) =
    transH (apH {Nat} {Nat} H1.hN (vid v hv)) (transH (H1.hN-eq v hv)
      (transH (H1.of-pair v v'
                 (transH (g1 v hv) (transH (apH {Nat} {Nat} (VF.valT m n h) pr.1) (symH (g1 v' hv')))) pr.2)
        (transH (symH (H1.hN-eq v' hv')) (symH (apH {Nat} {Nat} H1.hN (vid v' hv'))))))
   where { pr : Id Nat (H2.F.gn v) (H2.F.gn v') * Id Nat (H2.F.jn v) (H2.F.jn v') =
             H2.to-pair v v' (transH (symH (H2.hN-eq v hv)) (transH q (H2.hN-eq v' hv'))) ; } ;

  rel2 (v v' : Nat) (hv : IsT (leb v W)) (hv' : IsT (leb v' W))
    (q : Id Nat (H1.hN (VF.valT W W (idH (lin W)) v)) (H1.hN (VF.valT W W (idH (lin W)) v')))
    : Id Nat (H2.hN v) (H2.hN v') =
    transH (H2.hN-eq v hv)
      (transH (H2.of-pair v v'
                 (EZm.VH.valT-inj m n h hs (H2.F.gn v) (H2.F.gn v') (VF.valT-range W m G'' v) (VF.valT-range W m G'' v')
                    (transH (symH (g1 v hv)) (transH pr.1 (g1 v' hv')))) pr.2)
        (symH (H2.hN-eq v' hv')))
   where { pr : Id Nat (H1.F.gn v) (H1.F.gn v') * Id Nat (H1.F.jn v) (H1.F.jn v') =
             H1.to-pair v v' (transH (symH (H1.hN-eq v hv))
               (transH (apH {Nat} {Nat} H1.hN (symH (vid v hv))) (transH q
                 (transH (apH {Nat} {Nat} H1.hN (vid v' hv')) (H1.hN-eq v' hv'))))) ; } ;

  module K = EZm.EZK[W, W, suc n, suc m, H1.F.h, H2.F.h, idH (lin W), rel1, rel2] ;

  module I = VV.Ind[W, W, P1.zz, P1.Z.r, P2.Z.r, P1.Z.sgm, P1.Z.sec, P2.Z.sgm, P2.Z.sec, idH (lin W), K.muStrict, K.muEq, P1.fc] ;

  zEq : Id (VV.TD.EI (lin W)) P1.zz P2.zz =
    apH (\ v -> (VV.KD.lineL (lin W) v).2.1.1 (lin W) (idH (lin W)) J)
      (VV.KD.PT.pv-hom X w sd (lin W) _ _ (symH (comp-assoc (lin W) (lin m) (lin n) X f h G'')) l1 l2) ;

  res : Id (VV.TA.EI (lin W)) P1.val P2.val =
    transH (symH (VV.TA.PE.actId (lin W) (idH (lin W)) (refl (idH (lin W))) P1.val))
      (transH I.res
        (apH (\ z -> VV.rdS W P2.Z.r z P2.Z.sgm P2.Z.sec)
           (transH (VV.TD.PE.actId (lin W) (idH (lin W)) (refl (idH (lin W))) P1.zz) zEq))) ;
  opaque rel1 ; opaque rel2 ; opaque zEq ; opaque res ;
} ;
