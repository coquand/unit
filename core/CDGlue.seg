-- CDGlue.seg (L8, Delta): seg/model DGlue.seg ported (module names only).  Was: partial lines on decidable sieves of the prism y[N] * Delta[1]
-- (generalised points (f , j) : [W] -> [N] * [1], no product in Delta), and
-- their extension across ONE simplex sigma = (s1 , s2) : [m+1] -> [N] * [1]
-- by one horn filling (the step of the shuffle chains P_k of
-- FillBase / FillCell, in line form).
--
--   DPS.PrS N          a decidable sieve of the prism: a Boolean predicate on
--                  (W , f , j), closed under precomposition
--   PLine          a natural family of elements of A over the line gt of G,
--                  defined on a prism sieve S
--   Glue           the horn of sigma is S along sigma (cap1 / cap2); the
--                  horn data is the partial line along sigma, the horn
--                  operation fills it, and the partial line extends to
--                  S u sigma (values on sigma: the filler read along the
--                  unique factorisation through sigma).
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CDeltaNat[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module DS = DBm.DS ;
module DHm = CDeltaCl[a] ;
module DPS = CDPrS[a] ;
module DHn = CDHornFib[a, lz] ;

------------------------------------------------------------------------
-- partial lines in A over a line gt of G

module PL (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (N : Nat)
  (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
  (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
        -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g))) {
  open DB.GPre[lz].TyL[G, A] ;
  module GL = DB.GPre[lz].PshL[G] ;

  record PLine (S : DPS.PrS N) {
    v (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) : EI W ;
    vpt (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j)) : Id (Pt W) (v W f j s).1 (gt W f j) ;
    vnat (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S.1 W f j))
      (s' : IsT (S.1 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
      : Id (EI V) (E.act V W g (v W f j s)) (v V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s') ;
  } ;

  -- the value does not depend on the presentation of the point
  v-hom (S : DPS.PrS N) (L : PLine[S]) (W : Nat) (f f' : Hom (lin W) (lin N)) (j j' : Hom (lin W) Iv)
    (ef : Id (Hom (lin W) (lin N)) f f') (ej : Id (Hom (lin W) Iv) j j') (s : IsT (S.1 W f j)) (s' : IsT (S.1 W f' j'))
    : Id (EI W) (L.v W f j s) (L.v W f' j' s') =
    idJ (Hom (lin W) (lin N)) f (\ f2 E2 -> (s2 : IsT (S.1 W f2 j')) -> Id (EI W) (L.v W f j s) (L.v W f2 j' s2))
      (\ s2 -> idJ (Hom (lin W) Iv) j (\ j2 E2 -> (s3 : IsT (S.1 W f j2)) -> Id (EI W) (L.v W f j s) (L.v W f j2 s3))
                 (\ s3 -> apH (L.v W f j) (isProp-IsT' (S.1 W f j) s s3)) j' ej s2)
      f' ef s' ;

  ----------------------------------------------------------------------
  -- one simplex sigma = (s1 , s2) : [m+1] -> [N] * [1], its points (the
  -- predicate Mem, closed), and the unique factorisation through it

  module Glue (S : DPS.PrS N) (L : PLine[S]) (m k : Nat) (hk : IsT (leb k (suc m)))
    (s1 : Hom (lin (suc m)) (lin N)) (s2 : Hom (lin (suc m)) Iv)
    (Mem : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> Bool) (Mc : DPS.PrClos N Mem)
    (fac : (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> IsT (Mem W f j) -> Hom (lin W) (lin (suc m)))
    (fac1 : (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (Mem W f j))
            -> Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc m)) (lin N) s1 (fac W f j u)) f)
    (fac2 : (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (u : IsT (Mem W f j))
            -> Id (Hom (lin W) Iv) (compH (lin W) (lin (suc m)) Iv s2 (fac W f j u)) j)
    (uniq : (W : Nat) (h h' : Hom (lin W) (lin (suc m)))
            -> Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc m)) (lin N) s1 h) (compH (lin W) (lin (suc m)) (lin N) s1 h')
            -> Id (Hom (lin W) Iv) (compH (lin W) (lin (suc m)) Iv s2 h) (compH (lin W) (lin (suc m)) Iv s2 h')
            -> Id (Hom (lin W) (lin (suc m))) h h')
    -- the horn of sigma is exactly S along sigma
    (cap1 : (W : Nat) (g : Hom (lin W) (lin (suc m)))
            -> IsT (S.1 W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g))
            -> DS.Lands W (suc m) (DHm.hornS m k) g)
    (cap2 : (W : Nat) (g : Hom (lin W) (lin (suc m))) -> DS.Lands W (suc m) (DHm.hornS m k) g
            -> IsT (S.1 W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g)))
    (hf : DHn.DH[G, A].isFib) {
    module DHA = DHn.DH[G, A] ;

    rho : Pt (suc m) = gt (suc m) s1 s2 ;

    -- the horn data: the partial line along sigma
    hv (W : Nat) (g : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) g) : EI W =
      L.v W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) (cap2 W g i) ;

    hpt (W : Nat) (g : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) g)
      : Id (Pt W) (hv W g i).1 (G.act W (suc m) g rho) =
      transH (L.vpt W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) (cap2 W g i))
             (symH (gn W (suc m) g s1 s2)) ;

    -- s1 (g g') = (s1 g) g', and likewise s2
    cA1 (W' W : Nat) (g' : Hom (lin W') (lin W)) (g : Hom (lin W) (lin (suc m)))
      : Id (Hom (lin W') (lin N)) (compH (lin W') (lin W) (lin N) (compH (lin W) (lin (suc m)) (lin N) s1 g) g')
                                  (compH (lin W') (lin (suc m)) (lin N) s1 (compH (lin W') (lin W) (lin (suc m)) g g')) =
      comp-assoc (lin W') (lin W) (lin (suc m)) (lin N) s1 g g' ;
    cA2 (W' W : Nat) (g' : Hom (lin W') (lin W)) (g : Hom (lin W) (lin (suc m)))
      : Id (Hom (lin W') Iv) (compH (lin W') (lin W) Iv (compH (lin W) (lin (suc m)) Iv s2 g) g')
                             (compH (lin W') (lin (suc m)) Iv s2 (compH (lin W') (lin W) (lin (suc m)) g g')) =
      comp-assoc (lin W') (lin W) (lin (suc m)) Iv s2 g g' ;

    hn (W' W : Nat) (g' : Hom (lin W') (lin W)) (g : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) g)
      (i' : DS.Lands W' (suc m) (DHm.hornS m k) (compH (lin W') (lin W) (lin (suc m)) g g'))
      : Id (EI W') (E.act W' W g' (hv W g i)) (hv W' (compH (lin W') (lin W) (lin (suc m)) g g') i') =
      transH (L.vnat W' W g' (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) (cap2 W g i)
                (S.2 W' W g' (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) (cap2 W g i)))
             (v-hom S L W' _ _ _ _ (cA1 W' W g' g) (cA2 W' W g' g) _ (cap2 W' (compH (lin W') (lin W) (lin (suc m)) g g') i')) ;

    hdata : DHA.HornData m k rho = (hv, (hpt, hn)) ;

    fill : DHA.Ext m k rho hdata = hf m k hk rho hdata ;

    aE : EI (suc m) = (rho, fill.1) ;

    -- the filler agrees with the partial line on the horn
    aE-horn (W : Nat) (g : Hom (lin W) (lin (suc m))) (i : DS.Lands W (suc m) (DHm.hornS m k) g)
      : Id (EI W) (E.act W (suc m) g aE) (hv W g i) = fill.2 W g i ;

    ----------------------------------------------------------------------
    -- the extended partial line on S u sigma

    S' : DPS.PrS N = DPS.unionPr N S Mem Mc ;

    vB (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) : (b : Bool) -> Id Bool (S.1 W f j) b -> IsT (or b (Mem W f j)) -> EI W = split {
      true -> \ e s -> L.v W f j (substH (\ c -> IsT c) (symH e) (refl true)) ;
      false -> \ e s -> E.act W (suc m) (fac W f j s) aE } ;

    v' (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S'.1 W f j)) : EI W = vB W f j (S.1 W f j) (refl (S.1 W f j)) s ;

    vS' (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT (S.1 W f j))
      : (b : Bool) (e : Id Bool (S.1 W f j) b) (s : IsT (or b (Mem W f j))) -> Id (EI W) (vB W f j b e s) (L.v W f j t) = split {
      true -> \ e s -> apH (L.v W f j) (isProp-IsT' (S.1 W f j) (substH (\ c -> IsT c) (symH e) (refl true)) t) ;
      false -> \ e s -> absurd _ (false-true (transH (symH e) t)) } ;

    vM' (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (nt : Id Bool (S.1 W f j) false) (u : IsT (Mem W f j))
      : (b : Bool) (e : Id Bool (S.1 W f j) b) (s : IsT (or b (Mem W f j))) -> Id (EI W) (vB W f j b e s) (E.act W (suc m) (fac W f j u) aE) = split {
      true -> \ e s -> absurd _ (false-true (transH (symH nt) e)) ;
      false -> \ e s -> apH (\ z -> E.act W (suc m) (fac W f j z) aE) (isProp-IsT' (Mem W f j) s u) } ;

    vS (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S'.1 W f j)) (t : IsT (S.1 W f j))
      : Id (EI W) (v' W f j s) (L.v W f j t) = vS' W f j t (S.1 W f j) (refl (S.1 W f j)) s ;

    vM (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S'.1 W f j)) (nt : Id Bool (S.1 W f j) false) (u : IsT (Mem W f j))
      : Id (EI W) (v' W f j s) (E.act W (suc m) (fac W f j u) aE) = vM' W f j nt u (S.1 W f j) (refl (S.1 W f j)) s ;

    opaque v' ;

    -- a point of S' outside S is a point of sigma
    memOf (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S'.1 W f j)) (nt : Id Bool (S.1 W f j) false)
      : IsT (Mem W f j) =
      orE (IsT (Mem W f j)) (S.1 W f j) (Mem W f j) s (\ t -> absurd _ (false-true (transH (symH nt) t))) (\ u -> u) ;

    -- the filler read along g lies over gt (s1 g , s2 g)
    aEpt (W : Nat) (h : Hom (lin W) (lin (suc m))) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
      (e1 : Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc m)) (lin N) s1 h) f) (e2 : Id (Hom (lin W) Iv) (compH (lin W) (lin (suc m)) Iv s2 h) j)
      : Id (Pt W) (E.act W (suc m) h aE).1 (gt W f j) =
      transH (gn W (suc m) h s1 s2) (transH (apH (\ z -> gt W z (compH (lin W) (lin (suc m)) Iv s2 h)) e1) (apH (gt W f) e2)) ;

    vpt' (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S'.1 W f j)) : Id (Pt W) (v' W f j s).1 (gt W f j) =
      bcaseL (Id (Pt W) (v' W f j s).1 (gt W f j)) (S.1 W f j)
        (\ t -> transH (apH (\ z -> z.1) (vS W f j s t)) (L.vpt W f j t))
        (\ nt -> transH (apH (\ z -> z.1) (vM W f j s nt (memOf W f j s nt)))
                    (aEpt W (fac W f j (memOf W f j s nt)) f j (fac1 W f j (memOf W f j s nt)) (fac2 W f j (memOf W f j s nt)))) ;

    -- (f , j) = sigma h gives (f g , j g) = sigma (h g)
    fg1 (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (h : Hom (lin W) (lin (suc m)))
      (e1 : Id (Hom (lin W) (lin N)) (compH (lin W) (lin (suc m)) (lin N) s1 h) f)
      : Id (Hom (lin V) (lin N)) (compH (lin V) (lin (suc m)) (lin N) s1 (compH (lin V) (lin W) (lin (suc m)) h g)) (compH (lin V) (lin W) (lin N) f g) =
      transH (symH (cA1 V W g h)) (apH (\ z -> compH (lin V) (lin W) (lin N) z g) e1) ;
    fg2 (V W : Nat) (g : Hom (lin V) (lin W)) (j : Hom (lin W) Iv) (h : Hom (lin W) (lin (suc m)))
      (e2 : Id (Hom (lin W) Iv) (compH (lin W) (lin (suc m)) Iv s2 h) j)
      : Id (Hom (lin V) Iv) (compH (lin V) (lin (suc m)) Iv s2 (compH (lin V) (lin W) (lin (suc m)) h g)) (compH (lin V) (lin W) Iv j g) =
      transH (symH (cA2 V W g h)) (apH (\ z -> compH (lin V) (lin W) Iv z g) e2) ;

    -- the filler read along h, at a point of S, is the partial line
    aE-S (V : Nat) (h : Hom (lin V) (lin (suc m))) (f : Hom (lin V) (lin N)) (j : Hom (lin V) Iv)
      (e1 : Id (Hom (lin V) (lin N)) (compH (lin V) (lin (suc m)) (lin N) s1 h) f) (e2 : Id (Hom (lin V) Iv) (compH (lin V) (lin (suc m)) Iv s2 h) j)
      (t : IsT (S.1 V f j)) : Id (EI V) (E.act V (suc m) h aE) (L.v V f j t) =
      -- hv V h c is L.v at the point cap2 V h c: given, not found by unfolding hv
      transH (aE-horn V h c) (v-hom S L V _ f _ j e1 e2 (cap2 V h c) t)
     where { c : DS.Lands V (suc m) (DHm.hornS m k) h =
               cap1 V h (substH (\ z -> IsT (S.1 V z (compH (lin V) (lin (suc m)) Iv s2 h))) (symH e1)
                           (substH (\ z -> IsT (S.1 V f z)) (symH e2) t)) ; } ;

    vnat' (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (s : IsT (S'.1 W f j))
      (s' : IsT (S'.1 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
      : Id (EI V) (E.act V W g (v' W f j s)) (v' V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s') =
      bcaseL (Id (EI V) (E.act V W g (v' W f j s)) (v' V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s')) (S.1 W f j)
        (\ t -> transH (apH (E.act V W g) (vS W f j s t))
                  (transH (L.vnat V W g f j t (S.2 V W g f j t))
                          (symH (vS V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' (S.2 V W g f j t)))))
        (\ nt -> transH (apH (E.act V W g) (vM W f j s nt (memOf W f j s nt)))
          (transH (PE.actC V W (suc m) (fac W f j (memOf W f j s nt)) g aE)
            (bcaseL (Id (EI V) (E.act V (suc m) (compH (lin V) (lin W) (lin (suc m)) (fac W f j (memOf W f j s nt)) g) aE)
                              (v' V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s'))
               (S.1 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g))
               (\ t' -> transH (aE-S V (compH (lin V) (lin W) (lin (suc m)) (fac W f j (memOf W f j s nt)) g)
                                    (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)
                                    (fg1 V W g f (fac W f j (memOf W f j s nt)) (fac1 W f j (memOf W f j s nt)))
                                    (fg2 V W g j (fac W f j (memOf W f j s nt)) (fac2 W f j (memOf W f j s nt))) t')
                           (symH (vS V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' t')))
               (\ nt' -> transH
                   (apH (\ z -> E.act V (suc m) z aE)
                      (uniq V (compH (lin V) (lin W) (lin (suc m)) (fac W f j (memOf W f j s nt)) g)
                         (fac V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)
                            (memOf V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' nt'))
                         (transH (fg1 V W g f (fac W f j (memOf W f j s nt)) (fac1 W f j (memOf W f j s nt)))
                                 (symH (fac1 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)
                                          (memOf V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' nt'))))
                         (transH (fg2 V W g j (fac W f j (memOf W f j s nt)) (fac2 W f j (memOf W f j s nt)))
                                 (symH (fac2 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)
                                          (memOf V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' nt')))))) 
                   (symH (vM V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' nt'
                            (memOf V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g) s' nt')))))) ) ;

    L' : PLine[S'] = new PLine[S', v', vpt', vnat'] ;

    -- on sigma, the extension is the filler read along g
    v-sigma (W : Nat) (g : Hom (lin W) (lin (suc m)))
      (s : IsT (S'.1 W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g)))
      : Id (EI W) (v' W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) s) (E.act W (suc m) g aE) =
      bcaseL (Id (EI W) (v' W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) s) (E.act W (suc m) g aE))
        (S.1 W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g))
        (\ t -> transH (vS W _ _ s t) (symH (aE-S W g _ _ (refl (compH (lin W) (lin (suc m)) (lin N) s1 g)) (refl (compH (lin W) (lin (suc m)) Iv s2 g)) t)))
        (\ nt -> transH (vM W _ _ s nt (memOf W _ _ s nt))
                   (apH (\ z -> E.act W (suc m) z aE)
                      (uniq W (fac W (compH (lin W) (lin (suc m)) (lin N) s1 g) (compH (lin W) (lin (suc m)) Iv s2 g) (memOf W _ _ s nt)) g
                         (fac1 W _ _ (memOf W _ _ s nt)) (fac2 W _ _ (memOf W _ _ s nt))))) ;
  } ;
} ;
