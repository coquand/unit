-- CLocDUniv.seg (L9): Theorem DA on the universal family, and its
-- naturality (localisation.tex, Theorem DA, the universal route as for Ext:
-- model.tex §6.2).
--
--   DElFib      El over the universe is fibrant (CPosEl4.elFib), so D El
--               is, by Theorem DA (CLocComp.OfFib)
--   DF[D, c]    for a code map c : D -> U, the fibration of D(El along c):
--               that of D El moved along the cart D(c^* El) -> D El over c
--               (CLocDCart.DK of CSmall.SmallFib.C)
--   Nat         for t : D' -> D, DF at c t is DF at c moved along the cart
--               D(El along c t) -> D(El along c) over t: the carts compose
--               (CCartLaws2.CC, CG); no filler is moved

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module E4 = CPosEl4[a] ;
module PB = E1.PB ;
module UU = E1.UU ;
module PP = PB.GPre[a].PS ;

module DU = CLocD[a, a+].DT[UU.UCtx, UU.EGen] ;

DElFib : PB.CLine[a+].Lines[UU.UCtx, DU.DA].Fib = CLocComp[a, a+].OfFib[UU.UCtx, UU.EGen, E4.elFib].fib ;

module DF (D : PP.PCtx) (c : PB.CSmall.XSub[D, UU.UCtx]) {
  module X = PB.CSmall.SmallFib[UU.UCtx, UU.El, D, c] ;
  module K = CLocDCart[a, a+, a].DK[D, X.ElTy, UU.UCtx, UU.EGen, c.nt, c.nt-nat, X.ta, \ W w -> refl (c.nt W w.1), X.tanat, X.tainj,
    \ Y x u -> u, \ Y x u -> refl (c.nt Y x, u)] ;
  module DA = CLocD[a, a].DT[D, X.ElTy] ;

  fib : PB.CLine[a].Lines[D, DA.DA].Fib = K.C.moveFib DElFib ;
} ;

------------------------------------------------------------------------
-- naturality

module Nat (D' D : PP.PCtx) (t : PP.PSub[D', D]) (c : PB.CSmall.XSub[D, UU.UCtx]) {
  c' : PB.CSmall.XSub[D', UU.UCtx] = PB.CSmall.xoS D' D UU.UCtx c t ;
  module F = DF[D, c] ;
  module F' = DF[D', c'] ;
  module TX = PB.GPre[a].TyL[D, F.X.ElTy] ;
  module TX' = PB.GPre[a].TyL[D', F'.X.ElTy] ;

  -- the cart El along c t -> El along c over t
  tt (W : Ob) (w : TX'.EI W) : TX.EI W = (t.nt W w.1, w.2) ;

  ttnat (V W : Ob) (g : Hom V W) (w : TX'.EI W) : Id (TX.EI V) (TX.E.act V W g (tt W w)) (tt V (TX'.E.act V W g w)) =
    F.X.tainj V (TX.E.act V W g (tt W w)) (tt V (TX'.E.act V W g w)) (symH (t.nt-nat V W g w.1))
      (transH (symH (F.X.tanat V W g (tt W w))) (F'.X.tanat V W g w)) ;

  ttinj (W : Ob) (v v' : TX'.EI W) (P : Id (W0.Ix (D'.ob W)) v.1 v'.1) (Q : Id (TX.EI W) (tt W v) (tt W v')) : Id (TX'.EI W) v v' =
    F'.X.tainj W v v' P (apH (F.X.ta W) Q) ;

  opaque ttnat ; opaque ttinj ;

  module KT = CLocDCart[a, a, a].DK[D', F'.X.ElTy, D, F.X.ElTy, t.nt, t.nt-nat, tt, \ W w -> refl (t.nt W w.1), ttnat, ttinj,
    \ Y x u -> u, \ Y x u -> refl (t.nt Y x, u)] ;

  -- moving along KT then along F.K is moving along the composite
  module CC = PB.CCartLaws2[a, a, a+].CC[D', F'.DA.DA, D, F.DA.DA, UU.UCtx, DU.DA,
    t.nt, t.nt-nat, KT.tD, KT.tDpt, KT.tDnat, KT.tDinj, KT.bkD, KT.bkDta,
    c.nt, c.nt-nat, F.K.tD, F.K.tDpt, F.K.tDnat, F.K.tDinj, F.K.bkD, F.K.bkDta] ;

  -- the composite has the totals of F'.K
  Pta (W : Ob) (v : PB.GPre[a].TyL[D', F'.DA.DA].EI W) : Id (PB.GPre[a+].TyL[UU.UCtx, DU.DA].EI W) (CC.ta W v) (F'.K.tD W v) =
    F'.K.extG W (CC.ta W v) (F'.K.tD W v) (refl (c.nt W (t.nt W v.1)))
      (\ n f -> transH (F.K.tD-rd W (KT.tD W v) n f)
         (transH (apH (F.X.ta (lin n)) (KT.tD-rd W v n f)) (symH (F'.K.tD-rd W v n f)))) ;

  opaque Pta ;

  module CG = PB.CCartLaws2[a, a, a+].CG[D', F'.DA.DA, UU.UCtx, DU.DA,
    CC.s, CC.s-nat, CC.ta, CC.tapt, CC.tanat, CC.tainj, CC.bk, CC.bkta,
    c'.nt, c'.nt-nat, F'.K.tD, F'.K.tDpt, F'.K.tDnat, F'.K.tDinj, F'.K.bkD, F'.K.bkDta,
    \ W x -> refl (c.nt W (t.nt W x)), Pta] ;

  nat : Id (PB.CLine[a].Lines[D', F'.DA.DA].Fib) (KT.C.moveFib F.fib) F'.fib =
    transH (CC.compFib DElFib) (CG.congFib DElFib) ;
} ;
