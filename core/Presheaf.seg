-- Presheaf.seg: MODEL/Lv/Presheaf.agda (and MODEL/Presheaf.agda, its
-- level-0 instance).  The CwF of V-valued presheaves over a V-small
-- category C (objects and hom-sets are index types of iterative sets).
--
--   contexts      presheaves  G : C^op -> V
--   substitutions natural transformations
--   types over G  presheaves on the category of elements of G, whose
--                 action  tact J I f x y e  takes the equation
--                 e : act f x = y  as an argument
--   elements      sections
--
-- Taking the equation as an argument makes substitution in types
-- transport-free; the action does not depend on e, since the fibres of G
-- are sets (tact-irr).
--
-- Two levels: the category lives at k, the presheaves at l >= k (Agda: a
-- level-0 category, presheaves at level l).  The records PCtx, PSub, PTy,
-- PEl are segments used as types; mkctx/mksub/mkty/mkel are  new .
-- Agda's  abstract  block is the  opaque  list at the end of each part.

level k l ;
constraint k <= l ;
open Base ;
open Prelude[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;

module Psh (C : SmallCat[k].SmallCat) {
  open C ;
  open SmallCat[k].Objs[C.obV] ;
  open SmallCat[k].Homs[C.obV, C.homV] ;

  ----------------------------------------------------------------------
  -- The four sorts

  record PCtx {
    ob     : Ob -> W.V ;
    act (J I : Ob) (f : Hom J I) (x : W.Ix (ob I)) : W.Ix (ob J) ;
    act-id (I : Ob) (x : W.Ix (ob I)) : Id (W.Ix (ob I)) (act I I (idC I) x) x ;
    act-o (K J I : Ob) (f : Hom J I) (g : Hom K J) (x : W.Ix (ob I))
      : Id (W.Ix (ob K)) (act K I (oC K J I f g) x) (act K J g (act J I f x)) ;
  } ;

  -- the types of the fields, named so that they can be reused
  NT (D G : PCtx) : U l = (I : Ob) -> W.Ix (D.ob I) -> W.Ix (G.ob I) ;

  NatLaw (D G : PCtx) (n : NT D G) : U l =
    (J I : Ob) (f : Hom J I) (x : W.Ix (D.ob I))
    -> Id (W.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x)) ;

  TOb (G : PCtx) : U l+ = (I : Ob) -> W.Ix (G.ob I) -> W.V ;

  TactTy (G : PCtx) (o : TOb G) : U l =
    (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
    -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y) ;

  IdLaw (G : PCtx) (o : TOb G) (h : TactTy G o) : U l =
    (I : Ob) (x : W.Ix (G.ob I)) (e : Id (W.Ix (G.ob I)) (G.act I I (idC I) x) x) (a : W.Ix (o I x))
    -> Id (W.Ix (o I x)) (h I I (idC I) x x e a) a ;

  OLaw (G : PCtx) (o : TOb G) (h : TactTy G o) : U l =
    (K J I : Ob) (f : Hom J I) (g : Hom K J)
    (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
    (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
    (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
    -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a)) ;

  EOb (G : PCtx) (o : TOb G) : U l = (I : Ob) (x : W.Ix (G.ob I)) -> W.Ix (o I x) ;

  ElNat (G : PCtx) (o : TOb G) (h : TactTy G o) (n : EOb G o) : U l =
    (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
    (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y) ;

  record PSub (D G : PCtx) {
    nt (I : Ob) (x : W.Ix (D.ob I)) : W.Ix (G.ob I) ;
    nt-nat (J I : Ob) (f : Hom J I) (x : W.Ix (D.ob I))
      : Id (W.Ix (G.ob J)) (nt J (D.act J I f x)) (G.act J I f (nt I x)) ;
  } ;

  record PTy (G : PCtx) {
    tob (I : Ob) (x : W.Ix (G.ob I)) : W.V ;
    tact (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) (a : W.Ix (tob I x)) : W.Ix (tob J y) ;
    tact-id (I : Ob) (x : W.Ix (G.ob I)) (e : Id (W.Ix (G.ob I)) (G.act I I (idC I) x) x)
      (a : W.Ix (tob I x)) : Id (W.Ix (tob I x)) (tact I I (idC I) x x e a) a ;
    tact-o (K J I : Ob) (f : Hom J I) (g : Hom K J)
      (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (tob I x))
      : Id (W.Ix (tob K z)) (tact K I (oC K J I f g) x z e3 a) (tact K J g y z e2 (tact J I f x y e1 a)) ;
  } ;

  -- the one constructor of types given by their fields (records are compared by name)
  mkTy (G : PCtx) (o : TOb G) (h : TactTy G o) (hi : IdLaw G o h) (ho : OLaw G o h) : PTy[G] = new PTy[G, o, h, hi, ho] ;

  -- eta for presheaf types, in Id (no eta by conversion for records)
  pty-eta (G : PCtx) : (A : PTy[G]) -> Id (PTy[G]) A (mkTy G A.tob A.tact A.tact-id A.tact-o) =
    split { PTy o h hi ho -> refl (mkTy G o h hi ho) } ;

  record PEl (G : PCtx) (A : PTy[G]) {
    eob (I : Ob) (x : W.Ix (G.ob I)) : W.Ix (A.tob I x) ;
    enat (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y)
      : Id (W.Ix (A.tob J y)) (A.tact J I f x y e (eob I x)) (eob J y) ;
  } ;

  ----------------------------------------------------------------------
  -- The laws are propositions, the actions form sets

  natLaw-prop (D G : PCtx) (n : NT D G) : isProp (NatLaw D G n) =
    isProp-Pi Ob (\ J -> (I : Ob) (f : Hom J I) (x : W.Ix (D.ob I))
                         -> Id (W.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ J ->
    isProp-Pi Ob (\ I -> (f : Hom J I) (x : W.Ix (D.ob I))
                         -> Id (W.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ I ->
    isProp-Pi (Hom J I) (\ f -> (x : W.Ix (D.ob I))
                         -> Id (W.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ f ->
    isProp-Pi (W.Ix (D.ob I)) (\ x -> Id (W.Ix (G.ob J)) (n J (D.act J I f x)) (G.act J I f (n I x))) (\ x ->
      W.isSetIx (G.ob J) (n J (D.act J I f x)) (G.act J I f (n I x)))))) ;

  idLaw-prop (G : PCtx) (o : TOb G) (h : TactTy G o) : isProp (IdLaw G o h) =
    isProp-Pi Ob (\ I -> (x : W.Ix (G.ob I)) (e : Id (W.Ix (G.ob I)) (G.act I I (idC I) x) x) (a : W.Ix (o I x))
                         -> Id (W.Ix (o I x)) (h I I (idC I) x x e a) a) (\ I ->
    isProp-Pi (W.Ix (G.ob I)) (\ x -> (e : Id (W.Ix (G.ob I)) (G.act I I (idC I) x) x) (a : W.Ix (o I x))
                         -> Id (W.Ix (o I x)) (h I I (idC I) x x e a) a) (\ x ->
    isProp-Pi (Id (W.Ix (G.ob I)) (G.act I I (idC I) x) x) (\ e -> (a : W.Ix (o I x))
                         -> Id (W.Ix (o I x)) (h I I (idC I) x x e a) a) (\ e ->
    isProp-Pi (W.Ix (o I x)) (\ a -> Id (W.Ix (o I x)) (h I I (idC I) x x e a) a) (\ a ->
      W.isSetIx (o I x) (h I I (idC I) x x e a) a)))) ;

  oLaw-prop (G : PCtx) (o : TOb G) (h : TactTy G o) : isProp (OLaw G o h) =
    isProp-Pi Ob (\ K -> (J I : Ob) (f : Hom J I) (g : Hom K J)
      (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ K ->
    isProp-Pi Ob (\ J -> (I : Ob) (f : Hom J I) (g : Hom K J)
      (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ J ->
    isProp-Pi Ob (\ I -> (f : Hom J I) (g : Hom K J)
      (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ I ->
    isProp-Pi (Hom J I) (\ f -> (g : Hom K J)
      (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ f ->
    isProp-Pi (Hom K J) (\ g ->
      (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ g ->
    isProp-Pi (W.Ix (G.ob I)) (\ x -> (y : W.Ix (G.ob J)) (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ x ->
    isProp-Pi (W.Ix (G.ob J)) (\ y -> (z : W.Ix (G.ob K))
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ y ->
    isProp-Pi (W.Ix (G.ob K)) (\ z ->
      (e1 : Id (W.Ix (G.ob J)) (G.act J I f x) y) (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ z ->
    isProp-Pi (Id (W.Ix (G.ob J)) (G.act J I f x) y) (\ e1 ->
      (e2 : Id (W.Ix (G.ob K)) (G.act K J g y) z)
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ e1 ->
    isProp-Pi (Id (W.Ix (G.ob K)) (G.act K J g y) z) (\ e2 ->
      (e3 : Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ e2 ->
    isProp-Pi (Id (W.Ix (G.ob K)) (G.act K I (oC K J I f g) x) z) (\ e3 -> (a : W.Ix (o I x))
      -> Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ e3 ->
    isProp-Pi (W.Ix (o I x)) (\ a ->
      Id (W.Ix (o K z)) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a))) (\ a ->
      W.isSetIx (o K z) (h K I (oC K J I f g) x z e3 a) (h K J g y z e2 (h J I f x y e1 a)))))))))))))) ;

  elNat-prop (G : PCtx) (o : TOb G) (h : TactTy G o) (n : EOb G o) : isProp (ElNat G o h n) =
    isProp-Pi Ob (\ J -> (I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y)) (\ J ->
    isProp-Pi Ob (\ I -> (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y)) (\ I ->
    isProp-Pi (Hom J I) (\ f -> (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y)) (\ f ->
    isProp-Pi (W.Ix (G.ob I)) (\ x -> (y : W.Ix (G.ob J))
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y)) (\ x ->
    isProp-Pi (W.Ix (G.ob J)) (\ y ->
      (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y)) (\ y ->
    isProp-Pi (Id (W.Ix (G.ob J)) (G.act J I f x) y) (\ e -> Id (W.Ix (o J y)) (h J I f x y e (n I x)) (n J y)) (\ e ->
      W.isSetIx (o J y) (h J I f x y e (n I x)) (n J y))))))) ;

  isSet-tob (G : PCtx) : isSet (TOb G) =
    isSet-Pi Ob (\ I -> W.Ix (G.ob I) -> W.V) (\ I -> isSet-Pi (W.Ix (G.ob I)) (\ x -> W.V) (\ x -> W.isSetV)) ;

  isSet-tact (G : PCtx) (o : TOb G) : isSet (TactTy G o) =
    isSet-Pi Ob (\ J -> (I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (\ J ->
    isSet-Pi Ob (\ I -> (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (\ I ->
    isSet-Pi (Hom J I) (\ f -> (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (\ f ->
    isSet-Pi (W.Ix (G.ob I)) (\ x -> (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (\ x ->
    isSet-Pi (W.Ix (G.ob J)) (\ y ->
      Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (\ y ->
    isSet-Pi (Id (W.Ix (G.ob J)) (G.act J I f x) y) (\ e -> W.Ix (o I x) -> W.Ix (o J y)) (\ e ->
    isSet-Pi (W.Ix (o I x)) (\ a -> W.Ix (o J y)) (\ a -> W.isSetIx (o J y)))))))) ;

  ----------------------------------------------------------------------
  -- Equality of substitutions, types and elements

  -- the action of a type does not depend on the equation
  tact-irr (G : PCtx) (A : PTy[G]) (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
    (e e' : Id (W.Ix (G.ob J)) (G.act J I f x) y) (a : W.Ix (A.tob I x))
    : Id (W.Ix (A.tob J y)) (A.tact J I f x y e a) (A.tact J I f x y e' a) =
    ap (Id (W.Ix (G.ob J)) (G.act J I f x) y) (W.Ix (A.tob J y)) (\ e'' -> A.tact J I f x y e'' a) e e'
       (W.isSetIx (G.ob J) (G.act J I f x) y e e') ;

  nt-funext (D G : PCtx) (n n' : NT D G)
    (h : (I : Ob) (x : W.Ix (D.ob I)) -> Id (W.Ix (G.ob I)) (n I x) (n' I x)) : Id (NT D G) n n' =
    funext Ob (\ I -> W.Ix (D.ob I) -> W.Ix (G.ob I)) n n' (\ I ->
      funext (W.Ix (D.ob I)) (\ x -> W.Ix (G.ob I)) (n I) (n' I) (h I)) ;

  -- one occurrence of new PSub (elements are compared by occurrence)
  mkPSub (D G : PCtx) (n : NT D G) (nn : NatLaw D G n) : PSub[D, G] = new PSub[D, G, n, nn] ;

  psub-eta (D G : PCtx) : (s : PSub[D, G]) -> Id (PSub[D, G]) s (mkPSub D G s.nt s.nt-nat) =
    split { PSub n k -> refl (mkPSub D G n k) } ;

  sub-ext (D G : PCtx) (s t : PSub[D, G])
    (h : (I : Ob) (x : W.Ix (D.ob I)) -> Id (W.Ix (G.ob I)) (s.nt I x) (t.nt I x))
    : Id (PSub[D, G]) s t =
    trans (PSub[D, G]) s (mkPSub D G s.nt s.nt-nat) t (psub-eta D G s)
     (trans (PSub[D, G]) (mkPSub D G s.nt s.nt-nat) (mkPSub D G t.nt t.nt-nat) t
      (idJ (NT D G) s.nt (\ n1 P1 -> (k1 : NatLaw D G n1)
                                  -> Id (PSub[D, G]) (mkPSub D G s.nt s.nt-nat) (mkPSub D G n1 k1))
        (\ k1 -> ap (NatLaw D G s.nt) (PSub[D, G]) (\ k2 -> mkPSub D G s.nt k2) s.nt-nat k1
                    (natLaw-prop D G s.nt s.nt-nat k1))
        t.nt (nt-funext D G s.nt t.nt h) t.nt-nat)
      (sym (PSub[D, G]) t (mkPSub D G t.nt t.nt-nat) (psub-eta D G t))) ;

  PtEq (G : PCtx) (o : TOb G) (h h' : TactTy G o) : U l =
    (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
    (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) (a : W.Ix (o I x))
    -> Id (W.Ix (o J y)) (h J I f x y e a) (h' J I f x y e a) ;

  tact-funext (G : PCtx) (o : TOb G) (h h' : TactTy G o) (pt : PtEq G o h h') : Id (TactTy G o) h h' =
    funext Ob (\ J -> (I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) h h' (\ J ->
    funext Ob (\ I -> (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (h J) (h' J) (\ I ->
    funext (Hom J I) (\ f -> (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (h J I) (h' J I) (\ f ->
    funext (W.Ix (G.ob I)) (\ x -> (y : W.Ix (G.ob J))
      -> Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (h J I f) (h' J I f) (\ x ->
    funext (W.Ix (G.ob J)) (\ y ->
      Id (W.Ix (G.ob J)) (G.act J I f x) y -> W.Ix (o I x) -> W.Ix (o J y)) (h J I f x) (h' J I f x) (\ y ->
    funext (Id (W.Ix (G.ob J)) (G.act J I f x) y) (\ e -> W.Ix (o I x) -> W.Ix (o J y))
      (h J I f x y) (h' J I f x y) (\ e ->
    funext (W.Ix (o I x)) (\ a -> W.Ix (o J y)) (h J I f x y e) (h' J I f x y e) (pt J I f x y e))))))) ;

  ty-ext (G : PCtx) (o : TOb G) (h h' : TactTy G o)
    (hi : IdLaw G o h) (hi' : IdLaw G o h') (ho : OLaw G o h) (ho' : OLaw G o h')
    (pt : PtEq G o h h')
    : Id (PTy[G]) ((mkTy G o h hi ho)) ((mkTy G o h' hi' ho')) =
    idJ (TactTy G o) h
      (\ k1 P1 -> (hi1 : IdLaw G o k1) (ho1 : OLaw G o k1)
                  -> Id (PTy[G]) ((mkTy G o h hi ho)) ((mkTy G o k1 hi1 ho1)))
      (\ hi1 ho1 -> trans (PTy[G]) ((mkTy G o h hi ho)) ((mkTy G o h hi1 ho))
                                   ((mkTy G o h hi1 ho1))
         (ap (IdLaw G o h) (PTy[G]) (\ u -> (mkTy G o h u ho)) hi hi1 (idLaw-prop G o h hi hi1))
         (ap (OLaw G o h) (PTy[G]) (\ u -> (mkTy G o h hi1 u)) ho ho1 (oLaw-prop G o h ho ho1)))
      h' (tact-funext G o h h' pt) hi' ho' ;

  -- the same, for two given types, along a path between their objects parts
  ty-ext2 (G : PCtx) (A B : PTy[G]) (P : Id (TOb G) A.tob B.tob)
    (pt : (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
          (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) (a : W.Ix (A.tob I x))
          -> Id (W.Ix (B.tob J y))
                (subst (TOb G) (\ o -> W.Ix (o J y)) A.tob B.tob P (A.tact J I f x y e a))
                (B.tact J I f x y e (subst (TOb G) (\ o -> W.Ix (o I x)) A.tob B.tob P a)))
    : Id (PTy[G]) A B =
    trans (PTy[G]) A (mkTy G A.tob A.tact A.tact-id A.tact-o) B (pty-eta G A)
     (trans (PTy[G]) (mkTy G A.tob A.tact A.tact-id A.tact-o) (mkTy G B.tob B.tact B.tact-id B.tact-o) B
    (idJ (TOb G) A.tob
      (\ o1 P1 -> (h1 : TactTy G o1) (hi1 : IdLaw G o1 h1) (ho1 : OLaw G o1 h1)
         -> ((J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
             (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) (a : W.Ix (A.tob I x))
             -> Id (W.Ix (o1 J y))
                   (subst (TOb G) (\ o -> W.Ix (o J y)) A.tob o1 P1 (A.tact J I f x y e a))
                   (h1 J I f x y e (subst (TOb G) (\ o -> W.Ix (o I x)) A.tob o1 P1 a)))
         -> Id (PTy[G]) (mkTy G A.tob A.tact A.tact-id A.tact-o) ((mkTy G o1 h1 hi1 ho1)))
      (\ h1 hi1 ho1 pt1 -> ty-ext G A.tob A.tact h1 A.tact-id hi1 A.tact-o ho1 pt1)
      B.tob P B.tact B.tact-id B.tact-o pt)
      (sym (PTy[G]) B (mkTy G B.tob B.tact B.tact-id B.tact-o) (pty-eta G B))) ;

  -- one occurrence of new PEl
  mkPEl (G : PCtx) (A : PTy[G]) (n : EOb G A.tob) (nn : ElNat G A.tob A.tact n) : PEl[G, A] = new PEl[G, A, n, nn] ;

  pel-eta (G : PCtx) (A : PTy[G]) : (s : PEl[G, A]) -> Id (PEl[G, A]) s (mkPEl G A s.eob s.enat) =
    split { PEl n k -> refl (mkPEl G A n k) } ;

  el-ext (G : PCtx) (A : PTy[G]) (s t : PEl[G, A])
    (h : (I : Ob) (x : W.Ix (G.ob I)) -> Id (W.Ix (A.tob I x)) (s.eob I x) (t.eob I x))
    : Id (PEl[G, A]) s t =
    trans (PEl[G, A]) s (mkPEl G A s.eob s.enat) t (pel-eta G A s)
     (trans (PEl[G, A]) (mkPEl G A s.eob s.enat) (mkPEl G A t.eob t.enat) t
    (idJ (EOb G A.tob) s.eob
      (\ n1 P1 -> (k1 : ElNat G A.tob A.tact n1)
                  -> Id (PEl[G, A]) (mkPEl G A s.eob s.enat) (mkPEl G A n1 k1))
      (\ k1 -> ap (ElNat G A.tob A.tact s.eob) (PEl[G, A]) (\ k2 -> mkPEl G A s.eob k2) s.enat k1
                  (elNat-prop G A.tob A.tact s.eob s.enat k1))
      t.eob
      (funext Ob (\ I -> (x : W.Ix (G.ob I)) -> W.Ix (A.tob I x)) s.eob t.eob (\ I ->
         funext (W.Ix (G.ob I)) (\ x -> W.Ix (A.tob I x)) (s.eob I) (t.eob I) (h I)))
      t.enat)
      (sym (PEl[G, A]) t (mkPEl G A t.eob t.enat) (pel-eta G A t))) ;

  -- transport along an equation of types with the same objects part does
  -- not change anything read off through the objects part
  tob-same (G : PCtx) (F : PTy[G] -> U l+) (H : TOb G -> U l+)
    (pi : (B : PTy[G]) -> F B -> H B.tob)
    (B B' : PTy[G]) (P : Id (PTy[G]) B B') (same : Id (TOb G) B.tob B'.tob) (u : F B)
    : Id (H B'.tob) (pi B' (subst (PTy[G]) F B B' P u)) (subst (TOb G) H B.tob B'.tob same (pi B u)) =
    trans (H B'.tob) (pi B' (subst (PTy[G]) F B B' P u))
      (subst (TOb G) H B.tob B'.tob (ap (PTy[G]) (TOb G) (\ X -> X.tob) B B' P) (pi B u))
      (subst (TOb G) H B.tob B'.tob same (pi B u))
      (subst-proj (PTy[G]) (TOb G) (\ X -> X.tob) F H pi B B' P u)
      (ap (Id (TOb G) B.tob B'.tob) (H B'.tob) (\ q -> subst (TOb G) H B.tob B'.tob q (pi B u))
          (ap (PTy[G]) (TOb G) (\ X -> X.tob) B B' P) same
          (isSet-tob G B.tob B'.tob (ap (PTy[G]) (TOb G) (\ X -> X.tob) B B' P) same)) ;

  ----------------------------------------------------------------------
  -- Sets

  isSet-PSub (D G : PCtx) : isSet (PSub[D, G]) =
    isSet-retract (PSub[D, G]) ((n : NT D G) * NatLaw D G n)
      (\ s -> (s.nt, s.nt-nat)) (\ w -> new PSub[D, G, w.1, w.2])
      (\ s -> sym (PSub[D, G]) s (mkPSub D G s.nt s.nt-nat) (psub-eta D G s))
      (isSet-Sigma (NT D G) (\ n -> NatLaw D G n)
         (isSet-Pi Ob (\ I -> W.Ix (D.ob I) -> W.Ix (G.ob I)) (\ I ->
            isSet-Pi (W.Ix (D.ob I)) (\ x -> W.Ix (G.ob I)) (\ x -> W.isSetIx (G.ob I))))
         (\ n -> prop-to-set (NatLaw D G n) (natLaw-prop D G n))) ;

  isSet-PTy (G : PCtx) : isSet (PTy[G]) =
    isSet-retract (PTy[G]) ((o : TOb G) * (h : TactTy G o) * IdLaw G o h * OLaw G o h)
      (\ A -> (A.tob, A.tact, A.tact-id, A.tact-o))
      (\ w -> (mkTy G w.1 w.2.1 w.2.2.1 w.2.2.2))
      (\ A -> sym (PTy[G]) A (mkTy G A.tob A.tact A.tact-id A.tact-o) (pty-eta G A))
      (isSet-Sigma (TOb G) (\ o -> (h : TactTy G o) * IdLaw G o h * OLaw G o h) (isSet-tob G) (\ o ->
       isSet-Sigma (TactTy G o) (\ h -> IdLaw G o h * OLaw G o h) (isSet-tact G o) (\ h ->
       prop-to-set (IdLaw G o h * OLaw G o h)
         (isProp-Sigma (IdLaw G o h) (\ u -> OLaw G o h) (idLaw-prop G o h) (\ u -> oLaw-prop G o h))))) ;

  isSet-PEl (G : PCtx) (A : PTy[G]) : isSet (PEl[G, A]) =
    isSet-retract (PEl[G, A]) ((n : EOb G A.tob) * ElNat G A.tob A.tact n)
      (\ s -> (s.eob, s.enat)) (\ w -> new PEl[G, A, w.1, w.2])
      (\ s -> sym (PEl[G, A]) s (mkPEl G A s.eob s.enat) (pel-eta G A s))
      (isSet-Sigma (EOb G A.tob) (\ n -> ElNat G A.tob A.tact n)
         (isSet-Pi Ob (\ I -> (x : W.Ix (G.ob I)) -> W.Ix (A.tob I x)) (\ I ->
            isSet-Pi (W.Ix (G.ob I)) (\ x -> W.Ix (A.tob I x)) (\ x -> W.isSetIx (A.tob I x))))
         (\ n -> prop-to-set (ElNat G A.tob A.tact n) (elNat-prop G A.tob A.tact n))) ;

  opaque tact-irr ; opaque sub-ext ; opaque ty-ext ; opaque ty-ext2 ; opaque el-ext ;
  opaque tob-same ; opaque isSet-PSub ; opaque isSet-PTy ; opaque isSet-PEl ;

  ----------------------------------------------------------------------
  -- Operations

  idS (G : PCtx) : PSub[G, G] = new PSub[G, G, \ I x -> x, \ J I f x -> refl (G.act J I f x)] ;

  oS (T D G : PCtx) (s : PSub[D, G]) (t : PSub[T, D]) : PSub[T, G] =
    new PSub[T, G, \ I x -> s.nt I (t.nt I x),
      \ J I f x -> trans (W.Ix (G.ob J)) (s.nt J (t.nt J (T.act J I f x))) (s.nt J (D.act J I f (t.nt I x)))
                     (G.act J I f (s.nt I (t.nt I x)))
                     (ap (W.Ix (D.ob J)) (W.Ix (G.ob J)) (s.nt J) (t.nt J (T.act J I f x))
                         (D.act J I f (t.nt I x)) (t.nt-nat J I f x))
                     (s.nt-nat J I f (t.nt I x))] ;

  nilP : PCtx = new PCtx[\ I -> W.unitV, \ J I f x -> x, \ I x -> refl x, \ K J I f g x -> refl x] ;

  -- the map to the terminal context (one occurrence of new)
  epsP (G : PCtx) : PSub[G, nilP] = new PSub[G, nilP, \ I x -> tt, \ J I f x -> refl tt] ;

  -- the equation along which subTy acts
  ntEq (D G : PCtx) (s : PSub[D, G]) (J I : Ob) (f : Hom J I) (x : W.Ix (D.ob I)) (y : W.Ix (D.ob J))
    (e : Id (W.Ix (D.ob J)) (D.act J I f x) y) : Id (W.Ix (G.ob J)) (G.act J I f (s.nt I x)) (s.nt J y) =
    trans (W.Ix (G.ob J)) (G.act J I f (s.nt I x)) (s.nt J (D.act J I f x)) (s.nt J y)
      (sym (W.Ix (G.ob J)) (s.nt J (D.act J I f x)) (G.act J I f (s.nt I x)) (s.nt-nat J I f x))
      (ap (W.Ix (D.ob J)) (W.Ix (G.ob J)) (s.nt J) (D.act J I f x) y e) ;

  subTy (D G : PCtx) (A : PTy[G]) (s : PSub[D, G]) : PTy[D] =
    (mkTy D (\ I x -> A.tob I (s.nt I x)) (\ J I f x y e a -> A.tact J I f (s.nt I x) (s.nt J y) (ntEq D G s J I f x y e) a) (\ I x e a -> A.tact-id I (s.nt I x) (ntEq D G s I I (idC I) x x e) a) (\ K J I f g x y z e1 e2 e3 a ->
         A.tact-o K J I f g (s.nt I x) (s.nt J y) (s.nt K z)
           (ntEq D G s J I f x y e1) (ntEq D G s K J g y z e2) (ntEq D G s K I (oC K J I f g) x z e3) a)) ;

  subEl (D G : PCtx) (A : PTy[G]) (a : PEl[G, A]) (s : PSub[D, G]) : PEl[D, subTy D G A s] =
    new PEl[D, subTy D G A s, \ I x -> a.eob I (s.nt I x),
      \ J I f x y e -> a.enat J I f (s.nt I x) (s.nt J y) (ntEq D G s J I f x y e)] ;

  -- the fibres of the extended context
  SigT (G : PCtx) (A : PTy[G]) (J : Ob) : U l = (y : W.Ix (G.ob J)) * W.Ix (A.tob J y) ;

  -- (act f x , tact f refl a) = (y , tact f e a)
  pair-act (G : PCtx) (A : PTy[G]) (J I : Ob) (f : Hom J I) (x : W.Ix (G.ob I)) (y : W.Ix (G.ob J))
    (e : Id (W.Ix (G.ob J)) (G.act J I f x) y) (a : W.Ix (A.tob I x))
    : Id (SigT G A J) (G.act J I f x, A.tact J I f x (G.act J I f x) (refl (G.act J I f x)) a)
                      (y, A.tact J I f x y e a) =
    idJ (W.Ix (G.ob J)) (G.act J I f x)
      (\ y1 e1 -> Id (SigT G A J) (G.act J I f x, A.tact J I f x (G.act J I f x) (refl (G.act J I f x)) a)
                                  (y1, A.tact J I f x y1 e1 a))
      (refl (G.act J I f x, A.tact J I f x (G.act J I f x) (refl (G.act J I f x)) a)) y e ;

  extP (G : PCtx) (A : PTy[G]) : PCtx =
    new PCtx[\ I -> W.SigV (G.ob I) (\ x -> A.tob I x),
      \ J I f w -> (G.act J I f w.1, A.tact J I f w.1 (G.act J I f w.1) (refl (G.act J I f w.1)) w.2),
      \ I w -> trans (SigT G A I)
                 (G.act I I (idC I) w.1, A.tact I I (idC I) w.1 (G.act I I (idC I) w.1) (refl (G.act I I (idC I) w.1)) w.2)
                 (w.1, A.tact I I (idC I) w.1 w.1 (G.act-id I w.1) w.2)
                 (w.1, w.2)
                 (pair-act G A I I (idC I) w.1 w.1 (G.act-id I w.1) w.2)
                 (ap (W.Ix (A.tob I w.1)) (SigT G A I) (\ u -> (w.1, u))
                     (A.tact I I (idC I) w.1 w.1 (G.act-id I w.1) w.2) w.2
                     (A.tact-id I w.1 (G.act-id I w.1) w.2)),
      \ K J I f g w -> trans (SigT G A K)
                 (G.act K I (oC K J I f g) w.1,
                  A.tact K I (oC K J I f g) w.1 (G.act K I (oC K J I f g) w.1) (refl (G.act K I (oC K J I f g) w.1)) w.2)
                 (G.act K J g (G.act J I f w.1),
                  A.tact K I (oC K J I f g) w.1 (G.act K J g (G.act J I f w.1)) (G.act-o K J I f g w.1) w.2)
                 (G.act K J g (G.act J I f w.1),
                  A.tact K J g (G.act J I f w.1) (G.act K J g (G.act J I f w.1)) (refl (G.act K J g (G.act J I f w.1)))
                    (A.tact J I f w.1 (G.act J I f w.1) (refl (G.act J I f w.1)) w.2))
                 (pair-act G A K I (oC K J I f g) w.1 (G.act K J g (G.act J I f w.1)) (G.act-o K J I f g w.1) w.2)
                 (ap (W.Ix (A.tob K (G.act K J g (G.act J I f w.1)))) (SigT G A K)
                     (\ u -> (G.act K J g (G.act J I f w.1), u))
                     (A.tact K I (oC K J I f g) w.1 (G.act K J g (G.act J I f w.1)) (G.act-o K J I f g w.1) w.2)
                     (A.tact K J g (G.act J I f w.1) (G.act K J g (G.act J I f w.1)) (refl (G.act K J g (G.act J I f w.1)))
                        (A.tact J I f w.1 (G.act J I f w.1) (refl (G.act J I f w.1)) w.2))
                     (A.tact-o K J I f g w.1 (G.act J I f w.1) (G.act K J g (G.act J I f w.1))
                        (refl (G.act J I f w.1)) (refl (G.act K J g (G.act J I f w.1))) (G.act-o K J I f g w.1) w.2))] ;

  pP (G : PCtx) (A : PTy[G]) : PSub[extP G A, G] =
    new PSub[extP G A, G, \ I w -> w.1, \ J I f w -> refl (G.act J I f w.1)] ;

  q-nat (G : PCtx) (A : PTy[G]) (J I : Ob) (f : Hom J I) (w : W.Ix ((extP G A).ob I))
    (w' : W.Ix ((extP G A).ob J)) (e : Id (W.Ix ((extP G A).ob J)) ((extP G A).act J I f w) w')
    : Id (W.Ix (A.tob J w'.1)) ((subTy (extP G A) G A (pP G A)).tact J I f w w' e w.2) w'.2 =
    idJ (W.Ix ((extP G A).ob J)) ((extP G A).act J I f w)
      (\ w1 e1 -> Id (W.Ix (A.tob J w1.1)) ((subTy (extP G A) G A (pP G A)).tact J I f w w1 e1 w.2) w1.2)
      (refl (A.tact J I f w.1 (G.act J I f w.1) (refl (G.act J I f w.1)) w.2)) w' e ;

  qP (G : PCtx) (A : PTy[G]) : PEl[extP G A, subTy (extP G A) G A (pP G A)] =
    new PEl[extP G A, subTy (extP G A) G A (pP G A), \ I w -> w.2, q-nat G A] ;

  liftP (D G : PCtx) (A : PTy[G]) (s : PSub[D, G]) : PSub[extP D (subTy D G A s), extP G A] =
    new PSub[extP D (subTy D G A s), extP G A, \ I w -> (s.nt I w.1, w.2),
      \ J I f w -> sym (SigT G A J)
         (G.act J I f (s.nt I w.1), A.tact J I f (s.nt I w.1) (G.act J I f (s.nt I w.1)) (refl (G.act J I f (s.nt I w.1))) w.2)
         (s.nt J (D.act J I f w.1),
          A.tact J I f (s.nt I w.1) (s.nt J (D.act J I f w.1))
            (sym (W.Ix (G.ob J)) (s.nt J (D.act J I f w.1)) (G.act J I f (s.nt I w.1)) (s.nt-nat J I f w.1)) w.2)
         (pair-act G A J I f (s.nt I w.1) (s.nt J (D.act J I f w.1))
            (sym (W.Ix (G.ob J)) (s.nt J (D.act J I f w.1)) (G.act J I f (s.nt I w.1)) (s.nt-nat J I f w.1)) w.2)] ;

  secP (G : PCtx) (A : PTy[G]) (a : PEl[G, A]) : PSub[G, extP G A] =
    new PSub[G, extP G A, \ I x -> (x, a.eob I x),
      \ J I f x -> ap (W.Ix (A.tob J (G.act J I f x))) (SigT G A J) (\ u -> (G.act J I f x, u))
                      (a.eob J (G.act J I f x))
                      (A.tact J I f x (G.act J I f x) (refl (G.act J I f x)) (a.eob I x))
                      (sym (W.Ix (A.tob J (G.act J I f x)))
                           (A.tact J I f x (G.act J I f x) (refl (G.act J I f x)) (a.eob I x))
                           (a.eob J (G.act J I f x))
                           (a.enat J I f x (G.act J I f x) (refl (G.act J I f x))))] ;

  ----------------------------------------------------------------------
  -- Reading elements and substitutions out of the extended context

  elObs (G : PCtx) (o : TOb G) : U l = (I : Ob) (x : W.Ix (G.ob I)) -> W.Ix (o I x) ;

  el-subst (G : PCtx) (B B' : PTy[G]) (P : Id (PTy[G]) B B') (same : Id (TOb G) B.tob B'.tob)
    (u : PEl[G, B]) (t : PEl[G, B'])
    (h : (I : Ob) (x : W.Ix (G.ob I))
         -> Id (W.Ix (B'.tob I x)) (subst (TOb G) (\ o -> elObs G o) B.tob B'.tob same u.eob I x) (t.eob I x))
    : Id (PEl[G, B']) (subst (PTy[G]) (\ X -> PEl[G, X]) B B' P u) t =
    el-ext G B' (subst (PTy[G]) (\ X -> PEl[G, X]) B B' P u) t (\ I x ->
      trans (W.Ix (B'.tob I x)) (U0.eob I x) (subst (TOb G) (\ o -> elObs G o) B.tob B'.tob same u.eob I x) (t.eob I x)
        (happly (W.Ix (G.ob I)) (\ x1 -> W.Ix (B'.tob I x1)) (U0.eob I)
                (subst (TOb G) (\ o -> elObs G o) B.tob B'.tob same u.eob I)
           (happly Ob (\ I1 -> (x1 : W.Ix (G.ob I1)) -> W.Ix (B'.tob I1 x1)) U0.eob
                   (subst (TOb G) (\ o -> elObs G o) B.tob B'.tob same u.eob)
              (tob-same G (\ X -> PEl[G, X]) (\ o -> elObs G o) (\ X v -> v.eob) B B' P same u) I) x)
        (h I x))
   where { U0 : PEl[G, B'] = subst (PTy[G]) (\ X -> PEl[G, X]) B B' P u ; } ;

  subObs (G X : PCtx) (o : TOb G) : U l = (I : Ob) -> ((x : W.Ix (G.ob I)) * W.Ix (o I x)) -> W.Ix (X.ob I) ;

  sub-subst (G X : PCtx) (B B' : PTy[G]) (P : Id (PTy[G]) B B') (same : Id (TOb G) B.tob B'.tob)
    (u : PSub[extP G B, X]) (t : PSub[extP G B', X])
    (h : (I : Ob) (w : (x : W.Ix (G.ob I)) * W.Ix (B'.tob I x))
         -> Id (W.Ix (X.ob I)) (subst (TOb G) (\ o -> subObs G X o) B.tob B'.tob same u.nt I w) (t.nt I w))
    : Id (PSub[extP G B', X]) (subst (PTy[G]) (\ B2 -> PSub[extP G B2, X]) B B' P u) t =
    sub-ext (extP G B') X (subst (PTy[G]) (\ B2 -> PSub[extP G B2, X]) B B' P u) t (\ I w ->
      trans (W.Ix (X.ob I)) (U0.nt I w) (subst (TOb G) (\ o -> subObs G X o) B.tob B'.tob same u.nt I w) (t.nt I w)
        (happly ((x : W.Ix (G.ob I)) * W.Ix (B'.tob I x)) (\ w1 -> W.Ix (X.ob I)) (U0.nt I)
                (subst (TOb G) (\ o -> subObs G X o) B.tob B'.tob same u.nt I)
           (happly Ob (\ I1 -> ((x : W.Ix (G.ob I1)) * W.Ix (B'.tob I1 x)) -> W.Ix (X.ob I1)) U0.nt
                   (subst (TOb G) (\ o -> subObs G X o) B.tob B'.tob same u.nt)
              (tob-same G (\ B2 -> PSub[extP G B2, X]) (\ o -> subObs G X o) (\ B2 v -> v.nt) B B' P same u) I) w)
        (h I w))
   where { U0 : PSub[extP G B', X] = subst (PTy[G]) (\ B2 -> PSub[extP G B2, X]) B B' P u ; } ;

  opaque el-subst ; opaque sub-subst ;

  ----------------------------------------------------------------------
  -- The equations, as lemmas with explicit types

  subTy-id (G : PCtx) (A : PTy[G]) : Id (PTy[G]) (subTy G G A (idS G)) A =
    ty-ext2 G (subTy G G A (idS G)) A (refl A.tob)
      (\ J I f x y e a -> tact-irr G A J I f x y (ntEq G G (idS G) J I f x y e) e a) ;

  subTy-o (T D G : PCtx) (A : PTy[G]) (s : PSub[D, G]) (s' : PSub[T, D])
    : Id (PTy[T]) (subTy T G A (oS T D G s s')) (subTy T D (subTy D G A s) s') =
    ty-ext2 T (subTy T G A (oS T D G s s')) (subTy T D (subTy D G A s) s')
      (refl (\ I x -> A.tob I (s.nt I (s'.nt I x))))
      (\ J I f x y e a -> tact-irr G A J I f (s.nt I (s'.nt I x)) (s.nt J (s'.nt J y))
                            (ntEq T G (oS T D G s s') J I f x y e)
                            (ntEq D G s J I f (s'.nt I x) (s'.nt J y) (ntEq T D s' J I f x y e)) a) ;

  subEl-id (G : PCtx) (A : PTy[G]) (a : PEl[G, A])
    : Id (PEl[G, A]) (subst (PTy[G]) (\ X -> PEl[G, X]) (subTy G G A (idS G)) A (subTy-id G A)
                            (subEl G G A a (idS G))) a =
    el-subst G (subTy G G A (idS G)) A (subTy-id G A) (refl A.tob) (subEl G G A a (idS G)) a
      (\ I x -> refl (a.eob I x)) ;

  subEl-o (T D G : PCtx) (A : PTy[G]) (a : PEl[G, A]) (s : PSub[D, G]) (s' : PSub[T, D])
    : Id (PEl[T, subTy T D (subTy D G A s) s'])
         (subst (PTy[T]) (\ X -> PEl[T, X]) (subTy T G A (oS T D G s s')) (subTy T D (subTy D G A s) s')
                (subTy-o T D G A s s') (subEl T G A a (oS T D G s s')))
         (subEl T D (subTy D G A s) (subEl D G A a s) s') =
    el-subst T (subTy T G A (oS T D G s s')) (subTy T D (subTy D G A s) s') (subTy-o T D G A s s')
      (refl (\ I x -> A.tob I (s.nt I (s'.nt I x))))
      (subEl T G A a (oS T D G s s')) (subEl T D (subTy D G A s) (subEl D G A a s) s')
      (\ I x -> refl (a.eob I (s.nt I (s'.nt I x)))) ;

  liftP-id (G : PCtx) (A : PTy[G])
    : Id (PSub[extP G A, extP G A])
         (subst (PTy[G]) (\ B -> PSub[extP G B, extP G A]) (subTy G G A (idS G)) A (subTy-id G A)
                (liftP G G A (idS G)))
         (idS (extP G A)) =
    sub-subst G (extP G A) (subTy G G A (idS G)) A (subTy-id G A) (refl A.tob)
      (liftP G G A (idS G)) (idS (extP G A)) (\ I w -> refl w) ;

  liftP-o (T D G : PCtx) (A : PTy[G]) (s : PSub[D, G]) (s' : PSub[T, D])
    : Id (PSub[extP T (subTy T D (subTy D G A s) s'), extP G A])
         (subst (PTy[T]) (\ B -> PSub[extP T B, extP G A])
                (subTy T G A (oS T D G s s')) (subTy T D (subTy D G A s) s')
                (subTy-o T D G A s s') (liftP T G A (oS T D G s s')))
         (oS (extP T (subTy T D (subTy D G A s) s')) (extP D (subTy D G A s)) (extP G A)
             (liftP D G A s) (liftP T D (subTy D G A s) s')) =
    sub-subst T (extP G A) (subTy T G A (oS T D G s s')) (subTy T D (subTy D G A s) s')
      (subTy-o T D G A s s') (refl (\ I x -> A.tob I (s.nt I (s'.nt I x))))
      (liftP T G A (oS T D G s s'))
      (oS (extP T (subTy T D (subTy D G A s) s')) (extP D (subTy D G A s)) (extP G A)
          (liftP D G A s) (liftP T D (subTy D G A s) s'))
      (\ I w -> refl (s.nt I (s'.nt I w.1), w.2)) ;

  pP-liftP (D G : PCtx) (A : PTy[G]) (s : PSub[D, G])
    : Id (PSub[extP D (subTy D G A s), G])
         (oS (extP D (subTy D G A s)) (extP G A) G (pP G A) (liftP D G A s))
         (oS (extP D (subTy D G A s)) D G s (pP D (subTy D G A s))) =
    sub-ext (extP D (subTy D G A s)) G
      (oS (extP D (subTy D G A s)) (extP G A) G (pP G A) (liftP D G A s))
      (oS (extP D (subTy D G A s)) D G s (pP D (subTy D G A s)))
      (\ I w -> refl (s.nt I w.1)) ;

  pP-secP (G : PCtx) (A : PTy[G]) (a : PEl[G, A])
    : Id (PSub[G, G]) (oS G (extP G A) G (pP G A) (secP G A a)) (idS G) =
    sub-ext G G (oS G (extP G A) G (pP G A) (secP G A a)) (idS G) (\ I x -> refl x) ;

  secP-o (D G : PCtx) (A : PTy[G]) (a : PEl[G, A]) (s : PSub[D, G])
    : Id (PSub[D, extP G A]) (oS D G (extP G A) (secP G A a) s)
         (oS D (extP D (subTy D G A s)) (extP G A) (liftP D G A s)
             (secP D (subTy D G A s) (subEl D G A a s))) =
    sub-ext D (extP G A) (oS D G (extP G A) (secP G A a) s)
      (oS D (extP D (subTy D G A s)) (extP G A) (liftP D G A s) (secP D (subTy D G A s) (subEl D G A a s)))
      (\ I x -> refl (s.nt I x, a.eob I (s.nt I x))) ;

  opaque subTy-id ; opaque subTy-o ; opaque subEl-id ; opaque subEl-o ;
  opaque liftP-id ; opaque liftP-o ; opaque pP-liftP ; opaque pP-secP ; opaque secP-o ;

  EP (D G : PCtx) (A : PTy[G]) (s : PSub[D, G]) : PCtx = extP D (subTy D G A s) ;

  -- the type equations of CwF (p-lift-T, p-sec-T at B = A), spelled out
  p-lift-P (D G : PCtx) (A : PTy[G]) (s : PSub[D, G])
    : Id (PTy[EP D G A s]) (subTy (EP D G A s) (extP G A) (subTy (extP G A) G A (pP G A)) (liftP D G A s))
                  (subTy (EP D G A s) D (subTy D G A s) (pP D (subTy D G A s))) =
    trans (PTy[E])
      (subTy E (extP G A) (subTy (extP G A) G A (pP G A)) (liftP D G A s))
      (subTy E G A (oS E (extP G A) G (pP G A) (liftP D G A s)))
      (subTy E D (subTy D G A s) (pP D (subTy D G A s)))
      (sym (PTy[E]) (subTy E G A (oS E (extP G A) G (pP G A) (liftP D G A s)))
                    (subTy E (extP G A) (subTy (extP G A) G A (pP G A)) (liftP D G A s))
                    (subTy-o E (extP G A) G A (pP G A) (liftP D G A s)))
      (trans (PTy[E])
         (subTy E G A (oS E (extP G A) G (pP G A) (liftP D G A s)))
         (subTy E G A (oS E D G s (pP D (subTy D G A s))))
         (subTy E D (subTy D G A s) (pP D (subTy D G A s)))
         (ap (PSub[E, G]) (PTy[E]) (\ s' -> subTy E G A s')
             (oS E (extP G A) G (pP G A) (liftP D G A s)) (oS E D G s (pP D (subTy D G A s)))
             (pP-liftP D G A s))
         (subTy-o E D G A s (pP D (subTy D G A s))))
   where { E : PCtx = extP D (subTy D G A s) ; } ;

  p-sec-P (G : PCtx) (A : PTy[G]) (a : PEl[G, A])
    : Id (PTy[G]) (subTy G (extP G A) (subTy (extP G A) G A (pP G A)) (secP G A a)) A =
    trans (PTy[G])
      (subTy G (extP G A) (subTy (extP G A) G A (pP G A)) (secP G A a))
      (subTy G G A (oS G (extP G A) G (pP G A) (secP G A a)))
      A
      (sym (PTy[G]) (subTy G G A (oS G (extP G A) G (pP G A) (secP G A a)))
                    (subTy G (extP G A) (subTy (extP G A) G A (pP G A)) (secP G A a))
                    (subTy-o G (extP G A) G A (pP G A) (secP G A a)))
      (trans (PTy[G]) (subTy G G A (oS G (extP G A) G (pP G A) (secP G A a))) (subTy G G A (idS G)) A
         (ap (PSub[G, G]) (PTy[G]) (\ s' -> subTy G G A s')
             (oS G (extP G A) G (pP G A) (secP G A a)) (idS G) (pP-secP G A a))
         (subTy-id G A)) ;

  qP-liftP (D G : PCtx) (A : PTy[G]) (s : PSub[D, G])
    : Id (PEl[EP D G A s, subTy (EP D G A s) D (subTy D G A s) (pP D (subTy D G A s))])
         (subst (PTy[EP D G A s]) (\ X -> PEl[EP D G A s, X])
                (subTy (EP D G A s) (extP G A) (subTy (extP G A) G A (pP G A)) (liftP D G A s))
                (subTy (EP D G A s) D (subTy D G A s) (pP D (subTy D G A s)))
                (p-lift-P D G A s)
                (subEl (EP D G A s) (extP G A) (subTy (extP G A) G A (pP G A)) (qP G A) (liftP D G A s)))
         (qP D (subTy D G A s)) =
    el-subst E (subTy E (extP G A) (subTy (extP G A) G A (pP G A)) (liftP D G A s))
      (subTy E D (subTy D G A s) (pP D (subTy D G A s)))
      (p-lift-P D G A s) (refl (\ I w -> A.tob I (s.nt I w.1)))
      (subEl E (extP G A) (subTy (extP G A) G A (pP G A)) (qP G A) (liftP D G A s))
      (qP D (subTy D G A s)) (\ I w -> refl w.2)
   where { E : PCtx = extP D (subTy D G A s) ; } ;

  qP-secP (G : PCtx) (A : PTy[G]) (a : PEl[G, A])
    : Id (PEl[G, A])
         (subst (PTy[G]) (\ X -> PEl[G, X])
                (subTy G (extP G A) (subTy (extP G A) G A (pP G A)) (secP G A a)) A
                (p-sec-P G A a)
                (subEl G (extP G A) (subTy (extP G A) G A (pP G A)) (qP G A) (secP G A a)))
         a =
    el-subst G (subTy G (extP G A) (subTy (extP G A) G A (pP G A)) (secP G A a)) A
      (p-sec-P G A a) (refl A.tob)
      (subEl G (extP G A) (subTy (extP G A) G A (pP G A)) (qP G A) (secP G A a)) a
      (\ I x -> refl (a.eob I x)) ;

  opaque qP-liftP ; opaque qP-secP ;

  ----------------------------------------------------------------------
  -- The CwF

  PCwF : CwF.CwF[l+] = new CwF.CwF[l := l+,
    Ctx      := PCtx,
    Sub      := \ D G -> PSub[D, G],
    isSetSub := isSet-PSub,
    id       := idS,
    o        := oS,
    o-idl    := \ D G s -> sub-ext D G (oS D G G (idS G) s) s (\ I x -> refl (s.nt I x)),
    o-idr    := \ D G s -> sub-ext D G (oS D D G s (idS D)) s (\ I x -> refl (s.nt I x)),
    o-assoc  := \ Q T D G s s' s'' ->
                  sub-ext Q G (oS Q T G (oS T D G s s') s'') (oS Q D G s (oS Q T D s' s''))
                    (\ I x -> refl (s.nt I (s'.nt I (s''.nt I x)))),

    nil      := nilP,
    eps      := epsP,
    eps-uniq := \ G s -> sub-ext G nilP s (epsP G)
                           (\ I x -> isTop (s.nt I x) tt),

    Ty       := \ G -> PTy[G],
    isSetTy  := isSet-PTy,
    subT     := subTy,
    subT-id  := subTy-id,
    subT-o   := subTy-o,

    El       := \ G A -> PEl[G, A],
    isSetEl  := isSet-PEl,
    subt     := subEl,
    subt-id  := subEl-id,
    subt-o   := subEl-o,

    ext      := extP,
    p        := pP,
    q        := qP,
    lift     := liftP,
    sec      := secP,

    lift-id  := liftP-id,
    lift-o   := liftP-o,
    p-lift   := pP-liftP,
    p-sec    := pP-secP,
    sec-o    := secP-o,
    lift-p-sec-q := \ G A ->
      sub-ext (extP G A) (extP G A)
        (oS (extP G A) (extP (extP G A) (subTy (extP G A) G A (pP G A))) (extP G A)
            (liftP (extP G A) G A (pP G A))
            (secP (extP G A) (subTy (extP G A) G A (pP G A)) (qP G A)))
        (idS (extP G A)) (\ I w -> refl w),
    q-lift   := qP-liftP,
    q-sec    := qP-secP ] ;
} ;
