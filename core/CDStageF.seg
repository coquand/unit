-- CDStageF.seg (L8, Delta): seg/model DStageF.seg ported (module names only).  Was: the recursion over the stages: face-uniform fillers on
-- Delta from a horn filling operation (FillStage.build / FillComp, in line
-- form).
--
--   cmp2-of-fp   the faces of a problem agree on codimension 2, from the
--                face property of the stage (dl y dl z = dl (z+1) dl y,
--                DStageA.resP-sq; the faces are mono: dgH dgH dl dl = id)
--   stages       the filler at every [N], with its sides and its
--                codimension-2 agreement
--   fill         the filler of a problem at [N]
--   sides        it agrees with every side of the problem
--   face         restricted to a face, it is the filler of the face problem
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
open CDeltaNat[a] ;
open CDeltaFact[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
open CDCapBase[a] ;
open CDStageD[a, lz] ;
open CDStageE[a, lz] ;
open CDCapT[a] ;

-- no map into [1] misses two distinct vertices
two-miss : (x y y' : Nat) -> IsT (leb x (suc zero)) -> IsT (leb y (suc zero)) -> IsT (leb y' (suc zero))
  -> IsT (not (eqN x y)) -> IsT (not (eqN x y')) -> IsT (not (eqN y y')) -> Empty = split {
  zero -> split {
    zero -> \ y' hx hy hy' n1 n2 n3 -> false-true n1 ;
    suc y -> \ y' hx hy hy' n1 n2 n3 -> aux0 y' hy' n2 (substH (\ k -> IsT (not (eqN (suc k) y'))) (leb-zero y hy) n3) } ;
  suc x -> split {
    zero -> \ y' hx hy hy' n1 n2 n3 -> aux1 y' hy' (substH (\ k -> IsT (not (eqN (suc k) y'))) (leb-zero x hx) n2) n3 ;
    suc y -> \ y' hx hy hy' n1 n2 n3 -> false-true (substH (\ k -> IsT (not (eqN (suc k) (suc zero)))) (leb-zero x hx)
                                            (substH (\ k -> IsT (not (eqN (suc x) (suc k)))) (leb-zero y hy) n1)) } }
 where {
   aux0 : (y' : Nat) -> IsT (leb y' (suc zero)) -> IsT (not (eqN zero y')) -> IsT (not (eqN (suc zero) y')) -> Empty = split {
     zero -> \ h n2 n3 -> false-true n2 ;
     suc k -> \ h n2 n3 -> false-true (substH (\ m -> IsT (not (eqN (suc zero) (suc m)))) (leb-zero k h) n3) } ;
   aux1 : (y' : Nat) -> IsT (leb y' (suc zero)) -> IsT (not (eqN (suc zero) y')) -> IsT (not (eqN zero y')) -> Empty = split {
     zero -> \ h n2 n3 -> false-true n3 ;
     suc k -> \ h n2 n3 -> false-true (substH (\ m -> IsT (not (eqN (suc zero) (suc m)))) (leb-zero k h) n2) } ; } ;

-- dl y dl z = dl (z+1) dl y  (y <= z)
dldl (N' y z : Nat) (yz : IsT (leb y z))
  : Id (Hom (lin N') (lin (suc (suc N'))))
       (compH (lin N') (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') y) (dl N' z))
       (compH (lin N') (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') (suc z)) (dl N' y)) =
  symH (hom-eq (lin N') (lin (suc (suc N'))) _ _ (pw-dl-dl N' y z yz)) ;

-- the codimension-2 factorisation, for f missing y and z + 1 (y <= z):
-- dgH z (dgH y f) = dgH y (dgH (z+1) f), and the simplicial identity
f2eq (N' y z : Nat) (yz : IsT (leb y z)) (hz : IsT (leb (suc z) (suc (suc N')))) (hy : IsT (leb y (suc (suc N'))))
  (W : Nat) (f : Hom (lin W) (lin (suc (suc N')))) (my : IsT (missB W (suc (suc N')) f y)) (mz : IsT (missB W (suc (suc N')) f (suc z)))
  : Id (Hom (lin W) (lin N'))
       (compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f))
       (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') (suc z)) f)) =
  calc (Hom (lin W) (lin N')) {
      compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f)
    =< apH (\ k -> compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) k))
         (symH (transH (apH (compH (lin W) (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') (suc z)))
                          (fac W N' y (leb-trans y z (suc N') yz hz) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') (suc z)) f)
                             (miss-dg2 W (suc N') y z hz yz f my mz)))
                       (fac W (suc N') (suc z) hz f mz))) >
      compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y)
        (compH (lin W) (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') (suc z)) (compH (lin W) (lin N') (lin (suc N')) (dl N' y) f2')))
    =< apH (\ k -> compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) k))
         (transH (symH (comp-assoc (lin W) (lin N') (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') (suc z)) (dl N' y) f2'))
           (transH (apH (\ k -> compH (lin W) (lin N') (lin (suc (suc N'))) k f2') (symH (dldl N' y z yz)))
                   (comp-assoc (lin W) (lin N') (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') y) (dl N' z) f2'))) >
      compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y)
        (compH (lin W) (lin (suc N')) (lin (suc (suc N'))) (dl (suc N') y) (compH (lin W) (lin N') (lin (suc N')) (dl N' z) f2')))
    =< apH (compH (lin W) (lin (suc N')) (lin N') (dgH N' z)) (dgdl W (suc N') y hy (compH (lin W) (lin N') (lin (suc N')) (dl N' z) f2')) >
      compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin N') (lin (suc N')) (dl N' z) f2')
    =< dgdl W N' z hz f2' >
      f2' }
 where { f2' : Hom (lin W) (lin N') = compH (lin W) (lin (suc N')) (lin N') (dgH N' y) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') (suc z)) f) ; } ;

opaque f2eq ; opaque dldl ;

module SF (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))  {
  module SAm = CDStageA[a, lz].SA[G, A, e] ;
  open SAm ;
  module SBm = CDStageB[a, lz].SB[G, A, e, eN, eE] ;
  module SDm = SD[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;
  module SEm = SE[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0] ;

  ----------------------------------------------------------------------
  -- codimension 2, from the face property

  module C2 (N' : Nat) (F : FillTy (suc N')) (Fp : FillTy N') (fp : SDm.FPr N' F Fp) {
    -- y <= z: the faces y and z + 1 agree
    -- a stage-(N'+1) filler read at a point missing y is the stage-N' filler of the face y
    side1 (c : Prob (suc N')) (y : Nat) (hy : IsT (leb y (suc N'))) (W : Nat) (g : Hom (lin W) (lin (suc N'))) (m : IsT (missB W (suc N') g y))
      (j : Hom (lin W) Iv)
      : Id (TA.EI W) (lv (suc N') (fillE (suc N') F c) W g j)
                     (lv N' (fillE N' Fp (resP N' (suc N') (dl N' y) c)) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) g) j) =
      transH (apH (\ k -> lv (suc N') (fillE (suc N') F c) W k j) (symH (fac W N' y hy g m)))
        (transH (symH (lv-act N' (suc N') (dl N' y) (fillE (suc N') F c) W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) g) j))
                (apH (\ u -> lv N' u W (compH (lin W) (lin (suc N')) (lin N') (dgH N' y) g) j) (fp c y hy))) ;

    opaque side1 ;

    lt-case (b : Prob (suc (suc N'))) (y z : Nat) (yz : IsT (leb y z)) (hz : IsT (leb (suc z) (suc (suc N'))))
      (hy : IsT (leb y (suc (suc N')))) (W : Nat) (f : Hom (lin W) (lin (suc (suc N'))))
      (my : IsT (missB W (suc (suc N')) f y)) (mz : IsT (missB W (suc (suc N')) f (suc z))) (j : Hom (lin W) Iv)
      : Id (TA.EI W) (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y) b)) W
                         (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) j)
                     (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') (suc z)) b)) W
                         (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') (suc z)) f) j) =
      transH (side1 (resP (suc N') (suc (suc N')) (dl (suc N') y) b) z hz W
                (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) (miss-dg1 W (suc N') y z hy yz f my mz) j)
        (transH (apH {Prob N'} {TA.EI W} (\ c -> lv N' (fillE N' Fp c) W
                      (compH (lin W) (lin (suc N')) (lin N') (dgH N' z) (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f)) j)
                   (resP-sq N' (suc N') (suc N') (suc (suc N')) (dl (suc N') y) (dl N' z) (dl (suc N') (suc z)) (dl N' y) (dldl N' y z yz) b))
          (transH (apH (\ k -> lv N' (fillE N' Fp (resP N' (suc N') (dl N' y) (resP (suc N') (suc (suc N')) (dl (suc N') (suc z)) b))) W k j)
                     (f2eq N' y z yz hz hy W f my mz))
                  (symH (side1 (resP (suc N') (suc (suc N')) (dl (suc N') (suc z)) b) y (leb-trans y z (suc N') yz hz) W
                           (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') (suc z)) f) (miss-dg2 W (suc N') y z hz yz f my mz) j)))) ;

    cmp2 : SBm.Cmp2 (suc N') F = \ b y y' hy hy' W f my my' j ->
      eqNDecL (Id (TA.EI W) (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y) b)) W
                                (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) j)
                            (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y') b)) W
                                (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y') f) j)) y y'
        (\ e' -> substH (\ k -> Id (TA.EI W) (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y) b)) W
                                                (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) j)
                                            (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') k) b)) W
                                                (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') k) f) j)) e'
                   (refl (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y) b)) W
                            (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) j)))
        (\ ne -> ltbDecL (Id (TA.EI W) (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y) b)) W
                                            (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) j)
                                        (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y') b)) W
                                            (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y') f) j)) y y'
                   (\ lt -> up b y y' lt hy hy' W f my my' j)
                   (\ ge -> symH (up b y' y (leb-neq y' y ge (neq-sym y y' ne)) hy' hy W f my' my j)))
     where {
       up (b : Prob (suc (suc N'))) (y : Nat) : (y' : Nat) -> IsT (ltb y y') -> IsT (leb y (suc (suc N'))) -> IsT (leb y' (suc (suc N')))
         -> (W : Nat) (f : Hom (lin W) (lin (suc (suc N')))) -> IsT (missB W (suc (suc N')) f y) -> IsT (missB W (suc (suc N')) f y')
         -> (j : Hom (lin W) Iv)
         -> Id (TA.EI W) (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y) b)) W
                             (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y) f) j)
                         (lv (suc N') (fillE (suc N') F (resP (suc N') (suc (suc N')) (dl (suc N') y') b)) W
                             (compH (lin W) (lin (suc (suc N'))) (lin (suc N')) (dgH (suc N') y') f) j) = split {
         zero -> \ lt hy hy' W f my my' j -> absurd _ (false-true lt) ;
         suc z -> \ lt hy hy' W f my my' j -> lt-case b y z lt hy' hy W f my my' j } ; } ;
  } ;

  ----------------------------------------------------------------------
  -- all the stages

  cmp2-0 : SBm.Cmp2 zero SDm.St0.F = \ b y y' hy hy' W f my my' j ->
    eqNDecL (Id (TA.EI W) (lv zero (fillE zero SDm.St0.F (resP zero (suc zero) (dl zero y) b)) W
                              (compH (lin W) (lin (suc zero)) (lin zero) (dgH zero y) f) j)
                          (lv zero (fillE zero SDm.St0.F (resP zero (suc zero) (dl zero y') b)) W
                              (compH (lin W) (lin (suc zero)) (lin zero) (dgH zero y') f) j)) y y'
      (\ e' -> substH (\ k -> Id (TA.EI W) (lv zero (fillE zero SDm.St0.F (resP zero (suc zero) (dl zero y) b)) W
                                              (compH (lin W) (lin (suc zero)) (lin zero) (dgH zero y) f) j)
                                          (lv zero (fillE zero SDm.St0.F (resP zero (suc zero) (dl zero k) b)) W
                                              (compH (lin W) (lin (suc zero)) (lin zero) (dgH zero k) f) j)) e'
                 (refl (lv zero (fillE zero SDm.St0.F (resP zero (suc zero) (dl zero y) b)) W (compH (lin W) (lin (suc zero)) (lin zero) (dgH zero y) f) j)))
      (\ ne -> absurd _ (two-miss (valT W (suc zero) f zero) y y' (valT-range W (suc zero) f zero) hy hy'
                           (miss-e W (suc zero) y f my zero (refl true)) (miss-e W (suc zero) y' f my' zero (refl true)) ne)) ;

  State (N : Nat) : U lz = (F : FillTy N) * (SDm.Sides N F * SBm.Cmp2 N F) ;

  step (N' : Nat) (s : State N') : State (suc N') =
    (SDm.Step[N', s.1, s.2.1, s.2.2].F,
     (SDm.Step[N', s.1, s.2.1, s.2.2].sides,
      C2[N', SDm.Step[N', s.1, s.2.1, s.2.2].F, s.1, SEm.FP[N', s.1, s.2.1, s.2.2].fp].cmp2)) ;

  stages : (N : Nat) -> State N = split {
    zero -> (SDm.St0.F, (SDm.St0.sides, cmp2-0)) ;
    suc N' | ih-N' -> step N' (ih-N') } ;

  fill (N : Nat) : FillTy N = (stages N).1 ;

  sides (N : Nat) : SDm.Sides N (fill N) = (stages N).2.1 ;

  face (N' : Nat) : SDm.FPr N' (fill (suc N')) (fill N') = SEm.FP[N', (stages N').1, (stages N').2.1, (stages N').2.2].fp ;
} ;
