-- CDNormC.seg (L8, Delta): seg/model DNormC.seg ported (module names only).  Was: one step of the normalised fillers (DNormB): K' at [N+1]
-- from K at [N], with
--   sides'   K' agrees with the sides
--   fp'      (A) d_y^* (K' b) = K (d_y^* b)
--   degP     (B) K' (s_j^* c) = s_j^* (K c)
--   cmp2'    codimension 2 (DStageF.C2 from fp')
--
-- Constructive.

level a lz ;
constraint a <= lz ;
open Base ;
open Prelude[lz+] ;
open Paths[lz+] ;
module W0 = V[lz] ;
open Trees[a] ;
open Arith[a] ;
open CDLvl[a, lz] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
open CDSimpId[a] ;
module DGm = CDGlue[a, lz] ;
module DPS = CDPrS[a] ;
open CDCapBase[a] ;

module NC (G : DB.GPre[lz].PS.PCtx) (A : DB.GPre[lz].PS.PTy[G]) (e : El Iv) (eN : Nat) (eE : Id Tree e.1 (leaf eN))
  (tot : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> DB.GPre[lz].TyL[G, A].EI W)
  (tot-pt : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) -> Id (W0.Ix (G.ob W)) (tot N gt gn L0 W f j).1 (gt W f j))
  (tot-nat : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
         -> Id (DB.GPre[lz].TyL[G, A].EI V) (DB.GPre[lz].TyL[G, A].E.act V W g (tot N gt gn L0 W f j))
                                          (tot N gt gn L0 V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
  (tot-S0 : (N : Nat) (gt : (W : Nat) -> Hom (lin W) (lin N) -> Hom (lin W) Iv -> W0.Ix (G.ob W))
         (gn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv)
               -> Id (W0.Ix (G.ob V)) (G.act V W g (gt W f j)) (gt V (compH (lin V) (lin W) (lin N) f g) (compH (lin V) (lin W) Iv j g)))
         (L0 : DGm.PL[G, A, N, gt, gn].PLine[S0 N eN])
         (W : Nat) (f : Hom (lin W) (lin N)) (j : Hom (lin W) Iv) (t : IsT ((S0 N eN).1 W f j))
         -> Id (DB.GPre[lz].TyL[G, A].EI W) (tot N gt gn L0 W f j) (L0.v W f j t))
  (deg : (N : Nat) (b : CDStageA[a, lz].SA[G, A, e].Prob (suc N)) -> CDNormA[a, lz].NA[G, A, e].DegFound N b) {
  module NBm = CDNormB[a, lz].NB[G, A, e, eN, eE, tot, tot-pt, tot-nat, tot-S0, deg] ;
  open NBm ;
  open SAm ;
  open NAm ;

  module Step (N : Nat) (K : FillTy N) (sidesK : SDm.Sides N K) (cmp2K : SBm.Cmp2 N K) (low : LowRel N K) {
    module St = SDm.Step[N, K, sidesK, cmp2K] ;
    module FPm = SEm.FP[N, K, sidesK, cmp2K] ;

    -- the value on a degenerate problem
    dv (b : Prob (suc N)) (i : Nat) (E : DegId N b i) : KA.TS.T (suc N) b.1 =
      KA.TS.fromE (suc N) b.1 (KA.TS.E.act (suc N) N (dgH N i) (fillE N K (resP N (suc N) (dl N i) b))) (apH (\ c -> c.1) (symH E)) ;

    dv-E (b : Prob (suc N)) (i : Nat) (E : DegId N b i)
      : Id (KA.TS.EI (suc N)) (b.1, dv b i E) (KA.TS.E.act (suc N) N (dgH N i) (fillE N K (resP N (suc N) (dl N i) b))) =
      KA.TS.fromE-eq (suc N) b.1 (KA.TS.E.act (suc N) N (dgH N i) (fillE N K (resP N (suc N) (dl N i) b))) (apH (\ c -> c.1) (symH E)) ;

    KC (b : Prob (suc N)) : DegFound N b -> KA.TS.T (suc N) b.1 = split {
      inl w -> dv b w.1 w.2.2.1 ;
      inr n -> St.F b } ;

    K' : FillTy (suc N) = \ b -> KC b (deg N b) ;

    --------------------------------------------------------------------
    -- sides

    sidesC (b : Prob (suc N)) : (v : DegFound N b) -> SidesAt (suc N) b (b.1, KC b v) = split {
      inl w -> sides-tr (suc N) b (resP (suc N) N (dgH N w.1) (resP N (suc N) (dl N w.1) b)) w.2.2.1 (b.1, dv b w.1 w.2.2.1)
                  (substH (\ u -> SidesAt (suc N) (resP (suc N) N (dgH N w.1) (resP N (suc N) (dl N w.1) b)) u) (symH (dv-E b w.1 w.2.2.1))
                     (sides-pull (suc N) N (dgH N w.1) (resP N (suc N) (dl N w.1) b) (fillE N K (resP N (suc N) (dl N w.1) b))
                        (sidesK (resP N (suc N) (dl N w.1) b)))) ;
      inr n -> St.sides b } ;

    sides' : SDm.Sides (suc N) K' = \ b -> sidesC b (deg N b) ;

    --------------------------------------------------------------------
    -- (A) faces

    -- the filler restricted along a degeneracy and a face, at an abstract problem z
    fpz (i y : Nat) (hi : IsT (leb i N)) (hy : IsT (leb y (suc N))) (z : Prob N)
      : Id (KA.TS.EI N) (KA.TS.E.act N (suc N) (dl N y) (KA.TS.E.act (suc N) N (dgH N i) (fillE N K z)))
                        (fillE N K (resP N (suc N) (dl N y) (resP (suc N) N (dgH N i) z))) =
      transH (KA.TS.PE.actC N (suc N) N (dgH N i) (dl N y) (fillE N K z))
        (transH (uSD N K low z i y hi hy)
                (fill-cong N K _ _ (resP-o N (suc N) N (dl N y) (dgH N i) z))) ;

    opaque fpz ;

    fpDeg (b : Prob (suc N)) (y : Nat) (hy : IsT (leb y (suc N))) (i : Nat) (hi : IsT (leb i N)) (E : DegId N b i)
      : Id (KA.TS.EI N) (KA.TS.E.act N (suc N) (dl N y) (b.1, dv b i E)) (fillE N K (resP N (suc N) (dl N y) b)) =
      transH (apH (KA.TS.E.act N (suc N) (dl N y)) (dv-E b i E))
        (transH (fpz i y hi hy (resP N (suc N) (dl N i) b))
                (fill-cong N K _ _ (apH (resP N (suc N) (dl N y)) (symH E)))) ;

    fpC (b : Prob (suc N)) (y : Nat) (hy : IsT (leb y (suc N))) : (v : DegFound N b)
      -> Id (KA.TS.EI N) (KA.TS.E.act N (suc N) (dl N y) (b.1, KC b v)) (fillE N K (resP N (suc N) (dl N y) b)) = split {
      inl w -> fpDeg b y hy w.1 w.2.1 w.2.2.1 ;
      inr n -> FPm.fp b y hy } ;

    fp' : SDm.FPr N K' K = \ b y hy -> fpC b y hy (deg N b) ;
  } ;
} ;
