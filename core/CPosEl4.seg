-- CPosEl4.seg (L8, posets): El of the universe is fibrant (model.tex §8.1,
-- Hypothesis "El"): its composition in each direction is glued (CGlueRC)
-- from the compositions of the codes F_x = l at the generic point of
-- Z * [1], read in El through the Yoneda cart (CPosEl1), at the point o
-- over x (CPosEl2), coherent by CPosEl3.
--
-- Quarry: seg/model PElL2 (ElFib, fibEGen), GLocal3.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module E1 = CPosEl1[a] ;
module E2 = CPosEl2[a] ;
module E3 = CPosEl3[a] ;
module PB = E1.PB ;
module YO = PB.GYon[a] ;
module UU = E1.UU ;

module EF (e e' : El Iv)
  (sel : (Z : Ob) (F : UU.U0 Z) -> PB.CLine[a].Lines[YO.yP Z, F.1].CompK[e, e'].Comp)
  (selEq : (Z' Z : Ob) (g : Hom Z' Z) (F : UU.U0 Z)
     -> Id (PB.CLine[a].Lines[YO.yP Z', (UU.uAct Z' Z g F).1].CompK[e, e'].Comp) (sel Z' (UU.uAct Z' Z g F))
           (PB.CFibSub[a].FibSub[YO.yP Z', YO.yP Z, PB.GYon[a].yH Z' Z g, F.1].C.MoveComp[e, e'].move (sel Z F))) {
  module DE = PB.CLine[a+].EndKit[UU.UCtx, UU.EGen, e] ;
  module CK = PB.CLine[a+].Lines[UU.UCtx, UU.EGen].CompK[e, e'] ;

  module GL = PB.CGlueRC[a+, a].Glue[DE.TV.E, DE.SFm.SF, CK.Tend, CK.endL,
    \ Z x -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].EK'.TV.E,
    \ Z x W c -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].sV W c,
    \ Z x V W g c -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].sV-nat V W g c,
    \ Z x -> E2.Pt[e, Z, (DE.TV.pr1 Z x), E2.FC Z (DE.TV.pr1 Z x), E2.QdC Z (DE.TV.pr1 Z x), (DE.TV.pr2 Z x)].o,
    \ Z x -> E2.Pt[e, Z, (DE.TV.pr1 Z x), E2.FC Z (DE.TV.pr1 Z x), E2.QdC Z (DE.TV.pr1 Z x), (DE.TV.pr2 Z x)].oio,
    \ Z x -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].EK'.SFm.SF,
    \ Z x -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.MoveComp[e, e'].CK'.Tend,
    \ Z x -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.MoveComp[e, e'].CK'.endL,
    \ Z x W v -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].mS W v,
    \ Z x W v -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].mSpt W v,
    \ Z x V W g v -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].mSnat V W g v,
    \ Z x W v v' P Q -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].mS-inj W v v' P Q,
    \ Z x W c u -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].BkS[W, c, u].res,
    \ Z x W c u -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].BkS[W, c, u].res-mS,
    \ Z x W v -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.MoveComp[e, e'].mT W v,
    \ Z x W v -> refl (E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.AtEnd[e].sV W (E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.MoveComp[e, e'].TT'.pr1 W v)),
    \ Z x V W g v -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.MoveComp[e, e'].mTnat V W g v,
    \ Z x W v -> E1.YG.Yc[prodP Z Iv, E2.FC Z (DE.TV.pr1 Z x)].K.MoveComp[e, e'].sq W v,
    \ Z x -> sel (prodP Z Iv) (E2.FC Z (DE.TV.pr1 Z x)),
    \ Z x Y g sg sg' HQ Hv -> E3.Coh[e, e', sel, selEq, Z, x, Y, g].cohG
       (E2.FC Y (E1.FGU.actF Y Z g (DE.TV.pr1 Z x))) E3.Coh[e, e', sel, selEq, Z, x, Y, g].R (E2.QdC Y (E1.FGU.actF Y Z g (DE.TV.pr1 Z x))) sg sg' HQ Hv] ;

  comp : CK.Comp = GL.rc ;
} ;

-- El is fibrant
elFib : PB.CLine[a+].Lines[UU.UCtx, UU.EGen].Fib =
  (EF[e0, e1, \ Z F -> F.2.1, \ Z' Z g F -> refl ((UU.uAct Z' Z g F).2.1)].comp,
   EF[e1, e0, \ Z F -> F.2.2, \ Z' Z g F -> refl ((UU.uAct Z' Z g F).2.2)].comp) ;
