-- CPiNat.seg (L3, inside CB, level l): the fibration of Pi is natural
-- (model.tex Thm "type formers", naturality).  For s : D -> G, the
-- fibration of Pi A[s] B[s] built from the substituted fibrations of A and
-- B is the move of that of Pi A B along the cartesian map of CPiCart.
--
-- Proof, per direction, by MoveComp.unique, value by value (piE-eq):
--   PM     the problem at the moved data is the moved problem: the reverse
--          A filler moves (kmv: CFillMove at the empty side), then the start
--          and the side of the B part (apW-tau), so the B composites agree
--          by kopMv (value-mv)
--   H      the values of the composite: tau-val, PM, and Prob-cong for the
--          restricted data (sV-nat, mside-restr)

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module GPR = GPre[l] ;
open GPR.PS ;

module PiNatD (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[extP G A]) (d : Bool) {
  module PC = CPiCart[l].PiCart[D, G, s, A, B] ;
  A' : PTy[D] = PC.A' ;
  B' : PTy[extP D A'] = PC.B' ;
  module CA = CFibSub[l].FibSub[D, G, s, A].C ;
  module EAt = CA.AtEnd[tgt d] ;
  module FB_ = CFibSub[l].FibSub[extP D A', extP G A, liftP D G A s, B] ;
  module MB = FB_.C.MoveComp[src d, tgt d] ;
  module EB = FB_.C.AtEnd[src d] ;
  module MP = PC.C.MoveComp[src d, tgt d] ;
  module EP = PC.C.AtEnd[src d] ;

  module PiNatC (kA : CLine[l].Lines[G, A].Fill (tgt d)) (kA' : CLine[l].Lines[D, A'].Fill (tgt d))
    (cb : CLine[l].Lines[extP G A, B].CompK[src d, tgt d].Comp)
    (kmv : (X : Ob) (z : EAt.EK'.TV.EI X)
       -> Id (EAt.EK.TS.EI X) (EAt.mS X (EAt.EK'.TS.pr X z (kA'.kop X z (CPi[l].PiC[D, A', B', d, kA', MB.move cb].emptyP X z))))
                              (EAt.EK.TS.pr X (EAt.sV X z) (kA.kop X (EAt.sV X z) (CPi[l].PiC[G, A, B, d, kA, cb].emptyP X (EAt.sV X z))))) {
    module Pi' = CPi[l].PiC[D, A', B', d, kA', MB.move cb] ;
    module Pi = CPi[l].PiC[G, A, B, d, kA, cb] ;

    -- moving commutes with restriction (for the Pi composition)
    mside-restr (Y X : Ob) (h : Hom Y X) (x : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, x])
      : Id (EP.EK.PT.Side[Y, EP.sV Y (EP.EK'.TV.E.act Y X h x)])
           (subst (EP.EK.TV.EI Y) (\ z -> EP.EK.PT.Side[Y, z]) (EP.EK.TV.E.act Y X h (EP.sV X x)) (EP.sV Y (EP.EK'.TV.E.act Y X h x))
              (symH (EP.sV-nat Y X h x)) (EP.EK.PT.rside Y X h (EP.sV X x) (MP.mside Pi.comp X x sd)))
           (MP.mside Pi.comp Y (EP.EK'.TV.E.act Y X h x) (EP.EK'.PT.rside Y X h x sd)) =
      CMove[l, l].Mv[EP.EK'.TV.E, EP.EK'.SFm.SF, MP.CK'.Tend, MP.CK'.endL,
        EP.EK.TV.E, EP.EK.SFm.SF, MP.CK.Tend, MP.CK.endL, EP.sV, EP.sV-nat, EP.mS, EP.mSpt, EP.mSnat,
        MP.mT, \ W v -> refl (EP.sV W (MP.TT'.pr1 W v)), MP.mTnat, MP.mTinj, MP.bkT, MP.bkMv, MP.sq, Pi.comp].mside-restr Y X h x sd ;

    ------------------------------------------------------------------
    -- the problem moves

    module PM (K : Ob) (w : EP.EK'.TV.EI K) (p : EP.EK'.PT.Side[K, w]) (v : W0.Ix (A'.tob K ((Pi'.FG.ev (tgt d)).nt K (EP.EK'.TV.pr1 K w)))) {
      module Q' = Pi'.Prob[K, w, p, v] ;
      module Q = Pi.Prob[K, EP.sV K w, MP.mside Pi.comp K w p, v] ;

      -- the reverse A filler
      xAeq : Id (EAt.EK.TV.EI K) (EAt.sV K Q'.xA) Q.xA =
        EAt.EK.tv-eq K (EAt.sV K Q'.xA) Q.xA (refl (CA.sI K (EP.EK'.TV.pr1 K w))) (EAt.sVE K Q'.xA) ;

      emptyEq : Id (EAt.EK.PT.Side[K, Q.xA])
                   (subst (EAt.EK.TV.EI K) (\ z -> EAt.EK.PT.Side[K, z]) (EAt.sV K Q'.xA) Q.xA xAeq (Pi.emptyP K (EAt.sV K Q'.xA)))
                   (Pi.emptyP K Q.xA) =
        EAt.EK.PT.side-extH K (EAt.sV K Q'.xA) Q.xA xAeq (Pi.emptyP K (EAt.sV K Q'.xA)) (Pi.emptyP K Q.xA)
          (refl (emptyS K)) (\ V f i i' -> absurd _ (empty-lands V K f i)) ;

      LAeq : Id (EAt.EK.TS.EI K) (EAt.mS K (EAt.EK'.TS.pr K Q'.xA (kA'.kop K Q'.xA (Pi'.emptyP K Q'.xA)))) (EAt.EK.TS.pr K Q.xA (kA.kop K Q.xA (Pi.emptyP K Q.xA))) =
        transH (kmv K Q'.xA)
          (Pi.RCA.kop-cong kA K (EAt.sV K Q'.xA) Q.xA xAeq (Pi.emptyP K (EAt.sV K Q'.xA)) (Pi.emptyP K Q.xA) emptyEq) ;

      LAv (V : Ob) (g : Hom V K) (j : Hom V Iv) : Id (Pi.TA.EI V) (PC.SEA.mV V (Q'.La.1.1 V g j)) (Q.La.1.1 V g j) =
        transH (symH (apH (\ M -> CA.FA.lval K M V g j) (EAt.mS-line K (EAt.EK'.TS.pr K Q'.xA (kA'.kop K Q'.xA (Pi'.emptyP K Q'.xA))))))
               (apH (\ z -> (EAt.EK.TS.pr2 K z).1.1.1 V g j) LAeq) ;

      -- the start of the B part
      x0 : W0.Ix (D.ob K) = (Pi'.FG.ev (src d)).nt K (EP.EK'.TV.pr1 K w) ;
      w0' : Pi'.TA.EI K = Q'.La.1.1 K (idH K) (ptH K (src d)) ;

      p0 : Id (W0.Ix (G.ob K)) (G.act K K (idH K) (s.nt K x0)) (s.nt K (Pi'.TA.pr1 K w0')) =
        transH (symH (s.nt-nat K K (idH K) x0)) (apH (s.nt K) Q'.ps) ;

      PWq : Id (EB.EK.TV.EI K) (EB.sV K Q'.wB) Q.wB =
        EB.EK.tv-eq K (EB.sV K Q'.wB) Q.wB (FB_.C.FG.fam-eq K (EB.EK.TV.pr1 K (EB.sV K Q'.wB)) (EB.EK.TV.pr1 K Q.wB) LAv)
          (calc (Pi.TB.EI K) {
              EB.EK.endE K (EB.sV K Q'.wB)
            =< EB.sVE K Q'.wB >
              PC.SEB.mV K (Pi'.TB.pr K w0' (Pi'.PE.apW K x0 (EP.EK'.TV.pr2 K w) K (idH K) w0' Q'.ps))
            =< PC.apW-tau K x0 (EP.EK'.TV.pr2 K w) K (idH K) w0' Q'.ps p0 >
              (Pi.TB.pr K (PC.SEA.mV K w0') (Pi.PE.apW K (s.nt K x0) (PC.tau K x0 (EP.EK'.TV.pr2 K w)) K (idH K) (PC.SEA.mV K w0') p0))
            =< Pi.PE.apW-gen K (s.nt K x0) ((Pi.FG.ev (src d)).nt K (EP.EK.TV.pr1 K (EP.sV K w))) (PC.tau K x0 (EP.EK'.TV.pr2 K w)) (EP.EK.TV.pr2 K (EP.sV K w))
                 (symH (EP.sVE K w)) K (idH K) (PC.SEA.mV K w0') (Q.La.1.1 K (idH K) (ptH K (src d))) (LAv K (idH K) (ptH K (src d)))
                 p0 Q.ps >
              EB.EK.endE K Q.wB }) ;

      -- the side of the B part
      vB (V : Ob) (g : Hom V K) (h : Lands V K p.pQ g) (h' : Lands V K p.pQ g)
        : Id (EB.EK.TS.EI V) (EB.mS V (Q'.SB.pv V g h)) (Q.SB.pv V g h') =
        EB.EK.ts-ext V (EB.mS V (Q'.SB.pv V g h)) (Q.SB.pv V g h')
          (transH (EB.mSpt V (Q'.SB.pv V g h))
            (transH (apH (EB.sV V) (Q'.SB.pv-pt V g h))
              (transH (EB.sV-nat V K g Q'.wB)
                (transH (apH (EB.EK.TV.E.act V K g) PWq) (symH (Q.SB.pv-pt V g h'))))))
          (\ W' g' j ->
            calc (Pi.TB.EI W') {
                (FB_.C.FA.lval V (EB.EK.lineL V (EB.mS V (Q'.SB.pv V g h)))) W' g' j
              =< apH (\ M -> FB_.C.FA.lval V M W' g' j) (EB.mS-line V (Q'.SB.pv V g h)) >
                PC.SEB.mV W' (FB_.C.FA'.lval V (EB.EK'.lineL V (Q'.SB.pv V g h)) W' g' j)
              =< apH (PC.SEB.mV W') (Q'.SB.pv-lev V g h W' g' j) >
                PC.SEB.mV W' (Pi'.PL.ApL[V, (EP.EK'.TV.pr1 V (EP.EK'.TS.pr1 V (p.pv V g h))), (EP.EK'.TS.pr2 V (p.pv V g h)).1, Q'.SB.LaV V g h].val W' g' j)
              =< PC.apW-tau W' (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j)) (PC.PED.TP.pr2 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j)) W' (idH W')
                   (Q'.La.1.1 W' (compH W' V K g g') j)
                   (Pi'.PL.ApL[V, (EP.EK'.TV.pr1 V (EP.EK'.TS.pr1 V (p.pv V g h))), (EP.EK'.TS.pr2 V (p.pv V g h)).1, Q'.SB.LaV V g h].pz W' g' j)
                   (transH (symH (s.nt-nat W' W' (idH W') (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j))))
                           (apH (s.nt W') (Pi'.PL.ApL[V, (EP.EK'.TV.pr1 V (EP.EK'.TS.pr1 V (p.pv V g h))), (EP.EK'.TS.pr2 V (p.pv V g h)).1, Q'.SB.LaV V g h].pz W' g' j))) >
                (Pi.TB.pr W' (PC.SEA.mV W' (Q'.La.1.1 W' (compH W' V K g g') j)) (Pi.PE.apW W' (s.nt W' (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j))) (PC.tau W' (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j)) (PC.PED.TP.pr2 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j)))
                   W' (idH W') (PC.SEA.mV W' (Q'.La.1.1 W' (compH W' V K g g') j))
                   (transH (symH (s.nt-nat W' W' (idH W') (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j))))
                           (apH (s.nt W') (Pi'.PL.ApL[V, (EP.EK'.TV.pr1 V (EP.EK'.TS.pr1 V (p.pv V g h))), (EP.EK'.TS.pr2 V (p.pv V g h)).1, Q'.SB.LaV V g h].pz W' g' j)))))
              =< Pi.PE.apW-gen W' (s.nt W' (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j))) (PC.PEG.TP.pr1 W' ((EP.EK.TS.pr2 V ((MP.mside Pi.comp K w p).pv V g h')).1.1.1 W' g' j))
                   (PC.tau W' (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j)) (PC.PED.TP.pr2 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j))) (PC.PEG.TP.pr2 W' ((EP.EK.TS.pr2 V ((MP.mside Pi.comp K w p).pv V g h')).1.1.1 W' g' j))
                   (transH (apH (\ u -> PC.ta W' ((EP.EK'.TS.pr2 V u).1.1.1 W' g' j)) (EP.EK'.PT.pv-irr K w p V g h h'))
                           (symH (apH (\ M -> PC.C.FA.lval V M W' g' j) (EP.mS-line V (p.pv V g h')))))
                   W' (idH W') (PC.SEA.mV W' (Q'.La.1.1 W' (compH W' V K g g') j)) (Q.La.1.1 W' (compH W' V K g g') j)
                   (LAv W' (compH W' V K g g') j)
                   (transH (symH (s.nt-nat W' W' (idH W') (PC.PED.TP.pr1 W' ((EP.EK'.TS.pr2 V (p.pv V g h)).1.1.1 W' g' j))))
                           (apH (s.nt W') (Pi'.PL.ApL[V, (EP.EK'.TV.pr1 V (EP.EK'.TS.pr1 V (p.pv V g h))), (EP.EK'.TS.pr2 V (p.pv V g h)).1, Q'.SB.LaV V g h].pz W' g' j)))
                   (Pi.PL.ApL[V, (EP.EK.TV.pr1 V (EP.EK.TS.pr1 V ((MP.mside Pi.comp K w p).pv V g h'))), (EP.EK.TS.pr2 V ((MP.mside Pi.comp K w p).pv V g h')).1, Q.SB.LaV V g h'].pz W' g' j) >
                Pi.PL.ApL[V, (EP.EK.TV.pr1 V (EP.EK.TS.pr1 V ((MP.mside Pi.comp K w p).pv V g h'))), (EP.EK.TS.pr2 V ((MP.mside Pi.comp K w p).pv V g h')).1, Q.SB.LaV V g h'].val W' g' j
              =< symH (Q.SB.pv-lev V g h' W' g' j) >
                (FB_.C.FA.lval V (EB.EK.lineL V (Q.SB.pv V g h'))) W' g' j }) ;

      PSq : Id (EB.EK.PT.Side[K, Q.wB])
               (subst (EB.EK.TV.EI K) (\ z -> EB.EK.PT.Side[K, z]) (EB.sV K Q'.wB) Q.wB PWq (MB.mside cb K Q'.wB Q'.pB)) Q.pB =
        EB.EK.PT.side-extH K (EB.sV K Q'.wB) Q.wB PWq (MB.mside cb K Q'.wB Q'.pB) Q.pB (refl p.pQ) vB ;

      opaque xAeq ; opaque PWq ; opaque PSq ;

      -- the values
      value-mv : Id (Pi.TB.EI K) (PC.SEB.mV K (Pi'.TB.pr K (Pi'.TA.pr K ((Pi'.FG.ev (tgt d)).nt K (EP.EK'.TV.pr1 K w)) v) Q'.value))
                                 (Pi.TB.pr K (Pi.TA.pr K ((Pi.FG.ev (tgt d)).nt K (EP.EK.TV.pr1 K (EP.sV K w))) v) Q.value) =
        transH (apH (PC.SEB.mV K) Q'.value-E)
          (transH (symH (MB.E'.sVE K (MB.CK'.SE.mV K (MB.TT'.pr K Q'.wB Q'.bB))))
            (transH (apH (Pi.rdB K)
                      (transH (MB.kopMv cb K Q'.wB Q'.pB)
                        (Pi.RCB.kop-cong cb K (EB.sV K Q'.wB) Q.wB PWq (MB.mside cb K Q'.wB Q'.pB) Q.pB PSq)))
                    (symH Q.value-E))) ;
    } ;

    ------------------------------------------------------------------
    -- the composites agree

    module H (X : Ob) (x : EP.EK'.TV.EI X) (sd : EP.EK'.PT.Side[X, x]) {
      module CX' = Pi'.CopX[X, x, sd] ;
      module CX = Pi.CopX[X, EP.sV X x, MP.mside Pi.comp X x sd] ;
      xT' : W0.Ix (D.ob X) = CX'.xT ;

      module CH (K : Ob) (f : Hom K X) (v : W0.Ix (A.tob K (G.act K X f (s.nt X xT')))) (v' : W0.Ix (A.tob K (G.act K X f CX.xT)))
        (R : Id (Pi.TA.EI K) (Pi.TA.pr K (G.act K X f (s.nt X xT')) v) (Pi.TA.pr K (G.act K X f CX.xT) v')) {
        y : W0.Ix (G.ob K) = G.act K X f (s.nt X xT') ;
        y' : W0.Ix (G.ob K) = s.nt K (D.act K X f xT') ;
        aa : W0.Ix (A'.tob K (D.act K X f xT')) = Pi.TA.coeT K y y' (PC.PN.hs X xT' K f) v ;

        Ra : Id (Pi.TA.EI K) (Pi.TA.pr K y v) (Pi.TA.pr K y' aa) = Pi.TA.pr-coe K y y' (PC.PN.hs X xT' K f) v ;

        xr : EP.EK'.TV.EI K = EP.EK'.TV.E.act K X f x ;

        Pw : Id (EP.EK.TV.EI K) (EP.sV K xr) (EP.EK.TV.E.act K X f (EP.sV X x)) = symH (symH (EP.sV-nat K X f x)) ;

        Rp : Id (EP.EK.PT.Side[K, EP.EK.TV.E.act K X f (EP.sV X x)])
                (subst (EP.EK.TV.EI K) (\ z -> EP.EK.PT.Side[K, z]) (EP.sV K xr) (EP.EK.TV.E.act K X f (EP.sV X x)) Pw
                   (MP.mside Pi.comp K xr (EP.EK'.PT.rside K X f x sd)))
                (EP.EK.PT.rside K X f (EP.sV X x) (MP.mside Pi.comp X x sd)) =
          Pi.subst-inv (EP.EK.TV.EI K) (\ z -> EP.EK.PT.Side[K, z]) (EP.EK.TV.E.act K X f (EP.sV X x)) (EP.sV K xr)
            (symH (EP.sV-nat K X f x)) (EP.EK.PT.rside K X f (EP.sV X x) (MP.mside Pi.comp X x sd))
            (MP.mside Pi.comp K xr (EP.EK'.PT.rside K X f x sd)) (mside-restr K X f x sd) ;

        Vv : Id (Pi.KAe.TV.EI K) (Pi.KAe.TV.pr K (EP.EK.TV.pr1 K (EP.sV K xr)) (CX'.vK K f aa)) (Pi.KAe.TV.pr K (EP.EK.TV.pr1 K (EP.EK.TV.E.act K X f (EP.sV X x))) (CX.vK K f v')) =
          Pi.KAe.tv-eq K (Pi.KAe.TV.pr K (EP.EK.TV.pr1 K (EP.sV K xr)) (CX'.vK K f aa)) (Pi.KAe.TV.pr K (EP.EK.TV.pr1 K (EP.EK.TV.E.act K X f (EP.sV X x))) (CX.vK K f v')) (apH (\ z -> EP.EK.TV.pr1 K z) Pw)
            (transH (apH (PC.SEA.mV K) (symH (CX'.vK-E K f aa)))
              (transH (symH Ra) (transH R (CX.vK-E K f v')))) ;

        res : Id (Pi.TB.EI K) (Pi.PE.valE X (s.nt X xT') (PC.tau X xT' CX'.cop) K f v) (Pi.PE.valE X CX.xT CX.cop K f v') =
          calc (Pi.TB.EI K) {
              Pi.PE.valE X (s.nt X xT') (PC.tau X xT' CX'.cop) K f v
            =< Pi.PE.valE-cong X (s.nt X xT') (PC.tau X xT' CX'.cop) K f f (refl f) v (PC.TV[X, xT', CX'.cop, K, f, aa].ba)
                 (transH Ra (symH (Pi.PE.pp K y y' (PC.PN.hs X xT' K f) aa))) >
              Pi.PE.valE X (s.nt X xT') (PC.tau X xT' CX'.cop) K f (PC.TV[X, xT', CX'.cop, K, f, aa].ba)
            =< symH (PC.tau-val X xT' CX'.cop K f aa) >
              PC.SEB.mV K (Pi'.PE.valE X xT' CX'.cop K f aa)
            =< apH (PC.SEB.mV K) (CX'.cop-val K f aa) >
              PC.SEB.mV K (Pi'.TB.pr K (Pi'.TA.pr K ((Pi'.FG.ev (tgt d)).nt K (EP.EK'.TV.pr1 K xr)) (CX'.vK K f aa)) (Pi'.Prob[K, xr, EP.EK'.PT.rside K X f x sd, CX'.vK K f aa].value))
            =< PM[K, xr, EP.EK'.PT.rside K X f x sd, CX'.vK K f aa].value-mv >
              (Pi.TB.pr K (Pi.TA.pr K ((Pi.FG.ev (tgt d)).nt K (EP.EK.TV.pr1 K (EP.sV K xr))) (CX'.vK K f aa)) (Pi.Prob[K, EP.sV K xr, MP.mside Pi.comp K xr (EP.EK'.PT.rside K X f x sd), CX'.vK K f aa].value))
            =< Pi.Prob-cong K (EP.sV K xr) (EP.EK.TV.E.act K X f (EP.sV X x)) Pw
                 (MP.mside Pi.comp K xr (EP.EK'.PT.rside K X f x sd)) (EP.EK.PT.rside K X f (EP.sV X x) (MP.mside Pi.comp X x sd)) Rp
                 (CX'.vK K f aa) (CX.vK K f v') Vv >
              (Pi.TB.pr K (Pi.TA.pr K ((Pi.FG.ev (tgt d)).nt K (EP.EK.TV.pr1 K (EP.EK.TV.E.act K X f (EP.sV X x)))) (CX.vK K f v')) (Pi.Prob[K, EP.EK.TV.E.act K X f (EP.sV X x), EP.EK.PT.rside K X f (EP.sV X x) (MP.mside Pi.comp X x sd), CX.vK K f v'].value))
            =< symH (CX.cop-val K f v') >
              Pi.PE.valE X CX.xT CX.cop K f v' } ;
      } ;

      EPq : Id (Pi.TP.EI X) (PC.ta X (Pi'.rdP X (Pi'.TTP.pr X x CX'.cop))) (Pi.rdP X (Pi.TTP.pr X (EP.sV X x) CX.cop)) =
        Pi.PE.piE-eq X (PC.ta X (Pi'.rdP X (Pi'.TTP.pr X x CX'.cop))) (Pi.rdP X (Pi.TTP.pr X (EP.sV X x) CX.cop)) (refl (s.nt X xT'))
          (\ K f v v' R -> CH[K, f, v, v', R].res) ;

      res : Id (MP.TT.EI X) (MP.mT X (MP.TT'.pr X x (Pi'.comp.kop X x sd))) (MP.TT.pr X (EP.sV X x) (Pi.comp.kop X (EP.sV X x) (MP.mside Pi.comp X x sd))) =
        MP.CK.SE.mV-inj X (MP.mT X (MP.TT'.pr X x (Pi'.comp.kop X x sd))) (MP.TT.pr X (EP.sV X x) (Pi.comp.kop X (EP.sV X x) (MP.mside Pi.comp X x sd)))
          (refl (EP.sV X x))
          (MP.E'.EK.tv-eq X (MP.CK.SE.mV X (MP.mT X (MP.TT'.pr X x (Pi'.comp.kop X x sd)))) (MP.CK.SE.mV X (MP.TT.pr X (EP.sV X x) (Pi.comp.kop X (EP.sV X x) (MP.mside Pi.comp X x sd))))
            (refl (PC.C.sI X (EP.EK'.TV.pr1 X x)))
            (transH (MP.E'.sVE X (MP.CK'.SE.mV X (MP.TT'.pr X x (Pi'.comp.kop X x sd)))) EPq)) ;
    } ;

    nat : Id (MP.CK'.Comp) Pi'.comp (MP.move Pi.comp) = MP.unique Pi.comp Pi'.comp (\ X x sd -> H[X, x, sd].res) ;
  } ;
} ;

-- the fibration of Pi along s is the move of the fibration of Pi
module PiNat (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[extP G A])
  (fA : CLine[l].Lines[G, A].Fib) (fB : CLine[l].Lines[extP G A, B].Fib) {
  module PC = CPiCart[l].PiCart[D, G, s, A, B] ;
  module SEA = CSub[l].SubE[D, G, s, A] ;
  module FA_ = CFibSub[l].FibSub[D, G, s, A] ;
  module ND1 = PiNatD[D, G, s, A, B, true] ;
  module ND2 = PiNatD[D, G, s, A, B, false] ;

  -- the reverse fillers move at the empty side
  module FM1 = CFillMove[l, l].FillMv[D, PC.A', G, A, s.nt, s.nt-nat, SEA.mV, \ W v -> refl (s.nt W (SEA.TS.pr1 W v)), SEA.mV-nat, SEA.mV-inj,
    \ X x u -> u, \ X x u -> refl (SEA.TC.pr X (s.nt X x) u), false, fA.2] ;
  module FM2 = CFillMove[l, l].FillMv[D, PC.A', G, A, s.nt, s.nt-nat, SEA.mV, \ W v -> refl (s.nt W (SEA.TS.pr1 W v)), SEA.mV-nat, SEA.mV-inj,
    \ X x u -> u, \ X x u -> refl (SEA.TC.pr X (s.nt X x) u), true, fA.1] ;

  module P1' = CPi[l].PiC[D, PC.A', PC.B', true, FM1.FC'.fill, ND1.MB.move fB.1] ;
  module P1 = CPi[l].PiC[G, A, B, true, FM1.FC.fill, fB.1] ;
  module P2' = CPi[l].PiC[D, PC.A', PC.B', false, FM2.FC'.fill, ND2.MB.move fB.2] ;
  module P2 = CPi[l].PiC[G, A, B, false, FM2.FC.fill, fB.2] ;

  kmv1 (X : Ob) (z : ND1.EAt.EK'.TV.EI X)
    : Id (ND1.EAt.EK.TS.EI X) (ND1.EAt.mS X (ND1.EAt.EK'.TS.pr X z (FM1.FC'.fill.kop X z (P1'.emptyP X z))))
                              (ND1.EAt.EK.TS.pr X (ND1.EAt.sV X z) (FM1.FC.fill.kop X (ND1.EAt.sV X z) (P1.emptyP X (ND1.EAt.sV X z)))) =
    transH (FM1.fill-mv X z (P1'.emptyP X z))
      (apH (\ q -> (ND1.EAt.EK.TS.pr X (ND1.EAt.sV X z) (FM1.FC.fill.kop X (ND1.EAt.sV X z) q)))
        (ND1.EAt.EK.PT.side-ext X (ND1.EAt.sV X z) (FM1.msd X z (P1'.emptyP X z)) (P1.emptyP X (ND1.EAt.sV X z))
           (refl (emptyS X)) (\ V f i i' -> absurd _ (empty-lands V X f i)))) ;

  kmv2 (X : Ob) (z : ND2.EAt.EK'.TV.EI X)
    : Id (ND2.EAt.EK.TS.EI X) (ND2.EAt.mS X (ND2.EAt.EK'.TS.pr X z (FM2.FC'.fill.kop X z (P2'.emptyP X z))))
                              (ND2.EAt.EK.TS.pr X (ND2.EAt.sV X z) (FM2.FC.fill.kop X (ND2.EAt.sV X z) (P2.emptyP X (ND2.EAt.sV X z)))) =
    transH (FM2.fill-mv X z (P2'.emptyP X z))
      (apH (\ q -> (ND2.EAt.EK.TS.pr X (ND2.EAt.sV X z) (FM2.FC.fill.kop X (ND2.EAt.sV X z) q)))
        (ND2.EAt.EK.PT.side-ext X (ND2.EAt.sV X z) (FM2.msd X z (P2'.emptyP X z)) (P2.emptyP X (ND2.EAt.sV X z))
           (refl (emptyS X)) (\ V f i i' -> absurd _ (empty-lands V X f i)))) ;

  module N1 = ND1.PiNatC[FM1.FC.fill, FM1.FC'.fill, fB.1, kmv1] ;
  module N2 = ND2.PiNatC[FM2.FC.fill, FM2.FC'.fill, fB.2, kmv2] ;

  fib' : CLine[l].Lines[D, PC.PED.P].Fib =
    CPi[l].PiFib[D, PC.A', PC.B', FA_.sub fA, CFibSub[l].FibSub[extP D PC.A', extP G A, liftP D G A s, B].sub fB].fib ;

  F : CLine[l].Lines[G, PC.PEG.P].Fib = CPi[l].PiFib[G, A, B, fA, fB].fib ;

  nat : Id (CLine[l].Lines[D, PC.PED.P].Fib) fib' (PC.C.moveFib F) =
    transH {CLine[l].Lines[D, PC.PED.P].Fib} {fib'} {((PC.C.moveFib F).1, fib'.2)} {PC.C.moveFib F}
      (apH (\ c -> (c, fib'.2)) N1.nat) (apH (\ c -> ((PC.C.moveFib F).1, c)) N2.nat) ;
} ;
