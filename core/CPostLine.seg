-- CPostLine.seg (L9): the lines of D_N A from r_N psi(u , p) to u_N
-- (postnikov.tex, Theorem conv, the homotopy phi psi ~ id).
--
-- For (u , p) in the internal limit at (X , x) and the recursion of
-- CPostRec, step 2 is run at every simplex f : [n] -> X (St2S , St2Z):
-- it gives H^n(f) in C_n = i*K_n A.  The line at the stage N is the family
-- (Proposition DN, CLocDNC.from)
--
--   w (f , h)  =  H^N(f) at < id , h >        (f , h) : [n] -> X * [1], n <= N
--
-- read in A: the prism Hs N of the recursion for n < N (vlow), the value
-- at the identity of the step-2 prism for n = N (vtop).  It is natural
-- along the face maps (wface: H-face of the recursion below N, Hm-face of
-- step 2 at N), hence along all strict maps (CFacesGen.SGB, bounded by N).
--
--   line N        the line, an element of D_N A at X * [1]
--   end0 , end1   its ends: r_N psi(u , p) and u_N

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CSimp[a] ;
module PB = CPosInst[a].PB ;
module PP = PB.GPre[l].PS ;
module LD = CLocD[a, l] ;
module CK = CCosk[a, l] ;
module EZ = CBoxEZ[a] ;
module PM = CPostMap[a, l] ;
module BD = CPostBdry[a, l] ;
module PR = CPostRec[a, l] ;
module S2m = CPostStep2[a, l] ;

module PL (G : PP.PCtx) (A : PP.PTy[G]) (c : PB.CLine[l].Lines[G, A].Fib) (X : Ob) (x : W0.Ix (G.ob X))
  (u : (N : Nat) -> LD.DT[G, CK.KT[G, A, N].KA].DEl X x)
  (p : (N : Nat) -> LD.DT[G, CK.KT[G, A, N].KA].DEl (prodP X Iv) (G.act (prodP X Iv) X (pr1 X Iv) x))
  (pe0 : (N r : Nat) (hr : IsT (leb r N)) (hr' : IsT (leb r (suc N))) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e0) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  ((p N).1 r (compH (lin r) X (prodP X Iv) (lid X e0) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, suc N].rd (lin r) (G.act (lin r) X q x) ((u (suc N)).1 r q).1 r hr' (idH (lin r))))
  (pe1 : (N r : Nat) (hr : IsT (leb r N)) (q : Hom (lin r) X)
         -> Id (PB.GPre[l].TyL[G, A].EI (lin r))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) (prodP X Iv) (compH (lin r) X (prodP X Iv) (lid X e1) q) (G.act (prodP X Iv) X (pr1 X Iv) x))
                  ((p N).1 r (compH (lin r) X (prodP X Iv) (lid X e1) q)).1 r hr (idH (lin r)))
               (CK.KT[G, A, N].rd (lin r) (G.act (lin r) X q x) ((u N).1 r q).1 r hr (idH (lin r)))) {
  module LL = PR.L[G, A, c, X, x, u, p, pe0, pe1] ;
  module TA = PB.GPre[l].TyL[G, A] ;
  module GL = PB.GPre[l].PshL[G] ;
  XI : Ob = LL.XI ;
  xI : W0.Ix (G.ob XI) = LL.xI ;

  Rd (m : Nat) (f : Hom (lin m) X) : LL.Rec[m, f] = (LL.Drec m).R f ;

  ----------------------------------------------------------------------
  -- step 2 at f : [m] -> X

  module St2S (m' : Nat) (f : Hom (lin (suc m')) X) {
    module ST = LL.ST[m', (LL.Drec m').R, (LL.Drec m').FFH, (LL.Drec m').FFT, f] ;
    R : LL.Rec[suc m', f] = Rd (suc m') f ;
    Fd (y : Nat) : Hom (lin m') X = compH (lin m') (lin (suc m')) X f (dl m' y) ;
    Rf (y : Nat) : LL.Rec[m', Fd y] = Rd m' (Fd y) ;
    hm1 : IsT (leb (suc m') (suc m')) = leb-refl (suc m') ;
    hm2 : IsT (leb (suc (suc m')) (suc (suc m'))) = leb-refl (suc (suc m')) ;

    Th (y : Nat) (hy : IsT (leb y (suc m'))) : LL.TFam m' = (Rf y).Ts (suc m') ;

    -- the side at s = 0 is H^{m+1}(f) on the face
    Th-s0 (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (prodP (lin m') Iv))
      : Id (TA.EI (lin W)) (Th y hy W g (constH (lin W) Iv e0))
                           (R.Hs (suc (suc m')) W (compH (lin W) (lin m') (lin (suc m')) (dl m' y) (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g))
                                 (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)) =
      transH (apH (\ k -> Th y hy W k (constH (lin W) Iv e0)) (symH (pair-eta (lin m') Iv (lin W) g)))
        (transH ((Rf y).Ts0 (suc m') hm1 W (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g)
                                           (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g))
                (symH (ST.H-face (suc (suc m')) hm2 y hy W (compH (lin W) (prodP (lin m') Iv) (lin m') (pr1 (lin m') Iv) g)
                                 (compH (lin W) (prodP (lin m') Iv) Iv (pr2 (lin m') Iv) g)))) ;

    Th-t0 (y : Nat) (hy : IsT (leb y (suc m'))) (W : Nat) (g : Hom (lin W) (lin m')) (j : Hom (lin W) Iv)
      : Id (TA.EI (lin W)) (Th y hy W (pairH (lin m') Iv (lin W) g (constH (lin W) Iv e0)) j)
                           (TA.E.act (lin W) (lin (suc m')) (compH (lin W) (lin m') (lin (suc m')) (dl m' y) g) R.psi) =
      transH ((Rf y).Tt0 (suc m') hm1 W g j)
        (transH (apH (TA.E.act (lin W) (lin m') g) (symH (ST.psi-face y hy)))
                (TA.PE.actC (lin W) (lin m') (lin (suc m')) (dl m' y) g R.psi)) ;

    module S = S2m.S2[G, A, c, X, x, m', f, u (suc m'), u (suc (suc m')), p (suc m'), pe0 (suc m'), pe1 (suc m'),
      R.psi, R.psi-pt, R.Hs (suc (suc m')), R.Hp (suc (suc m')), R.Hn (suc (suc m')), R.H0 (suc (suc m')), R.H1 (suc (suc m')) hm2,
      Th, \ y hy -> (Rf y).Tp (suc m'), \ y hy -> (Rf y).Tn (suc m'), Th-s0, Th-t0, \ y hy -> (Rf y).Tt1 (suc m') hm1,
      (LL.Drec m').FFT (suc m') hm1 f] ;
  } ;

  module St2Z (f : Hom (lin zero) X) {
    R : LL.Rec[zero, f] = Rd zero f ;
    module S = S2m.S2z[G, A, c, X, x, f, u zero, u (suc zero), p zero, pe0 zero, pe1 zero,
      R.psi, R.psi-pt, R.Hs (suc zero), R.Hp (suc zero), R.Hn (suc zero), R.H0 (suc zero), R.H1 (suc zero) (leb-refl (suc zero))] ;
  } ;

  -- H^n(f) in C_n, f : [n] -> X
  HmT : (n : Nat) (f : Hom (lin n) X) (W : Nat) -> Hom (lin W) (lin n) -> Hom (lin W) Iv -> CK.KT[G, A, n].TK.EI (lin W) = split {
    zero -> \ f -> St2Z[f].S.Hm ;
    suc m' -> \ f -> St2S[m', f].S.Hm } ;

  HmTp : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n)) (j : Hom (lin W) Iv)
    -> Id (W0.Ix (G.ob (lin W))) (HmT n f W g j).1 (G.act (lin W) (lin n) g (G.act (lin n) X f x)) = split {
    zero -> \ f -> St2Z[f].S.HH.Hmp ;
    suc m' -> \ f -> St2S[m', f].S.HH.Hmp } ;

  HmT0 : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n))
    -> Id (CK.KT[G, A, n].TK.EI (lin W)) (HmT n f W g (constH (lin W) Iv e0))
          (CK.KT[G, A, n].TK.E.act (lin W) (lin n) g (CK.KT[G, A, n].etaE (lin n) (Rd n f).psi)) = split {
    zero -> \ f -> St2Z[f].S.HH.Hm-0 ;
    suc m' -> \ f -> St2S[m', f].S.HH.Hm-0 } ;

  HmT1 : (n : Nat) (f : Hom (lin n) X) (W : Nat) (g : Hom (lin W) (lin n))
    -> Id (CK.KT[G, A, n].TK.EI (lin W)) (HmT n f W g (constH (lin W) Iv e1))
          (CK.KT[G, A, n].etaE (lin W)
             (PM.DR[G, A, n, X, x, u n, lin n, EZ.HLin[n].ht, n, EZ.HLin[n].hB, EZ.HLin[n].hm, EZ.HLin[n].hi, leb-refl n, f].val W g)) = split {
    zero -> \ f -> St2Z[f].S.HH.Hm-1 ;
    suc m' -> \ f -> St2S[m', f].S.HH.Hm-1 } ;

  ----------------------------------------------------------------------
  -- the family

  p1F (n : Nat) (F : Hom (lin n) XI) : Hom (lin n) X = compH (lin n) XI X (pr1 X Iv) F ;
  p2F (n : Nat) (F : Hom (lin n) XI) : Hom (lin n) Iv = compH (lin n) XI Iv (pr2 X Iv) F ;

  vlow (N n : Nat) (f : Hom (lin n) X) (h : Hom (lin n) Iv) : TA.EI (lin n) = (Rd n f).Hs N n (idH (lin n)) h ;

  vtop (n : Nat) (f : Hom (lin n) X) (h : Hom (lin n) Iv) : TA.EI (lin n) =
    CK.KT[G, A, n].ev n (leb-refl n) (HmT n f n (idH (lin n)) h) ;

  val (N n : Nat) (F : Hom (lin n) XI) : TA.EI (lin n) =
    PR.bcaseL (TA.EI (lin n)) (leb (suc n) N) (\ hh -> vlow N n (p1F n F) (p2F n F)) (\ nh -> vtop n (p1F n F) (p2F n F)) ;

  -- the point
  ptF (n : Nat) (F : Hom (lin n) XI)
    : Id (W0.Ix (G.ob (lin n))) (G.act (lin n) (lin n) (idH (lin n)) (G.act (lin n) X (p1F n F) x)) (G.act (lin n) XI F xI) =
    transH (G.act-id (lin n) (G.act (lin n) X (p1F n F) x)) (symH (GL.actC (lin n) XI X (pr1 X Iv) F x)) ;

  vp (N n : Nat) (F : Hom (lin n) XI) : Id (W0.Ix (G.ob (lin n))) (val N n F).1 (G.act (lin n) XI F xI) =
    PR.bcaseD (TA.EI (lin n)) (\ w -> Id (W0.Ix (G.ob (lin n))) w.1 (G.act (lin n) XI F xI))
      (leb (suc n) N) (\ hh -> vlow N n (p1F n F) (p2F n F)) (\ nh -> vtop n (p1F n F) (p2F n F))
      (\ hh -> transH ((Rd n (p1F n F)).Hp N n (idH (lin n)) (p2F n F)) (ptF n F))
      (\ nh -> transH (CK.KT[G, A, n].ev-pt n (leb-refl n) (HmT n (p1F n F) n (idH (lin n)) (p2F n F)))
                 (transH (HmTp n (p1F n F) n (idH (lin n)) (p2F n F)) (ptF n F))) ;

  ----------------------------------------------------------------------
  -- naturality along the face maps

  -- at the top, the face of H^{n+1}(f) is the prism of the face at the stage n + 1
  module TF (n : Nat) (f : Hom (lin (suc n)) X) (h : Hom (lin (suc n)) Iv) (y : Nat) (hy : IsT (leb y (suc n))) {
    module T = St2S[n, f] ;
    module KS = CK.KT[G, A, suc n] ;
    hd : Hom (lin n) Iv = compH (lin n) (lin (suc n)) Iv h (dl n y) ;
    gp : Hom (lin n) (prodP (lin n) Iv) = pairH (lin n) Iv (lin n) (idH (lin n)) hd ;

    res : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (vtop (suc n) f h))
                             (vlow (suc n) n (compH (lin n) (lin (suc n)) X f (dl n y)) hd) =
      calc (TA.EI (lin n)) {
          TA.E.act (lin n) (lin (suc n)) (dl n y) (KS.ev (suc n) (leb-refl (suc n)) (T.S.Hm (suc n) (idH (lin (suc n))) h))
        =< KS.ev-nat n (suc n) (leb-suc n) (leb-refl (suc n)) (dl n y) (T.S.Hm (suc n) (idH (lin (suc n))) h) >
          KS.ev n (leb-suc n) (KS.TK.E.act (lin n) (lin (suc n)) (dl n y) (T.S.Hm (suc n) (idH (lin (suc n))) h))
        =< apH (KS.ev n (leb-suc n)) (T.S.HH.Hmn n (suc n) (dl n y) (idH (lin (suc n))) h) >
          KS.ev n (leb-suc n) (T.S.Hm n (compH (lin n) (lin (suc n)) (lin (suc n)) (idH (lin (suc n))) (dl n y)) hd)
        =< apH (\ k -> KS.ev n (leb-suc n) (T.S.Hm n k hd))
             (transH (comp-idl (lin n) (lin (suc n)) (dl n y)) (symH (comp-idr (lin n) (lin (suc n)) (dl n y)))) >
          KS.ev n (leb-suc n) (T.S.Hm n (compH (lin n) (lin n) (lin (suc n)) (dl n y) (idH (lin n))) hd)
        =< apH (KS.ev n (leb-suc n)) (T.S.Hm-face y hy n (idH (lin n)) hd) >
          KS.ev n (leb-suc n) (KS.etaE (lin n) (T.Th y hy n gp (constH (lin n) Iv e1)))
        =< KS.ev-eta n (leb-suc n) (T.Th y hy n gp (constH (lin n) Iv e1)) >
          T.Th y hy n gp (constH (lin n) Iv e1)
        =< (T.Rf y).Ts1 (suc n) T.hm1 n gp >
          (T.Rf y).Hs (suc n) n (LL.p1g n n gp) (LL.p2g n n gp)
        =< apH (\ k -> (T.Rf y).Hs (suc n) n k (LL.p2g n n gp)) (pr1-pair (lin n) Iv (lin n) (idH (lin n)) hd) >
          (T.Rf y).Hs (suc n) n (idH (lin n)) (LL.p2g n n gp)
        =< apH ((T.Rf y).Hs (suc n) n (idH (lin n))) (pr2-pair (lin n) Iv (lin n) (idH (lin n)) hd) >
          (T.Rf y).Hs (suc n) n (idH (lin n)) hd } ;
  } ;

  -- below the top, the face of H^N(f) is H^N of the face
  module LF (N n : Nat) (h2 : IsT (leb (suc (suc n)) N)) (f : Hom (lin (suc n)) X) (h : Hom (lin (suc n)) Iv) (y : Nat) (hy : IsT (leb y (suc n))) {
    module T = St2S[n, f] ;
    hd : Hom (lin n) Iv = compH (lin n) (lin (suc n)) Iv h (dl n y) ;

    res : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (vlow N (suc n) f h))
                             (vlow N n (compH (lin n) (lin (suc n)) X f (dl n y)) hd) =
      transH (T.R.Hn N n (suc n) (dl n y) (idH (lin (suc n))) h)
        (transH (apH (\ k -> T.R.Hs N n k hd)
                   (transH (comp-idl (lin n) (lin (suc n)) (dl n y)) (symH (comp-idr (lin n) (lin (suc n)) (dl n y)))))
                (T.ST.H-face N h2 y hy n (idH (lin n)) hd)) ;
  } ;

  -- N = n + 1 from n + 1 <= N and not n + 2 <= N
  topEq (N n : Nat) (o : IsT (leb (suc n) N)) (nh : Id Bool (leb (suc (suc n)) N) false) : Id Nat (suc n) N =
    symH (leb-anti N (suc n) (PR.nleb (suc (suc n)) N nh) o) ;

  module WF (N n : Nat) (o : IsT (leb (suc n) N)) (F : Hom (lin (suc n)) XI) (y : Nat) (hy : IsT (leb y (suc n))) {
    f : Hom (lin (suc n)) X = p1F (suc n) F ;
    h : Hom (lin (suc n)) Iv = p2F (suc n) F ;
    Fd : Hom (lin n) XI = compH (lin n) (lin (suc n)) XI F (dl n y) ;

    rw (M : Nat) : Id (TA.EI (lin n)) (vlow M n (compH (lin n) (lin (suc n)) X f (dl n y)) (compH (lin n) (lin (suc n)) Iv h (dl n y)))
                                      (vlow M n (p1F n Fd) (p2F n Fd)) =
      transH (apH (\ k -> vlow M n k (compH (lin n) (lin (suc n)) Iv h (dl n y))) (comp-assoc (lin n) (lin (suc n)) XI X (pr1 X Iv) F (dl n y)))
             (apH (vlow M n (p1F n Fd)) (comp-assoc (lin n) (lin (suc n)) XI Iv (pr2 X Iv) F (dl n y))) ;

    lhs : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (val N (suc n) F)) (vlow N n (p1F n Fd) (p2F n Fd)) =
      PR.bcaseD (TA.EI (lin (suc n))) (\ w -> Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) w) (vlow N n (p1F n Fd) (p2F n Fd)))
        (leb (suc (suc n)) N) (\ hh -> vlow N (suc n) f h) (\ nh -> vtop (suc n) f h)
        (\ h2 -> transH LF[N, n, h2, f, h, y, hy].res (rw N))
        (\ nh -> transH (substH {Nat} (\ M -> Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (vtop (suc n) f h))
                                                    (vlow M n (compH (lin n) (lin (suc n)) X f (dl n y)) (compH (lin n) (lin (suc n)) Iv h (dl n y))))
                           (topEq N n o nh) TF[n, f, h, y, hy].res)
                        (rw N)) ;

    res : Id (TA.EI (lin n)) (TA.E.act (lin n) (lin (suc n)) (dl n y) (val N (suc n) F)) (val N n Fd) =
      transH lhs (symH (PR.bcase-t (TA.EI (lin n)) (leb (suc n) N) (\ hh -> vlow N n (p1F n Fd) (p2F n Fd)) (\ nh -> vtop n (p1F n Fd) (p2F n Fd)) o)) ;
  } ;

  -- along every strict map (bounded faces suffice)
  module FG (N : Nat) {
    module S = CFacesGen[a, l].SGB[CLocRestr[a, l].R[TA.E].iG, XI, \ n -> IsT (leb n N), \ n o -> leb-trans n (suc n) N (leb-suc n) o,
                                   \ n -> isProp-IsT' (leb n N), \ n o F -> val N n F, \ n o F y hy -> WF[N, n, o, F, y, hy].res] ;
  } ;

  ----------------------------------------------------------------------
  -- the line, an element of D_N A at X * [1]

  module DCN (N : Nat) {
    module D = CLocDNC[a, l].DC[G, A, N] ;

    wF : D.CFam XI xI = \ n hn F -> TA.fromE (lin n) (G.act (lin n) XI F xI) (val N n F) (vp N n F) ;

    crdw (n : Nat) (hn : IsT (leb n N)) (F : Hom (lin n) XI) : Id (TA.EI (lin n)) (D.crd XI xI wF n hn F) (val N n F) =
      TA.fromE-eq (lin n) (G.act (lin n) XI F xI) (val N n F) (vp N n F) ;

    wC : D.CCompat XI xI wF = \ m n hm hn g s F ->
      transH (apH (TA.E.act (lin m) (lin n) g) (crdw n hn F))
        (transH (FG[N].S.fg n m g s F hn hm) (symH (crdw m hm (compH (lin m) (lin n) XI F g)))) ;

    w : D.CEl XI xI = (wF, wC) ;

    line : D.DK.DEl XI xI = D.from XI xI w ;

    -- elements of D_N A are determined by their values at the identity
    to-inj (Y : Ob) (yy : W0.Ix (G.ob Y)) (v v' : D.DK.DEl Y yy)
      (h : (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) Y) -> Id (TA.EI (lin n)) (D.rdId Y yy v n hn q) (D.rdId Y yy v' n hn q))
      : Id (D.DK.DEl Y yy) v v' =
      transH (symH (D.from-to Y yy v))
        (transH (apH (D.from Y yy) (D.Cext Y yy (D.to Y yy v) (D.to Y yy v') (\ n hn q ->
                   transH (D.crd-toF Y yy v n hn q) (transH (h n hn q) (symH (D.crd-toF Y yy v' n hn q))))))
                (D.from-to Y yy v')) ;

    -- the end e of the line
    elid (e : El Iv) : Id (W0.Ix (G.ob X)) (G.act X XI (lid X e) xI) x =
      transH (GL.actC X XI X (pr1 X Iv) (lid X e) x)
        (transH (apH (\ k -> G.act X X k x) (pr1-pair X Iv X (idH X) (constH X Iv e))) (G.act-id X x)) ;

    endL (e : El Iv) : D.DK.DEl X x = D.DK.dtact X XI (lid X e) xI x (elid e) line ;

    -- its values at the identity are those of the line at the lid
    end-rd (e : El Iv) (n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) X)
      : Id (TA.EI (lin n)) (D.rdId X x (endL e) n hn q) (val N n (compH (lin n) X XI (lid X e) q)) =
      calc (TA.EI (lin n)) {
          D.rdId X x (endL e) n hn q
        =< symH (D.crd-toF X x (endL e) n hn q) >
          D.crd X x (D.toF X x (endL e)) n hn q
        =< D.to-nat X XI (lid X e) xI x (elid e) line n hn q >
          D.crd XI xI (D.toF XI xI line) n hn (compH (lin n) X XI (lid X e) q)
        =< apH (\ v -> D.crd XI xI v.1 n hn (compH (lin n) X XI (lid X e) q)) (D.to-from XI xI w) >
          D.crd XI xI wF n hn (compH (lin n) X XI (lid X e) q)
        =< crdw n hn (compH (lin n) X XI (lid X e) q) >
          val N n (compH (lin n) X XI (lid X e) q) } ;
  } ;

  -- the lid after a chain
  pl1 (n : Nat) (e : El Iv) (q : Hom (lin n) X) : Id (Hom (lin n) X) (p1F n (compH (lin n) X XI (lid X e) q)) q =
    transH (symH (comp-assoc (lin n) X XI X (pr1 X Iv) (lid X e) q))
      (transH (apH (\ k -> compH (lin n) X X k q) (pr1-pair X Iv X (idH X) (constH X Iv e))) (comp-idl (lin n) X q)) ;

  pl2 (n : Nat) (e : El Iv) (q : Hom (lin n) X) : Id (Hom (lin n) Iv) (p2F n (compH (lin n) X XI (lid X e) q)) (constH (lin n) Iv e) =
    transH (symH (comp-assoc (lin n) X XI Iv (pr2 X Iv) (lid X e) q))
      (transH (apH (\ k -> compH (lin n) X Iv k q) (pr2-pair X Iv X (idH X) (constH X Iv e))) (BD.const-h (lin n) X q e)) ;

  vlow-lid (N n : Nat) (e : El Iv) (q : Hom (lin n) X)
    : Id (TA.EI (lin n)) (vlow N n (p1F n (compH (lin n) X XI (lid X e) q)) (p2F n (compH (lin n) X XI (lid X e) q))) (vlow N n q (constH (lin n) Iv e)) =
    transH (apH (\ k -> vlow N n k (p2F n (compH (lin n) X XI (lid X e) q))) (pl1 n e q)) (apH (vlow N n q) (pl2 n e q)) ;

  vtop-lid (n : Nat) (e : El Iv) (q : Hom (lin n) X)
    : Id (TA.EI (lin n)) (vtop n (p1F n (compH (lin n) X XI (lid X e) q)) (p2F n (compH (lin n) X XI (lid X e) q))) (vtop n q (constH (lin n) Iv e)) =
    transH (apH (\ k -> vtop n k (p2F n (compH (lin n) X XI (lid X e) q))) (pl1 n e q)) (apH (vtop n q) (pl2 n e q)) ;

  ----------------------------------------------------------------------
  -- the end 1 is u_N

  module E1 (N n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) X) {
    module D = DCN[N].D ;
    module KN = CK.KT[G, A, n] ;

    top : Id (TA.EI (lin n)) (vtop n q (constH (lin n) Iv e1)) (CLocDNC[a, l].DC[G, A, n].rdId X x (u n) n (leb-refl n) q) =
      transH (apH (KN.ev n (leb-refl n)) (HmT1 n q n (idH (lin n))))
        (transH (KN.ev-eta n (leb-refl n) _)
                PM.DRId[G, A, n, X, x, u n, n, leb-refl n, q, leb-refl n].res) ;

    topM (M : Nat) (e : Id Nat n M) (hM : IsT (leb n M))
      : Id (TA.EI (lin n)) (vtop n q (constH (lin n) Iv e1)) (CLocDNC[a, l].DC[G, A, M].rdId X x (u M) n hM q) =
      idJ Nat n (\ M1 e' -> (hM1 : IsT (leb n M1))
                   -> Id (TA.EI (lin n)) (vtop n q (constH (lin n) Iv e1)) (CLocDNC[a, l].DC[G, A, M1].rdId X x (u M1) n hM1 q))
        (\ hM1 -> transH top (KN.rd-irr (lin n) (G.act (lin n) X q x) ((u n).1 n q).1 n (leb-refl n) hM1 (idH (lin n))))
        M e hM ;

    low (hh : IsT (leb (suc n) N)) : Id (TA.EI (lin n)) (vlow N n q (constH (lin n) Iv e1)) (D.rdId X x (u N) n hn q) =
      transH ((Rd n q).H1 N hh n (idH (lin n)))
             PM.DRId[G, A, N, X, x, u N, n, leb-trans n (suc n) N (leb-suc n) hh, q, hn].res ;

    res : Id (TA.EI (lin n)) (val N n (compH (lin n) X XI (lid X e1) q)) (D.rdId X x (u N) n hn q) =
      PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) v (D.rdId X x (u N) n hn q)) (leb (suc n) N)
        (\ hh -> vlow N n (p1F n (compH (lin n) X XI (lid X e1) q)) (p2F n (compH (lin n) X XI (lid X e1) q)))
        (\ nh -> vtop n (p1F n (compH (lin n) X XI (lid X e1) q)) (p2F n (compH (lin n) X XI (lid X e1) q)))
        (\ hh -> transH (vlow-lid N n e1 q) (low hh))
        (\ nh -> transH (vtop-lid n e1 q) (topM N (symH (leb-anti N n (PR.nleb (suc n) N nh) hn)) hn)) ;
  } ;

  end1 (N : Nat) : Id (LD.DT[G, CK.KT[G, A, N].KA].DEl X x) (DCN[N].endL e1) (u N) =
    DCN[N].to-inj X x (DCN[N].endL e1) (u N) (\ n hn q -> transH (DCN[N].end-rd e1 n hn q) E1[N, n, hn, q].res) ;

  ----------------------------------------------------------------------
  -- the end 0 is r_N psi(u , p)

  rN (N : Nat) : LD.DT[G, CK.KT[G, A, N].KA].DEl X x =
    LD.DMap[G, A, CK.KT[G, A, N].KA, CK.KT[G, A, N].etaN].DF X x LL.psi ;

  module E0 (N n : Nat) (hn : IsT (leb n N)) (q : Hom (lin n) X) {
    module D = DCN[N].D ;
    module KN = CK.KT[G, A, n] ;

    -- r_N psi at q, at the identity, is psi(q)
    rhs : Id (TA.EI (lin n)) (D.rdId X x (rN N) n hn q) (TA.E.act (lin n) (lin n) (idH (lin n)) (Rd n q).psi) =
      apH (TA.E.act (lin n) (lin n) (idH (lin n))) (LL.rdE n q) ;

    top : Id (TA.EI (lin n)) (vtop n q (constH (lin n) Iv e0)) (TA.E.act (lin n) (lin n) (idH (lin n)) (Rd n q).psi) =
      transH (apH (KN.ev n (leb-refl n)) (HmT0 n q n (idH (lin n))))
        (transH (symH (KN.ev-nat n n (leb-refl n) (leb-refl n) (idH (lin n)) (KN.etaE (lin n) (Rd n q).psi)))
                (apH (TA.E.act (lin n) (lin n) (idH (lin n))) (KN.ev-eta n (leb-refl n) (Rd n q).psi))) ;

    res : Id (TA.EI (lin n)) (val N n (compH (lin n) X XI (lid X e0) q)) (D.rdId X x (rN N) n hn q) =
      transH (PR.bcaseD (TA.EI (lin n)) (\ v -> Id (TA.EI (lin n)) v (TA.E.act (lin n) (lin n) (idH (lin n)) (Rd n q).psi)) (leb (suc n) N)
                (\ hh -> vlow N n (p1F n (compH (lin n) X XI (lid X e0) q)) (p2F n (compH (lin n) X XI (lid X e0) q)))
                (\ nh -> vtop n (p1F n (compH (lin n) X XI (lid X e0) q)) (p2F n (compH (lin n) X XI (lid X e0) q)))
                (\ hh -> transH (vlow-lid N n e0 q) ((Rd n q).H0 N n (idH (lin n))))
                (\ nh -> transH (vtop-lid n e0 q) top))
             (symH rhs) ;
  } ;

  end0 (N : Nat) : Id (LD.DT[G, CK.KT[G, A, N].KA].DEl X x) (DCN[N].endL e0) (rN N) =
    DCN[N].to-inj X x (DCN[N].endL e0) (rN N) (\ n hn q -> transH (DCN[N].end-rd e0 n hn q) E0[N, n, hn, q].res) ;
} ;
