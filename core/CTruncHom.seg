-- Natural maps of seeded extension algebras.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module Maps (G : PCtx) (B C : PTy[G]) (f : HO.NMap[G,B,C]) {
  open CTruncRaw[a,l].Build[G,B] ;
  module KB = CTruncAlg[a,l].Algebras[G,B] ;
  module KC = CTruncAlg[a,l].Algebras[G,C] ;
  at (z : Loc) : KB.F z -> KC.F z = f.nfun z.1 z.2 ;
  nat (s z : Loc) (h : Arr s z) (b : KB.F z) :
    Id (KC.F s) (KC.act s z h (at z b)) (at s (KB.act s z h b)) =
    f.nnat s.1 z.1 h.1 z.2 s.2 h.2 b ;
  partial (z : Loc) (Q : PB.Phi z.1) (v : KB.Partial z Q) : KC.Partial z Q =
    \ s h i -> at s (v s h i) ;
  natural (z : Loc) (Q : PB.Phi z.1) (v : KB.Partial z Q) (vn : KB.Natural z Q v) :
    KC.Natural z Q (partial z Q v) = \ s h i r g j ->
    transH (nat r s g (v s h i)) (apH (at r) (vn s h i r g j)) ;
  opaque natural ;
  Preserves (b : KB.Algebra) (c : KC.Algebra) : U l =
    (z : Loc) (Q : PB.Phi z.1) (u : KB.F z) (v : KB.Partial z Q) (vn : KB.Natural z Q v) ->
    Id (KC.F z) (at z (b.extend z Q u v vn))
      (c.extend z Q (at z u) (partial z Q v) (natural z Q v vn)) ;
} ;
