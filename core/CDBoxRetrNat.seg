-- Compare the composition problems produced by the same retraction.
module Compare (e e' : El Iv) (c : DB.CLine[l].Lines[G, A].CompK[e, e'].Comp)
  (X : Nat) (x : TD.Pt X) (y : TG.Pt X) (p : Id (TG.Pt X) (s X x) y)
  (Q : DB.Phi X)
  (u : DB.CPartial[k].Partials[D, A'].Side[X, x]) (v : DB.CPartial[l].Partials[G, A].Side[X, y])
  (uQ : Id (DB.Phi X) Q u.pQ) (vQ : Id (DB.Phi X) Q v.pQ)
  (uv : (W : Nat) (f : Hom (lin W) (lin X)) (i : DB.Lands W X u.pQ f) (j : DB.Lands W X v.pQ f)
    -> Id (TG.EI W) (ta W (u.pv W f i)) (v.pv W f j))
  (r : (W : Nat) -> Hom (lin W) (lin X) -> Hom (lin W) Iv -> Hom (lin W) (lin X))
  (rn : (V W : Nat) (g : Hom (lin V) (lin W)) (f : Hom (lin W) (lin X)) (i : Hom (lin W) Iv)
    -> Id (Hom (lin V) (lin X)) (DB.compH V W X (r W f i) g) (r V (DB.compH V W X f g) (DB.ivA V W g i)))
  (R1 : (W : Nat) (f : Hom (lin W) (lin X)) -> Id (Hom (lin W) (lin X)) (r W f (DB.ptH W e')) f)
  (Du : (W : Nat) (f : Hom (lin W) (lin X)) -> DB.Lands W X u.pQ (r W f (DB.ptH W e)))
  (Gu : (W : Nat) (f : Hom (lin W) (lin X)) -> DB.Lands W X v.pQ (r W f (DB.ptH W e)))
  (Ds : (W : Nat) (f : Hom (lin W) (lin X)) (i : Hom (lin W) Iv) -> DB.Lands W X u.pQ f -> DB.Lands W X u.pQ (r W f i))
  (Gs : (W : Nat) (f : Hom (lin W) (lin X)) (i : Hom (lin W) Iv) -> DB.Lands W X v.pQ f -> DB.Lands W X v.pQ (r W f i)) {
  module M = C.MoveComp[e, e'] ;
  module E = M.E ;
  module F' = DB.CHornRetr[k].RF[D, A', e, e', M.move c, X, x, u, r, rn, R1, Du, Ds] ;
  module F = DB.CHornRetr[l].RF[G, A, e, e', c, X, y, v, r, rn, R1, Gu, Gs] ;
  module Rel = DB.CPartial[l].Rel[E.EK.TV.E, E.EK.SFm.SF, M.CK.Tend, M.CK.endL] ;

  start : Id (E.EK.TV.EI X) (E.sV X F'.x0) F.x0 =
    E.EK.tv-eq X (E.sV X F'.x0) F.x0
      (C.FG.fam-eq X (C.sI X F'.gam) F.gam (\ W f j ->
        transH (sn W X (r W f j) x) (apH (G.act W X (r W f j)) p)))
      (transH (E.sVE X F'.x0) (transH (apH (ta X) F'.x0-E)
        (transH (uv X F'.r0 (Du X (DB.idH X)) (Gu X (DB.idH X))) (symH F.x0-E)))) ;

  opaque start ;

  side (W : Nat) (f : Hom (lin W) (lin X)) (i : DB.Lands W X u.pQ f) (j : DB.Lands W X v.pQ f)
    : Id (E.EK.TS.EI W) (E.mS W (F'.LS.sv W f i)) (F.LS.sv W f j) =
    E.EK.ts-ext W (E.mS W (F'.LS.sv W f i)) (F.LS.sv W f j)
      (transH (E.mSpt W (F'.LS.sv W f i))
        (transH (apH (E.sV W) (F'.LS.sv-pt W f i))
          (transH (E.sV-nat W X f F'.x0)
            (transH (apH (E.EK.TV.E.act W X f) start) (symH (F.LS.sv-pt W f j))))))
      (\ V g k0 -> transH (E.mS-val W (F'.LS.sv W f i) V g k0)
        (transH (apH (ta V) (F'.LS.sv-val W f i V g k0))
          (transH (uv V _ (F'.iS W f i V g k0) (F.iS W f j V g k0)) (symH (F.LS.sv-val W f j V g k0))))) ;

  opaque side ;

  value : Id (M.TT.EI X) (M.mT X (M.TT'.pr X F'.x0 F'.c)) (M.TT.pr X F.x0 F.c) =
    transH (M.kopMv c X F'.x0 F'.LS.side)
      (Rel.kop-cong c X (E.sV X F'.x0) F.x0 start (M.mside c X F'.x0 F'.LS.side) F.LS.side
        (E.EK.PT.side-extH X (E.sV X F'.x0) F.x0 start (M.mside c X F'.x0 F'.LS.side) F.LS.side
          (transH (symH uQ) vQ) side)) ;

  endpoint (w : M.TT'.EI X) : Id (TG.EI X) (ta X (F'.rd X w)) (F.rd X (M.mT X w)) =
    symH (M.E'.sVE X (M.CK'.SE.mV X w)) ;

  law : Id (TG.EI X) (ta X (TD.pr X x F'.fill)) (TG.pr X y F.fill) =
    transH (apH (ta X) F'.fill-E) (transH (endpoint (M.TT'.pr X F'.x0 F'.c))
      (transH (apH (F.rd X) value) (symH F.fill-E))) ;

  opaque law ;
} ;
