-- Every well-formed node is its seeded extension.  This is the eta lemma
-- needed to obtain induction and uniqueness from the raw-tree recursor.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

module Eta (G : PCtx) (A : PTy[G]) {
  open CTruncRaw[a,l].Build[G,A] ;
  open CTruncGood[a,l].GoodSets[G,A] ;
  open CTruncLaws[a,l].Laws[G,A] ;
  module O = CTruncExt[a,l].Ops[G,A] ;
  module Node (z : Loc) (Q : PB.Phi z.1) (u : Seed z) (v : Side z Q)
    (good : Good (node z Q u v)) {
    tu (s : Loc) (h : Arr s z) : TrEl s = (u s h, good.2.1 s h) ;
    tv (s : Loc) (h : Arr s z) (i : PB.Lands s.1 z.1 Q h.1) : TrEl s =
      (v s h i, good.2.2.1 s h i) ;
    un (s : Loc) (h : Arr s z) (r : Loc) (g : Arr r s) :
      Id (TrEl r) (tr-res r s g (tu s h)) (tu r (compose r s z h g)) =
      tr-eq r _ _ (good.2.2.2.1 s h r g (tu s h).2.2) ;
    vn : O.Natural z Q tv = \ s h i r g j ->
      tr-eq r _ _ (good.2.2.2.2 s h i r g j (tv s h i).2.2) ;
    opaque un ; opaque vn ;
    module E = O.Extend[z,Q,tu z (ident z),tv,vn] ;
    seed-eq (s : Loc) (h : Arr s z) : Id Raw (E.us s h) (u s h) =
      transH (good.2.2.2.1 z (ident z) s h (tu z (ident z)).2.2)
        (apH (u s) (compose-idl s z h)) ;
    eta : Id (TrEl z) E.value (node z Q u v,(good,refl z)) =
      tr-eq z _ _ (transH (E.outside good.1)
        (same-node z Q E.us u E.vs v seed-eq
          (\ s h i j -> boundary-cong z Q v s h h (refl h) i j))) ;
    opaque eta ;
  } ;
} ;
