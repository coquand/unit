-- COpLaws.seg (L2, inside CB, levels i j k): the move laws for operations
-- without uniformity (COpMove.Pull):
--
--   opAt   an operation at equal points, on data with equal values, has
--          equal fillers (in the total)
--   PC     composite: pulling back along two maps is pulling back along
--          their composite (the moved data have the same values)
--   PG     congruence: maps with pointwise equal totals pull back alike
--          (points equal by a path, not definitionally)
--
-- Quarry: seg/model GFillX (laws by FExt).

level i j k ;
constraint a <= i ;
constraint i <= j ;
constraint j <= k ;
open Base ;
open Prelude[k+] ;
open Paths[k+] ;
open Axioms[k+].FunExtLemmas[fe @(k+)] ;
module W1 = V[i] ;
module W2 = V[j] ;
module W0 = V[k] ;
module P1 = GPre[i] ;
module P2 = GPre[j] ;
module P0 = GPre[k] ;

module OL (I : U a) (ok : I -> U a) (ob : I -> Ob) (S : (n : I) -> Phi (ob n)) {

  -- an operation at equal points, on data with the same values
  module At (G : P0.PS.PCtx) (A : P0.PS.PTy[G]) (c : COp[k].OpS[I, ok, ob, S, G, A].Op) {
    module F = COp[k].OpS[I, ok, ob, S, G, A] ;
    module TG = P0.TyL[G, A] ;

    opAt (n : I) (o : ok n) (y y' : W0.Ix (G.ob (ob n))) (P : Id (W0.Ix (G.ob (ob n))) y y') (h : F.HData n y) (h' : F.HData n y')
      (V : (W : Ob) (f : Hom W (ob n)) (q : Lands W (ob n) (S n) f) -> Id (TG.EI W) (h.1 W f q) (h'.1 W f q))
      : Id (TG.EI (ob n)) (y, (c n o y h).1) (y', (c n o y' h').1) =
      idJ (W0.Ix (G.ob (ob n))) y
        (\ y2 P2 -> (h2 : F.HData n y2) -> ((W : Ob) (f : Hom W (ob n)) (q : Lands W (ob n) (S n) f) -> Id (TG.EI W) (h.1 W f q) (h2.1 W f q))
           -> Id (TG.EI (ob n)) (y, (c n o y h).1) (y2, (c n o y2 h2).1))
        (\ h2 V2 -> apH {F.HData n y} {TG.EI (ob n)} (\ hd -> (y, (c n o y hd).1))
           (F.hd-eq n y h h2 (funext Ob (\ W -> (f : Hom W (ob n)) -> Lands W (ob n) (S n) f -> TG.EI W) h.1 h2.1 (\ W ->
              funext (Hom W (ob n)) (\ f -> Lands W (ob n) (S n) f -> TG.EI W) (h.1 W) (h2.1 W) (\ f ->
                funext (Lands W (ob n) (S n) f) (\ q -> TG.EI W) (h.1 W f) (h2.1 W f) (\ q -> V2 W f q))))))
        y' P h' V ;

    opaque opAt ;
  } ;

  -- composite
  module PC (D1 : P1.PS.PCtx) (A1 : P1.PS.PTy[D1]) (D : P2.PS.PCtx) (A' : P2.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
    (pts1 : (W : Ob) -> W1.Ix (D1.ob W) -> W2.Ix (D.ob W))
    (pnat1 : (V W : Ob) (g : Hom V W) (x : W1.Ix (D1.ob W)) -> Id (W2.Ix (D.ob V)) (pts1 V (D1.act V W g x)) (D.act V W g (pts1 W x)))
    (cf1 : (W : Ob) (x : W1.Ix (D1.ob W)) -> W1.Ix (A1.tob W x) -> W2.Ix (A'.tob W (pts1 W x)))
    (cb1 : (W : Ob) (x : W1.Ix (D1.ob W)) -> W2.Ix (A'.tob W (pts1 W x)) -> W1.Ix (A1.tob W x))
    (cbf1 : (W : Ob) (x : W1.Ix (D1.ob W)) (b : W1.Ix (A1.tob W x)) -> Id (W1.Ix (A1.tob W x)) (cb1 W x (cf1 W x b)) b)
    (cfb1 : (W : Ob) (x : W1.Ix (D1.ob W)) (b : W2.Ix (A'.tob W (pts1 W x))) -> Id (W2.Ix (A'.tob W (pts1 W x))) (cf1 W x (cb1 W x b)) b)
    (mnat1 : (V W : Ob) (g : Hom V W) (w : P1.TyL[D1, A1].EI W)
       -> Id (P2.TyL[D, A'].EI V) (P2.TyL[D, A'].E.act V W g (pts1 W w.1, cf1 W w.1 w.2))
                                  (pts1 V (P1.TyL[D1, A1].E.act V W g w).1, cf1 V (P1.TyL[D1, A1].E.act V W g w).1 (P1.TyL[D1, A1].E.act V W g w).2))
    (pts2 : (W : Ob) -> W2.Ix (D.ob W) -> W0.Ix (G.ob W))
    (pnat2 : (V W : Ob) (g : Hom V W) (x : W2.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (pts2 V (D.act V W g x)) (G.act V W g (pts2 W x)))
    (cf2 : (W : Ob) (x : W2.Ix (D.ob W)) -> W2.Ix (A'.tob W x) -> W0.Ix (A.tob W (pts2 W x)))
    (cb2 : (W : Ob) (x : W2.Ix (D.ob W)) -> W0.Ix (A.tob W (pts2 W x)) -> W2.Ix (A'.tob W x))
    (cbf2 : (W : Ob) (x : W2.Ix (D.ob W)) (b : W2.Ix (A'.tob W x)) -> Id (W2.Ix (A'.tob W x)) (cb2 W x (cf2 W x b)) b)
    (cfb2 : (W : Ob) (x : W2.Ix (D.ob W)) (b : W0.Ix (A.tob W (pts2 W x))) -> Id (W0.Ix (A.tob W (pts2 W x))) (cf2 W x (cb2 W x b)) b)
    (mnat2 : (V W : Ob) (g : Hom V W) (w : P2.TyL[D, A'].EI W)
       -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (pts2 W w.1, cf2 W w.1 w.2))
                                  (pts2 V (P2.TyL[D, A'].E.act V W g w).1, cf2 V (P2.TyL[D, A'].E.act V W g w).1 (P2.TyL[D, A'].E.act V W g w).2))
    (c : COp[k].OpS[I, ok, ob, S, G, A].Op) {
    pts (W : Ob) (x : W1.Ix (D1.ob W)) : W0.Ix (G.ob W) = pts2 W (pts1 W x) ;
    pnat (V W : Ob) (g : Hom V W) (x : W1.Ix (D1.ob W)) : Id (W0.Ix (G.ob V)) (pts V (D1.act V W g x)) (G.act V W g (pts W x)) =
      transH (apH (pts2 V) (pnat1 V W g x)) (pnat2 V W g (pts1 W x)) ;
    cf (W : Ob) (x : W1.Ix (D1.ob W)) (b : W1.Ix (A1.tob W x)) : W0.Ix (A.tob W (pts W x)) = cf2 W (pts1 W x) (cf1 W x b) ;
    cb (W : Ob) (x : W1.Ix (D1.ob W)) (b : W0.Ix (A.tob W (pts W x))) : W1.Ix (A1.tob W x) = cb1 W x (cb2 W (pts1 W x) b) ;
    cbf (W : Ob) (x : W1.Ix (D1.ob W)) (b : W1.Ix (A1.tob W x)) : Id (W1.Ix (A1.tob W x)) (cb W x (cf W x b)) b =
      transH (apH (cb1 W x) (cbf2 W (pts1 W x) (cf1 W x b))) (cbf1 W x b) ;
    cfb (W : Ob) (x : W1.Ix (D1.ob W)) (b : W0.Ix (A.tob W (pts W x))) : Id (W0.Ix (A.tob W (pts W x))) (cf W x (cb W x b)) b =
      transH (apH (cf2 W (pts1 W x)) (cfb1 W x (cb2 W (pts1 W x) b))) (cfb2 W (pts1 W x) b) ;
    mnat (V W : Ob) (g : Hom V W) (w : P1.TyL[D1, A1].EI W)
      : Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (pts W w.1, cf W w.1 w.2))
                               (pts V (P1.TyL[D1, A1].E.act V W g w).1, cf V (P1.TyL[D1, A1].E.act V W g w).1 (P1.TyL[D1, A1].E.act V W g w).2) =
      transH (mnat2 V W g (pts1 W w.1, cf1 W w.1 w.2))
        (apH {P2.TyL[D, A'].EI V} {P0.TyL[G, A].EI V} (\ z -> (pts2 V z.1, cf2 V z.1 z.2)) (mnat1 V W g w)) ;

    module M2 = COpMove[j, k].Pull[I, ok, ob, S, D, A', G, A, pts2, pnat2, cf2, cb2, cbf2, cfb2, mnat2, c] ;
    module M1 = COpMove[i, j].Pull[I, ok, ob, S, D1, A1, D, A', pts1, pnat1, cf1, cb1, cbf1, cfb1, mnat1, M2.op] ;
    module M12 = COpMove[i, k].Pull[I, ok, ob, S, D1, A1, G, A, pts, pnat, cf, cb, cbf, cfb, mnat, c] ;
    module F0 = COp[k].OpS[I, ok, ob, S, G, A] ;

    law : Id (COp[i].OpS[I, ok, ob, S, D1, A1].Op) M1.op M12.op =
      COp[i].OpS[I, ok, ob, S, D1, A1].op-ext M1.op M12.op (\ n o rho h ->
        apH {F0.HData n (pts (ob n) rho)} {W1.Ix (A1.tob (ob n) rho)} (\ hd -> cb (ob n) rho (c n o (pts (ob n) rho) hd).1)
          (F0.hd-eq n (pts (ob n) rho) (M2.mv n (pts1 (ob n) rho) (M1.mv n rho h)) (M12.mv n rho h) (refl (M12.mv n rho h).1))) ;
  } ;

  -- congruence
  module PG (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
    (pts1 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
    (pnat1 : (V W : Ob) (g : Hom V W) (x : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (pts1 V (D.act V W g x)) (G.act V W g (pts1 W x)))
    (cf1 : (W : Ob) (x : W1.Ix (D.ob W)) -> W1.Ix (A'.tob W x) -> W0.Ix (A.tob W (pts1 W x)))
    (cb1 : (W : Ob) (x : W1.Ix (D.ob W)) -> W0.Ix (A.tob W (pts1 W x)) -> W1.Ix (A'.tob W x))
    (cbf1 : (W : Ob) (x : W1.Ix (D.ob W)) (b : W1.Ix (A'.tob W x)) -> Id (W1.Ix (A'.tob W x)) (cb1 W x (cf1 W x b)) b)
    (cfb1 : (W : Ob) (x : W1.Ix (D.ob W)) (b : W0.Ix (A.tob W (pts1 W x))) -> Id (W0.Ix (A.tob W (pts1 W x))) (cf1 W x (cb1 W x b)) b)
    (mnat1 : (V W : Ob) (g : Hom V W) (w : P1.TyL[D, A'].EI W)
       -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (pts1 W w.1, cf1 W w.1 w.2))
                                  (pts1 V (P1.TyL[D, A'].E.act V W g w).1, cf1 V (P1.TyL[D, A'].E.act V W g w).1 (P1.TyL[D, A'].E.act V W g w).2))
    (pts2 : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
    (pnat2 : (V W : Ob) (g : Hom V W) (x : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob V)) (pts2 V (D.act V W g x)) (G.act V W g (pts2 W x)))
    (cf2 : (W : Ob) (x : W1.Ix (D.ob W)) -> W1.Ix (A'.tob W x) -> W0.Ix (A.tob W (pts2 W x)))
    (cb2 : (W : Ob) (x : W1.Ix (D.ob W)) -> W0.Ix (A.tob W (pts2 W x)) -> W1.Ix (A'.tob W x))
    (cbf2 : (W : Ob) (x : W1.Ix (D.ob W)) (b : W1.Ix (A'.tob W x)) -> Id (W1.Ix (A'.tob W x)) (cb2 W x (cf2 W x b)) b)
    (cfb2 : (W : Ob) (x : W1.Ix (D.ob W)) (b : W0.Ix (A.tob W (pts2 W x))) -> Id (W0.Ix (A.tob W (pts2 W x))) (cf2 W x (cb2 W x b)) b)
    (mnat2 : (V W : Ob) (g : Hom V W) (w : P1.TyL[D, A'].EI W)
       -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (pts2 W w.1, cf2 W w.1 w.2))
                                  (pts2 V (P1.TyL[D, A'].E.act V W g w).1, cf2 V (P1.TyL[D, A'].E.act V W g w).1 (P1.TyL[D, A'].E.act V W g w).2))
    (Ps : (W : Ob) (x : W1.Ix (D.ob W)) -> Id (W0.Ix (G.ob W)) (pts1 W x) (pts2 W x))
    (Q : (W : Ob) (w : P1.TyL[D, A'].EI W) -> Id (P0.TyL[G, A].EI W) (pts1 W w.1, cf1 W w.1 w.2) (pts2 W w.1, cf2 W w.1 w.2))
    (c : COp[k].OpS[I, ok, ob, S, G, A].Op) {
    module M1 = COpMove[i, k].Pull[I, ok, ob, S, D, A', G, A, pts1, pnat1, cf1, cb1, cbf1, cfb1, mnat1, c] ;
    module M2 = COpMove[i, k].Pull[I, ok, ob, S, D, A', G, A, pts2, pnat2, cf2, cb2, cbf2, cfb2, mnat2, c] ;
    module AT = At[G, A, c] ;
    module TD = P1.TyL[D, A'] ;

    pt (n : I) (o : ok n) (rho : W1.Ix (D.ob (ob n))) (h : COp[i].OpS[I, ok, ob, S, D, A'].HData n rho)
      : Id (TD.EI (ob n)) (rho, (M1.op n o rho h).1) (rho, (M2.op n o rho h).1) =
      M2.mInj (ob n) (rho, (M1.op n o rho h).1) (rho, (M2.op n o rho h).1) (refl rho)
        (calc (P0.TyL[G, A].EI (ob n)) {
            (pts2 (ob n) rho, cf2 (ob n) rho (M1.op n o rho h).1)
          =< symH (Q (ob n) (rho, (M1.op n o rho h).1)) >
            (pts1 (ob n) rho, cf1 (ob n) rho (cb1 (ob n) rho (c n o (pts1 (ob n) rho) (M1.mv n rho h)).1))
          =< apH {W0.Ix (A.tob (ob n) (pts1 (ob n) rho))} {P0.TyL[G, A].EI (ob n)} (\ z -> (pts1 (ob n) rho, z))
               (cfb1 (ob n) rho (c n o (pts1 (ob n) rho) (M1.mv n rho h)).1) >
            (pts1 (ob n) rho, (c n o (pts1 (ob n) rho) (M1.mv n rho h)).1)
          =< AT.opAt n o (pts1 (ob n) rho) (pts2 (ob n) rho) (Ps (ob n) rho) (M1.mv n rho h) (M2.mv n rho h)
               (\ W f q -> Q W (h.1 W f q)) >
            (pts2 (ob n) rho, (c n o (pts2 (ob n) rho) (M2.mv n rho h)).1)
          =< symH (apH {W0.Ix (A.tob (ob n) (pts2 (ob n) rho))} {P0.TyL[G, A].EI (ob n)} (\ z -> (pts2 (ob n) rho, z))
                     (cfb2 (ob n) rho (c n o (pts2 (ob n) rho) (M2.mv n rho h)).1)) >
            (pts2 (ob n) rho, cf2 (ob n) rho (M2.op n o rho h).1) }) ;

    law : Id (COp[i].OpS[I, ok, ob, S, D, A'].Op) M1.op M2.op =
      COp[i].OpS[I, ok, ob, S, D, A'].op-ext M1.op M2.op (\ n o rho h ->
        TD.pr-inj (ob n) rho (M1.op n o rho h).1 (M2.op n o rho h).1 (pt n o rho h)) ;
  } ;
} ;
