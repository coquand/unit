-- Naming a type with a horn operation. The code at x classifies the
-- type and its horn operation restricted along the Yoneda map of x.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module B = CDUniverseBase[a] ;
module DB = B.DB ;
module C = CDCodeContext[a].C ;
module Y = B.High.GYon[a+] ;
module U1 = B.Univ ;
module W = V[a+] ;
module P = B.P1 ;
module Q = B.Q1 ;
open P.PS ;
open SmallCat[a].Homs[DB.obV, DB.homV] ;

high (G : PCtx) : Q.PS.PCtx = new Q.PS.PCtx[G.ob, G.act, G.act-id, G.act-o] ;

highTy (G : PCtx) (A : PTy[G]) : Q.PS.PTy[high G] =
  new Q.PS.PTy[high G, A.tob, A.tact, A.tact-id, A.tact-o] ;

highSub (D G : PCtx) (s : PSub[D, G]) : Q.PS.PSub[high D, high G] =
  new Q.PS.PSub[high D, high G, s.nt, s.nt-nat] ;

Op (G : PCtx) (A : PTy[G]) : U a++ = B.Cl.Cl (high G) (highTy G A) ;
Fib (G : PCtx) (A : PTy[G]) : U a++ = DB.CLine[a+].Lines[G, A].Fib ;

horn (G : PCtx) (A : PTy[G]) (c : Fib G A) : Op G A =
  \ i -> CDeltaRetr[a, a+].fibToHorn G A c i.1 i.2 ;

module Naming (G : PCtx) (A : PTy[G]) (h : Op G A) {
  module S = Q.PS ;
  A1 : S.PTy[high G] = highTy G A ;

  Local (X : Nat) : U a++ = S.PSub[Y.yP X, high G] ;

  loc (X : Nat) (x : W.Ix (G.ob X)) : Local X = Y.yPt (high G) X x ;

  code (X : Nat) (s : Local X) : U1.U0 X =
    (S.subTy (Y.yP X) (high G) A1 s, B.Cl.clSub (Y.yP X) (high G) s A1 h) ;

  loc-nat (J I : Nat) (f : Hom J I) (x : W.Ix (G.ob I))
    : Id (Local J) (loc J (G.act J I f x)) (S.oS (Y.yP J) (Y.yP I) (high G) (loc I x) (Y.yH J I f)) =
    S.sub-ext (Y.yP J) (high G) _ _ (\ K g -> symH (G.act-o K J I f g x)) ;

  nat (J I : Nat) (f : Hom J I) (x : W.Ix (G.ob I))
    : Id (U1.U0 J) (code J (loc J (G.act J I f x))) (U1.uAct J I f (code I (loc I x))) =
    transH (apH (code J) (loc-nat J I f x))
      (B.Cl.clSub-o (Y.yP J) (Y.yP I) (high G) (loc I x) (Y.yH J I f) A1 h) ;

  name : C.C.Ty G = (\ I x -> code I (loc I x), nat) ;

  opaque nat ;
} ;

name (G : PCtx) (A : PTy[G]) (c : Fib G A) : C.C.Ty G = Naming[G, A, horn G A c].name ;

import CDNameSub ;
import CDNameDecode ;
