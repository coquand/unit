-- CDeltaId.seg (L8, Delta): Swan's identity type for the simplicial model
-- (model.tex §9.1), constructive (outside CClassical).  Decidable sieves
-- have dependent conjunction (CSieve.DConjS), so Id(a , b) is fibrant,
-- equivalent to the path type, and has J with its computation rule.  At
-- levels a and a+.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module DBm = CDeltaBase[a] ;
module DB = DBm.DB ;
module W0 = V[a] ;

module DSm = CSieve[a].DConjS[W0.natV, \ n m -> homV (lin n) (lin m), \ n -> idH (lin n),
  \ X Y Z g f -> compH (lin X) (lin Y) (lin Z) g f, \ L K J I f g h -> comp-assoc (lin L) (lin K) (lin J) (lin I) f g h,
  \ J I f -> comp-idl (lin J) (lin I) f, \ J I f -> comp-idr (lin J) (lin I) f] ;

dc : DB.CId[a].DConj = new DB.CId[a].DConj[DSm.dconj, DSm.dc-in, DSm.dc-out] ;
dc1 : DB.CId[a+].DConj = new DB.CId[a+].DConj[DSm.dconj, DSm.dc-in, DSm.dc-out] ;

module IdA (G : DB.GPre[a].PS.PCtx) (A : DB.GPre[a].PS.PTy[G]) (a0 b0 : DB.GPre[a].PS.PEl[G, A]) {
  module IFb = DB.CIdFib[a].IdFib[G, A, a0, b0] ;
  module IEq = DB.CIdEquiv[a].IdEquiv[G, A, a0, b0] ;

  -- Id(a , b) is fibrant
  fib (fA : DB.CLine[a].Lines[G, A].Fib) : DB.CLine[a].Lines[G, IFb.IdT].Fib = IFb.fib fA dc ;

  -- the projection to the path type is an equivalence
  equiv (fA : DB.CLine[a].Lines[G, A].Fib)
    : DB.CEquiv[a].EquivOp G IFb.IdT IEq.PF.PathT
        DB.CId[a].IdOver[G, G, A, IEq.PF.s, IEq.PF.sN, IEq.PF.PE.aE, IEq.PF.PE.bE, IEq.PF.PE.aE-act, IEq.PF.PE.bE-act].proj =
    IEq.equiv fA dc ;
} ;

-- J, with J d (x , a x , refl) = d x
module JA (G : DB.GPre[a].PS.PCtx) (A : DB.GPre[a].PS.PTy[G]) (a0 : DB.GPre[a].PS.PEl[G, A]) {
  module IJ = DB.CIdJ[a].IJ[G, A, a0] ;

  J (C : DB.GPre[a].PS.PTy[IJ.D]) (cC : DB.CLine[a].Lines[IJ.D, C].CompK[e0, e1].Comp)
    (d : DB.GPre[a].PS.PEl[G, DB.GPre[a].PS.subTy G IJ.D C IJ.c]) : DB.GPre[a].PS.PEl[IJ.D, C] = IJ.JJ[C, cC, d].J ;

  beta (C : DB.GPre[a].PS.PTy[IJ.D]) (cC : DB.CLine[a].Lines[IJ.D, C].CompK[e0, e1].Comp)
    (d : DB.GPre[a].PS.PEl[G, DB.GPre[a].PS.subTy G IJ.D C IJ.c]) (X : Nat) (x : W0.Ix (G.ob X))
    : Id (W0.Ix (C.tob X (IJ.c.nt X x))) ((J C cC d).eob X (IJ.c.nt X x)) (d.eob X x) = IJ.JJ[C, cC, d].beta X x ;
} ;
