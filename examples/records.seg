-- records.seg: a record comes with its constructor.
-- record M (params) { fields .. }  gives
--   mkM (params) (fields) : M[params] = new M[params, fields]
-- one occurrence of `new`, so elements built by mkM compare by name.

level a ;
data N = zero | suc (n : N) ;

record Pt (A : U a) {
  px : A ;
  py : A ;
  sum (f : A -> A -> A) : A = f px py ;     -- a member
} ;

p0 : Pt[N] = mkPt N zero (suc zero) ;
#normal p0.py ;
#conv p0.sum (\ x y -> y) = suc zero ;
-- two uses of mkPt with convertible fields are equal (by name, same occurrence)
one : N = suc zero ;
#conv p0 = mkPt N zero one ;
-- new is the constructor: two constructions with equal arguments are equal
eNew : Id (Pt[N]) (new Pt[N, zero, zero]) (mkPt N zero zero) = refl (mkPt N zero zero) ;

-- fields with telescopes become Pi-typed arguments; dependent fields
record Fam (A : U a) {
  F : A -> U a ;
  pick (x : A) : F x ;
  fst-of (x : A) : F x = pick x ;
} ;
fN : Fam[N] = mkFam N (\ n -> N) (\ n -> suc n) ;
#normal fN.fst-of zero ;

-- a user definition of mkM wins
record Box2 (A : U a) { b1 : A ; } ;
mkBox2 (A : U a) (x : A) : Box2[A] = new Box2[A, x] ;
#normal (mkBox2 N zero).b1 ;

-- no constructor when a field type mentions a member defined in the body
record Dep (A : U a) { d0 : A ; T : U a = Id A d0 d0 ; d1 : T ; } ;
#fails { k : Dep[N] = mkDep N zero (refl zero) ; } ;
