-- closures are compared by what their bodies mean, never by text alone
data N = zero | suc (n : N) ;

#fails { bad : Id (N -> N)
  (let { k : N = zero ; } in \ x -> k)
  (let { k : N = suc zero ; } in \ x -> k)
 = refl (let { k : N = zero ; } in \ x -> k) ; } ;

module A { f : N = zero ; g : N -> N = \ x -> f ; } ;
module B { f : N = suc zero ; g : N -> N = \ x -> f ; } ;
#fails { bad2 : Id (N -> N) A.g B.g = refl A.g ; } ;

-- the same closure, reached twice, is equal to itself
module M (n : N) { h : N -> N = \ x -> n ; } ;
module M1 = M[zero] ;
good : Id (N -> N) (M[zero].h) (M1.h) = refl M1.h ;
