-- unfilled.seg: holes left by a failed filling pass (PRIMREC.md 12).
-- EXPECTED: k and j fail (their hidden argument cannot be inferred); k2
-- and j2 check (the hole is not used); the #fails is an INTERNAL ERROR, not
-- "#fails ok": comparing suc _ with suc zero uses the unfilled hole, which
-- is never equal to anything.

level a ;
data N = zero | suc (n : N) ;
k : N = (\ x -> zero) _ ;
k2 : Id N k zero = refl zero ;
j : N = suc _ ;
j2 : Id N j j = refl j ;
#fails { j3 : Id N j (suc zero) = refl j ; } ;
