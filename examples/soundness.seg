-- soundness.seg: three holes, closed (2026-11-01).
--
-- 1. A constraint of a module is a hypothesis of its body: its members
--    have guarded types [psi]A, used at A only where psi is valid (guard
--    beta, bcde.pdf Fig. 13).  A module without parameters is used bare,
--    so psi is checked at each use.  Without it, M and Q below, each
--    loop-free, gave  U b : U b  in a loop-free context, and Hurkens'
--    paradox an element of Empty.
-- 2. Strict positivity is checked on the program as written; a hidden
--    argument of a constructor field solved by the data type itself is an
--    occurrence it did not see, and is rejected when filled.

level a b ;
data Empty = ;

module M { constraint b < a ; up : U a = U b ; } ;
module Q { constraint a <= b ; coe (X : U a) : U b = X ; } ;
#fails { Uu : U b = Q.coe M.up ; } ;

-- through nesting, through open, and through a submodule
module P (c : Level) { module K { constraint c+ < c ; bad : U c = U c ; } ; } ;
#fails { x : U a = P[a].K.bad ; } ;
#fails { open M ; y : U a = up ; } ;
module R { constraint b < a ; module S { s : U a = U b ; } ; } ;
#fails { z : U a = R.S.s ; } ;

-- where the constraint holds, the module is used
module Lt { constraint b < a ; module In { constraint b < a ; up : U a = U b ; } ; ok : U a = In.up ; } ;

-- a hidden argument hiding a negative occurrence
H {A : U a} (y : A) : U a = A -> Empty ;
#fails { data E : U a = c (x : E) (f : H x) ; } ;
-- written out, the occurrence is seen by the positivity check
#fails { data E : U a = c (x : E) (f : H {E} x) ; } ;

-- hidden arguments solved by the data type outside its fields are fine
idf {A : U a} (x : A) : A = x ;
data N : U a = z | s (n : N) ;
two : N = idf (s (s z)) ;

-- 3. Positivity is checked in the arguments of instances and in the terms
--    of directives too: a let with a negative data type, passed through
--    a module argument, gave an element of Empty.
module Box (A : U a) (a0 : A) { val : A = a0 ; } ;
#fails {
  module B = Box[Empty, let { data D : U a = roll (k : D -> Empty) ;
                              out : D -> Empty = split { roll k -> k (roll k) } ; }
                        in out (roll out)] ;
  false : Empty = B.val ;
} ;
#fails { open Box[Empty, let { data D : U a = roll (k : D -> Empty) ;
                               out : D -> Empty = split { roll k -> k (roll k) } ; }
                         in out (roll out)] ; } ;

-- 4. No shadowing for the binders that are not renamed: the parameters
--    of a module or record head, constructor fields and record fields.
--    A head parameter x named like a definition x was evaluated as the
--    definition while it had the parameter's type; a field named like its
--    data type was taken for a recursive field.  Both gave Empty.
data One : U a = tt ;
x : U a = One ;
#fails { module M4 (x : U a) { y : x = tt ; } ; false : Empty = M4[Empty].y ; } ;
#fails { record R4 (x : U a) { u : One ; d : x = tt ; } ; false : Empty = (new R4[Empty, tt]).d ; } ;
#fails { module O4 { w : U a = One ; module M5 (w : U a) { y : w = tt ; } ; } ; } ;
#fails { data D : U a+ = c (D : U a) (y : D) ;
         f : D -> Empty = split { c X y | r -> r } ;
         false : Empty = f (c (Empty -> Empty) (\ e -> e)) ; } ;
#fails { record S4 { x : U a ; v : x } ; } ;
-- renamed binders may reuse a name: they are not shadowing
fx (x : U a) : U a = x ;
gx : U a -> U a = \ x -> x ;

-- 5. Elements of a record compare by the record's name, which includes its
--    module instance: new Mb[true].Rb[tt] and new Mb[false].Rb[tt] were
--    equal.  The filling pass then wrote the fixed value of t.x back as the
--    variable y of the other instance, and the member .d was typed in one
--    instance and computed in the other.
data Bool : U a = true | false ;
module Mb (bb : Bool) {
  record Rb { u : One ; d : (z : Bool) * Id Bool z bb = (bb, refl bb) ; } ;
} ;
record Sb (A : U a) { xb : A ; } ;
Pb : Bool -> U a = split { false -> One ; true -> Empty } ;
#fails {
  g : Sb[Mb[true].Rb, xb := new Mb[true].Rb[tt]] -> Sb[Mb[false].Rb, xb := new Mb[false].Rb[tt]] -> Id Bool false true
    = split { Sb y -> \ t -> t.xb.d.2 } ;
  ft : Id Bool false true = g (new Sb[Mb[true].Rb, new Mb[true].Rb[tt]]) (new Sb[Mb[false].Rb, new Mb[false].Rb[tt]]) ;
  false' : Empty = idJ Bool false (\ z q -> Pb z) tt true ft ;
} ;
-- the two elements are different, and each is equal to itself
#fails { e : Id Mb[true].Rb (new Mb[true].Rb[tt]) (new Mb[false].Rb[tt]) = refl (new Mb[true].Rb[tt]) ; } ;
same : Id Mb[true].Rb (new Mb[true].Rb[tt]) (new Mb[true].Rb[tt]) = refl (new Mb[true].Rb[tt]) ;

-- 6. Data types, records and splits are compared by name; a record body
--    contains none of them (ruling 2026-11-07), at any position.  None of
--    the libraries used them; nested records were already rejected.
#fails { record R6 { x6 : U a ; data B6 : U a = c6 (y : x6) ; } ; } ;
#fails { record R7 { x7 : Bool ; g7 : One -> Bool = split { tt -> x7 } ; } ; } ;
