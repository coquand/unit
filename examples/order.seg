-- two pieces of code with the same text but different occurrences: their
-- environments are compared with their names (the variables differ in order)
data N = zero | suc (n : N) ;
f (x y : N) : N -> N = \ z -> y ;
g (y x : N) : N -> N = \ z -> y ;
#fails { bad : Id (N -> N) (f zero (suc zero)) (g zero (suc zero)) = refl (f zero (suc zero)) ; } ;
ok : Id (N -> N) (f zero (suc zero)) (g (suc zero) zero) = refl (f zero (suc zero)) ;
