-- aliases.seg: two instances of a segment share the id of its members;
-- naming one (for a hidden argument or an eta rewrite) must not pick the
-- other.  seg-60's repro.
level l ;
data Nat = zero | suc (n : Nat) ;
data Bool = true | false ;
module Outer (A : U l) {
  record Side {
    v : A ;
    vv : A = v ;
  } ;
} ;
module Use {
  module ON = Outer[Nat] ;
  module OB = Outer[Bool] ;
  f (s : ON.Side) : Nat = s.vv ;
  g (s : OB.Side) : Bool = s.vv ;
} ;
