level a ;
data N = zero ;
module Outer (k : Level) {
  module P { ob : N -> U k ; } ;
  okHere (G : P) : Id P G G = refl G ;
} ;
module Q = Outer[a] ;
bad1 (G : Q.P) : Id (Q.P) G G = refl G ;
bad2 (G : Outer[a].P) : Id (Outer[a].P) G G = refl G ;
-- through open, and the level of the nested segment follows the instance
open Outer[a] ;
bad3 (G : P) : Id P G G = refl G ;
#type Outer[a].P ;
#type Outer[a+].P ;

-- the universe counts only the fields that are NOT fixed
module Big (k : Level) { X : U k+ ; x : X ; } ;
#type Big[a] ;
#type Big[k := a, X := U a] ;
