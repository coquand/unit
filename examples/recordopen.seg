-- recordopen.seg: open of a module instance inside a record body
-- (RECORDS.md §1).  A scope operation: the opened members keep their
-- identities (Objs[obV].Ob), and at an element their arguments are the
-- element's projections.

level a ;
data N = zero | suc (n : N) ;

module Objs (o : N) {
  Ob : U a = N ;
  pt : Ob = o ;
} ;

record Cat {
  obV : N ;
  open Objs[obV] ;             -- depends on the field obV
  hom : Ob -> Ob -> U a ;      -- a field type through the open
  idm (x : Ob) : hom x x ;
  idm0 : hom pt pt = idm pt ;  -- a derived member through the open
} ;

-- the opened member is Objs[obV].Ob itself, at the element's obV
obIs (c : Cat) : Id (U a) (Objs[c.obV].Ob) (Objs[c.obV].Ob) = refl (Objs[c.obV].Ob) ;
useHom (c : Cat) (x : Objs[c.obV].Ob) : U a = c.hom x x ;
useIdm (c : Cat) (x : Objs[c.obV].Ob) : c.hom x x = c.idm x ;
idm0Is (c : Cat) : Id (c.hom (Objs[c.obV].pt) (Objs[c.obV].pt)) c.idm0 (c.idm (Objs[c.obV].pt)) =
  refl (c.idm (Objs[c.obV].pt)) ;
-- on a neutral application too
idm0App (S : N -> Cat) : Id ((S zero).hom (Objs[(S zero).obV].pt) (Objs[(S zero).obV].pt))
                            (S zero).idm0 ((S zero).idm (Objs[(S zero).obV].pt)) =
  refl ((S zero).idm (Objs[(S zero).obV].pt)) ;

-- an element built with new
idN (x y : N) : U a = Id N x y ;
c1 : Cat = new Cat[suc zero, idN, \ x -> refl x] ;
#conv c1.idm0 = refl (suc zero) ;

-- the opened names are in scope only in the record body
#fails { outside : U a = Ob ; } ;
-- the normal scope checks: a field may not reuse a variable's name
#fails { record Bad (obV : N) { obV : N ; } ; } ;

-- with Ob and pt locked, types still match by identity, never by unfolding
opaque Objs.Ob ;
opaque Objs.pt ;
useHomL (c : Cat) (x : Objs[c.obV].Ob) : U a = c.hom x x ;
idm0L (c : Cat) : Id (c.hom (Objs[c.obV].pt) (Objs[c.obV].pt)) c.idm0 (c.idm (Objs[c.obV].pt)) =
  refl (c.idm (Objs[c.obV].pt)) ;
-- a different obV is a different Ob
#fails { otherOb (c : Cat) (x : Objs[zero].Ob) : U a = c.hom x x ; } ;
-- locked, Ob is not N
#fails { notN (c : Cat) (x : N) : U a = c.hom x x ; } ;
