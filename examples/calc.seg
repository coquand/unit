-- calc.seg: equational chains.  calc A { a0 =< p1 > a1 =< p2 > a2 .. }
-- writes every point once; step i is checked against Id A a(i-1) ai,
-- and the chain is Prelude's trans, right nested:  trans p1 (trans p2 ..).

level a ;
data N = zero | suc (n : N) ;

trans (A : U a) (x y z : A) (p : Id A x y) (q : Id A y z) : Id A x z =
  idJ A y (\ w r -> Id A x w) p z q ;

ap (A B : U a) (f : A -> B) (x y : A) (p : Id A x y) : Id B (f x) (f y) =
  idJ A x (\ z q -> Id B (f x) (f z)) (refl (f x)) y p ;

-- the chain is definitionally the nested trans
ch3 (A : U a) (x y z w : A) (p : Id A x y) (q : Id A y z) (r : Id A z w)
  : Id A x w =
  calc A { x =< p > y =< q > z =< r > w } ;
ch3-def (A : U a) (x y z w : A) (p : Id A x y) (q : Id A y z) (r : Id A z w)
  : Id (Id A x w) (ch3 A x y z w p q r) (trans A x y w p (trans A y z w q r)) =
  refl (ch3 A x y z w p q r) ;

-- points may be any expressions; a variable named w is not captured
apSuc (x y w : N) (p : Id N x y) (q : Id N y w) : Id N (suc x) (suc w) =
  calc N { suc x =< ap N N (\ n -> suc n) x y p > suc y
                 =< ap N N (\ n -> suc n) y w q > suc w } ;

one : N = suc zero ;
#normal calc N { one =< refl one > one =< refl one > one } ;
#conv calc N { one =< refl one > suc zero } = refl one ;

-- a wrong intermediate point is caught at its step
#fails { bad (x y : N) (p : Id N x y) : Id N x y = calc N { x =< p > x =< refl x > y } ; } ;
#fails { bad2 (x y : N) (p : Id N x y) : Id N x x = calc N { x =< p > y } ; } ;
