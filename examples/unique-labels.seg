-- Record labels must be unique: struct checking binds fields in order,
-- whereas projection finds a field by name. Repeating T used to let
-- construction use the later T and projection the earlier one, deriving
-- Empty without assumptions. Reject repetitions before elaboration.
-- Splits likewise need unique labels: lookup otherwise leaves later
-- branches unchecked. Constructor and pattern labels are checked too.
level a ;
data N = z | s (n : N) ;
data Empty = ;

#fails {
 R : U a+ = sig { T : U a ; T : U a ; value : T } ;
 r : R = struct { T = Empty ; T = N ; value = z } ;
 contradiction : Empty = r.value ;
} ;
#fails { R : U a+ = sig { T : U a ; extra : N ; T : U a ; value : T } ; } ;
#fails { R : U a+ = sig { inner : sig { T : U a ; T : U a } } ; } ;
#fails { R : U a+ = let { S : U a+ = sig { T : U a ; T : U a } ; } in S ; } ;

-- Reusing a label in separate records is valid.
R : U a+ = sig { T : U a ; value : T } ;
S : U a+ = sig { T : U a ; value : T } ;
r : R = struct { T = N ; value = z } ;
#conv r.value = z ;
#fails { bad : R = struct { T = N ; T = N ; value = z } ; } ;

-- Even an ill-typed repeated branch used to be silently accepted.
#fails { f : N -> N = split { z -> z ; z -> Empty ; s n -> n } ; } ;
#fails { data Bad = c | c (n : N) ; } ;
data Pair = pair (x : N) (y : N) ;
#fails { f : Pair -> N = split { pair x x -> x } ; } ;
#fails { f : N -> N = split { z -> z ; s n | n -> n } ; } ;
fstPair : Pair -> N = split { pair x y -> x } ;
#conv fstPair (pair z (s z)) = z ;
ignorePair : Pair -> N = split { pair _ _ -> z } ;
#conv ignorePair (pair z (s z)) = z ;
