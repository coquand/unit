-- declarations.seg: files, modules and records are lists of declarations
-- (doc/declarations.pdf).  No data types and no split.
level a ;

-- definitions
idf (X : U a) (x : X) : X = x ;
comp (X : U a) (f g : X -> X) : X -> X = \ x -> f (g x) ;

-- a module: a declaration without body is a parameter
module Monoid {
  M : U a ;
  e : M ;
  op : M -> M -> M ;
  sq (x : M) : M = op x x ;
} ;

-- the same module with its first parameters in the head
module Monoid' (M : U a) (e : M) { op : M -> M -> M ; sq (x : M) : M = op x x ; } ;

-- an instance gives a value to every parameter, in order, possibly named
module End (X : U a) {
  module E = Monoid[X -> X, idf X, comp X] ;
  sq2 (f : X -> X) : X -> X = E.sq f ;
  sq3 (f : X -> X) : X -> X = Monoid[M := X -> X, e := idf X, op := comp X].sq f ;
  sq4 (f : X -> X) : X -> X = Monoid'[X -> X, idf X, comp X].sq f ;
} ;
sqEnd (X : U a) (f : X -> X) : X -> X = End[X].sq3 f ;
#normal sqEnd ;
-- the instances agree: the members are the same definition, with the same arguments
agree (X : U a) : Id ((X -> X) -> X -> X) End[X].sq2 End[X].sq3 = refl End[X].sq2 ;

-- a record: a declaration without body is a field
record Mon { M : U a ; e : M ; op : M -> M -> M ; sq (x : M) : M = op x x ; } ;

-- a record type gives values to some declarations, an element to all
EndMon (X : U a) : Mon[M := X -> X] = new Mon[X -> X, idf X, comp X] ;
square (X : U a) (f : X -> X) : X -> X = (EndMon X).sq f ;
#normal square ;
-- a fixed field computes at its type
fixedM (X : U a) (m : Mon[M := X -> X]) : Id (U a) m.M (X -> X) = refl (X -> X) ;
-- a field that is not fixed does not
#fails { notFixed (X : U a) (m : Mon) : Id (U a) m.M (X -> X) = refl (X -> X) ; } ;

-- values in order go to the first declarations without value
record Pair { X : U a ; x : X ; y : X ; } ;
record Pt { X : U a ; x : X ; y : X ; swap : Pair[X] = new Pair[X, y, x] ; } ;
same-type (X : U a) : Id (U a) Pair[X] Pair[X := X] = refl Pair[X] ;
p0 (X : U a) (u v : X) : Pt[X] = new Pt[X, u, v] ;
swapY (X : U a) (u v : X) : Id X (p0 X u v).swap.y u = refl u ;
-- equality of records is by name: Pair[X] and Pt[X] are different types
#fails { same (X : U a) (u v : X) : Pair[X] = p0 X u v ; } ;

-- a type with arguments: a definition whose value fixes fields
record IsEquiv { A : U a ; B : U a ; f : A -> B ;
                 sec : B -> A ; sec-eq : (b : B) -> Id B (f (sec b)) b ;
                 ret : B -> A ; ret-eq : (x : A) -> Id A (ret (f x)) x ; } ;
isEquiv (A B : U a) (f : A -> B) : U a = IsEquiv[A, B, f] ;
idEquiv (A : U a) : isEquiv A A (idf A) =
  new IsEquiv[A, A, idf A, sec := idf A, sec-eq := \ b -> refl b, ret := idf A, ret-eq := \ x -> refl x] ;

-- locks are declarations: from here on, sq is used without its value
opaque Monoid.sq ;
#fails { unfolds (X : U a) (f : X -> X) : Id (X -> X) (End[X].sq3 f) (comp X f f) = refl (comp X f f) ; } ;
-- still equal by name: the same declaration with the same values
byName (X : U a) (f : X -> X) : Id (X -> X) (End[X].sq2 f) (End[X].sq3 f) = refl (End[X].sq2 f) ;
transparent Monoid.sq ;
unfolds (X : U a) (f : X -> X) : Id (X -> X) (End[X].sq3 f) (comp X f f) = refl (comp X f f) ;
