-- frege.seg: the first lemmas of Frege's Begriffsschrift (1879) on the
-- transitive closure of a relation, as in Coquand, "Some remarks about
-- dependent type theory", Section 2.4.3.  The context of the lemmas
-- (a type A and a relation R) is a segment; the lemmas are checked once,
-- under it, and each instance only checks its arguments.

level a ;

module Frege (A : U a) (R : A -> A -> U a) {
  -- P is hereditary for R
  her : [b] (A -> U b) -> U (a \/ b) =
    <b> \ P -> (x : A) -> P x -> (y : A) -> R x y -> P y ;
  -- the transitive closure: y has every hereditary property of the
  -- successors of x
  Rplus (x y : A) : U (a+) =
    (P : A -> U a) -> her @a P -> ((z : A) -> R x z -> P z) -> P y ;
  -- the closure of x is hereditary (here at level a+)
  lem1 (x : A) : her @(a+) (Rplus x) =
    \ y h1 z h2 P h3 h4 -> h3 y (h1 P h3 h4) z h2 ;
  -- the definition of hereditary, used as a rule (stated once)
  her-step (P : A -> U (a+)) (hP : her @(a+) P) (x : A) (px : P x) (y : A) (r : R x y) : P y =
    hP x px y r ;
  -- transitivity.  Frege's proof takes P := Rplus x, an impredicative
  -- instance (Rplus x is in U (a+), not in U a); here P stays the given
  -- predicate and lem1 is used at the instance (x, y, h1)
  lem2 (x y z : A) (h1 : Rplus x y) (h2 : Rplus y z) : Rplus x z =
    \ P h3 h4 -> h2 P h3 (\ u r -> her-step (Rplus x) (lem1 x) y h1 u r P h3 h4) ;
  -- lem2 used twice, in different contexts
  lem3 (x y z w : A) (h1 : Rplus x y) (h2 : Rplus y z) (h3 : Rplus z w) : Rplus x w =
    lem2 x z w (lem2 x y z h1 h2) h3 ;
  -- a step of R is a step of the closure
  base (x y : A) (r : R x y) : Rplus x y = \ P h3 h4 -> h4 y r ;
} ;

-- an instance: the successor relation on N
data N = zero | suc (n : N) ;
Succ (x y : N) : U a = Id N (suc x) y ;
module FS = Frege[N, Succ] ;

one : N = suc zero ;
two : N = suc one ;
three : N = suc two ;

-- through the lemmas: nothing of Frege is opened
zero-three : FS.Rplus zero three =
  FS.lem3 zero one two three (FS.base zero one (refl one))
    (FS.base one two (refl two)) (FS.base two three (refl three)) ;

-- directly: Rplus must be opened to see that this is a function
zero-two : FS.Rplus zero two =
  \ P h3 h4 -> h3 one (h4 one (refl one)) two (refl two) ;
