-- Definitions in a module head: module M (x : A) (y : B = e) (z : C) { .. }
-- is module M (x : A) { y : B = e ; z : C ; .. }.  M has the parameters
-- A and f; B is a member.
level a ;
data N = zero | suc (n : N) ;
module M (A : U a) (B : U a = A -> A) (f : B) { twice (x : A) : A = f (f x) ; } ;
two : N = M[N, \ x -> suc x].twice zero ;
#normal two ;
#normal M[N, \ x -> suc x].B ;
#fails { bad : N = M[N, N -> N, \ x -> suc x].twice zero ; } ;
#fails { bad2 : N = M[N, zero].twice zero ; } ;
