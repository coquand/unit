-- Example4Run.seg: the evaluator halts on Example 4 of henderson.pdf with
-- (QUOTE 1).
--
-- Example4.seg proves that alpha has type at 1 in the initial memory mu,
-- hence that a run ending with a QUOTE ends with (QUOTE 1).  Here is the
-- run: a derivation example4-run : Ev mu 0 h21 with h21 0 = (QUOTE 1).  It
-- follows the paper's demand order.  (CAR (CDR (INTS 0))) forces the CDR,
-- which forces (INTS 0) to a CONS (the first round of INTEGERS), then its
-- tail (INTEGERS (PLUS I 1)) to a CONS (the second round); CAR then forces
-- the head of that second CONS, I = (PLUS I 1) with I = 0, which is 1.
-- The first head and the second tail are never evaluated, and the LABEL
-- is unfolded once, into a FUNARG cell (18) whose alist points to itself.
--
-- The memories h1 .. h21 are written in the form the rules of Ev give
-- them; h0a .. h14a are the memories after the allocations of [Fc]/[Fd].
-- Allocation is always at the first free address, and its freshness
-- (Funarg.Fresh) comes from the bound of Bound.seg: the initial memory is
-- bounded by 17, and each rewrite writes cells whose components are below
-- the current bound.  Every equation on cells holds by computation.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Syntax[l] ; open Funarg[l] ; open Eval[l] ;
open Bound[l] ; open Example4[l] ;

n17 : Nat = suc n16 ; n18 : Nat = suc n17 ; n19 : Nat = suc n18 ; n20 : Nat = suc n19 ;
n21 : Nat = suc n20 ; n22 : Nat = suc n21 ; n23 : Nat = suc n22 ; n24 : Nat = suc n23 ;
n25 : Nat = suc n24 ; n26 : Nat = suc n25 ; n27 : Nat = suc n26 ; n28 : Nat = suc n27 ;
n29 : Nat = suc n28 ; n30 : Nat = suc n29 ;

------------------------------------------------------------------------
-- allocation of one and of two cells at the bound

alloc1 (N : Nat) (m : Nat -> Cell) (b : Bounded N m) (q : Nat) (th : Alist) :
    Allocs m (upd m N (efunarg q th)) =
  al-cons m (upd m N (efunarg q th)) N q th (bounded-fresh N m b) (al-nil (upd m N (efunarg q th))) ;

alloc2 (N : Nat) (m : Nat -> Cell) (b : Bounded N m) (q1 q2 : Nat) (th : Alist) (h1 : IsT (below N (efunarg q1 th))) :
    Allocs m (upd (upd m N (efunarg q1 th)) (suc N) (efunarg q2 th)) =
  al-cons m (upd (upd m N (efunarg q1 th)) (suc N) (efunarg q2 th)) N q1 th (bounded-fresh N m b)
    (alloc1 (suc N) (upd m N (efunarg q1 th)) (bounded-alloc N m (efunarg q1 th) b h1) q2 th) ;

bound2 (N : Nat) (m : Nat -> Cell) (b : Bounded N m) (q1 q2 : Nat) (th : Alist)
    (h1 : IsT (below N (efunarg q1 th))) (h2 : IsT (below (suc N) (efunarg q2 th))) :
    Bounded (suc (suc N)) (upd (upd m N (efunarg q1 th)) (suc N) (efunarg q2 th)) =
  bounded-alloc (suc N) (upd m N (efunarg q1 th)) (efunarg q2 th) (bounded-alloc N m (efunarg q1 th) b h1) h2 ;

------------------------------------------------------------------------
-- the alists: INTS bound to the LABEL, INTEGERS to itself, then I bound
-- to the argument of the first and of the second call

th0 : Alist = acons INTS n18 anil ;
th1 : Alist = acons INTEGERS n18 anil ;
th2 : Alist = acons I n22 th1 ;
th3 : Alist = acons I n26 th1 ;

------------------------------------------------------------------------
-- the memories, with their bounds where an allocation follows

b0 : Bounded n17 mu = bounded-list cells0 tt ;
h0a : Nat -> Cell = upd (upd mu n17 (efunarg n2 anil)) n18 (efunarg n3 anil) ;
h1 : Nat -> Cell = upd h0a zero (eapp n17 n18) ;
h2 : Nat -> Cell = upd h1 zero (efunarg n4 th0) ;
b2 : Bounded n19 h2 =
  bounded-upd n19 h1 zero (efunarg n4 th0)
    (bounded-upd n19 h0a zero (eapp n17 n18) (bound2 n17 mu b0 n2 n3 anil tt tt) tt tt) tt tt ;
h2a : Nat -> Cell = upd h2 n19 (efunarg n5 th0) ;
h3 : Nat -> Cell = upd h2a zero (ecar n19) ;
b3 : Bounded n20 h3 = bounded-upd n20 h2a zero (ecar n19) (bounded-alloc n19 h2 (efunarg n5 th0) b2 tt) tt tt ;
h3a : Nat -> Cell = upd h3 n20 (efunarg n6 th0) ;
h4 : Nat -> Cell = upd h3a n19 (ecdr n20) ;
b4 : Bounded n21 h4 = bounded-upd n21 h3a n19 (ecdr n20) (bounded-alloc n20 h3 (efunarg n6 th0) b3 tt) tt tt ;
h4a : Nat -> Cell = upd (upd h4 n21 (efunarg n7 th0)) n22 (efunarg n8 th0) ;
h5 : Nat -> Cell = upd h4a n20 (eapp n21 n22) ;
h6 : Nat -> Cell = upd h5 n18 (efunarg n9 th1) ;
h7 : Nat -> Cell = upd h6 n21 (h6 n18) ;
h8 : Nat -> Cell = upd h7 n20 (efunarg n10 th2) ;
b8 : Bounded n23 h8 =
  bounded-upd n23 h7 n20 (efunarg n10 th2)
   (bounded-upd n23 h6 n21 (h6 n18)
    (bounded-upd n23 h5 n18 (efunarg n9 th1)
     (bounded-upd n23 h4a n20 (eapp n21 n22) (bound2 n21 h4 b4 n7 n8 th0 tt tt) tt tt) tt tt) tt tt) tt tt ;
h8a : Nat -> Cell = upd (upd h8 n23 (efunarg n11 th2)) n24 (efunarg n12 th2) ;
h9 : Nat -> Cell = upd h8a n20 (econs n23 n24) ;
b9 : Bounded n25 h9 = bounded-upd n25 h8a n20 (econs n23 n24) (bound2 n23 h8 b8 n11 n12 th2 tt tt) tt tt ;
h9a : Nat -> Cell = upd (upd h9 n25 (efunarg n13 th2)) n26 (efunarg n14 th2) ;
h10 : Nat -> Cell = upd h9a n24 (eapp n25 n26) ;
h11 : Nat -> Cell = upd h10 n25 (h10 n18) ;
h12 : Nat -> Cell = upd h11 n24 (efunarg n10 th3) ;
b12 : Bounded n27 h12 =
  bounded-upd n27 h11 n24 (efunarg n10 th3)
   (bounded-upd n27 h10 n25 (h10 n18)
    (bounded-upd n27 h9a n24 (eapp n25 n26) (bound2 n25 h9 b9 n13 n14 th2 tt tt) tt tt) tt tt) tt tt ;
h12a : Nat -> Cell = upd (upd h12 n27 (efunarg n11 th3)) n28 (efunarg n12 th3) ;
h13 : Nat -> Cell = upd h12a n24 (econs n27 n28) ;
h14 : Nat -> Cell = upd h13 n19 (h13 n24) ;
b14 : Bounded n29 h14 =
  bounded-upd n29 h13 n19 (h13 n24)
   (bounded-upd n29 h12a n24 (econs n27 n28) (bound2 n27 h12 b12 n11 n12 th3 tt tt) tt tt) tt tt ;
h14a : Nat -> Cell = upd (upd h14 n29 (efunarg n15 th2)) n30 (efunarg n16 th2) ;
h15 : Nat -> Cell = upd h14a n26 (eplus n29 n30) ;
h16 : Nat -> Cell = upd h15 n22 (equote (num zero)) ;
h17 : Nat -> Cell = upd h16 n29 (h16 n22) ;
h18 : Nat -> Cell = upd h17 n30 (equote (num n1)) ;
h19 : Nat -> Cell = upd h18 n26 (equote (num (add zero n1))) ;
h20 : Nat -> Cell = upd h19 n27 (h19 n26) ;
h21 : Nat -> Cell = upd h20 zero (h20 n27) ;

------------------------------------------------------------------------
-- the run, from the innermost demands outwards

-- [L]: INTEGERS (cell 18) is unfolded into a closure binding INTEGERS to itself
ev18 : Ev h5 n18 h6 =
  ev-L h5 h6 n18 n3 n9 INTEGERS anil (refl (efunarg n3 anil)) (refl (elabel INTEGERS n9))
    (ev-clo h6 n18 n9 th1 I n10 (refl (efunarg n9 th1)) (refl (elam I n10))) ;

-- [Fa]: INTS in the body is the LABEL
ev21 : Ev h5 n21 h7 =
  ev-Fa h5 h6 n21 n7 n18 INTS th0 (refl (efunarg n7 th0)) (refl (evar INTS)) (lk-here INTS n18 anil) ev18
    (refl (efunarg n7 th0)) (refl (evar INTS)) ;

-- first round: (INTS 0) is (CONS 23 24)
ev20b : Ev h8 n20 h9 =
  ev-F h8 h8a h9 n20 n10 th2 (econs n11 n12) (econs n23 n24) (alloc2 n23 h8 b8 n11 n12 th2 tt)
    (refl (efunarg n10 th2)) (refl (econs n11 n12))
    (ren-cons n11 n12 n23 n24 (refl (efunarg n11 th2), tt) (refl (efunarg n12 th2), tt))
    (ev-cons h9 n20 n23 n24 (refl (econs n23 n24))) ;

ev20g : Ev h5 n20 h9 =
  ev-G h5 h7 h9 n20 n21 n22 n9 n10 I th1 (refl (eapp n21 n22)) ev21 (refl (efunarg n9 th1)) (refl (elam I n10))
    (refl (eapp n21 n22)) ev20b ;

ev20 : Ev h4 n20 h9 =
  ev-F h4 h4a h9 n20 n6 th0 (eapp n7 n8) (eapp n21 n22) (alloc2 n21 h4 b4 n7 n8 th0 tt)
    (refl (efunarg n6 th0)) (refl (eapp n7 n8))
    (ren-app n7 n8 n21 n22 (refl (efunarg n7 th0), tt) (refl (efunarg n8 th0), tt)) ev20g ;

-- second round: the tail (INTEGERS (PLUS I 1)) is (CONS 27 28)
ev25 : Ev h10 n25 h11 =
  ev-Fa h10 h10 n25 n13 n18 INTEGERS th2 (refl (efunarg n13 th2)) (refl (evar INTEGERS))
    (lk-there I n22 th1 INTEGERS n18 tt (lk-here INTEGERS n18 anil))
    (ev-clo h10 n18 n9 th1 I n10 (refl (efunarg n9 th1)) (refl (elam I n10)))
    (refl (efunarg n13 th2)) (refl (evar INTEGERS)) ;

ev24b : Ev h12 n24 h13 =
  ev-F h12 h12a h13 n24 n10 th3 (econs n11 n12) (econs n27 n28) (alloc2 n27 h12 b12 n11 n12 th3 tt)
    (refl (efunarg n10 th3)) (refl (econs n11 n12))
    (ren-cons n11 n12 n27 n28 (refl (efunarg n11 th3), tt) (refl (efunarg n12 th3), tt))
    (ev-cons h13 n24 n27 n28 (refl (econs n27 n28))) ;

ev24g : Ev h10 n24 h13 =
  ev-G h10 h11 h13 n24 n25 n26 n9 n10 I th1 (refl (eapp n25 n26)) ev25 (refl (efunarg n9 th1)) (refl (elam I n10))
    (refl (eapp n25 n26)) ev24b ;

ev24 : Ev h9 n24 h13 =
  ev-F h9 h9a h13 n24 n12 th2 (eapp n13 n14) (eapp n25 n26) (alloc2 n25 h9 b9 n13 n14 th2 tt)
    (refl (efunarg n12 th2)) (refl (eapp n13 n14))
    (ren-app n13 n14 n25 n26 (refl (efunarg n13 th2), tt) (refl (efunarg n14 th2), tt)) ev24g ;

-- (CDR (INTS 0)) is the second CONS
ev19c : Ev h4 n19 h14 =
  ev-cdr h4 h9 h13 n19 n20 n23 n24 (refl (ecdr n20)) ev20 (refl (econs n23 n24)) ev24
    (refl (ecdr n20)) (refl (econs n23 n24)) ;

ev19 : Ev h3 n19 h14 =
  ev-F h3 h3a h14 n19 n5 th0 (ecdr n6) (ecdr n20) (alloc1 n20 h3 b3 n6 th0)
    (refl (efunarg n5 th0)) (refl (ecdr n6)) (ren-cdr n6 n20 (refl (efunarg n6 th0), tt)) ev19c ;

-- the head of the second CONS: I + 1 with I = 0
ev22 : Ev h15 n22 h16 =
  ev-Fb h15 n22 n8 th0 (num zero) (refl (efunarg n8 th0)) (refl (equote (num zero))) ;

ev29 : Ev h15 n29 h17 =
  ev-Fa h15 h16 n29 n15 n22 I th2 (refl (efunarg n15 th2)) (refl (evar I)) (lk-here I n22 th1) ev22
    (refl (efunarg n15 th2)) (refl (evar I)) ;

ev30 : Ev h17 n30 h18 =
  ev-Fb h17 n30 n16 th2 (num n1) (refl (efunarg n16 th2)) (refl (equote (num n1))) ;

ev26p : Ev h15 n26 h19 =
  ev-plus h15 h17 h18 n26 n29 n30 zero n1 (refl (eplus n29 n30)) ev29 ev30
    (refl (equote (num zero))) (refl (equote (num n1))) (refl (eplus n29 n30)) ;

ev26 : Ev h14 n26 h19 =
  ev-F h14 h14a h19 n26 n14 th2 (eplus n15 n16) (eplus n29 n30) (alloc2 n29 h14 b14 n15 n16 th2 tt)
    (refl (efunarg n14 th2)) (refl (eplus n15 n16))
    (ren-plus n15 n16 n29 n30 (refl (efunarg n15 th2), tt) (refl (efunarg n16 th2), tt)) ev26p ;

ev27 : Ev h14 n27 h20 =
  ev-Fa h14 h19 n27 n11 n26 I th3 (refl (efunarg n11 th3)) (refl (evar I)) (lk-here I n26 th1) ev26
    (refl (efunarg n11 th3)) (refl (evar I)) ;

-- the body (CAR (CDR (INTS 0)))
ev0c : Ev h3 zero h21 =
  ev-car h3 h14 h20 zero n19 n27 n28 (refl (ecar n19)) ev19 (refl (econs n27 n28)) ev27
    (refl (ecar n19)) (refl (econs n27 n28)) ;

ev0b : Ev h2 zero h21 =
  ev-F h2 h2a h21 zero n4 th0 (ecar n5) (ecar n19) (alloc1 n19 h2 b2 n5 th0)
    (refl (efunarg n4 th0)) (refl (ecar n5)) (ren-car n5 n19 (refl (efunarg n5 th0), tt)) ev0c ;

-- [G]: the LAMBDA applied to the LABEL
ev0g : Ev h1 zero h21 =
  ev-G h1 h1 h21 zero n17 n18 n2 n4 INTS anil (refl (eapp n17 n18))
    (ev-clo h1 n17 n2 anil INTS n4 (refl (efunarg n2 anil)) (refl (elam INTS n4)))
    (refl (efunarg n2 anil)) (refl (elam INTS n4)) (refl (eapp n17 n18)) ev0b ;

-- [Fc]: alpha = (FUNARG (2 3) <empty>)
example4-run : Ev mu zero h21 =
  ev-F mu h0a h21 zero n1 anil (eapp n2 n3) (eapp n17 n18) (alloc2 n17 mu b0 n2 n3 anil tt)
    (refl (efunarg n1 anil)) (refl (eapp n2 n3))
    (ren-app n2 n3 n17 n18 (refl (efunarg n2 anil), tt) (refl (efunarg n3 anil), tt)) ev0g ;

example4-answer : Id Cell (h21 zero) (equote (num n1)) = refl (equote (num n1)) ;

-- the evaluator halts on alpha, with (QUOTE 1)
example4-halts : (nu : Nat -> Cell) * (Ev mu zero nu * Id Cell (nu zero) (equote (num n1))) =
  (h21, (example4-run, example4-answer)) ;
