-- The infinite elements of the lazy evaluator's domain, as filters of
-- types: doc/lazy-intersection.tex section 6.  Parameters: univalence
-- (giving function extensionality and propositional extensionality) and
-- replacement (giving propositional truncation).
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ;
import Lib ; import Types ; import Syntax ; import Observe ; import Gen ; import Rules ;
import Closures ; import Funarg ; import Step ; import Eval ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import Truncation ; import TruncationCombinators ;
 import Filter ; import Laws ; import Sem ; import Fix ; import Steps ; import SemEval ;
} ;
