-- Filter.seg: the domain of infinite elements (doc/lazy-intersection.tex
-- section 6.1).
--
-- A filter is a proposition-valued predicate on types containing om,
-- closed under meet and upward closed for Le.  Filters with the same
-- elements are equal (filt-ext: function extensionality and propositional
-- extensionality); everywhere else we work with inclusions Sub and the
-- equivalence Eqv (inclusion both ways).
--
-- Most filters are given by "witnesses" W t (not propositions) closed
-- under om, meet and Le; truncF truncates them.  The operations of the
-- paper:
--   prin s       the principal filter of s; bot = prin om;  topF all types
--   genF A       the filter generated by A (an inductive family)
--   pairF x y    om <= t, or pair s u <= t with s in x, u in y
--   fstF, sndF   om <= s, or pair s om (pair om s) in x
--   appF f x     om <= t, or arr s t in f for some s in x
--   lamF R       om <= t, or a meet of arrows arr s u with R s u is <= t
--   fixF R       least set with om, meet, Le, and: s in it, R s t => t in it
--   atomF, eqF, condF, plusF   generated, by the observation rules
-- lamF and fixF take the trace R of a function (R s u: u is in g (prin s)),
-- a relation between types, so that they stay in the universe of the types.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

------------------------------------------------------------------------
-- truncation

Ex (A : U l) : U l = Tr.Trunc[A].carrier ;
ex (A : U l) (a : A) : Ex A = Tr.Trunc[A].inc a ;
ex-prop (A : U l) : isProp (Ex A) = Tr.Trunc[A].proposition ;
ex-elim (A P : U l) (pP : isProp P) (f : A -> P) (e : Ex A) : P = TC.rec A @l P pP f e ;

------------------------------------------------------------------------
-- filters

Closed (m : Ty -> U l) : U l =
  m om * (((s t : Ty) -> m s -> m t -> m (meet s t)) * ((s t : Ty) -> Le s t -> m s -> m t)) ;
IsFilter (m : Ty -> U l) : U l = ((s : Ty) -> isProp (m s)) * Closed m ;

Filt : U l+ = (m : Ty -> U l) * IsFilter m ;

mem (x : Filt) (s : Ty) : U l = x.1 s ;
fprop (x : Filt) (s : Ty) : isProp (mem x s) = x.2.1 s ;
fom (x : Filt) : mem x om = x.2.2.1 ;
fmeet (x : Filt) (s t : Ty) (h1 : mem x s) (h2 : mem x t) : mem x (meet s t) = x.2.2.2.1 s t h1 h2 ;
fup (x : Filt) (s t : Ty) (le : Le s t) (h : mem x s) : mem x t = x.2.2.2.2 s t le h ;

Sub (x y : Filt) : U l = (s : Ty) -> mem x s -> mem y s ;
Eqv (x y : Filt) : U l = Sub x y * Sub y x ;

sub-refl (x : Filt) : Sub x x = \ s h -> h ;
sub-trans (x y z : Filt) (p : Sub x y) (q : Sub y z) : Sub x z = \ s h -> q s (p s h) ;
eqv-refl (x : Filt) : Eqv x x = (sub-refl x, sub-refl x) ;
eqv-sym (x y : Filt) (e : Eqv x y) : Eqv y x = (e.2, e.1) ;
eqv-trans (x y z : Filt) (p : Eqv x y) (q : Eqv y z) : Eqv x z =
  (sub-trans x y z p.1 q.1, sub-trans z y x q.2 p.2) ;

-- an equation of filters gives an equivalence
id-eqv (x y : Filt) (e : Id Filt x y) : Eqv x y =
  Prelude[l+].subst Filt (\ z -> Eqv x z) x y e (eqv-refl x) ;

isProp-IsFilter (m : Ty -> U l) : isProp (IsFilter m) =
  isProp-Sigma ((s : Ty) -> isProp (m s)) (\ _ -> Closed m)
    (F.isProp-Pi Ty (\ s -> isProp (m s)) (\ s -> F.isProp-isProp (m s)))
    (\ pm -> isProp-Sigma (m om) (\ _ -> ((s t : Ty) -> m s -> m t -> m (meet s t)) * ((s t : Ty) -> Le s t -> m s -> m t))
      (pm om)
      (\ _ -> isProp-Sigma ((s t : Ty) -> m s -> m t -> m (meet s t)) (\ _ -> (s t : Ty) -> Le s t -> m s -> m t)
        (F.isProp-Pi Ty (\ s -> (t : Ty) -> m s -> m t -> m (meet s t)) (\ s ->
          F.isProp-Pi Ty (\ t -> m s -> m t -> m (meet s t)) (\ t ->
            F.isProp-Pi (m s) (\ _ -> m t -> m (meet s t)) (\ _ ->
              F.isProp-Pi (m t) (\ _ -> m (meet s t)) (\ _ -> pm (meet s t))))))
        (\ _ -> F.isProp-Pi Ty (\ s -> (t : Ty) -> Le s t -> m s -> m t) (\ s ->
          F.isProp-Pi Ty (\ t -> Le s t -> m s -> m t) (\ t ->
            F.isProp-Pi (Le s t) (\ _ -> m s -> m t) (\ _ ->
              F.isProp-Pi (m s) (\ _ -> m t) (\ _ -> pm t))))))) ;

-- propositional extensionality, from univalence for propositions
prop-ext (P Q : U l) (pP : isProp P) (pQ : isProp Q) (f : P -> Q) (g : Q -> P) : Id (U l) P Q =
  (propUA @l P Q pP pQ).sec (f, qinv P Q f g (\ b -> pQ (f (g b)) b) (\ a -> pP (g (f a)) a)) ;

-- filters with the same elements are equal
filt-ext (x y : Filt) (e : Eqv x y) : Id Filt x y =
  Prelude[l+].Sigma-eq (Ty -> U l) (\ m -> IsFilter m) x.1 y.1 x.2 y.2
    (Axioms[l+].FunExtLemmas[fe @l+].funext Ty (\ _ -> U l) x.1 y.1
      (\ s -> prop-ext (x.1 s) (y.1 s) (x.2.1 s) (y.2.1 s) (e.1 s) (e.2 s)))
    (isProp-IsFilter y.1) ;

------------------------------------------------------------------------
-- filters from witnesses

truncF (W : Ty -> U l) (wom : W om)
    (wmeet : (s t : Ty) -> W s -> W t -> W (meet s t))
    (wup : (s t : Ty) -> Le s t -> W s -> W t) : Filt =
  (\ t -> Ex (W t),
   (\ t -> ex-prop (W t),
    (ex (W om) wom,
     (\ s t a b -> TC.bind2 (W s) (W t) (W (meet s t)) (\ u v -> ex (W (meet s t)) (wmeet s t u v)) a b,
      \ s t h -> TC.map (W s) (W t) (wup s t h))))) ;

-- an element of a truncated filter, given by a witness
tr-in (W : Ty -> U l) (t : Ty) (w : W t) : Ex (W t) = ex (W t) w ;
-- an inclusion is checked on the witnesses
tr-sub (W : Ty -> U l) (y : Filt) (h : (t : Ty) -> W t -> mem y t) (t : Ty) (e : Ex (W t)) : mem y t =
  ex-elim (W t) (mem y t) (fprop y t) (h t) e ;

------------------------------------------------------------------------
-- principal filters, bottom, top

PW (s t : Ty) : U l = Le s t ;
prin (s : Ty) : Filt = truncF (PW s) (le-om s) (\ t u h k -> le-meet s t u h k) (\ t u h k -> le-trans s t u k h) ;
prin-in (s : Ty) : mem (prin s) s = tr-in (PW s) s (le-refl s) ;
-- prin s is included in every filter containing s
prin-sub (s : Ty) (x : Filt) (h : mem x s) : Sub (prin s) x =
  tr-sub (PW s) x (\ t le -> fup x s t le h) ;
-- prin is antitone
prin-anti (s s' : Ty) (le : Le s s') : Sub (prin s') (prin s) =
  prin-sub s' (prin s) (tr-in (PW s) s' le) ;

bot : Filt = prin om ;
bot-sub (x : Filt) : Sub bot x = prin-sub om x (fom x) ;

topF : Filt = (\ t -> Top, (\ t -> isTop, (tt, (\ s t a b -> tt, \ s t h a -> tt)))) ;
top-sub (x : Filt) : Sub x topF = \ s h -> tt ;

------------------------------------------------------------------------
-- generated filters

data GW (A : Ty -> U l) : (t : Ty) -> U l =
    g-in (t : Ty) (a : A t) : GW A t
  | g-om : GW A om
  | g-meet (s t : Ty) (h1 : GW A s) (h2 : GW A t) : GW A (meet s t)
  | g-up (s t : Ty) (h : GW A s) (le : Le s t) : GW A t ;

genF (A : Ty -> U l) : Filt = truncF (GW A) g-om (\ s t a b -> g-meet s t a b) (\ s t le w -> g-up s t w le) ;
gen-in (A : Ty -> U l) (t : Ty) (a : A t) : mem (genF A) t = tr-in (GW A) t (g-in t a) ;

gw-sub (A : Ty -> U l) (x : Filt) (h : (t : Ty) -> A t -> mem x t) : (t : Ty) -> GW A t -> mem x t = split {
  g-in t a -> h t a ;
  g-om -> fom x ;
  g-meet s t h1 h2 | r1 r2 -> fmeet x s t r1 r2 ;
  g-up s t w le | r -> fup x s t le r } ;

-- genF A is the least filter containing A
gen-sub (A : Ty -> U l) (x : Filt) (h : (t : Ty) -> A t -> mem x t) : Sub (genF A) x =
  tr-sub (GW A) x (gw-sub A x h) ;

-- genF is monotone in the generators
gen-mono (A B : Ty -> U l) (h : (t : Ty) -> A t -> B t) : Sub (genF A) (genF B) =
  gen-sub A (genF B) (\ t a -> gen-in B t (h t a)) ;

------------------------------------------------------------------------
-- an om summand: om <= t, or the witness P t

module OmOr (P : Ty -> U l) (pmeet : (s t : Ty) -> P s -> P t -> P (meet s t))
    (pup : (s t : Ty) -> Le s t -> P s -> P t) {
  W (t : Ty) : U l = Plus (Le om t) (P t) ;
  -- om <= s and a witness for t give one for meet s t
  left (s t : Ty) (k : Le om s) (w : P t) : P (meet s t) =
    pup t (meet s t) (le-meet t s t (le-trans t om s (le-om t) k) (le-refl t)) w ;
  right (s t : Ty) (w : P s) (k : Le om t) : P (meet s t) =
    pup s (meet s t) (le-meet s s t (le-refl s) (le-trans s om t (le-om s) k)) w ;
  wmeet (s t : Ty) : W s -> W t -> W (meet s t) = split {
    inl k -> split {
      inl k' -> inl (le-meet om s t k k') ;
      inr w -> inr (left s t k w) } ;
    inr v -> split {
      inl k' -> inr (right s t v k') ;
      inr w -> inr (pmeet s t v w) } } ;
  wup (s t : Ty) (le : Le s t) : W s -> W t = split {
    inl k -> inl (le-trans om s t k le) ;
    inr w -> inr (pup s t le w) } ;
  filt : Filt = truncF W (inl (le-refl om)) wmeet wup ;
  intro (t : Ty) (w : W t) : mem filt t = tr-in W t w ;
  sub (y : Filt) (h : (t : Ty) -> W t -> mem y t) : Sub filt y = tr-sub W y h ;
} ;

------------------------------------------------------------------------
-- pairs and projections

module Pair (x y : Filt) {
  P (t : Ty) : U l = (s : Ty) * ((u : Ty) * (mem x s * (mem y u * Le (pair s u) t))) ;
  pmeet (t1 t2 : Ty) (v : P t1) (w : P t2) : P (meet t1 t2) =
    (meet v.1 w.1, (meet v.2.1 w.2.1, (fmeet x v.1 w.1 v.2.2.1 w.2.2.1, (fmeet y v.2.1 w.2.1 v.2.2.2.1 w.2.2.2.1,
      le-meet (pair (meet v.1 w.1) (meet v.2.1 w.2.1)) t1 t2
        (le-trans (pair (meet v.1 w.1) (meet v.2.1 w.2.1)) (pair v.1 v.2.1) t1
          (le-pair (meet v.1 w.1) v.1 (meet v.2.1 w.2.1) v.2.1 (le-meet-l v.1 w.1) (le-meet-l v.2.1 w.2.1)) v.2.2.2.2)
        (le-trans (pair (meet v.1 w.1) (meet v.2.1 w.2.1)) (pair w.1 w.2.1) t2
          (le-pair (meet v.1 w.1) w.1 (meet v.2.1 w.2.1) w.2.1 (le-meet-r v.1 w.1) (le-meet-r v.2.1 w.2.1)) w.2.2.2.2))))) ;
  pup (t t' : Ty) (le : Le t t') (v : P t) : P t' =
    (v.1, (v.2.1, (v.2.2.1, (v.2.2.2.1, le-trans (pair v.1 v.2.1) t t' v.2.2.2.2 le)))) ;
  W (t : Ty) : U l = OmOr[P, pmeet, pup].W t ;
  filt : Filt = OmOr[P, pmeet, pup].filt ;
  intro (t : Ty) (w : W t) : mem filt t = OmOr[P, pmeet, pup].intro t w ;
  sub (y : Filt) (h : (t : Ty) -> W t -> mem y t) : Sub filt y = OmOr[P, pmeet, pup].sub y h ;
} ;
pairF (x y : Filt) : Filt = Pair[x, y].filt ;
pair-in (x y : Filt) (s u : Ty) (hs : mem x s) (hu : mem y u) : mem (pairF x y) (pair s u) =
  Pair[x, y].intro (pair s u) (inr (s, (u, (hs, (hu, le-refl (pair s u)))))) ;

-- om x om <= s x t
pair-om (s t : Ty) : Le (pair s t) (pair om om) = le-pair s om t om (le-om s) (le-om t) ;

module Fst (x : Filt) {
  P (s : Ty) : U l = mem x (pair s om) ;
  pmeet (s t : Ty) (a : P s) (b : P t) : P (meet s t) =
    fup x (meet (pair s om) (pair t om)) (pair (meet s t) om)
      (le-trans (meet (pair s om) (pair t om)) (pair (meet s t) (meet om om)) (pair (meet s t) om)
        (le-pair-meet s om t om) (le-pair (meet s t) (meet s t) (meet om om) om (le-refl (meet s t)) (le-om (meet om om))))
      (fmeet x (pair s om) (pair t om) a b) ;
  pup (s t : Ty) (le : Le s t) (a : P s) : P t =
    fup x (pair s om) (pair t om) (le-pair s t om om le (le-refl om)) a ;
  W (t : Ty) : U l = OmOr[P, pmeet, pup].W t ;
  filt : Filt = OmOr[P, pmeet, pup].filt ;
  intro (t : Ty) (w : W t) : mem filt t = OmOr[P, pmeet, pup].intro t w ;
  sub (y : Filt) (h : (t : Ty) -> W t -> mem y t) : Sub filt y = OmOr[P, pmeet, pup].sub y h ;
} ;
fstF (x : Filt) : Filt = Fst[x].filt ;

module Snd (x : Filt) {
  P (s : Ty) : U l = mem x (pair om s) ;
  pmeet (s t : Ty) (a : P s) (b : P t) : P (meet s t) =
    fup x (meet (pair om s) (pair om t)) (pair om (meet s t))
      (le-trans (meet (pair om s) (pair om t)) (pair (meet om om) (meet s t)) (pair om (meet s t))
        (le-pair-meet om s om t) (le-pair (meet om om) om (meet s t) (meet s t) (le-om (meet om om)) (le-refl (meet s t))))
      (fmeet x (pair om s) (pair om t) a b) ;
  pup (s t : Ty) (le : Le s t) (a : P s) : P t =
    fup x (pair om s) (pair om t) (le-pair om om s t (le-refl om) le) a ;
  W (t : Ty) : U l = OmOr[P, pmeet, pup].W t ;
  filt : Filt = OmOr[P, pmeet, pup].filt ;
  intro (t : Ty) (w : W t) : mem filt t = OmOr[P, pmeet, pup].intro t w ;
  sub (y : Filt) (h : (t : Ty) -> W t -> mem y t) : Sub filt y = OmOr[P, pmeet, pup].sub y h ;
} ;
sndF (x : Filt) : Filt = Snd[x].filt ;

------------------------------------------------------------------------
-- application

module App (f x : Filt) {
  P (t : Ty) : U l = (s : Ty) * (mem x s * mem f (arr s t)) ;
  pmeet (t u : Ty) (v : P t) (w : P u) : P (meet t u) =
    (meet v.1 w.1, (fmeet x v.1 w.1 v.2.1 w.2.1,
      fup f (meet (arr (meet v.1 w.1) t) (arr (meet v.1 w.1) u)) (arr (meet v.1 w.1) (meet t u))
        (le-arr-meet (meet v.1 w.1) t u)
        (fmeet f (arr (meet v.1 w.1) t) (arr (meet v.1 w.1) u)
          (fup f (arr v.1 t) (arr (meet v.1 w.1) t) (le-arr v.1 (meet v.1 w.1) t t (le-meet-l v.1 w.1) (le-refl t)) v.2.2)
          (fup f (arr w.1 u) (arr (meet v.1 w.1) u) (le-arr w.1 (meet v.1 w.1) u u (le-meet-r v.1 w.1) (le-refl u)) w.2.2)))) ;
  pup (t u : Ty) (le : Le t u) (v : P t) : P u =
    (v.1, (v.2.1, fup f (arr v.1 t) (arr v.1 u) (le-arr v.1 v.1 t u (le-refl v.1) le) v.2.2)) ;
  W (t : Ty) : U l = OmOr[P, pmeet, pup].W t ;
  filt : Filt = OmOr[P, pmeet, pup].filt ;
  intro (t : Ty) (w : W t) : mem filt t = OmOr[P, pmeet, pup].intro t w ;
  sub (y : Filt) (h : (t : Ty) -> W t -> mem y t) : Sub filt y = OmOr[P, pmeet, pup].sub y h ;
} ;
appF (f x : Filt) : Filt = App[f, x].filt ;
app-in (f x : Filt) (s t : Ty) (hs : mem x s) (hf : mem f (arr s t)) : mem (appF f x) t =
  App[f, x].intro t (inr (s, (hs, hf))) ;

------------------------------------------------------------------------
-- abstraction, from a trace

data AM (R : Ty -> Ty -> U l) : (r : Ty) -> U l =
    am-one (s u : Ty) (h : R s u) : AM R (arr s u)
  | am-meet (r1 r2 : Ty) (h1 : AM R r1) (h2 : AM R r2) : AM R (meet r1 r2) ;

module Lam (R : Ty -> Ty -> U l) {
  P (t : Ty) : U l = (r : Ty) * (AM R r * Le r t) ;
  pmeet (t u : Ty) (v : P t) (w : P u) : P (meet t u) =
    (meet v.1 w.1, (am-meet v.1 w.1 v.2.1 w.2.1, le-meet-mono v.1 t w.1 u v.2.2 w.2.2)) ;
  pup (t u : Ty) (le : Le t u) (v : P t) : P u = (v.1, (v.2.1, le-trans v.1 t u v.2.2 le)) ;
  W (t : Ty) : U l = OmOr[P, pmeet, pup].W t ;
  filt : Filt = OmOr[P, pmeet, pup].filt ;
  intro (t : Ty) (w : W t) : mem filt t = OmOr[P, pmeet, pup].intro t w ;
  sub (y : Filt) (h : (t : Ty) -> W t -> mem y t) : Sub filt y = OmOr[P, pmeet, pup].sub y h ;
} ;
lamF (R : Ty -> Ty -> U l) : Filt = Lam[R].filt ;
lam-in (R : Ty -> Ty -> U l) (s u : Ty) (h : R s u) : mem (lamF R) (arr s u) =
  Lam[R].intro (arr s u) (inr (arr s u, (am-one s u h, le-refl (arr s u)))) ;

------------------------------------------------------------------------
-- least fixed point, from a trace

data YW (R : Ty -> Ty -> U l) : (t : Ty) -> U l =
    y-om : YW R om
  | y-meet (s t : Ty) (h1 : YW R s) (h2 : YW R t) : YW R (meet s t)
  | y-up (s t : Ty) (h : YW R s) (le : Le s t) : YW R t
  | y-step (s t : Ty) (h : YW R s) (r : R s t) : YW R t ;

fixF (R : Ty -> Ty -> U l) : Filt = truncF (YW R) y-om (\ s t a b -> y-meet s t a b) (\ s t le w -> y-up s t w le) ;

-- the closure rule, on elements of the filter
fix-step (R : Ty -> Ty -> U l) (s t : Ty) (h : mem (fixF R) s) (r : R s t) : mem (fixF R) t =
  TC.map (YW R s) (YW R t) (\ w -> y-step s t w r) h ;

yw-sub (R : Ty -> Ty -> U l) (x : Filt) (h : (s t : Ty) -> mem x s -> R s t -> mem x t) :
    (t : Ty) -> YW R t -> mem x t = split {
  y-om -> fom x ;
  y-meet s t h1 h2 | r1 r2 -> fmeet x s t r1 r2 ;
  y-up s t w le | r -> fup x s t le r ;
  y-step s t w r | rh -> h s t rh r } ;

-- fixed-point induction: a filter closed under the rule contains fixF R
fix-ind (R : Ty -> Ty -> U l) (x : Filt) (h : (s t : Ty) -> mem x s -> R s t -> mem x t) : Sub (fixF R) x =
  tr-sub (YW R) x (yw-sub R x h) ;

------------------------------------------------------------------------
-- the primitives, generated by the observation rules (Observe.CellQ)

atomF (x : Filt) : Filt = genF (\ t ->
  Plus (Id Ty t (at T) * mem x atom) (Id Ty t (at NIL) * mem x (pair om om))) ;

eqF (x y : Filt) : Filt = genF (\ t -> (a : Atom) * ((b : Atom) * (mem x (at a) * (mem y (at b) *
  Plus (IsT (atEq a b) * Id Ty t (at T)) (IsF (atEq a b) * Id Ty t (at NIL)))))) ;

condF (x y z : Filt) : Filt = genF (\ t ->
  Plus (mem x (at T) * mem y t) (mem x (at NIL) * mem z t)) ;

plusF (x y : Filt) : Filt = genF (\ t -> (m : Nat) * ((n : Nat) * (mem x (at (num m)) * (mem y (at (num n)) *
  Id Ty t (at (num (add m n))))))) ;

------------------------------------------------------------------------
-- monotonicity of the operations

pmap (A B A' B' : U l) (f : A -> A') (g : B -> B') : Plus A B -> Plus A' B' = split {
  inl a -> inl (f a) ;
  inr b -> inr (g b) } ;

idf (A : U l) (a : A) : A = a ;

pair-mono (x x' y y' : Filt) (hx : Sub x x') (hy : Sub y y') : Sub (pairF x y) (pairF x' y') =
  Pair[x, y].sub (pairF x' y') (\ t w -> Pair[x', y'].intro t
    (pmap (Le om t) (Pair[x, y].P t) (Le om t) (Pair[x', y'].P t) (idf (Le om t))
      (\ v -> (v.1, (v.2.1, (hx v.1 v.2.2.1, (hy v.2.1 v.2.2.2.1, v.2.2.2.2))))) w)) ;

fst-mono (x x' : Filt) (h : Sub x x') : Sub (fstF x) (fstF x') =
  Fst[x].sub (fstF x') (\ t w -> Fst[x'].intro t
    (pmap (Le om t) (mem x (pair t om)) (Le om t) (mem x' (pair t om)) (idf (Le om t)) (h (pair t om)) w)) ;

snd-mono (x x' : Filt) (h : Sub x x') : Sub (sndF x) (sndF x') =
  Snd[x].sub (sndF x') (\ t w -> Snd[x'].intro t
    (pmap (Le om t) (mem x (pair om t)) (Le om t) (mem x' (pair om t)) (idf (Le om t)) (h (pair om t)) w)) ;

app-mono (f f' x x' : Filt) (hf : Sub f f') (hx : Sub x x') : Sub (appF f x) (appF f' x') =
  App[f, x].sub (appF f' x') (\ t w -> App[f', x'].intro t
    (pmap (Le om t) (App[f, x].P t) (Le om t) (App[f', x'].P t) (idf (Le om t))
      (\ v -> (v.1, (hx v.1 v.2.1, hf (arr v.1 t) v.2.2))) w)) ;

am-mono (R R' : Ty -> Ty -> U l) (h : (s u : Ty) -> R s u -> R' s u) : (r : Ty) -> AM R r -> AM R' r = split {
  am-one s u k -> am-one s u (h s u k) ;
  am-meet r1 r2 h1 h2 | a1 a2 -> am-meet r1 r2 a1 a2 } ;

lam-mono (R R' : Ty -> Ty -> U l) (h : (s u : Ty) -> R s u -> R' s u) : Sub (lamF R) (lamF R') =
  Lam[R].sub (lamF R') (\ t w -> Lam[R'].intro t
    (pmap (Le om t) (Lam[R].P t) (Le om t) (Lam[R'].P t) (idf (Le om t))
      (\ v -> (v.1, (am-mono R R' h v.1 v.2.1, v.2.2))) w)) ;

fix-mono (R R' : Ty -> Ty -> U l) (h : (s u : Ty) -> R s u -> R' s u) : Sub (fixF R) (fixF R') =
  fix-ind R (fixF R') (\ s t hs r -> fix-step R' s t hs (h s t r)) ;

atom-mono (x x' : Filt) (h : Sub x x') : Sub (atomF x) (atomF x') =
  gen-mono (\ t -> Plus (Id Ty t (at T) * mem x atom) (Id Ty t (at NIL) * mem x (pair om om)))
           (\ t -> Plus (Id Ty t (at T) * mem x' atom) (Id Ty t (at NIL) * mem x' (pair om om)))
    (\ t -> pmap (Id Ty t (at T) * mem x atom) (Id Ty t (at NIL) * mem x (pair om om))
                 (Id Ty t (at T) * mem x' atom) (Id Ty t (at NIL) * mem x' (pair om om))
                 (\ v -> (v.1, h atom v.2)) (\ v -> (v.1, h (pair om om) v.2))) ;

eq-mono (x x' y y' : Filt) (hx : Sub x x') (hy : Sub y y') : Sub (eqF x y) (eqF x' y') =
  gen-mono (\ t -> (a : Atom) * ((b : Atom) * (mem x (at a) * (mem y (at b) *
              Plus (IsT (atEq a b) * Id Ty t (at T)) (IsF (atEq a b) * Id Ty t (at NIL))))))
           (\ t -> (a : Atom) * ((b : Atom) * (mem x' (at a) * (mem y' (at b) *
              Plus (IsT (atEq a b) * Id Ty t (at T)) (IsF (atEq a b) * Id Ty t (at NIL))))))
    (\ t v -> (v.1, (v.2.1, (hx (at v.1) v.2.2.1, (hy (at v.2.1) v.2.2.2.1, v.2.2.2.2))))) ;

cond-mono (x x' y y' z z' : Filt) (hx : Sub x x') (hy : Sub y y') (hz : Sub z z') : Sub (condF x y z) (condF x' y' z') =
  gen-mono (\ t -> Plus (mem x (at T) * mem y t) (mem x (at NIL) * mem z t))
           (\ t -> Plus (mem x' (at T) * mem y' t) (mem x' (at NIL) * mem z' t))
    (\ t -> pmap (mem x (at T) * mem y t) (mem x (at NIL) * mem z t)
                 (mem x' (at T) * mem y' t) (mem x' (at NIL) * mem z' t)
                 (\ v -> (hx (at T) v.1, hy t v.2)) (\ v -> (hx (at NIL) v.1, hz t v.2))) ;

plus-mono (x x' y y' : Filt) (hx : Sub x x') (hy : Sub y y') : Sub (plusF x y) (plusF x' y') =
  gen-mono (\ t -> (m : Nat) * ((n : Nat) * (mem x (at (num m)) * (mem y (at (num n)) * Id Ty t (at (num (add m n)))))))
           (\ t -> (m : Nat) * ((n : Nat) * (mem x' (at (num m)) * (mem y' (at (num n)) * Id Ty t (at (num (add m n)))))))
    (\ t v -> (v.1, (v.2.1, (hx (at (num v.1)) v.2.2.1, (hy (at (num v.2.1)) v.2.2.2.1, v.2.2.2.2))))) ;
