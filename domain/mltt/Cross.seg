-- Cross.seg: two related substitutions (step 4a; NOTE-4.txt section 4.5).
--   SubEq G H s s'   s i = s' i at each variable
--   wkl-ty, beta-var0   (wk (lam C X)) applied to var 0 = X, by beta and D4
--   XJ, module XB     the motive, and the cases under a binder (Pi, lam,
--                     app) with the lifted substitutions over (H, s A)
--   xsub              Lemma X, one eliminator for Der

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ;
open Presup[l] ;

SubEq (n m : Nat) (G : Ctx n) (H : Ctx m) (s s' : Fin n -> Tm m) : U l =
  (i : Fin n) -> Der m (jeq H (s i) (s' i) (Sub.trav n (lookup n G i) m s)) ;

------------------------------------------------------------------------
-- beta at the variable 0

wkl-ty (m : Nat) (H : Ctx m) (C : Tm m) (dC : Der m (jty H C (uu m))) (X Y : Tm (suc m))
    (d : Der (suc m) (jty (ext m H C) X Y)) :
    Der (suc (suc m)) (jty (ext (suc m) (ext m H C) (wk m C)) (wkl m X) (wkl m Y)) =
  ren-der (suc m) (jty (ext m H C) X Y) d (suc (suc m)) (ext (suc m) (ext m H C) (wk m C))
    (Ren.lift m (suc m) (\ i -> fs m i)) (renok-lift m (suc m) H (ext m H C) (\ i -> fs m i) C (renok-wk m H C))
    (wf-ext (suc m) (ext m H C) (wk m C) (wk-ty m H C C (uu m) dC dC)) ;

-- (H, C) |- (wk (lam C X)) var0 = X : Y
beta-var0 (m : Nat) (H : Ctx m) (C : Tm m) (X Y : Tm (suc m)) (dC : Der m (jty H C (uu m)))
    (dY : Der (suc m) (jty (ext m H C) Y (uu (suc m)))) (dX : Der (suc m) (jty (ext m H C) X Y)) :
    Der (suc m) (jeq (ext m H C) (app (suc m) (wk m (lam m C X)) (var (suc m) (fz m))) X Y) =
  der-eq-r (suc m) (ext m H C) (app (suc m) (wk m (lam m C X)) (var (suc m) (fz m)))
    (subst1 (suc m) (wkl m X) (var (suc m) (fz m))) X Y (subst1-var0 m X)
    (der-eq-ty (suc m) (ext m H C) (app (suc m) (wk m (lam m C X)) (var (suc m) (fz m)))
       (subst1 (suc m) (wkl m X) (var (suc m) (fz m))) (subst1 (suc m) (wkl m Y) (var (suc m) (fz m))) Y
       (subst1-var0 m Y)
       (eq-beta (suc m) (ext m H C) (wk m C) (wkl m Y) (wkl m X) (var (suc m) (fz m))
          (wk-ty m H C C (uu m) dC dC) (wkl-ty m H C dC Y (uu (suc m)) dY) (wkl-ty m H C dC X Y dX)
          (ty-var (suc m) (ext m H C) (fz m) (wf-ext m H C dC)))) ;

------------------------------------------------------------------------
-- the motive

XJ (n : Nat) : Jf n -> U l = split {
  jwf G -> Top ;
  jty G M A -> (m : Nat) -> (H : Ctx m) -> (s s' : Fin n -> Tm m) -> SubOk n m G H s -> SubOk n m G H s' ->
    SubEq n m G H s s' -> Der m (jwf H) -> Der m (jeq H (Sub.trav n M m s) (Sub.trav n M m s') (Sub.trav n A m s)) ;
  jeq G M N A -> Top } ;

------------------------------------------------------------------------
-- under a binder A

module XB (n m : Nat) (G : Ctx n) (H : Ctx m) (s s' : Fin n -> Tm m) (so : SubOk n m G H s)
    (so' : SubOk n m G H s') (se : SubEq n m G H s s') (wH : Der m (jwf H)) (A : Tm n)
    (h1 : Der n (jty G A (uu n))) (eA : Der m (jeq H (Sub.trav n A m s) (Sub.trav n A m s') (uu m))) {

  dA : Der m (jty H (Sub.trav n A m s) (uu m)) = sub-der n (jty G A (uu n)) h1 m H s so wH ;
  dA' : Der m (jty H (Sub.trav n A m s') (uu m)) = sub-der n (jty G A (uu n)) h1 m H s' so' wH ;
  HA : Ctx (suc m) = ext m H (Sub.trav n A m s) ;
  wHA : Der (suc m) (jwf HA) = wf-ext m H (Sub.trav n A m s) dA ;
  H'A : Ctx (suc m) = ext m H (Sub.trav n A m s') ;
  wH'A : Der (suc m) (jwf H'A) = wf-ext m H (Sub.trav n A m s') dA' ;
  eA' : Der m (jeq H (Sub.trav n A m s') (Sub.trav n A m s) (uu m)) =
    eq-sym m H (Sub.trav n A m s) (Sub.trav n A m s') (uu m) eA ;

  soL : SubOk (suc n) (suc m) (ext n G A) HA (Sub.lift n m s) = subok-lift n m G H s A so dA ;
  soR : SubOk (suc n) (suc m) (ext n G A) H'A (Sub.lift n m s') = subok-lift n m G H s' A so' dA' ;
  -- the lift of s' moved to (H, s A)
  soL' : SubOk (suc n) (suc m) (ext n G A) HA (Sub.lift n m s') = \ i ->
    ctxconv-ty m H (Sub.trav n A m s') (Sub.trav n A m s) dA' dA eA' (Sub.lift n m s' i)
      (Sub.trav (suc n) (lookup (suc n) (ext n G A) i) (suc m) (Sub.lift n m s')) (soR i) ;

  seL : (i : Fin (suc n)) -> Der (suc m) (jeq HA (Sub.lift n m s i) (Sub.lift n m s' i)
          (Sub.trav (suc n) (lookup (suc n) (ext n G A) i) (suc m) (Sub.lift n m s))) = split {
    none -> eq-refl (suc m) HA (var (suc m) (fz m)) (Sub.trav (suc n) (wk n A) (suc m) (Sub.lift n m s)) (soL (fz n)) ;
    some i -> der-eq-ty (suc m) HA (wk m (s i)) (wk m (s' i)) (wk m (Sub.trav n (lookup n G i) m s))
                (Sub.trav (suc n) (wk n (lookup n G i)) (suc m) (Sub.lift n m s))
                (sym (Tm (suc m)) (Sub.trav (suc n) (wk n (lookup n G i)) (suc m) (Sub.lift n m s))
                   (wk m (Sub.trav n (lookup n G i) m s)) (wk-sub n m s (lookup n G i)))
                (wk-eq m H (Sub.trav n A m s) (s i) (s' i) (Sub.trav n (lookup n G i) m s) dA (se i)) } ;

  -- the induction hypothesis at a premise over (G, A)
  under (X Y : Tm (suc n)) (r : XJ (suc n) (jty (ext n G A) X Y)) :
      Der (suc m) (jeq HA (Sub.trav (suc n) X (suc m) (Sub.lift n m s)) (Sub.trav (suc n) X (suc m) (Sub.lift n m s'))
        (Sub.trav (suc n) Y (suc m) (Sub.lift n m s))) =
    r (suc m) HA (Sub.lift n m s) (Sub.lift n m s') soL soL' seL wHA ;

  -- the rule Pi
  x-pi (B : Tm (suc n)) (rB : XJ (suc n) (jty (ext n G A) B (uu (suc n)))) :
      Der m (jeq H (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))
        (pp m (Sub.trav n A m s') (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))) (uu m)) =
    eq-Pi m H (Sub.trav n A m s) (Sub.trav n A m s')
      (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))
      dA (eB.1) (eB.2) eA (under B (uu (suc n)) rB)
    where {
      eB : Der (suc m) (jty HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (uu (suc m)))
         * Der (suc m) (jty HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s')) (uu (suc m))) =
        eq-pre (suc m) (jeq HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))
          (uu (suc m))) (under B (uu (suc n)) rB) ; } ;

  -- the rule lam, by funext: both sides applied to var 0 are the bodies (beta-var0)
  x-lam (B M : Tm (suc n)) (h2 : Der (suc n) (jty (ext n G A) B (uu (suc n)))) (h3 : Der (suc n) (jty (ext n G A) M B))
      (rB : XJ (suc n) (jty (ext n G A) B (uu (suc n)))) (rM : XJ (suc n) (jty (ext n G A) M B)) :
      Der m (jeq H (lam m (Sub.trav n A m s) (Sub.trav (suc n) M (suc m) (Sub.lift n m s)))
        (lam m (Sub.trav n A m s') (Sub.trav (suc n) M (suc m) (Sub.lift n m s')))
        (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))) =
    eq-funext m H (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) L L' dA
      (eq-trans (suc m) HA (app (suc m) (wk m L) (var (suc m) (fz m))) (Sub.trav (suc n) M (suc m) (Sub.lift n m s))
         (app (suc m) (wk m L') (var (suc m) (fz m))) (Sub.trav (suc n) B (suc m) (Sub.lift n m s))
         (beta-var0 m H (Sub.trav n A m s) (Sub.trav (suc n) M (suc m) (Sub.lift n m s))
            (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) dA dB dM)
         (eq-trans (suc m) HA (Sub.trav (suc n) M (suc m) (Sub.lift n m s)) (Sub.trav (suc n) M (suc m) (Sub.lift n m s'))
            (app (suc m) (wk m L') (var (suc m) (fz m))) (Sub.trav (suc n) B (suc m) (Sub.lift n m s))
            (under M B rM)
            (eq-sym (suc m) HA (app (suc m) (wk m L') (var (suc m) (fz m))) (Sub.trav (suc n) M (suc m) (Sub.lift n m s'))
               (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) beta2)))
      dL dL'
    where {
      L : Tm m = lam m (Sub.trav n A m s) (Sub.trav (suc n) M (suc m) (Sub.lift n m s)) ;
      L' : Tm m = lam m (Sub.trav n A m s') (Sub.trav (suc n) M (suc m) (Sub.lift n m s')) ;
      dB : Der (suc m) (jty HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (uu (suc m))) =
        sub-der (suc n) (jty (ext n G A) B (uu (suc n))) h2 (suc m) HA (Sub.lift n m s) soL wHA ;
      dM : Der (suc m) (jty HA (Sub.trav (suc n) M (suc m) (Sub.lift n m s)) (Sub.trav (suc n) B (suc m) (Sub.lift n m s))) =
        sub-der (suc n) (jty (ext n G A) M B) h3 (suc m) HA (Sub.lift n m s) soL wHA ;
      dB' : Der (suc m) (jty H'A (Sub.trav (suc n) B (suc m) (Sub.lift n m s')) (uu (suc m))) =
        sub-der (suc n) (jty (ext n G A) B (uu (suc n))) h2 (suc m) H'A (Sub.lift n m s') soR wH'A ;
      dM' : Der (suc m) (jty H'A (Sub.trav (suc n) M (suc m) (Sub.lift n m s')) (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))) =
        sub-der (suc n) (jty (ext n G A) M B) h3 (suc m) H'A (Sub.lift n m s') soR wH'A ;
      eB : Der (suc m) (jeq HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))
             (uu (suc m))) = under B (uu (suc n)) rB ;
      dL : Der m (jty H L (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))) =
        ty-Lam m H (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav (suc n) M (suc m) (Sub.lift n m s))
          dA dB dM ;
      dL' : Der m (jty H L' (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))) =
        ty-conv m H L' (pp m (Sub.trav n A m s') (Sub.trav (suc n) B (suc m) (Sub.lift n m s')))
          (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))
          (ty-Lam m H (Sub.trav n A m s') (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))
             (Sub.trav (suc n) M (suc m) (Sub.lift n m s')) dA' dB' dM')
          (eq-sym m H (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))
             (pp m (Sub.trav n A m s') (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))) (uu m) (x-pi B rB))
          (ty-Pi m H (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) dA dB) ;
      -- the right side over (H, s' A), moved to (H, s A), at the type B[liftS s]
      beta2 : Der (suc m) (jeq HA (app (suc m) (wk m L') (var (suc m) (fz m))) (Sub.trav (suc n) M (suc m) (Sub.lift n m s'))
                (Sub.trav (suc n) B (suc m) (Sub.lift n m s))) =
        eq-conv (suc m) HA (app (suc m) (wk m L') (var (suc m) (fz m))) (Sub.trav (suc n) M (suc m) (Sub.lift n m s'))
          (Sub.trav (suc n) B (suc m) (Sub.lift n m s')) (Sub.trav (suc n) B (suc m) (Sub.lift n m s))
          (ctxconv-eq m H (Sub.trav n A m s') (Sub.trav n A m s) dA' dA eA'
             (app (suc m) (wk m L') (var (suc m) (fz m))) (Sub.trav (suc n) M (suc m) (Sub.lift n m s'))
             (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))
             (beta-var0 m H (Sub.trav n A m s') (Sub.trav (suc n) M (suc m) (Sub.lift n m s'))
                (Sub.trav (suc n) B (suc m) (Sub.lift n m s')) dA' dB' dM'))
          (eq-sym (suc m) HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))
             (uu (suc m)) eB)
          dB ; } ;

  -- the rule app: app-fun, then app-arg
  x-app (B : Tm (suc n)) (f a : Tm n) (h2 : Der (suc n) (jty (ext n G A) B (uu (suc n))))
      (h3 : Der n (jty G f (pp n A B))) (h4 : Der n (jty G a A))
      (rB : XJ (suc n) (jty (ext n G A) B (uu (suc n))))
      (ef : Der m (jeq H (Sub.trav n f m s) (Sub.trav n f m s') (Sub.trav n (pp n A B) m s)))
      (ea : Der m (jeq H (Sub.trav n a m s) (Sub.trav n a m s') (Sub.trav n A m s))) :
      Der m (jeq H (app m (Sub.trav n f m s) (Sub.trav n a m s)) (app m (Sub.trav n f m s') (Sub.trav n a m s'))
        (Sub.trav n (subst1 n B a) m s)) =
    der-eq-ty m H (app m (Sub.trav n f m s) (Sub.trav n a m s)) (app m (Sub.trav n f m s') (Sub.trav n a m s'))
      (subst1 m (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav n a m s)) (Sub.trav n (subst1 n B a) m s)
      (sym (Tm m) (Sub.trav n (subst1 n B a) m s) (subst1 m (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav n a m s))
         (sub-subst1 n m s B a))
      (eq-trans m H (app m (Sub.trav n f m s) (Sub.trav n a m s)) (app m (Sub.trav n f m s') (Sub.trav n a m s))
         (app m (Sub.trav n f m s') (Sub.trav n a m s'))
         (subst1 m (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (Sub.trav n a m s))
         (eq-app-fun m H (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s))
            (Sub.trav n f m s) (Sub.trav n f m s') (Sub.trav n a m s) dA dB ef
            (sub-der n (jty G a A) h4 m H s so wH))
         (eq-app-arg m H (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s))
            (Sub.trav n f m s') (Sub.trav n a m s) (Sub.trav n a m s') dA dB df' ea))
    where {
      dB : Der (suc m) (jty HA (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) (uu (suc m))) =
        sub-der (suc n) (jty (ext n G A) B (uu (suc n))) h2 (suc m) HA (Sub.lift n m s) soL wHA ;
      df' : Der m (jty H (Sub.trav n f m s') (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))) =
        ty-conv m H (Sub.trav n f m s') (pp m (Sub.trav n A m s') (Sub.trav (suc n) B (suc m) (Sub.lift n m s')))
          (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))
          (sub-der n (jty G f (pp n A B)) h3 m H s' so' wH)
          (eq-sym m H (pp m (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)))
             (pp m (Sub.trav n A m s') (Sub.trav (suc n) B (suc m) (Sub.lift n m s'))) (uu m) (x-pi B rB))
          (ty-Pi m H (Sub.trav n A m s) (Sub.trav (suc n) B (suc m) (Sub.lift n m s)) dA dB) ; } ;
} ;

------------------------------------------------------------------------
-- Lemma X

xsub : (n : Nat) -> (J : Jf n) -> Der n J -> XJ n J = split {
  wf-emp -> tt ;
  wf-ext n G A h -> tt ;
  ty-var n G i h -> \ m H s s' so so' se wH -> se i ;
  ty-conv n G M A B h1 h2 h3 | r1 r2 r3 -> \ m H s s' so so' se wH ->
    eq-conv m H (Sub.trav n M m s) (Sub.trav n M m s') (Sub.trav n A m s) (Sub.trav n B m s)
      (r1 m H s s' so so' se wH) (sub-der n (jeq G A B (uu n)) h2 m H s so wH) (sub-der n (jty G B (uu n)) h3 m H s so wH) ;
  ty-U n G h -> \ m H s s' so so' se wH -> eq-refl m H (uu m) (uu m) (ty-U m H wH) ;
  ty-Pi n G A B h1 h2 | r1 r2 -> \ m H s s' so so' se wH ->
    XB[n, m, G, H, s, s', so, so', se, wH, A, h1, r1 m H s s' so so' se wH].x-pi B r2 ;
  ty-Lam n G A B M h1 h2 h3 | r1 r2 r3 -> \ m H s s' so so' se wH ->
    XB[n, m, G, H, s, s', so, so', se, wH, A, h1, r1 m H s s' so so' se wH].x-lam B M h2 h3 r2 r3 ;
  ty-App n G A B f a h1 h2 h3 h4 | r1 r2 r3 r4 -> \ m H s s' so so' se wH ->
    XB[n, m, G, H, s, s', so, so', se, wH, A, h1, r1 m H s s' so so' se wH].x-app B f a h2 h3 h4 r2
      (r3 m H s s' so so' se wH) (r4 m H s s' so so' se wH) ;
  eq-refl n G M A h -> tt ;
  eq-sym n G M N A h -> tt ;
  eq-trans n G M N P A h1 h2 -> tt ;
  eq-conv n G M N A B h1 h2 h3 -> tt ;
  eq-beta n G A B M a h1 h2 h3 h4 -> tt ;
  eq-Pi n G A A' B B' h1 h2 h3 h4 h5 -> tt ;
  eq-funext n G A B f g h1 h2 h3 h4 -> tt ;
  eq-app-fun n G A B f f' a h1 h2 h3 h4 -> tt ;
  eq-app-arg n G A B f a a' h1 h2 h3 h4 -> tt } ;

-- Lemma X
subst-cross (n m : Nat) (G : Ctx n) (H : Ctx m) (s s' : Fin n -> Tm m) (M A : Tm n) (d : Der n (jty G M A))
    (so : SubOk n m G H s) (so' : SubOk n m G H s') (se : SubEq n m G H s s') (wH : Der m (jwf H)) :
    Der m (jeq H (Sub.trav n M m s) (Sub.trav n M m s') (Sub.trav n A m s)) =
  xsub n (jty G M A) d m H s s' so so' se wH ;
