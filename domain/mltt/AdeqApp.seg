-- AdeqApp.seg: adequacy (NOTE-4.txt 4.14.3), the cases app (ty-App,
-- eq-app-fun, eq-app-arg: one lemma ad-app), beta, funext.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ; open Cross[l] ;
open Filter[l] ; open Sem[l] ; open Sound[l] ; open Reduction[l] ; open RelC[l] ; open LawsC[l] ; open AdeqBase[l] ;
open AdeqPi[l] ; open AdeqLam[l] ;

module AdeqA (n : Nat) (D : Ctx n) (wD : Der n (jwf D)) {
  open RelCD[n, D] ;
  open LawsCD[n, D] ;
  open AdeqB[n, D] ;
  open AdeqP[n, D, wD] ;
  open AdeqL[n, D, wD] ;

  ----------------------------------------------------------------------
  -- an argument a : A, substituted by s and s', as the new variable

  module ArgCase (m : Nat) (G : Ctx m) (A a a' : Tm m) (h1 : Der m (jty G A (uu m))) (ea : Der m (jeq G a a' A))
      (ra : Ad m G a a' A) (rho : Env m) (fi : Fits m G rho) (s s' : Fin m -> Tm n) (rs : RelS m G rho s s') {

    As : Tm n = Sub.trav m A n s ;
    As' : Tm n = Sub.trav m A n s' ;
    as : Tm n = Sub.trav m a n s ;
    as' : Tm n = Sub.trav m a n s' ;
    da : Der m (jty G a A) = (eq-pre m (jeq G a a' A) ea).1 ;
    da' : Der m (jty G a' A) = (eq-pre m (jeq G a a' A) ea).2 ;
    tyuA : TyU (sem m A rho) = tyu-of m A rho (soundness-ty m G A (uu m) h1 rho fi) ;
    eA : Der n (jeq D As As' (uu n)) = subst-cross m n G D s s' A (uu m) h1 rs.ok rs.ok' rs.eq wD ;

    -- a[s] = a'[s'] and a[s] = a[s']
    cva : Der n (jeq D as (Sub.trav m a' n s') As) =
      eq-trans n D as (Sub.trav m a' n s) (Sub.trav m a' n s') As
        (sub-der m (jeq G a a' A) ea n D s rs.ok wD) (subst-cross m n G D s s' a' A da' rs.ok rs.ok' rs.eq wD) ;
    cvaa : Der n (jeq D as as' As) = subst-cross m n G D s s' a A da rs.ok rs.ok' rs.eq wD ;
    cvaa' : Der n (jeq D as' as As') =
      eq-sym n D as as' As' (eq-conv n D as as' As As' cvaa eA (eq-pre n (jeq D As As' (uu n)) eA).2) ;

    -- a[s] and a[s'] related at the typed elements of [[a]], at both types
    raa-at (u c : Ty) (mu : (sem m a rho).mem u) (mc : (sem m A rho).mem c) (hc : Tp (el u c)) :
        TmR u As as as' * TmR u As' as as' =
      (cl6 u c hc As as (Sub.trav m a' n s) as' t-ss.1
         (cl4 u c hc As as' (Sub.trav m a' n s) t-s's.2),
       cl6 u c hc As' as (Sub.trav m a' n s') as' t-ss'.2
         (cl4 u c hc As' as' (Sub.trav m a' n s') t-s's'.1))
      where {
        t-ss' : TmR u As as (Sub.trav m a' n s') * TmR u As' as (Sub.trav m a' n s') = ra rho fi s s' rs u c mu mc hc ;
        t-ss : TmR u As as (Sub.trav m a' n s) * TmR u As as (Sub.trav m a' n s) =
          ra rho fi s s (rels-diag m G rho s s' rs) u c mu mc hc ;
        t-s's : TmR u As' as' (Sub.trav m a' n s) * TmR u As as' (Sub.trav m a' n s) =
          ra rho fi s' s (rels-sym m G rho s s' rs) u c mu mc hc ;
        t-s's' : TmR u As' as' (Sub.trav m a' n s') * TmR u As' as' (Sub.trav m a' n s') =
          ra rho fi s' s' (rels-diag m G rho s' s (rels-sym m G rho s s' rs)) u c mu mc hc ; } ;

    raa : ArgR m A rho (sem m a rho) s s' as as' = \ u c mu mc hc -> raa-at u c mu mc hc ;

    rho2 : Env (suc m) = extE m rho (sem m a rho) ;
    fi2 : Fits (suc m) (ext m G A) rho2 = (fi, (tyuA, soundness-ty m G a A da rho fi)) ;
    rs2 : RelS (suc m) (ext m G A) rho2 (consS m n s as) (consS m n s' as') =
      rels-ext m G A rho (sem m a rho) s s' as as' rs cvaa cvaa' raa ;

    -- the type B[a] related to itself, from B : U over (G, A)
    tyB (B : Tm (suc m)) (rB : Ad (suc m) (ext m G A) B B (uu (suc m))) (c : Ty)
        (mc : (sem m (subst1 m B a) rho).mem c) (hc : Tp (el c univ)) :
        TyR c (Sub.trav m (subst1 m B a) n s) (Sub.trav m (subst1 m B a) n s') =
      tyr-tr c (Sub.trav (suc m) B n (consS m n s as)) (Sub.trav (suc m) B n (consS m n s' as'))
        (Sub.trav m (subst1 m B a) n s) (Sub.trav m (subst1 m B a) n s')
        (eq-cons-sub m n s B a) (eq-cons-sub m n s' B a)
        (ad-ty (suc m) (ext m G A) B B rB rho2 fi2 (consS m n s as) (consS m n s' as') rs2 c
           ((subst1-sem m B a rho).1 c mc) hc) ;
  } ;

  ----------------------------------------------------------------------
  -- app

  app-at (m : Nat) (G : Ctx m) (A : Tm m) (B : Tm (suc m)) (f f' a a' : Tm m)
      (h1 : Der m (jty G A (uu m))) (df : Der m (jty G f (pp m A B))) (ea : Der m (jeq G a a' A))
      (rf : Ad m G f f' (pp m A B)) (ra : Ad m G a a' A)
      (rho : Env m) (fi : Fits m G rho) (s s' : Fin m -> Tm n) (rs : RelS m G rho s s') (z : Ty)
      (mz : (sem m (app m f a) rho).mem z) :
      TmR z (Sub.trav m (subst1 m B a) n s) (Sub.trav m (app m f a) n s) (Sub.trav m (app m f' a') n s') =
    tmr-tr z (subst1 n Bs (Sub.trav m a n s)) (Sub.trav m (subst1 m B a) n s)
      (sym (Tm n) (Sub.trav m (subst1 m B a) n s) (subst1 n Bs (Sub.trav m a n s)) (sub-subst1 m n s B a))
      (Sub.trav m (app m f a) n s) (Sub.trav m (app m f' a') n s')
      (cmono-tm i.2.1 z i.2.2.2.2 (subst1 n Bs (Sub.trav m a n s)) (Sub.trav m (app m f a) n s) (Sub.trav m (app m f' a') n s') ap.c3)
    where {
      Bs : Tm (suc n) = Sub.trav (suc m) B (suc n) (Sub.lift m n s) ;
      As : Tm n = Sub.trav m A n s ;
      w : AppW (sem m f rho) (sem m a rho) z = (sem-app-eq m f a rho).1 z mz ;
      eg : Enl (sem m f rho) (sem m (pp m A B) rho) w.g = soundness-ty m G f (pp m A B) df rho fi w.g w.ing ;
      ex : Enl (sem m a rho) (sem m A rho) w.x =
        soundness-ty m G a A (eq-pre m (jeq G a a' A) ea).1 rho fi w.x w.inx ;
      i : InvArr eg.v ex.v z =
        inv-arr eg.v ex.v z
          (le-trans eg.v w.g (arr ex.v z) eg.below
             (le-trans w.g (arr w.x z) (arr ex.v z) w.le (le-arr w.x ex.v z z ex.below (le-refl z)))) ;
      tf : TmR eg.v (pp n As Bs) (Sub.trav m f n s) (Sub.trav m f' n s') = (rf rho fi s s' rs eg.v eg.c eg.inA eg.inB eg.tp).1 ;
      ta : TmR ex.v As (Sub.trav m a n s) (Sub.trav m a' n s') = (ra rho fi s s' rs ex.v ex.c ex.inA ex.inB ex.tp).1 ;
      ap : AppC Can i.2.1 (subst1 n Bs (Sub.trav m a n s)) (Sub.trav m f n s) (Sub.trav m f' n s')
             (Sub.trav m a n s) (Sub.trav m a' n s') =
        ((tmr-unfold eg.v (pp n As Bs) (Sub.trav m f n s) (Sub.trav m f' n s')).1 tf).fn As Bs (rrefl n (pp n As Bs))
          i.1 i.2.1 i.2.2.1 (Sub.trav m a n s) (Sub.trav m a' n s')
          (new ArgRC[Can, i.1, As, Sub.trav m a n s, Sub.trav m a' n s', cd := cons-down ex.v i.1 i.2.2.2.1 (tp-cons ex.v ex.c ex.tp),
                    cv := ArgCase[m, G, A, a, a', h1, ea, ra, rho, fi, s, s', rs].cva,
                    rel := cmono-tm ex.v i.1 i.2.2.2.1 As (Sub.trav m a n s) (Sub.trav m a' n s') ta]) ; } ;

  ad-app (m : Nat) (G : Ctx m) (A : Tm m) (B : Tm (suc m)) (f f' a a' : Tm m)
      (h1 : Der m (jty G A (uu m))) (df : Der m (jty G f (pp m A B))) (ea : Der m (jeq G a a' A))
      (rf : Ad m G f f' (pp m A B)) (ra : Ad m G a a' A) (rB : Ad (suc m) (ext m G A) B B (uu (suc m))) :
      Ad m G (app m f a) (app m f' a') (subst1 m B a) =
    \ rho fi s s' rs z c mz mc hc ->
      (app-at m G A B f f' a a' h1 df ea rf ra rho fi s s' rs z mz,
       cl5 z c hc (Sub.trav m (subst1 m B a) n s) (Sub.trav m (subst1 m B a) n s')
         (Sub.trav m (app m f a) n s) (Sub.trav m (app m f' a') n s')
         (ArgCase[m, G, A, a, a', h1, ea, ra, rho, fi, s, s', rs].tyB B rB c mc (tp-pre z c hc))
         (app-at m G A B f f' a a' h1 df ea rf ra rho fi s s' rs z mz)) ;

  ----------------------------------------------------------------------
  -- beta

  beta-at (m : Nat) (G : Ctx m) (A : Tm m) (B M : Tm (suc m)) (a : Tm m)
      (h1 : Der m (jty G A (uu m))) (h2 : Der (suc m) (jty (ext m G A) B (uu (suc m))))
      (h3 : Der (suc m) (jty (ext m G A) M B)) (h4 : Der m (jty G a A))
      (r3 : Ad (suc m) (ext m G A) M M B) (r4 : Ad m G a a A)
      (rho : Env m) (fi : Fits m G rho) (s s' : Fin m -> Tm n) (rs : RelS m G rho s s') (s1 : Fin m -> Tm n) (u c : Ty)
      (mu : (sem m (app m (lam m A M) a) rho).mem u) (mc : (sem m (subst1 m B a) rho).mem c) (hc : Tp (el u c))
      (t : TmR u (Sub.trav (suc m) B n (consS m n s1 (Sub.trav m a n s1)))
             (Sub.trav (suc m) M n (consS m n s (Sub.trav m a n s))) (Sub.trav (suc m) M n (consS m n s' (Sub.trav m a n s')))) :
      TmR u (Sub.trav m (subst1 m B a) n s1) (Sub.trav m (app m (lam m A M) a) n s) (Sub.trav m (subst1 m M a) n s') =
    cl7 u (Sub.trav m (subst1 m B a) n s1) (Sub.trav m (app m (lam m A M) a) n s) (Sub.trav m (subst1 m M a) n s')
      (subst1 n (Sub.trav (suc m) M (suc n) (Sub.lift m n s)) (Sub.trav m a n s)) (Sub.trav m (subst1 m M a) n s')
      (reds-beta n (Sub.trav m A n s) (Sub.trav (suc m) M (suc n) (Sub.lift m n s)) (Sub.trav m a n s))
      (rrefl n (Sub.trav m (subst1 m M a) n s'))
      (tmr-tr u (Sub.trav (suc m) B n (consS m n s1 (Sub.trav m a n s1))) (Sub.trav m (subst1 m B a) n s1) (eq-cons-sub m n s1 B a)
         (subst1 n (Sub.trav (suc m) M (suc n) (Sub.lift m n s)) (Sub.trav m a n s)) (Sub.trav m (subst1 m M a) n s')
         (tmr-trr u (Sub.trav (suc m) B n (consS m n s1 (Sub.trav m a n s1)))
            (subst1 n (Sub.trav (suc m) M (suc n) (Sub.lift m n s)) (Sub.trav m a n s))
            (Sub.trav (suc m) M n (consS m n s' (Sub.trav m a n s'))) (Sub.trav m (subst1 m M a) n s')
            (eq-cons-sub m n s' M a)
            (tmr-trl u (Sub.trav (suc m) B n (consS m n s1 (Sub.trav m a n s1)))
               (Sub.trav (suc m) M n (consS m n s (Sub.trav m a n s)))
               (subst1 n (Sub.trav (suc m) M (suc n) (Sub.lift m n s)) (Sub.trav m a n s))
               (Sub.trav (suc m) M n (consS m n s' (Sub.trav m a n s')))
               (eq-cons m n s (Sub.trav m a n s) M) t))) ;

  ad-beta-at (m : Nat) (G : Ctx m) (A : Tm m) (B M : Tm (suc m)) (a : Tm m)
      (h1 : Der m (jty G A (uu m))) (h2 : Der (suc m) (jty (ext m G A) B (uu (suc m))))
      (h3 : Der (suc m) (jty (ext m G A) M B)) (h4 : Der m (jty G a A))
      (r3 : Ad (suc m) (ext m G A) M M B) (r4 : Ad m G a a A)
      (rho : Env m) (fi : Fits m G rho) (s s' : Fin m -> Tm n) (rs : RelS m G rho s s') (u c : Ty)
      (mu : (sem m (app m (lam m A M) a) rho).mem u) (mc : (sem m (subst1 m B a) rho).mem c) (hc : Tp (el u c)) :
      TmR u (Sub.trav m (subst1 m B a) n s) (Sub.trav m (app m (lam m A M) a) n s) (Sub.trav m (subst1 m M a) n s') *
      TmR u (Sub.trav m (subst1 m B a) n s') (Sub.trav m (app m (lam m A M) a) n s) (Sub.trav m (subst1 m M a) n s') =
    (beta-at m G A B M a h1 h2 h3 h4 r3 r4 rho fi s s' rs s u c mu mc hc t.1,
     beta-at m G A B M a h1 h2 h3 h4 r3 r4 rho fi s s' rs s' u c mu mc hc t.2)
    where {
      mu2 : (sem (suc m) M (extE m rho (sem m a rho))).mem u =
        (subst1-sem m M a rho).1 u
          ((soundness-eq m G (app m (lam m A M) a) (subst1 m M a) (subst1 m B a) (eq-beta m G A B M a h1 h2 h3 h4) rho fi).1 u mu) ;
      t : TmR u (Sub.trav (suc m) B n (consS m n s (Sub.trav m a n s)))
            (Sub.trav (suc m) M n (consS m n s (Sub.trav m a n s))) (Sub.trav (suc m) M n (consS m n s' (Sub.trav m a n s'))) *
          TmR u (Sub.trav (suc m) B n (consS m n s' (Sub.trav m a n s')))
            (Sub.trav (suc m) M n (consS m n s (Sub.trav m a n s))) (Sub.trav (suc m) M n (consS m n s' (Sub.trav m a n s'))) =
        r3 (extE m rho (sem m a rho)) (ArgCase[m, G, A, a, a, h1, eq-refl m G a A h4, r4, rho, fi, s, s', rs].fi2)
          (consS m n s (Sub.trav m a n s)) (consS m n s' (Sub.trav m a n s'))
          (ArgCase[m, G, A, a, a, h1, eq-refl m G a A h4, r4, rho, fi, s, s', rs].rs2)
          u c mu2 ((subst1-sem m B a rho).1 c mc) hc ; } ;

  ad-beta (m : Nat) (G : Ctx m) (A : Tm m) (B M : Tm (suc m)) (a : Tm m)
      (h1 : Der m (jty G A (uu m))) (h2 : Der (suc m) (jty (ext m G A) B (uu (suc m))))
      (h3 : Der (suc m) (jty (ext m G A) M B)) (h4 : Der m (jty G a A))
      (r3 : Ad (suc m) (ext m G A) M M B) (r4 : Ad m G a a A) :
      Ad m G (app m (lam m A M) a) (subst1 m M a) (subst1 m B a) =
    \ rho fi s s' rs u c mu mc hc -> ad-beta-at m G A B M a h1 h2 h3 h4 r3 r4 rho fi s s' rs u c mu mc hc ;
} ;
