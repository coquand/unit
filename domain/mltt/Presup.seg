-- Presup.seg: presupposition (step 4a; NOTE-4.txt section 4.4).
--   wf-inv, lookup-ty   P1: wf (G, A) gives A : U; wf G gives lookup G i : U
--   ty-of               P2: M : A gives A : U
--   subst1-conv         a = a' gives B[a] = B[a'] (by beta and app-arg)
--   eq-pre              P3: M = N : A gives M : A and N : A

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ;

------------------------------------------------------------------------
-- P1

WfInv : (n : Nat) -> Ctx n -> U l = split {
  zero -> \ G -> Top ;
  suc m -> \ G -> Der m (jty G.1 G.2 (uu m)) } ;

WfInvJ (n : Nat) : Jf n -> U l = split {
  jwf G -> WfInv n G ;
  jty G M A -> Top ;
  jeq G M N A -> Top } ;

wf-inv : (n : Nat) -> (J : Jf n) -> Der n J -> WfInvJ n J = split {
  wf-emp -> tt ;
  wf-ext n G A h -> h ;
  ty-var n G i h -> tt ;
  ty-conv n G M A B h1 h2 h3 -> tt ;
  ty-U n G h -> tt ;
  ty-Pi n G A B h1 h2 -> tt ;
  ty-Lam n G A B M h1 h2 h3 -> tt ;
  ty-App n G A B f a h1 h2 h3 h4 -> tt ;
  eq-refl n G M A h -> tt ;
  eq-sym n G M N A h -> tt ;
  eq-trans n G M N P A h1 h2 -> tt ;
  eq-conv n G M N A B h1 h2 h3 -> tt ;
  eq-beta n G A B M a h1 h2 h3 h4 -> tt ;
  eq-Pi n G A A' B B' h1 h2 h3 h4 h5 -> tt ;
  eq-funext n G A B f g h1 h2 h3 h4 -> tt ;
  eq-app-fun n G A B f f' a h1 h2 h3 h4 -> tt ;
  eq-app-arg n G A B f a a' h1 h2 h3 h4 -> tt } ;

lookup-ty-ext (n : Nat) (G : Ctx n) (A : Tm n) (dA : Der n (jty G A (uu n)))
    (lG : (i : Fin n) -> Der n (jty G (lookup n G i) (uu n))) :
    (i : Fin (suc n)) -> Der (suc n) (jty (ext n G A) (lookup (suc n) (ext n G A) i) (uu (suc n))) = split {
  none -> wk-ty n G A A (uu n) dA dA ;
  some i -> wk-ty n G A (lookup n G i) (uu n) dA (lG i) } ;

lookup-ty : (n : Nat) -> (G : Ctx n) -> Der n (jwf G) -> (i : Fin n) -> Der n (jty G (lookup n G i) (uu n)) = split {
  zero -> \ G w i -> efq i ;
  suc n | r -> \ G w ->
    lookup-ty-ext n G.1 G.2 (wf-inv (suc n) (jwf G) w)
      (r G.1 (wf-of n (jty G.1 G.2 (uu n)) (wf-inv (suc n) (jwf G) w))) } ;

------------------------------------------------------------------------
-- P2

TyJ (n : Nat) : Jf n -> U l = split {
  jwf G -> Top ;
  jty G M A -> Der n (jty G A (uu n)) ;
  jeq G M N A -> Top } ;

ty-of : (n : Nat) -> (J : Jf n) -> Der n J -> TyJ n J = split {
  wf-emp -> tt ;
  wf-ext n G A h -> tt ;
  ty-var n G i h -> lookup-ty n G h i ;
  ty-conv n G M A B h1 h2 h3 -> h3 ;
  ty-U n G h -> ty-U n G h ;
  ty-Pi n G A B h1 h2 -> ty-U n G (wf-of n (jty G A (uu n)) h1) ;
  ty-Lam n G A B M h1 h2 h3 -> ty-Pi n G A B h1 h2 ;
  ty-App n G A B f a h1 h2 h3 h4 -> subst1-ty n G A a B (uu (suc n)) (wf-of n (jty G A (uu n)) h1) h4 h2 ;
  eq-refl n G M A h -> tt ;
  eq-sym n G M N A h -> tt ;
  eq-trans n G M N P A h1 h2 -> tt ;
  eq-conv n G M N A B h1 h2 h3 -> tt ;
  eq-beta n G A B M a h1 h2 h3 h4 -> tt ;
  eq-Pi n G A A' B B' h1 h2 h3 h4 h5 -> tt ;
  eq-funext n G A B f g h1 h2 h3 h4 -> tt ;
  eq-app-fun n G A B f f' a h1 h2 h3 h4 -> tt ;
  eq-app-arg n G A B f a a' h1 h2 h3 h4 -> tt } ;

------------------------------------------------------------------------
-- P3

-- B[a] = B[a'], by app-arg at lam A B : Pi A U and beta at a and a'
subst1-conv (n : Nat) (G : Ctx n) (A : Tm n) (B : Tm (suc n)) (a a' : Tm n)
    (dA : Der n (jty G A (uu n))) (dB : Der (suc n) (jty (ext n G A) B (uu (suc n))))
    (da : Der n (jty G a A)) (da' : Der n (jty G a' A)) (e : Der n (jeq G a a' A)) :
    Der n (jeq G (subst1 n B a) (subst1 n B a') (uu n)) =
  eq-trans n G (subst1 n B a) (app n (lam n A B) a) (subst1 n B a') (uu n)
    (eq-sym n G (app n (lam n A B) a) (subst1 n B a) (uu n) (eq-beta n G A (uu (suc n)) B a dA dU dB da))
    (eq-trans n G (app n (lam n A B) a) (app n (lam n A B) a') (subst1 n B a') (uu n)
       (eq-app-arg n G A (uu (suc n)) (lam n A B) a a' dA dU (ty-Lam n G A (uu (suc n)) B dA dU dB) e)
       (eq-beta n G A (uu (suc n)) B a' dA dU dB da'))
  where { dU : Der (suc n) (jty (ext n G A) (uu (suc n)) (uu (suc n))) = ty-U (suc n) (ext n G A) (wf-ext n G A dA) ; } ;

PreJ (n : Nat) : Jf n -> U l = split {
  jwf G -> Top ;
  jty G M A -> Top ;
  jeq G M N A -> Der n (jty G M A) * Der n (jty G N A) } ;

eq-pre : (n : Nat) -> (J : Jf n) -> Der n J -> PreJ n J = split {
  wf-emp -> tt ;
  wf-ext n G A h -> tt ;
  ty-var n G i h -> tt ;
  ty-conv n G M A B h1 h2 h3 -> tt ;
  ty-U n G h -> tt ;
  ty-Pi n G A B h1 h2 -> tt ;
  ty-Lam n G A B M h1 h2 h3 -> tt ;
  ty-App n G A B f a h1 h2 h3 h4 -> tt ;
  eq-refl n G M A h -> (h, h) ;
  eq-sym n G M N A h | r -> (r.2, r.1) ;
  eq-trans n G M N P A h1 h2 | r1 r2 -> (r1.1, r2.2) ;
  eq-conv n G M N A B h1 h2 h3 | r1 r2 r3 -> (ty-conv n G M A B r1.1 h2 h3, ty-conv n G N A B r1.2 h2 h3) ;
  eq-beta n G A B M a h1 h2 h3 h4 ->
    (ty-App n G A B (lam n A M) a h1 h2 (ty-Lam n G A B M h1 h2 h3) h4,
     subst1-ty n G A a M B (wf-of n (jty G A (uu n)) h1) h4 h3) ;
  eq-Pi n G A A' B B' h1 h2 h3 h4 h5 | r1 r2 r3 r4 r5 ->
    (ty-Pi n G A B h1 h2, ty-Pi n G A' B' r4.2 (ctxconv-ty n G A A' h1 r4.2 h4 B' (uu (suc n)) h3)) ;
  eq-funext n G A B f g h1 h2 h3 h4 -> (h3, h4) ;
  eq-app-fun n G A B f f' a h1 h2 h3 h4 | r1 r2 r3 r4 ->
    (ty-App n G A B f a h1 h2 r3.1 h4, ty-App n G A B f' a h1 h2 r3.2 h4) ;
  eq-app-arg n G A B f a a' h1 h2 h3 h4 | r1 r2 r3 r4 ->
    (ty-App n G A B f a h1 h2 h3 r4.1,
     ty-conv n G (app n f a') (subst1 n B a') (subst1 n B a) (ty-App n G A B f a' h1 h2 h3 r4.2)
       (eq-sym n G (subst1 n B a) (subst1 n B a') (uu n) (subst1-conv n G A B a a' h1 h2 r4.1 r4.2 h4))
       (subst1-ty n G A a B (uu (suc n)) (wf-of n (jty G A (uu n)) h1) r4.1 h2)) } ;
