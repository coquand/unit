-- Laws.seg: the laws of the relation proved together on the fuel
-- (step 4b; NOTE-4.txt section 4.9): L2 diagonal, L3 symmetry of TyR,
-- L4 symmetry of TmR, L5 conversion, L6 transitivity.  Laws N bundles
-- them at N; the case N+1 of each is a lemma from Laws N (and the laws
-- before it at N+1, in the order of the note).

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Typing[l] ;
open Syntax[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ;
open Filter[l] ; open Reduction[l] ; open LogRel[l] ;

module LawsD (n : Nat) (D : Ctx n) {
  open RelD[n, D] ;

  L2Ty (N : Nat) : U l+ = (Y : Filt) -> (T T' : Tm n) -> TyR N Y T T' -> TyR N Y T T ;
  L2Tm (N : Nat) : U l+ = (X Y : Filt) -> (T M M' : Tm n) -> TmR N X Y T M M' -> TmR N X Y T M M ;
  L3 (N : Nat) : U l+ = (Y : Filt) -> (T T' : Tm n) -> TyR N Y T T' -> TyR N Y T' T ;
  L4 (N : Nat) : U l+ = (X Y : Filt) -> (T M M' : Tm n) -> TmR N X Y T M M' -> TmR N X Y T M' M ;
  L5 (N : Nat) : U l+ =
    (X Y : Filt) -> (T T2 M M' : Tm n) -> TyR N X T T2 -> TmR N X Y T M M' -> TmR N X Y T2 M M' ;
  L6Ty (N : Nat) : U l+ = (Y : Filt) -> (T1 T2 T3 : Tm n) -> TyR N Y T1 T2 -> TyR N Y T2 T3 -> TyR N Y T1 T3 ;
  L6Tm (N : Nat) : U l+ =
    (X Y : Filt) -> (T M1 M2 M3 : Tm n) -> TmR N X Y T M1 M2 -> TmR N X Y T M2 M3 -> TmR N X Y T M1 M3 ;

  record LawsR { N : Nat ;
    dty : L2Ty N ; dtm : L2Tm N ; sty : L3 N ; stm : L4 N ; cv : L5 N ; tty : L6Ty N ; ttm : L6Tm N ; } ;
  Laws (N : Nat) : U l+ = LawsR[N] ;

  ----------------------------------------------------------------------
  -- arguments, at fuel N

  arg-diag (N : Nat) (h : Laws N) (X W : Filt) (A0 P P' : Tm n) (a : Arg (Rel N) X W A0 P P') : Arg (Rel N) X W A0 P P =
    new ArgRec[Rel N, X, W, A0, P, P, hw := a.hw, cv := eq-refl n D P A0 (eq-pre n (jeq D P P' A0) a.cv).1, rel := h.dtm X W A0 P P' a.rel] ;

  arg-sym (N : Nat) (h : Laws N) (X W : Filt) (A0 P P' : Tm n) (a : Arg (Rel N) X W A0 P P') : Arg (Rel N) X W A0 P' P =
    new ArgRec[Rel N, X, W, A0, P', P, hw := a.hw, cv := eq-sym n D P P' A0 a.cv, rel := h.stm X W A0 P P' a.rel] ;

  arg-conv (N : Nat) (h : Laws N) (X W : Filt) (A0 A2 P P' : Tm n) (a : Arg (Rel N) X W A0 P P')
      (tr : TyR N X A0 A2) (e : Der n (jeq D A0 A2 (uu n))) : Arg (Rel N) X W A2 P P' =
    new ArgRec[Rel N, X, W, A2, P, P', hw := a.hw, cv := eq-conv n D P P' A0 A2 a.cv e (eq-pre n (jeq D A0 A2 (uu n)) e).2,
             rel := h.cv X W A0 A2 P P' tr a.rel] ;

  ----------------------------------------------------------------------
  -- L2

  famc-11 (r : RF n -> U l+) (F : Filt) (B0 B1 : Tm (suc n)) (P P' : Tm n) (c : FamC r F B0 B1 P P') :
      FamC r F B0 B0 P P' = new FamCR[r, F, B0, B0, P, P', c1 := c.c1, c2 := c.c1, c3 := c.c1] ;

  appc-11 (r : RF n -> U l+) (F Z : Filt) (B M M' P P' : Tm n) (c : AppC r F Z B M M' P P') :
      AppC r F Z B M M P P' = new AppCR[r, F, Z, B, M, M, P, P', c1 := c.c1, c2 := c.c1, c3 := c.c1] ;

  pity-diag (N : Nat) (h : Laws N) (Y : Filt) (T T' : Tm n) (p : PiTy (Rel N) Y T T') : PiTy (Rel N) Y T T =
    new PiTyR[Rel N, Y, T, T, A0 := p.A0, B0 := p.B0, A1 := p.A0, B1 := p.B0, red := p.red, red' := p.red,
             d := new PiDR[Rel N, Y, p.A0, p.B0, p.A0, p.B0,
               cA := eq-refl n D p.A0 (uu n) (eq-pre n (jeq D p.A0 p.A1 (uu n)) p.d.cA).1,
               cB := eq-refl (suc n) (ext n D p.A0) p.B0 (uu (suc n))
                      (eq-pre (suc n) (jeq (ext n D p.A0) p.B0 p.B1 (uu (suc n))) p.d.cB).1,
               dom := h.dty (Dom Y) p.A0 p.A1 p.d.dom,
               fam := \ W P P' a -> famc-11 (Rel N) (Fam Y W) p.B0 p.B1 P P' (p.d.fam W P P' a)]] ;

  l2ty-step (N : Nat) (h : Laws N) : L2Ty (suc N) = \ Y T T' t ->
    new TyStepR[Rel N, Y, T, T, lo := h.dty Y T T' t.lo, un := \ u -> ((t.un u).1, (t.un u).1), pc := \ p -> pity-diag N h Y T T' (t.pc p)] ;

  l2tm-step (N : Nat) (h : Laws N) (d1 : L2Ty (suc N)) : L2Tm (suc N) = \ X Y T M M' t ->
    new TmStepR[Rel N, X, Y, T, M, M, lo := h.dtm X Y T M M' t.lo,
             un := \ u -> d1 Y M M' (t.un u),
             pc := \ p A0 B0 rT W P P' a ->
               appc-11 (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M M' P P' (t.pc p A0 B0 rT W P P' a)] ;

  ----------------------------------------------------------------------
  -- L3

  famc-sym (N : Nat) (h : Laws N) (Y : Filt) (T T' : Tm n) (p : PiTy (Rel N) Y T T') (W : Filt) (P P' : Tm n)
      (a : Arg (Rel N) (Dom Y) W p.A1 P P') : FamC (Rel N) (Fam Y W) p.B1 p.B0 P P' =
    new FamCR[Rel N, Fam Y W, p.B1, p.B0, P, P', c1 := f.c2, c2 := f.c1, c3 := h.sty (Fam Y W) (subst1 n p.B0 P') (subst1 n p.B1 P) fs.c3]
    where {
      a0 : Arg (Rel N) (Dom Y) W p.A0 P P' =
        arg-conv N h (Dom Y) W p.A1 p.A0 P P' a (h.sty (Dom Y) p.A0 p.A1 p.d.dom) (eq-sym n D p.A0 p.A1 (uu n) p.d.cA) ;
      f : FamC (Rel N) (Fam Y W) p.B0 p.B1 P P' = p.d.fam W P P' a0 ;
      fs : FamC (Rel N) (Fam Y W) p.B0 p.B1 P' P = p.d.fam W P' P (arg-sym N h (Dom Y) W p.A0 P P' a0) ; } ;

  pity-sym (N : Nat) (h : Laws N) (Y : Filt) (T T' : Tm n) (p : PiTy (Rel N) Y T T') : PiTy (Rel N) Y T' T =
    new PiTyR[Rel N, Y, T', T, A0 := p.A1, B0 := p.B1, A1 := p.A0, B1 := p.B0, red := p.red', red' := p.red,
             d := new PiDR[Rel N, Y, p.A1, p.B1, p.A0, p.B0,
               cA := eq-sym n D p.A0 p.A1 (uu n) p.d.cA,
               cB := ctxconv-eq n D p.A0 p.A1 (eq-pre n (jeq D p.A0 p.A1 (uu n)) p.d.cA).1
                      (eq-pre n (jeq D p.A0 p.A1 (uu n)) p.d.cA).2 p.d.cA p.B1 p.B0 (uu (suc n))
                      (eq-sym (suc n) (ext n D p.A0) p.B0 p.B1 (uu (suc n)) p.d.cB),
               dom := h.sty (Dom Y) p.A0 p.A1 p.d.dom,
               fam := \ W P P' a -> famc-sym N h Y T T' p W P P' a]] ;

  l3-step (N : Nat) (h : Laws N) : L3 (suc N) = \ Y T T' t ->
    new TyStepR[Rel N, Y, T', T, lo := h.sty Y T T' t.lo, un := \ u -> ((t.un u).2, (t.un u).1), pc := \ p -> pity-sym N h Y T T' (t.pc p)] ;

  ----------------------------------------------------------------------
  -- L4

  appc-sym (N : Nat) (h : Laws N) (X Y : Filt) (T M M' : Tm n) (t : TmR (suc N) X Y T M M') (p : IsPi X)
      (A0 : Tm n) (B0 : Tm (suc n)) (rT : Reds n T (pp n A0 B0)) (W : Filt) (P P' : Tm n)
      (a : Arg (Rel N) (Dom X) W A0 P P') : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M' M P P' =
    new AppCR[Rel N, Fam X W, appF Y W, subst1 n B0 P, M', M, P, P', c1 := c.c2, c2 := c.c1,
             c3 := h.ttm (Fam X W) (appF Y W) (subst1 n B0 P) (app n M' P) (app n M P) (app n M P')
                    (h.stm (Fam X W) (appF Y W) (subst1 n B0 P) (app n M P) (app n M' P) cd.c3) c.c1]
    where {
      c : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M M' P P' = t.pc p A0 B0 rT W P P' a ;
      cd : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M M' P P =
        t.pc p A0 B0 rT W P P (arg-diag N h (Dom X) W A0 P P' a) ; } ;

  l4-step (N : Nat) (h : Laws N) (s1 : L3 (suc N)) : L4 (suc N) = \ X Y T M M' t ->
    new TmStepR[Rel N, X, Y, T, M', M, lo := h.stm X Y T M M' t.lo,
             un := \ u -> s1 Y M M' (t.un u),
             pc := \ p A0 B0 rT W P P' a -> appc-sym N h X Y T M M' t p A0 B0 rT W P P' a] ;

  ----------------------------------------------------------------------
  -- L5

  appc-conv (N : Nat) (h : Laws N) (X Y : Filt) (T T2 M M' : Tm n) (ty : TyR (suc N) X T T2)
      (t : TmR (suc N) X Y T M M') (p : IsPi X) (A2 : Tm n) (B2 : Tm (suc n)) (r2 : Reds n T2 (pp n A2 B2))
      (W : Filt) (P P' : Tm n) (a : Arg (Rel N) (Dom X) W A2 P P') :
      AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B2 P) M M' P P' =
    new AppCR[Rel N, Fam X W, appF Y W, subst1 n B2 P, M, M', P, P',
             c1 := h.cv (Fam X W) (appF Y W) (subst1 n q.B0 P) (subst1 n B2 P) (app n M P) (app n M P') fc.c3 c.c1,
             c2 := h.cv (Fam X W) (appF Y W) (subst1 n q.B0 P) (subst1 n B2 P) (app n M' P) (app n M' P') fc.c3 c.c2,
             c3 := h.cv (Fam X W) (appF Y W) (subst1 n q.B0 P) (subst1 n B2 P) (app n M P) (app n M' P') fc.c3 c.c3]
    where {
      q : PiTy (Rel N) X T T2 = ty.pc p ;
      dq : PiD (Rel N) X q.A0 q.B0 A2 B2 =
        pid-r (Rel N) X q.A0 q.B0 q.A1 A2 q.B1 B2 (reds-pp n T2 q.A1 A2 q.B1 B2 q.red' r2) q.d ;
      a0 : Arg (Rel N) (Dom X) W q.A0 P P' =
        arg-conv N h (Dom X) W A2 q.A0 P P' a (h.sty (Dom X) q.A0 A2 dq.dom) (eq-sym n D q.A0 A2 (uu n) dq.cA) ;
      c : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n q.B0 P) M M' P P' = t.pc p q.A0 q.B0 q.red W P P' a0 ;
      fc : FamC (Rel N) (Fam X W) q.B0 B2 P P = dq.fam W P P (arg-diag N h (Dom X) W q.A0 P P' a0) ; } ;

  l5-step (N : Nat) (h : Laws N) : L5 (suc N) = \ X Y T T2 M M' ty t ->
    new TmStepR[Rel N, X, Y, T2, M, M', lo := h.cv X Y T T2 M M' ty.lo t.lo,
             un := \ u -> t.un u,
             pc := \ p A2 B2 r2 W P P' a -> appc-conv N h X Y T T2 M M' ty t p A2 B2 r2 W P P' a] ;

  ----------------------------------------------------------------------
  -- L6

  famc-trans (N : Nat) (h : Laws N) (Y : Filt) (A0 : Tm n) (B0 : Tm (suc n)) (A1 : Tm n) (B1 : Tm (suc n))
      (A2 : Tm n) (B2 : Tm (suc n)) (p : PiD (Rel N) Y A0 B0 A1 B1) (q : PiD (Rel N) Y A1 B1 A2 B2)
      (W : Filt) (P P' : Tm n) (a : Arg (Rel N) (Dom Y) W A0 P P') : FamC (Rel N) (Fam Y W) B0 B2 P P' =
    new FamCR[Rel N, Fam Y W, B0, B2, P, P', c1 := f1.c1, c2 := f2.c2,
             c3 := h.tty (Fam Y W) (subst1 n B0 P) (subst1 n B1 P') (subst1 n B2 P') f1.c3 f2d.c3]
    where {
      f1 : FamC (Rel N) (Fam Y W) B0 B1 P P' = p.fam W P P' a ;
      a1 : Arg (Rel N) (Dom Y) W A1 P P' = arg-conv N h (Dom Y) W A0 A1 P P' a p.dom p.cA ;
      f2 : FamC (Rel N) (Fam Y W) B1 B2 P P' = q.fam W P P' a1 ;
      f2d : FamC (Rel N) (Fam Y W) B1 B2 P' P' =
        q.fam W P' P' (arg-diag N h (Dom Y) W A1 P' P (arg-sym N h (Dom Y) W A1 P P' a1)) ; } ;

  pid-trans (N : Nat) (h : Laws N) (Y : Filt) (A0 : Tm n) (B0 : Tm (suc n)) (A1 : Tm n) (B1 : Tm (suc n))
      (A2 : Tm n) (B2 : Tm (suc n)) (p : PiD (Rel N) Y A0 B0 A1 B1) (q : PiD (Rel N) Y A1 B1 A2 B2) :
      PiD (Rel N) Y A0 B0 A2 B2 =
    new PiDR[Rel N, Y, A0, B0, A2, B2,
      cA := eq-trans n D A0 A1 A2 (uu n) p.cA q.cA,
      cB := eq-trans (suc n) (ext n D A0) B0 B1 B2 (uu (suc n)) p.cB
             (ctxconv-eq n D A1 A0 (eq-pre n (jeq D A0 A1 (uu n)) p.cA).2 (eq-pre n (jeq D A0 A1 (uu n)) p.cA).1
                (eq-sym n D A0 A1 (uu n) p.cA) B1 B2 (uu (suc n)) q.cB),
      dom := h.tty (Dom Y) A0 A1 A2 p.dom q.dom,
      fam := \ W P P' a -> famc-trans N h Y A0 B0 A1 B1 A2 B2 p q W P P' a] ;

  pity-trans (N : Nat) (h : Laws N) (Y : Filt) (T1 T2 T3 : Tm n) (p : PiTy (Rel N) Y T1 T2) (q : PiTy (Rel N) Y T2 T3) :
      PiTy (Rel N) Y T1 T3 =
    new PiTyR[Rel N, Y, T1, T3, A0 := p.A0, B0 := p.B0, A1 := q.A1, B1 := q.B1, red := p.red, red' := q.red',
             d := pid-trans N h Y p.A0 p.B0 p.A1 p.B1 q.A1 q.B1 p.d
                   (pid-l (Rel N) Y q.A0 p.A1 q.B0 p.B1 q.A1 q.B1 (reds-pp n T2 q.A0 p.A1 q.B0 p.B1 q.red p.red') q.d)] ;

  l6ty-step (N : Nat) (h : Laws N) : L6Ty (suc N) = \ Y T1 T2 T3 t1 t2 ->
    new TyStepR[Rel N, Y, T1, T3, lo := h.tty Y T1 T2 T3 t1.lo t2.lo,
             un := \ u -> ((t1.un u).1, (t2.un u).2),
             pc := \ p -> pity-trans N h Y T1 T2 T3 (t1.pc p) (t2.pc p)] ;

  appc-trans (N : Nat) (h : Laws N) (X Y : Filt) (T M1 M2 M3 : Tm n) (t1 : TmR (suc N) X Y T M1 M2)
      (t2 : TmR (suc N) X Y T M2 M3) (p : IsPi X) (A0 : Tm n) (B0 : Tm (suc n)) (rT : Reds n T (pp n A0 B0))
      (W : Filt) (P P' : Tm n) (a : Arg (Rel N) (Dom X) W A0 P P') :
      AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M1 M3 P P' =
    new AppCR[Rel N, Fam X W, appF Y W, subst1 n B0 P, M1, M3, P, P', c1 := c1.c1, c2 := c2.c2,
             c3 := h.ttm (Fam X W) (appF Y W) (subst1 n B0 P) (app n M1 P) (app n M2 P) (app n M3 P') c1d.c3 c2.c3]
    where {
      c1 : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M1 M2 P P' = t1.pc p A0 B0 rT W P P' a ;
      c2 : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M2 M3 P P' = t2.pc p A0 B0 rT W P P' a ;
      c1d : AppC (Rel N) (Fam X W) (appF Y W) (subst1 n B0 P) M1 M2 P P =
        t1.pc p A0 B0 rT W P P (arg-diag N h (Dom X) W A0 P P' a) ; } ;

  l6tm-step (N : Nat) (h : Laws N) (t1' : L6Ty (suc N)) : L6Tm (suc N) = \ X Y T M1 M2 M3 t1 t2 ->
    new TmStepR[Rel N, X, Y, T, M1, M3, lo := h.ttm X Y T M1 M2 M3 t1.lo t2.lo,
             un := \ u -> t1' Y M1 M2 M3 (t1.un u) (t2.un u),
             pc := \ p A0 B0 rT W P P' a -> appc-trans N h X Y T M1 M2 M3 t1 t2 p A0 B0 rT W P P' a] ;

  ----------------------------------------------------------------------
  -- all laws, at every fuel

  laws : (N : Nat) -> Laws N = split {
    zero -> new LawsR[zero,
      dty := \ Y T T' t -> tt, dtm := \ X Y T M M' t -> tt, sty := \ Y T T' t -> tt,
      stm := \ X Y T M M' t -> tt, cv := \ X Y T T2 M M' ty t -> tt,
      tty := \ Y T1 T2 T3 t1 t2 -> tt, ttm := \ X Y T M1 M2 M3 t1 t2 -> tt] ;
    suc N | h -> new LawsR[suc N,
      dty := l2ty-step N h, dtm := l2tm-step N h (l2ty-step N h),
      sty := l3-step N h, stm := l4-step N h (l3-step N h),
      cv := l5-step N h,
      tty := l6ty-step N h, ttm := l6tm-step N h (l6ty-step N h)] } ;
} ;
