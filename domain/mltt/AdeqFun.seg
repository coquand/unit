-- AdeqFun.seg: adequacy (NOTE-4.txt 4.14.3), the case funext.  The
-- selection of u is read through the representative f0 of u : c; the
-- third conclusion is the premise f x = g x at (s, P), (s', P'), the
-- first the typing of f, the second by L4, L6 from the premise at
-- (s, P), (s', P); the type at s' by L6 from the typing of f.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ; open Cross[l] ;
open Filter[l] ; open Sem[l] ; open Sound[l] ; open Reduction[l] ; open RelC[l] ; open LawsC[l] ; open AdeqBase[l] ;
open AdeqPi[l] ; open AdeqLam[l] ;

module AdeqF (n : Nat) (D : Ctx n) (wD : Der n (jwf D)) {
  open RelCD[n, D] ;
  open LawsCD[n, D] ;
  open AdeqB[n, D] ;
  open AdeqP[n, D, wD] ;
  open AdeqL[n, D, wD] ;

  module FunCase (m : Nat) (G : Ctx m) (A : Tm m) (B : Tm (suc m)) (f g : Tm m)
      (h1 : Der m (jty G A (uu m)))
      (r1 : Ad m G A A (uu m))
      (r2 : Ad (suc m) (ext m G A) (app (suc m) (wk m f) (var (suc m) (fz m))) (app (suc m) (wk m g) (var (suc m) (fz m))) B)
      (r3 : Ad m G f f (pp m A B))
      (rho : Env m) (fi : Fits m G rho) (s s' : Fin m -> Tm n) (rs : RelS m G rho s s') {

    As : Tm n = Sub.trav m A n s ;
    As' : Tm n = Sub.trav m A n s' ;
    Bs : Tm (suc n) = Sub.trav (suc m) B (suc n) (Sub.lift m n s) ;
    fs : Tm n = Sub.trav m f n s ;
    gs' : Tm n = Sub.trav m g n s' ;
    -- the premise's sides at (s1, Q)
    Fx (s1 : Fin m -> Tm n) (Q : Tm n) : Tm n = Sub.trav (suc m) (app (suc m) (wk m f) (var (suc m) (fz m))) n (consS m n s1 Q) ;
    Gx (s1 : Fin m -> Tm n) (Q : Tm n) : Tm n = Sub.trav (suc m) (app (suc m) (wk m g) (var (suc m) (fz m))) n (consS m n s1 Q) ;

    tyuA : TyU (sem m A rho) = tyu-of m A rho (soundness-ty m G A (uu m) h1 rho fi) ;
    eA : Der n (jeq D As As' (uu n)) = subst-cross m n G D s s' A (uu m) h1 rs.ok rs.ok' rs.eq wD ;

    -- the application of the weakening is the application
    fx-eq (h : Tm m) (s1 : Fin m -> Tm n) (Q : Tm n) :
        Id (Tm n) (Sub.trav (suc m) (app (suc m) (wk m h) (var (suc m) (fz m))) n (consS m n s1 Q)) (app n (Sub.trav m h n s1) Q) =
      cong-app n (Sub.trav (suc m) (wk m h) n (consS m n s1 Q)) (Sub.trav m h n s1) Q Q (consS-wk m n s1 Q h) (refl Q) ;

    module At (u c : Ty) (mu : (sem m f rho).mem u) (mc : (sem m (pp m A B) rho).mem c) (hc : Tp (el u c))
        (mcpi : (piF (sem m A rho) (fam m B rho)).mem c) (Ac phic f0 : Ty) (e1 : Eqv u f0) (e2 : Eqv c (pi Ac phic))
        (hpi : Tp (el (pi Ac phic) univ)) (h2' : Tp (ent f0 Ac phic)) (cf : Cons f0)
        (d t : Ty) (q : ASel u d t) (P P' : Tm n) (a : Arg Can d As P P') {

      i : InvArr f0 d t = inv-arr f0 d t (le-trans f0 u (arr d t) e1.2 (asel-le u d t q)) ;
      cd2 : Cons i.1 = cons-down d i.1 i.2.2.2.1 a.cd ;
      hd2 : Tp (el i.1 Ac) = key-tp f0 i.1 i.2.1 i.2.2.1 Ac phic h2' (pi-dom Ac phic hpi) cd2 ;
      sv : SelT phic i.1 i.2.1 = sel-val f0 Ac phic i.1 i.2.1 h2' cf hpi i.2.2.1 cd2 ;
      pin : PiIn (sem m A rho) (fam m B rho) Ac phic = pi-in-pi (sem m A rho) (fam m B rho) c Ac phic e2.1 mcpi ;
      rho' : Env (suc m) = extE m rho (prin i.1) ;
      fi' : Fits (suc m) (ext m G A) rho' = fits-ext m G A rho i.1 fi tyuA (new TyInR[sem m A rho, i.1, a := Ac, ina := pin.inA1, tp := hd2]) ;
      my : (sem (suc m) B rho').mem sv.1 = fam-mem-le m A B rho Ac phic pin i.1 sv.1 sv.2.1 ;
      mt2 : (sem (suc m) (app (suc m) (wk m f) (var (suc m) (fz m))) rho').mem i.2.1 =
        (sem-app-eq (suc m) (wk m f) (var (suc m) (fz m)) rho').2 i.2.1
          (new AppWR[sem (suc m) (wk m f) rho', sem (suc m) (var (suc m) (fz m)) rho', i.2.1, g := f0, x := i.1,
                    ing := (wk-sem m f rho (prin i.1)).2 f0 ((sem m f rho).fup u f0 e1.1 mu),
                    inx := (sem-var-eq (suc m) (fz m) rho').2 i.1 (le-refl i.1),
                    le := asel-le f0 i.1 i.2.1 i.2.2.1]) ;
      tyA : TyR Ac As As' = ad-ty m G A A r1 rho fi s s' rs Ac pin.inA1 (pi-dom Ac phic hpi) ;

      at2 (Q Q' : Tm n) (aQ : TmR d As Q Q') : TmR i.1 As Q Q' = cmono-tm d i.1 i.2.2.2.1 As Q Q' aQ ;
      ar (Q Q' : Tm n) (aQ : TmR d As Q Q') : ArgR m A rho (prin i.1) s s' Q Q' = \ u' c' mu' mc' hc' ->
        (cmono-tm i.1 u' mu' As Q Q' (at2 Q Q' aQ),
         cmono-tm i.1 u' mu' As' Q Q' (cl5 i.1 Ac hd2 As As' Q Q' tyA (at2 Q Q' aQ))) ;

      dP : Der n (jty D P As) = (eq-pre n (jeq D P P' As) a.cv).1 ;
      eP1 : Der n (jeq D P P' As') = eq-conv n D P P' As As' a.cv eA (eq-pre n (jeq D As As' (uu n)) eA).2 ;
      dP1 : Der n (jty D P As') = (eq-pre n (jeq D P P' As') eP1).1 ;

      body (Q Q' : Tm n) (eQ : Der n (jeq D Q Q' As)) (eQ' : Der n (jeq D Q' Q As')) (arQ : ArgR m A rho (prin i.1) s s' Q Q') :
          TmR i.2.1 (Sub.trav (suc m) B n (consS m n s Q)) (Fx s Q) (Gx s' Q') =
        (r2 rho' fi' (consS m n s Q) (consS m n s' Q') (rels-ext m G A rho (prin i.1) s s' Q Q' rs eQ eQ' arQ)
           i.2.1 sv.1 mt2 my sv.2.2).1 ;

      b3 : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (Fx s P) (Gx s' P') =
        body P P' a.cv (eq-sym n D P P' As' eP1) (ar P P' a.rel) ;
      b0 : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (Fx s P) (Gx s' P) =
        body P P (eq-refl n D P As dP) (eq-refl n D P As' dP1) (ar P P (cl2 d As P P' a.rel)) ;
      b2 : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (Gx s' P) (Gx s' P') =
        cl6 i.2.1 sv.1 sv.2.2 (Sub.trav (suc m) B n (consS m n s P)) (Gx s' P) (Fx s P) (Gx s' P')
          (cl4 i.2.1 sv.1 sv.2.2 (Sub.trav (suc m) B n (consS m n s P)) (Fx s P) (Gx s' P) b0) b3 ;

      -- to the application at t
      fin (X1 X2 : Tm n) (h1' h2'' : Tm m) (s1 s2 : Fin m -> Tm n) (Q Q' : Tm n)
          (ex1 : Id (Tm n) X1 (app n (Sub.trav m h1' n s1) Q)) (ex2 : Id (Tm n) X2 (app n (Sub.trav m h2'' n s2) Q'))
          (b : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) X1 X2) :
          TmR t (subst1 n Bs P) (app n (Sub.trav m h1' n s1) Q) (app n (Sub.trav m h2'' n s2) Q') =
        cmono-tm i.2.1 t i.2.2.2.2 (subst1 n Bs P) (app n (Sub.trav m h1' n s1) Q) (app n (Sub.trav m h2'' n s2) Q')
          (tmr-tr i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (subst1 n Bs P) (eq-cons m n s P B)
             (app n (Sub.trav m h1' n s1) Q) (app n (Sub.trav m h2'' n s2) Q')
             (tmr-trr i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (app n (Sub.trav m h1' n s1) Q) X2
                (app n (Sub.trav m h2'' n s2) Q') ex2
                (tmr-trl i.2.1 (Sub.trav (suc m) B n (consS m n s P)) X1 (app n (Sub.trav m h1' n s1) Q) X2 ex1 b))) ;

      c1 : TmR t (subst1 n Bs P) (app n fs P) (app n fs P') =
        (((tmr-unfold u (pp n As Bs) fs fs).1 (r3 rho fi s s (rels-diag m G rho s s' rs) u c mu mc hc).1).fn
           As Bs (rrefl n (pp n As Bs)) d t q P P' a).c1 ;

      appc : AppC Can t (subst1 n Bs P) fs gs' P P' =
        new AppRC[Can, t, subst1 n Bs P, fs, gs', P, P', c1 := c1,
                 c2 := fin (Gx s' P) (Gx s' P') g g s' s' P P' (fx-eq g s' P) (fx-eq g s' P') b2,
                 c3 := fin (Fx s P) (Gx s' P') f g s s' P P' (fx-eq f s P) (fx-eq g s' P') b3] ;
    } ;

    tyc-by (u c : Ty) (mcpi : (piF (sem m A rho) (fam m B rho)).mem c) : Shape u c -> TyC Can u fs gs' = split {
      sh-bot e h -> tyc-om Can u e fs gs' ;
      sh-univ e1 e2 -> absurd (TyC Can u fs gs') (pi-univ-clash (sem m A rho) (fam m B rho) c e2.1 mcpi) ;
      sh-pi Ac phic e1 e2 h1' h2' cp -> absurd (TyC Can u fs gs') (pi-univ-clash (sem m A rho) (fam m B rho) c e2.1 mcpi) ;
      sh-lam Ac phic f0 e1 e2 hpi h2' cf -> tyc-fun Can u f0 Ac phic e1.2 h2' fs gs' } ;

    appc-by (u c : Ty) (mu : (sem m f rho).mem u) (mc : (sem m (pp m A B) rho).mem c) (hc : Tp (el u c))
        (mcpi : (piF (sem m A rho) (fam m B rho)).mem c) (d t : Ty) (q : ASel u d t) (P P' : Tm n) (a : Arg Can d As P P') :
        Shape u c -> AppC Can t (subst1 n Bs P) fs gs' P P' = split {
      sh-bot e h -> appc-all Can t (\ T1 M1 M1' -> tmr-om t (app-bot u d t e q) T1 M1 M1') (subst1 n Bs P) fs gs' P P' ;
      sh-univ e1 e2 -> absurd (AppC Can t (subst1 n Bs P) fs gs' P P') (pi-univ-clash (sem m A rho) (fam m B rho) c e2.1 mcpi) ;
      sh-pi Ac phic e1 e2 h1' h2' cp ->
        absurd (AppC Can t (subst1 n Bs P) fs gs' P P') (pi-univ-clash (sem m A rho) (fam m B rho) c e2.1 mcpi) ;
      sh-lam Ac phic f0 e1 e2 hpi h2' cf -> At[u, c, mu, mc, hc, mcpi, Ac, phic, f0, e1, e2, hpi, h2', cf, d, t, q, P, P', a].appc } ;

    tm1 (u c : Ty) (mu : (sem m f rho).mem u) (mc : (sem m (pp m A B) rho).mem c) (hc : Tp (el u c)) :
        TmR u (pp n As Bs) fs gs' =
      (tmr-unfold u (pp n As Bs) fs gs').2
        (new TmCR[Can, u, pp n As Bs, fs, gs', ty := tyc-by u c mcpi (shape u c hc),
                  fn := fun-at-pp u As Bs fs gs' (\ d t q P P' a -> appc-by u c mu mc hc mcpi d t q P P' a (shape u c hc))])
      where { mcpi : (piF (sem m A rho) (fam m B rho)).mem c = (sem-pp-eq m A B rho).1 c mc ; } ;
  } ;

  ad-funext (m : Nat) (G : Ctx m) (A : Tm m) (B : Tm (suc m)) (f g : Tm m)
      (h1 : Der m (jty G A (uu m)))
      (r1 : Ad m G A A (uu m))
      (r2 : Ad (suc m) (ext m G A) (app (suc m) (wk m f) (var (suc m) (fz m))) (app (suc m) (wk m g) (var (suc m) (fz m))) B)
      (r3 : Ad m G f f (pp m A B)) : Ad m G f g (pp m A B) =
    \ rho fi s s' rs u c mu mc hc ->
      (FunCase[m, G, A, B, f, g, h1, r1, r2, r3, rho, fi, s, s', rs].tm1 u c mu mc hc,
       cl6 u c hc (Sub.trav m (pp m A B) n s') (Sub.trav m f n s) (Sub.trav m f n s') (Sub.trav m g n s')
         (r3 rho fi s s' rs u c mu mc hc).2
         (FunCase[m, G, A, B, f, g, h1, r1, r2, r3, rho, fi, s', s', rels-diag m G rho s' s (rels-sym m G rho s s' rs)].tm1
            u c mu mc hc)) ;
} ;
