-- Consequences.seg: NOTE-4.txt 4.14.4.  The bottom environment fits every
-- well-formed context, the identity is related over it (L1: its elements
-- are om-like), and adequacy at the element pi om om of [[Pi A B]] gives
-- Pi injectivity (paper Corollary 2.37) in any context.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ; open Cross[l] ;
open Filter[l] ; open Sem[l] ; open Sound[l] ; open Reduction[l] ; open RelC[l] ; open LawsC[l] ; open AdeqBase[l] ;
open AdeqPi[l] ; open Adequacy[l] ;

-- the bottom environment
rho0 (m : Nat) : Env m = \ i -> prin om ;

fits-bot : (m : Nat) -> (G : Ctx m) -> Der m (jwf G) -> Fits m G (rho0 m) = split {
  zero -> \ G w -> tt ;
  suc m | r -> \ G w ->
    (r G.1 (wf-of m (jty G.1 G.2 (uu m)) (wf-inv (suc m) (jwf G) w)),
     (tyu-of m G.2 (rho0 m)
        (soundness-ty m G.1 G.2 (uu m) (wf-inv (suc m) (jwf G) w) (rho0 m)
           (r G.1 (wf-of m (jty G.1 G.2 (uu m)) (wf-inv (suc m) (jwf G) w)))),
      \ t mt -> enl-om (prin om) (sem m G.2 (rho0 m)) t mt mt)) } ;

-- B[liftS id] = B
sub-id-lift (m : Nat) (B : Tm (suc m)) : Id (Tm (suc m)) (Sub.trav (suc m) B (suc m) (Sub.lift m m (idS m))) B =
  trans (Tm (suc m)) (Sub.trav (suc m) B (suc m) (Sub.lift m m (idS m))) (Sub.trav (suc m) B (suc m) (idS (suc m))) B
    (SL.trav-ext (suc m) B (suc m) (Sub.lift m m (idS m)) (idS (suc m)) (lift-id m)) (sub-id (suc m) B) ;

-- pi om om is of type U and in every semantic Pi
tp-pi-om : Tp (el (pi om om) univ) =
  t-pi (pi om om) univ om om (eqv-refl (pi om om)) (eqv-refl univ) tp-omU (en-om om (arr om univ)) cons-om ;

pi-om-in (m : Nat) (A : Tm m) (B : Tm (suc m)) (rho : Env m) : (sem m (pp m A B) rho).mem (pi om om) =
  (sem-pp-eq m A B rho).2 (pi om om)
    (inr (new PiWR[sem m A rho, fam m B rho, pi om om, a := om, b := om, le := le-refl (pi om om), ina := (sem m A rho).fom, ents := es-om])) ;

module PiInj (m : Nat) (G : Ctx m) (A A' : Tm m) (B B' : Tm (suc m)) (d : Der m (jeq G (pp m A B) (pp m A' B') (uu m))) {
  open RelCD[m, G] ;
  open LawsCD[m, G] ;
  open AdeqB[m, G] ;

  wG : Der m (jwf G) = wf-of m (jeq G (pp m A B) (pp m A' B') (uu m)) d ;

  Ai : Tm m = Sub.trav m A m (idS m) ;
  Bi : Tm (suc m) = Sub.trav (suc m) B (suc m) (Sub.lift m m (idS m)) ;
  Ai' : Tm m = Sub.trav m A' m (idS m) ;
  Bi' : Tm (suc m) = Sub.trav (suc m) B' (suc m) (Sub.lift m m (idS m)) ;

  -- the identity is related over the bottom environment
  rel-id : RelS m G (rho0 m) (idS m) (idS m) =
    new RelSR[m, G, rho0 m, idS m, idS m, ok := id-ok m G wG, ok' := id-ok m G wG,
             eq := \ i -> eq-refl m G (var m i) (Sub.trav m (lookup m G i) m (idS m)) (id-ok m G wG i),
             eq' := \ i -> eq-refl m G (var m i) (Sub.trav m (lookup m G i) m (idS m)) (id-ok m G wG i),
             vr := \ i u c mu mc hc ->
               (tmr-om u mu (Sub.trav m (lookup m G i) m (idS m)) (var m i) (var m i),
                tmr-om u mu (Sub.trav m (lookup m G i) m (idS m)) (var m i) (var m i))] ;

  -- adequacy at pi om om
  tm : TmR (pi om om) (uu m) (pp m Ai Bi) (pp m Ai' Bi') =
    (AdeqT[m, G, wG].adequacy m (jeq G (pp m A B) (pp m A' B') (uu m)) d (rho0 m) (fits-bot m G wG) (idS m) (idS m) rel-id
       (pi om om) univ (pi-om-in m A B (rho0 m)) (univ-in m (rho0 m)) tp-pi-om).1 ;

  pc : PiTy Can om om (pp m Ai Bi) (pp m Ai' Bi') =
    ((tyr-unfold (pi om om) (pp m Ai Bi) (pp m Ai' Bi')).1 (tmr-ty (pi om om) (uu m) (pp m Ai Bi) (pp m Ai' Bi') tm)).pc
      om om om om (sel-here (pi om om)) (ps-here om om) ;

  -- the reducts are the normal types themselves
  dd : PiD Can om om Ai Bi Ai' Bi' =
    pid-r Can om om Ai Bi pc.A1 Ai' pc.B1 Bi'
      (sym (Tm m) (pp m Ai' Bi') (pp m pc.A1 pc.B1) (reds-from-normal m (pp m Ai' Bi') (pp m pc.A1 pc.B1) pc.red' (normal-pp m Ai' Bi')))
      (pid-l Can om om pc.A0 Ai pc.B0 Bi pc.A1 pc.B1
         (sym (Tm m) (pp m Ai Bi) (pp m pc.A0 pc.B0) (reds-from-normal m (pp m Ai Bi) (pp m pc.A0 pc.B0) pc.red (normal-pp m Ai Bi)))
         pc.d) ;

  dom : Der m (jeq G A A' (uu m)) =
    der-eq-r m G A Ai' A' (uu m) (sub-id m A') (der-eq-l m G Ai A Ai' (uu m) (sub-id m A) dd.cA) ;

  cod : Der (suc m) (jeq (ext m G A) B B' (uu (suc m))) =
    Prelude[l].subst (Tm m) (\ Z -> Der (suc m) (jeq (ext m G Z) B B' (uu (suc m)))) Ai A (sub-id m A)
      (der-eq-r (suc m) (ext m G Ai) B Bi' B' (uu (suc m)) (sub-id-lift m B')
         (der-eq-l (suc m) (ext m G Ai) Bi B Bi' (uu (suc m)) (sub-id-lift m B) dd.cB)) ;
} ;

-- paper Corollary 2.37
pi-injectivity (m : Nat) (G : Ctx m) (A A' : Tm m) (B B' : Tm (suc m)) (d : Der m (jeq G (pp m A B) (pp m A' B') (uu m))) :
    Der m (jeq G A A' (uu m)) * Der (suc m) (jeq (ext m G A) B B' (uu (suc m))) =
  (PiInj[m, G, A, A', B, B', d].dom, PiInj[m, G, A, A', B, B', d].cod) ;
