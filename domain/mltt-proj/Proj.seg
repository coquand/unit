-- Proj.seg: the finitary projections on filters (Coquand and Huber, "An
-- adequacy theorem for dependent type theory", section 3; paper1 =
-- "Definitional inversion, without normalisation", section 2.3), on the
-- filters of domain/mltt.  Order as there: Le s t, s has more information.
--
-- projF B X is the filter of the types above a meet of elements of X each
-- typed at some type in B: the paper's p B X, generated by the typed
-- elements of X.  With several witnesses it is a filter with no
-- hypothesis on B or X (as lamF and piF in Filter.seg).
--   proj-sub    p B X <= X
--   proj-idem   p B (p B X) = p B X
--   proj-mono   monotone in B and in X
--   enl-proj    an element of X above a typed element is in p B X
--   proj-enl    if X is consistent and B a type (TyU B), every element of
--               p B X is above ONE typed element of X (Enl X B): the meet
--               of the witnesses, typed at a common type of B (paper1
--               Props 2.16, 2.17: tp-join, tp-up)
--   hasTy-fix   so, for X consistent and B a type, HasTy X B iff
--               X <= p B X, that is X = p B X: the elements of type B are
--               the fixed points of p B (hasTy-proj, proj-hasTy)
--   proj-univ   p U U = U (U : U)

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Filter[l] ; open Sound[l] ;

------------------------------------------------------------------------
-- meets of elements with a property

data Meets (P : Ty -> U l) : (m0 : Ty) -> U l =
    ms-om : Meets P om
  | ms-one (v : Ty) (p : P v) : Meets P v
  | ms-meet (f1 f2 : Ty) (h1 : Meets P f1) (h2 : Meets P f2) : Meets P (meet f1 f2) ;

meets-map (P P' : Ty -> U l) (h : (v : Ty) -> P v -> P' v) : (f : Ty) -> Meets P f -> Meets P' f = split {
  ms-om -> ms-om ;
  ms-one v p -> ms-one v (h v p) ;
  ms-meet f1 f2 h1 h2 | r1 r2 -> ms-meet f1 f2 r1 r2 } ;

-- a meet of elements of a filter is in it
meets-in (X : Filt) (P : Ty -> U l) (h : (v : Ty) -> P v -> X.mem v) : (f : Ty) -> Meets P f -> X.mem f = split {
  ms-om -> X.fom ;
  ms-one v p -> h v p ;
  ms-meet f1 f2 h1 h2 | r1 r2 -> X.fmeet f1 f2 r1 r2 } ;

------------------------------------------------------------------------
-- the projection

-- v is an element of X typed at some type in B
record TInR { B : Filt ; X : Filt ; v : Ty ; inX : X.mem v ; ty : TyIn B v ; } ;
TIn (B X : Filt) (v : Ty) : U l = TInR[B, X, v] ;

record ProjWR { B : Filt ; X : Filt ; t : Ty ; f : Ty ; le : Le f t ; ms : Meets (TIn B X) f ; } ;
ProjW (B X : Filt) (t : Ty) : U l = ProjWR[B, X, t] ;

proj-om (B X : Filt) : ProjW B X om = new ProjWR[B, X, om, f := om, le := le-refl om, ms := ms-om] ;

proj-meet (B X : Filt) (s t : Ty) (v : ProjW B X s) (w : ProjW B X t) : ProjW B X (meet s t) =
  new ProjWR[B, X, meet s t, f := meet v.f w.f, le := le-meet-mono v.f s w.f t v.le w.le, ms := ms-meet v.f w.f v.ms w.ms] ;

proj-up (B X : Filt) (t t' : Ty) (le : Le t t') (w : ProjW B X t) : ProjW B X t' =
  new ProjWR[B, X, t', f := w.f, le := le-trans w.f t t' w.le le, ms := w.ms] ;

projF (B X : Filt) : Filt = new Filt[ProjW B X, proj-om B X, proj-meet B X, proj-up B X] ;

-- a typed element of X is in p B X
proj-typed (B X : Filt) (v : Ty) (h : TIn B X v) : (projF B X).mem v =
  new ProjWR[B, X, v, f := v, le := le-refl v, ms := ms-one v h] ;

-- p B X <= X
proj-sub (B X : Filt) : Incl (projF B X) X =
  \ t w -> X.fup w.f t w.le (meets-in X (TIn B X) (\ v h -> h.inX) w.f w.ms) ;

-- p B (p B X) = p B X
proj-idem1 (B X : Filt) : Incl (projF B (projF B X)) (projF B X) = proj-sub B (projF B X) ;

tin-proj (B X : Filt) (v : Ty) (h : TIn B X v) : TIn B (projF B X) v =
  new TInR[B, projF B X, v, inX := proj-typed B X v h, ty := h.ty] ;

proj-idem2 (B X : Filt) : Incl (projF B X) (projF B (projF B X)) =
  \ t w -> new ProjWR[B, projF B X, t, f := w.f, le := w.le, ms := meets-map (TIn B X) (TIn B (projF B X)) (tin-proj B X) w.f w.ms] ;

proj-idem (B X : Filt) : FEq (projF B (projF B X)) (projF B X) = (proj-idem1 B X, proj-idem2 B X) ;

-- monotone in both arguments
tin-mono (B B' X X' : Filt) (iB : Incl B B') (iX : Incl X X') (v : Ty) (h : TIn B X v) : TIn B' X' v =
  new TInR[B', X', v, inX := iX v h.inX, ty := tyin-mono B B' iB v h.ty] ;

proj-mono (B B' X X' : Filt) (iB : Incl B B') (iX : Incl X X') : Incl (projF B X) (projF B' X') =
  \ t w -> new ProjWR[B', X', t, f := w.f, le := w.le, ms := meets-map (TIn B X) (TIn B' X') (tin-mono B B' X X' iB iX) w.f w.ms] ;

------------------------------------------------------------------------
-- one witness suffices, for X consistent and B a type

-- an element of X typed at a type of B which is itself in U
record TUR { B : Filt ; X : Filt ; t : Ty ;
  v : Ty ; below : Le v t ; inX : X.mem v ; c : Ty ; inB : B.mem c ; tp : Tp (el v c) ; cU : Tp (el c univ) ; } ;
TU (B X : Filt) (t : Ty) : U l = TUR[B, X, t] ;

tu-enl (B X : Filt) (t : Ty) (w : TU B X t) : Enl X B t =
  new EnlR[X, B, t, v := w.v, below := w.below, inA := w.inX, c := w.c, inB := w.inB, tp := w.tp] ;

-- an element of X above a typed element is in p B X (no hypothesis)
enl-proj (B X : Filt) (t : Ty) (e : Enl X B t) : (projF B X).mem t =
  new ProjWR[B, X, t, f := e.v, le := e.below,
           ms := ms-one e.v (new TInR[B, X, e.v, inX := e.inA, ty := new TyInR[B, e.v, a := e.c, ina := e.inB, tp := e.tp]])] ;

module Collapse (B X : Filt) (cX : ConsF X) (hB : TyU B) {

  -- the leaf om: om is typed at any type in U
  at-om : TU B X om =
    new TUR[B, X, om, v := om, below := le-refl om, inX := X.fom, c := s.a, inB := s.inA,
             tp := t-bot om s.a (le-refl om) s.tp, cU := s.tp]
    where { s : TyEl B om = ty-enl B hB om B.fom ; } ;

  -- a typed element, moved to a type of B in U below its type
  at-one (v : Ty) (h : TIn B X v) : TU B X v =
    new TUR[B, X, v, v := v, below := le-refl v, inX := h.inX, c := s.a, inB := s.inA,
             tp := tp-up v h.ty.a s.a h.ty.tp s.below s.tp, cU := s.tp]
    where { s : TyEl B h.ty.a = ty-enl B hB h.ty.a h.ty.ina ; } ;

  -- two typed elements: their meet, at a type of B in U below both types
  at-meet (f1 f2 : Ty) (w1 : TU B X f1) (w2 : TU B X f2) : TU B X (meet f1 f2) =
    new TUR[B, X, meet f1 f2, v := meet w1.v w2.v, below := le-meet-mono w1.v f1 w2.v f2 w1.below w2.below,
             inX := X.fmeet w1.v w2.v w1.inX w2.inX, c := s.a, inB := s.inA,
             tp := tp-join w1.v w2.v s.a
                    (tp-up w1.v w1.c s.a w1.tp (le-trans s.a (meet w1.c w2.c) w1.c s.below (le-meet-l w1.c w2.c)) s.tp)
                    (tp-up w2.v w2.c s.a w2.tp (le-trans s.a (meet w1.c w2.c) w2.c s.below (le-meet-r w1.c w2.c)) s.tp)
                    (cX (meet w1.v w2.v) (X.fmeet w1.v w2.v w1.inX w2.inX)),
             cU := s.tp]
    where { s : TyEl B (meet w1.c w2.c) = ty-enl B hB (meet w1.c w2.c) (B.fmeet w1.c w2.c w1.inB w2.inB) ; } ;

  collapse : (f : Ty) -> Meets (TIn B X) f -> TU B X f = split {
    ms-om -> at-om ;
    ms-one v h -> at-one v h ;
    ms-meet f1 f2 h1 h2 | r1 r2 -> at-meet f1 f2 r1 r2 } ;

  tu-up (t t' : Ty) (le : Le t t') (w : TU B X t) : TU B X t' =
    new TUR[B, X, t', v := w.v, below := le-trans w.v t t' w.below le, inX := w.inX, c := w.c, inB := w.inB, tp := w.tp, cU := w.cU] ;

  -- every element of p B X is above one typed element of X
  proj-enl (t : Ty) (w : (projF B X).mem t) : Enl X B t = tu-enl B X t (tu-up w.f t w.le (collapse w.f w.ms)) ;

  -- the elements of type B are the fixed points of p B
  hasTy-proj (h : HasTy X B) : Incl X (projF B X) = \ t m -> enl-proj B X t (h t m) ;
  proj-hasTy (i : Incl X (projF B X)) : HasTy X B = \ t m -> proj-enl t (i t m) ;
  hasTy-fix (h : HasTy X B) : FEq X (projF B X) = (hasTy-proj h, proj-sub B X) ;
} ;

------------------------------------------------------------------------
-- p U U = U

univ-in-univF : univF.mem univ = prin-in univ ;

proj-univ : FEq (projF univF univF) univF =
  (proj-sub univF univF,
   \ t le -> new ProjWR[univF, univF, t, f := univ, le := le,
                      ms := ms-one univ (new TInR[univF, univF, univ, inX := univ-in-univF,
                                                 ty := new TyInR[univF, univ, a := univ, ina := univ-in-univF, tp := tp-UU]])]) ;
