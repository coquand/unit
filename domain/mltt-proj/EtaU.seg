-- EtaU.seg: Coquand-Huber's example after Corollary 4 ("the finite
-- elements w : N -> N are exactly the finite elements of the continuous
-- functions El N -> El N"), with U in place of N (MLTT_eta has no N).
--
-- U -> U is Pi U (x |-> U), a type (Sound.sound-pi).  For W consistent:
--   eta    p (U -> U) W = lam U (x |-> p U (W x))        (ProjLam, Prop. 1)
--   fix    W : U -> U  iff  W = lam U (x |-> p U (W x))
-- i.e. an element of U -> U is determined by its applications to types,
-- and these are types: El (U -> U) is the domain of continuous functions
-- El U -> El U.
-- Proof of fix.  W : U -> U iff W = p (U -> U) W (Proj.Collapse.hasTy-fix,
-- proj-hasTy), and eta rewrites the right side.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Filter[l] ; open Sound[l] ; open Proj[l] ; open ProjLam[l] ;

-- the constant family U
constU (x : Ty) : Filt = univF ;

constU-anti (x x' : Ty) (le : Le x' x) : Incl (constU x) (constU x') = incl-refl univF ;

univF-cons : ConsF univF = prin-cons univ cons-univ ;

-- U -> U, a type
UU : Filt = piF univF constU ;

UU-cons : ConsF UU = OpCons[univF, constU, constU-anti, \ x cx -> univF-cons].pic univF-cons ;

UU-type : TyU UU = sound-pi univF constU univ-hasty (\ x h -> univ-hasty) UU-cons ;

module EtaU (W : Filt) (cW : ConsF W) {

  -- lam U (x |-> p U (W x))
  rhs : Filt = lamF univF (\ x -> projF univF (appAt W x)) ;

  eta : FEq (projF UU W) rhs =
    LamClause[univF, constU, constU-anti, W].Back[univ-hasty, \ x h -> univ-hasty, \ x cx -> univF-cons, cW].eq ;

  fix-to (h : HasTy W UU) : FEq W rhs =
    feq-trans W (projF UU W) rhs (Collapse[UU, W, cW, UU-type].hasTy-fix h) eta ;

  fix-from (e : FEq W rhs) : HasTy W UU =
    Collapse[UU, W, cW, UU-type].proj-hasTy (incl-trans W rhs (projF UU W) e.1 eta.2) ;
} ;
