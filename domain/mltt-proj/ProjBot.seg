-- ProjBot.seg: Coquand-Huber Prop. 1, "p U b = bot in the other cases",
-- for b a function:
--
--   p U (lam A G) = bot   (bot = prin om, the om-like types)
--
-- A function has no U or Pi component (Filter.ents-all), so an element of
-- lam A G is below neither U nor a product; by generation, an element of
-- lam A G of type U is om-like.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Filter[l] ; open Sound[l] ; open Proj[l] ;

botF : Filt = prin om ;

module LamU (A : Filt) (G : Ty -> Filt) {

  -- one element w of lam A G with w : U, by its shape
  at-shape (w : Ty) (p : LamW A G w) : Shape w univ -> botF.mem w = split {
    sh-bot e h -> e ;
    sh-univ e1 e2 ->
      absurd (botF.mem w)
        (sel-all NotUP p.f univ (inv-univ p.f (le-trans p.f w univ p.le e1.1)) (ents-all (EntR A G) p.f p.ents)) ;
    sh-pi A' phi e1 e2 h1 h2 c ->
      absurd (botF.mem w)
        (sel-all NotUP p.f (pi i.1 i.2.1) i.2.2.2.2.1 (ents-all (EntR A G) p.f p.ents))
      where { i : InvPi p.f A' phi = inv-pi p.f A' phi (le-trans p.f w (pi A' phi) p.le e1.1) ; } ;
    sh-lam A1 phi1 f e1 e2 h1 h2 cf -> absurd (botF.mem w) (univ-not-pi A1 phi1 e2.1) } ;

  at-typed (w : Ty) (h : TIn univF (lamF A G) w) : botF.mem w =
    at-shape w h.inX (shape w univ (tp-univ w h.ty.a h.ty.tp h.ty.ina)) ;

  -- p U (lam A G) = bot
  eq : FEq (projF univF (lamF A G)) botF =
    (\ t q -> botF.fup q.f t q.le (meets-in botF (TIn univF (lamF A G)) at-typed q.f q.ms),
     \ t e -> om-in (projF univF (lamF A G)) t e) ;
} ;
