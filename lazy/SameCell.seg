-- Equal cell contents have equal observations, even for LABEL cells:
-- the recursive LABEL premise is copied using the induction hypothesis.
level l ;
open Base ; open Prelude[l] ; open Types ; open Subtyping[l] ;
open Memory[l] ; open Observations[l] ;

copyEq (mu : Heap) (p q : Addr) (e : Expr)
    (same : Id (Maybe Expr) (mu p) (mu q))
    (eq : Id (Maybe Expr) (mu p) (just e)) : Id (Maybe Expr) (mu q) (just e) =
  pathTrans (Maybe Expr) (mu q) (mu p) (just e) (pathSym (Maybe Expr) (mu p) (mu q) same) eq ;

CopyResult (mu : Heap) : Query -> U l = split {
  cell p rho a -> (q : Addr) -> Id (Maybe Expr) (mu p) (mu q) -> Obs mu q rho a ;
  bindings rho th bs -> Top } ;

copyDerivation (mu : Heap) : (j : Query) -> Derive mu j -> CopyResult mu j = split {
  obsTop p rho -> \ q same -> obsTop q rho ;
  obsMeet p rho a b oa ob | ra rb -> \ q same -> obsMeet q rho a b (ra q same) (rb q same) ;
  obsSub p rho a b o le | r -> \ q same -> obsSub q rho a b (r q same) le ;
  obsVar p rho x eq -> \ q same -> obsVar q rho x (copyEq mu p q (evar x) same eq) ;
  obsQuote p rho a eq -> \ q same -> obsQuote q rho a (copyEq mu p q (equote a) same eq) ;
  obsCons p p1 p2 rho a b eq o1 o2 -> \ q same ->
    obsCons q p1 p2 rho a b (copyEq mu p q (econs p1 p2) same eq) o1 o2 ;
  obsCar p p1 rho a b eq o -> \ q same -> obsCar q p1 rho a b (copyEq mu p q (ecar p1) same eq) o ;
  obsCdr p p1 rho a b eq o -> \ q same -> obsCdr q p1 rho a b (copyEq mu p q (ecdr p1) same eq) o ;
  obsAtomT p p1 rho eq o -> \ q same -> obsAtomT q p1 rho (copyEq mu p q (eatom p1) same eq) o ;
  obsAtomNil p p1 rho eq o -> \ q same -> obsAtomNil q p1 rho (copyEq mu p q (eatom p1) same eq) o ;
  obsEqT p p1 p2 rho a b eq sameAtom o1 o2 -> \ q same ->
    obsEqT q p1 p2 rho a b (copyEq mu p q (eeq p1 p2) same eq) sameAtom o1 o2 ;
  obsEqNil p p1 p2 rho a b eq different o1 o2 -> \ q same ->
    obsEqNil q p1 p2 rho a b (copyEq mu p q (eeq p1 p2) same eq) different o1 o2 ;
  obsIfT p p0 p1 p2 rho a eq oc o -> \ q same ->
    obsIfT q p0 p1 p2 rho a (copyEq mu p q (eif p0 p1 p2) same eq) oc o ;
  obsIfNil p p0 p1 p2 rho a eq oc o -> \ q same ->
    obsIfNil q p0 p1 p2 rho a (copyEq mu p q (eif p0 p1 p2) same eq) oc o ;
  obsApp p pf px rho a b eq ofun ox -> \ q same ->
    obsApp q pf px rho a b (copyEq mu p q (eapp pf px) same eq) ofun ox ;
  obsLam p pb rho x a b eq o -> \ q same ->
    obsLam q pb rho x a b (copyEq mu p q (elam x pb) same eq) o ;
  obsLabel p pb rho x a b eq rec body | rr rb -> \ q same ->
    obsLabel q pb rho x a b (copyEq mu p q (elabel x pb) same eq) (rr q same) body ;
  obsFunarg p pb th rho bs a eq args body -> \ q same ->
    obsFunarg q pb th rho bs a (copyEq mu p q (efunarg pb th) same eq) args body ;
  obsPlus p p1 p2 rho m n eq o1 o2 -> \ q same ->
    obsPlus q p1 p2 rho m n (copyEq mu p q (eplus p1 p2) same eq) o1 o2 ;
  oaNil rho -> tt ; oaCons rho x q th bs a head tail -> tt } ;

sameCell (mu : Heap) (p q : Addr) (rho : Env) (a : Ty)
    (same : Id (Maybe Expr) (mu p) (mu q)) (o : Obs mu p rho a) : Obs mu q rho a =
  copyDerivation mu (cell p rho a) o q same ;
