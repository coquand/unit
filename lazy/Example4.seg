-- Example 4 of Henderson--Morris, as 21 checked memory rewrites.
-- The schedule follows the paper: demand selected components in situ,
-- then copy their values. The recursive LABEL creates an actual cycle.
level l ;
open Base ; open Prelude[l] ; open Memory[l] ; open Rewrites[l] ; open Eval[l] ;

lookupCell : List Expr -> Nat -> Maybe Expr = split {
  nil -> \ p -> nothing ;
  cons e es | r -> split { zero -> just e ; suc n -> r n } } ;
n0 : Nat = zero ;
n1 : Nat = suc n0 ;
n2 : Nat = suc n1 ;
n3 : Nat = suc n2 ;
n4 : Nat = suc n3 ;
n5 : Nat = suc n4 ;
n6 : Nat = suc n5 ;
n7 : Nat = suc n6 ;
n8 : Nat = suc n7 ;
n9 : Nat = suc n8 ;
n10 : Nat = suc n9 ;
n11 : Nat = suc n10 ;
n12 : Nat = suc n11 ;
n13 : Nat = suc n12 ;
n14 : Nat = suc n13 ;
n15 : Nat = suc n14 ;
n16 : Nat = suc n15 ;
n17 : Nat = suc n16 ;
n18 : Nat = suc n17 ;
n19 : Nat = suc n18 ;
n20 : Nat = suc n19 ;
n21 : Nat = suc n20 ;
n22 : Nat = suc n21 ;
n23 : Nat = suc n22 ;
n24 : Nat = suc n23 ;
n25 : Nat = suc n24 ;
n26 : Nat = suc n25 ;
n27 : Nat = suc n26 ;
n28 : Nat = suc n27 ;
n29 : Nat = suc n28 ;
n30 : Nat = suc n29 ;
initialCells : List Expr = cons (efunarg n1 nil) (cons (eapp n2 n3) (cons (elam n0 n4) (cons (elabel n1 n9) (cons (ecar n5) (cons (ecdr n6) (cons (eapp n7 n8) (cons (evar n0) (cons (equote (num n0)) (cons (elam n2 n10) (cons (econs n11 n12) (cons (evar n2) (cons (eapp n13 n14) (cons (evar n1) (cons (eplus n15 n16) (cons (evar n2) (cons (equote (num n1)) (nil))))))))))))))))) ;
h0 : Heap = lookupCell initialCells ;
bind (x p : Nat) (th : Alist) : Alist = cons (mkPair Nat Nat x p) th ;
theta0 : Alist = bind n0 n18 nil ;
theta1 : Alist = bind n1 n18 nil ;
theta2 : Alist = bind n2 n22 theta1 ;
theta3 : Alist = bind n2 n26 theta1 ;

-- 1. [Fc]
h1 : Heap = alloc2 h0 n0 (eapp n17 n18) n17 n18 n2 n3 nil ;
s1 : Step h0 h1 =
  stFc h0 n0 n1 n2 n3 n17 n18 nil (refl (just (efunarg n1 nil))) (refl (just (eapp n2 n3))) (refl nothing) (refl nothing) (refl false) ;

-- 2. [G]
h2 : Heap = upd h1 n0 (efunarg n4 theta0) ;
s2 : Step h1 h2 =
  stG h1 n0 n17 n2 n4 n18 nil n0 (refl (just (eapp n17 n18))) (refl (just (efunarg n2 nil))) (refl (just (elam n0 n4))) ;

-- 3. [Fd/CAR]
h3 : Heap = alloc1 h2 n0 (ecar n19) n19 n5 theta0 ;
s3 : Step h2 h3 =
  stFUnary carOp h2 n0 n4 n5 n19 theta0 (refl (just (efunarg n4 theta0))) (refl (just (ecar n5))) (refl nothing) ;

-- 4. [Fd/CDR]
h4 : Heap = alloc1 h3 n19 (ecdr n20) n20 n6 theta0 ;
s4 : Step h3 h4 =
  stFUnary cdrOp h3 n19 n5 n6 n20 theta0 (refl (just (efunarg n5 theta0))) (refl (just (ecdr n6))) (refl nothing) ;

-- 5. [Fc]
h5 : Heap = alloc2 h4 n20 (eapp n21 n22) n21 n22 n7 n8 theta0 ;
s5 : Step h4 h5 =
  stFc h4 n20 n6 n7 n8 n21 n22 theta0 (refl (just (efunarg n6 theta0))) (refl (just (eapp n7 n8))) (refl nothing) (refl nothing) (refl false) ;

-- 6. [L: create back edge from 18 to itself]
h6 : Heap = upd h5 n18 (efunarg n9 theta1) ;
s6 : Step h5 h6 =
  stL h5 n18 n3 n9 nil n1 (refl (just (efunarg n3 nil))) (refl (just (elabel n1 n9))) ;

-- 7. [Fa]
h7 : Heap = upd h6 n21 (efunarg n9 theta1) ;
s7 : Step h6 h7 =
  stFa h6 n21 n7 n18 theta0 n0 (efunarg n9 theta1) (refl (just (efunarg n7 theta0))) (refl (just (evar n0))) (alHere n0 n18 nil) (refl (just (efunarg n9 theta1))) ;

-- 8. [G]
h8 : Heap = upd h7 n20 (efunarg n10 theta2) ;
s8 : Step h7 h8 =
  stG h7 n20 n21 n9 n10 n22 theta1 n2 (refl (just (eapp n21 n22))) (refl (just (efunarg n9 theta1))) (refl (just (elam n2 n10))) ;

-- 9. [Fd/CONS]
h9 : Heap = alloc2 h8 n20 (econs n23 n24) n23 n24 n11 n12 theta2 ;
s9 : Step h8 h9 =
  stFBinary consOp h8 n20 n10 n11 n12 n23 n24 theta2 (refl (just (efunarg n10 theta2))) (refl (just (econs n11 n12))) (refl nothing) (refl nothing) (refl false) ;

-- 10. [Fc: force only the tail demanded by CDR]
h10 : Heap = alloc2 h9 n24 (eapp n25 n26) n25 n26 n13 n14 theta2 ;
s10 : Step h9 h10 =
  stFc h9 n24 n12 n13 n14 n25 n26 theta2 (refl (just (efunarg n12 theta2))) (refl (just (eapp n13 n14))) (refl nothing) (refl nothing) (refl false) ;

-- 11. [Fa]
h11 : Heap = upd h10 n25 (efunarg n9 theta1) ;
s11 : Step h10 h11 =
  stFa h10 n25 n13 n18 theta2 n1 (efunarg n9 theta1) (refl (just (efunarg n13 theta2))) (refl (just (evar n1))) (alThere n2 n22 theta1 n1 n18 (refl false) (alHere n1 n18 nil)) (refl (just (efunarg n9 theta1))) ;

-- 12. [G]
h12 : Heap = upd h11 n24 (efunarg n10 theta3) ;
s12 : Step h11 h12 =
  stG h11 n24 n25 n9 n10 n26 theta1 n2 (refl (just (eapp n25 n26))) (refl (just (efunarg n9 theta1))) (refl (just (elam n2 n10))) ;

-- 13. [Fd/CONS]
h13 : Heap = alloc2 h12 n24 (econs n27 n28) n27 n28 n11 n12 theta3 ;
s13 : Step h12 h13 =
  stFBinary consOp h12 n24 n10 n11 n12 n27 n28 theta3 (refl (just (efunarg n10 theta3))) (refl (just (econs n11 n12))) (refl nothing) (refl nothing) (refl false) ;

-- 14. [C/CDR]
h14 : Heap = upd h13 n19 (econs n27 n28) ;
s14 : Step h13 h14 =
  stCdr h13 n19 n20 n23 n24 (econs n27 n28) (refl (just (ecdr n20))) (refl (just (econs n23 n24))) (refl (just (econs n27 n28))) ;

-- 15. [Fd/PLUS: force second list head]
h15 : Heap = alloc2 h14 n26 (eplus n29 n30) n29 n30 n15 n16 theta2 ;
s15 : Step h14 h15 =
  stFBinary plusOp h14 n26 n14 n15 n16 n29 n30 theta2 (refl (just (efunarg n14 theta2))) (refl (just (eplus n15 n16))) (refl nothing) (refl nothing) (refl false) ;

-- 16. [Fb]
h16 : Heap = upd h15 n22 (equote (num n0)) ;
s16 : Step h15 h16 =
  stFb h15 n22 n8 theta0 (num n0) (refl (just (efunarg n8 theta0))) (refl (just (equote (num n0)))) ;

-- 17. [Fa]
h17 : Heap = upd h16 n29 (equote (num n0)) ;
s17 : Step h16 h17 =
  stFa h16 n29 n15 n22 theta2 n2 (equote (num n0)) (refl (just (efunarg n15 theta2))) (refl (just (evar n2))) (alHere n2 n22 theta1) (refl (just (equote (num n0)))) ;

-- 18. [Fb]
h18 : Heap = upd h17 n30 (equote (num n1)) ;
s18 : Step h17 h18 =
  stFb h17 n30 n16 theta2 (num n1) (refl (just (efunarg n16 theta2))) (refl (just (equote (num n1)))) ;

-- 19. [PLUS]
h19 : Heap = upd h18 n26 (equote (num n1)) ;
s19 : Step h18 h19 =
  stPlus h18 n26 n29 n30 n0 n1 (refl (just (eplus n29 n30))) (refl (just (equote (num n0)))) (refl (just (equote (num n1)))) ;

-- 20. [Fa]
h20 : Heap = upd h19 n27 (equote (num n1)) ;
s20 : Step h19 h20 =
  stFa h19 n27 n11 n26 theta3 n2 (equote (num n1)) (refl (just (efunarg n11 theta3))) (refl (just (evar n2))) (alHere n2 n26 theta1) (refl (just (equote (num n1)))) ;

-- 21. [C/CAR: answer]
h21 : Heap = upd h20 n0 (equote (num n1)) ;
s21 : Step h20 h21 =
  stCar h20 n0 n19 n27 n28 (equote (num n1)) (refl (just (ecar n19))) (refl (just (econs n27 n28))) (refl (just (equote (num n1)))) ;

example4Trace : Trace h0 h21 =
  more h0 h1 h21 s1 (more h1 h2 h21 s2 (more h2 h3 h21 s3 (more h3 h4 h21 s4 (more h4 h5 h21 s5 (more h5 h6 h21 s6 (more h6 h7 h21 s7 (more h7 h8 h21 s8 (more h8 h9 h21 s9 (more h9 h10 h21 s10 (more h10 h11 h21 s11 (more h11 h12 h21 s12 (more h12 h13 h21 s13 (more h13 h14 h21 s14 (more h14 h15 h21 s15 (more h15 h16 h21 s16 (more h16 h17 h21 s17 (more h17 h18 h21 s18 (more h18 h19 h21 s19 (more h19 h20 h21 s20 (more h20 h21 h21 s21 (done h21))))))))))))))))))))) ;

example4Answer : Id (Maybe Expr) (h21 n0) (just (equote (num n1))) =
  refl (just (equote (num n1))) ;
#conv h21 n0 = just (equote (num n1)) ;
#conv traceLength h0 h21 example4Trace = n21 ;
-- The recursive closure persists; the unused tail and first head were
-- never evaluated. These checks witness the sharing/lazy schedule.
#conv h21 n18 = just (efunarg n9 theta1) ;
#conv h21 n23 = just (efunarg n11 theta2) ;
#conv h21 n28 = just (efunarg n12 theta3) ;

-- A big-step derivation certifies the demand order as well as the rewrites.

eval18 : Evaluates h5 n18 h6 =
  evalL h5 h6 n18 n3 n9 nil n1 (refl (just (efunarg n3 nil))) (refl (just (elabel n1 n9))) (evalValue h6 n18 (valueClosure n18 n9 theta1 n2 n10 (refl (just (efunarg n9 theta1))) (refl (just (elam n2 n10))))) ;

eval21 : Evaluates h5 n21 h7 =
  evalFa h5 h6 n21 n7 n18 theta0 n0 (efunarg n9 theta1) (refl (just (efunarg n7 theta0))) (refl (just (evar n0))) (alHere n0 n18 nil) eval18 (refl (just (efunarg n7 theta0))) (refl (just (evar n0))) (refl (just (efunarg n9 theta1))) ;

eval20Body : Evaluates h8 n20 h9 =
  evalFBinary consOp h8 h9 n20 n10 n11 n12 n23 n24 theta2 (refl (just (efunarg n10 theta2))) (refl (just (econs n11 n12))) (refl nothing) (refl nothing) (refl false) (evalValue h9 n20 (valueCons n20 n23 n24 (refl (just (econs n23 n24))))) ;

eval20App : Evaluates h5 n20 h9 =
  evalG h5 h7 h9 n20 n21 n9 n10 n22 theta1 n2 (refl (just (eapp n21 n22))) eval21 (refl (just (eapp n21 n22))) (refl (just (efunarg n9 theta1))) (refl (just (elam n2 n10))) eval20Body ;

eval20 : Evaluates h4 n20 h9 =
  evalFc h4 h9 n20 n6 n7 n8 n21 n22 theta0 (refl (just (efunarg n6 theta0))) (refl (just (eapp n7 n8))) (refl nothing) (refl nothing) (refl false) eval20App ;

eval25 : Evaluates h10 n25 h11 =
  evalFa h10 h10 n25 n13 n18 theta2 n1 (efunarg n9 theta1) (refl (just (efunarg n13 theta2))) (refl (just (evar n1))) (alThere n2 n22 theta1 n1 n18 (refl false) (alHere n1 n18 nil)) (evalValue h10 n18 (valueClosure n18 n9 theta1 n2 n10 (refl (just (efunarg n9 theta1))) (refl (just (elam n2 n10))))) (refl (just (efunarg n13 theta2))) (refl (just (evar n1))) (refl (just (efunarg n9 theta1))) ;

eval24Body : Evaluates h12 n24 h13 =
  evalFBinary consOp h12 h13 n24 n10 n11 n12 n27 n28 theta3 (refl (just (efunarg n10 theta3))) (refl (just (econs n11 n12))) (refl nothing) (refl nothing) (refl false) (evalValue h13 n24 (valueCons n24 n27 n28 (refl (just (econs n27 n28))))) ;

eval24App : Evaluates h10 n24 h13 =
  evalG h10 h11 h13 n24 n25 n9 n10 n26 theta1 n2 (refl (just (eapp n25 n26))) eval25 (refl (just (eapp n25 n26))) (refl (just (efunarg n9 theta1))) (refl (just (elam n2 n10))) eval24Body ;

eval24 : Evaluates h9 n24 h13 =
  evalFc h9 h13 n24 n12 n13 n14 n25 n26 theta2 (refl (just (efunarg n12 theta2))) (refl (just (eapp n13 n14))) (refl nothing) (refl nothing) (refl false) eval24App ;

eval19Cdr : Evaluates h4 n19 h14 =
  evalCdr h4 h9 h13 n19 n20 n23 n24 (econs n27 n28) (refl (just (ecdr n20))) eval20 (refl (just (econs n23 n24))) eval24 (refl (just (ecdr n20))) (refl (just (econs n23 n24))) (refl (just (econs n27 n28))) ;

eval19 : Evaluates h3 n19 h14 =
  evalFUnary cdrOp h3 h14 n19 n5 n6 n20 theta0 (refl (just (efunarg n5 theta0))) (refl (just (ecdr n6))) (refl nothing) eval19Cdr ;

eval22 : Evaluates h15 n22 h16 =
  evalFb h15 n22 n8 theta0 (num n0) (refl (just (efunarg n8 theta0))) (refl (just (equote (num n0)))) ;

eval29 : Evaluates h15 n29 h17 =
  evalFa h15 h16 n29 n15 n22 theta2 n2 (equote (num n0)) (refl (just (efunarg n15 theta2))) (refl (just (evar n2))) (alHere n2 n22 theta1) eval22 (refl (just (efunarg n15 theta2))) (refl (just (evar n2))) (refl (just (equote (num n0)))) ;

eval30 : Evaluates h17 n30 h18 =
  evalFb h17 n30 n16 theta2 (num n1) (refl (just (efunarg n16 theta2))) (refl (just (equote (num n1)))) ;

eval26Plus : Evaluates h15 n26 h19 =
  evalPlus h15 h17 h18 n26 n29 n30 n0 n1 (refl (just (eplus n29 n30))) eval29 eval30 (refl (just (eplus n29 n30))) (refl (just (equote (num n0)))) (refl (just (equote (num n1)))) ;

eval26 : Evaluates h14 n26 h19 =
  evalFBinary plusOp h14 h19 n26 n14 n15 n16 n29 n30 theta2 (refl (just (efunarg n14 theta2))) (refl (just (eplus n15 n16))) (refl nothing) (refl nothing) (refl false) eval26Plus ;

eval27 : Evaluates h14 n27 h20 =
  evalFa h14 h19 n27 n11 n26 theta3 n2 (equote (num n1)) (refl (just (efunarg n11 theta3))) (refl (just (evar n2))) (alHere n2 n26 theta1) eval26 (refl (just (efunarg n11 theta3))) (refl (just (evar n2))) (refl (just (equote (num n1)))) ;

eval0Car : Evaluates h3 n0 h21 =
  evalCar h3 h14 h20 n0 n19 n27 n28 (equote (num n1)) (refl (just (ecar n19))) eval19 (refl (just (econs n27 n28))) eval27 (refl (just (ecar n19))) (refl (just (econs n27 n28))) (refl (just (equote (num n1)))) ;

eval0Body : Evaluates h2 n0 h21 =
  evalFUnary carOp h2 h21 n0 n4 n5 n19 theta0 (refl (just (efunarg n4 theta0))) (refl (just (ecar n5))) (refl nothing) eval0Car ;

eval0App : Evaluates h1 n0 h21 =
  evalG h1 h1 h21 n0 n17 n2 n4 n18 nil n0 (refl (just (eapp n17 n18))) (evalValue h1 n17 (valueClosure n17 n2 nil n0 n4 (refl (just (efunarg n2 nil))) (refl (just (elam n0 n4))))) (refl (just (eapp n17 n18))) (refl (just (efunarg n2 nil))) (refl (just (elam n0 n4))) eval0Body ;

example4Eval : Evaluates h0 n0 h21 =
  evalFc h0 h21 n0 n1 n2 n3 n17 n18 nil (refl (just (efunarg n1 nil))) (refl (just (eapp n2 n3))) (refl nothing) (refl nothing) (refl false) eval0App ;

#conv evalTrace h0 n0 h21 example4Eval = example4Trace ;
#conv traceLength h0 h21 (evalTrace h0 n0 h21 example4Eval) = n21 ;
