-- Allocation preserves meaning at OLD addresses; fresh addresses acquire
-- new meanings. This is the interface used to compose all rewrite rules.
level l ;
open Base ; open Prelude[l] ; open Types ; open Subtyping[l] ;
open Memory[l] ; open Observations[l] ; open HeapSupport[l] ;

record SameObservations (mu nu : Heap) {
  forward (p : Addr) (old : InDom mu p) (rho : Env) (a : Ty) : Obs mu p rho a -> Obs nu p rho a ;
  backward (p : Addr) (old : InDom mu p) (rho : Env) (a : Ty) : Obs nu p rho a -> Obs mu p rho a ;
} ;

sameObservationsRefl (mu : Heap) : SameObservations[mu, mu] =
  mkSameObservations mu mu (\ p old rho a o -> o) (\ p old rho a o -> o) ;

sameObservationsCompose (mu nu xi : Heap)
    (mn : SameObservations[mu, nu]) (nx : SameObservations[nu, xi])
    (domain : (p : Addr) -> InDom mu p -> InDom nu p) : SameObservations[mu, xi] =
  mkSameObservations mu xi
    (\ p old rho a o -> nx.forward p (domain p old) rho a (mn.forward p old rho a o))
    (\ p old rho a o -> mn.backward p old rho a (nx.backward p (domain p old) rho a o)) ;

-- Nonallocating rules establish the stronger result for all queries.
fromAllQueries (mu nu : Heap)
    (f : (j : Query) -> Derive mu j -> Derive nu j)
    (b : (j : Query) -> Derive nu j -> Derive mu j) : SameObservations[mu, nu] =
  mkSameObservations mu nu
    (\ p old rho a o -> f (cell p rho a) o)
    (\ p old rho a o -> b (cell p rho a) o) ;
