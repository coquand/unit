-- The semantic conclusion of the computed, demand-scheduled Example 4.
level l ;
open Base ; open Prelude[l] ; open Types ; open Subtyping[l] ;
open Memory[l] ; open Observations[l] ; open Eval[l] ; open HeapSupport[l] ;
open Example4[l] ; open Example4Support[l] ; open PartialCorrectness[l] ;

-- The initial cell has exactly the types above the literal 1.
answerSound (rho : Env) (t : Ty) (o : Obs h0 n0 rho t) : Le (at (num n1)) t =
  quotedSound h0 n0 h21 example4Eval initialWF rho (num n1) example4Answer t o ;
answerComplete (rho : Env) (t : Ty) (le : Le (at (num n1)) t) : Obs h0 n0 rho t =
  quotedComplete h0 n0 h21 example4Eval initialWF rho (num n1) example4Answer t le ;
observesOne : Observes h0 n0 (at (num n1)) = answerComplete emptyEnv (at (num n1)) (leRefl (at (num n1))) ;
