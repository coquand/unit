-- The least preorder generated by the rules of lazy-intersection.tex.
-- No semantic order oracle, approximation stage, or consistency premise.
level l ;
open Base ; open Prelude[l] ; open Types ;
data Le : (a b : Ty) -> U l =
    leRefl (a : Ty) : Le a a
  | leTrans (a b c : Ty) (p : Le a b) (q : Le b c) : Le a c
  | meetLeft (a b : Ty) : Le (meet a b) a
  | meetRight (a b : Ty) : Le (meet a b) b
  | meetIntro (r a b : Ty) (p : Le r a) (q : Le r b) : Le r (meet a b)
  | leTop (a : Ty) : Le a omega
  | atomBelow (a : Atom) : Le (at a) atomTop
  | prodMono (a c b d : Ty) (p : Le a c) (q : Le b d) : Le (prod a b) (prod c d)
  | prodMeet (a b c d : Ty) : Le (meet (prod a b) (prod c d)) (prod (meet a c) (meet b d))
  | arrMono (a c b d : Ty) (p : Le c a) (q : Le b d) : Le (arr a b) (arr c d)
  | arrMeet (a b c : Ty) : Le (meet (arr a b) (arr a c)) (arr a (meet b c))
  | arrTop (a : Ty) : Le (arr a omega) (arr omega omega) ;
meetMono (a b c d : Ty) (p : Le a c) (q : Le b d) : Le (meet a b) (meet c d) =
  meetIntro (meet a b) c d
    (leTrans (meet a b) a c (meetLeft a b) p)
    (leTrans (meet a b) b d (meetRight a b) q) ;
meetComm (a b : Ty) : Le (meet a b) (meet b a) = meetIntro (meet a b) b a (meetRight a b) (meetLeft a b) ;
meetIdem (a : Ty) : Le a (meet a a) = meetIntro a a a (leRefl a) (leRefl a) ;
arrowShape (a b : Ty) : Le (arr a b) (arr omega omega) =
  leTrans (arr a b) (arr a omega) (arr omega omega)
    (arrMono a a b omega (leRefl a) (leTop b)) (arrTop a) ;
