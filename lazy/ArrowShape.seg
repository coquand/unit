level l ;
open Base ; open Prelude[l] ; open Types ; open Subtyping[l] ; open Shape[l] ; open Arrow[l] ;

-- An arrow component, regardless of applicability of its domain,
-- supplies exactly the separated function shape.
shapeToArrow (input : Ty) : (rho : Ty) -> hasArrow rho -> Le rho (arr input omega) = split {
  omega -> \ h -> absurd (Le omega (arr input omega)) h ;
  atomTop -> \ h -> absurd (Le atomTop (arr input omega)) h ;
  at a -> \ h -> absurd (Le (at a) (arr input omega)) h ;
  prod a b -> \ h -> absurd (Le (prod a b) (arr input omega)) h ;
  arr a b -> \ h -> leTrans (arr a b) (arr omega omega) (arr input omega)
    (arrowShape a b) (arrMono omega input omega omega (leTop input) (leRefl omega)) ;
  meet a b | ra rb -> split {
    inl ha -> leTrans (meet a b) a (arr input omega) (meetLeft a b) (ra ha) ;
    inr hb -> leTrans (meet a b) b (arr input omega) (meetRight a b) (rb hb) } } ;

-- Full arrow characterization, including the uninformative codomain.
arrowCharacterise (rho input out : Ty) (d : Le rho (arr input out)) :
    Pair[hasArrow rho, Cover rho input out] =
  mkPair (hasArrow rho) (Cover rho input out) (arrowPresent rho input out d) (arrowSelection rho input out d) ;

arrowComplete (rho input out : Ty) (h : hasArrow rho) (c : Cover rho input out) : Le rho (arr input out) =
  resultsArrow rho input (shapeToArrow input rho h) out (coverResults rho input out c) ;

arrowTopComplete (rho input out : Ty) (h : hasArrow rho) (p : Le omega out) : Le rho (arr input out) =
  arrowComplete rho input out h (coverTop out p) ;
