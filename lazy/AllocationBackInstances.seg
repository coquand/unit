-- Backward observation invariance for every allocating rewrite.
-- The sole restriction is that the queried cell already existed; fresh
-- allocated cells have their closure interpretation in the mixed proof.
level l ;
open Base ; open Prelude[l] ; open Types ; open Memory[l] ; open Observations[l] ;
open Rewrites[l] ; open HeapSupport[l] ; open AllocationCases[l] ; open AllocationBackwards[l] ;

module FcBackward (mu : Heap) (p pb a b q r : Addr) (th : Alist)
    (root : Id (Maybe Expr) (mu p) (just (efunarg pb th)))
    (body : Id (Maybe Expr) (mu pb) (just (eapp a b)))
    (fq : Fresh mu q) (fr : Fresh mu r) (qr : Apart q r) (wf : WfHeap mu) {
  module O = FcOrigins[mu, p, pb, a, b, q, r, th, root, body, fq, fr, qr, wf] ;
  module B = BackAllocation[mu, O.nu, p, pb, th, O.fresh, O.shape, root, O.sourceRead, O.newRead, O.closed, wf, O.agreement] ;
  backward (z : Addr) (rho : Env) (out : Ty) (dz : InDom mu z) (o : Obs O.nu z rho out) : Obs mu z rho out =
    B.backward z rho out dz o ;
} ;

module UnaryBackward (op : Unary) (mu : Heap) (p pb a q : Addr) (th : Alist)
    (root : Id (Maybe Expr) (mu p) (just (efunarg pb th)))
    (body : Id (Maybe Expr) (mu pb) (just (unaryExpr op a)))
    (fq : Fresh mu q) (wf : WfHeap mu) {
  module O = UnaryOrigins[op, mu, p, pb, a, q, th, root, body, fq, wf] ;
  module B = BackAllocation[mu, O.nu, p, pb, th, O.fresh, O.shape, root, O.sourceRead, O.newRead, O.closed, wf, O.agreement] ;
  backward (z : Addr) (rho : Env) (out : Ty) (dz : InDom mu z) (o : Obs O.nu z rho out) : Obs mu z rho out =
    B.backward z rho out dz o ;
} ;

module BinaryBackward (op : Binary) (mu : Heap) (p pb a b q r : Addr) (th : Alist)
    (root : Id (Maybe Expr) (mu p) (just (efunarg pb th)))
    (body : Id (Maybe Expr) (mu pb) (just (binaryExpr op a b)))
    (fq : Fresh mu q) (fr : Fresh mu r) (qr : Apart q r) (wf : WfHeap mu) {
  module O = BinaryOrigins[op, mu, p, pb, a, b, q, r, th, root, body, fq, fr, qr, wf] ;
  module B = BackAllocation[mu, O.nu, p, pb, th, O.fresh, O.shape, root, O.sourceRead, O.newRead, O.closed, wf, O.agreement] ;
  backward (z : Addr) (rho : Env) (out : Ty) (dz : InDom mu z) (o : Obs O.nu z rho out) : Obs mu z rho out =
    B.backward z rho out dz o ;
} ;

module IfBackward (mu : Heap) (p pb a b c q r s : Addr) (th : Alist)
    (root : Id (Maybe Expr) (mu p) (just (efunarg pb th)))
    (body : Id (Maybe Expr) (mu pb) (just (eif a b c)))
    (fq : Fresh mu q) (fr : Fresh mu r) (fs : Fresh mu s)
    (qr : Apart q r) (qs : Apart q s) (rs : Apart r s) (wf : WfHeap mu) {
  module O = IfOrigins[mu, p, pb, a, b, c, q, r, s, th, root, body, fq, fr, fs, qr, qs, rs, wf] ;
  module B = BackAllocation[mu, O.nu, p, pb, th, O.fresh, O.shape, root, O.sourceRead, O.newRead, O.closed, wf, O.agreement] ;
  backward (z : Addr) (rho : Env) (out : Ty) (dz : InDom mu z) (o : Obs O.nu z rho out) : Obs mu z rho out =
    B.backward z rho out dz o ;
} ;
