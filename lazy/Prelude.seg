level l ;
open Base ;
data List (A : U l) : U l = nil | cons (x : A) (xs : List A) ;
data Maybe (A : U l) : U l = nothing | just (x : A) ;
data Either (A B : U l) : U l = inl (a : A) | inr (b : B) ;
record Pair (A B : U l) { fst : A ; snd : B ; } ;
record Sigma (A : U l) (B : A -> U l) { fst : A ; snd : B fst ; } ;
absurd (A : U l) : Empty -> A = split {} ;
pathSym (A : U l) (x y : A) (p : Id A x y) : Id A y x =
  idJ A x (\ z q -> Id A z x) (refl x) y p ;
pathTrans (A : U l) (x y z : A) (p : Id A x y) (q : Id A y z) : Id A x z =
  idJ A y (\ w r -> Id A x w) p z q ;
ap (A B : U l) (f : A -> B) (x y : A) (p : Id A x y) : Id B (f x) (f y) =
  idJ A x (\ z q -> Id B (f x) (f z)) (refl (f x)) y p ;
subst (A : U l) (P : A -> U l) (x y : A) (p : Id A x y) (u : P x) : P y =
  idJ A x (\ z q -> P z) u y p ;
choose (A : U l) (t f : A) : Bool -> A = split { false -> f ; true -> t } ;
Truth : Bool -> U l = split { false -> Empty ; true -> Top } ;
append (A : U l) : List A -> List A -> List A = split {
  nil -> \ ys -> ys ; cons x xs | r -> \ ys -> cons x (r ys) } ;
