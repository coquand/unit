-- Finite memories and environments for the intersection presentation.
level l ;
open Base ; open Prelude[l] ; open Types ;

Var : U l = Nat ;
Addr : U l = Nat ;
Alist : U l = List (Pair[Nat, Nat]) ;

data Expr : U l =
    evar (x : Var) | equote (a : Atom)
  | econs (p q : Addr) | ecar (p : Addr) | ecdr (p : Addr)
  | eatom (p : Addr) | eeq (p q : Addr) | eif (p q r : Addr)
  | eapp (p q : Addr) | elam (x : Var) (p : Addr)
  | elabel (x : Var) (p : Addr) | efunarg (p : Addr) (th : Alist)
  | eplus (p q : Addr) ;

Heap : U l = Addr -> Maybe Expr ;
ifBool (A : U l) (t f : A) : Bool -> A = split { true -> t ; false -> f } ;
ifNatEq (A : U l) (m n : Nat) (t f : A) : A = ifBool A t f (eqN m n) ;
upd (mu : Heap) (p0 : Addr) (e : Expr) (p : Addr) : Maybe Expr =
  ifNatEq (Maybe Expr) p p0 (just e) (mu p) ;

Env : U l = List (Pair[Nat, Ty]) ;
emptyEnv : Env = nil ;
ext (rho : Env) (x : Var) (a : Ty) : Env = cons (mkPair Nat Ty x a) rho ;
appendEnv : Env -> Env -> Env = split {
  nil -> \ rho -> rho ; cons b bs | r -> \ rho -> cons b (r rho) } ;
lookupEnv : Env -> Var -> Ty = split {
  nil -> \ x -> omega ;
  cons b bs | r -> \ x -> ifNatEq Ty b.fst x b.snd (r x) } ;

-- Parameterwise identities suffice: no function extensionality is used.
eqN-refl : (n : Nat) -> Id Bool (eqN n n) true = split {
  zero -> refl true ; suc n | r -> r } ;
upd-hit (mu : Heap) (p : Addr) (e : Expr) : Id (Maybe Expr) (upd mu p e p) (just e) =
  ap Bool (Maybe Expr) (\ b -> ifBool (Maybe Expr) (just e) (mu p) b)
    (eqN p p) true (eqN-refl p) ;
