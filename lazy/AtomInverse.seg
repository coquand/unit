level l ;
open Base ; open Prelude[l] ; open Types ; open Subtyping[l] ; open Shape[l] ;

-- A named atom occurs as a top-level intersection component.
AtomView (target : Atom) : Ty -> U l = split {
  omega -> Empty ; atomTop -> Empty ; at a -> Id Atom a target ;
  prod a b -> Empty ; arr a b -> Empty ; meet a b | ra rb -> Either ra rb } ;

atomPreserve (target : Atom) : (a b : Ty) -> Le a b -> AtomView target b -> AtomView target a = split {
  leRefl a -> \ h -> h ;
  leTrans a b c p q | rp rq -> \ h -> rp (rq h) ;
  meetLeft a b -> \ h -> inl h ;
  meetRight a b -> \ h -> inr h ;
  meetIntro r a b p q | rp rq -> split { inl h -> rp h ; inr h -> rq h } ;
  leTop a -> \ h -> absurd (AtomView target a) h ;
  atomBelow a -> \ h -> absurd (AtomView target (at a)) h ;
  prodMono a c b d p q -> \ h -> h ;
  prodMeet a b c d -> \ h -> absurd (AtomView target (meet (prod a b) (prod c d))) h ;
  arrMono a c b d p q -> \ h -> h ;
  arrMeet a b c -> \ h -> absurd (AtomView target (meet (arr a b) (arr a c))) h ;
  arrTop a -> \ h -> h } ;

atomInverse (rho : Ty) (a : Atom) (d : Le rho (at a)) : AtomView a rho =
  atomPreserve a rho (at a) d (refl a) ;

atomComplete (a : Atom) : (rho : Ty) -> AtomView a rho -> Le rho (at a) = split {
  omega -> \ h -> absurd (Le omega (at a)) h ;
  atomTop -> \ h -> absurd (Le atomTop (at a)) h ;
  at b -> \ h -> subst Atom (\ c -> Le (at b) (at c)) b a h (leRefl (at b)) ;
  prod b c -> \ h -> absurd (Le (prod b c) (at a)) h ;
  arr b c -> \ h -> absurd (Le (arr b c) (at a)) h ;
  meet b c | rb rc -> split {
    inl hb -> leTrans (meet b c) b (at a) (meetLeft b c) (rb hb) ;
    inr hc -> leTrans (meet b c) c (at a) (meetRight b c) (rc hc) } } ;

atomEquality (a b : Atom) (d : Le (at a) (at b)) : Id Atom a b = atomInverse (at a) b d ;

atomTopComplete : (rho : Ty) -> hasAtom rho -> Le rho atomTop = split {
  omega -> \ h -> absurd (Le omega atomTop) h ;
  atomTop -> \ h -> leRefl atomTop ;
  at a -> \ h -> atomBelow a ;
  prod a b -> \ h -> absurd (Le (prod a b) atomTop) h ;
  arr a b -> \ h -> absurd (Le (arr a b) atomTop) h ;
  meet a b | ra rb -> split {
    inl ha -> leTrans (meet a b) a atomTop (meetLeft a b) (ra ha) ;
    inr hb -> leTrans (meet a b) b atomTop (meetRight a b) (rb hb) } } ;
