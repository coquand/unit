-- Elementary data shared by the intersection presentation of LAZY.
data Top = tt ;
data Empty = ;
data Bool = false | true ;
data Nat = zero | suc (n : Nat) ;
data Atom = T | NIL | num (n : Nat) | sym (n : Nat) ;
plus : Nat -> Nat -> Nat = split { zero -> \ n -> n ; suc m | r -> \ n -> suc (r n) } ;
eqN : Nat -> Nat -> Bool = split {
  zero -> split { zero -> true ; suc n -> false } ;
  suc m | r -> split { zero -> false ; suc n -> r n } } ;
atomEq : Atom -> Atom -> Bool = split {
  T -> split { T -> true ; NIL -> false ; num n -> false ; sym n -> false } ;
  NIL -> split { T -> false ; NIL -> true ; num n -> false ; sym n -> false } ;
  num m -> split { T -> false ; NIL -> false ; num n -> eqN m n ; sym n -> false } ;
  sym m -> split { T -> false ; NIL -> false ; num n -> false ; sym n -> eqN m n } } ;
and : Bool -> Bool -> Bool = split { false -> \ b -> false ; true -> \ b -> b } ;
or : Bool -> Bool -> Bool = split { false -> \ b -> b ; true -> \ b -> true } ;
