-- Explicit support certificate for the finite initial memory of Example 4.
level l ;
open Base ; open Prelude[l] ; open Types ; open Memory[l] ; open MemoryLemmas[l] ;
open Rewrites[l] ; open HeapSupport[l] ; open Example4[l] ;

CellsClosed (P : Addr -> U l) : List Expr -> U l = split {
  nil -> Top ; cons e es | r -> Pair[ExprClosed P e, r] } ;
lookupClosed (P : Addr -> U l) : (es : List Expr) -> CellsClosed P es ->
    (p : Nat) -> (e : Expr) -> Id (Maybe Expr) (lookupCell es p) (just e) -> ExprClosed P e = split {
  nil -> \ h p e eq -> absurd (ExprClosed P e) (nothingNotJust e eq) ;
  cons x xs | r -> \ h -> split {
    zero -> \ e eq -> subst Expr (ExprClosed P) x e (contentsEq (just x) x e (refl (just x)) eq) h.fst ;
    suc p -> r h.snd p } } ;
d0 : InDom h0 n0 = defined h0 n0 (efunarg n1 nil) (refl (just (efunarg n1 nil))) ;
d1 : InDom h0 n1 = defined h0 n1 (eapp n2 n3) (refl (just (eapp n2 n3))) ;
d2 : InDom h0 n2 = defined h0 n2 (elam n0 n4) (refl (just (elam n0 n4))) ;
d3 : InDom h0 n3 = defined h0 n3 (elabel n1 n9) (refl (just (elabel n1 n9))) ;
d4 : InDom h0 n4 = defined h0 n4 (ecar n5) (refl (just (ecar n5))) ;
d5 : InDom h0 n5 = defined h0 n5 (ecdr n6) (refl (just (ecdr n6))) ;
d6 : InDom h0 n6 = defined h0 n6 (eapp n7 n8) (refl (just (eapp n7 n8))) ;
d7 : InDom h0 n7 = defined h0 n7 (evar n0) (refl (just (evar n0))) ;
d8 : InDom h0 n8 = defined h0 n8 (equote (num n0)) (refl (just (equote (num n0)))) ;
d9 : InDom h0 n9 = defined h0 n9 (elam n2 n10) (refl (just (elam n2 n10))) ;
d10 : InDom h0 n10 = defined h0 n10 (econs n11 n12) (refl (just (econs n11 n12))) ;
d11 : InDom h0 n11 = defined h0 n11 (evar n2) (refl (just (evar n2))) ;
d12 : InDom h0 n12 = defined h0 n12 (eapp n13 n14) (refl (just (eapp n13 n14))) ;
d13 : InDom h0 n13 = defined h0 n13 (evar n1) (refl (just (evar n1))) ;
d14 : InDom h0 n14 = defined h0 n14 (eplus n15 n16) (refl (just (eplus n15 n16))) ;
d15 : InDom h0 n15 = defined h0 n15 (evar n2) (refl (just (evar n2))) ;
d16 : InDom h0 n16 = defined h0 n16 (equote (num n1)) (refl (just (equote (num n1)))) ;

