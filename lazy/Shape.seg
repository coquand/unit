-- Shape and product inversion by interpretation of the declarative order.
-- These proofs use induction on Le, not a comparison algorithm.
level l ;
open Base ; open Prelude[l] ; open Types ; open Subtyping[l] ;

firstTy : Ty -> Ty = split {
  omega -> omega ; atomTop -> omega ; at a -> omega ;
  prod a b -> a ; arr a b -> omega ; meet a b | ra rb -> meet ra rb } ;
secondTy : Ty -> Ty = split {
  omega -> omega ; atomTop -> omega ; at a -> omega ;
  prod a b -> b ; arr a b -> omega ; meet a b | ra rb -> meet ra rb } ;

firstMono : (a b : Ty) -> Le a b -> Le (firstTy a) (firstTy b) = split {
  leRefl a -> leRefl (firstTy a) ;
  leTrans a b c p q | rp rq -> leTrans (firstTy a) (firstTy b) (firstTy c) rp rq ;
  meetLeft a b -> meetLeft (firstTy a) (firstTy b) ;
  meetRight a b -> meetRight (firstTy a) (firstTy b) ;
  meetIntro r a b p q | rp rq -> meetIntro (firstTy r) (firstTy a) (firstTy b) rp rq ;
  leTop a -> leTop (firstTy a) ;
  atomBelow a -> leRefl omega ;
  prodMono a c b d p q -> p ;
  prodMeet a b c d -> leRefl (meet a c) ;
  arrMono a c b d p q -> leRefl omega ;
  arrMeet a b c -> meetLeft omega omega ;
  arrTop a -> leRefl omega } ;

secondMono : (a b : Ty) -> Le a b -> Le (secondTy a) (secondTy b) = split {
  leRefl a -> leRefl (secondTy a) ;
  leTrans a b c p q | rp rq -> leTrans (secondTy a) (secondTy b) (secondTy c) rp rq ;
  meetLeft a b -> meetLeft (secondTy a) (secondTy b) ;
  meetRight a b -> meetRight (secondTy a) (secondTy b) ;
  meetIntro r a b p q | rp rq -> meetIntro (secondTy r) (secondTy a) (secondTy b) rp rq ;
  leTop a -> leTop (secondTy a) ;
  atomBelow a -> leRefl omega ;
  prodMono a c b d p q -> q ;
  prodMeet a b c d -> leRefl (meet b d) ;
  arrMono a c b d p q -> leRefl omega ;
  arrMeet a b c -> meetLeft omega omega ;
  arrTop a -> leRefl omega } ;

data Head = atomHead | pairHead | arrowHead ;
HeadEq : Head -> Head -> U l = split {
  atomHead -> split { atomHead -> Top ; pairHead -> Empty ; arrowHead -> Empty } ;
  pairHead -> split { atomHead -> Empty ; pairHead -> Top ; arrowHead -> Empty } ;
  arrowHead -> split { atomHead -> Empty ; pairHead -> Empty ; arrowHead -> Top } } ;

HasHead (k : Head) : Ty -> U l = split {
  omega -> Empty ; atomTop -> HeadEq k atomHead ; at a -> HeadEq k atomHead ;
  prod a b -> HeadEq k pairHead ; arr a b -> HeadEq k arrowHead ;
  meet a b | ra rb -> Either ra rb } ;

eitherOut (A B C : U l) (f : A -> C) (g : B -> C) : Either A B -> C =
  split { inl a -> f a ; inr b -> g b } ;

heads (k : Head) : (a b : Ty) -> Le a b -> HasHead k b -> HasHead k a = split {
  leRefl a -> \ h -> h ;
  leTrans a b c p q | rp rq -> \ h -> rp (rq h) ;
  meetLeft a b -> \ h -> inl h ;
  meetRight a b -> \ h -> inr h ;
  meetIntro r a b p q | rp rq -> eitherOut (HasHead k a) (HasHead k b) (HasHead k r) rp rq ;
  leTop a -> absurd (HasHead k a) ;
  atomBelow a -> \ h -> h ;
  prodMono a c b d p q -> \ h -> h ;
  prodMeet a b c d -> \ h -> inl h ;
  arrMono a c b d p q -> \ h -> h ;
  arrMeet a b c -> \ h -> inl h ;
  arrTop a -> \ h -> h } ;

hasArrow (a : Ty) : U l = HasHead arrowHead a ;
hasPair (a : Ty) : U l = HasHead pairHead a ;
hasAtom (a : Ty) : U l = HasHead atomHead a ;
arrowPresent (r a b : Ty) (p : Le r (arr a b)) : hasArrow r =
  heads arrowHead r (arr a b) p tt ;
pairPresent (r a b : Ty) (p : Le r (prod a b)) : hasPair r =
  heads pairHead r (prod a b) p tt ;

-- In particular the separated heads cannot collapse to no information.
noTopArrow (a b : Ty) (p : Le omega (arr a b)) : Empty = arrowPresent omega a b p ;
noTopPair (a b : Ty) (p : Le omega (prod a b)) : Empty = pairPresent omega a b p ;
noAtomArrow (x : Atom) (a b : Ty) (p : Le (at x) (arr a b)) : Empty = arrowPresent (at x) a b p ;
noPairArrow (a b c d : Ty) (p : Le (prod a b) (arr c d)) : Empty = arrowPresent (prod a b) c d p ;
noArrowPair (a b c d : Ty) (p : Le (arr a b) (prod c d)) : Empty = pairPresent (arr a b) c d p ;

pairFirst (a b c d : Ty) (p : Le (prod a b) (prod c d)) : Le a c =
  firstMono (prod a b) (prod c d) p ;
pairSecond (a b c d : Ty) (p : Le (prod a b) (prod c d)) : Le b d =
  secondMono (prod a b) (prod c d) p ;
