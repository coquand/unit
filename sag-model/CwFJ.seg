-- CwFJ.seg (M1 step 3, S5 toolkit): based J at a point.
--
-- For A over G and B2 over G.A, a point of G.A.B2 over G is y : A with
-- d : I', for a type I' and a path P : B2[sec y] = I'; the map is
--     instG y P d = upT (sec y) P o sec d : G -> G.A.B2.
-- Along instG: a type of G weakened twice is itself, its elements too
-- (wwT-inst, wwE-inst); the variable z of A is y (zv-inst); the last
-- variable is d (q-inst); a type over G.A weakened once is its value at
-- sec y (wT-inst, wE-inst); p o instG = sec y (p-inst).  Each is ovO
-- (over-paths compose along o s1 s2) of a leaf along upT (sec y) P
-- (CwFOv) and a leaf along sec d (CwFInt).
--
-- The context of J is the case B2 = Id(x p , q) (Dx, IK of CwFId.Der).
-- Its centre cen is instG x refl reflE BY DEFINITION (upT along refl is
-- lift), and the point (x , refl x) is cen (instRefl).  Jb: J-beta read as
-- an over-path along cen.  appLamInst: lam b at y, applied to d, is b at
-- the point (y , d).  With the motives written as types computed by
-- their stability lemmas, a J term is used through its values at points
-- and at cen.

open Base ;

module JPt (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;

  ----------------------------------------------------------------------
  -- over-paths compose

  ovO (E D G : Ctx) (A : Ty G) (s1 : Sub D G) (s2 : Sub E D) (A1 : Ty D) (P1 : Id (Ty D) (subT D G A s1) A1)
    (A2 : Ty E) (P2 : Id (Ty E) (subT E D A1 s2) A2) (P3 : Id (Ty E) (subT E G A (o E D G s1 s2)) A2)
    (a : El G A) (a1 : El D A1) (a2 : El E A2) (e1 : Ov D G A s1 A1 P1 a a1) (e2 : Ov E D A1 s2 A2 P2 a1 a2)
    : Ov E G A (o E D G s1 s2) A2 P3 a a2 =
    calc (El E A2) {
        trE E S A2 P3 x0
      =< trSame E S Y A2 P3 P2 (trans (Ty E) S X Y So AP1) x0 (trE E X Y AP1 (trE E S X So x0))
           (sym (El E Y) (trE E X Y AP1 (trE E S X So x0)) (trE E S Y (trans (Ty E) S X Y So AP1) x0) (trE-tr E S X Y So AP1 x0)) >
        trE E Y A2 P2 (trE E X Y AP1 (trE E S X So x0))
      =< ap (El E X) (El E A2) (\ v -> trE E Y A2 P2 (trE E X Y AP1 v)) (trE E S X So x0) (subt E D (subT D G A s1) (subt D G A a s1) s2)
            (subt-o E D G A a s1 s2) >
        trE E Y A2 P2 (trE E X Y AP1 (subt E D (subT D G A s1) (subt D G A a s1) s2))
      =< ap (El E Y) (El E A2) (\ v -> trE E Y A2 P2 v) (trE E X Y AP1 (subt E D (subT D G A s1) (subt D G A a s1) s2))
            (subt E D A1 (trE D (subT D G A s1) A1 P1 (subt D G A a s1)) s2)
            (sym (El E Y) (subt E D A1 (trE D (subT D G A s1) A1 P1 (subt D G A a s1)) s2)
                 (trE E X Y AP1 (subt E D (subT D G A s1) (subt D G A a s1) s2))
                 (subt-tr E D (subT D G A s1) A1 P1 (subt D G A a s1) s2)) >
        trE E Y A2 P2 (subt E D A1 (trE D (subT D G A s1) A1 P1 (subt D G A a s1)) s2)
      =< ap (El D A1) (El E A2) (\ v -> trE E Y A2 P2 (subt E D A1 v s2)) (trE D (subT D G A s1) A1 P1 (subt D G A a s1)) a1 e1 >
        trE E Y A2 P2 (subt E D A1 a1 s2)
      =< e2 >
        a2 }
   where {
    S : Ty E = subT E G A (o E D G s1 s2) ;
    X : Ty E = subT E D (subT D G A s1) s2 ;
    Y : Ty E = subT E D A1 s2 ;
    So : Id (Ty E) S X = subT-o E D G A s1 s2 ;
    AP1 : Id (Ty E) X Y = ap (Ty D) (Ty E) (\ Z -> subT E D Z s2) (subT D G A s1) A1 P1 ;
    x0 : El E S = subt E G A a (o E D G s1 s2) ;
   } ;

  -- a transport undone
  trE-sym (G : Ctx) (A A' : Ty G) (R : Id (Ty G) A A') (a' : El G A')
    : Id (El G A') (trE G A A' R (trE G A' A (sym (Ty G) A A' R) a')) a' =
    trans (El G A') (trE G A A' R (trE G A' A (sym (Ty G) A A' R) a')) (trE G A' A' (trans (Ty G) A' A A' (sym (Ty G) A A' R) R) a') a'
      (trE-tr G A' A A' (sym (Ty G) A A' R) R a')
      (trE-irr G A' A' (trans (Ty G) A' A A' (sym (Ty G) A A' R) R) (refl A') a') ;

  ----------------------------------------------------------------------
  -- the map of a point, and the leaves along it


  up1 (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I')
    : Sub (ext G I') (ext (ext G A) B2) = upT G (ext G A) B2 (sec G A y) I' P ;

  instG (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    : Sub G (ext (ext G A) B2) = o G (ext G I') (ext (ext G A) B2) (up1 G A B2 y I' P) (sec G I' d) ;

  -- a type of G, weakened twice
  wwT (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (B : Ty G) : Ty (ext (ext G A) B2) = wkT (ext G A) B2 (wkT G A B) ;
  wwE (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (B : Ty G) (b : El G B) : El (ext (ext G A) B2) (wwT G A B2 B) =
    wkE (ext G A) B2 (wkT G A B) (wkE G A B b) ;

  -- the variable z of A
  zv (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) : El (ext (ext G A) B2) (wwT G A B2 A) = wkE (ext G A) B2 (wkT G A A) (q G A) ;

  -- (B p p)[instG] = B
  wwT-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (B : Ty G) : Id (Ty G) (subT G (ext (ext G A) B2) (wwT G A B2 B) (instG G A B2 y I' P d)) B =
    trans (Ty G) (subT G (ext (ext G A) B2) (wwT G A B2 B) (instG G A B2 y I' P d)) (subT G (ext G I') (wkT G I' B) (sec G I' d)) B
      (trans (Ty G) (subT G (ext (ext G A) B2) (wwT G A B2 B) (instG G A B2 y I' P d))
                    (subT G (ext G I') (subT (ext G I') (ext (ext G A) B2) (wwT G A B2 B) (up1 G A B2 y I' P)) (sec G I' d))
                    (subT G (ext G I') (wkT G I' B) (sec G I' d))
         (subT-o G (ext G I') (ext (ext G A) B2) (wwT G A B2 B) (up1 G A B2 y I' P) (sec G I' d))
         (ap (Ty (ext G I')) (Ty G) (\ Z -> subT G (ext G I') Z (sec G I' d))
             (subT (ext G I') (ext (ext G A) B2) (wwT G A B2 B) (up1 G A B2 y I' P)) (wkT G I' B)
             (wkT-ov G (ext G A) B2 (wkT G A B) (sec G A y) I' P B (p-sec-T G A B y))))
      (p-sec-T G I' B d) ;

  wwE-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (B : Ty G) (b : El G B) (PB : Id (Ty G) (subT G (ext (ext G A) B2) (wwT G A B2 B) (instG G A B2 y I' P d)) B)
    : Ov G (ext (ext G A) B2) (wwT G A B2 B) (instG G A B2 y I' P d) B PB (wwE G A B2 B b) b =
    ovO G (ext G I') (ext (ext G A) B2) (wwT G A B2 B) (up1 G A B2 y I' P) (sec G I' d) (wkT G I' B) W B (p-sec-T G I' B d) PB
      (wwE G A B2 B b) (wkE G I' B b) b
      (wkE-ov G (ext G A) B2 (wkT G A B) (wkE G A B b) (sec G A y) I' P B (p-sec-T G A B y) b
         (IN.wkE-sec G A B y b (p-sec-T G A B y)) W)
      (IN.wkE-sec G I' B d b (p-sec-T G I' B d))
   where {
    W : Id (Ty (ext G I')) (subT (ext G I') (ext (ext G A) B2) (wwT G A B2 B) (up1 G A B2 y I' P)) (wkT G I' B) =
      wkT-ov G (ext G A) B2 (wkT G A B) (sec G A y) I' P B (p-sec-T G A B y) ;
   } ;

  zv-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (PB : Id (Ty G) (subT G (ext (ext G A) B2) (wwT G A B2 A) (instG G A B2 y I' P d)) A)
    : Ov G (ext (ext G A) B2) (wwT G A B2 A) (instG G A B2 y I' P d) A PB (zv G A B2) y =
    ovO G (ext G I') (ext (ext G A) B2) (wwT G A B2 A) (up1 G A B2 y I' P) (sec G I' d) (wkT G I' A) W A (p-sec-T G I' A d) PB
      (zv G A B2) (wkE G I' A y) y
      (wkE-ov G (ext G A) B2 (wkT G A A) (q G A) (sec G A y) I' P A (p-sec-T G A A y) y
         (IN.q-secO G A y (p-sec-T G A A y)) W)
      (IN.wkE-sec G I' A d y (p-sec-T G I' A d))
   where {
    W : Id (Ty (ext G I')) (subT (ext G I') (ext (ext G A) B2) (wwT G A B2 A) (up1 G A B2 y I' P)) (wkT G I' A) =
      wkT-ov G (ext G A) B2 (wkT G A A) (sec G A y) I' P A (p-sec-T G A A y) ;
   } ;

  -- the last variable u is delta
  qT-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    : Id (Ty G) (subT G (ext (ext G A) B2) (wkT (ext G A) B2 B2) (instG G A B2 y I' P d)) I' =
    trans (Ty G) (subT G (ext (ext G A) B2) WI (instG G A B2 y I' P d))
                 (subT G (ext G I') (subT (ext G I') (ext (ext G A) B2) WI (up1 G A B2 y I' P)) (sec G I' d)) I'
      (subT-o G (ext G I') (ext (ext G A) B2) WI (up1 G A B2 y I' P) (sec G I' d))
      (trans (Ty G) (subT G (ext G I') (subT (ext G I') (ext (ext G A) B2) WI (up1 G A B2 y I' P)) (sec G I' d))
                    (subT G (ext G I') (wkT G I' I') (sec G I' d)) I'
         (ap (Ty (ext G I')) (Ty G) (\ Z -> subT G (ext G I') Z (sec G I' d))
             (subT (ext G I') (ext (ext G A) B2) WI (up1 G A B2 y I' P)) (wkT G I' I') (wkT-ov G (ext G A) B2 B2 (sec G A y) I' P I' P))
         (p-sec-T G I' I' d))
   where { WI : Ty (ext (ext G A) B2) = wkT (ext G A) B2 B2 ; } ;

  q-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (PB : Id (Ty G) (subT G (ext (ext G A) B2) (wkT (ext G A) B2 B2) (instG G A B2 y I' P d)) I')
    : Ov G (ext (ext G A) B2) (wkT (ext G A) B2 B2) (instG G A B2 y I' P d) I' PB (q (ext G A) B2) d =
    ovO G (ext G I') (ext (ext G A) B2) (wkT (ext G A) B2 B2) (up1 G A B2 y I' P) (sec G I' d) (wkT G I' I') W I'
      (p-sec-T G I' I' d) PB (q (ext G A) B2) (q G I') d
      (q-ov G (ext G A) B2 (sec G A y) I' P W)
      (IN.q-secO G I' d (p-sec-T G I' I' d))
   where {
    W : Id (Ty (ext G I')) (subT (ext G I') (ext (ext G A) B2) (wkT (ext G A) B2 B2) (up1 G A B2 y I' P)) (wkT G I' I') =
      wkT-ov G (ext G A) B2 B2 (sec G A y) I' P I' P ;
   } ;

  -- a type over G.A, weakened once: its value at y
  wT-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (B : Ty (ext G A)) : Id (Ty G) (subT G (ext (ext G A) B2) (wkT (ext G A) B2 B) (instG G A B2 y I' P d)) (subT G (ext G A) B (sec G A y)) =
    trans (Ty G) (subT G (ext (ext G A) B2) WB (instG G A B2 y I' P d))
                 (subT G (ext G I') (subT (ext G I') (ext (ext G A) B2) WB (up1 G A B2 y I' P)) (sec G I' d)) By
      (subT-o G (ext G I') (ext (ext G A) B2) WB (up1 G A B2 y I' P) (sec G I' d))
      (trans (Ty G) (subT G (ext G I') (subT (ext G I') (ext (ext G A) B2) WB (up1 G A B2 y I' P)) (sec G I' d))
                    (subT G (ext G I') (wkT G I' By) (sec G I' d)) By
         (ap (Ty (ext G I')) (Ty G) (\ Z -> subT G (ext G I') Z (sec G I' d))
             (subT (ext G I') (ext (ext G A) B2) WB (up1 G A B2 y I' P)) (wkT G I' By)
             (wkT-ov G (ext G A) B2 B (sec G A y) I' P By (refl By)))
         (p-sec-T G I' By d))
   where {
    WB : Ty (ext (ext G A) B2) = wkT (ext G A) B2 B ;
    By : Ty G = subT G (ext G A) B (sec G A y) ;
   } ;

  wE-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (B : Ty (ext G A)) (b : El (ext G A) B)
    (PB : Id (Ty G) (subT G (ext (ext G A) B2) (wkT (ext G A) B2 B) (instG G A B2 y I' P d)) (subT G (ext G A) B (sec G A y)))
    : Ov G (ext (ext G A) B2) (wkT (ext G A) B2 B) (instG G A B2 y I' P d) (subT G (ext G A) B (sec G A y)) PB
         (wkE (ext G A) B2 B b) (subt G (ext G A) B b (sec G A y)) =
    ovO G (ext G I') (ext (ext G A) B2) (wkT (ext G A) B2 B) (up1 G A B2 y I' P) (sec G I' d) (wkT G I' By) W By (p-sec-T G I' By d) PB
      (wkE (ext G A) B2 B b) (wkE G I' By (subt G (ext G A) B b (sec G A y))) (subt G (ext G A) B b (sec G A y))
      (wkE-ov G (ext G A) B2 B b (sec G A y) I' P By (refl By) (subt G (ext G A) B b (sec G A y)) (refl (subt G (ext G A) B b (sec G A y))) W)
      (IN.wkE-sec G I' By d (subt G (ext G A) B b (sec G A y)) (p-sec-T G I' By d))
   where {
    By : Ty G = subT G (ext G A) B (sec G A y) ;
    W : Id (Ty (ext G I')) (subT (ext G I') (ext (ext G A) B2) (wkT (ext G A) B2 B) (up1 G A B2 y I' P)) (wkT G I' By) =
      wkT-ov G (ext G A) B2 B (sec G A y) I' P By (refl By) ;
   } ;

  ----------------------------------------------------------------------
  -- the context of J: B2 = Id(x p , q)

  Dx (G : Ctx) (A : Ty G) (x : El G A) : Ctx = DJ.Dx G A x ;
  IK (G : Ctx) (A : Ty G) (x : El G A) : Ty (ext G A) = DJ.IK G A x ;

  IKpt (G : Ctx) (A : Ty G) (x y : El G A)
    : Id (Ty G) (subT G (ext G A) (IK G A x) (sec G A y)) (IJ.IdT G A x y) =
    Id-ov G (ext G A) (wkT G A A) (wkE G A A x) (q G A) (sec G A y) A (p-sec-T G A A y) x y
      (IN.wkE-sec G A A y x (p-sec-T G A A y)) (IN.q-secO G A y (p-sec-T G A A y)) ;

  IK-ov (D G : Ctx) (A : Ty G) (x : El G A) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (x' : El D A') (Px : Ov D G A s A' PA x x')
    : Id (Ty (ext D A')) (subT (ext D A') (ext G A) (IK G A x) (upT D G A s A' PA)) (IK D A' x') =
    Id-ov (ext D A') (ext G A) (wkT G A A) (wkE G A A x) (q G A) (upT D G A s A' PA) (wkT D A' A') W
      (wkE D A' A' x') (q D A') (wkE-ov D G A A x s A' PA A' PA x' Px W) (q-ov D G A s A' PA W)
   where { W : Id (Ty (ext D A')) (subT (ext D A') (ext G A) (wkT G A A) (upT D G A s A' PA)) (wkT D A' A') = wkT-ov D G A A s A' PA A' PA ; } ;

  -- the variable u read in Id(z' , z) over Dx (z' = x weakened twice)
  uvP (G : Ctx) (A : Ty G) (x : El G A)
    : Id (Ty (Dx G A x)) (wkT (ext G A) (IK G A x) (IK G A x)) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) =
    Id-ov (Dx G A x) (ext G A) (wkT G A A) (wkE G A A x) (q G A) (p (ext G A) (IK G A x)) (wwT G A (IK G A x) A) (refl (wwT G A (IK G A x) A))
      (wwE G A (IK G A x) A x) (zv G A (IK G A x)) (refl (wwE G A (IK G A x) A x)) (refl (zv G A (IK G A x))) ;

  uv (G : Ctx) (A : Ty G) (x : El G A) : El (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) =
    trE (Dx G A x) (wkT (ext G A) (IK G A x) (IK G A x)) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (uvP G A x)
      (q (ext G A) (IK G A x)) ;

  -- at a point (y , d) with I' = Id(x , y): u is d
  uv-inst (G : Ctx) (A : Ty G) (x y : El G A) (d : El G (IJ.IdT G A x y))
    (PB : Id (Ty G) (subT G (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (instG G A (IK G A x) y (IJ.IdT G A x y) (IKpt G A x y) d))
                    (IJ.IdT G A x y))
    : Ov G (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (instG G A (IK G A x) y (IJ.IdT G A x y) (IKpt G A x y) d)
         (IJ.IdT G A x y) PB (uv G A x) d =
    ovTr G (Dx G A x) (wkT (ext G A) (IK G A x) (IK G A x)) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (uvP G A x)
      (instG G A (IK G A x) y (IJ.IdT G A x y) (IKpt G A x y) d) (IJ.IdT G A x y) (IJ.IdT G A x y) (refl (IJ.IdT G A x y))
      (qT-inst G A (IK G A x) y (IJ.IdT G A x y) (IKpt G A x y) d) PB (q (ext G A) (IK G A x)) d
      (q-inst G A (IK G A x) y (IJ.IdT G A x y) (IKpt G A x y) d (qT-inst G A (IK G A x) y (IJ.IdT G A x y) (IKpt G A x y) d)) ;

  -- at cen: u is rfl x
  uv-cen (G : Ctx) (A : Ty G) (x : El G A)
    (PB : Id (Ty G) (subT G (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (DJ.cen G A x)) (IJ.IdT G A x x))
    : Ov G (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (DJ.cen G A x) (IJ.IdT G A x x) PB (uv G A x) (IJ.rfl G A x) =
    trans (El G (IJ.IdT G A x x))
      (trE G (subT G (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (DJ.cen G A x)) (IJ.IdT G A x x) PB
         (subt G (Dx G A x) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (uv G A x) (DJ.cen G A x)))
      (trE G (subT G (ext G A) (IK G A x) (sec G A x)) (IJ.IdT G A x x) (DJ.reflT G A x) (DJ.reflE G A x)) (IJ.rfl G A x)
      (ovTr G (Dx G A x) (wkT (ext G A) (IK G A x) (IK G A x)) (IJ.IdT (Dx G A x) (wwT G A (IK G A x) A) (wwE G A (IK G A x) A x) (zv G A (IK G A x))) (uvP G A x)
         (DJ.cen G A x) (subT G (ext G A) (IK G A x) (sec G A x)) (IJ.IdT G A x x) (DJ.reflT G A x)
         (qT-inst G A (IK G A x) x (subT G (ext G A) (IK G A x) (sec G A x)) (refl (subT G (ext G A) (IK G A x) (sec G A x))) (DJ.reflE G A x)) PB
         (q (ext G A) (IK G A x)) (DJ.reflE G A x)
         (q-inst G A (IK G A x) x (subT G (ext G A) (IK G A x) (sec G A x)) (refl (subT G (ext G A) (IK G A x) (sec G A x))) (DJ.reflE G A x)
            (qT-inst G A (IK G A x) x (subT G (ext G A) (IK G A x) (sec G A x)) (refl (subT G (ext G A) (IK G A x) (sec G A x))) (DJ.reflE G A x))))
      (trE-sym G (subT G (ext G A) (IK G A x) (sec G A x)) (IJ.IdT G A x x) (DJ.reflT G A x) (IJ.rfl G A x)) ;

  ----------------------------------------------------------------------
  -- J-beta along cen, for a start given as a transport of a base

  Jb (G : Ctx) (A : Ty G) (x : El G A) (CM : Ty (Dx G A x)) (T0 : Ty G)
    (PD PD' : Id (Ty G) (subT G (Dx G A x) CM (DJ.cen G A x)) T0) (base : El G T0)
    : Ov G (Dx G A x) CM (DJ.cen G A x) T0 PD
         (IJ.J G A x CM (trE G T0 (subT G (Dx G A x) CM (DJ.cen G A x)) (sym (Ty G) (subT G (Dx G A x) CM (DJ.cen G A x)) T0 PD') base)) base =
    trans (El G T0) (trE G Sc T0 PD (subt G (Dx G A x) CM (IJ.J G A x CM d) (DJ.cen G A x))) (trE G Sc T0 PD d) base
      (ap (El G Sc) (El G T0) (\ v -> trE G Sc T0 PD v) (subt G (Dx G A x) CM (IJ.J G A x CM d) (DJ.cen G A x)) d (IJ.J-beta G A x CM d))
      (trans (El G T0) (trE G Sc T0 PD d) (trE G Sc T0 PD' d) base
         (trE-irr G Sc T0 PD PD' d)
         (trE-sym G Sc T0 PD' base))
   where {
    Sc : Ty G = subT G (Dx G A x) CM (DJ.cen G A x) ;
    d : El G Sc = trE G T0 Sc (sym (Ty G) Sc T0 PD') base ;
   } ;

  ----------------------------------------------------------------------
  -- the point (x , refl x) is cen

  instRefl (G : Ctx) (A : Ty G) (x : El G A)
    : Id (Sub G (Dx G A x)) (instG G A (IK G A x) x (IJ.IdT G A x x) (IKpt G A x x) (IJ.rfl G A x)) (DJ.cen G A x) =
    trans (Sub G (Dx G A x)) (instG G A (IK G A x) x (IJ.IdT G A x x) (IKpt G A x x) (IJ.rfl G A x))
      (o G (ext G I0) (Dx G A x) (lift G (ext G A) (IK G A x) (sec G A x)) (sec G I0 (trE G (IJ.IdT G A x x) I0 (sym (Ty G) I0 (IJ.IdT G A x x) (IKpt G A x x)) (IJ.rfl G A x))))
      (DJ.cen G A x)
      (IN.upT-sec G (ext G A) (IK G A x) I0 (IJ.IdT G A x x) (IKpt G A x x) (lift G (ext G A) (IK G A x) (sec G A x)) (IJ.rfl G A x))
      (ap (El G I0) (Sub G (Dx G A x)) (\ v -> o G (ext G I0) (Dx G A x) (lift G (ext G A) (IK G A x) (sec G A x)) (sec G I0 v))
          (trE G (IJ.IdT G A x x) I0 (sym (Ty G) I0 (IJ.IdT G A x x) (IKpt G A x x)) (IJ.rfl G A x)) (DJ.reflE G A x)
          (trE-irr G (IJ.IdT G A x x) I0 (sym (Ty G) I0 (IJ.IdT G A x x) (IKpt G A x x)) (sym (Ty G) I0 (IJ.IdT G A x x) (DJ.reflT G A x)) (IJ.rfl G A x)))
   where { I0 : Ty G = subT G (ext G A) (IK G A x) (sec G A x) ; } ;

  ----------------------------------------------------------------------
  -- lam b at y, applied to d, is b at the point (y , d)

  appLamInst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (B : Ty (ext G A)) (y : El G A) (I' : Ty G)
    (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    (b : El (ext (ext G A) B2) (wkT (ext G A) B2 B))
    (PF : Id (Ty G) (subT G (ext G A) (Fun (ext G A) B2 B) (sec G A y)) (Fun G I' (subT G (ext G A) B (sec G A y))))
    : Ov G (ext (ext G A) B2) (wkT (ext G A) B2 B) (instG G A B2 y I' P d) (subT G (ext G A) B (sec G A y)) (wT-inst G A B2 y I' P d B) b
         (app G I' (subT G (ext G A) B (sec G A y))
            (trE G (subT G (ext G A) (Fun (ext G A) B2 B) (sec G A y)) (Fun G I' (subT G (ext G A) B (sec G A y))) PF
               (subt G (ext G A) (Fun (ext G A) B2 B) (lam (ext G A) B2 (wkT (ext G A) B2 B) b) (sec G A y)))
            d) =
    calc (El G By) {
        trE G Xo By (wT-inst G A B2 y I' P d B) (subt G E2 WB b (instG G A B2 y I' P d))
      =< trSame G Xo Y2 By (wT-inst G A B2 y I' P d B) (trans (Ty G) Y2 Y3 By APB PST) (subT-o G (ext G I') E2 WB (up1 G A B2 y I' P) (sec G I' d))
           (subt G E2 WB b (instG G A B2 y I' P d)) bb (subt-o G (ext G I') E2 WB b (up1 G A B2 y I' P) (sec G I' d)) >
        trE G Y2 By (trans (Ty G) Y2 Y3 By APB PST) bb
      =< sym (El G By) (trE G Y3 By PST (trE G Y2 Y3 APB bb)) (trE G Y2 By (trans (Ty G) Y2 Y3 By APB PST) bb) (trE-tr G Y2 Y3 By APB PST bb) >
        trE G Y3 By PST (trE G Y2 Y3 APB bb)
      =< ap (El G Y3) (El G By) (\ v -> trE G Y3 By PST v) (trE G Y2 Y3 APB bb) (subt G (ext G I') (wkT G I' By) b' (sec G I' d))
            (sym (El G Y3) (subt G (ext G I') (wkT G I' By) b' (sec G I' d)) (trE G Y2 Y3 APB bb)
               (subt-tr G (ext G I') (subT (ext G I') E2 WB (up1 G A B2 y I' P)) (wkT G I' By) PB
                  (subt (ext G I') E2 WB b (up1 G A B2 y I' P)) (sec G I' d))) >
        trE G Y3 By PST (subt G (ext G I') (wkT G I' By) b' (sec G I' d))
      =< sym (El G By) (app G I' By (lam G I' (wkT G I' By) b') d) (trE G Y3 By PST (subt G (ext G I') (wkT G I' By) b' (sec G I' d)))
            (IN.app-lam G I' By b' d) >
        app G I' By (lam G I' (wkT G I' By) b') d
      =< ap (El G (Fun G I' By)) (El G By) (\ F -> app G I' By F d) (lam G I' (wkT G I' By) b')
            (trE G (subT G (ext G A) (Fun (ext G A) B2 B) (sec G A y)) (Fun G I' By) PF (subt G (ext G A) (Fun (ext G A) B2 B) L (sec G A y)))
            (sym (El G (Fun G I' By)) (trE G (subT G (ext G A) (Fun (ext G A) B2 B) (sec G A y)) (Fun G I' By) PF (subt G (ext G A) (Fun (ext G A) B2 B) L (sec G A y)))
                 (lam G I' (wkT G I' By) b')
                 (IN.lam-ov G (ext G A) B2 WB (sec G A y) I' P (wkT G I' By) PB PF b b' (refl b'))) >
        app G I' By (trE G (subT G (ext G A) (Fun (ext G A) B2 B) (sec G A y)) (Fun G I' By) PF (subt G (ext G A) (Fun (ext G A) B2 B) L (sec G A y))) d }
   where {
    E2 : Ctx = ext (ext G A) B2 ;
    WB : Ty E2 = wkT (ext G A) B2 B ;
    By : Ty G = subT G (ext G A) B (sec G A y) ;
    L : El (ext G A) (Fun (ext G A) B2 B) = lam (ext G A) B2 WB b ;
    PB : Id (Ty (ext G I')) (subT (ext G I') E2 WB (up1 G A B2 y I' P)) (wkT G I' By) = wkT-ov G (ext G A) B2 B (sec G A y) I' P By (refl By) ;
    b' : El (ext G I') (wkT G I' By) = trE (ext G I') (subT (ext G I') E2 WB (up1 G A B2 y I' P)) (wkT G I' By) PB (subt (ext G I') E2 WB b (up1 G A B2 y I' P)) ;
    Xo : Ty G = subT G E2 WB (instG G A B2 y I' P d) ;
    Y2 : Ty G = subT G (ext G I') (subT (ext G I') E2 WB (up1 G A B2 y I' P)) (sec G I' d) ;
    Y3 : Ty G = subT G (ext G I') (wkT G I' By) (sec G I' d) ;
    APB : Id (Ty G) Y2 Y3 = ap (Ty (ext G I')) (Ty G) (\ Z -> subT G (ext G I') Z (sec G I' d)) (subT (ext G I') E2 WB (up1 G A B2 y I' P)) (wkT G I' By) PB ;
    PST : Id (Ty G) Y3 By = p-sec-T G I' By d ;
    bb : El G Y2 = subt G (ext G I') (subT (ext G I') E2 WB (up1 G A B2 y I' P)) (subt (ext G I') E2 WB b (up1 G A B2 y I' P)) (sec G I' d) ;
   } ;

  ----------------------------------------------------------------------
  -- p of a point is sec y; q along extS s a is a

  p-inst (G : Ctx) (A : Ty G) (B2 : Ty (ext G A)) (y : El G A) (I' : Ty G) (P : Id (Ty G) (subT G (ext G A) B2 (sec G A y)) I') (d : El G I')
    : Id (Sub G (ext G A)) (o G (ext (ext G A) B2) (ext G A) (p (ext G A) B2) (instG G A B2 y I' P d)) (sec G A y) =
    idJ (Ty G) (subT G (ext G A) B2 (sec G A y))
      (\ X PX -> (d2 : El G X) -> Id (Sub G (ext G A)) (o G (ext (ext G A) B2) (ext G A) (p (ext G A) B2) (instG G A B2 y X PX d2)) (sec G A y))
      (\ d2 -> IN.p-extS G (ext G A) B2 (sec G A y) d2)
      I' P d ;

  q-extS (D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s))
    (PW : Id (Ty D) (subT D (ext G A) (wkT G A A) (extS D G A s a)) (subT D G A s))
    : Ov D (ext G A) (wkT G A A) (extS D G A s a) (subT D G A s) PW (q G A) a =
    ovO D (ext D (subT D G A s)) (ext G A) (wkT G A A) (lift D G A s) (sec D (subT D G A s) a) (wkT D (subT D G A s) (subT D G A s)) W
      (subT D G A s) (p-sec-T D (subT D G A s) (subT D G A s) a) PW (q G A) (q D (subT D G A s)) a
      (q-ov D G A s (subT D G A s) (refl (subT D G A s)) W)
      (IN.q-secO D (subT D G A s) a (p-sec-T D (subT D G A s) (subT D G A s) a))
   where {
    W : Id (Ty (ext D (subT D G A s))) (subT (ext D (subT D G A s)) (ext G A) (wkT G A A) (lift D G A s)) (wkT D (subT D G A s) (subT D G A s)) =
      wkT-ov D G A A s (subT D G A s) (refl (subT D G A s)) (subT D G A s) (refl (subT D G A s)) ;
   } ;
} ;
