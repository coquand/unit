-- CwFChi.seg (M1 step 3): the classifying map of a code, apart from
-- univalence.  In a CwF with a universe Un (Cod , Dec), U0 = 1.Cod is the
-- universal context; a code a over G is classified by chi a = (eps , a) :
-- G -> U0 (Chi: needs only the CwF and Un).  Its laws (ChiL): the
-- universal code a0 = q along chi a is a (Ta, as a TE chain; Pa, as an
-- over-path), and chi a after s is chi a[s] (chiNat).  The laws are
-- stated with the TE / Ov calculus, which is set up for a CwF with Pi,
-- Sigma and Swan Id; they use no univalence and no funext.
--
-- Informal text.  chi a = extS eps a', a' = a transported along Cod-nat.
-- Ta: a0 = q transported along Cod-nat; q along extS is a' (q-extS); a'
-- is a transport of a.  chiNat: two maps into U0 = 1.Cod are equal when
-- their Cod parts agree (ext-eq), both being a[s] up to transports.

open Base ;

module Chi (l : Level) (C : CwF.CwF[l]) (Un : CwFU.Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;

  -- the universal context
  U0 : Ctx = ext nil (Un.Cod nil) ;

  -- the classifying map of a code
  chi (G : Ctx) (a : El G (Un.Cod G)) : Sub G U0 =
    extS G nil (Un.Cod nil) (eps G) (subst (Ty G) (El G) (Un.Cod G) (subT G nil (Un.Cod nil) (eps G)) (sym (Ty G) (subT G nil (Un.Cod nil) (eps G)) (Un.Cod G) (Un.Cod-nat G nil (eps G))) a) ;
} ;

module ChiL (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (Un : CwFU.Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  open Chi[l, C, Un] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module PJ = CwFPrj.Prj[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module UU = CwFU.UnivUa[l, C, PS, SS, IJ, Un] ;
  module DU = CwFU.Univ[l, C].DerU[Un.Cod, Un.Cod-nat] ;

  -- the universal code
  a0 : El U0 (Un.Cod U0) = UU.qc nil ;

  -- a0 along chi a is a
  Ta (G : Ctx) (a : El G (Un.Cod G))
    : IN.TE G (subT G U0 (Un.Cod U0) (chi G a)) (Un.Cod G) (subt G U0 (Un.Cod U0) a0 (chi G a)) a =
    IN.teT G (subT G U0 (Un.Cod U0) (chi G a)) (subT G U0 (wkT nil (Un.Cod nil) (Un.Cod nil)) (chi G a)) (Un.Cod G)
      (subt G U0 (Un.Cod U0) a0 (chi G a)) (subt G U0 (wkT nil (Un.Cod nil) (Un.Cod nil)) (q nil (Un.Cod nil)) (chi G a)) a
      (SV.teSub G U0 (Un.Cod U0) (wkT nil (Un.Cod nil) (Un.Cod nil)) a0 (q nil (Un.Cod nil))
         (PJ.teTrS U0 (wkT nil (Un.Cod nil) (Un.Cod nil)) (Un.Cod U0) (Un.Cod-nat U0 nil (p nil (Un.Cod nil))) (q nil (Un.Cod nil))) (chi G a))
      (IN.teT G (subT G U0 (wkT nil (Un.Cod nil) (Un.Cod nil)) (chi G a)) (subT G nil (Un.Cod nil) (eps G)) (Un.Cod G)
         (subt G U0 (wkT nil (Un.Cod nil) (Un.Cod nil)) (q nil (Un.Cod nil)) (chi G a)) ac a
         (IN.teOv G U0 (wkT nil (Un.Cod nil) (Un.Cod nil)) (chi G a) (subT G nil (Un.Cod nil) (eps G))
            (IN.wkT-extS G nil (Un.Cod nil) (Un.Cod nil) (eps G) ac) (q nil (Un.Cod nil)) ac
            (JP.q-extS G nil (Un.Cod nil) (eps G) ac (IN.wkT-extS G nil (Un.Cod nil) (Un.Cod nil) (eps G) ac)))
         (PJ.teTrS G (Un.Cod G) (subT G nil (Un.Cod nil) (eps G)) (sym (Ty G) (subT G nil (Un.Cod nil) (eps G)) (Un.Cod G) (Un.Cod-nat G nil (eps G))) a))
   where {
    ac : El G (subT G nil (Un.Cod nil) (eps G)) =
      trE G (Un.Cod G) (subT G nil (Un.Cod nil) (eps G)) (sym (Ty G) (subT G nil (Un.Cod nil) (eps G)) (Un.Cod G) (Un.Cod-nat G nil (eps G))) a ;
   } ;

  Pa (G : Ctx) (a : El G (Un.Cod G)) : Ov G U0 (Un.Cod U0) (chi G a) (Un.Cod G) (Un.Cod-nat G U0 (chi G a)) a0 a =
    IN.teAny G (subT G U0 (Un.Cod U0) (chi G a)) (Un.Cod G) (subt G U0 (Un.Cod U0) a0 (chi G a)) a (Ta G a) (Un.Cod-nat G U0 (chi G a)) ;


  -- chi a after s is chi a[s]
  chiNat (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G)
    : Id (Sub D U0) (o D G U0 (chi G a) s) (chi D (DU.subU D G a s)) =
    IN.ext-eq D nil (Un.Cod nil) (o D G U0 (chi G a) s) (chi D (DU.subU D G a s))
      (trans (Sub D nil) (o D U0 nil (p nil (Un.Cod nil)) (o D G U0 (chi G a) s)) (eps D) (o D U0 nil (p nil (Un.Cod nil)) (chi D (DU.subU D G a s)))
         (eps-uniq D (o D U0 nil (p nil (Un.Cod nil)) (o D G U0 (chi G a) s)))
         (sym (Sub D nil) (o D U0 nil (p nil (Un.Cod nil)) (chi D (DU.subU D G a s))) (eps D) (eps-uniq D (o D U0 nil (p nil (Un.Cod nil)) (chi D (DU.subU D G a s))))))
      (Un.Cod D) (DU.subU D G a s)
      T1.1 T1.2 T2.1 T2.2
   where {
    W1 : Ty nil = Un.Cod nil ;
    T1 : IN.TE D (subT D U0 (wkT nil W1 W1) (o D G U0 (chi G a) s)) (Un.Cod D) (subt D U0 (wkT nil W1 W1) (q nil W1) (o D G U0 (chi G a) s)) (DU.subU D G a s) =
      IN.teT D (subT D U0 (wkT nil W1 W1) (o D G U0 (chi G a) s)) (subT D G (subT G U0 (wkT nil W1 W1) (chi G a)) s) (Un.Cod D)
        (subt D U0 (wkT nil W1 W1) (q nil W1) (o D G U0 (chi G a) s)) (subt D G (subT G U0 (wkT nil W1 W1) (chi G a)) (subt G U0 (wkT nil W1 W1) (q nil W1) (chi G a)) s)
        (DU.subU D G a s)
        (IN.teSubtO D G U0 (wkT nil W1 W1) (q nil W1) (chi G a) s)
        (IN.teT D (subT D G (subT G U0 (wkT nil W1 W1) (chi G a)) s) (subT D G (Un.Cod G) s) (Un.Cod D)
           (subt D G (subT G U0 (wkT nil W1 W1) (chi G a)) (subt G U0 (wkT nil W1 W1) (q nil W1) (chi G a)) s) (subt D G (Un.Cod G) a s) (DU.subU D G a s)
           (SV.teSub D G (subT G U0 (wkT nil W1 W1) (chi G a)) (Un.Cod G) (subt G U0 (wkT nil W1 W1) (q nil W1) (chi G a)) a
              (IN.teT G (subT G U0 (wkT nil W1 W1) (chi G a)) (subT G U0 (Un.Cod U0) (chi G a)) (Un.Cod G)
                 (subt G U0 (wkT nil W1 W1) (q nil W1) (chi G a)) (subt G U0 (Un.Cod U0) a0 (chi G a)) a
                 (SV.teSub G U0 (wkT nil W1 W1) (Un.Cod U0) (q nil W1) a0 (IN.teTr U0 (wkT nil W1 W1) (Un.Cod U0) (Un.Cod-nat U0 nil (p nil W1)) (q nil W1)) (chi G a))
                 (Ta G a)) s)
           (IN.teTr D (subT D G (Un.Cod G) s) (Un.Cod D) (Un.Cod-nat D G s) (subt D G (Un.Cod G) a s))) ;
    T2 : IN.TE D (subT D U0 (wkT nil W1 W1) (chi D (DU.subU D G a s))) (Un.Cod D) (subt D U0 (wkT nil W1 W1) (q nil W1) (chi D (DU.subU D G a s))) (DU.subU D G a s) =
      IN.teT D (subT D U0 (wkT nil W1 W1) (chi D (DU.subU D G a s))) (subT D U0 (Un.Cod U0) (chi D (DU.subU D G a s))) (Un.Cod D)
        (subt D U0 (wkT nil W1 W1) (q nil W1) (chi D (DU.subU D G a s))) (subt D U0 (Un.Cod U0) a0 (chi D (DU.subU D G a s))) (DU.subU D G a s)
        (SV.teSub D U0 (wkT nil W1 W1) (Un.Cod U0) (q nil W1) a0 (IN.teTr U0 (wkT nil W1 W1) (Un.Cod U0) (Un.Cod-nat U0 nil (p nil W1)) (q nil W1)) (chi D (DU.subU D G a s)))
        (Ta D (DU.subU D G a s)) ;
   } ;
} ;
