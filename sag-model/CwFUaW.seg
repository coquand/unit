-- CwFUaW.seg (M1 step 3, S4): the univalence field UaContr from one
-- contractibility at the universal context, in a CwF with Pi, Sigma, Swan
-- Id, naive funext NF and a universe Un.
--
-- Informal text.  U0 = 1.Cod is the universal context, with the code a0 = q.
-- Given uaC0 : isContr (Sigma b Sigma (r : Dec b -> Dec a0) Kr r) over U0,
-- CwFS4.s4 gives K0 : isContr (UaT a0) over U0.  For a code a over G, the
-- classifying map chi a : G -> U0 = (eps , a) takes a0 to a, so K0 along
-- chi a is UaContr G a.  Naturality: chi a after s is chi a[s] (both are
-- (eps , a[s]): ext-eq), so UaContr G a along s is UaContr D a[s].

open Base ;

module UaW (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g))
  (Un : CwFU.Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  open CwFChi.Chi[l, C, Un] ;
  open CwFChi.ChiL[l, C, PS, SS, IJ, Un] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module PJ = CwFPrj.Prj[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module QP = CwFQP.QP[l, C, PS, SS, IJ, NF] ;
  module S4 = CwFS4.S4[l, C, PS, SS, IJ, NF] ;
  module UU = CwFU.UnivUa[l, C, PS, SS, IJ, Un] ;
  module DU = CwFU.Univ[l, C].DerU[Un.Cod, Un.Cod-nat] ;

  -- the universal context and code
  X0 : Ty (ext U0 (Un.Cod U0)) = wkT U0 (Un.Cod U0) (Un.Dec U0 a0) ;
  Y0 : Ty (ext U0 (Un.Cod U0)) = Un.Dec (ext U0 (Un.Cod U0)) (UU.qc U0) ;

  -- the hypothesis: core's univalence, read at U0
  UaC0 : Ty U0 =
    EQ.isContr U0 (SS.Sig U0 (Un.Cod U0) (SS.Sig (ext U0 (Un.Cod U0)) (Fun (ext U0 (Un.Cod U0)) Y0 X0) (QP.QV[ext U0 (Un.Cod U0), X0, Y0].K1))) ;

  module W (uaC0 : El U0 UaC0) {
    K0 : El U0 (EQ.isContr U0 (UU.UaT U0 a0)) = S4.s4 U0 (Un.Cod U0) X0 Y0 uaC0 ;

    PU (G : Ctx) (a : El G (Un.Cod G))
      : Id (Ty G) (subT G U0 (EQ.isContr U0 (UU.UaT U0 a0)) (chi G a)) (EQ.isContr G (UU.UaT G a)) =
      EQ.isContr-ov G U0 (UU.UaT U0 a0) (chi G a) (UU.UaT G a) (UU.UaT-ov' G U0 a0 (chi G a) a (Pa G a)) ;

    UaContr (G : Ctx) (a : El G (Un.Cod G)) : El G (EQ.isContr G (UU.UaT G a)) =
      trE G (subT G U0 (EQ.isContr U0 (UU.UaT U0 a0)) (chi G a)) (EQ.isContr G (UU.UaT G a)) (PU G a)
        (subt G U0 (EQ.isContr U0 (UU.UaT U0 a0)) K0 (chi G a)) ;


    UaContr-nat (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G)
      : Ov D G (EQ.isContr G (UU.UaT G a)) s (EQ.isContr D (UU.UaT D (DU.subU D G a s)))
           (EQ.isContr-ov D G (UU.UaT G a) s (UU.UaT D (DU.subU D G a s)) (UU.UaT-ov D G a s))
           (UaContr G a) (UaContr D (DU.subU D G a s)) =
      IN.teAny D (subT D G (EQ.isContr G (UU.UaT G a)) s) (EQ.isContr D (UU.UaT D (DU.subU D G a s)))
        (subt D G (EQ.isContr G (UU.UaT G a)) (UaContr G a) s) (UaContr D (DU.subU D G a s))
        (IN.teT D (subT D G (EQ.isContr G (UU.UaT G a)) s) (subT D G (subT G U0 KT (chi G a)) s) (EQ.isContr D (UU.UaT D (DU.subU D G a s)))
           (subt D G (EQ.isContr G (UU.UaT G a)) (UaContr G a) s) (subt D G (subT G U0 KT (chi G a)) (subt G U0 KT K0 (chi G a)) s) (UaContr D (DU.subU D G a s))
           (SV.teSub D G (EQ.isContr G (UU.UaT G a)) (subT G U0 KT (chi G a)) (UaContr G a) (subt G U0 KT K0 (chi G a))
              (PJ.teTrS G (subT G U0 KT (chi G a)) (EQ.isContr G (UU.UaT G a)) (PU G a) (subt G U0 KT K0 (chi G a))) s)
           (IN.teT D (subT D G (subT G U0 KT (chi G a)) s) (subT D U0 KT (o D G U0 (chi G a) s)) (EQ.isContr D (UU.UaT D (DU.subU D G a s)))
              (subt D G (subT G U0 KT (chi G a)) (subt G U0 KT K0 (chi G a)) s) (subt D U0 KT K0 (o D G U0 (chi G a) s)) (UaContr D (DU.subU D G a s))
              (IN.teS D (subT D U0 KT (o D G U0 (chi G a) s)) (subT D G (subT G U0 KT (chi G a)) s)
                 (subt D U0 KT K0 (o D G U0 (chi G a) s)) (subt D G (subT G U0 KT (chi G a)) (subt G U0 KT K0 (chi G a)) s)
                 (IN.teSubtO D G U0 KT K0 (chi G a) s))
              (IN.teT D (subT D U0 KT (o D G U0 (chi G a) s)) (subT D U0 KT (chi D (DU.subU D G a s))) (EQ.isContr D (UU.UaT D (DU.subU D G a s)))
                 (subt D U0 KT K0 (o D G U0 (chi G a) s)) (subt D U0 KT K0 (chi D (DU.subU D G a s))) (UaContr D (DU.subU D G a s))
                 (IN.teSubEq D U0 KT K0 (o D G U0 (chi G a) s) (chi D (DU.subU D G a s)) (chiNat D G a s))
                 (IN.teTr D (subT D U0 KT (chi D (DU.subU D G a s))) (EQ.isContr D (UU.UaT D (DU.subU D G a s))) (PU D (DU.subU D G a s))
                    (subt D U0 KT K0 (chi D (DU.subU D G a s)))))))
        (EQ.isContr-ov D G (UU.UaT G a) s (UU.UaT D (DU.subU D G a s)) (UU.UaT-ov D G a s))
     where { KT : Ty U0 = EQ.isContr U0 (UU.UaT U0 a0) ; } ;

    uaStr : UU.UaStr = new UU.UaStr[UaContr, UaContr-nat] ;
  } ;
} ;
