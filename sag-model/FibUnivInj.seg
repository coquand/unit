-- Decoding reflects equality of fibrant types. The lift reflects
-- equality of the underlying small types and preserves their readings.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module S = PB.CSmall ;
open PB.GPre[a+].PS ;
module W0 = V[a] ;
module W1 = V[a+] ;
module FS = FibNameSub[a] ;
module NT = FibNameTy[a] ;
module Lift = FibPiLift[a] ;
module Uv = FibUniv[a] ;
module FN = FibName[a] ;
module NY = FibNameYon[a] ;

cast-small (v w : W0.V) (p : Id W0.V v w) (q : Id W1.V (S.smallC v) (S.smallC w)) (u : W0.Ix v)
  : Id (W0.Ix w) (subst W1.V (\ k -> W1.Ix k) (S.smallC v) (S.smallC w) q u) (PB.CExtEq1.sV v w p u) =
  idJ W0.V v
    (\ z r -> (q0 : Id W1.V (S.smallC v) (S.smallC z)) ->
      Id (W0.Ix z) (subst W1.V (\ k -> W1.Ix k) (S.smallC v) (S.smallC z) q0 u) (PB.CExtEq1.sV v z r u))
    (\ q0 -> apH (\ r -> subst W1.V (\ k -> W1.Ix k) (S.smallC v) (S.smallC v) r u)
      (W1.isSetV (S.smallC v) (S.smallC v) q0 (refl (S.smallC v)))) w p q ;
opaque cast-small ;

-- A type path is compatible with the action after reading its fibres.
module Action (G : PCtx) (A B : PTy[G]) (P : Id (PTy[G]) A B) {
  code (I : Ob) (x : W1.Ix (G.ob I)) : Id W1.V (A.tob I x) (B.tob I x) =
    apH (\ T -> T.tob I x) P ;

  coe (I : Ob) (x : W1.Ix (G.ob I)) (u : W1.Ix (A.tob I x)) : W1.Ix (B.tob I x) =
    subst W1.V (\ k -> W1.Ix k) (A.tob I x) (B.tob I x) (code I x) u ;

  law (J I : Ob) (f : Hom J I) (x : W1.Ix (G.ob I)) (y : W1.Ix (G.ob J))
    (e : Id (W1.Ix (G.ob J)) (G.act J I f x) y) (u : W1.Ix (A.tob I x))
    : Id (W1.Ix (B.tob J y)) (coe J y (A.tact J I f x y e u)) (B.tact J I f x y e (coe I x u)) =
    idJ (PTy[G]) A
      (\ T R -> Id (W1.Ix (T.tob J y))
         (subst W1.V (\ k -> W1.Ix k) (A.tob J y) (T.tob J y) (apH (\ X -> X.tob J y) R) (A.tact J I f x y e u))
         (T.tact J I f x y e (subst W1.V (\ k -> W1.Ix k) (A.tob I x) (T.tob I x) (apH (\ X -> X.tob I x) R) u)))
      (refl (A.tact J I f x y e u)) B P ;
  opaque law ;
} ;

module Up (G : PCtx) (A B : S.SPTy[G]) (P : Id (PTy[G]) (S.up G A) (S.up G B)) {
  module T = Action[G, S.up G A, S.up G B, P] ;

  Po (I : Ob) (x : W1.Ix (G.ob I)) : Id W0.V (A.tob I x) (B.tob I x) =
    Lift.small-inj (A.tob I x) (B.tob I x) (T.code I x) ;

  module E = NT.Ext[G].Pointwise[A, B, Po] ;

  read (I : Ob) (x : W1.Ix (G.ob I)) (u : W0.Ix (A.tob I x))
    : Id (W0.Ix (B.tob I x)) (T.coe I x u) (E.cast I x u) =
    cast-small (A.tob I x) (B.tob I x) (Po I x) (T.code I x) u ;

  law : Id (S.SPTy[G]) A B =
    E.law (\ J I f x y e u ->
      transH (symH (read J y (A.tact J I f x y e u)))
        (transH (T.law J I f x y e u) (apH (B.tact J I f x y e) (read I x u)))) ;
  opaque law ;
} ;

module Large (G : PCtx) (A B : FS.SmallFib G) (P : Id (FS.FC.STy G) (FS.large G A) (FS.large G B)) {
  T : PTy[G] = (FS.large G B).1 ;
  types : Id (S.SPTy[G]) A.1 B.1 =
    Up[G, A.1, B.1, apH (\ F -> F.1) P].law ;

  Fib (X : PTy[G]) : U a++ = PB.CLine[a+].Lines[G, X].Fib ;
  c : Fib T = subst (S.SPTy[G]) (\ X -> Fib (S.up G X)) A.1 B.1 types A.2 ;
  A' : FS.SmallFib G = (B.1, c) ;

  move : Id (FS.SmallFib G) A A' =
    Sigma-path (S.SPTy[G]) (\ X -> Fib (S.up G X)) A.1 B.1 A.2 c types (refl c) ;

  P' : Id (FS.FC.STy G) (T, c) (T, B.2) =
    transH (symH (apH (FS.large G) move)) P ;

  r : (p : Id (PTy[G]) T T) * Id (Fib T) (subst (PTy[G]) Fib T T p c) B.2 =
    sPath (PTy[G]) Fib (T, c) (T, B.2) P' ;

  structures : Id (Fib T) c B.2 =
    transH (apH (\ p -> subst (PTy[G]) Fib T T p c) (isSet-PTy G T T (refl T) r.1)) r.2 ;

  law : Id (FS.SmallFib G) A B =
    transH move (apH {Fib T} {FS.SmallFib G} (\ d -> (B.1, d)) structures) ;
  opaque law ;
} ;

dec-inj (G : PCtx) (c d : PEl[G, (Uv.Cod G).1]) (P : Id (Uv.FC.STy G) (Uv.Dec G c) (Uv.Dec G d))
  : Id (PEl[G, (Uv.Cod G).1]) c d =
  transH (symH (NY.name-dec G c))
    (transH (apH (FN.name G) (Large[G, FN.decodeSmall G c, FN.decodeSmall G d, P].law)) (NY.name-dec G d)) ;
opaque dec-inj ;
