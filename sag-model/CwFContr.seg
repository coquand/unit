-- CwFContr.seg (M1 step 3, S5 toolkit): a contraction normalised at a
-- point, in a CwF with Pi, Sigma and Swan Id.
--
-- Informal text.  Let X be a type over G with c : X and
-- ctr : Pi (w : X) Id(c , w), and y0 : X.
-- (1) T1, by J on z , u : Id(c , z):
--       T1(z , u) : Pi (w : X) (Id(c , w) -> Id(z , w)),  T1(c , refl) = \ w v. v.
--     T1y = T1(y0 , ctr y0), and gam w = T1y w (ctr w) : Id(y0 , w).
-- (2) Theta, by J on z , u : Id(c , z):  T1(z , u) z u = refl z.  At
--     refl it is (\ v. v) refl = refl.  At (y0 , ctr y0):
--       Thy : Id(T1y y0 (ctr y0) , refl y0),
--     and gam at y0 is T1y y0 (ctr y0) (gamAt).
-- The motives MT1, MTh are written for any context; their stability
-- lemmas compute them at cen (CwFJ.Jb) and at the point (y0 , ctr y0).

open Base ;

module Contr (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;

  ----------------------------------------------------------------------
  -- the motives

  MT1 (D : Ctx) (X : Ty D) (c z : El D X) : Ty D = PS.Pi D X (Fun (ext D X) (JP.IK D X c) (JP.IK D X z)) ;

  MT1-ov (D G : Ctx) (X : Ty G) (c z : El G X) (s : Sub D G) (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X')
    (c' : El D X') (Pc : Ov D G X s X' PX c c') (z' : El D X') (Pz : Ov D G X s X' PX z z')
    : Id (Ty D) (subT D G (MT1 G X c z) s) (MT1 D X' c' z') =
    Pi-ov D G X (Fun (ext G X) (JP.IK G X c) (JP.IK G X z)) s X' PX (Fun (ext D X') (JP.IK D X' c') (JP.IK D X' z'))
      (Fun-ov (ext D X') (ext G X) (JP.IK G X c) (JP.IK G X z) (upT D G X s X' PX)
         (JP.IK D X' c') (JP.IK-ov D G X c s X' PX c' Pc) (JP.IK D X' z') (JP.IK-ov D G X z s X' PX z' Pz)) ;

  -- T at z, as a function Id(c , z) -> Id(z , z)
  FAz (D : Ctx) (X : Ty D) (c z : El D X)
    : Id (Ty D) (subT D (ext D X) (Fun (ext D X) (JP.IK D X c) (JP.IK D X z)) (sec D X z)) (Fun D (IJ.IdT D X c z) (IJ.IdT D X z z)) =
    Fun-ov D (ext D X) (JP.IK D X c) (JP.IK D X z) (sec D X z) (IJ.IdT D X c z) (JP.IKpt D X c z) (IJ.IdT D X z z) (JP.IKpt D X z z) ;

  TA (D : Ctx) (X : Ty D) (c z : El D X) (T : El D (MT1 D X c z)) : El D (Fun D (IJ.IdT D X c z) (IJ.IdT D X z z)) =
    trE D (subT D (ext D X) (Fun (ext D X) (JP.IK D X c) (JP.IK D X z)) (sec D X z)) (Fun D (IJ.IdT D X c z) (IJ.IdT D X z z))
      (FAz D X c z) (IN.appD D X (Fun (ext D X) (JP.IK D X c) (JP.IK D X z)) T z) ;

  MTh (D : Ctx) (X : Ty D) (c z : El D X) (u : El D (IJ.IdT D X c z)) (T : El D (MT1 D X c z)) : Ty D =
    IJ.IdT D (IJ.IdT D X z z) (app D (IJ.IdT D X c z) (IJ.IdT D X z z) (TA D X c z T) u) (IJ.rfl D X z) ;

  TA-ov (D G : Ctx) (X : Ty G) (c z : El G X) (s : Sub D G) (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X')
    (c' : El D X') (Pc : Ov D G X s X' PX c c') (z' : El D X') (Pz : Ov D G X s X' PX z z')
    (T : El G (MT1 G X c z)) (T' : El D (MT1 D X' c' z')) (PT : Ov D G (MT1 G X c z) s (MT1 D X' c' z') (MT1-ov D G X c z s X' PX c' Pc z' Pz) T T')
    (PF : Id (Ty D) (subT D G (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) s) (Fun D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z')))
    : Ov D G (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) s (Fun D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z')) PF (TA G X c z T) (TA D X' c' z' T') =
    ovTr D G (subT G (ext G X) FG (sec G X z)) (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) (FAz G X c z) s
      (subT D (ext D X') FD (sec D X' z')) (Fun D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z')) (FAz D X' c' z') PApD PF
      (IN.appD G X FG T z) (IN.appD D X' FD T' z')
      (IN.appD-ov D G X FG s X' PX FD
         (Fun-ov (ext D X') (ext G X) (JP.IK G X c) (JP.IK G X z) (upT D G X s X' PX)
            (JP.IK D X' c') (JP.IK-ov D G X c s X' PX c' Pc) (JP.IK D X' z') (JP.IK-ov D G X z s X' PX z' Pz))
         (MT1-ov D G X c z s X' PX c' Pc z' Pz) T T' PT z z' Pz PApD)
   where {
    FG : Ty (ext G X) = Fun (ext G X) (JP.IK G X c) (JP.IK G X z) ;
    FD : Ty (ext D X') = Fun (ext D X') (JP.IK D X' c') (JP.IK D X' z') ;
    PApD : Id (Ty D) (subT D G (subT G (ext G X) FG (sec G X z)) s) (subT D (ext D X') FD (sec D X' z')) =
      trans (Ty D) (subT D G (subT G (ext G X) FG (sec G X z)) s) (subT D G (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) s)
                   (subT D (ext D X') FD (sec D X' z'))
        (ap (Ty G) (Ty D) (\ Y -> subT D G Y s) (subT G (ext G X) FG (sec G X z)) (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) (FAz G X c z))
        (trans (Ty D) (subT D G (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) s) (Fun D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z'))
                      (subT D (ext D X') FD (sec D X' z'))
           PF (sym (Ty D) (subT D (ext D X') FD (sec D X' z')) (Fun D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z')) (FAz D X' c' z'))) ;
   } ;

  MTh-ov (D G : Ctx) (X : Ty G) (c z : El G X) (u : El G (IJ.IdT G X c z)) (T : El G (MT1 G X c z))
    (s : Sub D G) (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X')
    (c' : El D X') (Pc : Ov D G X s X' PX c c') (z' : El D X') (Pz : Ov D G X s X' PX z z')
    (u' : El D (IJ.IdT D X' c' z')) (Pu : Ov D G (IJ.IdT G X c z) s (IJ.IdT D X' c' z') (Id-ov D G X c z s X' PX c' z' Pc Pz) u u')
    (T' : El D (MT1 D X' c' z')) (PT : Ov D G (MT1 G X c z) s (MT1 D X' c' z') (MT1-ov D G X c z s X' PX c' Pc z' Pz) T T')
    : Id (Ty D) (subT D G (MTh G X c z u T) s) (MTh D X' c' z' u' T') =
    Id-ov D G (IJ.IdT G X z z) (app G (IJ.IdT G X c z) (IJ.IdT G X z z) (TA G X c z T) u) (IJ.rfl G X z) s
      (IJ.IdT D X' z' z') PZZ (app D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z') (TA D X' c' z' T') u') (IJ.rfl D X' z')
      (app-ov D G (IJ.IdT G X c z) (IJ.IdT G X z z) s (IJ.IdT D X' c' z') PCZ (IJ.IdT D X' z' z') PZZ PF
         (TA G X c z T) (TA D X' c' z' T') (TA-ov D G X c z s X' PX c' Pc z' Pz T T' PT PF) u u' Pu)
      (IN.rfl-ov D G X z s X' PX z' Pz PZZ)
   where {
    PCZ : Id (Ty D) (subT D G (IJ.IdT G X c z) s) (IJ.IdT D X' c' z') = Id-ov D G X c z s X' PX c' z' Pc Pz ;
    PZZ : Id (Ty D) (subT D G (IJ.IdT G X z z) s) (IJ.IdT D X' z' z') = Id-ov D G X z z s X' PX z' z' Pz Pz ;
    PF : Id (Ty D) (subT D G (Fun G (IJ.IdT G X c z) (IJ.IdT G X z z)) s) (Fun D (IJ.IdT D X' c' z') (IJ.IdT D X' z' z')) =
      Fun-ov D G (IJ.IdT G X c z) (IJ.IdT G X z z) s (IJ.IdT D X' c' z') PCZ (IJ.IdT D X' z' z') PZZ ;
   } ;

  ----------------------------------------------------------------------
  -- the normalisation

  module Norm (G : Ctx) (X : Ty G) (c : El G X) (ctrPi : El G (PS.Pi G X (JP.IK G X c))) (y0 : El G X) {
    Bc : Ty (ext G X) = JP.IK G X c ;
    Dc : Ctx = JP.Dx G X c ;
    X2 : Ty Dc = JP.wwT G X Bc X ;
    c2 : El Dc X2 = JP.wwE G X Bc X c ;
    z2 : El Dc X2 = JP.zv G X Bc ;
    I0 : Ty G = subT G (ext G X) Bc (sec G X c) ;

    -- the leaves at cen
    PXc : Id (Ty G) (subT G Dc X2 (DJ.cen G X c)) X = JP.wwT-inst G X Bc c I0 (refl I0) (DJ.reflE G X c) X ;
    Pcc : Ov G Dc X2 (DJ.cen G X c) X PXc c2 c = JP.wwE-inst G X Bc c I0 (refl I0) (DJ.reflE G X c) X c PXc ;
    Pzc : Ov G Dc X2 (DJ.cen G X c) X PXc z2 c = JP.zv-inst G X Bc c I0 (refl I0) (DJ.reflE G X c) PXc ;

    -- (1) T1
    CM1 : Ty Dc = MT1 Dc X2 c2 z2 ;
    base1 : El G (MT1 G X c c) = lam G X (Fun (ext G X) Bc Bc) (IN.idF (ext G X) Bc) ;
    PC1 : Id (Ty G) (subT G Dc CM1 (DJ.cen G X c)) (MT1 G X c c) = MT1-ov G Dc X2 c2 z2 (DJ.cen G X c) X PXc c Pcc c Pzc ;
    T1J : El Dc CM1 = IJ.J G X c CM1 (trE G (MT1 G X c c) (subT G Dc CM1 (DJ.cen G X c)) (sym (Ty G) (subT G Dc CM1 (DJ.cen G X c)) (MT1 G X c c) PC1) base1) ;
    T1b : Ov G Dc CM1 (DJ.cen G X c) (MT1 G X c c) PC1 T1J base1 = JP.Jb G X c CM1 (MT1 G X c c) PC1 PC1 base1 ;

    -- (2) Theta
    Icc : Ty G = IJ.IdT G X c c ;
    CMh : Ty Dc = MTh Dc X2 c2 z2 (JP.uv G X c) T1J ;

    -- (\ v. v) refl = refl
    idAt : Id (El G (Fun G Icc Icc)) (TA G X c c base1) (IN.idF G Icc) =
      trans (El G (Fun G Icc Icc)) (TA G X c c base1)
            (trE G (subT G (ext G X) (Fun (ext G X) Bc Bc) (sec G X c)) (Fun G Icc Icc) (FAz G X c c)
                 (subt G (ext G X) (Fun (ext G X) Bc Bc) (IN.idF (ext G X) Bc) (sec G X c)))
            (IN.idF G Icc)
        (ap (El G (subT G (ext G X) (Fun (ext G X) Bc Bc) (sec G X c))) (El G (Fun G Icc Icc))
            (\ v -> trE G (subT G (ext G X) (Fun (ext G X) Bc Bc) (sec G X c)) (Fun G Icc Icc) (FAz G X c c) v)
            (IN.appD G X (Fun (ext G X) Bc Bc) base1 c) (subt G (ext G X) (Fun (ext G X) Bc Bc) (IN.idF (ext G X) Bc) (sec G X c))
            (IN.appD-lam G X (Fun (ext G X) Bc Bc) (IN.idF (ext G X) Bc) c))
        (IN.lam-ov G (ext G X) Bc (wkT (ext G X) Bc Bc) (sec G X c) Icc (JP.IKpt G X c c) (wkT G Icc Icc) PBq (FAz G X c c)
           (q (ext G X) Bc) (q G Icc) (q-ov G (ext G X) Bc (sec G X c) Icc (JP.IKpt G X c c) PBq))
     where {
      PBq : Id (Ty (ext G Icc)) (subT (ext G Icc) (ext (ext G X) Bc) (wkT (ext G X) Bc Bc) (upT G (ext G X) Bc (sec G X c) Icc (JP.IKpt G X c c)))
               (wkT G Icc Icc) =
        wkT-ov G (ext G X) Bc Bc (sec G X c) Icc (JP.IKpt G X c c) Icc (JP.IKpt G X c c) ;
     } ;

    baseh : El G (MTh G X c c (IJ.rfl G X c) base1) =
      IN.idOfEq G Icc (app G Icc Icc (TA G X c c base1) (IJ.rfl G X c)) (IJ.rfl G X c)
        (trans (El G Icc) (app G Icc Icc (TA G X c c base1) (IJ.rfl G X c)) (app G Icc Icc (IN.idF G Icc) (IJ.rfl G X c)) (IJ.rfl G X c)
           (ap (El G (Fun G Icc Icc)) (El G Icc) (\ F -> app G Icc Icc F (IJ.rfl G X c)) (TA G X c c base1) (IN.idF G Icc) idAt)
           (IN.app-idF G Icc (IJ.rfl G X c))) ;

    PCh : Id (Ty G) (subT G Dc CMh (DJ.cen G X c)) (MTh G X c c (IJ.rfl G X c) base1) =
      MTh-ov G Dc X2 c2 z2 (JP.uv G X c) T1J (DJ.cen G X c) X PXc c Pcc c Pzc (IJ.rfl G X c)
        (JP.uv-cen G X c (Id-ov G Dc X2 c2 z2 (DJ.cen G X c) X PXc c c Pcc Pzc)) base1 T1b ;

    ThJ : El Dc CMh = IJ.J G X c CMh (trE G (MTh G X c c (IJ.rfl G X c) base1) (subT G Dc CMh (DJ.cen G X c))
                                         (sym (Ty G) (subT G Dc CMh (DJ.cen G X c)) (MTh G X c c (IJ.rfl G X c) base1) PCh) baseh) ;

    -- the point (y0 , ctr y0)
    Iy : Ty G = IJ.IdT G X c y0 ;
    dy : El G Iy = trE G (subT G (ext G X) Bc (sec G X y0)) Iy (JP.IKpt G X c y0) (IN.appD G X Bc ctrPi y0) ;
    iota : Sub G Dc = JP.instG G X Bc y0 Iy (JP.IKpt G X c y0) dy ;
    PXy : Id (Ty G) (subT G Dc X2 iota) X = JP.wwT-inst G X Bc y0 Iy (JP.IKpt G X c y0) dy X ;
    Pcy : Ov G Dc X2 iota X PXy c2 c = JP.wwE-inst G X Bc y0 Iy (JP.IKpt G X c y0) dy X c PXy ;
    Pzy : Ov G Dc X2 iota X PXy z2 y0 = JP.zv-inst G X Bc y0 Iy (JP.IKpt G X c y0) dy PXy ;

    PT1y : Id (Ty G) (subT G Dc CM1 iota) (MT1 G X c y0) = MT1-ov G Dc X2 c2 z2 iota X PXy c Pcy y0 Pzy ;
    T1y : El G (MT1 G X c y0) = trE G (subT G Dc CM1 iota) (MT1 G X c y0) PT1y (subt G Dc CM1 T1J iota) ;

    PThy : Id (Ty G) (subT G Dc CMh iota) (MTh G X c y0 dy T1y) =
      MTh-ov G Dc X2 c2 z2 (JP.uv G X c) T1J iota X PXy c Pcy y0 Pzy dy
        (JP.uv-inst G X c y0 dy (Id-ov G Dc X2 c2 z2 iota X PXy c y0 Pcy Pzy)) T1y (refl T1y) ;

    -- Theta at (y0 , ctr y0)
    Thy : El G (MTh G X c y0 dy T1y) = trE G (subT G Dc CMh iota) (MTh G X c y0 dy T1y) PThy (subt G Dc CMh ThJ iota) ;

    -- gam w = T1y w (ctr w) : Id(y0 , w), and its value at y0
    Iyy : Ty G = IJ.IdT G X y0 y0 ;
    F1 : Ty (ext G X) = Fun (ext G X) Bc (JP.IK G X y0) ;
    gam : El (ext G X) (JP.IK G X y0) = app (ext G X) Bc (JP.IK G X y0) (bod G X F1 T1y) (bod G X Bc ctrPi) ;

    gamAt : Ov G (ext G X) (JP.IK G X y0) (sec G X y0) Iyy (JP.IKpt G X y0 y0) gam (app G Iy Iyy (TA G X c y0 T1y) dy) =
      app-ov G (ext G X) Bc (JP.IK G X y0) (sec G X y0) Iy (JP.IKpt G X c y0) Iyy (JP.IKpt G X y0 y0) (FAz G X c y0)
        (bod G X F1 T1y) (TA G X c y0 T1y) (refl (TA G X c y0 T1y)) (bod G X Bc ctrPi) dy (refl dy) ;
  } ;
} ;
