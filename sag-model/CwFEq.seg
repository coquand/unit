-- CwFEq.seg (M1 step 3, S1 part 2): contractibility and bi-invertible
-- equivalences as types of a CwF with Pi, Sigma and Swan Id, stable under
-- substitution.  isEquiv and Equiv are the source's (Prelude.IsEquiv: sec,
-- sec-eq, ret, ret-eq, as nested Sigma in this order); ruling 2026-11-09:
-- the univalence field is stated with them (M1.md, the univalence bridge).
--
--   isContr A   = Sigma (x : A) Pi (y : A) Id(x , y)
--   Htpy u v    = Pi (y : Y) Id(u (v y) , y)          (u : X -> Y, v : Y -> X)
--   RetT u      = Sigma (h : Y -> X) Htpy h u          (u : X -> Y)
--   isEquiv f   = Sigma (g : B -> A) Sigma (Htpy f g) (RetT f)
--   Equiv A B   = Sigma (f : A -> B) isEquiv f
--
-- with the variables bound by context extension and the outer data
-- weakened (wkT, wkE; wkF for functions; qF the last variable read as a
-- function).  Each stability lemma is an application of the lemmas of
-- CwFOv along the maps upT: the stability of a composite is the
-- composite of the stabilities of its parts.

open Base ;

module Eqv (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- weakened functions, and the last variable as a function

  wkFP (G : Ctx) (X A B : Ty G)
    : Id (Ty (ext G X)) (subT (ext G X) G (Fun G A B) (p G X)) (Fun (ext G X) (wkT G X A) (wkT G X B)) =
    Fun-ov (ext G X) G A B (p G X) (wkT G X A) (refl (wkT G X A)) (wkT G X B) (refl (wkT G X B)) ;

  wkF (G : Ctx) (X A B : Ty G) (f : El G (Fun G A B)) : El (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) =
    trE (ext G X) (wkT G X (Fun G A B)) (Fun (ext G X) (wkT G X A) (wkT G X B)) (wkFP G X A B) (wkE G X (Fun G A B) f) ;

  qF (G : Ctx) (A B : Ty G)
    : El (ext G (Fun G A B)) (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B)) =
    trE (ext G (Fun G A B)) (wkT G (Fun G A B) (Fun G A B)) (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B))
      (wkFP G (Fun G A B) A B) (q G (Fun G A B)) ;

  -- f over f' gives (wkF f) over (wkF f'), along upT s PX
  wkF-ov (D G : Ctx) (X A B : Ty G) (s : Sub D G) (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X')
    (A' B' : Ty D) (PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B'))
    (f : El G (Fun G A B)) (f' : El D (Fun D A' B')) (Pf : Ov D G (Fun G A B) s (Fun D A' B') PF f f')
    (PW : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (upT D G X s X' PX))
             (Fun (ext D X') (wkT D X' A') (wkT D X' B')))
    : Ov (ext D X') (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (upT D G X s X' PX)
         (Fun (ext D X') (wkT D X' A') (wkT D X' B')) PW (wkF G X A B f) (wkF D X' A' B' f') =
    ovTr (ext D X') (ext G X) (wkT G X (Fun G A B)) (Fun (ext G X) (wkT G X A) (wkT G X B)) (wkFP G X A B)
      (upT D G X s X' PX) (wkT D X' (Fun D A' B')) (Fun (ext D X') (wkT D X' A') (wkT D X' B')) (wkFP D X' A' B')
      (wkT-ov D G X (Fun G A B) s X' PX (Fun D A' B') PF) PW
      (wkE G X (Fun G A B) f) (wkE D X' (Fun D A' B') f')
      (wkE-ov D G X (Fun G A B) f s X' PX (Fun D A' B') PF f' Pf (wkT-ov D G X (Fun G A B) s X' PX (Fun D A' B') PF)) ;

  qF-ov (D G : Ctx) (A B : Ty G) (s : Sub D G) (A' B' : Ty D) (PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B'))
    (PW : Id (Ty (ext D (Fun D A' B')))
             (subT (ext D (Fun D A' B')) (ext G (Fun G A B)) (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B))
                   (upT D G (Fun G A B) s (Fun D A' B') PF))
             (Fun (ext D (Fun D A' B')) (wkT D (Fun D A' B') A') (wkT D (Fun D A' B') B')))
    : Ov (ext D (Fun D A' B')) (ext G (Fun G A B)) (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B))
         (upT D G (Fun G A B) s (Fun D A' B') PF)
         (Fun (ext D (Fun D A' B')) (wkT D (Fun D A' B') A') (wkT D (Fun D A' B') B')) PW (qF G A B) (qF D A' B') =
    ovTr (ext D (Fun D A' B')) (ext G (Fun G A B)) (wkT G (Fun G A B) (Fun G A B))
      (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B)) (wkFP G (Fun G A B) A B)
      (upT D G (Fun G A B) s (Fun D A' B') PF) (wkT D (Fun D A' B') (Fun D A' B'))
      (Fun (ext D (Fun D A' B')) (wkT D (Fun D A' B') A') (wkT D (Fun D A' B') B')) (wkFP D (Fun D A' B') A' B')
      (wkT-ov D G (Fun G A B) (Fun G A B) s (Fun D A' B') PF (Fun D A' B') PF) PW
      (q G (Fun G A B)) (q D (Fun D A' B'))
      (q-ov D G (Fun G A B) s (Fun D A' B') PF (wkT-ov D G (Fun G A B) (Fun G A B) s (Fun D A' B') PF (Fun D A' B') PF)) ;

  ----------------------------------------------------------------------
  -- contractibility

  -- over G.A.A[p]: Id(x , y) for the last two variables
  Id2 (G : Ctx) (A : Ty G) : Ty (ext (ext G A) (wkT G A A)) =
    IJ.IdT (ext (ext G A) (wkT G A A)) (wkT (ext G A) (wkT G A A) (wkT G A A))
      (wkE (ext G A) (wkT G A A) (wkT G A A) (q G A)) (q (ext G A) (wkT G A A)) ;

  isContr (G : Ctx) (A : Ty G) : Ty G =
    SS.Sig G A (PS.Pi (ext G A) (wkT G A A) (Id2 G A)) ;

  isContr-ov (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    : Id (Ty D) (subT D G (isContr G A) s) (isContr D A') =
    Sig-ov D G A (PS.Pi K Ap (Id2 G A)) s A' PA (PS.Pi K' Ap' (Id2 D A'))
      (Pi-ov K' K Ap (Id2 G A) s1 Ap' PAp (Id2 D A')
         (Id-ov (ext K' Ap') (ext K Ap) App (wkE K Ap Ap (q G A)) (q K Ap) s2 App' PApp
            (wkE K' Ap' Ap' (q D A')) (q K' Ap')
            (wkE-ov K' K Ap Ap (q G A) s1 Ap' PAp Ap' PAp (q D A') (q-ov D G A s A' PA PAp) PApp)
            (q-ov K' K Ap s1 Ap' PAp PApp)))
   where {
    K : Ctx = ext G A ;
    K' : Ctx = ext D A' ;
    Ap : Ty K = wkT G A A ;
    Ap' : Ty K' = wkT D A' A' ;
    App : Ty (ext K Ap) = wkT K Ap Ap ;
    App' : Ty (ext K' Ap') = wkT K' Ap' Ap' ;
    s1 : Sub K' K = upT D G A s A' PA ;
    PAp : Id (Ty K') (subT K' K Ap s1) Ap' = wkT-ov D G A A s A' PA A' PA ;
    s2 : Sub (ext K' Ap') (ext K Ap) = upT K' K Ap s1 Ap' PAp ;
    PApp : Id (Ty (ext K' Ap')) (subT (ext K' Ap') (ext K Ap) App s2) App' = wkT-ov K' K Ap Ap s1 Ap' PAp Ap' PAp ;
   } ;

  ----------------------------------------------------------------------
  -- homotopies u v ~ id

  Htpy (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (v : El G (Fun G Y X)) : Ty G =
    PS.Pi G Y
      (IJ.IdT (ext G Y) (wkT G Y Y)
         (app (ext G Y) (wkT G Y X) (wkT G Y Y) (wkF G Y X Y u)
            (app (ext G Y) (wkT G Y Y) (wkT G Y X) (wkF G Y Y X v) (q G Y)))
         (q G Y)) ;

  Htpy-ov (D G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (v : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PU : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y')) (u' : El D (Fun D X' Y')) (Pu : Ov D G (Fun G X Y) s (Fun D X' Y') PU u u')
    (PV : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (v' : El D (Fun D Y' X')) (Pv : Ov D G (Fun G Y X) s (Fun D Y' X') PV v v')
    : Id (Ty D) (subT D G (Htpy G X Y u v) s) (Htpy D X' Y' u' v') =
    Pi-ov D G Y (IJ.IdT K YY (app K XY YY uK vq) (q G Y)) s Y' PY (IJ.IdT K' YY' (app K' XY' YY' uK' vq') (q D Y'))
      (Id-ov K' K YY (app K XY YY uK vq) (q G Y) s1 YY' PYY (app K' XY' YY' uK' vq') (q D Y')
         (app-ov K' K XY YY s1 XY' PXY YY' PYY PFu uK uK'
            (wkF-ov D G Y X Y s Y' PY X' Y' PU u u' Pu PFu)
            vq vq'
            (app-ov K' K YY XY s1 YY' PYY XY' PXY PFv vK vK'
               (wkF-ov D G Y Y X s Y' PY Y' X' PV v v' Pv PFv)
               (q G Y) (q D Y') Pq))
         Pq)
   where {
    K : Ctx = ext G Y ;
    K' : Ctx = ext D Y' ;
    XY : Ty K = wkT G Y X ;
    YY : Ty K = wkT G Y Y ;
    XY' : Ty K' = wkT D Y' X' ;
    YY' : Ty K' = wkT D Y' Y' ;
    uK : El K (Fun K XY YY) = wkF G Y X Y u ;
    vK : El K (Fun K YY XY) = wkF G Y Y X v ;
    uK' : El K' (Fun K' XY' YY') = wkF D Y' X' Y' u' ;
    vK' : El K' (Fun K' YY' XY') = wkF D Y' Y' X' v' ;
    vq : El K XY = app K YY XY vK (q G Y) ;
    vq' : El K' XY' = app K' YY' XY' vK' (q D Y') ;
    s1 : Sub K' K = upT D G Y s Y' PY ;
    PXY : Id (Ty K') (subT K' K XY s1) XY' = wkT-ov D G Y X s Y' PY X' PX ;
    PYY : Id (Ty K') (subT K' K YY s1) YY' = wkT-ov D G Y Y s Y' PY Y' PY ;
    PFu : Id (Ty K') (subT K' K (Fun K XY YY) s1) (Fun K' XY' YY') = Fun-ov K' K XY YY s1 XY' PXY YY' PYY ;
    PFv : Id (Ty K') (subT K' K (Fun K YY XY) s1) (Fun K' YY' XY') = Fun-ov K' K YY XY s1 YY' PYY XY' PXY ;
    Pq : Ov K' K YY s1 YY' PYY (q G Y) (q D Y') = q-ov D G Y s Y' PY PYY ;
   } ;

  ----------------------------------------------------------------------
  -- retractions of u, sections, equivalences

  RetT (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) : Ty G =
    SS.Sig G (Fun G Y X)
      (Htpy (ext G (Fun G Y X)) (wkT G (Fun G Y X) Y) (wkT G (Fun G Y X) X) (qF G Y X) (wkF G (Fun G Y X) X Y u)) ;

  RetT-ov (D G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PU : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y')) (u' : El D (Fun D X' Y')) (Pu : Ov D G (Fun G X Y) s (Fun D X' Y') PU u u')
    : Id (Ty D) (subT D G (RetT G X Y u) s) (RetT D X' Y' u') =
    Sig-ov D G (Fun G Y X) (Htpy K Y1 X1 (qF G Y X) (wkF G (Fun G Y X) X Y u)) s (Fun D Y' X') PG
      (Htpy K' Y1' X1' (qF D Y' X') (wkF D (Fun D Y' X') X' Y' u'))
      (Htpy-ov K' K Y1 X1 (qF G Y X) (wkF G (Fun G Y X) X Y u) s1 Y1' PY1 X1' PX1
         PU1 (qF D Y' X') (qF-ov D G Y X s Y' X' PG PU1)
         PV1 (wkF D (Fun D Y' X') X' Y' u') (wkF-ov D G (Fun G Y X) X Y s (Fun D Y' X') PG X' Y' PU u u' Pu PV1))
   where {
    K : Ctx = ext G (Fun G Y X) ;
    K' : Ctx = ext D (Fun D Y' X') ;
    Y1 : Ty K = wkT G (Fun G Y X) Y ;
    X1 : Ty K = wkT G (Fun G Y X) X ;
    Y1' : Ty K' = wkT D (Fun D Y' X') Y' ;
    X1' : Ty K' = wkT D (Fun D Y' X') X' ;
    PG : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X') = Fun-ov D G Y X s Y' PY X' PX ;
    s1 : Sub K' K = upT D G (Fun G Y X) s (Fun D Y' X') PG ;
    PY1 : Id (Ty K') (subT K' K Y1 s1) Y1' = wkT-ov D G (Fun G Y X) Y s (Fun D Y' X') PG Y' PY ;
    PX1 : Id (Ty K') (subT K' K X1 s1) X1' = wkT-ov D G (Fun G Y X) X s (Fun D Y' X') PG X' PX ;
    PU1 : Id (Ty K') (subT K' K (Fun K Y1 X1) s1) (Fun K' Y1' X1') = Fun-ov K' K Y1 X1 s1 Y1' PY1 X1' PX1 ;
    PV1 : Id (Ty K') (subT K' K (Fun K X1 Y1) s1) (Fun K' X1' Y1') = Fun-ov K' K X1 Y1 s1 X1' PX1 Y1' PY1 ;
   } ;

  -- the section part's context G.(g : B -> A) and its homotopy f g ~ id
  SecH (G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) : Ty (ext G (Fun G B A)) =
    Htpy (ext G (Fun G B A)) (wkT G (Fun G B A) A) (wkT G (Fun G B A) B) (wkF G (Fun G B A) A B f) (qF G B A) ;

  isEquiv (G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) : Ty G =
    SS.Sig G (Fun G B A)
      (SS.Sig (ext G (Fun G B A)) (SecH G A B f)
         (RetT (ext (ext G (Fun G B A)) (SecH G A B f))
            (wkT (ext G (Fun G B A)) (SecH G A B f) (wkT G (Fun G B A) A))
            (wkT (ext G (Fun G B A)) (SecH G A B f) (wkT G (Fun G B A) B))
            (wkF (ext G (Fun G B A)) (SecH G A B f) (wkT G (Fun G B A) A) (wkT G (Fun G B A) B) (wkF G (Fun G B A) A B f)))) ;

  isEquiv-ov (D G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) (s : Sub D G)
    (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    (PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B')) (f' : El D (Fun D A' B')) (Pf : Ov D G (Fun G A B) s (Fun D A' B') PF f f')
    : Id (Ty D) (subT D G (isEquiv G A B f) s) (isEquiv D A' B' f') =
    Sig-ov D G (Fun G B A) (SS.Sig K1 H1 (RetT K2 A2 B2 f2)) s (Fun D B' A') PG (SS.Sig K1' H1' (RetT K2' A2' B2' f2'))
      (Sig-ov K1' K1 H1 (RetT K2 A2 B2 f2) s1 H1' PH (RetT K2' A2' B2' f2')
         (RetT-ov K2' K2 A2 B2 f2 s2 A2' PA2 B2' PB2 PF2 f2'
            (wkF-ov K1' K1 H1 A1 B1 s1 H1' PH A1' B1' PF1 f1 f1' Pf1 PF2)))
   where {
    K1 : Ctx = ext G (Fun G B A) ;
    K1' : Ctx = ext D (Fun D B' A') ;
    A1 : Ty K1 = wkT G (Fun G B A) A ;
    B1 : Ty K1 = wkT G (Fun G B A) B ;
    A1' : Ty K1' = wkT D (Fun D B' A') A' ;
    B1' : Ty K1' = wkT D (Fun D B' A') B' ;
    f1 : El K1 (Fun K1 A1 B1) = wkF G (Fun G B A) A B f ;
    f1' : El K1' (Fun K1' A1' B1') = wkF D (Fun D B' A') A' B' f' ;
    H1 : Ty K1 = SecH G A B f ;
    H1' : Ty K1' = SecH D A' B' f' ;
    K2 : Ctx = ext K1 H1 ;
    K2' : Ctx = ext K1' H1' ;
    A2 : Ty K2 = wkT K1 H1 A1 ;
    B2 : Ty K2 = wkT K1 H1 B1 ;
    A2' : Ty K2' = wkT K1' H1' A1' ;
    B2' : Ty K2' = wkT K1' H1' B1' ;
    f2 : El K2 (Fun K2 A2 B2) = wkF K1 H1 A1 B1 f1 ;
    f2' : El K2' (Fun K2' A2' B2') = wkF K1' H1' A1' B1' f1' ;
    PG : Id (Ty D) (subT D G (Fun G B A) s) (Fun D B' A') = Fun-ov D G B A s B' PB A' PA ;
    s1 : Sub K1' K1 = upT D G (Fun G B A) s (Fun D B' A') PG ;
    PA1 : Id (Ty K1') (subT K1' K1 A1 s1) A1' = wkT-ov D G (Fun G B A) A s (Fun D B' A') PG A' PA ;
    PB1 : Id (Ty K1') (subT K1' K1 B1 s1) B1' = wkT-ov D G (Fun G B A) B s (Fun D B' A') PG B' PB ;
    PF1 : Id (Ty K1') (subT K1' K1 (Fun K1 A1 B1) s1) (Fun K1' A1' B1') = Fun-ov K1' K1 A1 B1 s1 A1' PA1 B1' PB1 ;
    PG1 : Id (Ty K1') (subT K1' K1 (Fun K1 B1 A1) s1) (Fun K1' B1' A1') = Fun-ov K1' K1 B1 A1 s1 B1' PB1 A1' PA1 ;
    Pf1 : Ov K1' K1 (Fun K1 A1 B1) s1 (Fun K1' A1' B1') PF1 f1 f1' =
      wkF-ov D G (Fun G B A) A B s (Fun D B' A') PG A' B' PF f f' Pf PF1 ;
    PH : Id (Ty K1') (subT K1' K1 H1 s1) H1' =
      Htpy-ov K1' K1 A1 B1 f1 (qF G B A) s1 A1' PA1 B1' PB1 PF1 f1' Pf1 PG1 (qF D B' A') (qF-ov D G B A s B' A' PG PG1) ;
    s2 : Sub K2' K2 = upT K1' K1 H1 s1 H1' PH ;
    PA2 : Id (Ty K2') (subT K2' K2 A2 s2) A2' = wkT-ov K1' K1 H1 A1 s1 H1' PH A1' PA1 ;
    PB2 : Id (Ty K2') (subT K2' K2 B2 s2) B2' = wkT-ov K1' K1 H1 B1 s1 H1' PH B1' PB1 ;
    PF2 : Id (Ty K2') (subT K2' K2 (Fun K2 A2 B2) s2) (Fun K2' A2' B2') = Fun-ov K2' K2 A2 B2 s2 A2' PA2 B2' PB2 ;
   } ;

  Equiv (G : Ctx) (A B : Ty G) : Ty G =
    SS.Sig G (Fun G A B) (isEquiv (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B) (qF G A B)) ;

  Equiv-ov (D G : Ctx) (A B : Ty G) (s : Sub D G)
    (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    : Id (Ty D) (subT D G (Equiv G A B) s) (Equiv D A' B') =
    Sig-ov D G (Fun G A B) (isEquiv K A1 B1 (qF G A B)) s (Fun D A' B') PF (isEquiv K' A1' B1' (qF D A' B'))
      (isEquiv-ov K' K A1 B1 (qF G A B) s1 A1' PA1 B1' PB1 PF1 (qF D A' B') (qF-ov D G A B s A' B' PF PF1))
   where {
    K : Ctx = ext G (Fun G A B) ;
    K' : Ctx = ext D (Fun D A' B') ;
    A1 : Ty K = wkT G (Fun G A B) A ;
    B1 : Ty K = wkT G (Fun G A B) B ;
    A1' : Ty K' = wkT D (Fun D A' B') A' ;
    B1' : Ty K' = wkT D (Fun D A' B') B' ;
    PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B') = Fun-ov D G A B s A' PA B' PB ;
    s1 : Sub K' K = upT D G (Fun G A B) s (Fun D A' B') PF ;
    PA1 : Id (Ty K') (subT K' K A1 s1) A1' = wkT-ov D G (Fun G A B) A s (Fun D A' B') PF A' PA ;
    PB1 : Id (Ty K') (subT K' K B1 s1) B1' = wkT-ov D G (Fun G A B) B s (Fun D A' B') PF B' PB ;
    PF1 : Id (Ty K') (subT K' K (Fun K A1 B1) s1) (Fun K' A1' B1') = Fun-ov K' K A1 B1 s1 A1' PA1 B1' PB1 ;
   } ;
} ;
