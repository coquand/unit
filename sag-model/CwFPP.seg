-- CwFPP.seg (M1 step 3, S4 toolkit): the universal pair path, in a CwF
-- with Pi, Sigma and Swan Id.
--
-- For B over G.A, E2 = G.A.B (variables a , w) and the context of J based
-- at a, Om = E2.(b : A).Id(a , b).  Over Om:
--   rSt  : Om -> E2   the point (a , w)        (the projection)
--   rEnd : Om -> E2   the point (b , tr u w)   (lift of lift, after (p , JT))
-- and the pair of the variables pv of E2 (CwFSig) at both.
--
-- Informal text.
-- (1) extS-o: (s , a) after r is (s r , a[r]).
-- (2) Both points lie over the same point of G (pp rEnd = pp rSt), so
--     pv at both is in one type SO.
-- (3) At the centre of J both points are the identity of E2: for rSt by
--     p-extS, p-sec; for rEnd by ext-eq (p part: p-lift twice and
--     sub-eta, q part: q-ov along the lift, q-extS, J-beta of the
--     transport JT).  So J with motive Id(pv[rEnd] , pv[rSt]) starts at
--     refl pv.
-- (4) At a point (b , u) of Om over E2 (CwFTr.ptY): rSt is the identity
--     and rEnd is (b , trP u w): ppAt : Id(pv at (b , trP u w) , pv).

open Base ;

module PPth (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- (1) extS after a substitution

  ----------------------------------------------------------------------
  -- (2)-(4) the pair path

  module UP (G : Ctx) (A : Ty G) (B : Ty (ext G A)) {
    module VS = SV.At[G, A, B] ;
    IKz : Ty VS.E3 = JP.IK VS.E2 VS.App VS.zA ;
    Om : Ctx = ext VS.E3 IKz ;
    pO : Sub Om VS.E3 = p VS.E3 IKz ;
    JTw : El Om (subT Om VS.E3 VS.Bl pO) = TR.JT VS.E2 VS.App VS.zA VS.Bl VS.bB ;
    LL : Sub (ext VS.E3 VS.Bl) VS.E2 = lift VS.E3 VS.K B (lift VS.E2 G A VS.pp) ;
    rEnd : Sub Om VS.E2 = o Om (ext VS.E3 VS.Bl) VS.E2 LL (extS Om VS.E3 VS.Bl pO JTw) ;
    rSt : Sub Om VS.E2 = o Om VS.E3 VS.E2 (p VS.E2 VS.App) pO ;
    ppO : Sub Om G = o Om VS.E2 G VS.pp rSt ;

    -- pp after LL, after any map X into E3.Bl
    ppLL (D : Ctx) (X : Sub D (ext VS.E3 VS.Bl))
      : Id (Sub D G) (o D VS.E2 G VS.pp (o D (ext VS.E3 VS.Bl) VS.E2 LL X))
           (o D VS.E2 G VS.pp (o D VS.E3 VS.E2 (p VS.E2 VS.App) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X))) =
      calc (Sub D G) {
          o D VS.E2 G (o VS.E2 VS.K G (p G A) VS.p2) (o D (ext VS.E3 VS.Bl) VS.E2 LL X)
        =< o-assoc D VS.E2 VS.K G (p G A) VS.p2 (o D (ext VS.E3 VS.Bl) VS.E2 LL X) >
          o D VS.K G (p G A) (o D VS.E2 VS.K VS.p2 (o D (ext VS.E3 VS.Bl) VS.E2 LL X))
        =< ap (Sub D VS.K) (Sub D G) (\ t -> o D VS.K G (p G A) t) (o D VS.E2 VS.K VS.p2 (o D (ext VS.E3 VS.Bl) VS.E2 LL X))
              (o D VS.E3 VS.K (lift VS.E2 G A VS.pp) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X))
              (calc (Sub D VS.K) {
                  o D VS.E2 VS.K VS.p2 (o D (ext VS.E3 VS.Bl) VS.E2 LL X)
                =< sym (Sub D VS.K) (o D (ext VS.E3 VS.Bl) VS.K (o (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL) X) (o D VS.E2 VS.K VS.p2 (o D (ext VS.E3 VS.Bl) VS.E2 LL X))
                      (o-assoc D (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL X) >
                  o D (ext VS.E3 VS.Bl) VS.K (o (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL) X
                =< ap (Sub (ext VS.E3 VS.Bl) VS.K) (Sub D VS.K) (\ t -> o D (ext VS.E3 VS.Bl) VS.K t X) (o (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL)
                      (o (ext VS.E3 VS.Bl) VS.E3 VS.K (lift VS.E2 G A VS.pp) (p VS.E3 VS.Bl)) (p-lift VS.E3 VS.K B (lift VS.E2 G A VS.pp)) >
                  o D (ext VS.E3 VS.Bl) VS.K (o (ext VS.E3 VS.Bl) VS.E3 VS.K (lift VS.E2 G A VS.pp) (p VS.E3 VS.Bl)) X
                =< o-assoc D (ext VS.E3 VS.Bl) VS.E3 VS.K (lift VS.E2 G A VS.pp) (p VS.E3 VS.Bl) X >
                  o D VS.E3 VS.K (lift VS.E2 G A VS.pp) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X) }) >
          o D VS.K G (p G A) (o D VS.E3 VS.K (lift VS.E2 G A VS.pp) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X))
        =< sym (Sub D G) (o D VS.E3 G (o VS.E3 VS.K G (p G A) (lift VS.E2 G A VS.pp)) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X))
              (o D VS.K G (p G A) (o D VS.E3 VS.K (lift VS.E2 G A VS.pp) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X)))
              (o-assoc D VS.E3 VS.K G (p G A) (lift VS.E2 G A VS.pp) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X)) >
          o D VS.E3 G (o VS.E3 VS.K G (p G A) (lift VS.E2 G A VS.pp)) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X)
        =< ap (Sub VS.E3 G) (Sub D G) (\ t -> o D VS.E3 G t (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X))
              (o VS.E3 VS.K G (p G A) (lift VS.E2 G A VS.pp)) (o VS.E3 VS.E2 G VS.pp (p VS.E2 VS.App)) (p-lift VS.E2 G A VS.pp) >
          o D VS.E3 G (o VS.E3 VS.E2 G VS.pp (p VS.E2 VS.App)) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X)
        =< o-assoc D VS.E3 VS.E2 G VS.pp (p VS.E2 VS.App) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X) >
          o D VS.E2 G VS.pp (o D VS.E3 VS.E2 (p VS.E2 VS.App) (o D (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) X)) } ;

    eEnd : Id (Sub Om G) (o Om VS.E2 G VS.pp rEnd) ppO =
      trans (Sub Om G) (o Om VS.E2 G VS.pp rEnd)
        (o Om VS.E2 G VS.pp (o Om VS.E3 VS.E2 (p VS.E2 VS.App) (o Om (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) (extS Om VS.E3 VS.Bl pO JTw)))) ppO
        (ppLL Om (extS Om VS.E3 VS.Bl pO JTw))
        (ap (Sub Om VS.E3) (Sub Om G) (\ t -> o Om VS.E2 G VS.pp (o Om VS.E3 VS.E2 (p VS.E2 VS.App) t))
            (o Om (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) (extS Om VS.E3 VS.Bl pO JTw)) pO (IN.p-extS Om VS.E3 VS.Bl pO JTw)) ;

    SO : Ty Om = subT Om G VS.S ppO ;
    PEnd : Id (Ty Om) (subT Om VS.E2 VS.SW rEnd) SO =
      trans (Ty Om) (subT Om VS.E2 VS.SW rEnd) (subT Om G VS.S (o Om VS.E2 G VS.pp rEnd)) SO
        (sym (Ty Om) (subT Om G VS.S (o Om VS.E2 G VS.pp rEnd)) (subT Om VS.E2 VS.SW rEnd) (subT-o Om VS.E2 G VS.S VS.pp rEnd))
        (ap (Sub Om G) (Ty Om) (\ t -> subT Om G VS.S t) (o Om VS.E2 G VS.pp rEnd) ppO eEnd) ;
    PSt : Id (Ty Om) (subT Om VS.E2 VS.SW rSt) SO = sym (Ty Om) SO (subT Om VS.E2 VS.SW rSt) (subT-o Om VS.E2 G VS.S VS.pp rSt) ;

    Rend : El Om SO = trE Om (subT Om VS.E2 VS.SW rEnd) SO PEnd (subt Om VS.E2 VS.SW VS.pv rEnd) ;
    Rst : El Om SO = trE Om (subT Om VS.E2 VS.SW rSt) SO PSt (subt Om VS.E2 VS.SW VS.pv rSt) ;
    CM : Ty Om = IJ.IdT Om SO Rend Rst ;

    -- an element pv along a map equal to the identity is pv
    pvId (r : Sub Om VS.E2) (PR : Id (Ty Om) (subT Om VS.E2 VS.SW r) SO) (s : Sub VS.E2 Om) (e : Id (Sub VS.E2 VS.E2) (o VS.E2 Om VS.E2 r s) (id VS.E2))
      (PT : Id (Ty VS.E2) (subT VS.E2 Om SO s) VS.SW)
      : Ov VS.E2 Om SO s VS.SW PT (trE Om (subT Om VS.E2 VS.SW r) SO PR (subt Om VS.E2 VS.SW VS.pv r)) VS.pv =
      IN.teAny VS.E2 (subT VS.E2 Om SO s) VS.SW (subt VS.E2 Om SO (trE Om (subT Om VS.E2 VS.SW r) SO PR (subt Om VS.E2 VS.SW VS.pv r)) s) VS.pv
        (IN.teT VS.E2 (subT VS.E2 Om SO s) (subT VS.E2 Om (subT Om VS.E2 VS.SW r) s) VS.SW
           (subt VS.E2 Om SO (trE Om (subT Om VS.E2 VS.SW r) SO PR (subt Om VS.E2 VS.SW VS.pv r)) s)
           (subt VS.E2 Om (subT Om VS.E2 VS.SW r) (subt Om VS.E2 VS.SW VS.pv r) s) VS.pv
           (IN.teS VS.E2 (subT VS.E2 Om (subT Om VS.E2 VS.SW r) s) (subT VS.E2 Om SO s)
              (subt VS.E2 Om (subT Om VS.E2 VS.SW r) (subt Om VS.E2 VS.SW VS.pv r) s)
              (subt VS.E2 Om SO (trE Om (subT Om VS.E2 VS.SW r) SO PR (subt Om VS.E2 VS.SW VS.pv r)) s)
              (IN.teSubtTr VS.E2 Om (subT Om VS.E2 VS.SW r) SO PR (subt Om VS.E2 VS.SW VS.pv r) s))
           (IN.teT VS.E2 (subT VS.E2 Om (subT Om VS.E2 VS.SW r) s) (subT VS.E2 VS.E2 VS.SW (o VS.E2 Om VS.E2 r s)) VS.SW
              (subt VS.E2 Om (subT Om VS.E2 VS.SW r) (subt Om VS.E2 VS.SW VS.pv r) s) (subt VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 r s)) VS.pv
              (IN.teS VS.E2 (subT VS.E2 VS.E2 VS.SW (o VS.E2 Om VS.E2 r s)) (subT VS.E2 Om (subT Om VS.E2 VS.SW r) s)
                 (subt VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 r s)) (subt VS.E2 Om (subT Om VS.E2 VS.SW r) (subt Om VS.E2 VS.SW VS.pv r) s)
                 (IN.teSubtO VS.E2 Om VS.E2 VS.SW VS.pv r s))
              (IN.teT VS.E2 (subT VS.E2 VS.E2 VS.SW (o VS.E2 Om VS.E2 r s)) (subT VS.E2 VS.E2 VS.SW (id VS.E2)) VS.SW
                 (subt VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 r s)) (subt VS.E2 VS.E2 VS.SW VS.pv (id VS.E2)) VS.pv
                 (IN.teSubEq VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 r s) (id VS.E2) e)
                 (subT-id VS.E2 VS.SW, subt-id VS.E2 VS.SW VS.pv))))
        PT ;

    ------------------------------------------------------------------
    -- (3) at the centre

    cO : Sub VS.E2 Om = DJ.cen VS.E2 VS.App VS.zA ;

    pOc : Id (Sub VS.E2 VS.E3) (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) =
      IN.p-extS VS.E2 VS.E3 IKz (sec VS.E2 VS.App VS.zA) (DJ.reflE VS.E2 VS.App VS.zA) ;

    eS : Id (Sub VS.E2 VS.E2) (o VS.E2 Om VS.E2 rSt cO) (id VS.E2) =
      calc (Sub VS.E2 VS.E2) {
          o VS.E2 Om VS.E2 (o Om VS.E3 VS.E2 (p VS.E2 VS.App) pO) cO
        =< o-assoc VS.E2 Om VS.E3 VS.E2 (p VS.E2 VS.App) pO cO >
          o VS.E2 VS.E3 VS.E2 (p VS.E2 VS.App) (o VS.E2 Om VS.E3 pO cO)
        =< ap (Sub VS.E2 VS.E3) (Sub VS.E2 VS.E2) (\ t -> o VS.E2 VS.E3 VS.E2 (p VS.E2 VS.App) t) (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) pOc >
          o VS.E2 VS.E3 VS.E2 (p VS.E2 VS.App) (sec VS.E2 VS.App VS.zA)
        =< p-sec VS.E2 VS.App VS.zA >
          id VS.E2 } ;

    -- JT at the centre, read in Bz, is bB
    JTc : El VS.E2 VS.Bz =
      trE VS.E2 (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) VS.Bz
        (ap (Sub VS.E2 VS.E3) (Ty VS.E2) (\ t -> subT VS.E2 VS.E3 VS.Bl t) (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) pOc)
        (trE VS.E2 (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO))
           (sym (Ty VS.E2) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT-o VS.E2 Om VS.E3 VS.Bl pO cO))
           (subt VS.E2 Om (subT Om VS.E3 VS.Bl pO) JTw cO)) ;

    JTc-b : Id (El VS.E2 VS.Bz) JTc VS.bB =
      trans (El VS.E2 VS.Bz) JTc
        (trE VS.E2 (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) VS.Bz
           (trans (Ty VS.E2) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) VS.Bz
              (sym (Ty VS.E2) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT-o VS.E2 Om VS.E3 VS.Bl pO cO))
              (ap (Sub VS.E2 VS.E3) (Ty VS.E2) (\ t -> subT VS.E2 VS.E3 VS.Bl t) (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) pOc))
           (subt VS.E2 Om (subT Om VS.E3 VS.Bl pO) JTw cO))
        VS.bB
        (trE-tr VS.E2 (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) VS.Bz
           (sym (Ty VS.E2) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT-o VS.E2 Om VS.E3 VS.Bl pO cO))
           (ap (Sub VS.E2 VS.E3) (Ty VS.E2) (\ t -> subT VS.E2 VS.E3 VS.Bl t) (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) pOc)
           (subt VS.E2 Om (subT Om VS.E3 VS.Bl pO) JTw cO))
      (IN.teAny VS.E2 (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) VS.Bz (subt VS.E2 Om (subT Om VS.E3 VS.Bl pO) JTw cO) VS.bB
        (IN.teOv VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO VS.Bz (TR.PCen VS.E2 VS.App VS.zA VS.Bl) JTw VS.bB
           (TR.JT-beta VS.E2 VS.App VS.zA VS.Bl VS.bB))
        (trans (Ty VS.E2) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) VS.Bz
           (sym (Ty VS.E2) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT-o VS.E2 Om VS.E3 VS.Bl pO cO))
           (ap (Sub VS.E2 VS.E3) (Ty VS.E2) (\ t -> subT VS.E2 VS.E3 VS.Bl t) (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) pOc))) ;

    XC : Sub VS.E2 (ext VS.E3 VS.Bl) = extS VS.E2 VS.E3 VS.Bl (sec VS.E2 VS.App VS.zA) JTc ;

    -- (p , JT) after the centre is XC
    eX : Id (Sub VS.E2 (ext VS.E3 VS.Bl)) (o VS.E2 Om (ext VS.E3 VS.Bl) (extS Om VS.E3 VS.Bl pO JTw) cO) XC =
      trans (Sub VS.E2 (ext VS.E3 VS.Bl)) (o VS.E2 Om (ext VS.E3 VS.Bl) (extS Om VS.E3 VS.Bl pO JTw) cO)
        (extS VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)
           (trE VS.E2 (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO))
              (sym (Ty VS.E2) (subT VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO)) (subT VS.E2 Om (subT Om VS.E3 VS.Bl pO) cO) (subT-o VS.E2 Om VS.E3 VS.Bl pO cO))
              (subt VS.E2 Om (subT Om VS.E3 VS.Bl pO) JTw cO)))
        XC
        (SV.extS-o VS.E2 Om VS.E3 VS.Bl pO JTw cO)
        (IN.extS-cong VS.E2 VS.E3 VS.Bl (o VS.E2 Om VS.E3 pO cO) (sec VS.E2 VS.App VS.zA) pOc _ JTc (refl JTc)) ;

    -- LL after XC is the identity
    eLX : Id (Sub VS.E2 VS.E2) (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC) (id VS.E2) =
      IN.ext-eq VS.E2 VS.K B (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC) (id VS.E2)
        (calc (Sub VS.E2 VS.K) {
            o VS.E2 VS.E2 VS.K VS.p2 (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC)
          =< sym (Sub VS.E2 VS.K) (o VS.E2 (ext VS.E3 VS.Bl) VS.K (o (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL) XC)
                (o VS.E2 VS.E2 VS.K VS.p2 (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC)) (o-assoc VS.E2 (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL XC) >
            o VS.E2 (ext VS.E3 VS.Bl) VS.K (o (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL) XC
          =< ap (Sub (ext VS.E3 VS.Bl) VS.K) (Sub VS.E2 VS.K) (\ t -> o VS.E2 (ext VS.E3 VS.Bl) VS.K t XC) (o (ext VS.E3 VS.Bl) VS.E2 VS.K VS.p2 LL)
                (o (ext VS.E3 VS.Bl) VS.E3 VS.K (lift VS.E2 G A VS.pp) (p VS.E3 VS.Bl)) (p-lift VS.E3 VS.K B (lift VS.E2 G A VS.pp)) >
            o VS.E2 (ext VS.E3 VS.Bl) VS.K (o (ext VS.E3 VS.Bl) VS.E3 VS.K (lift VS.E2 G A VS.pp) (p VS.E3 VS.Bl)) XC
          =< o-assoc VS.E2 (ext VS.E3 VS.Bl) VS.E3 VS.K (lift VS.E2 G A VS.pp) (p VS.E3 VS.Bl) XC >
            o VS.E2 VS.E3 VS.K (lift VS.E2 G A VS.pp) (o VS.E2 (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) XC)
          =< ap (Sub VS.E2 VS.E3) (Sub VS.E2 VS.K) (\ t -> o VS.E2 VS.E3 VS.K (lift VS.E2 G A VS.pp) t)
                (o VS.E2 (ext VS.E3 VS.Bl) VS.E3 (p VS.E3 VS.Bl) XC) (sec VS.E2 VS.App VS.zA) (IN.p-extS VS.E2 VS.E3 VS.Bl (sec VS.E2 VS.App VS.zA) JTc) >
            extS VS.E2 G A VS.pp VS.zA
          =< sym (Sub VS.E2 VS.K) VS.p2 (extS VS.E2 G A VS.pp VS.zA) VS.eta2 >
            VS.p2
          =< sym (Sub VS.E2 VS.K) (o VS.E2 VS.E2 VS.K VS.p2 (id VS.E2)) VS.p2 (o-idr VS.E2 VS.K VS.p2) >
            o VS.E2 VS.E2 VS.K VS.p2 (id VS.E2) })
        (wkT VS.K B B) (q VS.K B)
        P3
        (SV.ovThen VS.E2 VS.E2 (wkT VS.K B B) (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC) VS.Bz (wkT VS.K B B) P0 (sym (Ty VS.E2) (wkT VS.K B B) VS.Bz VS.bP)
           (q VS.K B) JTc (q VS.K B)
           (JP.ovO VS.E2 (ext VS.E3 VS.Bl) VS.E2 (wkT VS.K B B) LL XC (wkT VS.E3 VS.Bl VS.Bl) PL VS.Bz PX P0 (q VS.K B) (q VS.E3 VS.Bl) JTc
              (q-ov VS.E3 VS.K B (lift VS.E2 G A VS.pp) VS.Bl (refl VS.Bl) PL)
              (JP.q-extS VS.E2 VS.E3 VS.Bl (sec VS.E2 VS.App VS.zA) JTc PX))
           (trans (El VS.E2 (wkT VS.K B B)) (trE VS.E2 VS.Bz (wkT VS.K B B) (sym (Ty VS.E2) (wkT VS.K B B) VS.Bz VS.bP) JTc)
              (trE VS.E2 VS.Bz (wkT VS.K B B) (sym (Ty VS.E2) (wkT VS.K B B) VS.Bz VS.bP) VS.bB) (q VS.K B)
              (ap (El VS.E2 VS.Bz) (El VS.E2 (wkT VS.K B B)) (\ v -> trE VS.E2 VS.Bz (wkT VS.K B B) (sym (Ty VS.E2) (wkT VS.K B B) VS.Bz VS.bP) v) JTc VS.bB JTc-b)
              (IN.trE-symL VS.E2 (wkT VS.K B B) VS.Bz VS.bP (q VS.K B))))
        (subT-id VS.E2 (wkT VS.K B B)) (subt-id VS.E2 (wkT VS.K B B) (q VS.K B))
     where {
      PL : Id (Ty (ext VS.E3 VS.Bl)) (subT (ext VS.E3 VS.Bl) (ext VS.K B) (wkT VS.K B B) LL) (wkT VS.E3 VS.Bl VS.Bl) =
        p-lift-T VS.E3 VS.K B B (lift VS.E2 G A VS.pp) ;
      PX : Id (Ty VS.E2) (subT VS.E2 (ext VS.E3 VS.Bl) (wkT VS.E3 VS.Bl VS.Bl) XC) VS.Bz =
        IN.wkT-extS VS.E2 VS.E3 VS.Bl VS.Bl (sec VS.E2 VS.App VS.zA) JTc ;
      P0 : Id (Ty VS.E2) (subT VS.E2 VS.E2 (wkT VS.K B B) (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC)) VS.Bz =
        trans (Ty VS.E2) (subT VS.E2 VS.E2 (wkT VS.K B B) (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC))
          (subT VS.E2 (ext VS.E3 VS.Bl) (subT (ext VS.E3 VS.Bl) (ext VS.K B) (wkT VS.K B B) LL) XC) VS.Bz
          (subT-o VS.E2 (ext VS.E3 VS.Bl) (ext VS.K B) (wkT VS.K B B) LL XC)
          (trans (Ty VS.E2) (subT VS.E2 (ext VS.E3 VS.Bl) (subT (ext VS.E3 VS.Bl) (ext VS.K B) (wkT VS.K B B) LL) XC)
             (subT VS.E2 (ext VS.E3 VS.Bl) (wkT VS.E3 VS.Bl VS.Bl) XC) VS.Bz
             (ap (Ty (ext VS.E3 VS.Bl)) (Ty VS.E2) (\ X -> subT VS.E2 (ext VS.E3 VS.Bl) X XC)
                 (subT (ext VS.E3 VS.Bl) (ext VS.K B) (wkT VS.K B B) LL) (wkT VS.E3 VS.Bl VS.Bl) PL)
             PX) ;
      P3 : Id (Ty VS.E2) (subT VS.E2 VS.E2 (wkT VS.K B B) (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC)) (wkT VS.K B B) =
        trans (Ty VS.E2) (subT VS.E2 VS.E2 (wkT VS.K B B) (o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC)) VS.Bz (wkT VS.K B B) P0 (sym (Ty VS.E2) (wkT VS.K B B) VS.Bz VS.bP) ;
     } ;

    eE : Id (Sub VS.E2 VS.E2) (o VS.E2 Om VS.E2 rEnd cO) (id VS.E2) =
      calc (Sub VS.E2 VS.E2) {
          o VS.E2 Om VS.E2 (o Om (ext VS.E3 VS.Bl) VS.E2 LL (extS Om VS.E3 VS.Bl pO JTw)) cO
        =< o-assoc VS.E2 Om (ext VS.E3 VS.Bl) VS.E2 LL (extS Om VS.E3 VS.Bl pO JTw) cO >
          o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL (o VS.E2 Om (ext VS.E3 VS.Bl) (extS Om VS.E3 VS.Bl pO JTw) cO)
        =< ap (Sub VS.E2 (ext VS.E3 VS.Bl)) (Sub VS.E2 VS.E2) (\ t -> o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL t)
              (o VS.E2 Om (ext VS.E3 VS.Bl) (extS Om VS.E3 VS.Bl pO JTw) cO) XC eX >
          o VS.E2 (ext VS.E3 VS.Bl) VS.E2 LL XC
        =< eLX >
          id VS.E2 } ;

    PCO : Id (Ty VS.E2) (subT VS.E2 Om SO cO) VS.SW =
      trans (Ty VS.E2) (subT VS.E2 Om SO cO) (subT VS.E2 G VS.S (o VS.E2 Om G ppO cO)) VS.SW
        (sym (Ty VS.E2) (subT VS.E2 G VS.S (o VS.E2 Om G ppO cO)) (subT VS.E2 Om SO cO) (subT-o VS.E2 Om G VS.S ppO cO))
        (trans (Ty VS.E2) (subT VS.E2 G VS.S (o VS.E2 Om G ppO cO)) (subT VS.E2 G VS.S VS.pp) VS.SW
           (ap (Sub VS.E2 G) (Ty VS.E2) (\ t -> subT VS.E2 G VS.S t) (o VS.E2 Om G ppO cO) VS.pp
               (calc (Sub VS.E2 G) {
                   o VS.E2 Om G (o Om VS.E2 G VS.pp rSt) cO
                 =< o-assoc VS.E2 Om VS.E2 G VS.pp rSt cO >
                   o VS.E2 VS.E2 G VS.pp (o VS.E2 Om VS.E2 rSt cO)
                 =< ap (Sub VS.E2 VS.E2) (Sub VS.E2 G) (\ t -> o VS.E2 VS.E2 G VS.pp t) (o VS.E2 Om VS.E2 rSt cO) (id VS.E2) eS >
                   o VS.E2 VS.E2 G VS.pp (id VS.E2)
                 =< o-idr VS.E2 G VS.pp >
                   VS.pp }))
           (refl VS.SW)) ;

    Pcen : Id (Ty VS.E2) (subT VS.E2 Om CM cO) (IJ.IdT VS.E2 VS.SW VS.pv VS.pv) =
      Id-ov VS.E2 Om SO Rend Rst cO VS.SW PCO VS.pv VS.pv
        (pvId rEnd PEnd cO eE PCO) (pvId rSt PSt cO eS PCO) ;

    JE : El Om CM =
      IJ.J VS.E2 VS.App VS.zA CM
        (trE VS.E2 (IJ.IdT VS.E2 VS.SW VS.pv VS.pv) (subT VS.E2 Om CM cO) (sym (Ty VS.E2) (subT VS.E2 Om CM cO) (IJ.IdT VS.E2 VS.SW VS.pv VS.pv) Pcen)
           (IJ.rfl VS.E2 VS.SW VS.pv)) ;

    ------------------------------------------------------------------
    -- (4) at a point (b , u)

    ptO (b : El VS.E2 VS.App) (u : El VS.E2 (IJ.IdT VS.E2 VS.App VS.zA b)) : Sub VS.E2 Om = TR.ptY VS.E2 VS.App VS.zA b u ;

    ePt (b : El VS.E2 VS.App) (u : El VS.E2 (IJ.IdT VS.E2 VS.App VS.zA b)) : Id (Sub VS.E2 VS.E2) (o VS.E2 Om VS.E2 rSt (ptO b u)) (id VS.E2) =
      calc (Sub VS.E2 VS.E2) {
          o VS.E2 Om VS.E2 (o Om VS.E3 VS.E2 (p VS.E2 VS.App) pO) (ptO b u)
        =< o-assoc VS.E2 Om VS.E3 VS.E2 (p VS.E2 VS.App) pO (ptO b u) >
          o VS.E2 VS.E3 VS.E2 (p VS.E2 VS.App) (o VS.E2 Om VS.E3 pO (ptO b u))
        =< ap (Sub VS.E2 VS.E3) (Sub VS.E2 VS.E2) (\ t -> o VS.E2 VS.E3 VS.E2 (p VS.E2 VS.App) t) (o VS.E2 Om VS.E3 pO (ptO b u)) (sec VS.E2 VS.App b)
              (JP.p-inst VS.E2 VS.App IKz b (IJ.IdT VS.E2 VS.App VS.zA b) (JP.IKpt VS.E2 VS.App VS.zA b) u) >
          o VS.E2 VS.E3 VS.E2 (p VS.E2 VS.App) (sec VS.E2 VS.App b)
        =< p-sec VS.E2 VS.App b >
          id VS.E2 } ;

    PSO (b : El VS.E2 VS.App) (u : El VS.E2 (IJ.IdT VS.E2 VS.App VS.zA b)) : Id (Ty VS.E2) (subT VS.E2 Om SO (ptO b u)) VS.SW =
      trans (Ty VS.E2) (subT VS.E2 Om SO (ptO b u)) (subT VS.E2 G VS.S (o VS.E2 Om G ppO (ptO b u))) VS.SW
        (sym (Ty VS.E2) (subT VS.E2 G VS.S (o VS.E2 Om G ppO (ptO b u))) (subT VS.E2 Om SO (ptO b u)) (subT-o VS.E2 Om G VS.S ppO (ptO b u)))
        (ap (Sub VS.E2 G) (Ty VS.E2) (\ t -> subT VS.E2 G VS.S t) (o VS.E2 Om G ppO (ptO b u)) VS.pp
            (calc (Sub VS.E2 G) {
                o VS.E2 Om G (o Om VS.E2 G VS.pp rSt) (ptO b u)
              =< o-assoc VS.E2 Om VS.E2 G VS.pp rSt (ptO b u) >
                o VS.E2 VS.E2 G VS.pp (o VS.E2 Om VS.E2 rSt (ptO b u))
              =< ap (Sub VS.E2 VS.E2) (Sub VS.E2 G) (\ t -> o VS.E2 VS.E2 G VS.pp t) (o VS.E2 Om VS.E2 rSt (ptO b u)) (id VS.E2) (ePt b u) >
                o VS.E2 VS.E2 G VS.pp (id VS.E2)
              =< o-idr VS.E2 G VS.pp >
                VS.pp })) ;

    -- pv along r (with pp r = pp), read in SW
    endE (r : Sub VS.E2 VS.E2) (err : Id (Sub VS.E2 G) (o VS.E2 VS.E2 G VS.pp r) VS.pp) : El VS.E2 VS.SW =
      trE VS.E2 (subT VS.E2 VS.E2 VS.SW r) VS.SW
        (trans (Ty VS.E2) (subT VS.E2 VS.E2 VS.SW r) (subT VS.E2 G VS.S (o VS.E2 VS.E2 G VS.pp r)) VS.SW
           (sym (Ty VS.E2) (subT VS.E2 G VS.S (o VS.E2 VS.E2 G VS.pp r)) (subT VS.E2 VS.E2 VS.SW r) (subT-o VS.E2 VS.E2 G VS.S VS.pp r))
           (ap (Sub VS.E2 G) (Ty VS.E2) (\ t -> subT VS.E2 G VS.S t) (o VS.E2 VS.E2 G VS.pp r) VS.pp err))
        (subt VS.E2 VS.E2 VS.SW VS.pv r) ;

    -- the pair path at (b , u): Id(pv at r , pv), for r = rEnd after the point
    ppAt (b : El VS.E2 VS.App) (u : El VS.E2 (IJ.IdT VS.E2 VS.App VS.zA b)) (r : Sub VS.E2 VS.E2)
      (er : Id (Sub VS.E2 VS.E2) (o VS.E2 Om VS.E2 rEnd (ptO b u)) r) (err : Id (Sub VS.E2 G) (o VS.E2 VS.E2 G VS.pp r) VS.pp)
      : El VS.E2 (IJ.IdT VS.E2 VS.SW (endE r err) VS.pv) =
      trE VS.E2 (subT VS.E2 Om CM (ptO b u)) (IJ.IdT VS.E2 VS.SW (endE r err) VS.pv)
        (Id-ov VS.E2 Om SO Rend Rst (ptO b u) VS.SW (PSO b u) (endE r err) VS.pv
           (IN.teAny VS.E2 (subT VS.E2 Om SO (ptO b u)) VS.SW (subt VS.E2 Om SO Rend (ptO b u)) (endE r err)
              (IN.teT VS.E2 (subT VS.E2 Om SO (ptO b u)) (subT VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (ptO b u)) VS.SW
                 (subt VS.E2 Om SO Rend (ptO b u)) (subt VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (subt Om VS.E2 VS.SW VS.pv rEnd) (ptO b u)) (endE r err)
                 (IN.teS VS.E2 (subT VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (ptO b u)) (subT VS.E2 Om SO (ptO b u))
                    (subt VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (subt Om VS.E2 VS.SW VS.pv rEnd) (ptO b u)) (subt VS.E2 Om SO Rend (ptO b u))
                    (IN.teSubtTr VS.E2 Om (subT Om VS.E2 VS.SW rEnd) SO PEnd (subt Om VS.E2 VS.SW VS.pv rEnd) (ptO b u)))
                 (IN.teT VS.E2 (subT VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (ptO b u)) (subT VS.E2 VS.E2 VS.SW (o VS.E2 Om VS.E2 rEnd (ptO b u))) VS.SW
                    (subt VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (subt Om VS.E2 VS.SW VS.pv rEnd) (ptO b u)) (subt VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 rEnd (ptO b u)))
                    (endE r err)
                    (IN.teS VS.E2 (subT VS.E2 VS.E2 VS.SW (o VS.E2 Om VS.E2 rEnd (ptO b u))) (subT VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (ptO b u))
                       (subt VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 rEnd (ptO b u))) (subt VS.E2 Om (subT Om VS.E2 VS.SW rEnd) (subt Om VS.E2 VS.SW VS.pv rEnd) (ptO b u))
                       (IN.teSubtO VS.E2 Om VS.E2 VS.SW VS.pv rEnd (ptO b u)))
                    (IN.teT VS.E2 (subT VS.E2 VS.E2 VS.SW (o VS.E2 Om VS.E2 rEnd (ptO b u))) (subT VS.E2 VS.E2 VS.SW r) VS.SW
                       (subt VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 rEnd (ptO b u))) (subt VS.E2 VS.E2 VS.SW VS.pv r) (endE r err)
                       (IN.teSubEq VS.E2 VS.E2 VS.SW VS.pv (o VS.E2 Om VS.E2 rEnd (ptO b u)) r er)
                       (IN.teTr VS.E2 (subT VS.E2 VS.E2 VS.SW r) VS.SW
                          (trans (Ty VS.E2) (subT VS.E2 VS.E2 VS.SW r) (subT VS.E2 G VS.S (o VS.E2 VS.E2 G VS.pp r)) VS.SW
                             (sym (Ty VS.E2) (subT VS.E2 G VS.S (o VS.E2 VS.E2 G VS.pp r)) (subT VS.E2 VS.E2 VS.SW r) (subT-o VS.E2 VS.E2 G VS.S VS.pp r))
                             (ap (Sub VS.E2 G) (Ty VS.E2) (\ t -> subT VS.E2 G VS.S t) (o VS.E2 VS.E2 G VS.pp r) VS.pp err))
                          (subt VS.E2 VS.E2 VS.SW VS.pv r)))))
              (PSO b u))
           (pvId rSt PSt (ptO b u) (ePt b u) (PSO b u)))
        (subt VS.E2 Om CM JE (ptO b u)) ;
  } ;
} ;
