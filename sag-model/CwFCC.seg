-- CwFCC.seg (M1 step 3, S4 toolkit): in a CwF with Pi, Sigma, Swan Id and
-- naive funext NF: the identity types of a contractible type are
-- contractible, isContr A is contractible when A is, and so is
-- Pi (x : A) isContr (F x) when it is inhabited.  Two elements of a
-- contractible type are equal.
--
-- Informal text.  Let A be contractible, y0 : A.
-- (1) CwFContr.Norm gives gam : Pi w. Id(y0 , w) with gam y0 = refl
--     (Thy, read through gamAt).  Over G.A, Id(y0 , w) is contractible with
--     centre gam w: the contraction Id(gam w , u) is J on u : Id(y0 , w),
--     whose start at cen = (y0 , refl) is Thy (the leaves along cen: q is
--     refl (q-inst, reflT), gam weakened is gam at y0 (wE-inst, gamAt)).
-- (2) isContr A = Sigma (c : A) Pi w. Id(c , w): the base is contractible,
--     each fibre by weak funext (CwFWfe) from (1) at y0 = c (CwFSigC).
-- (3) Pi (x : A) isContr (F x) is contractible when k is an element: by
--     weak funext from (2) at k x.
-- (4) In a contractible type, Id(a , b) is trans (sym (ctr a)) (ctr b).

open Base ;

module CC (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module CT = CwFContr.Contr[l, C, PS, SS, IJ] ;
  module SC = CwFSigC.SigC[l, C, PS, SS, IJ] ;
  module WF = CwFWfe.Wfe[l, C, PS, SS, IJ, NF] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- (1) Id(y0 , w) is contractible over G.A

  module IC (G : Ctx) (A : Ty G) (kA : El G (EQ.isContr G A)) (y0 : El G A) {
    module N = CT.Norm[G, A, SG.cenOf G A kA, SG.ctrPiOf G A kA, y0] ;
    B2 : Ty (ext G A) = JP.IK G A y0 ;
    g : El (ext G A) B2 = N.gam ;
    Dc : Ctx = JP.Dx G A y0 ;
    cen : Sub G Dc = DJ.cen G A y0 ;
    I0 : Ty G = subT G (ext G A) B2 (sec G A y0) ;
    Iyy : Ty G = IJ.IdT G A y0 y0 ;
    W2 : Ty Dc = wkT (ext G A) B2 B2 ;
    CM : Ty Dc = JP.IK (ext G A) B2 g ;

    -- the leaves at cen
    PB0 : Id (Ty G) (subT G Dc W2 cen) I0 = JP.qT-inst G A B2 y0 I0 (refl I0) (DJ.reflE G A y0) ;
    P1 : Id (Ty G) (subT G Dc W2 cen) Iyy = trans (Ty G) (subT G Dc W2 cen) I0 Iyy PB0 (DJ.reflT G A y0) ;

    Pq : Ov G Dc W2 cen Iyy P1 (q (ext G A) B2) (IJ.rfl G A y0) =
      calc (El G Iyy) {
          trE G (subT G Dc W2 cen) Iyy P1 (subt G Dc W2 (q (ext G A) B2) cen)
        =< sym (El G Iyy) (trE G I0 Iyy (DJ.reflT G A y0) (trE G (subT G Dc W2 cen) I0 PB0 (subt G Dc W2 (q (ext G A) B2) cen)))
               (trE G (subT G Dc W2 cen) Iyy P1 (subt G Dc W2 (q (ext G A) B2) cen))
               (trE-tr G (subT G Dc W2 cen) I0 Iyy PB0 (DJ.reflT G A y0) (subt G Dc W2 (q (ext G A) B2) cen)) >
          trE G I0 Iyy (DJ.reflT G A y0) (trE G (subT G Dc W2 cen) I0 PB0 (subt G Dc W2 (q (ext G A) B2) cen))
        =< ap (El G I0) (El G Iyy) (\ v -> trE G I0 Iyy (DJ.reflT G A y0) v)
              (trE G (subT G Dc W2 cen) I0 PB0 (subt G Dc W2 (q (ext G A) B2) cen)) (DJ.reflE G A y0)
              (JP.q-inst G A B2 y0 I0 (refl I0) (DJ.reflE G A y0) PB0) >
          trE G I0 Iyy (DJ.reflT G A y0) (DJ.reflE G A y0)
        =< JP.trE-sym G I0 Iyy (DJ.reflT G A y0) (IJ.rfl G A y0) >
          IJ.rfl G A y0 } ;

    gv : El G Iyy = app G N.Iy N.Iyy (CT.TA G A (SG.cenOf G A kA) y0 N.T1y) N.dy ;

    Pg : Ov G Dc W2 cen Iyy P1 (wkE (ext G A) B2 B2 g) gv =
      calc (El G Iyy) {
          trE G (subT G Dc W2 cen) Iyy P1 (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen)
        =< trE-irr G (subT G Dc W2 cen) Iyy P1 (trans (Ty G) (subT G Dc W2 cen) I0 Iyy PB0 (JP.IKpt G A y0 y0))
              (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen) >
          trE G (subT G Dc W2 cen) Iyy (trans (Ty G) (subT G Dc W2 cen) I0 Iyy PB0 (JP.IKpt G A y0 y0)) (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen)
        =< sym (El G Iyy) (trE G I0 Iyy (JP.IKpt G A y0 y0) (trE G (subT G Dc W2 cen) I0 PB0 (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen)))
               (trE G (subT G Dc W2 cen) Iyy (trans (Ty G) (subT G Dc W2 cen) I0 Iyy PB0 (JP.IKpt G A y0 y0)) (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen))
               (trE-tr G (subT G Dc W2 cen) I0 Iyy PB0 (JP.IKpt G A y0 y0) (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen)) >
          trE G I0 Iyy (JP.IKpt G A y0 y0) (trE G (subT G Dc W2 cen) I0 PB0 (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen))
        =< ap (El G I0) (El G Iyy) (\ v -> trE G I0 Iyy (JP.IKpt G A y0 y0) v)
              (trE G (subT G Dc W2 cen) I0 PB0 (subt G Dc W2 (wkE (ext G A) B2 B2 g) cen)) (subt G (ext G A) B2 g (sec G A y0))
              (JP.wE-inst G A B2 y0 I0 (refl I0) (DJ.reflE G A y0) B2 g PB0) >
          trE G I0 Iyy (JP.IKpt G A y0 y0) (subt G (ext G A) B2 g (sec G A y0))
        =< N.gamAt >
          gv } ;

    T0 : Ty G = IJ.IdT G Iyy gv (IJ.rfl G A y0) ;

    Pcen : Id (Ty G) (subT G Dc CM cen) T0 =
      Id-ov G Dc W2 (wkE (ext G A) B2 B2 g) (q (ext G A) B2) cen Iyy P1 gv (IJ.rfl G A y0) Pg Pq ;

    JE : El Dc CM = IJ.J G A y0 CM (trE G T0 (subT G Dc CM cen) (sym (Ty G) (subT G Dc CM cen) T0 Pcen) N.Thy) ;

    idC : El (ext G A) (EQ.isContr (ext G A) B2) = SG.mkContr (ext G A) B2 g JE ;
  } ;

  ----------------------------------------------------------------------
  -- (2) isContr A is contractible

  ccC (G : Ctx) (A : Ty G) (kA : El G (EQ.isContr G A)) : El G (EQ.isContr G (EQ.isContr G A)) =
    SC.sigC G A (SG.CP G A) kA
      (WF.wfe (ext G A) (wkT G A A) (EQ.Id2 G A) (IC[ext G A, wkT G A A, kA', q G A].idC))
   where {
    kA' : El (ext G A) (EQ.isContr (ext G A) (wkT G A A)) =
      trE (ext G A) (wkT G A (EQ.isContr G A)) (EQ.isContr (ext G A) (wkT G A A))
        (EQ.isContr-ov (ext G A) G A (p G A) (wkT G A A) (refl (wkT G A A))) (wkE G A (EQ.isContr G A) kA) ;
   } ;

  ----------------------------------------------------------------------
  -- (3) Pi (x : A) isContr (F x), when inhabited

  piCC (G : Ctx) (A : Ty G) (F : Ty (ext G A)) (k : El G (PS.Pi G A (EQ.isContr (ext G A) F)))
    : El G (EQ.isContr G (PS.Pi G A (EQ.isContr (ext G A) F))) =
    WF.wfe G A (EQ.isContr (ext G A) F) (ccC (ext G A) F ((PS.Pi-iso G A (EQ.isContr (ext G A) F)).fun k)) ;

  ----------------------------------------------------------------------
  -- (4) two elements of a contractible type are equal

  eqC (G : Ctx) (X : Ty G) (kc : El G (EQ.isContr G X)) (a b : El G X) : El G (IJ.IdT G X a b) =
    PT.transM G X a (SG.cenOf G X kc) b (PT.symM G X (SG.cenOf G X kc) a (SG.ctrAt G X kc a)) (SG.ctrAt G X kc b) ;
} ;
