-- PosCofConj.seg (M1, step 1): dependent conjunction for the cofibrations
-- of PosCof (M1.md §1), the hypothesis of Swan's identity type (core CId).
--
-- Informal text.  Given a cofibration Q of X and a natural family F f of
-- cofibrations (for f landing in Q), the decidable sieve
--   f lands  iff  f lands in Q and the identity lands in F f
-- (CSieve.DConjS) is a cofibration.  Let f land and k be covered by f.  Let
-- S be the image of f as a full subposet, ι : S -> X its inclusion, and
-- write f = ι q, k = ι k' (k' exists because k is covered by f).  Then ι
-- lands in Q (Full Q), and Λ = F ι is a cofibration of S.  By naturality
-- F f is the pullback of Λ along q, so q lands in Λ; k' is covered by q,
-- so k' lands in Λ (Full Λ); by naturality again the identity lands in
-- F k.  And k lands in Q (Full Q).  So k lands.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;
open PosCof[a] ;

------------------------------------------------------------------------
-- the full subposet on a non-empty decidable subset

qsplit (X : Ob) (A : Subset X) (t : Tree) : (b : Bool) (e : Id Bool (car X t) b) -> IsT (QT[X, A].qB t b e)
  -> (h : IsT (car X t)) * IsT (A (t, h)) = split {
  true -> \ e i -> (e, i) ;
  false -> \ e i -> absurd ((h : IsT (car X t)) * IsT (A (t, h))) (false-true i) } ;

qT-split (X : Ob) (A : Subset X) (t : Tree) (i : IsT (QT[X, A].qT t)) : (h : IsT (car X t)) * IsT (A (t, h)) =
  qsplit X A t (car X t) (refl (car X t)) i ;

module Sub (X : Ob) (A : Subset X) (a0 : El X) (h0 : IsT (A a0)) {
  ob : Ob = mkOb (QT[X, A].qT) (le X) (enum X)
    (\ t h -> cover X t (qT-split X A t h).1)
    a0.1 (transH (QT[X, A].qT-el a0) h0)
    (\ t h -> le-refl X t (qT-split X A t h).1)
    (le-trans X) (le-anti X) ;

  incl : Hom ob X = mkHom ob X (\ s -> (s.1, (qT-split X A s.1 s.2).1)) (\ s t h -> h) ;

  incl-in (s : El ob) : IsT (A (app ob X incl s)) = (qT-split X A s.1 s.2).2 ;

  -- a map with values in A factors through the inclusion
  cores (V : Ob) (k : Hom V X) (ink : (v : El V) -> IsT (A (app V X k v))) : Hom V ob =
    mkHom V ob (\ v -> ((app V X k v).1, transH (QT[X, A].qT-el (app V X k v)) (ink v))) (\ s t h -> mono V X k s t h) ;

  incl-cores (V : Ob) (k : Hom V X) (ink : (v : El V) -> IsT (A (app V X k v)))
    : Id (Hom V X) (compH V ob X incl (cores V k ink)) k =
    hom-eq V X (compH V ob X incl (cores V k ink)) k (\ v -> app-compH1 V ob X incl (cores V k ink) v) ;
} ;

------------------------------------------------------------------------
-- dependent conjunction

module DSm = CSieve[a].DConjS[obV, homV, idH, compH, comp-assoc, comp-idl, comp-idr] ;

module DC (X : Ob) (Q : PC.Phi X) (F : (W : Ob) (f : Hom W X) -> PC.Lands W X Q f -> PC.Phi W)
  (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : PC.Lands W X Q f) (i' : PC.Lands V X Q (compH V W X f g))
        -> Id (PC.Phi V) (PC.pre V W g (F W f i)) (F V (compH V W X f g) i')) {

  Fsp : DSm.FamTy X Q.1 = \ W f i -> (F W f i).1 ;
  Fnsp : DSm.FnTy X Q.1 Fsp = \ V W g f i i' -> apH (\ R -> R.1) (Fn V W g f i i') ;

  -- F depends on the map only
  F-cong (W : Ob) (f f' : Hom W X) (p : Id (Hom W X) f f') (i : PC.Lands W X Q f) (i' : PC.Lands W X Q f')
    : Id (PC.Phi W) (F W f i) (F W f' i') =
    idJ (Hom W X) f (\ f2 p2 -> (i2 : PC.Lands W X Q f2) -> Id (PC.Phi W) (F W f i) (F W f2 i2))
      (\ i2 -> apH (F W f) (PC.isProp-Lands W X Q f i i2)) f' p i' ;

  module At (W Z : Ob) (f : Hom W X) (k : Hom Z X)
    (i : SP.Lands W X (DSm.dconj X Q.1 Fsp Fnsp) f) (c : Covered Z W X k f) {
    o : (i' : PC.Lands W X Q f) * PC.Lands W W (F W f i') (idH W) = DSm.dc-out W X Q.1 Fsp Fnsp f i ;

    -- the image of f as a full subposet S, f = ι q, k = ι k'
    module SB = Sub[X, Image[W, X, f].inIm, app W X f (pt W, pt-car W), Image[W, X, f].im-complete (pt W, pt-car W)] ;
    q : Hom W SB.ob = SB.cores W f (\ s -> Image[W, X, f].im-complete s) ;
    k' : Hom Z SB.ob = SB.cores Z k c ;
    iq : Id (Hom W X) (compH W SB.ob X SB.incl q) f = SB.incl-cores W f (\ s -> Image[W, X, f].im-complete s) ;
    ik : Id (Hom Z X) (compH Z SB.ob X SB.incl k') k = SB.incl-cores Z k c ;

    -- k and ι land in Q
    iQ : PC.Lands Z X Q k = Q.2 W Z f k o.1 c ;
    iI : PC.Lands SB.ob X Q SB.incl = Q.2 W SB.ob f SB.incl o.1 (\ s -> SB.incl-in s) ;
    iq' : PC.Lands W X Q (compH W SB.ob X SB.incl q) = slands-hom W X Q.1 f (compH W SB.ob X SB.incl q) (symH iq) o.1 ;
    ik' : PC.Lands Z X Q (compH Z SB.ob X SB.incl k') = slands-hom Z X Q.1 k (compH Z SB.ob X SB.incl k') (symH ik) iQ ;

    Lam : PC.Phi SB.ob = F SB.ob SB.incl iI ;

    -- q lands in Λ: F f is the pullback of Λ along q
    q-lands : PC.Lands W SB.ob Lam q =
      slands-hom W SB.ob Lam.1 (compH W W SB.ob q (idH W)) q (comp-idr W SB.ob q)
        (substH (\ R -> PC.Lands W W R (idH W)) (symH (Fn W SB.ob q SB.incl iI iq'))
          (substH (\ R -> PC.Lands W W R (idH W)) (F-cong W f (compH W SB.ob X SB.incl q) (symH iq) o.1 iq') o.2)) ;

    -- k' is covered by q
    r (v : El Z) : (s : El W) * Id Tree (app W X f s).1 (app Z X k v).1 = Image[W, X, f].im-sound (app Z X k v) (c v) ;
    cov : Covered Z W SB.ob k' q = \ v ->
      Image[W, SB.ob, q].im-at (app Z SB.ob k' v) (r v).1 (el-eq SB.ob (app W SB.ob q (r v).1) (app Z SB.ob k' v) (r v).2) ;

    k'-lands : PC.Lands Z SB.ob Lam k' = Lam.2 W Z q k' q-lands cov ;

    -- the identity lands in F k
    jF : PC.Lands Z Z (F Z k iQ) (idH Z) =
      substH (\ R -> PC.Lands Z Z R (idH Z))
        (transH (Fn Z SB.ob k' SB.incl iI ik') (symH (F-cong Z k (compH Z SB.ob X SB.incl k') (symH ik) iQ ik')))
        (slands-hom Z SB.ob Lam.1 k' (compH Z Z SB.ob k' (idH Z)) (symH (comp-idr Z SB.ob k')) k'-lands) ;

    result : SP.Lands Z X (DSm.dconj X Q.1 Fsp Fnsp) k = DSm.dc-in Z X Q.1 Fsp Fnsp k iQ jF ;
  } ;

  full : Full X (DSm.dconj X Q.1 Fsp Fnsp) = \ W V f k i c -> At[W, V, f, k, i, c].result ;

  dconj : PC.Phi X = (DSm.dconj X Q.1 Fsp Fnsp, full) ;
} ;

-- the three fields of CId.DConj
dconjC (X : Ob) (Q : PC.Phi X) (F : (W : Ob) (f : Hom W X) -> PC.Lands W X Q f -> PC.Phi W)
  (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : PC.Lands W X Q f) (i' : PC.Lands V X Q (compH V W X f g))
        -> Id (PC.Phi V) (PC.pre V W g (F W f i)) (F V (compH V W X f g) i')) : PC.Phi X = DC[X, Q, F, Fn].dconj ;

dc-inC (W X : Ob) (Q : PC.Phi X) (F : (W'' : Ob) (f : Hom W'' X) -> PC.Lands W'' X Q f -> PC.Phi W'')
  (Fn : (V W' : Ob) (g : Hom V W') (f : Hom W' X) (i : PC.Lands W' X Q f) (i' : PC.Lands V X Q (compH V W' X f g))
        -> Id (PC.Phi V) (PC.pre V W' g (F W' f i)) (F V (compH V W' X f g) i'))
  (f : Hom W X) (i : PC.Lands W X Q f) (j : PC.Lands W W (F W f i) (idH W)) : PC.Lands W X (dconjC X Q F Fn) f =
  DSm.dc-in W X Q.1 DC[X, Q, F, Fn].Fsp DC[X, Q, F, Fn].Fnsp f i j ;

dc-outC (W X : Ob) (Q : PC.Phi X) (F : (W'' : Ob) (f : Hom W'' X) -> PC.Lands W'' X Q f -> PC.Phi W'')
  (Fn : (V W' : Ob) (g : Hom V W') (f : Hom W' X) (i : PC.Lands W' X Q f) (i' : PC.Lands V X Q (compH V W' X f g))
        -> Id (PC.Phi V) (PC.pre V W' g (F W' f i)) (F V (compH V W' X f g) i'))
  (f : Hom W X) (i : PC.Lands W X (dconjC X Q F Fn) f) : (i' : PC.Lands W X Q f) * PC.Lands W W (F W f i') (idH W) =
  DSm.dc-out W X Q.1 DC[X, Q, F, Fn].Fsp DC[X, Q, F, Fn].Fnsp f i ;
