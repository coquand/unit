-- CwFSing.seg (M1 step 3, S4 toolkit): elements of isContr, and based
-- singletons are contractible, in a CwF with Pi, Sigma and Swan Id.
--
-- Informal text.
-- (1) An element of isContr X is a centre c and a contraction: an element
--     of Id(c p , q) over G.X (mkContr; PCP: the second component's type at
--     c is Pi X Id(c p , q)).  Conversely its centre and its values ctrAt.
-- (2) subComp: b[s1][s2] and b[t], read in one type, agree when s1 s2 = t.
-- (3) Sing x = Sigma (z : A) Id(x , z).  Over Dx = G.A.Id(x p , q) the pair
--     of the variables pv (CwFSig) is an element of Sing[pp].  The centre
--     cS is pv at the centre cen of J, read in Sing (pp cen = id).  J with
--     the motive Id(cS[pp] , pv) has a start at cen: refl, since there both
--     sides are cS (2).  Along unpk : G.Sing -> Dx, pv is q (CwFSig) and
--     cS[pp] is cS[p]: the contraction.

open Base ;

module Sing (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- (1) contractibility

  CP (G : Ctx) (X : Ty G) : Ty (ext G X) = PS.Pi (ext G X) (wkT G X X) (EQ.Id2 G X) ;

  PCP (G : Ctx) (X : Ty G) (c : El G X) : Id (Ty G) (subT G (ext G X) (CP G X) (sec G X c)) (PS.Pi G X (JP.IK G X c)) =
    Pi-ov G (ext G X) (wkT G X X) (EQ.Id2 G X) (sec G X c) X (p-sec-T G X X c) (JP.IK G X c)
      (JP.IK-ov G (ext G X) (wkT G X X) (q G X) (sec G X c) X (p-sec-T G X X c) c (IN.q-secO G X c (p-sec-T G X X c))) ;

  mkContr (G : Ctx) (X : Ty G) (c : El G X) (ctr : El (ext G X) (JP.IK G X c)) : El G (EQ.isContr G X) =
    IN.pr G X (CP G X) c
      (trE G (PS.Pi G X (JP.IK G X c)) (subT G (ext G X) (CP G X) (sec G X c))
         (sym (Ty G) (subT G (ext G X) (CP G X) (sec G X c)) (PS.Pi G X (JP.IK G X c)) (PCP G X c))
         (lam G X (JP.IK G X c) ctr)) ;

  cenOf (G : Ctx) (X : Ty G) (k : El G (EQ.isContr G X)) : El G X = IN.fst G X (CP G X) k ;

  ctrPiOf (G : Ctx) (X : Ty G) (k : El G (EQ.isContr G X)) : El G (PS.Pi G X (JP.IK G X (cenOf G X k))) =
    trE G (subT G (ext G X) (CP G X) (sec G X (cenOf G X k))) (PS.Pi G X (JP.IK G X (cenOf G X k))) (PCP G X (cenOf G X k))
      (IN.snd G X (CP G X) k) ;

  ctrAt (G : Ctx) (X : Ty G) (k : El G (EQ.isContr G X)) (y : El G X) : El G (IJ.IdT G X (cenOf G X k) y) =
    trE G (subT G (ext G X) (JP.IK G X (cenOf G X k)) (sec G X y)) (IJ.IdT G X (cenOf G X k) y) (JP.IKpt G X (cenOf G X k) y)
      (IN.appD G X (JP.IK G X (cenOf G X k)) (ctrPiOf G X k) y) ;

  ----------------------------------------------------------------------
  -- (2) a substituted element along a composite

  subComp (E M G : Ctx) (B : Ty G) (b : El G B) (s1 : Sub M G) (s2 : Sub E M) (t : Sub E G) (e : Id (Sub E G) (o E M G s1 s2) t)
    (T : Ty E) (P : Id (Ty E) (subT E M (subT M G B s1) s2) T) (Q : Id (Ty E) (subT E G B t) T)
    : Id (El E T) (trE E (subT E M (subT M G B s1) s2) T P (subt E M (subT M G B s1) (subt M G B b s1) s2)) (trE E (subT E G B t) T Q (subt E G B b t)) =
    calc (El E T) {
        trE E X1 T P (subt E M (subT M G B s1) (subt M G B b s1) s2)
      =< ap (El E X1) (El E T) (\ v -> trE E X1 T P v) (subt E M (subT M G B s1) (subt M G B b s1) s2) (trE E S0 X1 So (subt E G B b (o E M G s1 s2)))
            (sym (El E X1) (trE E S0 X1 So (subt E G B b (o E M G s1 s2))) (subt E M (subT M G B s1) (subt M G B b s1) s2) (subt-o E M G B b s1 s2)) >
        trE E X1 T P (trE E S0 X1 So (subt E G B b (o E M G s1 s2)))
      =< trE-tr E S0 X1 T So P (subt E G B b (o E M G s1 s2)) >
        trE E S0 T (trans (Ty E) S0 X1 T So P) (subt E G B b (o E M G s1 s2))
      =< SJ.subtEq E G B b (o E M G s1 s2) t e T (trans (Ty E) S0 X1 T So P) Q >
        trE E (subT E G B t) T Q (subt E G B b t) }
   where {
    X1 : Ty E = subT E M (subT M G B s1) s2 ;
    S0 : Ty E = subT E G B (o E M G s1 s2) ;
    So : Id (Ty E) S0 X1 = subT-o E M G B s1 s2 ;
   } ;

  ----------------------------------------------------------------------
  -- (3) based singletons

  SingT (G : Ctx) (A : Ty G) (x : El G A) : Ty G = SS.Sig G A (JP.IK G A x) ;

  module S1 (G : Ctx) (A : Ty G) (x : El G A) {
    module VS = SV.At[G, A, JP.IK G A x] ;
    S : Ty G = SingT G A x ;
    Dx : Ctx = JP.Dx G A x ;
    cen : Sub G Dx = DJ.cen G A x ;

    ppcen : Id (Sub G G) (o G Dx G VS.pp cen) (id G) =
      calc (Sub G G) {
          o G Dx G VS.pp cen
        =< o-assoc G Dx (ext G A) G (p G A) VS.p2 cen >
          o G (ext G A) G (p G A) (o G Dx (ext G A) VS.p2 cen)
        =< ap (Sub G (ext G A)) (Sub G G) (\ t -> o G (ext G A) G (p G A) t) (o G Dx (ext G A) VS.p2 cen) (sec G A x)
              (IN.p-extS G (ext G A) (JP.IK G A x) (sec G A x) (DJ.reflE G A x)) >
          o G (ext G A) G (p G A) (sec G A x)
        =< p-sec G A x >
          id G } ;

    PSc : Id (Ty G) (subT G Dx VS.SW cen) S =
      trans (Ty G) (subT G Dx VS.SW cen) (subT G G S (o G Dx G VS.pp cen)) S
        (sym (Ty G) (subT G G S (o G Dx G VS.pp cen)) (subT G Dx VS.SW cen) (subT-o G Dx G S VS.pp cen))
        (trans (Ty G) (subT G G S (o G Dx G VS.pp cen)) (subT G G S (id G)) S
           (ap (Sub G G) (Ty G) (\ t -> subT G G S t) (o G Dx G VS.pp cen) (id G) ppcen)
           (subT-id G S)) ;

    cS : El G S = trE G (subT G Dx VS.SW cen) S PSc (subt G Dx VS.SW VS.pv cen) ;

    cW : El Dx VS.SW = subt Dx G S cS VS.pp ;

    Pcw : Ov G Dx VS.SW cen S PSc cW cS =
      trans (El G S) (trE G (subT G Dx VS.SW cen) S PSc (subt G Dx VS.SW cW cen)) (trE G (subT G G S (id G)) S (subT-id G S) (subt G G S cS (id G))) cS
        (subComp G Dx G S cS VS.pp cen (id G) ppcen S PSc (subT-id G S))
        (subt-id G S cS) ;

    CM : Ty Dx = IJ.IdT Dx VS.SW cW VS.pv ;

    Pcen : Id (Ty G) (subT G Dx CM cen) (IJ.IdT G S cS cS) =
      Id-ov G Dx VS.SW cW VS.pv cen S PSc cS cS Pcw (refl cS) ;

    JE : El Dx CM =
      IJ.J G A x CM (trE G (IJ.IdT G S cS cS) (subT G Dx CM cen) (sym (Ty G) (subT G Dx CM cen) (IJ.IdT G S cS cS) Pcen) (IJ.rfl G S cS)) ;

    -- along unpk
    Pcu : Ov (ext G S) Dx VS.SW VS.unpk (wkT G S S) VS.PU cW (wkE G S S cS) =
      subComp (ext G S) Dx G S cS VS.pp VS.unpk (p G S) VS.pp-unpk (wkT G S S) VS.PU (refl (wkT G S S)) ;

    Pctr : Id (Ty (ext G S)) (subT (ext G S) Dx CM VS.unpk) (JP.IK G S cS) =
      Id-ov (ext G S) Dx VS.SW cW VS.pv VS.unpk (wkT G S S) VS.PU (wkE G S S cS) (q G S) Pcu VS.pv-unpk ;

    ctr : El (ext G S) (JP.IK G S cS) =
      trE (ext G S) (subT (ext G S) Dx CM VS.unpk) (JP.IK G S cS) Pctr (subt (ext G S) Dx CM JE VS.unpk) ;

    singC : El G (EQ.isContr G S) = mkContr G S cS ctr ;
  } ;

  singC (G : Ctx) (A : Ty G) (x : El G A) : El G (EQ.isContr G (SingT G A x)) = S1[G, A, x].singC ;
} ;
