-- CwFEqP.seg (M1 step 3, S4 toolkit): an equivalence from and to its five
-- components, in a CwF with Pi, Sigma and Swan Id.
--
-- Informal text.  An element of Equiv(X , Y) is a nest of four pairs
-- (f , (g , (eta , (h , eps)))) with eta : f g ~ id and eps : h f ~ id.
-- mkE packs five components; UE unpacks one element; etaE: packing the
-- unpacked components gives the element back (eta for pairs, the
-- transports undone).  mkE-nat: packing is stable under substitution
-- (pairs are stable, CwFPrj.prO; the type families of the four layers are
-- stable, the *Fam-ov lemmas, read off CwFEq's stability lemmas).

open Base ;

module EqP (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PJ = CwFPrj.Prj[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- (1) the four type families

  -- the family of RetT u (h : Y -> X with h u ~ id), over G.(Y -> X)
  RetFam (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) : Ty (ext G (Fun G Y X)) =
    EQ.Htpy (ext G (Fun G Y X)) (wkT G (Fun G Y X) Y) (wkT G (Fun G Y X) X) (EQ.qF G Y X) (EQ.wkF G (Fun G Y X) X Y u) ;

  -- the family of the pair (eta , RetT), over G.(f g ~ id)
  R2Fam (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X)) : Ty (ext G (EQ.Htpy G X Y f g)) =
    EQ.RetT (ext G (EQ.Htpy G X Y f g)) (wkT G (EQ.Htpy G X Y f g) X) (wkT G (EQ.Htpy G X Y f g) Y) (EQ.wkF G (EQ.Htpy G X Y f g) X Y f) ;

  -- the family of isEquiv f, over G.(Y -> X)
  IEFam (G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) : Ty (ext G (Fun G B A)) =
    SS.Sig (ext G (Fun G B A)) (EQ.SecH G A B f)
      (EQ.RetT (ext (ext G (Fun G B A)) (EQ.SecH G A B f))
         (wkT (ext G (Fun G B A)) (EQ.SecH G A B f) (wkT G (Fun G B A) A))
         (wkT (ext G (Fun G B A)) (EQ.SecH G A B f) (wkT G (Fun G B A) B))
         (EQ.wkF (ext G (Fun G B A)) (EQ.SecH G A B f) (wkT G (Fun G B A) A) (wkT G (Fun G B A) B) (EQ.wkF G (Fun G B A) A B f))) ;

  -- the family of Equiv, over G.(A -> B)
  EFam (G : Ctx) (A B : Ty G) : Ty (ext G (Fun G A B)) =
    EQ.isEquiv (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B) (EQ.qF G A B) ;

  RetFam-ov (D G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PU : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y')) (u' : El D (Fun D X' Y')) (Pu : Ov D G (Fun G X Y) s (Fun D X' Y') PU u u')
    : Id (Ty (ext D (Fun D Y' X'))) (subT (ext D (Fun D Y' X')) (ext G (Fun G Y X)) (RetFam G X Y u) (upT D G (Fun G Y X) s (Fun D Y' X') (Fun-ov D G Y X s Y' PY X' PX)))
         (RetFam D X' Y' u') =
    EQ.Htpy-ov K' K Y1 X1 (EQ.qF G Y X) (EQ.wkF G (Fun G Y X) X Y u) s1 Y1' PY1 X1' PX1
      PU1 (EQ.qF D Y' X') (EQ.qF-ov D G Y X s Y' X' PG PU1)
      PV1 (EQ.wkF D (Fun D Y' X') X' Y' u') (EQ.wkF-ov D G (Fun G Y X) X Y s (Fun D Y' X') PG X' Y' PU u u' Pu PV1)
   where {
    K : Ctx = ext G (Fun G Y X) ;
    K' : Ctx = ext D (Fun D Y' X') ;
    Y1 : Ty K = wkT G (Fun G Y X) Y ;
    X1 : Ty K = wkT G (Fun G Y X) X ;
    Y1' : Ty K' = wkT D (Fun D Y' X') Y' ;
    X1' : Ty K' = wkT D (Fun D Y' X') X' ;
    PG : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X') = Fun-ov D G Y X s Y' PY X' PX ;
    s1 : Sub K' K = upT D G (Fun G Y X) s (Fun D Y' X') PG ;
    PY1 : Id (Ty K') (subT K' K Y1 s1) Y1' = wkT-ov D G (Fun G Y X) Y s (Fun D Y' X') PG Y' PY ;
    PX1 : Id (Ty K') (subT K' K X1 s1) X1' = wkT-ov D G (Fun G Y X) X s (Fun D Y' X') PG X' PX ;
    PU1 : Id (Ty K') (subT K' K (Fun K Y1 X1) s1) (Fun K' Y1' X1') = Fun-ov K' K Y1 X1 s1 Y1' PY1 X1' PX1 ;
    PV1 : Id (Ty K') (subT K' K (Fun K X1 Y1) s1) (Fun K' X1' Y1') = Fun-ov K' K X1 Y1 s1 X1' PX1 Y1' PY1 ;
   } ;

  R2Fam-ov (D G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PF : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y')) (f' : El D (Fun D X' Y')) (Pf : Ov D G (Fun G X Y) s (Fun D X' Y') PF f f')
    (PG : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (g' : El D (Fun D Y' X')) (Pg : Ov D G (Fun G Y X) s (Fun D Y' X') PG g g')
    : Id (Ty (ext D (EQ.Htpy D X' Y' f' g')))
         (subT (ext D (EQ.Htpy D X' Y' f' g')) (ext G (EQ.Htpy G X Y f g)) (R2Fam G X Y f g)
               (upT D G (EQ.Htpy G X Y f g) s (EQ.Htpy D X' Y' f' g') (EQ.Htpy-ov D G X Y f g s X' PX Y' PY PF f' Pf PG g' Pg)))
         (R2Fam D X' Y' f' g') =
    EQ.RetT-ov K' K XH YH (EQ.wkF G H X Y f) s2 XH' PXH YH' PYH PF2 (EQ.wkF D H' X' Y' f')
      (EQ.wkF-ov D G H X Y s H' PH X' Y' PF f f' Pf PF2)
   where {
    H : Ty G = EQ.Htpy G X Y f g ;
    H' : Ty D = EQ.Htpy D X' Y' f' g' ;
    PH : Id (Ty D) (subT D G H s) H' = EQ.Htpy-ov D G X Y f g s X' PX Y' PY PF f' Pf PG g' Pg ;
    K : Ctx = ext G H ;
    K' : Ctx = ext D H' ;
    s2 : Sub K' K = upT D G H s H' PH ;
    XH : Ty K = wkT G H X ;
    YH : Ty K = wkT G H Y ;
    XH' : Ty K' = wkT D H' X' ;
    YH' : Ty K' = wkT D H' Y' ;
    PXH : Id (Ty K') (subT K' K XH s2) XH' = wkT-ov D G H X s H' PH X' PX ;
    PYH : Id (Ty K') (subT K' K YH s2) YH' = wkT-ov D G H Y s H' PH Y' PY ;
    PF2 : Id (Ty K') (subT K' K (Fun K XH YH) s2) (Fun K' XH' YH') = Fun-ov K' K XH YH s2 XH' PXH YH' PYH ;
   } ;

  IEFam-ov (D G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) (s : Sub D G)
    (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    (PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B')) (f' : El D (Fun D A' B')) (Pf : Ov D G (Fun G A B) s (Fun D A' B') PF f f')
    : Id (Ty (ext D (Fun D B' A'))) (subT (ext D (Fun D B' A')) (ext G (Fun G B A)) (IEFam G A B f) (upT D G (Fun G B A) s (Fun D B' A') (Fun-ov D G B A s B' PB A' PA)))
         (IEFam D A' B' f') =
    Sig-ov K1' K1 H1 (EQ.RetT K2 A2 B2 f2) s1 H1' PH (EQ.RetT K2' A2' B2' f2')
      (EQ.RetT-ov K2' K2 A2 B2 f2 s2 A2' PA2 B2' PB2 PF2 f2'
         (EQ.wkF-ov K1' K1 H1 A1 B1 s1 H1' PH A1' B1' PF1 f1 f1' Pf1 PF2))
   where {
    K1 : Ctx = ext G (Fun G B A) ;
    K1' : Ctx = ext D (Fun D B' A') ;
    A1 : Ty K1 = wkT G (Fun G B A) A ;
    B1 : Ty K1 = wkT G (Fun G B A) B ;
    A1' : Ty K1' = wkT D (Fun D B' A') A' ;
    B1' : Ty K1' = wkT D (Fun D B' A') B' ;
    f1 : El K1 (Fun K1 A1 B1) = EQ.wkF G (Fun G B A) A B f ;
    f1' : El K1' (Fun K1' A1' B1') = EQ.wkF D (Fun D B' A') A' B' f' ;
    H1 : Ty K1 = EQ.SecH G A B f ;
    H1' : Ty K1' = EQ.SecH D A' B' f' ;
    K2 : Ctx = ext K1 H1 ;
    K2' : Ctx = ext K1' H1' ;
    A2 : Ty K2 = wkT K1 H1 A1 ;
    B2 : Ty K2 = wkT K1 H1 B1 ;
    A2' : Ty K2' = wkT K1' H1' A1' ;
    B2' : Ty K2' = wkT K1' H1' B1' ;
    f2 : El K2 (Fun K2 A2 B2) = EQ.wkF K1 H1 A1 B1 f1 ;
    f2' : El K2' (Fun K2' A2' B2') = EQ.wkF K1' H1' A1' B1' f1' ;
    PG : Id (Ty D) (subT D G (Fun G B A) s) (Fun D B' A') = Fun-ov D G B A s B' PB A' PA ;
    s1 : Sub K1' K1 = upT D G (Fun G B A) s (Fun D B' A') PG ;
    PA1 : Id (Ty K1') (subT K1' K1 A1 s1) A1' = wkT-ov D G (Fun G B A) A s (Fun D B' A') PG A' PA ;
    PB1 : Id (Ty K1') (subT K1' K1 B1 s1) B1' = wkT-ov D G (Fun G B A) B s (Fun D B' A') PG B' PB ;
    PF1 : Id (Ty K1') (subT K1' K1 (Fun K1 A1 B1) s1) (Fun K1' A1' B1') = Fun-ov K1' K1 A1 B1 s1 A1' PA1 B1' PB1 ;
    PG1 : Id (Ty K1') (subT K1' K1 (Fun K1 B1 A1) s1) (Fun K1' B1' A1') = Fun-ov K1' K1 B1 A1 s1 B1' PB1 A1' PA1 ;
    Pf1 : Ov K1' K1 (Fun K1 A1 B1) s1 (Fun K1' A1' B1') PF1 f1 f1' =
      EQ.wkF-ov D G (Fun G B A) A B s (Fun D B' A') PG A' B' PF f f' Pf PF1 ;
    PH : Id (Ty K1') (subT K1' K1 H1 s1) H1' =
      EQ.Htpy-ov K1' K1 A1 B1 f1 (EQ.qF G B A) s1 A1' PA1 B1' PB1 PF1 f1' Pf1 PG1 (EQ.qF D B' A') (EQ.qF-ov D G B A s B' A' PG PG1) ;
    s2 : Sub K2' K2 = upT K1' K1 H1 s1 H1' PH ;
    PA2 : Id (Ty K2') (subT K2' K2 A2 s2) A2' = wkT-ov K1' K1 H1 A1 s1 H1' PH A1' PA1 ;
    PB2 : Id (Ty K2') (subT K2' K2 B2 s2) B2' = wkT-ov K1' K1 H1 B1 s1 H1' PH B1' PB1 ;
    PF2 : Id (Ty K2') (subT K2' K2 (Fun K2 A2 B2) s2) (Fun K2' A2' B2') = Fun-ov K2' K2 A2 B2 s2 A2' PA2 B2' PB2 ;
   } ;

  EFam-ov (D G : Ctx) (A B : Ty G) (s : Sub D G)
    (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    : Id (Ty (ext D (Fun D A' B'))) (subT (ext D (Fun D A' B')) (ext G (Fun G A B)) (EFam G A B) (upT D G (Fun G A B) s (Fun D A' B') (Fun-ov D G A B s A' PA B' PB)))
         (EFam D A' B') =
    EQ.isEquiv-ov K' K A1 B1 (EQ.qF G A B) s1 A1' PA1 B1' PB1 PF1 (EQ.qF D A' B') (EQ.qF-ov D G A B s A' B' PF PF1)
   where {
    K : Ctx = ext G (Fun G A B) ;
    K' : Ctx = ext D (Fun D A' B') ;
    A1 : Ty K = wkT G (Fun G A B) A ;
    B1 : Ty K = wkT G (Fun G A B) B ;
    A1' : Ty K' = wkT D (Fun D A' B') A' ;
    B1' : Ty K' = wkT D (Fun D A' B') B' ;
    PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B') = Fun-ov D G A B s A' PA B' PB ;
    s1 : Sub K' K = upT D G (Fun G A B) s (Fun D A' B') PF ;
    PA1 : Id (Ty K') (subT K' K A1 s1) A1' = wkT-ov D G (Fun G A B) A s (Fun D A' B') PF A' PA ;
    PB1 : Id (Ty K') (subT K' K B1 s1) B1' = wkT-ov D G (Fun G A B) B s (Fun D A' B') PF B' PB ;
    PF1 : Id (Ty K') (subT K' K (Fun K A1 B1) s1) (Fun K' A1' B1') = Fun-ov K' K A1 B1 s1 A1' PA1 B1' PB1 ;
   } ;

  ----------------------------------------------------------------------
  -- (2) the families at points

  -- the family of RetT f at h
  PH2 (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (h : El D (Fun D Y X))
    : Id (Ty D) (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h)) (EQ.Htpy D Y X h f) =
    EQ.Htpy-ov D K1 B1 A1 g1 f1 (sec D FBA h) Y (p-sec-T D FBA Y h) X (p-sec-T D FBA X h) PU h (IN.qF-sec D Y X h PU)
      PV f (IN.wkF-sec D FBA X Y h f PV)
   where {
    FBA : Ty D = Fun D Y X ;
    K1 : Ctx = ext D FBA ;
    A1 : Ty K1 = wkT D FBA X ;
    B1 : Ty K1 = wkT D FBA Y ;
    f1 : El K1 (Fun K1 A1 B1) = EQ.wkF D FBA X Y f ;
    g1 : El K1 (Fun K1 B1 A1) = EQ.qF D Y X ;
    PU : Id (Ty D) (subT D K1 (Fun K1 B1 A1) (sec D FBA h)) (Fun D Y X) =
      Fun-ov D K1 B1 A1 (sec D FBA h) Y (p-sec-T D FBA Y h) X (p-sec-T D FBA X h) ;
    PV : Id (Ty D) (subT D K1 (Fun K1 A1 B1) (sec D FBA h)) (Fun D X Y) =
      Fun-ov D K1 A1 B1 (sec D FBA h) X (p-sec-T D FBA X h) Y (p-sec-T D FBA Y h) ;
   } ;

  -- the family of (eta , RetT) at eta
  PR2 (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X)) (eta : El D (EQ.Htpy D X Y f g))
    : Id (Ty D) (subT D (ext D (EQ.Htpy D X Y f g)) (R2Fam D X Y f g) (sec D (EQ.Htpy D X Y f g) eta)) (EQ.RetT D X Y f) =
    EQ.RetT-ov D (ext D Hg) (wkT D Hg X) (wkT D Hg Y) (EQ.wkF D Hg X Y f) (sec D Hg eta) X (p-sec-T D Hg X eta) Y (p-sec-T D Hg Y eta)
      (IN.FunSec D Hg X Y eta) f (IN.wkF-sec D Hg X Y eta f (IN.FunSec D Hg X Y eta))
   where { Hg : Ty D = EQ.Htpy D X Y f g ; } ;

  -- the family of isEquiv f at g
  P1 (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X))
    : Id (Ty D) (subT D (ext D (Fun D Y X)) (IEFam D X Y f) (sec D (Fun D Y X) g)) (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) =
    Sig-ov D K1 H1 R2 (sec D FBA g) Hg PH (R2Fam D X Y f g) PR
   where {
    FBA : Ty D = Fun D Y X ;
    K1 : Ctx = ext D FBA ;
    A1 : Ty K1 = wkT D FBA X ;
    B1 : Ty K1 = wkT D FBA Y ;
    f1 : El K1 (Fun K1 A1 B1) = EQ.wkF D FBA X Y f ;
    g1 : El K1 (Fun K1 B1 A1) = EQ.qF D Y X ;
    H1 : Ty K1 = EQ.SecH D X Y f ;
    K2 : Ctx = ext K1 H1 ;
    R2 : Ty K2 = EQ.RetT K2 (wkT K1 H1 A1) (wkT K1 H1 B1) (EQ.wkF K1 H1 A1 B1 f1) ;
    Hg : Ty D = EQ.Htpy D X Y f g ;
    PA1 : Id (Ty D) (subT D K1 A1 (sec D FBA g)) X = p-sec-T D FBA X g ;
    PB1 : Id (Ty D) (subT D K1 B1 (sec D FBA g)) Y = p-sec-T D FBA Y g ;
    PF1 : Id (Ty D) (subT D K1 (Fun K1 A1 B1) (sec D FBA g)) (Fun D X Y) = Fun-ov D K1 A1 B1 (sec D FBA g) X PA1 Y PB1 ;
    PG1 : Id (Ty D) (subT D K1 (Fun K1 B1 A1) (sec D FBA g)) (Fun D Y X) = Fun-ov D K1 B1 A1 (sec D FBA g) Y PB1 X PA1 ;
    PH : Id (Ty D) (subT D K1 H1 (sec D FBA g)) Hg =
      EQ.Htpy-ov D K1 A1 B1 f1 g1 (sec D FBA g) X PA1 Y PB1 PF1 f (IN.wkF-sec D FBA X Y g f PF1) PG1 g (IN.qF-sec D Y X g PG1) ;
    s2 : Sub (ext D Hg) K2 = upT D K1 H1 (sec D FBA g) Hg PH ;
    PA2 : Id (Ty (ext D Hg)) (subT (ext D Hg) K2 (wkT K1 H1 A1) s2) (wkT D Hg X) = wkT-ov D K1 H1 A1 (sec D FBA g) Hg PH X PA1 ;
    PB2 : Id (Ty (ext D Hg)) (subT (ext D Hg) K2 (wkT K1 H1 B1) s2) (wkT D Hg Y) = wkT-ov D K1 H1 B1 (sec D FBA g) Hg PH Y PB1 ;
    PF2 : Id (Ty (ext D Hg)) (subT (ext D Hg) K2 (Fun K2 (wkT K1 H1 A1) (wkT K1 H1 B1)) s2) (Fun (ext D Hg) (wkT D Hg X) (wkT D Hg Y)) =
      Fun-ov (ext D Hg) K2 (wkT K1 H1 A1) (wkT K1 H1 B1) s2 (wkT D Hg X) PA2 (wkT D Hg Y) PB2 ;
    PR : Id (Ty (ext D Hg)) (subT (ext D Hg) K2 R2 s2) (R2Fam D X Y f g) =
      EQ.RetT-ov (ext D Hg) K2 (wkT K1 H1 A1) (wkT K1 H1 B1) (EQ.wkF K1 H1 A1 B1 f1) s2 (wkT D Hg X) PA2 (wkT D Hg Y) PB2 PF2
        (EQ.wkF D Hg X Y f) (EQ.wkF-ov D K1 H1 A1 B1 (sec D FBA g) Hg PH X Y PF1 f1 f (IN.wkF-sec D FBA X Y g f PF1) PF2) ;
   } ;

  -- the family of Equiv at f
  PIE (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y))
    : Id (Ty D) (subT D (ext D (Fun D X Y)) (EFam D X Y) (sec D (Fun D X Y) f)) (EQ.isEquiv D X Y f) =
    EQ.isEquiv-ov D K X1 Y1 (EQ.qF D X Y) (sec D (Fun D X Y) f) X (p-sec-T D (Fun D X Y) X f) Y (p-sec-T D (Fun D X Y) Y f)
      (IN.FunSec D (Fun D X Y) X Y f) f (IN.qF-sec D X Y f (IN.FunSec D (Fun D X Y) X Y f))
   where {
    K : Ctx = ext D (Fun D X Y) ;
    X1 : Ty K = wkT D (Fun D X Y) X ;
    Y1 : Ty K = wkT D (Fun D X Y) Y ;
   } ;

  ----------------------------------------------------------------------
  -- (3) packing

  mkR (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (h : El D (Fun D Y X)) (eps : El D (EQ.Htpy D Y X h f)) : El D (EQ.RetT D X Y f) =
    IN.pr D (Fun D Y X) (RetFam D X Y f) h
      (trE D (EQ.Htpy D Y X h f) (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h))
         (sym (Ty D) (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h)) (EQ.Htpy D Y X h f) (PH2 D X Y f h)) eps) ;

  mkI2 (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X)) (eta : El D (EQ.Htpy D X Y f g))
    (r : El D (EQ.RetT D X Y f)) : El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) =
    IN.pr D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) eta
      (trE D (EQ.RetT D X Y f) (subT D (ext D (EQ.Htpy D X Y f g)) (R2Fam D X Y f g) (sec D (EQ.Htpy D X Y f g) eta))
         (sym (Ty D) (subT D (ext D (EQ.Htpy D X Y f g)) (R2Fam D X Y f g) (sec D (EQ.Htpy D X Y f g) eta)) (EQ.RetT D X Y f) (PR2 D X Y f g eta)) r) ;

  mkIE (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X))
    (i2 : El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) : El D (EQ.isEquiv D X Y f) =
    IN.pr D (Fun D Y X) (IEFam D X Y f) g
      (trE D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) (subT D (ext D (Fun D Y X)) (IEFam D X Y f) (sec D (Fun D Y X) g))
         (sym (Ty D) (subT D (ext D (Fun D Y X)) (IEFam D X Y f) (sec D (Fun D Y X) g)) (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) (P1 D X Y f g)) i2) ;

  mkEq (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (ie : El D (EQ.isEquiv D X Y f)) : El D (EQ.Equiv D X Y) =
    IN.pr D (Fun D X Y) (EFam D X Y) f
      (trE D (EQ.isEquiv D X Y f) (subT D (ext D (Fun D X Y)) (EFam D X Y) (sec D (Fun D X Y) f))
         (sym (Ty D) (subT D (ext D (Fun D X Y)) (EFam D X Y) (sec D (Fun D X Y) f)) (EQ.isEquiv D X Y f) (PIE D X Y f)) ie) ;

  mkE (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X)) (eta : El D (EQ.Htpy D X Y f g))
    (h : El D (Fun D Y X)) (eps : El D (EQ.Htpy D Y X h f)) : El D (EQ.Equiv D X Y) =
    mkEq D X Y f (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))) ;

  ----------------------------------------------------------------------
  -- (4) unpacking, and eta

  module UE (D : Ctx) (X Y : Ty D) (e : El D (EQ.Equiv D X Y)) {
    f : El D (Fun D X Y) = IN.fst D (Fun D X Y) (EFam D X Y) e ;
    ie : El D (EQ.isEquiv D X Y f) =
      trE D (subT D (ext D (Fun D X Y)) (EFam D X Y) (sec D (Fun D X Y) f)) (EQ.isEquiv D X Y f) (PIE D X Y f) (IN.snd D (Fun D X Y) (EFam D X Y) e) ;
    g : El D (Fun D Y X) = IN.fst D (Fun D Y X) (IEFam D X Y f) ie ;
    i2 : El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) =
      trE D (subT D (ext D (Fun D Y X)) (IEFam D X Y f) (sec D (Fun D Y X) g)) (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) (P1 D X Y f g)
        (IN.snd D (Fun D Y X) (IEFam D X Y f) ie) ;
    eta : El D (EQ.Htpy D X Y f g) = IN.fst D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) i2 ;
    rt : El D (EQ.RetT D X Y f) =
      trE D (subT D (ext D (EQ.Htpy D X Y f g)) (R2Fam D X Y f g) (sec D (EQ.Htpy D X Y f g) eta)) (EQ.RetT D X Y f) (PR2 D X Y f g eta)
        (IN.snd D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) i2) ;
    h : El D (Fun D Y X) = IN.fst D (Fun D Y X) (RetFam D X Y f) rt ;
    eps : El D (EQ.Htpy D Y X h f) =
      trE D (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h)) (EQ.Htpy D Y X h f) (PH2 D X Y f h)
        (IN.snd D (Fun D Y X) (RetFam D X Y f) rt) ;

    c4 : Id (El D (EQ.RetT D X Y f)) (mkR D X Y f h eps) rt =
      trans (El D (EQ.RetT D X Y f)) (mkR D X Y f h eps) (IN.pr D (Fun D Y X) (RetFam D X Y f) h (IN.snd D (Fun D Y X) (RetFam D X Y f) rt)) rt
        (ap (El D (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h))) (El D (EQ.RetT D X Y f))
            (\ v -> IN.pr D (Fun D Y X) (RetFam D X Y f) h v)
            (trE D (EQ.Htpy D Y X h f) (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h))
               (sym (Ty D) (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h)) (EQ.Htpy D Y X h f) (PH2 D X Y f h)) eps)
            (IN.snd D (Fun D Y X) (RetFam D X Y f) rt)
            (PJ.trBack D (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h)) (EQ.Htpy D Y X h f)
               (sym (Ty D) (subT D (ext D (Fun D Y X)) (RetFam D X Y f) (sec D (Fun D Y X) h)) (EQ.Htpy D Y X h f) (PH2 D X Y f h)) (PH2 D X Y f h)
               (IN.snd D (Fun D Y X) (RetFam D X Y f) rt)))
        (PJ.etaS D (Fun D Y X) (RetFam D X Y f) rt) ;

    c3 : Id (El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) (mkI2 D X Y f g eta (mkR D X Y f h eps)) i2 =
      trans (El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) (mkI2 D X Y f g eta (mkR D X Y f h eps)) (mkI2 D X Y f g eta rt) i2
        (ap (El D (EQ.RetT D X Y f)) (El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) (\ v -> mkI2 D X Y f g eta v) (mkR D X Y f h eps) rt c4)
        (trans (El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) (mkI2 D X Y f g eta rt)
           (IN.pr D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) eta (IN.snd D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) i2)) i2
           (ap (El D S3) (El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) (\ v -> IN.pr D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) eta v)
               (trE D (EQ.RetT D X Y f) S3 (sym (Ty D) S3 (EQ.RetT D X Y f) (PR2 D X Y f g eta)) rt)
               (IN.snd D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) i2)
               (PJ.trBack D S3 (EQ.RetT D X Y f) (sym (Ty D) S3 (EQ.RetT D X Y f) (PR2 D X Y f g eta)) (PR2 D X Y f g eta) (IN.snd D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) i2)))
           (PJ.etaS D (EQ.Htpy D X Y f g) (R2Fam D X Y f g) i2))
     where { S3 : Ty D = subT D (ext D (EQ.Htpy D X Y f g)) (R2Fam D X Y f g) (sec D (EQ.Htpy D X Y f g) eta) ; } ;

    c2 : Id (El D (EQ.isEquiv D X Y f)) (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))) ie =
      trans (El D (EQ.isEquiv D X Y f)) (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))) (mkIE D X Y f g i2) ie
        (ap (El D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g))) (El D (EQ.isEquiv D X Y f)) (\ v -> mkIE D X Y f g v) (mkI2 D X Y f g eta (mkR D X Y f h eps)) i2 c3)
        (trans (El D (EQ.isEquiv D X Y f)) (mkIE D X Y f g i2) (IN.pr D (Fun D Y X) (IEFam D X Y f) g (IN.snd D (Fun D Y X) (IEFam D X Y f) ie)) ie
           (ap (El D S2) (El D (EQ.isEquiv D X Y f)) (\ v -> IN.pr D (Fun D Y X) (IEFam D X Y f) g v)
               (trE D (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) S2 (sym (Ty D) S2 (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) (P1 D X Y f g)) i2)
               (IN.snd D (Fun D Y X) (IEFam D X Y f) ie)
               (PJ.trBack D S2 (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) (sym (Ty D) S2 (SS.Sig D (EQ.Htpy D X Y f g) (R2Fam D X Y f g)) (P1 D X Y f g)) (P1 D X Y f g)
                  (IN.snd D (Fun D Y X) (IEFam D X Y f) ie)))
           (PJ.etaS D (Fun D Y X) (IEFam D X Y f) ie))
     where { S2 : Ty D = subT D (ext D (Fun D Y X)) (IEFam D X Y f) (sec D (Fun D Y X) g) ; } ;

    etaE : Id (El D (EQ.Equiv D X Y)) (mkE D X Y f g eta h eps) e =
      trans (El D (EQ.Equiv D X Y)) (mkE D X Y f g eta h eps) (mkEq D X Y f ie) e
        (ap (El D (EQ.isEquiv D X Y f)) (El D (EQ.Equiv D X Y)) (\ v -> mkEq D X Y f v) (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))) ie c2)
        (trans (El D (EQ.Equiv D X Y)) (mkEq D X Y f ie) (IN.pr D (Fun D X Y) (EFam D X Y) f (IN.snd D (Fun D X Y) (EFam D X Y) e)) e
           (ap (El D S1) (El D (EQ.Equiv D X Y)) (\ v -> IN.pr D (Fun D X Y) (EFam D X Y) f v)
               (trE D (EQ.isEquiv D X Y f) S1 (sym (Ty D) S1 (EQ.isEquiv D X Y f) (PIE D X Y f)) ie)
               (IN.snd D (Fun D X Y) (EFam D X Y) e)
               (PJ.trBack D S1 (EQ.isEquiv D X Y f) (sym (Ty D) S1 (EQ.isEquiv D X Y f) (PIE D X Y f)) (PIE D X Y f) (IN.snd D (Fun D X Y) (EFam D X Y) e)))
           (PJ.etaS D (Fun D X Y) (EFam D X Y) e))
     where { S1 : Ty D = subT D (ext D (Fun D X Y)) (EFam D X Y) (sec D (Fun D X Y) f) ; } ;
  } ;

  ----------------------------------------------------------------------
  -- (5) packing is stable

  module MN (D' D : Ctx) (sg : Sub D' D) (X Y : Ty D) (X' Y' : Ty D')
    (PX : Id (Ty D') (subT D' D X sg) X') (PY : Id (Ty D') (subT D' D Y sg) Y')
    (f : El D (Fun D X Y)) (f' : El D' (Fun D' X' Y'))
    (Pf : Ov D' D (Fun D X Y) sg (Fun D' X' Y') (Fun-ov D' D X Y sg X' PX Y' PY) f f')
    (g : El D (Fun D Y X)) (g' : El D' (Fun D' Y' X'))
    (Pg : Ov D' D (Fun D Y X) sg (Fun D' Y' X') (Fun-ov D' D Y X sg Y' PY X' PX) g g')
    (eta : El D (EQ.Htpy D X Y f g)) (eta' : El D' (EQ.Htpy D' X' Y' f' g'))
    (Peta : Ov D' D (EQ.Htpy D X Y f g) sg (EQ.Htpy D' X' Y' f' g')
              (EQ.Htpy-ov D' D X Y f g sg X' PX Y' PY (Fun-ov D' D X Y sg X' PX Y' PY) f' Pf (Fun-ov D' D Y X sg Y' PY X' PX) g' Pg) eta eta')
    (h : El D (Fun D Y X)) (h' : El D' (Fun D' Y' X'))
    (Ph : Ov D' D (Fun D Y X) sg (Fun D' Y' X') (Fun-ov D' D Y X sg Y' PY X' PX) h h')
    (eps : El D (EQ.Htpy D Y X h f)) (eps' : El D' (EQ.Htpy D' Y' X' h' f'))
    (Peps : Ov D' D (EQ.Htpy D Y X h f) sg (EQ.Htpy D' Y' X' h' f')
              (EQ.Htpy-ov D' D Y X h f sg Y' PY X' PX (Fun-ov D' D Y X sg Y' PY X' PX) h' Ph (Fun-ov D' D X Y sg X' PX Y' PY) f' Pf) eps eps') {
    PF : Id (Ty D') (subT D' D (Fun D X Y) sg) (Fun D' X' Y') = Fun-ov D' D X Y sg X' PX Y' PY ;
    PG : Id (Ty D') (subT D' D (Fun D Y X) sg) (Fun D' Y' X') = Fun-ov D' D Y X sg Y' PY X' PX ;
    FYX : Ty D = Fun D Y X ;
    FYX' : Ty D' = Fun D' Y' X' ;
    Hg : Ty D = EQ.Htpy D X Y f g ;
    Hg' : Ty D' = EQ.Htpy D' X' Y' f' g' ;
    PHg : Id (Ty D') (subT D' D Hg sg) Hg' = EQ.Htpy-ov D' D X Y f g sg X' PX Y' PY PF f' Pf PG g' Pg ;
    He : Ty D = EQ.Htpy D Y X h f ;
    He' : Ty D' = EQ.Htpy D' Y' X' h' f' ;
    PHe : Id (Ty D') (subT D' D He sg) He' = EQ.Htpy-ov D' D Y X h f sg Y' PY X' PX PG h' Ph PF f' Pf ;

    -- RetT
    RF : Ty (ext D FYX) = RetFam D X Y f ;
    RF' : Ty (ext D' FYX') = RetFam D' X' Y' f' ;
    RFo : Id (Ty (ext D' FYX')) (subT (ext D' FYX') (ext D FYX) RF (upT D' D FYX sg FYX' PG)) RF' = RetFam-ov D' D X Y f sg X' PX Y' PY PF f' Pf ;
    PRt : Id (Ty D') (subT D' D (EQ.RetT D X Y f) sg) (EQ.RetT D' X' Y' f') = Sig-ov D' D FYX RF sg FYX' PG RF' RFo ;
    OR : Ov D' D (EQ.RetT D X Y f) sg (EQ.RetT D' X' Y' f') PRt (mkR D X Y f h eps) (mkR D' X' Y' f' h' eps') =
      PJ.prO D' D FYX RF sg FYX' PG RF' RFo h h' Ph
        (trE D He (subT D (ext D FYX) RF (sec D FYX h)) (sym (Ty D) (subT D (ext D FYX) RF (sec D FYX h)) He (PH2 D X Y f h)) eps)
        (trE D' He' (subT D' (ext D' FYX') RF' (sec D' FYX' h')) (sym (Ty D') (subT D' (ext D' FYX') RF' (sec D' FYX' h')) He' (PH2 D' X' Y' f' h')) eps')
        (ovTr D' D He (subT D (ext D FYX) RF (sec D FYX h)) (sym (Ty D) (subT D (ext D FYX) RF (sec D FYX h)) He (PH2 D X Y f h)) sg
           He' (subT D' (ext D' FYX') RF' (sec D' FYX' h')) (sym (Ty D') (subT D' (ext D' FYX') RF' (sec D' FYX' h')) He' (PH2 D' X' Y' f' h'))
           PHe (PJ.secPath D' D FYX RF sg FYX' PG RF' RFo h h' Ph) eps eps' Peps) ;

    -- (eta , RetT)
    R2 : Ty (ext D Hg) = R2Fam D X Y f g ;
    R2' : Ty (ext D' Hg') = R2Fam D' X' Y' f' g' ;
    R2o : Id (Ty (ext D' Hg')) (subT (ext D' Hg') (ext D Hg) R2 (upT D' D Hg sg Hg' PHg)) R2' = R2Fam-ov D' D X Y f g sg X' PX Y' PY PF f' Pf PG g' Pg ;
    PI2 : Id (Ty D') (subT D' D (SS.Sig D Hg R2) sg) (SS.Sig D' Hg' R2') = Sig-ov D' D Hg R2 sg Hg' PHg R2' R2o ;
    OI2 : Ov D' D (SS.Sig D Hg R2) sg (SS.Sig D' Hg' R2') PI2 (mkI2 D X Y f g eta (mkR D X Y f h eps)) (mkI2 D' X' Y' f' g' eta' (mkR D' X' Y' f' h' eps')) =
      PJ.prO D' D Hg R2 sg Hg' PHg R2' R2o eta eta' Peta
        (trE D (EQ.RetT D X Y f) (subT D (ext D Hg) R2 (sec D Hg eta)) (sym (Ty D) (subT D (ext D Hg) R2 (sec D Hg eta)) (EQ.RetT D X Y f) (PR2 D X Y f g eta)) (mkR D X Y f h eps))
        (trE D' (EQ.RetT D' X' Y' f') (subT D' (ext D' Hg') R2' (sec D' Hg' eta')) (sym (Ty D') (subT D' (ext D' Hg') R2' (sec D' Hg' eta')) (EQ.RetT D' X' Y' f') (PR2 D' X' Y' f' g' eta')) (mkR D' X' Y' f' h' eps'))
        (ovTr D' D (EQ.RetT D X Y f) (subT D (ext D Hg) R2 (sec D Hg eta)) (sym (Ty D) (subT D (ext D Hg) R2 (sec D Hg eta)) (EQ.RetT D X Y f) (PR2 D X Y f g eta)) sg
           (EQ.RetT D' X' Y' f') (subT D' (ext D' Hg') R2' (sec D' Hg' eta')) (sym (Ty D') (subT D' (ext D' Hg') R2' (sec D' Hg' eta')) (EQ.RetT D' X' Y' f') (PR2 D' X' Y' f' g' eta'))
           PRt (PJ.secPath D' D Hg R2 sg Hg' PHg R2' R2o eta eta' Peta) (mkR D X Y f h eps) (mkR D' X' Y' f' h' eps') OR) ;

    -- isEquiv
    IF : Ty (ext D FYX) = IEFam D X Y f ;
    IF' : Ty (ext D' FYX') = IEFam D' X' Y' f' ;
    IFo : Id (Ty (ext D' FYX')) (subT (ext D' FYX') (ext D FYX) IF (upT D' D FYX sg FYX' PG)) IF' = IEFam-ov D' D X Y f sg X' PX Y' PY PF f' Pf ;
    PIq : Id (Ty D') (subT D' D (EQ.isEquiv D X Y f) sg) (EQ.isEquiv D' X' Y' f') = Sig-ov D' D FYX IF sg FYX' PG IF' IFo ;
    OIE : Ov D' D (EQ.isEquiv D X Y f) sg (EQ.isEquiv D' X' Y' f') PIq
            (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))) (mkIE D' X' Y' f' g' (mkI2 D' X' Y' f' g' eta' (mkR D' X' Y' f' h' eps'))) =
      PJ.prO D' D FYX IF sg FYX' PG IF' IFo g g' Pg
        (trE D (SS.Sig D Hg R2) (subT D (ext D FYX) IF (sec D FYX g)) (sym (Ty D) (subT D (ext D FYX) IF (sec D FYX g)) (SS.Sig D Hg R2) (P1 D X Y f g))
           (mkI2 D X Y f g eta (mkR D X Y f h eps)))
        (trE D' (SS.Sig D' Hg' R2') (subT D' (ext D' FYX') IF' (sec D' FYX' g')) (sym (Ty D') (subT D' (ext D' FYX') IF' (sec D' FYX' g')) (SS.Sig D' Hg' R2') (P1 D' X' Y' f' g'))
           (mkI2 D' X' Y' f' g' eta' (mkR D' X' Y' f' h' eps')))
        (ovTr D' D (SS.Sig D Hg R2) (subT D (ext D FYX) IF (sec D FYX g)) (sym (Ty D) (subT D (ext D FYX) IF (sec D FYX g)) (SS.Sig D Hg R2) (P1 D X Y f g)) sg
           (SS.Sig D' Hg' R2') (subT D' (ext D' FYX') IF' (sec D' FYX' g')) (sym (Ty D') (subT D' (ext D' FYX') IF' (sec D' FYX' g')) (SS.Sig D' Hg' R2') (P1 D' X' Y' f' g'))
           PI2 (PJ.secPath D' D FYX IF sg FYX' PG IF' IFo g g' Pg)
           (mkI2 D X Y f g eta (mkR D X Y f h eps)) (mkI2 D' X' Y' f' g' eta' (mkR D' X' Y' f' h' eps')) OI2) ;

    -- Equiv
    FXY : Ty D = Fun D X Y ;
    FXY' : Ty D' = Fun D' X' Y' ;
    EF : Ty (ext D FXY) = EFam D X Y ;
    EF' : Ty (ext D' FXY') = EFam D' X' Y' ;
    EFo : Id (Ty (ext D' FXY')) (subT (ext D' FXY') (ext D FXY) EF (upT D' D FXY sg FXY' PF)) EF' = EFam-ov D' D X Y sg X' PX Y' PY ;
    PE : Id (Ty D') (subT D' D (EQ.Equiv D X Y) sg) (EQ.Equiv D' X' Y') = Sig-ov D' D FXY EF sg FXY' PF EF' EFo ;
    OE : Ov D' D (EQ.Equiv D X Y) sg (EQ.Equiv D' X' Y') PE (mkE D X Y f g eta h eps) (mkE D' X' Y' f' g' eta' h' eps') =
      PJ.prO D' D FXY EF sg FXY' PF EF' EFo f f' Pf
        (trE D (EQ.isEquiv D X Y f) (subT D (ext D FXY) EF (sec D FXY f)) (sym (Ty D) (subT D (ext D FXY) EF (sec D FXY f)) (EQ.isEquiv D X Y f) (PIE D X Y f))
           (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))))
        (trE D' (EQ.isEquiv D' X' Y' f') (subT D' (ext D' FXY') EF' (sec D' FXY' f')) (sym (Ty D') (subT D' (ext D' FXY') EF' (sec D' FXY' f')) (EQ.isEquiv D' X' Y' f') (PIE D' X' Y' f'))
           (mkIE D' X' Y' f' g' (mkI2 D' X' Y' f' g' eta' (mkR D' X' Y' f' h' eps'))))
        (ovTr D' D (EQ.isEquiv D X Y f) (subT D (ext D FXY) EF (sec D FXY f)) (sym (Ty D) (subT D (ext D FXY) EF (sec D FXY f)) (EQ.isEquiv D X Y f) (PIE D X Y f)) sg
           (EQ.isEquiv D' X' Y' f') (subT D' (ext D' FXY') EF' (sec D' FXY' f')) (sym (Ty D') (subT D' (ext D' FXY') EF' (sec D' FXY' f')) (EQ.isEquiv D' X' Y' f') (PIE D' X' Y' f'))
           PIq (PJ.secPath D' D FXY EF sg FXY' PF EF' EFo f f' Pf)
           (mkIE D X Y f g (mkI2 D X Y f g eta (mkR D X Y f h eps))) (mkIE D' X' Y' f' g' (mkI2 D' X' Y' f' g' eta' (mkR D' X' Y' f' h' eps'))) OIE) ;
  } ;
} ;
