-- CwFDer.seg (M1 step 3, S4 toolkit): two derived homotopies, in a CwF
-- with Pi, Sigma, Swan Id and naive function extensionality NF.
--
-- Informal text.  Write H y for a homotopy H : Htpy u v at y (htpyAt).
-- (1) secRet: from hs : f (s y) = y and hr : r (f x) = x,
--       f (r y) = f (r (f (s y))) = f (s y) = y
--     (ap f (ap r (sym (hs y))), ap f (hr (s y)), hs y).
-- (2) fibRet: if every fibre of u is contractible and h : u (v y) = y, then
--     v (u x) = x: (v (u x) , h (u x)) and (x , refl) lie in the fibre of u
--     over u x, so they are joined; apply the first projection.

open Base ;

module Der (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module DJ = CwFId.SwanId[l, C].Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;
  module QC = CwFQinvC.QinvC[l, C, PS, SS, IJ, NF] ;

  -- the identity type of a homotopy at a point
  IdAt (D : Ctx) (X Y : Ty D) (u : El D (Fun D X Y)) (v : El D (Fun D Y X)) : Ty (ext D Y) =
    IJ.IdT (ext D Y) (wkT D Y Y)
      (app (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (app (ext D Y) (wkT D Y Y) (wkT D Y X) (EQ.wkF D Y Y X v) (q D Y))) (q D Y) ;

  PIdAt (D : Ctx) (X Y : Ty D) (u : El D (Fun D X Y)) (v : El D (Fun D Y X)) (y : El D Y)
    : Id (Ty D) (subT D (ext D Y) (IdAt D X Y u v) (sec D Y y)) (IJ.IdT D Y (app D X Y u (app D Y X v y)) y) =
    Id-ov D (ext D Y) (wkT D Y Y)
      (app (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (app (ext D Y) (wkT D Y Y) (wkT D Y X) (EQ.wkF D Y Y X v) (q D Y))) (q D Y)
      (sec D Y y) Y (p-sec-T D Y Y y) (app D X Y u (app D Y X v y)) y
      (app-ov D (ext D Y) (wkT D Y X) (wkT D Y Y) (sec D Y y) X (p-sec-T D Y X y) Y (p-sec-T D Y Y y) (IN.FunSec D Y X Y y)
         (EQ.wkF D Y X Y u) u (IN.wkF-sec D Y X Y y u (IN.FunSec D Y X Y y))
         (app (ext D Y) (wkT D Y Y) (wkT D Y X) (EQ.wkF D Y Y X v) (q D Y)) (app D Y X v y)
         (app-ov D (ext D Y) (wkT D Y Y) (wkT D Y X) (sec D Y y) Y (p-sec-T D Y Y y) X (p-sec-T D Y X y) (IN.FunSec D Y Y X y)
            (EQ.wkF D Y Y X v) v (IN.wkF-sec D Y Y X y v (IN.FunSec D Y Y X y)) (q D Y) y (IN.q-secO D Y y (p-sec-T D Y Y y))))
      (IN.q-secO D Y y (p-sec-T D Y Y y)) ;

  htpyAt (D : Ctx) (X Y : Ty D) (u : El D (Fun D X Y)) (v : El D (Fun D Y X)) (H : El D (EQ.Htpy D X Y u v)) (y : El D Y)
    : El D (IJ.IdT D Y (app D X Y u (app D Y X v y)) y) =
    trE D (subT D (ext D Y) (IdAt D X Y u v) (sec D Y y)) (IJ.IdT D Y (app D X Y u (app D Y X v y)) y) (PIdAt D X Y u v y)
      (IN.appD D Y (IdAt D X Y u v) H y) ;

  -- a homotopy weakened
  wkFov (D : Ctx) (Z A B : Ty D) (f : El D (Fun D A B))
    : Ov (ext D Z) D (Fun D A B) (p D Z) (Fun (ext D Z) (wkT D Z A) (wkT D Z B)) (EQ.wkFP D Z A B) f (EQ.wkF D Z A B f) = refl (EQ.wkF D Z A B f) ;

  wkH (D : Ctx) (Z X Y : Ty D) (u : El D (Fun D X Y)) (v : El D (Fun D Y X)) (H : El D (EQ.Htpy D X Y u v))
    : El (ext D Z) (EQ.Htpy (ext D Z) (wkT D Z X) (wkT D Z Y) (EQ.wkF D Z X Y u) (EQ.wkF D Z Y X v)) =
    trE (ext D Z) (wkT D Z (EQ.Htpy D X Y u v)) (EQ.Htpy (ext D Z) (wkT D Z X) (wkT D Z Y) (EQ.wkF D Z X Y u) (EQ.wkF D Z Y X v))
      (EQ.Htpy-ov (ext D Z) D X Y u v (p D Z) (wkT D Z X) (refl (wkT D Z X)) (wkT D Z Y) (refl (wkT D Z Y))
         (EQ.wkFP D Z X Y) (EQ.wkF D Z X Y u) (wkFov D Z X Y u) (EQ.wkFP D Z Y X) (EQ.wkF D Z Y X v) (wkFov D Z Y X v))
      (wkE D Z (EQ.Htpy D X Y u v) H) ;

  ----------------------------------------------------------------------
  -- (1) secRet: f r ~ id

  module SRm (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (s r : El D (Fun D Y X))
    (hs : El D (EQ.Htpy D X Y f s)) (hr : El D (EQ.Htpy D Y X r f)) {
    D' : Ctx = ext D Y ;
    X' : Ty D' = wkT D Y X ;
    Y' : Ty D' = wkT D Y Y ;
    f' : El D' (Fun D' X' Y') = EQ.wkF D Y X Y f ;
    s' : El D' (Fun D' Y' X') = EQ.wkF D Y Y X s ;
    r' : El D' (Fun D' Y' X') = EQ.wkF D Y Y X r ;
    hs' : El D' (EQ.Htpy D' X' Y' f' s') = wkH D Y X Y f s hs ;
    hr' : El D' (EQ.Htpy D' Y' X' r' f') = wkH D Y Y X r f hr ;
    y : El D' Y' = q D Y ;
    sy : El D' X' = app D' Y' X' s' y ;
    fsy : El D' Y' = app D' X' Y' f' sy ;

    hsy : El D' (IJ.IdT D' Y' fsy y) = htpyAt D' X' Y' f' s' hs' y ;
    e1 : El D' (IJ.IdT D' Y' (app D' X' Y' f' (app D' Y' X' r' y)) (app D' X' Y' f' (app D' Y' X' r' fsy))) =
      PT.apM D' X' Y' (bod D' X' (wkT D' X' Y') f') (app D' Y' X' r' y) (app D' Y' X' r' fsy)
        (PT.apM D' Y' X' (bod D' Y' (wkT D' Y' X') r') y fsy (PT.symM D' Y' fsy y hsy)) ;
    e2 : El D' (IJ.IdT D' Y' (app D' X' Y' f' (app D' Y' X' r' fsy)) fsy) =
      PT.apM D' X' Y' (bod D' X' (wkT D' X' Y') f') (app D' Y' X' r' fsy) sy (htpyAt D' Y' X' r' f' hr' sy) ;

    body : El D' (IJ.IdT D' Y' (app D' X' Y' f' (app D' Y' X' r' y)) y) =
      PT.transM D' Y' (app D' X' Y' f' (app D' Y' X' r' y)) fsy y
        (PT.transM D' Y' (app D' X' Y' f' (app D' Y' X' r' y)) (app D' X' Y' f' (app D' Y' X' r' fsy)) fsy e1 e2)
        hsy ;

    secRet : El D (EQ.Htpy D X Y f r) = lam D Y (IdAt D X Y f r) body ;
  } ;

  -- lift p after the lift of sec w is the identity
  liftSecId (D : Ctx) (Z A : Ty D) (w : El D Z)
    : Id (Sub (ext D A) (ext D A))
         (o (ext D A) (ext (ext D Z) (wkT D Z A)) (ext D A) (lift (ext D Z) D A (p D Z)) (upT D (ext D Z) (wkT D Z A) (sec D Z w) A (p-sec-T D Z A w)))
         (id (ext D A)) =
    IN.ext-eq (ext D A) D A (o (ext D A) EZ (ext D A) LP UP) (id (ext D A))
      (calc (Sub (ext D A) D) {
          o (ext D A) (ext D A) D (p D A) (o (ext D A) EZ (ext D A) LP UP)
        =< sym (Sub (ext D A) D) (o (ext D A) EZ D (o EZ (ext D A) D (p D A) LP) UP) (o (ext D A) (ext D A) D (p D A) (o (ext D A) EZ (ext D A) LP UP))
              (o-assoc (ext D A) EZ (ext D A) D (p D A) LP UP) >
          o (ext D A) EZ D (o EZ (ext D A) D (p D A) LP) UP
        =< ap (Sub EZ D) (Sub (ext D A) D) (\ t -> o (ext D A) EZ D t UP) (o EZ (ext D A) D (p D A) LP) (o EZ (ext D Z) D (p D Z) (p (ext D Z) (wkT D Z A))) (p-lift (ext D Z) D A (p D Z)) >
          o (ext D A) EZ D (o EZ (ext D Z) D (p D Z) (p (ext D Z) (wkT D Z A))) UP
        =< o-assoc (ext D A) EZ (ext D Z) D (p D Z) (p (ext D Z) (wkT D Z A)) UP >
          o (ext D A) (ext D Z) D (p D Z) (o (ext D A) EZ (ext D Z) (p (ext D Z) (wkT D Z A)) UP)
        =< ap (Sub (ext D A) (ext D Z)) (Sub (ext D A) D) (\ t -> o (ext D A) (ext D Z) D (p D Z) t) (o (ext D A) EZ (ext D Z) (p (ext D Z) (wkT D Z A)) UP) (o (ext D A) D (ext D Z) (sec D Z w) (p D A))
              (CwFCoS.CoS[l, C, PS, SS, IJ].pUp D (ext D Z) (wkT D Z A) (sec D Z w) A (p-sec-T D Z A w)) >
          o (ext D A) (ext D Z) D (p D Z) (o (ext D A) D (ext D Z) (sec D Z w) (p D A))
        =< sym (Sub (ext D A) D) (o (ext D A) D D (o D (ext D Z) D (p D Z) (sec D Z w)) (p D A)) (o (ext D A) (ext D Z) D (p D Z) (o (ext D A) D (ext D Z) (sec D Z w) (p D A)))
              (o-assoc (ext D A) D (ext D Z) D (p D Z) (sec D Z w) (p D A)) >
          o (ext D A) D D (o D (ext D Z) D (p D Z) (sec D Z w)) (p D A)
        =< ap (Sub D D) (Sub (ext D A) D) (\ t -> o (ext D A) D D t (p D A)) (o D (ext D Z) D (p D Z) (sec D Z w)) (id D) (p-sec D Z w) >
          o (ext D A) D D (id D) (p D A)
        =< o-idl (ext D A) D (p D A) >
          p D A
        =< sym (Sub (ext D A) D) (o (ext D A) (ext D A) D (p D A) (id (ext D A))) (p D A) (o-idr (ext D A) D (p D A)) >
          o (ext D A) (ext D A) D (p D A) (id (ext D A)) })
      (wkT D A A) (q D A)
      P1
      (JP.ovO (ext D A) EZ (ext D A) (wkT D A A) LP UP (wkT (ext D Z) (wkT D Z A) (wkT D Z A)) W1 (wkT D A A) W2 P1
         (q D A) (q (ext D Z) (wkT D Z A)) (q D A)
         (q-ov (ext D Z) D A (p D Z) (wkT D Z A) (refl (wkT D Z A)) W1)
         (q-ov D (ext D Z) (wkT D Z A) (sec D Z w) A (p-sec-T D Z A w) W2))
      (subT-id (ext D A) (wkT D A A)) (subt-id (ext D A) (wkT D A A) (q D A))
   where {
    EZ : Ctx = ext (ext D Z) (wkT D Z A) ;
    LP : Sub EZ (ext D A) = lift (ext D Z) D A (p D Z) ;
    UP : Sub (ext D A) EZ = upT D (ext D Z) (wkT D Z A) (sec D Z w) A (p-sec-T D Z A w) ;
    W1 : Id (Ty EZ) (subT EZ (ext D A) (wkT D A A) LP) (wkT (ext D Z) (wkT D Z A) (wkT D Z A)) = p-lift-T (ext D Z) D A A (p D Z) ;
    W2 : Id (Ty (ext D A)) (subT (ext D A) EZ (wkT (ext D Z) (wkT D Z A) (wkT D Z A)) UP) (wkT D A A) = wkT-ov D (ext D Z) (wkT D Z A) (wkT D Z A) (sec D Z w) A (p-sec-T D Z A w) A (p-sec-T D Z A w) ;
    P1 : Id (Ty (ext D A)) (subT (ext D A) (ext D A) (wkT D A A) (o (ext D A) EZ (ext D A) LP UP)) (wkT D A A) =
      trans (Ty (ext D A)) (subT (ext D A) (ext D A) (wkT D A A) (o (ext D A) EZ (ext D A) LP UP)) (subT (ext D A) EZ (subT EZ (ext D A) (wkT D A A) LP) UP) (wkT D A A)
        (subT-o (ext D A) EZ (ext D A) (wkT D A A) LP UP)
        (trans (Ty (ext D A)) (subT (ext D A) EZ (subT EZ (ext D A) (wkT D A A) LP) UP) (subT (ext D A) EZ (wkT (ext D Z) (wkT D Z A) (wkT D Z A)) UP) (wkT D A A)
           (ap (Ty EZ) (Ty (ext D A)) (\ Y -> subT (ext D A) EZ Y UP) (subT EZ (ext D A) (wkT D A A) LP) (wkT (ext D Z) (wkT D Z A) (wkT D Z A)) W1) W2) ;
   } ;

  ----------------------------------------------------------------------
  -- (2) fibRet: v u ~ id from contractible fibres of u and u v ~ id

  module FRm (D : Ctx) (X Y : Ty D) (u : El D (Fun D X Y)) (v : El D (Fun D Y X))
    (k : El (ext D Y) (EQ.isContr (ext D Y) (QB.FibE (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (q D Y))))
    (h : El D (EQ.Htpy D X Y u v)) {
    D' : Ctx = ext D X ;
    X' : Ty D' = wkT D X X ;
    Y' : Ty D' = wkT D X Y ;
    u' : El D' (Fun D' X' Y') = EQ.wkF D X X Y u ;
    v' : El D' (Fun D' Y' X') = EQ.wkF D X Y X v ;
    h' : El D' (EQ.Htpy D' X' Y' u' v') = wkH D X X Y u v h ;
    x : El D' X' = q D X ;
    ux : El D' Y' = app D' X' Y' u' x ;

    -- the fibre of u over u x
    sx : Sub D' (ext D Y) = extS D' D Y (p D X) ux ;
    FB : Ty D' = QB.FibE D' X' Y' u' ux ;
    PFB : Id (Ty D') (subT D' (ext D Y) (QB.FibE (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (q D Y)) sx) FB =
      QB.FibE-ov D' (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (q D Y) sx X' Y'
        (IN.wkT-extS D' D Y X (p D X) ux) (IN.wkT-extS D' D Y Y (p D X) ux) (QC.PFs D' D Y X Y (p D X) ux) u'
        (trans (El D' (Fun D' X' Y')) (trE D' (subT D' (ext D Y) (Fun (ext D Y) (wkT D Y X) (wkT D Y Y)) sx) (Fun D' X' Y') (QC.PFs D' D Y X Y (p D X) ux)
                                        (subt D' (ext D Y) (Fun (ext D Y) (wkT D Y X) (wkT D Y Y)) (EQ.wkF D Y X Y u) sx))
           (QC.fAl D' D (p D X) X Y u) u'
           (QC.wkFAt D' D Y X Y u (p D X) ux)
           (trE-irr D' (wkT D X (Fun D X Y)) (Fun D' X' Y') (Fun-ov D' D X Y (p D X) X' (refl X') Y' (refl Y')) (EQ.wkFP D X X Y) (wkE D X (Fun D X Y) u)))
        ux (JP.q-extS D' D Y (p D X) ux (IN.wkT-extS D' D Y Y (p D X) ux)) ;
    kx : El D' (EQ.isContr D' FB) =
      trE D' (subT D' (ext D Y) (EQ.isContr (ext D Y) (QB.FibE (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (q D Y))) sx) (EQ.isContr D' FB)
        (EQ.isContr-ov D' (ext D Y) (QB.FibE (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (q D Y)) sx FB PFB)
        (subt D' (ext D Y) (EQ.isContr (ext D Y) (QB.FibE (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y u) (q D Y))) k sx) ;

    -- the family of the fibre at a point
    Fm : Ty (ext D' X') = QB.FamE D' X' Y' u' ux ;
    PFm (a : El D' X') : Id (Ty D') (subT D' (ext D' X') Fm (sec D' X' a)) (IJ.IdT D' Y' (app D' X' Y' u' a) ux) =
      Id-ov D' (ext D' X') (wkT D' X' Y') (app (ext D' X') (wkT D' X' X') (wkT D' X' Y') (EQ.wkF D' X' X' Y' u') (q D' X')) (wkE D' X' Y' ux)
        (sec D' X' a) Y' (p-sec-T D' X' Y' a) (app D' X' Y' u' a) ux
        (app-ov D' (ext D' X') (wkT D' X' X') (wkT D' X' Y') (sec D' X' a) X' (p-sec-T D' X' X' a) Y' (p-sec-T D' X' Y' a) (IN.FunSec D' X' X' Y' a)
           (EQ.wkF D' X' X' Y' u') u' (IN.wkF-sec D' X' X' Y' a u' (IN.FunSec D' X' X' Y' a)) (q D' X') a (IN.q-secO D' X' a (p-sec-T D' X' X' a)))
        (IN.wkE-sec D' X' Y' a ux (p-sec-T D' X' Y' a)) ;

    vux : El D' X' = app D' Y' X' v' ux ;
    pb1 : El D' (subT D' (ext D' X') Fm (sec D' X' vux)) =
      trE D' (IJ.IdT D' Y' (app D' X' Y' u' vux) ux) (subT D' (ext D' X') Fm (sec D' X' vux)) (sym (Ty D') (subT D' (ext D' X') Fm (sec D' X' vux)) (IJ.IdT D' Y' (app D' X' Y' u' vux) ux) (PFm vux))
        (htpyAt D' X' Y' u' v' h' ux) ;
    pb2 : El D' (subT D' (ext D' X') Fm (sec D' X' x)) =
      trE D' (IJ.IdT D' Y' ux ux) (subT D' (ext D' X') Fm (sec D' X' x)) (sym (Ty D') (subT D' (ext D' X') Fm (sec D' X' x)) (IJ.IdT D' Y' ux ux) (PFm x))
        (IJ.rfl D' Y' ux) ;
    pt1 : El D' FB = IN.pr D' X' Fm vux pb1 ;
    pt2 : El D' FB = IN.pr D' X' Fm x pb2 ;

    pth : El D' (IJ.IdT D' FB pt1 pt2) =
      PT.transM D' FB pt1 (SG.cenOf D' FB kx) pt2
        (PT.symM D' FB (SG.cenOf D' FB kx) pt1 (SG.ctrAt D' FB kx pt1)) (SG.ctrAt D' FB kx pt2) ;

    -- the first projection as a map
    EF : Ctx = ext D' FB ;
    XF : Ty EF = wkT D' FB X' ;
    SNF : Id (Ty EF) (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) = SS.Sig-nat EF D' X' Fm (p D' FB) ;
    fstM : El EF XF = IN.fst EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (trE EF (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) SNF (q D' FB)) ;

    fstAt (w : El D' FB) : Id (El D' X') (PT.atv D' FB X' fstM w) (IN.fst D' X' Fm w) =
      IN.teAny D' (subT D' EF XF (sec D' FB w)) X' (subt D' EF XF fstM (sec D' FB w)) (IN.fst D' X' Fm w)
        (IN.teOv D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w) fstM (IN.fst D' X' Fm w)
           (IN.fst-ov D' EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (sec D' FB w) X' (p-sec-T D' FB X' w) Fm PBs
              (Sig-ov D' EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (sec D' FB w) X' (p-sec-T D' FB X' w) Fm PBs)
              (trE EF (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) SNF (q D' FB)) w
              (IN.teAny D' (subT D' EF (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) (sec D' FB w)) FB
                 (subt D' EF (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) (trE EF (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) SNF (q D' FB)) (sec D' FB w)) w
                 (IN.teT D' (subT D' EF (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) (sec D' FB w)) (subT D' EF (wkT D' FB FB) (sec D' FB w)) FB
                    (subt D' EF (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) (trE EF (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) SNF (q D' FB)) (sec D' FB w))
                    (subt D' EF (wkT D' FB FB) (q D' FB) (sec D' FB w)) w
                    (IN.teS D' (subT D' EF (wkT D' FB FB) (sec D' FB w)) (subT D' EF (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) (sec D' FB w))
                       (subt D' EF (wkT D' FB FB) (q D' FB) (sec D' FB w))
                       (subt D' EF (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) (trE EF (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) SNF (q D' FB)) (sec D' FB w))
                       (IN.teSubtTr D' EF (wkT D' FB FB) (SS.Sig EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)))) SNF (q D' FB) (sec D' FB w)))
                    (IN.teOv D' EF (wkT D' FB FB) (sec D' FB w) FB (p-sec-T D' FB FB w) (q D' FB) w (IN.q-secO D' FB w (p-sec-T D' FB FB w))))
                 (Sig-ov D' EF XF (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (sec D' FB w) X' (p-sec-T D' FB X' w) Fm PBs))))
        (p-sec-T D' FB X' w)
     where {
      PBs : Id (Ty (ext D' X')) (subT (ext D' X') (ext EF XF) (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w))) Fm =
        trans (Ty (ext D' X')) (subT (ext D' X') (ext EF XF) (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w)))
          (subT (ext D' X') (ext D' X') Fm (o (ext D' X') (ext EF XF) (ext D' X') (lift EF D' X' (p D' FB)) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w)))) Fm
          (sym (Ty (ext D' X')) (subT (ext D' X') (ext D' X') Fm (o (ext D' X') (ext EF XF) (ext D' X') (lift EF D' X' (p D' FB)) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w))))
               (subT (ext D' X') (ext EF XF) (subT (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB))) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w)))
               (subT-o (ext D' X') (ext EF XF) (ext D' X') Fm (lift EF D' X' (p D' FB)) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w))))
          (trans (Ty (ext D' X')) (subT (ext D' X') (ext D' X') Fm (o (ext D' X') (ext EF XF) (ext D' X') (lift EF D' X' (p D' FB)) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w))))
             (subT (ext D' X') (ext D' X') Fm (id (ext D' X'))) Fm
             (ap (Sub (ext D' X') (ext D' X')) (Ty (ext D' X')) (\ t -> subT (ext D' X') (ext D' X') Fm t)
                 (o (ext D' X') (ext EF XF) (ext D' X') (lift EF D' X' (p D' FB)) (upT D' EF XF (sec D' FB w) X' (p-sec-T D' FB X' w))) (id (ext D' X'))
                 (liftSecId D' FB X' w))
             (subT-id (ext D' X') Fm)) ;
     } ;

    body : El D' (IJ.IdT D' X' vux x) =
      trE D' (IJ.IdT D' X' (PT.atv D' FB X' fstM pt1) (PT.atv D' FB X' fstM pt2)) (IJ.IdT D' X' vux x)
        (DJ.idCong D' X' X' (refl X') (PT.atv D' FB X' fstM pt1) (PT.atv D' FB X' fstM pt2) vux x
           (trans (El D' X') (PT.atv D' FB X' fstM pt1) (IN.fst D' X' Fm pt1) vux (fstAt pt1) (IN.fst-pr D' X' Fm vux pb1))
           (trans (El D' X') (PT.atv D' FB X' fstM pt2) (IN.fst D' X' Fm pt2) x (fstAt pt2) (IN.fst-pr D' X' Fm x pb2)))
        (PT.apM D' FB X' fstM pt1 pt2 pth) ;

    fibRet : El D (EQ.Htpy D Y X v u) = lam D X (IdAt D Y X v u) body ;
  } ;
} ;
