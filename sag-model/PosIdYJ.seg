-- PosIdYJ.seg (M1, step 3): J for the Yoneda Id, and J commutes with
-- substitution.
--
-- Setting.  A over G, a0 : A, K = G.A.  DY = K.Id(a0[p] , q) with the Yoneda
-- Id (PosIdY) of A[p] over K; core's J-context is D = K.Id(a0 , q) of CIdJ
-- (paths valued in G.A).
--
-- Informal text.
-- (1) The iso io : DY -> D over K, with inverse oi.  A path w of DY at k has
--     values w W f j : A(W , p (k f)); its readings in G.A,
--     (p (k f) , w W f j), form a path of D at k (the ends: w at (id , e0)
--     is a0 (p (k id)), at (id , e1) it is q (k id), and k id = k).  Back,
--     the values of a path of D are read off its readings (fromE).  The
--     sieve is unchanged.  Both composites are identities (same readings).
-- (2) The data of CJ on DY (JD), transported from CIdJ's along io:
--     pr = pr io, c = oi c, lam z = oi (lam (io z)), psi = the sieve.
--     J and beta are CJ's (PosJNat.JJ).
-- (3) For r : G' -> G, the map of J-contexts is oi upD io' (upD of
--     PosJNat); it commutes with the base, the contraction and the sieve
--     because io and oi are inverse, so PosJNat.JNatG gives jnat.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;

module YJ (G : PCtx) (A : PTy[G]) (a0 : PEl[G, A]) {
  module IJ = PB.CIdJ[l].IJ[G, A, a0] ;
  K : PCtx = extP G A ;
  B : PTy[K] = subTy K G A (pP G A) ;
  aK : PEl[K, B] = subEl K G A a0 (pP G A) ;
  module YK = PosIdY[a, l].IdY[K, B, aK, qP G A] ;
  DY : PCtx = extP K YK.IdYT ;

  module TA = IJ.TA ;
  module TI = IJ.TI ;
  module TY = YK.TY ;
  module SEB = PB.CSub[l].SubE[K, G, pP G A, A] ;

  ----------------------------------------------------------------------
  -- (1) the iso with core's J-context

  -- readings in G.A
  rdG (X : Ob) (k : W0.Ix (K.ob X)) (w : W0.Ix (YK.tob X k)) (W : Ob) (f : Hom W X) (j : Hom W Iv) : TA.EI W =
    SEB.mV W (YK.rd X k w W f j) ;

  toJ (X : Ob) (k : W0.Ix (K.ob X)) (w : W0.Ix (YK.tob X k)) : W0.Ix (IJ.IO.tobI X k) =
    (((\ W f j -> rdG X k w W f j,
       \ V W g f j -> transH (SEB.mV-nat V W g (YK.rd X k w W f j)) (apH (SEB.mV V) (YK.rd-nat X k w V W g f j))),
      (\ W f j -> refl (G.act W X f (TA.pr1 X k)),
       (transH (apH (TA.pr X (TA.pr1 X (K.act X X (idH X) k))) (w.1.2.2.1 X (idH X)))
          (IJ.aEq X (TA.pr1 X (K.act X X (idH X) k)) (TA.pr1 X k) (G.act-id X (TA.pr1 X k))),
        transH (apH (TA.pr X (TA.pr1 X (K.act X X (idH X) k))) (w.1.2.2.2 X (idH X)))
          (transH (pairE-eta G A X (K.act X X (idH X) k)) (K.act-id X k))))),
     (w.2.1, \ W f i j -> apH (TA.pr W (TA.pr1 W (K.act W X f k))) (w.2.2 W f i j))) ;

  module FromJ (X : Ob) (k : W0.Ix (K.ob X)) (v : W0.Ix (IJ.IO.tobI X k)) {
    L (W : Ob) (f : Hom W X) (j : Hom W Iv) : TA.EI W = v.1.1.1 W f j ;

    uJ (W : Ob) (f : Hom W X) (j : Hom W Iv) : W0.Ix (A.tob W (TA.pr1 W (K.act W X f k))) =
      TA.fromE W (TA.pr1 W (K.act W X f k)) (L W f j) (v.1.2.1 W f j) ;

    uJ-E (W : Ob) (f : Hom W X) (j : Hom W Iv) : Id (TA.EI W) (TA.pr W (TA.pr1 W (K.act W X f k)) (uJ W f j)) (L W f j) =
      TA.fromE-eq W (TA.pr1 W (K.act W X f k)) (L W f j) (v.1.2.1 W f j) ;

    atE (W : Ob) (f : Hom W X) (j : Hom W Iv) (c : W0.Ix (A.tob W (TA.pr1 W (K.act W X f k))))
      (E : Id (TA.EI W) (L W f j) (TA.pr W (TA.pr1 W (K.act W X f k)) c))
      : Id (W0.Ix (A.tob W (TA.pr1 W (K.act W X f k)))) (uJ W f j) c =
      TA.pr-inj W (TA.pr1 W (K.act W X f k)) (uJ W f j) c (transH (uJ-E W f j) E) ;

    natJ (V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
      : Id (W0.Ix (A.tob V (TA.pr1 V (K.act V X (compH V W X f g) k))))
           (B.tact V W g (K.act W X f k) (K.act V X (compH V W X f g) k) (YK.ptn X k V W g f) (uJ W f j))
           (uJ V (compH V W X f g) (compH V W Iv j g)) =
      TA.pr-inj V (TA.pr1 V (K.act V X (compH V W X f g) k))
        (B.tact V W g (K.act W X f k) (K.act V X (compH V W X f g) k) (YK.ptn X k V W g f) (uJ W f j))
        (uJ V (compH V W X f g) (compH V W Iv j g))
        (transH (symH (TA.pr-tact V W g (TA.pr1 W (K.act W X f k)) (TA.pr1 V (K.act V X (compH V W X f g) k))
                         (ntEq K G (pP G A) V W g (K.act W X f k) (K.act V X (compH V W X f g) k) (YK.ptn X k V W g f)) (uJ W f j)))
          (transH (apH (TA.E.act V W g) (uJ-E W f j))
            (transH (v.1.1.2 V W g f j) (symH (uJ-E V (compH V W X f g) (compH V W Iv j g)))))) ;

    res : W0.Ix (YK.tob X k) =
      ((uJ,
        (natJ,
         (\ W f -> atE W f (PB.ptH W e0) (a0.eob W (TA.pr1 W (K.act W X f k))) (IJ.IO.PT.end0g X k v.1 W f),
          \ W f -> atE W f (PB.ptH W e1) (TA.pr2 W (K.act W X f k))
                     (transH (IJ.IO.PT.end1g X k v.1 W f) (symH (pairE-eta G A W (K.act W X f k))))))),
       (v.2.1, \ W f i j -> atE W f j (a0.eob W (TA.pr1 W (K.act W X f k))) (v.2.2 W f i j))) ;
  } ;

  fromJ (X : Ob) (k : W0.Ix (K.ob X)) (v : W0.Ix (IJ.IO.tobI X k)) : W0.Ix (YK.tob X k) = FromJ[X, k, v].res ;

  -- io : DY -> D
  ioV (X : Ob) (z : W0.Ix (DY.ob X)) : W0.Ix (IJ.D.ob X) = TI.pr X (TY.pr1 X z) (toJ X (TY.pr1 X z) (TY.pr2 X z)) ;

  ioV-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (DY.ob X)) : Id (W0.Ix (IJ.D.ob Y)) (ioV Y (DY.act Y X h z)) (IJ.D.act Y X h (ioV X z)) =
    IJ.IO.tpI-ext Y (ioV Y (DY.act Y X h z)) (IJ.D.act Y X h (ioV X z)) (refl (K.act Y X h (TY.pr1 X z)))
      (\ V g j -> apH (SEB.mV V) (YK.Tact[Y, X, h, TY.pr1 X z, K.act Y X h (TY.pr1 X z), refl (K.act Y X h (TY.pr1 X z)), TY.pr2 X z].rdc V g j))
      (refl (PB.pre Y X h (TY.pr2 X z).2.1)) ;

  io : PSub[DY, IJ.D] = new PSub[DY, IJ.D, ioV, ioV-nat] ;

  -- oi : D -> DY
  oiV (X : Ob) (z : W0.Ix (IJ.D.ob X)) : W0.Ix (DY.ob X) = TY.pr X (TI.pr1 X z) (fromJ X (TI.pr1 X z) (TI.pr2 X z)) ;

  oiV-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (IJ.D.ob X)) : Id (W0.Ix (DY.ob Y)) (oiV Y (IJ.D.act Y X h z)) (DY.act Y X h (oiV X z)) =
    YK.tpY-ext Y (oiV Y (IJ.D.act Y X h z)) (DY.act Y X h (oiV X z)) (refl (K.act Y X h (TI.pr1 X z)))
      (\ V g j -> SEB.mV-inj V (YK.rd Y (K.act Y X h (TI.pr1 X z)) (fromJ Y (K.act Y X h (TI.pr1 X z)) (TI.pr2 Y (IJ.D.act Y X h z))) V g j)
                    (YK.rd Y (K.act Y X h (TI.pr1 X z)) (TY.pr2 Y (DY.act Y X h (oiV X z))) V g j)
                    (refl (K.act V Y g (K.act Y X h (TI.pr1 X z))))
         (transH (FromJ[Y, K.act Y X h (TI.pr1 X z), TI.pr2 Y (IJ.D.act Y X h z)].uJ-E V g j)
           (symH (transH (apH (SEB.mV V) (YK.Tact[Y, X, h, TI.pr1 X z, K.act Y X h (TI.pr1 X z), refl (K.act Y X h (TI.pr1 X z)), fromJ X (TI.pr1 X z) (TI.pr2 X z)].rdc V g j))
                    (FromJ[X, TI.pr1 X z, TI.pr2 X z].uJ-E V (compH V Y X h g) j)))))
      (refl (PB.pre Y X h (TI.pr2 X z).2.1)) ;

  oi : PSub[IJ.D, DY] = new PSub[IJ.D, DY, oiV, oiV-nat] ;

  -- they are inverse
  oi-io (X : Ob) (z : W0.Ix (DY.ob X)) : Id (W0.Ix (DY.ob X)) (oiV X (ioV X z)) z =
    YK.tpY-ext X (oiV X (ioV X z)) z (refl (TY.pr1 X z))
      (\ V g j -> SEB.mV-inj V (YK.rd X (TY.pr1 X z) (fromJ X (TY.pr1 X z) (toJ X (TY.pr1 X z) (TY.pr2 X z))) V g j)
                    (YK.rd X (TY.pr1 X z) (TY.pr2 X z) V g j) (refl (K.act V X g (TY.pr1 X z)))
                    (FromJ[X, TY.pr1 X z, toJ X (TY.pr1 X z) (TY.pr2 X z)].uJ-E V g j))
      (refl (TY.pr2 X z).2.1) ;

  io-oi (X : Ob) (z : W0.Ix (IJ.D.ob X)) : Id (W0.Ix (IJ.D.ob X)) (ioV X (oiV X z)) z =
    IJ.IO.tpI-ext X (ioV X (oiV X z)) z (refl (TI.pr1 X z))
      (\ V g j -> FromJ[X, TI.pr1 X z, TI.pr2 X z].uJ-E V g j)
      (refl (TI.pr2 X z).2.1) ;

  ----------------------------------------------------------------------
  -- (2) the data of J on DY

  module FDY = CL.FC[DY] ;
  module MO = CL.FMap[IJ.D, DY, oi] ;

  prY : PSub[DY, G] = oS DY IJ.D G IJ.pr io ;
  cY : PSub[G, DY] = oS G IJ.D DY oi IJ.c ;

  lamY (X : Ob) (z : W0.Ix (DY.ob X)) : W0.Ix (FDY.ob X) = MO.mapF X (IJ.lam X (ioV X z)) ;

  lamY-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (DY.ob X)) : Id (W0.Ix (FDY.ob Y)) (lamY Y (DY.act Y X h z)) (FDY.actF Y X h (lamY X z)) =
    calc (W0.Ix (FDY.ob Y)) {
        MO.mapF Y (IJ.lam Y (ioV Y (DY.act Y X h z)))
      =< apH (\ w -> MO.mapF Y (IJ.lam Y w)) (ioV-nat Y X h z) >
        MO.mapF Y (IJ.lam Y (IJ.D.act Y X h (ioV X z)))
      =< apH (MO.mapF Y) (IJ.lam-nat Y X h (ioV X z)) >
        MO.mapF Y (IJ.FD.actF Y X h (IJ.lam X (ioV X z)))
      =< symH (MO.mapF-act Y X h (IJ.lam X (ioV X z))) >
        FDY.actF Y X h (MO.mapF X (IJ.lam X (ioV X z))) } ;

  psiY (X : Ob) (z : W0.Ix (DY.ob X)) : PB.Phi X = (TY.pr2 X z).2.1 ;

  yjD : PosJNat[a, l].JD[G, DY] = new PosJNat[a, l].JD[G, DY, prY, cY,
    \ X x -> IJ.prc X x,
    lamY, lamY-nat,
    \ X z -> apH (oiV X) (IJ.lam0 X (ioV X z)),
    \ X z -> transH (apH (oiV X) (IJ.lam1 X (ioV X z))) (oi-io X z),
    psiY,
    \ Y X h z -> refl (PB.pre Y X h (psiY X z)),
    \ X x -> IJ.psi-c X x,
    \ X z W f i j -> transH (apH (oiV W) (IJ.lam-c X (ioV X z) W f i j))
                       (apH (\ w -> oiV W (IJ.c.nt W (IJ.pr.nt W w))) (symH (ioV-nat W X f z)))] ;

  -- J and its computation rule
  module JY (C : PTy[DY]) (cC : CL.Lines[DY, C].CompK[e0, e1].Comp) (d : PEl[G, subTy G DY C cY]) {
    module J0 = PosJNat[a, l].JJ[G, DY, yjD, C, cC, d].J0 ;

    J : PEl[DY, C] = J0.J ;

    beta (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (C.tob X (cY.nt X x))) (J.eob X (cY.nt X x)) (d.eob X x) = J0.beta X x ;
  } ;
} ;

------------------------------------------------------------------------
-- (3) J commutes with substitution

module YJNat (G' G : PCtx) (r : PSub[G', G]) (A : PTy[G]) (a0 : PEl[G, A]) {
  module Y = YJ[G, A, a0] ;
  module Y' = YJ[G', subTy G' G A r, subEl G' G A a0 r] ;
  module JN = PosJNat[a, l].JNat[G', G, r, A, a0] ;

  -- the map of J-contexts: oi upD io'
  upYV (X : Ob) (z : W0.Ix (Y'.DY.ob X)) : W0.Ix (Y.DY.ob X) = Y.oiV X (JN.upV X (Y'.ioV X z)) ;
  upY : PSub[Y'.DY, Y.DY] = oS Y'.DY Y'.IJ.D Y.DY (oS Y'.IJ.D Y.IJ.D Y.DY Y.oi JN.upD) Y'.io ;

  prEq (X : Ob) (z : W0.Ix (Y'.DY.ob X)) : Id (W0.Ix (G.ob X)) (Y.prY.nt X (upYV X z)) (r.nt X (Y'.prY.nt X z)) =
    refl (r.nt X (Y'.prY.nt X z)) ;

  lamEq (X : Ob) (z : W0.Ix (Y'.DY.ob X))
    : Id (W0.Ix (Y.FDY.ob X)) (CL.FMap[Y'.DY, Y.DY, upY].mapF X (Y'.lamY X z)) (Y.lamY X (upYV X z)) =
    Y.FDY.fam-eq X (CL.FMap[Y'.DY, Y.DY, upY].mapF X (Y'.lamY X z)) (Y.lamY X (upYV X z)) (\ W f j ->
      calc (W0.Ix (Y.DY.ob W)) {
          Y.oiV W (JN.upV W (Y'.ioV W (Y'.oiV W ((Y'.IJ.lam X (Y'.ioV X z)).1 W f j))))
        =< apH (\ w -> Y.oiV W (JN.upV W w)) (Y'.io-oi W ((Y'.IJ.lam X (Y'.ioV X z)).1 W f j)) >
          Y.oiV W (JN.upV W ((Y'.IJ.lam X (Y'.ioV X z)).1 W f j))
        =< apH (Y.oiV W) (JN.lamV-up X (Y'.ioV X z) W f j) >
          Y.oiV W ((Y.IJ.lam X (JN.upV X (Y'.ioV X z))).1 W f j)
        =< symH (apH (\ w -> Y.oiV W ((Y.IJ.lam X w).1 W f j)) (Y.io-oi X (JN.upV X (Y'.ioV X z)))) >
          Y.oiV W ((Y.IJ.lam X (Y.ioV X (upYV X z))).1 W f j) }) ;

  psiEq (X : Ob) (z : W0.Ix (Y'.DY.ob X)) : Id (PB.Phi X) (Y'.psiY X z) (Y.psiY X (upYV X z)) = refl (Y'.psiY X z) ;

  module YJN (C : PTy[Y.DY]) (cC : CL.Lines[Y.DY, C].CompK[e0, e1].Comp) (d : PEl[G, subTy G Y.DY C Y.cY])
    (d' : PEl[G', subTy G' Y'.DY (subTy Y'.DY Y.DY C upY) Y'.cY])
    (dEq : (X : Ob) (x : W0.Ix (G'.ob X))
       -> Id (GPR.TyL[Y.DY, C].EI X) (GPR.TyL[Y.DY, C].pr X (upYV X (Y'.cY.nt X x)) (d'.eob X x))
                                     (GPR.TyL[Y.DY, C].pr X (Y.cY.nt X (r.nt X x)) (d.eob X (r.nt X x)))) {
    module T = PosJNat[a, l].JNatG[G', G, r, Y'.DY, Y.DY, Y'.yjD, Y.yjD, upY, prEq, lamEq, psiEq, C, cC, d, d', dEq] ;

    jnat (X : Ob) (z : W0.Ix (Y'.DY.ob X)) : Id (W0.Ix (C.tob X (upYV X z))) (T.J1.J.eob X z) (T.J0.J.eob X (upYV X z)) = T.jnat X z ;
  } ;
} ;
