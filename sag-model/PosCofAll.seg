-- PosCofAll.seg (M1, step 1): ∀ along the interval for the cofibrations
-- of PosCof (M1.md §1: ∀F = {A : [1] × A ∈ F}).
--
-- Informal text.  A line of cofibrations L over X is a natural family of
-- cofibrations L(f, j) of W, for f : W -> X and j : W -> [1].  Its values
-- are all pullbacks of ONE cofibration of X × [1], the universal value
-- Λ = L(pr1, pr2), along (f, j) (naturality).  The core's forallS (CPosBase)
-- says: f lands in ∀L iff the cylinder (f pr1, pr2) : W × [1] -> X × [1]
-- lands in Λ.  If k is covered by f, then the cylinder of k is covered by
-- the cylinder of f (a point (v, j) is hit by (s, j) where f s = k v), so
-- Full Λ gives: k lands in ∀L.  Hence ∀L is a cofibration.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;
open PosCof[a] ;

module Forall (X : Ob) {
  XI : Ob = prodP X Iv ;

  -- a line of cofibrations (the type PhiL of CBase.CB at PC.Phi)
  Line : U a = (L : (W : Ob) -> Hom W X -> Hom W Iv -> PC.Phi W)
    * ((V W : Ob) (g : Hom V W) (f : Hom W X) (j : Hom W Iv)
       -> Id (PC.Phi V) (PC.pre V W g (L W f j)) (L V (compH V W X f g) (compH V W Iv j g))) ;

  -- the same line of decidable sieves, for CPosBase.forallS
  toSP (L : Line) : PhiLP X = (\ W f j -> (L.1 W f j).1, \ V W g f j -> apH (\ q -> q.1) (L.2 V W g f j)) ;

  -- the universal value Λ (lam) and the classifying maps
  lam (L : Line) : PC.Phi XI = L.1 XI (pr1 X Iv) (pr2 X Iv) ;

  m (W : Ob) (f : Hom W X) (j : Hom W Iv) : Hom W XI = pairH X Iv W f j ;

  lam-at (L : Line) (W : Ob) (f : Hom W X) (j : Hom W Iv)
    : Id (PC.Phi W) (PC.pre W XI (m W f j) (lam L)) (L.1 W f j) =
    transH (L.2 W XI (m W f j) (pr1 X Iv) (pr2 X Iv))
      (transH (apH (\ h -> L.1 W h (compH W XI Iv (pr2 X Iv) (m W f j))) (pr1-pair X Iv W f j))
              (apH (\ h -> L.1 W f h) (pr2-pair X Iv W f j))) ;

  -- L (f, j) holds at the identity iff (f, j) lands in the universal value
  to-univ (L : Line) (W : Ob) (f : Hom W X) (j : Hom W Iv) (h : PC.Lands W W (L.1 W f j) (idH W))
    : PC.Lands W XI (lam L) (m W f j) =
    slands-hom W XI (lam L).1 (compH W W XI (m W f j) (idH W)) (m W f j) (comp-idr W XI (m W f j))
      (substH (\ q -> PC.Lands W W q (idH W)) (symH (lam-at L W f j)) h) ;

  from-univ (L : Line) (W : Ob) (f : Hom W X) (j : Hom W Iv) (h : PC.Lands W XI (lam L) (m W f j))
    : PC.Lands W W (L.1 W f j) (idH W) =
    substH (\ q -> PC.Lands W W q (idH W)) (lam-at L W f j)
      (slands-hom W XI (lam L).1 (m W f j) (compH W W XI (m W f j) (idH W)) (symH (comp-idr W XI (m W f j))) h) ;

  -- the cylinder of f : W -> X
  cyl (W : Ob) (f : Hom W X) : Hom (prodP W Iv) XI = m (prodP W Iv) (compH (prodP W Iv) W X f (pr1 W Iv)) (pr2 W Iv) ;

  -- k covered by f gives: the cylinder of k covered by the cylinder of f
  covered-cyl (V W : Ob) (k : Hom V X) (f : Hom W X) (c : Covered V W X k f)
    : Covered (prodP V Iv) (prodP W Iv) XI (cyl V k) (cyl W f) = \ u ->
    Image[prodP W Iv, XI, cyl W f].im-at (app (prodP V Iv) XI (cyl V k) u) (w u)
      (el-eq XI (app (prodP W Iv) XI (cyl W f) (w u)) (app (prodP V Iv) XI (cyl V k) u) (tr u))
   where { v (u : El (prodP V Iv)) : El V = app (prodP V Iv) V (pr1 V Iv) u ;
           jv (u : El (prodP V Iv)) : El Iv = app (prodP V Iv) Iv (pr2 V Iv) u ;
           r (u : El (prodP V Iv)) : (s : El W) * Id Tree (app W X f s).1 (app V X k (v u)).1 =
             Image[W, X, f].im-sound (app V X k (v u)) (c (v u)) ;
           w (u : El (prodP V Iv)) : El (prodP W Iv) =
             (node (r u).1.1 (jv u).1, and-i (car W (r u).1.1) (car Iv (jv u).1) (r u).1.2 (jv u).2) ;
           tr (u : El (prodP V Iv))
             : Id Tree (app (prodP W Iv) XI (cyl W f) (w u)).1 (app (prodP V Iv) XI (cyl V k) u).1 =
             node-eq _ _ _ _
               (transH (app-compH1 (prodP W Iv) W X f (pr1 W Iv) (w u))
                 (transH (apH (\ s -> (app W X f s).1)
                           (el-eq W (app (prodP W Iv) W (pr1 W Iv) (w u)) (r u).1 (refl (r u).1.1)))
                   (transH (r u).2 (symH (app-compH1 (prodP V Iv) V X k (pr1 V Iv) u)))))
               (refl (jv u).1) ; } ;

  full-forall (L : Line) : Full X (forallS X (toSP L)) = \ W V f k i c ->
    from-univ L (prodP V Iv) (compH (prodP V Iv) V X k (pr1 V Iv)) (pr2 V Iv)
      ((lam L).2 (prodP W Iv) (prodP V Iv) (cyl W f) (cyl V k)
        (to-univ L (prodP W Iv) (compH (prodP W Iv) W X f (pr1 W Iv)) (pr2 W Iv) i)
        (covered-cyl V W k f c)) ;
} ;

-- ∀ along the interval, with the two laws of CBase.CB
forallC (X : Ob) (L : Forall[X].Line) : PC.Phi X =
  (forallS X (Forall[X].toSP L), Forall[X].full-forall L) ;

lands-forallC (W X : Ob) (L : Forall[X].Line) (f : Hom W X) (i : PC.Lands W X (forallC X L) f)
  : HoldsLP X (Forall[X].toSP L) W f = lands-forall W X (Forall[X].toSP L) f i ;

forall-landsC (W X : Ob) (L : Forall[X].Line) (f : Hom W X) (h : HoldsLP X (Forall[X].toSP L) W f)
  : PC.Lands W X (forallC X L) f = forall-lands W X (Forall[X].toSP L) f h ;
