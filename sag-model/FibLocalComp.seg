-- A cart detects equality of compositions on every line in its image.
-- Lift the starting element and the side, then compare the moved
-- composites in the target's total space.

level a k l ;
constraint a <= k ;
constraint a <= l ;
open Base ;
open Prelude[(k \/ l)+] ;
open Paths[(k \/ l)+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module P0 = PB.GPre[k] ;
module P1 = PB.GPre[l] ;
module W0 = V[k] ;
module W1 = V[l] ;

module Test (D : P1.PS.PCtx) (A' : P1.PS.PTy[D]) (G : P0.PS.PCtx) (A : P0.PS.PTy[G])
  (s : (W : Ob) -> W1.Ix (D.ob W) -> W0.Ix (G.ob W))
  (s-nat : (V W : Ob) (g : Hom V W) (d : W1.Ix (D.ob W))
    -> Id (W0.Ix (G.ob V)) (s V (D.act V W g d)) (G.act V W g (s W d)))
  (ta : (W : Ob) -> P1.TyL[D, A'].EI W -> P0.TyL[G, A].EI W)
  (tapt : (W : Ob) (v : P1.TyL[D, A'].EI W)
    -> Id (W0.Ix (G.ob W)) (P0.TyL[G, A].pr1 W (ta W v)) (s W (P1.TyL[D, A'].pr1 W v)))
  (tanat : (V W : Ob) (g : Hom V W) (v : P1.TyL[D, A'].EI W)
    -> Id (P0.TyL[G, A].EI V) (P0.TyL[G, A].E.act V W g (ta W v)) (ta V (P1.TyL[D, A'].E.act V W g v)))
  (tainj : (W : Ob) (v v' : P1.TyL[D, A'].EI W)
    (P : Id (W1.Ix (D.ob W)) (P1.TyL[D, A'].pr1 W v) (P1.TyL[D, A'].pr1 W v'))
    (Q : Id (P0.TyL[G, A].EI W) (ta W v) (ta W v'))
    -> Id (P1.TyL[D, A'].EI W) v v')
  (bk : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x))) -> W1.Ix (A'.tob X x))
  (bkta : (X : Ob) (x : W1.Ix (D.ob X)) (u : W0.Ix (A.tob X (s X x)))
    -> Id (P0.TyL[G, A].EI X) (ta X (P1.TyL[D, A'].pr X x (bk X x u))) (P0.TyL[G, A].pr X (s X x) u)) {

  module K = PB.CCart[k, l].Cart[D, A', G, A, s, s-nat, ta, tapt, tanat, tainj, bk, bkta] ;

  module Comp (e e' : El Iv) {
    module M = K.MoveComp[e, e'] ;
    module E = M.E ;
    module T = E.EK ;
    module S = E.EK' ;

    -- Pull back side values at the restrictions of the lifted point.
    module LiftSide (X : Ob) (o : S.TV.EI X) (sd : T.PT.Side[X, E.sV X o]) {
      pt (W : Ob) (f : Hom W X) : S.TV.EI W = S.TV.E.act W X f o ;

      preimage-base (W : Ob) (f : Hom W X) (i : PB.Lands W X sd.pQ f)
        : Id (T.TV.EI W) (T.TS.pr1 W (sd.pv W f i)) (E.sV W (pt W f)) =
        transH (sd.ppt W f i) (symH (E.sV-nat W X f o)) ;

      module Value (W : Ob) (f : Hom W X) (i : PB.Lands W X sd.pQ f) {
        u : T.TS.T W (E.sV W (pt W f)) =
          T.TS.fromE W (E.sV W (pt W f)) (sd.pv W f i) (preimage-base W f i) ;
        module B = E.BkS[W, pt W f, u] ;

        v : S.TS.EI W = S.TS.pr W (pt W f) B.res ;

        image : Id (T.TS.EI W) (E.mS W v) (sd.pv W f i) =
          transH B.res-mS (T.TS.fromE-eq W (E.sV W (pt W f)) (sd.pv W f i) (preimage-base W f i)) ;
        opaque image ;
      } ;

      val (W : Ob) (f : Hom W X) (i : PB.Lands W X sd.pQ f) : S.TS.EI W = Value[W, f, i].v ;

      nat (V W : Ob) (g : Hom V W) (f : Hom W X)
        (i : PB.Lands W X sd.pQ f) (j : PB.Lands V X sd.pQ (compH V W X f g))
        : Id (S.TS.EI V) (S.TS.E.act V W g (val W f i)) (val V (compH V W X f g) j) =
        E.mS-inj V (S.TS.E.act V W g (val W f i)) (val V (compH V W X f g) j)
          (symH (S.TV.E.act-o V W X f g o))
          (transH (symH (E.mSnat V W g (val W f i)))
            (transH (apH (T.TS.E.act V W g) Value[W, f, i].image)
              (transH (sd.pnat V W g f i j) (symH Value[V, compH V W X f g, j].image)))) ;
      opaque nat ;

      side : S.PT.Side[X, o] = new S.PT.Side[X, o, sd.pQ, val, \ W f i -> refl (pt W f), nat] ;

      image (c : M.CK.Comp) : Id (T.PT.Side[X, E.sV X o]) (M.mside c X o side) sd =
        T.PT.side-ext X (E.sV X o) (M.mside c X o side) sd (refl sd.pQ)
          (\ W f i j -> transH Value[W, f, i].image (T.PT.pv-irr X (E.sV X o) sd W f i j)) ;
      opaque image ;
    } ;

    module Compare (c d : M.CK.Comp) (H : Id (M.CK'.Comp) (M.move c) (M.move d)) {
      module AtImage (X : Ob) (o : S.TV.EI X) (sd : T.PT.Side[X, E.sV X o]) {
        module L = LiftSide[X, o, sd] ;

        law : Id (M.TT.T X (E.sV X o)) (c.kop X (E.sV X o) sd) (d.kop X (E.sV X o) sd) =
        M.TT.pr-inj X (E.sV X o) (c.kop X (E.sV X o) sd) (d.kop X (E.sV X o) sd)
          (calc (M.TT.EI X) {
             M.TT.pr X (E.sV X o) (c.kop X (E.sV X o) sd)
             =< apH (\ z -> M.TT.pr X (E.sV X o) (c.kop X (E.sV X o) z)) (symH (L.image c)) >
             M.TT.pr X (E.sV X o) (c.kop X (E.sV X o) (M.mside c X o L.side))
             =< symH (M.kopMv c X o L.side) >
             M.mT X (M.TT'.pr X o ((M.move c).kop X o L.side))
             =< apH {M.CK'.Comp} {M.TT.EI X} (\ z -> M.mT X (M.TT'.pr X o (z.kop X o L.side))) H >
             M.mT X (M.TT'.pr X o ((M.move d).kop X o L.side))
             =< M.kopMv d X o L.side >
             M.TT.pr X (E.sV X o) (d.kop X (E.sV X o) (M.mside d X o L.side))
             =< apH (\ z -> M.TT.pr X (E.sV X o) (d.kop X (E.sV X o) z)) (L.image d) >
             M.TT.pr X (E.sV X o) (d.kop X (E.sV X o) sd) }) ;
        opaque law ;
      } ;

      at-point (X : Ob) (o : S.TV.EI X) (x : T.TV.EI X) (P : Id (T.TV.EI X) (E.sV X o) x)
        : (sd : T.PT.Side[X, x]) -> Id (M.TT.T X x) (c.kop X x sd) (d.kop X x sd) =
        idJ (T.TV.EI X) (E.sV X o)
          (\ y _ -> (sd : T.PT.Side[X, y]) -> Id (M.TT.T X y) (c.kop X y sd) (d.kop X y sd))
          (\ sd -> AtImage[X, o, sd].law) x P ;

      at-line (X : Ob) (ell : W1.Ix (K.FD.ob X)) (x : T.TV.EI X)
        (P : Id (W0.Ix (K.FG.ob X)) (K.sI X ell) (T.TV.pr1 X x))
        (sd : T.PT.Side[X, x]) : Id (M.TT.T X x) (c.kop X x sd) (d.kop X x sd) =
        at-point X o x (T.tv-eq X (E.sV X o) x P
          (transH (E.sVE X o)
            (transH (bkta X start b) (K.TA.fromE-eq X (s X start) (T.endE X x) start-eq)))) sd
        where {
          start : W1.Ix (D.ob X) = (K.FD.ev e).nt X ell ;
          start-eq : Id (W0.Ix (G.ob X)) (K.TA.pr1 X (T.endE X x)) (s X start) =
            apH ((K.FG.ev e).nt X) (symH P) ;
          b : W0.Ix (A.tob X (s X start)) = K.TA.fromE X (s X start) (T.endE X x) start-eq ;
          o : S.TV.EI X = S.TV.pr X ell (bk X start b) ;
        } ;
      opaque at-line ;
    } ;
  } ;
} ;

-- The generic line in y(X * [1]) maps to the given line along the
-- Yoneda map of its value at the projections.
module LinePoint (G : P0.PS.PCtx) (X : Ob) (line : W0.Ix (PB.CLine[k].FC[G].ob X)) {
  stage : Ob = prodP X Iv ;
  point : W0.Ix (G.ob stage) = line.1 stage (pr1 X Iv) (pr2 X Iv) ;

  module Y = PB.GYon[l] ;
  module F = PB.CLine[l].FC[Y.yP stage] ;

  ell : W1.Ix (F.ob X) =
    (\ W f j -> pairH X Iv W f j, \ V W g f j -> CPosEl2[a].pair-comp V W X g f j) ;

  read (W : Ob) (f : Hom W X) (j : Hom W Iv)
    : Id (W0.Ix (G.ob W)) (G.act W stage (ell.1 W f j) point) (line.1 W f j) =
    transH (line.2 W stage (pairH X Iv W f j) (pr1 X Iv) (pr2 X Iv))
      (transH (apH (\ g -> line.1 W g (compH W stage Iv (pr2 X Iv) (pairH X Iv W f j))) (pr1-pair X Iv W f j))
              (apH (line.1 W f) (pr2-pair X Iv W f j))) ;
  opaque read ;
} ;
