-- Fibration structures on posets are determined by their Yoneda
-- restrictions. SameLevel uses ordinary substitution; Small uses
-- CSmall's mixed-level substitution for the universe classifier.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[(a+ \/ l)+] ;
open Paths[(a+ \/ l)+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;

module SameLevel (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) {
  module P = PB.GPre[l] ;
  module Y = PB.GYon[l] ;
  module C = PB.CLine[l].Lines[G, A] ;
  module R = FibLocalComp[a, l, l] ;

  module At (Z : Ob) (z : V[l].Ix (G.ob Z)) {
    D : P.PS.PCtx = Y.yP Z ;
    s : P.PS.PSub[D, G] = Y.yPt G Z z ;
    module F = PB.CFibSub[l].FibSub[D, G, s, A] ;
    module SE = F.SE ;
    module B = PB.CLine[l].Lines[D, P.PS.subTy D G A s] ;
    restrict (c : C.Fib) : B.Fib = F.sub c ;

    module Test = R.Test[D, P.PS.subTy D G A s, G, A, s.nt, s.nt-nat,
      SE.mV, \ W v -> refl (s.nt W (SE.TS.pr1 W v)), SE.mV-nat, SE.mV-inj,
      \ W x u -> u, \ W x u -> refl (SE.TC.pr W (s.nt W x) u)] ;
  } ;

  module Comp (e e' : El Iv) {
    module K = C.CompK[e, e'] ;
    module Ext = PB.CPartial[l].Rel[K.EK.TV.E, K.EK.SFm.SF, K.Tend, K.endL] ;

    module AtProblem (X : Ob) (x : K.EK.TV.EI X) {
      line : V[l].Ix (C.FG.ob X) = K.EK.TV.pr1 X x ;
      module L = R.LinePoint[G, X, line] ;
      module T = At[L.stage, L.point].Test ;
      module Proof = T.Comp[e, e'] ;
      module Move = Proof.M ;

      line-eq : Id (V[l].Ix (C.FG.ob X)) (T.K.sI X L.ell) line =
        C.FG.fam-eq X (T.K.sI X L.ell) line L.read ;

      test (c d : K.Comp) (H : Id Move.CK'.Comp (Move.move c) (Move.move d))
        (sd : K.EK.PT.Side[X, x]) : Id (Ext.TT.T X x) (c.kop X x sd) (d.kop X x sd) =
        Proof.Compare[c, d, H].at-line X L.ell x line-eq sd ;
      opaque test ;
    } ;

    comp-local (c d : K.Comp)
      (H : (Z : Ob) (z : V[l].Ix (G.ob Z))
        -> Id (At[Z, z].F.C.MoveComp[e, e'].CK'.Comp)
              (At[Z, z].F.C.MoveComp[e, e'].move c) (At[Z, z].F.C.MoveComp[e, e'].move d))
      : Id K.Comp c d =
      Ext.rc-ext c d (\ X x sd ->
        AtProblem[X, x].test c d (H AtProblem[X, x].L.stage AtProblem[X, x].L.point) sd) ;
  } ;

  fib-local (c d : C.Fib)
    (H : (Z : Ob) (z : V[l].Ix (G.ob Z)) -> Id (At[Z, z].B.Fib) (At[Z, z].restrict c) (At[Z, z].restrict d))
    : Id C.Fib c d =
    transH {C.Fib} {c} {(d.1, c.2)} {d}
      (apH {C.CompK[e0, e1].Comp} {C.Fib} (\ u -> (u, c.2))
        (Comp[e0, e1].comp-local c.1 d.1 (\ Z z -> apH {At[Z, z].B.Fib} (\ f -> f.1) (H Z z))))
      (apH {C.CompK[e1, e0].Comp} {C.Fib} (\ v -> (d.1, v))
        (Comp[e1, e0].comp-local c.2 d.2 (\ Z z -> apH {At[Z, z].B.Fib} (\ f -> f.2) (H Z z)))) ;
  opaque fib-local ;
} ;

module Small (G : PB.GPre[a+].PS.PCtx) (A : PB.CSmall.SPTy[G]) {
  module P = PB.GPre[a] ;
  module Y = PB.GYon[a] ;
  module C = PB.CLine[a+].Lines[G, PB.CSmall.up G A] ;
  module R = FibLocalComp[a, a+, a] ;

  module At (Z : Ob) (z : V[a+].Ix (G.ob Z)) {
    D : P.PS.PCtx = Y.yP Z ;
    s : PB.CSmall.XSub[D, G] =
      new PB.CSmall.XSub[D, G, \ W f -> G.act W Z f z, \ V W g f -> G.act-o V W Z f g z] ;
    module F = PB.CSmall.SmallFib[G, A, D, s] ;
    module B = PB.CLine[a].Lines[D, F.ElTy] ;
    restrict (c : C.Fib) : B.Fib = F.fib c ;

    module Test = R.Test[D, F.ElTy, G, PB.CSmall.up G A, s.nt, s.nt-nat,
      F.ta, \ W v -> refl (s.nt W (F.TB.pr1 W v)), F.tanat, F.tainj,
      \ W x u -> u, \ W x u -> refl (F.TE.pr W (s.nt W x) u)] ;
  } ;

  module Comp (e e' : El Iv) {
    module K = C.CompK[e, e'] ;
    module Ext = PB.CPartial[a+].Rel[K.EK.TV.E, K.EK.SFm.SF, K.Tend, K.endL] ;

    module AtProblem (X : Ob) (x : K.EK.TV.EI X) {
      line : V[a+].Ix (C.FG.ob X) = K.EK.TV.pr1 X x ;
      module L = R.LinePoint[G, X, line] ;
      module T = At[L.stage, L.point].Test ;
      module Proof = T.Comp[e, e'] ;
      module Move = Proof.M ;

      line-eq : Id (V[a+].Ix (C.FG.ob X)) (T.K.sI X L.ell) line =
        C.FG.fam-eq X (T.K.sI X L.ell) line L.read ;

      test (c d : K.Comp) (H : Id Move.CK'.Comp (Move.move c) (Move.move d))
        (sd : K.EK.PT.Side[X, x]) : Id (Ext.TT.T X x) (c.kop X x sd) (d.kop X x sd) =
        Proof.Compare[c, d, H].at-line X L.ell x line-eq sd ;
      opaque test ;
    } ;

    comp-local (c d : K.Comp)
      (H : (Z : Ob) (z : V[a+].Ix (G.ob Z))
        -> Id (At[Z, z].F.C.MoveComp[e, e'].CK'.Comp)
              (At[Z, z].F.C.MoveComp[e, e'].move c) (At[Z, z].F.C.MoveComp[e, e'].move d))
      : Id K.Comp c d =
      Ext.rc-ext c d (\ X x sd ->
        AtProblem[X, x].test c d (H AtProblem[X, x].L.stage AtProblem[X, x].L.point) sd) ;
  } ;

  fib-local (c d : C.Fib)
    (H : (Z : Ob) (z : V[a+].Ix (G.ob Z)) -> Id (At[Z, z].B.Fib) (At[Z, z].restrict c) (At[Z, z].restrict d))
    : Id C.Fib c d =
    transH {C.Fib} {c} {(d.1, c.2)} {d}
      (apH {C.CompK[e0, e1].Comp} {C.Fib} (\ u -> (u, c.2))
        (Comp[e0, e1].comp-local c.1 d.1 (\ Z z -> apH {At[Z, z].B.Fib} (\ f -> f.1) (H Z z))))
      (apH {C.CompK[e1, e0].Comp} {C.Fib} (\ v -> (d.1, v))
        (Comp[e1, e0].comp-local c.2 d.2 (\ Z z -> apH {At[Z, z].B.Fib} (\ f -> f.2) (H Z z)))) ;
  opaque fib-local ;
} ;
