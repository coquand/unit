-- FibUaHr.seg (M1 step 3, S4, H: the round trip for r).  For a point z of
-- T3 at X and u in Yc(z) = fib0 (b), the alpha of f's datum at z, at the
-- identity, applied to u moved to fib0 (uAct id b) along ANY code path c,
-- is S3's body rbc = bod rc at (z , u).  Neither S3a, nor eqU, nor kd
-- enters.
--
-- Informal text.
-- (1) tactId-sV.  El's action along the identity, at b, towards any code F'
--     (any path e : b id = F') is a transport of V along any code path c:
--     tactG = (substF) a transport of tz = b.tact id along y0 = id id, and
--     tz read at id (fib-move, tact-move, tact-id: as CUniv.tidG) is the
--     element itself; the two transports compose to one (sV-two).
-- (2) Hr.  Let z1 = z id, u1 = sV c u.
--     alpha (id , q) u1 = psA (gv u1) by definition of GC.al, and gv u1 is
--     rbc (z1 , u1): read in the total space of Xc both are S.al (z1 , u1)
--     (GC.gv-E, pr-inj).  The identity action of the total space E(Yc) at
--     (z , u) is (z1 , tact id u) by definition, and tact id u = u1 by (1);
--     so act-id of E(Yc) gives a path Q : (z1 , u1) = (z , u).  rbc moved
--     along Q is rbc (z , u) (apd-el); the move is a transport of V along
--     the codes (subst-ap), and psA is another transport between the same
--     codes, so they agree (sV-irr).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module UU = CPosEl1[a].UU ;
module YG = CPosEl1[a].YG ;
module UF = FibUaF[a] ;
module PPi = PresheafPi[a, a+].PPi[PB.BC] ;

------------------------------------------------------------------------
-- (1) the identity action of El is a transport

-- b.tact along the identity, at y0 = id id, read at id
tz-id (X : Ob) (b : UU.U0 X) (u : W0.Ix (UU.fib0 X b))
  : Id (W0.Ix (b.1.tob X (idH X)))
       (YG.sV (b.1.tob X ((PB.GYon[a].yH X X (idH X)).nt X (idH X))) (b.1.tob X (idH X)) (apH (b.1.tob X) (PB.comp-idl X X (idH X)))
          (b.1.tact X X (idH X) (idH X) ((PB.GYon[a].yH X X (idH X)).nt X (idH X)) (UU.idf-eq X X (idH X)) u))
       u =
  transH (UU.fib-move (Hom X X) (b.1.tob X) ((PB.GYon[a].yH X X (idH X)).nt X (idH X)) (idH X) (PB.comp-idl X X (idH X))
            (apH (b.1.tob X) (PB.comp-idl X X (idH X)))
            (b.1.tact X X (idH X) (idH X) ((PB.GYon[a].yH X X (idH X)).nt X (idH X)) (UU.idf-eq X X (idH X)) u))
  (transH (UU.tact-move (PB.GYon[a].yP X) b.1 X X (idH X) (idH X) ((PB.GYon[a].yH X X (idH X)).nt X (idH X)) (idH X)
            (UU.idf-eq X X (idH X)) (PB.comp-idl X X (idH X)) (PB.comp-idl X X (idH X)) u)
          (b.1.tact-id X (idH X) (PB.comp-idl X X (idH X)) u)) ;

tactId-sV (X : Ob) (b F' : UU.U0 X) (e : Id (UU.U0 X) (UU.uAct X X (idH X) b) F')
  (c : Id W0.V (UU.fib0 X b) (UU.fib0 X F')) (u : W0.Ix (UU.fib0 X b))
  : Id (W0.Ix (UU.fib0 X F')) (UU.tactG X X (idH X) b F' e u) (YG.sV (UU.fib0 X b) (UU.fib0 X F') c u) =
  transH (UU.substF X (UU.uAct X X (idH X) b) F' e tz)
  (transH (apH (YG.sV (UU.fib0 X (UU.uAct X X (idH X) b)) (UU.fib0 X F') (ap (UU.U0 X) W0.V (UU.fib0 X) (UU.uAct X X (idH X) b) F' e))
             (transH (symH (YG.sV-round' (UU.fib0 X (UU.uAct X X (idH X) b)) (UU.fib0 X b) cy tz))
                     (apH (YG.sV (UU.fib0 X b) (UU.fib0 X (UU.uAct X X (idH X) b)) (symH cy)) (tz-id X b u))))
          (PB.CExtEq1.sV-two (UU.fib0 X b) (UU.fib0 X (UU.uAct X X (idH X) b)) (UU.fib0 X F')
             (symH cy) (ap (UU.U0 X) W0.V (UU.fib0 X) (UU.uAct X X (idH X) b) F' e) c u))
 where {
  tz : W0.Ix (UU.fib0 X (UU.uAct X X (idH X) b)) =
    b.1.tact X X (idH X) (idH X) ((PB.GYon[a].yH X X (idH X)).nt X (idH X)) (UU.idf-eq X X (idH X)) u ;
  cy : Id W0.V (UU.fib0 X (UU.uAct X X (idH X) b)) (UU.fib0 X b) = apH (b.1.tob X) (PB.comp-idl X X (idH X)) ;
 } ;

opaque tz-id ; opaque tactId-sV ;

------------------------------------------------------------------------
-- (2) the round trip for r

module RT (X : Ob) (z : V1.Ix (UF.T3.ob X)) (q : IsT (PB.CGlueD.fl X (PB.topS X) X (idH X))) {
  module D = UF.FD.P[X, z, UF.zF X z, refl (UF.zF X z), PB.topS X] ;
  module EY = PB.GPre[a+].TyL[UF.T3, UF.Yc.1] ;

  z1 : V1.Ix (UF.T3.ob X) = UF.T3.act X X (idH X) z ;

  -- the code of rbc's fibre at a point of E(Yc)
  code (w : V1.Ix ((L.extP UF.T3 UF.Yc.1).ob X)) : W0.V = UU.fib0 X (UF.zF X (L.fstE UF.T3 UF.Yc.1 X w)) ;

  module H (c : Id W0.V (UU.fib0 X (UF.zb X z)) (UU.fib0 X (UF.zb X z1))) (u : W0.Ix (UU.fib0 X (UF.zb X z))) {
    u1 : W0.Ix (UU.fib0 X (UF.zb X z1)) = YG.sV (UU.fib0 X (UF.zb X z)) (UU.fib0 X (UF.zb X z1)) c u ;

    -- gv is rbc, read in the total space of Xc
    gvEq : Id (W0.Ix (UU.fib0 X (UF.zF X z1))) (D.GC.gv X (idH X, q) u1) (UF.S.rb.eob X (EY.pr X z1 u1)) =
      D.GC.TAg.pr-inj X z1 (D.GC.gv X (idH X, q) u1) (UF.S.rb.eob X (EY.pr X z1 u1)) (D.GC.gv-E X (idH X, q) u1) ;

    -- the identity action of E(Yc) at (z , u) is (z1 , u1)
    Q : Id (V1.Ix ((L.extP UF.T3 UF.Yc.1).ob X)) (EY.pr X z1 u1) (EY.pr X z u) =
      transH (apH (EY.pr X z1)
                (symH (tactId-sV X (UF.zb X z) (UF.zb X z1) (L.ntEq UF.T3 UU.UCtx UF.ym X X (idH X) z z1 (refl z1)) c u)))
             ((L.extP UF.T3 UF.Yc.1).act-id X (EY.pr X z u)) ;

    Hr : Id (W0.Ix (UU.fib0 X (UF.zF X z))) (D.GC.al X (idH X) q u1) (UF.S.rb.eob X (EY.pr X z u)) =
      transH (apH (D.psA X (idH X)) gvEq)
      (transH (PB.CExtEq1.sV-irr (code (EY.pr X z1 u1)) (code (EY.pr X z u))
                 (symH (D.cA X (idH X))) (ap (V1.Ix ((L.extP UF.T3 UF.Yc.1).ob X)) W0.V code (EY.pr X z1 u1) (EY.pr X z u) Q)
                 (UF.S.rb.eob X (EY.pr X z1 u1)))
      (transH (symH (subst-ap (V1.Ix ((L.extP UF.T3 UF.Yc.1).ob X)) W0.V code (\ v -> W0.Ix v) (EY.pr X z1 u1) (EY.pr X z u) Q
                       (UF.S.rb.eob X (EY.pr X z1 u1))))
              (PPi.apd-el (L.extP UF.T3 UF.Yc.1) (L.subTy (L.extP UF.T3 UF.Yc.1) UF.T3 UF.Xc.1 (L.pP UF.T3 UF.Yc.1)) UF.S.rb X
                 (EY.pr X z1 u1) (EY.pr X z u) Q))) ;
  } ;
} ;
