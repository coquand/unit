-- CPosInst.seg (sag-model shim): in this directory the poset instance is
-- PosFull, the base with the cofibrations of M1.md §1.  The core universe
-- files CPosEl1-5 and CPosFinal (symlinks) name their base CPosInst[a].PB,
-- so this one line re-instantiates them at the new base, without copies.
-- Not a symlink: core/CPosInst.seg (all decidable sieves) is not used here.
-- The interval of the base as an object and its point sieves (ivO, ptSO,
-- lands-ptO, pt-landsO, pt-disjO) are re-exported under the names of
-- core's CPosInst, for the core files that use them (CLocBoundContr,
-- CTruncIsProp).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;
open PosCof[a] ;
module PB = PosFull[a].PB ;
ivO : Ob = Iv ;
ptSO (e : El Iv) : PC.Phi Iv = PC.ptS e ;
lands-ptO (W : Ob) (e : El Iv) (g : Hom W Iv) (i : PC.Lands W Iv (PC.ptS e) g) : Id (Hom W Iv) g (constH W Iv e) = PC.lands-pt W e g i ;
pt-landsO (W : Ob) (e : El Iv) : PC.Lands W Iv (PC.ptS e) (constH W Iv e) = PC.pt-lands W e ;
pt-disjO (W : Ob) (g : Hom W Iv) (i : PC.Lands W Iv (PC.ptS e0) g) (i' : PC.Lands W Iv (PC.ptS e1) g) : Empty = PC.pt-disj W g i i' ;
