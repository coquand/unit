-- PosFull.seg (M1, step 2): the base CB at posets with the cofibrations of
-- M1.md §1 (PosCof, PosCofAll).  Same category, interval and connections as
-- the core's poset instance (CPosInst); only the presheaf of sieves differs:
-- PC.Phi (the decidable sieves determined by images) for SP.Phi (all
-- decidable sieves), with ∀ along the interval forallC.
--
-- Every generic construction (L2-L7) is then a member of PB at the new
-- base: PB.CThm7, PB.CUaOp, PB.CFibU3, ...  The universe files CPosEl1-5 and
-- CPosFinal are read through symlinks to core; in this directory the name
-- CPosInst resolves to the shim CPosInst.seg, which points at this PB.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;
open PosCof[a] ;
open PosCofAll[a] ;

-- the end sieves are stable (on posets, landing in a restricted sieve is
-- landing of the composite, by computation)
endPre (Y X : Ob) (g : Hom Y X) (i : Hom X Iv) (e : El Iv)
  : Id (PC.Phi Y) (PC.pre Y X g (PC.pre X Iv i (PC.ptS e))) (PC.pre Y Iv (compH Y X Iv i g) (PC.ptS e)) =
  PC.phi-ext Y (PC.pre Y X g (PC.pre X Iv i (PC.ptS e))) (PC.pre Y Iv (compH Y X Iv i g) (PC.ptS e))
    (\ W f l -> substH (\ k -> PC.Lands W Iv (PC.ptS e) k) (symH (comp-assoc W Y X Iv i g f)) l)
    (\ W f l -> substH (\ k -> PC.Lands W Iv (PC.ptS e) k) (comp-assoc W Y X Iv i g f) l) ;

module PB = CBase[a].CB[obV, homV, idH, compH, comp-idl, comp-idr, comp-assoc,
  \ X -> homV X Iv, \ Y X g i -> compH Y X Iv i g, \ X i -> comp-idr X Iv i, \ L K J g h i -> comp-assoc L K J Iv i g h,
  El Iv, e0, e1, \ X e -> constH X Iv e, constH-nat,
  PC.Phi, PC.pre, PC.Lands, PC.isProp-Lands, PC.lands-comp, PC.lands-pre, PC.pre-lands, PC.phi-ext,
  PC.emptyS, PC.empty-lands, PC.topS, PC.top-lands,
  \ W i e -> PC.pre W Iv i (PC.ptS e),
  \ Y X g i e -> endPre Y X g i e,
  \ W e g i -> transH (symH (comp-idr W Iv g)) (PC.lands-pt W e (compH W W Iv g (idH W)) (PC.lands-pre W W Iv g (PC.ptS e) (idH W) i)),
  \ W e -> PC.pre-lands W W Iv (constH W Iv e) (PC.ptS e) (idH W) (substH (\ k -> PC.Lands W Iv (PC.ptS e) k) (symH (comp-idr W Iv (constH W Iv e))) (PC.pt-lands W e)),
  \ W g i i' -> PC.pt-disj W (compH W W Iv g (idH W)) (PC.lands-pre W W Iv g (PC.ptS e0) (idH W) i) (PC.lands-pre W W Iv g (PC.ptS e1) (idH W) i'),
  PC.allS, PC.allS-sound, PC.allS-complete,
  PC.bigU, PC.bigU-in, PC.bigU-out,
  forallC, lands-forallC, forall-landsC,
  cIp, cIp-nat, cI-jsrc-t, cI-jsrc-f, cI-jtgt-t, cI-jtgt-f, cI-isrc-t, cI-isrc-f, cI-itgt-t, cI-itgt-f] ;

-- the interval of the poset base as an object, and its point sieves: the
-- form used by the files written at this base (PB.IvP W is Hom W ivO,
-- PB.endS W i e is PC.pre W ivO i (ptSO e), by computation)
ivO : Ob = Iv ;
ptSO (e : El Iv) : PC.Phi Iv = PC.ptS e ;
lands-ptO (W : Ob) (e : El Iv) (g : Hom W Iv) (i : PC.Lands W Iv (PC.ptS e) g) : Id (Hom W Iv) g (constH W Iv e) = PC.lands-pt W e g i ;
pt-landsO (W : Ob) (e : El Iv) : PC.Lands W Iv (PC.ptS e) (constH W Iv e) = PC.pt-lands W e ;
pt-disjO (W : Ob) (g : Hom W Iv) (i : PC.Lands W Iv (PC.ptS e0) g) (i' : PC.Lands W Iv (PC.ptS e1) g) : Empty = PC.pt-disj W g i i' ;
