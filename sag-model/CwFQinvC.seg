-- CwFQinvC.seg (M1 step 3, S4 toolkit): step C of Escardo's proof and
-- the theorem: a quasi-invertible map has contractible (co-based) fibres,
-- in a CwF with Pi, Sigma, Swan Id and naive function extensionality.
--
-- Informal text.  f : X -> Y, g : Y -> X, eta : g (f x) = x, eps :
-- f (g y) = y, w : Y.  T = FibE f w = Sigma x Id(f x , w), Q = FibE (f o g) w
-- = Sigma y Id(f (g y) , w), contractible by step B (CwFQinv).
-- (1) Helpers: a function along s (fAl); its weakening at a point (s , a)
--     is it (wkFAt); application at a point (appAt, compAt: (f o g) a =
--     f (g a)); the fibre family at a point (FamAt).
-- (2) The maps of contexts: sg (x , p) = (f x , tr_u p) with u = sym eta_x
--     : Id(x , g (f x)), and tu (y , q) = (g y , q).
-- (3) tu sg is the end point of the universal pair path (CwFPP) at
--     (g (f x) , u): both are (g (f x) , tr_u p) (extS-o, liftExtS,
--     extS-cong).  The pair path is the homotopy of CwFRetS, so T is a
--     retract of Q: contractible.

open Base ;

module QinvC (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module PP = CwFPP.PPth[l, C, PS, SS, IJ] ;
  module RS = CwFRetS.RetS[l, C, PS, SS, IJ] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;

  ----------------------------------------------------------------------
  -- (1) helpers

  fAl (D G : Ctx) (s : Sub D G) (A B : Ty G) (h : El G (Fun G A B)) : El D (Fun D (subT D G A s) (subT D G B s)) =
    trE D (subT D G (Fun G A B) s) (Fun D (subT D G A s) (subT D G B s))
      (Fun-ov D G A B s (subT D G A s) (refl (subT D G A s)) (subT D G B s) (refl (subT D G B s))) (subt D G (Fun G A B) h s) ;

  PFs (D G : Ctx) (X A B : Ty G) (s : Sub D G) (a : El D (subT D G X s))
    : Id (Ty D) (subT D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (extS D G X s a)) (Fun D (subT D G A s) (subT D G B s)) =
    Fun-ov D (ext G X) (wkT G X A) (wkT G X B) (extS D G X s a) (subT D G A s) (IN.wkT-extS D G X A s a) (subT D G B s) (IN.wkT-extS D G X B s a) ;

  -- a weakened function at a point is the function along s
  wkFAt (D G : Ctx) (X A B : Ty G) (h : El G (Fun G A B)) (s : Sub D G) (a : El D (subT D G X s))
    : Ov D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (extS D G X s a) (Fun D (subT D G A s) (subT D G B s)) (PFs D G X A B s a)
         (EQ.wkF G X A B h) (fAl D G s A B h) =
    IN.teAny D (subT D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (extS D G X s a)) (Fun D (subT D G A s) (subT D G B s))
      (subt D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (EQ.wkF G X A B h) (extS D G X s a)) (fAl D G s A B h)
      (IN.teT D (subT D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (extS D G X s a)) (subT D (ext G X) (wkT G X (Fun G A B)) (extS D G X s a))
                (Fun D (subT D G A s) (subT D G B s))
         (subt D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (EQ.wkF G X A B h) (extS D G X s a)) (subt D (ext G X) (wkT G X (Fun G A B)) (wkE G X (Fun G A B) h) (extS D G X s a))
         (fAl D G s A B h)
         (IN.teS D (subT D (ext G X) (wkT G X (Fun G A B)) (extS D G X s a)) (subT D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (extS D G X s a))
            (subt D (ext G X) (wkT G X (Fun G A B)) (wkE G X (Fun G A B) h) (extS D G X s a)) (subt D (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (EQ.wkF G X A B h) (extS D G X s a))
            (IN.teSubtTr D (ext G X) (wkT G X (Fun G A B)) (Fun (ext G X) (wkT G X A) (wkT G X B)) (EQ.wkFP G X A B) (wkE G X (Fun G A B) h) (extS D G X s a)))
         (IN.teT D (subT D (ext G X) (wkT G X (Fun G A B)) (extS D G X s a)) (subT D G (Fun G A B) s) (Fun D (subT D G A s) (subT D G B s))
            (subt D (ext G X) (wkT G X (Fun G A B)) (wkE G X (Fun G A B) h) (extS D G X s a)) (subt D G (Fun G A B) h s) (fAl D G s A B h)
            (IN.teOv D (ext G X) (wkT G X (Fun G A B)) (extS D G X s a) (subT D G (Fun G A B) s) (IN.wkT-extS D G X (Fun G A B) s a)
               (wkE G X (Fun G A B) h) (subt D G (Fun G A B) h s) (IN.wkE-extS D G X (Fun G A B) h s a (IN.wkT-extS D G X (Fun G A B) s a)))
            (IN.teTr D (subT D G (Fun G A B) s) (Fun D (subT D G A s) (subT D G B s))
               (Fun-ov D G A B s (subT D G A s) (refl (subT D G A s)) (subT D G B s) (refl (subT D G B s))) (subt D G (Fun G A B) h s))))
      (PFs D G X A B s a) ;

  -- app of a weakened function at the variable, at a point (s , a)
  appVar (D G : Ctx) (X B : Ty G) (h : El G (Fun G X B)) (s : Sub D G) (a : El D (subT D G X s))
    : Ov D (ext G X) (wkT G X B) (extS D G X s a) (subT D G B s) (IN.wkT-extS D G X B s a)
         (app (ext G X) (wkT G X X) (wkT G X B) (EQ.wkF G X X B h) (q G X)) (app D (subT D G X s) (subT D G B s) (fAl D G s X B h) a) =
    app-ov D (ext G X) (wkT G X X) (wkT G X B) (extS D G X s a) (subT D G X s) (IN.wkT-extS D G X X s a) (subT D G B s) (IN.wkT-extS D G X B s a)
      (PFs D G X X B s a) (EQ.wkF G X X B h) (fAl D G s X B h) (wkFAt D G X X B h s a) (q G X) a (JP.q-extS D G X s a (IN.wkT-extS D G X X s a)) ;

  -- the fibre family at a point
  FamAt (D G : Ctx) (X Y : Ty G) (e : El G (Fun G X Y)) (w : El G Y) (s : Sub D G) (a : El D (subT D G X s))
    : Id (Ty D) (subT D (ext G X) (QB.FamE G X Y e w) (extS D G X s a))
         (IJ.IdT D (subT D G Y s) (app D (subT D G X s) (subT D G Y s) (fAl D G s X Y e) a) (subt D G Y w s)) =
    Id-ov D (ext G X) (wkT G X Y) (app (ext G X) (wkT G X X) (wkT G X Y) (EQ.wkF G X X Y e) (q G X)) (wkE G X Y w) (extS D G X s a)
      (subT D G Y s) (IN.wkT-extS D G X Y s a) (app D (subT D G X s) (subT D G Y s) (fAl D G s X Y e) a) (subt D G Y w s)
      (appVar D G X Y e s a) (IN.wkE-extS D G X Y w s a (IN.wkT-extS D G X Y s a)) ;

  -- the body of a function, at a point (s , a), is the application of the
  -- function along s (bodNat)
  appAt (D G : Ctx) (A B : Ty G) (F : El G (Fun G A B)) (s : Sub D G) (a : El D (subT D G A s))
    : IN.TE D (subT D (ext G A) (wkT G A B) (extS D G A s a)) (subT D G B s)
         (subt D (ext G A) (wkT G A B) (bod G A (wkT G A B) F) (extS D G A s a)) (app D (subT D G A s) (subT D G B s) (fAl D G s A B F) a) =
    IN.teT D (subT D (ext G A) (wkT G A B) (extS D G A s a)) (subT D (ext D As) (subT (ext D As) (ext G A) (wkT G A B) L) (sec D As a)) (subT D G B s)
      (subt D (ext G A) (wkT G A B) bF (extS D G A s a)) (subt D (ext D As) (subT (ext D As) (ext G A) (wkT G A B) L) (subt (ext D As) (ext G A) (wkT G A B) bF L) (sec D As a))
      (app D As Bs (fAl D G s A B F) a)
      (IN.teSubtO D (ext D As) (ext G A) (wkT G A B) bF L (sec D As a))
      (IN.teT D (subT D (ext D As) (subT (ext D As) (ext G A) (wkT G A B) L) (sec D As a)) (subT D (ext D As) (wkT D As Bs) (sec D As a)) (subT D G B s)
         (subt D (ext D As) (subT (ext D As) (ext G A) (wkT G A B) L) (subt (ext D As) (ext G A) (wkT G A B) bF L) (sec D As a))
         (subt D (ext D As) (wkT D As Bs) (bod D As (wkT D As Bs) (fAl D G s A B F)) (sec D As a)) (app D As Bs (fAl D G s A B F) a)
         (SV.teSub D (ext D As) (subT (ext D As) (ext G A) (wkT G A B) L) (wkT D As Bs) (subt (ext D As) (ext G A) (wkT G A B) bF L) (bod D As (wkT D As Bs) (fAl D G s A B F))
            (p-lift-T D G A B s,
             sym (El (ext D As) (wkT D As Bs)) (bod D As (wkT D As Bs) (fAl D G s A B F))
               (trE (ext D As) (subT (ext D As) (ext G A) (wkT G A B) L) (wkT D As Bs) (p-lift-T D G A B s) (subt (ext D As) (ext G A) (wkT G A B) bF L))
               (bodNat D G A (wkT G A B) s (wkT D As Bs) (p-lift-T D G A B s)
                  (Fun-ov D G A B s As (refl As) Bs (refl Bs)) F))
            (sec D As a))
         (IN.teTr D (subT D (ext D As) (wkT D As Bs) (sec D As a)) Bs (p-sec-T D As Bs a) (subt D (ext D As) (wkT D As Bs) (bod D As (wkT D As Bs) (fAl D G s A B F)) (sec D As a))))
   where {
    As : Ty D = subT D G A s ;
    Bs : Ty D = subT D G B s ;
    L : Sub (ext D As) (ext G A) = lift D G A s ;
    bF : El (ext G A) (wkT G A B) = bod G A (wkT G A B) F ;
   } ;

  -- (f o g) along s at a is f (g a)
  fgq (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X)) : El (ext G Y) (wkT G Y Y) =
    app (ext G Y) (wkT G Y X) (wkT G Y Y) (EQ.wkF G Y X Y f) (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X g) (q G Y)) ;

  compAt (D G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X)) (s : Sub D G) (a : El D (subT D G Y s))
    : Id (El D (subT D G Y s))
         (app D (subT D G Y s) (subT D G Y s) (fAl D G s Y Y (lam G Y (wkT G Y Y) (fgq G X Y f g))) a)
         (app D (subT D G X s) (subT D G Y s) (fAl D G s X Y f) (app D (subT D G Y s) (subT D G X s) (fAl D G s Y X g) a)) =
    IN.teAny D (subT D G Y s) (subT D G Y s) LHS RHS
      (IN.teT D (subT D G Y s) (subT D (ext G Y) (wkT G Y Y) (extS D G Y s a)) (subT D G Y s) LHS (subt D (ext G Y) (wkT G Y Y) (fgq G X Y f g) (extS D G Y s a)) RHS
         (IN.teS D (subT D (ext G Y) (wkT G Y Y) (extS D G Y s a)) (subT D G Y s) (subt D (ext G Y) (wkT G Y Y) (fgq G X Y f g) (extS D G Y s a)) LHS
            (IN.teT D (subT D (ext G Y) (wkT G Y Y) (extS D G Y s a)) (subT D (ext G Y) (wkT G Y Y) (extS D G Y s a)) (subT D G Y s)
               (subt D (ext G Y) (wkT G Y Y) (fgq G X Y f g) (extS D G Y s a)) (subt D (ext G Y) (wkT G Y Y) (bod G Y (wkT G Y Y) fgY) (extS D G Y s a)) LHS
               (refl (subT D (ext G Y) (wkT G Y Y) (extS D G Y s a)),
                ap (El (ext G Y) (wkT G Y Y)) (El D (subT D (ext G Y) (wkT G Y Y) (extS D G Y s a))) (\ v -> subt D (ext G Y) (wkT G Y Y) v (extS D G Y s a))
                   (fgq G X Y f g) (bod G Y (wkT G Y Y) fgY)
                   (sym (El (ext G Y) (wkT G Y Y)) (bod G Y (wkT G Y Y) fgY) (fgq G X Y f g) ((PS.Pi-iso G Y (wkT G Y Y)).fun-inv (fgq G X Y f g))))
               (appAt D G Y Y fgY s a)))
         (IN.teOv D (ext G Y) (wkT G Y Y) (extS D G Y s a) (subT D G Y s) (IN.wkT-extS D G Y Y s a) (fgq G X Y f g) RHS
            (app-ov D (ext G Y) (wkT G Y X) (wkT G Y Y) (extS D G Y s a) (subT D G X s) (IN.wkT-extS D G Y X s a) (subT D G Y s) (IN.wkT-extS D G Y Y s a)
               (PFs D G Y X Y s a) (EQ.wkF G Y X Y f) (fAl D G s X Y f) (wkFAt D G Y X Y f s a)
               (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X g) (q G Y)) (app D (subT D G Y s) (subT D G X s) (fAl D G s Y X g) a)
               (appVar D G Y X g s a))))
      (refl (subT D G Y s))
   where {
    fgY : El G (Fun G Y Y) = lam G Y (wkT G Y Y) (fgq G X Y f g) ;
    LHS : El D (subT D G Y s) = app D (subT D G Y s) (subT D G Y s) (fAl D G s Y Y fgY) a ;
    RHS : El D (subT D G Y s) = app D (subT D G X s) (subT D G Y s) (fAl D G s X Y f) (app D (subT D G Y s) (subT D G X s) (fAl D G s Y X g) a) ;
   } ;

  -- lift s after (t , v)
  liftExtS (D' D G : Ctx) (B : Ty G) (s : Sub D G) (t : Sub D' D) (v : El D' (subT D' D (subT D G B s) t))
    : Id (Sub D' (ext G B)) (o D' (ext D (subT D G B s)) (ext G B) (lift D G B s) (extS D' D (subT D G B s) t v))
         (extS D' G B (o D' D G s t) (trE D' (subT D' D (subT D G B s) t) (subT D' G B (o D' D G s t))
                                        (sym (Ty D') (subT D' G B (o D' D G s t)) (subT D' D (subT D G B s) t) (subT-o D' D G B s t)) v)) =
    IN.ext-eq D' G B (o D' (ext D Bs) (ext G B) (lift D G B s) Xv) (extS D' G B (o D' D G s t) vr)
      (calc (Sub D' G) {
          o D' (ext G B) G (p G B) (o D' (ext D Bs) (ext G B) (lift D G B s) Xv)
        =< sym (Sub D' G) (o D' (ext D Bs) G (o (ext D Bs) (ext G B) G (p G B) (lift D G B s)) Xv) (o D' (ext G B) G (p G B) (o D' (ext D Bs) (ext G B) (lift D G B s) Xv))
              (o-assoc D' (ext D Bs) (ext G B) G (p G B) (lift D G B s) Xv) >
          o D' (ext D Bs) G (o (ext D Bs) (ext G B) G (p G B) (lift D G B s)) Xv
        =< ap (Sub (ext D Bs) G) (Sub D' G) (\ u -> o D' (ext D Bs) G u Xv) (o (ext D Bs) (ext G B) G (p G B) (lift D G B s)) (o (ext D Bs) D G s (p D Bs)) (p-lift D G B s) >
          o D' (ext D Bs) G (o (ext D Bs) D G s (p D Bs)) Xv
        =< o-assoc D' (ext D Bs) D G s (p D Bs) Xv >
          o D' D G s (o D' (ext D Bs) D (p D Bs) Xv)
        =< ap (Sub D' D) (Sub D' G) (\ u -> o D' D G s u) (o D' (ext D Bs) D (p D Bs) Xv) t (IN.p-extS D' D Bs t v) >
          o D' D G s t
        =< sym (Sub D' G) (o D' (ext G B) G (p G B) (extS D' G B (o D' D G s t) vr)) (o D' D G s t) (IN.p-extS D' G B (o D' D G s t) vr) >
          o D' (ext G B) G (p G B) (extS D' G B (o D' D G s t) vr) })
      (subT D' G B (o D' D G s t)) vr
      P1
      (JP.ovO D' (ext D Bs) (ext G B) (wkT G B B) (lift D G B s) Xv (wkT D Bs Bs) (p-lift-T D G B B s) (subT D' G B (o D' D G s t)) P2' P1
         (q G B) (q D Bs) vr
         (q-ov D G B s Bs (refl Bs) (p-lift-T D G B B s))
         (SV.ovThen D' (ext D Bs) (wkT D Bs Bs) Xv (subT D' D Bs t) (subT D' G B (o D' D G s t)) PW So' (q D Bs) v vr
            (JP.q-extS D' D Bs t v PW) (refl vr)))
      (IN.wkT-extS D' G B B (o D' D G s t) vr) (JP.q-extS D' G B (o D' D G s t) vr (IN.wkT-extS D' G B B (o D' D G s t) vr))
   where {
    Bs : Ty D = subT D G B s ;
    Xv : Sub D' (ext D Bs) = extS D' D Bs t v ;
    So' : Id (Ty D') (subT D' D Bs t) (subT D' G B (o D' D G s t)) = sym (Ty D') (subT D' G B (o D' D G s t)) (subT D' D Bs t) (subT-o D' D G B s t) ;
    vr : El D' (subT D' G B (o D' D G s t)) = trE D' (subT D' D Bs t) (subT D' G B (o D' D G s t)) So' v ;
    PW : Id (Ty D') (subT D' (ext D Bs) (wkT D Bs Bs) Xv) (subT D' D Bs t) = IN.wkT-extS D' D Bs Bs t v ;
    P2' : Id (Ty D') (subT D' (ext D Bs) (wkT D Bs Bs) Xv) (subT D' G B (o D' D G s t)) = trans (Ty D') (subT D' (ext D Bs) (wkT D Bs Bs) Xv) (subT D' D Bs t) (subT D' G B (o D' D G s t)) PW So' ;
    P1 : Id (Ty D') (subT D' (ext G B) (wkT G B B) (o D' (ext D Bs) (ext G B) (lift D G B s) Xv)) (subT D' G B (o D' D G s t)) =
      trans (Ty D') (subT D' (ext G B) (wkT G B B) (o D' (ext D Bs) (ext G B) (lift D G B s) Xv)) (subT D' (ext D Bs) (subT (ext D Bs) (ext G B) (wkT G B B) (lift D G B s)) Xv)
        (subT D' G B (o D' D G s t))
        (subT-o D' (ext D Bs) (ext G B) (wkT G B B) (lift D G B s) Xv)
        (trans (Ty D') (subT D' (ext D Bs) (subT (ext D Bs) (ext G B) (wkT G B B) (lift D G B s)) Xv) (subT D' (ext D Bs) (wkT D Bs Bs) Xv) (subT D' G B (o D' D G s t))
           (ap (Ty (ext D Bs)) (Ty D') (\ Z -> subT D' (ext D Bs) Z Xv) (subT (ext D Bs) (ext G B) (wkT G B B) (lift D G B s)) (wkT D Bs Bs) (p-lift-T D G B B s)) P2') ;
   } ;

  ----------------------------------------------------------------------
  -- (2), (3) step C

  module SCm (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X))
    (eta : El G (EQ.Htpy G Y X g f)) (eps : El G (EQ.Htpy G X Y f g)) (w : El G Y) {
    module B0 = QB.SB[G, X, Y, f, g, eps, w] ;
    Pf : Ty (ext G X) = QB.FamE G X Y f w ;
    Pm : Ty (ext G Y) = QB.FamE G Y Y B0.fgY w ;
    module VT = SV.At[G, X, Pf] ;
    module VQ = SV.At[G, Y, Pm] ;
    module PU = PP.UP[G, X, Pf] ;
    module RR = RS.R[G, X, Pf, Y, Pm] ;
    ET : Ctx = VT.E2 ;
    EQ2 : Ctx = VQ.E2 ;
    XT : Ty ET = subT ET G X VT.pp ;
    YT : Ty ET = subT ET G Y VT.pp ;
    fT : El ET (Fun ET XT YT) = fAl ET G VT.pp X Y f ;
    gT : El ET (Fun ET YT XT) = fAl ET G VT.pp Y X g ;
    fxT : El ET YT = app ET XT YT fT VT.zA ;
    bT : El ET XT = app ET YT XT gT fxT ;

    -- eta at the variable x
    gfq : El (ext G X) (wkT G X X) =
      app (ext G X) (wkT G X Y) (wkT G X X) (EQ.wkF G X Y X g) (app (ext G X) (wkT G X X) (wkT G X Y) (EQ.wkF G X X Y f) (q G X)) ;
    Fg : Ty (ext G X) = IJ.IdT (ext G X) (wkT G X X) gfq (q G X) ;
    xP : Sub ET (ext G X) = extS ET G X VT.pp VT.zA ;

    PFg : Id (Ty ET) (subT ET (ext G X) Fg xP) (IJ.IdT ET XT bT VT.zA) =
      Id-ov ET (ext G X) (wkT G X X) gfq (q G X) xP XT (IN.wkT-extS ET G X X VT.pp VT.zA) bT VT.zA
        (app-ov ET (ext G X) (wkT G X Y) (wkT G X X) xP YT (IN.wkT-extS ET G X Y VT.pp VT.zA) XT (IN.wkT-extS ET G X X VT.pp VT.zA)
           (PFs ET G X Y X VT.pp VT.zA) (EQ.wkF G X Y X g) gT (wkFAt ET G X Y X g VT.pp VT.zA)
           (app (ext G X) (wkT G X X) (wkT G X Y) (EQ.wkF G X X Y f) (q G X)) fxT (appVar ET G X Y f VT.pp VT.zA))
        (JP.q-extS ET G X VT.pp VT.zA (IN.wkT-extS ET G X X VT.pp VT.zA)) ;

    etaX : El ET (IJ.IdT ET XT bT VT.zA) =
      trE ET (subT ET (ext G X) Fg xP) (IJ.IdT ET XT bT VT.zA) PFg (subt ET (ext G X) Fg (bod G X Fg eta) xP) ;

    u : El ET (IJ.IdT ET XT VT.zA bT) = PT.symM ET XT bT VT.zA etaX ;

    trp : El ET (subT ET VT.E3 VT.Bl (sec ET XT bT)) = TR.trP ET XT VT.Bl VT.zA bT u VT.bB ;

    -- (2) the maps
    sY : Sub ET (ext G Y) = extS ET G Y VT.pp fxT ;

    So3 : Id (Ty ET) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (subT ET VT.E3 VT.Bl (sec ET XT bT)) =
      subT-o ET VT.E3 (ext G X) Pf (lift ET G X VT.pp) (sec ET XT bT) ;

    PbS : Id (Ty ET) (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G Y) Pm sY) =
      trans (Ty ET) (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (subT ET (ext G Y) Pm sY)
        (sym (Ty ET) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (subT ET VT.E3 VT.Bl (sec ET XT bT)) So3)
        (trans (Ty ET) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (IJ.IdT ET YT (app ET XT YT fT bT) (subt ET G Y w VT.pp)) (subT ET (ext G Y) Pm sY)
           (FamAt ET G X Y f w VT.pp bT)
           (trans (Ty ET) (IJ.IdT ET YT (app ET XT YT fT bT) (subt ET G Y w VT.pp)) (IJ.IdT ET YT (app ET YT YT (fAl ET G VT.pp Y Y B0.fgY) fxT) (subt ET G Y w VT.pp))
              (subT ET (ext G Y) Pm sY)
              (ap (El ET YT) (Ty ET) (\ v -> IJ.IdT ET YT v (subt ET G Y w VT.pp)) (app ET XT YT fT bT) (app ET YT YT (fAl ET G VT.pp Y Y B0.fgY) fxT)
                  (sym (El ET YT) (app ET YT YT (fAl ET G VT.pp Y Y B0.fgY) fxT) (app ET XT YT fT bT) (compAt ET G X Y f g VT.pp fxT)))
              (sym (Ty ET) (subT ET (ext G Y) Pm sY) (IJ.IdT ET YT (app ET YT YT (fAl ET G VT.pp Y Y B0.fgY) fxT) (subt ET G Y w VT.pp))
                 (FamAt ET G Y Y B0.fgY w VT.pp fxT)))) ;

    bS : El ET (subT ET (ext G Y) Pm sY) = trE ET (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G Y) Pm sY) PbS trp ;

    sg : Sub ET EQ2 = extS ET (ext G Y) Pm sY bS ;

    esg : Id (Sub ET G) (o ET EQ2 G VQ.pp sg) VT.pp =
      calc (Sub ET G) {
          o ET EQ2 G (o EQ2 (ext G Y) G (p G Y) VQ.p2) sg
        =< o-assoc ET EQ2 (ext G Y) G (p G Y) VQ.p2 sg >
          o ET (ext G Y) G (p G Y) (o ET EQ2 (ext G Y) VQ.p2 sg)
        =< ap (Sub ET (ext G Y)) (Sub ET G) (\ t -> o ET (ext G Y) G (p G Y) t) (o ET EQ2 (ext G Y) VQ.p2 sg) sY (IN.p-extS ET (ext G Y) Pm sY bS) >
          o ET (ext G Y) G (p G Y) sY
        =< IN.p-extS ET G Y VT.pp fxT >
          VT.pp } ;

    YQ : Ty EQ2 = subT EQ2 G Y VQ.pp ;
    XQ : Ty EQ2 = subT EQ2 G X VQ.pp ;
    gQ : El EQ2 (Fun EQ2 YQ XQ) = fAl EQ2 G VQ.pp Y X g ;
    fQ : El EQ2 (Fun EQ2 XQ YQ) = fAl EQ2 G VQ.pp X Y f ;
    gyQ : El EQ2 XQ = app EQ2 YQ XQ gQ VQ.zA ;
    tX : Sub EQ2 (ext G X) = extS EQ2 G X VQ.pp gyQ ;

    PbU : Id (Ty EQ2) VQ.Bz (subT EQ2 (ext G X) Pf tX) =
      trans (Ty EQ2) VQ.Bz (subT EQ2 (ext G Y) Pm (extS EQ2 G Y VQ.pp VQ.zA)) (subT EQ2 (ext G X) Pf tX)
        (sym (Ty EQ2) (subT EQ2 (ext G Y) Pm (extS EQ2 G Y VQ.pp VQ.zA)) VQ.Bz (subT-o EQ2 VQ.E3 (ext G Y) Pm (lift EQ2 G Y VQ.pp) (sec EQ2 VQ.App VQ.zA)))
        (trans (Ty EQ2) (subT EQ2 (ext G Y) Pm (extS EQ2 G Y VQ.pp VQ.zA)) (IJ.IdT EQ2 YQ (app EQ2 YQ YQ (fAl EQ2 G VQ.pp Y Y B0.fgY) VQ.zA) (subt EQ2 G Y w VQ.pp))
           (subT EQ2 (ext G X) Pf tX)
           (FamAt EQ2 G Y Y B0.fgY w VQ.pp VQ.zA)
           (trans (Ty EQ2) (IJ.IdT EQ2 YQ (app EQ2 YQ YQ (fAl EQ2 G VQ.pp Y Y B0.fgY) VQ.zA) (subt EQ2 G Y w VQ.pp)) (IJ.IdT EQ2 YQ (app EQ2 XQ YQ fQ gyQ) (subt EQ2 G Y w VQ.pp))
              (subT EQ2 (ext G X) Pf tX)
              (ap (El EQ2 YQ) (Ty EQ2) (\ v -> IJ.IdT EQ2 YQ v (subt EQ2 G Y w VQ.pp)) (app EQ2 YQ YQ (fAl EQ2 G VQ.pp Y Y B0.fgY) VQ.zA) (app EQ2 XQ YQ fQ gyQ)
                  (compAt EQ2 G X Y f g VQ.pp VQ.zA))
              (sym (Ty EQ2) (subT EQ2 (ext G X) Pf tX) (IJ.IdT EQ2 YQ (app EQ2 XQ YQ fQ gyQ) (subt EQ2 G Y w VQ.pp)) (FamAt EQ2 G X Y f w VQ.pp gyQ)))) ;

    bU : El EQ2 (subT EQ2 (ext G X) Pf tX) = trE EQ2 VQ.Bz (subT EQ2 (ext G X) Pf tX) PbU VQ.bB ;

    tu : Sub EQ2 ET = extS EQ2 (ext G X) Pf tX bU ;

    etu : Id (Sub EQ2 G) (o EQ2 ET G VT.pp tu) VQ.pp =
      calc (Sub EQ2 G) {
          o EQ2 ET G (o ET (ext G X) G (p G X) VT.p2) tu
        =< o-assoc EQ2 ET (ext G X) G (p G X) VT.p2 tu >
          o EQ2 (ext G X) G (p G X) (o EQ2 ET (ext G X) VT.p2 tu)
        =< ap (Sub EQ2 (ext G X)) (Sub EQ2 G) (\ t -> o EQ2 (ext G X) G (p G X) t) (o EQ2 ET (ext G X) VT.p2 tu) tX (IN.p-extS EQ2 (ext G X) Pf tX bU) >
          o EQ2 (ext G X) G (p G X) tX
        =< IN.p-extS EQ2 G X VQ.pp gyQ >
          VQ.pp } ;

    module M0 = RR.M[sg, esg, tu, etu] ;

    -- (3) both tu sg and the end of the pair path are NF0 = (g (f x) , tr_u p)
    trp' : El ET (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) =
      trE ET (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (sym (Ty ET) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (subT ET VT.E3 VT.Bl (sec ET XT bT)) So3) trp ;
    NF0 : Sub ET ET = extS ET (ext G X) Pf (extS ET G X VT.pp bT) trp' ;

    pt : Sub ET PU.Om = PU.ptO bT u ;
    Xo : Sub PU.Om (ext VT.E3 VT.Bl) = extS PU.Om VT.E3 VT.Bl PU.pO PU.JTw ;
    pinst : Id (Sub ET VT.E3) (o ET PU.Om VT.E3 PU.pO pt) (sec ET XT bT) =
      JP.p-inst ET XT PU.IKz bT (IJ.IdT ET XT VT.zA bT) (JP.IKpt ET XT VT.zA bT) u ;
    SoJ : Id (Ty ET) (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) = subT-o ET PU.Om VT.E3 VT.Bl PU.pO pt ;
    jt : El ET (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) =
      trE ET (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt))
        (sym (Ty ET) (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) SoJ)
        (subt ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) PU.JTw pt) ;

    ej : Id (El ET (subT ET VT.E3 VT.Bl (sec ET XT bT)))
            (trE ET (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subT ET VT.E3 VT.Bl (sec ET XT bT))
               (ap (Sub ET VT.E3) (Ty ET) (\ t -> subT ET VT.E3 VT.Bl t) (o ET PU.Om VT.E3 PU.pO pt) (sec ET XT bT) pinst) jt)
            trp =
      IN.teAny ET (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subT ET VT.E3 VT.Bl (sec ET XT bT)) jt trp
        (IN.teT ET (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) (subT ET VT.E3 VT.Bl (sec ET XT bT))
           jt (subt ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) PU.JTw pt) trp
           (IN.teS ET (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subt ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) PU.JTw pt) jt
              (IN.teTr ET (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt))
                 (sym (Ty ET) (subT ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt)) (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) SoJ)
                 (subt ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) PU.JTw pt)))
           (IN.teTr ET (subT ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) pt) (subT ET VT.E3 VT.Bl (sec ET XT bT)) (TR.PPt ET XT VT.Bl VT.zA bT u)
              (subt ET PU.Om (subT PU.Om VT.E3 VT.Bl PU.pO) PU.JTw pt)))
        (ap (Sub ET VT.E3) (Ty ET) (\ t -> subT ET VT.E3 VT.Bl t) (o ET PU.Om VT.E3 PU.pO pt) (sec ET XT bT) pinst) ;

    eA : Id (Sub ET ET) (o ET PU.Om ET PU.rEnd pt) NF0 =
      calc (Sub ET ET) {
          o ET PU.Om ET (o PU.Om (ext VT.E3 VT.Bl) ET PU.LL Xo) pt
        =< o-assoc ET PU.Om (ext VT.E3 VT.Bl) ET PU.LL Xo pt >
          o ET (ext VT.E3 VT.Bl) ET PU.LL (o ET PU.Om (ext VT.E3 VT.Bl) Xo pt)
        =< ap (Sub ET (ext VT.E3 VT.Bl)) (Sub ET ET) (\ t -> o ET (ext VT.E3 VT.Bl) ET PU.LL t) (o ET PU.Om (ext VT.E3 VT.Bl) Xo pt)
              (extS ET VT.E3 VT.Bl (sec ET XT bT) trp)
              (trans (Sub ET (ext VT.E3 VT.Bl)) (o ET PU.Om (ext VT.E3 VT.Bl) Xo pt) (extS ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt) jt) (extS ET VT.E3 VT.Bl (sec ET XT bT) trp)
                 (SV.extS-o ET PU.Om VT.E3 VT.Bl PU.pO PU.JTw pt)
                 (IN.extS-cong ET VT.E3 VT.Bl (o ET PU.Om VT.E3 PU.pO pt) (sec ET XT bT) pinst jt trp ej)) >
          o ET (ext VT.E3 VT.Bl) ET PU.LL (extS ET VT.E3 VT.Bl (sec ET XT bT) trp)
        =< liftExtS ET VT.E3 (ext G X) Pf (lift ET G X VT.pp) (sec ET XT bT) trp >
          NF0 } ;

    -- tu sg
    PYs : Id (Ty ET) (subT ET EQ2 YQ sg) YT =
      trans (Ty ET) (subT ET EQ2 YQ sg) (subT ET G Y (o ET EQ2 G VQ.pp sg)) YT
        (sym (Ty ET) (subT ET G Y (o ET EQ2 G VQ.pp sg)) (subT ET EQ2 YQ sg) (subT-o ET EQ2 G Y VQ.pp sg))
        (ap (Sub ET G) (Ty ET) (\ t -> subT ET G Y t) (o ET EQ2 G VQ.pp sg) VT.pp esg) ;
    PXs : Id (Ty ET) (subT ET EQ2 XQ sg) XT =
      trans (Ty ET) (subT ET EQ2 XQ sg) (subT ET G X (o ET EQ2 G VQ.pp sg)) XT
        (sym (Ty ET) (subT ET G X (o ET EQ2 G VQ.pp sg)) (subT ET EQ2 XQ sg) (subT-o ET EQ2 G X VQ.pp sg))
        (ap (Sub ET G) (Ty ET) (\ t -> subT ET G X t) (o ET EQ2 G VQ.pp sg) VT.pp esg) ;
    PFsg : Id (Ty ET) (subT ET EQ2 (Fun EQ2 YQ XQ) sg) (Fun ET YT XT) = Fun-ov ET EQ2 YQ XQ sg YT PYs XT PXs ;

    Pg : Ov ET EQ2 (Fun EQ2 YQ XQ) sg (Fun ET YT XT) PFsg gQ gT =
      IN.teAny ET (subT ET EQ2 (Fun EQ2 YQ XQ) sg) (Fun ET YT XT) (subt ET EQ2 (Fun EQ2 YQ XQ) gQ sg) gT
        (IN.teT ET (subT ET EQ2 (Fun EQ2 YQ XQ) sg) (subT ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) sg) (Fun ET YT XT)
           (subt ET EQ2 (Fun EQ2 YQ XQ) gQ sg) (subt ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) (subt EQ2 G (Fun G Y X) g VQ.pp) sg) gT
           (IN.teS ET (subT ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) sg) (subT ET EQ2 (Fun EQ2 YQ XQ) sg)
              (subt ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) (subt EQ2 G (Fun G Y X) g VQ.pp) sg) (subt ET EQ2 (Fun EQ2 YQ XQ) gQ sg)
              (IN.teSubtTr ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) (Fun EQ2 YQ XQ) (Fun-ov EQ2 G Y X VQ.pp YQ (refl YQ) XQ (refl XQ)) (subt EQ2 G (Fun G Y X) g VQ.pp) sg))
           (IN.teT ET (subT ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) sg) (subT ET G (Fun G Y X) (o ET EQ2 G VQ.pp sg)) (Fun ET YT XT)
              (subt ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) (subt EQ2 G (Fun G Y X) g VQ.pp) sg) (subt ET G (Fun G Y X) g (o ET EQ2 G VQ.pp sg)) gT
              (IN.teS ET (subT ET G (Fun G Y X) (o ET EQ2 G VQ.pp sg)) (subT ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) sg)
                 (subt ET G (Fun G Y X) g (o ET EQ2 G VQ.pp sg)) (subt ET EQ2 (subT EQ2 G (Fun G Y X) VQ.pp) (subt EQ2 G (Fun G Y X) g VQ.pp) sg)
                 (IN.teSubtO ET EQ2 G (Fun G Y X) g VQ.pp sg))
              (IN.teT ET (subT ET G (Fun G Y X) (o ET EQ2 G VQ.pp sg)) (subT ET G (Fun G Y X) VT.pp) (Fun ET YT XT)
                 (subt ET G (Fun G Y X) g (o ET EQ2 G VQ.pp sg)) (subt ET G (Fun G Y X) g VT.pp) gT
                 (IN.teSubEq ET G (Fun G Y X) g (o ET EQ2 G VQ.pp sg) VT.pp esg)
                 (IN.teTr ET (subT ET G (Fun G Y X) VT.pp) (Fun ET YT XT) (Fun-ov ET G Y X VT.pp YT (refl YT) XT (refl XT)) (subt ET G (Fun G Y X) g VT.pp)))))
        PFsg ;

    Py : Ov ET EQ2 YQ sg YT PYs VQ.zA fxT =
      IN.teAny ET (subT ET EQ2 YQ sg) YT (subt ET EQ2 YQ VQ.zA sg) fxT
        (IN.teT ET (subT ET EQ2 YQ sg) (subT ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) sg) YT
           (subt ET EQ2 YQ VQ.zA sg) (subt ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) (subt EQ2 (ext G Y) (wkT G Y Y) (q G Y) VQ.p2) sg) fxT
           (IN.teS ET (subT ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) sg) (subT ET EQ2 YQ sg)
              (subt ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) (subt EQ2 (ext G Y) (wkT G Y Y) (q G Y) VQ.p2) sg) (subt ET EQ2 YQ VQ.zA sg)
              (IN.teSubtTr ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) YQ
                 (sym (Ty EQ2) YQ (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) (subT-o EQ2 (ext G Y) G Y (p G Y) VQ.p2))
                 (subt EQ2 (ext G Y) (wkT G Y Y) (q G Y) VQ.p2) sg))
           (IN.teT ET (subT ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) sg) (subT ET (ext G Y) (wkT G Y Y) (o ET EQ2 (ext G Y) VQ.p2 sg)) YT
              (subt ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) (subt EQ2 (ext G Y) (wkT G Y Y) (q G Y) VQ.p2) sg) (subt ET (ext G Y) (wkT G Y Y) (q G Y) (o ET EQ2 (ext G Y) VQ.p2 sg)) fxT
              (IN.teS ET (subT ET (ext G Y) (wkT G Y Y) (o ET EQ2 (ext G Y) VQ.p2 sg)) (subT ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) sg)
                 (subt ET (ext G Y) (wkT G Y Y) (q G Y) (o ET EQ2 (ext G Y) VQ.p2 sg)) (subt ET EQ2 (subT EQ2 (ext G Y) (wkT G Y Y) VQ.p2) (subt EQ2 (ext G Y) (wkT G Y Y) (q G Y) VQ.p2) sg)
                 (IN.teSubtO ET EQ2 (ext G Y) (wkT G Y Y) (q G Y) VQ.p2 sg))
              (IN.teT ET (subT ET (ext G Y) (wkT G Y Y) (o ET EQ2 (ext G Y) VQ.p2 sg)) (subT ET (ext G Y) (wkT G Y Y) sY) YT
                 (subt ET (ext G Y) (wkT G Y Y) (q G Y) (o ET EQ2 (ext G Y) VQ.p2 sg)) (subt ET (ext G Y) (wkT G Y Y) (q G Y) sY) fxT
                 (IN.teSubEq ET (ext G Y) (wkT G Y Y) (q G Y) (o ET EQ2 (ext G Y) VQ.p2 sg) sY (IN.p-extS ET (ext G Y) Pm sY bS))
                 (IN.teOv ET (ext G Y) (wkT G Y Y) sY YT (IN.wkT-extS ET G Y Y VT.pp fxT) (q G Y) fxT (JP.q-extS ET G Y VT.pp fxT (IN.wkT-extS ET G Y Y VT.pp fxT))))))
        PYs ;

    gyr : El ET (subT ET G X (o ET EQ2 G VQ.pp sg)) =
      trE ET (subT ET EQ2 XQ sg) (subT ET G X (o ET EQ2 G VQ.pp sg)) (sym (Ty ET) (subT ET G X (o ET EQ2 G VQ.pp sg)) (subT ET EQ2 XQ sg) (subT-o ET EQ2 G X VQ.pp sg))
        (subt ET EQ2 XQ gyQ sg) ;

    egy : Id (El ET XT) (trE ET (subT ET G X (o ET EQ2 G VQ.pp sg)) XT (ap (Sub ET G) (Ty ET) (\ t -> subT ET G X t) (o ET EQ2 G VQ.pp sg) VT.pp esg) gyr) bT =
      trans (El ET XT) (trE ET (subT ET G X (o ET EQ2 G VQ.pp sg)) XT (ap (Sub ET G) (Ty ET) (\ t -> subT ET G X t) (o ET EQ2 G VQ.pp sg) VT.pp esg) gyr)
        (trE ET (subT ET EQ2 XQ sg) XT PXs (subt ET EQ2 XQ gyQ sg)) bT
        (trE-tr ET (subT ET EQ2 XQ sg) (subT ET G X (o ET EQ2 G VQ.pp sg)) XT
           (sym (Ty ET) (subT ET G X (o ET EQ2 G VQ.pp sg)) (subT ET EQ2 XQ sg) (subT-o ET EQ2 G X VQ.pp sg))
           (ap (Sub ET G) (Ty ET) (\ t -> subT ET G X t) (o ET EQ2 G VQ.pp sg) VT.pp esg) (subt ET EQ2 XQ gyQ sg))
        (app-ov ET EQ2 YQ XQ sg YT PYs XT PXs PFsg gQ gT Pg VQ.zA fxT Py) ;

    etX : Id (Sub ET (ext G X)) (o ET EQ2 (ext G X) tX sg) (extS ET G X VT.pp bT) =
      trans (Sub ET (ext G X)) (o ET EQ2 (ext G X) tX sg) (extS ET G X (o ET EQ2 G VQ.pp sg) gyr) (extS ET G X VT.pp bT)
        (SV.extS-o ET EQ2 G X VQ.pp gyQ sg)
        (IN.extS-cong ET G X (o ET EQ2 G VQ.pp sg) VT.pp esg gyr bT egy) ;

    bu : El ET (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) =
      trE ET (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg))
        (sym (Ty ET) (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT-o ET EQ2 (ext G X) Pf tX sg))
        (subt ET EQ2 (subT EQ2 (ext G X) Pf tX) bU sg) ;

    ebu : Id (El ET (subT ET (ext G X) Pf (extS ET G X VT.pp bT)))
             (trE ET (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) (subT ET (ext G X) Pf (extS ET G X VT.pp bT))
                (ap (Sub ET (ext G X)) (Ty ET) (\ t -> subT ET (ext G X) Pf t) (o ET EQ2 (ext G X) tX sg) (extS ET G X VT.pp bT) etX) bu)
             trp' =
      IN.teAny ET (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) bu trp'
        (IN.teT ET (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT ET (ext G X) Pf (extS ET G X VT.pp bT))
           bu (subt ET EQ2 (subT EQ2 (ext G X) Pf tX) bU sg) trp'
           (IN.teS ET (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) (subt ET EQ2 (subT EQ2 (ext G X) Pf tX) bU sg) bu
              (IN.teTr ET (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg))
                 (sym (Ty ET) (subT ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg)) (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT-o ET EQ2 (ext G X) Pf tX sg))
                 (subt ET EQ2 (subT EQ2 (ext G X) Pf tX) bU sg)))
           (IN.teT ET (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subT ET EQ2 VQ.Bz sg) (subT ET (ext G X) Pf (extS ET G X VT.pp bT))
              (subt ET EQ2 (subT EQ2 (ext G X) Pf tX) bU sg) (subt ET EQ2 VQ.Bz VQ.bB sg) trp'
              (IN.teS ET (subT ET EQ2 VQ.Bz sg) (subT ET EQ2 (subT EQ2 (ext G X) Pf tX) sg) (subt ET EQ2 VQ.Bz VQ.bB sg) (subt ET EQ2 (subT EQ2 (ext G X) Pf tX) bU sg)
                 (IN.teSubtTr ET EQ2 VQ.Bz (subT EQ2 (ext G X) Pf tX) PbU VQ.bB sg))
              (IN.teT ET (subT ET EQ2 VQ.Bz sg) (subT ET EQ2 (wkT (ext G Y) Pm Pm) sg) (subT ET (ext G X) Pf (extS ET G X VT.pp bT))
                 (subt ET EQ2 VQ.Bz VQ.bB sg) (subt ET EQ2 (wkT (ext G Y) Pm Pm) (q (ext G Y) Pm) sg) trp'
                 (IN.teS ET (subT ET EQ2 (wkT (ext G Y) Pm Pm) sg) (subT ET EQ2 VQ.Bz sg) (subt ET EQ2 (wkT (ext G Y) Pm Pm) (q (ext G Y) Pm) sg) (subt ET EQ2 VQ.Bz VQ.bB sg)
                    (IN.teSubtTr ET EQ2 (wkT (ext G Y) Pm Pm) VQ.Bz VQ.bP (q (ext G Y) Pm) sg))
                 (IN.teT ET (subT ET EQ2 (wkT (ext G Y) Pm Pm) sg) (subT ET (ext G Y) Pm sY) (subT ET (ext G X) Pf (extS ET G X VT.pp bT))
                    (subt ET EQ2 (wkT (ext G Y) Pm Pm) (q (ext G Y) Pm) sg) bS trp'
                    (IN.teOv ET EQ2 (wkT (ext G Y) Pm Pm) sg (subT ET (ext G Y) Pm sY) (IN.wkT-extS ET (ext G Y) Pm Pm sY bS) (q (ext G Y) Pm) bS
                       (JP.q-extS ET (ext G Y) Pm sY bS (IN.wkT-extS ET (ext G Y) Pm Pm sY bS)))
                    (IN.teT ET (subT ET (ext G Y) Pm sY) (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) bS trp trp'
                       (IN.teS ET (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G Y) Pm sY) trp bS (IN.teTr ET (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G Y) Pm sY) PbS trp))
                       (IN.teTr ET (subT ET VT.E3 VT.Bl (sec ET XT bT)) (subT ET (ext G X) Pf (extS ET G X VT.pp bT))
                          (sym (Ty ET) (subT ET (ext G X) Pf (extS ET G X VT.pp bT)) (subT ET VT.E3 VT.Bl (sec ET XT bT)) So3) trp))))))
        (ap (Sub ET (ext G X)) (Ty ET) (\ t -> subT ET (ext G X) Pf t) (o ET EQ2 (ext G X) tX sg) (extS ET G X VT.pp bT) etX) ;

    eB : Id (Sub ET ET) (o ET EQ2 ET tu sg) NF0 =
      trans (Sub ET ET) (o ET EQ2 ET tu sg) (extS ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg) bu) NF0
        (SV.extS-o ET EQ2 (ext G X) Pf tX bU sg)
        (IN.extS-cong ET (ext G X) Pf (o ET EQ2 (ext G X) tX sg) (extS ET G X VT.pp bT) etX bu trp' ebu) ;

    er : Id (Sub ET ET) (o ET PU.Om ET PU.rEnd pt) (o ET EQ2 ET tu sg) =
      trans (Sub ET ET) (o ET PU.Om ET PU.rEnd pt) NF0 (o ET EQ2 ET tu sg) eA (sym (Sub ET ET) (o ET EQ2 ET tu sg) NF0 eB) ;

    H : El ET (IJ.IdT ET VT.SW M0.LH VT.pv) = PU.ppAt bT u (o ET EQ2 ET tu sg) er M0.ets ;

    kFib : El G (EQ.isContr G (QB.FibE G X Y f w)) = M0.HM[H].retE B0.kM ;
  } ;

  -- a quasi-invertible map has contractible fibres, at any point w
  qinvC (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X))
    (eta : El G (EQ.Htpy G Y X g f)) (eps : El G (EQ.Htpy G X Y f g)) (w : El G Y)
    : El G (EQ.isContr G (QB.FibE G X Y f w)) = SCm[G, X, Y, f, g, eta, eps, w].kFib ;
} ;
