-- CwFSig.seg (M1 step 3, S4 toolkit): Sigma types and two context
-- extensions, in a CwF with Pi, Sigma and Swan Id.
--
-- For B over G.A write E2 = G.A.B and pp : E2 -> G the double projection.
--
-- Informal text.
-- (1) liftComp: if s1 s2 = s, then lift s1 after the lift of s2 (read
--     along any path A[s1][s2] = A[s]) is lift s: lift-o, a transport
--     commuting with postcomposition, and types forming a set.
-- (2) The pair of the variables pv : (Sigma A B)[pp] over E2 is
--     pr(z , b) with z the variable of A (CwFInt.qOf) and b the variable
--     of B read at (pp , z) (sub-eta: p = (pp , z)).
-- (3) At a point (s , a , b) of E2 over D, pv is pr(a , b): pr-ov along
--     the point, with leaves wkE-extS, q-extS and (1) for the family.
-- (4) unpk : G.(Sigma A B) -> E2 is the point (p , fst q , snd q); pv along
--     unpk is q (by (3) and Sig-iso's inv-fun).

open Base ;

module SigV (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;

  -- an over-path followed by a transport of the target
  ovThen (D G : Ctx) (A : Ty G) (s : Sub D G) (A1 A2 : Ty D) (P : Id (Ty D) (subT D G A s) A1) (Q : Id (Ty D) A1 A2)
    (a : El G A) (a1 : El D A1) (a2 : El D A2) (e1 : Ov D G A s A1 P a a1) (e2 : Id (El D A2) (trE D A1 A2 Q a1) a2)
    : Ov D G A s A2 (trans (Ty D) (subT D G A s) A1 A2 P Q) a a2 =
    trans (El D A2) (trE D (subT D G A s) A2 (trans (Ty D) (subT D G A s) A1 A2 P Q) (subt D G A a s))
      (trE D A1 A2 Q (trE D (subT D G A s) A1 P (subt D G A a s))) a2
      (sym (El D A2) (trE D A1 A2 Q (trE D (subT D G A s) A1 P (subt D G A a s)))
           (trE D (subT D G A s) A2 (trans (Ty D) (subT D G A s) A1 A2 P Q) (subt D G A a s))
           (trE-tr D (subT D G A s) A1 A2 P Q (subt D G A a s)))
      (trans (El D A2) (trE D A1 A2 Q (trE D (subT D G A s) A1 P (subt D G A a s))) (trE D A1 A2 Q a1) a2
         (ap (El D A1) (El D A2) (\ v -> trE D A1 A2 Q v) (trE D (subT D G A s) A1 P (subt D G A a s)) a1 e1)
         e2) ;

  ----------------------------------------------------------------------
  -- (1) lifts compose

  substPost (D E G : Ctx) (A1 : Ty E) (A : Ty G) (X0 X1 : Ty D) (PA : Id (Ty D) X0 X1)
    (M : Sub (ext E A1) (ext G A)) (L : Sub (ext D X0) (ext E A1))
    : Id (Sub (ext D X1) (ext G A))
         (o (ext D X1) (ext E A1) (ext G A) M (subst (Ty D) (\ X -> Sub (ext D X) (ext E A1)) X0 X1 PA L))
         (subst (Ty D) (\ X -> Sub (ext D X) (ext G A)) X0 X1 PA (o (ext D X0) (ext E A1) (ext G A) M L)) =
    idJ (Ty D) X0
      (\ X PX -> Id (Sub (ext D X) (ext G A))
                    (o (ext D X) (ext E A1) (ext G A) M (subst (Ty D) (\ X2 -> Sub (ext D X2) (ext E A1)) X0 X PX L))
                    (subst (Ty D) (\ X2 -> Sub (ext D X2) (ext G A)) X0 X PX (o (ext D X0) (ext E A1) (ext G A) M L)))
      (refl (o (ext D X0) (ext E A1) (ext G A) M L)) X1 PA ;

  liftComp (D E G : Ctx) (A : Ty G) (s1 : Sub E G) (s2 : Sub D E) (s : Sub D G) (e : Id (Sub D G) (o D E G s1 s2) s)
    (PA : Id (Ty D) (subT D E (subT E G A s1) s2) (subT D G A s))
    : Id (Sub (ext D (subT D G A s)) (ext G A))
         (o (ext D (subT D G A s)) (ext E (subT E G A s1)) (ext G A) (lift E G A s1) (upT D E (subT E G A s1) s2 (subT D G A s) PA))
         (lift D G A s) =
    idJ (Sub D G) (o D E G s1 s2)
      (\ t et -> (PA2 : Id (Ty D) (subT D E (subT E G A s1) s2) (subT D G A t))
         -> Id (Sub (ext D (subT D G A t)) (ext G A))
               (o (ext D (subT D G A t)) (ext E (subT E G A s1)) (ext G A) (lift E G A s1) (upT D E (subT E G A s1) s2 (subT D G A t) PA2))
               (lift D G A t))
      (\ PA2 ->
         calc (Sub (ext D A0) (ext G A)) {
             o (ext D A0) (ext E A1) (ext G A) (lift E G A s1) (upT D E A1 s2 A0 PA2)
           =< substPost D E G A1 A A12 A0 PA2 (lift E G A s1) (lift D E A1 s2) >
             subst (Ty D) F A12 A0 PA2 (o (ext D A12) (ext E A1) (ext G A) (lift E G A s1) (lift D E A1 s2))
           =< ap (F A12) (F A0) (\ v -> subst (Ty D) F A12 A0 PA2 v)
                 (o (ext D A12) (ext E A1) (ext G A) (lift E G A s1) (lift D E A1 s2))
                 (subst (Ty D) F A0 A12 So (lift D G A (o D E G s1 s2)))
                 (sym (F A12) (subst (Ty D) F A0 A12 So (lift D G A (o D E G s1 s2)))
                      (o (ext D A12) (ext E A1) (ext G A) (lift E G A s1) (lift D E A1 s2))
                      (lift-o D E G A s1 s2)) >
             subst (Ty D) F A12 A0 PA2 (subst (Ty D) F A0 A12 So (lift D G A (o D E G s1 s2)))
           =< sym (F A0) (subst (Ty D) F A0 A0 (trans (Ty D) A0 A12 A0 So PA2) (lift D G A (o D E G s1 s2)))
                 (subst (Ty D) F A12 A0 PA2 (subst (Ty D) F A0 A12 So (lift D G A (o D E G s1 s2))))
                 (SJ.substTr (Ty D) F A0 A12 A0 So PA2 (lift D G A (o D E G s1 s2))) >
             subst (Ty D) F A0 A0 (trans (Ty D) A0 A12 A0 So PA2) (lift D G A (o D E G s1 s2))
           =< ap (Id (Ty D) A0 A0) (F A0) (\ R -> subst (Ty D) F A0 A0 R (lift D G A (o D E G s1 s2)))
                 (trans (Ty D) A0 A12 A0 So PA2) (refl A0) (isSetTy D A0 A0 (trans (Ty D) A0 A12 A0 So PA2) (refl A0)) >
             lift D G A (o D E G s1 s2) })
      s e PA
   where {
    A1 : Ty E = subT E G A s1 ;
    A12 : Ty D = subT D E A1 s2 ;
    A0 : Ty D = subT D G A (o D E G s1 s2) ;
    So : Id (Ty D) A0 A12 = subT-o D E G A s1 s2 ;
    F (X : Ty D) : U l = Sub (ext D X) (ext G A) ;
   } ;

  ----------------------------------------------------------------------
  -- helpers: a TE along a substitution; a transport over an element path;
  -- a section after a transported lift

  teSub (D G : Ctx) (A A' : Ty G) (x : El G A) (y : El G A') (h : IN.TE G A A' x y) (s : Sub D G)
    : IN.TE D (subT D G A s) (subT D G A' s) (subt D G A x s) (subt D G A' y s) =
    IN.teT D (subT D G A s) (subT D G A' s) (subT D G A' s) (subt D G A x s) (subt D G A' (trE G A A' h.1 x) s) (subt D G A' y s)
      (IN.teSubtTr D G A A' h.1 x s)
      (refl (subT D G A' s), ap (El G A') (El D (subT D G A' s)) (\ v -> subt D G A' v s) (trE G A A' h.1 x) y h.2) ;

  substEl (D : Ctx) (A : Ty D) (F : El D A -> Ty D) (x y : El D A) (e : Id (El D A) x y) (v : El D (F x))
    : Id (El D (F y)) (subst (El D A) (\ z -> El D (F z)) x y e v) (trE D (F x) (F y) (ap (El D A) (Ty D) F x y e) v) =
    idJ (El D A) x
      (\ z ez -> Id (El D (F z)) (subst (El D A) (\ z2 -> El D (F z2)) x z ez v) (trE D (F x) (F z) (ap (El D A) (Ty D) F x z ez) v))
      (refl v) y e ;

  upSec (D E : Ctx) (A1 : Ty E) (s : Sub D E) (A' : Ty D) (PA : Id (Ty D) (subT D E A1 s) A') (Z : Ty (ext E A1)) (y : El D (subT D E A1 s))
    : Id (Ty D) (subT D (ext D (subT D E A1 s)) (subT (ext D (subT D E A1 s)) (ext E A1) Z (lift D E A1 s)) (sec D (subT D E A1 s) y))
         (subT D (ext D A') (subT (ext D A') (ext E A1) Z (upT D E A1 s A' PA)) (sec D A' (trE D (subT D E A1 s) A' PA y))) =
    idJ (Ty D) (subT D E A1 s)
      (\ X PX -> Id (Ty D) (subT D (ext D (subT D E A1 s)) (subT (ext D (subT D E A1 s)) (ext E A1) Z (lift D E A1 s)) (sec D (subT D E A1 s) y))
                       (subT D (ext D X) (subT (ext D X) (ext E A1) Z (upT D E A1 s X PX)) (sec D X (trE D (subT D E A1 s) X PX y))))
      (refl (subT D (ext D (subT D E A1 s)) (subT (ext D (subT D E A1 s)) (ext E A1) Z (lift D E A1 s)) (sec D (subT D E A1 s) y)))
      A' PA ;

  extS-o (D' D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s)) (r : Sub D' D)
    : Id (Sub D' (ext G A)) (o D' D (ext G A) (extS D G A s a) r)
         (extS D' G A (o D' D G s r) (trE D' (subT D' D (subT D G A s) r) (subT D' G A (o D' D G s r))
                                        (sym (Ty D') (subT D' G A (o D' D G s r)) (subT D' D (subT D G A s) r) (subT-o D' D G A s r))
                                        (subt D' D (subT D G A s) a r))) =
    IN.ext-eq D' G A (o D' D (ext G A) (extS D G A s a) r) (extS D' G A (o D' D G s r) ar)
      (calc (Sub D' G) {
          o D' (ext G A) G (p G A) (o D' D (ext G A) (extS D G A s a) r)
        =< sym (Sub D' G) (o D' D G (o D (ext G A) G (p G A) (extS D G A s a)) r) (o D' (ext G A) G (p G A) (o D' D (ext G A) (extS D G A s a) r))
              (o-assoc D' D (ext G A) G (p G A) (extS D G A s a) r) >
          o D' D G (o D (ext G A) G (p G A) (extS D G A s a)) r
        =< ap (Sub D G) (Sub D' G) (\ t -> o D' D G t r) (o D (ext G A) G (p G A) (extS D G A s a)) s (IN.p-extS D G A s a) >
          o D' D G s r
        =< sym (Sub D' G) (o D' (ext G A) G (p G A) (extS D' G A (o D' D G s r) ar)) (o D' D G s r) (IN.p-extS D' G A (o D' D G s r) ar) >
          o D' (ext G A) G (p G A) (extS D' G A (o D' D G s r) ar) })
      (subT D' G A (o D' D G s r)) ar
      P1
      (JP.ovO D' D (ext G A) (wkT G A A) (extS D G A s a) r (subT D G A s) (IN.wkT-extS D G A A s a) (subT D' G A (o D' D G s r))
         (sym (Ty D') (subT D' G A (o D' D G s r)) (subT D' D (subT D G A s) r) (subT-o D' D G A s r)) P1 (q G A) a ar
         (JP.q-extS D G A s a (IN.wkT-extS D G A A s a)) (refl ar))
      (IN.wkT-extS D' G A A (o D' D G s r) ar) (JP.q-extS D' G A (o D' D G s r) ar (IN.wkT-extS D' G A A (o D' D G s r) ar))
   where {
    ar : El D' (subT D' G A (o D' D G s r)) =
      trE D' (subT D' D (subT D G A s) r) (subT D' G A (o D' D G s r))
        (sym (Ty D') (subT D' G A (o D' D G s r)) (subT D' D (subT D G A s) r) (subT-o D' D G A s r)) (subt D' D (subT D G A s) a r) ;
    P1 : Id (Ty D') (subT D' (ext G A) (wkT G A A) (o D' D (ext G A) (extS D G A s a) r)) (subT D' G A (o D' D G s r)) =
      trans (Ty D') (subT D' (ext G A) (wkT G A A) (o D' D (ext G A) (extS D G A s a) r)) (subT D' D (subT D (ext G A) (wkT G A A) (extS D G A s a)) r)
        (subT D' G A (o D' D G s r))
        (subT-o D' D (ext G A) (wkT G A A) (extS D G A s a) r)
        (trans (Ty D') (subT D' D (subT D (ext G A) (wkT G A A) (extS D G A s a)) r) (subT D' D (subT D G A s) r) (subT D' G A (o D' D G s r))
           (ap (Ty D) (Ty D') (\ X -> subT D' D X r) (subT D (ext G A) (wkT G A A) (extS D G A s a)) (subT D G A s) (IN.wkT-extS D G A A s a))
           (sym (Ty D') (subT D' G A (o D' D G s r)) (subT D' D (subT D G A s) r) (subT-o D' D G A s r))) ;
   } ;

  ----------------------------------------------------------------------
  -- (2) the pair of the variables

  module At (G : Ctx) (A : Ty G) (B : Ty (ext G A)) {
    K : Ctx = ext G A ;
    E2 : Ctx = ext K B ;
    S : Ty G = SS.Sig G A B ;
    p2 : Sub E2 K = p K B ;
    pp : Sub E2 G = o E2 K G (p G A) p2 ;
    Ap : Ty K = wkT G A A ;
    App : Ty E2 = subT E2 G A pp ;
    E3 : Ctx = ext E2 App ;
    Bl : Ty E3 = subT E3 K B (lift E2 G A pp) ;
    SW : Ty E2 = subT E2 G S pp ;
    SN : Id (Ty E2) SW (SS.Sig E2 App Bl) = SS.Sig-nat E2 G A B pp ;

    zA : El E2 App = IN.qOf E2 G A p2 ;
    eta2 : Id (Sub E2 K) p2 (extS E2 G A pp zA) = IN.sub-eta E2 G A p2 ;
    Bz : Ty E2 = subT E2 E3 Bl (sec E2 App zA) ;
    bP : Id (Ty E2) (wkT K B B) Bz =
      trans (Ty E2) (wkT K B B) (subT E2 K B (extS E2 G A pp zA)) Bz
        (ap (Sub E2 K) (Ty E2) (\ t -> subT E2 K B t) p2 (extS E2 G A pp zA) eta2)
        (subT-o E2 E3 K B (lift E2 G A pp) (sec E2 App zA)) ;
    bB : El E2 Bz = trE E2 (wkT K B B) Bz bP (q K B) ;

    pv0 : El E2 (SS.Sig E2 App Bl) = IN.pr E2 App Bl zA bB ;
    pv : El E2 SW = trE E2 (SS.Sig E2 App Bl) SW (sym (Ty E2) SW (SS.Sig E2 App Bl) SN) pv0 ;

    --------------------------------------------------------------------
    -- (3) at a point

    ptS (D : Ctx) (s : Sub D G) (a : El D (subT D G A s)) (b : El D (subT D K B (extS D G A s a))) : Sub D E2 =
      extS D K B (extS D G A s a) b ;

    pp-pt (D : Ctx) (s : Sub D G) (a : El D (subT D G A s)) (b : El D (subT D K B (extS D G A s a)))
      : Id (Sub D G) (o D E2 G pp (ptS D s a b)) s =
      calc (Sub D G) {
          o D E2 G pp (ptS D s a b)
        =< o-assoc D E2 K G (p G A) p2 (ptS D s a b) >
          o D K G (p G A) (o D E2 K p2 (ptS D s a b))
        =< ap (Sub D K) (Sub D G) (\ t -> o D K G (p G A) t) (o D E2 K p2 (ptS D s a b)) (extS D G A s a)
              (IN.p-extS D K B (extS D G A s a) b) >
          o D K G (p G A) (extS D G A s a)
        =< IN.p-extS D G A s a >
          s } ;

    pv-pt (D : Ctx) (s : Sub D G) (a : El D (subT D G A s)) (b : El D (subT D K B (extS D G A s a)))
      (PS : Id (Ty D) (subT D E2 SW (ptS D s a b)) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) K B (lift D G A s))))
      : Ov D E2 SW (ptS D s a b) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) K B (lift D G A s))) PS pv
           (IN.pr D (subT D G A s) (subT (ext D (subT D G A s)) K B (lift D G A s)) a
              (trE D (subT D K B (extS D G A s a)) (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) K B (lift D G A s)) (sec D (subT D G A s) a))
                 (subT-o D (ext D (subT D G A s)) K B (lift D G A s) (sec D (subT D G A s) a)) b)) =
      ovTr D E2 (SS.Sig E2 App Bl) SW (sym (Ty E2) SW (SS.Sig E2 App Bl) SN) sg (SS.Sig D As Bls) (SS.Sig D As Bls) (refl (SS.Sig D As Bls)) PW PS
        pv0 (IN.pr D As Bls a b2)
        (IN.pr-ov D E2 App Bl sg As PA Bls PB PW zA a Pz bB b2 PT Pb)
     where {
      sg : Sub D E2 = ptS D s a b ;
      As : Ty D = subT D G A s ;
      Bls : Ty (ext D As) = subT (ext D As) K B (lift D G A s) ;
      Bsa : Ty D = subT D (ext D As) Bls (sec D As a) ;
      Bk : Ty D = subT D K B (extS D G A s a) ;
      So3 : Id (Ty D) Bk Bsa = subT-o D (ext D As) K B (lift D G A s) (sec D As a) ;
      b2 : El D Bsa = trE D Bk Bsa So3 b ;
      PA : Id (Ty D) (subT D E2 App sg) As =
        trans (Ty D) (subT D E2 App sg) (subT D G A (o D E2 G pp sg)) As
          (sym (Ty D) (subT D G A (o D E2 G pp sg)) (subT D E2 App sg) (subT-o D E2 G A pp sg))
          (ap (Sub D G) (Ty D) (\ t -> subT D G A t) (o D E2 G pp sg) s (pp-pt D s a b)) ;
      -- zA at the point is a
      Ak : Ty D = subT D K Ap (extS D G A s a) ;
      PW1 : Id (Ty D) (subT D E2 (wkT K B Ap) sg) Ak = IN.wkT-extS D K B Ap (extS D G A s a) b ;
      PW2 : Id (Ty D) Ak As = IN.wkT-extS D G A A s a ;
      e12 : Ov D E2 (wkT K B Ap) sg As (trans (Ty D) (subT D E2 (wkT K B Ap) sg) Ak As PW1 PW2) (wkE K B Ap (q G A)) a =
        ovThen D E2 (wkT K B Ap) sg Ak As PW1 PW2 (wkE K B Ap (q G A)) (subt D K Ap (q G A) (extS D G A s a)) a
          (IN.wkE-extS D K B Ap (q G A) (extS D G A s a) b PW1)
          (JP.q-extS D G A s a PW2) ;
      Pz : Ov D E2 App sg As PA zA a =
        ovTr D E2 (wkT K B Ap) App (sym (Ty E2) App (wkT K B Ap) (subT-o E2 K G A (p G A) p2)) sg As As (refl As)
          (trans (Ty D) (subT D E2 (wkT K B Ap) sg) Ak As PW1 PW2) PA (wkE K B Ap (q G A)) a e12 ;
      -- bB at the point is b
      PW3 : Id (Ty D) (subT D E2 (wkT K B B) sg) Bk = IN.wkT-extS D K B B (extS D G A s a) b ;
      PT : Id (Ty D) (subT D E2 Bz sg) Bsa =
        trans (Ty D) (subT D E2 Bz sg) (subT D E2 (wkT K B B) sg) Bsa
          (sym (Ty D) (subT D E2 (wkT K B B) sg) (subT D E2 Bz sg) (ap (Ty E2) (Ty D) (\ X -> subT D E2 X sg) (wkT K B B) Bz bP))
          (trans (Ty D) (subT D E2 (wkT K B B) sg) Bk Bsa PW3 So3) ;
      Pb : Ov D E2 Bz sg Bsa PT bB b2 =
        ovTr D E2 (wkT K B B) Bz bP sg Bk Bsa So3 PW3 PT (q K B) b (JP.q-extS D K B (extS D G A s a) b PW3) ;
      -- the family
      PB : Id (Ty (ext D As)) (subT (ext D As) E3 Bl (upT D E2 App sg As PA)) Bls =
        trans (Ty (ext D As)) (subT (ext D As) E3 Bl (upT D E2 App sg As PA))
          (subT (ext D As) K B (o (ext D As) E3 K (lift E2 G A pp) (upT D E2 App sg As PA))) Bls
          (sym (Ty (ext D As)) (subT (ext D As) K B (o (ext D As) E3 K (lift E2 G A pp) (upT D E2 App sg As PA)))
               (subT (ext D As) E3 Bl (upT D E2 App sg As PA))
               (subT-o (ext D As) E3 K B (lift E2 G A pp) (upT D E2 App sg As PA)))
          (ap (Sub (ext D As) K) (Ty (ext D As)) (\ t -> subT (ext D As) K B t)
              (o (ext D As) E3 K (lift E2 G A pp) (upT D E2 App sg As PA)) (lift D G A s)
              (liftComp D E2 G A pp sg s (pp-pt D s a b) PA)) ;
      PW : Id (Ty D) (subT D E2 (SS.Sig E2 App Bl) sg) (SS.Sig D As Bls) =
        trans (Ty D) (subT D E2 (SS.Sig E2 App Bl) sg) (subT D E2 SW sg) (SS.Sig D As Bls)
          (ap (Ty E2) (Ty D) (\ X -> subT D E2 X sg) (SS.Sig E2 App Bl) SW (sym (Ty E2) SW (SS.Sig E2 App Bl) SN)) PS ;
     } ;

    -- a map into G.A with p part s and q over a is extS s a
    etPt (D : Ctx) (t : Sub D K) (s : Sub D G) (es : Id (Sub D G) (o D K G (p G A) t) s)
      (a : El D (subT D G A s)) (PWa : Id (Ty D) (subT D K Ap t) (subT D G A s)) (qa : Ov D K Ap t (subT D G A s) PWa (q G A) a)
      : Id (Sub D K) t (extS D G A s a) =
      IN.ext-eq D G A t (extS D G A s a)
        (trans (Sub D G) (o D K G (p G A) t) s (o D K G (p G A) (extS D G A s a)) es
           (sym (Sub D G) (o D K G (p G A) (extS D G A s a)) s (IN.p-extS D G A s a)))
        (subT D G A s) a PWa qa (IN.wkT-extS D G A A s a) (JP.q-extS D G A s a (IN.wkT-extS D G A A s a)) ;

    -- at a point (t , b) whose first part t has p t = s and q over a
    pv-gen (D : Ctx) (t : Sub D K) (s : Sub D G) (es : Id (Sub D G) (o D K G (p G A) t) s)
      (a : El D (subT D G A s)) (PWa : Id (Ty D) (subT D K Ap t) (subT D G A s)) (qa : Ov D K Ap t (subT D G A s) PWa (q G A) a)
      (b : El D (subT D K B t))
      (PS : Id (Ty D) (subT D E2 SW (extS D K B t b)) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) K B (lift D G A s))))
      : Ov D E2 SW (extS D K B t b) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) K B (lift D G A s))) PS pv
           (IN.pr D (subT D G A s) (subT (ext D (subT D G A s)) K B (lift D G A s)) a
              (trE D (subT D K B (extS D G A s a)) (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) K B (lift D G A s)) (sec D (subT D G A s) a))
                 (subT-o D (ext D (subT D G A s)) K B (lift D G A s) (sec D (subT D G A s) a))
                 (trE D (subT D K B t) (subT D K B (extS D G A s a)) (ap (Sub D K) (Ty D) (\ u -> subT D K B u) t (extS D G A s a) (etPt D t s es a PWa qa)) b))) =
      IN.teAny D (subT D E2 SW (extS D K B t b)) SgD (subt D E2 SW pv (extS D K B t b)) (IN.pr D As Bls a b2)
        (IN.teT D (subT D E2 SW (extS D K B t b)) (subT D E2 SW (ptS D s a b')) SgD
           (subt D E2 SW pv (extS D K B t b)) (subt D E2 SW pv (ptS D s a b')) (IN.pr D As Bls a b2)
           (IN.teSubEq D E2 SW pv (extS D K B t b) (ptS D s a b')
              (IN.extS-cong D K B t (extS D G A s a) et b b' (refl b')))
           (IN.teOv D E2 SW (ptS D s a b') SgD P1 pv (IN.pr D As Bls a b2) (pv-pt D s a b' P1)))
        PS
     where {
      As : Ty D = subT D G A s ;
      Bls : Ty (ext D As) = subT (ext D As) K B (lift D G A s) ;
      SgD : Ty D = SS.Sig D As Bls ;
      et : Id (Sub D K) t (extS D G A s a) = etPt D t s es a PWa qa ;
      b' : El D (subT D K B (extS D G A s a)) = trE D (subT D K B t) (subT D K B (extS D G A s a)) (ap (Sub D K) (Ty D) (\ u -> subT D K B u) t (extS D G A s a) et) b ;
      b2 : El D (subT D (ext D As) Bls (sec D As a)) =
        trE D (subT D K B (extS D G A s a)) (subT D (ext D As) Bls (sec D As a)) (subT-o D (ext D As) K B (lift D G A s) (sec D As a)) b' ;
      P1 : Id (Ty D) (subT D E2 SW (ptS D s a b')) SgD =
        trans (Ty D) (subT D E2 SW (ptS D s a b')) (subT D E2 SW (extS D K B t b)) SgD
          (sym (Ty D) (subT D E2 SW (extS D K B t b)) (subT D E2 SW (ptS D s a b'))
             (ap (Sub D E2) (Ty D) (\ u -> subT D E2 SW u) (extS D K B t b) (ptS D s a b') (IN.extS-cong D K B t (extS D G A s a) et b b' (refl b'))))
          PS ;
     } ;

    --------------------------------------------------------------------
    -- (4) the unpacking map

    ES : Ctx = ext G S ;
    Ap1 : Ty ES = subT ES G A (p G S) ;
    Bl1 : Ty (ext ES Ap1) = subT (ext ES Ap1) K B (lift ES G A (p G S)) ;
    SN1 : Id (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) = SS.Sig-nat ES G A B (p G S) ;
    w1 : El ES (SS.Sig ES Ap1 Bl1) = trE ES (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1 (q G S) ;
    a1 : El ES Ap1 = IN.fst ES Ap1 Bl1 w1 ;
    So1 : Id (Ty ES) (subT ES K B (extS ES G A (p G S) a1)) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) =
      subT-o ES (ext ES Ap1) K B (lift ES G A (p G S)) (sec ES Ap1 a1) ;
    b1 : El ES (subT ES K B (extS ES G A (p G S) a1)) =
      trE ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) (subT ES K B (extS ES G A (p G S) a1))
        (sym (Ty ES) (subT ES K B (extS ES G A (p G S) a1)) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) So1)
        (IN.snd ES Ap1 Bl1 w1) ;

    unpk : Sub ES E2 = ptS ES (p G S) a1 b1 ;

    pp-unpk : Id (Sub ES G) (o ES E2 G pp unpk) (p G S) = pp-pt ES (p G S) a1 b1 ;

    PU : Id (Ty ES) (subT ES E2 SW unpk) (wkT G S S) =
      trans (Ty ES) (subT ES E2 SW unpk) (subT ES G S (o ES E2 G pp unpk)) (wkT G S S)
        (sym (Ty ES) (subT ES G S (o ES E2 G pp unpk)) (subT ES E2 SW unpk) (subT-o ES E2 G S pp unpk))
        (ap (Sub ES G) (Ty ES) (\ t -> subT ES G S t) (o ES E2 G pp unpk) (p G S) pp-unpk) ;

    pv-unpk : Ov ES E2 SW unpk (wkT G S S) PU pv (q G S) =
      ovRe ES E2 SW unpk (wkT G S S)
        (trans (Ty ES) (subT ES E2 SW unpk) (SS.Sig ES Ap1 Bl1) (wkT G S S) PS1 (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1))
        PU pv (q G S)
        (ovThen ES E2 SW unpk (SS.Sig ES Ap1 Bl1) (wkT G S S) PS1 (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1)
           pv (IN.pr ES Ap1 Bl1 a1 (trE ES (subT ES K B (extS ES G A (p G S) a1)) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) So1 b1))
           (q G S)
           (pv-pt ES (p G S) a1 b1 PS1)
           (calc (El ES (wkT G S S)) {
               trE ES (SS.Sig ES Ap1 Bl1) (wkT G S S) (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1)
                 (IN.pr ES Ap1 Bl1 a1 (trE ES (subT ES K B (extS ES G A (p G S) a1)) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) So1 b1))
             =< ap (El ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1))) (El ES (wkT G S S))
                   (\ v -> trE ES (SS.Sig ES Ap1 Bl1) (wkT G S S) (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1) (IN.pr ES Ap1 Bl1 a1 v))
                   (trE ES (subT ES K B (extS ES G A (p G S) a1)) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) So1 b1)
                   (IN.snd ES Ap1 Bl1 w1)
                   (JP.trE-sym ES (subT ES K B (extS ES G A (p G S) a1)) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) So1 (IN.snd ES Ap1 Bl1 w1)) >
               trE ES (SS.Sig ES Ap1 Bl1) (wkT G S S) (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1) (IN.pr ES Ap1 Bl1 a1 (IN.snd ES Ap1 Bl1 w1))
             =< ap (El ES (SS.Sig ES Ap1 Bl1)) (El ES (wkT G S S))
                   (\ v -> trE ES (SS.Sig ES Ap1 Bl1) (wkT G S S) (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1) v)
                   (IN.pr ES Ap1 Bl1 a1 (IN.snd ES Ap1 Bl1 w1)) w1 ((SS.Sig-iso ES Ap1 Bl1).inv-fun w1) >
               trE ES (SS.Sig ES Ap1 Bl1) (wkT G S S) (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1) w1
             =< IN.trE-symL ES (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1 (q G S) >
               q G S }))
     where {
      PS1 : Id (Ty ES) (subT ES E2 SW unpk) (SS.Sig ES Ap1 Bl1) = trans (Ty ES) (subT ES E2 SW unpk) (wkT G S S) (SS.Sig ES Ap1 Bl1) PU SN1 ;
     } ;

    --------------------------------------------------------------------
    -- (5) unpk after the pair map (pp , pv) is the identity

    X : Sub E2 ES = extS E2 G S pp pv ;
    pX : Id (Sub E2 G) (o E2 ES G (p G S) X) pp = IN.p-extS E2 G S pp pv ;

    PAX : Id (Ty E2) (subT E2 ES Ap1 X) App =
      trans (Ty E2) (subT E2 ES Ap1 X) (subT E2 G A (o E2 ES G (p G S) X)) App
        (sym (Ty E2) (subT E2 G A (o E2 ES G (p G S) X)) (subT E2 ES Ap1 X) (subT-o E2 ES G A (p G S) X))
        (ap (Sub E2 G) (Ty E2) (\ t -> subT E2 G A t) (o E2 ES G (p G S) X) pp pX) ;

    PBX : Id (Ty (ext E2 App)) (subT (ext E2 App) (ext ES Ap1) Bl1 (upT E2 ES Ap1 X App PAX)) Bl =
      trans (Ty (ext E2 App)) (subT (ext E2 App) (ext ES Ap1) Bl1 (upT E2 ES Ap1 X App PAX))
        (subT (ext E2 App) K B (o (ext E2 App) (ext ES Ap1) K (lift ES G A (p G S)) (upT E2 ES Ap1 X App PAX))) Bl
        (sym (Ty (ext E2 App)) (subT (ext E2 App) K B (o (ext E2 App) (ext ES Ap1) K (lift ES G A (p G S)) (upT E2 ES Ap1 X App PAX)))
             (subT (ext E2 App) (ext ES Ap1) Bl1 (upT E2 ES Ap1 X App PAX))
             (subT-o (ext E2 App) (ext ES Ap1) K B (lift ES G A (p G S)) (upT E2 ES Ap1 X App PAX)))
        (ap (Sub (ext E2 App) K) (Ty (ext E2 App)) (\ t -> subT (ext E2 App) K B t)
            (o (ext E2 App) (ext ES Ap1) K (lift ES G A (p G S)) (upT E2 ES Ap1 X App PAX)) (lift E2 G A pp)
            (liftComp E2 ES G A (p G S) X pp pX PAX)) ;

    PWX : Id (Ty E2) (subT E2 ES (SS.Sig ES Ap1 Bl1) X) (SS.Sig E2 App Bl) =
      trans (Ty E2) (subT E2 ES (SS.Sig ES Ap1 Bl1) X) (subT E2 ES (wkT G S S) X) (SS.Sig E2 App Bl)
        (ap (Ty ES) (Ty E2) (\ Z -> subT E2 ES Z X) (SS.Sig ES Ap1 Bl1) (wkT G S S) (sym (Ty ES) (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1))
        (trans (Ty E2) (subT E2 ES (wkT G S S) X) (subT E2 G S (o E2 ES G (p G S) X)) (SS.Sig E2 App Bl)
           (sym (Ty E2) (subT E2 G S (o E2 ES G (p G S) X)) (subT E2 ES (wkT G S S) X) (subT-o E2 ES G S (p G S) X))
           (trans (Ty E2) (subT E2 G S (o E2 ES G (p G S) X)) SW (SS.Sig E2 App Bl)
              (ap (Sub E2 G) (Ty E2) (\ t -> subT E2 G S t) (o E2 ES G (p G S) X) pp pX) SN)) ;

    hw : IN.TE E2 (subT E2 ES (SS.Sig ES Ap1 Bl1) X) (SS.Sig E2 App Bl) (subt E2 ES (SS.Sig ES Ap1 Bl1) w1 X) pv0 =
      IN.teT E2 (subT E2 ES (SS.Sig ES Ap1 Bl1) X) (subT E2 ES (wkT G S S) X) (SS.Sig E2 App Bl)
        (subt E2 ES (SS.Sig ES Ap1 Bl1) w1 X) (subt E2 ES (wkT G S S) (q G S) X) pv0
        (IN.teS E2 (subT E2 ES (wkT G S S) X) (subT E2 ES (SS.Sig ES Ap1 Bl1) X) (subt E2 ES (wkT G S S) (q G S) X) (subt E2 ES (SS.Sig ES Ap1 Bl1) w1 X)
           (IN.teSubtTr E2 ES (wkT G S S) (SS.Sig ES Ap1 Bl1) SN1 (q G S) X))
        (IN.teT E2 (subT E2 ES (wkT G S S) X) SW (SS.Sig E2 App Bl) (subt E2 ES (wkT G S S) (q G S) X) pv pv0
           (IN.teOv E2 ES (wkT G S S) X SW (IN.wkT-extS E2 G S S pp pv) (q G S) pv (JP.q-extS E2 G S pp pv (IN.wkT-extS E2 G S S pp pv)))
           (SN, JP.trE-sym E2 SW (SS.Sig E2 App Bl) SN pv0)) ;

    PwX : Ov E2 ES (SS.Sig ES Ap1 Bl1) X (SS.Sig E2 App Bl) PWX w1 pv0 =
      IN.teAny E2 (subT E2 ES (SS.Sig ES Ap1 Bl1) X) (SS.Sig E2 App Bl) (subt E2 ES (SS.Sig ES Ap1 Bl1) w1 X) pv0 hw PWX ;

    FA : Ov E2 ES Ap1 X App PAX a1 (IN.fst E2 App Bl pv0) = IN.fst-ov E2 ES Ap1 Bl1 X App PAX Bl PBX PWX w1 pv0 PwX ;

    PS2 : Id (Ty E2) (subT E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X) (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) =
      trans (Ty E2) (subT E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X)
        (subT E2 (ext E2 (subT E2 ES Ap1 X)) (subT (ext E2 (subT E2 ES Ap1 X)) (ext ES Ap1) Bl1 (lift E2 ES Ap1 X)) (sec E2 (subT E2 ES Ap1 X) (subt E2 ES Ap1 a1 X)))
        (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0)))
        (CwF.Formers[l, C].coerce E2 ES Ap1 Bl1 a1 X)
        (trans (Ty E2)
           (subT E2 (ext E2 (subT E2 ES Ap1 X)) (subT (ext E2 (subT E2 ES Ap1 X)) (ext ES Ap1) Bl1 (lift E2 ES Ap1 X)) (sec E2 (subT E2 ES Ap1 X) (subt E2 ES Ap1 a1 X)))
           (subT E2 (ext E2 App) (subT (ext E2 App) (ext ES Ap1) Bl1 (upT E2 ES Ap1 X App PAX)) (sec E2 App (trE E2 (subT E2 ES Ap1 X) App PAX (subt E2 ES Ap1 a1 X))))
           (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0)))
           (upSec E2 ES Ap1 X App PAX Bl1 (subt E2 ES Ap1 a1 X))
           (trans (Ty E2)
              (subT E2 (ext E2 App) (subT (ext E2 App) (ext ES Ap1) Bl1 (upT E2 ES Ap1 X App PAX)) (sec E2 App (trE E2 (subT E2 ES Ap1 X) App PAX (subt E2 ES Ap1 a1 X))))
              (subT E2 (ext E2 App) Bl (sec E2 App (trE E2 (subT E2 ES Ap1 X) App PAX (subt E2 ES Ap1 a1 X))))
              (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0)))
              (ap (Ty (ext E2 App)) (Ty E2) (\ Z -> subT E2 (ext E2 App) Z (sec E2 App (trE E2 (subT E2 ES Ap1 X) App PAX (subt E2 ES Ap1 a1 X))))
                  (subT (ext E2 App) (ext ES Ap1) Bl1 (upT E2 ES Ap1 X App PAX)) Bl PBX)
              (ap (El E2 App) (Ty E2) (\ x -> subT E2 (ext E2 App) Bl (sec E2 App x))
                  (trE E2 (subT E2 ES Ap1 X) App PAX (subt E2 ES Ap1 a1 X)) (IN.fst E2 App Bl pv0) FA))) ;

    FB : Ov E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) PS2
           (IN.snd ES Ap1 Bl1 w1) (IN.snd E2 App Bl pv0) =
      IN.snd-ov E2 ES Ap1 Bl1 X App PAX Bl PBX PWX w1 pv0 PwX PS2 ;

    sb : IN.TE E2 (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) Bz (IN.snd E2 App Bl pv0) bB =
      (ap (El E2 App) (Ty E2) (\ x -> subT E2 E3 Bl (sec E2 App x)) (IN.fst E2 App Bl pv0) zA (IN.fst-pr E2 App Bl zA bB),
       trans (El E2 Bz)
         (trE E2 (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) Bz
            (ap (El E2 App) (Ty E2) (\ x -> subT E2 E3 Bl (sec E2 App x)) (IN.fst E2 App Bl pv0) zA (IN.fst-pr E2 App Bl zA bB)) (IN.snd E2 App Bl pv0))
         (subst (El E2 App) (\ x2 -> El E2 (subT E2 E3 Bl (sec E2 App x2))) (IN.fst E2 App Bl pv0) zA (IN.fst-pr E2 App Bl zA bB) (IN.snd E2 App Bl pv0))
         bB
         (sym (El E2 Bz) (subst (El E2 App) (\ x2 -> El E2 (subT E2 E3 Bl (sec E2 App x2))) (IN.fst E2 App Bl pv0) zA (IN.fst-pr E2 App Bl zA bB) (IN.snd E2 App Bl pv0))
              (trE E2 (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) Bz
                 (ap (El E2 App) (Ty E2) (\ x -> subT E2 E3 Bl (sec E2 App x)) (IN.fst E2 App Bl pv0) zA (IN.fst-pr E2 App Bl zA bB)) (IN.snd E2 App Bl pv0))
              (substEl E2 App (\ x -> subT E2 E3 Bl (sec E2 App x)) (IN.fst E2 App Bl pv0) zA (IN.fst-pr E2 App Bl zA bB) (IN.snd E2 App Bl pv0)))
         (IN.snd-pr E2 App Bl zA bB)) ;

    -- the K part
    eA : Sub ES K = extS ES G A (p G S) a1 ;

    hq1 : IN.TE E2 (subT E2 K Ap (o E2 ES K eA X)) App (subt E2 K Ap (q G A) (o E2 ES K eA X)) zA =
      IN.teT E2 (subT E2 K Ap (o E2 ES K eA X)) (subT E2 ES (subT ES K Ap eA) X) App
        (subt E2 K Ap (q G A) (o E2 ES K eA X)) (subt E2 ES (subT ES K Ap eA) (subt ES K Ap (q G A) eA) X) zA
        (IN.teSubtO E2 ES K Ap (q G A) eA X)
        (IN.teT E2 (subT E2 ES (subT ES K Ap eA) X) (subT E2 ES Ap1 X) App
           (subt E2 ES (subT ES K Ap eA) (subt ES K Ap (q G A) eA) X) (subt E2 ES Ap1 a1 X) zA
           (teSub E2 ES (subT ES K Ap eA) Ap1 (subt ES K Ap (q G A) eA) a1
              (IN.teOv ES K Ap eA Ap1 (IN.wkT-extS ES G A A (p G S) a1) (q G A) a1 (JP.q-extS ES G A (p G S) a1 (IN.wkT-extS ES G A A (p G S) a1))) X)
           (IN.teT E2 (subT E2 ES Ap1 X) App App (subt E2 ES Ap1 a1 X) (IN.fst E2 App Bl pv0) zA
              (IN.teOv E2 ES Ap1 X App PAX a1 (IN.fst E2 App Bl pv0) FA)
              (refl App, IN.fst-pr E2 App Bl zA bB))) ;

    E1 : Id (Sub E2 K) (o E2 ES K eA X) p2 =
      IN.ext-eq E2 G A (o E2 ES K eA X) p2
        (calc (Sub E2 G) {
            o E2 K G (p G A) (o E2 ES K eA X)
          =< sym (Sub E2 G) (o E2 ES G (o ES K G (p G A) eA) X) (o E2 K G (p G A) (o E2 ES K eA X)) (o-assoc E2 ES K G (p G A) eA X) >
            o E2 ES G (o ES K G (p G A) eA) X
          =< ap (Sub ES G) (Sub E2 G) (\ t -> o E2 ES G t X) (o ES K G (p G A) eA) (p G S) (IN.p-extS ES G A (p G S) a1) >
            o E2 ES G (p G S) X
          =< pX >
            pp })
        App zA hq1.1 hq1.2
        (sym (Ty E2) App (subT E2 K Ap p2) (subT-o E2 K G A (p G A) p2)) (refl zA) ;

    -- the B part
    hq3 : IN.TE E2 (subT E2 E2 (wkT K B B) (o E2 ES E2 unpk X)) (wkT K B B) (subt E2 E2 (wkT K B B) (q K B) (o E2 ES E2 unpk X)) (q K B) =
      IN.teT E2 (subT E2 E2 (wkT K B B) (o E2 ES E2 unpk X)) (subT E2 ES (subT ES E2 (wkT K B B) unpk) X) (wkT K B B)
        (subt E2 E2 (wkT K B B) (q K B) (o E2 ES E2 unpk X)) (subt E2 ES (subT ES E2 (wkT K B B) unpk) (subt ES E2 (wkT K B B) (q K B) unpk) X) (q K B)
        (IN.teSubtO E2 ES E2 (wkT K B B) (q K B) unpk X)
        (IN.teT E2 (subT E2 ES (subT ES E2 (wkT K B B) unpk) X) (subT E2 ES (subT ES K B eA) X) (wkT K B B)
           (subt E2 ES (subT ES E2 (wkT K B B) unpk) (subt ES E2 (wkT K B B) (q K B) unpk) X) (subt E2 ES (subT ES K B eA) b1 X) (q K B)
           (teSub E2 ES (subT ES E2 (wkT K B B) unpk) (subT ES K B eA) (subt ES E2 (wkT K B B) (q K B) unpk) b1
              (IN.teOv ES E2 (wkT K B B) unpk (subT ES K B eA) (IN.wkT-extS ES K B B eA b1) (q K B) b1 (JP.q-extS ES K B eA b1 (IN.wkT-extS ES K B B eA b1))) X)
           (IN.teT E2 (subT E2 ES (subT ES K B eA) X) (subT E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X) (wkT K B B)
              (subt E2 ES (subT ES K B eA) b1 X) (subt E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) (IN.snd ES Ap1 Bl1 w1) X) (q K B)
              (IN.teS E2 (subT E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X) (subT E2 ES (subT ES K B eA) X)
                 (subt E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) (IN.snd ES Ap1 Bl1 w1) X) (subt E2 ES (subT ES K B eA) b1 X)
                 (IN.teSubtTr E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) (subT ES K B eA)
                    (sym (Ty ES) (subT ES K B eA) (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) So1) (IN.snd ES Ap1 Bl1 w1) X))
              (IN.teT E2 (subT E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X) (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) (wkT K B B)
                 (subt E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) (IN.snd ES Ap1 Bl1 w1) X) (IN.snd E2 App Bl pv0) (q K B)
                 (IN.teOv E2 ES (subT ES (ext ES Ap1) Bl1 (sec ES Ap1 a1)) X (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) PS2
                    (IN.snd ES Ap1 Bl1 w1) (IN.snd E2 App Bl pv0) FB)
                 (IN.teT E2 (subT E2 (ext E2 App) Bl (sec E2 App (IN.fst E2 App Bl pv0))) Bz (wkT K B B) (IN.snd E2 App Bl pv0) bB (q K B)
                    sb
                    (IN.teS E2 (wkT K B B) Bz (q K B) bB (IN.teTr E2 (wkT K B B) Bz bP (q K B))))))) ;

    UP0 : Id (Sub E2 E2) (o E2 ES E2 unpk X) (id E2) =
      IN.ext-eq E2 K B (o E2 ES E2 unpk X) (id E2)
        (calc (Sub E2 K) {
            o E2 E2 K p2 (o E2 ES E2 unpk X)
          =< sym (Sub E2 K) (o E2 ES K (o ES E2 K p2 unpk) X) (o E2 E2 K p2 (o E2 ES E2 unpk X)) (o-assoc E2 ES E2 K p2 unpk X) >
            o E2 ES K (o ES E2 K p2 unpk) X
          =< ap (Sub ES K) (Sub E2 K) (\ t -> o E2 ES K t X) (o ES E2 K p2 unpk) eA (IN.p-extS ES K B eA b1) >
            o E2 ES K eA X
          =< E1 >
            p2
          =< sym (Sub E2 K) (o E2 E2 K p2 (id E2)) p2 (o-idr E2 K p2) >
            o E2 E2 K p2 (id E2) })
        (wkT K B B) (q K B) hq3.1 hq3.2
        (subT-id E2 (wkT K B B)) (subt-id E2 (wkT K B B) (q K B)) ;

    -- for any map s : D -> E2, unpk after (pp s , pv s) is s
    UP (D : Ctx) (sg : Sub D E2)
      : Id (Sub D E2) (o D ES E2 unpk (extS D G S (o D E2 G pp sg) (trE D (subT D E2 SW sg) (subT D G S (o D E2 G pp sg))
                                                 (sym (Ty D) (subT D G S (o D E2 G pp sg)) (subT D E2 SW sg) (subT-o D E2 G S pp sg))
                                                 (subt D E2 SW pv sg)))) sg =
      calc (Sub D E2) {
          o D ES E2 unpk (extS D G S (o D E2 G pp sg) (trE D (subT D E2 SW sg) (subT D G S (o D E2 G pp sg))
                                     (sym (Ty D) (subT D G S (o D E2 G pp sg)) (subT D E2 SW sg) (subT-o D E2 G S pp sg)) (subt D E2 SW pv sg)))
        =< ap (Sub D ES) (Sub D E2) (\ t -> o D ES E2 unpk t)
              (extS D G S (o D E2 G pp sg) (trE D (subT D E2 SW sg) (subT D G S (o D E2 G pp sg))
                                     (sym (Ty D) (subT D G S (o D E2 G pp sg)) (subT D E2 SW sg) (subT-o D E2 G S pp sg)) (subt D E2 SW pv sg)))
              (o D E2 ES X sg)
              (sym (Sub D ES) (o D E2 ES X sg) _ (extS-o D E2 G S pp pv sg)) >
          o D ES E2 unpk (o D E2 ES X sg)
        =< sym (Sub D E2) (o D E2 E2 (o E2 ES E2 unpk X) sg) (o D ES E2 unpk (o D E2 ES X sg)) (o-assoc D E2 ES E2 unpk X sg) >
          o D E2 E2 (o E2 ES E2 unpk X) sg
        =< ap (Sub E2 E2) (Sub D E2) (\ t -> o D E2 E2 t sg) (o E2 ES E2 unpk X) (id E2) UP0 >
          o D E2 E2 (id E2) sg
        =< o-idl D E2 sg >
          sg } ;
  } ;
} ;
