-- CwFCoS.seg (M1 step 3, S4 toolkit): co-based singletons are
-- contractible, in a CwF with Pi, Sigma and Swan Id.
--
-- Over K = G.A (variable w), CoSF = Sigma (y : A) Id(y , w).  The source's
-- homotopies (CwFEq.Htpy) are co-based, so their fibres are; based J
-- fixes the LEFT end, so the two variables of K2 = G.A.A are swapped.
--
-- Informal text.  Write v1 , v2 for the two variables of K2.
-- (1) swK : K2 -> K2 exchanges them (s1 : K2 -> K puts v2 in the place
--     of the variable of K); swK swK = id and s1 swK = p (ext-eq, from the
--     values of v1 , v2 along swK).
-- (2) E2 = K2.Id(v2 , v1) is the context of the pairs of CoSF (CwFSig) and
--     Dx = K2.Id(v1 , v2) the context of J based at the variable of K.
--     tau : Dx -> E2 and ex : E2 -> Dx are the lifts of swK; tau ex = id
--     (pUp: p o upT s = s o p, and (1)).
-- (3) Over Dx, R = pv along tau is the pair (v1 , u) in CoSF at v2, i.e. at
--     sigz = s1 o p.  The centre c' is R at the centre cen of J, read in
--     CoSF (sigz cen = id).  J with motive Id(c'[sigz] , R) starts at
--     refl.  Along ex, c'[sigz] is c'[pp] and R is pv: an element of
--     Id(c'[pp] , pv) over E2, and along unpk the contraction (as in
--     CwFSing).

open Base ;

module CoS (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;

  -- p after a lift (transported) is s after p
  pUp (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    : Id (Sub (ext D A') G) (o (ext D A') (ext G A) G (p G A) (upT D G A s A' PA)) (o (ext D A') D G s (p D A')) =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> Id (Sub (ext D X) G) (o (ext D X) (ext G A) G (p G A) (upT D G A s X PX)) (o (ext D X) D G s (p D X)))
      (p-lift D G A s) A' PA ;

  -- the co-based singleton family over G.A
  CoSF (G : Ctx) (A : Ty G) : Ty (ext G A) =
    SS.Sig (ext G A) (wkT G A A)
      (IJ.IdT (ext (ext G A) (wkT G A A)) (wkT (ext G A) (wkT G A A) (wkT G A A)) (q (ext G A) (wkT G A A)) (wkE (ext G A) (wkT G A A) (wkT G A A) (q G A))) ;

  module CS (G : Ctx) (A : Ty G) {
    K : Ctx = ext G A ;
    Aw : Ty K = wkT G A A ;
    K2 : Ctx = ext K Aw ;
    A2 : Ty K2 = wkT K Aw Aw ;
    v1 : El K2 A2 = wkE K Aw Aw (q G A) ;
    v2 : El K2 A2 = q K Aw ;
    Bw : Ty K2 = IJ.IdT K2 A2 v2 v1 ;
    IKx : Ty K2 = IJ.IdT K2 A2 v1 v2 ;
    CoS0 : Ty K = CoSF G A ;
    module VC = SV.At[K, Aw, Bw] ;
    E2 : Ctx = ext K2 Bw ;
    Dx : Ctx = ext K2 IKx ;
    pE : Sub E2 K2 = p K2 Bw ;
    pD : Sub Dx K2 = p K2 IKx ;

    ------------------------------------------------------------------
    -- (1) the swap

    p12 : Sub K2 G = o K2 K G (p G A) (p K Aw) ;
    A12 : Ty K2 = subT K2 G A p12 ;
    PA12 : Id (Ty K2) A2 A12 = sym (Ty K2) A12 A2 (subT-o K2 K G A (p G A) (p K Aw)) ;
    v2r : El K2 A12 = trE K2 A2 A12 PA12 v2 ;
    s1 : Sub K2 K = extS K2 G A p12 v2r ;
    PWq : Id (Ty K2) (subT K2 K Aw s1) A12 = IN.wkT-extS K2 G A A p12 v2r ;
    QA1 : Id (Ty K2) (subT K2 K Aw s1) A2 = trans (Ty K2) (subT K2 K Aw s1) A12 A2 PWq (sym (Ty K2) A2 A12 PA12) ;
    a1 : El K2 (subT K2 K Aw s1) = trE K2 A2 (subT K2 K Aw s1) (sym (Ty K2) (subT K2 K Aw s1) A2 QA1) v1 ;
    swK : Sub K2 K2 = extS K2 K Aw s1 a1 ;

    PW0 : Id (Ty K2) (subT K2 K2 A2 swK) (subT K2 K Aw s1) = IN.wkT-extS K2 K Aw Aw s1 a1 ;
    PA2sw : Id (Ty K2) (subT K2 K2 A2 swK) A2 = trans (Ty K2) (subT K2 K2 A2 swK) (subT K2 K Aw s1) A2 PW0 QA1 ;

    Lv2 : Ov K2 K2 A2 swK A2 PA2sw v2 v1 =
      SV.ovThen K2 K2 A2 swK (subT K2 K Aw s1) A2 PW0 QA1 v2 a1 v1
        (JP.q-extS K2 K Aw s1 a1 PW0)
        (JP.trE-sym K2 (subT K2 K Aw s1) A2 QA1 v1) ;

    Lv1 : Ov K2 K2 A2 swK A2 PA2sw v1 v2 =
      SV.ovThen K2 K2 A2 swK (subT K2 K Aw s1) A2 PW0 QA1 v1 (subt K2 K Aw (q G A) s1) v2
        (IN.wkE-extS K2 K Aw Aw (q G A) s1 a1 PW0)
        (calc (El K2 A2) {
            trE K2 (subT K2 K Aw s1) A2 QA1 (subt K2 K Aw (q G A) s1)
          =< sym (El K2 A2) (trE K2 A12 A2 (sym (Ty K2) A2 A12 PA12) (trE K2 (subT K2 K Aw s1) A12 PWq (subt K2 K Aw (q G A) s1)))
                (trE K2 (subT K2 K Aw s1) A2 QA1 (subt K2 K Aw (q G A) s1))
                (trE-tr K2 (subT K2 K Aw s1) A12 A2 PWq (sym (Ty K2) A2 A12 PA12) (subt K2 K Aw (q G A) s1)) >
            trE K2 A12 A2 (sym (Ty K2) A2 A12 PA12) (trE K2 (subT K2 K Aw s1) A12 PWq (subt K2 K Aw (q G A) s1))
          =< ap (El K2 A12) (El K2 A2) (\ v -> trE K2 A12 A2 (sym (Ty K2) A2 A12 PA12) v)
                (trE K2 (subT K2 K Aw s1) A12 PWq (subt K2 K Aw (q G A) s1)) v2r (JP.q-extS K2 G A p12 v2r PWq) >
            trE K2 A12 A2 (sym (Ty K2) A2 A12 PA12) v2r
          =< IN.trE-symL K2 A2 A12 PA12 v2 >
            v2 }) ;

    PBsw : Id (Ty K2) (subT K2 K2 Bw swK) IKx = Id-ov K2 K2 A2 v2 v1 swK A2 PA2sw v1 v2 Lv2 Lv1 ;
    PIsw : Id (Ty K2) (subT K2 K2 IKx swK) Bw = Id-ov K2 K2 A2 v1 v2 swK A2 PA2sw v2 v1 Lv1 Lv2 ;

    -- s1 swK = p
    S1W : Id (Sub K2 K) (o K2 K2 K s1 swK) (p K Aw) =
      IN.ext-eq K2 G A (o K2 K2 K s1 swK) (p K Aw)
        (calc (Sub K2 G) {
            o K2 K G (p G A) (o K2 K2 K s1 swK)
          =< sym (Sub K2 G) (o K2 K2 G (o K2 K G (p G A) s1) swK) (o K2 K G (p G A) (o K2 K2 K s1 swK)) (o-assoc K2 K2 K G (p G A) s1 swK) >
            o K2 K2 G (o K2 K G (p G A) s1) swK
          =< ap (Sub K2 G) (Sub K2 G) (\ t -> o K2 K2 G t swK) (o K2 K G (p G A) s1) p12 (IN.p-extS K2 G A p12 v2r) >
            o K2 K2 G p12 swK
          =< o-assoc K2 K2 K G (p G A) (p K Aw) swK >
            o K2 K G (p G A) (o K2 K2 K (p K Aw) swK)
          =< ap (Sub K2 K) (Sub K2 G) (\ t -> o K2 K G (p G A) t) (o K2 K2 K (p K Aw) swK) s1 (IN.p-extS K2 K Aw s1 a1) >
            o K2 K G (p G A) s1
          =< IN.p-extS K2 G A p12 v2r >
            p12 })
        A12 (trE K2 A2 A12 PA12 v1)
        Pq1
        (JP.ovO K2 K2 K (wkT G A A) s1 swK A12 PWq A12 P2' Pq1 (q G A) v2r (trE K2 A2 A12 PA12 v1)
           (JP.q-extS K2 G A p12 v2r PWq)
           (ovTr K2 K2 A2 A12 PA12 swK A2 A12 PA12 PA2sw P2' v2 v1 Lv2))
        PA12 (refl (trE K2 A2 A12 PA12 v1))
     where {
      P2' : Id (Ty K2) (subT K2 K2 A12 swK) A12 =
        trans (Ty K2) (subT K2 K2 A12 swK) (subT K2 K2 A2 swK) A12
          (ap (Ty K2) (Ty K2) (\ X -> subT K2 K2 X swK) A12 A2 (sym (Ty K2) A2 A12 PA12))
          (trans (Ty K2) (subT K2 K2 A2 swK) A2 A12 PA2sw PA12) ;
      Pq1 : Id (Ty K2) (subT K2 K (wkT G A A) (o K2 K2 K s1 swK)) A12 =
        trans (Ty K2) (subT K2 K (wkT G A A) (o K2 K2 K s1 swK)) (subT K2 K2 (subT K2 K (wkT G A A) s1) swK) A12
          (subT-o K2 K2 K (wkT G A A) s1 swK)
          (trans (Ty K2) (subT K2 K2 (subT K2 K (wkT G A A) s1) swK) (subT K2 K2 A12 swK) A12
             (ap (Ty K2) (Ty K2) (\ X -> subT K2 K2 X swK) (subT K2 K (wkT G A A) s1) A12 PWq) P2') ;
     } ;

    -- swK swK = id
    swsw : Id (Sub K2 K2) (o K2 K2 K2 swK swK) (id K2) =
      IN.ext-eq K2 K Aw (o K2 K2 K2 swK swK) (id K2)
        (calc (Sub K2 K) {
            o K2 K2 K (p K Aw) (o K2 K2 K2 swK swK)
          =< sym (Sub K2 K) (o K2 K2 K (o K2 K2 K (p K Aw) swK) swK) (o K2 K2 K (p K Aw) (o K2 K2 K2 swK swK)) (o-assoc K2 K2 K2 K (p K Aw) swK swK) >
            o K2 K2 K (o K2 K2 K (p K Aw) swK) swK
          =< ap (Sub K2 K) (Sub K2 K) (\ t -> o K2 K2 K t swK) (o K2 K2 K (p K Aw) swK) s1 (IN.p-extS K2 K Aw s1 a1) >
            o K2 K2 K s1 swK
          =< S1W >
            p K Aw
          =< sym (Sub K2 K) (o K2 K2 K (p K Aw) (id K2)) (p K Aw) (o-idr K2 K (p K Aw)) >
            o K2 K2 K (p K Aw) (id K2) })
        A2 v2
        (trans (Ty K2) (subT K2 K2 A2 (o K2 K2 K2 swK swK)) (subT K2 K2 (subT K2 K2 A2 swK) swK) A2
           (subT-o K2 K2 K2 A2 swK swK)
           (trans (Ty K2) (subT K2 K2 (subT K2 K2 A2 swK) swK) (subT K2 K2 A2 swK) A2
              (ap (Ty K2) (Ty K2) (\ X -> subT K2 K2 X swK) (subT K2 K2 A2 swK) A2 PA2sw) PA2sw))
        (JP.ovO K2 K2 K2 A2 swK swK A2 PA2sw A2 PA2sw
           (trans (Ty K2) (subT K2 K2 A2 (o K2 K2 K2 swK swK)) (subT K2 K2 (subT K2 K2 A2 swK) swK) A2
              (subT-o K2 K2 K2 A2 swK swK)
              (trans (Ty K2) (subT K2 K2 (subT K2 K2 A2 swK) swK) (subT K2 K2 A2 swK) A2
                 (ap (Ty K2) (Ty K2) (\ X -> subT K2 K2 X swK) (subT K2 K2 A2 swK) A2 PA2sw) PA2sw))
           v2 v1 v2 Lv2 Lv1)
        (subT-id K2 A2) (subt-id K2 A2 v2) ;

    -- s1 o (sec of the variable) = id
    S1S : Id (Sub K K) (o K K2 K s1 (sec K Aw (q G A))) (id K) =
      IN.ext-eq K G A (o K K2 K s1 (sec K Aw (q G A))) (id K)
        (calc (Sub K G) {
            o K K G (p G A) (o K K2 K s1 (sec K Aw (q G A)))
          =< sym (Sub K G) (o K K2 G (o K2 K G (p G A) s1) (sec K Aw (q G A))) (o K K G (p G A) (o K K2 K s1 (sec K Aw (q G A))))
                (o-assoc K K2 K G (p G A) s1 (sec K Aw (q G A))) >
            o K K2 G (o K2 K G (p G A) s1) (sec K Aw (q G A))
          =< ap (Sub K2 G) (Sub K G) (\ t -> o K K2 G t (sec K Aw (q G A))) (o K2 K G (p G A) s1) p12 (IN.p-extS K2 G A p12 v2r) >
            o K K2 G p12 (sec K Aw (q G A))
          =< o-assoc K K2 K G (p G A) (p K Aw) (sec K Aw (q G A)) >
            o K K G (p G A) (o K K2 K (p K Aw) (sec K Aw (q G A)))
          =< ap (Sub K K) (Sub K G) (\ t -> o K K G (p G A) t) (o K K2 K (p K Aw) (sec K Aw (q G A))) (id K) (p-sec K Aw (q G A)) >
            o K K G (p G A) (id K) })
        Aw (q G A)
        Pq1
        (JP.ovO K K2 K (wkT G A A) s1 (sec K Aw (q G A)) A12 PWq Aw P2 Pq1 (q G A) v2r (q G A)
           (JP.q-extS K2 G A p12 v2r PWq)
           (ovTr K K2 A2 A12 PA12 (sec K Aw (q G A)) Aw Aw (refl Aw) (p-sec-T K Aw Aw (q G A)) P2 v2 (q G A)
              (IN.q-secO K Aw (q G A) (p-sec-T K Aw Aw (q G A)))))
        (subT-id K Aw) (subt-id K Aw (q G A))
     where {
      P2 : Id (Ty K) (subT K K2 A12 (sec K Aw (q G A))) Aw =
        trans (Ty K) (subT K K2 A12 (sec K Aw (q G A))) (subT K K2 A2 (sec K Aw (q G A))) Aw
          (ap (Ty K2) (Ty K) (\ X -> subT K K2 X (sec K Aw (q G A))) A12 A2 (sym (Ty K2) A2 A12 PA12))
          (p-sec-T K Aw Aw (q G A)) ;
      Pq1 : Id (Ty K) (subT K K (wkT G A A) (o K K2 K s1 (sec K Aw (q G A)))) Aw =
        trans (Ty K) (subT K K (wkT G A A) (o K K2 K s1 (sec K Aw (q G A)))) (subT K K2 (subT K2 K (wkT G A A) s1) (sec K Aw (q G A))) Aw
          (subT-o K K2 K (wkT G A A) s1 (sec K Aw (q G A)))
          (trans (Ty K) (subT K K2 (subT K2 K (wkT G A A) s1) (sec K Aw (q G A))) (subT K K2 A12 (sec K Aw (q G A))) Aw
             (ap (Ty K2) (Ty K) (\ X -> subT K K2 X (sec K Aw (q G A))) (subT K2 K (wkT G A A) s1) A12 PWq) P2) ;
     } ;

    ------------------------------------------------------------------
    -- (2) the lifts of the swap

    tau : Sub Dx E2 = upT K2 K2 Bw swK IKx PBsw ;
    ex : Sub E2 Dx = upT K2 K2 IKx swK Bw PIsw ;
    sigz : Sub Dx K = o Dx K2 K s1 pD ;

    tauex : Id (Sub E2 E2) (o E2 Dx E2 tau ex) (id E2) =
      IN.ext-eq E2 K2 Bw (o E2 Dx E2 tau ex) (id E2)
        (calc (Sub E2 K2) {
            o E2 E2 K2 pE (o E2 Dx E2 tau ex)
          =< sym (Sub E2 K2) (o E2 Dx K2 (o Dx E2 K2 pE tau) ex) (o E2 E2 K2 pE (o E2 Dx E2 tau ex)) (o-assoc E2 Dx E2 K2 pE tau ex) >
            o E2 Dx K2 (o Dx E2 K2 pE tau) ex
          =< ap (Sub Dx K2) (Sub E2 K2) (\ t -> o E2 Dx K2 t ex) (o Dx E2 K2 pE tau) (o Dx K2 K2 swK pD) (pUp K2 K2 Bw swK IKx PBsw) >
            o E2 Dx K2 (o Dx K2 K2 swK pD) ex
          =< o-assoc E2 Dx K2 K2 swK pD ex >
            o E2 K2 K2 swK (o E2 Dx K2 pD ex)
          =< ap (Sub E2 K2) (Sub E2 K2) (\ t -> o E2 K2 K2 swK t) (o E2 Dx K2 pD ex) (o E2 K2 K2 swK pE) (pUp K2 K2 IKx swK Bw PIsw) >
            o E2 K2 K2 swK (o E2 K2 K2 swK pE)
          =< sym (Sub E2 K2) (o E2 K2 K2 (o K2 K2 K2 swK swK) pE) (o E2 K2 K2 swK (o E2 K2 K2 swK pE)) (o-assoc E2 K2 K2 K2 swK swK pE) >
            o E2 K2 K2 (o K2 K2 K2 swK swK) pE
          =< ap (Sub K2 K2) (Sub E2 K2) (\ t -> o E2 K2 K2 t pE) (o K2 K2 K2 swK swK) (id K2) swsw >
            o E2 K2 K2 (id K2) pE
          =< o-idl E2 K2 pE >
            pE
          =< sym (Sub E2 K2) (o E2 E2 K2 pE (id E2)) pE (o-idr E2 K2 pE) >
            o E2 E2 K2 pE (id E2) })
        (wkT K2 Bw Bw) (q K2 Bw)
        P1
        (JP.ovO E2 Dx E2 (wkT K2 Bw Bw) tau ex (wkT K2 IKx IKx) Wq1 (wkT K2 Bw Bw) Wq2 P1 (q K2 Bw) (q K2 IKx) (q K2 Bw)
           (q-ov K2 K2 Bw swK IKx PBsw Wq1)
           (q-ov K2 K2 IKx swK Bw PIsw Wq2))
        (subT-id E2 (wkT K2 Bw Bw)) (subt-id E2 (wkT K2 Bw Bw) (q K2 Bw))
     where {
      Wq1 : Id (Ty Dx) (subT Dx E2 (wkT K2 Bw Bw) tau) (wkT K2 IKx IKx) = wkT-ov K2 K2 Bw Bw swK IKx PBsw IKx PBsw ;
      Wq2 : Id (Ty E2) (subT E2 Dx (wkT K2 IKx IKx) ex) (wkT K2 Bw Bw) = wkT-ov K2 K2 IKx IKx swK Bw PIsw Bw PIsw ;
      P1 : Id (Ty E2) (subT E2 E2 (wkT K2 Bw Bw) (o E2 Dx E2 tau ex)) (wkT K2 Bw Bw) =
        trans (Ty E2) (subT E2 E2 (wkT K2 Bw Bw) (o E2 Dx E2 tau ex)) (subT E2 Dx (subT Dx E2 (wkT K2 Bw Bw) tau) ex) (wkT K2 Bw Bw)
          (subT-o E2 Dx E2 (wkT K2 Bw Bw) tau ex)
          (trans (Ty E2) (subT E2 Dx (subT Dx E2 (wkT K2 Bw Bw) tau) ex) (subT E2 Dx (wkT K2 IKx IKx) ex) (wkT K2 Bw Bw)
             (ap (Ty Dx) (Ty E2) (\ X -> subT E2 Dx X ex) (subT Dx E2 (wkT K2 Bw Bw) tau) (wkT K2 IKx IKx) Wq1) Wq2) ;
     } ;

    PPT : Id (Sub Dx K) (o Dx E2 K VC.pp tau) sigz =
      calc (Sub Dx K) {
          o Dx E2 K (o E2 K2 K (p K Aw) pE) tau
        =< o-assoc Dx E2 K2 K (p K Aw) pE tau >
          o Dx K2 K (p K Aw) (o Dx E2 K2 pE tau)
        =< ap (Sub Dx K2) (Sub Dx K) (\ t -> o Dx K2 K (p K Aw) t) (o Dx E2 K2 pE tau) (o Dx K2 K2 swK pD) (pUp K2 K2 Bw swK IKx PBsw) >
          o Dx K2 K (p K Aw) (o Dx K2 K2 swK pD)
        =< sym (Sub Dx K) (o Dx K2 K (o K2 K2 K (p K Aw) swK) pD) (o Dx K2 K (p K Aw) (o Dx K2 K2 swK pD)) (o-assoc Dx K2 K2 K (p K Aw) swK pD) >
          o Dx K2 K (o K2 K2 K (p K Aw) swK) pD
        =< ap (Sub K2 K) (Sub Dx K) (\ t -> o Dx K2 K t pD) (o K2 K2 K (p K Aw) swK) s1 (IN.p-extS K2 K Aw s1 a1) >
          sigz } ;

    cY : Sub K Dx = DJ.cen K Aw (q G A) ;

    sigcY : Id (Sub K K) (o K Dx K sigz cY) (id K) =
      calc (Sub K K) {
          o K Dx K (o Dx K2 K s1 pD) cY
        =< o-assoc K Dx K2 K s1 pD cY >
          o K K2 K s1 (o K Dx K2 pD cY)
        =< ap (Sub K K2) (Sub K K) (\ t -> o K K2 K s1 t) (o K Dx K2 pD cY) (sec K Aw (q G A))
              (IN.p-extS K K2 IKx (sec K Aw (q G A)) (DJ.reflE K Aw (q G A))) >
          o K K2 K s1 (sec K Aw (q G A))
        =< S1S >
          id K } ;

    sigex : Id (Sub E2 K) (o E2 Dx K sigz ex) VC.pp =
      calc (Sub E2 K) {
          o E2 Dx K (o Dx K2 K s1 pD) ex
        =< o-assoc E2 Dx K2 K s1 pD ex >
          o E2 K2 K s1 (o E2 Dx K2 pD ex)
        =< ap (Sub E2 K2) (Sub E2 K) (\ t -> o E2 K2 K s1 t) (o E2 Dx K2 pD ex) (o E2 K2 K2 swK pE) (pUp K2 K2 IKx swK Bw PIsw) >
          o E2 K2 K s1 (o E2 K2 K2 swK pE)
        =< sym (Sub E2 K) (o E2 K2 K (o K2 K2 K s1 swK) pE) (o E2 K2 K s1 (o E2 K2 K2 swK pE)) (o-assoc E2 K2 K2 K s1 swK pE) >
          o E2 K2 K (o K2 K2 K s1 swK) pE
        =< ap (Sub K2 K) (Sub E2 K) (\ t -> o E2 K2 K t pE) (o K2 K2 K s1 swK) (p K Aw) S1W >
          VC.pp } ;

    ------------------------------------------------------------------
    -- (3) the pair over Dx, the centre, J

    PRd : Id (Ty Dx) (subT Dx E2 VC.SW tau) (subT Dx K CoS0 sigz) =
      trans (Ty Dx) (subT Dx E2 VC.SW tau) (subT Dx K CoS0 (o Dx E2 K VC.pp tau)) (subT Dx K CoS0 sigz)
        (sym (Ty Dx) (subT Dx K CoS0 (o Dx E2 K VC.pp tau)) (subT Dx E2 VC.SW tau) (subT-o Dx E2 K CoS0 VC.pp tau))
        (ap (Sub Dx K) (Ty Dx) (\ t -> subT Dx K CoS0 t) (o Dx E2 K VC.pp tau) sigz PPT) ;

    R0 : El Dx (subT Dx E2 VC.SW tau) = subt Dx E2 VC.SW VC.pv tau ;
    R : El Dx (subT Dx K CoS0 sigz) = trE Dx (subT Dx E2 VC.SW tau) (subT Dx K CoS0 sigz) PRd R0 ;

    SZ : Ty Dx = subT Dx K CoS0 sigz ;

    PC : Id (Ty K) (subT K Dx SZ cY) CoS0 =
      trans (Ty K) (subT K Dx SZ cY) (subT K K CoS0 (o K Dx K sigz cY)) CoS0
        (sym (Ty K) (subT K K CoS0 (o K Dx K sigz cY)) (subT K Dx SZ cY) (subT-o K Dx K CoS0 sigz cY))
        (trans (Ty K) (subT K K CoS0 (o K Dx K sigz cY)) (subT K K CoS0 (id K)) CoS0
           (ap (Sub K K) (Ty K) (\ t -> subT K K CoS0 t) (o K Dx K sigz cY) (id K) sigcY)
           (subT-id K CoS0)) ;

    c' : El K CoS0 = trE K (subT K Dx SZ cY) CoS0 PC (subt K Dx SZ R cY) ;

    L : El Dx SZ = subt Dx K CoS0 c' sigz ;

    CM : Ty Dx = IJ.IdT Dx SZ L R ;

    Pcen : Id (Ty K) (subT K Dx CM cY) (IJ.IdT K CoS0 c' c') =
      Id-ov K Dx SZ L R cY CoS0 PC c' c'
        (trans (El K CoS0) (trE K (subT K Dx SZ cY) CoS0 PC (subt K Dx SZ L cY)) (trE K (subT K K CoS0 (id K)) CoS0 (subT-id K CoS0) (subt K K CoS0 c' (id K))) c'
           (SG.subComp K Dx K CoS0 c' sigz cY (id K) sigcY CoS0 PC (subT-id K CoS0))
           (subt-id K CoS0 c'))
        (refl c') ;

    JE : El Dx CM =
      IJ.J K Aw (q G A) CM
        (trE K (IJ.IdT K CoS0 c' c') (subT K Dx CM cY) (sym (Ty K) (subT K Dx CM cY) (IJ.IdT K CoS0 c' c') Pcen) (IJ.rfl K CoS0 c')) ;

    -- along ex
    PSx : Id (Ty E2) (subT E2 Dx SZ ex) VC.SW =
      trans (Ty E2) (subT E2 Dx SZ ex) (subT E2 K CoS0 (o E2 Dx K sigz ex)) VC.SW
        (sym (Ty E2) (subT E2 K CoS0 (o E2 Dx K sigz ex)) (subT E2 Dx SZ ex) (subT-o E2 Dx K CoS0 sigz ex))
        (ap (Sub E2 K) (Ty E2) (\ t -> subT E2 K CoS0 t) (o E2 Dx K sigz ex) VC.pp sigex) ;

    PLx : Ov E2 Dx SZ ex VC.SW PSx L (subt E2 K CoS0 c' VC.pp) =
      SG.subComp E2 Dx K CoS0 c' sigz ex VC.pp sigex VC.SW PSx (refl VC.SW) ;

    PRx : Ov E2 Dx SZ ex VC.SW PSx R VC.pv =
      IN.teAny E2 (subT E2 Dx SZ ex) VC.SW (subt E2 Dx SZ R ex) VC.pv
        (IN.teT E2 (subT E2 Dx SZ ex) (subT E2 Dx (subT Dx E2 VC.SW tau) ex) VC.SW (subt E2 Dx SZ R ex) (subt E2 Dx (subT Dx E2 VC.SW tau) R0 ex) VC.pv
           (IN.teS E2 (subT E2 Dx (subT Dx E2 VC.SW tau) ex) (subT E2 Dx SZ ex) (subt E2 Dx (subT Dx E2 VC.SW tau) R0 ex) (subt E2 Dx SZ R ex)
              (IN.teSubtTr E2 Dx (subT Dx E2 VC.SW tau) SZ PRd R0 ex))
           (IN.teT E2 (subT E2 Dx (subT Dx E2 VC.SW tau) ex) (subT E2 E2 VC.SW (o E2 Dx E2 tau ex)) VC.SW
              (subt E2 Dx (subT Dx E2 VC.SW tau) R0 ex) (subt E2 E2 VC.SW VC.pv (o E2 Dx E2 tau ex)) VC.pv
              (IN.teS E2 (subT E2 E2 VC.SW (o E2 Dx E2 tau ex)) (subT E2 Dx (subT Dx E2 VC.SW tau) ex)
                 (subt E2 E2 VC.SW VC.pv (o E2 Dx E2 tau ex)) (subt E2 Dx (subT Dx E2 VC.SW tau) R0 ex)
                 (IN.teSubtO E2 Dx E2 VC.SW VC.pv tau ex))
              (IN.teT E2 (subT E2 E2 VC.SW (o E2 Dx E2 tau ex)) (subT E2 E2 VC.SW (id E2)) VC.SW
                 (subt E2 E2 VC.SW VC.pv (o E2 Dx E2 tau ex)) (subt E2 E2 VC.SW VC.pv (id E2)) VC.pv
                 (IN.teSubEq E2 E2 VC.SW VC.pv (o E2 Dx E2 tau ex) (id E2) tauex)
                 (subT-id E2 VC.SW, subt-id E2 VC.SW VC.pv))))
        PSx ;

    Xc : El E2 (IJ.IdT E2 VC.SW (subt E2 K CoS0 c' VC.pp) VC.pv) =
      trE E2 (subT E2 Dx CM ex) (IJ.IdT E2 VC.SW (subt E2 K CoS0 c' VC.pp) VC.pv)
        (Id-ov E2 Dx SZ L R ex VC.SW PSx (subt E2 K CoS0 c' VC.pp) VC.pv PLx PRx)
        (subt E2 Dx CM JE ex) ;

    -- along unpk: the contraction
    Pcu : Ov (ext K CoS0) E2 VC.SW VC.unpk (wkT K CoS0 CoS0) VC.PU (subt E2 K CoS0 c' VC.pp) (wkE K CoS0 CoS0 c') =
      SG.subComp (ext K CoS0) E2 K CoS0 c' VC.pp VC.unpk (p K CoS0) VC.pp-unpk (wkT K CoS0 CoS0) VC.PU (refl (wkT K CoS0 CoS0)) ;

    Pctr : Id (Ty (ext K CoS0)) (subT (ext K CoS0) E2 (IJ.IdT E2 VC.SW (subt E2 K CoS0 c' VC.pp) VC.pv) VC.unpk) (JP.IK K CoS0 c') =
      Id-ov (ext K CoS0) E2 VC.SW (subt E2 K CoS0 c' VC.pp) VC.pv VC.unpk (wkT K CoS0 CoS0) VC.PU (wkE K CoS0 CoS0 c') (q K CoS0) Pcu VC.pv-unpk ;

    ctr : El (ext K CoS0) (JP.IK K CoS0 c') =
      trE (ext K CoS0) (subT (ext K CoS0) E2 (IJ.IdT E2 VC.SW (subt E2 K CoS0 c' VC.pp) VC.pv) VC.unpk) (JP.IK K CoS0 c') Pctr
        (subt (ext K CoS0) E2 (IJ.IdT E2 VC.SW (subt E2 K CoS0 c' VC.pp) VC.pv) Xc VC.unpk) ;

    coSC : El K (EQ.isContr K CoS0) = SG.mkContr K CoS0 c' ctr ;
  } ;

  -- co-based singletons are contractible, over G.A (the right end varies)
  coSC (G : Ctx) (A : Ty G) : El (ext G A) (EQ.isContr (ext G A) (CoSF G A)) = CS[G, A].coSC ;
} ;
