-- CwFRet.seg (M1 step 3, S4 toolkit): a retract of a contractible type
-- is contractible, in a CwF with Pi, Sigma and Swan Id.
--
-- Maps are elements over context extensions: sm : Q p over G.T (from T
-- to Q), rm : T p over G.Q (from Q to T).  rs, the composite at the
-- variable t of T, is rm along sgm = (p , sm) : G.T -> G.Q.
--
-- Informal text.  Let h : Id(rs , t) over G.T and let Q be contractible
-- with centre cQ.  The centre of T is cT = rm(cQ).  Over G.T:
-- (1) uQ : Id(cQ , sm t), the contraction of Q along sgm (Id-ov with the
--     leaves wkE-extS, q-extS).
-- (2) ap of rm (weakened along p) to uQ : Id(rm(cQ) , rm(sm t)).  Its
--     ends are cT p and rs: both are transports of rm along composites of
--     substitutions that agree (sec-o; extS = lift o sec by definition),
--     by the TE calculus of CwFInt.
-- (3) trans with h: Id(cT p , t), the contraction.

open Base ;

module Ret (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;

  module R (G : Ctx) (T Q : Ty G) (sm : El (ext G T) (wkT G T Q)) (rm : El (ext G Q) (wkT G Q T)) {
    K : Ctx = ext G T ;
    Qp : Ty K = wkT G T Q ;
    Tp : Ty K = wkT G T T ;
    sgm : Sub K (ext G Q) = extS K G Q (p G T) sm ;
    PRS : Id (Ty K) (subT K (ext G Q) (wkT G Q T) sgm) Tp = IN.wkT-extS K G Q T (p G T) sm ;
    rs : El K Tp = trE K (subT K (ext G Q) (wkT G Q T) sgm) Tp PRS (subt K (ext G Q) (wkT G Q T) rm sgm) ;

    -- rm weakened along p
    L : Sub (ext K Qp) (ext G Q) = lift K G Q (p G T) ;
    PL : Id (Ty (ext K Qp)) (subT (ext K Qp) (ext G Q) (wkT G Q T) L) (wkT K Qp Tp) = p-lift-T K G Q T (p G T) ;
    rmw : El (ext K Qp) (wkT K Qp Tp) = trE (ext K Qp) (subT (ext K Qp) (ext G Q) (wkT G Q T) L) (wkT K Qp Tp) PL (subt (ext K Qp) (ext G Q) (wkT G Q T) rm L) ;

    -- rm weakened, at x, is rm along lift p o sec x
    teW (x : El K Qp)
      : IN.TE K (subT K (ext G Q) (wkT G Q T) (o K (ext K Qp) (ext G Q) L (sec K Qp x))) Tp
           (subt K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp x))) (PT.atv K Qp Tp rmw x) =
      IN.teT K (subT K (ext G Q) (wkT G Q T) (o K (ext K Qp) (ext G Q) L (sec K Qp x)))
               (subT K (ext K Qp) (wkT K Qp Tp) (sec K Qp x)) Tp
        (subt K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp x)))
        (subt K (ext K Qp) (wkT K Qp Tp) rmw (sec K Qp x)) (PT.atv K Qp Tp rmw x)
        (IN.teT K (subT K (ext G Q) (wkT G Q T) (o K (ext K Qp) (ext G Q) L (sec K Qp x)))
                  (subT K (ext K Qp) (subT (ext K Qp) (ext G Q) (wkT G Q T) L) (sec K Qp x))
                  (subT K (ext K Qp) (wkT K Qp Tp) (sec K Qp x))
           (subt K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp x)))
           (subt K (ext K Qp) (subT (ext K Qp) (ext G Q) (wkT G Q T) L) (subt (ext K Qp) (ext G Q) (wkT G Q T) rm L) (sec K Qp x))
           (subt K (ext K Qp) (wkT K Qp Tp) rmw (sec K Qp x))
           (IN.teSubtO K (ext K Qp) (ext G Q) (wkT G Q T) rm L (sec K Qp x))
           (IN.teSubtTr K (ext K Qp) (subT (ext K Qp) (ext G Q) (wkT G Q T) L) (wkT K Qp Tp) PL (subt (ext K Qp) (ext G Q) (wkT G Q T) rm L) (sec K Qp x)))
        (IN.teTr K (subT K (ext K Qp) (wkT K Qp Tp) (sec K Qp x)) Tp (p-sec-T K Qp Tp x) (subt K (ext K Qp) (wkT K Qp Tp) rmw (sec K Qp x))) ;

    -- at sm: rs
    e-sm : Id (El K Tp) (PT.atv K Qp Tp rmw sm) rs =
      IN.teAny K Tp Tp (PT.atv K Qp Tp rmw sm) rs
        (IN.teT K Tp (subT K (ext G Q) (wkT G Q T) sgm) Tp (PT.atv K Qp Tp rmw sm) (subt K (ext G Q) (wkT G Q T) rm sgm) rs
           (IN.teS K (subT K (ext G Q) (wkT G Q T) sgm) Tp (subt K (ext G Q) (wkT G Q T) rm sgm) (PT.atv K Qp Tp rmw sm) (teW sm))
           (IN.teTr K (subT K (ext G Q) (wkT G Q T) sgm) Tp PRS (subt K (ext G Q) (wkT G Q T) rm sgm)))
        (refl Tp) ;

    module H (hm : El K (IJ.IdT K Tp rs (q G T))) (kQ : El G (EQ.isContr G Q)) {
      cQ : El G Q = SG.cenOf G Q kQ ;
      cT : El G T = PT.atv G Q T rm cQ ;
      w0 : El K Qp = wkE G T Q cQ ;

      -- (1) the contraction of Q at sm
      ctrQ : El (ext G Q) (JP.IK G Q cQ) = bod G Q (JP.IK G Q cQ) (SG.ctrPiOf G Q kQ) ;
      PW : Id (Ty K) (subT K (ext G Q) (wkT G Q Q) sgm) Qp = IN.wkT-extS K G Q Q (p G T) sm ;
      PUQ : Id (Ty K) (subT K (ext G Q) (JP.IK G Q cQ) sgm) (IJ.IdT K Qp w0 sm) =
        Id-ov K (ext G Q) (wkT G Q Q) (wkE G Q Q cQ) (q G Q) sgm Qp PW w0 sm
          (IN.wkE-extS K G Q Q cQ (p G T) sm PW) (JP.q-extS K G Q (p G T) sm PW) ;
      uQ : El K (IJ.IdT K Qp w0 sm) = trE K (subT K (ext G Q) (JP.IK G Q cQ) sgm) (IJ.IdT K Qp w0 sm) PUQ (subt K (ext G Q) (JP.IK G Q cQ) ctrQ sgm) ;

      -- (2) ap of rm, and its ends
      apU : El K (IJ.IdT K Tp (PT.atv K Qp Tp rmw w0) (PT.atv K Qp Tp rmw sm)) = PT.apM K Qp Tp rmw w0 sm uQ ;

      e-c : Id (El K Tp) (PT.atv K Qp Tp rmw w0) (wkE G T T cT) =
        IN.teAny K Tp Tp (PT.atv K Qp Tp rmw w0) (wkE G T T cT)
          (IN.teT K Tp X0 Tp (PT.atv K Qp Tp rmw w0) (subt K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp w0))) (wkE G T T cT)
             (IN.teS K X0 Tp (subt K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp w0))) (PT.atv K Qp Tp rmw w0) (teW w0))
             (IN.teT K X0 (subT K (ext G Q) (wkT G Q T) (o K G (ext G Q) (sec G Q cQ) (p G T))) Tp
                (subt K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp w0)))
                (subt K (ext G Q) (wkT G Q T) rm (o K G (ext G Q) (sec G Q cQ) (p G T))) (wkE G T T cT)
                (IN.teSubEq K (ext G Q) (wkT G Q T) rm (o K (ext K Qp) (ext G Q) L (sec K Qp w0)) (o K G (ext G Q) (sec G Q cQ) (p G T))
                   (sym (Sub K (ext G Q)) (o K G (ext G Q) (sec G Q cQ) (p G T)) (o K (ext K Qp) (ext G Q) L (sec K Qp w0)) (sec-o K G Q cQ (p G T))))
                (IN.teT K (subT K (ext G Q) (wkT G Q T) (o K G (ext G Q) (sec G Q cQ) (p G T))) (subT K G (subT G (ext G Q) (wkT G Q T) (sec G Q cQ)) (p G T)) Tp
                   (subt K (ext G Q) (wkT G Q T) rm (o K G (ext G Q) (sec G Q cQ) (p G T)))
                   (subt K G (subT G (ext G Q) (wkT G Q T) (sec G Q cQ)) (subt G (ext G Q) (wkT G Q T) rm (sec G Q cQ)) (p G T))
                   (wkE G T T cT)
                   (IN.teSubtO K G (ext G Q) (wkT G Q T) rm (sec G Q cQ) (p G T))
                   (IN.teSubtTr K G (subT G (ext G Q) (wkT G Q T) (sec G Q cQ)) T (p-sec-T G Q T cQ) (subt G (ext G Q) (wkT G Q T) rm (sec G Q cQ)) (p G T)))))
          (refl Tp)
       where { X0 : Ty K = subT K (ext G Q) (wkT G Q T) (o K (ext K Qp) (ext G Q) L (sec K Qp w0)) ; } ;

      -- (3) the contraction of T
      apT : El K (IJ.IdT K Tp (wkE G T T cT) rs) =
        trE K (IJ.IdT K Tp (PT.atv K Qp Tp rmw w0) (PT.atv K Qp Tp rmw sm)) (IJ.IdT K Tp (wkE G T T cT) rs)
          (DJ.idCong K Tp Tp (refl Tp) (PT.atv K Qp Tp rmw w0) (PT.atv K Qp Tp rmw sm) (wkE G T T cT) rs e-c e-sm) apU ;

      ctrT : El K (JP.IK G T cT) = PT.transM K Tp (wkE G T T cT) rs (q G T) apT hm ;

      kT : El G (EQ.isContr G T) = SG.mkContr G T cT ctrT ;
    } ;
  } ;

  -- a retract of a contractible type is contractible
  retC (G : Ctx) (T Q : Ty G) (sm : El (ext G T) (wkT G T Q)) (rm : El (ext G Q) (wkT G Q T))
    (hm : El (ext G T) (IJ.IdT (ext G T) (wkT G T T) (R[G, T, Q, sm, rm].rs) (q G T))) (kQ : El G (EQ.isContr G Q))
    : El G (EQ.isContr G T) = R[G, T, Q, sm, rm].H[hm, kQ].kT ;
} ;
