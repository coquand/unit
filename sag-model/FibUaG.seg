-- FibUaG.seg (M1 step 3, S4, the map g of the assembly of uaC0, part 1).
-- Over R = resCtx (core: the full glue data, CExtBig's UB.CU.resCtx), the
-- universal triple (BU , AU' , alU) with core's glued equivalence eqU
-- (CExtEq2) gives, in the CwF of fibrant types, a map rd : Yd -> Xd and
-- an element kd of Kr rd.
--
-- Informal text.
-- (1) A map of types m : B -> A over D (core PMap) is an element of A
--     weakened over D.B (bodyOf): its value at w is m(w) read in the
--     fibre at the point of w (fromE); natural since m is (mnat).
-- (2) Xd = El along pA, then along inclR; Yd = El along bmap: their
--     underlying types are AU' and BU by definition.  rd = lam (bodyOf alU).
-- (3) S3's map for rd is alU up to app-lam (bod (lam b) = b is a path, not
--     a definition): the identity maps of fibres form a cart of triples
--     (BU , AU' , S.al) -> (BU , AU' , alU), so eqU moves to S.al (eR).
-- (4) kd = S3a(eR) (FibS3.A).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module LP = PB.GPre[a+] ;
module FCw = FibCwF[a, a+] ;
module FC = FCw.FC ;
module UU = CPosEl1[a].UU ;
module Un = FibUniv[a] ;
module OV = CwFOv.Ov[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId] ;
module UB = PB.CExtBig.UB[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl] ;

------------------------------------------------------------------------
-- (1) a map of types as an element of the weakened type

module BodyOf (D : L.PCtx) (B A : L.PTy[D]) (m : PB.CPartial[a+].PMap[D, B, A]) {
  module TA = LP.TyL[D, A] ;

  ev (W : Ob) (w : V1.Ix ((L.extP D B).ob W)) : V1.Ix (A.tob W (L.fstE D B W w)) =
    TA.fromE W (L.fstE D B W w) (m.mE W w) (m.mpt W w) ;

  evN (J I : Ob) (f : Hom J I) (w : V1.Ix ((L.extP D B).ob I)) (w' : V1.Ix ((L.extP D B).ob J))
    (e : Id (V1.Ix ((L.extP D B).ob J)) ((L.extP D B).act J I f w) w')
    : Id (V1.Ix (A.tob J (L.fstE D B J w')))
         ((L.subTy (L.extP D B) D A (L.pP D B)).tact J I f w w' e (ev I w)) (ev J w') =
    TA.pr-inj J (L.fstE D B J w') ((L.subTy (L.extP D B) D A (L.pP D B)).tact J I f w w' e (ev I w)) (ev J w')
      (transH (symH (TA.pr-tact J I f (L.fstE D B I w) (L.fstE D B J w') (L.ntEq (L.extP D B) D (L.pP D B) J I f w w' e) (ev I w)))
      (transH (apH (TA.E.act J I f) (TA.fromE-eq I (L.fstE D B I w) (m.mE I w) (m.mpt I w)))
      (transH (symH (m.mnat J I f w))
      (transH (apH (m.mE J) e)
              (symH (TA.fromE-eq J (L.fstE D B J w') (m.mE J w') (m.mpt J w'))))))) ;

  body : L.PEl[L.extP D B, L.subTy (L.extP D B) D A (L.pP D B)] =
    new L.PEl[L.extP D B, L.subTy (L.extP D B) D A (L.pP D B), ev, evN] ;

  -- read in the total space of A, the body at w is m(w)
  body-E (W : Ob) (w : V1.Ix ((L.extP D B).ob W)) : Id (TA.EI W) (TA.pr W (L.fstE D B W w) (body.eob W w)) (m.mE W w) =
    TA.fromE-eq W (L.fstE D B W w) (m.mE W w) (m.mpt W w) ;

  opaque evN ; opaque body-E ;
} ;

------------------------------------------------------------------------
-- (2) the types and the map over resCtx

R : L.PCtx = UB.CU.resCtx ;

Xd : FC.STy R = FC.subS R UB.GDr (FC.subS UB.GDr UU.UCtx Un.ElF UB.pA) UB.CU.inclR ;
Yd : FC.STy R = FC.subS R UU.UCtx Un.ElF UB.bmap ;

module BU = BodyOf[R, UB.BU, UB.AU', UB.alU] ;

rd : FCw.fibCwF.El R (OV.Fun R Yd Xd) = OV.lam R Yd (OV.wkT R Yd Xd) BU.body ;

module S = FibS3[a, a+].S3[R, Xd, Yd, rd] ;

------------------------------------------------------------------------
-- (3) eqU moved to S3's map

-- S3's map for rd is alU, pointwise
comm (W : Ob) (v : S.TY.EI W) : Id (S.TX.EI W) (S.al.mE W v) (UB.alU.mE W v) =
  transH (apH (\ u -> S.TX.pr W (S.TY.pr1 W v) (u.eob W v)) ((FCw.fibPi.Pi-iso R Yd (OV.wkT R Yd Xd)).fun-inv BU.body))
         (BU.body-E W v) ;

module HI = PB.CHFibCart[a+, a+].HCart[R, UB.BU, UB.AU', S.al, R, UB.BU, UB.AU', UB.alU,
  \ W x -> x, \ V W g x -> refl (R.act V W g x),
  \ W v -> v, \ W v -> refl (S.TX.pr1 W v), \ V W g v -> refl (S.TX.E.act V W g v), \ W v v' Pp Qp -> Qp,
  \ X x u -> u, \ X x u -> refl (S.TX.pr X x u),
  \ W v -> v, \ W v -> refl (S.TY.pr1 W v), \ V W g v -> refl (S.TY.E.act V W g v), \ W v v' Pp Qp -> Qp,
  \ X x u -> u, \ X x u -> refl (S.TY.pr X x u),
  comm] ;

eR : PB.CEquiv[a+].EquivOp R UB.BU UB.AU' S.al =
  HI.moveEq PB.CExtEq2.EQ2[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl].eqU ;

------------------------------------------------------------------------
-- (4) the element of Kr rd

kd : FCw.fibCwF.El R (FibS3[a, a+].QP.Kr R Xd Yd rd) = S.A[eR].k ;
