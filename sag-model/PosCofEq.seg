-- PosCofEq.seg (M1): the equaliser cofibrations {f = g} of cavrep
-- Setting 40, for any two maps f, g : X -> Y of finite posets (M1.md §1,
-- table: the non-empty subsets of {x : f x = g x}).
--
-- Informal text.  E = {x : f x = g x} is a decidable subset of X (values
-- are trees, with decidable equality).  The maps landing in the subset
-- sieve of E (PosCof.full-sub: determined by images, so a cofibration)
-- are those h : W -> X with all values in E, that is f h = g h value by
-- value, that is f h = g h (hom-eq).  The sieve is stable: its pullback
-- along k is the equaliser of f k and g k (both are the maps h with
-- f k h = g k h).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;
open PosCof[a] ;

module EqC (X Y : Ob) (f g : Hom X Y) {
  -- the points where f and g agree
  E : Subset X = \ x -> eqT (app X Y f x).1 (app X Y g x).1 ;

  eqS : PC.Phi X = (subS X X (idH X) E, full-sub X E) ;

  -- h lands in {f = g} iff f h = g h
  lands-eq (W : Ob) (h : Hom W X) (i : PC.Lands W X eqS h) : Id (Hom W Y) (compH W X Y f h) (compH W X Y g h) =
    hom-eq W Y (compH W X Y f h) (compH W X Y g h) (\ s ->
      transH (app-compH1 W X Y f h s)
        (transH (eqT-sound (app X Y f (app W X h s)).1 (app X Y g (app W X h s)).1 (pl s)) (symH (app-compH1 W X Y g h s))))
   where { pl : PosetSub.Lands W X E h =
             plands-eq W X E (compH W X X (idH X) h) h (comp-idl W X h) (isIn-sound W X (compH W X X (idH X) h) E i) ; } ;

  eq-lands (W : Ob) (h : Hom W X) (p : Id (Hom W Y) (compH W X Y f h) (compH W X Y g h)) : PC.Lands W X eqS h =
    isIn-complete W X (compH W X X (idH X) h) E
      (plands-eq W X E h (compH W X X (idH X) h) (symH (comp-idl W X h))
         (\ s -> transH (apH (\ t -> eqT t (app X Y g (app W X h s)).1)
                           (transH (symH (app-compH1 W X Y f h s))
                              (transH (apH (\ k -> (app W Y k s).1) p) (app-compH1 W X Y g h s))))
                         (eqT-refl (app X Y g (app W X h s)).1))) ;
} ;

-- stability: the pullback of {f = g} along k is {f k = g k}
eq-pre (Z X Y : Ob) (k : Hom Z X) (f g : Hom X Y)
  : Id (PC.Phi Z) (PC.pre Z X k EqC[X, Y, f, g].eqS) EqC[Z, Y, compH Z X Y f k, compH Z X Y g k].eqS =
  PC.phi-ext Z (PC.pre Z X k EqC[X, Y, f, g].eqS) EqC[Z, Y, compH Z X Y f k, compH Z X Y g k].eqS
    (\ W h i -> EqC[Z, Y, compH Z X Y f k, compH Z X Y g k].eq-lands W h
       (transH (comp-assoc W Z X Y f k h)
         (transH (EqC[X, Y, f, g].lands-eq W (compH W Z X k h) (PC.lands-pre W Z X k EqC[X, Y, f, g].eqS h i))
                 (symH (comp-assoc W Z X Y g k h)))))
    (\ W h i -> PC.pre-lands W Z X k EqC[X, Y, f, g].eqS h
       (EqC[X, Y, f, g].eq-lands W (compH W Z X k h)
          (transH (symH (comp-assoc W Z X Y f k h))
            (transH (EqC[Z, Y, compH Z X Y f k, compH Z X Y g k].lands-eq W h i) (comp-assoc W Z X Y g k h))))) ;
