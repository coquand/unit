-- CwFPth.seg (M1 step 3, S4 toolkit): ap, sym and trans for Swan Id in a
-- CwF with Pi, Sigma and Swan Id, each a transport (CwFTr) in a family
-- over G.A, with its value at refl.
--
-- A map from A to B over G is an element r of B p over G.A; its value at
-- x is r[sec x] read in B (atv).  For a function f, app f x is atv of
-- bod f, by definition.
--
-- Informal text.  For x y : A and u : Id(x , y):
-- (1) ap r u = transport of refl (r x) in the family Id(r x , r z) (z : A),
--     whose value at y is Id(r x , r y) (Id-ov; r[sec y] read in B is r y by
--     definition).
-- (2) sym u = transport of refl x in Id(z , x).
-- (3) trans u w = transport of u in Id(x , z) along w : Id(y , z) (the
--     family is CwFJ.IK, its values are IKpt).
-- At refl each is refl (resp. u): tr-refl, and a transport undone.

open Base ;

module Pth (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;

  -- the value of a map at a point
  atv (G : Ctx) (A B : Ty G) (r : El (ext G A) (wkT G A B)) (x : El G A) : El G B =
    trE G (subT G (ext G A) (wkT G A B) (sec G A x)) B (p-sec-T G A B x) (subt G (ext G A) (wkT G A B) r (sec G A x)) ;

  -- app f x is atv (bod f) x
  app-atv (G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) (x : El G A)
    : Id (El G B) (app G A B f x) (atv G A B (bod G A (wkT G A B) f) x) = refl (app G A B f x) ;

  ----------------------------------------------------------------------
  -- (1) ap

  APf (G : Ctx) (A B : Ty G) (r : El (ext G A) (wkT G A B)) (x : El G A) : Ty (ext G A) =
    IJ.IdT (ext G A) (wkT G A B) (wkE G A B (atv G A B r x)) r ;

  APpt (G : Ctx) (A B : Ty G) (r : El (ext G A) (wkT G A B)) (x y : El G A)
    : Id (Ty G) (subT G (ext G A) (APf G A B r x) (sec G A y)) (IJ.IdT G B (atv G A B r x) (atv G A B r y)) =
    Id-ov G (ext G A) (wkT G A B) (wkE G A B (atv G A B r x)) r (sec G A y) B (p-sec-T G A B y)
      (atv G A B r x) (atv G A B r y)
      (IN.wkE-sec G A B y (atv G A B r x) (p-sec-T G A B y))
      (refl (atv G A B r y)) ;

  apM (G : Ctx) (A B : Ty G) (r : El (ext G A) (wkT G A B)) (x y : El G A) (u : El G (IJ.IdT G A x y))
    : El G (IJ.IdT G B (atv G A B r x) (atv G A B r y)) =
    trE G (subT G (ext G A) (APf G A B r x) (sec G A y)) (IJ.IdT G B (atv G A B r x) (atv G A B r y)) (APpt G A B r x y)
      (TR.trP G A (APf G A B r x) x y u
         (trE G (IJ.IdT G B (atv G A B r x) (atv G A B r x)) (subT G (ext G A) (APf G A B r x) (sec G A x))
            (sym (Ty G) (subT G (ext G A) (APf G A B r x) (sec G A x)) (IJ.IdT G B (atv G A B r x) (atv G A B r x)) (APpt G A B r x x))
            (IJ.rfl G B (atv G A B r x)))) ;

  ap-refl (G : Ctx) (A B : Ty G) (r : El (ext G A) (wkT G A B)) (x : El G A)
    : Id (El G (IJ.IdT G B (atv G A B r x) (atv G A B r x))) (apM G A B r x x (IJ.rfl G A x)) (IJ.rfl G B (atv G A B r x)) =
    trans (El G Ixx) (apM G A B r x x (IJ.rfl G A x)) (trE G Px Ixx (APpt G A B r x x) (trE G Ixx Px (sym (Ty G) Px Ixx (APpt G A B r x x)) (IJ.rfl G B (atv G A B r x))))
      (IJ.rfl G B (atv G A B r x))
      (ap (El G Px) (El G Ixx) (\ v -> trE G Px Ixx (APpt G A B r x x) v)
          (TR.trP G A (APf G A B r x) x x (IJ.rfl G A x) (trE G Ixx Px (sym (Ty G) Px Ixx (APpt G A B r x x)) (IJ.rfl G B (atv G A B r x))))
          (trE G Ixx Px (sym (Ty G) Px Ixx (APpt G A B r x x)) (IJ.rfl G B (atv G A B r x)))
          (TR.tr-refl G A (APf G A B r x) x (trE G Ixx Px (sym (Ty G) Px Ixx (APpt G A B r x x)) (IJ.rfl G B (atv G A B r x)))))
      (JP.trE-sym G Px Ixx (APpt G A B r x x) (IJ.rfl G B (atv G A B r x)))
   where {
    Px : Ty G = subT G (ext G A) (APf G A B r x) (sec G A x) ;
    Ixx : Ty G = IJ.IdT G B (atv G A B r x) (atv G A B r x) ;
   } ;

  ----------------------------------------------------------------------
  -- (2) sym

  SYf (G : Ctx) (A : Ty G) (x : El G A) : Ty (ext G A) = IJ.IdT (ext G A) (wkT G A A) (q G A) (wkE G A A x) ;

  SYpt (G : Ctx) (A : Ty G) (x y : El G A) : Id (Ty G) (subT G (ext G A) (SYf G A x) (sec G A y)) (IJ.IdT G A y x) =
    Id-ov G (ext G A) (wkT G A A) (q G A) (wkE G A A x) (sec G A y) A (p-sec-T G A A y) y x
      (IN.q-secO G A y (p-sec-T G A A y)) (IN.wkE-sec G A A y x (p-sec-T G A A y)) ;

  symM (G : Ctx) (A : Ty G) (x y : El G A) (u : El G (IJ.IdT G A x y)) : El G (IJ.IdT G A y x) =
    trE G (subT G (ext G A) (SYf G A x) (sec G A y)) (IJ.IdT G A y x) (SYpt G A x y)
      (TR.trP G A (SYf G A x) x y u
         (trE G (IJ.IdT G A x x) (subT G (ext G A) (SYf G A x) (sec G A x))
            (sym (Ty G) (subT G (ext G A) (SYf G A x) (sec G A x)) (IJ.IdT G A x x) (SYpt G A x x)) (IJ.rfl G A x))) ;

  sym-refl (G : Ctx) (A : Ty G) (x : El G A)
    : Id (El G (IJ.IdT G A x x)) (symM G A x x (IJ.rfl G A x)) (IJ.rfl G A x) =
    trans (El G Ixx) (symM G A x x (IJ.rfl G A x)) (trE G Px Ixx (SYpt G A x x) (trE G Ixx Px (sym (Ty G) Px Ixx (SYpt G A x x)) (IJ.rfl G A x)))
      (IJ.rfl G A x)
      (ap (El G Px) (El G Ixx) (\ v -> trE G Px Ixx (SYpt G A x x) v)
          (TR.trP G A (SYf G A x) x x (IJ.rfl G A x) (trE G Ixx Px (sym (Ty G) Px Ixx (SYpt G A x x)) (IJ.rfl G A x)))
          (trE G Ixx Px (sym (Ty G) Px Ixx (SYpt G A x x)) (IJ.rfl G A x))
          (TR.tr-refl G A (SYf G A x) x (trE G Ixx Px (sym (Ty G) Px Ixx (SYpt G A x x)) (IJ.rfl G A x))))
      (JP.trE-sym G Px Ixx (SYpt G A x x) (IJ.rfl G A x))
   where {
    Px : Ty G = subT G (ext G A) (SYf G A x) (sec G A x) ;
    Ixx : Ty G = IJ.IdT G A x x ;
   } ;

  ----------------------------------------------------------------------
  -- (3) trans

  transM (G : Ctx) (A : Ty G) (x y z : El G A) (u : El G (IJ.IdT G A x y)) (w : El G (IJ.IdT G A y z))
    : El G (IJ.IdT G A x z) =
    trE G (subT G (ext G A) (JP.IK G A x) (sec G A z)) (IJ.IdT G A x z) (JP.IKpt G A x z)
      (TR.trP G A (JP.IK G A x) y z w
         (trE G (IJ.IdT G A x y) (subT G (ext G A) (JP.IK G A x) (sec G A y))
            (sym (Ty G) (subT G (ext G A) (JP.IK G A x) (sec G A y)) (IJ.IdT G A x y) (JP.IKpt G A x y)) u)) ;

  trans-refl (G : Ctx) (A : Ty G) (x y : El G A) (u : El G (IJ.IdT G A x y))
    : Id (El G (IJ.IdT G A x y)) (transM G A x y y u (IJ.rfl G A y)) u =
    trans (El G Ixy) (transM G A x y y u (IJ.rfl G A y)) (trE G Py Ixy (JP.IKpt G A x y) (trE G Ixy Py (sym (Ty G) Py Ixy (JP.IKpt G A x y)) u)) u
      (ap (El G Py) (El G Ixy) (\ v -> trE G Py Ixy (JP.IKpt G A x y) v)
          (TR.trP G A (JP.IK G A x) y y (IJ.rfl G A y) (trE G Ixy Py (sym (Ty G) Py Ixy (JP.IKpt G A x y)) u))
          (trE G Ixy Py (sym (Ty G) Py Ixy (JP.IKpt G A x y)) u)
          (TR.tr-refl G A (JP.IK G A x) y (trE G Ixy Py (sym (Ty G) Py Ixy (JP.IKpt G A x y)) u)))
      (JP.trE-sym G Py Ixy (JP.IKpt G A x y) u)
   where {
    Py : Ty G = subT G (ext G A) (JP.IK G A x) (sec G A y) ;
    Ixy : Ty G = IJ.IdT G A x y ;
   } ;
} ;
