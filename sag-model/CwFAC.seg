-- CwFAC.seg (M1 step 3, S4 toolkit): sections of a map with contractible
-- fibres form a contractible type ("type-theoretic choice"), in a CwF with
-- Pi, Sigma, Swan Id and naive function extensionality NF.
--
-- For u : X -> Y, SecT u = Sigma (v : Y -> X) Pi (y : Y) Id(u (v y) , y)
-- (the section part of CwFEq.isEquiv) and Pi (y : Y) FibE u y.
--
-- Informal text.  SecT u is a retract of Pi y FibE u y, which is
-- contractible by weak funext when every fibre is.
--   sm (v , h) = \ y. (v y , h y)     (at the context of SecT, from its
--                                      projections a1 , b1: CwFSig)
--   rm phi     = (\ y. fst (phi y) , \ y. snd (phi y)), i.e. the pair of
--                the variables pv along the map rho : G.Q -> G.(v).(h).
-- rho after (p , sm) is unpk, componentwise: the first component of the
-- body of sm is app v (q) (fst-pr), and lam (app (wkF v) q) = v (eta);
-- the second likewise.  So rs = pv along unpk = q: the homotopy is refl.
-- (1) eta lemmas.  (2) rm.  (3) sm.  (4) rho (p , sm) = unpk.  (5) secC.

open Base ;

module AC (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module RT = CwFRet.Ret[l, C, PS, SS, IJ] ;
  module RS = CwFRetS.RetS[l, C, PS, SS, IJ] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;
  module WF = CwFWfe.Wfe[l, C, PS, SS, IJ, NF] ;
  module QC = CwFQinvC.QinvC[l, C, PS, SS, IJ, NF] ;

  ----------------------------------------------------------------------
  -- (1) eta

  appq (D : Ctx) (A B : Ty D) (f : El D (Fun D A B))
    : Id (El (ext D A) (wkT D A B)) (app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B f) (q D A)) (bod D A (wkT D A B) f) =
    trans (El (ext D A) (wkT D A B)) (app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B f) (q D A))
      (app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B (lam D A (wkT D A B) (bod D A (wkT D A B) f))) (q D A)) (bod D A (wkT D A B) f)
      (ap (El D (Fun D A B)) (El (ext D A) (wkT D A B)) (\ F -> app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B F) (q D A))
          f (lam D A (wkT D A B) (bod D A (wkT D A B) f)) (sym (El D (Fun D A B)) (lam D A (wkT D A B) (bod D A (wkT D A B) f)) f ((PS.Pi-iso D A (wkT D A B)).inv-fun f)))
      (IN.appWkLamQ D A B (bod D A (wkT D A B) f)) ;

  etaF (D : Ctx) (A B : Ty D) (f : El D (Fun D A B))
    : Id (El D (Fun D A B)) (lam D A (wkT D A B) (app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B f) (q D A))) f =
    trans (El D (Fun D A B)) (lam D A (wkT D A B) (app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B f) (q D A))) (lam D A (wkT D A B) (bod D A (wkT D A B) f)) f
      (ap (El (ext D A) (wkT D A B)) (El D (Fun D A B)) (\ v -> lam D A (wkT D A B) v)
          (app (ext D A) (wkT D A A) (wkT D A B) (EQ.wkF D A A B f) (q D A)) (bod D A (wkT D A B) f) (appq D A B f))
      ((PS.Pi-iso D A (wkT D A B)).inv-fun f) ;

  -- the body along a transported lift (bodNat for upT)
  bodNatUp (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (F : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D A' B')) (f : El G (PS.Pi G A B))
    : Ov (ext D A') (ext G A) B (upT D G A s A' PA) B' PB (bod G A B f) (bod D A' B' (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D A' B') F (subt D G (PS.Pi G A B) f s))) =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> (PB2 : Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2)
         -> (F2 : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D X B2))
         -> Ov (ext D X) (ext G A) B (upT D G A s X PX) B2 PB2 (bod G A B f) (bod D X B2 (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D X B2) F2 (subt D G (PS.Pi G A B) f s))))
      (\ B2 PB2 ->
         idJ (Ty (ext D As)) BL
           (\ B3 PB3 -> (F3 : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D As B3))
              -> Ov (ext D As) (ext G A) B (lift D G A s) B3 PB3 (bod G A B f) (bod D As B3 (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D As B3) F3 (subt D G (PS.Pi G A B) f s))))
           (\ F3 -> sym (El (ext D As) BL) (bod D As BL (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D As BL) F3 (subt D G (PS.Pi G A B) f s)))
                      (subt (ext D As) (ext G A) B (bod G A B f) (lift D G A s))
                      (bodNat D G A B s BL (refl BL) F3 f))
           B2 PB2)
      A' PA B' PB F
   where {
    As : Ty D = subT D G A s ;
    BL : Ty (ext D As) = subT (ext D As) (ext G A) B (lift D G A s) ;
   } ;

  module SA (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) {
    FYX : Ty G = Fun G Y X ;
    Hs : Ty (ext G FYX) = EQ.SecH G X Y u ;
    S : Ty G = SS.Sig G FYX Hs ;
    module VS = SV.At[G, FYX, Hs] ;
    K : Ctx = ext G Y ;
    XK : Ty K = wkT G Y X ;
    YK : Ty K = wkT G Y Y ;
    uK : El K (Fun K XK YK) = EQ.wkF G Y X Y u ;
    FmK : Ty (ext K XK) = QB.FamE K XK YK uK (q G Y) ;
    FV : Ty K = QB.FibE K XK YK uK (q G Y) ;
    Q : Ty G = PS.Pi G Y FV ;

    ------------------------------------------------------------------
    -- (2) the second component's type, and the fibre family, at points

    PHsAt (D : Ctx) (s : Sub D G) (vv : El D (subT D G FYX s)) (vF : El D (Fun D (subT D G Y s) (subT D G X s)))
      (h : IN.TE D (subT D G FYX s) (Fun D (subT D G Y s) (subT D G X s)) vv vF)
      : Id (Ty D) (subT D (ext G FYX) Hs (extS D G FYX s vv)) (EQ.Htpy D (subT D G X s) (subT D G Y s) (QC.fAl D G s X Y u) vF) =
      EQ.Htpy-ov D (ext G FYX) (wkT G FYX X) (wkT G FYX Y) (EQ.wkF G FYX X Y u) (EQ.qF G Y X) (extS D G FYX s vv)
        (subT D G X s) (IN.wkT-extS D G FYX X s vv) (subT D G Y s) (IN.wkT-extS D G FYX Y s vv)
        (QC.PFs D G FYX X Y s vv) (QC.fAl D G s X Y u) (QC.wkFAt D G FYX X Y u s vv)
        (QC.PFs D G FYX Y X s vv) vF
        (IN.teAny D (subT D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (extS D G FYX s vv)) (Fun D (subT D G Y s) (subT D G X s))
           (subt D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (EQ.qF G Y X) (extS D G FYX s vv)) vF
           (IN.teT D (subT D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (extS D G FYX s vv)) (subT D G FYX s) (Fun D (subT D G Y s) (subT D G X s))
              (subt D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (EQ.qF G Y X) (extS D G FYX s vv)) vv vF
              (IN.teT D (subT D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (extS D G FYX s vv)) (subT D (ext G FYX) (wkT G FYX FYX) (extS D G FYX s vv)) (subT D G FYX s)
                 (subt D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (EQ.qF G Y X) (extS D G FYX s vv)) (subt D (ext G FYX) (wkT G FYX FYX) (q G FYX) (extS D G FYX s vv)) vv
                 (IN.teS D (subT D (ext G FYX) (wkT G FYX FYX) (extS D G FYX s vv)) (subT D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (extS D G FYX s vv))
                    (subt D (ext G FYX) (wkT G FYX FYX) (q G FYX) (extS D G FYX s vv)) (subt D (ext G FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (EQ.qF G Y X) (extS D G FYX s vv))
                    (IN.teSubtTr D (ext G FYX) (wkT G FYX FYX) (Fun (ext G FYX) (wkT G FYX Y) (wkT G FYX X)) (EQ.wkFP G FYX Y X) (q G FYX) (extS D G FYX s vv)))
                 (IN.teOv D (ext G FYX) (wkT G FYX FYX) (extS D G FYX s vv) (subT D G FYX s) (IN.wkT-extS D G FYX FYX s vv) (q G FYX) vv
                    (JP.q-extS D G FYX s vv (IN.wkT-extS D G FYX FYX s vv))))
              h)
           (QC.PFs D G FYX Y X s vv)) ;

    -- u along the lift of s is u along s, weakened
    eUL (D : Ctx) (s : Sub D G)
      : IN.TE (ext D (subT D G Y s)) (Fun (ext D (subT D G Y s)) (subT (ext D (subT D G Y s)) K XK (lift D G Y s)) (subT (ext D (subT D G Y s)) K YK (lift D G Y s)))
              (Fun (ext D (subT D G Y s)) (wkT D (subT D G Y s) (subT D G X s)) (wkT D (subT D G Y s) (subT D G Y s)))
              (QC.fAl (ext D (subT D G Y s)) K (lift D G Y s) XK YK uK) (EQ.wkF D (subT D G Y s) (subT D G X s) (subT D G Y s) (QC.fAl D G s X Y u)) =
      IN.teT DY (Fun DY XL YL) (subT DY K (Fun K XK YK) (lift D G Y s)) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
        (QC.fAl DY K (lift D G Y s) XK YK uK) (subt DY K (Fun K XK YK) uK (lift D G Y s)) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
        (IN.teS DY (subT DY K (Fun K XK YK) (lift D G Y s)) (Fun DY XL YL) (subt DY K (Fun K XK YK) uK (lift D G Y s)) (QC.fAl DY K (lift D G Y s) XK YK uK)
           (IN.teTr DY (subT DY K (Fun K XK YK) (lift D G Y s)) (Fun DY XL YL) (Fun-ov DY K XK YK (lift D G Y s) XL (refl XL) YL (refl YL)) (subt DY K (Fun K XK YK) uK (lift D G Y s))))
        (IN.teT DY (subT DY K (Fun K XK YK) (lift D G Y s)) (subT DY K (wkT G Y (Fun G X Y)) (lift D G Y s)) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
           (subt DY K (Fun K XK YK) uK (lift D G Y s)) (subt DY K (wkT G Y (Fun G X Y)) (wkE G Y (Fun G X Y) u) (lift D G Y s)) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
           (IN.teS DY (subT DY K (wkT G Y (Fun G X Y)) (lift D G Y s)) (subT DY K (Fun K XK YK) (lift D G Y s))
              (subt DY K (wkT G Y (Fun G X Y)) (wkE G Y (Fun G X Y) u) (lift D G Y s)) (subt DY K (Fun K XK YK) uK (lift D G Y s))
              (IN.teSubtTr DY K (wkT G Y (Fun G X Y)) (Fun K XK YK) (EQ.wkFP G Y X Y) (wkE G Y (Fun G X Y) u) (lift D G Y s)))
           (IN.teT DY (subT DY K (wkT G Y (Fun G X Y)) (lift D G Y s)) (subT DY G (Fun G X Y) (o DY K G (p G Y) (lift D G Y s))) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
              (subt DY K (wkT G Y (Fun G X Y)) (wkE G Y (Fun G X Y) u) (lift D G Y s)) (subt DY G (Fun G X Y) u (o DY K G (p G Y) (lift D G Y s))) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
              (IN.teS DY (subT DY G (Fun G X Y) (o DY K G (p G Y) (lift D G Y s))) (subT DY K (wkT G Y (Fun G X Y)) (lift D G Y s))
                 (subt DY G (Fun G X Y) u (o DY K G (p G Y) (lift D G Y s))) (subt DY K (wkT G Y (Fun G X Y)) (wkE G Y (Fun G X Y) u) (lift D G Y s))
                 (IN.teSubtO DY K G (Fun G X Y) u (p G Y) (lift D G Y s)))
              (IN.teT DY (subT DY G (Fun G X Y) (o DY K G (p G Y) (lift D G Y s))) (subT DY G (Fun G X Y) (o DY D G s (p D Ys))) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
                 (subt DY G (Fun G X Y) u (o DY K G (p G Y) (lift D G Y s))) (subt DY G (Fun G X Y) u (o DY D G s (p D Ys))) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
                 (IN.teSubEq DY G (Fun G X Y) u (o DY K G (p G Y) (lift D G Y s)) (o DY D G s (p D Ys)) (p-lift D G Y s))
                 (IN.teT DY (subT DY G (Fun G X Y) (o DY D G s (p D Ys))) (subT DY D (subT D G (Fun G X Y) s) (p D Ys)) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
                    (subt DY G (Fun G X Y) u (o DY D G s (p D Ys))) (subt DY D (subT D G (Fun G X Y) s) (subt D G (Fun G X Y) u s) (p D Ys)) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
                    (IN.teSubtO DY D G (Fun G X Y) u s (p D Ys))
                    (IN.teT DY (subT DY D (subT D G (Fun G X Y) s) (p D Ys)) (wkT D Ys (Fun D Xs Ys)) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
                       (subt DY D (subT D G (Fun G X Y) s) (subt D G (Fun G X Y) u s) (p D Ys)) (wkE D Ys (Fun D Xs Ys) (QC.fAl D G s X Y u)) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
                       (SV.teSub DY D (subT D G (Fun G X Y) s) (Fun D Xs Ys) (subt D G (Fun G X Y) u s) (QC.fAl D G s X Y u)
                          (IN.teTr D (subT D G (Fun G X Y) s) (Fun D Xs Ys) (Fun-ov D G X Y s Xs (refl Xs) Ys (refl Ys)) (subt D G (Fun G X Y) u s)) (p D Ys))
                       (IN.teTr DY (wkT D Ys (Fun D Xs Ys)) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys)) (EQ.wkFP D Ys Xs Ys) (wkE D Ys (Fun D Xs Ys) (QC.fAl D G s X Y u))))))))
     where {
      Ys : Ty D = subT D G Y s ;
      Xs : Ty D = subT D G X s ;
      DY : Ctx = ext D Ys ;
      XL : Ty DY = subT DY K XK (lift D G Y s) ;
      YL : Ty DY = subT DY K YK (lift D G Y s) ;
     } ;

    FmAt (D : Ctx) (s : Sub D G) (x' : El (ext D (subT D G Y s)) (subT (ext D (subT D G Y s)) K XK (lift D G Y s)))
      : Id (Ty (ext D (subT D G Y s))) (subT (ext D (subT D G Y s)) (ext K XK) FmK (extS (ext D (subT D G Y s)) K XK (lift D G Y s) x'))
           (IJ.IdT (ext D (subT D G Y s)) (wkT D (subT D G Y s) (subT D G Y s))
              (app (ext D (subT D G Y s)) (wkT D (subT D G Y s) (subT D G X s)) (wkT D (subT D G Y s) (subT D G Y s))
                   (EQ.wkF D (subT D G Y s) (subT D G X s) (subT D G Y s) (QC.fAl D G s X Y u))
                   (trE (ext D (subT D G Y s)) (subT (ext D (subT D G Y s)) K XK (lift D G Y s)) (wkT D (subT D G Y s) (subT D G X s)) (p-lift-T D G Y X s) x'))
              (q D (subT D G Y s))) =
      trans (Ty DY) (subT DY (ext K XK) FmK (extS DY K XK (lift D G Y s) x'))
        (IJ.IdT DY YL (app DY XL YL (QC.fAl DY K (lift D G Y s) XK YK uK) x') (subt DY K YK (q G Y) (lift D G Y s)))
        (IJ.IdT DY (wkT D Ys Ys) (app DY (wkT D Ys Xs) (wkT D Ys Ys) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u)) xr) (q D Ys))
        (QC.FamAt DY K XK YK uK (q G Y) (lift D G Y s) x')
        (DJ.idCong DY YL (wkT D Ys Ys) (p-lift-T D G Y Y s)
           (app DY XL YL (QC.fAl DY K (lift D G Y s) XK YK uK) x') (subt DY K YK (q G Y) (lift D G Y s))
           (app DY (wkT D Ys Xs) (wkT D Ys Ys) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u)) xr) (q D Ys)
           (trans (El DY (wkT D Ys Ys)) (trE DY YL (wkT D Ys Ys) (p-lift-T D G Y Y s) (app DY XL YL (QC.fAl DY K (lift D G Y s) XK YK uK) x'))
              (app DY (wkT D Ys Xs) (wkT D Ys Ys) (trE DY (Fun DY XL YL) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys)) PFF (QC.fAl DY K (lift D G Y s) XK YK uK)) xr)
              (app DY (wkT D Ys Xs) (wkT D Ys Ys) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u)) xr)
              (sym (El DY (wkT D Ys Ys)) (app DY (wkT D Ys Xs) (wkT D Ys Ys) (trE DY (Fun DY XL YL) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys)) PFF (QC.fAl DY K (lift D G Y s) XK YK uK)) xr)
                 (trE DY YL (wkT D Ys Ys) (p-lift-T D G Y Y s) (app DY XL YL (QC.fAl DY K (lift D G Y s) XK YK uK) x'))
                 (IN.app-tr2 DY XL (wkT D Ys Xs) YL (wkT D Ys Ys) (p-lift-T D G Y X s) (p-lift-T D G Y Y s) PFF (QC.fAl DY K (lift D G Y s) XK YK uK) x'))
              (ap (El DY (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))) (El DY (wkT D Ys Ys)) (\ F -> app DY (wkT D Ys Xs) (wkT D Ys Ys) F xr)
                  (trE DY (Fun DY XL YL) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys)) PFF (QC.fAl DY K (lift D G Y s) XK YK uK))
                  (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u))
                  (IN.teAny DY (Fun DY XL YL) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys)) (QC.fAl DY K (lift D G Y s) XK YK uK) (EQ.wkF D Ys Xs Ys (QC.fAl D G s X Y u)) (eUL D s) PFF)))
           (q-lift D G Y s))
     where {
      Ys : Ty D = subT D G Y s ;
      Xs : Ty D = subT D G X s ;
      DY : Ctx = ext D Ys ;
      XL : Ty DY = subT DY K XK (lift D G Y s) ;
      YL : Ty DY = subT DY K YK (lift D G Y s) ;
      xr : El DY (wkT D Ys Xs) = trE DY XL (wkT D Ys Xs) (p-lift-T D G Y X s) x' ;
      PFF : Id (Ty DY) (Fun DY XL YL) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys)) =
        trans (Ty DY) (Fun DY XL YL) (Fun DY (wkT D Ys Xs) YL) (Fun DY (wkT D Ys Xs) (wkT D Ys Ys))
          (ap (Ty DY) (Ty DY) (\ Z -> Fun DY Z YL) XL (wkT D Ys Xs) (p-lift-T D G Y X s))
          (ap (Ty DY) (Ty DY) (\ Z -> Fun DY (wkT D Ys Xs) Z) YL (wkT D Ys Ys) (p-lift-T D G Y Y s)) ;
     } ;

    ------------------------------------------------------------------
    -- (3) rm, at SQ = G.Q: pv along rho = (p , lam (fst (bod q)) , lam (snd (bod q)))

    SQ : Ctx = ext G Q ;
    Y1 : Ty SQ = wkT G Q Y ;
    X1 : Ty SQ = wkT G Q X ;
    LQ : Sub (ext SQ Y1) K = lift SQ G Y (p G Q) ;
    FVQ : Ty (ext SQ Y1) = subT (ext SQ Y1) K FV LQ ;
    PNQ : Id (Ty SQ) (wkT G Q Q) (PS.Pi SQ Y1 FVQ) = PS.Pi-nat SQ G Y FV (p G Q) ;
    qQ' : El SQ (PS.Pi SQ Y1 FVQ) = trE SQ (wkT G Q Q) (PS.Pi SQ Y1 FVQ) PNQ (q G Q) ;
    XQ : Ty (ext SQ Y1) = subT (ext SQ Y1) K XK LQ ;
    FmQ : Ty (ext (ext SQ Y1) XQ) = subT (ext (ext SQ Y1) XQ) (ext K XK) FmK (lift (ext SQ Y1) K XK LQ) ;
    SNQ : Id (Ty (ext SQ Y1)) FVQ (SS.Sig (ext SQ Y1) XQ FmQ) = SS.Sig-nat (ext SQ Y1) K XK FmK LQ ;
    phS : El (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) = trE (ext SQ Y1) FVQ (SS.Sig (ext SQ Y1) XQ FmQ) SNQ (bod SQ Y1 FVQ qQ') ;
    fx : El (ext SQ Y1) XQ = IN.fst (ext SQ Y1) XQ FmQ phS ;
    sx : El (ext SQ Y1) (subT (ext SQ Y1) (ext (ext SQ Y1) XQ) FmQ (sec (ext SQ Y1) XQ fx)) = IN.snd (ext SQ Y1) XQ FmQ phS ;

    PXQ : Id (Ty (ext SQ Y1)) XQ (wkT SQ Y1 X1) = p-lift-T SQ G Y X (p G Q) ;
    fx1 : El (ext SQ Y1) (wkT SQ Y1 X1) = trE (ext SQ Y1) XQ (wkT SQ Y1 X1) PXQ fx ;
    vF : El SQ (Fun SQ Y1 X1) = lam SQ Y1 (wkT SQ Y1 X1) fx1 ;
    PFQ : Id (Ty SQ) (wkT G Q FYX) (Fun SQ Y1 X1) = Fun-ov SQ G Y X (p G Q) Y1 (refl Y1) X1 (refl X1) ;
    vU : El SQ (wkT G Q FYX) = trE SQ (Fun SQ Y1 X1) (wkT G Q FYX) (sym (Ty SQ) (wkT G Q FYX) (Fun SQ Y1 X1) PFQ) vF ;
    hvQ : IN.TE SQ (wkT G Q FYX) (Fun SQ Y1 X1) vU vF =
      IN.teS SQ (Fun SQ Y1 X1) (wkT G Q FYX) vF vU (IN.teTr SQ (Fun SQ Y1 X1) (wkT G Q FYX) (sym (Ty SQ) (wkT G Q FYX) (Fun SQ Y1 X1) PFQ) vF) ;

    uQ : El SQ (Fun SQ X1 Y1) = QC.fAl SQ G (p G Q) X Y u ;
    sQ : Sub SQ (ext G FYX) = extS SQ G FYX (p G Q) vU ;
    PHsQ : Id (Ty SQ) (subT SQ (ext G FYX) Hs sQ) (EQ.Htpy SQ X1 Y1 uQ vF) = PHsAt SQ (p G Q) vU vF hvQ ;

    IdQ : Ty (ext SQ Y1) =
      IJ.IdT (ext SQ Y1) (wkT SQ Y1 Y1)
        (app (ext SQ Y1) (wkT SQ Y1 X1) (wkT SQ Y1 Y1) (EQ.wkF SQ Y1 X1 Y1 uQ) (app (ext SQ Y1) (wkT SQ Y1 Y1) (wkT SQ Y1 X1) (EQ.wkF SQ Y1 Y1 X1 vF) (q SQ Y1)))
        (q SQ Y1) ;

    Phb : Id (Ty (ext SQ Y1)) (subT (ext SQ Y1) (ext (ext SQ Y1) XQ) FmQ (sec (ext SQ Y1) XQ fx)) IdQ =
      trans (Ty (ext SQ Y1)) (subT (ext SQ Y1) (ext (ext SQ Y1) XQ) FmQ (sec (ext SQ Y1) XQ fx)) (subT (ext SQ Y1) (ext K XK) FmK (extS (ext SQ Y1) K XK LQ fx)) IdQ
        (sym (Ty (ext SQ Y1)) (subT (ext SQ Y1) (ext K XK) FmK (extS (ext SQ Y1) K XK LQ fx)) (subT (ext SQ Y1) (ext (ext SQ Y1) XQ) FmQ (sec (ext SQ Y1) XQ fx))
           (subT-o (ext SQ Y1) (ext (ext SQ Y1) XQ) (ext K XK) FmK (lift (ext SQ Y1) K XK LQ) (sec (ext SQ Y1) XQ fx)))
        (trans (Ty (ext SQ Y1)) (subT (ext SQ Y1) (ext K XK) FmK (extS (ext SQ Y1) K XK LQ fx))
           (IJ.IdT (ext SQ Y1) (wkT SQ Y1 Y1) (app (ext SQ Y1) (wkT SQ Y1 X1) (wkT SQ Y1 Y1) (EQ.wkF SQ Y1 X1 Y1 uQ) fx1) (q SQ Y1)) IdQ
           (FmAt SQ (p G Q) fx)
           (ap (El (ext SQ Y1) (wkT SQ Y1 X1)) (Ty (ext SQ Y1)) (\ v -> IJ.IdT (ext SQ Y1) (wkT SQ Y1 Y1) (app (ext SQ Y1) (wkT SQ Y1 X1) (wkT SQ Y1 Y1) (EQ.wkF SQ Y1 X1 Y1 uQ) v) (q SQ Y1))
               fx1 (app (ext SQ Y1) (wkT SQ Y1 Y1) (wkT SQ Y1 X1) (EQ.wkF SQ Y1 Y1 X1 vF) (q SQ Y1))
               (sym (El (ext SQ Y1) (wkT SQ Y1 X1)) (app (ext SQ Y1) (wkT SQ Y1 Y1) (wkT SQ Y1 X1) (EQ.wkF SQ Y1 Y1 X1 vF) (q SQ Y1)) fx1 (IN.appWkLamQ SQ Y1 X1 fx1)))) ;

    hb : El (ext SQ Y1) IdQ = trE (ext SQ Y1) (subT (ext SQ Y1) (ext (ext SQ Y1) XQ) FmQ (sec (ext SQ Y1) XQ fx)) IdQ Phb sx ;
    hU : El SQ (subT SQ (ext G FYX) Hs sQ) =
      trE SQ (EQ.Htpy SQ X1 Y1 uQ vF) (subT SQ (ext G FYX) Hs sQ) (sym (Ty SQ) (subT SQ (ext G FYX) Hs sQ) (EQ.Htpy SQ X1 Y1 uQ vF) PHsQ) (lam SQ Y1 IdQ hb) ;

    rho : Sub SQ VS.E2 = extS SQ (ext G FYX) Hs sQ hU ;
    erho : Id (Sub SQ G) (o SQ VS.E2 G VS.pp rho) (p G Q) =
      calc (Sub SQ G) {
          o SQ VS.E2 G (o VS.E2 (ext G FYX) G (p G FYX) VS.p2) rho
        =< o-assoc SQ VS.E2 (ext G FYX) G (p G FYX) VS.p2 rho >
          o SQ (ext G FYX) G (p G FYX) (o SQ VS.E2 (ext G FYX) VS.p2 rho)
        =< ap (Sub SQ (ext G FYX)) (Sub SQ G) (\ t -> o SQ (ext G FYX) G (p G FYX) t) (o SQ VS.E2 (ext G FYX) VS.p2 rho) sQ (IN.p-extS SQ (ext G FYX) Hs sQ hU) >
          o SQ (ext G FYX) G (p G FYX) sQ
        =< IN.p-extS SQ G FYX (p G Q) vU >
          p G Q } ;
    rm : El SQ (wkT G Q S) = RS.alongT SQ VS.E2 G S VS.pp VS.pv rho (p G Q) erho ;

    ------------------------------------------------------------------
    -- (4) sm, at ST = G.S: \ y. (a1 y , b1 y)

    ST : Ctx = ext G S ;
    Y2 : Ty ST = wkT G S Y ;
    X2 : Ty ST = wkT G S X ;
    PF2 : Id (Ty ST) VS.Ap1 (Fun ST Y2 X2) = Fun-ov ST G Y X (p G S) Y2 (refl Y2) X2 (refl X2) ;
    aF : El ST (Fun ST Y2 X2) = trE ST VS.Ap1 (Fun ST Y2 X2) PF2 VS.a1 ;
    uS : El ST (Fun ST X2 Y2) = QC.fAl ST G (p G S) X Y u ;
    PHsS : Id (Ty ST) (subT ST (ext G FYX) Hs (extS ST G FYX (p G S) VS.a1)) (EQ.Htpy ST X2 Y2 uS aF) =
      PHsAt ST (p G S) VS.a1 aF (IN.teTr ST VS.Ap1 (Fun ST Y2 X2) PF2 VS.a1) ;
    IdS : Ty (ext ST Y2) =
      IJ.IdT (ext ST Y2) (wkT ST Y2 Y2)
        (app (ext ST Y2) (wkT ST Y2 X2) (wkT ST Y2 Y2) (EQ.wkF ST Y2 X2 Y2 uS) (app (ext ST Y2) (wkT ST Y2 Y2) (wkT ST Y2 X2) (EQ.wkF ST Y2 Y2 X2 aF) (q ST Y2)))
        (q ST Y2) ;
    b1H : El ST (PS.Pi ST Y2 IdS) = trE ST (subT ST (ext G FYX) Hs (extS ST G FYX (p G S) VS.a1)) (EQ.Htpy ST X2 Y2 uS aF) PHsS VS.b1 ;
    hS : El (ext ST Y2) IdS = bod ST Y2 IdS b1H ;
    xS : El (ext ST Y2) (wkT ST Y2 X2) = app (ext ST Y2) (wkT ST Y2 Y2) (wkT ST Y2 X2) (EQ.wkF ST Y2 Y2 X2 aF) (q ST Y2) ;
    LS : Sub (ext ST Y2) K = lift ST G Y (p G S) ;
    XS' : Ty (ext ST Y2) = subT (ext ST Y2) K XK LS ;
    PXS : Id (Ty (ext ST Y2)) XS' (wkT ST Y2 X2) = p-lift-T ST G Y X (p G S) ;
    xS' : El (ext ST Y2) XS' = trE (ext ST Y2) (wkT ST Y2 X2) XS' (sym (Ty (ext ST Y2)) XS' (wkT ST Y2 X2) PXS) xS ;
    FmS' : Ty (ext (ext ST Y2) XS') = subT (ext (ext ST Y2) XS') (ext K XK) FmK (lift (ext ST Y2) K XK LS) ;

    PhS : Id (Ty (ext ST Y2)) IdS (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' xS')) =
      trans (Ty (ext ST Y2)) IdS
        (IJ.IdT (ext ST Y2) (wkT ST Y2 Y2) (app (ext ST Y2) (wkT ST Y2 X2) (wkT ST Y2 Y2) (EQ.wkF ST Y2 X2 Y2 uS) (trE (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS')) (q ST Y2))
        (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' xS'))
        (ap (El (ext ST Y2) (wkT ST Y2 X2)) (Ty (ext ST Y2)) (\ v -> IJ.IdT (ext ST Y2) (wkT ST Y2 Y2) (app (ext ST Y2) (wkT ST Y2 X2) (wkT ST Y2 Y2) (EQ.wkF ST Y2 X2 Y2 uS) v) (q ST Y2))
            xS (trE (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS')
            (sym (El (ext ST Y2) (wkT ST Y2 X2)) (trE (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS') xS (JP.trE-sym (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS)))
        (trans (Ty (ext ST Y2))
           (IJ.IdT (ext ST Y2) (wkT ST Y2 Y2) (app (ext ST Y2) (wkT ST Y2 X2) (wkT ST Y2 Y2) (EQ.wkF ST Y2 X2 Y2 uS) (trE (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS')) (q ST Y2))
           (subT (ext ST Y2) (ext K XK) FmK (extS (ext ST Y2) K XK LS xS'))
           (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' xS'))
           (sym (Ty (ext ST Y2)) (subT (ext ST Y2) (ext K XK) FmK (extS (ext ST Y2) K XK LS xS'))
              (IJ.IdT (ext ST Y2) (wkT ST Y2 Y2) (app (ext ST Y2) (wkT ST Y2 X2) (wkT ST Y2 Y2) (EQ.wkF ST Y2 X2 Y2 uS) (trE (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS')) (q ST Y2))
              (FmAt ST (p G S) xS'))
           (subT-o (ext ST Y2) (ext (ext ST Y2) XS') (ext K XK) FmK (lift (ext ST Y2) K XK LS) (sec (ext ST Y2) XS' xS'))) ;

    hS' : El (ext ST Y2) (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' xS')) =
      trE (ext ST Y2) IdS (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' xS')) PhS hS ;

    FVS : Ty (ext ST Y2) = subT (ext ST Y2) K FV LS ;
    SNS : Id (Ty (ext ST Y2)) FVS (SS.Sig (ext ST Y2) XS' FmS') = SS.Sig-nat (ext ST Y2) K XK FmK LS ;
    body : El (ext ST Y2) FVS = trE (ext ST Y2) (SS.Sig (ext ST Y2) XS' FmS') FVS (sym (Ty (ext ST Y2)) FVS (SS.Sig (ext ST Y2) XS' FmS') SNS) (IN.pr (ext ST Y2) XS' FmS' xS' hS') ;
    PNS : Id (Ty ST) (wkT G S Q) (PS.Pi ST Y2 FVS) = PS.Pi-nat ST G Y FV (p G S) ;
    sm : El ST (wkT G S Q) = trE ST (PS.Pi ST Y2 FVS) (wkT G S Q) (sym (Ty ST) (wkT G S Q) (PS.Pi ST Y2 FVS) PNS) (lam ST Y2 FVS body) ;

    ------------------------------------------------------------------
    -- (5) rho after (p , sm) is unpk

    sg : Sub ST SQ = extS ST G Q (p G S) sm ;
    epg : Id (Sub ST G) (o ST SQ G (p G Q) sg) (p G S) = IN.p-extS ST G Q (p G S) sm ;
    PY2 : Id (Ty ST) (subT ST SQ Y1 sg) Y2 =
      trans (Ty ST) (subT ST SQ Y1 sg) (subT ST G Y (o ST SQ G (p G Q) sg)) Y2
        (sym (Ty ST) (subT ST G Y (o ST SQ G (p G Q) sg)) (subT ST SQ Y1 sg) (subT-o ST SQ G Y (p G Q) sg))
        (ap (Sub ST G) (Ty ST) (\ t -> subT ST G Y t) (o ST SQ G (p G Q) sg) (p G S) epg) ;
    PX2 : Id (Ty ST) (subT ST SQ X1 sg) X2 =
      trans (Ty ST) (subT ST SQ X1 sg) (subT ST G X (o ST SQ G (p G Q) sg)) X2
        (sym (Ty ST) (subT ST G X (o ST SQ G (p G Q) sg)) (subT ST SQ X1 sg) (subT-o ST SQ G X (p G Q) sg))
        (ap (Sub ST G) (Ty ST) (\ t -> subT ST G X t) (o ST SQ G (p G Q) sg) (p G S) epg) ;
    su : Sub (ext ST Y2) (ext SQ Y1) = upT ST SQ Y1 sg Y2 PY2 ;
    LQs : Id (Sub (ext ST Y2) K) (o (ext ST Y2) (ext SQ Y1) K LQ su) LS = SV.liftComp ST SQ G Y (p G Q) sg (p G S) epg PY2 ;

    PFVS : Id (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) FVQ su) FVS =
      trans (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) FVQ su) (subT (ext ST Y2) K FV (o (ext ST Y2) (ext SQ Y1) K LQ su)) FVS
        (sym (Ty (ext ST Y2)) (subT (ext ST Y2) K FV (o (ext ST Y2) (ext SQ Y1) K LQ su)) (subT (ext ST Y2) (ext SQ Y1) FVQ su) (subT-o (ext ST Y2) (ext SQ Y1) K FV LQ su))
        (ap (Sub (ext ST Y2) K) (Ty (ext ST Y2)) (\ t -> subT (ext ST Y2) K FV t) (o (ext ST Y2) (ext SQ Y1) K LQ su) LS LQs) ;
    PPi : Id (Ty ST) (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) = Pi-ov ST SQ Y1 FVQ sg Y2 PY2 FVS PFVS ;

    eQs : Id (El ST (PS.Pi ST Y2 FVS)) (trE ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) PPi (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg)) (lam ST Y2 FVS body) =
      IN.teAny ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg) (lam ST Y2 FVS body)
        (IN.teT ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (subT ST SQ (wkT G Q Q) sg) (PS.Pi ST Y2 FVS) (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg) (subt ST SQ (wkT G Q Q) (q G Q) sg) (lam ST Y2 FVS body)
           (IN.teS ST (subT ST SQ (wkT G Q Q) sg) (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (subt ST SQ (wkT G Q Q) (q G Q) sg) (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg)
              (IN.teSubtTr ST SQ (wkT G Q Q) (PS.Pi SQ Y1 FVQ) PNQ (q G Q) sg))
           (IN.teT ST (subT ST SQ (wkT G Q Q) sg) (wkT G S Q) (PS.Pi ST Y2 FVS) (subt ST SQ (wkT G Q Q) (q G Q) sg) sm (lam ST Y2 FVS body)
              (IN.teOv ST SQ (wkT G Q Q) sg (wkT G S Q) (IN.wkT-extS ST G Q Q (p G S) sm) (q G Q) sm (JP.q-extS ST G Q (p G S) sm (IN.wkT-extS ST G Q Q (p G S) sm)))
              (IN.teS ST (PS.Pi ST Y2 FVS) (wkT G S Q) (lam ST Y2 FVS body) sm
                 (IN.teTr ST (PS.Pi ST Y2 FVS) (wkT G S Q) (sym (Ty ST) (wkT G S Q) (PS.Pi ST Y2 FVS) PNS) (lam ST Y2 FVS body)))))
        PPi ;

    PAx : Id (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) XQ su) XS' =
      trans (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) XQ su) (subT (ext ST Y2) K XK (o (ext ST Y2) (ext SQ Y1) K LQ su)) XS'
        (sym (Ty (ext ST Y2)) (subT (ext ST Y2) K XK (o (ext ST Y2) (ext SQ Y1) K LQ su)) (subT (ext ST Y2) (ext SQ Y1) XQ su) (subT-o (ext ST Y2) (ext SQ Y1) K XK LQ su))
        (ap (Sub (ext ST Y2) K) (Ty (ext ST Y2)) (\ t -> subT (ext ST Y2) K XK t) (o (ext ST Y2) (ext SQ Y1) K LQ su) LS LQs) ;
    sux : Sub (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) = upT (ext ST Y2) (ext SQ Y1) XQ su XS' PAx ;
    PBf : Id (Ty (ext (ext ST Y2) XS')) (subT (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) FmQ sux) FmS' =
      trans (Ty (ext (ext ST Y2) XS')) (subT (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) FmQ sux)
        (subT (ext (ext ST Y2) XS') (ext K XK) FmK (o (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) (ext K XK) (lift (ext SQ Y1) K XK LQ) sux)) FmS'
        (sym (Ty (ext (ext ST Y2) XS')) (subT (ext (ext ST Y2) XS') (ext K XK) FmK (o (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) (ext K XK) (lift (ext SQ Y1) K XK LQ) sux))
           (subT (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) FmQ sux) (subT-o (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) (ext K XK) FmK (lift (ext SQ Y1) K XK LQ) sux))
        (ap (Sub (ext (ext ST Y2) XS') (ext K XK)) (Ty (ext (ext ST Y2) XS')) (\ t -> subT (ext (ext ST Y2) XS') (ext K XK) FmK t)
            (o (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) (ext K XK) (lift (ext SQ Y1) K XK LQ) sux) (lift (ext ST Y2) K XK LS)
            (SV.liftComp (ext ST Y2) (ext SQ Y1) K XK LQ su LS LQs PAx)) ;
    PWs : Id (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) su) (SS.Sig (ext ST Y2) XS' FmS') =
      Sig-ov (ext ST Y2) (ext SQ Y1) XQ FmQ su XS' PAx FmS' PBf ;

    prX : El (ext ST Y2) (SS.Sig (ext ST Y2) XS' FmS') = IN.pr (ext ST Y2) XS' FmS' xS' hS' ;

    PwS : Ov (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) su (SS.Sig (ext ST Y2) XS' FmS') PWs phS prX =
      IN.teAny (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) su) (SS.Sig (ext ST Y2) XS' FmS') (subt (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) phS su) prX
        (IN.teT (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) su) (subT (ext ST Y2) (ext SQ Y1) FVQ su) (SS.Sig (ext ST Y2) XS' FmS')
           (subt (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) phS su) (subt (ext ST Y2) (ext SQ Y1) FVQ (bod SQ Y1 FVQ qQ') su) prX
           (IN.teS (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) FVQ su) (subT (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) su)
              (subt (ext ST Y2) (ext SQ Y1) FVQ (bod SQ Y1 FVQ qQ') su) (subt (ext ST Y2) (ext SQ Y1) (SS.Sig (ext SQ Y1) XQ FmQ) phS su)
              (IN.teSubtTr (ext ST Y2) (ext SQ Y1) FVQ (SS.Sig (ext SQ Y1) XQ FmQ) SNQ (bod SQ Y1 FVQ qQ') su))
           (IN.teT (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) FVQ su) FVS (SS.Sig (ext ST Y2) XS' FmS')
              (subt (ext ST Y2) (ext SQ Y1) FVQ (bod SQ Y1 FVQ qQ') su) body prX
              (IN.teT (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) FVQ su) FVS FVS
                 (subt (ext ST Y2) (ext SQ Y1) FVQ (bod SQ Y1 FVQ qQ') su) (bod ST Y2 FVS (trE ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) PPi (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg))) body
                 (IN.teOv (ext ST Y2) (ext SQ Y1) FVQ su FVS PFVS (bod SQ Y1 FVQ qQ') (bod ST Y2 FVS (trE ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) PPi (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg)))
                    (bodNatUp ST SQ Y1 FVQ sg Y2 PY2 FVS PFVS PPi qQ'))
                 (refl FVS,
                  trans (El (ext ST Y2) FVS) (bod ST Y2 FVS (trE ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) PPi (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg))) (bod ST Y2 FVS (lam ST Y2 FVS body)) body
                    (ap (El ST (PS.Pi ST Y2 FVS)) (El (ext ST Y2) FVS) (\ F -> bod ST Y2 FVS F)
                        (trE ST (subT ST SQ (PS.Pi SQ Y1 FVQ) sg) (PS.Pi ST Y2 FVS) PPi (subt ST SQ (PS.Pi SQ Y1 FVQ) qQ' sg)) (lam ST Y2 FVS body) eQs)
                    ((PS.Pi-iso ST Y2 FVS).fun-inv body)))
              (IN.teS (ext ST Y2) (SS.Sig (ext ST Y2) XS' FmS') FVS prX body
