              (IN.teOv (ext ST Y2) (ext SQ Y1) XQ su XS' PAx fx (IN.fst (ext ST Y2) XS' FmS' prX) FAx)
              (refl XS', IN.fst-pr (ext ST Y2) XS' FmS' xS' hS'))
           (PXS, JP.trE-sym (ext ST Y2) XS' (wkT ST Y2 X2) PXS xS)) ;

    LV : Ov ST SQ (Fun SQ Y1 X1) sg (Fun ST Y2 X2) PFun2 vF (lam ST Y2 (wkT ST Y2 X2) xS) =
