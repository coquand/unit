                    (sec (ext ST Y2) XS' (trE (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) XQ su) XS' PAx (subt (ext ST Y2) (ext SQ Y1) XQ fx su))))
              (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' (trE (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) XQ su) XS' PAx (subt (ext ST Y2) (ext SQ Y1) XQ fx su))))
              (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' (IN.fst (ext ST Y2) XS' FmS' prX)))
              (ap (Ty (ext (ext ST Y2) XS')) (Ty (ext ST Y2))
                  (\ Z -> subT (ext ST Y2) (ext (ext ST Y2) XS') Z (sec (ext ST Y2) XS' (trE (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) XQ su) XS' PAx (subt (ext ST Y2) (ext SQ Y1) XQ fx su))))
                  (subT (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) FmQ sux) FmS' PBf)
