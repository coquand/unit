        (IN.teAny (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) IdQ su) IdS (subt (ext ST Y2) (ext SQ Y1) IdQ hb su) hS hh PIdS) ;

    eA1 : Sub ST (ext G FYX) = extS ST G FYX (p G S) VS.a1 ;

    E2 : IN.TE ST (subT ST SQ (subT SQ (ext G FYX) Hs sQ) sg) (subT ST (ext G FYX) Hs eA1) (subt ST SQ (subT SQ (ext G FYX) Hs sQ) hU sg) VS.b1 =
      IN.teT ST (subT ST SQ (subT SQ (ext G FYX) Hs sQ) sg) (subT ST SQ (PS.Pi SQ Y1 IdQ) sg) (subT ST (ext G FYX) Hs eA1)
        (subt ST SQ (subT SQ (ext G FYX) Hs sQ) hU sg) (subt ST SQ (PS.Pi SQ Y1 IdQ) (lam SQ Y1 IdQ hb) sg) VS.b1
        (IN.teS ST (subT ST SQ (PS.Pi SQ Y1 IdQ) sg) (subT ST SQ (subT SQ (ext G FYX) Hs sQ) sg) (subt ST SQ (PS.Pi SQ Y1 IdQ) (lam SQ Y1 IdQ hb) sg) (subt ST SQ (subT SQ (ext G FYX) Hs sQ) hU sg)
           (IN.teSubtTr ST SQ (PS.Pi SQ Y1 IdQ) (subT SQ (ext G FYX) Hs sQ) (sym (Ty SQ) (subT SQ (ext G FYX) Hs sQ) (EQ.Htpy SQ X1 Y1 uQ vF) PHsQ) (lam SQ Y1 IdQ hb) sg))
        (IN.teT ST (subT ST SQ (PS.Pi SQ Y1 IdQ) sg) (PS.Pi ST Y2 IdS) (subT ST (ext G FYX) Hs eA1)
           (subt ST SQ (PS.Pi SQ Y1 IdQ) (lam SQ Y1 IdQ hb) sg) b1H VS.b1
           (IN.teT ST (subT ST SQ (PS.Pi SQ Y1 IdQ) sg) (PS.Pi ST Y2 IdS) (PS.Pi ST Y2 IdS) (subt ST SQ (PS.Pi SQ Y1 IdQ) (lam SQ Y1 IdQ hb) sg) (lam ST Y2 IdS hS) b1H
              (IN.teOv ST SQ (PS.Pi SQ Y1 IdQ) sg (PS.Pi ST Y2 IdS) PPiId (lam SQ Y1 IdQ hb) (lam ST Y2 IdS hS) LH)
              (refl (PS.Pi ST Y2 IdS), (PS.Pi-iso ST Y2 IdS).inv-fun b1H))
           (IN.teS ST (subT ST (ext G FYX) Hs eA1) (PS.Pi ST Y2 IdS) VS.b1 b1H
              (IN.teTr ST (subT ST (ext G FYX) Hs eA1) (PS.Pi ST Y2 IdS) PHsS VS.b1))) ;

    EK : Id (Sub ST (ext G FYX)) (o ST SQ (ext G FYX) sQ sg) eA1 =
      IN.ext-eq ST G FYX (o ST SQ (ext G FYX) sQ sg) eA1
        (calc (Sub ST G) {
            o ST (ext G FYX) G (p G FYX) (o ST SQ (ext G FYX) sQ sg)
          =< sym (Sub ST G) (o ST SQ G (o SQ (ext G FYX) G (p G FYX) sQ) sg) (o ST (ext G FYX) G (p G FYX) (o ST SQ (ext G FYX) sQ sg)) (o-assoc ST SQ (ext G FYX) G (p G FYX) sQ sg) >
            o ST SQ G (o SQ (ext G FYX) G (p G FYX) sQ) sg
          =< ap (Sub SQ G) (Sub ST G) (\ t -> o ST SQ G t sg) (o SQ (ext G FYX) G (p G FYX) sQ) (p G Q) (IN.p-extS SQ G FYX (p G Q) vU) >
            o ST SQ G (p G Q) sg
          =< epg >
            p G S
          =< sym (Sub ST G) (o ST (ext G FYX) G (p G FYX) eA1) (p G S) (IN.p-extS ST G FYX (p G S) VS.a1) >
            o ST (ext G FYX) G (p G FYX) eA1 })
        VS.Ap1 VS.a1
        (trans (Ty ST) (subT ST (ext G FYX) (wkT G FYX FYX) (o ST SQ (ext G FYX) sQ sg)) (subT ST SQ (subT SQ (ext G FYX) (wkT G FYX FYX) sQ) sg) VS.Ap1
           (subT-o ST SQ (ext G FYX) (wkT G FYX FYX) sQ sg)
           (trans (Ty ST) (subT ST SQ (subT SQ (ext G FYX) (wkT G FYX FYX) sQ) sg) (subT ST SQ (wkT G Q FYX) sg) VS.Ap1
              (ap (Ty SQ) (Ty ST) (\ Z -> subT ST SQ Z sg) (subT SQ (ext G FYX) (wkT G FYX FYX) sQ) (wkT G Q FYX) (IN.wkT-extS SQ G FYX FYX (p G Q) vU))
              E1.1))
        (JP.ovO ST SQ (ext G FYX) (wkT G FYX FYX) sQ sg (wkT G Q FYX) (IN.wkT-extS SQ G FYX FYX (p G Q) vU) VS.Ap1 E1.1
           (trans (Ty ST) (subT ST (ext G FYX) (wkT G FYX FYX) (o ST SQ (ext G FYX) sQ sg)) (subT ST SQ (subT SQ (ext G FYX) (wkT G FYX FYX) sQ) sg) VS.Ap1
              (subT-o ST SQ (ext G FYX) (wkT G FYX FYX) sQ sg)
              (trans (Ty ST) (subT ST SQ (subT SQ (ext G FYX) (wkT G FYX FYX) sQ) sg) (subT ST SQ (wkT G Q FYX) sg) VS.Ap1
                 (ap (Ty SQ) (Ty ST) (\ Z -> subT ST SQ Z sg) (subT SQ (ext G FYX) (wkT G FYX FYX) sQ) (wkT G Q FYX) (IN.wkT-extS SQ G FYX FYX (p G Q) vU))
                 E1.1))
           (q G FYX) vU VS.a1 (JP.q-extS SQ G FYX (p G Q) vU (IN.wkT-extS SQ G FYX FYX (p G Q) vU)) E1.2)
        (IN.wkT-extS ST G FYX FYX (p G S) VS.a1) (JP.q-extS ST G FYX (p G S) VS.a1 (IN.wkT-extS ST G FYX FYX (p G S) VS.a1)) ;

    PE2r : Id (Ty ST) (subT ST VS.E2 (wkT (ext G FYX) Hs Hs) (o ST SQ VS.E2 rho sg)) (subT ST (ext G FYX) Hs eA1) =
      trans (Ty ST) (subT ST VS.E2 (wkT (ext G FYX) Hs Hs) (o ST SQ VS.E2 rho sg)) (subT ST SQ (subT SQ VS.E2 (wkT (ext G FYX) Hs Hs) rho) sg) (subT ST (ext G FYX) Hs eA1)
        (subT-o ST SQ VS.E2 (wkT (ext G FYX) Hs Hs) rho sg)
        (trans (Ty ST) (subT ST SQ (subT SQ VS.E2 (wkT (ext G FYX) Hs Hs) rho) sg) (subT ST SQ (subT SQ (ext G FYX) Hs sQ) sg) (subT ST (ext G FYX) Hs eA1)
           (ap (Ty SQ) (Ty ST) (\ Z -> subT ST SQ Z sg) (subT SQ VS.E2 (wkT (ext G FYX) Hs Hs) rho) (subT SQ (ext G FYX) Hs sQ) (IN.wkT-extS SQ (ext G FYX) Hs Hs sQ hU))
           E2.1) ;

    eRS : Id (Sub ST VS.E2) (o ST SQ VS.E2 rho sg) VS.unpk =
      IN.ext-eq ST (ext G FYX) Hs (o ST SQ VS.E2 rho sg) VS.unpk
        (calc (Sub ST (ext G FYX)) {
            o ST VS.E2 (ext G FYX) VS.p2 (o ST SQ VS.E2 rho sg)
          =< sym (Sub ST (ext G FYX)) (o ST SQ (ext G FYX) (o SQ VS.E2 (ext G FYX) VS.p2 rho) sg) (o ST VS.E2 (ext G FYX) VS.p2 (o ST SQ VS.E2 rho sg)) (o-assoc ST SQ VS.E2 (ext G FYX) VS.p2 rho sg) >
            o ST SQ (ext G FYX) (o SQ VS.E2 (ext G FYX) VS.p2 rho) sg
          =< ap (Sub SQ (ext G FYX)) (Sub ST (ext G FYX)) (\ t -> o ST SQ (ext G FYX) t sg) (o SQ VS.E2 (ext G FYX) VS.p2 rho) sQ (IN.p-extS SQ (ext G FYX) Hs sQ hU) >
            o ST SQ (ext G FYX) sQ sg
          =< EK >
            eA1
          =< sym (Sub ST (ext G FYX)) (o ST VS.E2 (ext G FYX) VS.p2 VS.unpk) eA1 (IN.p-extS ST (ext G FYX) Hs eA1 VS.b1) >
            o ST VS.E2 (ext G FYX) VS.p2 VS.unpk })
        (subT ST (ext G FYX) Hs eA1) VS.b1
        PE2r
        (JP.ovO ST SQ VS.E2 (wkT (ext G FYX) Hs Hs) rho sg (subT SQ (ext G FYX) Hs sQ) (IN.wkT-extS SQ (ext G FYX) Hs Hs sQ hU) (subT ST (ext G FYX) Hs eA1) E2.1 PE2r
           (q (ext G FYX) Hs) hU VS.b1 (JP.q-extS SQ (ext G FYX) Hs sQ hU (IN.wkT-extS SQ (ext G FYX) Hs Hs sQ hU)) E2.2)
        (IN.wkT-extS ST (ext G FYX) Hs Hs eA1 VS.b1) (JP.q-extS ST (ext G FYX) Hs eA1 VS.b1 (IN.wkT-extS ST (ext G FYX) Hs Hs eA1 VS.b1)) ;

    ------------------------------------------------------------------
    -- (6) the homotopy is refl; sections are contractible

    module RR = RT.R[G, S, Q, sm, rm] ;

    ers : Id (El ST (wkT G S S)) RR.rs (q G S) =
      IN.teAny ST (wkT G S S) (wkT G S S) RR.rs (q G S)
        (IN.teT ST (wkT G S S) (subT ST SQ (wkT G Q S) sg) (wkT G S S) RR.rs (subt ST SQ (wkT G Q S) rm sg) (q G S)
           (IN.teS ST (subT ST SQ (wkT G Q S) sg) (wkT G S S) (subt ST SQ (wkT G Q S) rm sg) RR.rs (IN.teTr ST (subT ST SQ (wkT G Q S) sg) (wkT G S S) RR.PRS (subt ST SQ (wkT G Q S) rm sg)))
           (IN.teT ST (subT ST SQ (wkT G Q S) sg) (subT ST SQ (subT SQ VS.E2 VS.SW rho) sg) (wkT G S S) (subt ST SQ (wkT G Q S) rm sg) (subt ST SQ (subT SQ VS.E2 VS.SW rho) (subt SQ VS.E2 VS.SW VS.pv rho) sg) (q G S)
              (IN.teS ST (subT ST SQ (subT SQ VS.E2 VS.SW rho) sg) (subT ST SQ (wkT G Q S) sg) (subt ST SQ (subT SQ VS.E2 VS.SW rho) (subt SQ VS.E2 VS.SW VS.pv rho) sg) (subt ST SQ (wkT G Q S) rm sg)
                 (SV.teSub ST SQ (subT SQ VS.E2 VS.SW rho) (wkT G Q S) (subt SQ VS.E2 VS.SW VS.pv rho) rm (RS.teAlong SQ VS.E2 G S VS.pp VS.pv rho (p G Q) erho) sg))
              (IN.teT ST (subT ST SQ (subT SQ VS.E2 VS.SW rho) sg) (subT ST VS.E2 VS.SW (o ST SQ VS.E2 rho sg)) (wkT G S S)
                 (subt ST SQ (subT SQ VS.E2 VS.SW rho) (subt SQ VS.E2 VS.SW VS.pv rho) sg) (subt ST VS.E2 VS.SW VS.pv (o ST SQ VS.E2 rho sg)) (q G S)
                 (IN.teS ST (subT ST VS.E2 VS.SW (o ST SQ VS.E2 rho sg)) (subT ST SQ (subT SQ VS.E2 VS.SW rho) sg)
                    (subt ST VS.E2 VS.SW VS.pv (o ST SQ VS.E2 rho sg)) (subt ST SQ (subT SQ VS.E2 VS.SW rho) (subt SQ VS.E2 VS.SW VS.pv rho) sg)
                    (IN.teSubtO ST SQ VS.E2 VS.SW VS.pv rho sg))
                 (IN.teT ST (subT ST VS.E2 VS.SW (o ST SQ VS.E2 rho sg)) (subT ST VS.E2 VS.SW VS.unpk) (wkT G S S)
                    (subt ST VS.E2 VS.SW VS.pv (o ST SQ VS.E2 rho sg)) (subt ST VS.E2 VS.SW VS.pv VS.unpk) (q G S)
                    (IN.teSubEq ST VS.E2 VS.SW VS.pv (o ST SQ VS.E2 rho sg) VS.unpk eRS)
                    (IN.teOv ST VS.E2 VS.SW VS.unpk (wkT G S S) VS.PU VS.pv (q G S) VS.pv-unpk)))))
        (refl (wkT G S S)) ;

    hm : El ST (IJ.IdT ST (wkT G S S) RR.rs (q G S)) = IN.idOfEq ST (wkT G S S) RR.rs (q G S) ers ;

    secC (k : El (ext G Y) (EQ.isContr (ext G Y) FV)) : El G (EQ.isContr G S) = RT.retC G S Q sm rm hm (WF.wfe G Y FV k) ;
  } ;
} ;
