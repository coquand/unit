    -- the second components
    PWY2 : Id (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) (wkT SQ Y1 Y1) su) (wkT ST Y2 Y2) = wkT-ov ST SQ Y1 Y1 sg Y2 PY2 Y2 PY2 ;
    PFuX : Id (Ty ST) (subT ST SQ (Fun SQ X1 Y1) sg) (Fun ST X2 Y2) = Fun-ov ST SQ X1 Y1 sg X2 PX2 Y2 PY2 ;
