                 (sec (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) XQ su) (subt (ext ST Y2) (ext SQ Y1) XQ fx su)))
           (subT (ext ST Y2) (ext (ext ST Y2) XS') (subT (ext (ext ST Y2) XS') (ext (ext SQ Y1) XQ) FmQ sux)
