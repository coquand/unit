            (subst (El (ext ST Y2) XS') (\ x2 -> El (ext ST Y2) (subT (ext ST Y2) (ext (ext ST Y2) XS') FmS' (sec (ext ST Y2) XS' x2))) (IN.fst (ext ST Y2) XS' FmS' prX) xS'
               (IN.fst-pr (ext ST Y2) XS' FmS' xS' hS') (IN.snd (ext ST Y2) XS' FmS' prX))
