    PS2 : Id (Ty (ext ST Y2)) (subT (ext ST Y2) (ext SQ Y1) (subT (ext SQ Y1) (ext (ext SQ Y1) XQ) FmQ (sec (ext SQ Y1) XQ fx)) su)
