                  (trE (ext ST Y2) (subT (ext ST Y2) (ext SQ Y1) XQ su) XS' PAx (subt (ext ST Y2) (ext SQ Y1) XQ fx su)) (IN.fst (ext ST Y2) XS' FmS' prX) FAx))) ;

