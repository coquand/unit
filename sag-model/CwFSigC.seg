-- CwFSigC.seg (M1 step 3, S4 toolkit): Sigma A B is contractible when A
-- is and every B a is, in a CwF with Pi, Sigma and Swan Id.
--
-- Informal text.  Let kA : isContr A over G and kB : isContr B over G.A,
-- with centre cB (over G.A).  S = Sigma A B is a retract of A (CwFRet):
--   sm (a , b) = a;   rm a = pr(a , cB a).
-- (1) Over G.A the pair of the variables pv (CwFSig) is a map B -> S p,
--     pv'; rm is its value at cB (so no pair has to be computed).
-- (2) Over E2 = G.A.B the contraction of B gives u : Id(cB p , b); ap of
--     pv' (weakened) to u is Id(rm p , pv'): its ends are the values of
--     pv' along lift p o sec x, for x = cB p (sec-o: that is rm p) and
--     x = q (lift-p-sec-q: that is pv' itself), by the TE calculus.
-- (3) Along unpk : G.S -> E2, rm p is rm along (p , fst q) and pv' is q:
--     the homotopy rs = q of CwFRet.

open Base ;

module SigC (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module RT = CwFRet.Ret[l, C, PS, SS, IJ] ;

  module SC (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (kA : El G (EQ.isContr G A)) (kB : El (ext G A) (EQ.isContr (ext G A) B)) {
    module VS = SV.At[G, A, B] ;
    K : Ctx = ext G A ;
    E2 : Ctx = ext K B ;
    S : Ty G = SS.Sig G A B ;
    ES : Ctx = ext G S ;
    SK : Ty K = wkT G A S ;
    SKp : Ty E2 = wkT K B SK ;
    Bp : Ty E2 = wkT K B B ;

    -- (1) pv as a map B -> S p over G.A, and rm
    So : Id (Ty E2) VS.SW SKp = subT-o E2 K G S (p G A) VS.p2 ;
    pv' : El E2 SKp = trE E2 VS.SW SKp So VS.pv ;
    cBK : El K B = SG.cenOf K B kB ;
    rm : El K SK = PT.atv K B SK pv' cBK ;

    -- (2) ap at E2
    L2 : Sub (ext E2 Bp) (ext K B) = lift E2 K B VS.p2 ;
    PL : Id (Ty (ext E2 Bp)) (subT (ext E2 Bp) (ext K B) (wkT K B SK) L2) (wkT E2 Bp SKp) = p-lift-T E2 K B SK VS.p2 ;
    pvw : El (ext E2 Bp) (wkT E2 Bp SKp) =
      trE (ext E2 Bp) (subT (ext E2 Bp) (ext K B) (wkT K B SK) L2) (wkT E2 Bp SKp) PL (subt (ext E2 Bp) (ext K B) (wkT K B SK) pv' L2) ;

    teW (x : El E2 Bp)
      : IN.TE E2 (subT E2 (ext K B) (wkT K B SK) (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp x))) SKp
           (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp x))) (PT.atv E2 Bp SKp pvw x) =
      IN.teT E2 (subT E2 (ext K B) (wkT K B SK) (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp x)))
                (subT E2 (ext E2 Bp) (wkT E2 Bp SKp) (sec E2 Bp x)) SKp
        (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp x)))
        (subt E2 (ext E2 Bp) (wkT E2 Bp SKp) pvw (sec E2 Bp x)) (PT.atv E2 Bp SKp pvw x)
        (IN.teT E2 (subT E2 (ext K B) (wkT K B SK) (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp x)))
                   (subT E2 (ext E2 Bp) (subT (ext E2 Bp) (ext K B) (wkT K B SK) L2) (sec E2 Bp x))
                   (subT E2 (ext E2 Bp) (wkT E2 Bp SKp) (sec E2 Bp x))
           (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp x)))
           (subt E2 (ext E2 Bp) (subT (ext E2 Bp) (ext K B) (wkT K B SK) L2) (subt (ext E2 Bp) (ext K B) (wkT K B SK) pv' L2) (sec E2 Bp x))
           (subt E2 (ext E2 Bp) (wkT E2 Bp SKp) pvw (sec E2 Bp x))
           (IN.teSubtO E2 (ext E2 Bp) (ext K B) (wkT K B SK) pv' L2 (sec E2 Bp x))
           (IN.teSubtTr E2 (ext E2 Bp) (subT (ext E2 Bp) (ext K B) (wkT K B SK) L2) (wkT E2 Bp SKp) PL (subt (ext E2 Bp) (ext K B) (wkT K B SK) pv' L2) (sec E2 Bp x)))
        (IN.teTr E2 (subT E2 (ext E2 Bp) (wkT E2 Bp SKp) (sec E2 Bp x)) SKp (p-sec-T E2 Bp SKp x) (subt E2 (ext E2 Bp) (wkT E2 Bp SKp) pvw (sec E2 Bp x))) ;

    -- at the variable q: pv' itself
    e-q : Id (El E2 SKp) (PT.atv E2 Bp SKp pvw (q K B)) pv' =
      IN.teAny E2 SKp SKp (PT.atv E2 Bp SKp pvw (q K B)) pv'
        (IN.teT E2 SKp X1 SKp (PT.atv E2 Bp SKp pvw (q K B))
           (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (q K B)))) pv'
           (IN.teS E2 X1 SKp (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (q K B)))) (PT.atv E2 Bp SKp pvw (q K B)) (teW (q K B)))
           (IN.teT E2 X1 (subT E2 E2 SKp (id E2)) SKp
              (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (q K B)))) (subt E2 E2 SKp pv' (id E2)) pv'
              (IN.teSubEq E2 E2 SKp pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (q K B))) (id E2) (lift-p-sec-q K B))
              (subT-id E2 SKp, subt-id E2 SKp pv')))
        (refl SKp)
     where { X1 : Ty E2 = subT E2 (ext K B) (wkT K B SK) (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (q K B))) ; } ;

    -- at cB p: rm p
    e-c : Id (El E2 SKp) (PT.atv E2 Bp SKp pvw (wkE K B B cBK)) (wkE K B SK rm) =
      IN.teAny E2 SKp SKp (PT.atv E2 Bp SKp pvw (wkE K B B cBK)) (wkE K B SK rm)
        (IN.teT E2 SKp X0 SKp (PT.atv E2 Bp SKp pvw (wkE K B B cBK))
           (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (wkE K B B cBK)))) (wkE K B SK rm)
           (IN.teS E2 X0 SKp (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (wkE K B B cBK)))) (PT.atv E2 Bp SKp pvw (wkE K B B cBK)) (teW (wkE K B B cBK)))
           (IN.teT E2 X0 (subT E2 (ext K B) (wkT K B SK) (o E2 K (ext K B) (sec K B cBK) VS.p2)) SKp
              (subt E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (wkE K B B cBK))))
              (subt E2 (ext K B) (wkT K B SK) pv' (o E2 K (ext K B) (sec K B cBK) VS.p2)) (wkE K B SK rm)
              (IN.teSubEq E2 (ext K B) (wkT K B SK) pv' (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (wkE K B B cBK))) (o E2 K (ext K B) (sec K B cBK) VS.p2)
                 (sym (Sub E2 (ext K B)) (o E2 K (ext K B) (sec K B cBK) VS.p2) (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (wkE K B B cBK))) (sec-o E2 K B cBK VS.p2)))
              (IN.teT E2 (subT E2 (ext K B) (wkT K B SK) (o E2 K (ext K B) (sec K B cBK) VS.p2)) (subT E2 K (subT K (ext K B) (wkT K B SK) (sec K B cBK)) VS.p2) SKp
                 (subt E2 (ext K B) (wkT K B SK) pv' (o E2 K (ext K B) (sec K B cBK) VS.p2))
                 (subt E2 K (subT K (ext K B) (wkT K B SK) (sec K B cBK)) (subt K (ext K B) (wkT K B SK) pv' (sec K B cBK)) VS.p2)
                 (wkE K B SK rm)
                 (IN.teSubtO E2 K (ext K B) (wkT K B SK) pv' (sec K B cBK) VS.p2)
                 (IN.teSubtTr E2 K (subT K (ext K B) (wkT K B SK) (sec K B cBK)) SK (p-sec-T K B SK cBK) (subt K (ext K B) (wkT K B SK) pv' (sec K B cBK)) VS.p2))))
        (refl SKp)
     where { X0 : Ty E2 = subT E2 (ext K B) (wkT K B SK) (o E2 (ext E2 Bp) (ext K B) L2 (sec E2 Bp (wkE K B B cBK))) ; } ;

    uB : El E2 (JP.IK K B cBK) = bod K B (JP.IK K B cBK) (SG.ctrPiOf K B kB) ;

    apB : El E2 (IJ.IdT E2 SKp (PT.atv E2 Bp SKp pvw (wkE K B B cBK)) (PT.atv E2 Bp SKp pvw (q K B))) =
      PT.apM E2 Bp SKp pvw (wkE K B B cBK) (q K B) uB ;

    hE : El E2 (IJ.IdT E2 SKp (wkE K B SK rm) pv') =
      trE E2 (IJ.IdT E2 SKp (PT.atv E2 Bp SKp pvw (wkE K B B cBK)) (PT.atv E2 Bp SKp pvw (q K B))) (IJ.IdT E2 SKp (wkE K B SK rm) pv')
        (DJ.idCong E2 SKp SKp (refl SKp) (PT.atv E2 Bp SKp pvw (wkE K B B cBK)) (PT.atv E2 Bp SKp pvw (q K B)) (wkE K B SK rm) pv' e-c e-q) apB ;

    -- (3) along unpk
    module RR = RT.R[G, S, A, VS.a1, rm] ;

    PW : Id (Ty ES) (subT ES E2 SKp VS.unpk) (wkT G S S) =
      trans (Ty ES) (subT ES E2 SKp VS.unpk) (subT ES E2 VS.SW VS.unpk) (wkT G S S)
        (ap (Ty E2) (Ty ES) (\ X -> subT ES E2 X VS.unpk) SKp VS.SW (sym (Ty E2) VS.SW SKp So)) VS.PU ;

    P1 : Ov ES E2 SKp VS.unpk (wkT G S S) PW (wkE K B SK rm) RR.rs =
      SG.subComp ES E2 K SK rm VS.p2 VS.unpk RR.sgm (IN.p-extS ES K B RR.sgm VS.b1) (wkT G S S) PW RR.PRS ;

    P2 : Ov ES E2 SKp VS.unpk (wkT G S S) PW pv' (q G S) =
      ovTr ES E2 VS.SW SKp So VS.unpk (wkT G S S) (wkT G S S) (refl (wkT G S S)) VS.PU PW VS.pv (q G S) VS.pv-unpk ;

    hm : El ES (IJ.IdT ES (wkT G S S) RR.rs (q G S)) =
      trE ES (subT ES E2 (IJ.IdT E2 SKp (wkE K B SK rm) pv') VS.unpk) (IJ.IdT ES (wkT G S S) RR.rs (q G S))
        (Id-ov ES E2 SKp (wkE K B SK rm) pv' VS.unpk (wkT G S S) PW RR.rs (q G S) P1 P2)
        (subt ES E2 (IJ.IdT E2 SKp (wkE K B SK rm) pv') hE VS.unpk) ;

    sigC : El G (EQ.isContr G S) = RT.retC G S A VS.a1 rm hm kA ;
  } ;

  sigC (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (kA : El G (EQ.isContr G A)) (kB : El (ext G A) (EQ.isContr (ext G A) B))
    : El G (EQ.isContr G (SS.Sig G A B)) = SC[G, A, B, kA, kB].sigC ;
} ;
