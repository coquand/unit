-- FibGlueF.seg (M1 step 3, S4, the map f): a full glue datum read through
-- a point of a context.  For a level-a+ context G, two maps xm , ym : G -> U
-- (codes), a map alg : El[ym] -> El[xm] over G with an equivalence
-- structure eg, a point t of G at X, a code F with a path pF : xm t = F and
-- a sieve ph, the glue datum (F , ph , B , alpha , e) has B at g the code
-- ym (t g), alpha = alg read back, e = eg moved along the cart of triples
-- over io : RC(X , ph) -> G, g |-> t g (core's CGlueCart.GC).
--
-- Informal text.
-- (1) The B-cart is the identity on fibres: the fibre of Bt at g is that of
--     El at ym (t g), which is the fibre of El[ym] at t g.  Naturality: read
--     in El (the substitution cart CSub.SubE, injective over equal points),
--     both sides are El's action on the same pair (CYonCart.tacE, which
--     holds for any path of codes).
-- (2) The A-cart: the fibre of At at g has code F(g), that of El[xm] at t g
--     has code fib0 (xm (t g)).  xm (t g) = F g (xm natural, then pF), and
--     fib0 (F g) = F(g id) = F(g) (CYonCart.Yc.Po); the A-cart is the
--     transport sV along this path cA.  Read in El it is the Yoneda cart
--     of F (Yc.ta), up to the path xm (t g) = F g of points of U (mvA); so
--     its naturality is Yc.tanat.  Its inverse on fibres is sV back.
-- (3) GC gives the datum; out adds that it is full when ph is.
-- (4) Naturality (CGlueCartNat): the datum at t restricted along h is the
--     datum at t h over F h and pre h ph; B-codes and carts agree through
--     the path t (h g) = (t h) g of points of G (act-o).
-- (5) fdat: the full datum over xm t at the sieve top.  fnat: restricted
--     along h (UaTy's action, any path of codes) it is fdat at t h: (4),
--     then pre h top = top, then the path to the code is irrelevant (J).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Trees[a] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[a] ;
open GPR.PS ;
open PB.GYon[a] ;
module L = PB.GPre[a+].PS ;
module LP = PB.GPre[a+] ;
module UU = CPosEl1[a].UU ;
module YG = CPosEl1[a].YG ;
module DD = PB.CGlueD.GD[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl] ;
module GE = PB.CGlueE.GE[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl] ;
module UA = PB.CUa.UaU[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl] ;

module FD (G : L.PCtx) (xm ym : L.PSub[G, UU.UCtx])
  (alg : PB.CPartial[a+].PMap[G, L.subTy G UU.UCtx UU.EGen ym, L.subTy G UU.UCtx UU.EGen xm])
  (eg : PB.CEquiv[a+].EquivOp G (L.subTy G UU.UCtx UU.EGen ym) (L.subTy G UU.UCtx UU.EGen xm) alg) {
  -- El along the two maps, and their substitution carts into El
  module SA = PB.CSub[a+].SubE[G, UU.UCtx, xm, UU.EGen] ;
  module SB = PB.CSub[a+].SubE[G, UU.UCtx, ym, UU.EGen] ;

  module P (X : Ob) (t : V1.Ix (G.ob X)) (F : UU.U0 X) (pF : Id (UU.U0 X) (xm.nt X t) F) (ph : PB.Phi X) {
    module R = PB.CGlueE.RCm[X, ph] ;
    module Y = YG.Yc[X, F] ;

    -- the point of G at g
    io (W : Ob) (r : W0.Ix (R.RC.ob W)) : V1.Ix (G.ob W) = G.act W X r.1 t ;

    io-nat (V W : Ob) (k : Hom V W) (r : W0.Ix (R.RC.ob W)) : Id (V1.Ix (G.ob V)) (io V (R.RC.act V W k r)) (G.act V W k (io W r)) =
      G.act-o V W X r.1 k t ;

    --------------------------------------------------------------------
    -- (1) the B-codes and the B-cart

    B (W : Ob) (g : Hom W X) (q : IsT (PB.CGlueD.fl X ph W g)) : UU.U0 W = ym.nt W (G.act W X g t) ;

    bn : DD.BNat X ph B = \ W' W chi g q g2 E q2 ->
      transH (symH (ym.nt-nat W' W chi (G.act W X g t)))
        (apH (ym.nt W') (transH (symH (G.act-o W' W X g chi t)) (apH (\ k -> G.act W' X k t) E))) ;

    Bt0 : PTy[R.RC] = GE.BtOf X ph B bn ;
    module TBt = GPR.TyL[R.RC, Bt0] ;

    tB (W : Ob) (v : TBt.EI W) : SB.TS.EI W = SB.TS.pr W (io W (TBt.pr1 W v)) (TBt.pr2 W v) ;

    -- the path of codes in Bt's action, named once
    bnA (V W : Ob) (k : Hom V W) (r : W0.Ix (R.RC.ob W)) : Id (UU.U0 V) (UU.uAct V W k (B W r.1 r.2)) (B V (R.RC.act V W k r).1 (R.RC.act V W k r).2) =
      bn V W k r.1 r.2 (R.RC.act V W k r).1 (apH (\ z -> z.1) (refl (R.RC.act V W k r))) (R.RC.act V W k r).2 ;

    tBnat (V W : Ob) (k : Hom V W) (v : TBt.EI W) : Id (SB.TS.EI V) (SB.TS.E.act V W k (tB W v)) (tB V (TBt.E.act V W k v)) =
      SB.mV-inj V (SB.TS.E.act V W k (tB W v)) (tB V (TBt.E.act V W k v)) (symH (io-nat V W k (TBt.pr1 W v)))
        (transH (symH (SB.mV-nat V W k (tB W v)))
                (YG.tacE V W k (B W (TBt.pr1 W v).1 (TBt.pr1 W v).2) (B V (R.RC.act V W k (TBt.pr1 W v)).1 (R.RC.act V W k (TBt.pr1 W v)).2)
                   (bnA V W k (TBt.pr1 W v)) (TBt.pr2 W v))) ;

    tBinj (W : Ob) (v v' : TBt.EI W) (Pp : Id (W0.Ix (R.RC.ob W)) (TBt.pr1 W v) (TBt.pr1 W v')) (Qp : Id (SB.TS.EI W) (tB W v) (tB W v')) : Id (TBt.EI W) v v' =
      idJ (W0.Ix (R.RC.ob W)) (TBt.pr1 W v)
        (\ r2 P2 -> (b2 : W0.Ix (Bt0.tob W r2)) -> Id (SB.TS.EI W) (tB W v) (tB W (TBt.pr W r2 b2)) -> Id (TBt.EI W) v (TBt.pr W r2 b2))
        (\ b2 Q2 -> apH {W0.Ix (Bt0.tob W (TBt.pr1 W v))} {TBt.EI W} (\ z -> (TBt.pr W (TBt.pr1 W v) z)) (SB.TS.pr-inj W (io W (TBt.pr1 W v)) (TBt.pr2 W v) b2 Q2))
        (TBt.pr1 W v') Pp (TBt.pr2 W v') Qp ;

    opaque tBnat ; opaque tBinj ;

    --------------------------------------------------------------------
    -- (2) the A-cart

    At0 : PTy[R.RC] = subTy R.RC (yP X) F.1 R.inclRC ;
    module TAt = GPR.TyL[R.RC, At0] ;

    -- xm (t g) = F g
    nx (W : Ob) (g : Hom W X) : Id (UU.U0 W) (xm.nt W (G.act W X g t)) (UU.uAct W X g F) =
      transH (xm.nt-nat W X g t) (apH (UU.uAct W X g) pF) ;

    -- the code of At at g and that of El[xm] at t g
    cA (W : Ob) (g : Hom W X) : Id W0.V (F.1.tob W g) (UU.fib0 W (xm.nt W (G.act W X g t))) =
      transH (symH (Y.Po W g)) (apH (UU.fib0 W) (symH (nx W g))) ;

    phA (W : Ob) (g : Hom W X) (u : W0.Ix (F.1.tob W g)) : W0.Ix (UU.fib0 W (xm.nt W (G.act W X g t))) =
      PB.CExtEq1.sV (F.1.tob W g) (UU.fib0 W (xm.nt W (G.act W X g t))) (cA W g) u ;

    psA (W : Ob) (g : Hom W X) (z : W0.Ix (UU.fib0 W (xm.nt W (G.act W X g t)))) : W0.Ix (F.1.tob W g) =
      PB.CExtEq1.sV (UU.fib0 W (xm.nt W (G.act W X g t))) (F.1.tob W g) (symH (cA W g)) z ;

    tA (W : Ob) (v : TAt.EI W) : SA.TS.EI W = SA.TS.pr W (io W (TAt.pr1 W v)) (phA W (TAt.pr1 W v).1 (TAt.pr2 W v)) ;

    -- read in El, tA is the Yoneda cart of F
    mvA (W : Ob) (v : TAt.EI W) : Id (SA.TC.EI W) (SA.mV W (tA W v)) (Y.ta W (Y.TF.pr W (TAt.pr1 W v).1 (TAt.pr2 W v))) =
      apH (\ p -> SA.TC.pr W p.1 p.2)
        (PB.CExtEq1.pair-eqV1 (UU.U0 W) (UU.fib0 W) (xm.nt W (io W (TAt.pr1 W v))) (UU.uAct W X (TAt.pr1 W v).1 F) (nx W (TAt.pr1 W v).1)
          (phA W (TAt.pr1 W v).1 (TAt.pr2 W v)) (YG.sV (F.1.tob W (TAt.pr1 W v).1) (UU.fib0 W (Y.s W (TAt.pr1 W v).1)) (symH (Y.Po W (TAt.pr1 W v).1)) (TAt.pr2 W v))
          (apH (UU.fib0 W) (nx W (TAt.pr1 W v).1))
          (PB.CExtEq1.sV-two (F.1.tob W (TAt.pr1 W v).1) (UU.fib0 W (xm.nt W (io W (TAt.pr1 W v)))) (UU.fib0 W (Y.s W (TAt.pr1 W v).1))
             (cA W (TAt.pr1 W v).1) (apH (UU.fib0 W) (nx W (TAt.pr1 W v).1)) (symH (Y.Po W (TAt.pr1 W v).1)) (TAt.pr2 W v))) ;

    -- At's action, read in F's total over y X
    actF (V W : Ob) (k : Hom V W) (v : TAt.EI W)
      : Id (Y.TF.EI V) (Y.TF.E.act V W k (Y.TF.pr W (TAt.pr1 W v).1 (TAt.pr2 W v)))
                       (Y.TF.pr V (TAt.pr1 V (TAt.E.act V W k v)).1 (TAt.pr2 V (TAt.E.act V W k v))) =
      transH (Y.TF.pr-tact V W k (TAt.pr1 W v).1 (compH V W X (TAt.pr1 W v).1 k) (refl (compH V W X (TAt.pr1 W v).1 k)) (TAt.pr2 W v))
        (apH (Y.TF.pr V (compH V W X (TAt.pr1 W v).1 k))
           (tact-irr (yP X) F.1 V W k (TAt.pr1 W v).1 (compH V W X (TAt.pr1 W v).1 k) (refl (compH V W X (TAt.pr1 W v).1 k))
              (ntEq R.RC (yP X) R.inclRC V W k (TAt.pr1 W v) (R.RC.act V W k (TAt.pr1 W v)) (refl (R.RC.act V W k (TAt.pr1 W v)))) (TAt.pr2 W v))) ;

    tAnat (V W : Ob) (k : Hom V W) (v : TAt.EI W) : Id (SA.TS.EI V) (SA.TS.E.act V W k (tA W v)) (tA V (TAt.E.act V W k v)) =
      SA.mV-inj V (SA.TS.E.act V W k (tA W v)) (tA V (TAt.E.act V W k v)) (symH (io-nat V W k (TAt.pr1 W v)))
        (transH (symH (SA.mV-nat V W k (tA W v)))
        (transH (apH (SA.TC.E.act V W k) (mvA W v))
        (transH (Y.tanat V W k (Y.TF.pr W (TAt.pr1 W v).1 (TAt.pr2 W v)))
        (transH (apH (Y.ta V) (actF V W k v))
                (symH (mvA V (TAt.E.act V W k v))))))) ;

    bkA (Y0 : Ob) (r : W0.Ix (R.RC.ob Y0)) (z : W0.Ix (UU.fib0 Y0 (xm.nt Y0 (io Y0 r)))) : W0.Ix (F.1.tob Y0 r.1) = psA Y0 r.1 z ;

    bkAta (Y0 : Ob) (r : W0.Ix (R.RC.ob Y0)) (z : W0.Ix (UU.fib0 Y0 (xm.nt Y0 (io Y0 r))))
      : Id (SA.TS.EI Y0) (tA Y0 (TAt.pr Y0 r (bkA Y0 r z))) (SA.TS.pr Y0 (io Y0 r) z) =
      apH (SA.TS.pr Y0 (io Y0 r)) (YG.sV-round (F.1.tob Y0 r.1) (UU.fib0 Y0 (xm.nt Y0 (io Y0 r))) (cA Y0 r.1) z) ;

    tAinj (W : Ob) (v v' : TAt.EI W) (Pp : Id (W0.Ix (R.RC.ob W)) (TAt.pr1 W v) (TAt.pr1 W v')) (Qp : Id (SA.TS.EI W) (tA W v) (tA W v')) : Id (TAt.EI W) v v' =
      idJ (W0.Ix (R.RC.ob W)) (TAt.pr1 W v)
        (\ r2 P2 -> (b2 : W0.Ix (At0.tob W r2)) -> Id (SA.TS.EI W) (tA W v) (tA W (TAt.pr W r2 b2)) -> Id (TAt.EI W) v (TAt.pr W r2 b2))
        (\ b2 Q2 -> apH {W0.Ix (At0.tob W (TAt.pr1 W v))} {TAt.EI W} (\ z -> (TAt.pr W (TAt.pr1 W v) z))
           (transH (symH (YG.sV-round' (F.1.tob W (TAt.pr1 W v).1) (UU.fib0 W (xm.nt W (io W (TAt.pr1 W v)))) (cA W (TAt.pr1 W v).1) (TAt.pr2 W v)))
             (transH (apH (psA W (TAt.pr1 W v).1) (SA.TS.pr-inj W (io W (TAt.pr1 W v)) (phA W (TAt.pr1 W v).1 (TAt.pr2 W v)) (phA W (TAt.pr1 W v).1 b2) Q2))
                     (YG.sV-round' (F.1.tob W (TAt.pr1 W v).1) (UU.fib0 W (xm.nt W (io W (TAt.pr1 W v)))) (cA W (TAt.pr1 W v).1) b2))))
        (TAt.pr1 W v') Pp (TAt.pr2 W v') Qp ;

    opaque mvA ; opaque tAnat ; opaque bkAta ; opaque tAinj ;

    --------------------------------------------------------------------
    -- (3) the glue datum

    module GC = PB.CGlueCart.GC[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl,
      X, F, ph, B, bn, G, L.subTy G UU.UCtx UU.EGen ym, L.subTy G UU.UCtx UU.EGen xm, alg, eg, io, io-nat,
      tA, \ W v -> refl (io W (TAt.pr1 W v)), tAnat, tAinj, bkA, bkAta,
      tB, \ W v -> refl (io W (TBt.pr1 W v)), tBnat, tBinj, \ Y0 r z -> z, \ Y0 r z -> refl (SB.TS.pr Y0 (io Y0 r) z)] ;

    out (full : IsT (PB.allS X ph)) : UA.UaT0 X F = (GC.dat, (refl F, full)) ;
  } ;

  -- the datum, as a function of its parameters
  datOf (X : Ob) (t : V1.Ix (G.ob X)) (F : UU.U0 X) (pF : Id (UU.U0 X) (xm.nt X t) F) (ph : PB.Phi X) : GE.GD1 X =
    P[X, t, F, pF, ph].GC.dat ;

  ----------------------------------------------------------------------
  -- (4) naturality: the datum at t, restricted along h, is the datum at
  -- t h (over the code F h and the sieve pre h ph).  CGlueCartNat: the
  -- B-codes agree by act-o of G, the carts by the same path of points.

  module N (X : Ob) (t : V1.Ix (G.ob X)) (F : UU.U0 X) (pF : Id (UU.U0 X) (xm.nt X t) F) (ph : PB.Phi X) (J : Ob) (h : Hom J X) {
    module D = P[X, t, F, pF, ph] ;
    module D' = P[J, G.act J X h t, UU.uAct J X h F, D.nx J h, PB.pre J X h ph] ;

    -- t (h g) = (t h) g
    Pio (W : Ob) (g : Hom W J) : Id (V1.Ix (G.ob W)) (G.act W J g (G.act J X h t)) (G.act W X (compH W J X h g) t) =
      symH (G.act-o W J X h g t) ;

    PBc (W : Ob) (g : Hom W J) (q : IsT (PB.CGlueD.fl J (PB.pre J X h ph) W g)) (q2 : IsT (PB.CGlueD.fl X ph W (compH W J X h g)))
      : Id (UU.U0 W) (D.B W (compH W J X h g) q2) (D'.B W g q) =
      apH (ym.nt W) (symH (Pio W g)) ;

    PtA (W : Ob) (v : D'.TAt.EI W) (q2 : IsT (PB.CGlueD.fl X ph W (compH W J X h (D'.TAt.pr1 W v).1)))
      : Id (SA.TS.EI W) (D'.tA W v) (D.tA W (D.TAt.pr W (compH W J X h (D'.TAt.pr1 W v).1, q2) (D'.TAt.pr2 W v))) =
      apH (\ p -> SA.TS.pr W p.1 p.2)
        (PB.CExtEq1.pair-eqV1 (V1.Ix (G.ob W)) (\ z -> UU.fib0 W (xm.nt W z))
          (G.act W J (D'.TAt.pr1 W v).1 (G.act J X h t)) (G.act W X (compH W J X h (D'.TAt.pr1 W v).1) t) (Pio W (D'.TAt.pr1 W v).1)
          (D'.phA W (D'.TAt.pr1 W v).1 (D'.TAt.pr2 W v)) (D.phA W (compH W J X h (D'.TAt.pr1 W v).1) (D'.TAt.pr2 W v))
          (apH (\ z -> UU.fib0 W (xm.nt W z)) (Pio W (D'.TAt.pr1 W v).1))
          (PB.CExtEq1.sV-two (F.1.tob W (compH W J X h (D'.TAt.pr1 W v).1))
             (UU.fib0 W (xm.nt W (G.act W J (D'.TAt.pr1 W v).1 (G.act J X h t)))) (UU.fib0 W (xm.nt W (G.act W X (compH W J X h (D'.TAt.pr1 W v).1) t)))
             (D'.cA W (D'.TAt.pr1 W v).1) (apH (\ z -> UU.fib0 W (xm.nt W z)) (Pio W (D'.TAt.pr1 W v).1)) (D.cA W (compH W J X h (D'.TAt.pr1 W v).1))
             (D'.TAt.pr2 W v))) ;

    PtB (W : Ob) (r : W0.Ix (D'.R.RC.ob W)) (q2 : IsT (PB.CGlueD.fl X ph W (compH W J X h r.1)))
      (b : W0.Ix (UU.fib0 W (D.B W (compH W J X h r.1) q2)))
      : Id (SB.TS.EI W)
           (D'.tB W (D'.TBt.pr W r (subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (D.B W (compH W J X h r.1) q2) (D'.B W r.1 r.2) (PBc W r.1 r.2 q2) b)))
           (D.tB W (D.TBt.pr W (compH W J X h r.1, q2) b)) =
      apH (\ p -> SB.TS.pr W p.1 p.2)
        (PB.CExtEq1.pair-eqV1 (V1.Ix (G.ob W)) (\ z -> UU.fib0 W (ym.nt W z))
          (G.act W J r.1 (G.act J X h t)) (G.act W X (compH W J X h r.1) t) (Pio W r.1)
          (subst (UU.U0 W) (\ G2 -> W0.Ix (UU.fib0 W G2)) (D.B W (compH W J X h r.1) q2) (D'.B W r.1 r.2) (PBc W r.1 r.2 q2) b) b
          (apH (\ z -> UU.fib0 W (ym.nt W z)) (Pio W r.1))
          (transH (apH (PB.CExtEq1.sV (UU.fib0 W (D'.B W r.1 r.2)) (UU.fib0 W (D.B W (compH W J X h r.1) q2)) (apH (\ z -> UU.fib0 W (ym.nt W z)) (Pio W r.1)))
                     (UU.substF W (D.B W (compH W J X h r.1) q2) (D'.B W r.1 r.2) (PBc W r.1 r.2 q2) b))
                  (PB.CExtEq1.sV-two (UU.fib0 W (D.B W (compH W J X h r.1) q2)) (UU.fib0 W (D'.B W r.1 r.2)) (UU.fib0 W (D.B W (compH W J X h r.1) q2))
                     (apH (UU.fib0 W) (PBc W r.1 r.2 q2)) (apH (\ z -> UU.fib0 W (ym.nt W z)) (Pio W r.1)) (refl (UU.fib0 W (D.B W (compH W J X h r.1) q2))) b))) ;

    opaque PtA ; opaque PtB ;

    module GN = PB.CGlueCartNat.GCN[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl,
      X, F, ph, D.B, D.bn, G, L.subTy G UU.UCtx UU.EGen ym, L.subTy G UU.UCtx UU.EGen xm, alg, eg,
      D.io, D.io-nat, D.tA, \ W v -> refl (D.io W (D.TAt.pr1 W v)), D.tAnat, D.tAinj, D.bkA, D.bkAta,
      D.tB, \ W v -> refl (D.io W (D.TBt.pr1 W v)), D.tBnat, D.tBinj, \ Y0 r z -> z, \ Y0 r z -> refl (SB.TS.pr Y0 (D.io Y0 r) z),
      J, h, D'.B, D'.bn,
      D'.io, D'.io-nat, D'.tA, \ W v -> refl (D'.io W (D'.TAt.pr1 W v)), D'.tAnat, D'.tAinj, D'.bkA, D'.bkAta,
      D'.tB, \ W v -> refl (D'.io W (D'.TBt.pr1 W v)), D'.tBnat, D'.tBinj, \ Y0 r z -> z, \ Y0 r z -> refl (SB.TS.pr Y0 (D'.io Y0 r) z),
      PBc, PtA, PtB] ;

    law : Id (GE.GD1 J) (GE.act1 J X h (datOf X t F pF ph)) (datOf J (G.act J X h t) (UU.uAct J X h F) (D.nx J h) (PB.pre J X h ph)) = GN.law ;
  } ;

  ----------------------------------------------------------------------
  -- (5) the full datum at a point, over its own code, and its naturality

  fullTop (X : Ob) : IsT (PB.allS X (PB.topS X)) = PB.allS-complete X (PB.topS X) (PB.top-lands X X (idH X)) ;

  pre-top (J X : Ob) (h : Hom J X) : Id (PB.Phi J) (PB.pre J X h (PB.topS X)) (PB.topS J) =
    PB.phi-ext J (PB.pre J X h (PB.topS X)) (PB.topS J) (\ W f i -> PB.top-lands W J f)
      (\ W f i -> PB.pre-lands W J X h (PB.topS X) f (PB.top-lands W X (compH W J X h f))) ;

  fdat (X : Ob) (t : V1.Ix (G.ob X)) : UA.UaT0 X (xm.nt X t) =
    P[X, t, xm.nt X t, refl (xm.nt X t), PB.topS X].out (fullTop X) ;

  -- the datum does not depend on the path to its code
  datF (X : Ob) (t : V1.Ix (G.ob X)) (ph : PB.Phi X) (F : UU.U0 X) (pF : Id (UU.U0 X) (xm.nt X t) F)
    : Id (GE.GD1 X) (datOf X t F pF ph) (datOf X t (xm.nt X t) (refl (xm.nt X t)) ph) =
    symH (idJ (UU.U0 X) (xm.nt X t) (\ F2 p2 -> Id (GE.GD1 X) (datOf X t (xm.nt X t) (refl (xm.nt X t)) ph) (datOf X t F2 p2 ph))
            (refl (datOf X t (xm.nt X t) (refl (xm.nt X t)) ph)) F pF) ;

  fnat (X : Ob) (t : V1.Ix (G.ob X)) (J : Ob) (h : Hom J X) (e : Id (UU.U0 J) (UU.uAct J X h (xm.nt X t)) (xm.nt J (G.act J X h t)))
    : Id (UA.UaT0 J (xm.nt J (G.act J X h t))) (UA.uaTact J X h (xm.nt X t) (xm.nt J (G.act J X h t)) e (fdat X t)) (fdat J (G.act J X h t)) =
    UA.uaExt J (xm.nt J (G.act J X h t)) (UA.uaTact J X h (xm.nt X t) (xm.nt J (G.act J X h t)) e (fdat X t)) (fdat J (G.act J X h t))
      (transH (N[X, t, xm.nt X t, refl (xm.nt X t), PB.topS X, J, h].law)
      (transH (apH (\ p -> datOf J (G.act J X h t) (UU.uAct J X h (xm.nt X t)) (P[X, t, xm.nt X t, refl (xm.nt X t), PB.topS X].nx J h) p) (pre-top J X h))
              (datF J (G.act J X h t) (PB.topS J) (UU.uAct J X h (xm.nt X t)) (P[X, t, xm.nt X t, refl (xm.nt X t), PB.topS X].nx J h)))) ;

  opaque fnat ;
} ;
