-- CwFId.seg (M1, step 3): Swan's identity type in a CwF (the interface
-- record of M1.md decision 1).  CwF.Formers.IdStr is the extensional
-- identity type; this is the intensional one with based J and a strict
-- computation rule, all stable under substitution.
--
-- For A over G and a : A, write K = G.A, I = Id(a p , q) over K and
-- Dx = K.I (the context of the motive).  The centre cen : G -> Dx is
-- (sec a , refl a), refl transported along I[sec a] = Id(a , a) (reflT).
-- For s : D -> G the map upS : Dx(A[s] , a[s]) -> Dx(A , a) is the double
-- lift, transported along I[lift s] = I(A[s] , a[s]) (IKnat).
--
-- Fields: IdT, IdT-nat, rfl, rfl-nat; J, J-beta; cen-nat (the centre is
-- stable: cen s = upS cen'); J-nat.  cen-nat is a consequence of the CwF
-- laws and rfl-nat; it is a field here (a proposition: substitutions form
-- a set) and proved in each model.
--
-- Dx, cen, upS, cenT are not derived members of the record but the module
-- Der[IdT, IdT-nat, rfl], so that an instance names THE same terms (an
-- instance under construction cannot name the record's derived members).
-- The endpoints of the transport in J-nat are written out (an elaborated
-- '_' is compared by computing).
--
-- Informal text for the derived transports.
-- (1) subtEq: two transports of b at equal substitutions s = s', to the
--     same type, agree (types form a set, so the paths can be chosen; then
--     J on s = s').
-- (2) wk-sec: (b p)[sec a] = b;  wk-lift: (b p)[lift s] = (b[s]) p; both by
--     subt-o and subtEq along p sec a = id, p lift s = s p.
-- (3) idCong: Id is a congruence for (A , a , b) given with transports.

open Base ;

module SwanId (l : Level) (C : CwF.CwF[l]) {
  open Prelude[l] ;
  open C ;

  ----------------------------------------------------------------------
  -- (1) transports

  substTr (T : U l) (F : T -> U l) (x y z : T) (p : Id T x y) (q : Id T y z) (u : F x)
    : Id (F z) (subst T F x z (trans T x y z p q) u) (subst T F y z q (subst T F x y p u)) =
    idJ T y (\ w r -> Id (F w) (subst T F x w (trans T x y w p r) u) (subst T F y w r (subst T F x y p u)))
      (refl (subst T F x y p u)) z q ;

  apdSubt (E G : Ctx) (B : Ty G) (b : El G B) (s s' : Sub E G) (P : Id (Sub E G) s s')
    : Id (El E (subT E G B s')) (subst (Ty E) (El E) (subT E G B s) (subT E G B s') (ap (Sub E G) (Ty E) (\ s2 -> subT E G B s2) s s' P) (subt E G B b s))
         (subt E G B b s') =
    idJ (Sub E G) s
      (\ s2 P2 -> Id (El E (subT E G B s2)) (subst (Ty E) (El E) (subT E G B s) (subT E G B s2) (ap (Sub E G) (Ty E) (\ s3 -> subT E G B s3) s s2 P2) (subt E G B b s))
                     (subt E G B b s2))
      (refl (subt E G B b s)) s' P ;

  subtEq (E G : Ctx) (B : Ty G) (b : El G B) (s s' : Sub E G) (P : Id (Sub E G) s s') (T : Ty E)
    (Q : Id (Ty E) (subT E G B s) T) (Q' : Id (Ty E) (subT E G B s') T)
    : Id (El E T) (subst (Ty E) (El E) (subT E G B s) T Q (subt E G B b s)) (subst (Ty E) (El E) (subT E G B s') T Q' (subt E G B b s')) =
    trans (El E T) _ (subst (Ty E) (El E) (subT E G B s) T (trans (Ty E) _ _ T (ap (Sub E G) (Ty E) (\ s2 -> subT E G B s2) s s' P) Q') (subt E G B b s)) _
      (ap (Id (Ty E) (subT E G B s) T) (El E T) (\ R -> subst (Ty E) (El E) (subT E G B s) T R (subt E G B b s)) Q _
         (isSetTy E (subT E G B s) T Q _))
      (trans (El E T) _ (subst (Ty E) (El E) (subT E G B s') T Q' (subst (Ty E) (El E) (subT E G B s) (subT E G B s') (ap (Sub E G) (Ty E) (\ s2 -> subT E G B s2) s s' P) (subt E G B b s))) _
         (substTr (Ty E) (El E) (subT E G B s) (subT E G B s') T (ap (Sub E G) (Ty E) (\ s2 -> subT E G B s2) s s' P) Q' (subt E G B b s))
         (ap (El E (subT E G B s')) (El E T) (\ v -> subst (Ty E) (El E) (subT E G B s') T Q' v) _ _ (apdSubt E G B b s s' P))) ;

  -- subt-o, read the other way
  subt-o' (T D G : Ctx) (B : Ty G) (b : El G B) (s : Sub D G) (s' : Sub T D)
    : Id (El T (subT T D (subT D G B s) s')) (subt T D (subT D G B s) (subt D G B b s) s')
         (subst (Ty T) (El T) (subT T G B (o T D G s s')) (subT T D (subT D G B s) s') (subT-o T D G B s s') (subt T G B b (o T D G s s'))) =
    sym (El T (subT T D (subT D G B s) s')) _ _ (subt-o T D G B b s s') ;

  ----------------------------------------------------------------------
  -- (2) weakening, then a section or a lift

  wk-sec (G : Ctx) (A B : Ty G) (a : El G A) (b : El G B)
    : Id (El G B) (subst (Ty G) (El G) (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a)) B (p-sec-T G A B a)
                    (subt G (ext G A) (subT (ext G A) G B (p G A)) (subt (ext G A) G B b (p G A)) (sec G A a)))
                  b =
    calc (El G B) {
        subst (Ty G) (El G) T1 B (p-sec-T G A B a) (subt G (ext G A) (subT (ext G A) G B (p G A)) (subt (ext G A) G B b (p G A)) (sec G A a))
      =< ap (El G T1) (El G B) (\ v -> subst (Ty G) (El G) T1 B (p-sec-T G A B a) v)
           (subt G (ext G A) (subT (ext G A) G B (p G A)) (subt (ext G A) G B b (p G A)) (sec G A a))
           (subst (Ty G) (El G) (subT G G B s1) T1 Po (subt G G B b s1))
           (subt-o' G (ext G A) G B b (p G A) (sec G A a)) >
        subst (Ty G) (El G) T1 B (p-sec-T G A B a) (subst (Ty G) (El G) (subT G G B s1) T1 Po (subt G G B b s1))
      =< sym (El G B) (subst (Ty G) (El G) (subT G G B s1) B (trans (Ty G) (subT G G B s1) T1 B Po (p-sec-T G A B a)) (subt G G B b s1))
           (subst (Ty G) (El G) T1 B (p-sec-T G A B a) (subst (Ty G) (El G) (subT G G B s1) T1 Po (subt G G B b s1)))
           (substTr (Ty G) (El G) (subT G G B s1) T1 B Po (p-sec-T G A B a) (subt G G B b s1)) >
        subst (Ty G) (El G) (subT G G B s1) B (trans (Ty G) (subT G G B s1) T1 B Po (p-sec-T G A B a)) (subt G G B b s1)
      =< subtEq G G B b s1 (id G) (p-sec G A a) B (trans (Ty G) (subT G G B s1) T1 B Po (p-sec-T G A B a)) (subT-id G B) >
        subst (Ty G) (El G) (subT G G B (id G)) B (subT-id G B) (subt G G B b (id G))
      =< subt-id G B b >
        b }
   where {
    s1 : Sub G G = o G (ext G A) G (p G A) (sec G A a) ;
    T1 : Ty G = subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a) ;
    Po : Id (Ty G) (subT G G B s1) T1 = subT-o G (ext G A) G B (p G A) (sec G A a) ;
   } ;

  wk-lift (D G : Ctx) (A B : Ty G) (b : El G B) (s : Sub D G)
    : Id (El (ext D (subT D G A s)) (subT (ext D (subT D G A s)) D (subT D G B s) (p D (subT D G A s))))
         (subst (Ty (ext D (subT D G A s))) (El (ext D (subT D G A s)))
            (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s))
            (subT (ext D (subT D G A s)) D (subT D G B s) (p D (subT D G A s))) (p-lift-T D G A B s)
            (subt (ext D (subT D G A s)) (ext G A) (subT (ext G A) G B (p G A)) (subt (ext G A) G B b (p G A)) (lift D G A s)))
         (subt (ext D (subT D G A s)) D (subT D G B s) (subt D G B b s) (p D (subT D G A s))) =
    calc (El E T) {
        subst (Ty E) (El E) T1 T (p-lift-T D G A B s) (subt E (ext G A) (subT (ext G A) G B (p G A)) (subt (ext G A) G B b (p G A)) (lift D G A s))
      =< ap (El E T1) (El E T) (\ v -> subst (Ty E) (El E) T1 T (p-lift-T D G A B s) v)
           (subt E (ext G A) (subT (ext G A) G B (p G A)) (subt (ext G A) G B b (p G A)) (lift D G A s))
           (subst (Ty E) (El E) (subT E G B s1) T1 Po (subt E G B b s1))
           (subt-o' E (ext G A) G B b (p G A) (lift D G A s)) >
        subst (Ty E) (El E) T1 T (p-lift-T D G A B s) (subst (Ty E) (El E) (subT E G B s1) T1 Po (subt E G B b s1))
      =< sym (El E T) (subst (Ty E) (El E) (subT E G B s1) T (trans (Ty E) (subT E G B s1) T1 T Po (p-lift-T D G A B s)) (subt E G B b s1))
           (subst (Ty E) (El E) T1 T (p-lift-T D G A B s) (subst (Ty E) (El E) (subT E G B s1) T1 Po (subt E G B b s1)))
           (substTr (Ty E) (El E) (subT E G B s1) T1 T Po (p-lift-T D G A B s) (subt E G B b s1)) >
        subst (Ty E) (El E) (subT E G B s1) T (trans (Ty E) (subT E G B s1) T1 T Po (p-lift-T D G A B s)) (subt E G B b s1)
      =< subtEq E G B b s1 s2 (p-lift D G A s) T (trans (Ty E) (subT E G B s1) T1 T Po (p-lift-T D G A B s)) (subT-o E D G B s (p D (subT D G A s))) >
        subst (Ty E) (El E) (subT E G B s2) T (subT-o E D G B s (p D (subT D G A s))) (subt E G B b s2)
      =< subt-o E D G B b s (p D (subT D G A s)) >
        subt E D (subT D G B s) (subt D G B b s) (p D (subT D G A s)) }
   where {
    E : Ctx = ext D (subT D G A s) ;
    T : Ty E = subT E D (subT D G B s) (p D (subT D G A s)) ;
    s1 : Sub E G = o E (ext G A) G (p G A) (lift D G A s) ;
    s2 : Sub E G = o E D G s (p D (subT D G A s)) ;
    T1 : Ty E = subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s) ;
    Po : Id (Ty E) (subT E G B s1) T1 = subT-o E (ext G A) G B (p G A) (lift D G A s) ;
   } ;

  ----------------------------------------------------------------------
  -- (3) the constructions from Id, its naturality and refl: the context
  -- of the motive, the centre, the map of motive contexts.  A module (not
  -- derived members of the record), so that an instance names the same
  -- terms: Der[IdT, IdT-nat, rfl].cen is THE centre of the instance.

  module Der (IdT : (G : Ctx) (A : Ty G) (a b : El G A) -> Ty G)
    (IdT-nat : (D G : Ctx) (A : Ty G) (a b : El G A) (s : Sub D G)
       -> Id (Ty D) (subT D G (IdT G A a b) s) (IdT D (subT D G A s) (subt D G A a s) (subt D G A b s)))
    (rfl : (G : Ctx) (A : Ty G) (a : El G A) -> El G (IdT G A a a)) {

    -- Id is a congruence
    idCong (G : Ctx) (A A' : Ty G) (PA : Id (Ty G) A A') (a b : El G A) (a' b' : El G A')
      (Pa : Id (El G A') (subst (Ty G) (El G) A A' PA a) a') (Pb : Id (El G A') (subst (Ty G) (El G) A A' PA b) b')
      : Id (Ty G) (IdT G A a b) (IdT G A' a' b') =
      idJ (Ty G) A
        (\ A2 P2 -> (a2 b2 : El G A2) -> Id (El G A2) (subst (Ty G) (El G) A A2 P2 a) a2 -> Id (El G A2) (subst (Ty G) (El G) A A2 P2 b) b2
           -> Id (Ty G) (IdT G A a b) (IdT G A2 a2 b2))
        (\ a2 b2 Pa2 Pb2 ->
           trans (Ty G) _ (IdT G A a2 b) _
             (ap (El G A) (Ty G) (\ v -> IdT G A v b) a a2 Pa2)
             (ap (El G A) (Ty G) (\ v -> IdT G A a2 v) b b2 Pb2))
        A' PA a' b' Pa Pb ;

    -- the context of the motive
    Ap (G : Ctx) (A : Ty G) : Ty (ext G A) = subT (ext G A) G A (p G A) ;
    ap' (G : Ctx) (A : Ty G) (a : El G A) : El (ext G A) (Ap G A) = subt (ext G A) G A a (p G A) ;
    IK (G : Ctx) (A : Ty G) (a : El G A) : Ty (ext G A) = IdT (ext G A) (Ap G A) (ap' G A a) (q G A) ;
    Dx (G : Ctx) (A : Ty G) (a : El G A) : Ctx = ext (ext G A) (IK G A a) ;

    -- the centre: (sec a , refl a), refl transported along reflT
    reflT (G : Ctx) (A : Ty G) (a : El G A) : Id (Ty G) (subT G (ext G A) (IK G A a) (sec G A a)) (IdT G A a a) =
      trans (Ty G) _ _ (IdT G A a a)
        (IdT-nat G (ext G A) (Ap G A) (ap' G A a) (q G A) (sec G A a))
        (idCong G (subT G (ext G A) (Ap G A) (sec G A a)) A (p-sec-T G A A a)
           (subt G (ext G A) (Ap G A) (ap' G A a) (sec G A a)) (subt G (ext G A) (Ap G A) (q G A) (sec G A a)) a a
           (wk-sec G A A a a) (q-sec G A a)) ;

    reflE (G : Ctx) (A : Ty G) (a : El G A) : El G (subT G (ext G A) (IK G A a) (sec G A a)) =
      subst (Ty G) (El G) (IdT G A a a) (subT G (ext G A) (IK G A a) (sec G A a))
        (sym (Ty G) (subT G (ext G A) (IK G A a) (sec G A a)) (IdT G A a a) (reflT G A a)) (rfl G A a) ;

    cen (G : Ctx) (A : Ty G) (a : El G A) : Sub G (Dx G A a) = extS G (ext G A) (IK G A a) (sec G A a) (reflE G A a) ;

    -- substitution: the map of motive contexts over s
    IKnat (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G)
      : Id (Ty (ext D (subT D G A s))) (subT (ext D (subT D G A s)) (ext G A) (IK G A a) (lift D G A s)) (IK D (subT D G A s) (subt D G A a s)) =
      trans (Ty (ext D (subT D G A s))) _ _ (IK D (subT D G A s) (subt D G A a s))
        (IdT-nat (ext D (subT D G A s)) (ext G A) (Ap G A) (ap' G A a) (q G A) (lift D G A s))
        (idCong (ext D (subT D G A s)) _ (Ap D (subT D G A s)) (p-lift-T D G A A s) _ _ (ap' D (subT D G A s) (subt D G A a s)) (q D (subT D G A s))
           (wk-lift D G A A a s) (q-lift D G A s)) ;

    upS (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) : Sub (Dx D (subT D G A s) (subt D G A a s)) (Dx G A a) =
      subst (Ty (ext D (subT D G A s))) (\ X -> Sub (ext (ext D (subT D G A s)) X) (Dx G A a))
        (subT (ext D (subT D G A s)) (ext G A) (IK G A a) (lift D G A s)) (IK D (subT D G A s) (subt D G A a s)) (IKnat D G A a s)
        (lift (ext D (subT D G A s)) (ext G A) (IK G A a) (lift D G A s)) ;

    -- the centre is stable (a field of the record)
    CenNat (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) : U l =
      Id (Sub D (Dx G A a)) (o D G (Dx G A a) (cen G A a) s)
         (o D (Dx D (subT D G A s) (subt D G A a s)) (Dx G A a) (upS D G A a s) (cen D (subT D G A s) (subt D G A a s))) ;

    -- the motive's type at the centre, after s
    cenT (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (cn : CenNat D G A a s) (CM : Ty (Dx G A a))
      : Id (Ty D) (subT D G (subT G (Dx G A a) CM (cen G A a)) s)
                  (subT D (Dx D (subT D G A s) (subt D G A a s))
                     (subT (Dx D (subT D G A s) (subt D G A a s)) (Dx G A a) CM (upS D G A a s)) (cen D (subT D G A s) (subt D G A a s))) =
      trans (Ty D) _ (subT D (Dx G A a) CM (o D G (Dx G A a) (cen G A a) s)) _
        (sym (Ty D) _ _ (subT-o D G (Dx G A a) CM (cen G A a) s))
        (trans (Ty D) _ (subT D (Dx G A a) CM (o D (Dx D (subT D G A s) (subt D G A a s)) (Dx G A a) (upS D G A a s) (cen D (subT D G A s) (subt D G A a s)))) _
           (ap (Sub D (Dx G A a)) (Ty D) (\ s2 -> subT D (Dx G A a) CM s2) _ _ cn)
           (subT-o D (Dx D (subT D G A s) (subt D G A a s)) (Dx G A a) CM (upS D G A a s) (cen D (subT D G A s) (subt D G A a s)))) ;
  } ;

  ----------------------------------------------------------------------
  -- the record

  record IdJStr {
    IdT (G : Ctx) (A : Ty G) (a b : El G A) : Ty G ;
    IdT-nat (D G : Ctx) (A : Ty G) (a b : El G A) (s : Sub D G)
      : Id (Ty D) (subT D G (IdT G A a b) s) (IdT D (subT D G A s) (subt D G A a s) (subt D G A b s)) ;

    rfl (G : Ctx) (A : Ty G) (a : El G A) : El G (IdT G A a a) ;
    rfl-nat (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G)
      : Id (El D (IdT D (subT D G A s) (subt D G A a s) (subt D G A a s)))
           (subst (Ty D) (El D) (subT D G (IdT G A a a) s) (IdT D (subT D G A s) (subt D G A a s) (subt D G A a s))
                  (IdT-nat D G A a a s) (subt D G (IdT G A a a) (rfl G A a) s))
           (rfl D (subT D G A s) (subt D G A a s)) ;

    -- based J, with its computation rule
    J (G : Ctx) (A : Ty G) (a : El G A) (CM : Ty (Der[IdT, IdT-nat, rfl].Dx G A a))
      (d : El G (subT G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].cen G A a))) : El (Der[IdT, IdT-nat, rfl].Dx G A a) CM ;
    J-beta (G : Ctx) (A : Ty G) (a : El G A) (CM : Ty (Der[IdT, IdT-nat, rfl].Dx G A a))
      (d : El G (subT G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].cen G A a)))
      : Id (El G (subT G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].cen G A a)))
           (subt G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (J G A a CM d) (Der[IdT, IdT-nat, rfl].cen G A a)) d ;

    cen-nat (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) : Der[IdT, IdT-nat, rfl].CenNat D G A a s ;

    J-nat (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (CM : Ty (Der[IdT, IdT-nat, rfl].Dx G A a))
      (d : El G (subT G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].cen G A a)))
      : Id (El (Der[IdT, IdT-nat, rfl].Dx D (subT D G A s) (subt D G A a s))
               (subT (Der[IdT, IdT-nat, rfl].Dx D (subT D G A s) (subt D G A a s)) (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].upS D G A a s)))
           (subt (Der[IdT, IdT-nat, rfl].Dx D (subT D G A s) (subt D G A a s)) (Der[IdT, IdT-nat, rfl].Dx G A a) CM (J G A a CM d)
              (Der[IdT, IdT-nat, rfl].upS D G A a s))
           (J D (subT D G A s) (subt D G A a s)
              (subT (Der[IdT, IdT-nat, rfl].Dx D (subT D G A s) (subt D G A a s)) (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].upS D G A a s))
              (subst (Ty D) (El D)
                 (subT D G (subT G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].cen G A a)) s)
                 (subT D (Der[IdT, IdT-nat, rfl].Dx D (subT D G A s) (subt D G A a s))
                    (subT (Der[IdT, IdT-nat, rfl].Dx D (subT D G A s) (subt D G A a s)) (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].upS D G A a s))
                    (Der[IdT, IdT-nat, rfl].cen D (subT D G A s) (subt D G A a s)))
                 (Der[IdT, IdT-nat, rfl].cenT D G A a s (cen-nat D G A a s) CM)
                 (subt D G (subT G (Der[IdT, IdT-nat, rfl].Dx G A a) CM (Der[IdT, IdT-nat, rfl].cen G A a)) d s))) ;
  } ;
} ;
