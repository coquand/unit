-- CwFRetS.seg (M1 step 3, S4 toolkit): retracts between Sigma types given
-- by substitutions between their two-variable contexts, in a CwF with
-- Pi, Sigma and Swan Id.
--
-- T = Sigma X P, Q = Sigma Y P' over G; E2T = G.X.P, E2Q = G.Y.P' with
-- the pairs of the variables pvT, pvQ (CwFSig).  A map T -> Q is a
-- substitution sg : E2T -> E2Q over G (ppQ sg = ppT).
--
-- Informal text.  Given sg : E2T -> E2Q, tu : E2Q -> E2T over G and
-- H : Id(pvT along tu sg , pvT) over E2T, T is a retract of Q (CwFRet):
--   sm = (pvQ along sg) along unpkT,   rm = (pvT along tu) along unpkQ.
-- The composite rs is pvT along tu sg unpkT: the map (p , sm) is
-- (ppQ , pvQ) after sg unpkT (extS-o), and unpkQ after (ppQ , pvQ) is the
-- identity (CwFSig.UP).  H along unpkT is then Id(rs , q).

open Base ;

module RetS (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module RT = CwFRet.Ret[l, C, PS, SS, IJ] ;

  -- an element along a map whose composite with pp is known, read there
  alongT (D E G : Ctx) (Z : Ty G) (pZ : Sub E G) (z : El E (subT E G Z pZ)) (r : Sub D E) (t : Sub D G) (er : Id (Sub D G) (o D E G pZ r) t)
    : El D (subT D G Z t) =
    trE D (subT D E (subT E G Z pZ) r) (subT D G Z t)
      (trans (Ty D) (subT D E (subT E G Z pZ) r) (subT D G Z (o D E G pZ r)) (subT D G Z t)
         (sym (Ty D) (subT D G Z (o D E G pZ r)) (subT D E (subT E G Z pZ) r) (subT-o D E G Z pZ r))
         (ap (Sub D G) (Ty D) (\ u -> subT D G Z u) (o D E G pZ r) t er))
      (subt D E (subT E G Z pZ) z r) ;

  teAlong (D E G : Ctx) (Z : Ty G) (pZ : Sub E G) (z : El E (subT E G Z pZ)) (r : Sub D E) (t : Sub D G) (er : Id (Sub D G) (o D E G pZ r) t)
    : IN.TE D (subT D E (subT E G Z pZ) r) (subT D G Z t) (subt D E (subT E G Z pZ) z r) (alongT D E G Z pZ z r t er) =
    IN.teTr D (subT D E (subT E G Z pZ) r) (subT D G Z t)
      (trans (Ty D) (subT D E (subT E G Z pZ) r) (subT D G Z (o D E G pZ r)) (subT D G Z t)
         (sym (Ty D) (subT D G Z (o D E G pZ r)) (subT D E (subT E G Z pZ) r) (subT-o D E G Z pZ r))
         (ap (Sub D G) (Ty D) (\ u -> subT D G Z u) (o D E G pZ r) t er))
      (subt D E (subT E G Z pZ) z r) ;

  module R (G : Ctx) (X : Ty G) (P : Ty (ext G X)) (Y : Ty G) (P' : Ty (ext G Y)) {
    module VT = SV.At[G, X, P] ;
    module VQ = SV.At[G, Y, P'] ;
    T : Ty G = VT.S ;
    Q : Ty G = VQ.S ;
    ET : Ctx = VT.E2 ;
    EQ2 : Ctx = VQ.E2 ;
    ST : Ctx = ext G T ;
    SQ : Ctx = ext G Q ;

    module M (sg : Sub ET EQ2) (esg : Id (Sub ET G) (o ET EQ2 G VQ.pp sg) VT.pp)
             (tu : Sub EQ2 ET) (etu : Id (Sub EQ2 G) (o EQ2 ET G VT.pp tu) VQ.pp) {

      smE : El ET (subT ET G Q VT.pp) = alongT ET EQ2 G Q VQ.pp VQ.pv sg VT.pp esg ;
      sm : El ST (wkT G T Q) = alongT ST ET G Q VT.pp smE VT.unpk (p G T) VT.pp-unpk ;
      rmE : El EQ2 (subT EQ2 G T VQ.pp) = alongT EQ2 ET G T VT.pp VT.pv tu VQ.pp etu ;
      rm : El SQ (wkT G Q T) = alongT SQ EQ2 G T VQ.pp rmE VQ.unpk (p G Q) VQ.pp-unpk ;

      module RR = RT.R[G, T, Q, sm, rm] ;

      -- the composite map to G
      su : Sub ST EQ2 = o ST ET EQ2 sg VT.unpk ;
      esu : Id (Sub ST G) (o ST EQ2 G VQ.pp su) (p G T) =
        calc (Sub ST G) {
            o ST EQ2 G VQ.pp (o ST ET EQ2 sg VT.unpk)
          =< sym (Sub ST G) (o ST ET G (o ET EQ2 G VQ.pp sg) VT.unpk) (o ST EQ2 G VQ.pp (o ST ET EQ2 sg VT.unpk)) (o-assoc ST ET EQ2 G VQ.pp sg VT.unpk) >
            o ST ET G (o ET EQ2 G VQ.pp sg) VT.unpk
          =< ap (Sub ET G) (Sub ST G) (\ u -> o ST ET G u VT.unpk) (o ET EQ2 G VQ.pp sg) VT.pp esg >
            o ST ET G VT.pp VT.unpk
          =< VT.pp-unpk >
            p G T } ;

      -- (p , sm) is (ppQ , pvQ) along su
      pvsu : El ST (subT ST G Q (o ST EQ2 G VQ.pp su)) =
        trE ST (subT ST EQ2 VQ.SW su) (subT ST G Q (o ST EQ2 G VQ.pp su))
          (sym (Ty ST) (subT ST G Q (o ST EQ2 G VQ.pp su)) (subT ST EQ2 VQ.SW su) (subT-o ST EQ2 G Q VQ.pp su))
          (subt ST EQ2 VQ.SW VQ.pv su) ;

      eSg : Id (Sub ST SQ) RR.sgm (extS ST G Q (o ST EQ2 G VQ.pp su) pvsu) =
        IN.extS-cong ST G Q (p G T) (o ST EQ2 G VQ.pp su) (sym (Sub ST G) (o ST EQ2 G VQ.pp su) (p G T) esu) sm pvsu
          (IN.teAny ST (wkT G T Q) (subT ST G Q (o ST EQ2 G VQ.pp su)) sm pvsu
             (IN.teT ST (wkT G T Q) (subT ST ET (subT ET G Q VT.pp) VT.unpk) (subT ST G Q (o ST EQ2 G VQ.pp su)) sm (subt ST ET (subT ET G Q VT.pp) smE VT.unpk) pvsu
                (IN.teS ST (subT ST ET (subT ET G Q VT.pp) VT.unpk) (wkT G T Q) (subt ST ET (subT ET G Q VT.pp) smE VT.unpk) sm
                   (teAlong ST ET G Q VT.pp smE VT.unpk (p G T) VT.pp-unpk))
                (IN.teT ST (subT ST ET (subT ET G Q VT.pp) VT.unpk) (subT ST ET (subT ET EQ2 VQ.SW sg) VT.unpk) (subT ST G Q (o ST EQ2 G VQ.pp su))
                   (subt ST ET (subT ET G Q VT.pp) smE VT.unpk) (subt ST ET (subT ET EQ2 VQ.SW sg) (subt ET EQ2 VQ.SW VQ.pv sg) VT.unpk) pvsu
                   (IN.teS ST (subT ST ET (subT ET EQ2 VQ.SW sg) VT.unpk) (subT ST ET (subT ET G Q VT.pp) VT.unpk)
                      (subt ST ET (subT ET EQ2 VQ.SW sg) (subt ET EQ2 VQ.SW VQ.pv sg) VT.unpk) (subt ST ET (subT ET G Q VT.pp) smE VT.unpk)
                      (SV.teSub ST ET (subT ET EQ2 VQ.SW sg) (subT ET G Q VT.pp) (subt ET EQ2 VQ.SW VQ.pv sg) smE
                         (teAlong ET EQ2 G Q VQ.pp VQ.pv sg VT.pp esg) VT.unpk))
                   (IN.teT ST (subT ST ET (subT ET EQ2 VQ.SW sg) VT.unpk) (subT ST EQ2 VQ.SW su) (subT ST G Q (o ST EQ2 G VQ.pp su))
                      (subt ST ET (subT ET EQ2 VQ.SW sg) (subt ET EQ2 VQ.SW VQ.pv sg) VT.unpk) (subt ST EQ2 VQ.SW VQ.pv su) pvsu
                      (IN.teS ST (subT ST EQ2 VQ.SW su) (subT ST ET (subT ET EQ2 VQ.SW sg) VT.unpk)
                         (subt ST EQ2 VQ.SW VQ.pv su) (subt ST ET (subT ET EQ2 VQ.SW sg) (subt ET EQ2 VQ.SW VQ.pv sg) VT.unpk)
                         (IN.teSubtO ST ET EQ2 VQ.SW VQ.pv sg VT.unpk))
                      (IN.teTr ST (subT ST EQ2 VQ.SW su) (subT ST G Q (o ST EQ2 G VQ.pp su))
                         (sym (Ty ST) (subT ST G Q (o ST EQ2 G VQ.pp su)) (subT ST EQ2 VQ.SW su) (subT-o ST EQ2 G Q VQ.pp su))
                         (subt ST EQ2 VQ.SW VQ.pv su)))))
             (ap (Sub ST G) (Ty ST) (\ u -> subT ST G Q u) (p G T) (o ST EQ2 G VQ.pp su) (sym (Sub ST G) (o ST EQ2 G VQ.pp su) (p G T) esu))) ;

      eU : Id (Sub ST EQ2) (o ST SQ EQ2 VQ.unpk RR.sgm) su =
        trans (Sub ST EQ2) (o ST SQ EQ2 VQ.unpk RR.sgm) (o ST SQ EQ2 VQ.unpk (extS ST G Q (o ST EQ2 G VQ.pp su) pvsu)) su
          (ap (Sub ST SQ) (Sub ST EQ2) (\ u -> o ST SQ EQ2 VQ.unpk u) RR.sgm (extS ST G Q (o ST EQ2 G VQ.pp su) pvsu) eSg)
          (VQ.UP ST su) ;

      -- rs is pvT along tu sg unpkT
      ts : Sub ST ET = o ST EQ2 ET tu su ;

      hrs : IN.TE ST (subT ST ET VT.SW ts) (wkT G T T) (subt ST ET VT.SW VT.pv ts) RR.rs =
        IN.teS ST (wkT G T T) (subT ST ET VT.SW ts) RR.rs (subt ST ET VT.SW VT.pv ts)
          (IN.teT ST (wkT G T T) (subT ST SQ (wkT G Q T) RR.sgm) (subT ST ET VT.SW ts) RR.rs (subt ST SQ (wkT G Q T) rm RR.sgm) (subt ST ET VT.SW VT.pv ts)
             (IN.teS ST (subT ST SQ (wkT G Q T) RR.sgm) (wkT G T T) (subt ST SQ (wkT G Q T) rm RR.sgm) RR.rs
                (IN.teTr ST (subT ST SQ (wkT G Q T) RR.sgm) (wkT G T T) RR.PRS (subt ST SQ (wkT G Q T) rm RR.sgm)))
             (IN.teT ST (subT ST SQ (wkT G Q T) RR.sgm) (subT ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) RR.sgm) (subT ST ET VT.SW ts)
                (subt ST SQ (wkT G Q T) rm RR.sgm) (subt ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) (subt SQ EQ2 (subT EQ2 G T VQ.pp) rmE VQ.unpk) RR.sgm)
                (subt ST ET VT.SW VT.pv ts)
                (IN.teS ST (subT ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) RR.sgm) (subT ST SQ (wkT G Q T) RR.sgm)
                   (subt ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) (subt SQ EQ2 (subT EQ2 G T VQ.pp) rmE VQ.unpk) RR.sgm) (subt ST SQ (wkT G Q T) rm RR.sgm)
                   (SV.teSub ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) (wkT G Q T) (subt SQ EQ2 (subT EQ2 G T VQ.pp) rmE VQ.unpk) rm
                      (teAlong SQ EQ2 G T VQ.pp rmE VQ.unpk (p G Q) VQ.pp-unpk) RR.sgm))
                (IN.teT ST (subT ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) RR.sgm) (subT ST EQ2 (subT EQ2 G T VQ.pp) (o ST SQ EQ2 VQ.unpk RR.sgm))
                   (subT ST ET VT.SW ts)
                   (subt ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) (subt SQ EQ2 (subT EQ2 G T VQ.pp) rmE VQ.unpk) RR.sgm)
                   (subt ST EQ2 (subT EQ2 G T VQ.pp) rmE (o ST SQ EQ2 VQ.unpk RR.sgm)) (subt ST ET VT.SW VT.pv ts)
                   (IN.teS ST (subT ST EQ2 (subT EQ2 G T VQ.pp) (o ST SQ EQ2 VQ.unpk RR.sgm)) (subT ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) RR.sgm)
                      (subt ST EQ2 (subT EQ2 G T VQ.pp) rmE (o ST SQ EQ2 VQ.unpk RR.sgm))
                      (subt ST SQ (subT SQ EQ2 (subT EQ2 G T VQ.pp) VQ.unpk) (subt SQ EQ2 (subT EQ2 G T VQ.pp) rmE VQ.unpk) RR.sgm)
                      (IN.teSubtO ST SQ EQ2 (subT EQ2 G T VQ.pp) rmE VQ.unpk RR.sgm))
                   (IN.teT ST (subT ST EQ2 (subT EQ2 G T VQ.pp) (o ST SQ EQ2 VQ.unpk RR.sgm)) (subT ST EQ2 (subT EQ2 G T VQ.pp) su) (subT ST ET VT.SW ts)
                      (subt ST EQ2 (subT EQ2 G T VQ.pp) rmE (o ST SQ EQ2 VQ.unpk RR.sgm)) (subt ST EQ2 (subT EQ2 G T VQ.pp) rmE su) (subt ST ET VT.SW VT.pv ts)
                      (IN.teSubEq ST EQ2 (subT EQ2 G T VQ.pp) rmE (o ST SQ EQ2 VQ.unpk RR.sgm) su eU)
                      (IN.teT ST (subT ST EQ2 (subT EQ2 G T VQ.pp) su) (subT ST EQ2 (subT EQ2 ET VT.SW tu) su) (subT ST ET VT.SW ts)
                         (subt ST EQ2 (subT EQ2 G T VQ.pp) rmE su) (subt ST EQ2 (subT EQ2 ET VT.SW tu) (subt EQ2 ET VT.SW VT.pv tu) su) (subt ST ET VT.SW VT.pv ts)
                         (IN.teS ST (subT ST EQ2 (subT EQ2 ET VT.SW tu) su) (subT ST EQ2 (subT EQ2 G T VQ.pp) su)
                            (subt ST EQ2 (subT EQ2 ET VT.SW tu) (subt EQ2 ET VT.SW VT.pv tu) su) (subt ST EQ2 (subT EQ2 G T VQ.pp) rmE su)
                            (SV.teSub ST EQ2 (subT EQ2 ET VT.SW tu) (subT EQ2 G T VQ.pp) (subt EQ2 ET VT.SW VT.pv tu) rmE
                               (teAlong EQ2 ET G T VT.pp VT.pv tu VQ.pp etu) su))
                         (IN.teS ST (subT ST ET VT.SW ts) (subT ST EQ2 (subT EQ2 ET VT.SW tu) su)
                            (subt ST ET VT.SW VT.pv ts) (subt ST EQ2 (subT EQ2 ET VT.SW tu) (subt EQ2 ET VT.SW VT.pv tu) su)
                            (IN.teSubtO ST EQ2 ET VT.SW VT.pv tu su))))))) ;

      -- the homotopy, from H along unpkT
      ets : Id (Sub ET G) (o ET ET G VT.pp (o ET EQ2 ET tu sg)) VT.pp =
        calc (Sub ET G) {
            o ET ET G VT.pp (o ET EQ2 ET tu sg)
          =< sym (Sub ET G) (o ET EQ2 G (o EQ2 ET G VT.pp tu) sg) (o ET ET G VT.pp (o ET EQ2 ET tu sg)) (o-assoc ET EQ2 ET G VT.pp tu sg) >
            o ET EQ2 G (o EQ2 ET G VT.pp tu) sg
          =< ap (Sub EQ2 G) (Sub ET G) (\ u -> o ET EQ2 G u sg) (o EQ2 ET G VT.pp tu) VQ.pp etu >
            o ET EQ2 G VQ.pp sg
          =< esg >
            VT.pp } ;

      LH : El ET VT.SW = alongT ET ET G T VT.pp VT.pv (o ET EQ2 ET tu sg) VT.pp ets ;

      module HM (H : El ET (IJ.IdT ET VT.SW LH VT.pv)) {
        Pl : Ov ST ET VT.SW VT.unpk (wkT G T T) VT.PU LH RR.rs =
          IN.teAny ST (subT ST ET VT.SW VT.unpk) (wkT G T T) (subt ST ET VT.SW LH VT.unpk) RR.rs
            (IN.teT ST (subT ST ET VT.SW VT.unpk) (subT ST ET VT.SW ts) (wkT G T T) (subt ST ET VT.SW LH VT.unpk) (subt ST ET VT.SW VT.pv ts) RR.rs
               (IN.teT ST (subT ST ET VT.SW VT.unpk) (subT ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) VT.unpk) (subT ST ET VT.SW ts)
                  (subt ST ET VT.SW LH VT.unpk) (subt ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) (subt ET ET VT.SW VT.pv (o ET EQ2 ET tu sg)) VT.unpk) (subt ST ET VT.SW VT.pv ts)
                  (IN.teS ST (subT ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) VT.unpk) (subT ST ET VT.SW VT.unpk)
                     (subt ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) (subt ET ET VT.SW VT.pv (o ET EQ2 ET tu sg)) VT.unpk) (subt ST ET VT.SW LH VT.unpk)
                     (SV.teSub ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) VT.SW (subt ET ET VT.SW VT.pv (o ET EQ2 ET tu sg)) LH
                        (teAlong ET ET G T VT.pp VT.pv (o ET EQ2 ET tu sg) VT.pp ets) VT.unpk))
                  (IN.teT ST (subT ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) VT.unpk) (subT ST ET VT.SW (o ST ET ET (o ET EQ2 ET tu sg) VT.unpk)) (subT ST ET VT.SW ts)
                     (subt ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) (subt ET ET VT.SW VT.pv (o ET EQ2 ET tu sg)) VT.unpk)
                     (subt ST ET VT.SW VT.pv (o ST ET ET (o ET EQ2 ET tu sg) VT.unpk)) (subt ST ET VT.SW VT.pv ts)
                     (IN.teS ST (subT ST ET VT.SW (o ST ET ET (o ET EQ2 ET tu sg) VT.unpk)) (subT ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) VT.unpk)
                        (subt ST ET VT.SW VT.pv (o ST ET ET (o ET EQ2 ET tu sg) VT.unpk))
                        (subt ST ET (subT ET ET VT.SW (o ET EQ2 ET tu sg)) (subt ET ET VT.SW VT.pv (o ET EQ2 ET tu sg)) VT.unpk)
                        (IN.teSubtO ST ET ET VT.SW VT.pv (o ET EQ2 ET tu sg) VT.unpk))
                     (IN.teSubEq ST ET VT.SW VT.pv (o ST ET ET (o ET EQ2 ET tu sg) VT.unpk) ts (o-assoc ST ET EQ2 ET tu sg VT.unpk))))
               hrs)
            VT.PU ;

        hm : El ST (IJ.IdT ST (wkT G T T) RR.rs (q G T)) =
          trE ST (subT ST ET (IJ.IdT ET VT.SW LH VT.pv) VT.unpk) (IJ.IdT ST (wkT G T T) RR.rs (q G T))
            (Id-ov ST ET VT.SW LH VT.pv VT.unpk (wkT G T T) VT.PU RR.rs (q G T) Pl VT.pv-unpk)
            (subt ST ET (IJ.IdT ET VT.SW LH VT.pv) H VT.unpk) ;

        retE (kQ : El G (EQ.isContr G Q)) : El G (EQ.isContr G T) = RT.retC G T Q sm rm hm kQ ;
      } ;
    } ;
  } ;
} ;
