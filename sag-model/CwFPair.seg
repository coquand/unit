-- CwFPair.seg (M1 step 3, S4 toolkit): pairs and projections of a Sigma
-- type at points, and their naturality, in a CwF with Pi, Sigma, Swan Id.
--
-- For S = Sigma A B over G and a point t : D -> G, an element of S[t] is a
-- pair (a : A[t] , b : B[(t , a)]):
--   pSt t a b,  fstS t w,  sndS t w,
-- with the laws fst-pS, snd-pS, pS-eta (Sig-iso), and their naturality
-- along r : D' -> D (the point t r): fstS-nat, sndS-nat, pS-nat, each a TE
-- (CwFInt), proved once by fst-ov, snd-ov, pr-ov with the type paths of
-- CwFSig (liftComp, upSec, coerce).

open Base ;

module PairAt (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;

  module At (G : Ctx) (A : Ty G) (B : Ty (ext G A)) {
    S : Ty G = SS.Sig G A B ;

    At' (D : Ctx) (t : Sub D G) : Ty D = subT D G A t ;
    Bt (D : Ctx) (t : Sub D G) : Ty (ext D (subT D G A t)) = subT (ext D (subT D G A t)) (ext G A) B (lift D G A t) ;
    SN (D : Ctx) (t : Sub D G) : Id (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) = SS.Sig-nat D G A B t ;
    Bp (D : Ctx) (t : Sub D G) (a : El D (subT D G A t)) : Ty D = subT D (ext G A) B (extS D G A t a) ;
    So (D : Ctx) (t : Sub D G) (a : El D (subT D G A t)) : Id (Ty D) (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) =
      subT-o D (ext D (At' D t)) (ext G A) B (lift D G A t) (sec D (At' D t) a) ;

    pSt (D : Ctx) (t : Sub D G) (a : El D (subT D G A t)) (b : El D (Bp D t a)) : El D (subT D G S t) =
      trE D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t))
        (IN.pr D (At' D t) (Bt D t) a (trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b)) ;

    wS (D : Ctx) (t : Sub D G) (w : El D (subT D G S t)) : El D (SS.Sig D (At' D t) (Bt D t)) =
      trE D (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t) w ;

    fstS (D : Ctx) (t : Sub D G) (w : El D (subT D G S t)) : El D (subT D G A t) = IN.fst D (At' D t) (Bt D t) (wS D t w) ;

    sndS (D : Ctx) (t : Sub D G) (w : El D (subT D G S t)) : El D (Bp D t (fstS D t w)) =
      trE D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (Bp D t (fstS D t w))
        (sym (Ty D) (Bp D t (fstS D t w)) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (So D t (fstS D t w)))
        (IN.snd D (At' D t) (Bt D t) (wS D t w)) ;

    ----------------------------------------------------------------------
    -- the laws

    wS-pS (D : Ctx) (t : Sub D G) (a : El D (subT D G A t)) (b : El D (Bp D t a))
      : Id (El D (SS.Sig D (At' D t) (Bt D t))) (wS D t (pSt D t a b))
           (IN.pr D (At' D t) (Bt D t) a (trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b)) =
      CwFJ.JPt[l, C, PS, SS, IJ].trE-sym D (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t)
        (IN.pr D (At' D t) (Bt D t) a (trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b)) ;

    fst-pS (D : Ctx) (t : Sub D G) (a : El D (subT D G A t)) (b : El D (Bp D t a))
      : Id (El D (subT D G A t)) (fstS D t (pSt D t a b)) a =
      trans (El D (subT D G A t)) (fstS D t (pSt D t a b))
        (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a (trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b))) a
        (ap (El D (SS.Sig D (At' D t) (Bt D t))) (El D (subT D G A t)) (\ v -> IN.fst D (At' D t) (Bt D t) v) (wS D t (pSt D t a b))
            (IN.pr D (At' D t) (Bt D t) a (trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b)) (wS-pS D t a b))
        (IN.fst-pr D (At' D t) (Bt D t) a (trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b)) ;

    pS-eta (D : Ctx) (t : Sub D G) (w : El D (subT D G S t)) : Id (El D (subT D G S t)) (pSt D t (fstS D t w) (sndS D t w)) w =
      calc (El D (subT D G S t)) {
          trE D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t))
            (IN.pr D (At' D t) (Bt D t) (fstS D t w) (trE D (Bp D t (fstS D t w)) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (So D t (fstS D t w)) (sndS D t w)))
        =< ap (El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w)))) (El D (subT D G S t))
              (\ v -> trE D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t)) (IN.pr D (At' D t) (Bt D t) (fstS D t w) v))
              (trE D (Bp D t (fstS D t w)) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (So D t (fstS D t w)) (sndS D t w))
              (IN.snd D (At' D t) (Bt D t) (wS D t w))
              (CwFJ.JPt[l, C, PS, SS, IJ].trE-sym D (Bp D t (fstS D t w)) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (So D t (fstS D t w)) (IN.snd D (At' D t) (Bt D t) (wS D t w))) >
          trE D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t)) (IN.pr D (At' D t) (Bt D t) (fstS D t w) (IN.snd D (At' D t) (Bt D t) (wS D t w)))
        =< ap (El D (SS.Sig D (At' D t) (Bt D t))) (El D (subT D G S t))
              (\ v -> trE D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t)) v)
              (IN.pr D (At' D t) (Bt D t) (fstS D t w) (IN.snd D (At' D t) (Bt D t) (wS D t w))) (wS D t w) ((SS.Sig-iso D (At' D t) (Bt D t)).inv-fun (wS D t w)) >
          trE D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t)) (wS D t w)
        =< IN.trE-symL D (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t) w >
          w } ;

    snd-pS (D : Ctx) (t : Sub D G) (a : El D (subT D G A t)) (b : El D (Bp D t a))
      : IN.TE D (Bp D t (fstS D t (pSt D t a b))) (Bp D t a) (sndS D t (pSt D t a b)) b =
      IN.teT D (Bp D t (fstS D t (pSt D t a b))) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t (pSt D t a b)))) (Bp D t a)
        (sndS D t (pSt D t a b)) (IN.snd D (At' D t) (Bt D t) (wS D t (pSt D t a b))) b
        (IN.teS D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t (pSt D t a b)))) (Bp D t (fstS D t (pSt D t a b)))
           (IN.snd D (At' D t) (Bt D t) (wS D t (pSt D t a b))) (sndS D t (pSt D t a b))
           (IN.teTr D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t (pSt D t a b)))) (Bp D t (fstS D t (pSt D t a b)))
              (sym (Ty D) (Bp D t (fstS D t (pSt D t a b))) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t (pSt D t a b)))) (So D t (fstS D t (pSt D t a b))))
              (IN.snd D (At' D t) (Bt D t) (wS D t (pSt D t a b)))))
        (IN.teT D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t (pSt D t a b)))) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (Bp D t a)
           (IN.snd D (At' D t) (Bt D t) (wS D t (pSt D t a b))) bb b
           (idJ (El D (SS.Sig D (At' D t) (Bt D t))) (IN.pr D (At' D t) (Bt D t) a bb)
              (\ w2 e2 -> IN.TE D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (IN.fst D (At' D t) (Bt D t) w2))) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a))
                             (IN.snd D (At' D t) (Bt D t) w2) bb)
              (ap (El D (At' D t)) (Ty D) (\ x -> subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) x)) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)) a
                  (IN.fst-pr D (At' D t) (Bt D t) a bb),
               trans (El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)))
                 (trE D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)))) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a))
                    (ap (El D (At' D t)) (Ty D) (\ x -> subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) x)) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)) a (IN.fst-pr D (At' D t) (Bt D t) a bb))
                    (IN.snd D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)))
                 (subst (El D (At' D t)) (\ x2 -> El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) x2))) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)) a
                    (IN.fst-pr D (At' D t) (Bt D t) a bb) (IN.snd D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)))
                 bb
                 (sym (El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)))
                    (subst (El D (At' D t)) (\ x2 -> El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) x2))) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)) a
                       (IN.fst-pr D (At' D t) (Bt D t) a bb) (IN.snd D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)))
                    (trE D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)))) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a))
                       (ap (El D (At' D t)) (Ty D) (\ x -> subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) x)) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)) a (IN.fst-pr D (At' D t) (Bt D t) a bb))
                       (IN.snd D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)))
                    (SV.substEl D (At' D t) (\ x -> subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) x)) (IN.fst D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb)) a
                       (IN.fst-pr D (At' D t) (Bt D t) a bb) (IN.snd D (At' D t) (Bt D t) (IN.pr D (At' D t) (Bt D t) a bb))))
                 (IN.snd-pr D (At' D t) (Bt D t) a bb))
              (wS D t (pSt D t a b))
              (sym (El D (SS.Sig D (At' D t) (Bt D t))) (wS D t (pSt D t a b)) (IN.pr D (At' D t) (Bt D t) a bb) (wS-pS D t a b)))
           (IN.teS D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) b bb (IN.teTr D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b)))
     where {
      bb : El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) = trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b ;
     } ;

    ----------------------------------------------------------------------
    -- naturality along r : D' -> D

    module Nat (D' D : Ctx) (t : Sub D G) (r : Sub D' D) {
      tr : Sub D' G = o D' D G t r ;
      PA : Id (Ty D') (subT D' D (subT D G A t) r) (subT D' G A tr) = sym (Ty D') (subT D' G A tr) (subT D' D (subT D G A t) r) (subT-o D' D G A t r) ;
      PSr : Id (Ty D') (subT D' D (subT D G S t) r) (subT D' G S tr) = sym (Ty D') (subT D' G S tr) (subT D' D (subT D G S t) r) (subT-o D' D G S t r) ;
      wr (w : El D (subT D G S t)) : El D' (subT D' G S tr) = trE D' (subT D' D (subT D G S t) r) (subT D' G S tr) PSr (subt D' D (subT D G S t) w r) ;
      ar (a : El D (subT D G A t)) : El D' (subT D' G A tr) = trE D' (subT D' D (subT D G A t) r) (subT D' G A tr) PA (subt D' D (subT D G A t) a r) ;

      PB : Id (Ty (ext D' (At' D' tr))) (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA)) (Bt D' tr) =
        trans (Ty (ext D' (At' D' tr))) (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA))
          (subT (ext D' (At' D' tr)) (ext G A) B (o (ext D' (At' D' tr)) (ext D (At' D t)) (ext G A) (lift D G A t) (upT D' D (At' D t) r (At' D' tr) PA))) (Bt D' tr)
          (sym (Ty (ext D' (At' D' tr))) (subT (ext D' (At' D' tr)) (ext G A) B (o (ext D' (At' D' tr)) (ext D (At' D t)) (ext G A) (lift D G A t) (upT D' D (At' D t) r (At' D' tr) PA)))
             (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA))
             (subT-o (ext D' (At' D' tr)) (ext D (At' D t)) (ext G A) B (lift D G A t) (upT D' D (At' D t) r (At' D' tr) PA)))
          (ap (Sub (ext D' (At' D' tr)) (ext G A)) (Ty (ext D' (At' D' tr))) (\ u -> subT (ext D' (At' D' tr)) (ext G A) B u)
              (o (ext D' (At' D' tr)) (ext D (At' D t)) (ext G A) (lift D G A t) (upT D' D (At' D t) r (At' D' tr) PA)) (lift D' G A tr)
              (SV.liftComp D' D G A t r tr (refl tr) PA)) ;

      PW : Id (Ty D') (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (SS.Sig D' (At' D' tr) (Bt D' tr)) =
        Sig-ov D' D (At' D t) (Bt D t) r (At' D' tr) PA (Bt D' tr) PB ;

      Pw (w : El D (subT D G S t)) : Ov D' D (SS.Sig D (At' D t) (Bt D t)) r (SS.Sig D' (At' D' tr) (Bt D' tr)) PW (wS D t w) (wS D' tr (wr w)) =
        IN.teAny D' (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (SS.Sig D' (At' D' tr) (Bt D' tr)) (subt D' D (SS.Sig D (At' D t) (Bt D t)) (wS D t w) r) (wS D' tr (wr w))
          (IN.teT D' (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (subT D' D (subT D G S t) r) (SS.Sig D' (At' D' tr) (Bt D' tr))
             (subt D' D (SS.Sig D (At' D t) (Bt D t)) (wS D t w) r) (subt D' D (subT D G S t) w r) (wS D' tr (wr w))
             (IN.teS D' (subT D' D (subT D G S t) r) (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (subt D' D (subT D G S t) w r) (subt D' D (SS.Sig D (At' D t) (Bt D t)) (wS D t w) r)
                (IN.teSubtTr D' D (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t) w r))
             (IN.teT D' (subT D' D (subT D G S t) r) (subT D' G S tr) (SS.Sig D' (At' D' tr) (Bt D' tr)) (subt D' D (subT D G S t) w r) (wr w) (wS D' tr (wr w))
                (IN.teTr D' (subT D' D (subT D G S t) r) (subT D' G S tr) PSr (subt D' D (subT D G S t) w r))
                (IN.teTr D' (subT D' G S tr) (SS.Sig D' (At' D' tr) (Bt D' tr)) (SN D' tr) (wr w))))
          PW ;

      FA (w : El D (subT D G S t)) : Ov D' D (At' D t) r (At' D' tr) PA (fstS D t w) (fstS D' tr (wr w)) =
        IN.fst-ov D' D (At' D t) (Bt D t) r (At' D' tr) PA (Bt D' tr) PB PW (wS D t w) (wS D' tr (wr w)) (Pw w) ;

      fstS-nat (w : El D (subT D G S t)) : IN.TE D' (subT D' D (subT D G A t) r) (subT D' G A tr) (subt D' D (subT D G A t) (fstS D t w) r) (fstS D' tr (wr w)) =
        IN.teOv D' D (At' D t) r (At' D' tr) PA (fstS D t w) (fstS D' tr (wr w)) (FA w) ;

      -- the type of the second component, along r
      PS2 (w : El D (subT D G S t))
        : Id (Ty D') (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) r)
             (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w)))) =
        trans (Ty D') (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) r)
          (subT D' (ext D' (subT D' D (At' D t) r)) (subT (ext D' (subT D' D (At' D t) r)) (ext D (At' D t)) (Bt D t) (lift D' D (At' D t) r)) (sec D' (subT D' D (At' D t) r) (subt D' D (At' D t) (fstS D t w) r)))
          (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w))))
          (CwF.Formers[l, C].coerce D' D (At' D t) (Bt D t) (fstS D t w) r)
          (trans (Ty D')
             (subT D' (ext D' (subT D' D (At' D t) r)) (subT (ext D' (subT D' D (At' D t) r)) (ext D (At' D t)) (Bt D t) (lift D' D (At' D t) r)) (sec D' (subT D' D (At' D t) r) (subt D' D (At' D t) (fstS D t w) r)))
             (subT D' (ext D' (At' D' tr)) (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA)) (sec D' (At' D' tr) (trE D' (subT D' D (At' D t) r) (At' D' tr) PA (subt D' D (At' D t) (fstS D t w) r))))
             (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w))))
             (SV.upSec D' D (At' D t) r (At' D' tr) PA (Bt D t) (subt D' D (At' D t) (fstS D t w) r))
             (trans (Ty D')
                (subT D' (ext D' (At' D' tr)) (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA)) (sec D' (At' D' tr) (trE D' (subT D' D (At' D t) r) (At' D' tr) PA (subt D' D (At' D t) (fstS D t w) r))))
                (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (trE D' (subT D' D (At' D t) r) (At' D' tr) PA (subt D' D (At' D t) (fstS D t w) r))))
                (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w))))
                (ap (Ty (ext D' (At' D' tr))) (Ty D') (\ Z -> subT D' (ext D' (At' D' tr)) Z (sec D' (At' D' tr) (trE D' (subT D' D (At' D t) r) (At' D' tr) PA (subt D' D (At' D t) (fstS D t w) r))))
                    (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA)) (Bt D' tr) PB)
                (ap (El D' (At' D' tr)) (Ty D') (\ x -> subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) x))
                    (trE D' (subT D' D (At' D t) r) (At' D' tr) PA (subt D' D (At' D t) (fstS D t w) r)) (fstS D' tr (wr w)) (FA w)))) ;

      sndS-nat (w : El D (subT D G S t))
        : IN.TE D' (subT D' D (Bp D t (fstS D t w)) r) (Bp D' tr (fstS D' tr (wr w))) (subt D' D (Bp D t (fstS D t w)) (sndS D t w) r) (sndS D' tr (wr w)) =
        IN.teT D' (subT D' D (Bp D t (fstS D t w)) r) (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) r) (Bp D' tr (fstS D' tr (wr w)))
          (subt D' D (Bp D t (fstS D t w)) (sndS D t w) r) (subt D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (IN.snd D (At' D t) (Bt D t) (wS D t w)) r)
          (sndS D' tr (wr w))
          (IN.teS D' (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) r) (subT D' D (Bp D t (fstS D t w)) r)
             (subt D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (IN.snd D (At' D t) (Bt D t) (wS D t w)) r) (subt D' D (Bp D t (fstS D t w)) (sndS D t w) r)
             (IN.teSubtTr D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (Bp D t (fstS D t w))
                (sym (Ty D) (Bp D t (fstS D t w)) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (So D t (fstS D t w)))
                (IN.snd D (At' D t) (Bt D t) (wS D t w)) r))
          (IN.teT D' (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) r) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w))))
                     (Bp D' tr (fstS D' tr (wr w)))
             (subt D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) (IN.snd D (At' D t) (Bt D t) (wS D t w)) r) (IN.snd D' (At' D' tr) (Bt D' tr) (wS D' tr (wr w)))
             (sndS D' tr (wr w))
             (IN.teOv D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) (fstS D t w))) r (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w)))) (PS2 w)
                (IN.snd D (At' D t) (Bt D t) (wS D t w)) (IN.snd D' (At' D' tr) (Bt D' tr) (wS D' tr (wr w)))
                (IN.snd-ov D' D (At' D t) (Bt D t) r (At' D' tr) PA (Bt D' tr) PB PW (wS D t w) (wS D' tr (wr w)) (Pw w) (PS2 w)))
             (IN.teTr D' (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w)))) (Bp D' tr (fstS D' tr (wr w)))
                (sym (Ty D') (Bp D' tr (fstS D' tr (wr w))) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (fstS D' tr (wr w)))) (So D' tr (fstS D' tr (wr w))))
                (IN.snd D' (At' D' tr) (Bt D' tr) (wS D' tr (wr w))))) ;

      -- pairs along r
      PBr (a : El D (subT D G A t)) : Id (Ty D') (subT D' D (Bp D t a) r) (Bp D' tr (ar a)) =
        trans (Ty D') (subT D' D (Bp D t a) r) (subT D' (ext G A) B (o D' D (ext G A) (extS D G A t a) r)) (Bp D' tr (ar a))
          (sym (Ty D') (subT D' (ext G A) B (o D' D (ext G A) (extS D G A t a) r)) (subT D' D (Bp D t a) r) (subT-o D' D (ext G A) B (extS D G A t a) r))
          (ap (Sub D' (ext G A)) (Ty D') (\ u -> subT D' (ext G A) B u) (o D' D (ext G A) (extS D G A t a) r) (extS D' G A tr (ar a)) (SV.extS-o D' D G A t a r)) ;

      br (a : El D (subT D G A t)) (b : El D (Bp D t a)) : El D' (Bp D' tr (ar a)) =
        trE D' (subT D' D (Bp D t a) r) (Bp D' tr (ar a)) (PBr a) (subt D' D (Bp D t a) b r) ;

      PT (a : El D (subT D G A t))
        : Id (Ty D') (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) r) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a))) =
        trans (Ty D') (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) r)
          (subT D' (ext D' (subT D' D (At' D t) r)) (subT (ext D' (subT D' D (At' D t) r)) (ext D (At' D t)) (Bt D t) (lift D' D (At' D t) r)) (sec D' (subT D' D (At' D t) r) (subt D' D (At' D t) a r)))
          (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a)))
          (CwF.Formers[l, C].coerce D' D (At' D t) (Bt D t) a r)
          (trans (Ty D')
             (subT D' (ext D' (subT D' D (At' D t) r)) (subT (ext D' (subT D' D (At' D t) r)) (ext D (At' D t)) (Bt D t) (lift D' D (At' D t) r)) (sec D' (subT D' D (At' D t) r) (subt D' D (At' D t) a r)))
             (subT D' (ext D' (At' D' tr)) (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA)) (sec D' (At' D' tr) (ar a)))
             (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a)))
             (SV.upSec D' D (At' D t) r (At' D' tr) PA (Bt D t) (subt D' D (At' D t) a r))
             (ap (Ty (ext D' (At' D' tr))) (Ty D') (\ Z -> subT D' (ext D' (At' D' tr)) Z (sec D' (At' D' tr) (ar a)))
                 (subT (ext D' (At' D' tr)) (ext D (At' D t)) (Bt D t) (upT D' D (At' D t) r (At' D' tr) PA)) (Bt D' tr) PB)) ;

      pS-nat (a : El D (subT D G A t)) (b : El D (Bp D t a))
        : IN.TE D' (subT D' D (subT D G S t) r) (subT D' G S tr) (subt D' D (subT D G S t) (pSt D t a b) r) (pSt D' tr (ar a) (br a b)) =
        IN.teT D' (subT D' D (subT D G S t) r) (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (subT D' G S tr)
          (subt D' D (subT D G S t) (pSt D t a b) r) (subt D' D (SS.Sig D (At' D t) (Bt D t)) (IN.pr D (At' D t) (Bt D t) a bb) r) (pSt D' tr (ar a) (br a b))
          (IN.teS D' (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (subT D' D (subT D G S t) r)
             (subt D' D (SS.Sig D (At' D t) (Bt D t)) (IN.pr D (At' D t) (Bt D t) a bb) r) (subt D' D (subT D G S t) (pSt D t a b) r)
             (IN.teSubtTr D' D (SS.Sig D (At' D t) (Bt D t)) (subT D G S t) (sym (Ty D) (subT D G S t) (SS.Sig D (At' D t) (Bt D t)) (SN D t)) (IN.pr D (At' D t) (Bt D t) a bb) r))
          (IN.teT D' (subT D' D (SS.Sig D (At' D t) (Bt D t)) r) (SS.Sig D' (At' D' tr) (Bt D' tr)) (subT D' G S tr)
             (subt D' D (SS.Sig D (At' D t) (Bt D t)) (IN.pr D (At' D t) (Bt D t) a bb) r) (IN.pr D' (At' D' tr) (Bt D' tr) (ar a) bbr) (pSt D' tr (ar a) (br a b))
             (IN.teOv D' D (SS.Sig D (At' D t) (Bt D t)) r (SS.Sig D' (At' D' tr) (Bt D' tr)) PW (IN.pr D (At' D t) (Bt D t) a bb) (IN.pr D' (At' D' tr) (Bt D' tr) (ar a) bbr)
                (IN.pr-ov D' D (At' D t) (Bt D t) r (At' D' tr) PA (Bt D' tr) PB PW a (ar a) (refl (ar a)) bb bbr (PT a)
                   (IN.teAny D' (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) r) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a)))
                      (subt D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) bb r) bbr
                      (IN.teT D' (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) r) (subT D' D (Bp D t a) r) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a)))
                         (subt D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) bb r) (subt D' D (Bp D t a) b r) bbr
                         (IN.teS D' (subT D' D (Bp D t a) r) (subT D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) r) (subt D' D (Bp D t a) b r) (subt D' D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) bb r)
                            (IN.teSubtTr D' D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b r))
                         (IN.teT D' (subT D' D (Bp D t a) r) (Bp D' tr (ar a)) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a)))
                            (subt D' D (Bp D t a) b r) (br a b) bbr
                            (IN.teTr D' (subT D' D (Bp D t a) r) (Bp D' tr (ar a)) (PBr a) (subt D' D (Bp D t a) b r))
                            (IN.teTr D' (Bp D' tr (ar a)) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a))) (So D' tr (ar a)) (br a b))))
                      (PT a))))
             (IN.teTr D' (SS.Sig D' (At' D' tr) (Bt D' tr)) (subT D' G S tr) (sym (Ty D') (subT D' G S tr) (SS.Sig D' (At' D' tr) (Bt D' tr)) (SN D' tr)) (IN.pr D' (At' D' tr) (Bt D' tr) (ar a) bbr)))
       where {
        bb : El D (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) = trE D (Bp D t a) (subT D (ext D (At' D t)) (Bt D t) (sec D (At' D t) a)) (So D t a) b ;
        bbr : El D' (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a))) = trE D' (Bp D' tr (ar a)) (subT D' (ext D' (At' D' tr)) (Bt D' tr) (sec D' (At' D' tr) (ar a))) (So D' tr (ar a)) (br a b) ;
       } ;
    } ;
  } ;
} ;
