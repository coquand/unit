-- PosId.seg (M1, step 2): Swan's identity type on the base PosFull, as
-- core CPosId on the old base.  The cofibrations of M1.md §1 have dependent
-- conjunction (PosCofConj: dconjC, dc-inC, dc-outC), so Id(a , b) is
-- fibrant, equivalent to the path type, and has J with its computation rule.
-- At levels a and a+ (types and the universe).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open PosCofConj[a] ;
module PB = PosFull[a].PB ;

dc : PB.CId[l].DConj = new PB.CId[l].DConj[dconjC, dc-inC, dc-outC] ;
dc1 : PB.CId[l+].DConj = new PB.CId[l+].DConj[dconjC, dc-inC, dc-outC] ;

module IdA (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (a0 b0 : PB.GPre[l].PS.PEl[G, A]) {
  module IFb = PB.CIdFib[l].IdFib[G, A, a0, b0] ;
  module IEq = PB.CIdEquiv[l].IdEquiv[G, A, a0, b0] ;

  -- Id(a , b) is fibrant
  fib (fA : PB.CLine[l].Lines[G, A].Fib) : PB.CLine[l].Lines[G, IFb.IdT].Fib = IFb.fib fA dc ;

  -- the projection to the path type is an equivalence
  equiv (fA : PB.CLine[l].Lines[G, A].Fib)
    : PB.CEquiv[l].EquivOp G IFb.IdT IEq.PF.PathT PB.CId[l].IdOver[G, G, A, IEq.PF.s, IEq.PF.sN, IEq.PF.PE.aE, IEq.PF.PE.bE, IEq.PF.PE.aE-act, IEq.PF.PE.bE-act].proj =
    IEq.equiv fA dc ;
} ;

-- J, with J d (x , a x , refl) = d x
module JA (G : PB.GPre[l].PS.PCtx) (A : PB.GPre[l].PS.PTy[G]) (a0 : PB.GPre[l].PS.PEl[G, A]) {
  module IJ = PB.CIdJ[l].IJ[G, A, a0] ;

  J (C : PB.GPre[l].PS.PTy[IJ.D]) (cC : PB.CLine[l].Lines[IJ.D, C].CompK[e0, e1].Comp)
    (d : PB.GPre[l].PS.PEl[G, PB.GPre[l].PS.subTy G IJ.D C IJ.c]) : PB.GPre[l].PS.PEl[IJ.D, C] = IJ.JJ[C, cC, d].J ;

  beta (C : PB.GPre[l].PS.PTy[IJ.D]) (cC : PB.CLine[l].Lines[IJ.D, C].CompK[e0, e1].Comp)
    (d : PB.GPre[l].PS.PEl[G, PB.GPre[l].PS.subTy G IJ.D C IJ.c]) (X : Ob) (x : V[l].Ix (G.ob X))
    : Id (V[l].Ix (C.tob X (IJ.c.nt X x))) ((J C cC d).eob X (IJ.c.nt X x)) (d.eob X x) = IJ.JJ[C, cC, d].beta X x ;
} ;
