-- FibIdRd.seg (M1, step 3): reading transported elements of the Yoneda Id
-- (PosIdY), for the instance of CwFId.SwanId at fibCwF (FibId).
--
-- An element w of the fibre of Id(a , b) at x is determined by its values
-- w W f j : A(W , x f) and its sieve (PosIdY.idY-eq).  The CwF laws move
-- such elements along paths of types; these lemmas say what is moved.
--
-- Informal text.
-- (1) The value at a point of an element transported along a path of
--     types (of any type T mapping to types: PTy, or structured types) is
--     its value transported in the fibre along ANY path of fibre codes,
--     since V is a set (elTr).  The same for a substitution out of a
--     context extension, at a point (x , v): its value at
--     (x , v transported back) (subTr).
-- (2) The V-reading of w at (W , f , j) is the pair (code of the fibre,
--     value) in Sigma V Ix.  It does not mention A or G, so it can be
--     compared across a path of triples (A , a , b): a transport in the
--     fibre along any code path between two Yoneda Id fibres keeps the
--     V-readings and the sieve, given a path of the triples (triRd,
--     triSq; by J on the triple path, V a set).  Two elements of one fibre
--     with the same V-readings and sieve are equal (idY-eqV).
-- (3) refl: the constant path at a x with the total sieve; natural (the
--     readings of its restriction are those at h f).
-- (4) A path of triples from a path of types and paths of the transported
--     elements (triPath, the form of CwFId.idCong).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

------------------------------------------------------------------------
-- (1) transported elements and substitutions, at a point

elTr (G : PCtx) (T : U l+) (ty : T -> PTy[G]) (B B' : T) (P : Id T B B') (u : PEl[G, ty B]) (I : Ob) (x : W0.Ix (G.ob I))
  (c : Id W0.V ((ty B).tob I x) ((ty B').tob I x))
  : Id (W0.Ix ((ty B').tob I x)) ((subst T (\ Z -> PEl[G, ty Z]) B B' P u).eob I x)
       (subst W0.V (\ v -> W0.Ix v) ((ty B).tob I x) ((ty B').tob I x) c (u.eob I x)) =
  idJ T B
    (\ B2 P2 -> (c2 : Id W0.V ((ty B).tob I x) ((ty B2).tob I x))
       -> Id (W0.Ix ((ty B2).tob I x)) ((subst T (\ Z -> PEl[G, ty Z]) B B2 P2 u).eob I x)
             (subst W0.V (\ v -> W0.Ix v) ((ty B).tob I x) ((ty B2).tob I x) c2 (u.eob I x)))
    (\ c2 -> ap (Id W0.V ((ty B).tob I x) ((ty B).tob I x)) (W0.Ix ((ty B).tob I x))
               (\ q -> subst W0.V (\ v -> W0.Ix v) ((ty B).tob I x) ((ty B).tob I x) q (u.eob I x))
               (refl ((ty B).tob I x)) c2 (W0.isSetV ((ty B).tob I x) ((ty B).tob I x) (refl ((ty B).tob I x)) c2))
    B' P c ;

subTr (G Z : PCtx) (T : U l+) (ty : T -> PTy[G]) (B B' : T) (P : Id T B B') (u : PSub[extP G (ty B), Z]) (I : Ob)
  (w : W0.Ix ((extP G (ty B')).ob I)) (c : Id W0.V ((ty B').tob I (fstE G (ty B') I w)) ((ty B).tob I (fstE G (ty B') I w)))
  : Id (W0.Ix (Z.ob I)) ((subst T (\ Y -> PSub[extP G (ty Y), Z]) B B' P u).nt I w)
       (u.nt I (pairE G (ty B) I (fstE G (ty B') I w)
                  (subst W0.V (\ v -> W0.Ix v) ((ty B').tob I (fstE G (ty B') I w)) ((ty B).tob I (fstE G (ty B') I w)) c (sndE G (ty B') I w)))) =
  idJ T B
    (\ B2 P2 -> (w2 : W0.Ix ((extP G (ty B2)).ob I)) (c2 : Id W0.V ((ty B2).tob I (fstE G (ty B2) I w2)) ((ty B).tob I (fstE G (ty B2) I w2)))
       -> Id (W0.Ix (Z.ob I)) ((subst T (\ Y -> PSub[extP G (ty Y), Z]) B B2 P2 u).nt I w2)
             (u.nt I (pairE G (ty B) I (fstE G (ty B2) I w2)
                        (subst W0.V (\ v -> W0.Ix v) ((ty B2).tob I (fstE G (ty B2) I w2)) ((ty B).tob I (fstE G (ty B2) I w2)) c2 (sndE G (ty B2) I w2)))))
    (\ w2 c2 -> ap (Id W0.V ((ty B).tob I (fstE G (ty B) I w2)) ((ty B).tob I (fstE G (ty B) I w2))) (W0.Ix (Z.ob I))
                  (\ q -> u.nt I (pairE G (ty B) I (fstE G (ty B) I w2)
                                   (subst W0.V (\ v -> W0.Ix v) ((ty B).tob I (fstE G (ty B) I w2)) ((ty B).tob I (fstE G (ty B) I w2)) q (sndE G (ty B) I w2))))
                  (refl ((ty B).tob I (fstE G (ty B) I w2))) c2
                  (W0.isSetV ((ty B).tob I (fstE G (ty B) I w2)) ((ty B).tob I (fstE G (ty B) I w2)) (refl ((ty B).tob I (fstE G (ty B) I w2))) c2))
    B' P w c ;

------------------------------------------------------------------------
-- (2) V-readings

VR : U l+ = (c : W0.V) * W0.Ix c ;

-- a point of the total space, read in V
vmap (G : PCtx) (A : PTy[G]) (W : Ob) (r : GPR.TyL[G, A].EI W) : VR =
  (A.tob W (GPR.TyL[G, A].pr1 W r), GPR.TyL[G, A].pr2 W r) ;

-- the second components of two V-readings with the same code
vinj (c : W0.V) (u u' : W0.Ix c) (Q : Id VR (c, u) (c, u')) : Id (W0.Ix c) u u' =
  transH (ap (Id W0.V c c) (W0.Ix c) (\ p -> subst W0.V (\ v -> W0.Ix v) c c p u)
            (refl c) (ap VR W0.V (\ z -> z.1) (c, u) (c, u') Q) (W0.isSetV c c (refl c) (ap VR W0.V (\ z -> z.1) (c, u) (c, u') Q)))
         (Sigma-snd W0.V (\ v -> W0.Ix v) c c u u' Q) ;

-- the triples (A , a , b) over G
Tri (G : PCtx) : U l+ = (A : PTy[G]) * ((b : PEl[G, A]) * PEl[G, A]) ;

FT (G : PCtx) (t : Tri G) (X : Ob) (x : W0.Ix (G.ob X)) : W0.V = PosIdY[a, l].IdY[G, t.1, t.2.1, t.2.2].tob X x ;

vr (G : PCtx) (t : Tri G) (X : Ob) (x : W0.Ix (G.ob X)) (w : W0.Ix (FT G t X x)) (W : Ob) (f : Hom W X) (j : Hom W Iv) : VR =
  (t.1.tob W (G.act W X f x), w.1.1 W f j) ;

-- the V-reading is the reading of PosIdY, read in V (by definition)
vr-rd (G : PCtx) (t : Tri G) (X : Ob) (x : W0.Ix (G.ob X)) (w : W0.Ix (FT G t X x)) (W : Ob) (f : Hom W X) (j : Hom W Iv)
  : Id VR (vr G t X x w W f j) (vmap G t.1 W (PosIdY[a, l].IdY[G, t.1, t.2.1, t.2.2].rd X x w W f j)) =
  refl (vr G t X x w W f j) ;

triRd (G : PCtx) (t t' : Tri G) (T : Id (Tri G) t t') (X : Ob) (x : W0.Ix (G.ob X))
  (c : Id W0.V (FT G t X x) (FT G t' X x)) (w : W0.Ix (FT G t X x)) (W : Ob) (f : Hom W X) (j : Hom W Iv)
  : Id VR (vr G t' X x (subst W0.V (\ v -> W0.Ix v) (FT G t X x) (FT G t' X x) c w) W f j) (vr G t X x w W f j) =
  idJ (Tri G) t
    (\ t2 T2 -> (c2 : Id W0.V (FT G t X x) (FT G t2 X x))
       -> Id VR (vr G t2 X x (subst W0.V (\ v -> W0.Ix v) (FT G t X x) (FT G t2 X x) c2 w) W f j) (vr G t X x w W f j))
    (\ c2 -> ap (Id W0.V (FT G t X x) (FT G t X x)) VR
               (\ q -> vr G t X x (subst W0.V (\ v -> W0.Ix v) (FT G t X x) (FT G t X x) q w) W f j)
               c2 (refl (FT G t X x)) (W0.isSetV (FT G t X x) (FT G t X x) c2 (refl (FT G t X x))))
    t' T c ;

triSq (G : PCtx) (t t' : Tri G) (T : Id (Tri G) t t') (X : Ob) (x : W0.Ix (G.ob X))
  (c : Id W0.V (FT G t X x) (FT G t' X x)) (w : W0.Ix (FT G t X x))
  : Id (PB.Phi X) (subst W0.V (\ v -> W0.Ix v) (FT G t X x) (FT G t' X x) c w).2.1 w.2.1 =
  idJ (Tri G) t
    (\ t2 T2 -> (c2 : Id W0.V (FT G t X x) (FT G t2 X x))
       -> Id (PB.Phi X) (subst W0.V (\ v -> W0.Ix v) (FT G t X x) (FT G t2 X x) c2 w).2.1 w.2.1)
    (\ c2 -> ap (Id W0.V (FT G t X x) (FT G t X x)) (PB.Phi X)
               (\ q -> (subst W0.V (\ v -> W0.Ix v) (FT G t X x) (FT G t X x) q w).2.1)
               c2 (refl (FT G t X x)) (W0.isSetV (FT G t X x) (FT G t X x) c2 (refl (FT G t X x))))
    t' T c ;

idY-eqV (G : PCtx) (t : Tri G) (X : Ob) (x : W0.Ix (G.ob X)) (w w' : W0.Ix (FT G t X x))
  (q : (W : Ob) (f : Hom W X) (j : Hom W Iv) -> Id VR (vr G t X x w W f j) (vr G t X x w' W f j))
  (Q : Id (PB.Phi X) w.2.1 w'.2.1) : Id (W0.Ix (FT G t X x)) w w' =
  PosIdY[a, l].IdY[G, t.1, t.2.1, t.2.2].idY-eq X x w w'
    (\ W f j -> apH (GPR.TyL[G, t.1].pr W (G.act W X f x))
                  (vinj (t.1.tob W (G.act W X f x)) (w.1.1 W f j) (w'.1.1 W f j) (q W f j)))
    Q ;

------------------------------------------------------------------------
-- (3) refl

module ReflY (G : PCtx) (A : PTy[G]) (a0 : PEl[G, A]) {
  module Y = PosIdY[a, l].IdY[G, A, a0, a0] ;

  val (X : Ob) (x : W0.Ix (G.ob X)) : W0.Ix (Y.tob X x) =
    ((\ W f j -> a0.eob W (Y.pt X x W f),
      (\ V W g f j -> a0.enat V W g (Y.pt X x W f) (Y.pt X x V (compH V W X f g)) (Y.ptn X x V W g f),
       (\ W f -> refl (a0.eob W (Y.pt X x W f)), \ W f -> refl (a0.eob W (Y.pt X x W f))))),
     (PB.topS X, \ W f i j -> refl (a0.eob W (Y.pt X x W f)))) ;

  -- the total sieve is stable
  pre-top (J I : Ob) (f : Hom J I) : Id (PB.Phi J) (PB.pre J I f (PB.topS I)) (PB.topS J) =
    PB.phi-ext J (PB.pre J I f (PB.topS I)) (PB.topS J) (\ W g i -> PB.top-lands W J g)
      (\ W g i -> PB.pre-lands W J I f (PB.topS I) g (PB.top-lands W I (compH W J I f g))) ;

  nat (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y)
    : Id (W0.Ix (Y.tob J y)) (Y.tactY J I f x y e (val I x)) (val J y) =
    Y.idY-eq J y (Y.tactY J I f x y e (val I x)) (val J y)
      (\ V g j -> transH (Y.Tact[J, I, f, x, y, e, val I x].rdc V g j)
                    (apH (\ v -> Y.TA.pr V v (a0.eob V v)) (Y.Tact[J, I, f, x, y, e, val I x].pi V g)))
      (pre-top J I f) ;

  rflY : PEl[G, Y.IdYT] = mkPEl G Y.IdYT val nat ;
} ;

------------------------------------------------------------------------
-- (4) a path of triples

triPath (G : PCtx) (A A' : PTy[G]) (P : Id (PTy[G]) A A') (a b : PEl[G, A]) (a' b' : PEl[G, A'])
  (Pa : Id (PEl[G, A']) (subst (PTy[G]) (\ X -> PEl[G, X]) A A' P a) a')
  (Pb : Id (PEl[G, A']) (subst (PTy[G]) (\ X -> PEl[G, X]) A A' P b) b')
  : Id (Tri G) (A, (a, b)) (A', (a', b')) =
  idJ (PTy[G]) A
    (\ A2 P2 -> (a2 b2 : PEl[G, A2]) -> Id (PEl[G, A2]) (subst (PTy[G]) (\ X -> PEl[G, X]) A A2 P2 a) a2
       -> Id (PEl[G, A2]) (subst (PTy[G]) (\ X -> PEl[G, X]) A A2 P2 b) b2 -> Id (Tri G) (A, (a, b)) (A2, (a2, b2)))
    (\ a2 b2 Pa2 Pb2 ->
       idJ (PEl[G, A]) a (\ a3 Q3 -> Id (Tri G) (A, (a, b)) (A, (a3, b2)))
         (idJ (PEl[G, A]) b (\ b3 Q3 -> Id (Tri G) (A, (a, b)) (A, (a, b3))) (refl (A, (a, b))) b2 Pb2)
         a2 Pa2)
    A' P a' b' Pa Pb ;
