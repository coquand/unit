-- FibContr.seg (M1 step 3, S4, S2): a relative contractibility structure
-- (core's ContrOp) on a fibrant type T over G gives an element of the
-- internal isContr T of the CwF of fibrant types FibCwF[a, l].
--
-- Informal text.  The centre c is the extension of the empty side
-- (CLocBoundContr.Contract).  Over G.T, at (W , z = (y , t)) and j : W -> I,
-- Lf W z j is the extension of the side {j = 0 |-> c y , j = 1 |-> t}
-- (CLocBoundContr.Connect, for the maps const c and id).  It is natural
-- (Connect.Uniform), and at the ends it is c y and t (Connect.end-value).
-- So it is a line field with ends c[p] and q (FibNF.LineY): an element of
-- Id(c[p] , q) over G.T, the contraction.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LB = CLocBoundContr[a, l] ;
module SG = CwFSing.Sing[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;

module CO (G : PCtx) (T : FC.STy G) (k : PB.CPartial[l].ContrOp G T.1) {
  module TT = GPR.TyL[G, T.1] ;
  GT : PCtx = extP G T.1 ;
  T1 : PTy[GT] = subTy GT G T.1 (pP G T.1) ;

  -- the centre
  c : PEl[G, T.1] = LB.Contract[G, T.1, k].centre ;

  module CN = LB.Connect[G, T.1, T.1, LB.constant G T.1 c, PB.CHtpyOps[l].idN G T.1, k] ;

  -- the line field
  Lf (W : Ob) (z : W0.Ix (GT.ob W)) (j : Hom W Iv) : W0.Ix (T1.tob W z) = (CN.Ends[W, z, j].value).2 ;

  Unat (V W : Ob) (g : Hom V W) (z : W0.Ix (GT.ob W)) (z' : W0.Ix (GT.ob V)) (E : Id (W0.Ix (GT.ob V)) (GT.act V W g z) z') (j : Hom W Iv)
    : Id (W0.Ix (T1.tob V z')) (T1.tact V W g z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g)) =
    TT.pr-inj V (TT.pr1 V z') (T1.tact V W g z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g))
      (transH (symH (TT.pr-tact V W g (TT.pr1 W z) (TT.pr1 V z') (ntEq GT G (pP G T.1) V W g z z' E) (Lf W z j)))
        CN.Uniform[V, W, g, z, z', E, j].value-nat) ;

  U0 (W : Ob) (z : W0.Ix (GT.ob W)) : Id (W0.Ix (T1.tob W z)) (Lf W z (PB.ptH W e0)) ((subEl GT G T.1 c (pP G T.1)).eob W z) =
    TT.pr-inj W (TT.pr1 W z) (Lf W z (PB.ptH W e0)) ((subEl GT G T.1 c (pP G T.1)).eob W z) (CN.end-value W z LB.f0) ;

  U1 (W : Ob) (z : W0.Ix (GT.ob W)) : Id (W0.Ix (T1.tob W z)) (Lf W z (PB.ptH W e1)) ((qP G T.1).eob W z) =
    TT.pr-inj W (TT.pr1 W z) (Lf W z (PB.ptH W e1)) ((qP G T.1).eob W z) (CN.end-value W z LB.f1) ;

  module LY = FibNF[a, l].LineY[GT, T1, subEl GT G T.1 c (pP G T.1), qP G T.1, Lf, Unat, U0, U1] ;

  contr : FCw.fibCwF.El G (EQ.isContr G T) = SG.mkContr G T c LY.el ;
} ;

contr (G : PCtx) (T : FC.STy G) (k : PB.CPartial[l].ContrOp G T.1) : FCw.fibCwF.El G (EQ.isContr G T) = CO[G, T, k].contr ;
