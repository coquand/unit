-- CwFCtx.seg (M1 step 3, S4 toolkit): strict retracts of comprehension
-- contexts, and right-nested Sigma, in a CwF with Pi, Sigma, Swan Id.
--
-- Informal text.
-- (1) ctxRet: if G.S is a strict retract of G.S' over G (sg , tu with
--     p sg = p, p tu = p, tu sg = id) and S' is contractible, so is S
--     (CwFRet with sm = q along sg, rm = q along tu: the composite rs is q
--     along tu sg = q).
-- (2) XU: X after unpk is the identity (CwFSig: unpk X = id), so G.(Sigma A
--     B) and G.A.B are isomorphic contexts.
-- (3) sigCR: Sigma A (Sigma B C) is contractible if Sigma A B is and C is
--     (over G.A.B): both G.(Sigma A (Sigma B C)) and G.(Sigma (Sigma A B)
--     C') (C' = C along unpk) are isomorphic to G.A.B.C, and the second is
--     contractible by CwFSigC.

open Base ;

module Ctx (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module RT = CwFRet.Ret[l, C, PS, SS, IJ] ;
  module RS = CwFRetS.RetS[l, C, PS, SS, IJ] ;
  module SC = CwFSigC.SigC[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- (1) strict retracts of contexts

  module CR (G : Ctx) (S S' : Ty G) (sg : Sub (ext G S) (ext G S')) (psg : Id (Sub (ext G S) G) (o (ext G S) (ext G S') G (p G S') sg) (p G S))
    (tu : Sub (ext G S') (ext G S)) (ptu : Id (Sub (ext G S') G) (o (ext G S') (ext G S) G (p G S) tu) (p G S'))
    (e : Id (Sub (ext G S) (ext G S)) (o (ext G S) (ext G S') (ext G S) tu sg) (id (ext G S))) {
    ES : Ctx = ext G S ;
    ES' : Ctx = ext G S' ;
    sm : El ES (wkT G S S') = RS.alongT ES ES' G S' (p G S') (q G S') sg (p G S) psg ;
    rm : El ES' (wkT G S' S) = RS.alongT ES' ES G S (p G S) (q G S) tu (p G S') ptu ;
    module RR = RT.R[G, S, S', sm, rm] ;

    -- the map (p , sm) is sg
    eSg : Id (Sub ES ES') RR.sgm sg =
      sym (Sub ES ES') sg RR.sgm
        (trans (Sub ES ES') sg (extS ES G S' (o ES ES' G (p G S') sg) (IN.qOf ES G S' sg)) RR.sgm
           (IN.sub-eta ES G S' sg)
           (IN.extS-cong ES G S' (o ES ES' G (p G S') sg) (p G S) psg (IN.qOf ES G S' sg) sm
              (trE-tr ES (subT ES ES' (wkT G S' S') sg) (subT ES G S' (o ES ES' G (p G S') sg)) (subT ES G S' (p G S))
                 (sym (Ty ES) (subT ES G S' (o ES ES' G (p G S') sg)) (subT ES ES' (wkT G S' S') sg) (subT-o ES ES' G S' (p G S') sg))
                 (ap (Sub ES G) (Ty ES) (\ t -> subT ES G S' t) (o ES ES' G (p G S') sg) (p G S) psg)
                 (subt ES ES' (wkT G S' S') (q G S') sg)))) ;

    ers : Id (El ES (wkT G S S)) RR.rs (q G S) =
      IN.teAny ES (wkT G S S) (wkT G S S) RR.rs (q G S)
        (IN.teT ES (wkT G S S) (subT ES ES' (wkT G S' S) sg) (wkT G S S) RR.rs (subt ES ES' (wkT G S' S) rm sg) (q G S)
           (IN.teT ES (wkT G S S) (subT ES ES' (wkT G S' S) RR.sgm) (subT ES ES' (wkT G S' S) sg) RR.rs (subt ES ES' (wkT G S' S) rm RR.sgm) (subt ES ES' (wkT G S' S) rm sg)
              (IN.teS ES (subT ES ES' (wkT G S' S) RR.sgm) (wkT G S S) (subt ES ES' (wkT G S' S) rm RR.sgm) RR.rs (IN.teTr ES (subT ES ES' (wkT G S' S) RR.sgm) (wkT G S S) RR.PRS (subt ES ES' (wkT G S' S) rm RR.sgm)))
              (IN.teSubEq ES ES' (wkT G S' S) rm RR.sgm sg eSg))
           (IN.teT ES (subT ES ES' (wkT G S' S) sg) (subT ES ES' (subT ES' ES (wkT G S S) tu) sg) (wkT G S S)
              (subt ES ES' (wkT G S' S) rm sg) (subt ES ES' (subT ES' ES (wkT G S S) tu) (subt ES' ES (wkT G S S) (q G S) tu) sg) (q G S)
              (IN.teS ES (subT ES ES' (subT ES' ES (wkT G S S) tu) sg) (subT ES ES' (wkT G S' S) sg)
                 (subt ES ES' (subT ES' ES (wkT G S S) tu) (subt ES' ES (wkT G S S) (q G S) tu) sg) (subt ES ES' (wkT G S' S) rm sg)
                 (SV.teSub ES ES' (subT ES' ES (wkT G S S) tu) (wkT G S' S) (subt ES' ES (wkT G S S) (q G S) tu) rm (RS.teAlong ES' ES G S (p G S) (q G S) tu (p G S') ptu) sg))
              (IN.teT ES (subT ES ES' (subT ES' ES (wkT G S S) tu) sg) (subT ES ES (wkT G S S) (o ES ES' ES tu sg)) (wkT G S S)
                 (subt ES ES' (subT ES' ES (wkT G S S) tu) (subt ES' ES (wkT G S S) (q G S) tu) sg) (subt ES ES (wkT G S S) (q G S) (o ES ES' ES tu sg)) (q G S)
                 (IN.teS ES (subT ES ES (wkT G S S) (o ES ES' ES tu sg)) (subT ES ES' (subT ES' ES (wkT G S S) tu) sg)
                    (subt ES ES (wkT G S S) (q G S) (o ES ES' ES tu sg)) (subt ES ES' (subT ES' ES (wkT G S S) tu) (subt ES' ES (wkT G S S) (q G S) tu) sg)
                    (IN.teSubtO ES ES' ES (wkT G S S) (q G S) tu sg))
                 (IN.teT ES (subT ES ES (wkT G S S) (o ES ES' ES tu sg)) (subT ES ES (wkT G S S) (id ES)) (wkT G S S)
                    (subt ES ES (wkT G S S) (q G S) (o ES ES' ES tu sg)) (subt ES ES (wkT G S S) (q G S) (id ES)) (q G S)
                    (IN.teSubEq ES ES (wkT G S S) (q G S) (o ES ES' ES tu sg) (id ES) e)
                    (subT-id ES (wkT G S S), subt-id ES (wkT G S S) (q G S))))))
        (refl (wkT G S S)) ;

    ctrS (k : El G (EQ.isContr G S')) : El G (EQ.isContr G S) =
      RT.retC G S S' sm rm (IN.idOfEq ES (wkT G S S) RR.rs (q G S) ers) k ;
  } ;

  ----------------------------------------------------------------------
  -- (2) X unpk = id

  module XUm (G : Ctx) (A : Ty G) (B : Ty (ext G A)) {
    module VX = SV.At[G, A, B] ;
    S : Ty G = SS.Sig G A B ;
    ES : Ctx = ext G S ;
    XU : Id (Sub ES ES) (o ES VX.E2 ES VX.X VX.unpk) (id ES) =
    IN.ext-eq ES G S (o ES VX.E2 ES VX.X VX.unpk) (id ES)
      (calc (Sub ES G) {
          o ES ES G (p G S) (o ES VX.E2 ES VX.X VX.unpk)
        =< sym (Sub ES G) (o ES VX.E2 G (o VX.E2 ES G (p G S) VX.X) VX.unpk) (o ES ES G (p G S) (o ES VX.E2 ES VX.X VX.unpk)) (o-assoc ES VX.E2 ES G (p G S) VX.X VX.unpk) >
          o ES VX.E2 G (o VX.E2 ES G (p G S) VX.X) VX.unpk
        =< ap (Sub VX.E2 G) (Sub ES G) (\ t -> o ES VX.E2 G t VX.unpk) (o VX.E2 ES G (p G S) VX.X) VX.pp VX.pX >
          o ES VX.E2 G VX.pp VX.unpk
        =< VX.pp-unpk >
          p G S
        =< sym (Sub ES G) (o ES ES G (p G S) (id ES)) (p G S) (o-idr ES G (p G S)) >
          o ES ES G (p G S) (id ES) })
      (wkT G S S) (q G S)
      (trans (Ty ES) (subT ES ES (wkT G S S) (o ES VX.E2 ES VX.X VX.unpk)) (subT ES VX.E2 VX.SW VX.unpk) (wkT G S S)
         (trans (Ty ES) (subT ES ES (wkT G S S) (o ES VX.E2 ES VX.X VX.unpk)) (subT ES VX.E2 (subT VX.E2 ES (wkT G S S) VX.X) VX.unpk) (subT ES VX.E2 VX.SW VX.unpk)
            (subT-o ES VX.E2 ES (wkT G S S) VX.X VX.unpk)
            (ap (Ty VX.E2) (Ty ES) (\ Z -> subT ES VX.E2 Z VX.unpk) (subT VX.E2 ES (wkT G S S) VX.X) VX.SW (IN.wkT-extS VX.E2 G S S VX.pp VX.pv)))
         VX.PU)
      (JP.ovO ES VX.E2 ES (wkT G S S) VX.X VX.unpk VX.SW (IN.wkT-extS VX.E2 G S S VX.pp VX.pv) (wkT G S S) VX.PU
         (trans (Ty ES) (subT ES ES (wkT G S S) (o ES VX.E2 ES VX.X VX.unpk)) (subT ES VX.E2 VX.SW VX.unpk) (wkT G S S)
            (trans (Ty ES) (subT ES ES (wkT G S S) (o ES VX.E2 ES VX.X VX.unpk)) (subT ES VX.E2 (subT VX.E2 ES (wkT G S S) VX.X) VX.unpk) (subT ES VX.E2 VX.SW VX.unpk)
               (subT-o ES VX.E2 ES (wkT G S S) VX.X VX.unpk)
               (ap (Ty VX.E2) (Ty ES) (\ Z -> subT ES VX.E2 Z VX.unpk) (subT VX.E2 ES (wkT G S S) VX.X) VX.SW (IN.wkT-extS VX.E2 G S S VX.pp VX.pv)))
            VX.PU)
         (q G S) VX.pv (q G S) (JP.q-extS VX.E2 G S VX.pp VX.pv (IN.wkT-extS VX.E2 G S S VX.pp VX.pv)) VX.pv-unpk)
      (subT-id ES (wkT G S S)) (subt-id ES (wkT G S S) (q G S)) ;
  } ;

  ----------------------------------------------------------------------
  -- (3) right-nested Sigma

  module SR (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (Cc : Ty (ext (ext G A) B)) {
    module VAB = SV.At[G, A, B] ;
    S : Ty G = SS.Sig G A B ;
    ES : Ctx = ext G S ;
    E2 : Ctx = VAB.E2 ;
    E3 : Ctx = ext E2 Cc ;
    BC : Ty (ext G A) = SS.Sig (ext G A) B Cc ;
    R : Ty G = SS.Sig G A BC ;
    module VR = SV.At[G, A, BC] ;
    module VBC = SV.At[ext G A, B, Cc] ;
    module XR = XUm[G, A, BC] ;
    module XBC = XUm[ext G A, B, Cc] ;
    ER : Ctx = ext G R ;

    iR : Sub ER E3 = o ER VR.E2 E3 VBC.unpk VR.unpk ;
    jR : Sub E3 ER = o E3 VR.E2 ER VR.X VBC.X ;

    jRiR : Id (Sub ER ER) (o ER E3 ER jR iR) (id ER) =
      calc (Sub ER ER) {
          o ER E3 ER (o E3 VR.E2 ER VR.X VBC.X) (o ER VR.E2 E3 VBC.unpk VR.unpk)
        =< o-assoc ER E3 VR.E2 ER VR.X VBC.X (o ER VR.E2 E3 VBC.unpk VR.unpk) >
          o ER VR.E2 ER VR.X (o ER E3 VR.E2 VBC.X (o ER VR.E2 E3 VBC.unpk VR.unpk))
        =< ap (Sub ER VR.E2) (Sub ER ER) (\ t -> o ER VR.E2 ER VR.X t) (o ER E3 VR.E2 VBC.X (o ER VR.E2 E3 VBC.unpk VR.unpk)) VR.unpk
              (calc (Sub ER VR.E2) {
                  o ER E3 VR.E2 VBC.X (o ER VR.E2 E3 VBC.unpk VR.unpk)
                =< sym (Sub ER VR.E2) (o ER VR.E2 VR.E2 (o VR.E2 E3 VR.E2 VBC.X VBC.unpk) VR.unpk) (o ER E3 VR.E2 VBC.X (o ER VR.E2 E3 VBC.unpk VR.unpk))
                      (o-assoc ER VR.E2 E3 VR.E2 VBC.X VBC.unpk VR.unpk) >
                  o ER VR.E2 VR.E2 (o VR.E2 E3 VR.E2 VBC.X VBC.unpk) VR.unpk
                =< ap (Sub VR.E2 VR.E2) (Sub ER VR.E2) (\ t -> o ER VR.E2 VR.E2 t VR.unpk) (o VR.E2 E3 VR.E2 VBC.X VBC.unpk) (id VR.E2) XBC.XU >
                  o ER VR.E2 VR.E2 (id VR.E2) VR.unpk
                =< o-idl ER VR.E2 VR.unpk >
                  VR.unpk }) >
          o ER VR.E2 ER VR.X VR.unpk
        =< XR.XU >
          id ER } ;

    C' : Ty ES = subT ES E2 Cc VAB.unpk ;
    L : Ty G = SS.Sig G S C' ;
    module VL = SV.At[G, S, C'] ;
    module XL = XUm[G, S, C'] ;
    EL : Ctx = ext G L ;
    EC' : Ctx = ext ES C' ;

    lf : Sub EC' E3 = lift ES E2 Cc VAB.unpk ;
    PCX : Id (Ty E2) (subT E2 ES C' VAB.X) Cc =
      trans (Ty E2) (subT E2 ES C' VAB.X) (subT E2 E2 Cc (o E2 ES E2 VAB.unpk VAB.X)) Cc
        (sym (Ty E2) (subT E2 E2 Cc (o E2 ES E2 VAB.unpk VAB.X)) (subT E2 ES C' VAB.X) (subT-o E2 ES E2 Cc VAB.unpk VAB.X))
        (trans (Ty E2) (subT E2 E2 Cc (o E2 ES E2 VAB.unpk VAB.X)) (subT E2 E2 Cc (id E2)) Cc
           (ap (Sub E2 E2) (Ty E2) (\ t -> subT E2 E2 Cc t) (o E2 ES E2 VAB.unpk VAB.X) (id E2) VAB.UP0)
           (subT-id E2 Cc)) ;
    up : Sub E3 EC' = upT E2 ES C' VAB.X Cc PCX ;

    WL : Id (Ty EC') (subT EC' E3 (wkT E2 Cc Cc) lf) (wkT ES C' C') = p-lift-T ES E2 Cc Cc VAB.unpk ;
    WU : Id (Ty E3) (subT E3 EC' (wkT ES C' C') up) (wkT E2 Cc Cc) = wkT-ov E2 ES C' C' VAB.X Cc PCX Cc PCX ;

    lfup : Id (Sub E3 E3) (o E3 EC' E3 lf up) (id E3) =
      IN.ext-eq E3 E2 Cc (o E3 EC' E3 lf up) (id E3)
        (calc (Sub E3 E2) {
            o E3 E3 E2 (p E2 Cc) (o E3 EC' E3 lf up)
          =< sym (Sub E3 E2) (o E3 EC' E2 (o EC' E3 E2 (p E2 Cc) lf) up) (o E3 E3 E2 (p E2 Cc) (o E3 EC' E3 lf up)) (o-assoc E3 EC' E3 E2 (p E2 Cc) lf up) >
            o E3 EC' E2 (o EC' E3 E2 (p E2 Cc) lf) up
          =< ap (Sub EC' E2) (Sub E3 E2) (\ t -> o E3 EC' E2 t up) (o EC' E3 E2 (p E2 Cc) lf) (o EC' ES E2 VAB.unpk (p ES C')) (p-lift ES E2 Cc VAB.unpk) >
            o E3 EC' E2 (o EC' ES E2 VAB.unpk (p ES C')) up
          =< o-assoc E3 EC' ES E2 VAB.unpk (p ES C') up >
            o E3 ES E2 VAB.unpk (o E3 EC' ES (p ES C') up)
          =< ap (Sub E3 ES) (Sub E3 E2) (\ t -> o E3 ES E2 VAB.unpk t) (o E3 EC' ES (p ES C') up) (o E3 E2 ES VAB.X (p E2 Cc)) (CwFCoS.CoS[l, C, PS, SS, IJ].pUp E2 ES C' VAB.X Cc PCX) >
            o E3 ES E2 VAB.unpk (o E3 E2 ES VAB.X (p E2 Cc))
          =< sym (Sub E3 E2) (o E3 E2 E2 (o E2 ES E2 VAB.unpk VAB.X) (p E2 Cc)) (o E3 ES E2 VAB.unpk (o E3 E2 ES VAB.X (p E2 Cc))) (o-assoc E3 E2 ES E2 VAB.unpk VAB.X (p E2 Cc)) >
            o E3 E2 E2 (o E2 ES E2 VAB.unpk VAB.X) (p E2 Cc)
          =< ap (Sub E2 E2) (Sub E3 E2) (\ t -> o E3 E2 E2 t (p E2 Cc)) (o E2 ES E2 VAB.unpk VAB.X) (id E2) VAB.UP0 >
            o E3 E2 E2 (id E2) (p E2 Cc)
          =< o-idl E3 E2 (p E2 Cc) >
            p E2 Cc
          =< sym (Sub E3 E2) (o E3 E3 E2 (p E2 Cc) (id E3)) (p E2 Cc) (o-idr E3 E2 (p E2 Cc)) >
            o E3 E3 E2 (p E2 Cc) (id E3) })
        (wkT E2 Cc Cc) (q E2 Cc)
        (trans (Ty E3) (subT E3 E3 (wkT E2 Cc Cc) (o E3 EC' E3 lf up)) (subT E3 EC' (subT EC' E3 (wkT E2 Cc Cc) lf) up) (wkT E2 Cc Cc)
           (subT-o E3 EC' E3 (wkT E2 Cc Cc) lf up)
           (trans (Ty E3) (subT E3 EC' (subT EC' E3 (wkT E2 Cc Cc) lf) up) (subT E3 EC' (wkT ES C' C') up) (wkT E2 Cc Cc)
              (ap (Ty EC') (Ty E3) (\ Z -> subT E3 EC' Z up) (subT EC' E3 (wkT E2 Cc Cc) lf) (wkT ES C' C') WL) WU))
        (JP.ovO E3 EC' E3 (wkT E2 Cc Cc) lf up (wkT ES C' C') WL (wkT E2 Cc Cc) WU
           (trans (Ty E3) (subT E3 E3 (wkT E2 Cc Cc) (o E3 EC' E3 lf up)) (subT E3 EC' (subT EC' E3 (wkT E2 Cc Cc) lf) up) (wkT E2 Cc Cc)
              (subT-o E3 EC' E3 (wkT E2 Cc Cc) lf up)
              (trans (Ty E3) (subT E3 EC' (subT EC' E3 (wkT E2 Cc Cc) lf) up) (subT E3 EC' (wkT ES C' C') up) (wkT E2 Cc Cc)
                 (ap (Ty EC') (Ty E3) (\ Z -> subT E3 EC' Z up) (subT EC' E3 (wkT E2 Cc Cc) lf) (wkT ES C' C') WL) WU))
           (q E2 Cc) (q ES C') (q E2 Cc)
           (q-ov ES E2 Cc VAB.unpk C' (refl C') WL)
           (q-ov E2 ES C' VAB.X Cc PCX WU))
        (subT-id E3 (wkT E2 Cc Cc)) (subt-id E3 (wkT E2 Cc Cc) (q E2 Cc)) ;

    uplf : Id (Sub EC' EC') (o EC' E3 EC' up lf) (id EC') =
      IN.ext-eq EC' ES C' (o EC' E3 EC' up lf) (id EC')
        (calc (Sub EC' ES) {
            o EC' EC' ES (p ES C') (o EC' E3 EC' up lf)
          =< sym (Sub EC' ES) (o EC' E3 ES (o E3 EC' ES (p ES C') up) lf) (o EC' EC' ES (p ES C') (o EC' E3 EC' up lf)) (o-assoc EC' E3 EC' ES (p ES C') up lf) >
            o EC' E3 ES (o E3 EC' ES (p ES C') up) lf
          =< ap (Sub E3 ES) (Sub EC' ES) (\ t -> o EC' E3 ES t lf) (o E3 EC' ES (p ES C') up) (o E3 E2 ES VAB.X (p E2 Cc)) (CwFCoS.CoS[l, C, PS, SS, IJ].pUp E2 ES C' VAB.X Cc PCX) >
            o EC' E3 ES (o E3 E2 ES VAB.X (p E2 Cc)) lf
          =< o-assoc EC' E3 E2 ES VAB.X (p E2 Cc) lf >
            o EC' E2 ES VAB.X (o EC' E3 E2 (p E2 Cc) lf)
          =< ap (Sub EC' E2) (Sub EC' ES) (\ t -> o EC' E2 ES VAB.X t) (o EC' E3 E2 (p E2 Cc) lf) (o EC' ES E2 VAB.unpk (p ES C')) (p-lift ES E2 Cc VAB.unpk) >
            o EC' E2 ES VAB.X (o EC' ES E2 VAB.unpk (p ES C'))
          =< sym (Sub EC' ES) (o EC' ES ES (o ES E2 ES VAB.X VAB.unpk) (p ES C')) (o EC' E2 ES VAB.X (o EC' ES E2 VAB.unpk (p ES C'))) (o-assoc EC' ES E2 ES VAB.X VAB.unpk (p ES C')) >
            o EC' ES ES (o ES E2 ES VAB.X VAB.unpk) (p ES C')
          =< ap (Sub ES ES) (Sub EC' ES) (\ t -> o EC' ES ES t (p ES C')) (o ES E2 ES VAB.X VAB.unpk) (id ES) XUm[G, A, B].XU >
            o EC' ES ES (id ES) (p ES C')
          =< o-idl EC' ES (p ES C') >
            p ES C'
          =< sym (Sub EC' ES) (o EC' EC' ES (p ES C') (id EC')) (p ES C') (o-idr EC' ES (p ES C')) >
            o EC' EC' ES (p ES C') (id EC') })
        (wkT ES C' C') (q ES C')
        (trans (Ty EC') (subT EC' EC' (wkT ES C' C') (o EC' E3 EC' up lf)) (subT EC' E3 (subT E3 EC' (wkT ES C' C') up) lf) (wkT ES C' C')
           (subT-o EC' E3 EC' (wkT ES C' C') up lf)
           (trans (Ty EC') (subT EC' E3 (subT E3 EC' (wkT ES C' C') up) lf) (subT EC' E3 (wkT E2 Cc Cc) lf) (wkT ES C' C')
              (ap (Ty E3) (Ty EC') (\ Z -> subT EC' E3 Z lf) (subT E3 EC' (wkT ES C' C') up) (wkT E2 Cc Cc) WU) WL))
        (JP.ovO EC' E3 EC' (wkT ES C' C') up lf (wkT E2 Cc Cc) WU (wkT ES C' C') WL
           (trans (Ty EC') (subT EC' EC' (wkT ES C' C') (o EC' E3 EC' up lf)) (subT EC' E3 (subT E3 EC' (wkT ES C' C') up) lf) (wkT ES C' C')
              (subT-o EC' E3 EC' (wkT ES C' C') up lf)
              (trans (Ty EC') (subT EC' E3 (subT E3 EC' (wkT ES C' C') up) lf) (subT EC' E3 (wkT E2 Cc Cc) lf) (wkT ES C' C')
                 (ap (Ty E3) (Ty EC') (\ Z -> subT EC' E3 Z lf) (subT E3 EC' (wkT ES C' C') up) (wkT E2 Cc Cc) WU) WL))
           (q ES C') (q E2 Cc) (q ES C')
           (q-ov E2 ES C' VAB.X Cc PCX WU)
           (q-ov ES E2 Cc VAB.unpk C' (refl C') WL))
        (subT-id EC' (wkT ES C' C')) (subt-id EC' (wkT ES C' C') (q ES C')) ;

    iL : Sub EL E3 = o EL EC' E3 lf VL.unpk ;
    jL : Sub E3 EL = o E3 EC' EL VL.X up ;

    iLjL : Id (Sub E3 E3) (o E3 EL E3 iL jL) (id E3) =
      calc (Sub E3 E3) {
          o E3 EL E3 (o EL EC' E3 lf VL.unpk) (o E3 EC' EL VL.X up)
        =< o-assoc E3 EL EC' E3 lf VL.unpk (o E3 EC' EL VL.X up) >
          o E3 EC' E3 lf (o E3 EL EC' VL.unpk (o E3 EC' EL VL.X up))
        =< ap (Sub E3 EC') (Sub E3 E3) (\ t -> o E3 EC' E3 lf t) (o E3 EL EC' VL.unpk (o E3 EC' EL VL.X up)) up
              (calc (Sub E3 EC') {
                  o E3 EL EC' VL.unpk (o E3 EC' EL VL.X up)
                =< sym (Sub E3 EC') (o E3 EC' EC' (o EC' EL EC' VL.unpk VL.X) up) (o E3 EL EC' VL.unpk (o E3 EC' EL VL.X up)) (o-assoc E3 EC' EL EC' VL.unpk VL.X up) >
                  o E3 EC' EC' (o EC' EL EC' VL.unpk VL.X) up
                =< ap (Sub EC' EC') (Sub E3 EC') (\ t -> o E3 EC' EC' t up) (o EC' EL EC' VL.unpk VL.X) (id EC') VL.UP0 >
                  o E3 EC' EC' (id EC') up
                =< o-idl E3 EC' up >
                  up }) >
          o E3 EC' E3 lf up
        =< lfup >
          id E3 } ;

    sg : Sub ER EL = o ER E3 EL jL iR ;
    tu : Sub EL ER = o EL E3 ER jR iL ;

    tusg : Id (Sub ER ER) (o ER EL ER tu sg) (id ER) =
      calc (Sub ER ER) {
          o ER EL ER (o EL E3 ER jR iL) (o ER E3 EL jL iR)
        =< o-assoc ER EL E3 ER jR iL (o ER E3 EL jL iR) >
          o ER E3 ER jR (o ER EL E3 iL (o ER E3 EL jL iR))
        =< ap (Sub ER E3) (Sub ER ER) (\ t -> o ER E3 ER jR t) (o ER EL E3 iL (o ER E3 EL jL iR)) iR
              (calc (Sub ER E3) {
                  o ER EL E3 iL (o ER E3 EL jL iR)
                =< sym (Sub ER E3) (o ER E3 E3 (o E3 EL E3 iL jL) iR) (o ER EL E3 iL (o ER E3 EL jL iR)) (o-assoc ER E3 EL E3 iL jL iR) >
                  o ER E3 E3 (o E3 EL E3 iL jL) iR
                =< ap (Sub E3 E3) (Sub ER E3) (\ t -> o ER E3 E3 t iR) (o E3 EL E3 iL jL) (id E3) iLjL >
                  o ER E3 E3 (id E3) iR
                =< o-idl ER E3 iR >
                  iR }) >
          o ER E3 ER jR iR
        =< jRiR >
          id ER } ;

    -- both maps lie over G: the projections of E3 to G agree
    p3 : Sub E3 G = o E3 E2 G VAB.pp (p E2 Cc) ;

    pjL : Id (Sub E3 G) (o E3 EL G (p G L) jL) p3 =
      calc (Sub E3 G) {
          o E3 EL G (p G L) (o E3 EC' EL VL.X up)
        =< sym (Sub E3 G) (o E3 EC' G (o EC' EL G (p G L) VL.X) up) (o E3 EL G (p G L) (o E3 EC' EL VL.X up)) (o-assoc E3 EC' EL G (p G L) VL.X up) >
          o E3 EC' G (o EC' EL G (p G L) VL.X) up
        =< ap (Sub EC' G) (Sub E3 G) (\ t -> o E3 EC' G t up) (o EC' EL G (p G L) VL.X) VL.pp VL.pX >
          o E3 EC' G (o EC' ES G (p G S) (p ES C')) up
        =< o-assoc E3 EC' ES G (p G S) (p ES C') up >
          o E3 ES G (p G S) (o E3 EC' ES (p ES C') up)
        =< ap (Sub E3 ES) (Sub E3 G) (\ t -> o E3 ES G (p G S) t) (o E3 EC' ES (p ES C') up) (o E3 E2 ES VAB.X (p E2 Cc)) (CwFCoS.CoS[l, C, PS, SS, IJ].pUp E2 ES C' VAB.X Cc PCX) >
          o E3 ES G (p G S) (o E3 E2 ES VAB.X (p E2 Cc))
        =< sym (Sub E3 G) (o E3 E2 G (o E2 ES G (p G S) VAB.X) (p E2 Cc)) (o E3 ES G (p G S) (o E3 E2 ES VAB.X (p E2 Cc))) (o-assoc E3 E2 ES G (p G S) VAB.X (p E2 Cc)) >
          o E3 E2 G (o E2 ES G (p G S) VAB.X) (p E2 Cc)
        =< ap (Sub E2 G) (Sub E3 G) (\ t -> o E3 E2 G t (p E2 Cc)) (o E2 ES G (p G S) VAB.X) VAB.pp VAB.pX >
          p3 } ;

    pjR : Id (Sub E3 G) (o E3 ER G (p G R) jR) p3 =
      calc (Sub E3 G) {
          o E3 ER G (p G R) (o E3 VR.E2 ER VR.X VBC.X)
        =< sym (Sub E3 G) (o E3 VR.E2 G (o VR.E2 ER G (p G R) VR.X) VBC.X) (o E3 ER G (p G R) (o E3 VR.E2 ER VR.X VBC.X)) (o-assoc E3 VR.E2 ER G (p G R) VR.X VBC.X) >
          o E3 VR.E2 G (o VR.E2 ER G (p G R) VR.X) VBC.X
        =< ap (Sub VR.E2 G) (Sub E3 G) (\ t -> o E3 VR.E2 G t VBC.X) (o VR.E2 ER G (p G R) VR.X) VR.pp VR.pX >
          o E3 VR.E2 G (o VR.E2 (ext G A) G (p G A) (p (ext G A) BC)) VBC.X
        =< o-assoc E3 VR.E2 (ext G A) G (p G A) (p (ext G A) BC) VBC.X >
          o E3 (ext G A) G (p G A) (o E3 VR.E2 (ext G A) (p (ext G A) BC) VBC.X)
        =< ap (Sub E3 (ext G A)) (Sub E3 G) (\ t -> o E3 (ext G A) G (p G A) t) (o E3 VR.E2 (ext G A) (p (ext G A) BC) VBC.X) VBC.pp VBC.pX >
          o E3 (ext G A) G (p G A) (o E3 E2 (ext G A) (p (ext G A) B) (p E2 Cc))
        =< sym (Sub E3 G) (o E3 E2 G (o E2 (ext G A) G (p G A) (p (ext G A) B)) (p E2 Cc)) (o E3 (ext G A) G (p G A) (o E3 E2 (ext G A) (p (ext G A) B) (p E2 Cc)))
              (o-assoc E3 E2 (ext G A) G (p G A) (p (ext G A) B) (p E2 Cc)) >
          p3 } ;

    piR : Id (Sub ER G) (o ER E3 G p3 iR) (p G R) =
      trans (Sub ER G) (o ER E3 G p3 iR) (o ER E3 G (o E3 ER G (p G R) jR) iR) (p G R)
        (ap (Sub E3 G) (Sub ER G) (\ t -> o ER E3 G t iR) p3 (o E3 ER G (p G R) jR) (sym (Sub E3 G) (o E3 ER G (p G R) jR) p3 pjR))
        (trans (Sub ER G) (o ER E3 G (o E3 ER G (p G R) jR) iR) (o ER ER G (p G R) (o ER E3 ER jR iR)) (p G R)
           (o-assoc ER E3 ER G (p G R) jR iR)
           (trans (Sub ER G) (o ER ER G (p G R) (o ER E3 ER jR iR)) (o ER ER G (p G R) (id ER)) (p G R)
              (ap (Sub ER ER) (Sub ER G) (\ t -> o ER ER G (p G R) t) (o ER E3 ER jR iR) (id ER) jRiR)
              (o-idr ER G (p G R)))) ;

    piL : Id (Sub EL G) (o EL E3 G p3 iL) (p G L) =
      trans (Sub EL G) (o EL E3 G p3 iL) (o EL E3 G (o E3 EL G (p G L) jL) iL) (p G L)
        (ap (Sub E3 G) (Sub EL G) (\ t -> o EL E3 G t iL) p3 (o E3 EL G (p G L) jL) (sym (Sub E3 G) (o E3 EL G (p G L) jL) p3 pjL))
        (trans (Sub EL G) (o EL E3 G (o E3 EL G (p G L) jL) iL) (o EL EL G (p G L) (o EL E3 EL jL iL)) (p G L)
           (o-assoc EL E3 EL G (p G L) jL iL)
           (trans (Sub EL G) (o EL EL G (p G L) (o EL E3 EL jL iL)) (o EL EL G (p G L) (id EL)) (p G L)
              (ap (Sub EL EL) (Sub EL G) (\ t -> o EL EL G (p G L) t) (o EL E3 EL jL iL) (id EL)
                  (calc (Sub EL EL) {
                      o EL E3 EL (o E3 EC' EL VL.X up) (o EL EC' E3 lf VL.unpk)
                    =< o-assoc EL E3 EC' EL VL.X up (o EL EC' E3 lf VL.unpk) >
                      o EL EC' EL VL.X (o EL E3 EC' up (o EL EC' E3 lf VL.unpk))
                    =< ap (Sub EL EC') (Sub EL EL) (\ t -> o EL EC' EL VL.X t) (o EL E3 EC' up (o EL EC' E3 lf VL.unpk)) VL.unpk
                          (calc (Sub EL EC') {
                              o EL E3 EC' up (o EL EC' E3 lf VL.unpk)
                            =< sym (Sub EL EC') (o EL EC' EC' (o EC' E3 EC' up lf) VL.unpk) (o EL E3 EC' up (o EL EC' E3 lf VL.unpk)) (o-assoc EL EC' E3 EC' up lf VL.unpk) >
                              o EL EC' EC' (o EC' E3 EC' up lf) VL.unpk
                            =< ap (Sub EC' EC') (Sub EL EC') (\ t -> o EL EC' EC' t VL.unpk) (o EC' E3 EC' up lf) (id EC') uplf >
                              o EL EC' EC' (id EC') VL.unpk
                            =< o-idl EL EC' VL.unpk >
                              VL.unpk }) >
                      o EL EC' EL VL.X VL.unpk
                    =< XL.XU >
                      id EL }))
              (o-idr EL G (p G L)))) ;

    psg : Id (Sub ER G) (o ER EL G (p G L) sg) (p G R) =
      calc (Sub ER G) {
          o ER EL G (p G L) (o ER E3 EL jL iR)
        =< sym (Sub ER G) (o ER E3 G (o E3 EL G (p G L) jL) iR) (o ER EL G (p G L) (o ER E3 EL jL iR)) (o-assoc ER E3 EL G (p G L) jL iR) >
          o ER E3 G (o E3 EL G (p G L) jL) iR
        =< ap (Sub E3 G) (Sub ER G) (\ t -> o ER E3 G t iR) (o E3 EL G (p G L) jL) p3 pjL >
          o ER E3 G p3 iR
        =< piR >
          p G R } ;

    ptu : Id (Sub EL G) (o EL ER G (p G R) tu) (p G L) =
      calc (Sub EL G) {
          o EL ER G (p G R) (o EL E3 ER jR iL)
        =< sym (Sub EL G) (o EL E3 G (o E3 ER G (p G R) jR) iL) (o EL ER G (p G R) (o EL E3 ER jR iL)) (o-assoc EL E3 ER G (p G R) jR iL) >
          o EL E3 G (o E3 ER G (p G R) jR) iL
        =< ap (Sub E3 G) (Sub EL G) (\ t -> o EL E3 G t iL) (o E3 ER G (p G R) jR) p3 pjR >
          o EL E3 G p3 iL
        =< piL >
          p G L } ;

    module CRL = CR[G, R, L, sg, psg, tu, ptu, tusg] ;

    sigCR (kS : El G (EQ.isContr G S)) (kC : El E2 (EQ.isContr E2 Cc)) : El G (EQ.isContr G R) =
      CRL.ctrS (SC.sigC G S C' kS
         (trE ES (subT ES E2 (EQ.isContr E2 Cc) VAB.unpk) (EQ.isContr ES C') (EQ.isContr-ov ES E2 Cc VAB.unpk C' (refl C'))
            (subt ES E2 (EQ.isContr E2 Cc) kC VAB.unpk))) ;
  } ;

  ----------------------------------------------------------------------
  -- (4) a strict retract of fibre contexts G.A.P ◁ G.A.P' gives one of
  -- G.(Sigma A P) ◁ G.(Sigma A P')

  module CRS (G : Ctx) (A : Ty G) (P P' : Ty (ext G A))
    (sg' : Sub (ext (ext G A) P) (ext (ext G A) P'))
    (psg' : Id (Sub (ext (ext G A) P) (ext G A)) (o (ext (ext G A) P) (ext (ext G A) P') (ext G A) (p (ext G A) P') sg') (p (ext G A) P))
    (tu' : Sub (ext (ext G A) P') (ext (ext G A) P))
    (ptu' : Id (Sub (ext (ext G A) P') (ext G A)) (o (ext (ext G A) P') (ext (ext G A) P) (ext G A) (p (ext G A) P) tu') (p (ext G A) P'))
    (e' : Id (Sub (ext (ext G A) P) (ext (ext G A) P)) (o (ext (ext G A) P) (ext (ext G A) P') (ext (ext G A) P) tu' sg') (id (ext (ext G A) P))) {
    module VP = SV.At[G, A, P] ;
    module VQ = SV.At[G, A, P'] ;
    T : Ty G = SS.Sig G A P ;
    T' : Ty G = SS.Sig G A P' ;
    ET : Ctx = ext G T ;
    ET' : Ctx = ext G T' ;
    E : Ctx = VP.E2 ;
    E' : Ctx = VQ.E2 ;

    sg : Sub ET ET' = o ET E ET' (o E E' ET' VQ.X sg') VP.unpk ;
    tu : Sub ET' ET = o ET' E' ET (o E' E ET VP.X tu') VQ.unpk ;

    e : Id (Sub ET ET) (o ET ET' ET tu sg) (id ET) =
      calc (Sub ET ET) {
          o ET ET' ET (o ET' E' ET (o E' E ET VP.X tu') VQ.unpk) (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk)
        =< o-assoc ET ET' E' ET (o E' E ET VP.X tu') VQ.unpk (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk) >
          o ET E' ET (o E' E ET VP.X tu') (o ET ET' E' VQ.unpk (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk))
        =< ap (Sub ET E') (Sub ET ET) (\ t -> o ET E' ET (o E' E ET VP.X tu') t) (o ET ET' E' VQ.unpk (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk)) (o ET E E' sg' VP.unpk)
              (calc (Sub ET E') {
                  o ET ET' E' VQ.unpk (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk)
                =< sym (Sub ET E') (o ET E E' (o E ET' E' VQ.unpk (o E E' ET' VQ.X sg')) VP.unpk) (o ET ET' E' VQ.unpk (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk))
                      (o-assoc ET E ET' E' VQ.unpk (o E E' ET' VQ.X sg') VP.unpk) >
                  o ET E E' (o E ET' E' VQ.unpk (o E E' ET' VQ.X sg')) VP.unpk
                =< ap (Sub E E') (Sub ET E') (\ t -> o ET E E' t VP.unpk) (o E ET' E' VQ.unpk (o E E' ET' VQ.X sg')) sg'
                      (calc (Sub E E') {
                          o E ET' E' VQ.unpk (o E E' ET' VQ.X sg')
                        =< sym (Sub E E') (o E E' E' (o E' ET' E' VQ.unpk VQ.X) sg') (o E ET' E' VQ.unpk (o E E' ET' VQ.X sg')) (o-assoc E E' ET' E' VQ.unpk VQ.X sg') >
                          o E E' E' (o E' ET' E' VQ.unpk VQ.X) sg'
                        =< ap (Sub E' E') (Sub E E') (\ t -> o E E' E' t sg') (o E' ET' E' VQ.unpk VQ.X) (id E') VQ.UP0 >
                          o E E' E' (id E') sg'
                        =< o-idl E E' sg' >
                          sg' }) >
                  o ET E E' sg' VP.unpk }) >
          o ET E' ET (o E' E ET VP.X tu') (o ET E E' sg' VP.unpk)
        =< o-assoc ET E' E ET VP.X tu' (o ET E E' sg' VP.unpk) >
          o ET E ET VP.X (o ET E' E tu' (o ET E E' sg' VP.unpk))
        =< ap (Sub ET E) (Sub ET ET) (\ t -> o ET E ET VP.X t) (o ET E' E tu' (o ET E E' sg' VP.unpk)) VP.unpk
              (calc (Sub ET E) {
                  o ET E' E tu' (o ET E E' sg' VP.unpk)
                =< sym (Sub ET E) (o ET E E (o E E' E tu' sg') VP.unpk) (o ET E' E tu' (o ET E E' sg' VP.unpk)) (o-assoc ET E E' E tu' sg' VP.unpk) >
                  o ET E E (o E E' E tu' sg') VP.unpk
                =< ap (Sub E E) (Sub ET E) (\ t -> o ET E E t VP.unpk) (o E E' E tu' sg') (id E) e' >
                  o ET E E (id E) VP.unpk
                =< o-idl ET E VP.unpk >
                  VP.unpk }) >
          o ET E ET VP.X VP.unpk
        =< XUm[G, A, P].XU >
          id ET } ;

    -- p of the pack after a map over G.A
    pX' (D : Ctx) (m : Sub D E') (n : Sub D E) (pm : Id (Sub D (ext G A)) (o D E' (ext G A) (p (ext G A) P') m) (o D E (ext G A) (p (ext G A) P) n))
      : Id (Sub D G) (o D ET' G (p G T') (o D E' ET' VQ.X m)) (o D E G VP.pp n) =
      calc (Sub D G) {
          o D ET' G (p G T') (o D E' ET' VQ.X m)
        =< sym (Sub D G) (o D E' G (o E' ET' G (p G T') VQ.X) m) (o D ET' G (p G T') (o D E' ET' VQ.X m)) (o-assoc D E' ET' G (p G T') VQ.X m) >
          o D E' G (o E' ET' G (p G T') VQ.X) m
        =< ap (Sub E' G) (Sub D G) (\ t -> o D E' G t m) (o E' ET' G (p G T') VQ.X) VQ.pp VQ.pX >
          o D E' G (o E' (ext G A) G (p G A) (p (ext G A) P')) m
        =< o-assoc D E' (ext G A) G (p G A) (p (ext G A) P') m >
          o D (ext G A) G (p G A) (o D E' (ext G A) (p (ext G A) P') m)
        =< ap (Sub D (ext G A)) (Sub D G) (\ t -> o D (ext G A) G (p G A) t) (o D E' (ext G A) (p (ext G A) P') m) (o D E (ext G A) (p (ext G A) P) n) pm >
          o D (ext G A) G (p G A) (o D E (ext G A) (p (ext G A) P) n)
        =< sym (Sub D G) (o D E G (o E (ext G A) G (p G A) (p (ext G A) P)) n) (o D (ext G A) G (p G A) (o D E (ext G A) (p (ext G A) P) n)) (o-assoc D E (ext G A) G (p G A) (p (ext G A) P) n) >
          o D E G VP.pp n } ;

    psg : Id (Sub ET G) (o ET ET' G (p G T') sg) (p G T) =
      calc (Sub ET G) {
          o ET ET' G (p G T') (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk)
        =< sym (Sub ET G) (o ET E G (o E ET' G (p G T') (o E E' ET' VQ.X sg')) VP.unpk) (o ET ET' G (p G T') (o ET E ET' (o E E' ET' VQ.X sg') VP.unpk))
              (o-assoc ET E ET' G (p G T') (o E E' ET' VQ.X sg') VP.unpk) >
          o ET E G (o E ET' G (p G T') (o E E' ET' VQ.X sg')) VP.unpk
        =< ap (Sub E G) (Sub ET G) (\ t -> o ET E G t VP.unpk) (o E ET' G (p G T') (o E E' ET' VQ.X sg')) (o E E G VP.pp (id E))
              (pX' E sg' (id E) (trans (Sub E (ext G A)) (o E E' (ext G A) (p (ext G A) P') sg') (p (ext G A) P) (o E E (ext G A) (p (ext G A) P) (id E)) psg'
                                    (sym (Sub E (ext G A)) (o E E (ext G A) (p (ext G A) P) (id E)) (p (ext G A) P) (o-idr E (ext G A) (p (ext G A) P))))) >
          o ET E G (o E E G VP.pp (id E)) VP.unpk
        =< ap (Sub E G) (Sub ET G) (\ t -> o ET E G t VP.unpk) (o E E G VP.pp (id E)) VP.pp (o-idr E G VP.pp) >
          o ET E G VP.pp VP.unpk
        =< VP.pp-unpk >
          p G T } ;

    ptu : Id (Sub ET' G) (o ET' ET G (p G T) tu) (p G T') =
      calc (Sub ET' G) {
          o ET' ET G (p G T) (o ET' E' ET (o E' E ET VP.X tu') VQ.unpk)
        =< sym (Sub ET' G) (o ET' E' G (o E' ET G (p G T) (o E' E ET VP.X tu')) VQ.unpk) (o ET' ET G (p G T) (o ET' E' ET (o E' E ET VP.X tu') VQ.unpk))
              (o-assoc ET' E' ET G (p G T) (o E' E ET VP.X tu') VQ.unpk) >
          o ET' E' G (o E' ET G (p G T) (o E' E ET VP.X tu')) VQ.unpk
        =< ap (Sub E' G) (Sub ET' G) (\ t -> o ET' E' G t VQ.unpk) (o E' ET G (p G T) (o E' E ET VP.X tu')) VQ.pp
              (calc (Sub E' G) {
                  o E' ET G (p G T) (o E' E ET VP.X tu')
                =< sym (Sub E' G) (o E' E G (o E ET G (p G T) VP.X) tu') (o E' ET G (p G T) (o E' E ET VP.X tu')) (o-assoc E' E ET G (p G T) VP.X tu') >
                  o E' E G (o E ET G (p G T) VP.X) tu'
                =< ap (Sub E G) (Sub E' G) (\ t -> o E' E G t tu') (o E ET G (p G T) VP.X) VP.pp VP.pX >
                  o E' E G (o E (ext G A) G (p G A) (p (ext G A) P)) tu'
                =< o-assoc E' E (ext G A) G (p G A) (p (ext G A) P) tu' >
                  o E' (ext G A) G (p G A) (o E' E (ext G A) (p (ext G A) P) tu')
                =< ap (Sub E' (ext G A)) (Sub E' G) (\ t -> o E' (ext G A) G (p G A) t) (o E' E (ext G A) (p (ext G A) P) tu') (p (ext G A) P') ptu' >
                  VQ.pp }) >
          o ET' E' G VQ.pp VQ.unpk
        =< VQ.pp-unpk >
          p G T' } ;

    module CRT = CR[G, T, T', sg, psg, tu, ptu, e] ;
  } ;
} ;
