-- CwFTr.seg (M1 step 3, S4 toolkit): transport in a family along a Swan
-- Id path, in a CwF with Pi, Sigma and Swan Id.
--
-- Informal text.  Let P be a type over G.A, x y : A, u : Id(x , y) and
-- v : P(x).
-- (1) The motive is P read over the context Dx = G.A.Id(x p , q) of J
--     through the projection: CMt = P p.  At the centre it is P(x), at the
--     point (y , u) it is P(y) (CwFJ.wT-inst; the centre IS the point
--     (x , refl) with the identity path, by definition).
-- (2) trP P u v = (J CMt v) at the point (y , u), read in P(y).
-- (3) trP P refl v = v: the point (x , refl x) is the centre
--     (CwFJ.instRefl), so the value is J at the centre (CwFId.subtEq), which
--     is v by J-beta (CwFJ.Jb).

open Base ;

module Tr (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;

  -- (1) the motive and its value at the centre
  CMt (G : Ctx) (A : Ty G) (x : El G A) (P : Ty (ext G A)) : Ty (JP.Dx G A x) = wkT (ext G A) (JP.IK G A x) P ;

  I0 (G : Ctx) (A : Ty G) (x : El G A) : Ty G = subT G (ext G A) (JP.IK G A x) (sec G A x) ;

  PCen (G : Ctx) (A : Ty G) (x : El G A) (P : Ty (ext G A))
    : Id (Ty G) (subT G (JP.Dx G A x) (CMt G A x P) (DJ.cen G A x)) (subT G (ext G A) P (sec G A x)) =
    JP.wT-inst G A (JP.IK G A x) x (I0 G A x) (refl (I0 G A x)) (DJ.reflE G A x) P ;

  JT (G : Ctx) (A : Ty G) (x : El G A) (P : Ty (ext G A)) (v : El G (subT G (ext G A) P (sec G A x)))
    : El (JP.Dx G A x) (CMt G A x P) =
    IJ.J G A x (CMt G A x P)
      (trE G (subT G (ext G A) P (sec G A x)) (subT G (JP.Dx G A x) (CMt G A x P) (DJ.cen G A x))
         (sym (Ty G) (subT G (JP.Dx G A x) (CMt G A x P) (DJ.cen G A x)) (subT G (ext G A) P (sec G A x)) (PCen G A x P)) v) ;

  -- (2) the point (y , u), and the transport
  ptY (G : Ctx) (A : Ty G) (x y : El G A) (u : El G (IJ.IdT G A x y)) : Sub G (JP.Dx G A x) =
    JP.instG G A (JP.IK G A x) y (IJ.IdT G A x y) (JP.IKpt G A x y) u ;

  PPt (G : Ctx) (A : Ty G) (P : Ty (ext G A)) (x y : El G A) (u : El G (IJ.IdT G A x y))
    : Id (Ty G) (subT G (JP.Dx G A x) (CMt G A x P) (ptY G A x y u)) (subT G (ext G A) P (sec G A y)) =
    JP.wT-inst G A (JP.IK G A x) y (IJ.IdT G A x y) (JP.IKpt G A x y) u P ;

  trP (G : Ctx) (A : Ty G) (P : Ty (ext G A)) (x y : El G A) (u : El G (IJ.IdT G A x y))
    (v : El G (subT G (ext G A) P (sec G A x))) : El G (subT G (ext G A) P (sec G A y)) =
    trE G (subT G (JP.Dx G A x) (CMt G A x P) (ptY G A x y u)) (subT G (ext G A) P (sec G A y)) (PPt G A P x y u)
      (subt G (JP.Dx G A x) (CMt G A x P) (JT G A x P v) (ptY G A x y u)) ;

  -- (3) along refl
  tr-refl (G : Ctx) (A : Ty G) (P : Ty (ext G A)) (x : El G A) (v : El G (subT G (ext G A) P (sec G A x)))
    : Id (El G (subT G (ext G A) P (sec G A x))) (trP G A P x x (IJ.rfl G A x) v) v =
    trans (El G (subT G (ext G A) P (sec G A x)))
      (trP G A P x x (IJ.rfl G A x) v)
      (trE G (subT G (JP.Dx G A x) (CMt G A x P) (DJ.cen G A x)) (subT G (ext G A) P (sec G A x)) (PCen G A x P)
         (subt G (JP.Dx G A x) (CMt G A x P) (JT G A x P v) (DJ.cen G A x)))
      v
      (SJ.subtEq G (JP.Dx G A x) (CMt G A x P) (JT G A x P v) (ptY G A x x (IJ.rfl G A x)) (DJ.cen G A x) (JP.instRefl G A x)
         (subT G (ext G A) P (sec G A x)) (PPt G A P x x (IJ.rfl G A x)) (PCen G A x P))
      (JP.Jb G A x (CMt G A x P) (subT G (ext G A) P (sec G A x)) (PCen G A x P) (PCen G A x P) v) ;

  -- J-beta for JT, read at the centre
  JT-beta (G : Ctx) (A : Ty G) (x : El G A) (P : Ty (ext G A)) (v : El G (subT G (ext G A) P (sec G A x)))
    : Ov G (JP.Dx G A x) (CMt G A x P) (DJ.cen G A x) (subT G (ext G A) P (sec G A x)) (PCen G A x P) (JT G A x P v) v =
    JP.Jb G A x (CMt G A x P) (subT G (ext G A) P (sec G A x)) (PCen G A x P) (PCen G A x P) v ;

  opaque JT ;
} ;
