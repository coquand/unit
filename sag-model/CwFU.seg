-- CwFU.seg (M1, step 3): a Tarski universe in a CwF (the interface record
-- of M1.md decision 1, next to CwFId).  A type Cod of codes in every
-- context and a decoding Dec of its elements into types, both stable under
-- substitution.  Closure of the codes under Pi, Sigma, Id is a further
-- record (not yet).
--
-- The substituted code subU c s is c[s] read in Cod D along Cod-nat.  It is
-- the module DerU[Cod, Cod-nat], not a derived member of the record, so
-- that an instance names the same term (as CwFId.Der).

open Base ;

module Univ (l : Level) (C : CwF.CwF[l]) {
  open Prelude[l] ;
  open C ;

  module DerU (Cod : (G : Ctx) -> Ty G)
    (Cod-nat : (D G : Ctx) (s : Sub D G) -> Id (Ty D) (subT D G (Cod G) s) (Cod D)) {

    subU (D G : Ctx) (c : El G (Cod G)) (s : Sub D G) : El D (Cod D) =
      subst (Ty D) (El D) (subT D G (Cod G) s) (Cod D) (Cod-nat D G s) (subt D G (Cod G) c s) ;
  } ;

  record UnivStr {
    Cod (G : Ctx) : Ty G ;
    Cod-nat (D G : Ctx) (s : Sub D G) : Id (Ty D) (subT D G (Cod G) s) (Cod D) ;

    Dec (G : Ctx) (c : El G (Cod G)) : Ty G ;
    Dec-nat (D G : Ctx) (c : El G (Cod G)) (s : Sub D G)
      : Id (Ty D) (subT D G (Dec G c) s) (Dec D (DerU[Cod, Cod-nat].subU D G c s)) ;
  } ;
} ;

------------------------------------------------------------------------
-- Univalence (ruling 2026-11-09: the interface field is UaContr, with the
-- source's bi-invertible equivalences of CwFEq).  For a code a over G,
-- over K = G.Cod the type
--     UaT a = Sigma (b : Cod) Equiv(Dec a , Dec b)
-- (Dec a weakened, b the last variable read in Cod along Cod-nat; the
-- family over G.Cod is PB a), and the field: a natural element of
-- isContr (UaT a).  PB-ov, UaT-ov': for a over a', PB a and UaT a are
-- over PB a', UaT a'; the code b is over b by q-ov read along Cod-nat
-- (ovTr).

module UnivUa (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module DU = Univ[l, C].DerU[Un.Cod, Un.Cod-nat] ;

  -- the last variable of G.Cod, as a code
  qc (G : Ctx) : El (ext G (Un.Cod G)) (Un.Cod (ext G (Un.Cod G))) =
    trE (ext G (Un.Cod G)) (wkT G (Un.Cod G) (Un.Cod G)) (Un.Cod (ext G (Un.Cod G)))
      (Un.Cod-nat (ext G (Un.Cod G)) G (p G (Un.Cod G))) (q G (Un.Cod G)) ;

  -- the family of equivalences from Dec a, over G.Cod
  PB (G : Ctx) (a : El G (Un.Cod G)) : Ty (ext G (Un.Cod G)) =
    EQ.Equiv (ext G (Un.Cod G)) (wkT G (Un.Cod G) (Un.Dec G a)) (Un.Dec (ext G (Un.Cod G)) (qc G)) ;

  UaT (G : Ctx) (a : El G (Un.Cod G)) : Ty G = SS.Sig G (Un.Cod G) (PB G a) ;

  -- qc is over qc
  qc-ov (D G : Ctx) (s : Sub D G)
    : Ov (ext D (Un.Cod D)) (ext G (Un.Cod G)) (Un.Cod (ext G (Un.Cod G))) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s))
         (Un.Cod (ext D (Un.Cod D)))
         (Un.Cod-nat (ext D (Un.Cod D)) (ext G (Un.Cod G)) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)))
         (qc G) (qc D) =
    ovTr K' K (wkT G (Un.Cod G) (Un.Cod G)) (Un.Cod K) (Un.Cod-nat K G (p G (Un.Cod G))) s1
      (wkT D (Un.Cod D) (Un.Cod D)) (Un.Cod K') (Un.Cod-nat K' D (p D (Un.Cod D))) PW (Un.Cod-nat K' K s1)
      (q G (Un.Cod G)) (q D (Un.Cod D)) (q-ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) PW)
   where {
    K : Ctx = ext G (Un.Cod G) ;
    K' : Ctx = ext D (Un.Cod D) ;
    s1 : Sub K' K = upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) ;
    PW : Id (Ty K') (subT K' K (wkT G (Un.Cod G) (Un.Cod G)) s1) (wkT D (Un.Cod D) (Un.Cod D)) =
      wkT-ov D G (Un.Cod G) (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) (Un.Cod D) (Un.Cod-nat D G s) ;
   } ;

  -- a over a' along s: PB a over PB a' along the lift of s
  PB-ov (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G) (a' : El D (Un.Cod D))
    (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    : Id (Ty (ext D (Un.Cod D))) (subT (ext D (Un.Cod D)) (ext G (Un.Cod G)) (PB G a) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)))
         (PB D a') =
    EQ.Equiv-ov K' K Da (Un.Dec K (qc G)) s1 Da'
      (wkT-ov D G (Un.Cod G) (Un.Dec G a) s (Un.Cod D) (Un.Cod-nat D G s) (Un.Dec D a')
         (trans (Ty D) (subT D G (Un.Dec G a) s) (Un.Dec D (DU.subU D G a s)) (Un.Dec D a')
            (Un.Dec-nat D G a s) (ap (El D (Un.Cod D)) (Ty D) (\ c -> Un.Dec D c) (DU.subU D G a s) a' Pa)))
      (Un.Dec K' (qc D))
      (trans (Ty K') (subT K' K (Un.Dec K (qc G)) s1) (Un.Dec K' (DU.subU K' K (qc G) s1)) (Un.Dec K' (qc D))
         (Un.Dec-nat K' K (qc G) s1)
         (ap (El K' (Un.Cod K')) (Ty K') (\ c -> Un.Dec K' c) (DU.subU K' K (qc G) s1) (qc D) (qc-ov D G s)))
   where {
    K : Ctx = ext G (Un.Cod G) ;
    K' : Ctx = ext D (Un.Cod D) ;
    Da : Ty K = wkT G (Un.Cod G) (Un.Dec G a) ;
    Da' : Ty K' = wkT D (Un.Cod D) (Un.Dec D a') ;
    s1 : Sub K' K = upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) ;
   } ;

  UaT-ov' (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G) (a' : El D (Un.Cod D))
    (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    : Id (Ty D) (subT D G (UaT G a) s) (UaT D a') =
    Sig-ov D G (Un.Cod G) (PB G a) s (Un.Cod D) (Un.Cod-nat D G s) (PB D a') (PB-ov D G a s a' Pa) ;

  UaT-ov (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G)
    : Id (Ty D) (subT D G (UaT G a) s) (UaT D (DU.subU D G a s)) =
    UaT-ov' D G a s (DU.subU D G a s) (refl (DU.subU D G a s)) ;

  record UaStr {
    UaContr (G : Ctx) (a : El G (Un.Cod G)) : El G (EQ.isContr G (UaT G a)) ;
    UaContr-nat (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G)
      : Ov D G (EQ.isContr G (UaT G a)) s (EQ.isContr D (UaT D (DU.subU D G a s)))
           (EQ.isContr-ov D G (UaT G a) s (UaT D (DU.subU D G a s)) (UaT-ov D G a s))
           (UaContr G a) (UaContr D (DU.subU D G a s)) ;
  } ;
} ;
