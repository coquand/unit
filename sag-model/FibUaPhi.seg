-- FibUaPhi.seg (M1 step 3, S4, the map g, part 2): the classifying map
-- Phi : R -> T3 of the universal data over R = resCtx, and its public laws.
-- g and H use these laws only, never the three extS and their transports.
--
-- Informal text.
-- (1) A map s : G -> U is an element of Cod G (elOf).  aEl = elOf (pA o
--     inclR) (the code A of a datum), bEl = elOf bmap (its B at id).
-- (2) Phi0 = chi aEl : R -> U0; Phi1 = (Phi0 , bEl) : R -> U0.Cod.
--     X0 and Y0 along Phi1 are Xd and Yd (PXd, PYd): both are El along a
--     composite map into U, whose values are those of aEl, bEl (a0-pt,
--     qc-pt, then elTr: chi and the extS transport along Cod-nat).
-- (3) Phi2 = (Phi1 , rd) along Fun-ov; Phi3 = (Phi2 , kd) along Kr-ov,
--     whose over-path Pr says that the variable r1 along Phi2 is rd: r1 is
--     q transported (teTrS), q along extS is the transported rd (q-extS),
--     which is a transport of rd (teTrS).
-- Laws.  (Phi-x) the code of Phi3 w is aMap w; (Phi-b) its b is bmap w;
-- (Phi-r) Pr, with the type paths PX1, PY1, PR; (Phi-k) the variable
-- of T3 along Phi3 is kd up to a transport (TE).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module FCw = FibCwF[a, a+] ;
module UU = CPosEl1[a].UU ;
module Un = FibUniv[a] ;
module UF = FibUaF[a] ;
module UG = FibUaG[a] ;
module UW = UF.UW ;
open CwFOv.Ov[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId] ;

-- extS of a given CwF (a derived member is reached through a CwF variable)
module XS (C : CwF.CwF[a++]) {
  extS (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (a : C.El D (C.subT D G A s)) : C.Sub D (C.ext G A) = C.extS D G A s a ;
} ;

------------------------------------------------------------------------
-- (1) maps into U as codes

elOf (G : L.PCtx) (s : L.PSub[G, UU.UCtx]) : FCw.fibCwF.El G (FibUniv[a].fibUniv.Cod G) =
  new L.PEl[G, (FibUniv[a].fibUniv.Cod G).1, \ I x -> s.nt I x,
    \ J I f x y e -> transH (symH (s.nt-nat J I f x)) (apH (s.nt J) e)] ;

aMap : L.PSub[UG.R, UU.UCtx] = FCw.fibCwF.o UG.R UG.UB.GDr UU.UCtx UG.UB.pA UG.UB.CU.inclR ;

aEl : FCw.fibCwF.El UG.R (FibUniv[a].fibUniv.Cod UG.R) = elOf UG.R aMap ;
bEl : FCw.fibCwF.El UG.R (FibUniv[a].fibUniv.Cod UG.R) = elOf UG.R UG.UB.bmap ;

------------------------------------------------------------------------
-- (2) Phi0, Phi1 and the types X0 , Y0 along Phi1

Phi0 : FCw.fibCwF.Sub UG.R UF.CH.U0 = UF.CH.chi UG.R aEl ;

bR : FCw.fibCwF.El UG.R (FCw.fibCwF.subT UG.R UF.CH.U0 (FibUniv[a].fibUniv.Cod UF.CH.U0) Phi0) =
  trE UG.R (FibUniv[a].fibUniv.Cod UG.R) (FCw.fibCwF.subT UG.R UF.CH.U0 (FibUniv[a].fibUniv.Cod UF.CH.U0) Phi0)
    (symH (FibUniv[a].fibUniv.Cod-nat UG.R UF.CH.U0 Phi0)) bEl ;

Phi1 : FCw.fibCwF.Sub UG.R UF.Gb = XS[FCw.fibCwF].extS UG.R UF.CH.U0 (FibUniv[a].fibUniv.Cod UF.CH.U0) Phi0 bR ;

-- (Phi-x) the code of Phi at w
PhiX (W : Ob) (w : V1.Ix (UG.R.ob W))
  : Id (UU.U0 W) (L.sndE FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil).1 W (Phi0.nt W w)) (aMap.nt W w) =
  FibIdRd[a, a+].elTr UG.R (FCw.fibCwF.Ty UG.R) (\ Z -> Z.1) (FibUniv[a].fibUniv.Cod UG.R)
    (FCw.fibCwF.subT UG.R FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil) (FCw.fibCwF.eps UG.R))
    (sym (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil) (FCw.fibCwF.eps UG.R)) (FibUniv[a].fibUniv.Cod UG.R)
       (FibUniv[a].fibUniv.Cod-nat UG.R FCw.fibCwF.nil (FCw.fibCwF.eps UG.R)))
    aEl W w (refl (UU.codeU W)) ;

-- (Phi-b) the b of Phi at w
PhiB (W : Ob) (w : V1.Ix (UG.R.ob W))
  : Id (UU.U0 W) (L.sndE UF.CH.U0 (FibUniv[a].fibUniv.Cod UF.CH.U0).1 W (Phi1.nt W w)) (UG.UB.bmap.nt W w) =
  FibIdRd[a, a+].elTr UG.R (FCw.fibCwF.Ty UG.R) (\ Z -> Z.1) (FibUniv[a].fibUniv.Cod UG.R)
    (FCw.fibCwF.subT UG.R UF.CH.U0 (FibUniv[a].fibUniv.Cod UF.CH.U0) Phi0)
    (symH (FibUniv[a].fibUniv.Cod-nat UG.R UF.CH.U0 Phi0)) bEl W w (refl (UU.codeU W)) ;

PXd : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.Gb UW.X0 Phi1) UG.Xd =
  transH (apH (\ B -> FCw.fibCwF.subT UG.R UF.Gb B Phi1) UF.eX0)
  (transH (symH (FCw.fibCwF.subT-o UG.R UF.Gb UU.UCtx Un.ElF UF.c1 Phi1))
  (transH (apH (\ s -> FCw.fibCwF.subT UG.R UU.UCtx Un.ElF s)
             (L.sub-ext UG.R UU.UCtx (FCw.fibCwF.o UG.R UF.Gb UU.UCtx UF.c1 Phi1) aMap
                (\ W w -> transH (UF.a0-pt W (Phi0.nt W w)) (PhiX W w))))
          (FCw.fibCwF.subT-o UG.R UG.UB.GDr UU.UCtx Un.ElF UG.UB.pA UG.UB.CU.inclR))) ;

PYd : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.Gb UW.Y0 Phi1) UG.Yd =
  transH (symH (FCw.fibCwF.subT-o UG.R UF.Gb UU.UCtx Un.ElF UF.d0 Phi1))
         (apH (\ s -> FCw.fibCwF.subT UG.R UU.UCtx Un.ElF s)
            (L.sub-ext UG.R UU.UCtx (FCw.fibCwF.o UG.R UF.Gb UU.UCtx UF.d0 Phi1) UG.UB.bmap
               (\ W w -> transH (UF.qc-pt W (Phi1.nt W w)) (PhiB W w)))) ;

------------------------------------------------------------------------
-- (3) Phi2 , Phi3

PF : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1) (Fun UG.R UG.Yd UG.Xd) =
  Fun-ov UG.R UF.Gb UW.Y0 UW.X0 Phi1 UG.Yd PYd UG.Xd PXd ;

rR : FCw.fibCwF.El UG.R (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1) =
  trE UG.R (Fun UG.R UG.Yd UG.Xd) (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1) (symH PF) UG.rd ;

Phi2 : FCw.fibCwF.Sub UG.R UF.QV.G1 = XS[FCw.fibCwF].extS UG.R UF.Gb UF.QV.FYX Phi1 rR ;

PX1 : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.X1 Phi2) UG.Xd =
  transH (UW.IN.wkT-extS UG.R UF.Gb UF.QV.FYX UW.X0 Phi1 rR) PXd ;

PY1 : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.Y1 Phi2) UG.Yd =
  transH (UW.IN.wkT-extS UG.R UF.Gb UF.QV.FYX UW.Y0 Phi1 rR) PYd ;

PR : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) Phi2) (Fun UG.R UG.Yd UG.Xd) =
  Fun-ov UG.R UF.QV.G1 UF.QV.Y1 UF.QV.X1 Phi2 UG.Yd PY1 UG.Xd PX1 ;

-- (Phi-r) the variable r1 along Phi2 is rd
Pr : Ov UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) Phi2 (Fun UG.R UG.Yd UG.Xd) PR UF.QV.r1 UG.rd =
  UW.IN.teAny UG.R (FCw.fibCwF.subT UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) Phi2) (Fun UG.R UG.Yd UG.Xd)
    (FCw.fibCwF.subt UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) UF.QV.r1 Phi2) UG.rd
    (UW.IN.teT UG.R (FCw.fibCwF.subT UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) Phi2) (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1) (Fun UG.R UG.Yd UG.Xd)
       (FCw.fibCwF.subt UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) UF.QV.r1 Phi2) rR UG.rd
       (UW.IN.teT UG.R (FCw.fibCwF.subT UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) Phi2) (FCw.fibCwF.subT UG.R UF.QV.G1 (wkT UF.Gb UF.QV.FYX UF.QV.FYX) Phi2)
          (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1)
          (FCw.fibCwF.subt UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) UF.QV.r1 Phi2) (FCw.fibCwF.subt UG.R UF.QV.G1 (wkT UF.Gb UF.QV.FYX UF.QV.FYX) (FCw.fibCwF.q UF.Gb UF.QV.FYX) Phi2) rR
          (UW.SV.teSub UG.R UF.QV.G1 (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) (wkT UF.Gb UF.QV.FYX UF.QV.FYX) UF.QV.r1 (FCw.fibCwF.q UF.Gb UF.QV.FYX)
             (UW.PJ.teTrS UF.QV.G1 (wkT UF.Gb UF.QV.FYX UF.QV.FYX) (Fun UF.QV.G1 UF.QV.Y1 UF.QV.X1) (UW.EQ.wkFP UF.Gb UF.QV.FYX UW.Y0 UW.X0) (FCw.fibCwF.q UF.Gb UF.QV.FYX)) Phi2)
          (UW.IN.teOv UG.R UF.QV.G1 (wkT UF.Gb UF.QV.FYX UF.QV.FYX) Phi2 (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1) (UW.IN.wkT-extS UG.R UF.Gb UF.QV.FYX UF.QV.FYX Phi1 rR)
             (FCw.fibCwF.q UF.Gb UF.QV.FYX) rR (UW.JP.q-extS UG.R UF.Gb UF.QV.FYX Phi1 rR (UW.IN.wkT-extS UG.R UF.Gb UF.QV.FYX UF.QV.FYX Phi1 rR))))
       (UW.PJ.teTrS UG.R (Fun UG.R UG.Yd UG.Xd) (FCw.fibCwF.subT UG.R UF.Gb UF.QV.FYX Phi1) (symH PF) UG.rd))
    PR ;

PK : Id (FCw.fibCwF.Ty UG.R) (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.K1 Phi2) (UW.QP.Kr UG.R UG.Xd UG.Yd UG.rd) =
  UW.QP.Kr-ov UG.R UF.QV.G1 UF.QV.X1 UF.QV.Y1 UF.QV.r1 Phi2 UG.Xd PX1 UG.Yd PY1 PR UG.rd Pr ;

kR : FCw.fibCwF.El UG.R (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.K1 Phi2) =
  trE UG.R (UW.QP.Kr UG.R UG.Xd UG.Yd UG.rd) (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.K1 Phi2) (symH PK) UG.kd ;

Phi3 : FCw.fibCwF.Sub UG.R UF.T3 = XS[FCw.fibCwF].extS UG.R UF.QV.G1 UF.QV.K1 Phi2 kR ;

-- (Phi-k) the variable k of T3 along Phi3 is kd
Pk : UW.IN.TE UG.R (FCw.fibCwF.subT UG.R UF.T3 (wkT UF.QV.G1 UF.QV.K1 UF.QV.K1) Phi3) (UW.QP.Kr UG.R UG.Xd UG.Yd UG.rd)
       (FCw.fibCwF.subt UG.R UF.T3 (wkT UF.QV.G1 UF.QV.K1 UF.QV.K1) (FCw.fibCwF.q UF.QV.G1 UF.QV.K1) Phi3) UG.kd =
  UW.IN.teT UG.R (FCw.fibCwF.subT UG.R UF.T3 (wkT UF.QV.G1 UF.QV.K1 UF.QV.K1) Phi3) (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.K1 Phi2) (UW.QP.Kr UG.R UG.Xd UG.Yd UG.rd)
    (FCw.fibCwF.subt UG.R UF.T3 (wkT UF.QV.G1 UF.QV.K1 UF.QV.K1) (FCw.fibCwF.q UF.QV.G1 UF.QV.K1) Phi3) kR UG.kd
    (UW.IN.teOv UG.R UF.T3 (wkT UF.QV.G1 UF.QV.K1 UF.QV.K1) Phi3 (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.K1 Phi2) (UW.IN.wkT-extS UG.R UF.QV.G1 UF.QV.K1 UF.QV.K1 Phi2 kR)
       (FCw.fibCwF.q UF.QV.G1 UF.QV.K1) kR (UW.JP.q-extS UG.R UF.QV.G1 UF.QV.K1 Phi2 kR (UW.IN.wkT-extS UG.R UF.QV.G1 UF.QV.K1 UF.QV.K1 Phi2 kR)))
    (UW.PJ.teTrS UG.R (UW.QP.Kr UG.R UG.Xd UG.Yd UG.rd) (FCw.fibCwF.subT UG.R UF.QV.G1 UF.QV.K1 Phi2) (symH PK) UG.kd) ;

opaque PXd ; opaque PYd ; opaque Pr ; opaque Pk ;
