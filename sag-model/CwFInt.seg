-- CwFInt.seg (M1 step 3, S5 toolkit): internal constructions in a CwF
-- with Pi, Sigma and Swan Id, over the over-calculus of CwFOv.
--
-- Informal text.
-- (1) Along sec a: (B p)[sec a] = B (p-sec-T), (b p)[sec a] = b
--     (wk-sec), q[sec a] = a (q-sec); for functions through ovTr.
-- (2) Pairs and projections are Sig-iso and its inverse; fst-nat: the
--     first projection of w[s] (read in a Sigma type along any path) is
--     (fst w)[s], from Sig-iso-nat and the iso laws (as bodNat).
-- (3) Dependent application appD f a = (bod f)[sec a]; appD-nat as
--     app-nat (both sides are (bod f)[lift s][sec a[s]], sq at sec-o);
--     lam-ov from Pi-iso-nat.
-- (4) An equality of elements gives an element of Id (refl, transported).
--     The identity function: app id x = x (fun-inv, q-sec); weakened it
--     is the identity (lam-ov along p, q-ov).
-- (5) mkIsEquiv packs sec, sec-eq, ret, ret-eq: the types of the
--     second components along sec g, sec eta, sec h are computed by
--     Sig-ov, Htpy-ov, RetT-ov with the leaves of (1).  The identity
--     equivalence idE.

open Base ;

module Int (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;

  ----------------------------------------------------------------------
  -- (1) leaves along sec

  wkE-sec (G : Ctx) (A B : Ty G) (a : El G A) (b : El G B)
    (PW : Id (Ty G) (subT G (ext G A) (wkT G A B) (sec G A a)) B)
    : Ov G (ext G A) (wkT G A B) (sec G A a) B PW (wkE G A B b) b =
    ovRe G (ext G A) (wkT G A B) (sec G A a) B (p-sec-T G A B a) PW (wkE G A B b) b (SJ.wk-sec G A B a b) ;

  q-secO (G : Ctx) (A : Ty G) (a : El G A) (PW : Id (Ty G) (subT G (ext G A) (wkT G A A) (sec G A a)) A)
    : Ov G (ext G A) (wkT G A A) (sec G A a) A PW (q G A) a =
    ovRe G (ext G A) (wkT G A A) (sec G A a) A (p-sec-T G A A a) PW (q G A) a (q-sec G A a) ;

  wkF-sec (G : Ctx) (X A B : Ty G) (x : El G X) (f : El G (Fun G A B))
    (PW : Id (Ty G) (subT G (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (sec G X x)) (Fun G A B))
    : Ov G (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (sec G X x) (Fun G A B) PW (EQ.wkF G X A B f) f =
    ovTr G (ext G X) (wkT G X (Fun G A B)) (Fun (ext G X) (wkT G X A) (wkT G X B)) (EQ.wkFP G X A B) (sec G X x)
      (Fun G A B) (Fun G A B) (refl (Fun G A B)) (p-sec-T G X (Fun G A B) x) PW
      (wkE G X (Fun G A B) f) f (SJ.wk-sec G X (Fun G A B) x f) ;

  qF-sec (G : Ctx) (A B : Ty G) (g : El G (Fun G A B))
    (PW : Id (Ty G) (subT G (ext G (Fun G A B)) (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B))
                          (sec G (Fun G A B) g)) (Fun G A B))
    : Ov G (ext G (Fun G A B)) (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B))
         (sec G (Fun G A B) g) (Fun G A B) PW (EQ.qF G A B) g =
    ovTr G (ext G (Fun G A B)) (wkT G (Fun G A B) (Fun G A B))
      (Fun (ext G (Fun G A B)) (wkT G (Fun G A B) A) (wkT G (Fun G A B) B)) (EQ.wkFP G (Fun G A B) A B)
      (sec G (Fun G A B) g) (Fun G A B) (Fun G A B) (refl (Fun G A B)) (p-sec-T G (Fun G A B) (Fun G A B) g) PW
      (q G (Fun G A B)) g (q-sec G (Fun G A B) g) ;

  -- a weakened function type along sec
  FunSec (G : Ctx) (X A B : Ty G) (x : El G X)
    : Id (Ty G) (subT G (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X B)) (sec G X x)) (Fun G A B) =
    Fun-ov G (ext G X) (wkT G X A) (wkT G X B) (sec G X x) A (p-sec-T G X A x) B (p-sec-T G X B x) ;

  ----------------------------------------------------------------------
  -- (2) pairs and projections

  pr (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (x : El G A) (y : El G (subT G (ext G A) B (sec G A x)))
    : El G (SS.Sig G A B) = (SS.Sig-iso G A B).inv (x, y) ;

  fst (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (w : El G (SS.Sig G A B)) : El G A = ((SS.Sig-iso G A B).fun w).1 ;

  snd (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (w : El G (SS.Sig G A B))
    : El G (subT G (ext G A) B (sec G A (fst G A B w))) = ((SS.Sig-iso G A B).fun w).2 ;

  fst-pr (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (x : El G A) (y : El G (subT G (ext G A) B (sec G A x)))
    : Id (El G A) (fst G A B (pr G A B x y)) x =
    (sPath (El G A) (\ x2 -> El G (subT G (ext G A) B (sec G A x2))) ((SS.Sig-iso G A B).fun (pr G A B x y)) (x, y)
       ((SS.Sig-iso G A B).fun-inv (x, y))).1 ;

  snd-pr (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (x : El G A) (y : El G (subT G (ext G A) B (sec G A x)))
    : Id (El G (subT G (ext G A) B (sec G A x)))
         (subst (El G A) (\ x2 -> El G (subT G (ext G A) B (sec G A x2))) (fst G A B (pr G A B x y)) x
                (fst-pr G A B x y) (snd G A B (pr G A B x y)))
         y =
    (sPath (El G A) (\ x2 -> El G (subT G (ext G A) B (sec G A x2))) ((SS.Sig-iso G A B).fun (pr G A B x y)) (x, y)
       ((SS.Sig-iso G A B).fun-inv (x, y))).2 ;

  -- fst commutes with a transport of the second component's type
  fstTr (G : Ctx) (A : Ty G) (B B' : Ty (ext G A)) (Q : Id (Ty (ext G A)) B B') (w : El G (SS.Sig G A B))
    : Id (El G A) (fst G A B' (trE G (SS.Sig G A B) (SS.Sig G A B') (ap (Ty (ext G A)) (Ty G) (\ Y -> SS.Sig G A Y) B B' Q) w))
         (fst G A B w) =
    idJ (Ty (ext G A)) B
      (\ Y QY -> Id (El G A) (fst G A Y (trE G (SS.Sig G A B) (SS.Sig G A Y) (ap (Ty (ext G A)) (Ty G) (\ Y2 -> SS.Sig G A Y2) B Y QY) w))
                    (fst G A B w))
      (refl (fst G A B w)) B' Q ;

  -- the first projection is stable, read along any path
  fst-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (B' : Ty (ext D (subT D G A s)))
    (QB : Id (Ty (ext D (subT D G A s))) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) B')
    (F : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) B')) (w : El G (SS.Sig G A B))
    : Id (El D (subT D G A s)) (fst D (subT D G A s) B' (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) B') F (subt D G (SS.Sig G A B) w s)))
         (subt D G A (fst G A B w) s) =
    calc (El D As) {
        fst D As B' (trE D SG SB' F ws)
      =< ap (El D SB') (El D As) (\ v -> fst D As B' v) (trE D SG SB' F ws) (trE D SG SB' (trans (Ty D) SG SL SB' N QS) ws)
            (trE-irr D SG SB' F (trans (Ty D) SG SL SB' N QS) ws) >
        fst D As B' (trE D SG SB' (trans (Ty D) SG SL SB' N QS) ws)
      =< ap (El D SB') (El D As) (\ v -> fst D As B' v) (trE D SG SB' (trans (Ty D) SG SL SB' N QS) ws) (trE D SL SB' QS (trE D SG SL N ws))
            (sym (El D SB') (trE D SL SB' QS (trE D SG SL N ws)) (trE D SG SB' (trans (Ty D) SG SL SB' N QS) ws) (trE-tr D SG SL SB' N QS ws)) >
        fst D As B' (trE D SL SB' QS (trE D SG SL N ws))
      =< fstTr D As BL B' QB (trE D SG SL N ws) >
        fst D As BL (trE D SG SL N ws)
      =< ap (El D SL) (El D As) (\ v -> fst D As BL v) (trE D SG SL N ws) (pr D As BL (subt D G A x s) yS) step >
        fst D As BL (pr D As BL (subt D G A x s) yS)
      =< fst-pr D As BL (subt D G A x s) yS >
        subt D G A x s }
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
    SG : Ty D = subT D G (SS.Sig G A B) s ;
    SL : Ty D = SS.Sig D As BL ;
    SB' : Ty D = SS.Sig D As B' ;
    N : Id (Ty D) SG SL = SS.Sig-nat D G A B s ;
    QS : Id (Ty D) SL SB' = ap (Ty E) (Ty D) (\ Y -> SS.Sig D As Y) BL B' QB ;
    ws : El D SG = subt D G (SS.Sig G A B) w s ;
    x : El G A = fst G A B w ;
    y : El G (subT G (ext G A) B (sec G A x)) = snd G A B w ;
    yS : El D (subT D E BL (sec D As (subt D G A x s))) =
      trE D (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D E BL (sec D As (subt D G A x s)))
        (CwF.Formers[l, C].coerce D G A B x s) (subt D G (subT G (ext G A) B (sec G A x)) y s) ;
    step : Id (El D SL) (trE D SG SL N ws) (pr D As BL (subt D G A x s) yS) =
      trans (El D SL) (trE D SG SL N ws) (trE D SG SL N (subt D G (SS.Sig G A B) (pr G A B x y) s)) (pr D As BL (subt D G A x s) yS)
        (ap (El G (SS.Sig G A B)) (El D SL) (\ v -> trE D SG SL N (subt D G (SS.Sig G A B) v s)) w (pr G A B x y)
            (sym (El G (SS.Sig G A B)) (pr G A B x y) w ((SS.Sig-iso G A B).inv-fun w)))
        (SS.Sig-iso-nat D G A B x y s) ;
   } ;

  -- the first projection of an over-element is over
  fst-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (PW : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D A' B'))
    (w : El G (SS.Sig G A B)) (w' : El D (SS.Sig D A' B')) (Pw : Ov D G (SS.Sig G A B) s (SS.Sig D A' B') PW w w')
    : Ov D G A s A' PA (fst G A B w) (fst D A' B' w') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
         -> (PW2 : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D X B2)) -> (w2 : El D (SS.Sig D X B2))
         -> Ov D G (SS.Sig G A B) s (SS.Sig D X B2) PW2 w w2 -> Ov D G A s X PX (fst G A B w) (fst D X B2 w2))
      (\ B2 PB2 ->
         idJ (Ty E) BL
           (\ B3 PB3 -> (PW2 : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D As B3)) -> (w2 : El D (SS.Sig D As B3))
              -> Ov D G (SS.Sig G A B) s (SS.Sig D As B3) PW2 w w2 -> Ov D G A s As (refl As) (fst G A B w) (fst D As B3 w2))
           (\ PW2 w2 Pw2 ->
              idJ (El D (SS.Sig D As BL)) (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D As BL) PW2 (subt D G (SS.Sig G A B) w s))
                (\ w3 e3 -> Ov D G A s As (refl As) (fst G A B w) (fst D As BL w3))
                (sym (El D As) (fst D As BL (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D As BL) PW2 (subt D G (SS.Sig G A B) w s)))
                     (subt D G A (fst G A B w) s) (fst-nat D G A B s BL (refl BL) PW2 w))
                w2 Pw2)
           B2 PB2)
      A' PA B' PB PW w' Pw
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
   } ;

  ----------------------------------------------------------------------
  -- (3) dependent application, lam

  appD (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El G (PS.Pi G A B)) (a : El G A)
    : El G (subT G (ext G A) B (sec G A a)) = subt G (ext G A) B (bod G A B f) (sec G A a) ;

  appD-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G)
    (F : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))))
    (f : El G (PS.Pi G A B)) (a : El G A)
    (PT : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s)
                    (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) (sec D (subT D G A s) (subt D G A a s))))
    : Ov D G (subT G (ext G A) B (sec G A a)) s
         (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) (sec D (subT D G A s) (subt D G A a s))) PT
         (appD G A B f a)
         (appD D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
               (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) F
                    (subt D G (PS.Pi G A B) f s))
               (subt D G A a s)) =
    calc (El D T) {
        trE D (subT D G (subT G (ext G A) B (sec G A a)) s) T PT
          (subt D G (subT G (ext G A) B (sec G A a)) (subt G (ext G A) B (bod G A B f) (sec G A a)) s)
      =< sq D (ext G A) G E B (bod G A B f) (sec G A a) s (lift D G A s) (sec D As (subt D G A a s)) (sec-o D G A a s) T PT (refl T) >
        subt D E BL (subt E (ext G A) B (bod G A B f) (lift D G A s)) (sec D As (subt D G A a s))
      =< ap (El E BL) (El D T) (\ v -> subt D E BL v (sec D As (subt D G A a s)))
            (subt E (ext G A) B (bod G A B f) (lift D G A s)) (bod D As BL (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D As BL) F (subt D G (PS.Pi G A B) f s)))
            (sym (El E BL) (bod D As BL (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D As BL) F (subt D G (PS.Pi G A B) f s)))
                 (subt E (ext G A) B (bod G A B f) (lift D G A s)) (bodNat D G A B s BL (refl BL) F f)) >
        subt D E BL (bod D As BL (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D As BL) F (subt D G (PS.Pi G A B) f s))) (sec D As (subt D G A a s)) }
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
    T : Ty D = subT D E BL (sec D As (subt D G A a s)) ;
   } ;

  appD-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (PF : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D A' B'))
    (f : El G (PS.Pi G A B)) (f' : El D (PS.Pi D A' B')) (Pf : Ov D G (PS.Pi G A B) s (PS.Pi D A' B') PF f f')
    (a : El G A) (a' : El D A') (Pa : Ov D G A s A' PA a a')
    (PT : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s) (subT D (ext D A') B' (sec D A' a')))
    : Ov D G (subT G (ext G A) B (sec G A a)) s (subT D (ext D A') B' (sec D A' a')) PT (appD G A B f a) (appD D A' B' f' a') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
         -> (PF2 : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D X B2)) -> (f2 : El D (PS.Pi D X B2))
         -> Ov D G (PS.Pi G A B) s (PS.Pi D X B2) PF2 f f2 -> (a2 : El D X) -> Ov D G A s X PX a a2
         -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s) (subT D (ext D X) B2 (sec D X a2)))
         -> Ov D G (subT G (ext G A) B (sec G A a)) s (subT D (ext D X) B2 (sec D X a2)) PT2 (appD G A B f a) (appD D X B2 f2 a2))
      (\ B2 PB2 ->
         idJ (Ty E) BL
           (\ B3 PB3 -> (PF2 : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D As B3)) -> (f2 : El D (PS.Pi D As B3))
              -> Ov D G (PS.Pi G A B) s (PS.Pi D As B3) PF2 f f2 -> (a2 : El D As) -> Ov D G A s As (refl As) a a2
              -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s) (subT D E B3 (sec D As a2)))
              -> Ov D G (subT G (ext G A) B (sec G A a)) s (subT D E B3 (sec D As a2)) PT2 (appD G A B f a) (appD D As B3 f2 a2))
           (\ PF2 f2 Pf2 a2 Pa2 ->
              idJ (El D As) (subt D G A a s)
                (\ a3 e3 -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s) (subT D E BL (sec D As a3)))
                   -> Ov D G (subT G (ext G A) B (sec G A a)) s (subT D E BL (sec D As a3)) PT2 (appD G A B f a) (appD D As BL f2 a3))
                (idJ (El D (PS.Pi D As BL)) (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D As BL) PF2 (subt D G (PS.Pi G A B) f s))
                   (\ f3 e4 -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A a)) s) (subT D E BL (sec D As (subt D G A a s))))
                      -> Ov D G (subT G (ext G A) B (sec G A a)) s (subT D E BL (sec D As (subt D G A a s))) PT2 (appD G A B f a)
                            (appD D As BL f3 (subt D G A a s)))
                   (\ PT2 -> appD-nat D G A B s PF2 f a PT2) f2 Pf2)
                a2 Pa2)
           B2 PB2)
      A' PA B' PB PF f' Pf a' Pa PT
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
   } ;

  lam-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (PF : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D A' B'))
    (b : El (ext G A) B) (b' : El (ext D A') B') (Pb : Ov (ext D A') (ext G A) B (upT D G A s A' PA) B' PB b b')
    : Ov D G (PS.Pi G A B) s (PS.Pi D A' B') PF (lam G A B b) (lam D A' B' b') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> (PB2 : Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2)
         -> (PF2 : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D X B2)) -> (b2 : El (ext D X) B2)
         -> Ov (ext D X) (ext G A) B (upT D G A s X PX) B2 PB2 b b2 -> Ov D G (PS.Pi G A B) s (PS.Pi D X B2) PF2 (lam G A B b) (lam D X B2 b2))
      (\ B2 PB2 ->
         idJ (Ty E) BL
           (\ B3 PB3 -> (PF2 : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D As B3)) -> (b2 : El E B3)
              -> Ov E (ext G A) B (lift D G A s) B3 PB3 b b2 -> Ov D G (PS.Pi G A B) s (PS.Pi D As B3) PF2 (lam G A B b) (lam D As B3 b2))
           (\ PF2 b2 Pb2 ->
              idJ (El E BL) (subt E (ext G A) B b (lift D G A s))
                (\ b3 e3 -> Ov D G (PS.Pi G A B) s (PS.Pi D As BL) PF2 (lam G A B b) (lam D As BL b3))
                (ovRe D G (PS.Pi G A B) s (PS.Pi D As BL) (PS.Pi-nat D G A B s) PF2 (lam G A B b)
                   (lam D As BL (subt E (ext G A) B b (lift D G A s))) (PS.Pi-iso-nat D G A B b s))
                b2 Pb2)
           B2 PB2)
      A' PA B' PB PF b' Pb
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
   } ;

  appD-lam (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (b : El (ext G A) B) (a : El G A)
    : Id (El G (subT G (ext G A) B (sec G A a))) (appD G A B (lam G A B b) a) (subt G (ext G A) B b (sec G A a)) =
    ap (El (ext G A) B) (El G (subT G (ext G A) B (sec G A a))) (\ v -> subt G (ext G A) B v (sec G A a))
       (bod G A B (lam G A B b)) b ((PS.Pi-iso G A B).fun-inv b) ;

  app-lam (G : Ctx) (A B : Ty G) (b : El (ext G A) (wkT G A B)) (a : El G A)
    : Id (El G B) (app G A B (lam G A (wkT G A B) b) a)
         (trE G (subT G (ext G A) (wkT G A B) (sec G A a)) B (p-sec-T G A B a) (subt G (ext G A) (wkT G A B) b (sec G A a))) =
    ap (El G (subT G (ext G A) (wkT G A B) (sec G A a))) (El G B)
       (\ v -> trE G (subT G (ext G A) (wkT G A B) (sec G A a)) B (p-sec-T G A B a) v)
       (appD G A (wkT G A B) (lam G A (wkT G A B) b) a) (subt G (ext G A) (wkT G A B) b (sec G A a))
       (appD-lam G A (wkT G A B) b a) ;

  ----------------------------------------------------------------------
  -- (4) Id from an equality; the identity function

  idOfEq (G : Ctx) (A : Ty G) (u v : El G A) (e : Id (El G A) u v) : El G (IJ.IdT G A u v) =
    subst (El G A) (\ w -> El G (IJ.IdT G A u w)) u v e (IJ.rfl G A u) ;

  idF (G : Ctx) (A : Ty G) : El G (Fun G A A) = lam G A (wkT G A A) (q G A) ;

  app-idF (G : Ctx) (A : Ty G) (x : El G A) : Id (El G A) (app G A A (idF G A) x) x =
    trans (El G A) (app G A A (idF G A) x) (trE G (subT G (ext G A) (wkT G A A) (sec G A x)) A (p-sec-T G A A x) (subt G (ext G A) (wkT G A A) (q G A) (sec G A x))) x
      (app-lam G A A (q G A) x) (q-sec G A x) ;

  wkF-idF (G : Ctx) (X A : Ty G)
    : Id (El (ext G X) (Fun (ext G X) (wkT G X A) (wkT G X A))) (EQ.wkF G X A A (idF G A)) (idF (ext G X) (wkT G X A)) =
    lam-ov (ext G X) G A (wkT G A A) (p G X) (wkT G X A) (refl (wkT G X A)) (wkT (ext G X) (wkT G X A) (wkT G X A)) PW
      (EQ.wkFP G X A A) (q G A) (q (ext G X) (wkT G X A))
      (q-ov (ext G X) G A (p G X) (wkT G X A) (refl (wkT G X A)) PW)
   where {
    PW : Id (Ty (ext (ext G X) (wkT G X A))) (subT (ext (ext G X) (wkT G X A)) (ext G A) (wkT G A A) (upT (ext G X) G A (p G X) (wkT G X A) (refl (wkT G X A))))
            (wkT (ext G X) (wkT G X A) (wkT G X A)) =
      wkT-ov (ext G X) G A A (p G X) (wkT G X A) (refl (wkT G X A)) (wkT G X A) (refl (wkT G X A)) ;
   } ;

  ----------------------------------------------------------------------
  -- (5) equivalences from their four components

  mkIsEquiv (G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) (g : El G (Fun G B A)) (eta : El G (EQ.Htpy G A B f g))
    (h : El G (Fun G B A)) (eps : El G (EQ.Htpy G B A h f)) : El G (EQ.isEquiv G A B f) =
    pr G FBA (SS.Sig K1 H1 R2) g
      (trE G (SS.Sig G Hg R2') (subT G K1 (SS.Sig K1 H1 R2) (sec G FBA g))
         (sym (Ty G) (subT G K1 (SS.Sig K1 H1 R2) (sec G FBA g)) (SS.Sig G Hg R2') P1)
         (pr G Hg R2' eta
            (trE G (EQ.RetT G A B f) (subT G (ext G Hg) R2' (sec G Hg eta))
               (sym (Ty G) (subT G (ext G Hg) R2' (sec G Hg eta)) (EQ.RetT G A B f) PR2)
               (pr G FBA (EQ.Htpy K1 B1 A1 g1 f1) h
                  (trE G (EQ.Htpy G B A h f) (subT G K1 (EQ.Htpy K1 B1 A1 g1 f1) (sec G FBA h))
                     (sym (Ty G) (subT G K1 (EQ.Htpy K1 B1 A1 g1 f1) (sec G FBA h)) (EQ.Htpy G B A h f) PH2)
                     eps)))))
   where {
    FBA : Ty G = Fun G B A ;
    K1 : Ctx = ext G FBA ;
    A1 : Ty K1 = wkT G FBA A ;
    B1 : Ty K1 = wkT G FBA B ;
    f1 : El K1 (Fun K1 A1 B1) = EQ.wkF G FBA A B f ;
    g1 : El K1 (Fun K1 B1 A1) = EQ.qF G B A ;
    H1 : Ty K1 = EQ.SecH G A B f ;
    K2 : Ctx = ext K1 H1 ;
    R2 : Ty K2 = EQ.RetT K2 (wkT K1 H1 A1) (wkT K1 H1 B1) (EQ.wkF K1 H1 A1 B1 f1) ;
    Hg : Ty G = EQ.Htpy G A B f g ;
    R2' : Ty (ext G Hg) = EQ.RetT (ext G Hg) (wkT G Hg A) (wkT G Hg B) (EQ.wkF G Hg A B f) ;
    -- along sec g
    PA1 : Id (Ty G) (subT G K1 A1 (sec G FBA g)) A = p-sec-T G FBA A g ;
    PB1 : Id (Ty G) (subT G K1 B1 (sec G FBA g)) B = p-sec-T G FBA B g ;
    PF1 : Id (Ty G) (subT G K1 (Fun K1 A1 B1) (sec G FBA g)) (Fun G A B) = Fun-ov G K1 A1 B1 (sec G FBA g) A PA1 B PB1 ;
    PG1 : Id (Ty G) (subT G K1 (Fun K1 B1 A1) (sec G FBA g)) (Fun G B A) = Fun-ov G K1 B1 A1 (sec G FBA g) B PB1 A PA1 ;
    PH : Id (Ty G) (subT G K1 H1 (sec G FBA g)) Hg =
      EQ.Htpy-ov G K1 A1 B1 f1 g1 (sec G FBA g) A PA1 B PB1 PF1 f (wkF-sec G FBA A B g f PF1) PG1 g (qF-sec G B A g PG1) ;
    s2 : Sub (ext G Hg) K2 = upT G K1 H1 (sec G FBA g) Hg PH ;
    PA2 : Id (Ty (ext G Hg)) (subT (ext G Hg) K2 (wkT K1 H1 A1) s2) (wkT G Hg A) = wkT-ov G K1 H1 A1 (sec G FBA g) Hg PH A PA1 ;
    PB2 : Id (Ty (ext G Hg)) (subT (ext G Hg) K2 (wkT K1 H1 B1) s2) (wkT G Hg B) = wkT-ov G K1 H1 B1 (sec G FBA g) Hg PH B PB1 ;
    PF2 : Id (Ty (ext G Hg)) (subT (ext G Hg) K2 (Fun K2 (wkT K1 H1 A1) (wkT K1 H1 B1)) s2) (Fun (ext G Hg) (wkT G Hg A) (wkT G Hg B)) =
      Fun-ov (ext G Hg) K2 (wkT K1 H1 A1) (wkT K1 H1 B1) s2 (wkT G Hg A) PA2 (wkT G Hg B) PB2 ;
    PR : Id (Ty (ext G Hg)) (subT (ext G Hg) K2 R2 s2) R2' =
      EQ.RetT-ov (ext G Hg) K2 (wkT K1 H1 A1) (wkT K1 H1 B1) (EQ.wkF K1 H1 A1 B1 f1) s2 (wkT G Hg A) PA2 (wkT G Hg B) PB2 PF2
        (EQ.wkF G Hg A B f) (EQ.wkF-ov G K1 H1 A1 B1 (sec G FBA g) Hg PH A B PF1 f1 f (wkF-sec G FBA A B g f PF1) PF2) ;
    P1 : Id (Ty G) (subT G K1 (SS.Sig K1 H1 R2) (sec G FBA g)) (SS.Sig G Hg R2') = Sig-ov G K1 H1 R2 (sec G FBA g) Hg PH R2' PR ;
    -- along sec eta
    PR2 : Id (Ty G) (subT G (ext G Hg) R2' (sec G Hg eta)) (EQ.RetT G A B f) =
      EQ.RetT-ov G (ext G Hg) (wkT G Hg A) (wkT G Hg B) (EQ.wkF G Hg A B f) (sec G Hg eta) A (p-sec-T G Hg A eta) B (p-sec-T G Hg B eta)
        (FunSec G Hg A B eta) f (wkF-sec G Hg A B eta f (FunSec G Hg A B eta)) ;
    -- along sec h
    PU : Id (Ty G) (subT G K1 (Fun K1 B1 A1) (sec G FBA h)) (Fun G B A) =
      Fun-ov G K1 B1 A1 (sec G FBA h) B (p-sec-T G FBA B h) A (p-sec-T G FBA A h) ;
    PV : Id (Ty G) (subT G K1 (Fun K1 A1 B1) (sec G FBA h)) (Fun G A B) =
      Fun-ov G K1 A1 B1 (sec G FBA h) A (p-sec-T G FBA A h) B (p-sec-T G FBA B h) ;
    PH2 : Id (Ty G) (subT G K1 (EQ.Htpy K1 B1 A1 g1 f1) (sec G FBA h)) (EQ.Htpy G B A h f) =
      EQ.Htpy-ov G K1 B1 A1 g1 f1 (sec G FBA h) B (p-sec-T G FBA B h) A (p-sec-T G FBA A h) PU h (qF-sec G B A h PU)
        PV f (wkF-sec G FBA A B h f PV) ;
   } ;

  -- the identity homotopy id id ~ id
  hid (G : Ctx) (A : Ty G) : El G (EQ.Htpy G A A (idF G A) (idF G A)) =
    lam G A (IJ.IdT (ext G A) AA L (q G A)) (idOfEq (ext G A) AA L (q G A) e)
   where {
    AA : Ty (ext G A) = wkT G A A ;
    wid : El (ext G A) (Fun (ext G A) AA AA) = EQ.wkF G A A A (idF G A) ;
    L : El (ext G A) AA = app (ext G A) AA AA wid (app (ext G A) AA AA wid (q G A)) ;
    e : Id (El (ext G A) AA) L (q G A) =
      trans (El (ext G A) AA) L
        (app (ext G A) AA AA (idF (ext G A) AA) (app (ext G A) AA AA (idF (ext G A) AA) (q G A))) (q G A)
        (ap (El (ext G A) (Fun (ext G A) AA AA)) (El (ext G A) AA) (\ F -> app (ext G A) AA AA F (app (ext G A) AA AA F (q G A)))
            wid (idF (ext G A) AA) (wkF-idF G A A))
        (trans (El (ext G A) AA)
           (app (ext G A) AA AA (idF (ext G A) AA) (app (ext G A) AA AA (idF (ext G A) AA) (q G A)))
           (app (ext G A) AA AA (idF (ext G A) AA) (q G A)) (q G A)
           (ap (El (ext G A) AA) (El (ext G A) AA) (\ v -> app (ext G A) AA AA (idF (ext G A) AA) v)
               (app (ext G A) AA AA (idF (ext G A) AA) (q G A)) (q G A) (app-idF (ext G A) AA (q G A)))
           (app-idF (ext G A) AA (q G A))) ;
   } ;

  -- the identity equivalence
  idE (G : Ctx) (A : Ty G) : El G (EQ.Equiv G A A) =
    pr G (Fun G A A) (EQ.isEquiv K A1 A1 (EQ.qF G A A)) (idF G A)
      (trE G (EQ.isEquiv G A A (idF G A)) (subT G K (EQ.isEquiv K A1 A1 (EQ.qF G A A)) (sec G (Fun G A A) (idF G A)))
         (sym (Ty G) (subT G K (EQ.isEquiv K A1 A1 (EQ.qF G A A)) (sec G (Fun G A A) (idF G A))) (EQ.isEquiv G A A (idF G A)) PI)
         (mkIsEquiv G A A (idF G A) (idF G A) (hid G A) (idF G A) (hid G A)))
   where {
    K : Ctx = ext G (Fun G A A) ;
    A1 : Ty K = wkT G (Fun G A A) A ;
    PA : Id (Ty G) (subT G K A1 (sec G (Fun G A A) (idF G A))) A = p-sec-T G (Fun G A A) A (idF G A) ;
    PF : Id (Ty G) (subT G K (Fun K A1 A1) (sec G (Fun G A A) (idF G A))) (Fun G A A) =
      Fun-ov G K A1 A1 (sec G (Fun G A A) (idF G A)) A PA A PA ;
    PI : Id (Ty G) (subT G K (EQ.isEquiv K A1 A1 (EQ.qF G A A)) (sec G (Fun G A A) (idF G A))) (EQ.isEquiv G A A (idF G A)) =
      EQ.isEquiv-ov G K A1 A1 (EQ.qF G A A) (sec G (Fun G A A) (idF G A)) A PA A PA PF (idF G A) (qF-sec G A A (idF G A) PF) ;
   } ;

  ----------------------------------------------------------------------
  -- (6) the second projection

  -- a transport undone, the other way
  trE-symL (G : Ctx) (A A' : Ty G) (R : Id (Ty G) A A') (a : El G A)
    : Id (El G A) (trE G A' A (sym (Ty G) A A' R) (trE G A A' R a)) a =
    trans (El G A) (trE G A' A (sym (Ty G) A A' R) (trE G A A' R a)) (trE G A A (trans (Ty G) A A' A R (sym (Ty G) A A' R)) a) a
      (trE-tr G A A' A R (sym (Ty G) A A' R) a)
      (trE-irr G A A (trans (Ty G) A A' A R (sym (Ty G) A A' R)) (refl A) a) ;

  -- the second component of an element equal to a pair
  sndEq (D : Ctx) (A : Ty D) (B : Ty (ext D A)) (w2 : El D (SS.Sig D A B)) (x' : El D A)
    (y' : El D (subT D (ext D A) B (sec D A x'))) (E : Id (El D (SS.Sig D A B)) (pr D A B x' y') w2)
    (Z : Ty D) (z : El D Z) (R : Id (Ty D) Z (subT D (ext D A) B (sec D A x'))) (ez : Id (El D (subT D (ext D A) B (sec D A x'))) (trE D Z (subT D (ext D A) B (sec D A x')) R z) y')
    (R2 : Id (Ty D) Z (subT D (ext D A) B (sec D A (fst D A B w2))))
    : Id (El D (subT D (ext D A) B (sec D A (fst D A B w2)))) (trE D Z (subT D (ext D A) B (sec D A (fst D A B w2))) R2 z) (snd D A B w2) =
    idJ (El D (SS.Sig D A B)) (pr D A B x' y')
      (\ w3 E3 -> (R3 : Id (Ty D) Z (subT D (ext D A) B (sec D A (fst D A B w3))))
         -> Id (El D (subT D (ext D A) B (sec D A (fst D A B w3)))) (trE D Z (subT D (ext D A) B (sec D A (fst D A B w3))) R3 z) (snd D A B w3))
      (\ R3 -> trSame D Z Bp Bp R3 (refl Bp) (trans (Ty D) Z Bx Bp R (sym (Ty D) Bp Bx Apg)) z (snd D A B (pr D A B x' y'))
         (calc (El D Bp) {
             trE D Z Bp (trans (Ty D) Z Bx Bp R (sym (Ty D) Bp Bx Apg)) z
           =< sym (El D Bp) (trE D Bx Bp (sym (Ty D) Bp Bx Apg) (trE D Z Bx R z)) (trE D Z Bp (trans (Ty D) Z Bx Bp R (sym (Ty D) Bp Bx Apg)) z)
                (trE-tr D Z Bx Bp R (sym (Ty D) Bp Bx Apg) z) >
             trE D Bx Bp (sym (Ty D) Bp Bx Apg) (trE D Z Bx R z)
           =< ap (El D Bx) (El D Bp) (\ v -> trE D Bx Bp (sym (Ty D) Bp Bx Apg) v) (trE D Z Bx R z) (trE D Bp Bx Apg (snd D A B (pr D A B x' y')))
                (trans (El D Bx) (trE D Z Bx R z) y' (trE D Bp Bx Apg (snd D A B (pr D A B x' y')))
                   ez
                   (sym (El D Bx) (trE D Bp Bx Apg (snd D A B (pr D A B x' y'))) y'
                      (trans (El D Bx) (trE D Bp Bx Apg (snd D A B (pr D A B x' y')))
                         (subst (El D A) (\ x2 -> El D (subT D (ext D A) B (sec D A x2))) (fst D A B (pr D A B x' y')) x' (fst-pr D A B x' y') (snd D A B (pr D A B x' y')))
                         y'
                         (sym (El D Bx) (subst (El D A) (\ x2 -> El D (subT D (ext D A) B (sec D A x2))) (fst D A B (pr D A B x' y')) x' (fst-pr D A B x' y') (snd D A B (pr D A B x' y')))
                              (trE D Bp Bx Apg (snd D A B (pr D A B x' y')))
                              (subst-ap (El D A) (Ty D) (\ x2 -> subT D (ext D A) B (sec D A x2)) (El D) (fst D A B (pr D A B x' y')) x' (fst-pr D A B x' y') (snd D A B (pr D A B x' y'))))
                         (snd-pr D A B x' y')))) >
             trE D Bx Bp (sym (Ty D) Bp Bx Apg) (trE D Bp Bx Apg (snd D A B (pr D A B x' y')))
           =< trE-symL D Bp Bx Apg (snd D A B (pr D A B x' y')) >
             snd D A B (pr D A B x' y') }))
      w2 E R2
   where {
    Bx : Ty D = subT D (ext D A) B (sec D A x') ;
    Bp : Ty D = subT D (ext D A) B (sec D A (fst D A B (pr D A B x' y'))) ;
    Apg : Id (Ty D) Bp Bx = ap (El D A) (Ty D) (\ x2 -> subT D (ext D A) B (sec D A x2)) (fst D A B (pr D A B x' y')) x' (fst-pr D A B x' y') ;
   } ;

  -- the second projection is stable (at A[s], B[lift s], along the path Sig-nat)
  snd-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G)
    (F : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))))
    (w : El G (SS.Sig G A B))
    (PS2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A (fst G A B w))) s)
                     (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
                           (sec D (subT D G A s) (fst D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
                                   (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) F
                                        (subt D G (SS.Sig G A B) w s))))))
    : Ov D G (subT G (ext G A) B (sec G A (fst G A B w))) s
         (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
               (sec D (subT D G A s) (fst D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
                       (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) F
                            (subt D G (SS.Sig G A B) w s)))))
         PS2 (snd G A B w)
         (snd D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))
            (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) F
                 (subt D G (SS.Sig G A B) w s))) =
    sndEq D As BL (trE D SG SL F ws) (subt D G A x s) yS
      (sym (El D SL) (trE D SG SL F ws) (pr D As BL (subt D G A x s) yS)
         (trans (El D SL) (trE D SG SL F ws) (trE D SG SL N ws) (pr D As BL (subt D G A x s) yS)
            (trE-irr D SG SL F N ws) step))
      (subT D G (subT G (ext G A) B (sec G A x)) s) (subt D G (subT G (ext G A) B (sec G A x)) y s)
      (CwF.Formers[l, C].coerce D G A B x s) (refl yS) PS2
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
    SG : Ty D = subT D G (SS.Sig G A B) s ;
    SL : Ty D = SS.Sig D As BL ;
    N : Id (Ty D) SG SL = SS.Sig-nat D G A B s ;
    ws : El D SG = subt D G (SS.Sig G A B) w s ;
    x : El G A = fst G A B w ;
    y : El G (subT G (ext G A) B (sec G A x)) = snd G A B w ;
    yS : El D (subT D E BL (sec D As (subt D G A x s))) =
      trE D (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D E BL (sec D As (subt D G A x s)))
        (CwF.Formers[l, C].coerce D G A B x s) (subt D G (subT G (ext G A) B (sec G A x)) y s) ;
    step : Id (El D SL) (trE D SG SL N ws) (pr D As BL (subt D G A x s) yS) =
      trans (El D SL) (trE D SG SL N ws) (trE D SG SL N (subt D G (SS.Sig G A B) (pr G A B x y) s)) (pr D As BL (subt D G A x s) yS)
        (ap (El G (SS.Sig G A B)) (El D SL) (\ v -> trE D SG SL N (subt D G (SS.Sig G A B) v s)) w (pr G A B x y)
            (sym (El G (SS.Sig G A B)) (pr G A B x y) w ((SS.Sig-iso G A B).inv-fun w)))
        (SS.Sig-iso-nat D G A B x y s) ;
   } ;

  snd-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (PW : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D A' B'))
    (w : El G (SS.Sig G A B)) (w' : El D (SS.Sig D A' B')) (Pw : Ov D G (SS.Sig G A B) s (SS.Sig D A' B') PW w w')
    (PS2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A (fst G A B w))) s) (subT D (ext D A') B' (sec D A' (fst D A' B' w'))))
    : Ov D G (subT G (ext G A) B (sec G A (fst G A B w))) s (subT D (ext D A') B' (sec D A' (fst D A' B' w'))) PS2
         (snd G A B w) (snd D A' B' w') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
         -> (PW2 : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D X B2)) -> (w2 : El D (SS.Sig D X B2))
         -> Ov D G (SS.Sig G A B) s (SS.Sig D X B2) PW2 w w2
         -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A (fst G A B w))) s) (subT D (ext D X) B2 (sec D X (fst D X B2 w2))))
         -> Ov D G (subT G (ext G A) B (sec G A (fst G A B w))) s (subT D (ext D X) B2 (sec D X (fst D X B2 w2))) PT2 (snd G A B w) (snd D X B2 w2))
      (\ B2 PB2 ->
         idJ (Ty E) BL
           (\ B3 PB3 -> (PW2 : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D As B3)) -> (w2 : El D (SS.Sig D As B3))
              -> Ov D G (SS.Sig G A B) s (SS.Sig D As B3) PW2 w w2
              -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A (fst G A B w))) s) (subT D E B3 (sec D As (fst D As B3 w2))))
              -> Ov D G (subT G (ext G A) B (sec G A (fst G A B w))) s (subT D E B3 (sec D As (fst D As B3 w2))) PT2 (snd G A B w) (snd D As B3 w2))
           (\ PW2 w2 Pw2 ->
              idJ (El D (SS.Sig D As BL)) (trE D (subT D G (SS.Sig G A B) s) (SS.Sig D As BL) PW2 (subt D G (SS.Sig G A B) w s))
                (\ w3 e3 -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A (fst G A B w))) s) (subT D E BL (sec D As (fst D As BL w3))))
                   -> Ov D G (subT G (ext G A) B (sec G A (fst G A B w))) s (subT D E BL (sec D As (fst D As BL w3))) PT2 (snd G A B w) (snd D As BL w3))
                (\ PT2 -> snd-nat D G A B s PW2 w PT2)
                w2 Pw2)
           B2 PB2)
      A' PA B' PB PW w' Pw PS2
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
   } ;

  ----------------------------------------------------------------------
  -- (7) refl is stable

  rfl-ov (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (a' : El D A') (Pa : Ov D G A s A' PA a a') (PI : Id (Ty D) (subT D G (IJ.IdT G A a a) s) (IJ.IdT D A' a' a'))
    : Ov D G (IJ.IdT G A a a) s (IJ.IdT D A' a' a') PI (IJ.rfl G A a) (IJ.rfl D A' a') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (a2 : El D X) -> Ov D G A s X PX a a2 -> (PI2 : Id (Ty D) (subT D G (IJ.IdT G A a a) s) (IJ.IdT D X a2 a2))
         -> Ov D G (IJ.IdT G A a a) s (IJ.IdT D X a2 a2) PI2 (IJ.rfl G A a) (IJ.rfl D X a2))
      (\ a2 Pa2 ->
         idJ (El D (subT D G A s)) (subt D G A a s)
           (\ a3 e3 -> (PI2 : Id (Ty D) (subT D G (IJ.IdT G A a a) s) (IJ.IdT D (subT D G A s) a3 a3))
              -> Ov D G (IJ.IdT G A a a) s (IJ.IdT D (subT D G A s) a3 a3) PI2 (IJ.rfl G A a) (IJ.rfl D (subT D G A s) a3))
           (\ PI2 -> ovRe D G (IJ.IdT G A a a) s (IJ.IdT D (subT D G A s) (subt D G A a s) (subt D G A a s)) (IJ.IdT-nat D G A a a s) PI2
                       (IJ.rfl G A a) (IJ.rfl D (subT D G A s) (subt D G A a s)) (IJ.rfl-nat D G A a s))
           a2 Pa2)
      A' PA a' Pa PI ;

  ----------------------------------------------------------------------
  -- (8) eta for maps into a context extension

  -- composing a transported lift with a section
  upT-sec (D G : Ctx) (A : Ty G) (A0 A' : Ty D) (PA : Id (Ty D) A0 A') (L : Sub (ext D A0) (ext G A)) (y : El D A')
    : Id (Sub D (ext G A)) (o D (ext D A') (ext G A) (subst (Ty D) (\ X -> Sub (ext D X) (ext G A)) A0 A' PA L) (sec D A' y))
         (o D (ext D A0) (ext G A) L (sec D A0 (trE D A' A0 (sym (Ty D) A0 A' PA) y))) =
    idJ (Ty D) A0
      (\ X PX -> (y2 : El D X) -> Id (Sub D (ext G A)) (o D (ext D X) (ext G A) (subst (Ty D) (\ X2 -> Sub (ext D X2) (ext G A)) A0 X PX L) (sec D X y2))
                                     (o D (ext D A0) (ext G A) L (sec D A0 (trE D X A0 (sym (Ty D) A0 X PX) y2))))
      (\ y2 -> refl (o D (ext D A0) (ext G A) L (sec D A0 y2))) A' PA y ;

  -- the q-part of s, read at A[p s]
  qOf (D G : Ctx) (A : Ty G) (s : Sub D (ext G A)) : El D (subT D G A (o D (ext G A) G (p G A) s)) =
    trE D (subT D (ext G A) (wkT G A A) s) (subT D G A (o D (ext G A) G (p G A) s))
      (sym (Ty D) (subT D G A (o D (ext G A) G (p G A) s)) (subT D (ext G A) (wkT G A A) s) (subT-o D (ext G A) G A (p G A) s))
      (subt D (ext G A) (wkT G A A) (q G A) s) ;

  sub-eta (D G : Ctx) (A : Ty G) (s : Sub D (ext G A))
    : Id (Sub D (ext G A)) s (extS D G A (o D (ext G A) G (p G A) s) (qOf D G A s)) =
    calc (Sub D K) {
        s
      =< sym (Sub D K) (o D K K (id K) s) s (o-idl D K s) >
        o D K K (id K) s
      =< ap (Sub K K) (Sub D K) (\ t -> o D K K t s) (id K) (o K KA K LP SQ)
            (sym (Sub K K) (o K KA K LP SQ) (id K) (lift-p-sec-q G A)) >
        o D K K (o K KA K LP SQ) s
      =< o-assoc D K KA K LP SQ s >
        o D KA K LP (o D K KA SQ s)
      =< ap (Sub D KA) (Sub D K) (\ t -> o D KA K LP t) (o D K KA SQ s) (o D DA KA LS (sec D As qs))
            (sec-o D K Ap (q G A) s) >
        o D KA K LP (o D DA KA LS (sec D As qs))
      =< sym (Sub D K) (o D DA K (o DA KA K LP LS) (sec D As qs)) (o D KA K LP (o D DA KA LS (sec D As qs)))
            (o-assoc D DA KA K LP LS (sec D As qs)) >
        o D DA K (o DA KA K LP LS) (sec D As qs)
      =< ap (Sub DA K) (Sub D K) (\ t -> o D DA K t (sec D As qs)) (o DA KA K LP LS)
            (subst (Ty D) (\ X -> Sub (ext D X) K) (subT D G A ps) As SO (lift D G A ps))
            (sym (Sub DA K) (subst (Ty D) (\ X -> Sub (ext D X) K) (subT D G A ps) As SO (lift D G A ps)) (o DA KA K LP LS)
                 (lift-o D K G A (p G A) s)) >
        o D DA K (subst (Ty D) (\ X -> Sub (ext D X) K) (subT D G A ps) As SO (lift D G A ps)) (sec D As qs)
      =< upT-sec D G A (subT D G A ps) As SO (lift D G A ps) qs >
        extS D G A ps (qOf D G A s) }
   where {
    K : Ctx = ext G A ;
    Ap : Ty K = wkT G A A ;
    KA : Ctx = ext K Ap ;
    ps : Sub D G = o D K G (p G A) s ;
    As : Ty D = subT D K Ap s ;
    DA : Ctx = ext D As ;
    LP : Sub KA K = lift K G A (p G A) ;
    SQ : Sub K KA = sec K Ap (q G A) ;
    LS : Sub DA KA = lift D K Ap s ;
    qs : El D As = subt D K Ap (q G A) s ;
    SO : Id (Ty D) (subT D G A ps) As = subT-o D K G A (p G A) s ;
   } ;

  ----------------------------------------------------------------------
  -- (9) along extS s a: p is s, weakenings are values at s, q is a

  p-extS (D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s))
    : Id (Sub D G) (o D (ext G A) G (p G A) (extS D G A s a)) s =
    calc (Sub D G) {
        o D (ext G A) G (p G A) (o D DA (ext G A) (lift D G A s) (sec D As a))
      =< sym (Sub D G) (o D DA G (o DA (ext G A) G (p G A) (lift D G A s)) (sec D As a))
              (o D (ext G A) G (p G A) (o D DA (ext G A) (lift D G A s) (sec D As a)))
              (o-assoc D DA (ext G A) G (p G A) (lift D G A s) (sec D As a)) >
        o D DA G (o DA (ext G A) G (p G A) (lift D G A s)) (sec D As a)
      =< ap (Sub DA G) (Sub D G) (\ t -> o D DA G t (sec D As a)) (o DA (ext G A) G (p G A) (lift D G A s)) (o DA D G s (p D As))
            (p-lift D G A s) >
        o D DA G (o DA D G s (p D As)) (sec D As a)
      =< o-assoc D DA D G s (p D As) (sec D As a) >
        o D D G s (o D DA D (p D As) (sec D As a))
      =< ap (Sub D D) (Sub D G) (\ t -> o D D G s t) (o D DA D (p D As) (sec D As a)) (id D) (p-sec D As a) >
        o D D G s (id D)
      =< o-idr D G s >
        s }
   where { As : Ty D = subT D G A s ; DA : Ctx = ext D As ; } ;

  wkT-extS (D G : Ctx) (A B : Ty G) (s : Sub D G) (a : El D (subT D G A s))
    : Id (Ty D) (subT D (ext G A) (wkT G A B) (extS D G A s a)) (subT D G B s) =
    trans (Ty D) (subT D (ext G A) (wkT G A B) (extS D G A s a)) (subT D G B (o D (ext G A) G (p G A) (extS D G A s a))) (subT D G B s)
      (sym (Ty D) (subT D G B (o D (ext G A) G (p G A) (extS D G A s a))) (subT D (ext G A) (wkT G A B) (extS D G A s a))
           (subT-o D (ext G A) G B (p G A) (extS D G A s a)))
      (ap (Sub D G) (Ty D) (\ t -> subT D G B t) (o D (ext G A) G (p G A) (extS D G A s a)) s (p-extS D G A s a)) ;

  wkE-extS (D G : Ctx) (A B : Ty G) (b : El G B) (s : Sub D G) (a : El D (subT D G A s))
    (PW : Id (Ty D) (subT D (ext G A) (wkT G A B) (extS D G A s a)) (subT D G B s))
    : Ov D (ext G A) (wkT G A B) (extS D G A s a) (subT D G B s) PW (wkE G A B b) (subt D G B b s) =
    calc (El D (subT D G B s)) {
        trE D Y (subT D G B s) PW (subt D (ext G A) (wkT G A B) (wkE G A B b) e)
      =< ap (El D Y) (El D (subT D G B s)) (\ v -> trE D Y (subT D G B s) PW v) (subt D (ext G A) (wkT G A B) (wkE G A B b) e)
            (trE D S Y So (subt D G B b (o D (ext G A) G (p G A) e)))
            (sym (El D Y) (trE D S Y So (subt D G B b (o D (ext G A) G (p G A) e))) (subt D (ext G A) (wkT G A B) (wkE G A B b) e)
                 (subt-o D (ext G A) G B b (p G A) e)) >
        trE D Y (subT D G B s) PW (trE D S Y So (subt D G B b (o D (ext G A) G (p G A) e)))
      =< trE-tr D S Y (subT D G B s) So PW (subt D G B b (o D (ext G A) G (p G A) e)) >
        trE D S (subT D G B s) (trans (Ty D) S Y (subT D G B s) So PW) (subt D G B b (o D (ext G A) G (p G A) e))
      =< SJ.subtEq D G B b (o D (ext G A) G (p G A) e) s (p-extS D G A s a) (subT D G B s) (trans (Ty D) S Y (subT D G B s) So PW)
            (refl (subT D G B s)) >
        subt D G B b s }
   where {
    e : Sub D (ext G A) = extS D G A s a ;
    S : Ty D = subT D G B (o D (ext G A) G (p G A) e) ;
    Y : Ty D = subT D (ext G A) (wkT G A B) e ;
    So : Id (Ty D) S Y = subT-o D (ext G A) G B (p G A) e ;
   } ;

  ----------------------------------------------------------------------
  -- (10) two maps into G.A with the same p part and q over the same
  -- element are equal (sub-eta)

  extS-cong (D G : Ctx) (A : Ty G) (s s' : Sub D G) (e : Id (Sub D G) s s') (a : El D (subT D G A s)) (a' : El D (subT D G A s'))
    (ea : Id (El D (subT D G A s')) (trE D (subT D G A s) (subT D G A s') (ap (Sub D G) (Ty D) (\ t -> subT D G A t) s s' e) a) a')
    : Id (Sub D (ext G A)) (extS D G A s a) (extS D G A s' a') =
    idJ (Sub D G) s
      (\ t et -> (a2 : El D (subT D G A t)) -> Id (El D (subT D G A t)) (trE D (subT D G A s) (subT D G A t) (ap (Sub D G) (Ty D) (\ t2 -> subT D G A t2) s t et) a) a2
         -> Id (Sub D (ext G A)) (extS D G A s a) (extS D G A t a2))
      (\ a2 ea2 -> ap (El D (subT D G A s)) (Sub D (ext G A)) (\ v -> extS D G A s v) a a2 ea2)
      s' e a' ea ;

  ext-eq (D G : Ctx) (A : Ty G) (s1 s2 : Sub D (ext G A)) (e : Id (Sub D G) (o D (ext G A) G (p G A) s1) (o D (ext G A) G (p G A) s2))
    (A' : Ty D) (x : El D A')
    (P1 : Id (Ty D) (subT D (ext G A) (wkT G A A) s1) A') (q1 : Ov D (ext G A) (wkT G A A) s1 A' P1 (q G A) x)
    (P2 : Id (Ty D) (subT D (ext G A) (wkT G A A) s2) A') (q2 : Ov D (ext G A) (wkT G A A) s2 A' P2 (q G A) x)
    : Id (Sub D (ext G A)) s1 s2 =
    trans (Sub D (ext G A)) s1 (extS D G A ps1 (qOf D G A s1)) s2
      (sub-eta D G A s1)
      (trans (Sub D (ext G A)) (extS D G A ps1 (qOf D G A s1)) (extS D G A ps2 (qOf D G A s2)) s2
         (extS-cong D G A ps1 ps2 e (qOf D G A s1) (qOf D G A s2)
            (calc (El D T2) {
                trE D T1 T2 Ae (qOf D G A s1)
              =< trE-tr D Y1 T1 T2 (sym (Ty D) T1 Y1 (subT-o D (ext G A) G A (p G A) s1)) Ae (subt D (ext G A) (wkT G A A) (q G A) s1) >
                trE D Y1 T2 (trans (Ty D) Y1 T1 T2 (sym (Ty D) T1 Y1 (subT-o D (ext G A) G A (p G A) s1)) Ae) (subt D (ext G A) (wkT G A A) (q G A) s1)
              =< trSame D Y1 Y2 T2 (trans (Ty D) Y1 T1 T2 (sym (Ty D) T1 Y1 (subT-o D (ext G A) G A (p G A) s1)) Ae)
                   (sym (Ty D) T2 Y2 (subT-o D (ext G A) G A (p G A) s2)) (trans (Ty D) Y1 A' Y2 P1 (sym (Ty D) Y2 A' P2))
                   (subt D (ext G A) (wkT G A A) (q G A) s1) (subt D (ext G A) (wkT G A A) (q G A) s2)
                   (calc (El D Y2) {
                       trE D Y1 Y2 (trans (Ty D) Y1 A' Y2 P1 (sym (Ty D) Y2 A' P2)) (subt D (ext G A) (wkT G A A) (q G A) s1)
                     =< sym (El D Y2) (trE D A' Y2 (sym (Ty D) Y2 A' P2) (trE D Y1 A' P1 (subt D (ext G A) (wkT G A A) (q G A) s1)))
                          (trE D Y1 Y2 (trans (Ty D) Y1 A' Y2 P1 (sym (Ty D) Y2 A' P2)) (subt D (ext G A) (wkT G A A) (q G A) s1))
                          (trE-tr D Y1 A' Y2 P1 (sym (Ty D) Y2 A' P2) (subt D (ext G A) (wkT G A A) (q G A) s1)) >
                       trE D A' Y2 (sym (Ty D) Y2 A' P2) (trE D Y1 A' P1 (subt D (ext G A) (wkT G A A) (q G A) s1))
                     =< ap (El D A') (El D Y2) (\ v -> trE D A' Y2 (sym (Ty D) Y2 A' P2) v) (trE D Y1 A' P1 (subt D (ext G A) (wkT G A A) (q G A) s1))
                          (trE D Y2 A' P2 (subt D (ext G A) (wkT G A A) (q G A) s2))
                          (trans (El D A') (trE D Y1 A' P1 (subt D (ext G A) (wkT G A A) (q G A) s1)) x
                             (trE D Y2 A' P2 (subt D (ext G A) (wkT G A A) (q G A) s2)) q1
                             (sym (El D A') (trE D Y2 A' P2 (subt D (ext G A) (wkT G A A) (q G A) s2)) x q2)) >
                       trE D A' Y2 (sym (Ty D) Y2 A' P2) (trE D Y2 A' P2 (subt D (ext G A) (wkT G A A) (q G A) s2))
                     =< trE-symL D Y2 A' P2 (subt D (ext G A) (wkT G A A) (q G A) s2) >
                       subt D (ext G A) (wkT G A A) (q G A) s2 }) >
                qOf D G A s2 }))
         (sym (Sub D (ext G A)) s2 (extS D G A ps2 (qOf D G A s2)) (sub-eta D G A s2)))
   where {
    ps1 : Sub D G = o D (ext G A) G (p G A) s1 ;
    ps2 : Sub D G = o D (ext G A) G (p G A) s2 ;
    T1 : Ty D = subT D G A ps1 ;
    T2 : Ty D = subT D G A ps2 ;
    Y1 : Ty D = subT D (ext G A) (wkT G A A) s1 ;
    Y2 : Ty D = subT D (ext G A) (wkT G A A) s2 ;
    Ae : Id (Ty D) T1 T2 = ap (Sub D G) (Ty D) (\ t -> subT D G A t) ps1 ps2 e ;
   } ;

  ----------------------------------------------------------------------
  -- (11) pairs are stable

  pr-nat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G)
    (F : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))))
    (x : El G A) (y : El G (subT G (ext G A) B (sec G A x)))
    (PT : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s)
                    (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) (sec D (subT D G A s) (subt D G A x s))))
    : Ov D G (SS.Sig G A B) s (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s))) F (pr G A B x y)
         (pr D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) (subt D G A x s)
             (trE D (subT D G (subT G (ext G A) B (sec G A x)) s)
                    (subT D (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) (sec D (subT D G A s) (subt D G A x s)))
                    PT (subt D G (subT G (ext G A) B (sec G A x)) y s))) =
    trans (El D SL) (trE D SG SL F (subt D G (SS.Sig G A B) (pr G A B x y) s)) (trE D SG SL N (subt D G (SS.Sig G A B) (pr G A B x y) s))
      (pr D As BL (subt D G A x s) (trE D Ys Yx PT ys))
      (trE-irr D SG SL F N (subt D G (SS.Sig G A B) (pr G A B x y) s))
      (trans (El D SL) (trE D SG SL N (subt D G (SS.Sig G A B) (pr G A B x y) s)) (pr D As BL (subt D G A x s) (trE D Ys Yx (CwF.Formers[l, C].coerce D G A B x s) ys))
         (pr D As BL (subt D G A x s) (trE D Ys Yx PT ys))
         (SS.Sig-iso-nat D G A B x y s)
         (ap (El D Yx) (El D SL) (\ v -> pr D As BL (subt D G A x s) v) (trE D Ys Yx (CwF.Formers[l, C].coerce D G A B x s) ys) (trE D Ys Yx PT ys)
             (trE-irr D Ys Yx (CwF.Formers[l, C].coerce D G A B x s) PT ys)))
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
    SG : Ty D = subT D G (SS.Sig G A B) s ;
    SL : Ty D = SS.Sig D As BL ;
    N : Id (Ty D) SG SL = SS.Sig-nat D G A B s ;
    Ys : Ty D = subT D G (subT G (ext G A) B (sec G A x)) s ;
    Yx : Ty D = subT D E BL (sec D As (subt D G A x s)) ;
    ys : El D Ys = subt D G (subT G (ext G A) B (sec G A x)) y s ;
   } ;

  pr-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (PW : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D A' B'))
    (x : El G A) (x' : El D A') (Px : Ov D G A s A' PA x x')
    (y : El G (subT G (ext G A) B (sec G A x))) (y' : El D (subT D (ext D A') B' (sec D A' x')))
    (PT : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D (ext D A') B' (sec D A' x')))
    (Py : Ov D G (subT G (ext G A) B (sec G A x)) s (subT D (ext D A') B' (sec D A' x')) PT y y')
    : Ov D G (SS.Sig G A B) s (SS.Sig D A' B') PW (pr G A B x y) (pr D A' B' x' y') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
         -> (PW2 : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D X B2)) -> (x2 : El D X) -> Ov D G A s X PX x x2
         -> (y2 : El D (subT D (ext D X) B2 (sec D X x2))) -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D (ext D X) B2 (sec D X x2)))
         -> Ov D G (subT G (ext G A) B (sec G A x)) s (subT D (ext D X) B2 (sec D X x2)) PT2 y y2
         -> Ov D G (SS.Sig G A B) s (SS.Sig D X B2) PW2 (pr G A B x y) (pr D X B2 x2 y2))
      (\ B2 PB2 ->
         idJ (Ty E) BL
           (\ B3 PB3 -> (PW2 : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D As B3)) -> (x2 : El D As) -> Ov D G A s As (refl As) x x2
              -> (y2 : El D (subT D E B3 (sec D As x2))) -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D E B3 (sec D As x2)))
              -> Ov D G (subT G (ext G A) B (sec G A x)) s (subT D E B3 (sec D As x2)) PT2 y y2
              -> Ov D G (SS.Sig G A B) s (SS.Sig D As B3) PW2 (pr G A B x y) (pr D As B3 x2 y2))
           (\ PW2 x2 Px2 ->
              idJ (El D As) (subt D G A x s)
                (\ x3 e3 -> (y2 : El D (subT D E BL (sec D As x3))) -> (PT2 : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D E BL (sec D As x3)))
                   -> Ov D G (subT G (ext G A) B (sec G A x)) s (subT D E BL (sec D As x3)) PT2 y y2
                   -> Ov D G (SS.Sig G A B) s (SS.Sig D As BL) PW2 (pr G A B x y) (pr D As BL x3 y2))
                (\ y2 PT2 Py2 ->
                   idJ (El D (subT D E BL (sec D As (subt D G A x s)))) (trE D (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D E BL (sec D As (subt D G A x s))) PT2
                                                                          (subt D G (subT G (ext G A) B (sec G A x)) y s))
                     (\ y3 e4 -> Ov D G (SS.Sig G A B) s (SS.Sig D As BL) PW2 (pr G A B x y) (pr D As BL (subt D G A x s) y3))
                     (pr-nat D G A B s PW2 x y PT2) y2 Py2)
                x2 Px2)
           B2 PB2)
      A' PA B' PB PW x' Px y' PT Py
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
   } ;

  ----------------------------------------------------------------------
  -- (12) application: through transports; of a weakened lam at q

  app-tr2 (G : Ctx) (X X' Y Y' : Ty G) (PX : Id (Ty G) X X') (PY : Id (Ty G) Y Y')
    (PF : Id (Ty G) (Fun G X Y) (Fun G X' Y')) (F : El G (Fun G X Y)) (x : El G X)
    : Id (El G Y') (app G X' Y' (trE G (Fun G X Y) (Fun G X' Y') PF F) (trE G X X' PX x)) (trE G Y Y' PY (app G X Y F x)) =
    idJ (Ty G) X
      (\ X2 PX2 -> (PF2 : Id (Ty G) (Fun G X Y) (Fun G X2 Y')) -> Id (El G Y') (app G X2 Y' (trE G (Fun G X Y) (Fun G X2 Y') PF2 F) (trE G X X2 PX2 x))
                                                                    (trE G Y Y' PY (app G X Y F x)))
      (idJ (Ty G) Y
         (\ Y2 PY2 -> (PF2 : Id (Ty G) (Fun G X Y) (Fun G X Y2)) -> Id (El G Y2) (app G X Y2 (trE G (Fun G X Y) (Fun G X Y2) PF2 F) x)
                                                                       (trE G Y Y2 PY2 (app G X Y F x)))
         (\ PF2 -> ap (El G (Fun G X Y)) (El G Y) (\ F2 -> app G X Y F2 x) (trE G (Fun G X Y) (Fun G X Y) PF2 F) F
                      (trE-irr G (Fun G X Y) (Fun G X Y) PF2 (refl (Fun G X Y)) F))
         Y' PY)
      X' PX PF ;

  -- app (lam b weakened) q = b
  appWkLamQ (K : Ctx) (A B : Ty K) (b : El (ext K A) (wkT K A B))
    : Id (El (ext K A) (wkT K A B)) (app (ext K A) (wkT K A A) (wkT K A B) (EQ.wkF K A A B (lam K A (wkT K A B) b)) (q K A)) b =
    calc (El E WB) {
        app E WA WB (EQ.wkF K A A B (lam K A (wkT K A B) b)) (q K A)
      =< ap (El E (Fun E WA WB)) (El E WB) (\ F -> app E WA WB F (q K A)) (EQ.wkF K A A B (lam K A (wkT K A B) b)) (lam E WA (wkT E WA WB) b')
            (lam-ov E K A (wkT K A B) (p K A) WA (refl WA) (wkT E WA WB) PB (EQ.wkFP K A A B) b b' (refl b')) >
        app E WA WB (lam E WA (wkT E WA WB) b') (q K A)
      =< app-lam E WA WB b' (q K A) >
        trE E (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB (p-sec-T E WA WB (q K A)) (subt E (ext E WA) (wkT E WA WB) b' (sec E WA (q K A)))
      =< ap (El E (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A)))) (El E WB) (\ v -> trE E (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB (p-sec-T E WA WB (q K A)) v)
            (subt E (ext E WA) (wkT E WA WB) b' (sec E WA (q K A)))
            (trE E Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) APB (subt E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) (sec E WA (q K A))))
            (subt-tr E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (wkT E WA WB) PB (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) (sec E WA (q K A))) >
        trE E (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB (p-sec-T E WA WB (q K A))
          (trE E Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) APB (subt E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) (sec E WA (q K A))))
      =< trE-tr E Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB APB (p-sec-T E WA WB (q K A))
           (subt E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) (sec E WA (q K A))) >
        trE E Y2 WB (trans (Ty E) Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB APB (p-sec-T E WA WB (q K A)))
          (subt E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) (sec E WA (q K A)))
      =< trSame E Y2 S0 WB (trans (Ty E) Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB APB (p-sec-T E WA WB (q K A)))
           (trans (Ty E) S0 Y2 WB So (trans (Ty E) Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB APB (p-sec-T E WA WB (q K A))))
           (sym (Ty E) S0 Y2 So) bl (subt E E WB b LS)
           (trans (El E S0) (trE E Y2 S0 (sym (Ty E) S0 Y2 So) bl) (trE E Y2 S0 (sym (Ty E) S0 Y2 So) (trE E S0 Y2 So (subt E E WB b LS))) (subt E E WB b LS)
              (ap (El E Y2) (El E S0) (\ v -> trE E Y2 S0 (sym (Ty E) S0 Y2 So) v) bl (trE E S0 Y2 So (subt E E WB b LS))
                  (sym (El E Y2) (trE E S0 Y2 So (subt E E WB b LS)) bl (subt-o E (ext E WA) E WB b (lift E K A (p K A)) (sec E WA (q K A)))))
              (trE-symL E S0 Y2 So (subt E E WB b LS))) >
        trE E S0 WB (trans (Ty E) S0 Y2 WB So (trans (Ty E) Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB APB (p-sec-T E WA WB (q K A))))
          (subt E E WB b LS)
      =< SJ.subtEq E E WB b LS (id E) (lift-p-sec-q K A) WB
           (trans (Ty E) S0 Y2 WB So (trans (Ty E) Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) WB APB (p-sec-T E WA WB (q K A))))
           (subT-id E WB) >
        trE E (subT E E WB (id E)) WB (subT-id E WB) (subt E E WB b (id E))
      =< subt-id E WB b >
        b }
   where {
    E : Ctx = ext K A ;
    WA : Ty E = wkT K A A ;
    WB : Ty E = wkT K A B ;
    PB : Id (Ty (ext E WA)) (subT (ext E WA) E (wkT K A B) (upT E K A (p K A) WA (refl WA))) (wkT E WA WB) =
      wkT-ov E K A B (p K A) WA (refl WA) WB (refl WB) ;
    b' : El (ext E WA) (wkT E WA WB) = trE (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (wkT E WA WB) PB (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) ;
    Y2 : Ty E = subT E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (sec E WA (q K A)) ;
    APB : Id (Ty E) Y2 (subT E (ext E WA) (wkT E WA WB) (sec E WA (q K A))) =
      ap (Ty (ext E WA)) (Ty E) (\ Z -> subT E (ext E WA) Z (sec E WA (q K A))) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (wkT E WA WB) PB ;
    LS : Sub E E = o E (ext E WA) E (lift E K A (p K A)) (sec E WA (q K A)) ;
    S0 : Ty E = subT E E WB LS ;
    So : Id (Ty E) S0 Y2 = subT-o E (ext E WA) E WB (lift E K A (p K A)) (sec E WA (q K A)) ;
    bl : El E Y2 = subt E (ext E WA) (subT (ext E WA) E (wkT K A B) (lift E K A (p K A))) (subt (ext E WA) E (wkT K A B) b (lift E K A (p K A))) (sec E WA (q K A)) ;
   } ;

  ----------------------------------------------------------------------
  -- (13) x is a transport of y: TE x y = a path of types with the
  -- transport of x equal to y.  Types form a set, so any path will do.

  TE (G : Ctx) (A B : Ty G) (x : El G A) (y : El G B) : U l =
    (P0 : Id (Ty G) A B) * Id (El G B) (trE G A B P0 x) y ;

  teAny (G : Ctx) (A B : Ty G) (x : El G A) (y : El G B) (h : TE G A B x y) (P : Id (Ty G) A B)
    : Id (El G B) (trE G A B P x) y =
    trans (El G B) (trE G A B P x) (trE G A B h.1 x) y (trE-irr G A B P h.1 x) h.2 ;

  teT (G : Ctx) (A B C' : Ty G) (x : El G A) (y : El G B) (z : El G C') (h1 : TE G A B x y) (h2 : TE G B C' y z)
    : TE G A C' x z =
    (trans (Ty G) A B C' h1.1 h2.1,
     trans (El G C') (trE G A C' (trans (Ty G) A B C' h1.1 h2.1) x) (trE G B C' h2.1 (trE G A B h1.1 x)) z
       (sym (El G C') (trE G B C' h2.1 (trE G A B h1.1 x)) (trE G A C' (trans (Ty G) A B C' h1.1 h2.1) x) (trE-tr G A B C' h1.1 h2.1 x))
       (trans (El G C') (trE G B C' h2.1 (trE G A B h1.1 x)) (trE G B C' h2.1 y) z
          (ap (El G B) (El G C') (\ v -> trE G B C' h2.1 v) (trE G A B h1.1 x) y h1.2) h2.2)) ;

  teS (G : Ctx) (A B : Ty G) (x : El G A) (y : El G B) (h : TE G A B x y) : TE G B A y x =
    (sym (Ty G) A B h.1,
     trans (El G A) (trE G B A (sym (Ty G) A B h.1) y) (trE G B A (sym (Ty G) A B h.1) (trE G A B h.1 x)) x
       (ap (El G B) (El G A) (\ v -> trE G B A (sym (Ty G) A B h.1) v) y (trE G A B h.1 x) (sym (El G B) (trE G A B h.1 x) y h.2))
       (trE-symL G A B h.1 x)) ;

  -- a transport, and the steps of substitution
  teTr (G : Ctx) (A B : Ty G) (P : Id (Ty G) A B) (x : El G A) : TE G A B x (trE G A B P x) = (P, refl (trE G A B P x)) ;

  teSubtO (T D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (s' : Sub T D)
    : TE T (subT T G A (o T D G s s')) (subT T D (subT D G A s) s') (subt T G A a (o T D G s s')) (subt T D (subT D G A s) (subt D G A a s) s') =
    (subT-o T D G A s s', subt-o T D G A a s s') ;

  teSubEq (E G : Ctx) (B : Ty G) (b : El G B) (s s' : Sub E G) (e : Id (Sub E G) s s')
    : TE E (subT E G B s) (subT E G B s') (subt E G B b s) (subt E G B b s') =
    (ap (Sub E G) (Ty E) (\ t -> subT E G B t) s s' e, SJ.apdSubt E G B b s s' e) ;

  teSubtTr (D G : Ctx) (A A' : Ty G) (P : Id (Ty G) A A') (a : El G A) (s : Sub D G)
    : TE D (subT D G A s) (subT D G A' s) (subt D G A a s) (subt D G A' (trE G A A' P a) s) =
    (ap (Ty G) (Ty D) (\ X -> subT D G X s) A A' P,
     sym (El D (subT D G A' s)) (subt D G A' (trE G A A' P a) s) (trE D (subT D G A s) (subT D G A' s) (ap (Ty G) (Ty D) (\ X -> subT D G X s) A A' P) (subt D G A a s))
       (subt-tr D G A A' P a s)) ;

  -- an over-path is a TE
  teOv (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (a : El G A) (a' : El D A')
    (e : Ov D G A s A' PA a a') : TE D (subT D G A s) A' (subt D G A a s) a' = (PA, e) ;
} ;
