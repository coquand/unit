-- CwFS4.seg (M1 step 3, S4): Sigma A Equiv(X , Y) is contractible when
-- Sigma A Sigma (r : Y -> X) Kr r is, in a CwF with Pi, Sigma, Swan Id and
-- naive funext NF.
--
-- Informal text.  Over D = G.A, Equiv(X , Y) is a strict retract of
-- Q(X , Y) = Sigma r Sigma (k : Kr r) L r (CwFQP):
--   to Q:   (f , g , eta , h , eps) |-> (h , k , f , eps , g , eta), with
--           k the contractible fibres of h (qinvC: h has inverse f, eps,
--           and f h ~ id from eta and eps, CwFDer.secRet);
--   from Q: (r , k , f , hr , s , hs) |-> (f , s , hs , r , hr).
-- The composite is the identity on the variable: unpacking is stable
-- (CwFQP.QN), packing is stable (CwFEqP.MN), unpacking a packed element
-- gives its components back (CwFQP.BQ), packing the unpacked components
-- gives the element back (CwFEqP.UE.etaE).  So Sigma A Equiv is a strict
-- retract of Sigma A Q (CwFCtx.CRS).  Sigma A Q is contractible: reassociate
-- (CwFCtx.SR) to Sigma (Sigma A Sigma r Kr r) L and use sigCR, with L r
-- contractible over k (LC): Sigma f (r f ~ id) is contractible as the
-- fibres of r are (CwFAC.secC), and SecT f is, as the fibres of f are
-- (qinvC: f has inverse r, with r f ~ id and f r ~ id from k, CwFDer.fibRet).

open Base ;

module S4 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module PJ = CwFPrj.Prj[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module CX = CwFCtx.Ctx[l, C, PS, SS, IJ] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;
  module QC = CwFQinvC.QinvC[l, C, PS, SS, IJ, NF] ;
  module AC = CwFAC.AC[l, C, PS, SS, IJ, NF] ;
  module DR = CwFDer.Der[l, C, PS, SS, IJ, NF] ;
  module EP = CwFEqP.EqP[l, C, PS, SS, IJ] ;
  module QP = CwFQP.QP[l, C, PS, SS, IJ, NF] ;

  ----------------------------------------------------------------------
  -- (1) contractible fibres from a quasi-inverse, at the variable

  fibC (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X))
    (eta : El D (EQ.Htpy D Y X g f)) (eps : El D (EQ.Htpy D X Y f g))
    : El (ext D Y) (EQ.isContr (ext D Y) (QB.FibE (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y f) (q D Y))) =
    QC.qinvC (ext D Y) (wkT D Y X) (wkT D Y Y) (EQ.wkF D Y X Y f) (EQ.wkF D Y Y X g)
      (DR.wkH D Y Y X g f eta) (DR.wkH D Y X Y f g eps) (q D Y) ;

  -- the fibres of h are contractible, from an equivalence (f , g , eta , h , eps)
  kOf (D : Ctx) (X Y : Ty D) (f : El D (Fun D X Y)) (g : El D (Fun D Y X)) (eta : El D (EQ.Htpy D X Y f g))
    (h : El D (Fun D Y X)) (eps : El D (EQ.Htpy D Y X h f)) : El D (QP.Kr D X Y h) =
    lam D X (EQ.isContr (ext D X) (QP.FVr D X Y h))
      (fibC D Y X h f DR.SRm[D, X, Y, f, g, h, eta, eps].secRet eps) ;

  -- a weakened homotopy type is a homotopy type
  HtW (D : Ctx) (Z X Y : Ty D) (u : El D (Fun D X Y)) (v : El D (Fun D Y X))
    : Id (Ty (ext D Z)) (wkT D Z (EQ.Htpy D X Y u v)) (EQ.Htpy (ext D Z) (wkT D Z X) (wkT D Z Y) (EQ.wkF D Z X Y u) (EQ.wkF D Z Y X v)) =
    EQ.Htpy-ov (ext D Z) D X Y u v (p D Z) (wkT D Z X) (refl (wkT D Z X)) (wkT D Z Y) (refl (wkT D Z Y))
      (EQ.wkFP D Z X Y) (EQ.wkF D Z X Y u) (refl (EQ.wkF D Z X Y u)) (EQ.wkFP D Z Y X) (EQ.wkF D Z Y X v) (refl (EQ.wkF D Z Y X v)) ;

  -- Kr weakened
  KrW (D : Ctx) (Z X Y : Ty D) (r : El D (Fun D Y X))
    : Id (Ty (ext D Z)) (wkT D Z (QP.Kr D X Y r)) (QP.Kr (ext D Z) (wkT D Z X) (wkT D Z Y) (EQ.wkF D Z Y X r)) =
    QP.Kr-ov (ext D Z) D X Y r (p D Z) (wkT D Z X) (refl (wkT D Z X)) (wkT D Z Y) (refl (wkT D Z Y))
      (EQ.wkFP D Z Y X) (EQ.wkF D Z Y X r) (refl (EQ.wkF D Z Y X r)) ;

  ----------------------------------------------------------------------
  -- (2) L r is contractible over k : Kr r

  module LCm (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (k : El G (QP.Kr G X Y r)) {
    module LVc = QP.LV[G, X, Y, r] ;
    -- Sigma f (r f ~ id): the fibres of r
    kS : El G (EQ.isContr G (SS.Sig G LVc.FXY LVc.H)) =
      AC.SA[G, Y, X, r].secC (bod G X (EQ.isContr (ext G X) (QP.FVr G X Y r)) k) ;

    -- over E2 = G.f.hr
    r1 : El LVc.KF (Fun LVc.KF LVc.Y1 LVc.X1) = EQ.wkF G LVc.FXY Y X r ;
    r2 : El LVc.E2 (Fun LVc.E2 LVc.Y2 LVc.X2) = EQ.wkF LVc.KF LVc.H LVc.Y1 LVc.X1 r1 ;
    k1 : El LVc.KF (QP.Kr LVc.KF LVc.X1 LVc.Y1 r1) = trE LVc.KF (wkT G LVc.FXY (QP.Kr G X Y r)) (QP.Kr LVc.KF LVc.X1 LVc.Y1 r1) (KrW G LVc.FXY X Y r) (wkE G LVc.FXY (QP.Kr G X Y r) k) ;
    k2 : El LVc.E2 (QP.Kr LVc.E2 LVc.X2 LVc.Y2 r2) = trE LVc.E2 (wkT LVc.KF LVc.H (QP.Kr LVc.KF LVc.X1 LVc.Y1 r1)) (QP.Kr LVc.E2 LVc.X2 LVc.Y2 r2) (KrW LVc.KF LVc.H LVc.X1 LVc.Y1 r1) (wkE LVc.KF LVc.H (QP.Kr LVc.KF LVc.X1 LVc.Y1 r1) k1) ;
    kr2 : El (ext LVc.E2 LVc.X2) (EQ.isContr (ext LVc.E2 LVc.X2) (QP.FVr LVc.E2 LVc.X2 LVc.Y2 r2)) = bod LVc.E2 LVc.X2 (EQ.isContr (ext LVc.E2 LVc.X2) (QP.FVr LVc.E2 LVc.X2 LVc.Y2 r2)) k2 ;
    hr2 : El LVc.E2 (EQ.Htpy LVc.E2 LVc.Y2 LVc.X2 r2 LVc.f2) =
      trE LVc.E2 (wkT LVc.KF LVc.H LVc.H) (EQ.Htpy LVc.E2 LVc.Y2 LVc.X2 r2 LVc.f2) (HtW LVc.KF LVc.H LVc.Y1 LVc.X1 r1 (EQ.qF G X Y)) (q LVc.KF LVc.H) ;
    fr2 : El LVc.E2 (EQ.Htpy LVc.E2 LVc.X2 LVc.Y2 LVc.f2 r2) = DR.FRm[LVc.E2, LVc.Y2, LVc.X2, r2, LVc.f2, kr2, hr2].fibRet ;
    kC : El LVc.E2 (EQ.isContr LVc.E2 LVc.Cc) = AC.SA[LVc.E2, LVc.X2, LVc.Y2, LVc.f2].secC (fibC LVc.E2 LVc.X2 LVc.Y2 LVc.f2 r2 hr2 fr2) ;

    kL : El G (EQ.isContr G (QP.L G X Y r)) = CX.SR[G, LVc.FXY, LVc.H, LVc.Cc].sigCR kS kC ;
  } ;

  ----------------------------------------------------------------------
  -- (3) the two maps, and packing equal components

  module TQ (D : Ctx) (X Y : Ty D) (e : El D (EQ.Equiv D X Y)) {
    module UE = EP.UE[D, X, Y, e] ;
    res : El D (QP.QF D X Y) =
      QP.mkQ D X Y UE.h (kOf D X Y UE.f UE.g UE.eta UE.h UE.eps) (QP.mkL D X Y UE.h UE.f UE.eps (QP.mkSec D X Y UE.f UE.g UE.eta)) ;
  } ;

  toQE (D : Ctx) (X Y : Ty D) (e : El D (EQ.Equiv D X Y)) : El D (QP.QF D X Y) = TQ[D, X, Y, e].res ;

  module TT (D : Ctx) (X Y : Ty D) (w : El D (QP.QF D X Y)) {
    module W = QP.UQ[D, X, Y, w] ;
    res : El D (EQ.Equiv D X Y) = EP.mkE D X Y W.f W.s W.hs W.r W.hr ;
  } ;

  toTQ (D : Ctx) (X Y : Ty D) (w : El D (QP.QF D X Y)) : El D (EQ.Equiv D X Y) = TT[D, X, Y, w].res ;

  mkE-cong (D : Ctx) (X Y : Ty D) (f f2 : El D (Fun D X Y)) (ef : Id (El D (Fun D X Y)) f f2)
    (g g2 : El D (Fun D Y X)) (eg : Id (El D (Fun D Y X)) g g2)
    (h h2 : El D (Fun D Y X)) (eh : Id (El D (Fun D Y X)) h h2)
    (eta : El D (EQ.Htpy D X Y f g)) (eta2 : El D (EQ.Htpy D X Y f2 g2)) (Teta : IN.TE D (EQ.Htpy D X Y f g) (EQ.Htpy D X Y f2 g2) eta eta2)
    (eps : El D (EQ.Htpy D Y X h f)) (eps2 : El D (EQ.Htpy D Y X h2 f2)) (Teps : IN.TE D (EQ.Htpy D Y X h f) (EQ.Htpy D Y X h2 f2) eps eps2)
    : Id (El D (EQ.Equiv D X Y)) (EP.mkE D X Y f g eta h eps) (EP.mkE D X Y f2 g2 eta2 h2 eps2) =
    idJ (El D (Fun D X Y)) f
      (\ f3 e3 -> (g3 : El D (Fun D Y X)) -> Id (El D (Fun D Y X)) g g3 -> (h3 : El D (Fun D Y X)) -> Id (El D (Fun D Y X)) h h3
         -> (eta3 : El D (EQ.Htpy D X Y f3 g3)) -> IN.TE D (EQ.Htpy D X Y f g) (EQ.Htpy D X Y f3 g3) eta eta3
         -> (eps3 : El D (EQ.Htpy D Y X h3 f3)) -> IN.TE D (EQ.Htpy D Y X h f) (EQ.Htpy D Y X h3 f3) eps eps3
         -> Id (El D (EQ.Equiv D X Y)) (EP.mkE D X Y f g eta h eps) (EP.mkE D X Y f3 g3 eta3 h3 eps3))
      (\ g3 eg3 ->
         idJ (El D (Fun D Y X)) g
           (\ g4 e4 -> (h3 : El D (Fun D Y X)) -> Id (El D (Fun D Y X)) h h3
              -> (eta3 : El D (EQ.Htpy D X Y f g4)) -> IN.TE D (EQ.Htpy D X Y f g) (EQ.Htpy D X Y f g4) eta eta3
              -> (eps3 : El D (EQ.Htpy D Y X h3 f)) -> IN.TE D (EQ.Htpy D Y X h f) (EQ.Htpy D Y X h3 f) eps eps3
              -> Id (El D (EQ.Equiv D X Y)) (EP.mkE D X Y f g eta h eps) (EP.mkE D X Y f g4 eta3 h3 eps3))
           (\ h3 eh3 ->
              idJ (El D (Fun D Y X)) h
                (\ h4 e5 -> (eta3 : El D (EQ.Htpy D X Y f g)) -> IN.TE D (EQ.Htpy D X Y f g) (EQ.Htpy D X Y f g) eta eta3
                   -> (eps3 : El D (EQ.Htpy D Y X h4 f)) -> IN.TE D (EQ.Htpy D Y X h f) (EQ.Htpy D Y X h4 f) eps eps3
                   -> Id (El D (EQ.Equiv D X Y)) (EP.mkE D X Y f g eta h eps) (EP.mkE D X Y f g eta3 h4 eps3))
                (\ eta3 T3 eps3 T4 ->
                   trans (El D (EQ.Equiv D X Y)) (EP.mkE D X Y f g eta h eps) (EP.mkE D X Y f g eta3 h eps) (EP.mkE D X Y f g eta3 h eps3)
                     (ap (El D (EQ.Htpy D X Y f g)) (El D (EQ.Equiv D X Y)) (\ v -> EP.mkE D X Y f g v h eps) eta eta3
                         (PJ.teId D (EQ.Htpy D X Y f g) eta eta3 T3))
                     (ap (El D (EQ.Htpy D Y X h f)) (El D (EQ.Equiv D X Y)) (\ v -> EP.mkE D X Y f g eta3 h v) eps eps3
                         (PJ.teId D (EQ.Htpy D Y X h f) eps eps3 T4)))
                h3 eh3)
           g3 eg3)
      f2 ef g2 eg h2 eh eta2 Teta eps2 Teps ;

  ----------------------------------------------------------------------
  -- (4) the fibre retract D.Equiv <| D.Q, over D

  module FR (D : Ctx) (X Y : Ty D) {
    E : Ty D = EQ.Equiv D X Y ;
    Q : Ty D = QP.QF D X Y ;
    DE : Ctx = ext D E ;
    DQ : Ctx = ext D Q ;
    XE : Ty DE = wkT D E X ;
    YE : Ty DE = wkT D E Y ;
    XQ : Ty DQ = wkT D Q X ;
    YQ : Ty DQ = wkT D Q Y ;
    PEe : Id (Ty DE) (wkT D E E) (EQ.Equiv DE XE YE) = EQ.Equiv-ov DE D X Y (p D E) XE (refl XE) YE (refl YE) ;
    PQe : Id (Ty DE) (wkT D E Q) (QP.QF DE XE YE) = QP.QF-ov DE D X Y (p D E) XE (refl XE) YE (refl YE) ;
    PEq : Id (Ty DQ) (wkT D Q E) (EQ.Equiv DQ XQ YQ) = EQ.Equiv-ov DQ D X Y (p D Q) XQ (refl XQ) YQ (refl YQ) ;
    PQq : Id (Ty DQ) (wkT D Q Q) (QP.QF DQ XQ YQ) = QP.QF-ov DQ D X Y (p D Q) XQ (refl XQ) YQ (refl YQ) ;

    eE : El DE (EQ.Equiv DE XE YE) = trE DE (wkT D E E) (EQ.Equiv DE XE YE) PEe (q D E) ;
    smE : El DE (QP.QF DE XE YE) = toQE DE XE YE eE ;
    sm : El DE (wkT D E Q) = trE DE (QP.QF DE XE YE) (wkT D E Q) (sym (Ty DE) (wkT D E Q) (QP.QF DE XE YE) PQe) smE ;
    sg : Sub DE DQ = extS DE D Q (p D E) sm ;

    wQ : El DQ (QP.QF DQ XQ YQ) = trE DQ (wkT D Q Q) (QP.QF DQ XQ YQ) PQq (q D Q) ;
    rmQ : El DQ (EQ.Equiv DQ XQ YQ) = toTQ DQ XQ YQ wQ ;
    rm : El DQ (wkT D Q E) = trE DQ (EQ.Equiv DQ XQ YQ) (wkT D Q E) (sym (Ty DQ) (wkT D Q E) (EQ.Equiv DQ XQ YQ) PEq) rmQ ;
    tu : Sub DQ DE = extS DQ D E (p D Q) rm ;

    psg : Id (Sub DE D) (o DE DQ D (p D Q) sg) (p D E) = IN.p-extS DE D Q (p D E) sm ;
    ptu : Id (Sub DQ D) (o DQ DE D (p D E) tu) (p D Q) = IN.p-extS DQ D E (p D Q) rm ;

    -- X and Y over Q, along sg
    PXs : Id (Ty DE) (subT DE DQ XQ sg) XE =
      trans (Ty DE) (subT DE DQ XQ sg) (subT DE D X (o DE DQ D (p D Q) sg)) XE
        (sym (Ty DE) (subT DE D X (o DE DQ D (p D Q) sg)) (subT DE DQ XQ sg) (subT-o DE DQ D X (p D Q) sg))
        (ap (Sub DE D) (Ty DE) (\ t -> subT DE D X t) (o DE DQ D (p D Q) sg) (p D E) psg) ;
    PYs : Id (Ty DE) (subT DE DQ YQ sg) YE =
      trans (Ty DE) (subT DE DQ YQ sg) (subT DE D Y (o DE DQ D (p D Q) sg)) YE
        (sym (Ty DE) (subT DE D Y (o DE DQ D (p D Q) sg)) (subT DE DQ YQ sg) (subT-o DE DQ D Y (p D Q) sg))
        (ap (Sub DE D) (Ty DE) (\ t -> subT DE D Y t) (o DE DQ D (p D Q) sg) (p D E) psg) ;

    -- the variable of Q along sg is to Q of the variable of E
    Tw : IN.TE DE (subT DE DQ (QP.QF DQ XQ YQ) sg) (QP.QF DE XE YE) (subt DE DQ (QP.QF DQ XQ YQ) wQ sg) smE =
      IN.teT DE (subT DE DQ (QP.QF DQ XQ YQ) sg) (subT DE DQ (wkT D Q Q) sg) (QP.QF DE XE YE) (subt DE DQ (QP.QF DQ XQ YQ) wQ sg) (subt DE DQ (wkT D Q Q) (q D Q) sg) smE
        (SV.teSub DE DQ (QP.QF DQ XQ YQ) (wkT D Q Q) wQ (q D Q) (PJ.teTrS DQ (wkT D Q Q) (QP.QF DQ XQ YQ) PQq (q D Q)) sg)
        (IN.teT DE (subT DE DQ (wkT D Q Q) sg) (wkT D E Q) (QP.QF DE XE YE) (subt DE DQ (wkT D Q Q) (q D Q) sg) sm smE
           (IN.teOv DE DQ (wkT D Q Q) sg (wkT D E Q) (IN.wkT-extS DE D Q Q (p D E) sm) (q D Q) sm
              (JP.q-extS DE D Q (p D E) sm (IN.wkT-extS DE D Q Q (p D E) sm)))
           (PJ.teTrS DE (QP.QF DE XE YE) (wkT D E Q) (sym (Ty DE) (wkT D E Q) (QP.QF DE XE YE) PQe) smE)) ;
    Pw : Ov DE DQ (QP.QF DQ XQ YQ) sg (QP.QF DE XE YE) (QP.QF-ov DE DQ XQ YQ sg XE PXs YE PYs) wQ smE =
      IN.teAny DE (subT DE DQ (QP.QF DQ XQ YQ) sg) (QP.QF DE XE YE) (subt DE DQ (QP.QF DQ XQ YQ) wQ sg) smE Tw (QP.QF-ov DE DQ XQ YQ sg XE PXs YE PYs) ;

    module QNs = QP.QN[DE, DQ, sg, XQ, YQ, XE, YE, PXs, PYs, wQ, smE, Pw] ;
    module MNs = EP.MN[DE, DQ, sg, XQ, YQ, XE, YE, PXs, PYs, QNs.A.f, QNs.B.f, QNs.Of, QNs.A.s, QNs.B.s, QNs.Os, QNs.A.hs, QNs.B.hs, QNs.Ohs,
                       QNs.A.r, QNs.B.r, QNs.Or, QNs.A.hr, QNs.B.hr, QNs.Ohr] ;
    module UEe = EP.UE[DE, XE, YE, eE] ;
    module BQs = QP.BQ[DE, XE, YE, UEe.h, kOf DE XE YE UEe.f UEe.g UEe.eta UEe.h UEe.eps, UEe.f, UEe.eps, UEe.g, UEe.eta] ;

    mkB : El DE (EQ.Equiv DE XE YE) = EP.mkE DE XE YE QNs.B.f QNs.B.s QNs.B.hs QNs.B.r QNs.B.hr ;
    eB : Id (El DE (EQ.Equiv DE XE YE)) mkB eE =
      trans (El DE (EQ.Equiv DE XE YE)) mkB (EP.mkE DE XE YE UEe.f UEe.g UEe.eta UEe.h UEe.eps) eE
        (mkE-cong DE XE YE QNs.B.f UEe.f BQs.ef QNs.B.s UEe.g BQs.es QNs.B.r UEe.h BQs.er QNs.B.hs UEe.eta BQs.Ths QNs.B.hr UEe.eps BQs.Thr)
        UEe.etaE ;

    -- q along tu sg is q
    Tq : IN.TE DE (subT DE (ext D E) (wkT D E E) (o DE DQ (ext D E) tu sg)) (wkT D E E) (subt DE (ext D E) (wkT D E E) (q D E) (o DE DQ (ext D E) tu sg)) (q D E) =
      IN.teT DE (subT DE (ext D E) (wkT D E E) (o DE DQ (ext D E) tu sg)) (subT DE DQ (subT DQ (ext D E) (wkT D E E) tu) sg) (wkT D E E)
        (subt DE (ext D E) (wkT D E E) (q D E) (o DE DQ (ext D E) tu sg)) (subt DE DQ (subT DQ (ext D E) (wkT D E E) tu) (subt DQ (ext D E) (wkT D E E) (q D E) tu) sg) (q D E)
        (IN.teSubtO DE DQ (ext D E) (wkT D E E) (q D E) tu sg)
        (IN.teT DE (subT DE DQ (subT DQ (ext D E) (wkT D E E) tu) sg) (subT DE DQ (wkT D Q E) sg) (wkT D E E)
           (subt DE DQ (subT DQ (ext D E) (wkT D E E) tu) (subt DQ (ext D E) (wkT D E E) (q D E) tu) sg) (subt DE DQ (wkT D Q E) rm sg) (q D E)
           (SV.teSub DE DQ (subT DQ (ext D E) (wkT D E E) tu) (wkT D Q E) (subt DQ (ext D E) (wkT D E E) (q D E) tu) rm
              (IN.teOv DQ (ext D E) (wkT D E E) tu (wkT D Q E) (IN.wkT-extS DQ D E E (p D Q) rm) (q D E) rm
                 (JP.q-extS DQ D E (p D Q) rm (IN.wkT-extS DQ D E E (p D Q) rm))) sg)
           (IN.teT DE (subT DE DQ (wkT D Q E) sg) (subT DE DQ (EQ.Equiv DQ XQ YQ) sg) (wkT D E E)
              (subt DE DQ (wkT D Q E) rm sg) (subt DE DQ (EQ.Equiv DQ XQ YQ) rmQ sg) (q D E)
              (SV.teSub DE DQ (wkT D Q E) (EQ.Equiv DQ XQ YQ) rm rmQ
                 (PJ.teTrS DQ (EQ.Equiv DQ XQ YQ) (wkT D Q E) (sym (Ty DQ) (wkT D Q E) (EQ.Equiv DQ XQ YQ) PEq) rmQ) sg)
              (IN.teT DE (subT DE DQ (EQ.Equiv DQ XQ YQ) sg) (EQ.Equiv DE XE YE) (wkT D E E) (subt DE DQ (EQ.Equiv DQ XQ YQ) rmQ sg) mkB (q D E)
                 (IN.teOv DE DQ (EQ.Equiv DQ XQ YQ) sg (EQ.Equiv DE XE YE) MNs.PE rmQ mkB MNs.OE)
                 (IN.teT DE (EQ.Equiv DE XE YE) (EQ.Equiv DE XE YE) (wkT D E E) mkB eE (q D E)
                    (refl (EQ.Equiv DE XE YE), eB)
                    (PJ.teTrS DE (wkT D E E) (EQ.Equiv DE XE YE) PEe (q D E)))))) ;

    eP : Id (Sub DE D) (o DE (ext D E) D (p D E) (o DE DQ (ext D E) tu sg)) (o DE (ext D E) D (p D E) (id DE)) =
      calc (Sub DE D) {
          o DE (ext D E) D (p D E) (o DE DQ (ext D E) tu sg)
        =< sym (Sub DE D) (o DE DQ D (o DQ (ext D E) D (p D E) tu) sg) (o DE (ext D E) D (p D E) (o DE DQ (ext D E) tu sg))
              (o-assoc DE DQ (ext D E) D (p D E) tu sg) >
          o DE DQ D (o DQ (ext D E) D (p D E) tu) sg
        =< ap (Sub DQ D) (Sub DE D) (\ t -> o DE DQ D t sg) (o DQ (ext D E) D (p D E) tu) (p D Q) ptu >
          o DE DQ D (p D Q) sg
        =< psg >
          p D E
        =< sym (Sub DE D) (o DE (ext D E) D (p D E) (id DE)) (p D E) (o-idr DE D (p D E)) >
          o DE (ext D E) D (p D E) (id DE) } ;

    e : Id (Sub DE DE) (o DE DQ DE tu sg) (id DE) =
      IN.ext-eq DE D E (o DE DQ (ext D E) tu sg) (id DE) eP (wkT D E E) (q D E) Tq.1 Tq.2
        (subT-id DE (wkT D E E)) (subt-id DE (wkT D E E) (q D E)) ;
  } ;

  ----------------------------------------------------------------------
  -- (5) the theorem

  module Main (G : Ctx) (A : Ty G) (X Y : Ty (ext G A)) {
    D : Ctx = ext G A ;
    module F = FR[D, X, Y] ;
    module CR1 = CX.CRS[G, A, F.E, F.Q, F.sg, F.psg, F.tu, F.ptu, F.e] ;
    module QVd = QP.QV[D, X, Y] ;
    module SRd = CX.SR[D, QVd.FYX, QVd.K1, QVd.LL] ;
    module CR2 = CX.CRS[G, A, F.Q, SRd.L, SRd.sg, SRd.psg, SRd.tu, SRd.ptu, SRd.tusg] ;

    kv : El QVd.G2 (QP.Kr QVd.G2 QVd.X2 QVd.Y2 QVd.r2) =
      trE QVd.G2 (wkT QVd.G1 QVd.K1 QVd.K1) (QP.Kr QVd.G2 QVd.X2 QVd.Y2 QVd.r2) (KrW QVd.G1 QVd.K1 QVd.X1 QVd.Y1 QVd.r1) (q QVd.G1 QVd.K1) ;
    kLL : El QVd.G2 (EQ.isContr QVd.G2 QVd.LL) = LCm[QVd.G2, QVd.X2, QVd.Y2, QVd.r2, kv].kL ;
    kC : El SRd.ES (EQ.isContr SRd.ES SRd.C') =
      trE SRd.ES (subT SRd.ES QVd.G2 (EQ.isContr QVd.G2 QVd.LL) SRd.VAB.unpk) (EQ.isContr SRd.ES SRd.C')
        (EQ.isContr-ov SRd.ES QVd.G2 QVd.LL SRd.VAB.unpk SRd.C' (refl SRd.C'))
        (subt SRd.ES QVd.G2 (EQ.isContr QVd.G2 QVd.LL) kLL SRd.VAB.unpk) ;

    main (uaC : El G (EQ.isContr G (SS.Sig G A SRd.S))) : El G (EQ.isContr G (SS.Sig G A F.E)) =
      CR1.CRT.ctrS (CR2.CRT.ctrS (CX.SR[G, A, SRd.S, SRd.C'].sigCR uaC kC)) ;
  } ;

  -- Sigma A Equiv(X , Y) is contractible if Sigma A Sigma (r : Y -> X) Kr r is
  s4 (G : Ctx) (A : Ty G) (X Y : Ty (ext G A))
    (uaC : El G (EQ.isContr G (SS.Sig G A (SS.Sig (ext G A) (Fun (ext G A) Y X) (QP.QV[ext G A, X, Y].K1)))))
    : El G (EQ.isContr G (SS.Sig G A (EQ.Equiv (ext G A) X Y))) = Main[G, A, X, Y].main uaC ;
} ;
