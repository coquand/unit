-- PosCof.seg (M1, step 1): the cofibrations of the poset base, choice (2)
-- of M1.md §1, the sieves generated by lattice equations t = u.
--
-- Informal text.  A cofibration of a finite poset X is a finite union of
-- sieves of full subposets.  A map f : W -> X factors through a full
-- subposet A iff its image lies in A, so such a sieve is determined by
-- images: if f lands and every value of k is a value of f, then k lands.
-- Conversely a decidable sieve with this property is the union of the
-- sieves of the images of its maps, a finite union.  So:
--
--   a cofibration is a decidable sieve Q (CSieve) with  Full X Q :
--   f lands in Q and k is covered by f  imply  k lands in Q.
--
-- Full is a proposition, so a cofibration is determined by its maps
-- (phi-ext).  Closure, each a short argument:
--   pullback along h :  k covered by g  gives  h k covered by h g;
--   empty, total     :  nothing lands / everything lands;
--   a subset sieve   :  landing is a condition on values (end points);
--   finite union     :  apply Full in the piece where f lands.
-- ∀ along the interval and dependent conjunction need the image as a
-- poset: PosCofAll.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Axioms[a+].FunExtLemmas[fe @(a+)] ;
open Trees[a] ;
open Arith[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
open CPosBase[a] ;

------------------------------------------------------------------------
-- some element of a list satisfies P

anyL (P : Tree -> Bool) : Tree -> Bool = split {
  leaf n -> false ;
  node t l | ih-t ih-l -> or (P t) ih-l } ;

anyL-sound (P : Tree -> Bool) : (l : Tree) -> IsT (anyL P l) -> (t : Tree) * IsT (P t) = split {
  leaf n -> \ h -> absurd ((t : Tree) * IsT (P t)) (false-true h) ;
  node t l | ih-t ih-l -> \ h ->
    or-elim ((t' : Tree) * IsT (P t')) (P t) (anyL P l) h (\ p -> (t, p)) (\ q -> ih-l q) } ;

anyL-complete (P : Tree -> Bool) : (l x : Tree) -> IsT (mem x l) -> IsT (P x) -> IsT (anyL P l) = split {
  leaf n -> \ x m p -> absurd (IsT false) (false-true m) ;
  node t l | ih-t ih-l -> \ x m p ->
    or-elim (IsT (or (P t) (anyL P l))) (eqT x t) (mem x l) m
      (\ e -> or-l (P t) (anyL P l) (substH (\ y -> IsT (P y)) (eqT-sound x t e) p))
      (\ m' -> or-r (P t) (anyL P l) (ih-l x m' p)) } ;

------------------------------------------------------------------------
-- the image of f : W -> X, as a decidable subset of X

module Image (W X : Ob) (f : Hom W X) {
  -- the points of W sent to x
  hit (x : El X) : Subset W = \ s -> eqT (app W X f s).1 x.1 ;

  inIm (x : El X) : Bool = anyL (QT[W, hit x].qT) (enum W) ;

  qB-sound (x : El X) (t : Tree) : (b : Bool) (e : Id Bool (car W t) b) -> IsT (QT[W, hit x].qB t b e)
    -> (h : IsT (car W t)) * IsT (hit x (t, h)) = split {
    true -> \ e i -> (e, i) ;
    false -> \ e i -> absurd ((h : IsT (car W t)) * IsT (hit x (t, h))) (false-true i) } ;

  -- x in the image is a value of f
  im-sound (x : El X) (i : IsT (inIm x)) : (s : El W) * Id Tree (app W X f s).1 x.1 =
    ((r.1, q.1), eqT-sound (app W X f (r.1, q.1)).1 x.1 q.2)
   where { r : (t : Tree) * IsT (QT[W, hit x].qT t) = anyL-sound (QT[W, hit x].qT) (enum W) i ;
           q : (h : IsT (car W r.1)) * IsT (hit x (r.1, h)) = qB-sound x r.1 (car W r.1) (refl (car W r.1)) r.2 ; } ;

  -- a value of f is in the image
  im-complete (s : El W) : IsT (inIm (app W X f s)) =
    anyL-complete (QT[W, hit (app W X f s)].qT) (enum W) s.1 (cover W s.1 s.2)
      (transH (QT[W, hit (app W X f s)].qT-el s) (eqT-refl (app W X f s).1)) ;

  im-at (x : El X) (s : El W) (p : Id (El X) (app W X f s) x) : IsT (inIm x) =
    substH (\ y -> IsT (inIm y)) p (im-complete s) ;
} ;

-- every value of k is a value of f
Covered (V W X : Ob) (k : Hom V X) (f : Hom W X) : U a =
  (v : El V) -> IsT (Image[W, X, f].inIm (app V X k v)) ;

-- composing with h keeps the covering
covered-comp (V W Y X : Ob) (h : Hom Y X) (k : Hom V Y) (g : Hom W Y) (c : Covered V W Y k g)
  : Covered V W X (compH V Y X h k) (compH W Y X h g) = \ v ->
  Image[W, X, compH W Y X h g].im-at (app V X (compH V Y X h k) v) (r v).1 (val v)
 where { r (v : El V) : (s : El W) * Id Tree (app W Y g s).1 (app V Y k v).1 =
           Image[W, Y, g].im-sound (app V Y k v) (c v) ;
         val (v : El V) : Id (El X) (app W X (compH W Y X h g) (r v).1) (app V X (compH V Y X h k) v) =
           transH (app-compH W Y X h g (r v).1)
             (transH (apH (app Y X h) (el-eq Y (app W Y g (r v).1) (app V Y k v) (r v).2))
                     (symH (app-compH V Y X h k v))) ; } ;

------------------------------------------------------------------------
-- the property, and the cofibrations

Full (X : Ob) (Q : SP.Phi X) : U a =
  (W V : Ob) (f : Hom W X) (k : Hom V X) -> SP.Lands W X Q f -> Covered V W X k f -> SP.Lands V X Q k ;

isProp-Full (X : Ob) (Q : SP.Phi X) : isProp (Full X Q) =
  isProp-Pi Ob (\ W -> (V : Ob) (f : Hom W X) (k : Hom V X) -> SP.Lands W X Q f -> Covered V W X k f -> SP.Lands V X Q k) (\ W ->
  isProp-Pi Ob (\ V -> (f : Hom W X) (k : Hom V X) -> SP.Lands W X Q f -> Covered V W X k f -> SP.Lands V X Q k) (\ V ->
  isProp-Pi (Hom W X) (\ f -> (k : Hom V X) -> SP.Lands W X Q f -> Covered V W X k f -> SP.Lands V X Q k) (\ f ->
  isProp-Pi (Hom V X) (\ k -> SP.Lands W X Q f -> Covered V W X k f -> SP.Lands V X Q k) (\ k ->
  isProp-Pi (SP.Lands W X Q f) (\ i -> Covered V W X k f -> SP.Lands V X Q k) (\ i ->
  isProp-Pi (Covered V W X k f) (\ c -> SP.Lands V X Q k) (\ c -> SP.isProp-Lands V X Q k)))))) ;

-- closure under pullback
full-pre (Y X : Ob) (h : Hom Y X) (Q : SP.Phi X) (fQ : Full X Q) : Full Y (SP.pre Y X h Q) =
  \ W V g k i c -> fQ W V (compH W Y X h g) (compH V Y X h k) i (covered-comp V W Y X h k g c) ;

-- a sieve given by a subset (landing is a condition on values) is Full
val-id (W X : Ob) (f : Hom W X) (s : El W) : Id (El X) (app W X (compH W X X (idH X) f) s) (app W X f s) =
  transH (app-compH W X X (idH X) f s) (app-idH X (app W X f s)) ;

full-sub-at (X : Ob) (Q : Subset X) (W V : Ob) (f : Hom W X) (k : Hom V X)
  (i : SP.Lands W X (subS X X (idH X) Q) f) (c : Covered V W X k f) : SP.Lands V X (subS X X (idH X) Q) k =
  isIn-complete V X (compH V X X (idH X) k) Q (\ v ->
    substH (\ y -> IsT (Q y))
      (transH (el-eq X (app W X f (r v).1) (app V X k v) (r v).2) (symH (val-id V X k v)))
      (substH (\ y -> IsT (Q y)) (val-id W X f (r v).1) (isIn-sound W X (compH W X X (idH X) f) Q i (r v).1)))
 where { r (v : El V) : (s : El W) * Id Tree (app W X f s).1 (app V X k v).1 =
           Image[W, X, f].im-sound (app V X k v) (c v) ; } ;

full-sub (X : Ob) (Q : Subset X) : Full X (subS X X (idH X) Q) = full-sub-at X Q ;

-- the cofibrations, with the operations of the base interface (CBase.CB)
module PC {
  Phi (X : Ob) : U a = (Q : SP.Phi X) * Full X Q ;

  pre (Y X : Ob) (h : Hom Y X) (Q : Phi X) : Phi Y = (SP.pre Y X h Q.1, full-pre Y X h Q.1 Q.2) ;

  Lands (W X : Ob) (Q : Phi X) (f : Hom W X) : U a = SP.Lands W X Q.1 f ;

  isProp-Lands (W X : Ob) (Q : Phi X) (f : Hom W X) : isProp (Lands W X Q f) = SP.isProp-Lands W X Q.1 f ;

  lands-comp (W' W X : Ob) (Q : Phi X) (f : Hom W X) (chi : Hom W' W) (i : Lands W X Q f)
    : Lands W' X Q (compH W' W X f chi) = SP.lands-comp W' W X Q.1 f chi i ;

  lands-pre (W Y X : Ob) (h : Hom Y X) (Q : Phi X) (g : Hom W Y) (i : Lands W Y (pre Y X h Q) g)
    : Lands W X Q (compH W Y X h g) = i ;
  pre-lands (W Y X : Ob) (h : Hom Y X) (Q : Phi X) (g : Hom W Y) (i : Lands W X Q (compH W Y X h g))
    : Lands W Y (pre Y X h Q) g = i ;

  phi-ext (X : Ob) (Q Q' : Phi X) (p : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Lands W X Q' f)
    (q : (W : Ob) (f : Hom W X) -> Lands W X Q' f -> Lands W X Q f) : Id (Phi X) Q Q' =
    Sigma-eq (SP.Phi X) (\ R -> Full X R) Q.1 Q'.1 Q.2 Q'.2 (SP.phi-ext X Q.1 Q'.1 p q) (isProp-Full X Q'.1) ;

  emptyS (X : Ob) : Phi X =
    (SP.emptyS X, \ W V f k i c -> absurd (SP.Lands V X (SP.emptyS X) k) (SP.empty-lands W X f i)) ;
  empty-lands (W X : Ob) (f : Hom W X) (i : Lands W X (emptyS X) f) : Empty = SP.empty-lands W X f i ;

  topS (X : Ob) : Phi X = (SP.topS X, \ W V f k i c -> SP.top-lands V X k) ;
  top-lands (W X : Ob) (f : Hom W X) : Lands W X (topS X) f = SP.top-lands W X f ;

  -- the end points of [1]
  ptS (e : El Iv) : Phi Iv = (sptS e, full-sub Iv (PosetSub.ptS e)) ;
  lands-pt (W : Ob) (e : El Iv) (g : Hom W Iv) (i : Lands W Iv (ptS e) g) : Id (Hom W Iv) g (constH W Iv e) =
    slands-pt W e g i ;
  pt-lands (W : Ob) (e : El Iv) : Lands W Iv (ptS e) (constH W Iv e) = spt-lands W e ;
  pt-disj (W : Ob) (g : Hom W Iv) (i : Lands W Iv (ptS e0) g) (i' : Lands W Iv (ptS e1) g) : Empty =
    spt-disj W g i i' ;

  -- decided at the identity
  allS (X : Ob) (Q : Phi X) : Bool = SP.allS X Q.1 ;
  allS-sound (X : Ob) (Q : Phi X) (h : IsT (allS X Q)) : Lands X X Q (idH X) = SP.allS-sound X Q.1 h ;
  allS-complete (X : Ob) (Q : Phi X) (i : Lands X X Q (idH X)) : IsT (allS X Q) = SP.allS-complete X Q.1 i ;

  -- finite unions
  bigU (X : Ob) (r : Nat) (Q : Fin r -> Phi X) : Phi X =
    (SP.bigU X r (\ j -> (Q j).1), \ W V f k i c ->
      SP.bigU-in V X r (\ j -> (Q j).1) k (o W f i).1 ((Q (o W f i).1).2 W V f k (o W f i).2 c))
   where { o (W : Ob) (f : Hom W X) (i : SP.Lands W X (SP.bigU X r (\ j -> (Q j).1)) f)
             : (j : Fin r) * SP.Lands W X (Q j).1 f = SP.bigU-out W X r (\ j -> (Q j).1) f i ; } ;
  bigU-in (W X : Ob) (r : Nat) (Q : Fin r -> Phi X) (f : Hom W X) (k0 : Fin r) (i : Lands W X (Q k0) f)
    : Lands W X (bigU X r Q) f = SP.bigU-in W X r (\ j -> (Q j).1) f k0 i ;
  bigU-out (W X : Ob) (r : Nat) (Q : Fin r -> Phi X) (f : Hom W X) (i : Lands W X (bigU X r Q) f)
    : (k0 : Fin r) * Lands W X (Q k0) f = SP.bigU-out W X r (\ j -> (Q j).1) f i ;
} ;
