-- The constituent graph codes of PresheafPi.RawPi.rawCode, named at
-- either level so their members can be compared one constructor at a time.

level a l ;
constraint a <= l ;
open Base ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module W = V[l] ;
module VL = VLift[a, l] ;
module PB = PosFull[a].PB ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;

piO (B : Ob -> W.V) : W.V = VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) B ;
piH (J I : Ob) (B : Hom J I -> W.V) : W.V =
  VL.PiS (Hom J I) (VL.encIx (homV J I)) (VL.encIx-inj (homV J I)) B ;

module Parts (I : Ob) (Af : PP.RawPi[I].AfT) (Bf : PP.RawPi[I].BfT Af)
  (Aact : PP.RawPi[I].AactT Af) (Bact : PP.RawPi[I].BactT Af Bf Aact) {
  module R = PP.RawPi[I] ;

  FunArg (J : Ob) (f : Hom J I) : W.V = W.PiV (Af J f) (Bf J f) ;
  FunHom (J : Ob) : W.V = piH J I (FunArg J) ;
  Fun : W.V = piO FunHom ;

  module Nat (phi : R.RFun Af Bf) {
    IdCode (J K : Ob) (f : Hom J I) (g : Hom K J) (u : W.Ix (Af J f)) : W.V =
      W.IdV (Bf K (compH K J I f g) (Aact J K f g u))
        (Bact J K f g u (phi J f u)) (phi K (compH K J I f g) (Aact J K f g u)) ;
    Arg (J K : Ob) (f : Hom J I) (g : Hom K J) : W.V = W.PiV (Af J f) (IdCode J K f g) ;
    HomK (J K : Ob) (f : Hom J I) : W.V = piH K J (Arg J K f) ;
    HomJ (J K : Ob) : W.V = piH J I (HomK J K) ;
    ObjK (J : Ob) : W.V = piO (HomJ J) ;
    Code : W.V = piO ObjK ;
  } ;
} ;
