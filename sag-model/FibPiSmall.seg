-- Pi of small fibrant types is small. Use the small raw codes, retain
-- the existing Pi action, and transport the existing fibration to them.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module S = PB.CSmall ;
open PB.GPre[a+].PS ;
module W0 = V[a] ;
module W1 = V[a+] ;
module FS = FibNameSub[a] ;
module FC = FS.FC ;
module Fib = FibCwF[a, a+] ;
module PP = PresheafPi[a, a+].PPi[PB.BC] ;
module Raw = FibPiCode[a] ;

module Pi (G : PCtx) (A : FS.SmallFib G) (B : FS.SmallFib (extP G (FS.large G A).1)) {
  A0 : FC.STy G = FS.large G A ;
  GA : PCtx = extP G A0.1 ;
  B0 : FC.STy GA = FS.large GA B ;
  Big : FC.STy G = Fib.FPi.SPi.Pi G A0 B0 ;
  module P = PP.PiCode[G, A0.1, B0.1] ;

  module At (I : Ob) (x : W1.Ix (G.ob I)) {
    module L = Raw.P0.PP.RawPi[I] ;
    Af : L.AfT = \ J f -> A.1.tob J (P.ptOf I x J f) ;
    Bf : L.BfT Af = \ J f u -> B.1.tob J (pairE G A0.1 J (P.ptOf I x J f) u) ;
    module R = Raw.Raw[I, Af, Bf, P.AactOf I (P.ptOf I x) (P.cOf I x), P.BactOf I (P.ptOf I x) (P.cOf I x) (P.eOf I x)] ;
  } ;

  SmallTy : S.SPTy[G] = new S.SPTy[G, \ I x -> At[I, x].R.lo, P.piAct, P.piId, P.piOL] ;
  Up : PTy[G] = S.up G SmallTy ;

  codes : Id (TOb G) Up.tob Big.1.tob =
    funext Ob (\ I -> W1.Ix (G.ob I) -> W1.V) Up.tob Big.1.tob
      (\ I -> funext (W1.Ix (G.ob I)) (\ _ -> W1.V) (Up.tob I) (Big.1.tob I) (\ x -> At[I, x].R.law)) ;

  read (I : Ob) (x : W1.Ix (G.ob I)) (u : W1.Ix (Up.tob I x))
    : Id (W1.Ix (Big.1.tob I x)) (subst (TOb G) (\ k -> W1.Ix (k I x)) Up.tob Big.1.tob codes u) u =
    transH (subst-ap (TOb G) W1.V (\ k -> k I x) (\ v -> W1.Ix v) Up.tob Big.1.tob codes u)
      (At[I, x].R.cast (apH (\ k -> k I x) codes) u) ;
  opaque read ;

  types : Id (PTy[G]) Up Big.1 =
    ty-ext2 G Up Big.1 codes (\ J I f x y e u ->
      transH (read J y (Up.tact J I f x y e u))
        (apH (Big.1.tact J I f x y e) (symH (read I x u)))) ;
  opaque types ;

  FibAt (T : PTy[G]) : U a++ = PB.CLine[a+].Lines[G, T].Fib ;

  small-fib : FibAt Up = subst (PTy[G]) FibAt Big.1 Up (symH types) Big.2 ;
  small : FS.SmallFib G = (SmallTy, small-fib) ;

  law : Id (FC.STy G) (FS.large G small) Big =
    symH (Sigma-path (PTy[G]) FibAt Big.1 Up Big.2 small-fib (symH types) (refl small-fib)) ;
  opaque law ;
} ;
