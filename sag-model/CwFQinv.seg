-- CwFQinv.seg (M1 step 3, S4 toolkit): fibres of maps, and step B of
-- "a quasi-invertible map has contractible fibres" (Escardo), in a CwF
-- with Pi, Sigma, Swan Id and naive function extensionality NF.
--
-- FibE e w = Sigma (x : X) Id(e x , w), the co-based fibre of e : X -> Y
-- at w (the orientation of CwFEq.Htpy).
--
-- Informal text.
-- (1) FibE is stable: Sig-ov, Id-ov, app-ov, wkF-ov, wkE-ov.
-- (2) Step B.  Let f : X -> Y, g : Y -> X, eps : Htpy f g (f (g y) = y),
--     w : Y.  Over G.(h : Y -> Y) the family CF h = isContr (FibE h w).
--     NF applied to sym(eps) is a path idY = f o g in Y -> Y; transporting
--     the contractibility of the co-based singleton (CwFCoS: FibE idY w,
--     since app idY y = y) along it gives isContr (FibE (f o g) w).

open Base ;

module Qinv (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module CO = CwFCoS.CoS[l, C, PS, SS, IJ] ;

  ----------------------------------------------------------------------
  -- (1) fibres

  FamE (D : Ctx) (X Y : Ty D) (e : El D (Fun D X Y)) (w : El D Y) : Ty (ext D X) =
    IJ.IdT (ext D X) (wkT D X Y) (app (ext D X) (wkT D X X) (wkT D X Y) (EQ.wkF D X X Y e) (q D X)) (wkE D X Y w) ;

  FibE (D : Ctx) (X Y : Ty D) (e : El D (Fun D X Y)) (w : El D Y) : Ty D = SS.Sig D X (FamE D X Y e w) ;

  FamE-ov (D G : Ctx) (X Y : Ty G) (e : El G (Fun G X Y)) (w : El G Y) (s : Sub D G) (X' Y' : Ty D)
    (PX : Id (Ty D) (subT D G X s) X') (PY : Id (Ty D) (subT D G Y s) Y') (PF : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y'))
    (e' : El D (Fun D X' Y')) (Pe : Ov D G (Fun G X Y) s (Fun D X' Y') PF e e') (w' : El D Y') (Pw : Ov D G Y s Y' PY w w')
    : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (FamE G X Y e w) (upT D G X s X' PX)) (FamE D X' Y' e' w') =
    Id-ov (ext D X') (ext G X) (wkT G X Y) (app (ext G X) (wkT G X X) (wkT G X Y) (EQ.wkF G X X Y e) (q G X)) (wkE G X Y w)
      (upT D G X s X' PX) (wkT D X' Y') PWY
      (app (ext D X') (wkT D X' X') (wkT D X' Y') (EQ.wkF D X' X' Y' e') (q D X')) (wkE D X' Y' w')
      (app-ov (ext D X') (ext G X) (wkT G X X) (wkT G X Y) (upT D G X s X' PX) (wkT D X' X') PWX (wkT D X' Y') PWY PFw
         (EQ.wkF G X X Y e) (EQ.wkF D X' X' Y' e') (EQ.wkF-ov D G X X Y s X' PX X' Y' PF e e' Pe PFw)
         (q G X) (q D X') (q-ov D G X s X' PX PWX))
      (wkE-ov D G X Y w s X' PX Y' PY w' Pw PWY)
   where {
    PWX : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (wkT G X X) (upT D G X s X' PX)) (wkT D X' X') = wkT-ov D G X X s X' PX X' PX ;
    PWY : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (wkT G X Y) (upT D G X s X' PX)) (wkT D X' Y') = wkT-ov D G X Y s X' PX Y' PY ;
    PFw : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (Fun (ext G X) (wkT G X X) (wkT G X Y)) (upT D G X s X' PX)) (Fun (ext D X') (wkT D X' X') (wkT D X' Y')) =
      Fun-ov (ext D X') (ext G X) (wkT G X X) (wkT G X Y) (upT D G X s X' PX) (wkT D X' X') PWX (wkT D X' Y') PWY ;
   } ;

  FibE-ov (D G : Ctx) (X Y : Ty G) (e : El G (Fun G X Y)) (w : El G Y) (s : Sub D G) (X' Y' : Ty D)
    (PX : Id (Ty D) (subT D G X s) X') (PY : Id (Ty D) (subT D G Y s) Y') (PF : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y'))
    (e' : El D (Fun D X' Y')) (Pe : Ov D G (Fun G X Y) s (Fun D X' Y') PF e e') (w' : El D Y') (Pw : Ov D G Y s Y' PY w w')
    : Id (Ty D) (subT D G (FibE G X Y e w) s) (FibE D X' Y' e' w') =
    Sig-ov D G X (FamE G X Y e w) s X' PX (FamE D X' Y' e' w') (FamE-ov D G X Y e w s X' Y' PX PY PF e' Pe w' Pw) ;

  ----------------------------------------------------------------------
  -- (2) step B

  module SB (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (g : El G (Fun G Y X)) (eps : El G (EQ.Htpy G X Y f g)) (w : El G Y) {
    FY : Ty G = Fun G Y Y ;
    Kh : Ctx = ext G FY ;
    Yh : Ty Kh = wkT G FY Y ;
    hv : El Kh (Fun Kh Yh Yh) = EQ.qF G Y Y ;
    wh : El Kh Yh = wkE G FY Y w ;
    CF : Ty Kh = EQ.isContr Kh (FibE Kh Yh Yh hv wh) ;

    CFat (e : El G FY) : Id (Ty G) (subT G Kh CF (sec G FY e)) (EQ.isContr G (FibE G Y Y e w)) =
      EQ.isContr-ov G Kh (FibE Kh Yh Yh hv wh) (sec G FY e) (FibE G Y Y e w)
        (FibE-ov G Kh Yh Yh hv wh (sec G FY e) Y Y (p-sec-T G FY Y e) (p-sec-T G FY Y e) (IN.FunSec G FY Y Y e)
           e (IN.qF-sec G Y Y e (IN.FunSec G FY Y Y e)) w (IN.wkE-sec G FY Y e w (p-sec-T G FY Y e))) ;

    -- the identity and f o g
    idY : El G FY = IN.idF G Y ;
    fgq : El (ext G Y) (wkT G Y Y) =
      app (ext G Y) (wkT G Y X) (wkT G Y Y) (EQ.wkF G Y X Y f) (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X g) (q G Y)) ;
    fgY : El G FY = lam G Y (wkT G Y Y) fgq ;

    -- the contractible co-based singleton is the fibre of the identity
    coAt : El G (EQ.isContr G (FibE G Y Y idY w)) =
      trE G (subT G (ext G Y) (EQ.isContr (ext G Y) (CO.CoSF G Y)) (sec G Y w)) (EQ.isContr G (FibE G Y Y idY w))
        (EQ.isContr-ov G (ext G Y) (CO.CoSF G Y) (sec G Y w) (FibE G Y Y idY w)
           (Sig-ov G (ext G Y) (wkT G Y Y) (IJ.IdT (ext (ext G Y) (wkT G Y Y)) (wkT (ext G Y) (wkT G Y Y) (wkT G Y Y)) (q (ext G Y) (wkT G Y Y)) (wkE (ext G Y) (wkT G Y Y) (wkT G Y Y) (q G Y)))
              (sec G Y w) Y (p-sec-T G Y Y w) (FamE G Y Y idY w)
              (trans (Ty (ext G Y)) (subT (ext G Y) (ext (ext G Y) (wkT G Y Y)) (IJ.IdT (ext (ext G Y) (wkT G Y Y)) (wkT (ext G Y) (wkT G Y Y) (wkT G Y Y)) (q (ext G Y) (wkT G Y Y)) (wkE (ext G Y) (wkT G Y Y) (wkT G Y Y) (q G Y))) (upT G (ext G Y) (wkT G Y Y) (sec G Y w) Y (p-sec-T G Y Y w))) (IJ.IdT (ext G Y) (wkT G Y Y) (q G Y) (wkE G Y Y w)) (FamE G Y Y idY w)
                 (Id-ov (ext G Y) (ext (ext G Y) (wkT G Y Y)) (wkT (ext G Y) (wkT G Y Y) (wkT G Y Y)) (q (ext G Y) (wkT G Y Y)) (wkE (ext G Y) (wkT G Y Y) (wkT G Y Y) (q G Y))
                    (upT G (ext G Y) (wkT G Y Y) (sec G Y w) Y (p-sec-T G Y Y w)) (wkT G Y Y)
                    (wkT-ov G (ext G Y) (wkT G Y Y) (wkT G Y Y) (sec G Y w) Y (p-sec-T G Y Y w) Y (p-sec-T G Y Y w))
                    (q G Y) (wkE G Y Y w)
                    (q-ov G (ext G Y) (wkT G Y Y) (sec G Y w) Y (p-sec-T G Y Y w)
                       (wkT-ov G (ext G Y) (wkT G Y Y) (wkT G Y Y) (sec G Y w) Y (p-sec-T G Y Y w) Y (p-sec-T G Y Y w)))
                    (wkE-ov G (ext G Y) (wkT G Y Y) (wkT G Y Y) (q G Y) (sec G Y w) Y (p-sec-T G Y Y w) Y (p-sec-T G Y Y w) w
                       (IN.q-secO G Y w (p-sec-T G Y Y w))
                       (wkT-ov G (ext G Y) (wkT G Y Y) (wkT G Y Y) (sec G Y w) Y (p-sec-T G Y Y w) Y (p-sec-T G Y Y w))))
                 (ap (El (ext G Y) (wkT G Y Y)) (Ty (ext G Y)) (\ v -> IJ.IdT (ext G Y) (wkT G Y Y) v (wkE G Y Y w))
                     (q G Y) (app (ext G Y) (wkT G Y Y) (wkT G Y Y) (EQ.wkF G Y Y Y idY) (q G Y))
                     (sym (El (ext G Y) (wkT G Y Y)) (app (ext G Y) (wkT G Y Y) (wkT G Y Y) (EQ.wkF G Y Y Y idY) (q G Y)) (q G Y)
                        (trans (El (ext G Y) (wkT G Y Y)) (app (ext G Y) (wkT G Y Y) (wkT G Y Y) (EQ.wkF G Y Y Y idY) (q G Y))
                           (app (ext G Y) (wkT G Y Y) (wkT G Y Y) (IN.idF (ext G Y) (wkT G Y Y)) (q G Y)) (q G Y)
                           (ap (El (ext G Y) (Fun (ext G Y) (wkT G Y Y) (wkT G Y Y))) (El (ext G Y) (wkT G Y Y))
                               (\ F -> app (ext G Y) (wkT G Y Y) (wkT G Y Y) F (q G Y)) (EQ.wkF G Y Y Y idY) (IN.idF (ext G Y) (wkT G Y Y)) (IN.wkF-idF G Y Y))
                           (IN.app-idF (ext G Y) (wkT G Y Y) (q G Y))))))))
        (subt G (ext G Y) (EQ.isContr (ext G Y) (CO.CoSF G Y)) (CO.coSC G Y) (sec G Y w)) ;

    -- the path idY = f o g, by NF
    bid : Id (El (ext G Y) (wkT G Y Y)) (bod G Y (wkT G Y Y) idY) (q G Y) = (PS.Pi-iso G Y (wkT G Y Y)).fun-inv (q G Y) ;
    bfg : Id (El (ext G Y) (wkT G Y Y)) (bod G Y (wkT G Y Y) fgY) fgq = (PS.Pi-iso G Y (wkT G Y Y)).fun-inv fgq ;

    hh : El G (PS.Pi G Y (IJ.IdT (ext G Y) (wkT G Y Y) (bod G Y (wkT G Y Y) idY) (bod G Y (wkT G Y Y) fgY))) =
      lam G Y (IJ.IdT (ext G Y) (wkT G Y Y) (bod G Y (wkT G Y Y) idY) (bod G Y (wkT G Y Y) fgY))
        (trE (ext G Y) (IJ.IdT (ext G Y) (wkT G Y Y) (q G Y) fgq) (IJ.IdT (ext G Y) (wkT G Y Y) (bod G Y (wkT G Y Y) idY) (bod G Y (wkT G Y Y) fgY))
           (DJ.idCong (ext G Y) (wkT G Y Y) (wkT G Y Y) (refl (wkT G Y Y)) (q G Y) fgq (bod G Y (wkT G Y Y) idY) (bod G Y (wkT G Y Y) fgY)
              (sym (El (ext G Y) (wkT G Y Y)) (bod G Y (wkT G Y Y) idY) (q G Y) bid)
              (sym (El (ext G Y) (wkT G Y Y)) (bod G Y (wkT G Y Y) fgY) fgq bfg))
           (PT.symM (ext G Y) (wkT G Y Y) fgq (q G Y) (bod G Y (IJ.IdT (ext G Y) (wkT G Y Y) fgq (q G Y)) eps))) ;

    pth : El G (IJ.IdT G FY idY fgY) = NF G Y (wkT G Y Y) idY fgY hh ;

    kM : El G (EQ.isContr G (FibE G Y Y fgY w)) =
      trE G (subT G Kh CF (sec G FY fgY)) (EQ.isContr G (FibE G Y Y fgY w)) (CFat fgY)
        (TR.trP G FY CF idY fgY pth
           (trE G (EQ.isContr G (FibE G Y Y idY w)) (subT G Kh CF (sec G FY idY)) (sym (Ty G) (subT G Kh CF (sec G FY idY)) (EQ.isContr G (FibE G Y Y idY w)) (CFat idY))
              coAt)) ;
  } ;
} ;
