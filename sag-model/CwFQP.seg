-- CwFQP.seg (M1 step 3, S4 toolkit): the type Q(X , Y) of the retract
-- T <| Q, its stability, packing and unpacking, in a CwF with Pi, Sigma,
-- Swan Id and naive funext NF.
--
-- Informal text.  For X Y over G (X = Dec a, Y = Dec b):
--   Kr r     = Pi (x : X) isContr (Fib_r x)            (r : Y -> X)
--   SecT u   = Sigma (v : Y -> X) (u v ~ id)            (u : X -> Y)
--   L r      = Sigma (f : X -> Y) Sigma (hr : r f ~ id) SecT f
--   Q(X , Y) = Sigma (r : Y -> X) Sigma (k : Kr r) L r
-- Each is stable under substitution (the *-ov lemmas, one per layer, the
-- family of each Sigma along the lift).  mkQ packs six components, UQ
-- unpacks, UQ (mkQ ...) gives the components back (betaQ); unpacking is
-- stable (QN).

open Base ;

module QP (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PJ = CwFPrj.Prj[l, C, PS, SS, IJ] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;

  ----------------------------------------------------------------------
  -- (1) sections: SecT u = Sigma v (u v ~ id)

  SecT (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) : Ty G = SS.Sig G (Fun G Y X) (EQ.SecH G X Y u) ;

  SecH-ov (D G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PU : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y')) (u' : El D (Fun D X' Y')) (Pu : Ov D G (Fun G X Y) s (Fun D X' Y') PU u u')
    : Id (Ty (ext D (Fun D Y' X'))) (subT (ext D (Fun D Y' X')) (ext G (Fun G Y X)) (EQ.SecH G X Y u) (upT D G (Fun G Y X) s (Fun D Y' X') (Fun-ov D G Y X s Y' PY X' PX)))
         (EQ.SecH D X' Y' u') =
    EQ.Htpy-ov K1' K1 X1 Y1 (EQ.wkF G (Fun G Y X) X Y u) (EQ.qF G Y X) s1 X1' PX1 Y1' PY1 PF1 (EQ.wkF D (Fun D Y' X') X' Y' u')
      (EQ.wkF-ov D G (Fun G Y X) X Y s (Fun D Y' X') PG X' Y' PU u u' Pu PF1)
      PG1 (EQ.qF D Y' X') (EQ.qF-ov D G Y X s Y' X' PG PG1)
   where {
    K1 : Ctx = ext G (Fun G Y X) ;
    K1' : Ctx = ext D (Fun D Y' X') ;
    X1 : Ty K1 = wkT G (Fun G Y X) X ;
    Y1 : Ty K1 = wkT G (Fun G Y X) Y ;
    X1' : Ty K1' = wkT D (Fun D Y' X') X' ;
    Y1' : Ty K1' = wkT D (Fun D Y' X') Y' ;
    PG : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X') = Fun-ov D G Y X s Y' PY X' PX ;
    s1 : Sub K1' K1 = upT D G (Fun G Y X) s (Fun D Y' X') PG ;
    PX1 : Id (Ty K1') (subT K1' K1 X1 s1) X1' = wkT-ov D G (Fun G Y X) X s (Fun D Y' X') PG X' PX ;
    PY1 : Id (Ty K1') (subT K1' K1 Y1 s1) Y1' = wkT-ov D G (Fun G Y X) Y s (Fun D Y' X') PG Y' PY ;
    PF1 : Id (Ty K1') (subT K1' K1 (Fun K1 X1 Y1) s1) (Fun K1' X1' Y1') = Fun-ov K1' K1 X1 Y1 s1 X1' PX1 Y1' PY1 ;
    PG1 : Id (Ty K1') (subT K1' K1 (Fun K1 Y1 X1) s1) (Fun K1' Y1' X1') = Fun-ov K1' K1 Y1 X1 s1 Y1' PY1 X1' PX1 ;
   } ;

  SecT-ov (D G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PU : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y')) (u' : El D (Fun D X' Y')) (Pu : Ov D G (Fun G X Y) s (Fun D X' Y') PU u u')
    : Id (Ty D) (subT D G (SecT G X Y u) s) (SecT D X' Y' u') =
    Sig-ov D G (Fun G Y X) (EQ.SecH G X Y u) s (Fun D Y' X') (Fun-ov D G Y X s Y' PY X' PX) (EQ.SecH D X' Y' u')
      (SecH-ov D G X Y u s X' PX Y' PY PU u' Pu) ;

  -- the family of SecT u at v
  PSecH (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (v : El G (Fun G Y X))
    : Id (Ty G) (subT G (ext G (Fun G Y X)) (EQ.SecH G X Y u) (sec G (Fun G Y X) v)) (EQ.Htpy G X Y u v) =
    EQ.Htpy-ov G K1 X1 Y1 u1 v1 (sec G FYX v) X PX1 Y PY1 PF1 u (IN.wkF-sec G FYX X Y v u PF1) PG1 v (IN.qF-sec G Y X v PG1)
   where {
    FYX : Ty G = Fun G Y X ;
    K1 : Ctx = ext G FYX ;
    X1 : Ty K1 = wkT G FYX X ;
    Y1 : Ty K1 = wkT G FYX Y ;
    u1 : El K1 (Fun K1 X1 Y1) = EQ.wkF G FYX X Y u ;
    v1 : El K1 (Fun K1 Y1 X1) = EQ.qF G Y X ;
    PX1 : Id (Ty G) (subT G K1 X1 (sec G FYX v)) X = p-sec-T G FYX X v ;
    PY1 : Id (Ty G) (subT G K1 Y1 (sec G FYX v)) Y = p-sec-T G FYX Y v ;
    PF1 : Id (Ty G) (subT G K1 (Fun K1 X1 Y1) (sec G FYX v)) (Fun G X Y) = Fun-ov G K1 X1 Y1 (sec G FYX v) X PX1 Y PY1 ;
    PG1 : Id (Ty G) (subT G K1 (Fun K1 Y1 X1) (sec G FYX v)) (Fun G Y X) = Fun-ov G K1 Y1 X1 (sec G FYX v) Y PY1 X PX1 ;
   } ;

  mkSec (G : Ctx) (X Y : Ty G) (u : El G (Fun G X Y)) (v : El G (Fun G Y X)) (h : El G (EQ.Htpy G X Y u v)) : El G (SecT G X Y u) =
    IN.pr G (Fun G Y X) (EQ.SecH G X Y u) v
      (trE G (EQ.Htpy G X Y u v) (subT G (ext G (Fun G Y X)) (EQ.SecH G X Y u) (sec G (Fun G Y X) v))
         (sym (Ty G) (subT G (ext G (Fun G Y X)) (EQ.SecH G X Y u) (sec G (Fun G Y X) v)) (EQ.Htpy G X Y u v) (PSecH G X Y u v)) h) ;

  ----------------------------------------------------------------------
  -- (2) contractible fibres: Kr r = Pi x isContr (Fib_r x)

  FVr (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) : Ty (ext G X) =
    QB.FibE (ext G X) (wkT G X Y) (wkT G X X) (EQ.wkF G X Y X r) (q G X) ;

  Kr (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) : Ty G = PS.Pi G X (EQ.isContr (ext G X) (FVr G X Y r)) ;

  FVr-ov (D G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PR : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (r' : El D (Fun D Y' X')) (Pr : Ov D G (Fun G Y X) s (Fun D Y' X') PR r r')
    : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (FVr G X Y r) (upT D G X s X' PX)) (FVr D X' Y' r') =
    QB.FibE-ov (ext D X') (ext G X) (wkT G X Y) (wkT G X X) (EQ.wkF G X Y X r) (q G X) s1 (wkT D X' Y') (wkT D X' X') PYX PXX PFw
      (EQ.wkF D X' Y' X' r') (EQ.wkF-ov D G X Y X s X' PX Y' X' PR r r' Pr PFw) (q D X') (q-ov D G X s X' PX PXX)
   where {
    s1 : Sub (ext D X') (ext G X) = upT D G X s X' PX ;
    PYX : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (wkT G X Y) s1) (wkT D X' Y') = wkT-ov D G X Y s X' PX Y' PY ;
    PXX : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (wkT G X X) s1) (wkT D X' X') = wkT-ov D G X X s X' PX X' PX ;
    PFw : Id (Ty (ext D X')) (subT (ext D X') (ext G X) (Fun (ext G X) (wkT G X Y) (wkT G X X)) s1) (Fun (ext D X') (wkT D X' Y') (wkT D X' X')) =
      Fun-ov (ext D X') (ext G X) (wkT G X Y) (wkT G X X) s1 (wkT D X' Y') PYX (wkT D X' X') PXX ;
   } ;

  Kr-ov (D G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PR : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (r' : El D (Fun D Y' X')) (Pr : Ov D G (Fun G Y X) s (Fun D Y' X') PR r r')
    : Id (Ty D) (subT D G (Kr G X Y r) s) (Kr D X' Y' r') =
    Pi-ov D G X (EQ.isContr (ext G X) (FVr G X Y r)) s X' PX (EQ.isContr (ext D X') (FVr D X' Y' r'))
      (EQ.isContr-ov (ext D X') (ext G X) (FVr G X Y r) (upT D G X s X' PX) (FVr D X' Y' r') (FVr-ov D G X Y r s X' PX Y' PY PR r' Pr)) ;

  ----------------------------------------------------------------------
  -- (3) L r = Sigma f Sigma (hr : r f ~ id) SecT f

  -- the inner family over G.(X -> Y).(r f ~ id)
  module LV (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) {
    FXY : Ty G = Fun G X Y ;
    KF : Ctx = ext G FXY ;
    X1 : Ty KF = wkT G FXY X ;
    Y1 : Ty KF = wkT G FXY Y ;
    H : Ty KF = EQ.SecH G Y X r ;
    E2 : Ctx = ext KF H ;
    X2 : Ty E2 = wkT KF H X1 ;
    Y2 : Ty E2 = wkT KF H Y1 ;
    f2 : El E2 (Fun E2 X2 Y2) = EQ.wkF KF H X1 Y1 (EQ.qF G X Y) ;
    Cc : Ty E2 = SecT E2 X2 Y2 f2 ;
    LF : Ty KF = SS.Sig KF H Cc ;
  } ;

  L (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) : Ty G = SS.Sig G (Fun G X Y) (LV[G, X, Y, r].LF) ;

  module LFo (D G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PR : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (r' : El D (Fun D Y' X')) (Pr : Ov D G (Fun G Y X) s (Fun D Y' X') PR r r') {
    module LVa = LV[G, X, Y, r] ;
    module LVb = LV[D, X', Y', r'] ;
    PF : Id (Ty D) (subT D G (Fun G X Y) s) (Fun D X' Y') = Fun-ov D G X Y s X' PX Y' PY ;
    s1 : Sub LVb.KF LVa.KF = upT D G (Fun G X Y) s (Fun D X' Y') PF ;
    PH : Id (Ty LVb.KF) (subT LVb.KF LVa.KF LVa.H s1) LVb.H = SecH-ov D G Y X r s Y' PY X' PX PR r' Pr ;
    s2 : Sub LVb.E2 LVa.E2 = upT LVb.KF LVa.KF LVa.H s1 LVb.H PH ;
    PX1 : Id (Ty LVb.KF) (subT LVb.KF LVa.KF LVa.X1 s1) LVb.X1 = wkT-ov D G (Fun G X Y) X s (Fun D X' Y') PF X' PX ;
    PY1 : Id (Ty LVb.KF) (subT LVb.KF LVa.KF LVa.Y1 s1) LVb.Y1 = wkT-ov D G (Fun G X Y) Y s (Fun D X' Y') PF Y' PY ;
    PF1 : Id (Ty LVb.KF) (subT LVb.KF LVa.KF (Fun LVa.KF LVa.X1 LVa.Y1) s1) (Fun LVb.KF LVb.X1 LVb.Y1) = Fun-ov LVb.KF LVa.KF LVa.X1 LVa.Y1 s1 LVb.X1 PX1 LVb.Y1 PY1 ;
    PX2 : Id (Ty LVb.E2) (subT LVb.E2 LVa.E2 LVa.X2 s2) LVb.X2 = wkT-ov LVb.KF LVa.KF LVa.H LVa.X1 s1 LVb.H PH LVb.X1 PX1 ;
    PY2 : Id (Ty LVb.E2) (subT LVb.E2 LVa.E2 LVa.Y2 s2) LVb.Y2 = wkT-ov LVb.KF LVa.KF LVa.H LVa.Y1 s1 LVb.H PH LVb.Y1 PY1 ;
    PF2 : Id (Ty LVb.E2) (subT LVb.E2 LVa.E2 (Fun LVa.E2 LVa.X2 LVa.Y2) s2) (Fun LVb.E2 LVb.X2 LVb.Y2) = Fun-ov LVb.E2 LVa.E2 LVa.X2 LVa.Y2 s2 LVb.X2 PX2 LVb.Y2 PY2 ;
    res : Id (Ty (ext D (Fun D X' Y'))) (subT (ext D (Fun D X' Y')) (ext G (Fun G X Y)) (LV[G, X, Y, r].LF) (upT D G (Fun G X Y) s (Fun D X' Y') (Fun-ov D G X Y s X' PX Y' PY)))
         (LV[D, X', Y', r'].LF) =
    Sig-ov LVb.KF LVa.KF LVa.H LVa.Cc s1 LVb.H PH LVb.Cc
      (SecT-ov LVb.E2 LVa.E2 LVa.X2 LVa.Y2 LVa.f2 s2 LVb.X2 PX2 LVb.Y2 PY2 PF2 LVb.f2
         (EQ.wkF-ov LVb.KF LVa.KF LVa.H LVa.X1 LVa.Y1 s1 LVb.H PH LVb.X1 LVb.Y1 PF1 (EQ.qF G X Y) (EQ.qF D X' Y') (EQ.qF-ov D G X Y s X' Y' PF PF1) PF2)) ;
  } ;

  LF-ov (D G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PR : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (r' : El D (Fun D Y' X')) (Pr : Ov D G (Fun G Y X) s (Fun D Y' X') PR r r')
    : Id (Ty (ext D (Fun D X' Y'))) (subT (ext D (Fun D X' Y')) (ext G (Fun G X Y)) (LV[G, X, Y, r].LF) (upT D G (Fun G X Y) s (Fun D X' Y') (Fun-ov D G X Y s X' PX Y' PY)))
         (LV[D, X', Y', r'].LF) =
    LFo[D, G, X, Y, r, s, X', PX, Y', PY, PR, r', Pr].res ;

  L-ov (D G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    (PR : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X')) (r' : El D (Fun D Y' X')) (Pr : Ov D G (Fun G Y X) s (Fun D Y' X') PR r r')
    : Id (Ty D) (subT D G (L G X Y r) s) (L D X' Y' r') =
    Sig-ov D G (Fun G X Y) (LV[G, X, Y, r].LF) s (Fun D X' Y') (Fun-ov D G X Y s X' PX Y' PY) (LV[D, X', Y', r'].LF)
      (LF-ov D G X Y r s X' PX Y' PY PR r' Pr) ;

  -- the family of L r at f: Sigma (r f ~ id) SecT f
  LFf (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (f : El G (Fun G X Y)) : Ty G =
    SS.Sig G (EQ.Htpy G Y X r f)
      (SecT (ext G (EQ.Htpy G Y X r f)) (wkT G (EQ.Htpy G Y X r f) X) (wkT G (EQ.Htpy G Y X r f) Y) (EQ.wkF G (EQ.Htpy G Y X r f) X Y f)) ;

  module PLFm (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (f : El G (Fun G X Y)) {
    module LVp = LV[G, X, Y, r] ;
    Hf : Ty G = EQ.Htpy G Y X r f ;
    Cf : Ty (ext G Hf) = SecT (ext G Hf) (wkT G Hf X) (wkT G Hf Y) (EQ.wkF G Hf X Y f) ;
    PX1 : Id (Ty G) (subT G LVp.KF LVp.X1 (sec G LVp.FXY f)) X = p-sec-T G LVp.FXY X f ;
    PY1 : Id (Ty G) (subT G LVp.KF LVp.Y1 (sec G LVp.FXY f)) Y = p-sec-T G LVp.FXY Y f ;
    PF1 : Id (Ty G) (subT G LVp.KF (Fun LVp.KF LVp.X1 LVp.Y1) (sec G LVp.FXY f)) (Fun G X Y) = Fun-ov G LVp.KF LVp.X1 LVp.Y1 (sec G LVp.FXY f) X PX1 Y PY1 ;
    PH : Id (Ty G) (subT G LVp.KF LVp.H (sec G LVp.FXY f)) Hf = PSecH G Y X r f ;
    s2 : Sub (ext G Hf) LVp.E2 = upT G LVp.KF LVp.H (sec G LVp.FXY f) Hf PH ;
    PX2 : Id (Ty (ext G Hf)) (subT (ext G Hf) LVp.E2 LVp.X2 s2) (wkT G Hf X) = wkT-ov G LVp.KF LVp.H LVp.X1 (sec G LVp.FXY f) Hf PH X PX1 ;
    PY2 : Id (Ty (ext G Hf)) (subT (ext G Hf) LVp.E2 LVp.Y2 s2) (wkT G Hf Y) = wkT-ov G LVp.KF LVp.H LVp.Y1 (sec G LVp.FXY f) Hf PH Y PY1 ;
    PF2 : Id (Ty (ext G Hf)) (subT (ext G Hf) LVp.E2 (Fun LVp.E2 LVp.X2 LVp.Y2) s2) (Fun (ext G Hf) (wkT G Hf X) (wkT G Hf Y)) =
      Fun-ov (ext G Hf) LVp.E2 LVp.X2 LVp.Y2 s2 (wkT G Hf X) PX2 (wkT G Hf Y) PY2 ;
    res : Id (Ty G) (subT G (ext G (Fun G X Y)) (LV[G, X, Y, r].LF) (sec G (Fun G X Y) f)) (LFf G X Y r f) =
    Sig-ov G LVp.KF LVp.H LVp.Cc (sec G LVp.FXY f) Hf PH Cf
      (SecT-ov (ext G Hf) LVp.E2 LVp.X2 LVp.Y2 LVp.f2 s2 (wkT G Hf X) PX2 (wkT G Hf Y) PY2 PF2 (EQ.wkF G Hf X Y f)
         (EQ.wkF-ov G LVp.KF LVp.H LVp.X1 LVp.Y1 (sec G LVp.FXY f) Hf PH X Y PF1 (EQ.qF G X Y) f (IN.qF-sec G X Y f PF1) PF2)) ;
  } ;

  PLF (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (f : El G (Fun G X Y))
    : Id (Ty G) (subT G (ext G (Fun G X Y)) (LV[G, X, Y, r].LF) (sec G (Fun G X Y) f)) (LFf G X Y r f) =
    PLFm[G, X, Y, r, f].res ;

  -- the family of LFf at hr: SecT f
  PCc (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (f : El G (Fun G X Y)) (hr : El G (EQ.Htpy G Y X r f))
    : Id (Ty G) (subT G (ext G (EQ.Htpy G Y X r f)) (SecT (ext G (EQ.Htpy G Y X r f)) (wkT G (EQ.Htpy G Y X r f) X) (wkT G (EQ.Htpy G Y X r f) Y)
                                                          (EQ.wkF G (EQ.Htpy G Y X r f) X Y f))
                          (sec G (EQ.Htpy G Y X r f) hr))
         (SecT G X Y f) =
    SecT-ov G (ext G Hf) (wkT G Hf X) (wkT G Hf Y) (EQ.wkF G Hf X Y f) (sec G Hf hr) X (p-sec-T G Hf X hr) Y (p-sec-T G Hf Y hr)
      (IN.FunSec G Hf X Y hr) f (IN.wkF-sec G Hf X Y hr f (IN.FunSec G Hf X Y hr))
   where { Hf : Ty G = EQ.Htpy G Y X r f ; } ;

  mkL (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (f : El G (Fun G X Y)) (hr : El G (EQ.Htpy G Y X r f)) (c : El G (SecT G X Y f))
    : El G (L G X Y r) =
    IN.pr G (Fun G X Y) (LV[G, X, Y, r].LF) f
      (trE G (LFf G X Y r f) (subT G (ext G (Fun G X Y)) (LV[G, X, Y, r].LF) (sec G (Fun G X Y) f))
         (sym (Ty G) (subT G (ext G (Fun G X Y)) (LV[G, X, Y, r].LF) (sec G (Fun G X Y) f)) (LFf G X Y r f) (PLF G X Y r f))
         (IN.pr G Hf Cf hr
            (trE G (SecT G X Y f) (subT G (ext G Hf) Cf (sec G Hf hr)) (sym (Ty G) (subT G (ext G Hf) Cf (sec G Hf hr)) (SecT G X Y f) (PCc G X Y r f hr)) c)))
   where {
    Hf : Ty G = EQ.Htpy G Y X r f ;
    Cf : Ty (ext G Hf) = SecT (ext G Hf) (wkT G Hf X) (wkT G Hf Y) (EQ.wkF G Hf X Y f) ;
   } ;

  ----------------------------------------------------------------------
  -- (4) Q(X , Y) = Sigma r Sigma (k : Kr r) L r

  module QV (G : Ctx) (X Y : Ty G) {
    FYX : Ty G = Fun G Y X ;
    G1 : Ctx = ext G FYX ;
    X1 : Ty G1 = wkT G FYX X ;
    Y1 : Ty G1 = wkT G FYX Y ;
    r1 : El G1 (Fun G1 Y1 X1) = EQ.qF G Y X ;
    K1 : Ty G1 = Kr G1 X1 Y1 r1 ;
    G2 : Ctx = ext G1 K1 ;
    X2 : Ty G2 = wkT G1 K1 X1 ;
    Y2 : Ty G2 = wkT G1 K1 Y1 ;
    r2 : El G2 (Fun G2 Y2 X2) = EQ.wkF G1 K1 Y1 X1 r1 ;
    LL : Ty G2 = L G2 X2 Y2 r2 ;
    QF1 : Ty G1 = SS.Sig G1 K1 LL ;
  } ;

  QF (G : Ctx) (X Y : Ty G) : Ty G = SS.Sig G (Fun G Y X) (QV[G, X, Y].QF1) ;

  module QFo (D G : Ctx) (X Y : Ty G) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y') {
    module Qa = QV[G, X, Y] ;
    module Qb = QV[D, X', Y'] ;
    PG : Id (Ty D) (subT D G (Fun G Y X) s) (Fun D Y' X') = Fun-ov D G Y X s Y' PY X' PX ;
    s1 : Sub Qb.G1 Qa.G1 = upT D G (Fun G Y X) s (Fun D Y' X') PG ;
    PX1 : Id (Ty Qb.G1) (subT Qb.G1 Qa.G1 Qa.X1 s1) Qb.X1 = wkT-ov D G (Fun G Y X) X s (Fun D Y' X') PG X' PX ;
    PY1 : Id (Ty Qb.G1) (subT Qb.G1 Qa.G1 Qa.Y1 s1) Qb.Y1 = wkT-ov D G (Fun G Y X) Y s (Fun D Y' X') PG Y' PY ;
    PG1 : Id (Ty Qb.G1) (subT Qb.G1 Qa.G1 (Fun Qa.G1 Qa.Y1 Qa.X1) s1) (Fun Qb.G1 Qb.Y1 Qb.X1) = Fun-ov Qb.G1 Qa.G1 Qa.Y1 Qa.X1 s1 Qb.Y1 PY1 Qb.X1 PX1 ;
    Pr1 : Ov Qb.G1 Qa.G1 (Fun Qa.G1 Qa.Y1 Qa.X1) s1 (Fun Qb.G1 Qb.Y1 Qb.X1) PG1 Qa.r1 Qb.r1 = EQ.qF-ov D G Y X s Y' X' PG PG1 ;
    PK : Id (Ty Qb.G1) (subT Qb.G1 Qa.G1 Qa.K1 s1) Qb.K1 = Kr-ov Qb.G1 Qa.G1 Qa.X1 Qa.Y1 Qa.r1 s1 Qb.X1 PX1 Qb.Y1 PY1 PG1 Qb.r1 Pr1 ;
    s2 : Sub Qb.G2 Qa.G2 = upT Qb.G1 Qa.G1 Qa.K1 s1 Qb.K1 PK ;
    PX2 : Id (Ty Qb.G2) (subT Qb.G2 Qa.G2 Qa.X2 s2) Qb.X2 = wkT-ov Qb.G1 Qa.G1 Qa.K1 Qa.X1 s1 Qb.K1 PK Qb.X1 PX1 ;
    PY2 : Id (Ty Qb.G2) (subT Qb.G2 Qa.G2 Qa.Y2 s2) Qb.Y2 = wkT-ov Qb.G1 Qa.G1 Qa.K1 Qa.Y1 s1 Qb.K1 PK Qb.Y1 PY1 ;
    PG2 : Id (Ty Qb.G2) (subT Qb.G2 Qa.G2 (Fun Qa.G2 Qa.Y2 Qa.X2) s2) (Fun Qb.G2 Qb.Y2 Qb.X2) = Fun-ov Qb.G2 Qa.G2 Qa.Y2 Qa.X2 s2 Qb.Y2 PY2 Qb.X2 PX2 ;
    Pr2 : Ov Qb.G2 Qa.G2 (Fun Qa.G2 Qa.Y2 Qa.X2) s2 (Fun Qb.G2 Qb.Y2 Qb.X2) PG2 Qa.r2 Qb.r2 =
      EQ.wkF-ov Qb.G1 Qa.G1 Qa.K1 Qa.Y1 Qa.X1 s1 Qb.K1 PK Qb.Y1 Qb.X1 PG1 Qa.r1 Qb.r1 Pr1 PG2 ;
    PL : Id (Ty Qb.G2) (subT Qb.G2 Qa.G2 Qa.LL s2) Qb.LL = L-ov Qb.G2 Qa.G2 Qa.X2 Qa.Y2 Qa.r2 s2 Qb.X2 PX2 Qb.Y2 PY2 PG2 Qb.r2 Pr2 ;
    res : Id (Ty Qb.G1) (subT Qb.G1 Qa.G1 Qa.QF1 s1) Qb.QF1 = Sig-ov Qb.G1 Qa.G1 Qa.K1 Qa.LL s1 Qb.K1 PK Qb.LL PL ;
  } ;

  QF1-ov (D G : Ctx) (X Y : Ty G) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    : Id (Ty (ext D (Fun D Y' X'))) (subT (ext D (Fun D Y' X')) (ext G (Fun G Y X)) (QV[G, X, Y].QF1) (upT D G (Fun G Y X) s (Fun D Y' X') (Fun-ov D G Y X s Y' PY X' PX)))
         (QV[D, X', Y'].QF1) =
    QFo[D, G, X, Y, s, X', PX, Y', PY].res ;

  QF-ov (D G : Ctx) (X Y : Ty G) (s : Sub D G)
    (X' : Ty D) (PX : Id (Ty D) (subT D G X s) X') (Y' : Ty D) (PY : Id (Ty D) (subT D G Y s) Y')
    : Id (Ty D) (subT D G (QF G X Y) s) (QF D X' Y') =
    Sig-ov D G (Fun G Y X) (QV[G, X, Y].QF1) s (Fun D Y' X') (Fun-ov D G Y X s Y' PY X' PX) (QV[D, X', Y'].QF1) (QF1-ov D G X Y s X' PX Y' PY) ;

  -- the family of L r weakened over G.Kr r
  LW (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) : Ty (ext G (Kr G X Y r)) =
    L (ext G (Kr G X Y r)) (wkT G (Kr G X Y r) X) (wkT G (Kr G X Y r) Y) (EQ.wkF G (Kr G X Y r) Y X r) ;

  -- the family of Q at r
  module PQm (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) {
    module Qp = QV[G, X, Y] ;
    Kg : Ty G = Kr G X Y r ;
    PX1 : Id (Ty G) (subT G Qp.G1 Qp.X1 (sec G Qp.FYX r)) X = p-sec-T G Qp.FYX X r ;
    PY1 : Id (Ty G) (subT G Qp.G1 Qp.Y1 (sec G Qp.FYX r)) Y = p-sec-T G Qp.FYX Y r ;
    PG1 : Id (Ty G) (subT G Qp.G1 (Fun Qp.G1 Qp.Y1 Qp.X1) (sec G Qp.FYX r)) (Fun G Y X) = Fun-ov G Qp.G1 Qp.Y1 Qp.X1 (sec G Qp.FYX r) Y PY1 X PX1 ;
    Pr1 : Ov G Qp.G1 (Fun Qp.G1 Qp.Y1 Qp.X1) (sec G Qp.FYX r) (Fun G Y X) PG1 Qp.r1 r = IN.qF-sec G Y X r PG1 ;
    PK : Id (Ty G) (subT G Qp.G1 Qp.K1 (sec G Qp.FYX r)) Kg = Kr-ov G Qp.G1 Qp.X1 Qp.Y1 Qp.r1 (sec G Qp.FYX r) X PX1 Y PY1 PG1 r Pr1 ;
    s2 : Sub (ext G Kg) Qp.G2 = upT G Qp.G1 Qp.K1 (sec G Qp.FYX r) Kg PK ;
    PX2 : Id (Ty (ext G Kg)) (subT (ext G Kg) Qp.G2 Qp.X2 s2) (wkT G Kg X) = wkT-ov G Qp.G1 Qp.K1 Qp.X1 (sec G Qp.FYX r) Kg PK X PX1 ;
    PY2 : Id (Ty (ext G Kg)) (subT (ext G Kg) Qp.G2 Qp.Y2 s2) (wkT G Kg Y) = wkT-ov G Qp.G1 Qp.K1 Qp.Y1 (sec G Qp.FYX r) Kg PK Y PY1 ;
    PG2 : Id (Ty (ext G Kg)) (subT (ext G Kg) Qp.G2 (Fun Qp.G2 Qp.Y2 Qp.X2) s2) (Fun (ext G Kg) (wkT G Kg Y) (wkT G Kg X)) =
      Fun-ov (ext G Kg) Qp.G2 Qp.Y2 Qp.X2 s2 (wkT G Kg Y) PY2 (wkT G Kg X) PX2 ;
    Pr2 : Ov (ext G Kg) Qp.G2 (Fun Qp.G2 Qp.Y2 Qp.X2) s2 (Fun (ext G Kg) (wkT G Kg Y) (wkT G Kg X)) PG2 Qp.r2 (EQ.wkF G Kg Y X r) =
      EQ.wkF-ov G Qp.G1 Qp.K1 Qp.Y1 Qp.X1 (sec G Qp.FYX r) Kg PK Y X PG1 Qp.r1 r Pr1 PG2 ;
    PL : Id (Ty (ext G Kg)) (subT (ext G Kg) Qp.G2 Qp.LL s2) (LW G X Y r) =
      L-ov (ext G Kg) Qp.G2 Qp.X2 Qp.Y2 Qp.r2 s2 (wkT G Kg X) PX2 (wkT G Kg Y) PY2 PG2 (EQ.wkF G Kg Y X r) Pr2 ;
    res : Id (Ty G) (subT G Qp.G1 Qp.QF1 (sec G Qp.FYX r)) (SS.Sig G Kg (LW G X Y r)) = Sig-ov G Qp.G1 Qp.K1 Qp.LL (sec G Qp.FYX r) Kg PK (LW G X Y r) PL ;
  } ;

  PQ1 (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X))
    : Id (Ty G) (subT G (ext G (Fun G Y X)) (QV[G, X, Y].QF1) (sec G (Fun G Y X) r)) (SS.Sig G (Kr G X Y r) (LW G X Y r)) =
    PQm[G, X, Y, r].res ;

  -- the family of Sigma k L at k
  PLW (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (k : El G (Kr G X Y r))
    : Id (Ty G) (subT G (ext G (Kr G X Y r)) (LW G X Y r) (sec G (Kr G X Y r) k)) (L G X Y r) =
    L-ov G (ext G Kg) (wkT G Kg X) (wkT G Kg Y) (EQ.wkF G Kg Y X r) (sec G Kg k) X (p-sec-T G Kg X k) Y (p-sec-T G Kg Y k)
      (IN.FunSec G Kg Y X k) r (IN.wkF-sec G Kg Y X k r (IN.FunSec G Kg Y X k))
   where { Kg : Ty G = Kr G X Y r ; } ;

  mkQ (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) (k : El G (Kr G X Y r)) (lv : El G (L G X Y r)) : El G (QF G X Y) =
    IN.pr G (Fun G Y X) (QV[G, X, Y].QF1) r
      (trE G (SS.Sig G (Kr G X Y r) (LW G X Y r)) (subT G (ext G (Fun G Y X)) (QV[G, X, Y].QF1) (sec G (Fun G Y X) r))
         (sym (Ty G) (subT G (ext G (Fun G Y X)) (QV[G, X, Y].QF1) (sec G (Fun G Y X) r)) (SS.Sig G (Kr G X Y r) (LW G X Y r)) (PQ1 G X Y r))
         (IN.pr G (Kr G X Y r) (LW G X Y r) k
            (trE G (L G X Y r) (subT G (ext G (Kr G X Y r)) (LW G X Y r) (sec G (Kr G X Y r) k))
               (sym (Ty G) (subT G (ext G (Kr G X Y r)) (LW G X Y r) (sec G (Kr G X Y r) k)) (L G X Y r) (PLW G X Y r k)) lv))) ;

  ----------------------------------------------------------------------
  -- (5) unpacking

  module UQ (D : Ctx) (X Y : Ty D) (w : El D (QF D X Y)) {
    r : El D (Fun D Y X) = IN.fst D (Fun D Y X) (QV[D, X, Y].QF1) w ;
    q1 : El D (SS.Sig D (Kr D X Y r) (LW D X Y r)) =
      trE D (subT D (ext D (Fun D Y X)) (QV[D, X, Y].QF1) (sec D (Fun D Y X) r)) (SS.Sig D (Kr D X Y r) (LW D X Y r)) (PQ1 D X Y r)
        (IN.snd D (Fun D Y X) (QV[D, X, Y].QF1) w) ;
    k : El D (Kr D X Y r) = IN.fst D (Kr D X Y r) (LW D X Y r) q1 ;
    lv : El D (L D X Y r) =
      trE D (subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) k)) (L D X Y r) (PLW D X Y r k) (IN.snd D (Kr D X Y r) (LW D X Y r) q1) ;
    f : El D (Fun D X Y) = IN.fst D (Fun D X Y) (LV[D, X, Y, r].LF) lv ;
    l1 : El D (LFf D X Y r f) =
      trE D (subT D (ext D (Fun D X Y)) (LV[D, X, Y, r].LF) (sec D (Fun D X Y) f)) (LFf D X Y r f) (PLF D X Y r f) (IN.snd D (Fun D X Y) (LV[D, X, Y, r].LF) lv) ;
    hr : El D (EQ.Htpy D Y X r f) =
      IN.fst D (EQ.Htpy D Y X r f) (SecT (ext D (EQ.Htpy D Y X r f)) (wkT D (EQ.Htpy D Y X r f) X) (wkT D (EQ.Htpy D Y X r f) Y) (EQ.wkF D (EQ.Htpy D Y X r f) X Y f)) l1 ;
    c : El D (SecT D X Y f) =
      trE D (subT D (ext D (EQ.Htpy D Y X r f)) (SecT (ext D (EQ.Htpy D Y X r f)) (wkT D (EQ.Htpy D Y X r f) X) (wkT D (EQ.Htpy D Y X r f) Y) (EQ.wkF D (EQ.Htpy D Y X r f) X Y f))
                (sec D (EQ.Htpy D Y X r f) hr))
        (SecT D X Y f) (PCc D X Y r f hr)
        (IN.snd D (EQ.Htpy D Y X r f) (SecT (ext D (EQ.Htpy D Y X r f)) (wkT D (EQ.Htpy D Y X r f) X) (wkT D (EQ.Htpy D Y X r f) Y) (EQ.wkF D (EQ.Htpy D Y X r f) X Y f)) l1) ;
    s : El D (Fun D Y X) = IN.fst D (Fun D Y X) (EQ.SecH D X Y f) c ;
    hs : El D (EQ.Htpy D X Y f s) =
      trE D (subT D (ext D (Fun D Y X)) (EQ.SecH D X Y f) (sec D (Fun D Y X) s)) (EQ.Htpy D X Y f s) (PSecH D X Y f s) (IN.snd D (Fun D Y X) (EQ.SecH D X Y f) c) ;
  } ;

  ----------------------------------------------------------------------
  -- (6) unpacking a packed element gives the components back

  module BQ (D : Ctx) (X Y : Ty D) (r : El D (Fun D Y X)) (k : El D (Kr D X Y r)) (f : El D (Fun D X Y))
    (hr : El D (EQ.Htpy D Y X r f)) (s : El D (Fun D Y X)) (hs : El D (EQ.Htpy D X Y f s)) {
    c0 : El D (SecT D X Y f) = mkSec D X Y f s hs ;
    l0 : El D (L D X Y r) = mkL D X Y r f hr c0 ;
    w : El D (QF D X Y) = mkQ D X Y r k l0 ;
    module UU = UQ[D, X, Y, w] ;
    FYX : Ty D = Fun D Y X ;
    FXY : Ty D = Fun D X Y ;
    IR : U l = El D FYX ;
    IF : U l = El D FXY ;

    -- level 1
    S1 : Ty D = subT D (ext D FYX) (QV[D, X, Y].QF1) (sec D FYX r) ;
    SU : Ty D = subT D (ext D FYX) (QV[D, X, Y].QF1) (sec D FYX UU.r) ;
    KL : Ty D = SS.Sig D (Kr D X Y r) (LW D X Y r) ;
    KLU : Ty D = SS.Sig D (Kr D X Y UU.r) (LW D X Y UU.r) ;
    y1 : El D KL = IN.pr D (Kr D X Y r) (LW D X Y r) k
                     (trE D (L D X Y r) (subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) k))
                        (sym (Ty D) (subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) k)) (L D X Y r) (PLW D X Y r k)) l0) ;
    y0 : El D S1 = trE D KL S1 (sym (Ty D) S1 KL (PQ1 D X Y r)) y1 ;
    er : Id IR UU.r r = IN.fst-pr D FYX (QV[D, X, Y].QF1) r y0 ;
    Tq1 : IN.TE D KLU KL UU.q1 y1 =
      IN.teT D KLU SU KL UU.q1 (IN.snd D FYX (QV[D, X, Y].QF1) w) y1
        (PJ.teTrS D SU KLU (PQ1 D X Y UU.r) (IN.snd D FYX (QV[D, X, Y].QF1) w))
        (IN.teT D SU S1 KL (IN.snd D FYX (QV[D, X, Y].QF1) w) y0 y1
           (PJ.sndPrTE D FYX (QV[D, X, Y].QF1) r y0)
           (PJ.teTrS D KL S1 (sym (Ty D) S1 KL (PQ1 D X Y r)) y1)) ;

    -- level 2: k and L
    Tk : IN.TE D (Kr D X Y UU.r) (Kr D X Y r) UU.k k =
      IN.teT D (Kr D X Y UU.r) (Kr D X Y r) (Kr D X Y r) UU.k (IN.fst D (Kr D X Y r) (LW D X Y r) y1) k
        (PJ.fstTE2 D IR IF (\ i j -> Kr D X Y i) (\ i j -> LW D X Y i) UU.r r er f f (refl f) UU.q1 y1 Tq1)
        (refl (Kr D X Y r), IN.fst-pr D (Kr D X Y r) (LW D X Y r) k
                              (trE D (L D X Y r) (subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) k))
                                 (sym (Ty D) (subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) k)) (L D X Y r) (PLW D X Y r k)) l0)) ;

    SK : Ty D = subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) (IN.fst D (Kr D X Y r) (LW D X Y r) y1)) ;
    SKU : Ty D = subT D (ext D (Kr D X Y UU.r)) (LW D X Y UU.r) (sec D (Kr D X Y UU.r) UU.k) ;
    SK0 : Ty D = subT D (ext D (Kr D X Y r)) (LW D X Y r) (sec D (Kr D X Y r) k) ;
    l0' : El D SK0 = trE D (L D X Y r) SK0 (sym (Ty D) SK0 (L D X Y r) (PLW D X Y r k)) l0 ;
    Tl : IN.TE D (L D X Y UU.r) (L D X Y r) UU.lv l0 =
      IN.teT D (L D X Y UU.r) SKU (L D X Y r) UU.lv (IN.snd D (Kr D X Y UU.r) (LW D X Y UU.r) UU.q1) l0
        (PJ.teTrS D SKU (L D X Y UU.r) (PLW D X Y UU.r UU.k) (IN.snd D (Kr D X Y UU.r) (LW D X Y UU.r) UU.q1))
        (IN.teT D SKU SK (L D X Y r) (IN.snd D (Kr D X Y UU.r) (LW D X Y UU.r) UU.q1) (IN.snd D (Kr D X Y r) (LW D X Y r) y1) l0
           (PJ.sndTE2 D IR IF (\ i j -> Kr D X Y i) (\ i j -> LW D X Y i) UU.r r er f f (refl f) UU.q1 y1 Tq1)
           (IN.teT D SK SK0 (L D X Y r) (IN.snd D (Kr D X Y r) (LW D X Y r) y1) l0' l0
              (PJ.sndPrTE D (Kr D X Y r) (LW D X Y r) k l0')
              (PJ.teTrS D (L D X Y r) SK0 (sym (Ty D) SK0 (L D X Y r) (PLW D X Y r k)) l0))) ;

    -- level 3: f and (hr , c)
    LFr (i : IR) : Ty (ext D FXY) = LV[D, X, Y, i].LF ;
    y3 : El D (LFf D X Y r f) =
      IN.pr D (EQ.Htpy D Y X r f) (SecT (ext D (EQ.Htpy D Y X r f)) (wkT D (EQ.Htpy D Y X r f) X) (wkT D (EQ.Htpy D Y X r f) Y) (EQ.wkF D (EQ.Htpy D Y X r f) X Y f)) hr
        (trE D (SecT D X Y f) (subT D (ext D (EQ.Htpy D Y X r f)) (SecT (ext D (EQ.Htpy D Y X r f)) (wkT D (EQ.Htpy D Y X r f) X) (wkT D (EQ.Htpy D Y X r f) Y) (EQ.wkF D (EQ.Htpy D Y X r f) X Y f)) (sec D (EQ.Htpy D Y X r f) hr))
           (sym (Ty D) (subT D (ext D (EQ.Htpy D Y X r f)) (SecT (ext D (EQ.Htpy D Y X r f)) (wkT D (EQ.Htpy D Y X r f) X) (wkT D (EQ.Htpy D Y X r f) Y) (EQ.wkF D (EQ.Htpy D Y X r f) X Y f)) (sec D (EQ.Htpy D Y X r f) hr))
                (SecT D X Y f) (PCc D X Y r f hr)) c0) ;
    S3 : Ty D = subT D (ext D FXY) (LFr r) (sec D FXY f) ;
    y2 : El D S3 = trE D (LFf D X Y r f) S3 (sym (Ty D) S3 (LFf D X Y r f) (PLF D X Y r f)) y3 ;
    ef : Id IF UU.f f =
      PJ.teId D FXY UU.f f
        (IN.teT D FXY FXY FXY UU.f (IN.fst D FXY (LFr r) l0) f
           (PJ.fstTE2 D IR IF (\ i j -> FXY) (\ i j -> LFr i) UU.r r er f f (refl f) UU.lv l0 Tl)
           (refl FXY, IN.fst-pr D FXY (LFr r) f y2)) ;

    S3p : Ty D = subT D (ext D FXY) (LFr r) (sec D FXY (IN.fst D FXY (LFr r) l0)) ;
    S3U : Ty D = subT D (ext D FXY) (LFr UU.r) (sec D FXY UU.f) ;
    Tl1 : IN.TE D (LFf D X Y UU.r UU.f) (LFf D X Y r f) UU.l1 y3 =
      IN.teT D (LFf D X Y UU.r UU.f) S3U (LFf D X Y r f) UU.l1 (IN.snd D FXY (LFr UU.r) UU.lv) y3
        (PJ.teTrS D S3U (LFf D X Y UU.r UU.f) (PLF D X Y UU.r UU.f) (IN.snd D FXY (LFr UU.r) UU.lv))
        (IN.teT D S3U S3p (LFf D X Y r f) (IN.snd D FXY (LFr UU.r) UU.lv) (IN.snd D FXY (LFr r) l0) y3
           (PJ.sndTE2 D IR IF (\ i j -> FXY) (\ i j -> LFr i) UU.r r er f f (refl f) UU.lv l0 Tl)
           (IN.teT D S3p S3 (LFf D X Y r f) (IN.snd D FXY (LFr r) l0) y2 y3
              (PJ.sndPrTE D FXY (LFr r) f y2)
              (PJ.teTrS D (LFf D X Y r f) S3 (sym (Ty D) S3 (LFf D X Y r f) (PLF D X Y r f)) y3))) ;

    HA (i : IR) (j : IF) : Ty D = EQ.Htpy D Y X i j ;
    CB (i : IR) (j : IF) : Ty (ext D (HA i j)) = SecT (ext D (HA i j)) (wkT D (HA i j) X) (wkT D (HA i j) Y) (EQ.wkF D (HA i j) X Y j) ;
    c0' : El D (subT D (ext D (HA r f)) (CB r f) (sec D (HA r f) hr)) =
      trE D (SecT D X Y f) (subT D (ext D (HA r f)) (CB r f) (sec D (HA r f) hr)) (sym (Ty D) (subT D (ext D (HA r f)) (CB r f) (sec D (HA r f) hr)) (SecT D X Y f) (PCc D X Y r f hr)) c0 ;
    Thr : IN.TE D (HA UU.r UU.f) (HA r f) UU.hr hr =
      IN.teT D (HA UU.r UU.f) (HA r f) (HA r f) UU.hr (IN.fst D (HA r f) (CB r f) y3) hr
        (PJ.fstTE2 D IR IF HA CB UU.r r er UU.f f ef UU.l1 y3 Tl1)
        (refl (HA r f), IN.fst-pr D (HA r f) (CB r f) hr c0') ;

    S4p : Ty D = subT D (ext D (HA r f)) (CB r f) (sec D (HA r f) (IN.fst D (HA r f) (CB r f) y3)) ;
    S4 : Ty D = subT D (ext D (HA r f)) (CB r f) (sec D (HA r f) hr) ;
    S4U : Ty D = subT D (ext D (HA UU.r UU.f)) (CB UU.r UU.f) (sec D (HA UU.r UU.f) UU.hr) ;
    Tc : IN.TE D (SecT D X Y UU.f) (SecT D X Y f) UU.c c0 =
      IN.teT D (SecT D X Y UU.f) S4U (SecT D X Y f) UU.c (IN.snd D (HA UU.r UU.f) (CB UU.r UU.f) UU.l1) c0
        (PJ.teTrS D S4U (SecT D X Y UU.f) (PCc D X Y UU.r UU.f UU.hr) (IN.snd D (HA UU.r UU.f) (CB UU.r UU.f) UU.l1))
        (IN.teT D S4U S4p (SecT D X Y f) (IN.snd D (HA UU.r UU.f) (CB UU.r UU.f) UU.l1) (IN.snd D (HA r f) (CB r f) y3) c0
           (PJ.sndTE2 D IR IF HA CB UU.r r er UU.f f ef UU.l1 y3 Tl1)
           (IN.teT D S4p S4 (SecT D X Y f) (IN.snd D (HA r f) (CB r f) y3) c0' c0
              (PJ.sndPrTE D (HA r f) (CB r f) hr c0')
              (PJ.teTrS D (SecT D X Y f) S4 (sym (Ty D) S4 (SecT D X Y f) (PCc D X Y r f hr)) c0))) ;

    -- level 4: s and hs
    SA (i : IF) (j : IF) : Ty D = FYX ;
    SB (i : IF) (j : IF) : Ty (ext D FYX) = EQ.SecH D X Y i ;
    S5 : Ty D = subT D (ext D FYX) (EQ.SecH D X Y f) (sec D FYX s) ;
    hs' : El D S5 = trE D (EQ.Htpy D X Y f s) S5 (sym (Ty D) S5 (EQ.Htpy D X Y f s) (PSecH D X Y f s)) hs ;
    es : Id IR UU.s s =
      PJ.teId D FYX UU.s s
        (IN.teT D FYX FYX FYX UU.s (IN.fst D FYX (EQ.SecH D X Y f) c0) s
           (PJ.fstTE2 D IF IF SA SB UU.f f ef f f (refl f) UU.c c0 Tc)
           (refl FYX, IN.fst-pr D FYX (EQ.SecH D X Y f) s hs')) ;

    S5p : Ty D = subT D (ext D FYX) (EQ.SecH D X Y f) (sec D FYX (IN.fst D FYX (EQ.SecH D X Y f) c0)) ;
    S5U : Ty D = subT D (ext D FYX) (EQ.SecH D X Y UU.f) (sec D FYX UU.s) ;
    Ths : IN.TE D (EQ.Htpy D X Y UU.f UU.s) (EQ.Htpy D X Y f s) UU.hs hs =
      IN.teT D (EQ.Htpy D X Y UU.f UU.s) S5U (EQ.Htpy D X Y f s) UU.hs (IN.snd D FYX (EQ.SecH D X Y UU.f) UU.c) hs
        (PJ.teTrS D S5U (EQ.Htpy D X Y UU.f UU.s) (PSecH D X Y UU.f UU.s) (IN.snd D FYX (EQ.SecH D X Y UU.f) UU.c))
        (IN.teT D S5U S5p (EQ.Htpy D X Y f s) (IN.snd D FYX (EQ.SecH D X Y UU.f) UU.c) (IN.snd D FYX (EQ.SecH D X Y f) c0) hs
           (PJ.sndTE2 D IF IF SA SB UU.f f ef f f (refl f) UU.c c0 Tc)
           (IN.teT D S5p S5 (EQ.Htpy D X Y f s) (IN.snd D FYX (EQ.SecH D X Y f) c0) hs' hs
              (PJ.sndPrTE D FYX (EQ.SecH D X Y f) s hs')
              (PJ.teTrS D (EQ.Htpy D X Y f s) S5 (sym (Ty D) S5 (EQ.Htpy D X Y f s) (PSecH D X Y f s)) hs))) ;
  } ;

  ----------------------------------------------------------------------
  -- (7) unpacking is stable

  module QN (D' D : Ctx) (sg : Sub D' D) (X Y : Ty D) (X' Y' : Ty D')
    (PX : Id (Ty D') (subT D' D X sg) X') (PY : Id (Ty D') (subT D' D Y sg) Y')
    (w : El D (QF D X Y)) (w' : El D' (QF D' X' Y'))
    (Pw : Ov D' D (QF D X Y) sg (QF D' X' Y') (QF-ov D' D X Y sg X' PX Y' PY) w w') {
    module A = UQ[D, X, Y, w] ;
    module B = UQ[D', X', Y', w'] ;
    FYX : Ty D = Fun D Y X ;
    FYX' : Ty D' = Fun D' Y' X' ;
    FXY : Ty D = Fun D X Y ;
    FXY' : Ty D' = Fun D' X' Y' ;
    PG : Id (Ty D') (subT D' D FYX sg) FYX' = Fun-ov D' D Y X sg Y' PY X' PX ;
    PF : Id (Ty D') (subT D' D FXY sg) FXY' = Fun-ov D' D X Y sg X' PX Y' PY ;

    -- r
    Or : Ov D' D FYX sg FYX' PG A.r B.r =
      PJ.fstO D' D FYX (QV[D, X, Y].QF1) sg FYX' PG (QV[D', X', Y'].QF1) (QF1-ov D' D X Y sg X' PX Y' PY) w w' Pw ;

    -- (k , L)
    KA : Ty D = Kr D X Y A.r ;
    KB : Ty D' = Kr D' X' Y' B.r ;
    PKr : Id (Ty D') (subT D' D KA sg) KB = Kr-ov D' D X Y A.r sg X' PX Y' PY PG B.r Or ;
    s1 : Sub (ext D' KB) (ext D KA) = upT D' D KA sg KB PKr ;
    PX1 : Id (Ty (ext D' KB)) (subT (ext D' KB) (ext D KA) (wkT D KA X) s1) (wkT D' KB X') = wkT-ov D' D KA X sg KB PKr X' PX ;
    PY1 : Id (Ty (ext D' KB)) (subT (ext D' KB) (ext D KA) (wkT D KA Y) s1) (wkT D' KB Y') = wkT-ov D' D KA Y sg KB PKr Y' PY ;
    PFw : Id (Ty (ext D' KB)) (subT (ext D' KB) (ext D KA) (Fun (ext D KA) (wkT D KA Y) (wkT D KA X)) s1) (Fun (ext D' KB) (wkT D' KB Y') (wkT D' KB X')) =
      Fun-ov (ext D' KB) (ext D KA) (wkT D KA Y) (wkT D KA X) s1 (wkT D' KB Y') PY1 (wkT D' KB X') PX1 ;
    PLWo : Id (Ty (ext D' KB)) (subT (ext D' KB) (ext D KA) (LW D X Y A.r) s1) (LW D' X' Y' B.r) =
      L-ov (ext D' KB) (ext D KA) (wkT D KA X) (wkT D KA Y) (EQ.wkF D KA Y X A.r) s1 (wkT D' KB X') PX1 (wkT D' KB Y') PY1 PFw (EQ.wkF D' KB Y' X' B.r)
        (EQ.wkF-ov D' D KA Y X sg KB PKr Y' X' PG A.r B.r Or PFw) ;
    PKL : Id (Ty D') (subT D' D (SS.Sig D KA (LW D X Y A.r)) sg) (SS.Sig D' KB (LW D' X' Y' B.r)) = Sig-ov D' D KA (LW D X Y A.r) sg KB PKr (LW D' X' Y' B.r) PLWo ;
    Oq1 : Ov D' D (SS.Sig D KA (LW D X Y A.r)) sg (SS.Sig D' KB (LW D' X' Y' B.r)) PKL A.q1 B.q1 =
      ovTr D' D (subT D (ext D FYX) (QV[D, X, Y].QF1) (sec D FYX A.r)) (SS.Sig D KA (LW D X Y A.r)) (PQ1 D X Y A.r) sg
        (subT D' (ext D' FYX') (QV[D', X', Y'].QF1) (sec D' FYX' B.r)) (SS.Sig D' KB (LW D' X' Y' B.r)) (PQ1 D' X' Y' B.r)
        (PJ.secPath D' D FYX (QV[D, X, Y].QF1) sg FYX' PG (QV[D', X', Y'].QF1) (QF1-ov D' D X Y sg X' PX Y' PY) A.r B.r Or) PKL
        (IN.snd D FYX (QV[D, X, Y].QF1) w) (IN.snd D' FYX' (QV[D', X', Y'].QF1) w')
        (PJ.sndO D' D FYX (QV[D, X, Y].QF1) sg FYX' PG (QV[D', X', Y'].QF1) (QF1-ov D' D X Y sg X' PX Y' PY) w w' Pw) ;
    Ok : Ov D' D KA sg KB PKr A.k B.k = PJ.fstO D' D KA (LW D X Y A.r) sg KB PKr (LW D' X' Y' B.r) PLWo A.q1 B.q1 Oq1 ;

    PL : Id (Ty D') (subT D' D (L D X Y A.r) sg) (L D' X' Y' B.r) = L-ov D' D X Y A.r sg X' PX Y' PY PG B.r Or ;
    Ol : Ov D' D (L D X Y A.r) sg (L D' X' Y' B.r) PL A.lv B.lv =
      ovTr D' D (subT D (ext D KA) (LW D X Y A.r) (sec D KA A.k)) (L D X Y A.r) (PLW D X Y A.r A.k) sg
        (subT D' (ext D' KB) (LW D' X' Y' B.r) (sec D' KB B.k)) (L D' X' Y' B.r) (PLW D' X' Y' B.r B.k)
        (PJ.secPath D' D KA (LW D X Y A.r) sg KB PKr (LW D' X' Y' B.r) PLWo A.k B.k Ok) PL
        (IN.snd D KA (LW D X Y A.r) A.q1) (IN.snd D' KB (LW D' X' Y' B.r) B.q1)
        (PJ.sndO D' D KA (LW D X Y A.r) sg KB PKr (LW D' X' Y' B.r) PLWo A.q1 B.q1 Oq1) ;

    -- f
    LFA : Ty (ext D FXY) = LV[D, X, Y, A.r].LF ;
    LFB : Ty (ext D' FXY') = LV[D', X', Y', B.r].LF ;
    PLFo : Id (Ty (ext D' FXY')) (subT (ext D' FXY') (ext D FXY) LFA (upT D' D FXY sg FXY' PF)) LFB = LF-ov D' D X Y A.r sg X' PX Y' PY PG B.r Or ;
    Of : Ov D' D FXY sg FXY' PF A.f B.f = PJ.fstO D' D FXY LFA sg FXY' PF LFB PLFo A.lv B.lv Ol ;

    -- (hr , c)
    HA : Ty D = EQ.Htpy D Y X A.r A.f ;
    HB : Ty D' = EQ.Htpy D' Y' X' B.r B.f ;
    PHr : Id (Ty D') (subT D' D HA sg) HB = EQ.Htpy-ov D' D Y X A.r A.f sg Y' PY X' PX PG B.r Or PF B.f Of ;
    s3 : Sub (ext D' HB) (ext D HA) = upT D' D HA sg HB PHr ;
    PX3 : Id (Ty (ext D' HB)) (subT (ext D' HB) (ext D HA) (wkT D HA X) s3) (wkT D' HB X') = wkT-ov D' D HA X sg HB PHr X' PX ;
    PY3 : Id (Ty (ext D' HB)) (subT (ext D' HB) (ext D HA) (wkT D HA Y) s3) (wkT D' HB Y') = wkT-ov D' D HA Y sg HB PHr Y' PY ;
    PFh : Id (Ty (ext D' HB)) (subT (ext D' HB) (ext D HA) (Fun (ext D HA) (wkT D HA X) (wkT D HA Y)) s3) (Fun (ext D' HB) (wkT D' HB X') (wkT D' HB Y')) =
      Fun-ov (ext D' HB) (ext D HA) (wkT D HA X) (wkT D HA Y) s3 (wkT D' HB X') PX3 (wkT D' HB Y') PY3 ;
    CA : Ty (ext D HA) = SecT (ext D HA) (wkT D HA X) (wkT D HA Y) (EQ.wkF D HA X Y A.f) ;
    CB : Ty (ext D' HB) = SecT (ext D' HB) (wkT D' HB X') (wkT D' HB Y') (EQ.wkF D' HB X' Y' B.f) ;
    PCA : Id (Ty (ext D' HB)) (subT (ext D' HB) (ext D HA) CA s3) CB =
      SecT-ov (ext D' HB) (ext D HA) (wkT D HA X) (wkT D HA Y) (EQ.wkF D HA X Y A.f) s3 (wkT D' HB X') PX3 (wkT D' HB Y') PY3 PFh (EQ.wkF D' HB X' Y' B.f)
        (EQ.wkF-ov D' D HA X Y sg HB PHr X' Y' PF A.f B.f Of PFh) ;
    PLFf : Id (Ty D') (subT D' D (LFf D X Y A.r A.f) sg) (LFf D' X' Y' B.r B.f) = Sig-ov D' D HA CA sg HB PHr CB PCA ;
    Ol1 : Ov D' D (LFf D X Y A.r A.f) sg (LFf D' X' Y' B.r B.f) PLFf A.l1 B.l1 =
      ovTr D' D (subT D (ext D FXY) LFA (sec D FXY A.f)) (LFf D X Y A.r A.f) (PLF D X Y A.r A.f) sg
        (subT D' (ext D' FXY') LFB (sec D' FXY' B.f)) (LFf D' X' Y' B.r B.f) (PLF D' X' Y' B.r B.f)
        (PJ.secPath D' D FXY LFA sg FXY' PF LFB PLFo A.f B.f Of) PLFf
        (IN.snd D FXY LFA A.lv) (IN.snd D' FXY' LFB B.lv)
        (PJ.sndO D' D FXY LFA sg FXY' PF LFB PLFo A.lv B.lv Ol) ;
    Ohr : Ov D' D HA sg HB PHr A.hr B.hr = PJ.fstO D' D HA CA sg HB PHr CB PCA A.l1 B.l1 Ol1 ;

    PSc : Id (Ty D') (subT D' D (SecT D X Y A.f) sg) (SecT D' X' Y' B.f) = SecT-ov D' D X Y A.f sg X' PX Y' PY PF B.f Of ;
    Oc : Ov D' D (SecT D X Y A.f) sg (SecT D' X' Y' B.f) PSc A.c B.c =
      ovTr D' D (subT D (ext D HA) CA (sec D HA A.hr)) (SecT D X Y A.f) (PCc D X Y A.r A.f A.hr) sg
        (subT D' (ext D' HB) CB (sec D' HB B.hr)) (SecT D' X' Y' B.f) (PCc D' X' Y' B.r B.f B.hr)
        (PJ.secPath D' D HA CA sg HB PHr CB PCA A.hr B.hr Ohr) PSc
        (IN.snd D HA CA A.l1) (IN.snd D' HB CB B.l1)
        (PJ.sndO D' D HA CA sg HB PHr CB PCA A.l1 B.l1 Ol1) ;

    -- s and hs
    PSH : Id (Ty (ext D' FYX')) (subT (ext D' FYX') (ext D FYX) (EQ.SecH D X Y A.f) (upT D' D FYX sg FYX' PG)) (EQ.SecH D' X' Y' B.f) =
      SecH-ov D' D X Y A.f sg X' PX Y' PY PF B.f Of ;
    Os : Ov D' D FYX sg FYX' PG A.s B.s = PJ.fstO D' D FYX (EQ.SecH D X Y A.f) sg FYX' PG (EQ.SecH D' X' Y' B.f) PSH A.c B.c Oc ;
    Ohs : Ov D' D (EQ.Htpy D X Y A.f A.s) sg (EQ.Htpy D' X' Y' B.f B.s) (EQ.Htpy-ov D' D X Y A.f A.s sg X' PX Y' PY PF B.f Of PG B.s Os) A.hs B.hs =
      ovTr D' D (subT D (ext D FYX) (EQ.SecH D X Y A.f) (sec D FYX A.s)) (EQ.Htpy D X Y A.f A.s) (PSecH D X Y A.f A.s) sg
        (subT D' (ext D' FYX') (EQ.SecH D' X' Y' B.f) (sec D' FYX' B.s)) (EQ.Htpy D' X' Y' B.f B.s) (PSecH D' X' Y' B.f B.s)
        (PJ.secPath D' D FYX (EQ.SecH D X Y A.f) sg FYX' PG (EQ.SecH D' X' Y' B.f) PSH A.s B.s Os)
        (EQ.Htpy-ov D' D X Y A.f A.s sg X' PX Y' PY PF B.f Of PG B.s Os)
        (IN.snd D FYX (EQ.SecH D X Y A.f) A.c) (IN.snd D' FYX' (EQ.SecH D' X' Y' B.f) B.c)
        (PJ.sndO D' D FYX (EQ.SecH D X Y A.f) sg FYX' PG (EQ.SecH D' X' Y' B.f) PSH A.c B.c Oc) ;
  } ;
} ;
