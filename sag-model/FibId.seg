-- FibId.seg (M1, step 3): the instance fibId of CwFId.SwanId[l+, fibCwF].IdJStr,
-- second part (the first is FibIdCen): J is CJ's J (PosJNat.JJ) for the
-- J-data of PosIdYJ, over the record's context of the motive, with the
-- start moved along cen = cY; beta is CJ's beta read back along cen = cY;
-- J-nat is PosJNat.JNatG at the record's map upS (whose commutation with
-- the J-data comes from upY through upS = upY at each point), with the
-- starts compared in the total space (cen-nat, FibIdRd.elTr).
--
-- Writing rule learnt here: PosIdYJ's terms (DY, cY, yjD) and the
-- record's (Der.Dx, Der.cen) are two presentations of one context; a
-- comparison of two large terms that differ in it costs seconds.  So each
-- PosIdYJ term is given once a type in the record's vocabulary (cYr,
-- yjDr, ..., CN.ptR), and the D-level data is FC.subS D G A s, not the
-- record's projection, inside the proofs.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module FC = FibCwF[a, l].FC ;
module SW = CwFId.SwanId[l+, FibCwF[a, l].fibCwF] ;
module R = FibIdRd[a, l] ;
open FibIdCen[a, l] ;

-- the start of J, moved to cY
dC (G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (CM : FC.STy (DR.Dx G A a0)) (d : PEl[G, subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)])
  : PEl[G, subTy G (DR.Dx G A a0) CM.1 PosIdYJ[a, l].YJ[G, A.1, a0].cY] =
  subst (PSub[G, DR.Dx G A a0]) (\ t -> PEl[G, subTy G (DR.Dx G A a0) CM.1 t]) (DR.cen G A a0) PosIdYJ[a, l].YJ[G, A.1, a0].cY Cen[G, A, a0].cenEq d ;

module JB (G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (CM : FC.STy (DR.Dx G A a0)) (d : PEl[G, subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)]) {
  module J0 = PosJNat[a, l].JJ[G, DR.Dx G A a0, PosIdYJ[a, l].YJ[G, A.1, a0].yjD, CM.1, CM.2.1, dC G A a0 CM d].J0 ;
} ;

jY (G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (CM : FC.STy (DR.Dx G A a0)) (d : PEl[G, subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)])
  : PEl[DR.Dx G A a0, CM.1] = JB[G, A, a0, CM, d].J0.J ;

-- a computation rule at one substitution gives it at an equal one
betaTr (G Z : PCtx) (C : PTy[Z]) (sg sg' : PSub[G, Z]) (P : Id (PSub[G, Z]) sg sg') (Jt : PEl[Z, C]) (d : PEl[G, subTy G Z C sg])
  (h : Id (PEl[G, subTy G Z C sg']) (subEl G Z C Jt sg') (subst (PSub[G, Z]) (\ t -> PEl[G, subTy G Z C t]) sg sg' P d))
  : Id (PEl[G, subTy G Z C sg]) (subEl G Z C Jt sg) d =
  idJ (PSub[G, Z]) sg
    (\ t P2 -> Id (PEl[G, subTy G Z C t]) (subEl G Z C Jt t) (subst (PSub[G, Z]) (\ t2 -> PEl[G, subTy G Z C t2]) sg t P2 d)
       -> Id (PEl[G, subTy G Z C sg]) (subEl G Z C Jt sg) d)
    (\ h2 -> h2) sg' P h ;

jY-beta (G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (CM : FC.STy (DR.Dx G A a0)) (d : PEl[G, subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)])
  : Id (PEl[G, subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)]) (subEl G (DR.Dx G A a0) CM.1 (jY G A a0 CM d) (DR.cen G A a0)) d =
  betaTr G (DR.Dx G A a0) CM.1 (DR.cen G A a0) PosIdYJ[a, l].YJ[G, A.1, a0].cY Cen[G, A, a0].cenEq (jY G A a0 CM d) d
    (el-ext G (subTy G (DR.Dx G A a0) CM.1 PosIdYJ[a, l].YJ[G, A.1, a0].cY)
       (subEl G (DR.Dx G A a0) CM.1 (jY G A a0 CM d) PosIdYJ[a, l].YJ[G, A.1, a0].cY) (dC G A a0 CM d)
       (\ X x -> JB[G, A, a0, CM, d].J0.beta X x)) ;

------------------------------------------------------------------------
-- (5) J commutes with substitution: PosJNat.JNatG at the record's map upS

-- a transport along a path of substitutions, read in the total space
trS (G Z : PCtx) (C : PTy[Z]) (sg sg' : PSub[G, Z]) (P : Id (PSub[G, Z]) sg sg') (u : PEl[G, subTy G Z C sg]) (X : Ob) (x : W0.Ix (G.ob X))
  : Id (GPR.TyL[Z, C].EI X) (GPR.TyL[Z, C].pr X (sg'.nt X x) ((subst (PSub[G, Z]) (\ t -> PEl[G, subTy G Z C t]) sg sg' P u).eob X x))
                            (GPR.TyL[Z, C].pr X (sg.nt X x) (u.eob X x)) =
  idJ (PSub[G, Z]) sg
    (\ t P2 -> Id (GPR.TyL[Z, C].EI X) (GPR.TyL[Z, C].pr X (t.nt X x) ((subst (PSub[G, Z]) (\ t2 -> PEl[G, subTy G Z C t2]) sg t P2 u).eob X x))
                                       (GPR.TyL[Z, C].pr X (sg.nt X x) (u.eob X x)))
    (refl (GPR.TyL[Z, C].pr X (sg.nt X x) (u.eob X x))) sg' P ;

module JNt (D G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (s : PSub[D, G]) (CM : FC.STy (DR.Dx G A a0))
  (d : PEl[G, subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)]) {
  module UP = Up[D, G, A, a0, s] ;
  module Y = UP.Y ;
  module Yr = PosIdYJ[a, l].YJ[D, (FC.subS D G A s).1, subEl D G A.1 a0 s] ;
  module TC = GPR.TyL[DR.Dx G A a0, CM.1] ;

  -- the motive and its start at D, as in the record
  CM' : FC.STy (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) =
    FC.subS (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) (DR.Dx G A a0) CM (DR.upS D G A a0 s) ;
  d'' : PEl[D, subTy D (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) CM'.1 (DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s))] =
    subst (FC.STy D) (\ Z -> PEl[D, Z.1])
      (FC.subS D G (FC.subS G (DR.Dx G A a0) CM (DR.cen G A a0)) s)
      (FC.subS D (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) CM' (DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)))
      (DR.cenT D G A a0 s CN[D, G, A, a0, s].law CM)
      (subEl D G (subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)) d s) ;

  -- upS commutes with the J-data (from upY, through upS = upY at each
  -- point), stated in the vocabulary of PosIdYJ
  module Y' = UP.Y' ;

  prEq (X : Ob) (z : W0.Ix (Y'.DY.ob X)) : Id (W0.Ix (G.ob X)) (Y.prY.nt X (UP.upSY.nt X z)) (s.nt X (Y'.prY.nt X z)) =
    apH (Y.prY.nt X) UP.UpZ[X, z].pt ;

  lamEq (X : Ob) (z : W0.Ix (Y'.DY.ob X))
    : Id (W0.Ix (Y.FDY.ob X)) (PB.CLine[l].FMap[Y'.DY, Y.DY, UP.upSY].mapF X (Y'.lamY X z)) (Y.lamY X (UP.upSY.nt X z)) =
    Y.FDY.fam-eq X (PB.CLine[l].FMap[Y'.DY, Y.DY, UP.upSY].mapF X (Y'.lamY X z)) (Y.lamY X (UP.upSY.nt X z))
      (\ W f j -> transH (UP.UpZ[W, (Y'.lamY X z).1 W f j].pt)
                    (transH (apH (\ F -> F.1 W f j) (UP.YN.lamEq X z))
                       (apH (\ w -> (Y.lamY X w).1 W f j) (symH UP.UpZ[X, z].pt)))) ;

  psiEq (X : Ob) (z : W0.Ix (Y'.DY.ob X)) : Id (PB.Phi X) (Y'.psiY X z) (Y.psiY X (UP.upSY.nt X z)) =
    apH (Y.psiY X) (symH UP.UpZ[X, z].pt) ;

  -- the start at D, moved to cY'
  -- PosIdYJ's centres, J-data and starts, named with the record's contexts
  -- (each comparison of the two contexts is made once, here)
  cYr : PSub[D, DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)] = Yr.cY ;
  cenEqr : Id (PSub[D, DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)]) (DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)) cYr = Cen[D, FC.subS D G A s, subEl D G A.1 a0 s].cenEq ;
  cYg : PSub[G, DR.Dx G A a0] = Y.cY ;
  yjDr : PosJNat[a, l].JD[D, DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)] = Yr.yjD ;
  yjDg : PosJNat[a, l].JD[G, DR.Dx G A a0] = Y.yjD ;
  dD : PEl[D, subTy D (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) CM'.1 cYr] = dC D (FC.subS D G A s) (subEl D G A.1 a0 s) CM' d'' ;
  dG : PEl[G, subTy G (DR.Dx G A a0) CM.1 cYg] = dC G A a0 CM d ;

  -- the starts are one point of the total space
  st1 (X : Ob) (x : W0.Ix (D.ob X))
    : Id (TC.EI X) (TC.pr X ((DR.upS D G A a0 s).nt X (cYr.nt X x)) (dD.eob X x))
                   (TC.pr X ((DR.upS D G A a0 s).nt X ((DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)).nt X x)) (d''.eob X x)) =
    apH (PB.CSub[l].SubE[DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s), DR.Dx G A a0, DR.upS D G A a0 s, CM.1].mV X)
      (trS D (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) CM'.1 (DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)) cYr
         cenEqr d'' X x) ;

  -- d'' at x is d at s x moved along the code path of cen-nat
  vEq (X : Ob) (x : W0.Ix (D.ob X))
    : Id (W0.Ix (CM.1.tob X ((DR.upS D G A a0 s).nt X ((DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)).nt X x))))
         (d''.eob X x)
         (subst W0.V (\ v -> W0.Ix v) (CM.1.tob X ((DR.cen G A a0).nt X (s.nt X x)))
            (CM.1.tob X ((DR.upS D G A a0 s).nt X ((DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)).nt X x)))
            (apH (CM.1.tob X) (CN[D, G, A, a0, s].ptR X x)) (d.eob X (s.nt X x))) =
    R.elTr D (FC.STy D) (\ Z -> Z.1)
      (FC.subS D G (FC.subS G (DR.Dx G A a0) CM (DR.cen G A a0)) s)
      (FC.subS D (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) CM' (DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)))
      (DR.cenT D G A a0 s CN[D, G, A, a0, s].law CM)
      (subEl D G (subTy G (DR.Dx G A a0) CM.1 (DR.cen G A a0)) d s) X x (apH (CM.1.tob X) (CN[D, G, A, a0, s].ptR X x)) ;

  st2 (X : Ob) (x : W0.Ix (D.ob X))
    : Id (TC.EI X) (TC.pr X ((DR.upS D G A a0 s).nt X ((DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)).nt X x)) (d''.eob X x))
                   (TC.pr X ((DR.cen G A a0).nt X (s.nt X x)) (d.eob X (s.nt X x))) =
    symH (TC.pr-eqV X ((DR.cen G A a0).nt X (s.nt X x)) ((DR.upS D G A a0 s).nt X ((DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)).nt X x))
            (CN[D, G, A, a0, s].ptR X x) (d.eob X (s.nt X x)) (d''.eob X x) (apH (CM.1.tob X) (CN[D, G, A, a0, s].ptR X x))
            (symH (vEq X x))) ;

  st3 (X : Ob) (x : W0.Ix (D.ob X))
    : Id (TC.EI X) (TC.pr X ((DR.cen G A a0).nt X (s.nt X x)) (d.eob X (s.nt X x)))
                   (TC.pr X (cYg.nt X (s.nt X x)) (dG.eob X (s.nt X x))) =
    symH (trS G (DR.Dx G A a0) CM.1 (DR.cen G A a0) cYg Cen[G, A, a0].cenEq d X (s.nt X x)) ;

  dEq (X : Ob) (x : W0.Ix (D.ob X))
    : Id (TC.EI X) (TC.pr X ((DR.upS D G A a0 s).nt X (cYr.nt X x)) (dD.eob X x))
                   (TC.pr X (cYg.nt X (s.nt X x)) (dG.eob X (s.nt X x))) =
    transH (st1 X x) (transH (st2 X x) (st3 X x)) ;

  module JN = PosJNat[a, l].JNatG[D, G, s, DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s), DR.Dx G A a0, yjDr, yjDg, DR.upS D G A a0 s,
    prEq, lamEq, psiEq, CM.1, CM.2.1, dG, dD, dEq] ;

  law : Id (PEl[DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s), CM'.1])
           (subEl (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) (DR.Dx G A a0) CM.1 (jY G A a0 CM d) (DR.upS D G A a0 s))
           (jY D (FC.subS D G A s) (subEl D G A.1 a0 s) CM' d'') =
    el-ext (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) CM'.1
      (subEl (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) (DR.Dx G A a0) CM.1 (jY G A a0 CM d) (DR.upS D G A a0 s))
      (jY D (FC.subS D G A s) (subEl D G A.1 a0 s) CM' d'') (\ X z -> symH (JN.jnat X z)) ;
} ;

------------------------------------------------------------------------
-- the instance

fibId : SW.IdJStr = new SW.IdJStr[
  IdT     := idTy,
  IdT-nat := idTy-nat,
  rfl     := rflE,
  rfl-nat := \ D G A a0 s -> RflNat[D, G, A, a0, s].law,
  J       := jY,
  J-beta  := jY-beta,
  cen-nat := \ D G A a0 s -> CN[D, G, A, a0, s].law,
  J-nat   := \ D G A a0 s CM d -> JNt[D, G, A, a0, s, CM, d].law ] ;
