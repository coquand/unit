-- CwFPrj.seg (M1 step 3, S4 toolkit): pairs and projections along a
-- substitution, with the type of the second component computed, in a CwF
-- with Pi, Sigma and Swan Id.
--
-- Informal text.  For a family B over G.A and B' over D.A' with B along
-- the lift of s equal to B' (PB), and x over x': B at x, along s, is B' at
-- x' (secPath: sec x after s is the lift of s after sec x[s], CwF's
-- coerce).  So the second projection, and the pair, are stable with the
-- type path computed (sndO, prO).  Also: transports undone (trBack), eta
-- for pairs (etaS), and the second projection of a pair (sndPr).

open Base ;

module Prj (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;

  -- B at x, along s, is B' at x'
  secPath (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (x : El G A) (x' : El D A') (Px : Ov D G A s A' PA x x')
    : Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D (ext D A') B' (sec D A' x')) =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
         -> (x2 : El D X) -> Ov D G A s X PX x x2
         -> Id (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D (ext D X) B2 (sec D X x2)))
      (\ B2 PB2 x2 Px2 ->
         trans (Ty D) (subT D G (subT G (ext G A) B (sec G A x)) s) (subT D E BL (sec D As (subt D G A x s))) (subT D E B2 (sec D As x2))
           (CwF.Formers[l, C].coerce D G A B x s)
           (trans (Ty D) (subT D E BL (sec D As (subt D G A x s))) (subT D E B2 (sec D As (subt D G A x s))) (subT D E B2 (sec D As x2))
              (ap (Ty E) (Ty D) (\ Y -> subT D E Y (sec D As (subt D G A x s))) BL B2 PB2)
              (ap (El D As) (Ty D) (\ v -> subT D E B2 (sec D As v)) (subt D G A x s) x2 Px2)))
      A' PA B' PB x' Px
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
   } ;

  -- the second projection along s
  sndO (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (w : El G (SS.Sig G A B)) (w' : El D (SS.Sig D A' B'))
    (Pw : Ov D G (SS.Sig G A B) s (SS.Sig D A' B') (Sig-ov D G A B s A' PA B' PB) w w')
    : Ov D G (subT G (ext G A) B (sec G A (IN.fst G A B w))) s (subT D (ext D A') B' (sec D A' (IN.fst D A' B' w')))
         (secPath D G A B s A' PA B' PB (IN.fst G A B w) (IN.fst D A' B' w') (IN.fst-ov D G A B s A' PA B' PB (Sig-ov D G A B s A' PA B' PB) w w' Pw))
         (IN.snd G A B w) (IN.snd D A' B' w') =
    IN.snd-ov D G A B s A' PA B' PB (Sig-ov D G A B s A' PA B' PB) w w' Pw
      (secPath D G A B s A' PA B' PB (IN.fst G A B w) (IN.fst D A' B' w') (IN.fst-ov D G A B s A' PA B' PB (Sig-ov D G A B s A' PA B' PB) w w' Pw)) ;

  fstO (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (w : El G (SS.Sig G A B)) (w' : El D (SS.Sig D A' B'))
    (Pw : Ov D G (SS.Sig G A B) s (SS.Sig D A' B') (Sig-ov D G A B s A' PA B' PB) w w')
    : Ov D G A s A' PA (IN.fst G A B w) (IN.fst D A' B' w') =
    IN.fst-ov D G A B s A' PA B' PB (Sig-ov D G A B s A' PA B' PB) w w' Pw ;

  -- the pair along s
  prO (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    (x : El G A) (x' : El D A') (Px : Ov D G A s A' PA x x')
    (y : El G (subT G (ext G A) B (sec G A x))) (y' : El D (subT D (ext D A') B' (sec D A' x')))
    (Py : Ov D G (subT G (ext G A) B (sec G A x)) s (subT D (ext D A') B' (sec D A' x')) (secPath D G A B s A' PA B' PB x x' Px) y y')
    : Ov D G (SS.Sig G A B) s (SS.Sig D A' B') (Sig-ov D G A B s A' PA B' PB) (IN.pr G A B x y) (IN.pr D A' B' x' y') =
    IN.pr-ov D G A B s A' PA B' PB (Sig-ov D G A B s A' PA B' PB) x x' Px y y' (secPath D G A B s A' PA B' PB x x' Px) Py ;

  -- a transport undone, along any two paths
  trBack (G : Ctx) (A A' : Ty G) (P : Id (Ty G) A' A) (P' : Id (Ty G) A A') (a : El G A)
    : Id (El G A) (trE G A' A P (trE G A A' P' a)) a =
    trans (El G A) (trE G A' A P (trE G A A' P' a)) (trE G A A (trans (Ty G) A A' A P' P) a) a
      (trE-tr G A A' A P' P a) (trE-irr G A A (trans (Ty G) A A' A P' P) (refl A) a) ;

  -- eta for pairs
  etaS (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (w : El G (SS.Sig G A B))
    : Id (El G (SS.Sig G A B)) (IN.pr G A B (IN.fst G A B w) (IN.snd G A B w)) w = (SS.Sig-iso G A B).inv-fun w ;

  -- the second projection of a pair, transported to the type at x
  sndPr (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (x : El G A) (y : El G (subT G (ext G A) B (sec G A x)))
    (P : Id (Ty G) (subT G (ext G A) B (sec G A (IN.fst G A B (IN.pr G A B x y)))) (subT G (ext G A) B (sec G A x)))
    : Id (El G (subT G (ext G A) B (sec G A x))) (trE G (subT G (ext G A) B (sec G A (IN.fst G A B (IN.pr G A B x y)))) (subT G (ext G A) B (sec G A x)) P
                                                    (IN.snd G A B (IN.pr G A B x y))) y =
    calc (El G Bx) {
        trE G Bp Bx P (IN.snd G A B (IN.pr G A B x y))
      =< trE-irr G Bp Bx P Apg (IN.snd G A B (IN.pr G A B x y)) >
        trE G Bp Bx Apg (IN.snd G A B (IN.pr G A B x y))
      =< sym (El G Bx) (subst (El G A) (\ x2 -> El G (subT G (ext G A) B (sec G A x2))) (IN.fst G A B (IN.pr G A B x y)) x (IN.fst-pr G A B x y) (IN.snd G A B (IN.pr G A B x y)))
            (trE G Bp Bx Apg (IN.snd G A B (IN.pr G A B x y)))
            (SV.substEl G A (\ x2 -> subT G (ext G A) B (sec G A x2)) (IN.fst G A B (IN.pr G A B x y)) x (IN.fst-pr G A B x y) (IN.snd G A B (IN.pr G A B x y))) >
        subst (El G A) (\ x2 -> El G (subT G (ext G A) B (sec G A x2))) (IN.fst G A B (IN.pr G A B x y)) x (IN.fst-pr G A B x y) (IN.snd G A B (IN.pr G A B x y))
      =< IN.snd-pr G A B x y >
        y }
   where {
    Bx : Ty G = subT G (ext G A) B (sec G A x) ;
    Bp : Ty G = subT G (ext G A) B (sec G A (IN.fst G A B (IN.pr G A B x y))) ;
    Apg : Id (Ty G) Bp Bx = ap (El G A) (Ty G) (\ x2 -> subT G (ext G A) B (sec G A x2)) (IN.fst G A B (IN.pr G A B x y)) x (IN.fst-pr G A B x y) ;
   } ;

  -- an over-path read through a path of its source element
  ovSrc (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (a b : El G A) (e : Id (El G A) a b) (a' : El D A')
    (h : Ov D G A s A' PA b a') : Ov D G A s A' PA a a' =
    idJ (El G A) a (\ b2 e2 -> Ov D G A s A' PA b2 a' -> Ov D G A s A' PA a a') (\ h2 -> h2) b e h ;

  -- an over-path read through a path of its target element
  ovTgt (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (a : El G A) (a' b' : El D A')
    (h : Ov D G A s A' PA a a') (e : Id (El D A') a' b') : Ov D G A s A' PA a b' =
    trans (El D A') (trE D (subT D G A s) A' PA (subt D G A a s)) a' b' h e ;

  -- projections of two pairs that are transports of each other, in a
  -- family of Sigma types indexed by two parameters that agree
  fstTE2 (D : Ctx) (I J : U l) (A : I -> J -> Ty D) (B : (i : I) -> (j : J) -> Ty (ext D (A i j)))
    (i1 i2 : I) (e1 : Id I i1 i2) (j1 j2 : J) (e2 : Id J j1 j2)
    (w1 : El D (SS.Sig D (A i1 j1) (B i1 j1))) (w2 : El D (SS.Sig D (A i2 j2) (B i2 j2)))
    (h : IN.TE D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i2 j2) (B i2 j2)) w1 w2)
    : IN.TE D (A i1 j1) (A i2 j2) (IN.fst D (A i1 j1) (B i1 j1) w1) (IN.fst D (A i2 j2) (B i2 j2) w2) =
    idJ I i1
      (\ i ei -> (w3 : El D (SS.Sig D (A i j2) (B i j2))) -> IN.TE D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i j2) (B i j2)) w1 w3
         -> IN.TE D (A i1 j1) (A i j2) (IN.fst D (A i1 j1) (B i1 j1) w1) (IN.fst D (A i j2) (B i j2) w3))
      (idJ J j1
         (\ j ej -> (w3 : El D (SS.Sig D (A i1 j) (B i1 j))) -> IN.TE D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i1 j) (B i1 j)) w1 w3
            -> IN.TE D (A i1 j1) (A i1 j) (IN.fst D (A i1 j1) (B i1 j1) w1) (IN.fst D (A i1 j) (B i1 j) w3))
         (\ w3 h3 -> (refl (A i1 j1),
                      ap (El D (SS.Sig D (A i1 j1) (B i1 j1))) (El D (A i1 j1)) (\ v -> IN.fst D (A i1 j1) (B i1 j1) v) w1 w3
                         (IN.teAny D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i1 j1) (B i1 j1)) w1 w3 h3 (refl (SS.Sig D (A i1 j1) (B i1 j1))))))
         j2 e2)
      i2 e1 w2 h ;

  sndTE2 (D : Ctx) (I J : U l) (A : I -> J -> Ty D) (B : (i : I) -> (j : J) -> Ty (ext D (A i j)))
    (i1 i2 : I) (e1 : Id I i1 i2) (j1 j2 : J) (e2 : Id J j1 j2)
    (w1 : El D (SS.Sig D (A i1 j1) (B i1 j1))) (w2 : El D (SS.Sig D (A i2 j2) (B i2 j2)))
    (h : IN.TE D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i2 j2) (B i2 j2)) w1 w2)
    : IN.TE D (subT D (ext D (A i1 j1)) (B i1 j1) (sec D (A i1 j1) (IN.fst D (A i1 j1) (B i1 j1) w1)))
              (subT D (ext D (A i2 j2)) (B i2 j2) (sec D (A i2 j2) (IN.fst D (A i2 j2) (B i2 j2) w2)))
              (IN.snd D (A i1 j1) (B i1 j1) w1) (IN.snd D (A i2 j2) (B i2 j2) w2) =
    idJ I i1
      (\ i ei -> (w3 : El D (SS.Sig D (A i j2) (B i j2))) -> IN.TE D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i j2) (B i j2)) w1 w3
         -> IN.TE D (subT D (ext D (A i1 j1)) (B i1 j1) (sec D (A i1 j1) (IN.fst D (A i1 j1) (B i1 j1) w1)))
                    (subT D (ext D (A i j2)) (B i j2) (sec D (A i j2) (IN.fst D (A i j2) (B i j2) w3)))
                    (IN.snd D (A i1 j1) (B i1 j1) w1) (IN.snd D (A i j2) (B i j2) w3))
      (idJ J j1
         (\ j ej -> (w3 : El D (SS.Sig D (A i1 j) (B i1 j))) -> IN.TE D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i1 j) (B i1 j)) w1 w3
            -> IN.TE D (subT D (ext D (A i1 j1)) (B i1 j1) (sec D (A i1 j1) (IN.fst D (A i1 j1) (B i1 j1) w1)))
                       (subT D (ext D (A i1 j)) (B i1 j) (sec D (A i1 j) (IN.fst D (A i1 j) (B i1 j) w3)))
                       (IN.snd D (A i1 j1) (B i1 j1) w1) (IN.snd D (A i1 j) (B i1 j) w3))
         (\ w3 h3 ->
            idJ (El D (SS.Sig D (A i1 j1) (B i1 j1))) w1
              (\ w4 e4 -> IN.TE D (subT D (ext D (A i1 j1)) (B i1 j1) (sec D (A i1 j1) (IN.fst D (A i1 j1) (B i1 j1) w1)))
                                  (subT D (ext D (A i1 j1)) (B i1 j1) (sec D (A i1 j1) (IN.fst D (A i1 j1) (B i1 j1) w4)))
                                  (IN.snd D (A i1 j1) (B i1 j1) w1) (IN.snd D (A i1 j1) (B i1 j1) w4))
              (refl (subT D (ext D (A i1 j1)) (B i1 j1) (sec D (A i1 j1) (IN.fst D (A i1 j1) (B i1 j1) w1))), refl (IN.snd D (A i1 j1) (B i1 j1) w1))
              w3 (IN.teAny D (SS.Sig D (A i1 j1) (B i1 j1)) (SS.Sig D (A i1 j1) (B i1 j1)) w1 w3 h3 (refl (SS.Sig D (A i1 j1) (B i1 j1)))))
         j2 e2)
      i2 e1 w2 h ;

  -- a TE between elements of one type is a path
  teId (G : Ctx) (A : Ty G) (x y : El G A) (h : IN.TE G A A x y) : Id (El G A) x y = IN.teAny G A A x y h (refl A) ;

  -- the second component of a pair is a transport of y
  sndPrTE (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (x : El G A) (y : El G (subT G (ext G A) B (sec G A x)))
    : IN.TE G (subT G (ext G A) B (sec G A (IN.fst G A B (IN.pr G A B x y)))) (subT G (ext G A) B (sec G A x)) (IN.snd G A B (IN.pr G A B x y)) y =
    (ap (El G A) (Ty G) (\ x2 -> subT G (ext G A) B (sec G A x2)) (IN.fst G A B (IN.pr G A B x y)) x (IN.fst-pr G A B x y),
     sndPr G A B x y (ap (El G A) (Ty G) (\ x2 -> subT G (ext G A) B (sec G A x2)) (IN.fst G A B (IN.pr G A B x y)) x (IN.fst-pr G A B x y))) ;

  -- a transport and its source
  teTrS (G : Ctx) (A B : Ty G) (P : Id (Ty G) A B) (x : El G A) : IN.TE G B A (trE G A B P x) x = IN.teS G A B x (trE G A B P x) (IN.teTr G A B P x) ;
} ;
