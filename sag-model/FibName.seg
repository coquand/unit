-- The code of a small fibrant type reads it along each Yoneda point.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module Uv = FibUniv[a] ;
module PB = PosFull[a].PB ;
module P0 = PB.GPre[a].PS ;
open PB.GPre[a+].PS ;
module S = PB.CSmall ;
module W1 = V[a+] ;
module Y = PB.GYon[a] ;
module UU = Uv.UU ;
module FS = FibNameSub[a] ;
module FC = Uv.FC ;

restrict (G : PCtx) (A : FS.SmallFib G) (D : P0.PCtx) (s : S.XSub[D, G])
  : (B : P0.PTy[D]) * PB.CLine[a].Lines[D, B].Fib =
  (S.SmallFib[G, A.1, D, s].ElTy, S.SmallFib[G, A.1, D, s].fib A.2) ;

module Class (G : PCtx) (A : FS.SmallFib G) {
  module L = FibLocal[a, a+].Small[G, A.1] ;

  code (X : Ob) (x : W1.Ix (G.ob X)) : UU.U0 X = restrict G A (Y.yP X) L.At[X, x].s ;

  module Res (J I : Ob) (f : Hom J I) (x : W1.Ix (G.ob I)) {
    y : W1.Ix (G.ob J) = G.act J I f x ;
    r : S.XSub[Y.yP J, G] = S.xoS (Y.yP J) (Y.yP I) G L.At[I, x].s (Y.yH J I f) ;

    base : Id (S.XSub[Y.yP J, G]) r L.At[J, y].s =
      S.xs-ext (Y.yP J) G r L.At[J, y].s (\ W g -> G.act-o W J I f g x) ;

    nat : Id (UU.U0 J) (UU.uAct J I f (code I x)) (code J y) =
      transH (PB.CSmallSub.SS[G, A.1, Y.yP I, Y.yP J, L.At[I, x].s, Y.yH J I f, A.2].law)
        (apH (restrict G A (Y.yP J)) base) ;
    opaque nat ;
  } ;

  name : PEl[G, (Uv.Cod G).1] = mkPEl G (Uv.Cod G).1 code
    (\ J I f x y e -> transH Res[J, I, f, x].nat (apH (code J) e)) ;

  map : PSub[G, UU.UCtx] = Uv.clMap G name ;
} ;

name (G : PCtx) (A : FS.SmallFib G) : PEl[G, (Uv.Cod G).1] = Class[G, A].name ;

module Nat (D G : PCtx) (A : FS.SmallFib G) (s : PSub[D, G]) {
  B : FS.SmallFib D = FS.sub D G A s ;
  module DG = Class[G, A] ;
  module DD = Class[D, B] ;

  module At (X : Ob) (x : W1.Ix (D.ob X)) {
    E : P0.PCtx = Y.yP X ;
    r : S.XSub[E, G] = FS.xcomp E D G s DD.L.At[X, x].s ;
    t : S.XSub[E, G] = DG.L.At[X, s.nt X x].s ;

    base : Id (S.XSub[E, G]) r t =
      S.xs-ext E G r t (\ W f -> s.nt-nat W X f x) ;

    code-nat : Id (UU.U0 X) (DD.code X x) (DG.code X (s.nt X x)) =
      transH FS.Mixed[E, D, G, A, s, DD.L.At[X, x].s].law
        (apH (restrict G A E) base) ;
    opaque code-nat ;
  } ;

  law : Id (PEl[D, (Uv.Cod D).1]) (Uv.DU.subU D G DG.name s) DD.name =
    el-ext D (Uv.Cod D).1 (Uv.DU.subU D G DG.name s) DD.name (\ X x ->
      symH (transH At[X, x].code-nat (Uv.subU-pt D G DG.name s X x))) ;
  opaque law ;
} ;

name-nat (D G : PCtx) (A : FS.SmallFib G) (s : PSub[D, G])
  : Id (PEl[D, (Uv.Cod D).1]) (Uv.DU.subU D G (name G A) s) (name D (FS.sub D G A s)) =
  Nat[D, G, A, s].law ;

ElSmall : FS.SmallFib UU.UCtx = (UU.El, CPosEl4[a].elFib) ;

decodeSmall (G : PCtx) (c : PEl[G, (Uv.Cod G).1]) : FS.SmallFib G =
  FS.sub G UU.UCtx ElSmall (Uv.clMap G c) ;

large-dec (G : PCtx) (c : PEl[G, (Uv.Cod G).1]) : Id (FC.STy G) (FS.large G (decodeSmall G c)) (Uv.Dec G c) =
  refl (Uv.Dec G c) ;
