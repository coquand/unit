-- PosIdYFib.seg (M1, step 3): the fibration of the Yoneda Id is natural.
-- For s : D -> G, the structured type (Id(a , b) , fib)[s] is
-- (Id(a[s] , b[s]) , fib), as an equality of structured types (FibCwF.FC).
--
-- Informal text.
-- (1) Core's Id: its fibration over D (from the substituted fibration of A)
--     is the move of its fibration over G along the cart of CIdCart: CPathNat
--     for the path compositions, then CIdNat in each direction.
-- (2) The Yoneda fibration is core's moved along the iso (PosIdY (4)).  So
--     both sides are moves of core's fibration over G along two composite
--     carts Id(a[s] , b[s]) -> core Id(a , b) over s:
--       left   transport along IdT-nat, the substitution cart, the iso at G;
--       right  the iso at D, then the cart of CIdCart.
--     Both send (x , w) to (s x , the readings of w, its sieve): the left
--     one by the reading lemma for the transport (bk-rd), the right one by
--     definition.  So the composites agree (CCartLaws2.CG.congFib), and each
--     composite move is the move along the composite (compFib).
-- (3) With MoveNat (FibCwF): (Id[s] , fib[s]) = (Id' , K fib), and (2).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;

module FibNat (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (a0 b0 : PEl[G, A]) (fA : CL.Lines[G, A].Fib) {
  module N = PosIdY[a, l].IdYNat[D, G, s, A, a0, b0] ;
  module YG = N.YG ;
  module YD = N.YD ;
  A' : PTy[D] = subTy D G A s ;
  fA' : CL.Lines[D, A'].Fib = FibClL[a, l].clSub D G s A fA ;

  ----------------------------------------------------------------------
  -- (1) core's Id

  module IC = PB.CIdCart[l].IdCart[D, G, s, A, a0, b0] ;
  module PN = PB.CPathNat[l].PathNat[D, G, s, A, a0, b0, fA] ;
  module N1 = PB.CIdNat[l].IdNatC[D, G, s, A, a0, b0, e0, e1, PN.F.1, PosId[a, l].dc] ;
  module N2 = PB.CIdNat[l].IdNatC[D, G, s, A, a0, b0, e1, e0, PN.F.2, PosId[a, l].dc] ;

  coreG : CL.Lines[G, IC.IdT].Fib = PB.CIdFib[l].IdFib[G, A, a0, b0].fib fA PosId[a, l].dc ;
  coreD : CL.Lines[D, IC.IdT'].Fib = PB.CIdFib[l].IdFib[D, A', subEl D G A a0 s, subEl D G A b0 s].fib fA' PosId[a, l].dc ;

  cnat : Id (CL.Lines[D, IC.IdT'].Fib) coreD (IC.C.moveFib coreG) =
    transH {CL.Lines[D, IC.IdT'].Fib} {coreD} {(N1.I'.comp, N2.I'.comp)} {IC.C.moveFib coreG}
      (apH {CL.Lines[D, IC.PF'.PathT].Fib} {CL.Lines[D, IC.IdT'].Fib}
         (\ F' -> (PB.CIdFib[l].IF[D, D, IC.PC.A', IC.PF'.s, IC.PF'.sN, IC.PF'.PE.aE, IC.PF'.PE.bE, IC.PF'.PE.aE-act, IC.PF'.PE.bE-act,
                     e0, e1, F'.1, PosId[a, l].dc].comp,
                   PB.CIdFib[l].IF[D, D, IC.PC.A', IC.PF'.s, IC.PF'.sN, IC.PF'.PE.aE, IC.PF'.PE.bE, IC.PF'.PE.aE-act, IC.PF'.PE.bE-act,
                     e1, e0, F'.2, PosId[a, l].dc].comp)) PN.nat)
      (transH {CL.Lines[D, IC.IdT'].Fib} {(N1.I'.comp, N2.I'.comp)} {((IC.C.moveFib coreG).1, N2.I'.comp)} {IC.C.moveFib coreG}
         (apH (\ c -> (c, N2.I'.comp)) N1.nat)
         (apH (\ c -> ((IC.C.moveFib coreG).1, c)) N2.nat)) ;

  ----------------------------------------------------------------------
  -- (2) the two composite carts

  module SE = PB.CSub[l].SubE[D, G, s, YG.IdYT] ;
  module TR = PB.CTrFib[l].TR[D, subTy D G YG.IdYT s] ;

  -- transport along IdT-nat, then the substitution cart
  ta2 (W : Ob) (v : YD.TY.EI W) : YG.TY.EI W = SE.mV W (TR.ta YD.IdYT N.nat W v) ;

  tanat2 (V W : Ob) (g : Hom V W) (v : YD.TY.EI W) : Id (YG.TY.EI V) (YG.TY.E.act V W g (ta2 W v)) (ta2 V (YD.TY.E.act V W g v)) =
    transH (SE.mV-nat V W g (TR.ta YD.IdYT N.nat W v)) (apH (SE.mV V) (TR.tanat YD.IdYT N.nat V W g v)) ;

  tainj2 (W : Ob) (v v' : YD.TY.EI W) (P : Id (W0.Ix (D.ob W)) (YD.TY.pr1 W v) (YD.TY.pr1 W v')) (Q : Id (YG.TY.EI W) (ta2 W v) (ta2 W v'))
    : Id (YD.TY.EI W) v v' =
    TR.tainj YD.IdYT N.nat W v v' P (SE.mV-inj W (TR.ta YD.IdYT N.nat W v) (TR.ta YD.IdYT N.nat W v') P Q) ;

  bk2 (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (YG.tob X (s.nt X x))) : W0.Ix (YD.tob X x) = TR.fwV YD.IdYT N.nat X x u ;

  bkta2 (X : Ob) (x : W0.Ix (D.ob X)) (u : W0.Ix (YG.tob X (s.nt X x)))
    : Id (YG.TY.EI X) (ta2 X (YD.TY.pr X x (bk2 X x u))) (YG.TY.pr X (s.nt X x) u) =
    apH (SE.mV X) (TR.bkta YD.IdYT N.nat X x u) ;

  module MN = FibCwF[a, l].MoveNat[D, G, s, YG.IdYT, YD.IdYT, N.nat, ta2, \ W v -> refl (s.nt W (YD.TY.pr1 W v)), tanat2, tainj2, bk2, bkta2,
    \ W v -> refl (ta2 W v)] ;

  -- left: K, then the iso at G
  module R2 = PB.CCartLaws2[l, l, l].CC[D, YD.IdYT, G, YG.IdYT, G, IC.IdT,
    s.nt, s.nt-nat, ta2, \ W v -> refl (s.nt W (YD.TY.pr1 W v)), tanat2, tainj2, bk2, bkta2,
    \ W x -> x, \ V W g x -> refl (G.act V W g x), YG.ta, \ W v -> refl (YG.TY.pr1 W v), YG.tanat, YG.tainj, YG.bk, YG.bkta] ;

  -- right: the iso at D, then the cart of CIdCart
  module R1 = PB.CCartLaws2[l, l, l].CC[D, YD.IdYT, D, IC.IdT', G, IC.IdT,
    \ W x -> x, \ V W g x -> refl (D.act V W g x), YD.ta, \ W v -> refl (YD.TY.pr1 W v), YD.tanat, YD.tainj, YD.bk, YD.bkta,
    s.nt, s.nt-nat, IC.taI, \ W v -> refl (s.nt W (IC.TI'.pr1 W v)), IC.tanatI, IC.tainjI, IC.bkI, IC.bktaI] ;

  -- they agree: the same point, readings and sieve
  Pta (W : Ob) (v : YD.TY.EI W) : Id (YG.TI.EI W) (R2.ta W v) (R1.ta W v) =
    YG.IO.tpI-ext W (R2.ta W v) (R1.ta W v) (refl (s.nt W (YD.TY.pr1 W v)))
      (\ V g j -> transH (apH (\ u -> YG.rd W (s.nt W (YD.TY.pr1 W v)) u V g j)
                            (TR.tr-pw YD.IdYT N.nat W (YD.TY.pr1 W v) (N.Q0 W (YD.TY.pr1 W v)) (YD.TY.pr2 W v)))
                    (N.bk-rd W (YD.TY.pr1 W v) (YD.TY.pr2 W v) V g j))
      (transH (apH (\ u -> u.2.1) (TR.tr-pw YD.IdYT N.nat W (YD.TY.pr1 W v) (N.Q0 W (YD.TY.pr1 W v)) (YD.TY.pr2 W v)))
              (N.bk-sq W (YD.TY.pr1 W v) (YD.TY.pr2 W v))) ;

  module CGm = PB.CCartLaws2[l, l, l].CG[D, YD.IdYT, G, IC.IdT,
    R2.s, R2.s-nat, R2.ta, R2.tapt, R2.tanat, R2.tainj, R2.bk, R2.bkta,
    R1.s, R1.s-nat, R1.ta, R1.tapt, R1.tanat, R1.tainj, R1.bk, R1.bkta,
    \ W x -> refl (s.nt W x), Pta] ;

  fibNat : Id (CL.Lines[D, YD.IdYT].Fib) (MN.K.moveFib (YG.fib fA)) (YD.fib fA') =
    calc (CL.Lines[D, YD.IdYT].Fib) {
        MN.K.moveFib (YG.C.moveFib coreG)
      =< R2.compFib coreG >
        R2.C12.moveFib coreG
      =< CGm.congFib coreG >
        R1.C12.moveFib coreG
      =< symH (R1.compFib coreG) >
        YD.C.moveFib (IC.C.moveFib coreG)
      =< symH (apH YD.C.moveFib cnat) >
        YD.C.moveFib coreD } ;

  ----------------------------------------------------------------------
  -- (3) the structured type

  law : Id (FibCwF[a, l].FC.STy D) (FibCwF[a, l].FC.subS D G (YG.IdYT, YG.fib fA) s) (YD.IdYT, YD.fib fA') =
    transH (MN.law (YG.fib fA)) (apH {CL.Lines[D, YD.IdYT].Fib} {FibCwF[a, l].FC.STy D} (\ z -> (YD.IdYT, z)) fibNat) ;
} ;
