-- CwFOv.seg (M1 step 3, S1 part 1): stability of composite types and
-- elements in a CwF with Pi, Sigma and Swan Id (CwFId), stated with
-- arbitrary type paths.
--
-- For s : D -> G, a type A over G and a path PA : A[s] = A' the map
-- upT s PA : D.A' -> G.A is lift s transported along PA.  An element a of A
-- is OVER a' of A' (along s, w.r.t. PA) when a[s] transported along PA is
-- a'.  Every lemma below takes the target data (A', a', ...) with the
-- paths as arguments, so composite statements are applications, and each
-- is proved by J on those paths, which reduces it to a law of the CwF at
-- PA = refl (where upT s PA is lift s).  Types form a set, so an over-path
-- holds w.r.t. any type path once it holds w.r.t. one (ovRe); the
-- conclusions are stated for any path.
--
-- Informal text.
-- (1) trSame: two transports into one type T of x and y agree when y is a
--     transport of x (types form a set).  sq: b[s1][s2] and b[t1][t2],
--     transported to one T, agree when s1 s2 = t1 t2 (subt-o, subtEq).
-- (2) Pi, Sigma, Id are stable: Pi-nat, Sig-nat, IdT-nat, then a path of
--     arguments.  Weakening is stable: p-lift-T, wk-lift, q-lift.
-- (3) Functions.  Fun A B = Pi A (B p); app f a = (bod f)[sec a], read in
--     B by p-sec-T.  bodNat: the body of f[s] (read in Pi along any path)
--     is (bod f)[lift s], from Pi-iso-nat and the iso laws.  app-nat: both
--     sides are transports of (bod f)[lift s][sec a[s]] (sq at sec-o).

open Base ;

module Ov (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  module SI = CwFId.SwanId[l, C] ;
  module DI = SI.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;

  ----------------------------------------------------------------------
  -- (1) transports of elements along type paths

  trE (G : Ctx) (A A' : Ty G) (P : Id (Ty G) A A') (a : El G A) : El G A' =
    subst (Ty G) (El G) A A' P a ;

  trE-irr (G : Ctx) (A A' : Ty G) (P P' : Id (Ty G) A A') (a : El G A)
    : Id (El G A') (trE G A A' P a) (trE G A A' P' a) =
    ap (Id (Ty G) A A') (El G A') (\ R -> trE G A A' R a) P P' (isSetTy G A A' P P') ;

  trE-tr (G : Ctx) (A A2 A3 : Ty G) (P : Id (Ty G) A A2) (Q : Id (Ty G) A2 A3) (a : El G A)
    : Id (El G A3) (trE G A2 A3 Q (trE G A A2 P a)) (trE G A A3 (trans (Ty G) A A2 A3 P Q) a) =
    sym (El G A3) (trE G A A3 (trans (Ty G) A A2 A3 P Q) a) (trE G A2 A3 Q (trE G A A2 P a))
      (SI.substTr (Ty G) (El G) A A2 A3 P Q a) ;

  -- x and y transported to T agree when y is a transport of x
  trSame (G : Ctx) (X Y T : Ty G) (P : Id (Ty G) X T) (Q : Id (Ty G) Y T) (R : Id (Ty G) X Y)
    (x : El G X) (y : El G Y) (e : Id (El G Y) (trE G X Y R x) y)
    : Id (El G T) (trE G X T P x) (trE G Y T Q y) =
    idJ (El G Y) (trE G X Y R x) (\ y2 e2 -> Id (El G T) (trE G X T P x) (trE G Y T Q y2))
      (trans (El G T) (trE G X T P x) (trE G X T (trans (Ty G) X Y T R Q) x) (trE G Y T Q (trE G X Y R x))
         (trE-irr G X T P (trans (Ty G) X Y T R Q) x)
         (sym (El G T) (trE G Y T Q (trE G X Y R x)) (trE G X T (trans (Ty G) X Y T R Q) x) (trE-tr G X Y T R Q x)))
      y e ;

  -- substitution of a transported element
  subt-tr (D G : Ctx) (A A' : Ty G) (P : Id (Ty G) A A') (a : El G A) (s : Sub D G)
    : Id (El D (subT D G A' s)) (subt D G A' (trE G A A' P a) s)
         (trE D (subT D G A s) (subT D G A' s) (ap (Ty G) (Ty D) (\ X -> subT D G X s) A A' P) (subt D G A a s)) =
    idJ (Ty G) A
      (\ X P2 -> Id (El D (subT D G X s)) (subt D G X (trE G A X P2 a) s)
                    (trE D (subT D G A s) (subT D G X s) (ap (Ty G) (Ty D) (\ Y -> subT D G Y s) A X P2) (subt D G A a s)))
      (refl (subt D G A a s)) A' P ;

  -- two composite substitutions with the same composite
  sq (E G M N : Ctx) (B : Ty G) (b : El G B) (s1 : Sub M G) (s2 : Sub E M) (t1 : Sub N G) (t2 : Sub E N)
    (e : Id (Sub E G) (o E M G s1 s2) (o E N G t1 t2)) (T : Ty E)
    (P : Id (Ty E) (subT E M (subT M G B s1) s2) T) (Q : Id (Ty E) (subT E N (subT N G B t1) t2) T)
    : Id (El E T) (trE E (subT E M (subT M G B s1) s2) T P (subt E M (subT M G B s1) (subt M G B b s1) s2))
                  (trE E (subT E N (subT N G B t1) t2) T Q (subt E N (subT N G B t1) (subt N G B b t1) t2)) =
    trans (El E T) (trE E X1 T P x1) (trE E S1 T (trans (Ty E) S1 X1 T O1 P) (subt E G B b (o E M G s1 s2))) (trE E X2 T Q x2)
      (sym (El E T) (trE E S1 T (trans (Ty E) S1 X1 T O1 P) (subt E G B b (o E M G s1 s2))) (trE E X1 T P x1)
         (trSame E S1 X1 T (trans (Ty E) S1 X1 T O1 P) P O1 (subt E G B b (o E M G s1 s2)) x1 (subt-o E M G B b s1 s2)))
      (trans (El E T) (trE E S1 T (trans (Ty E) S1 X1 T O1 P) (subt E G B b (o E M G s1 s2)))
                      (trE E S2 T (trans (Ty E) S2 X2 T O2 Q) (subt E G B b (o E N G t1 t2))) (trE E X2 T Q x2)
         (SI.subtEq E G B b (o E M G s1 s2) (o E N G t1 t2) e T (trans (Ty E) S1 X1 T O1 P) (trans (Ty E) S2 X2 T O2 Q))
         (trSame E S2 X2 T (trans (Ty E) S2 X2 T O2 Q) Q O2 (subt E G B b (o E N G t1 t2)) x2 (subt-o E N G B b t1 t2)))
   where {
    X1 : Ty E = subT E M (subT M G B s1) s2 ;
    X2 : Ty E = subT E N (subT N G B t1) t2 ;
    S1 : Ty E = subT E G B (o E M G s1 s2) ;
    S2 : Ty E = subT E G B (o E N G t1 t2) ;
    O1 : Id (Ty E) S1 X1 = subT-o E M G B s1 s2 ;
    O2 : Id (Ty E) S2 X2 = subT-o E N G B t1 t2 ;
    x1 : El E X1 = subt E M (subT M G B s1) (subt M G B b s1) s2 ;
    x2 : El E X2 = subt E N (subT N G B t1) (subt N G B b t1) t2 ;
   } ;

  ----------------------------------------------------------------------
  -- (2) the map over s along a type path, and over-paths

  upT (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') : Sub (ext D A') (ext G A) =
    subst (Ty D) (\ X -> Sub (ext D X) (ext G A)) (subT D G A s) A' PA (lift D G A s) ;

  Ov (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A') (a : El G A) (a' : El D A') : U l =
    Id (El D A') (trE D (subT D G A s) A' PA (subt D G A a s)) a' ;

  ovRe (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA PA2 : Id (Ty D) (subT D G A s) A') (a : El G A) (a' : El D A')
    (e : Ov D G A s A' PA a a') : Ov D G A s A' PA2 a a' =
    trans (El D A') (trE D (subT D G A s) A' PA2 (subt D G A a s)) (trE D (subT D G A s) A' PA (subt D G A a s)) a'
      (trE-irr D (subT D G A s) A' PA2 PA (subt D G A a s)) e ;

  -- an over-path survives transports on both sides
  ovTr (D G : Ctx) (A A2 : Ty G) (R : Id (Ty G) A A2) (s : Sub D G) (A' A2' : Ty D) (R' : Id (Ty D) A' A2')
    (PA : Id (Ty D) (subT D G A s) A') (PA2 : Id (Ty D) (subT D G A2 s) A2') (a : El G A) (a' : El D A')
    (e : Ov D G A s A' PA a a') : Ov D G A2 s A2' PA2 (trE G A A2 R a) (trE D A' A2' R' a') =
    idJ (Ty G) A
      (\ X RX -> (PX : Id (Ty D) (subT D G X s) A2') -> Ov D G X s A2' PX (trE G A X RX a) (trE D A' A2' R' a'))
      (idJ (Ty D) A'
         (\ Y RY -> (PY : Id (Ty D) (subT D G A s) Y) -> Ov D G A s Y PY a (trE D A' Y RY a'))
         (\ PY -> ovRe D G A s A' PA PY a a' e) A2' R')
      A2 R PA2 ;

  ----------------------------------------------------------------------
  -- (2) Pi, Sigma, Id

  Pi-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D A' B') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
                  -> Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D X B2))
      (\ B2 PB2 ->
         trans (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)))
                      (PS.Pi D (subT D G A s) B2)
           (PS.Pi-nat D G A B s)
           (ap (Ty (ext D (subT D G A s))) (Ty D) (\ Y -> PS.Pi D (subT D G A s) Y)
               (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) B2 PB2))
      A' PA B' PB ;

  Sig-ov (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty (ext D A')) (PB : Id (Ty (ext D A')) (subT (ext D A') (ext G A) B (upT D G A s A' PA)) B')
    : Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D A' B') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (B2 : Ty (ext D X)) -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) B (upT D G A s X PX)) B2
                  -> Id (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D X B2))
      (\ B2 PB2 ->
         trans (Ty D) (subT D G (SS.Sig G A B) s) (SS.Sig D (subT D G A s) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)))
                      (SS.Sig D (subT D G A s) B2)
           (SS.Sig-nat D G A B s)
           (ap (Ty (ext D (subT D G A s))) (Ty D) (\ Y -> SS.Sig D (subT D G A s) Y)
               (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) B2 PB2))
      A' PA B' PB ;

  Id-ov (D G : Ctx) (A : Ty G) (a b : El G A) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (a' b' : El D A') (Pa : Ov D G A s A' PA a a') (Pb : Ov D G A s A' PA b b')
    : Id (Ty D) (subT D G (IJ.IdT G A a b) s) (IJ.IdT D A' a' b') =
    trans (Ty D) (subT D G (IJ.IdT G A a b) s) (IJ.IdT D (subT D G A s) (subt D G A a s) (subt D G A b s)) (IJ.IdT D A' a' b')
      (IJ.IdT-nat D G A a b s)
      (DI.idCong D (subT D G A s) A' PA (subt D G A a s) (subt D G A b s) a' b' Pa Pb) ;

  ----------------------------------------------------------------------
  -- (2) weakening

  wkT (G : Ctx) (A B : Ty G) : Ty (ext G A) = subT (ext G A) G B (p G A) ;
  wkE (G : Ctx) (A B : Ty G) (b : El G B) : El (ext G A) (wkT G A B) = subt (ext G A) G B b (p G A) ;

  wkT-ov (D G : Ctx) (A B : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    : Id (Ty (ext D A')) (subT (ext D A') (ext G A) (wkT G A B) (upT D G A s A' PA)) (wkT D A' B') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> Id (Ty (ext D X)) (subT (ext D X) (ext G A) (wkT G A B) (upT D G A s X PX)) (wkT D X B'))
      (idJ (Ty D) (subT D G B s)
         (\ Y PY -> Id (Ty (ext D (subT D G A s))) (subT (ext D (subT D G A s)) (ext G A) (wkT G A B) (lift D G A s))
                       (wkT D (subT D G A s) Y))
         (p-lift-T D G A B s) B' PB)
      A' PA ;

  wkE-ov (D G : Ctx) (A B : Ty G) (b : El G B) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B') (b' : El D B') (Pb : Ov D G B s B' PB b b')
    (PW : Id (Ty (ext D A')) (subT (ext D A') (ext G A) (wkT G A B) (upT D G A s A' PA)) (wkT D A' B'))
    : Ov (ext D A') (ext G A) (wkT G A B) (upT D G A s A' PA) (wkT D A' B') PW (wkE G A B b) (wkE D A' B' b') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (PW2 : Id (Ty (ext D X)) (subT (ext D X) (ext G A) (wkT G A B) (upT D G A s X PX)) (wkT D X B'))
                 -> Ov (ext D X) (ext G A) (wkT G A B) (upT D G A s X PX) (wkT D X B') PW2 (wkE G A B b) (wkE D X B' b'))
      (idJ (Ty D) (subT D G B s)
         (\ Y PY -> (b2 : El D Y) -> Ov D G B s Y PY b b2
             -> (PW2 : Id (Ty E) (subT E (ext G A) (wkT G A B) (lift D G A s)) (wkT D (subT D G A s) Y))
             -> Ov E (ext G A) (wkT G A B) (lift D G A s) (wkT D (subT D G A s) Y) PW2 (wkE G A B b) (wkE D (subT D G A s) Y b2))
         (\ b2 Pb2 ->
            idJ (El D (subT D G B s)) (subt D G B b s)
              (\ b3 e3 -> (PW2 : Id (Ty E) (subT E (ext G A) (wkT G A B) (lift D G A s)) (wkT D (subT D G A s) (subT D G B s)))
                 -> Ov E (ext G A) (wkT G A B) (lift D G A s) (wkT D (subT D G A s) (subT D G B s)) PW2 (wkE G A B b)
                       (wkE D (subT D G A s) (subT D G B s) b3))
              (\ PW2 -> ovRe E (ext G A) (wkT G A B) (lift D G A s) (wkT D (subT D G A s) (subT D G B s)) (p-lift-T D G A B s) PW2
                          (wkE G A B b) (wkE D (subT D G A s) (subT D G B s) (subt D G B b s)) (SI.wk-lift D G A B b s))
              b2 Pb2)
         B' PB b' Pb)
      A' PA PW
   where { E : Ctx = ext D (subT D G A s) ; } ;

  q-ov (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (PW : Id (Ty (ext D A')) (subT (ext D A') (ext G A) (wkT G A A) (upT D G A s A' PA)) (wkT D A' A'))
    : Ov (ext D A') (ext G A) (wkT G A A) (upT D G A s A' PA) (wkT D A' A') PW (q G A) (q D A') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (PW2 : Id (Ty (ext D X)) (subT (ext D X) (ext G A) (wkT G A A) (upT D G A s X PX)) (wkT D X X))
                 -> Ov (ext D X) (ext G A) (wkT G A A) (upT D G A s X PX) (wkT D X X) PW2 (q G A) (q D X))
      (\ PW2 -> ovRe (ext D (subT D G A s)) (ext G A) (wkT G A A) (lift D G A s) (wkT D (subT D G A s) (subT D G A s))
                     (p-lift-T D G A A s) PW2 (q G A) (q D (subT D G A s)) (q-lift D G A s))
      A' PA PW ;

  ----------------------------------------------------------------------
  -- (3) functions

  Fun (G : Ctx) (A B : Ty G) : Ty G = PS.Pi G A (wkT G A B) ;
  bod (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El G (PS.Pi G A B)) : El (ext G A) B = (PS.Pi-iso G A B).fun f ;
  lam (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (b : El (ext G A) B) : El G (PS.Pi G A B) = (PS.Pi-iso G A B).inv b ;

  app (G : Ctx) (A B : Ty G) (f : El G (Fun G A B)) (a : El G A) : El G B =
    trE G (subT G (ext G A) (wkT G A B) (sec G A a)) B (p-sec-T G A B a)
      (subt G (ext G A) (wkT G A B) (bod G A (wkT G A B) f) (sec G A a)) ;

  Fun-ov (D G : Ctx) (A B : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B') =
    Pi-ov D G A (wkT G A B) s A' PA (wkT D A' B') (wkT-ov D G A B s A' PA B' PB) ;

  -- lam commutes with a transport of the codomain
  lamTr (G : Ctx) (A : Ty G) (B B' : Ty (ext G A)) (Q : Id (Ty (ext G A)) B B') (b : El (ext G A) B)
    : Id (El G (PS.Pi G A B'))
         (trE G (PS.Pi G A B) (PS.Pi G A B') (ap (Ty (ext G A)) (Ty G) (\ Y -> PS.Pi G A Y) B B' Q) (lam G A B b))
         (lam G A B' (trE (ext G A) B B' Q b)) =
    idJ (Ty (ext G A)) B
      (\ Y QY -> Id (El G (PS.Pi G A Y))
                    (trE G (PS.Pi G A B) (PS.Pi G A Y) (ap (Ty (ext G A)) (Ty G) (\ Y2 -> PS.Pi G A Y2) B Y QY) (lam G A B b))
                    (lam G A Y (trE (ext G A) B Y QY b)))
      (refl (lam G A B b)) B' Q ;

  -- the body of f[s], read in a Pi type along any path, is (bod f)[lift s]
  bodNat (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s : Sub D G) (B' : Ty (ext D (subT D G A s)))
    (Q : Id (Ty (ext D (subT D G A s))) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) B')
    (F : Id (Ty D) (subT D G (PS.Pi G A B) s) (PS.Pi D (subT D G A s) B')) (f : El G (PS.Pi G A B))
    : Id (El (ext D (subT D G A s)) B')
         (bod D (subT D G A s) B' (trE D (subT D G (PS.Pi G A B) s) (PS.Pi D (subT D G A s) B') F (subt D G (PS.Pi G A B) f s)))
         (trE (ext D (subT D G A s)) (subT (ext D (subT D G A s)) (ext G A) B (lift D G A s)) B' Q
            (subt (ext D (subT D G A s)) (ext G A) B (bod G A B f) (lift D G A s))) =
    calc (El E B') {
        bod D As B' (trE D PiG PiB' F fs)
      =< ap (El D PiB') (El E B') (\ v -> bod D As B' v) (trE D PiG PiB' F fs) (trE D PiL PiB' QP (trE D PiG PiL N fs)) step1 >
        bod D As B' (trE D PiL PiB' QP (trE D PiG PiL N fs))
      =< ap (El D PiL) (El E B') (\ v -> bod D As B' (trE D PiL PiB' QP v)) (trE D PiG PiL N fs) (lam D As BL Y) step2 >
        bod D As B' (trE D PiL PiB' QP (lam D As BL Y))
      =< ap (El D PiB') (El E B') (\ v -> bod D As B' v) (trE D PiL PiB' QP (lam D As BL Y)) (lam D As B' (trE E BL B' Q Y))
            (lamTr D As BL B' Q Y) >
        bod D As B' (lam D As B' (trE E BL B' Q Y))
      =< (PS.Pi-iso D As B').fun-inv (trE E BL B' Q Y) >
        trE E BL B' Q Y }
   where {
    As : Ty D = subT D G A s ;
    E : Ctx = ext D As ;
    BL : Ty E = subT E (ext G A) B (lift D G A s) ;
    PiG : Ty D = subT D G (PS.Pi G A B) s ;
    PiL : Ty D = PS.Pi D As BL ;
    PiB' : Ty D = PS.Pi D As B' ;
    N : Id (Ty D) PiG PiL = PS.Pi-nat D G A B s ;
    QP : Id (Ty D) PiL PiB' = ap (Ty E) (Ty D) (\ Y2 -> PS.Pi D As Y2) BL B' Q ;
    fs : El D PiG = subt D G (PS.Pi G A B) f s ;
    Y : El E BL = subt E (ext G A) B (bod G A B f) (lift D G A s) ;
    step1 : Id (El D PiB') (trE D PiG PiB' F fs) (trE D PiL PiB' QP (trE D PiG PiL N fs)) =
      trans (El D PiB') (trE D PiG PiB' F fs) (trE D PiG PiB' (trans (Ty D) PiG PiL PiB' N QP) fs) (trE D PiL PiB' QP (trE D PiG PiL N fs))
        (trE-irr D PiG PiB' F (trans (Ty D) PiG PiL PiB' N QP) fs)
        (sym (El D PiB') (trE D PiL PiB' QP (trE D PiG PiL N fs)) (trE D PiG PiB' (trans (Ty D) PiG PiL PiB' N QP) fs)
           (trE-tr D PiG PiL PiB' N QP fs)) ;
    step2 : Id (El D PiL) (trE D PiG PiL N fs) (lam D As BL Y) =
      trans (El D PiL) (trE D PiG PiL N fs) (trE D PiG PiL N (subt D G (PS.Pi G A B) (lam G A B (bod G A B f)) s)) (lam D As BL Y)
        (ap (El G (PS.Pi G A B)) (El D PiL) (\ v -> trE D PiG PiL N (subt D G (PS.Pi G A B) v s)) f (lam G A B (bod G A B f))
            (sym (El G (PS.Pi G A B)) (lam G A B (bod G A B f)) f ((PS.Pi-iso G A B).inv-fun f)))
        (PS.Pi-iso-nat D G A B (bod G A B f) s) ;
   } ;

  -- application is stable: both sides are transports of (bod f)[lift s][sec a[s]]
  app-nat (D G : Ctx) (A B : Ty G) (s : Sub D G)
    (F : Id (Ty D) (subT D G (Fun G A B) s) (Fun D (subT D G A s) (subT D G B s))) (f : El G (Fun G A B)) (a : El G A)
    : Id (El D (subT D G B s)) (subt D G B (app G A B f a) s)
         (app D (subT D G A s) (subT D G B s) (trE D (subT D G (Fun G A B) s) (Fun D (subT D G A s) (subT D G B s)) F (subt D G (Fun G A B) f s))
              (subt D G A a s)) =
    calc (El D Bs) {
        subt D G B (app G A B f a) s
      =< subt-tr D G X0 B (p-sec-T G A B a) (subt G (ext G A) WB bf (sec G A a)) s >
        trE D X1 Bs P1 (subt D G X0 (subt G (ext G A) WB bf (sec G A a)) s)
      =< sq D (ext G A) G E WB bf (sec G A a) s (lift D G A s) (sec D As as) (sec-o D G A a s) Bs P1 (trans (Ty D) X2 X3 Bs P2 S2) >
        trE D X2 Bs (trans (Ty D) X2 X3 Bs P2 S2) y2
      =< sym (El D Bs) (trE D X3 Bs S2 (trE D X2 X3 P2 y2)) (trE D X2 Bs (trans (Ty D) X2 X3 Bs P2 S2) y2) (trE-tr D X2 X3 Bs P2 S2 y2) >
        trE D X3 Bs S2 (trE D X2 X3 P2 y2)
      =< ap (El D X3) (El D Bs) (\ v -> trE D X3 Bs S2 v) (trE D X2 X3 P2 y2) (subt D E WBs (trE E BL WBs PL yL) (sec D As as))
            (sym (El D X3) (subt D E WBs (trE E BL WBs PL yL) (sec D As as)) (trE D X2 X3 P2 y2)
               (subt-tr D E BL WBs PL yL (sec D As as))) >
        trE D X3 Bs S2 (subt D E WBs (trE E BL WBs PL yL) (sec D As as))
      =< ap (El E WBs) (El D Bs) (\ v -> trE D X3 Bs S2 (subt D E WBs v (sec D As as))) (trE E BL WBs PL yL) (bod D As WBs fs)
            (sym (El E WBs) (bod D As WBs fs) (trE E BL WBs PL yL) (bodNat D G A WB s WBs PL F f)) >
        trE D X3 Bs S2 (subt D E WBs (bod D As WBs fs) (sec D As as)) }
   where {
    As : Ty D = subT D G A s ;
    Bs : Ty D = subT D G B s ;
    as : El D As = subt D G A a s ;
    E : Ctx = ext D As ;
    WB : Ty (ext G A) = wkT G A B ;
    WBs : Ty E = wkT D As Bs ;
    BL : Ty E = subT E (ext G A) WB (lift D G A s) ;
    bf : El (ext G A) WB = bod G A WB f ;
    fs : El D (Fun D As Bs) = trE D (subT D G (Fun G A B) s) (Fun D As Bs) F (subt D G (Fun G A B) f s) ;
    PL : Id (Ty E) BL WBs = p-lift-T D G A B s ;
    yL : El E BL = subt E (ext G A) WB bf (lift D G A s) ;
    X0 : Ty G = subT G (ext G A) WB (sec G A a) ;
    X1 : Ty D = subT D G X0 s ;
    X2 : Ty D = subT D E BL (sec D As as) ;
    X3 : Ty D = subT D E WBs (sec D As as) ;
    P1 : Id (Ty D) X1 Bs = ap (Ty G) (Ty D) (\ Y -> subT D G Y s) X0 B (p-sec-T G A B a) ;
    P2 : Id (Ty D) X2 X3 = ap (Ty E) (Ty D) (\ Y -> subT D E Y (sec D As as)) BL WBs PL ;
    S2 : Id (Ty D) X3 Bs = p-sec-T D As Bs as ;
    y2 : El D X2 = subt D E BL yL (sec D As as) ;
   } ;

  -- application at A[s] and any B'
  app-ov0 (D G : Ctx) (A B : Ty G) (s : Sub D G) (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B')
    (PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D (subT D G A s) B')) (f : El G (Fun G A B)) (a : El G A)
    : Ov D G B s B' PB (app G A B f a)
         (app D (subT D G A s) B' (trE D (subT D G (Fun G A B) s) (Fun D (subT D G A s) B') PF (subt D G (Fun G A B) f s)) (subt D G A a s)) =
    idJ (Ty D) (subT D G B s)
      (\ Y PY -> (PF2 : Id (Ty D) (subT D G (Fun G A B) s) (Fun D (subT D G A s) Y))
                 -> Ov D G B s Y PY (app G A B f a)
                       (app D (subT D G A s) Y (trE D (subT D G (Fun G A B) s) (Fun D (subT D G A s) Y) PF2 (subt D G (Fun G A B) f s))
                            (subt D G A a s)))
      (\ PF2 -> app-nat D G A B s PF2 f a) B' PB PF ;

  app-ov (D G : Ctx) (A B : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    (B' : Ty D) (PB : Id (Ty D) (subT D G B s) B') (PF : Id (Ty D) (subT D G (Fun G A B) s) (Fun D A' B'))
    (f : El G (Fun G A B)) (f' : El D (Fun D A' B')) (Pf : Ov D G (Fun G A B) s (Fun D A' B') PF f f')
    (a : El G A) (a' : El D A') (Pa : Ov D G A s A' PA a a')
    : Ov D G B s B' PB (app G A B f a) (app D A' B' f' a') =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> (PF2 : Id (Ty D) (subT D G (Fun G A B) s) (Fun D X B')) (f2 : El D (Fun D X B'))
                 -> Ov D G (Fun G A B) s (Fun D X B') PF2 f f2 -> (a2 : El D X) -> Ov D G A s X PX a a2
                 -> Ov D G B s B' PB (app G A B f a) (app D X B' f2 a2))
      (\ PF2 f2 Pf2 a2 Pa2 ->
         idJ (El D (subT D G A s)) (subt D G A a s)
           (\ a3 e3 -> Ov D G B s B' PB (app G A B f a) (app D (subT D G A s) B' f2 a3))
           (idJ (El D (Fun D (subT D G A s) B')) (trE D (subT D G (Fun G A B) s) (Fun D (subT D G A s) B') PF2 (subt D G (Fun G A B) f s))
              (\ f3 e4 -> Ov D G B s B' PB (app G A B f a) (app D (subT D G A s) B' f3 (subt D G A a s)))
              (app-ov0 D G A B s B' PB PF2 f a) f2 Pf2)
           a2 Pa2)
      A' PA PF f' Pf a' Pa ;
} ;
