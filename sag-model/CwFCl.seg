-- CwFCl.seg (M1, step 3): the CwF of structured types.  Given a CwF C and
-- a classifier Cl (a structure Cl G A on each type A over G, a set, with a
-- substitution clSub satisfying the two laws), the types A with a structure
-- c : Cl G A form again a CwF, with the same contexts, substitutions and
-- elements.  At B, C is the presheaf CwF and Cl = Fib: the fibrant types.
--
-- Informal text.  Types are pairs (A , c); substitution is (A[s] , c[s]);
-- the laws subT-id, subT-o are the laws of clSub.  Contexts, substitutions,
-- extension and elements are those of C, read at the first component.
-- Every other law of a CwF is an equation in C after a transport along a
-- path of types.  A transport in a family that depends on the first
-- component only is a transport along the path of first components (red),
-- and two paths of types of C are equal (types of C form a set).  So each
-- law is the law of C.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;

module ClCwF (C : CwF.CwF[l]) (Cl : (G : C.Ctx) -> C.Ty G -> U l)
  (isSet-Cl : (G : C.Ctx) (A : C.Ty G) -> isSet (Cl G A))
  (clSub : (D G : C.Ctx) (s : C.Sub D G) (A : C.Ty G) (c : Cl G A) -> Cl D (C.subT D G A s))
  (clSub-id : (G : C.Ctx) (A : C.Ty G) (c : Cl G A)
     -> Id ((A' : C.Ty G) * Cl G A') (A, c) (C.subT G G A (C.id G), clSub G G (C.id G) A c))
  (clSub-o : (T D G : C.Ctx) (s : C.Sub D G) (s' : C.Sub T D) (A : C.Ty G) (c : Cl G A)
     -> Id ((A' : C.Ty T) * Cl T A') (C.subT T G A (C.o T D G s s'), clSub T G (C.o T D G s s') A c)
                                     (C.subT T D (C.subT D G A s) s', clSub T D s' (C.subT D G A s) (clSub D G s A c))) {

  -- the structured types
  STy (G : C.Ctx) : U l = (A : C.Ty G) * Cl G A ;

  subS (D G : C.Ctx) (A : STy G) (s : C.Sub D G) : STy D = (C.subT D G A.1 s, clSub D G s A.1 A.2) ;

  -- a transport in a family of the first component is one along any path
  -- of the first components
  red (G : C.Ctx) (F : C.Ty G -> U l) (X Y : STy G) (P : Id (STy G) X Y) (P0 : Id (C.Ty G) X.1 Y.1) (u : F X.1)
    : Id (F Y.1) (subst (STy G) (\ Z -> F Z.1) X Y P u) (subst (C.Ty G) F X.1 Y.1 P0 u) =
    idJ (STy G) X
      (\ Z Q -> (Q0 : Id (C.Ty G) X.1 Z.1)
         -> Id (F Z.1) (subst (STy G) (\ W -> F W.1) X Z Q u) (subst (C.Ty G) F X.1 Z.1 Q0 u))
      (\ Q0 -> ap (Id (C.Ty G) X.1 X.1) (F X.1) (\ R -> subst (C.Ty G) F X.1 X.1 R u)
                  (refl X.1) Q0 (C.isSetTy G X.1 X.1 (refl X.1) Q0))
      Y P P0 ;

  subS-id (G : C.Ctx) (A : STy G) : Id (STy G) (subS G G A (C.id G)) A =
    sym (STy G) A (subS G G A (C.id G)) (clSub-id G A.1 A.2) ;

  subS-o (T D G : C.Ctx) (A : STy G) (s : C.Sub D G) (s' : C.Sub T D)
    : Id (STy T) (subS T G A (C.o T D G s s')) (subS T D (subS D G A s) s') = clSub-o T D G s s' A.1 A.2 ;

  -- the derived paths p-lift-T, p-sec-T of the CwF below, stated here
  -- because the fields q-lift, q-sec are transported along them (the same
  -- terms as in CwF.CwF, at subS)
  pLiftT (D G : C.Ctx) (A B : STy G) (s : C.Sub D G)
    : Id (STy (C.ext D (C.subT D G A.1 s)))
         (subS (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) (subS (C.ext G A.1) G B (C.p G A.1)) (C.lift D G A.1 s))
         (subS (C.ext D (C.subT D G A.1 s)) D (subS D G B s) (C.p D (C.subT D G A.1 s))) =
    trans (STy E)
      (subS E (C.ext G A.1) (subS (C.ext G A.1) G B (C.p G A.1)) (C.lift D G A.1 s))
      (subS E G B (C.o E (C.ext G A.1) G (C.p G A.1) (C.lift D G A.1 s)))
      (subS E D (subS D G B s) (C.p D (C.subT D G A.1 s)))
      (sym (STy E) (subS E G B (C.o E (C.ext G A.1) G (C.p G A.1) (C.lift D G A.1 s)))
                  (subS E (C.ext G A.1) (subS (C.ext G A.1) G B (C.p G A.1)) (C.lift D G A.1 s))
                  (subS-o E (C.ext G A.1) G B (C.p G A.1) (C.lift D G A.1 s)))
      (trans (STy E)
         (subS E G B (C.o E (C.ext G A.1) G (C.p G A.1) (C.lift D G A.1 s)))
         (subS E G B (C.o E D G s (C.p D (C.subT D G A.1 s))))
         (subS E D (subS D G B s) (C.p D (C.subT D G A.1 s)))
         (ap (C.Sub E G) (STy E) (\ s' -> subS E G B s')
             (C.o E (C.ext G A.1) G (C.p G A.1) (C.lift D G A.1 s)) (C.o E D G s (C.p D (C.subT D G A.1 s)))
             (C.p-lift D G A.1 s))
         (subS-o E D G B s (C.p D (C.subT D G A.1 s))))
   where { E : C.Ctx = C.ext D (C.subT D G A.1 s) ; } ;

  pSecT (G : C.Ctx) (A B : STy G) (a : C.El G A.1)
    : Id (STy G) (subS G (C.ext G A.1) (subS (C.ext G A.1) G B (C.p G A.1)) (C.sec G A.1 a)) B =
    trans (STy G)
      (subS G (C.ext G A.1) (subS (C.ext G A.1) G B (C.p G A.1)) (C.sec G A.1 a))
      (subS G G B (C.o G (C.ext G A.1) G (C.p G A.1) (C.sec G A.1 a)))
      B
      (sym (STy G) (subS G G B (C.o G (C.ext G A.1) G (C.p G A.1) (C.sec G A.1 a)))
                  (subS G (C.ext G A.1) (subS (C.ext G A.1) G B (C.p G A.1)) (C.sec G A.1 a))
                  (subS-o G (C.ext G A.1) G B (C.p G A.1) (C.sec G A.1 a)))
      (trans (STy G) (subS G G B (C.o G (C.ext G A.1) G (C.p G A.1) (C.sec G A.1 a))) (subS G G B (C.id G)) B
         (ap (C.Sub G G) (STy G) (\ s' -> subS G G B s')
             (C.o G (C.ext G A.1) G (C.p G A.1) (C.sec G A.1 a)) (C.id G) (C.p-sec G A.1 a))
         (subS-id G B)) ;

  SCwF : CwF.CwF[l] = new CwF.CwF[l := l,
    Ctx      := C.Ctx,
    Sub      := C.Sub,
    isSetSub := C.isSetSub,
    id       := C.id,
    o        := C.o,
    o-idl    := C.o-idl,
    o-idr    := C.o-idr,
    o-assoc  := C.o-assoc,

    nil      := C.nil,
    eps      := C.eps,
    eps-uniq := C.eps-uniq,

    Ty       := STy,
    isSetTy  := \ G -> isSet-Sigma (C.Ty G) (Cl G) (C.isSetTy G) (isSet-Cl G),
    subT     := subS,
    subT-id  := subS-id,
    subT-o   := subS-o,

    El       := \ G A -> C.El G A.1,
    isSetEl  := \ G A -> C.isSetEl G A.1,
    subt     := \ D G A a s -> C.subt D G A.1 a s,
    subt-id  := \ G A a ->
      trans (C.El G A.1) _ (subst (C.Ty G) (C.El G) (C.subT G G A.1 (C.id G)) A.1 (C.subT-id G A.1) (C.subt G G A.1 a (C.id G))) a
        (red G (C.El G) (subS G G A (C.id G)) A (subS-id G A) (C.subT-id G A.1) (C.subt G G A.1 a (C.id G)))
        (C.subt-id G A.1 a),
    subt-o   := \ T D G A a s s' ->
      trans (C.El T (C.subT T D (C.subT D G A.1 s) s')) _
        (subst (C.Ty T) (C.El T) (C.subT T G A.1 (C.o T D G s s')) (C.subT T D (C.subT D G A.1 s) s')
               (C.subT-o T D G A.1 s s') (C.subt T G A.1 a (C.o T D G s s')))
        (C.subt T D (C.subT D G A.1 s) (C.subt D G A.1 a s) s')
        (red T (C.El T) (subS T G A (C.o T D G s s')) (subS T D (subS D G A s) s') (subS-o T D G A s s')
             (C.subT-o T D G A.1 s s') (C.subt T G A.1 a (C.o T D G s s')))
        (C.subt-o T D G A.1 a s s'),

    ext      := \ G A -> C.ext G A.1,
    p        := \ G A -> C.p G A.1,
    q        := \ G A -> C.q G A.1,
    lift     := \ D G A s -> C.lift D G A.1 s,
    sec      := \ G A a -> C.sec G A.1 a,

    lift-id  := \ G A ->
      trans (C.Sub (C.ext G A.1) (C.ext G A.1)) _
        (subst (C.Ty G) (\ B -> C.Sub (C.ext G B) (C.ext G A.1)) (C.subT G G A.1 (C.id G)) A.1 (C.subT-id G A.1)
               (C.lift G G A.1 (C.id G)))
        (C.id (C.ext G A.1))
        (red G (\ B -> C.Sub (C.ext G B) (C.ext G A.1)) (subS G G A (C.id G)) A (subS-id G A) (C.subT-id G A.1)
             (C.lift G G A.1 (C.id G)))
        (C.lift-id G A.1),
    lift-o   := \ T D G A s s' ->
      trans (C.Sub (C.ext T (C.subT T D (C.subT D G A.1 s) s')) (C.ext G A.1)) _
        (subst (C.Ty T) (\ B -> C.Sub (C.ext T B) (C.ext G A.1))
               (C.subT T G A.1 (C.o T D G s s')) (C.subT T D (C.subT D G A.1 s) s')
               (C.subT-o T D G A.1 s s') (C.lift T G A.1 (C.o T D G s s')))
        (C.o (C.ext T (C.subT T D (C.subT D G A.1 s) s')) (C.ext D (C.subT D G A.1 s)) (C.ext G A.1)
             (C.lift D G A.1 s) (C.lift T D (C.subT D G A.1 s) s'))
        (red T (\ B -> C.Sub (C.ext T B) (C.ext G A.1)) (subS T G A (C.o T D G s s')) (subS T D (subS D G A s) s')
             (subS-o T D G A s s') (C.subT-o T D G A.1 s s') (C.lift T G A.1 (C.o T D G s s')))
        (C.lift-o T D G A.1 s s'),
    p-lift   := \ D G A s -> C.p-lift D G A.1 s,
    p-sec    := \ G A a -> C.p-sec G A.1 a,
    sec-o    := \ D G A a s -> C.sec-o D G A.1 a s,
    lift-p-sec-q := \ G A -> C.lift-p-sec-q G A.1,
    q-lift   := \ D G A s ->
      trans (C.El (C.ext D (C.subT D G A.1 s)) (C.subT (C.ext D (C.subT D G A.1 s)) D (C.subT D G A.1 s) (C.p D (C.subT D G A.1 s)))) _
        (subst (C.Ty (C.ext D (C.subT D G A.1 s))) (C.El (C.ext D (C.subT D G A.1 s)))
               (C.subT (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) (C.subT (C.ext G A.1) G A.1 (C.p G A.1)) (C.lift D G A.1 s))
               (C.subT (C.ext D (C.subT D G A.1 s)) D (C.subT D G A.1 s) (C.p D (C.subT D G A.1 s)))
               (C.p-lift-T D G A.1 A.1 s)
               (C.subt (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) (C.subT (C.ext G A.1) G A.1 (C.p G A.1)) (C.q G A.1) (C.lift D G A.1 s)))
        (C.q D (C.subT D G A.1 s))
        (red (C.ext D (C.subT D G A.1 s)) (C.El (C.ext D (C.subT D G A.1 s))) _ _ (pLiftT D G A A s) (C.p-lift-T D G A.1 A.1 s)
             (C.subt (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) (C.subT (C.ext G A.1) G A.1 (C.p G A.1)) (C.q G A.1) (C.lift D G A.1 s)))
        (C.q-lift D G A.1 s),
    q-sec    := \ G A a ->
      trans (C.El G A.1) _
        (subst (C.Ty G) (C.El G) (C.subT G (C.ext G A.1) (C.subT (C.ext G A.1) G A.1 (C.p G A.1)) (C.sec G A.1 a)) A.1
               (C.p-sec-T G A.1 A.1 a)
               (C.subt G (C.ext G A.1) (C.subT (C.ext G A.1) G A.1 (C.p G A.1)) (C.q G A.1) (C.sec G A.1 a)))
        a
        (red G (C.El G) _ A (pSecT G A A a) (C.p-sec-T G A.1 A.1 a)
             (C.subt G (C.ext G A.1) (C.subT (C.ext G A.1) G A.1 (C.p G A.1)) (C.q G A.1) (C.sec G A.1 a)))
        (C.q-sec G A.1 a) ] ;

  ----------------------------------------------------------------------
  -- Pi and Sigma.  A structure on Pi A B (Sigma A B) from structures on A
  -- and B, natural in the substitution, gives Pi (Sigma) on the structured
  -- types; the isomorphisms with their naturality are those of C (red).

  module CF = CwF.Formers[l, C] ;
  module SF = CwF.Formers[l, SCwF] ;

  module ClPi (P : CF.PiStr)
    (piCl : (G : C.Ctx) (A : STy G) (B : STy (C.ext G A.1)) -> Cl G (P.Pi G A.1 B.1))
    (piCl-nat : (D G : C.Ctx) (A : STy G) (B : STy (C.ext G A.1)) (s : C.Sub D G)
       -> Id (STy D) (subS D G (P.Pi G A.1 B.1, piCl G A B) s)
                     (P.Pi D (C.subT D G A.1 s) (C.subT (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) B.1 (C.lift D G A.1 s)),
                      piCl D (subS D G A s) (subS (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) B (C.lift D G A.1 s)))) {
    SPi : SF.PiStr = new SF.PiStr[
      Pi         := \ G A B -> (P.Pi G A.1 B.1, piCl G A B),
      Pi-nat     := piCl-nat,
      Pi-iso     := \ G A B -> P.Pi-iso G A.1 B.1,
      Pi-iso-nat := \ D G A B f s ->
        transH (red D (C.El D) _ _ (piCl-nat D G A B s) (P.Pi-nat D G A.1 B.1 s)
                    (C.subt D G (P.Pi G A.1 B.1) ((P.Pi-iso G A.1 B.1).inv f) s))
               (P.Pi-iso-nat D G A.1 B.1 f s) ] ;
  } ;

  module ClSig (S : CF.SigStr)
    (sigCl : (G : C.Ctx) (A : STy G) (B : STy (C.ext G A.1)) -> Cl G (S.Sig G A.1 B.1))
    (sigCl-nat : (D G : C.Ctx) (A : STy G) (B : STy (C.ext G A.1)) (s : C.Sub D G)
       -> Id (STy D) (subS D G (S.Sig G A.1 B.1, sigCl G A B) s)
                     (S.Sig D (C.subT D G A.1 s) (C.subT (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) B.1 (C.lift D G A.1 s)),
                      sigCl D (subS D G A s) (subS (C.ext D (C.subT D G A.1 s)) (C.ext G A.1) B (C.lift D G A.1 s)))) {
    -- the naturality of the isomorphism, with its points written
    module SN (D G : C.Ctx) (A : STy G) (B : STy (C.ext G A.1)) (a : C.El G A.1)
      (b : C.El G (C.subT G (C.ext G A.1) B.1 (C.sec G A.1 a))) (s : C.Sub D G) {
      A' : STy D = subS D G A s ;
      E : C.Ctx = C.ext D A'.1 ;
      B' : STy E = subS E (C.ext G A.1) B (C.lift D G A.1 s) ;
      SgD : C.Ty D = S.Sig D A'.1 B'.1 ;

      inv' (z : C.El D (C.subT D E B'.1 (C.sec D A'.1 (C.subt D G A.1 a s)))) : C.El D SgD =
        (S.Sig-iso D A'.1 B'.1).inv (C.subt D G A.1 a s, z) ;

      u : C.El D (C.subT D G (S.Sig G A.1 B.1) s) = C.subt D G (S.Sig G A.1 B.1) ((S.Sig-iso G A.1 B.1).inv (a, b)) s ;
      bs : C.El D (C.subT D G (C.subT G (C.ext G A.1) B.1 (C.sec G A.1 a)) s) =
        C.subt D G (C.subT G (C.ext G A.1) B.1 (C.sec G A.1 a)) b s ;

      -- the second component, transported in the structured CwF and in C
      bS : C.El D (C.subT D E B'.1 (C.sec D A'.1 (C.subt D G A.1 a s))) =
        subst (STy D) (\ Z -> C.El D Z.1) (subS D G (subS G (C.ext G A.1) B (C.sec G A.1 a)) s)
          (subS D E B' (C.sec D A'.1 (C.subt D G A.1 a s))) (SF.coerce D G A B a s) bs ;
      bC : C.El D (C.subT D E B'.1 (C.sec D A'.1 (C.subt D G A.1 a s))) =
        subst (C.Ty D) (C.El D) (C.subT D G (C.subT G (C.ext G A.1) B.1 (C.sec G A.1 a)) s)
          (C.subT D E B'.1 (C.sec D A'.1 (C.subt D G A.1 a s))) (CF.coerce D G A.1 B.1 a s) bs ;

      law : Id (C.El D SgD)
               (subst (STy D) (\ Z -> C.El D Z.1) (subS D G (S.Sig G A.1 B.1, sigCl G A B) s) (SgD, sigCl D A' B')
                      (sigCl-nat D G A B s) u)
               (inv' bS) =
        transH {C.El D SgD} {_} {inv' bC} {inv' bS}
          (transH {C.El D SgD} {_} {subst (C.Ty D) (C.El D) (C.subT D G (S.Sig G A.1 B.1) s) SgD (S.Sig-nat D G A.1 B.1 s) u} {inv' bC}
                  (red D (C.El D) _ _ (sigCl-nat D G A B s) (S.Sig-nat D G A.1 B.1 s) u)
                  (S.Sig-iso-nat D G A.1 B.1 a b s))
          (apH inv' {bC} {bS}
            (sym (C.El D (C.subT D E B'.1 (C.sec D A'.1 (C.subt D G A.1 a s)))) bS bC
                 (red D (C.El D) _ _ (SF.coerce D G A B a s) (CF.coerce D G A.1 B.1 a s) bs))) ;
    } ;

    SSig : SF.SigStr = new SF.SigStr[
      Sig         := \ G A B -> (S.Sig G A.1 B.1, sigCl G A B),
      Sig-nat     := sigCl-nat,
      Sig-iso     := \ G A B -> S.Sig-iso G A.1 B.1,
      Sig-iso-nat := \ D G A B a b s -> SN[D, G, A, B, a, b, s].law ] ;
  } ;
} ;
