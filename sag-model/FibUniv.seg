-- FibUniv.seg (M1, step 3): the instance of CwFU.Univ.UnivStr at the CwF of
-- fibrant types of presheaf level a+, FibCwF[a, a+].  The codes are core's
-- universe of level-a fibrant types (CPosEl1.UU, fibrant by CPosFinal.fibU),
-- the decoding is core's generic family El with its fibration
-- (CPosEl4.elFib).
--
-- Informal text.
-- (1) Cod G is the closed universe (U over the terminal context, with its
--     fibration) substituted along G -> 1.  Then Cod(G)[s] = Cod D is a law
--     of the CwF: the substitutions D -> 1 are equal.  (Taking fibU G in
--     each G instead would need fibU to be stable under substitution, which
--     core does not state.)
-- (2) A code c over G is, at each point x of G(I), a fibrant type over y I.
--     Its classifying map |c| : G -> U is x |-> c x; Dec G c is the generic
--     family (El, elFib) substituted along |c|.
-- (3) |c| s = |c[s]|: at a point, the substituted code transported along
--     Cod-nat has the value c (s x) (the fibres are the same code of V,
--     FibIdRd.elTr).  So Dec(c)[s] = Dec(c[s]) is again a law of the CwF.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
open PB.GPre[a+].PS ;
module FC = FibCwF[a, a+].FC ;
module UU = CPosEl1[a].UU ;
module UV = CwFU.Univ[a++, FibCwF[a, a+].fibCwF] ;

------------------------------------------------------------------------
-- (1) the codes

-- the closed universe
U1 : FC.STy nilP = (UU.UTy nilP, CPosFinal[a].fibU nilP) ;

Cod (G : PCtx) : FC.STy G = FC.subS G nilP U1 (epsP G) ;

-- two maps into the terminal context are equal
epsEq (D G : PCtx) (s : PSub[D, G]) : Id (PSub[D, nilP]) (oS D G nilP (epsP G) s) (epsP D) =
  sub-ext D nilP (oS D G nilP (epsP G) s) (epsP D) (\ I x -> refl tt) ;

Cod-nat (D G : PCtx) (s : PSub[D, G]) : Id (FC.STy D) (FC.subS D G (Cod G) s) (Cod D) =
  transH (symH (FC.subS-o D G nilP U1 (epsP G) s))
         (apH (\ t -> FC.subS D nilP U1 t) (epsEq D G s)) ;

module DU = UV.DerU[Cod, Cod-nat] ;

------------------------------------------------------------------------
-- (2) the decoding

-- the classifying map of a code
clMap (G : PCtx) (c : PEl[G, (Cod G).1]) : PSub[G, UU.UCtx] =
  mkPSub G UU.UCtx (\ I x -> c.eob I x) (\ J I f x -> symH (c.enat J I f x (G.act J I f x) (refl (G.act J I f x)))) ;

-- the generic family, with its fibration
ElF : FC.STy UU.UCtx = (UU.EGen, CPosEl4[a].elFib) ;

Dec (G : PCtx) (c : PEl[G, (Cod G).1]) : FC.STy G = FC.subS G UU.UCtx ElF (clMap G c) ;

------------------------------------------------------------------------
-- (3) the decoding is stable

-- the substituted code has the value of c at s x
subU-pt (D G : PCtx) (c : PEl[G, (Cod G).1]) (s : PSub[D, G]) (I : Ob) (x : V1.Ix (D.ob I))
  : Id (UU.U0 I) (c.eob I (s.nt I x)) ((DU.subU D G c s).eob I x) =
  symH (FibIdRd[a, a+].elTr D (FC.STy D) (\ Z -> Z.1) (FC.subS D G (Cod G) s) (Cod D) (Cod-nat D G s)
          (subEl D G (Cod G).1 c s) I x (refl (UU.codeU I))) ;

clMapEq (D G : PCtx) (c : PEl[G, (Cod G).1]) (s : PSub[D, G])
  : Id (PSub[D, UU.UCtx]) (oS D G UU.UCtx (clMap G c) s) (clMap D (DU.subU D G c s)) =
  sub-ext D UU.UCtx (oS D G UU.UCtx (clMap G c) s) (clMap D (DU.subU D G c s)) (subU-pt D G c s) ;

Dec-nat (D G : PCtx) (c : PEl[G, (Cod G).1]) (s : PSub[D, G])
  : Id (FC.STy D) (FC.subS D G (Dec G c) s) (Dec D (DU.subU D G c s)) =
  transH (symH (FC.subS-o D G UU.UCtx ElF (clMap G c) s))
         (apH (\ t -> FC.subS D UU.UCtx ElF t) (clMapEq D G c s)) ;

------------------------------------------------------------------------
-- the instance

fibUniv : UV.UnivStr = new UV.UnivStr[
  Cod     := Cod,
  Cod-nat := Cod-nat,
  Dec     := Dec,
  Dec-nat := Dec-nat ] ;
