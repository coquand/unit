-- Naming a decoded code recovers the code at each Yoneda point.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module E1 = CPosEl1[a] ;
module EF = CPosEl4[a] ;
module PB = E1.PB ;
module UU = E1.UU ;
module S = PB.CSmall ;
module P0 = PB.GPre[a] ;
module Y = PB.GYon[a] ;
module W0 = V[a] ;
module W1 = V[a+] ;
open PB.GPre[a+].PS ;
module Uv = FibUniv[a] ;
module FN = FibName[a] ;
module FS = FibNameSub[a] ;
module El = PB.CElC.ElC[PB.CFibCl.Cl, PB.CFibCl.clSub, PB.CFibCl.clSub-id, PB.CFibCl.clSub-o, PB.CFibCl.encCl, EF.elFib] ;

module Yon (Z : Ob) (F : UU.U0 Z) {
  D : P0.PS.PCtx = Y.yP Z ;
  module YC = E1.YG.Yc[Z, F] ;
  map : S.XSub[D, UU.UCtx] = El.cx D YC.s YC.s-nat ;
  module R = S.SmallFib[UU.UCtx, UU.El, D, map] ;
  module CL = PB.CLine[a].Lines[D, F.1] ;

  P : Id (P0.PS.PTy[D]) R.ElTy F.1 = El.Yon[Z, F, YC.s-nat].elYon ;
  module TR = PB.CTrFib[a].TR[D, R.ElTy] ;
  module K = TR.C[F.1, P].K ;

  module C = PB.CCartLaws2[a, a, a+].CC[D, F.1, D, R.ElTy, UU.UCtx, UU.EGen,
    \ W x -> x, \ V W g x -> refl (D.act V W g x), TR.ta F.1 P,
    \ W v -> refl (YC.TF.pr1 W v), TR.tanat F.1 P, TR.tainj F.1 P, TR.fwV F.1 P, TR.bkta F.1 P,
    YC.s, YC.s-nat, R.ta, \ W v -> refl (YC.s W (R.TB.pr1 W v)), R.tanat, R.tainj,
    \ W x u -> u, \ W x u -> refl (R.TE.pr W (YC.s W x) u)] ;

  total (W : Ob) (v : YC.TF.EI W) : Id (E1.TE.EI W) (C.ta W v) (YC.ta W v) =
    apH (E1.TE.pr W (YC.s W (YC.TF.pr1 W v)))
      (TR.tr-pw F.1 P W (YC.TF.pr1 W v) (symH (YC.Po W (YC.TF.pr1 W v))) (YC.TF.pr2 W v)) ;
  opaque total ;

  module CG = PB.CCartLaws2[a, a, a+].CG[D, F.1, UU.UCtx, UU.EGen,
    C.s, C.s-nat, C.ta, C.tapt, C.tanat, C.tainj, C.bk, C.bkta,
    YC.s, YC.s-nat, YC.ta, \ W v -> refl (YC.s W (YC.TF.pr1 W v)), YC.tanat, YC.tainj, YC.bk, YC.bkta,
    \ W x -> refl (YC.s W x), total] ;

  fib : Id CL.Fib (K.moveFib (R.fib EF.elFib)) F.2 =
    transH (C.compFib EF.elFib)
      (transH (CG.congFib EF.elFib) (CPosFinal[a].yonP Z F)) ;

  law : Id (UU.U0 Z) (FN.restrict UU.UCtx FN.ElSmall D map) F =
    transH (TR.law F.1 P (R.fib EF.elFib))
      (apH {CL.Fib} {UU.U0 Z} (\ k -> (F.1, k)) fib) ;
  opaque law ;
} ;

module Round (G : PCtx) (c : PEl[G, (Uv.Cod G).1]) {
  A : FS.SmallFib G = FN.decodeSmall G c ;
  m : PSub[G, UU.UCtx] = Uv.clMap G c ;
  module C = FN.Class[G, A] ;

  module At (Z : Ob) (z : W1.Ix (G.ob Z)) {
    F : UU.U0 Z = c.eob Z z ;
    D : P0.PS.PCtx = Y.yP Z ;
    t : S.XSub[D, G] = C.L.At[Z, z].s ;
    r : S.XSub[D, UU.UCtx] = FS.xcomp D G UU.UCtx m t ;

    base : Id (S.XSub[D, UU.UCtx]) r Yon[Z, F].map =
      S.xs-ext D UU.UCtx r Yon[Z, F].map (\ W g -> m.nt-nat W Z g z) ;

    law : Id (UU.U0 Z) (C.code Z z) F =
      transH FS.Mixed[D, G, UU.UCtx, FN.ElSmall, m, t].law
        (transH (apH (FN.restrict UU.UCtx FN.ElSmall D) base) Yon[Z, F].law) ;
    opaque law ;
  } ;

  law : Id (PEl[G, (Uv.Cod G).1]) C.name c =
    el-ext G (Uv.Cod G).1 C.name c (\ Z z -> At[Z, z].law) ;
  opaque law ;
} ;

name-dec (G : PCtx) (c : PEl[G, (Uv.Cod G).1])
  : Id (PEl[G, (Uv.Cod G).1]) (FN.name G (FN.decodeSmall G c)) c =
  Round[G, c].law ;
