-- The Pi code names the small fibrant Pi. Its naturality follows by
-- decoding, using Pi naturality and faithfulness of decoding.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module PB = PosFull[a].PB ;
open PB.GPre[a+].PS ;
module F = FibCwF[a, a+] ;
module FC = F.FC ;
module Uv = FibUniv[a] ;
module FN = FibName[a] ;
module FS = FibNameSub[a] ;
module ND = FibNameDec[a] ;
module Inj = FibUnivInj[a] ;
module PiS = FibPiSmall[a] ;
module UI = CwFUnivPi.Closure[a++, F.fibCwF, F.fibPi] ;
module UC = UI.With[Uv.fibUniv] ;
module Ov = CwFOv.Ov[a++, F.fibCwF, F.fibPi, F.fibSig, FibId[a, a+].fibId] ;

Code (G : PCtx) : U a++ = PEl[G, (Uv.Cod G).1] ;
Binder (G : PCtx) (u : Code G) : PCtx = extP G (Uv.Dec G u).1 ;

PiDec (G : PCtx) (u : Code G) (v : Code (Binder G u)) : FC.STy G =
  F.FPi.SPi.Pi G (Uv.Dec G u) (Uv.Dec (Binder G u) v) ;

module Form (G : PCtx) (u : Code G) (v : Code (Binder G u)) {
  A : FS.SmallFib G = FN.decodeSmall G u ;
  B : FS.SmallFib (Binder G u) = FN.decodeSmall (Binder G u) v ;
  module P = PiS.Pi[G, A, B] ;

  c : Code G = FN.name G P.small ;

  law : Id (FC.STy G) (Uv.Dec G c) (PiDec G u v) =
    transH (ND.dec-name G P.small) P.law ;
  opaque law ;
} ;

pic (G : PCtx) (u : Code G) (v : Code (Binder G u)) : Code G =
  Form[G, u, v].c ;

Dec-pic (G : PCtx) (u : Code G) (v : Code (Binder G u))
  : Id (FC.STy G) (Uv.Dec G (pic G u v)) (PiDec G u v) =
  Form[G, u, v].law ;

module Nat (D G : PCtx) (s : PSub[D, G]) (u : Code G) (v : Code (Binder G u)) {
  u' : Code D = Uv.DU.subU D G u s ;
  K : PCtx = Binder G u ;
  K' : PCtx = Binder D u' ;
  t : PSub[K', K] = UC.up-code D G u s ;
  v' : Code K' = Uv.DU.subU K' K v t ;

  pi-nat : Id (FC.STy D) (FC.subS D G (PiDec G u v) s) (PiDec D u' v') =
    Ov.Pi-ov D G (Uv.Dec G u) (Uv.Dec K v) s
      (Uv.Dec D u') (Uv.Dec-nat D G u s) (Uv.Dec K' v') (Uv.Dec-nat K' K v t) ;
  opaque pi-nat ;

  from : Code D = Uv.DU.subU D G (pic G u v) s ;
  to : Code D = pic D u' v' ;

  decoded : Id (FC.STy D) (Uv.Dec D from) (Uv.Dec D to) =
    calc (FC.STy D) {
        Uv.Dec D from
      =< symH (Uv.Dec-nat D G (pic G u v) s) >
        FC.subS D G (Uv.Dec G (pic G u v)) s
      =< apH (\ A -> FC.subS D G A s) (Dec-pic G u v) >
        FC.subS D G (PiDec G u v) s
      =< pi-nat >
        PiDec D u' v'
      =< symH (Dec-pic D u' v') >
        Uv.Dec D to } ;
  opaque decoded ;

  law : Id (Code D) from to = Inj.dec-inj D from to decoded ;
} ;

pic-nat (D G : PCtx) (s : PSub[D, G]) (u : Code G) (v : Code (Binder G u))
  : Id (Code D) (Uv.DU.subU D G (pic G u v) s)
      (pic D (Uv.DU.subU D G u s)
        (Uv.DU.subU (Binder D (Uv.DU.subU D G u s)) (Binder G u) v (UC.up-code D G u s))) =
  Nat[D, G, s, u, v].law ;

piClosure : UC.PiClosure = new UC.PiClosure[pic, Dec-pic, pic-nat] ;
fibUnivPi : UI.UnivPiStr = new UI.UnivPiStr[Uv.fibUniv, piClosure] ;
