-- Equal names give equal small fibrant types. Recover the underlying
-- type first, then apply mixed-level locality to the two structures.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
open PB.GPre[a+].PS ;
module P0 = PB.GPre[a].PS ;
module W1 = V[a+] ;
module Y = PB.GYon[a] ;
module Uv = FibUniv[a] ;
module UU = Uv.UU ;
module FS = FibNameSub[a] ;
module N = FibName[a] ;
module NY = FibNameYon[a] ;
module NT = FibNameTy[a] ;

module Code (Z : Ob) {
  Ty : U a+ = P0.PTy[Y.yP Z] ;
  Fib (T : Ty) : U a+ = PB.CLine[a].Lines[Y.yP Z, T].Fib ;

  -- A path of codes over a fixed type compares their structures.
  structure (T : Ty) (c d : Fib T) (q : Id (UU.U0 Z) (T, c) (T, d))
    : Id (Fib T) c d =
    transH (apH (\ p -> Prelude[a+].subst Ty Fib T T p c) (P0.isSet-PTy (Y.yP Z) T T (refl T) r.1)) r.2
    where { r : (p : Id Ty T T) * Id (Fib T) (Prelude[a+].subst Ty Fib T T p c) d =
      Prelude[a+].sPath Ty Fib (T, c) (T, d) q ; } ;
  opaque structure ;
} ;

module Inj (G : PCtx) (A B : FS.SmallFib G)
  (H : Id (PEl[G, (Uv.Cod G).1]) (N.name G A) (N.name G B)) {
  Codes : U a++ = PEl[G, (Uv.Cod G).1] ;
  module NB = N.Class[G, B] ;
  module LT = NT.Local[G, A.1, B.1] ;
  module S = PB.CSmall ;

  at (Z : Ob) (z : W1.Ix (G.ob Z)) : Id (P0.PTy[LT.At[Z, z].D]) LT.At[Z, z].AL LT.At[Z, z].BL =
    apH (\ k -> k.1) (apH {Codes} {UU.U0 Z} (\ d -> d.eob Z z) H) ;

  types : Id (S.SPTy[G]) A.1 B.1 = LT.Read[at].law ;

  Fib (T : S.SPTy[G]) : U a++ = PB.CLine[a+].Lines[G, S.up G T].Fib ;
  c : Fib B.1 = subst (S.SPTy[G]) Fib A.1 B.1 types A.2 ;
  A' : FS.SmallFib G = (B.1, c) ;

  move : Id (FS.SmallFib G) A A' =
    Sigma-path (S.SPTy[G]) Fib A.1 B.1 A.2 c types (refl c) ;

  names : Id Codes (N.name G A') (N.name G B) =
    transH (symH (apH (N.name G) move)) H ;

  module At (Z : Ob) (z : W1.Ix (G.ob Z)) {
    module C = NB.L.At[Z, z] ;
    code : Id (UU.U0 Z) (N.Class[G, A'].code Z z) (NB.code Z z) =
      apH {Codes} {UU.U0 Z} (\ d -> d.eob Z z) names ;

    structure : Id C.B.Fib (C.restrict c) (C.restrict B.2) =
      Code[Z].structure C.F.ElTy (C.restrict c) (C.restrict B.2) code ;
    opaque structure ;
  } ;

  structures : Id (Fib B.1) c B.2 = NB.L.fib-local c B.2 (\ Z z -> At[Z, z].structure) ;

  law : Id (FS.SmallFib G) A B =
    transH move (apH {Fib B.1} {FS.SmallFib G} (\ d -> (B.1, d)) structures) ;
  opaque law ;
} ;

dec-small-name (G : PCtx) (A : FS.SmallFib G)
  : Id (FS.SmallFib G) (N.decodeSmall G (N.name G A)) A =
  Inj[G, N.decodeSmall G (N.name G A), A, NY.name-dec G (N.name G A)].law ;

dec-name (G : PCtx) (A : FS.SmallFib G)
  : Id (Uv.FC.STy G) (Uv.Dec G (N.name G A)) (FS.large G A) =
  transH (symH (N.large-dec G (N.name G A)))
    (apH (FS.large G) (dec-small-name G A)) ;
