-- Comparisons of iterative-set constructors across the two levels.
-- Small codes keep their index type, and their members are lifted.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module W0 = V[a] ;
module W1 = V[a+] ;
module VL = VLift[a, a+] ;
module S = PosFull[a].PB.CSmall ;

transparent CBase.CB.CSmall.smallF ;

read-small (v : W0.V) (x : W0.Ix v)
  : Id W1.M (W1.ev (S.smallC v) x).1 (VL.liftM (W0.ev v x).1) =
  refl (VL.liftM (W0.ev v x).1) ;

small-lift-m : (m : W0.M) (i : W0.isIt m) -> Id W1.M (S.smallC (m, i)).1 (VL.liftM m) =
  split { sup X f -> \ i -> refl (sup X (\ x -> VL.liftM (f x))) } ;

opaque CBase.CB.CSmall.smallF ;

code-eq (v w : W1.V) (p : Id W1.M v.1 w.1) : Id W1.V v w =
  Sigma-eq W1.M (\ m -> W1.isIt m) v.1 w.1 v.2 w.2 p (W1.isProp-isIt w.1) ;

small-lift (v : W0.V) : Id W1.V (S.smallC v) (VL.liftV v) =
  code-eq (S.smallC v) (VL.liftV v) (small-lift-m v.1 v.2) ;

small-inj (v w : W0.V) (p : Id W1.V (S.smallC v) (S.smallC w)) : Id W0.V v w =
  Prelude[a+].Sigma-eq W0.M (\ m -> W0.isIt m) v.1 w.1 v.2 w.2
    (VL.liftV-inj v w (apH (\ x -> x.1) (transH (symH (small-lift v)) (transH p (small-lift w)))))
    (W0.isProp-isIt w.1) ;
opaque small-inj ;

sup-eq (X : U a) (f g : X -> W1.M) (p : (x : X) -> Id W1.M (f x) (g x))
  : Id W1.M (sup X f) (sup X g) =
  apH (\ k -> sup X k) (funext X (\ _ -> W1.M) f g p) ;

empty-lift : Id W1.M (VL.liftM W0.emptyV.1) W1.emptyV.1 =
  sup-eq Empty (\ e -> VL.liftM (Prelude[a+].absurd W0.V e).1) (\ e -> (absurd W1.V e).1)
    (\ e -> absurd (Id W1.M (VL.liftM (Prelude[a+].absurd W0.V e).1) (absurd W1.V e).1) e) ;
opaque empty-lift ;

sing-lift (v : W0.V) : Id W1.M (VL.liftM (W0.sing v).1) (W1.sing (VL.liftV v)).1 =
  refl (W1.sing (VL.liftV v)).1 ;

two-member (v : W0.V) : (b : Bool) -> Id W1.M (VL.liftM (W0.twoF v b).1) (W1.twoF (VL.liftV v) b).1 =
  split { true -> empty-lift ; false -> sing-lift v } ;

two-lift (v : W0.V) : Id W1.M (VL.liftM (W0.two v).1) (W1.two (VL.liftV v)).1 =
  sup-eq Bool (\ b -> VL.liftM (W0.twoF v b).1) (\ b -> (W1.twoF (VL.liftV v) b).1)
    (two-member v) ;

pair-member (v w : W0.V) : (b : Bool) -> Id W1.M (VL.liftM (W0.pairF v w b).1) (W1.pairF (VL.liftV v) (VL.liftV w) b).1 =
  split { true -> sing-lift v ; false -> two-lift w } ;

pair-lift (v w : W0.V) : Id W1.M (VL.liftM (W0.pairV v w).1) (W1.pairV (VL.liftV v) (VL.liftV w)).1 =
  sup-eq Bool (\ b -> VL.liftM (W0.pairF v w b).1) (\ b -> (W1.pairF (VL.liftV v) (VL.liftV w) b).1)
    (pair-member v w) ;

pair-value (v w : W0.V) (v' w' : W1.V)
  (p : Id W1.M (VL.liftM v.1) v'.1) (q : Id W1.M (VL.liftM w.1) w'.1)
  : Id W1.M (VL.liftM (W0.pairV v w).1) (W1.pairV v' w').1 =
  transH (pair-lift v w)
    (transH (apH (\ t -> (W1.pairV t (VL.liftV w)).1) (code-eq (VL.liftV v) v' p))
      (apH (\ t -> (W1.pairV v' t).1) (code-eq (VL.liftV w) w' q))) ;
opaque pair-value ;

-- A member of either Pi encoding is a graph with the same indices.
graph-value (X : U a) (enc val : X -> W0.V) (enc' val' : X -> W1.V)
  (p : (x : X) -> Id W1.M (VL.liftM (enc x).1) (enc' x).1)
  (q : (x : X) -> Id W1.M (VL.liftM (val x).1) (val' x).1)
  : Id W1.M (VL.liftM (sup X (\ x -> (W0.pairV (enc x) (val x)).1)))
      (sup X (\ x -> (W1.pairV (enc' x) (val' x)).1)) =
  sup-eq X (\ x -> VL.liftM (W0.pairV (enc x) (val x)).1)
    (\ x -> (W1.pairV (enc' x) (val' x)).1)
    (\ x -> pair-value (enc x) (val x) (enc' x) (val' x) (p x) (q x)) ;
opaque graph-value ;

-- Equality through the same sup index type leaves each index fixed.
module Fixed (X : U a) (f g : X -> W1.M) (h : Id (X -> W1.M) f g) {
  m : Id W1.M (sup X f) (sup X g) = apH (\ k -> sup X k) h ;

  val (u : X) : Id X (subst W1.M (\ k -> W1.Idx k) (sup X f) (sup X g) m u) u =
    idJ (X -> W1.M) f
      (\ k p -> Id X (subst W1.M (\ v -> W1.Idx v) (sup X f) (sup X k) (apH (\ z -> sup X z) p) u) u)
      (refl u) g h ;

  cast (i : W1.isIt (sup X f)) (j : W1.isIt (sup X g))
    (p : Id W1.V (sup X f, i) (sup X g, j)) (u : X)
    : Id X (subst W1.V (\ v -> W1.Ix v) (sup X f, i) (sup X g, j) p u) u =
    transH (subst-ap W1.V W1.M (\ v -> v.1) (\ v -> W1.Idx v) (sup X f, i) (sup X g, j) p u)
      (transH (apH (\ r -> subst W1.M (\ v -> W1.Idx v) (sup X f) (sup X g) r u)
        (W1.paths-prop (sup X f) i (sup X g) (apH (\ v -> v.1) p) m)) (val u)) ;
  opaque cast ;
} ;
