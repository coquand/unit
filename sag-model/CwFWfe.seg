-- CwFWfe.seg (M1 step 3, S4 toolkit): weak function extensionality from
-- naive function extensionality NF, in a CwF with Pi, Sigma, Swan Id.
--
-- Informal text.  Let kB : isContr B over G.A, with centre cB.  The centre
-- of Pi A B is c = lam cB.  Over K = G.(Pi A B), with g the variable, NF
-- applied to y |-> ctr_B(g y) : Id(cB y , g y) is a path c = g: the
-- contraction.  The centre of kB along the lift L of p is cB along L
-- (fst-nat, with CPov the stability of the contraction type), and so is
-- the body of c along p (bodNat).

open Base ;

module Wfe (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;

  -- the type of contractions is stable
  CPov (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    : Id (Ty (ext D A')) (subT (ext D A') (ext G A) (SG.CP G A) (upT D G A s A' PA)) (SG.CP D A') =
    Pi-ov K' K Ap (EQ.Id2 G A) s1 Ap' PAp (EQ.Id2 D A')
      (Id-ov (ext K' Ap') (ext K Ap) App (wkE K Ap Ap (q G A)) (q K Ap) s2 App' PApp
         (wkE K' Ap' Ap' (q D A')) (q K' Ap')
         (wkE-ov K' K Ap Ap (q G A) s1 Ap' PAp Ap' PAp (q D A') (q-ov D G A s A' PA PAp) PApp)
         (q-ov K' K Ap s1 Ap' PAp PApp))
   where {
    K : Ctx = ext G A ;
    K' : Ctx = ext D A' ;
    Ap : Ty K = wkT G A A ;
    Ap' : Ty K' = wkT D A' A' ;
    App : Ty (ext K Ap) = wkT K Ap Ap ;
    App' : Ty (ext K' Ap') = wkT K' Ap' Ap' ;
    s1 : Sub K' K = upT D G A s A' PA ;
    PAp : Id (Ty K') (subT K' K Ap s1) Ap' = wkT-ov D G A A s A' PA A' PA ;
    s2 : Sub (ext K' Ap') (ext K Ap) = upT K' K Ap s1 Ap' PAp ;
    PApp : Id (Ty (ext K' Ap')) (subT (ext K' Ap') (ext K Ap) App s2) App' = wkT-ov K' K Ap Ap s1 Ap' PAp Ap' PAp ;
   } ;

  module W (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (kB : El (ext G A) (EQ.isContr (ext G A) B)) {
    P : Ty G = PS.Pi G A B ;
    K : Ctx = ext G P ;
    A' : Ty K = subT K G A (p G P) ;
    L : Sub (ext K A') (ext G A) = lift K G A (p G P) ;
    B' : Ty (ext K A') = subT (ext K A') (ext G A) B L ;
    PN : Id (Ty K) (wkT G P P) (PS.Pi K A' B') = PS.Pi-nat K G A B (p G P) ;

    cB : El (ext G A) B = SG.cenOf (ext G A) B kB ;
    c : El G P = lam G A B cB ;
    c' : El K (PS.Pi K A' B') = trE K (wkT G P P) (PS.Pi K A' B') PN (wkE G P P c) ;
    g' : El K (PS.Pi K A' B') = trE K (wkT G P P) (PS.Pi K A' B') PN (q G P) ;

    kB' : El (ext K A') (EQ.isContr (ext K A') B') =
      trE (ext K A') (subT (ext K A') (ext G A) (EQ.isContr (ext G A) B) L) (EQ.isContr (ext K A') B')
        (EQ.isContr-ov (ext K A') (ext G A) B L B' (refl B')) (subt (ext K A') (ext G A) (EQ.isContr (ext G A) B) kB L) ;

    -- the centre of kB' and the body of c' are both cB along L
    e1 : Id (El (ext K A') B') (SG.cenOf (ext K A') B' kB') (bod K A' B' c') =
      trans (El (ext K A') B') (SG.cenOf (ext K A') B' kB') (subt (ext K A') (ext G A) B cB L) (bod K A' B' c')
        (IN.fst-nat (ext K A') (ext G A) B (SG.CP (ext G A) B) L (SG.CP (ext K A') B')
           (CPov (ext K A') (ext G A) B L B' (refl B'))
           (EQ.isContr-ov (ext K A') (ext G A) B L B' (refl B')) kB)
        (sym (El (ext K A') B') (bod K A' B' c') (subt (ext K A') (ext G A) B cB L)
           (trans (El (ext K A') B') (bod K A' B' c') (subt (ext K A') (ext G A) B (bod G A B c) L) (subt (ext K A') (ext G A) B cB L)
              (bodNat K G A B (p G P) B' (refl B') PN c)
              (ap (El (ext G A) B) (El (ext K A') B') (\ v -> subt (ext K A') (ext G A) B v L) (bod G A B c) cB ((PS.Pi-iso G A B).fun-inv cB)))) ;

    h : El K (PS.Pi K A' (IJ.IdT (ext K A') B' (bod K A' B' c') (bod K A' B' g'))) =
      lam K A' (IJ.IdT (ext K A') B' (bod K A' B' c') (bod K A' B' g'))
        (trE (ext K A') (IJ.IdT (ext K A') B' (SG.cenOf (ext K A') B' kB') (bod K A' B' g')) (IJ.IdT (ext K A') B' (bod K A' B' c') (bod K A' B' g'))
           (DJ.idCong (ext K A') B' B' (refl B') (SG.cenOf (ext K A') B' kB') (bod K A' B' g') (bod K A' B' c') (bod K A' B' g') e1 (refl (bod K A' B' g')))
           (SG.ctrAt (ext K A') B' kB' (bod K A' B' g'))) ;

    ctr : El K (JP.IK G P c) =
      trE K (IJ.IdT K (PS.Pi K A' B') c' g') (JP.IK G P c)
        (DJ.idCong K (PS.Pi K A' B') (wkT G P P) (sym (Ty K) (wkT G P P) (PS.Pi K A' B') PN) c' g' (wkE G P P c) (q G P)
           (IN.trE-symL K (wkT G P P) (PS.Pi K A' B') PN (wkE G P P c))
           (IN.trE-symL K (wkT G P P) (PS.Pi K A' B') PN (q G P)))
        (NF K A' B' c' g' h) ;

    wfe : El G (EQ.isContr G P) = SG.mkContr G P c ctr ;
  } ;

  wfe (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (kB : El (ext G A) (EQ.isContr (ext G A) B)) : El G (EQ.isContr G (PS.Pi G A B)) =
    W[G, A, B, kB].wfe ;
} ;
