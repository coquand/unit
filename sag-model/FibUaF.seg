-- FibUaF.seg (M1 step 3, S4, the map f of the assembly of uaC0).  Over
-- the telescope T3 = U0 . Cod . (Y0 -> X0) . K1 of CwFUaW (a point is
-- (((F , b) , r) , k)), the equivalence structure S3b(k) on r, read through
-- FibGlueF at each point, is a full glue datum over F (CPosFinal's UaTy).
--
-- Informal text.
-- (1) X0 = Dec a0 and Y0 = Dec (qc) are El along the classifying maps of
--     the codes a0 and qc, which are transports of the variable q; at a
--     point their values are F and b (FibIdRd.elTr, the code path being
--     refl).  So, weakened to T3, they are El along xm : z |-> F and
--     ym : z |-> b (subT-o three and two times, then sub-ext): PX , PY.
-- (2) The variable k of T3 is an element of Kr r2 (CwFS4.KrW).  Transported
--     along PX , PY, (r2 , k) gives (rc , kc) with rc : El[ym] -> El[xm].
-- (3) S3b (FibS3) gives core's equivalence structure on rc, and FibGlueF
--     the full glue datum at each point of T3.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module FCw = FibCwF[a, a+] ;
module UU = CPosEl1[a].UU ;
module Un = FibUniv[a] ;
module UW = CwFUaW.UaW[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf, FibUniv[a].fibUniv] ;
module CH = CwFChi.Chi[a++, FCw.fibCwF, FibUniv[a].fibUniv] ;
module CHL = CwFChi.ChiL[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
open CwFOv.Ov[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId] ;

------------------------------------------------------------------------
-- the telescope and its points

Gb : FCw.fibCwF.Ctx = FCw.fibCwF.ext CH.U0 (FibUniv[a].fibUniv.Cod CH.U0) ;

module QV = UW.QP.QV[Gb, UW.X0, UW.Y0] ;

T3 : FCw.fibCwF.Ctx = QV.G2 ;

-- the components of a point (((x , b) , r) , k), x = (tt , F)
z1 (W : Ob) (z : V1.Ix (T3.ob W)) : V1.Ix (QV.G1.ob W) = L.fstE QV.G1 QV.K1.1 W z ;
z0 (W : Ob) (z : V1.Ix (T3.ob W)) : V1.Ix (Gb.ob W) = L.fstE Gb QV.FYX.1 W (z1 W z) ;
zx (W : Ob) (z : V1.Ix (T3.ob W)) : V1.Ix (CH.U0.ob W) = L.fstE CH.U0 (FibUniv[a].fibUniv.Cod CH.U0).1 W (z0 W z) ;
zb (W : Ob) (z : V1.Ix (T3.ob W)) : UU.U0 W = L.sndE CH.U0 (FibUniv[a].fibUniv.Cod CH.U0).1 W (z0 W z) ;
zF (W : Ob) (z : V1.Ix (T3.ob W)) : UU.U0 W = L.sndE FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil).1 W (zx W z) ;

-- the two codes, as maps into the universe (natural by definition)
xm : L.PSub[T3, UU.UCtx] = new L.PSub[T3, UU.UCtx, zF, \ J I f z -> refl (UU.uAct J I f (zF I z))] ;
ym : L.PSub[T3, UU.UCtx] = new L.PSub[T3, UU.UCtx, zb, \ J I f z -> refl (UU.uAct J I f (zb I z))] ;

Xc : FCw.fibCwF.Ty T3 = FCw.fibCwF.subT T3 UU.UCtx Un.ElF xm ;
Yc : FCw.fibCwF.Ty T3 = FCw.fibCwF.subT T3 UU.UCtx Un.ElF ym ;

------------------------------------------------------------------------
-- (1) X0 and Y0 weakened to T3 are El along xm and ym

-- the values of the two codes
a0-pt (W : Ob) (x : V1.Ix (CH.U0.ob W)) : Id (UU.U0 W) (CHL.a0.eob W x) (L.sndE FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil).1 W x) =
  FibIdRd[a, a+].elTr CH.U0 (FCw.fibCwF.Ty CH.U0) (\ Z -> Z.1) (wkT FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil) (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil)) (FibUniv[a].fibUniv.Cod CH.U0)
    (FibUniv[a].fibUniv.Cod-nat CH.U0 FCw.fibCwF.nil (FCw.fibCwF.p FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil))) (FCw.fibCwF.q FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil)) W x (refl (UU.codeU W)) ;

qc-pt (W : Ob) (x : V1.Ix (Gb.ob W)) : Id (UU.U0 W) ((UW.UU.qc CH.U0).eob W x) (L.sndE CH.U0 (FibUniv[a].fibUniv.Cod CH.U0).1 W x) =
  FibIdRd[a, a+].elTr Gb (FCw.fibCwF.Ty Gb) (\ Z -> Z.1) (wkT CH.U0 (FibUniv[a].fibUniv.Cod CH.U0) (FibUniv[a].fibUniv.Cod CH.U0)) (FibUniv[a].fibUniv.Cod Gb)
    (FibUniv[a].fibUniv.Cod-nat Gb CH.U0 (FCw.fibCwF.p CH.U0 (FibUniv[a].fibUniv.Cod CH.U0))) (FCw.fibCwF.q CH.U0 (FibUniv[a].fibUniv.Cod CH.U0)) W x (refl (UU.codeU W)) ;

-- the classifying maps, composed with the projections
c0 : FCw.fibCwF.Sub CH.U0 UU.UCtx = Un.clMap CH.U0 CHL.a0 ;
c1 : FCw.fibCwF.Sub Gb UU.UCtx = FCw.fibCwF.o Gb CH.U0 UU.UCtx c0 (FCw.fibCwF.p CH.U0 (FibUniv[a].fibUniv.Cod CH.U0)) ;
c2 : FCw.fibCwF.Sub QV.G1 UU.UCtx = FCw.fibCwF.o QV.G1 Gb UU.UCtx c1 (FCw.fibCwF.p Gb QV.FYX) ;
c3 : FCw.fibCwF.Sub T3 UU.UCtx = FCw.fibCwF.o T3 QV.G1 UU.UCtx c2 (FCw.fibCwF.p QV.G1 QV.K1) ;

d0 : FCw.fibCwF.Sub Gb UU.UCtx = Un.clMap Gb (UW.UU.qc CH.U0) ;
d1 : FCw.fibCwF.Sub QV.G1 UU.UCtx = FCw.fibCwF.o QV.G1 Gb UU.UCtx d0 (FCw.fibCwF.p Gb QV.FYX) ;
d2 : FCw.fibCwF.Sub T3 UU.UCtx = FCw.fibCwF.o T3 QV.G1 UU.UCtx d1 (FCw.fibCwF.p QV.G1 QV.K1) ;

-- X0 is El along c1
eX0 : Id (FCw.fibCwF.Ty Gb) UW.X0 (FCw.fibCwF.subT Gb UU.UCtx Un.ElF c1) =
  symH (FCw.fibCwF.subT-o Gb CH.U0 UU.UCtx Un.ElF c0 (FCw.fibCwF.p CH.U0 (FibUniv[a].fibUniv.Cod CH.U0))) ;

eX1 : Id (FCw.fibCwF.Ty QV.G1) QV.X1 (FCw.fibCwF.subT QV.G1 UU.UCtx Un.ElF c2) =
  transH (apH (\ B -> FCw.fibCwF.subT QV.G1 Gb B (FCw.fibCwF.p Gb QV.FYX)) eX0)
         (symH (FCw.fibCwF.subT-o QV.G1 Gb UU.UCtx Un.ElF c1 (FCw.fibCwF.p Gb QV.FYX))) ;

PX : Id (FCw.fibCwF.Ty T3) QV.X2 Xc =
  transH (apH (\ B -> FCw.fibCwF.subT T3 QV.G1 B (FCw.fibCwF.p QV.G1 QV.K1)) eX1)
  (transH (symH (FCw.fibCwF.subT-o T3 QV.G1 UU.UCtx Un.ElF c2 (FCw.fibCwF.p QV.G1 QV.K1)))
          (apH (\ s -> FCw.fibCwF.subT T3 UU.UCtx Un.ElF s) (L.sub-ext T3 UU.UCtx c3 xm (\ W z -> a0-pt W (zx W z))))) ;

PY : Id (FCw.fibCwF.Ty T3) QV.Y2 Yc =
  transH (apH (\ B -> FCw.fibCwF.subT T3 QV.G1 B (FCw.fibCwF.p QV.G1 QV.K1)) (symH (FCw.fibCwF.subT-o QV.G1 Gb UU.UCtx Un.ElF d0 (FCw.fibCwF.p Gb QV.FYX))))
  (transH (symH (FCw.fibCwF.subT-o T3 QV.G1 UU.UCtx Un.ElF d1 (FCw.fibCwF.p QV.G1 QV.K1)))
          (apH (\ s -> FCw.fibCwF.subT T3 UU.UCtx Un.ElF s) (L.sub-ext T3 UU.UCtx d2 ym (\ W z -> qc-pt W (z0 W z))))) ;

------------------------------------------------------------------------
-- (2) r and k, transported

k2 : FCw.fibCwF.El T3 (UW.QP.Kr T3 QV.X2 QV.Y2 QV.r2) =
  trE T3 (wkT QV.G1 QV.K1 QV.K1) (UW.QP.Kr T3 QV.X2 QV.Y2 QV.r2) (UW.S4.KrW QV.G1 QV.K1 QV.X1 QV.Y1 QV.r1) (FCw.fibCwF.q QV.G1 QV.K1) ;

KP (X Y : FCw.fibCwF.Ty T3) : U a++ = (r : FCw.fibCwF.El T3 (Fun T3 Y X)) * FCw.fibCwF.El T3 (UW.QP.Kr T3 X Y r) ;

rk1 : KP Xc QV.Y2 = subst (FCw.fibCwF.Ty T3) (\ X -> KP X QV.Y2) QV.X2 Xc PX (QV.r2, k2) ;

rk : KP Xc Yc = subst (FCw.fibCwF.Ty T3) (\ Y -> KP Xc Y) QV.Y2 Yc PY rk1 ;

------------------------------------------------------------------------
-- (3) the equivalence structure and the glue data

module S = FibS3[a, a+].S3[T3, Xc, Yc, rk.1] ;

module FD = FibGlueF[a].FD[T3, xm, ym, S.al, S.B[rk.2].eop] ;

------------------------------------------------------------------------
-- (4) f : Q0 -> UaTy' over U0, a natural map

-- the type of the assembly over U0, and core's UaTy along U0 -> U
Q0 : FCw.fibCwF.Ty CH.U0 =
  FCw.fibSig.Sig CH.U0 (FibUniv[a].fibUniv.Cod CH.U0) (FCw.fibSig.Sig Gb QV.FYX QV.K1) ;

pim : L.PSub[CH.U0, UU.UCtx] =
  new L.PSub[CH.U0, UU.UCtx, \ W x -> L.sndE FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil).1 W x,
    \ J I f x -> refl (UU.uAct J I f (L.sndE FCw.fibCwF.nil (FibUniv[a].fibUniv.Cod FCw.fibCwF.nil).1 I x))] ;

UaTy' : L.PTy[CH.U0] = L.subTy CH.U0 UU.UCtx CPosFinal[a].UF.UO.UA.UaTy pim ;

-- a point of U0 . Q0 as a point of the telescope
tel (X : Ob) (x : V1.Ix (CH.U0.ob X)) (w : V1.Ix (Q0.1.tob X x)) : V1.Ix (T3.ob X) =
  L.pairE QV.G1 QV.K1.1 X (L.pairE Gb QV.FYX.1 X (L.pairE CH.U0 (FibUniv[a].fibUniv.Cod CH.U0).1 X x w.1) w.2.1) w.2.2 ;

-- the action of U0 . Q0 is that of the telescope, by definition
telAct (J I : Ob) (h : Hom J I) (x : V1.Ix (CH.U0.ob I)) (w : V1.Ix (Q0.1.tob I x))
  : Id (V1.Ix (T3.ob J)) (tel J (CH.U0.act J I h x) (Q0.1.tact J I h x (CH.U0.act J I h x) (refl (CH.U0.act J I h x)) w)) (T3.act J I h (tel I x w)) =
  refl (T3.act J I h (tel I x w)) ;

fv (X : Ob) (x : V1.Ix (CH.U0.ob X)) (w : V1.Ix (Q0.1.tob X x)) : V1.Ix (UaTy'.tob X x) = FD.fdat X (tel X x w) ;

fnn (J I : Ob) (h : Hom J I) (x : V1.Ix (CH.U0.ob I)) (y : V1.Ix (CH.U0.ob J)) (e : Id (V1.Ix (CH.U0.ob J)) (CH.U0.act J I h x) y)
  (w : V1.Ix (Q0.1.tob I x))
  : Id (V1.Ix (UaTy'.tob J y)) (UaTy'.tact J I h x y e (fv I x w)) (fv J y (Q0.1.tact J I h x y e w)) =
  idJ (V1.Ix (CH.U0.ob J)) (CH.U0.act J I h x)
    (\ y2 e2 -> Id (V1.Ix (UaTy'.tob J y2)) (UaTy'.tact J I h x y2 e2 (fv I x w)) (fv J y2 (Q0.1.tact J I h x y2 e2 w)))
    -- at y = x h: fnat, the point being T3's action (telAct)
    (FD.fnat I (tel I x w) J h (L.ntEq CH.U0 UU.UCtx pim J I h x (CH.U0.act J I h x) (refl (CH.U0.act J I h x))))
    y e ;

f : PB.CHtpyOps[a+].NMap[CH.U0, Q0.1, UaTy'] = new PB.CHtpyOps[a+].NMap[CH.U0, Q0.1, UaTy', fv, fnn] ;
