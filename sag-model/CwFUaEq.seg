-- CwFUaEq.seg (M1 step 3, S5): the interface field UaContr gives the
-- source's univalence, isEquiv (idtoeqv a b), generically (ruling
-- 2026-11-09, M1.md decision 6).
--
-- Informal proof.  Fix a code a over G; over K = G.U (variable b) let
-- P b = Equiv(Dec a , Dec b), X = Sigma (b : U) P b, e0 = id : P a,
-- y0 = (a , e0) : X, and f_b : Id(a , b) -> P b by J with f_a refl = e0
-- (idtoeqv).  UaContr gives c : X and ctr : Pi (w : X) Id(c , w).
-- (1) T1, by J on Id(c , z): Pi (w : X) (Id(c , w) -> Id(z , w)), with
--     T1(c , refl) = \ w v. v.  gamma w = T1(y0 , ctr y0) w (ctr w) :
--     Id(y0 , w).
-- (2) Theta, by J on u : Id(c , z): T1(z , u) z u = refl z; at (y0 ,
--     ctr y0): gamma y0 = refl y0.
-- (3) apY, by J on Id(y0 , w): Id(a , fst w), apY(y0 , refl) = refl.
-- (4) SE, by J on delta : Id(y0 , w): f (apY delta) = snd w.
-- (5) g (b , e) = apY(pr(b , e) , gamma (pr(b , e))): f (g e) = e by (4).
-- (6) Theta', by J on gamma y0 = refl (2): apY(gamma y0) = apY(refl) =
--     refl.  So g (a , e0) = refl.
-- (7) RE, by J on p : Id(a , b): g (f p) = p, at refl by (6) and
--     f refl = e0.
-- Then (g , (5) , g , (7)) is in isEquiv f (bi-invertible: sec = ret).
--
-- Each J is used through its values at points (CwFJ.instG) and at cen
-- (CwFJ.Jb); the motives are types whose values there are computed by
-- their stability lemmas.

open Base ;

module UaEq (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (UA : CwFU.UnivUa[l, C, PS, SS, IJ, Un].UaStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module UU = CwFU.UnivUa[l, C, PS, SS, IJ, Un] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module CF = CwFContr.Contr[l, C, PS, SS, IJ] ;

  -- a transport undone (metatheory)
  substInv (A : U l) (F : A -> U l) (x y : A) (pp : Id A x y) (u : F x)
    : Id (F x) (subst A F y x (sym A x y pp) (subst A F x y pp u)) u =
    idJ A x (\ z r -> Id (F x) (subst A F z x (sym A x z r) (subst A F x z r u)) u) (refl u) y pp ;

  ----------------------------------------------------------------------
  -- the family P at a point

  qc-pt (G : Ctx) (b : El G (Un.Cod G))
    : Ov G (ext G (Un.Cod G)) (Un.Cod (ext G (Un.Cod G))) (sec G (Un.Cod G) b) (Un.Cod G)
         (Un.Cod-nat G (ext G (Un.Cod G)) (sec G (Un.Cod G) b)) (UU.qc G) b =
    ovTr G (ext G (Un.Cod G)) (wkT G (Un.Cod G) (Un.Cod G)) (Un.Cod (ext G (Un.Cod G)))
      (Un.Cod-nat (ext G (Un.Cod G)) G (p G (Un.Cod G))) (sec G (Un.Cod G) b) (Un.Cod G) (Un.Cod G) (refl (Un.Cod G))
      (p-sec-T G (Un.Cod G) (Un.Cod G) b) (Un.Cod-nat G (ext G (Un.Cod G)) (sec G (Un.Cod G) b))
      (q G (Un.Cod G)) b (IN.q-secO G (Un.Cod G) b (p-sec-T G (Un.Cod G) (Un.Cod G) b)) ;

  PB-pt (G : Ctx) (a b : El G (Un.Cod G))
    : Id (Ty G) (subT G (ext G (Un.Cod G)) (UU.PB G a) (sec G (Un.Cod G) b)) (EQ.Equiv G (Un.Dec G a) (Un.Dec G b)) =
    EQ.Equiv-ov G (ext G (Un.Cod G)) (wkT G (Un.Cod G) (Un.Dec G a)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (sec G (Un.Cod G) b)
      (Un.Dec G a) (p-sec-T G (Un.Cod G) (Un.Dec G a) b) (Un.Dec G b)
      (trans (Ty G) (subT G (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (sec G (Un.Cod G) b))
                    (Un.Dec G (UU.DU.subU G (ext G (Un.Cod G)) (UU.qc G) (sec G (Un.Cod G) b))) (Un.Dec G b)
         (Un.Dec-nat G (ext G (Un.Cod G)) (UU.qc G) (sec G (Un.Cod G) b))
         (ap (El G (Un.Cod G)) (Ty G) (\ c -> Un.Dec G c) (UU.DU.subU G (ext G (Un.Cod G)) (UU.qc G) (sec G (Un.Cod G) b)) b (qc-pt G b))) ;

  ----------------------------------------------------------------------
  -- the motives of apY and SE, for any context

  -- the type of idtoeqv, packaged over G: Pi (b : U) (Id(a , b) -> P b)
  FPT (D : Ctx) (a : El D (Un.Cod D)) : Ty D =
    PS.Pi D (Un.Cod D) (Fun (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a) (UU.PB D a)) ;

  FPT-ov (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G) (a' : El D (Un.Cod D))
    (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    : Id (Ty D) (subT D G (FPT G a) s) (FPT D a') =
    Pi-ov D G (Un.Cod G) (Fun (ext G (Un.Cod G)) (JP.IK G (Un.Cod G) a) (UU.PB G a)) s (Un.Cod D) (Un.Cod-nat D G s)
      (Fun (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a') (UU.PB D a'))
      (Fun-ov (ext D (Un.Cod D)) (ext G (Un.Cod G)) (JP.IK G (Un.Cod G) a) (UU.PB G a) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s))
         (JP.IK D (Un.Cod D) a') (JP.IK-ov D G (Un.Cod G) a s (Un.Cod D) (Un.Cod-nat D G s) a' Pa)
         (UU.PB D a') (UU.PB-ov D G a s a' Pa)) ;

  -- P b, as P at sec b
  PBat (D : Ctx) (a b : El D (Un.Cod D)) : Ty D = subT D (ext D (Un.Cod D)) (UU.PB D a) (sec D (Un.Cod D) b) ;

  PBat-ov (D G : Ctx) (a b : El G (Un.Cod G)) (s : Sub D G) (a' b' : El D (Un.Cod D))
    (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a') (Pb : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) b b')
    : Id (Ty D) (subT D G (PBat G a b) s) (PBat D a' b') =
    trans (Ty D) (subT D G (PBat G a b) s) (subT D G (EQ.Equiv G (Un.Dec G a) (Un.Dec G b)) s) (PBat D a' b')
      (ap (Ty G) (Ty D) (\ Y -> subT D G Y s) (PBat G a b) (EQ.Equiv G (Un.Dec G a) (Un.Dec G b)) (PB-pt G a b))
      (trans (Ty D) (subT D G (EQ.Equiv G (Un.Dec G a) (Un.Dec G b)) s) (EQ.Equiv D (Un.Dec D a') (Un.Dec D b')) (PBat D a' b')
         (EQ.Equiv-ov D G (Un.Dec G a) (Un.Dec G b) s (Un.Dec D a') (DecP a a' Pa) (Un.Dec D b') (DecP b b' Pb))
         (sym (Ty D) (PBat D a' b') (EQ.Equiv D (Un.Dec D a') (Un.Dec D b')) (PB-pt D a' b')))
   where {
    DecP (x : El G (Un.Cod G)) (x' : El D (Un.Cod D)) (Px : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) x x')
      : Id (Ty D) (subT D G (Un.Dec G x) s) (Un.Dec D x') =
      trans (Ty D) (subT D G (Un.Dec G x) s) (Un.Dec D (UU.DU.subU D G x s)) (Un.Dec D x')
        (Un.Dec-nat D G x s) (ap (El D (Un.Cod D)) (Ty D) (\ c -> Un.Dec D c) (UU.DU.subU D G x s) x' Px) ;
   } ;

  -- f at b, from its packaging fP
  FFun (D : Ctx) (a b : El D (Un.Cod D))
    : Id (Ty D) (subT D (ext D (Un.Cod D)) (Fun (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a) (UU.PB D a)) (sec D (Un.Cod D) b))
         (Fun D (IJ.IdT D (Un.Cod D) a b) (PBat D a b)) =
    Fun-ov D (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a) (UU.PB D a) (sec D (Un.Cod D) b) (IJ.IdT D (Un.Cod D) a b)
      (JP.IKpt D (Un.Cod D) a b) (PBat D a b) (refl (PBat D a b)) ;

  fAt (D : Ctx) (a : El D (Un.Cod D)) (fP : El D (FPT D a)) (b : El D (Un.Cod D))
    : El D (Fun D (IJ.IdT D (Un.Cod D) a b) (PBat D a b)) =
    trE D (subT D (ext D (Un.Cod D)) (Fun (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a) (UU.PB D a)) (sec D (Un.Cod D) b))
      (Fun D (IJ.IdT D (Un.Cod D) a b) (PBat D a b)) (FFun D a b)
      (IN.appD D (Un.Cod D) (Fun (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a) (UU.PB D a)) fP b) ;

  fAt-ov (D G : Ctx) (a : El G (Un.Cod G)) (fP : El G (FPT G a)) (b : El G (Un.Cod G)) (s : Sub D G)
    (a' : El D (Un.Cod D)) (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    (fP' : El D (FPT D a')) (PfP : Ov D G (FPT G a) s (FPT D a') (FPT-ov D G a s a' Pa) fP fP')
    (b' : El D (Un.Cod D)) (Pb : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) b b')
    (PF : Id (Ty D) (subT D G (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) s) (Fun D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b')))
    : Ov D G (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) s (Fun D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b')) PF
         (fAt G a fP b) (fAt D a' fP' b') =
    ovTr D G (subT G (ext G (Un.Cod G)) FG (sec G (Un.Cod G) b)) (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) (FFun G a b) s
      (subT D (ext D (Un.Cod D)) FD (sec D (Un.Cod D) b')) (Fun D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b')) (FFun D a' b') PApD PF
      (IN.appD G (Un.Cod G) FG fP b) (IN.appD D (Un.Cod D) FD fP' b')
      (IN.appD-ov D G (Un.Cod G) FG s (Un.Cod D) (Un.Cod-nat D G s) FD
         (Fun-ov (ext D (Un.Cod D)) (ext G (Un.Cod G)) (JP.IK G (Un.Cod G) a) (UU.PB G a) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s))
            (JP.IK D (Un.Cod D) a') (JP.IK-ov D G (Un.Cod G) a s (Un.Cod D) (Un.Cod-nat D G s) a' Pa)
            (UU.PB D a') (UU.PB-ov D G a s a' Pa))
         (FPT-ov D G a s a' Pa) fP fP' PfP b b' Pb PApD)
   where {
    FG : Ty (ext G (Un.Cod G)) = Fun (ext G (Un.Cod G)) (JP.IK G (Un.Cod G) a) (UU.PB G a) ;
    FD : Ty (ext D (Un.Cod D)) = Fun (ext D (Un.Cod D)) (JP.IK D (Un.Cod D) a') (UU.PB D a') ;
    PApD : Id (Ty D) (subT D G (subT G (ext G (Un.Cod G)) FG (sec G (Un.Cod G) b)) s) (subT D (ext D (Un.Cod D)) FD (sec D (Un.Cod D) b')) =
      trans (Ty D) (subT D G (subT G (ext G (Un.Cod G)) FG (sec G (Un.Cod G) b)) s)
                   (subT D G (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) s) (subT D (ext D (Un.Cod D)) FD (sec D (Un.Cod D) b'))
        (ap (Ty G) (Ty D) (\ Y -> subT D G Y s) (subT G (ext G (Un.Cod G)) FG (sec G (Un.Cod G) b)) (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) (FFun G a b))
        (trans (Ty D) (subT D G (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) s) (Fun D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b'))
                      (subT D (ext D (Un.Cod D)) FD (sec D (Un.Cod D) b'))
           PF (sym (Ty D) (subT D (ext D (Un.Cod D)) FD (sec D (Un.Cod D) b')) (Fun D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b')) (FFun D a' b'))) ;
   } ;

  -- apY's motive: Id(a , fst w)
  MapY (D : Ctx) (a : El D (Un.Cod D)) (w : El D (UU.UaT D a)) : Ty D =
    IJ.IdT D (Un.Cod D) a (IN.fst D (Un.Cod D) (UU.PB D a) w) ;

  w-fst-ov (D G : Ctx) (a : El G (Un.Cod G)) (w : El G (UU.UaT G a)) (s : Sub D G)
    (a' : El D (Un.Cod D)) (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    (w' : El D (UU.UaT D a')) (Pw : Ov D G (UU.UaT G a) s (UU.UaT D a') (UU.UaT-ov' D G a s a' Pa) w w')
    : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) (IN.fst G (Un.Cod G) (UU.PB G a) w) (IN.fst D (Un.Cod D) (UU.PB D a') w') =
    IN.fst-ov D G (Un.Cod G) (UU.PB G a) s (Un.Cod D) (Un.Cod-nat D G s) (UU.PB D a') (UU.PB-ov D G a s a' Pa)
      (UU.UaT-ov' D G a s a' Pa) w w' Pw ;

  MapY-ov (D G : Ctx) (a : El G (Un.Cod G)) (w : El G (UU.UaT G a)) (s : Sub D G)
    (a' : El D (Un.Cod D)) (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    (w' : El D (UU.UaT D a')) (Pw : Ov D G (UU.UaT G a) s (UU.UaT D a') (UU.UaT-ov' D G a s a' Pa) w w')
    : Id (Ty D) (subT D G (MapY G a w) s) (MapY D a' w') =
    Id-ov D G (Un.Cod G) a (IN.fst G (Un.Cod G) (UU.PB G a) w) s (Un.Cod D) (Un.Cod-nat D G s) a' (IN.fst D (Un.Cod D) (UU.PB D a') w')
      Pa (w-fst-ov D G a w s a' Pa w' Pw) ;

  -- SE's motive: f (r) = snd w, at b = fst w
  MSE (D : Ctx) (a : El D (Un.Cod D)) (fP : El D (FPT D a)) (w : El D (UU.UaT D a)) (r : El D (MapY D a w)) : Ty D =
    IJ.IdT D (PBat D a (IN.fst D (Un.Cod D) (UU.PB D a) w))
      (app D (IJ.IdT D (Un.Cod D) a (IN.fst D (Un.Cod D) (UU.PB D a) w)) (PBat D a (IN.fst D (Un.Cod D) (UU.PB D a) w))
         (fAt D a fP (IN.fst D (Un.Cod D) (UU.PB D a) w)) r)
      (IN.snd D (Un.Cod D) (UU.PB D a) w) ;

  MSE-ov (D G : Ctx) (a : El G (Un.Cod G)) (fP : El G (FPT G a)) (w : El G (UU.UaT G a)) (r : El G (MapY G a w)) (s : Sub D G)
    (a' : El D (Un.Cod D)) (Pa : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) a a')
    (fP' : El D (FPT D a')) (PfP : Ov D G (FPT G a) s (FPT D a') (FPT-ov D G a s a' Pa) fP fP')
    (w' : El D (UU.UaT D a')) (Pw : Ov D G (UU.UaT G a) s (UU.UaT D a') (UU.UaT-ov' D G a s a' Pa) w w')
    (r' : El D (MapY D a' w')) (Pr : Ov D G (MapY G a w) s (MapY D a' w') (MapY-ov D G a w s a' Pa w' Pw) r r')
    : Id (Ty D) (subT D G (MSE G a fP w r) s) (MSE D a' fP' w' r') =
    Id-ov D G (PBat G a b) (app G (IJ.IdT G (Un.Cod G) a b) (PBat G a b) (fAt G a fP b) r) (IN.snd G (Un.Cod G) (UU.PB G a) w) s
      (PBat D a' b') PPb (app D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b') (fAt D a' fP' b') r') (IN.snd D (Un.Cod D) (UU.PB D a') w')
      (app-ov D G (IJ.IdT G (Un.Cod G) a b) (PBat G a b) s (IJ.IdT D (Un.Cod D) a' b') PI (PBat D a' b') PPb PF
         (fAt G a fP b) (fAt D a' fP' b') (fAt-ov D G a fP b s a' Pa fP' PfP b' Pb PF) r r' Pr)
      (IN.snd-ov D G (Un.Cod G) (UU.PB G a) s (Un.Cod D) (Un.Cod-nat D G s) (UU.PB D a') (UU.PB-ov D G a s a' Pa)
         (UU.UaT-ov' D G a s a' Pa) w w' Pw PPb)
   where {
    b : El G (Un.Cod G) = IN.fst G (Un.Cod G) (UU.PB G a) w ;
    b' : El D (Un.Cod D) = IN.fst D (Un.Cod D) (UU.PB D a') w' ;
    Pb : Ov D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s) b b' = w-fst-ov D G a w s a' Pa w' Pw ;
    PPb : Id (Ty D) (subT D G (PBat G a b) s) (PBat D a' b') = PBat-ov D G a b s a' b' Pa Pb ;
    PI : Id (Ty D) (subT D G (IJ.IdT G (Un.Cod G) a b) s) (IJ.IdT D (Un.Cod D) a' b') =
      Id-ov D G (Un.Cod G) a b s (Un.Cod D) (Un.Cod-nat D G s) a' b' Pa Pb ;
    PF : Id (Ty D) (subT D G (Fun G (IJ.IdT G (Un.Cod G) a b) (PBat G a b)) s) (Fun D (IJ.IdT D (Un.Cod D) a' b') (PBat D a' b')) =
      Fun-ov D G (IJ.IdT G (Un.Cod G) a b) (PBat G a b) s (IJ.IdT D (Un.Cod D) a' b') PI (PBat D a' b') PPb ;
   } ;

  ----------------------------------------------------------------------
  -- at a code a over G

  module At (G : Ctx) (a : El G (Un.Cod G)) {
    U0 : Ty G = Un.Cod G ;
    K : Ctx = ext G U0 ;
    IKa : Ty K = JP.IK G U0 a ;
    Dxa : Ctx = JP.Dx G U0 a ;
    P : Ty K = UU.PB G a ;
    X : Ty G = UU.UaT G a ;
    Pa : Ty G = subT G K P (sec G U0 a) ;

    -- the identity equivalence of Dec a, in P a
    e0 : El G Pa =
      trE G (EQ.Equiv G (Un.Dec G a) (Un.Dec G a)) Pa (sym (Ty G) Pa (EQ.Equiv G (Un.Dec G a) (Un.Dec G a)) (PB-pt G a a))
        (IN.idE G (Un.Dec G a)) ;

    -- idtoeqv, by J with motive P (weakened), and its computation rule
    Pcen : Id (Ty G) (subT G Dxa (wkT K IKa P) (DJ.cen G U0 a)) Pa =
      JP.wT-inst G U0 IKa a (subT G K IKa (sec G U0 a)) (refl (subT G K IKa (sec G U0 a))) (DJ.reflE G U0 a) P ;

    fJ : El Dxa (wkT K IKa P) =
      IJ.J G U0 a (wkT K IKa P) (trE G Pa (subT G Dxa (wkT K IKa P) (DJ.cen G U0 a)) (sym (Ty G) (subT G Dxa (wkT K IKa P) (DJ.cen G U0 a)) Pa Pcen) e0) ;

    f : El K (Fun K IKa P) = lam K IKa (wkT K IKa P) fJ ;

    f-beta : Ov G Dxa (wkT K IKa P) (DJ.cen G U0 a) Pa Pcen fJ e0 =
      JP.Jb G U0 a (wkT K IKa P) Pa Pcen Pcen e0 ;

    -- the contraction given by UaContr
    CP : Ty (ext G X) = PS.Pi (ext G X) (wkT G X X) (EQ.Id2 G X) ;
    uc : El G (SS.Sig G X CP) = UA.UaContr G a ;
    c : El G X = IN.fst G X CP uc ;

    PCP : Id (Ty G) (subT G (ext G X) CP (sec G X c)) (PS.Pi G X (JP.IK G X c)) =
      Pi-ov G (ext G X) (wkT G X X) (EQ.Id2 G X) (sec G X c) X (p-sec-T G X X c) (JP.IK G X c)
        (JP.IK-ov G (ext G X) (wkT G X X) (q G X) (sec G X c) X (p-sec-T G X X c) c (IN.q-secO G X c (p-sec-T G X X c))) ;

    ctrPi : El G (PS.Pi G X (JP.IK G X c)) =
      trE G (subT G (ext G X) CP (sec G X c)) (PS.Pi G X (JP.IK G X c)) PCP (IN.snd G X CP uc) ;

    ctrAt (y : El G X) : El G (IJ.IdT G X c y) =
      trE G (subT G (ext G X) (JP.IK G X c) (sec G X y)) (IJ.IdT G X c y) (JP.IKpt G X c y) (IN.appD G X (JP.IK G X c) ctrPi y) ;

    -- the point (a , id) of X
    y0 : El G X = IN.pr G U0 P a e0 ;

    ----------------------------------------------------------------------
    -- f at a, applied to refl, is e0

    f-at-a : Id (El G Pa) (app G (IJ.IdT G U0 a a) Pa (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a)
                                                           (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a)) e0 =
      calc (El G Pa) {
          app G (IJ.IdT G U0 a a) Pa (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a)
                                         (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a)
        =< sym (El G Pa) (trE G Xi Pa WI (subt G Dxa (wkT K IKa P) fJ iR))
             (app G (IJ.IdT G U0 a a) Pa (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a)
                                            (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a))
             (JP.appLamInst G U0 IKa P a (IJ.IdT G U0 a a) (JP.IKpt G U0 a a) (IJ.rfl G U0 a) fJ (FFun G a a)) >
          trE G Xi Pa WI (subt G Dxa (wkT K IKa P) fJ iR)
        =< SJ.subtEq G Dxa (wkT K IKa P) fJ iR (DJ.cen G U0 a) (JP.instRefl G U0 a) Pa WI Pcen >
          trE G (subT G Dxa (wkT K IKa P) (DJ.cen G U0 a)) Pa Pcen (subt G Dxa (wkT K IKa P) fJ (DJ.cen G U0 a))
        =< f-beta >
          e0 }
     where {
      iR : Sub G Dxa = JP.instG G U0 IKa a (IJ.IdT G U0 a a) (JP.IKpt G U0 a a) (IJ.rfl G U0 a) ;
      Xi : Ty G = subT G Dxa (wkT K IKa P) iR ;
      WI : Id (Ty G) Xi Pa = JP.wT-inst G U0 IKa a (IJ.IdT G U0 a a) (JP.IKpt G U0 a a) (IJ.rfl G U0 a) P ;
     } ;

    -- idtoeqv packaged over G
    fP : El G (FPT G a) = lam G U0 (Fun K IKa P) f ;

    fAt-a : Id (El G (Fun G (IJ.IdT G U0 a a) Pa)) (fAt G a fP a)
               (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))) =
      ap (El G (subT G K (Fun K IKa P) (sec G U0 a))) (El G (Fun G (IJ.IdT G U0 a a) Pa))
         (\ v -> trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) v)
         (IN.appD G U0 (Fun K IKa P) fP a) (subt G K (Fun K IKa P) f (sec G U0 a)) (IN.appD-lam G U0 (Fun K IKa P) f a) ;

    -- for b with pi : a = b: f_b (refl transported) = e0 transported
    Qf (b : El G U0) (pi : Id (El G U0) a b)
      : Id (El G (PBat G a b))
           (app G (IJ.IdT G U0 a b) (PBat G a b) (fAt G a fP b)
                (trE G (IJ.IdT G U0 a a) (IJ.IdT G U0 a b) (ap (El G U0) (Ty G) (\ v -> IJ.IdT G U0 a v) a b pi) (IJ.rfl G U0 a)))
           (trE G Pa (PBat G a b) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a b pi) e0) =
      idJ (El G U0) a
        (\ b2 pi2 -> Id (El G (PBat G a b2))
           (app G (IJ.IdT G U0 a b2) (PBat G a b2) (fAt G a fP b2)
                (trE G (IJ.IdT G U0 a a) (IJ.IdT G U0 a b2) (ap (El G U0) (Ty G) (\ v -> IJ.IdT G U0 a v) a b2 pi2) (IJ.rfl G U0 a)))
           (trE G Pa (PBat G a b2) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a b2 pi2) e0))
        (trans (El G Pa) (app G (IJ.IdT G U0 a a) Pa (fAt G a fP a) (IJ.rfl G U0 a))
                         (app G (IJ.IdT G U0 a a) Pa (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a)
                                                        (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a)) e0
           (ap (El G (Fun G (IJ.IdT G U0 a a) Pa)) (El G Pa) (\ F -> app G (IJ.IdT G U0 a a) Pa F (IJ.rfl G U0 a)) (fAt G a fP a)
               (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a)))
               fAt-a)
           f-at-a)
        b pi ;

    ----------------------------------------------------------------------
    -- the data at the context of J at y0, Dy = G.X.Id(y0 , -)

    module NM = CF.Norm[G, X, c, ctrPi, y0] ;

    Bv : Ty (ext G X) = JP.IK G X y0 ;
    Dy : Ctx = JP.Dx G X y0 ;
    p2 : Sub Dy (ext G X) = p (ext G X) Bv ;
    CN1 : Id (Ty (ext G X)) (wkT G X U0) (Un.Cod (ext G X)) = Un.Cod-nat (ext G X) G (p G X) ;
    CNp2 : Id (Ty Dy) (subT Dy (ext G X) (Un.Cod (ext G X)) p2) (Un.Cod Dy) = Un.Cod-nat Dy (ext G X) p2 ;
    APC : Id (Ty Dy) (JP.wwT G X Bv U0) (subT Dy (ext G X) (Un.Cod (ext G X)) p2) =
      ap (Ty (ext G X)) (Ty Dy) (\ Y -> subT Dy (ext G X) Y p2) (wkT G X U0) (Un.Cod (ext G X)) CN1 ;
    CN2 : Id (Ty Dy) (JP.wwT G X Bv U0) (Un.Cod Dy) = trans (Ty Dy) (JP.wwT G X Bv U0) (subT Dy (ext G X) (Un.Cod (ext G X)) p2) (Un.Cod Dy) APC CNp2 ;

    a1 : El (ext G X) (Un.Cod (ext G X)) = trE (ext G X) (wkT G X U0) (Un.Cod (ext G X)) CN1 (wkE G X U0 a) ;
    aD : El Dy (Un.Cod Dy) = trE Dy (JP.wwT G X Bv U0) (Un.Cod Dy) CN2 (JP.wwE G X Bv U0 a) ;

    PaD : Ov Dy (ext G X) (Un.Cod (ext G X)) p2 (Un.Cod Dy) CNp2 a1 aD =
      trans (El Dy (Un.Cod Dy)) (trE Dy (subT Dy (ext G X) (Un.Cod (ext G X)) p2) (Un.Cod Dy) CNp2 (subt Dy (ext G X) (Un.Cod (ext G X)) a1 p2))
                                (trE Dy (subT Dy (ext G X) (Un.Cod (ext G X)) p2) (Un.Cod Dy) CNp2 (trE Dy (JP.wwT G X Bv U0) (subT Dy (ext G X) (Un.Cod (ext G X)) p2) APC (JP.wwE G X Bv U0 a)))
                                aD
        (ap (El Dy (subT Dy (ext G X) (Un.Cod (ext G X)) p2)) (El Dy (Un.Cod Dy)) (\ v -> trE Dy (subT Dy (ext G X) (Un.Cod (ext G X)) p2) (Un.Cod Dy) CNp2 v)
            (subt Dy (ext G X) (Un.Cod (ext G X)) a1 p2) (trE Dy (JP.wwT G X Bv U0) (subT Dy (ext G X) (Un.Cod (ext G X)) p2) APC (JP.wwE G X Bv U0 a))
            (subt-tr Dy (ext G X) (wkT G X U0) (Un.Cod (ext G X)) CN1 (wkE G X U0 a) p2))
        (trE-tr Dy (JP.wwT G X Bv U0) (subT Dy (ext G X) (Un.Cod (ext G X)) p2) (Un.Cod Dy) APC CNp2 (JP.wwE G X Bv U0 a)) ;

    UP1 : Id (Ty (ext G X)) (wkT G X X) (UU.UaT (ext G X) a1) = UU.UaT-ov' (ext G X) G a (p G X) a1 (refl a1) ;
    UP2 : Id (Ty Dy) (JP.wwT G X Bv X) (UU.UaT Dy aD) =
      trans (Ty Dy) (JP.wwT G X Bv X) (subT Dy (ext G X) (UU.UaT (ext G X) a1) p2) (UU.UaT Dy aD)
        (ap (Ty (ext G X)) (Ty Dy) (\ Y -> subT Dy (ext G X) Y p2) (wkT G X X) (UU.UaT (ext G X) a1) UP1)
        (UU.UaT-ov' Dy (ext G X) a1 p2 aD PaD) ;
    FP1 : Id (Ty (ext G X)) (wkT G X (FPT G a)) (FPT (ext G X) a1) = FPT-ov (ext G X) G a (p G X) a1 (refl a1) ;
    FP2 : Id (Ty Dy) (JP.wwT G X Bv (FPT G a)) (FPT Dy aD) =
      trans (Ty Dy) (JP.wwT G X Bv (FPT G a)) (subT Dy (ext G X) (FPT (ext G X) a1) p2) (FPT Dy aD)
        (ap (Ty (ext G X)) (Ty Dy) (\ Y -> subT Dy (ext G X) Y p2) (wkT G X (FPT G a)) (FPT (ext G X) a1) FP1)
        (FPT-ov Dy (ext G X) a1 p2 aD PaD) ;

    wX : El (ext G X) (UU.UaT (ext G X) a1) = trE (ext G X) (wkT G X X) (UU.UaT (ext G X) a1) UP1 (q G X) ;
    wD : El Dy (UU.UaT Dy aD) = trE Dy (JP.wwT G X Bv X) (UU.UaT Dy aD) UP2 (JP.zv G X Bv) ;
    fP1 : El (ext G X) (FPT (ext G X) a1) = trE (ext G X) (wkT G X (FPT G a)) (FPT (ext G X) a1) FP1 (wkE G X (FPT G a) fP) ;
    fPD : El Dy (FPT Dy aD) = trE Dy (JP.wwT G X Bv (FPT G a)) (FPT Dy aD) FP2 (JP.wwE G X Bv (FPT G a) fP) ;

    -- at cen
    cY : Sub G Dy = DJ.cen G X y0 ;
    I0y : Ty G = subT G (ext G X) Bv (sec G X y0) ;
    PaC : Ov G Dy (Un.Cod Dy) cY U0 (Un.Cod-nat G Dy cY) aD a =
      ovTr G Dy (JP.wwT G X Bv U0) (Un.Cod Dy) CN2 cY U0 U0 (refl U0) (JP.wwT-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) U0)
        (Un.Cod-nat G Dy cY) (JP.wwE G X Bv U0 a) a
        (JP.wwE-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) U0 a (JP.wwT-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) U0)) ;
    PwC : Ov G Dy (UU.UaT Dy aD) cY X (UU.UaT-ov' G Dy aD cY a PaC) wD y0 =
      ovTr G Dy (JP.wwT G X Bv X) (UU.UaT Dy aD) UP2 cY X X (refl X) (JP.wwT-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) X)
        (UU.UaT-ov' G Dy aD cY a PaC) (JP.zv G X Bv) y0
        (JP.zv-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) (JP.wwT-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) X)) ;
    PfC : Ov G Dy (FPT Dy aD) cY (FPT G a) (FPT-ov G Dy aD cY a PaC) fPD fP =
      ovTr G Dy (JP.wwT G X Bv (FPT G a)) (FPT Dy aD) FP2 cY (FPT G a) (FPT G a) (refl (FPT G a))
        (JP.wwT-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) (FPT G a)) (FPT-ov G Dy aD cY a PaC) (JP.wwE G X Bv (FPT G a) fP) fP
        (JP.wwE-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) (FPT G a) fP (JP.wwT-inst G X Bv y0 I0y (refl I0y) (DJ.reflE G X y0) (FPT G a))) ;

    -- along sec gam : G.X -> Dy
    sg : Sub (ext G X) Dy = sec (ext G X) Bv NM.gam ;
    Pa1 : Ov (ext G X) Dy (Un.Cod Dy) sg (Un.Cod (ext G X)) (Un.Cod-nat (ext G X) Dy sg) aD a1 =
      ovTr (ext G X) Dy (JP.wwT G X Bv U0) (Un.Cod Dy) CN2 sg (wkT G X U0) (Un.Cod (ext G X)) CN1
        (p-sec-T (ext G X) Bv (wkT G X U0) NM.gam) (Un.Cod-nat (ext G X) Dy sg) (JP.wwE G X Bv U0 a) (wkE G X U0 a)
        (IN.wkE-sec (ext G X) Bv (wkT G X U0) NM.gam (wkE G X U0 a) (p-sec-T (ext G X) Bv (wkT G X U0) NM.gam)) ;
    Pw1 : Ov (ext G X) Dy (UU.UaT Dy aD) sg (UU.UaT (ext G X) a1) (UU.UaT-ov' (ext G X) Dy aD sg a1 Pa1) wD wX =
      ovTr (ext G X) Dy (JP.wwT G X Bv X) (UU.UaT Dy aD) UP2 sg (wkT G X X) (UU.UaT (ext G X) a1) UP1
        (p-sec-T (ext G X) Bv (wkT G X X) NM.gam) (UU.UaT-ov' (ext G X) Dy aD sg a1 Pa1) (JP.zv G X Bv) (q G X)
        (IN.wkE-sec (ext G X) Bv (wkT G X X) NM.gam (q G X) (p-sec-T (ext G X) Bv (wkT G X X) NM.gam)) ;
    PfP1 : Ov (ext G X) Dy (FPT Dy aD) sg (FPT (ext G X) a1) (FPT-ov (ext G X) Dy aD sg a1 Pa1) fPD fP1 =
      ovTr (ext G X) Dy (JP.wwT G X Bv (FPT G a)) (FPT Dy aD) FP2 sg (wkT G X (FPT G a)) (FPT (ext G X) a1) FP1
        (p-sec-T (ext G X) Bv (wkT G X (FPT G a)) NM.gam) (FPT-ov (ext G X) Dy aD sg a1 Pa1)
        (JP.wwE G X Bv (FPT G a) fP) (wkE G X (FPT G a) fP)
        (IN.wkE-sec (ext G X) Bv (wkT G X (FPT G a)) NM.gam (wkE G X (FPT G a) fP) (p-sec-T (ext G X) Bv (wkT G X (FPT G a)) NM.gam)) ;

    ----------------------------------------------------------------------
    -- (3) apY : Id(a , fst w), by J on Id(y0 , w)

    pia : Id (El G U0) a (IN.fst G U0 P y0) = sym (El G U0) (IN.fst G U0 P y0) a (IN.fst-pr G U0 P a e0) ;
    baseA : El G (MapY G a y0) =
      trE G (IJ.IdT G U0 a a) (MapY G a y0) (ap (El G U0) (Ty G) (\ v -> IJ.IdT G U0 a v) a (IN.fst G U0 P y0) pia) (IJ.rfl G U0 a) ;

    CMa : Ty Dy = MapY Dy aD wD ;
    PCa : Id (Ty G) (subT G Dy CMa cY) (MapY G a y0) = MapY-ov G Dy aD wD cY a PaC y0 PwC ;
    apJ : El Dy CMa = IJ.J G X y0 CMa (trE G (MapY G a y0) (subT G Dy CMa cY) (sym (Ty G) (subT G Dy CMa cY) (MapY G a y0) PCa) baseA) ;
    apb : Ov G Dy CMa cY (MapY G a y0) PCa apJ baseA = JP.Jb G X y0 CMa (MapY G a y0) PCa PCa baseA ;

    ----------------------------------------------------------------------
    -- (4) SE : f (apY delta) = snd w, by J on Id(y0 , w)

    -- snd y0 is e0, transported along pia
    sndy0 : Id (El G (PBat G a (IN.fst G U0 P y0))) (IN.snd G U0 P y0)
               (trE G Pa (PBat G a (IN.fst G U0 P y0)) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a (IN.fst G U0 P y0) pia) e0) =
      trans (El G (PBat G a (IN.fst G U0 P y0))) (IN.snd G U0 P y0)
        (subst (El G U0) (\ v -> El G (PBat G a v)) a (IN.fst G U0 P y0) pia
           (subst (El G U0) (\ v -> El G (PBat G a v)) (IN.fst G U0 P y0) a (IN.fst-pr G U0 P a e0) (IN.snd G U0 P y0)))
        (trE G Pa (PBat G a (IN.fst G U0 P y0)) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a (IN.fst G U0 P y0) pia) e0)
        (sym (El G (PBat G a (IN.fst G U0 P y0)))
           (subst (El G U0) (\ v -> El G (PBat G a v)) a (IN.fst G U0 P y0) pia
              (subst (El G U0) (\ v -> El G (PBat G a v)) (IN.fst G U0 P y0) a (IN.fst-pr G U0 P a e0) (IN.snd G U0 P y0)))
           (IN.snd G U0 P y0)
           (substInv (El G U0) (\ v -> El G (PBat G a v)) (IN.fst G U0 P y0) a (IN.fst-pr G U0 P a e0) (IN.snd G U0 P y0)))
        (trans (El G (PBat G a (IN.fst G U0 P y0)))
           (subst (El G U0) (\ v -> El G (PBat G a v)) a (IN.fst G U0 P y0) pia
              (subst (El G U0) (\ v -> El G (PBat G a v)) (IN.fst G U0 P y0) a (IN.fst-pr G U0 P a e0) (IN.snd G U0 P y0)))
           (subst (El G U0) (\ v -> El G (PBat G a v)) a (IN.fst G U0 P y0) pia e0)
           (trE G Pa (PBat G a (IN.fst G U0 P y0)) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a (IN.fst G U0 P y0) pia) e0)
           (ap (El G Pa) (El G (PBat G a (IN.fst G U0 P y0))) (\ v -> subst (El G U0) (\ v2 -> El G (PBat G a v2)) a (IN.fst G U0 P y0) pia v)
               (subst (El G U0) (\ v -> El G (PBat G a v)) (IN.fst G U0 P y0) a (IN.fst-pr G U0 P a e0) (IN.snd G U0 P y0)) e0
               (IN.snd-pr G U0 P a e0))
           (subst-ap (El G U0) (Ty G) (\ v -> PBat G a v) (El G) a (IN.fst G U0 P y0) pia e0)) ;

    baseS : El G (MSE G a fP y0 baseA) =
      IN.idOfEq G (PBat G a (IN.fst G U0 P y0))
        (app G (IJ.IdT G U0 a (IN.fst G U0 P y0)) (PBat G a (IN.fst G U0 P y0)) (fAt G a fP (IN.fst G U0 P y0)) baseA)
        (IN.snd G U0 P y0)
        (trans (El G (PBat G a (IN.fst G U0 P y0)))
           (app G (IJ.IdT G U0 a (IN.fst G U0 P y0)) (PBat G a (IN.fst G U0 P y0)) (fAt G a fP (IN.fst G U0 P y0)) baseA)
           (trE G Pa (PBat G a (IN.fst G U0 P y0)) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a (IN.fst G U0 P y0) pia) e0)
           (IN.snd G U0 P y0)
           (Qf (IN.fst G U0 P y0) pia)
           (sym (El G (PBat G a (IN.fst G U0 P y0))) (IN.snd G U0 P y0)
              (trE G Pa (PBat G a (IN.fst G U0 P y0)) (ap (El G U0) (Ty G) (\ v -> PBat G a v) a (IN.fst G U0 P y0) pia) e0) sndy0)) ;

    CMs : Ty Dy = MSE Dy aD fPD wD apJ ;
    PCs : Id (Ty G) (subT G Dy CMs cY) (MSE G a fP y0 baseA) = MSE-ov G Dy aD fPD wD apJ cY a PaC fP PfC y0 PwC baseA apb ;
    SEJ : El Dy CMs = IJ.J G X y0 CMs (trE G (MSE G a fP y0 baseA) (subT G Dy CMs cY) (sym (Ty G) (subT G Dy CMs cY) (MSE G a fP y0 baseA) PCs) baseS) ;

    -- their values over G.X, at (w , gam w)
    PAW : Id (Ty (ext G X)) (subT (ext G X) Dy CMa sg) (MapY (ext G X) a1 wX) = MapY-ov (ext G X) Dy aD wD sg a1 Pa1 wX Pw1 ;
    apW : El (ext G X) (MapY (ext G X) a1 wX) = trE (ext G X) (subT (ext G X) Dy CMa sg) (MapY (ext G X) a1 wX) PAW (subt (ext G X) Dy CMa apJ sg) ;
    PSW : Id (Ty (ext G X)) (subT (ext G X) Dy CMs sg) (MSE (ext G X) a1 fP1 wX apW) =
      MSE-ov (ext G X) Dy aD fPD wD apJ sg a1 Pa1 fP1 PfP1 wX Pw1 apW (refl apW) ;
    SEW : El (ext G X) (MSE (ext G X) a1 fP1 wX apW) = trE (ext G X) (subT (ext G X) Dy CMs sg) (MSE (ext G X) a1 fP1 wX apW) PSW (subt (ext G X) Dy CMs SEJ sg) ;

    ----------------------------------------------------------------------
    -- (5) over Gm = K.P (variables b , e): the pair map sgm : Gm -> G.X,
    -- the section g, and f (g e) = e

    Gm : Ctx = ext K P ;
    pP : Sub Gm K = p K P ;
    pp : Sub Gm G = o Gm K G (p G U0) pP ;
    So : Id (Ty Gm) (subT Gm G U0 pp) (JP.wwT G U0 P U0) = subT-o Gm K G U0 (p G U0) pP ;
    CdG : Ty Gm = Un.Cod Gm ;
    CNG : Id (Ty Gm) (subT Gm G U0 pp) CdG = Un.Cod-nat Gm G pp ;
    PU : Id (Ty Gm) (JP.wwT G U0 P U0) CdG = trans (Ty Gm) (JP.wwT G U0 P U0) (subT Gm G U0 pp) CdG (sym (Ty Gm) (subT Gm G U0 pp) (JP.wwT G U0 P U0) So) CNG ;
    aG : El Gm CdG = trE Gm (JP.wwT G U0 P U0) CdG PU (JP.wwE G U0 P U0 a) ;
    bG : El Gm CdG = trE Gm (JP.wwT G U0 P U0) CdG PU (JP.zv G U0 P) ;

    PaG : Ov Gm G U0 pp CdG CNG a aG =
      trSame Gm (subT Gm G U0 pp) (JP.wwT G U0 P U0) CdG CNG PU So (subt Gm G U0 a pp) (JP.wwE G U0 P U0 a) (subt-o Gm K G U0 a (p G U0) pP) ;

    upG : Sub (ext Gm CdG) K = upT Gm G U0 pp CdG CNG ;

    -- upG o sec bG = p : the pair (pp , b) is p (sub-eta)
    SPb : Id (Sub Gm K) (o Gm (ext Gm CdG) K upG (sec Gm CdG bG)) pP =
      trans (Sub Gm K) (o Gm (ext Gm CdG) K upG (sec Gm CdG bG))
                       (o Gm (ext Gm (subT Gm G U0 pp)) K (lift Gm G U0 pp) (sec Gm (subT Gm G U0 pp) (trE Gm CdG (subT Gm G U0 pp) (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG) bG)))
                       pP
        (IN.upT-sec Gm G U0 (subT Gm G U0 pp) CdG CNG (lift Gm G U0 pp) bG)
        (trans (Sub Gm K) (o Gm (ext Gm (subT Gm G U0 pp)) K (lift Gm G U0 pp) (sec Gm (subT Gm G U0 pp) (trE Gm CdG (subT Gm G U0 pp) (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG) bG)))
                          (extS Gm G U0 pp (IN.qOf Gm G U0 pP)) pP
           (ap (El Gm (subT Gm G U0 pp)) (Sub Gm K) (\ v -> o Gm (ext Gm (subT Gm G U0 pp)) K (lift Gm G U0 pp) (sec Gm (subT Gm G U0 pp) v))
               (trE Gm CdG (subT Gm G U0 pp) (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG) bG) (IN.qOf Gm G U0 pP)
               (trans (El Gm (subT Gm G U0 pp)) (trE Gm CdG (subT Gm G U0 pp) (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG) bG)
                  (trE Gm (JP.wwT G U0 P U0) (subT Gm G U0 pp) (trans (Ty Gm) (JP.wwT G U0 P U0) CdG (subT Gm G U0 pp) PU (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG)) (JP.zv G U0 P))
                  (IN.qOf Gm G U0 pP)
                  (trE-tr Gm (JP.wwT G U0 P U0) CdG (subT Gm G U0 pp) PU (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG) (JP.zv G U0 P))
                  (trE-irr Gm (JP.wwT G U0 P U0) (subT Gm G U0 pp) (trans (Ty Gm) (JP.wwT G U0 P U0) CdG (subT Gm G U0 pp) PU (sym (Ty Gm) (subT Gm G U0 pp) CdG CNG))
                     (sym (Ty Gm) (subT Gm G U0 pp) (JP.wwT G U0 P U0) So) (JP.zv G U0 P))))
           (sym (Sub Gm K) pP (extS Gm G U0 pp (IN.qOf Gm G U0 pP)) (IN.sub-eta Gm G U0 pP))) ;

    PE : Id (Ty Gm) (wkT K P P) (PBat Gm aG bG) =
      trans (Ty Gm) (wkT K P P) (subT Gm K P (o Gm (ext Gm CdG) K upG (sec Gm CdG bG))) (PBat Gm aG bG)
        (ap (Sub Gm K) (Ty Gm) (\ t -> subT Gm K P t) pP (o Gm (ext Gm CdG) K upG (sec Gm CdG bG))
            (sym (Sub Gm K) (o Gm (ext Gm CdG) K upG (sec Gm CdG bG)) pP SPb))
        (trans (Ty Gm) (subT Gm K P (o Gm (ext Gm CdG) K upG (sec Gm CdG bG))) (subT Gm (ext Gm CdG) (subT (ext Gm CdG) K P upG) (sec Gm CdG bG)) (PBat Gm aG bG)
           (subT-o Gm (ext Gm CdG) K P upG (sec Gm CdG bG))
           (ap (Ty (ext Gm CdG)) (Ty Gm) (\ Y -> subT Gm (ext Gm CdG) Y (sec Gm CdG bG)) (subT (ext Gm CdG) K P upG) (UU.PB Gm aG)
               (UU.PB-ov Gm G a pp aG PaG))) ;

    eG : El Gm (PBat Gm aG bG) = trE Gm (wkT K P P) (PBat Gm aG bG) PE (q K P) ;
    wG : El Gm (UU.UaT Gm aG) = IN.pr Gm CdG (UU.PB Gm aG) bG eG ;
    UXG : Id (Ty Gm) (subT Gm G X pp) (UU.UaT Gm aG) = UU.UaT-ov' Gm G a pp aG PaG ;
    wpp : El Gm (subT Gm G X pp) = trE Gm (UU.UaT Gm aG) (subT Gm G X pp) (sym (Ty Gm) (subT Gm G X pp) (UU.UaT Gm aG) UXG) wG ;
    sgm : Sub Gm (ext G X) = extS Gm G X pp wpp ;

    -- over-paths along sgm
    Pa1s : Ov Gm (ext G X) (Un.Cod (ext G X)) sgm CdG (Un.Cod-nat Gm (ext G X) sgm) a1 aG =
      trans (El Gm CdG) (trE Gm (subT Gm (ext G X) (Un.Cod (ext G X)) sgm) CdG (Un.Cod-nat Gm (ext G X) sgm) (subt Gm (ext G X) (Un.Cod (ext G X)) a1 sgm))
                        (trE Gm (subT Gm G U0 pp) CdG CNG (subt Gm G U0 a pp)) aG
        (ovTr Gm (ext G X) (wkT G X U0) (Un.Cod (ext G X)) CN1 sgm (subT Gm G U0 pp) CdG CNG (IN.wkT-extS Gm G X U0 pp wpp)
           (Un.Cod-nat Gm (ext G X) sgm) (wkE G X U0 a) (subt Gm G U0 a pp)
           (IN.wkE-extS Gm G X U0 a pp wpp (IN.wkT-extS Gm G X U0 pp wpp)))
        PaG ;

    Pws : Ov Gm (ext G X) (UU.UaT (ext G X) a1) sgm (UU.UaT Gm aG) (UU.UaT-ov' Gm (ext G X) a1 sgm aG Pa1s) wX wG =
      trans (El Gm (UU.UaT Gm aG)) (trE Gm (subT Gm (ext G X) (UU.UaT (ext G X) a1) sgm) (UU.UaT Gm aG) (UU.UaT-ov' Gm (ext G X) a1 sgm aG Pa1s) (subt Gm (ext G X) (UU.UaT (ext G X) a1) wX sgm))
                                   (trE Gm (subT Gm G X pp) (UU.UaT Gm aG) UXG wpp) wG
        (ovTr Gm (ext G X) (wkT G X X) (UU.UaT (ext G X) a1) UP1 sgm (subT Gm G X pp) (UU.UaT Gm aG) UXG (IN.wkT-extS Gm G X X pp wpp)
           (UU.UaT-ov' Gm (ext G X) a1 sgm aG Pa1s) (q G X) wpp (JP.q-extS Gm G X pp wpp (IN.wkT-extS Gm G X X pp wpp)))
        (JP.trE-sym Gm (subT Gm G X pp) (UU.UaT Gm aG) UXG wG) ;

    fPG : El Gm (FPT Gm aG) = trE Gm (subT Gm G (FPT G a) pp) (FPT Gm aG) (FPT-ov Gm G a pp aG PaG) (subt Gm G (FPT G a) fP pp) ;

    PfPs : Ov Gm (ext G X) (FPT (ext G X) a1) sgm (FPT Gm aG) (FPT-ov Gm (ext G X) a1 sgm aG Pa1s) fP1 fPG =
      ovTr Gm (ext G X) (wkT G X (FPT G a)) (FPT (ext G X) a1) FP1 sgm (subT Gm G (FPT G a) pp) (FPT Gm aG) (FPT-ov Gm G a pp aG PaG)
        (IN.wkT-extS Gm G X (FPT G a) pp wpp) (FPT-ov Gm (ext G X) a1 sgm aG Pa1s) (wkE G X (FPT G a) fP) (subt Gm G (FPT G a) fP pp)
        (IN.wkE-extS Gm G X (FPT G a) fP pp wpp (IN.wkT-extS Gm G X (FPT G a) pp wpp)) ;

    -- apY and SE at the pair (b , e)
    PAs : Id (Ty Gm) (subT Gm (ext G X) (MapY (ext G X) a1 wX) sgm) (MapY Gm aG wG) = MapY-ov Gm (ext G X) a1 wX sgm aG Pa1s wG Pws ;
    apG : El Gm (MapY Gm aG wG) = trE Gm (subT Gm (ext G X) (MapY (ext G X) a1 wX) sgm) (MapY Gm aG wG) PAs (subt Gm (ext G X) (MapY (ext G X) a1 wX) apW sgm) ;
    PSs : Id (Ty Gm) (subT Gm (ext G X) (MSE (ext G X) a1 fP1 wX apW) sgm) (MSE Gm aG fPG wG apG) =
      MSE-ov Gm (ext G X) a1 fP1 wX apW sgm aG Pa1s fPG PfPs wG Pws apG (refl apG) ;
    SEG : El Gm (MSE Gm aG fPG wG apG) = trE Gm (subT Gm (ext G X) (MSE (ext G X) a1 fP1 wX apW) sgm) (MSE Gm aG fPG wG apG) PSs (subt Gm (ext G X) (MSE (ext G X) a1 fP1 wX apW) SEW sgm) ;

    -- the section g
    WI : Ty Gm = wkT K P IKa ;
    WP : Ty Gm = wkT K P P ;
    IdKP : Id (Ty Gm) WI (IJ.IdT Gm CdG aG bG) =
      Id-ov Gm K (wkT G U0 U0) (wkE G U0 U0 a) (q G U0) pP CdG PU aG bG (refl aG) (refl bG) ;
    fstw : Id (El Gm CdG) (IN.fst Gm CdG (UU.PB Gm aG) wG) bG = IN.fst-pr Gm CdG (UU.PB Gm aG) bG eG ;
    MYG : Id (Ty Gm) (MapY Gm aG wG) (IJ.IdT Gm CdG aG bG) =
      ap (El Gm CdG) (Ty Gm) (\ v -> IJ.IdT Gm CdG aG v) (IN.fst Gm CdG (UU.PB Gm aG) wG) bG fstw ;
    gB : El Gm WI = trE Gm (MapY Gm aG wG) WI (trans (Ty Gm) (MapY Gm aG wG) (IJ.IdT Gm CdG aG bG) WI MYG (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP)) apG ;
    g : El K (Fun K P IKa) = lam K P WI gB ;

    -- f weakened to Gm is fP at b
    PBF : Id (Ty (ext Gm CdG)) (subT (ext Gm CdG) K (Fun K IKa P) upG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) =
      Fun-ov (ext Gm CdG) K IKa P upG (JP.IK Gm CdG aG) (JP.IK-ov Gm G U0 a pp CdG CNG aG PaG) (UU.PB Gm aG) (UU.PB-ov Gm G a pp aG PaG) ;
    f' : El (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) =
      trE (ext Gm CdG) (subT (ext Gm CdG) K (Fun K IKa P) upG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) PBF (subt (ext Gm CdG) K (Fun K IKa P) f upG) ;
    fPG-lam : Id (El Gm (FPT Gm aG)) fPG (lam Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f') =
      IN.lam-ov Gm G U0 (Fun K IKa P) pp CdG CNG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) PBF (FPT-ov Gm G a pp aG PaG) f f' (refl f') ;

    -- fAt b is a transport of f[p] (= f weakened)
    fAtTE : IN.TE Gm (subT Gm K (Fun K IKa P) pP) (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG))
                     (subt Gm K (Fun K IKa P) f pP) (fAt Gm aG fPG bG) =
      IN.teT Gm (subT Gm K (Fun K IKa P) pP) (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG))
                (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG))
        (subt Gm K (Fun K IKa P) f pP) (subt Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' (sec Gm CdG bG)) (fAt Gm aG fPG bG)
        (IN.teT Gm (subT Gm K (Fun K IKa P) pP) (subT Gm K (Fun K IKa P) (o Gm (ext Gm CdG) K upG (sec Gm CdG bG)))
                   (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG))
           (subt Gm K (Fun K IKa P) f pP) (subt Gm K (Fun K IKa P) f (o Gm (ext Gm CdG) K upG (sec Gm CdG bG)))
           (subt Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' (sec Gm CdG bG))
           (IN.teSubEq Gm K (Fun K IKa P) f pP (o Gm (ext Gm CdG) K upG (sec Gm CdG bG)) (sym (Sub Gm K) (o Gm (ext Gm CdG) K upG (sec Gm CdG bG)) pP SPb))
           (IN.teT Gm (subT Gm K (Fun K IKa P) (o Gm (ext Gm CdG) K upG (sec Gm CdG bG))) (subT Gm (ext Gm CdG) (subT (ext Gm CdG) K (Fun K IKa P) upG) (sec Gm CdG bG))
                      (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG))
              (subt Gm K (Fun K IKa P) f (o Gm (ext Gm CdG) K upG (sec Gm CdG bG))) (subt Gm (ext Gm CdG) (subT (ext Gm CdG) K (Fun K IKa P) upG) (subt (ext Gm CdG) K (Fun K IKa P) f upG) (sec Gm CdG bG))
              (subt Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' (sec Gm CdG bG))
              (IN.teSubtO Gm (ext Gm CdG) K (Fun K IKa P) f upG (sec Gm CdG bG))
              (IN.teSubtTr Gm (ext Gm CdG) (subT (ext Gm CdG) K (Fun K IKa P) upG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) PBF
                 (subt (ext Gm CdG) K (Fun K IKa P) f upG) (sec Gm CdG bG))))
        (FFun Gm aG bG,
         ap (El Gm (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG))) (El Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)))
            (\ v -> trE Gm (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG)) (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (FFun Gm aG bG) v)
            (subt Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' (sec Gm CdG bG))
            (IN.appD Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) fPG bG)
            (sym (El Gm (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG)))
                 (IN.appD Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) fPG bG)
                 (subt Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' (sec Gm CdG bG))
                 (trans (El Gm (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG)))
                    (IN.appD Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) fPG bG)
                    (IN.appD Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (lam Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f') bG)
                    (subt Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' (sec Gm CdG bG))
                    (ap (El Gm (FPT Gm aG)) (El Gm (subT Gm (ext Gm CdG) (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) (sec Gm CdG bG)))
                        (\ F -> IN.appD Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) F bG) fPG
                        (lam Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f') fPG-lam)
                    (IN.appD-lam Gm CdG (Fun (ext Gm CdG) (JP.IK Gm CdG aG) (UU.PB Gm aG)) f' bG)))) ;

    -- f (g e) = e, over Gm
    fW : El Gm (Fun Gm WI WP) = EQ.wkF K P IKa P f ;
    gW : El Gm (Fun Gm WP WI) = EQ.wkF K P P IKa g ;
    HB : Ty Gm = IJ.IdT Gm WP (app Gm WI WP fW (app Gm WP WI gW (q K P))) (q K P) ;

    fwb : El Gm CdG = IN.fst Gm CdG (UU.PB Gm aG) wG ;
    TP : Id (Ty Gm) (PBat Gm aG fwb) WP =
      trans (Ty Gm) (PBat Gm aG fwb) (PBat Gm aG bG) WP (ap (El Gm CdG) (Ty Gm) (\ v -> PBat Gm aG v) fwb bG fstw) (sym (Ty Gm) WP (PBat Gm aG bG) PE) ;

    -- fAt along a path of points
    appAt (b2 : El Gm CdG) (pi : Id (El Gm CdG) fwb b2)
      : Id (El Gm (PBat Gm aG b2))
           (trE Gm (PBat Gm aG fwb) (PBat Gm aG b2) (ap (El Gm CdG) (Ty Gm) (\ v -> PBat Gm aG v) fwb b2 pi)
              (app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG))
           (app Gm (IJ.IdT Gm CdG aG b2) (PBat Gm aG b2) (fAt Gm aG fPG b2)
              (trE Gm (IJ.IdT Gm CdG aG fwb) (IJ.IdT Gm CdG aG b2) (ap (El Gm CdG) (Ty Gm) (\ v -> IJ.IdT Gm CdG aG v) fwb b2 pi) apG)) =
      idJ (El Gm CdG) fwb
        (\ b3 pi3 -> Id (El Gm (PBat Gm aG b3))
           (trE Gm (PBat Gm aG fwb) (PBat Gm aG b3) (ap (El Gm CdG) (Ty Gm) (\ v -> PBat Gm aG v) fwb b3 pi3)
              (app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG))
           (app Gm (IJ.IdT Gm CdG aG b3) (PBat Gm aG b3) (fAt Gm aG fPG b3)
              (trE Gm (IJ.IdT Gm CdG aG fwb) (IJ.IdT Gm CdG aG b3) (ap (El Gm CdG) (Ty Gm) (\ v -> IJ.IdT Gm CdG aG v) fwb b3 pi3) apG)))
        (refl (app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG)) b2 pi ;

    PF2 : Id (Ty Gm) (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI WP) =
      trans (Ty Gm) (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI (PBat Gm aG bG)) (Fun Gm WI WP)
        (ap (Ty Gm) (Ty Gm) (\ Z -> Fun Gm Z (PBat Gm aG bG)) (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP))
        (ap (Ty Gm) (Ty Gm) (\ Z -> Fun Gm WI Z) (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE)) ;

    fAt-fW : Id (El Gm (Fun Gm WI WP)) (trE Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI WP) PF2 (fAt Gm aG fPG bG)) fW =
      IN.teAny Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI WP) (fAt Gm aG fPG bG) fW
        (IN.teT Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (subT Gm K (Fun K IKa P) pP) (Fun Gm WI WP)
           (fAt Gm aG fPG bG) (subt Gm K (Fun K IKa P) f pP) fW
           (IN.teS Gm (subT Gm K (Fun K IKa P) pP) (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (subt Gm K (Fun K IKa P) f pP) (fAt Gm aG fPG bG) fAtTE)
           (IN.teTr Gm (subT Gm K (Fun K IKa P) pP) (Fun Gm WI WP) (EQ.wkFP K P IKa P) (subt Gm K (Fun K IKa P) f pP)))
        PF2 ;

    Pa-sec : Id (El Gm WP) (trE Gm (PBat Gm aG fwb) WP TP (app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG))
                           (app Gm WI WP fW (app Gm WP WI gW (q K P))) =
      calc (El Gm WP) {
          trE Gm (PBat Gm aG fwb) WP TP (app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG)
        =< sym (El Gm WP) (trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf L0))
             (trE Gm (PBat Gm aG fwb) WP TP L0) (trE-tr Gm (PBat Gm aG fwb) (PBat Gm aG bG) WP APf (sym (Ty Gm) WP (PBat Gm aG bG) PE) L0) >
          trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf L0)
        =< ap (El Gm (PBat Gm aG bG)) (El Gm WP) (\ v -> trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) v)
             (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf L0) (app Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG) (fAt Gm aG fPG bG) r')
             (appAt bG fstw) >
          trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) (app Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG) (fAt Gm aG fPG bG) r')
        =< sym (El Gm WP) (app Gm WI WP (trE Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI WP) PF2 (fAt Gm aG fPG bG))
                                      (trE Gm (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) r'))
             (trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) (app Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG) (fAt Gm aG fPG bG) r'))
             (IN.app-tr2 Gm (IJ.IdT Gm CdG aG bG) WI (PBat Gm aG bG) WP (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) (sym (Ty Gm) WP (PBat Gm aG bG) PE)
                PF2 (fAt Gm aG fPG bG) r') >
          app Gm WI WP (trE Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI WP) PF2 (fAt Gm aG fPG bG))
                       (trE Gm (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) r')
        =< ap (El Gm (Fun Gm WI WP)) (El Gm WP) (\ F -> app Gm WI WP F (trE Gm (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) r'))
             (trE Gm (Fun Gm (IJ.IdT Gm CdG aG bG) (PBat Gm aG bG)) (Fun Gm WI WP) PF2 (fAt Gm aG fPG bG)) fW fAt-fW >
          app Gm WI WP fW (trE Gm (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) r')
        =< ap (El Gm WI) (El Gm WP) (\ v -> app Gm WI WP fW v) (trE Gm (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) r')
             (app Gm WP WI gW (q K P))
             (trans (El Gm WI) (trE Gm (IJ.IdT Gm CdG aG bG) WI (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) r') gB (app Gm WP WI gW (q K P))
                (trE-tr Gm (MapY Gm aG wG) (IJ.IdT Gm CdG aG bG) WI MYG (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP) apG)
                (sym (El Gm WI) (app Gm WP WI gW (q K P)) gB (IN.appWkLamQ K P IKa gB))) >
          app Gm WI WP fW (app Gm WP WI gW (q K P)) }
     where {
      APf : Id (Ty Gm) (PBat Gm aG fwb) (PBat Gm aG bG) = ap (El Gm CdG) (Ty Gm) (\ v -> PBat Gm aG v) fwb bG fstw ;
      L0 : El Gm (PBat Gm aG fwb) = app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG ;
      r' : El Gm (IJ.IdT Gm CdG aG bG) = trE Gm (MapY Gm aG wG) (IJ.IdT Gm CdG aG bG) MYG apG ;
     } ;

    Pb-sec : Id (El Gm WP) (trE Gm (PBat Gm aG fwb) WP TP (IN.snd Gm CdG (UU.PB Gm aG) wG)) (q K P) =
      calc (El Gm WP) {
          trE Gm (PBat Gm aG fwb) WP TP (IN.snd Gm CdG (UU.PB Gm aG) wG)
        =< sym (El Gm WP) (trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf (IN.snd Gm CdG (UU.PB Gm aG) wG)))
             (trE Gm (PBat Gm aG fwb) WP TP (IN.snd Gm CdG (UU.PB Gm aG) wG))
             (trE-tr Gm (PBat Gm aG fwb) (PBat Gm aG bG) WP APf (sym (Ty Gm) WP (PBat Gm aG bG) PE) (IN.snd Gm CdG (UU.PB Gm aG) wG)) >
          trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf (IN.snd Gm CdG (UU.PB Gm aG) wG))
        =< ap (El Gm (PBat Gm aG bG)) (El Gm WP) (\ v -> trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) v)
             (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf (IN.snd Gm CdG (UU.PB Gm aG) wG)) eG
             (trans (El Gm (PBat Gm aG bG)) (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf (IN.snd Gm CdG (UU.PB Gm aG) wG))
                (subst (El Gm CdG) (\ v -> El Gm (PBat Gm aG v)) fwb bG fstw (IN.snd Gm CdG (UU.PB Gm aG) wG)) eG
                (sym (El Gm (PBat Gm aG bG)) (subst (El Gm CdG) (\ v -> El Gm (PBat Gm aG v)) fwb bG fstw (IN.snd Gm CdG (UU.PB Gm aG) wG))
                     (trE Gm (PBat Gm aG fwb) (PBat Gm aG bG) APf (IN.snd Gm CdG (UU.PB Gm aG) wG))
                     (subst-ap (El Gm CdG) (Ty Gm) (\ v -> PBat Gm aG v) (El Gm) fwb bG fstw (IN.snd Gm CdG (UU.PB Gm aG) wG)))
                (IN.snd-pr Gm CdG (UU.PB Gm aG) bG eG)) >
          trE Gm (PBat Gm aG bG) WP (sym (Ty Gm) WP (PBat Gm aG bG) PE) eG
        =< IN.trE-symL Gm WP (PBat Gm aG bG) PE (q K P) >
          q K P }
     where { APf : Id (Ty Gm) (PBat Gm aG fwb) (PBat Gm aG bG) = ap (El Gm CdG) (Ty Gm) (\ v -> PBat Gm aG v) fwb bG fstw ; } ;

    secB : El Gm HB =
      trE Gm (MSE Gm aG fPG wG apG) HB
        (DJ.idCong Gm (PBat Gm aG fwb) WP TP (app Gm (IJ.IdT Gm CdG aG fwb) (PBat Gm aG fwb) (fAt Gm aG fPG fwb) apG) (IN.snd Gm CdG (UU.PB Gm aG) wG)
           (app Gm WI WP fW (app Gm WP WI gW (q K P))) (q K P) Pa-sec Pb-sec)
        SEG ;

    etaH : El K (EQ.Htpy K IKa P f g) = lam K P HB secB ;

    ----------------------------------------------------------------------
    -- (6) apY at gam y0 is apY at refl, internally (J on gam y0 = refl)

    Iyy : Ty G = IJ.IdT G X y0 y0 ;
    T0 : Ty G = MapY G a y0 ;
    up1y : Sub (ext G Iyy) Dy = JP.up1 G X Bv y0 Iyy (JP.IKpt G X y0 y0) ;

    aI : El (ext G Iyy) (Un.Cod (ext G Iyy)) = trE (ext G Iyy) (wkT G Iyy U0) (Un.Cod (ext G Iyy)) (Un.Cod-nat (ext G Iyy) G (p G Iyy)) (wkE G Iyy U0 a) ;
    wI : El (ext G Iyy) (UU.UaT (ext G Iyy) aI) =
      trE (ext G Iyy) (wkT G Iyy X) (UU.UaT (ext G Iyy) aI) (UU.UaT-ov' (ext G Iyy) G a (p G Iyy) aI (refl aI)) (wkE G Iyy X y0) ;

    PW1 : Id (Ty (ext G Iyy)) (subT (ext G Iyy) Dy (JP.wwT G X Bv U0) up1y) (wkT G Iyy U0) =
      wkT-ov G (ext G X) Bv (wkT G X U0) (sec G X y0) Iyy (JP.IKpt G X y0 y0) U0 (p-sec-T G X U0 y0) ;
    PaU : Ov (ext G Iyy) Dy (Un.Cod Dy) up1y (Un.Cod (ext G Iyy)) (Un.Cod-nat (ext G Iyy) Dy up1y) aD aI =
      ovTr (ext G Iyy) Dy (JP.wwT G X Bv U0) (Un.Cod Dy) CN2 up1y (wkT G Iyy U0) (Un.Cod (ext G Iyy)) (Un.Cod-nat (ext G Iyy) G (p G Iyy))
        PW1 (Un.Cod-nat (ext G Iyy) Dy up1y) (JP.wwE G X Bv U0 a) (wkE G Iyy U0 a)
        (wkE-ov G (ext G X) Bv (wkT G X U0) (wkE G X U0 a) (sec G X y0) Iyy (JP.IKpt G X y0 y0) U0 (p-sec-T G X U0 y0) a
           (IN.wkE-sec G X U0 y0 a (p-sec-T G X U0 y0)) PW1) ;
    PW2 : Id (Ty (ext G Iyy)) (subT (ext G Iyy) Dy (JP.wwT G X Bv X) up1y) (wkT G Iyy X) =
      wkT-ov G (ext G X) Bv (wkT G X X) (sec G X y0) Iyy (JP.IKpt G X y0 y0) X (p-sec-T G X X y0) ;
    PwU : Ov (ext G Iyy) Dy (UU.UaT Dy aD) up1y (UU.UaT (ext G Iyy) aI) (UU.UaT-ov' (ext G Iyy) Dy aD up1y aI PaU) wD wI =
      ovTr (ext G Iyy) Dy (JP.wwT G X Bv X) (UU.UaT Dy aD) UP2 up1y (wkT G Iyy X) (UU.UaT (ext G Iyy) aI)
        (UU.UaT-ov' (ext G Iyy) G a (p G Iyy) aI (refl aI)) PW2 (UU.UaT-ov' (ext G Iyy) Dy aD up1y aI PaU) (JP.zv G X Bv) (wkE G Iyy X y0)
        (wkE-ov G (ext G X) Bv (wkT G X X) (q G X) (sec G X y0) Iyy (JP.IKpt G X y0 y0) X (p-sec-T G X X y0) y0
           (IN.q-secO G X y0 (p-sec-T G X X y0)) PW2) ;

    TT : Id (Ty (ext G Iyy)) (subT (ext G Iyy) Dy CMa up1y) (wkT G Iyy T0) =
      trans (Ty (ext G Iyy)) (subT (ext G Iyy) Dy CMa up1y) (MapY (ext G Iyy) aI wI) (wkT G Iyy T0)
        (MapY-ov (ext G Iyy) Dy aD wD up1y aI PaU wI PwU)
        (sym (Ty (ext G Iyy)) (wkT G Iyy T0) (MapY (ext G Iyy) aI wI) (MapY-ov (ext G Iyy) G a y0 (p G Iyy) aI (refl aI) wI (refl wI))) ;

    -- apY at (y0 , v), for v : Id(y0 , y0)
    ap0 : El (ext G Iyy) (wkT G Iyy T0) = trE (ext G Iyy) (subT (ext G Iyy) Dy CMa up1y) (wkT G Iyy T0) TT (subt (ext G Iyy) Dy CMa apJ up1y) ;
    apAt (v : El G Iyy) : El G T0 = trE G (subT G (ext G Iyy) (wkT G Iyy T0) (sec G Iyy v)) T0 (p-sec-T G Iyy T0 v) (subt G (ext G Iyy) (wkT G Iyy T0) ap0 (sec G Iyy v)) ;

    -- apY at (y0 , v) is a transport of apJ at the point (y0 , v)
    apAtTE (v : El G Iyy) : IN.TE G (subT G Dy CMa (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) v)) T0
                                   (subt G Dy CMa apJ (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) v)) (apAt v) =
      IN.teT G (subT G Dy CMa (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) v)) (subT G (ext G Iyy) (subT (ext G Iyy) Dy CMa up1y) (sec G Iyy v)) T0
        (subt G Dy CMa apJ (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) v))
        (subt G (ext G Iyy) (subT (ext G Iyy) Dy CMa up1y) (subt (ext G Iyy) Dy CMa apJ up1y) (sec G Iyy v)) (apAt v)
        (IN.teSubtO G (ext G Iyy) Dy CMa apJ up1y (sec G Iyy v))
        (IN.teT G (subT G (ext G Iyy) (subT (ext G Iyy) Dy CMa up1y) (sec G Iyy v)) (subT G (ext G Iyy) (wkT G Iyy T0) (sec G Iyy v)) T0
           (subt G (ext G Iyy) (subT (ext G Iyy) Dy CMa up1y) (subt (ext G Iyy) Dy CMa apJ up1y) (sec G Iyy v))
           (subt G (ext G Iyy) (wkT G Iyy T0) ap0 (sec G Iyy v)) (apAt v)
           (IN.teSubtTr G (ext G Iyy) (subT (ext G Iyy) Dy CMa up1y) (wkT G Iyy T0) TT (subt (ext G Iyy) Dy CMa apJ up1y) (sec G Iyy v))
           (IN.teTr G (subT G (ext G Iyy) (wkT G Iyy T0) (sec G Iyy v)) T0 (p-sec-T G Iyy T0 v) (subt G (ext G Iyy) (wkT G Iyy T0) ap0 (sec G Iyy v)))) ;

    -- at refl it is the start of apY
    apR-eq : Id (El G T0) (apAt (IJ.rfl G X y0)) baseA =
      trans (El G T0) (apAt (IJ.rfl G X y0)) (trE G SI T0 (apAtTE (IJ.rfl G X y0)).1 xI) baseA
        (sym (El G T0) (trE G SI T0 (apAtTE (IJ.rfl G X y0)).1 xI) (apAt (IJ.rfl G X y0)) (apAtTE (IJ.rfl G X y0)).2)
        (IN.teAny G SI T0 xI baseA
           (IN.teT G SI (subT G Dy CMa cY) T0 xI (subt G Dy CMa apJ cY) baseA
              (IN.teSubEq G Dy CMa apJ (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) (IJ.rfl G X y0)) cY (JP.instRefl G X y0))
              (IN.teOv G Dy CMa cY (MapY G a y0) PCa apJ baseA apb))
           (apAtTE (IJ.rfl G X y0)).1)
     where {
      SI : Ty G = subT G Dy CMa (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) (IJ.rfl G X y0)) ;
      xI : El G SI = subt G Dy CMa apJ (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) (IJ.rfl G X y0)) ;
     } ;

    -- gam y0, and gam y0 = refl (CwFContr)
    theta : El G Iyy = trE G (subT G (ext G X) Bv (sec G X y0)) Iyy (JP.IKpt G X y0 y0) (subt G (ext G X) Bv NM.gam (sec G X y0)) ;
    Omega : El G (IJ.IdT G Iyy theta (IJ.rfl G X y0)) =
      trE G (CF.MTh G X c y0 NM.dy NM.T1y) (IJ.IdT G Iyy theta (IJ.rfl G X y0))
        (ap (El G Iyy) (Ty G) (\ v -> IJ.IdT G Iyy v (IJ.rfl G X y0)) (app G NM.Iy Iyy (CF.TA G X c y0 NM.T1y) NM.dy) theta
            (sym (El G Iyy) theta (app G NM.Iy Iyy (CF.TA G X c y0 NM.T1y) NM.dy) NM.gamAt))
        NM.Thy ;

    -- Theta': J on gam y0 = refl, motive Id(apY(y0 , gam y0) , apY(y0 , v))
    Bt : Ty (ext G Iyy) = JP.IK G Iyy theta ;
    Dt : Ctx = JP.Dx G Iyy theta ;
    CMt : Ty Dt = IJ.IdT Dt (JP.wwT G Iyy Bt T0) (JP.wwE G Iyy Bt T0 (apAt theta)) (wkE (ext G Iyy) Bt (wkT G Iyy T0) ap0) ;

    -- its value at a point (v , d) of Dt
    PCt (v : El G Iyy) (I' : Ty G) (P' : Id (Ty G) (subT G (ext G Iyy) Bt (sec G Iyy v)) I') (d : El G I')
      : Id (Ty G) (subT G Dt CMt (JP.instG G Iyy Bt v I' P' d)) (IJ.IdT G T0 (apAt theta) (apAt v)) =
      Id-ov G Dt (JP.wwT G Iyy Bt T0) (JP.wwE G Iyy Bt T0 (apAt theta)) (wkE (ext G Iyy) Bt (wkT G Iyy T0) ap0) (JP.instG G Iyy Bt v I' P' d) T0 PWT
        (apAt theta) (apAt v)
        (JP.wwE-inst G Iyy Bt v I' P' d T0 (apAt theta) PWT)
        (ovTr G Dt (wkT (ext G Iyy) Bt (wkT G Iyy T0)) (wkT (ext G Iyy) Bt (wkT G Iyy T0)) (refl (wkT (ext G Iyy) Bt (wkT G Iyy T0)))
           (JP.instG G Iyy Bt v I' P' d) (subT G (ext G Iyy) (wkT G Iyy T0) (sec G Iyy v)) T0 (p-sec-T G Iyy T0 v)
           (JP.wT-inst G Iyy Bt v I' P' d (wkT G Iyy T0)) PWT (wkE (ext G Iyy) Bt (wkT G Iyy T0) ap0) (subt G (ext G Iyy) (wkT G Iyy T0) ap0 (sec G Iyy v))
           (JP.wE-inst G Iyy Bt v I' P' d (wkT G Iyy T0) ap0 (JP.wT-inst G Iyy Bt v I' P' d (wkT G Iyy T0))))
     where { PWT : Id (Ty G) (subT G Dt (JP.wwT G Iyy Bt T0) (JP.instG G Iyy Bt v I' P' d)) T0 = JP.wwT-inst G Iyy Bt v I' P' d T0 ; } ;

    I0t : Ty G = subT G (ext G Iyy) Bt (sec G Iyy theta) ;
    PCt0 : Id (Ty G) (subT G Dt CMt (DJ.cen G Iyy theta)) (IJ.IdT G T0 (apAt theta) (apAt theta)) =
      PCt theta I0t (refl I0t) (DJ.reflE G Iyy theta) ;
    ThJ' : El Dt CMt =
      IJ.J G Iyy theta CMt (trE G (IJ.IdT G T0 (apAt theta) (apAt theta)) (subT G Dt CMt (DJ.cen G Iyy theta))
                              (sym (Ty G) (subT G Dt CMt (DJ.cen G Iyy theta)) (IJ.IdT G T0 (apAt theta) (apAt theta)) PCt0) (IJ.rfl G T0 (apAt theta))) ;

    Ir : Ty G = IJ.IdT G Iyy theta (IJ.rfl G X y0) ;
    iota2 : Sub G Dt = JP.instG G Iyy Bt (IJ.rfl G X y0) Ir (JP.IKpt G Iyy theta (IJ.rfl G X y0)) Omega ;
    Thr : El G (IJ.IdT G T0 (apAt theta) (apAt (IJ.rfl G X y0))) =
      trE G (subT G Dt CMt iota2) (IJ.IdT G T0 (apAt theta) (apAt (IJ.rfl G X y0)))
        (PCt (IJ.rfl G X y0) Ir (JP.IKpt G Iyy theta (IJ.rfl G X y0)) Omega) (subt G Dt CMt ThJ' iota2) ;

    ----------------------------------------------------------------------
    -- (7) g (a , e0) is apY(y0 , gam y0): the pair map at (a , e0) is sec y0

    pt : Sub G Gm = JP.instG G U0 P a Pa (refl Pa) e0 ;

    PaGpt : Ov G Gm CdG pt U0 (Un.Cod-nat G Gm pt) aG a =
      ovTr G Gm (JP.wwT G U0 P U0) CdG PU pt U0 U0 (refl U0) (JP.wwT-inst G U0 P a Pa (refl Pa) e0 U0) (Un.Cod-nat G Gm pt)
        (JP.wwE G U0 P U0 a) a (JP.wwE-inst G U0 P a Pa (refl Pa) e0 U0 a (JP.wwT-inst G U0 P a Pa (refl Pa) e0 U0)) ;
    PbGpt : Ov G Gm CdG pt U0 (Un.Cod-nat G Gm pt) bG a =
      ovTr G Gm (JP.wwT G U0 P U0) CdG PU pt U0 U0 (refl U0) (JP.wwT-inst G U0 P a Pa (refl Pa) e0 U0) (Un.Cod-nat G Gm pt)
        (JP.zv G U0 P) a (JP.zv-inst G U0 P a Pa (refl Pa) e0 (JP.wwT-inst G U0 P a Pa (refl Pa) e0 U0)) ;
    PTe : Id (Ty G) (subT G Gm (PBat Gm aG bG) pt) Pa = PBat-ov G Gm aG bG pt a a PaGpt PbGpt ;
    PeG : Ov G Gm (PBat Gm aG bG) pt Pa PTe eG e0 =
      ovTr G Gm (wkT K P P) (PBat Gm aG bG) PE pt Pa Pa (refl Pa) (JP.qT-inst G U0 P a Pa (refl Pa) e0) PTe (q K P) e0
        (JP.q-inst G U0 P a Pa (refl Pa) e0 (JP.qT-inst G U0 P a Pa (refl Pa) e0)) ;
    PwGpt : Ov G Gm (UU.UaT Gm aG) pt X (UU.UaT-ov' G Gm aG pt a PaGpt) wG y0 =
      IN.pr-ov G Gm CdG (UU.PB Gm aG) pt U0 (Un.Cod-nat G Gm pt) P (UU.PB-ov G Gm aG pt a PaGpt) (UU.UaT-ov' G Gm aG pt a PaGpt)
        bG a PbGpt eG e0 PTe PeG ;

    PX2 : Id (Ty G) (subT G Gm (subT Gm G X pp) pt) X =
      trans (Ty G) (subT G Gm (subT Gm G X pp) pt) (subT G Gm (UU.UaT Gm aG) pt) X
        (ap (Ty Gm) (Ty G) (\ Y -> subT G Gm Y pt) (subT Gm G X pp) (UU.UaT Gm aG) UXG) (UU.UaT-ov' G Gm aG pt a PaGpt) ;
    PX1 : Id (Ty G) (subT G (ext G X) (wkT G X X) (o G Gm (ext G X) sgm pt)) X =
      trans (Ty G) (subT G (ext G X) (wkT G X X) (o G Gm (ext G X) sgm pt)) (subT G Gm (subT Gm (ext G X) (wkT G X X) sgm) pt) X
        (subT-o G Gm (ext G X) (wkT G X X) sgm pt)
        (trans (Ty G) (subT G Gm (subT Gm (ext G X) (wkT G X X) sgm) pt) (subT G Gm (subT Gm G X pp) pt) X
           (ap (Ty Gm) (Ty G) (\ Y -> subT G Gm Y pt) (subT Gm (ext G X) (wkT G X X) sgm) (subT Gm G X pp) (IN.wkT-extS Gm G X X pp wpp)) PX2) ;

    tauEq : Id (Sub G (ext G X)) (o G Gm (ext G X) sgm pt) (sec G X y0) =
      IN.ext-eq G G X (o G Gm (ext G X) sgm pt) (sec G X y0)
        (calc (Sub G G) {
            o G (ext G X) G (p G X) (o G Gm (ext G X) sgm pt)
          =< sym (Sub G G) (o G Gm G (o Gm (ext G X) G (p G X) sgm) pt) (o G (ext G X) G (p G X) (o G Gm (ext G X) sgm pt))
               (o-assoc G Gm (ext G X) G (p G X) sgm pt) >
            o G Gm G (o Gm (ext G X) G (p G X) sgm) pt
          =< ap (Sub Gm G) (Sub G G) (\ t -> o G Gm G t pt) (o Gm (ext G X) G (p G X) sgm) pp (IN.p-extS Gm G X pp wpp) >
            o G Gm G pp pt
          =< o-assoc G Gm K G (p G U0) pP pt >
            o G K G (p G U0) (o G Gm K pP pt)
          =< ap (Sub G K) (Sub G G) (\ t -> o G K G (p G U0) t) (o G Gm K pP pt) (sec G U0 a) (JP.p-inst G U0 P a Pa (refl Pa) e0) >
            o G K G (p G U0) (sec G U0 a)
          =< p-sec G U0 a >
            id G
          =< sym (Sub G G) (o G (ext G X) G (p G X) (sec G X y0)) (id G) (p-sec G X y0) >
            o G (ext G X) G (p G X) (sec G X y0) })
        X y0 PX1
        (JP.ovO G Gm (ext G X) (wkT G X X) sgm pt (subT Gm G X pp) (IN.wkT-extS Gm G X X pp wpp) X PX2 PX1 (q G X) wpp y0
           (JP.q-extS Gm G X pp wpp (IN.wkT-extS Gm G X X pp wpp))
           (ovTr G Gm (UU.UaT Gm aG) (subT Gm G X pp) (sym (Ty Gm) (subT Gm G X pp) (UU.UaT Gm aG) UXG) pt X X (refl X)
              (UU.UaT-ov' G Gm aG pt a PaGpt) PX2 wG y0 PwGpt))
        (p-sec-T G X X y0) (IN.q-secO G X y0 (p-sec-T G X X y0)) ;

    -- sec gam o sec y0 is the point (y0 , gam y0)
    secsec : Id (Sub G Dy) (o G (ext G X) Dy sg (sec G X y0)) (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta) =
      trans (Sub G Dy) (o G (ext G X) Dy sg (sec G X y0))
                       (o G (ext G (subT G (ext G X) Bv (sec G X y0))) Dy (lift G (ext G X) Bv (sec G X y0))
                          (sec G (subT G (ext G X) Bv (sec G X y0)) (subt G (ext G X) Bv NM.gam (sec G X y0))))
                       (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta)
        (sec-o G (ext G X) Bv NM.gam (sec G X y0))
        (sym (Sub G Dy) (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta)
             (o G (ext G (subT G (ext G X) Bv (sec G X y0))) Dy (lift G (ext G X) Bv (sec G X y0))
                (sec G (subT G (ext G X) Bv (sec G X y0)) (subt G (ext G X) Bv NM.gam (sec G X y0))))
             (trans (Sub G Dy) (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta)
                (o G (ext G (subT G (ext G X) Bv (sec G X y0))) Dy (lift G (ext G X) Bv (sec G X y0))
                   (sec G (subT G (ext G X) Bv (sec G X y0)) (trE G Iyy (subT G (ext G X) Bv (sec G X y0)) (sym (Ty G) (subT G (ext G X) Bv (sec G X y0)) Iyy (JP.IKpt G X y0 y0)) theta)))
                (o G (ext G (subT G (ext G X) Bv (sec G X y0))) Dy (lift G (ext G X) Bv (sec G X y0))
                   (sec G (subT G (ext G X) Bv (sec G X y0)) (subt G (ext G X) Bv NM.gam (sec G X y0))))
                (IN.upT-sec G (ext G X) Bv (subT G (ext G X) Bv (sec G X y0)) Iyy (JP.IKpt G X y0 y0) (lift G (ext G X) Bv (sec G X y0)) theta)
                (ap (El G (subT G (ext G X) Bv (sec G X y0))) (Sub G Dy)
                    (\ v -> o G (ext G (subT G (ext G X) Bv (sec G X y0))) Dy (lift G (ext G X) Bv (sec G X y0)) (sec G (subT G (ext G X) Bv (sec G X y0)) v))
                    (trE G Iyy (subT G (ext G X) Bv (sec G X y0)) (sym (Ty G) (subT G (ext G X) Bv (sec G X y0)) Iyy (JP.IKpt G X y0 y0)) theta)
                    (subt G (ext G X) Bv NM.gam (sec G X y0))
                    (IN.trE-symL G (subT G (ext G X) Bv (sec G X y0)) Iyy (JP.IKpt G X y0 y0) (subt G (ext G X) Bv NM.gam (sec G X y0)))))) ;

    -- the value of g's body at (a , e0) is a transport of apY(y0 , gam y0)
    I0a : Ty G = subT G K IKa (sec G U0 a) ;
    WIpt : Id (Ty G) (subT G Gm WI pt) I0a = JP.wT-inst G U0 P a Pa (refl Pa) e0 IKa ;

    gBTE : IN.TE G (subT G Gm WI pt) T0 (subt G Gm WI gB pt) (apAt theta) =
      IN.teT G (subT G Gm WI pt) (subT G Gm (MapY Gm aG wG) pt) T0 (subt G Gm WI gB pt) (subt G Gm (MapY Gm aG wG) apG pt) (apAt theta)
        (IN.teS G (subT G Gm (MapY Gm aG wG) pt) (subT G Gm WI pt) (subt G Gm (MapY Gm aG wG) apG pt) (subt G Gm WI gB pt)
           (IN.teSubtTr G Gm (MapY Gm aG wG) WI (trans (Ty Gm) (MapY Gm aG wG) (IJ.IdT Gm CdG aG bG) WI MYG (sym (Ty Gm) WI (IJ.IdT Gm CdG aG bG) IdKP)) apG pt))
      (IN.teT G (subT G Gm (MapY Gm aG wG) pt) (subT G Gm (subT Gm (ext G X) MX1 sgm) pt) T0
         (subt G Gm (MapY Gm aG wG) apG pt) (subt G Gm (subT Gm (ext G X) MX1 sgm) (subt Gm (ext G X) MX1 apW sgm) pt) (apAt theta)
         (IN.teS G (subT G Gm (subT Gm (ext G X) MX1 sgm) pt) (subT G Gm (MapY Gm aG wG) pt) (subt G Gm (subT Gm (ext G X) MX1 sgm) (subt Gm (ext G X) MX1 apW sgm) pt)
            (subt G Gm (MapY Gm aG wG) apG pt)
            (IN.teSubtTr G Gm (subT Gm (ext G X) MX1 sgm) (MapY Gm aG wG) PAs (subt Gm (ext G X) MX1 apW sgm) pt))
      (IN.teT G (subT G Gm (subT Gm (ext G X) MX1 sgm) pt) (subT G (ext G X) MX1 (o G Gm (ext G X) sgm pt)) T0
         (subt G Gm (subT Gm (ext G X) MX1 sgm) (subt Gm (ext G X) MX1 apW sgm) pt) (subt G (ext G X) MX1 apW (o G Gm (ext G X) sgm pt)) (apAt theta)
         (IN.teS G (subT G (ext G X) MX1 (o G Gm (ext G X) sgm pt)) (subT G Gm (subT Gm (ext G X) MX1 sgm) pt)
            (subt G (ext G X) MX1 apW (o G Gm (ext G X) sgm pt)) (subt G Gm (subT Gm (ext G X) MX1 sgm) (subt Gm (ext G X) MX1 apW sgm) pt)
            (IN.teSubtO G Gm (ext G X) MX1 apW sgm pt))
      (IN.teT G (subT G (ext G X) MX1 (o G Gm (ext G X) sgm pt)) (subT G (ext G X) MX1 (sec G X y0)) T0
         (subt G (ext G X) MX1 apW (o G Gm (ext G X) sgm pt)) (subt G (ext G X) MX1 apW (sec G X y0)) (apAt theta)
         (IN.teSubEq G (ext G X) MX1 apW (o G Gm (ext G X) sgm pt) (sec G X y0) tauEq)
      (IN.teT G (subT G (ext G X) MX1 (sec G X y0)) (subT G (ext G X) (subT (ext G X) Dy CMa sg) (sec G X y0)) T0
         (subt G (ext G X) MX1 apW (sec G X y0)) (subt G (ext G X) (subT (ext G X) Dy CMa sg) (subt (ext G X) Dy CMa apJ sg) (sec G X y0)) (apAt theta)
         (IN.teS G (subT G (ext G X) (subT (ext G X) Dy CMa sg) (sec G X y0)) (subT G (ext G X) MX1 (sec G X y0))
            (subt G (ext G X) (subT (ext G X) Dy CMa sg) (subt (ext G X) Dy CMa apJ sg) (sec G X y0)) (subt G (ext G X) MX1 apW (sec G X y0))
            (IN.teSubtTr G (ext G X) (subT (ext G X) Dy CMa sg) MX1 PAW (subt (ext G X) Dy CMa apJ sg) (sec G X y0)))
      (IN.teT G (subT G (ext G X) (subT (ext G X) Dy CMa sg) (sec G X y0)) (subT G Dy CMa (o G (ext G X) Dy sg (sec G X y0))) T0
         (subt G (ext G X) (subT (ext G X) Dy CMa sg) (subt (ext G X) Dy CMa apJ sg) (sec G X y0)) (subt G Dy CMa apJ (o G (ext G X) Dy sg (sec G X y0))) (apAt theta)
         (IN.teS G (subT G Dy CMa (o G (ext G X) Dy sg (sec G X y0))) (subT G (ext G X) (subT (ext G X) Dy CMa sg) (sec G X y0))
            (subt G Dy CMa apJ (o G (ext G X) Dy sg (sec G X y0))) (subt G (ext G X) (subT (ext G X) Dy CMa sg) (subt (ext G X) Dy CMa apJ sg) (sec G X y0))
            (IN.teSubtO G (ext G X) Dy CMa apJ sg (sec G X y0)))
      (IN.teT G (subT G Dy CMa (o G (ext G X) Dy sg (sec G X y0))) (subT G Dy CMa (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta)) T0
         (subt G Dy CMa apJ (o G (ext G X) Dy sg (sec G X y0))) (subt G Dy CMa apJ (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta)) (apAt theta)
         (IN.teSubEq G Dy CMa apJ (o G (ext G X) Dy sg (sec G X y0)) (JP.instG G X Bv y0 Iyy (JP.IKpt G X y0 y0) theta) secsec)
         (apAtTE theta)))))))
     where { MX1 : Ty (ext G X) = MapY (ext G X) a1 wX ; } ;

    ----------------------------------------------------------------------
    -- (8) RE: g (f p) = p, by J on p : Id(a , b)

    FPg : Id (Ty G) (subT G K (Fun K P IKa) (sec G U0 a)) (Fun G Pa I0a) = Fun-ov G K P IKa (sec G U0 a) Pa (refl Pa) I0a (refl I0a) ;
    FPf : Id (Ty G) (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G I0a Pa) = Fun-ov G K IKa P (sec G U0 a) I0a (refl I0a) Pa (refl Pa) ;
    gA : El G (Fun G Pa I0a) = trE G (subT G K (Fun K P IKa) (sec G U0 a)) (Fun G Pa I0a) FPg (subt G K (Fun K P IKa) g (sec G U0 a)) ;
    fA : El G (Fun G I0a Pa) = trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G I0a Pa) FPf (subt G K (Fun K IKa P) f (sec G U0 a)) ;

    -- f at a on refl
    E1 : Id (El G Pa) (app G I0a Pa fA (DJ.reflE G U0 a)) e0 =
      trans (El G Pa) (app G I0a Pa fA (DJ.reflE G U0 a))
        (app G (IJ.IdT G U0 a a) Pa (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a))
        e0
        (trans (El G Pa) (app G I0a Pa fA (DJ.reflE G U0 a))
           (app G I0a Pa (trE G (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) FR (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))))
                        (DJ.reflE G U0 a))
           (app G (IJ.IdT G U0 a a) Pa (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a))
           (ap (El G (Fun G I0a Pa)) (El G Pa) (\ F -> app G I0a Pa F (DJ.reflE G U0 a)) fA
               (trE G (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) FR (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))))
               (sym (El G (Fun G I0a Pa)) (trE G (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) FR (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a)))) fA
                  (trans (El G (Fun G I0a Pa)) (trE G (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) FR (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))))
                     (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G I0a Pa) (trans (Ty G) (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) (FFun G a a) FR) (subt G K (Fun K IKa P) f (sec G U0 a)))
                     fA
                     (trE-tr G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) (FFun G a a) FR (subt G K (Fun K IKa P) f (sec G U0 a)))
                     (trE-irr G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G I0a Pa) (trans (Ty G) (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) (FFun G a a) FR) FPf
                        (subt G K (Fun K IKa P) f (sec G U0 a))))))
           (IN.app-tr2 G (IJ.IdT G U0 a a) I0a Pa Pa (sym (Ty G) I0a (IJ.IdT G U0 a a) (DJ.reflT G U0 a)) (refl Pa) FR
              (trE G (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G (IJ.IdT G U0 a a) Pa) (FFun G a a) (subt G K (Fun K IKa P) f (sec G U0 a))) (IJ.rfl G U0 a)))
        f-at-a
     where {
      FR : Id (Ty G) (Fun G (IJ.IdT G U0 a a) Pa) (Fun G I0a Pa) =
        ap (Ty G) (Ty G) (\ Z -> Fun G Z Pa) (IJ.IdT G U0 a a) I0a (sym (Ty G) I0a (IJ.IdT G U0 a a) (DJ.reflT G U0 a)) ;
     } ;

    -- g at (a , e0) is apY(y0 , gam y0), read in I0a
    TI : Id (Ty G) T0 I0a =
      trans (Ty G) T0 (IJ.IdT G U0 a a) I0a
        (ap (El G U0) (Ty G) (\ v -> IJ.IdT G U0 a v) (IN.fst G U0 P y0) a (sym (El G U0) a (IN.fst G U0 P y0) pia))
        (sym (Ty G) I0a (IJ.IdT G U0 a a) (JP.IKpt G U0 a a)) ;

    E2 : Id (El G I0a) (app G Pa I0a gA e0) (trE G T0 I0a TI (apAt theta)) =
      trans (El G I0a) (app G Pa I0a gA e0) (trE G (subT G Gm WI pt) I0a WIpt (subt G Gm WI gB pt)) (trE G T0 I0a TI (apAt theta))
        (sym (El G I0a) (trE G (subT G Gm WI pt) I0a WIpt (subt G Gm WI gB pt)) (app G Pa I0a gA e0)
           (JP.appLamInst G U0 P IKa a Pa (refl Pa) e0 gB FPg))
        (sym (El G I0a) (trE G T0 I0a TI (apAt theta)) (trE G (subT G Gm WI pt) I0a WIpt (subt G Gm WI gB pt))
           (IN.teAny G T0 I0a (apAt theta) (trE G (subT G Gm WI pt) I0a WIpt (subt G Gm WI gB pt))
              (IN.teT G T0 (subT G Gm WI pt) I0a (apAt theta) (subt G Gm WI gB pt) (trE G (subT G Gm WI pt) I0a WIpt (subt G Gm WI gB pt))
                 (IN.teS G (subT G Gm WI pt) T0 (subt G Gm WI gB pt) (apAt theta) gBTE)
                 (IN.teTr G (subT G Gm WI pt) I0a WIpt (subt G Gm WI gB pt)))
              TI)) ;

    -- refl in I0a is baseA transported
    E3 : Id (El G I0a) (trE G T0 I0a TI baseA) (DJ.reflE G U0 a) =
      IN.teAny G T0 I0a baseA (DJ.reflE G U0 a)
        (IN.teT G T0 (IJ.IdT G U0 a a) I0a baseA (IJ.rfl G U0 a) (DJ.reflE G U0 a)
           (IN.teS G (IJ.IdT G U0 a a) T0 (IJ.rfl G U0 a) baseA (IN.teTr G (IJ.IdT G U0 a a) T0 (ap (El G U0) (Ty G) (\ v -> IJ.IdT G U0 a v) a (IN.fst G U0 P y0) pia) (IJ.rfl G U0 a)))
           (IN.teTr G (IJ.IdT G U0 a a) I0a (sym (Ty G) I0a (IJ.IdT G U0 a a) (DJ.reflT G U0 a)) (IJ.rfl G U0 a)))
        TI ;

    -- the motive of RE is the body of Htpy g f
    CMr : Ty Dxa = IJ.IdT Dxa (wkT K IKa IKa)
                     (app Dxa (wkT K IKa P) (wkT K IKa IKa) (EQ.wkF K IKa P IKa g) (app Dxa (wkT K IKa IKa) (wkT K IKa P) (EQ.wkF K IKa IKa P f) (q K IKa)))
                     (q K IKa) ;

    cA : Sub G Dxa = DJ.cen G U0 a ;
    WTa : Id (Ty G) (subT G Dxa (wkT K IKa IKa) cA) I0a = JP.wT-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) IKa ;
    WPa : Id (Ty G) (subT G Dxa (wkT K IKa P) cA) Pa = JP.wT-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) P ;
    PFg : Id (Ty G) (subT G Dxa (Fun Dxa (wkT K IKa P) (wkT K IKa IKa)) cA) (Fun G Pa I0a) = Fun-ov G Dxa (wkT K IKa P) (wkT K IKa IKa) cA Pa WPa I0a WTa ;
    PFf : Id (Ty G) (subT G Dxa (Fun Dxa (wkT K IKa IKa) (wkT K IKa P)) cA) (Fun G I0a Pa) = Fun-ov G Dxa (wkT K IKa IKa) (wkT K IKa P) cA I0a WTa Pa WPa ;

    Pgc : Ov G Dxa (Fun Dxa (wkT K IKa P) (wkT K IKa IKa)) cA (Fun G Pa I0a) PFg (EQ.wkF K IKa P IKa g) gA =
      ovTr G Dxa (wkT K IKa (Fun K P IKa)) (Fun Dxa (wkT K IKa P) (wkT K IKa IKa)) (EQ.wkFP K IKa P IKa) cA (subT G K (Fun K P IKa) (sec G U0 a)) (Fun G Pa I0a) FPg
        (JP.wT-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) (Fun K P IKa)) PFg (wkE K IKa (Fun K P IKa) g) (subt G K (Fun K P IKa) g (sec G U0 a))
        (JP.wE-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) (Fun K P IKa) g (JP.wT-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) (Fun K P IKa))) ;
    Pfc : Ov G Dxa (Fun Dxa (wkT K IKa IKa) (wkT K IKa P)) cA (Fun G I0a Pa) PFf (EQ.wkF K IKa IKa P f) fA =
      ovTr G Dxa (wkT K IKa (Fun K IKa P)) (Fun Dxa (wkT K IKa IKa) (wkT K IKa P)) (EQ.wkFP K IKa IKa P) cA (subT G K (Fun K IKa P) (sec G U0 a)) (Fun G I0a Pa) FPf
        (JP.wT-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) (Fun K IKa P)) PFf (wkE K IKa (Fun K IKa P) f) (subt G K (Fun K IKa P) f (sec G U0 a))
        (JP.wE-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) (Fun K IKa P) f (JP.wT-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) (Fun K IKa P))) ;
    Pqc : Ov G Dxa (wkT K IKa IKa) cA I0a WTa (q K IKa) (DJ.reflE G U0 a) = JP.q-inst G U0 IKa a I0a (refl I0a) (DJ.reflE G U0 a) WTa ;

    PCr : Id (Ty G) (subT G Dxa CMr cA) (IJ.IdT G I0a (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a)) =
      Id-ov G Dxa (wkT K IKa IKa)
        (app Dxa (wkT K IKa P) (wkT K IKa IKa) (EQ.wkF K IKa P IKa g) (app Dxa (wkT K IKa IKa) (wkT K IKa P) (EQ.wkF K IKa IKa P f) (q K IKa)))
        (q K IKa) cA I0a WTa (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a)
        (app-ov G Dxa (wkT K IKa P) (wkT K IKa IKa) cA Pa WPa I0a WTa PFg (EQ.wkF K IKa P IKa g) gA Pgc
           (app Dxa (wkT K IKa IKa) (wkT K IKa P) (EQ.wkF K IKa IKa P f) (q K IKa)) (app G I0a Pa fA (DJ.reflE G U0 a))
           (app-ov G Dxa (wkT K IKa IKa) (wkT K IKa P) cA I0a WTa Pa WPa PFf (EQ.wkF K IKa IKa P f) fA Pfc (q K IKa) (DJ.reflE G U0 a) Pqc))
        Pqc ;

    -- the start: from Theta' (Thr), apR-eq, E1, E2, E3
    baseR : El G (IJ.IdT G I0a (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a)) =
      trE G (IJ.IdT G T0 (apAt theta) (apAt (IJ.rfl G X y0))) (IJ.IdT G I0a (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a))
        (DJ.idCong G T0 I0a TI (apAt theta) (apAt (IJ.rfl G X y0)) (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a)
           (trans (El G I0a) (trE G T0 I0a TI (apAt theta)) (app G Pa I0a gA e0) (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a)))
              (sym (El G I0a) (app G Pa I0a gA e0) (trE G T0 I0a TI (apAt theta)) E2)
              (ap (El G Pa) (El G I0a) (\ v -> app G Pa I0a gA v) e0 (app G I0a Pa fA (DJ.reflE G U0 a)) (sym (El G Pa) (app G I0a Pa fA (DJ.reflE G U0 a)) e0 E1)))
           (trans (El G I0a) (trE G T0 I0a TI (apAt (IJ.rfl G X y0))) (trE G T0 I0a TI baseA) (DJ.reflE G U0 a)
              (ap (El G T0) (El G I0a) (\ v -> trE G T0 I0a TI v) (apAt (IJ.rfl G X y0)) baseA apR-eq)
              E3))
        Thr ;

    REJ : El Dxa CMr = IJ.J G U0 a CMr (trE G (IJ.IdT G I0a (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a)) (subT G Dxa CMr cA)
                                          (sym (Ty G) (subT G Dxa CMr cA) (IJ.IdT G I0a (app G Pa I0a gA (app G I0a Pa fA (DJ.reflE G U0 a))) (DJ.reflE G U0 a)) PCr)
                                          baseR) ;

    epsH : El K (EQ.Htpy K P IKa g f) = lam K IKa CMr REJ ;

    ----------------------------------------------------------------------
    -- univalence at a: idtoeqv is a (bi-invertible) equivalence

    idtoeqv : El K (Fun K IKa P) = f ;
    ua : El K (EQ.isEquiv K IKa P f) = IN.mkIsEquiv K IKa P f g etaH g epsH ;
  } ;
} ;
