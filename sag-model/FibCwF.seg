-- FibCwF.seg (M1, step 3): the CwF of fibrant types of B, with Pi and
-- Sigma.  The instance of CwFCl at the presheaf CwF over the base PosFull
-- and the classifier Cl = Fib (core CFibCl: clSub, clSub-id, clSub-o).
--
-- Informal text.
-- (1) A fibration structure is a pair of relative contractibility
--     structures, and such a structure is determined by its extensions
--     (CPartial.rc-ext), which lie in sets.  So Fib is a set (Hedberg).
-- (2) Naturality in the form CwFCl asks for: (A[s] , c[s]) = (A' , c')
--     as structured types.  Core proves c' = K c for a cart K : A' -> A
--     over s (CPiNat, CSigNat).  Given a path P : A[s] = A' of types,
--     transport along P is the move along the cart of P (CTrFib.law), c[s]
--     is the move along the substitution cart (CFibSub), the two moves
--     compose (CCartLaws2.compFib), and the composite cart has the data of
--     K (CCartLaws2.congFib).  This is MoveNat, used for Pi (K the cart of
--     CPiCart, which is that composite by definition) and Sigma (K the
--     cart of CSigNat; the transport along P is the identity on fibres,
--     CTrFib.tr-pw).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

------------------------------------------------------------------------
-- (1) fibration structures form a set

module RCSet (D : PCtx) (S T : PTy[D]) (m : PB.CPartial[l].PMap[D, S, T]) {
  module R = PB.CPartial[l].Rel[D, S, T, m] ;

  Same (k k' : R.RC) : U l+ =
    (X : Ob) (x : R.TS.Pt X) (s : R.PS'.Side[X, x]) -> Id (R.TT.T X x) (k.kop X x s) (k'.kop X x s) ;

  isProp-Same (k k' : R.RC) : isProp (Same k k') =
    Axioms[l+].FunExtLemmas[fe @(l+)].isProp-Pi Ob (\ X -> (x : R.TS.Pt X) (s : R.PS'.Side[X, x]) -> Id (R.TT.T X x) (k.kop X x s) (k'.kop X x s)) (\ X ->
    Axioms[l+].FunExtLemmas[fe @(l+)].isProp-Pi (R.TS.Pt X) (\ x -> (s : R.PS'.Side[X, x]) -> Id (R.TT.T X x) (k.kop X x s) (k'.kop X x s)) (\ x ->
    Axioms[l+].FunExtLemmas[fe @(l+)].isProp-Pi (R.PS'.Side[X, x]) (\ s -> Id (R.TT.T X x) (k.kop X x s) (k'.kop X x s)) (\ s ->
      W0.isSetIx (T.tob X x) (k.kop X x s) (k'.kop X x s)))) ;

  isSet-RC : isSet R.RC = \ k ->
    Hedberg[R.RC, k, \ k' -> Same k k', \ k' -> isProp-Same k k', \ X x s -> refl (k.kop X x s), \ k' h -> R.rc-ext k k' h].hedberg ;
} ;

isSet-Comp (G : PCtx) (A : PTy[G]) (e e' : El Iv) : isSet (PB.CLine[l].Lines[G, A].CompK[e, e'].Comp) =
  RCSet[PB.CLine[l].Lines[G, A].CompK[e, e'].EK.TV.E, PB.CLine[l].Lines[G, A].CompK[e, e'].EK.SFm.SF,
        PB.CLine[l].Lines[G, A].CompK[e, e'].Tend, PB.CLine[l].Lines[G, A].CompK[e, e'].endL].isSet-RC ;

isSet-Fib (G : PCtx) (A : PTy[G]) : isSet (FibClL[a, l].Cl G A) =
  isSet-Sigma (PB.CLine[l].Lines[G, A].CompK[e0, e1].Comp) (\ c -> PB.CLine[l].Lines[G, A].CompK[e1, e0].Comp)
    (isSet-Comp G A e0 e1) (\ c -> isSet-Comp G A e1 e0) ;

------------------------------------------------------------------------
-- the CwF of fibrant types

module FC = CwFCl[l+].ClCwF[PCwF, FibClL[a, l].Cl, isSet-Fib, FibClL[a, l].clSub, FibClL[a, l].clSub-id, FibClL[a, l].clSub-o] ;

------------------------------------------------------------------------
-- (2) naturality: the substituted structure, transported along a path of
-- types, is the move along a cart with the composite's data

module MoveNat (D G : PCtx) (s : PSub[D, G]) (X : PTy[G]) (Y : PTy[D]) (P2 : Id (PTy[D]) (subTy D G X s) Y)
  (ta2 : (W : Ob) -> GPR.TyL[D, Y].EI W -> GPR.TyL[G, X].EI W)
  (tapt2 : (W : Ob) (v : GPR.TyL[D, Y].EI W) -> Id (W0.Ix (G.ob W)) (GPR.TyL[G, X].pr1 W (ta2 W v)) (s.nt W (GPR.TyL[D, Y].pr1 W v)))
  (tanat2 : (V W : Ob) (g : Hom V W) (v : GPR.TyL[D, Y].EI W)
     -> Id (GPR.TyL[G, X].EI V) (GPR.TyL[G, X].E.act V W g (ta2 W v)) (ta2 V (GPR.TyL[D, Y].E.act V W g v)))
  (tainj2 : (W : Ob) (v v' : GPR.TyL[D, Y].EI W) (P : Id (W0.Ix (D.ob W)) (GPR.TyL[D, Y].pr1 W v) (GPR.TyL[D, Y].pr1 W v'))
     (Q : Id (GPR.TyL[G, X].EI W) (ta2 W v) (ta2 W v')) -> Id (GPR.TyL[D, Y].EI W) v v')
  (bk2 : (Z : Ob) (x : W0.Ix (D.ob Z)) (u : W0.Ix (X.tob Z (s.nt Z x))) -> W0.Ix (Y.tob Z x))
  (bkta2 : (Z : Ob) (x : W0.Ix (D.ob Z)) (u : W0.Ix (X.tob Z (s.nt Z x)))
     -> Id (GPR.TyL[G, X].EI Z) (ta2 Z (GPR.TyL[D, Y].pr Z x (bk2 Z x u))) (GPR.TyL[G, X].pr Z (s.nt Z x) u))
  (Pta : (W : Ob) (v : GPR.TyL[D, Y].EI W)
     -> Id (GPR.TyL[G, X].EI W) (PB.CSub[l].SubE[D, G, s, X].mV W (PB.CTrFib[l].TR[D, subTy D G X s].ta Y P2 W v)) (ta2 W v)) {
  module TR = PB.CTrFib[l].TR[D, subTy D G X s] ;
  module SE = PB.CSub[l].SubE[D, G, s, X] ;

  module K = PB.CCart[l, l].Cart[D, Y, G, X, s.nt, s.nt-nat, ta2, tapt2, tanat2, tainj2, bk2, bkta2] ;

  -- transport along P2, then the substitution cart
  module CC = PB.CCartLaws2[l, l, l].CC[D, Y, D, subTy D G X s, G, X,
    \ W x -> x, \ V W g x -> refl (D.act V W g x), TR.ta Y P2, \ W v -> refl (GPR.TyL[D, Y].pr1 W v), TR.tanat Y P2, TR.tainj Y P2, TR.fwV Y P2, TR.bkta Y P2,
    s.nt, s.nt-nat, SE.mV, \ W v -> refl (s.nt W (SE.TS.pr1 W v)), SE.mV-nat, SE.mV-inj, \ Z x u -> u, \ Z x u -> refl (SE.TC.pr Z (s.nt Z x) u)] ;

  -- the composite has the data of K
  module CG = PB.CCartLaws2[l, l, l].CG[D, Y, G, X,
    CC.s, CC.s-nat, CC.ta, CC.tapt, CC.tanat, CC.tainj, CC.bk, CC.bkta,
    s.nt, s.nt-nat, ta2, tapt2, tanat2, tainj2, bk2, bkta2,
    \ W x -> refl (s.nt W x), Pta] ;

  law (F : FibClL[a, l].Cl G X)
    : Id (FC.STy D) (subTy D G X s, FibClL[a, l].clSub D G s X F) (Y, K.moveFib F) =
    transH (TR.law Y P2 (FibClL[a, l].clSub D G s X F))
      (apH {FibClL[a, l].Cl D Y} {FC.STy D} (\ z -> (Y, z)) (transH (CC.compFib F) (CG.congFib F))) ;
} ;

------------------------------------------------------------------------
-- Pi

piCl (G : PCtx) (A : FC.STy G) (B : FC.STy (extP G A.1)) : FibClL[a, l].Cl G (PB.CPiE[l].PiE[G, A.1, B.1].P) =
  PB.CPi[l].PiFib[G, A.1, B.1, A.2, B.2].fib ;

module PiN (D G : PCtx) (s : PSub[D, G]) (A : FC.STy G) (B : FC.STy (extP G A.1)) {
  module PC = PB.CPiCart[l].PiCart[D, G, s, A.1, B.1] ;
  module N = PB.CPiNat[l].PiNat[D, G, s, A.1, B.1, A.2, B.2] ;
  module MN = MoveNat[D, G, s, PC.PEG.P, PC.PED.P, PC.P2, PC.ta, \ W v -> refl (s.nt W (PC.PED.TP.pr1 W v)), PC.tanat, PC.tainj, PC.bk, PC.bkta, \ W v -> refl (PC.ta W v)] ;

  law : Id (FC.STy D) (FC.subS D G (PC.PEG.P, piCl G A B) s)
                      (PC.PED.P, piCl D (FC.subS D G A s) (FC.subS (extP D (subTy D G A.1 s)) (extP G A.1) B (liftP D G A.1 s))) =
    transH (MN.law N.F) (apH {FibClL[a, l].Cl D PC.PED.P} {FC.STy D} (\ z -> (PC.PED.P, z)) (symH N.nat)) ;
} ;

module FPi = FC.ClPi[PresheafPi[a, l].PPi[PB.BC].PPi, piCl, \ D G A B s -> PiN[D, G, s, A, B].law] ;

------------------------------------------------------------------------
-- Sigma

sigCl (G : PCtx) (A : FC.STy G) (B : FC.STy (extP G A.1)) : FibClL[a, l].Cl G (PresheafFormers[a, l].PFormers[PB.BC].SigAB[G, A.1, B.1].SigP) =
  PB.CSig[l].SigFib[G, A.1, B.1, A.2, B.2].fib ;

module SigN (D G : PCtx) (s : PSub[D, G]) (A : FC.STy G) (B : FC.STy (extP G A.1)) {
  module SC = PB.CSigNat[l].SigCart[D, G, s, A.1, B.1] ;
  module N = PB.CSigNat[l].SigNat[D, G, s, A.1, B.1, A.2, B.2] ;
  module TR = PB.CTrFib[l].TR[D, subTy D G SC.SG.SigP s] ;
  P2 : Id (PTy[D]) (subTy D G SC.SG.SigP s) SC.SD.SigP = PresheafFormers[a, l].PFormers[PB.BC].SigNat[D, G, A.1, B.1, s].nat ;

  -- transport along P2 is the identity on fibres
  Pta (W : Ob) (v : SC.TSd.EI W) : Id (SC.TSg.EI W) (SC.SES.mV W (TR.ta SC.SD.SigP P2 W v)) (SC.SES.mV W v) =
    apH (\ u -> SC.SES.mV W (GPR.TyL[D, subTy D G SC.SG.SigP s].pr W (SC.TSd.pr1 W v) u))
      (TR.tr-pw SC.SD.SigP P2 W (SC.TSd.pr1 W v) (refl (SC.SD.SigP.tob W (SC.TSd.pr1 W v))) (SC.TSd.pr2 W v)) ;

  module MN = MoveNat[D, G, s, SC.SG.SigP, SC.SD.SigP, P2, SC.SES.mV, \ W v -> refl (s.nt W (SC.TSd.pr1 W v)), SC.tanat, SC.SES.mV-inj,
    \ Z x u -> u, \ Z x u -> refl (SC.TSg.pr Z (s.nt Z x) u), Pta] ;

  law : Id (FC.STy D) (FC.subS D G (SC.SG.SigP, sigCl G A B) s)
                      (SC.SD.SigP, sigCl D (FC.subS D G A s) (FC.subS (extP D (subTy D G A.1 s)) (extP G A.1) B (liftP D G A.1 s))) =
    transH (MN.law N.F) (apH {FibClL[a, l].Cl D SC.SD.SigP} {FC.STy D} (\ z -> (SC.SD.SigP, z)) (symH N.nat)) ;
} ;

module FSig = FC.ClSig[PresheafFormers[a, l].PFormers[PB.BC].PSig, sigCl, \ D G A B s -> SigN[D, G, s, A, B].law] ;

------------------------------------------------------------------------
-- the interface at B so far: the CwF of fibrant types, Pi, Sigma

fibCwF : CwF.CwF[l+] = FC.SCwF ;
fibPi : CwF.Formers[l+, fibCwF].PiStr = FPi.SPi ;
fibSig : CwF.Formers[l+, fibCwF].SigStr = FSig.SSig ;
