-- CwFFv.seg (M1 step 3, S4, S3 toolkit): the end point of the fibre FVr,
-- in a CwF with Pi, Sigma and Swan Id.
--
-- FVr G X Y r over G.X (variable x) is Sigma (y : Y) Id(r y , x), written
-- over K' = G.X.Y[p] with the end r y = app (wkF (wkF r)) q (CwFQinv.FamE).
--
-- Informal text.  That end is a transport of (bod r) along the lift
-- tau = lift (p : G.X -> G) : G.X.Y[p] -> G.Y:
-- (1) app h a is a transport of (bod h)[sec a] (by definition);
-- (2) bod (wkF f) is a transport of (bod f)[lift p] (bodNat), so
--     (bod (wkF e))[sec q] is one of (bod e)[lift p][sec q], i.e. of
--     (bod e)[lift p o sec q] = (bod e)[id] (lift-p-sec-q), i.e. of bod e;
-- (3) bod e for e = wkF r is a transport of (bod r)[tau] (bodNat).
-- (4) FVr is Sigma Yd Id(e1 , e2) by definition (fvDef, stated here once).

open Base ;

module Fv (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module QP = CwFQP.QP[l, C, PS, SS, IJ, NF] ;

  module E (G : Ctx) (X Y : Ty G) (r : El G (Fun G Y X)) {
    D : Ctx = ext G X ;
    Yd : Ty D = wkT G X Y ;
    Xd : Ty D = wkT G X X ;
    K' : Ctx = ext D Yd ;
    A1 : Ty K' = wkT D Yd Yd ;
    B1 : Ty K' = wkT D Yd Xd ;
    e : El D (Fun D Yd Xd) = EQ.wkF G X Y X r ;
    h : El K' (Fun K' A1 B1) = EQ.wkF D Yd Yd Xd e ;

    -- the end of FVr
    e1 : El K' B1 = app K' A1 B1 h (q D Yd) ;

    tau : Sub K' (ext G Y) = lift D G Y (p G X) ;
    rt : El K' (subT K' (ext G Y) (wkT G Y X) tau) = subt K' (ext G Y) (wkT G Y X) (bod G Y (wkT G Y X) r) tau ;

    Ls : Sub K' K' = o K' (ext K' A1) K' (lift K' D Yd (p D Yd)) (sec K' A1 (q D Yd)) ;
    QL : Id (Ty (ext K' A1)) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (wkT K' A1 B1) =
      wkT-ov K' D Yd Xd (p D Yd) A1 (refl A1) B1 (refl B1) ;
    bh : El (ext K' A1) (wkT K' A1 B1) = bod K' A1 (wkT K' A1 B1) h ;
    be : El K' B1 = bod D Yd B1 e ;

    -- (1) and (2)
    t1 : IN.TE K' (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd))) B1
           (subt K' (ext K' A1) (wkT K' A1 B1) bh (sec K' A1 (q D Yd))) e1 =
      IN.teTr K' (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd))) B1 (p-sec-T K' A1 B1 (q D Yd))
        (subt K' (ext K' A1) (wkT K' A1 B1) bh (sec K' A1 (q D Yd))) ;

    bhE : Id (El (ext K' A1) (wkT K' A1 B1)) bh
            (trE (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (wkT K' A1 B1) QL
               (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd)))) =
      bodNat K' D Yd B1 (p D Yd) (wkT K' A1 B1) QL (EQ.wkFP D Yd Yd Xd) e ;

    t2 : IN.TE K' (subT K' K' B1 Ls) B1 (subt K' K' B1 be Ls) e1 =
      IN.teT K' (subT K' K' B1 Ls) (subT K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
        B1 (subt K' K' B1 be Ls)
        (subt K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
        e1
        (IN.teSubtO K' (ext K' A1) K' B1 be (lift K' D Yd (p D Yd)) (sec K' A1 (q D Yd)))
        (IN.teT K' (subT K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
           (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd))) B1
           (subt K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
           (subt K' (ext K' A1) (wkT K' A1 B1) bh (sec K' A1 (q D Yd))) e1
           (IN.teT K' (subT K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
              (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd)))
              (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd)))
              (subt K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
              (subt K' (ext K' A1) (wkT K' A1 B1)
                 (trE (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (wkT K' A1 B1) QL (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))))
                 (sec K' A1 (q D Yd)))
              (subt K' (ext K' A1) (wkT K' A1 B1) bh (sec K' A1 (q D Yd)))
              (IN.teSubtTr K' (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (wkT K' A1 B1) QL
                 (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))) (sec K' A1 (q D Yd)))
              (refl (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd))),
               ap (El (ext K' A1) (wkT K' A1 B1)) (El K' (subT K' (ext K' A1) (wkT K' A1 B1) (sec K' A1 (q D Yd))))
                 (\ v -> subt K' (ext K' A1) (wkT K' A1 B1) v (sec K' A1 (q D Yd)))
                 (trE (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (wkT K' A1 B1) QL (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))))
                 bh (sym (El (ext K' A1) (wkT K' A1 B1)) bh
                       (trE (ext K' A1) (subT (ext K' A1) K' B1 (lift K' D Yd (p D Yd))) (wkT K' A1 B1) QL (subt (ext K' A1) K' B1 be (lift K' D Yd (p D Yd))))
                       bhE)))
           t1) ;

    -- lift p o sec q is the identity
    t3 : IN.TE K' (subT K' K' B1 (id K')) (subT K' K' B1 Ls) (subt K' K' B1 be (id K')) (subt K' K' B1 be Ls) =
      IN.teSubEq K' K' B1 be (id K') Ls (sym (Sub K' K') Ls (id K') (lift-p-sec-q D Yd)) ;

    -- the end is a transport of bod e
    tE : IN.TE K' B1 B1 be e1 =
      IN.teT K' B1 (subT K' K' B1 (id K')) B1 be (subt K' K' B1 be (id K')) e1
        (IN.teS K' (subT K' K' B1 (id K')) B1 (subt K' K' B1 be (id K')) be (subT-id K' B1, subt-id K' B1 be))
        (IN.teT K' (subT K' K' B1 (id K')) (subT K' K' B1 Ls) B1 (subt K' K' B1 be (id K')) (subt K' K' B1 be Ls) e1 t3 t2) ;

    -- (3) bod e is a transport of (bod r)[tau]
    t4 : IN.TE K' (subT K' (ext G Y) (wkT G Y X) tau) B1 rt be =
      (wkT-ov D G Y X (p G X) Yd (refl Yd) Xd (refl Xd),
       sym (El K' B1) be (trE K' (subT K' (ext G Y) (wkT G Y X) tau) B1 (wkT-ov D G Y X (p G X) Yd (refl Yd) Xd (refl Xd)) rt)
         (bodNat D G Y (wkT G Y X) (p G X) (wkT D Yd Xd) (wkT-ov D G Y X (p G X) Yd (refl Yd) Xd (refl Xd)) (EQ.wkFP G X Y X) r)) ;

    -- FVr, by definition
    e2 : El K' B1 = wkE D Yd Xd (q G X) ;
    FVd : Ty D = SS.Sig D Yd (IJ.IdT K' B1 e1 e2) ;
    fvDef : Id (Ty D) (QP.FVr G X Y r) FVd = refl FVd ;

    end : IN.TE K' (subT K' (ext G Y) (wkT G Y X) tau) B1 rt e1 =
      IN.teT K' (subT K' (ext G Y) (wkT G Y X) tau) B1 B1 rt be e1 t4 tE ;
  } ;
} ;
