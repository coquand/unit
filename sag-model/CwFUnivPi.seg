-- A Tarski universe closed under dependent products in a CwF.

open Base ;

module Closure (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr) {
  open Prelude[l] ;
  open C ;
  module UV = CwFU.Univ[l, C] ;

  module With (Un : UV.UnivStr) {
    module DU = UV.DerU[Un.Cod, Un.Cod-nat] ;

    up-code (D G : Ctx) (a : El G (Un.Cod G)) (s : Sub D G)
      : Sub (ext D (Un.Dec D (DU.subU D G a s))) (ext G (Un.Dec G a)) =
      subst (Ty D) (\ A -> Sub (ext D A) (ext G (Un.Dec G a)))
        (subT D G (Un.Dec G a) s) (Un.Dec D (DU.subU D G a s)) (Un.Dec-nat D G a s)
        (lift D G (Un.Dec G a) s) ;

    record PiClosure {
      pic (G : Ctx) (a : El G (Un.Cod G)) (b : El (ext G (Un.Dec G a)) (Un.Cod (ext G (Un.Dec G a))))
        : El G (Un.Cod G) ;

      Dec-pic (G : Ctx) (a : El G (Un.Cod G)) (b : El (ext G (Un.Dec G a)) (Un.Cod (ext G (Un.Dec G a))))
        : Id (Ty G) (Un.Dec G (pic G a b)) (PS.Pi G (Un.Dec G a) (Un.Dec (ext G (Un.Dec G a)) b)) ;

      pic-nat (D G : Ctx) (s : Sub D G) (a : El G (Un.Cod G))
        (b : El (ext G (Un.Dec G a)) (Un.Cod (ext G (Un.Dec G a))))
        : Id (El D (Un.Cod D)) (DU.subU D G (pic G a b) s)
            (pic D (DU.subU D G a s)
              (DU.subU (ext D (Un.Dec D (DU.subU D G a s))) (ext G (Un.Dec G a)) b (up-code D G a s))) ;
    } ;
  } ;

  record UnivPiStr {
    universe : UV.UnivStr ;
    products : With[universe].PiClosure ;
  } ;
} ;
