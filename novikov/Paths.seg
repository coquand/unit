-- Paths.seg: the few facts about identity types and sums used here.

level l ;
open Base ;

absurd {A : U l} : Empty -> A = split { } ;

symH {A : U l} {x y : A} (p : Id A x y) : Id A y x =
  idJ A x (\ z q -> Id A z x) (refl x) y p ;

substH {A : U l} (F : A -> U l) {x y : A} (p : Id A x y) (u : F x) : F y =
  idJ A x (\ z q -> F z) u y p ;

data Or (A B : U l) : U l = inl (a : A) | inr (b : B) ;
