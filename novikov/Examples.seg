-- Examples.seg: Novikov's theorem computes, through either elimination of
-- the cut (Operators.cut, Novikov's; Variant.cutV, the variant of Coquand's appendix).  The constant x_n is true
-- exactly when n is even, and F(n) = ~x_n & x_(n+1), true exactly when n
-- is odd.  The sum of the F(n) is proved by its summand F(3); the witness
-- is read off the cut-free proof obtained by eliminating the cut on the
-- sum (Existence.Markov).

level l ;
open Base ; open Paths[l] ; open Formula[l] ;

notB : Bool -> Bool = split { true -> false ; false -> true } ;
even : Nat -> Bool = split { zero -> true ; suc n | r -> notB r } ;

three : Nat = suc (suc (suc zero)) ;

module E = Novikov[even] ;

F (n : Nat) : Fm = fand (cnx n) (cx (suc n)) ;

sumF : E.Regular[l].Reg (cons (Sp (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].Fu)) empty) =
  E.Regular[l].weak (cons (W (E.Existence[l].emb (F three))) empty) (cons (Sp (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].Fu)) empty)
    (E.Regular[l].sub1 (W (E.Existence[l].emb (F three))) empty (cons (Sp (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].Fu)) empty)
      (\ k -> E.Regular[l].at (cons (Sp (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].Fu)) empty) zero three)
      (E.Regular[l].subEmpty (cons (Sp (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].Fu)) empty)))
    ((E.Existence[l].truth (F three)).1 empty (tt, tt)) ;

w : Nat = (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].markov sumF).1 ;
#normal w ;
#conv w = three ;

-- the same, with the variant (Variant.cutV)
wV : Nat = (E.Existence[l].Markov[E.Variant[l].cutV, F, \ n -> (tt, tt)].markov sumF).1 ;
#normal wV ;
#conv wV = three ;

-- a proof with a genuine cut, on the sum itself: the left premise proves
-- the cut formula by its summand F(5), the right premise proves the
-- context by F(3).  Both eliminations of the cut give the witness 3.
five : Nat = suc (suc three) ;
Fu : Nat -> T = E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].Fu ;
Gm : Seq = cons (Sp Fu) empty ;

-- W (emb (F n)) , empty  regular for n odd, moved into H at place a, summand n
into (n : Nat) (H : Seq) (a : Nat) (c : (k : Nat) -> E.Regular[l].Cov H (E.Existence[l].emb (F n))) (h : E.Existence[l].Holds (F n)) : E.Regular[l].Reg H =
  E.Regular[l].weak (cons (W (E.Existence[l].emb (F n))) empty) H
    (E.Regular[l].sub1 (W (E.Existence[l].emb (F n))) empty H c (E.Regular[l].subEmpty H))
    ((E.Existence[l].truth (F n)).1 empty h) ;

-- left premise: the cut formula, by its summand F(5)
pL : E.Regular[l].Reg (cons (Sp Fu) Gm) =
  into five (cons (Sp Fu) Gm) zero (\ k -> E.Regular[l].at (cons (Sp Fu) Gm) zero five) (tt, tt) ;
-- right premise: the context, by its summand F(3)
pR : E.Regular[l].Reg (cons (W (neg (Sp Fu))) Gm) =
  into three (cons (W (neg (Sp Fu))) Gm) (suc zero) (\ k -> E.Regular[l].at (cons (W (neg (Sp Fu))) Gm) (suc zero) three) (tt, tt) ;

sumF2 : E.Regular[l].Reg Gm = E.Operators[l].cut (Sp Fu) Gm pL pR ;
sumF2V : E.Regular[l].Reg Gm = E.Variant[l].cutV (Sp Fu) Gm pL pR ;

wCut : Nat = (E.Existence[l].Markov[E.Operators[l].cut, F, \ n -> (tt, tt)].markov sumF2).1 ;
wCutV : Nat = (E.Existence[l].Markov[E.Variant[l].cutV, F, \ n -> (tt, tt)].markov sumF2V).1 ;
#conv wCut = three ;
#conv wCutV = three ;

------------------------------------------------------------------------
-- the theorem of 1939, through a cut on a letter.  G(6) = ~A_0,
-- G(7) = A_0, and G(n) = A_(n+1) otherwise.  The sum of the G(n) is
-- proved by a cut on A_0: the left premise  A_0 , sum  by the axiom with
-- G(6), the right premise  ~A_0 , sum  by the axiom with G(7).  The
-- elimination of the cut (Novikov's, and the variant) gives a regular
-- finite part, up to N = 7.

eqN : Nat -> Nat -> Bool = split {
  zero -> split { zero -> true ; suc n -> false } ;
  suc m | r -> split { zero -> false ; suc n -> r n } } ;

ifFm : Bool -> Fm -> Fm -> Fm = split { true -> \ a b -> a ; false -> \ a b -> b } ;

six : Nat = suc five ;
seven : Nat = suc six ;

Gf (n : Nat) : Fm = ifFm (eqN n six) (nla zero) (ifFm (eqN n seven) (la zero) (la (suc n))) ;

Sg : T = Sp (\ n -> E.Existence[l].emb (Gf n)) ;
Gs : Seq = cons Sg empty ;

qL : E.Regular[l].Reg (cons (L zero) Gs) =
  E.Regular[l].laxAt (cons (L zero) Gs) zero zero (suc zero) six (L zero) tt (refl (L zero)) (refl (NL zero)) ;
qR : E.Regular[l].Reg (cons (W (neg (L zero))) Gs) =
  E.Regular[l].laxAt (cons (W (neg (L zero))) Gs) zero zero (suc zero) seven (NL zero) tt (refl (NL zero)) (refl (L zero)) ;

nCut : Nat = (E.Finite[l].auxTheorem Gf (E.Operators[l].cut (L zero) Gs qL qR)).1 ;
nCutV : Nat = (E.Finite[l].auxTheorem Gf (E.Variant[l].cutV (L zero) Gs qL qR)).1 ;
#conv nCut = seven ;
#conv nCutV = seven ;
