-- Examples.seg: Novikov's theorem computes.  The constant x_n is true
-- exactly when n is even, and F(n) = ~x_n & x_(n+1), true exactly when n
-- is odd.  The sum of the F(n) is proved by its summand F(3); the witness
-- is read off the cut-free proof obtained by eliminating the cut on the
-- sum (Existence.Markov).

level l ;
open Base ; open Paths[l] ; open Formula[l] ;

notB : Bool -> Bool = split { true -> false ; false -> true } ;
even : Nat -> Bool = split { zero -> true ; suc n | r -> notB r } ;

three : Nat = suc (suc (suc zero)) ;

module E = Novikov[even] ;

F (n : Nat) : Fm = fand (cnx n) (cx (suc n)) ;

sumF : E.Regular[l].Reg (cons (Sp (E.Existence[l].Markov[F].Fu)) empty) =
  E.Regular[l].weak (cons (W (E.Existence[l].emb (F three))) empty) (cons (Sp (E.Existence[l].Markov[F].Fu)) empty)
    (E.Regular[l].sub1 (W (E.Existence[l].emb (F three))) empty (cons (Sp (E.Existence[l].Markov[F].Fu)) empty)
      (\ k -> E.Regular[l].at (cons (Sp (E.Existence[l].Markov[F].Fu)) empty) zero three)
      (E.Regular[l].subEmpty (cons (Sp (E.Existence[l].Markov[F].Fu)) empty)))
    ((E.Existence[l].truth (F three)).1 empty (tt, tt)) ;

w : Nat = (E.Existence[l].Markov[F].markov sumF).1 ;
#normal w ;
#conv w = three ;
