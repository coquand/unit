-- Calculus.seg: the calculus with the rule of inference, and Novikov's
-- principal theorem (1943, section 8): every provable sequent is
-- regular, hence the calculus is consistent.
--
-- Provable is the inductive family generated by the two rules of
-- regularity and the cut rule: from  A , G  and  W (neg A) , G  infer G.  By induction on the proof, using
-- Novikov's cut rule (Operators.seg) at each cut.

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ; open Cut[l] ; open Operators[l] ; open Variant[l] ;

data Provable : (G : Seq) -> U l =
    pax (G : Seq) (m k : Nat) (t : True (comp (G m) k)) : Provable G
  | ppi (G : Seq) (m k : Nat) (g : Nat -> T) (e : Id T (comp (G m) k) (Sp g))
        (ds : (j : Nat) -> Provable (cons (g j) G)) : Provable G
  | plax (G : Seq) (m k m' k' : Nat) (lt : Letter (comp (G m) k))
         (e : Id T (comp (G m') k') (neg (comp (G m) k))) : Provable G
  | pcut (G : Seq) (A : T) (p : Provable (cons A G)) (q : Provable (cons (W (neg A)) G)) : Provable G ;

-- Novikov's principal theorem
regularBy (c : CutRule) : (G : Seq) -> Provable G -> Reg G = split {
  pax G m k t -> ax G m k t ;
  ppi G m k g e ds | r -> pi G m k g e r ;
  plax G m k m' k' lt e -> lax G m k m' k' lt e ;
  pcut G A p q | rp rq -> c A G rp rq } ;

regular : (G : Seq) -> Provable G -> Reg G = regularBy cut ;

-- the same, with the variant
regularV : (G : Seq) -> Provable G -> Reg G = regularBy cutV ;

-- the calculus is consistent: the empty sequent is not provable
consistency (p : Provable empty) : Empty = notEmpty (regular empty p) ;
