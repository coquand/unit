-- Cut.seg: what the two proofs of the rule of inference share.
--
-- A sequent D is eliminable if, for every B, B is regular whenever
-- W (neg D) , B  is (neg D, the product NegS D of the negations of the
-- formulas of D).  If every regular sequent is eliminable, the cut rule
-- holds (cutBy): if  A , G  and  W (neg A) , G  are regular, then so is G,
-- since  W (neg (A , G)) , G  is regular (identity).
--
-- The opening of brackets (Novikov's Lemmas 9-12; Lemma 5 of Coquand's
-- appendix).  If  W (neg D) , B  and  Sp (neg o e) , B  are regular then
-- so is   Sp (\ j -> neg (e j , D)) , B :
-- the product neg D is moved into each summand neg (e j) of the sum.
-- By Replace on the second proof (invariant: the first, weakened).  At
-- a focus on the summand neg (e l), focus on the l-th summand of the
-- result, the product of W (neg (e l)) and the W (neg (D m)).  Its first
-- factor is the focus itself (its premises are those of the focus,
-- with the induction hypothesis), the others come from the first proof
-- by inversion.
--
-- Novikov's proof of eliminability is Operators.seg; the variant of
-- Coquand's appendix is Variant.seg.

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ; open Identity[l] ;

Elim (D : Seq) : U l = (B : Seq) -> Reg (cons (W (NegS D)) B) -> Reg B ;

------------------------------------------------------------------------
-- the opening of brackets (Novikov's Lemmas 9-12; Lemma 5 of Coquand)

module AndSum (D : Seq) (e : Nat -> T) {

  X : T = Sp (\ j -> neg (e j)) ;
  Z : T = Sp (\ j -> NegS (cons (e j) D)) ;
  WN : T = W (NegS D) ;

  Q (B : Seq) : U l = Reg (cons WN B) ;
  qe : QExt Q = \ a B q -> weak (cons WN B) (cons WN (cons a B)) (subCons WN B (cons a B) (subTail a B)) q ;

  C : Seq -> U l = RepC X Z Q ;

  -- the first factor: the focus on neg (e l), moved
  first (G B : Seq) (q : Q B) (s : Sub G (cons X B)) (l : Nat) (v : Rule (PremC C G) (neg (e l)))
    : Reg (cons (W (neg (e l))) (cons Z B)) = moveFocus X Z Q qe G B q s (neg (e l)) v ;

  -- the other factors: inversion of the invariant
  other (B : Seq) (q : Q B) (m : Nat) : Reg (cons (W (neg (D m))) (cons Z B)) =
    weak (cons (W (neg (D m))) B) (cons (W (neg (D m))) (cons Z B))
      (subCons (W (neg (D m))) B (cons Z B) (subTail Z B))
      (inv (NegS D) m B q) ;

  -- the factors of the l-th summand of Z, from the first one
  factors (B : Seq) (q : Q B) (l : Nat) (r0 : Reg (cons (W (neg (e l))) (cons Z B)))
    : (m : Nat) -> Reg (cons (W (neg (cons (e l) D m))) (cons Z B)) = split {
    zero -> r0 ;
    suc m -> other B q m } ;

  h : Handler X Z Q = \ G B q s l v -> focus (cons Z B) zero l (factors B q l (first G B q s l v)) ;

  -- the first factor when the summand neg (e l) is a letter a: its
  -- negation is in B, or is another summand neg (e l') of X
  letterFirst (B : Seq) (q : Q B) (a : T) (lt : Letter a) (l : Nat) (ee : Id T (neg (e l)) a)
    : Where X B (neg a) -> Reg (cons (W (neg (e l))) (cons Z B)) = split {
    inr pb -> laxPlaces (cons (W (neg (e l))) (cons Z B)) a lt (zero, zero, ee)
                (placeIn (W (neg (e l))) (cons Z B) (neg a) (placeIn Z B (neg a) pb)) ;
    inl lb -> weak (cons Z (cons (W (neg (e l))) B)) (cons (W (neg (e l))) (cons Z B)) (subSwap Z (W (neg (e l))) B)
                (focus (cons Z (cons (W (neg (e l))) B)) zero lb.1
                  (factors (cons (W (neg (e l))) B) (qe (W (neg (e l))) B q) lb.1
                    (laxPlaces (cons (W (neg (e lb.1))) (cons Z (cons (W (neg (e l))) B))) a lt
                      (suc (suc zero), zero, ee) (zero, zero, lb.2)))) } ;

  hl : HandlerL X Z Q = \ G B q s a lt l ee w ->
    focus (cons Z B) zero l (factors B q l (letterFirst B q a lt l ee w)) ;

  andSum (B : Seq) (p : Reg (cons WN B)) (r : Reg (cons X B)) : Reg (cons Z B) =
    Replace[X, Z, Q, qe, h, hl].replace B p r ;
} ;

------------------------------------------------------------------------
-- the atomic cut (Novikov's Lemma 13): if  a , B  and  ~a , B  are
-- regular, a a letter, then so is B.  By Replace on the first proof: a
-- is never a distinguished term, and an axiom  a v ~a  with ~a in B is
-- replaced by the second proof.

letterRule (P : (Nat -> T) -> U l) : (a : T) -> Letter a -> (l : Nat) -> Rule P (comp a l) -> Empty = split {
  F0 -> \ z l v -> z ; F1 -> \ z l v -> z ; X n -> \ z l v -> z ; NX n -> \ z l v -> z ;
  L n -> \ z l v -> v ; NL n -> \ z l v -> v ; Sp f -> \ z l v -> z } ;

module AtomCut (a : T) (lt : Letter a) {

  Q (B : Seq) : U l = Reg (cons (neg a) B) ;
  qe : QExt Q = \ b B q -> weak (cons (neg a) B) (cons (neg a) (cons b B)) (subCons (neg a) B (cons b B) (subTail b B)) q ;

  h : Handler a F0 Q = \ G B q s l v -> absurd (letterRule (PremC (RepC a F0 Q) G) a lt l v) ;

  -- b = a; its negation is not a summand of a, so it is in B
  atomL (B : Seq) (q : Q B) (b : T) (eab : Id T a b) : Where a B (neg b) -> Reg (cons F0 B) = split {
    inl lb -> absurd (letterNeq a lt (transH (symH (compLetter a lt lb.1)) (transH lb.2 (apH neg (symH eab))))) ;
    inr pb -> wkTail F0 B (weak (cons (neg a) B) B
                (sub1 (neg a) B B
                  (\ k -> inr (pb.1, pb.2.1, transH pb.2.2 (transH (apH neg (symH eab))
                             (symH (compLetter (neg a) (letterNeg a lt) k)))))
                  (subRefl B)) q) } ;

  hl : HandlerL a F0 Q = \ G B q s b lb l e w -> atomL B q b (transH (symH (compLetter a lt l)) e) w ;

  cutAtom (B : Seq) (p : Reg (cons a B)) (q : Reg (cons (neg a) B)) : Reg B =
    str0 B (Replace[a, F0, Q, qe, h, hl].replace B q p) ;
} ;

-- the negation of the summand c = comp (D m) k, by two inversions
invTwice (D B : Seq) (m k : Nat) (q : Reg (cons (W (NegS D)) B)) : Reg (cons (neg (comp (D m) k)) B) =
  substH (\ z -> Reg (cons z B)) (compNeg (D m) k) (inv (neg (D m)) k B (inv (NegS D) m B q)) ;

-- a sequent D with an axiom A v ~A is eliminable: two inversions and the
-- atomic cut
letterLeaf (D B : Seq) (m k m' k' : Nat) (lt : Letter (comp (D m) k))
  (e : Id T (comp (D m') k') (neg (comp (D m) k))) (q : Reg (cons (W (NegS D)) B)) : Reg B =
  AtomCut[comp (D m) k, lt].cutAtom B
    (substH (\ z -> Reg (cons z B)) (negNeg (comp (D m) k) lt)
      (substH (\ z -> Reg (cons (neg z) B)) e (invTwice D B m' k' q)))
    (invTwice D B m k q) ;

------------------------------------------------------------------------
-- the cut rule and the rule of inference

cutPrem (A : T) (G : Seq) (q : Reg (cons (W (neg A)) G))
  : (m : Nat) -> Reg (cons (W (neg (cons A G m))) (cons (W (NegS (cons A G))) G)) = split {
  zero -> weak (cons (W (neg A)) G) (cons (W (neg A)) (cons (W (NegS (cons A G))) G))
            (subCons (W (neg A)) G (cons (W (NegS (cons A G))) G) (subTail (W (NegS (cons A G))) G)) q ;
  suc m -> weak (cons (G m) (cons (W (neg (G m))) empty)) (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G))
            (sub1 (G m) (cons (W (neg (G m))) empty) (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G))
              (\ k -> at (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G)) (suc (suc m)) k)
              (sub1 (W (neg (G m))) empty (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G))
                (\ k -> at (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G)) zero k)
                (subEmpty (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G)))))
            (idA (G m) empty) } ;

-- a cut rule, from a proof that regular sequents are eliminable
ElimProof : U l = (D : Seq) -> Reg D -> Elim D ;
CutRule : U l = (A : T) -> (G : Seq) -> Reg (cons A G) -> Reg (cons (W (neg A)) G) -> Reg G ;

cutBy (el : ElimProof) : CutRule = \ A G p q ->
  el (cons A G) p G (focus (cons (W (NegS (cons A G))) G) zero zero (cutPrem A G q)) ;

