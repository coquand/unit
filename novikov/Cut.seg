-- Cut.seg: Novikov's theorem, the admissibility of the rule of inference
-- (1943, section 8), in the form of the appendix of Coquand, "A semantics
-- of evidence for classical arithmetic" (1993).  There is no induction
-- on the cut formula: the induction is on the regularity proof of the
-- formula eliminated.
--
-- A sequent D is eliminable if, for every B, B is regular whenever
-- W (neg D) , B  is (neg D, the product NegS D of the negations of the
-- formulas of D).
--
-- Lemma 5 (Novikov's Lemmas 9-12).  If  W (neg D) , B  and
-- Sp (neg o e) , B  are regular then so is
--   Sp (\ j -> neg (e j , D)) , B :
-- the product neg D is moved into each summand neg (e j) of the sum.
-- By Replace on the second proof (invariant: the first, weakened).  At
-- a focus on the summand neg (e l), focus on the l-th summand of the
-- result, the product of W (neg (e l)) and the W (neg (D m)).  Its first
-- factor is the focus itself (its premises are those of the focus,
-- with the induction hypothesis), the others come from the first proof
-- by inversion.
--
-- Lemma 6.  If every D j is eliminable and  Sp (\ j -> neg (D j)) , B  is
-- regular, then so is B.  By Replace: at a focus on the summand
-- neg (D l), the premises give (induction hypothesis)  W (neg (D l m)) , B
-- for all m, hence  W (neg (D l)) , B,  hence B since D l is eliminable.
--
-- Proposition 2.  Every regular sequent D is eliminable, by induction on
-- its proof.  Let the last focus of D be on the k-th summand c of D r.
-- Given  W (neg D) , B  regular, Replace (an inner induction): at a focus
-- on the product neg D, its r-th premise gives (induction hypothesis)
-- W (neg (D r)) , B, and inversion at k gives  neg c , B.  If c is 1 or
-- a true constant then neg c is 0 or a false constant, and is removed.  If c = Sp g, then the premises of the focus on
-- D are the regular sequents  g j , D,  eliminable by the outer
-- induction hypothesis; Lemma 5 (with e = g) and Lemma 6 (with
-- D j = g j , D) give B.
--
-- The cut rule follows: if  A , G  and  W (neg A) , G  are regular, then
-- so is G, since  W (neg (A , G)) , G  is regular (identity).

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ; open Identity[l] ;

Elim (D : Seq) : U l = (B : Seq) -> Reg (cons (W (NegS D)) B) -> Reg B ;

------------------------------------------------------------------------
-- Lemma 5

module AndSum (D : Seq) (e : Nat -> T) {

  X : T = Sp (\ j -> neg (e j)) ;
  Z : T = Sp (\ j -> NegS (cons (e j) D)) ;
  WN : T = W (NegS D) ;

  Q (B : Seq) : U l = Reg (cons WN B) ;
  qe : QExt Q = \ a B q -> weak (cons WN B) (cons WN (cons a B)) (subCons WN B (cons a B) (subTail a B)) q ;

  C : Seq -> U l = RepC X Z Q ;

  -- the place of the summands of  Z , g i , B  in  g i , W (neg (e l)) , Z , B
  subFirst (G B : Seq) (l : Nat) (a : T) : Sub (cons Z (cons a B)) (cons a (cons (W (neg (e l))) (cons Z B))) =
    sub1 Z (cons a B) (cons a (cons (W (neg (e l))) (cons Z B)))
      (\ k -> at (cons a (cons (W (neg (e l))) (cons Z B))) (suc (suc zero)) k)
      (sub1 a B (cons a (cons (W (neg (e l))) (cons Z B)))
        (\ k -> at (cons a (cons (W (neg (e l))) (cons Z B))) zero k)
        (\ m k -> at (cons a (cons (W (neg (e l))) (cons Z B))) (suc (suc (suc m))) k)) ;

  -- the first factor: the focus on neg (e l), moved
  first (G B : Seq) (q : Q B) (s : Sub G (cons X B)) (l : Nat) (v : Rule (PremC C G) (neg (e l)))
    : Reg (cons (W (neg (e l))) (cons Z B)) =
    focus (cons (W (neg (e l))) (cons Z B)) zero zero
      (ruleMap (PremC C G) (Prem (cons (W (neg (e l))) (cons Z B)))
        (\ g w i -> weak (cons Z (cons (g i) B)) (cons (g i) (cons (W (neg (e l))) (cons Z B)))
                      (subFirst G B l (g i))
                      ((w i).2 (cons (g i) B) (qe (g i) B q) (subPush (g i) X G B s)))
        (neg (e l)) v) ;

  -- the other factors: inversion of the invariant
  other (B : Seq) (q : Q B) (m : Nat) : Reg (cons (W (neg (D m))) (cons Z B)) =
    weak (cons (W (neg (D m))) B) (cons (W (neg (D m))) (cons Z B))
      (subCons (W (neg (D m))) B (cons Z B) (subTail Z B))
      (inv (NegS D) m B q) ;

  factors (G B : Seq) (q : Q B) (s : Sub G (cons X B)) (l : Nat) (v : Rule (PremC C G) (neg (e l)))
    : (m : Nat) -> Reg (cons (W (neg (cons (e l) D m))) (cons Z B)) = split {
    zero -> first G B q s l v ;
    suc m -> other B q m } ;

  h : Handler X Z Q = \ G B q s l v -> focus (cons Z B) zero l (factors G B q s l v) ;

  andSum (B : Seq) (p : Reg (cons WN B)) (r : Reg (cons X B)) : Reg (cons Z B) =
    Replace[X, Z, Q, qe, h].replace B p r ;
} ;

------------------------------------------------------------------------
-- Lemma 6

module SumElim (Ds : Nat -> Seq) (el : (j : Nat) -> Elim (Ds j)) {

  X : T = Sp (\ j -> NegS (Ds j)) ;
  C : Seq -> U l = RepC X F0 NoQ ;

  h : Handler X F0 NoQ = \ G B q s l v ->
    wkTail F0 B (el l B
      (focus (cons (W (NegS (Ds l))) B) zero zero (\ m ->
         weak (cons (W (neg (Ds l m))) B) (cons (W (neg (Ds l m))) (cons (W (NegS (Ds l))) B))
           (subCons (W (neg (Ds l m))) B (cons (W (NegS (Ds l))) B) (subTail (W (NegS (Ds l))) B))
           (str0 (cons (W (neg (Ds l m))) B)
             ((v m).2 (cons (W (neg (Ds l m))) B) tt (subPush (W (neg (Ds l m))) X G B s)))))) ;

  sumElim (B : Seq) (p : Reg (cons X B)) : Reg B =
    str0 B (Replace[X, F0, NoQ, noQ, h].replace B tt p) ;
} ;

------------------------------------------------------------------------
-- Proposition 2: a regular sequent is eliminable

-- the last focus of D on c, with neg c , B regular
lastFocus (D B : Seq) (p : Reg (cons (W (NegS D)) B))
  : (c : T) -> Rule (PremC Elim D) c -> Reg (cons (neg c) B) -> Reg (cons F0 B) = split {
  F0 -> \ v r -> absurd v ;
  F1 -> \ v r -> r ;
  X n -> \ v r -> weak (cons (NX n) B) (cons F0 B) (sub1 (NX n) B (cons F0 B) (\ k -> inl v) (subTail F0 B)) r ;
  NX n -> \ v r -> weak (cons (X n) B) (cons F0 B) (sub1 (X n) B (cons F0 B) (\ k -> inl v) (subTail F0 B)) r ;
  Sp g -> \ v r -> wkTail F0 B
    (SumElim[\ j -> cons (g j) D, \ j -> (v j).2].sumElim B
      (AndSum[D, g].andSum B p r)) } ;

elimH (D : Seq) (n k : Nat) (v : Rule (PremC Elim D) (comp (D n) k)) : Handler (W (NegS D)) F0 NoQ =
  \ G B q s l w ->
    lastFocus D B (recX (W (NegS D)) F0 NoQ G B s l w) (comp (D n) k) v
      (substH (\ z -> Reg (cons z B)) (compNeg (D n) k)
        (inv (neg (D n)) k B
          (str0 (cons (W (neg (D n))) B)
            ((w n).2 (cons (W (neg (D n))) B) tt (subPush (W (neg (D n))) (W (NegS D)) G B s))))) ;

elimStep : Step Elim = \ D n k v B p ->
  str0 B (Replace[W (NegS D), F0, NoQ, noQ, elimH D n k v].replace B tt p) ;

elim (D : Seq) (p : Reg D) : Elim D = regInd Elim elimStep D p ;

------------------------------------------------------------------------
-- the cut rule and the rule of inference

cutPrem (A : T) (G : Seq) (q : Reg (cons (W (neg A)) G))
  : (m : Nat) -> Reg (cons (W (neg (cons A G m))) (cons (W (NegS (cons A G))) G)) = split {
  zero -> weak (cons (W (neg A)) G) (cons (W (neg A)) (cons (W (NegS (cons A G))) G))
            (subCons (W (neg A)) G (cons (W (NegS (cons A G))) G) (subTail (W (NegS (cons A G))) G)) q ;
  suc m -> weak (cons (G m) (cons (W (neg (G m))) empty)) (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G))
            (sub1 (G m) (cons (W (neg (G m))) empty) (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G))
              (\ k -> at (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G)) (suc (suc m)) k)
              (sub1 (W (neg (G m))) empty (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G))
                (\ k -> at (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G)) zero k)
                (subEmpty (cons (W (neg (G m))) (cons (W (NegS (cons A G))) G)))))
            (idA (G m) empty) } ;

cut (A : T) (G : Seq) (p : Reg (cons A G)) (q : Reg (cons (W (neg A)) G)) : Reg G =
  elim (cons A G) p G (focus (cons (W (NegS (cons A G))) G) zero zero (cutPrem A G q)) ;

-- Novikov's rule 5: if F and  ~F v G  are regular, so is G
mp (A : T) (G : Seq) (p : Reg (cons A empty)) (q : Reg (cons (W (neg A)) G)) : Reg G =
  cut A G (weak (cons A empty) (cons A G) (subCons A empty G (subEmpty G)) p) q ;

-- consistency: A and ~A are not both regular
consistent (A : T) (p : Reg (cons A empty)) (q : Reg (cons (W (neg A)) empty)) : Empty =
  notEmpty (mp A empty p q) ;
