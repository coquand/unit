-- Identity.seg: two lemmas without cut.
--
-- Identity (Novikov 1943, section 8: "each expression F v ~F is
-- regular").  For every formula A and sequent G:
--   IdA A:  A , W (neg A) , G  is regular   (A read as a sum)
--   IdU A:  W A , neg A , G    is regular   (A read as a product)
-- by induction on A, the two together.  For a constant, the true one of
-- x_n, ~x_n is the focus.  For A = Sp f:
--   IdA: focus on the product neg A = Sp (neg o f); its j-th premise
--        neg (f j) , A , W (neg A) , G  contains  W (f j) , neg (f j)
--        (f j is a summand of A), regular by IdU (f j);
--   IdU: focus on the product A; its i-th premise  f i , W A , neg A , G
--        contains  f i , W (neg (f i))  (neg (f i) is a summand of the
--        sum neg A), regular by IdA (f i).
-- This is the only induction on formulas in the development.
--
-- Inversion (Novikov's Lemma 1, for one factor).  If  W u , B  is
-- regular then so is  comp u i , B : a factor of a product in a regular
-- sequent can replace the product.  By Replace: at a focus on u = Sp g
-- itself, the i-th premise gives  g i , g i , B , and a contraction.

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ;

------------------------------------------------------------------------
-- identity

IdA (A : T) : U l = (G : Seq) -> Reg (cons A (cons (W (neg A)) G)) ;
IdU (A : T) : U l = (G : Seq) -> Reg (cons (W A) (cons (neg A) G)) ;

idSp (f : Nat -> T) (r : (n : Nat) -> IdA (f n) * IdU (f n)) : IdA (Sp f) * IdU (Sp f) =
  (\ G -> focus (cons (Sp f) (cons (W (neg (Sp f))) G)) (suc zero) zero (\ j ->
     weak (cons (W (f j)) (cons (neg (f j)) G)) (H1 G j)
       (sub1 (W (f j)) (cons (neg (f j)) G) (H1 G j) (\ k -> at (H1 G j) (suc zero) j)
         (sub1 (neg (f j)) G (H1 G j) (\ k -> at (H1 G j) zero k)
           (\ m k -> at (H1 G j) (suc (suc (suc m))) k)))
       ((r j).2 G)),
   \ G -> focus (cons (W (Sp f)) (cons (neg (Sp f)) G)) zero zero (\ i ->
     weak (cons (f i) (cons (W (neg (f i))) G)) (H2 G i)
       (sub1 (f i) (cons (W (neg (f i))) G) (H2 G i) (\ k -> at (H2 G i) zero k)
         (sub1 (W (neg (f i))) G (H2 G i) (\ k -> at (H2 G i) (suc (suc zero)) i)
           (\ m k -> at (H2 G i) (suc (suc (suc m))) k)))
       ((r i).1 G)))
 where {
   H1 (G : Seq) (j : Nat) : Seq = cons (neg (f j)) (cons (Sp f) (cons (W (neg (Sp f))) G)) ;
   H2 (G : Seq) (i : Nat) : Seq = cons (f i) (cons (W (Sp f)) (cons (neg (Sp f)) G)) ;
 } ;

-- a constant: whichever of x_n, ~x_n is true is the focus
idX (n : Nat) : Or (Tr (val n)) (Fl (val n)) -> IdA (X n) * IdU (X n) = split {
  inl t -> (\ G -> focus (cons (X n) (cons (W (NX n)) G)) zero zero t,
            \ G -> focus (cons (W (X n)) (cons (NX n) G)) zero zero t) ;
  inr f -> (\ G -> focus (cons (X n) (cons (W (NX n)) G)) (suc zero) zero f,
            \ G -> focus (cons (W (X n)) (cons (NX n) G)) (suc zero) zero f) } ;

idNX (n : Nat) : Or (Tr (val n)) (Fl (val n)) -> IdA (NX n) * IdU (NX n) = split {
  inl t -> (\ G -> focus (cons (NX n) (cons (W (X n)) G)) (suc zero) zero t,
            \ G -> focus (cons (W (NX n)) (cons (X n) G)) (suc zero) zero t) ;
  inr f -> (\ G -> focus (cons (NX n) (cons (W (X n)) G)) zero zero f,
            \ G -> focus (cons (W (NX n)) (cons (X n) G)) zero zero f) } ;

ident : (A : T) -> IdA A * IdU A = split {
  F0 -> (\ G -> focus (cons F0 (cons (W F1) G)) (suc zero) zero tt,
         \ G -> focus (cons (W F0) (cons F1 G)) (suc zero) zero tt) ;
  F1 -> (\ G -> focus (cons F1 (cons (W F0) G)) zero zero tt,
         \ G -> focus (cons (W F1) (cons F0 G)) zero zero tt) ;
  X n -> idX n (decB (val n)) ;
  L n -> (\ G -> lax (cons (L n) (cons (W (NL n)) G)) zero zero (suc zero) zero tt (refl (NL n)),
          \ G -> lax (cons (W (L n)) (cons (NL n) G)) zero zero (suc zero) zero tt (refl (NL n))) ;
  NL n -> (\ G -> lax (cons (NL n) (cons (W (L n)) G)) zero zero (suc zero) zero tt (refl (L n)),
           \ G -> lax (cons (W (NL n)) (cons (L n) G)) zero zero (suc zero) zero tt (refl (L n))) ;
  NX n -> idNX n (decB (val n)) ;
  Sp f | r -> idSp f r } ;

idA (A : T) : IdA A = (ident A).1 ;

------------------------------------------------------------------------
-- inversion

invH (i : Nat) : (u : T) -> Handler (W u) (comp u i) NoQ = split {
  F0 -> \ G B q s l v -> absurd v ;
  F1 -> \ G B q s l v -> focus (cons F1 B) zero zero tt ;
  X n -> \ G B q s l v -> focus (cons (X n) B) zero zero v ;
  NX n -> \ G B q s l v -> focus (cons (NX n) B) zero zero v ;
  L n -> \ G B q s l v -> absurd v ;
  NL n -> \ G B q s l v -> absurd v ;
  Sp g -> \ G B q s l v ->
    weak (cons (g i) (cons (g i) B)) (cons (g i) B) (subDup (g i) B)
      ((v i).2 (cons (g i) B) tt (subPush (g i) (W (Sp g)) G B s)) } ;

-- u = a is a letter; its negation is in B
invL (i : Nat) (u : T) (B : Seq) (a : T) (lt : Letter a) (e : Id T u a)
  : Where (W u) B (neg a) -> Reg (cons (comp u i) B) = split {
  inl lb -> absurd (letterNeq a lt (transH (symH e) lb.2)) ;
  inr pb -> laxPlaces (cons (comp u i) B) a lt
              (zero, zero, substH (\ z -> Id T (comp (comp z i) zero) a) (symH e) (comp2Letter a lt i zero))
              (placeIn (comp u i) B (neg a) pb) } ;

inv (u : T) (i : Nat) (B : Seq) (p : Reg (cons (W u) B)) : Reg (cons (comp u i) B) =
  Replace[W u, comp u i, NoQ, noQ, invH i u, \ G B q s a lt l e w -> invL i u B a lt e w].replace B tt p ;
