-- Finite.seg: the auxiliary theorem of section 10 of Novikov's 1943
-- paper, announced in the note of 1939 ("Sur quelques théorèmes
-- d'existence", C. R. Acad. Sci. URSS 23, 438-440): if the sum
-- F_1 + F_2 + ... of finitary formulas is regular, then so is a finite
-- part F_1 + ... + F_N, and N is computed from the regularity proof.
--
-- A formula is hereditarily finite (HF) if each of its sums and products
-- takes only finitely many distinct values: every term equals one of the
-- first N0.  The finitary formulas (letters, constants, & and v) are HF.
--
-- The finite part:  S_N = Sp (\ l -> trunc l N h),  the summands h l for
-- l <= N and 0 after; S_N , B  regular implies  S_N' , B  regular for
-- N <= N' (inclusion).
--
-- Theorem.  If the h l are HF and  Sp h , B  is regular, with every
-- formula of B HF, then  S_N , B  is regular for some N.  By induction on
-- regularity, for all such B:
--   - a distinguished term c, a summand of h l or of B: if c is atomic,
--     N = l (or 0); if c = Sp g, c is HF, so its factors take finitely
--     many values g 0, ..., g K up to equality; the induction hypothesis
--     gives N_j for the premises  g j , B  (j <= K), and N is the maximum
--     of the N_j (and of l).  Every premise  g j , S_N , B  is then the
--     premise for some j <= K, after inclusion.
--   - an axiom A v ~A: N is the largest index of a summand of Sp h used.
-- There is no cut: the induction is on the given regularity proof.

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ; open Calculus[l] ; open Existence[l] ;

------------------------------------------------------------------------
-- order and maxima on Nat

Le : Nat -> Nat -> U l = split {
  zero -> \ n -> Top ;
  suc m | r -> split { zero -> Empty ; suc n -> r n } } ;

leRefl : (n : Nat) -> Le n n = split { zero -> tt ; suc n | r -> r } ;

leTrans : (a b c : Nat) -> Le a b -> Le b c -> Le a c = split {
  zero -> \ b c x y -> tt ;
  suc a | r -> split {
    zero -> \ c x y -> absurd x ;
    suc b -> split {
      zero -> \ x y -> absurd y ;
      suc c -> \ x y -> r b c x y } } } ;

max : Nat -> Nat -> Nat = split {
  zero -> \ b -> b ;
  suc a | r -> split { zero -> suc a ; suc b -> suc (r b) } } ;

leMaxL : (a b : Nat) -> Le a (max a b) = split {
  zero -> \ b -> tt ;
  suc a | r -> split { zero -> leRefl a ; suc b -> r b } } ;

leMaxR : (a b : Nat) -> Le b (max a b) = split {
  zero -> \ b -> leRefl b ;
  suc a | r -> split { zero -> tt ; suc b -> r b } } ;

-- the maximum of f 0, ..., f n
bigMax : Nat -> (Nat -> Nat) -> Nat = split {
  zero -> \ f -> f zero ;
  suc n | r -> \ f -> max (f zero) (r (\ i -> f (suc i))) } ;

leBigMax : (j n : Nat) -> (f : Nat -> Nat) -> Le j n -> Le (f j) (bigMax n f) = split {
  zero -> split {
    zero -> \ f x -> leRefl (f zero) ;
    suc n -> \ f x -> leMaxL (f zero) (bigMax n (\ i -> f (suc i))) } ;
  suc j | r -> split {
    zero -> \ f x -> absurd x ;
    suc n -> \ f x -> leTrans (f (suc j)) (bigMax n (\ i -> f (suc i))) (bigMax (suc n) f)
                         (r n (\ i -> f (suc i)) x) (leMaxR (f zero) (bigMax n (\ i -> f (suc i)))) } } ;

------------------------------------------------------------------------
-- the finite parts of a sum

-- trunc l N h = h l for l <= N, and 0 for l > N
trunc : (k : Nat) -> (N : Nat) -> (h : Nat -> T) -> T = split {
  zero -> \ N h -> h zero ;
  suc k | r -> split { zero -> \ h -> F0 ; suc N -> \ h -> r N (\ i -> h (suc i)) } } ;

truncAt : (k N : Nat) -> (h : Nat -> T) -> Le k N -> Id T (trunc k N h) (h k) = split {
  zero -> \ N h x -> refl (h zero) ;
  suc k | r -> split { zero -> \ h x -> absurd x ; suc N -> \ h x -> r N (\ i -> h (suc i)) x } } ;

truncMono : (k N N' : Nat) -> (h : Nat -> T) -> Le N N' ->
  Or (FalseAtom (trunc k N h)) (Id T (trunc k N' h) (trunc k N h)) = split {
  zero -> \ N N' h x -> inr (refl (h zero)) ;
  suc k | r -> split {
    zero -> \ N' h x -> inl tt ;
    suc N -> split {
      zero -> \ h x -> absurd x ;
      suc N' -> \ h x -> r N N' (\ i -> h (suc i)) x } } } ;

------------------------------------------------------------------------
-- hereditarily finite formulas

HF : T -> U l = split {
  F0 -> Top ; F1 -> Top ; X n -> Top ; NX n -> Top ; L n -> Top ; NL n -> Top ;
  Sp g | r -> ((K : Nat) * ((j : Nat) -> (j' : Nat) * Le j' K * Id T (g j) (g j'))) * ((j : Nat) -> r j) } ;

hfComp : (a : T) -> HF a -> (i : Nat) -> HF (comp a i) = split {
  F0 -> \ z i -> z ; F1 -> \ z i -> z ; X n -> \ z i -> z ; NX n -> \ z i -> z ;
  L n -> \ z i -> z ; NL n -> \ z i -> z ; Sp g -> \ z i -> z.2 i } ;

hfW (x : T) (hx : HF x) : HF (W x) = ((zero, \ j -> (zero, tt, refl x)), \ j -> hx) ;

pairRep (x y : T) : (j : Nat) -> (j' : Nat) * Le j' (suc zero) * Id T (pairF x y j) (pairF x y j') = split {
  zero -> (zero, tt, refl x) ;
  suc j -> (suc zero, tt, refl y) } ;

pairHF (x y : T) (hx : HF x) (hy : HF y) : (j : Nat) -> HF (pairF x y j) = split {
  zero -> hx ;
  suc j -> hy } ;

hfPair (x y : T) (hx : HF x) (hy : HF y) : HF (Sp (pairF x y)) = ((suc zero, pairRep x y), pairHF x y hx hy) ;

-- the finitary formulas are hereditarily finite
hfEmb : (a : Fm) -> HF (emb a) = split {
  la n -> tt ; nla n -> tt ; cx n -> tt ; cnx n -> tt ;
  fand a b | ra rb -> hfPair (W (emb a)) (W (emb b)) (hfW (emb a) ra) (hfW (emb b) rb) ;
  for a b | ra rb -> hfW (Sp (pairF (emb a) (emb b))) (hfPair (emb a) (emb b) ra rb) } ;

------------------------------------------------------------------------
-- the theorem

module Bound (h : Nat -> T) (hh : (n : Nat) -> HF (h n)) {

  S : T = Sp h ;
  SN (N : Nat) : T = Sp (\ k -> trunc k N h) ;

  QF (B : Seq) : U l = (m : Nat) -> HF (B m) ;

  qfCons (a : T) (ha : HF a) (B : Seq) (q : QF B) : (m : Nat) -> HF (cons a B m) = split {
    zero -> ha ;
    suc m -> q m } ;

  -- a larger finite part
  monoCov (B : Seq) (N N' k : Nat) : Or (FalseAtom (trunc k N h)) (Id T (trunc k N' h) (trunc k N h))
    -> Cov (cons (SN N') B) (trunc k N h) = split {
    inl z -> inl z ;
    inr e -> inr (zero, k, e) } ;

  subMono (B : Seq) (N N' : Nat) (x : Le N N') : Sub (cons (SN N) B) (cons (SN N') B) = split {
    zero -> \ k -> monoCov B N N' k (truncMono k N N' h x) ;
    suc m -> \ k -> at (cons (SN N') B) (suc m) k } ;

  mono (B : Seq) (N N' : Nat) (x : Le N N') (p : Reg (cons (SN N) B)) : Reg (cons (SN N') B) =
    weak (cons (SN N) B) (cons (SN N') B) (subMono B N N' x) p ;

  C (G : Seq) : U l = (B : Seq) -> QF B -> Sub G (cons S B) -> (N : Nat) * Reg (cons (SN N) B) ;

  -- the premises of a distinguished term c, for every large enough N
  Collect (B : Seq) (c : T) : U l = (N0 : Nat) * ((N : Nat) -> Le N0 N -> Rule (Prem (cons (SN N) B)) c) ;

  ih (G B : Seq) (q : QF B) (s : Sub G (cons S B)) (g : Nat -> T) (z : HF (Sp g)) (v : PremC C G g) (j : Nat)
    : (N : Nat) * Reg (cons (SN N) (cons (g j) B)) =
    (v j).2 (cons (g j) B) (qfCons (g j) (z.2 j) B q) (subPush (g j) S G B s) ;

  -- the premise for j is the premise for a j' <= K
  premJ (G B : Seq) (q : QF B) (s : Sub G (cons S B)) (g : Nat -> T) (z : HF (Sp g)) (v : PremC C G g)
    (N : Nat) (x : Le (bigMax z.1.1 (\ j -> (ih G B q s g z v j).1)) N) (j : Nat)
    : Reg (cons (g j) (cons (SN N) B)) =
    weak (cons (SN N) (cons (g j) B)) (cons (g j) (cons (SN N) B)) (subSwap (SN N) (g j) B)
      (substH (\ t -> Reg (cons (SN N) (cons t B))) (symH (z.1.2 j).2.2)
        (mono (cons (g (z.1.2 j).1) B) (ih G B q s g z v (z.1.2 j).1).1 N
          (leTrans (ih G B q s g z v (z.1.2 j).1).1 (bigMax z.1.1 (\ j -> (ih G B q s g z v j).1)) N
            (leBigMax (z.1.2 j).1 z.1.1 (\ j -> (ih G B q s g z v j).1) (z.1.2 j).2.1) x)
          (ih G B q s g z v (z.1.2 j).1).2)) ;

  collect (G B : Seq) (q : QF B) (s : Sub G (cons S B)) : (c : T) -> HF c -> Rule (PremC C G) c -> Collect B c = split {
    F0 -> \ z v -> absurd v ;
    F1 -> \ z v -> (zero, \ N x -> v) ;
    X n -> \ z v -> (zero, \ N x -> v) ;
    NX n -> \ z v -> (zero, \ N x -> v) ;
    L n -> \ z v -> absurd v ;
    NL n -> \ z v -> absurd v ;
    Sp g -> \ z v -> (bigMax z.1.1 (\ j -> (ih G B q s g z v j).1), premJ G B q s g z v) } ;

  -- the distinguished term is the i-th summand of Sp h: N >= i
  atS (B : Seq) (c : T) (i : Nat) (e : Id T (h i) c) (col : Collect B c) : (N : Nat) * Reg (cons (SN N) B) =
    (max col.1 i,
     focus (cons (SN (max col.1 i)) B) zero i
       (substH (Rule (Prem (cons (SN (max col.1 i)) B)))
         (transH (symH e) (symH (truncAt i (max col.1 i) h (leMaxR col.1 i))))
         (col.2 (max col.1 i) (leMaxL col.1 i)))) ;

  -- the distinguished term is in B
  atB (B : Seq) (c : T) (n i : Nat) (e : Id T (comp (B n) i) c) (col : Collect B c) : (N : Nat) * Reg (cons (SN N) B) =
    (col.1, focus (cons (SN col.1) B) (suc n) i
              (substH (Rule (Prem (cons (SN col.1) B))) (symH e) (col.2 col.1 (leRefl col.1)))) ;

  placeS (G B : Seq) (q : QF B) (s : Sub G (cons S B)) (c : T) (v : Rule (PremC C G) c)
    : (n : Nat) -> (i : Nat) -> Id T (comp (cons S B n) i) c -> (N : Nat) * Reg (cons (SN N) B) = split {
    zero -> \ i e -> atS B c i e (collect G B q s c (substH HF e (hh i)) v) ;
    suc n -> \ i e -> atB B c n i e (collect G B q s c (substH HF e (hfComp (B n) (q n) i)) v) } ;

  coverS (G B : Seq) (q : QF B) (s : Sub G (cons S B)) (c : T) (v : Rule (PremC C G) c)
    : Cov (cons S B) c -> (N : Nat) * Reg (cons (SN N) B) = split {
    inl z -> absurd (falseRule (PremC C G) c z v) ;
    inr p -> placeS G B q s c v p.1 p.2.1 p.2.2 } ;

  step : Step C = \ G m k v B q s -> coverS G B q s (comp (G m) k) v (s m k) ;

  -- an axiom A v ~A: N bounds the summands of Sp h used
  idx (B : Seq) (t : T) : Where S B t -> Nat = split { inl la -> la.1 ; inr p -> zero } ;

  placeN (B : Seq) (t : T) (N : Nat) : (w : Where S B t) -> Le (idx B t w) N -> Place (cons (SN N) B) t = split {
    inl la -> \ x -> (zero, la.1, transH (truncAt la.1 N h x) la.2) ;
    inr p -> \ x -> placeIn (SN N) B t p } ;

  laxN (B : Seq) (a : T) (lt : Letter a) (wa : Where S B a) (wb : Where S B (neg a)) : (N : Nat) * Reg (cons (SN N) B) =
    (max (idx B a wa) (idx B (neg a) wb),
     laxPlaces (cons (SN (max (idx B a wa) (idx B (neg a) wb))) B) a lt
       (placeN B a (max (idx B a wa) (idx B (neg a) wb)) wa (leMaxL (idx B a wa) (idx B (neg a) wb)))
       (placeN B (neg a) (max (idx B a wa) (idx B (neg a) wb)) wb (leMaxR (idx B a wa) (idx B (neg a) wb)))) ;

  stepL : StepL C = \ G m k m' k' lt e B q s ->
    laxN B (comp (G m) k) lt (whereOf S B (comp (G m) k) lt (s m k))
      (whereOf S B (neg (comp (G m) k)) (letterNeg (comp (G m) k) lt) (substH (Cov (cons S B)) e (s m' k'))) ;

  bound (p : Reg (cons S empty)) : (N : Nat) * Reg (cons (SN N) empty) =
    regInd C step stepL (cons S empty) p empty (\ m -> tt) (subRefl (cons S empty)) ;
} ;

-- Novikov's auxiliary theorem (1943, section 10; announced 1939): a regular (in particular a provable) sum of
-- finitary formulas has a regular finite part
auxTheorem (F : Nat -> Fm) (p : Reg (cons (Sp (\ n -> emb (F n))) empty))
  : (N : Nat) * Reg (cons (Bound[\ n -> emb (F n), \ n -> hfEmb (F n)].SN N) empty) =
  Bound[\ n -> emb (F n), \ n -> hfEmb (F n)].bound p ;

auxTheoremProof (F : Nat -> Fm) (p : Provable (cons (Sp (\ n -> emb (F n))) empty))
  : (N : Nat) * Reg (cons (Bound[\ n -> emb (F n), \ n -> hfEmb (F n)].SN N) empty) =
  auxTheorem F (regular (cons (Sp (\ n -> emb (F n))) empty) p) ;
