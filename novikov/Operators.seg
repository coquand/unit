-- Operators.seg: Novikov's proof of the rule of inference (1943,
-- sections 7 and 8), with his operators B_tau and A_tau.
--
-- Novikov's symbol tau records the choices of distinguished terms in a
-- regularity proof, and he shows by induction on regularity that a regular
-- F has a tau for which B_tau(F) is a product of elementary regular
-- formulas.  Here tau is the regularity proof p itself.
--
-- B_p(D) is the product of the leaves of p.  A leaf is a sequent D with a
-- true summand, written as one sum SumS D:
--   B_(ax D ..)(D)        = W (SumS D)
--   B_(pi D .. g e ds)(D) = Sp (\ j -> W (B_(ds j)(g j , D)))
-- A_p(neg D) is neg B_p(D).  Negation computes through Sp, so Novikov's
-- duality  sum A_tau(~F_i) = sum A ~A ~L v sum ~x' ~L  holds by definition:
--   A_(ax D ..)        = W (neg D)                 (neg D, a product)
--   A_(pi D .. g e ds) = Sp (\ j -> W (A_(ds j)))  (a sum).
--
-- Lemma 18.  If  W (neg D) , B  is regular then so is  A_p , B.
--   By induction on p.  For a leaf, A_p = W (neg D).  If the last
--   distinguished term of p is c = Sp g, two inversions give
--   neg c , B = Sp (neg o g) , B.  Then the opening of brackets (Novikov's
--   Lemmas 9-12, Cut.AndSum) gives  Sp (\ j -> neg (g j , D)) , B.
--   Finally Lemma 17, with the induction hypothesis, applies A_(ds j)
--   inside each summand.
-- Lemma 17.  If  Sp P , B  is regular, and for every j and B'
--   W (P j) , B'  regular implies  Q j , B'  regular, then
--   Sp (\ j -> W (Q j)) , B  is regular.  By induction on  Sp P , B
--   (Replace): a distinguished term P l is moved to  W (P l) , Y , B, and
--   the hypothesis gives  Q l , Y , B,  the constituent needed.
-- Lemma 15.  If  A_p , B  is regular then so is B.  By induction on p.
--   For a leaf, two inversions give  neg c , B  with c true, so neg c is a
--   false atom and is removed (Lemma 14).  Otherwise, by induction on
--   A_p , B  (Replace): a distinguished term W (A_(ds l)) gives
--   A_(ds l) , B,  hence B by the induction hypothesis on p.
--
-- Hence every regular sequent is eliminable (elim), and the cut rule
-- follows (cut, Cut.cutBy).  The induction is on the regularity proof p of
-- the formula eliminated, never on a formula.

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ; open Identity[l] ; open Cut[l] ;

-- a sequent as one sum: the summands are the one-factor products W (D m)
SumS (D : Seq) : T = Sp (\ m -> W (D m)) ;

-- B_p(D), the product of the leaves of p
Bop : (D : Seq) -> Reg D -> T = split {
  ax D m k t -> W (SumS D) ;
  pi D m k g e ds | r -> Sp (\ j -> W (r j)) ;
  lax D m k m' k' lt e -> W (SumS D) } ;

-- A_p(neg D)
Aop (D : Seq) (p : Reg D) : T = neg (Bop D p) ;

-- Novikov's duality, by definition
aAx (D : Seq) (m k : Nat) (t : True (comp (D m) k))
  : Id T (Aop D (ax D m k t)) (W (NegS D)) = refl (W (NegS D)) ;
aPi (D : Seq) (m k : Nat) (g : Nat -> T) (e : Id T (comp (D m) k) (Sp g)) (ds : (j : Nat) -> Reg (cons (g j) D))
  : Id T (Aop D (pi D m k g e ds)) (Sp (\ j -> W (Aop (cons (g j) D) (ds j)))) =
  refl (Sp (\ j -> W (Aop (cons (g j) D) (ds j)))) ;

------------------------------------------------------------------------
-- Lemma 17

module Open17 (P Q : Nat -> T) (h : (j : Nat) -> (B : Seq) -> Reg (cons (W (P j)) B) -> Reg (cons (Q j) B)) {

  X : T = Sp P ;
  Y : T = Sp (\ j -> W (Q j)) ;

  hd : Handler X Y NoQ = \ G B q s l v ->
    focus (cons Y B) zero l (\ i -> h l (cons Y B) (moveFocus X Y NoQ noQ G B q s (P l) v)) ;

  -- W (P l) , Y , B  when P l is a letter a: its negation is in B, or is
  -- another P l' (then the hypothesis at l' and a focus on Y)
  letterW (B : Seq) (a : T) (lt : Letter a) (l : Nat) (ee : Id T (P l) a)
    : Where X B (neg a) -> Reg (cons (W (P l)) (cons Y B)) = split {
    inr pb -> laxPlaces (cons (W (P l)) (cons Y B)) a lt (zero, zero, ee)
                (placeIn (W (P l)) (cons Y B) (neg a) (placeIn Y B (neg a) pb)) ;
    inl lb -> focus (cons (W (P l)) (cons Y B)) (suc zero) lb.1 (\ i ->
                h lb.1 (cons (W (P l)) (cons Y B))
                  (laxPlaces (cons (W (P lb.1)) (cons (W (P l)) (cons Y B))) a lt
                    (suc zero, zero, ee) (zero, zero, lb.2))) } ;

  hl : HandlerL X Y NoQ = \ G B q s a lt l ee w ->
    focus (cons Y B) zero l (\ i -> h l (cons Y B) (letterW B a lt l ee w)) ;

  open17 (B : Seq) (p : Reg (cons X B)) : Reg (cons Y B) = Replace[X, Y, NoQ, noQ, hd, hl].replace B tt p ;
} ;

------------------------------------------------------------------------
-- Lemma 18

lemma18 : (D : Seq) -> (p : Reg D) -> (B : Seq) -> Reg (cons (W (NegS D)) B) -> Reg (cons (Aop D p) B) = split {
  ax D m k t -> \ B q -> q ;
  lax D m k m' k' lt e -> \ B q -> q ;
  pi D m k g e ds | r -> \ B q ->
    Open17[\ j -> NegS (cons (g j) D), \ j -> Aop (cons (g j) D) (ds j), r].open17 B
      (AndSum[D, g].andSum B q (substH (\ z -> Reg (cons (neg z) B)) e (invTwice D B m k q))) } ;

------------------------------------------------------------------------
-- Lemma 15

falseComp : (c : T) -> FalseAtom c -> (k : Nat) -> FalseAtom (comp c k) = split {
  F0 -> \ z k -> z ;
  F1 -> \ z k -> z ;
  X n -> \ z k -> z ;
  NX n -> \ z k -> z ;
  L n -> \ z k -> z ;
  NL n -> \ z k -> z ;
  Sp f -> \ z k -> absurd z } ;

-- the negation of a true atom is a false atom
negTrue : (c : T) -> True c -> FalseAtom (neg c) = split {
  F0 -> \ t -> t ;
  F1 -> \ t -> t ;
  X n -> \ t -> t ;
  NX n -> \ t -> t ;
  L n -> \ t -> t ;
  NL n -> \ t -> t ;
  Sp f -> \ t -> t } ;

-- Lemma 14: a false atom is removed
dropFalse (a : T) (B : Seq) (z : FalseAtom a) (p : Reg (cons a B)) : Reg B =
  weak (cons a B) B (subFalse a B (falseComp a z)) p ;

h15 (D : Seq) (g : Nat -> T) (ds : (j : Nat) -> Reg (cons (g j) D))
  (r : (j : Nat) -> (B : Seq) -> Reg (cons (Aop (cons (g j) D) (ds j)) B) -> Reg B)
  : Handler (Sp (\ j -> W (Aop (cons (g j) D) (ds j)))) F0 NoQ = \ G B q s l v ->
  wkTail F0 B (r l B (str0 (cons (Aop (cons (g l) D) (ds l)) B)
    ((v zero).2 (cons (Aop (cons (g l) D) (ds l)) B) tt
      (subPush (Aop (cons (g l) D) (ds l)) (Sp (\ j -> W (Aop (cons (g j) D) (ds j)))) G B s)))) ;

lemma15 : (D : Seq) -> (p : Reg D) -> (B : Seq) -> Reg (cons (Aop D p) B) -> Reg B = split {
  ax D m k t -> \ B q -> dropFalse (neg (comp (D m) k)) B (negTrue (comp (D m) k) t) (invTwice D B m k q) ;
  pi D m k g e ds | r -> \ B q ->
    str0 B (Replace[Sp (\ j -> W (Aop (cons (g j) D) (ds j))), F0, NoQ, noQ, h15 D g ds r,
                    hlNone (Sp (\ j -> W (Aop (cons (g j) D) (ds j)))) F0 NoQ (\ l z -> z)].replace B tt q) ;
  lax D m k m' k' lt e -> \ B q -> letterLeaf D B m k m' k' lt e q } ;

------------------------------------------------------------------------
-- the rule of inference, Novikov's way

elim : ElimProof = \ D p B q -> lemma15 D p B (lemma18 D p B q) ;

cut : CutRule = cutBy elim ;

-- Novikov's rule 5: if F and  ~F v G  are regular, so is G
mp (A : T) (G : Seq) (p : Reg (cons A empty)) (q : Reg (cons (W (neg A)) G)) : Reg G =
  cut A G (weak (cons A empty) (cons A G) (subCons A empty G (subEmpty G)) p) q ;

-- consistency: A and ~A are not both regular
consistent (A : T) (p : Reg (cons A empty)) (q : Reg (cons (W (neg A)) empty)) : Empty =
  notEmpty (mp A empty p q) ;
