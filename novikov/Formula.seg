-- Formula.seg: Novikov's infinitary formulas (1943, sections 1 and 6).
--
-- A formula is a tree: Novikov's constants x_n and their negations, the
-- empty sum 0 and the empty product 1, and Sp f for a sequence f of
-- formulas.  The tree carries no polarity: Sp f read in an existential
-- position is the infinite sum (disjunction) of the f n, each read in a
-- universal position, and read in a universal position it is the infinite
-- product (conjunction) of the f n, each read in an existential position.
-- These are Novikov's normal forms (section 6): the summands of a sum are
-- products and the factors of a product are sums; a constant is both.
-- Finite sums and products are infinite ones with repeated terms.
-- The constants x_n, ~x_n are Novikov's; which of the two is true is
-- fixed once and for all (the parameter val of the regularity files).
--
-- Negation is the de Morgan dual (Novikov's reduced form of the negation,
-- section 1): it exchanges x_n and ~x_n, 0 and 1, and keeps the shape.
--
-- A sequent is a sequence of formulas read existentially, so that it is
-- the sum of all their summands: Novikov's merged sum (the tilde, section
-- 3), with the empty places filled by 0.  The k-th summand of an
-- existential formula is comp a k; the constant 1 read as a sum has every
-- summand 1, the constant 0 every summand 0.

level l ;
open Base ; open Paths[l] ;

data T = F0 | F1 | X (n : Nat) | NX (n : Nat) | Sp (f : Nat -> T) ;

neg : T -> T = split { F0 -> F1 ; F1 -> F0 ; X n -> NX n ; NX n -> X n ; Sp f | r -> Sp r } ;

-- the summands of a formula read as a sum
comp : T -> Nat -> T = split {
  F0 -> \ k -> F0 ; F1 -> \ k -> F1 ; X n -> \ k -> X n ; NX n -> \ k -> NX n ; Sp f -> f } ;

-- by definition the summands of the negation are the negated summands
compNeg : (a : T) -> (k : Nat) -> Id T (comp (neg a) k) (neg (comp a k)) = split {
  F0 -> \ k -> refl F1 ;
  F1 -> \ k -> refl F0 ;
  X n -> \ k -> refl (NX n) ;
  NX n -> \ k -> refl (X n) ;
  Sp f -> \ k -> refl (neg (f k)) } ;

Seq : U l = Nat -> T ;

cons (a : T) (G : Seq) : Seq = split { zero -> a ; suc m -> G m } ;

empty : Seq = \ m -> F0 ;

-- a formula read universally, as a one-summand sum, to enter a sequent
W (u : T) : T = Sp (\ n -> u) ;

-- the negation of a sequent: the product of the negations of its
-- formulas, each negation (a product) entering as a one-summand sum
NegS (G : Seq) : T = Sp (\ m -> W (neg (G m))) ;

-- a pair as a sequence (finite sums and products)
pairF (x y : T) : Nat -> T = split { zero -> x ; suc n -> y } ;

-- finitary formulas over the constants (decidable propositions, s. 10)
data Fm = cx (n : Nat) | cnx (n : Nat) | fand (a b : Fm) | for (a b : Fm) ;

-- truth of a Boolean value
Tr : Bool -> U l = split { true -> Top ; false -> Empty } ;
Fl : Bool -> U l = split { true -> Empty ; false -> Top } ;

decB : (b : Bool) -> Or (Tr b) (Fl b) = split { true -> inl tt ; false -> inr tt } ;

trFl : (b : Bool) -> Tr b -> Fl b -> Empty = split { true -> \ t f -> f ; false -> \ t f -> t } ;
