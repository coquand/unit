-- Arithmetic.seg: the applications (Novikov 1943, sections 9 and 10).
--
-- Induction (section 9).  For any sequence A of formulas (read as sums),
-- the sequent
--   W (neg (A 0)) , Sp (\ i -> A i & W (neg (A (i+1)))) , W (Sp A)
-- (that is  A 0 & forall i (A i -> A (i+1)) -> forall i A i)  is regular,
-- without cut.  Focus on the product Sp A; the n-th premise  A n , S  is
-- regular by induction on n: for 0 by identity; for n+1 focus on the
-- (n)-th summand A n & W (neg (A (n+1))), whose two premises are the case
-- n (weakened) and an identity.
--
-- Existence (section 10), in Existence.seg.

level l ;
open Base ; open Paths[l] ; open Formula[l] ; open Regular[l] ; open Identity[l] ; open Cut[l] ;

------------------------------------------------------------------------
-- induction

-- the conjunction of two formulas read as sums
and2 (x y : T) : T = Sp (pairF x y) ;

module Induction (A : Nat -> T) {

  Base0 : T = W (neg (A zero)) ;
  StepF : T = Sp (\ i -> and2 (A i) (W (neg (A (suc i))))) ;
  All : T = W (Sp A) ;
  S : Seq = cons Base0 (cons StepF (cons All empty)) ;

  -- identity:  A n , W (neg (A n))  inside the sequent H at places a and b
  idIn (n : Nat) (H : Seq) (a b : Nat) (ea : (k : Nat) -> Cov H (comp (A n) k))
    (eb : (k : Nat) -> Cov H (neg (A n))) : Reg H =
    weak (cons (A n) (cons (W (neg (A n))) empty)) H
      (sub1 (A n) (cons (W (neg (A n))) empty) H ea (sub1 (W (neg (A n))) empty H eb (subEmpty H)))
      (idA (A n) empty) ;

  stepPrem (n : Nat) (r : Reg (cons (A n) S)) : (j : Nat) -> Reg (cons (pairF (A n) (W (neg (A (suc n)))) j) (cons (A (suc n)) S)) = split {
    zero -> weak (cons (A n) S) (cons (A n) (cons (A (suc n)) S))
              (subCons (A n) S (cons (A (suc n)) S) (subTail (A (suc n)) S)) r ;
    suc j -> idIn (suc n) (cons (W (neg (A (suc n)))) (cons (A (suc n)) S)) (suc zero) zero
               (\ k -> at (cons (W (neg (A (suc n)))) (cons (A (suc n)) S)) (suc zero) k)
               (\ k -> at (cons (W (neg (A (suc n)))) (cons (A (suc n)) S)) zero k) } ;

  each : (n : Nat) -> Reg (cons (A n) S) = split {
    zero -> idIn zero (cons (A zero) S) zero (suc zero)
              (\ k -> at (cons (A zero) S) zero k) (\ k -> at (cons (A zero) S) (suc zero) k) ;
    suc n | r -> focus (cons (A (suc n)) S) (suc (suc zero)) n (stepPrem n r) } ;

  induction : Reg S = focus S (suc (suc zero)) zero each ;
} ;

