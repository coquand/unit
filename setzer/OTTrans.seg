        by-lex ii ii (om z0) ii ii z0 false true true (lex-self ii ii) (lex-IO z0 (isT-om0 z0 tz)) (lex-IO z0 (isT-om0 z0 tz)) (t0 tx ty (isT-om0 z0 tz)) (\ e1 e2 p q -> abF p) h1 h2 ;
      ii -> \ tx ty tz h1 h2 ->
        abF h2
    }
  }
} ;
