-- OTTrans.seg: Lemma 2.4 of Setzer (APAL 92, 1998), second half: <' is
-- transitive on T'.  With OTLaws (irreflexivity, trichotomy) <' is a
-- linear order on T'.
--
-- Informal proof.  For x, y, z in T': x <' y and y <' z imply x <' z.
--
-- Induction.  By recursion on x, then on y, then on z.  So the hypothesis
-- is available for a triple (x', y', z') when x' is a proper subterm of x
-- (y', z' arbitrary), or x' = x and y' is a proper subterm of y (z'
-- arbitrary), or x' = x, y' = y and z' is a proper subterm of z.  Every
-- triple used below is of one of these forms; there is one permuted triple,
-- in (3): from e <' c <' a we get e <' a by trichotomy and the triple
-- (a, e, c) (lt-rot).
--
-- Lexicographic step (lex-trans).  Suppose that on x, y, z the order is
-- the lexicographic order of a key in T' and a tag:
--   u <' v  iff  key u <' key v  or  (key u = key v and tag u v).
-- Then x <' y <' z gives x <' z from transitivity at the triple of keys
-- and transitivity of the tags at equal keys.  It is used three times:
--   sums:  key (a0,..,an) = a0, key of an atom = itself; tag = comparison
--          of the tails, an atom being below a proper sum with the same
--          first summand;
--   G':    key psi_pi b = pi when pi /= I, key of a term of Car' = itself;
--          tag psi_pi b, psi_pi d is b <' d, tag of psi_pi b against Car'
--          is true (psi_pi b <' pi), the other tags are false;
--   Car':  key Omega_a = a, key of a term of Fi' = itself; the tag is true
--          from Fi' to Omega_a (kappa <' Omega_kappa) and false otherwise.
-- Each view is a lemma per pair of kinds (lex-PP, lex-SS, lex-OO, ...),
-- from the clauses of Def. 2.3 and, where (11) negates a clause, from
-- trichotomy.  The key triple is smaller unless all three terms are atoms
-- (sums), in Car' (G'), in Fi' (Car').
--
-- Cases, by the kinds of x, y, z:
--   a zero:  x = 0 gives 0 <' z, as z /= 0;  nothing is <' 0.
--   a sum:   lexicographic step with the heads.
--   a phi:   seven patterns (caseFFF, ..., caseGGF), using (3), and (4)
--            in the form  phi'_a b <' g iff a <' g and b <' g,
--                         g <' phi'_c d iff g <=' c or g <=' d  (g in G').
--   G' with a psi_pi, pi /= I: lexicographic step with the G' view;
--   Car' with an Omega: lexicographic step with the Car' view;
--   Fi':     psi_I b <' psi_I d iff b <' d, psi_I b <' I, and nothing in
--            Fi' is above I.
-- The dispatcher lt-trans (216 cases of constructors, and the index of a
-- psi is split into I and not I) is generated by tools/gentrans.py.

level m ;
import OT ;
import OTLaws ;
open OT ;
open OTLaws[m] ;

------------------------------------------------------------------------
-- Notation

Tr (b : Bool) : U m = Id Bool b true ;
LT (x y : T) : U m = Tr (lt x y) ;
EQ (x y : T) : U m = Tr (eqT x y) ;
TT (x : T) : U m = Tr (isT x) ;
-- transitivity at one triple
Tr3 (x y z : T) : U m = LT x y -> LT y z -> LT x z ;

------------------------------------------------------------------------
-- Booleans

orE (P : U m) : (u v : Bool) -> Tr (or u v) -> (Tr u -> P) -> (Tr v -> P) -> P = split {
  false -> \ v h k1 k2 -> k2 h ;
  true -> \ v h k1 k2 -> k1 (refl true) } ;
orIl : (u v : Bool) -> Tr u -> Tr (or u v) = split {
  false -> \ v h -> abF h ; true -> \ v h -> refl true } ;
orIr : (u v : Bool) -> Tr v -> Tr (or u v) = split {
  false -> \ v h -> h ; true -> \ v h -> refl true } ;
andI : (u v : Bool) -> Tr u -> Tr v -> Tr (and u v) = split {
  false -> \ v h k -> h ; true -> \ v h k -> k } ;

orF : (u : Bool) -> Id Bool (or u false) u = split { false -> refl false ; true -> refl true } ;
orT : (u : Bool) -> Id Bool (or u true) true = split { false -> refl true ; true -> refl true } ;
andF : (u : Bool) -> Id Bool (and u false) false = split { false -> refl false ; true -> refl false } ;
andT : (u : Bool) -> Id Bool (and u true) u = split { false -> refl false ; true -> refl true } ;
orAF (u v : Bool) : Id Bool (or u (and v false)) u = trans (ap (\ w -> or u w) (andF v)) (orF u) ;
orAT (u v : Bool) : Id Bool (or u (and v true)) (or u v) = ap (\ w -> or u w) (andT v) ;

iteT : (u : Bool) -> (A B : Bool) -> Id Bool u true -> Id Bool (ifB u A B) A = split {
  false -> \ A B h -> abF h ; true -> \ A B h -> refl A } ;
iteF : (u : Bool) -> (A B : Bool) -> Id Bool u false -> Id Bool (ifB u A B) B = split {
  false -> \ A B h -> refl B ; true -> \ A B h -> abT h } ;

-- "<' is false if a = b" is harmless when the clause is false at a = b
guard-drop : (e : Bool) (c : B2) -> (Tr e -> Id Bool (fwd c) false) -> Id Bool (fwd (guard e c)) (fwd c) = split {
  false -> \ c h -> refl (fwd c) ;
  true -> \ c h -> sym (h (refl true)) } ;

------------------------------------------------------------------------
-- Equal terms, trichotomy

eq-sym (u v : T) (p : EQ u v) : EQ v u = trans (eqT-sym v u) p ;
eq-trans (u v w : T) (p : EQ u v) (q : EQ v w) : EQ u w = subst (\ s -> EQ u s) (eqT-sound v w q) p ;
eq-lt-l (u v w : T) (e : EQ u v) (h : LT v w) : LT u w = subst (\ s -> LT s w) (sym (eqT-sound u v e)) h ;
eq-lt-r (u v w : T) (h : LT u v) (e : EQ v w) : LT u w = subst (\ s -> LT u s) (eqT-sound v w e) h ;

le-of-lt (u v : T) (h : LT u v) : Tr (le u v) = orIl (lt u v) (eqT u v) h ;
le-of-eq (u v : T) (e : EQ u v) : Tr (le u v) = orIr (lt u v) (eqT u v) e ;
le-eq-r (u v w : T) (h : Tr (le u v)) (e : EQ v w) : Tr (le u w) = subst (\ s -> Tr (le u s)) (eqT-sound v w e) h ;

-- u <=' v <' w and u <' v <=' w, from transitivity at (u, v, w)
le-lt (u v w : T) (k : Tr3 u v w) (h : Tr (le u v)) (q : LT v w) : LT u w =
  orE (LT u w) (lt u v) (eqT u v) h (\ p -> k p q) (\ e -> eq-lt-l u v w e q) ;
lt-le (u v w : T) (k : Tr3 u v w) (p : LT u v) (h : Tr (le v w)) : LT u w =
  orE (LT u w) (lt v w) (eqT v w) h (\ q -> k p q) (\ e -> eq-lt-r u v w p e) ;

tri (u v : T) (tu : TT u) (tv : TT v) (P : U m) (k1 : LT u v -> P) (k2 : EQ u v -> P) (k3 : LT v u -> P) : P =
  boolCases P (eqT u v) k2 (\ ne -> boolCases P (lt u v) k1 (\ f -> k3 (lt-total u v tu tv ne f))) ;

asym-abs (P : U m) (u v : T) (tu : TT u) (tv : TT v) (p : LT u v) (q : LT v u) : P =
  abF (trans (sym (lt-asym u v tu tv p)) q) ;

-- u <' v <' w gives u <' w from transitivity at the triple (w, u, v)
lt-rot (u v w : T) (tu : TT u) (tv : TT v) (tw : TT w) (k : Tr3 w u v) (p : LT u v) (q : LT v w) : LT u w =
  tri u w tu tw (LT u w) (\ r -> r)
    (\ e -> asym-abs (LT u w) u v tu tv p (eq-lt-r v w u q (eq-sym u w e)))
    (\ r -> asym-abs (LT u w) v w tv tw q (k r p)) ;

-- not (v <' u) gives u <=' v, and conversely
nlt-le (u v : T) (tu : TT u) (tv : TT v) (h : Id Bool (lt v u) false) : Tr (le u v) =
  boolCases (Tr (le u v)) (eqT u v) (\ e -> le-of-eq u v e)
    (\ ne -> le-of-lt u v (lt-total v u tv tu (trans (eqT-sym v u) ne) h)) ;
le-nlt (u v : T) (tu : TT u) (tv : TT v) (h : Tr (le u v)) : Id Bool (lt v u) false =
  orE (Id Bool (lt v u) false) (lt u v) (eqT u v) h
    (\ p -> lt-asym u v tu tv p)
    (\ e -> subst (\ s -> Id Bool (lt s u) false) (eqT-sound u v e) (lt-irr u)) ;

-- the forms of u <' v produced by clause (11)
nle-lt (u v : T) (tu : TT u) (tv : TT v) : Id Bool (not (or (bwd (cmp2 u v)) (eqT v u))) (lt u v) =
  boolCases (Id Bool (not (or (bwd (cmp2 u v)) (eqT v u))) (lt u v)) (eqT u v)
    (\ e -> trans (ap (\ w -> not (or (bwd (cmp2 u v)) w)) (trans (eqT-sym v u) e))
              (trans (ap not (orT (bwd (cmp2 u v)))) (sym (ap fwd (eq-irr u v e)))))
    (\ ne -> trans (ap (\ w -> not (or (bwd (cmp2 u v)) w)) (trans (eqT-sym v u) ne))
               (trans (ap not (orF (bwd (cmp2 u v)))) (sym (cmp2-excl u v tu tv ne)))) ;
nbwd-le (u v : T) (tu : TT u) (tv : TT v) : Id Bool (not (bwd (cmp2 u v))) (le u v) =
  boolCases (Id Bool (not (bwd (cmp2 u v))) (le u v)) (eqT u v)
    (\ e -> trans (ap (\ c -> not (bwd c)) (eq-irr u v e))
              (sym (trans (ap (\ w -> or (lt u v) w) e) (orT (lt u v)))))
    (\ ne -> trans (sym (cmp2-excl u v tu tv ne))
               (sym (trans (ap (\ w -> or (lt u v) w) ne) (orF (lt u v))))) ;

------------------------------------------------------------------------
-- Clause (4):  phi'_a b <' g iff a <' g and b <' g, for g in G';
-- by (11), g <' phi'_c d iff g <=' c or g <=' d.

lt-phiG (a b : T) : (g : T) -> Tr (isG g) -> Id Bool (lt (phi a b) g) (and (lt a g) (lt b g)) = split {
  zero -> \ h -> abF h ; plus g0 gs -> \ h -> abF h ; phi g0 g1 -> \ h -> abF h ;
  psi g0 g1 -> \ h -> refl (and (lt a (psi g0 g1)) (lt b (psi g0 g1))) ;
  om g0 -> \ h -> refl (and (lt a (om g0)) (lt b (om g0))) ;
  ii -> \ h -> refl (and (lt a ii) (lt b ii)) } ;

lt-Gphi (c d : T) : (g : T) -> Tr (isG g) -> Id Bool (lt g (phi c d)) (not (and (lt c g) (lt d g))) = split {
  zero -> \ h -> abF h ; plus g0 gs -> \ h -> abF h ; phi g0 g1 -> \ h -> abF h ;
  psi g0 g1 -> \ h -> ap2 (\ u v -> not (and u v)) (sym (lt-swap (psi g0 g1) c)) (sym (lt-swap (psi g0 g1) d)) ;
  om g0 -> \ h -> ap2 (\ u v -> not (and u v)) (sym (lt-swap (om g0) c)) (sym (lt-swap (om g0) d)) ;
  ii -> \ h -> ap2 (\ u v -> not (and u v)) (sym (lt-swap ii c)) (sym (lt-swap ii d)) } ;

fg-elim (a b g : T) (hg : Tr (isG g)) (h : LT (phi a b) g) : LT a g * LT b g =
  (and-l (lt a g) (lt b g) (trans (sym (lt-phiG a b g hg)) h),
   and-r (lt a g) (lt b g) (trans (sym (lt-phiG a b g hg)) h)) ;
fg-intro (a b g : T) (hg : Tr (isG g)) (p : LT a g) (q : LT b g) : LT (phi a b) g =
  trans (lt-phiG a b g hg) (andI (lt a g) (lt b g) p q) ;

gf-elim (P : U m) (c d g : T) (tc : TT c) (td : TT d) (tg : TT g) (hg : Tr (isG g)) (h : LT g (phi c d))
        (k1 : Tr (le g c) -> P) (k2 : Tr (le g d) -> P) : P =
  boolCases P (lt c g)
    (\ p -> k2 (nlt-le g d tg td (and-false-r (lt c g) (lt d g) p
                  (not-true (and (lt c g) (lt d g)) (trans (sym (lt-Gphi c d g hg)) h)))))
    (\ f -> k1 (nlt-le g c tg tc f)) ;
gf-intro-c (c d g : T) (tc : TT c) (tg : TT g) (hg : Tr (isG g)) (h : Tr (le g c)) : LT g (phi c d) =
  trans (lt-Gphi c d g hg) (ap (\ u -> not (and u (lt d g))) (le-nlt g c tg tc h)) ;
gf-intro-d (c d g : T) (td : TT d) (tg : TT g) (hg : Tr (isG g)) (h : Tr (le g d)) : LT g (phi c d) =
  trans (lt-Gphi c d g hg)
    (trans (ap (\ u -> not (and (lt c g) u)) (le-nlt g d tg td h)) (ap not (andF (lt c g)))) ;

------------------------------------------------------------------------
-- Clause (3):  phi'_a b <' phi'_c d iff (A) a <' c and b <' phi'_c d,
-- or (B) a = c and b <' d, or (C) c <' a and phi'_a b <=' d.

ph3A (a b c d : T) : Bool = and (lt a c) (lt b (phi c d)) ;
ph3B (a b c d : T) : Bool = and (eqT a c) (lt b d) ;
ph3C (a b c d : T) : Bool = and (lt c a) (le (phi a b) d) ;

-- the clause at a = c, b = d
cl3-zero (bY : B2) (eac : Bool) (xd : B2) (exd eyb : Bool)
  : Id Bool (fwd (cl3 (false, false) bY eac (false, false) xd exd eyb)) false =
  trans (orF (and eac false)) (andF eac) ;

lt-phiphi (a b c d : T) : Id Bool (lt (phi a b) (phi c d)) (or (or (ph3A a b c d) (ph3B a b c d)) (ph3C a b c d)) =
  trans (guard-drop (eqT (phi a b) (phi c d))
           (cl3 (cmp2 a c) (cmp2 b (phi c d)) (eqT a c) (cmp2 b d) (cmp2 (phi a b) d) (eqT (phi a b) d) (eqT (phi c d) b))
           (\ e -> trans (ap2 (\ u w -> fwd (cl3 u (cmp2 b (phi c d)) (eqT a c) w (cmp2 (phi a b) d) (eqT (phi a b) d) (eqT (phi c d) b)))
                              (eq-irr a c (and-l (eqT a c) (eqT b d) e)) (eq-irr b d (and-r (eqT a c) (eqT b d) e)))
                         (cl3-zero (cmp2 b (phi c d)) (eqT a c) (cmp2 (phi a b) d) (eqT (phi a b) d) (eqT (phi c d) b))))
        (ap (\ u -> or (or (ph3A a b c d) (ph3B a b c d)) (and u (le (phi a b) d))) (sym (lt-swap a c))) ;

phi3-cases (P : U m) (a b c d : T) (h : LT (phi a b) (phi c d))
  (k1 : LT a c -> LT b (phi c d) -> P) (k2 : EQ a c -> LT b d -> P) (k3 : LT c a -> Tr (le (phi a b) d) -> P) : P =
  orE P (or (ph3A a b c d) (ph3B a b c d)) (ph3C a b c d) (trans (sym (lt-phiphi a b c d)) h)
    (\ h12 -> orE P (ph3A a b c d) (ph3B a b c d) h12
       (\ p -> k1 (and-l (lt a c) (lt b (phi c d)) p) (and-r (lt a c) (lt b (phi c d)) p))
       (\ p -> k2 (and-l (eqT a c) (lt b d) p) (and-r (eqT a c) (lt b d) p)))
    (\ p -> k3 (and-l (lt c a) (le (phi a b) d) p) (and-r (lt c a) (le (phi a b) d) p)) ;

phi3-A (a b c d : T) (p : LT a c) (q : LT b (phi c d)) : LT (phi a b) (phi c d) =
  trans (lt-phiphi a b c d)
    (orIl (or (ph3A a b c d) (ph3B a b c d)) (ph3C a b c d)
      (orIl (ph3A a b c d) (ph3B a b c d) (andI (lt a c) (lt b (phi c d)) p q))) ;
phi3-B (a b c d : T) (p : EQ a c) (q : LT b d) : LT (phi a b) (phi c d) =
  trans (lt-phiphi a b c d)
    (orIl (or (ph3A a b c d) (ph3B a b c d)) (ph3C a b c d)
      (orIr (ph3A a b c d) (ph3B a b c d) (andI (eqT a c) (lt b d) p q))) ;
phi3-C (a b c d : T) (p : LT c a) (q : Tr (le (phi a b) d)) : LT (phi a b) (phi c d) =
  trans (lt-phiphi a b c d)
    (orIr (or (ph3A a b c d) (ph3B a b c d)) (ph3C a b c d) (andI (lt c a) (le (phi a b) d) p q)) ;

------------------------------------------------------------------------
-- The cases with a phi.  x = phi'_a b, y = phi'_c d, z = phi'_e f;
-- g, k in G'.  The Tr3 arguments are the induction hypotheses used.

-- (3) then (3).  x <' y by (A), (B) or (C), and y <' z by (A'), (B'), (C').
-- (C) with (A'): x <=' d <' z.  (C) otherwise, and (C'): e <' a and x <' f.
-- (A) with (A') or (B'): a <' e and b <' y <' z.  (A) with (C'): compare a
-- and e.  (B): as (A) with b <' d in place of b <' y.
caseFFF (a b c d e f : T) (ta : TT a) (tc : TT c) (te : TT e)
  (iace : Tr3 a c e) (iaec : Tr3 a e c) (ibyz : Tr3 b (phi c d) (phi e f)) (ibyf : Tr3 b (phi c d) f)
  (ibdz : Tr3 b d (phi e f)) (ibdf : Tr3 b d f) (ixyf : Tr3 (phi a b) (phi c d) f)
  (ixdz : Tr3 (phi a b) d (phi e f)) (ixdf : Tr3 (phi a b) d f)
  (h1 : LT (phi a b) (phi c d)) (h2 : LT (phi c d) (phi e f)) : LT (phi a b) (phi e f) =
  phi3-cases (LT (phi a b) (phi e f)) a b c d h1
    (\ ac byy -> phi3-cases (LT (phi a b) (phi e f)) c d e f h2
       (\ ce dz -> phi3-A a b e f (iace ac ce) (ibyz byy h2))
       (\ ce df -> phi3-A a b e f (eq-lt-r a c e ac ce) (ibyz byy h2))
       (\ ec yf -> tri a e ta te (LT (phi a b) (phi e f))
          (\ ae -> phi3-A a b e f ae (ibyz byy h2))
          (\ ae -> phi3-B a b e f ae (lt-le b (phi c d) f ibyf byy yf))
          (\ ea -> phi3-C a b e f ea (le-of-lt (phi a b) f (lt-le (phi a b) (phi c d) f ixyf h1 yf)))))
    (\ ac bd -> phi3-cases (LT (phi a b) (phi e f)) c d e f h2
       (\ ce dz -> phi3-A a b e f (eq-lt-l a c e ac ce) (ibdz bd dz))
       (\ ce df -> phi3-B a b e f (eq-trans a c e ac ce) (ibdf bd df))
       (\ ec yf -> phi3-C a b e f (eq-lt-r e c a ec (eq-sym a c ac))
                     (le-of-lt (phi a b) f (lt-le (phi a b) (phi c d) f ixyf h1 yf))))
    (\ ca xd -> phi3-cases (LT (phi a b) (phi e f)) c d e f h2
       (\ ce dz -> le-lt (phi a b) d (phi e f) ixdz xd dz)
       (\ ce df -> phi3-C a b e f (eq-lt-l e c a (eq-sym c e ce) ca)
                     (le-of-lt (phi a b) f (le-lt (phi a b) d f ixdf xd df)))
       (\ ec yf -> phi3-C a b e f (lt-rot e c a te tc ta iaec ec ca)
                     (le-of-lt (phi a b) f (lt-le (phi a b) (phi c d) f ixyf h1 yf)))) ;

-- (3) then (4): c, d <' g; (A) a <' c, b <' y; (B) a = c, b <' d;
-- (C) x <=' d <' g.
caseFFG (a b c d g : T) (hg : Tr (isG g))
  (iacg : Tr3 a c g) (ibyg : Tr3 b (phi c d) g) (ibdg : Tr3 b d g) (ixdg : Tr3 (phi a b) d g)
  (h1 : LT (phi a b) (phi c d)) (h2 : LT (phi c d) g) : LT (phi a b) g =
  phi3-cases (LT (phi a b) g) a b c d h1
    (\ ac byy -> fg-intro a b g hg (iacg ac (fg-elim c d g hg h2).1) (ibyg byy h2))
    (\ ac bd -> fg-intro a b g hg (eq-lt-l a c g ac (fg-elim c d g hg h2).1) (ibdg bd (fg-elim c d g hg h2).2))
    (\ ca xd -> le-lt (phi a b) d g ixdg xd (fg-elim c d g hg h2).2) ;

-- (4) then (4): a, b <' g, and g <=' c or g <=' d.  If g <=' c then
-- (A).  If g <=' d compare a and c: (A), (B) with b <' g <=' d, or (C)
-- with x <' g <=' d.
caseFGF (a b g c d : T) (ta : TT a) (tg : TT g) (tc : TT c) (td : TT d) (hg : Tr (isG g))
  (iagc : Tr3 a g c) (ibgz : Tr3 b g (phi c d)) (ibgd : Tr3 b g d) (ixgd : Tr3 (phi a b) g d)
  (h1 : LT (phi a b) g) (h2 : LT g (phi c d)) : LT (phi a b) (phi c d) =
  gf-elim (LT (phi a b) (phi c d)) c d g tc td tg hg h2
    (\ gc -> phi3-A a b c d (lt-le a g c iagc (fg-elim a b g hg h1).1 gc) (ibgz (fg-elim a b g hg h1).2 h2))
    (\ gd -> tri a c ta tc (LT (phi a b) (phi c d))
       (\ ac -> phi3-A a b c d ac (ibgz (fg-elim a b g hg h1).2 h2))
       (\ ac -> phi3-B a b c d ac (lt-le b g d ibgd (fg-elim a b g hg h1).2 gd))
       (\ ca -> phi3-C a b c d ca (le-of-lt (phi a b) d (lt-le (phi a b) g d ixgd h1 gd)))) ;

-- (4) then (3): g <=' c or g <=' d.  (A') g <=' c <' e, or g <=' d <' z;
-- (B') g <=' c = e, or g <=' d <' f;  (C') g <' y <=' f.
caseGFF (g c d e f : T) (tg : TT g) (tc : TT c) (td : TT d) (te : TT e) (tf : TT f) (hg : Tr (isG g))
  (igce : Tr3 g c e) (igdz : Tr3 g d (phi e f)) (igdf : Tr3 g d f) (igyf : Tr3 g (phi c d) f)
  (h1 : LT g (phi c d)) (h2 : LT (phi c d) (phi e f)) : LT g (phi e f) =
  phi3-cases (LT g (phi e f)) c d e f h2
    (\ ce dz -> gf-elim (LT g (phi e f)) c d g tc td tg hg h1
       (\ gc -> gf-intro-c e f g te tg hg (le-of-lt g e (le-lt g c e igce gc ce)))
       (\ gd -> le-lt g d (phi e f) igdz gd dz))
    (\ ce df -> gf-elim (LT g (phi e f)) c d g tc td tg hg h1
       (\ gc -> gf-intro-c e f g te tg hg (le-eq-r g c e gc ce))
       (\ gd -> gf-intro-d e f g tf tg hg (le-of-lt g f (le-lt g d f igdf gd df))))
    (\ ec yf -> gf-intro-d e f g tf tg hg (le-of-lt g f (lt-le g (phi c d) f igyf h1 yf))) ;

-- (4) then a comparison in G': a, b <' g <' k
caseFGG (a b g k : T) (hg : Tr (isG g)) (hk : Tr (isG k)) (iagk : Tr3 a g k) (ibgk : Tr3 b g k)
  (h1 : LT (phi a b) g) (h2 : LT g k) : LT (phi a b) k =
  fg-intro a b k hk (iagk (fg-elim a b g hg h1).1 h2) (ibgk (fg-elim a b g hg h1).2 h2) ;

-- (4) then (4): g <=' c <' k or g <=' d <' k
caseGFG (g c d k : T) (tg : TT g) (tc : TT c) (td : TT d) (hg : Tr (isG g)) (hk : Tr (isG k))
  (igck : Tr3 g c k) (igdk : Tr3 g d k) (h1 : LT g (phi c d)) (h2 : LT (phi c d) k) : LT g k =
  gf-elim (LT g k) c d g tc td tg hg h1
    (\ gc -> le-lt g c k igck gc (fg-elim c d k hk h2).1)
    (\ gd -> le-lt g d k igdk gd (fg-elim c d k hk h2).2) ;

-- a comparison in G' then (4): g <' k <=' e or g <' k <=' f
caseGGF (g k e f : T) (tg : TT g) (tk : TT k) (te : TT e) (tf : TT f) (hg : Tr (isG g)) (hk : Tr (isG k))
  (igke : Tr3 g k e) (igkf : Tr3 g k f) (h1 : LT g k) (h2 : LT k (phi e f)) : LT g (phi e f) =
  gf-elim (LT g (phi e f)) e f k te tf tk hk h2
    (\ ke -> gf-intro-c e f g te tg hg (le-of-lt g e (lt-le g k e igke h1 ke)))
    (\ kf -> gf-intro-d e f g tf tg hg (le-of-lt g f (lt-le g k f igkf h1 kf))) ;

------------------------------------------------------------------------
-- The lexicographic step

-- u <' v is the lexicographic order of the keys hu, hv and the tag t
Lex (u v hu hv : T) (t : Bool) : U m = Id Bool (lt u v) (or (lt hu hv) (and (eqT hu hv) t)) ;
LexOf (hu hv : T) (t : Bool) : U m = Tr (or (lt hu hv) (and (eqT hu hv) t)) ;

lex-trans (hx hy hz : T) (txy tyz txz : Bool) (kH : Tr3 hx hy hz)
  (kT : EQ hx hy -> EQ hy hz -> Tr txy -> Tr tyz -> Tr txz)
  (h1 : LexOf hx hy txy) (h2 : LexOf hy hz tyz) : LexOf hx hz txz =
  orE (LexOf hx hz txz) (lt hx hy) (and (eqT hx hy) txy) h1
    (\ p -> orE (LexOf hx hz txz) (lt hy hz) (and (eqT hy hz) tyz) h2
       (\ q -> orIl (lt hx hz) (and (eqT hx hz) txz) (kH p q))
       (\ q -> orIl (lt hx hz) (and (eqT hx hz) txz) (eq-lt-r hx hy hz p (and-l (eqT hy hz) tyz q))))
    (\ p -> orE (LexOf hx hz txz) (lt hy hz) (and (eqT hy hz) tyz) h2
       (\ q -> orIl (lt hx hz) (and (eqT hx hz) txz) (eq-lt-l hx hy hz (and-l (eqT hx hy) txy p) q))
       (\ q -> orIr (lt hx hz) (and (eqT hx hz) txz)
                 (andI (eqT hx hz) txz
                    (eq-trans hx hy hz (and-l (eqT hx hy) txy p) (and-l (eqT hy hz) tyz q))
                    (kT (and-l (eqT hx hy) txy p) (and-l (eqT hy hz) tyz q)
                        (and-r (eqT hx hy) txy p) (and-r (eqT hy hz) tyz q))))) ;

by-lex (x y z hx hy hz : T) (txy tyz txz : Bool)
  (vxy : Lex x y hx hy txy) (vyz : Lex y z hy hz tyz) (vxz : Lex x z hx hz txz)
  (kH : Tr3 hx hy hz) (kT : EQ hx hy -> EQ hy hz -> Tr txy -> Tr tyz -> Tr txz)
  (h1 : LT x y) (h2 : LT y z) : LT x z =
  trans vxz (lex-trans hx hy hz txy tyz txz kH kT (trans (sym vxy) h1) (trans (sym vyz) h2)) ;

-- any comparison, with the terms as keys
lex-self (u v : T) : Lex u v u v false = sym (orAF (lt u v) (eqT u v)) ;

------------------------------------------------------------------------
-- Views of sums (clause (2))

lex-PP (x0 xs y0 ys : T) : Lex (plus x0 xs) (plus y0 ys) x0 y0 (lt xs ys) =
  guard-drop (eqT (plus x0 xs) (plus y0 ys)) (cl2 (cmp2 x0 y0) (eqT x0 y0) (cmp2 xs ys))
    (\ e -> trans (ap2 (\ u w -> fwd (cl2 u (eqT x0 y0) w))
                       (eq-irr x0 y0 (and-l (eqT x0 y0) (eqT xs ys) e))
                       (eq-irr xs ys (and-r (eqT x0 y0) (eqT xs ys) e)))
                  (andF (eqT x0 y0))) ;

lex-PA (x0 xs : T) : (y : T) -> Tr (isA y) -> Lex (plus x0 xs) y x0 y false = split {
  zero -> \ h -> abF h ; plus y0 ys -> \ h -> abF h ;
  phi y0 y1 -> \ h -> lex-self x0 (phi y0 y1) ;
  psi y0 y1 -> \ h -> lex-self x0 (psi y0 y1) ;
  om y0 -> \ h -> lex-self x0 (om y0) ;
  ii -> \ h -> lex-self x0 ii } ;

lex-AP : (x : T) -> Tr (isA x) -> (y0 ys : T) -> Lex x (plus y0 ys) x y0 true = split {
  zero -> \ h y0 ys -> abF h ; plus x0 xs -> \ h y0 ys -> abF h ;
  phi x0 x1 -> \ h y0 ys -> sym (orAT (lt (phi x0 x1) y0) (eqT (phi x0 x1) y0)) ;
  psi x0 x1 -> \ h y0 ys -> sym (orAT (lt (psi x0 x1) y0) (eqT (psi x0 x1) y0)) ;
  om x0 -> \ h y0 ys -> sym (orAT (lt (om x0) y0) (eqT (om x0) y0)) ;
  ii -> \ h y0 ys -> sym (orAT (lt ii y0) (eqT ii y0)) } ;

------------------------------------------------------------------------
-- Clause (5) at the four combinations of "the index is I"

-- pi, ka /= I:  pi <' ka, or pi = ka and b <' d
v5SS : (ip iq e g p1 p2 b1 b2 : Bool) -> (xq pY : B2) -> Id Bool ip false -> Id Bool iq false
       -> (Tr e -> Id Bool p1 false) -> (Tr g -> Id Bool b1 false)
       -> Id Bool (fwd (guard (and e g) (cl5 ip iq e (b1, b2) (p1, p2) xq pY))) (or p1 (and e b1)) = split {
  true -> \ iq e g p1 p2 b1 b2 xq pY hp hq he hg -> abT hp ;
  false -> split {
    true -> \ e g p1 p2 b1 b2 xq pY hp hq he hg -> abT hq ;
    false -> split {
      false -> \ g p1 p2 b1 b2 xq pY hp hq he hg -> refl (or p1 false) ;
      true -> split {
        false -> split {
          false -> \ p2 -> split {
            false -> \ b2 xq pY hp hq he hg -> refl false ;
            true -> \ b2 xq pY hp hq he hg -> refl true } ;
          true -> \ p2 -> split {
            false -> \ b2 xq pY hp hq he hg -> refl true ;
            true -> \ b2 xq pY hp hq he hg -> refl true } } ;
        true -> split {
          true -> \ p2 b1 b2 xq pY hp hq he hg -> abT (he (refl true)) ;
          false -> \ p2 -> split {
            true -> \ b2 xq pY hp hq he hg -> abT (hg (refl true)) ;
            false -> \ b2 xq pY hp hq he hg -> refl false } } } } } } ;

-- pi /= I = ka:  pi <' psi_I d
v5ST : (ip iq e g : Bool) -> (bd pq xq : B2) -> (y1 y2 : Bool) -> Id Bool ip false -> Id Bool iq true
       -> Id Bool e false -> Id Bool (fwd (guard (and e g) (cl5 ip iq e bd pq xq (y1, y2)))) y1 = split {
  true -> \ iq e g bd pq xq y1 y2 hp hq he -> abT hp ;
  false -> split {
    false -> \ e g bd pq xq y1 y2 hp hq he -> abF hq ;
    true -> split {
      true -> \ g bd pq xq y1 y2 hp hq he -> abT he ;
      false -> \ g bd pq xq y1 y2 hp hq he -> refl y1 } } } ;

-- pi = I /= ka:  psi_I b <' ka
v5TS : (ip iq e g : Bool) -> (bd pq : B2) -> (q1 q2 : Bool) -> (pY : B2) -> Id Bool ip true -> Id Bool iq false
       -> Id Bool e false -> Id Bool (fwd (guard (and e g) (cl5 ip iq e bd pq (q1, q2) pY))) (or q1 false) = split {
  false -> \ iq e g bd pq q1 q2 pY hp hq he -> abF hp ;
  true -> split {
    true -> \ e g bd pq q1 q2 pY hp hq he -> abT hq ;
    false -> split {
      true -> \ g bd pq q1 q2 pY hp hq he -> abT he ;
      false -> \ g bd pq q1 q2 pY hp hq he -> refl (or q1 false) } } } ;

-- pi = ka = I:  b <' d
v5II : (ip iq e g b1 b2 : Bool) -> (pq xq pY : B2) -> Id Bool ip true -> Id Bool iq true -> Id Bool e true
       -> (Tr g -> Id Bool b1 false) -> Id Bool (fwd (guard (and e g) (cl5 ip iq e (b1, b2) pq xq pY))) b1 = split {
  false -> \ iq e g b1 b2 pq xq pY hp hq he hg -> abF hp ;
  true -> split {
    false -> \ e g b1 b2 pq xq pY hp hq he hg -> abF hq ;
    true -> split {
      false -> \ g b1 b2 pq xq pY hp hq he hg -> abF he ;
      true -> split {
        false -> split {
          false -> \ b2 pq xq pY hp hq he hg -> refl false ;
          true -> \ b2 pq xq pY hp hq he hg -> refl true } ;
        true -> split {
          false -> \ b2 pq xq pY hp hq he hg -> refl false ;
          true -> \ b2 pq xq pY hp hq he hg -> abT (hg (refl true)) } } } } } ;

-- an index /= I is not I
ne-II (p q : T) (hp : Id Bool (isI p) false) (hq : Id Bool (isI q) true) : Id Bool (eqT p q) false =
  trans (ap (\ s -> eqT p s) (isI-true q hq)) (trans (eqT-sym p ii) (isI-ne p hp)) ;

------------------------------------------------------------------------
-- Views of G' (key psi_pi b = pi for pi /= I, tag b <' d or "below pi")
-- and of Car' (key Omega_a = a, tag "kappa below Omega_kappa").
-- S: psi_pi b with pi /= I;  T: psi_pi b with pi = I;  O: Omega;  I.

lex-SS (p b q d : T) (hp : Id Bool (isI p) false) (hq : Id Bool (isI q) false)
  : Lex (psi p b) (psi q d) p q (lt b d) =
  v5SS (isI p) (isI q) (eqT p q) (eqT b d) (fwd (cmp2 p q)) (bwd (cmp2 p q)) (fwd (cmp2 b d)) (bwd (cmp2 b d))
       (cmp2 (psi p b) q) (cmp2 p (psi q d)) hp hq (\ e -> ap fwd (eq-irr p q e)) (\ e -> ap fwd (eq-irr b d e)) ;

lex-ST (p b q d : T) (tx : TT (psi p b)) (hp : Id Bool (isI p) false) (hq : Id Bool (isI q) true)
  : Lex (psi p b) (psi q d) p (psi q d) true =
  trans (v5ST (isI p) (isI q) (eqT p q) (eqT b d) (cmp2 b d) (cmp2 p q) (cmp2 (psi p b) q)
              (fwd (cmp2 p (psi q d))) (bwd (cmp2 p (psi q d))) hp hq (ne-II p q hp hq))
        (sym (trans (orAT (lt p (psi q d)) (eqT p (psi q d)))
               (trans (ap (\ w -> or (lt p (psi q d)) w) (R-notpsi p (isT-psiR p b tx) q d)) (orF (lt p (psi q d)))))) ;

lex-TS (p b q d : T) (hp : Id Bool (isI p) true) (hq : Id Bool (isI q) false)
  : Lex (psi p b) (psi q d) (psi p b) q false =
  trans (v5TS (isI p) (isI q) (eqT p q) (eqT b d) (cmp2 b d) (cmp2 p q)
              (fwd (cmp2 (psi p b) q)) (bwd (cmp2 (psi p b) q)) (cmp2 p (psi q d)) hp hq
              (trans (eqT-sym p q) (ne-II q p hq hp)))
        (trans (orF (lt (psi p b) q)) (sym (orAF (lt (psi p b) q) (eqT (psi p b) q)))) ;

lex-SO (p b c : T) (hp : Id Bool (isI p) false) : Lex (psi p b) (om c) p (om c) true =
  trans (iteF (isI p) (le (psi p b) c) (le p (om c)) hp) (sym (orAT (lt p (om c)) (eqT p (om c)))) ;

lex-SI (p b : T) (hp : Id Bool (isI p) false) : Lex (psi p b) ii p ii true =
  trans (iteF (isI p) true (le p ii) hp) (sym (orAT (lt p ii) (eqT p ii))) ;

lex-OS (a q d : T) (ta : TT (om a)) (tq : TT q) (hq : Id Bool (isI q) false) : Lex (om a) (psi q d) (om a) q false =
  trans (ap not (iteF (isI q) (or (bwd (cmp2 a (psi q d))) (eqT (psi q d) a)) (or (bwd (cmp2 (om a) q)) (eqT q (om a))) hq))
        (trans (nle-lt (om a) q ta tq) (sym (orAF (lt (om a) q) (eqT (om a) q)))) ;

lex-IS (q d : T) (tq : TT q) (hq : Id Bool (isI q) false) : Lex ii (psi q d) ii q false =
  trans (ap not (iteF (isI q) true (or (bwd (cmp2 ii q)) (eqT q ii)) hq))
        (trans (nle-lt ii q (refl true) tq) (sym (orAF (lt ii q) (eqT ii q)))) ;

lex-OO (a c : T) : Lex (om a) (om c) a c false =
  trans (guard-drop (eqT a c) (cl9 (cmp2 a c)) (\ e -> ap fwd (eq-irr a c e))) (lex-self a c) ;

lex-OI (a : T) : Lex (om a) ii a ii false = lex-self a ii ;

lex-OT (a q d : T) (ta : TT a) (ty : TT (psi q d)) (hq : Id Bool (isI q) true) : Lex (om a) (psi q d) a (psi q d) false =
  trans (ap not (iteT (isI q) (or (bwd (cmp2 a (psi q d))) (eqT (psi q d) a)) (or (bwd (cmp2 (om a) q)) (eqT q (om a))) hq))
        (trans (nle-lt a (psi q d) ta ty) (lex-self a (psi q d))) ;

lex-IO (c : T) (tc : TT c) : Lex ii (om c) ii c true =
  trans (nbwd-le ii c (refl true) tc) (sym (orAT (lt ii c) (eqT ii c))) ;

lex-TO (p b c : T) (hp : Id Bool (isI p) true) : Lex (psi p b) (om c) (psi p b) c true =
  trans (iteT (isI p) (le (psi p b) c) (le p (om c)) hp) (sym (orAT (lt (psi p b) c) (eqT (psi p b) c))) ;

-- Fi':  psi_I b <' psi_I d iff b <' d;  psi_I b <' I;  not I <' psi_I d
lt-TT (p b q d : T) (hp : Id Bool (isI p) true) (hq : Id Bool (isI q) true) : Id Bool (lt (psi p b) (psi q d)) (lt b d) =
  v5II (isI p) (isI q) (eqT p q) (eqT b d) (fwd (cmp2 b d)) (bwd (cmp2 b d)) (cmp2 p q) (cmp2 (psi p b) q) (cmp2 p (psi q d))
       hp hq (ap2 eqT (isI-true p hp) (isI-true q hq)) (\ e -> ap fwd (eq-irr b d e)) ;
lt-TI (p b : T) (hp : Id Bool (isI p) true) : LT (psi p b) ii = iteT (isI p) true (le p ii) hp ;
lt-IT (q d : T) (hq : Id Bool (isI q) true) : Id Bool (lt ii (psi q d)) false =
  ap not (iteT (isI q) true (or (bwd (cmp2 ii q)) (eqT q ii)) hq) ;

-- psi_I b <' psi_I d <' psi_I f
caseTTT (p b q d r f : T) (hp : Id Bool (isI p) true) (hq : Id Bool (isI q) true) (hr : Id Bool (isI r) true)
  (ibdf : Tr3 b d f) (h1 : LT (psi p b) (psi q d)) (h2 : LT (psi q d) (psi r f)) : LT (psi p b) (psi r f) =
  trans (lt-TT p b r f hp hr) (ibdf (trans (sym (lt-TT p b q d hp hq)) h1) (trans (sym (lt-TT q d r f hq hr)) h2)) ;

------------------------------------------------------------------------
-- Transitivity (generated by tools/gentrans.py)

lt-trans : (x y z : T) -> TT x -> TT y -> TT z -> LT x y -> LT y z -> LT x z = split {
  zero -> split {
    zero -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        abF h1 ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        abF h1 ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        abF h1 ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        abF h1 ;
      ii -> \ tx ty tz h1 h2 ->
        abF h1
    } ;
    plus y0 ys | s0 ss -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        refl true ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        refl true ;
      ii -> \ tx ty tz h1 h2 ->
        refl true
    } ;
    phi y0 y1 | s0 s1 -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        refl true ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        refl true ;
      ii -> \ tx ty tz h1 h2 ->
        refl true
    } ;
    psi y0 y1 | s0 s1 -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        refl true ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        refl true ;
      ii -> \ tx ty tz h1 h2 ->
        refl true
    } ;
    om y0 | s0 -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        refl true ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        refl true ;
      ii -> \ tx ty tz h1 h2 ->
        refl true
    } ;
    ii -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        refl true ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        refl true ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        refl true ;
      ii -> \ tx ty tz h1 h2 ->
        refl true
    }
  } ;
  plus x0 xs | r0 rs -> split {
    zero -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        abF h1 ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        abF h1 ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        abF h1 ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        abF h1 ;
      ii -> \ tx ty tz h1 h2 ->
        abF h1
    } ;
    plus y0 ys | s0 ss -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
        by-lex (plus x0 xs) (plus y0 ys) (plus z0 zs) x0 y0 z0 (lt xs ys) (lt ys zs) (lt xs zs) (lex-PP x0 xs y0 ys) (lex-PP y0 ys z0 zs) (lex-PP x0 xs z0 zs) (r0 y0 z0 (isT-plus0 x0 xs tx) (isT-plus0 y0 ys ty) (isT-plus0 z0 zs tz)) (\ e1 e2 p q -> (rs ys zs (isT-plusS x0 xs tx) (isT-plusS y0 ys ty) (isT-plusS z0 zs tz)) p q) h1 h2 ;
      phi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        by-lex (plus x0 xs) (plus y0 ys) (phi z0 z1) x0 y0 (phi z0 z1) (lt xs ys) false false (lex-PP x0 xs y0 ys) (lex-PA y0 ys (phi z0 z1) (refl true)) (lex-PA x0 xs (phi z0 z1) (refl true)) (r0 y0 (phi z0 z1) (isT-plus0 x0 xs tx) (isT-plus0 y0 ys ty) tz) (\ e1 e2 p q -> abF q) h1 h2 ;
      psi z0 z1 | t0 t1 -> \ tx ty tz h1 h2 ->
        by-lex (plus x0 xs) (plus y0 ys) (psi z0 z1) x0 y0 (psi z0 z1) (lt xs ys) false false (lex-PP x0 xs y0 ys) (lex-PA y0 ys (psi z0 z1) (refl true)) (lex-PA x0 xs (psi z0 z1) (refl true)) (r0 y0 (psi z0 z1) (isT-plus0 x0 xs tx) (isT-plus0 y0 ys ty) tz) (\ e1 e2 p q -> abF q) h1 h2 ;
      om z0 | t0 -> \ tx ty tz h1 h2 ->
        by-lex (plus x0 xs) (plus y0 ys) (om z0) x0 y0 (om z0) (lt xs ys) false false (lex-PP x0 xs y0 ys) (lex-PA y0 ys (om z0) (refl true)) (lex-PA x0 xs (om z0) (refl true)) (r0 y0 (om z0) (isT-plus0 x0 xs tx) (isT-plus0 y0 ys ty) tz) (\ e1 e2 p q -> abF q) h1 h2 ;
      ii -> \ tx ty tz h1 h2 ->
        by-lex (plus x0 xs) (plus y0 ys) ii x0 y0 ii (lt xs ys) false false (lex-PP x0 xs y0 ys) (lex-PA y0 ys ii (refl true)) (lex-PA x0 xs ii (refl true)) (r0 y0 ii (isT-plus0 x0 xs tx) (isT-plus0 y0 ys ty) tz) (\ e1 e2 p q -> abF q) h1 h2
    } ;
    phi y0 y1 | s0 s1 -> split {
      zero -> \ tx ty tz h1 h2 ->
        abF h2 ;
      plus z0 zs | t0 ts -> \ tx ty tz h1 h2 ->
