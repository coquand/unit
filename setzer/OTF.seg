-- OTF.seg: the functions on OT of Setzer (APAL 92, 1998), Section 2.2,
-- Definitions 2.10, 2.11 and 2.13, Remark 2.12 (all of it) and Remark 2.14
-- except (c), (d), (h) (Section 4 does not use those).  The mirror is
-- tools/otfun.py; the block of values in OTFTest.seg is computed by it, and
-- every statement was tested on it first (tools/checks.py rem212, rem214).
--
-- Statements (x, y, ... in OT unless said otherwise):
--   2.12(a) x+y, x.n, phi_x y, Omega_x, Omega^n_x in OT          rem212a
--   2.12(b) x is 0, I, =NF' y+z, =NF phi_y z, Omega_y, psi_y z   rem212b
--   2.12(c) lengths of the parts are smaller (x, y, z in T')     rem212c
--   2.12(d) the parts are in OT                                  rem212d
--   2.12(e) y <' y' => x+y <' x+y'                               rem212e
--   2.12(f) phi_x y <' phi_x' y' iff ..., with the last disjunct
--           corrected to phi_x y <' y' (false as printed)         rem212f
--   2.12(g) Omega_x <' Omega_y iff x <' y (x, y in T')           rem212g
--   2.12(h) x, y <=' x+y, phi_x y;  x <=' Omega_x                rem212h
--   2.14(a) x~, x+, x^-Fi, x^+Fi, x^-I in OT                     rem214a
--   2.14(b) x <=' y => the same five are <='                     rem214b
--   2.14(e) (x~)+ = x+                                           rem214e
--   2.14(f) x~ = Omega_y, x+ = Omega_{y+1}, x~ <=' x <' x+       rem214f
--   2.14(g) the three regions for x^-Fi, x^+Fi                   rem214g1/2/3
--   2.14(i) x <' Omega^n_{x^-Fi + 1} for some n                  rem214i
--   2.14(j) c <' d => C~_b(c) in C~_b(d) (c, d in T')            rem214j
--   2.14(k) a in C~_b(c) => a+1 in C~_b(c);  psi_a b in OT =>
--           psi_a (b+1) in OT                                    rem214k1/2
-- x^+I appears in 2.14(a), (b) but is not defined in the paper; left out.
-- The informal proof of each is in the comment of its section.
--
-- Definitions (page images, pp. 123-125), and how they are written here.
--
-- 2.10(a)  a = (a1..an), b = (b1..bm).  b = 0: a+b = a.  If ai <' b1 for all
--   i: a+b = b.  Otherwise, with j the largest index with b1 <=' aj,
--   a+b = (a1,..,aj,b1,..,bm).  Written as a recursion on a:
--     0 + b = b;   a + 0 = a;
--     (a0, as) + b = (a0, as + b) if b1 <=' a0, and b otherwise;
--     g + b = (g, b) if b1 <=' g, and b otherwise   (g an atom).
--   For a in OT the summands decrease, so the indices i with b1 <=' ai form
--   an initial segment and the two definitions agree (choice 4 below).
-- 2.10(b)  a.0 = 0,  a.(n+1) = (a.n) + a.
-- 2.10(c)  phi_a b = b if b in Cr(a);  = a if b = 0 and a in G';  phi'_a b
--   otherwise.
-- 2.10(d)  Omega_0 = 0;  Omega_a = a if a in Fi;  Omega'_a otherwise
--   (OT.omF).   (e)  Omega^0_a = a,  Omega^{n+1}_a = Omega_{Omega^n_a}.
-- 2.13(a)  (Omega'_{s+1})^- = Omega_s,  I^- = 0   (OT.kminus).
-- 2.13(b)  a~ (largest cardinal <=' a), a+ (least cardinal >' a), a^-Fi,
--   a^+Fi, by recursion on a:
--     0:            0,           Omega_1,       0,       psi_I 0
--     (a0,..,an):   those of a0
--     phi'_b c:     those of max{b, c}
--     psi_b c, b /= I:  b^-,     b,             b^-Fi,   b^+Fi
--     psi_I c:      a,           Omega_{a+1},   a,       psi_I (c+1)
--     Omega'_b:     a,           Omega_{b+1},   b^-Fi,   b^+Fi
--     I:            I,           Omega_{I+1},   I,       I
--   On terms outside OT the values are "arbitrary"; we compute the same
--   clauses on every raw term.  The recursion for phi'_b c is on b or on c,
--   whichever is max{b, c}: both are proper subterms.
-- 2.13(c)  a^-I = 0 if a <' I, I otherwise.  (2.14(a), (b) also mention
--   x^+I, which is not defined in the paper; it is left out.)
--
-- Choice 4 (added to those of OT.seg).  + is the recursion above, which is
-- Setzer's definition on OT (the only place Remarks 2.12, 2.14 use it).
-- On T' outside OT they may differ: for a = (1, omega), b = omega Setzer's
-- j is 2 and gives (1, omega, omega), the recursion gives omega.

level j ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
open OT ;
open OTLaws[j] ;
open OTTrans[j] ;
open OTC[j] ;

-- N, one, +, s+1, *, phi, Omega^n, the card values, a^-I: OT.seg

C4 : U j = T * (T * (T * T)) ;

------------------------------------------------------------------------
-- Tools

-- a property of ite T u x y, by cases on u
iteC (P : T -> U j) : (u : Bool) -> (x y : T) -> (Tr u -> P x) -> (Id Bool u false -> P y) -> P (ifT u x y) = split {
  false -> \ x y f g -> g (refl false) ; true -> \ x y f g -> f (refl true) } ;

isZero-true : (x : T) -> Tr (isZero x) -> Id T x zero = split {
  zero -> \ h -> refl zero ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> abF h ;
  psi x0 x1 -> \ h -> abF h ; om x0 -> \ h -> abF h ; ii -> \ h -> abF h } ;

G-nz : (x : T) -> Tr (isG x) -> Id Bool (isZero x) false = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> abF h ;
  psi x0 x1 -> \ h -> refl false ; om x0 -> \ h -> refl false ; ii -> \ h -> refl false } ;

-- (OT2), (OT3), (OT5) as introduction rules
ot-plusI (x0 xs : T) (hA : Tr (isA x0)) (o0 : OK x0) (hz : Id Bool (isZero xs) false) (os : OK xs)
  (hl : Tr (le (hd xs) x0)) : OK (plus x0 xs) =
  andI (and (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs))) (le (hd xs) x0)
    (andI (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs))
       (andI (isA x0) (isOT x0) hA o0) (andI (not (isZero xs)) (isOT xs) (ap not hz) os))
    hl ;

ot-phiI (x y : T) (ox : OK x) (oy : OK y) (hc : Id Bool (crit x y) false)
  (hz : Id Bool (and (isZero y) (isG x)) false) : OK (phi x y) =
  andI (and (isOT x) (isOT y)) (and (not (crit x y)) (not (and (isZero y) (isG x))))
    (andI (isOT x) (isOT y) ox oy) (andI (not (crit x y)) (not (and (isZero y) (isG x))) (ap not hc) (ap not hz)) ;

ot-omI (x : T) (o : OK x) (hf : Id Bool (isFi x) false) (hz : Id Bool (isZero x) false) : OK (om x) =
  andI (and (isOT x) (not (isFi x))) (not (isZero x)) (andI (isOT x) (not (isFi x)) o (ap not hf)) (ap not hz) ;

------------------------------------------------------------------------
-- Remark 2.12(a): x + y, x.n, phi_x y, Omega_x, Omega^n_x are in OT.
--
-- Omega_x: x itself (0, psi_I b, I), or Omega'_x with x not in Fi u {0}
-- (OT5).  Omega^n_x: by induction on n.  phi_x y: y if y in Cr(x); x if
-- y = 0 and x in G'; otherwise phi'_x y, and the two conditions of (OT3)
-- are the negations of the first two cases.  x + y, by induction on x:
-- for y /= 0, x + y is y, or (g, y) with hd(y) <=' g (x = g an atom), or
-- (x0, xs + y) with hd(y) <=' x0, where xs + y /= 0 is in OT by the
-- hypothesis and hd(xs + y) is hd(xs) or hd(y), both <=' x0 (add-hd).
-- x.n: by induction on n.

omF-OK : (x : T) -> OK x -> OK (omF x) = split {
  zero -> \ o -> o ;
  plus x0 xs -> \ o -> ot-omI (plus x0 xs) o (refl false) (refl false) ;
  phi x0 x1 -> \ o -> ot-omI (phi x0 x1) o (refl false) (refl false) ;
  psi p c -> \ o -> iteC OK (isI p) (psi p c) (om (psi p c)) (\ h -> o) (\ h -> ot-omI (psi p c) o h (refl false)) ;
  om a -> \ o -> ot-omI (om a) o (refl false) (refl false) ;
  ii -> \ o -> o } ;

omN-OK : (m : N) -> (x : T) -> OK x -> OK (omN m x) = split {
  nz -> \ x o -> o ; ns m | r -> \ x o -> omF-OK (omN m x) (r x o) } ;

phiF-OK (x y : T) (ox : OK x) (oy : OK y) : OK (phiF x y) =
  iteC OK (crit x y) y (ifT (and (isZero y) (isG x)) x (phi x y)) (\ h -> oy)
    (\ hc -> iteC OK (and (isZero y) (isG x)) x (phi x y) (\ h -> ox) (\ hz -> ot-phiI x y ox oy hc hz)) ;

add-nz : (a b : T) -> Id Bool (isZero b) false -> Id Bool (isZero (add a b)) false = split {
  zero -> \ b hz -> hz ;
  plus x0 xs -> \ b hz -> iteC (\ t -> Id Bool (isZero t) false) (isZero b) (plus x0 xs)
    (ifT (le (hd b) x0) (plus x0 (add xs b)) b) (\ h -> refl false)
    (\ h -> iteC (\ t -> Id Bool (isZero t) false) (le (hd b) x0) (plus x0 (add xs b)) b (\ h' -> refl false) (\ h' -> hz)) ;
  phi x0 x1 -> \ b hz -> iteC (\ t -> Id Bool (isZero t) false) (isZero b) (phi x0 x1) (consA (phi x0 x1) b) (\ h -> refl false)
    (\ h -> iteC (\ t -> Id Bool (isZero t) false) (le (hd b) (phi x0 x1)) (plus (phi x0 x1) b) b (\ h' -> refl false) (\ h' -> hz)) ;
  psi x0 x1 -> \ b hz -> iteC (\ t -> Id Bool (isZero t) false) (isZero b) (psi x0 x1) (consA (psi x0 x1) b) (\ h -> refl false)
    (\ h -> iteC (\ t -> Id Bool (isZero t) false) (le (hd b) (psi x0 x1)) (plus (psi x0 x1) b) b (\ h' -> refl false) (\ h' -> hz)) ;
  om x0 -> \ b hz -> iteC (\ t -> Id Bool (isZero t) false) (isZero b) (om x0) (consA (om x0) b) (\ h -> refl false)
    (\ h -> iteC (\ t -> Id Bool (isZero t) false) (le (hd b) (om x0)) (plus (om x0) b) b (\ h' -> refl false) (\ h' -> hz)) ;
  ii -> \ b hz -> iteC (\ t -> Id Bool (isZero t) false) (isZero b) ii (consA ii b) (\ h -> refl false)
    (\ h -> iteC (\ t -> Id Bool (isZero t) false) (le (hd b) ii) (plus ii b) b (\ h' -> refl false) (\ h' -> hz)) } ;

-- hd(a + b) is hd(a) or hd(b), so below g when both are
HdLe (g : T) (t : T) : U j = Tr (le (hd t) g) ;

add-hd (g : T) : (a b : T) -> HdLe g a -> HdLe g b -> HdLe g (add a b) = split {
  zero -> \ b ha hb -> hb ;
  plus x0 xs -> \ b ha hb -> iteC (HdLe g) (isZero b) (plus x0 xs) (ifT (le (hd b) x0) (plus x0 (add xs b)) b) (\ h -> ha)
    (\ h -> iteC (HdLe g) (le (hd b) x0) (plus x0 (add xs b)) b (\ h' -> ha) (\ h' -> hb)) ;
  phi x0 x1 -> \ b ha hb -> iteC (HdLe g) (isZero b) (phi x0 x1) (consA (phi x0 x1) b) (\ h -> ha)
    (\ h -> iteC (HdLe g) (le (hd b) (phi x0 x1)) (plus (phi x0 x1) b) b (\ h' -> ha) (\ h' -> hb)) ;
  psi x0 x1 -> \ b ha hb -> iteC (HdLe g) (isZero b) (psi x0 x1) (consA (psi x0 x1) b) (\ h -> ha)
    (\ h -> iteC (HdLe g) (le (hd b) (psi x0 x1)) (plus (psi x0 x1) b) b (\ h' -> ha) (\ h' -> hb)) ;
  om x0 -> \ b ha hb -> iteC (HdLe g) (isZero b) (om x0) (consA (om x0) b) (\ h -> ha)
    (\ h -> iteC (HdLe g) (le (hd b) (om x0)) (plus (om x0) b) b (\ h' -> ha) (\ h' -> hb)) ;
  ii -> \ b ha hb -> iteC (HdLe g) (isZero b) ii (consA ii b) (\ h -> ha)
    (\ h -> iteC (HdLe g) (le (hd b) ii) (plus ii b) b (\ h' -> ha) (\ h' -> hb)) } ;

consA-OK (g b : T) (hA : Tr (isA g)) (og : OK g) (hz : Id Bool (isZero b) false) (ob : OK b) : OK (consA g b) =
  iteC OK (le (hd b) g) (plus g b) b (\ hl -> ot-plusI g b hA og hz ob hl) (\ h -> ob) ;

-- an atom g: g + b
add-OK-A (g b : T) (hA : Tr (isA g)) (og : OK g) (ob : OK b) : OK (ifT (isZero b) g (consA g b)) =
  iteC OK (isZero b) g (consA g b) (\ h -> og) (\ hz -> consA-OK g b hA og hz ob) ;

add-OK : (a : T) -> OK a -> (b : T) -> OK b -> OK (add a b) = split {
  zero -> \ oa b ob -> ob ;
  plus x0 xs | _ r -> \ oa b ob ->
    iteC OK (isZero b) (plus x0 xs) (ifT (le (hd b) x0) (plus x0 (add xs b)) b) (\ h -> oa)
      (\ hz -> iteC OK (le (hd b) x0) (plus x0 (add xs b)) b
         (\ hl -> ot-plusI x0 (add xs b) (ot-plusA x0 xs oa) (ot-plus0 x0 xs oa) (add-nz xs b hz)
                    (r (ot-plusS x0 xs oa) b ob) (add-hd x0 xs b (ot-plusLe x0 xs oa) hl))
         (\ h -> ob)) ;
  phi x0 x1 -> \ oa b ob -> add-OK-A (phi x0 x1) b (refl true) oa ob ;
  psi x0 x1 -> \ oa b ob -> add-OK-A (psi x0 x1) b (refl true) oa ob ;
  om x0 -> \ oa b ob -> add-OK-A (om x0) b (refl true) oa ob ;
  ii -> \ oa b ob -> add-OK-A ii b (refl true) oa ob } ;

mul-OK (a : T) (o : OK a) : (m : N) -> OK (mul a m) = split {
  nz -> refl true ; ns m | r -> add-OK (mul a m) r a o } ;

suc-OK (a : T) (o : OK a) : OK (suc a) = add-OK a o one (refl true) ;

------------------------------------------------------------------------
-- Remark 2.12(h): x, y <=' x + y;  x, y <=' phi_x y;  x <=' Omega_x.
--
-- Omega: OTC.lt-om.  phi: if y in Cr(x), then x <' y (y = phi'_b c with
-- x <' b <' y, or y in G' with x <' y); if y = 0, then phi_x y = x;
-- otherwise phi-below.  +: by induction on x, with three facts on sums:
--   * xs <' (x0, xs) for (x0, xs) in OT                     (sum-lt);
--   * y in OT, hd(y) <=' g, y <=' r  =>  y <' (g, r)        (le-cons);
--   * hd(x) <' hd(y), y /= 0  =>  x <' y                     (hd-lt).
-- y <=' x + y: x + y is y, or (g, y) (le-cons with r = y), or (x0, xs + y)
-- with y <=' xs + y by the hypothesis (le-cons).  x <=' x + y: x + y is x
-- (y = 0), or y with x0 <' hd(y) (hd-lt), or (g, y), or (x0, xs + y) with
-- xs <=' xs + y by the hypothesis.

zero-le-any : (t : T) -> Tr (le zero t) = split {
  zero -> refl true ; plus x0 xs -> refl true ; phi x0 x1 -> refl true ;
  psi x0 x1 -> refl true ; om x0 -> refl true ; ii -> refl true } ;

sum-lt : (xs x0 : T) -> OK (plus x0 xs) -> LT xs (plus x0 xs) = split {
  zero -> \ x0 o -> abF (ot-plusZ x0 zero o) ;
  plus y0 ys | _ r -> \ x0 o ->
    trans (lex-PP y0 ys x0 (plus y0 ys))
      (orE (Tr (or (lt y0 x0) (and (eqT y0 x0) (lt ys (plus y0 ys))))) (lt y0 x0) (eqT y0 x0) (ot-plusLe x0 (plus y0 ys) o)
         (\ p -> orIl (lt y0 x0) (and (eqT y0 x0) (lt ys (plus y0 ys))) p)
         (\ e -> orIr (lt y0 x0) (and (eqT y0 x0) (lt ys (plus y0 ys)))
                   (andI (eqT y0 x0) (lt ys (plus y0 ys)) e (r y0 (ot-plusS x0 (plus y0 ys) o))))) ;
  phi a b -> \ x0 o -> trans (lt-gP (phi a b) (refl true) x0 (phi a b)) (ot-plusLe x0 (phi a b) o) ;
  psi a b -> \ x0 o -> trans (lt-gP (psi a b) (refl true) x0 (psi a b)) (ot-plusLe x0 (psi a b) o) ;
  om a -> \ x0 o -> trans (lt-gP (om a) (refl true) x0 (om a)) (ot-plusLe x0 (om a) o) ;
  ii -> \ x0 o -> trans (lt-gP ii (refl true) x0 ii) (ot-plusLe x0 ii o) } ;

le-cons : (y g r : T) -> TT r -> OK y -> Tr (le (hd y) g) -> Tr (le y r) -> LT y (plus g r) = split {
  zero -> \ g r tr oy hl hy -> refl true ;
  plus y0 ys -> \ g r tr oy hl hy ->
    trans (lex-PP y0 ys g r)
      (orE (Tr (or (lt y0 g) (and (eqT y0 g) (lt ys r)))) (lt y0 g) (eqT y0 g) hl
         (\ p -> orIl (lt y0 g) (and (eqT y0 g) (lt ys r)) p)
         (\ e -> orIr (lt y0 g) (and (eqT y0 g) (lt ys r))
                   (andI (eqT y0 g) (lt ys r) e
                      (lt-le ys (plus y0 ys) r
                         (tr3 ys (plus y0 ys) r (ot-T ys (ot-plusS y0 ys oy)) (ot-T (plus y0 ys) oy) tr)
                         (sum-lt ys y0 oy) hy)))) ;
  phi a b -> \ g r tr oy hl hy -> trans (lt-gP (phi a b) (refl true) g r) hl ;
  psi a b -> \ g r tr oy hl hy -> trans (lt-gP (psi a b) (refl true) g r) hl ;
  om a -> \ g r tr oy hl hy -> trans (lt-gP (om a) (refl true) g r) hl ;
  ii -> \ g r tr oy hl hy -> trans (lt-gP ii (refl true) g r) hl } ;

-- x <' (y0, ys) from hd(x) <' y0
lt-plusR : (x y0 ys : T) -> LT (hd x) y0 -> LT x (plus y0 ys) = split {
  zero -> \ y0 ys h -> refl true ;
  plus x0 xs -> \ y0 ys h -> trans (lex-PP x0 xs y0 ys) (orIl (lt x0 y0) (and (eqT x0 y0) (lt xs ys)) h) ;
  phi a b -> \ y0 ys h -> trans (lt-gP (phi a b) (refl true) y0 ys) (le-of-lt (phi a b) y0 h) ;
  psi a b -> \ y0 ys h -> trans (lt-gP (psi a b) (refl true) y0 ys) (le-of-lt (psi a b) y0 h) ;
  om a -> \ y0 ys h -> trans (lt-gP (om a) (refl true) y0 ys) (le-of-lt (om a) y0 h) ;
  ii -> \ y0 ys h -> trans (lt-gP ii (refl true) y0 ys) (le-of-lt ii y0 h) } ;

hd-lt (x : T) : (y : T) -> Id Bool (isZero y) false -> LT (hd x) (hd y) -> LT x y = split {
  zero -> \ hz h -> abT hz ;
  plus y0 ys -> \ hz h -> lt-plusR x y0 ys h ;
  phi a b -> \ hz h -> trans (lt-hd x (phi a b) (refl true)) h ;
  psi a b -> \ hz h -> trans (lt-hd x (psi a b) (refl true)) h ;
  om a -> \ hz h -> trans (lt-hd x (om a) (refl true)) h ;
  ii -> \ hz h -> trans (lt-hd x ii (refl true)) h } ;

-- y <=' x + y
le-add-r-A (g y : T) (oy : OK y) : Tr (le y (ifT (isZero y) g (consA g y))) =
  iteC (\ t -> Tr (le y t)) (isZero y) g (consA g y)
    (\ hz -> subst (\ s -> Tr (le s g)) (sym (isZero-true y hz)) (zero-le-any g))
    (\ hz -> iteC (\ t -> Tr (le y t)) (le (hd y) g) (plus g y) y
       (\ hl -> le-of-lt y (plus g y) (le-cons y g y (ot-T y oy) oy hl (le-refl y))) (\ h -> le-refl y)) ;

le-add-r : (x : T) -> OK x -> (y : T) -> OK y -> Tr (le y (add x y)) = split {
  zero -> \ ox y oy -> le-refl y ;
  plus x0 xs | _ r -> \ ox y oy ->
    iteC (\ t -> Tr (le y t)) (isZero y) (plus x0 xs) (ifT (le (hd y) x0) (plus x0 (add xs y)) y)
      (\ hz -> subst (\ s -> Tr (le s (plus x0 xs))) (sym (isZero-true y hz)) (zero-le-any (plus x0 xs)))
      (\ hz -> iteC (\ t -> Tr (le y t)) (le (hd y) x0) (plus x0 (add xs y)) y
         (\ hl -> le-of-lt y (plus x0 (add xs y))
                    (le-cons y x0 (add xs y) (ot-T (add xs y) (add-OK xs (ot-plusS x0 xs ox) y oy)) oy hl
                       (r (ot-plusS x0 xs ox) y oy)))
         (\ h -> le-refl y)) ;
  phi a b -> \ ox y oy -> le-add-r-A (phi a b) y oy ;
  psi a b -> \ ox y oy -> le-add-r-A (psi a b) y oy ;
  om a -> \ ox y oy -> le-add-r-A (om a) y oy ;
  ii -> \ ox y oy -> le-add-r-A ii y oy } ;

-- x <=' x + y
le-plus2 (x0 xs r : T) (h : Tr (le xs r)) : Tr (le (plus x0 xs) (plus x0 r)) =
  orE (Tr (le (plus x0 xs) (plus x0 r))) (lt xs r) (eqT xs r) h
    (\ p -> le-of-lt (plus x0 xs) (plus x0 r)
              (trans (lex-PP x0 xs x0 r) (orIr (lt x0 x0) (and (eqT x0 x0) (lt xs r)) (andI (eqT x0 x0) (lt xs r) (eqT-refl x0) p))))
    (\ e -> le-of-eq (plus x0 xs) (plus x0 r) (andI (eqT x0 x0) (eqT xs r) (eqT-refl x0) e)) ;

le-add-l-A (g y : T) (hA : Tr (isA g)) (og : OK g) (oy : OK y) : Tr (le g (ifT (isZero y) g (consA g y))) =
  iteC (\ t -> Tr (le g t)) (isZero y) g (consA g y) (\ hz -> le-refl g)
    (\ hz -> iteC (\ t -> Tr (le g t)) (le (hd y) g) (plus g y) y
       (\ hl -> le-of-lt g (plus g y) (lt-head g y hA))
       (\ hn -> le-of-lt g y (hd-lt g y hz (subst (\ s -> LT s (hd y)) (sym (hd-A g hA))
                   (nle-lt' (hd y) g (ot-T (hd y) (hd-OK y oy)) (ot-T g og) hn))))) ;

le-add-l : (x : T) -> OK x -> (y : T) -> OK y -> Tr (le x (add x y)) = split {
  zero -> \ ox y oy -> zero-le-any y ;
  plus x0 xs | _ r -> \ ox y oy ->
    iteC (\ t -> Tr (le (plus x0 xs) t)) (isZero y) (plus x0 xs) (ifT (le (hd y) x0) (plus x0 (add xs y)) y)
      (\ hz -> le-refl (plus x0 xs))
      (\ hz -> iteC (\ t -> Tr (le (plus x0 xs) t)) (le (hd y) x0) (plus x0 (add xs y)) y
         (\ hl -> le-plus2 x0 xs (add xs y) (r (ot-plusS x0 xs ox) y oy))
         (\ hn -> le-of-lt (plus x0 xs) y (hd-lt (plus x0 xs) y hz
                    (nle-lt' (hd y) x0 (ot-T (hd y) (hd-OK y oy)) (ot-T x0 (ot-plus0 x0 xs ox)) hn)))) ;
  phi a b -> \ ox y oy -> le-add-l-A (phi a b) y (refl true) ox oy ;
  psi a b -> \ ox y oy -> le-add-l-A (psi a b) y (refl true) ox oy ;
  om a -> \ ox y oy -> le-add-l-A (om a) y (refl true) ox oy ;
  ii -> \ ox y oy -> le-add-l-A ii y (refl true) ox oy } ;

-- phi
crit-lt (x : T) (tx : TT x) : (y : T) -> TT y -> Tr (crit x y) -> LT x y = split {
  zero -> \ ty h -> abF h ;
  plus y0 ys -> \ ty h -> abF h ;
  phi b c -> \ ty h -> tr3 x b (phi b c) tx (isT-phi0 b c ty) ty h
                         ((phi-below b).1 b c (isT-phi0 b c ty) (isT-phi0 b c ty) (isT-phi1 b c ty) (le-refl b)) ;
  psi p b -> \ ty h -> h ; om a -> \ ty h -> h ; ii -> \ ty h -> h } ;

le-phiF-l (x y : T) (ox : OK x) (oy : OK y) : Tr (le x (phiF x y)) =
  iteC (\ t -> Tr (le x t)) (crit x y) y (ifT (and (isZero y) (isG x)) x (phi x y))
    (\ hc -> le-of-lt x y (crit-lt x (ot-T x ox) y (ot-T y oy) hc))
    (\ hc -> iteC (\ t -> Tr (le x t)) (and (isZero y) (isG x)) x (phi x y) (\ h -> le-refl x)
       (\ h -> le-of-lt x (phi x y) ((phi-below x).1 x y (ot-T x ox) (ot-T x ox) (ot-T y oy) (le-refl x)))) ;

le-phiF-r (x y : T) (ox : OK x) (oy : OK y) : Tr (le y (phiF x y)) =
  iteC (\ t -> Tr (le y t)) (crit x y) y (ifT (and (isZero y) (isG x)) x (phi x y))
    (\ hc -> le-refl y)
    (\ hc -> iteC (\ t -> Tr (le y t)) (and (isZero y) (isG x)) x (phi x y)
       (\ h -> subst (\ s -> Tr (le s x)) (sym (isZero-true y (and-l (isZero y) (isG x) h))) (zero-le-any x))
       (\ h -> le-of-lt y (phi x y) ((phi-below y).2 x y (ot-T y oy) (ot-T x ox) (ot-T y oy) (le-refl y)))) ;

le-omF (x : T) (o : OK x) : Tr (le x (omF x)) = omF-le x x (k-main x o).1 (ot-T x o) (le-refl x) ;

-- Remark 2.12(h), as stated
rem212h (x y : T) (ox : OK x) (oy : OK y)
  : Tr (le x (add x y)) * (Tr (le y (add x y)) * (Tr (le x (phiF x y)) * (Tr (le y (phiF x y)) * Tr (le x (omF x))))) =
  (le-add-l x ox y oy, (le-add-r x ox y oy, (le-phiF-l x y ox oy, (le-phiF-r x y ox oy, le-omF x ox)))) ;

-- Remark 2.12(a), as stated
rem212a (x y : T) (m : N) (ox : OK x) (oy : OK y)
  : OK (add x y) * (OK (mul x m) * (OK (phiF x y) * (OK (omF x) * OK (omN m x)))) =
  (add-OK x ox y oy, (mul-OK x ox m, (phiF-OK x y ox oy, (omF-OK x ox, omN-OK m x ox)))) ;

------------------------------------------------------------------------
-- Remark 2.12(g): Omega_x <' Omega_y iff x <' y  (x, y in T').
--
-- Omega_x = x when x in Fi' u {0} (fixed), and Omega'_x otherwise.  Four
-- cases.  Both fixed: nothing to do.  Neither: clause (9).  x fixed, y not:
-- x = 0 (clause (1)), x = psi_I b (clause (7): x <' Omega'_y iff x <=' y)
-- or x = I (clause (10)); x /= y since y is not in Fi', so x <=' y is x <' y.
-- y fixed, x not: y = 0;  y = psi_I d (clause (7) and (11): Omega'_x <'
-- psi_I d iff not psi_I d <=' x, iff x <' psi_I d);  or y = I (clause (10)).

fx (x : T) : Bool = or (isFi x) (isZero x) ;

omF-fix : (x : T) -> Tr (fx x) -> Id T (omF x) x = split {
  zero -> \ h -> refl zero ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> abF h ;
  psi p c -> \ h -> ifT-t (isI p) (psi p c) (om (psi p c)) (trans (sym (orF (isI p))) h) ;
  om a -> \ h -> abF h ; ii -> \ h -> refl ii } ;

omF-mov : (x : T) -> Id Bool (fx x) false -> Id T (omF x) (om x) = split {
  zero -> \ h -> abT h ; plus x0 xs -> \ h -> refl (om (plus x0 xs)) ; phi x0 x1 -> \ h -> refl (om (phi x0 x1)) ;
  psi p c -> \ h -> ifT-f (isI p) (psi p c) (om (psi p c)) (trans (sym (orF (isI p))) h) ;
  om a -> \ h -> refl (om (om a)) ; ii -> \ h -> abT h } ;

-- x fixed, y moved:  x /= y
fx-ne (x y : T) (hx : Tr (fx x)) (hy : Id Bool (fx y) false) : Id Bool (eqT x y) false =
  boolCases (Id Bool (eqT x y) false) (eqT x y)
    (\ e -> abT (trans (sym hx) (trans (ap fx (eqT-sound x y e)) hy))) (\ e -> e) ;

zero-lt-nz : (y : T) -> Id Bool (isZero y) false -> Id Bool (lt zero y) true = split {
  zero -> \ h -> abT h ; plus x0 xs -> \ h -> refl true ; phi x0 x1 -> \ h -> refl true ;
  psi x0 x1 -> \ h -> refl true ; om x0 -> \ h -> refl true ; ii -> \ h -> refl true } ;

fix-mov : (x : T) -> (y : T) -> TT y -> Tr (fx x) -> Id Bool (fx y) false -> Id Bool (lt x (om y)) (lt x y) = split {
  zero -> \ y ty hx hy -> sym (zero-lt-nz y (or-ff (isFi y) (isZero y) hy).2) ;
  plus x0 xs -> \ y ty hx hy -> abF hx ;
  phi x0 x1 -> \ y ty hx hy -> abF hx ;
  psi p b -> \ y ty hx hy ->
    trans (lex-TO p b y (trans (sym (orF (isI p))) hx))
      (trans (orAT (lt (psi p b) y) (eqT (psi p b) y))
         (trans (ap (\ w -> or (lt (psi p b) y) w) (fx-ne (psi p b) y hx hy)) (orF (lt (psi p b) y)))) ;
  om a -> \ y ty hx hy -> abF hx ;
  ii -> \ y ty hx hy ->
    trans (lex-IO y ty)
      (trans (orAT (lt ii y) (eqT ii y))
         (trans (ap (\ w -> or (lt ii y) w) (fx-ne ii y hx hy)) (orF (lt ii y)))) } ;

mov-fix (x : T) (tx : TT x) : (y : T) -> TT y -> Tr (fx y) -> Id Bool (lt (om x) y) (lt x y) = split {
  zero -> \ ty hy -> trans (lt-zero (om x)) (sym (lt-zero x)) ;
  plus y0 ys -> \ ty hy -> abF hy ;
  phi y0 y1 -> \ ty hy -> abF hy ;
  psi q d -> \ ty hy -> trans (lex-OT x q d tx ty (trans (sym (orF (isI q))) hy)) (orAF (lt x (psi q d)) (eqT x (psi q d))) ;
  om c -> \ ty hy -> abF hy ;
  ii -> \ ty hy -> trans (lex-OI x) (orAF (lt x ii) (eqT x ii)) } ;

rem212g (x y : T) (tx : TT x) (ty : TT y) : Id Bool (lt (omF x) (omF y)) (lt x y) =
  boolCases (Id Bool (lt (omF x) (omF y)) (lt x y)) (fx x)
    (\ hx -> boolCases (Id Bool (lt (omF x) (omF y)) (lt x y)) (fx y)
       (\ hy -> ap2 lt (omF-fix x hx) (omF-fix y hy))
       (\ hy -> trans (ap2 lt (omF-fix x hx) (omF-mov y hy)) (fix-mov x y ty hx hy)))
    (\ hx -> boolCases (Id Bool (lt (omF x) (omF y)) (lt x y)) (fx y)
       (\ hy -> trans (ap2 lt (omF-mov x hx) (omF-fix y hy)) (mov-fix x tx y ty hy))
       (\ hy -> trans (ap2 lt (omF-mov x hx) (omF-mov y hy)) (trans (lex-OO x y) (orAF (lt x y) (eqT x y))))) ;

------------------------------------------------------------------------
-- Remark 2.12(e): y <' y'  =>  x + y <' x + y'   (x, y, y' in OT).
--
-- By induction on x.  x = 0: clear.  y = 0: x + 0 = x <' x + y' (lt-add-l,
-- the strict form of x <=' x + y for y /= 0, proved like it).  y, y' /= 0,
-- x = (a, xs) or x = a an atom: x + y is (a, k) with k = xs + y (resp. y)
-- when hd(y) <=' a, and y otherwise; the same for y'.  Four cases
-- (add-step):  both kept: (a, k) <' (a, k') from k <' k' (the hypothesis,
-- resp. y <' y');  y kept, y' not: hd(x + y) = a <' hd(y') (hd-lt);  y not,
-- y' kept: hd(y') <=' a <' hd(y), so y' <' y, impossible;  neither: y <' y'.

add-zero-r : (x : T) -> Id T (add x zero) x = split {
  zero -> refl zero ; plus x0 xs -> refl (plus x0 xs) ; phi x0 x1 -> refl (phi x0 x1) ;
  psi x0 x1 -> refl (psi x0 x1) ; om x0 -> refl (om x0) ; ii -> refl ii } ;

-- x + y for y /= 0, x a sum or an atom
add-P (x0 xs y : T) (hz : Id Bool (isZero y) false)
  : Id T (add (plus x0 xs) y) (ifT (le (hd y) x0) (plus x0 (add xs y)) y) =
  ifT-f (isZero y) (plus x0 xs) (ifT (le (hd y) x0) (plus x0 (add xs y)) y) hz ;
add-A (g y : T) (hz : Id Bool (isZero y) false) (hx : Id T (add g y) (ifT (isZero y) g (consA g y)))
  : Id T (add g y) (ifT (le (hd y) g) (plus g y) y) =
  trans hx (ifT-f (isZero y) g (consA g y) hz) ;

-- add g y, by definition, for each kind of atom
AddA (g : T) : U j = (y : T) -> Id T (add g y) (ifT (isZero y) g (consA g y)) ;
addA : (g : T) -> Tr (isA g) -> AddA g = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ;
  phi x0 x1 -> \ h y -> refl (add (phi x0 x1) y) ;
  psi x0 x1 -> \ h y -> refl (add (psi x0 x1) y) ;
  om x0 -> \ h y -> refl (add (om x0) y) ;
  ii -> \ h y -> refl (add ii y) } ;

-- x <' x + y for y /= 0
lt-add-l-A (g y : T) (hA : Tr (isA g)) (og : OK g) (oy : OK y) (hz : Id Bool (isZero y) false) : LT g (add g y) =
  subst (\ t -> LT g t) (sym (add-A g y hz (addA g hA y)))
    (iteC (\ t -> LT g t) (le (hd y) g) (plus g y) y (\ hl -> lt-head g y hA)
       (\ hn -> hd-lt g y hz (subst (\ s -> LT s (hd y)) (sym (hd-A g hA))
                   (nle-lt' (hd y) g (ot-T (hd y) (hd-OK y oy)) (ot-T g og) hn)))) ;

lt-add-l : (x : T) -> OK x -> (y : T) -> OK y -> Id Bool (isZero y) false -> LT x (add x y) = split {
  zero -> \ ox y oy hz -> zero-lt-nz y hz ;
  plus x0 xs | _ r -> \ ox y oy hz ->
    subst (\ t -> LT (plus x0 xs) t) (sym (add-P x0 xs y hz))
      (iteC (\ t -> LT (plus x0 xs) t) (le (hd y) x0) (plus x0 (add xs y)) y
         (\ hl -> trans (lex-PP x0 xs x0 (add xs y))
                    (orIr (lt x0 x0) (and (eqT x0 x0) (lt xs (add xs y)))
                       (andI (eqT x0 x0) (lt xs (add xs y)) (eqT-refl x0) (r (ot-plusS x0 xs ox) y oy hz))))
         (\ hn -> hd-lt (plus x0 xs) y hz
                    (nle-lt' (hd y) x0 (ot-T (hd y) (hd-OK y oy)) (ot-T x0 (ot-plus0 x0 xs ox)) hn))) ;
  phi a b -> \ ox y oy hz -> lt-add-l-A (phi a b) y (refl true) ox oy hz ;
  psi a b -> \ ox y oy hz -> lt-add-l-A (psi a b) y (refl true) ox oy hz ;
  om a -> \ ox y oy hz -> lt-add-l-A (om a) y (refl true) ox oy hz ;
  ii -> \ ox y oy hz -> lt-add-l-A ii y (refl true) ox oy hz } ;

-- the four cases, for a head a and kept tails k <' k'
add-step (a y y' k k' : T) (ta : TT a) (oy : OK y) (oy' : OK y') (tk : TT k) (tk' : TT k')
  (hz : Id Bool (isZero y) false) (hz' : Id Bool (isZero y') false) (h : LT y y') (hk : LT k k')
  : LT (ifT (le (hd y) a) (plus a k) y) (ifT (le (hd y') a) (plus a k') y') =
  iteC (\ t -> LT t (ifT (le (hd y') a) (plus a k') y')) (le (hd y) a) (plus a k) y
    (\ hl -> iteC (\ t -> LT (plus a k) t) (le (hd y') a) (plus a k') y'
       (\ hl' -> trans (lex-PP a k a k') (orIr (lt a a) (and (eqT a a) (lt k k')) (andI (eqT a a) (lt k k') (eqT-refl a) hk)))
       (\ hn' -> hd-lt (plus a k) y' hz' (nle-lt' (hd y') a (ot-T (hd y') (hd-OK y' oy')) ta hn')))
    (\ hn -> iteC (\ t -> LT y t) (le (hd y') a) (plus a k') y'
       (\ hl' -> asym-abs (LT y (plus a k')) y y' (ot-T y oy) (ot-T y' oy') h
          (hd-lt y' y hz
             (le-lt (hd y') a (hd y) (tr3 (hd y') a (hd y) (ot-T (hd y') (hd-OK y' oy')) ta (ot-T (hd y) (hd-OK y oy)))
                hl' (nle-lt' (hd y) a (ot-T (hd y) (hd-OK y oy)) ta hn))))
       (\ hn' -> h)) ;

add-mono-A (g y y' : T) (hA : Tr (isA g)) (og : OK g) (oy : OK y) (oy' : OK y')
  (hz : Id Bool (isZero y) false) (hz' : Id Bool (isZero y') false) (h : LT y y') : LT (add g y) (add g y') =
  subst (\ t -> LT t (add g y')) (sym (add-A g y hz (addA g hA y)))
    (subst (\ t -> LT (ifT (le (hd y) g) (plus g y) y) t) (sym (add-A g y' hz' (addA g hA y')))
       (add-step g y y' y y' (ot-T g og) oy oy' (ot-T y oy) (ot-T y' oy') hz hz' h h)) ;

-- y <' y' gives y' /= 0
nz-of-gt (y : T) : (y' : T) -> LT y y' -> Id Bool (isZero y') false = split {
  zero -> \ h -> abT (trans (sym h) (lt-zero y)) ;
  plus x0 xs -> \ h -> refl false ; phi x0 x1 -> \ h -> refl false ;
  psi x0 x1 -> \ h -> refl false ; om x0 -> \ h -> refl false ; ii -> \ h -> refl false } ;

add-mono-nz : (x : T) -> OK x -> (y y' : T) -> OK y -> OK y' -> Id Bool (isZero y) false -> Id Bool (isZero y') false
  -> LT y y' -> LT (add x y) (add x y') = split {
  zero -> \ ox y y' oy oy' hz hz' h -> h ;
  plus x0 xs | _ r -> \ ox y y' oy oy' hz hz' h ->
    subst (\ t -> LT t (add (plus x0 xs) y')) (sym (add-P x0 xs y hz))
      (subst (\ t -> LT (ifT (le (hd y) x0) (plus x0 (add xs y)) y) t) (sym (add-P x0 xs y' hz'))
         (add-step x0 y y' (add xs y) (add xs y') (ot-T x0 (ot-plus0 x0 xs ox)) oy oy'
            (ot-T (add xs y) (add-OK xs (ot-plusS x0 xs ox) y oy)) (ot-T (add xs y') (add-OK xs (ot-plusS x0 xs ox) y' oy'))
            hz hz' h (r (ot-plusS x0 xs ox) y y' oy oy' hz hz' h))) ;
  phi a b -> \ ox y y' oy oy' hz hz' h -> add-mono-A (phi a b) y y' (refl true) ox oy oy' hz hz' h ;
  psi a b -> \ ox y y' oy oy' hz hz' h -> add-mono-A (psi a b) y y' (refl true) ox oy oy' hz hz' h ;
  om a -> \ ox y y' oy oy' hz hz' h -> add-mono-A (om a) y y' (refl true) ox oy oy' hz hz' h ;
  ii -> \ ox y y' oy oy' hz hz' h -> add-mono-A ii y y' (refl true) ox oy oy' hz hz' h } ;

rem212e (x y y' : T) (ox : OK x) (oy : OK y) (oy' : OK y') (h : LT y y') : LT (add x y) (add x y') =
  boolCases (LT (add x y) (add x y')) (isZero y)
    (\ hz -> subst (\ s -> LT (add x s) (add x y')) (sym (isZero-true y hz))
       (subst (\ t -> LT t (add x y')) (sym (add-zero-r x))
          (lt-add-l x ox y' oy' (nz-of-gt y y' h))))
    (\ hz -> add-mono-nz x ox y y' oy oy' hz (nz-of-gt y y' h) h) ;

------------------------------------------------------------------------
-- Remark 2.12(f), corrected: for x, y, x', y' in OT
--   phi_x y <' phi_x' y'  iff  (x <' x' and y <' phi_x' y') or (x = x' and y <' y')
--                              or (x' <' x and phi_x y <' y').
-- As printed the last disjunct has phi_x y <=' y'; that fails for
-- phi_I 0 = I = phi_0 I (both sides compare I with I).
--
-- Two lemmas.
--   (i)  y <' y'  =>  phi_x y <' phi_x y'                    (phiF-mono).
--        If y' in Cr(x), phi_x y' = y': phi_x y is y <' y', or x <' y' (y = 0),
--        or phi'_x y <' y' by (3)(A) (y' = phi'_b c, x <' b) or (4) (y' in G',
--        x <' y').  Otherwise y' /= 0 and phi_x y' = phi'_x y': phi_x y is y,
--        or x, both below phi'_x y' (phi-below), or phi'_x y, by (3)(B).
--   (ii) x <' x'  =>  phi_x (phi_x' y') = phi_x' y'           (phiF-fix):
--        phi_x' y' is in Cr(x).  It is y' in Cr(x') (and Cr(x') is part of
--        Cr(x)), or x' in G' with x <' x', or phi'_x' y' with x <' x'.
-- Then (f).  <=: (A) phi_x y <' phi_x (phi_x' y') = phi_x' y' by (i), (ii);
-- (B) by (i); (C) phi_x y <' y' <=' phi_x' y' (2.12(h)).  =>: compare x and
-- x'.  x <' x': y <=' phi_x y <' phi_x' y'.  x = x': y = y' and y' <' y are
-- excluded by (i).  x' <' x: phi_x y = y' would give phi_x' y' = phi_x y by
-- (ii), and y' <' phi_x y would give phi_x' y' <' phi_x' (phi_x y) = phi_x y
-- by (i), (ii); so phi_x y <' y', by trichotomy.

-- (i)
phi-crit (x y : T) (tx : TT x) (ty : TT y) : (y' : T) -> TT y' -> Tr (crit x y') -> LT y y' -> LT (phi x y) y' = split {
  zero -> \ ty' hc h -> abF hc ;
  plus y0 ys -> \ ty' hc h -> abF hc ;
  phi b c -> \ ty' hc h -> phi3-A x y b c hc h ;
  psi p b -> \ ty' hc h -> fg-intro x y (psi p b) (refl true) hc h ;
  om a -> \ ty' hc h -> fg-intro x y (om a) (refl true) hc h ;
  ii -> \ ty' hc h -> fg-intro x y ii (refl true) hc h } ;

phiF-mono (x y y' : T) (ox : OK x) (oy : OK y) (oy' : OK y') (h : LT y y') : LT (phiF x y) (phiF x y') =
  iteC (\ t -> LT (phiF x y) t) (crit x y') y' (ifT (and (isZero y') (isG x)) x (phi x y'))
    (\ hc' -> iteC (\ t -> LT t y') (crit x y) y (ifT (and (isZero y) (isG x)) x (phi x y)) (\ hc -> h)
       (\ hc -> iteC (\ t -> LT t y') (and (isZero y) (isG x)) x (phi x y)
          (\ hz -> crit-lt x (ot-T x ox) y' (ot-T y' oy') hc')
          (\ hz -> phi-crit x y (ot-T x ox) (ot-T y oy) y' (ot-T y' oy') hc' h)))
    (\ hc' -> iteC (\ t -> LT (phiF x y) t) (and (isZero y') (isG x)) x (phi x y')
       (\ hz' -> abF (trans (sym (nz-of-gt y y' h)) (and-l (isZero y') (isG x) hz')))
       (\ hz' -> iteC (\ t -> LT t (phi x y')) (crit x y) y (ifT (and (isZero y) (isG x)) x (phi x y))
          (\ hc -> (phi-below y).2 x y' (ot-T y oy) (ot-T x ox) (ot-T y' oy') (le-of-lt y y' h))
          (\ hc -> iteC (\ t -> LT t (phi x y')) (and (isZero y) (isG x)) x (phi x y)
             (\ hz -> (phi-below x).1 x y' (ot-T x ox) (ot-T x ox) (ot-T y' oy') (le-refl x))
             (\ hz -> phi3-B x y x y' (eqT-refl x) h)))) ;

-- (ii)
crit-up (x x' : T) (tx : TT x) (tx' : TT x') (h : LT x x') : (y : T) -> TT y -> Tr (crit x' y) -> Tr (crit x y) = split {
  zero -> \ ty hc -> abF hc ;
  plus y0 ys -> \ ty hc -> abF hc ;
  phi b c -> \ ty hc -> tr3 x x' b tx tx' (isT-phi0 b c ty) h hc ;
  psi p b -> \ ty hc -> tr3 x x' (psi p b) tx tx' ty h hc ;
  om a -> \ ty hc -> tr3 x x' (om a) tx tx' ty h hc ;
  ii -> \ ty hc -> tr3 x x' ii tx tx' ty h hc } ;

crit-G (x : T) : (g : T) -> Tr (isG g) -> LT x g -> Tr (crit x g) = split {
  zero -> \ hg h -> abF hg ; plus y0 ys -> \ hg h -> abF hg ; phi b c -> \ hg h -> abF hg ;
  psi p b -> \ hg h -> h ; om a -> \ hg h -> h ; ii -> \ hg h -> h } ;

phiF-crit (x x' y' : T) (tx : TT x) (tx' : TT x') (ty' : TT y') (h : LT x x') : Tr (crit x (phiF x' y')) =
  iteC (\ t -> Tr (crit x t)) (crit x' y') y' (ifT (and (isZero y') (isG x')) x' (phi x' y'))
    (\ hc -> crit-up x x' tx tx' h y' ty' hc)
    (\ hc -> iteC (\ t -> Tr (crit x t)) (and (isZero y') (isG x')) x' (phi x' y')
       (\ hz -> crit-G x x' (and-r (isZero y') (isG x') hz) h) (\ hz -> h)) ;

phiF-fix (x x' y' : T) (tx : TT x) (tx' : TT x') (ty' : TT y') (h : LT x x') : Id T (phiF x (phiF x' y')) (phiF x' y') =
  ifT-t (crit x (phiF x' y')) (phiF x' y') (ifT (and (isZero (phiF x' y')) (isG x)) x (phi x (phiF x' y')))
    (phiF-crit x x' y' tx tx' ty' h) ;

-- a Boolean equality from the two implications
bool-iff : (u v : Bool) -> (Tr u -> Tr v) -> (Tr v -> Tr u) -> Id Bool u v = split {
  false -> split { false -> \ f g -> refl false ; true -> \ f g -> g (refl true) } ;
  true -> \ v f g -> sym (f (refl true)) } ;

F3 (x y x' y' : T) : Bool =
  or (or (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y'))) (and (lt x' x) (lt (phiF x y) y')) ;

rem212f-l (x y x' y' : T) (ox : OK x) (oy : OK y) (ox' : OK x') (oy' : OK y') (r : Tr (F3 x y x' y'))
  : LT (phiF x y) (phiF x' y') =
  orE (LT (phiF x y) (phiF x' y')) (or (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y')))
      (and (lt x' x) (lt (phiF x y) y')) r
    (\ r1 -> orE (LT (phiF x y) (phiF x' y')) (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y')) r1
       (\ a -> subst (\ t -> LT (phiF x y) t)
                 (phiF-fix x x' y' (ot-T x ox) (ot-T x' ox') (ot-T y' oy') (and-l (lt x x') (lt y (phiF x' y')) a))
                 (phiF-mono x y (phiF x' y') ox oy (phiF-OK x' y' ox' oy') (and-r (lt x x') (lt y (phiF x' y')) a)))
       (\ b -> subst (\ s -> LT (phiF x y) (phiF s y')) (eqT-sound x x' (and-l (eqT x x') (lt y y') b))
                 (phiF-mono x y y' ox oy oy' (and-r (eqT x x') (lt y y') b))))
    (\ c -> lt-le (phiF x y) y' (phiF x' y')
              (tr3 (phiF x y) y' (phiF x' y') (ot-T (phiF x y) (phiF-OK x y ox oy)) (ot-T y' oy') (ot-T (phiF x' y') (phiF-OK x' y' ox' oy')))
              (and-r (lt x' x) (lt (phiF x y) y') c) (le-phiF-r x' y' ox' oy')) ;

rem212f-r (x y x' y' : T) (ox : OK x) (oy : OK y) (ox' : OK x') (oy' : OK y') (h : LT (phiF x y) (phiF x' y'))
  : Tr (F3 x y x' y') =
  tri x x' (ot-T x ox) (ot-T x' ox') (Tr (F3 x y x' y'))
    (\ p -> orIl (or (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y'))) (and (lt x' x) (lt (phiF x y) y'))
       (orIl (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y'))
          (andI (lt x x') (lt y (phiF x' y')) p
             (le-lt y (phiF x y) (phiF x' y')
                (tr3 y (phiF x y) (phiF x' y') (ot-T y oy) (ot-T (phiF x y) (phiF-OK x y ox oy)) (ot-T (phiF x' y') (phiF-OK x' y' ox' oy')))
                (le-phiF-r x y ox oy) h))))
    (\ e -> orIl (or (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y'))) (and (lt x' x) (lt (phiF x y) y'))
       (orIr (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y'))
          (andI (eqT x x') (lt y y') e
             (tri y y' (ot-T y oy) (ot-T y' oy') (LT y y') (\ q -> q)
                (\ q -> abF (trans (sym (lt-irr (phiF x y)))
                              (subst (\ s -> LT (phiF x y) (phiF x s)) (sym (eqT-sound y y' q))
                                 (subst (\ s -> LT (phiF x y) (phiF s y')) (sym (eqT-sound x x' e)) h))))
                (\ q -> asym-abs (LT y y') (phiF x y) (phiF x' y')
                          (ot-T (phiF x y) (phiF-OK x y ox oy)) (ot-T (phiF x' y') (phiF-OK x' y' ox' oy')) h
                          (subst (\ s -> LT (phiF s y') (phiF x y)) (eqT-sound x x' e) (phiF-mono x y' y ox oy' oy q)))))))
    (\ p -> orIr (or (and (lt x x') (lt y (phiF x' y'))) (and (eqT x x') (lt y y'))) (and (lt x' x) (lt (phiF x y) y'))
       (andI (lt x' x) (lt (phiF x y) y') p
          (tri (phiF x y) y' (ot-T (phiF x y) (phiF-OK x y ox oy)) (ot-T y' oy') (LT (phiF x y) y') (\ q -> q)
             (\ q -> abF (trans (sym (lt-irr (phiF x y)))
                           (subst (\ t -> LT (phiF x y) t) (phiF-fix x' x y (ot-T x' ox') (ot-T x ox) (ot-T y oy) p)
                              (subst (\ s -> LT (phiF x y) (phiF x' s)) (sym (eqT-sound (phiF x y) y' q)) h))))
             (\ q -> asym-abs (LT (phiF x y) y') (phiF x y) (phiF x' y')
                       (ot-T (phiF x y) (phiF-OK x y ox oy)) (ot-T (phiF x' y') (phiF-OK x' y' ox' oy')) h
                       (subst (\ t -> LT (phiF x' y') t) (phiF-fix x' x y (ot-T x' ox') (ot-T x ox) (ot-T y oy) p)
                          (phiF-mono x' y' (phiF x y) ox' oy' (phiF-OK x y ox oy) q)))))) ;

rem212f (x y x' y' : T) (ox : OK x) (oy : OK y) (ox' : OK x') (oy' : OK y')
  : Id Bool (lt (phiF x y) (phiF x' y')) (F3 x y x' y') =
  bool-iff (lt (phiF x y) (phiF x' y')) (F3 x y x' y')
    (rem212f-r x y x' y' ox oy ox' oy') (rem212f-l x y x' y' ox oy ox' oy') ;

------------------------------------------------------------------------
-- Def. 2.11: normal forms.
--   (a) a =NF b+c: b = (b1..bn), c = (c1..cm), n, m >= 1, a = (b1..bn, c1..cm)
--       in OT;  a =NF' b+c: moreover c in A.
--   (b) a =NF phi_b c: a = phi'_b c in OT;  (c) a =NF Omega_b: a = Omega'_b
--       in OT;  (d) a =NF psi_b c: a = psi_b c in OT.
-- (b1..bn, c1..cm) is cat b c.  "b = (b1..bn) with n >= 1" is: b in T', b /= 0.

-- cat (b1..bn, c1..cm): OT.seg

NZ (x : T) : U j = Id Bool (isZero x) false ;

NFsum (a b c : T) : U j = Id T a (cat b c) * (TT b * (TT c * (NZ b * (NZ c * OK a)))) ;
NFsum' (a b c : T) : U j = NFsum a b c * Tr (isA c) ;
NFphi (a b c : T) : U j = Id T a (phi b c) * OK a ;
NFom (a b : T) : U j = Id T a (om b) * OK a ;
NFpsi (a b c : T) : U j = Id T a (psi b c) * OK a ;

-- the hypothesis of Remark 2.12(c), (d)
data Dec (x y z : T) : U j = dsum (h : NFsum x y z) | dphi (h : NFphi x y z)
                           | dom (h : NFom x y) (e : Id T y z) | dpsi (h : NFpsi x y z) ;

------------------------------------------------------------------------
-- Remark 2.12(d): x in OT, x =NF y+z (or phi_y z, Omega_y with y = z,
-- psi_y z)  =>  y, z in OT.
-- phi, Omega, psi: (OT3), (OT5), (OT4).  Sums, by induction on y:
-- y = g an atom: x = (g, z), (OT2).  y = (y0, ys): x = (y0, ys + z) (as cat)
-- with ys + z in OT; by the hypothesis ys, z in OT; and hd(ys) =
-- hd(cat ys z) <=' y0, so y in OT by (OT2).

hd-cat : (y z : T) -> NZ y -> Id T (hd (cat y z)) (hd y) = split {
  zero -> \ z h -> abT h ; plus x0 xs -> \ z h -> refl x0 ;
  phi x0 x1 -> \ z h -> refl (phi x0 x1) ; psi x0 x1 -> \ z h -> refl (psi x0 x1) ;
  om x0 -> \ z h -> refl (om x0) ; ii -> \ z h -> refl ii } ;

cat-OK : (y z : T) -> TT y -> NZ y -> OK (cat y z) -> OK y * OK z = split {
  zero -> \ z ty hy o -> abT hy ;
  plus y0 ys | _ r -> \ z ty hy o ->
    (ot-plusI y0 ys (isT-plusA y0 ys ty) (ot-plus0 y0 (cat ys z) o) (tail-nz y0 ys ty)
       (r z (isT-plusS y0 ys ty) (tail-nz y0 ys ty) (ot-plusS y0 (cat ys z) o)).1
       (subst (\ s -> Tr (le s y0)) (hd-cat ys z (tail-nz y0 ys ty)) (ot-plusLe y0 (cat ys z) o)),
     (r z (isT-plusS y0 ys ty) (tail-nz y0 ys ty) (ot-plusS y0 (cat ys z) o)).2) ;
  phi x0 x1 -> \ z ty hy o -> (ot-plus0 (phi x0 x1) z o, ot-plusS (phi x0 x1) z o) ;
  psi x0 x1 -> \ z ty hy o -> (ot-plus0 (psi x0 x1) z o, ot-plusS (psi x0 x1) z o) ;
  om x0 -> \ z ty hy o -> (ot-plus0 (om x0) z o, ot-plusS (om x0) z o) ;
  ii -> \ z ty hy o -> (ot-plus0 ii z o, ot-plusS ii z o) } ;

rem212d (x y z : T) (ty : TT y) : Dec x y z -> OK y * OK z = split {
  dsum h -> cat-OK y z ty h.2.2.2.1 (subst OK h.1 h.2.2.2.2.2) ;
  dphi h -> (ot-phi0 y z (subst OK h.1 h.2), ot-phi1 y z (subst OK h.1 h.2)) ;
  dom h e -> (ot-om0 y (subst OK h.1 h.2), subst OK e (ot-om0 y (subst OK h.1 h.2))) ;
  dpsi h -> (ot-psi0 y z (subst OK h.1 h.2), ot-psi1 y z (subst OK h.1 h.2)) } ;

------------------------------------------------------------------------
-- Remark 2.12(b): every x in OT is 0, I, or, for some y, z in OT,
-- x =NF' y+z, x =NF phi_y z, x =NF Omega_y, x =NF psi_y z.
-- A sum (x0, xs) is cat y z with z its last summand (last-split, by
-- induction on xs); y, z in OT by (d).

data NFof (x : T) : U j = isz (h : Tr (isZero x)) | isii (h : Id T x ii)
  | nsum (y z : T) (oy : OK y) (oz : OK z) (h : NFsum' x y z)
  | nphi (y z : T) (oy : OK y) (oz : OK z) (h : NFphi x y z)
  | nom (y : T) (oy : OK y) (h : NFom x y)
  | npsi (y z : T) (oy : OK y) (oz : OK z) (h : NFpsi x y z) ;

Last (x : T) : U j = (y : T) * ((z : T) * (Id T x (cat y z) * (TT y * (NZ y * (TT z * Tr (isA z)))))) ;

cat-A : (g : T) -> Tr (isA g) -> (z : T) -> Id T (cat g z) (plus g z) = split {
  zero -> \ h z -> abF h ; plus x0 xs -> \ h z -> abF h ;
  phi x0 x1 -> \ h z -> refl (plus (phi x0 x1) z) ; psi x0 x1 -> \ h z -> refl (plus (psi x0 x1) z) ;
  om x0 -> \ h z -> refl (plus (om x0) z) ; ii -> \ h z -> refl (plus ii z) } ;

last-A (x0 g : T) (t : TT (plus x0 g)) (hg : Tr (isA g)) : Last (plus x0 g) =
  (x0, (g, (sym (cat-A x0 (isT-plusA x0 g t) g), (isT-plus0 x0 g t, (A-nz x0 (isT-plusA x0 g t), (isT-plusS x0 g t, hg)))))) ;

last-P (x0 : T) (w : T) (t : TT (plus x0 w)) (l : Last w) : Last (plus x0 w) =
  (plus x0 l.1, (l.2.1, (ap (\ s -> plus x0 s) l.2.2.1,
    (andI (and (isA x0) (isT x0)) (and (not (isZero l.1)) (isT l.1))
       (andI (isA x0) (isT x0) (isT-plusA x0 w t) (isT-plus0 x0 w t))
       (andI (not (isZero l.1)) (isT l.1) (ap not l.2.2.2.2.1) l.2.2.2.1),
     (refl false, l.2.2.2.2.2))))) ;

last-split : (xs x0 : T) -> TT (plus x0 xs) -> Last (plus x0 xs) = split {
  zero -> \ x0 t -> abT (tail-nz x0 zero t) ;
  plus y0 ys | _ r -> \ x0 t -> last-P x0 (plus y0 ys) t (r y0 (isT-plusS x0 (plus y0 ys) t)) ;
  phi a b -> \ x0 t -> last-A x0 (phi a b) t (refl true) ;
  psi a b -> \ x0 t -> last-A x0 (psi a b) t (refl true) ;
  om a -> \ x0 t -> last-A x0 (om a) t (refl true) ;
  ii -> \ x0 t -> last-A x0 ii t (refl true) } ;

nf-sum (x : T) (o : OK x) (l : Last x) : NFof x =
  nsum l.1 l.2.1
    (cat-OK l.1 l.2.1 l.2.2.2.1 l.2.2.2.2.1 (subst OK l.2.2.1 o)).1
    (cat-OK l.1 l.2.1 l.2.2.2.1 l.2.2.2.2.1 (subst OK l.2.2.1 o)).2
    ((l.2.2.1, (l.2.2.2.1, (l.2.2.2.2.2.1, (l.2.2.2.2.1, (A-nz l.2.1 l.2.2.2.2.2.2, o))))), l.2.2.2.2.2.2) ;

rem212b : (x : T) -> OK x -> NFof x = split {
  zero -> \ o -> isz (refl true) ;
  plus x0 xs -> \ o -> nf-sum (plus x0 xs) o (last-split xs x0 (ot-T (plus x0 xs) o)) ;
  phi y z -> \ o -> nphi y z (ot-phi0 y z o) (ot-phi1 y z o) (refl (phi y z), o) ;
  psi y z -> \ o -> npsi y z (ot-psi0 y z o) (ot-psi1 y z o) (refl (psi y z), o) ;
  om y -> \ o -> nom y (ot-om0 y o) (refl (om y), o) ;
  ii -> \ o -> isii (refl ii) } ;

------------------------------------------------------------------------
-- Remark 2.12(c): x, y, z in T', x =NF y+z (or phi_y z, Omega_y with y = z,
-- psi_y z)  =>  length(y) < length(x) and length(z) < length(x).
-- length counts the constructors (as tools/otfun.py).  For a sum,
-- length(cat y z) = 1 + length(y) + length(z) for y /= 0 in T', by induction
-- on y (the tail of y is then /= 0).

nadd : N -> N -> N = split { nz -> \ m -> m ; ns k | r -> \ m -> ns (r m) } ;

sucN (w : N) : N = ns w ;

-- a < b:  b = 1 + k + a for some k
NLt (a b : N) : U j = (k : N) * Id N b (ns (nadd k a)) ;

nadd-z : (a : N) -> Id N (nadd a nz) a = split { nz -> refl nz ; ns k | r -> ap sucN r } ;
nadd-s : (a b : N) -> Id N (nadd a (ns b)) (ns (nadd a b)) = split {
  nz -> \ b -> refl (ns b) ; ns k | r -> \ b -> ap sucN (r b) } ;
nadd-comm : (a b : N) -> Id N (nadd a b) (nadd b a) = split {
  nz -> \ b -> sym (nadd-z b) ;
  ns k | r -> \ b -> trans (ap sucN (r b)) (sym (nadd-s b k)) } ;
nadd-assoc : (a b c : N) -> Id N (nadd (nadd a b) c) (nadd a (nadd b c)) = split {
  nz -> \ b c -> refl (nadd b c) ; ns k | r -> \ b c -> ap sucN (r b c) } ;

lenT : T -> N = split {
  zero -> ns nz ;
  plus x0 xs | r0 rs -> ns (nadd r0 rs) ;
  phi x0 x1 | r0 r1 -> ns (nadd r0 r1) ;
  psi x0 x1 | r0 r1 -> ns (nadd r0 r1) ;
  om x0 | r0 -> ns r0 ;
  ii -> ns nz } ;

-- a, b < 1 + a + b
nlt-l (a b : N) : NLt a (ns (nadd a b)) = (b, ap sucN (nadd-comm a b)) ;
nlt-r (a b : N) : NLt b (ns (nadd a b)) = (a, refl (ns (nadd a b))) ;

len-cat : (y z : T) -> TT y -> NZ y -> Id N (lenT (cat y z)) (ns (nadd (lenT y) (lenT z))) = split {
  zero -> \ z ty h -> abT h ;
  plus y0 ys | _ r -> \ z ty h ->
    ap sucN (trans (ap (nadd (lenT y0)) (r z (isT-plusS y0 ys ty) (tail-nz y0 ys ty)))
               (trans (nadd-s (lenT y0) (nadd (lenT ys) (lenT z)))
                  (ap sucN (sym (nadd-assoc (lenT y0) (lenT ys) (lenT z)))))) ;
  phi x0 x1 -> \ z ty h -> refl (lenT (plus (phi x0 x1) z)) ;
  psi x0 x1 -> \ z ty h -> refl (lenT (plus (psi x0 x1) z)) ;
  om x0 -> \ z ty h -> refl (lenT (plus (om x0) z)) ;
  ii -> \ z ty h -> refl (lenT (plus ii z)) } ;

Len2 (x y z : T) : U j = NLt (lenT y) (lenT x) * NLt (lenT z) (lenT x) ;

len2-at (x x' y z : T) (e : Id T x x') (h : Len2 x' y z) : Len2 x y z = subst (\ s -> Len2 s y z) (sym e) h ;

rem212c (x y z : T) : Dec x y z -> Len2 x y z = split {
  dsum h -> len2-at x (cat y z) y z h.1
    (subst (\ m -> NLt (lenT y) m * NLt (lenT z) m) (sym (len-cat y z h.2.1 h.2.2.2.1))
       (nlt-l (lenT y) (lenT z), nlt-r (lenT y) (lenT z))) ;
  dphi h -> len2-at x (phi y z) y z h.1 (nlt-l (lenT y) (lenT z), nlt-r (lenT y) (lenT z)) ;
  dom h e -> len2-at x (om y) y z h.1 (subst (\ s -> Len2 (om y) y s) e ((nz, refl (ns (lenT y))), (nz, refl (ns (lenT y))))) ;
  dpsi h -> len2-at x (psi y z) y z h.1 (nlt-l (lenT y) (lenT z), nlt-r (lenT y) (lenT z)) } ;

------------------------------------------------------------------------
-- a + 1, for a in T'.
--   1 <=' g for every g in A n T' (nothing but 0 is below 1, OTC.one-min);
--   so (a0, as) + 1 = (a0, as + 1), g + 1 = (g, 1), and
--   G_k(a + 1) = G_k(a)  (G_k(1) = {}).

one-le (x : T) (tx : TT x) (hz : NZ x) : Tr (le one x) = nlt-le one x (refl true) tx (one-min x tx hz) ;

suc-P (x0 xs : T) (t : TT (plus x0 xs)) : Id T (suc (plus x0 xs)) (plus x0 (suc xs)) =
  ifT-t (le one x0) (plus x0 (suc xs)) one
    (one-le x0 (isT-plus0 x0 xs t) (A-nz x0 (isT-plusA x0 xs t))) ;

suc-A (g : T) (hA : Tr (isA g)) (tg : TT g) : Id T (suc g) (plus g one) =
  trans (add-A g one (refl false) (addA g hA one)) (ifT-t (le one g) (plus g one) one (one-le g tg (A-nz g hA))) ;

app-nil : (M : L) -> Id L (app M nil) M = split {
  nil -> refl nil ; cons h tl | r -> ap (\ N -> cons h N) r } ;

SucF (k a : T) : U j = TT (suc a) * Id L (G k (suc a)) (G k a) ;

suc-A-F (k g : T) (hA : Tr (isA g)) (tg : TT g) : SucF k g =
  subst (\ s -> TT s * Id L (G k s) (G k g)) (sym (suc-A g hA tg))
    (andI (and (isA g) (isT g)) (and (not (isZero one)) (isT one)) (andI (isA g) (isT g) hA tg) (refl true),
     app-nil (G k g)) ;

suc-F (k : T) : (a : T) -> TT a -> SucF k a = split {
  zero -> \ t -> (refl true, refl nil) ;
  plus x0 xs | _ r -> \ t ->
    subst (\ s -> TT s * Id L (G k s) (G k (plus x0 xs))) (sym (suc-P x0 xs t))
      (andI (and (isA x0) (isT x0)) (and (not (isZero (suc xs))) (isT (suc xs)))
         (andI (isA x0) (isT x0) (isT-plusA x0 xs t) (isT-plus0 x0 xs t))
         (andI (not (isZero (suc xs))) (isT (suc xs)) (ap not (add-nz xs one (refl false))) (r (isT-plusS x0 xs t)).1),
       ap (app (G k x0)) (r (isT-plusS x0 xs t)).2) ;
  phi a b -> \ t -> suc-A-F k (phi a b) (refl true) t ;
  psi a b -> \ t -> suc-A-F k (psi a b) (refl true) t ;
  om a -> \ t -> suc-A-F k (om a) (refl true) t ;
  ii -> \ t -> suc-A-F k ii (refl true) t } ;

suc-T (a : T) (t : TT a) : TT (suc a) = (suc-F zero a t).1 ;

------------------------------------------------------------------------
-- Remark 2.14(j): c <' d  =>  C~_b(c) is a subset of C~_b(d)  (c, d in T').
-- G_b(a) <' c <' d.

rem214j (b c d : T) (tc : TT c) (td : TT d) (h : LT c d) (a : T) (m : Tr (inC b c a)) : Tr (inC b d a) =
  andI (isT a) (allLt (G b a) d) (and-l (isT a) (allLt (G b a) c) m)
    (allLt-mono (G b a) c d (G-T b a (and-l (isT a) (allLt (G b a) c) m)) tc td (and-r (isT a) (allLt (G b a) c) m) h) ;

------------------------------------------------------------------------
-- Remark 2.14(k): a in C~_b(c) => a+1 in C~_b(c);  psi_a b in OT =>
-- psi_a (b+1) in OT.  G(a+1) = G(a); and G_a(b) <' b <' b+1 (2.12(h)).

rem214k1 (b c a : T) (m : Tr (inC b c a)) : Tr (inC b c (suc a)) =
  andI (isT (suc a)) (allLt (G b (suc a)) c) (suc-T a (and-l (isT a) (allLt (G b a) c) m))
    (subst (\ M -> Tr (allLt M c)) (sym (suc-F b a (and-l (isT a) (allLt (G b a) c) m)).2)
       (and-r (isT a) (allLt (G b a) c) m)) ;

rem214k2 (a b : T) (o : OK (psi a b)) : OK (psi a (suc b)) =
  andI (and (isR a) (isOT a)) (and (isOT (suc b)) (allLt (G a (suc b)) (suc b))) (ot-psiH a b o)
    (andI (isOT (suc b)) (allLt (G a (suc b)) (suc b)) (suc-OK b (ot-psi1 a b o))
       (subst (\ M -> Tr (allLt M (suc b))) (sym (suc-F a b (ot-T b (ot-psi1 a b o))).2)
          (ot4-mono a b (suc b) o (suc-T b (ot-T b (ot-psi1 a b o)))
             (lt-add-l b (ot-psi1 a b o) one (refl true) (refl false))))) ;

------------------------------------------------------------------------
-- s = pred1 e for e in Suc n OT:  s in OT and s + 1 = e.
-- By induction on e.  e = 1: s = 0.  e = (x0, 1): s = x0, x0 + 1 = (x0, 1).
-- e = (x0, xs), xs /= 1: s = (x0, p), p = pred1 xs; p /= 0, p <' xs so
-- hd(p) <=' hd(xs) <=' x0 (hd-mono), and (x0, p) + 1 = (x0, p + 1).

iteG (A : U j) (P : A -> U j) : (u : Bool) -> (x y : A) -> (Tr u -> P x) -> (Id Bool u false -> P y) -> P (ite A u x y) = split {
  false -> \ x y f g -> g (refl false) ; true -> \ x y f g -> f (refl true) } ;
-- the same for ifQ
ifQ-G (P : C4 -> U j) : (u : Bool) -> (x y : C4) -> (Tr u -> P x) -> (Id Bool u false -> P y) -> P (ifQ u x y) = split {
  false -> \ x y f g -> g (refl false) ; true -> \ x y f g -> f (refl true) } ;

-- p <' q, p /= 0  =>  hd(p) <=' hd(q)
hd-mono (p q : T) (op : OK p) (oq : OK q) (nzp : NZ p) (h : LT p q) : Tr (le (hd p) (hd q)) =
  nlt-le (hd p) (hd q) (ot-T (hd p) (hd-OK p op)) (ot-T (hd q) (hd-OK q oq))
    (boolCases (Id Bool (lt (hd q) (hd p)) false) (lt (hd q) (hd p))
       (\ c -> asym-abs (Id Bool (lt (hd q) (hd p)) false) p q (ot-T p op) (ot-T q oq) h (hd-lt q p nzp c))
       (\ c -> c)) ;

SP (e : T) : U j = OK (pred1 e) * Id T (suc (pred1 e)) e ;

sp-ok (x0 xs : T) (o : OK (plus x0 xs)) (hs : Tr (isSuc xs)) (ho : Id Bool (isOne xs) false) (ih : SP xs)
  : OK (plus x0 (pred1 xs)) =
  ot-plusI x0 (pred1 xs) (ot-plusA x0 xs o) (ot-plus0 x0 xs o)
    (pred-lt xs (ot-T xs (ot-plusS x0 xs o)) hs ho).2.2.2 ih.1
    (le-trans (hd (pred1 xs)) (hd xs) x0
       (tr3 (hd (pred1 xs)) (hd xs) x0 (ot-T (hd (pred1 xs)) (hd-OK (pred1 xs) ih.1))
          (ot-T (hd xs) (hd-OK xs (ot-plusS x0 xs o))) (ot-T x0 (ot-plus0 x0 xs o)))
       (hd-mono (pred1 xs) xs ih.1 (ot-plusS x0 xs o) (pred-lt xs (ot-T xs (ot-plusS x0 xs o)) hs ho).2.2.2
          (pred-lt xs (ot-T xs (ot-plusS x0 xs o)) hs ho).1)
       (ot-plusLe x0 xs o)) ;

sp-step (x0 xs : T) (o : OK (plus x0 xs)) (hs : Tr (isSuc xs)) (ho : Id Bool (isOne xs) false) (ih : SP xs)
  : OK (plus x0 (pred1 xs)) * Id T (suc (plus x0 (pred1 xs))) (plus x0 xs) =
  (sp-ok x0 xs o hs ho ih,
   trans (suc-P x0 (pred1 xs) (ot-T (plus x0 (pred1 xs)) (sp-ok x0 xs o hs ho ih))) (ap (\ s -> plus x0 s) ih.2)) ;

suc-pred : (e : T) -> OK e -> Tr (isSuc e) -> SP e = split {
  zero -> \ o hs -> abF hs ;
  plus x0 xs | _ r -> \ o hs ->
    boolCases (SP (plus x0 xs)) (isOne xs)
      (\ ho -> subst (\ s -> OK s * Id T (suc s) (plus x0 xs)) (sym (ifT-t (isOne xs) x0 (plus x0 (pred1 xs)) ho))
         (ot-plus0 x0 xs o,
          trans (suc-A x0 (ot-plusA x0 xs o) (ot-T x0 (ot-plus0 x0 xs o))) (ap (\ s -> plus x0 s) (sym (one-eq xs ho)))))
      (\ ho -> subst (\ s -> OK s * Id T (suc s) (plus x0 xs)) (sym (ifT-f (isOne xs) x0 (plus x0 (pred1 xs)) ho))
         (sp-step x0 xs o hs ho (r (ot-plusS x0 xs o) hs))) ;
  phi a b -> \ o hs -> (refl true, sym (one-eq-phi a b hs)) ;
  psi a b -> \ o hs -> abF hs ; om a -> \ o hs -> abF hs ; ii -> \ o hs -> abF hs } ;

-- a successor is moved by Omega
suc-fx : (e : T) -> Tr (isSuc e) -> Id Bool (fx e) false = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> refl false ; phi a b -> \ h -> refl false ;
  psi a b -> \ h -> abF h ; om a -> \ h -> abF h ; ii -> \ h -> abF h } ;

------------------------------------------------------------------------
-- Remark 2.14(a), (e), (f): the values of 2.13(b) on OT.
--   (a) x~, x+, x^-Fi, x^+Fi, x^-I in OT;
--   (e) (x~)+ = x+;
--   (f) for some y in OT: x~ = Omega_y, x+ = Omega_{y+1}, x~ <=' x <' x+.
-- By induction on x, following the clauses of 2.13(b); each statement is
-- written on the four values c = card x (OK4, E4, F1c), so the phi'_b c
-- case is the hypothesis at b or at c.  The clause psi_b c, b /= I, uses
-- b = Omega'_e, e in Suc:  b^- = Omega_s with s = pred1 e in OT, s+1 = e
-- (suc-pred), so b^- is Omega_s and b = Omega_{s+1}; and (b^-)+ = b, as
-- (Omega_s)+ = Omega_{s+1} for every s (up-omF).
-- (f), x~ <=' x <' x+:  0 <' Omega_1;  a sum is between its head and the
-- head's x+ (x+ is in G');  phi'_b c lies between max{b,c}~ and max{b,c}+
-- (phi-below, (4));  psi_b c, b /= I: b^- <' psi_b c <' b (OTC.km-lt, (6));
-- psi_I c <' Omega'_{psi_I c + 1} (7);  Omega'_b <' Omega'_{b+1} (9);
-- I <' Omega'_{I+1} (10).

tildeOf (c : C4) : T = c.1 ;
upOf (c : C4) : T = c.2.1 ;

OK4 (c : C4) : U j = OK c.1 * (OK c.2.1 * (OK c.2.2.1 * OK c.2.2.2)) ;

-- b = Omega'_e in R n OT
RS (b : T) : U j = (e : T) * (Id T b (om e) * (OK (om e) * Tr (isSuc e))) ;
r-split (b : T) (ob : OK b) (hR : Tr (isR b)) (hi : Id Bool (isI b) false) : RS b =
  (arg b, ((R-cases b hR hi).1, (subst OK (R-cases b hR hi).1 ob, (R-cases b hR hi).2))) ;

km-OK (b : T) (r : RS b) : OK (kminus b) =
  subst (\ q -> OK (kminus q)) (sym r.2.1) (omF-OK (pred1 r.1) (suc-pred r.1 (ot-om0 r.1 r.2.2.1) r.2.2.2).1) ;

-- the clause psi_b c, b /= I, of R-terms:  b in R n OT
rs-psi (b c : T) (o : OK (psi b c)) (hi : Id Bool (isI b) false) : RS b = r-split b (ot-psi0 b c o) (ot-psiR b c o) hi ;

card-OK : (x : T) -> OK x -> OK4 (card x) = split {
  zero -> \ o -> (refl true, (refl true, (refl true, refl true))) ;
  plus x0 xs | r0 _ -> \ o -> r0 (ot-plus0 x0 xs o) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G OK4 (le x1 x0) (card x0) (card x1)
    (\ h -> r0 (ot-phi0 x0 x1 o)) (\ h -> r1 (ot-phi1 x0 x1 o)) ;
  psi x0 x1 | r0 _ -> \ o -> ifQ-G OK4 (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> (o, (omF-OK (suc (psi x0 x1)) (suc-OK (psi x0 x1) o),
              (o, subst (\ q -> OK (psi q (suc x1))) (isI-true x0 hi) (rem214k2 x0 x1 o)))))
    (\ hi -> (km-OK x0 (rs-psi x0 x1 o hi), (ot-psi0 x0 x1 o, (r0 (ot-psi0 x0 x1 o)).2.2))) ;
  om x0 | r0 -> \ o -> (o, (omF-OK (suc x0) (suc-OK x0 (ot-om0 x0 o)), (r0 (ot-om0 x0 o)).2.2)) ;
  ii -> \ o -> (refl true, (refl true, (refl true, refl true))) } ;

mI-OK (a : T) : OK (mI a) = iteC OK (lt a ii) zero ii (\ h -> refl true) (\ h -> refl true) ;

rem214a (x : T) (o : OK x) : OK (tilde x) * (OK (up x) * (OK (mFi x) * (OK (pFi x) * OK (mI x)))) =
  ((card-OK x o).1, ((card-OK x o).2.1, ((card-OK x o).2.2.1, ((card-OK x o).2.2.2, mI-OK x)))) ;

-- (e)
up-omF : (s : T) -> Id T (up (omF s)) (omF (suc s)) = split {
  zero -> refl (om one) ;
  plus x0 xs -> refl (omF (suc (plus x0 xs))) ;
  phi x0 x1 -> refl (omF (suc (phi x0 x1))) ;
  psi p c -> iteC (\ t -> Id T (up t) (omF (suc (psi p c)))) (isI p) (psi p c) (om (psi p c))
    (\ hi -> ap upOf (ifQ-t (isI p) (psi p c, (omF (suc (psi p c)), (psi p c, psi ii (suc c))))
                        (cardS p (card p)) hi))
    (\ hi -> refl (omF (suc (psi p c)))) ;
  om a -> refl (omF (suc (om a))) ;
  ii -> refl (omF (suc ii)) } ;

-- Omega'_e = Omega_{s+1}, s = pred1 e
om-suc-pred (e : T) (oe : OK (om e)) (hs : Tr (isSuc e)) : Id T (omF (suc (pred1 e))) (om e) =
  trans (ap omF (suc-pred e (ot-om0 e oe) hs).2) (omF-mov e (suc-fx e hs)) ;

-- (b^-)+ = b
km-up (b : T) (r : RS b) : Id T (up (kminus b)) b =
  subst (\ q -> Id T (up (kminus q)) q) (sym r.2.1) (trans (up-omF (pred1 r.1)) (om-suc-pred r.1 r.2.2.1 r.2.2.2)) ;

E4 (c : C4) : U j = Id T (up c.1) c.2.1 ;

card-E : (x : T) -> OK x -> E4 (card x) = split {
  zero -> \ o -> refl (om one) ;
  plus x0 xs | r0 _ -> \ o -> r0 (ot-plus0 x0 xs o) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G E4 (le x1 x0) (card x0) (card x1)
    (\ h -> r0 (ot-phi0 x0 x1 o)) (\ h -> r1 (ot-phi1 x0 x1 o)) ;
  psi x0 x1 -> \ o -> ifQ-G E4 (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> ap upOf (ifQ-t (isI x0) (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1))))
                        (cardS x0 (card x0)) hi))
    (\ hi -> km-up x0 (rs-psi x0 x1 o hi)) ;
  om x0 -> \ o -> refl (omF (suc x0)) ;
  ii -> \ o -> refl (omF (suc ii)) } ;

rem214e (x : T) (o : OK x) : Id T (up (tilde x)) (up x) = card-E x o ;

-- (f), first half: x~ = Omega_y and x+ = Omega_{y+1} for some y in OT
F1c (c : C4) : U j = (y : T) * (OK y * (Id T c.1 (omF y) * Id T c.2.1 (omF (suc y)))) ;

km-F1 (b : T) (r : RS b) (cb : C4) : F1c (cardS b cb) =
  subst (\ q -> F1c (cardS q cb)) (sym r.2.1)
    (pred1 r.1, ((suc-pred r.1 (ot-om0 r.1 r.2.2.1) r.2.2.2).1,
      (refl (omF (pred1 r.1)), sym (om-suc-pred r.1 r.2.2.1 r.2.2.2)))) ;

om-mov (x0 : T) (o : OK (om x0)) : Id Bool (fx x0) false =
  ap2 or (not-true (isFi x0) (and-r (isOT x0) (not (isFi x0)) (and-l (and (isOT x0) (not (isFi x0))) (not (isZero x0)) o)))
         (not-true (isZero x0) (ot-omZ x0 o)) ;

card-F1 : (x : T) -> OK x -> F1c (card x) = split {
  zero -> \ o -> (zero, (refl true, (refl zero, refl (om one)))) ;
  plus x0 xs | r0 _ -> \ o -> r0 (ot-plus0 x0 xs o) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G F1c (le x1 x0) (card x0) (card x1)
    (\ h -> r0 (ot-phi0 x0 x1 o)) (\ h -> r1 (ot-phi1 x0 x1 o)) ;
  psi x0 x1 -> \ o -> ifQ-G F1c (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> (psi x0 x1, (o, (sym (omF-fix (psi x0 x1) (trans (orF (isI x0)) hi)), refl (omF (suc (psi x0 x1)))))))
    (\ hi -> km-F1 x0 (rs-psi x0 x1 o hi) (card x0)) ;
  om x0 -> \ o -> (x0, (ot-om0 x0 o, (sym (omF-mov x0 (om-mov x0 o)), refl (omF (suc x0))))) ;
  ii -> \ o -> (ii, (refl true, (refl ii, refl (omF (suc ii))))) } ;

-- (f), second half: x~ <=' x <' x+
omF-G : (y : T) -> NZ y -> Tr (isG (omF y)) = split {
  zero -> \ h -> abT h ; plus x0 xs -> \ h -> refl true ; phi x0 x1 -> \ h -> refl true ;
  psi p c -> \ h -> iteC (\ t -> Tr (isG t)) (isI p) (psi p c) (om (psi p c)) (\ q -> refl true) (\ q -> refl true) ;
  om a -> \ h -> refl true ; ii -> \ h -> refl true } ;

R-G : (q : T) -> Tr (isR q) -> Tr (isG q) = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> abF h ;
  psi x0 x1 -> \ h -> abF h ; om x0 -> \ h -> refl true ; ii -> \ h -> refl true } ;

G4 (c : C4) : U j = Tr (isG c.2.1) ;

card-G : (x : T) -> OK x -> G4 (card x) = split {
  zero -> \ o -> refl true ;
  plus x0 xs | r0 _ -> \ o -> r0 (ot-plus0 x0 xs o) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G G4 (le x1 x0) (card x0) (card x1)
    (\ h -> r0 (ot-phi0 x0 x1 o)) (\ h -> r1 (ot-phi1 x0 x1 o)) ;
  psi x0 x1 -> \ o -> ifQ-G G4 (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> omF-G (suc (psi x0 x1)) (add-nz (psi x0 x1) one (refl false)))
    (\ hi -> R-G x0 (ot-psiR x0 x1 o)) ;
  om x0 -> \ o -> omF-G (suc x0) (add-nz x0 one (refl false)) ;
  ii -> \ o -> refl true } ;

G-A : (g : T) -> Tr (isG g) -> Tr (isA g) = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> abF h ;
  psi x0 x1 -> \ h -> refl true ; om x0 -> \ h -> refl true ; ii -> \ h -> refl true } ;

-- a + 1 is a sum for a /= 0 in T', so it is moved by Omega
sfx : (a : T) -> TT a -> NZ a -> Id Bool (fx (suc a)) false = split {
  zero -> \ t hz -> abT hz ;
  plus x0 xs -> \ t hz -> ap fx (suc-P x0 xs t) ;
  phi x0 x1 -> \ t hz -> ap fx (suc-A (phi x0 x1) (refl true) t) ;
  psi x0 x1 -> \ t hz -> ap fx (suc-A (psi x0 x1) (refl true) t) ;
  om x0 -> \ t hz -> ap fx (suc-A (om x0) (refl true) t) ;
  ii -> \ t hz -> ap fx (suc-A ii (refl true) t) } ;

-- Omega_{a+1} = Omega'_{a+1} for a /= 0 in T'
omF-suc (a : T) (ta : TT a) (hz : NZ a) : Id T (omF (suc a)) (om (suc a)) =
  omF-mov (suc a) (sfx a ta hz) ;

F2 (x : T) (c : C4) : U j = Tr (le c.1 x) * LT x c.2.1 ;

f2-psiS (b c : T) (r : RS b) : F2 (psi b c) (cardS b (card b)) =
  subst (\ q -> F2 (psi q c) (cardS q (card q))) (sym r.2.1)
    (le-of-lt (kminus (om r.1)) (psi (om r.1) c) ((km-lt r.1 (ot-T r.1 (ot-om0 r.1 r.2.2.1)) r.2.2.2).2 c),
     trans (lex-SO (om r.1) c r.1 (refl false))
       (orIr (lt (om r.1) (om r.1)) (and (eqT (om r.1) (om r.1)) true) (andI (eqT (om r.1) (om r.1)) true (eqT-refl (om r.1)) (refl true)))) ;

f2-psiI (b c : T) (o : OK (psi b c)) (hi : Tr (isI b)) : F2 (psi b c) (psi b c, (omF (suc (psi b c)), (psi b c, psi ii (suc c)))) =
  (le-refl (psi b c),
   subst (\ t -> LT (psi b c) t) (sym (omF-suc (psi b c) (ot-T (psi b c) o) (refl false)))
     (trans (lex-TO b c (suc (psi b c)) hi)
        (orIl (lt (psi b c) (suc (psi b c))) (and (eqT (psi b c) (suc (psi b c))) true)
           (lt-add-l (psi b c) o one (refl true) (refl false))))) ;

card-F2 : (x : T) -> OK x -> F2 x (card x) = split {
  zero -> \ o -> (le-refl zero, refl true) ;
  plus x0 xs | r0 _ -> \ o ->
    (le-trans (tilde x0) x0 (plus x0 xs)
       (tr3 (tilde x0) x0 (plus x0 xs) (ot-T (tilde x0) (card-OK x0 (ot-plus0 x0 xs o)).1) (ot-T x0 (ot-plus0 x0 xs o)) (ot-T (plus x0 xs) o))
       (r0 (ot-plus0 x0 xs o)).1 (le-of-lt x0 (plus x0 xs) (lt-head x0 xs (ot-plusA x0 xs o))),
     trans (lt-hd (plus x0 xs) (up x0) (G-A (up x0) (card-G x0 (ot-plus0 x0 xs o)))) (r0 (ot-plus0 x0 xs o)).2) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G (F2 (phi x0 x1)) (le x1 x0) (card x0) (card x1)
    (\ h -> (le-trans (tilde x0) x0 (phi x0 x1)
               (tr3 (tilde x0) x0 (phi x0 x1) (ot-T (tilde x0) (card-OK x0 (ot-phi0 x0 x1 o)).1) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T (phi x0 x1) o))
               (r0 (ot-phi0 x0 x1 o)).1
               (le-of-lt x0 (phi x0 x1) ((phi-below x0).1 x0 x1 (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) (le-refl x0))),
             fg-intro x0 x1 (up x0) (card-G x0 (ot-phi0 x0 x1 o)) (r0 (ot-phi0 x0 x1 o)).2
               (le-lt x1 x0 (up x0)
                  (tr3 x1 x0 (up x0) (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T (up x0) (card-OK x0 (ot-phi0 x0 x1 o)).2.1))
                  h (r0 (ot-phi0 x0 x1 o)).2)))
    (\ h -> (le-trans (tilde x1) x1 (phi x0 x1)
               (tr3 (tilde x1) x1 (phi x0 x1) (ot-T (tilde x1) (card-OK x1 (ot-phi1 x0 x1 o)).1) (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T (phi x0 x1) o))
               (r1 (ot-phi1 x0 x1 o)).1
               (le-of-lt x1 (phi x0 x1) ((phi-below x1).2 x0 x1 (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) (le-refl x1))),
             fg-intro x0 x1 (up x1) (card-G x1 (ot-phi1 x0 x1 o))
               (tr3 x0 x1 (up x1) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T (up x1) (card-OK x1 (ot-phi1 x0 x1 o)).2.1)
                  (nle-lt' x1 x0 (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) h) (r1 (ot-phi1 x0 x1 o)).2)
               (r1 (ot-phi1 x0 x1 o)).2)) ;
  psi x0 x1 -> \ o -> ifQ-G (F2 (psi x0 x1)) (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> f2-psiI x0 x1 o hi) (\ hi -> f2-psiS x0 x1 (rs-psi x0 x1 o hi)) ;
  om x0 -> \ o ->
    (le-refl (om x0),
     subst (\ t -> LT (om x0) t) (sym (omF-suc x0 (ot-T x0 (ot-om0 x0 o)) (not-true (isZero x0) (ot-omZ x0 o))))
       (trans (lex-OO x0 (suc x0))
          (orIl (lt x0 (suc x0)) (and (eqT x0 (suc x0)) false) (lt-add-l x0 (ot-om0 x0 o) one (refl true) (refl false))))) ;
  ii -> \ o -> (le-refl ii, refl true) } ;

rem214f (x : T) (o : OK x)
  : (y : T) * (OK y * (Id T (tilde x) (omF y) * (Id T (up x) (omF (suc y)) * (Tr (le (tilde x) x) * LT x (up x))))) =
  ((card-F1 x o).1, ((card-F1 x o).2.1, ((card-F1 x o).2.2.1, ((card-F1 x o).2.2.2, card-F2 x o)))) ;

------------------------------------------------------------------------
-- Remark 2.14(g): x^-Fi, x^+Fi in the three regions below psi_I 0, between
-- psi_I 0 and I, above I.
--
-- By induction on x, one of three states holds for m = x^-Fi, p = x^+Fi:
--   st0:  m = 0, p = psi_I 0, x <' psi_I 0;
--   st1:  m = psi_I y, p = psi_I (y+1), psi_I y in OT, m <=' x <' p;
--   st2:  m = p = I, I <=' x.
-- 0: st0.  I: st2.  psi_I c: st1 with y = c (c <' c+1).  A sum, phi'_b c,
-- Omega'_b take the state of a part u <=' x (the head, max{b,c}, b) with
-- "u <' g => x <' g" for g in Fi' (clause (2), (4), and (7)/(11):
-- Omega'_b <' g iff b <' g, 2.12(g)) (fi-lift).  psi_b c, b /= I, takes the
-- state of b >' psi_b c: x <' b <' p;  m <=' b, m in Fi', so m <' b and
-- m <' psi_b c by (5);  I <=' b /= I gives I <' psi_b c by (6), (11).
-- Then (g): the three regions are disjoint (psi_I 0 <=' psi_I y, psi_I (y+1) <' I).

data FiSt (x m p : T) : U j =
    st0 (hm : Id T m zero) (hp : Id T p (psi ii zero)) (h : LT x (psi ii zero))
  | st1 (y : T) (oy : OK (psi ii y)) (hm : Id T m (psi ii y)) (hp : Id T p (psi ii (suc y)))
        (h1 : Tr (le m x)) (h2 : LT x p)
  | st2 (hm : Id T m ii) (hp : Id T p ii) (h : Tr (le ii x)) ;

FS (x : T) (c : C4) : U j = FiSt x c.2.2.1 c.2.2.2 ;

Fi-G : (g : T) -> Tr (isFi g) -> Tr (isG g) = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> abF h ;
  psi x0 x1 -> \ h -> refl true ; om x0 -> \ h -> abF h ; ii -> \ h -> refl true } ;

-- "u <' g => x <' g" for g in Fi'
Below (u x : T) : U j = (g : T) -> Tr (isFi g) -> TT g -> LT u g -> LT x g ;

psiS-T (y : T) (oy : OK (psi ii y)) : TT (psi ii (suc y)) = ot-T (psi ii (suc y)) (rem214k2 ii y oy) ;

fi-lift (x u m p : T) (tx : TT x) (tu : TT u) (hux : Tr (le u x)) (k : Below u x) : FiSt u m p -> FiSt x m p = split {
  st0 hm hp h -> st0 hm hp (k (psi ii zero) (refl true) (refl true) h) ;
  st1 y oy hm hp h1 h2 -> st1 y oy hm hp
    (le-trans m u x (tr3 m u x (subst TT (sym hm) (ot-T (psi ii y) oy)) tu tx) h1 hux)
    (k p (subst (\ q -> Tr (isFi q)) (sym hp) (refl true)) (subst TT (sym hp) (psiS-T y oy)) h2) ;
  st2 hm hp h -> st2 hm hp (le-trans ii u x (tr3 ii u x (refl true) tu tx) h hux) } ;

-- psi_I y <=' b, b in R, b /= I  =>  psi_I y <' psi_b c   (by (5))
fi-m (b c y : T) (hR : Tr (isR b)) (hi : Id Bool (isI b) false) (h1 : Tr (le (psi ii y) b)) : LT (psi ii y) (psi b c) =
  trans (lex-TS ii y b c (refl true) hi)
    (orIl (lt (psi ii y) b) (and (eqT (psi ii y) b) false)
       (orE (LT (psi ii y) b) (lt (psi ii y) b) (eqT (psi ii y) b) h1 (\ q -> q)
          (\ q -> abT (trans (sym (trans (eqT-sym b (psi ii y)) q)) (R-notpsi b hR ii y))))) ;

-- psi_b c with b = Omega'_e, from the state of b
fi-psiS (b c m p : T) (tb : TT b) (hR : Tr (isR b)) (tx : TT (psi b c)) (hi : Id Bool (isI b) false) (hx : LT (psi b c) b)
  : FiSt b m p -> FiSt (psi b c) m p = split {
  st0 hm hp h -> st0 hm hp (tr3 (psi b c) b (psi ii zero) tx tb (refl true) hx h) ;
  st1 y oy hm hp h1 h2 -> st1 y oy hm hp
    (subst (\ q -> Tr (le q (psi b c))) (sym hm)
       (le-of-lt (psi ii y) (psi b c) (fi-m b c y hR hi (subst (\ q -> Tr (le q b)) hm h1))))
    (tr3 (psi b c) b p tx tb (subst TT (sym hp) (psiS-T y oy)) hx h2) ;
  st2 hm hp h -> st2 hm hp
    (le-of-lt ii (psi b c)
       (trans (lex-IS b c tb hi)
          (orIl (lt ii b) (and (eqT ii b) false)
             (orE (LT ii b) (lt ii b) (eqT ii b) h (\ q -> q)
                (\ q -> abT (trans (ap isI (eqT-sound ii b q)) hi)))))) } ;

card-FS : (x : T) -> OK x -> FS x (card x) = split {
  zero -> \ o -> st0 (refl zero) (refl (psi ii zero)) (refl true) ;
  plus x0 xs | r0 _ -> \ o ->
    fi-lift (plus x0 xs) x0 (mFi x0) (pFi x0) (ot-T (plus x0 xs) o) (ot-T x0 (ot-plus0 x0 xs o))
      (le-of-lt x0 (plus x0 xs) (lt-head x0 xs (ot-plusA x0 xs o)))
      (\ g hg tg h -> trans (lt-hd (plus x0 xs) g (G-A g (Fi-G g hg))) h)
      (r0 (ot-plus0 x0 xs o)) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G (FS (phi x0 x1)) (le x1 x0) (card x0) (card x1)
    (\ h10 -> fi-lift (phi x0 x1) x0 (mFi x0) (pFi x0) (ot-T (phi x0 x1) o) (ot-T x0 (ot-phi0 x0 x1 o))
       (le-of-lt x0 (phi x0 x1) ((phi-below x0).1 x0 x1 (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) (le-refl x0)))
       (\ g hg tg h -> fg-intro x0 x1 g (Fi-G g hg) h
          (le-lt x1 x0 g (tr3 x1 x0 g (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) tg) h10 h))
       (r0 (ot-phi0 x0 x1 o)))
    (\ h10 -> fi-lift (phi x0 x1) x1 (mFi x1) (pFi x1) (ot-T (phi x0 x1) o) (ot-T x1 (ot-phi1 x0 x1 o))
       (le-of-lt x1 (phi x0 x1) ((phi-below x1).2 x0 x1 (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) (le-refl x1)))
       (\ g hg tg h -> fg-intro x0 x1 g (Fi-G g hg)
          (tr3 x0 x1 g (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) tg
             (nle-lt' x1 x0 (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) h10) h) h)
       (r1 (ot-phi1 x0 x1 o))) ;
  psi x0 x1 | r0 _ -> \ o -> ifQ-G (FS (psi x0 x1)) (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> subst (\ q -> FiSt (psi q x1) (psi q x1) (psi ii (suc x1))) (sym (isI-true x0 hi))
       (st1 x1 (subst (\ q -> OK (psi q x1)) (isI-true x0 hi) o) (refl (psi ii x1)) (refl (psi ii (suc x1)))
          (le-refl (psi ii x1))
          (trans (lt-TT ii x1 ii (suc x1) (refl true) (refl true)) (lt-add-l x1 (ot-psi1 x0 x1 o) one (refl true) (refl false)))))
    (\ hi -> fi-psiS x0 x1 (mFi x0) (pFi x0) (ot-T x0 (ot-psi0 x0 x1 o)) (ot-psiR x0 x1 o) (ot-T (psi x0 x1) o) hi
       (f2-psiS x0 x1 (rs-psi x0 x1 o hi)).2 (r0 (ot-psi0 x0 x1 o))) ;
  om x0 | r0 -> \ o ->
    fi-lift (om x0) x0 (mFi x0) (pFi x0) (ot-T (om x0) o) (ot-T x0 (ot-om0 x0 o))
      (le-of-lt x0 (om x0) (lt-om x0 (ot-om0 x0 o)))
      (\ g hg tg h -> trans (mov-fix x0 (ot-T x0 (ot-om0 x0 o)) g tg (orIl (isFi g) (isZero g) hg)) h)
      (r0 (ot-om0 x0 o)) ;
  ii -> \ o -> st2 (refl ii) (refl ii) (le-refl ii) } ;

le-psiI0 (y : T) : Tr (le (psi ii zero) (psi ii y)) =
  trans (ap (\ w -> or w (eqT zero y)) (lt-TT ii zero ii y (refl true) (refl true))) (zero-le-any y) ;

-- the regions are disjoint
fi-not-below (x y : T) (tx : TT x) (oy : OK (psi ii y)) (h1 : Tr (le (psi ii y) x)) (h : LT x (psi ii zero)) : Id Bool true false =
  sym (trans (sym (lt-irr (psi ii zero)))
         (le-lt (psi ii zero) x (psi ii zero) (tr3 (psi ii zero) x (psi ii zero) (refl true) tx (refl true))
            (le-trans (psi ii zero) (psi ii y) x (tr3 (psi ii zero) (psi ii y) x (refl true) (ot-T (psi ii y) oy) tx) (le-psiI0 y) h1)
            h)) ;

G1 (x m p : T) : U j = Id T m zero * Id T p (psi ii zero) ;
g1-of (x m p : T) (tx : TT x) (h : LT x (psi ii zero)) : FiSt x m p -> G1 x m p = split {
  st0 hm hp h0 -> (hm, hp) ;
  st1 y oy hm hp h1 h2 -> abT (fi-not-below x y tx oy (subst (\ q -> Tr (le q x)) hm h1) h) ;
  st2 hm hp h2 -> abF (le-lt ii x (psi ii zero) (tr3 ii x (psi ii zero) (refl true) tx (refl true)) h2 h) } ;

G2 (x m p : T) : U j = (y : T) * (OK y * (Tr (inC ii y y) * (Id T m (psi ii y) * (Id T p (psi ii (suc y)) * (Tr (le m x) * LT x p))))) ;
g2-of (x m p : T) (tx : TT x) (h1 : Tr (le (psi ii zero) x)) (h2 : LT x ii) : FiSt x m p -> G2 x m p = split {
  st0 hm hp h -> abF (trans (sym (lt-irr x)) (lt-le x (psi ii zero) x (tr3 x (psi ii zero) x tx (refl true) tx) h h1)) ;
  st1 y oy hm hp k1 k2 -> (y, (ot-psi1 ii y oy, (andI (isT y) (allLt (G ii y) y) (ot-T y (ot-psi1 ii y oy)) (ot-psiG ii y oy),
                          (hm, (hp, (k1, k2)))))) ;
  st2 hm hp h -> abF (trans (sym (lt-irr ii)) (le-lt ii x ii (tr3 ii x ii (refl true) tx (refl true)) h h2)) } ;

G3 (x m p : T) : U j = Id T m ii * Id T p ii ;
g3-of (x m p : T) (tx : TT x) (h : Tr (le ii x)) : FiSt x m p -> G3 x m p = split {
  st0 hm hp h0 -> abF (le-lt ii x (psi ii zero) (tr3 ii x (psi ii zero) (refl true) tx (refl true)) h h0) ;
  st1 y oy hm hp k1 k2 -> abF (trans (sym (lt-IT ii (suc y) (refl true)))
       (le-lt ii x (psi ii (suc y)) (tr3 ii x (psi ii (suc y)) (refl true) tx (psiS-T y oy)) h
          (subst (\ q -> LT x q) hp k2))) ;
  st2 hm hp h0 -> (hm, hp) } ;

rem214g1 (x : T) (o : OK x) (h : LT x (psi ii zero)) : G1 x (mFi x) (pFi x) =
  g1-of x (mFi x) (pFi x) (ot-T x o) h (card-FS x o) ;
rem214g2 (x : T) (o : OK x) (h1 : Tr (le (psi ii zero) x)) (h2 : LT x ii) : G2 x (mFi x) (pFi x) =
  g2-of x (mFi x) (pFi x) (ot-T x o) h1 h2 (card-FS x o) ;
rem214g3 (x : T) (o : OK x) (h : Tr (le ii x)) : G3 x (mFi x) (pFi x) =
  g3-of x (mFi x) (pFi x) (ot-T x o) h (card-FS x o) ;

------------------------------------------------------------------------
-- Remark 2.14(i): x <' Omega^n_{x^-Fi + 1} for some n.
-- By induction on x, with W_n = Omega^n_{m+1}, m = x^-Fi.  W_n <=' W_{n+1}
-- (2.12(h)) and W_{n+1} is in G' (an Omega of a term /= 0).  0 <' 1 = W_0.
-- A sum, phi'_b c: their parts are below W_n, so they are below W_{n+1}
-- (clauses (2), (4)).  psi_I c: c' <' Omega_{c'+1} = W_1 (c' = psi_I c, as in
-- (f)).  psi_b c, b /= I: psi_b c <' b <' W_n.  Omega'_b: b <' W_n gives
-- Omega'_b = Omega_b <' Omega_{W_n} = W_{n+1} (2.12(g)).  I: I <' W_1.

omF-nz : (y : T) -> NZ y -> NZ (omF y) = split {
  zero -> \ h -> h ; plus x0 xs -> \ h -> refl false ; phi x0 x1 -> \ h -> refl false ;
  psi p c -> \ h -> iteC NZ (isI p) (psi p c) (om (psi p c)) (\ q -> refl false) (\ q -> refl false) ;
  om a -> \ h -> refl false ; ii -> \ h -> refl false } ;

omN-nz : (n : N) -> (a : T) -> NZ a -> NZ (omN n a) = split {
  nz -> \ a h -> h ; ns n | r -> \ a h -> omF-nz (omN n a) (r a h) } ;

W (m : T) (n : N) : T = omN n (suc m) ;

W-OK (m : T) (om : OK m) (n : N) : OK (W m n) = omN-OK n (suc m) (suc-OK m om) ;
W-G (m : T) (n : N) : Tr (isG (W m (ns n))) = omF-G (W m n) (omN-nz n (suc m) (add-nz m one (refl false))) ;

-- u <' W_n  =>  u <' W_{n+1}
bump (u m : T) (n : N) (om : OK m) (tu : TT u) (h : LT u (W m n)) : LT u (W m (ns n)) =
  lt-le u (W m n) (W m (ns n)) (tr3 u (W m n) (W m (ns n)) tu (ot-T (W m n) (W-OK m om n)) (ot-T (W m (ns n)) (W-OK m om (ns n))))
    h (le-omF (W m n) (W-OK m om n)) ;

I4 (x : T) (c : C4) : U j = (n : N) * LT x (W c.2.2.1 n) ;

i4-up (x u m : T) (om : OK m) (tu : TT u) (k : (g : T) -> Tr (isG g) -> TT g -> LT u g -> LT x g)
  (r : (n : N) * LT u (W m n)) : (n : N) * LT x (W m n) =
  (ns r.1, k (W m (ns r.1)) (W-G m r.1) (ot-T (W m (ns r.1)) (W-OK m om (ns r.1))) (bump u m r.1 om tu r.2)) ;

card-I : (x : T) -> OK x -> I4 x (card x) = split {
  zero -> \ o -> (nz, refl true) ;
  plus x0 xs | r0 _ -> \ o ->
    i4-up (plus x0 xs) x0 (mFi x0) (card-OK x0 (ot-plus0 x0 xs o)).2.2.1 (ot-T x0 (ot-plus0 x0 xs o))
      (\ g hg tg h -> trans (lt-hd (plus x0 xs) g (G-A g hg)) h) (r0 (ot-plus0 x0 xs o)) ;
  phi x0 x1 | r0 r1 -> \ o -> ifQ-G (I4 (phi x0 x1)) (le x1 x0) (card x0) (card x1)
    (\ h10 -> i4-up (phi x0 x1) x0 (mFi x0) (card-OK x0 (ot-phi0 x0 x1 o)).2.2.1 (ot-T x0 (ot-phi0 x0 x1 o))
       (\ g hg tg h -> fg-intro x0 x1 g hg h
          (le-lt x1 x0 g (tr3 x1 x0 g (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) tg) h10 h))
       (r0 (ot-phi0 x0 x1 o)))
    (\ h10 -> i4-up (phi x0 x1) x1 (mFi x1) (card-OK x1 (ot-phi1 x0 x1 o)).2.2.1 (ot-T x1 (ot-phi1 x0 x1 o))
       (\ g hg tg h -> fg-intro x0 x1 g hg
          (tr3 x0 x1 g (ot-T x0 (ot-phi0 x0 x1 o)) (ot-T x1 (ot-phi1 x0 x1 o)) tg
             (nle-lt' x1 x0 (ot-T x1 (ot-phi1 x0 x1 o)) (ot-T x0 (ot-phi0 x0 x1 o)) h10) h) h)
       (r1 (ot-phi1 x0 x1 o))) ;
  psi x0 x1 | r0 _ -> \ o -> ifQ-G (I4 (psi x0 x1)) (isI x0)
    (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0))
    (\ hi -> (ns nz, (f2-psiI x0 x1 o hi).2))
    (\ hi -> ((r0 (ot-psi0 x0 x1 o)).1,
              tr3 (psi x0 x1) x0 (W (mFi x0) (r0 (ot-psi0 x0 x1 o)).1) (ot-T (psi x0 x1) o) (ot-T x0 (ot-psi0 x0 x1 o))
                (ot-T (W (mFi x0) (r0 (ot-psi0 x0 x1 o)).1) (W-OK (mFi x0) (card-OK x0 (ot-psi0 x0 x1 o)).2.2.1 (r0 (ot-psi0 x0 x1 o)).1))
                (f2-psiS x0 x1 (rs-psi x0 x1 o hi)).2 (r0 (ot-psi0 x0 x1 o)).2)) ;
  om x0 | r0 -> \ o ->
    (ns (r0 (ot-om0 x0 o)).1,
     subst (\ t -> LT t (W (mFi x0) (ns (r0 (ot-om0 x0 o)).1))) (omF-mov x0 (om-mov x0 o))
       (trans (rem212g x0 (W (mFi x0) (r0 (ot-om0 x0 o)).1) (ot-T x0 (ot-om0 x0 o))
                 (ot-T (W (mFi x0) (r0 (ot-om0 x0 o)).1) (W-OK (mFi x0) (card-OK x0 (ot-om0 x0 o)).2.2.1 (r0 (ot-om0 x0 o)).1)))
          (r0 (ot-om0 x0 o)).2)) ;
  ii -> \ o -> (ns nz, refl true) } ;

rem214i (x : T) (o : OK x) : (n : N) * LT x (omN n (suc (mFi x))) = card-I x o ;

------------------------------------------------------------------------
-- Remark 2.14(b): x <=' y  =>  x~ <=' y~, x+ <=' y+, x^-Fi <=' y^-Fi,
-- x^+Fi <=' y^+Fi, x^-I <=' y^-I  (x, y in OT).  (x^+I is not defined in
-- the paper.)
--
-- The cardinals are the kappa = Omega_s, s in OT.  Two facts, by induction
-- on y (card-M, card-P):
--   (M) kappa <=' y  =>  kappa <=' y~;
--   (P) y <' kappa   =>  y+ <=' kappa.
-- With them: x~ = Omega_s <=' x <=' y gives x~ <=' y~ (M), and
-- x <=' y <' y+ = Omega_{t+1} gives x+ <=' y+ (P) (2.14(f)).
-- Tools: s <=' t => Omega_s <=' Omega_t (2.12(g));  y <' s => y+1 <=' s
-- (by OTC.lt-succ at y+1, whose predecessor is y).
-- (M): kappa = 0 is below everything; otherwise kappa is in G'.  Sum: kappa
-- <=' y0 (clause (2)).  phi'_b c: kappa <=' b or kappa <=' c (clause (4)).
-- psi_I c, Omega'_b, I: y~ = y.  psi_pi c, pi = Omega'_e: kappa /= psi_pi c,
-- so Omega_s <' psi_pi c <' Omega_e, s <' e (2.12(g)), s <=' pred1 e
-- (lt-succ; e = 1 gives s = 0), Omega_s <=' Omega_{pred1 e} = y~.
-- (P): 0: Omega_1 <=' Omega_s as 1 <=' s.  Sum, phi'_b c: the head, resp.
-- b and c, are below kappa in G'.  y = Omega_t (t = y for psi_I c and I,
-- t = b for Omega'_b): t <' s, so y+ = Omega_{t+1} <=' Omega_s.  psi_pi c,
-- pi /= I: y+ = pi <=' kappa by (5), (6) (lex-SO, lex-SI, lex-ST).
-- x^-Fi, x^+Fi: the states of (g) for x and y (fi-mono); in st1/st1,
-- psi_I a <=' x <=' y <' psi_I (b+1) gives a <' b+1, a <=' b.

omF-le-mono (t s : T) (tt : TT t) (ts : TT s) (h : Tr (le t s)) : Tr (le (omF t) (omF s)) =
  orE (Tr (le (omF t) (omF s))) (lt t s) (eqT t s) h
    (\ p -> le-of-lt (omF t) (omF s) (trans (rem212g t s tt ts) p))
    (\ e -> subst (\ u -> Tr (le (omF t) (omF u))) (eqT-sound t s e) (le-refl (omF t))) ;

SucSh (y : T) : U j = Tr (isSuc (suc y)) * (Id Bool (isOne (suc y)) false * Id T (pred1 (suc y)) y) ;

suc-sh-A (g : T) (hA : Tr (isA g)) (tg : TT g) : SucSh g =
  subst (\ t -> Tr (isSuc t) * (Id Bool (isOne t) false * Id T (pred1 t) g)) (sym (suc-A g hA tg))
    (refl true, (refl false, refl g)) ;

suc-sh : (y : T) -> TT y -> NZ y -> SucSh y = split {
  zero -> \ t h -> abT h ;
  plus x0 xs | _ r -> \ t h ->
    subst (\ u -> Tr (isSuc u) * (Id Bool (isOne u) false * Id T (pred1 u) (plus x0 xs))) (sym (suc-P x0 xs t))
      ((r (isT-plusS x0 xs t) (tail-nz x0 xs t)).1,
       (refl false,
        trans (ifT-f (isOne (suc xs)) x0 (plus x0 (pred1 (suc xs))) (r (isT-plusS x0 xs t) (tail-nz x0 xs t)).2.1)
          (ap (\ s -> plus x0 s) (r (isT-plusS x0 xs t) (tail-nz x0 xs t)).2.2))) ;
  phi a b -> \ t h -> suc-sh-A (phi a b) (refl true) t ;
  psi a b -> \ t h -> suc-sh-A (psi a b) (refl true) t ;
  om a -> \ t h -> suc-sh-A (om a) (refl true) t ;
  ii -> \ t h -> suc-sh-A ii (refl true) t } ;

-- y <' s  =>  y + 1 <=' s
lt-suc-le (y s : T) (oy : OK y) (os : OK s) (h : LT y s) : Tr (le (suc y) s) =
  boolCases (Tr (le (suc y) s)) (isZero y)
    (\ hz -> subst (\ u -> Tr (le (suc u) s)) (sym (isZero-true y hz)) (one-le s (ot-T s os) (nz-of-gt y s h)))
    (\ hz -> nlt-le (suc y) s (suc-T y (ot-T y oy)) (ot-T s os)
       (boolCases (Id Bool (lt s (suc y)) false) (lt s (suc y))
          (\ c -> abF (trans (sym (le-nlt s y (ot-T s os) (ot-T y oy)
                       (subst (\ u -> Tr (le s u)) (suc-sh y (ot-T y oy) hz).2.2
                          (lt-succ (suc y) (suc-T y (ot-T y oy)) (suc-sh y (ot-T y oy) hz).1 (suc-sh y (ot-T y oy) hz).2.1
                             s (ot-T s os) c)))) h))
          (\ c -> c))) ;

-- Omega_s /= psi_pi c for pi /= I
omF-ne-psi (p c : T) (hp : Id Bool (isI p) false) : (s : T) -> Id Bool (eqT (omF s) (psi p c)) false = split {
  zero -> refl false ; plus x0 xs -> refl false ; phi x0 x1 -> refl false ;
  psi q d -> iteC (\ t -> Id Bool (eqT t (psi p c)) false) (isI q) (psi q d) (om (psi q d))
    (\ hq -> ap (\ w -> and w (eqT d c)) (trans (ap (\ u -> eqT u p) (isI-true q hq)) (isI-ne p hp)))
    (\ hq -> refl false) ;
  om a -> refl false ; ii -> refl false } ;

-- Omega_s is 0 or in G'
omF-G' : (s : T) -> NZ (omF s) -> Tr (isG (omF s)) = split {
  zero -> \ h -> abT h ;
  plus x0 xs -> \ h -> refl true ; phi x0 x1 -> \ h -> refl true ;
  psi p c -> \ h -> omF-G (psi p c) (refl false) ;
  om a -> \ h -> refl true ; ii -> \ h -> refl true } ;

eqT-A-P : (g : T) -> Tr (isA g) -> (y0 ys : T) -> Id Bool (eqT g (plus y0 ys)) false = split {
  zero -> \ h y0 ys -> abF h ; plus x0 xs -> \ h y0 ys -> abF h ;
  phi a b -> \ h y0 ys -> refl false ; psi a b -> \ h y0 ys -> refl false ;
  om a -> \ h y0 ys -> refl false ; ii -> \ h y0 ys -> refl false } ;
eqT-G-phi : (g : T) -> Tr (isG g) -> (c d : T) -> Id Bool (eqT g (phi c d)) false = split {
  zero -> \ h c d -> abF h ; plus x0 xs -> \ h c d -> abF h ; phi a b -> \ h c d -> abF h ;
  psi a b -> \ h c d -> refl false ; om a -> \ h c d -> refl false ; ii -> \ h c d -> refl false } ;

-- u <=' v, u /= v  =>  u <' v
le-ne-lt (u v : T) (h : Tr (le u v)) (ne : Id Bool (eqT u v) false) : LT u v =
  orE (LT u v) (lt u v) (eqT u v) h (\ p -> p) (\ e -> abT (trans (sym e) ne)) ;

-- (M)
Mc (y : T) (c : C4) : U j = (s : T) -> OK s -> Tr (le (omF s) y) -> Tr (le (omF s) c.1) ;

-- kappa = 0, or kappa in G'
m-gen (s t : T) (k : Tr (isG (omF s)) -> Tr (le (omF s) t)) : Tr (le (omF s) t) =
  boolCases (Tr (le (omF s) t)) (isZero (omF s))
    (\ hz -> subst (\ u -> Tr (le u t)) (sym (isZero-true (omF s) hz)) (zero-le-any t))
    (\ nz -> k (omF-G' s nz)) ;

-- kappa <=' psi_{Omega'_e} c  =>  s <' e   (kappa /= psi, psi <' Omega'_e = Omega_e, 2.12(g))
m-se (e c s : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (o : OK (psi (om e) c)) (os : OK s)
  (h : Tr (le (omF s) (psi (om e) c))) : LT s e =
  trans (sym (rem212g s e (ot-T s os) (ot-T e (ot-om0 e oe))))
    (subst (\ u -> LT (omF s) u) (sym (omF-mov e (suc-fx e hs)))
       (tr3 (omF s) (psi (om e) c) (om e) (ot-T (omF s) (omF-OK s os)) (ot-T (psi (om e) c) o) (ot-T (om e) oe)
          (le-ne-lt (omF s) (psi (om e) c) h (omF-ne-psi (om e) c (refl false) s))
          (f2-psiS (om e) c (e, (refl (om e), (oe, hs)))).2)) ;

-- kappa <=' psi_{Omega'_e} c  =>  kappa <=' Omega_{pred1 e}
m-psiS (e c s : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (o : OK (psi (om e) c)) (os : OK s)
  (h : Tr (le (omF s) (psi (om e) c))) : Tr (le (omF s) (kminus (om e))) =
  boolCases (Tr (le (omF s) (kminus (om e)))) (isZero s)
    (\ hz -> subst (\ u -> Tr (le (omF u) (kminus (om e)))) (sym (isZero-true s hz)) (zero-le-any (kminus (om e))))
    (\ hz -> boolCases (Tr (le (omF s) (kminus (om e)))) (isOne e)
       (\ ho -> abF (trans (sym (one-min s (ot-T s os) hz))
                   (subst (\ u -> LT s u) (one-eq e ho) (m-se e c s oe hs o os h))))
       (\ ho -> omF-le-mono s (pred1 e) (ot-T s os) (pred-lt e (ot-T e (ot-om0 e oe)) hs ho).2.1
                  (lt-succ e (ot-T e (ot-om0 e oe)) hs ho s (ot-T s os) (m-se e c s oe hs o os h)))) ;

card-M : (y : T) -> OK y -> Mc y (card y) = split {
  zero -> \ o s os h -> h ;
  plus y0 ys | r0 _ -> \ o s os h -> m-gen s (tilde y0) (\ hg ->
    r0 (ot-plus0 y0 ys o) s os
      (orE (Tr (le (omF s) y0)) (lt (omF s) (plus y0 ys)) (eqT (omF s) (plus y0 ys)) h
         (\ p -> trans (sym (lt-gP (omF s) (G-A (omF s) hg) y0 ys)) p)
         (\ e -> abT (trans (sym e) (eqT-A-P (omF s) (G-A (omF s) hg) y0 ys))))) ;
  phi y0 y1 | r0 r1 -> \ o -> ifQ-G (Mc (phi y0 y1)) (le y1 y0) (card y0) (card y1)
    (\ h10 s os h -> m-gen s (tilde y0) (\ hg -> r0 (ot-phi0 y0 y1 o) s os
       (gf-elim (Tr (le (omF s) y0)) y0 y1 (omF s) (ot-T y0 (ot-phi0 y0 y1 o)) (ot-T y1 (ot-phi1 y0 y1 o))
          (ot-T (omF s) (omF-OK s os)) hg (le-ne-lt (omF s) (phi y0 y1) h (eqT-G-phi (omF s) hg y0 y1))
          (\ a -> a)
          (\ b -> le-trans (omF s) y1 y0
                    (tr3 (omF s) y1 y0 (ot-T (omF s) (omF-OK s os)) (ot-T y1 (ot-phi1 y0 y1 o)) (ot-T y0 (ot-phi0 y0 y1 o)))
                    b h10))))
    (\ h10 s os h -> m-gen s (tilde y1) (\ hg -> r1 (ot-phi1 y0 y1 o) s os
       (gf-elim (Tr (le (omF s) y1)) y0 y1 (omF s) (ot-T y0 (ot-phi0 y0 y1 o)) (ot-T y1 (ot-phi1 y0 y1 o))
          (ot-T (omF s) (omF-OK s os)) hg (le-ne-lt (omF s) (phi y0 y1) h (eqT-G-phi (omF s) hg y0 y1))
          (\ a -> le-trans (omF s) y0 y1
                    (tr3 (omF s) y0 y1 (ot-T (omF s) (omF-OK s os)) (ot-T y0 (ot-phi0 y0 y1 o)) (ot-T y1 (ot-phi1 y0 y1 o)))
                    a (le-of-lt y0 y1 (nle-lt' y1 y0 (ot-T y1 (ot-phi1 y0 y1 o)) (ot-T y0 (ot-phi0 y0 y1 o)) h10)))
          (\ b -> b)))) ;
  psi y0 y1 -> \ o -> ifQ-G (Mc (psi y0 y1)) (isI y0)
    (psi y0 y1, (omF (suc (psi y0 y1)), (psi y0 y1, psi ii (suc y1)))) (cardS y0 (card y0))
    (\ hi s os h -> h)
    (\ hi s os h -> subst (\ q -> OK (psi q y1) -> Tr (le (omF s) (psi q y1)) -> Tr (le (omF s) (kminus q)))
                      (sym (rs-psi y0 y1 o hi).2.1)
                      (\ o' h' -> m-psiS (rs-psi y0 y1 o hi).1 y1 s (rs-psi y0 y1 o hi).2.2.1 (rs-psi y0 y1 o hi).2.2.2 o' os h')
                      o h) ;
  om y0 -> \ o s os h -> h ;
  ii -> \ o s os h -> h } ;

-- (P)
Pc (y : T) (c : C4) : U j = (s : T) -> OK s -> LT y (omF s) -> Tr (le c.2.1 (omF s)) ;

-- Omega_t <' Omega_s  =>  Omega_{t+1} <=' Omega_s
up-step (t s : T) (ot : OK t) (os : OK s) (h : LT (omF t) (omF s)) : Tr (le (omF (suc t)) (omF s)) =
  omF-le-mono (suc t) s (suc-T t (ot-T t ot)) (ot-T s os)
    (lt-suc-le t s ot os (trans (sym (rem212g t s (ot-T t ot) (ot-T s os))) h)) ;

nz-of-omF : (s : T) -> NZ (omF s) -> NZ s = split {
  zero -> \ h -> h ; plus x0 xs -> \ h -> refl false ; phi x0 x1 -> \ h -> refl false ;
  psi x0 x1 -> \ h -> refl false ; om x0 -> \ h -> refl false ; ii -> \ h -> refl false } ;

lexle (u v : T) (t : Bool) (h : Tr (or (lt u v) (and (eqT u v) t))) : Tr (le u v) =
  orE (Tr (le u v)) (lt u v) (and (eqT u v) t) h (\ q -> le-of-lt u v q) (\ q -> le-of-eq u v (and-l (eqT u v) t q)) ;

-- psi_p b <' Omega_s, p /= I  =>  p <=' Omega_s   (clauses (5), (6))
psiS-up (p b : T) (tx : TT (psi p b)) (hp : Id Bool (isI p) false) : (s : T) -> LT (psi p b) (omF s) -> Tr (le p (omF s)) = split {
  zero -> \ h -> abT (trans (sym h) (lt-zero (psi p b))) ;
  plus x0 xs -> \ h -> lexle p (om (plus x0 xs)) true (trans (sym (lex-SO p b (plus x0 xs) hp)) h) ;
  phi x0 x1 -> \ h -> lexle p (om (phi x0 x1)) true (trans (sym (lex-SO p b (phi x0 x1) hp)) h) ;
  psi q d -> iteC (\ t -> LT (psi p b) t -> Tr (le p t)) (isI q) (psi q d) (om (psi q d))
    (\ hq h -> lexle p (psi q d) true (trans (sym (lex-ST p b q d tx hp hq)) h))
    (\ hq h -> lexle p (om (psi q d)) true (trans (sym (lex-SO p b (psi q d) hp)) h)) ;
  om a -> \ h -> lexle p (om (om a)) true (trans (sym (lex-SO p b (om a) hp)) h) ;
  ii -> \ h -> lexle p ii true (trans (sym (lex-SI p b hp)) h) } ;

card-P : (y : T) -> OK y -> Pc y (card y) = split {
  zero -> \ o s os h -> omF-le-mono one s (refl true) (ot-T s os)
                          (one-le s (ot-T s os) (nz-of-omF s (nz-of-gt zero (omF s) h))) ;
  plus y0 ys | r0 _ -> \ o s os h -> r0 (ot-plus0 y0 ys o) s os
    (trans (sym (lt-hd (plus y0 ys) (omF s) (G-A (omF s) (omF-G' s (nz-of-gt (plus y0 ys) (omF s) h))))) h) ;
  phi y0 y1 | r0 r1 -> \ o -> ifQ-G (Pc (phi y0 y1)) (le y1 y0) (card y0) (card y1)
    (\ h10 s os h -> r0 (ot-phi0 y0 y1 o) s os (fg-elim y0 y1 (omF s) (omF-G' s (nz-of-gt (phi y0 y1) (omF s) h)) h).1)
    (\ h10 s os h -> r1 (ot-phi1 y0 y1 o) s os (fg-elim y0 y1 (omF s) (omF-G' s (nz-of-gt (phi y0 y1) (omF s) h)) h).2) ;
  psi y0 y1 -> \ o -> ifQ-G (Pc (psi y0 y1)) (isI y0)
    (psi y0 y1, (omF (suc (psi y0 y1)), (psi y0 y1, psi ii (suc y1)))) (cardS y0 (card y0))
    (\ hi s os h -> up-step (psi y0 y1) s o os
       (subst (\ t -> LT t (omF s)) (sym (omF-fix (psi y0 y1) (trans (orF (isI y0)) hi))) h))
    (\ hi s os h -> psiS-up y0 y1 (ot-T (psi y0 y1) o) hi s h) ;
  om y0 -> \ o s os h -> up-step y0 s (ot-om0 y0 o) os (subst (\ t -> LT t (omF s)) (sym (omF-mov y0 (om-mov y0 o))) h) ;
  ii -> \ o s os h -> up-step ii s (refl true) os h } ;

-- x~ and x+
tilde-mono (x y : T) (ox : OK x) (oy : OK y) (h : Tr (le x y)) : Tr (le (tilde x) (tilde y)) =
  subst (\ t -> Tr (le t (tilde y))) (sym (card-F1 x ox).2.2.1)
    (card-M y oy (card-F1 x ox).1 (card-F1 x ox).2.1
       (subst (\ t -> Tr (le t y)) (card-F1 x ox).2.2.1
          (le-trans (tilde x) x y (tr3 (tilde x) x y (ot-T (tilde x) (card-OK x ox).1) (ot-T x ox) (ot-T y oy))
             (card-F2 x ox).1 h))) ;

up-mono (x y : T) (ox : OK x) (oy : OK y) (h : Tr (le x y)) : Tr (le (up x) (up y)) =
  subst (\ t -> Tr (le (up x) t)) (sym (card-F1 y oy).2.2.2)
    (card-P x ox (suc (card-F1 y oy).1) (suc-OK (card-F1 y oy).1 (card-F1 y oy).2.1)
       (subst (\ t -> LT x t) (card-F1 y oy).2.2.2
          (le-lt x y (up y) (tr3 x y (up y) (ot-T x ox) (ot-T y oy) (ot-T (up y) (card-OK y oy).2.1)) h (card-F2 y oy).2))) ;

-- x^-Fi and x^+Fi
le-at (a b a' b' : T) (ea : Id T a a') (eb : Id T b b') (h : Tr (le a' b')) : Tr (le a b) =
  subst (\ u -> Tr (le u b)) (sym ea) (subst (\ u -> Tr (le a' u)) (sym eb) h) ;

le-psiI-mono (a b : T) (h : Tr (le a b)) : Tr (le (psi ii a) (psi ii b)) =
  trans (ap (\ w -> or w (eqT a b)) (lt-TT ii a ii b (refl true) (refl true))) h ;

-- a <' b + 1  =>  a <=' b
lt-suc-le' (a b : T) (oa : OK a) (ob : OK b) (h : LT a (suc b)) : Tr (le a b) =
  boolCases (Tr (le a b)) (isZero b)
    (\ hz -> subst (\ u -> Tr (le a u)) (sym (isZero-true b hz))
       (boolCases (Tr (le a zero)) (isZero a)
          (\ ha -> subst (\ u -> Tr (le u zero)) (sym (isZero-true a ha)) (le-refl zero))
          (\ ha -> abF (trans (sym (one-min a (ot-T a oa) ha)) (subst (\ u -> LT a (suc u)) (isZero-true b hz) h)))))
    (\ hz -> subst (\ u -> Tr (le a u)) (suc-sh b (ot-T b ob) hz).2.2
       (lt-succ (suc b) (suc-T b (ot-T b ob)) (suc-sh b (ot-T b ob) hz).1 (suc-sh b (ot-T b ob) hz).2.1 a (ot-T a oa) h)) ;

-- a <=' b  =>  a + 1 <=' b + 1
suc-le-mono (a b : T) (oa : OK a) (ob : OK b) (h : Tr (le a b)) : Tr (le (suc a) (suc b)) =
  orE (Tr (le (suc a) (suc b))) (lt a b) (eqT a b) h
    (\ p -> le-trans (suc a) b (suc b)
              (tr3 (suc a) b (suc b) (suc-T a (ot-T a oa)) (ot-T b ob) (suc-T b (ot-T b ob)))
              (lt-suc-le a b oa ob p) (le-add-l b ob one (refl true)))
    (\ e -> subst (\ u -> Tr (le (suc a) (suc u))) (eqT-sound a b e) (le-refl (suc a))) ;

-- psi_I a <=' x <=' y <' psi_I (b+1)  =>  a <=' b
fi-ab (x y a b : T) (tx : TT x) (ty : TT y) (oa : OK (psi ii a)) (ob : OK (psi ii b)) (h : Tr (le x y))
  (h1 : Tr (le (psi ii a) x)) (h2 : LT y (psi ii (suc b))) : Tr (le a b) =
  lt-suc-le' a b (ot-psi1 ii a oa) (ot-psi1 ii b ob)
    (trans (sym (lt-TT ii a ii (suc b) (refl true) (refl true)))
       (le-lt (psi ii a) y (psi ii (suc b)) (tr3 (psi ii a) y (psi ii (suc b)) (ot-T (psi ii a) oa) ty (psiS-T b ob))
          (le-trans (psi ii a) x y (tr3 (psi ii a) x y (ot-T (psi ii a) oa) tx ty) h1 h) h2)) ;

FiLe (mx px my py : T) : U j = Tr (le mx my) * Tr (le px py) ;

-- x in state st1 a
fi-mono1 (x y a mx px : T) (tx : TT x) (ty : TT y) (oa : OK (psi ii a)) (h : Tr (le x y))
  (hm : Id T mx (psi ii a)) (hp : Id T px (psi ii (suc a))) (h1 : Tr (le mx x))
  (my py : T) : FiSt y my py -> FiLe mx px my py = split {
  st0 hm' hp' h' -> abT (fi-not-below y a ty oa
      (le-trans (psi ii a) x y (tr3 (psi ii a) x y (ot-T (psi ii a) oa) tx ty) (subst (\ u -> Tr (le u x)) hm h1) h) h') ;
  st1 b ob hm' hp' h1' h2' ->
    (le-at mx my (psi ii a) (psi ii b) hm hm' (le-psiI-mono a b (fi-ab x y a b tx ty oa ob h (subst (\ u -> Tr (le u x)) hm h1) (subst (\ u -> LT y u) hp' h2'))),
     le-at px py (psi ii (suc a)) (psi ii (suc b)) hp hp'
       (le-psiI-mono (suc a) (suc b) (suc-le-mono a b (ot-psi1 ii a oa) (ot-psi1 ii b ob)
          (fi-ab x y a b tx ty oa ob h (subst (\ u -> Tr (le u x)) hm h1) (subst (\ u -> LT y u) hp' h2'))))) ;
  st2 hm' hp' h' ->
    (le-at mx my (psi ii a) ii hm hm' (le-of-lt (psi ii a) ii (lt-TI ii a (refl true))),
     le-at px py (psi ii (suc a)) ii hp hp' (le-of-lt (psi ii (suc a)) ii (lt-TI ii (suc a) (refl true)))) } ;

-- x in state st0
fi-mono0 (mx px : T) (hm : Id T mx zero) (hp : Id T px (psi ii zero)) (y my py : T) : FiSt y my py -> FiLe mx px my py = split {
  st0 hm' hp' h' -> (le-at mx my zero zero hm hm' (le-refl zero), le-at px py (psi ii zero) (psi ii zero) hp hp' (le-refl (psi ii zero))) ;
  st1 b ob hm' hp' h1' h2' -> (le-at mx my zero (psi ii b) hm hm' (zero-le-any (psi ii b)),
                               le-at px py (psi ii zero) (psi ii (suc b)) hp hp' (le-psiI0 (suc b))) ;
  st2 hm' hp' h' -> (le-at mx my zero ii hm hm' (zero-le-any ii), le-at px py (psi ii zero) ii hp hp' (refl true)) } ;

-- x in state st2
fi-mono2 (x y mx px : T) (tx : TT x) (ty : TT y) (h : Tr (le x y)) (hm : Id T mx ii) (hp : Id T px ii) (h0 : Tr (le ii x))
  (my py : T) : FiSt y my py -> FiLe mx px my py = split {
  st0 hm' hp' h' -> abF (le-lt ii y (psi ii zero) (tr3 ii y (psi ii zero) (refl true) ty (refl true))
                          (le-trans ii x y (tr3 ii x y (refl true) tx ty) h0 h) h') ;
  st1 b ob hm' hp' h1' h2' -> abF (trans (sym (lt-IT ii (suc b) (refl true)))
       (le-lt ii y (psi ii (suc b)) (tr3 ii y (psi ii (suc b)) (refl true) ty (psiS-T b ob))
          (le-trans ii x y (tr3 ii x y (refl true) tx ty) h0 h) (subst (\ u -> LT y u) hp' h2'))) ;
  st2 hm' hp' h' -> (le-at mx my ii ii hm hm' (le-refl ii), le-at px py ii ii hp hp' (le-refl ii)) } ;

fi-mono (x y mx px my py : T) (tx : TT x) (ty : TT y) (h : Tr (le x y)) (sy : FiSt y my py)
  : FiSt x mx px -> FiLe mx px my py = split {
  st0 hm hp h0 -> fi-mono0 mx px hm hp y my py sy ;
  st1 a oa hm hp h1 h2 -> fi-mono1 x y a mx px tx ty oa h hm hp h1 my py sy ;
  st2 hm hp h0 -> fi-mono2 x y mx px tx ty h hm hp h0 my py sy } ;

-- x^-I
mI-mono (x y : T) (tx : TT x) (ty : TT y) (h : Tr (le x y)) : Tr (le (mI x) (mI y)) =
  iteC (\ t -> Tr (le (mI x) t)) (lt y ii) zero ii
    (\ hy -> subst (\ t -> Tr (le t zero)) (sym (ifT-t (lt x ii) zero ii (le-lt x y ii (tr3 x y ii tx ty (refl true)) h hy)))
               (le-refl zero))
    (\ hy -> iteC (\ t -> Tr (le t ii)) (lt x ii) zero ii (\ q -> zero-le-any ii) (\ q -> le-refl ii)) ;

rem214b (x y : T) (ox : OK x) (oy : OK y) (h : Tr (le x y))
  : Tr (le (tilde x) (tilde y)) * (Tr (le (up x) (up y)) * (Tr (le (mFi x) (mFi y)) * (Tr (le (pFi x) (pFi y)) * Tr (le (mI x) (mI y))))) =
  (tilde-mono x y ox oy h,
   (up-mono x y ox oy h,
    ((fi-mono x y (mFi x) (pFi x) (mFi y) (pFi y) (ot-T x ox) (ot-T y oy) h (card-FS y oy) (card-FS x ox)).1,
     ((fi-mono x y (mFi x) (pFi x) (mFi y) (pFi y) (ot-T x ox) (ot-T y oy) h (card-FS y oy) (card-FS x ox)).2,
      mI-mono x y (ot-T x ox) (ot-T y oy) h)))) ;
