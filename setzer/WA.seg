-- WA.seg: Setzer (APAL 92, 1998), Section 4.3: W(A), the step to the next
-- cardinal.  W(A) is Definition 5.6, Assumption 4.10 is proved for it (as
-- Setzer does after Remark 5.7), Notation 4.11 is one declaration (wa-ind),
-- Definition 4.12 and Lemma 4.13.  The mirror is tools/otsec43.py; every
-- statement was tested on it first (python3 otsec43.py tilde 8, lem413 6).
--
-- Definition 5.6 (page 154), A a class:
--   (a) tau^(a) = Sigma y : N. y in tau^A(a)                    TH
--   (b) W_1^A = W x : N. tau^(x)                                W1 (sup x f)
--   (c) Cor^A(t): for every subtree u of t, index(u) in M(A) and the
--       v-th subtree of u has index v.0, for v : tau^(index u)
--   (d) W(A) = {y | exists v : W_1^A. Cor^A(v) and index(v) = y}  WA
--       (by definition: wa-mk, wa-sig, and its elimination wa-elim:
--       x in W(A) gives x = index(t) for a t with Cor^A(t); then locked)
-- Here Cor^A is defined by recursion on the tree, by Remark 5.7(c):
--   Cor^A(sup(x, f)) = x in M(A) and, for every v : tau^(x),
--                      Cor^A(f v) and index(f v) = v.0          Cor, cor-sup
-- Setzer's (c) (quantifying over the subtrees u <= t) is equivalent to it
-- by Remark 5.7(c); defining it by the recursion makes 5.7(c) a fact "by
-- definition" and needs no order on subtrees.
--
-- WA is declared with its full arity (WA A y); written as a class
-- "\ y -> ..." every application WA A y opens WA to beta-reduce, so that
-- any type mentioning an element of W(A) opened it (a checker effect).
--
-- Assumption 4.10, with A^A(B) = {y in M(A) | tau^A(y) c B} (CA.scA):
--   (a) A^A(W(A)) c W(A)                                        wa-a
--   (b) A^A(B) n W(A) c B  =>  W(A) c B                         wa-b
-- Proof (Setzer, after Remark 5.7).  (a): x in M(A), tau^A(x) c W(A): for
-- each v : tau^(x) take the tree f v with Cor^A(f v) and index(f v) = v.0
-- that v.0 in W(A) provides (ch);
-- then Cor^A(sup(x, f)) and index(sup(x, f)) = x.  (b): by induction on
-- t : W_1^A, Cor^A(t) => index(t) in B (cor-ind).  For t = sup(x, f) with
-- Cor^A(t): x in M(A), and for y in tau^A(x), v = (y, _): Cor^A(f v), so by
-- induction index(f v) = y is in B; so x in A^A(B).  x in W(A) by t.  So
-- x = index(t) in B.
--
-- Notation 4.11 ("by Ind(x in W(A))"): to show P(x) for x in W(A) it is
-- enough to show P(x) for x in W(A) n M(A) with tau^A(x) c P: this is 4.10(b)
-- with B = P (wa-ind).  From here on W(A) is used only through 4.10 (wa-a,
-- wa-ind), as in Setzer's proofs.
--
-- Definition 4.12.  (a) A|b = A n (b+1)                         Bar
--   (b) A [= B iff A c OT and A|x = B|x for every x in A        Seg
--
-- Lemma 4.13 (a in OT):
--   (a) x in W(A) => tau^A(x) c W(A) and x in M(A)              rem413a
--   (b) A n Omega_a = B n Omega_a, A c M(A), B c M(B) =>
--       M(A) n Omega_{a+1} = M(B) n Omega_{a+1} and
--       W(A) n Omega_{a+1} = W(B) n Omega_{a+1}                  rem413b
--   (c) A = B => W(A) = W(B)                                    rem413c
--   (d) W(A) n Omega_1 [= OT                                    rem413d
--
-- Proof.  (a) By Ind: x in W(A), x in M(A), and every y in tau^A(x) has
-- tau^A(y) c W(A) and y in M(A), so y in A^A(W(A)) c W(A) (4.10(a)).
--
-- (b) and (c) are two instances of one lemma (wa-agree):  let P be a class
-- such that, for x in M(A) n P, C^x(A) = C^x(B), and tau^A(x) c P.  Then
-- W(A) n P c W(B).  Proof by Ind(x in W(A)) of "x in P => x in W(B)": let
-- x in M(A) n P.  x in M(B), since x in C^x(A) = C^x(B).  tau^B(x) = tau^A(x)
-- (= C^x(.) n x), and each y in it is in P, so by induction in W(B).  So
-- x in A^B(W(B)) c W(B) (4.10(a) for B).
--   (b): P = Omega_{a+1}.  For x in OT, x <' Omega_{a+1}:
--     x~ <=' Omega_a (til-bound): x~ = Omega_s with s in OT and x~ <=' x
--       (2.14(f)), so Omega_s <' Omega_{a+1}, s <' a+1 (2.12(g)), s <=' a,
--       Omega_s <=' Omega_a (omF-le-mono);
--     so A n x~ = B n x~ (cap-le: the elements of A and B are in OT), and
--     C^x(A) = C^x(B) by Lemma 4.7(c).
--   y in tau^A(x) gives y <' x <' Omega_{a+1}.  W(B) n P c W(A) the same
--   way.  M(A) n Omega_{a+1} = M(B) n Omega_{a+1} by C^x(A) = C^x(B).
--   (Setzer's proof writes Omega_{b+1} for the second Omega_{a+1}.)
--   (c): P = all terms; C^x(A) = C^x(B) since C^x is monotone in A n x
--   (ca-mono).  Setzer says "immediate by (b)"; (b) assumes A c M(A), which
--   (c) does not, so (c) is proved from the lemma directly, without it.
--
-- (d) W(A) n Omega_1 c OT by (a) (M(A) c OT).  Let x in W(A), x <' Omega_1,
-- and z in OT, z <' x+1.  Then z <=' x (lt-suc-le').  If z = x, z is in
-- W(A) n Omega_1.  If z <' x, then z in OT n x = tau^A(x) (Lemma 4.9(c),
-- x <' Omega_1), so z in W(A) by (a), and z <' x <' Omega_1.  The converse
-- inclusion W(A) n Omega_1 n (x+1) c OT n (x+1) is the first part.

level wl ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
import OTF ;
import CA ;
open OT ;
open OTLaws[wl] ;
open OTTrans[wl] ;
open OTC[wl] ;
open OTF[wl] ;
open CA[wl] ;

------------------------------------------------------------------------
-- Classes

-- A n B
Meet (A B : Cl) (x : T) : U wl = A x * B x ;

-- OT as a class
OTc (x : T) : U wl = OK x ;

-- transport of x in B along u = y (explicit, so that no class in scope is opened)
tr-B (B : Cl) (u y : T) (e : Id T u y) (b : B u) : B y = subst (\ s -> B s) e b ;

------------------------------------------------------------------------
-- Definition 5.6

-- tau^(a) = Sigma y. y in tau^A(a)
TH (A : Cl) (a : T) : U wl = (y : T) * tau A a y ;

-- W_1^A
data W1 (A : Cl) : U wl = sup (x : T) (f : TH A x -> W1 A) ;

idx (A : Cl) : W1 A -> T = split { sup x f | r -> x } ;

-- Cor^A, by the recursion of Remark 5.7(c)
Cor (A : Cl) : W1 A -> U wl = split {
  sup x f | r -> M A x * ((v : TH A x) -> r v * Id T (idx A (f v)) v.1) } ;

-- by definition of idx and Cor, stated once
idx-sup (A : Cl) (x : T) (f : TH A x -> W1 A) : Id T (idx A (sup x f)) x = refl x ;
cor-sup (A : Cl) (x : T) (f : TH A x -> W1 A)
  : Iff (Cor A (sup x f)) (M A x * ((v : TH A x) -> Cor A (f v) * Id T (idx A (f v)) v.1)) =
  (\ h -> h, \ h -> h) ;

-- W(A)
-- (full arity: as a lambda, WA A y would open WA to reduce)
WA (A : Cl) (y : T) : U wl = (v : W1 A) * (Cor A v * Id T (idx A v) y) ;
wa-mk (A : Cl) (y : T) (v : W1 A) (c : Cor A v) (e : Id T (idx A v) y) : WA A y = (v, (c, e)) ;
-- by definition of W(A), stated once
wa-sig (A : Cl) (y : T) (h : WA A y) : (t : W1 A) * (Cor A t * Id T (idx A t) y) = h ;

-- x in W(A): x = index(t) for some t with Cor^A(t)
wa-elim (A P : Cl) (k : (t : W1 A) -> Cor A t -> P (idx A t)) (y : T) (h : WA A y) : P y =
  tr-B P (idx A h.1) y h.2.2 (k h.1 h.2.1) ;

-- lock the construction after its characterising lemmas
opaque Cor ;
opaque WA ;
opaque wa-mk ;
opaque wa-sig ;
opaque wa-elim ;

------------------------------------------------------------------------
-- Assumption 4.10

-- for each v : tau^(x), a tree f v with Cor^A(f v) and index(f v) = v.0
ch (A : Cl) (x : T) (h : Sub (tau A x) (WA A)) (v : TH A x) : (t : W1 A) * (Cor A t * Id T (idx A t) v.1) =
  wa-sig A v.1 (h v.1 v.2) ;

-- (a) A^A(W(A)) c W(A)
wa-a (A : Cl) : Sub (scA A (WA A)) (WA A) =
  \ x h -> wa-mk A x (sup x (\ v -> (ch A x h.2 v).1))
             (bw (Cor A (sup x (\ v -> (ch A x h.2 v).1)))
                 (M A x * ((v : TH A x) -> Cor A (ch A x h.2 v).1 * Id T (idx A (ch A x h.2 v).1) v.1))
                 (cor-sup A x (\ v -> (ch A x h.2 v).1))
                 (h.1, \ v -> (ch A x h.2 v).2))
             (idx-sup A x (\ v -> (ch A x h.2 v).1)) ;

-- the step at sup(x, f), with Cor^A(sup(x, f)) unfolded to g (cor-sup)
cor-step (A B : Cl) (h : Sub (Meet (scA A B) (WA A)) B) (x : T) (f : TH A x -> W1 A)
  (r : (v : TH A x) -> Cor A (f v) -> B (idx A (f v))) (c : Cor A (sup x f))
  (g : M A x * ((v : TH A x) -> Cor A (f v) * Id T (idx A (f v)) v.1)) : B x =
  h x ((g.1, \ y t -> tr-B B (idx A (f (y, t))) y (g.2 (y, t)).2 (r (y, t) (g.2 (y, t)).1)),
       wa-mk A x (sup x f) c (idx-sup A x f)) ;

-- the induction on W_1^A: Cor^A(t) => index(t) in B
cor-ind (A B : Cl) (h : Sub (Meet (scA A B) (WA A)) B) : (t : W1 A) -> Cor A t -> B (idx A t) = split {
  sup x f | r -> \ c -> cor-step A B h x f r c
    (fw (Cor A (sup x f)) (M A x * ((v : TH A x) -> Cor A (f v) * Id T (idx A (f v)) v.1)) (cor-sup A x f) c) } ;

-- (b) A^A(B) n W(A) c B => W(A) c B
wa-b (A B : Cl) (h : Sub (Meet (scA A B) (WA A)) B) : Sub (WA A) B = wa-elim A B (cor-ind A B h) ;

------------------------------------------------------------------------
-- Notation 4.11: Ind(x in W(A))

wa-ind (A P : Cl) (step : (x : T) -> WA A x -> M A x -> Sub (tau A x) P -> P x) : Sub (WA A) P =
  wa-b A P (\ x h -> step x h.2 h.1.1 h.1.2) ;

------------------------------------------------------------------------
-- Definition 4.12

-- A|b = A n (b+1)
Bar (A : Cl) (b : T) : Cl = Cap A (suc b) ;
-- A [= B
Seg (A B : Cl) : U wl = Sub A OTc * ((x : T) -> A x -> Eqv (Bar A x) (Bar B x)) ;

------------------------------------------------------------------------
-- Lemma 4.13 (a)

rem413a (A : Cl) : Sub (WA A) (\ x -> Sub (tau A x) (WA A) * M A x) =
  wa-ind A (\ x -> Sub (tau A x) (WA A) * M A x)
    (\ x w m ih -> (\ y t -> wa-a A y ((ih y t).2, (ih y t).1), m)) ;

-- W(A) c M(A) (Remark 5.7(b)), W(A) c OT
wa-M (A : Cl) (x : T) (h : WA A x) : M A x = (rem413a A x h).2 ;
wa-OK (A : Cl) (x : T) (h : WA A x) : OK x = (wa-M A x h).1 ;

------------------------------------------------------------------------
-- The lemma behind (b) and (c)

wa-agree (A B P : Cl) (hP : (x : T) -> M A x -> P x -> Eqv (C x A) (C x B))
  (hD : (x y : T) -> M A x -> P x -> tau A x y -> P y) : (x : T) -> WA A x -> P x -> WA B x =
  wa-ind A (\ x -> P x -> WA B x)
    (\ x w m ih p ->
       wa-a B x ((m.1, fw (C x A x) (C x B x) (hP x m p x) m.2),
                 \ y t -> ih y (bw (C x A y) (C x B y) (hP x m p y) t.1, t.2)
                            (hD x y m p (bw (C x A y) (C x B y) (hP x m p y) t.1, t.2)))) ;

------------------------------------------------------------------------
-- Lemma 4.13 (b)

-- y <' Omega_{a+1} => y~ <=' Omega_a
til-bound (y a : T) (oy : OK y) (oa : OK a) (h : LT y (omF (suc a))) : Tr (le (tilde y) (omF a)) =
  let { r : (s : T) * (OK s * (Id T (tilde y) (omF s) * (Id T (up y) (omF (suc s)) * (Tr (le (tilde y) y) * LT y (up y)))))
          = rem214f y oy ;
        ts : TT r.1 = ot-T r.1 r.2.1 ;
        ta1 : TT (suc a) = suc-T a (ot-T a oa) ;
        q : LT (omF r.1) (omF (suc a))
          = le-lt (omF r.1) y (omF (suc a)) (tr3 (omF r.1) y (omF (suc a)) (omF-T r.1 ts) (ot-T y oy) (omF-T (suc a) ta1))
              (subst (\ u -> Tr (le u y)) r.2.2.1 r.2.2.2.2.1) h ; }
  in subst (\ u -> Tr (le u (omF a))) (sym r.2.2.1)
       (omF-le-mono r.1 a ts (ot-T a oa)
          (lt-suc-le' r.1 a r.2.1 oa (trans (sym (rem212g r.1 (suc a) ts ta1)) q))) ;

-- A n k = B n k, k' <=' k, A, B c OT => A n k' = B n k'
cap-le (A B : Cl) (oA : Sub A OTc) (oB : Sub B OTc) (k k' : T) (ok : OK k) (ok' : OK k') (hk : Tr (le k' k))
  (e : Eqv (Cap A k) (Cap B k)) : Eqv (Cap A k') (Cap B k') =
  \ x -> (\ g -> ((fw (Cap A k x) (Cap B k x) (e x) (g.1, lt-le x k' k (trOT x k' k (oA x g.1) ok' ok) g.2 hk)).1, g.2),
          \ g -> ((bw (Cap A k x) (Cap B k x) (e x) (g.1, lt-le x k' k (trOT x k' k (oB x g.1) ok' ok) g.2 hk)).1, g.2)) ;

-- x in OT, x <' Omega_{a+1} => C^x(A) = C^x(B)  (Lemma 4.7(c))
ca-below (A B : Cl) (hA : Sub A (M A)) (hB : Sub B (M B)) (a : T) (oa : OK a)
  (e : Eqv (Cap A (omF a)) (Cap B (omF a))) (x : T) (ox : OK x) (l : LT x (omF (suc a))) : Eqv (C x A) (C x B) =
  rem47c A B hA hB x ox
    (cap-le A B (\ z g -> (hA z g).1) (\ z g -> (hB z g).1) (omF a) (tilde x) (omF-OK a oa) (til-OK x ox)
       (til-bound x a ox oa l) e) ;

-- W(A) n Omega_{a+1} c W(B)
wa-below (A B : Cl) (hA : Sub A (M A)) (hB : Sub B (M B)) (a : T) (oa : OK a)
  (e : Eqv (Cap A (omF a)) (Cap B (omF a))) : (x : T) -> WA A x -> LT x (omF (suc a)) -> WA B x =
  wa-agree A B (\ x -> LT x (omF (suc a)))
    (\ x m l -> ca-below A B hA hB a oa e x m.1 l)
    (\ x y m l t -> (tr3 y x (omF (suc a)) (ot-T y (ca-ok x A y t.1)) (ot-T x m.1)
                             (omF-T (suc a) (suc-T a (ot-T a oa)))) t.2 l) ;

-- Eqv is symmetric
eqv-sym (A B : Cl) (e : Eqv A B) : Eqv B A = \ x -> (bw (A x) (B x) (e x), fw (A x) (B x) (e x)) ;

rem413b (A B : Cl) (a : T) (oa : OK a) (e : Eqv (Cap A (omF a)) (Cap B (omF a)))
  (hA : Sub A (M A)) (hB : Sub B (M B))
  : Eqv (Cap (M A) (omF (suc a))) (Cap (M B) (omF (suc a))) * Eqv (Cap (WA A) (omF (suc a))) (Cap (WA B) (omF (suc a))) =
  (\ x -> (\ g -> ((g.1.1, fw (C x A x) (C x B x) (ca-below A B hA hB a oa e x g.1.1 g.2 x) g.1.2), g.2),
           \ g -> ((g.1.1, bw (C x A x) (C x B x) (ca-below A B hA hB a oa e x g.1.1 g.2 x) g.1.2), g.2)),
   \ x -> (\ g -> (wa-below A B hA hB a oa e x g.1 g.2, g.2),
           \ g -> (wa-below B A hB hA a oa (eqv-sym (Cap A (omF a)) (Cap B (omF a)) e) x g.1 g.2, g.2))) ;

------------------------------------------------------------------------
-- Lemma 4.13 (c)

-- A = B => C^x(A) = C^x(B)  (ca-mono both ways)
ca-eqv (A B : Cl) (e : Eqv A B) (x : T) : Eqv (C x A) (C x B) =
  \ y -> (ca-mono x A B (\ z g -> (fw (A z) (B z) (e z) g.1, g.2)) y,
          ca-mono x B A (\ z g -> (bw (A z) (B z) (e z) g.1, g.2)) y) ;

rem413c (A B : Cl) (e : Eqv A B) : Eqv (WA A) (WA B) =
  \ x -> (\ g -> wa-agree A B (\ z -> One) (\ z m p -> ca-eqv A B e z) (\ z y m p t -> tt) x g tt,
          \ g -> wa-agree B A (\ z -> One) (\ z m p -> ca-eqv B A (eqv-sym A B e) z) (\ z y m p t -> tt) x g tt) ;

------------------------------------------------------------------------
-- Lemma 4.13 (d)

-- z <' x+1, z <' x, x in W(A) n Omega_1 => z in W(A) n Omega_1
seg-lt (A : Cl) (x z : T) (h : Cap (WA A) (om one) x) (oz : OK z) (p : LT z x) : Cap (WA A) (om one) z =
  ((rem413a A x h.1).1 z (bw (tau A x z) (OK z * LT z x) (rem49c A x (wa-OK A x h.1) h.2 z) (oz, p)),
   trOT z x (om one) oz (wa-OK A x h.1) om1-OK p h.2) ;

rem413d (A : Cl) : Seg (Cap (WA A) (om one)) OTc =
  (\ x h -> wa-OK A x h.1,
   \ x h z -> (\ g -> (wa-OK A z g.1.1, g.2),
               \ g -> (orE (Cap (WA A) (om one) z) (lt z x) (eqT z x) (lt-suc-le' z x g.1 (wa-OK A x h.1) g.2)
                         (\ p -> seg-lt A x z h g.1 p)
                         (\ q -> tr-B (Cap (WA A) (om one)) x z (sym (eqT-sound z x q)) h), g.2))) ;
