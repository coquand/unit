-- OTFTest.seg: computations with the functions of Defs. 2.10, 2.11, 2.13
-- (defined in OT.seg, their laws in OTF.seg), against values computed by
-- the mirror tools/otfun.py.
-- The named values first, then the generated block.

import OT ;
open OT ;

#conv up zero = om one ;
#conv up ii = om (plus ii one) ;
#conv tilde (psi (om one) zero) = zero ;
#conv up (psi (om one) zero) = om one ;
#conv pFi (om one) = psi ii zero ;
#conv phiF zero (om one) = om one ;
#conv phiF (om one) zero = om one ;
#conv phiF one zero = phi one zero ;
#conv suc one = plus one one ;
#conv omN (ns (ns nz)) one = om (om one) ;
#conv mI (psi ii zero) = zero ;
#conv mI (om (plus ii one)) = ii ;

-- generated by tools/checks.py genf (the mirror tools/otfun.py), on OT terms of size <= 7;
-- the recursion for + agrees with Setzer's definition on all 51529 pairs (0 failures)
