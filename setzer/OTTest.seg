-- OTTest.seg: computations with the definitions of OT.seg.
--
-- (1) Named notations and the expected facts about them: the chain
--     0 < 1 < 2 < omega < eps_0 < psi_{Omega_1} 0 < psi_{Omega_1} Omega_{I+1}
--       < psi_{Omega_1} Omega_{I+2} < Omega_1 < Omega_2 < psi_I 0 < I
--       < Omega_{I+1} < Omega_{I+2},
--     the members of OT among them, and terms excluded from OT by each
--     clause of Def. 2.9.
-- (2) A cross-check with an independent implementation: values of <' and
--     of OT on random terms of T' of size <= 7, computed by a Python mirror
--     of OT.seg; the mirror also found <' linear on all 4200 terms of T'
--     of size <= 8, and Remark 2.15 (b)-(e) true on its test pool.

level l ;
import OT ;
open OT ;

one : T = phi zero zero ;
two : T = plus one one ;
omega : T = phi zero one ;
eps0 : T = phi one zero ;
om1 : T = om one ;
om2 : T = om two ;
-- psi_{Omega_1} 0, the Feferman-Schuette ordinal Gamma_0
gam0 : T = psi om1 zero ;
psiI0 : T = psi ii zero ;
omI1 : T = om (plus ii one) ;
omI2 : T = om (plus ii two) ;
-- the ordinals of Theorem 4.41 for n = 1, 2
target1 : T = psi om1 omI1 ;
target2 : T = psi om1 omI2 ;

-- (1) the chain
#conv lt zero one = true ;
#conv lt one two = true ;
#conv lt two omega = true ;
#conv lt omega eps0 = true ;
#conv lt eps0 gam0 = true ;
#conv lt gam0 target1 = true ;
#conv lt target1 target2 = true ;
#conv lt target2 om1 = true ;
#conv lt om1 om2 = true ;
#conv lt om2 psiI0 = true ;
#conv lt psiI0 ii = true ;
#conv lt ii omI1 = true ;
#conv lt omI1 omI2 = true ;
-- the converses, and irreflexivity
#conv lt one zero = false ;
#conv lt gam0 eps0 = false ;
#conv lt om1 target2 = false ;
#conv lt ii psiI0 = false ;
#conv lt omI1 ii = false ;
#conv lt target1 target1 = false ;

-- members of OT
#conv isOT one = true ;
#conv isOT omega = true ;
#conv isOT eps0 = true ;
#conv isOT gam0 = true ;
#conv isOT om2 = true ;
#conv isOT psiI0 = true ;
#conv isOT omI2 = true ;
#conv isOT target1 = true ;
#conv isOT target2 = true ;
#conv isOT (psi ii psiI0) = true ;
#conv isOT (plus omega one) = true ;
-- excluded, clause by clause
-- (OT2) the summands must decrease
#conv isOT (plus one omega) = false ;
-- (OT3) Gamma_0 is critical for phi_0: phi_0 Gamma_0 = Gamma_0
#conv isOT (phi zero gam0) = false ;
-- (OT3) phi_a 0 = a for a in G'
#conv isOT (phi gam0 zero) = false ;
-- (OT4) the index must be in R'
#conv isOT (psi one zero) = false ;
-- (OT4) G_{Omega_1}(psi_{Omega_1} Omega_1) = {Omega_1}, not below psi_{Omega_1} Omega_1
#conv G om1 (psi om1 om1) = cons om1 nil ;
#conv isOT (psi om1 (psi om1 om1)) = false ;
-- (OT5) Omega of a fixed point of Omega
#conv isOT (om psiI0) = false ;
-- (T'5) Omega'_0 is not a term
#conv isT (om zero) = false ;
#conv isOT (om zero) = false ;

-- (2) cross-check with the Python mirror
-- generated by otmirror.py (the Python mirror of OT.seg): 300 pairs of T' terms of size <= 7
#conv lt (phi (om ii) (phi ii ii)) (psi ii (phi zero (psi ii ii))) = false ;
#conv lt (phi (phi zero (phi zero zero)) zero) (plus (phi zero (psi ii ii)) ii) = true ;
#conv lt (phi ii (phi zero (om ii))) (om (phi (phi zero zero) (om ii))) = true ;
#conv lt (phi (plus (phi zero ii) ii) ii) (phi (phi zero zero) (phi ii ii)) = false ;
#conv lt (phi (phi (phi ii ii) ii) ii) (phi (phi (om (om ii)) zero) ii) = true ;
#conv lt (phi (om (phi zero (om ii))) zero) (phi (psi ii zero) (phi ii zero)) = false ;
#conv lt (om (phi (om (phi ii ii)) ii)) (phi zero ii) = false ;
#conv lt (om (plus (phi ii ii) ii)) (psi ii (plus (om ii) ii)) = false ;
#conv lt (psi ii (om (om (om (om ii))))) (plus ii (om (plus ii ii))) = true ;
#conv lt (plus (phi ii ii) (om (om ii))) (phi (om ii) zero) = true ;
#conv lt (phi (om (om (psi ii ii))) ii) (plus ii (phi zero (psi ii zero))) = false ;
#conv lt (om (phi ii (phi (om ii) zero))) (phi (om ii) (om (plus ii ii))) = false ;
#conv lt (phi zero (om (om (phi zero zero)))) (plus ii (phi ii (phi ii ii))) = true ;
#conv lt (plus ii (phi (om ii) (om ii))) (phi ii (phi (psi ii zero) zero)) = true ;
#conv lt (phi (plus ii (om (om ii))) ii) (om (phi (phi ii zero) zero)) = true ;
#conv lt (plus ii (psi ii (psi ii zero))) (phi zero (plus (om ii) ii)) = true ;
#conv lt (plus (phi (phi zero ii) ii) ii) (plus (phi ii (phi ii ii)) ii) = false ;
#conv lt (plus ii (om (om (psi ii zero)))) (plus ii (om (om (phi zero zero)))) = false ;
#conv lt (plus (psi ii ii) (om (om ii))) (plus (phi zero (om ii)) ii) = true ;
#conv lt (phi ii (phi zero (om (om ii)))) (phi ii (om (om ii))) = false ;
#conv lt (phi ii (plus (phi zero ii) ii)) (psi ii (phi (phi zero zero) zero)) = false ;
#conv lt (plus (psi ii ii) (psi ii zero)) (plus (phi zero ii) (om (om ii))) = true ;
#conv lt (plus ii (om (om (om ii)))) (plus (om ii) (om (psi ii ii))) = true ;
#conv lt (phi (phi (phi zero ii) zero) zero) (phi (om (plus (om ii) ii)) zero) = true ;
#conv lt (plus (om ii) (psi ii zero)) (phi (phi zero ii) (phi ii zero)) = false ;
#conv lt (phi (phi zero (phi ii zero)) ii) (phi (om (phi zero (om ii))) zero) = true ;
#conv lt (phi (om ii) (om (phi ii ii))) (phi (plus ii (phi ii zero)) zero) = false ;
#conv lt (phi zero (phi zero (om (om ii)))) (plus (phi zero zero) (phi ii ii)) = false ;
#conv lt (phi (plus (psi ii zero) ii) ii) (phi (om (om (om (om ii)))) zero) = true ;
#conv lt (phi (plus ii (om (om ii))) zero) (phi (phi ii (phi zero zero)) zero) = true ;
#conv lt (psi ii (om (om ii))) (phi (phi (psi ii ii) ii) zero) = true ;
#conv lt (om (phi (phi zero ii) (om ii))) (phi (om (phi zero zero)) zero) = false ;
#conv lt (om (om (om (phi zero ii)))) (phi (psi ii (phi zero ii)) zero) = false ;
#conv lt (phi ii (phi zero (om ii))) (phi (phi zero ii) (psi ii ii)) = false ;
#conv lt (phi (om (psi ii zero)) (om ii)) (phi (plus ii (om ii)) ii) = false ;
#conv lt (phi (om (om (phi zero ii))) zero) (om (phi (psi ii ii) (om ii))) = false ;
#conv lt (phi (phi zero zero) (om ii)) (phi (phi ii ii) (psi ii ii)) = false ;
#conv lt (plus (om (psi ii zero)) (om ii)) (plus (phi (om ii) (om ii)) ii) = true ;
#conv lt (phi zero (om (om (om (om ii))))) (phi (plus (phi ii zero) ii) zero) = false ;
#conv lt (phi (om ii) (phi ii (om ii))) (psi ii (om (phi (om ii) ii))) = false ;
#conv lt (phi (plus (om (om ii)) ii) zero) (plus (phi zero (om (om ii))) ii) = false ;
#conv lt (phi (phi (om ii) ii) (om ii)) (phi (om ii) (phi ii (om ii))) = false ;
#conv lt (plus (phi ii zero) (phi ii zero)) (om (plus ii (om (psi ii ii)))) = true ;
#conv lt (phi ii (om (om (plus ii ii)))) (phi zero (phi ii (psi ii zero))) = false ;
#conv lt (om (psi ii ii)) (plus ii (phi ii ii)) = true ;
#conv lt (om (om (om (om (om (om ii)))))) (plus (psi ii ii) (phi zero zero)) = false ;
#conv lt (phi (phi ii (phi zero ii)) ii) (phi (om (om (psi ii ii))) zero) = false ;
#conv lt (phi ii (plus (om (om ii)) ii)) (om (phi ii (om (plus ii ii)))) = true ;
#conv lt (phi zero (phi zero (phi ii zero))) (plus (om (om (psi ii zero))) ii) = false ;
#conv lt (phi (om (phi zero zero)) (om ii)) (phi (phi zero (psi ii ii)) zero) = false ;
#conv lt (plus (om (phi (om ii) zero)) ii) (phi (phi ii zero) (psi ii zero)) = false ;
#conv lt (phi (phi (phi zero ii) ii) ii) (phi ii (phi ii ii)) = false ;
#conv lt (psi ii (om (om (phi zero ii)))) (psi ii (phi zero (plus ii ii))) = false ;
#conv lt (phi (psi ii ii) (om (om ii))) (phi ii (om (plus ii ii))) = false ;
#conv lt (phi (psi ii zero) (om (om ii))) (phi (psi ii (om (om ii))) zero) = false ;
#conv lt (phi zero (phi zero (phi zero zero))) (phi (phi ii ii) (phi ii zero)) = true ;
#conv lt (om (om (phi (phi ii ii) ii))) (phi (phi zero ii) (phi ii zero)) = false ;
#conv lt (phi (om (om (om (om ii)))) zero) (om (phi ii (phi ii zero))) = false ;
#conv lt (phi zero (psi ii (phi zero ii))) (phi (om (plus (om ii) ii)) zero) = true ;
#conv lt (phi ii (phi (phi zero ii) ii)) (plus ii (om (psi ii zero))) = false ;
#conv lt (om (psi ii (om (phi zero zero)))) (plus (om (om ii)) (plus ii ii)) = true ;
#conv lt (plus (phi (om ii) zero) ii) (plus (phi ii ii) (om (om ii))) = false ;
#conv lt (om (om (phi zero ii))) (plus ii (om (phi zero zero))) = false ;
#conv lt zero (plus (phi ii ii) (phi zero ii)) = true ;
#conv lt (phi (phi (om (om ii)) zero) zero) (phi zero (om (om (om ii)))) = true ;
#conv lt (om (psi ii (om (psi ii zero)))) (om (plus (phi (om ii) zero) ii)) = true ;
#conv lt (phi (om (om ii)) (om ii)) (phi (plus ii ii) ii) = false ;
#conv lt (phi (phi (om (om ii)) zero) zero) (phi zero (plus ii (psi ii zero))) = false ;
#conv lt (phi ii (phi (om ii) (om ii))) (om (om (om (phi ii (om ii))))) = true ;
#conv lt (psi ii ii) (phi ii (phi zero (phi ii zero))) = true ;
