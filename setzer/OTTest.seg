#conv lt (phi ii (psi ii (phi zero zero))) (psi ii (om (psi ii (om ii)))) = false ;
#conv lt (phi (phi ii ii) (om (om ii))) (plus ii (phi ii (phi zero zero))) = false ;
#conv lt (plus (phi zero zero) (om ii)) (phi (om (phi (om ii) zero)) ii) = true ;
