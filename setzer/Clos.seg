-- Clos.seg: Setzer (APAL 92, 1998), Section 4.3, the closure properties:
-- Definition 4.14, Remark 4.15, Lemma 4.16, Lemma 4.17, and the comparison
-- x, y <' x + y for sums that Def. 4.14(a) needs.  The mirror is
-- tools/otclos.py; every statement was tested on it first (catlt 7,
-- rem415 7, lem416 6, lem417 6).  Lemma 4.17 (b), (c) are in Lem417.seg.
--
-- x, y <' cat x y (cat x y the sum (x1..xn, y1..ym), x, y /= 0):
--   (a) x in T'  =>  x <' cat x y                                cat-lt-l
--   (b) x in T', cat x y in OT  =>  y <' cat x y                  cat-lt-r
-- Proof, by induction on x.  (a) x an atom g: cat g y = (g, y) and
-- g <' (g, ..) by clause (2) (lt-head).  x = (x0, xs): cat x y =
-- (x0, cat xs y), and xs <' cat xs y by induction, so x <' cat x y by (2)
-- (lex-PP, equal heads).  (b) x an atom g: y <' (g, y), the tail of a sum in
-- OT is below it (OTF.sum-lt).  x = (x0, xs): y <' cat xs y by induction
-- (cat xs y in OT, the tail of cat x y), and cat xs y <' (x0, cat xs y)
-- (sum-lt); transitivity.
-- (b) needs OT: on T' it fails for x = I, y = Omega'_I (otclos.py catlt:
-- 695447 of the 1392400 pairs of size <= 7 outside OT; none inside).
-- Corollary: z =NF x + y => x, y <' z (nf-lt), so a class B weakly downward
-- closed for sums stays so when cut at any b (wdc-cap); this is the step
-- from "x, y in A" (Def. 4.14(a)) to the class form WDC (A n a~) of CA.seg.
--
-- Definition 4.14 (A, C classes; "x in OT" quantifiers kept as hypotheses):
--   (a) A weakly downward closed: for z in A,
--       z =NF' x + y, z =NF phi_x y => x, y in A;  z =NF Omega_x => x in A;
--       z =NF psi_kappa y, kappa in R => kappa^- in A.             WD
--   (b) A downward closed: WD, and for z in A, z =NF x + y (any split) =>
--       x, y in A;  x in A => x~, x^-Fi, x^-I in A;  kappa in R n A =>
--       kappa^- in A.                                              DC
--       (Setzer writes x^{-1}; we read x^{-I} (Def. 2.13(c)), as in 4.7(g).)
--   (c) A weakly upward closed bounded by C: for x, y in A, z in OT n C,
--       z =NF' x + y, z =NF phi_x y, z =NF Omega_x => z in A;
--       0 in C => 0 in A;  I in C => I in A.                       WU
--   (d) A upward closed bounded by C: for x, y in A and z in OT n C,
--       z = x + y, phi_x y, Omega_x, x+ => z in A; 0, I as in (c).  UC
--   (e) bounded by OT.
-- "z <=' C" for a class C is read as z in C, a term a standing for the class
-- {x | x <' a} (Bnd a).  The reading z <=' a fails: tau^A(a) is not upward
-- closed bounded by a in that sense (Lemma 4.16(a)); otclos.py lem416: it
-- fails in 5748 of 7209 instances.
--
-- Remark 4.15.  A c OT weakly downward closed and weakly upward closed bounded
-- by C, A c C, C an initial segment of OT (Ini: z, c in OT, z <=' c in C =>
-- z in C)  =>  A downward closed and upward closed bounded by C.   rem415
-- (Setzer: "Easy".  C is an initial segment in all his uses: OT, a, kappa+.
-- The proof below uses it for the intermediate terms, which are <=' a
-- member of C.)
-- Proof.  Write z <=' x for "z in C" when x in C (Ini).
--   0 in A if A is not empty (0 <=' x in C); I in A if I <=' x in A.
--   Sums.  For z = cat p u in A: Sums(A, u) and p in A (CA.qq, from WD by
--   induction on u).  Conversely (up-cat, induction on u): p in A, Sums(A, u),
--   cat p u in OT n C => cat p u in A: u an atom: cat p u =NF' p + u, WU;
--   u = (u0, us): cat p u = cat (cat p u0) us (CA.cat-step), cat p u0 =NF'
--   p + u0 is in C (cat p u0 <' cat p u, cat-lt-l) so in A by WU, then
--   induction.  So z =NF x + y in A gives x in A (qq) and y in A: y an atom,
--   Sums(A, y); y = (y0, ys) = cat y0 ys, up-cat at y0 (y <' z, cat-lt-r).
--   x + y (u-sum): y = 0: x.  Otherwise x + y = y, or x + y = cat p y with p
--   x or a part of x = cat p q (add-cat, induction on x along Def. 2.10(a));
--   p in A (qq), Sums(A, y) (sums-of), up-cat.
--   phi_x y (u-phi): y, x, or phi'_x y =NF phi_x y (WU).  Omega_x (u-om): x
--   (x in Fi or 0), or Omega'_x =NF Omega_x (WU).
--   s+1 and Omega_{s+1} for s in A (suc-up): 1 = phi_0 0 in A, s + 1 by u-sum,
--   Omega_{s+1} by u-om; the terms are <=' Omega_{s+1}.
--   x+ (u-up, induction on x, by Def. 2.13(b)): 0+ = Omega_{0+1}; a sum, phi:
--   induction at the head, at max{b, c}; psi_I c, Omega'_b, I: Omega_{s+1}
--   for s = x, b, I; psi_kappa c, kappa /= I: kappa = Omega'_e, e = s+1
--   (s = pred1 e), kappa^- = Omega_s in A (WD), so s in A (om-inv: Omega_s is
--   s, or Omega'_s =NF Omega_s), and kappa = Omega_{s+1} (suc-up).
--   x~ (d-tilde, induction on x): 0; the head; max{b, c}; kappa^- for
--   psi_kappa c (WD); x itself otherwise.
--   x^-Fi (d-mFi).  The psi case asks for kappa^-Fi with only kappa^- in A,
--   and kappa^- is not a subterm.  Induction on t of the pair
--     (1) hd(t) in A => t^-Fi in A;
--     (2) t in R \ {I}, t^- in A => t^-Fi in A.
--   (1) at psi_kappa c, kappa /= I: psi_kappa c^-Fi = kappa^-Fi, (2) at kappa.
--   (2) at Omega'_e (e = s+1): Omega'_e^-Fi = e^-Fi = hd(e)^-Fi; s = 0:
--   e = 1, 1^-Fi = 0; otherwise s in A (om-inv), hd(e) = hd(s) in A, (1) at e.
--   x^-I: 0 or I.  kappa^- for kappa in R n A (d-R): I^- = 0; kappa =
--   Omega'_e: e in A (WD), e = s+1 =NF' s + 1 (s /= 0), s in A, Omega_s in A by
--   u-om (Omega_s = kappa^- <' kappa).

--
-- Lemma 4.16 (a in OT):
--   (a) A c M(A), A n a~ weakly downward closed =>
--       C^a(A) downward closed and upward closed                rem416a-C
--       tau^A(a) downward closed and upward closed bounded by a  rem416a-tau
--       W(A) n a+ and M(A) n a+ downward closed                  rem416a-W, rem416a-M
--   (b) A c OT, k in OT, A n k [= W(A) => A n k weakly downward closed   rem416b
--       (A c OT and k in OT are not in Setzer's statement; the comparison
--       u <' z <' k needs u in T'.  In the use, 4.17(b), A c M(A) c OT.)
-- Lemma 4.17 (a): 0 in W(A)                                     rem417a
--
-- Proof of 4.16(a).  C^a(A): by Remark 4.15 with C = OT.  C^a(A) = C^{a~}(A)
-- (4.7(a)), and C^b(A), b = a~, is weakly downward closed (wd-C):
--   sums: u in C^b(A), u /= 0 => Sums(C^b(A), u) (ca-sums, induction on u: by
--   4.4(c) the head and tail are in, or u in A n b, whose summands are in
--   A n b c C^b(A) (CA.sums-of, 4.7(h))); and Sums(C^b(A), x) => x in C^b(A)
--   (sums-C).  So z = cat x y in C^b(A) gives x, y in C^b(A).
--   phi, Omega: z in A n b (then the parts are in A n b c C^b(A)) or the
--   parts are in C^b(A) (4.4(c)).
--   psi_k y: z in A n b (then k^- in A n b), or b <' k and k in C^b(A) (4.4(d));
--   k = I: k^- = 0.  k = Omega'_e: not in A n b (b <' k), so e in C^b(A);
--   e = s + 1 = cat s 1, s in C^b(A) by the sums case, so k^- = Omega_s in C^b(A)
--   (km-C).  (Setzer's "by the first part of this proof".)
-- Weakly upward closed: 4.4(b), (c), sums by CA.s-cat (wu-C).
--   tau^A(a) = C^a(A) n a: Remark 4.15 with C = a; WD of B n a from WD of B,
-- since the parts named in 4.14(a) are <' z (wd-cap: nf-lt; phi-below; lt-om;
-- k^- <' psi_k y); WU of B n a bounded by a from WU of B (wu-cap).
--   W(A) n a+, M(A) n a+ (dc-below): x in it is in C^x(A) (x in M(A)), which is
-- downward closed (A n x~ is weakly downward closed: x~ <=' a~ (til-up, from
-- WA.til-bound), wd-cap and A n a~ n x~ = A n x~).  Every term y that
-- 4.14(a), (b) names is <=' x (parts <' x; x~, x^-Fi, x^-I <=' x by 2.14(f),
-- (g) (mfi-le), 2.13(c); k^- <' k).  y = x: done.  y <' x: y in tau^A(x)
-- c W(A) (4.13(a)), resp. y in C^y(A) by 4.7(b) (y <=' x).
-- Proof of 4.16(b) (seg-back: z in A n k, y in C^z(A), y <' z => y in
-- tau^A(z) c W(A), and (A n k)|z = W(A)|z, so y in A n k).  z in A n k is in
-- W(A) c M(A), so z in C^z(A), and not by z in A n z: by 4.4(c), (d) its parts
-- are in C^z(A) (own-plus, own-phi, own-om, own-psi).  phi, Omega: seg-back.
--   Sums (bs, induction on x): z = cat x g, g an atom.  x = g0 an atom: z =
--   (g0, g), seg-back.  x = (x0, xs): z = (x0, cat xs g); x0, cat xs g in C^z(A);
--   cat xs g in A n k (seg-back), so xs, g in A n k by induction; xs in A n z
--   c C^z(A) (4.7(h)), so x = (x0, xs) in C^z(A) (4.4(c)) and x <' z: seg-back.
--   (Setzer splits sums at the last summand, as in his Def. 5.3, and reads the
--   parts off directly; with the head split of CA.seg this induction is needed.)
--   psi_p y: z <' p, p in C^z(A) (4.4(d)); A n z is weakly downward closed for
--   sums (the sums case, z <' k), so p^- in C^z(A) (km-C, as in (a)), p^- <' z.
--   (This replaces Setzer's case split on x <=' z+1 and his use of 0 in W(A).)
-- Proof of 4.17(a): 0 in M(A) (4.9(d)) and tau^A(0) is empty; 4.10(a).
level kl ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
import OTF ;
import CA ;
import WA ;
open OT ;
open OTLaws[kl] ;
open OTTrans[kl] ;
open OTC[kl] ;
open OTF[kl] ;
open CA[kl] ;
open WA[kl] ;

------------------------------------------------------------------------
-- x, y <' cat x y

cat-lt-l : (x : T) -> TT x -> NZ x -> (y : T) -> LT x (cat x y) = split {
  zero -> \ tx nx y -> abT nx ;
  plus x0 xs | _ r -> \ tx nx y ->
    trans (lex-PP x0 xs x0 (cat xs y))
      (orIr (lt x0 x0) (and (eqT x0 x0) (lt xs (cat xs y)))
         (andI (eqT x0 x0) (lt xs (cat xs y)) (eqT-refl x0) (r (isT-plusS x0 xs tx) (tail-nz x0 xs tx) y))) ;
  phi a b -> \ tx nx y -> lt-head (phi a b) y (refl true) ;
  psi a b -> \ tx nx y -> lt-head (psi a b) y (refl true) ;
  om a -> \ tx nx y -> lt-head (om a) y (refl true) ;
  ii -> \ tx nx y -> lt-head ii y (refl true) } ;

-- the step (x0, xs): y <' cat xs y <' (x0, cat xs y)
cat-lt-r-P (x0 xs y : T) (txs : TT xs) (nxs : NZ xs) (o : OK (plus x0 (cat xs y))) (ih : LT y (cat xs y))
  : LT y (plus x0 (cat xs y)) =
  trOT y (cat xs y) (plus x0 (cat xs y))
    (cat-OK xs y txs nxs (ot-plusS x0 (cat xs y) o)).2 (ot-plusS x0 (cat xs y) o) o
    ih (sum-lt (cat xs y) x0 o) ;

cat-lt-r : (x : T) -> TT x -> NZ x -> (y : T) -> OK (cat x y) -> LT y (cat x y) = split {
  zero -> \ tx nx y o -> abT nx ;
  plus x0 xs | _ r -> \ tx nx y o ->
    cat-lt-r-P x0 xs y (isT-plusS x0 xs tx) (tail-nz x0 xs tx) o
      (r (isT-plusS x0 xs tx) (tail-nz x0 xs tx) y (ot-plusS x0 (cat xs y) o)) ;
  phi a b -> \ tx nx y o -> sum-lt y (phi a b) o ;
  psi a b -> \ tx nx y o -> sum-lt y (psi a b) o ;
  om a -> \ tx nx y o -> sum-lt y (om a) o ;
  ii -> \ tx nx y o -> sum-lt y ii o } ;

-- the parts of z =NF x + y (accessors)
nfs-e (z x y : T) (h : NFsum z x y) : Id T z (cat x y) = h.1 ;
nfs-tx (z x y : T) (h : NFsum z x y) : TT x = h.2.1 ;
nfs-ty (z x y : T) (h : NFsum z x y) : TT y = h.2.2.1 ;
nfs-nx (z x y : T) (h : NFsum z x y) : NZ x = h.2.2.2.1 ;
nfs-ny (z x y : T) (h : NFsum z x y) : NZ y = h.2.2.2.2.1 ;
nfs-ok (z x y : T) (h : NFsum z x y) : OK z = h.2.2.2.2.2 ;

-- z =NF x + y  =>  x, y in OT  and  x, y <' z
nfs-OK (z x y : T) (h : NFsum z x y) : OK x * OK y =
  cat-OK x y (nfs-tx z x y h) (nfs-nx z x y h) (nf-OK z (cat x y) (nfs-e z x y h) (nfs-ok z x y h)) ;

nf-lt (z x y : T) (h : NFsum z x y) : LT x z * LT y z =
  (subst (\ s -> LT x s) (sym (nfs-e z x y h)) (cat-lt-l x (nfs-tx z x y h) (nfs-nx z x y h) y),
   subst (\ s -> LT y s) (sym (nfs-e z x y h))
     (cat-lt-r x (nfs-tx z x y h) (nfs-nx z x y h) y (nf-OK z (cat x y) (nfs-e z x y h) (nfs-ok z x y h)))) ;

-- B weakly downward closed for sums  =>  so is B n b
wdc-cap (B : Cl) (b : T) (tb : TT b) (w : WDC B) : WDC (Cap B b) =
  \ z x y h m ->
    let { p : B x * B y = w z x y h m.1 ;
          l : LT x z * LT y z = nf-lt z x y h.1 ;
          o : OK x * OK y = nfs-OK z x y h.1 ; }
    in ((p.1, tr3 x z b (ot-T x o.1) (ot-T z (nfs-ok z x y h.1)) tb l.1 m.2),
        (p.2, tr3 y z b (ot-T y o.2) (ot-T z (nfs-ok z x y h.1)) tb l.2 m.2)) ;

------------------------------------------------------------------------
-- Definition 4.14

-- (a)
WDs (A : Cl) : U kl = (z x y : T) -> OK x -> OK y -> A z -> NFsum' z x y -> A x * A y ;
WDp (A : Cl) : U kl = (z x y : T) -> OK x -> OK y -> A z -> NFphi z x y -> A x * A y ;
WDo (A : Cl) : U kl = (z x : T) -> OK x -> A z -> NFom z x -> A x ;
WDk (A : Cl) : U kl = (z k y : T) -> OK y -> Tr (isR k) -> A z -> NFpsi z k y -> A (kminus k) ;
WD (A : Cl) : U kl = WDs A * (WDp A * (WDo A * WDk A)) ;
wd-s (A : Cl) (w : WD A) : WDs A = w.1 ;
wd-p (A : Cl) (w : WD A) : WDp A = w.2.1 ;
wd-o (A : Cl) (w : WD A) : WDo A = w.2.2.1 ;
wd-k (A : Cl) (w : WD A) : WDk A = w.2.2.2 ;

-- (b)
DSum (A : Cl) : U kl = (z x y : T) -> OK x -> OK y -> A z -> NFsum z x y -> A x * A y ;
DCard (A : Cl) : U kl = (x : T) -> A x -> A (tilde x) * (A (mFi x) * A (mI x)) ;
DR (A : Cl) : U kl = (k : T) -> Tr (isR k) -> A k -> A (kminus k) ;
DC (A : Cl) : U kl = WD A * (DSum A * (DCard A * DR A)) ;

-- (c)
WUs (A Bd : Cl) : U kl = (z x y : T) -> A x -> A y -> OK z -> Bd z -> NFsum' z x y -> A z ;
WUp (A Bd : Cl) : U kl = (z x y : T) -> A x -> A y -> OK z -> Bd z -> NFphi z x y -> A z ;
WUo (A Bd : Cl) : U kl = (z x : T) -> A x -> OK z -> Bd z -> NFom z x -> A z ;
WU0 (A Bd : Cl) : U kl = (Bd zero -> A zero) * (Bd ii -> A ii) ;
WU (A Bd : Cl) : U kl = WUs A Bd * (WUp A Bd * (WUo A Bd * WU0 A Bd)) ;
wu-s (A Bd : Cl) (u : WU A Bd) : WUs A Bd = u.1 ;
wu-p (A Bd : Cl) (u : WU A Bd) : WUp A Bd = u.2.1 ;
wu-o (A Bd : Cl) (u : WU A Bd) : WUo A Bd = u.2.2.1 ;
wu-0 (A Bd : Cl) (u : WU A Bd) : WU0 A Bd = u.2.2.2 ;

-- (d)
USum (A Bd : Cl) : U kl = (x y : T) -> A x -> A y -> OK (add x y) -> Bd (add x y) -> A (add x y) ;
UPhi (A Bd : Cl) : U kl = (x y : T) -> A x -> A y -> OK (phiF x y) -> Bd (phiF x y) -> A (phiF x y) ;
UOm (A Bd : Cl) : U kl = (x : T) -> A x -> OK (omF x) -> Bd (omF x) -> A (omF x) ;
UUp (A Bd : Cl) : U kl = (x : T) -> A x -> OK (up x) -> Bd (up x) -> A (up x) ;
UC (A Bd : Cl) : U kl = USum A Bd * (UPhi A Bd * (UOm A Bd * (UUp A Bd * WU0 A Bd))) ;

-- a term as a bound: {x | x <' a}
Bnd (a x : T) : U kl = LT x a ;

-- C an initial segment of OT
Ini (Bd : Cl) : U kl = (z c : T) -> OK z -> OK c -> Tr (le z c) -> Bd c -> Bd z ;

------------------------------------------------------------------------
-- Remark 4.15

-- the hypotheses: A c OT, C initial, A WD, A WU bounded by C, A c C
H415 (A Bd : Cl) : U kl = Sub A OTc * (Ini Bd * (WD A * (WU A Bd * Sub A Bd))) ;
h-ot (A Bd : Cl) (h : H415 A Bd) : Sub A OTc = h.1 ;
h-ini (A Bd : Cl) (h : H415 A Bd) : Ini Bd = h.2.1 ;
h-wd (A Bd : Cl) (h : H415 A Bd) : WD A = h.2.2.1 ;
h-wu (A Bd : Cl) (h : H415 A Bd) : WU A Bd = h.2.2.2.1 ;
h-sub (A Bd : Cl) (h : H415 A Bd) : Sub A Bd = h.2.2.2.2 ;

-- z <=' x in A  =>  z in C
h-below (A Bd : Cl) (h : H415 A Bd) (z x : T) (oz : OK z) (l : Tr (le z x)) (a : A x) : Bd z =
  h-ini A Bd h z x oz (h-ot A Bd h x a) l (h-sub A Bd h x a) ;
-- z <=' x in C  =>  z in C
h-belowC (A Bd : Cl) (h : H415 A Bd) (z x : T) (oz : OK z) (ox : OK x) (l : Tr (le z x)) (c : Bd x) : Bd z =
  h-ini A Bd h z x oz ox l c ;

-- the sums clause of WD in the class form of CA.seg
wd-wdc (A : Cl) (w : WD A) : WDC A =
  \ z x y h a -> wd-s A w z x y (nfs-OK z x y h.1).1 (nfs-OK z x y h.1).2 a h ;

-- cat p g =NF' p + g, g an atom
nfs'-cat (p g : T) (tp : TT p) (np : NZ p) (tg : TT g) (hg : Tr (isA g)) (o : OK (cat p g)) : NFsum' (cat p g) p g =
  ((refl (cat p g), (tp, (tg, (np, (A-nz g hg, o))))), hg) ;

-- up-cat, an atom u = g
up-atom (A Bd : Cl) (h : H415 A Bd) (g : T) (hg : Tr (isA g)) (tg : TT g)
  (p : T) (tp : TT p) (np : NZ p) (ap : A p) (s : Sums A g) (o : OK (cat p g)) (c : Bd (cat p g)) : A (cat p g) =
  wu-s A Bd (h-wu A Bd h) (cat p g) p g ap (sums-A A g hg s) o c (nfs'-cat p g tp np tg hg o) ;

UpH (A Bd : Cl) (u : T) : U kl =
  (p : T) -> TT p -> NZ p -> A p -> Sums A u -> OK (cat p u) -> Bd (cat p u) -> A (cat p u) ;

-- up-cat, u = (u0, us): cat p u = cat (cat p u0) us
up-plus (A Bd : Cl) (h : H415 A Bd) (u0 us : T) (tu : TT (plus u0 us)) (r : UpH A Bd us)
  (p : T) (tp : TT p) (np : NZ p) (ap : A p) (s : Sums A (plus u0 us))
  (o : OK (cat p (plus u0 us))) (c : Bd (cat p (plus u0 us))) : A (cat p (plus u0 us)) =
  let { hA : Tr (isA u0) = isT-plusA u0 us tu ;
        tp1 : TT (cat p u0) = cat-TT p tp np u0 (isT-plus0 u0 us tu) (A-nz u0 hA) ;
        np1 : NZ (cat p u0) = cat-NZ p np u0 ;
        e : Id T (cat (cat p u0) us) (cat p (plus u0 us)) = cat-step p u0 us hA ;
        o' : OK (cat (cat p u0) us) = nf-OK (cat p (plus u0 us)) (cat (cat p u0) us) (sym e) o ;
        c' : Bd (cat (cat p u0) us) = tr-B Bd (cat p (plus u0 us)) (cat (cat p u0) us) (sym e) c ;
        op1 : OK (cat p u0) = (cat-OK (cat p u0) us tp1 np1 o').1 ;
        cp1 : Bd (cat p u0) = h-belowC A Bd h (cat p u0) (cat (cat p u0) us) op1 o' (le-of-lt (cat p u0) (cat (cat p u0) us) (cat-lt-l (cat p u0) tp1 np1 us)) c' ;
        ap1 : A (cat p u0) = wu-s A Bd (h-wu A Bd h) (cat p u0) p u0 ap s.1 op1 cp1 (nfs'-cat p u0 tp np (isT-plus0 u0 us tu) hA op1) ; }
  in tr-B A (cat (cat p u0) us) (cat p (plus u0 us)) e (r (cat p u0) tp1 np1 ap1 s.2 o' c') ;

up-cat (A Bd : Cl) (h : H415 A Bd) : (u : T) -> TT u -> NZ u -> UpH A Bd u = split {
  zero -> \ t n -> abT n ;
  plus u0 us | _ r -> \ t n -> up-plus A Bd h u0 us t (r (isT-plusS u0 us t) (tail-nz u0 us t)) ;
  phi x0 x1 -> \ t n -> up-atom A Bd h (phi x0 x1) (refl true) t ;
  psi x0 x1 -> \ t n -> up-atom A Bd h (psi x0 x1) (refl true) t ;
  om x0 -> \ t n -> up-atom A Bd h (om x0) (refl true) t ;
  ii -> \ t n -> up-atom A Bd h ii (refl true) t } ;

-- u in OT n C, u /= 0, Sums(A, u)  =>  u in A
sums-in (A Bd : Cl) (h : H415 A Bd) : (u : T) -> OK u -> NZ u -> Sums A u -> Bd u -> A u = split {
  zero -> \ o n s c -> abT n ;
  plus u0 us -> \ o n s c ->
    let { t : TT (plus u0 us) = ot-T (plus u0 us) o ;
          hA : Tr (isA u0) = isT-plusA u0 us t ;
          e : Id T (cat u0 us) (plus u0 us) = cat-A u0 hA us ; }
    in tr-B A (cat u0 us) (plus u0 us) e
         (up-cat A Bd h us (isT-plusS u0 us t) (tail-nz u0 us t) u0 (isT-plus0 u0 us t) (A-nz u0 hA) s.1 s.2
            (nf-OK (plus u0 us) (cat u0 us) (sym e) o) (tr-B Bd (plus u0 us) (cat u0 us) (sym e) c)) ;
  phi x0 x1 -> \ o n s c -> s ;
  psi x0 x1 -> \ o n s c -> s ;
  om x0 -> \ o n s c -> s ;
  ii -> \ o n s c -> s } ;

-- (b), sums: z =NF x + y in A  =>  x, y in A
d-sum (A Bd : Cl) (h : H415 A Bd) : DSum A =
  \ z x y ox oy a hs ->
    let { o : OK (cat x y) = nf-OK z (cat x y) (nfs-e z x y hs) (nfs-ok z x y hs) ;
          q : Sums A y * A x = qq A (h-ot A Bd h) (wd-wdc A (h-wd A Bd h)) y (nfs-ty z x y hs) (nfs-ny z x y hs)
                                x (nfs-tx z x y hs) (nfs-nx z x y hs) (tr-B A z (cat x y) (nfs-e z x y hs) a) ; }
    in (q.2, sums-in A Bd h y oy (nfs-ny z x y hs) q.1
               (h-below A Bd h y z oy (le-of-lt y z (nf-lt z x y hs).2) a)) ;

-- the head of x in A is in A
hd-in (A Bd : Cl) (h : H415 A Bd) : (x : T) -> A x -> A (hd x) = split {
  zero -> \ a -> a ;
  plus x0 xs -> \ a ->
    let { o : OK (plus x0 xs) = h-ot A Bd h (plus x0 xs) a ;
          t : TT (plus x0 xs) = ot-T (plus x0 xs) o ;
          hA : Tr (isA x0) = isT-plusA x0 xs t ; }
    in (qq A (h-ot A Bd h) (wd-wdc A (h-wd A Bd h)) xs (isT-plusS x0 xs t) (tail-nz x0 xs t)
          x0 (isT-plus0 x0 xs t) (A-nz x0 hA) (tr-B A (plus x0 xs) (cat x0 xs) (sym (cat-A x0 hA xs)) a)).2 ;
  phi x0 x1 -> \ a -> a ;
  psi x0 x1 -> \ a -> a ;
  om x0 -> \ a -> a ;
  ii -> \ a -> a } ;

------------------------------------------------------------------------
-- Closed computations

ok-zero : OK zero = refl true ;
ok-ii : OK ii = refl true ;
ok-one : OK one = refl true ;
-- 1^-Fi = 0
mfi-one : Id T (mFi one) zero = refl zero ;
-- 0+ = Omega_1 = Omega_{0+1}
up-zero : Id T (up zero) (omF (suc zero)) = refl (om one) ;
-- 1 =NF phi_0 0
nfphi-one : NFphi one zero zero = (refl one, ok-one) ;

-- 0 and I
zero-in (A Bd : Cl) (h : H415 A Bd) (x : T) (a : A x) : A zero =
  (wu-0 A Bd (h-wu A Bd h)).1 (h-below A Bd h zero x ok-zero (zero-le-any x) a) ;
ii-in (A Bd : Cl) (h : H415 A Bd) (x : T) (l : Tr (le ii x)) (a : A x) : A ii =
  (wu-0 A Bd (h-wu A Bd h)).2 (h-below A Bd h ii x ok-ii l a) ;

-- 1 = phi_0 0
one-in (A Bd : Cl) (h : H415 A Bd) (x : T) (a : A x) (c : Bd one) : A one =
  wu-p A Bd (h-wu A Bd h) one zero zero (zero-in A Bd h x a) (zero-in A Bd h x a) ok-one c nfphi-one ;

------------------------------------------------------------------------
-- x + y as cat p y (Def. 2.10(a)), p = x or x = cat p q

Pre (p x : T) : U kl = Or (Id T p x) ((q : T) * (Id T x (cat p q) * (TT q * NZ q))) ;
AddC (x y : T) : U kl = Or (Id T (add x y) y) ((p : T) * (Id T (add x y) (cat p y) * (TT p * (NZ p * Pre p x)))) ;

-- (x0, p') for (x0, xs)
pre-P (x0 xs p : T) (pr : Pre p xs) : Pre (plus x0 p) (plus x0 xs) =
  either (Id T p xs) ((q : T) * (Id T xs (cat p q) * (TT q * NZ q))) (Pre (plus x0 p) (plus x0 xs))
    (\ e -> inl (ap (\ s -> plus x0 s) e))
    (\ w -> inr (w.1, (ap (\ s -> plus x0 s) w.2.1, w.2.2)))
    pr ;

-- an atom g: g + y = (g, y) or y
add-cat-A (g : T) (hA : Tr (isA g)) (tg : TT g) (y : T) (ny : NZ y) : AddC g y =
  boolCases (AddC g y) (le (hd y) g)
    (\ l -> inr (g, (trans (add-A g y ny (addA g hA y)) (trans (ifT-t (le (hd y) g) (plus g y) y l) (sym (cat-A g hA y))),
                     (tg, (A-nz g hA, inl (refl g))))))
    (\ l -> inl (trans (add-A g y ny (addA g hA y)) (ifT-f (le (hd y) g) (plus g y) y l))) ;

-- (x0, xs) + y = (x0, xs + y) or y
add-cat-P (x0 xs : T) (tx : TT (plus x0 xs)) (y : T) (ny : NZ y) (ih : AddC xs y) : AddC (plus x0 xs) y =
  boolCases (AddC (plus x0 xs) y) (le (hd y) x0)
    (\ l -> either (Id T (add xs y) y) ((p : T) * (Id T (add xs y) (cat p y) * (TT p * (NZ p * Pre p xs)))) (AddC (plus x0 xs) y)
       (\ e -> inr (x0, (trans (add-P x0 xs y ny) (trans (ifT-t (le (hd y) x0) (plus x0 (add xs y)) y l)
                                 (trans (ap (\ s -> plus x0 s) e) (sym (cat-A x0 (isT-plusA x0 xs tx) y)))),
                         (isT-plus0 x0 xs tx, (A-nz x0 (isT-plusA x0 xs tx),
                          inr (xs, (sym (cat-A x0 (isT-plusA x0 xs tx) xs), (isT-plusS x0 xs tx, tail-nz x0 xs tx))))))))
       (\ w -> inr (plus x0 w.1, (trans (add-P x0 xs y ny) (trans (ifT-t (le (hd y) x0) (plus x0 (add xs y)) y l)
                                       (ap (\ s -> plus x0 s) w.2.1)),
                                (tt-plusA x0 w.1 (isT-plusA x0 xs tx) (isT-plus0 x0 xs tx) w.2.2.1 w.2.2.2.1,
                                 (refl false, pre-P x0 xs w.1 w.2.2.2.2)))))
       ih)
    (\ l -> inl (trans (add-P x0 xs y ny) (ifT-f (le (hd y) x0) (plus x0 (add xs y)) y l))) ;

add-cat : (x : T) -> TT x -> (y : T) -> NZ y -> AddC x y = split {
  zero -> \ tx y ny -> inl (refl y) ;
  plus x0 xs | _ r -> \ tx y ny -> add-cat-P x0 xs tx y ny (r (isT-plusS x0 xs tx) y ny) ;
  phi a b -> \ tx y ny -> add-cat-A (phi a b) (refl true) tx y ny ;
  psi a b -> \ tx y ny -> add-cat-A (psi a b) (refl true) tx y ny ;
  om a -> \ tx y ny -> add-cat-A (om a) (refl true) tx y ny ;
  ii -> \ tx y ny -> add-cat-A ii (refl true) tx y ny } ;

-- x + 0 = x (by definition of +)
add-zero : (x : T) -> Id T (add x zero) x = split {
  zero -> refl zero ; plus x0 xs -> refl (plus x0 xs) ; phi a b -> refl (phi a b) ;
  psi a b -> refl (psi a b) ; om a -> refl (om a) ; ii -> refl ii } ;

------------------------------------------------------------------------
-- Remark 4.15, upward closure

-- p = x or x = cat p q, x in A  =>  p in A
pre-in (A Bd : Cl) (h : H415 A Bd) (p x : T) (tp : TT p) (np : NZ p) (pr : Pre p x) (a : A x) : A p =
  either (Id T p x) ((q : T) * (Id T x (cat p q) * (TT q * NZ q))) (A p)
    (\ e -> tr-B A x p (sym e) a)
    (\ w -> (qq A (h-ot A Bd h) (wd-wdc A (h-wd A Bd h)) w.1 w.2.2.1 w.2.2.2 p tp np (tr-B A x (cat p w.1) w.2.1 a)).2)
    pr ;

-- x + y, y /= 0
u-sum-nz (A Bd : Cl) (h : H415 A Bd) (x y : T) (ax : A x) (ay : A y) (o : OK (add x y)) (c : Bd (add x y)) (ny : NZ y) : A (add x y) =
  either (Id T (add x y) y) ((p : T) * (Id T (add x y) (cat p y) * (TT p * (NZ p * Pre p x)))) (A (add x y))
    (\ e -> tr-B A y (add x y) (sym e) ay)
    (\ w -> tr-B A (cat w.1 y) (add x y) (sym w.2.1)
              (up-cat A Bd h y (ot-T y (h-ot A Bd h y ay)) ny w.1 w.2.2.1 w.2.2.2.1
                 (pre-in A Bd h w.1 x w.2.2.1 w.2.2.2.1 w.2.2.2.2 ax)
                 (sums-of A (h-ot A Bd h) (wd-wdc A (h-wd A Bd h)) y (ot-T y (h-ot A Bd h y ay)) ny ay)
                 (nf-OK (add x y) (cat w.1 y) w.2.1 o) (tr-B Bd (add x y) (cat w.1 y) w.2.1 c)))
    (add-cat x (ot-T x (h-ot A Bd h x ax)) y ny) ;

u-sum (A Bd : Cl) (h : H415 A Bd) : USum A Bd =
  \ x y ax ay o c ->
    boolCases (A (add x y)) (isZero y)
      (\ z -> tr-B A x (add x y) (sym (trans (ap (\ s -> add x s) (isZero-true y z)) (add-zero x))) ax)
      (\ ny -> u-sum-nz A Bd h x y ax ay o c ny) ;

-- phi_x y: y, x, or phi'_x y =NF phi_x y (Def. 2.10(c))
u-phi (A Bd : Cl) (h : H415 A Bd) : UPhi A Bd =
  \ x y ax ay ->
    iteC (\ t -> OK t -> Bd t -> A t) (crit x y) y (ifT (and (isZero y) (isG x)) x (phi x y))
      (\ q o c -> ay)
      (\ q -> iteC (\ t -> OK t -> Bd t -> A t) (and (isZero y) (isG x)) x (phi x y)
                (\ q' o c -> ax)
                (\ q' o c -> wu-p A Bd (h-wu A Bd h) (phi x y) x y ax ay o c (refl (phi x y), o))) ;

-- Omega_x: x, or Omega'_x =NF Omega_x (Def. 2.10(d))
u-om (A Bd : Cl) (h : H415 A Bd) : UOm A Bd =
  \ x ax o c ->
    boolCases (A (omF x)) (fx x)
      (\ f -> tr-B A x (omF x) (sym (omF-fix x f)) ax)
      (\ f -> tr-B A (om x) (omF x) (sym (omF-mov x f))
                (wu-o A Bd (h-wu A Bd h) (om x) x ax (nf-OK (omF x) (om x) (omF-mov x f) o)
                   (tr-B Bd (omF x) (om x) (omF-mov x f) c) (refl (om x), nf-OK (omF x) (om x) (omF-mov x f) o))) ;

-- Omega_s in A  =>  s in A
om-inv (A Bd : Cl) (h : H415 A Bd) (s : T) (a : A (omF s)) : A s =
  boolCases (A s) (fx s)
    (\ f -> tr-B A (omF s) s (omF-fix s f) a)
    (\ f -> wd-o A (h-wd A Bd h) (om s) s
              (ot-om0 s (h-ot A Bd h (om s) (tr-B A (omF s) (om s) (omF-mov s f) a)))
              (tr-B A (omF s) (om s) (omF-mov s f) a)
              (refl (om s), h-ot A Bd h (om s) (tr-B A (omF s) (om s) (omF-mov s f) a))) ;

-- s in A  =>  Omega_{s+1} in A (if in Bd)
suc-up (A Bd : Cl) (h : H415 A Bd) (s : T) (as : A s) (c : Bd (omF (suc s))) : A (omF (suc s)) =
  let { os : OK s = h-ot A Bd h s as ;
        osuc : OK (suc s) = suc-OK s os ;
        c1 : Bd (suc s) = h-belowC A Bd h (suc s) (omF (suc s)) osuc (omF-OK (suc s) osuc) (le-omF (suc s) osuc) c ;
        cone : Bd one = h-belowC A Bd h one (suc s) ok-one osuc (le-add-r s os one ok-one) c1 ;
        asuc : A (suc s) = u-sum A Bd h s one as (one-in A Bd h s as cone) osuc c1 ; }
  in u-om A Bd h (suc s) asuc (omF-OK (suc s) osuc) c ;

-- kappa in R \ {I}, kappa^- in A  =>  kappa in A:  kappa = Omega'_e = Omega_{s+1}, Omega_s in A
R-in (A Bd : Cl) (h : H415 A Bd) : (k : T) -> Tr (isR k) -> Id Bool (isI k) false -> OK k -> A (kminus k) -> Bd k -> A k = split {
  zero -> \ r n o a c -> abF r ;
  plus x0 xs -> \ r n o a c -> abF r ;
  phi x0 x1 -> \ r n o a c -> abF r ;
  psi x0 x1 -> \ r n o a c -> abF r ;
  om e -> \ r n o a c ->
    tr-B A (omF (suc (pred1 e))) (om e) (om-suc-pred e o r)
      (suc-up A Bd h (pred1 e) (om-inv A Bd h (pred1 e) a) (tr-B Bd (om e) (omF (suc (pred1 e))) (sym (om-suc-pred e o r)) c)) ;
  ii -> \ r n o a c -> abT n } ;

-- the values of card at psi_x0 x1 (Def. 2.13(b))
card-psi-I (x0 x1 : T) (t : Tr (isI x0))
  : Id C4 (card (psi x0 x1)) (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) =
  ifQ-t (isI x0) (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0)) t ;
card-psi-R (x0 x1 : T) (n : Id Bool (isI x0) false) : Id C4 (card (psi x0 x1)) (cardS x0 (card x0)) =
  ifQ-f (isI x0) (psi x0 x1, (omF (suc (psi x0 x1)), (psi x0 x1, psi ii (suc x1)))) (cardS x0 (card x0)) n ;

-- the value of card at phi'_x0 x1 (Def. 2.13(b): those of max{x0, x1})
card-phi (x0 x1 : T) : Id C4 (card (phi x0 x1)) (ifQ (le x1 x0) (card x0) (card x1)) =
  refl (ifQ (le x1 x0) (card x0) (card x1)) ;

-- x+ in A (by recursion on x, Def. 2.13(b))
UpQ (A Bd : Cl) (x : T) : U kl = A x -> Bd (up x) -> A (up x) ;

u-up-phi (A Bd : Cl) (h : H415 A Bd) (x0 x1 : T) (r0 : UpQ A Bd x0) (r1 : UpQ A Bd x1) : UpQ A Bd (phi x0 x1) =
  \ a c ->
    let { o : OK (phi x0 x1) = h-ot A Bd h (phi x0 x1) a ;
          p : A x0 * A x1 = wd-p A (h-wd A Bd h) (phi x0 x1) x0 x1 (ot-phi0 x0 x1 o) (ot-phi1 x0 x1 o) a (refl (phi x0 x1), o) ;
          e : Id T (ifQ (le x1 x0) (card x0) (card x1)).2.1 (up (phi x0 x1)) = ap (\ k -> k.2.1) (sym (card-phi x0 x1)) ; }
    in tr-B A (ifQ (le x1 x0) (card x0) (card x1)).2.1 (up (phi x0 x1)) e
         (ifQ-G (\ k -> Bd k.2.1 -> A k.2.1) (le x1 x0) (card x0) (card x1) (\ q -> r0 p.1) (\ q -> r1 p.2)
            (tr-B Bd (up (phi x0 x1)) (ifQ (le x1 x0) (card x0) (card x1)).2.1 (sym e) c)) ;

u-up-psi (A Bd : Cl) (h : H415 A Bd) (x0 x1 : T) : UpQ A Bd (psi x0 x1) =
  \ a c ->
    let { o : OK (psi x0 x1) = h-ot A Bd h (psi x0 x1) a ; }
    in boolCases (A (up (psi x0 x1))) (isI x0)
         (\ t -> tr-B A (omF (suc (psi x0 x1))) (up (psi x0 x1)) (sym (ap (\ k -> k.2.1) (card-psi-I x0 x1 t)))
                   (suc-up A Bd h (psi x0 x1) a (tr-B Bd (up (psi x0 x1)) (omF (suc (psi x0 x1))) (ap (\ k -> k.2.1) (card-psi-I x0 x1 t)) c)))
         (\ n -> tr-B A x0 (up (psi x0 x1)) (sym (ap (\ k -> k.2.1) (card-psi-R x0 x1 n)))
                   (R-in A Bd h x0 (ot-psiR x0 x1 o) n (ot-psi0 x0 x1 o)
                      (wd-k A (h-wd A Bd h) (psi x0 x1) x0 x1 (ot-psi1 x0 x1 o) (ot-psiR x0 x1 o) a (refl (psi x0 x1), o))
                      (tr-B Bd (up (psi x0 x1)) x0 (ap (\ k -> k.2.1) (card-psi-R x0 x1 n)) c))) ;

u-up (A Bd : Cl) (h : H415 A Bd) : (x : T) -> UpQ A Bd x = split {
  zero -> \ a c -> tr-B A (omF (suc zero)) (up zero) (sym up-zero)
                     (suc-up A Bd h zero a (tr-B Bd (up zero) (omF (suc zero)) up-zero c)) ;
  plus x0 xs | r0 _ -> \ a c -> r0 (hd-in A Bd h (plus x0 xs) a) c ;
  phi x0 x1 | r0 r1 -> u-up-phi A Bd h x0 x1 r0 r1 ;
  psi x0 x1 -> u-up-psi A Bd h x0 x1 ;
  om x0 -> \ a c -> suc-up A Bd h x0
              (wd-o A (h-wd A Bd h) (om x0) x0 (ot-om0 x0 (h-ot A Bd h (om x0) a)) a (refl (om x0), h-ot A Bd h (om x0) a)) c ;
  ii -> \ a c -> suc-up A Bd h ii a c } ;

------------------------------------------------------------------------
-- Remark 4.15, the cardinals below x

-- x~ (by recursion on x, Def. 2.13(b))
d-tilde (A Bd : Cl) (h : H415 A Bd) : (x : T) -> A x -> A (tilde x) = split {
  zero -> \ a -> a ;
  plus x0 xs | r0 _ -> \ a -> r0 (hd-in A Bd h (plus x0 xs) a) ;
  phi x0 x1 | r0 r1 -> \ a ->
    let { o : OK (phi x0 x1) = h-ot A Bd h (phi x0 x1) a ;
          p : A x0 * A x1 = wd-p A (h-wd A Bd h) (phi x0 x1) x0 x1 (ot-phi0 x0 x1 o) (ot-phi1 x0 x1 o) a (refl (phi x0 x1), o) ; }
    in tr-B A (ifQ (le x1 x0) (card x0) (card x1)).1 (tilde (phi x0 x1)) (ap (\ k -> k.1) (sym (card-phi x0 x1)))
         (ifQ-G (\ k -> A k.1) (le x1 x0) (card x0) (card x1) (\ q -> r0 p.1) (\ q -> r1 p.2)) ;
  psi x0 x1 -> \ a ->
    let { o : OK (psi x0 x1) = h-ot A Bd h (psi x0 x1) a ; }
    in boolCases (A (tilde (psi x0 x1))) (isI x0)
         (\ t -> tr-B A (psi x0 x1) (tilde (psi x0 x1)) (sym (ap (\ k -> k.1) (card-psi-I x0 x1 t))) a)
         (\ n -> tr-B A (kminus x0) (tilde (psi x0 x1)) (sym (ap (\ k -> k.1) (card-psi-R x0 x1 n)))
                   (wd-k A (h-wd A Bd h) (psi x0 x1) x0 x1 (ot-psi1 x0 x1 o) (ot-psiR x0 x1 o) a (refl (psi x0 x1), o))) ;
  om x0 -> \ a -> a ;
  ii -> \ a -> a } ;

-- hd(s + 1) = hd(s), s /= 0
hd-suc : (s : T) -> TT s -> NZ s -> Id T (hd (suc s)) (hd s) = split {
  zero -> \ t n -> abT n ;
  plus x0 xs -> \ t n -> ap hd (suc-P x0 xs t) ;
  phi a b -> \ t n -> ap hd (suc-A (phi a b) (refl true) t) ;
  psi a b -> \ t n -> ap hd (suc-A (psi a b) (refl true) t) ;
  om a -> \ t n -> ap hd (suc-A (om a) (refl true) t) ;
  ii -> \ t n -> ap hd (suc-A ii (refl true) t) } ;

-- s + 1 = cat s 1, s /= 0
suc-cat : (s : T) -> TT s -> NZ s -> Id T (suc s) (cat s one) = split {
  zero -> \ t n -> abT n ;
  plus x0 xs | _ r -> \ t n -> trans (suc-P x0 xs t) (ap (\ u -> plus x0 u) (r (isT-plusS x0 xs t) (tail-nz x0 xs t))) ;
  phi a b -> \ t n -> suc-A (phi a b) (refl true) t ;
  psi a b -> \ t n -> suc-A (psi a b) (refl true) t ;
  om a -> \ t n -> suc-A (om a) (refl true) t ;
  ii -> \ t n -> suc-A ii (refl true) t } ;

-- x^-Fi: the pair (1), (2) of the proof
FQ (A : Cl) (t : T) : U kl =
  (A (hd t) -> OK t -> A (mFi t)) * (Tr (isR t) -> Id Bool (isI t) false -> OK t -> A (kminus t) -> A (mFi t)) ;

-- (2) at Omega'_e from (1) at e
fq-R (A Bd : Cl) (h : H415 A Bd) (e : T) (q : A (hd e) -> OK e -> A (mFi e)) (hs : Tr (isSuc e)) (o : OK (om e))
  (ak : A (omF (pred1 e))) : A (mFi e) =
  let { oe : OK e = ot-om0 e o ;
        sp : SP e = suc-pred e oe hs ; }
  in boolCases (A (mFi e)) (isZero (pred1 e))
       (\ z -> tr-B A zero (mFi e)
                 (sym (trans (ap mFi (trans (sym sp.2) (ap suc (isZero-true (pred1 e) z)))) mfi-one))
                 (tr-B A (omF (pred1 e)) zero (ap omF (isZero-true (pred1 e) z)) ak))
       (\ nz -> q (tr-B A (hd (pred1 e)) (hd e)
                     (trans (sym (hd-suc (pred1 e) (ot-T (pred1 e) sp.1) nz)) (ap hd sp.2))
                     (hd-in A Bd h (pred1 e) (om-inv A Bd h (pred1 e) ak)))
                  oe) ;

fq-phi (A Bd : Cl) (h : H415 A Bd) (x0 x1 : T) (r0 : FQ A x0) (r1 : FQ A x1) (a : A (phi x0 x1)) (o : OK (phi x0 x1))
  : A (mFi (phi x0 x1)) =
  let { p : A x0 * A x1 = wd-p A (h-wd A Bd h) (phi x0 x1) x0 x1 (ot-phi0 x0 x1 o) (ot-phi1 x0 x1 o) a (refl (phi x0 x1), o) ; }
  in tr-B A (ifQ (le x1 x0) (card x0) (card x1)).2.2.1 (mFi (phi x0 x1)) (ap (\ k -> k.2.2.1) (sym (card-phi x0 x1)))
       (ifQ-G (\ k -> A k.2.2.1) (le x1 x0) (card x0) (card x1)
          (\ q -> r0.1 (hd-in A Bd h x0 p.1) (ot-phi0 x0 x1 o))
          (\ q -> r1.1 (hd-in A Bd h x1 p.2) (ot-phi1 x0 x1 o))) ;

fq-psi (A Bd : Cl) (h : H415 A Bd) (x0 x1 : T) (r0 : FQ A x0) (a : A (psi x0 x1)) (o : OK (psi x0 x1))
  : A (mFi (psi x0 x1)) =
  boolCases (A (mFi (psi x0 x1))) (isI x0)
    (\ t -> tr-B A (psi x0 x1) (mFi (psi x0 x1)) (sym (ap (\ k -> k.2.2.1) (card-psi-I x0 x1 t))) a)
    (\ n -> tr-B A (mFi x0) (mFi (psi x0 x1)) (sym (ap (\ k -> k.2.2.1) (card-psi-R x0 x1 n)))
              (r0.2 (ot-psiR x0 x1 o) n (ot-psi0 x0 x1 o)
                 (wd-k A (h-wd A Bd h) (psi x0 x1) x0 x1 (ot-psi1 x0 x1 o) (ot-psiR x0 x1 o) a (refl (psi x0 x1), o)))) ;

fq (A Bd : Cl) (h : H415 A Bd) : (t : T) -> FQ A t = split {
  zero -> (\ a o -> a, \ r -> abF r) ;
  plus x0 xs | r0 _ -> (\ a o -> r0.1 (tr-B A x0 (hd x0) (sym (hd-A x0 (isT-plusA x0 xs (ot-T (plus x0 xs) o)))) a) (ot-plus0 x0 xs o),
                       \ r -> abF r) ;
  phi x0 x1 | r0 r1 -> (\ a o -> fq-phi A Bd h x0 x1 r0 r1 a o, \ r -> abF r) ;
  psi x0 x1 | r0 _ -> (\ a o -> fq-psi A Bd h x0 x1 r0 a o, \ r -> abF r) ;
  om e | r0 -> (\ a o -> r0.1 (hd-in A Bd h e (wd-o A (h-wd A Bd h) (om e) e (ot-om0 e o) a (refl (om e), o))) (ot-om0 e o),
                \ r n o ak -> fq-R A Bd h e r0.1 r o ak) ;
  ii -> (\ a o -> a, \ r n -> abT n) } ;

-- x^-I: 0 or I
d-mI (A Bd : Cl) (h : H415 A Bd) (x : T) (a : A x) : A (mI x) =
  iteC (\ t -> A t) (lt x ii) zero ii
    (\ q -> zero-in A Bd h x a)
    (\ f -> ii-in A Bd h x (nlt-le ii x (ot-T ii ok-ii) (ot-T x (h-ot A Bd h x a)) f) a) ;

-- kappa^- for kappa = Omega'_e in A:  e = s + 1 =NF' s + 1, s in A, Omega_s in A
dR-om (A Bd : Cl) (h : H415 A Bd) (e : T) (hs : Tr (isSuc e)) (a : A (om e)) : A (omF (pred1 e)) =
  let { o : OK (om e) = h-ot A Bd h (om e) a ;
        oe : OK e = ot-om0 e o ;
        ae : A e = wd-o A (h-wd A Bd h) (om e) e oe a (refl (om e), o) ;
        sp : SP e = suc-pred e oe hs ; }
  in boolCases (A (omF (pred1 e))) (isZero (pred1 e))
       (\ z -> tr-B A zero (omF (pred1 e)) (sym (ap omF (isZero-true (pred1 e) z))) (zero-in A Bd h (om e) a))
       (\ nz -> u-om A Bd h (pred1 e)
                  (wd-s A (h-wd A Bd h) e (pred1 e) one sp.1 ok-one ae
                     ((trans (sym sp.2) (suc-cat (pred1 e) (ot-T (pred1 e) sp.1) nz),
                       (ot-T (pred1 e) sp.1, (ot-T one ok-one, (nz, (refl false, oe))))), refl true)).1
                  (omF-OK (pred1 e) sp.1)
                  (h-below A Bd h (omF (pred1 e)) (om e) (omF-OK (pred1 e) sp.1)
                     (le-of-lt (omF (pred1 e)) (om e) (km-lt e (ot-T e oe) hs).1) a)) ;

d-R (A Bd : Cl) (h : H415 A Bd) : DR A = split {
  zero -> \ r a -> abF r ;
  plus x0 xs -> \ r a -> abF r ;
  phi x0 x1 -> \ r a -> abF r ;
  psi x0 x1 -> \ r a -> abF r ;
  om e -> \ r a -> dR-om A Bd h e r a ;
  ii -> \ r a -> zero-in A Bd h ii a } ;

------------------------------------------------------------------------
-- Remark 4.15

rem415 (A Bd : Cl) (h : H415 A Bd) : DC A * UC A Bd =
  ((h-wd A Bd h,
    (d-sum A Bd h,
     (\ x a -> (d-tilde A Bd h x a, ((fq A Bd h x).1 (hd-in A Bd h x a) (h-ot A Bd h x a), d-mI A Bd h x a)),
      d-R A Bd h))),
   (u-sum A Bd h,
    (u-phi A Bd h,
     (u-om A Bd h,
      (\ x a o c -> u-up A Bd h x a c,
       wu-0 A Bd (h-wu A Bd h)))))) ;

------------------------------------------------------------------------
-- Order facts: what WD and DC name is <=' the term

lt-km-psi : (k y : T) -> OK (psi k y) -> LT (kminus k) (psi k y) = split {
  zero -> \ y o -> abF (ot-psiR zero y o) ;
  plus x0 xs -> \ y o -> abF (ot-psiR (plus x0 xs) y o) ;
  phi x0 x1 -> \ y o -> abF (ot-psiR (phi x0 x1) y o) ;
  psi x0 x1 -> \ y o -> abF (ot-psiR (psi x0 x1) y o) ;
  om e -> \ y o -> (km-lt e (ot-T e (ot-om0 e (ot-psi0 (om e) y o))) (ot-psiR (om e) y o)).2 y ;
  ii -> \ y o -> zero-lt-nz (psi ii y) (refl false) } ;

lt-km : (k : T) -> Tr (isR k) -> OK k -> LT (kminus k) k = split {
  zero -> \ r o -> abF r ;
  plus x0 xs -> \ r o -> abF r ;
  phi x0 x1 -> \ r o -> abF r ;
  psi x0 x1 -> \ r o -> abF r ;
  om e -> \ r o -> (km-lt e (ot-T e (ot-om0 e o)) r).1 ;
  ii -> \ r o -> zero-lt-nz ii (refl false) } ;

-- phi_x y: x, y <' phi_x y;  Omega_x: x <' Omega_x  (z =NF ..., transported)
lt-phi-l (z x y : T) (ox : OK x) (oy : OK y) (h : NFphi z x y) : LT x z =
  subst (\ s -> LT x s) (sym h.1) ((phi-below x).1 x y (ot-T x ox) (ot-T x ox) (ot-T y oy) (le-refl x)) ;
lt-phi-r (z x y : T) (ox : OK x) (oy : OK y) (h : NFphi z x y) : LT y z =
  subst (\ s -> LT y s) (sym h.1) ((phi-below y).2 x y (ot-T y oy) (ot-T x ox) (ot-T y oy) (le-refl y)) ;
lt-om-nf (z x : T) (ox : OK x) (h : NFom z x) : LT x z = subst (\ s -> LT x s) (sym h.1) (lt-om x ox) ;
lt-km-nf (z k y : T) (h : NFpsi z k y) : LT (kminus k) z =
  subst (\ s -> LT (kminus k) s) (sym h.1) (lt-km-psi k y (nf-OK z (psi k y) h.1 h.2)) ;

-- kappa^- in OT
ok-km : (k : T) -> Tr (isR k) -> OK k -> OK (kminus k) = split {
  zero -> \ r o -> abF r ;
  plus x0 xs -> \ r o -> abF r ;
  phi x0 x1 -> \ r o -> abF r ;
  psi x0 x1 -> \ r o -> abF r ;
  om e -> \ r o -> omF-OK (pred1 e) (suc-pred e (ot-om0 e o) r).1 ;
  ii -> \ r o -> ok-zero } ;

-- x^-Fi <=' x (Remark 2.14(g), the three regions);  x^-I <=' x
tt-psiI0 : TT (psi ii zero) = refl true ;
mfi-le (x : T) (o : OK x) : Tr (le (mFi x) x) =
  boolCases (Tr (le (mFi x) x)) (lt x (psi ii zero))
    (\ h -> subst (\ m -> Tr (le m x)) (sym (rem214g1 x o h).1) (zero-le-any x))
    (\ n -> boolCases (Tr (le (mFi x) x)) (lt x ii)
       (\ h2 -> (rem214g2 x o (nlt-le (psi ii zero) x tt-psiI0 (ot-T x o) n) h2).2.2.2.2.2.1)
       (\ n2 -> subst (\ m -> Tr (le m x)) (sym (rem214g3 x o (nlt-le ii x (ot-T ii ok-ii) (ot-T x o) n2)).1)
                  (nlt-le ii x (ot-T ii ok-ii) (ot-T x o) n2))) ;
mI-le (x : T) (tx : TT x) : Tr (le (mI x) x) =
  iteC (\ t -> Tr (le t x)) (lt x ii) zero ii (\ q -> zero-le-any x) (\ f -> nlt-le ii x (ot-T ii ok-ii) tx f) ;

-- x <' x + 1
lt-suc-self (x : T) (ox : OK x) : LT x (suc x) = lt-add-l x ox one ok-one (refl false) ;

------------------------------------------------------------------------
-- Cutting at a bound

-- u <' z <' a, u in B  =>  u in B n a
cap-in (B : Cl) (a : T) (ta : TT a) (z u : T) (oz : OK z) (ou : OK u) (bu : B u) (l : LT u z) (m : LT z a) : Cap B a u =
  (bu, tr3 u z a (ot-T u ou) (ot-T z oz) ta l m) ;

-- B c OT weakly downward closed  =>  so is B n a
wd-cap (B : Cl) (okB : Sub B OTc) (a : T) (ta : TT a) (w : WD B) : WD (Cap B a) =
  (\ z x y ox oy m h ->
     let { p : B x * B y = wd-s B w z x y ox oy m.1 h ; }
     in (cap-in B a ta z x (okB z m.1) ox p.1 (nf-lt z x y h.1).1 m.2,
         cap-in B a ta z y (okB z m.1) oy p.2 (nf-lt z x y h.1).2 m.2),
   (\ z x y ox oy m h ->
      let { p : B x * B y = wd-p B w z x y ox oy m.1 h ; }
      in (cap-in B a ta z x (okB z m.1) ox p.1 (lt-phi-l z x y ox oy h) m.2,
          cap-in B a ta z y (okB z m.1) oy p.2 (lt-phi-r z x y ox oy h) m.2),
    (\ z x ox m h -> cap-in B a ta z x (okB z m.1) ox (wd-o B w z x ox m.1 h) (lt-om-nf z x ox h) m.2,
     \ z k y oy r m h ->
       cap-in B a ta z (kminus k) (okB z m.1) (ok-km k r (ot-psi0 k y (nf-OK z (psi k y) h.1 h.2)))
         (wd-k B w z k y oy r m.1 h) (lt-km-nf z k y h) m.2))) ;

-- B weakly upward closed bounded by OT  =>  B n a weakly upward closed bounded by a
wu-cap (B : Cl) (a : T) (u : WU B OTc) : WU (Cap B a) (Bnd a) =
  (\ z x y bx by o c h -> (wu-s B OTc u z x y bx.1 by.1 o o h, c),
   (\ z x y bx by o c h -> (wu-p B OTc u z x y bx.1 by.1 o o h, c),
    (\ z x bx o c h -> (wu-o B OTc u z x bx.1 o o h, c),
     (\ c -> ((wu-0 B OTc u).1 ok-zero, c), \ c -> ((wu-0 B OTc u).2 ok-ii, c))))) ;

ini-OT : Ini OTc = \ z c oz oc l h -> oz ;
ini-bnd (a : T) (ta : TT a) : Ini (Bnd a) = \ z c oz oc l h -> le-lt z c a (tr3 z c a (ot-T z oz) (ot-T c oc) ta) l h ;

-- WD is invariant under =
wd-eqv (A B : Cl) (e : Eqv A B) (w : WD A) : WD B =
  (\ z x y ox oy b h ->
     let { p : A x * A y = wd-s A w z x y ox oy (bw (A z) (B z) (e z) b) h ; }
     in (fw (A x) (B x) (e x) p.1, fw (A y) (B y) (e y) p.2),
   (\ z x y ox oy b h ->
      let { p : A x * A y = wd-p A w z x y ox oy (bw (A z) (B z) (e z) b) h ; }
      in (fw (A x) (B x) (e x) p.1, fw (A y) (B y) (e y) p.2),
    (\ z x ox b h -> fw (A x) (B x) (e x) (wd-o A w z x ox (bw (A z) (B z) (e z) b) h),
     \ z k y oy r b h -> fw (A (kminus k)) (B (kminus k)) (e (kminus k)) (wd-k A w z k y oy r (bw (A z) (B z) (e z) b) h)))) ;

------------------------------------------------------------------------
-- Sums in C^b(A), for A n b weakly downward closed

-- u in C^b(A), u /= 0  =>  Sums(C^b(A), u)
ca-sums (A : Cl) (b : T) (okb : Sub (Cap A b) OTc) (wd : WDC (Cap A b)) : (u : T) -> TT u -> NZ u -> C b A u -> Sums (C b A) u = split {
  zero -> \ t n -> absurdT (C b A zero -> Sums (C b A) zero) n ;
  plus u0 us | _ r -> \ t n h ->
    either (Cap A b (plus u0 us)) (C b A u0 * C b A us) (Sums (C b A) (plus u0 us))
      (\ q -> sums-map (Cap A b) (C b A) (\ p g -> rem47h b A p (okb p g) g) (plus u0 us)
                (sums-of (Cap A b) okb wd (plus u0 us) t n q))
      (\ p -> (p.1, r (isT-plusS u0 us t) (tail-nz u0 us t) p.2))
      (fw (C b A (plus u0 us)) (Or (Cap A b (plus u0 us)) (C b A u0 * C b A us)) (ca-plus b A u0 us (ca-ok b A (plus u0 us) h)) h) ;
  phi x0 x1 -> \ t n h -> h ;
  psi x0 x1 -> \ t n h -> h ;
  om x0 -> \ t n h -> h ;
  ii -> \ t n h -> h } ;

-- Sums(C^b(A), u), u in OT  =>  u in C^b(A)  (4.4(c), by parts)
sums-C (b : T) (A : Cl) : (u : T) -> OK u -> Sums (C b A) u -> C b A u = split {
  zero -> \ o s -> ca-zero b A ;
  plus u0 us | _ r -> \ o s ->
    bw (C b A (plus u0 us)) (Or (Cap A b (plus u0 us)) (C b A u0 * C b A us)) (ca-plus b A u0 us o)
      (inr (s.1, r (ot-plusS u0 us o) s.2)) ;
  phi x0 x1 -> \ o s -> s ;
  psi x0 x1 -> \ o s -> s ;
  om x0 -> \ o s -> s ;
  ii -> \ o s -> s } ;

-- the summands of cat x y are those of x and of y (by definition of Sums and cat)
sums-split (D : Cl) : (x y : T) -> Sums D (cat x y) -> Sums D x * Sums D y = split {
  zero -> \ y s -> (tt, s) ;
  plus x0 xs | _ r -> \ y s -> ((s.1, (r y s.2).1), (r y s.2).2) ;
  phi x0 x1 -> \ y s -> s ;
  psi x0 x1 -> \ y s -> s ;
  om x0 -> \ y s -> s ;
  ii -> \ y s -> s } ;

-- Omega_s in C^b(A) for s in C^b(A)
om-C (b : T) (A : Cl) (s : T) (os : OK s) (cs : C b A s) : C b A (omF s) =
  boolCases (C b A (omF s)) (fx s)
    (\ f -> ca-el-r b A s (omF s) (omF-fix s f) cs)
    (\ f -> ca-el-r b A (om s) (omF s) (omF-mov s f)
              (bw (C b A (om s)) (Or (Cap A b (om s)) (C b A s)) (ca-om b A s (nf-OK (omF s) (om s) (omF-mov s f) (omF-OK s os)))
                 (inr cs))) ;

-- e = s + 1 = cat s 1 (s = pred1 e /= 0);  Omega_0 = 0
e-cat (e : T) (sp : SP e) (nz : NZ (pred1 e)) : Id T e (cat (pred1 e) one) =
  trans (sym sp.2) (suc-cat (pred1 e) (ot-T (pred1 e) sp.1) nz) ;
omF-z (s : T) (z : Tr (isZero s)) : Id T (omF s) zero = ap omF (isZero-true s z) ;

-- kappa = Omega'_e in C^b(A), b <' kappa  =>  kappa^- = Omega_s in C^b(A)  (e = s+1)
km-C-om (A : Cl) (b : T) (ob : OK b) (okb : Sub (Cap A b) OTc) (wd : WDC (Cap A b)) (e : T) (hs : Tr (isSuc e))
  (o : OK (om e)) (l : LT b (om e)) (c : C b A (om e)) : C b A (omF (pred1 e)) =
  let { oe : OK e = ot-om0 e o ;
        sp : SP e = suc-pred e oe hs ;
        ce : C b A e = either (Cap A b (om e)) (C b A e) (C b A e)
                         (\ q -> lt-abs (C b A e) b (om e) (ot-T b ob) (ot-T (om e) o) l q.2)
                         (\ p -> p)
                         (fw (C b A (om e)) (Or (Cap A b (om e)) (C b A e)) (ca-om b A e o) c) ; }
  in boolCases (C b A (omF (pred1 e))) (isZero (pred1 e))
       (\ z -> ca-el-r b A zero (omF (pred1 e)) (omF-z (pred1 e) z) (ca-zero b A))
       (\ nz -> om-C b A (pred1 e) sp.1
                  (sums-C b A (pred1 e) sp.1
                     (sums-split (C b A) (pred1 e) one
                        (ca-sums A b okb wd (cat (pred1 e) one)
                           (cat-TT (pred1 e) (ot-T (pred1 e) sp.1) nz one (ot-T one ok-one) (refl false)) (cat-NZ (pred1 e) nz one)
                           (ca-el b A e (cat (pred1 e) one) (e-cat e sp nz) ce))).1)) ;

km-C (A : Cl) (b : T) (ob : OK b) (okb : Sub (Cap A b) OTc) (wd : WDC (Cap A b))
  : (k : T) -> Tr (isR k) -> OK k -> LT b k -> C b A k -> C b A (kminus k) = split {
  zero -> \ r -> absurdB (OK zero -> LT b zero -> C b A zero -> C b A (kminus zero)) r ;
  plus x0 xs -> \ r -> absurdB (OK (plus x0 xs) -> LT b (plus x0 xs) -> C b A (plus x0 xs) -> C b A (kminus (plus x0 xs))) r ;
  phi x0 x1 -> \ r -> absurdB (OK (phi x0 x1) -> LT b (phi x0 x1) -> C b A (phi x0 x1) -> C b A (kminus (phi x0 x1))) r ;
  psi x0 x1 -> \ r -> absurdB (OK (psi x0 x1) -> LT b (psi x0 x1) -> C b A (psi x0 x1) -> C b A (kminus (psi x0 x1))) r ;
  om e -> \ r o l c -> km-C-om A b ob okb wd e r o l c ;
  ii -> \ r o l c -> ca-zero b A } ;

------------------------------------------------------------------------
-- Lemma 4.16 (a)

-- C^b(A) weakly downward closed, for A n b weakly downward closed
wd-C (A : Cl) (b : T) (ob : OK b) (okb : Sub (Cap A b) OTc) (w : WD (Cap A b)) : WD (C b A) =
  (\ z x y ox oy hz h ->
     let { S : Sums (C b A) (cat x y)
             = ca-sums A b okb (wd-wdc (Cap A b) w) (cat x y)
                 (cat-TT x (nfs-tx z x y h.1) (nfs-nx z x y h.1) y (nfs-ty z x y h.1) (nfs-ny z x y h.1))
                 (cat-NZ x (nfs-nx z x y h.1) y) (ca-el b A z (cat x y) (nfs-e z x y h.1) hz) ; }
     in (sums-C b A x ox (sums-split (C b A) x y S).1, sums-A (C b A) y h.2 (sums-split (C b A) x y S).2),
   (\ z x y ox oy hz h ->
      either (Cap A b (phi x y)) (C b A x * C b A y) (C b A x * C b A y)
        (\ q -> let { p : Cap A b x * Cap A b y
                        = wd-p (Cap A b) w (phi x y) x y ox oy q (refl (phi x y), nf-OK z (phi x y) h.1 h.2) ; }
                in (rem47h b A x ox p.1, rem47h b A y oy p.2))
        (\ p -> p)
        (fw (C b A (phi x y)) (Or (Cap A b (phi x y)) (C b A x * C b A y)) (ca-phi b A x y (nf-OK z (phi x y) h.1 h.2))
           (ca-el b A z (phi x y) h.1 hz)),
    (\ z x ox hz h ->
       either (Cap A b (om x)) (C b A x) (C b A x)
         (\ q -> rem47h b A x ox (wd-o (Cap A b) w (om x) x ox q (refl (om x), nf-OK z (om x) h.1 h.2)))
         (\ p -> p)
         (fw (C b A (om x)) (Or (Cap A b (om x)) (C b A x)) (ca-om b A x (nf-OK z (om x) h.1 h.2))
            (ca-el b A z (om x) h.1 hz)),
     \ z k y oy r hz h ->
       either (Cap A b (psi k y)) (PsiP b A k y) (C b A (kminus k))
         (\ q -> rem47h b A (kminus k) (ok-km k r (ot-psi0 k y (nf-OK z (psi k y) h.1 h.2)))
                   (wd-k (Cap A b) w (psi k y) k y oy r q (refl (psi k y), nf-OK z (psi k y) h.1 h.2)))
         (\ p -> km-C A b ob okb (wd-wdc (Cap A b) w) k r (ot-psi0 k y (nf-OK z (psi k y) h.1 h.2)) p.1 p.2.1)
         (fw (C b A (psi k y)) (Or (Cap A b (psi k y)) (PsiP b A k y)) (ca-psi b A k y (nf-OK z (psi k y) h.1 h.2))
            (ca-el b A z (psi k y) h.1 hz))))) ;

-- C^a(A) weakly upward closed (Assumption 4.4(b), (c); sums by CA.s-cat)
wu-C (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (wd : WDC (Cap A (tilde a))) : WU (C a A) OTc =
  (\ z x y ax ay o c h ->
     ca-el-r a A (cat x y) z (nfs-e z x y h.1)
       (s-cat A hA a oa wd x (nfs-tx z x y h.1) ax y ay (nf-OK z (cat x y) (nfs-e z x y h.1) o)),
   (\ z x y ax ay o c h ->
      ca-el-r a A (phi x y) z h.1
        (bw (C a A (phi x y)) (Or (Cap A a (phi x y)) (C a A x * C a A y)) (ca-phi a A x y (nf-OK z (phi x y) h.1 o)) (inr (ax, ay))),
    (\ z x ax o c h ->
       ca-el-r a A (om x) z h.1
         (bw (C a A (om x)) (Or (Cap A a (om x)) (C a A x)) (ca-om a A x (nf-OK z (om x) h.1 o)) (inr ax)),
     (\ c -> ca-zero a A, \ c -> ca-I a A)))) ;

-- C^a(A) satisfies the hypotheses of Remark 4.15 with C = OT
h415-C (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a))) : H415 (C a A) OTc =
  (\ x g -> ca-ok a A x g,
   (ini-OT,
    (wd-eqv (C (tilde a) A) (C a A) (eqv-sym (C a A) (C (tilde a) A) (rem47a A hA a oa))
       (wd-C A (tilde a) (til-OK a oa) (\ x q -> (hA x q.1).1) w),
     (wu-C A hA a oa (wd-wdc (Cap A (tilde a)) w),
      \ x g -> ca-ok a A x g)))) ;

-- (a), C^a(A): downward closed and upward closed
rem416a-C (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a))) : DC (C a A) * UC (C a A) OTc =
  rem415 (C a A) OTc (h415-C A hA a oa w) ;

-- (a), tau^A(a): downward closed and upward closed bounded by a
rem416a-tau (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a)))
  : DC (tau A a) * UC (tau A a) (Bnd a) =
  rem415 (tau A a) (Bnd a)
    (\ x g -> ca-ok a A x g.1,
     (ini-bnd a (ot-T a oa),
      (wd-cap (C a A) (\ x g -> ca-ok a A x g) a (ot-T a oa) (rem416a-C A hA a oa w).1.1,
       (wu-cap (C a A) a (wu-C A hA a oa (wd-wdc (Cap A (tilde a)) w)),
        \ x g -> g.2)))) ;

-- the parts of DC (accessors)
dc-wd (A : Cl) (d : DC A) : WD A = d.1 ;
dc-sum (A : Cl) (d : DC A) : DSum A = d.2.1 ;
dc-card (A : Cl) (d : DC A) : DCard A = d.2.2.1 ;
dc-R (A : Cl) (d : DC A) : DR A = d.2.2.2 ;

-- B is downward closed if every x in B is in a downward closed D_x whose elements
-- y <=' x are in B (every term named by Def. 4.14(a), (b) is <=' the given one)
dc-below (B : Cl) (D : T -> Cl) (okB : Sub B OTc)
  (d : (x : T) -> B x -> DC (D x)) (self : (x : T) -> B x -> D x x)
  (back : (x y : T) -> B x -> D x y -> Tr (le y x) -> B y) : DC B =
  ((\ z x y ox oy bz h ->
      let { p : D z x * D z y = wd-s (D z) (dc-wd (D z) (d z bz)) z x y ox oy (self z bz) h ; }
      in (back z x bz p.1 (le-of-lt x z (nf-lt z x y h.1).1), back z y bz p.2 (le-of-lt y z (nf-lt z x y h.1).2)),
    (\ z x y ox oy bz h ->
       let { p : D z x * D z y = wd-p (D z) (dc-wd (D z) (d z bz)) z x y ox oy (self z bz) h ; }
       in (back z x bz p.1 (le-of-lt x z (lt-phi-l z x y ox oy h)), back z y bz p.2 (le-of-lt y z (lt-phi-r z x y ox oy h))),
     (\ z x ox bz h -> back z x bz (wd-o (D z) (dc-wd (D z) (d z bz)) z x ox (self z bz) h) (le-of-lt x z (lt-om-nf z x ox h)),
      \ z k y oy r bz h -> back z (kminus k) bz (wd-k (D z) (dc-wd (D z) (d z bz)) z k y oy r (self z bz) h)
                             (le-of-lt (kminus k) z (lt-km-nf z k y h))))),
   (\ z x y ox oy bz h ->
      let { p : D z x * D z y = dc-sum (D z) (d z bz) z x y ox oy (self z bz) h ; }
      in (back z x bz p.1 (le-of-lt x z (nf-lt z x y h).1), back z y bz p.2 (le-of-lt y z (nf-lt z x y h).2)),
    (\ x bx ->
       let { c : D x (tilde x) * (D x (mFi x) * D x (mI x)) = dc-card (D x) (d x bx) x (self x bx) ;
             ox : OK x = okB x bx ; }
       in (back x (tilde x) bx c.1 (til-le x ox),
           (back x (mFi x) bx c.2.1 (mfi-le x ox), back x (mI x) bx c.2.2 (mI-le x (ot-T x ox)))),
     \ k r bk -> back k (kminus k) bk (dc-R (D k) (d k bk) k r (self k bk)) (le-of-lt (kminus k) k (lt-km k r (okB k bk)))))) ;

-- x <' a+  =>  x~ <=' a~  (a~ = Omega_s, a+ = Omega_{s+1}, WA.til-bound)
til-up (x a : T) (ox : OK x) (oa : OK a) (l : LT x (up a)) : Tr (le (tilde x) (tilde a)) =
  let { r : (s : T) * (OK s * (Id T (tilde a) (omF s) * (Id T (up a) (omF (suc s)) * (Tr (le (tilde a) a) * LT a (up a)))))
          = rem214f a oa ; }
  in subst (\ u -> Tr (le (tilde x) u)) (sym r.2.2.1)
       (til-bound x r.1 ox r.2.1 (subst (\ u -> LT x u) r.2.2.2.1 l)) ;

-- A n a~ weakly downward closed, x <' a+  =>  A n x~ weakly downward closed
wd-x (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a))) (x : T) (ox : OK x) (l : LT x (up a))
  : WD (Cap A (tilde x)) =
  wd-eqv (Cap (Cap A (tilde a)) (tilde x)) (Cap A (tilde x))
    (\ z -> (\ g -> (g.1.1, g.2),
             \ g -> ((g.1, lt-le z (tilde x) (tilde a) (trOT z (tilde x) (tilde a) (hA z g.1).1 (til-OK x ox) (til-OK a oa))
                             g.2 (til-up x a ox oa l)), g.2)))
    (wd-cap (Cap A (tilde a)) (\ z g -> (hA z g.1).1) (tilde x) (ot-T (tilde x) (til-OK x ox)) w) ;

-- C^x(A) is downward closed for x <' a+
dc-Cx (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a))) (x : T) (ox : OK x) (l : LT x (up a))
  : DC (C x A) =
  (rem416a-C A hA x ox (wd-x A hA a oa w x ox l)).1 ;

-- y <=' x in B: y = x, or y <' x
le-cases (B : Cl) (x y : T) (l : Tr (le y x)) (g : B x) (k : LT y x -> B y) : B y =
  orE (B y) (lt y x) (eqT y x) l k (\ e -> tr-B B x y (sym (eqT-sound y x e)) g) ;

-- y in C^x(A), y <' x, x in W(A) n a+  =>  y in tau^A(x) c W(A)  (4.13(a)), y <' a+
wa-lt (A : Cl) (a : T) (oa : OK a) (x y : T) (g : Cap (WA[kl].WA A) (up a) x) (c : C x A y) (p : LT y x)
  : Cap (WA[kl].WA A) (up a) y =
  ((rem413a A x g.1).1 y (c, p), trOT y x (up a) (ca-ok x A y c) (wa-M A x g.1).1 (rem214a a oa).2.1 p g.2) ;

-- (a), W(A) n a+ downward closed
rem416a-W (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a))) : DC (Cap (WA[kl].WA A) (up a)) =
  dc-below (Cap (WA[kl].WA A) (up a)) (\ x -> C x A) (\ x g -> (wa-M A x g.1).1)
    (\ x g -> dc-Cx A hA a oa w x (wa-M A x g.1).1 g.2)
    (\ x g -> m-c A x (wa-M A x g.1))
    (\ x y g c l -> le-cases (Cap (WA[kl].WA A) (up a)) x y l g (wa-lt A a oa x y g c)) ;

-- (a), M(A) n a+ downward closed:  y in C^x(A), y <=' x  =>  y in C^y(A)  (4.7(b))
rem416a-M (A : Cl) (hA : Sub A (M A)) (a : T) (oa : OK a) (w : WD (Cap A (tilde a))) : DC (Cap (M A) (up a)) =
  dc-below (Cap (M A) (up a)) (\ x -> C x A) (\ x g -> g.1.1)
    (\ x g -> dc-Cx A hA a oa w x g.1.1 g.2)
    (\ x g -> m-c A x g.1)
    (\ x y g c l ->
       ((ca-ok x A y c, rem47b A hA y x (ca-ok x A y c) g.1.1 l y c),
        le-lt y x (up a) (trOT y x (up a) (ca-ok x A y c) g.1.1 (rem214a a oa).2.1) l g.2)) ;

------------------------------------------------------------------------
-- Lemma 4.16 (b):  A n k [= W(A)  =>  A n k weakly downward closed  (k in OT)

-- z in A n k  =>  z in W(A)  (z in (A n k)|z = W(A)|z)
seg-w (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (z : T) (bz : Cap A k z) : WA[kl].WA A z =
  (fw (Bar (Cap A k) z z) (Bar (WA[kl].WA A) z z) (sg.2 z bz z) (bz, lt-suc-self z (sg.1 z bz))).1 ;

-- z in A n k, y in C^z(A), y <' z  =>  y in tau^A(z) c W(A), so y in W(A)|z = (A n k)|z
seg-back (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (z y : T) (bz : Cap A k z) (c : C z A y) (l : LT y z)
  : Cap A k y =
  (bw (Bar (Cap A k) z y) (Bar (WA[kl].WA A) z y) (sg.2 z bz y)
     ((rem413a A z (seg-w A k sg z bz)).1 y (c, l),
      trOT y z (suc z) (ca-ok z A y c) (sg.1 z bz) (suc-OK z (sg.1 z bz)) l (lt-suc-self z (sg.1 z bz)))).1 ;

-- z in C^z(A) is not in A n z, so its parts are in C^z(A) (Assumption 4.4(c), (d))
own-plus (A : Cl) (z0 zs : T) (o : OK (plus z0 zs)) (c : C (plus z0 zs) A (plus z0 zs))
  : C (plus z0 zs) A z0 * C (plus z0 zs) A zs =
  either (Cap A (plus z0 zs) (plus z0 zs)) (C (plus z0 zs) A z0 * C (plus z0 zs) A zs) (C (plus z0 zs) A z0 * C (plus z0 zs) A zs)
    (\ q -> irr-abs (C (plus z0 zs) A z0 * C (plus z0 zs) A zs) (plus z0 zs) q.2)
    (\ p -> p)
    (fw (C (plus z0 zs) A (plus z0 zs)) (Or (Cap A (plus z0 zs) (plus z0 zs)) (C (plus z0 zs) A z0 * C (plus z0 zs) A zs))
       (ca-plus (plus z0 zs) A z0 zs o) c) ;
own-phi (A : Cl) (x y : T) (o : OK (phi x y)) (c : C (phi x y) A (phi x y)) : C (phi x y) A x * C (phi x y) A y =
  either (Cap A (phi x y) (phi x y)) (C (phi x y) A x * C (phi x y) A y) (C (phi x y) A x * C (phi x y) A y)
    (\ q -> irr-abs (C (phi x y) A x * C (phi x y) A y) (phi x y) q.2)
    (\ p -> p)
    (fw (C (phi x y) A (phi x y)) (Or (Cap A (phi x y) (phi x y)) (C (phi x y) A x * C (phi x y) A y)) (ca-phi (phi x y) A x y o) c) ;
own-om (A : Cl) (x : T) (o : OK (om x)) (c : C (om x) A (om x)) : C (om x) A x =
  either (Cap A (om x) (om x)) (C (om x) A x) (C (om x) A x)
    (\ q -> irr-abs (C (om x) A x) (om x) q.2)
    (\ p -> p)
    (fw (C (om x) A (om x)) (Or (Cap A (om x) (om x)) (C (om x) A x)) (ca-om (om x) A x o) c) ;
own-psi (A : Cl) (p y : T) (o : OK (psi p y)) (c : C (psi p y) A (psi p y)) : PsiP (psi p y) A p y =
  either (Cap A (psi p y) (psi p y)) (PsiP (psi p y) A p y) (PsiP (psi p y) A p y)
    (\ q -> irr-abs (PsiP (psi p y) A p y) (psi p y) q.2)
    (\ r -> r)
    (fw (C (psi p y) A (psi p y)) (Or (Cap A (psi p y) (psi p y)) (PsiP (psi p y) A p y)) (ca-psi (psi p y) A p y o) c) ;

-- z in A n k  =>  z in C^z(A)
seg-c (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (z : T) (bz : Cap A k z) : C z A z =
  m-c A z (wa-M A z (seg-w A k sg z bz)) ;

-- sums, by induction on x:  cat x g in A n k (g an atom)  =>  x, g in A n k
BS (A : Cl) (k : T) (x : T) : U kl =
  (g : T) -> Tr (isA g) -> TT g -> TT x -> NZ x -> Cap A k (cat x g) -> Cap A k x * Cap A k g ;

-- x = (x0, xs): cat x g = (x0, cat xs g); x0, cat xs g in C^z(A); cat xs g in A n k, so
-- xs, g in A n k (induction); xs in A n z c C^z(A) (4.7(h)), so x in C^z(A), x <' z
bs-plus (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (x0 xs : T) (r : BS A k xs)
  (g : T) (hg : Tr (isA g)) (tg : TT g) (tx : TT (plus x0 xs)) (nx : NZ (plus x0 xs)) (bz : Cap A k (plus x0 (cat xs g)))
  : Cap A k (plus x0 xs) * Cap A k g =
  let { oz : OK (plus x0 (cat xs g)) = sg.1 (plus x0 (cat xs g)) bz ;
        P : C (plus x0 (cat xs g)) A x0 * C (plus x0 (cat xs g)) A (cat xs g)
          = own-plus A x0 (cat xs g) oz (seg-c A k sg (plus x0 (cat xs g)) bz) ;
        ih : Cap A k xs * Cap A k g
           = r g hg tg (isT-plusS x0 xs tx) (tail-nz x0 xs tx)
               (seg-back A k sg (plus x0 (cat xs g)) (cat xs g) bz P.2 (sum-lt (cat xs g) x0 oz)) ;
        ox : OK (plus x0 xs) = (cat-OK (plus x0 xs) g tx nx oz).1 ;
        lx : LT (plus x0 xs) (plus x0 (cat xs g)) = cat-lt-l (plus x0 xs) tx nx g ;
        cx : C (plus x0 (cat xs g)) A (plus x0 xs)
           = bw (C (plus x0 (cat xs g)) A (plus x0 xs))
                (Or (Cap A (plus x0 (cat xs g)) (plus x0 xs)) (C (plus x0 (cat xs g)) A x0 * C (plus x0 (cat xs g)) A xs))
                (ca-plus (plus x0 (cat xs g)) A x0 xs ox)
                (inr (P.1, rem47h (plus x0 (cat xs g)) A xs (ot-plusS x0 xs ox)
                             (ih.1.1, trOT xs (plus x0 xs) (plus x0 (cat xs g)) (ot-plusS x0 xs ox) ox oz (sum-lt xs x0 ox) lx))) ; }
  in (seg-back A k sg (plus x0 (cat xs g)) (plus x0 xs) bz cx lx, ih.2) ;

-- x = g0 an atom: cat g0 g = (g0, g), both parts in C^z(A) and <' z
bs-atom (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (g0 : T) (h0 : Tr (isA g0))
  (g : T) (hg : Tr (isA g)) (tg : TT g) (tx : TT g0) (nx : NZ g0) (bz : Cap A k (plus g0 g)) : Cap A k g0 * Cap A k g =
  let { oz : OK (plus g0 g) = sg.1 (plus g0 g) bz ;
        P : C (plus g0 g) A g0 * C (plus g0 g) A g = own-plus A g0 g oz (seg-c A k sg (plus g0 g) bz) ; }
  in (seg-back A k sg (plus g0 g) g0 bz P.1 (lt-head g0 g h0), seg-back A k sg (plus g0 g) g bz P.2 (sum-lt g g0 oz)) ;

bs (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) : (x : T) -> BS A k x = split {
  zero -> \ g hg tg tx nx -> absurdT (Cap A k (cat zero g) -> Cap A k zero * Cap A k g) nx ;
  plus x0 xs | _ r -> bs-plus A k sg x0 xs r ;
  phi a b -> bs-atom A k sg (phi a b) (refl true) ;
  psi a b -> bs-atom A k sg (psi a b) (refl true) ;
  om a -> bs-atom A k sg (om a) (refl true) ;
  ii -> bs-atom A k sg ii (refl true) } ;

-- the sums clause, in the class form
rem416b-wdc (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) : WDC (Cap A k) =
  \ z x y h bz -> bs A k sg x y h.2 (nfs-ty z x y h.1) (nfs-tx z x y h.1) (nfs-nx z x y h.1) (tr-B (Cap A k) z (cat x y) (nfs-e z x y h.1) bz) ;

-- A n k weakly downward closed for sums, z <' k  =>  so is A n z
wdc-below (A : Cl) (k : T) (ok : OK k) (okk : Sub (Cap A k) OTc) (w : WDC (Cap A k)) (z : T) (oz : OK z) (l : LT z k)
  : WDC (Cap A z) =
  \ u x y h m ->
    let { ou : OK u = nfs-ok u x y h.1 ;
          p : Cap A k x * Cap A k y = w u x y h (m.1, trOT u z k ou oz ok m.2 l) ;
          lt2 : LT x u * LT y u = nf-lt u x y h.1 ;
          o2 : OK x * OK y = nfs-OK u x y h.1 ; }
    in ((p.1.1, trOT x u z o2.1 ou oz lt2.1 m.2), (p.2.1, trOT y u z o2.2 ou oz lt2.2 m.2)) ;

-- phi_x y in A n k  =>  x, y in A n k
b-phi (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (x y : T) (ox : OK x) (oy : OK y) (bz : Cap A k (phi x y))
  : Cap A k x * Cap A k y =
  let { o : OK (phi x y) = sg.1 (phi x y) bz ;
        P : C (phi x y) A x * C (phi x y) A y = own-phi A x y o (seg-c A k sg (phi x y) bz) ; }
  in (seg-back A k sg (phi x y) x bz P.1 (lt-phi-l (phi x y) x y ox oy (refl (phi x y), o)),
      seg-back A k sg (phi x y) y bz P.2 (lt-phi-r (phi x y) x y ox oy (refl (phi x y), o))) ;

-- Omega'_x in A n k  =>  x in A n k
b-om (A : Cl) (k : T) (sg : Seg (Cap A k) (WA[kl].WA A)) (x : T) (ox : OK x) (bz : Cap A k (om x)) : Cap A k x =
  let { o : OK (om x) = sg.1 (om x) bz ; }
  in seg-back A k sg (om x) x bz (own-om A x o (seg-c A k sg (om x) bz)) (lt-om-nf (om x) x ox (refl (om x), o)) ;

-- psi_p y in A n k  =>  p^- in A n k:  z = psi_p y in C^z(A), z <' p, p in C^z(A), so
-- p^- in C^z(A) (km-C, with A n z weakly downward closed for sums) and p^- <' z
b-psi (A : Cl) (okA : Sub A OTc) (k : T) (ok : OK k) (sg : Seg (Cap A k) (WA[kl].WA A)) (p y : T) (r : Tr (isR p))
  (bz : Cap A k (psi p y)) : Cap A k (kminus p) =
  let { o : OK (psi p y) = sg.1 (psi p y) bz ;
        P : PsiP (psi p y) A p y = own-psi A p y o (seg-c A k sg (psi p y) bz) ; }
  in seg-back A k sg (psi p y) (kminus p) bz
       (km-C A (psi p y) o (\ u q -> okA u q.1) (wdc-below A k ok sg.1 (rem416b-wdc A k sg) (psi p y) o bz.2) p r (ot-psi0 p y o) P.1 P.2.1)
       (lt-km-psi p y o) ;

rem416b (A : Cl) (okA : Sub A OTc) (k : T) (ok : OK k) (sg : Seg (Cap A k) (WA[kl].WA A)) : WD (Cap A k) =
  (\ z x y ox oy bz h -> rem416b-wdc A k sg z x y h bz,
   (\ z x y ox oy bz h -> b-phi A k sg x y ox oy (tr-B (Cap A k) z (phi x y) h.1 bz),
    (\ z x ox bz h -> b-om A k sg x ox (tr-B (Cap A k) z (om x) h.1 bz),
     \ z p y oy r bz h -> b-psi A okA k ok sg p y r (tr-B (Cap A k) z (psi p y) h.1 bz)))) ;

------------------------------------------------------------------------
-- Lemma 4.17 (a): 0 in W(A)  (0 in M(A), and nothing is <' 0)

below-zero (R : U kl) (y : T) (l : LT y zero) : R = absurdB R (trans (sym (lt-zero y)) l) ;

rem417a (A : Cl) : WA[kl].WA A zero =
  wa-a A zero ((rem49d A).1, \ y t -> below-zero (WA[kl].WA A y) y t.2) ;
