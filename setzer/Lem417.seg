-- Lem417.seg: Setzer (APAL 92, 1998), Lemma 4.17 (b) and (c), pp. 144-146.
-- (a) is Clos.rem417a.  The mirror is tools/otclos.py (lem417 6, no
-- failures: 212 instances of (b) with k in R and 2907 with k not in R;
-- 778 of (c) with z = max{k, y} and 16203 with z above it).
--
-- Statements (A a class):
--   (b) A c M(A), k in OT, A n k = W(A) n k  =>  W(A) n k+ is downward
--       closed and upward closed bounded by k+.                      rem417b
--       (Setzer's k is a cardinal; the proof does not use it.)
--   (c) A c M(A), k, y, z in W(A), k, y <=' z, W(A) n z~ = A n z~, k in R,
--       y in C_k(y)  =>  psi_k y in W(A).                            rem417c
--       (Setzer: z = max{k, y}; the proof uses only z in W(A) and
--       k, y <=' z, so z is any element of W(A) above both.)
--
-- Induction.  Setzer inducts on length(d) in (iii), (iv), (v) and (c)(*),
-- because he decomposes sums by =NF' (last summand).  Here every
-- decomposition used is the head split (d0, ds), which is =NF d0 + ds,
-- and the parts named are immediate subterms: the inductions are
-- structural (split), and no length induction is needed.
--
-- Reading of (c).  The three subcases of "Case u =NF psi_pi u'" (p. 145)
-- compare u with (psi_k y)~, not with psi_k y: the tilde is printed over
-- "psi_k y" in "Subcase psi_k y = u" and "psi_k y <' u" (page image), and
-- "u = k^-" in the second only makes sense so.  In the first subcase
-- (u <' a~) Setzer's "pi = I" is what CA.rem47f's proof found (d <' a~
-- forces kappa = I); here it is derived from 4.4(d) at a~ and til-psi.
-- Setzer's tau is a cardinal in W(A); the claim below uses only tau in
-- W(A) (where he uses pi^- = tau for pi = tau+, we use pi^- = tau~).
--
-- Proof of (b).  Write W for W(A), k+ = up k, and assume (H17) A c M(A),
-- k in OT, A n k = W n k.
--   A n k [= W (k-seg: x in A n k, y <=' x: y <' k), so A n k is weakly
-- downward closed (4.16(b)), and A n a~ for every a <' k+, since
-- a~ <=' k~ <=' k (wd-x of Clos, from A n k~, wd-le).  So C^a(A) is
-- downward closed for a <' k+ (dc-Cx, 4.16(a)), and W n k+ is (4.16(a)).
-- For a <' k+:
--   x in W => x in (A n a~) u (M(A) \ a~)  (good-w: x <' a~ <=' k gives
--   x in W n k = A n k);
--   y in A, y <' a, a <=' k  =>  y in W  (k-low);
--   x in W, x <=' a, d in tau^A(a), d <=' x  =>  d in W  (w-below: d = x, or
--   d in tau^A(a) n x c tau^A(x) c W by 4.9(a), 4.13(a)).
-- By Remark 4.15 it suffices that W n k+ is weakly upward closed bounded
-- by k+: (i) 0 in W (4.17(a)); (ii)-(v) below.
--  (ii) (w-sum) b in W:  for c in W, a in OT, a <' k+, a =NF b + c
--   (any split) => a in W, by Ind(c in W).  a in M(A) by 4.9(e) (b, c by
--   good-w; A n a~ weakly downward closed).  Let d in tau^A(a).  d <=' b:
--   w-below.  b <' d: d <' a = b + c, so d = b + d' with d' <' c
--   (sum-mid, below); d' in C^a(A) (C^a(A) downward closed), d' <' c <=' a,
--   so d' in tau^A(c) (4.9(a)); by IH d in W.  So a in A^A(W) c W (4.10(a)).
--   sum-mid: b, c, d in T', b /= 0, b <' d <' cat b c  =>  d = cat b d',
--   d' /= 0, d' <' c.  Induction on b, by clause (2): b = g an atom:
--   d = (d0, ds) with g <=' d0 (g <' d) and d0 <=' g (d <' (g, c)), so
--   d0 = g and ds <' c; d an atom is impossible (g <' d <=' g).
--   b = (b0, bs): cat b c = (b0, cat bs c), and as above d = (b0, ds) with
--   bs <' ds <' cat bs c; induction.  d = 0: nothing is <' 0.
--  (iii) (w-phi) for b in W, c in W, a in OT, a <' k+, a =NF phi_b c => a in W,
--   by Ind(b in W), side-Ind(c in W).  a in M(A) by 4.9(e).  d in tau^A(a)
--   => d in W, by induction on d:
--     0: (i).  (d0, ds): its parts are in C^a(A) (downward closed) and <' a,
--     so in W by induction, and d in W by (ii)  (t-plus).
--     d <=' b or d <=' c: w-below.  Otherwise b, c <' d.
--     psi, Omega', I (in G'): d <' phi_b c gives d <=' b or d <=' c (clause (4)).
--     phi_d1 d2: d1, d2 in W by induction (parts in C^a(A), <' a).  By
--     clause (3) for d <' phi_b c: d1 <' b: d1 in tau^A(a) n b c tau^A(b),
--     the main IH at d1 with d2;  d1 = b and d2 <' c: d2 in tau^A(c), the
--     side IH;  b <' d1 and d <=' c: excluded (c <' d).
--  (iv) (w-om) for b in W, a in OT, a <' k+, a =NF Omega_b => a in W, by
--   Ind(b in W).  a = Omega'_b in M(A) (4.9(e)); a~ = a <=' k.  y in tau^A(a)
--   => y in W, by induction on y:  0: (i);  sums: t-plus;  phi: t-phi (by
--   (iii));  Omega'_y1: y1 <' b (clause (9)), y1 in tau^A(a) n b c tau^A(b),
--   main IH;  I: I <=' b (clause (10)), w-below;  psi_p y1: by 4.4(d)
--   y in A n a (then k-low), or a <' p:  p = I gives y <=' b (clause (7)),
--   w-below;  p /= I gives a = a~ <' y (CA.til-psi), excluded.
--  (v) (w-ii) I <' k+ => I in W.  I in M(A) (4.9(d)), I = I~ <=' k.
--   y in tau^A(I) => y in W by induction on y: 0, sums, phi, Omega as in (iv)
--   (t-plus, t-phi, t-om);  psi_p y1: y in A n I (k-low), or I <' p, which
--   is impossible (p = I, or I = I~ <' y <' I by til-psi);  I <' I: no.
--
-- Proof of (c).  Let tau = z~.  W n tau = A n tau, so (b) holds at
-- tau (H17).  z in W n z+ (downward closed, 4.16(a)) gives tau in W, and
-- k^- in W for k /= I; y <=' z <' z+ = tau+ (2.14(e)); psi_k y <' k <=' z;
-- k^- <=' tau (k^- = Omega_s, Omega_s <=' z => Omega_s <=' z~, card-M).
-- Then (c) follows from the claim, for tau in W with W n tau = A n tau:
--   P(y): y <' tau+ => for p in R with (p = I or (p^- in W and p^- <=' tau)),
--   psi_p y in OT, psi_p y <' tau+:  psi_p y in W,
-- by Ind(y in W).  Fix y, p, write a = psi_p y (a <' tau+, so C^a(A) is
-- downward closed and a~ <=' tau).  First, for b <' tau+ and v in W:
-- v in C^b(A) (in-Cb: v <' b~ <=' tau gives v in A n b~ c C^b(A); else
-- b~ <=' v, v in M(A), C^v(A) c C^b(A) by 4.7(b)'s Down).
--   (*) u in C_p(y), u in C^a(A), u <' tau+  =>  u in W, by induction on u.
--   0, I: (i), (v).  (u0, us), phi, Omega': the parts are in C_p(y)
--   (2.15(b)), in C^a(A) (downward closed), <' u: induction, then
--   (ii)-(iv).  u = psi_q u'.  u in C^a(A) = C^{a~}(A) (4.7(a)); by 4.4(d)
--   u in A n a~ (then u <' a~ <=' tau: u in A n tau = W n tau), or
--   a~ <' q and q, u' in C^a(A).  In the second case compare u with a~:
--   u <' a~: q = I (else a~ <=' (a~)~ <' u, til-psi, card-M).  If p /= I,
--     a~ = p^- in W, and u in tau^A(a) n p^- c W (w-below).  If p = I,
--     a~ = a, u' <' y (clause (5)), u' in C_I(u') c C_I(y) (2.14(j)),
--     u' <' tau+; by induction u' in W; u' in C^y(A) (in-Cb), so
--     u' in tau^A(y): main IH at u' with q = I gives u in W.
--   u = a~: p /= I (p = I: a~ = a = psi_I y, not in C_I(y)), u = p^- in W.
--   a~ <' u: q, u' in C_p(y) and u' <' y by 2.15(e) (p /= I, u not <=' p^-)
--     or 2.15(d) (p = I, u not <' psi_I y).  u' in W by induction
--     (u' <' y <' tau+), u' in tau^A(y) as above.  q = I, or q^- in W with
--     q^- <=' tau:  q <' tau+: q in W by induction, q^- by downward
--     closure, q^- <' tau+ gives q^- <=' tau~ <=' tau (til-up, card-M);
--     q = tau+: q^- = tau~ (the s of 2.14(f)), in W by downward closure;
--     tau+ <' q = Omega_{s+1}: tau+ <=' Omega_s = q^- <' u <' tau+ (til-bound,
--     card-M), excluded.  Main IH at u' with q: u in W.
--   Then tau^A(a) c W: d <' a <' p gives d in C_p(y) (2.15(c)), and (*).
-- a in M(A): a in C^a(A) by 4.4(d), a <' p: y in C^a(A) (in-Cb);
-- p = I in C^a(A), or p^- in W gives p^- in C^a(A) (in-Cb) and p in C^a(A)
-- (Clos.R-in, C^a(A) upward closed).  So a in A^A(W) c W.
level pl ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
import OTF ;
import CA ;
import WA ;
import Clos ;
open OT ;
open OTLaws[pl] ;
open OTTrans[pl] ;
open OTC[pl] ;
open OTF[pl] ;
open CA[pl] ;
open WA[pl] ;
open Clos[pl] ;

------------------------------------------------------------------------
-- The hypotheses of (b): A c M(A), k in OT, A n k = W(A) n k

H17 (A : Cl) (k : T) : U pl = Sub A (M A) * (OK k * Eqv (Cap A k) (Cap (WA[pl].WA A) k)) ;
k-m (A : Cl) (k : T) (h : H17 A k) : Sub A (M A) = h.1 ;
k-ok (A : Cl) (k : T) (h : H17 A k) : OK k = h.2.1 ;
k-e (A : Cl) (k : T) (h : H17 A k) : Eqv (Cap A k) (Cap (WA[pl].WA A) k) = h.2.2 ;
k-ot (A : Cl) (k : T) (h : H17 A k) : Sub A OTc = \ x g -> (k-m A k h x g).1 ;

-- y in A n k  =>  y in W(A);  y in W(A), y <' k  =>  y in A
k-aw (A : Cl) (k : T) (h : H17 A k) (y : T) (g : Cap A k y) : WA[pl].WA A y =
  (fw (Cap A k y) (Cap (WA[pl].WA A) k y) (k-e A k h y) g).1 ;
k-wa (A : Cl) (k : T) (h : H17 A k) (y : T) (w : WA[pl].WA A y) (l : LT y k) : A y =
  (bw (Cap A k y) (Cap (WA[pl].WA A) k y) (k-e A k h y) (w, l)).1 ;

-- A n k [= W(A):  y <=' x <' k
k-seg (A : Cl) (k : T) (h : H17 A k) : Seg (Cap A k) (WA[pl].WA A) =
  (\ x g -> k-ot A k h x g.1,
   \ x g y -> (\ q -> (k-aw A k h y q.1, q.2),
               \ q -> ((k-wa A k h y q.1
                          (le-lt y x k (trOT y x k (wa-OK A y q.1) (k-ot A k h x g.1) (k-ok A k h))
                             (lt-suc-le' y x (wa-OK A y q.1) (k-ot A k h x g.1) q.2) g.2),
                        le-lt y x k (trOT y x k (wa-OK A y q.1) (k-ot A k h x g.1) (k-ok A k h))
                          (lt-suc-le' y x (wa-OK A y q.1) (k-ot A k h x g.1) q.2) g.2),
                       q.2))) ;

-- A n b weakly downward closed, c <=' b  =>  A n c weakly downward closed
wd-le (A : Cl) (okA : Sub A OTc) (b c : T) (ob : OK b) (oc : OK c) (l : Tr (le c b)) (w : WD (Cap A b)) : WD (Cap A c) =
  wd-eqv (Cap (Cap A b) c) (Cap A c)
    (\ z -> (\ g -> (g.1.1, g.2),
             \ g -> ((g.1, lt-le z c b (trOT z c b (okA z g.1) oc ob) g.2 l), g.2)))
    (wd-cap (Cap A b) (\ z g -> okA z g.1) c (ot-T c oc) w) ;

-- A n k~ weakly downward closed (4.16(b), k~ <=' k)
k-wt (A : Cl) (k : T) (h : H17 A k) : WD (Cap A (tilde k)) =
  wd-le A (k-ot A k h) k (tilde k) (k-ok A k h) (til-OK k (k-ok A k h)) (til-le k (k-ok A k h))
    (rem416b A (k-ot A k h) k (k-ok A k h) (k-seg A k h)) ;

-- a <' k+  =>  a~ <=' k
k-til (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (l : LT a (up k)) : Tr (le (tilde a) k) =
  le-trans (tilde a) (tilde k) k (trOT (tilde a) (tilde k) k (til-OK a oa) (til-OK k (k-ok A k h)) (k-ok A k h))
    (til-up a k oa (k-ok A k h) l) (til-le k (k-ok A k h)) ;

-- a <' k+  =>  C^a(A) downward closed (4.16(a))
k-dc (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (l : LT a (up k)) : DC (C a A) =
  dc-Cx A (k-m A k h) k (k-ok A k h) (k-wt A k h) a oa l ;

-- a <' k+  =>  A n a~ weakly downward closed for sums
k-wdc (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (l : LT a (up k)) : WDC (Cap A (tilde a)) =
  wd-wdc (Cap A (tilde a)) (wd-x A (k-m A k h) k (k-ok A k h) (k-wt A k h) a oa l) ;

-- y in A, y <' c <=' k  =>  y in W(A)
k-low (A : Cl) (k : T) (h : H17 A k) (y c : T) (oc : OK c) (ay : A y) (l : LT y c) (lc : Tr (le c k)) : WA[pl].WA A y =
  k-aw A k h y (ay, lt-le y c k (trOT y c k (k-ot A k h y ay) oc (k-ok A k h)) l lc) ;

-- x in W(A), a <' k+  =>  x in (A n a~) u (M(A) \ a~)
good-w (A : Cl) (k : T) (h : H17 A k) (x : T) (wx : WA[pl].WA A x) (a : T) (oa : OK a) (l : LT a (up k)) : Good A a x =
  boolCases (Good A a x) (lt x (tilde a))
    (\ t -> inl (k-wa A k h x wx (lt-le x (tilde a) k (trOT x (tilde a) k (wa-OK A x wx) (til-OK a oa) (k-ok A k h)) t (k-til A k h a oa l)), t))
    (\ f -> inr (wa-M A x wx, nlt-le (tilde a) x (ot-T (tilde a) (til-OK a oa)) (ot-T x (wa-OK A x wx)) f)) ;

-- x in W(A), x <=' a, d in tau^A(a), d <=' x  =>  d in W(A)  (4.9(a), 4.13(a))
w-below (A : Cl) (hA : Sub A (M A)) (x a d : T) (wx : WA[pl].WA A x) (oa : OK a) (lx : Tr (le x a))
  (td : tau A a d) (ld : Tr (le d x)) : WA[pl].WA A d =
  le-cases (WA[pl].WA A) x d ld wx
    (\ p -> (rem413a A x wx).1 d (rem49a A hA a x oa (wa-OK A x wx) lx d (td, p))) ;

------------------------------------------------------------------------
-- Transport along an equation (explicit arguments: an implicit match next to
-- the step packages below opens them, a checker effect)

lt-r (d a a' : T) (e : Id T a a') (l : LT d a) : LT d a' = subst (\ x -> LT d x) e l ;
lt-l (d d' a : T) (e : Id T d d') (l : LT d a) : LT d' a = subst (\ x -> LT x a) e l ;
le-l (d d' a : T) (e : Id T d d') (l : Tr (le d a)) : Tr (le d' a) = subst (\ x -> Tr (le x a)) e l ;
-- Tr c, b = c  =>  Tr b;   Tr c, c = b  =>  Tr b
tr-b (b c : Bool) (e : Id Bool b c) (l : Tr c) : Tr b = trans e l ;
tr-bs (b c : Bool) (e : Id Bool c b) (l : Tr c) : Tr b = trans (sym e) l ;

------------------------------------------------------------------------
-- Between b and b + c (clause (2))

SumMid (b c d : T) : U pl = (d' : T) * (Id T d (cat b d') * (TT d' * (NZ d' * LT d' c))) ;

-- g <' d <' (g, c) is impossible for an atom d
atom-mid (R : U pl) (d g c : T) (hd : Tr (isA d)) (td : TT d) (tg : TT g) (h1 : LT g d) (h2 : LT d (plus g c)) : R =
  orE R (lt d g) (and (eqT d g) true) (trans (sym (lex-AP d hd g c)) h2)
    (\ p -> asym-abs R g d tg td h1 p)
    (\ p -> irr-abs R g (eq-lt-r g d g h1 (and-l (eqT d g) true p))) ;

-- b = g an atom, d = (d0, ds):  d0 = g, ds <' c
mid-gP (g c d0 ds : T) (hg : Tr (isA g)) (tg : TT g) (td : TT (plus d0 ds))
  (h1 : LT g (plus d0 ds)) (h2 : LT (plus d0 ds) (plus g c)) : SumMid g c (plus d0 ds) =
  orE (SumMid g c (plus d0 ds)) (lt d0 g) (and (eqT d0 g) (lt ds c)) (trans (sym (lex-PP d0 ds g c)) h2)
    (\ p -> orE (SumMid g c (plus d0 ds)) (lt g d0) (and (eqT g d0) true) (trans (sym (lex-AP g hg d0 ds)) h1)
              (\ q -> asym-abs (SumMid g c (plus d0 ds)) g d0 tg (isT-plus0 d0 ds td) q p)
              (\ q -> irr-abs (SumMid g c (plus d0 ds)) d0 (eq-lt-r d0 g d0 p (and-l (eqT g d0) true q))))
    (\ p -> (ds, (trans (ap (\ s -> plus s ds) (eqT-sound d0 g (and-l (eqT d0 g) (lt ds c) p))) (sym (cat-A g hg ds)),
                  (isT-plusS d0 ds td, (tail-nz d0 ds td, and-r (eqT d0 g) (lt ds c) p))))) ;

-- b = (b0, bs), d = (d0, ds):  d0 = b0, bs <' ds <' cat bs c
MidP (b0 bs c d0 ds : T) : U pl = Id T d0 b0 * (LT bs ds * LT ds (cat bs c)) ;
mid-PP (b0 bs c d0 ds : T) (tb : TT (plus b0 bs)) (td : TT (plus d0 ds))
  (h1 : LT (plus b0 bs) (plus d0 ds)) (h2 : LT (plus d0 ds) (plus b0 (cat bs c))) : MidP b0 bs c d0 ds =
  orE (MidP b0 bs c d0 ds) (lt d0 b0) (and (eqT d0 b0) (lt ds (cat bs c))) (trans (sym (lex-PP d0 ds b0 (cat bs c))) h2)
    (\ p -> orE (MidP b0 bs c d0 ds) (lt b0 d0) (and (eqT b0 d0) (lt bs ds)) (trans (sym (lex-PP b0 bs d0 ds)) h1)
              (\ q -> asym-abs (MidP b0 bs c d0 ds) b0 d0 (isT-plus0 b0 bs tb) (isT-plus0 d0 ds td) q p)
              (\ q -> irr-abs (MidP b0 bs c d0 ds) d0 (eq-lt-r d0 b0 d0 p (and-l (eqT b0 d0) (lt bs ds) q))))
    (\ p -> orE (MidP b0 bs c d0 ds) (lt b0 d0) (and (eqT b0 d0) (lt bs ds)) (trans (sym (lex-PP b0 bs d0 ds)) h1)
              (\ q -> irr-abs (MidP b0 bs c d0 ds) b0 (eq-lt-r b0 d0 b0 q (and-l (eqT d0 b0) (lt ds (cat bs c)) p)))
              (\ q -> (eqT-sound d0 b0 (and-l (eqT d0 b0) (lt ds (cat bs c)) p),
                       (and-r (eqT b0 d0) (lt bs ds) q, and-r (eqT d0 b0) (lt ds (cat bs c)) p)))) ;

-- the step (b0, bs), from the induction hypothesis at bs
mid-plus (b0 bs c d0 ds : T) (m : MidP b0 bs c d0 ds) (r : SumMid bs c ds) : SumMid (plus b0 bs) c (plus d0 ds) =
  (r.1, (subst (\ s -> Id T (plus d0 ds) (plus s (cat bs r.1))) m.1 (ap (\ t -> plus d0 t) r.2.1), r.2.2)) ;

SM (b c : T) : U pl = (d : T) -> TT d -> LT b d -> LT d (cat b c) -> SumMid b c d ;

-- b = g an atom (cat g c = (g, c))
sm-atom (g c : T) (hg : Tr (isA g)) (tg : TT g) : (d : T) -> TT d -> LT g d -> LT d (plus g c) -> SumMid g c d = split {
  zero -> \ td h1 h2 -> absurdB (SumMid g c zero) (trans (sym (lt-zero g)) h1) ;
  plus d0 ds -> \ td h1 h2 -> mid-gP g c d0 ds hg tg td h1 h2 ;
  phi x0 x1 -> \ td h1 h2 -> atom-mid (SumMid g c (phi x0 x1)) (phi x0 x1) g c (refl true) td tg h1 h2 ;
  psi x0 x1 -> \ td h1 h2 -> atom-mid (SumMid g c (psi x0 x1)) (psi x0 x1) g c (refl true) td tg h1 h2 ;
  om x0 -> \ td h1 h2 -> atom-mid (SumMid g c (om x0)) (om x0) g c (refl true) td tg h1 h2 ;
  ii -> \ td h1 h2 -> atom-mid (SumMid g c ii) ii g c (refl true) td tg h1 h2 } ;

-- (b0, bs) <' d, d an atom  =>  b0 <' d
pa-lt (b0 bs d : T) (hd : Tr (isA d)) (h : LT (plus b0 bs) d) : LT b0 d =
  trans (sym (orAF (lt b0 d) (eqT b0 d))) (trans (sym (lex-PA b0 bs d hd)) h) ;

-- b = (b0, bs) (cat b c = (b0, cat bs c))
sm-plus (b0 bs c : T) (tb : TT (plus b0 bs)) (r : SM bs c)
  : (d : T) -> TT d -> LT (plus b0 bs) d -> LT d (plus b0 (cat bs c)) -> SumMid (plus b0 bs) c d = split {
  zero -> \ td h1 h2 -> absurdB (SumMid (plus b0 bs) c zero) (trans (sym (lt-zero (plus b0 bs))) h1) ;
  plus d0 ds -> \ td h1 h2 ->
    mid-plus b0 bs c d0 ds (mid-PP b0 bs c d0 ds tb td h1 h2)
      (r ds (isT-plusS d0 ds td) (mid-PP b0 bs c d0 ds tb td h1 h2).2.1 (mid-PP b0 bs c d0 ds tb td h1 h2).2.2) ;
  phi x0 x1 -> \ td h1 h2 -> atom-mid (SumMid (plus b0 bs) c (phi x0 x1)) (phi x0 x1) b0 (cat bs c) (refl true) td (isT-plus0 b0 bs tb)
                                (pa-lt b0 bs (phi x0 x1) (refl true) h1) h2 ;
  psi x0 x1 -> \ td h1 h2 -> atom-mid (SumMid (plus b0 bs) c (psi x0 x1)) (psi x0 x1) b0 (cat bs c) (refl true) td (isT-plus0 b0 bs tb)
                                (pa-lt b0 bs (psi x0 x1) (refl true) h1) h2 ;
  om x0 -> \ td h1 h2 -> atom-mid (SumMid (plus b0 bs) c (om x0)) (om x0) b0 (cat bs c) (refl true) td (isT-plus0 b0 bs tb)
                            (pa-lt b0 bs (om x0) (refl true) h1) h2 ;
  ii -> \ td h1 h2 -> atom-mid (SumMid (plus b0 bs) c ii) ii b0 (cat bs c) (refl true) td (isT-plus0 b0 bs tb)
                         (pa-lt b0 bs ii (refl true) h1) h2 } ;

-- b, d in T', b /= 0, b <' d <' cat b c  =>  d = cat b d', d' /= 0, d' <' c
sum-mid (c : T) : (b : T) -> TT b -> NZ b -> SM b c = split {
  zero -> \ tb nb -> abT nb ;
  plus b0 bs | _ r -> \ tb nb -> sm-plus b0 bs c tb (r (isT-plusS b0 bs tb) (tail-nz b0 bs tb)) ;
  phi x0 x1 -> \ tb nb -> sm-atom (phi x0 x1) c (refl true) tb ;
  psi x0 x1 -> \ tb nb -> sm-atom (psi x0 x1) c (refl true) tb ;
  om x0 -> \ tb nb -> sm-atom (om x0) c (refl true) tb ;
  ii -> \ tb nb -> sm-atom ii c (refl true) tb } ;

------------------------------------------------------------------------
-- Small steps for a <' k+

-- k+ in OT;  d <' a <' k+
k-up (A : Cl) (k : T) (h : H17 A k) : OK (up k) = (rem214a k (k-ok A k h)).2.1 ;
k-lt (A : Cl) (k : T) (h : H17 A k) (d a : T) (od : OK d) (oa : OK a) (l : LT d a) (la : LT a (up k)) : LT d (up k) =
  trOT d a (up k) od oa (k-up A k h) l la ;

-- x in C^a(A), x <' y in tau^A(a)  =>  x in tau^A(a)
tau-in (A : Cl) (a x y : T) (oa : OK a) (cx : C a A x) (l : LT x y) (ty : tau A a y) : tau A a x =
  (cx, trOT x y a (ca-ok a A x cx) (ca-ok a A y ty.1) oa l ty.2) ;

-- (d0, ds) =NF d0 + ds
nfs-head (d0 ds : T) (o : OK (plus d0 ds)) : NFsum (plus d0 ds) d0 ds =
  (sym (cat-A d0 (ot-plusA d0 ds o) ds),
   (ot-T d0 (ot-plus0 d0 ds o), (ot-T ds (ot-plusS d0 ds o), (A-nz d0 (ot-plusA d0 ds o), (tail-nz d0 ds (ot-T (plus d0 ds) o), o))))) ;

-- the parts of a sum, a phi, an Omega' in tau^A(a) are in tau^A(a)  (C^a(A) downward closed)
tp-plus (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (la : LT a (up k)) (d0 ds : T) (td : tau A a (plus d0 ds))
  : tau A a d0 * tau A a ds =
  let { o : OK (plus d0 ds) = ca-ok a A (plus d0 ds) td.1 ;
        p : C a A d0 * C a A ds = dc-sum (C a A) (k-dc A k h a oa la) (plus d0 ds) d0 ds (ot-plus0 d0 ds o) (ot-plusS d0 ds o) td.1 (nfs-head d0 ds o) ; }
  in (tau-in A a d0 (plus d0 ds) oa p.1 (lt-head d0 ds (ot-plusA d0 ds o)) td,
      tau-in A a ds (plus d0 ds) oa p.2 (sum-lt ds d0 o) td) ;

tp-phi (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (la : LT a (up k)) (d1 d2 : T) (td : tau A a (phi d1 d2))
  : tau A a d1 * tau A a d2 =
  let { o : OK (phi d1 d2) = ca-ok a A (phi d1 d2) td.1 ;
        p : C a A d1 * C a A d2 = wd-p (C a A) (dc-wd (C a A) (k-dc A k h a oa la)) (phi d1 d2) d1 d2 (ot-phi0 d1 d2 o) (ot-phi1 d1 d2 o)
                                    td.1 (refl (phi d1 d2), o) ; }
  in (tau-in A a d1 (phi d1 d2) oa p.1 (lt-phi-l (phi d1 d2) d1 d2 (ot-phi0 d1 d2 o) (ot-phi1 d1 d2 o) (refl (phi d1 d2), o)) td,
      tau-in A a d2 (phi d1 d2) oa p.2 (lt-phi-r (phi d1 d2) d1 d2 (ot-phi0 d1 d2 o) (ot-phi1 d1 d2 o) (refl (phi d1 d2), o)) td) ;

tp-om (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (la : LT a (up k)) (d1 : T) (td : tau A a (om d1)) : tau A a d1 =
  let { o : OK (om d1) = ca-ok a A (om d1) td.1 ; }
  in tau-in A a d1 (om d1) oa (wd-o (C a A) (dc-wd (C a A) (k-dc A k h a oa la)) (om d1) d1 (ot-om0 d1 o) td.1 (refl (om d1), o))
       (lt-om-nf (om d1) d1 (ot-om0 d1 o) (refl (om d1), o)) td ;

------------------------------------------------------------------------
-- (ii) sums:  b in W(A);  for c in W(A), a <' k+, a =NF b + c  =>  a in W(A)

SumQ (A : Cl) (k b c : T) : U pl = (a : T) -> OK a -> LT a (up k) -> NFsum a b c -> WA[pl].WA A a ;

-- d = b + d' (sum-mid):  d' in tau^A(c), the induction hypothesis
ws-at (A : Cl) (k : T) (h : H17 A k) (b c : T) (ih : Sub (tau A c) (SumQ A k b))
  (a : T) (oa : OK a) (la : LT a (up k)) (hs : NFsum a b c) (d : T) (td : tau A a d) (m : SumMid b c d) : WA[pl].WA A d =
  let { od : OK d = ca-ok a A d td.1 ;
        hd : NFsum d b m.1 = (m.2.1, (nfs-tx a b c hs, (m.2.2.1, (nfs-nx a b c hs, (m.2.2.2.1, od))))) ;
        oc : OK c = (nfs-OK a b c hs).2 ;
        o2 : OK b * OK m.1 = nfs-OK d b m.1 hd ;
        lc : LT c a = (nf-lt a b c hs).2 ;
        cd : C a A m.1 = (dc-sum (C a A) (k-dc A k h a oa la) d b m.1 o2.1 o2.2 td.1 hd).2 ; }
  in ih m.1 (rem49a A (k-m A k h) a c oa oc (le-of-lt c a lc) m.1 ((cd, trOT m.1 c a o2.2 oc oa m.2.2.2.2 lc), m.2.2.2.2))
       d od (k-lt A k h d a od oa td.2 la) hd ;

ws-step (A : Cl) (k : T) (h : H17 A k) (b : T) (wb : WA[pl].WA A b) (c : T) (wc : WA[pl].WA A c) (ih : Sub (tau A c) (SumQ A k b))
  : SumQ A k b c =
  \ a oa la hs ->
    wa-a A a
      (rem49e-sum A (k-m A k h) a b c hs (k-wdc A k h a oa la) (good-w A k h b wb a oa la) (good-w A k h c wc a oa la),
       \ d td ->
         boolCases (WA[pl].WA A d) (lt b d)
           (\ l -> ws-at A k h b c ih a oa la hs d td
                     (sum-mid c b (nfs-tx a b c hs) (nfs-nx a b c hs) d (ot-T d (ca-ok a A d td.1)) l
                        (lt-r d a (cat b c) (nfs-e a b c hs) td.2)))
           (\ f -> w-below A (k-m A k h) b a d wb oa (le-of-lt b a (nf-lt a b c hs).1) td
                     (nlt-le d b (ot-T d (ca-ok a A d td.1)) (ot-T b (wa-OK A b wb)) f))) ;

w-sum (A : Cl) (k : T) (h : H17 A k) (b : T) (wb : WA[pl].WA A b) : Sub (WA[pl].WA A) (SumQ A k b) =
  wa-ind A (SumQ A k b) (\ c wc mc ih -> ws-step A k h b wb c wc ih) ;

-- a sum in tau^A(a) whose parts are in W(A)
t-plus (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (la : LT a (up k)) (d0 ds : T)
  (r0 : tau A a d0 -> WA[pl].WA A d0) (rs : tau A a ds -> WA[pl].WA A ds) (td : tau A a (plus d0 ds)) : WA[pl].WA A (plus d0 ds) =
  let { o : OK (plus d0 ds) = ca-ok a A (plus d0 ds) td.1 ;
        p : tau A a d0 * tau A a ds = tp-plus A k h a oa la d0 ds td ; }
  in w-sum A k h d0 (r0 p.1) ds (rs p.2) (plus d0 ds) o (k-lt A k h (plus d0 ds) a o oa td.2 la) (nfs-head d0 ds o) ;

------------------------------------------------------------------------
-- (iii) phi:  b, c in W(A), a <' k+, a =NF phi_b c  =>  a in W(A)

PhiQ (A : Cl) (k b c : T) : U pl = (a : T) -> OK a -> LT a (up k) -> NFphi a b c -> WA[pl].WA A a ;
PhiP (A : Cl) (k b : T) : U pl = Sub (WA[pl].WA A) (PhiQ A k b) ;

-- d <=' b, or d <=' c, or b, c <' d
above2 (P : U pl) (d b c : T) (td : TT d) (tb : TT b) (tc : TT c)
  (k1 : Tr (le d b) -> P) (k2 : Tr (le d c) -> P) (k3 : LT b d -> LT c d -> P) : P =
  boolCases P (lt b d)
    (\ p -> boolCases P (lt c d) (\ q -> k3 p q) (\ q -> k2 (nlt-le d c td tc q)))
    (\ p -> k1 (nlt-le d b td tb p)) ;

-- phi_d1 d2 = phi_b d2 for d1 = b
phi-eq (d1 b d2 : T) (e : EQ d1 b) : Id T (phi d1 d2) (phi b d2) = ap (\ x -> phi x d2) (eqT-sound d1 b e) ;

-- the data of one step of (iii): b, c in W(A), the main and side induction
-- hypotheses, and a =NF phi_b c <' k+
PhiS (A : Cl) (k b c a : T) : U pl =
  WA[pl].WA A b * (WA[pl].WA A c * (Sub (tau A b) (PhiP A k) * (Sub (tau A c) (PhiQ A k b) *
  (OK a * (LT a (up k) * NFphi a b c))))) ;
ps-wb (A : Cl) (k b c a : T) (s : PhiS A k b c a) : WA[pl].WA A b = s.1 ;
ps-wc (A : Cl) (k b c a : T) (s : PhiS A k b c a) : WA[pl].WA A c = s.2.1 ;
ps-ihb (A : Cl) (k b c a : T) (s : PhiS A k b c a) : Sub (tau A b) (PhiP A k) = s.2.2.1 ;
ps-ihc (A : Cl) (k b c a : T) (s : PhiS A k b c a) : Sub (tau A c) (PhiQ A k b) = s.2.2.2.1 ;
ps-oa (A : Cl) (k b c a : T) (s : PhiS A k b c a) : OK a = s.2.2.2.2.1 ;
ps-la (A : Cl) (k b c a : T) (s : PhiS A k b c a) : LT a (up k) = s.2.2.2.2.2.1 ;
ps-hs (A : Cl) (k b c a : T) (s : PhiS A k b c a) : NFphi a b c = s.2.2.2.2.2.2 ;
ps-ob (A : Cl) (k b c a : T) (s : PhiS A k b c a) : OK b = wa-OK A b s.1 ;
ps-oc (A : Cl) (k b c a : T) (s : PhiS A k b c a) : OK c = wa-OK A c s.2.1 ;

-- b, c <=' a
ps-lb (A : Cl) (k b c a : T) (s : PhiS A k b c a) : Tr (le b a) =
  le-of-lt b a (lt-phi-l a b c (ps-ob A k b c a s) (ps-oc A k b c a s) (ps-hs A k b c a s)) ;
ps-lc (A : Cl) (k b c a : T) (s : PhiS A k b c a) : Tr (le c a) =
  le-of-lt c a (lt-phi-r a b c (ps-ob A k b c a s) (ps-oc A k b c a s) (ps-hs A k b c a s)) ;

-- d = phi_d1 d2 in tau^A(a), b, c <' d, d2 in W(A): clause (3) for d <' phi_b c
wp-phi (A : Cl) (k : T) (h : H17 A k) (b c a : T) (s : PhiS A k b c a) (d1 d2 : T) (w2 : WA[pl].WA A d2)
  (td : tau A a (phi d1 d2)) (lb : LT b (phi d1 d2)) (lc : LT c (phi d1 d2)) : WA[pl].WA A (phi d1 d2) =
  let { o : OK (phi d1 d2) = ca-ok a A (phi d1 d2) td.1 ;
        t : tau A a d1 * tau A a d2 = tp-phi A k h a (ps-oa A k b c a s) (ps-la A k b c a s) d1 d2 td ;
        lu : LT (phi d1 d2) (up k) = k-lt A k h (phi d1 d2) a o (ps-oa A k b c a s) td.2 (ps-la A k b c a s) ; }
  in phi3-cases (WA[pl].WA A (phi d1 d2)) d1 d2 b c (lt-r (phi d1 d2) a (phi b c) (ps-hs A k b c a s).1 td.2)
       (\ p q -> ps-ihb A k b c a s d1
                   (rem49a A (k-m A k h) a b (ps-oa A k b c a s) (ps-ob A k b c a s) (ps-lb A k b c a s) d1 (t.1, p))
                   d2 w2 (phi d1 d2) o lu (refl (phi d1 d2), o))
       (\ e q -> ps-ihc A k b c a s d2
                   (rem49a A (k-m A k h) a c (ps-oa A k b c a s) (ps-oc A k b c a s) (ps-lc A k b c a s) d2 (t.2, q))
                   (phi d1 d2) o lu (phi-eq d1 b d2 e, o))
       (\ p q -> le-abs (WA[pl].WA A (phi d1 d2)) (phi d1 d2) c (ot-T (phi d1 d2) o) (ot-T c (ps-oc A k b c a s)) q lc) ;

-- g in G', b, c <' g:  g <' phi_b c is impossible (clause (4))
wp-G (R : U pl) (A : Cl) (k b c a g : T) (s : PhiS A k b c a) (hg : Tr (isG g)) (tg : TT g) (l : LT g a)
  (lb : LT b g) (lc : LT c g) : R =
  gf-elim R b c g (ot-T b (ps-ob A k b c a s)) (ot-T c (ps-oc A k b c a s)) tg hg (lt-r g a (phi b c) (ps-hs A k b c a s).1 l)
    (\ q -> le-abs R g b tg (ot-T b (ps-ob A k b c a s)) q lb)
    (\ q -> le-abs R g c tg (ot-T c (ps-oc A k b c a s)) q lc) ;

-- d <=' b or d <=' c: w-below; otherwise the case k3
wp-cases (A : Cl) (k : T) (h : H17 A k) (b c a d : T) (s : PhiS A k b c a) (td : tau A a d)
  (k3 : LT b d -> LT c d -> WA[pl].WA A d) : WA[pl].WA A d =
  above2 (WA[pl].WA A d) d b c (ot-T d (ca-ok a A d td.1)) (ot-T b (ps-ob A k b c a s)) (ot-T c (ps-oc A k b c a s))
    (\ l -> w-below A (k-m A k h) b a d (ps-wb A k b c a s) (ps-oa A k b c a s) (ps-lb A k b c a s) td l)
    (\ l -> w-below A (k-m A k h) c a d (ps-wc A k b c a s) (ps-oa A k b c a s) (ps-lc A k b c a s) td l)
    k3 ;

wp-at (A : Cl) (k : T) (h : H17 A k) (b c a g : T) (s : PhiS A k b c a) (hg : Tr (isG g)) (td : tau A a g) : WA[pl].WA A g =
  wp-cases A k h b c a g s td
    (\ lb lc -> wp-G (WA[pl].WA A g) A k b c a g s hg (ot-T g (ca-ok a A g td.1)) td.2 lb lc) ;

-- tau^A(a) c W(A), by induction on d
wp-rec (A : Cl) (k : T) (h : H17 A k) (b c a : T) (s : PhiS A k b c a) : (d : T) -> tau A a d -> WA[pl].WA A d = split {
  zero -> \ td -> rem417a A ;
  plus d0 ds | r0 rs -> t-plus A k h a (ps-oa A k b c a s) (ps-la A k b c a s) d0 ds r0 rs ;
  phi d1 d2 | _ r2 -> \ td ->
    wp-cases A k h b c a (phi d1 d2) s td
      (\ lb lc -> wp-phi A k h b c a s d1 d2
                    (r2 (tp-phi A k h a (ps-oa A k b c a s) (ps-la A k b c a s) d1 d2 td).2) td lb lc) ;
  psi x0 x1 -> wp-at A k h b c a (psi x0 x1) s (refl true) ;
  om x0 -> wp-at A k h b c a (om x0) s (refl true) ;
  ii -> wp-at A k h b c a ii s (refl true) } ;

wp-step (A : Cl) (k : T) (h : H17 A k) (b : T) (wb : WA[pl].WA A b) (ihb : Sub (tau A b) (PhiP A k))
  (c : T) (wc : WA[pl].WA A c) (ihc : Sub (tau A c) (PhiQ A k b)) : PhiQ A k b c =
  \ a oa la hs ->
    wa-a A a
      (rem49e-phi A (k-m A k h) a b c hs (good-w A k h b wb a oa la) (good-w A k h c wc a oa la),
       wp-rec A k h b c a (wb, (wc, (ihb, (ihc, (oa, (la, hs))))))) ;

w-phi (A : Cl) (k : T) (h : H17 A k) : Sub (WA[pl].WA A) (PhiP A k) =
  wa-ind A (PhiP A k)
    (\ b wb mb ihb -> wa-ind A (PhiQ A k b) (\ c wc mc ihc -> wp-step A k h b wb ihb c wc ihc)) ;

-- a phi in tau^A(a) whose parts are in W(A)
t-phi (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (la : LT a (up k)) (d1 d2 : T)
  (r1 : tau A a d1 -> WA[pl].WA A d1) (r2 : tau A a d2 -> WA[pl].WA A d2) (td : tau A a (phi d1 d2)) : WA[pl].WA A (phi d1 d2) =
  let { o : OK (phi d1 d2) = ca-ok a A (phi d1 d2) td.1 ;
        p : tau A a d1 * tau A a d2 = tp-phi A k h a oa la d1 d2 td ; }
  in w-phi A k h d1 (r1 p.1) d2 (r2 p.2) (phi d1 d2) o (k-lt A k h (phi d1 d2) a o oa td.2 la) (refl (phi d1 d2), o) ;

------------------------------------------------------------------------
-- (iv) Omega:  b in W(A), a <' k+, a =NF Omega_b  =>  a in W(A)

OmP (A : Cl) (k b : T) : U pl = (a : T) -> OK a -> LT a (up k) -> NFom a b -> WA[pl].WA A a ;

-- the data of one step of (iv)
OmS (A : Cl) (k b a : T) : U pl =
  WA[pl].WA A b * (Sub (tau A b) (OmP A k) * (OK a * (LT a (up k) * NFom a b))) ;
os-wb (A : Cl) (k b a : T) (s : OmS A k b a) : WA[pl].WA A b = s.1 ;
os-ih (A : Cl) (k b a : T) (s : OmS A k b a) : Sub (tau A b) (OmP A k) = s.2.1 ;
os-oa (A : Cl) (k b a : T) (s : OmS A k b a) : OK a = s.2.2.1 ;
os-la (A : Cl) (k b a : T) (s : OmS A k b a) : LT a (up k) = s.2.2.2.1 ;
os-hs (A : Cl) (k b a : T) (s : OmS A k b a) : NFom a b = s.2.2.2.2 ;
os-ob (A : Cl) (k b a : T) (s : OmS A k b a) : OK b = wa-OK A b s.1 ;
os-lb (A : Cl) (k b a : T) (s : OmS A k b a) : Tr (le b a) =
  le-of-lt b a (lt-om-nf a b (os-ob A k b a s) (os-hs A k b a s)) ;

-- (Omega'_b)~ = Omega'_b  (by definition of tilde)
til-nfom (a b : T) (hs : NFom a b) : Id T (tilde a) a = subst (\ x -> Id T (tilde x) x) (sym hs.1) (refl (om b)) ;

-- a <=' k
os-lk (A : Cl) (k : T) (h : H17 A k) (b a : T) (s : OmS A k b a) : Tr (le a k) =
  le-l (tilde a) a k (til-nfom a b (os-hs A k b a s)) (k-til A k h a (os-oa A k b a s) (os-la A k b a s)) ;

-- y <' a = Omega'_b, by clauses (7), (10):  y <=' b
le-of-lex (u b : T) (p : LT u (om b)) (lx : Lex u (om b) u b true) : Tr (le u b) =
  trans (sym (orAT (lt u b) (eqT u b))) (trans (sym lx) p) ;

-- Omega'_y1 <' Omega'_b  =>  y1 <' b  (clause (9))
om-lt-om (y1 b : T) (l : LT (om y1) (om b)) : LT y1 b =
  trans (sym (orAF (lt y1 b) (eqT y1 b))) (trans (sym (lex-OO y1 b)) l) ;

-- Omega'_y1 in tau^A(a): y1 <' b (clause (9)), the main induction hypothesis
wo-om (A : Cl) (k : T) (h : H17 A k) (b a : T) (s : OmS A k b a) (y1 : T) (ty : tau A a (om y1)) : WA[pl].WA A (om y1) =
  let { oy : OK (om y1) = ca-ok a A (om y1) ty.1 ;
        l1 : LT y1 b = om-lt-om y1 b (lt-r (om y1) a (om b) (os-hs A k b a s).1 ty.2) ; }
  in os-ih A k b a s y1
       (rem49a A (k-m A k h) a b (os-oa A k b a s) (os-ob A k b a s) (os-lb A k b a s) y1
          (tp-om A k h a (os-oa A k b a s) (os-la A k b a s) y1 ty, l1))
       (om y1) oy (k-lt A k h (om y1) a oy (os-oa A k b a s) ty.2 (os-la A k b a s)) (refl (om y1), oy) ;

-- psi_p y1 in tau^A(a): in A n a (k-low), or a <' p
wo-psi (A : Cl) (k : T) (h : H17 A k) (b a : T) (s : OmS A k b a) (p y1 : T) (ty : tau A a (psi p y1)) : WA[pl].WA A (psi p y1) =
  let { oy : OK (psi p y1) = ca-ok a A (psi p y1) ty.1 ;
        ly : LT (psi p y1) (om b) = lt-r (psi p y1) a (om b) (os-hs A k b a s).1 ty.2 ; }
  in either (Cap A a (psi p y1)) (PsiP a A p y1) (WA[pl].WA A (psi p y1))
       (\ q -> k-low A k h (psi p y1) a (os-oa A k b a s) q.1 q.2 (os-lk A k h b a s))
       (\ r -> boolCases (WA[pl].WA A (psi p y1)) (isI p)
                 (\ t -> w-below A (k-m A k h) b a (psi p y1) (os-wb A k b a s) (os-oa A k b a s) (os-lb A k b a s) ty
                           (le-of-lex (psi p y1) b ly (lex-TO p y1 b t)))
                 (\ f -> asym-abs (WA[pl].WA A (psi p y1)) a (psi p y1) (ot-T a (os-oa A k b a s)) (ot-T (psi p y1) oy)
                           (lt-l (tilde a) a (psi p y1) (til-nfom a b (os-hs A k b a s)) (til-psi a p y1 (os-oa A k b a s) oy f r.1))
                           ty.2))
       (fw (C a A (psi p y1)) (Or (Cap A a (psi p y1)) (PsiP a A p y1)) (ca-psi a A p y1 oy) ty.1) ;

-- tau^A(a) c W(A), by induction on y
wo-rec (A : Cl) (k : T) (h : H17 A k) (b a : T) (s : OmS A k b a) : (y : T) -> tau A a y -> WA[pl].WA A y = split {
  zero -> \ ty -> rem417a A ;
  plus y0 ys | r0 rs -> t-plus A k h a (os-oa A k b a s) (os-la A k b a s) y0 ys r0 rs ;
  phi y1 y2 | r1 r2 -> t-phi A k h a (os-oa A k b a s) (os-la A k b a s) y1 y2 r1 r2 ;
  psi p y1 -> wo-psi A k h b a s p y1 ;
  om y1 -> wo-om A k h b a s y1 ;
  ii -> \ ty -> w-below A (k-m A k h) b a ii (os-wb A k b a s) (os-oa A k b a s) (os-lb A k b a s) ty
                  (le-of-lex ii b (lt-r ii a (om b) (os-hs A k b a s).1 ty.2)
                     (lex-IO b (ot-T b (os-ob A k b a s)))) } ;

w-om (A : Cl) (k : T) (h : H17 A k) : Sub (WA[pl].WA A) (OmP A k) =
  wa-ind A (OmP A k)
    (\ b wb mb ih a oa la hs ->
       wa-a A a (rem49e-om A (k-m A k h) a b hs (good-w A k h b wb a oa la),
                 wo-rec A k h b a (wb, (ih, (oa, (la, hs)))))) ;

-- an Omega' in tau^A(a) whose part is in W(A)
t-om (A : Cl) (k : T) (h : H17 A k) (a : T) (oa : OK a) (la : LT a (up k)) (y1 : T)
  (r1 : tau A a y1 -> WA[pl].WA A y1) (ty : tau A a (om y1)) : WA[pl].WA A (om y1) =
  let { oy : OK (om y1) = ca-ok a A (om y1) ty.1 ; }
  in w-om A k h y1 (r1 (tp-om A k h a oa la y1 ty)) (om y1) oy (k-lt A k h (om y1) a oy oa ty.2 la) (refl (om y1), oy) ;

------------------------------------------------------------------------
-- (v) I <' k+  =>  I in W(A)

-- I~ = I  (by definition of tilde)
tilde-ii : Id T (tilde ii) ii = refl ii ;

-- psi_p y1 in tau^A(I): in A n I (k-low), or I <' p, impossible
wi-psi (A : Cl) (k : T) (h : H17 A k) (la : LT ii (up k)) (p y1 : T) (ty : tau A ii (psi p y1)) : WA[pl].WA A (psi p y1) =
  let { oy : OK (psi p y1) = ca-ok ii A (psi p y1) ty.1 ; }
  in either (Cap A ii (psi p y1)) (PsiP ii A p y1) (WA[pl].WA A (psi p y1))
       (\ q -> k-low A k h (psi p y1) ii ok-ii q.1 q.2 (le-l (tilde ii) ii k tilde-ii (k-til A k h ii ok-ii la)))
       (\ r -> boolCases (WA[pl].WA A (psi p y1)) (isI p)
                 (\ t -> irr-abs (WA[pl].WA A (psi p y1)) ii (lt-r ii p ii (isI-true p t) r.1))
                 (\ f -> asym-abs (WA[pl].WA A (psi p y1)) ii (psi p y1) (refl true) (ot-T (psi p y1) oy)
                           (lt-l (tilde ii) ii (psi p y1) tilde-ii (til-psi ii p y1 ok-ii oy f r.1)) ty.2))
       (fw (C ii A (psi p y1)) (Or (Cap A ii (psi p y1)) (PsiP ii A p y1)) (ca-psi ii A p y1 oy) ty.1) ;

wi-rec (A : Cl) (k : T) (h : H17 A k) (la : LT ii (up k)) : (y : T) -> tau A ii y -> WA[pl].WA A y = split {
  zero -> \ ty -> rem417a A ;
  plus y0 ys | r0 rs -> t-plus A k h ii ok-ii la y0 ys r0 rs ;
  phi y1 y2 | r1 r2 -> t-phi A k h ii ok-ii la y1 y2 r1 r2 ;
  psi p y1 -> wi-psi A k h la p y1 ;
  om y1 | r1 -> t-om A k h ii ok-ii la y1 r1 ;
  ii -> \ ty -> irr-abs (WA[pl].WA A ii) ii ty.2 } ;

w-ii (A : Cl) (k : T) (h : H17 A k) (la : LT ii (up k)) : WA[pl].WA A ii =
  wa-a A ii ((rem49d A).2, wi-rec A k h la) ;

------------------------------------------------------------------------
-- Lemma 4.17 (b)

-- W(A) n k+ weakly upward closed bounded by k+
k-wu (A : Cl) (k : T) (h : H17 A k) : WU (Cap (WA[pl].WA A) (up k)) (Bnd (up k)) =
  (\ z x y bx by o c hs -> (w-sum A k h x bx.1 y by.1 z o c hs.1, c),
   (\ z x y bx by o c hs -> (w-phi A k h x bx.1 y by.1 z o c hs, c),
    (\ z x bx o c hs -> (w-om A k h x bx.1 z o c hs, c),
     (\ c -> (rem417a A, c), \ c -> (w-ii A k h c, c))))) ;

rem417b (A : Cl) (k : T) (h : H17 A k) : DC (Cap (WA[pl].WA A) (up k)) * UC (Cap (WA[pl].WA A) (up k)) (Bnd (up k)) =
  rem415 (Cap (WA[pl].WA A) (up k)) (Bnd (up k))
    (\ x g -> wa-OK A x g.1,
     (ini-bnd (up k) (ot-T (up k) (k-up A k h)),
      ((rem416a-W A (k-m A k h) k (k-ok A k h) (k-wt A k h)).1,
       (k-wu A k h,
        \ x g -> g.2)))) ;

------------------------------------------------------------------------
-- Cardinals

-- a cardinal Omega_s <=' x is <=' x~  (OTF.card-M)
card-le (c s : T) (os : OK s) (e : Id T c (omF s)) (x : T) (ox : OK x) (l : Tr (le c x)) : Tr (le c (tilde x)) =
  subst (\ w -> Tr (le w (tilde x))) (sym e) (card-M x ox s os (subst (\ w -> Tr (le w x)) e l)) ;

-- a~ <=' (a~)~   (a~ = Omega_s, 2.14(f))
til-self (a : T) (oa : OK a) : Tr (le (tilde a) (tilde (tilde a))) =
  card-le (tilde a) (rem214f a oa).1 (rem214f a oa).2.1 (rem214f a oa).2.2.1 (tilde a) (til-OK a oa) (le-refl (tilde a)) ;

-- x <=' y <=' x  =>  x = y
le-antisym (x y : T) (tx : TT x) (ty : TT y) (l1 : Tr (le x y)) (l2 : Tr (le y x)) : Id T x y =
  orE (Id T x y) (lt x y) (eqT x y) l1 (\ p -> le-abs (Id T x y) y x ty tx l2 p) (\ e -> eqT-sound x y e) ;

-- (Omega'_e)^- = Omega_{pred e}  (by definition of kminus)
km-om (e : T) : Id T (kminus (om e)) (omF (pred1 e)) = refl (omF (pred1 e)) ;

-- q in R \ {I}:  q^- = Omega_s with s in OT
KmF (q : T) : U pl = (s : T) * (OK s * Id T (kminus q) (omF s)) ;
km-F (q : T) (rq : Tr (isR q)) (nq : Id Bool (isI q) false) (oq : OK q) : KmF q =
  subst (\ x -> OK x -> KmF x) (sym (R-cases q rq nq).1)
    (\ o -> (pred1 (arg q), ((suc-pred (arg q) (ot-om0 (arg q) o) (R-cases q rq nq).2).1, km-om (arg q)))) oq ;

-- q^- <' t+  =>  q^- <=' t~   (q^- <=' (q^-)~ <=' t~, til-up)
km-below (q t : T) (rq : Tr (isR q)) (nq : Id Bool (isI q) false) (oq : OK q) (ot : OK t) (l : LT (kminus q) (up t))
  : Tr (le (kminus q) (tilde t)) =
  le-trans (kminus q) (tilde (kminus q)) (tilde t)
    (trOT (kminus q) (tilde (kminus q)) (tilde t) (ok-km q rq oq) (til-OK (kminus q) (ok-km q rq oq)) (til-OK t ot))
    (card-le (kminus q) (km-F q rq nq oq).1 (km-F q rq nq oq).2.1 (km-F q rq nq oq).2.2 (kminus q) (ok-km q rq oq) (le-refl (kminus q)))
    (til-up (kminus q) t (ok-km q rq oq) ot l) ;

-- y <' q = Omega'_{s+1}  =>  y~ <=' q^- = Omega_s   (WA.til-bound)
til-km (y q : T) (rq : Tr (isR q)) (nq : Id Bool (isI q) false) (oq : OK q) (oy : OK y) (l : LT y q) : Tr (le (tilde y) (kminus q)) =
  subst (\ x -> OK x -> LT y x -> Tr (le (tilde y) (kminus x))) (sym (R-cases q rq nq).1)
    (\ o l' -> til-bound y (pred1 (arg q)) oy (suc-pred (arg q) (ot-om0 (arg q) o) (R-cases q rq nq).2).1
                 (subst (\ w -> LT y w) (sym (om-suc-pred (arg q) o (R-cases q rq nq).2)) l')) oq l ;

-- (psi_p y)~ = p^- for p /= I,  = psi_I y for p = I  (by definition of tilde)
til-psiR (p y : T) (n : Id Bool (isI p) false) : Id T (tilde (psi p y)) (kminus p) = ap (\ c -> c.1) (card-psi-R p y n) ;
til-psiI (p y : T) (t : Tr (isI p)) : Id T (tilde (psi p y)) (psi p y) = ap (\ c -> c.1) (card-psi-I p y t) ;

-- allLt (h, M) y = h <' y and allLt M y  (by definition of allLt)
allLt-cons (h : T) (M : L) (y : T) : Id Bool (allLt (cons h M) y) (and (lt h y) (allLt M y)) = refl (and (lt h y) (allLt M y)) ;
allLt-G (M N : L) (y : T) (e : Id L M N) (g : Tr (allLt M y)) : Tr (allLt N y) = subst (\ K -> Tr (allLt K y)) e g ;
own-I (p y : T) (tp : Tr (isI p)) (i : InC p y (psi p y)) : Tr (inC ii y (psi ii y)) =
  subst (\ x -> Tr (inC x y (psi x y))) (isI-true p tp) i ;

-- psi_I y is not in C_I(y):  y in G_I(psi_I y)
not-own (R : U pl) (p y : T) (tp : Tr (isI p)) (i : InC p y (psi p y)) : R =
  let { i' : Tr (inC ii y (psi ii y)) = own-I p y tp i ;
        g : Tr (allLt (cons y (app (G ii ii) (G ii y))) y)
          = allLt-G (G ii (psi ii y)) (cons y (app (G ii ii) (G ii y))) y (g-psi-hi ii y (le-refl ii))
              (and-r (isT (psi ii y)) (allLt (G ii (psi ii y)) y) i') ; }
  in irr-abs R y (and-l (lt y y) (allLt (app (G ii ii) (G ii y)) y)
                   (tr-bs (and (lt y y) (allLt (app (G ii ii) (G ii y)) y)) (allLt (cons y (app (G ii ii) (G ii y))) y)
                      (allLt-cons y (app (G ii ii) (G ii y)) y) g)) ;

-- psi_k y in OT  (k in R n OT, y in OT, y in C_k(y))
ok-psi (k y : T) (rk : Tr (isR k)) (ok : OK k) (oy : OK y) (iy : InC k y y) : OK (psi k y) =
  andI (and (isR k) (isOT k)) (and (isOT y) (allLt (G k y) y)) (andI (isR k) (isOT k) rk ok)
    (andI (isOT y) (allLt (G k y) y) oy (and-r (isT y) (allLt (G k y) y) iy)) ;

------------------------------------------------------------------------
-- (c): t in W(A) with A c M(A), A n t = W(A) n t (H17 A t)

-- b <' t+, v in W(A)  =>  v in C^b(A)
in-Cb (A : Cl) (t : T) (h : H17 A t) (b : T) (ob : OK b) (lb : LT b (up t)) (v : T) (wv : WA[pl].WA A v) : C b A v =
  boolCases (C b A v) (lt v (tilde b))
    (\ l -> low-in A (k-m A t h) b ob v
              (k-wa A t h v wv (lt-le v (tilde b) t (trOT v (tilde b) t (wa-OK A v wv) (til-OK b ob) (k-ok A t h)) l (k-til A t h b ob lb)), l))
    (\ f -> ca-down A (k-m A t h) v b v ob (wa-OK A v wv)
              (nlt-le (tilde b) v (ot-T (tilde b) (til-OK b ob)) (ot-T v (wa-OK A v wv)) f) (m-c A v (wa-M A v wv))) ;

-- the claim: p = I, or p^- in W(A) n (t+1)
PC (A : Cl) (t p : T) : U pl = Or (Tr (isI p)) (WA[pl].WA A (kminus p) * Tr (le (kminus p) t)) ;
pc-km (A : Cl) (t p : T) (pc : PC A t p) (n : Id Bool (isI p) false) : WA[pl].WA A (kminus p) * Tr (le (kminus p) t) =
  either (Tr (isI p)) (WA[pl].WA A (kminus p) * Tr (le (kminus p) t)) (WA[pl].WA A (kminus p) * Tr (le (kminus p) t))
    (\ q -> absurdT (WA[pl].WA A (kminus p) * Tr (le (kminus p) t)) (trans (sym q) n)) (\ q -> q) pc ;

CP (A : Cl) (t y : T) : U pl =
  LT y (up t) -> (p : T) -> Tr (isR p) -> PC A t p -> OK (psi p y) -> LT (psi p y) (up t) -> WA[pl].WA A (psi p y) ;

-- the data of one step: y in W(A), the induction hypothesis, p, and the conditions
CS (A : Cl) (t y p : T) : U pl =
  WA[pl].WA A y * (Sub (tau A y) (CP A t) * (LT y (up t) * (Tr (isR p) * (PC A t p * (OK (psi p y) * LT (psi p y) (up t)))))) ;
cs-wy (A : Cl) (t y p : T) (s : CS A t y p) : WA[pl].WA A y = s.1 ;
cs-ih (A : Cl) (t y p : T) (s : CS A t y p) : Sub (tau A y) (CP A t) = s.2.1 ;
cs-ly (A : Cl) (t y p : T) (s : CS A t y p) : LT y (up t) = s.2.2.1 ;
cs-rp (A : Cl) (t y p : T) (s : CS A t y p) : Tr (isR p) = s.2.2.2.1 ;
cs-pc (A : Cl) (t y p : T) (s : CS A t y p) : PC A t p = s.2.2.2.2.1 ;
cs-oa (A : Cl) (t y p : T) (s : CS A t y p) : OK (psi p y) = s.2.2.2.2.2.1 ;
cs-la (A : Cl) (t y p : T) (s : CS A t y p) : LT (psi p y) (up t) = s.2.2.2.2.2.2 ;
cs-oy (A : Cl) (t y p : T) (s : CS A t y p) : OK y = wa-OK A y s.1 ;
cs-op (A : Cl) (t y p : T) (s : CS A t y p) : OK p = ot-psi0 p y (cs-oa A t y p s) ;

-- (*):  u in C_p(y), u in C^{psi_p y}(A), u <' t+  =>  u in W(A)
Star (A : Cl) (t y p u : T) : U pl = InC p y u -> C (psi p y) A u -> LT u (up t) -> WA[pl].WA A u ;

-- C^{psi_p y}(A) downward closed
cs-dc (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) : DC (C (psi p y) A) =
  k-dc A t h (psi p y) (cs-oa A t y p s) (cs-la A t y p s) ;

st-plus (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (u0 us : T) (r0 : Star A t y p u0) (rs : Star A t y p us)
  : Star A t y p (plus u0 us) =
  \ iu cu lu ->
    let { o : OK (plus u0 us) = ca-ok (psi p y) A (plus u0 us) cu ;
          c2 : C (psi p y) A u0 * C (psi p y) A us
             = dc-sum (C (psi p y) A) (cs-dc A t h y p s) (plus u0 us) u0 us (ot-plus0 u0 us o) (ot-plusS u0 us o) cu (nfs-head u0 us o) ;
          i2 : Tr (and (inC p y u0) (inC p y us)) = tr-bs (and (inC p y u0) (inC p y us)) (inC p y (plus u0 us)) (rem215b-plus p y u0 us (ot-T (plus u0 us) o)) iu ; }
    in w-sum A t h u0
         (r0 (and-l (inC p y u0) (inC p y us) i2) c2.1 (k-lt A t h u0 (plus u0 us) (ot-plus0 u0 us o) o (lt-head u0 us (ot-plusA u0 us o)) lu))
         us (rs (and-r (inC p y u0) (inC p y us) i2) c2.2 (k-lt A t h us (plus u0 us) (ot-plusS u0 us o) o (sum-lt us u0 o) lu))
         (plus u0 us) o lu (nfs-head u0 us o) ;

st-phi (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (u1 u2 : T) (r1 : Star A t y p u1) (r2 : Star A t y p u2)
  : Star A t y p (phi u1 u2) =
  \ iu cu lu ->
    let { o : OK (phi u1 u2) = ca-ok (psi p y) A (phi u1 u2) cu ;
          c2 : C (psi p y) A u1 * C (psi p y) A u2
             = wd-p (C (psi p y) A) (dc-wd (C (psi p y) A) (cs-dc A t h y p s)) (phi u1 u2) u1 u2 (ot-phi0 u1 u2 o) (ot-phi1 u1 u2 o)
                 cu (refl (phi u1 u2), o) ;
          i2 : Tr (and (inC p y u1) (inC p y u2)) = tr-bs (and (inC p y u1) (inC p y u2)) (inC p y (phi u1 u2)) (rem215b-phi p y u1 u2 (ot-T (phi u1 u2) o)) iu ; }
    in w-phi A t h u1
         (r1 (and-l (inC p y u1) (inC p y u2) i2) c2.1
             (k-lt A t h u1 (phi u1 u2) (ot-phi0 u1 u2 o) o (lt-phi-l (phi u1 u2) u1 u2 (ot-phi0 u1 u2 o) (ot-phi1 u1 u2 o) (refl (phi u1 u2), o)) lu))
         u2 (r2 (and-r (inC p y u1) (inC p y u2) i2) c2.2
             (k-lt A t h u2 (phi u1 u2) (ot-phi1 u1 u2 o) o (lt-phi-r (phi u1 u2) u1 u2 (ot-phi0 u1 u2 o) (ot-phi1 u1 u2 o) (refl (phi u1 u2), o)) lu))
         (phi u1 u2) o lu (refl (phi u1 u2), o) ;

st-om (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (u1 : T) (r1 : Star A t y p u1) : Star A t y p (om u1) =
  \ iu cu lu ->
    let { o : OK (om u1) = ca-ok (psi p y) A (om u1) cu ; }
    in w-om A t h u1
         (r1 (tr-bs (inC p y u1) (inC p y (om u1)) (rem215b-om p y u1 (ot-T (om u1) o)) iu)
             (wd-o (C (psi p y) A) (dc-wd (C (psi p y) A) (cs-dc A t h y p s)) (om u1) u1 (ot-om0 u1 o) cu (refl (om u1), o))
             (k-lt A t h u1 (om u1) (ot-om0 u1 o) o (lt-om-nf (om u1) u1 (ot-om0 u1 o) (refl (om u1), o)) lu))
         (om u1) o lu (refl (om u1), o) ;

------------------------------------------------------------------------
-- (*), u = psi_q u'

-- the end of each subcase: u' in C_p(y) n C^{psi_p y}(A), u' <' y, and q's condition:
-- u' in W(A) by induction, u' in tau^A(y) (in-Cb), the main IH at u' with q
st-end (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (q u' : T) (o : OK (psi q u')) (lu : LT (psi q u') (up t))
  (ru : Star A t y p u') (iu' : InC p y u') (cu' : C (psi p y) A u') (l' : LT u' y) (pcq : PC A t q) : WA[pl].WA A (psi q u') =
  let { lu' : LT u' (up t) = k-lt A t h u' y (ot-psi1 q u' o) (cs-oy A t y p s) l' (cs-ly A t y p s) ;
        wu' : WA[pl].WA A u' = ru iu' cu' lu' ; }
  in cs-ih A t y p s u' (in-Cb A t h y (cs-oy A t y p s) (cs-ly A t y p s) u' wu', l')
       lu' q (ot-psiR q u' o) pcq o lu ;

-- u' in C_q(u')  (OT4)
own-inC (q u' : T) (o : OK (psi q u')) : InC q u' u' =
  andI (isT u') (allLt (G q u') u') (ot-T u' (ot-psi1 q u' o)) (ot-psiG q u' o) ;

-- q = I = p:  C_q = C_p
inC-II (q p a u v : T) (tq : Tr (isI q)) (tp : Tr (isI p)) (i : InC q a v) : InC p a v =
  subst (\ x -> InC x a v) (trans (isI-true q tq) (sym (isI-true p tp))) i ;

-- subcase u <' a~, q = I, p = I:  a~ = a, u' <' y (clause (5)), u' in C_I(u') c C_I(y) (2.14(j))
st-loI (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (q u' : T) (o : OK (psi q u')) (lu : LT (psi q u') (up t))
  (ru : Star A t y p u') (cu' : C (psi p y) A u') (tq : Tr (isI q)) (tp : Tr (isI p)) (l : LT (psi q u') (tilde (psi p y)))
  : WA[pl].WA A (psi q u') =
  let { l' : LT u' y = tr-bs (lt u' y) (lt (psi q u') (psi p y)) (lt-TT q u' p y tq tp) (lt-r (psi q u') (tilde (psi p y)) (psi p y) (til-psiI p y tp) l) ; }
  in st-end A t h y p s q u' o lu ru
       (rem214j p u' y (ot-T u' (ot-psi1 q u' o)) (ot-T y (cs-oy A t y p s)) l' u'
          (inC-II q p u' u' u' tq tp (own-inC q u' o)))
       cu' l' (inl tq) ;

-- subcase u <' a~, p /= I:  a~ = p^- in W(A), w-below
st-loR (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (u : T) (cu : C (psi p y) A u)
  (n : Id Bool (isI p) false) (l : LT u (tilde (psi p y))) : WA[pl].WA A u =
  let { oa : OK (psi p y) = cs-oa A t y p s ;
        la : Tr (le (tilde (psi p y)) (psi p y)) = til-le (psi p y) oa ; }
  in w-below A (k-m A t h) (kminus p) (psi p y) u (pc-km A t p (cs-pc A t y p s) n).1 oa
       (le-l (tilde (psi p y)) (kminus p) (psi p y) (til-psiR p y n) la)
       (cu, lt-le u (tilde (psi p y)) (psi p y) (trOT u (tilde (psi p y)) (psi p y) (ca-ok (psi p y) A u cu) (til-OK (psi p y) oa) oa) l la)
       (le-of-lt u (kminus p) (lt-r u (tilde (psi p y)) (kminus p) (til-psiR p y n) l)) ;

-- subcase u <' a~:  q /= I is excluded (a~ <=' (a~)~ <' u, til-psi)
st-lo (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (q u' : T) (o : OK (psi q u')) (lu : LT (psi q u') (up t))
  (ru : Star A t y p u') (cu : C (psi p y) A (psi q u')) (cu' : C (psi p y) A u') (r : LT (tilde (psi p y)) q)
  (l : LT (psi q u') (tilde (psi p y))) : WA[pl].WA A (psi q u') =
  let { oa : OK (psi p y) = cs-oa A t y p s ; }
  in boolCases (WA[pl].WA A (psi q u')) (isI q)
       (\ tq -> boolCases (WA[pl].WA A (psi q u')) (isI p)
                  (\ tp -> st-loI A t h y p s q u' o lu ru cu' tq tp l)
                  (\ np -> st-loR A t h y p s (psi q u') cu np l))
       (\ nq -> asym-abs (WA[pl].WA A (psi q u')) (psi q u') (tilde (psi p y)) (ot-T (psi q u') o) (ot-T (tilde (psi p y)) (til-OK (psi p y) oa)) l
                  (le-lt (tilde (psi p y)) (tilde (tilde (psi p y))) (psi q u')
                     (trOT (tilde (psi p y)) (tilde (tilde (psi p y))) (psi q u') (til-OK (psi p y) oa) (til-OK (tilde (psi p y)) (til-OK (psi p y) oa)) o)
                     (til-self (psi p y) oa)
                     (til-psi (tilde (psi p y)) q u' (til-OK (psi p y) oa) o nq r))) ;

-- transports for u = a~
inC-eq (p y u v : T) (e : Id T u v) (i : InC p y u) : InC p y v = subst (\ x -> InC p y x) e i ;
eq-tr (u v w : T) (e : Id T u v) (f : Id T v w) : Id T u w = trans e f ;
eq-back (u v w : T) (e : Id T u v) (f : Id T v w) : Id T w u = sym (trans e f) ;

-- subcase u = a~:  p /= I (psi_I y is not in C_I(y)), u = p^- in W(A)
st-eq (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) (u : T) (iu : InC p y u) (e : Id T u (tilde (psi p y)))
  : WA[pl].WA A u =
  boolCases (WA[pl].WA A u) (isI p)
    (\ tp -> not-own (WA[pl].WA A u) p y tp (inC-eq p y u (psi p y) (eq-tr u (tilde (psi p y)) (psi p y) e (til-psiI p y tp)) iu))
    (\ np -> tr-B (WA[pl].WA A) (kminus p) u (eq-back u (tilde (psi p y)) (kminus p) e (til-psiR p y np)) (pc-km A t p (cs-pc A t y p s) np).1) ;

-- q's condition when q /= I:  q^- <' u <' t+ gives q^- <=' t~;  q <' t+: q in W(A) by
-- induction, q^- by downward closure (b);  t+ <=' q: t~ <' q gives t~ <=' q^-, so q^- = t~
pc-q (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (q u' : T) (o : OK (psi q u')) (lu : LT (psi q u') (up t))
  (rq : Star A t y p q) (iq : InC p y q) (cq : C (psi p y) A q) (nq : Id Bool (isI q) false)
  : WA[pl].WA A (kminus q) * Tr (le (kminus q) t) =
  let { ot : OK t = k-ok A t h ;
        oq : OK q = ot-psi0 q u' o ;
        r : Tr (isR q) = ot-psiR q u' o ;
        okq : OK (kminus q) = ok-km q r oq ;
        lk : Tr (le (kminus q) (tilde t))
           = km-below q t r nq oq ot (k-lt A t h (kminus q) (psi q u') okq o (lt-km-psi q u' o) lu) ;
        lt' : LT (tilde t) (up t) = le-lt (tilde t) t (up t) (trOT (tilde t) t (up t) (til-OK t ot) ot (k-up A t h)) (til-le t ot) (rem214f t ot).2.2.2.2.2 ;
        dc : DC (Cap (WA[pl].WA A) (up t)) = (rem417b A t h).1 ; }
  in (boolCases (WA[pl].WA A (kminus q)) (lt q (up t))
        (\ l -> (dc-R (Cap (WA[pl].WA A) (up t)) dc q r (rq iq cq l, l)).1)
        (\ f -> tr-B (WA[pl].WA A) (tilde t) (kminus q)
                  (le-antisym (tilde t) (kminus q) (ot-T (tilde t) (til-OK t ot)) (ot-T (kminus q) okq)
                     (le-trans (tilde t) (tilde (tilde t)) (kminus q)
                        (trOT (tilde t) (tilde (tilde t)) (kminus q) (til-OK t ot) (til-OK (tilde t) (til-OK t ot)) okq)
                        (til-self t ot)
                        (til-km (tilde t) q r nq oq (til-OK t ot)
                           (lt-le (tilde t) (up t) q (trOT (tilde t) (up t) q (til-OK t ot) (k-up A t h) oq) lt'
                              (nlt-le (up t) q (ot-T (up t) (k-up A t h)) (ot-T q oq) f))))
                     lk)
                  (dc-card (Cap (WA[pl].WA A) (up t)) dc t (wt, (rem214f t ot).2.2.2.2.2)).1.1),
      le-trans (kminus q) (tilde t) t (trOT (kminus q) (tilde t) t okq (til-OK t ot) ot) lk (til-le t ot)) ;

-- subcase a~ <' u:  q, u' in C_p(y), u' <' y (2.15(e) for p /= I, 2.15(d) for p = I)
st-x5 (A : Cl) (t y p : T) (s : CS A t y p) (q u' : T) (o : OK (psi q u')) (iu : InC p y (psi q u'))
  (l : LT (tilde (psi p y)) (psi q u')) : Tr (X5 p y q u') =
  boolCases (Tr (X5 p y q u')) (isI p)
    (\ tp -> orE (Tr (X5 p y q u')) (Y5 p y q u') (X5 p y q u')
               (tr-bs (or (Y5 p y q u') (X5 p y q u')) (inC p y (psi q u')) (rem215d p y q u' (cs-op A t y p s) (cs-rp A t y p s) (ot-T y (cs-oy A t y p s)) o) iu)
               (\ y5 -> asym-abs (Tr (X5 p y q u')) (psi q u') (psi p y) (ot-T (psi q u') o) (ot-T (psi p y) (cs-oa A t y p s))
                          y5 (lt-l (tilde (psi p y)) (psi p y) (psi q u') (til-psiI p y tp) l))
               (\ x -> x))
    (\ np -> orE (Tr (X5 p y q u')) (le (psi q u') (kminus p)) (X5 p y q u')
               (tr-bs (or (le (psi q u') (kminus p)) (X5 p y q u')) (inC p y (psi q u')) (rem215e-R p y q u' (cs-op A t y p s) (cs-rp A t y p s) np (ot-T y (cs-oy A t y p s)) o) iu)
               (\ l2 -> le-abs (Tr (X5 p y q u')) (psi q u') (kminus p) (ot-T (psi q u') o)
                          (ot-T (kminus p) (ok-km p (cs-rp A t y p s) (cs-op A t y p s)))
                          l2 (lt-l (tilde (psi p y)) (kminus p) (psi q u') (til-psiR p y np) l))
               (\ x -> x)) ;

st-hi (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (s : CS A t y p) (q u' : T) (o : OK (psi q u'))
  (lu : LT (psi q u') (up t)) (rq : Star A t y p q) (ru : Star A t y p u') (iu : InC p y (psi q u'))
  (cq : C (psi p y) A q) (cu' : C (psi p y) A u') (l : LT (tilde (psi p y)) (psi q u')) : WA[pl].WA A (psi q u') =
  let { x5 : Tr (X5 p y q u') = st-x5 A t y p s q u' o iu l ; }
  in st-end A t h y p s q u' o lu ru
       (and-r (inC p y q) (inC p y u') (and-l (and (inC p y q) (inC p y u')) (lt u' y) x5)) cu'
       (and-r (and (inC p y q) (inC p y u')) (lt u' y) x5)
       (boolCases (PC A t q) (isI q) (\ tq -> inl tq)
          (\ nq -> inr (pc-q A t h wt y p q u' o lu rq
                          (and-l (inC p y q) (inC p y u') (and-l (and (inC p y q) (inC p y u')) (lt u' y) x5)) cq nq))) ;

-- a~ <' q, q, u' in C^{a~}(A) = C^a(A): compare u with a~
st-cmp (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (s : CS A t y p) (q u' : T) (o : OK (psi q u'))
  (lu : LT (psi q u') (up t)) (rq : Star A t y p q) (ru : Star A t y p u') (iu : InC p y (psi q u'))
  (cu : C (psi p y) A (psi q u')) (r : PsiP (tilde (psi p y)) A q u') : WA[pl].WA A (psi q u') =
  let { oa : OK (psi p y) = cs-oa A t y p s ;
        cq : C (psi p y) A q = bw (C (psi p y) A q) (C (tilde (psi p y)) A q) (rem47a A (k-m A t h) (psi p y) oa q) r.2.1 ;
        cu' : C (psi p y) A u' = bw (C (psi p y) A u') (C (tilde (psi p y)) A u') (rem47a A (k-m A t h) (psi p y) oa u') r.2.2 ; }
  in tri (psi q u') (tilde (psi p y)) (ot-T (psi q u') o) (ot-T (tilde (psi p y)) (til-OK (psi p y) oa)) (WA[pl].WA A (psi q u'))
       (\ l -> st-lo A t h y p s q u' o lu ru cu cu' r.1 l)
       (\ e -> st-eq A t h y p s (psi q u') iu (eqT-sound (psi q u') (tilde (psi p y)) e))
       (\ l -> st-hi A t h wt y p s q u' o lu rq ru iu cq cu' l) ;

-- u in C^a(A) = C^{a~}(A) (4.7(a)); 4.4(d) at a~: u in A n a~, or a~ <' q and q, u' in C^{a~}(A)
st-psi (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (s : CS A t y p) (q u' : T)
  (rq : Star A t y p q) (ru : Star A t y p u') : Star A t y p (psi q u') =
  \ iu cu lu ->
    let { oa : OK (psi p y) = cs-oa A t y p s ;
          o : OK (psi q u') = ca-ok (psi p y) A (psi q u') cu ; }
    in either (Cap A (tilde (psi p y)) (psi q u')) (PsiP (tilde (psi p y)) A q u') (WA[pl].WA A (psi q u'))
         (\ g -> k-low A t h (psi q u') (tilde (psi p y)) (til-OK (psi p y) oa) g.1 g.2 (k-til A t h (psi p y) oa (cs-la A t y p s)))
         (\ r -> st-cmp A t h wt y p s q u' o lu rq ru iu cu r)
         (fw (C (tilde (psi p y)) A (psi q u')) (Or (Cap A (tilde (psi p y)) (psi q u')) (PsiP (tilde (psi p y)) A q u'))
            (ca-psi (tilde (psi p y)) A q u' o)
            (fw (C (psi p y) A (psi q u')) (C (tilde (psi p y)) A (psi q u')) (rem47a A (k-m A t h) (psi p y) oa (psi q u')) cu)) ;

-- (*), by induction on u
st (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (s : CS A t y p) : (u : T) -> Star A t y p u = split {
  zero -> \ iu cu lu -> rem417a A ;
  plus u0 us | r0 rs -> st-plus A t h y p s u0 us r0 rs ;
  phi u1 u2 | r1 r2 -> st-phi A t h y p s u1 u2 r1 r2 ;
  psi q u' | rq ru -> st-psi A t h wt y p s q u' rq ru ;
  om u1 | r1 -> st-om A t h y p s u1 r1 ;
  ii -> \ iu cu lu -> w-ii A t h lu } ;

------------------------------------------------------------------------
-- The claim, by Ind(y in W(A))

-- tau^A(psi_p y) c W(A):  d <' psi_p y <' p gives d in C_p(y) (2.15(c)), and (*)
cl-tau (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (s : CS A t y p) : Sub (tau A (psi p y)) (WA[pl].WA A) =
  \ d td ->
    let { od : OK d = ca-ok (psi p y) A d td.1 ; }
    in st A t h wt y p s d
         (tr-b (inC p y d) (lt d (psi p y))
            (rem215c p (cs-op A t y p s) (cs-rp A t y p s) d y (ot-T y (cs-oy A t y p s)) od
               (trOT d (psi p y) p od (cs-oa A t y p s) (cs-op A t y p s) td.2 (psi-lt p y (cs-oa A t y p s))))
            td.2)
         td.1 (k-lt A t h d (psi p y) od (cs-oa A t y p s) td.2 (cs-la A t y p s)) ;

-- p in C^{psi_p y}(A):  I by 4.4(b); otherwise p^- in W(A), so in C^a(A) (in-Cb), and p by R-in
cl-p (A : Cl) (t : T) (h : H17 A t) (y p : T) (s : CS A t y p) : C (psi p y) A p =
  boolCases (C (psi p y) A p) (isI p)
    (\ tp -> ca-el-r (psi p y) A ii p (isI-true p tp) (ca-I (psi p y) A))
    (\ np -> R-in (C (psi p y) A) OTc
               (h415-C A (k-m A t h) (psi p y) (cs-oa A t y p s)
                  (wd-x A (k-m A t h) t (k-ok A t h) (k-wt A t h) (psi p y) (cs-oa A t y p s) (cs-la A t y p s)))
               p (cs-rp A t y p s) np (cs-op A t y p s)
               (in-Cb A t h (psi p y) (cs-oa A t y p s) (cs-la A t y p s) (kminus p) (pc-km A t p (cs-pc A t y p s) np).1)
               (cs-op A t y p s)) ;

-- psi_p y in M(A) (4.4(d): psi_p y <' p, p, y in C^{psi_p y}(A)), and in A^A(W(A)) c W(A)
cl-at (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) (y p : T) (s : CS A t y p) : WA[pl].WA A (psi p y) =
  wa-a A (psi p y)
    ((cs-oa A t y p s,
      bw (C (psi p y) A (psi p y)) (Or (Cap A (psi p y) (psi p y)) (PsiP (psi p y) A p y)) (ca-psi (psi p y) A p y (cs-oa A t y p s))
        (inr (psi-lt p y (cs-oa A t y p s),
              (cl-p A t h y p s,
               in-Cb A t h (psi p y) (cs-oa A t y p s) (cs-la A t y p s) y (cs-wy A t y p s))))),
     cl-tau A t h wt y p s) ;

claim (A : Cl) (t : T) (h : H17 A t) (wt : WA[pl].WA A t) : Sub (WA[pl].WA A) (CP A t) =
  wa-ind A (CP A t)
    (\ y wy my ih ly p rp pc op lp -> cl-at A t h wt y p (wy, (ih, (ly, (rp, (pc, (op, lp))))))) ;

------------------------------------------------------------------------
-- Lemma 4.17 (c)

-- z+ = (z~)+  (2.14(e))
up-til (z : T) (oz : OK z) : Id T (up z) (up (tilde z)) = sym (rem214e z oz) ;

-- t = z~:  t in W(A) (W(A) n z+ downward closed, 4.16(a)), z+ = t+ (2.14(e)), and the claim at t
rem417c (A : Cl) (hA : Sub A (M A)) (k y z : T) (wk : WA[pl].WA A k) (wy : WA[pl].WA A y) (wz : WA[pl].WA A z)
  (lk : Tr (le k z)) (ly : Tr (le y z)) (e : Eqv (Cap (WA[pl].WA A) (tilde z)) (Cap A (tilde z)))
  (rk : Tr (isR k)) (iy : InC k y y) : WA[pl].WA A (psi k y) =
  let { oz : OK z = wa-OK A z wz ;
        ok : OK k = wa-OK A k wk ;
        oy : OK y = wa-OK A y wy ;
        ouz : OK (up z) = (rem214a z oz).2.1 ;
        h : H17 A (tilde z) = (hA, (til-OK z oz, eqv-sym (Cap (WA[pl].WA A) (tilde z)) (Cap A (tilde z)) e)) ;
        lz : LT z (up z) = (rem214f z oz).2.2.2.2.2 ;
        dcz : DC (Cap (WA[pl].WA A) (up z))
            = rem416a-W A hA z oz (rem416b A (k-ot A (tilde z) h) (tilde z) (til-OK z oz) (k-seg A (tilde z) h)) ;
        lkz : LT k (up z) = le-lt k z (up z) (trOT k z (up z) ok oz ouz) lk lz ;
        op : OK (psi k y) = ok-psi k y rk ok oy iy ; }
  in claim A (tilde z) h (dc-card (Cap (WA[pl].WA A) (up z)) dcz z (wz, lz)).1.1 y wy
       (lt-r y (up z) (up (tilde z)) (up-til z oz) (le-lt y z (up z) (trOT y z (up z) oy oz ouz) ly lz))
       k rk
       (boolCases (PC A (tilde z) k) (isI k) (\ t -> inl t)
          (\ n -> inr ((dc-R (Cap (WA[pl].WA A) (up z)) dcz k rk (wk, lkz)).1,
                       km-below k z rk n ok oz (trOT (kminus k) k (up z) (ok-km k rk ok) ok ouz (lt-km k rk ok) lkz))))
       op
       (lt-r (psi k y) (up z) (up (tilde z)) (up-til z oz) (trOT (psi k y) k (up z) op ok ouz (psi-lt k y op) lkz)) ;
