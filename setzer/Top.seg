-- Top.seg: Setzer (APAL 92, 1998), Section 4.7, well-ordering up to psi_{Omega_1} Omega_{I+n}:
-- Definition 4.39 - Theorem 4.41, pp. 151-152.  The mirror is tools/ottop.py (lem 6: 88 terms
-- with Omega_{I+1}, Omega_{I+2}, Omega_{I+3}, WW_0 .. WW_3; no failures).
--
-- Notation.  I + n is the term iN n:  I + 0 = I,  I + (m+1) = (I, 1, .., 1) with m+1 ones
--   (ones m = (1, .., 1), m+1 summands).  Omega_{I+n} = kN n = Omega_{iN n} (Def. 2.10(d));
--   Omega_I = I.  By computation (Def. 2.10(a)): (I+m) + 1 = I + (m+1)  (iN-suc, from
--   ones m + 1 = ones (m+1), ones-suc).  So Omega_{I+m+1} = Omega_{(I+m)+1} = (Omega_{I+m})+
--   (2.14: up-omF; kN-up), and Omega_{I+m} <' Omega_{I+m+1} (lt-k).  I + n in OT (iN-ok):
--   I, and x + 1 in OT for x in OT.
--
-- Definition 4.39.  WW_0 = WW n I,  WW_{m+1} = W(WW_m) n Omega_{I+m+1}.             WWi
--   Every WW_i is a class (WW is one); WW_i : N -> Cl by recursion on N.
--
-- Lemma 4.40 (Setzer: meta induction on i; here an induction on N in the theory).  The
-- invariant, for each i:
--   E(i):  WW_i = W(WW_i) n Omega_{I+i}                                           EI
--   F(i):  Omega_{I+i} in W(WW_i)                                                 FI
-- Then Ag(WW_i) (4.24's eq-ag: A = W(A) n a => Ag(A)), Omega_{I+i} in WW_{i+1}
-- (F(i), Omega_{I+i} <' Omega_{I+i+1}), and WW_i = WW_{i+1} n Omega_{I+i}: "c" by
-- WW_i c WW_{i+1} (below), "o" by E(i).                                        rem440
--
-- E(0).  WW n I = W(WW) n I (4.38(c)) and W(WW) n I = W(WW_0) n I: transfer at I
--   (wa-at both ways; WW n I = WW_0 n I).                                       E0
-- F(0).  I in M(WW_0) (I in OT, I in C^I(WW_0) by 4.4), and tau^{WW_0}(I) c W(WW_0):
--   y in C^I(WW_0) is in C^I(WW) (C^I monotone in the class, ca-mono), and
--   (tau-I)  y in C^I(WW), y <' I  =>  y in WW,
--   so y in WW n I = WW_0 c W(WW_0) (E(0)).  Then 4.10(a).                       F0
--   Setzer: "by an easy induction on length(x) ... x in WW n I".  No induction is
--   needed: y lies below some psi_I e in WW, and then y in tau^WW(psi_I e) = WW n psi_I e:
--   (below-ww)  a in WW, a <' I, y in C^I(WW), y <' a  =>  y in WW:
--     y in C^a(WW) (4.7(b): a <=' I), so y in tau^WW(a) = WW n a (4.20).
--   If y <' psi_I 0: a = psi_I 0, in WW by 4.31(b).  Otherwise (2.14(g)) y^{-Fi} = psi_I b
--   and y <' psi_I(b+1).  psi_I b in C^I(WW) (C^I(WW) is downward closed, 4.16(a) via
--   ag-ca: DCard), and by 4.4 psi_I b is in WW n I or I <' I; so psi_I b in WW (psiI-ww),
--   psi_I(b+1) in WW (4.31(b)), and a = psi_I(b+1).
-- E(j) => E(j+1).  A = WW_j, B = WW_{j+1}, k = Omega_{I+j}, k' = Omega_{I+j+1}.
--   A c B: y in A is in W(A) n k (E(j)) and k <' k'.                              sub-next
--   A c M(A) (Ag(A), from E(j)); B c M(B): B c W(A) c M(A) c M(B) (4.13(a), and
--   M monotone in the class, as C^x is: m-mono).                                sub-M
--   A n k = B n k: "c" by A c B; "o": y in W(A), y <' k gives y in A by E(j).    cap-k
--   4.13(b) at a = I + j (Omega_a = k, Omega_{a+1} = k'):
--   W(A) n k' = W(B) n k'.  The left side is B by definition: E(j+1).          w-next, E-next
--   (Setzer: "W_j = W_{j+1} n Omega_{I+j}. Therefore W_{j+1} = W(W_j) n Omega_{I+j+1}
--    = W(W_{j+1}) n Omega_{I+j+1}"; the same, with B c M(B) made explicit, as 4.13(b) needs.)
-- F(j) => F(j+1) (given E(j+1)).  B = WW_{j+1}, Ag(B) by E(j+1), k = Omega_{I+j} in B
--   (F(j), k <' k').  4.23(c) for B: k+ in W(B+) (ap-wup) and B+ n k+ = W(B) n k+ (ap-cap)
--   = B n k+ (E(j+1), k+ = k').  Transfer at k+ (wa-at): k+ = k' in W(B).        F-next
--   (Setzer: "Omega_{I+j+1} in C^{Omega_{I+j+1}}(WW), and if x in tau(Omega_{I+j+1}),
--    by induction on length(x) immediately x in WW_{j+1} n Omega_{I+j+1}"; the closure
--    argument is 4.23(c) for B, already proved: no induction here either.)
--
-- Theorem 4.41.  X a class (a set X : P(N) is the class Lf X), progressive:
--   for y in OT, (for x in OT, x <' y => x in X) => y in X.                    ProgOT
--   Then for every n, y in OT, y <' psi_{Omega_1} Omega_{I+n} => y in X.         thm441c, thm441
--   A = WW_{n+1}, Ag(A) (4.40).  X is progressive on Omega_1 (prog1-of), so A n Omega_1 c X
--   (4.21(c)).  Omega_1 in WW_0 (4.31(a) at 1 <' I; Omega_1 <' I) c WW_{n+1} (A c B above,
--   n+1 times: ww0-sub).  Omega_{I+n} in A (4.40).  Omega_1 in R, and Omega_{I+n} in
--   C_{Omega_1}(Omega_{I+n}): G_{Omega_1}(Omega_{I+n}) = {} (Def. 2.7: G(I) = G(1) = {},
--   G(Omega_x) = G(x), G of a sum = the union; G-kN).  So psi_{Omega_1} Omega_{I+n} in A
--   (4.23(b)), and it is <' Omega_1 (psi-lt).  A n Omega_1 [= OT (4.21(b)) gives y in A n
--   Omega_1, so y in X.
--   (Setzer states it in the theories T; here it is proved in the theory of these files.
--   Setzer's "for all n" is a meta quantifier; here n : N is internal, which needs WW_i by
--   recursion on N into classes, i.e. a universe above the classes (ML1W has only U; for a
--   fixed n the proof unfolds to n steps of E, F and needs no such universe).)

level tu ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
import OTF ;
import CA ;
import WA ;
import Clos ;
import Lem417 ;
import Ag ;
import WW ;
import GammaI ;
open OT ;
open OTLaws[tu+] ;
open OTTrans[tu+] ;
open OTC[tu+] ;
open OTF[tu+] ;
open CA[tu+] ;
open WA[tu+] ;
open Clos[tu+] ;
open Lem417[tu+] ;
open Ag[tu+] ;
open WW[tu] ;
open GammaI[tu] ;
module SC = CA[tu] ;

------------------------------------------------------------------------
-- I + n and Omega_{I+n}

plusOne (x : T) : T = plus one x ;
plusI (x : T) : T = plus ii x ;

ones : N -> T = split { nz -> one ; ns m | r -> plusOne r } ;
iN : N -> T = split { nz -> ii ; ns m -> plusI (ones m) } ;
kN (n : N) : T = omF (iN n) ;

-- by computation (Def. 2.10(a))
ones-suc : (m : N) -> Id T (add (ones m) one) (ones (ns m)) = split {
  nz -> refl (plus one one) ;
  ns m | r -> ap plusOne r } ;
iN-suc : (m : N) -> Id T (suc (iN m)) (iN (ns m)) = split {
  nz -> refl (plus ii one) ;
  ns m -> ap plusI (ones-suc m) } ;

iN-ok : (m : N) -> OK (iN m) = split {
  nz -> ok-ii ;
  ns m | r -> tr-B OTc (suc (iN m)) (iN (ns m)) (iN-suc m) (suc-OK (iN m) r) } ;
kN-ok (n : N) : OK (kN n) = omF-OK (iN n) (iN-ok n) ;

-- Omega_{I+m+1} = (Omega_{I+m})+
kN-up (m : N) : Id T (up (kN m)) (kN (ns m)) = trans (up-omF (iN m)) (ap omF (iN-suc m)) ;
lt-k (m : N) : LT (kN m) (kN (ns m)) =
  tr-B (\ u -> LT (kN m) u) (up (kN m)) (kN (ns m)) (kN-up m) (Ag[tu+].lt-up (kN m) (kN-ok m)) ;

------------------------------------------------------------------------
-- Definition 4.39

WWi : N -> Cl = split {
  nz -> Cap WW[tu].WW ii ;
  ns m | r -> Cap (WA[tu+].WA r) (kN (ns m)) } ;

-- the invariant of Lemma 4.40
EI (n : N) : U (tu+) = Eqv (WWi n) (Cap (WA[tu+].WA (WWi n)) (kN n)) ;
FI (n : N) : U (tu+) = WA[tu+].WA (WWi n) (kN n) ;

-- WW_i c OT, Ag(WW_i), from E(i)
ag-i (n : N) (e : EI n) : Ag[tu+].Ag (WWi n) = eq-ag (WWi n) (kN n) (kN-ok n) e ;

------------------------------------------------------------------------
-- E(0), F(0)

-- tau^WW(I) c WW
below-ww (a : T) (wa : WW[tu].WW a) (la : LT a ii) (y : T) (c : C ii WW[tu].WW y) (l : LT y a) : WW[tu].WW y =
  (fw (tau WW[tu].WW a y) (Cap WW[tu].WW a y) (rem420 WW[tu].WW ag-ww a wa y)
     (rem47b WW[tu].WW (ag-M WW[tu].WW ag-ww) a ii (ww-ot a wa) ok-ii (le-of-lt a ii la) y c, l)).1 ;

-- psi_I b in C^I(WW)  =>  psi_I b in WW  (4.4: I <' I is false)
psiI-ww (b : T) (cb : C ii WW[tu].WW (psi ii b)) : WW[tu].WW (psi ii b) =
  either (Cap WW[tu].WW ii (psi ii b)) (PsiP ii WW[tu].WW ii b) (WW[tu].WW (psi ii b))
    (\ q -> q.1)
    (\ p -> absurdB (WW[tu].WW (psi ii b)) p.1)
    (fw (C ii WW[tu].WW (psi ii b)) (Or (Cap WW[tu].WW ii (psi ii b)) (PsiP ii WW[tu].WW ii b))
       (ca-psi ii WW[tu].WW ii b (ca-ok ii WW[tu].WW (psi ii b) cb)) cb) ;

-- y in C^I(WW)  =>  y^{-Fi} in C^I(WW)  (DCard)
mfi-c (y : T) (c : C ii WW[tu].WW y) : C ii WW[tu].WW (mFi y) =
  (dc-card (C ii WW[tu].WW) (ag-ca WW[tu].WW ag-ww ii ok-ii).1 y c).2.1 ;

-- the parts of 2.14(g): y^{-Fi} = psi_I b, y^{+Fi} = psi_I(b+1), y <' y^{+Fi}
g2-b (y : T) (g : G2 y (mFi y) (pFi y)) : T = g.1 ;
g2-m (y : T) (g : G2 y (mFi y) (pFi y)) : Id T (mFi y) (psi ii (g2-b y g)) = g.2.2.2.1 ;
g2-p (y : T) (g : G2 y (mFi y) (pFi y)) : Id T (pFi y) (psi ii (suc (g2-b y g))) = g.2.2.2.2.1 ;
g2-lt (y : T) (g : G2 y (mFi y) (pFi y)) : LT y (pFi y) = g.2.2.2.2.2.2 ;

-- psi_I 0 <=' y <' I
tau-I-hi (y : T) (c : C ii WW[tu].WW y) (g : G2 y (mFi y) (pFi y)) : WW[tu].WW y =
  below-ww (psi ii (suc (g2-b y g)))
    (rem431b (g2-b y g)
       (psiI-ww (g2-b y g) (tr-B (C ii WW[tu].WW) (mFi y) (psi ii (g2-b y g)) (g2-m y g) (mfi-c y c))))
    (lt-TI ii (suc (g2-b y g)) (refl true)) y c
    (tr-B (\ u -> LT y u) (pFi y) (psi ii (suc (g2-b y g))) (g2-p y g) (g2-lt y g)) ;

tau-I (y : T) (t : tau WW[tu].WW ii y) : WW[tu].WW y =
  boolCases (WW[tu].WW y) (lt y (psi ii zero))
    (\ s -> below-ww (psi ii zero) rem431b0 (lt-TI ii zero (refl true)) y t.1 s)
    (\ f -> tau-I-hi y t.1
              (rem214g2 y (ca-ok ii WW[tu].WW y t.1)
                 (nlt-le (psi ii zero) y tt-psiI0 (ot-T y (ca-ok ii WW[tu].WW y t.1)) f) t.2)) ;

-- WW n I = WW_0 n I, WW_0 c OT
cap-ii : Eqv (Cap WW[tu].WW ii) (Cap (WWi nz) ii) = \ y -> (\ q -> (q, q.2), \ q -> q.1) ;
ot0 : Sub (WWi nz) OTc = \ y q -> ww-ot y q.1 ;

e0-to (y : T) (q : WWi nz y) : Cap (WA[tu+].WA (WWi nz)) ii y =
  (wa-at WW[tu].WW (WWi nz) ww-ot ot0 ii ok-ii cap-ii y
     (fw (Cap WW[tu].WW ii y) (Cap (WA[tu+].WA WW[tu].WW) ii y) (rem438c y) q).1 (le-of-lt y ii q.2),
   q.2) ;
e0-from (y : T) (q : Cap (WA[tu+].WA (WWi nz)) ii y) : WWi nz y =
  bw (Cap WW[tu].WW ii y) (Cap (WA[tu+].WA WW[tu].WW) ii y) (rem438c y)
    (wa-at (WWi nz) WW[tu].WW ot0 ww-ot ii ok-ii (eqv-sym (Cap WW[tu].WW ii) (Cap (WWi nz) ii) cap-ii) y q.1
       (le-of-lt y ii q.2),
     q.2) ;

E0 : EI nz = \ y -> (e0-to y, e0-from y) ;

F0 : FI nz =
  wa-a (WWi nz) ii
    ((ok-ii, ca-I ii (WWi nz)),
     \ y t -> (e0-to y (tau-I y (ca-mono ii (WWi nz) WW[tu].WW (\ u q -> (q.1.1, q.2)) y t.1, t.2), t.2)).1) ;

------------------------------------------------------------------------
-- E(j) => E(j+1), F(j) => F(j+1)

sub-next (j : N) (e : EI j) : Sub (WWi j) (WWi (ns j)) =
  \ y q -> ((fw (WWi j y) (Cap (WA[tu+].WA (WWi j)) (kN j) y) (e y) q).1,
            trOT y (kN j) (kN (ns j))
              (wa-OK (WWi j) y (fw (WWi j y) (Cap (WA[tu+].WA (WWi j)) (kN j) y) (e y) q).1) (kN-ok j) (kN-ok (ns j))
              (fw (WWi j y) (Cap (WA[tu+].WA (WWi j)) (kN j) y) (e y) q).2 (lt-k j)) ;

sub-M (j : N) (e : EI j) : Sub (WWi (ns j)) (M (WWi (ns j))) =
  \ y q -> m-mono (WWi j) (WWi (ns j)) (sub-next j e) y (wa-M (WWi j) y q.1) ;

cap-k (j : N) (e : EI j) : Eqv (Cap (WWi j) (omF (iN j))) (Cap (WWi (ns j)) (omF (iN j))) =
  \ y -> (\ q -> (sub-next j e y q.1, q.2),
          \ q -> (bw (WWi j y) (Cap (WA[tu+].WA (WWi j)) (kN j) y) (e y) (q.1.1, q.2), q.2)) ;

-- W(A) n k' = W(B) n k'  (4.13(b))
w-next (j : N) (e : EI j) : Eqv (Cap (WA[tu+].WA (WWi j)) (kN (ns j))) (Cap (WA[tu+].WA (WWi (ns j))) (kN (ns j))) =
  cap-tr (WA[tu+].WA (WWi j)) (WA[tu+].WA (WWi (ns j))) (omF (suc (iN j))) (kN (ns j)) (ap omF (iN-suc j))
    (rem413b (WWi j) (WWi (ns j)) (iN j) (iN-ok j) (cap-k j e) (ag-M (WWi j) (ag-i j e)) (sub-M j e)).2 ;

-- WW_{j+1} = W(WW_j) n k' by definition
E-next (j : N) (e : EI j) : EI (ns j) = w-next j e ;

-- A = W(A) n a  =>  W(A) n a = A n a
cap-w (A : Cl) (a : T) (e : Eqv A (Cap (WA[tu+].WA A) a)) : Eqv (Cap (WA[tu+].WA A) a) (Cap A a) =
  \ y -> (\ q -> (bw (A y) (Cap (WA[tu+].WA A) a y) (e y) q, q.2), \ q -> fw (A y) (Cap (WA[tu+].WA A) a y) (e y) q.1) ;

-- B+ n k+ = B n k+
ap-k (j : N) (e1 : EI (ns j)) (kb : WWi (ns j) (kN j))
  : Eqv (Cap (Aplus (WWi (ns j))) (up (kN j))) (Cap (WWi (ns j)) (up (kN j))) =
  eqv-trans (Cap (Aplus (WWi (ns j))) (up (kN j))) (Cap (WA[tu+].WA (WWi (ns j))) (up (kN j))) (Cap (WWi (ns j)) (up (kN j)))
    (ap-cap (WWi (ns j)) (ag-i (ns j) e1) (kN j) kb)
    (cap-trs (WA[tu+].WA (WWi (ns j))) (WWi (ns j)) (kN (ns j)) (up (kN j)) (kN-up j)
       (cap-w (WWi (ns j)) (kN (ns j)) e1)) ;

F-next (j : N) (e1 : EI (ns j)) (f : FI j) : FI (ns j) =
  tr-B (WA[tu+].WA (WWi (ns j))) (up (kN j)) (kN (ns j)) (kN-up j)
    (wa-at (Aplus (WWi (ns j))) (WWi (ns j))
       (ap-ok (WWi (ns j)) (ag-i (ns j) e1)) (ag-ot (WWi (ns j)) (ag-i (ns j) e1))
       (up (kN j)) (up-OK (kN j) (kN-ok j)) (ap-k j e1 (f, lt-k j))
       (up (kN j)) (ap-wup (WWi (ns j)) (ag-i (ns j) e1) (kN j) (f, lt-k j)) (le-refl (up (kN j)))) ;

------------------------------------------------------------------------
-- Lemma 4.40

Inv (n : N) : U (tu+) = EI n * FI n ;
inv : (n : N) -> Inv n = split {
  nz -> (E0, F0) ;
  ns j | r -> (E-next j r.1, F-next j (E-next j r.1) r.2) } ;
inv-e (n : N) : EI n = (inv n).1 ;
inv-f (n : N) : FI n = (inv n).2 ;

-- WW_i = WW_{i+1} n Omega_{I+i}
ww-cap (i : N) : Eqv (WWi i) (Cap (WWi (ns i)) (kN i)) =
  \ y -> (\ q -> (sub-next i (inv-e i) y q, (fw (WWi i y) (Cap (WA[tu+].WA (WWi i)) (kN i) y) (inv-e i y) q).2),
          \ q -> bw (WWi i y) (Cap (WA[tu+].WA (WWi i)) (kN i) y) (inv-e i y) (q.1.1, q.2)) ;

rem440 (i : N) : Ag[tu+].Ag (WWi i) * (WWi (ns i) (kN i) * Eqv (WWi i) (Cap (WWi (ns i)) (kN i))) =
  (ag-i i (inv-e i), ((inv-f i, lt-k i), ww-cap i)) ;

------------------------------------------------------------------------
-- Theorem 4.41

-- WW_0 c WW_n
ww0-sub : (n : N) -> Sub (WWi nz) (WWi n) = split {
  nz -> \ y q -> q ;
  ns m | r -> \ y q -> sub-next m (inv-e m) y (r y q) } ;

-- Omega_1 in WW_0
om1-ww0 : WWi nz (om one) = (rem431a one ww-one (refl true), refl true) ;

-- G_{Omega_1}(Omega_{I+n}) = {}  (by computation)
G-ones : (m : N) -> Id L (G (om one) (ones m)) nil = split {
  nz -> refl nil ;
  ns m | r -> r } ;
G-kN : (n : N) -> Id L (G (om one) (kN n)) nil = split {
  nz -> refl nil ;
  ns m -> G-ones m } ;
allLtAt (y : T) (g : L) : Bool = allLt g y ;
inc-kN (n : N) : InC (om one) (kN n) (kN n) =
  trans (inC-T (om one) (kN n) (kN n) (ot-T (kN n) (kN-ok n))) (ap (allLtAt (kN n)) (G-kN n)) ;

-- psi_{Omega_1} Omega_{I+n} in WW_{n+1}
psi-ww (n : N) : WWi (ns n) (psi (om one) (kN n)) =
  rem423b (WWi (ns n)) (ag-i (ns n) (inv-e (ns n))) (om one) (kN n)
    (ww0-sub (ns n) (om one) om1-ww0) (inv-f n, lt-k n) (refl true) (inc-kN n) ;

-- progressive (Setzer's premise), and progressive on Omega_1
ProgOT (B : Cl) : U (tu+) = (y : T) -> OK y -> ((x : T) -> OK x -> LT x y -> B x) -> B y ;
prog1-of (B : Cl) (p : ProgOT B) : Prog1 B =
  \ x q h -> p x q.1 (\ z oz l -> h z ((oz, trOT z x (om one) oz q.1 om1-OK l q.2), l)) ;

thm441c (n : N) (B : Cl) (p : ProgOT B) (y : T) (oy : OK y) (l : LT y (psi (om one) (kN n))) : B y =
  rem421c (WWi (ns n)) B (ag-i (ns n) (inv-e (ns n))) (prog1-of B p) y
    (seg-dn (Cap (WWi (ns n)) (om one)) OTc (rem421b (WWi (ns n)) (ag-i (ns n) (inv-e (ns n))))
       (psi (om one) (kN n)) y
       (psi-ww n, psi-lt (om one) (kN n) (ag-ot (WWi (ns n)) (ag-i (ns n) (inv-e (ns n))) (psi (om one) (kN n)) (psi-ww n)))
       oy
       (lt-sx y (psi (om one) (kN n)) oy (ag-ot (WWi (ns n)) (ag-i (ns n) (inv-e (ns n))) (psi (om one) (kN n)) (psi-ww n)) l)) ;

-- for a set X : P(N)
thm441 (n : N) (X : SC.Cl) (p : ProgOT (Lf X)) (y : T) (oy : OK y) (l : LT y (psi (om one) (kN n))) : Lf X y =
  thm441c n (Lf X) p y oy l ;
