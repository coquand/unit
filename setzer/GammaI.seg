-- GammaI.seg: Setzer (APAL 92, 1998), Section 4.6, a distinguished class containing I:
-- Definition 4.32 - Lemma 4.38, pp. 149-151.  The mirror is tools/otgam.py (lem 7: 227
-- terms, 5706 instances of the hypothesis of 4.37 for a distinguished D, 31 for WW;
-- xlem 6 adds psi_k y with k = Omega_{I+1}, Omega_{I+2}; no failures).
--
-- Goal (Lemma 4.38): W(WW) n I = WW n I.  By 4.31(b) it reduces to (**) psi_I c in
-- A^WW(WW) => psi_I c in WW, and by 4.30 to (***): tau^WW(psi_I c) is below a SET B c WW.
-- Throughout, a = psi_I c, and Hq c (Setzer's q): a in OT and tau^WW(a) c WW.
--
-- Definition 4.33.  C_I^WW(c) = C_I(c) n C^a(WW)  (a class).                     CW
--   C_I(c) is the decidable C~_I(c) of Def. 2.8 (InC ii c).
--
-- Definitions 4.32, 4.35 (changed).  For a SET X c C_I^WW(c) (p : X c C_I^WW(c)),
--   Gamma'(X) = {d in OT n C_I(c) | Str(X, d) or Pcw(X, d)}                       Gam
--   Str(X, d): d = 0, I; d = (x0, xs) (head split) with x0, xs in X; phi_x0 x1 with
--     x0, x1 in X; Omega_x0 with x0 in X; psi_k y with a <' k and k, y in X.     Str
--   Pcw(X, d): d in WW n k for some k in X with k <' a.                           Pcw
--   Pcw is a set: k in C_I^WW(c), k <' a, so k in tau^WW(a) c WW (Hq); WW n k is
--   g n k for the set g of k in WW (4.26(a)): ww-in, ww-out.
--   Setzer's Gamma_c has, instead of Str for psi_I b and instead of Pcw, the clauses
--   (D4) WW n psi_I 0 and (D5) WW n psi_I(b+1) for b in X n C_I(b) n c.  His proof
--   of 4.37 "o" (by induction on length) needs b in X for psi_I b = x^{-Fi}, a deep
--   subterm of x.  With the clauses above, every step of that proof uses only immediate
--   subterms, and the induction is structural (no length induction).
-- Lemma 4.34(b) (soundness).  X c C_I^WW(c) => Gamma'(X) c C_I^WW(c).  gam-sound
--   Str: 4.4(c), (d) (a <' k for psi_k y).  Pcw: d <' k <' a and d in WW, so d in
--   C^a(WW) by 4.7(h).  (4.34(a), monotonicity, is not needed: the stages are cumulative.)
-- Definition 4.36.  Gamma^0 = {}, Gamma^{n+1} = Gamma^n u Gamma'(Gamma^n), defined with
--   the proof Gamma^n c C_I^WW(c) (it, by recursion on n: stages are pairs).  Gamma^w =
--   U_n Gamma^n, a set (Gw).  Gamma^n c Gamma^{k+n} (stage-up); two elements of stages
--   are in one stage (two, by k+n = n+k).
-- Lemma 4.37.  C_I^WW(c) = Gamma^w.  "o" is soundness.  "c" (rem437):  x in OT n C_I(c)
--   n C^a(WW) => x in Gamma^w, by induction on x.  Then x is in Gamma^{m+1} by Str or Pcw,
--   once its parts are in Gamma^m:
--   0, I: Str.
--   (x0, xs), phi_x0 x1, Omega_x0: the parts are in C^a(WW) (C^a(WW) is downward closed,
--     4.16(a) via ag-ca: DSum at the head split nfs-head, WDp, WDo), and in C_I(c)
--     (2.15(b)); induction; Str.
--   psi_k y, by 4.4(d), in two ways:
--   - a <' k and k, y in C^a(WW).  k <' I is impossible (k in C_I(c), so k <' a, 2.15(c));
--     so I <=' k, and k, y in C_I(c); induction; Str.
--   - x in WW n a (the leaf).  If k = I: y in C^{psi_I y}(WW) (psi_I y in WW c M(WW),
--     x-in) and y in C_I(y), so y in C^a(WW) by 4.7(e) (psi_I y <=' psi_I y, a <' I):
--     leaf-I; with a <' I this is the first way.  If I <' k: psi_k y <' I is false (clause
--     (6): psi_k y <' I iff k <=' I): psi-hi-abs.  If k <' I: k = x+ (Def. 2.13(b)),
--     in WW (4.29(c')); k in C_I(c) (2.15), so k <' a (2.15(c)) and k in C^a(WW) (4.7(h));
--     induction gives k in Gamma^m; x <' k (psi-lt), x in WW: Pcw.
-- Lemma 4.38.  (a) psi_I c in A^WW(WW) => psi_I c in WW.                        rem438a
--   B = Gamma^w n a (Bs).  B c WW|a: d in B is in C^a(WW) n a = tau^WW(a) c WW.
--   tau^WW(a) <=' B: y in tau^WW(a) is in C_I(c) (y <' a <' I, 2.15(c)), so in Gamma^w
--   (4.37), and y <' a.  a <' I.  Then 4.30.
--   (b) x in A^WW(WW), x <' I => x in WW.                                       rem438b
--   x in W(WW) (4.10(a): tau^WW(x) c WW c W(WW)).  If x <' psi_I 0: psi_I 0 in WW
--   (4.31(b)) and x <' psi_I 0, so x in WW (WW [= W(WW)).  Otherwise x^{-Fi} = psi_I y,
--   x <' psi_I(y+1), psi_I y <=' x (2.14(g)).  psi_I y in WW: if psi_I y <' x, it is in
--   C^x(WW) (C^x(WW) downward closed, DCard, x in M(WW)), so in tau^WW(x) c WW; if
--   psi_I y = x, by (a).  psi_I(y+1) in WW (4.31(b)), and x in WW as before.
--   (Setzer: "x^{-Fi} in C^x(WW) n x c WW or x^{-Fi} = x in A^WW(WW)".)
--   (c) WW n I = W(WW) n I.                                                      rem438c
--   "c": WW [= W(WW).  "o": by Ind(y in W(WW)) (4.11) of y <' I => y in WW: tau^WW(x)
--   c WW (its elements are <' x <' I), so x in A^WW(WW), and (b).

level gu ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
import OTF ;
import CA ;
import WA ;
import Clos ;
import Lem417 ;
import Ag ;
import WW ;
open OT ;
open OTLaws[gu+] ;
open OTTrans[gu+] ;
open OTC[gu+] ;
open OTF[gu+] ;
open CA[gu+] ;
open WA[gu+] ;
open Clos[gu+] ;
open Lem417[gu+] ;
open Ag[gu+] ;
open WW[gu] ;
module SC = CA[gu] ;

------------------------------------------------------------------------
-- The hypotheses, Definition 4.33

-- a in OT, tau^WW(a) c WW  (a = psi_I c)
Hq (c : T) : U (gu+) = OK (psi ii c) * Sub (tau WW[gu].WW (psi ii c)) WW[gu].WW ;
hq-o (c : T) (h : Hq c) : OK (psi ii c) = h.1 ;
hq-t (c : T) (h : Hq c) : Sub (tau WW[gu].WW (psi ii c)) WW[gu].WW = h.2 ;
hq-c (c : T) (h : Hq c) : TT c = ot-T c (ot-psi1 ii c (hq-o c h)) ;

-- C_I^WW(c)
CW (c d : T) : U (gu+) = InC ii c d * C (psi ii c) WW[gu].WW d ;
cw-inc (c d : T) (w : CW c d) : InC ii c d = w.1 ;
cw-c (c d : T) (w : CW c d) : C (psi ii c) WW[gu].WW d = w.2 ;

-- C_I(c) at the two levels (equal by definition)
inc-up (c d : T) (i : OTC[gu].InC ii c d) : InC ii c d = i ;
inc-dn (c d : T) (i : InC ii c d) : OTC[gu].InC ii c d = i ;

-- k in C_I^WW(c), k <' a  =>  k in WW
cw-ww (c : T) (h : Hq c) (k : T) (w : CW c k) (l : LT k (psi ii c)) : WW[gu].WW k = hq-t c h k (cw-c c k w, l) ;

-- WW n k is g n k, g the set of k in WW (4.26(a))
ww-in (k : T) (wk : WW[gu].WW k) (x : T) (wx : WW[gu].WW x) (l : LT x k) : SC.Cap (ww-set k wk) k x =
  ((bw (Bar (Lf (ww-set k wk)) k x) (Bar WW[gu].WW k x)
       ((ww-seg (ww-set k wk) (ww-gag k wk)).2 k (ww-mem k wk) x)
       (wx, lt-sx x k (ww-ot x wx) (ww-ot k wk) l)).1,
   lt-dn x k l) ;
ww-out (k : T) (wk : WW[gu].WW k) (x : T) (q : SC.Cap (ww-set k wk) k x) : Cap WW[gu].WW k x =
  (ww-mk (ww-set k wk) (ww-gag k wk) x q.1, WW[gu].lt-up x k q.2) ;

------------------------------------------------------------------------
-- Definitions 4.32, 4.35: Gamma'(X) for a set X c C_I^WW(c)

Str (X : SC.Cl) (c : T) : T -> U gu = split {
  zero -> One ;
  plus x0 xs -> X x0 * X xs ;
  phi x0 x1 -> X x0 * X x1 ;
  psi k y -> OTTrans[gu].LT (psi ii c) k * (X k * X y) ;
  om x0 -> X x0 ;
  ii -> One } ;

Pcw (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) : U gu =
  (k : T) * ((xk : X k) * ((lk : OTTrans[gu].LT k (psi ii c))
     * SC.Cap (ww-set k (cw-ww c h k (p k xk) (WW[gu].lt-up k (psi ii c) lk))) k d)) ;

Gam (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) : U gu =
  OTC[gu].OK d * (OTC[gu].InC ii c d * SC.Or (Str X c d) (Pcw c h X p d)) ;

------------------------------------------------------------------------
-- Lemma 4.34(b)

str-sound (c : T) (X : SC.Cl) (p : Sub (Lf X) (CW c)) : (d : T) -> OK d -> Str X c d -> C (psi ii c) WW[gu].WW d = split {
  zero -> \ o s -> ca-zero (psi ii c) WW[gu].WW ;
  plus x0 xs -> \ o s ->
    bw (C (psi ii c) WW[gu].WW (plus x0 xs)) (Or (Cap WW[gu].WW (psi ii c) (plus x0 xs)) (C (psi ii c) WW[gu].WW x0 * C (psi ii c) WW[gu].WW xs))
      (ca-plus (psi ii c) WW[gu].WW x0 xs o) (inr (cw-c c x0 (p x0 s.1), cw-c c xs (p xs s.2))) ;
  phi x0 x1 -> \ o s ->
    bw (C (psi ii c) WW[gu].WW (phi x0 x1)) (Or (Cap WW[gu].WW (psi ii c) (phi x0 x1)) (C (psi ii c) WW[gu].WW x0 * C (psi ii c) WW[gu].WW x1))
      (ca-phi (psi ii c) WW[gu].WW x0 x1 o) (inr (cw-c c x0 (p x0 s.1), cw-c c x1 (p x1 s.2))) ;
  psi k y -> \ o s ->
    bw (C (psi ii c) WW[gu].WW (psi k y)) (Or (Cap WW[gu].WW (psi ii c) (psi k y)) (PsiP (psi ii c) WW[gu].WW k y))
      (ca-psi (psi ii c) WW[gu].WW k y o)
      (inr (WW[gu].lt-up (psi ii c) k s.1, (cw-c c k (p k s.2.1), cw-c c y (p y s.2.2)))) ;
  om x0 -> \ o s ->
    bw (C (psi ii c) WW[gu].WW (om x0)) (Or (Cap WW[gu].WW (psi ii c) (om x0)) (C (psi ii c) WW[gu].WW x0))
      (ca-om (psi ii c) WW[gu].WW x0 o) (inr (cw-c c x0 (p x0 s))) ;
  ii -> \ o s -> ca-I (psi ii c) WW[gu].WW } ;

-- the parts of d in Pcw(X): k, k in X, k <' a, k in WW, d in WW n k
pc-k (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) (q : Pcw c h X p d) : T = q.1 ;
pc-lt (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) (q : Pcw c h X p d)
  : LT (pc-k c h X p d q) (psi ii c) = WW[gu].lt-up q.1 (psi ii c) q.2.2.1 ;
pc-ww (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) (q : Pcw c h X p d) : WW[gu].WW (pc-k c h X p d q) =
  cw-ww c h q.1 (p q.1 q.2.1) (WW[gu].lt-up q.1 (psi ii c) q.2.2.1) ;
pc-in (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) (q : Pcw c h X p d) : Cap WW[gu].WW (pc-k c h X p d q) d =
  ww-out q.1 (pc-ww c h X p d q) d q.2.2.2 ;

pc-sound (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) (d : T) (o : OK d) (q : Pcw c h X p d)
  : C (psi ii c) WW[gu].WW d =
  rem47h (psi ii c) WW[gu].WW d o
    ((pc-in c h X p d q).1,
     lt-trans d (pc-k c h X p d q) (psi ii c) (ot-T d o) (ot-T (pc-k c h X p d q) (ww-ot (pc-k c h X p d q) (pc-ww c h X p d q)))
       (ot-T (psi ii c) (hq-o c h)) (pc-in c h X p d q).2 (pc-lt c h X p d q)) ;

gam-sound (c : T) (h : Hq c) (X : SC.Cl) (p : Sub (Lf X) (CW c)) : Sub (Lf (Gam c h X p)) (CW c) =
  \ d g -> (inc-up c d g.2.1,
            either (Str X c d) (Pcw c h X p d) (C (psi ii c) WW[gu].WW d)
              (str-sound c X p d (ok-up d g.1)) (pc-sound c h X p d (ok-up d g.1))
              (or-up (Str X c d) (Pcw c h X p d) (Str X c d) (Pcw c h X p d) (\ s -> s) (\ s -> s) g.2.2)) ;

------------------------------------------------------------------------
-- Definition 4.36: the stages

-- a set with its proof of X c C_I^WW(c)
GS (c : T) : U (gu+) = (X : SC.Cl) * Sub (Lf X) (CW c) ;
gs-set (c : T) (s : GS c) (d : T) : U gu = s.1 d ;
gs-sub (c : T) (s : GS c) : Sub (Lf (gs-set c s)) (CW c) = s.2 ;

-- X u Gamma'(X)
Gn (c : T) (h : Hq c) (s : GS c) (d : T) : U gu =
  SC.Or (gs-set c s d) (Gam c h (gs-set c s) (gs-sub c s) d) ;
gn-sound (c : T) (h : Hq c) (s : GS c) : Sub (Lf (Gn c h s)) (CW c) =
  \ d g -> either (gs-set c s d) (Gam c h (gs-set c s) (gs-sub c s) d) (CW c d)
             (gs-sub c s d) (gam-sound c h (gs-set c s) (gs-sub c s) d)
             (or-up (gs-set c s d) (Gam c h (gs-set c s) (gs-sub c s) d)
                    (gs-set c s d) (Gam c h (gs-set c s) (gs-sub c s) d) (\ u -> u) (\ u -> u) g) ;

emp-sub (c : T) : Sub (Lf Emp) (CW c) = \ y e -> below-zero (CW c y) y (WW[gu].lt-up y zero e) ;

it (c : T) (h : Hq c) : N -> GS c = split {
  nz -> (Emp, emp-sub c) ;
  ns m | r -> (Gn c h r, gn-sound c h r) } ;

-- Gamma^n, its proof, and the two clauses of Gamma^{n+1} (by definition of it)
Stage (c : T) (h : Hq c) (n : N) (d : T) : U gu = gs-set c (it c h n) d ;
stage-sub (c : T) (h : Hq c) (n : N) (d : T) (g : Stage c h n d) : CW c d = gs-sub c (it c h n) d g ;
stage-l (c : T) (h : Hq c) (m : N) (d : T) (g : Stage c h m d) : Stage c h (ns m) d = inl g ;
stage-r (c : T) (h : Hq c) (m : N) (d : T) (g : Gam c h (Stage c h m) (stage-sub c h m) d) : Stage c h (ns m) d = inr g ;

-- Gamma^w, and the parts of d in it: n, d in Gamma^n
Gw (c : T) (h : Hq c) (d : T) : U gu = (n : N) * Stage c h n d ;
gw-n (c : T) (h : Hq c) (d : T) (g : Gw c h d) : N = g.1 ;
gw-in (c : T) (h : Hq c) (d : T) (g : Gw c h d) : Stage c h (gw-n c h d g) d = g.2 ;

-- addition on N
plusN : N -> N -> N = split { nz -> \ n -> n ; ns k | r -> \ n -> ns (r n) } ;
plusN-z : (n : N) -> Id N (plusN n nz) n = split {
  nz -> refl nz ; ns k | r -> ap sucN r } ;
plusN-s : (k n : N) -> Id N (plusN k (ns n)) (ns (plusN k n)) = split {
  nz -> \ n -> refl (ns n) ; ns k | r -> \ n -> ap sucN (r n) } ;
plusN-comm : (k n : N) -> Id N (plusN k n) (plusN n k) = split {
  nz -> \ n -> sym (plusN-z n) ;
  ns k | r -> \ n -> trans (ap sucN (r n)) (sym (plusN-s n k)) } ;

-- Gamma^n c Gamma^{k+n}
stage-up (c : T) (h : Hq c) (n : N) : (k : N) -> (d : T) -> Stage c h n d -> Stage c h (plusN k n) d = split {
  nz -> \ d g -> g ;
  ns k | r -> \ d g -> stage-l c h (plusN k n) d (r d g) } ;

-- two elements of Gamma^w are in one stage
Two (c : T) (h : Hq c) (y z : T) : U (gu+) = (m : N) * (Stage c h m y * Stage c h m z) ;
two (c : T) (h : Hq c) (y z : T) (gy : Gw c h y) (gz : Gw c h z) : Two c h y z =
  (plusN (gw-n c h z gz) (gw-n c h y gy),
   (stage-up c h (gw-n c h y gy) (gw-n c h z gz) y (gw-in c h y gy),
    subst (\ m -> Stage c h m z) (plusN-comm (gw-n c h y gy) (gw-n c h z gz))
      (stage-up c h (gw-n c h z gz) (gw-n c h y gy) z (gw-in c h z gz)))) ;

------------------------------------------------------------------------
-- Lemma 4.37 "c"

-- x in OT n C_I(c) with Str(Gamma^m, x) or Pcw(Gamma^m, x) is in Gamma^{m+1}
next-str (c : T) (h : Hq c) (m : N) (x : T) (o : OK x) (i : InC ii c x) (s : Str (Stage c h m) c x) : Gw c h x =
  (ns m, stage-r c h m x (ok-dn x o, (inc-dn c x i, inl s))) ;
next-pc (c : T) (h : Hq c) (m : N) (x : T) (o : OK x) (i : InC ii c x)
  (q : Pcw c h (Stage c h m) (stage-sub c h m) x) : Gw c h x =
  (ns m, stage-r c h m x (ok-dn x o, (inc-dn c x i, inr q))) ;

-- with one part, with two parts
gw-one (c : T) (h : Hq c) (x y : T) (o : OK x) (i : InC ii c x) (gy : Gw c h y)
  (f : (m : N) -> Stage c h m y -> Str (Stage c h m) c x) : Gw c h x =
  next-str c h (gw-n c h y gy) x o i (f (gw-n c h y gy) (gw-in c h y gy)) ;
gw-two (c : T) (h : Hq c) (x y z : T) (o : OK x) (i : InC ii c x) (gy : Gw c h y) (gz : Gw c h z)
  (f : (m : N) -> Stage c h m y -> Stage c h m z -> Str (Stage c h m) c x) : Gw c h x =
  next-str c h (two c h y z gy gz).1 x o i
    (f (two c h y z gy gz).1 (two c h y z gy gz).2.1 (two c h y z gy gz).2.2) ;

-- the statement, for x
P437 (c : T) (h : Hq c) (x : T) : U (gu+) = OK x -> InC ii c x -> C (psi ii c) WW[gu].WW x -> Lf (Gw c h) x ;

-- C^a(WW) is downward closed (4.16(a), via ag-ca)
cw-dc (c : T) (h : Hq c) : DC (C (psi ii c) WW[gu].WW) = (ag-ca WW[gu].WW ag-ww (psi ii c) (hq-o c h)).1 ;

-- psi_I y in WW n a  =>  y in C^a(WW)  (x-in, 4.7(e))
leaf-I (c : T) (h : Hq c) (y : T) (w : WW[gu].WW (psi ii y)) (l : LT (psi ii y) (psi ii c)) : C (psi ii c) WW[gu].WW y =
  fw (C (psi ii y) WW[gu].WW y) (C (psi ii c) WW[gu].WW y)
    (rem47e WW[gu].WW y (ot-T y (ot-psi1 ii y (ww-ot (psi ii y) w))) (psi ii y) (psi ii c)
       (ww-ot (psi ii y) w, (le-refl (psi ii y), lt-TI ii y (refl true)))
       (hq-o c h, (le-of-lt (psi ii y) (psi ii c) l, lt-TI ii c (refl true)))
       y (ot-psi1 ii y (ww-ot (psi ii y) w)) (own-inC ii y (ww-ot (psi ii y) w)))
    (x-in y w) ;

-- psi_k y <' I iff k <=' I, for k /= I (clause (6), by definition of lt)
lt-psi-ii (k y : T) (n : Id Bool (isI k) false) : Id Bool (lt (psi k y) ii) (le k ii) = iteF (isI k) true (le k ii) n ;

-- I <=' k /= I:  psi_k y <' I is false
psi-hi-abs (R : U (gu+)) (k y : T) (o : OK (psi k y)) (n : Id Bool (isI k) false) (l : Tr (le ii k))
  (q : LT (psi k y) ii) : R =
  absurdB R (trans (sym n) (ap isI (le-antisym k ii (ot-T k (ot-psi0 k y o)) (refl true)
                                      (trans (sym (lt-psi-ii k y n)) q) l))) ;

-- psi_k y+ = k for k /= I (Def. 2.13(b))
up-psi (k y : T) (n : Id Bool (isI k) false) : Id T (up (psi k y)) k = ap (\ q -> q.2.1) (card-psi-R k y n) ;

-- psi_k y by its own clause:  a <' k and k, y in C^a(WW)
comp-str (c : T) (h : Hq c) (k y : T) (rk : P437 c h k) (ry : P437 c h y) (o : OK (psi k y))
  (i : InC ii c (psi k y)) (p : PsiP (psi ii c) WW[gu].WW k y) : Gw c h (psi k y) =
  boolCases (Gw c h (psi k y)) (le ii k)
    (\ l -> gw-two c h (psi k y) k y o i
              (rk (ot-psi0 k y o) (inc-psi-hi c k y o l i).1 p.2.1)
              (ry (ot-psi1 k y o) (inc-psi-hi c k y o l i).2 p.2.2)
              (\ m u v -> (lt-dn (psi ii c) k p.1, (u, v))))
    (\ l -> lt-abs (Gw c h (psi k y)) k (psi ii c) (ot-T k (ot-psi0 k y o)) (ot-T (psi ii c) (hq-o c h))
              (inc-below c k (hq-c c h) (ot-psi0 k y o) (inc-psi-lo c k y o l i)
                 (nle-lt' ii k (refl true) (ot-T k (ot-psi0 k y o)) l))
              p.1) ;

-- psi_I y in WW n a: its own clause (k = I)
comp-I (c : T) (h : Hq c) (k y : T) (rk : P437 c h k) (ry : P437 c h y) (o : OK (psi k y))
  (i : InC ii c (psi k y)) (e : Id T ii k) (q : Cap WW[gu].WW (psi ii c) (psi k y)) : Gw c h (psi k y) =
  comp-str c h k y rk ry o i
    (tr-B (\ u -> LT (psi ii c) u) ii k e (lt-TI ii c (refl true)),
     (tr-B (C (psi ii c) WW[gu].WW) ii k e (ca-I (psi ii c) WW[gu].WW),
      leaf-I c h y (tr-B (\ u -> WW[gu].WW (psi u y)) k ii (sym e) q.1)
        (tr-B (\ u -> LT (psi u y) (psi ii c)) k ii (sym e) q.2))) ;

-- the last step: k in Gamma^m, k <' a, x in WW n k
comp-lo2 (c : T) (h : Hq c) (k y : T) (o : OK (psi k y)) (i : InC ii c (psi k y)) (q : Cap WW[gu].WW (psi ii c) (psi k y))
  (wk : WW[gu].WW k) (lk : LT k (psi ii c)) (gk : Gw c h k) : Gw c h (psi k y) =
  next-pc c h (gw-n c h k gk) (psi k y) o i
    (k, (gw-in c h k gk, (lt-dn k (psi ii c) lk,
      ww-in k (cw-ww c h k (stage-sub c h (gw-n c h k gk) k (gw-in c h k gk)) (WW[gu].lt-up k (psi ii c) (lt-dn k (psi ii c) lk)))
        (psi k y) q.1 (psi-lt k y o)))) ;

-- psi_k y in WW n a, k <' I: Pcw with k = x+
comp-lo (c : T) (h : Hq c) (k y : T) (rk : P437 c h k) (o : OK (psi k y)) (i : InC ii c (psi k y))
  (n : Id Bool (isI k) false) (l : Id Bool (le ii k) false) (q : Cap WW[gu].WW (psi ii c) (psi k y)) : Gw c h (psi k y) =
  comp-lo2 c h k y o i q
    (tr-B WW[gu].WW (up (psi k y)) k (up-psi k y n) (ww-up (psi k y) q.1))
    (inc-below c k (hq-c c h) (ot-psi0 k y o) (inc-psi-lo c k y o l i)
       (nle-lt' ii k (refl true) (ot-T k (ot-psi0 k y o)) l))
    (rk (ot-psi0 k y o) (inc-psi-lo c k y o l i)
       (rem47h (psi ii c) WW[gu].WW k (ot-psi0 k y o)
          (tr-B WW[gu].WW (up (psi k y)) k (up-psi k y n) (ww-up (psi k y) q.1),
           inc-below c k (hq-c c h) (ot-psi0 k y o) (inc-psi-lo c k y o l i)
             (nle-lt' ii k (refl true) (ot-T k (ot-psi0 k y o)) l)))) ;

-- psi_k y in WW n a
comp-leaf (c : T) (h : Hq c) (k y : T) (rk : P437 c h k) (ry : P437 c h y) (o : OK (psi k y))
  (i : InC ii c (psi k y)) (q : Cap WW[gu].WW (psi ii c) (psi k y)) : Gw c h (psi k y) =
  boolCases (Gw c h (psi k y)) (isI k)
    (\ t -> comp-I c h k y rk ry o i (sym (isI-true k t)) q)
    (\ n -> boolCases (Gw c h (psi k y)) (le ii k)
              (\ l -> psi-hi-abs (Gw c h (psi k y)) k y o n l
                        (lt-trans (psi k y) (psi ii c) ii (ot-T (psi k y) o) (ot-T (psi ii c) (hq-o c h)) (refl true)
                           q.2 (lt-TI ii c (refl true))))
              (\ l -> comp-lo c h k y rk o i n l q)) ;

rem437 (c : T) (h : Hq c) : (x : T) -> P437 c h x = split {
  zero -> \ o i g -> next-str c h nz zero o i tt ;
  plus x0 xs | r0 rs -> \ o i g ->
    gw-two c h (plus x0 xs) x0 xs o i
      (r0 (ot-plus0 x0 xs o) (inc-plus c x0 xs o i).1
          (dc-sum (C (psi ii c) WW[gu].WW) (cw-dc c h) (plus x0 xs) x0 xs (ot-plus0 x0 xs o) (ot-plusS x0 xs o) g (nfs-head x0 xs o)).1)
      (rs (ot-plusS x0 xs o) (inc-plus c x0 xs o i).2
          (dc-sum (C (psi ii c) WW[gu].WW) (cw-dc c h) (plus x0 xs) x0 xs (ot-plus0 x0 xs o) (ot-plusS x0 xs o) g (nfs-head x0 xs o)).2)
      (\ m u v -> (u, v)) ;
  phi x0 x1 | r0 r1 -> \ o i g ->
    gw-two c h (phi x0 x1) x0 x1 o i
      (r0 (ot-phi0 x0 x1 o) (inc-phi c x0 x1 o i).1
          (wd-p (C (psi ii c) WW[gu].WW) (dc-wd (C (psi ii c) WW[gu].WW) (cw-dc c h)) (phi x0 x1) x0 x1
             (ot-phi0 x0 x1 o) (ot-phi1 x0 x1 o) g (refl (phi x0 x1), o)).1)
      (r1 (ot-phi1 x0 x1 o) (inc-phi c x0 x1 o i).2
          (wd-p (C (psi ii c) WW[gu].WW) (dc-wd (C (psi ii c) WW[gu].WW) (cw-dc c h)) (phi x0 x1) x0 x1
             (ot-phi0 x0 x1 o) (ot-phi1 x0 x1 o) g (refl (phi x0 x1), o)).2)
      (\ m u v -> (u, v)) ;
  psi k y | rk ry -> \ o i g ->
    either (Cap WW[gu].WW (psi ii c) (psi k y)) (PsiP (psi ii c) WW[gu].WW k y) (Gw c h (psi k y))
      (comp-leaf c h k y rk ry o i) (comp-str c h k y rk ry o i)
      (fw (C (psi ii c) WW[gu].WW (psi k y)) (Or (Cap WW[gu].WW (psi ii c) (psi k y)) (PsiP (psi ii c) WW[gu].WW k y))
         (ca-psi (psi ii c) WW[gu].WW k y o) g) ;
  om x0 | r0 -> \ o i g ->
    gw-one c h (om x0) x0 o i
      (r0 (ot-om0 x0 o) (inc-om c x0 o i)
          (wd-o (C (psi ii c) WW[gu].WW) (dc-wd (C (psi ii c) WW[gu].WW) (cw-dc c h)) (om x0) x0 (ot-om0 x0 o) g (refl (om x0), o)))
      (\ m u -> u) ;
  ii -> \ o i g -> next-str c h nz ii o i tt } ;

------------------------------------------------------------------------
-- Lemma 4.38

-- (a)  B = Gamma^w n a
Bs (c : T) (h : Hq c) (d : T) : U gu = SC.Cap (Gw c h) (psi ii c) d ;

bs-bar (c : T) (h : Hq c) : Sub (Lf (Bs c h)) (Bar WW[gu].WW (psi ii c)) =
  \ d b -> (hq-t c h d (cw-c c d (stage-sub c h (gw-n c h d b.1) d (gw-in c h d b.1)), WW[gu].lt-up d (psi ii c) b.2),
            lt-sx d (psi ii c) (ca-ok (psi ii c) WW[gu].WW d (cw-c c d (stage-sub c h (gw-n c h d b.1) d (gw-in c h d b.1)))) (hq-o c h)
              (WW[gu].lt-up d (psi ii c) b.2)) ;

-- y <' a  =>  y in C_I(c)  (2.15(c) at I)
inc-of (c : T) (h : Hq c) (y : T) (oy : OK y) (l : LT y (psi ii c)) : InC ii c y =
  trans (cs-I y c (hq-c c h) oy
           (lt-trans y (psi ii c) ii (ot-T y oy) (ot-T (psi ii c) (hq-o c h)) (refl true) l (lt-TI ii c (refl true))))
        l ;

bs-dn (c : T) (h : Hq c) : Sub (tau WW[gu].WW (psi ii c)) (Dn (Lf (Bs c h))) =
  \ y t -> (y, ((rem437 c h y (ca-ok (psi ii c) WW[gu].WW y t.1) (inc-of c h y (ca-ok (psi ii c) WW[gu].WW y t.1) t.2) t.1,
                 lt-dn y (psi ii c) t.2), le-refl y)) ;

hq-of (c : T) (s : scA WW[gu].WW WW[gu].WW (psi ii c)) : Hq c = (s.1.1, s.2) ;

rem438a (c : T) (s : scA WW[gu].WW WW[gu].WW (psi ii c)) : WW[gu].WW (psi ii c) =
  rem430 (psi ii c) (Bs c (hq-of c s))
    (s.1, (lt-TI ii c (refl true), (bs-bar c (hq-of c s), bs-dn c (hq-of c s)))) ;

-- (b)
w438 (x : T) (s : scA WW[gu].WW WW[gu].WW x) : WA[gu+].WA WW[gu].WW x = wa-a WW[gu].WW x (s.1, \ y t -> ag-w WW[gu].WW ag-ww y (s.2 y t)) ;
below438 (x z : T) (s : scA WW[gu].WW WW[gu].WW x) (wz : WW[gu].WW z) (l : LT x z) : WW[gu].WW x =
  ag-back WW[gu].WW ag-ww z x wz (w438 x s) (le-of-lt x z l) ;

-- x^{-Fi} = psi_I y in WW
fi438 (x : T) (s : scA WW[gu].WW WW[gu].WW x) (g : G2 x (mFi x) (pFi x)) : WW[gu].WW (psi ii g.1) =
  boolCases (WW[gu].WW (psi ii g.1)) (lt (mFi x) x)
    (\ t -> s.2 (psi ii g.1)
              (tr-B (C x WW[gu].WW) (mFi x) (psi ii g.1) g.2.2.2.1
                 (dc-card (C x WW[gu].WW) (ag-ca WW[gu].WW ag-ww x s.1.1).1 x s.1.2).2.1,
               tr-B (\ u -> LT u x) (mFi x) (psi ii g.1) g.2.2.2.1 t))
    (\ f -> rem438a g.1
              (tr-B (scA WW[gu].WW WW[gu].WW) x (psi ii g.1)
                 (trans (le-antisym x (mFi x) (ot-T x s.1.1) (ot-T (mFi x) (rem214a x s.1.1).2.2.1)
                           (nlt-le x (mFi x) (ot-T x s.1.1) (ot-T (mFi x) (rem214a x s.1.1).2.2.1) f) g.2.2.2.2.2.1)
                        g.2.2.2.1)
                 s)) ;

rem438b (x : T) (s : scA WW[gu].WW WW[gu].WW x) (l : LT x ii) : WW[gu].WW x =
  boolCases (WW[gu].WW x) (lt x (psi ii zero))
    (\ t -> below438 x (psi ii zero) s rem431b0 t)
    (\ f -> below438 x (psi ii (suc (rem214g2 x s.1.1 (nlt-le (psi ii zero) x tt-psiI0 (ot-T x s.1.1) f) l).1)) s
              (rem431b (rem214g2 x s.1.1 (nlt-le (psi ii zero) x tt-psiI0 (ot-T x s.1.1) f) l).1
                 (fi438 x s (rem214g2 x s.1.1 (nlt-le (psi ii zero) x tt-psiI0 (ot-T x s.1.1) f) l)))
              (tr-B (\ u -> LT x u) (pFi x)
                 (psi ii (suc (rem214g2 x s.1.1 (nlt-le (psi ii zero) x tt-psiI0 (ot-T x s.1.1) f) l).1))
                 (rem214g2 x s.1.1 (nlt-le (psi ii zero) x tt-psiI0 (ot-T x s.1.1) f) l).2.2.2.2.1
                 (rem214g2 x s.1.1 (nlt-le (psi ii zero) x tt-psiI0 (ot-T x s.1.1) f) l).2.2.2.2.2.2)) ;

-- (c)
P438 (y : T) : U (gu+) = LT y ii -> WW[gu].WW y ;
step438 (x : T) (w : WA[gu+].WA WW[gu].WW x) (m : M WW[gu].WW x) (s : Sub (tau WW[gu].WW x) P438) : P438 x =
  \ l -> rem438b x
           (m, \ y t -> s y t (lt-trans y x ii (ot-T y (ca-ok x WW[gu].WW y t.1)) (ot-T x m.1) (refl true) t.2 l))
           l ;

rem438c : Eqv (Cap WW[gu].WW ii) (Cap (WA[gu+].WA WW[gu].WW) ii) =
  \ y -> (\ q -> (ag-w WW[gu].WW ag-ww y q.1, q.2),
          \ q -> (wa-ind WW[gu].WW P438 step438 y q.1 q.2, q.2)) ;
