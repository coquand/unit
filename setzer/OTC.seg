-- OTC.seg: Remark 2.15 of Setzer (APAL 92, 1998), the sets C_kappa(a),
-- with the facts about OT it needs.  Section 4 uses all of (a)-(e); (e) is
-- the one Setzer cites (as "Lemma 2.15(e)", in Lemma 4.17(c)).
--
--   C_kappa(a) = C~_kappa(a) n OT,  b in C~_kappa(a) iff b in T' and
--   G_kappa(b) <' a  (Def. 2.8(b); OT.inC kappa a b).
--
-- Statements (kappa in R n OT, a in T'; b in OT where it says so):
--   (a) 0, I in C_kappa(a)                                  rem215a-zero, rem215a-I
--   (b) b = (c, d) (head, tail), phi'_c d:  b in C~ iff c, d in C~;
--       b = Omega'_c:  b in C~ iff c in C~                  rem215b-plus, -phi, -om
--   (c) b <' kappa:  b in C_kappa(a) iff b <' psi_kappa a    rem215c
--   (d) b = psi_p d:  b in C_kappa(a) iff b <' psi_kappa a or
--       (p, d in C_kappa(a) and d <' a)                     rem215d
--   (e) kappa /= I, b = psi_p d:  b in C_kappa(a) iff b <=' kappa^- or
--       (p, d in C_kappa(a) and d <' a)                     rem215e-R
-- Setzer states (b) for b =NF c+d with any split of the summands; with
-- sums nested to the right the head/tail split is the case written here,
-- and the general one follows by induction on the number of summands.
--
-- Informal proof.  (a), (b): by (G1), (G2), (G4), (G5), and "M u N <' a iff
-- M <' a and N <' a".  (c) by induction on b, using (d) for psi terms
-- (section (c)); (d) by the three cases of (G3) (section (d)); (e) from (d)
-- (section (e)).  What they need, in order:
--   * OT is a subset of T', and the conditions of Def. 2.9 one by one;
--   * comparisons with an atom go through the head of a sum (clause (2));
--   * y <=' c or y <=' d gives y <' phi'_c d                (phi-below);
--   * kappa^- <' kappa, and kappa^- <' psi_kappa d             (km-lt);
--   * x <' Omega'_x for x in OT, Remark 2.12(h)             (lt-om);
--   * G_kappa(x) = {} when hd(x) <=' kappa^-; so G_kappa(kappa) = {}
--                                                           (z-main, G-kk);
--   * G_kappa(d) <' d <' a gives G_kappa(d) <' a             (ot4-mono);
--   * x <' s+1 gives x <=' s                                (lt-succ).
-- Each is proved where it is stated, with its informal proof.

level n ;
import OT ;
import OTLaws ;
import OTTrans ;
open OT ;
open OTLaws[n] ;
open OTTrans[n] ;

-- b in C~_k(a), as a type
InC (k a b : T) : U n = Tr (inC k a b) ;

andA : (u v w : Bool) -> Id Bool (and u (and v w)) (and (and u v) w) = split {
  false -> \ v w -> refl false ; true -> \ v w -> refl (and v w) } ;

------------------------------------------------------------------------
-- M u N <' a iff M <' a and N <' a

allLt-app : (M N : L) (y : T) -> Id Bool (allLt (app M N) y) (and (allLt M y) (allLt N y)) = split {
  nil -> \ N y -> refl (allLt N y) ;
  cons h tl | r -> \ N y -> trans (ap (\ w -> and (lt h y) w) (r N y)) (andA (lt h y) (allLt tl y) (allLt N y)) } ;

------------------------------------------------------------------------
-- (a)

rem215a-zero (k a : T) : InC k a zero = refl true ;
rem215a-I (k a : T) : InC k a ii = refl true ;

------------------------------------------------------------------------
-- (b)

-- b with G_k(b) = G_k(c) u G_k(d), all three in T'
inC-split (k a b c d : T) (tb : TT b) (tc : TT c) (td : TT d) (g : Id L (G k b) (app (G k c) (G k d)))
  : Id Bool (inC k a b) (and (inC k a c) (inC k a d)) =
  trans (ap (\ w -> and w (allLt (G k b) a)) tb)
    (trans (ap (\ M -> allLt M a) g)
      (trans (allLt-app (G k c) (G k d) a)
        (sym (ap2 (\ u v -> and (and u (allLt (G k c) a)) (and v (allLt (G k d) a))) tc td)))) ;

rem215b-plus (k a c d : T) (tb : TT (plus c d)) : Id Bool (inC k a (plus c d)) (and (inC k a c) (inC k a d)) =
  inC-split k a (plus c d) c d tb (isT-plus0 c d tb) (isT-plusS c d tb) (refl (app (G k c) (G k d))) ;

rem215b-phi (k a c d : T) (tb : TT (phi c d)) : Id Bool (inC k a (phi c d)) (and (inC k a c) (inC k a d)) =
  inC-split k a (phi c d) c d tb (isT-phi0 c d tb) (isT-phi1 c d tb) (refl (app (G k c) (G k d))) ;

rem215b-om (k a c : T) (tb : TT (om c)) : Id Bool (inC k a (om c)) (inC k a c) =
  trans (ap (\ w -> and w (allLt (G k c) a)) tb)
    (sym (ap (\ u -> and u (allLt (G k c) a)) (isT-om0 c tb))) ;

------------------------------------------------------------------------
-- OT: the conditions of Def. 2.9, one lemma each, and OT is a subset of T'

OK (x : T) : U n = Tr (isOT x) ;
tr3 (x y z : T) (tx : TT x) (ty : TT y) (tz : TT z) : Tr3 x y z = lt-trans x y z tx ty tz ;

ot-plusH (x0 xs : T) (h : OK (plus x0 xs)) : Tr (and (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs))) =
  and-l (and (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs))) (le (hd xs) x0) h ;
ot-plusA (x0 xs : T) (h : OK (plus x0 xs)) : Tr (isA x0) =
  and-l (isA x0) (isOT x0) (and-l (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs)) (ot-plusH x0 xs h)) ;
ot-plus0 (x0 xs : T) (h : OK (plus x0 xs)) : OK x0 =
  and-r (isA x0) (isOT x0) (and-l (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs)) (ot-plusH x0 xs h)) ;
ot-plusZ (x0 xs : T) (h : OK (plus x0 xs)) : Tr (not (isZero xs)) =
  and-l (not (isZero xs)) (isOT xs) (and-r (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs)) (ot-plusH x0 xs h)) ;
ot-plusS (x0 xs : T) (h : OK (plus x0 xs)) : OK xs =
  and-r (not (isZero xs)) (isOT xs) (and-r (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs)) (ot-plusH x0 xs h)) ;
ot-plusLe (x0 xs : T) (h : OK (plus x0 xs)) : Tr (le (hd xs) x0) =
  and-r (and (and (isA x0) (isOT x0)) (and (not (isZero xs)) (isOT xs))) (le (hd xs) x0) h ;

ot-phi0 (x0 x1 : T) (h : OK (phi x0 x1)) : OK x0 =
  and-l (isOT x0) (isOT x1) (and-l (and (isOT x0) (isOT x1)) (and (not (crit x0 x1)) (not (and (isZero x1) (isG x0)))) h) ;
ot-phi1 (x0 x1 : T) (h : OK (phi x0 x1)) : OK x1 =
  and-r (isOT x0) (isOT x1) (and-l (and (isOT x0) (isOT x1)) (and (not (crit x0 x1)) (not (and (isZero x1) (isG x0)))) h) ;

ot-psiH (x0 x1 : T) (h : OK (psi x0 x1)) : Tr (and (isR x0) (isOT x0)) =
  and-l (and (isR x0) (isOT x0)) (and (isOT x1) (allLt (G x0 x1) x1)) h ;
ot-psiR (x0 x1 : T) (h : OK (psi x0 x1)) : Tr (isR x0) = and-l (isR x0) (isOT x0) (ot-psiH x0 x1 h) ;
ot-psi0 (x0 x1 : T) (h : OK (psi x0 x1)) : OK x0 = and-r (isR x0) (isOT x0) (ot-psiH x0 x1 h) ;
ot-psi1 (x0 x1 : T) (h : OK (psi x0 x1)) : OK x1 =
  and-l (isOT x1) (allLt (G x0 x1) x1) (and-r (and (isR x0) (isOT x0)) (and (isOT x1) (allLt (G x0 x1) x1)) h) ;
-- (OT4): G_pi(b) <' b
ot-psiG (x0 x1 : T) (h : OK (psi x0 x1)) : Tr (allLt (G x0 x1) x1) =
  and-r (isOT x1) (allLt (G x0 x1) x1) (and-r (and (isR x0) (isOT x0)) (and (isOT x1) (allLt (G x0 x1) x1)) h) ;

ot-om0 (x0 : T) (h : OK (om x0)) : OK x0 =
  and-l (isOT x0) (not (isFi x0)) (and-l (and (isOT x0) (not (isFi x0))) (not (isZero x0)) h) ;
ot-omZ (x0 : T) (h : OK (om x0)) : Tr (not (isZero x0)) =
  and-r (and (isOT x0) (not (isFi x0))) (not (isZero x0)) h ;

ot-T : (x : T) -> OK x -> TT x = split {
  zero -> \ h -> refl true ;
  plus x0 xs | i0 is -> \ h ->
    andI (and (isA x0) (isT x0)) (and (not (isZero xs)) (isT xs))
      (andI (isA x0) (isT x0) (ot-plusA x0 xs h) (i0 (ot-plus0 x0 xs h)))
      (andI (not (isZero xs)) (isT xs) (ot-plusZ x0 xs h) (is (ot-plusS x0 xs h))) ;
  phi x0 x1 | i0 i1 -> \ h -> andI (isT x0) (isT x1) (i0 (ot-phi0 x0 x1 h)) (i1 (ot-phi1 x0 x1 h)) ;
  psi x0 x1 | i0 i1 -> \ h ->
    andI (and (isR x0) (isT x0)) (isT x1)
      (andI (isR x0) (isT x0) (ot-psiR x0 x1 h) (i0 (ot-psi0 x0 x1 h))) (i1 (ot-psi1 x0 x1 h)) ;
  om x0 | i0 -> \ h -> andI (not (isZero x0)) (isT x0) (ot-omZ x0 h) (i0 (ot-om0 x0 h)) ;
  ii -> \ h -> refl true } ;

------------------------------------------------------------------------
-- Comparison with an atom g (g in A'), by clause (2):
--   x <' g iff hd(x) <' g;   g <' (y0,..) iff g <=' y0;  so y0 <' (y0,..).

lt-hd : (x g : T) -> Tr (isA g) -> Id Bool (lt x g) (lt (hd x) g) = split {
  zero -> \ g h -> refl (lt zero g) ;
  plus x0 xs -> split {
    zero -> \ h -> abF h ; plus y0 ys -> \ h -> abF h ;
    phi y0 y1 -> \ h -> refl (lt x0 (phi y0 y1)) ;
    psi y0 y1 -> \ h -> refl (lt x0 (psi y0 y1)) ;
    om y0 -> \ h -> refl (lt x0 (om y0)) ;
    ii -> \ h -> refl (lt x0 ii) } ;
  phi x0 x1 -> \ g h -> refl (lt (phi x0 x1) g) ;
  psi x0 x1 -> \ g h -> refl (lt (psi x0 x1) g) ;
  om x0 -> \ g h -> refl (lt (om x0) g) ;
  ii -> \ g h -> refl (lt ii g) } ;

lt-gP : (g : T) -> Tr (isA g) -> (y0 ys : T) -> Id Bool (lt g (plus y0 ys)) (le g y0) = split {
  zero -> \ h y0 ys -> abF h ; plus x0 xs -> \ h y0 ys -> abF h ;
  phi x0 x1 -> \ h y0 ys -> refl (le (phi x0 x1) y0) ;
  psi x0 x1 -> \ h y0 ys -> refl (le (psi x0 x1) y0) ;
  om x0 -> \ h y0 ys -> refl (le (om x0) y0) ;
  ii -> \ h y0 ys -> refl (le ii y0) } ;

le-refl (x : T) : Tr (le x x) = le-of-eq x x (eqT-refl x) ;

lt-head (x0 xs : T) (h : Tr (isA x0)) : LT x0 (plus x0 xs) = trans (lt-gP x0 h x0 xs) (le-refl x0) ;

isT-plusA (x0 xs : T) (p : TT (plus x0 xs)) : Tr (isA x0) =
  and-l (isA x0) (isT x0) (and-l (and (isA x0) (isT x0)) (and (not (isZero xs)) (isT xs)) p) ;

------------------------------------------------------------------------
-- Below phi (Remark 2.12(h) for phi', on T'):
--   y <=' c  =>  y <' phi'_c d       y <=' d  =>  y <' phi'_c d.
-- By induction on y.  0 <' phi'_c d.  A sum: its head is below it, and
-- y <' phi'_c d iff hd(y) <' phi'_c d.  y in G': clause (4).  y = phi'_g h:
-- g <' y and h <' y by the hypothesis at g, h;  if y <=' c, clause (3)(A)
-- (g <' c, and h <' c gives h <' phi'_c d);  if y <=' d, compare g and c:
-- (3)(A) with h <=' d, (3)(B) with h <' d, (3)(C) with y <=' d.

PhiC (y : T) : U n = (c d : T) -> TT y -> TT c -> TT d -> Tr (le y c) -> LT y (phi c d) ;
PhiD (y : T) : U n = (c d : T) -> TT y -> TT c -> TT d -> Tr (le y d) -> LT y (phi c d) ;

phi-below : (y : T) -> PhiC y * PhiD y = split {
  zero -> (\ c d ty tc td h -> refl true, \ c d ty tc td h -> refl true) ;
  plus y0 ys | i0 is ->
    (\ c d ty tc td h -> trans (lt-hd (plus y0 ys) (phi c d) (refl true))
        (i0.1 c d (isT-plus0 y0 ys ty) tc td
          (le-of-lt y0 c (lt-le y0 (plus y0 ys) c (tr3 y0 (plus y0 ys) c (isT-plus0 y0 ys ty) ty tc)
                            (lt-head y0 ys (isT-plusA y0 ys ty)) h))),
     \ c d ty tc td h -> trans (lt-hd (plus y0 ys) (phi c d) (refl true))
        (i0.2 c d (isT-plus0 y0 ys ty) tc td
          (le-of-lt y0 d (lt-le y0 (plus y0 ys) d (tr3 y0 (plus y0 ys) d (isT-plus0 y0 ys ty) ty td)
                            (lt-head y0 ys (isT-plusA y0 ys ty)) h)))) ;
  phi g h | ig ih ->
    (\ c d ty tc td hle -> phi3-A g h c d
        (lt-le g (phi g h) c (tr3 g (phi g h) c (isT-phi0 g h ty) ty tc)
           (ig.1 g h (isT-phi0 g h ty) (isT-phi0 g h ty) (isT-phi1 g h ty) (le-refl g)) hle)
        (ih.1 c d (isT-phi1 g h ty) tc td
           (le-of-lt h c (lt-le h (phi g h) c (tr3 h (phi g h) c (isT-phi1 g h ty) ty tc)
              (ih.2 g h (isT-phi1 g h ty) (isT-phi0 g h ty) (isT-phi1 g h ty) (le-refl h)) hle))),
     \ c d ty tc td hle ->
       tri g c (isT-phi0 g h ty) tc (LT (phi g h) (phi c d))
         (\ p -> phi3-A g h c d p
            (ih.2 c d (isT-phi1 g h ty) tc td
               (le-of-lt h d (lt-le h (phi g h) d (tr3 h (phi g h) d (isT-phi1 g h ty) ty td)
                  (ih.2 g h (isT-phi1 g h ty) (isT-phi0 g h ty) (isT-phi1 g h ty) (le-refl h)) hle))))
         (\ e -> phi3-B g h c d e
            (lt-le h (phi g h) d (tr3 h (phi g h) d (isT-phi1 g h ty) ty td)
               (ih.2 g h (isT-phi1 g h ty) (isT-phi0 g h ty) (isT-phi1 g h ty) (le-refl h)) hle))
         (\ q -> phi3-C g h c d q hle)) ;
  psi g h -> (\ c d ty tc td hle -> gf-intro-c c d (psi g h) tc ty (refl true) hle,
              \ c d ty tc td hle -> gf-intro-d c d (psi g h) td ty (refl true) hle) ;
  om g -> (\ c d ty tc td hle -> gf-intro-c c d (om g) tc ty (refl true) hle,
           \ c d ty tc td hle -> gf-intro-d c d (om g) td ty (refl true) hle) ;
  ii -> (\ c d ty tc td hle -> gf-intro-c c d ii tc ty (refl true) hle,
         \ c d ty tc td hle -> gf-intro-d c d ii td ty (refl true) hle) } ;

------------------------------------------------------------------------
-- Omega_a (Def. 2.10(d)) and kappa^- (Def. 2.13(a))
--   Omega_0 = 0;  Omega_a = a if a in Fi;  Omega_a = Omega'_a otherwise.
--   (Omega'_{s+1})^- = Omega_s;  I^- = 0.
-- s+1 is the sum with last summand 1 = phi'_0 0; pred1 (s+1) = s.

ite-t (A : U n) : (u : Bool) -> (x y : A) -> Tr u -> Id A (ite A u x y) x = split {
  false -> \ x y h -> abF h ; true -> \ x y h -> refl x } ;
ite-f (A : U n) : (u : Bool) -> (x y : A) -> Id Bool u false -> Id A (ite A u x y) y = split {
  false -> \ x y h -> refl y ; true -> \ x y h -> abT h } ;
-- the same for the level-free ifT, ifL, ifQ of OT.seg
ifT-t : (u : Bool) -> (x y : T) -> Tr u -> Id T (ifT u x y) x = split {
  false -> \ x y h -> abF h ; true -> \ x y h -> refl x } ;
ifT-f : (u : Bool) -> (x y : T) -> Id Bool u false -> Id T (ifT u x y) y = split {
  false -> \ x y h -> refl y ; true -> \ x y h -> abT h } ;
ifL-t : (u : Bool) -> (x y : L) -> Tr u -> Id L (ifL u x y) x = split {
  false -> \ x y h -> abF h ; true -> \ x y h -> refl x } ;
ifL-f : (u : Bool) -> (x y : L) -> Id Bool u false -> Id L (ifL u x y) y = split {
  false -> \ x y h -> refl y ; true -> \ x y h -> abT h } ;
ifQ-t : (u : Bool) -> (x y : T * (T * (T * T))) -> Tr u -> Id (T * (T * (T * T))) (ifQ u x y) x = split {
  false -> \ x y h -> abF h ; true -> \ x y h -> refl x } ;
ifQ-f : (u : Bool) -> (x y : T * (T * (T * T))) -> Id Bool u false -> Id (T * (T * (T * T))) (ifQ u x y) y = split {
  false -> \ x y h -> refl y ; true -> \ x y h -> abT h } ;

-- a cardinal other than I is Omega'_t with t in Suc'
R-cases : (p : T) -> Tr (isR p) -> Id Bool (isI p) false -> Id T p (om (arg p)) * Tr (isSuc (arg p)) = split {
  zero -> \ hr hi -> abF hr ; plus x0 xs -> \ hr hi -> abF hr ; phi x0 x1 -> \ hr hi -> abF hr ;
  psi x0 x1 -> \ hr hi -> abF hr ; om x0 -> \ hr hi -> (refl (om x0), hr) ; ii -> \ hr hi -> abT hi } ;

A-nz : (x : T) -> Tr (isA x) -> Id Bool (isZero x) false = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> refl false ;
  psi x0 x1 -> \ h -> refl false ; om x0 -> \ h -> refl false ; ii -> \ h -> refl false } ;

suc-nz : (e : T) -> Tr (isSuc e) -> Tr (not (isZero e)) = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> refl true ; phi x0 x1 -> \ h -> refl true ;
  psi x0 x1 -> \ h -> abF h ; om x0 -> \ h -> abF h ; ii -> \ h -> abF h } ;

one-pred : (e : T) -> Tr (isOne e) -> Id T (pred1 e) zero = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> refl zero ;
  psi x0 x1 -> \ h -> abF h ; om x0 -> \ h -> abF h ; ii -> \ h -> abF h } ;

-- 1 <' psi_q b
one-lt-phi : (x0 x1 q b : T) -> Tr (and (isZero x0) (isZero x1)) -> LT (phi x0 x1) (psi q b) = split {
  zero -> split {
    zero -> \ q b h -> refl true ;
    plus y0 ys -> \ q b h -> abF h ; phi y0 y1 -> \ q b h -> abF h ; psi y0 y1 -> \ q b h -> abF h ;
    om y0 -> \ q b h -> abF h ; ii -> \ q b h -> abF h } ;
  plus y0 ys -> \ x1 q b h -> abF h ; phi y0 y1 -> \ x1 q b h -> abF h ; psi y0 y1 -> \ x1 q b h -> abF h ;
  om y0 -> \ x1 q b h -> abF h ; ii -> \ x1 q b h -> abF h } ;
one-lt : (c q b : T) -> Tr (isOne c) -> LT c (psi q b) = split {
  zero -> \ q b h -> abF h ; plus x0 xs -> \ q b h -> abF h ;
  phi x0 x1 -> \ q b h -> one-lt-phi x0 x1 q b h ;
  psi x0 x1 -> \ q b h -> abF h ; om x0 -> \ q b h -> abF h ; ii -> \ q b h -> abF h } ;

-- s = pred1 t for t in Suc', t /= 1:  s <' t, s in T', hd(t) <=' s, s /= 0
PredOf (t s : T) : U n = LT s t * (TT s * (Tr (le (hd t) s) * Id Bool (isZero s) false)) ;

pred-step (x0 xs p : T) (tt : TT (plus x0 xs)) (h : PredOf xs p) : PredOf (plus x0 xs) (plus x0 p) =
  (trans (lex-PP x0 p x0 xs) (orIr (lt x0 x0) (and (eqT x0 x0) (lt p xs)) (andI (eqT x0 x0) (lt p xs) (eqT-refl x0) h.1)),
   (andI (and (isA x0) (isT x0)) (and (not (isZero p)) (isT p))
      (andI (isA x0) (isT x0) (isT-plusA x0 xs tt) (isT-plus0 x0 xs tt))
      (andI (not (isZero p)) (isT p) (ap not h.2.2.2) h.2.1),
    (le-of-lt x0 (plus x0 p) (lt-head x0 p (isT-plusA x0 xs tt)), refl false))) ;

pred-lt : (t : T) -> TT t -> Tr (isSuc t) -> Id Bool (isOne t) false -> PredOf t (pred1 t) = split {
  zero -> \ tt hs ho -> abF hs ;
  plus x0 xs | _ is -> \ tt hs ho ->
    boolCases (PredOf (plus x0 xs) (pred1 (plus x0 xs))) (isOne xs)
      (\ o -> subst (\ s -> PredOf (plus x0 xs) s) (sym (ifT-t (isOne xs) x0 (plus x0 (pred1 xs)) o))
         (lt-head x0 xs (isT-plusA x0 xs tt),
          (isT-plus0 x0 xs tt, (le-refl x0, A-nz x0 (isT-plusA x0 xs tt)))))
      (\ o -> subst (\ s -> PredOf (plus x0 xs) s) (sym (ifT-f (isOne xs) x0 (plus x0 (pred1 xs)) o))
         (pred-step x0 xs (pred1 xs) tt (is (isT-plusS x0 xs tt) hs o))) ;
  phi x0 x1 -> \ tt hs ho -> abF (trans (sym ho) hs) ;
  psi x0 x1 -> \ tt hs ho -> abF hs ; om x0 -> \ tt hs ho -> abF hs ; ii -> \ tt hs ho -> abF hs } ;

------------------------------------------------------------------------
-- kappa^- <' kappa and kappa^- <' psi_kappa d, for kappa = Omega'_e, e in Suc'.
-- With s = pred1 e <' e:  Omega_s <' Omega'_e and Omega_s <' psi_kappa d, by
-- the clauses for 0, I (10, 5), psi_I (7, 5) and Omega' (9, 6).

KmP (x e : T) : U n = LT x (om e) * ((d : T) -> LT x (psi (om e) d)) ;

om-pair (a e : T) (ta : TT (om a)) (tom : TT (om e)) (h : LT a e) : KmP (om a) e =
  (trans (lex-OO a e) (orIl (lt a e) (and (eqT a e) false) h),
   \ d -> trans (lex-OS a (om e) d ta tom (refl false))
            (orIl (lt (om a) (om e)) (and (eqT (om a) (om e)) false)
               (trans (lex-OO a e) (orIl (lt a e) (and (eqT a e) false) h)))) ;

omF-lt : (s e : T) -> TT s -> TT e -> TT (om e) -> LT s e -> KmP (omF s) e = split {
  zero -> \ e ts te tom h -> (refl true, \ d -> refl true) ;
  plus x0 xs -> \ e ts te tom h -> om-pair (plus x0 xs) e ts tom h ;
  phi x0 x1 -> \ e ts te tom h -> om-pair (phi x0 x1) e ts tom h ;
  psi p c -> \ e ts te tom h ->
    boolCases (KmP (omF (psi p c)) e) (isI p)
      (\ hp -> subst (\ u -> KmP u e) (sym (ifT-t (isI p) (psi p c) (om (psi p c)) hp))
         (trans (lex-TO p c e hp) (orIl (lt (psi p c) e) (and (eqT (psi p c) e) true) h),
          \ d -> trans (lex-TS p c (om e) d hp (refl false))
                   (orIl (lt (psi p c) (om e)) (and (eqT (psi p c) (om e)) false)
                      (trans (lex-TO p c e hp) (orIl (lt (psi p c) e) (and (eqT (psi p c) e) true) h)))))
      (\ hp -> subst (\ u -> KmP u e) (sym (ifT-f (isI p) (psi p c) (om (psi p c)) hp))
         (om-pair (psi p c) e ts tom h)) ;
  om a -> \ e ts te tom h -> om-pair (om a) e ts tom h ;
  ii -> \ e ts te tom h ->
    (trans (lex-IO e te) (orIl (lt ii e) (and (eqT ii e) true) h),
     \ d -> trans (lex-IS (om e) d tom (refl false))
              (orIl (lt ii (om e)) (and (eqT ii (om e)) false)
                 (trans (lex-IO e te) (orIl (lt ii e) (and (eqT ii e) true) h)))) } ;

tt-om (e : T) (te : TT e) (hs : Tr (isSuc e)) : TT (om e) = andI (not (isZero e)) (isT e) (suc-nz e hs) te ;

km-lt (e : T) (te : TT e) (hs : Tr (isSuc e)) : KmP (kminus (om e)) e =
  boolCases (KmP (kminus (om e)) e) (isOne e)
    (\ o -> subst (\ s -> KmP (omF s) e) (sym (one-pred e o)) (refl true, \ d -> refl true))
    (\ o -> omF-lt (pred1 e) e (pred-lt e te hs o).2.1 te (tt-om e te hs) (pred-lt e te hs o).1) ;

omF-T : (s : T) -> TT s -> TT (omF s) = split {
  zero -> \ ts -> ts ; plus x0 xs -> \ ts -> ts ; phi x0 x1 -> \ ts -> ts ;
  psi p c -> \ ts -> boolCases (TT (omF (psi p c))) (isI p)
    (\ hp -> subst (\ u -> TT u) (sym (ifT-t (isI p) (psi p c) (om (psi p c)) hp)) ts)
    (\ hp -> subst (\ u -> TT u) (sym (ifT-f (isI p) (psi p c) (om (psi p c)) hp)) ts) ;
  om a -> \ ts -> ts ; ii -> \ ts -> ts } ;

------------------------------------------------------------------------
-- x <' Omega'_y for x in OT, x <=' y (Remark 2.12(h): x <=' Omega_x).
--
-- By induction on x, with two more statements carried along:
--   Yb x:  x <=' s  =>  x <' psi_kappa b,  kappa = Omega'_{s+1}
--          (x <=' Omega_s = kappa^- <' psi_kappa b, from the first statement
--          at x when Omega_s = Omega'_s);
--   Va x:  for x = Omega'_t, t in Suc':  t <' psi_x b
--          (t <' psi_x b iff hd(t) <' psi_x b, and Yb at hd(t)).
-- The cases of x <' Omega'_y.  0: (1).  I: (10).  A sum: hd(x) <' x <=' y.
-- phi'_c d: (4), with c, d <' phi'_c d.  Omega'_c: (9), with c <' Omega'_c.
-- psi_I b: (7).  psi_p b, p = Omega'_t: by (6) we need p <=' Omega'_y, that
-- is t <=' y, and t <' psi_p b <=' y by Va at p.  This is why Va is carried:
-- the hypothesis is needed at hd(t), which is not a subterm of psi_p b.

L2 (x : T) : U n = (y : T) -> TT y -> Tr (le x y) -> LT x (om y) ;
Yb (x : T) : U n = (e b : T) -> TT e -> TT b -> Tr (isSuc e) -> Tr (le x (pred1 e)) -> LT x (psi (om e) b) ;
Va (x : T) : U n = (b : T) -> TT b -> Tr (isSuc (arg x)) -> LT (arg x) (psi x b) ;

-- x <=' s gives x <=' Omega_s, by L2 at x when Omega_s = Omega'_s
omF-le : (s x : T) -> L2 x -> TT s -> Tr (le x s) -> Tr (le x (omF s)) = split {
  zero -> \ x lx ts h -> h ;
  plus x0 xs -> \ x lx ts h -> le-of-lt x (om (plus x0 xs)) (lx (plus x0 xs) ts h) ;
  phi x0 x1 -> \ x lx ts h -> le-of-lt x (om (phi x0 x1)) (lx (phi x0 x1) ts h) ;
  psi p c -> \ x lx ts h -> boolCases (Tr (le x (omF (psi p c)))) (isI p)
    (\ hp -> subst (\ u -> Tr (le x u)) (sym (ifT-t (isI p) (psi p c) (om (psi p c)) hp)) h)
    (\ hp -> subst (\ u -> Tr (le x u)) (sym (ifT-f (isI p) (psi p c) (om (psi p c)) hp))
               (le-of-lt x (om (psi p c)) (lx (psi p c) ts h))) ;
  om a -> \ x lx ts h -> le-of-lt x (om (om a)) (lx (om a) ts h) ;
  ii -> \ x lx ts h -> h } ;

tt-psi (e b : T) (te : TT e) (tb : TT b) (hs : Tr (isSuc e)) : TT (psi (om e) b) =
  andI (and (isR (om e)) (isT (om e))) (isT b) (andI (isR (om e)) (isT (om e)) hs (tt-om e te hs)) tb ;

yb-of (x : T) (lx : L2 x) (tx : TT x) : Yb x = \ e b te tb hs h ->
  boolCases (LT x (psi (om e) b)) (isOne e)
    (\ o -> le-lt x zero (psi (om e) b) (tr3 x zero (psi (om e) b) tx (refl true) (tt-psi e b te tb hs))
              (subst (\ s -> Tr (le x s)) (one-pred e o) h) (refl true))
    (\ o -> le-lt x (omF (pred1 e)) (psi (om e) b)
              (tr3 x (omF (pred1 e)) (psi (om e) b) tx (omF-T (pred1 e) (pred-lt e te hs o).2.1) (tt-psi e b te tb hs))
              (omF-le (pred1 e) x lx (pred-lt e te hs o).2.1 h)
              ((km-lt e te hs).2 b)) ;

K (x : T) : U n = L2 x * (Yb (hd x) * Va x) ;

k-plus (x0 xs : T) (o : OK (plus x0 xs)) (r0 : K x0) : K (plus x0 xs) =
  (\ y ty h -> trans (lt-hd (plus x0 xs) (om y) (refl true))
       (r0.1 y ty (le-of-lt x0 y (lt-le x0 (plus x0 xs) y
          (tr3 x0 (plus x0 xs) y (ot-T x0 (ot-plus0 x0 xs o)) (ot-T (plus x0 xs) o) ty)
          (lt-head x0 xs (ot-plusA x0 xs o)) h))),
   (yb-of x0 r0.1 (ot-T x0 (ot-plus0 x0 xs o)), \ b tb hs -> abF hs)) ;

l2-phi (c d : T) (o : OK (phi c d)) (rc : K c) (rd : K d) : L2 (phi c d) = \ y ty h ->
  fg-intro c d (om y) (refl true)
    (rc.1 y ty (le-of-lt c y (lt-le c (phi c d) y
       (tr3 c (phi c d) y (ot-T c (ot-phi0 c d o)) (ot-T (phi c d) o) ty)
       ((phi-below c).1 c d (ot-T c (ot-phi0 c d o)) (ot-T c (ot-phi0 c d o)) (ot-T d (ot-phi1 c d o)) (le-refl c)) h)))
    (rd.1 y ty (le-of-lt d y (lt-le d (phi c d) y
       (tr3 d (phi c d) y (ot-T d (ot-phi1 c d o)) (ot-T (phi c d) o) ty)
       ((phi-below d).2 c d (ot-T d (ot-phi1 c d o)) (ot-T c (ot-phi0 c d o)) (ot-T d (ot-phi1 c d o)) (le-refl d)) h))) ;

k-phi (c d : T) (o : OK (phi c d)) (rc : K c) (rd : K d) : K (phi c d) =
  (l2-phi c d o rc rd, (yb-of (phi c d) (l2-phi c d o rc rd) (ot-T (phi c d) o), \ b tb hs -> abF hs)) ;

l2-om (c : T) (o : OK (om c)) (rc : K c) : L2 (om c) = \ y ty h ->
  trans (lex-OO c y) (orIl (lt c y) (and (eqT c y) false)
    (lt-le c (om c) y (tr3 c (om c) y (ot-T c (ot-om0 c o)) (ot-T (om c) o) ty)
       (rc.1 c (ot-T c (ot-om0 c o)) (le-refl c)) h)) ;

va-om (c : T) (o : OK (om c)) (rc : K c) : Va (om c) = \ b tb hs ->
  boolCases (LT c (psi (om c) b)) (isOne c)
    (\ e -> one-lt c (om c) b e)
    (\ e -> trans (lt-hd c (psi (om c) b) (refl true))
              (rc.2.1 c b (ot-T c (ot-om0 c o)) tb hs (pred-lt c (ot-T c (ot-om0 c o)) hs e).2.2.1)) ;

k-om (c : T) (o : OK (om c)) (rc : K c) : K (om c) =
  (l2-om c o rc, (yb-of (om c) (l2-om c o rc) (ot-T (om c) o), va-om c o rc)) ;

-- psi_p b <' Omega'_y, p = Omega'_t:  t <' psi_p b <=' y, so p <' Omega'_y
l2-psiS (p b y : T) (o : OK (psi p b)) (rp : K p) (ty : TT y) (h : Tr (le (psi p b) y))
  (hp : Id Bool (isI p) false) : Tr (le p (om y)) =
  subst (\ q -> Tr (le q (om y))) (sym (R-cases p (ot-psiR p b o) hp).1)
    (le-of-lt (om (arg p)) (om y) (trans (lex-OO (arg p) y) (orIl (lt (arg p) y) (and (eqT (arg p) y) false)
       (lt-le (arg p) (psi p b) y
          (tr3 (arg p) (psi p b) y
             (isT-om0 (arg p) (subst (\ q -> TT q) (R-cases p (ot-psiR p b o) hp).1 (ot-T p (ot-psi0 p b o))))
             (ot-T (psi p b) o) ty)
          (rp.2.2 b (ot-T b (ot-psi1 p b o)) (R-cases p (ot-psiR p b o) hp).2) h)))) ;

l2-psi (p b : T) (o : OK (psi p b)) (rp : K p) : L2 (psi p b) = \ y ty h ->
  boolCases (LT (psi p b) (om y)) (isI p)
    (\ hp -> trans (lex-TO p b y hp) (trans (orAT (lt (psi p b) y) (eqT (psi p b) y)) h))
    (\ hp -> trans (lex-SO p b y hp) (trans (orAT (lt p (om y)) (eqT p (om y))) (l2-psiS p b y o rp ty h hp))) ;

k-psi (p b : T) (o : OK (psi p b)) (rp : K p) : K (psi p b) =
  (l2-psi p b o rp, (yb-of (psi p b) (l2-psi p b o rp) (ot-T (psi p b) o), \ b' tb hs -> abF hs)) ;

l2-I : L2 ii = \ y ty h -> trans (lex-IO y ty) (trans (orAT (lt ii y) (eqT ii y)) h) ;

k-main : (x : T) -> OK x -> K x = split {
  zero -> \ o -> (\ y ty h -> refl true, (\ e b te tb hs h -> refl true, \ b tb hs -> abF hs)) ;
  plus x0 xs | k0 ks -> \ o -> k-plus x0 xs o (k0 (ot-plus0 x0 xs o)) ;
  phi c d | kc kd -> \ o -> k-phi c d o (kc (ot-phi0 c d o)) (kd (ot-phi1 c d o)) ;
  psi p b | kp kb -> \ o -> k-psi p b o (kp (ot-psi0 p b o)) ;
  om c | kc -> \ o -> k-om c o (kc (ot-om0 c o)) ;
  ii -> \ o -> (l2-I, (yb-of ii l2-I (refl true), \ b tb hs -> abF hs)) } ;

-- Remark 2.12(h), the Omega part:  x <' Omega'_x
lt-om (x : T) (o : OK x) : LT x (om x) = (k-main x o).1 x (ot-T x o) (le-refl x) ;

------------------------------------------------------------------------
-- G_kappa(x) = {} below kappa^-  (kappa = Omega'_e, e in Suc')
--
-- Let g in G' with g <' kappa and g <' psi_kappa d for every d (g = kappa^-
-- will do).  For x in OT with hd(x) <=' g:  G_kappa(x) = {}.  By induction
-- on x.  Sums: every summand is <=' hd(x).  phi'_c d, Omega'_c: c, d are
-- below x (phi-below, lt-om), and G_kappa is the union of theirs (G1, G2,
-- G4).  psi_p b <=' g <' kappa: if p = I, G_kappa(psi_I b) = {} as
-- psi_I b <' kappa (G3, third case); if p /= I, then p <=' kappa by (6) and
-- p /= kappa as g <' psi_kappa b, so p <' kappa and G_kappa(psi_p b) = {}.
-- Then G_kappa(kappa) = G_kappa(e) = {}: hd(e) <=' pred1(e) <=' kappa^-.

lt-nle (u v : T) (tu : TT u) (tv : TT v) (h : LT u v) : Id Bool (le v u) false =
  boolCases (Id Bool (le v u) false) (eqT v u)
    (\ e -> abF (trans (sym (lt-irr u)) (subst (\ s -> LT u s) (eqT-sound v u e) h)))
    (\ ne -> trans (ap (\ w -> or w (eqT v u)) (lt-asym u v tu tv h)) ne) ;

le-trans (u v w : T) (k : Tr3 u v w) (h1 : Tr (le u v)) (h2 : Tr (le v w)) : Tr (le u w) =
  orE (Tr (le u w)) (lt u v) (eqT u v) h1
    (\ p -> le-of-lt u w (lt-le u v w k p h2))
    (\ e -> subst (\ s -> Tr (le s w)) (sym (eqT-sound u v e)) h2) ;

hd-A : (x : T) -> Tr (isA x) -> Id T (hd x) x = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> refl (phi x0 x1) ;
  psi x0 x1 -> \ h -> refl (psi x0 x1) ; om x0 -> \ h -> refl (om x0) ; ii -> \ h -> refl ii } ;

hd-OK : (x : T) -> OK x -> OK (hd x) = split {
  zero -> \ o -> o ; plus x0 xs -> \ o -> ot-plus0 x0 xs o ; phi x0 x1 -> \ o -> o ;
  psi x0 x1 -> \ o -> o ; om x0 -> \ o -> o ; ii -> \ o -> o } ;

hd-le : (x : T) -> TT x -> Tr (le (hd x) x) = split {
  zero -> \ t -> le-refl zero ;
  plus x0 xs -> \ t -> le-of-lt x0 (plus x0 xs) (lt-head x0 xs (isT-plusA x0 xs t)) ;
  phi x0 x1 -> \ t -> le-refl (phi x0 x1) ; psi x0 x1 -> \ t -> le-refl (psi x0 x1) ;
  om x0 -> \ t -> le-refl (om x0) ; ii -> \ t -> le-refl ii } ;

-- u <' x <=' g, u in OT: hd(u) <=' g
below-g (u x g : T) (ou : OK u) (tx : TT x) (tg : TT g) (h1 : LT u x) (h2 : Tr (le x g)) : Tr (le (hd u) g) =
  le-trans (hd u) u g (tr3 (hd u) u g (ot-T (hd u) (hd-OK u ou)) (ot-T u ou) tg)
    (hd-le u (ot-T u ou)) (le-of-lt u g (lt-le u x g (tr3 u x g (ot-T u ou) tx tg) h1 h2)) ;

Zh (e g x : T) : U n = OK x -> Tr (le (hd x) g) -> Id L (G (om e) x) nil ;

z-psi (e g p b : T) (te : TT e) (hs : Tr (isSuc e)) (tg : TT g) (gk : LT g (om e))
  (gpsi : (d : T) -> LT g (psi (om e) d)) (o : OK (psi p b)) (h : Tr (le (psi p b) g)) : Id L (G (om e) (psi p b)) nil =
  boolCases (Id L (G (om e) (psi p b)) nil) (isI p)
    (\ hp -> trans (ifL-t (isI p) (ifL (le (om e) (psi p b)) (cons b (app (G (om e) p) (G (om e) b))) nil)
                     (ifL (le (om e) p) (cons b (app (G (om e) p) (G (om e) b))) nil) hp)
                 (ifL-f (le (om e) (psi p b)) (cons b (app (G (om e) p) (G (om e) b))) nil
                    (lt-nle (psi p b) (om e) (ot-T (psi p b) o) (tt-om e te hs)
                       (le-lt (psi p b) g (om e) (tr3 (psi p b) g (om e) (ot-T (psi p b) o) tg (tt-om e te hs)) h gk))))
    (\ hp -> trans (ifL-f (isI p) (ifL (le (om e) (psi p b)) (cons b (app (G (om e) p) (G (om e) b))) nil)
                     (ifL (le (om e) p) (cons b (app (G (om e) p) (G (om e) b))) nil) hp)
                 (ifL-f (le (om e) p) (cons b (app (G (om e) p) (G (om e) b))) nil
                    (lt-nle p (om e) (ot-T p (ot-psi0 p b o)) (tt-om e te hs)
                       (orE (LT p (om e)) (lt p (om e)) (and (eqT p (om e)) true)
                          (trans (sym (lex-SO p b e hp))
                             (le-lt (psi p b) g (om e) (tr3 (psi p b) g (om e) (ot-T (psi p b) o) tg (tt-om e te hs)) h gk))
                          (\ q -> q)
                          (\ q -> abF (trans (sym (le-nlt (psi (om e) b) g (subst (\ s -> TT (psi s b)) (eqT-sound p (om e) (and-l (eqT p (om e)) true q)) (ot-T (psi p b) o)) tg
                                                   (subst (\ s -> Tr (le (psi s b) g)) (eqT-sound p (om e) (and-l (eqT p (om e)) true q)) h)))
                                         (gpsi b))))))) ;

z-main (e g : T) (te : TT e) (hs : Tr (isSuc e)) (tg : TT g) (gk : LT g (om e))
  (gpsi : (d : T) -> LT g (psi (om e) d)) : (x : T) -> Zh e g x = split {
  zero -> \ o h -> refl nil ;
  plus x0 xs | z0 zs -> \ o h ->
    ap2 app (z0 (ot-plus0 x0 xs o) (subst (\ u -> Tr (le u g)) (sym (hd-A x0 (ot-plusA x0 xs o))) h))
            (zs (ot-plusS x0 xs o)
               (le-trans (hd xs) x0 g
                  (tr3 (hd xs) x0 g (ot-T (hd xs) (hd-OK xs (ot-plusS x0 xs o))) (ot-T x0 (ot-plus0 x0 xs o)) tg)
                  (ot-plusLe x0 xs o) h)) ;
  phi c d | zc zd -> \ o h ->
    ap2 app (zc (ot-phi0 c d o) (below-g c (phi c d) g (ot-phi0 c d o) (ot-T (phi c d) o) tg
                 ((phi-below c).1 c d (ot-T c (ot-phi0 c d o)) (ot-T c (ot-phi0 c d o)) (ot-T d (ot-phi1 c d o)) (le-refl c)) h))
            (zd (ot-phi1 c d o) (below-g d (phi c d) g (ot-phi1 c d o) (ot-T (phi c d) o) tg
                 ((phi-below d).2 c d (ot-T d (ot-phi1 c d o)) (ot-T c (ot-phi0 c d o)) (ot-T d (ot-phi1 c d o)) (le-refl d)) h)) ;
  psi p b -> \ o h -> z-psi e g p b te hs tg gk gpsi o h ;
  om c | zc -> \ o h -> zc (ot-om0 c o) (below-g c (om c) g (ot-om0 c o) (ot-T (om c) o) tg (lt-om c (ot-om0 c o)) h) ;
  ii -> \ o h -> refl nil } ;

one-G-phi (k : T) : (x0 x1 : T) -> Tr (and (isZero x0) (isZero x1)) -> Id L (G k (phi x0 x1)) nil = split {
  zero -> split {
    zero -> \ h -> refl nil ;
    plus y0 ys -> \ h -> abF h ; phi y0 y1 -> \ h -> abF h ; psi y0 y1 -> \ h -> abF h ;
    om y0 -> \ h -> abF h ; ii -> \ h -> abF h } ;
  plus y0 ys -> \ x1 h -> abF h ; phi y0 y1 -> \ x1 h -> abF h ; psi y0 y1 -> \ x1 h -> abF h ;
  om y0 -> \ x1 h -> abF h ; ii -> \ x1 h -> abF h } ;
one-G (k : T) : (c : T) -> Tr (isOne c) -> Id L (G k c) nil = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> one-G-phi k x0 x1 h ;
  psi x0 x1 -> \ h -> abF h ; om x0 -> \ h -> abF h ; ii -> \ h -> abF h } ;

-- G_kappa(kappa) = {}
G-kk (e : T) (o : OK (om e)) (hs : Tr (isSuc e)) : Id L (G (om e) (om e)) nil =
  boolCases (Id L (G (om e) e) nil) (isOne e)
    (\ h -> one-G (om e) e h)
    (\ h -> z-main e (kminus (om e)) (ot-T e (ot-om0 e o)) hs
              (omF-T (pred1 e) (pred-lt e (ot-T e (ot-om0 e o)) hs h).2.1)
              (km-lt e (ot-T e (ot-om0 e o)) hs).1 (km-lt e (ot-T e (ot-om0 e o)) hs).2 e (ot-om0 e o)
              (omF-le (pred1 e) (hd e) (k-main (hd e) (hd-OK e (ot-om0 e o))).1
                 (pred-lt e (ot-T e (ot-om0 e o)) hs h).2.1 (pred-lt e (ot-T e (ot-om0 e o)) hs h).2.2.1)) ;

------------------------------------------------------------------------
-- The elements of G_kappa(x) are in T', and M <' d <' a gives M <' a

allT : L -> Bool = split { nil -> true ; cons h tl | r -> and (isT h) r } ;

allT-app : (M N : L) -> Tr (allT M) -> Tr (allT N) -> Tr (allT (app M N)) = split {
  nil -> \ N h1 h2 -> h2 ;
  cons h tl | r -> \ N h1 h2 -> andI (isT h) (allT (app tl N)) (and-l (isT h) (allT tl) h1) (r N (and-r (isT h) (allT tl) h1) h2) } ;

ite-L (P : L -> U n) : (u : Bool) -> (x y : L) -> P x -> P y -> P (ifL u x y) = split {
  false -> \ x y px py -> py ; true -> \ x y px py -> px } ;

G-T (k : T) : (x : T) -> TT x -> Tr (allT (G k x)) = split {
  zero -> \ t -> refl true ;
  plus x0 xs | g0 gs -> \ t -> allT-app (G k x0) (G k xs) (g0 (isT-plus0 x0 xs t)) (gs (isT-plusS x0 xs t)) ;
  phi x0 x1 | g0 g1 -> \ t -> allT-app (G k x0) (G k x1) (g0 (isT-phi0 x0 x1 t)) (g1 (isT-phi1 x0 x1 t)) ;
  psi x0 x1 | g0 g1 -> \ t ->
    ite-L (\ M -> Tr (allT M)) (isI x0) (ifL (or (isI k) (le k (psi x0 x1))) (cons x1 (app (G k x0) (G k x1))) nil)
      (ifL (le k x0) (cons x1 (app (G k x0) (G k x1))) (ifL (isI k) (G k x0) nil))
      (ite-L (\ M -> Tr (allT M)) (or (isI k) (le k (psi x0 x1))) (cons x1 (app (G k x0) (G k x1))) nil
         (andI (isT x1) (allT (app (G k x0) (G k x1))) (isT-psi1 x0 x1 t)
            (allT-app (G k x0) (G k x1) (g0 (isT-psi0 x0 x1 t)) (g1 (isT-psi1 x0 x1 t)))) (refl true))
      (ite-L (\ M -> Tr (allT M)) (le k x0) (cons x1 (app (G k x0) (G k x1))) (ifL (isI k) (G k x0) nil)
         (andI (isT x1) (allT (app (G k x0) (G k x1))) (isT-psi1 x0 x1 t)
            (allT-app (G k x0) (G k x1) (g0 (isT-psi0 x0 x1 t)) (g1 (isT-psi1 x0 x1 t))))
         (ite-L (\ M -> Tr (allT M)) (isI k) (G k x0) nil (g0 (isT-psi0 x0 x1 t)) (refl true))) ;
  om x0 | g0 -> \ t -> g0 (isT-om0 x0 t) ;
  ii -> \ t -> refl true } ;

allLt-mono : (M : L) (d a : T) -> Tr (allT M) -> TT d -> TT a -> Tr (allLt M d) -> LT d a -> Tr (allLt M a) = split {
  nil -> \ d a hM td ta h1 h2 -> refl true ;
  cons h tl | r -> \ d a hM td ta h1 h2 ->
    andI (lt h a) (allLt tl a)
      (tr3 h d a (and-l (isT h) (allT tl) hM) td ta (and-l (lt h d) (allLt tl d) h1) h2)
      (r d a (and-r (isT h) (allT tl) hM) td ta (and-r (lt h d) (allLt tl d) h1) h2) } ;

-- (OT4) with d <' a:  G_p(d) <' a
ot4-mono (p d a : T) (o : OK (psi p d)) (ta : TT a) (h : LT d a) : Tr (allLt (G p d) a) =
  allLt-mono (G p d) d a (G-T p d (ot-T d (ot-psi1 p d o))) (ot-T d (ot-psi1 p d o)) ta (ot-psiG p d o) h ;

------------------------------------------------------------------------
-- Booleans

and-comm : (u v : Bool) -> Id Bool (and u v) (and v u) = split {
  false -> split { false -> refl false ; true -> refl false } ;
  true -> split { false -> refl false ; true -> refl true } } ;
-- u => v:  or u v = v
or-absorb : (u v : Bool) -> (Tr u -> Tr v) -> Id Bool (or u v) v = split {
  false -> \ v h -> refl v ; true -> \ v h -> sym (h (refl true)) } ;
or-and-absorb : (u v w : Bool) -> Id Bool (or u (and (and u v) w)) u = split {
  false -> \ v w -> refl false ; true -> \ v w -> refl true } ;
-- v => u:  or u v = u
or-absorb-r : (u v : Bool) -> (Tr v -> Tr u) -> Id Bool (or u v) u = split {
  false -> split { false -> \ h -> refl false ; true -> \ h -> sym (h (refl true)) } ;
  true -> \ v h -> refl true } ;
-- u => v:  and u v = u
and-absorb : (u v : Bool) -> (Tr u -> Tr v) -> Id Bool (and u v) u = split {
  false -> \ v h -> refl false ; true -> \ v h -> h (refl true) } ;
or-ff : (u v : Bool) -> Id Bool (or u v) false -> Id Bool u false * Id Bool v false = split {
  false -> \ v h -> (refl false, h) ; true -> \ v h -> abT h } ;

-- not (u <=' v) gives v <' u
nle-lt' (u v : T) (tu : TT u) (tv : TT v) (h : Id Bool (le u v) false) : LT v u =
  lt-total u v tu tv (or-ff (lt u v) (eqT u v) h).2 (or-ff (lt u v) (eqT u v) h).1 ;

------------------------------------------------------------------------
-- (d)  b = psi_p d in OT:  b in C_k(a)  iff  b <' psi_k a  or
--      (p, d in C_k(a) and d <' a).
--
-- G_k(b) is, by (G3), one of: the full set {d} u G_k(p) u G_k(d), whose
-- members are <' a iff the second disjunct holds (full-eq); G_k(p), when
-- p <' k = I; or {}.
--   Full set.  The first disjunct implies the second.  If p = k (k /= I, or
--   p = k = I), b <' psi_k a means d <' a; G_k(k) = {} and G_k(d) <' d <' a
--   by (OT4).  The other full cases (k <=' p /= I with p /= k, or k <=' psi_I d)
--   contradict b <' psi_k a, by (5).
--   G_k(p), p <' k = I.  b <' psi_I a iff p <' psi_I a (5), which is
--   p in C_I(a) by (c) at p; and "y or (y and ..)" is y.
--   {}.  p <' k /= I, or psi_I d <' k /= I:  b <' psi_k a by (5).

Y5 (k a p d : T) : Bool = lt (psi p d) (psi k a) ;
X5 (k a p d : T) : Bool = and (and (inC k a p) (inC k a d)) (lt d a) ;

inC-T (k a x : T) (tx : TT x) : Id Bool (inC k a x) (allLt (G k x) a) = ap (\ w -> and w (allLt (G k x) a)) tx ;

full-eq (k a p d : T) (tp : TT p) (td : TT d)
  : Id Bool (allLt (cons d (app (G k p) (G k d))) a) (X5 k a p d) =
  trans (ap (\ w -> and (lt d a) w) (allLt-app (G k p) (G k d) a))
    (trans (and-comm (lt d a) (and (allLt (G k p) a) (allLt (G k d) a)))
       (sym (ap2 (\ u v -> and (and (and u (allLt (G k p) a)) (and v (allLt (G k d) a))) (lt d a)) tp td))) ;

-- the two cases p = k of the full set
x5-eq (k a p d : T) (tp : TT p) (ta : TT a) (o : OK (psi p d)) (pk : Id T p k) (gk : Id L (G k k) nil) (h : LT d a)
  : Tr (X5 k a p d) =
  andI (and (inC k a p) (inC k a d)) (lt d a)
    (andI (inC k a p) (inC k a d)
       (andI (isT p) (allLt (G k p) a) tp
          (subst (\ q -> Tr (allLt (G k q) a)) (sym pk) (subst (\ M -> Tr (allLt M a)) (sym gk) (refl true))))
       (andI (isT d) (allLt (G k d) a) (ot-T d (ot-psi1 p d o))
          (subst (\ q -> Tr (allLt (G q d) a)) pk (ot4-mono p d a o ta h))))
    h ;

rem215d-om (e a p d : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (ta : TT a) (o : OK (psi p d))
  : Id Bool (inC (om e) a (psi p d)) (or (Y5 (om e) a p d) (X5 (om e) a p d)) =
  trans (inC-T (om e) a (psi p d) (ot-T (psi p d) o))
  (boolCases (Id Bool (allLt (G (om e) (psi p d)) a) (or (Y5 (om e) a p d) (X5 (om e) a p d))) (isI p)
    (\ hp -> trans (ap (\ M -> allLt M a)
                     (ifL-t (isI p) (ifL (le (om e) (psi p d)) (cons d (app (G (om e) p) (G (om e) d))) nil)
                        (ifL (le (om e) p) (cons d (app (G (om e) p) (G (om e) d))) nil) hp))
      (boolCases (Id Bool (allLt (ifL (le (om e) (psi p d)) (cons d (app (G (om e) p) (G (om e) d))) nil) a)
                          (or (Y5 (om e) a p d) (X5 (om e) a p d))) (le (om e) (psi p d))
        (\ hl -> trans (ap (\ M -> allLt M a) (ifL-t (le (om e) (psi p d)) (cons d (app (G (om e) p) (G (om e) d))) nil hl))
           (trans (full-eq (om e) a p d (ot-T p (ot-psi0 p d o)) (ot-T d (ot-psi1 p d o)))
              (sym (or-absorb (Y5 (om e) a p d) (X5 (om e) a p d)
                 (\ y -> abF (trans (sym (le-nlt (om e) (psi p d) (ot-T (om e) oe) (ot-T (psi p d) o) hl))
                    (orE (LT (psi p d) (om e)) (lt (psi p d) (om e)) (and (eqT (psi p d) (om e)) false)
                       (trans (sym (lex-TS p d (om e) a hp (refl false))) y) (\ q -> q)
                       (\ q -> abF (and-r (eqT (psi p d) (om e)) false q)))))))))
        (\ hl -> trans (ap (\ M -> allLt M a) (ifL-f (le (om e) (psi p d)) (cons d (app (G (om e) p) (G (om e) d))) nil hl))
           (sym (orIl (Y5 (om e) a p d) (X5 (om e) a p d)
              (trans (lex-TS p d (om e) a hp (refl false))
                 (orIl (lt (psi p d) (om e)) (and (eqT (psi p d) (om e)) false)
                    (nle-lt' (om e) (psi p d) (ot-T (om e) oe) (ot-T (psi p d) o) hl))))))))
    (\ hp -> trans (ap (\ M -> allLt M a)
                     (ifL-f (isI p) (ifL (le (om e) (psi p d)) (cons d (app (G (om e) p) (G (om e) d))) nil)
                        (ifL (le (om e) p) (cons d (app (G (om e) p) (G (om e) d))) nil) hp))
      (boolCases (Id Bool (allLt (ifL (le (om e) p) (cons d (app (G (om e) p) (G (om e) d))) nil) a)
                          (or (Y5 (om e) a p d) (X5 (om e) a p d))) (le (om e) p)
        (\ hl -> trans (ap (\ M -> allLt M a) (ifL-t (le (om e) p) (cons d (app (G (om e) p) (G (om e) d))) nil hl))
           (trans (full-eq (om e) a p d (ot-T p (ot-psi0 p d o)) (ot-T d (ot-psi1 p d o)))
              (sym (or-absorb (Y5 (om e) a p d) (X5 (om e) a p d)
                 (\ y -> orE (Tr (X5 (om e) a p d)) (lt p (om e)) (and (eqT p (om e)) (lt d a))
                    (trans (sym (lex-SS p d (om e) a hp (refl false))) y)
                    (\ q -> abF (trans (sym (le-nlt (om e) p (ot-T (om e) oe) (ot-T p (ot-psi0 p d o)) hl)) q))
                    (\ q -> x5-eq (om e) a p d (ot-T p (ot-psi0 p d o)) ta o
                              (eqT-sound p (om e) (and-l (eqT p (om e)) (lt d a) q)) (G-kk e oe hs)
                              (and-r (eqT p (om e)) (lt d a) q)))))))
        (\ hl -> trans (ap (\ M -> allLt M a) (ifL-f (le (om e) p) (cons d (app (G (om e) p) (G (om e) d))) nil hl))
           (sym (orIl (Y5 (om e) a p d) (X5 (om e) a p d)
              (trans (lex-SS p d (om e) a hp (refl false))
                 (orIl (lt p (om e)) (and (eqT p (om e)) (lt d a))
                    (nle-lt' (om e) p (ot-T (om e) oe) (ot-T p (ot-psi0 p d o)) hl)))))))) ) ;

rem215d-I (a p d : T) (ta : TT a) (o : OK (psi p d)) (cp : LT p ii -> Id Bool (inC ii a p) (lt p (psi ii a)))
  : Id Bool (inC ii a (psi p d)) (or (Y5 ii a p d) (X5 ii a p d)) =
  trans (inC-T ii a (psi p d) (ot-T (psi p d) o))
  (boolCases (Id Bool (allLt (G ii (psi p d)) a) (or (Y5 ii a p d) (X5 ii a p d))) (isI p)
    (\ hp -> trans (ap (\ M -> allLt M a)
                     (ifL-t (isI p) (cons d (app (G ii p) (G ii d)))
                        (ifL (le ii p) (cons d (app (G ii p) (G ii d))) (G ii p)) hp))
      (trans (full-eq ii a p d (ot-T p (ot-psi0 p d o)) (ot-T d (ot-psi1 p d o)))
         (sym (or-absorb (Y5 ii a p d) (X5 ii a p d)
            (\ y -> x5-eq ii a p d (ot-T p (ot-psi0 p d o)) ta o (isI-true p hp) (refl nil)
                      (trans (sym (lt-TT p d ii a hp (refl true))) y))))))
    (\ hp -> trans (ap (\ M -> allLt M a)
                     (ifL-f (isI p) (cons d (app (G ii p) (G ii d)))
                        (ifL (le ii p) (cons d (app (G ii p) (G ii d))) (G ii p)) hp))
      (boolCases (Id Bool (allLt (ifL (le ii p) (cons d (app (G ii p) (G ii d))) (G ii p)) a)
                          (or (Y5 ii a p d) (X5 ii a p d))) (le ii p)
        (\ hl -> trans (ap (\ M -> allLt M a) (ifL-t (le ii p) (cons d (app (G ii p) (G ii d))) (G ii p) hl))
           (trans (full-eq ii a p d (ot-T p (ot-psi0 p d o)) (ot-T d (ot-psi1 p d o)))
              (sym (or-absorb (Y5 ii a p d) (X5 ii a p d)
                 (\ y -> orE (Tr (X5 ii a p d)) (lt p (psi ii a)) (and (eqT p (psi ii a)) true)
                    (trans (sym (lex-ST p d ii a (ot-T (psi p d) o) hp (refl true))) y)
                    (\ q -> abF (trans (sym (lt-asym (psi ii a) p ta (ot-T p (ot-psi0 p d o))
                                (lt-le (psi ii a) ii p (tr3 (psi ii a) ii p ta (refl true) (ot-T p (ot-psi0 p d o)))
                                   (lt-TI ii a (refl true)) hl))) q))
                    (\ q -> abF (trans (sym (R-notpsi p (ot-psiR p d o) ii a)) (and-l (eqT p (psi ii a)) true q))))))))
        (\ hl -> trans (ap (\ M -> allLt M a) (ifL-f (le ii p) (cons d (app (G ii p) (G ii d))) (G ii p) hl))
           (sym (trans (ap2 (\ u v -> or u (and (and v (inC ii a d)) (lt d a)))
                          (trans (lex-ST p d ii a (ot-T (psi p d) o) hp (refl true))
                             (trans (ap (\ w -> or (lt p (psi ii a)) (and w true)) (R-notpsi p (ot-psiR p d o) ii a))
                                (trans (orF (lt p (psi ii a)))
                                   (sym (trans (sym (inC-T ii a p (ot-T p (ot-psi0 p d o))))
                                          (cp (nle-lt' ii p (refl true) (ot-T p (ot-psi0 p d o)) hl)))))))
                          (inC-T ii a p (ot-T p (ot-psi0 p d o))))
                    (or-and-absorb (allLt (G ii p) a) (inC ii a d) (lt d a))))))) ) ;

------------------------------------------------------------------------
-- (c)  b in OT, b <' k:  b in C_k(a)  iff  b <' psi_k a.
--
-- By induction on b.  0: both hold.  A sum: (b), and b <' psi_k a iff its
-- head is, which implies it for the tail (hd of the tail <=' head).
-- phi'_c d: (b) and (4), both for psi_k a and for k.  Omega'_c: (b);
-- if k /= I both sides hold (Omega'_c <' k gives Omega'_c <' psi_k a by
-- (6), and c <' Omega'_c); if k = I, (7) and (10) reduce it to c.  I: k /= I
-- and I <' psi_k a by (5).  psi_p d: by (d) it remains that p, d in C_k(a)
-- and d <' a give b <' psi_k a: by (5), from p <=' k (6) if p /= I (p = k with
-- d <' a; p <' k /= I; p <' k = I with p in C_I(a), so p <' psi_I a by the
-- hypothesis at p), and from psi_I d <' k, or d <' a when k = I.

Cs (k b : T) : U n = (a : T) -> TT a -> OK b -> LT b k -> Id Bool (inC k a b) (lt b (psi k a)) ;

tt-psik (k a : T) (tk : TT k) (hk : Tr (isR k)) (ta : TT a) : TT (psi k a) =
  andI (and (isR k) (isT k)) (isT a) (andI (isR k) (isT k) hk tk) ta ;

c-plus (k x0 xs : T) (tk : TT k) (hk : Tr (isR k)) (hA : Tr (isA k)) (c0 : Cs k x0) (cs : Cs k xs) : Cs k (plus x0 xs) =
  \ a ta o h ->
  trans (rem215b-plus k a x0 xs (ot-T (plus x0 xs) o))
   (trans (ap2 and
       (c0 a ta (ot-plus0 x0 xs o)
          (tr3 x0 (plus x0 xs) k (ot-T x0 (ot-plus0 x0 xs o)) (ot-T (plus x0 xs) o) tk (lt-head x0 xs (ot-plusA x0 xs o)) h))
       (cs a ta (ot-plusS x0 xs o)
          (trans (lt-hd xs k hA)
             (le-lt (hd xs) x0 k (tr3 (hd xs) x0 k (ot-T (hd xs) (hd-OK xs (ot-plusS x0 xs o))) (ot-T x0 (ot-plus0 x0 xs o)) tk)
                (ot-plusLe x0 xs o)
                (tr3 x0 (plus x0 xs) k (ot-T x0 (ot-plus0 x0 xs o)) (ot-T (plus x0 xs) o) tk (lt-head x0 xs (ot-plusA x0 xs o)) h)))))
     (and-absorb (lt x0 (psi k a)) (lt xs (psi k a))
        (\ q -> trans (lt-hd xs (psi k a) (refl true))
           (le-lt (hd xs) x0 (psi k a)
              (tr3 (hd xs) x0 (psi k a) (ot-T (hd xs) (hd-OK xs (ot-plusS x0 xs o))) (ot-T x0 (ot-plus0 x0 xs o)) (tt-psik k a tk hk ta))
              (ot-plusLe x0 xs o) q)))) ;

c-phi (k c d : T) (hG : Tr (isG k)) (cc : Cs k c) (cd : Cs k d) : Cs k (phi c d) = \ a ta o h ->
  trans (rem215b-phi k a c d (ot-T (phi c d) o))
   (trans (ap2 and (cc a ta (ot-phi0 c d o) (fg-elim c d k hG h).1) (cd a ta (ot-phi1 c d o) (fg-elim c d k hG h).2))
      (sym (lt-phiG c d (psi k a) (refl true)))) ;

-- kappa = Omega'_e

c-I-om (e : T) (oe : OK (om e)) : Cs (om e) ii = \ a ta o h ->
  sym (trans (lex-IS (om e) a (ot-T (om e) oe) (refl false)) (orIl (lt ii (om e)) (and (eqT ii (om e)) false) h)) ;

c-om-om (e c : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (cc : Cs (om e) c) : Cs (om e) (om c) = \ a ta o h ->
  trans (rem215b-om (om e) a c (ot-T (om c) o))
   (trans (cc a ta (ot-om0 c o) (tr3 c (om c) (om e) (ot-T c (ot-om0 c o)) (ot-T (om c) o) (ot-T (om e) oe) (lt-om c (ot-om0 c o)) h))
     (trans (tr3 c (om c) (psi (om e) a) (ot-T c (ot-om0 c o)) (ot-T (om c) o) (tt-psik (om e) a (ot-T (om e) oe) hs ta)
               (lt-om c (ot-om0 c o))
               (trans (lex-OS c (om e) a (ot-T (om c) o) (ot-T (om e) oe) (refl false))
                  (orIl (lt (om c) (om e)) (and (eqT (om c) (om e)) false) h)))
        (sym (trans (lex-OS c (om e) a (ot-T (om c) o) (ot-T (om e) oe) (refl false))
                (orIl (lt (om c) (om e)) (and (eqT (om c) (om e)) false) h))))) ;

c-psi-om (e p d : T) (oe : OK (om e)) (hs : Tr (isSuc e)) : Cs (om e) (psi p d) = \ a ta o h ->
  trans (rem215d-om e a p d oe hs ta o)
    (or-absorb-r (Y5 (om e) a p d) (X5 (om e) a p d)
       (\ x -> boolCases (Tr (Y5 (om e) a p d)) (isI p)
          (\ hp -> trans (lex-TS p d (om e) a hp (refl false))
                     (orIl (lt (psi p d) (om e)) (and (eqT (psi p d) (om e)) false) h))
          (\ hp -> trans (lex-SS p d (om e) a hp (refl false))
                     (orE (Tr (or (lt p (om e)) (and (eqT p (om e)) (lt d a)))) (lt p (om e)) (and (eqT p (om e)) true)
                        (trans (sym (lex-SO p d e hp)) h)
                        (\ q -> orIl (lt p (om e)) (and (eqT p (om e)) (lt d a)) q)
                        (\ q -> orIr (lt p (om e)) (and (eqT p (om e)) (lt d a))
                                  (andI (eqT p (om e)) (lt d a) (and-l (eqT p (om e)) true q)
                                     (and-r (and (inC (om e) a p) (inC (om e) a d)) (lt d a) x))))))) ;

cs-om (e : T) (oe : OK (om e)) (hs : Tr (isSuc e)) : (b : T) -> Cs (om e) b = split {
  zero -> \ a ta o h -> refl true ;
  plus x0 xs | c0 cs -> c-plus (om e) x0 xs (ot-T (om e) oe) hs (refl true) c0 cs ;
  phi c d | cc cd -> c-phi (om e) c d (refl true) cc cd ;
  psi p d -> c-psi-om e p d oe hs ;
  om c | cc -> c-om-om e c oe hs cc ;
  ii -> c-I-om e oe } ;

-- kappa = I

c-om-I (c : T) (cc : Cs ii c) : Cs ii (om c) = \ a ta o h ->
  trans (rem215b-om ii a c (ot-T (om c) o))
   (trans (cc a ta (ot-om0 c o)
             (orE (LT c ii) (lt c ii) (and (eqT c ii) false) (trans (sym (lex-OI c)) h) (\ q -> q)
                (\ q -> abF (and-r (eqT c ii) false q))))
      (sym (trans (lex-OT c ii a (ot-T c (ot-om0 c o)) ta (refl true)) (orAF (lt c (psi ii a)) (eqT c (psi ii a)))))) ;

c-psi-I (p d : T) (cp : Cs ii p) : Cs ii (psi p d) = \ a ta o h ->
  trans (rem215d-I a p d ta o (\ hp -> cp a ta (ot-psi0 p d o) hp))
    (or-absorb-r (Y5 ii a p d) (X5 ii a p d)
       (\ x -> boolCases (Tr (Y5 ii a p d)) (isI p)
          (\ hp -> trans (lt-TT p d ii a hp (refl true)) (and-r (and (inC ii a p) (inC ii a d)) (lt d a) x))
          (\ hp -> trans (lex-ST p d ii a (ot-T (psi p d) o) hp (refl true))
             (orIl (lt p (psi ii a)) (and (eqT p (psi ii a)) true)
                (trans (sym (cp a ta (ot-psi0 p d o)
                    (orE (LT p ii) (lt p ii) (and (eqT p ii) true) (trans (sym (lex-SI p d hp)) h) (\ q -> q)
                       (\ q -> abF (trans (sym (ne-II p ii hp (refl true))) (and-l (eqT p ii) true q))))))
                   (and-l (inC ii a p) (inC ii a d) (and-l (and (inC ii a p) (inC ii a d)) (lt d a) x))))))) ;

cs-I : (b : T) -> Cs ii b = split {
  zero -> \ a ta o h -> refl true ;
  plus x0 xs | c0 cs -> c-plus ii x0 xs (refl true) (refl true) (refl true) c0 cs ;
  phi c d | cc cd -> c-phi ii c d (refl true) cc cd ;
  psi p d | cp _ -> c-psi-I p d cp ;
  om c | cc -> c-om-I c cc ;
  ii -> \ a ta o h -> abF (trans (sym (lt-irr ii)) h) } ;

-- (c) and (d) for kappa in R n OT
rem215c (k : T) (ok : OK k) (hR : Tr (isR k)) : (b : T) -> Cs k b =
  boolCases ((b : T) -> Cs k b) (isI k)
    (\ hk -> subst (\ q -> (b : T) -> Cs q b) (sym (isI-true k hk)) cs-I)
    (\ hk -> subst (\ q -> (b : T) -> Cs q b) (sym (R-cases k hR hk).1)
               (cs-om (arg k) (subst (\ q -> OK q) (R-cases k hR hk).1 ok) (R-cases k hR hk).2)) ;

rem215d (k a p d : T) (ok : OK k) (hR : Tr (isR k)) (ta : TT a) (o : OK (psi p d))
  : Id Bool (inC k a (psi p d)) (or (Y5 k a p d) (X5 k a p d)) =
  boolCases (Id Bool (inC k a (psi p d)) (or (Y5 k a p d) (X5 k a p d))) (isI k)
    (\ hk -> subst (\ q -> Id Bool (inC q a (psi p d)) (or (Y5 q a p d) (X5 q a p d))) (sym (isI-true k hk))
               (rem215d-I a p d ta o (\ hp -> cs-I p a ta (ot-psi0 p d o) hp)))
    (\ hk -> subst (\ q -> Id Bool (inC q a (psi p d)) (or (Y5 q a p d) (X5 q a p d))) (sym (R-cases k hR hk).1)
               (rem215d-om (arg k) a p d (subst (\ q -> OK q) (R-cases k hR hk).1 ok) (R-cases k hR hk).2 ta o)) ;

------------------------------------------------------------------------
-- (e)  kappa = Omega'_e /= I, b = psi_p d in OT:
--      b in C_kappa(a)  iff  b <=' kappa^-  or  (p, d in C_kappa(a) and d <' a).
--
-- From (d): b <=' kappa^- gives b <' psi_kappa a (kappa^- <' psi_kappa a).
-- Conversely b <' psi_kappa a is, by (5): psi_I d <' kappa (p = I), or
-- p <' kappa, or p = kappa and d <' a (then the second disjunct, as in (d)).
--   psi_I d <' Omega'_e:  psi_I d <=' e by (7), so psi_I d <=' hd(e) <=' pred1(e),
--     and then <=' Omega_{pred1 e} = kappa^- (omF-le).  (e = 1 is impossible.)
--   p = Omega'_t <' Omega'_e:  t <' e, so t <=' pred1(e) (lt-succ), and
--     Omega'_t <=' Omega_{pred1 e} (om-le-omF; t /= pred1 e when the latter is
--     in Fi, as t in Suc');  and psi_p d <' p.
-- lt-succ: x <' s+1 => x <=' s, by induction on s+1, using that nothing in T'
-- other than 0 is below 1 (one-min).

lt-zero : (x : T) -> Id Bool (lt x zero) false = split {
  zero -> refl false ; plus x0 xs -> refl false ; phi x0 x1 -> refl false ;
  psi x0 x1 -> refl false ; om x0 -> refl false ; ii -> refl false } ;

zero-le : (y : T) -> Id Bool (isZero y) false -> Tr (le zero y) = split {
  zero -> \ h -> abT h ; plus x0 xs -> \ h -> refl true ; phi x0 x1 -> \ h -> refl true ;
  psi x0 x1 -> \ h -> refl true ; om x0 -> \ h -> refl true ; ii -> \ h -> refl true } ;

one-eq-phi : (x0 x1 : T) -> Tr (and (isZero x0) (isZero x1)) -> Id T (phi x0 x1) (phi zero zero) = split {
  zero -> split {
    zero -> \ h -> refl (phi zero zero) ;
    plus y0 ys -> \ h -> abF h ; phi y0 y1 -> \ h -> abF h ; psi y0 y1 -> \ h -> abF h ;
    om y0 -> \ h -> abF h ; ii -> \ h -> abF h } ;
  plus y0 ys -> \ x1 h -> abF h ; phi y0 y1 -> \ x1 h -> abF h ; psi y0 y1 -> \ x1 h -> abF h ;
  om y0 -> \ x1 h -> abF h ; ii -> \ x1 h -> abF h } ;
one-eq : (c : T) -> Tr (isOne c) -> Id T c (phi zero zero) = split {
  zero -> \ h -> abF h ; plus x0 xs -> \ h -> abF h ; phi x0 x1 -> \ h -> one-eq-phi x0 x1 h ;
  psi x0 x1 -> \ h -> abF h ; om x0 -> \ h -> abF h ; ii -> \ h -> abF h } ;

-- nothing in T' but 0 is below 1
one-min1 (c d : T) : Id Bool (or (or (ph3A c d zero zero) (ph3B c d zero zero)) (ph3C c d zero zero))
                             (or (or false (and (eqT c zero) false)) (and (lt zero c) false)) =
  ap2 (\ u v -> or (or (and u (lt d (phi zero zero))) (and (eqT c zero) v)) (and (lt zero c) false)) (lt-zero c) (lt-zero d) ;
one-min2 (c : T) : Id Bool (or (or false (and (eqT c zero) false)) (and (lt zero c) false)) false =
  ap2 (\ u v -> or (or false u) v) (andF (eqT c zero)) (andF (lt zero c)) ;
one-min : (y : T) -> TT y -> Id Bool (isZero y) false -> Id Bool (lt y (phi zero zero)) false = split {
  zero -> \ t nz -> abT nz ;
  plus y0 ys | r0 _ -> \ t nz -> r0 (isT-plus0 y0 ys t) (A-nz y0 (isT-plusA y0 ys t)) ;
  phi c d -> \ t nz -> trans (lt-phiphi c d zero zero) (trans (one-min1 c d) (one-min2 c)) ;
  psi x0 x1 -> \ t nz -> refl false ; om x0 -> \ t nz -> refl false ; ii -> \ t nz -> refl false } ;

tail-nz (y0 ys : T) (t : TT (plus y0 ys)) : Id Bool (isZero ys) false =
  not-true (isZero ys) (and-l (not (isZero ys)) (isT ys) (and-r (and (isA y0) (isT y0)) (and (not (isZero ys)) (isT ys)) t)) ;

-- x <' (x0, 1) => x <=' x0
ls-one (x0 xs : T) (hA : Tr (isA x0)) (ho : Tr (isOne xs)) : (x : T) -> TT x -> LT x (plus x0 xs) -> Tr (le x x0) = split {
  zero -> \ tx h -> zero-le x0 (A-nz x0 hA) ;
  plus y0 ys -> \ tx h ->
    orE (Tr (le (plus y0 ys) x0)) (lt y0 x0) (and (eqT y0 x0) (lt ys xs)) (trans (sym (lex-PP y0 ys x0 xs)) h)
      (\ q -> le-of-lt (plus y0 ys) x0 (trans (lt-hd (plus y0 ys) x0 hA) q))
      (\ q -> abF (trans (sym (one-min ys (isT-plusS y0 ys tx) (tail-nz y0 ys tx)))
                    (subst (\ u -> LT ys u) (one-eq xs ho) (and-r (eqT y0 x0) (lt ys xs) q)))) ;
  phi c d -> \ tx h -> h ; psi c d -> \ tx h -> h ; om c -> \ tx h -> h ; ii -> \ tx h -> h } ;

-- x <' (x0, xs) and (x <' xs => x <=' p) give x <=' (x0, p)
ls-step (x0 xs p : T) (ih : (x : T) -> TT x -> LT x xs -> Tr (le x p))
  : (x : T) -> TT x -> LT x (plus x0 xs) -> Tr (le x (plus x0 p)) = split {
  zero -> \ tx h -> refl true ;
  plus y0 ys -> \ tx h ->
    orE (Tr (le (plus y0 ys) (plus x0 p))) (lt y0 x0) (and (eqT y0 x0) (lt ys xs)) (trans (sym (lex-PP y0 ys x0 xs)) h)
      (\ q -> le-of-lt (plus y0 ys) (plus x0 p)
                (trans (lex-PP y0 ys x0 p) (orIl (lt y0 x0) (and (eqT y0 x0) (lt ys p)) q)))
      (\ q -> orE (Tr (le (plus y0 ys) (plus x0 p))) (lt ys p) (eqT ys p)
                (ih ys (isT-plusS y0 ys tx) (and-r (eqT y0 x0) (lt ys xs) q))
                (\ r -> le-of-lt (plus y0 ys) (plus x0 p)
                          (trans (lex-PP y0 ys x0 p) (orIr (lt y0 x0) (and (eqT y0 x0) (lt ys p))
                             (andI (eqT y0 x0) (lt ys p) (and-l (eqT y0 x0) (lt ys xs) q) r))))
                (\ r -> le-of-eq (plus y0 ys) (plus x0 p) (andI (eqT y0 x0) (eqT ys p) (and-l (eqT y0 x0) (lt ys xs) q) r))) ;
  phi c d -> \ tx h -> le-of-lt (phi c d) (plus x0 p) h ;
  psi c d -> \ tx h -> le-of-lt (psi c d) (plus x0 p) h ;
  om c -> \ tx h -> le-of-lt (om c) (plus x0 p) h ;
  ii -> \ tx h -> le-of-lt ii (plus x0 p) h } ;

lt-succ : (e : T) -> TT e -> Tr (isSuc e) -> Id Bool (isOne e) false -> (x : T) -> TT x -> LT x e -> Tr (le x (pred1 e)) = split {
  zero -> \ te hs ho x tx h -> abF hs ;
  plus x0 xs | _ ih -> \ te hs ho x tx h ->
    boolCases (Tr (le x (pred1 (plus x0 xs)))) (isOne xs)
      (\ o -> subst (\ s -> Tr (le x s)) (sym (ifT-t (isOne xs) x0 (plus x0 (pred1 xs)) o))
                (ls-one x0 xs (isT-plusA x0 xs te) o x tx h))
      (\ o -> subst (\ s -> Tr (le x s)) (sym (ifT-f (isOne xs) x0 (plus x0 (pred1 xs)) o))
                (ls-step x0 xs (pred1 xs) (ih (isT-plusS x0 xs te) hs o) x tx h)) ;
  phi x0 x1 -> \ te hs ho x tx h -> abF (trans (sym ho) hs) ;
  psi x0 x1 -> \ te hs ho x tx h -> abF hs ; om x0 -> \ te hs ho x tx h -> abF hs ;
  ii -> \ te hs ho x tx h -> abF hs } ;

le-suc-lt (t s : T) (h : Tr (le t s)) (ht : Tr (isSuc t)) (hn : Id Bool (isSuc s) false) : LT t s =
  orE (LT t s) (lt t s) (eqT t s) h (\ p -> p)
    (\ e -> abF (trans (sym hn) (subst (\ u -> Tr (isSuc u)) (eqT-sound t s e) ht))) ;

om-mono (t s : T) (h : Tr (le t s)) : Tr (le (om t) (om s)) =
  orE (Tr (le (om t) (om s))) (lt t s) (eqT t s) h
    (\ p -> le-of-lt (om t) (om s) (trans (lex-OO t s) (orIl (lt t s) (and (eqT t s) false) p)))
    (\ e -> le-of-eq (om t) (om s) e) ;

-- t in Suc', t <=' s:  Omega'_t <=' Omega_s
om-le-omF : (s t : T) -> TT t -> TT s -> Tr (isSuc t) -> Tr (le t s) -> Tr (le (om t) (omF s)) = split {
  zero -> \ t tt ts ht h -> abF (trans (sym (lt-zero t)) (le-suc-lt t zero h ht (refl false))) ;
  plus x0 xs -> \ t tt ts ht h -> om-mono t (plus x0 xs) h ;
  phi x0 x1 -> \ t tt ts ht h -> om-mono t (phi x0 x1) h ;
  psi q c -> \ t tt ts ht h -> boolCases (Tr (le (om t) (omF (psi q c)))) (isI q)
    (\ hq -> subst (\ u -> Tr (le (om t) u)) (sym (ifT-t (isI q) (psi q c) (om (psi q c)) hq))
               (le-of-lt (om t) (psi q c)
                  (trans (lex-OT t q c tt ts hq)
                     (orIl (lt t (psi q c)) (and (eqT t (psi q c)) false) (le-suc-lt t (psi q c) h ht (refl false))))))
    (\ hq -> subst (\ u -> Tr (le (om t) u)) (sym (ifT-f (isI q) (psi q c) (om (psi q c)) hq)) (om-mono t (psi q c) h)) ;
  om a -> \ t tt ts ht h -> om-mono t (om a) h ;
  ii -> \ t tt ts ht h -> le-of-lt (om t) ii
          (trans (lex-OI t) (orIl (lt t ii) (and (eqT t ii) false) (le-suc-lt t ii h ht (refl false)))) } ;

km-T (e : T) (te : TT e) (hs : Tr (isSuc e)) : TT (kminus (om e)) =
  boolCases (TT (kminus (om e))) (isOne e)
    (\ o -> subst (\ s -> TT (omF s)) (sym (one-pred e o)) (refl true))
    (\ o -> omF-T (pred1 e) (pred-lt e te hs o).2.1) ;

le-hd-psi (p d : T) : (e : T) -> Tr (le (psi p d) e) -> Tr (le (psi p d) (hd e)) = split {
  zero -> \ h -> h ;
  plus x0 xs -> \ h -> trans (sym (orF (le (psi p d) x0))) h ;
  phi x0 x1 -> \ h -> h ; psi x0 x1 -> \ h -> h ; om x0 -> \ h -> h ; ii -> \ h -> h } ;

-- psi_I d <' Omega'_e  =>  psi_I d <=' kappa^-
w-I (e p d : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (o : OK (psi p d)) (hp : Id Bool (isI p) true)
  (h : LT (psi p d) (om e)) : Tr (le (psi p d) (kminus (om e))) =
  boolCases (Tr (le (psi p d) (kminus (om e)))) (isOne e)
    (\ ho -> abF (subst (\ u -> Tr (le (psi p d) u)) (one-eq e ho)
                 (trans (sym (orAT (lt (psi p d) e) (eqT (psi p d) e))) (trans (sym (lex-TO p d e hp)) h))))
    (\ ho -> omF-le (pred1 e) (psi p d) (k-main (psi p d) o).1 (pred-lt e (ot-T e (ot-om0 e oe)) hs ho).2.1
       (le-trans (psi p d) (hd e) (pred1 e)
          (tr3 (psi p d) (hd e) (pred1 e) (ot-T (psi p d) o) (ot-T (hd e) (hd-OK e (ot-om0 e oe)))
             (pred-lt e (ot-T e (ot-om0 e oe)) hs ho).2.1)
          (le-hd-psi p d e (trans (sym (orAT (lt (psi p d) e) (eqT (psi p d) e))) (trans (sym (lex-TO p d e hp)) h)))
          (pred-lt e (ot-T e (ot-om0 e oe)) hs ho).2.2.1)) ;

-- p = Omega'_t:  t in T', and p <' Omega'_e gives t <' e
w-tT (p d : T) (o : OK (psi p d)) (hp : Id Bool (isI p) false) : TT (arg p) =
  isT-om0 (arg p) (subst (\ q -> TT q) (R-cases p (ot-psiR p d o) hp).1 (ot-T p (ot-psi0 p d o))) ;
w-tlt (e p d : T) (o : OK (psi p d)) (hp : Id Bool (isI p) false) (h : LT p (om e)) : LT (arg p) e =
  orE (LT (arg p) e) (lt (arg p) e) (and (eqT (arg p) e) false)
    (trans (sym (lex-OO (arg p) e)) (subst (\ q -> LT q (om e)) (R-cases p (ot-psiR p d o) hp).1 h))
    (\ q -> q) (\ q -> abF (and-r (eqT (arg p) e) false q)) ;

-- p <' Omega'_e, p /= I  =>  psi_p d <=' kappa^-
w-S (e p d : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (o : OK (psi p d)) (hp : Id Bool (isI p) false)
  (h : LT p (om e)) : Tr (le (psi p d) (kminus (om e))) =
  boolCases (Tr (le (psi p d) (kminus (om e)))) (isOne e)
    (\ ho -> abF (trans (sym (one-min (arg p) (w-tT p d o hp) (not-true (isZero (arg p)) (suc-nz (arg p) (R-cases p (ot-psiR p d o) hp).2))))
                   (subst (\ u -> LT (arg p) u) (one-eq e ho) (w-tlt e p d o hp h))))
    (\ ho -> le-of-lt (psi p d) (kminus (om e))
       (lt-le (psi p d) p (kminus (om e))
          (tr3 (psi p d) p (kminus (om e)) (ot-T (psi p d) o) (ot-T p (ot-psi0 p d o)) (km-T e (ot-T e (ot-om0 e oe)) hs))
          (subst (\ q -> LT (psi p d) q) (sym (R-cases p (ot-psiR p d o) hp).1)
             (trans (lex-SO p d (arg p) hp)
                (orIr (lt p (om (arg p))) (and (eqT p (om (arg p))) true)
                   (andI (eqT p (om (arg p))) true
                      (subst (\ q -> Tr (eqT p q)) (R-cases p (ot-psiR p d o) hp).1 (eqT-refl p)) (refl true)))))
          (subst (\ q -> Tr (le q (kminus (om e)))) (sym (R-cases p (ot-psiR p d o) hp).1)
             (om-le-omF (pred1 e) (arg p) (w-tT p d o hp) (pred-lt e (ot-T e (ot-om0 e oe)) hs ho).2.1
                (R-cases p (ot-psiR p d o) hp).2
                (lt-succ e (ot-T e (ot-om0 e oe)) hs ho (arg p) (w-tT p d o hp) (w-tlt e p d o hp h)))))) ;

or-cong-imp : (y y' x : Bool) -> (Tr y -> Tr (or y' x)) -> (Tr y' -> Tr y) -> Id Bool (or y x) (or y' x) = split {
  true -> \ y' x h1 h2 -> sym (h1 (refl true)) ;
  false -> split {
    true -> \ x h1 h2 -> abF (h2 (refl true)) ;
    false -> \ x h1 h2 -> refl x } } ;

rem215e (e a p d : T) (oe : OK (om e)) (hs : Tr (isSuc e)) (ta : TT a) (o : OK (psi p d))
  : Id Bool (inC (om e) a (psi p d)) (or (le (psi p d) (kminus (om e))) (X5 (om e) a p d)) =
  trans (rem215d-om e a p d oe hs ta o)
    (or-cong-imp (Y5 (om e) a p d) (le (psi p d) (kminus (om e))) (X5 (om e) a p d)
       (\ y -> boolCases (Tr (or (le (psi p d) (kminus (om e))) (X5 (om e) a p d))) (isI p)
          (\ hp -> orIl (le (psi p d) (kminus (om e))) (X5 (om e) a p d)
             (w-I e p d oe hs o hp
                (orE (LT (psi p d) (om e)) (lt (psi p d) (om e)) (and (eqT (psi p d) (om e)) false)
                   (trans (sym (lex-TS p d (om e) a hp (refl false))) y) (\ q -> q)
                   (\ q -> abF (and-r (eqT (psi p d) (om e)) false q)))))
          (\ hp -> orE (Tr (or (le (psi p d) (kminus (om e))) (X5 (om e) a p d))) (lt p (om e)) (and (eqT p (om e)) (lt d a))
             (trans (sym (lex-SS p d (om e) a hp (refl false))) y)
             (\ q -> orIl (le (psi p d) (kminus (om e))) (X5 (om e) a p d) (w-S e p d oe hs o hp q))
             (\ q -> orIr (le (psi p d) (kminus (om e))) (X5 (om e) a p d)
                       (x5-eq (om e) a p d (ot-T p (ot-psi0 p d o)) ta o
                          (eqT-sound p (om e) (and-l (eqT p (om e)) (lt d a) q)) (G-kk e oe hs)
                          (and-r (eqT p (om e)) (lt d a) q)))))
       (\ y' -> le-lt (psi p d) (kminus (om e)) (psi (om e) a)
          (tr3 (psi p d) (kminus (om e)) (psi (om e) a) (ot-T (psi p d) o) (km-T e (ot-T e (ot-om0 e oe)) hs)
             (tt-psik (om e) a (ot-T (om e) oe) hs ta))
          y' ((km-lt e (ot-T e (ot-om0 e oe)) hs).2 a))) ;

-- (e) for kappa in R n OT, kappa /= I
rem215e-R (k a p d : T) (ok : OK k) (hR : Tr (isR k)) (hk : Id Bool (isI k) false) (ta : TT a) (o : OK (psi p d))
  : Id Bool (inC k a (psi p d)) (or (le (psi p d) (kminus k)) (X5 k a p d)) =
  subst (\ q -> Id Bool (inC q a (psi p d)) (or (le (psi p d) (kminus q)) (X5 q a p d))) (sym (R-cases k hR hk).1)
    (rem215e (arg k) a p d (subst (\ q -> OK q) (R-cases k hR hk).1 ok) (R-cases k hR hk).2 ta o) ;
