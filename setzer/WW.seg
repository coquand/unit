-- WW.seg: Setzer (APAL 92, 1998), Section 4.5, the union of all distinguished
-- sets: Definition 4.25 - Lemma 4.31, pp. 147-148.  The mirror is tools/otww.py
-- (lem 6: 65 terms, 66 distinguished sets; 2082 sets for 4.26(a), 93665
-- triples for the bound; no failures.  On these pools every term is in WW, so
-- the membership statements of 4.29 - 4.31 are weak tests there; proof 6 tests
-- the steps of 4.30, 4.31 with any distinguished set D in place of WW: d~ in
-- C^d(D) for d in M(D) (4178), Omega_s in C^b(D) => s in C^b(D) (149730),
-- Omega_a in M(D) (304), psi_I x in D => x+1 in C^{psi_I(x+1)}(D) (450), and the
-- ordinal side conditions; no failures.)
--
-- Sizes.  Setzer: P(N) = the sets (N -> U), Cl(N) = the classes, and
--   WW = U {X : P(N) | Ag(X)}
-- quantifies over sets, so WW is a class.  Here sets are SC.Cl = T -> U ul and
-- classes Cl = T -> U (ul+): the files of Section 4 are opened at ul+ (classes)
-- and their instances at ul are SC = CA[ul], SW = WA[ul], SG = Ag[ul] (sets).
-- Both instances talk about the same terms: T and every function on T (lt,
-- isOT, add, phiF, omF, tilde, up, cat, ...) are declared in OT.seg with no
-- level in scope, so they are one constant at every level (a declaration's
-- arguments include every level in scope at it; this is why OT.seg is
-- level-free, as Base.seg of the core).  The predicates LT, OK, Cap, Bar of the
-- two instances are equal by definition (Tr b = Id Bool b true at every level).
-- What is not shared is what each level builds: the data Or and the W-type of
-- WA, hence C^a(X), W(X) and Ag(X).  In ML1W, W(X) for X : P(N) is the same
-- whether X is read as a set or as a class; here it is a lemma:
--   (L1) X a set:  C^a(X) as a set = C^a(X) as a class          lc
--        (induction on d: both satisfy the clauses of 4.4)
--   (L2) W(X) as a set = W(X) as a class                        lw-up, lw-dn
--        (set -> class: recursion on the tree, with 4.10(a) for the class;
--         class -> set: Ind(x in W(X)) (4.11) for the class, with 4.10(a)
--         for the set; tau and M correspond by (L1))
--   (L3) Ag(X) as a set iff Ag(X) as a class                    ag-up, ag-dn
-- A set X, as a class, is Lf X (Lf X y = X y: functions T -> U ul are not
-- functions T -> U (ul+), only their values are lifted).
--
-- Definition 4.25.  WW = {y | y in X for some set X with Ag(X)}.     WW
--   (Ag(X) as a set; ww-mk, ww-ag take it as a class, by (L3).)
--
-- Lemma 4.26.  (a) X a set: Ag(X) <-> X [= WW.          ww-seg, ww-ag-set
--   (b) B a class, B [= WW => Ag(B).                     ww-ag-cl
--   Uniqueness (from 4.24; agree):  Ag(A), Ag(B), a in A, b in B, c in OT,
--   c <=' a, c <=' b  =>  A|c = B|c.  A' = A|c is A' = W(A') n (c+1): for
--   y <=' c, A' n y = A n y, so W(A') and W(A) agree up to c (transfer,
--   wa-at), and W(A) n (c+1) = A n (c+1) (A|a = W(A)|a, c <=' a).  The same
--   for B' = B|c; 4.24 with a_0 = a_1 = c+1 gives A' = B' n (c+1) = B'.
--   (Setzer: X' = X|b, B' = B|b, "by 4.13(b) W(X')|b = W(X)|b = X|b = X'",
--   and 4.24.)
--   Transfer at a bar (wbar):  A, B c OT, a in OT, A n a = B n a  =>
--   W(A)|a = W(B)|a  (wa-at both ways at z = a; y <' a+1 iff y <=' a).
--   (a) "->": X c OT.  For a in X and y <=' a: y in X gives y in WW (X is a
--   witness).  y in WW gives a set B, Ag(B), y in B; agree at c = y (y <=' a,
--   y <=' y) gives X|y = B|y, and y in B|y, so y in X.
--   (b) Let a in B.  a in WW: a in D, D a set, Ag(D).  B|a = WW|a (B [= WW)
--   = D|a ((a) for D) = W(D)|a (Ag(D)) = W(B)|a (wbar: B n a = D n a, the
--   first two equalities restricted to a).  So B [= W(B): Ag(B).
--   (a) "<-": (b) for the class Lf X, then (L3).
-- Lemma 4.27.  Ag(WW).                                       ag-ww
--   (b) with WW [= WW (WW c OT: each witness is c OT).
-- Lemma 4.28.  (a) A a class, every x in A is in a set Y with Ag(Y), Y c A
--   => Ag(A).                                                rem428a
--   A c OT (x in Y c OT); A [= WW: for x in A, y <=' x: y in A gives y in WW
--   (its own Y); y in WW gives y in Y_x ((a) "->" for Y_x, at x), so y in A.
--   Then 4.26(b).  (Setzer: "Y [= WW, WW|x = Y|x c A|x c WW|x".)
--   (b) A a class, y in OT, Ag(A) => Ag(A n y).               rem428b
--   For a in A n y: (A n y)|a = A|a (a <' y) = W(A)|a (Ag(A)) = W(A n y)|a
--   (wbar: A n a = (A n y) n a).
-- Lemma 4.29.  (a) WW is downward closed and upward closed bounded by WW
--   (by Dn(WW), as in 4.23(a)).                              rem429a
--   4.23(a) at WW, by 4.27.
--   (c') m in WW => m+ in WW.                                 ww-up
--   m in A, A a set with Ag(A): Ag(A+), m+ in A+ (4.23(c) for the set A).
--   (c) x in OT, Omega_x in WW => Omega_{x+1} in WW.          rem429c
--   (Omega_x)+ = Omega_{x+1} (up-omF), then (c').
--   (b) y, z in WW, x in OT, x = y + z, phi_y z (Def. 2.10), or psi_y z
--   => x in WW.                                               rem429b-sum, -phi, -psi
--   Setzer: A u B with Ag(A), Ag(B), C = (A u B)+, "x <=' C, x in C c WW"
--   (printed "z <=' C, z in C").  Here, shorter: m = max{y, z} in WW, m+ in WW
--   (c'), and x <' m+ (the bound), so x in WW by (a); psi_y z in OT gives y in
--   R and z in C_y(z), so psi_y z in WW by 4.23(b) at WW.
--   The bound (Setzer leaves it to the reader):  y, z <=' m (in OT), x = y + z
--   or phi_y z in OT  =>  x <' m+.  card(x) is card(y) or card(z): a sum has
--   the card values of its head (Def. 2.13(b)), and y + z is y, z, or a sum
--   with head that of y; phi_y z is z, y, or phi'_y z, whose values are those
--   of max{y, z} (card-add, card-phi).  So x+ is y+ or z+, <=' m+ (2.14(b)),
--   and x <' x+ (2.14(f)).
--
-- Lemma 4.30.  a in M(WW), a <' I, B a set, B c WW|a, every y in tau^WW(a)
--   is <=' some x in B  =>  a in WW.                          rem430
--   (H430 bundles the hypotheses.)  Setzer chooses g : B^ -> P(N) with Ag(g p),
--   p.1 in g p; here g p = ww-set (the set of p.1 in WW), no choice.
--   (1) C = U_{p : B^} (g p n a), a set (Cs).  Ag(C) by 4.28(a): y in C is in
--       Y = g p n a, Ag(Y) by 4.28(b) (as a set: cap-ag), Y c C.     ag-cs
--   (2) tau^WW(a) c WW: y <=' x in B, x <=' a.  y = x, or y <' x and then
--       y in tau^WW(a) n x c tau^WW(x) (4.9(a)) = WW n x (4.20).     tau-ww
--   (3) C = WW n a.  "c": g p c WW.  "o": y in WW n a is in tau^WW(a) (4.7(h)),
--       y <=' x for an x in B; x in g p (p = (x, _)), g p|x = WW|x (4.26(a)), so
--       y in g p n a.                                            cs-eq
--   (4) W(C) n a c C (Setzer: by Ind(d in W(C)); the induction hypothesis is not
--       needed).  Let d in W(C), d <' a.  d in M(C) (4.13(a)); C^d(C) is
--       downward closed (4.16(a): C n d~ weakly downward closed, as C is
--       distinguished, 4.23(a)), so d~ in C^d(C).  d~ <=' d <=' a and
--       d^{-I} = a^{-I} = 0 (d, a <' I): 4.7(g) gives d~ in C^a(C), = C^a(WW)
--       (4.7(c'): C n a = WW n a, ca-cap); d~ <' a, so d~ in tau^WW(a) c WW (2).
--       d+ = (d~)+ (2.14(e)) is in WW (4.29(c')).  C n d = WW n d, so
--       d in W(WW) (transfer at d, wa-at), and WW n d+ = W(WW) n d+ (WW
--       distinguished, d+ in WW): d in WW n a = C.                wc-c
--       (Setzer: "C|d = WW|d = W(WW)|d = W(C)|d"; the same chain.)
--   (5) C' = C u {a} (Cp).  C' n a = C n a = WW n a.  a in M(C'): C^a(C') =
--       C^a(WW) (ca-cap) and a in M(WW).  tau^C'(a) = tau^WW(a) c WW n a = C
--       c W(C) (2, 3), and W(C) n a = W(C') n a (transfer at a both ways), so
--       a in W(C') (4.10(a)).  C' = W(C') n (a+1): y in W(C'), y <=' a is a, or
--       y <' a and y in W(C) n a c C (4).  So Ag(C') (eq-ag), and a in C' c WW.
--   0 in WW (ww-zero): 4.30 at a = 0 with B empty (tau^WW(0) is empty).
-- Lemma 4.31.  (a) x in WW, x <' I => Omega_x in WW.          rem431a
--   By Ind(a in WW) (4.21(a)) of P(a) = (a <' I => Omega_a in WW).  Let a in WW,
--   P on WW n a, a <' I.  If a is 0 or in Fi, Omega_a = a (omF-fix).  Otherwise
--   Omega_a = Omega'_a (omF-mov).  Let A = ww-set a (a set, Ag(A), a in A) and
--   B = {Omega_{y+1} | y in A n a} (a set; Setzer: y in tau^A(a) = A n a, 4.20).
--   - B c WW|Omega_a: y in A n a is in WW n a, y <' I, so Omega_y in WW (P(y)) and
--     Omega_{y+1} in WW (4.29(c)); y+1 <=' a (y <' a), so Omega_{y+1} <=' Omega_a
--     (2.12(g)).
--   - tau^WW(Omega_a) <=' B: let y in tau^WW(Omega_a), y~ = Omega_s (2.14(f)).
--     C^{Omega_a}(WW) is downward closed (4.16(a), WW n (Omega_a)~ weakly
--     downward closed by 4.29(a)), so y~ = Omega_s in it, and s in it (Omega_s
--     is s, or Omega'_s and then s by downward closure).  Omega_s <=' y <' Omega_a
--     gives s <' a (2.12(g)); s in C^{Omega_a}(WW) c C^a(WW) (4.7(b), a <=' Omega_a),
--     so s in tau^WW(a) = WW n a (4.20), and s in A (A|a = WW|a, 4.26(a)).
--     y <' y+ = (y~)+ = Omega_{s+1} in B (2.14(e), (f)).
--     (Setzer: "y~ in tau^WW(Omega_a), y~ = Omega_c, c in tau^WW(Omega_a) n a
--     c tau^A(a), y <' Omega_{c+1} in B".)
--   - Omega_a in M(WW): a in WW n Omega'_a c C^{Omega_a}(WW) (4.7(h); a <' Omega'_a),
--     so Omega'_a in C^{Omega_a}(WW) by its clause (4.4(c)).  (Setzer: "a in C^a(WW)
--     c C^{Omega_a}(WW)"; 4.7(b) gives the other inclusion, C^{Omega_a} c C^a, and
--     C^a(D) c C^{Omega_a}(D) is false: D = {0, 1}, a = 1, psi_{Omega_1} 0 is in
--     C^1(D) (1 <' Omega_1), not in C^{Omega_1}(D); otww.py proof finds 9 cases.)
--   - Omega_a <' I: 2.12(g) with Omega_I = I.
--   Then 4.30.
--   (b) psi_I 0 in WW;  psi_I x in WW => psi_I (x+1) in WW.    rem431b0, rem431b
--   Both are one lemma (fi-ww) at c = 0, e = 0 and c = psi_I x, e = x+1, with
--   d = psi_I e and W_n = Omega^n_{c+1} (OTF.W):  c in WW, d in OT,
--   e in C^d(WW), c+1 <' d, and y <' d => y^-Fi <=' c  give  d in WW.
--   B = {W_n | n : N} (a set).
--   - W_n <' d: c+1 <' d, and u <' d => Omega_u <' Omega_d = d (2.12(g)).
--   - W_n in WW: c+1 in WW (4.29(b), 1 = phi_0 0 in WW); W_{n+1} = Omega_{W_n}
--     in WW by (a), W_n <' d <' I.
--   - tau^WW(d) <=' B: y <' W(y^-Fi, n) for some n (2.14(i)) and
--     W(y^-Fi, n) <=' W(c, n) (y^-Fi <=' c; +1 and Omega are monotone).
--   - d in M(WW): d <' I and I, e in C^d(WW) (4.4(d)).
--   Then 4.30.  The side conditions:
--   c = 0:  1 <' psi_I 0 (computation); y <' psi_I 0 => y^-Fi = 0 (2.14(g)).
--   c = psi_I x:  c+1 <' d: psi_I x <' psi_I (x+1) (lt-TT), a sum below its head.
--     y <' d => y^-Fi <=' c: y <' psi_I 0 gives y^-Fi = 0; otherwise
--     y^-Fi = psi_I y' <=' y (2.14(g)), and y' <=' x (fi-ab), so psi_I y' <=' c.
--     e in C^d(WW) (Setzer: "psi_I x in C^{psi_I x}(WW), x in C^{psi_I x}(WW),
--     e in C^{psi_I x}(WW) n C_I(x) c C^{psi_I e}(WW)"): c in WW c M(WW), and
--     c in C^c(WW) is not by c <' c, so x in C^c(WW) (4.4(d)); 1 in C^c(WW);
--     C^c(WW) is upward closed (4.16(a)), so x+1 in C^c(WW); x+1 in C_I(x)
--     (2.14(k)), and 4.7(e) at psi_I x <=' c, d <' I.

level ul ;
import OT ;
import OTLaws ;
import OTTrans ;
import OTC ;
import OTF ;
import CA ;
import WA ;
import Clos ;
import Lem417 ;
import Ag ;
open OT ;
open OTLaws[ul+] ;
open OTTrans[ul+] ;
open OTC[ul+] ;
open OTF[ul+] ;
open CA[ul+] ;
open WA[ul+] ;
open Clos[ul+] ;
open Lem417[ul+] ;
open Ag[ul+] ;
module SC = CA[ul] ;
module SW = WA[ul] ;
module SG = Ag[ul] ;

------------------------------------------------------------------------
-- A set as a class

Lf (X : SC.Cl) (y : T) : U (ul+) = X y ;

-- the predicates of the two levels are equal by definition (stated once)
ok-up (y : T) (o : OTC[ul].OK y) : OK y = o ;
ok-dn (y : T) (o : OK y) : OTC[ul].OK y = o ;
lt-up (x y : T) (l : OTTrans[ul].LT x y) : LT x y = l ;
lt-dn (x y : T) (l : LT x y) : OTTrans[ul].LT x y = l ;
cap-up (X : SC.Cl) (a y : T) (q : SC.Cap X a y) : Cap (Lf X) a y = q ;
cap-dn (X : SC.Cl) (a y : T) (q : Cap (Lf X) a y) : SC.Cap X a y = q ;

-- the disjunctions of the two levels
or-up (P Q : U ul) (P' Q' : U (ul+)) (f : P -> P') (g : Q -> Q') : SC.Or P Q -> Or P' Q' = split {
  inl p -> inl (f p) ; inr q -> inr (g q) } ;
or-dn (P Q : U ul) (P' Q' : U (ul+)) (f : P' -> P) (g : Q' -> Q) : Or P' Q' -> SC.Or P Q = split {
  inl p -> inl (f p) ; inr q -> inr (g q) } ;

------------------------------------------------------------------------
-- (L1) C^a(X) at the two levels

-- x in C^a by a clause "x in X n a, or P", at both levels, with P <-> P'
lc-step (Cs Ks Ps : U ul) (Cb Kb Pb : U (ul+))
  (es : SC.Iff Cs (SC.Or Ks Ps)) (eb : Iff Cb (Or Kb Pb))
  (k1 : Ks -> Kb) (k2 : Kb -> Ks) (p1 : Ps -> Pb) (p2 : Pb -> Ps) : Iff Cs Cb =
  (\ h -> bw Cb (Or Kb Pb) eb (or-up Ks Ps Kb Pb k1 p1 (SC.fw Cs (SC.Or Ks Ps) es h)),
   \ h -> SC.bw Cs (SC.Or Ks Ps) es (or-dn Ks Ps Kb Pb k2 p2 (fw Cb (Or Kb Pb) eb h))) ;

lc (a : T) (X : SC.Cl) : (d : T) -> Iff (SC.C a X d) (C a (Lf X) d) = split {
  zero -> (\ h -> ca-zero a (Lf X), \ h -> SC.ca-zero a X) ;
  plus x0 xs | r0 rs ->
    (\ h -> fw (SC.C a X (plus x0 xs)) (C a (Lf X) (plus x0 xs))
              (lc-step (SC.C a X (plus x0 xs)) (SC.Cap X a (plus x0 xs)) (SC.C a X x0 * SC.C a X xs)
                 (C a (Lf X) (plus x0 xs)) (Cap (Lf X) a (plus x0 xs)) (C a (Lf X) x0 * C a (Lf X) xs)
                 (SC.ca-plus a X x0 xs (SC.ca-ok a X (plus x0 xs) h))
                 (ca-plus a (Lf X) x0 xs (ok-up (plus x0 xs) (SC.ca-ok a X (plus x0 xs) h)))
                 (cap-up X a (plus x0 xs)) (cap-dn X a (plus x0 xs))
                 (\ q -> (fw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, fw (SC.C a X xs) (C a (Lf X) xs) rs q.2))
                 (\ q -> (bw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, bw (SC.C a X xs) (C a (Lf X) xs) rs q.2))) h,
     \ h -> bw (SC.C a X (plus x0 xs)) (C a (Lf X) (plus x0 xs))
              (lc-step (SC.C a X (plus x0 xs)) (SC.Cap X a (plus x0 xs)) (SC.C a X x0 * SC.C a X xs)
                 (C a (Lf X) (plus x0 xs)) (Cap (Lf X) a (plus x0 xs)) (C a (Lf X) x0 * C a (Lf X) xs)
                 (SC.ca-plus a X x0 xs (ok-dn (plus x0 xs) (ca-ok a (Lf X) (plus x0 xs) h)))
                 (ca-plus a (Lf X) x0 xs (ca-ok a (Lf X) (plus x0 xs) h))
                 (cap-up X a (plus x0 xs)) (cap-dn X a (plus x0 xs))
                 (\ q -> (fw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, fw (SC.C a X xs) (C a (Lf X) xs) rs q.2))
                 (\ q -> (bw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, bw (SC.C a X xs) (C a (Lf X) xs) rs q.2))) h) ;
  phi x0 x1 | r0 r1 ->
    (\ h -> fw (SC.C a X (phi x0 x1)) (C a (Lf X) (phi x0 x1))
              (lc-step (SC.C a X (phi x0 x1)) (SC.Cap X a (phi x0 x1)) (SC.C a X x0 * SC.C a X x1)
                 (C a (Lf X) (phi x0 x1)) (Cap (Lf X) a (phi x0 x1)) (C a (Lf X) x0 * C a (Lf X) x1)
                 (SC.ca-phi a X x0 x1 (SC.ca-ok a X (phi x0 x1) h))
                 (ca-phi a (Lf X) x0 x1 (ok-up (phi x0 x1) (SC.ca-ok a X (phi x0 x1) h)))
                 (cap-up X a (phi x0 x1)) (cap-dn X a (phi x0 x1))
                 (\ q -> (fw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, fw (SC.C a X x1) (C a (Lf X) x1) r1 q.2))
                 (\ q -> (bw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, bw (SC.C a X x1) (C a (Lf X) x1) r1 q.2))) h,
     \ h -> bw (SC.C a X (phi x0 x1)) (C a (Lf X) (phi x0 x1))
              (lc-step (SC.C a X (phi x0 x1)) (SC.Cap X a (phi x0 x1)) (SC.C a X x0 * SC.C a X x1)
                 (C a (Lf X) (phi x0 x1)) (Cap (Lf X) a (phi x0 x1)) (C a (Lf X) x0 * C a (Lf X) x1)
                 (SC.ca-phi a X x0 x1 (ok-dn (phi x0 x1) (ca-ok a (Lf X) (phi x0 x1) h)))
                 (ca-phi a (Lf X) x0 x1 (ca-ok a (Lf X) (phi x0 x1) h))
                 (cap-up X a (phi x0 x1)) (cap-dn X a (phi x0 x1))
                 (\ q -> (fw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, fw (SC.C a X x1) (C a (Lf X) x1) r1 q.2))
                 (\ q -> (bw (SC.C a X x0) (C a (Lf X) x0) r0 q.1, bw (SC.C a X x1) (C a (Lf X) x1) r1 q.2))) h) ;
  psi x0 x1 | r0 r1 ->
    (\ h -> fw (SC.C a X (psi x0 x1)) (C a (Lf X) (psi x0 x1))
              (lc-step (SC.C a X (psi x0 x1)) (SC.Cap X a (psi x0 x1)) (SC.PsiP a X x0 x1)
                 (C a (Lf X) (psi x0 x1)) (Cap (Lf X) a (psi x0 x1)) (PsiP a (Lf X) x0 x1)
                 (SC.ca-psi a X x0 x1 (SC.ca-ok a X (psi x0 x1) h))
                 (ca-psi a (Lf X) x0 x1 (ok-up (psi x0 x1) (SC.ca-ok a X (psi x0 x1) h)))
                 (cap-up X a (psi x0 x1)) (cap-dn X a (psi x0 x1))
                 (\ q -> (lt-up a x0 q.1, (fw (SC.C a X x0) (C a (Lf X) x0) r0 q.2.1, fw (SC.C a X x1) (C a (Lf X) x1) r1 q.2.2)))
                 (\ q -> (lt-dn a x0 q.1, (bw (SC.C a X x0) (C a (Lf X) x0) r0 q.2.1, bw (SC.C a X x1) (C a (Lf X) x1) r1 q.2.2)))) h,
     \ h -> bw (SC.C a X (psi x0 x1)) (C a (Lf X) (psi x0 x1))
              (lc-step (SC.C a X (psi x0 x1)) (SC.Cap X a (psi x0 x1)) (SC.PsiP a X x0 x1)
                 (C a (Lf X) (psi x0 x1)) (Cap (Lf X) a (psi x0 x1)) (PsiP a (Lf X) x0 x1)
                 (SC.ca-psi a X x0 x1 (ok-dn (psi x0 x1) (ca-ok a (Lf X) (psi x0 x1) h)))
                 (ca-psi a (Lf X) x0 x1 (ca-ok a (Lf X) (psi x0 x1) h))
                 (cap-up X a (psi x0 x1)) (cap-dn X a (psi x0 x1))
                 (\ q -> (lt-up a x0 q.1, (fw (SC.C a X x0) (C a (Lf X) x0) r0 q.2.1, fw (SC.C a X x1) (C a (Lf X) x1) r1 q.2.2)))
                 (\ q -> (lt-dn a x0 q.1, (bw (SC.C a X x0) (C a (Lf X) x0) r0 q.2.1, bw (SC.C a X x1) (C a (Lf X) x1) r1 q.2.2)))) h) ;
  om x0 | r0 ->
    (\ h -> fw (SC.C a X (om x0)) (C a (Lf X) (om x0))
              (lc-step (SC.C a X (om x0)) (SC.Cap X a (om x0)) (SC.C a X x0)
                 (C a (Lf X) (om x0)) (Cap (Lf X) a (om x0)) (C a (Lf X) x0)
                 (SC.ca-om a X x0 (SC.ca-ok a X (om x0) h))
                 (ca-om a (Lf X) x0 (ok-up (om x0) (SC.ca-ok a X (om x0) h)))
                 (cap-up X a (om x0)) (cap-dn X a (om x0))
                 (fw (SC.C a X x0) (C a (Lf X) x0) r0) (bw (SC.C a X x0) (C a (Lf X) x0) r0)) h,
     \ h -> bw (SC.C a X (om x0)) (C a (Lf X) (om x0))
              (lc-step (SC.C a X (om x0)) (SC.Cap X a (om x0)) (SC.C a X x0)
                 (C a (Lf X) (om x0)) (Cap (Lf X) a (om x0)) (C a (Lf X) x0)
                 (SC.ca-om a X x0 (ok-dn (om x0) (ca-ok a (Lf X) (om x0) h)))
                 (ca-om a (Lf X) x0 (ca-ok a (Lf X) (om x0) h))
                 (cap-up X a (om x0)) (cap-dn X a (om x0))
                 (fw (SC.C a X x0) (C a (Lf X) x0) r0) (bw (SC.C a X x0) (C a (Lf X) x0) r0)) h) ;
  ii -> (\ h -> ca-I a (Lf X), \ h -> SC.ca-I a X) } ;

------------------------------------------------------------------------
-- (L2) W(X) at the two levels

-- tau and M correspond, by (L1)
tau-up (X : SC.Cl) (x y : T) (t : SC.tau X x y) : tau (Lf X) x y =
  (fw (SC.C x X y) (C x (Lf X) y) (lc x X y) t.1, lt-up y x t.2) ;
tau-dn (X : SC.Cl) (x y : T) (t : tau (Lf X) x y) : SC.tau X x y =
  (bw (SC.C x X y) (C x (Lf X) y) (lc x X y) t.1, lt-dn y x t.2) ;
m-up (X : SC.Cl) (x : T) (m : SC.M X x) : M (Lf X) x =
  (ok-up x m.1, fw (SC.C x X x) (C x (Lf X) x) (lc x X x) m.2) ;
m-dn (X : SC.Cl) (x : T) (m : M (Lf X) x) : SC.M X x =
  (ok-dn x m.1, bw (SC.C x X x) (C x (Lf X) x) (lc x X x) m.2) ;

-- set -> class: at sup(x, f), with Cor(sup(x, f)) unfolded to g (cor-sup)
lw-step (X : SC.Cl) (x : T) (f : SW.TH X x -> SW.W1 X)
  (r : (v : SW.TH X x) -> SW.Cor X (f v) -> WA[ul+].WA (Lf X) (SW.idx X (f v)))
  (g : SC.M X x * ((v : SW.TH X x) -> SW.Cor X (f v) * Id T (SW.idx X (f v)) v.1)) : WA[ul+].WA (Lf X) x =
  wa-a (Lf X) x
    (m-up X x g.1,
     \ y t -> tr-B (WA[ul+].WA (Lf X)) (SW.idx X (f (y, tau-dn X x y t))) y (g.2 (y, tau-dn X x y t)).2
                (r (y, tau-dn X x y t) (g.2 (y, tau-dn X x y t)).1)) ;

lw-tree (X : SC.Cl) : (t : SW.W1 X) -> SW.Cor X t -> WA[ul+].WA (Lf X) (SW.idx X t) = split {
  sup x f | r -> \ c -> lw-step X x f r
    (SC.fw (SW.Cor X (sup x f)) (SC.M X x * ((v : SW.TH X x) -> SW.Cor X (f v) * Id T (SW.idx X (f v)) v.1))
       (SW.cor-sup X x f) c) } ;

lw-up (X : SC.Cl) (y : T) (h : SW.WA X y) : WA[ul+].WA (Lf X) y =
  tr-B (WA[ul+].WA (Lf X)) (SW.idx X (SW.wa-sig X y h).1) y (SW.wa-sig X y h).2.2
    (lw-tree X (SW.wa-sig X y h).1 (SW.wa-sig X y h).2.1) ;

-- class -> set: Ind(x in W(X)) for the class, 4.10(a) for the set
lw-dn (X : SC.Cl) : Sub (WA[ul+].WA (Lf X)) (Lf (SW.WA X)) =
  wa-ind (Lf X) (Lf (SW.WA X))
    (\ x w m s -> SW.wa-a X x (m-dn X x m, \ y t -> s y (tau-up X x y t))) ;

------------------------------------------------------------------------
-- (L3) Ag(X) at the two levels

bar-up (A : SC.Cl) (B : Cl) (f : (y : T) -> A y -> B y) (x y : T) (q : SW.Bar A x y) : Bar B x y =
  (f y q.1, lt-up y (suc x) q.2) ;
bar-dn (A : SC.Cl) (B : Cl) (f : (y : T) -> B y -> A y) (x y : T) (q : Bar B x y) : SW.Bar A x y =
  (f y q.1, lt-dn y (suc x) q.2) ;

ag-up (X : SC.Cl) (g : SG.Ag X) : Ag[ul+].Ag (Lf X) =
  (\ x xa -> ok-up x (g.1 x xa),
   \ x xa y -> (\ q -> bar-up (SW.WA X) (WA[ul+].WA (Lf X)) (lw-up X) x y
                  (SC.fw (SW.Bar X x y) (SW.Bar (SW.WA X) x y) (g.2 x xa y) (bar-dn X (Lf X) (\ z p -> p) x y q)),
                \ q -> bar-up X (Lf X) (\ z p -> p) x y
                  (SC.bw (SW.Bar X x y) (SW.Bar (SW.WA X) x y) (g.2 x xa y) (bar-dn (SW.WA X) (WA[ul+].WA (Lf X)) (lw-dn X) x y q)))) ;

ag-dn (X : SC.Cl) (g : Ag[ul+].Ag (Lf X)) : SG.Ag X =
  (\ x xa -> ok-dn x (g.1 x xa),
   \ x xa y -> (\ q -> bar-dn (SW.WA X) (WA[ul+].WA (Lf X)) (lw-dn X) x y
                  (fw (Bar (Lf X) x y) (Bar (WA[ul+].WA (Lf X)) x y) (g.2 x xa y) (bar-up X (Lf X) (\ z p -> p) x y q)),
                \ q -> bar-dn X (Lf X) (\ z p -> p) x y
                  (bw (Bar (Lf X) x y) (Bar (WA[ul+].WA (Lf X)) x y) (g.2 x xa y) (bar-up (SW.WA X) (WA[ul+].WA (Lf X)) (lw-up X) x y q)))) ;

------------------------------------------------------------------------
-- Definition 4.25

WW (y : T) : U (ul+) = (X : SC.Cl) * (SG.Ag X * X y) ;

-- the parts of y in WW: a set, its Ag[ul+].Ag (as a set, as a class), y in it
ww-set (y : T) (h : WW y) : SC.Cl = h.1 ;
ww-sag (y : T) (h : WW y) : SG.Ag (ww-set y h) = h.2.1 ;
ww-gag (y : T) (h : WW y) : Ag[ul+].Ag (Lf (ww-set y h)) = ag-up (ww-set y h) (ww-sag y h) ;
ww-mem (y : T) (h : WW y) : Lf (ww-set y h) y = h.2.2 ;
ww-mk (X : SC.Cl) (g : Ag[ul+].Ag (Lf X)) (y : T) (xy : Lf X y) : WW y = (X, (ag-dn X g, xy)) ;

ww-ot : Sub WW OTc = \ y h -> ag-ot (Lf (ww-set y h)) (ww-gag y h) y (ww-mem y h) ;

------------------------------------------------------------------------
-- Lemma 4.26

-- y <' a+1 => y <=' a
le-bar (y a : T) (oy : OK y) (oa : OK a) (l : LT y (suc a)) : Tr (le y a) = lt-suc-le' y a oy oa l ;

-- transfer at a bar:  A n a = B n a  =>  W(A)|a = W(B)|a
bar-w (A B : Cl) (oA : Sub A OTc) (oB : Sub B OTc) (a : T) (oa : OK a) (e : Eqv (Cap A a) (Cap B a))
  : Eqv (Bar (WA[ul+].WA A) a) (Bar (WA[ul+].WA B) a) =
  \ y -> (\ q -> (wa-at A B oA oB a oa e y q.1 (le-bar y a (wa-OK A y q.1) oa q.2), q.2),
          \ q -> (wa-at B A oB oA a oa (eqv-sym (Cap A a) (Cap B a) e) y q.1 (le-bar y a (wa-OK B y q.1) oa q.2), q.2)) ;

-- A|a = B|a  =>  A n a = B n a
bar-cap (A B : Cl) (oA : Sub A OTc) (oB : Sub B OTc) (a : T) (oa : OK a) (e : Eqv (Bar A a) (Bar B a))
  : Eqv (Cap A a) (Cap B a) =
  \ y -> (\ q -> ((fw (Bar A a y) (Bar B a y) (e y) (q.1, lt-sx y a (oA y q.1) oa q.2)).1, q.2),
          \ q -> ((bw (Bar A a y) (Bar B a y) (e y) (q.1, lt-sx y a (oB y q.1) oa q.2)).1, q.2)) ;

-- Ag(A), a in A, c <=' a  =>  A|c = W(A|c) n (c+1)
bar-eq (A : Cl) (g : Ag[ul+].Ag A) (a c : T) (aa : A a) (oc : OK c) (la : Tr (le c a))
  : Eqv (Bar A c) (Cap (WA[ul+].WA (Bar A c)) (suc c)) =
  \ y -> (\ q -> (wa-at A (Bar A c) (ag-ot A g) (\ z p -> ag-ot A g z p.1) c oc
                    (\ z -> (\ p -> ((p.1, lt-sx z c (ag-ot A g z p.1) oc p.2), p.2), \ p -> (p.1.1, p.2)))
                    y (ag-w A g y q.1) (le-bar y c (ag-ot A g y q.1) oc q.2), q.2),
          \ q -> (ag-back A g a y aa
                    (wa-at (Bar A c) A (\ z p -> ag-ot A g z p.1) (ag-ot A g) c oc
                       (\ z -> (\ p -> (p.1.1, p.2), \ p -> ((p.1, lt-sx z c (ag-ot A g z p.1) oc p.2), p.2)))
                       y q.1 (le-bar y c (wa-OK (Bar A c) y q.1) oc q.2))
                    (le-trans y c a (trOT y c a (wa-OK (Bar A c) y q.1) oc (ag-ot A g a aa))
                       (le-bar y c (wa-OK (Bar A c) y q.1) oc q.2) la), q.2)) ;

-- uniqueness (Lemma 4.24 at a_0 = a_1 = c+1)
agree (A B : Cl) (gA : Ag[ul+].Ag A) (gB : Ag[ul+].Ag B) (a b c : T) (aa : A a) (bb : B b) (oc : OK c)
  (la : Tr (le c a)) (lb : Tr (le c b)) : Eqv (Bar A c) (Bar B c) =
  eqv-trans (Bar A c) (Cap (Bar B c) (suc c)) (Bar B c)
    (rem424 (Bar A c) (Bar B c) (suc c) (suc c)
       (suc-OK c oc, (suc-OK c oc, (bar-eq A gA a c aa oc la, (bar-eq B gB b c bb oc lb, le-refl (suc c))))))
    (\ y -> (\ q -> q.1, \ q -> (q, q.2))) ;

-- (a) "->"
ww-seg (X : SC.Cl) (g : Ag[ul+].Ag (Lf X)) : Seg (Lf X) WW =
  (ag-ot (Lf X) g,
   \ a xa y -> (\ q -> (ww-mk X g y q.1, q.2),
                \ q -> ((bw (Bar (Lf X) y y) (Bar (Lf (ww-set y q.1)) y y)
                          (agree (Lf X) (Lf (ww-set y q.1)) g (ww-gag y q.1) a y y xa (ww-mem y q.1)
                             (ww-ot y q.1) (le-bar y a (ww-ot y q.1) (ag-ot (Lf X) g a xa) q.2) (le-refl y) y)
                          (ww-mem y q.1, lt-suc-self y (ww-ot y q.1))).1, q.2))) ;

-- (b), at a in B, with a in D, D a set, Ag(D):  B|a = WW|a = D|a
seg-bar (B : Cl) (s : Seg B WW) (a : T) (ba : B a) (D : SC.Cl) (gD : Ag[ul+].Ag (Lf D)) (aD : Lf D a)
  : Eqv (Bar B a) (Bar (Lf D) a) =
  eqv-trans (Bar B a) (Bar WW a) (Bar (Lf D) a) (s.2 a ba)
    (eqv-sym (Bar (Lf D) a) (Bar WW a) ((ww-seg D gD).2 a aD)) ;

-- ... = W(D)|a = W(B)|a
ww-ag-at (B : Cl) (s : Seg B WW) (a : T) (ba : B a) (D : SC.Cl) (gD : Ag[ul+].Ag (Lf D)) (aD : Lf D a)
  : Eqv (Bar B a) (Bar (WA[ul+].WA B) a) =
  eqv-trans (Bar B a) (Bar (Lf D) a) (Bar (WA[ul+].WA B) a) (seg-bar B s a ba D gD aD)
    (eqv-trans (Bar (Lf D) a) (Bar (WA[ul+].WA (Lf D)) a) (Bar (WA[ul+].WA B) a) (gD.2 a aD)
       (bar-w (Lf D) B (ag-ot (Lf D) gD) s.1 a (s.1 a ba)
          (bar-cap (Lf D) B (ag-ot (Lf D) gD) s.1 a (s.1 a ba)
             (eqv-sym (Bar B a) (Bar (Lf D) a) (seg-bar B s a ba D gD aD))))) ;

ww-ag-cl (B : Cl) (s : Seg B WW) : Ag[ul+].Ag B =
  (s.1, \ a ba -> ww-ag-at B s a ba (ww-set a (seg-in B WW s a ba)) (ww-gag a (seg-in B WW s a ba))
                     (ww-mem a (seg-in B WW s a ba))) ;

-- (a) "<-"
ww-ag-set (X : SC.Cl) (s : Seg (Lf X) WW) : SG.Ag X = ag-dn X (ww-ag-cl (Lf X) s) ;

------------------------------------------------------------------------
-- Lemma 4.27

ag-ww : Ag[ul+].Ag WW = ww-ag-cl WW (ww-ot, \ x h y -> (\ q -> q, \ q -> q)) ;

------------------------------------------------------------------------
-- Lemma 4.28

-- (a): the hypothesis at x: a set Y, Ag(Y), x in Y, Y c A
Cov (A : Cl) (x : T) : U (ul+) = (Y : SC.Cl) * (SG.Ag Y * (Y x * Sub (Lf Y) A)) ;

rem428a (A : Cl) (H : (x : T) -> A x -> Cov A x) : Ag[ul+].Ag A =
  ww-ag-cl A
    (\ x ax -> ag-ot (Lf (H x ax).1) (ag-up (H x ax).1 (H x ax).2.1) x (H x ax).2.2.1,
     \ x ax y -> (\ q -> (((H y q.1).1, ((H y q.1).2.1, (H y q.1).2.2.1)), q.2),
                  \ q -> ((H x ax).2.2.2 y
                            (bw (Bar (Lf (H x ax).1) x y) (Bar WW x y)
                               ((ww-seg (H x ax).1 (ag-up (H x ax).1 (H x ax).2.1)).2 x (H x ax).2.2.1 y) q).1, q.2))) ;

-- (b)
rem428b (A : Cl) (g : Ag[ul+].Ag A) (c : T) (oc : OK c) : Ag[ul+].Ag (Cap A c) =
  (\ x q -> ag-ot A g x q.1,
   \ a q -> eqv-trans (Bar (Cap A c) a) (Bar A a) (Bar (WA[ul+].WA (Cap A c)) a)
     (\ y -> (\ p -> (p.1.1, p.2),
              \ p -> ((p.1, le-lt y a c (trOT y a c (ag-ot A g y p.1) (ag-ot A g a q.1) oc)
                              (le-bar y a (ag-ot A g y p.1) (ag-ot A g a q.1) p.2) q.2), p.2)))
     (eqv-trans (Bar A a) (Bar (WA[ul+].WA A) a) (Bar (WA[ul+].WA (Cap A c)) a)
        (g.2 a q.1)
        (bar-w A (Cap A c) (ag-ot A g) (\ z p -> ag-ot A g z p.1) a (ag-ot A g a q.1)
           (\ y -> (\ p -> ((p.1, lt-trans y a c (ot-T y (ag-ot A g y p.1)) (ot-T a (ag-ot A g a q.1)) (ot-T c oc) p.2 q.2), p.2),
                    \ p -> (p.1.1, p.2)))))) ;

------------------------------------------------------------------------
-- The bound: y, z <=' m, x = y + z or phi_y z  =>  x <' m+

-- the card values of x are those of y or of z
CardOf (x y z : T) : U (ul+) = Or (Id C4 (card x) (card y)) (Id C4 (card x) (card z)) ;

-- (g, z) has the values of g (Def. 2.13(b): those of the head)
card-cons (g z : T) : CardOf (consA g z) g z =
  iteC (\ w -> CardOf w g z) (le (hd z) g) (plus g z) z (\ t -> inl (refl (card g))) (\ f -> inr (refl (card z))) ;

-- y + z is y, z, or a sum with the head of y
card-add : (y z : T) -> CardOf (add y z) y z = split {
  zero -> \ z -> inr (refl (card z)) ;
  plus x0 xs -> \ z ->
    iteC (\ w -> CardOf w (plus x0 xs) z) (isZero z) (plus x0 xs) (ifT (le (hd z) x0) (plus x0 (add xs z)) z)
      (\ t -> inl (refl (card x0)))
      (\ f -> iteC (\ w -> CardOf w (plus x0 xs) z) (le (hd z) x0) (plus x0 (add xs z)) z
                (\ t -> inl (refl (card x0))) (\ f -> inr (refl (card z)))) ;
  phi x0 x1 -> \ z ->
    iteC (\ w -> CardOf w (phi x0 x1) z) (isZero z) (phi x0 x1) (consA (phi x0 x1) z)
      (\ t -> inl (refl (card (phi x0 x1)))) (\ f -> card-cons (phi x0 x1) z) ;
  psi x0 x1 -> \ z ->
    iteC (\ w -> CardOf w (psi x0 x1) z) (isZero z) (psi x0 x1) (consA (psi x0 x1) z)
      (\ t -> inl (refl (card (psi x0 x1)))) (\ f -> card-cons (psi x0 x1) z) ;
  om x0 -> \ z ->
    iteC (\ w -> CardOf w (om x0) z) (isZero z) (om x0) (consA (om x0) z)
      (\ t -> inl (refl (card (om x0)))) (\ f -> card-cons (om x0) z) ;
  ii -> \ z ->
    iteC (\ w -> CardOf w ii z) (isZero z) ii (consA ii z)
      (\ t -> inl (refl (card ii))) (\ f -> card-cons ii z) } ;

-- phi_y z is z, y, or phi'_y z, which has the values of max{y, z}
card-phi (y z : T) : CardOf (phiF y z) y z =
  iteC (\ w -> CardOf w y z) (crit y z) z (ifT (and (isZero z) (isG y)) y (phi y z))
    (\ t -> inr (refl (card z)))
    (\ f -> iteC (\ w -> CardOf w y z) (and (isZero z) (isG y)) y (phi y z)
              (\ t -> inl (refl (card y)))
              (\ f -> ifQ-G (\ c -> Or (Id C4 c (card y)) (Id C4 c (card z))) (le z y) (card y) (card z)
                        (\ t -> inl (refl (card y))) (\ f -> inr (refl (card z))))) ;

-- equal card values give equal x+
up-of (x y : T) (e : Id C4 (card x) (card y)) : Id T (up x) (up y) = ap (\ c -> c.2.1) e ;

-- x+ <=' y+ <=' m+  from  y <=' m (2.14(b)), and x <' x+ (2.14(f))
bound-of (x y m : T) (ox : OK x) (oy : OK y) (om : OK m) (ly : Tr (le y m)) (e : Id C4 (card x) (card y)) : LT x (up m) =
  lt-le x (up x) (up m) (trOT x (up x) (up m) ox (up-OK x ox) (up-OK m om)) (rem214f x ox).2.2.2.2.2
    (subst (\ u -> Tr (le u (up m))) (sym (up-of x y e)) (up-mono y m oy om ly)) ;

bound (x y z m : T) (ox : OK x) (oy : OK y) (oz : OK z) (om : OK m) (ly : Tr (le y m)) (lz : Tr (le z m))
  (c : CardOf x y z) : LT x (up m) =
  either (Id C4 (card x) (card y)) (Id C4 (card x) (card z)) (LT x (up m))
    (\ e -> bound-of x y m ox oy om ly e) (\ e -> bound-of x z m ox oz om lz e) c ;

------------------------------------------------------------------------
-- Lemma 4.29

-- (a)
rem429a : DC WW * UC WW (Dn WW) = rem423a WW ag-ww ;

-- (c'): m in A, Ag(A) => m+ in A+, Ag(A+)  (4.23(c) for the set A)
ww-up (m : T) (h : WW m) : WW (up m) =
  (SG.Aplus (ww-set m h),
   ((SG.rem423c (ww-set m h) (ww-sag m h)).1, (SG.rem423c (ww-set m h) (ww-sag m h)).2.2 m (ww-mem m h))) ;

-- (c)
rem429c (x : T) (h : WW (omF x)) : WW (omF (suc x)) = tr-B WW (up (omF x)) (omF (suc x)) (up-omF x) (ww-up (omF x) h) ;

-- (b): x below m+ in WW, m = max{y, z}
ww-below-at (x y z : T) (wy : WW y) (wz : WW z) (ox : OK x) (c : CardOf x y z) (m : Mx WW y z) : Dn WW x =
  (up m.1, (ww-up m.1 m.2.1,
            le-of-lt x (up m.1) (bound x y z m.1 ox (ww-ot y wy) (ww-ot z wz) (ww-ot m.1 m.2.1) m.2.2.1 m.2.2.2 c))) ;
ww-below (x y z : T) (wy : WW y) (wz : WW z) (ox : OK x) (c : CardOf x y z) : Dn WW x =
  ww-below-at x y z wy wz ox c (max2 WW ww-ot y z wy wz) ;

rem429b-sum (y z : T) (wy : WW y) (wz : WW z) (o : OK (add y z)) : WW (add y z) =
  uc-sum WW (Dn WW) rem429a.2 y z wy wz o (ww-below (add y z) y z wy wz o (card-add y z)) ;
rem429b-phi (y z : T) (wy : WW y) (wz : WW z) (o : OK (phiF y z)) : WW (phiF y z) =
  uc-phi WW (Dn WW) rem429a.2 y z wy wz o (ww-below (phiF y z) y z wy wz o (card-phi y z)) ;
rem429b-psi (y z : T) (wy : WW y) (wz : WW z) (o : OK (psi y z)) : WW (psi y z) =
  rem423b WW ag-ww y z wy wz (ot-psiR y z o) (own-inC y z o) ;

------------------------------------------------------------------------
-- Lemma 4.30

-- the hypotheses: a in M(WW), a <' I, B c WW|a, tau^WW(a) <=' B
H430 (a : T) (B : SC.Cl) : U (ul+) =
  M WW a * (LT a ii * (Sub (Lf B) (Bar WW a) * Sub (tau WW a) (Dn (Lf B)))) ;
h-ma (a : T) (B : SC.Cl) (h : H430 a B) : M WW a = h.1 ;
h-oa (a : T) (B : SC.Cl) (h : H430 a B) : OK a = h.1.1 ;
h-I (a : T) (B : SC.Cl) (h : H430 a B) : LT a ii = h.2.1 ;
h-B (a : T) (B : SC.Cl) (h : H430 a B) : Sub (Lf B) (Bar WW a) = h.2.2.1 ;
h-t (a : T) (B : SC.Cl) (h : H430 a B) : Sub (tau WW a) (Dn (Lf B)) = h.2.2.2 ;

-- x in B is in WW; g(x) its set, Ag(g(x))
h-w (a : T) (B : SC.Cl) (h : H430 a B) (x : T) (bx : B x) : WW x = (h-B a B h x bx).1 ;
cu-g (a : T) (B : SC.Cl) (h : H430 a B) (x : T) (bx : B x) : SC.Cl = ww-set x (h-w a B h x bx) ;
cu-gag (a : T) (B : SC.Cl) (h : H430 a B) (x : T) (bx : B x) : Ag[ul+].Ag (Lf (cu-g a B h x bx)) =
  ww-gag x (h-w a B h x bx) ;

-- 4.28(b) for a set:  Ag(X) => Ag(X n a)
cap-ag (X : SC.Cl) (g : Ag[ul+].Ag (Lf X)) (a : T) (oa : OK a) : SG.Ag (SC.Cap X a) =
  ag-dn (SC.Cap X a)
    (ag-eqv (Cap (Lf X) a) (Lf (SC.Cap X a)) (\ y -> (cap-dn X a y, cap-up X a y)) (rem428b (Lf X) g a oa)) ;

-- (1) C = U_{p : B^} (g p n a), Ag(C)
Cu (a : T) (B : SC.Cl) (h : H430 a B) (y : T) : U ul =
  (p : (x : T) * B x) * SC.Cap (cu-g a B h p.1 p.2) a y ;

ag-cu (a : T) (B : SC.Cl) (h : H430 a B) : Ag[ul+].Ag (Lf (Cu a B h)) =
  rem428a (Lf (Cu a B h))
    (\ y c -> (SC.Cap (cu-g a B h c.1.1 c.1.2) a,
               (cap-ag (cu-g a B h c.1.1 c.1.2) (cu-gag a B h c.1.1 c.1.2) a (h-oa a B h),
                (c.2, \ z q -> (c.1, q))))) ;

-- (2) tau^WW(a) c WW:  y <=' x in B, x <=' a
tau-at (a : T) (B : SC.Cl) (h : H430 a B) (y : T) (t : tau WW a y) (q : Dn (Lf B) y) : WW y =
  le-cases WW q.1 y q.2.2 (h-w a B h q.1 q.2.1)
    (\ p -> (fw (tau WW q.1 y) (Cap WW q.1 y) (rem420 WW ag-ww q.1 (h-w a B h q.1 q.2.1) y)
               (rem49a WW (ag-M WW ag-ww) a q.1 (h-oa a B h) (ww-ot q.1 (h-w a B h q.1 q.2.1))
                  (le-bar q.1 a (ww-ot q.1 (h-w a B h q.1 q.2.1)) (h-oa a B h) (h-B a B h q.1 q.2.1).2)
                  y (t, p))).1) ;
tau-ww (a : T) (B : SC.Cl) (h : H430 a B) : Sub (tau WW a) WW = \ y t -> tau-at a B h y t (h-t a B h y t) ;

-- (3) C = WW n a.  "o": y <=' x in B, g(x)|x = WW|x
cu-in (a : T) (B : SC.Cl) (h : H430 a B) (y : T) (q : Cap WW a y) (r : Dn (Lf B) y) : Lf (Cu a B h) y =
  ((r.1, r.2.1),
   ((bw (Bar (Lf (cu-g a B h r.1 r.2.1)) r.1 y) (Bar WW r.1 y)
        ((ww-seg (cu-g a B h r.1 r.2.1) (cu-gag a B h r.1 r.2.1)).2 r.1 (ww-mem r.1 (h-w a B h r.1 r.2.1)) y)
        (q.1, le-sx y r.1 (ww-ot y q.1) (ww-ot r.1 (h-w a B h r.1 r.2.1)) r.2.2)).1,
    lt-dn y a q.2)) ;
cu-eq (a : T) (B : SC.Cl) (h : H430 a B) : Eqv (Lf (Cu a B h)) (Cap WW a) =
  \ y -> (\ c -> (ww-mk (cu-g a B h c.1.1 c.1.2) (cu-gag a B h c.1.1 c.1.2) y c.2.1, lt-up y a c.2.2),
          \ q -> cu-in a B h y q (h-t a B h y (rem47h a WW y (ww-ot y q.1) q, q.2))) ;

-- A = B n a, b <=' a  =>  A n b = B n b
cap-of (A B : Cl) (oB : Sub B OTc) (a b : T) (oa : OK a) (ob : OK b) (e : Eqv A (Cap B a)) (l : Tr (le b a))
  : Eqv (Cap A b) (Cap B b) =
  \ y -> (\ q -> ((fw (A y) (Cap B a y) (e y) q.1).1, q.2),
          \ q -> (bw (A y) (Cap B a y) (e y) (q.1, lt-le y b a (trOT y b a (oB y q.1) ob oa) q.2 l), q.2)) ;

cu-cap (a : T) (B : SC.Cl) (h : H430 a B) : Eqv (Cap (Lf (Cu a B h)) a) (Cap WW a) =
  cap-of (Lf (Cu a B h)) WW ww-ot a a (h-oa a B h) (h-oa a B h) (cu-eq a B h) (le-refl a) ;

-- Ag(A) => C^b(A) downward closed and upward closed (4.16(a); A n b~ by 4.23(a))
ag-ca (A : Cl) (g : Ag[ul+].Ag A) (b : T) (ob : OK b) : DC (C b A) * UC (C b A) OTc =
  rem416a-C A (ag-M A g) b ob (wd-cap A (ag-ot A g) (tilde b) (ot-T (tilde b) (til-OK b ob)) (rem423a A g).1.1) ;

-- x <' I  =>  x^{-I} = 0
mI-lo (x : T) (h : LT x ii) : Id T (mI x) zero = ifT-t (lt x ii) zero ii h ;

-- (4) d in W(C), d <' a:  d~ in C^d(C), = C^a(C) (4.7(g)) = C^a(WW) (ca-cap)
wc-til (a : T) (B : SC.Cl) (h : H430 a B) (d : T) (w : WA[ul+].WA (Lf (Cu a B h)) d) (l : LT d a) : C a WW (tilde d) =
  fw (C a (Lf (Cu a B h)) (tilde d)) (C a WW (tilde d)) (ca-cap (Lf (Cu a B h)) WW a (cu-cap a B h) (tilde d))
    (fw (Cap (C d (Lf (Cu a B h))) (suc (tilde d)) (tilde d)) (Cap (C a (Lf (Cu a B h))) (suc (tilde d)) (tilde d))
       (rem47g (Lf (Cu a B h)) (ag-M (Lf (Cu a B h)) (ag-cu a B h)) d a
          (wa-OK (Lf (Cu a B h)) d w,
           (h-oa a B h,
            (le-trans (tilde d) d a (trOT (tilde d) d a (til-OK d (wa-OK (Lf (Cu a B h)) d w)) (wa-OK (Lf (Cu a B h)) d w) (h-oa a B h))
               (til-le d (wa-OK (Lf (Cu a B h)) d w)) (le-of-lt d a l),
             trans (mI-lo d (lt-trans d a ii (ot-T d (wa-OK (Lf (Cu a B h)) d w)) (ot-T a (h-oa a B h)) (ot-T ii ok-ii) l (h-I a B h)))
               (sym (mI-lo a (h-I a B h))))))
          (tilde d))
       ((dc-card (C d (Lf (Cu a B h))) (ag-ca (Lf (Cu a B h)) (ag-cu a B h) d (wa-OK (Lf (Cu a B h)) d w)).1 d
           (wa-M (Lf (Cu a B h)) d w).2).1,
        lt-suc-self (tilde d) (til-OK d (wa-OK (Lf (Cu a B h)) d w)))).1 ;

-- d+ = (d~)+ in WW  (d~ in tau^WW(a) c WW)
wc-up (a : T) (B : SC.Cl) (h : H430 a B) (d : T) (w : WA[ul+].WA (Lf (Cu a B h)) d) (l : LT d a) : WW (up d) =
  tr-B WW (up (tilde d)) (up d) (rem214e d (wa-OK (Lf (Cu a B h)) d w))
    (ww-up (tilde d)
       (tau-ww a B h (tilde d)
          (wc-til a B h d w l,
           le-lt (tilde d) d a (trOT (tilde d) d a (til-OK d (wa-OK (Lf (Cu a B h)) d w)) (wa-OK (Lf (Cu a B h)) d w) (h-oa a B h))
             (til-le d (wa-OK (Lf (Cu a B h)) d w)) l))) ;

-- d in W(WW)  (C n d = WW n d, transfer at d)
wc-w (a : T) (B : SC.Cl) (h : H430 a B) (d : T) (w : WA[ul+].WA (Lf (Cu a B h)) d) (l : LT d a) : WA[ul+].WA WW d =
  wa-at (Lf (Cu a B h)) WW (ag-ot (Lf (Cu a B h)) (ag-cu a B h)) ww-ot d (wa-OK (Lf (Cu a B h)) d w)
    (cap-of (Lf (Cu a B h)) WW ww-ot a d (h-oa a B h) (wa-OK (Lf (Cu a B h)) d w) (cu-eq a B h) (le-of-lt d a l))
    d w (le-refl d) ;

-- W(C) n a c C:  d in W(WW) n d+ = WW n d+
wc-c (a : T) (B : SC.Cl) (h : H430 a B) (d : T) (w : WA[ul+].WA (Lf (Cu a B h)) d) (l : LT d a) : Lf (Cu a B h) d =
  bw (Lf (Cu a B h) d) (Cap WW a d) (cu-eq a B h d)
    ((bw (Cap WW (up d) d) (Cap (WA[ul+].WA WW) (up d) d) (ag-cap WW ag-ww (up d) (wc-up a B h d w l) d)
        (wc-w a B h d w l, Ag[ul+].lt-up d (wa-OK (Lf (Cu a B h)) d w))).1, l) ;

-- (5) C' = C u {a}
Cua (a : T) (B : SC.Cl) (h : H430 a B) (y : T) : U ul = SC.Or (Cu a B h y) (Id T y a) ;

cua-or (a : T) (B : SC.Cl) (h : H430 a B) (y : T) (c : Lf (Cua a B h) y) : Or (Lf (Cu a B h) y) (Id T y a) =
  or-up (Cu a B h y) (Id T y a) (Lf (Cu a B h) y) (Id T y a) (\ q -> q) (\ e -> e) c ;

cua-ot (a : T) (B : SC.Cl) (h : H430 a B) : Sub (Lf (Cua a B h)) OTc =
  \ y c -> either (Lf (Cu a B h) y) (Id T y a) (OTc y) (ag-ot (Lf (Cu a B h)) (ag-cu a B h) y)
             (\ e -> tr-B OTc a y (sym e) (h-oa a B h)) (cua-or a B h y c) ;

-- C' n a = C n a
cua-cap (a : T) (B : SC.Cl) (h : H430 a B) : Eqv (Cap (Lf (Cua a B h)) a) (Cap (Lf (Cu a B h)) a) =
  \ y -> (\ q -> (either (Lf (Cu a B h) y) (Id T y a) (Lf (Cu a B h) y) (\ c -> c)
                    (\ e -> absurdB (Lf (Cu a B h) y) (trans (sym (lt-irr a)) (tr-B (\ s -> LT s a) y a e q.2)))
                    (cua-or a B h y q.1), q.2),
          \ q -> (inl q.1, q.2)) ;

cua-ww (a : T) (B : SC.Cl) (h : H430 a B) : Eqv (Cap (Lf (Cua a B h)) a) (Cap WW a) =
  eqv-trans (Cap (Lf (Cua a B h)) a) (Cap (Lf (Cu a B h)) a) (Cap WW a) (cua-cap a B h) (cu-cap a B h) ;

-- W(C') n a c C  and  C c W(C')  (transfer at a)
cua-wc (a : T) (B : SC.Cl) (h : H430 a B) (y : T) (w : WA[ul+].WA (Lf (Cua a B h)) y) (l : LT y a) : Lf (Cu a B h) y =
  wc-c a B h y
    (wa-at (Lf (Cua a B h)) (Lf (Cu a B h)) (cua-ot a B h) (ag-ot (Lf (Cu a B h)) (ag-cu a B h)) a (h-oa a B h)
       (cua-cap a B h) y w (le-of-lt y a l)) l ;
cu-wcua (a : T) (B : SC.Cl) (h : H430 a B) (y : T) (c : Lf (Cu a B h) y) : WA[ul+].WA (Lf (Cua a B h)) y =
  wa-at (Lf (Cu a B h)) (Lf (Cua a B h)) (ag-ot (Lf (Cu a B h)) (ag-cu a B h)) (cua-ot a B h) a (h-oa a B h)
    (eqv-sym (Cap (Lf (Cua a B h)) a) (Cap (Lf (Cu a B h)) a) (cua-cap a B h))
    y (ag-w (Lf (Cu a B h)) (ag-cu a B h) y c) (le-of-lt y a (fw (Lf (Cu a B h) y) (Cap WW a y) (cu-eq a B h y) c).2) ;

-- a in W(C'):  a in M(C'), tau^C'(a) = tau^WW(a) c C
cua-a (a : T) (B : SC.Cl) (h : H430 a B) : WA[ul+].WA (Lf (Cua a B h)) a =
  wa-a (Lf (Cua a B h)) a
    ((h-oa a B h, bw (C a (Lf (Cua a B h)) a) (C a WW a) (ca-cap (Lf (Cua a B h)) WW a (cua-ww a B h) a) (h-ma a B h).2),
     \ y t -> cu-wcua a B h y
                (bw (Lf (Cu a B h) y) (Cap WW a y) (cu-eq a B h y)
                   (tau-ww a B h y (fw (C a (Lf (Cua a B h)) y) (C a WW y) (ca-cap (Lf (Cua a B h)) WW a (cua-ww a B h) y) t.1, t.2),
                    t.2))) ;

-- C' = W(C') n (a+1)
cua-eq (a : T) (B : SC.Cl) (h : H430 a B) : Eqv (Lf (Cua a B h)) (Cap (WA[ul+].WA (Lf (Cua a B h))) (suc a)) =
  \ y -> (\ c -> either (Lf (Cu a B h) y) (Id T y a) (Cap (WA[ul+].WA (Lf (Cua a B h))) (suc a) y)
                   (\ q -> (cu-wcua a B h y q,
                            lt-sx y a (ag-ot (Lf (Cu a B h)) (ag-cu a B h) y q) (h-oa a B h)
                              (fw (Lf (Cu a B h) y) (Cap WW a y) (cu-eq a B h y) q).2))
                   (\ e -> tr-B (Cap (WA[ul+].WA (Lf (Cua a B h))) (suc a)) a y (sym e)
                             (cua-a a B h, lt-suc-self a (h-oa a B h)))
                   (cua-or a B h y c),
          \ q -> le-cases (Lf (Cua a B h)) a y (le-bar y a (wa-OK (Lf (Cua a B h)) y q.1) (h-oa a B h) q.2) (inr (refl a))
                   (\ p -> inl (cua-wc a B h y q.1 p))) ;

rem430 (a : T) (B : SC.Cl) (h : H430 a B) : WW a =
  ww-mk (Cua a B h) (eq-ag (Lf (Cua a B h)) (suc a) (suc-OK a (h-oa a B h)) (cua-eq a B h)) a (inr (refl a)) ;

-- 0 in WW: 4.30 with B empty
Emp (y : T) : U ul = OTTrans[ul].LT y zero ;
h430-zero : H430 zero Emp =
  ((rem49d WW).1,
   (refl true,
    (\ x e -> absurdB (Bar WW zero x) (trans (sym (lt-zero x)) e),
     \ y t -> absurdB (Dn (Lf Emp) y) (trans (sym (lt-zero y)) t.2)))) ;
ww-zero : WW zero = rem430 zero Emp h430-zero ;

------------------------------------------------------------------------
-- Lemma 4.31 (a)

-- P(a) = (a <' I => Omega_a in WW)
Om431 (a : T) : U (ul+) = LT a ii -> WW (omF a) ;

-- B = {Omega_{y+1} | y in A n a}
Bom (A : SC.Cl) (a z : T) : U ul = (y : T) * (SC.Cap A a y * Id T z (omF (suc y))) ;

-- y in A n a (A = ww-set a) is in WW n a
ww-low (a : T) (wa : WW a) (y : T) (q : SC.Cap (ww-set a wa) a y) : Cap WW a y =
  (ww-mk (ww-set a wa) (ww-gag a wa) y q.1, lt-up y a q.2) ;

-- B c WW|Omega_a:  Omega_{y+1} in WW (P(y), 4.29(c)), Omega_{y+1} <=' Omega_a
bom-at (a : T) (wa : WW a) (ih : Sub (Cap WW a) Om431) (la : LT a ii) (y : T) (q : SC.Cap (ww-set a wa) a y)
  : Bar WW (omF a) (omF (suc y)) =
  (rem429c y (ih y (ww-low a wa y q)
                (lt-trans y a ii (ot-T y (ww-ot y (ww-low a wa y q).1)) (ot-T a (ww-ot a wa)) (ot-T ii ok-ii)
                   (ww-low a wa y q).2 la)),
   le-sx (omF (suc y)) (omF a) (omF-OK (suc y) (suc-OK y (ww-ot y (ww-low a wa y q).1))) (omF-OK a (ww-ot a wa))
     (omF-le-mono (suc y) a (ot-T (suc y) (suc-OK y (ww-ot y (ww-low a wa y q).1))) (ot-T a (ww-ot a wa))
        (lt-suc-le y a (ww-ot y (ww-low a wa y q).1) (ww-ot a wa) (ww-low a wa y q).2))) ;
bom-ww (a : T) (wa : WW a) (ih : Sub (Cap WW a) Om431) (la : LT a ii) : Sub (Lf (Bom (ww-set a wa) a)) (Bar WW (omF a)) =
  \ z p -> tr-B (Bar WW (omF a)) (omF (suc p.1)) z (sym p.2.2) (bom-at a wa ih la p.1 p.2.1) ;

-- X downward closed (Def. 4.14(a)), Omega_s in X  =>  s in X  (Omega_s is s or Omega'_s)
om-in (X : Cl) (w : WD X) (s : T) (os : OK s) (h : X (omF s)) : X s =
  boolCases (X s) (fx s)
    (\ t -> tr-B X (omF s) s (omF-fix s t) h)
    (\ f -> wd-o X w (om s) s os (tr-B X (omF s) (om s) (omF-mov s f) h)
              (refl (om s), tr-B OTc (omF s) (om s) (omF-mov s f) (omF-OK s os))) ;

-- y in C^b(WW), y~ = Omega_s  =>  s in C^b(WW)  (C^b(WW) downward closed)
ca-til-s (b : T) (ob : OK b) (y s : T) (os : OK s) (et : Id T (tilde y) (omF s)) (g : C b WW y) : C b WW s =
  om-in (C b WW) (ag-ca WW ag-ww b ob).1.1 s os
    (tr-B (C b WW) (tilde y) (omF s) et (dc-card (C b WW) (ag-ca WW ag-ww b ob).1 y g).1) ;

-- Omega_s = y~ <=' y <' Omega_a  =>  s <' a  (2.12(g))
s-lt (a y s : T) (oa : OK a) (os : OK s) (oy : OK y) (et : Id T (tilde y) (omF s)) (l : LT y (omF a)) : LT s a =
  trans (sym (rem212g s a (ot-T s os) (ot-T a oa)))
    (le-lt (omF s) y (omF a) (trOT (omF s) y (omF a) (omF-OK s os) oy (omF-OK a oa))
       (tr-B (\ u -> Tr (le u y)) (tilde y) (omF s) et (til-le y oy)) l) ;

-- s in C^{Omega_a}(WW) c C^a(WW), s <' a:  s in WW n a = A n a
s-cap (a : T) (wa : WW a) (y s : T) (t : tau WW (omF a) y) (os : OK s) (et : Id T (tilde y) (omF s))
  : SC.Cap (ww-set a wa) a s =
  ((bw (Bar (Lf (ww-set a wa)) a s) (Bar WW a s) ((ww-seg (ww-set a wa) (ww-gag a wa)).2 a (ww-mem a wa) s)
      ((fw (tau WW a s) (Cap WW a s) (rem420 WW ag-ww a wa s)
          (rem47b WW (ag-M WW ag-ww) a (omF a) (ww-ot a wa) (omF-OK a (ww-ot a wa)) (le-omF a (ww-ot a wa)) s
             (ca-til-s (omF a) (omF-OK a (ww-ot a wa)) y s os et t.1),
           s-lt a y s (ww-ot a wa) os (ca-ok (omF a) WW y t.1) et t.2)).1,
       lt-sx s a os (ww-ot a wa) (s-lt a y s (ww-ot a wa) os (ca-ok (omF a) WW y t.1) et t.2))).1,
   lt-dn s a (s-lt a y s (ww-ot a wa) os (ca-ok (omF a) WW y t.1) et t.2)) ;

-- tau^WW(Omega_a) <=' B:  y <' y+ = Omega_{s+1}
tau-bom-at (a : T) (wa : WW a) (y : T) (t : tau WW (omF a) y) (s : T) (os : OK s)
  (et : Id T (tilde y) (omF s)) (eu : Id T (up y) (omF (suc s))) : Dn (Lf (Bom (ww-set a wa) a)) y =
  (omF (suc s),
   ((s, (s-cap a wa y s t os et, refl (omF (suc s)))),
    le-of-lt y (omF (suc s))
      (tr-B (\ u -> LT y u) (up y) (omF (suc s)) eu (Ag[ul+].lt-up y (ca-ok (omF a) WW y t.1))))) ;
tau-bom (a : T) (wa : WW a) : Sub (tau WW (omF a)) (Dn (Lf (Bom (ww-set a wa) a))) =
  \ y t -> tau-bom-at a wa y t (rem214f y (ca-ok (omF a) WW y t.1)).1 (rem214f y (ca-ok (omF a) WW y t.1)).2.1
             (rem214f y (ca-ok (omF a) WW y t.1)).2.2.1 (rem214f y (ca-ok (omF a) WW y t.1)).2.2.2.1 ;

-- Omega_a in M(WW), a not 0, not in Fi:  a in WW n Omega'_a c C^{Omega_a}(WW) (4.7(h)),
-- so Omega'_a in C^{Omega_a}(WW) by its clause (4.4(c))
om-M (a : T) (wa : WW a) (nf : Id Bool (fx a) false) : M WW (omF a) =
  (omF-OK a (ww-ot a wa),
   ca-el-r (omF a) WW (om a) (omF a) (omF-mov a nf)
     (bw (C (omF a) WW (om a)) (Or (Cap WW (omF a) (om a)) (C (omF a) WW a))
        (ca-om (omF a) WW a (tr-B OTc (omF a) (om a) (omF-mov a nf) (omF-OK a (ww-ot a wa))))
        (inr (rem47h (omF a) WW a (ww-ot a wa)
                (wa, tr-B (\ u -> LT a u) (om a) (omF a) (sym (omF-mov a nf)) (lt-om a (ww-ot a wa))))))) ;

-- Omega_a <' Omega_I = I
om-I (a : T) (oa : OK a) (la : LT a ii) : LT (omF a) ii = trans (rem212g a ii (ot-T a oa) (ot-T ii ok-ii)) la ;

h431 (a : T) (wa : WW a) (ih : Sub (Cap WW a) Om431) (la : LT a ii) (nf : Id Bool (fx a) false)
  : H430 (omF a) (Bom (ww-set a wa) a) =
  (om-M a wa nf, (om-I a (ww-ot a wa) la, (bom-ww a wa ih la, tau-bom a wa))) ;

prog431 : Prog WW Om431 =
  \ a wa ih la -> boolCases (WW (omF a)) (fx a)
    (\ t -> tr-B WW a (omF a) (sym (omF-fix a t)) wa)
    (\ f -> rem430 (omF a) (Bom (ww-set a wa) a) (h431 a wa ih la f)) ;

rem431a (x : T) (w : WW x) (l : LT x ii) : WW (omF x) = rem421a WW Om431 ag-ww prog431 x w l ;

------------------------------------------------------------------------
-- Lemma 4.31 (b)

-- the hypotheses at c, d = psi_I e:  c in WW, d in OT, e in C^d(WW), c+1 <' d,
-- y <' d => y^-Fi <=' c
Fb (c e : T) : U (ul+) =
  WW c * (OK (psi ii e) * (C (psi ii e) WW e * (LT (suc c) (psi ii e) *
    ((y : T) -> OK y -> LT y (psi ii e) -> Tr (le (mFi y) c))))) ;
fb-w (c e : T) (f : Fb c e) : WW c = f.1 ;
fb-od (c e : T) (f : Fb c e) : OK (psi ii e) = f.2.1 ;
fb-ce (c e : T) (f : Fb c e) : C (psi ii e) WW e = f.2.2.1 ;
fb-lt (c e : T) (f : Fb c e) : LT (suc c) (psi ii e) = f.2.2.2.1 ;
fb-fi (c e : T) (f : Fb c e) : (y : T) -> OK y -> LT y (psi ii e) -> Tr (le (mFi y) c) = f.2.2.2.2 ;

-- B = {W_n | n : N}, W_n = Omega^n_{c+1}
Bw (c z : T) : U ul = (n : N) * Id T z (omN n (suc c)) ;

-- W_n <' d  (Omega_u <' Omega_d = d for u <' d)
w-lt (c e : T) (f : Fb c e) : (n : N) -> LT (omN n (suc c)) (psi ii e) = split {
  nz -> fb-lt c e f ;
  ns n | r -> trans (rem212g (omN n (suc c)) (psi ii e)
                       (ot-T (omN n (suc c)) (omN-OK n (suc c) (suc-OK c (ww-ot c (fb-w c e f)))))
                       (ot-T (psi ii e) (fb-od c e f))) r } ;

-- 1 = phi_0 0 in WW
ww-one : WW one = rem429b-phi zero zero ww-zero ww-zero ok-one ;

-- W_n in WW:  c+1 (4.29(b)), Omega_{W_n} ((a))
w-ww (c e : T) (f : Fb c e) : (n : N) -> WW (omN n (suc c)) = split {
  nz -> rem429b-sum c one (fb-w c e f) ww-one (suc-OK c (ww-ot c (fb-w c e f))) ;
  ns n | r -> rem431a (omN n (suc c)) r
                (lt-trans (omN n (suc c)) (psi ii e) ii
                   (ot-T (omN n (suc c)) (omN-OK n (suc c) (suc-OK c (ww-ot c (fb-w c e f)))))
                   (ot-T (psi ii e) (fb-od c e f)) (ot-T ii ok-ii)
                   (w-lt c e f n) (lt-TI ii e (refl true))) } ;

-- u <=' v  =>  W(u, n) <=' W(v, n)
w-mono (u v : T) (ou : OK u) (ov : OK v) (h : Tr (le u v)) : (n : N) -> Tr (le (omN n (suc u)) (omN n (suc v))) = split {
  nz -> suc-le-mono u v ou ov h ;
  ns n | r -> omF-le-mono (omN n (suc u)) (omN n (suc v))
                (ot-T (omN n (suc u)) (omN-OK n (suc u) (suc-OK u ou)))
                (ot-T (omN n (suc v)) (omN-OK n (suc v) (suc-OK v ov))) r } ;

-- tau^WW(d) <=' B:  y <' W(y^-Fi, n) <=' W(c, n)  (2.14(i))
fb-dn (c e : T) (f : Fb c e) (y : T) (t : tau WW (psi ii e) y) (r : (n : N) * LT y (omN n (suc (mFi y))))
  : Dn (Lf (Bw c)) y =
  (omN r.1 (suc c),
   ((r.1, refl (omN r.1 (suc c))),
    le-trans y (omN r.1 (suc (mFi y))) (omN r.1 (suc c))
      (trOT y (omN r.1 (suc (mFi y))) (omN r.1 (suc c)) (ca-ok (psi ii e) WW y t.1)
         (omN-OK r.1 (suc (mFi y)) (suc-OK (mFi y) (rem214a y (ca-ok (psi ii e) WW y t.1)).2.2.1))
         (omN-OK r.1 (suc c) (suc-OK c (ww-ot c (fb-w c e f)))))
      (le-of-lt y (omN r.1 (suc (mFi y))) r.2)
      (w-mono (mFi y) c (rem214a y (ca-ok (psi ii e) WW y t.1)).2.2.1 (ww-ot c (fb-w c e f))
         (fb-fi c e f y (ca-ok (psi ii e) WW y t.1) t.2) r.1))) ;

h-fb (c e : T) (f : Fb c e) : H430 (psi ii e) (Bw c) =
  ((fb-od c e f,
    bw (C (psi ii e) WW (psi ii e)) (Or (Cap WW (psi ii e) (psi ii e)) (PsiP (psi ii e) WW ii e))
      (ca-psi (psi ii e) WW ii e (fb-od c e f))
      (inr (psi-lt ii e (fb-od c e f), (ca-I (psi ii e) WW, fb-ce c e f)))),
   (psi-lt ii e (fb-od c e f),
    (\ z p -> tr-B (Bar WW (psi ii e)) (omN p.1 (suc c)) z (sym p.2)
                (w-ww c e f p.1,
                 lt-sx (omN p.1 (suc c)) (psi ii e) (omN-OK p.1 (suc c) (suc-OK c (ww-ot c (fb-w c e f)))) (fb-od c e f)
                   (w-lt c e f p.1)),
     \ y t -> fb-dn c e f y t (rem214i y (ca-ok (psi ii e) WW y t.1))))) ;

fi-ww (c e : T) (f : Fb c e) : WW (psi ii e) = rem430 (psi ii e) (Bw c) (h-fb c e f) ;

-- c = 0, e = 0:  psi_I 0 in OT (computation), 0+1 = 1 <' psi_I 0 (one-lt),
-- y <' psi_I 0 => y^-Fi = 0 (2.14(g))
ok-psiI0 : OK (psi ii zero) = refl true ;
fb0 : Fb zero zero =
  (ww-zero,
   (ok-psiI0,
    (ca-zero (psi ii zero) WW,
     (one-lt one ii zero (refl true),
      \ y oy l -> le-at (mFi y) zero zero zero (rem214g1 y oy l).1 (refl zero) (le-refl zero))))) ;

rem431b0 : WW (psi ii zero) = fi-ww zero zero fb0 ;

-- c = psi_I x, e = x+1
-- y^-Fi = psi_I y' <=' y <' psi_I (x+1)  =>  y' <=' x  (fi-ab)
fi-g2 (x : T) (oc : OK (psi ii x)) (y : T) (oy : OK y) (l : LT y (psi ii (suc x))) (g : G2 y (mFi y) (pFi y))
  : Tr (le (mFi y) (psi ii x)) =
  le-at (mFi y) (psi ii x) (psi ii g.1) (psi ii x) g.2.2.2.1 (refl (psi ii x))
    (le-psiI-mono g.1 x
       (fi-ab y y g.1 x (ot-T y oy) (ot-T y oy) (tr-B OTc (mFi y) (psi ii g.1) g.2.2.2.1 (rem214a y oy).2.2.1) oc (le-refl y)
          (tr-B (\ u -> Tr (le u y)) (mFi y) (psi ii g.1) g.2.2.2.1 g.2.2.2.2.2.1) l)) ;

fi-S (x : T) (oc : OK (psi ii x)) (y : T) (oy : OK y) (l : LT y (psi ii (suc x))) : Tr (le (mFi y) (psi ii x)) =
  boolCases (Tr (le (mFi y) (psi ii x))) (lt y (psi ii zero))
    (\ t -> le-at (mFi y) (psi ii x) zero (psi ii x) (rem214g1 y oy t).1 (refl (psi ii x)) (zero-le-any (psi ii x)))
    (\ n -> fi-g2 x oc y oy l
              (rem214g2 y oy (nlt-le (psi ii zero) y tt-psiI0 (ot-T y oy) n)
                 (lt-trans y (psi ii (suc x)) ii (ot-T y oy) (psiS-T x oc) (ot-T ii ok-ii) l (lt-TI ii (suc x) (refl true))))) ;

-- psi_I x <' psi_I (x+1)
lt-psiS (x : T) (oc : OK (psi ii x)) : LT (psi ii x) (psi ii (suc x)) =
  trans (lt-TT ii x ii (suc x) (refl true) (refl true)) (lt-suc-self x (ot-psi1 ii x oc)) ;

-- x in C^c(WW): c in M(WW), c in C^c(WW) is not by c <' c (4.4(d))
x-in (x : T) (w : WW (psi ii x)) : C (psi ii x) WW x =
  either (Cap WW (psi ii x) (psi ii x)) (PsiP (psi ii x) WW ii x) (C (psi ii x) WW x)
    (\ q -> absurdB (C (psi ii x) WW x) (trans (sym (lt-irr (psi ii x))) q.2))
    (\ p -> p.2.2)
    (fw (C (psi ii x) WW (psi ii x)) (Or (Cap WW (psi ii x) (psi ii x)) (PsiP (psi ii x) WW ii x))
       (ca-psi (psi ii x) WW ii x (ww-ot (psi ii x) w)) (ag-M WW ag-ww (psi ii x) w).2) ;

-- x+1 in C^c(WW): C^c(WW) upward closed, 1 in C^c(WW)
xs-in (x : T) (w : WW (psi ii x)) : C (psi ii x) WW (suc x) =
  uc-sum (C (psi ii x) WW) OTc (ag-ca WW ag-ww (psi ii x) (ww-ot (psi ii x) w)).2 x one (x-in x w)
    (bw (C (psi ii x) WW one) (Or (Cap WW (psi ii x) one) (C (psi ii x) WW zero * C (psi ii x) WW zero))
       (ca-phi (psi ii x) WW zero zero ok-one) (inr (ca-zero (psi ii x) WW, ca-zero (psi ii x) WW)))
    (suc-OK x (ot-psi1 ii x (ww-ot (psi ii x) w))) (suc-OK x (ot-psi1 ii x (ww-ot (psi ii x) w))) ;

-- e in C^d(WW): x+1 in C_I(x) (2.14(k)), 4.7(e) at psi_I x <=' c, d <' I
ce-S (x : T) (w : WW (psi ii x)) : C (psi ii (suc x)) WW (suc x) =
  fw (C (psi ii x) WW (suc x)) (C (psi ii (suc x)) WW (suc x))
    (rem47e WW x (ot-T x (ot-psi1 ii x (ww-ot (psi ii x) w))) (psi ii x) (psi ii (suc x))
       (ww-ot (psi ii x) w, (le-refl (psi ii x), lt-TI ii x (refl true)))
       (rem214k2 ii x (ww-ot (psi ii x) w),
        (le-of-lt (psi ii x) (psi ii (suc x)) (lt-psiS x (ww-ot (psi ii x) w)), lt-TI ii (suc x) (refl true)))
       (suc x) (suc-OK x (ot-psi1 ii x (ww-ot (psi ii x) w)))
       (rem214k1 ii x x (own-inC ii x (ww-ot (psi ii x) w))))
    (xs-in x w) ;

-- c+1 = (c, 1) <' d: its head c is <' d  (suc-A, lt-hd)
lt-sucS (x : T) (oc : OK (psi ii x)) : LT (suc (psi ii x)) (psi ii (suc x)) =
  tr-B (\ u -> LT u (psi ii (suc x))) (plus (psi ii x) one) (suc (psi ii x))
    (sym (suc-A (psi ii x) (refl true) (ot-T (psi ii x) oc)))
    (trans (lt-hd (plus (psi ii x) one) (psi ii (suc x)) (refl true)) (lt-psiS x oc)) ;

fbS (x : T) (w : WW (psi ii x)) : Fb (psi ii x) (suc x) =
  (w,
   (rem214k2 ii x (ww-ot (psi ii x) w),
    (ce-S x w,
     (lt-sucS x (ww-ot (psi ii x) w),
      fi-S x (ww-ot (psi ii x) w))))) ;

rem431b (x : T) (w : WW (psi ii x)) : WW (psi ii (suc x)) = fi-ww (psi ii x) (suc x) (fbS x w) ;
