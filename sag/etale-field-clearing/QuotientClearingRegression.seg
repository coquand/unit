-- Over Z/4, localising at 2 kills 1 although 1 is not in the zero ideal.
-- This forces explicit powers in the pullback and permits a zero target.
-- Also check the s=1, N=0 quasi-inverse and surjectivity edge case.
level l ; open Ring[l] ;
module Z = ZMod4[l] ; module Tr = Truncation[l] ;
module I = RegularIdeal[l] ;
module Nilpotent = QuotientPowerClearing[l].Over[Z.ring,I.zero-ideal Z.ring,\ b -> Z.set b q0,q2] ;
two : Nat = suc (suc zero) ;
kill-one : Nilpotent.Witness q1 = (two,refl q0) ;
one-not-zero : Not (Id Z.ring.R q1 q0) = \ eq -> subst (Z.code q1) eq tt ;
image-one-zero : Id Nilpotent.T.R (Nilpotent.eta.1 q1) Nilpotent.T.z = Nilpotent.vanish q1 kill-one ;
cleared : Tr.Trunc[Nilpotent.Witness q1].carrier = Nilpotent.clear q1 image-one-zero ;
module N = Nilpotent.QuasiInverse[two,q0,refl q0] ;
surjective (x : Nilpotent.T.R) : Tr.Trunc[N.Rep x].carrier = N.onto x ;
module Identity = QuotientPowerClearing[l].Over[Z.ring,I.zero-ideal Z.ring,\ b -> Z.set b q0,q1] ;
module One = Identity.QuasiInverse[zero,q1,refl q0] ;
surjective-one (x : Identity.T.R) : Tr.Trunc[One.Rep x].carrier = One.onto x ;
cleared-zero : Identity.Witness q0 = (zero,refl q0) ;
