-- Compact.seg: N-infinity is searchable (Escardo), hence omniscient, and
-- extensional equality of functions N-infinity -> 2 is decidable.
--
-- For p : N-infinity -> 2 let  e p = (n |-> p (under 0) and .. and p (under n)),
-- a decreasing sequence.  Suppose p (e p) = 1.
--  (A) p (under n) = 1 for all n.  Otherwise e p has a 0 at n, so e p =
--      under m for some m (first zero), and m is where e p first drops,
--      i.e. p (under m) = 0; then p (e p) = p (under m) = 0.
--  (B) p infinity = 1: by (A) e p is constantly 1, so e p = infinity.
--  (C) p x = 1 for all x: otherwise p x = 0; then x has no 0 (a 0 makes
--      x = under m, and p (under m) = 1 by (A)), so x = infinity, and
--      p infinity = 1 by (B).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Decisions[l] ; open NInfty[l] ; open Search[l] ;

module Eps (p : NI -> Bool) {
  seq : Nat -> Bool = split { zero -> p (under zero) ; suc n | r -> and r (p (under (suc n))) } ;
  e : NI = (seq, \ n h -> so-and-l (seq n) (p (under (suc n))) h) ;

  and-false : (b : Bool) -> Id Bool (and b false) false = split { true -> refl false ; false -> refl false } ;
  -- a 0 of p under n is a 0 of e p at n
  seq-false : (n : Nat) -> Id Bool (p (under n)) false -> Id Bool (seq n) false = split {
    zero -> \ f -> f ;
    suc n -> \ f -> transH (apH (and (seq n)) f) (and-false (seq n)) } ;
  -- if e p = under m, then p (under m) = 0
  at-under : (m : Nat) -> Id NI e (under m) -> Id Bool (p (under m)) false = split {
    zero -> \ q -> transH (ni-at e (under zero) q zero) (ltb-self zero) ;
    suc m -> \ q -> substH (\ b -> Id Bool (and b (p (under (suc m)))) false)
      (transH (ni-at e (under (suc m)) q m) (ltb-suc m))
      (transH (ni-at e (under (suc m)) q (suc m)) (ltb-self (suc m))) } ;

  module Hyp (h : Id Bool (p e) true) {
    -- (A)
    all-under (n : Nat) : Id Bool (p (under n)) true =
      cases (\ b -> Id Bool (p (under n)) b -> Id Bool (p (under n)) true) (p (under n))
        (\ t q -> t)
        (\ f q -> absurd (Id Bool (p (under n)) true) (so-false (p (under (First[e].first-zero n (seq-false n f)).1))
          (at-under (First[e].first-zero n (seq-false n f)).1 (First[e].first-zero n (seq-false n f)).2)
          (so-true (p (under (First[e].first-zero n (seq-false n f)).1))
            (transH (symH (apH p (First[e].first-zero n (seq-false n f)).2)) h)))) (refl (p (under n))) ;
    -- (B)
    seq-true : (n : Nat) -> Id Bool (seq n) true = split {
      zero -> all-under zero ;
      suc n | r -> transH (apH (\ b -> and b (p (under (suc n)))) r) (all-under (suc n)) } ;
    at-infty : Id Bool (p infty) true = transH (apH p (symH (ni-eq e infty seq-true))) h ;
    -- (C)
    no-zero (x : NI) (f : Id Bool (p x) false) (n : Nat) : Id Bool (x.1 n) true =
      cases (\ b -> Id Bool (x.1 n) b -> Id Bool (x.1 n) true) (x.1 n)
        (\ t q -> t)
        (\ g q -> absurd (Id Bool (x.1 n) true) (so-false (p x) f (so-true (p x)
          (transH (apH p (First[x].first-zero n g).2) (all-under (First[x].first-zero n g).1))))) (refl (x.1 n)) ;
    all (x : NI) : Id Bool (p x) true =
      cases (\ b -> Id Bool (p x) b -> Id Bool (p x) true) (p x)
        (\ t q -> t)
        (\ f q -> absurd (Id Bool (p x) true) (so-false (p x) f (so-true (p x)
          (transH (apH p (ni-eq x infty (no-zero x f))) at-infty)))) (refl (p x)) ;
  } ;
} ;

-- Theorem: N-infinity is searchable
ni-searchable : Searchable NI = (\ p -> Eps[p].e, \ p h x -> Eps[p].Hyp[h].all x) ;
-- so it is omniscient: for every p, p x = 0 for some x or p x = 1 for all x
ni-omniscient : Omniscient NI = omniscient NI ni-searchable ;
-- and for f, g : N-infinity -> 2, either they differ somewhere or are equal everywhere
ni-decide-eq (f g : NI -> Bool) : Plus ((x : NI) * (Id Bool (f x) (g x) -> Empty)) ((x : NI) -> Id Bool (f x) (g x)) =
  decide-eq NI ni-searchable f g ;
-- products of N-infinity and the Booleans are searchable too
ni2-searchable : Searchable (NI * NI) = product-searchable NI NI ni-searchable ni-searchable ;
