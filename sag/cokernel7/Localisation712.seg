-- SAG Lemma 7.1.2 and Lemma 7.1.8 for U = X, as stated in the paper.
-- X a scheme, M x modules, f : X -> R.  M(X) is a module over the ring
-- X -> R, and its localisation M(X)_f maps to the product of the (M x)_(f x)
-- by m / f^p |-> (x |-> m(x) / f(x)^p).  This map is linear and an
-- equivalence: injective by a uniform exponent (scheme boundedness),
-- surjective by gluing fractions (qc-schemes/FractionSections).  If each
-- M x is weakly quasi-coherent, composing with the canonical equivalences
-- (M x)_(f x) = (M x)^D(f x) gives M(X)_f = M(D(f)).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module NF = NatFin[l] ; module A7 = Alg73[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 Rg : A7.CRing = MD.ring ;
 module RA = A7.RA[Rg] ;
 module S = Schemes[l].Over[R,setR] ;
 module PQ = PointQC[l].Over[Rg] ;
 -- the ring X -> R and the module M(X) over it
 module Fun (X : U l) {
  E (g h : X -> R.R) (p : (x : X) -> Id R.R (g x) (h x)) : Id (X -> R.R) g h = F.funext X (\ x -> R.R) g h p ;
  ring : A7.CRing = new A7.CRing[X -> R.R,F.isSet-Pi X (\ x -> R.R) (\ x -> setR),
   \ x -> Rg.z,\ x -> Rg.o,\ g h x -> Rg.add (g x) (h x),\ g h x -> Rg.mul (g x) (h x),\ g x -> Rg.neg (g x),
   \ a b c -> E _ _ (\ x -> Rg.addA (a x) (b x) (c x)),
   \ a b -> E _ _ (\ x -> Rg.addC (a x) (b x)),
   \ a -> E _ _ (\ x -> Rg.addZ (a x)),
   \ a -> E _ _ (\ x -> Rg.addN (a x)),
   \ a b c -> E _ _ (\ x -> Rg.mulA (a x) (b x) (c x)),
   \ a b -> E _ _ (\ x -> Rg.mulC (a x) (b x)),
   \ a -> E _ _ (\ x -> Rg.mulO (a x)),
   \ a b c -> E _ _ (\ x -> Rg.dist (a x) (b x) (c x))] ;
  pw-at (f : X -> R.R) : (n : Base.Nat) (x : X) -> Id R.R (A7.RA[ring].pw f n x) (RA.pw (f x) n) = split {
   zero -> \ x -> refl Rg.o ;
   suc n | ih -> \ x -> ap (Rg.mul (f x)) (ih x) } ;
  module Mod (Mx : X -> MD.Module) {
   Sec : U l = (x : X) -> (Mx x).M ;
   Q (m m' : Sec) (p : (x : X) -> Id (Mx x).M (m x) (m' x)) : Id Sec m m' = F.funext X (\ x -> (Mx x).M) m m' p ;
   pi : A7.Mod[ring] = new A7.Mod[ring,Sec,
    F.isSet-Pi X (\ x -> (Mx x).M) (\ x -> (Mx x).setM),
    \ x -> (Mx x).mz,
    \ m m' x -> (Mx x).madd (m x) (m' x),
    \ m x -> (Mx x).mneg (m x),
    \ a b c -> Q _ _ (\ x -> (Mx x).maddA (a x) (b x) (c x)),
    \ a b -> Q _ _ (\ x -> (Mx x).maddC (a x) (b x)),
    \ a -> Q _ _ (\ x -> (Mx x).maddZ (a x)),
    \ a -> Q _ _ (\ x -> (Mx x).maddN (a x)),
    \ g m x -> (Mx x).sm (g x) (m x),
    \ g h m -> Q _ _ (\ x -> (Mx x).smA (g x) (h x) (m x)),
    \ m -> Q _ _ (\ x -> (Mx x).smO (m x)),
    \ g m m' -> Q _ _ (\ x -> (Mx x).smD (g x) (m x) (m' x)),
    \ g h m -> Q _ _ (\ x -> (Mx x).smE (g x) (h x) (m x))] ;
  } ;
 } ;
 module At (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module) (f : X -> R.R) {
  module FX = Fun[X] ;
  module MX = FX.Mod[Mx] ;
  module LF = Localisation[l].Over[FX.ring].At[MX.pi,f] ;
  module LFM = LocalisationModule[l].Over[FX.ring].At[MX.pi,f] ;
  module Pt (x : X) {
   module C = Localisation[l].Over[Rg].At[Mx x,f x] ;
   module CM = LocalisationModule[l].Over[Rg].At[Mx x,f x] ;
   module MA = A7.MA[Rg,Mx x] ;
   module MF = ModuleFractions[l].Over[R,setR].At[Mx x,f x] ;
  } ;
  Target : U l = (x : X) -> Pt[x].C.L ;
  set-Target : Pr.isSet Target = F.isSet-Pi X (\ x -> Pt[x].C.L) (\ x -> Pt[x].C.Q.set) ;
  at (y : LF.F) (x : X) : Pt[x].C.F = (y.1 x,y.2) ;
  value (y : LF.F) : Target = \ x -> Pt[x].C.Q.inc (at y x) ;
  -- f^n m, read at x
  sm-at (n : Base.Nat) (m : MX.Sec) (x : X) :
   Id (Mx x).M (MX.pi.sm (A7.RA[FX.ring].pw f n) m x) ((Mx x).sm (RA.pw (f x) n) (m x)) =
   ap (\ a -> (Mx x).sm a (m x)) (FX.pw-at f n x) ;
  num-at (y y' : LF.F) (x : X) : Id (Mx x).M (LF.Num y y' x) (Pt[x].C.Num (at y x) (at y' x)) =
   trans (ap (\ a -> Pt[x].MA.sub a (MX.pi.sm (A7.RA[FX.ring].pw f y.2) y'.1 x)) (sm-at y'.2 y.1 x))
    (ap (Pt[x].MA.sub ((Mx x).sm (RA.pw (f x) y'.2) (y.1 x))) (sm-at y.2 y'.1 x)) ;
  eqv-at (y y' : LF.F) (e : LF.Eqv y y') (x : X) : Pt[x].C.Eqv (at y x) (at y' x) = (e.1,
   trans (ap ((Mx x).sm (RA.pw (f x) e.1)) (sym (num-at y y' x)))
    (trans (sym (sm-at e.1 (LF.Num y y') x)) (ap (\ g -> g x) e.2))) ;
  respect (y y' : LF.F) (h : LF.rel y y') : Id Target (value y) (value y') =
   Tr.Trunc[LF.Eqv y y'].induction @l (\ z -> Id Target (value y) (value y')) (\ z -> set-Target _ _)
    (\ e -> F.funext X (\ x -> Pt[x].C.L) (value y) (value y') (\ x ->
      Pt[x].C.Q.relates (at y x) (at y' x) (Tr.Trunc[Pt[x].C.Eqv (at y x) (at y' x)].inc (eqv-at y y' e x)))) h ;
  module Psi = LF.Q.Descend[Target,set-Target,value,respect] ;
  psi (q : LF.L) : Target = Psi.map q ;
  -- injective: one exponent for all x
  module Inj (y y' : LF.F) (h : Id Target (value y) (value y')) {
   P (x : X) (n : Nat) : U l = MD.Fractions[Mx x].Kills (f x) (Pt[x].C.Num (at y x) (at y' x)) n ;
   module UB = SchemeUniform[l].Over[R,setR,axioms].At[X,scheme,P,
    \ x -> MD.Fractions[Mx x].kills-prop (f x) (Pt[x].C.Num (at y x) (at y' x)),
    \ x -> MD.Fractions[Mx x].kills-up (f x) (Pt[x].C.Num (at y x) (at y' x))] ;
   pointwise (x : X) : Tr.Trunc[UB.Inhabitant x].carrier =
    Tr.Trunc[Pt[x].C.Eqv (at y x) (at y' x)].induction @l (\ z -> Tr.Trunc[UB.Inhabitant x].carrier)
     (\ z -> Tr.Trunc[UB.Inhabitant x].proposition)
     (\ e -> Tr.Trunc[UB.Inhabitant x].inc (NF.fromN e.1,
       trans (ap (\ k -> (Mx x).sm (RA.pw (f x) k) (Pt[x].C.Num (at y x) (at y' x))) (NF.to-from e.1)) e.2))
     (Pt[x].C.Q.effective (at y x) (at y' x) (ap (\ g -> g x) h)) ;
   global (b : UB.Goal) : LF.Eqv y y' = (NF.toN b.1,
    MX.Q _ _ (\ x -> trans (sm-at (NF.toN b.1) (LF.Num y y') x)
     (trans (ap ((Mx x).sm (RA.pw (f x) (NF.toN b.1))) (num-at y y' x)) (b.2 x)))) ;
   result : LF.rel y y' =
    Tr.Trunc[UB.Goal].induction @l (\ z -> LF.rel y y') (\ z -> Tr.Trunc[LF.Eqv y y'].proposition)
     (\ b -> Tr.Trunc[LF.Eqv y y'].inc (global b)) (UB.theorem pointwise) ;
  } ;
  injective (q q' : LF.L) (h : Id Target (psi q) (psi q')) : Id LF.L q q' =
   LF.Q.induction @l (\ q -> Id Target (psi q) (psi q') -> Id LF.L q q')
    (\ q -> F.isProp-Pi _ (\ z -> Id LF.L q q') (\ z -> LF.Q.set _ _))
    (\ y -> LF.Q.induction @l (\ q' -> Id Target (psi (LF.Q.inc y)) (psi q') -> Id LF.L (LF.Q.inc y) q')
      (\ q' -> F.isProp-Pi _ (\ z -> Id LF.L (LF.Q.inc y) q') (\ z -> LF.Q.set _ _))
      (\ y' h' -> LF.Q.relates y y' (Inj[y,y',trans (sym (Psi.beta y)) (trans h' (Psi.beta y'))].result)) q') q h ;
  -- surjective: glue pointwise fractions
  fraction (x : X) (m : (Mx x).M) (k : Nat) : Pt[x].C.L = Pt[x].C.frac m (NF.toN k) ;
  raise (x : X) (d k : Nat) (m : (Mx x).M) :
   Id Pt[x].C.L (fraction x (Iterates[l].On[(Mx x).M,(Mx x).sm (f x)].power d m) (plus d k)) (fraction x m k) =
   trans (ap (\ w -> fraction x w (plus d k)) (Pt[x].MF.power d m))
    (trans (ap (Pt[x].C.frac ((Mx x).sm (RA.pw (f x) (NF.toN d)) m)) (ModuleFractions[l].to-plus d k))
     (Pt[x].CM.same ((Mx x).sm (RA.pw (f x) (NF.toN d)) m,A7.plusN (NF.toN d) (NF.toN k)) (m,NF.toN k)
      (trans (Pt[x].MA.sm-swap (RA.pw (f x) (NF.toN k)) (RA.pw (f x) (NF.toN d)) m)
       (sym (Pt[x].CM.dd (NF.toN d) (NF.toN k) m))))) ;
  detect (x : X) (k : Nat) (u v : (Mx x).M) (p : Id Pt[x].C.L (fraction x u k) (fraction x v k)) :
   Tr.Trunc[(e : Nat) * Id (Mx x).M (Iterates[l].On[(Mx x).M,(Mx x).sm (f x)].power e u)
    (Iterates[l].On[(Mx x).M,(Mx x).sm (f x)].power e v)].carrier =
   Pt[x].MF.same-detect k u v
    (Tr.Trunc[Pt[x].C.Eqv (u,NF.toN k) (v,NF.toN k)].induction @l
     (\ z -> Tr.Trunc[(e : Nat) * MD.Fractions[Mx x].Same (f x) u k v k e].carrier)
     (\ z -> Tr.Trunc[(e : Nat) * MD.Fractions[Mx x].Same (f x) u k v k e].proposition)
     (\ e -> Tr.Trunc[(e : Nat) * MD.Fractions[Mx x].Same (f x) u k v k e].inc (NF.fromN e.1,
       trans (ap (\ j -> (Mx x).sm (RA.pw (f x) j) (Pt[x].C.Num (u,NF.toN k) (v,NF.toN k))) (NF.to-from e.1)) e.2))
     (Pt[x].C.Q.effective (u,NF.toN k) (v,NF.toN k) p)) ;
  module FS = FractionSections[l].Over[R,setR,axioms].At[X,scheme,\ x -> (Mx x).M,\ x -> (Mx x).setM,
   \ x -> (Mx x).sm (f x),\ x -> Pt[x].C.L,\ x -> Pt[x].C.Q.set,fraction].Laws[raise,detect] ;
  represented (t : Target) (x : X) : Tr.Trunc[FS.Section[t].Rep x].carrier =
   Pt[x].C.Q.induction @l (\ q -> Tr.Trunc[(k : Nat) * (m : (Mx x).M) * Id Pt[x].C.L (fraction x m k) q].carrier)
    (\ q -> Tr.Trunc[(k : Nat) * (m : (Mx x).M) * Id Pt[x].C.L (fraction x m k) q].proposition)
    (\ a -> Tr.Trunc[(k : Nat) * (m : (Mx x).M) * Id Pt[x].C.L (fraction x m k) (Pt[x].C.Q.inc a)].inc
      (NF.fromN a.2,a.1,ap (Pt[x].C.frac a.1) (NF.to-from a.2))) (t x) ;
  Fib (t : Target) : U l = (q : LF.L) * Id Target (psi q) t ;
  fib-prop (t : Target) : Pr.isProp (Fib t) = \ a b ->
   Pr.Sigma-eq LF.L (\ q -> Id Target (psi q) t) a.1 b.1 a.2 b.2 (injective a.1 b.1 (trans a.2 (sym b.2))) (set-Target _ _) ;
  fib (t : Target) : Fib t =
   Tr.Trunc[FS.Section[t].Goal].induction @l (\ z -> Fib t) (\ z -> fib-prop t)
    (\ g -> (LF.frac g.2.1 (NF.toN g.1),trans (Psi.beta (g.2.1,NF.toN g.1))
      (F.funext X (\ x -> Pt[x].C.L) _ t g.2.2)))
    (FS.Section[t].theorem (represented t)) ;
  -- Lemma 7.1.2
  equivalence : Pr.isEquiv LF.L Target psi = Pr.qinv LF.L Target psi (\ t -> (fib t).1) (\ t -> (fib t).2)
   (\ q -> injective _ q (fib (psi q)).2) ;
  -- psi is linear over X -> R
  psi-add (q q' : LF.L) : Id Target (psi (LFM.add q q')) (\ x -> Pt[x].CM.add (psi q x) (psi q' x)) =
   LF.Q.induction @l (\ q -> Id Target (psi (LFM.add q q')) (\ x -> Pt[x].CM.add (psi q x) (psi q' x)))
    (\ q -> set-Target _ _) (\ y ->
    LF.Q.induction @l (\ q' -> Id Target (psi (LFM.add (LF.Q.inc y) q')) (\ x -> Pt[x].CM.add (psi (LF.Q.inc y) x) (psi q' x)))
     (\ q' -> set-Target _ _) (\ y' ->
     trans (ap psi (LFM.add-inc y y')) (trans (Psi.beta (LFM.fadd y y'))
      (F.funext X (\ x -> Pt[x].C.L) _ _ (\ x -> trans
       (Pt[x].CM.pair (at (LFM.fadd y y') x) (Pt[x].CM.fadd (at y x) (at y' x))
        (trans (ap (\ a -> (Mx x).madd a (MX.pi.sm (A7.RA[FX.ring].pw f y.2) y'.1 x)) (sm-at y'.2 y.1 x))
         (ap ((Mx x).madd ((Mx x).sm (RA.pw (f x) y'.2) (y.1 x))) (sm-at y.2 y'.1 x)))
        (refl (A7.plusN y.2 y'.2)))
       (trans (sym (Pt[x].CM.add-inc (at y x) (at y' x)))
        (sym (trans (ap (\ a -> Pt[x].CM.add a (psi (LF.Q.inc y') x)) (ap (\ g -> g x) (Psi.beta y)))
         (ap (Pt[x].CM.add (value y x)) (ap (\ g -> g x) (Psi.beta y')))))))))) q') q ;
  psi-scale (g : X -> R.R) (q : LF.L) : Id Target (psi (LFM.scale g q)) (\ x -> Pt[x].CM.scale (g x) (psi q x)) =
   LF.Q.induction @l (\ q -> Id Target (psi (LFM.scale g q)) (\ x -> Pt[x].CM.scale (g x) (psi q x)))
    (\ q -> set-Target _ _) (\ y ->
    trans (ap psi (LFM.Sc[g].D.beta y)) (trans (Psi.beta (LFM.fsc g y))
     (F.funext X (\ x -> Pt[x].C.L) _ _ (\ x -> trans (sym (Pt[x].CM.Sc[g x].D.beta (at y x)))
      (ap (Pt[x].CM.scale (g x)) (sym (ap (\ h -> h x) (Psi.beta y)))))))) q ;
  -- Lemma 7.1.8 for U = X: with weakly quasi-coherent fibres, M(X)_f = M(D(f))
  module Restrict (w : MD.WqcBundle X Mx) {
   Dsec : U l = (x : X) -> RA.unit (f x) -> (Mx x).M ;
   module E (x : X) {
    module W = PQ.At[Mx x] ;
    eq : Pr.isEquiv Pt[x].C.L Pt[x].C.Sec Pt[x].C.phi =
     Pt[x].C.FromQC[(W.from-aff (w x) (f x)).1,(W.from-aff (w x) (f x)).2].equiv ;
   } ;
   to (t : Target) : Dsec = \ x -> Pt[x].C.phi (t x) ;
   from (s : Dsec) : Target = \ x -> (E[x].eq).sec (s x) ;
   pointwise : Pr.Equiv Target Dsec = (to,Pr.qinv Target Dsec to from
    (\ s -> F.funext X (\ x -> RA.unit (f x) -> (Mx x).M) _ s (\ x -> (E[x].eq).sec-eq (s x)))
    (\ t -> F.funext X (\ x -> Pt[x].C.L) _ t (\ x -> Pr.sec-ret _ _ Pt[x].C.phi E[x].eq (t x)))) ;
   theorem : Pr.Equiv LF.L Dsec = Equivalences[l].compose LF.L Target Dsec (psi,equivalence) pointwise ;
  } ;
 } ;
 -- Lemma 7.1.8 for an open U, which need not be affine: U is a scheme
 module Open (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module) (w : MD.WqcBundle X Mx)
  (sub : X -> U l) (op : OpenProp[l].Over[R,setR].OpenSubtype X sub) (f : ((x : X) * sub x) -> R.R) {
  Y : U l = (x : X) * sub x ;
  scheme-Y : S.Scheme Y = SchemeSubtypes[l].Over[R,setR,axioms].open-subtype X scheme sub op ;
  module A = At[Y,scheme-Y,\ y -> Mx y.1,f] ;
  theorem : Pr.Equiv A.LF.L A.Restrict[\ y -> w y.1].Dsec = A.Restrict[\ y -> w y.1].theorem ;
 } ;
} ;
