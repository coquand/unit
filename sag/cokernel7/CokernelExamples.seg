-- Boundary cases for quotient modules: dividing by everything gives one
-- element; dividing by zero loses nothing.  The negative test checks
-- that the quotient does not identify elements by computation.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ;
module Over (Rg : A7.CRing) (P : A7.Mod[Rg]) {
 module MP = A7.MA[Rg,P] ;
 everything : Submodules[l].Submodule[Rg,P] = new Submodules[l].Submodule[Rg,P,\ x -> Top,
  \ x -> isTop,tt,\ x y u v -> tt,\ x u -> tt,\ a x u -> tt] ;
 nothing : Submodules[l].Submodule[Rg,P] = new Submodules[l].Submodule[Rg,P,\ x -> Id P.M x P.mz,
  \ x -> P.setM _ _,refl P.mz,
  \ x y u v -> transH (apH (\ t -> P.madd t y) u) (transH (MP.mzl y) v),
  \ x u -> transH (apH P.mneg u) MP.mneg-z,
  \ a x u -> transH (apH (P.sm a) u) (MP.sm-zr a)] ;
 module All = QuotientModule[l].Over[Rg].Quot[P,everything] ;
 module None = QuotientModule[l].Over[Rg].Quot[P,nothing] ;
 -- P / P has one element
 trivial (q : All.C) : Id All.C q (All.inc P.mz) =
  All.Ind1 (\ q -> Id All.C q (All.inc P.mz)) (\ a -> All.in-kernel a tt) (\ q -> All.Q.set _ _) q ;
 -- P / 0 -> P is injective
 faithful (a b : P.M) (h : Id None.C (None.inc a) (None.inc b)) : Id P.M a b =
  symH (MP.sub-zero b a (None.Q.effective a b h)) ;
 #fails {
  -- a nonzero class is not zero by computation
  false-zero-class (a : P.M) : Id None.C (None.inc a) (None.inc P.mz) = refl (None.inc a) ;
 } ;
} ;
