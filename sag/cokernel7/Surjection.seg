-- The key step of 7.1.13.  Let p : P -> Q be linear and surjective, with
-- kernel K, and let P and K be weakly quasi-coherent.  Then Q is.
--  * A section s of Q over D(r) lifts to P: the preimages of s(d) form a
--    torsor under K, and D(r) = Spec R[1/r] is affine, so Theorem 7.3.6
--    gives a section a over D(r) with p a = s.  Then a = m / r^N, so
--    s = p(m) / r^N.
--  * If p x vanishes on D(r), then x is in K on D(r), so x = k / r^N with
--    k in K; r^N x - k vanishes on D(r) and is killed by some r^K in P,
--    so r^(K+N) p x = 0.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 Rg : A7.CRing = MD.ring ;
 module RA = A7.RA[Rg] ;
 module SM = Submodules[l].Over[Rg] ;
 module PQ = PointQC[l].Over[Rg] ;
 module UA = UnitAffine[l].Over[R,setR] ;
 module At (P Q : SM.Module) (p : SM.Linear P Q) (K : Submodules[l].Submodule[Rg,P])
  (to-K : (x : P.M) -> Id Q.M (p.1 x) Q.mz -> K.S x)
  (from-K : (x : P.M) -> K.S x -> Id Q.M (p.1 x) Q.mz)
  (surj : (y : Q.M) -> Tr.Trunc[(x : P.M) * Id Q.M (p.1 x) y].carrier)
  (wP : PQ.At[P].WQC) (wK : PQ.At[SM.Sub[P,K].carrier].WQC) {
  module L = SM.Lin[P,Q,p] ;
  module KS = SM.Sub[P,K] ;
  module MP = A7.MA[Rg,P] ;
  module MQ = A7.MA[Rg,Q] ;
  module Pt = Affine[l].PtL[Rg,P] ;
  -- (x - y) + y = x, and k + y = x gives k = x - y
  sub-add (x y : P.M) : Id P.M (P.madd (MP.sub x y) y) x =
   transH (symH (P.maddA x (P.mneg y) y))
    (transH (apH (P.madd x) (transH (P.maddC (P.mneg y) y) (P.maddN y))) (P.maddZ x)) ;
  add-sub (k x y : P.M) (h : Id P.M (P.madd k y) x) : Id P.M k (MP.sub x y) = calc P.M {
   k =< symH (P.maddZ k) > P.madd k P.mz
    =< apH (P.madd k) (symH (P.maddN y)) > P.madd k (P.madd y (P.mneg y))
    =< P.maddA k y (P.mneg y) > P.madd (P.madd k y) (P.mneg y)
    =< apH (\ t -> P.madd t (P.mneg y)) h > MP.sub x y } ;
  -- r^N (u^N v) = v when r u = 1
  cancel (r u : Rg.R) (h : Id Rg.R (Rg.mul r u) Rg.o) (N : Nat) (v : P.M) :
   Id P.M (P.sm (RA.pw r N) (P.sm (RA.pw u N) v)) v =
   transH (MP.sm-swap (RA.pw r N) (RA.pw u N) v) (Pt.cancel-pw r u h N v) ;
  module Lift (r : Rg.R) (s : RA.unit r -> Q.M) {
   X : U l = RA.unit r ;
   Mx (d : X) : SM.Module = KS.carrier ;
   module Af = Affine[l].Aff[Rg,X,Mx] ;
   T (d : X) : U l = (x : P.M) * Id Q.M (p.1 x) (s d) ;
   T-eq (d : X) (t t' : T d) (h : Id P.M t.1 t'.1) : Id (T d) t t' =
    Sigma-eq P.M (\ x -> Id Q.M (p.1 x) (s d)) t.1 t'.1 t.2 t'.2 h (Q.setM _ _) ;
   T-set (d : X) : isSet (T d) =
    isSet-Sigma P.M (\ x -> Id Q.M (p.1 x) (s d)) P.setM (\ x -> prop-to-set _ (Q.setM _ _)) ;
   act (d : X) (k : KS.E) (t : T d) : T d = (P.madd k.1 t.1,
    transH (p.2.1 k.1 t.1) (transH (apH (\ y -> Q.madd y (p.1 t.1)) (from-K k.1 k.2))
     (transH (MQ.mzl (p.1 t.1)) t.2))) ;
   diff (d : X) (t t' : T d) : KS.E = (MP.sub t'.1 t.1, to-K (MP.sub t'.1 t.1)
    (transH (L.map-sub t'.1 t.1) (transH (apH (\ y -> MQ.sub y (p.1 t.1)) (transH t'.2 (symH t.2)))
     (MQ.sub-self (p.1 t.1))))) ;
   Moves (d : X) (t t' : T d) : U l = (k : KS.E) * Id (T d) (act d k t) t' ;
   centre (d : X) (t t' : T d) : Moves d t t' = (diff d t t',T-eq d _ _ (sub-add t'.1 t.1)) ;
   contract (d : X) (t t' : T d) (w : Moves d t t') : Id (Moves d t t') (centre d t t') w =
    Sigma-eq KS.E (\ k -> Id (T d) (act d k t) t') _ _ _ _
     (KS.eq _ _ (symH (add-sub w.1.1 t'.1 t.1 (apH (\ v -> v.1) w.2)))) (T-set d _ _) ;
   ts (d : X) : Torsor[l].TorBase[Af.ab d].TorStr (T d) = (act d,T-set d,
    \ a b t -> T-eq d _ _ (symH (P.maddA a.1 b.1 t.1)),
    \ t -> T-eq d _ _ (MP.mzl t.1),
    \ t t' -> (centre d t t',contract d t t'),
    surj (s d)) ;
   w : MD.WqcBundle X Mx = \ d -> PQ.At[KS.carrier].to-aff wK ;
   section : Tr.Trunc[(d : X) -> T d].carrier =
    AffineVanishing[l].Over[R,setR,axioms].Torsors[X,Mx,w,T,ts].presented
     UA.At[r].A UA.At[r].fp UA.At[r].equiv ;
   rep (a : (d : X) -> T d) (e : PQ.At[P].Rep r (\ d -> (a d).1)) : PQ.At[Q].Rep r s =
    (p.1 e.1,e.2.1,\ d -> transH (symH (a d).2)
     (transH (apH p.1 (e.2.2 d)) (p.2.2 (RA.pw d.1 e.2.1) e.1))) ;
   result : Tr.Trunc[PQ.At[Q].Rep r s].carrier =
    Tr.Trunc[(d : X) -> T d].induction @l (\ z -> Tr.Trunc[PQ.At[Q].Rep r s].carrier)
     (\ z -> Tr.Trunc[PQ.At[Q].Rep r s].proposition)
     (\ a -> Tr.Trunc[PQ.At[P].Rep r (\ d -> (a d).1)].induction @l
       (\ z -> Tr.Trunc[PQ.At[Q].Rep r s].carrier) (\ z -> Tr.Trunc[PQ.At[Q].Rep r s].proposition)
       (\ e -> Tr.Trunc[PQ.At[Q].Rep r s].inc (rep a e)) ((wP r).1 (\ d -> (a d).1))) section ;
  } ;
  module Zero (r : Rg.R) (m : Q.M) (v : RA.unit r -> Id Q.M m Q.mz) (x : P.M) (hx : Id Q.M (p.1 x) m) {
   kd (d : RA.unit r) : KS.E = (x,to-K x (transH hx (v d))) ;
   module Rep (e : PQ.At[KS.carrier].Rep r kd) {
    k : P.M = e.1.1 ;
    N : Nat = e.2.1 ;
    z : P.M = MP.sub (P.sm (RA.pw r N) x) k ;
    vanish (d : RA.unit r) : Id P.M z P.mz =
     transH (apH (\ y -> MP.sub (P.sm (RA.pw r N) y) k) (apH (\ u -> u.1) (e.2.2 d)))
      (transH (apH (\ y -> MP.sub y k) (cancel r d.1 d.2 N k)) (MP.sub-self k)) ;
    module Killed (c : PQ.At[P].Kill r z) {
     Kr : Rg.R = RA.pw r c.1 ;
     Nr : Rg.R = RA.pw r N ;
     sub-z (y : Q.M) : Id Q.M (MQ.sub y Q.mz) y = transH (apH (Q.madd y) MQ.mneg-z) (Q.maddZ y) ;
     kill : PQ.At[Q].Kill r m = (A7.plusN c.1 N, calc Q.M {
      Q.sm (RA.pw r (A7.plusN c.1 N)) m =< apH (\ t -> Q.sm t m) (RA.pw-add r c.1 N) > Q.sm (Rg.mul Kr Nr) m
       =< symH (Q.smA Kr Nr m) > Q.sm Kr (Q.sm Nr m)
       =< apH (\ y -> Q.sm Kr (Q.sm Nr y)) (symH hx) > Q.sm Kr (Q.sm Nr (p.1 x))
       =< apH (Q.sm Kr) (symH (p.2.2 Nr x)) > Q.sm Kr (p.1 (P.sm Nr x))
       =< apH (Q.sm Kr) (symH (transH (apH (MQ.sub (p.1 (P.sm Nr x))) (from-K k e.1.2)) (sub-z (p.1 (P.sm Nr x)))))
        > Q.sm Kr (MQ.sub (p.1 (P.sm Nr x)) (p.1 k))
       =< apH (Q.sm Kr) (symH (L.map-sub (P.sm Nr x) k)) > Q.sm Kr (p.1 z)
       =< symH (p.2.2 Kr z) > p.1 (P.sm Kr z)
       =< apH p.1 c.2 > p.1 P.mz
       =< L.map-z > Q.mz }) ;
    } ;
    result : Tr.Trunc[PQ.At[Q].Kill r m].carrier =
     Tr.Trunc[PQ.At[P].Kill r z].induction @l (\ t -> Tr.Trunc[PQ.At[Q].Kill r m].carrier)
      (\ t -> Tr.Trunc[PQ.At[Q].Kill r m].proposition)
      (\ c -> Tr.Trunc[PQ.At[Q].Kill r m].inc Killed[c].kill) ((wP r).2 z vanish) ;
   } ;
   result : Tr.Trunc[PQ.At[Q].Kill r m].carrier =
    Tr.Trunc[PQ.At[KS.carrier].Rep r kd].induction @l (\ t -> Tr.Trunc[PQ.At[Q].Kill r m].carrier)
     (\ t -> Tr.Trunc[PQ.At[Q].Kill r m].proposition) (\ e -> Rep[e].result) ((wK r).1 kd) ;
  } ;
  theorem : PQ.At[Q].WQC = \ r ->
   (\ s -> Lift[r,s].result,
    \ m v -> Tr.Trunc[(x : P.M) * Id Q.M (p.1 x) m].induction @l
     (\ t -> Tr.Trunc[PQ.At[Q].Kill r m].carrier) (\ t -> Tr.Trunc[PQ.At[Q].Kill r m].proposition)
     (\ w -> Zero[r,m,v,w.1,w.2].result) (surj m)) ;
 } ;
} ;
