-- Boundary cases for M_r: at r = 0 every fraction is zero.  The negative
-- test checks that m / 1 and m / r are not identified by computation.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module Over (Rg : A7.CRing) (Md : A7.Mod[Rg]) {
 module MP = A7.MA[Rg,Md] ;
 module Z = Localisation[l].Over[Rg].At[Md,Rg.z] ;
 -- M_0 = 0
 at-zero (m : Md.M) (p : Nat) : Id Z.L (Z.frac m p) (Z.frac Md.mz zero) =
  Z.Q.relates (m,p) (Md.mz,zero) (Tr.Trunc[Z.Eqv (m,p) (Md.mz,zero)].inc (suc zero,
   transH (apH (\ t -> Md.sm t (Z.Num (m,p) (Md.mz,zero))) (Rg.mulO Rg.z)) (MP.sm-zl (Z.Num (m,p) (Md.mz,zero))))) ;
 module G (r : Rg.R) {
  module Lr = Localisation[l].Over[Rg].At[Md,r] ;
  #fails {
   -- m / 1 and m / r are different representatives
   false-same-fraction (m : Md.M) : Id Lr.L (Lr.frac m zero) (Lr.frac m (suc zero)) = refl (Lr.frac m zero) ;
  } ;
 } ;
} ;
