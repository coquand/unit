-- The module structure of M_r: m/r^p + n/r^t = (r^t m + r^p n)/r^(p+t),
-- -(m/r^p) = (-m)/r^p, a (m/r^p) = (a m)/r^p, defined on representatives
-- and descended.  The canonical map M_r -> M^D(r) is linear.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : A7.CRing) {
 module At (Md : A7.Mod[Rg]) (r : Rg.R) {
  module Lc = Localisation[l].Over[Rg].At[Md,r] ;
  open Rg ; open A7.RA[Rg] ; open Md ; open A7.MA[Rg,Md] ;
  F : U l = Lc.F ;
  L : U l = Lc.L ;
  d (p : Nat) : R = pw r p ;
  inc (x : F) : L = Lc.Q.inc x ;
  -- representatives
  fadd (x y : F) : F = (madd (sm (d y.2) x.1) (sm (d x.2) y.1),A7.plusN x.2 y.2) ;
  fneg (x : F) : F = (mneg x.1,x.2) ;
  fsc (a : R) (x : F) : F = (sm a x.1,x.2) ;
  fz : F = (mz,zero) ;
  -- equal pairs, and cross-multiplied numerators
  pair (x y : F) (hn : Id M x.1 y.1) (hd : Id Nat x.2 y.2) : Id L (inc x) (inc y) =
   apH inc (trans F x (y.1,x.2) y (ap M F (\ a -> (a,x.2)) x.1 y.1 hn) (ap Nat F (\ k -> (y.1,k)) x.2 y.2 hd)) ;
  same (x y : F) (h : Id M (sm (d y.2) x.1) (sm (d x.2) y.1)) : Id L (inc x) (inc y) =
   Lc.Q.relates x y (Tr.Trunc[Lc.Eqv x y].inc (zero,transH (smO (Lc.Num x y))
    (transH (apH (\ w -> sub w (sm (d x.2) y.1)) h) (sub-self (sm (d x.2) y.1))))) ;
  -- scalar algebra
  smm (a b : R) (x : M) : Id M (sm (mul a b) x) (sm a (sm b x)) = symH (smA a b x) ;
  dd (p t : Nat) (x : M) : Id M (sm (d (A7.plusN p t)) x) (sm (d p) (sm (d t) x)) =
   transH (apH (\ w -> sm w x) (pw-add r p t)) (smm (d p) (d t) x) ;
  -- a + c - (b + c) = a - b
  cancel-r (a b c : M) : Id M (sub (madd a c) (madd b c)) (sub a b) = calc M {
   madd (madd a c) (mneg (madd b c)) =< apH (madd (madd a c)) (neg-add b c) > madd (madd a c) (madd (mneg b) (mneg c))
    =< swap4 a c (mneg b) (mneg c) > madd (madd a (mneg b)) (madd c (mneg c))
    =< apH (madd (sub a b)) (maddN c) > madd (sub a b) mz
    =< maddZ (sub a b) > sub a b } ;
  -- respect of fadd in the first argument
  module Raise (x x' y : F) {
   p : Nat = x.2 ; p' : Nat = x'.2 ; t : Nat = y.2 ; s : R = d t ;
   num : Id M (Lc.Num (fadd x y) (fadd x' y)) (sm s (sm s (Lc.Num x x'))) = calc M {
    sub (sm (d (A7.plusN p' t)) (madd (sm s x.1) (sm (d p) y.1))) (sm (d (A7.plusN p t)) (madd (sm s x'.1) (sm (d p') y.1)))
     =< apH (\ w -> sub w (sm (d (A7.plusN p t)) (madd (sm s x'.1) (sm (d p') y.1))))
         (transH (dd p' t (madd (sm s x.1) (sm (d p) y.1))) (apH (sm (d p')) (smD s (sm s x.1) (sm (d p) y.1))))
      > sub (sm (d p') (madd (sm s (sm s x.1)) (sm s (sm (d p) y.1)))) (sm (d (A7.plusN p t)) (madd (sm s x'.1) (sm (d p') y.1)))
     =< apH (sub (sm (d p') (madd (sm s (sm s x.1)) (sm s (sm (d p) y.1)))))
         (transH (dd p t (madd (sm s x'.1) (sm (d p') y.1))) (apH (sm (d p)) (smD s (sm s x'.1) (sm (d p') y.1))))
      > sub (sm (d p') (madd (sm s (sm s x.1)) (sm s (sm (d p) y.1)))) (sm (d p) (madd (sm s (sm s x'.1)) (sm s (sm (d p') y.1))))
     =< apH (\ w -> sub w (sm (d p) (madd (sm s (sm s x'.1)) (sm s (sm (d p') y.1))))) (smD (d p') (sm s (sm s x.1)) (sm s (sm (d p) y.1)))
      > sub (madd (sm (d p') (sm s (sm s x.1))) (sm (d p') (sm s (sm (d p) y.1)))) (sm (d p) (madd (sm s (sm s x'.1)) (sm s (sm (d p') y.1))))
     =< apH (sub (madd (sm (d p') (sm s (sm s x.1))) (sm (d p') (sm s (sm (d p) y.1))))) (smD (d p) (sm s (sm s x'.1)) (sm s (sm (d p') y.1)))
      > sub (madd (sm (d p') (sm s (sm s x.1))) (sm (d p') (sm s (sm (d p) y.1)))) (madd (sm (d p) (sm s (sm s x'.1))) (sm (d p) (sm s (sm (d p') y.1))))
     =< apH (\ w -> sub (madd (sm (d p') (sm s (sm s x.1))) w) (madd (sm (d p) (sm s (sm s x'.1))) (sm (d p) (sm s (sm (d p') y.1)))))
         (transH (sm-swap (d p') s (sm (d p) y.1)) (transH (apH (sm s) (sm-swap (d p') (d p) y.1)) (sm-swap s (d p) (sm (d p') y.1))))
      > sub (madd (sm (d p') (sm s (sm s x.1))) (sm (d p) (sm s (sm (d p') y.1)))) (madd (sm (d p) (sm s (sm s x'.1))) (sm (d p) (sm s (sm (d p') y.1))))
     =< cancel-r (sm (d p') (sm s (sm s x.1))) (sm (d p) (sm s (sm s x'.1))) (sm (d p) (sm s (sm (d p') y.1)))
      > sub (sm (d p') (sm s (sm s x.1))) (sm (d p) (sm s (sm s x'.1)))
     =< apH (\ w -> sub w (sm (d p) (sm s (sm s x'.1)))) (transH (sm-swap (d p') s (sm s x.1)) (apH (sm s) (sm-swap (d p') s x.1)))
      > sub (sm s (sm s (sm (d p') x.1))) (sm (d p) (sm s (sm s x'.1)))
     =< apH (sub (sm s (sm s (sm (d p') x.1)))) (transH (sm-swap (d p) s (sm s x'.1)) (apH (sm s) (sm-swap (d p) s x'.1)))
      > sub (sm s (sm s (sm (d p') x.1))) (sm s (sm s (sm (d p) x'.1)))
     =< symH (sm-sub s (sm s (sm (d p') x.1)) (sm s (sm (d p) x'.1)))
      > sm s (sub (sm s (sm (d p') x.1)) (sm s (sm (d p) x'.1)))
     =< apH (sm s) (symH (sm-sub s (sm (d p') x.1) (sm (d p) x'.1))) > sm s (sm s (Lc.Num x x')) } ;
   eqv (e : Lc.Eqv x x') : Lc.Eqv (fadd x y) (fadd x' y) = (e.1,
    transH (apH (sm (d e.1)) num) (transH (sm-swap (d e.1) s (sm s (Lc.Num x x')))
     (transH (apH (sm s) (sm-swap (d e.1) s (Lc.Num x x')))
      (Lc.zero-under s s (sm (d e.1) (Lc.Num x x')) (Lc.zero-under s (d e.1) (Lc.Num x x') e.2))))) ;
  } ;
  add-first (x x' y : F) (h : Lc.rel x x') : Id L (inc (fadd x y)) (inc (fadd x' y)) =
   Lc.Q.relates _ _ (Tr.Trunc[Lc.Eqv x x'].induction @l (\ w -> Lc.rel (fadd x y) (fadd x' y))
    (\ w -> Tr.Trunc[Lc.Eqv (fadd x y) (fadd x' y)].proposition)
    (\ e -> Tr.Trunc[Lc.Eqv (fadd x y) (fadd x' y)].inc (Raise[x,x',y].eqv e)) h) ;
  add-comm (x y : F) : Id L (inc (fadd x y)) (inc (fadd y x)) =
   pair (fadd x y) (fadd y x) (maddC (sm (d y.2) x.1) (sm (d x.2) y.1)) (A7.plusN-comm x.2 y.2) ;
  add-second (x y y' : F) (h : Lc.rel y y') : Id L (inc (fadd x y)) (inc (fadd x y')) =
   transH (add-comm x y) (transH (add-first y y' x h) (add-comm y' x)) ;
  neg-num (x y : F) : Id M (Lc.Num (fneg x) (fneg y)) (mneg (Lc.Num x y)) = calc M {
   sub (sm (d y.2) (mneg x.1)) (sm (d x.2) (mneg y.1))
    =< apH (\ w -> sub w (sm (d x.2) (mneg y.1))) (sm-neg (d y.2) x.1) > sub (mneg (sm (d y.2) x.1)) (sm (d x.2) (mneg y.1))
    =< apH (\ w -> madd (mneg (sm (d y.2) x.1)) (mneg w)) (sm-neg (d x.2) y.1)
     > madd (mneg (sm (d y.2) x.1)) (mneg (mneg (sm (d x.2) y.1)))
    =< symH (neg-add (sm (d y.2) x.1) (mneg (sm (d x.2) y.1))) > mneg (Lc.Num x y) } ;
  neg-respect (x y : F) (h : Lc.rel x y) : Id L (inc (fneg x)) (inc (fneg y)) =
   Lc.Q.relates _ _ (Tr.Trunc[Lc.Eqv x y].induction @l (\ w -> Lc.rel (fneg x) (fneg y))
    (\ w -> Tr.Trunc[Lc.Eqv (fneg x) (fneg y)].proposition)
    (\ e -> Tr.Trunc[Lc.Eqv (fneg x) (fneg y)].inc (e.1,transH (apH (sm (d e.1)) (neg-num x y))
      (transH (sm-neg (d e.1) (Lc.Num x y)) (transH (apH mneg e.2) mneg-z)))) h) ;
  sc-num (c : R) (x y : F) : Id M (Lc.Num (fsc c x) (fsc c y)) (sm c (Lc.Num x y)) =
   transH (apH (\ w -> sub w (sm (d x.2) (sm c y.1))) (sm-swap (d y.2) c x.1))
    (transH (apH (sub (sm c (sm (d y.2) x.1))) (sm-swap (d x.2) c y.1))
     (symH (sm-sub c (sm (d y.2) x.1) (sm (d x.2) y.1)))) ;
  sc-respect (c : R) (x y : F) (h : Lc.rel x y) : Id L (inc (fsc c x)) (inc (fsc c y)) =
   Lc.Q.relates _ _ (Tr.Trunc[Lc.Eqv x y].induction @l (\ w -> Lc.rel (fsc c x) (fsc c y))
    (\ w -> Tr.Trunc[Lc.Eqv (fsc c x) (fsc c y)].proposition)
    (\ e -> Tr.Trunc[Lc.Eqv (fsc c x) (fsc c y)].inc (e.1,transH (apH (sm (d e.1)) (sc-num c x y))
      (transH (sm-swap (d e.1) c (Lc.Num x y)) (Lc.zero-under c (d e.1) (Lc.Num x y) e.2)))) h) ;
  -- the operations on M_r
  module AddL (y : F) { module D = Lc.Q.Descend[L,Lc.Q.set,\ x -> inc (fadd x y),\ x x' h -> add-first x x' y h] ; } ;
  addL-eq (y y' : F) (h : Lc.rel y y') (q : L) : Id L (AddL[y].D.map q) (AddL[y'].D.map q) =
   Lc.Q.induction @l (\ q -> Id L (AddL[y].D.map q) (AddL[y'].D.map q)) (\ q -> Lc.Q.set _ _)
    (\ x -> transH (AddL[y].D.beta x) (transH (add-second x y y' h) (symH (AddL[y'].D.beta x)))) q ;
  module Add = Lc.Q.Descend[L -> L,FL.isSet-Pi L (\ q -> L) (\ q -> Lc.Q.set),\ y -> AddL[y].D.map,
   \ y y' h -> FL.funext L (\ q -> L) _ _ (addL-eq y y' h)] ;
  add (q q' : L) : L = Add.map q' q ;
  add-inc (x y : F) : Id L (add (inc x) (inc y)) (inc (fadd x y)) =
   transH (apH (\ h -> h (inc x)) (Add.beta y)) (AddL[y].D.beta x) ;
  module Neg = Lc.Q.Descend[L,Lc.Q.set,\ x -> inc (fneg x),neg-respect] ;
  neg (q : L) : L = Neg.map q ;
  module Sc (c : R) { module D = Lc.Q.Descend[L,Lc.Q.set,\ x -> inc (fsc c x),sc-respect c] ; } ;
  scale (c : R) (q : L) : L = Sc[c].D.map q ;
  -- laws on representatives
  rA (x y z : F) : Id L (inc (fadd x (fadd y z))) (inc (fadd (fadd x y) z)) =
   pair (fadd x (fadd y z)) (fadd (fadd x y) z) (calc M {
    madd (sm (d (A7.plusN y.2 z.2)) x.1) (sm (d x.2) (madd (sm (d z.2) y.1) (sm (d y.2) z.1)))
     =< apH (\ w -> madd w (sm (d x.2) (madd (sm (d z.2) y.1) (sm (d y.2) z.1)))) (transH (dd y.2 z.2 x.1) (sm-swap (d y.2) (d z.2) x.1))
      > madd (sm (d z.2) (sm (d y.2) x.1)) (sm (d x.2) (madd (sm (d z.2) y.1) (sm (d y.2) z.1)))
     =< apH (madd (sm (d z.2) (sm (d y.2) x.1))) (smD (d x.2) (sm (d z.2) y.1) (sm (d y.2) z.1))
      > madd (sm (d z.2) (sm (d y.2) x.1)) (madd (sm (d x.2) (sm (d z.2) y.1)) (sm (d x.2) (sm (d y.2) z.1)))
     =< maddA (sm (d z.2) (sm (d y.2) x.1)) (sm (d x.2) (sm (d z.2) y.1)) (sm (d x.2) (sm (d y.2) z.1))
      > madd (madd (sm (d z.2) (sm (d y.2) x.1)) (sm (d x.2) (sm (d z.2) y.1))) (sm (d x.2) (sm (d y.2) z.1))
     =< apH (\ w -> madd (madd (sm (d z.2) (sm (d y.2) x.1)) w) (sm (d x.2) (sm (d y.2) z.1))) (sm-swap (d x.2) (d z.2) y.1)
      > madd (madd (sm (d z.2) (sm (d y.2) x.1)) (sm (d z.2) (sm (d x.2) y.1))) (sm (d x.2) (sm (d y.2) z.1))
     =< apH (\ w -> madd w (sm (d x.2) (sm (d y.2) z.1))) (symH (smD (d z.2) (sm (d y.2) x.1) (sm (d x.2) y.1)))
      > madd (sm (d z.2) (madd (sm (d y.2) x.1) (sm (d x.2) y.1))) (sm (d x.2) (sm (d y.2) z.1))
     =< apH (madd (sm (d z.2) (madd (sm (d y.2) x.1) (sm (d x.2) y.1)))) (symH (dd x.2 y.2 z.1))
      > madd (sm (d z.2) (madd (sm (d y.2) x.1) (sm (d x.2) y.1))) (sm (d (A7.plusN x.2 y.2)) z.1) })
    (symH (A7.plusN-assoc x.2 y.2 z.2)) ;
  rZ (x : F) : Id L (inc (fadd x fz)) (inc x) = pair (fadd x fz) x
   (transH (apH (\ w -> madd w (sm (d x.2) mz)) (smO x.1)) (transH (apH (madd x.1) (sm-zr (d x.2))) (maddZ x.1)))
   (A7.plusN-zero x.2) ;
  rN (x : F) : Id L (inc (fadd x (fneg x))) (inc fz) = same (fadd x (fneg x)) fz
   (transH (smO (madd (sm (d x.2) x.1) (sm (d x.2) (mneg x.1))))
    (transH (apH (madd (sm (d x.2) x.1)) (sm-neg (d x.2) x.1))
     (transH (maddN (sm (d x.2) x.1)) (symH (sm-zr (d (A7.plusN x.2 x.2))))))) ;
  rSA (a b : R) (x : F) : Id L (inc (fsc a (fsc b x))) (inc (fsc (mul a b) x)) =
   pair (fsc a (fsc b x)) (fsc (mul a b) x) (smA a b x.1) (refl x.2) ;
  rSO (x : F) : Id L (inc (fsc o x)) (inc x) = pair (fsc o x) x (smO x.1) (refl x.2) ;
  rSD (c : R) (x y : F) : Id L (inc (fsc c (fadd x y))) (inc (fadd (fsc c x) (fsc c y))) =
   pair (fsc c (fadd x y)) (fadd (fsc c x) (fsc c y))
    (transH (smD c (sm (d y.2) x.1) (sm (d x.2) y.1))
     (transH (apH (\ w -> madd w (sm c (sm (d x.2) y.1))) (sm-swap c (d y.2) x.1))
      (apH (madd (sm (d y.2) (sm c x.1))) (sm-swap c (d x.2) y.1))))
    (refl (A7.plusN x.2 y.2)) ;
  rSE (a b : R) (x : F) : Id L (inc (fsc (Rg.add a b) x)) (inc (fadd (fsc a x) (fsc b x))) =
   same (fsc (Rg.add a b) x) (fadd (fsc a x) (fsc b x)) (calc M {
    sm (d (A7.plusN x.2 x.2)) (sm (Rg.add a b) x.1) =< dd x.2 x.2 (sm (Rg.add a b) x.1)
     > sm (d x.2) (sm (d x.2) (sm (Rg.add a b) x.1))
    =< apH (\ w -> sm (d x.2) (sm (d x.2) w)) (smE a b x.1) > sm (d x.2) (sm (d x.2) (madd (sm a x.1) (sm b x.1)))
    =< apH (sm (d x.2)) (smD (d x.2) (sm a x.1) (sm b x.1)) > sm (d x.2) (madd (sm (d x.2) (sm a x.1)) (sm (d x.2) (sm b x.1))) }) ;
  -- the laws on M_r
  P1 (G : L -> U l) (h : (x : F) -> G (inc x)) (pr : (q : L) -> isProp (G q)) (q : L) : G q =
   Lc.Q.induction @l G pr h q ;
  lA (q q' q'' : L) : Id L (add q (add q' q'')) (add (add q q') q'') =
   P1 (\ q -> Id L (add q (add q' q'')) (add (add q q') q'')) (\ x ->
    P1 (\ q' -> Id L (add (inc x) (add q' q'')) (add (add (inc x) q') q'')) (\ y ->
     P1 (\ q'' -> Id L (add (inc x) (add (inc y) q'')) (add (add (inc x) (inc y)) q'')) (\ z ->
      transH (apH (add (inc x)) (add-inc y z)) (transH (add-inc x (fadd y z)) (transH (rA x y z)
       (transH (symH (add-inc (fadd x y) z)) (apH (\ t -> add t (inc z)) (symH (add-inc x y)))))))
      (\ q'' -> Lc.Q.set _ _) q'') (\ q' -> Lc.Q.set _ _) q') (\ q -> Lc.Q.set _ _) q ;
  lC (q q' : L) : Id L (add q q') (add q' q) =
   P1 (\ q -> Id L (add q q') (add q' q)) (\ x ->
    P1 (\ q' -> Id L (add (inc x) q') (add q' (inc x))) (\ y ->
     transH (add-inc x y) (transH (add-comm x y) (symH (add-inc y x)))) (\ q' -> Lc.Q.set _ _) q')
    (\ q -> Lc.Q.set _ _) q ;
  lZ (q : L) : Id L (add q (inc fz)) q =
   P1 (\ q -> Id L (add q (inc fz)) q) (\ x -> transH (add-inc x fz) (rZ x)) (\ q -> Lc.Q.set _ _) q ;
  lN (q : L) : Id L (add q (neg q)) (inc fz) =
   P1 (\ q -> Id L (add q (neg q)) (inc fz)) (\ x ->
    transH (apH (add (inc x)) (Neg.beta x)) (transH (add-inc x (fneg x)) (rN x))) (\ q -> Lc.Q.set _ _) q ;
  lSA (a b : R) (q : L) : Id L (scale a (scale b q)) (scale (mul a b) q) =
   P1 (\ q -> Id L (scale a (scale b q)) (scale (mul a b) q)) (\ x ->
    transH (apH (scale a) (Sc[b].D.beta x)) (transH (Sc[a].D.beta (fsc b x))
     (transH (rSA a b x) (symH (Sc[mul a b].D.beta x))))) (\ q -> Lc.Q.set _ _) q ;
  lSO (q : L) : Id L (scale o q) q =
   P1 (\ q -> Id L (scale o q) q) (\ x -> transH (Sc[o].D.beta x) (rSO x)) (\ q -> Lc.Q.set _ _) q ;
  lSD (c : R) (q q' : L) : Id L (scale c (add q q')) (add (scale c q) (scale c q')) =
   P1 (\ q -> Id L (scale c (add q q')) (add (scale c q) (scale c q'))) (\ x ->
    P1 (\ q' -> Id L (scale c (add (inc x) q')) (add (scale c (inc x)) (scale c q'))) (\ y ->
     transH (apH (scale c) (add-inc x y)) (transH (Sc[c].D.beta (fadd x y)) (transH (rSD c x y)
      (transH (symH (add-inc (fsc c x) (fsc c y)))
       (transH (apH (\ t -> add t (inc (fsc c y))) (symH (Sc[c].D.beta x)))
        (apH (add (scale c (inc x))) (symH (Sc[c].D.beta y))))))))
     (\ q' -> Lc.Q.set _ _) q') (\ q -> Lc.Q.set _ _) q ;
  lSE (a b : R) (q : L) : Id L (scale (Rg.add a b) q) (add (scale a q) (scale b q)) =
   P1 (\ q -> Id L (scale (Rg.add a b) q) (add (scale a q) (scale b q))) (\ x ->
    transH (Sc[Rg.add a b].D.beta x) (transH (rSE a b x)
     (transH (symH (add-inc (fsc a x) (fsc b x)))
      (transH (apH (\ t -> add t (inc (fsc b x))) (symH (Sc[a].D.beta x)))
       (apH (add (scale a (inc x))) (symH (Sc[b].D.beta x))))))) (\ q -> Lc.Q.set _ _) q ;
  -- M_r as a module
  carrier : A7.Mod[Rg] = new A7.Mod[Rg,L,Lc.Q.set,inc fz,add,neg,lA,lC,lZ,lN,
   scale,lSA,lSO,lSD,lSE] ;
  -- the canonical map M_r -> M^D(r) is linear
  phi-add (q q' : L) : Id Lc.Sec (Lc.phi (add q q')) (\ u -> madd (Lc.phi q u) (Lc.phi q' u)) =
   P1 (\ q -> Id Lc.Sec (Lc.phi (add q q')) (\ u -> madd (Lc.phi q u) (Lc.phi q' u))) (\ x ->
    P1 (\ q' -> Id Lc.Sec (Lc.phi (add (inc x) q')) (\ u -> madd (Lc.phi (inc x) u) (Lc.phi q' u))) (\ y ->
     transH (apH Lc.phi (add-inc x y)) (transH (Lc.Phi.beta (fadd x y))
      (transH (FL.funext Lc.D (\ u -> M) (Lc.value (fadd x y)) (\ u -> madd (Lc.value x u) (Lc.value y u)) (\ u -> calc M {
        sm (pw u.1 (A7.plusN x.2 y.2)) (madd (sm (d y.2) x.1) (sm (d x.2) y.1))
         =< transH (apH (\ w -> sm w (madd (sm (d y.2) x.1) (sm (d x.2) y.1))) (pw-add u.1 x.2 y.2))
             (smm (pw u.1 x.2) (pw u.1 y.2) (madd (sm (d y.2) x.1) (sm (d x.2) y.1)))
          > sm (pw u.1 x.2) (sm (pw u.1 y.2) (madd (sm (d y.2) x.1) (sm (d x.2) y.1)))
         =< apH (sm (pw u.1 x.2)) (smD (pw u.1 y.2) (sm (d y.2) x.1) (sm (d x.2) y.1))
          > sm (pw u.1 x.2) (madd (sm (pw u.1 y.2) (sm (d y.2) x.1)) (sm (pw u.1 y.2) (sm (d x.2) y.1)))
         =< smD (pw u.1 x.2) (sm (pw u.1 y.2) (sm (d y.2) x.1)) (sm (pw u.1 y.2) (sm (d x.2) y.1))
          > madd (sm (pw u.1 x.2) (sm (pw u.1 y.2) (sm (d y.2) x.1))) (sm (pw u.1 x.2) (sm (pw u.1 y.2) (sm (d x.2) y.1)))
         =< apH (\ w -> madd (sm (pw u.1 x.2) w) (sm (pw u.1 x.2) (sm (pw u.1 y.2) (sm (d x.2) y.1))))
             (Affine[l].PtL[Rg,Md].cancel-pw r u.1 u.2 y.2 x.1)
          > madd (sm (pw u.1 x.2) x.1) (sm (pw u.1 x.2) (sm (pw u.1 y.2) (sm (d x.2) y.1)))
         =< apH (madd (sm (pw u.1 x.2) x.1)) (Lc.cancel u y.2 x.2 y.1)
          > madd (sm (pw u.1 x.2) x.1) (sm (pw u.1 y.2) y.1) }))
       (FL.funext Lc.D (\ u -> M) (\ u -> madd (Lc.value x u) (Lc.value y u)) (\ u -> madd (Lc.phi (inc x) u) (Lc.phi (inc y) u)) (\ u -> symH (transH
         (apH (\ w -> madd w (Lc.phi (inc y) u)) (apH (\ g -> g u) (Lc.Phi.beta x)))
         (apH (madd (Lc.value x u)) (apH (\ g -> g u) (Lc.Phi.beta y)))))))))
     (\ q' -> Lc.set-Sec _ _) q') (\ q -> Lc.set-Sec _ _) q ;
  phi-scale (c : R) (q : L) : Id Lc.Sec (Lc.phi (scale c q)) (\ u -> sm c (Lc.phi q u)) =
   P1 (\ q -> Id Lc.Sec (Lc.phi (scale c q)) (\ u -> sm c (Lc.phi q u))) (\ x ->
    transH (apH Lc.phi (Sc[c].D.beta x)) (transH (Lc.Phi.beta (fsc c x))
     (FL.funext Lc.D (\ u -> M) _ _ (\ u -> transH (sm-swap (pw u.1 x.2) c x.1)
      (apH (sm c) (symH (apH (\ g -> g u) (Lc.Phi.beta x))))))))
    (\ q -> Lc.set-Sec _ _) q ;
 } ;
} ;
