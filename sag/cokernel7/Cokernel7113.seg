-- SAG Proposition 7.1.13: the cokernel N / f(M) of a linear map
-- f : M -> N of weakly quasi-coherent modules is weakly quasi-coherent.
-- Two applications of Surjection: M -> f(M) has kernel ker f (7.1.6), so
-- f(M) is weakly quasi-coherent; N -> N / f(M) has kernel f(M).  The
-- paper's detour through embeddings and M / ker f is not needed.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 Rg : A7.CRing = MD.ring ;
 module SM = Submodules[l].Over[Rg] ;
 module PQ = PointQC[l].Over[Rg] ;
 module SJ = Surjection[l].Over[R,setR,axioms] ;
 -- 7.1.6 in the form of Modules.WeaklyQC
 kernel (M N : MD.Module) (f : SM.Linear M N) (wM : MD.WeaklyQC M) (wN : MD.WeaklyQC N) :
  MD.WeaklyQC (SM.Sub[M,SM.Kernel[M,N,f].sub].carrier) =
  PQ.At[SM.Sub[M,SM.Kernel[M,N,f].sub].carrier].to-aff
   (Kernel716[l].Over[Rg].At[M,N,f,PQ.At[M].from-aff wM,PQ.At[N].from-aff wN].theorem) ;
 module At (M N : MD.Module) (f : SM.Linear M N) (wM : MD.WeaklyQC M) (wN : MD.WeaklyQC N) {
  wM' : PQ.At[M].WQC = PQ.At[M].from-aff wM ;
  wN' : PQ.At[N].WQC = PQ.At[N].from-aff wN ;
  module Ker = SM.Kernel[M,N,f] ;
  module Im = SM.Image[M,N,f] ;
  wKer : PQ.At[SM.Sub[M,Ker.sub].carrier].WQC = Kernel716[l].Over[Rg].At[M,N,f,wM',wN'].theorem ;
  image : MD.Module = Im.I.carrier ;
  wIm : PQ.At[image].WQC = SJ.At[M,image,Im.onto,Ker.sub,Im.onto-kernel,Im.kernel-onto,
   Im.onto-surjective,wM',wKer].theorem ;
  module Co = QuotientModule[l].Over[Rg].Quot[N,Im.sub] ;
  cokernel : MD.Module = Co.carrier ;
  wCo : PQ.At[cokernel].WQC = SJ.At[N,cokernel,Co.projection,Im.sub,Co.kernel,Co.in-kernel,
   Co.surjective,wN',wIm].theorem ;
  -- 7.1.13
  theorem : MD.WeaklyQC cokernel = PQ.At[cokernel].to-aff wCo ;
  -- and the image, on the way
  image-qc : MD.WeaklyQC image = PQ.At[image].to-aff wIm ;
 } ;
} ;
