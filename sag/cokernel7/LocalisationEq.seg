-- Lemmas 7.1.2 and 7.1.8 as equalities in the type of modules over the
-- ring X -> R, from the linear equivalences of Localisation712 and the
-- structure identity principle (ModuleSIP).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module A7 = Alg73[l] ;
module G = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module RA = A7.RA[MD.ring] ;
 module S = Schemes[l].Over[R,setR] ;
 module L712 = Localisation712[l].Over[R,setR,axioms] ;
 module At (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module) (f : X -> R.R) {
  module L = L712.At[X,scheme,Mx,f] ;
  Mod : U l+ = A7.Mod[L.FX.ring] ;
  -- the product of a family of modules, over X -> R
  pim (fam : X -> MD.Module) : Mod = L.FX.Mod[fam].pi ;
  -- 7.1.2: M(X)_f = prod_x (M x)_(f x)
  lemma-7-1-2 : Id Mod L.LFM.carrier (pim (\ x -> L.Pt[x].CM.carrier)) =
   ModuleSIP[l].Over[L.FX.ring].sip L.LFM.carrier (pim (\ x -> L.Pt[x].CM.carrier))
    ((L.psi,L.equivalence),L.psi-add,L.psi-scale) ;
  -- 7.1.8 for U = X: M(X)_f = M(D(f)), for weakly quasi-coherent fibres
  module Restrict (w : MD.WqcBundle X Mx) {
   module Rs = L.Restrict[w] ;
   Dmod (x : X) : MD.Module = MD.pi (RA.unit (f x)) (\ d -> Mx x) ;
   at (x : X) : Id MD.Module L.Pt[x].CM.carrier (Dmod x) =
    ModuleSIP[l].Over[MD.ring].sip L.Pt[x].CM.carrier (Dmod x)
     ((L.Pt[x].C.phi,Rs.E[x].eq),L.Pt[x].CM.phi-add,L.Pt[x].CM.phi-scale) ;
   lemma-7-1-8 : Id Mod L.LFM.carrier (pim Dmod) =
    P1.trans Mod L.LFM.carrier (pim (\ x -> L.Pt[x].CM.carrier)) (pim Dmod) lemma-7-1-2
     (P1.ap (X -> MD.Module) Mod pim (\ x -> L.Pt[x].CM.carrier) Dmod
      (G.funext X (\ x -> MD.Module) (\ x -> L.Pt[x].CM.carrier) Dmod at)) ;
  } ;
 } ;
 -- 7.1.8 for an open U: apply the above to the scheme U
 module Open (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module) (w : MD.WqcBundle X Mx)
  (sub : X -> U l) (op : OpenProp[l].Over[R,setR].OpenSubtype X sub) (f : ((x : X) * sub x) -> R.R) {
  module O = L712.Open[X,scheme,Mx,w,sub,op,f] ;
  module A = At[O.Y,O.scheme-Y,\ y -> Mx y.1,f] ;
  lemma-7-1-8 : Id A.Mod A.L.LFM.carrier (A.pim A.Restrict[\ y -> w y.1].Dmod) = A.Restrict[\ y -> w y.1].lemma-7-1-8 ;
 } ;
} ;
