-- SAG Lemma 7.1.6: the kernel of a linear map f : P -> Q of weakly
-- quasi-coherent modules is weakly quasi-coherent.  No localised module
-- is needed.  A section s of the kernel over D(r) is m / r^N with m in P;
-- f m vanishes on D(r), so r^K f m = 0, and s = (r^K m) / r^(K+N) with
-- r^K m in the kernel.  The zero clause is the one of P.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module Over (Rg : A7.CRing) {
 module RA = A7.RA[Rg] ;
 module SM = Submodules[l].Over[Rg] ;
 module PQ = PointQC[l].Over[Rg] ;
 module At (P Q : SM.Module) (f : SM.Linear P Q) (wP : PQ.At[P].WQC) (wQ : PQ.At[Q].WQC) {
  module L = SM.Lin[P,Q,f] ;
  module Ker = SM.Kernel[P,Q,f] ;
  module KS = SM.Sub[P,Ker.sub] ;
  module KQ = PQ.At[KS.carrier] ;
  module MQ = A7.MA[Rg,Q] ;
  module Pt = Affine[l].PtL[Rg,P] ;
  -- u^N x = 0 with u r = 1 gives x = 0
  cancel (r : Rg.R) (d : RA.unit r) (N : Nat) (x : Q.M) (h : Id Q.M (Q.sm (RA.pw d.1 N) x) Q.mz) : Id Q.M x Q.mz =
   MQ.unit-kill (RA.pw d.1 N) (RA.pw r N) (transH (Rg.mulC (RA.pw d.1 N) (RA.pw r N)) (RA.unit-pw r d.1 d.2 N)) x h ;
  module Rep (r : Rg.R) (s : RA.unit r -> KS.E) (a : PQ.At[P].Rep r (\ d -> (s d).1)) {
   m : P.M = a.1 ;
   N : Nat = a.2.1 ;
   vanish (d : RA.unit r) : Id Q.M (f.1 m) Q.mz = cancel r d N (f.1 m)
    (transH (symH (f.2.2 (RA.pw d.1 N) m)) (transH (apH f.1 (symH (a.2.2 d))) (s d).2)) ;
   module Raised (k : PQ.At[Q].Kill r (f.1 m)) {
    m' : P.M = P.sm (RA.pw r k.1) m ;
    in-ker : Ker.S m' = transH (f.2.2 (RA.pw r k.1) m) k.2 ;
    rep : KQ.Rep r s = ((m',in-ker),A7.plusN k.1 N,
     \ d -> KS.eq _ _ (transH (a.2.2 d) (symH (Pt.raise r d.1 d.2 k.1 N m)))) ;
   } ;
   result : Tr.Trunc[KQ.Rep r s].carrier =
    Tr.Trunc[PQ.At[Q].Kill r (f.1 m)].induction @l (\ z -> Tr.Trunc[KQ.Rep r s].carrier)
     (\ z -> Tr.Trunc[KQ.Rep r s].proposition)
     (\ k -> Tr.Trunc[KQ.Rep r s].inc (Raised[k].rep)) ((wQ r).2 (f.1 m) vanish) ;
  } ;
  theorem : KQ.WQC = \ r ->
   (\ s -> Tr.Trunc[PQ.At[P].Rep r (\ d -> (s d).1)].induction @l (\ z -> Tr.Trunc[KQ.Rep r s].carrier)
     (\ z -> Tr.Trunc[KQ.Rep r s].proposition) (\ a -> Rep[r,s,a].result)
     ((wP r).1 (\ d -> (s d).1)),
    \ m v -> Tr.Trunc[PQ.At[P].Kill r m.1].induction @l (\ z -> Tr.Trunc[KQ.Kill r m].carrier)
     (\ z -> Tr.Trunc[KQ.Kill r m].proposition)
     (\ k -> Tr.Trunc[KQ.Kill r m].inc (k.1,KS.eq _ _ k.2))
     ((wP r).2 m.1 (\ d -> apH (\ u -> u.1) (v d)))) ;
 } ;
} ;
