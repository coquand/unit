-- The localisation M_r of a module at r, as a set: pairs (m, p), read
-- m / r^p, divided by "r^K (r^q m - r^p m') = 0 for some K" (effective
-- quotient).  The canonical map M_r -> M^D(r) sends m / r^p to d |-> u^p m,
-- u the inverse of r.  It is an equivalence exactly when the two clauses
-- of PointQC hold at r: so those clauses are the paper's Definition 7.1.5.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : A7.CRing) {
 module PQ = PointQC[l].Over[Rg] ;
 module At (Md : A7.Mod[Rg]) (r : Rg.R) {
  open Rg ; open A7.RA[Rg] ; open Md ; open A7.MA[Rg,Md] ;
  module Pt = Affine[l].PtL[Rg,Md] ;
  F : U l = M * Nat ;
  d (p : Nat) : R = pw r p ;
  -- the numerator of x - y
  Num (x y : F) : M = sub (sm (d y.2) x.1) (sm (d x.2) y.1) ;
  Eqv (x y : F) : U l = (K : Nat) * Id M (sm (d K) (Num x y)) mz ;
  rel (x y : F) : U l = Tr.Trunc[Eqv x y].carrier ;
  -- algebra
  zero-under (a b : R) (x : M) (h : Id M (sm b x) mz) : Id M (sm a (sm b x)) mz =
   transH (apH (sm a) h) (sm-zr a) ;
  -- (x - y) + (y - z) = x - z
  chain (x y z : M) : Id M (madd (sub x y) (sub y z)) (sub x z) = calc M {
   madd (madd x (mneg y)) (madd y (mneg z))
    =< symH (maddA x (mneg y) (madd y (mneg z))) > madd x (madd (mneg y) (madd y (mneg z)))
    =< apH (madd x) (maddA (mneg y) y (mneg z)) > madd x (madd (madd (mneg y) y) (mneg z))
    =< apH (\ t -> madd x (madd t (mneg z))) (transH (maddC (mneg y) y) (maddN y)) > madd x (madd mz (mneg z))
    =< apH (madd x) (mzl (mneg z)) > sub x z } ;
  -- b (c m - a m'') = c (b m - a m') + a (c m' - b m'')
  three (a b c : R) (m m' m'' : M) :
   Id M (sm b (sub (sm c m) (sm a m''))) (madd (sm c (sub (sm b m) (sm a m'))) (sm a (sub (sm c m') (sm b m'')))) =
   symH (calc M {
    madd (sm c (sub (sm b m) (sm a m'))) (sm a (sub (sm c m') (sm b m'')))
     =< apH (\ t -> madd t (sm a (sub (sm c m') (sm b m'')))) (sm-sub c (sm b m) (sm a m'))
      > madd (sub (sm c (sm b m)) (sm c (sm a m'))) (sm a (sub (sm c m') (sm b m'')))
     =< apH (madd (sub (sm c (sm b m)) (sm c (sm a m')))) (sm-sub a (sm c m') (sm b m''))
      > madd (sub (sm c (sm b m)) (sm c (sm a m'))) (sub (sm a (sm c m')) (sm a (sm b m'')))
     =< apH (\ t -> madd (sub (sm c (sm b m)) t) (sub (sm a (sm c m')) (sm a (sm b m'')))) (sm-swap c a m')
      > madd (sub (sm c (sm b m)) (sm a (sm c m'))) (sub (sm a (sm c m')) (sm a (sm b m'')))
     =< chain (sm c (sm b m)) (sm a (sm c m')) (sm a (sm b m'')) > sub (sm c (sm b m)) (sm a (sm b m''))
     =< apH (\ t -> sub t (sm a (sm b m''))) (sm-swap c b m) > sub (sm b (sm c m)) (sm a (sm b m''))
     =< apH (sub (sm b (sm c m))) (sm-swap a b m'') > sub (sm b (sm c m)) (sm b (sm a m''))
     =< symH (sm-sub b (sm c m) (sm a m'')) > sm b (sub (sm c m) (sm a m'')) }) ;
  -- d (K + L) x = d K (d L x)
  split-pw (K L : Nat) (x : M) : Id M (sm (d (A7.plusN K L)) x) (sm (d K) (sm (d L) x)) =
   transH (apH (\ t -> sm t x) (pw-add r K L)) (symH (smA (d K) (d L) x)) ;
  rr (x : F) : rel x x = Tr.Trunc[Eqv x x].inc (zero,transH (apH (sm o) (sub-self (sm (d x.2) x.1))) (sm-zr o)) ;
  rs (x y : F) (h : rel x y) : rel y x =
   Tr.Trunc[Eqv x y].induction @l (\ t -> rel y x) (\ t -> Tr.Trunc[Eqv y x].proposition)
    (\ e -> Tr.Trunc[Eqv y x].inc (e.1,calc M {
      sm (d e.1) (Num y x) =< apH (sm (d e.1)) (symH (neg-sub (sm (d y.2) x.1) (sm (d x.2) y.1)))
       > sm (d e.1) (mneg (Num x y))
      =< sm-neg (d e.1) (Num x y) > mneg (sm (d e.1) (Num x y))
      =< apH mneg e.2 > mneg mz
      =< mneg-z > mz })) h ;
  module Trans (x y z : F) (e1 : Eqv x y) (e2 : Eqv y z) {
   a : R = d x.2 ; b : R = d y.2 ; c : R = d z.2 ;
   s : R = d e1.1 ; t : R = d e2.1 ;
   eqv : Eqv x z = (A7.plusN e1.1 (A7.plusN e2.1 y.2), calc M {
    sm (d (A7.plusN e1.1 (A7.plusN e2.1 y.2))) (Num x z)
     =< split-pw e1.1 (A7.plusN e2.1 y.2) (Num x z) > sm s (sm (d (A7.plusN e2.1 y.2)) (Num x z))
     =< apH (sm s) (split-pw e2.1 y.2 (Num x z)) > sm s (sm t (sm b (Num x z)))
     =< apH (\ w -> sm s (sm t w)) (three a b c x.1 y.1 z.1) > sm s (sm t (madd (sm c (Num x y)) (sm a (Num y z))))
     =< apH (sm s) (smD t (sm c (Num x y)) (sm a (Num y z))) > sm s (madd (sm t (sm c (Num x y))) (sm t (sm a (Num y z))))
     =< smD s (sm t (sm c (Num x y))) (sm t (sm a (Num y z)))
      > madd (sm s (sm t (sm c (Num x y)))) (sm s (sm t (sm a (Num y z))))
     =< apH (\ w -> madd w (sm s (sm t (sm a (Num y z)))))
         (transH (sm-swap s t (sm c (Num x y))) (transH (apH (sm t) (sm-swap s c (Num x y)))
          (zero-under t c (sm s (Num x y)) (zero-under c s (Num x y) e1.2))))
      > madd mz (sm s (sm t (sm a (Num y z))))
     =< apH (madd mz) (transH (apH (sm s) (sm-swap t a (Num y z))) (zero-under s a (sm t (Num y z)) (zero-under a t (Num y z) e2.2)))
      > madd mz mz
     =< maddZ mz > mz }) ;
  } ;
  rt (x y z : F) (h : rel x y) (k : rel y z) : rel x z =
   Tr.Trunc[Eqv x y].induction @l (\ w -> rel x z) (\ w -> Tr.Trunc[Eqv x z].proposition)
    (\ e1 -> Tr.Trunc[Eqv y z].induction @l (\ w -> rel x z) (\ w -> Tr.Trunc[Eqv x z].proposition)
     (\ e2 -> Tr.Trunc[Eqv x z].inc Trans[x,y,z,e1,e2].eqv) k) h ;
  module Q = Quotient[l].Quot[F,rel,\ x y -> Tr.Trunc[Eqv x y].proposition,rr,rs,rt] ;
  L : U l = Q.Q ;
  frac (m : M) (p : Nat) : L = Q.inc (m,p) ;
  -- the canonical map to M^D(r)
  D : U l = unit r ;
  Sec : U l = D -> M ;
  set-Sec : isSet Sec = FL.isSet-Pi D (\ u -> M) (\ u -> setM) ;
  value (x : F) : Sec = \ u -> sm (pw u.1 x.2) x.1 ;
  -- u^q (u^p (r^q m)) = u^p m
  cancel (u : D) (p q : Nat) (m : M) : Id M (sm (pw u.1 q) (sm (pw u.1 p) (sm (d q) m))) (sm (pw u.1 p) m) =
   transH (sm-swap (pw u.1 q) (pw u.1 p) (sm (d q) m)) (apH (sm (pw u.1 p)) (Pt.cancel-pw r u.1 u.2 q m)) ;
  -- u^q is invertible
  inv (u : D) (q : Nat) : Id R (mul (pw u.1 q) (d q)) o =
   transH (mulC (pw u.1 q) (d q)) (unit-pw r u.1 u.2 q) ;
  -- on D(r), Num x y = 0 iff value x = value y
  module Compare (x y : F) (u : D) {
   p : Nat = x.2 ; q : Nat = y.2 ;
   scaled : Id M (sm (pw u.1 p) (sm (pw u.1 q) (Num x y))) (sub (value x u) (value y u)) = calc M {
    sm (pw u.1 p) (sm (pw u.1 q) (sub (sm (d q) x.1) (sm (d p) y.1)))
     =< apH (sm (pw u.1 p)) (sm-sub (pw u.1 q) (sm (d q) x.1) (sm (d p) y.1))
      > sm (pw u.1 p) (sub (sm (pw u.1 q) (sm (d q) x.1)) (sm (pw u.1 q) (sm (d p) y.1)))
     =< apH (\ w -> sm (pw u.1 p) (sub w (sm (pw u.1 q) (sm (d p) y.1)))) (Pt.cancel-pw r u.1 u.2 q x.1)
      > sm (pw u.1 p) (sub x.1 (sm (pw u.1 q) (sm (d p) y.1)))
     =< sm-sub (pw u.1 p) x.1 (sm (pw u.1 q) (sm (d p) y.1))
      > sub (sm (pw u.1 p) x.1) (sm (pw u.1 p) (sm (pw u.1 q) (sm (d p) y.1)))
     =< apH (sub (sm (pw u.1 p) x.1)) (cancel u q p y.1) > sub (sm (pw u.1 p) x.1) (sm (pw u.1 q) y.1) } ;
   to (h : Id M (Num x y) mz) : Id M (value x u) (value y u) =
    sub-zero (value x u) (value y u) (transH (symH scaled)
     (transH (apH (\ w -> sm (pw u.1 p) (sm (pw u.1 q) w)) h)
      (transH (apH (sm (pw u.1 p)) (sm-zr (pw u.1 q))) (sm-zr (pw u.1 p))))) ;
   from (h : Id M (value x u) (value y u)) : Id M (Num x y) mz =
    unit-kill (pw u.1 q) (d q) (inv u q) (Num x y)
     (unit-kill (pw u.1 p) (d p) (inv u p) (sm (pw u.1 q) (Num x y))
      (transH scaled (transH (apH (sub (value x u)) (symH h)) (sub-self (value x u))))) ;
  } ;
  respect (x y : F) (h : rel x y) : Id Sec (value x) (value y) =
   Tr.Trunc[Eqv x y].induction @l (\ w -> Id Sec (value x) (value y)) (\ w -> set-Sec _ _)
    (\ e -> FL.funext D (\ u -> M) (value x) (value y) (\ u -> Compare[x,y,u].to
      (unit-kill (d e.1) (pw u.1 e.1) (unit-pw r u.1 u.2 e.1) (Num x y) e.2))) h ;
  module Phi = Q.Descend[Sec,set-Sec,value,respect] ;
  phi (q : L) : Sec = Phi.map q ;
  -- (1) the clauses give an equivalence
  module FromQC (rep : PQ.At[Md].RepClause r) (kill : PQ.At[Md].KillClause r) {
   injective-rep (x y : F) (h : Id Sec (value x) (value y)) : rel x y =
    Tr.Trunc[PQ.At[Md].Kill r (Num x y)].induction @l (\ w -> rel x y) (\ w -> Tr.Trunc[Eqv x y].proposition)
     (\ k -> Tr.Trunc[Eqv x y].inc k)
     (kill (Num x y) (\ u -> Compare[x,y,u].from (apH (\ g -> g u) h))) ;
   injective (q q' : L) (h : Id Sec (phi q) (phi q')) : Id L q q' =
    Q.induction @l (\ q -> Id Sec (phi q) (phi q') -> Id L q q') (\ q -> FL.isProp-Pi _ (\ z -> Id L q q') (\ z -> Q.set _ _))
     (\ x -> Q.induction @l (\ q' -> Id Sec (phi (Q.inc x)) (phi q') -> Id L (Q.inc x) q')
       (\ q' -> FL.isProp-Pi _ (\ z -> Id L (Q.inc x) q') (\ z -> Q.set _ _))
       (\ y h' -> Q.relates x y (injective-rep x y
         (transH (symH (Phi.beta x)) (transH h' (Phi.beta y))))) q') q h ;
   Fib (s : Sec) : U l = (q : L) * Id Sec (phi q) s ;
   fib-prop (s : Sec) : isProp (Fib s) = \ a b ->
    Sigma-eq L (\ q -> Id Sec (phi q) s) a.1 b.1 a.2 b.2 (injective a.1 b.1 (transH a.2 (symH b.2))) (set-Sec _ _) ;
   fib (s : Sec) : Fib s =
    Tr.Trunc[PQ.At[Md].Rep r s].induction @l (\ t -> Fib s) (\ t -> fib-prop s)
     (\ e -> (frac e.1 e.2.1,transH (Phi.beta (e.1,e.2.1)) (FL.funext D (\ u -> M) _ s (\ u -> symH (e.2.2 u)))))
     (rep s) ;
   equiv : isEquiv L Sec phi = qinv L Sec phi (\ s -> (fib s).1) (\ s -> (fib s).2)
    (\ q -> injective _ q (fib (phi q)).2) ;
  } ;
  -- (2) an equivalence gives the clauses
  module ToQC (e : isEquiv L Sec phi) {
   rep : PQ.At[Md].RepClause r = \ s ->
    Q.induction @l (\ q -> Id Sec (phi q) s -> Tr.Trunc[PQ.At[Md].Rep r s].carrier)
     (\ q -> FL.isProp-Pi _ (\ z -> Tr.Trunc[PQ.At[Md].Rep r s].carrier) (\ z -> Tr.Trunc[PQ.At[Md].Rep r s].proposition))
     (\ x h -> Tr.Trunc[PQ.At[Md].Rep r s].inc (x.1,x.2,\ u -> symH (apH (\ g -> g u) (transH (symH (Phi.beta x)) h))))
     (e.sec s) (e.sec-eq s) ;
   kill : PQ.At[Md].KillClause r = \ m v ->
    Tr.Trunc[Eqv (m,zero) (mz,zero)].induction @l (\ w -> Tr.Trunc[PQ.At[Md].Kill r m].carrier)
     (\ w -> Tr.Trunc[PQ.At[Md].Kill r m].proposition)
     (\ k -> Tr.Trunc[PQ.At[Md].Kill r m].inc (k.1,transH (apH (sm (d k.1))
       (symH (transH (apH (\ w -> sub w (sm o mz)) (smO m)) (transH (apH (sub m) (smO mz))
        (transH (apH (madd m) mneg-z) (maddZ m)))))) k.2))
     (Q.effective (m,zero) (mz,zero)
      (Equivalences[l].injective L Sec phi e _ _
       (transH (Phi.beta (m,zero)) (transH (FL.funext D (\ u -> M) _ _ (\ u -> transH (smO m) (transH (v u) (symH (smO mz)))))
        (symH (Phi.beta (mz,zero))))))) ;
  } ;
 } ;
} ;
