-- The quotient P/K of a module by a submodule: the effective quotient of
-- P by "y - x in K" (Quotient.Quot), with the operations descended
-- along the projection.  The projection is linear and surjective, and its
-- kernel is K.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : A7.CRing) {
 module SM = Submodules[l].Over[Rg] ;
 module Quot (P : SM.Module) (K : Submodules[l].Submodule[Rg,P]) {
  module MP = A7.MA[Rg,P] ;
  open MP ;
  -- (x + z) - (x + y) = z - y
  diff-l (x y z : P.M) : Id P.M (sub (P.madd x z) (P.madd x y)) (sub z y) = calc P.M {
   P.madd (P.madd x z) (P.mneg (P.madd x y))
    =< apH (P.madd (P.madd x z)) (neg-add x y) > P.madd (P.madd x z) (P.madd (P.mneg x) (P.mneg y))
    =< swap4 x z (P.mneg x) (P.mneg y) > P.madd (P.madd x (P.mneg x)) (P.madd z (P.mneg y))
    =< apH (\ t -> P.madd t (sub z y)) (P.maddN x) > P.madd P.mz (sub z y)
    =< mzl (sub z y) > sub z y } ;
  diff-r (x y z : P.M) : Id P.M (sub (P.madd z x) (P.madd y x)) (sub z y) =
   transH (apH (\ t -> sub t (P.madd y x)) (P.maddC z x))
    (transH (apH (\ t -> sub (P.madd x z) t) (P.maddC y x)) (diff-l x y z)) ;
  -- (c - b) + (b - a) = c - a
  chain (a b c : P.M) : Id P.M (P.madd (sub c b) (sub b a)) (sub c a) = calc P.M {
   P.madd (P.madd c (P.mneg b)) (P.madd b (P.mneg a))
    =< symH (P.maddA c (P.mneg b) (P.madd b (P.mneg a))) > P.madd c (P.madd (P.mneg b) (P.madd b (P.mneg a)))
    =< apH (P.madd c) (P.maddA (P.mneg b) b (P.mneg a)) > P.madd c (P.madd (P.madd (P.mneg b) b) (P.mneg a))
    =< apH (\ t -> P.madd c (P.madd t (P.mneg a))) (transH (P.maddC (P.mneg b) b) (P.maddN b))
     > P.madd c (P.madd P.mz (P.mneg a))
    =< apH (P.madd c) (mzl (P.mneg a)) > sub c a } ;
  rel (a b : P.M) : U l = K.S (sub b a) ;
  rr (a : P.M) : rel a a = substH K.S (symH (sub-self a)) K.zero ;
  rs (a b : P.M) (h : rel a b) : rel b a = substH K.S (neg-sub b a) (K.neg (sub b a) h) ;
  rt (a b c : P.M) (h : rel a b) (k : rel b c) : rel a c =
   substH K.S (chain a b c) (K.add (sub c b) (sub b a) k h) ;
  module Q = Quotient[l].Quot[P.M,rel,\ a b -> K.prop (sub b a),rr,rs,rt] ;
  C : U l = Q.Q ;
  inc : P.M -> C = Q.inc ;
  -- addition: first in the second argument, then in the first
  module AddR (a : P.M) { module D = Q.Descend[C,Q.set,\ b -> inc (P.madd a b),
   \ b b' h -> Q.relates (P.madd a b) (P.madd a b') (substH K.S (symH (diff-l a b b')) h)] ; } ;
  addR-eq (a a' : P.M) (h : rel a a') (q : C) : Id C (AddR[a].D.map q) (AddR[a'].D.map q) =
   Q.induction @l (\ q -> Id C (AddR[a].D.map q) (AddR[a'].D.map q)) (\ q -> Q.set _ _)
    (\ b -> transH (AddR[a].D.beta b) (transH (Q.relates (P.madd a b) (P.madd a' b) (substH K.S (symH (diff-r b a a')) h))
      (symH (AddR[a'].D.beta b)))) q ;
  module Add = Q.Descend[C -> C,F.isSet-Pi C (\ q -> C) (\ q -> Q.set),\ a -> AddR[a].D.map,
   \ a a' h -> F.funext C (\ q -> C) _ _ (addR-eq a a' h)] ;
  add (q r : C) : C = Add.map q r ;
  add-inc (a b : P.M) : Id C (add (inc a) (inc b)) (inc (P.madd a b)) =
   transH (apH (\ h -> h (inc b)) (Add.beta a)) (AddR[a].D.beta b) ;
  module Neg = Q.Descend[C,Q.set,\ a -> inc (P.mneg a),
   \ a a' h -> Q.relates (P.mneg a) (P.mneg a') (substH K.S (neg-add a' (P.mneg a)) (K.neg (sub a' a) h))] ;
  neg (q : C) : C = Neg.map q ;
  module Scale (r : Rg.R) { module D = Q.Descend[C,Q.set,\ a -> inc (P.sm r a),
   \ a a' h -> Q.relates (P.sm r a) (P.sm r a') (substH K.S (sm-sub r a' a) (K.scale r (sub a' a) h))] ; } ;
  scale (r : Rg.R) (q : C) : C = Scale[r].D.map q ;
  -- laws, by induction on representatives
  Ind1 (P1 : C -> U l) (h : (a : P.M) -> P1 (inc a)) (pr : (q : C) -> isProp (P1 q)) (q : C) : P1 q =
   Q.induction @l P1 pr h q ;
  maddA (q r s : C) : Id C (add q (add r s)) (add (add q r) s) =
   Ind1 (\ q -> Id C (add q (add r s)) (add (add q r) s)) (\ a ->
    Ind1 (\ r -> Id C (add (inc a) (add r s)) (add (add (inc a) r) s)) (\ b ->
     Ind1 (\ s -> Id C (add (inc a) (add (inc b) s)) (add (add (inc a) (inc b)) s)) (\ c -> calc C {
      add (inc a) (add (inc b) (inc c)) =< apH (add (inc a)) (add-inc b c) > add (inc a) (inc (P.madd b c))
       =< add-inc a (P.madd b c) > inc (P.madd a (P.madd b c))
       =< apH inc (P.maddA a b c) > inc (P.madd (P.madd a b) c)
       =< symH (add-inc (P.madd a b) c) > add (inc (P.madd a b)) (inc c)
       =< apH (\ t -> add t (inc c)) (symH (add-inc a b)) > add (add (inc a) (inc b)) (inc c) })
      (\ s -> Q.set _ _) s) (\ r -> Q.set _ _) r) (\ q -> Q.set _ _) q ;
  maddC (q r : C) : Id C (add q r) (add r q) =
   Ind1 (\ q -> Id C (add q r) (add r q)) (\ a ->
    Ind1 (\ r -> Id C (add (inc a) r) (add r (inc a))) (\ b ->
     transH (add-inc a b) (transH (apH inc (P.maddC a b)) (symH (add-inc b a))))
     (\ r -> Q.set _ _) r) (\ q -> Q.set _ _) q ;
  maddZ (q : C) : Id C (add q (inc P.mz)) q =
   Ind1 (\ q -> Id C (add q (inc P.mz)) q) (\ a -> transH (add-inc a P.mz) (apH inc (P.maddZ a)))
    (\ q -> Q.set _ _) q ;
  maddN (q : C) : Id C (add q (neg q)) (inc P.mz) =
   Ind1 (\ q -> Id C (add q (neg q)) (inc P.mz)) (\ a ->
    transH (apH (add (inc a)) (Neg.beta a)) (transH (add-inc a (P.mneg a)) (apH inc (P.maddN a))))
    (\ q -> Q.set _ _) q ;
  smA (x y : Rg.R) (q : C) : Id C (scale x (scale y q)) (scale (Rg.mul x y) q) =
   Ind1 (\ q -> Id C (scale x (scale y q)) (scale (Rg.mul x y) q)) (\ a ->
    transH (apH (scale x) (Scale[y].D.beta a)) (transH (Scale[x].D.beta (P.sm y a))
     (transH (apH inc (P.smA x y a)) (symH (Scale[Rg.mul x y].D.beta a)))))
    (\ q -> Q.set _ _) q ;
  smO (q : C) : Id C (scale Rg.o q) q =
   Ind1 (\ q -> Id C (scale Rg.o q) q) (\ a -> transH (Scale[Rg.o].D.beta a) (apH inc (P.smO a)))
    (\ q -> Q.set _ _) q ;
  smD (x : Rg.R) (q r : C) : Id C (scale x (add q r)) (add (scale x q) (scale x r)) =
   Ind1 (\ q -> Id C (scale x (add q r)) (add (scale x q) (scale x r))) (\ a ->
    Ind1 (\ r -> Id C (scale x (add (inc a) r)) (add (scale x (inc a)) (scale x r))) (\ b -> calc C {
     scale x (add (inc a) (inc b)) =< apH (scale x) (add-inc a b) > scale x (inc (P.madd a b))
      =< Scale[x].D.beta (P.madd a b) > inc (P.sm x (P.madd a b))
      =< apH inc (P.smD x a b) > inc (P.madd (P.sm x a) (P.sm x b))
      =< symH (add-inc (P.sm x a) (P.sm x b)) > add (inc (P.sm x a)) (inc (P.sm x b))
      =< apH (\ t -> add t (inc (P.sm x b))) (symH (Scale[x].D.beta a)) > add (scale x (inc a)) (inc (P.sm x b))
      =< apH (add (scale x (inc a))) (symH (Scale[x].D.beta b)) > add (scale x (inc a)) (scale x (inc b)) })
     (\ r -> Q.set _ _) r) (\ q -> Q.set _ _) q ;
  smE (x y : Rg.R) (q : C) : Id C (scale (Rg.add x y) q) (add (scale x q) (scale y q)) =
   Ind1 (\ q -> Id C (scale (Rg.add x y) q) (add (scale x q) (scale y q))) (\ a -> calc C {
    scale (Rg.add x y) (inc a) =< Scale[Rg.add x y].D.beta a > inc (P.sm (Rg.add x y) a)
     =< apH inc (P.smE x y a) > inc (P.madd (P.sm x a) (P.sm y a))
     =< symH (add-inc (P.sm x a) (P.sm y a)) > add (inc (P.sm x a)) (inc (P.sm y a))
     =< apH (\ t -> add t (inc (P.sm y a))) (symH (Scale[x].D.beta a)) > add (scale x (inc a)) (inc (P.sm y a))
     =< apH (add (scale x (inc a))) (symH (Scale[y].D.beta a)) > add (scale x (inc a)) (scale y (inc a)) })
    (\ q -> Q.set _ _) q ;
  carrier : SM.Module = new A7.Mod[Rg,C,Q.set,inc P.mz,add,neg,maddA,maddC,maddZ,maddN,
   scale,smA,smO,smD,smE] ;
  projection : SM.Linear P carrier =
   (inc,\ a b -> symH (add-inc a b),\ r a -> symH (Scale[r].D.beta a)) ;
  surjective (q : C) : Tr.Trunc[(a : P.M) * Id C (inc a) q].carrier =
   Ind1 (\ q -> Tr.Trunc[(a : P.M) * Id C (inc a) q].carrier)
    (\ a -> Tr.Trunc[(a' : P.M) * Id C (inc a') (inc a)].inc (a,refl (inc a)))
    (\ q -> Tr.Trunc[(a : P.M) * Id C (inc a) q].proposition) q ;
  -- the kernel of the projection is K
  sub-zero-l (a : P.M) : Id P.M (sub P.mz a) (P.mneg a) = mzl (P.mneg a) ;
  kernel (a : P.M) (h : Id C (inc a) (inc P.mz)) : K.S a =
   substH K.S (neg-neg a) (K.neg (P.mneg a) (substH K.S (sub-zero-l a) (Q.effective a P.mz h))) ;
  in-kernel (a : P.M) (k : K.S a) : Id C (inc a) (inc P.mz) =
   Q.relates a P.mz (substH K.S (symH (sub-zero-l a)) (K.neg a k)) ;
 } ;
} ;
