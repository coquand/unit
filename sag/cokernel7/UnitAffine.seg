-- D(r), the proposition "r is invertible", is Spec R[1/r]: the
-- localisation of R at r is finitely presented, and its spectrum is
-- equivalent to D(r) because Spec R is a point.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module BP = BasePresentation[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module At (r : R.R) {
  module Loc = I.Presented[C.base,BP.empty,BP.presentation,r,cst r,refl r] ;
  A : C.Algebra = Loc.L.algebra ;
  fp : P.FP A = Loc.L.fp ;
  Pt : U l = (x : C.Spec C.base) * RL[R].unit (x.1.1 r) ;
  sp : Pr.Equiv (C.Spec A) Pt = Loc.L.spectrum ;
  base-eq (x : C.Spec C.base) : Id (C.Spec C.base) (C.identity C.base) x =
   C.ext C.base C.base _ x (\ a -> sym (x.2 a)) ;
  to (u : RL[R].unit r) : C.Spec A = sp.2.sec (C.identity C.base,u) ;
  from (a : C.Spec A) : RL[R].unit r = subst (\ t -> RL[R].unit t) ((sp.1 a).1.2 r) (sp.1 a).2 ;
  from-to (u : RL[R].unit r) : Id (RL[R].unit r) (from (to u)) u = RR.unit-prop r _ _ ;
  to-from (a : C.Spec A) : Id (C.Spec A) (to (from a)) a =
   Equivalences[l].injective (C.Spec A) Pt sp.1 sp.2 _ _
    (trans (sp.2.sec-eq (C.identity C.base,from a))
     (Pr.Sigma-eq (C.Spec C.base) (\ x -> RL[R].unit (x.1.1 r)) _ _ _ _
      (base-eq (sp.1 a).1) (RR.unit-prop ((sp.1 a).1.1.1 r)))) ;
  equiv : Pr.Equiv (RL[R].unit r) (C.Spec A) = (to,Pr.qinv _ _ to from to-from from-to) ;
 } ;
} ;
