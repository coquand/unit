-- PolyGcd.seg: Théorème 11 of doc/gcd-polynomial.tex.  If A is a gcd domain,
-- so is A[X] (PolynomialRing.Extension).
--
--  * discrete: f = 0 iff its content is 0;
--  * 1 /= 0: the constant coefficient;
--  * integral: direct content induction gives c(f)c(g)=0 from f g=0;
--    the contents of nonzero polynomials are nonzero, a contradiction;
--  * gcd: f = 0 gives g, g = 0 gives f; otherwise D, lambda of Lemme 10,
--    D = c(D) E with E primitive, E | f and E | g (Lemme 8), and
--    G = gamma E, gamma = gcd(c(f), c(g)).  G | f by Gauss (gamma divides
--    the coefficients of f = E q, hence those of q).  A common divisor
--    h = c(h) h* of f, g has c(h) | gamma, and h* | c(D) E gives h* | E.
--
--  Gcds merely exist, so contents are data taken when needed: the gcd of
--  f, g merely exists, and its proof takes c(f), c(g), c(D) and gamma.
--  Deciding x = 0 is a proposition, so it may take c(x).  A[X] is then a
--  discrete domain, so h | G may take c(h) (div-from in A[X]).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 open A ; open RL[A] ; open GcdDomain[l].Divisibility[A] ;
 module PB = PolyBase[l].Over[A,G] ;
 open PB ;
 module GL = GcdDomain[l] ;
 module Dg = Degree[l].Over[A,G] ;
 module GS = Gauss[l].Over[A,G] ;
 module EL = Elimination[l].Over[A,G] ;

 ---------------------------------------------------------------------
 -- the content

 -- c is a content of x
 Cont (x : Pol) (c : R) : U l = C.Content (Dg.dg x) (coef x) c ;
 SomeCont (x : Pol) : U l = C.SomeContent (Dg.dg x) (coef x) ;
 cont-exists (x : Pol) : GL.Merely (SomeCont x) = C.cont-exists (coef x) (Dg.dg x) ;
 zero-content (x : Pol) (c : R) (hc : Cont x c) (h : Id R c z) : Id Pol x B.zeroQ =
  Dg.zero-of-coefs x (Dg.Cx[x].K.With[c,hc].c-zero h) ;
 content-zero (x : Pol) (c : R) (hc : Cont x c) (h : (i : Nat) -> Id R (coef x i) z) : Id R c z =
  div-of-zero c (Dg.Cx[x].K.With[c,hc].c-univ z (\ i -> div-eq-right z z (coef x i) (sym (h i)) (div-zero z))) ;
 zero-coef (x : Pol) (e : Id Pol x B.zeroQ) (i : Nat) : Id R (coef x i) z =
  trans (ap (\ w -> coef w i) e) (CP.coef-zero i) ;
 -- h = 0 gives h r = 0
 zero-mul-coef (h r : Pol) (e : Id Pol h B.zeroQ) (i : Nat) : Id R (coef (B.mulQ h r) i) z =
  zero-coef (B.mulQ h r) (trans (ap (\ w -> B.mulQ w r) e) (LB.zero-mul r)) i ;
 -- a divisor of a non-zero polynomial is non-zero
 nz-div (h f : Pol) (d : DB.Div h f) (ch : R) (hch : Cont h ch) (cf : R) (hcf : Cont f cf)
  (hf : Not (Id R cf z)) : Not (Id R ch z) = \ e ->
  hf (content-zero f cf hcf (\ i -> trans (ap (\ w -> coef w i) d.2) (zero-mul-coef h d.1 (zero-content h ch hch e) i))) ;
 -- (c E) q = E (c q)
 shuffle (c : R) (E q : Pol) : Id Pol (B.mulQ (sc c E) q) (B.mulQ E (sc c q)) =
  trans (sym (B.mul-assoc (B.constant c) E q)) (LB.mul-swap (B.constant c) E q) ;

 -- Lemme 6: the primitive part, for a content c /= 0 of x
 module PP (x : Pol) (c : R) (hc : Cont x c) (nc : Not (Id R c z)) {
  module K = Dg.Cx[x].K.With[c,hc] ;
  module S = Scalar[c,nc] ;
  xs : Pol = (S.divide x K.c-div).1 ;
  eq : Id Pol x (sc c xs) = (S.divide x K.c-div).2 ;
  prim : Prim xs = \ d hd ->
   D.div-cancel c d o nc
    (div-eq-right (mul c d) c (mul c o) (sym (mulO c))
     (K.c-univ (mul c d) (\ i -> div-eq-right (mul c d) (mul c (coef xs i)) (coef x i)
        (sym (trans (ap (\ w -> coef w i) eq) (coef-sc c xs i))) (div-scale d (coef xs i) c (hd i))))) ;
 } ;

 ---------------------------------------------------------------------
 -- discrete, 1 /= 0, integral

 byDec (x : Pol) (c : R) (hc : Cont x c) : Plus (Id R c z) (Not (Id R c z)) -> Plus (Id Pol x B.zeroQ) (Not (Id Pol x B.zeroQ)) = split {
  inl e -> inl (zero-content x c hc e) ;
  inr n -> inr (\ e -> n (content-zero x c hc (zero-coef x e))) } ;
 -- deciding x = 0 is a proposition, so we may take a content of x
 decP (x : Pol) : Plus (Id Pol x B.zeroQ) (Not (Id Pol x B.zeroQ)) =
  GL.take (SomeCont x) (Plus (Id Pol x B.zeroQ) (Not (Id Pol x B.zeroQ)))
   (GL.dec-prop (Id Pol x B.zeroQ) (B.set x B.zeroQ)) (cont-exists x)
   (\ cc -> byDec x cc.1 cc.2 (G.dec cc.1)) ;

 nontrivialP : Not (Id Pol B.oneQ B.zeroQ) = \ e ->
  G.nontrivial (trans (sym (CP.coef-const0 o)) (zero-coef B.oneQ e zero)) ;

 -- Direct content induction: a zero product forces c(p)c(q)=0.
 -- The contents of nonzero lists are nonzero, so the base domain cancels.
 list-content-nz (p : PL.P) (hp : Not (Id Pol (B.include p) B.zeroQ)) (cp : GS.DP.SomeCont p) :
   Not (Id R cp.1 z) = \ e ->
   hp (Dg.zero-of-coefs (B.include p) (\ i -> trans (CP.coef-include p i) (GS.DP.At[p].K.With[cp.1,cp.2].c-zero e i))) ;
 integral-with (p : PL.P) (hp : Not (Id Pol (B.include p) B.zeroQ))
   (q : PL.P) (hq : Not (Id Pol (B.include q) B.zeroQ))
   (h : Id Pol (B.mulQ (B.include p) (B.include q)) B.zeroQ)
   (cp : GS.DP.SomeCont p) (cq : GS.DP.SomeCont q) : Empty =
   G.integral cp.1 cq.1 (list-content-nz p hp cp) (list-content-nz q hq cq)
     (div-of-zero (mul cp.1 cq.1)
       (GS.DP.product p q cp.1 cp.2 cq.1 cq.2 z (\ k -> div-eq-right z z (PL.coef (ML.pmul p q) k)
         (sym (trans (sym (coef-mul-include p q k)) (zero-coef (B.mulQ (B.include p) (B.include q)) h k)))
         (div-zero z)))) ;
 integral-lists (p : PL.P) (hp : Not (Id Pol (B.include p) B.zeroQ))
   (q : PL.P) (hq : Not (Id Pol (B.include q) B.zeroQ))
   (h : Id Pol (B.mulQ (B.include p) (B.include q)) B.zeroQ) : Empty =
   GL.take (GS.DP.SomeCont p) Empty GL.empty-prop (GS.DP.cont-exists p) (\ cp ->
    GL.take (GS.DP.SomeCont q) Empty GL.empty-prop (GS.DP.cont-exists q) (\ cq ->
     integral-with p hp q hq h cp cq)) ;
 Integral (x y : Pol) : U l = Not (Id Pol x B.zeroQ) -> Not (Id Pol y B.zeroQ) -> Not (Id Pol (B.mulQ x y) B.zeroQ) ;
 integralP : (x y : Pol) -> Integral x y =
  B.forall2 Integral
   (\ x y -> FE.isProp-Pi (Not (Id Pol x B.zeroQ)) (\ hx -> Not (Id Pol y B.zeroQ) -> Not (Id Pol (B.mulQ x y) B.zeroQ))
     (\ hx -> FE.isProp-Pi (Not (Id Pol y B.zeroQ)) (\ hy -> Not (Id Pol (B.mulQ x y) B.zeroQ))
       (\ hy -> GcdDomain[l].not-prop (Id Pol (B.mulQ x y) B.zeroQ))))
   (\ p q hp hq h -> integral-lists p hp q hq h) ;
 -- A[X] is a discrete domain
 module DD = GcdDomain[l].Domain[B.ring,B.set,decP,integralP] ;

 ---------------------------------------------------------------------
 -- the gcd of two non-zero polynomials

 module Main (f g : Pol) (cf : R) (hcf : Cont f cf) (cg : R) (hcg : Cont g cg)
  (nf : Not (Id R cf z)) (ng : Not (Id R cg z)) {
  el : EL.Elim[f,g] = EL.elimination f g (Dg.dg f) (Dg.dg g) (Dg.dg-bnd f) (Dg.dg-bnd g) ;
  lam : R = el.lam ;
  -- for a content cD of D and a gcd gm of c(f), c(g)
  module With (cD : R) (hcD : Cont el.gd cD) (gm : GcdOf cf cg) {
   nD : Not (Id R cD z) = \ e ->
    nf (content-zero f cf hcf (\ i -> D.cancel-zero lam (coef f i) el.lam-nz
      (trans (sym (coef-sc lam f i)) (trans (ap (\ w -> coef w i) el.div-f.2) (zero-mul-coef el.gd el.div-f.1 (zero-content el.gd cD hcD e) i))))) ;
   module PD = PP[el.gd,cD,hcD,nD] ;
   E : Pol = PD.xs ;
   ef : Id Pol (sc lam f) (B.mulQ E (sc cD el.div-f.1)) =
    trans el.div-f.2 (trans (ap (\ w -> B.mulQ w el.div-f.1) PD.eq) (shuffle cD E el.div-f.1)) ;
   eg : Id Pol (sc lam g) (B.mulQ E (sc cD el.div-g.1)) =
    trans el.div-g.2 (trans (ap (\ w -> B.mulQ w el.div-g.1) PD.eq) (shuffle cD E el.div-g.1)) ;
   Ef : DB.Div E f = GS.DivPrim[E,f,sc cD el.div-f.1,PD.prim,lam,el.lam-nz,ef].result ;
   Eg : DB.Div E g = GS.DivPrim[E,g,sc cD el.div-g.1,PD.prim,lam,el.lam-nz,eg].result ;
   gam : R = gm.1 ;
   ngam : Not (Id R gam z) = \ e ->
    nf (div-of-zero cf (div-eq-left gam z cf e (gcd-left cf cg gm))) ;
   Gp : Pol = sc gam E ;
   -- G divides x, for x = f, g
   module Part (x : Pol) (cx : R) (hcx : Cont x cx) (dE : DB.Div E x) (dg : Div gam cx) {
    dgi (i : Nat) : Div gam (coef (B.mulQ E dE.1) i) =
     div-trans gam cx (coef (B.mulQ E dE.1) i) dg
      (div-eq-right cx (coef x i) (coef (B.mulQ E dE.1) i) (ap (\ w -> coef w i) dE.2) (Dg.Cx[x].K.With[cx,hcx].c-div i)) ;
    s : Scalar[gam,ngam].Quot dE.1 = Scalar[gam,ngam].divide dE.1 (GS.GaussAt[gam,ngam].gauss E dE.1 PD.prim dgi) ;
    result : DB.Div Gp x = (s.1, trans dE.2 (trans (ap (B.mulQ E) s.2) (sym (shuffle gam E s.1)))) ;
   } ;
   -- a common divisor divides G
   module Common (h : Pol) (df : DB.Div h f) (dg : DB.Div h g) {
    hD : DB.Div h el.gd = el.common h df dg ;
    -- for a content ch of h
    module WithH (ch : R) (hch : Cont h ch) {
     nh : Not (Id R ch z) = nz-div h f df ch hch cf hcf nf ;
     module PH = PP[h,ch,hch,nh] ;
     ch-div (x : Pol) (dx : DB.Div h x) (i : Nat) : Div ch (coef x i) =
      div-eq-right ch (mul ch (coef (B.mulQ PH.xs dx.1) i)) (coef x i)
       (sym (trans (ap (\ w -> coef w i) (trans dx.2 (trans (ap (\ w -> B.mulQ w dx.1) PH.eq) (sym (B.mul-assoc (B.constant ch) PH.xs dx.1)))))
                   (coef-sc ch (B.mulQ PH.xs dx.1) i)))
       (div-factor ch (coef (B.mulQ PH.xs dx.1) i)) ;
     ch-gam : Div ch gam = gcd-univ cf cg gm ch
      (Dg.Cx[f].K.With[cf,hcf].c-univ ch (ch-div f df)) (Dg.Cx[g].K.With[cg,hcg].c-univ ch (ch-div g dg)) ;
     eD : Id Pol (sc cD E) (B.mulQ PH.xs (sc ch hD.1)) =
      trans (sym PD.eq) (trans hD.2 (trans (ap (\ w -> B.mulQ w hD.1) PH.eq) (shuffle ch PH.xs hD.1))) ;
     hsE : DB.Div PH.xs E = GS.DivPrim[PH.xs,E,sc ch hD.1,PH.prim,cD,nD,eD].result ;
     cC : DB.Div (B.constant ch) (B.constant gam) =
      (B.constant ch-gam.1, trans (ap B.constant ch-gam.2) (B.constant-mul ch ch-gam.1)) ;
     result : DB.Div h Gp =
      DB.div-eq-left (sc ch PH.xs) h Gp (sym PH.eq) (DB.div-mul2 (B.constant ch) (B.constant gam) PH.xs E cC hsE) ;
    } ;
    result : DB.Div h Gp = DD.div-from (SomeCont h) (cont-exists h) h Gp (\ cc -> WithH[cc.1,cc.2].result) ;
   } ;
   gcdOf : DB.GcdOf f g =
    (Gp, (Part[f,cf,hcf,Ef,gcd-left cf cg gm].result,
         (Part[g,cg,hcg,Eg,gcd-right cf cg gm].result,
          \ h df dg -> Common[h,df,dg].result))) ;
  } ;
  gcdOf : GL.Merely (DB.GcdOf f g) =
   GL.take (SomeCont el.gd) (GL.Merely (DB.GcdOf f g)) (GL.merely-prop (DB.GcdOf f g)) (cont-exists el.gd) (\ cD ->
    GL.take (GcdOf cf cg) (GL.Merely (DB.GcdOf f g)) (GL.merely-prop (DB.GcdOf f g)) (G.gcd cf cg) (\ gm ->
     GL.merely (DB.GcdOf f g) With[cD.1,cD.2,gm].gcdOf)) ;
 } ;

 byG (f g : Pol) (cf : R) (hcf : Cont f cf) (cg : R) (hcg : Cont g cg) (nf : Not (Id R cf z))
  : Plus (Id R cg z) (Not (Id R cg z)) -> GL.Merely (DB.GcdOf f g) = split {
  inl e -> GL.merely (DB.GcdOf f g)
            (f, (DB.div-refl f, (DB.div-eq-right f B.zeroQ g (sym (zero-content g cg hcg e)) (DB.div-zero f), \ c hf hg -> hf))) ;
  inr ng -> Main[f,g,cf,hcf,cg,hcg,nf,ng].gcdOf } ;
 byF (f g : Pol) (cf : R) (hcf : Cont f cf) (cg : R) (hcg : Cont g cg)
  : Plus (Id R cf z) (Not (Id R cf z)) -> GL.Merely (DB.GcdOf f g) = split {
  inl e -> GL.merely (DB.GcdOf f g)
            (g, (DB.div-eq-right g B.zeroQ f (sym (zero-content f cf hcf e)) (DB.div-zero g), (DB.div-refl g, \ c hf hg -> hg))) ;
  inr nf -> byG f g cf hcf cg hcg nf (G.dec cg) } ;
 -- any two polynomials merely have a gcd
 gcdP (f g : Pol) : GL.Merely (DB.GcdOf f g) =
  GL.take (SomeCont f) (GL.Merely (DB.GcdOf f g)) (GL.merely-prop (DB.GcdOf f g)) (cont-exists f) (\ cf ->
   GL.take (SomeCont g) (GL.Merely (DB.GcdOf f g)) (GL.merely-prop (DB.GcdOf f g)) (cont-exists g) (\ cg ->
    byF f g cf.1 cf.2 cg.1 cg.2 (G.dec cf.1))) ;

 -- Théorème 11
 domain : GcdDomain[l].GcdDomain[B.ring] = GcdDomain[l].mkGcdDomain B.ring B.set decP integralP gcdP nontrivialP ;
} ;
