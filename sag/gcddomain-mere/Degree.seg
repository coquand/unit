-- Degree.seg: the degree of an element of A[X] (A discrete) as the least
-- strict bound n of the indices of its non-zero coefficients: e_i = 0 for
-- i >= n, and e_(n-1) /= 0 when n > 0.  It is unique, hence a proposition,
-- and is therefore obtained on the quotient A[X] from the lists
-- (doc/gcd-polynomial.tex, point délicat 1).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module NO = NatOrder[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 open A ; open RL[A] ;
 module PB = PolyBase[l].Over[A,G] ;
 open PB ;
 TopF : Nat -> (Nat -> R) -> U l = split { zero -> \ e -> Top ; suc n -> \ e -> Not (Id R (e n) z) } ;
 DegF (e : Nat -> R) : U l = (n : Nat) * (C.Bnd n e * TopF n e) ;

 top-eq : (u v : Top) -> Id Top u v = split { tt -> split { tt -> refl tt } } ;
 top-prop : (n : Nat) (e : Nat -> R) -> Pr.isProp (TopF n e) = split {
  zero -> \ e -> top-eq ;
  suc n -> \ e -> GcdDomain[l].not-prop (Id R (e n) z) } ;
 bnd-prop (n : Nat) (e : Nat -> R) : Pr.isProp (C.Bnd n e) =
  FE.isProp-Pi Nat (\ i -> Id R (e (plus n i)) z) (\ i -> G.set (e (plus n i)) z) ;
 -- a non-zero coefficient at n - 1 beyond a bound m
 top-vs-bound (m : Nat) (e : Nat -> R) (bm : C.Bnd m e) (d : Nat) : (n : Nat) -> TopF n e -> Id Nat n (plus m (suc d)) -> Empty = split {
  zero -> \ t h -> suc-zero (plus m d) (sym (trans h (plus-suc m d))) ;
  suc n -> \ t h -> t (trans (ap e (suc-inj (trans h (plus-suc m d)))) (bm d)) } ;
 unique-step (e : Nat -> R) (n m : Nat) (tn : TopF n e) (bm : C.Bnd m e) : (d : Nat) -> Id Nat n (plus m d) -> Id Nat n m = split {
  zero -> \ h -> trans h (plus-zero m) ;
  suc d -> \ h -> efq (top-vs-bound m e bm d n tn h) } ;
 unique-cmp (e : Nat -> R) (n m : Nat) (bn : C.Bnd n e) (tn : TopF n e) (bm : C.Bnd m e) (tm : TopF m e) :
  Plus ((d : Nat) * Id Nat n (plus m d)) ((d : Nat) * Id Nat m (plus n d)) -> Id Nat n m = split {
  inl p -> unique-step e n m tn bm p.1 p.2 ;
  inr p -> sym (unique-step e m n tm bn p.1 p.2) } ;
 deg-prop (e : Nat -> R) : Pr.isProp (DegF e) = \ u v ->
  Pr.Sigma-eq Nat (\ n -> C.Bnd n e * TopF n e) u.1 v.1 u.2 v.2
   (unique-cmp e u.1 v.1 u.2.1 u.2.2 v.2.1 v.2.2 (NO.compare u.1 v.1))
   (Pr.isProp-Sigma (C.Bnd v.1 e) (\ b -> TopF v.1 e) (bnd-prop v.1 e) (\ b -> top-prop v.1 e)) ;

 -- on the lists
 zero-cons (c : R) (p : PL.P) (b : C.Bnd zero (PL.coef p)) (h : Id R c z) : C.Bnd zero (PL.coef (cons c p)) = split {
  zero -> h ; suc i -> b i } ;
 byC (c : R) (p : PL.P) (b : C.Bnd zero (PL.coef p)) : Plus (Id R c z) (Not (Id R c z)) -> DegF (PL.coef (cons c p)) = split {
  inl h -> (zero, (zero-cons c p b h, tt)) ;
  inr n -> (suc zero, (\ i -> b i, n)) } ;
 cons-deg (c : R) (p : PL.P) : (n : Nat) -> C.Bnd n (PL.coef p) -> TopF n (PL.coef p) -> DegF (PL.coef (cons c p)) = split {
  zero -> \ b t -> byC c p b (G.dec c) ;
  suc n -> \ b t -> (suc (suc n), (\ i -> b i, t)) } ;
 deg-list : (p : PL.P) -> DegF (PL.coef p) = split {
  nil -> (zero, (\ i -> refl z, tt)) ;
  cons c p | r -> cons-deg c p r.1 r.2.1 r.2.2 } ;

 -- on A[X]
 deg : (x : Pol) -> DegF (coef x) =
  B.Q.induction @l (\ x -> DegF (coef x)) (\ x -> deg-prop (coef x))
   (\ p -> subst (\ e -> DegF e) (sym (CP.Coef.beta p)) (deg-list p)) ;
 dg (x : Pol) : Nat = (deg x).1 ;
 dg-bnd (x : Pol) : C.Bnd (dg x) (coef x) = (deg x).2.1 ;
 -- the content of x, from its degree
 module Cx (x : Pol) {
  module K = C.Bounded[coef x,dg x,dg-bnd x] ;
 } ;
 -- x = 0 iff its coefficients vanish
 zero-of-coefs (x : Pol) (h : (i : Nat) -> Id R (coef x i) z) : Id Pol x B.zeroQ =
  CP.coef-ext x B.zeroQ (\ k -> trans (h k) (sym (CP.coef-zero k))) ;
}
;
