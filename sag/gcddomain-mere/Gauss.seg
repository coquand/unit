-- Gauss.seg: Gauss's lemma by the content (doc/gcd-polynomial.tex, §3).
--
--  Direct content induction (MRR IV.4.3), removing the constant term
--  rather than the leading term, since lists are constant-first.
--  Every common divisor of the coefficients of p q divides c(p)c(q).
--  Primitive p,q: put t=gcd(d,p_0); induction on the shorter tail gives
--  t | c(tail p)c(q), hence t | all coefficients of p, hence t | 1.
--  Symmetrically gcd(d,q_0) | 1; d | p_0 q_0 now gives d | 1 by Euclid.
--  General p,q: divide by nonzero contents (zero cases separate), apply
--  that primitive-product result and Content.Bounded.prim-M.
--  No Dedekind-Mertens, prime elements, or factorisation is used.
--  Lemme 8: E primitive, lambda /= 0, lambda f = E q give f = E q'
--    (q = lambda q').
-- On the lists first; on A[X] for d /= 0 (then the conclusion is a
-- proposition and holds on the quotient).
-- Gcds merely exist: the statement is for EVERY content of p and of q, and
-- the gcds gcd(d,p_0), gcd(d,q_0) and the contents used in a step are
-- taken there (the goal of each step is a divisibility: div-from).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Direct (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 open A ; open RL[A] ; open GcdDomain[l].Divisibility[A] ;
 module PB = PolyBase[l].Over[A,G] ; open PB ;
 module GD = GcdDomain[l].Gcd[A,G] ;
 module RW = RawLaws[l].Laws[A] ; module RM = RawMultiplication[l].Laws[A] ;

 module GL = GcdDomain[l] ;
 -- c is a content of the list p
 Cont (p : PL.P) (c : R) : U l = C.Content (PL.plen p) (PL.coef p) c ;
 SomeCont (p : PL.P) : U l = C.SomeContent (PL.plen p) (PL.coef p) ;
 cont-exists (p : PL.P) : GL.Merely (SomeCont p) = C.cont-exists (PL.coef p) (PL.plen p) ;
 module At (p : PL.P) { module K = C.Bounded[PL.coef p,PL.plen p,bnd-list p] ; } ;
 Common (d : R) (p : PL.P) : U l = (i : Nat) -> Div d (PL.coef p i) ;
 Product (p q : PL.P) : U l = (cp : R) -> Cont p cp -> (cq : R) -> Cont q cq ->
  (d : R) -> Common d (ML.pmul p q) -> Div d (mul cp cq) ;
 -- divisibility is closed under subtraction
 div-sub (d a b : R) (ha : Div d a) (hb : Div d b) : Div d (add a (neg b)) =
   div-add d a (neg b) ha (div-neg d b hb) ;
 sub-add (x y : R) : Id R (add (add x y) (neg x)) y =
   trans (ap (\ t -> add t (neg x)) (addC x y)) (add-neg-cancel y x) ;

 -- A common divisor of (a+Xp)q and of a divides every coefficient of pq.
 module Tail (a : R) (p q : PL.P) (d : R) (ha : Div d a)
   (h : Common d (ML.pmul (cons a p) q)) (i : Nat) {
   x : R = mul a (PL.coef q (suc i)) ;
   y : R = PL.coef (ML.pmul p q) i ;
   eq : Id R (PL.coef (ML.pmul (cons a p) q) (suc i)) (add x y) =
     trans (RM.mul-cons-left a p q (suc i))
       (trans (ML.coef-addP (ML.scal a q) (cons z (ML.pmul p q)) (suc i))
         (ap (\ t -> add t y) (ML.coef-scal a q (suc i)))) ;
   dx : Div d x = div-mul d a (PL.coef q (suc i)) ha ;
   dxy : Div d (add x y) = div-eq-right d _ _ eq (h (suc i)) ;
   result : Div d y = div-eq-right d _ y (sub-add x y) (div-sub d (add x y) x dxy dx) ;
 } ;
 tail-common (a : R) (p q : PL.P) (d : R) (ha : Div d a)
   (h : Common d (ML.pmul (cons a p) q)) (i : Nat) : Div d (PL.coef (ML.pmul p q) i) =
   Tail[a,p,q,d,ha,h,i].result ;

 -- Primitive product at the next length, assuming the general statement
 -- for pairs whose total length is one less.
 Rec (N : Nat) : U l = (p q : PL.P) -> Id Nat (plus (PL.plen p) (PL.plen q)) N -> Product p q ;
 module PrimStep (N : Nat) (r : Rec N) (a : R) (p : PL.P) (b : R) (q : PL.P)
   (e : Id Nat (plus (PL.plen (cons a p)) (PL.plen (cons b q))) (suc N))
   (pp : C.Prim (PL.coef (cons a p))) (pq : C.Prim (PL.coef (cons b q)))
   (d : R) (h : Common d (ML.pmul (cons a p) (cons b q)))
   (gA : GcdOf d a) (gB : GcdOf d b) {
   ef : Id Nat (plus (PL.plen p) (PL.plen (cons b q))) N = suc-inj e ;
   es : Id Nat (plus (PL.plen q) (PL.plen (cons a p))) N =
     trans (plus-comm (PL.plen q) (suc (PL.plen p)))
       (trans (sym (plus-suc (PL.plen p) (PL.plen q))) ef) ;
   module One (a0 : R) (p0 q0 : PL.P) (ep : Id Nat (plus (PL.plen p0) (PL.plen q0)) N)
     (prim0 : C.Prim (PL.coef (cons a0 p0))) (prim1 : C.Prim (PL.coef q0))
     (hh : Common d (ML.pmul (cons a0 p0) q0)) (g : GcdOf d a0)
     (cp0 : SomeCont p0) (cq0 : SomeCont q0) {
     t : R = g.1 ;
     ht : Common t (ML.pmul (cons a0 p0) q0) = \ i -> div-trans t d _ (gcd-left d a0 g) (hh i) ;
     tc : Div t (mul cp0.1 cq0.1) =
       r p0 q0 ep cp0.1 cp0.2 cq0.1 cq0.2 t (tail-common a0 p0 q0 t (gcd-right d a0 g) ht) ;
     ct : Div t cp0.1 = div-trans t (mul cp0.1 cq0.1) cp0.1 tc
       (div-eq-right (mul cp0.1 cq0.1) (mul cp0.1 o) cp0.1 (mulO cp0.1)
         (div-scale cq0.1 o cp0.1 (At[q0].K.With[cq0.1,cq0.2].prim-c prim1))) ;
     coeffs : Common t (cons a0 p0) = split {
       zero -> gcd-right d a0 g ;
       suc i -> div-trans t cp0.1 (PL.coef p0 i) ct (At[p0].K.With[cp0.1,cp0.2].c-div i) } ;
     result : Div t o = prim0 t coeffs ;
   } ;
   -- the claim, taking the contents of p0 and q0
   one (a0 : R) (p0 q0 : PL.P) (ep : Id Nat (plus (PL.plen p0) (PL.plen q0)) N)
     (prim0 : C.Prim (PL.coef (cons a0 p0))) (prim1 : C.Prim (PL.coef q0))
     (hh : Common d (ML.pmul (cons a0 p0) q0)) (g : GcdOf d a0) : Div g.1 o =
     D.div-from (SomeCont p0) (cont-exists p0) g.1 o (\ cp0 ->
      D.div-from (SomeCont q0) (cont-exists q0) g.1 o (\ cq0 ->
       One[a0,p0,q0,ep,prim0,prim1,hh,g,cp0,cq0].result)) ;
   cpA : Div gA.1 o = one a p (cons b q) ef pp pq h gA ;
   hs : Common d (ML.pmul (cons b q) (cons a p)) = \ i ->
     div-eq-right d _ _ (RM.mul-comm (cons a p) (cons b q) i) (h i) ;
   cpB : Div gB.1 o = one b q (cons a p) es pq pp hs gB ;
   ab : Div d (mul a b) = div-eq-right d _ _ (ML.coef0-pmul (cons a p) (cons b q)) (h zero) ;
   db : Div d b = GD.euclid d a b gA cpA ab ;
   result : Div d o = div-trans d gB.1 o (gcd-univ d b gB d (div-refl d) db) cpB ;
 } ;
 -- The empty list cannot be primitive in a nontrivial ring.
 not-prim-nil (p : C.Prim (PL.coef nil)) : Empty = G.nontrivial (div-of-zero o (p z (\ i -> div-zero z))) ;
 primitive (N : Nat) (r : Rec N) : (p q : PL.P) ->
   Id Nat (plus (PL.plen p) (PL.plen q)) (suc N) -> C.Prim (PL.coef p) -> C.Prim (PL.coef q) -> C.Prim (PL.coef (ML.pmul p q)) = split {
   nil -> \ q e pp pq -> efq (not-prim-nil pp) ;
   cons a p -> split {
     nil -> \ e pp pq -> efq (not-prim-nil pq) ;
     cons b q -> \ e pp pq d h ->
       D.div-from (GcdOf d a) (G.gcd d a) d o (\ gA ->
        D.div-from (GcdOf d b) (G.gcd d b) d o (\ gB ->
         PrimStep[N,r,a,p,b,q,e,pp,pq,d,h,gA,gB].result)) } } ;

 -- Divide a list by its nonzero content, preserving its length.
 div-len (c : R) : (p : PL.P) (w : Common c p) -> Id Nat (PL.plen (divL c p w)) (PL.plen p) = split {
   nil -> \ w -> refl zero ; cons a p | r -> \ w -> ap (\ n -> suc n) (r (\ i -> w (suc i))) } ;
 module Part (p : PL.P) (c : R) (hc : Cont p c) (nc : Not (Id R c z)) {
   module K = At[p].K.With[c,hc] ;
   qs : PL.P = divL c p K.c-div ;
   length : Id Nat (PL.plen qs) (PL.plen p) = div-len c p K.c-div ;
   eq (i : Nat) : Id R (PL.coef p i) (mul c (PL.coef qs i)) = divL-coef c p K.c-div i ;
   scaled : PL.peq p (ML.scal c qs) = \ i -> trans (eq i) (sym (ML.coef-scal c qs i)) ;
   prim : C.Prim (PL.coef qs) = \ d hd -> D.div-cancel c d o nc
     (div-eq-right (mul c d) c (mul c o) (sym (mulO c))
       (K.c-univ (mul c d) (\ i -> div-eq-right (mul c d) (mul c (PL.coef qs i)) (PL.coef p i)
         (sym (eq i)) (div-scale d (PL.coef qs i) c (hd i))))) ;
 } ;
 module Nonzero (N : Nat) (r : Rec N) (p q : PL.P)
   (e : Id Nat (plus (PL.plen p) (PL.plen q)) (suc N))
   (cp : R) (hp : Cont p cp) (cq : R) (hq : Cont q cq)
   (np : Not (Id R cp z)) (nq : Not (Id R cq z)) {
   module Pp = Part[p,cp,hp,np] ; module Pq = Part[q,cq,hq,nq] ;
   u : R = mul cp cq ;
   len' : Id Nat (plus (PL.plen Pp.qs) (PL.plen Pq.qs)) (suc N) =
     trans (Pr.cong2 Nat plus _ _ _ _ Pp.length Pq.length) e ;
   prim : C.Prim (PL.coef (ML.pmul Pp.qs Pq.qs)) = primitive N r Pp.qs Pq.qs len' Pp.prim Pq.prim ;
   scaled : PL.peq (ML.pmul p q) (ML.scal u (ML.pmul Pp.qs Pq.qs)) =
     PL.peq-trans _ _ _ (RM.mul-cong p (ML.scal Pp.c Pp.qs) q (ML.scal Pq.c Pq.qs) Pp.scaled Pq.scaled)
       (PL.peq-trans _ _ _ (RM.mul-scal-left Pp.c Pp.qs (ML.scal Pq.c Pq.qs))
         (PL.peq-trans _ _ _ (RW.scal-cong Pp.c _ _ (RM.mul-scal-right Pq.c Pp.qs Pq.qs))
           (RW.scal-scal Pp.c Pq.c (ML.pmul Pp.qs Pq.qs)))) ;
   result (d : R) (h : Common d (ML.pmul p q)) : Div d u = At[ML.pmul Pp.qs Pq.qs].K.prim-M prim u d
     (\ i -> div-eq-right d _ _ (trans (scaled i) (ML.coef-scal u (ML.pmul Pp.qs Pq.qs) i)) (h i)) ;
 } ;
 step-byQ (N : Nat) (r : Rec N) (p q : PL.P) (e : Id Nat (plus (PL.plen p) (PL.plen q)) (suc N))
   (cp : R) (hp : Cont p cp) (cq : R) (hq : Cont q cq) (d : R) (h : Common d (ML.pmul p q))
   (np : Not (Id R cp z)) : Plus (Id R cq z) (Not (Id R cq z)) -> Div d (mul cp cq) = split {
   inl q0 -> div-eq-right d z (mul cp cq) (sym (trans (ap (mul cp) q0) (mul-zero cp))) (div-zero d) ;
   inr nq -> Nonzero[N,r,p,q,e,cp,hp,cq,hq,np,nq].result d h } ;
 step-byP (N : Nat) (r : Rec N) (p q : PL.P) (e : Id Nat (plus (PL.plen p) (PL.plen q)) (suc N))
   (cp : R) (hp : Cont p cp) (cq : R) (hq : Cont q cq) (d : R) (h : Common d (ML.pmul p q))
   : Plus (Id R cp z) (Not (Id R cp z)) -> Div d (mul cp cq) = split {
   inl p0 -> div-eq-right d z (mul cp cq) (sym (trans (ap (\ t -> mul t cq) p0) (zero-mul cq))) (div-zero d) ;
   inr np -> step-byQ N r p q e cp hp cq hq d h np (G.dec cq) } ;
 step (N : Nat) (r : Rec N) (p q : PL.P) (e : Id Nat (plus (PL.plen p) (PL.plen q)) (suc N)) : Product p q =
   \ cp hp cq hq d h -> step-byP N r p q e cp hp cq hq d h (G.dec cp) ;
 at-zero : (p q : PL.P) -> Id Nat (plus (PL.plen p) (PL.plen q)) zero -> Product p q = split {
   nil -> \ q e cp hp cq hq d h -> div-eq-right d z (mul cp cq)
     (sym (trans (ap (\ t -> mul t cq) (C.cont-nil (PL.coef nil) cp hp)) (zero-mul cq))) (div-zero d) ;
   cons a p -> \ q e -> efq (suc-zero (plus (PL.plen p) (PL.plen q)) e) } ;
 induction : (N : Nat) -> Rec N = split {
   zero -> at-zero ; suc N | r -> step N r } ;
 product (p q : PL.P) : Product p q = induction (plus (PL.plen p) (PL.plen q)) p q (refl (plus (PL.plen p) (PL.plen q))) ;
 -- Conversely, products of common coefficient divisors divide the product.
 multiply-common-shift-common (c d : R) (p q : PL.P) (h : Common (mul c d) (ML.pmul p q)) : Common (mul c d) (cons z (ML.pmul p q)) = split {
   zero -> div-zero (mul c d) ; suc i -> h i } ;
 multiply-common (c d : R) (p : PL.P) (hp : Common c p) : (q : PL.P) -> Common d q -> Common (mul c d) (ML.pmul p q) = split {
   nil -> \ hq i -> div-zero (mul c d) ;
   cons b q | r -> \ hq i ->
     div-eq-right (mul c d) _ _ (sym (ML.coef-addP (ML.scal b p) (cons z (ML.pmul p q)) i))
       (div-add (mul c d) (PL.coef (ML.scal b p) i) (PL.coef (cons z (ML.pmul p q)) i)
         (div-eq-right (mul c d) (mul (PL.coef p i) b) (PL.coef (ML.scal b p) i)
           (trans (mulC (PL.coef p i) b) (sym (ML.coef-scal b p i)))
           (div-mul2 c (PL.coef p i) d b (hp i) (hq zero)))
         (multiply-common-shift-common c d p q (r (\ k -> hq (suc k))) i)) } ;
 -- Content multiplicativity up to associates, without normalising gcd units.
 content-mul-left (p q : PL.P) (cp : R) (hp : Cont p cp) (cq : R) (hq : Cont q cq)
   (c : R) (hc : Cont (ML.pmul p q) c) : Div c (mul cp cq) =
   product p q cp hp cq hq c (At[ML.pmul p q].K.With[c,hc].c-div) ;
 content-mul-right (p q : PL.P) (cp : R) (hp : Cont p cp) (cq : R) (hq : Cont q cq)
   (c : R) (hc : Cont (ML.pmul p q) c) : Div (mul cp cq) c =
   At[ML.pmul p q].K.With[c,hc].c-univ (mul cp cq)
     (multiply-common cp cq p (At[p].K.With[cp,hp].c-div) q (At[q].K.With[cq,hq].c-div)) ;
 -- Gauss on lists, for contents cp, cq of p, q
 gauss-with (p q : PL.P) (pp : C.Prim (PL.coef p)) (d : R) (h : Common d (ML.pmul p q)) (i : Nat)
   (cp : SomeCont p) (cq : SomeCont q) : Div d (PL.coef q i) =
   div-trans d cq.1 (PL.coef q i)
     (div-trans d (mul cp.1 cq.1) cq.1 (product p q cp.1 cp.2 cq.1 cq.2 d h)
       (div-eq-right (mul cp.1 cq.1) (mul cq.1 o) cq.1 (mulO cq.1)
         (div-eq-left (mul cq.1 cp.1) (mul cp.1 cq.1) (mul cq.1 o)
           (mulC cq.1 cp.1) (div-scale cp.1 o cq.1 (At[p].K.With[cp.1,cp.2].prim-c pp)))))
     (At[q].K.With[cq.1,cq.2].c-div i) ;
 gauss (p q : PL.P) (pp : C.Prim (PL.coef p)) (d : R) (h : Common d (ML.pmul p q)) (i : Nat) : Div d (PL.coef q i) =
   D.div-from (SomeCont p) (cont-exists p) d (PL.coef q i) (\ cp ->
    D.div-from (SomeCont q) (cont-exists q) d (PL.coef q i) (\ cq -> gauss-with p q pp d h i cp cq)) ;
} ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 open A ; open RL[A] ; open GcdDomain[l].Divisibility[A] ;
 module PB = PolyBase[l].Over[A,G] ;
 open PB ;
 module DP = Direct[A,G] ;

 -- Lemme 7 on coefficient lists, by direct content induction.
 gauss-list (p : PL.P) (pr : C.Prim (PL.coef p)) (d : R) (q : PL.P)
   (hd : (k : Nat) -> Div d (PL.coef (ML.pmul p q) k)) (j : Nat) : Div d (PL.coef q j) =
   DP.gauss p q pr d hd j ;

 -- Lemme 7 on A[X], for d /= 0
 module GaussAt (d : R) (hd0 : Not (Id R d z)) {
  Concl (y : Pol) : U l = (j : Nat) -> Div d (coef y j) ;
  concl-prop (y : Pol) : Pr.isProp (Concl y) = FE.isProp-Pi Nat (\ j -> Div d (coef y j)) (\ j -> D.div-prop d (coef y j) hd0) ;
  Stmt (x y : Pol) : U l = Prim x -> ((k : Nat) -> Div d (coef (B.mulQ x y) k)) -> Concl y ;
  stmt-prop (x y : Pol) : Pr.isProp (Stmt x y) =
   FE.isProp-Pi (Prim x) (\ px -> ((k : Nat) -> Div d (coef (B.mulQ x y) k)) -> Concl y)
    (\ px -> FE.isProp-Pi ((k : Nat) -> Div d (coef (B.mulQ x y) k)) (\ h -> Concl y) (\ h -> concl-prop y)) ;
  on-lists (p q : PL.P) : Stmt (B.include p) (B.include q) = \ px hd j ->
   div-eq-right d (PL.coef q j) (coef (B.include q) j) (sym (CP.coef-include q j))
    (gauss-list p (prim-include p px) d q
      (\ k -> div-eq-right d (coef (B.mulQ (B.include p) (B.include q)) k) (PL.coef (ML.pmul p q) k) (coef-mul-include p q k) (hd k)) j) ;
  gauss : (x y : Pol) -> Stmt x y = B.forall2 Stmt stmt-prop on-lists ;
 } ;

 -- Lemme 8
 module DivPrim (E f q : Pol) (pE : Prim E) (lam : R) (hl : Not (Id R lam z))
  (e : Id Pol (sc lam f) (B.mulQ E q)) {
  module S = Scalar[lam,hl] ;
  dq : S.Divides q = GaussAt[lam,hl].gauss E q pE
   (\ k -> div-eq-right lam (coef (sc lam f) k) (coef (B.mulQ E q) k) (ap (\ w -> coef w k) e)
            (div-eq-right lam (mul lam (coef f k)) (coef (sc lam f) k) (sym (coef-sc lam f k)) (div-factor lam (coef f k)))) ;
  q' : Pol = (S.divide q dq).1 ;
  same : Id Pol (sc lam f) (sc lam (B.mulQ E q')) =
   trans e (trans (ap (B.mulQ E) (S.divide q dq).2) (LB.mul-swap E (B.constant lam) q')) ;
  result : DB.Div E f = (q', S.cancel f (B.mulQ E q') same) ;
 } ;
} ;
