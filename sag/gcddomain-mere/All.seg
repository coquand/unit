-- Gauss's lemma and "A gcd domain => A[X] gcd domain", trimmed from sag/gcd
-- as a reading example (informal text: unit/doc/gcddomain.tex; this copy: gcds merely exist).
import Base ; import Prelude ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ; import Poly ; import Mul ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 -- A[X] as a quotient of coefficient lists
 import Truncation ; import Quotient ;
 import RawLaws ; import RawMultiplication ; import RingHom ; import PolynomialRing ; import Coefficients ;
 -- the algebra
 import NatOrder ; import GcdDomain ; import Content ; import PolyBase ; import Gauss ; import Elimination ; import Degree ; import PolyGcd ;
} ;
