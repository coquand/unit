-- mu_ijk on frames (../HANDOFF-GABBER-HOMOTOPY.md).  Over an affine Y = Spec L
-- (L finitely presented), let G be a family of R^x-gerbes with three point
-- families a, b, c, and T_ab, T_bc, T_ac the torsors of paths (GERBE).
-- Frame data for the lines of T_ab and T_bc (AFFINELINEDATA: frames s_j,
-- dual frames d_j with sum_j <d_j, s_j> = 1) give frame data for T_ac:
--     s_(j,i) = s_j s'_i,   d_(j,i) = d_j d'_i        (PATHPRODUCT),
-- indexed by Fin (m n) (PAIRING), since
--     sum_(j,i) <d_j d'_i, s_j s'_i> = (sum_j <d_j, s_j>)(sum_i <d'_i, s'_i>) = 1
-- by multiplicativity of the pairing.  The projector of these data
-- (AFFINELINEPROJECTOR) is the Kronecker product of the two projectors:
--     <d_j d'_i, s_k s'_h> = <d_j, s_k> <d'_i, s'_h>,
-- checked at every point of Y (SQC).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module RR = RL[R] ;
 module PSum = Pairing[l].Sums[R] ;
 Tor : U l+ = TorsorId[l].TorId[UG.group].Tor ;
 module At (L : C.Algebra) (fp : P.FP L) (G : C.Spec L -> GB.AGerbe) (pa pb pc : (y : C.Spec L) -> (G y).1) {
  Y : U l = C.Spec L ;
  Tab (y : Y) : Tor = GB.GL[G y].PTor (pa y) (pb y) ;
  Tbc (y : Y) : Tor = GB.GL[G y].PTor (pb y) (pc y) ;
  Tac (y : Y) : Tor = GB.GL[G y].PTor (pa y) (pc y) ;
  module DAB = AffineLineData[l].Over[R,setR,axioms].At[L,fp,Tab] ;
  module DBC = AffineLineData[l].Over[R,setR,axioms].At[L,fp,Tbc] ;
  module DAC = AffineLineData[l].Over[R,setR,axioms].At[L,fp,Tac] ;
  module Product (wab : DAB.Data) (wbc : DBC.Data) {
   m : Nat = wab.1 ;
   n : Nat = wbc.1 ;
   N : Nat = Pairing[l].times m n ;
   first (x : Fin N) : Fin m = (Pairing[l].unpair n m x).1 ;
   second (x : Fin N) : Fin n = (Pairing[l].unpair n m x).2 ;
   ss (x : Fin N) : DAC.Sections = \ y ->
    PathProduct[l].Over[R,setR].At[G y].Multiplicative[pa y,pb y,pc y].LX.product (wab.2.1 (first x) y) (wbc.2.1 (second x) y) ;
   ds (x : Fin N) : DAC.DualSections = \ y ->
    PathProduct[l].Over[R,setR].At[G y].Multiplicative[pa y,pb y,pc y].DX.product (wab.2.2.1 (first x) y) (wbc.2.2.1 (second x) y) ;
   -- <d_j d'_i, s_k s'_h> = <d_j, s_k> <d'_i, s'_h>
   pair-product (x x' : Fin N) (y : Y) :
    Id R.R (DAC.pair (ds x) (ss x') y) (R.mul (DAB.pair (wab.2.2.1 (first x)) (wab.2.1 (first x')) y) (DBC.pair (wbc.2.2.1 (second x)) (wbc.2.1 (second x')) y)) =
    PathProduct[l].Over[R,setR].At[G y].Multiplicative[pa y,pb y,pc y].multiplicative
     (wab.2.2.1 (first x) y) (wbc.2.2.1 (second x) y) (wab.2.1 (first x') y) (wbc.2.1 (second x') y) ;
   -- the sum over Fin (m n) as a double sum
   double (A : Fin m -> R.R) (B : Fin n -> R.R) :
    Id R.R (RS.sum N (\ x -> R.mul (A (first x)) (B (second x)))) (R.mul (RS.sum m A) (RS.sum n B)) =
    calc R.R { RS.sum N (\ x -> R.mul (A (first x)) (B (second x)))
      =< PSum.sum-pair n m (\ x -> R.mul (A (first x)) (B (second x))) >
         RS.sum m (\ j -> RS.sum n (\ i -> R.mul (A (first (Pairing[l].pair n m j i))) (B (second (Pairing[l].pair n m j i)))))
      =< RS.sum-cong m _ (\ j -> R.mul (A j) (RS.sum n B)) (\ j ->
          trans (RS.sum-cong n _ (\ i -> R.mul (A j) (B i)) (\ i ->
            ap (\ q -> R.mul (A q.1) (B q.2)) (Pairing[l].unpair-pair n m j i)))
           (RS.sum-scale (A j) n B)) > RS.sum m (\ j -> R.mul (A j) (RS.sum n B))
      =< RS.sum-cong m _ (\ j -> R.mul (RS.sum n B) (A j)) (\ j -> R.mulC (A j) (RS.sum n B)) >
         RS.sum m (\ j -> R.mul (RS.sum n B) (A j))
      =< RS.sum-scale (RS.sum n B) m A > R.mul (RS.sum n B) (RS.sum m A)
      =< R.mulC (RS.sum n B) (RS.sum m A) > R.mul (RS.sum m A) (RS.sum n B) } ;
   total (y : Y) : Id R.R (RS.sum N (\ x -> DAC.pair (ds x) (ss x) y)) R.o =
    calc R.R { RS.sum N (\ x -> DAC.pair (ds x) (ss x) y)
      =< RS.sum-cong N _ _ (\ x -> pair-product x x y) >
         RS.sum N (\ x -> R.mul (DAB.pair (wab.2.2.1 (first x)) (wab.2.1 (first x)) y) (DBC.pair (wbc.2.2.1 (second x)) (wbc.2.1 (second x)) y))
      =< double (\ j -> DAB.pair (wab.2.2.1 j) (wab.2.1 j) y) (\ i -> DBC.pair (wbc.2.2.1 i) (wbc.2.1 i) y) >
         R.mul (RS.sum m (\ j -> DAB.pair (wab.2.2.1 j) (wab.2.1 j) y)) (RS.sum n (\ i -> DBC.pair (wbc.2.2.1 i) (wbc.2.1 i) y))
      =< cong2 R.R R.mul _ _ _ _ (wab.2.2.2 y) (wbc.2.2.2 y) > R.mul R.o R.o
      =< R.mulO R.o > R.o } ;
   product-data : DAC.Data = (N,(ss,(ds,total))) ;
   -- the projector of the product data is the Kronecker product
   module PAB = AffineLineProjector[l].Over[R,setR,axioms].At[L,fp,Tab].From[wab] ;
   module PBC = AffineLineProjector[l].Over[R,setR,axioms].At[L,fp,Tbc].From[wbc] ;
   module PAC = AffineLineProjector[l].Over[R,setR,axioms].At[L,fp,Tac].From[product-data] ;
   kronecker (x x' : Fin N) :
    Id L.ring.R (PAC.entry x x') (L.ring.mul (PAB.entry (first x) (first x')) (PBC.entry (second x) (second x'))) =
    AffineLineProjector[l].Over[R,setR,axioms].At[L,fp,Tac].ext _ _ (\ y ->
     calc R.R { y.1.1 (PAC.entry x x')
       =< PAC.beta x x' y > DAC.pair (ds x) (ss x') y
       =< pair-product x x' y >
          R.mul (DAB.pair (wab.2.2.1 (first x)) (wab.2.1 (first x')) y) (DBC.pair (wbc.2.2.1 (second x)) (wbc.2.1 (second x')) y)
       =< sym (cong2 R.R R.mul _ _ _ _ (PAB.beta (first x) (first x') y) (PBC.beta (second x) (second x') y)) >
          R.mul (y.1.1 (PAB.entry (first x) (first x'))) (y.1.1 (PBC.entry (second x) (second x')))
       =< sym (y.1.2.2.2 (PAB.entry (first x) (first x')) (PBC.entry (second x) (second x'))) >
          y.1.1 (L.ring.mul (PAB.entry (first x) (first x')) (PBC.entry (second x) (second x'))) }) ;
  } ;
 } ;
} ;
