-- Lines over an affine as images of projectors in the sense of PROJECTORS
-- (../HANDOFF-GABBER-HOMOTOPY.md).  For frame data w of a family of torsors
-- T over Spec L (AFFINELINEDATA), the rank-one projector of AFFINELINEPROJECTOR
-- is a projector over L (its idempotence is entrywise), and its image is
-- its fixed vectors.  The global sections of the line are encoded in the
-- image, additively and L-linearly (coordinates-add, coordinates-scale);
-- so decoding is additive and linear as well, and two frame data w, w' of
-- the same line give isomorphic images: v |-> encode' (decode v).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 Tor : U l+ = TorsorId[l].TorId[UG.group].Tor ;
 module At (L : C.Algebra) (fp : P.FP L) (T : C.Spec L -> Tor) {
  module D = AffineLineData[l].Over[R,setR,axioms].At[L,fp,T] ;
  module AP = AffineLineProjector[l].Over[R,setR,axioms].At[L,fp,T] ;
  module PJ = Projectors[l].Over[L.ring,L.set] ;
  module MI = PJ.MI ;
  -- pointwise sums and multiples of sections
  sadd (s t : D.Sections) : D.Sections = \ x -> (D.LM x).madd (s x) (t x) ;
  sscale (a : L.ring.R) (s : D.Sections) : D.Sections = \ x -> (D.LM x).sm (x.1.1 a) (s x) ;
  module Of (w : D.Data) {
   module E = AP.From[w] ;
   n : Nat = w.1 ;
   module MA = MnAlgebra[l].Over[L.ring,L.set,n] ;
   projector : PJ.Projector = new PJ.Projector[n,E.entry,MA.mat-eq (MA.mmul E.entry E.entry) E.entry E.projector.idempotent] ;
   module I = PJ.Image[projector] ;
   to-fixed (x : I.Carrier) : E.Fixed.Fixed E.entry = (I.value x,\ i -> I.V.entry _ _ (I.member x) i) ;
   from-fixed (v : E.Fixed.Fixed E.entry) : I.Carrier = (v.1,I.V.vec-eq _ _ v.2) ;
   encode (s : D.Sections) : I.Carrier = from-fixed (E.encode s) ;
   decode (x : I.Carrier) : D.Sections = E.decode (to-fixed x) ;
   decode-encode (s : D.Sections) : Id D.Sections (decode (encode s)) s =
    trans (ap E.decode (Pr.Sigma-eq E.M.Vector (\ a -> (i : Fin n) -> Id L.ring.R (E.M.action E.entry a i) (a i))
      (to-fixed (encode s)).1 (E.encode s).1 (to-fixed (encode s)).2 (E.encode s).2 (refl (E.encode s).1)
      (E.Fixed.fixed-prop E.entry (E.encode s).1)))
     (E.decode-encode s) ;
   encode-decode (x : I.Carrier) : Id I.Carrier (encode (decode x)) x =
    I.ext (encode (decode x)) x (ap (\ v -> v.1) (E.encode-decode (to-fixed x))) ;
   encode-add (s t : D.Sections) : Id I.Carrier (encode (sadd s t)) (I.add (encode s) (encode t)) =
    I.ext (encode (sadd s t)) (I.add (encode s) (encode t)) (I.V.vec-eq _ _ (\ i -> E.coordinates-add s t i)) ;
   encode-scale (a : L.ring.R) (s : D.Sections) : Id I.Carrier (encode (sscale a s)) (I.scale a (encode s)) =
    I.ext (encode (sscale a s)) (I.scale a (encode s)) (I.V.vec-eq _ _ (\ i -> E.coordinates-scale a s i)) ;
   decode-add (x y : I.Carrier) : Id D.Sections (decode (I.add x y)) (sadd (decode x) (decode y)) =
    trans (ap decode (sym (trans (encode-add (decode x) (decode y)) (cong2 I.Carrier I.add _ _ _ _ (encode-decode x) (encode-decode y)))))
     (decode-encode (sadd (decode x) (decode y))) ;
   decode-scale (a : L.ring.R) (x : I.Carrier) : Id D.Sections (decode (I.scale a x)) (sscale a (decode x)) =
    trans (ap decode (sym (trans (encode-scale a (decode x)) (ap (I.scale a) (encode-decode x)))))
     (decode-encode (sscale a (decode x))) ;
  } ;
  -- two frame data of one line give isomorphic images
  module Compare (w w' : D.Data) {
   module A = Of[w] ;
   module B = Of[w'] ;
   to (x : A.I.Carrier) : B.I.Carrier = B.encode (A.decode x) ;
   from (y : B.I.Carrier) : A.I.Carrier = A.encode (B.decode y) ;
   iso : MI.Iso[A.I.image,B.I.image] = MI.make A.I.image B.I.image to from
    (\ x y -> trans (ap B.encode (A.decode-add x y)) (B.encode-add (A.decode x) (A.decode y)))
    (\ a x -> trans (ap B.encode (A.decode-scale a x)) (B.encode-scale a (A.decode x)))
    (\ y -> trans (ap B.encode (A.decode-encode (B.decode y))) (B.encode-decode y))
    (\ x -> trans (ap A.encode (B.decode-encode (A.decode x))) (A.encode-decode x)) ;
  } ;
 } ;
} ;
