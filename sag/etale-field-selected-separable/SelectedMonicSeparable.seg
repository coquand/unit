-- On a selected factor eQ of Q=k[T]/f, nondegenerate trace forces every
-- derivative annihilator to vanish. A regular witness for f' in Q then
-- supplies the derivative inverse in eQ. No monogenic presentation of
-- eQ itself is assumed: the derivation is first Q->eQ and then restricted.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (lower : List k.R) {
 module M = MonicBasisUniversal[l].Over[k,setk].At[lower] ;
 module C = Algebras[l].Over[k,setk] ; Q : C.Algebra = M.Q ;
 module V = MonicDualValues[l].Over[k,Q.ring,Q.set,Q.iota,M.x] ;
 derivative : Q.ring.R = V.slope lower ;
 module Factor (e : Q.ring.R) (he : Id Q.ring.R (Q.ring.mul e e) e)
  (n : Nat) (basis : TraceBasis[l].Over[k,setk,TraceRetraction[l].Idempotent[k,setk,Q,e,he].algebra].Basis[n]) {
  module R = TraceRetraction[l].Idempotent[k,setk,Q,e,he] ;
  module TB = TraceBasis[l].Over[k,setk,R.algebra].At[n,basis] ;
  module Nat = MonicValueNaturality[l].Over[k,setk].Map[Q,R.algebra,R.projection,M.x] ;
  module Slope = MonicSlopeNaturality[l].Over[k,setk].Map[Q,R.algebra,R.projection,M.x] ;
  root : Id R.F.Carrier (MonicBasisUniversal[l].Values[k,R.F.ring,R.iota,R.F.project M.x].value lower) R.F.zero =
   trans (sym (Nat.value lower))
    (trans (ap R.F.project M.root) (RingHom[l].zero Q.ring R.F.ring R.F.projection)) ;
  module Relative = MonicRelativeDerivation[l].Over[k,setk,lower,R.algebra,R.F.project M.x,root] ;
  same (a : Q.ring.R) : Id R.F.Carrier (Relative.hom.1.1 a) (R.F.project a) =
   M.unique R.algebra Relative.hom R.projection Relative.To.beta a ;
  module Retarget = RelativeDerivations[l].Retarget[k,setk,Q,R.algebra,Relative.hom,R.projection,same] ;
  module Restrict = IdempotentDerivation[l].Over[k,setk,Q,e,he] ;
  Nondegenerate : U l = (a : R.F.Carrier) ->
   ((b : R.F.Carrier) -> Id k.R (TB.trace (R.F.mul a b)) k.z) -> Id R.F.Carrier a R.F.zero ;
  module Annihilator (nd : Nondegenerate) (a : R.F.Carrier)
   (killed : Id R.F.Carrier (R.F.mul Relative.derivative a) R.F.zero) {
   module D = Relative.At[a,killed] ;
   module Cut = Restrict.Given[Retarget.map D.derivation].Trace[n,basis] ;
   zero : Id R.F.Carrier a R.F.zero = trans (sym D.generator) (Cut.theorem nd M.x) ;
  } ;
  module Witness (nd : Nondegenerate) (b : Q.ring.R)
   (hb : Id Q.ring.R derivative (Q.ring.mul (Q.ring.mul derivative derivative) b)) {
   module L = RL[Q.ring] ; module FL = RL[R.F.ring] ;
   complement : Q.ring.R = Q.ring.add Q.ring.o (Q.ring.neg (Q.ring.mul derivative b)) ;
   kills : Id Q.ring.R (Q.ring.mul derivative complement) Q.ring.z =
    trans (Q.ring.dist derivative Q.ring.o (Q.ring.neg (Q.ring.mul derivative b)))
     (trans (cong2 Q.ring.R Q.ring.add _ _ _ _ (Q.ring.mulO derivative)
      (trans (L.mul-neg derivative (Q.ring.mul derivative b))
       (ap Q.ring.neg (trans (Q.ring.mulA derivative derivative b) (sym hb))))) (Q.ring.addN derivative)) ;
   projected-kills : Id R.F.Carrier (R.F.mul Relative.derivative (R.F.project complement)) R.F.zero =
    trans (ap (\ a -> R.F.mul a (R.F.project complement)) (sym (Slope.slope lower)))
     (trans (sym (R.F.project-mul derivative complement))
      (trans (ap R.F.project kills) (RingHom[l].zero Q.ring R.F.ring R.F.projection))) ;
   complement-zero : Id R.F.Carrier (R.F.project complement) R.F.zero =
    Annihilator[nd,R.F.project complement,projected-kills].zero ;
   inverse-equation : Id R.F.Carrier (R.F.mul (R.F.project derivative) (R.F.project b)) R.F.one =
    sym (FormallyEtale[l].Units[R.F.ring,R.F.set].sub-zero R.F.one (R.F.mul (R.F.project derivative) (R.F.project b))
     (trans (sym (trans (R.F.project-add Q.ring.o (Q.ring.neg (Q.ring.mul derivative b)))
      (cong2 R.F.Carrier R.F.add _ _ _ _ R.F.project-one
       (trans (RingHom[l].negation Q.ring R.F.ring R.F.projection (Q.ring.mul derivative b))
        (ap R.F.neg (R.F.project-mul derivative b)))))) complement-zero)) ;
   unit : FL.unit (R.F.project derivative) = (R.F.project b,inverse-equation) ;
  } ;
  theorem (nd : Nondegenerate) (regular : PrincipalRegularity[l].Over[Q.ring].Regular) : RL[R.F.ring].unit (R.F.project derivative) =
   TC.rec (PrincipalRegularity[l].Over[Q.ring].Witness derivative) @l (RL[R.F.ring].unit (R.F.project derivative))
    (FormallyEtale[l].Units[R.F.ring,R.F.set].unit-prop _) (\ w -> Witness[nd,w.1,w.2].unit) (regular derivative) ;
 } ;
} ;
