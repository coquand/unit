-- A finite product of idempotents remains outside a specified prime
-- when every factor does. Explicit divisibility preserves all equations
-- killed by an individual factor, including derivative-inverse equations.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) {
 module L = RL[A] ; module PI = PrimeIdempotents[l].Over[A] ;
 product : (n : Nat) -> (Fin n -> A.R) -> A.R = split {
  zero -> \ a -> A.o ; suc n | ih -> \ a -> A.mul (a (inr tt)) (ih (\ i -> a (inl i))) } ;
 square : (n : Nat) (a : Fin n -> A.R) -> ((i : Fin n) -> Id A.R (A.mul (a i) (a i)) (a i)) ->
  Id A.R (A.mul (product n a) (product n a)) (product n a) = split {
  zero -> \ a ha -> A.mulO A.o ;
  suc n | ih -> \ a ha -> PI.product-idempotent (a (inr tt)) (product n (\ i -> a (inl i)))
   (ha (inr tt)) (ih (\ i -> a (inl i)) (\ i -> ha (inl i))) } ;
 choose (q : PI.Prime) (a b : A.R) (ha : Not (q.ideal.In a)) (hb : Not (q.ideal.In b)) :
  Plus (q.ideal.In a) (q.ideal.In b) -> Empty = split { inl h -> ha h ; inr h -> hb h } ;
 outside (q : PI.Prime) : (n : Nat) (a : Fin n -> A.R) -> ((i : Fin n) -> Not (q.ideal.In (a i))) -> Not (q.ideal.In (product n a)) = split {
  zero -> \ a ha -> q.proper ;
  suc n | ih -> \ a ha h -> choose q (a (inr tt)) (product n (\ i -> a (inl i))) (ha (inr tt))
   (ih (\ i -> a (inl i)) (\ i -> ha (inl i))) (q.prime _ _ h) } ;
 Divides (a b : A.R) : U l = (c : A.R) * Id A.R b (A.mul a c) ;
 divides : (n : Nat) (a : Fin n -> A.R) (i : Fin n) -> Divides (a i) (product n a) = split {
  zero -> \ a i -> efq i ;
  suc n | ih -> \ a -> split {
   inl i -> (A.mul (a (inr tt)) (ih (\ j -> a (inl j)) i).1,
    trans (ap (A.mul (a (inr tt))) (ih (\ j -> a (inl j)) i).2)
     (L.mul-swap (a (inr tt)) (a (inl i)) (ih (\ j -> a (inl j)) i).1)) ;
   inr t -> (product n (\ i -> a (inl i)),
    ap (\ u -> A.mul (a (inr u)) (product n (\ i -> a (inl i)))) (MnSums[l].top-eq tt t)) } } ;
 kills (n : Nat) (a : Fin n -> A.R) (i : Fin n) (b : A.R) (eq : Id A.R (A.mul (a i) b) A.z) :
  Id A.R (A.mul (product n a) b) A.z =
  trans (ap (\ c -> A.mul c b) (divides n a i).2)
   (trans (sym (A.mulA (a i) (divides n a i).1 b))
    (trans (L.mul-swap (a i) (divides n a i).1 b)
     (trans (ap (A.mul (divides n a i).1) eq) (L.mul-zero (divides n a i).1)))) ;
} ;
