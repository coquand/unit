-- The full selected-separability construction on F2 x F2. Neither the
-- old handwritten selected certificate nor a derivative-unit hypothesis
-- is supplied. Also exercise a common factor for both basis elements,
-- repeated elements, and the empty family.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module T = PrimitiveRegression[l] ;
module BF = BooleanRing[l] ;
module One = SelectedSeparableAnnihilator[l].Over[T.k,BF.bool-set,T.field,T.S,T.two,T.basis,T.reduced,T.perfect,T.q] ;
point : T.Pair = (true,false) ;
constructed : Tr.Trunc[One.Result[point]].carrier = One.theorem point ;
constant-zero : Tr.Trunc[One.Result[T.z]].carrier = One.theorem T.z ;
constant-one : Tr.Trunc[One.Result[T.o]].carrier = One.theorem T.o ;
module Known = One.At[point].Given[T.minimal] ;
from-known-minimal : Tr.Trunc[One.Result[point]].carrier = Known.theorem ;
module Verify (r : Known.Select.B.Result) {
 module C = Known.Chosen[r] ;
 kept-minimal : Id (List T.k.R) C.result.lower T.minimal.lower = refl T.minimal.lower ;
 global-root : Id T.Pair (One.St.value point (SelectedFactorStatement[l].Over[T.k,BF.bool-set].monic C.result.lower)) T.z = C.result.annihilates ;
 derivative-unit : RL[C.F.BasePart.F.ring].unit (C.F.BasePart.F.project C.Sep.derivative) = C.unit ;
 selected-equation : Id T.Pair
  (T.A.mul C.result.idempotent
   (T.A.add (T.A.mul (One.St.slope point (SelectedFactorStatement[l].Over[T.k,BF.bool-set].monic C.result.lower)) C.result.inverse)
    (T.A.neg T.A.o))) T.z = C.result.separable ;
} ;
module Many = CommonSeparableFactor[l].Over[T.k,BF.bool-set,T.field,T.S,T.two,T.basis,T.reduced,T.perfect,T.q] ;
both-basis : Tr.Trunc[Many.Family[T.two,T.basis.vector].Result].carrier = Many.basis-family ;
repeated : Tr.Trunc[Many.Family[T.two,\ i -> point].Result].carrier = Many.Family[T.two,\ i -> point].theorem ;
empty : Tr.Trunc[Many.Family[zero,\ i -> efq i].Result].carrier = Many.Family[zero,\ i -> efq i].theorem ;
module Product = FiniteIdempotentProduct[l].Over[T.A] ;
factors : Fin T.two -> T.Pair = snoc (Fin T.one) T.Pair (\ i -> point) T.o ;
product-value : Id T.Pair (Product.product T.two factors) point = refl point ;
product-kills-other : Id T.Pair (T.A.mul (Product.product T.two factors) (false,true)) T.z =
 Product.kills T.two factors T.i0 (false,true) (refl T.z) ;
product-outside : Not (T.member (Product.product T.two factors)) = Product.outside T.q T.two factors
 (T.two-elim (\ i -> Not (T.member (factors i))) T.nonzero T.nonzero) ;
