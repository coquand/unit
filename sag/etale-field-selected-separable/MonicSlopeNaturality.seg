-- The monic Horner derivative commutes with algebra maps. Recursion
-- uses its proved slope formula and ordinary monic value naturality.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ;
 module Map (S T : C.Algebra) (h : C.Hom S T) (x : S.ring.R) {
  module V = MonicValueNaturality[l].Over[k,setk].Map[S,T,h,x] ;
  module DS = MonicDualValues[l].Over[k,S.ring,S.set,S.iota,x] ;
  module DT = MonicDualValues[l].Over[k,T.ring,T.set,T.iota,h.1.1 x] ;
  slope : (cs : List k.R) -> Id T.ring.R (h.1.1 (DS.slope cs)) (DT.slope cs) = split {
   nil -> RingHom[l].zero S.ring T.ring h.1 ;
   cons a cs | ih -> trans (ap h.1.1 (DS.slope-cons a cs))
    (trans (h.1.2.2.1 (S.ring.mul x (DS.slope cs)) (DS.Plain.value cs))
     (trans (cong2 T.ring.R T.ring.add _ _ _ _
      (trans (h.1.2.2.2 x (DS.slope cs)) (ap (T.ring.mul (h.1.1 x)) ih)) (V.value cs))
      (sym (DT.slope-cons a cs)))) } ;
 } ;
 module Ordinary (S : C.Algebra) (x : S.ring.R) {
  module D = MonicDualValues[l].Over[k,S.ring,S.set,S.iota,x] ;
  dual-algebra : C.Algebra = C.mkAlgebra D.D.ring D.D.set D.dual ;
  module St = SelectedFactorStatement[l].Over[k,setk].At[S] ;
  slope (cs : List k.R) : Id S.ring.R
   (St.slope x (SelectedFactorStatement[l].Over[k,setk].monic cs)) (D.slope cs) =
   ap (\ a -> a.2) (MonicValueNaturality[l].Over[k,setk].Horner[dual-algebra,(x,S.ring.o)].equation cs) ;
 } ;
} ;
