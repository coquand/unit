-- For one specified element x, a finite reduced field algebra with
-- perfect trace has a monic annihilator whose derivative is invertible
-- on one idempotent factor outside the specified prime. The polynomial
-- is the constructed minimal polynomial in the original ambient algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (perfect : PerfectTraceNondegenerate[l].Over[k,setk,S,n,basis].Perfect)
 (q : PrimeIdempotents[l].Over[S.ring].Prime) {
 module St = SelectedFactorStatement[l].Over[k,setk].At[S] ;
 module ND = PerfectTraceNondegenerate[l].Over[k,setk,S,n,basis] ;
 module L = RL[S.ring] ; module H = RingHom[l] ;
 record Result (x : S.ring.R) {
  idempotent : S.ring.R ; square : Id S.ring.R (S.ring.mul idempotent idempotent) idempotent ;
  outside : Not (q.ideal.In idempotent) ;
  lower : List k.R ;
  annihilates : Id S.ring.R (St.value x (SelectedFactorStatement[l].Over[k,setk].monic lower)) S.ring.z ;
  root : Id S.ring.R (S.ring.mul idempotent (St.value x (SelectedFactorStatement[l].Over[k,setk].monic lower))) S.ring.z ;
  inverse : S.ring.R ;
  separable : Id S.ring.R
   (S.ring.mul idempotent (S.ring.add
    (S.ring.mul (St.slope x (SelectedFactorStatement[l].Over[k,setk].monic lower)) inverse) (S.ring.neg S.ring.o))) S.ring.z ;
 } ;
 module At (x : S.ring.R) {
  module Injection = MinimalPolynomialInjection[l].Over[k,setk,field,S,n,basis,x] ;
  module Given (f : Injection.Min.Minimal) {
   module I = Injection.At[f] ; module Reg = I.Reduced[reduced] ; module Prime = I.Prime[q] ;
   module Select = SelectedFiniteAlgebraBasis[l].Over[k,setk,I.Q,S,I.hom,I.M.degree,n,I.M.basis,basis,Prime.theorem,Reg.regular] ;
   module Chosen (r : Select.B.Result) {
    module F = Select.Factor[r] ; module B = F.Field[field.decide] ;
    module ST = F.Target.Bases[n,B.TargetBasis.rank,basis,B.target-basis].Theorem ;
    module BT = TraceBasis[l].Over[k,setk,F.BasePart.algebra].At[B.BaseBasis.rank,B.base-basis] ;
    module TT = TraceTransitivity[l].Over[k,setk,F.BasePart.algebra,F.Target.algebra,F.inclusion,
     B.BaseBasis.rank,B.TargetBasis.rank,B.base-basis,B.target-basis].Free[r.rank,r.basis] ;
    module TB = TraceBasis[l].Over[k,setk,F.Target.algebra].At[B.TargetBasis.rank,B.target-basis] ;
    target-nondegenerate (a : F.Target.F.Carrier)
     (h : (b : F.Target.F.Carrier) -> Id k.R (TB.trace (F.Target.F.mul a b)) k.z) :
     Id F.Target.F.Carrier a F.Target.F.zero = ST.nondegenerate (ND.nondegenerate perfect) a h ;
    base-nondegenerate (a : F.BasePart.F.Carrier)
     (h : (b : F.BasePart.F.Carrier) -> Id k.R (BT.trace (F.BasePart.F.mul a b)) k.z) :
     Id F.BasePart.F.Carrier a F.BasePart.F.zero =
     TT.Descend[F.Injective[I.injective].injective-arrow,target-nondegenerate,a,h].theorem ;
    module Sep = SelectedMonicSeparable[l].Over[k,setk,f.lower] ;
    module Der = Sep.Factor[r.e,r.idempotent,B.BaseBasis.rank,B.base-basis] ;
    unit : RL[F.BasePart.F.ring].unit (F.BasePart.F.project Sep.derivative) = Der.theorem base-nondegenerate Reg.regular ;
    eps : S.ring.R = I.hom.1.1 r.e ;
    inverse : S.ring.R = I.hom.1.1 unit.1.1 ;
    module Natural = MonicSlopeNaturality[l].Over[k,setk].Map[I.Q,S,I.hom,I.M.x] ;
    module Ordinary = MonicSlopeNaturality[l].Over[k,setk].Ordinary[S,x] ;
    polynomial : List k.R = SelectedFactorStatement[l].Over[k,setk].monic f.lower ;
    derivative-image : Id S.ring.R (I.hom.1.1 Sep.derivative) (St.slope x polynomial) =
     trans (Natural.slope f.lower)
      (trans (ap (\ y -> MonicDualValues[l].Over[k,S.ring,S.set,S.iota,y].slope f.lower) I.beta)
       (sym (Ordinary.slope f.lower))) ;
    unit-image : Id S.ring.R (S.ring.mul (S.ring.mul eps (I.hom.1.1 Sep.derivative)) inverse) eps =
     trans (sym (trans (I.hom.1.2.2.2 (I.Q.ring.mul r.e Sep.derivative) unit.1.1)
      (ap (\ a -> S.ring.mul a inverse) (I.hom.1.2.2.2 r.e Sep.derivative))))
      (ap I.hom.1.1 (ap (\ a -> a.1) unit.2)) ;
    absorbs : Id S.ring.R (S.ring.mul eps (S.ring.mul (St.slope x polynomial) inverse)) eps =
     trans (S.ring.mulA eps (St.slope x polynomial) inverse)
      (trans (ap (\ a -> S.ring.mul (S.ring.mul eps a) inverse) (sym derivative-image)) unit-image) ;
    separable : Id S.ring.R (S.ring.mul eps (S.ring.add (S.ring.mul (St.slope x polynomial) inverse) (S.ring.neg S.ring.o))) S.ring.z =
     trans (S.ring.dist eps (S.ring.mul (St.slope x polynomial) inverse) (S.ring.neg S.ring.o))
      (trans (cong2 S.ring.R S.ring.add _ _ _ _ absorbs
       (trans (L.mul-neg eps S.ring.o) (ap S.ring.neg (S.ring.mulO eps)))) (S.ring.addN eps)) ;
    annihilates : Id S.ring.R (St.value x polynomial) S.ring.z =
     trans (MonicValueNaturality[l].Over[k,setk].Horner[S,x].equation f.lower) I.root ;
    root : Id S.ring.R (S.ring.mul eps (St.value x polynomial)) S.ring.z =
     trans (ap (S.ring.mul eps) annihilates) (L.mul-zero eps) ;
    result : Result[x] = new Result[x,eps,F.Relative.image-idempotent,r.outside,f.lower,annihilates,root,inverse,separable] ;
   } ;
   theorem : Tr.Trunc[Result[x]].carrier = TC.map Select.B.Result Result[x] (\ r -> Chosen[r].result) Select.theorem ;
  } ;
  theorem : Tr.Trunc[Result[x]].carrier = TC.bind Injection.Min.Minimal Result[x] (\ f -> Given[f].theorem) Injection.Min.theorem ;
 } ;
 theorem (x : S.ring.R) : Tr.Trunc[Result[x]].carrier = At[x].theorem ;
} ;
