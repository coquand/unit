-- One selected factor makes the supplied monic annihilators separable
-- for every member of a finite family. Independent selected certificates
-- are intersected by multiplying their idempotents, so no repeated trace
-- descent or further basis construction is needed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (perfect : PerfectTraceNondegenerate[l].Over[k,setk,S,n,basis].Perfect)
 (q : PrimeIdempotents[l].Over[S.ring].Prime) {
 module One = SelectedSeparableAnnihilator[l].Over[k,setk,field,S,n,basis,reduced,perfect,q] ;
 module P = FiniteIdempotentProduct[l].Over[S.ring] ;
 module St = One.St ; module L = RL[S.ring] ;
 module Family (t : Nat) (x : Fin t -> S.ring.R) {
  record Result {
   idempotent : S.ring.R ; square : Id S.ring.R (S.ring.mul idempotent idempotent) idempotent ;
   outside : Not (q.ideal.In idempotent) ;
   lower : Fin t -> List k.R ;
   annihilates (i : Fin t) : Id S.ring.R
    (St.value (x i) (SelectedFactorStatement[l].Over[k,setk].monic (lower i))) S.ring.z ;
   root (i : Fin t) : Id S.ring.R (S.ring.mul idempotent
    (St.value (x i) (SelectedFactorStatement[l].Over[k,setk].monic (lower i)))) S.ring.z ;
   inverse : Fin t -> S.ring.R ;
   separable (i : Fin t) : Id S.ring.R (S.ring.mul idempotent
    (S.ring.add (S.ring.mul (St.slope (x i) (SelectedFactorStatement[l].Over[k,setk].monic (lower i))) (inverse i))
     (S.ring.neg S.ring.o))) S.ring.z ;
  } ;
  module Given (r : (i : Fin t) -> One.Result[x i]) {
   factors (i : Fin t) : S.ring.R = (r i).idempotent ;
   e : S.ring.R = P.product t factors ;
   root (i : Fin t) : Id S.ring.R (S.ring.mul e
    (St.value (x i) (SelectedFactorStatement[l].Over[k,setk].monic (r i).lower))) S.ring.z =
    P.kills t factors i _ (r i).root ;
   separable (i : Fin t) : Id S.ring.R (S.ring.mul e
    (S.ring.add (S.ring.mul (St.slope (x i) (SelectedFactorStatement[l].Over[k,setk].monic (r i).lower)) (r i).inverse)
     (S.ring.neg S.ring.o))) S.ring.z = P.kills t factors i _ (r i).separable ;
   result : Result = new Result[e,P.square t factors (\ i -> (r i).square),P.outside q t factors (\ i -> (r i).outside),
    \ i -> (r i).lower,\ i -> (r i).annihilates,root,\ i -> (r i).inverse,separable] ;
  } ;
  theorem : Tr.Trunc[Result].carrier =
   TC.map ((i : Fin t) -> One.Result[x i]) Result (\ r -> Given[r].result)
    (AffineFinite[l].choice t (\ i -> One.Result[x i]) (\ i -> One.theorem (x i))) ;
 } ;
 basis-family : Tr.Trunc[Family[n,basis.vector].Result].carrier = Family[n,basis.vector].theorem ;
} ;
