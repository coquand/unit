-- The two copies of the small types.  Sections 2-5 use Ring's Nat and
-- Presentations' Fin (n+1 = Fin n + Top); torsor/ uses Base's Nat and
-- Cech's Fin (n+1 = Opt (Fin n), with none the new element).
-- toN and toF translate; sums and powers agree definitionally step by step.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module CF = FinChoice[l] ;
toN : Nat -> Base.Nat = split { zero -> zero ; suc n | r -> suc r } ;
fromN : Base.Nat -> Nat = split { zero -> zero ; suc n | r -> suc r } ;
to-from : (n : Base.Nat) -> Id Base.Nat (toN (fromN n)) n = split {
 zero -> refl zero ; suc n | r -> ap (\ k -> suc k) r } ;
from-to : (n : Nat) -> Id Nat (fromN (toN n)) n = split {
 zero -> refl zero ; suc n | r -> ap (\ k -> suc k) r } ;
-- old elements to old elements, the new one to none
toF : (n : Nat) -> Fin n -> CF.Fin (toN n) = split {
 zero -> \ i -> efq i ;
 suc n | r -> split { inl i -> some (r i) ; inr t -> none } } ;
fromF : (n : Nat) -> CF.Fin (toN n) -> Fin n = split {
 zero -> \ i -> CF.fin-zero (\ j -> Fin zero) i ;
 suc n | r -> split { none -> inr tt ; some i -> inl (r i) } } ;
from-toF : (n : Nat) -> (i : Fin n) -> Id (Fin n) (fromF n (toF n i)) i = split {
 zero -> \ i -> efq i ;
 suc n | r -> split {
  inl i -> ap (\ j -> inl j) (r i) ;
  inr t -> ap (\ u -> inr u) (FinSum[l].top-prop tt t) } } ;
