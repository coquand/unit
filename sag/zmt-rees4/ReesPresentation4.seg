-- ReesPresentation4.seg: the Rees presentation with kernel-membership
-- certificates, for the constructed rings (handoff §2, Gates A-C, concrete).
--
-- Rings (Gate A).  B = A[X_0..X_3] = D_4(A), the tower of zmt-weighted4 over
-- A with the X-degree grading GX; R = B[U_1..U_t] = D_t(B), the tower over
-- B with the U-degree grading GU.  (The handoff's R = A[U_1..U_t][X_0..X_3]
-- is the same polynomial ring; it is built here with the X-variables first,
-- so that both gradings are the constructed ones: GX on B with B-coefficient
-- maps, GU on R over B.)  B and R are CFN (CoefficientTower.cfnD: HilbertCFN
-- at each step).  The values a_j in A give b_j = a_j in B (X-degree 0), the
-- generators P_q of J are elements of B of X-degree e_q (hP).
-- M[T] = (B/J)[T]; phi : R -> M[T], U_j |-> a_j T, has T^n coefficient
-- [ev_a (pr_n x)] (ReesGenerators4).
--
-- Gate B.  DegreeCor.Free over R with r = 1 (M = R), n = 1 and the
-- generators f = (P_1, .., P_s, U_1 - a_1 T, .., U_t - a_t T) of T-degree
-- <= 1: GenAt at m = 0 (gen zero) gives, merely, a finite list Gs of
-- elements of R (blocks of T-degree 0) with
--     every g in Gs in N cap R (the elimination ideal), and
--     every u in N cap R in the R-span of Gs.                   (presentation)
-- The elimination ideal is ker phi: ker-of-elim (via the certificates) and
-- ker-elim (via the tower decomposition of R).  Every element of the
-- elimination ideal merely has a certificate (cert) and satisfies (certU).
-- Gate C.  The bihomogeneous components comp n d g of the generators lie in
-- the elimination ideal (comp-elim) with the X-degree certificates (certX),
-- and every element of ker phi is a finite R-combination of them
-- (kernel-generated).
-- Term lists (TermLists, ConcreteT).  The P_q may be given as term lists of
-- zmt-weighted4 (TPoly A, every term of total degree e_q: HomDeg): phiT sends
-- c X^u to c X_0^u_0 X_1^u_1 X_2^u_2 X_3^u_3 in B (X_0 the variable of the
-- innermost ring, as in PolynomialRing4Bridge), and HomDeg e p gives
-- X-degree e (hom-phiT: X_k has degree 1, degrees add, constants have degree 0).
-- Nothing about the output of GenAt is predicted: only the certified
-- properties are stated.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module NA = NatArith[l] ;
module PA4 = PolynomialAction4[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

four : Nat = suc (suc (suc (suc zero))) ;

module XRing (A : CRing) (setA : Pr.isSet A.R) {
  module XT = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  -- B = A[X_0..X_3] with the X-degree
  B : CRing = XT.D four ;
  setB : Pr.isSet B.R = XT.setD four ;
  GX : Graded[A,four,B] = XT.grD four ;
  Xv (k : Ps.Fin four) : B.R = GX.var k ;
} ;

module Concrete (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) (t : Nat) (a : Ps.Fin t -> A.R)
  (s : Nat) (P : Ps.Fin s -> XRing[A,setA].B.R) (e : Ps.Fin s -> Base.Nat)
  (hP : (q : Ps.Fin s) -> Id XRing[A,setA].B.R (XRing[A,setA].GX.pr (pos (e q)) (P q)) (P q)) {
  module XR = XRing[A,setA] ;
  cfnB : CFN[l].CFN[K0,XR.B] = XR.XT.cfnD K0 cfnA four ;
  -- R = B[U_1..U_t] with the U-degree
  module UT = CoefficientPolynomial[l].CoefficientTower[XR.B,XR.setB] ;
  R : CRing = UT.D t ;
  setR : Pr.isSet R.R = UT.setD t ;
  GU : Graded[XR.B,t,R] = UT.grD t ;
  cfnR : CFN[l].CFN[K0,R] = UT.cfnD K0 cfnB t ;
  -- b_j = a_j, of X-degree 0
  b (j : Ps.Fin t) : XR.B.R = XR.GX.iota.1 (a j) ;
  hb (j : Ps.Fin t) : Id XR.B.R (XR.GX.pr zeroZ (b j)) (b j) = XR.GX.iota-hom (a j) ;

  module RC = ReesComponents4[l].Over[A,four,XR.B,XR.setB,XR.GX,t,R,setR,GU,b,s,P,e,hP,hb] ;
  module RK = RC.RK ; module RG = RK.RG ;
  -- finite decompositions in B and R
  decB : (y : XR.B.R) -> RC.DX.FinDeg y = DegreeDecomposition4[l].TowerDecomposition[A,setA].fin-deg four ;
  decR : (x : R.R) -> RC.DU.FinDeg x = DegreeDecomposition4[l].TowerDecomposition[XR.B,XR.setB].fin-deg t ;

  -- DegreeCor (Cor. 10) over R, M = R^1, T-degree bound n = 1, the s + t generators
  module DC = DegreeCor[l].Free[R,cfnR.disc,cfnR.coh,CFN[l].fl K0 R cfnR,suc zero,suc zero,RG.S,RG.gens] ;
  Blk1 : U l = RK.Blk1 ;
  module MS = Spans[l].Over[R,RK.SQ.blk (suc zero)] ;

  -- the Rees presentation: a finite generating list of the elimination ideal
  ReesW : U l = (Gs : List Blk1) *
    (DegreeCor[l].AllL Blk1 RK.Elim Gs * ((u : Blk1) -> RK.Elim u -> MS.Mm Gs u)) ;
  presentation : Tr.Trunc[ReesW].carrier = DC.gen zero ;

  -- ker phi = the elimination ideal
  ker-of-elim (u : Blk1) (h : RK.Elim u) : RK.Ker (RK.elR u) = RK.ker-of-elim u h ;
  ker-elim (x : R.R) (k : RK.Ker x) : RK.Elim (RK.ub x) = RK.ker-elim x k (decR x) ;
  elim-of-ker (u : Blk1) (k : RK.Ker (RK.elR u)) : RK.Elim u = RK.elim-of-ker u k (decR (RK.elR u)) ;
  -- (cert) and (certU) for every element of the elimination ideal
  cert (u : Blk1) (h : RK.Elim u) : Tr.Trunc[RK.CertW u].carrier = RK.cert u h ;
  certU (u : Blk1) (w : RK.CertW u) (n : Nat) :
    Id XR.B.R (RK.RG.ev (GU.pr (cdeg n) (RK.elR u))) (RK.RSB.comb s (RK.Hc u w n) P) = RK.certU u w n ;
  -- (certX) and the components
  certX (u : Blk1) (w : RK.CertW u) (n : Nat) (d : Base.Nat) :
    Id XR.B.R (RK.RG.ev (RC.comp n d (RK.elR u))) (RK.RSB.comb s (RC.HX u w n d) P) = RC.certX u w n d ;
  comp-elim (u : Blk1) (h : RK.Elim u) (n : Nat) (d : Base.Nat) : RK.Elim (RK.ub (RC.comp n d (RK.elR u))) =
    RC.comp-elim u h n d ;

  -- the components of the generators generate ker phi
  module WithGens (w : ReesW) {
    Gs : List Blk1 = w.1 ;
    gens-elim : DegreeCor[l].AllL Blk1 RK.Elim Gs = w.2.1 ;
    span (u : Blk1) (h : RK.Elim u) : MS.Mm Gs u = w.2.2 u h ;
    module GC = RC.Generate[decB,decR,Gs,span] ;
    kernel-generated (x : R.R) (k : RK.Ker x) : GC.FC.InComb x = GC.generate (RK.ub x) (ker-elim x k) ;
  } ;
} ;

------------------------------------------------------------------------
-- the generators of J as term lists

-- a + b as integers
addP-pos (a : Base.Nat) : (b : Base.Nat) -> Id Int (addP (pos a) b) (pos (NA.plus a b)) = split {
  zero -> sym (ap (\ k -> pos k) (NA.plus-zero a)) ;
  suc b | r -> trans (ap sucZ r) (sym (ap (\ k -> pos k) (NA.plus-suc a b))) } ;

module TermLists (A : CRing) (setA : Pr.isSet A.R) {
  module XR = XRing[A,setA] ;
  module GXL = Laws[A,four,XR.B,XR.setB,XR.GX] ;
  -- X_0 is the variable of the innermost ring
  x0 : Ps.Fin four = inl (inl (inl (inr tt))) ;
  x1 : Ps.Fin four = inl (inl (inr tt)) ;
  x2 : Ps.Fin four = inl (inr tt) ;
  x3 : Ps.Fin four = inr tt ;
  pw (k : Ps.Fin four) : Base.Nat -> XR.B.R = split {
    zero -> XR.B.o ;
    suc n | r -> XR.B.mul r (XR.Xv k) } ;
  hom-pw (k : Ps.Fin four) : (n : Base.Nat) -> GXL.Hom (pos n) (pw k n) = split {
    zero -> GXL.hom-one ;
    suc n | r -> GXL.hom-mul (pos n) (pos (suc zero)) (pw k n) (XR.Xv k) r (XR.GX.var-hom k) } ;
  hom-times (m n : Base.Nat) (x y : XR.B.R) (hx : GXL.Hom (pos m) x) (hy : GXL.Hom (pos n) y) : GXL.Hom (pos (NA.plus m n)) (XR.B.mul x y) =
    subst (\ k -> GXL.Hom k (XR.B.mul x y)) (addP-pos m n) (GXL.hom-mul (pos m) (pos n) x y hx hy) ;
  -- X^u
  mono : PA4.N4 -> XR.B.R = split {
    nx u0 u1 u2 u3 -> XR.B.mul (XR.B.mul (XR.B.mul (pw x0 u0) (pw x1 u1)) (pw x2 u2)) (pw x3 u3) } ;
  hom-mono : (u : PA4.N4) -> GXL.Hom (pos (PA4.size u)) (mono u) = split {
    nx u0 u1 u2 u3 -> hom-times (NA.plus (NA.plus u0 u1) u2) u3 (XR.B.mul (XR.B.mul (pw x0 u0) (pw x1 u1)) (pw x2 u2)) (pw x3 u3)
      (hom-times (NA.plus u0 u1) u2 (XR.B.mul (pw x0 u0) (pw x1 u1)) (pw x2 u2)
        (hom-times u0 u1 (pw x0 u0) (pw x1 u1) (hom-pw x0 u0) (hom-pw x1 u1)) (hom-pw x2 u2))
      (hom-pw x3 u3) } ;
  -- sum of c X^u
  phiT : PA4.TPoly A.R -> XR.B.R = split {
    nil -> XR.B.z ;
    cons t p | r -> XR.B.add (XR.B.mul (XR.GX.iota.1 t.1) (mono t.2)) r } ;
  hom-phiT (dd : Base.Nat) : (p : PA4.TPoly A.R) -> HomogeneousMatrices4[l].HomDeg A.R dd p -> GXL.Hom (pos dd) (phiT p) = split {
    nil -> \ h -> GXL.hom-zero (pos dd) ;
    cons t p | r -> \ h -> GXL.hom-add (pos dd) (XR.B.mul (XR.GX.iota.1 t.1) (mono t.2)) (phiT p)
      (trans (GXL.pr-iota (pos dd) t.1 (mono t.2))
         (ap (XR.B.mul (XR.GX.iota.1 t.1)) (subst (\ k -> GXL.Hom (pos k) (mono t.2)) h.1 (hom-mono t.2))))
      (r h.2) } ;
} ;

-- the presentation for P_q given as term lists of degree e_q
module ConcreteT (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) (t : Nat) (a : Ps.Fin t -> A.R)
  (s : Nat) (p : Ps.Fin s -> PA4.TPoly A.R) (e : Ps.Fin s -> Base.Nat)
  (hp : (q : Ps.Fin s) -> HomogeneousMatrices4[l].HomDeg A.R (e q) (p q)) {
  module TL = TermLists[A,setA] ;
  P (q : Ps.Fin s) : TL.XR.B.R = TL.phiT (p q) ;
  hP (q : Ps.Fin s) : TL.GXL.Hom (pos (e q)) (P q) = TL.hom-phiT (e q) (p q) (hp q) ;
  module C = Concrete[K0,A,setA,cfnA,t,a,s,P,e,hP] ;
} ;
