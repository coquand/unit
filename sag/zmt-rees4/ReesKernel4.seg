-- ReesKernel4.seg: the kernel of the Rees map is the elimination ideal, with
-- explicit certificates (handoff §1 (a)-(c), Gate B and the U-degree part of
-- Gate C), for a graded ring R over B (ReesGenerators4).
--
-- The Rees map phi : R -> M[T], M = B/J, J = (P_1, .., P_s), U_j |-> b_j T,
-- has T^n coefficient [ev (pr n x)] (ReesGenerators4: Ev on R).  So
--     Ker x  :=  for every n, ev (pr n x) is in J               (ker phi)
-- (InJ y: merely y = sum_q H_q P_q).  The elimination ideal: an element u of
-- R (a block of T-degree 0) with emb u in N, the R[T]-span of P_q and
-- U_j - b_j T (Elim u, the N of DegreeCor at n = 1).
--
-- Certificates (cert).  XSpan's XS d g (g = sum_i c_i F_i + T g', g' in
-- XS (d-1)) gives explicit coefficients cs_k,i (k <= d) with
--     g = sum_{k <= d} T^k sum_i cs_k,i F_i                     (pcomb, cert-of)
-- i.e. g = sum_i c_i(T) F_i with c_i(T) = sum_k cs_k,i T^k: for g = emb u,
--     u = sum_q c_q(T) P_q + sum_j d_j(T) (U_j - b_j T).          (cert)
-- (certU).  Applying Ev m (ReesGenerators4: additive, Ev m (T y) =
-- Ev (m-1) y, Ev m (sum_i c_i F_i) = sum_q ev (pr m c_q) P_q):
--     Ev m (sum_k T^k cF cs_k) = sum_q H_mq P_q,
--     H_mq = sum_{k <= d} ev (pr (m - k) cs_k,q)                  (hh, ev-pcomb)
-- and Ev n (emb u) = ev (pr n u); hence ev (pr n u) = sum_q H_nq P_q
-- (certU), and Elim u gives Ker u (ker-of-elim).  No separate "the kernel
-- is graded" lemma is used.
--
-- Conversely (elim-of-hom): if x has U-degree n and ev x is in J, then x
-- is in N.  Let D_n(y) = y - T^n ev(y) (as constant sequences).  For y of
-- degree 0, y = ev(y) (base-eq), D_0(y) = 0.  For y of degree n+1,
-- y = sum_j U_j low_j y, so with y' = sum_j b_j low_j y (degree n,
-- ev y' = ev y by ev-low):
--     sum_j (low_j y)(U_j - b_j T) = y - T y'                  (rel-sum)
--     D_(n+1)(y) = (y - T y') + T D_n(y')                       (tele)
-- so D_n(y) is in N for every homogeneous y (dif-in).  Then
-- x = D_n(x) + T^n ev(x), and ev(x) = sum_q H_q P_q gives
-- ev(x) = sum_q H_q P_q in N (jgen-in: sum_q H_q pgen_q).
-- For an x with a finite decomposition (DegreeDecomposition4.Decomp)
-- Ker x gives Elim x, summing over the parts (ker-elim-dec).
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (B : CRing) (setB : Pr.isSet B.R) (t : Nat) (R : CRing) (setR : Pr.isSet R.R) (G : Graded[B,t,R])
  (b : Ps.Fin t -> B.R) (s : Nat) (P : Ps.Fin s -> B.R) {
  module RG = ReesGenerators4[l].Over[B,setB,t,R,setR,G,b,s,P] ;
  module GL = RG.GL ; module XN = RG.XN ; module SQ = RG.SQ ; module I = RG.I ;
  module RSB = RG.RSB ; module RSR = Comb[l].Sums[R,IP.regular R] ;
  module LQ = RG.LQ ; module CS = RG.CS ; module LR = RG.LR ;
  module DLR = IP.ModL[R,IP.regular R] ;
  module HSI = HomSum[B,R,G.iota] ;
  two : Nat = suc (suc zero) ;

  ------------------------------------------------------------------------
  -- explicit polynomial combinations sum_k T^k sum_i cs_k,i F_i

  Coef : U l = Ps.Fin RG.S -> R.R ;
  CSeq : U l = Nat -> Coef ;
  pcomb : (d : Nat) -> CSeq -> RG.Seq = split {
    zero -> \ cs -> XN.cF (cs zero) ;
    suc d | r -> \ cs -> RG.Sq.madd (XN.cF (cs zero)) (SQ.Xs (r (\ k -> cs (suc k)))) } ;
  Cert (d : Nat) (g : RG.Seq) : U l = (cs : CSeq) * Id RG.Seq g (pcomb d cs) ;
  consS (c : Coef) (cs : CSeq) : CSeq = split {
    zero -> c ;
    suc k -> cs k } ;
  -- the Ruitenburg form XS d g as an explicit combination
  cert-of : (d : Nat) (g : RG.Seq) -> XN.XS d g -> Cert d g = split {
    zero -> \ g h -> (consS h.1 (\ k -> XN.vz), sym h.2) ;
    suc d | r -> \ g h -> (consS h.1 (r h.2.1 h.2.2.1).1,
      trans h.2.2.2 (ap (\ y -> RG.Sq.madd (XN.cF h.1) (SQ.Xs y)) (r h.2.1 h.2.2.1).2)) } ;

  -- H m q = sum_{k <= d} ev (pr (m - k) cs_k,q)
  hh : (d : Nat) -> Int -> CSeq -> Ps.Fin s -> B.R = split {
    zero -> \ m cs q -> RG.ev (G.pr m (cs zero (I.jl s q))) ;
    suc d | r -> \ m cs q -> B.add (RG.ev (G.pr m (cs zero (I.jl s q)))) (r (predZ m) (\ k -> cs (suc k)) q) } ;
  ev-pcomb : (d : Nat) (m : Int) (cs : CSeq) -> Id B.R (RG.EvZ m (pcomb d cs)) (RSB.comb s (hh d m cs) P) = split {
    zero -> \ m cs -> RG.EvZ-cF m (cs zero) ;
    suc d | r -> \ m cs ->
      trans (RG.EvZ-add m (XN.cF (cs zero)) (SQ.Xs (pcomb d (\ k -> cs (suc k)))))
        (trans (IP.ModL[B,IP.regular B].G.cong-add (RG.EvZ-cF m (cs zero))
                  (trans (RG.EvZ-X m (pcomb d (\ k -> cs (suc k)))) (r (predZ m) (\ k -> cs (suc k)))))
          (sym (RSB.comb-add s (\ q -> RG.ev (G.pr m (cs zero (I.jl s q)))) (hh d (predZ m) (\ k -> cs (suc k))) P))) } ;

  ------------------------------------------------------------------------
  -- the kernel and the elimination ideal

  Blk1 : U l = SQ.Blk (suc zero) ;
  -- the element of R of a block of T-degree 0, and back
  elR (u : Blk1) : R.R = RG.val (u (inr tt)) ;
  ub (x : R.R) : Blk1 = \ i -> RG.one x ;
  -- membership in J
  JW (y : B.R) : U l = (H : Ps.Fin s -> B.R) * Id B.R y (RSB.comb s H P) ;
  InJ (y : B.R) : U l = Tr.Trunc[JW y].carrier ;
  -- the kernel of phi
  Ker (x : R.R) : U l = (n : Nat) -> InJ (RG.ev (G.pr (cdeg n) x)) ;
  -- the elimination ideal (J, U - bT) cap R
  Elim (u : Blk1) : U l = XN.NM (SQ.emb (suc zero) u) ;
  -- a certificate (cert) for u
  CertW (u : Blk1) : U l = (d : Nat) * Cert d (SQ.emb (suc zero) u) ;
  cert (u : Blk1) (h : Elim u) : Tr.Trunc[CertW u].carrier =
    XN.nm-rec (SQ.emb (suc zero) u) Tr.Trunc[CertW u].carrier Tr.Trunc[CertW u].proposition
      (\ w -> Tr.Trunc[CertW u].inc (w.1, cert-of w.1 (SQ.emb (suc zero) u) w.2)) h ;
  -- the certificate's coefficients of P_q in degree n
  Hc (u : Blk1) (w : CertW u) (n : Nat) (q : Ps.Fin s) : B.R = hh w.1 (cdeg n) w.2.1 q ;
  -- (certU): ev (pr n u) = sum_q H_nq P_q
  certU (u : Blk1) (w : CertW u) (n : Nat) : Id B.R (RG.ev (G.pr (cdeg n) (elR u))) (RSB.comb s (Hc u w n) P) =
    trans (sym (RG.EvZ-emb1 (cdeg n) u)) (trans (ap (RG.EvZ (cdeg n)) w.2.2) (ev-pcomb w.1 (cdeg n) w.2.1)) ;
  ker-of-elim (u : Blk1) (h : Elim u) : Ker (elR u) = \ n ->
    TC.map (CertW u) (JW (RG.ev (G.pr (cdeg n) (elR u)))) (\ w -> (Hc u w n, certU u w n)) (cert u h) ;

  ------------------------------------------------------------------------
  -- a homogeneous element with ev x in J is in N

  cst1 (x : R.R) : RG.Seq = SQ.emb (suc zero) (ub x) ;
  XpowB : Base.Nat -> RG.Seq -> RG.Seq = split {
    zero -> \ g -> g ;
    suc n | r -> \ g -> SQ.Xs (r g) } ;
  nm-XpowB : (n : Base.Nat) (g : RG.Seq) -> XN.NM g -> XN.NM (XpowB n g) = split {
    zero -> \ g h -> h ;
    suc n | r -> \ g h -> XN.nm-X (XpowB n g) (r g h) } ;
  -- y - T^n ev(y)
  Dif (n : Base.Nat) (y : R.R) : RG.Seq = LQ.msub (cst1 y) (XpowB n (cst1 (RG.iotaR (RG.ev y)))) ;

  -- equality of sequences entrywise
  at-top (v w : RG.M) (h : Id R.R (v (inr tt)) (w (inr tt))) : (u : Top) -> Id R.R (v (inr u)) (w (inr u)) = split {
    tt -> h } ;
  at1 (v w : RG.M) (h : Id R.R (v (inr tt)) (w (inr tt))) : (k : Ps.Fin (suc zero)) -> Id R.R (v k) (w k) = split {
    inl e -> absurd (Id R.R (v (inl e)) (w (inl e))) e ;
    inr u -> at-top v w h u } ;
  m-ext (v w : RG.M) (h : Id R.R (RG.val v) (RG.val w)) : Id RG.M v w = RG.F1.ext v w (at1 v w h) ;
  seq-ext (g h : RG.Seq) (e : (j : Nat) -> Id R.R (RG.val (g j)) (RG.val (h j))) : Id RG.Seq g h =
    SQ.sext g h (\ j -> m-ext (g j) (h j) (e j)) ;
  -- the entries of a finite sum of sequences
  val-sum : (n : Nat) (u : Ps.Fin n -> RG.Seq) (j : Nat) -> Id R.R (RG.val (CS.sum n u j)) (RSR.sum n (\ i -> RG.val (u i j))) = split {
    zero -> \ u j -> refl R.z ;
    suc n | r -> \ u j -> ap (R.add (RG.val (u (inr tt) j))) (r (\ i -> u (inl i)) j) } ;

  -- the generators are in N
  rel-in (j : Ps.Fin t) : XN.NM (SQ.emb two (RG.rgen j)) =
    subst (\ z -> XN.NM (SQ.emb two z)) (RG.gens-r j) (XN.nm-gen (I.jr s j)) ;
  pg-in (q : Ps.Fin s) : XN.NM (SQ.emb two (RG.pgen q)) =
    subst (\ z -> XN.NM (SQ.emb two z)) (RG.gens-l q) (XN.nm-gen (I.jl s q)) ;

  -- degree 0: iota (ev y) = y
  ev-deg0 (y : R.R) (h : GL.Hom zeroZ y) : Id R.R (RG.iotaR (RG.ev y)) y =
    trans (ap (\ z -> RG.iotaR (RG.ev z)) (sym (G.base-eq y h))) (trans (ap RG.iotaR (G.ev-iota b (G.base y))) (G.base-eq y h)) ;

  module Lower (n : Base.Nat) (y : R.R) (h : GL.Hom (pos (suc n)) y) {
    lw (j : Ps.Fin t) : R.R = G.low j y ;
    hlw (j : Ps.Fin t) : GL.Hom (pos n) (lw j) = G.low-hom n j y h ;
    -- y' = sum_j b_j low_j y
    y' : R.R = RSR.sum t (\ j -> R.mul (RG.iotaR (b j)) (lw j)) ;
    hy' : GL.Hom (pos n) y' =
      GL.hom-sum (pos n) t (\ j -> R.mul (RG.iotaR (b j)) (lw j))
        (\ j -> trans (GL.pr-iota (pos n) (b j) (lw j)) (ap (R.mul (RG.iotaR (b j))) (hlw j))) ;
    ev-y' : Id B.R (RG.ev y') (RG.ev y) =
      trans (RG.EV.HS.map-sum t (\ j -> R.mul (RG.iotaR (b j)) (lw j)))
        (trans (RSB.sum-cong t (\ j -> RG.ev (R.mul (RG.iotaR (b j)) (lw j))) (\ j -> B.mul (b j) (RG.ev (lw j)))
                  (\ j -> trans (RG.EV.ev.2.2.2 (RG.iotaR (b j)) (lw j)) (ap (\ w -> B.mul w (RG.ev (lw j))) (G.ev-iota b (b j)))))
          (sym (RG.EV.ev-low n y h))) ;

    -- sum_j (low_j y)(U_j - b_j T) = y - T y', entrywise
    rsum : RG.Seq = CS.sum t (\ j -> RG.Sq.sm (lw j) (SQ.emb two (RG.rgen j))) ;
    at0 : Id R.R (RSR.sum t (\ j -> R.mul (lw j) (G.var j))) (R.add y (R.neg R.z)) =
      trans (RSR.sum-cong t (\ j -> R.mul (lw j) (G.var j)) (\ j -> R.mul (G.var j) (lw j)) (\ j -> R.mulC (lw j) (G.var j)))
        (trans (sym (G.low-eq n y h)) (sym (trans (ap (R.add y) DLR.G.neg-zero) (R.addZ y)))) ;
    at1' : Id R.R (RSR.sum t (\ j -> R.mul (lw j) (R.neg (RG.iotaR (b j))))) (R.add R.z (R.neg y')) =
      trans (RSR.sum-cong t (\ j -> R.mul (lw j) (R.neg (RG.iotaR (b j)))) (\ j -> R.neg (R.mul (RG.iotaR (b j)) (lw j)))
               (\ j -> trans (LR.mul-neg (lw j) (RG.iotaR (b j))) (ap R.neg (R.mulC (lw j) (RG.iotaR (b j))))))
        (trans (RSR.sum-neg t (\ j -> R.mul (RG.iotaR (b j)) (lw j))) (sym (LR.zl (R.neg y')))) ;
    at2 (i : Nat) : Id R.R (RSR.sum t (\ j -> R.mul (lw j) (RG.val (SQ.emb two (RG.rgen j) (suc (suc i)))))) (R.add R.z (R.neg R.z)) =
      trans (trans (RSR.sum-cong t (\ j -> R.mul (lw j) (RG.val (SQ.emb two (RG.rgen j) (suc (suc i))))) (\ j -> R.z)
                      (\ j -> trans (ap (R.mul (lw j)) (RG.rg-tail2 j i)) (LR.mul-zero (lw j))))
                   (RSR.sum-zero t))
        (sym (trans (ap (R.add R.z) DLR.G.neg-zero) (R.addZ R.z))) ;
    rel-atS : (j : Nat) -> Id R.R (RG.val (rsum (suc j))) (RG.val (LQ.msub (cst1 y) (SQ.Xs (cst1 y')) (suc j))) = split {
      zero -> trans (val-sum t (\ j -> RG.Sq.sm (lw j) (SQ.emb two (RG.rgen j))) (suc zero)) at1' ;
      suc i -> trans (val-sum t (\ j -> RG.Sq.sm (lw j) (SQ.emb two (RG.rgen j))) (suc (suc i))) (at2 i) } ;
    rel-at : (j : Nat) -> Id R.R (RG.val (rsum j)) (RG.val (LQ.msub (cst1 y) (SQ.Xs (cst1 y')) j)) = split {
      zero -> trans (val-sum t (\ j -> RG.Sq.sm (lw j) (SQ.emb two (RG.rgen j))) zero) at0 ;
      suc j -> rel-atS j } ;
    rel-sum : Id RG.Seq rsum (LQ.msub (cst1 y) (SQ.Xs (cst1 y'))) = seq-ext rsum (LQ.msub (cst1 y) (SQ.Xs (cst1 y'))) rel-at ;
    rsum-in : XN.NM rsum =
      XN.nm-sum t (\ j -> RG.Sq.sm (lw j) (SQ.emb two (RG.rgen j))) (\ j -> XN.nm-sm (lw j) (SQ.emb two (RG.rgen j)) (rel-in j)) ;
  } ;

  -- (a - b) + (b - c) = a - c, and T (a - b) = T a - T b
  tele (x y w : RG.Seq) : Id RG.Seq (RG.Sq.madd (LQ.msub x y) (LQ.msub y w)) (LQ.msub x w) =
    trans (sym (RG.Sq.maddA x (RG.Sq.mneg y) (LQ.msub y w)))
      (ap (RG.Sq.madd x) (trans (RG.Sq.maddA (RG.Sq.mneg y) y (RG.Sq.mneg w))
        (trans (ap (\ z -> RG.Sq.madd z (RG.Sq.mneg w)) (trans (RG.Sq.maddC (RG.Sq.mneg y) y) (RG.Sq.maddN y))) (LQ.G.zl (RG.Sq.mneg w))))) ;
  xs-sub (x y : RG.Seq) : Id RG.Seq (SQ.Xs (LQ.msub x y)) (LQ.msub (SQ.Xs x) (SQ.Xs y)) =
    trans (SQ.xs-add' x (RG.Sq.mneg y)) (ap (RG.Sq.madd (SQ.Xs x)) (LQ.G.hom-neg SQ.Xs SQ.xs-add' y)) ;

  -- D_n(y) is in N for y of U-degree n
  dif-step (n : Base.Nat) (y : R.R) (h : GL.Hom (pos (suc n)) y) (ih : XN.NM (Dif n Lower[n,y,h].y')) : XN.NM (Dif (suc n) y) =
    XN.nm-cong (RG.Sq.madd Lower[n,y,h].rsum (SQ.Xs (Dif n Lower[n,y,h].y'))) (Dif (suc n) y)
      (trans (LQ.G.cong-add Lower[n,y,h].rel-sum
                (trans (xs-sub (cst1 Lower[n,y,h].y') (XpowB n (cst1 (RG.iotaR (RG.ev Lower[n,y,h].y')))))
                  (ap (\ z -> LQ.msub (SQ.Xs (cst1 Lower[n,y,h].y')) (SQ.Xs (XpowB n (cst1 (RG.iotaR z))))) Lower[n,y,h].ev-y')))
        (tele (cst1 y) (SQ.Xs (cst1 Lower[n,y,h].y')) (XpowB (suc n) (cst1 (RG.iotaR (RG.ev y))))))
      (XN.nm-add Lower[n,y,h].rsum (SQ.Xs (Dif n Lower[n,y,h].y')) Lower[n,y,h].rsum-in (XN.nm-X (Dif n Lower[n,y,h].y') ih)) ;
  dif-in : (n : Base.Nat) (y : R.R) -> GL.Hom (pos n) y -> XN.NM (Dif n y) = split {
    zero -> \ y h -> XN.nm-cong RG.Sq.mz (Dif zero y)
      (sym (trans (ap (\ z -> LQ.msub (cst1 y) (cst1 z)) (ev-deg0 y h)) (LQ.sub-self (cst1 y)))) XN.nm-zero ;
    suc n | r -> \ y h -> dif-step n y h (r (Lower[n,y,h].y') Lower[n,y,h].hy') } ;

  -- an element of J, as a constant sequence, is in N
  cst1-add-at (x y : R.R) : (j : Nat) -> Id R.R (RG.val (cst1 (R.add x y) j)) (RG.val (RG.Sq.madd (cst1 x) (cst1 y) j)) = split {
    zero -> refl (R.add x y) ;
    suc j -> sym (R.addZ R.z) } ;
  cst1-add (x y : R.R) : Id RG.Seq (cst1 (R.add x y)) (RG.Sq.madd (cst1 x) (cst1 y)) =
    seq-ext (cst1 (R.add x y)) (RG.Sq.madd (cst1 x) (cst1 y)) (cst1-add-at x y) ;
  cst1-zero-at : (j : Nat) -> Id R.R (RG.val (cst1 R.z j)) (RG.val (RG.Sq.mz j)) = split {
    zero -> refl R.z ;
    suc j -> refl R.z } ;
  cst1-zero : Id RG.Seq (cst1 R.z) RG.Sq.mz = seq-ext (cst1 R.z) RG.Sq.mz cst1-zero-at ;
  cst1-sum : (n : Nat) (f : Ps.Fin n -> R.R) -> Id RG.Seq (cst1 (RSR.sum n f)) (CS.sum n (\ i -> cst1 (f i))) = split {
    zero -> \ f -> cst1-zero ;
    suc n | r -> \ f -> trans (cst1-add (f (inr tt)) (RSR.sum n (\ i -> f (inl i))))
                         (ap (RG.Sq.madd (cst1 (f (inr tt)))) (r (\ i -> f (inl i)))) } ;
  cst1-pg-at (c : R.R) (q : Ps.Fin s) : (j : Nat) ->
    Id R.R (RG.val (cst1 (R.mul c (RG.iotaR (P q))) j)) (RG.val (RG.Sq.sm c (SQ.emb two (RG.pgen q)) j)) = split {
    zero -> refl (R.mul c (RG.iotaR (P q))) ;
    suc j -> sym (trans (ap (R.mul c) (RG.pg-tail q j)) (LR.mul-zero c)) } ;
  jgen-in (H : Ps.Fin s -> B.R) : XN.NM (cst1 (RG.iotaR (RSB.comb s H P))) =
    XN.nm-cong (CS.sum s (\ q -> RG.Sq.sm (RG.iotaR (H q)) (SQ.emb two (RG.pgen q)))) (cst1 (RG.iotaR (RSB.comb s H P)))
      (sym (trans (ap cst1 (HSI.map-sum s (\ q -> B.mul (H q) (P q))))
             (trans (ap cst1 (RSR.sum-cong s (\ q -> RG.iotaR (B.mul (H q) (P q))) (\ q -> R.mul (RG.iotaR (H q)) (RG.iotaR (P q)))
                                (\ q -> G.iota.2.2.2 (H q) (P q))))
               (trans (cst1-sum s (\ q -> R.mul (RG.iotaR (H q)) (RG.iotaR (P q))))
                 (CS.sum-cong s (\ q -> cst1 (R.mul (RG.iotaR (H q)) (RG.iotaR (P q)))) (\ q -> RG.Sq.sm (RG.iotaR (H q)) (SQ.emb two (RG.pgen q)))
                    (\ q -> seq-ext _ _ (cst1-pg-at (RG.iotaR (H q)) q)))))))
      (XN.nm-sum s (\ q -> RG.Sq.sm (RG.iotaR (H q)) (SQ.emb two (RG.pgen q))) (\ q -> XN.nm-sm (RG.iotaR (H q)) (SQ.emb two (RG.pgen q)) (pg-in q))) ;
  inj-in (y : B.R) (h : InJ y) : XN.NM (cst1 (RG.iotaR y)) =
    Tr.Trunc[JW y].induction @l (\ w -> XN.NM (cst1 (RG.iotaR y))) (\ w -> XN.nm-prop (cst1 (RG.iotaR y)))
      (\ w -> XN.nm-cong (cst1 (RG.iotaR (RSB.comb s w.1 P))) (cst1 (RG.iotaR y)) (ap (\ z -> cst1 (RG.iotaR z)) (sym w.2)) (jgen-in w.1)) h ;

  -- x = D_n(x) + T^n ev(x)
  undif (n : Base.Nat) (x : R.R) : Id RG.Seq (RG.Sq.madd (Dif n x) (XpowB n (cst1 (RG.iotaR (RG.ev x))))) (cst1 x) =
    trans (sym (RG.Sq.maddA (cst1 x) (RG.Sq.mneg (XpowB n (cst1 (RG.iotaR (RG.ev x))))) (XpowB n (cst1 (RG.iotaR (RG.ev x))))))
      (trans (ap (RG.Sq.madd (cst1 x)) (trans (RG.Sq.maddC (RG.Sq.mneg (XpowB n (cst1 (RG.iotaR (RG.ev x))))) (XpowB n (cst1 (RG.iotaR (RG.ev x)))))
                                        (RG.Sq.maddN (XpowB n (cst1 (RG.iotaR (RG.ev x)))))))
        (RG.Sq.maddZ (cst1 x))) ;
  -- (bihomogeneous case of ker phi in N): x of U-degree n with ev x in J is in N
  elim-of-hom (n : Base.Nat) (x : R.R) (hx : GL.Hom (pos n) x) (hj : InJ (RG.ev x)) : Elim (ub x) =
    XN.nm-cong (RG.Sq.madd (Dif n x) (XpowB n (cst1 (RG.iotaR (RG.ev x))))) (cst1 x) (undif n x)
      (XN.nm-add (Dif n x) (XpowB n (cst1 (RG.iotaR (RG.ev x)))) (dif-in n x hx)
        (nm-XpowB n (cst1 (RG.iotaR (RG.ev x))) (inj-in (RG.ev x) hj))) ;

  ------------------------------------------------------------------------
  -- ker phi in N, for an element with a finite decomposition

  module DD = DegreeDecomposition4[l].Over[B,t,R,setR,G] ;
  elim-sumTo : (m : Nat) (f : Nat -> R.R) -> ((d : Nat) -> Elim (ub (f d))) -> Elim (ub (DD.DS.sumTo m f)) = split {
    zero -> \ f h -> XN.nm-cong RG.Sq.mz (cst1 R.z) (sym cst1-zero) XN.nm-zero ;
    suc m | r -> \ f h -> XN.nm-cong (RG.Sq.madd (cst1 (f m)) (cst1 (DD.DS.sumTo m f))) (cst1 (DD.DS.sumTo (suc m) f))
      (sym (cst1-add (f m) (DD.DS.sumTo m f))) (XN.nm-add (cst1 (f m)) (cst1 (DD.DS.sumTo m f)) (h m) (r f h)) } ;
  ker-elim-dec (x : R.R) (k : Ker x) (m : Nat) (dx : DD.Decomp m x) : Elim (ub x) =
    XN.nm-cong (cst1 (DD.DS.sumTo m (DD.part x))) (cst1 x) (ap cst1 (sym dx.1))
      (elim-sumTo m (DD.part x) (\ d -> elim-of-hom (toB d) (G.pr (cdeg d) x) (GL.hom-pr (cdeg d) x) (k d))) ;
  ker-elim (x : R.R) (k : Ker x) (fx : DD.FinDeg x) : Elim (ub x) =
    Tr.Trunc[DD.FinDegW x].induction @l (\ w -> Elim (ub x)) (\ w -> XN.nm-prop (cst1 x)) (\ w -> ker-elim-dec x k w.1 w.2) fx ;

  -- a block of T-degree 0 is its element of R: ub (elR u) = u
  blk-top (u : Blk1) : (i : Top) -> Id RG.M (RG.one (elR u)) (u (inr i)) = split {
    tt -> m-ext (RG.one (elR u)) (u (inr tt)) (refl (elR u)) } ;
  blk-at (u : Blk1) : (i : Ps.Fin (suc zero)) -> Id RG.M (ub (elR u) i) (u i) = split {
    inl e -> absurd (Id RG.M (ub (elR u) (inl e)) (u (inl e))) e ;
    inr i -> blk-top u i } ;
  ub-elR (u : Blk1) : Id Blk1 (ub (elR u)) u = Blocks[l].Pow[R,RG.Md,suc zero].ext (ub (elR u)) u (blk-at u) ;
  -- ker phi in N, for blocks
  elim-of-ker (u : Blk1) (k : Ker (elR u)) (fx : DD.FinDeg (elR u)) : Elim u =
    subst Elim (ub-elR u) (ker-elim (elR u) k fx) ;
} ;
