-- ReesComponents4.seg: bihomogeneous components of kernel elements, their
-- certificates with X-degrees, and generation (handoff §1 (c), Gate C).
--
-- Data: B graded over A by X-degree (GX : Graded A r B; later
-- B = A[X_0..X_3], r = 4), R graded over B by U-degree (as in
-- ReesKernel4), P_q of X-degree e_q (hP; the ASSUMPTION of the handoff)
-- and b_j of X-degree 0 (hb).
--
-- (certX).  From (certU) ev (pr n u) = sum_q H_nq P_q (ReesKernel4), taking
-- X-degree d parts, since P_q has X-degree e_q (pr-mul):
--     prX d (ev (pr n u)) = sum_q prX (d - e_q) (H_nq) . P_q        (prX-comb)
-- with H'_nq = prX (d - e_q) H_nq of X-degree d - e_q (hom-HX), and
-- H'_nq = 0 when d < e_q (d - e_q is then negative: HX-below).
--
-- Components.  The U-degree n part pr n x has the canonical expression of
-- zmt-weighted4 (Laws.expr: x = sum over words w of U^w h_w, h_w in B).
-- The bihomogeneous component of bidegree (n, d) is
--     comp n d x = the value of the expression with every h_w replaced by
--                  prX d h_w                                    (comp)
-- canonical, no choice.  It has U-degree n (value-hom) and is BiHom n d: the
-- value of an expression all of whose coefficients have X-degree d.
--   ev (comp n d x) = prX d (ev (pr n x))                          (ev-comp)
-- by induction on n: ev (sum_j U_j y_j) = sum_j b_j ev y_j (ev-comb) and
-- prX d (b_j y) = b_j prX d y (b_j of X-degree 0).
-- So, for u in the elimination ideal with certificate w (ReesKernel4.cert),
--     ev (comp n d u) = sum_q H'_nq P_q                           (certX)
-- and comp n d u is in the elimination ideal (comp-elim, by
-- ReesKernel4.elim-of-hom) and in ker phi (comp-ker).
--
-- Generation.  If every element of B and of R merely has a finite
-- decomposition (DegreeDecomposition4: true for the towers), then
--   x = sum_{n < B_u} pr n x                     (U-degrees)
--   pr n x = sum_{d < B_x} comp n d x           (part-comps: a common X-bound
--     for the finitely many coefficients of the expression, all-fin,
--     fin-bound; value-decomp)
-- so every generator g_l is a finite R-combination of its components
-- (Generate.gen-in), and so is every element of the R-span of the g_l
-- (Generate.generate).  FinComb: "a finite R-combination of the family
-- c : Ix -> R" (CombW: k, indices, coefficients, equation), closed under 0,
-- +, R-multiples and finite sums (joining two index lists: ReesJoin).
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module NA = NatArith[l] ; module PA4 = PolynomialAction4[l] ;

------------------------------------------------------------------------
-- finite R-combinations of a family

module ReesFinComb (R : CRing) (Ix : U l) (c : Ix -> R.R) {
  module RS = Comb[l].Sums[R,IP.regular R] ; module DL = IP.ModL[R,IP.regular R] ;
  module DS = DegreeDecomposition4[l].DegSums[R,IP.regular R] ;
  CombW (y : R.R) : U l = (k : Nat) * ((ix : Ps.Fin k -> Ix) * ((cf : Ps.Fin k -> R.R) * Id R.R y (RS.comb k cf (\ i -> c (ix i))))) ;
  InComb (y : R.R) : U l = Tr.Trunc[CombW y].carrier ;
  in-prop (y : R.R) : Pr.isProp (InComb y) = Tr.Trunc[CombW y].proposition ;
  in-cong (y y' : R.R) (e : Id R.R y y') (h : InComb y) : InComb y' = subst InComb e h ;

  in-zero : InComb R.z = Tr.Trunc[CombW R.z].inc (zero, (\ i -> absurd Ix i, (\ i -> absurd R.R i, refl R.z))) ;
  in-gen (i : Ix) : InComb (c i) = Tr.Trunc[CombW (c i)].inc (suc zero, (\ k -> i, (\ k -> R.o,
    sym (trans (R.addZ (R.mul R.o (c i))) (RL[R].one-left (c i)))))) ;

  -- two combinations joined
  module AddW (y y' : R.R) (w : CombW y) (w' : CombW y') {
    k : Nat = w.1 ;
    k' : Nat = w'.1 ;
    module JI = ReesGenerators4[l].ReesJoin[Ix,k'] ; module JC = ReesGenerators4[l].ReesJoin[R.R,k'] ;
    module LI = ReesGenerators4[l].ReesJoinLaws[Ix,k'] ; module LC = ReesGenerators4[l].ReesJoinLaws[R.R,k'] ;
    module IX = ReesGenerators4[l].ReesIndex[k'] ;
    ix (i : Ps.Fin (plus k k')) : Ix = JI.join k w.2.1 w'.2.1 i ;
    cf (i : Ps.Fin (plus k k')) : R.R = JC.join k w.2.2.1 w'.2.2.1 i ;
    term (i : Ps.Fin (plus k k')) : R.R = R.mul (cf i) (c (ix i)) ;
    left (q : Ps.Fin k) : Id R.R (term (IX.jl k q)) (R.mul (w.2.2.1 q) (c (w.2.1 q))) =
      trans (ap (\ z -> R.mul z (c (ix (IX.jl k q)))) (LC.join-l k w.2.2.1 w'.2.2.1 q))
            (ap (\ z -> R.mul (w.2.2.1 q) (c z)) (LI.join-l k w.2.1 w'.2.1 q)) ;
    right (j : Ps.Fin k') : Id R.R (term (IX.jr k j)) (R.mul (w'.2.2.1 j) (c (w'.2.1 j))) =
      trans (ap (\ z -> R.mul z (c (ix (IX.jr k j)))) (LC.join-r k w.2.2.1 w'.2.2.1 j))
            (ap (\ z -> R.mul (w'.2.2.1 j) (c z)) (LI.join-r k w.2.1 w'.2.1 j)) ;
    eq : Id R.R (R.add y y') (RS.comb (plus k k') cf (\ i -> c (ix i))) =
      sym (trans (ReesGenerators4[l].ReesSumJoin[R,IP.regular R,k'].sum-join k term)
            (DL.G.cong-add (trans (RS.sum-cong k (\ q -> term (IX.jl k q)) (\ q -> R.mul (w.2.2.1 q) (c (w.2.1 q))) left) (sym w.2.2.2))
                           (trans (RS.sum-cong k' (\ j -> term (IX.jr k j)) (\ j -> R.mul (w'.2.2.1 j) (c (w'.2.1 j))) right) (sym w'.2.2.2)))) ;
    res : CombW (R.add y y') = (plus k k', (ix, (cf, eq))) ;
  } ;
  add-w (y y' : R.R) (w : CombW y) (w' : CombW y') : CombW (R.add y y') = AddW[y,y',w,w'].res ;
  in-add (y y' : R.R) (h : InComb y) (h' : InComb y') : InComb (R.add y y') =
    TC.map2 (CombW y) (CombW y') (CombW (R.add y y')) (add-w y y') h h' ;
  sm-w (a y : R.R) (w : CombW y) : CombW (R.mul a y) =
    (w.1, (w.2.1, (\ i -> R.mul a (w.2.2.1 i),
      trans (ap (R.mul a) w.2.2.2) (sym (RS.comb-sm w.1 a w.2.2.1 (\ i -> c (w.2.1 i))))))) ;
  in-sm (a y : R.R) (h : InComb y) : InComb (R.mul a y) = TC.map (CombW y) (CombW (R.mul a y)) (sm-w a y) h ;
  in-sum : (k : Nat) (ys : Ps.Fin k -> R.R) -> ((i : Ps.Fin k) -> InComb (ys i)) -> InComb (RS.sum k ys) = split {
    zero -> \ ys h -> in-zero ;
    suc k | r -> \ ys h -> in-add (ys (inr tt)) (RS.sum k (\ i -> ys (inl i))) (h (inr tt)) (r (\ i -> ys (inl i)) (\ i -> h (inl i))) } ;
  in-comb (k : Nat) (cf : Ps.Fin k -> R.R) (ys : Ps.Fin k -> R.R) (h : (i : Ps.Fin k) -> InComb (ys i)) : InComb (RS.comb k cf ys) =
    in-sum k (\ i -> R.mul (cf i) (ys i)) (\ i -> in-sm (cf i) (ys i) (h i)) ;
  in-sumTo : (m : Nat) (f : Nat -> R.R) -> ((d : Nat) -> InComb (f d)) -> InComb (DS.sumTo m f) = split {
    zero -> \ f h -> in-zero ;
    suc m | r -> \ f h -> in-add (f m) (DS.sumTo m f) (h m) (r f h) } ;
} ;

-- a common bound for finitely many monotone bounded properties
module ReesFinBound (Q0 : U l) {
  module Sat = Saturation[l] ;
  Bounded (Q : Nat -> U l) : U l = Tr.Trunc[(Bx : Nat) * Q Bx].carrier ;
  fin-bound : (k : Nat) (Q : Ps.Fin k -> Nat -> U l) -> ((j : Ps.Fin k) (Bx m : Nat) -> Q j Bx -> Q j (plus m Bx)) ->
    ((j : Ps.Fin k) -> Bounded (Q j)) -> Bounded (\ Bx -> (j : Ps.Fin k) -> Q j Bx) = split {
    zero -> \ Q mono h -> Tr.Trunc[(Bx : Nat) * ((j : Ps.Fin zero) -> Q j Bx)].inc (zero, \ j -> absurd (Q j zero) j) ;
    suc k | r -> \ Q mono h ->
      TC.map2 ((Bx : Nat) * ((j : Ps.Fin k) -> Q (inl j) Bx)) ((Bx : Nat) * Q (inr tt) Bx)
        ((Bx : Nat) * ((j : Ps.Fin (suc k)) -> Q j Bx))
        (\ w1 w2 -> (plus w2.1 w1.1, Sat.allS k (\ j -> Q j (plus w2.1 w1.1))
            (\ j -> mono (inl j) w1.1 w2.1 (w1.2 j))
            (subst (\ z -> Q (inr tt) z) (plus-comm w1.1 w2.1) (mono (inr tt) w2.1 w1.1 w2.2))))
        (r (\ j -> Q (inl j)) (\ j -> mono (inl j)) (\ j -> h (inl j))) (h (inr tt)) } ;
} ;

------------------------------------------------------------------------
-- components and their certificates

module Over (A : CRing) (r : Nat) (B : CRing) (setB : Pr.isSet B.R) (GX : Graded[A,r,B])
  (t : Nat) (R : CRing) (setR : Pr.isSet R.R) (G : Graded[B,t,R])
  (b : Ps.Fin t -> B.R) (s : Nat) (P : Ps.Fin s -> B.R)
  (e : Ps.Fin s -> Base.Nat) (hP : (q : Ps.Fin s) -> Id B.R (GX.pr (pos (e q)) (P q)) (P q))
  (hb : (j : Ps.Fin t) -> Id B.R (GX.pr zeroZ (b j)) (b j)) {
  module RK = ReesKernel4[l].Over[B,setB,t,R,setR,G,b,s,P] ;
  module RG = RK.RG ; module GL = RK.GL ;
  module GXL = Laws[A,r,B,setB,GX] ;
  module DX = DegreeDecomposition4[l].Over[A,r,B,setB,GX] ;
  module DU = RK.DD ;
  module RSB = RK.RSB ; module RSR = RK.RSR ;

  -- (certX), the algebra: prX d (sum_q H_q P_q) = sum_q prX (d - e_q) (H_q) P_q
  prX-comb (d : Int) (H : Ps.Fin s -> B.R) :
    Id B.R (GX.pr d (RSB.comb s H P)) (RSB.comb s (\ q -> GX.pr (subZ d (pos (e q))) (H q)) P) =
    trans (GXL.pr-sum d s (\ q -> B.mul (H q) (P q)))
      (RSB.sum-cong s (\ q -> GX.pr d (B.mul (H q) (P q))) (\ q -> B.mul (GX.pr (subZ d (pos (e q))) (H q)) (P q))
         (\ q -> GX.pr-mul d (pos (e q)) (H q) (P q) (hP q))) ;
  -- d - (m + 1 + d) = -(m + 1)
  minus-plus (x : Int) (d : Base.Nat) : (m : Base.Nat) -> Id Int (PA4.minus x (NA.plus m d)) (PA4.minus (PA4.minus x d) m) = split {
    zero -> refl (PA4.minus x d) ;
    suc m | rr -> ap predZ rr } ;
  below (d m : Base.Nat) : Id Int (subZ (pos d) (pos (NA.plus (suc m) d))) (negsuc m) =
    trans (sub-pos (pos d) (NA.plus (suc m) d))
      (trans (minus-plus (pos d) d (suc m))
        (trans (ap (\ z -> PA4.minus z (suc m)) (FinitePolynomial4[l].minus-self d)) (minus-zero-suc m))) ;

  ------------------------------------------------------------------------
  -- expressions with every coefficient changed

  mapE : (k : Base.Nat) -> (B.R -> B.R) -> GL.Expr k -> GL.Expr k = split {
    zero -> \ f a -> f a ;
    suc k | rr -> \ f ex j -> rr f (ex j) } ;
  AllE : (k : Base.Nat) -> (B.R -> U l) -> GL.Expr k -> U l = split {
    zero -> \ Q a -> Q a ;
    suc k | rr -> \ Q ex -> (j : Ps.Fin t) -> rr Q (ex j) } ;
  all-pr : (k : Base.Nat) (d : Int) (ex : GL.Expr k) -> AllE k (GXL.Hom d) (mapE k (GX.pr d) ex) = split {
    zero -> \ d a -> GXL.hom-pr d a ;
    suc k | rr -> \ d ex j -> rr d (ex j) } ;
  -- ev (value (prX d e)) = prX d (ev (value e))
  ev-value-map : (k : Base.Nat) (d : Int) (ex : GL.Expr k) ->
    Id B.R (RG.ev (GL.value k (mapE k (GX.pr d) ex))) (GX.pr d (RG.ev (GL.value k ex))) = split {
    zero -> \ d a -> trans (G.ev-iota b (GX.pr d a)) (ap (GX.pr d) (sym (G.ev-iota b a))) ;
    suc k | rr -> \ d ex -> calc B.R {
      RG.ev (GL.value (suc k) (mapE (suc k) (GX.pr d) ex))
        =< RK.RG.EV.ev-comb (\ j -> GL.value k (mapE k (GX.pr d) (ex j)))
        > RSB.sum t (\ j -> B.mul (b j) (RG.ev (GL.value k (mapE k (GX.pr d) (ex j)))))
        =< RSB.sum-cong t (\ j -> B.mul (b j) (RG.ev (GL.value k (mapE k (GX.pr d) (ex j)))))
             (\ j -> GX.pr d (B.mul (b j) (RG.ev (GL.value k (ex j)))))
             (\ j -> trans (ap (B.mul (b j)) (rr d (ex j))) (sym (GXL.pr-mul-left d zeroZ (b j) (RG.ev (GL.value k (ex j))) (hb j))))
        > RSB.sum t (\ j -> GX.pr d (B.mul (b j) (RG.ev (GL.value k (ex j)))))
        =< sym (GXL.pr-sum d t (\ j -> B.mul (b j) (RG.ev (GL.value k (ex j)))))
        > GX.pr d (RSB.sum t (\ j -> B.mul (b j) (RG.ev (GL.value k (ex j)))))
        =< ap (GX.pr d) (sym (RK.RG.EV.ev-comb (\ j -> GL.value k (ex j))))
        > GX.pr d (RG.ev (GL.value (suc k) ex)) } } ;

  ------------------------------------------------------------------------
  -- the bihomogeneous components

  exprOf (n : Nat) (x : R.R) : GL.Expr (toB n) = GL.expr (toB n) (G.pr (cdeg n) x) (GL.hom-pr (cdeg n) x) ;
  comp (n : Nat) (d : Base.Nat) (x : R.R) : R.R = GL.value (toB n) (mapE (toB n) (GX.pr (pos d)) (exprOf n x)) ;
  -- y = sum_w U^w h_w with |w| = n and every h_w of X-degree d
  BiHom (n : Nat) (d : Base.Nat) (y : R.R) : U l =
    (ex : GL.Expr (toB n)) * (AllE (toB n) (GXL.Hom (pos d)) ex * Id R.R (GL.value (toB n) ex) y) ;
  comp-bihom (n : Nat) (d : Base.Nat) (x : R.R) : BiHom n d (comp n d x) =
    (mapE (toB n) (GX.pr (pos d)) (exprOf n x), (all-pr (toB n) (pos d) (exprOf n x), refl (comp n d x))) ;
  comp-homU (n : Nat) (d : Base.Nat) (x : R.R) : GL.Hom (cdeg n) (comp n d x) =
    GL.value-hom (toB n) (mapE (toB n) (GX.pr (pos d)) (exprOf n x)) ;
  ev-comp (n : Nat) (d : Base.Nat) (x : R.R) : Id B.R (RG.ev (comp n d x)) (GX.pr (pos d) (RG.ev (G.pr (cdeg n) x))) =
    trans (ev-value-map (toB n) (pos d) (exprOf n x))
      (ap (\ z -> GX.pr (pos d) (RG.ev z)) (GL.expr-value (toB n) (G.pr (cdeg n) x) (GL.hom-pr (cdeg n) x))) ;

  -- (certX): the coefficients H' of the components, of X-degree d - e_q
  HX (u : RK.Blk1) (w : RK.CertW u) (n : Nat) (d : Base.Nat) (q : Ps.Fin s) : B.R =
    GX.pr (subZ (pos d) (pos (e q))) (RK.Hc u w n q) ;
  hom-HX (u : RK.Blk1) (w : RK.CertW u) (n : Nat) (d : Base.Nat) (q : Ps.Fin s) :
    GXL.Hom (subZ (pos d) (pos (e q))) (HX u w n d q) = GXL.hom-pr (subZ (pos d) (pos (e q))) (RK.Hc u w n q) ;
  HX-below (u : RK.Blk1) (w : RK.CertW u) (n : Nat) (d m : Base.Nat) (q : Ps.Fin s)
    (h : Id Base.Nat (e q) (NA.plus (suc m) d)) : Id B.R (HX u w n d q) B.z =
    trans (ap (\ k -> GX.pr k (RK.Hc u w n q)) (trans (ap (\ z -> subZ (pos d) (pos z)) h) (below d m)))
      (GX.pr-negdeg m (RK.Hc u w n q)) ;
  certX (u : RK.Blk1) (w : RK.CertW u) (n : Nat) (d : Base.Nat) :
    Id B.R (RG.ev (comp n d (RK.elR u))) (RSB.comb s (HX u w n d) P) =
    trans (ev-comp n d (RK.elR u)) (trans (ap (GX.pr (pos d)) (RK.certU u w n)) (prX-comb (pos d) (RK.Hc u w n))) ;
  -- the components lie in the elimination ideal and in ker phi
  comp-elim (u : RK.Blk1) (h : RK.Elim u) (n : Nat) (d : Base.Nat) : RK.Elim (RK.ub (comp n d (RK.elR u))) =
    RK.elim-of-hom (toB n) (comp n d (RK.elR u)) (comp-homU n d (RK.elR u))
      (TC.map (RK.CertW u) (RK.JW (RG.ev (comp n d (RK.elR u)))) (\ w -> (HX u w n d, certX u w n d)) (RK.cert u h)) ;
  comp-ker (u : RK.Blk1) (h : RK.Elim u) (n : Nat) (d : Base.Nat) : RK.Ker (comp n d (RK.elR u)) =
    RK.ker-of-elim (RK.ub (comp n d (RK.elR u))) (comp-elim u h n d) ;

  ------------------------------------------------------------------------
  -- an element is the finite sum of its components

  module DSR = DegreeDecomposition4[l].DegSumsRing[R] ;
  module MIB = DegreeDecomposition4[l].DegSumsRing[B].Map[R,G.iota] ;
  -- sum_j sum_{d < m} f j d = sum_{d < m} sum_j f j d
  sum-sumTo (k : Nat) : (m : Nat) (f : Ps.Fin k -> Nat -> R.R) ->
    Id R.R (RSR.sum k (\ j -> DU.DS.sumTo m (f j))) (DU.DS.sumTo m (\ d -> RSR.sum k (\ j -> f j d))) = split {
    zero -> \ f -> RSR.sum-zero k ;
    suc m | rr -> \ f -> trans (RSR.sum-add k (\ j -> f j m) (\ j -> DU.DS.sumTo m (f j)))
                         (ap (R.add (RSR.sum k (\ j -> f j m))) (rr f)) } ;
  value-decomp : (k : Base.Nat) (ex : GL.Expr k) (Bx : Nat) -> AllE k (DX.Decomp Bx) ex ->
    Id R.R (GL.value k ex) (DU.DS.sumTo Bx (\ d -> GL.value k (mapE k (GX.pr (cdeg d)) ex))) = split {
    zero -> \ a Bx h -> trans (ap G.iota.1 h.1) (MIB.map-sumTo Bx (DX.part a)) ;
    suc k | rr -> \ ex Bx h -> calc R.R {
      GL.value (suc k) ex
        =< RSR.sum-cong t (\ j -> R.mul (G.var j) (GL.value k (ex j)))
             (\ j -> DU.DS.sumTo Bx (\ d -> R.mul (G.var j) (GL.value k (mapE k (GX.pr (cdeg d)) (ex j)))))
             (\ j -> trans (ap (R.mul (G.var j)) (rr (ex j) Bx (h j)))
                       (DSR.mul-sumTo (G.var j) Bx (\ d -> GL.value k (mapE k (GX.pr (cdeg d)) (ex j)))))
        > RSR.sum t (\ j -> DU.DS.sumTo Bx (\ d -> R.mul (G.var j) (GL.value k (mapE k (GX.pr (cdeg d)) (ex j)))))
        =< sum-sumTo t Bx (\ j d -> R.mul (G.var j) (GL.value k (mapE k (GX.pr (cdeg d)) (ex j))))
        > DU.DS.sumTo Bx (\ d -> GL.value (suc k) (mapE (suc k) (GX.pr (cdeg d)) ex)) } } ;
  all-pad : (k : Base.Nat) (ex : GL.Expr k) (Bx m : Nat) -> AllE k (DX.Decomp Bx) ex -> AllE k (DX.Decomp (plus m Bx)) ex = split {
    zero -> \ a Bx m h -> DX.pad m Bx a h ;
    suc k | rr -> \ ex Bx m h j -> rr (ex j) Bx m (h j) } ;
  module FB = ReesFinBound[Top] ;
  -- a common X-bound for the coefficients of an expression
  all-fin (decB : (y : B.R) -> DX.FinDeg y) : (k : Base.Nat) (ex : GL.Expr k) -> FB.Bounded (\ Bx -> AllE k (DX.Decomp Bx) ex) = split {
    zero -> \ a -> decB a ;
    suc k | rr -> \ ex -> FB.fin-bound t (\ j Bx -> AllE k (DX.Decomp Bx) (ex j)) (\ j Bx m h -> all-pad k (ex j) Bx m h) (\ j -> rr (ex j)) } ;
  -- pr n x = sum_{d < Bx} comp n d x, merely
  PartW (n : Nat) (x : R.R) : U l = (Bx : Nat) * Id R.R (G.pr (cdeg n) x) (DU.DS.sumTo Bx (\ d -> comp n (toB d) x)) ;
  part-comps (decB : (y : B.R) -> DX.FinDeg y) (n : Nat) (x : R.R) : Tr.Trunc[PartW n x].carrier =
    TC.map ((Bx : Nat) * AllE (toB n) (DX.Decomp Bx) (exprOf n x)) (PartW n x)
      (\ w -> (w.1, trans (sym (GL.expr-value (toB n) (G.pr (cdeg n) x) (GL.hom-pr (cdeg n) x)))
                      (value-decomp (toB n) (exprOf n x) w.1 w.2)))
      (all-fin decB (toB n) (exprOf n x)) ;

  ------------------------------------------------------------------------
  -- the components of generators of the elimination ideal generate it

  module Generate (decB : (y : B.R) -> DX.FinDeg y) (decR : (x : R.R) -> DU.FinDeg x)
    (Gs : List RK.Blk1) (span : (u : RK.Blk1) -> RK.Elim u -> Spans[l].Over[R,RK.SQ.blk (suc zero)].Mm Gs u) {
    module LG = Comb[l].Lists[R,RK.SQ.blk (suc zero)] ;
    module MS = Spans[l].Over[R,RK.SQ.blk (suc zero)] ;
    module VB = Comb[l].Sums[R,RK.SQ.blk (suc zero)] ;
    L : Nat = len Gs ;
    gl (k : Ps.Fin L) : R.R = RK.elR (LG.elem Gs k) ;
    -- the index set of the components: (generator, U-degree, X-degree)
    Ix : U l = (k : Ps.Fin L) * (Nat * Base.Nat) ;
    cp (i : Ix) : R.R = comp i.2.1 i.2.2 (gl i.1) ;
    module FC = ReesFinComb[R,Ix,cp] ;
    part-in (k : Ps.Fin L) (n : Nat) : FC.InComb (G.pr (cdeg n) (gl k)) =
      Tr.Trunc[PartW n (gl k)].induction @l (\ w -> FC.InComb (G.pr (cdeg n) (gl k))) (\ w -> FC.in-prop (G.pr (cdeg n) (gl k)))
        (\ w -> FC.in-cong (DU.DS.sumTo w.1 (\ d -> comp n (toB d) (gl k))) (G.pr (cdeg n) (gl k)) (sym w.2)
                  (FC.in-sumTo w.1 (\ d -> comp n (toB d) (gl k)) (\ d -> FC.in-gen (k, (n, toB d)))))
        (part-comps decB n (gl k)) ;
    -- every generator is a finite combination of its components
    gen-in (k : Ps.Fin L) : FC.InComb (gl k) =
      Tr.Trunc[DU.FinDegW (gl k)].induction @l (\ w -> FC.InComb (gl k)) (\ w -> FC.in-prop (gl k))
        (\ w -> FC.in-cong (DU.DS.sumTo w.1 (DU.part (gl k))) (gl k) (sym w.2.1)
                  (FC.in-sumTo w.1 (DU.part (gl k)) (part-in k)))
        (decR (gl k)) ;
    elR-comb : (k : Nat) (cf : Ps.Fin k -> R.R) (us : Ps.Fin k -> RK.Blk1) ->
      Id R.R (RK.elR (VB.comb k cf us)) (RSR.comb k cf (\ i -> RK.elR (us i))) = split {
      zero -> \ cf us -> refl R.z ;
      suc k | rr -> \ cf us -> ap (R.add (R.mul (cf (inr tt)) (RK.elR (us (inr tt))))) (rr (\ i -> cf (inl i)) (\ i -> us (inl i))) } ;
    -- every element of the elimination ideal is a finite R-combination of components
    generate (u : RK.Blk1) (h : RK.Elim u) : FC.InComb (RK.elR u) =
      MS.mm-rec Gs u (FC.InComb (RK.elR u)) (FC.in-prop (RK.elR u))
        (\ i -> FC.in-cong (RSR.comb L (LG.in-fam Gs u i).1 gl) (RK.elR u)
                  (trans (sym (elR-comb L (LG.in-fam Gs u i).1 (LG.elem Gs))) (ap RK.elR (LG.in-fam Gs u i).2))
                  (FC.in-comb L (LG.in-fam Gs u i).1 gl gen-in))
        (span u h) ;
  } ;
} ;
