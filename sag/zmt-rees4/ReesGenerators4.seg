-- ReesGenerators4.seg: the generators of the Rees kernel problem and the
-- coefficients of the substitution U |-> aT (handoff §1, Gate A, the generic
-- part).
--
-- Data.  B a commutative set-ring (later B = A[X_0..X_3]), R a commutative
-- set-ring graded over B with t variables U_1..U_t (Graded B t R, the
-- notion of sag/zmt-weighted4; later R = B[U_1..U_t]), b_1..b_t in B (the
-- values a_j) and P_1..P_s in B (the generators of J).  M = R^1 (the free
-- module of rank one, Comb.Free) is the module of DegreeCor; R[T] is the
-- module of sequences Nat -> M (SeqPoly).
--
-- Generators (gens, on the index set Fin (s + t): first the s generators
-- of J, then the t relations; ReesJoin):
--   pgen q = P_q              (the block (P_q, 0) of T-degree <= 1)
--   rgen j = U_j - b_j T      (the block (U_j, -b_j))
-- N is the R[T]-span of these (XSpan.NM, the N of DegreeCor at n = 1).
--
-- The coefficients of g(bT).  Substituting U = bT in a polynomial
-- g = sum_k g_k T^k of R[T] gives a polynomial of B[T]; its coefficient of
-- T^m is
--     Ev m g = sum_{k <= m} ev (pr (m - k) g_k)                         (Ev)
-- (pr = the U-degree part, ev = the evaluation U |-> b): the U-degree
-- (m - k) part of g_k becomes b^w T^(m - k).  By recursion on m:
--     Ev 0 g = ev (pr 0 g_0),  Ev (m+1) g = ev (pr (m+1) g_0) + Ev m (tail g),
-- and Ev m = 0 for a negative m (EvZ, on Int).  For g in R (T-degree 0),
-- Ev m g = ev (pr m g): the T^m coefficient of g(bT, X) is ev_b (pr_m g).
-- Laws (all by the recursion and the laws of pr and ev):
--   Ev m is additive, Ev m 0 = 0, Ev m of a finite sum is the sum (EvZ-add,
--   EvZ-zero, EvZ-sum); Ev m (T g) = Ev (m-1) g (EvZ-X);
--   Ev m (c P_q) = ev (pr m c) P_q                                (EvZ-pg)
--     since c P_q = P_q c with P_q of U-degree 0 (pr-iota);
--   Ev m (c (U_j - b_j T)) = ev (pr (m-1) c) b_j - b_j ev (pr (m-1) c) = 0
--                                                                 (EvZ-rg)
--     since pr m (c U_j) = pr (m-1) (c) U_j (pr-mul, U_j of degree 1) and
--     pr (m-1) (c (-b_j)) = pr (m-1) (c) (-b_j) (-b_j of degree 0);
--   hence for an R-combination sum_i c_i F_i of the generators
--     Ev m (sum_i c_i F_i) = sum_q ev (pr m c_q) P_q                (EvZ-cF)
--   (the relations contribute 0: this is phi(U_j - a_j T) = 0).
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;

------------------------------------------------------------------------
-- the index set Fin (s + t): the first s and the last t indices

module ReesJoin (X : U l) (t : Nat) {
  joinS (s : Nat) (r : (Ps.Fin s -> X) -> (Ps.Fin t -> X) -> Ps.Fin (plus s t) -> X)
    (G1 : Ps.Fin (suc s) -> X) (G2 : Ps.Fin t -> X) : Ps.Fin (suc (plus s t)) -> X = split {
    inl i -> r (\ q -> G1 (inl q)) G2 i ;
    inr u -> G1 (inr u) } ;
  join : (s : Nat) -> (Ps.Fin s -> X) -> (Ps.Fin t -> X) -> Ps.Fin (plus s t) -> X = split {
    zero -> \ G1 G2 -> G2 ;
    suc s | r -> joinS s r } ;
} ;

module ReesIndex (t : Nat) {
  jlS (s : Nat) (r : Ps.Fin s -> Ps.Fin (plus s t)) : Ps.Fin (suc s) -> Ps.Fin (suc (plus s t)) = split {
    inl q -> inl (r q) ;
    inr u -> inr u } ;
  -- the index of the q-th generator of J
  jl : (s : Nat) -> Ps.Fin s -> Ps.Fin (plus s t) = split {
    zero -> \ q -> absurd (Ps.Fin t) q ;
    suc s | r -> jlS s r } ;
  -- the index of the j-th relation
  jr : (s : Nat) -> Ps.Fin t -> Ps.Fin (plus s t) = split {
    zero -> \ j -> j ;
    suc s | r -> \ j -> inl (r j) } ;
} ;

module ReesJoinLaws (X : U l) (t : Nat) {
  module J = ReesJoin[X,t] ; module I = ReesIndex[t] ;
  join-lS (s : Nat) (r : (G1 : Ps.Fin s -> X) (G2 : Ps.Fin t -> X) (q : Ps.Fin s) -> Id X (J.join s G1 G2 (I.jl s q)) (G1 q))
    (G1 : Ps.Fin (suc s) -> X) (G2 : Ps.Fin t -> X) : (q : Ps.Fin (suc s)) -> Id X (J.join (suc s) G1 G2 (I.jl (suc s) q)) (G1 q) = split {
    inl q -> r (\ q' -> G1 (inl q')) G2 q ;
    inr u -> refl (G1 (inr u)) } ;
  join-l : (s : Nat) (G1 : Ps.Fin s -> X) (G2 : Ps.Fin t -> X) (q : Ps.Fin s) -> Id X (J.join s G1 G2 (I.jl s q)) (G1 q) = split {
    zero -> \ G1 G2 q -> absurd (Id X (J.join zero G1 G2 (I.jl zero q)) (G1 q)) q ;
    suc s | r -> join-lS s r } ;
  join-r : (s : Nat) (G1 : Ps.Fin s -> X) (G2 : Ps.Fin t -> X) (j : Ps.Fin t) -> Id X (J.join s G1 G2 (I.jr s j)) (G2 j) = split {
    zero -> \ G1 G2 j -> refl (G2 j) ;
    suc s | r -> \ G1 G2 j -> r (\ q -> G1 (inl q)) G2 j } ;
} ;

-- a sum over Fin (s + t) is the sum over the first s plus the sum over the last t
module ReesSumJoin (A : CRing) (Md : IP.Mod[A]) (t : Nat) {
  open Md ; module S = Comb[l].Sums[A,Md] ; module ML = IP.ModL[A,Md] ; module I = ReesIndex[t] ;
  sum-join : (s : Nat) (u : Ps.Fin (plus s t) -> M) ->
    Id M (S.sum (plus s t) u) (madd (S.sum s (\ q -> u (I.jl s q))) (S.sum t (\ j -> u (I.jr s j)))) = split {
    zero -> \ u -> sym (ML.G.zl (S.sum t u)) ;
    suc s | r -> \ u ->
      trans (ap (madd (u (inr tt))) (r (\ i -> u (inl i))))
        (maddA (u (inr tt)) (S.sum s (\ q -> u (inl (I.jl s q)))) (S.sum t (\ j -> u (inl (I.jr s j))))) } ;
} ;

------------------------------------------------------------------------
-- the generators and the coefficients of g(bT)

module Over (B : CRing) (setB : Pr.isSet B.R) (t : Nat) (R : CRing) (setR : Pr.isSet R.R) (G : Graded[B,t,R])
  (b : Ps.Fin t -> B.R) (s : Nat) (P : Ps.Fin s -> B.R) {
  module GL = Laws[B,t,R,setR,G] ;
  module LB = RL[B] ; module LR = RL[R] ;
  module RSB = Comb[l].Sums[B,IP.regular B] ;
  module EV = CoefficientEvaluation4[l].Over[B,setB,t,R,setR,G,b] ;
  module I = ReesIndex[t] ;

  -- M = R^1, the module of DegreeCor
  module F1 = Comb[l].Free[R,suc zero] ;
  Md : IP.Mod[R] = F1.mod ;
  M : U l = F1.Vec ;
  one (x : R.R) : M = \ i -> x ;
  val (v : M) : R.R = v (inr tt) ;
  module SQ = SeqPoly[l].Over[R,Md] ;
  Seq : U l = SQ.Seq ;
  Sq : IP.Mod[R] = SQ.seq ;
  module CS = Comb[l].Sums[R,Sq] ; module LQ = IP.ModL[R,Sq] ;
  Blk2 : U l = SQ.Blk (suc (suc zero)) ;

  -- the block c0 + c1 T
  top1 (c1 : M) : Ps.Fin (suc zero) -> M = split {
    inl e -> absurd M e ;
    inr u -> c1 } ;
  lin (c0 c1 : M) : Blk2 = split {
    inl i -> top1 c1 i ;
    inr u -> c0 } ;

  ev (x : R.R) : B.R = EV.ev.1 x ;
  iotaR (x : B.R) : R.R = G.iota.1 x ;

  -- the generators: P_q and U_j - b_j T
  pgen (q : Ps.Fin s) : Blk2 = lin (one (iotaR (P q))) Md.mz ;
  rgen (j : Ps.Fin t) : Blk2 = lin (one (G.var j)) (one (R.neg (iotaR (b j)))) ;
  S : Nat = plus s t ;
  gens : Ps.Fin S -> Blk2 = ReesJoin[Blk2,t].join s pgen rgen ;
  F (i : Ps.Fin S) : Seq = SQ.emb (suc (suc zero)) (gens i) ;
  module XN = XSpan[l].Over[R,Md,S,F] ;
  module JL = ReesJoinLaws[Blk2,t] ;
  gens-l (q : Ps.Fin s) : Id Blk2 (gens (I.jl s q)) (pgen q) = JL.join-l s pgen rgen q ;
  gens-r (j : Ps.Fin t) : Id Blk2 (gens (I.jr s j)) (rgen j) = JL.join-r s pgen rgen j ;

  ------------------------------------------------------------------------
  -- the coefficient of T^m of g(bT)

  -- the U-degree k part of an entry, evaluated
  e (k : Int) (x : M) : B.R = ev (G.pr k (val x)) ;
  tl (g : Seq) : Seq = \ j -> g (suc j) ;
  evB : Base.Nat -> Seq -> B.R = split {
    zero -> \ g -> e (pos zero) (g zero) ;
    suc n | r -> \ g -> B.add (e (pos (suc n)) (g zero)) (r (tl g)) } ;
  EvZ : Int -> Seq -> B.R = split {
    pos n -> evB n ;
    negsuc n -> \ g -> B.z } ;
  -- by definition
  evZ-pos (n : Base.Nat) (g : Seq) : Id B.R (EvZ (pos n) g) (evB n g) = refl (evB n g) ;

  -- e is additive, vanishes on 0 and in negative degree
  e-add (k : Int) (x y : M) : Id B.R (e k (Md.madd x y)) (B.add (e k x) (e k y)) =
    trans (ap ev (G.pr-add k (val x) (val y))) (EV.ev.2.2.1 (G.pr k (val x)) (G.pr k (val y))) ;
  e-van (k : Int) (x : M) (h : Id R.R (val x) R.z) : Id B.R (e k x) B.z =
    trans (ap (\ y -> ev (G.pr k y)) h) (trans (ap ev (GL.pr-zero k)) EV.ev-zero) ;
  e-neg (n : Base.Nat) (x : M) : Id B.R (e (negsuc n) x) B.z =
    trans (ap ev (G.pr-negdeg n (val x))) EV.ev-zero ;

  -- a sequence with every entry 0
  Zero (g : Seq) : U l = (j : Nat) -> Id R.R (val (g j)) R.z ;
  evB-van : (n : Base.Nat) (g : Seq) -> Zero g -> Id B.R (evB n g) B.z = split {
    zero -> \ g h -> e-van (pos zero) (g zero) (h zero) ;
    suc n | r -> \ g h -> trans (ap (\ w -> B.add w (evB n (tl g))) (e-van (pos (suc n)) (g zero) (h zero)))
                        (trans (LB.zl (evB n (tl g))) (r (tl g) (\ j -> h (suc j)))) } ;
  EvZ-van : (k : Int) (g : Seq) -> Zero g -> Id B.R (EvZ k g) B.z = split {
    pos n -> evB-van n ;
    negsuc n -> \ g h -> refl B.z } ;
  EvZ-zero (k : Int) : Id B.R (EvZ k Sq.mz) B.z = EvZ-van k Sq.mz (\ j -> refl R.z) ;

  -- a sequence vanishing from 1 on: Ev k g = e k (g 0)
  evB-const : (n : Base.Nat) (g : Seq) -> Zero (tl g) -> Id B.R (evB n g) (e (pos n) (g zero)) = split {
    zero -> \ g h -> refl (e (pos zero) (g zero)) ;
    suc n -> \ g h -> trans (ap (B.add (e (pos (suc n)) (g zero))) (evB-van n (tl g) h)) (B.addZ (e (pos (suc n)) (g zero))) } ;
  EvZ-const : (k : Int) (g : Seq) -> Zero (tl g) -> Id B.R (EvZ k g) (e k (g zero)) = split {
    pos n -> evB-const n ;
    negsuc n -> \ g h -> sym (e-neg n (g zero)) } ;
  -- the elements of R: Ev k (emb 1 u) = ev (pr k u)
  EvZ-emb1 (k : Int) (u : SQ.Blk (suc zero)) : Id B.R (EvZ k (SQ.emb (suc zero) u)) (e k (u (inr tt))) =
    EvZ-const k (SQ.emb (suc zero) u) (\ j -> refl R.z) ;

  -- additivity
  evB-add : (n : Base.Nat) (g h : Seq) -> Id B.R (evB n (Sq.madd g h)) (B.add (evB n g) (evB n h)) = split {
    zero -> \ g h -> e-add (pos zero) (g zero) (h zero) ;
    suc n | r -> \ g h -> trans (IP.ModL[B,IP.regular B].G.cong-add (e-add (pos (suc n)) (g zero) (h zero)) (r (tl g) (tl h)))
                          (LB.swap (e (pos (suc n)) (g zero)) (e (pos (suc n)) (h zero)) (evB n (tl g)) (evB n (tl h))) } ;
  EvZ-add : (k : Int) (g h : Seq) -> Id B.R (EvZ k (Sq.madd g h)) (B.add (EvZ k g) (EvZ k h)) = split {
    pos n -> evB-add n ;
    negsuc n -> \ g h -> sym (B.addZ B.z) } ;
  EvZ-sum (k : Int) : (n : Nat) (u : Ps.Fin n -> Seq) -> Id B.R (EvZ k (CS.sum n u)) (RSB.sum n (\ i -> EvZ k (u i))) = split {
    zero -> \ u -> EvZ-zero k ;
    suc n | r -> \ u -> trans (EvZ-add k (u (inr tt)) (CS.sum n (\ i -> u (inl i))))
                          (ap (B.add (EvZ k (u (inr tt)))) (r (\ i -> u (inl i)))) } ;

  -- Ev k (T g) = Ev (k - 1) g
  EvZ-Xpos : (n : Base.Nat) (g : Seq) -> Id B.R (EvZ (pos n) (SQ.Xs g)) (EvZ (predZ (pos n)) g) = split {
    zero -> \ g -> e-van (pos zero) Md.mz (refl R.z) ;
    suc n -> \ g -> trans (ap (\ w -> B.add w (evB n g)) (e-van (pos (suc n)) Md.mz (refl R.z))) (LB.zl (evB n g)) } ;
  EvZ-X : (k : Int) (g : Seq) -> Id B.R (EvZ k (SQ.Xs g)) (EvZ (predZ k) g) = split {
    pos n -> EvZ-Xpos n ;
    negsuc n -> \ g -> refl B.z } ;

  ------------------------------------------------------------------------
  -- the generators under Ev

  -- the tail of c P_q is 0
  pg-tail (q : Ps.Fin s) : (j : Nat) -> Id R.R (val (SQ.emb (suc (suc zero)) (pgen q) (suc j))) R.z = split {
    zero -> refl R.z ;
    suc j -> refl R.z } ;
  -- e k (c P_q) = ev (pr k c) P_q
  e-pg (k : Int) (c : R.R) (q : Ps.Fin s) : Id B.R (e k (Md.sm c (one (iotaR (P q))))) (B.mul (ev (G.pr k c)) (P q)) = calc B.R {
    ev (G.pr k (R.mul c (iotaR (P q))))
      =< ap (\ y -> ev (G.pr k y)) (R.mulC c (iotaR (P q))) > ev (G.pr k (R.mul (iotaR (P q)) c))
      =< ap ev (GL.pr-iota k (P q) c) > ev (R.mul (iotaR (P q)) (G.pr k c))
      =< EV.ev.2.2.2 (iotaR (P q)) (G.pr k c) > B.mul (ev (iotaR (P q))) (ev (G.pr k c))
      =< ap (\ w -> B.mul w (ev (G.pr k c))) (G.ev-iota b (P q)) > B.mul (P q) (ev (G.pr k c))
      =< B.mulC (P q) (ev (G.pr k c)) > B.mul (ev (G.pr k c)) (P q) } ;
  EvZ-pg (k : Int) (c : R.R) (q : Ps.Fin s) :
    Id B.R (EvZ k (Sq.sm c (SQ.emb (suc (suc zero)) (pgen q)))) (B.mul (ev (G.pr k c)) (P q)) =
    trans (EvZ-const k (Sq.sm c (SQ.emb (suc (suc zero)) (pgen q)))
             (\ j -> trans (ap (R.mul c) (pg-tail q j)) (LR.mul-zero c)))
          (e-pg k c q) ;

  -- c (U_j - b_j T)
  rg-tail2 (j : Ps.Fin t) : (i : Nat) -> Id R.R (val (SQ.emb (suc (suc zero)) (rgen j) (suc (suc i)))) R.z = split {
    zero -> refl R.z ;
    suc i -> refl R.z } ;
  -- -b_j has U-degree 0
  hom-nb (j : Ps.Fin t) : GL.Hom zeroZ (R.neg (iotaR (b j))) =
    trans (GL.pr-neg zeroZ (iotaR (b j))) (ap R.neg (GL.hom-iota (b j))) ;
  -- pr 0 (c U_j) = pr (-1) (c) U_j = 0
  e-rg0 (c : R.R) (j : Ps.Fin t) : Id B.R (e (pos zero) (Md.sm c (one (G.var j)))) B.z = calc B.R {
    ev (G.pr (pos zero) (R.mul c (G.var j)))
      =< ap ev (G.pr-mul (pos zero) (pos (suc zero)) c (G.var j) (G.var-hom j)) > ev (R.mul (G.pr (negsuc zero) c) (G.var j))
      =< ap (\ y -> ev (R.mul y (G.var j))) (G.pr-negdeg zero c) > ev (R.mul R.z (G.var j))
      =< ap ev (LR.zero-mul (G.var j)) > ev R.z
      =< EV.ev-zero > B.z } ;
  -- ev (pr (n+1) (c U_j)) + ev (pr n (c (-b_j))) = ev (pr n c) (b_j + (-b_j)) = 0
  e-rgS (n : Base.Nat) (c : R.R) (j : Ps.Fin t) :
    Id B.R (B.add (e (pos (suc n)) (Md.sm c (one (G.var j)))) (e (pos n) (Md.sm c (one (R.neg (iotaR (b j))))))) B.z = calc B.R {
    B.add (ev (G.pr (pos (suc n)) (R.mul c (G.var j)))) (ev (G.pr (pos n) (R.mul c (R.neg (iotaR (b j))))))
      =< IP.ModL[B,IP.regular B].G.cong-add
           (ap ev (G.pr-mul (pos (suc n)) (pos (suc zero)) c (G.var j) (G.var-hom j)))
           (ap ev (G.pr-mul (pos n) zeroZ c (R.neg (iotaR (b j))) (hom-nb j)))
      > B.add (ev (R.mul (G.pr (pos n) c) (G.var j))) (ev (R.mul (G.pr (pos n) c) (R.neg (iotaR (b j)))))
      =< IP.ModL[B,IP.regular B].G.cong-add (EV.ev.2.2.2 (G.pr (pos n) c) (G.var j)) (EV.ev.2.2.2 (G.pr (pos n) c) (R.neg (iotaR (b j))))
      > B.add (B.mul (ev (G.pr (pos n) c)) (ev (G.var j))) (B.mul (ev (G.pr (pos n) c)) (ev (R.neg (iotaR (b j)))))
      =< sym (B.dist (ev (G.pr (pos n) c)) (ev (G.var j)) (ev (R.neg (iotaR (b j)))))
      > B.mul (ev (G.pr (pos n) c)) (B.add (ev (G.var j)) (ev (R.neg (iotaR (b j)))))
      =< ap (B.mul (ev (G.pr (pos n) c)))
           (trans (IP.ModL[B,IP.regular B].G.cong-add (G.ev-var b j)
                     (trans (RH.negation R B EV.ev (iotaR (b j))) (ap B.neg (G.ev-iota b (b j)))))
                  (B.addN (b j)))
      > B.mul (ev (G.pr (pos n) c)) B.z
      =< LB.mul-zero (ev (G.pr (pos n) c)) > B.z } ;
  rg-zz (c : R.R) (j : Ps.Fin t) : Zero (tl (tl (Sq.sm c (SQ.emb (suc (suc zero)) (rgen j))))) =
    \ i -> trans (ap (R.mul c) (rg-tail2 j i)) (LR.mul-zero c) ;
  EvZ-rgpos (c : R.R) (j : Ps.Fin t) : (n : Base.Nat) -> Id B.R (EvZ (pos n) (Sq.sm c (SQ.emb (suc (suc zero)) (rgen j)))) B.z = split {
    zero -> e-rg0 c j ;
    suc n -> trans (ap (B.add (e (pos (suc n)) (Md.sm c (one (G.var j)))))
                     (evB-const n (tl (Sq.sm c (SQ.emb (suc (suc zero)) (rgen j)))) (rg-zz c j)))
                   (e-rgS n c j) } ;
  EvZ-rgZ (c : R.R) (j : Ps.Fin t) : (k : Int) -> Id B.R (EvZ k (Sq.sm c (SQ.emb (suc (suc zero)) (rgen j)))) B.z = split {
    pos n -> EvZ-rgpos c j n ;
    negsuc n -> refl B.z } ;
  -- Ev k (c (U_j - b_j T)) = 0
  EvZ-rg (k : Int) (c : R.R) (j : Ps.Fin t) : Id B.R (EvZ k (Sq.sm c (SQ.emb (suc (suc zero)) (rgen j)))) B.z = EvZ-rgZ c j k ;

  -- Ev k (sum_i c_i F_i) = sum_q ev (pr k c_q) P_q
  module SJ = ReesSumJoin[B,IP.regular B,t] ;
  EvZ-cF (k : Int) (c : Ps.Fin S -> R.R) :
    Id B.R (EvZ k (XN.cF c)) (RSB.comb s (\ q -> ev (G.pr k (c (I.jl s q)))) P) =
    trans (EvZ-sum k S (\ i -> Sq.sm (c i) (F i)))
      (trans (SJ.sum-join s (\ i -> EvZ k (Sq.sm (c i) (F i))))
        (trans (IP.ModL[B,IP.regular B].G.cong-add
                  (RSB.sum-cong s (\ q -> EvZ k (Sq.sm (c (I.jl s q)) (F (I.jl s q)))) (\ q -> B.mul (ev (G.pr k (c (I.jl s q)))) (P q))
                     (\ q -> trans (ap (\ z -> EvZ k (Sq.sm (c (I.jl s q)) (SQ.emb (suc (suc zero)) z))) (gens-l q)) (EvZ-pg k (c (I.jl s q)) q)))
                  (trans (RSB.sum-cong t (\ j -> EvZ k (Sq.sm (c (I.jr s j)) (F (I.jr s j)))) (\ j -> B.z)
                            (\ j -> trans (ap (\ z -> EvZ k (Sq.sm (c (I.jr s j)) (SQ.emb (suc (suc zero)) z))) (gens-r j)) (EvZ-rg k (c (I.jr s j)) j)))
                         (RSB.sum-zero t)))
               (B.addZ (RSB.comb s (\ q -> ev (G.pr k (c (I.jl s q)))) P)))) ;
} ;
