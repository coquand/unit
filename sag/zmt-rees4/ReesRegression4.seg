-- ReesRegression4.seg: checked instances (handoff §2, Gate D).
--
-- J = (X_0^3), given as the term list [1 X_0^3] of degree 3 (cubicT).
-- Over a CFN ring A (OverCFN[K0,A,setA,cfnA]):
--   1. t = 0 (T0): R = B, no relations.  X_0^3 has U-degree 0 and is in J,
--      so it is in the elimination ideal and in ker phi (elim0, ker0); the
--      presentation exists (presentation0).
--   2. t = 1, a single value a_1 (T1[a1]): x = U_1 X_0^3, of U-degree 1 with
--      ev x = a_1 X_0^3 in J (ev-x), is in the elimination ideal and in
--      ker phi (elim-x, ker-x); for every certificate w of x: the X-degree 3
--      certificate (certX at (1,3)), its coefficients of X-degree 3 - 3 = 0
--      (hom13), and the X-degree 2 coefficients vanish (below12: 2 < 3);
--      x is merely a finite R-combination of the components of the GenAt
--      generators (generated-x).
-- Over Z (OverZ, ZCFN), t = 2, a = (2, 3):
--   3. x = 3 U_1 - 2 U_2 has U-degree 1 and ev x = 3.2 - 2.3 = 0 (ev-x, by
--      the ring-map laws and computation in Z): it is in the elimination
--      ideal and in ker phi (elim-x, ker-x), and merely a finite combination
--      of components (generated-x); the instances of 1 and 2 over Z (CZ).
-- The generators produced by GenAt are not predicted; only certified
-- properties are checked.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module PA4 = PolynomialAction4[l] ;
module CRt = CubicResolution4[l] ; module RP = ReesPresentation4[l] ;

threeB : Base.Nat = suc (suc (suc zero)) ;
twoB : Base.Nat = suc (suc zero) ;
oneN : Nat = suc zero ;
-- X_0^3
cubicT (A : CRing) : PA4.TPoly A.R = cons (A.o, nx threeB zero zero zero) nil ;
cubic-hom (A : CRing) : HomogeneousMatrices4[l].HomDeg A.R threeB (cubicT A) = (refl threeB, tt) ;

module OverCFN (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) {
  module DX = XSpan[l].Delta[RP.XRing[A,setA].B,IP.regular RP.XRing[A,setA].B] ;

  ------------------------------------------------------------------------
  -- 1. t = 0
  module T0 = RP.ConcreteT[K0,A,setA,cfnA,zero,\ j -> absurd A.R j,oneN,\ q -> cubicT A,\ q -> threeB,\ q -> cubic-hom A] ;
  module C0 = T0.C ;
  P0 : C0.XR.B.R = T0.P (inr tt) ;
  x0 : C0.R.R = C0.GU.iota.1 P0 ;
  inJ0 : C0.RK.InJ (C0.RK.RG.ev x0) =
    Tr.Trunc[C0.RK.JW (C0.RK.RG.ev x0)].inc (DX.delta oneN (inr tt),
      trans (C0.GU.ev-iota C0.b P0) (sym (DX.comb-delta oneN T0.P (inr tt)))) ;
  elim0 : C0.RK.Elim (C0.RK.ub x0) = C0.RK.elim-of-hom zero x0 (C0.RK.GL.hom-iota P0) inJ0 ;
  ker0 : C0.RK.Ker x0 = C0.ker-of-elim (C0.RK.ub x0) elim0 ;
  presentation0 : Tr.Trunc[C0.ReesW].carrier = C0.presentation ;

  ------------------------------------------------------------------------
  -- 2. t = 1, J = (X_0^3)
  module T1 (a1 : A.R) {
    module T = RP.ConcreteT[K0,A,setA,cfnA,oneN,\ j -> a1,oneN,\ q -> cubicT A,\ q -> threeB,\ q -> cubic-hom A] ;
    module C = T.C ;
    P : C.XR.B.R = T.P (inr tt) ;
    U1 : C.R.R = C.GU.var (inr tt) ;
    x : C.R.R = C.R.mul U1 (C.GU.iota.1 P) ;
    hom-x : C.RK.GL.Hom (pos (suc zero)) x =
      trans (C.GU.pr-mul (pos (suc zero)) zeroZ U1 (C.GU.iota.1 P) (C.RK.GL.hom-iota P))
        (ap (\ y -> C.R.mul y (C.GU.iota.1 P)) (C.GU.var-hom (inr tt))) ;
    -- ev x = a_1 X_0^3
    ev-x : Id C.XR.B.R (C.RK.RG.ev x) (C.XR.B.mul (C.b (inr tt)) P) =
      trans (C.RK.RG.EV.ev.2.2.2 U1 (C.GU.iota.1 P))
        (trans (ap (\ y -> C.XR.B.mul y (C.RK.RG.ev (C.GU.iota.1 P))) (C.GU.ev-var C.b (inr tt)))
          (ap (C.XR.B.mul (C.b (inr tt))) (C.GU.ev-iota C.b P))) ;
    inJ-x : C.RK.InJ (C.RK.RG.ev x) =
      Tr.Trunc[C.RK.JW (C.RK.RG.ev x)].inc (\ q -> C.b (inr tt), trans ev-x (sym (C.XR.B.addZ (C.XR.B.mul (C.b (inr tt)) P)))) ;
    elim-x : C.RK.Elim (C.RK.ub x) = C.RK.elim-of-hom (suc zero) x hom-x inJ-x ;
    ker-x : C.RK.Ker x = C.ker-of-elim (C.RK.ub x) elim-x ;
    -- the component certificates of x, for any certificate w
    module Cert (w : C.RK.CertW (C.RK.ub x)) {
      cert13 : Id C.XR.B.R (C.RK.RG.ev (C.RC.comp oneN threeB x)) (C.RK.RSB.comb oneN (C.RC.HX (C.RK.ub x) w oneN threeB) T.P) =
        C.certX (C.RK.ub x) w oneN threeB ;
      hom13 (q : Ps.Fin oneN) : C.RC.GXL.Hom zeroZ (C.RC.HX (C.RK.ub x) w oneN threeB q) =
        C.RC.hom-HX (C.RK.ub x) w oneN threeB q ;
      below12 (q : Ps.Fin oneN) : Id C.XR.B.R (C.RC.HX (C.RK.ub x) w oneN twoB q) C.XR.B.z =
        C.RC.HX-below (C.RK.ub x) w oneN twoB zero q (refl threeB) ;
      comp13-elim : C.RK.Elim (C.RK.ub (C.RC.comp oneN threeB x)) = C.comp-elim (C.RK.ub x) elim-x oneN threeB ;
    } ;
    certified : Tr.Trunc[C.RK.CertW (C.RK.ub x)].carrier = C.cert (C.RK.ub x) elim-x ;
    -- x is a finite combination of the components of the generators
    Generated : U l = (w : C.ReesW) * C.WithGens[w].GC.FC.InComb x ;
    generated-x : Tr.Trunc[Generated].carrier =
      TC.map C.ReesW Generated (\ w -> (w, C.WithGens[w].kernel-generated x ker-x)) C.presentation ;
  } ;
} ;

------------------------------------------------------------------------
-- 3. over Z, a = (2, 3)

module OverZ {
  module ZR = ZRing[l] ;
  aZ : Ps.Fin CRt.rk2 -> Int = CRt.pair Int (pos twoB) (pos threeB) ;
  module T = RP.ConcreteT[Nat * Nat,ZR.ring,ZR.set,ZCFN[l].cfn,CRt.rk2,aZ,oneN,\ q -> cubicT ZR.ring,\ q -> threeB,\ q -> cubic-hom ZR.ring] ;
  module C = T.C ;
  module GL = C.RK.GL ;
  iX (n : Int) : C.XR.B.R = C.XR.GX.iota.1 n ;
  cZ (n : Int) : C.R.R = C.GU.iota.1 (iX n) ;
  U1 : C.R.R = C.GU.var CRt.i0 ;
  U2 : C.R.R = C.GU.var CRt.i1 ;
  y1 : C.R.R = C.R.mul (cZ (pos threeB)) U1 ;
  y2 : C.R.R = C.R.mul (cZ (pos twoB)) U2 ;
  -- 3 U_1 - 2 U_2
  x : C.R.R = C.R.add y1 (C.R.neg y2) ;
  hom-y (n : Int) (j : Ps.Fin CRt.rk2) : GL.Hom (pos (suc zero)) (C.R.mul (cZ n) (C.GU.var j)) =
    trans (GL.pr-iota (pos (suc zero)) (iX n) (C.GU.var j)) (ap (C.R.mul (cZ n)) (C.GU.var-hom j)) ;
  hom-x : GL.Hom (pos (suc zero)) x =
    GL.hom-add (pos (suc zero)) y1 (C.R.neg y2) (hom-y (pos threeB) CRt.i0)
      (trans (GL.pr-neg (pos (suc zero)) y2) (ap C.R.neg (hom-y (pos twoB) CRt.i1))) ;
  -- ev (c U_j) = c a_j, computed in Z
  ev-y (n : Int) (j : Ps.Fin CRt.rk2) : Id C.XR.B.R (C.RK.RG.ev (C.R.mul (cZ n) (C.GU.var j))) (iX (ZR.mul n (aZ j))) =
    trans (C.RK.RG.EV.ev.2.2.2 (cZ n) (C.GU.var j))
      (trans (ap (\ z -> C.XR.B.mul z (C.RK.RG.ev (C.GU.var j))) (C.GU.ev-iota C.b (iX n)))
        (trans (ap (C.XR.B.mul (iX n)) (C.GU.ev-var C.b j)) (sym (C.XR.GX.iota.2.2.2 n (aZ j))))) ;
  -- ev x = 3.2 - 2.3 = 0
  ev-x : Id C.XR.B.R (C.RK.RG.ev x) C.XR.B.z =
    trans (C.RK.RG.EV.ev.2.2.1 y1 (C.R.neg y2))
      (trans (IP.ModL[C.XR.B,IP.regular C.XR.B].G.cong-add (ev-y (pos threeB) CRt.i0)
                (trans (RH.negation C.R C.XR.B C.RK.RG.EV.ev y2) (ap C.XR.B.neg (ev-y (pos twoB) CRt.i1))))
        (C.XR.B.addN (iX (ZR.mul (pos threeB) (pos twoB))))) ;
  inJ-x : C.RK.InJ (C.RK.RG.ev x) =
    Tr.Trunc[C.RK.JW (C.RK.RG.ev x)].inc (\ q -> C.XR.B.z, trans ev-x (sym (C.RK.RSB.comb-zero oneN T.P))) ;
  elim-x : C.RK.Elim (C.RK.ub x) = C.RK.elim-of-hom (suc zero) x hom-x inJ-x ;
  ker-x : C.RK.Ker x = C.ker-of-elim (C.RK.ub x) elim-x ;
  Generated : U l = (w : C.ReesW) * C.WithGens[w].GC.FC.InComb x ;
  generated-x : Tr.Trunc[Generated].carrier =
    TC.map C.ReesW Generated (\ w -> (w, C.WithGens[w].kernel-generated x ker-x)) C.presentation ;
  -- 1 and 2 over Z, with a_1 = 2
  module CZ = OverCFN[Nat * Nat,ZR.ring,ZR.set,ZCFN[l].cfn] ;
  elim0 : CZ.C0.RK.Elim (CZ.C0.RK.ub CZ.x0) = CZ.elim0 ;
  elim1 : CZ.T1[pos twoB].C.RK.Elim (CZ.T1[pos twoB].C.RK.ub CZ.T1[pos twoB].x) = CZ.T1[pos twoB].elim-x ;
} ;
