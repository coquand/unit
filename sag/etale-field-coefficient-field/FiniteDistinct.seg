-- Finite lookup and extension of a distinct list in a discrete type.
-- Membership keeps the unique index, so no representative choice is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (X : U l) (setX : Pr.isSet X)
 (equal : (a b : X) -> Plus (Id X a b) (Not (Id X a b))) {
 Injective (n : Nat) (v : Fin n -> X) : U l =
  (i j : Fin n) -> Id X (v i) (v j) -> Id (Fin n) i j ;
 Member (n : Nat) (v : Fin n -> X) (x : X) : U l = (i : Fin n) * Id X (v i) x ;
 Fresh (n : Nat) (v : Fin n -> X) (x : X) : U l = (i : Fin n) -> Not (Id X (v i) x) ;
 Lookup (n : Nat) (v : Fin n -> X) (x : X) : U l = Plus (Member n v x) (Fresh n v x) ;
 member-prop (n : Nat) (v : Fin n -> X) (inj : Injective n v) (x : X) : Pr.isProp (Member n v x) =
  \ a b -> Pr.Sigma-eq (Fin n) (\ i -> Id X (v i) x) a.1 b.1 a.2 b.2
   (inj a.1 b.1 (trans a.2 (sym b.2))) (setX (v b.1) x) ;
 fail (n : Nat) (v : Fin (suc n) -> X) (x : X) (h : Not (Id X (v (inr tt)) x))
  (old : Fresh n (\ i -> v (inl i)) x) : Fresh (suc n) v x =
  AffineFinite[l].section n (\ i -> Not (Id X (v i) x)) old h ;
 append-result (n : Nat) (v : Fin (suc n) -> X) (x : X)
  (h : Not (Id X (v (inr tt)) x)) : Lookup n (\ i -> v (inl i)) x -> Lookup (suc n) v x = split {
  inl a -> inl (inl a.1,a.2) ; inr no -> inr (fail n v x h no) } ;
 last (n : Nat) (v : Fin (suc n) -> X) (x : X) (old : Lookup n (\ i -> v (inl i)) x) :
  Plus (Id X (v (inr tt)) x) (Not (Id X (v (inr tt)) x)) -> Lookup (suc n) v x = split {
  inl h -> inl (inr tt,h) ; inr h -> append-result n v x h old } ;
 lookup : (n : Nat) (v : Fin n -> X) (x : X) -> Lookup n v x = split {
  zero -> \ v x -> inr (\ i -> efq i) ;
  suc n | ih -> \ v x -> last n v x (ih (\ i -> v (inl i)) x) (equal (v (inr tt)) x) } ;
 module Append (n : Nat) (v : Fin n -> X) (inj : Injective n v) (x : X) (fresh : Fresh n v x) {
  vector : Fin (suc n) -> X = snoc (Fin n) X v x ;
  equal-indices : (i j : Fin (suc n)) -> Id X (vector i) (vector j) -> Id (Fin (suc n)) i j = split {
   inl i -> split {
    inl j -> \ h -> ap (\ z -> inl z) (inj i j h) ;
    inr t -> \ h -> efq (fresh i h) } ;
   inr t -> split {
    inl j -> \ h -> efq (fresh j (sym h)) ;
    inr u -> \ h -> ap (\ z -> inr z) (AffineFinite[l].top-eq t u) } } ;
 } ;
} ;
