-- Finite dependent search with a common explicit failure witness.
level l ; open Ring[l] ; open Presentations[l] ;
map (A B E : U l) (f : A -> B) : Plus A E -> Plus B E = split { inl a -> inl (f a) ; inr e -> inr e } ;
join-right (A B E : U l) (a : A) : Plus B E -> Plus (A * B) E = split {
 inl b -> inl (a,b) ; inr e -> inr e } ;
join (A B E : U l) : Plus A E -> Plus B E -> Plus (A * B) E = split {
 inl a -> join-right A B E a ; inr e -> \ b -> inr e } ;
step (n : Nat) (P : Fin (suc n) -> U l) (E : U l)
 (old : Plus ((i : Fin n) -> P (inl i)) E) (last : Plus (P (inr tt)) E) : Plus ((i : Fin (suc n)) -> P i) E =
 map (((i : Fin n) -> P (inl i)) * P (inr tt)) ((i : Fin (suc n)) -> P i) E
  (\ p -> AffineFinite[l].section n P p.1 p.2)
  (join ((i : Fin n) -> P (inl i)) (P (inr tt)) E old last) ;
scan : (n : Nat) (P : Fin n -> U l) (E : U l) -> ((i : Fin n) -> Plus (P i) E) -> Plus ((i : Fin n) -> P i) E = split {
 zero -> \ P E f -> inl (\ i -> efq i) ;
 suc n | ih -> \ P E f -> step n P E (ih (\ i -> P (inl i)) E (\ i -> f (inl i))) (f (inr tt)) } ;

-- Finite choice suffices to run the same scan with mere answers.
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
mere (n : Nat) (P : Fin n -> U l) (E : U l)
 (f : (i : Fin n) -> Tr.Trunc[Plus (P i) E].carrier) : Tr.Trunc[Plus ((i : Fin n) -> P i) E].carrier =
 TC.map ((i : Fin n) -> Plus (P i) E) (Plus ((i : Fin n) -> P i) E)
  (scan n P E) (AffineFinite[l].choice n (\ i -> Plus (P i) E) f) ;
mere-join (A B E : U l) : Tr.Trunc[Plus A E].carrier -> Tr.Trunc[Plus B E].carrier -> Tr.Trunc[Plus (A * B) E].carrier =
 TC.map2 (Plus A E) (Plus B E) (Plus (A * B) E) (join A B E) ;
