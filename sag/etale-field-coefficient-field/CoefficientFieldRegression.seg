-- Computed branches over F2: the bound 1 yields two distinct elements;
-- the bound 2 yields the actual finite coefficient subfield. Repeated
-- input coefficients cause no extra growth and all have explicit lifts.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module B = BooleanRing[l] ;
k : CRing = B.two-ring ;
empty-to-ring : Base.Empty -> Empty = split {} ;
empty-up : Empty -> Ring[l+].Empty = split {} ;
nonzero : Not (Id k.R k.o k.z) = \ h -> empty-to-ring (B.true-false h) ;
decide : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ;
coefficients : Fin three -> k.R = snoc (Fin two) k.R (snoc (Fin one) k.R (\ i -> true) false) true ;
module T = FiniteCoefficientField[l].Over[k,B.bool-set,decide,nonzero,three,coefficients] ;
branch (M : Nat) : T.Result M -> Nat = split { inl large -> zero ; inr small -> one } ;
large-branch : Id Nat (branch one (T.theorem one)) zero = refl zero ;
small-branch : Id Nat (branch two (T.theorem two)) one = refl one ;
get-small (M : Nat) : (r : T.Result M) -> Id Nat (branch M r) one -> T.Subfield = split {
 inl large -> \ h -> Ring[l+].absurd T.Subfield (empty-up (zero-suc zero h)) ;
 inr small -> \ h -> small } ;
get-large (M : Nat) : (r : T.Result M) -> Id Nat (branch M r) zero -> T.Closure.Distinct (suc M) = split {
 inl large -> \ h -> large ; inr small -> \ h -> efq (suc-zero zero h) } ;
small : T.Subfield = get-small two (T.theorem two) small-branch ;
large : T.Closure.Distinct two = get-large one (T.theorem one) large-branch ;
small-size : Id Nat small.size two = refl two ;
large-zero : Id k.R (large.1 (inl (inr tt))) false = refl false ;
large-one : Id k.R (large.1 (inr tt)) true = refl true ;
large-distinct (i j : Fin two) (h : Id k.R (large.1 i) (large.1 j)) : Id (Fin two) i j = large.2 i j h ;
coefficient-lift (i : Fin three) : Id k.R (small.inclusion.1 (small.coefficient i)) (coefficients i) = small.coefficient-image i ;
field-decide (a : small.ring.R) : Plus (Id small.ring.R a small.ring.z) (RL[small.ring].unit a) = small.field-decide a ;
finite-cover (a : small.ring.R) : (i : Fin small.size) * Id small.ring.R (small.enumeration i) a = small.cover a ;
module EmptyCoefficients = FiniteCoefficientField[l].Over[k,B.bool-set,decide,nonzero,zero,\ i -> efq i] ;
empty-branch : EmptyCoefficients.Result two = EmptyCoefficients.theorem two ;
module Ops = DiscreteFieldOperations[l].Over[k,B.bool-set,decide,nonzero] ;
inverse-zero : Id k.R (Ops.inverse false) false = refl false ;
inverse-one : Id k.R (Ops.inverse true) true = refl true ;
