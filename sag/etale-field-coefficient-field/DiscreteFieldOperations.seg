-- Constructive field operations used in bounded closure. Inverse is
-- total, choosing 0 at 0. Closing under this operation avoids a separate
-- finite injection-to-surjection argument for the closed coefficient ring.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (decide : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a)) (nonzero : Not (Id k.R k.o k.z)) {
 module L = RL[k] ;
 unit-nonzero (a : k.R) (u : L.unit a) (h : Id k.R a k.z) : Empty =
  nonzero (trans (sym u.2) (trans (ap (\ x -> k.mul x u.1) h) (L.zero-mul u.1))) ;
 zero-case (a : k.R) : Plus (Id k.R a k.z) (L.unit a) -> Plus (Id k.R a k.z) (Not (Id k.R a k.z)) = split {
  inl h -> inl h ; inr h -> inr (unit-nonzero a h) } ;
 zero-dec (a : k.R) : Plus (Id k.R a k.z) (Not (Id k.R a k.z)) = zero-case a (decide a) ;
 equal-case (a b : k.R) : Plus (Id k.R (k.add a (k.neg b)) k.z) (Not (Id k.R (k.add a (k.neg b)) k.z)) ->
  Plus (Id k.R a b) (Not (Id k.R a b)) = split {
  inl h -> inl (AffineRing[l].Laws[k,setk].difference-zero a b h) ;
  inr h -> inr (\ p -> h (trans (ap (\ x -> k.add x (k.neg b)) p) (k.addN b))) } ;
 equal (a b : k.R) : Plus (Id k.R a b) (Not (Id k.R a b)) = equal-case a b (zero-dec (k.add a (k.neg b))) ;
 inverse-case (a : k.R) : Plus (Id k.R a k.z) (L.unit a) -> k.R = split {
  inl h -> k.z ; inr u -> u.1 } ;
 inverse (a : k.R) : k.R = inverse-case a (decide a) ;
 proof-case (a : k.R) (h : Not (Id k.R a k.z)) :
  (d : Plus (Id k.R a k.z) (L.unit a)) -> Id k.R (k.mul a (inverse-case a d)) k.o = split {
  inl z -> efq (h z) ; inr u -> u.2 } ;
 inverse-law (a : k.R) (h : Not (Id k.R a k.z)) : Id k.R (k.mul a (inverse a)) k.o = proof-case a h (decide a) ;
} ;
