-- Main algebraic calculation. Only the displayed Stable hypothesis is assumed.
level l ; open Ring[l] ;
module Over (A B : CRing) (setA : Prelude[l].isSet A.R) (setB : Prelude[l].isSet B.R)
 (h : RingHom[l].Hom A B) (F G Ue Ve : Bivariate[l].Over[A].Expr)
 (relation : PolynomialIdentity[l].Over[A,setA].Relation F G Ue Ve)
 (x0 y0 : B.R)
 (gzero : Id B.R (Bivariate[l].Over[A].In[B,h].val x0 y0 G) B.z)
 (invertible : RL[B].unit (Bivariate[l].Over[A].In[B,h].jacobian x0 y0 F G))
 (n : Nat) (stable : StableAnnihilator[l].Over[B].Stable (Bivariate[l].Over[A].In[B,h].val x0 y0 F) n) {
 open B ; open Poly[l].PolyR[B] ; open Mul[l].MulR[B] ;
 module E = Bivariate[l].Over[A].In[B,h] ;
 module J = FiniteJets[l].Over[B] ; module S = StableAnnihilator[l].Over[B] ;
 module L = TaylorLift[l].Over[A,B,h,F,G,x0,y0,gzero,invertible] ;
 module M = RawMultiplication[l].Laws[B] ;
 s : L.State n = L.lift n ; x : P = s.1 ; y : P = s.2.1 ;
 p : P = E.raw x y Ue ; q : P = E.raw x y Ve ;
 curve-relation : peq (pmul (E.raw x y F) p) (pmul (E.raw x y G) q) =
  PolynomialIdentity[l].Over[A,setA].RawInto[B,setB,h].relation F G Ue Ve relation x y ;
 vanishes : J.Eq (suc n) (pmul L.target p) nil =
  J.compose (suc n) (pmul L.target p) (pmul (E.raw x y F) p) nil
   (J.mul-eq (suc n) L.target (E.raw x y F) p p
    (J.reverse (suc n) (E.raw x y F) L.target s.2.2.2.2.1) (J.same (suc n) p))
   (J.compose (suc n) (pmul (E.raw x y F) p) (pmul (E.raw x y G) q) nil
    (J.from-peq (suc n) _ _ curve-relation)
    (J.compose (suc n) (pmul (E.raw x y G) q) (pmul nil q) nil
     (J.mul-eq (suc n) (E.raw x y G) nil q q s.2.2.2.2.2 (J.same (suc n) q))
     (J.from-peq (suc n) (pmul nil q) nil (M.mul-zero-left q)))) ;
 constant : Id R (coef p zero) (E.val x0 y0 Ue) =
  trans (E.raw-zero x y Ue)
   (trans (ap (\ t -> E.val t (coef y zero) Ue) s.2.2.1)
    (ap (\ t -> E.val x0 t Ue) s.2.2.2.1)) ;
 result : Id R (E.val x0 y0 Ue) z =
  trans (sym constant) (S.Kernel[L.f,n,stable,p,vanishes].result) ;
} ;
