-- Every element of the existing A[X][Y] has a bivariate expression,
-- merely. This uses quotient induction and finite list induction, no choice.
level l ; open Ring[l] ;
module Tr = Truncation[l] ; module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module P = PolynomialIdentity[l].Over[A,setA] ; module T = Bivariate[l].Over[A] ; open T ;
 module X = P.X ; module XY = P.XY ;
 module H = RingHom[l] ;
 xexpr : List A.R -> Expr = split {
  nil -> cE A.z ; cons a p | r -> addE (cE a) (mulE xE r) } ;
 xexpr-sound : (p : List A.R) -> Id XY.Carrier (P.formal (xexpr p)) (XY.constant (X.include p)) = split {
  nil -> ap XY.constant (H.zero A X.ring X.inclusion) ;
  cons a p | r -> trans (ap (XY.addQ (P.formal (cE a))) (ap (XY.mulQ P.x) r))
   (trans (ap (XY.addQ (P.formal (cE a))) (sym (XY.inclusion.2.2.2 X.variable (X.include p))))
    (trans (sym (XY.inclusion.2.2.1 (X.constant a) (X.mulQ X.variable (X.include p))))
     (ap XY.constant (sym (X.horner a p))))) } ;
 Rep (p : XY.Carrier) : U l = (e : Expr) * Id XY.Carrier (P.formal e) p ;
 Has (p : XY.Carrier) : U l = Tr.Trunc[Rep p].carrier ;
 has-prop (p : XY.Carrier) : Pr.isProp (Has p) = Tr.Trunc[Rep p].proposition ;
 coefficient : (a : X.Carrier) -> Has (XY.constant a) =
  X.Q.induction @l (\ a -> Has (XY.constant a)) (\ a -> has-prop (XY.constant a))
   (\ p -> Tr.Trunc[Rep (XY.constant (X.include p))].inc (xexpr p,xexpr-sound p)) ;
 zero : Rep XY.zeroQ =
  (cE A.z,trans (ap XY.constant (H.zero A X.ring X.inclusion)) (H.zero X.ring XY.ring XY.inclusion)) ;
 module Cons (a : X.Carrier) (p : List X.Carrier) (r : Has (XY.include p)) {
  combine (ca : Rep (XY.constant a)) (cp : Rep (XY.include p)) : Rep (XY.include (cons a p)) =
   (addE ca.1 (mulE yE cp.1),
    trans (Presentations[l].cong2 XY.Carrier XY.addQ _ _ _ _ ca.2 (ap (XY.mulQ P.y) cp.2))
     (sym (XY.horner a p))) ;
  result : Has (XY.include (cons a p)) =
   Tr.Trunc[Rep (XY.constant a)].induction @l (\ ca -> Has (XY.include (cons a p))) (\ ca -> has-prop _)
    (\ ca -> Tr.Trunc[Rep (XY.include p)].induction @l (\ cp -> Has (XY.include (cons a p))) (\ cp -> has-prop _)
     (\ cp -> Tr.Trunc[Rep (XY.include (cons a p))].inc (combine ca cp)) r) (coefficient a) ;
 } ;
 raw : (p : List X.Carrier) -> Has (XY.include p) = split {
  nil -> Tr.Trunc[Rep XY.zeroQ].inc zero ; cons a p | r -> Cons[a,p,r].result } ;
 represent : (p : XY.Carrier) -> Has p = XY.Q.induction @l Has has-prop raw ;
} ;
