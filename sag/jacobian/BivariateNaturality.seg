-- Evaluation and evaluated partial derivatives commute with ring maps.
level l ; open Ring[l] ;
module Over (A B C : CRing) (h : RingHom[l].Hom A B) (k : RingHom[l].Hom B C) (x y : B.R) {
 module T = Bivariate[l].Over[A] ; open T ;
 module EB = T.In[B,h] ;
 composite : RingHom[l].Hom A C = RingHom[l].compose A B C k h ;
 module EC = T.In[C,composite] ;
 module J = FiniteJets[l].Over[C] ;
 value : (e : Expr) -> Id C.R (k.1 (EB.val x y e)) (EC.val (k.1 x) (k.1 y) e) = split {
  xE -> refl (k.1 x) ; yE -> refl (k.1 y) ; cE a -> refl (k.1 (h.1 a)) ;
  addE p q | hp hq -> trans (k.2.2.1 (EB.val x y p) (EB.val x y q)) (J.cg C.add _ _ _ _ hp hq) ;
  mulE p q | hp hq -> trans (k.2.2.2 (EB.val x y p) (EB.val x y q)) (J.cg C.mul _ _ _ _ hp hq) } ;
 dx : (e : Expr) -> Id C.R (k.1 (EB.dx x y e)) (EC.dx (k.1 x) (k.1 y) e) = split {
  xE -> k.2.1 ; yE -> RingHom[l].zero B C k ; cE a -> RingHom[l].zero B C k ;
  addE p q | hp hq -> trans (k.2.2.1 (EB.dx x y p) (EB.dx x y q)) (J.cg C.add _ _ _ _ hp hq) ;
  mulE p q | hp hq -> trans (k.2.2.1 (B.mul (EB.dx x y p) (EB.val x y q)) (B.mul (EB.val x y p) (EB.dx x y q)))
   (J.cg C.add _ _ _ _
    (trans (k.2.2.2 (EB.dx x y p) (EB.val x y q)) (J.cg C.mul _ _ _ _ hp (value q)))
    (trans (k.2.2.2 (EB.val x y p) (EB.dx x y q)) (J.cg C.mul _ _ _ _ (value p) hq))) } ;
 dy : (e : Expr) -> Id C.R (k.1 (EB.dy x y e)) (EC.dy (k.1 x) (k.1 y) e) = split {
  xE -> RingHom[l].zero B C k ; yE -> k.2.1 ; cE a -> RingHom[l].zero B C k ;
  addE p q | hp hq -> trans (k.2.2.1 (EB.dy x y p) (EB.dy x y q)) (J.cg C.add _ _ _ _ hp hq) ;
  mulE p q | hp hq -> trans (k.2.2.1 (B.mul (EB.dy x y p) (EB.val x y q)) (B.mul (EB.val x y p) (EB.dy x y q)))
   (J.cg C.add _ _ _ _
    (trans (k.2.2.2 (EB.dy x y p) (EB.val x y q)) (J.cg C.mul _ _ _ _ hp (value q)))
    (trans (k.2.2.2 (EB.val x y p) (EB.dy x y q)) (J.cg C.mul _ _ _ _ (value p) hq))) } ;
 jacobian (p q : Expr) : Id C.R (k.1 (EB.jacobian x y p q)) (EC.jacobian (k.1 x) (k.1 y) p q) =
  trans (k.2.2.1 (B.mul (EB.dx x y p) (EB.dy x y q)) (B.neg (B.mul (EB.dy x y p) (EB.dx x y q))))
   (J.cg C.add _ _ _ _
    (trans (k.2.2.2 (EB.dx x y p) (EB.dy x y q)) (J.cg C.mul _ _ _ _ (dx p) (dy q)))
    (trans (RingHom[l].negation B C k (B.mul (EB.dy x y p) (EB.dx x y q)))
     (ap C.neg (trans (k.2.2.2 (EB.dy x y p) (EB.dx x y q)) (J.cg C.mul _ _ _ _ (dy p) (dx q)))))) ;
} ;
