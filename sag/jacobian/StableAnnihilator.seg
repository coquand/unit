-- The only noetherian input is Stable f n, used in Kernel.result; Kernel.iterated
-- and Kernel.killed hold without it (see Sequence for the other use).
level l ; open Ring[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ; open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module J = FiniteJets[l].Over[A] ; module M = RawMultiplication[l].Laws[A] ;
 module L = RawLaws[l].Laws[A] ;
 power (f : R) : Nat -> R = split { zero -> o ; suc n | r -> mul f r } ;
 Stable (f : R) (n : Nat) : U l =
  (v : R) -> Id R (mul (power f (suc n)) v) z -> Id R (mul (power f n) v) z ;
 difference (a b : R) (h : Id R (add a (neg b)) z) : Id R a b =
  trans (sym (addZ a))
   (trans (ap (add a) (sym (neg-cancel b)))
    (trans (addA a (neg b) b) (trans (ap (\ c -> add c b) h) (zl b)))) ;
 linear (f : R) : P = cons f (cons (neg o) nil) ;
 linear-next (f : R) (p : P) (k : Nat) :
  Id R (coef (pmul (linear f) p) (suc k)) (add (mul f (coef p (suc k))) (neg (coef p k))) =
  trans (J.mul-next (linear f) p k)
   (ap (add (mul f (coef p (suc k))))
    (trans (M.mul-single-left (neg o) p k) (L.neg-coef p k))) ;
 Steps (f : R) (n : Nat) (p : P) : U l =
  (k : Nat) -> FiniteJets[l].Lt n k -> Id R (coef p k) (mul f (coef p (suc k))) ;
 steps (f : R) (n : Nat) (p : P) (h : J.Eq (suc n) (pmul (linear f) p) nil) : Steps f n p =
  \ k b -> sym (difference (mul f (coef p (suc k))) (coef p k)
   (trans (sym (linear-next f p k)) (h (suc k) b))) ;
 steps-tail (f : R) (n : Nat) (p : P) (h : Steps f (suc n) p) : Steps f n (J.tail p) =
  \ k b -> trans (J.tail-coef p k)
   (trans (h (suc k) b) (ap (mul f) (sym (J.tail-coef p (suc k))))) ;
 iterate (f : R) : (n : Nat) (p : P) -> Steps f n p ->
  Id R (coef p zero) (mul (power f n) (coef p n)) = split {
  zero -> \ p h -> sym (one-left (coef p zero)) ;
  suc n | r -> \ p h -> trans (h zero tt)
   (trans (ap (mul f)
     (trans (sym (J.tail-coef p zero))
      (trans (r (J.tail p) (steps-tail f n p h)) (ap (mul (power f n)) (J.tail-coef p n)))))
    (mulA f (power f n) (coef p (suc n)))) } ;
 -- iterated and killed hold at every order; only result uses Stable
 module Kernel (f : R) (n : Nat) (p : P)
  (h : J.Eq (suc n) (pmul (linear f) p) nil) {
  initial : Id R (mul f (coef p zero)) z = trans (sym (coef0-pmul (linear f) p)) (h zero tt) ;
  iterated : Id R (coef p zero) (mul (power f n) (coef p n)) = iterate f n p (steps f n p h) ;
  killed : Id R (mul (power f (suc n)) (coef p n)) z =
   trans (sym (mulA f (power f n) (coef p n))) (trans (ap (mul f) (sym iterated)) initial) ;
  result (stable : Stable f n) : Id R (coef p zero) z = trans iterated (stable (coef p n) killed) ;
 } ;
} ;
