-- RawMap.seg: a ring map k : S -> T acts on coefficient lists, and the
-- action commutes with sum and product up to peq.  The k-th coefficient
-- of the image is the image of the k-th coefficient; sum and scaling
-- follow coefficientwise, the product by its recursion on the second
-- factor.
level l ; open Ring[l] ;
module Over (S T : CRing) (k : RingHom[l].Hom S T) {
 module PS = Poly[l].PolyR[S] ; module PT = Poly[l].PolyR[T] ;
 module MS = Mul[l].MulR[S] ; module MT = Mul[l].MulR[T] ;
 module LT = RawLaws[l].Laws[T] ; module RT = RawMultiplication[l].Laws[T] ;

 pmap : PS.P -> PT.P = split { nil -> nil ; cons c p | r -> cons (k.1 c) r } ;

 coef-pmap : (p : PS.P) (n : Nat) -> Id T.R (PT.coef (pmap p) n) (k.1 (PS.coef p n)) = split {
  nil -> \ n -> sym (RingHom[l].zero S T k) ;
  cons c p | r -> split { zero -> refl (k.1 c) ; suc n -> r n } } ;

 pmap-addP (p q : PS.P) : PT.peq (pmap (MS.addP p q)) (MT.addP (pmap p) (pmap q)) = \ n ->
  calc T.R { PT.coef (pmap (MS.addP p q)) n
               =< coef-pmap (MS.addP p q) n > k.1 (PS.coef (MS.addP p q) n)
               =< ap k.1 (MS.coef-addP p q n) > k.1 (S.add (PS.coef p n) (PS.coef q n))
               =< k.2.2.1 (PS.coef p n) (PS.coef q n) > T.add (k.1 (PS.coef p n)) (k.1 (PS.coef q n))
               =< FiniteJets[l].Over[T].cg T.add _ _ _ _ (sym (coef-pmap p n)) (sym (coef-pmap q n))
               > T.add (PT.coef (pmap p) n) (PT.coef (pmap q) n)
               =< sym (MT.coef-addP (pmap p) (pmap q) n) > PT.coef (MT.addP (pmap p) (pmap q)) n } ;

 pmap-scal (b : S.R) (p : PS.P) : PT.peq (pmap (MS.scal b p)) (MT.scal (k.1 b) (pmap p)) = \ n ->
  calc T.R { PT.coef (pmap (MS.scal b p)) n
               =< coef-pmap (MS.scal b p) n > k.1 (PS.coef (MS.scal b p) n)
               =< ap k.1 (MS.coef-scal b p n) > k.1 (S.mul b (PS.coef p n))
               =< k.2.2.2 b (PS.coef p n) > T.mul (k.1 b) (k.1 (PS.coef p n))
               =< ap (T.mul (k.1 b)) (sym (coef-pmap p n)) > T.mul (k.1 b) (PT.coef (pmap p) n)
               =< sym (MT.coef-scal (k.1 b) (pmap p) n) > PT.coef (MT.scal (k.1 b) (pmap p)) n } ;

 -- f (b + X g) = b f + X (f g), on both sides
 pmap-pmul (f : PS.P) : (g : PS.P) -> PT.peq (pmap (MS.pmul f g)) (MT.pmul (pmap f) (pmap g)) = split {
  nil -> LT.rr nil ;
  cons b g | r ->
   LT.eq _ _ _ (pmap-addP (MS.scal b f) (cons S.z (MS.pmul f g)))
    (LT.add-cong _ _ _ _ (pmap-scal b f) (RT.cons-cong (k.1 S.z) T.z _ _ (RingHom[l].zero S T k) r)) } ;
} ;
