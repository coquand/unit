-- FiniteCoefficients.seg: Step II over an arbitrary coefficient ring A,
-- with no hypothesis (doc/jacobian-noetherian.tex).
--
-- Fix F U = G V.  In B = (A[X,Y]/G)[1/J] it suffices that u = U(x,y) = 0
-- (JacobianDivisibility.FromVanishing).
--  1. gens: the images in B of the constants of F, G, U, V, then 1/J, y, x.
--     Gn.gen gens presents Z[gens] in B, noetherian (Integers, Generated).
--  2. C: the coded subring B' of B (CodedSubring); it is coded noetherian
--     (Subring), and incl : B' -> B is injective (C.eq).
--  3. Fs, Gs, Us, Vs: F, G, U, V with their constants in B' (lift; each
--     constant is a generator).  Over B', with the identity as coefficient
--     map, G(x,y) = 0 and 1/J inverts J(x,y), and the curve identity holds
--     in B'[T]: its image under incl is the image of F U = G V in B[T]
--     (RawMap, PolynomialIdentity.RawInto), and incl is injective.
--  4. RegularAt.Curve over B' gives u = f^n w_n and f^(n+1) w_n = 0 in B';
--     each w_n is in B', so merely coded, and CodedSubring.Vanish gives
--     u = 0 in B', hence in B.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (F G : Bivariate[l].Over[A].Expr) {
 module D = JacobianDivisibility[l].Over[A,setA,F,G] ;
 B : CRing = D.B ;
 module T = Bivariate[l].Over[A] ;
 module J = FiniteJets[l].Over[B] ;
 module Z = Integers[l].Over[B] ;
 module Gn = Generated[l].Over[B,Z.pres,Z.noeth] ;

 ------------------------------------------------------------------------
 -- the generators

 xB : B.R = D.phi.1 D.P.x ; yB : B.R = D.phi.1 D.P.y ;
 jinv : B.R = D.L.invertible.1 ;
 base : List B.R = cons jinv (cons yB (cons xB nil)) ;

 -- the images of the constants of e, in front of acc
 consts : T.Expr -> List B.R -> List B.R = split {
  xE -> \ acc -> acc ; yE -> \ acc -> acc ;
  cE a -> \ acc -> cons (D.h.1 a) acc ;
  addE p q | rp rq -> \ acc -> rp (rq acc) ;
  mulE p q | rp rq -> \ acc -> rp (rq acc) } ;

 CodedIn (xs : List B.R) (b : B.R) : U l = CodedSubring[l].Over[B,Gn.gen xs].Coded b ;

 -- a code over xs is one over x.xs, hence over consts e xs
 up (x : B.R) (xs : List B.R) (b : B.R) (c : CodedIn xs b) : CodedIn (cons x xs) b =
  Tr.Trunc[CodedSubring[l].Over[B,Gn.gen xs].Lifts b].induction @l (\ t -> CodedIn (cons x xs) b)
   (\ t -> CodedSubring[l].Over[B,Gn.gen (cons x xs)].coded-prop b)
   (\ cb -> CodedSubring[l].Over[B,Gn.gen (cons x xs)].known (Gn.up x xs cb.1) b (trans (Gn.up-phi x xs cb.1) cb.2)) c ;
 ups : (e : T.Expr) (acc : List B.R) (b : B.R) -> CodedIn acc b -> CodedIn (consts e acc) b = split {
  xE -> \ acc b c -> c ; yE -> \ acc b c -> c ;
  cE a -> \ acc b c -> up (D.h.1 a) acc b c ;
  addE p q | rp rq -> \ acc b c -> rp (consts q acc) b (rq acc b c) ;
  mulE p q | rp rq -> \ acc b c -> rp (consts q acc) b (rq acc b c) } ;

 -- every constant of e is coded over xs
 AllCoded (xs : List B.R) : T.Expr -> U l = split {
  xE -> Top ; yE -> Top ; cE a -> CodedIn xs (D.h.1 a) ;
  addE p q | rp rq -> rp * rq ; mulE p q | rp rq -> rp * rq } ;
 all : (e : T.Expr) (acc xs : List B.R) -> ((b : B.R) -> CodedIn (consts e acc) b -> CodedIn xs b) ->
   AllCoded xs e = split {
  xE -> \ acc xs m -> tt ; yE -> \ acc xs m -> tt ;
  cE a -> \ acc xs m -> m (D.h.1 a)
    (CodedSubring[l].Over[B,Gn.gen (cons (D.h.1 a) acc)].known (Gn.var (D.h.1 a) acc) (D.h.1 a) (Gn.var-phi (D.h.1 a) acc)) ;
  addE p q | rp rq -> \ acc xs m -> (rp (consts q acc) xs m, rq acc xs (\ b c -> m b (ups p (consts q acc) b c))) ;
  mulE p q | rp rq -> \ acc xs m -> (rp (consts q acc) xs m, rq acc xs (\ b c -> m b (ups p (consts q acc) b c))) } ;

 module CB = CodedSubring[l].Over[B,Gn.gen base] ;
 coded-x : CodedIn base xB =
   CB.known (Gn.up jinv (cons yB (cons xB nil)) (Gn.up yB (cons xB nil) (Gn.var xB nil))) xB
     (trans (Gn.up-phi jinv (cons yB (cons xB nil)) (Gn.up yB (cons xB nil) (Gn.var xB nil)))
       (trans (Gn.up-phi yB (cons xB nil) (Gn.var xB nil)) (Gn.var-phi xB nil))) ;
 coded-y : CodedIn base yB =
   CB.known (Gn.up jinv (cons yB (cons xB nil)) (Gn.var yB (cons xB nil))) yB
     (trans (Gn.up-phi jinv (cons yB (cons xB nil)) (Gn.var yB (cons xB nil))) (Gn.var-phi yB (cons xB nil))) ;
 coded-jinv : CodedIn base jinv = CB.known (Gn.var jinv (cons yB (cons xB nil))) jinv (Gn.var-phi jinv (cons yB (cons xB nil))) ;

 ------------------------------------------------------------------------
 -- one relation

 module AtRelation (Ue Ve : T.Expr) (rel : D.P.Relation F G Ue Ve) {
  E0 : T.Expr = addE (addE F G) (addE Ue Ve) ;
  gens : List B.R = consts E0 base ;
  module Sb = CodedSubring[l].Subring[B,Gn.gen gens,Gn.noeth gens] ;
  module C = Sb.O ;
  cs : AllCoded gens E0 = all E0 base gens (\ b c -> c) ;

  -- the four polynomials over B'
  module TS = Bivariate[l].Over[C.ring] ;
  lift : (e : T.Expr) -> AllCoded gens e -> TS.Expr = split {
   xE -> \ c -> xE ; yE -> \ c -> yE ;
   cE a -> \ c -> cE (D.h.1 a, c) ;
   addE p q | rp rq -> \ c -> addE (rp c.1) (rq c.2) ;
   mulE p q | rp rq -> \ c -> mulE (rp c.1) (rq c.2) } ;
  Fs : TS.Expr = lift F cs.1.1 ; Gs : TS.Expr = lift G cs.1.2 ;
  Us : TS.Expr = lift Ue cs.2.1 ; Vs : TS.Expr = lift Ve cs.2.2 ;
  module ES = TS.In[C.ring,RingHom[l].identity C.ring] ;

  -- incl commutes with evaluation and the partial derivatives
  value (x y : C.Carrier) : (e : T.Expr) (c : AllCoded gens e) ->
    Id B.R (ES.val x y (lift e c)).1 (D.E.val x.1 y.1 e) = split {
   xE -> \ c -> refl x.1 ; yE -> \ c -> refl y.1 ; cE a -> \ c -> refl (D.h.1 a) ;
   addE p q | hp hq -> \ c -> J.cg B.add _ _ _ _ (hp c.1) (hq c.2) ;
   mulE p q | hp hq -> \ c -> J.cg B.mul _ _ _ _ (hp c.1) (hq c.2) } ;
  dx (x y : C.Carrier) : (e : T.Expr) (c : AllCoded gens e) ->
    Id B.R (ES.dx x y (lift e c)).1 (D.E.dx x.1 y.1 e) = split {
   xE -> \ c -> refl B.o ; yE -> \ c -> refl B.z ; cE a -> \ c -> refl B.z ;
   addE p q | hp hq -> \ c -> J.cg B.add _ _ _ _ (hp c.1) (hq c.2) ;
   mulE p q | hp hq -> \ c -> J.cg B.add _ _ _ _ (J.cg B.mul _ _ _ _ (hp c.1) (value x y q c.2))
                                               (J.cg B.mul _ _ _ _ (value x y p c.1) (hq c.2)) } ;
  dy (x y : C.Carrier) : (e : T.Expr) (c : AllCoded gens e) ->
    Id B.R (ES.dy x y (lift e c)).1 (D.E.dy x.1 y.1 e) = split {
   xE -> \ c -> refl B.z ; yE -> \ c -> refl B.o ; cE a -> \ c -> refl B.z ;
   addE p q | hp hq -> \ c -> J.cg B.add _ _ _ _ (hp c.1) (hq c.2) ;
   mulE p q | hp hq -> \ c -> J.cg B.add _ _ _ _ (J.cg B.mul _ _ _ _ (hp c.1) (value x y q c.2))
                                               (J.cg B.mul _ _ _ _ (value x y p c.1) (hq c.2)) } ;
  jacobian (x y : C.Carrier) (p q : T.Expr) (cp : AllCoded gens p) (cq : AllCoded gens q) :
    Id B.R (ES.jacobian x y (lift p cp) (lift q cq)).1 (D.E.jacobian x.1 y.1 p q) =
   J.cg B.add _ _ _ _ (J.cg B.mul _ _ _ _ (dx x y p cp) (dy x y q cq))
    (ap B.neg (J.cg B.mul _ _ _ _ (dy x y p cp) (dx x y q cq))) ;

  -- ... and with evaluation on coefficient lists
  module RM = RawMap[l].Over[C.ring,B,C.incl] ;
  module PS = Poly[l].PolyR[C.ring] ; module MS = Mul[l].MulR[C.ring] ;
  module PB = Poly[l].PolyR[B] ; module MB = Mul[l].MulR[B] ;
  module LB = RawLaws[l].Laws[B] ; module RB = RawMultiplication[l].Laws[B] ;
  raw (x y : PS.P) : (e : T.Expr) (c : AllCoded gens e) ->
    PB.peq (RM.pmap (ES.raw x y (lift e c))) (D.E.raw (RM.pmap x) (RM.pmap y) e) = split {
   xE -> \ c -> LB.rr (RM.pmap x) ; yE -> \ c -> LB.rr (RM.pmap y) ;
   cE a -> \ c -> LB.rr (cons (D.h.1 a) nil) ;
   addE p q | hp hq -> \ c ->
    LB.eq _ _ _ (RM.pmap-addP (ES.raw x y (lift p c.1)) (ES.raw x y (lift q c.2)))
     (LB.add-cong _ _ _ _ (hp c.1) (hq c.2)) ;
   mulE p q | hp hq -> \ c ->
    LB.eq _ _ _ (RM.pmap-pmul (ES.raw x y (lift p c.1)) (ES.raw x y (lift q c.2)))
     (RB.mul-cong _ _ _ _ (hp c.1) (hq c.2)) } ;
  product (x y : PS.P) (p q : T.Expr) (cp : AllCoded gens p) (cq : AllCoded gens q) :
    PB.peq (RM.pmap (MS.pmul (ES.raw x y (lift p cp)) (ES.raw x y (lift q cq))))
      (MB.pmul (D.E.raw (RM.pmap x) (RM.pmap y) p) (D.E.raw (RM.pmap x) (RM.pmap y) q)) =
   LB.eq _ _ _ (RM.pmap-pmul (ES.raw x y (lift p cp)) (ES.raw x y (lift q cq)))
    (RB.mul-cong _ _ _ _ (raw x y p cp) (raw x y q cq)) ;

  -- the curve identity in B'[T], from the one in B[T]
  curve (x y : PS.P) :
    PS.peq (MS.pmul (ES.raw x y Fs) (ES.raw x y Us)) (MS.pmul (ES.raw x y Gs) (ES.raw x y Vs)) = \ k ->
   C.eq _ _
    (trans (sym (RM.coef-pmap (MS.pmul (ES.raw x y Fs) (ES.raw x y Us)) k))
     (trans (LB.eq _ _ _ (product x y F Ue cs.1.1 cs.2.1)
              (LB.eq _ _ _ (D.P.RawInto[B,D.L.set,D.h].relation F G Ue Ve rel (RM.pmap x) (RM.pmap y))
                (PB.peq-sym _ _ (product x y G Ve cs.1.2 cs.2.2))) k)
      (RM.coef-pmap (MS.pmul (ES.raw x y Gs) (ES.raw x y Vs)) k))) ;

  -- the point, G(x,y) = 0 and the inverse of J(x,y), in B'
  x0 : C.Carrier = (xB, ups E0 base xB coded-x) ;
  y0 : C.Carrier = (yB, ups E0 base yB coded-y) ;
  j0 : C.Carrier = (jinv, ups E0 base jinv coded-jinv) ;
  gzero : Id C.Carrier (ES.val x0 y0 Gs) C.zero =
   C.eq _ _ (trans (value x0 y0 G cs.1.2) D.gzero) ;
  invertible : RL[C.ring].unit (ES.jacobian x0 y0 Fs Gs) =
   (j0, C.eq _ _
     (trans (ap (\ t -> B.mul t jinv) (trans (jacobian x0 y0 F G cs.1.1 cs.1.2) (sym (D.NatMap.jacobian F G))))
       D.L.invertible.2)) ;

  -- the lift of every order, in B'
  module Order (n : Nat) {
   module R = RegularAt[l].Curve[C.ring,C.ring,RingHom[l].identity C.ring,Fs,Gs,Us,Vs,curve,x0,y0,gzero,invertible,n] ;
  } ;
  w (n : Nat) : C.Carrier = Order[n].R.coefficient ;
  module Vn = CodedSubring[l].Vanish[C.ring,C.set D.L.set,Sb.coded-noetherian,ES.val x0 y0 Fs,ES.val x0 y0 Us,w,
    \ n -> Order[n].R.iterated,\ n -> Order[n].R.killed] ;
  vanish : Id B.R (D.E.val xB yB Ue) B.z =
   trans (sym (value x0 y0 Ue cs.2.1)) (ap C.incl.1 Vn.vanish) ;
 } ;

 module V = D.FromVanishing[\ Ue Ve rel -> AtRelation[Ue,Ve,rel].vanish] ;
 result (u v : D.Rg.R) (rel : Id D.Rg.R (D.Rg.mul D.f u) (D.Rg.mul D.g v)) :
   Tr.Trunc[D.CertificateFor u].carrier = V.PolynomialRelation[u,v,rel].result ;
} ;
