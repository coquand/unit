-- The existing fraction construction at powers of one element.
level l ; open Ring[l] ;
module Tr = Truncation[l] ;
module Over (A : CRing) (j : A.R) {
 open A ; module P = AffinePowers[l].Over[A] ;
 Powers (s : R) : U l = (n : Nat) * Id R s (P.power j n) ;
 one : Powers o = (zero,refl o) ;
 product (s t : R) (hs : Powers s) (ht : Powers t) : Powers (mul s t) =
  (plus hs.1 ht.1,trans (Presentations[l].cong2 R mul _ _ _ _ hs.2 ht.2) (sym (P.power-add j hs.1 ht.1))) ;
 module L = MonoidLocalization[l].Over[A,Powers,one,product] ;
 ring : CRing = L.ring ; set : Prelude[l].isSet ring.R = L.set ;
 inclusion : RingHom[l].Hom A ring = L.inclusion ;
 inverse : L.Raw.Fraction = (o,j,suc zero,sym (mulO j)) ;
 invertible : RL[ring].unit (inclusion.1 j) = (L.include inverse,L.fraction-equation inverse) ;
 Killed (a : R) : U l = (n : Nat) * Id R (mul (P.power j n) a) z ;
 kernel (a : R) (h : Id ring.R (inclusion.1 a) ring.z) : Tr.Trunc[Killed a].carrier =
  Tr.Trunc[L.Kernel a].induction @l (\ w -> Tr.Trunc[Killed a].carrier) (\ w -> Tr.Trunc[Killed a].proposition)
   (\ w -> Tr.Trunc[Killed a].inc (w.2.1.1,trans (ap (\ t -> mul t a) (sym w.2.1.2)) w.2.2)) (L.kernel a h) ;
} ;
