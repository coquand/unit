-- A nonlinear example over every commutative ring, in every characteristic.
-- For F=X+X^2, G=Y at (0,0), the lift starts X(T)=-T-T^2, Y(T)=0.
level l ; open Ring[l] ;
module Nonlinear (A : CRing) {
 open A ; open RL[A] ;
 module T = Bivariate[l].Over[A] ; open T ;
 identity : RingHom[l].Hom A A = RingHom[l].identity A ;
 module E = T.In[A,identity] ;
 module J = FiniteJets[l].Over[A] ;
 open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 F : Expr = addE xE (mulE xE xE) ; G : Expr = yE ;
 fx : Id R (E.dx z z F) o =
  trans (ap (add o) (trans (J.cg add _ _ _ _ (mul-zero o) (zero-mul o)) (addZ z))) (addZ o) ;
 jacobian-one : Id R (E.jacobian z z F G) o =
  trans (J.cg add _ _ _ _ (mulO (E.dx z z F)) (trans (ap neg (mul-zero (E.dy z z F))) neg-zero))
   (trans (addZ (E.dx z z F)) fx) ;
 invertible : unit (E.jacobian z z F G) = (o,trans (mulO (E.jacobian z z F G)) jacobian-one) ;
 module Lift = TaylorLift[l].Over[A,A,identity,F,G,z,z,refl z,invertible] ;
 all-orders (n : Nat) : Lift.State n = Lift.lift n ;
 two : Nat = suc (suc zero) ;
 s : Lift.State two = all-orders two ;
 x : P = s.1 ; y : P = s.2.1 ;
 xzero : Id R (coef x zero) z = s.2.2.1 ;
 y-coefficients : J.Eq (suc two) y nil = s.2.2.2.2.2 ;
 square-one : Id R (coef (pmul x x) (suc zero)) z =
  trans (J.mul-next x x zero)
   (trans (J.cg add _ _ _ _
     (trans (ap (\ t -> mul t (coef x (suc zero))) xzero) (zero-mul (coef x (suc zero))))
     (trans (coef0-pmul (J.tail x) x) (trans (ap (mul (coef (J.tail x) zero)) xzero) (mul-zero (coef (J.tail x) zero)))))
    (addZ z)) ;
 first : Id R (coef x (suc zero)) (neg o) =
  trans (sym (addZ (coef x (suc zero))))
   (trans (ap (add (coef x (suc zero))) (sym square-one))
    (trans (sym (coef-addP x (pmul x x) (suc zero))) (s.2.2.2.2.1 (suc zero) tt))) ;
 minus-one-square : Id R (mul (neg o) (neg o)) o =
  trans (neg-mul-left o (neg o)) (trans (ap neg (one-left (neg o))) (neg-neg o)) ;
 square-two : Id R (coef (pmul x x) two) o =
  trans (J.mul-next x x (suc zero))
   (trans (ap (\ t -> add t (coef (pmul (J.tail x) x) (suc zero)))
     (trans (ap (\ t -> mul t (coef x two)) xzero) (zero-mul (coef x two))))
    (trans (zl (coef (pmul (J.tail x) x) (suc zero)))
     (trans (J.mul-next (J.tail x) x zero)
      (trans (J.cg add _ _ _ _
        (trans (ap (\ t -> mul t (coef x (suc zero))) (J.tail-coef x zero))
         (trans (J.cg mul _ _ _ _ first first) minus-one-square))
        (trans (coef0-pmul (J.tail (J.tail x)) x)
         (trans (ap (mul (coef (J.tail (J.tail x)) zero)) xzero) (mul-zero (coef (J.tail (J.tail x)) zero)))))
       (addZ o))))) ;
 second : Id R (coef x two) (neg o) =
  neg-uniq o (coef x two)
   (trans (addC o (coef x two))
    (trans (ap (add (coef x two)) (sym square-two))
     (trans (sym (coef-addP x (pmul x x) two)) (s.2.2.2.2.1 two tt)))) ;
} ;
