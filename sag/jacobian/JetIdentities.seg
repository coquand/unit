-- (px*a+py*b)*q+p*(qx*a+qy*b) = (px*q+p*qx)*a+(py*q+p*qy)*b
module ProductDifferential (Rg : CRing) (v_p v_q v_px v_py v_qx v_qy v_a v_b : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_px Rg.z) v_px = (Rg.addZ v_px) ;
  step1 : Id Rg.R v_px (Rg.add v_px Rg.z) = (sym step0) ;
