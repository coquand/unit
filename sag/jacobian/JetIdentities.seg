  step10 : Id Rg.R (Rg.add (Rg.mul v_d v_u) (Rg.mul v_d Rg.z)) (Rg.add (Rg.mul v_d v_u) Rg.z) = (cong2 Rg.R Rg.add (Rg.mul v_d v_u) (Rg.mul v_d v_u) (Rg.mul v_d Rg.z) Rg.z (refl (Rg.mul v_d v_u)) step8) ;
  step11 : Id Rg.R (Rg.mul v_d (Rg.add v_u Rg.z)) (Rg.add (Rg.mul v_d v_u) Rg.z) = (trans step9 step10) ;
  step12 : Id Rg.R (Rg.mul Rg.z (Rg.add v_u Rg.z)) Rg.z = (RL[Rg].zero-mul (Rg.add v_u Rg.z)) ;
