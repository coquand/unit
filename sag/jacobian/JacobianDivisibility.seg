-- Step II: FU = GV implies merely (e,W) with J^e U = G W in A[X,Y].
-- Everything follows from the vanishing of U(x,y) in B = (A[X,Y]/G)[1/J]
-- (FromVanishing).  Two inputs give that vanishing:
--   result        stabilization of the F-annihilators in B (NoetherianInput);
--   result-coded  a noetherian presentation of B onto which every element
--                 merely lifts (CodedSubring.CodedNoetherian): along the
--                 coefficients w_n of the order-n lifts, u = f^n w_n and
--                 f^(n+1) w_n = 0, and noetherianity on this one sequence
--                 kills u (CodedSubring.Vanish).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (F G : Bivariate[l].Over[A].Expr) {
 module P = PolynomialIdentity[l].Over[A,setA] ;
 Rg : CRing = P.XY.ring ;
 f : Rg.R = P.formal F ; g : Rg.R = P.formal G ;
 j : Rg.R = P.Canon.jacobian P.x P.y F G ;
 module Q = PrincipalQuotient[l].Over[P.XY.ring,P.XY.set,g] ;
 module L = PowerLocalization[l].Over[Q.ring,Q.include j] ;
 B : CRing = L.ring ;
 phi : RingHom[l].Hom P.XY.ring L.ring = RingHom[l].compose P.XY.ring Q.ring L.ring L.inclusion Q.inclusion ;
 h : RingHom[l].Hom A L.ring = RingHom[l].compose A P.XY.ring L.ring phi P.inclusion ;
 module E = Bivariate[l].Over[A].In[L.ring,h] ;
 module NatMap = BivariateNaturality[l].Over[A,P.XY.ring,L.ring,P.inclusion,phi,P.x,P.y] ;
 module S = StableAnnihilator[l].Over[L.ring] ;
 module Pow = AffinePowers[l].Over[P.XY.ring] ;
 NoetherianInput : U l = (n : Nat) * S.Stable (phi.1 f) n ;
 CertificateFor (u : Rg.R) : U l = (e : Nat) * (w : Rg.R) * Id Rg.R (Rg.mul (Pow.power j e) u) (Rg.mul g w) ;
 gzero : Id B.R (E.val (phi.1 P.x) (phi.1 P.y) G) B.z =
  trans (sym (NatMap.value G))
   (trans (ap L.inclusion.1 Q.kills) (RingHom[l].zero Q.ring L.ring L.inclusion)) ;
 invertible : RL[L.ring].unit (E.jacobian (phi.1 P.x) (phi.1 P.y) F G) =
  subst (RL[L.ring].unit) (NatMap.jacobian F G) L.invertible ;
 module FromVanishing
  (vanish : (Ue Ve : Bivariate[l].Over[A].Expr) -> P.Relation F G Ue Ve ->
            Id B.R (E.val (phi.1 P.x) (phi.1 P.y) Ue) B.z) {
  module Relation (Ue Ve : Bivariate[l].Over[A].Expr) (rel : P.Relation F G Ue Ve) {
   localized-zero : Id B.R (phi.1 (P.formal Ue)) B.z = trans (NatMap.value Ue) (vanish Ue Ve rel) ;
   Certificate : U l = CertificateFor (P.formal Ue) ;
   module Clear (w : L.Killed (Q.include (P.formal Ue))) {
    a : Rg.R = Rg.mul (Pow.power j w.1) (P.formal Ue) ;
    quotient-zero : Id Q.Carrier (Q.include a) Q.zeroQ =
     trans (Q.inclusion.2.2.2 (Pow.power j w.1) (P.formal Ue))
      (trans (ap (\ t -> Q.mulQ t (Q.include (P.formal Ue)))
        (AffinePowers[l].power-map P.XY.ring Q.ring Q.inclusion j w.1)) w.2) ;
    result : Tr.Trunc[Certificate].carrier =
     Tr.Trunc[Q.Divides a].induction @l (\ v -> Tr.Trunc[Certificate].carrier) (\ v -> Tr.Trunc[Certificate].proposition)
      (\ v -> Tr.Trunc[Certificate].inc (w.1,v.1,v.2)) (Q.kernel a quotient-zero) ;
   } ;
   result : Tr.Trunc[Certificate].carrier =
    Tr.Trunc[L.Killed (Q.include (P.formal Ue))].induction @l
     (\ w -> Tr.Trunc[Certificate].carrier) (\ w -> Tr.Trunc[Certificate].proposition)
     (\ w -> Clear[w].result) (L.kernel (Q.include (P.formal Ue)) localized-zero) ;
  } ;
  module PolynomialRelation (u v : Rg.R) (rel : Id Rg.R (Rg.mul f u) (Rg.mul g v)) {
   module Rep = ExpressionRepresentation[l].Over[A,setA] ;
   module FromExpressions (ru : Rep.Rep u) (rv : Rep.Rep v) {
    expr-relation : P.Relation F G ru.1 rv.1 =
     trans (ap (Rg.mul f) ru.2) (trans rel (ap (Rg.mul g) (sym rv.2))) ;
    convert (w : CertificateFor (P.formal ru.1)) : CertificateFor u =
     (w.1,w.2.1,trans (ap (Rg.mul (Pow.power j w.1)) (sym ru.2)) w.2.2) ;
    result : Tr.Trunc[CertificateFor u].carrier =
     Tr.Trunc[CertificateFor (P.formal ru.1)].induction @l
      (\ w -> Tr.Trunc[CertificateFor u].carrier) (\ w -> Tr.Trunc[CertificateFor u].proposition)
      (\ w -> Tr.Trunc[CertificateFor u].inc (convert w)) (Relation[ru.1,rv.1,expr-relation].result) ;
   } ;
   result : Tr.Trunc[CertificateFor u].carrier =
    Tr.Trunc[Rep.Rep u].induction @l (\ ru -> Tr.Trunc[CertificateFor u].carrier) (\ ru -> Tr.Trunc[CertificateFor u].proposition)
     (\ ru -> Tr.Trunc[Rep.Rep v].induction @l (\ rv -> Tr.Trunc[CertificateFor u].carrier) (\ rv -> Tr.Trunc[CertificateFor u].proposition)
      (\ rv -> FromExpressions[ru,rv].result) (Rep.represent v)) (Rep.represent u) ;
  } ;
 } ;
 module WithStabilization (input : NoetherianInput) {
  stable : S.Stable (E.val (phi.1 P.x) (phi.1 P.y) F) input.1 =
   subst (\ a -> S.Stable a input.1) (NatMap.value F) input.2 ;
  vanish (Ue Ve : Bivariate[l].Over[A].Expr) (rel : P.Relation F G Ue Ve) :
   Id B.R (E.val (phi.1 P.x) (phi.1 P.y) Ue) B.z = RegularAt[l].Over[A,L.ring,setA,L.set,h,F,G,Ue,Ve,rel,phi.1 P.x,phi.1 P.y,gzero,invertible,input.1].C.result stable ;
  module V = FromVanishing[vanish] ;
 } ;
 result (input : Tr.Trunc[NoetherianInput].carrier) (u v : Rg.R)
  (rel : Id Rg.R (Rg.mul f u) (Rg.mul g v)) : Tr.Trunc[CertificateFor u].carrier =
  Tr.Trunc[NoetherianInput].induction @l (\ w -> Tr.Trunc[CertificateFor u].carrier)
   (\ w -> Tr.Trunc[CertificateFor u].proposition)
   (\ w -> WithStabilization[w].V.PolynomialRelation[u,v,rel].result) input ;

 fB : B.R = E.val (phi.1 P.x) (phi.1 P.y) F ;
 module WithCodes (input : CodedSubring[l].CodedNoetherian B) {
  module AtRelation (Ue Ve : Bivariate[l].Over[A].Expr) (rel : P.Relation F G Ue Ve) {
   u : B.R = E.val (phi.1 P.x) (phi.1 P.y) Ue ;
   w (n : Nat) : B.R = RegularAt[l].Over[A,L.ring,setA,L.set,h,F,G,Ue,Ve,rel,phi.1 P.x,phi.1 P.y,gzero,invertible,n].C.coefficient ;
   iterated (n : Nat) : Id B.R u (B.mul (S.power fB n) (w n)) = RegularAt[l].Over[A,L.ring,setA,L.set,h,F,G,Ue,Ve,rel,phi.1 P.x,phi.1 P.y,gzero,invertible,n].C.iterated ;
   killed (n : Nat) : Id B.R (B.mul (S.power fB (suc n)) (w n)) B.z = RegularAt[l].Over[A,L.ring,setA,L.set,h,F,G,Ue,Ve,rel,phi.1 P.x,phi.1 P.y,gzero,invertible,n].C.killed ;
   module Vn = CodedSubring[l].Vanish[B,L.set,input,fB,u,w,iterated,killed] ;
  } ;
  module V = FromVanishing[\ Ue Ve rel -> AtRelation[Ue,Ve,rel].Vn.vanish] ;
 } ;
 result-coded (input : CodedSubring[l].CodedNoetherian B) (u v : Rg.R)
  (rel : Id Rg.R (Rg.mul f u) (Rg.mul g v)) : Tr.Trunc[CertificateFor u].carrier =
  WithCodes[input].V.PolynomialRelation[u,v,rel].result ;
} ;
