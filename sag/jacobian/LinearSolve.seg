-- Inversion of a 2 by 2 matrix, using only the inverse of its determinant.
level l ; open Ring[l] ;
module Over (A : CRing) (a b c d : A.R)
 (invertible : RL[A].unit (A.add (A.mul a d) (A.neg (A.mul b c)))) (u v : A.R) {
 open A ; open RL[A] ;
 alpha : R = mul invertible.1 (add (mul d u) (neg (mul b v))) ;
 beta : R = mul invertible.1 (add (mul a v) (neg (mul c u))) ;
 first : Id R (add (mul a alpha) (mul b beta)) u =
  trans (JetIdentities[l].SolveFirst[A,a,b,c,d,invertible.1,u,v].proof)
   (trans (ap (\ t -> mul t u) invertible.2) (one-left u)) ;
 second : Id R (add (mul c alpha) (mul d beta)) v =
  trans (JetIdentities[l].SolveSecond[A,a,b,c,d,invertible.1,u,v].proof)
   (trans (ap (\ t -> mul t v) invertible.2) (one-left v)) ;
} ;
