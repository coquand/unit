-- The syzygy hypothesis is an equality in the existing actual ring A[X][Y].
-- This file transports it to coefficient lists over any target A-algebra.
level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module T = Bivariate[l].Over[A] ; open T ;
 module X = PolynomialRing[l].Extension[A,setA] ;
 module XY = PolynomialRing[l].Extension[X.ring,X.set] ;
 module H = RingHom[l] ;
 inclusion : H.Hom A XY.ring = H.compose A X.ring XY.ring XY.inclusion X.inclusion ;
 x : XY.Carrier = XY.constant X.variable ; y : XY.Carrier = XY.variable ;
 module Canon = T.In[XY.ring,inclusion] ;
 formal (e : Expr) : XY.Carrier = Canon.val x y e ;
 Relation (F G Ue Ve : Expr) : U l = Id XY.Carrier (formal (mulE F Ue)) (formal (mulE G Ve)) ;
 module Into (B : CRing) (setB : Prelude[l].isSet B.R) (h : H.Hom A B) (bx by : B.R) {
  module EX = Universal[l].Property[A,B,setA,setB].Given[h,bx] ;
  module EY = Universal[l].Property[X.ring,B,X.set,setB].Given[EX.extend,by] ;
  module E = T.In[B,h] ; module J = FiniteJets[l].Over[B] ;
  natural : (e : Expr) -> Id B.R (EY.extend.1 (formal e)) (E.val bx by e) = split {
   xE -> trans (EY.on-constants X.variable) EX.on-variable ;
   yE -> EY.on-variable ;
   cE a -> trans (EY.on-constants (X.constant a)) (EX.on-constants a) ;
   addE p q | hp hq -> trans (EY.extend.2.2.1 (formal p) (formal q)) (J.cg B.add _ _ _ _ hp hq) ;
   mulE p q | hp hq -> trans (EY.extend.2.2.2 (formal p) (formal q)) (J.cg B.mul _ _ _ _ hp hq) } ;
  relation (F G Ue Ve : Expr) (r : Relation F G Ue Ve) :
   Id B.R (B.mul (E.val bx by F) (E.val bx by Ue)) (B.mul (E.val bx by G) (E.val bx by Ve)) =
   trans (sym (natural (mulE F Ue))) (trans (ap EY.extend.1 r) (natural (mulE G Ve))) ;
 } ;
 module RawInto (B : CRing) (setB : Prelude[l].isSet B.R) (h : H.Hom A B) {
  module E = T.In[B,h] ; module BT = PolynomialRing[l].Extension[B,setB] ;
  module Raw = Poly[l].PolyR[B] ; module M = Mul[l].MulR[B] ;
  hT : H.Hom A BT.ring = H.compose A B BT.ring BT.inclusion h ;
  module ET = T.In[BT.ring,hT] ;
  sound (p q : Raw.P) : (e : Expr) ->
   Id BT.Carrier (ET.val (BT.include p) (BT.include q) e) (BT.include (E.raw p q e)) = split {
   xE -> refl (BT.include p) ; yE -> refl (BT.include q) ; cE a -> refl (BT.constant (h.1 a)) ;
   addE e d | he hd -> trans (Presentations[l].cong2 BT.Carrier BT.addQ _ _ _ _ he hd)
    (BT.Add.beta (E.raw p q e) (E.raw p q d)) ;
   mulE e d | he hd -> trans (Presentations[l].cong2 BT.Carrier BT.mulQ _ _ _ _ he hd)
    (BT.Multiply.beta (E.raw p q e) (E.raw p q d)) } ;
  relation (F G Ue Ve : Expr) (r : Relation F G Ue Ve) (p q : Raw.P) :
   Raw.peq (M.pmul (E.raw p q F) (E.raw p q Ue)) (M.pmul (E.raw p q G) (E.raw p q Ve)) =
   BT.Q.effective _ _
    (trans (sym (sound p q (mulE F Ue)))
     (trans (Into[BT.ring,BT.set,hT,BT.include p,BT.include q].relation F G Ue Ve r)
      (sound p q (mulE G Ve)))) ;
 } ;
} ;
