-- A principal quotient of a presented algebra has the presentation
-- obtained by adding the chosen equation.  This identifies the explicit
-- quotient used for flat base change with the polynomial-equation API.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module E = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module G = Generated[l].Over[R,setR] ;
 base-solution : P.Solutions (zero,nil) C.base = (\ v -> efq v,tt) ;
 module BaseTo (B : C.Algebra) {
  extend (s : P.Solutions (zero,nil) B) : C.Hom C.base B = (B.iota,\ r -> refl (B.iota.1 r)) ;
  forward : C.Hom C.base B -> P.Solutions (zero,nil) B = P.canonical (zero,nil) C.base base-solution B ;
  fb (s : P.Solutions (zero,nil) B) : Id (P.Solutions (zero,nil) B) (forward (extend s)) s =
   P.solutions-ext (zero,nil) B _ _ (\ v -> efq v) ;
  bf (f : C.Hom C.base B) : Id (C.Hom C.base B) (extend (forward f)) f =
   C.ext C.base B _ _ (\ r -> sym (f.2 r)) ;
  universal : Pr.isEquiv (C.Hom C.base B) (P.Solutions (zero,nil) B) forward =
   Pr.qinv _ _ forward extend fb bf ;
 } ;
 base-presentation : P.Presents (zero,nil) C.base = (base-solution,\ B -> BaseTo[B].universal) ;
 module At (n : Nat) (es : P.Equations (Fin n)) (A : C.Algebra) (pa : P.Presents (n,es) A)
  (e : P.Expr (Fin n)) {
  q : A.ring.R = P.eval (Fin n) A pa.1.1 e ;
  module Q = FlatPrincipalQuotient[l].Over[A.ring,q] ;
  algebra : C.Algebra = C.mkAlgebra Q.Q.ring Q.Q.set (H.compose R A.ring Q.Q.ring Q.Q.projection A.iota) ;
  projection : C.Hom A algebra = (Q.Q.projection,\ r -> refl (Q.Q.include (A.iota.1 r))) ;
  gens (v : Fin n) : Q.Q.Carrier = Q.Q.include (pa.1.1 v) ;
  root : Id Q.Q.Carrier (P.eval (Fin n) algebra gens e) Q.Q.zeroQ =
   trans (sym (P.natural (Fin n) A algebra projection pa.1.1 e)) Q.root ;
  solution : P.Solutions (n,cons e es) algebra =
   (gens,root,P.zeros-natural (Fin n) A algebra projection pa.1.1 es pa.1.2) ;
  module To (B : C.Algebra) {
   module AtSolution (s : P.Solutions (n,cons e es) B) {
    old-solution : P.Solutions (n,es) B = (s.1,s.2.2) ;
    old-map : C.Hom A B = (pa.2 B).sec old-solution ;
    old-gen (v : Fin n) : Id B.ring.R (old-map.1.1 (pa.1.1 v)) (s.1 v) =
     ap (\ t -> t.1 v) ((pa.2 B).sec-eq old-solution) ;
    killed : Id B.ring.R (old-map.1.1 q) B.ring.z =
     trans (P.natural (Fin n) A B old-map pa.1.1 e)
      (trans (G.eval-ext (Fin n) B (\ v -> old-map.1.1 (pa.1.1 v)) s.1 old-gen e) s.2.1) ;
    module Into = Q.Into[B.ring,B.set,old-map.1,killed] ;
    hom : C.Hom algebra B = (Into.hom,\ r -> trans (Into.beta (A.iota.1 r)) (old-map.2 r)) ;
    on-gen (v : Fin n) : Id B.ring.R (hom.1.1 (gens v)) (s.1 v) =
     trans (Into.beta (pa.1.1 v)) (old-gen v) ;
   } ;
   extend (s : P.Solutions (n,cons e es) B) : C.Hom algebra B = AtSolution[s].hom ;
   forward : C.Hom algebra B -> P.Solutions (n,cons e es) B = P.canonical (n,cons e es) algebra solution B ;
   fb (s : P.Solutions (n,cons e es) B) : Id (P.Solutions (n,cons e es) B) (forward (extend s)) s =
    P.solutions-ext (n,cons e es) B _ _ AtSolution[s].on-gen ;
   module Recover (f : C.Hom algebra B) {
    module K = AtSolution[forward f] ;
    old : C.Hom A B = C.compose A algebra B f projection ;
    old-equal : Id (C.Hom A B) K.old-map old =
     E.injective (C.Hom A B) (P.Solutions (n,es) B) (P.canonical (n,es) A pa.1 B) (pa.2 B) _ _
      (P.solutions-ext (n,es) B _ _ K.old-gen) ;
    pointwise : (x : Q.Q.Carrier) -> Id B.ring.R ((extend (forward f)).1.1 x) (f.1.1 x) =
     Q.Q.Q.induction @l (\ x -> Id B.ring.R ((extend (forward f)).1.1 x) (f.1.1 x)) (\ x -> B.set _ _)
      (\ a -> trans (K.Into.beta a) (ap (\ h -> h.1.1 a) old-equal)) ;
   } ;
   bf (f : C.Hom algebra B) : Id (C.Hom algebra B) (extend (forward f)) f =
    C.ext algebra B _ _ Recover[f].pointwise ;
   universal : Pr.isEquiv (C.Hom algebra B) (P.Solutions (n,cons e es) B) forward =
    Pr.qinv _ _ forward extend fb bf ;
  } ;
  presentation : P.Presents (n,cons e es) algebra = (solution,\ B -> To[B].universal) ;
 } ;
} ;
