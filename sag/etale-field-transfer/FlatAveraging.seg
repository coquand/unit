-- Averaging gives a linear section of mu.  The certificate equalizes
-- every source element, so neither a standard presentation nor a field
-- hypothesis occurs in this argument.  Apply the checked flat retraction.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (S T D : CRing) (u : H.Hom S T) (left : H.Hom S D) (right : H.Hom T D)
 (mu : H.Hom D T) (ret : (t : T.R) -> Id T.R (mu.1 (right.1 t)) t)
 (e : D.R) (me : Id T.R (mu.1 e) T.o)
 (equalizes : (s : S.R) -> Id D.R (D.mul e (left.1 s)) (D.mul e (right.1 (u.1 s))))
 (flat : FlatRelations[l].Over[S,D,left].Flat) {
 module LD = RL[D] ; module LT = RL[T] ;
 averaged (d : D.R) : Id T.R (mu.1 (D.mul e d)) (mu.1 d) =
  trans (mu.2.2.2 e d) (trans (ap (\ x -> T.mul x (mu.1 d)) me) (LT.one-left (mu.1 d))) ;
 over (s : S.R) : Id T.R (mu.1 (left.1 s)) (u.1 s) =
  trans (sym (averaged (left.1 s)))
   (trans (ap mu.1 (equalizes s)) (trans (averaged (right.1 (u.1 s))) (ret (u.1 s)))) ;
 section (t : T.R) : D.R = D.mul e (right.1 t) ;
 section-zero : Id D.R (section T.z) D.z =
  trans (ap (D.mul e) (H.zero T D right)) (LD.mul-zero e) ;
 section-add (t v : T.R) : Id D.R (section (T.add t v)) (D.add (section t) (section v)) =
  trans (ap (D.mul e) (right.2.2.1 t v)) (D.dist e (right.1 t) (right.1 v)) ;
 section-scale (s : S.R) (t : T.R) :
  Id D.R (section (T.mul (u.1 s) t)) (D.mul (left.1 s) (section t)) =
  trans (ap (D.mul e) (right.2.2.2 (u.1 s) t))
   (trans (D.mulA e (right.1 (u.1 s)) (right.1 t))
    (trans (ap (\ x -> D.mul x (right.1 t)) (sym (equalizes s)))
     (trans (sym (D.mulA e (left.1 s) (right.1 t))) (LD.mul-swap e (left.1 s) (right.1 t))))) ;
 section-law (t : T.R) : Id T.R (mu.1 (section t)) t = trans (averaged (right.1 t)) (ret t) ;
 module Transfer = FlatRetraction[l].Over[S,D,T,left,u,mu,over,
  section,section-zero,section-add,section-scale,section-law,flat] ;
 theorem : FlatRelations[l].Over[S,T,u].Flat = Transfer.theorem ;
} ;
