-- Regression 1 uses the empty presentation and an arbitrary target.
-- Regression 2 reruns the constructed Z/4Z, X^2-X example through the
-- new general theorem; its old standard-transfer proof is not used.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module EmptyPresentation (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module E = FormallyEtale[l].Over[R,setR] ;
 fp : P.FP C.base = Truncation[l+].Trunc[P.Witness C.base].inc
  ((zero,nil),FlatQuotientPresentation[l].Over[R,setR].base-presentation) ;
 unique : E.Unique C.base = \ B N f g h -> C.ext C.base B f g
  (\ r -> trans (f.2 r) (sym (g.2 r))) ;
 module At (T : C.Algebra) (flat : FlatRelations[l].Over[R,T.ring,T.iota].Flat) {
  u : C.Hom C.base T = (T.iota,\ r -> refl (T.iota.1 r)) ;
  theorem : FlatRelations[l].Over[R,T.ring,T.iota].Flat =
   FlatDiagonalTransfer[l].Over[R,setR].At[C.base,T,u,fp,unique,flat].theorem ;
 } ;
} ;
module NR = FlatRegression[l] ;
module Nonreduced (rq : NR.Reps.Representation NR.q) (rg : NR.Reps.Representation NR.Pt.g) {
 module Old = NR.Test[rq,rg] ;
 module P = Presentations[l].Over[NR.A,ZMod4[l].set] ;
 fp : P.FP Old.S = Truncation[l+].Trunc[P.Witness Old.S].inc (Old.SA.Loc.pres,Old.SA.Loc.K.presentation) ;
 unique : NR.E.Unique Old.S = StandardEtaleLift[l].Over[NR.A,ZMod4[l].set].At[NR.q,NR.P.oneQ,Old.S,Old.SA.standard].unique ;
 flat : FlatRelations[l].Over[Old.S.ring,NR.A,Old.u.1].Flat =
  FlatDiagonalTransfer[l].Over[NR.A,ZMod4[l].set].At[Old.S,NR.C.base,Old.u,fp,unique,FlatRelations[l].Self[NR.A].flat].theorem ;
 module Kernel = FlatQuotient[l].Over[Old.S.ring,NR.A,Old.u.1,Old.onto,flat] ;
 kernel : Tr.Trunc[Kernel.Witness Old.x].carrier = Kernel.theorem Old.x Old.ux ;
 result : NR.Result = (Old.S,Old.SA.standard,Old.etale,Old.u,flat,Old.x,Old.ux,Old.nonzero,kernel) ;
} ;
from-q (rq : NR.Reps.Representation NR.q) : Truncation[l+].Trunc[NR.Result].carrier =
 Tr.Trunc[NR.Reps.Representation NR.Pt.g].induction @(l+) (\ w -> Truncation[l+].Trunc[NR.Result].carrier)
  (\ w -> Truncation[l+].Trunc[NR.Result].proposition)
  (\ rg -> Truncation[l+].Trunc[NR.Result].inc Nonreduced[rq,rg].result) (NR.Reps.representation NR.Pt.g) ;
nonreduced : Truncation[l+].Trunc[NR.Result].carrier =
 Tr.Trunc[NR.Reps.Representation NR.q].induction @(l+) (\ w -> Truncation[l+].Trunc[NR.Result].carrier)
  (\ w -> Truncation[l+].Trunc[NR.Result].proposition) from-q (NR.Reps.representation NR.q) ;
