-- General transfer: a finitely presented formally unramified R-algebra
-- S transfers R-flatness to S-flatness along every S -> T.  Construct a
-- flat extension from the presentation, map the diagonal certificate
-- into it, and average.  T need not be finitely presented.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module Tn = Tensor[l].Over[R,setR] ;
 module FromCertificate (S D T : C.Algebra) (cp : Tn.Coproduct S S D)
  (cert : DiagonalCertificate[l].Over[R,setR].At[S,D,cp].Witness)
  (u : C.Hom S T) (co : FlatCocone[l].Over[R,setR,T].Cocone[S]) {
  module DK = DiagonalKernel[l].Over[R,setR].At[S,D,cp] ;
  pair : C.Hom S co.algebra * C.Hom S co.algebra =
   (co.left,C.compose S T co.algebra co.right u) ;
  image : C.Hom D co.algebra = (cp.2.2 co.algebra).sec pair ;
  image-left (s : S.ring.R) : Id co.algebra.ring.R (image.1.1 (DK.left.1.1 s)) (co.left.1.1 s) =
   ap (\ f -> f.1.1.1 s) ((cp.2.2 co.algebra).sec-eq pair) ;
  image-right (s : S.ring.R) : Id co.algebra.ring.R (image.1.1 (DK.right.1.1 s)) (co.right.1.1 (u.1.1 s)) =
   ap (\ f -> f.2.1.1 s) ((cp.2.2 co.algebra).sec-eq pair) ;
  mu : C.Hom co.algebra T = co.extend T u (C.identity T) ;
  mu-left (s : S.ring.R) : Id T.ring.R (mu.1.1 (co.left.1.1 s)) (u.1.1 s) =
   co.beta-left T u (C.identity T) s ;
  mu-right (t : T.ring.R) : Id T.ring.R (mu.1.1 (co.right.1.1 t)) t =
   co.beta-right T u (C.identity T) t ;
  comparison : Id (C.Hom D T) (C.compose D co.algebra T mu image) (C.compose D S T u DK.mu) =
   DK.hom-ext T (C.compose D co.algebra T mu image) (C.compose D S T u DK.mu)
    (\ s -> trans (ap mu.1.1 (image-left s)) (trans (mu-left s) (sym (ap u.1.1 (DK.mu-left s)))))
    (\ s -> trans (ap mu.1.1 (image-right s)) (trans (mu-right (u.1.1 s)) (sym (ap u.1.1 (DK.mu-right s))))) ;
  epsilon : co.algebra.ring.R = image.1.1 cert.epsilon ;
  mu-one : Id T.ring.R (mu.1.1 epsilon) T.ring.o =
   trans (ap (\ f -> f.1.1 cert.epsilon) comparison) (trans (ap u.1.1 cert.mu-one) u.1.2.1) ;
  equalises (s : S.ring.R) :
   Id co.algebra.ring.R (co.algebra.ring.mul epsilon (co.left.1.1 s))
    (co.algebra.ring.mul epsilon (co.right.1.1 (u.1.1 s))) =
   trans (ap (co.algebra.ring.mul epsilon) (sym (image-left s)))
    (trans (sym (image.1.2.2.2 cert.epsilon (DK.left.1.1 s)))
     (trans (ap image.1.1 (cert.equalises s))
      (trans (image.1.2.2.2 cert.epsilon (DK.right.1.1 s))
       (ap (co.algebra.ring.mul epsilon) (image-right s))))) ;
  module Average = FlatAveraging[l].Over[S.ring,T.ring,co.algebra.ring,u.1,co.left.1,co.right.1,
   mu.1,mu-right,epsilon,mu-one,equalises,co.flat] ;
  theorem : FlatRelations[l].Over[S.ring,T.ring,u.1].Flat = Average.theorem ;
 } ;
 module Presented (p : P.Presentation) (S : C.Algebra) (ps : P.Presents p S)
  (T : C.Algebra) (u : C.Hom S T) (unique : FE.Unique S)
  (flat : FlatRelations[l].Over[R,T.ring,T.iota].Flat) {
  module Dia = DiagonalCertificate[l].Over[R,setR].Concrete[p,S,ps,unique] ;
  module Co = FlatPresentedCocone[l].Over[R,setR,T,flat].At[p,S,ps] ;
  module ST = FlatRelations[l].Over[S.ring,T.ring,u.1] ;
  theorem : ST.Flat = \ n a b relation ->
   TC.bind Dia.Diag.Witness (ST.Explanation[n,a,b])
    (\ cert -> FromCertificate[S,Dia.T.T,T,Dia.T.coproduct,cert,u,Co.result].theorem n a b relation)
    Dia.theorem ;
 } ;
 module At (S T : C.Algebra) (u : C.Hom S T) (fp : P.FP S) (unique : FE.Unique S)
  (flat : FlatRelations[l].Over[R,T.ring,T.iota].Flat) {
  module ST = FlatRelations[l].Over[S.ring,T.ring,u.1] ;
  theorem : ST.Flat = \ n a b relation ->
   Truncation[l+].Trunc[P.Witness S].induction @l (\ w -> ST.Explained n a b)
    (\ w -> Tr.Trunc[ST.Explanation[n,a,b]].proposition)
    (\ w -> Presented[w.1,S,w.2,T,u,unique,flat].theorem n a b relation) fp ;
 } ;
} ;
