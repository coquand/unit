-- A flat scalar extension with the existence and beta laws of the
-- coproduct.  Uniqueness is unnecessary for averaging.  Polynomial
-- extension and a simultaneous principal quotient preserve this data.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (T : Algebras[l].Over[R,setR].Algebra) {
 module C = Algebras[l].Over[R,setR] ;
 record Cocone (S : C.Algebra) {
  algebra : C.Algebra ;
  left : C.Hom S algebra ;
  right : C.Hom T algebra ;
  extend (B : C.Algebra) (f : C.Hom S B) (g : C.Hom T B) : C.Hom algebra B ;
  beta-left (B : C.Algebra) (f : C.Hom S B) (g : C.Hom T B) (s : S.ring.R) :
   Id B.ring.R ((extend B f g).1.1 (left.1.1 s)) (f.1.1 s) ;
  beta-right (B : C.Algebra) (f : C.Hom S B) (g : C.Hom T B) (t : T.ring.R) :
   Id B.ring.R ((extend B f g).1.1 (right.1.1 t)) (g.1.1 t) ;
  flat : FlatRelations[l].Over[S.ring,algebra.ring,left.1].Flat ;
 } ;
 start (flat : FlatRelations[l].Over[R,T.ring,T.iota].Flat) : Cocone[C.base] =
  new Cocone[C.base,T,(T.iota,\ r -> refl (T.iota.1 r)),C.identity T,
   \ B f g -> g,\ B f g r -> trans (g.2 r) (sym (f.2 r)),\ B f g t -> refl (g.1.1 t),flat] ;
 module Polynomial (S : C.Algebra) (c : Cocone[S]) {
  module SX = C.Polynomial[S] ; module DX = C.Polynomial[c.algebra] ;
  module M = FlatPolynomialData[l].Map[S.ring,c.algebra.ring,S.set,c.algebra.set,c.left.1] ;
  left : C.Hom SX.algebra DX.algebra =
   (M.f,\ r -> trans (M.UP.on-constants (S.iota.1 r)) (ap DX.X.constant (c.left.2 r))) ;
  right : C.Hom T DX.algebra = C.compose T c.algebra DX.algebra DX.inclusion c.right ;
  module To (B : C.Algebra) (f : C.Hom SX.algebra B) (g : C.Hom T B) {
   old : C.Hom S B = C.compose S SX.algebra B f SX.inclusion ;
   old-map : C.Hom c.algebra B = c.extend B old g ;
   module UQ = Universal[l].Property[c.algebra.ring,B.ring,c.algebra.set,B.set].Given[old-map.1,f.1.1 SX.X.variable] ;
   hom : C.Hom DX.algebra B =
    (UQ.extend,\ r -> trans (UQ.on-constants (c.algebra.iota.1 r)) (old-map.2 r)) ;
   composite : H.Hom SX.X.ring B.ring = H.compose SX.X.ring DX.X.ring B.ring hom.1 left.1 ;
   module UP = Universal[l].Property[S.ring,B.ring,S.set,B.set].Given[old.1,f.1.1 SX.X.variable] ;
   constants (s : S.ring.R) : Id B.ring.R (composite.1 (SX.X.constant s)) (old.1.1 s) =
    trans (ap hom.1.1 (M.UP.on-constants s))
     (trans (UQ.on-constants (c.left.1.1 s)) (c.beta-left B old g s)) ;
   variable : Id B.ring.R (composite.1 SX.X.variable) (f.1.1 SX.X.variable) =
    trans (ap hom.1.1 M.UP.on-variable) UQ.on-variable ;
   compare : Id (H.Hom SX.X.ring B.ring) composite f.1 =
    trans (UP.unique composite constants variable)
     (sym (UP.unique f.1 (\ s -> refl (f.1.1 (SX.X.constant s))) (refl (f.1.1 SX.X.variable)))) ;
   beta-left (s : SX.X.Carrier) : Id B.ring.R (hom.1.1 (left.1.1 s)) (f.1.1 s) =
    ap (\ h -> h.1 s) compare ;
   beta-right (t : T.ring.R) : Id B.ring.R (hom.1.1 (right.1.1 t)) (g.1.1 t) =
    trans (UQ.on-constants (c.right.1.1 t)) (c.beta-right B old g t) ;
  } ;
  module Flat = FlatPolynomialBaseChange[l].Over[S.ring,c.algebra.ring,S.set,c.algebra.set,c.left.1,c.flat] ;
  result : Cocone[SX.algebra] = new Cocone[SX.algebra,DX.algebra,left,right,
   \ B f g -> To[B,f,g].hom,\ B f g -> To[B,f,g].beta-left,\ B f g -> To[B,f,g].beta-right,Flat.theorem] ;
 } ;
 module Principal (S : C.Algebra) (c : Cocone[S]) (q : S.ring.R) {
  module Ch = FlatPrincipalQuotient[l].Change[S.ring,c.algebra.ring,c.left.1,q] ;
  module SQ = Ch.Source ; module DQ = Ch.Target ;
  source : C.Algebra = C.mkAlgebra SQ.Q.ring SQ.Q.set (H.compose R S.ring SQ.Q.ring SQ.Q.projection S.iota) ;
  source-map : C.Hom S source = (SQ.Q.projection,\ r -> refl (SQ.Q.include (S.iota.1 r))) ;
  algebra : C.Algebra = C.mkAlgebra DQ.Q.ring DQ.Q.set
   (H.compose R c.algebra.ring DQ.Q.ring DQ.Q.projection c.algebra.iota) ;
  left : C.Hom source algebra =
   (Ch.map,\ r -> trans (Ch.Induced.beta (S.iota.1 r)) (ap DQ.Q.include (c.left.2 r))) ;
  projection : C.Hom c.algebra algebra = (DQ.Q.projection,\ r -> refl (DQ.Q.include (c.algebra.iota.1 r))) ;
  right : C.Hom T algebra = C.compose T c.algebra algebra projection c.right ;
  module To (B : C.Algebra) (f : C.Hom source B) (g : C.Hom T B) {
   old : C.Hom S B = C.compose S source B f source-map ;
   old-map : C.Hom c.algebra B = c.extend B old g ;
   root : Id B.ring.R (old-map.1.1 (c.left.1.1 q)) B.ring.z =
    trans (c.beta-left B old g q) (trans (ap f.1.1 SQ.root) (H.zero source.ring B.ring f.1)) ;
   module Into = DQ.Into[B.ring,B.set,old-map.1,root] ;
   hom : C.Hom algebra B =
    (Into.hom,\ r -> trans (Into.beta (c.algebra.iota.1 r)) (old-map.2 r)) ;
   beta-left : (s : source.ring.R) -> Id B.ring.R (hom.1.1 (left.1.1 s)) (f.1.1 s) =
    SQ.Q.Q.induction @l (\ s -> Id B.ring.R (hom.1.1 (left.1.1 s)) (f.1.1 s)) (\ s -> B.set _ _)
     (\ s -> trans (ap hom.1.1 (Ch.Induced.beta s))
      (trans (Into.beta (c.left.1.1 s)) (c.beta-left B old g s))) ;
   beta-right (t : T.ring.R) : Id B.ring.R (hom.1.1 (right.1.1 t)) (g.1.1 t) =
    trans (Into.beta (c.right.1.1 t)) (c.beta-right B old g t) ;
  } ;
  result : Cocone[source] = new Cocone[source,algebra,left,right,
   \ B f g -> To[B,f,g].hom,\ B f g -> To[B,f,g].beta-left,\ B f g -> To[B,f,g].beta-right,Ch.Flat[c.flat].theorem] ;
 } ;
} ;
