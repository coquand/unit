-- Generated.seg: adjoining finitely many elements.
--
-- From a noetherian presented subring P of S and elements x_1, .., x_n of
-- S, iterating the Hilbert basis theorem presents the subring generated by
-- P and the x_i, and it is noetherian.  With P the image of a discrete
-- field or of any noetherian ring under a ring map (Transfer), this covers
-- k[x_1, .., x_n] and all its quotients, and localisations (x = 1/s).
--
-- What noetherianity gives (ascending): along any sequence of codes, some
-- element is a combination of the earlier ones.
level l ; open Ring[l] ; open Bar[l] ;

module Over (S : CRing) (P : Span[l].Pres[S]) (n0 : Span[l].Over[S,P].Noeth) {
  gen : List S.R -> Span[l].Pres[S] = split {
    nil -> P ;
    cons x xs | r -> PolyPres[l].Over[S,r,x].pres } ;

  noeth : (xs : List S.R) -> Span[l].Over[S,gen xs].Noeth = split {
    nil -> n0 ;
    cons x xs | r -> Hilbert[l].Over[S,gen xs,x].hilbert r } ;

  -- a code one level up, the codes of the base, the adjoined element
  up (x : S.R) (xs : List S.R) (c : (gen xs).K) : (gen (cons x xs)).K = cons c nil ;
  up-phi (x : S.R) (xs : List S.R) (c : (gen xs).K) :
    Id S.R ((gen (cons x xs)).phi (up x xs c)) ((gen xs).phi c) =
    trans (S.addZ (S.mul ((gen xs).phi c) S.o)) (S.mulO ((gen xs).phi c)) ;

  base : (xs : List S.R) -> P.K -> (gen xs).K = split {
    nil -> \ c -> c ;
    cons x xs | r -> \ c -> up x xs (r c) } ;
  base-phi : (xs : List S.R) (c : P.K) -> Id S.R ((gen xs).phi (base xs c)) (P.phi c) = split {
    nil -> \ c -> refl (P.phi c) ;
    cons x xs | r -> \ c -> trans (up-phi x xs (base xs c)) (r c) } ;

  var (x : S.R) (xs : List S.R) : (gen (cons x xs)).K = cons (gen xs).ko (cons (gen xs).kz nil) ;
  var-phi (x : S.R) (xs : List S.R) : Id S.R ((gen (cons x xs)).phi (var x xs)) x =
    calc S.R { S.add (S.mul ((gen xs).phi (gen xs).ko) (S.mul x S.o))
                     (S.add (S.mul ((gen xs).phi (gen xs).kz) S.o) S.z)
                 =< ap (\ t -> S.add (S.mul t (S.mul x S.o)) (S.add (S.mul ((gen xs).phi (gen xs).kz) S.o) S.z))
                       (gen xs).phi-o
                 > S.add (S.mul S.o (S.mul x S.o)) (S.add (S.mul ((gen xs).phi (gen xs).kz) S.o) S.z)
                 =< ap (\ t -> S.add (S.mul S.o (S.mul x S.o)) (S.add (S.mul t S.o) S.z)) (gen xs).phi-z
                 > S.add (S.mul S.o (S.mul x S.o)) (S.add (S.mul S.z S.o) S.z)
                 =< ap (S.add (S.mul S.o (S.mul x S.o))) (trans (S.addZ (S.mul S.z S.o)) (S.mulO S.z))
                 > S.add (S.mul S.o (S.mul x S.o)) S.z
                 =< S.addZ (S.mul S.o (S.mul x S.o)) > S.mul S.o (S.mul x S.o)
                 =< RL[S].one-left (S.mul x S.o) > S.mul x S.o
                 =< S.mulO x > x } ;

  ascending (xs : List S.R) (c : Nat -> (gen xs).K) :
    (m : Nat) * Span[l].Over[S,gen xs].Good (Span[l].Over[S,gen xs].G.init c m) =
    Span[l].Over[S,gen xs].G.eventually c (noeth xs) ;
} ;
