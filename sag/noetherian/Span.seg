-- Span.seg: presented subrings, linear combinations, good lists and
-- noetherianity.
--
-- A presentation of a subring of S is a type K of codes with a map phi to
-- S that preserves the ring operations; no law is asked of K.  Elements of
-- quotients and localisations need not have chosen representatives; codes
-- are the representatives a proof uses.  Coefficients of linear
-- combinations are codes as well.
--
-- In s y: y is a combination of the phi t, t in s, with coefficients in K.
-- Good s (Coquand-Persson 3.1): some element of s is a combination of the
-- elements before it.  Noeth: Good bars the empty list.
--
-- Two facts about Good, both by induction on the newer part p of a list
-- p ++ s (Coquand-Persson Lemma 7 and Lemma 13):
--   good-ins: inserting g between p and s keeps Good;
--   good-rep: replacing a by a' in p ++ a.s, with a' - a in the span of s,
--             keeps Good, because the spans of the initial segments agree.
-- The same tree then witnesses the bar after the change (bars-ins,
-- bars-rep).
level l ; open Ring[l] ; open Bar[l] ;

record Pres (S : CRing) {
  K : U l ;
  phi : K -> S.R ;
  kz : K ;
  ko : K ;
  kadd : K -> K -> K ;
  kmul : K -> K -> K ;
  kneg : K -> K ;
  phi-z : Id S.R (phi kz) S.z ;
  phi-o : Id S.R (phi ko) S.o ;
  phi-add (x y : K) : Id S.R (phi (kadd x y)) (S.add (phi x) (phi y)) ;
  phi-mul (x y : K) : Id S.R (phi (kmul x y)) (S.mul (phi x) (phi y)) ;
  phi-neg (x : K) : Id S.R (phi (kneg x)) (S.neg (phi x)) ;
} ;

module Over (S : CRing) (P : Pres[S]) {
  open S ; open RL[S] ; open P ;

  ------------------------------------------------------------------------
  -- ring identities used below

  drop-kz (y w : R) : Id R (add y (neg (mul (phi kz) w))) y =
    calc R { add y (neg (mul (phi kz) w))
               =< ap (\ t -> add y (neg (mul t w))) phi-z > add y (neg (mul z w))
               =< ap (\ t -> add y (neg t)) (zero-mul w) > add y (neg z)
               =< ap (add y) neg-zero > add y z
               =< addZ y > y } ;

  gen-step (w : R) : Id R (add w (neg (mul (phi ko) w))) z =
    calc R { add w (neg (mul (phi ko) w))
               =< ap (\ t -> add w (neg (mul t w))) phi-o > add w (neg (mul o w))
               =< ap (\ t -> add w (neg t)) (one-left w) > add w (neg w)
               =< addN w > z } ;

  sub-add (y u : R) : Id R (add (add y (neg u)) u) y =
    calc R { add (add y (neg u)) u =< sym (addA y (neg u) u) > add y (add (neg u) u)
               =< ap (add y) (neg-cancel u) > add y z
               =< addZ y > y } ;

  add-step (y y' u u' v w : R) (e : Id R v (add u u')) :
    Id R (add (add y (neg (mul u w))) (add y' (neg (mul u' w)))) (add (add y y') (neg (mul v w))) =
    calc R { add (add y (neg (mul u w))) (add y' (neg (mul u' w)))
               =< swap y (neg (mul u w)) y' (neg (mul u' w))
               > add (add y y') (add (neg (mul u w)) (neg (mul u' w)))
               =< ap (add (add y y')) (sym (neg-add (mul u w) (mul u' w)))
               > add (add y y') (neg (add (mul u w) (mul u' w)))
               =< ap (\ t -> add (add y y') (neg t)) (sym (dist-left u u' w))
               > add (add y y') (neg (mul (add u u') w))
               =< ap (\ t -> add (add y y') (neg (mul t w))) (sym e) > add (add y y') (neg (mul v w)) } ;

  scale-step (a y u v w : R) (e : Id R v (mul a u)) :
    Id R (mul a (add y (neg (mul u w)))) (add (mul a y) (neg (mul v w))) =
    calc R { mul a (add y (neg (mul u w))) =< dist a y (neg (mul u w)) > add (mul a y) (mul a (neg (mul u w)))
               =< ap (add (mul a y)) (mul-neg a (mul u w)) > add (mul a y) (neg (mul a (mul u w)))
               =< ap (\ t -> add (mul a y) (neg t)) (mulA a u w) > add (mul a y) (neg (mul (mul a u) w))
               =< ap (\ t -> add (mul a y) (neg (mul t w))) (sym e) > add (mul a y) (neg (mul v w)) } ;

  neg-step (y : R) : Id R (mul (phi (kneg ko)) y) (neg y) =
    calc R { mul (phi (kneg ko)) y =< ap (\ t -> mul t y) (phi-neg ko) > mul (neg (phi ko)) y
               =< ap (\ t -> mul (neg t) y) phi-o > mul (neg o) y
               =< neg-mul-left o y > neg (mul o y)
               =< ap neg (one-left y) > neg y } ;

  -- (y - c A) - c (A' - A) = y - c A'
  rep-step (y c A A' : R) :
    Id R (add (add y (neg (mul c A))) (neg (mul c (add A' (neg A))))) (add y (neg (mul c A'))) =
    calc R { add (add y (neg (mul c A))) (neg (mul c (add A' (neg A))))
               =< ap (\ t -> add (add y (neg (mul c A))) (neg t))
                     (trans (dist c A' (neg A)) (ap (add (mul c A')) (mul-neg c A)))
               > add (add y (neg (mul c A))) (neg (add (mul c A') (neg (mul c A))))
               =< ap (add (add y (neg (mul c A)))) (negsub (mul c A') (mul c A))
               > add (add y (neg (mul c A))) (add (neg (mul c A')) (mul c A))
               =< sym (addA y (neg (mul c A)) (add (neg (mul c A')) (mul c A)))
               > add y (add (neg (mul c A)) (add (neg (mul c A')) (mul c A)))
               =< ap (add y) (add-swap (neg (mul c A)) (neg (mul c A')) (mul c A))
               > add y (add (neg (mul c A')) (add (neg (mul c A)) (mul c A)))
               =< ap (\ t -> add y (add (neg (mul c A')) t)) (neg-cancel (mul c A))
               > add y (add (neg (mul c A')) z)
               =< ap (add y) (addZ (neg (mul c A'))) > add y (neg (mul c A')) } ;

  add-diff (A A' : R) : Id R (add A (add A' (neg A))) A' =
    trans (add-swap A A' (neg A)) (trans (ap (add A') (addN A)) (addZ A')) ;

  ------------------------------------------------------------------------
  -- linear combinations with coefficients in K

  In : List K -> R -> U l = split {
    nil -> \ y -> Id R y z ;
    cons t s | r -> \ y -> (c : K) * r (add y (neg (mul (phi c) (phi t)))) } ;

  in-tr (s : List K) (y y' : R) (e : Id R y y') (h : In s y) : In s y' = subst (In s) e h ;

  in-zero : (s : List K) -> In s z = split {
    nil -> refl z ;
    cons t s | r -> (kz, in-tr s z (add z (neg (mul (phi kz) (phi t)))) (sym (drop-kz z (phi t))) r) } ;

  in-add : (s : List K) (y y' : R) -> In s y -> In s y' -> In s (add y y') = split {
    nil -> \ y y' h h' ->
      calc R { add y y' =< ap (\ t -> add t y') h > add z y'
                 =< ap (add z) h' > add z z
                 =< addZ z > z } ;
    cons t s | r -> \ y y' h h' -> (kadd h.1 h'.1,
      in-tr s _ _ (add-step y y' (phi h.1) (phi h'.1) (phi (kadd h.1 h'.1)) (phi t) (phi-add h.1 h'.1))
        (r (add y (neg (mul (phi h.1) (phi t)))) (add y' (neg (mul (phi h'.1) (phi t)))) h.2 h'.2)) } ;

  in-scale : (s : List K) (d : K) (y : R) -> In s y -> In s (mul (phi d) y) = split {
    nil -> \ d y h -> trans (ap (mul (phi d)) h) (mul-zero (phi d)) ;
    cons t s | r -> \ d y h -> (kmul d h.1,
      in-tr s _ _ (scale-step (phi d) y (phi h.1) (phi (kmul d h.1)) (phi t) (phi-mul d h.1))
        (r d (add y (neg (mul (phi h.1) (phi t)))) h.2)) } ;

  in-neg (s : List K) (y : R) (h : In s y) : In s (neg y) =
    in-tr s (mul (phi (kneg ko)) y) (neg y) (neg-step y) (in-scale s (kneg ko) y h) ;

  in-weak (t : K) (s : List K) (y : R) (h : In s y) : In (cons t s) y =
    (kz, in-tr s y (add y (neg (mul (phi kz) (phi t)))) (sym (drop-kz y (phi t))) h) ;

  in-gen (t : K) (s : List K) : In (cons t s) (phi t) =
    (ko, in-tr s z (add (phi t) (neg (mul (phi ko) (phi t)))) (sym (gen-step (phi t))) (in-zero s)) ;

  in-app : (p s : List K) (y : R) -> In s y -> In (app p s) y = split {
    nil -> \ s y h -> h ;
    cons t p | r -> \ s y h -> in-weak t (app p s) y (r s y h) } ;

  in-gen-mid (p : List K) (t : K) (s : List K) : In (app p (cons t s)) (phi t) =
    in-app p (cons t s) (phi t) (in-gen t s) ;

  in-mid : (p g s : List K) (y : R) -> In (app p s) y -> In (app p (app g s)) y = split {
    nil -> \ g s y h -> in-app g s y h ;
    cons t p | r -> \ g s y h -> (h.1, r g s (add y (neg (mul (phi h.1) (phi t)))) h.2) } ;

  in-rep : (p s : List K) (a a' : K) -> In s (add (phi a') (neg (phi a))) ->
           (y : R) -> In (app p (cons a s)) y -> In (app p (cons a' s)) y = split {
    nil -> \ s a a' d y h -> (h.1,
      in-tr s _ _ (rep-step y (phi h.1) (phi a) (phi a'))
        (in-add s (add y (neg (mul (phi h.1) (phi a)))) (neg (mul (phi h.1) (add (phi a') (neg (phi a)))))
          h.2 (in-neg s (mul (phi h.1) (add (phi a') (neg (phi a))))
                 (in-scale s h.1 (add (phi a') (neg (phi a))) d)))) ;
    cons t p | r -> \ s a a' d y h -> (h.1, r s a a' d (add y (neg (mul (phi h.1) (phi t)))) h.2) } ;

  ------------------------------------------------------------------------
  -- good lists

  Good : List K -> U l = split {
    nil -> Empty ;
    cons t s | r -> Plus (In s (phi t)) r } ;

  good-pre : (g s : List K) -> Good s -> Good (app g s) = split {
    nil -> \ s h -> h ;
    cons t g | r -> \ s h -> inr (r s h) } ;

  good-ins-cons (p g s : List K) (t : K) (ih : Good (app p s) -> Good (app p (app g s))) :
    Plus (In (app p s) (phi t)) (Good (app p s)) ->
    Plus (In (app p (app g s)) (phi t)) (Good (app p (app g s))) = split {
    inl w -> inl (in-mid p g s (phi t) w) ;
    inr h -> inr (ih h) } ;
  good-ins : (p g s : List K) -> Good (app p s) -> Good (app p (app g s)) = split {
    nil -> good-pre ;
    cons t p | r -> \ g s -> good-ins-cons p g s t (r g s) } ;

  good-rep-nil (s : List K) (a a' : K) (d : In s (add (phi a') (neg (phi a)))) :
    Plus (In s (phi a)) (Good s) -> Plus (In s (phi a')) (Good s) = split {
    inl w -> inl (in-tr s (add (phi a) (add (phi a') (neg (phi a)))) (phi a') (add-diff (phi a) (phi a'))
                    (in-add s (phi a) (add (phi a') (neg (phi a))) w d)) ;
    inr h -> inr h } ;
  good-rep-cons (p s : List K) (a a' : K) (d : In s (add (phi a') (neg (phi a)))) (t : K)
    (ih : Good (app p (cons a s)) -> Good (app p (cons a' s))) :
    Plus (In (app p (cons a s)) (phi t)) (Good (app p (cons a s))) ->
    Plus (In (app p (cons a' s)) (phi t)) (Good (app p (cons a' s))) = split {
    inl w -> inl (in-rep p s a a' d (phi t) w) ;
    inr h -> inr (ih h) } ;
  good-rep : (p s : List K) (a a' : K) -> In s (add (phi a') (neg (phi a))) ->
             Good (app p (cons a s)) -> Good (app p (cons a' s)) = split {
    nil -> good-rep-nil ;
    cons t p | r -> \ s a a' d -> good-rep-cons p s a a' d t (r s a a' d) } ;

  ------------------------------------------------------------------------
  -- noetherianity, and the two changes that keep a bar

  module G = Bar[l].Over[K,Good] ;
  Noeth : U l = G.Bars nil ;

  InsRel (g s s1 s2 : List K) : U l =
    (p : List K) * (Id (List K) (app p s) s1 * Id (List K) (app p (app g s)) s2) ;
  ins-cons (g s : List K) (x : K) (s1 s2 : List K) (e : InsRel g s s1 s2) : InsRel g s (cons x s1) (cons x s2) =
    (cons x e.1, (ap (\ k -> cons x k) e.2.1, ap (\ k -> cons x k) e.2.2)) ;
  ins-good (g s s1 s2 : List K) (e : InsRel g s s1 s2) (h : Good s1) : Good s2 =
    subst Good e.2.2 (good-ins e.1 g s (subst Good (sym e.2.1) h)) ;
  bars-ins (p g s : List K) (b : G.Bars (app p s)) : G.Bars (app p (app g s)) =
    Bar[l].Keep[K,Good,Good,InsRel g s,ins-cons g s,ins-good g s].bars
      (app p s) (app p (app g s)) (p,(refl (app p s),refl (app p (app g s)))) b ;

  RepRel (s : List K) (a a' : K) (s1 s2 : List K) : U l =
    (p : List K) * (Id (List K) (app p (cons a s)) s1 * Id (List K) (app p (cons a' s)) s2) ;
  rep-cons (s : List K) (a a' x : K) (s1 s2 : List K) (e : RepRel s a a' s1 s2) :
    RepRel s a a' (cons x s1) (cons x s2) =
    (cons x e.1, (ap (\ k -> cons x k) e.2.1, ap (\ k -> cons x k) e.2.2)) ;
  rep-good (s : List K) (a a' : K) (d : In s (add (phi a') (neg (phi a)))) (s1 s2 : List K)
    (e : RepRel s a a' s1 s2) (h : Good s1) : Good s2 =
    subst Good e.2.2 (good-rep e.1 s a a' d (subst Good (sym e.2.1) h)) ;
  bars-rep (p s : List K) (a a' : K) (d : In s (add (phi a') (neg (phi a))))
    (b : G.Bars (app p (cons a s))) : G.Bars (app p (cons a' s)) =
    Bar[l].Keep[K,Good,Good,RepRel s a a',rep-cons s a a',rep-good s a a' d].bars
      (app p (cons a s)) (app p (cons a' s)) (p,(refl (app p (cons a s)),refl (app p (cons a' s)))) b ;
} ;
