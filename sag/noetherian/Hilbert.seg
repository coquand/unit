-- Hilbert.seg: the Hilbert basis theorem (Coquand-Persson 1999, 3.1).
--
-- If P presents a noetherian subring of S, then for every X in S the
-- polynomial codes over P (PolyPres) present a noetherian subring: the
-- subring generated by P and X.  With S = R[X] this is the basis theorem;
-- with a quotient or a localisation R[1/s] (X = 1/s) for S it gives these
-- constructions as well.
--
-- Informal proof.  Write P(s) for "Good bars s" on lists of polynomial
-- codes, and call s minimal (M s) if, at each position, every strictly
-- shorter replacement of the element there, after the elements before it,
-- has P.
--
--   Open induction (open-ind): if M s and P(s.f) for every f with
--   M(s.f), then P(s).  Prove P(s.f) by course-of-values induction on the
--   length of f: the induction hypothesis is exactly M(s.f).
--
--   Main lemma (main): if the leading coefficients a_i of the codes
--   g_i = a_i.f_i satisfy Good bars [a_0..a_m], and M [g_0..g_m], then
--   P [g_0..g_m].  By induction on the bar.
--     Step: by the bar, the claim holds for every extension g = a.f; the
--     empty extension is good, as 0 is in every span; open induction.
--     Base: some a_k is a combination sum c_i a_i of earlier ones
--     (leaf-case finds k; later elements are inserted by bars-ins).
--     Run through i < k (reduce): if g_i is longer than g_k, minimality
--     at i gives P for g_k placed directly after g_0..g_{i-1}, and the
--     elements in between are inserted.  Otherwise subtract c_i X^d g_i
--     from g_k (axpy): the leading coefficient becomes a_k - c_i a_i and
--     the difference is in the span of the earlier codes, so P transfers
--     back (bars-rep).  When all i are used, the leading coefficient is 0:
--     g_k = a.f with phi a = 0 evaluates as f, which is shorter, so
--     minimality at k gives P.
--
--   Theorem: apply the main lemma to the empty list.
level l ; open Ring[l] ; open Bar[l] ; open NatOrder[l] ;

module Over (S : CRing) (P : Span[l].Pres[S]) (X : S.R) {
  open S ; open RL[S] ; open P ;
  module PP = PolyPres[l].Over[S,P,X] ;
  module SC = Span[l].Over[S,P] ;
  module SD = Span[l].Over[S,PP.pres] ;

  Bars (s : List (List K)) : U l = SD.G.Bars s ;

  ------------------------------------------------------------------------
  -- minimality and open induction

  M : List (List K) -> U l = split {
    nil -> Top ;
    cons f s | r -> r * ((g : List K) -> Lt (len g) (len f) -> Bars (cons g s)) } ;

  cv (s : List (List K)) (m : M s) (h : (f : List K) -> M (cons f s) -> Bars (cons f s)) :
    (n : Nat) (f : List K) -> Lt (len f) n -> Bars (cons f s) = split {
    zero -> \ f b -> efq b ;
    suc n | r -> \ f b -> h f (m, \ g bg -> r g (le-trans (suc (len g)) (len f) n bg b)) } ;

  open-ind (s : List (List K)) (m : M s) (h : (f : List K) -> M (cons f s) -> Bars (cons f s)) : Bars s =
    SD.G.step s (\ f -> cv s m h (suc (len {K} f)) f (le-refl (len {K} f))) ;

  nil-good (s : List (List K)) : Bars (cons nil s) = SD.G.here (cons nil s) (inl (SD.in-zero s)) ;

  ------------------------------------------------------------------------
  -- codes with their leading coefficients

  fsts : List (K * List K) -> List K = split {
    nil -> nil ;
    cons p ps | r -> cons p.1 r } ;
  lift : List (K * List K) -> List (List K) = split {
    nil -> nil ;
    cons p ps | r -> cons (cons p.1 p.2) r } ;

  ------------------------------------------------------------------------
  -- the base case: reduction of the leading coefficient

  -- phi a = 0: a.f evaluates as f
  vanish (a : K) (f : List K) (w : Id R (phi a) z) : Id R (add (PP.ev (cons a f)) (neg (PP.ev f))) z =
    trans (add-neg-cancel (mul (phi a) (PP.pow (len f))) (PP.ev f))
      (trans (ap (\ t -> mul t (PP.pow (len f))) w) (zero-mul (PP.pow (len f)))) ;

  reduce-nil (s : List (List K)) (a : K) (f : List K) (w : Id R (phi a) z) (b : Bars (cons f s)) :
    Bars (cons (cons a f) s) =
    SD.bars-rep nil s f (cons a f)
      (SD.in-tr s z (add (PP.ev (cons a f)) (neg (PP.ev f))) (sym (vanish a f w)) (SD.in-zero s)) b ;

  cancel (V T : R) : Id R (add V (neg (add V (neg T)))) T =
    trans (ap (add V) (negsub V T)) (trans (addA V (neg V) T) (trans (ap (\ u -> add u T) (addN V)) (zl T))) ;

  -- the difference g - axpy c e g = c X^d e lies in the span of s, e in s
  axpy-diff (pi s : List (List K)) (e : List K) (c : K) (d : Nat) (g : List K)
    (de : Id Nat (len g) (plus d (len e))) :
    SD.In (app pi (cons e s)) (add (PP.ev g) (neg (PP.ev (PP.axpy c e g)))) =
    SD.in-tr (app pi (cons e s)) (mul (PP.ev (PP.monomial c d)) (PP.ev e))
      (add (PP.ev g) (neg (PP.ev (PP.axpy c e g))))
      (calc R { mul (PP.ev (PP.monomial c d)) (PP.ev e)
                  =< ap (\ t -> mul t (PP.ev e)) (PP.ev-monomial c d) > mul (mul (phi c) (PP.pow d)) (PP.ev e)
                  =< sym (cancel (PP.ev g) (mul (mul (phi c) (PP.pow d)) (PP.ev e)))
                  > add (PP.ev g) (neg (add (PP.ev g) (neg (mul (mul (phi c) (PP.pow d)) (PP.ev e)))))
                  =< ap (\ t -> add (PP.ev g) (neg t)) (sym (PP.ev-axpy c e g d de))
                  > add (PP.ev g) (neg (PP.ev (PP.axpy c e g))) })
      (SD.in-scale (app pi (cons e s)) (PP.monomial c d) (PP.ev e) (SD.in-gen-mid pi e s)) ;

  Reduce (ps : List (K * List K)) : U l =
    (pi : List (List K)) (a : K) (f : List K) -> SC.In (fsts ps) (phi a) -> M (lift ps) ->
    ((g : List K) -> Lt (len g) (suc (len f)) -> Bars (cons g (app pi (lift ps)))) ->
    Bars (cons (cons a f) (app pi (lift ps))) ;

  -- e = p.1 . p.2 is longer than a.f: minimality at e
  reduce-gt (p : K * List K) (ps : List (K * List K)) (pi : List (List K)) (a : K) (f : List K)
    (m : M (lift (cons p ps))) (gt : Lt (suc (len f)) (len {K} (cons p.1 p.2))) :
    Bars (cons (cons a f) (app pi (lift (cons p ps)))) =
    subst (\ t -> Bars (cons (cons a f) t)) (app-assoc pi (cons (cons p.1 p.2) nil) (lift ps))
      (SD.bars-ins (cons (cons a f) nil) (app pi (cons (cons p.1 p.2) nil)) (lift ps) (m.2 (cons a f) gt)) ;

  -- e is not longer: subtract c X^d e
  reduce-le (p : K * List K) (ps : List (K * List K)) (pi : List (List K)) (a : K) (f : List K)
    (w : SC.In (fsts (cons p ps)) (phi a)) (m : M (lift (cons p ps)))
    (k : (g : List K) -> Lt (len g) (suc (len f)) -> Bars (cons g (app pi (lift (cons p ps)))))
    (ih : Reduce ps) (dd : (d : Nat) * Id Nat (suc (len f)) (plus d (len {K} (cons p.1 p.2)))) :
    Bars (cons (cons a f) (app pi (lift (cons p ps)))) =
    SD.bars-rep nil (app pi (cons (cons p.1 p.2) (lift ps))) (PP.axpy w.1 (cons p.1 p.2) (cons a f)) (cons a f)
      (axpy-diff pi (lift ps) (cons p.1 p.2) w.1 dd.1 (cons a f) dd.2)
      (subst (\ t -> Bars (cons (PP.axpy w.1 (cons p.1 p.2) (cons a f)) t))
        (app-assoc pi (cons (cons p.1 p.2) nil) (lift ps))
        (ih (app pi (cons (cons p.1 p.2) nil)) (kadd a (kneg (kmul w.1 p.1))) (PP.axpy w.1 p.2 f)
          (SC.in-tr (fsts ps) (add (phi a) (neg (mul (phi w.1) (phi p.1)))) (phi (kadd a (kneg (kmul w.1 p.1))))
            (sym (PP.head-step w.1 a p.1)) w.2)
          m.1
          (\ g bg -> subst (\ t -> Bars (cons g t)) (sym (app-assoc pi (cons (cons p.1 p.2) nil) (lift ps)))
             (k g (subst (\ n -> Lt (len g) n) (PP.len-axpy w.1 (cons p.1 p.2) (cons a f) dd.1 dd.2) bg))))) ;

  reduce-cons (p : K * List K) (ps : List (K * List K)) (pi : List (List K)) (a : K) (f : List K)
    (w : SC.In (fsts (cons p ps)) (phi a)) (m : M (lift (cons p ps)))
    (k : (g : List K) -> Lt (len g) (suc (len f)) -> Bars (cons g (app pi (lift (cons p ps)))))
    (ih : Reduce ps) :
    Plus (Le (len {K} (cons p.1 p.2)) (suc (len f))) (Lt (suc (len f)) (len {K} (cons p.1 p.2))) ->
    Bars (cons (cons a f) (app pi (lift (cons p ps)))) = split {
    inl le -> reduce-le p ps pi a f w m k ih (le-plus (len {K} (cons p.1 p.2)) (suc (len f)) le) ;
    inr gt -> reduce-gt p ps pi a f m gt } ;

  reduce : (ps : List (K * List K)) -> Reduce ps = split {
    nil -> \ pi a f w m k -> reduce-nil (app pi nil) a f w (k f (le-refl (len f))) ;
    cons p ps | r -> \ pi a f w m k ->
      reduce-cons p ps pi a f w m k r (le-or-gt (len {K} (cons p.1 p.2)) (suc (len f))) } ;

  leaf-cons (p : K * List K) (ps : List (K * List K)) (m : M (lift (cons p ps)))
    (ih : SC.Good (fsts ps) -> M (lift ps) -> Bars (lift ps)) :
    Plus (SC.In (fsts ps) (phi p.1)) (SC.Good (fsts ps)) -> Bars (lift (cons p ps)) = split {
    inl w -> reduce ps nil p.1 p.2 w m.1 m.2 ;
    inr g -> SD.bars-ins nil (cons (cons p.1 p.2) nil) (lift ps) (ih g m.1) } ;

  leaf-case : (ps : List (K * List K)) -> SC.Good (fsts ps) -> M (lift ps) -> Bars (lift ps) = split {
    nil -> \ g m -> efq g ;
    cons p ps | r -> \ g m -> leaf-cons p ps m r g } ;

  ------------------------------------------------------------------------
  -- the main lemma and the theorem

  extend (ps : List (K * List K))
    (ih : (a : K) (f : List K) -> M (cons (cons a f) (lift ps)) -> Bars (cons (cons a f) (lift ps))) :
    (g : List K) -> M (cons g (lift ps)) -> Bars (cons g (lift ps)) = split {
    nil -> \ mg -> nil-good (lift ps) ;
    cons a f -> ih a f } ;

  main : (t : Tree K) (ps : List (K * List K)) -> SC.G.Valid t (fsts ps) -> M (lift ps) -> Bars (lift ps) = split {
    leaf -> leaf-case ;
    node h | r -> \ ps v m -> open-ind (lift ps) m (extend ps (\ a f -> r a (cons (a,f) ps) (v a))) } ;

  hilbert (n : SC.Noeth) : SD.Noeth = main n.1 nil n.2 tt ;
} ;
