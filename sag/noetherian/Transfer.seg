-- Transfer.seg: a ring map carries a noetherian presented subring to its
-- image.  The codes and the tree are unchanged: a combination in S maps
-- to a combination in S' with the same coefficients.  For a surjection
-- S -> S/I this is the quotient; I need not be finitely generated.
--
-- The map is given by the three laws of RingHom.Preserves (unit, addition,
-- multiplication); zero and negation follow as in RingHom.
level l ; open Ring[l] ; open Bar[l] ;

module Over (S S' : CRing) (f : S.R -> S'.R)
  (f-o : Id S'.R (f S.o) S'.o)
  (f-add : (a b : S.R) -> Id S'.R (f (S.add a b)) (S'.add (f a) (f b)))
  (f-mul : (a b : S.R) -> Id S'.R (f (S.mul a b)) (S'.mul (f a) (f b)))
  (P : Span[l].Pres[S]) {
  open P ;
  module SP = Span[l].Over[S,P] ;

  f-z : Id S'.R (f S.z) S'.z =
    RL[S'].add-cancel (f S.z) (f S.z) (trans (sym (f-add S.z S.z)) (ap f (S.addZ S.z))) ;
  f-neg (a : S.R) : Id S'.R (f (S.neg a)) (S'.neg (f a)) =
    RL[S'].neg-uniq (f a) (f (S.neg a)) (trans (sym (f-add a (S.neg a))) (trans (ap f (S.addN a)) f-z)) ;

  image : Span[l].Pres[S'] =
    Span[l].mkPres S' K (\ x -> f (phi x)) kz ko kadd kmul kneg
      (trans (ap f phi-z) f-z) (trans (ap f phi-o) f-o)
      (\ x y -> trans (ap f (phi-add x y)) (f-add (phi x) (phi y)))
      (\ x y -> trans (ap f (phi-mul x y)) (f-mul (phi x) (phi y)))
      (\ x -> trans (ap f (phi-neg x)) (f-neg (phi x))) ;
  module SI = Span[l].Over[S',image] ;

  in-map : (s : List K) (y : S.R) -> SP.In s y -> SI.In s (f y) = split {
    nil -> \ y e -> trans (ap f e) f-z ;
    cons t s | r -> \ y h -> (h.1,
      SI.in-tr s (f (S.add y (S.neg (S.mul (phi h.1) (phi t)))))
        (S'.add (f y) (S'.neg (S'.mul (f (phi h.1)) (f (phi t)))))
        (trans (f-add y (S.neg (S.mul (phi h.1) (phi t))))
          (ap (S'.add (f y)) (trans (f-neg (S.mul (phi h.1) (phi t))) (ap S'.neg (f-mul (phi h.1) (phi t))))))
        (r (S.add y (S.neg (S.mul (phi h.1) (phi t)))) h.2)) } ;

  good-map-cons (t : K) (s : List K) (ih : SP.Good s -> SI.Good s) :
    Plus (SP.In s (phi t)) (SP.Good s) -> Plus (SI.In s (f (phi t))) (SI.Good s) = split {
    inl w -> inl (in-map s (phi t) w) ;
    inr g -> inr (ih g) } ;
  good-map : (s : List K) -> SP.Good s -> SI.Good s = split {
    nil -> \ g -> g ;
    cons t s | r -> good-map-cons t s r } ;

  Same (s s' : List K) : U l = Id (List K) s s' ;
  same-cons (x : K) (s s' : List K) (e : Same s s') : Same (cons x s) (cons x s') = ap (\ k -> cons x k) e ;
  same-good (s s' : List K) (e : Same s s') (g : SP.Good s) : SI.Good s' = subst SI.Good e (good-map s g) ;

  noeth (n : SP.Noeth) : SI.Noeth =
    Keep[K,SP.Good,SI.Good,Same,same-cons,same-good].bars nil nil (refl nil) n ;
} ;
