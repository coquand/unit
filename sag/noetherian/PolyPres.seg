-- PolyPres.seg: polynomial codes.
--
-- Given a presentation P of a subring of S and an element X of S, a list
-- of codes [a_n, ..., a_0] (highest coefficient first) stands for
-- a_n X^n + ... + a_0 (ev).  This presents the subring generated by the
-- phi a and X.  The ring operations on codes go through the reversed,
-- lowest-first lists (evL), where they are the usual ones.
--
-- For the step of the Hilbert basis theorem: axpy c u v subtracts
-- c X^d u from v, the two lists aligned at their heads, where
-- len v = d + len u; the head of the result is a - c b.
level l ; open Ring[l] ; open Bar[l] ;

module Over (S : CRing) (P : Span[l].Pres[S]) (X : S.R) {
  open S ; open RL[S] ; open P ;
  module SP = Span[l].Over[S,P] ;

  pow : Nat -> R = split { zero -> o ; suc n | r -> mul X r } ;

  pow-add : (d k : Nat) -> Id R (pow (plus d k)) (mul (pow d) (pow k)) = split {
    zero -> \ k -> sym (one-left (pow k)) ;
    suc d | r -> \ k -> trans (ap (mul X) (r k)) (mulA X (pow d) (pow k)) } ;

  ev : List K -> R = split {
    nil -> z ;
    cons a f | r -> add (mul (phi a) (pow (len f))) r } ;

  evL : List K -> R = split {
    nil -> z ;
    cons a f | r -> add (phi a) (mul X r) } ;

  revOnto : List K -> List K -> List K = split {
    nil -> \ m -> m ;
    cons a f | r -> \ m -> r (cons a m) } ;
  rev (u : List K) : List K = revOnto u nil ;

  ------------------------------------------------------------------------
  -- reversal exchanges the two evaluations

  rev-step1 (F P A M : R) :
    Id R (add F (mul P (add A (mul X M)))) (add (add (mul A P) F) (mul (mul X P) M)) =
    calc R { add F (mul P (add A (mul X M)))
               =< ap (add F) (dist P A (mul X M)) > add F (add (mul P A) (mul P (mul X M)))
               =< addA F (mul P A) (mul P (mul X M)) > add (add F (mul P A)) (mul P (mul X M))
               =< ap (\ t -> add t (mul P (mul X M))) (trans (addC F (mul P A)) (ap (\ u -> add u F) (mulC P A)))
               > add (add (mul A P) F) (mul P (mul X M))
               =< ap (add (add (mul A P) F)) (trans (mulA P X M) (ap (\ u -> mul u M) (mulC P X)))
               > add (add (mul A P) F) (mul (mul X P) M) } ;

  evL-revOnto : (u m : List K) -> Id R (evL (revOnto u m)) (add (ev u) (mul (pow (len u)) (evL m))) = split {
    nil -> \ m -> sym (trans (zl (mul o (evL m))) (one-left (evL m))) ;
    cons a f | r -> \ m -> trans (r (cons a m)) (rev-step1 (ev f) (pow (len f)) (phi a) (evL m)) } ;

  rev-step2 (Q V B M : R) :
    Id R (add (mul (mul X Q) V) (add (mul B Q) M)) (add (mul Q (add B (mul X V))) M) =
    calc R { add (mul (mul X Q) V) (add (mul B Q) M)
               =< addA (mul (mul X Q) V) (mul B Q) M > add (add (mul (mul X Q) V) (mul B Q)) M
               =< ap (\ u -> add u M) (addC (mul (mul X Q) V) (mul B Q)) > add (add (mul B Q) (mul (mul X Q) V)) M
               =< ap (\ u -> add (add u (mul (mul X Q) V)) M) (mulC B Q) > add (add (mul Q B) (mul (mul X Q) V)) M
               =< ap (\ u -> add (add (mul Q B) u) M) (sym (trans (mul-swap Q X V) (mulA X Q V)))
               > add (add (mul Q B) (mul Q (mul X V))) M
               =< ap (\ u -> add u M) (sym (dist Q B (mul X V))) > add (mul Q (add B (mul X V))) M } ;

  ev-revOnto : (v m : List K) -> Id R (ev (revOnto v m)) (add (mul (pow (len m)) (evL v)) (ev m)) = split {
    nil -> \ m -> sym (trans (ap (\ t -> add t (ev m)) (mul-zero (pow (len m)))) (zl (ev m))) ;
    cons b v | r -> \ m -> trans (r (cons b m)) (rev-step2 (pow (len m)) (evL v) (phi b) (ev m)) } ;

  evL-rev (u : List K) : Id R (evL (rev u)) (ev u) =
    trans (evL-revOnto u nil) (trans (ap (add (ev u)) (mul-zero (pow (len u)))) (addZ (ev u))) ;
  ev-rev (v : List K) : Id R (ev (rev v)) (evL v) =
    trans (ev-revOnto v nil) (trans (ap (\ t -> add t z) (one-left (evL v))) (addZ (evL v))) ;

  ------------------------------------------------------------------------
  -- the usual operations on lowest-first lists

  ladd : List K -> List K -> List K = split {
    nil -> \ q -> q ;
    cons a p | r -> split {
      nil -> cons a p ;
      cons b q -> cons (kadd a b) (r q) } } ;

  evL-add : (p q : List K) -> Id R (evL (ladd p q)) (add (evL p) (evL q)) = split {
    nil -> \ q -> sym (zl (evL q)) ;
    cons a p | r -> split {
      nil -> sym (addZ (evL (cons a p))) ;
      cons b q ->
        calc R { add (phi (kadd a b)) (mul X (evL (ladd p q)))
                   =< ap (\ t -> add t (mul X (evL (ladd p q)))) (phi-add a b)
                   > add (add (phi a) (phi b)) (mul X (evL (ladd p q)))
                   =< ap (\ t -> add (add (phi a) (phi b)) (mul X t)) (r q)
                   > add (add (phi a) (phi b)) (mul X (add (evL p) (evL q)))
                   =< ap (add (add (phi a) (phi b))) (dist X (evL p) (evL q))
                   > add (add (phi a) (phi b)) (add (mul X (evL p)) (mul X (evL q)))
                   =< swap (phi a) (phi b) (mul X (evL p)) (mul X (evL q))
                   > add (add (phi a) (mul X (evL p))) (add (phi b) (mul X (evL q))) } } } ;

  lscale (c : K) : List K -> List K = split {
    nil -> nil ;
    cons a p | r -> cons (kmul c a) r } ;

  evL-scale (c : K) : (p : List K) -> Id R (evL (lscale c p)) (mul (phi c) (evL p)) = split {
    nil -> sym (mul-zero (phi c)) ;
    cons a p | r ->
      calc R { add (phi (kmul c a)) (mul X (evL (lscale c p)))
                 =< ap (\ t -> add t (mul X (evL (lscale c p)))) (phi-mul c a)
                 > add (mul (phi c) (phi a)) (mul X (evL (lscale c p)))
                 =< ap (\ t -> add (mul (phi c) (phi a)) (mul X t)) r
                 > add (mul (phi c) (phi a)) (mul X (mul (phi c) (evL p)))
                 =< ap (add (mul (phi c) (phi a))) (mul-swap X (phi c) (evL p))
                 > add (mul (phi c) (phi a)) (mul (phi c) (mul X (evL p)))
                 =< sym (dist (phi c) (phi a) (mul X (evL p))) > mul (phi c) (add (phi a) (mul X (evL p))) } } ;

  lmul : List K -> List K -> List K = split {
    nil -> \ q -> nil ;
    cons a p | r -> \ q -> ladd (lscale a q) (cons kz (r q)) } ;

  evL-mul : (p q : List K) -> Id R (evL (lmul p q)) (mul (evL p) (evL q)) = split {
    nil -> \ q -> sym (zero-mul (evL q)) ;
    cons a p | r -> \ q ->
      calc R { evL (ladd (lscale a q) (cons kz (lmul p q)))
                 =< evL-add (lscale a q) (cons kz (lmul p q))
                 > add (evL (lscale a q)) (add (phi kz) (mul X (evL (lmul p q))))
                 =< ap (\ t -> add t (add (phi kz) (mul X (evL (lmul p q))))) (evL-scale a q)
                 > add (mul (phi a) (evL q)) (add (phi kz) (mul X (evL (lmul p q))))
                 =< ap (\ t -> add (mul (phi a) (evL q)) (add t (mul X (evL (lmul p q))))) phi-z
                 > add (mul (phi a) (evL q)) (add z (mul X (evL (lmul p q))))
                 =< ap (add (mul (phi a) (evL q))) (zl (mul X (evL (lmul p q))))
                 > add (mul (phi a) (evL q)) (mul X (evL (lmul p q)))
                 =< ap (\ t -> add (mul (phi a) (evL q)) (mul X t)) (r q)
                 > add (mul (phi a) (evL q)) (mul X (mul (evL p) (evL q)))
                 =< ap (add (mul (phi a) (evL q))) (mulA X (evL p) (evL q))
                 > add (mul (phi a) (evL q)) (mul (mul X (evL p)) (evL q))
                 =< sym (dist-left (phi a) (mul X (evL p)) (evL q))
                 > mul (add (phi a) (mul X (evL p))) (evL q) } } ;

  ------------------------------------------------------------------------
  -- the presentation by polynomial codes

  padd (u v : List K) : List K = rev (ladd (rev u) (rev v)) ;
  pmul (u v : List K) : List K = rev (lmul (rev u) (rev v)) ;
  pneg (u : List K) : List K = rev (lscale (kneg ko) (rev u)) ;
  pone : List K = cons ko nil ;

  ev-one : Id R (ev pone) o = trans (addZ (mul (phi ko) o)) (trans (mulO (phi ko)) phi-o) ;

  ev-add (u v : List K) : Id R (ev (padd u v)) (add (ev u) (ev v)) =
    calc R { ev (padd u v) =< ev-rev (ladd (rev u) (rev v)) > evL (ladd (rev u) (rev v))
               =< evL-add (rev u) (rev v) > add (evL (rev u)) (evL (rev v))
               =< ap (\ t -> add t (evL (rev v))) (evL-rev u) > add (ev u) (evL (rev v))
               =< ap (add (ev u)) (evL-rev v) > add (ev u) (ev v) } ;

  ev-mul (u v : List K) : Id R (ev (pmul u v)) (mul (ev u) (ev v)) =
    calc R { ev (pmul u v) =< ev-rev (lmul (rev u) (rev v)) > evL (lmul (rev u) (rev v))
               =< evL-mul (rev u) (rev v) > mul (evL (rev u)) (evL (rev v))
               =< ap (\ t -> mul t (evL (rev v))) (evL-rev u) > mul (ev u) (evL (rev v))
               =< ap (mul (ev u)) (evL-rev v) > mul (ev u) (ev v) } ;

  ev-neg (u : List K) : Id R (ev (pneg u)) (neg (ev u)) =
    calc R { ev (pneg u) =< ev-rev (lscale (kneg ko) (rev u)) > evL (lscale (kneg ko) (rev u))
               =< evL-scale (kneg ko) (rev u) > mul (phi (kneg ko)) (evL (rev u))
               =< ap (mul (phi (kneg ko))) (evL-rev u) > mul (phi (kneg ko)) (ev u)
               =< SP.neg-step (ev u) > neg (ev u) } ;

  pres : Span[l].Pres[S] =
    Span[l].mkPres S (List K) ev nil pone padd pmul pneg (refl z) ev-one ev-add ev-mul ev-neg ;

  ------------------------------------------------------------------------
  -- monomials and the head-aligned subtraction

  zeros : Nat -> List K = split { zero -> nil ; suc d | r -> cons kz r } ;

  len-zeros : (d : Nat) -> Id Nat (len (zeros d)) d = split {
    zero -> refl zero ;
    suc d | r -> ap (\ k -> suc k) r } ;

  ev-zeros : (d : Nat) -> Id R (ev (zeros d)) z = split {
    zero -> refl z ;
    suc d | r ->
      calc R { add (mul (phi kz) (pow (len (zeros d)))) (ev (zeros d))
                 =< ap (\ t -> add (mul t (pow (len (zeros d)))) (ev (zeros d))) phi-z
                 > add (mul z (pow (len (zeros d)))) (ev (zeros d))
                 =< ap (\ t -> add t (ev (zeros d))) (zero-mul (pow (len (zeros d)))) > add z (ev (zeros d))
                 =< ap (add z) r > add z z
                 =< addZ z > z } } ;

  monomial (c : K) (d : Nat) : List K = cons c (zeros d) ;

  ev-monomial (c : K) (d : Nat) : Id R (ev (monomial c d)) (mul (phi c) (pow d)) =
    calc R { ev (monomial c d) =< ap (add (mul (phi c) (pow (len (zeros d))))) (ev-zeros d)
               > add (mul (phi c) (pow (len (zeros d)))) z
               =< addZ (mul (phi c) (pow (len (zeros d)))) > mul (phi c) (pow (len (zeros d)))
               =< ap (\ k -> mul (phi c) (pow k)) (len-zeros d) > mul (phi c) (pow d) } ;

  axpy (c : K) : List K -> List K -> List K = split {
    nil -> \ v -> v ;
    cons b h | r -> split {
      nil -> nil ;
      cons a f -> cons (kadd a (kneg (kmul c b))) (r f) } } ;

  shorter (d m n : Nat) (e : Id Nat (suc n) (plus d (suc m))) : Id Nat n (plus d m) =
    suc-inj (trans e (plus-suc d m)) ;
  not-shorter (d m : Nat) (e : Id Nat zero (plus d (suc m))) : Empty =
    zero-suc (plus d m) (trans e (plus-suc d m)) ;

  len-axpy (c : K) : (u v : List K) (d : Nat) -> Id Nat (len v) (plus d (len u)) ->
                     Id Nat (len (axpy c u v)) (len v) = split {
    nil -> \ v d e -> refl (len v) ;
    cons b h | r -> split {
      nil -> \ d e -> efq (not-shorter d (len h) e) ;
      cons a f -> \ d e -> ap (\ k -> suc k) (r f d (shorter d (len h) (len f) e)) } } ;

  head-step (c a b : K) :
    Id R (phi (kadd a (kneg (kmul c b)))) (add (phi a) (neg (mul (phi c) (phi b)))) =
    trans (phi-add a (kneg (kmul c b))) (ap (add (phi a)) (trans (phi-neg (kmul c b)) (ap neg (phi-mul c b)))) ;

  -- (A - C B)(Y P) + (F - (C Y) H) = (A (Y P) + F) - (C Y)(B P + H)
  axpy-step (A F H B C Y P : R) :
    Id R (add (mul (add A (neg (mul C B))) (mul Y P)) (add F (neg (mul (mul C Y) H))))
         (add (add (mul A (mul Y P)) F) (neg (mul (mul C Y) (add (mul B P) H)))) =
    calc R { add (mul (add A (neg (mul C B))) (mul Y P)) (add F (neg (mul (mul C Y) H)))
               =< ap (\ t -> add t (add F (neg (mul (mul C Y) H))))
                     (trans (dist-left A (neg (mul C B)) (mul Y P))
                       (ap (add (mul A (mul Y P)))
                         (trans (neg-mul-left (mul C B) (mul Y P)) (ap neg (mul-four C B Y P)))))
               > add (add (mul A (mul Y P)) (neg (mul (mul C Y) (mul B P)))) (add F (neg (mul (mul C Y) H)))
               =< swap (mul A (mul Y P)) (neg (mul (mul C Y) (mul B P))) F (neg (mul (mul C Y) H))
               > add (add (mul A (mul Y P)) F) (add (neg (mul (mul C Y) (mul B P))) (neg (mul (mul C Y) H)))
               =< ap (add (add (mul A (mul Y P)) F)) (sym (neg-add (mul (mul C Y) (mul B P)) (mul (mul C Y) H)))
               > add (add (mul A (mul Y P)) F) (neg (add (mul (mul C Y) (mul B P)) (mul (mul C Y) H)))
               =< ap (\ t -> add (add (mul A (mul Y P)) F) (neg t)) (sym (dist (mul C Y) (mul B P) H))
               > add (add (mul A (mul Y P)) F) (neg (mul (mul C Y) (add (mul B P) H))) } ;

  ev-axpy (c : K) : (u v : List K) (d : Nat) -> Id Nat (len v) (plus d (len u)) ->
    Id R (ev (axpy c u v)) (add (ev v) (neg (mul (mul (phi c) (pow d)) (ev u)))) = split {
    nil -> \ v d e ->
      sym (calc R { add (ev v) (neg (mul (mul (phi c) (pow d)) z))
                      =< ap (\ t -> add (ev v) (neg t)) (mul-zero (mul (phi c) (pow d))) > add (ev v) (neg z)
                      =< ap (add (ev v)) neg-zero > add (ev v) z
                      =< addZ (ev v) > ev v }) ;
    cons b h | r -> split {
      nil -> \ d e -> efq (not-shorter d (len h) e) ;
      cons a f -> \ d e ->
        calc R { add (mul (phi (kadd a (kneg (kmul c b)))) (pow (len (axpy c h f)))) (ev (axpy c h f))
                   =< ap (\ k -> add (mul (phi (kadd a (kneg (kmul c b)))) (pow k)) (ev (axpy c h f)))
                         (trans (len-axpy c h f d (shorter d (len h) (len f) e)) (shorter d (len h) (len f) e))
                   > add (mul (phi (kadd a (kneg (kmul c b)))) (pow (plus d (len h)))) (ev (axpy c h f))
                   =< ap (\ t -> add (mul (phi (kadd a (kneg (kmul c b)))) t) (ev (axpy c h f))) (pow-add d (len h))
                   > add (mul (phi (kadd a (kneg (kmul c b)))) (mul (pow d) (pow (len h)))) (ev (axpy c h f))
                   =< ap (\ t -> add (mul t (mul (pow d) (pow (len h)))) (ev (axpy c h f))) (head-step c a b)
                   > add (mul (add (phi a) (neg (mul (phi c) (phi b)))) (mul (pow d) (pow (len h)))) (ev (axpy c h f))
                   =< ap (add (mul (add (phi a) (neg (mul (phi c) (phi b)))) (mul (pow d) (pow (len h)))))
                         (r f d (shorter d (len h) (len f) e))
                   > add (mul (add (phi a) (neg (mul (phi c) (phi b)))) (mul (pow d) (pow (len h))))
                         (add (ev f) (neg (mul (mul (phi c) (pow d)) (ev h))))
                   =< axpy-step (phi a) (ev f) (ev h) (phi b) (phi c) (pow d) (pow (len h))
                   > add (add (mul (phi a) (mul (pow d) (pow (len h)))) (ev f))
                         (neg (mul (mul (phi c) (pow d)) (add (mul (phi b) (pow (len h))) (ev h))))
                   =< ap (\ t -> add (add (mul (phi a) t) (ev f))
                                     (neg (mul (mul (phi c) (pow d)) (add (mul (phi b) (pow (len h))) (ev h)))))
                         (sym (trans (ap pow (shorter d (len h) (len f) e)) (pow-add d (len h))))
                   > add (add (mul (phi a) (pow (len f))) (ev f))
                         (neg (mul (mul (phi c) (pow d)) (add (mul (phi b) (pow (len h))) (ev h)))) } } } ;
} ;
