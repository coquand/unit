-- Field.seg: a discrete field is noetherian (Kuroki: 1-noetherian).
--
-- Codes are the elements themselves.  Given x: if x = 0, then [x] is good;
-- if x is invertible, every y is y x^-1 times x, so [x,y] is good.
level l ; open Ring[l] ; open Bar[l] ;

-- the ring presented by itself
self (S : CRing) : Span[l].Pres[S] =
  Span[l].mkPres S S.R (\ x -> x) S.z S.o S.add S.mul S.neg (refl S.z) (refl S.o)
    (\ x y -> refl (S.add x y)) (\ x y -> refl (S.mul x y)) (\ x -> refl (S.neg x)) ;

module Over (F : CRing)
  (dec : (x : F.R) -> Plus (Id F.R x F.z) ((y : F.R) * Id F.R (F.mul x y) F.o)) {
  open F ; open RL[F] ;
  module SF = Span[l].Over[F,self F] ;


  -- y - (y x') x = 0
  divide (x x' y : R) (i : Id R (mul x x') o) : Id R (add y (neg (mul (mul y x') x))) z =
    calc R { add y (neg (mul (mul y x') x))
               =< ap (\ t -> add y (neg t)) (trans (sym (mulA y x' x)) (ap (mul y) (trans (mulC x' x) i)))
               > add y (neg (mul y o))
               =< ap (\ t -> add y (neg t)) (mulO y) > add y (neg y)
               =< addN y > z } ;

  branch (x : R) : Plus (Id R x z) ((y : R) * Id R (mul x y) o) -> Tree R = split {
    inl e -> leaf ;
    inr i -> node (\ y -> leaf) } ;

  valid-branch (x : R) : (d : Plus (Id R x z) ((y : R) * Id R (mul x y) o)) ->
                         SF.G.Valid (branch x d) (cons x nil) = split {
    inl e -> inl e ;
    inr i -> \ y -> inl (mul y i.1, divide x i.1 y i.2) } ;

  noeth : SF.Noeth = (node (\ x -> branch x (dec x)), \ x -> valid-branch x (dec x)) ;
} ;
