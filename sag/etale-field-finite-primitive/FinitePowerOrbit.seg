-- The first M powers of an element of exact order M are pairwise
-- distinct. Bounded exponent comparison uses only subtraction witnesses.
level l ; open Ring[l] ; open Presentations[l] ;
module O = NatOrder[l] ;
index : (n : Nat) -> Fin n -> Nat = split {
 zero -> \ i -> efq i ; suc n | rec -> split { inl i -> rec i ; inr t -> n } } ;
bounded : (n : Nat) (i : Fin n) -> O.Lt (index n i) n = split {
 zero -> \ i -> efq i ;
 suc n | rec -> split { inl i -> O.le-suc (suc (index n i)) n (rec i) ; inr t -> O.le-refl (suc n) } } ;
injective : (n : Nat) (i j : Fin n) -> Id Nat (index n i) (index n j) -> Id (Fin n) i j = split {
 zero -> \ i j eq -> efq i ;
 suc n | rec -> split {
  inl i -> split {
   inl j -> \ eq -> ap (\ k -> inl k) (rec i j eq) ;
   inr t -> \ eq -> efq (NaturalProductOrder[l].irrefl n (subst (\ k -> O.Lt k n) eq (bounded n i))) } ;
  inr t -> split {
   inl j -> \ eq -> efq (NaturalProductOrder[l].irrefl n (subst (\ k -> O.Lt k n) (sym eq) (bounded n j))) ;
   inr u -> \ eq -> ap (\ v -> inr v) (MnSums[l].top-eq t u) } } } ;
module Over (A : CRing) (a : A.R) (m : Nat) (exact : MinimalFiniteOrder[l].Over[A].Exact a m) {
 module F = FiniteOrderPowers[l].Over[A] ; module P = F.P ; module L = RL[A] ;
 unit : L.unit a = (P.power a m,exact.1) ;
 product-unit (x y : A.R) (u : L.unit x) (v : L.unit y) : L.unit (A.mul x y) =
  (A.mul u.1 v.1,trans (L.mul-four x y u.1 v.1) (trans (cong2 A.R A.mul _ _ _ _ u.2 v.2) (A.mulO A.o))) ;
 power-unit : (n : Nat) -> L.unit (P.power a n) = split {
  zero -> (A.o,A.mulO A.o) ; suc n | rec -> product-unit a (P.power a n) unit rec } ;
 cancel-unit (x b : A.R) (u : L.unit b) (h : Id A.R (A.mul x b) b) : Id A.R x A.o =
  trans (sym (A.mulO x)) (trans (ap (A.mul x) (sym u.2))
   (trans (A.mulA x b u.1) (trans (ap (\ t -> A.mul t u.1) h) u.2))) ;
 difference (i j d : Nat) (bound : O.Lt i (suc m)) (eq : Id Nat i (plus j d))
  (same : Id A.R (P.power a i) (P.power a j)) : Id Nat i j =
  trans eq
   (trans (ap (plus j)
    (exact.2 d (O.le-trans (suc d) (suc i) (suc m)
      (subst (O.Le d) (sym eq) (O.le-plus-right j d)) bound)
     (cancel-unit (P.power a d) (P.power a j) (power-unit j)
      (trans (A.mulC (P.power a d) (P.power a j))
       (trans (sym (F.power-add a j d)) (trans (ap (P.power a) (sym eq)) same))))))
    (plus-zero j)) ;
 unique-case (i j : Nat) (bi : O.Lt i (suc m)) (bj : O.Lt j (suc m))
  (same : Id A.R (P.power a i) (P.power a j)) :
  Plus ((d : Nat) * Id Nat i (plus j d)) ((d : Nat) * Id Nat j (plus i d)) -> Id Nat i j = split {
   inl d -> difference i j d.1 bi d.2 same ;
   inr d -> sym (difference j i d.1 bj d.2 (sym same)) } ;
 unique (i j : Nat) (bi : O.Lt i (suc m)) (bj : O.Lt j (suc m))
  (same : Id A.R (P.power a i) (P.power a j)) : Id Nat i j = unique-case i j bi bj same (O.compare i j) ;
 orbit (i : Fin (suc m)) : A.R = P.power a (index (suc m) i) ;
 distinct (i j : Fin (suc m)) (same : Id A.R (orbit i) (orbit j)) : Id (Fin (suc m)) i j =
  injective (suc m) i j (unique (index (suc m) i) (index (suc m) j) (bounded (suc m) i) (bounded (suc m) j) same) ;
} ;
