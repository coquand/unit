-- An element whose exact order dominates all unit orders supplies a
-- common exponent for all units. Combining it with any unit gives a
-- common-multiple order; maximality forces that multiple to be one.
level l ; open Ring[l] ; open Presentations[l] ;
module G = NaturalGcd[l] ; module O = NatOrder[l] ;
module TooLarge (m p k : Nat) (eq : Id Nat (suc p) (G.times (suc (suc k)) (suc m))) (bound : O.Le p m) {
 strict : O.Lt (suc m) (suc p) = subst (O.Lt (suc m))
  (sym (trans eq (G.comm (suc (suc k)) (suc m))))
   (GcdStripping[l].strict-product (suc m) k (suc-zero m)) ;
 impossible : Empty = NaturalProductOrder[l].irrefl (suc m)
  (O.le-trans (suc (suc m)) (suc p) (suc m) strict bound) ;
} ;
multiple-bounded (m p : Nat) : (q : Nat) -> Id Nat (suc p) (G.times q (suc m)) -> O.Le p m -> Id Nat (suc p) (suc m) = split {
 zero -> \ eq bound -> efq (suc-zero p eq) ;
 suc q -> positive q }
 where {
 positive : (q : Nat) -> Id Nat (suc p) (G.times (suc q) (suc m)) -> O.Le p m -> Id Nat (suc p) (suc m) = split {
  zero -> \ eq bound -> trans eq (G.one-left (suc m)) ;
  suc k -> \ eq bound -> efq TooLarge[m,p,k,eq,bound].impossible } } ;
module Over (A : CRing) (gamma : A.R) (m : Nat)
 (exact : MinimalFiniteOrder[l].Over[A].Exact gamma m)
 (dominates : (a : A.R) -> RL[A].unit a ->
  (j : Nat) * (MinimalFiniteOrder[l].Over[A].Exact a j * O.Le j m)) {
 module F = FiniteOrderPowers[l].Over[A] ; module Combine = OrderCombination[l].Over[A] ;
 module At (a : A.R) (unit : RL[A].unit a) {
  order : (j : Nat) * (F.Exact a j * O.Le j m) = dominates a unit ;
  module C = Combine.At[gamma,a,m,order.1,exact,order.2.1] ;
  bound-order : (j : Nat) * (F.Exact C.element j * O.Le j m) = dominates C.element C.invertible ;
  bound : O.Le C.predecessor m = O.le-trans C.predecessor bound-order.1 m
   (Combine.exact-le C.element C.predecessor bound-order.1 C.exact bound-order.2.1) bound-order.2.2 ;
  equality : Id Nat (suc C.predecessor) (suc m) = multiple-bounded m C.predecessor C.parts.left-quotient C.left-multiple bound ;
  result : F.Period a (suc m) =
   trans (ap (F.P.power a) (trans (sym equality) C.right-multiple))
    (F.multiple a (suc order.1) order.2.1.1 C.parts.right-quotient) ;
 } ;
 theorem (a : A.R) (unit : RL[A].unit a) : F.Period a (suc m) = At[a,unit].result ;
} ;
