-- A complete enumeration-to-polynomial bridge. The cardinality is proved
-- to be at least two, and one monic list T^Q-T works for every element.
-- Its coefficients can lie in any base ring mapping to the finite field.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module FF = FinitePermutationFold[l] ;
module H = RingHom[l] ;
singleton-prop : (i j : Fin (suc zero)) -> Id (Fin (suc zero)) i j = split {
 inl e -> \ j -> efq e ;
 inr u -> split { inl e -> efq e ; inr v -> ap (\ t -> inr t) (MnSums[l].top-eq u v) } } ;
module Over (K A : CRing) (setA : Pr.isSet A.R) (rho : H.Hom K A)
 (dec : (x : A.R) -> Plus (Id A.R x A.z) (RL[A].unit x))
 (nontrivial : Not (Id A.R A.o A.z)) {
 module C = FrobeniusPolynomial[l].Coefficients[K] ;
 module Powers = FiniteFieldPowers[l].Over[A,setA,dec,nontrivial] ;
 module DN = QuadraticPairs[l].Over[A,setA,A.z] ;
 dual-map : H.Hom K DN.ring = H.compose K A DN.ring DN.inclusion rho ;
 value (p : List K.R) (x : A.R) : A.R = MonicReduce[l].Horner[K,A,rho,x].horner (C.monic p) ;
 slope (p : List K.R) (x : A.R) : A.R =
  (MonicReduce[l].Horner[K,DN.ring,dual-map,(x,A.o)].horner (C.monic p)).2 ;
 record Data (Q : Nat) {
  m : Nat ;
  cardinality : Id Nat Q (suc (suc m)) ;
  root : (x : A.R) -> Id A.R (value (C.lower m) x) A.z ;
  separable : (x : A.R) -> Id A.R (A.mul (slope (C.lower m) x) (A.neg A.o)) A.o
 } ;
 module Positive (m : Nat) (enumerate : Fin (suc (suc m)) -> A.R) (index : A.R -> Fin (suc (suc m)))
  (ei : (x : A.R) -> Id A.R (enumerate (index x)) x)
  (ie : (i : Fin (suc (suc m))) -> Id (Fin (suc (suc m))) (index (enumerate i)) i) {
  module P = Powers.At[suc m,enumerate,index,ei,ie] ;
  module F (x : A.R) { module FP = FrobeniusPolynomial[l].At[K,A,setA,rho,m,x,P.cardinal-zero,P.frobenius x] ; } ;
  result : Data[suc (suc m)] = new Data[suc (suc m),m,refl (suc (suc m)),\ x -> F[x].FP.root,\ x -> F[x].FP.separable] ;
 } ;
 positive : (n : Nat) (enumerate : Fin (suc n) -> A.R) (index : A.R -> Fin (suc n)) ->
  ((x : A.R) -> Id A.R (enumerate (index x)) x) ->
  ((i : Fin (suc n)) -> Id (Fin (suc n)) (index (enumerate i)) i) -> Data[suc n] = split {
  zero -> \ enumerate index ei ie -> efq (nontrivial
   (trans (sym (ei A.o)) (trans (ap enumerate (singleton-prop (index A.o) (index A.z))) (ei A.z)))) ;
  suc m | rec -> \ enumerate index ei ie ->
   Positive[m,enumerate,index,ei,ie].result } ;
 construct : (Q : Nat) (enumerate : Fin Q -> A.R) (index : A.R -> Fin Q) ->
  ((x : A.R) -> Id A.R (enumerate (index x)) x) ->
  ((i : Fin Q) -> Id (Fin Q) (index (enumerate i)) i) -> Data[Q] = split {
  zero -> \ enumerate index ei ie -> efq (index A.z) ;
  suc n | rec -> positive n } ;
 module Enumerated (Q : Nat) (enumerate : Fin Q -> A.R)
  (injective : (i j : Fin Q) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin Q) i j)
  (onto : (x : A.R) -> Tr.Trunc[(i : Fin Q) * Id A.R (enumerate i) x].carrier) {
  module E = FiniteFieldEnumeration[l].Over[A.R,setA,Q,enumerate,injective,onto] ;
  theorem : Data[Q] = construct Q enumerate E.index E.enumerate-index E.index-enumerate ;
  lower : List K.R = C.lower theorem.m ;
  root (x : A.R) : Id A.R (value lower x) A.z = theorem.root x ;
  separable (x : A.R) : Id A.R (A.mul (slope lower x) (A.neg A.o)) A.o = theorem.separable x ;
 } ;
} ;
