-- Bounded search constructs an exact positive order from any positive
-- closing exponent. No group theorem or excluded middle is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module O = NatOrder[l] ; module FF = FinitePermutationFold[l] ;
module Over (A : CRing) {
 module Power = FF.Over[A.R,A.o,A.mul,A.mulA,A.mulC,A.mulO] ;
 Exact (a : A.R) (m : Nat) : U l =
  Id A.R (Power.power a (suc m)) A.o *
   ((r : Nat) -> O.Lt r (suc m) -> Id A.R (Power.power a r) A.o -> Id Nat r zero) ;
 module At (a : A.R)
  (decide : (r : Nat) -> Plus (Id A.R (Power.power a r) A.o) (Not (Id A.R (Power.power a r) A.o))) {
  NoPositive (m : Nat) : U l = (r : Nat) -> O.Le (suc r) m -> Not (Id A.R (Power.power a (suc r)) A.o) ;
  Found (m : Nat) : U l = (j : Nat) * (Exact a j * O.Le (suc j) m) ;
  State (m : Nat) : U l = Plus (Found m) (NoPositive m) ;
  minimal (m : Nat) (h : NoPositive m) :
   (r : Nat) -> O.Lt r (suc m) -> Id A.R (Power.power a r) A.o -> Id Nat r zero = split {
    zero -> \ bound eq -> refl zero ;
    suc r -> \ bound eq -> efq (h r bound eq) } ;
  extend-case (m : Nat) (h : NoPositive m) (last : Not (Id A.R (Power.power a (suc m)) A.o))
   (r : Nat) : Plus (O.Lt (suc r) (suc m)) (Id Nat (suc r) (suc m)) -> Not (Id A.R (Power.power a (suc r)) A.o) = split {
    inl bound -> h r bound ;
    inr eq -> \ root -> last (trans (ap (Power.power a) (sym eq)) root) } ;
  extend (m : Nat) (h : NoPositive m) (last : Not (Id A.R (Power.power a (suc m)) A.o)) : NoPositive (suc m) =
   \ r bound -> extend-case m h last r (O.le-cases (suc r) (suc m) bound) ;
  choose (m : Nat) (h : NoPositive m) :
   Plus (Id A.R (Power.power a (suc m)) A.o) (Not (Id A.R (Power.power a (suc m)) A.o)) -> State (suc m) = split {
    inl root -> inl (m,((root,minimal m h),O.le-refl (suc m))) ;
    inr no -> inr (extend m h no) } ;
  advance (m : Nat) : State m -> State (suc m) = split {
   inl f -> inl (f.1,(f.2.1,O.le-suc (suc f.1) m f.2.2)) ;
   inr h -> choose m h (decide (suc m)) } ;
  search : (m : Nat) -> State m = split {
   zero -> inr (\ r bound eq -> efq bound) ;
   suc m | rec -> advance m rec } ;
  finish (m : Nat) (root : Id A.R (Power.power a (suc m)) A.o) : State (suc m) -> Found (suc m) = split {
   inl f -> f ; inr h -> efq (h m (O.le-refl (suc m)) root) } ;
  theorem (m : Nat) (root : Id A.R (Power.power a (suc m)) A.o) : Found (suc m) = finish m root (search (suc m)) ;
 } ;
} ;
