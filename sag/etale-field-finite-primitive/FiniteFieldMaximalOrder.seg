-- Every nonzero element has an exact positive order by bounded search.
-- A maximum among the finitely many orders gives an actual unit gamma
-- whose order bounds every other order. Cyclicity is a separate theorem.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module O = NatOrder[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (dec : (x : A.R) -> Plus (Id A.R x A.z) (RL[A].unit x))
 (nontrivial : Not (Id A.R A.o A.z)) {
 module L = RL[A] ; module Powers = FiniteFieldPowers[l].Over[A,setA,dec,nontrivial] ;
 module Order = MinimalFiniteOrder[l].Over[A] ; module P = Order.Power ; module Root = PolynomialRootBound[l].Over[A] ;
 unit-nonzero (x : A.R) (u : L.unit x) (h : Id A.R x A.z) : Empty =
  nontrivial (trans (sym u.2) (trans (ap (\ a -> A.mul a u.1) h) (L.zero-mul u.1))) ;
 zero-case (a : A.R) : Plus (Id A.R a A.z) (L.unit a) -> Plus (Id A.R a A.z) (Not (Id A.R a A.z)) = split {
  inl h -> inl h ; inr u -> inr (unit-nonzero a u) } ;
 zero-dec (a : A.R) : Plus (Id A.R a A.z) (Not (Id A.R a A.z)) = zero-case a (dec a) ;
 equal-case (a b : A.R) : Plus (Id A.R (A.add a (A.neg b)) A.z) (Not (Id A.R (A.add a (A.neg b)) A.z)) ->
  Plus (Id A.R a b) (Not (Id A.R a b)) = split {
   inl h -> inl (Root.sub-zero a b h) ;
   inr no -> inr (\ h -> no (trans (ap (\ x -> A.add x (A.neg b)) h) (A.addN b))) } ;
 equal (a b : A.R) : Plus (Id A.R a b) (Not (Id A.R a b)) = equal-case a b (zero-dec (A.add a (A.neg b))) ;
 module At (m : Nat) (enumerate : Fin (suc (suc m)) -> A.R)
  (injective : (i j : Fin (suc (suc m))) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin (suc (suc m))) i j)
  (onto : (x : A.R) -> Tr.Trunc[(i : Fin (suc (suc m))) * Id A.R (enumerate i) x].carrier) {
  size : Nat = suc (suc m) ;
  module E = FiniteFieldEnumeration[l].Over[A.R,setA,size,enumerate,injective,onto] ;
  module F = Powers.At[suc m,enumerate,E.index,E.enumerate-index,E.index-enumerate] ;
  module AtIndex (i : Fin size) {
   module Search = Order.At[F.entry i,\ r -> equal (P.power (F.entry i) r) A.o] ;
   module Nonzero = F.Nonzero[F.entry i,F.entry-unit i] ;
   found : Search.Found (suc m) = Search.theorem m Nonzero.fermat ;
  } ;
  order (i : Fin size) : Nat = AtIndex[i].found.1 ;
  exact (i : Fin size) : Order.Exact (F.entry i) (order i) = AtIndex[i].found.2.1 ;
  maximum : FiniteMaximum[l].Maximum size order = FiniteMaximum[l].maximum (suc m) order ;
  gamma : A.R = F.entry maximum.1 ;
  invertible : L.unit gamma = F.entry-unit maximum.1 ;
  predecessor : Nat = order maximum.1 ;
  gamma-order : Order.Exact gamma predecessor = exact maximum.1 ;
  index-not-zero (a : A.R) (u : L.unit a) (h : Id (Fin size) (E.index a) F.zero-index) : Empty =
   unit-nonzero a u (trans (sym (E.enumerate-index a)) (trans (ap enumerate h) (E.enumerate-index A.z))) ;
  entry-value (a : A.R) (u : L.unit a) : Id A.R (F.entry (E.index a)) a =
   trans (F.entry-nonzero (E.index a) (index-not-zero a u)) (E.enumerate-index a) ;
  dominates (a : A.R) (u : L.unit a) : (j : Nat) * (Order.Exact a j * O.Le j predecessor) =
   (order (E.index a),(subst (\ x -> Order.Exact x (order (E.index a))) (entry-value a u) (exact (E.index a)),maximum.2 (E.index a))) ;
 } ;
} ;
