-- Bezout calculations used by gcd stripping. Support(h,v) means that
-- every number coprime to v is coprime to h; it records prime support
-- without defining primes or factorising any integer.
level l ; open Ring[l] ; open Presentations[l] ;
module G = NaturalGcd[l] ; module Z = ZRing[l] ; module L = RL[Z.ring] ;
module J = Integers[l].Over[Z.ring] ;
N : Nat -> Z.ring.R = G.N ; times : Nat -> Nat -> Nat = G.times ;
Coprime : Nat -> Nat -> U l = G.Coprime ;
Support (h v : Nat) : U l = (r : Nat) -> Coprime r v -> Coprime r h ;
one (r : Nat) : Coprime r (suc zero) = (Z.ring.z,(Z.ring.o,
 sym (trans (ap (Z.ring.add (Z.ring.mul Z.ring.z (N r))) (Z.ring.mulO Z.ring.o))
  (trans (ap (\ x -> Z.ring.add x Z.ring.o) (L.zero-mul (N r))) (L.zl Z.ring.o))))) ;
support-one (v : Nat) : Support (suc zero) v = \ r c -> one r ;
swap (a b : Nat) (c : Coprime a b) : Coprime b a =
 (c.2.1,(c.1,trans c.2.2 (Z.ring.addC (Z.ring.mul c.1 (N a)) (Z.ring.mul c.2.1 (N b))))) ;
module Divisor (r v g q : Nat) (eq : Id Nat v (times q g)) (c : Coprime r v) {
 result : Coprime r g = (c.1,(Z.ring.mul c.2.1 (N q),
  trans c.2.2 (ap (Z.ring.add (Z.ring.mul c.1 (N r)))
   (trans (ap (Z.ring.mul c.2.1) (trans (ap N eq) (J.iota-mul q g))) (Z.ring.mulA c.2.1 (N q) (N g)))))) ;
} ;
divisor (v g q : Nat) (eq : Id Nat v (times q g)) : Support g v = \ r c -> Divisor[r,v,g,q,eq,c].result ;
module Product (r a b : Nat) (c : Coprime r a) (d : Coprime r b) {
 left : Z.ring.R = Z.ring.add c.1 (Z.ring.mul (Z.ring.mul c.2.1 (N a)) d.1) ;
 right : Z.ring.R = Z.ring.mul c.2.1 d.2.1 ;
 equation : Id Z.ring.R Z.ring.o
  (Z.ring.add (Z.ring.mul left (N r)) (Z.ring.mul right (N (times a b)))) =
  calc Z.ring.R {
   Z.ring.o =< c.2.2 > Z.ring.add (Z.ring.mul c.1 (N r)) (Z.ring.mul c.2.1 (N a))
    =< ap (Z.ring.add (Z.ring.mul c.1 (N r)))
      (trans (sym (Z.ring.mulO (Z.ring.mul c.2.1 (N a)))) (ap (Z.ring.mul (Z.ring.mul c.2.1 (N a))) d.2.2))
     > Z.ring.add (Z.ring.mul c.1 (N r)) (Z.ring.mul (Z.ring.mul c.2.1 (N a))
       (Z.ring.add (Z.ring.mul d.1 (N r)) (Z.ring.mul d.2.1 (N b))))
    =< ap (Z.ring.add (Z.ring.mul c.1 (N r)))
      (Z.ring.dist (Z.ring.mul c.2.1 (N a)) (Z.ring.mul d.1 (N r)) (Z.ring.mul d.2.1 (N b)))
     > Z.ring.add (Z.ring.mul c.1 (N r))
       (Z.ring.add (Z.ring.mul (Z.ring.mul c.2.1 (N a)) (Z.ring.mul d.1 (N r)))
        (Z.ring.mul (Z.ring.mul c.2.1 (N a)) (Z.ring.mul d.2.1 (N b))))
    =< ap (Z.ring.add (Z.ring.mul c.1 (N r)))
      (cong2 Z.ring.R Z.ring.add _ _ _ _
       (Z.ring.mulA (Z.ring.mul c.2.1 (N a)) d.1 (N r))
       (trans (L.mul-four c.2.1 (N a) d.2.1 (N b)) (ap (Z.ring.mul right) (sym (J.iota-mul a b)))))
     > Z.ring.add (Z.ring.mul c.1 (N r))
       (Z.ring.add (Z.ring.mul (Z.ring.mul (Z.ring.mul c.2.1 (N a)) d.1) (N r)) (Z.ring.mul right (N (times a b))))
    =< Z.ring.addA (Z.ring.mul c.1 (N r)) (Z.ring.mul (Z.ring.mul (Z.ring.mul c.2.1 (N a)) d.1) (N r)) (Z.ring.mul right (N (times a b)))
     > Z.ring.add (Z.ring.add (Z.ring.mul c.1 (N r)) (Z.ring.mul (Z.ring.mul (Z.ring.mul c.2.1 (N a)) d.1) (N r))) (Z.ring.mul right (N (times a b)))
    =< ap (\ x -> Z.ring.add x (Z.ring.mul right (N (times a b))))
      (sym (L.dist-left c.1 (Z.ring.mul (Z.ring.mul c.2.1 (N a)) d.1) (N r)))
     > Z.ring.add (Z.ring.mul left (N r)) (Z.ring.mul right (N (times a b))) } ;
 result : Coprime r (times a b) = (left,(right,equation)) ;
} ;
product (r a b : Nat) (c : Coprime r a) (d : Coprime r b) : Coprime r (times a b) = Product[r,a,b,c,d].result ;
support-product (a b v : Nat) (ca : Support a v) (cb : Support b v) : Support (times a b) v =
 \ r c -> product r a b (ca r c) (cb r c) ;
module CancelFactor (d m v g u q : Nat)
 (product-factor : Id Nat (times d m) (times u g)) (v-factor : Id Nat v (times q g)) (c : Coprime m v) {
 coefficient : Z.ring.R = Z.ring.add (Z.ring.mul c.1 (N u)) (Z.ring.mul (Z.ring.mul (N d) c.2.1) (N q)) ;
 equation : Id Z.ring.R (N d) (Z.ring.mul coefficient (N g)) =
  calc Z.ring.R {
   N d =< sym (Z.ring.mulO (N d)) > Z.ring.mul (N d) Z.ring.o
    =< ap (Z.ring.mul (N d)) c.2.2 > Z.ring.mul (N d) (Z.ring.add (Z.ring.mul c.1 (N m)) (Z.ring.mul c.2.1 (N v)))
    =< Z.ring.dist (N d) (Z.ring.mul c.1 (N m)) (Z.ring.mul c.2.1 (N v))
     > Z.ring.add (Z.ring.mul (N d) (Z.ring.mul c.1 (N m))) (Z.ring.mul (N d) (Z.ring.mul c.2.1 (N v)))
    =< cong2 Z.ring.R Z.ring.add _ _ _ _
      (trans (L.mul-swap (N d) c.1 (N m))
       (trans (ap (Z.ring.mul c.1) (trans (sym (J.iota-mul d m)) (trans (ap N product-factor) (J.iota-mul u g))))
        (Z.ring.mulA c.1 (N u) (N g))))
      (trans (Z.ring.mulA (N d) c.2.1 (N v))
       (trans (ap (Z.ring.mul (Z.ring.mul (N d) c.2.1)) (trans (ap N v-factor) (J.iota-mul q g)))
        (Z.ring.mulA (Z.ring.mul (N d) c.2.1) (N q) (N g))))
     > Z.ring.add (Z.ring.mul (Z.ring.mul c.1 (N u)) (N g)) (Z.ring.mul (Z.ring.mul (Z.ring.mul (N d) c.2.1) (N q)) (N g))
    =< sym (L.dist-left (Z.ring.mul c.1 (N u)) (Z.ring.mul (Z.ring.mul (N d) c.2.1) (N q)) (N g))
     > Z.ring.mul coefficient (N g) } ;
 quotient : (q : Nat) * Id Nat d (times q g) = G.from-integer d g coefficient equation ;
} ;
plus-zero-left : (a b : Nat) -> Id Nat (plus a b) zero -> Id Nat a zero = split {
 zero -> \ b h -> refl zero ; suc a -> \ b h -> efq (suc-zero (plus a b) h) } ;
product-one : (a b : Nat) -> Id Nat (times a b) (suc zero) -> Id Nat b (suc zero) = split {
 zero -> \ b h -> efq (zero-suc zero h) ;
 suc a -> split {
  zero -> \ h -> efq (zero-suc zero (trans (sym (G.zero-right (suc a))) h)) ;
  suc b -> \ h -> ap (\ k -> suc k) (plus-zero-left b (times a (suc b)) (suc-inj h)) } } ;
module GcdOne (m n : Nat) (c : Coprime m n) {
 g : G.Gcd[m,n] = G.gcd m n ;
 coefficient : Z.ring.R = Z.ring.add (Z.ring.mul c.1 (N g.left)) (Z.ring.mul c.2.1 (N g.right)) ;
 equation : Id Z.ring.R Z.ring.o (Z.ring.mul coefficient (N g.divisor)) =
  trans c.2.2
   (trans (cong2 Z.ring.R Z.ring.add _ _ _ _
    (trans (ap (Z.ring.mul c.1) (trans (ap N g.left-factor) (J.iota-mul g.left g.divisor))) (Z.ring.mulA c.1 (N g.left) (N g.divisor)))
    (trans (ap (Z.ring.mul c.2.1) (trans (ap N g.right-factor) (J.iota-mul g.right g.divisor))) (Z.ring.mulA c.2.1 (N g.right) (N g.divisor))))
    (sym (L.dist-left (Z.ring.mul c.1 (N g.left)) (Z.ring.mul c.2.1 (N g.right)) (N g.divisor)))) ;
 quotient : (q : Nat) * Id Nat (suc zero) (times q g.divisor) = G.from-integer (suc zero) g.divisor coefficient equation ;
 result : Id Nat g.divisor (suc zero) = product-one quotient.1 g.divisor (sym quotient.2) ;
} ;
gcd-one (m n : Nat) (c : Coprime m n) : Id Nat (ZArith[l].euclid m n).g (suc zero) = GcdOne[m,n,c].result ;
