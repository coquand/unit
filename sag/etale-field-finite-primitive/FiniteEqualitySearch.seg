-- Decidable membership in an explicitly indexed finite family.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (X : U l) (equal : (x y : X) -> Plus (Id X x y) (Not (Id X x y))) {
 Witness (n : Nat) (v : Fin n -> X) (x : X) : U l = (i : Fin n) * Id X (v i) x ;
 Missing (n : Nat) (v : Fin n -> X) (x : X) : U l = (i : Fin n) -> Not (Id X (v i) x) ;
 Result (n : Nat) (v : Fin n -> X) (x : X) : U l = Plus (Witness n v x) (Missing n v x) ;
 last-case (n : Nat) (v : Fin (suc n) -> X) (x : X) (old : Missing n (\ i -> v (inl i)) x) :
  Plus (Id X (v (inr tt)) x) (Not (Id X (v (inr tt)) x)) -> Result (suc n) v x = split {
   inl h -> inl (inr tt,h) ;
   inr no -> inr (AffineFinite[l].section n (\ i -> Not (Id X (v i) x)) old no) } ;
 advance (n : Nat) (v : Fin (suc n) -> X) (x : X) : Result n (\ i -> v (inl i)) x -> Result (suc n) v x = split {
  inl h -> inl (inl h.1,h.2) ; inr no -> last-case n v x no (equal (v (inr tt)) x) } ;
 search : (n : Nat) (v : Fin n -> X) (x : X) -> Result n v x = split {
  zero -> \ v x -> inr (\ i -> efq i) ;
  suc n | rec -> \ v x -> advance n v x (rec (\ i -> v (inl i)) x) } ;
} ;
