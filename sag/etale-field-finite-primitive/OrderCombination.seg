-- Two exact positive orders can be combined into an exact order which
-- is a multiple of both. Gcd stripping chooses powers with coprime
-- orders, and the checked exact-product theorem multiplies those orders.
level l ; open Ring[l] ; open Presentations[l] ;
module G = NaturalGcd[l] ; module CP = CoprimeOrderParts[l] ; module O = NatOrder[l] ;
module Over (A : CRing) {
 module F = FiniteOrderPowers[l].Over[A] ; module P = F.P ; module L = RL[A] ;
 module At (a b : A.R) (m n : Nat) (ea : F.Exact a m) (eb : F.Exact b n) {
  parts : CP.Parts[suc m,suc n] = CP.theorem m n ;
  hp : (k : Nat) * Id Nat parts.h (suc k) = CP.predecessor parts.h parts.h-positive ;
  dp : (k : Nat) * Id Nat parts.d (suc k) = CP.predecessor parts.d parts.d-positive ;
  up : (k : Nat) * Id Nat parts.u (suc k) = CP.predecessor parts.u parts.u-positive ;
  wp : (k : Nat) * Id Nat parts.w (suc k) = CP.predecessor parts.w parts.w-positive ;
  alpha : A.R = P.power a (suc hp.1) ; beta : A.R = P.power b (suc dp.1) ;
  left-factor : Id Nat (suc m) (G.times (suc up.1) (suc hp.1)) =
   trans parts.m-factor (trans (G.comm parts.h parts.u) (cong2 Nat G.times _ _ _ _ up.2 hp.2)) ;
  right-factor : Id Nat (suc n) (G.times (suc wp.1) (suc dp.1)) =
   trans parts.n-factor (trans (G.comm parts.d parts.w) (cong2 Nat G.times _ _ _ _ wp.2 dp.2)) ;
  left-order : F.Exact alpha up.1 = F.power-exact a m hp.1 up.1 ea left-factor ;
  right-order : F.Exact beta wp.1 = F.power-exact b n dp.1 wp.1 eb right-factor ;
  coprime : G.Coprime (suc up.1) (suc wp.1) =
   subst (\ x -> G.Coprime x (suc wp.1)) up.2 (subst (G.Coprime parts.u) wp.2 parts.coprime) ;
  module Product = F.ExactProduct[alpha,beta,up.1,wp.1,left-order,right-order,CoprimeArithmetic[l].gcd-one (suc up.1) (suc wp.1) coprime] ;
  element : A.R = A.mul alpha beta ; predecessor : Nat = Product.predecessor ;
  exact : F.Exact element predecessor = Product.exact ;
  invertible : L.unit element = (P.power element predecessor,exact.1) ;
  length : Id Nat (suc predecessor) (G.times parts.u parts.w) =
   trans (G.comm (suc wp.1) (suc up.1)) (cong2 Nat G.times _ _ _ _ (sym up.2) (sym wp.2)) ;
  left-multiple : Id Nat (suc predecessor) (G.times parts.left-quotient (suc m)) = trans length parts.left-multiple ;
  right-multiple : Id Nat (suc predecessor) (G.times parts.right-quotient (suc n)) = trans length parts.right-multiple ;
 } ;
 exact-le-case (a : A.R) (m n : Nat) (em : F.Exact a m) (en : F.Exact a n) :
  Plus (O.Le m n) (O.Lt n m) -> O.Le m n = split {
   inl h -> h ; inr h -> efq (suc-zero n (em.2 (suc n) h en.1)) } ;
 exact-le (a : A.R) (m n : Nat) (em : F.Exact a m) (en : F.Exact a n) : O.Le m n =
  exact-le-case a m n em en (O.le-or-gt m n) ;
} ;
