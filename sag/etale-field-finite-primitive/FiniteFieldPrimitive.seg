-- Full finite-field primitive-element construction from an injective,
-- merely surjective finite enumeration. No factorisation, choice,
-- characteristic classification, or primitive-element axiom is used.
-- The base K is arbitrary: the monomial representations and T^Q-T have
-- coefficients 0,1,-1, so they work over every supplied ring map K -> A.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ;
module Over (K A : CRing) (setA : Pr.isSet A.R) (rho : H.Hom K A)
 (dec : (x : A.R) -> Plus (Id A.R x A.z) (RL[A].unit x))
 (nontrivial : Not (Id A.R A.o A.z)) {
 module C = FrobeniusPolynomial[l].Coefficients[K] ;
 module Annihilator = FiniteFieldAnnihilator[l].Over[K,A,setA,rho,dec,nontrivial] ;
 module Max = FiniteFieldMaximalOrder[l].Over[A,setA,dec,nontrivial] ;
 value (x : A.R) (p : List K.R) : A.R = MonicReduce[l].Horner[K,A,rho,x].horner p ;
 record Data {
  gamma : A.R ;
  invertible : RL[A].unit gamma ;
  lower : List K.R ;
  root : Id A.R (value gamma (C.monic lower)) A.z ;
  slope-unit : Id A.R (A.mul (Annihilator.slope lower gamma) (A.neg A.o)) A.o ;
  representation : (x : A.R) -> (p : List K.R) * Id A.R (value gamma p) x ;
 } ;
 module At (m : Nat) (enumerate : Fin (suc (suc m)) -> A.R)
  (injective : (i j : Fin (suc (suc m))) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin (suc (suc m))) i j)
  (onto : (x : A.R) -> Tr.Trunc[(i : Fin (suc (suc m))) * Id A.R (enumerate i) x].carrier) {
  module M = Max.At[m,enumerate,injective,onto] ;
  module Common = MaximalOrderPeriod[l].Over[A,M.gamma,M.predecessor,M.gamma-order,M.dominates] ;
  module Cyclic = FiniteFieldCyclic[l].Over[A,Max.Powers.inverse,Max.equal,nontrivial,M.gamma,M.predecessor,M.gamma-order,Common.theorem] ;
  module F = Annihilator.Enumerated[suc (suc m),enumerate,injective,onto] ;
  module V = C.At[A,rho,M.gamma] ;
  represent-unit (x : A.R) (unit : RL[A].unit x) : (p : List K.R) * Id A.R (value M.gamma p) x =
   (C.tail (FinitePowerOrbit[l].index (suc M.predecessor) (Cyclic.theorem x unit).1),
    trans (V.tail-value (FinitePowerOrbit[l].index (suc M.predecessor) (Cyclic.theorem x unit).1)) (Cyclic.theorem x unit).2) ;
  choose (x : A.R) : Plus (Id A.R x A.z) (RL[A].unit x) -> (p : List K.R) * Id A.R (value M.gamma p) x = split {
   inl eq -> (nil,sym eq) ; inr unit -> represent-unit x unit } ;
  represent (x : A.R) : (p : List K.R) * Id A.R (value M.gamma p) x = choose x (dec x) ;
  result : Data = new Data[M.gamma,M.invertible,F.lower,F.root M.gamma,F.separable M.gamma,represent] ;
 } ;
 module EmptyEnumeration (enumerate : Fin zero -> A.R)
  (injective : (i j : Fin zero) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin zero) i j)
  (onto : (x : A.R) -> Tr.Trunc[(i : Fin zero) * Id A.R (enumerate i) x].carrier) {
  module E = FiniteFieldEnumeration[l].Over[A.R,setA,zero,enumerate,injective,onto] ;
  result : Data = efq (E.index A.z) ;
 } ;
 module SingletonEnumeration (enumerate : Fin (suc zero) -> A.R)
  (injective : (i j : Fin (suc zero)) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin (suc zero)) i j)
  (onto : (x : A.R) -> Tr.Trunc[(i : Fin (suc zero)) * Id A.R (enumerate i) x].carrier) {
  module E = FiniteFieldEnumeration[l].Over[A.R,setA,suc zero,enumerate,injective,onto] ;
  result : Data = efq (nontrivial (trans (sym (E.enumerate-index A.o))
   (trans (ap enumerate (FiniteFieldAnnihilator[l].singleton-prop (E.index A.o) (E.index A.z))) (E.enumerate-index A.z)))) ;
 } ;
 positive : (n : Nat) (enumerate : Fin (suc n) -> A.R) ->
  ((i j : Fin (suc n)) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin (suc n)) i j) ->
  ((x : A.R) -> Tr.Trunc[(i : Fin (suc n)) * Id A.R (enumerate i) x].carrier) -> Data = split {
   zero -> \ enumerate injective onto -> SingletonEnumeration[enumerate,injective,onto].result ;
   suc m -> \ enumerate injective onto -> At[m,enumerate,injective,onto].result } ;
 theorem : (Q : Nat) (enumerate : Fin Q -> A.R) ->
  ((i j : Fin Q) -> Id A.R (enumerate i) (enumerate j) -> Id (Fin Q) i j) ->
  ((x : A.R) -> Tr.Trunc[(i : Fin Q) * Id A.R (enumerate i) x].carrier) -> Data = split {
   zero -> \ enumerate injective onto -> EmptyEnumeration[enumerate,injective,onto].result ;
   suc n -> positive n } ;
} ;
