-- The existing integer Bezout algorithm, with actual natural-number
-- quotients. Taking absolute values is justified by uniqueness of signed
-- magnitudes; no choice or positivity oracle is required.
level l ; open Ring[l] ; open Presentations[l] ;
module Z = ZRing[l] ; module ZA = ZArith[l] ; module I = Integers[l] ;
module J = I.Over[Z.ring] ; module L = RL[Z.ring] ; module O = NatOrder[l] ;
module Roots = PolynomialRootBound[l].Over[Z.ring] ;
N : Nat -> Z.ring.R = J.iota ;
times : Nat -> Nat -> Nat = I.times ;
zero-right (a : Nat) : Id Nat (times a zero) zero =
 ZA.iota-inj (times a zero) zero (trans (J.iota-mul a zero) (L.mul-zero (N a))) ;
one-right (a : Nat) : Id Nat (times a (suc zero)) a =
 ZA.iota-inj (times a (suc zero)) a (trans (J.iota-mul a (suc zero)) (Z.ring.mulO (N a))) ;
one-left (a : Nat) : Id Nat (times (suc zero) a) a = plus-zero a ;
comm (a b : Nat) : Id Nat (times a b) (times b a) =
 ZA.iota-inj (times a b) (times b a) (trans (J.iota-mul a b) (trans (Z.ring.mulC (N a) (N b)) (sym (J.iota-mul b a)))) ;
assoc (a b c : Nat) : Id Nat (times a (times b c)) (times (times a b) c) =
 ZA.iota-inj (times a (times b c)) (times (times a b) c)
  (trans (J.iota-mul a (times b c))
   (trans (ap (Z.ring.mul (N a)) (J.iota-mul b c))
    (trans (Z.ring.mulA (N a) (N b) (N c))
     (trans (ap (\ x -> Z.ring.mul x (N c)) (sym (J.iota-mul a b))) (sym (J.iota-mul (times a b) c)))))) ;
from-integer (m d : Nat) (c : Z.ring.R) (h : Id Z.ring.R (N m) (Z.ring.mul c (N d))) :
 (q : Nat) * Id Nat m (times q d) =
 ((ZA.abs c).1,ZA.sign-unique (N m) m (times (ZA.abs c).1 d) (inl (refl (N m)))
  (subst (\ x -> ZA.Sign x (times (ZA.abs c).1 d)) (sym h)
   (ZA.sign-mul c (N d) (ZA.abs c).1 d (ZA.abs c).2 (inl (refl (N d)))))) ;
record Gcd (m n : Nat) {
 divisor : Nat ; left : Nat ; right : Nat ;
 left-factor : Id Nat m (times left divisor) ;
 right-factor : Id Nat n (times right divisor) ;
 s : Z.ring.R ; t : Z.ring.R ;
 bezout : Id Z.ring.R (N divisor) (Z.ring.add (Z.ring.mul s (N m)) (Z.ring.mul t (N n))) ;
} ;
module From (m n : Nat) (g : ZA.Gcd2[m,n]) {
 left : (q : Nat) * Id Nat m (times q g.g) = from-integer m g.g g.a g.ea ;
 right : (q : Nat) * Id Nat n (times q g.g) = from-integer n g.g g.b g.eb ;
 result : Gcd[m,n] = new Gcd[m,n,g.g,left.1,right.1,left.2,right.2,g.s,g.t,g.bez] ;
} ;
gcd (m n : Nat) : Gcd[m,n] = From[m,n,ZA.euclid m n].result ;
positive (m n : Nat) (g : Gcd[suc m,n]) : Not (Id Nat g.divisor zero) =
 \ h -> suc-zero m (trans g.left-factor (trans (ap (times g.left) h) (zero-right g.left))) ;
cancel (k : Nat) (x y : Z.ring.R) (h : Id Z.ring.R (Z.ring.mul x (N (suc k))) (Z.ring.mul y (N (suc k)))) :
 Id Z.ring.R x y = Roots.sub-zero x y (ZA.cancel k (Z.ring.add x (Z.ring.neg y))
   (trans (L.dist-left x (Z.ring.neg y) (N (suc k)))
    (trans (cong2 Z.ring.R Z.ring.add _ _ _ _ h (L.neg-mul-left y (N (suc k)))) (Z.ring.addN (Z.ring.mul y (N (suc k))))))) ;
Coprime (m n : Nat) : U l = (s : Z.ring.R) * (t : Z.ring.R) *
 Id Z.ring.R Z.ring.o (Z.ring.add (Z.ring.mul s (N m)) (Z.ring.mul t (N n))) ;
module Cofactors (m n k : Nat) (g : Gcd[m,n]) (positive : Id Nat g.divisor (suc k)) {
 equation : Id Z.ring.R (Z.ring.mul Z.ring.o (N (suc k)))
  (Z.ring.mul (Z.ring.add (Z.ring.mul g.s (N g.left)) (Z.ring.mul g.t (N g.right))) (N (suc k))) =
   trans (L.one-left (N (suc k)))
    (trans (ap N (sym positive))
     (trans g.bezout
      (trans (cong2 Z.ring.R Z.ring.add _ _ _ _
       (ap (Z.ring.mul g.s) (trans (ap N g.left-factor) (J.iota-mul g.left g.divisor)))
       (ap (Z.ring.mul g.t) (trans (ap N g.right-factor) (J.iota-mul g.right g.divisor))))
       (trans (cong2 Z.ring.R Z.ring.add _ _ _ _ (Z.ring.mulA g.s (N g.left) (N g.divisor)) (Z.ring.mulA g.t (N g.right) (N g.divisor)))
        (trans (sym (L.dist-left (Z.ring.mul g.s (N g.left)) (Z.ring.mul g.t (N g.right)) (N g.divisor)))
         (ap (Z.ring.mul (Z.ring.add (Z.ring.mul g.s (N g.left)) (Z.ring.mul g.t (N g.right)))) (ap N positive))))))) ;
 coprime : Coprime g.left g.right = (g.s,(g.t,cancel k Z.ring.o
  (Z.ring.add (Z.ring.mul g.s (N g.left)) (Z.ring.mul g.t (N g.right))) equation)) ;
} ;
