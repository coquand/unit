-- Actual F2 exercises the complete construction, including primitive
-- generation and the separable monic polynomial. Integer order examples
-- force gcd stripping, including repeated removal of the same divisor.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F2 = BooleanRing[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ; four : Nat = suc three ;
five : Nat = suc four ; six : Nat = suc five ; seven : Nat = suc six ; eight : Nat = suc seven ;
nine : Nat = suc eight ; ten : Nat = suc nine ; eleven : Nat = suc ten ; twelve : Nat = suc eleven ;
thirteen : Nat = suc twelve ; fourteen : Nat = suc thirteen ; fifteen : Nat = suc fourteen ; sixteen : Nat = suc fifteen ;
A : CRing = F2.two-ring ;
dec : (x : A.R) -> Plus (Id A.R x A.z) (RL[A].unit x) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
nontrivial : Not (Id A.R A.o A.z) = \ h -> Pr.absurd Empty (F2.true-false h) ;
enumerate : Fin two -> A.R = snoc (Fin one) A.R (\ i -> false) true ;
index : A.R -> Fin two = split { false -> inl (inr tt) ; true -> inr tt } ;
enumerate-index : (x : A.R) -> Id A.R (enumerate (index x)) x = split { false -> refl false ; true -> refl true } ;
index-enumerate : (i : Fin two) -> Id (Fin two) (index (enumerate i)) i = split {
 inl i -> ap (\ j -> inl j) (FiniteFieldAnnihilator[l].singleton-prop (inr tt) i) ;
 inr t -> ap (\ u -> inr u) (MnSums[l].top-eq tt t) } ;
injective (i j : Fin two) (h : Id A.R (enumerate i) (enumerate j)) : Id (Fin two) i j =
 trans (sym (index-enumerate i)) (trans (ap index h) (index-enumerate j)) ;
onto (x : A.R) : Tr.Trunc[(i : Fin two) * Id A.R (enumerate i) x].carrier =
 Tr.Trunc[(i : Fin two) * Id A.R (enumerate i) x].inc (index x,enumerate-index x) ;
module Primitive = FiniteFieldPrimitive[l].Over[A,A,F2.bool-set,H.identity A,dec,nontrivial] ;
result : Primitive.Data = Primitive.theorem two enumerate injective onto ;
root : Id A.R (Primitive.value result.gamma (Primitive.C.monic result.lower)) false = result.root ;
slope-unit : Id A.R (A.mul (Primitive.Annihilator.slope result.lower result.gamma) (A.neg true)) true = result.slope-unit ;
zero-representation : (p : List A.R) * Id A.R (Primitive.value result.gamma p) false = result.representation false ;
one-representation : (p : List A.R) * Id A.R (Primitive.value result.gamma p) true = result.representation true ;
module Max = FiniteFieldMaximalOrder[l].Over[A,F2.bool-set,dec,nontrivial].At[zero,enumerate,injective,onto] ;
unit-one : (x : A.R) -> RL[A].unit x -> Id A.R x true = split {
 false -> \ u -> efq (nontrivial (sym u.2)) ; true -> \ u -> refl true } ;
generator-one : Id A.R Max.gamma true = unit-one Max.gamma Max.invertible ;

module Frobenius = FiniteFieldAnnihilator[l].Over[A,A,F2.bool-set,H.identity A,dec,nontrivial].Enumerated[two,enumerate,injective,onto] ;
lower-list : Id (List A.R) Frobenius.lower (cons false (cons true nil)) = refl (cons false (cons true nil)) ;
module Parts = CoprimeOrderParts[l] ;
parts64 : Parts.Parts[six,four] = Parts.theorem five three ;
removed2 : Id Nat parts64.h two = refl two ;
left-order3 : Id Nat parts64.u three = refl three ;
right-order4 : Id Nat parts64.w four = refl four ;
common12 : Id Nat (NaturalGcd[l].times parts64.u parts64.w) twelve = refl twelve ;
parts816 : Parts.Parts[eight,sixteen] = Parts.theorem seven fifteen ;
factor8 : Id Nat eight (NaturalGcd[l].times parts816.h parts816.u) = parts816.m-factor ;
factor16 : Id Nat sixteen (NaturalGcd[l].times parts816.d parts816.w) = parts816.n-factor ;
repeated-coprime : NaturalGcd[l].Coprime parts816.u parts816.w = parts816.coprime ;
parts11 : Parts.Parts[one,one] = Parts.theorem zero zero ;
trivial-left : Id Nat parts11.u one = refl one ;
trivial-right : Id Nat parts11.w one = refl one ;
