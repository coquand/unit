-- An injective, merely surjective finite enumeration has an actual
-- inverse: each fibre is a proposition. This eliminates truncations
-- pointwise and makes no choice of arbitrary representatives.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (X : U l) (setX : Pr.isSet X) (n : Nat) (enumerate : Fin n -> X)
 (injective : (i j : Fin n) -> Id X (enumerate i) (enumerate j) -> Id (Fin n) i j)
 (onto : (x : X) -> Tr.Trunc[(i : Fin n) * Id X (enumerate i) x].carrier) {
 Fibre (x : X) : U l = (i : Fin n) * Id X (enumerate i) x ;
 fibre-prop (x : X) : Pr.isProp (Fibre x) = \ a b ->
  Pr.Sigma-eq (Fin n) (\ i -> Id X (enumerate i) x) a.1 b.1 a.2 b.2
   (injective a.1 b.1 (trans a.2 (sym b.2))) (setX (enumerate b.1) x) ;
 preimage (x : X) : Fibre x = TC.rec (Fibre x) @l (Fibre x) (fibre-prop x) (\ a -> a) (onto x) ;
 index (x : X) : Fin n = (preimage x).1 ;
 enumerate-index (x : X) : Id X (enumerate (index x)) x = (preimage x).2 ;
 index-enumerate (i : Fin n) : Id (Fin n) (index (enumerate i)) i =
  injective (index (enumerate i)) i (enumerate-index (enumerate i)) ;
} ;
