-- Exact order M plus a common exponent M implies that the first M
-- powers enumerate every unit: an omitted unit would give T^M-1 more
-- than M distinct roots. The index is returned by decidable finite search.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing)
 (inverse : (x : A.R) -> Not (Id A.R x A.z) -> RL[A].unit x)
 (equal : (x y : A.R) -> Plus (Id A.R x y) (Not (Id A.R x y)))
 (nontrivial : Not (Id A.R A.o A.z))
 (gamma : A.R) (m : Nat) (exact : MinimalFiniteOrder[l].Over[A].Exact gamma m)
 (period : (x : A.R) -> RL[A].unit x -> Id A.R (MinimalFiniteOrder[l].Over[A].Power.power x (suc m)) A.o) {
 module Orbit = FinitePowerOrbit[l].Over[A,gamma,m,exact] ; module Power = Orbit.P ;
 module L = RL[A] ; module C = FrobeniusPolynomial[l].Coefficients[A] ;
 module Raw = Poly[l].PolyR[A] ; module MulP = Mul[l].MulR[A] ;
 module Root = PolynomialRootBound[l].Over[A] ; module Bound = Root.Bound ; module Field = Root.Field[inverse] ;
 module Search = FiniteEqualitySearch[l].Over[A.R,equal] ;
 size : Nat = suc m ;
 polynomial : Raw.P = cons (A.neg A.o) (C.tail m) ;
 length : Id Nat (Raw.plen polynomial) (suc size) = ap (\ n -> suc n) (C.tail-length m) ;
 leading : Id A.R (Raw.coef polynomial size) A.o = C.tail-leading m ;
 bound : Bound.Bound (suc size) polynomial = \ k ->
  trans (ap (Raw.coef polynomial) (ap (\ d -> plus d k) (sym length))) (MulP.coef-beyond polynomial k) ;
 tail-value (x : A.R) : (n : Nat) -> Id A.R (Raw.ev (C.tail n) x) (Power.power x n) = split {
  zero -> trans (ap (A.add A.o) (L.mul-zero x)) (A.addZ A.o) ;
  suc n | rec -> trans (L.zl (A.mul x (Raw.ev (C.tail n) x))) (ap (A.mul x) rec) } ;
 value (x : A.R) : Id A.R (Raw.ev polynomial x) (A.add (Power.power x size) (A.neg A.o)) =
  trans (ap (A.add (A.neg A.o)) (ap (A.mul x) (tail-value x m))) (A.addC (A.neg A.o) (Power.power x size)) ;
 root (x : A.R) (unit : RL[A].unit x) : Id A.R (Raw.ev polynomial x) A.z =
  trans (value x) (trans (ap (\ y -> A.add y (A.neg A.o)) (period x unit)) (A.addN A.o)) ;
 module Missing (x : A.R) (unit : RL[A].unit x) (missing : Search.Missing size Orbit.orbit x) {
  family : Fin (suc size) -> A.R = snoc (Fin size) A.R Orbit.orbit x ;
  distinct : (i j : Fin (suc size)) -> Id A.R (family i) (family j) -> Id (Fin (suc size)) i j = split {
   inl i -> split {
    inl j -> \ h -> ap (\ k -> inl k) (Orbit.distinct i j h) ;
    inr t -> \ h -> efq (missing i h) } ;
   inr t -> split {
    inl j -> \ h -> efq (missing j (sym h)) ;
    inr u -> \ h -> ap (\ v -> inr v) (MnSums[l].top-eq t u) } } ;
  roots : (i : Fin (suc size)) -> Id A.R (Raw.ev polynomial (family i)) A.z = split {
   inl i -> root (Orbit.orbit i) (Orbit.power-unit (FinitePowerOrbit[l].index size i)) ;
   inr t -> root x unit } ;
  zero : Raw.peq polynomial nil = Field.theorem (suc size) polynomial bound family distinct roots ;
  impossible : Empty = nontrivial (trans (sym leading) (zero size)) ;
 } ;
 choose (x : A.R) (unit : RL[A].unit x) : Search.Result size Orbit.orbit x -> Search.Witness size Orbit.orbit x = split {
  inl h -> h ; inr no -> efq Missing[x,unit,no].impossible } ;
 theorem (x : A.R) (unit : RL[A].unit x) : (i : Fin size) * Id A.R (Orbit.orbit i) x =
  choose x unit (Search.search size Orbit.orbit x) ;
} ;
