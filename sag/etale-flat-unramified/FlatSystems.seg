-- The finite-relations definition of Flat, with any finite number of
-- relations imposed at once.  The simultaneous refinement is the existing
-- DescentFlat.OneToMany theorem, transported through FlatRelations.Bridge.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R)
 (h : RingHom[l].Hom A B) (flat : FlatRelations[l].Over[A,B,h].Flat) {
 module O = FlatRelations[l].Over[A,B,h] ; module UM = O.Underlying[setA,setB] ;
 module DF = DescentFlat[l].Over[A,setA] ; module DA = DF.At[UM.M] ;
 module CV = O.Converse[setA,setB,O.Bridge[setA,setB,flat].theorem] ;
 module DL = DF.DL ; module MM = DF.MM ;
 module SA = FiniteIdeal[l].Sums[A] ; module SB = FiniteIdeal[l].Sums[B] ;
 record Explanation (n m : Nat) (a : Fin m -> Fin n -> A.R) (b : Fin n -> B.R) {
  size : Nat ;
  column (j : Fin size) (i : Fin n) : A.R ;
  generator (j : Fin size) : B.R ;
  expands (i : Fin n) : Id B.R (b i) (SB.lin size (\ j -> h.1 (column j i)) generator) ;
  relations (v : Fin m) (j : Fin size) : Id A.R (SA.lin n (a v) (column j)) A.z ;
 } ;
 module Given (n m : Nat) (a : Fin m -> Fin n -> A.R) (b : Fin n -> B.R)
  (r : (v : Fin m) -> O.Relation n (a v) b) {
  q : DF.SM.Linear (DL.Free n) UM.M = MM.combination UM.M n b ;
  kill (v : Fin m) : Id UM.M.M (q.1 (a v)) UM.M.mz = trans (UM.combination n b (a v)) (r v) ;
  module From (e : DA.Explanation n m q a) {
   k : Nat = e.1.size ;
   column (j : Fin k) (i : Fin n) : A.R = e.1.through.1 (MM.Free[n].unit i) j ;
   generator (j : Fin k) : B.R = e.1.values.1 (MM.Free[k].unit j) ;
   expands (i : Fin n) : Id B.R (b i) (SB.lin k (\ j -> h.1 (column j i)) generator) =
    trans (sym (DL.On[UM.M].lin-unit n b i))
     (trans (sym (e.1.agrees (MM.Free[n].unit i)))
      (trans (ap e.1.values.1 (sym (MM.Free[k].expansion (e.1.through.1 (MM.Free[n].unit i)))))
       (trans (MM.Map[DL.Free k,UM.M,e.1.values].H.lin k (MM.Free[k].unit) (e.1.through.1 (MM.Free[n].unit i)))
        (UM.combination k generator (e.1.through.1 (MM.Free[n].unit i)))))) ;
   relations (v : Fin m) (j : Fin k) : Id A.R (SA.lin n (a v) (column j)) A.z =
    trans (sym (CV.coordinate k n (\ i -> e.1.through.1 (MM.Free[n].unit i)) (a v) j))
     (trans (ap (\ w -> w j) (sym (MM.Map[DL.Free n,DL.Free k,e.1.through].H.lin n (MM.Free[n].unit) (a v))))
      (trans (ap (\ w -> e.1.through.1 w j) (MM.Free[n].expansion (a v)))
       (Pr.happly (Fin k) (\ w -> A.R) _ _ (e.2 v) j))) ;
   result : Explanation[n,m,a,b] = new Explanation[n,m,a,b,k,column,generator,expands,relations] ;
  } ;
  theorem : Tr.Trunc[Explanation[n,m,a,b]].carrier =
   TC.map (DA.Explanation n m q a) (Explanation[n,m,a,b]) (\ e -> From[e].result)
    (DA.OneToMany[O.Bridge[setA,setB,flat].theorem].theorem m n q a kill) ;
 } ;
 theorem (n m : Nat) (a : Fin m -> Fin n -> A.R) (b : Fin n -> B.R)
  (r : (v : Fin m) -> O.Relation n (a v) b) : Tr.Trunc[Explanation[n,m,a,b]].carrier =
  Given[n,m,a,b,r].theorem ;
} ;
