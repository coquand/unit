-- Two roots a,b of q in D, with q'(a) invertible.  Synthetic division
-- q(X)=(X-a)H(X) gives e=H(b)/H(a).  Then e a=e b, and every ring map
-- identifying a and b sends e to 1.  These are all the averaging proof uses.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module Over (A D T : CRing) (setA : Pr.isSet A.R) (setD : Pr.isSet D.R) (setT : Pr.isSet T.R)
 (iota : H.Hom A D) (mu : H.Hom D T) (a b : D.R)
 (q : PolynomialRing[l].Extension[A,setA].Carrier)
 (ra : Id D.R (StandardEtale[l].Over[A,setA].At[D,setD,iota,a].value q) D.z)
 (rb : Id D.R (StandardEtale[l].Over[A,setA].At[D,setD,iota,b].value q) D.z)
 (dq : RL[D].unit (StandardEtale[l].Over[A,setA].At[D,setD,iota,a].derivative q))
 (same : Id T.R (mu.1 a) (mu.1 b))
 (rep : FlatPolynomialData[l].Coefficients[A,setA].Representation q) {
 module M = FlatPolynomialData[l].Map[A,D,setA,setD,iota] ;
 module VA = FlatEvaluationBaseChange[l].Over[A,D,D,setA,setD,setD,iota,H.identity D,a] ;
 module VB = FlatEvaluationBaseChange[l].Over[A,D,D,setA,setD,setD,iota,H.identity D,b] ;
 module SD = StandardEtale[l].Over[D,setD] ;
 module EA = SD.At[D,setD,H.identity D,a] ; module EB = SD.At[D,setD,H.identity D,b] ;
 module LD = RL[D] ; module LT = RL[T] ;
 base-eq : Id (H.Hom A D) VA.base iota = H.Properties[A,D,setD].ext VA.base iota (\ r -> refl (iota.1 r)) ;
 value-base (x : D.R) : Id D.R
  (StandardEtale[l].Over[A,setA].At[D,setD,VA.base,x].value q)
  (StandardEtale[l].Over[A,setA].At[D,setD,iota,x].value q) =
  ap (\ h -> StandardEtale[l].Over[A,setA].At[D,setD,h,x].value q) base-eq ;
 p : List D.R = M.raw rep.1 ;
 raw-eq : Id M.Q.Carrier (M.Q.include p) (M.f.1 q) =
  trans (sym (M.on-list rep.1)) (ap M.f.1 rep.2) ;
 avalue : Id D.R (EA.value (M.Q.include p)) D.z =
  trans (ap EA.value raw-eq) (trans (VA.value q) (trans (value-base a) ra)) ;
 bvalue : Id D.R (EB.value (M.Q.include p)) D.z =
  trans (ap EB.value raw-eq) (trans (VB.value q) (trans (value-base b) rb)) ;
 module EvalRaw = Evaluation[l].Evaluate[D,D,setD,setD,H.identity D,a] ;
 raw-values : (fs : List D.R) -> Id D.R (EvalRaw.E fs) (Poly[l].PolyR[D].ev fs a) = split {
  nil -> refl D.z ; cons c fs | ih -> ap (\ z -> D.add c (D.mul a z)) ih } ;
 raw-root : Id D.R (Poly[l].PolyR[D].ev p a) D.z =
  trans (sym (raw-values p)) (trans (sym (EvalRaw.D.beta p)) avalue) ;
 module RF = FlatRootFactor[l].Over[D,setD,a,p,raw-root] ;
 ha : D.R = EA.value RF.qpoly ; hb : D.R = EB.value RF.qpoly ;
 derivative : Id D.R (EA.derivative RF.poly) (StandardEtale[l].Over[A,setA].At[D,setD,iota,a].derivative q) =
  trans (ap EA.derivative raw-eq) (trans (VA.derivative q)
   (ap (\ h -> StandardEtale[l].Over[A,setA].At[D,setD,h,a].derivative q) base-eq)) ;
 ha-unit : LD.unit ha = subst LD.unit RF.derivative (subst LD.unit (sym derivative) dq) ;
 e : D.R = D.mul hb ha-unit.1 ;
 killed : Id D.R (D.mul (D.add b (D.neg a)) e) D.z =
  trans (D.mulA (D.add b (D.neg a)) hb ha-unit.1)
   (trans (ap (\ x -> D.mul x ha-unit.1) RF.AtRoot[b,bvalue].kills) (LD.zero-mul ha-unit.1)) ;
 expanded : Id D.R (D.mul (D.add b (D.neg a)) e) (D.add (D.mul e b) (D.neg (D.mul e a))) =
  trans (LD.dist-left b (D.neg a) e)
   (Ps.cong2 D.R D.add _ _ _ _ (D.mulC b e)
    (trans (LD.neg-mul-left a e) (ap D.neg (D.mulC a e)))) ;
 equalizes : Id D.R (D.mul e a) (D.mul e b) =
  sym (FormallyEtale[l].Units[D,setD].sub-zero (D.mul e b) (D.mul e a) (trans (sym expanded) killed)) ;
 module EV = Universal[l].Property[D,T,setD,setT].Given[mu,mu.1 a] ;
 ma : H.Hom M.Q.ring T = H.compose M.Q.ring D T mu EA.ev ;
 mb : H.Hom M.Q.ring T = H.compose M.Q.ring D T mu EB.ev ;
 ma-eq : Id (H.Hom M.Q.ring T) ma EV.extend =
  EV.unique ma (\ d -> ap mu.1 (EA.UP.on-constants d)) (ap mu.1 EA.UP.on-variable) ;
 mb-eq : Id (H.Hom M.Q.ring T) mb EV.extend =
  EV.unique mb (\ d -> ap mu.1 (EB.UP.on-constants d)) (trans (ap mu.1 EB.UP.on-variable) (sym same)) ;
 mh : Id T.R (mu.1 hb) (mu.1 ha) = ap (\ f -> f.1 RF.qpoly) (trans mb-eq (sym ma-eq)) ;
 image : Id T.R (mu.1 e) T.o =
  trans (mu.2.2.2 hb ha-unit.1)
   (trans (ap (\ x -> T.mul x (mu.1 ha-unit.1)) mh)
    (trans (sym (mu.2.2.2 ha ha-unit.1)) (trans (ap mu.1 ha-unit.2) mu.2.1))) ;
} ;
