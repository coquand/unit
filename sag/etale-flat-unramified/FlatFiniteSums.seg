level l ; open Ring[l] ; open Presentations[l] ;
module Over (R : CRing) {
 module S = FiniteIdeal[l].Sums[R] ; module M = MnSums[l].Over[R] ;
 compose (n m : Nat) (a : Fin n -> R.R) (p : Fin n -> Fin m -> R.R) (b : Fin m -> R.R) :
  Id R.R (S.lin n a (\ i -> S.lin m (p i) b))
   (S.lin m (\ j -> S.lin n a (\ i -> p i j)) b) =
  trans (S.sum-cong n (\ i -> R.mul (a i) (S.lin m (p i) b))
   (\ i -> S.sum m (\ j -> R.mul (a i) (R.mul (p i j) (b j))))
   (\ i -> sym (S.sum-scale (a i) m (\ j -> R.mul (p i j) (b j)))))
   (trans (M.exchange m n (\ i j -> R.mul (a i) (R.mul (p i j) (b j))))
    (S.sum-cong m (\ j -> S.sum n (\ i -> R.mul (a i) (R.mul (p i j) (b j))))
     (\ j -> R.mul (S.lin n a (\ i -> p i j)) (b j))
     (\ j -> trans (S.sum-cong n (\ i -> R.mul (a i) (R.mul (p i j) (b j)))
      (\ i -> R.mul (R.mul (a i) (p i j)) (b j)) (\ i -> R.mulA (a i) (p i j) (b j)))
      (M.sum-scale-right (b j) n (\ i -> R.mul (a i) (p i j)))))) ;
} ;
-- Fin n enumerates exactly the indices below n.  Reverse order keeps
-- the recursion on both Nat arguments direct.
index : (n : Nat) -> Fin n -> Nat = split {
 zero -> \ i -> efq i ;
 suc n | ih -> split { inl i -> suc (ih i) ; inr t -> zero } } ;
locate-step (n k : Nat) :
 Plus ((i : Fin n) * Id Nat (index n i) k) (CoefficientBound[l].le n k) ->
 Plus ((i : Fin (suc n)) * Id Nat (index (suc n) i) (suc k)) (CoefficientBound[l].le (suc n) (suc k)) = split {
 inl w -> inl (inl w.1,ap (\ d -> suc d) w.2) ; inr h -> inr h } ;
locate : (n k : Nat) -> Plus ((i : Fin n) * Id Nat (index n i) k) (CoefficientBound[l].le n k) = split {
 zero -> \ k -> inr tt ;
 suc n | ih -> split {
  zero -> inl (inr tt,refl zero) ;
  suc k -> locate-step n k (ih k) } } ;
