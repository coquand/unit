-- Transport localization flatness from explicit fractions to the presented
-- localization used by Local.  Both maps and their retraction law are
-- constructed from the existing universal properties.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (E : Algebras[l].Over[R,setR].Algebra)
 (p : Presentations[l].Over[R,setR].Presentation) (pa : Presentations[l].Over[R,setR].Presents p E)
 (s : E.ring.R) (expr : Presentations[l].Over[R,setR].Expr (Fin p.1))
 (rep : Id E.ring.R (Presentations[l].Over[R,setR].eval (Fin p.1) E pa.1.1 expr) s)
 (flat : FlatRelations[l].Over[R,E.ring,E.iota].Flat) {
 module C = Algebras[l].Over[R,setR] ;
 module L = Localization[l].Over[R,setR,E,p,pa,s,expr,rep] ;
 T : C.Algebra = L.algebra ;
 module P = PowerLocalization[l].Over[E.ring,s] ;
 PF : C.Algebra = C.mkAlgebra P.ring P.set (H.compose R E.ring P.ring P.inclusion E.iota) ;
 inclusion : C.Hom E PF = (P.inclusion,\ r -> refl (P.inclusion.1 (E.iota.1 r))) ;
 toP : C.Hom T PF = L.Canonical[PF].universal.sec (inclusion,P.invertible) ;
 restriction : Id (C.Hom E PF) (C.compose E T PF toP L.inclusion) inclusion =
  ap (\ w -> w.1) (L.Canonical[PF].universal.sec-eq (inclusion,P.invertible)) ;
 on-E (x : E.ring.R) : Id P.ring.R (toP.1.1 (L.inclusion.1.1 x)) (P.inclusion.1 x) =
  ap (\ h -> h.1.1 x) restriction ;
 module Back = FlatPowerLocalization[l].Into[E.ring,s,T.ring,T.set,L.inclusion.1,L.inverse] ;
 back-base (r : R.R) : Id T.ring.R (Back.hom.1 (PF.iota.1 r)) (T.iota.1 r) =
  trans (Back.beta (E.iota.1 r)) (L.inclusion.2 r) ;
 back : C.Hom PF T = (Back.hom,back-base) ;
 composite : C.Hom T T = C.compose T PF T back toP ;
 on-input (x : E.ring.R) : Id T.ring.R (composite.1.1 (L.inclusion.1.1 x)) (L.inclusion.1.1 x) =
  trans (ap Back.hom.1 (on-E x)) (Back.beta x) ;
 equal : Id (C.Hom T T) composite (C.identity T) =
  Equivalences[l].injective (C.Hom T T) L.To[T].Data L.Canonical[T].map L.Canonical[T].universal
   composite (C.identity T)
   (L.To[T].data-ext _ _
    (C.ext E T (C.compose E T T composite L.inclusion) (C.compose E T T (C.identity T) L.inclusion) on-input)) ;
 ret (t : T.ring.R) : Id T.ring.R (Back.hom.1 (toP.1.1 t)) t = ap (\ h -> h.1.1 t) equal ;
 linear (r : R.R) (t : T.ring.R) :
  Id P.ring.R (toP.1.1 (T.ring.mul (T.iota.1 r) t)) (P.ring.mul (PF.iota.1 r) (toP.1.1 t)) =
  trans (toP.1.2.2.2 (T.iota.1 r) t) (ap (\ x -> P.ring.mul x (toP.1.1 t)) (toP.2 r)) ;
 module LF = LocalizationFlat[l].Over[R,E.ring,E.iota,flat,s] ;
 module RT = FlatRetraction[l].Over[R,P.ring,T.ring,PF.iota,T.iota,Back.hom,back-base,toP.1.1,
  H.zero T.ring P.ring toP.1,toP.1.2.2.1,linear,ret,LF.flat] ;
 theorem : FlatRelations[l].Over[R,T.ring,T.iota].Flat = RT.theorem ;
} ;
