-- Two maps from a standard algebra agree after multiplication by e if
-- they do so on its distinguished generator.  Use the quotient by Ann(e)
-- and the standard algebra's universal property; no choice is involved.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ; module SE = StandardEtale[l].Over[A,setA] ;
 module P = SE.RX ;
 module At (q g : P.Carrier) (S : C.Algebra) (st : SE.Points[q,g].Standard S)
  (D : C.Algebra) (f f' : C.Hom S D) (e : D.ring.R)
  (generator : Id D.ring.R (D.ring.mul e (f.1.1 st.1.1)) (D.ring.mul e (f'.1.1 st.1.1))) {
  module L = RL[D.ring] ; module Pt = SE.Points[q,g] ;
  Ann (x : D.ring.R) : U l = Id D.ring.R (D.ring.mul e x) D.ring.z ;
  add (x y : D.ring.R) (hx : Ann x) (hy : Ann y) : Ann (D.ring.add x y) =
   trans (D.ring.dist e x y) (trans (Presentations[l].cong2 D.ring.R D.ring.add _ _ _ _ hx hy) (D.ring.addZ D.ring.z)) ;
  scale (a x : D.ring.R) (hx : Ann x) : Ann (D.ring.mul a x) =
   trans (L.mul-swap e a x) (trans (ap (D.ring.mul a) hx) (L.mul-zero a)) ;
  ideal : RegularIdeal[l].IdealPred[D.ring] = RegularIdeal[l].mkIdealPred D.ring Ann (L.mul-zero e) add scale ;
  module Q = QuotientRing[l].Over[D.ring,ideal,\ x -> D.set _ _] ;
  algebra : C.Algebra = C.mkAlgebra Q.ring Q.set (H.compose A D.ring Q.ring Q.projection D.iota) ;
  projection : C.Hom D algebra = (Q.projection,\ a -> refl (Q.include (D.iota.1 a))) ;
  left : C.Hom S algebra = C.compose S D algebra projection f ;
  right : C.Hom S algebra = C.compose S D algebra projection f' ;
  difference (x y : D.ring.R) :
   Id D.ring.R (D.ring.mul e (D.ring.add x (D.ring.neg y)))
    (D.ring.add (D.ring.mul e x) (D.ring.neg (D.ring.mul e y))) =
   trans (D.ring.dist e x (D.ring.neg y)) (ap (D.ring.add (D.ring.mul e x)) (L.mul-neg e y)) ;
  gen-rel : Q.Rel (f.1.1 st.1.1) (f'.1.1 st.1.1) =
   trans (difference (f.1.1 st.1.1) (f'.1.1 st.1.1))
    (trans (ap (\ x -> D.ring.add x (D.ring.neg (D.ring.mul e (f'.1.1 st.1.1)))) generator)
     (D.ring.addN (D.ring.mul e (f'.1.1 st.1.1)))) ;
  gen-eq : Id Q.Carrier (left.1.1 st.1.1) (right.1.1 st.1.1) = Q.Q.relates _ _ gen-rel ;
  maps : Id (C.Hom S algebra) left right =
   Equivalences[l].injective (C.Hom S algebra) (Pt.Point algebra) (Pt.push S st.1 algebra) (st.2 algebra)
    left right (Pt.point-ext algebra (Pt.push S st.1 algebra left) (Pt.push S st.1 algebra right) gen-eq) ;
  theorem (s : S.ring.R) : Id D.ring.R (D.ring.mul e (f.1.1 s)) (D.ring.mul e (f'.1.1 s)) =
   FormallyEtale[l].Units[D.ring,D.set].sub-zero (D.ring.mul e (f.1.1 s)) (D.ring.mul e (f'.1.1 s))
    (trans (sym (difference (f.1.1 s) (f'.1.1 s))) (Q.Q.effective _ _ (ap (\ h -> h.1.1 s) maps))) ;
 } ;
} ;
