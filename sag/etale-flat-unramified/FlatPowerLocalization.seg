level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Into (A : CRing) (j : A.R) (B : CRing) (setB : Pr.isSet B.R)
 (h : H.Hom A B) (hj : RL[B].unit (h.1 j)) {
 module L = PowerLocalization[l].Over[A,j] ; module PB = AffinePowers[l].Over[B] ;
 units (a : A.R) (w : L.Powers a) : RL[B].unit (h.1 a) =
  subst (RL[B].unit) (sym (trans (ap h.1 w.2) (AffinePowers[l].power-map A B h j w.1)))
   (PB.Units[setB].power-unit (h.1 j) hj w.1) ;
 module M = MonoidLocalizationMap[l].Over[A,L.Powers,L.one,L.product,B,setB,h,units] ;
 hom : H.Hom L.ring B = M.hom ;
 beta (a : A.R) : Id B.R (hom.1 (L.inclusion.1 a)) (h.1 a) = M.constants a ;
} ;
module Unique (A : CRing) (j : A.R) (B : CRing) (setB : Pr.isSet B.R)
 (f g : H.Hom PowerLocalization[l].Over[A,j].ring B)
 (eq : (a : A.R) -> Id B.R (f.1 (PowerLocalization[l].Over[A,j].inclusion.1 a))
  (g.1 (PowerLocalization[l].Over[A,j].inclusion.1 a))) {
 module L = PowerLocalization[l].Over[A,j] ; module LB = RL[B] ;
 module Rg = Regularity[l].Over[B] ;
 equation (h : H.Hom L.ring B) (p : L.L.Raw.Fraction) :
  Id B.R (B.mul (h.1 (L.inclusion.1 p.2.1)) (h.1 (L.L.include p))) (h.1 (L.inclusion.1 p.1)) =
  trans (sym (h.2.2.2 (L.inclusion.1 p.2.1) (L.L.include p))) (ap h.1 (L.L.fraction-equation p)) ;
 raw (p : L.L.Raw.Fraction) : Id B.R (f.1 (L.L.include p)) (g.1 (L.L.include p)) =
  Rg.from-kernel (f.1 (L.inclusion.1 p.2.1))
   (\ z hz -> LB.unit-reg _ z (FormallyEtale[l].unit-map L.ring B f (L.inclusion.1 p.2.1) (L.L.inverse p.2.1 p.2.2)) hz)
   _ _ (trans (equation f p) (trans (eq p.1)
    (trans (sym (equation g p)) (ap (\ a -> B.mul a (g.1 (L.L.include p))) (sym (eq p.2.1)))))) ;
 theorem : (x : L.ring.R) -> Id B.R (f.1 x) (g.1 x) =
  L.L.Q.induction @l (\ x -> Id B.R (f.1 x) (g.1 x)) (\ x -> setB _ _) raw ;
} ;
module Change (A B : CRing) (h : H.Hom A B) (j : A.R) {
 module Source = PowerLocalization[l].Over[A,j] ;
 module Target = PowerLocalization[l].Over[B,h.1 j] ;
 comp : H.Hom A Target.ring = H.compose A B Target.ring Target.inclusion h ;
 module Map = Into[A,j,Target.ring,Target.set,comp,Target.invertible] ;
 hom : H.Hom Source.ring Target.ring = Map.hom ;
 module Flat (flat : FlatRelations[l].Over[A,B,h].Flat) {
  module TargetFlat = LocalizationFlat[l].Over[A,B,h,flat,h.1 j] ;
  module SourceFlat = FlatLocalizedSource[l].Over[A,Target.ring,comp,j,hom,Map.beta,TargetFlat.flat] ;
  theorem : FlatRelations[l].Over[Source.ring,Target.ring,hom].Flat = SourceFlat.theorem ;
 } ;
} ;
