-- Standard etale algebras have unique square-zero lifting.  Existence
-- is one Newton step; uniqueness is StandardEtale.Points.unramified.
-- Representatives are chosen only inside truncation, which is eliminated
-- into the proposition of a lift together with its reduction equation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module E = FormallyEtale[l].Over[A,setA] ;
 module SE = StandardEtale[l].Over[A,setA] ;
 hom-set (S B : C.Algebra) : Pr.isSet (C.Hom S B) =
  Pr.isSet-Sigma (H.Hom S.ring B.ring) (C.Commutes S B) (H.Properties[S.ring,B.ring,B.set].set)
   (\ h -> Pr.prop-to-set (C.Commutes S B h) (C.commutes-prop S B h)) ;
 module Quot (B : C.Algebra) (N : E.SquareZero[B]) {
  module M = E.Mod[B,N] ; module Q = M.Q ;
  module Un = FormallyEtale[l].Units[B.ring,B.set] ;
  Representative (x : Q.Carrier) : U l = (a : B.ring.R) * Id Q.Carrier (Q.include a) x ;
  representative : (x : Q.Carrier) -> Tr.Trunc[Representative x].carrier =
   Q.Q.induction @l (\ x -> Tr.Trunc[Representative x].carrier)
    (\ x -> Tr.Trunc[Representative x].proposition)
    (\ a -> Tr.Trunc[Representative (Q.include a)].inc (a,refl (Q.include a))) ;
  module Unit (x : B.ring.R) (u : RL[Q.ring].unit (Q.include x)) {
   from (v : Representative u.1) : RL[B.ring].unit x =
    E.unit-mod-nilpotent B N x v.1
     (Q.Q.effective (B.ring.mul x v.1) B.ring.o
      (trans (Q.projection.2.2.2 x v.1) (trans (ap (Q.mulQ (Q.include x)) v.2) u.2))) ;
   theorem : RL[B.ring].unit x =
    TC.rec (Representative u.1) @l (RL[B.ring].unit x) (Un.unit-prop x) from (representative u.1) ;
  } ;
 } ;
 module At (q g : SE.RX.Carrier) (S : C.Algebra) (st : SE.Points[q,g].Standard S) {
  module Pt = SE.Points[q,g] ;
  unique : E.Unique S = Pt.unramified S st ;
  module Problem (B : C.Algebra) (N : E.SquareZero[B]) (f : C.Hom S E.Mod[B,N].algebra) {
   module Qr = Quot[B,N] ; module M = Qr.M ; module Q = Qr.Q ;
   module Un = FormallyEtale[l].Units[B.ring,B.set] ; module L = RL[B.ring] ;
   module IL = RegularIdeal[l].IdealLaws[B.ring,N.ideal] ;
   Lift : U l = (h : C.Hom S B) * Id (C.Hom S M.algebra) (E.reduce S B N h) f ;
   lift-prop : Pr.isProp Lift = \ h k ->
    Pr.Sigma-eq (C.Hom S B) (\ h -> Id (C.Hom S M.algebra) (E.reduce S B N h) f)
     h.1 k.1 h.2 k.2 (unique B N h.1 k.1 (trans h.2 (sym k.2))) (hom-set S M.algebra _ _) ;
   p : Pt.Point M.algebra = Pt.push S st.1 M.algebra f ;
   module From (rep : Qr.Representative p.1) {
    a : B.ring.R = rep.1 ;
    module X = SE.At[B.ring,B.set,B.iota,a] ;
    module Nat = SE.Natural[B.ring,Q.ring,B.set,Q.set,B.iota,M.algebra.iota,Q.projection,M.projection.2,a] ;
    value (P : SE.RX.Carrier) : Id Q.Carrier (Q.include (X.value P)) (SE.At[Q.ring,Q.set,M.algebra.iota,p.1].value P) =
     trans (Nat.value P) (ap (\ b -> SE.At[Q.ring,Q.set,M.algebra.iota,b].value P) rep.2) ;
    q-in : N.ideal.In (X.value q) = Q.kernel (X.value q) (trans (value q) p.2.1) ;
    g-unit : RL[B.ring].unit (X.value Pt.g) =
     Qr.Unit[X.value Pt.g,subst (RL[Q.ring].unit) (sym (value Pt.g)) p.2.2].theorem ;
    d-unit : RL[B.ring].unit (X.derivative q) =
     subst (RL[B.ring].unit) (SE.deriv-value B.ring B.set B.iota a q)
      (Un.unit-right (X.value g) (X.value (SE.deriv q))
       (subst (RL[B.ring].unit) (X.ev.2.2.2 g (SE.deriv q)) g-unit)) ;
    eps : B.ring.R = B.ring.neg (B.ring.mul d-unit.1 (X.value q)) ;
    eps-in : N.ideal.In eps = IL.in-neg _ (N.ideal.in-mul d-unit.1 (X.value q) q-in) ;
    b : B.ring.R = B.ring.add a eps ;
    module Taylor = X.Taylor[eps,N.square eps eps eps-in eps-in] ;
    correction : Id B.ring.R (B.ring.mul (X.derivative q) eps) (B.ring.neg (X.value q)) =
     trans (L.mul-neg (X.derivative q) (B.ring.mul d-unit.1 (X.value q)))
      (ap B.ring.neg (trans (B.ring.mulA (X.derivative q) d-unit.1 (X.value q))
       (trans (ap (\ v -> B.ring.mul v (X.value q)) d-unit.2) (L.one-left (X.value q))))) ;
    root : Id B.ring.R (SE.At[B.ring,B.set,B.iota,b].value q) B.ring.z =
     trans (Taylor.taylor q) (trans (ap (B.ring.add (X.value q)) correction) (B.ring.addN (X.value q))) ;
    same : Id Q.Carrier (Q.include b) p.1 =
     trans (Q.projection.2.2.1 a eps)
      (trans (ap (Q.addQ (Q.include a)) (Q.to-zero eps eps-in)) (trans (Q.ring.addZ (Q.include a)) rep.2)) ;
    module Y = SE.At[B.ring,B.set,B.iota,b] ;
    module Ny = SE.Natural[B.ring,Q.ring,B.set,Q.set,B.iota,M.algebra.iota,Q.projection,M.projection.2,b] ;
    g-same : Id Q.Carrier (Q.include (Y.value Pt.g)) (SE.At[Q.ring,Q.set,M.algebra.iota,p.1].value Pt.g) =
     trans (Ny.value Pt.g) (ap (\ c -> SE.At[Q.ring,Q.set,M.algebra.iota,c].value Pt.g) same) ;
    point : Pt.Point B = (b,root,
     Qr.Unit[Y.value Pt.g,subst (RL[Q.ring].unit) (sym g-same) p.2.2].theorem) ;
    h : C.Hom S B = (st.2 B).sec point ;
    h-generator : Id B.ring.R (h.1.1 st.1.1) b = ap (\ t -> t.1) ((st.2 B).sec-eq point) ;
    reduced : Id (C.Hom S M.algebra) (E.reduce S B N h) f =
     Equivalences[l].injective (C.Hom S M.algebra) (Pt.Point M.algebra) (Pt.push S st.1 M.algebra)
      (st.2 M.algebra) (E.reduce S B N h) f
      (Pt.point-ext M.algebra (Pt.push S st.1 M.algebra (E.reduce S B N h)) p
       (trans (E.reduce-at S B N h st.1.1) (trans (ap Q.include h-generator) same))) ;
    theorem : Lift = (h,reduced) ;
   } ;
   theorem : Lift = TC.rec (Qr.Representative p.1) @l Lift lift-prop (\ rep -> From[rep].theorem) (Qr.representative p.1) ;
  } ;
  lift : E.Lift S = \ B N f -> Problem[B,N,f].theorem ;
  formally-etale : E.FormallyEtale S = (lift,unique) ;
  etale (presentation : Presentations[l].Over[A,setA].Witness S) : E.Etale S = (formally-etale,presentation) ;
 } ;
} ;
