-- The separability averaging argument, in exactly the finite-relations
-- flatness interface.  e need only map to 1 and equalize the two generator
-- actions; idempotence is not needed for the module retraction.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ; module SE = StandardEtale[l].Over[A,setA] ;
 module P = SE.RX ;
 module At (q g : P.Carrier) (S T D : C.Algebra) (st : SE.Points[q,g].Standard S)
  (u : C.Hom S T) (left : C.Hom S D) (right : C.Hom T D)
  (mu : H.Hom D.ring T.ring) (ret : (t : T.ring.R) -> Id T.ring.R (mu.1 (right.1.1 t)) t)
  (e : D.ring.R) (me : Id T.ring.R (mu.1 e) T.ring.o)
  (eg : Id D.ring.R (D.ring.mul e (left.1.1 st.1.1)) (D.ring.mul e (right.1.1 (u.1.1 st.1.1))))
  (flat : FlatRelations[l].Over[S.ring,D.ring,left.1].Flat) {
  module LD = RL[D.ring] ; module LT = RL[T.ring] ;
  module Eq = FlatAnnihilatorComparison[l].Over[A,setA].At[q,g,S,st,D,left,C.compose S T D right u,e,eg] ;
  averaged (d : D.ring.R) : Id T.ring.R (mu.1 (D.ring.mul e d)) (mu.1 d) =
   trans (mu.2.2.2 e d) (trans (ap (\ x -> T.ring.mul x (mu.1 d)) me) (LT.one-left (mu.1 d))) ;
  over (s : S.ring.R) : Id T.ring.R (mu.1 (left.1.1 s)) (u.1.1 s) =
   trans (sym (averaged (left.1.1 s)))
    (trans (ap mu.1 (Eq.theorem s)) (trans (averaged (right.1.1 (u.1.1 s))) (ret (u.1.1 s)))) ;
  section (t : T.ring.R) : D.ring.R = D.ring.mul e (right.1.1 t) ;
  section-zero : Id D.ring.R (section T.ring.z) D.ring.z =
   trans (ap (D.ring.mul e) (H.zero T.ring D.ring right.1)) (LD.mul-zero e) ;
  section-add (t v : T.ring.R) : Id D.ring.R (section (T.ring.add t v)) (D.ring.add (section t) (section v)) =
   trans (ap (D.ring.mul e) (right.1.2.2.1 t v)) (D.ring.dist e (right.1.1 t) (right.1.1 v)) ;
  section-scale (s : S.ring.R) (t : T.ring.R) :
   Id D.ring.R (section (T.ring.mul (u.1.1 s) t)) (D.ring.mul (left.1.1 s) (section t)) =
   trans (ap (D.ring.mul e) (right.1.2.2.2 (u.1.1 s) t))
    (trans (D.ring.mulA e (right.1.1 (u.1.1 s)) (right.1.1 t))
     (trans (ap (\ x -> D.ring.mul x (right.1.1 t)) (sym (Eq.theorem s)))
      (trans (sym (D.ring.mulA e (left.1.1 s) (right.1.1 t))) (LD.mul-swap e (left.1.1 s) (right.1.1 t))))) ;
  section-law (t : T.ring.R) : Id T.ring.R (mu.1 (section t)) t = trans (averaged (right.1.1 t)) (ret t) ;
  module Transfer = FlatRetraction[l].Over[S.ring,D.ring,T.ring,left.1,u.1,mu,over,
   section,section-zero,section-add,section-scale,section-law,flat] ;
  theorem : FlatRelations[l].Over[S.ring,T.ring,u.1].Flat = Transfer.theorem ;
 } ;
} ;
