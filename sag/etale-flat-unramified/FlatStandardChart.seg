-- A standard algebra in the existing universal-property API is isomorphic
-- to the explicit quotient/localization chart used in the flatness proof.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ; module SE = StandardEtale[l].Over[A,setA] ;
 module P = SE.RX ;
 module At (q g : P.Carrier) (S : C.Algebra) (st : SE.Points[q,g].Standard S) {
  module Pt = SE.Points[q,g] ;
  module Ch = FlatPolynomialChart[l].Over[A,setA,q,Pt.g] ;
  algebra : C.Algebra = C.mkAlgebra Ch.ring Ch.set Ch.base ;
  module EV = SE.At[Ch.ring,Ch.set,Ch.base,Ch.x] ;
  eval : Id (H.Hom P.ring Ch.ring) Ch.poly EV.ev =
   EV.UP.unique Ch.poly (\ a -> refl (Ch.base.1 a)) (refl Ch.x) ;
  value (p : P.Carrier) : Id Ch.ring.R (EV.value p) (Ch.poly.1 p) = sym (ap (\ h -> h.1 p) eval) ;
  point : Pt.Point algebra = (Ch.x,trans (value q) Ch.root,
   subst (RL[Ch.ring].unit) (sym (value Pt.g)) Ch.unit) ;
  forward : C.Hom S algebra = (st.2 algebra).sec point ;
  forward-x : Id Ch.ring.R (forward.1.1 st.1.1) Ch.x =
   ap (\ p -> p.1) ((st.2 algebra).sec-eq point) ;
  module Back = Ch.Into[S.ring,S.set,S.iota,st.1.1,st.1.2.1,st.1.2.2] ;
  backward : C.Hom algebra S = (Back.hom,Back.on-base) ;
  gf : C.Hom S S = C.compose S algebra S backward forward ;
  gf-x : Id S.ring.R (gf.1.1 st.1.1) st.1.1 = trans (ap Back.hom.1 forward-x) Back.on-x ;
  gf-id : Id (C.Hom S S) gf (C.identity S) =
   Equivalences[l].injective (C.Hom S S) (Pt.Point S) (Pt.push S st.1 S) (st.2 S) gf (C.identity S)
    (Pt.point-ext S (Pt.push S st.1 S gf) (Pt.push S st.1 S (C.identity S)) gf-x) ;
  left (s : S.ring.R) : Id S.ring.R (backward.1.1 (forward.1.1 s)) s = ap (\ f -> f.1.1 s) gf-id ;
  fg : H.Hom Ch.ring Ch.ring = H.compose Ch.ring S.ring Ch.ring forward.1 backward.1 ;
  fg-base (a : A.R) : Id Ch.ring.R (fg.1 (Ch.base.1 a)) (Ch.base.1 a) =
   trans (ap forward.1.1 (Back.on-base a)) (forward.2 a) ;
  fg-x : Id Ch.ring.R (fg.1 Ch.x) Ch.x = trans (ap forward.1.1 Back.on-x) forward-x ;
  right (x : Ch.ring.R) : Id Ch.ring.R (forward.1.1 (backward.1.1 x)) x =
   Ch.Unique[Ch.ring,Ch.set,fg,H.identity Ch.ring,fg-base,fg-x].theorem x ;
  iso : Pr.isEquiv S.ring.R Ch.ring.R forward.1.1 =
   Pr.qinv S.ring.R Ch.ring.R forward.1.1 backward.1.1 right left ;
 } ;
} ;
