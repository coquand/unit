-- Nonreduced regression: A = Z/4Z, q = X^2-X, S standard for (q,1),
-- u : S -> A is evaluation at zero.  S is constructed, rather than given.
-- Transfer proves A flat over S; the kernel theorem is applied to the
-- distinguished root x.  Evaluation at one proves x is not zero.
-- Thus this exercises a genuinely nonzero kernel, as well as the new
-- square-zero lifting theorem over a nonreduced base.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module ZM = ZMod4[l] ;
A : CRing = ZM.ring ;
module C = Algebras[l].Over[A,ZM.set] ;
module SE = StandardEtale[l].Over[A,ZM.set] ; module P = SE.RX ;
module E = FormallyEtale[l].Over[A,ZM.set] ;
q : P.Carrier = P.addQ (P.mulQ P.variable P.variable) (P.negQ P.variable) ;
module Pt = SE.Points[q,P.oneQ] ;
module At (a : A.R) {
 module X = SE.At[A,ZM.set,H.identity A,a] ;
 value : Id A.R (X.value q) (A.add (A.mul a a) (A.neg a)) =
  trans (X.ev.2.2.1 (P.mulQ P.variable P.variable) (P.negQ P.variable))
   (Ps.cong2 A.R A.add _ _ _ _
    (trans (X.ev.2.2.2 P.variable P.variable) (Ps.cong2 A.R A.mul _ _ _ _ X.UP.on-variable X.UP.on-variable))
    (trans (H.negation P.ring A X.ev P.variable) (ap A.neg X.UP.on-variable))) ;
 dual : Id X.DN.Pair (X.evd.1 q) (X.DN.ring.add (X.DN.ring.mul (a,A.o) (a,A.o)) (X.DN.ring.neg (a,A.o))) =
  trans (X.evd.2.2.1 (P.mulQ P.variable P.variable) (P.negQ P.variable))
   (Ps.cong2 X.DN.Pair X.DN.ring.add _ _ _ _
    (trans (X.evd.2.2.2 P.variable P.variable)
     (Ps.cong2 X.DN.Pair X.DN.ring.mul _ _ _ _ X.UPe.on-variable X.UPe.on-variable))
    (trans (H.negation P.ring X.DN.ring X.evd P.variable) (ap X.DN.ring.neg X.UPe.on-variable))) ;
 g-value : Id A.R (X.value Pt.g) (X.derivative q) =
  trans (X.ev.2.2.2 P.oneQ (SE.deriv q))
   (trans (ap (\ z -> A.mul z (X.value (SE.deriv q))) X.ev.2.1)
    (trans (RL[A].one-left (X.value (SE.deriv q))) (SE.deriv-value A ZM.set (H.identity A) a q))) ;
} ;
point0 : Pt.Point C.base = (q0,At[q0].value,
 subst (RL[A].unit) (sym (trans (At[q0].g-value) (ap (\ p -> p.2) At[q0].dual))) (q3,refl q1)) ;
point1 : Pt.Point C.base = (q1,At[q1].value,
 subst (RL[A].unit) (sym (trans (At[q1].g-value) (ap (\ p -> p.2) At[q1].dual))) (q1,refl q1)) ;
different : Not (Id A.R q1 q0) = \ h -> subst (\ x -> ZM.code q1 x) h tt ;
module Reps = FlatPolynomialData[l].Coefficients[A,ZM.set] ;
module Test (rq : Reps.Representation q) (rg : Reps.Representation Pt.g) {
 module SA = StandardAlgebra[l].Over[A,ZM.set].Build[q,P.oneQ,rq.1,rg.1,rq.2,rg.2] ;
 S : C.Algebra = SA.S ;
 u : C.Hom S C.base = (SA.standard.2 C.base).sec point0 ;
 v : C.Hom S C.base = (SA.standard.2 C.base).sec point1 ;
 x : S.ring.R = SA.point.1 ;
 ux : Id A.R (u.1.1 x) A.z = ap (\ p -> p.1) ((SA.standard.2 C.base).sec-eq point0) ;
 vx : Id A.R (v.1.1 x) A.o = ap (\ p -> p.1) ((SA.standard.2 C.base).sec-eq point1) ;
 nonzero : Not (Id S.ring.R x S.ring.z) = \ h ->
  different (trans (sym vx) (trans (ap v.1.1 h) (H.zero S.ring A v.1))) ;
 onto (a : A.R) : Tr.Trunc[(s : S.ring.R) * Id A.R (u.1.1 s) a].carrier =
  Tr.Trunc[(s : S.ring.R) * Id A.R (u.1.1 s) a].inc (S.iota.1 a,u.2 a) ;
 flat : FlatRelations[l].Over[S.ring,A,u.1].Flat =
  FlatStandardTransfer[l].Over[A,ZM.set].At[q,P.oneQ,S,C.base,SA.standard,u,FlatRelations[l].Self[A].flat].theorem ;
 module K = FlatQuotient[l].Over[S.ring,A,u.1,onto,flat] ;
 kernel : Tr.Trunc[K.Witness x].carrier = K.theorem x ux ;
 etale : E.Etale S = StandardEtaleLift[l].Over[A,ZM.set].At[q,P.oneQ,S,SA.standard].etale (SA.Loc.pres,SA.Loc.K.presentation) ;
} ;
-- Package the constructed source and the concrete, nonzero kernel test.
Result : U l+ = (S : C.Algebra) * Pt.Standard S * E.Etale S *
 (u : C.Hom S C.base) * FlatRelations[l].Over[S.ring,A,u.1].Flat *
 (x : S.ring.R) * Id A.R (u.1.1 x) A.z * Not (Id S.ring.R x S.ring.z) *
 Tr.Trunc[(b : S.ring.R) * Id A.R (u.1.1 b) A.z * Id S.ring.R x (S.ring.mul x b)].carrier ;
from (rq : Reps.Representation q) (rg : Reps.Representation Pt.g) : Result =
 (Test[rq,rg].S,Test[rq,rg].SA.standard,Test[rq,rg].etale,Test[rq,rg].u,Test[rq,rg].flat,
  Test[rq,rg].x,Test[rq,rg].ux,Test[rq,rg].nonzero,Test[rq,rg].kernel) ;
from-q (rq : Reps.Representation q) : Truncation[l+].Trunc[Result].carrier =
 Tr.Trunc[Reps.Representation Pt.g].induction @(l+) (\ w -> Truncation[l+].Trunc[Result].carrier)
  (\ w -> Truncation[l+].Trunc[Result].proposition) (\ rg -> Truncation[l+].Trunc[Result].inc (from rq rg)) (Reps.representation Pt.g) ;
regression : Truncation[l+].Trunc[Result].carrier =
 Tr.Trunc[Reps.Representation q].induction @(l+) (\ w -> Truncation[l+].Trunc[Result].carrier)
  (\ w -> Truncation[l+].Trunc[Result].proposition) from-q (Reps.representation q) ;
