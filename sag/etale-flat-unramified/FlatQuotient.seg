-- A surjective flat ring map has idempotent kernel.  Finite equations,
-- with preimages chosen only under propositional truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (S T : CRing) (u : RingHom[l].Hom S T)
 (surj : (t : T.R) -> Tr.Trunc[(s : S.R) * Id T.R (u.1 s) t].carrier)
 (flat : FlatRelations[l].Over[S,T,u].Flat) {
 module FS = FiniteIdeal[l].Sums[S] ; module FT = FiniteIdeal[l].Sums[T] ;
 module O = FlatRelations[l].Over[S,T,u] ; module MS = FlatRelations[l].MapSums[S,T,u] ;
 module LS = RL[S] ; module LT = RL[T] ;
 Kernel (x : S.R) : U l = Id T.R (u.1 x) T.z ;
 -- The witness is stronger than membership in I^2: x = x b with b in I.
 Witness (x : S.R) : U l = (b : S.R) * Kernel b * Id S.R x (S.mul x b) ;
 module At (x : S.R) (hx : Kernel x) {
  a (i : Fin (suc zero)) : S.R = x ;
  b (i : Fin (suc zero)) : T.R = T.o ;
  relation : O.Relation (suc zero) a b =
   trans (T.addZ (T.mul (u.1 x) T.o)) (trans (T.mulO (u.1 x)) hx) ;
  module Explained (e : O.Explanation[suc zero,a,b]) {
   c (j : Fin e.size) : S.R = e.column j (inr tt) ;
   xc (j : Fin e.size) : Id S.R (S.mul x (c j)) S.z =
    trans (sym (S.addZ (S.mul x (c j)))) (e.relations j) ;
   Preimages : U l = (j : Fin e.size) -> (s : S.R) * Id T.R (u.1 s) (e.generator j) ;
   module Chosen (p : Preimages) {
    z : S.R = FS.lin e.size c (\ j -> (p j).1) ;
    uz : Id T.R (u.1 z) T.o =
     trans (MS.lin e.size c (\ j -> (p j).1))
      (trans (FT.sum-cong e.size
       (\ j -> T.mul (u.1 (c j)) (u.1 (p j).1))
       (\ j -> T.mul (u.1 (c j)) (e.generator j))
       (\ j -> ap (T.mul (u.1 (c j))) (p j).2)) (sym (e.expands (inr tt)))) ;
    xz : Id S.R (S.mul x z) S.z =
     trans (sym (FS.sum-scale x e.size (\ j -> S.mul (c j) (p j).1)))
      (trans (FS.sum-cong e.size
       (\ j -> S.mul x (S.mul (c j) (p j).1)) (\ j -> S.z)
       (\ j -> trans (S.mulA x (c j) (p j).1)
        (trans (ap (\ v -> S.mul v (p j).1) (xc j)) (LS.zero-mul (p j).1))))
       (FS.sum-zero e.size)) ;
    k : S.R = S.add S.o (S.neg z) ;
    uk : Kernel k =
     trans (u.2.2.1 S.o (S.neg z))
      (trans (cong2 T.R T.add _ _ _ _ u.2.1
       (trans (RingHom[l].negation S T u z) (ap T.neg uz))) (T.addN T.o)) ;
    xk : Id S.R (S.mul x k) x =
     trans (S.dist x S.o (S.neg z))
      (trans (cong2 S.R S.add _ _ _ _ (S.mulO x)
       (trans (LS.mul-neg x z) (trans (ap S.neg xz) LS.neg-zero))) (S.addZ x)) ;
    result : Witness x = (k,uk,sym xk) ;
   } ;
   result : Tr.Trunc[Witness x].carrier =
    TC.map Preimages (Witness x) (\ p -> Chosen[p].result)
     (AffineFinite[l].choice e.size (\ j -> (s : S.R) * Id T.R (u.1 s) (e.generator j))
      (\ j -> surj (e.generator j))) ;
  } ;
  result : Tr.Trunc[Witness x].carrier =
   TC.bind (O.Explanation[suc zero,a,b]) (Witness x) (\ e -> Explained[e].result)
    (flat (suc zero) a b relation) ;
 } ;
 theorem (x : S.R) (hx : Kernel x) : Tr.Trunc[Witness x].carrier = At[x,hx].result ;
} ;
