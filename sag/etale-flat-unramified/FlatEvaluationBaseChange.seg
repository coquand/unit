-- Polynomial evaluation and the dual-number derivative commute with a
-- change of coefficient ring.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (A B D : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (setD : Pr.isSet D.R)
 (k : H.Hom A B) (h : H.Hom B D) (x : D.R) {
 module M = FlatPolynomialData[l].Map[A,B,setA,setB,k] ;
 base : H.Hom A D = H.compose A B D h k ;
 module EA = StandardEtale[l].Over[A,setA].At[D,setD,base,x] ;
 module EB = StandardEtale[l].Over[B,setB].At[D,setD,h,x] ;
 composed : H.Hom M.P.ring D = H.compose M.P.ring M.Q.ring D EB.ev M.f ;
 values : Id (H.Hom M.P.ring D) composed EA.ev =
  EA.UP.unique composed
   (\ a -> trans (ap EB.ev.1 (M.UP.on-constants a)) (EB.UP.on-constants (k.1 a)))
   (trans (ap EB.ev.1 M.UP.on-variable) EB.UP.on-variable) ;
 value (p : M.P.Carrier) : Id D.R (EB.value (M.f.1 p)) (EA.value p) = ap (\ f -> f.1 p) values ;
 dual : H.Hom M.P.ring EB.DN.ring = H.compose M.P.ring M.Q.ring EB.DN.ring EB.evd M.f ;
 dual-values : Id (H.Hom M.P.ring EB.DN.ring) dual EA.evd =
  EA.UPe.unique dual
   (\ a -> trans (ap EB.evd.1 (M.UP.on-constants a)) (EB.UPe.on-constants (k.1 a)))
   (trans (ap EB.evd.1 M.UP.on-variable) EB.UPe.on-variable) ;
 derivative (p : M.P.Carrier) : Id D.R (EB.derivative (M.f.1 p)) (EA.derivative p) =
  ap (\ f -> (f.1 p).2) dual-values ;
} ;
module Retarget (A D : CRing) (setA : Pr.isSet A.R) (setD : Pr.isSet D.R)
 (h h' : H.Hom A D) (same : (a : A.R) -> Id D.R (h.1 a) (h'.1 a)) (x : D.R) {
 module SE = StandardEtale[l].Over[A,setA] ;
 path : Id (H.Hom A D) h h' = H.Properties[A,D,setD].ext h h' same ;
 value (p : SE.RX.Carrier) : Id D.R (SE.At[D,setD,h,x].value p) (SE.At[D,setD,h',x].value p) =
  ap (\ f -> SE.At[D,setD,f,x].value p) path ;
 derivative (p : SE.RX.Carrier) : Id D.R (SE.At[D,setD,h,x].derivative p) (SE.At[D,setD,h',x].derivative p) =
  ap (\ f -> SE.At[D,setD,f,x].derivative p) path ;
} ;
