-- A direct summand of a flat algebra, as a module, is flat.  The section
-- need not preserve multiplication or the unit.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A B C : CRing) (hB : RingHom[l].Hom A B) (hC : RingHom[l].Hom A C)
 (p : RingHom[l].Hom B C) (over : (a : A.R) -> Id C.R (p.1 (hB.1 a)) (hC.1 a))
 (s : C.R -> B.R) (sz : Id B.R (s C.z) B.z)
 (sa : (x y : C.R) -> Id B.R (s (C.add x y)) (B.add (s x) (s y)))
 (ss : (a : A.R) (x : C.R) -> Id B.R (s (C.mul (hC.1 a) x)) (B.mul (hB.1 a) (s x)))
 (ret : (x : C.R) -> Id C.R (p.1 (s x)) x)
 (flat : FlatRelations[l].Over[A,B,hB].Flat) {
 module OB = FlatRelations[l].Over[A,B,hB] ; module OC = FlatRelations[l].Over[A,C,hC] ;
 module SB = FiniteIdeal[l].Sums[B] ; module SC = FiniteIdeal[l].Sums[C] ;
 linear : (n : Nat) (a : Fin n -> A.R) (b : Fin n -> C.R) ->
  Id B.R (s (SC.lin n (\ i -> hC.1 (a i)) b)) (SB.lin n (\ i -> hB.1 (a i)) (\ i -> s (b i))) = split {
  zero -> \ a b -> sz ;
  suc n | ih -> \ a b ->
   trans (sa (C.mul (hC.1 (a (inr tt))) (b (inr tt))) (SC.lin n (\ i -> hC.1 (a (inl i))) (\ i -> b (inl i))))
    (cong2 B.R B.add _ _ _ _ (ss (a (inr tt)) (b (inr tt))) (ih (\ i -> a (inl i)) (\ i -> b (inl i)))) } ;
 relation (n : Nat) (a : Fin n -> A.R) (b : Fin n -> C.R) (r : OC.Relation n a b) :
  OB.Relation n a (\ i -> s (b i)) = trans (sym (linear n a b)) (trans (ap s r) sz) ;
 module Image = FlatRelations[l].Image[A,B,hB,C,hC,p,over] ;
 theorem : OC.Flat = \ n a b r ->
  OC.Ops[n,a].equal-mere (\ i -> p.1 (s (b i))) b (\ i -> ret (b i))
   (Image.mere n a (\ i -> s (b i)) (flat n a (\ i -> s (b i)) (relation n a b r))) ;
} ;
