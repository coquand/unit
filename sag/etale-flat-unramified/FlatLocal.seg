-- Local flatness extension of zmt2-revised.tex.
-- The candidate construction is the existing Local.seg construction,
-- with its Etale input weakened to a finite presentation and flatness.
-- The introduction, polynomial loop, surjection and kernel generators are
-- unchanged.  The final lifting-based step is replaced by the proved
-- FlatBaseStandardQuotient theorem.  The source's explicit local ZMT and
-- residue-field Factor inputs remain visible; no global ZMT is imported.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FX = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (q a) (q c)) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-out : Not (q (j.1 s)))
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier) {
 module In = Introduction[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,q,q-zero,q-add,q-scale,q-m,q-prime,q-proper,q-dec,
  B,setB,iB,j,j-alg,n',bs,coord,s,s-out,zmt] ;
 module C = Algebras[l].Over[A,setA] ;
 module P = Presentations[l].Over[A,setA] ;
 module FEo = FormallyEtale[l].Over[A,setA] ;
 module SE = StandardEtale[l].Over[A,setA] ;
 module RX = SE.RX ;
 module LE = RL[E] ;
 module St = FlatLocalStatement[l].Over[A,setA,E,setE,iota,q] ;

 module Field (x0 : B.R) (F0 : In.Factor x0) (presentation : P.Witness St.Ealg)
  (flat : FlatRelations[l].Over[A,E,iota].Flat) {
  module FC = In.FieldCase[x0,F0] ;
  module M = FC.M ;
  p : P.Presentation = presentation.1 ;
  pa : P.Presents p St.Ealg = presentation.2 ;
  module GnE = Generated[l].Over[A,setA].Generated[p,St.Ealg,pa] ;
  Rep (x : E.R) : U l = Generated[l].Over[A,setA].Representation p St.Ealg pa x ;
  -- the choices of the Introduction, eliminated into the proposition theorem
  Into (X : U l) (f : X -> Truncation[l+].Trunc[St.Conclusion].carrier) (x : Tr.Trunc[X].carrier) : Truncation[l+].Trunc[St.Conclusion].carrier =
   Tr.Trunc[X].induction @(l+) (\ w -> Truncation[l+].Trunc[St.Conclusion].carrier) (\ w -> Truncation[l+].Trunc[St.Conclusion].proposition) f x ;
  module Run (c0 : M.Choice0) (cm : M.Step0[c0].Choice1) (ch : M.Step0[c0].Step1[cm].Choice)
   (cl : M.Step0[c0].Step1[cm].Chosen[ch].Clearing) {
   module M0 = M.Step0[c0] ; module M1 = M0.Step1[cm] ;
   module Ch = M1.Chosen[ch] ; module Cl = Ch.Cl[cl] ;
   yE : E.R = j.1 M0.y ;
   Q : RX.Carrier = Cl.S1.S1.Q ;
   GX : RX.Carrier = Ch.LIE.Ho.horner Ch.G ;
   module Pt = SE.Points[Q,GX] ;
   module Ay = SE.At[E,setE,iota,yE] ;
   g1 : E.R = Ay.value Pt.g ;
   -- Q(y) = 0
   Q-y : Id E.R (Ay.value Q) E.z = Cl.S1.LQ.Lp.eval-Q Cl.S1.S1.e Cl.S1.S1.a Cl.S1.S1.root ;
   -- G(y) = g and Q'(y) is the Introduction's Q'(y), by definition
   G-y : Id E.R (Ay.value GX) Ch.gE = Ch.LIE.ev-horner Ch.G ;
   Qprime-is : Id E.R (Ay.derivative Q) Cl.Qprime = refl Cl.Qprime ;
   g1-split : Id E.R g1 (E.mul Ch.gE Cl.Qprime) =
    trans (Ay.ev.2.2.2 GX (SE.deriv Q))
     (Ps.cong2 E.R E.mul _ _ _ _ G-y (trans (SE.deriv-value E setE iota yE Q) Qprime-is)) ;
   g1-case : Plus (q Ch.gE) (q Cl.Qprime) -> Empty = split { inl h -> Ch.g-out h ; inr h -> Cl.Qprime-out h } ;
   g1-out : Not (q g1) = \ h -> g1-case (q-prime _ _ (subst q g1-split h)) ;

   module Data (LQ Lg : List A.R) (hQ : Id RX.Carrier (RX.include LQ) Q) (hg : Id RX.Carrier (RX.include Lg) Pt.g)
    (eg : P.Expr (Ps.Fin p.1)) (heg : Id E.R (P.eval (Ps.Fin p.1) St.Ealg pa.1.1 eg) g1)
    (Y : P.Expr (Ps.Fin p.1)) (hY : Id E.R (P.eval (Ps.Fin p.1) St.Ealg pa.1.1 Y) yE)
    (fg : (v : Ps.Fin p.1) -> Ch.CDE.FullAt Ch.G (pa.1.1 v)) {
    ---------------------------------------------------------------
    -- (a) S
    module SA = StandardAlgebra[l].Over[A,setA].Build[Q,GX,LQ,Lg,hQ,hg] ;
    S : C.Algebra = SA.S ;
    st : Pt.Standard S = SA.standard ;
    sS : S.ring.R = SA.point.1 ;
    module LS = RL[S.ring] ; module US = FormallyEtale[l].Units[S.ring,S.set] ;
    module Xs = SE.At[S.ring,S.set,S.iota,sS] ;
    ---------------------------------------------------------------
    -- (b) T = E[1/g1] and u : S -> T
    module LT = Localization[l].Over[A,setA,St.Ealg,p,pa,g1,eg,heg] ;
    T : C.Algebra = LT.algebra ;
    iT : C.Hom St.Ealg T = LT.inclusion ;
    module LTr = RL[T.ring] ; module UT = FormallyEtale[l].Units[T.ring,T.set] ;
    module PT = AffinePowers[l].Over[T.ring] ;
    module NT = SE.Natural[E,T.ring,setE,T.set,iota,T.iota,iT.1,iT.2,yE] ;
    pT : Pt.Point T =
     (iT.1.1 yE,trans (sym (NT.value Q)) (trans (ap iT.1.1 Q-y) (H.zero E T.ring iT.1)),
      subst (RL[T.ring].unit) (NT.value Pt.g) LT.inverse) ;
    u : C.Hom S T = (st.2 T).sec pT ;
    u-push : Id (Pt.Point T) (Pt.push S st.1 T u) pT = (st.2 T).sec-eq pT ;
    -- by definition, push u is u(s)
    push-at (Bp : C.Algebra) (h : C.Hom S Bp) : Id Bp.ring.R (Pt.push S st.1 Bp h).1 (h.1.1 sS) = refl (h.1.1 sS) ;
    u-s : Id T.ring.R (u.1.1 sS) (iT.1.1 yE) = trans (sym (push-at T u)) (ap (\ t -> t.1) u-push) ;
    module Nu = SE.Natural[S.ring,T.ring,S.set,T.set,S.iota,T.iota,u.1,u.2,sS] ;
    -- u(P(s)) = i(P(y))
    u-value (Pp : RX.Carrier) : Id T.ring.R (u.1.1 (Xs.value Pp)) (iT.1.1 (Ay.value Pp)) =
     trans (Nu.value Pp) (trans (ap (\ b -> SE.At[T.ring,T.set,T.iota,b].value Pp) u-s) (sym (NT.value Pp))) ;

    ---------------------------------------------------------------
    -- (c) u is onto
    Preimage (t : T.ring.R) : U l = (x : S.ring.R) * Id T.ring.R (u.1.1 x) t ;
    -- G(s) is a unit (it divides (G Q')(s))
    gS-split : Id S.ring.R (Xs.value Pt.g) (S.ring.mul (Xs.value GX) (Xs.value (SE.deriv Q))) = Xs.ev.2.2.2 GX (SE.deriv Q) ;
    G-unit : RL[S.ring].unit (Xs.value GX) = US.unit-left (Xs.value GX) (Xs.value (SE.deriv Q)) (subst (RL[S.ring].unit) gS-split SA.point.2.2) ;
    gamma : S.ring.R = G-unit.1 ;
    -- i(g) u(gamma) = 1
    u-gamma : Id T.ring.R (T.ring.mul (iT.1.1 Ch.gE) (u.1.1 gamma)) T.ring.o =
     trans (ap (\ t -> T.ring.mul t (u.1.1 gamma)) (sym (trans (u-value GX) (ap iT.1.1 G-y))))
      (trans (sym (u.1.2.2.2 (Xs.value GX) gamma)) (trans (ap u.1.1 G-unit.2) u.1.2.1)) ;
    power-one : (k : Nat) -> Id T.ring.R (PT.power T.ring.o k) T.ring.o = split {
     zero -> refl T.ring.o ; suc k | ih -> trans (LTr.one-left (PT.power T.ring.o k)) ih } ;
    -- a z in E with z g^k = r(y) (Full at z) is the image of r(s) gamma^k
    module PreE (z : E.R) (fz : Ch.CDE.FullAt Ch.G z) {
     r : List A.R = fz.1 ;
     k : Nat = fz.2.1 ;
     R0 : RX.Carrier = Ch.LIE.Ho.horner r ;
     x : S.ring.R = S.ring.mul (Xs.value R0) (AffinePowers[l].Over[S.ring].power gamma k) ;
     -- i(z) i(g)^k = i(r(y))
     iz : Id T.ring.R (T.ring.mul (iT.1.1 z) (PT.power (iT.1.1 Ch.gE) k)) (iT.1.1 (Ay.value R0)) =
      trans (ap (T.ring.mul (iT.1.1 z)) (sym (AffinePowers[l].power-map E T.ring iT.1 Ch.gE k)))
       (trans (sym (iT.1.2.2.2 z (AffinePowers[l].Over[E].power Ch.gE k)))
        (ap iT.1.1 (trans fz.2.2 (sym (Ch.LIE.ev-horner r))))) ;
     image : Id T.ring.R (u.1.1 x) (iT.1.1 z) = calc T.ring.R {
      u.1.1 x
       =< trans (u.1.2.2.2 (Xs.value R0) (AffinePowers[l].Over[S.ring].power gamma k))
           (Ps.cong2 T.ring.R T.ring.mul _ _ _ _ (u-value R0) (AffinePowers[l].power-map S.ring T.ring u.1 gamma k))
        > T.ring.mul (iT.1.1 (Ay.value R0)) (PT.power (u.1.1 gamma) k)
       =< ap (\ t -> T.ring.mul t (PT.power (u.1.1 gamma) k)) (sym iz)
        > T.ring.mul (T.ring.mul (iT.1.1 z) (PT.power (iT.1.1 Ch.gE) k)) (PT.power (u.1.1 gamma) k)
       =< sym (T.ring.mulA (iT.1.1 z) (PT.power (iT.1.1 Ch.gE) k) (PT.power (u.1.1 gamma) k))
        > T.ring.mul (iT.1.1 z) (T.ring.mul (PT.power (iT.1.1 Ch.gE) k) (PT.power (u.1.1 gamma) k))
       =< ap (T.ring.mul (iT.1.1 z)) (trans (sym (PT.power-mul (iT.1.1 Ch.gE) (u.1.1 gamma) k))
            (trans (ap (\ t -> PT.power t k) u-gamma) (power-one k)))
        > T.ring.mul (iT.1.1 z) T.ring.o
       =< T.ring.mulO (iT.1.1 z) > iT.1.1 z } ;
     pre : Preimage (iT.1.1 z) = (x,image) ;
    } ;
    -- 1/g1 is the image of 1/(G Q')(s)
    delta : S.ring.R = SA.point.2.2.1 ;
    u-delta : Id T.ring.R (u.1.1 delta) LT.inverse.1 =
     ap (\ w -> w.1) (UT.unit-prop (iT.1.1 g1)
      (u.1.1 delta,trans (ap (\ t -> T.ring.mul t (u.1.1 delta)) (sym (u-value Pt.g)))
        (trans (sym (u.1.2.2.2 (Xs.value Pt.g) delta)) (trans (ap u.1.1 SA.point.2.2.2) u.1.2.1)))
      LT.inverse) ;
    -- the generators of T and their preimages
    VT : U l = Ps.Fin (suc p.1) ;
    gensT : VT -> T.ring.R = LT.K.A.solution.1 ;
    pre-gen : (v : VT) -> Preimage (gensT v) = split {
     inl w -> subst Preimage (LT.Canonical[T].inclusion-gen w) PreE[pa.1.1 w,fg w].pre ;
     inr t -> subst Preimage (ap (\ t1 -> gensT (inr t1)) (P.top-prop tt t)) (delta,u-delta) } ;
    pre-expr : (e : P.Expr VT) -> Preimage (P.eval VT T gensT e) = split {
     var v -> pre-gen v ;
     cst c -> (S.iota.1 c,u.2 c) ;
     sumE e1 e2 | r1 r2 -> (S.ring.add r1.1 r2.1,trans (u.1.2.2.1 r1.1 r2.1) (Ps.cong2 T.ring.R T.ring.add _ _ _ _ r1.2 r2.2)) ;
     mulE e1 e2 | r1 r2 -> (S.ring.mul r1.1 r2.1,trans (u.1.2.2.2 r1.1 r2.1) (Ps.cong2 T.ring.R T.ring.mul _ _ _ _ r1.2 r2.2)) } ;
    module GnT = Generated[l].Over[A,setA].Generated[LT.pres,T,LT.K.presentation] ;
    surj (t : T.ring.R) : Tr.Trunc[Preimage t].carrier =
     TC.map (Generated[l].Over[A,setA].Representation LT.pres T LT.K.presentation t) (Preimage t)
      (\ w -> subst Preimage w.2 (pre-expr w.1)) (GnT.generated t) ;

    ---------------------------------------------------------------
    -- (d) generators of ker u
    VE : U l = Ps.Fin p.1 ;
    sigma (v : VE) : S.ring.R = PreE[pa.1.1 v,fg v].x ;
    u-sigma (v : VE) : Id T.ring.R (u.1.1 (sigma v)) (iT.1.1 (pa.1.1 v)) = PreE[pa.1.1 v,fg v].image ;
    module LsS = IdealGenerated[l].Lists[S.ring] ;
    r1 : Nat = suc (len {P.Expr VE} p.2) ;
    kgen : Ps.Fin r1 -> S.ring.R = split {
     inl i -> P.eval VE S sigma (LsS.at p.2 i) ;
     inr t -> S.ring.add sS (S.ring.neg (P.eval VE S sigma Y)) } ;
    -- equations hold at the generators of E
    zeros-at (Bz : C.Algebra) (a : VE -> Bz.ring.R) : (es : P.Equations VE) -> P.Zeros VE Bz a es ->
     (i : Ps.Fin (len {P.Expr VE} es)) -> Id Bz.ring.R (P.eval VE Bz a (LsS.at es i)) Bz.ring.z = split {
     nil -> \ zs i -> efq i ;
     cons e es | r -> \ zs -> split { inl i -> r zs.2 i ; inr t -> zs.1 } } ;
    -- u(f(sigma)) = i(f(x)) for an expression f
    u-eval (f : P.Expr VE) : Id T.ring.R (u.1.1 (P.eval VE S sigma f)) (iT.1.1 (P.eval VE St.Ealg pa.1.1 f)) =
     trans (P.natural VE S T u sigma f)
      (trans (Generated[l].Over[A,setA].eval-ext VE T (\ v -> u.1.1 (sigma v)) (\ v -> iT.1.1 (pa.1.1 v)) u-sigma f)
       (sym (P.natural VE St.Ealg T iT pa.1.1 f))) ;
    k-in : (i : Ps.Fin r1) -> Id T.ring.R (u.1.1 (kgen i)) T.ring.z = split {
     inl i -> trans (u-eval (LsS.at p.2 i)) (trans (ap iT.1.1 (zeros-at St.Ealg pa.1.1 p.2 pa.1.2 i)) (H.zero E T.ring iT.1)) ;
     inr t -> trans (u.1.2.2.1 sS (S.ring.neg (P.eval VE S sigma Y)))
      (trans (Ps.cong2 T.ring.R T.ring.add _ _ _ _ u-s
              (trans (H.negation S.ring T.ring u.1 (P.eval VE S sigma Y)) (ap T.ring.neg (trans (u-eval Y) (ap iT.1.1 hY)))))
       (T.ring.addN (iT.1.1 yE))) } ;
    -- K = (k) and S/K
    module KG = RegularIdeal[l].Generated[S.ring,r1,kgen] ;
    module SK = QuotientRing[l].Over[S.ring,KG.ideal,KG.in-prop] ;
    SKa : C.Algebra = C.mkAlgebra SK.ring SK.set (H.compose A S.ring SK.ring SK.projection S.iota) ;
    piK : C.Hom S SKa = (SK.projection,\ c -> refl (SK.include (S.iota.1 c))) ;
    -- E -> S/K, x_v |-> sigma_v
    sigmaK (v : VE) : SK.Carrier = SK.include (sigma v) ;
    zeros-of : (es : P.Equations VE) -> ((i : Ps.Fin (len {P.Expr VE} es)) -> KG.In (P.eval VE S sigma (LsS.at es i))) ->
     P.Zeros VE SKa sigmaK es = split {
     nil -> \ h -> tt ;
     cons e es | r -> \ h -> (trans (sym (P.natural VE S SKa piK sigma e)) (SK.to-zero (P.eval VE S sigma e) (h (inr tt))),r (\ i -> h (inl i))) } ;
    solK : P.Solutions p SKa = (sigmaK,zeros-of p.2 (\ i -> KG.generator (inl i))) ;
    psi0 : C.Hom St.Ealg SKa = (pa.2 SKa).sec solK ;
    psi0-x (v : VE) : Id SK.Carrier (psi0.1.1 (pa.1.1 v)) (sigmaK v) = ap (\ t -> t.1 v) ((pa.2 SKa).sec-eq solK) ;
    -- psi0(y) = s
    psi0-y : Id SK.Carrier (psi0.1.1 yE) (SK.include sS) = calc SK.Carrier {
     psi0.1.1 yE
      =< ap psi0.1.1 (sym hY) > psi0.1.1 (P.eval VE St.Ealg pa.1.1 Y)
      =< P.natural VE St.Ealg SKa psi0 pa.1.1 Y > P.eval VE SKa (\ v -> psi0.1.1 (pa.1.1 v)) Y
      =< Generated[l].Over[A,setA].eval-ext VE SKa (\ v -> psi0.1.1 (pa.1.1 v)) sigmaK psi0-x Y > P.eval VE SKa sigmaK Y
      =< sym (P.natural VE S SKa piK sigma Y) > SK.include (P.eval VE S sigma Y)
      =< sym (SK.Q.relates sS (P.eval VE S sigma Y) (KG.generator (inr tt))) > SK.include sS } ;
    module N0 = SE.Natural[E,SK.ring,setE,SK.set,iota,SKa.iota,psi0.1,psi0.2,yE] ;
    module NK = SE.Natural[S.ring,SK.ring,S.set,SK.set,S.iota,SKa.iota,piK.1,piK.2,sS] ;
    psi0-g1 : RL[SK.ring].unit (psi0.1.1 g1) =
     subst (RL[SK.ring].unit)
      (sym (trans (N0.value Pt.g) (trans (ap (\ b -> SE.At[SK.ring,SK.set,SKa.iota,b].value Pt.g) psi0-y) (sym (NK.value Pt.g)))))
      (FormallyEtale[l].unit-map S.ring SK.ring piK.1 (Xs.value Pt.g) SA.point.2.2) ;
    -- psi : T -> S/K, psi i = psi0
    psi : C.Hom T SKa = (LT.Canonical[SKa].universal).sec (psi0,psi0-g1) ;
    psi-map : Id LT.To[SKa].Data (LT.Canonical[SKa].map psi) (psi0,psi0-g1) = (LT.Canonical[SKa].universal).sec-eq (psi0,psi0-g1) ;
    -- by definition, the map of h restricts h along i
    map-at (Bp : C.Algebra) (h : C.Hom T Bp) : Id (C.Hom St.Ealg Bp) (LT.Canonical[Bp].map h).1 (C.compose St.Ealg T Bp h iT) =
     refl (C.compose St.Ealg T Bp h iT) ;
    psi-i : Id (C.Hom St.Ealg SKa) (C.compose St.Ealg T SKa psi iT) psi0 = trans (sym (map-at SKa psi)) (ap (\ d -> d.1) psi-map) ;
    -- psi u = pi, since both send s to s
    psi-u-s : Id SK.Carrier (Pt.push S st.1 SKa (C.compose S T SKa psi u)).1 (Pt.push S st.1 SKa piK).1 = calc SK.Carrier {
     (Pt.push S st.1 SKa (C.compose S T SKa psi u)).1
      =< trans (push-at SKa (C.compose S T SKa psi u)) (St.compose-at S T SKa psi u sS) > psi.1.1 (u.1.1 sS)
      =< ap psi.1.1 u-s > psi.1.1 (iT.1.1 yE)
      =< trans (sym (St.compose-at St.Ealg T SKa psi iT yE)) (ap (\ h -> h.1.1 yE) psi-i) > psi0.1.1 yE
      =< psi0-y > SK.include sS
      =< sym (push-at SKa piK) > (Pt.push S st.1 SKa piK).1 } ;
    psi-u : Id (C.Hom S SKa) (C.compose S T SKa psi u) piK =
     Equivalences[l].injective (C.Hom S SKa) (Pt.Point SKa) (Pt.push S st.1 SKa) (st.2 SKa) (C.compose S T SKa psi u) piK
      (Pt.point-ext SKa (Pt.push S st.1 SKa (C.compose S T SKa psi u)) (Pt.push S st.1 SKa piK) psi-u-s) ;
    -- u x = 0 gives pi x = psi (u x) = 0
    pi-zero (x : S.ring.R) (hx : Id T.ring.R (u.1.1 x) T.ring.z) : Id SK.Carrier (SK.include x) SK.zeroQ = calc SK.Carrier {
     SK.include x
      =< trans (sym (ap (\ h -> h.1.1 x) psi-u)) (St.compose-at S T SKa psi u x) > psi.1.1 (u.1.1 x)
      =< ap psi.1.1 hx > psi.1.1 T.ring.z
      =< H.zero T.ring SKa.ring psi.1 > SK.zeroQ } ;
    gen (x : S.ring.R) (hx : Id T.ring.R (u.1.1 x) T.ring.z) :
     Tr.Trunc[(c : Ps.Fin r1 -> S.ring.R) * Id S.ring.R x (FiniteIdeal[l].Sums[S.ring].lin r1 kgen c)].carrier =
     TC.map (FiniteIdeal[l].Sums[S.ring].Coordinates r1 kgen x) ((c : Ps.Fin r1 -> S.ring.R) * Id S.ring.R x (FiniteIdeal[l].Sums[S.ring].lin r1 kgen c))
      (\ w -> (w.1,sym w.2)) (SK.kernel x (pi-zero x hx)) ;

    ---------------------------------------------------------------
    -- (e) Localizing a flat algebra preserves flatness over A.
    module TF = FlatPresentedLocalization[l].Over[A,setA,St.Ealg,p,pa,g1,eg,heg,flat] ;
    -- (f) Transfer flatness to S, obtain I = I^2 and reuse the determinant
    -- and standard-localisation construction.  No Lift E is assumed.
    module Th = FlatBaseStandardQuotient[l].Over[A,setA].At[Q,GX,S,T,st,SA.full,u,surj,TF.theorem,r1,kgen,k-in,gen] ;
    localisation : St.IsLocalisation T iT g1 =
     (LT.inverse,\ Bl -> Equivalences[l].homotopy _ _ LT.Canonical[Bl].equivalence (St.Restrict T iT g1 LT.inverse Bl)
       (\ h -> LT.To[Bl].data-ext _ _ (refl (C.compose St.Ealg T Bl h iT)))) ;
    conclusion (res : Th.Result) : St.Conclusion =
     (g1,g1-out,T,iT,localisation,Q,RX.ring.mul GX res.1,res.2,
      StandardEtaleLift[l].Over[A,setA].At[Q,RX.ring.mul GX res.1,T,res.2].etale (LT.pres,LT.K.presentation)) ;
    theorem : Truncation[l+].Trunc[St.Conclusion].carrier =
     Truncation[l+].Trunc[Th.Result].induction @(l+) (\ w -> Truncation[l+].Trunc[St.Conclusion].carrier)
      (\ w -> Truncation[l+].Trunc[St.Conclusion].proposition)
      (\ res -> Truncation[l+].Trunc[St.Conclusion].inc (conclusion res)) Th.theorem ;
   } ;
   -- the choices of lists, expressions and Full at the generators of E
   FullGens : U l = (v : Ps.Fin p.1) -> Ch.CDE.FullAt Ch.G (pa.1.1 v) ;
   theorem : Truncation[l+].Trunc[St.Conclusion].carrier =
    Into (M1.Representative Q) (\ wQ ->
     Into (M1.Representative Pt.g) (\ wg ->
      Into (Rep g1) (\ we ->
       Into (Rep yE) (\ wy ->
        Into FullGens (\ fg -> Data[wQ.1,wg.1,wQ.2,wg.2,we.1,we.2,wy.1,wy.2,fg].theorem)
         (EtaleCase[l].choice p.1 (\ v -> Ch.CDE.FullAt Ch.G (pa.1.1 v)) (\ v -> Ch.full (pa.1.1 v))))
        (GnE.generated yE))
       (GnE.generated g1))
      (M1.representative Pt.g))
     (M1.representative Q) ;
  } ;
  -- Theorem local
  theorem : Truncation[l+].Trunc[St.Conclusion].carrier =
   Into M.Choice0 (\ c0 ->
    Into (M.Step0[c0].Choice1) (\ cm ->
     Into (M.Step0[c0].Step1[cm].Choice) (\ ch ->
      Into (M.Step0[c0].Step1[cm].Chosen[ch].Clearing) (\ cl -> Run[c0,cm,ch,cl].theorem)
       (M.Step0[c0].Step1[cm].Chosen[ch].clearing))
      (M.Step0[c0].Step1[cm].choice))
     (M.Step0[c0].choice1))
    M.choice0 ;
 } ;
} ;
