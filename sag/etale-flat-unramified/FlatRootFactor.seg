-- Synthetic division at a root, and the value of the quotient at that
-- root.  The second identity identifies the quotient value with the
-- derivative used by StandardEtale (evaluation in dual numbers).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (a : A.R) (p : List A.R)
 (root : Id A.R (Poly[l].PolyR[A].ev p a) A.z) {
 module Raw = Poly[l].PolyR[A] ; module P = PolynomialRing[l].Extension[A,setA] ;
 module PC = PolynomialCoefficients[l].Over[A,setA] ;
 module Co = FlatPolynomialData[l].Coefficients[A,setA] ;
 module LA = RL[A] ; module LP = RL[P.ring] ;
 quotient : List A.R = (Raw.sdiv a p).1 ;
 poly : P.Carrier = P.include p ;
 qpoly : P.Carrier = P.include quotient ;
 linear : P.Carrier = P.addQ P.variable (P.constant (A.neg a)) ;
 previous : (k : Nat) -> Id A.R (PC.coef (P.mulQ P.variable qpoly) k) (Raw.cprev quotient k) = split {
  zero -> (PC.shift-coef qpoly).1 ;
  suc k -> trans ((PC.shift-coef qpoly).2 k) (PC.coef-include quotient k) } ;
 factor-coef (k : Nat) : Id A.R (PC.coef (P.mulQ linear qpoly) k) (Raw.mform a quotient k) =
  trans (ap (\ f -> PC.coef f k) (LP.dist-left P.variable (P.constant (A.neg a)) qpoly))
   (trans (Co.add k (P.mulQ P.variable qpoly) (P.mulQ (P.constant (A.neg a)) qpoly))
    (Ps.cong2 A.R A.add _ _ _ _ (previous k)
     (trans (PC.scale-coef (A.neg a) qpoly k)
      (trans (ap (A.mul (A.neg a)) (PC.coef-include quotient k)) (LA.neg-mul-left a (Raw.coef quotient k)))))) ;
 factor : Id P.Carrier poly (P.mulQ linear qpoly) =
  PC.ext poly (P.mulQ linear qpoly) (\ k ->
   trans (PC.coef-include p k) (trans (Raw.root-factor a p root k)
    (trans (Raw.coef-mulXa a quotient k) (sym (factor-coef k))))) ;
 module SE = StandardEtale[l].Over[A,setA] ;
 module At = SE.At[A,setA,H.identity A,a] ;
 module DN = At.DN ;
 dual-linear : Id DN.Pair (At.evd.1 linear) (A.z,A.o) =
  trans (At.evd.2.2.1 P.variable (P.constant (A.neg a)))
   (trans (Ps.cong2 DN.Pair DN.plusQ _ _ _ _ At.UPe.on-variable (At.UPe.on-constants (A.neg a)))
    (DN.eq _ _ (A.addN a) (A.addZ A.o))) ;
 derivative : Id A.R (At.derivative poly) (At.value qpoly) =
  trans (ap (\ f -> (At.evd.1 f).2) factor)
   (trans (ap (\ z -> z.2) (At.evd.2.2.2 linear qpoly))
    (trans (ap (\ z -> (DN.timesQ z (At.evd.1 qpoly)).2) dual-linear)
     (trans (Ps.cong2 A.R A.add _ _ _ _ (LA.zero-mul (At.evd.1 qpoly).2) (LA.one-left (At.evd.1 qpoly).1))
      (trans (LA.zl (At.evd.1 qpoly).1) (At.value-first qpoly))))) ;
 module AtRoot (b : A.R) (rb : Id A.R (SE.At[A,setA,H.identity A,b].value poly) A.z) {
  module EV = SE.At[A,setA,H.identity A,b] ;
  value-linear : Id A.R (EV.value linear) (A.add b (A.neg a)) =
   trans (EV.ev.2.2.1 P.variable (P.constant (A.neg a)))
    (Ps.cong2 A.R A.add _ _ _ _ EV.UP.on-variable (EV.UP.on-constants (A.neg a))) ;
  kills : Id A.R (A.mul (A.add b (A.neg a)) (EV.value qpoly)) A.z =
   trans (ap (\ x -> A.mul x (EV.value qpoly)) (sym value-linear))
    (trans (sym (EV.ev.2.2.2 linear qpoly)) (trans (ap EV.value (sym factor)) rb)) ;
 } ;
} ;
