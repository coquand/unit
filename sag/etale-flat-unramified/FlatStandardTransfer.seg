-- The substantive flatness transfer theorem, with no residual-field or
-- local hypotheses: S standard etale over A and T flat over A imply T
-- flat over S for every A-algebra map S -> T.
-- The scalar extension is constructed as a polynomial quotient/chart,
-- proved flat by finite coefficient equations.  Synthetic division gives
-- the averaging element and hence the module retraction.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ; module SE = StandardEtale[l].Over[A,setA] ;
 module P = SE.RX ;
 module At (q g : P.Carrier) (S T : C.Algebra) (st : SE.Points[q,g].Standard S)
  (u : C.Hom S T) (flat : FlatRelations[l].Over[A,T.ring,T.iota].Flat) {
  module Pt = SE.Points[q,g] ;
  module Iso = FlatStandardChart[l].Over[A,setA].At[q,g,S,st] ;
  module Ch = FlatPolynomialChart[l].Change[A,T.ring,setA,T.set,T.iota,q,Pt.g] ;
  module D = Ch.Target ;
  rho : H.Hom T.ring D.ring = D.base ;
  algebra : C.Algebra = C.mkAlgebra D.ring D.set (H.compose A T.ring D.ring rho T.iota) ;
  right : C.Hom T algebra = (rho,\ a -> refl (rho.1 (T.iota.1 a))) ;
  lambda : H.Hom S.ring D.ring = H.compose S.ring Iso.Ch.ring D.ring Ch.hom Iso.forward.1 ;
  lambda-base (a : A.R) : Id D.ring.R (lambda.1 (S.iota.1 a)) (algebra.iota.1 a) =
   trans (ap Ch.hom.1 (Iso.forward.2 a)) (Ch.on-base a) ;
  left : C.Hom S algebra = (lambda,lambda-base) ;
  module BaseFlat = Ch.Flat[flat] ;
  module Transport = FlatSourceIso[l].Over[Iso.Ch.ring,D.ring,S.ring,Ch.hom,Iso.forward.1,Iso.backward.1,
   Iso.right,Iso.left,BaseFlat.theorem] ;
  flat-D : FlatRelations[l].Over[S.ring,D.ring,lambda].Flat = Transport.theorem ;
  tp : Pt.Point T = Pt.push S st.1 T u ;
  module ET = FlatEvaluationBaseChange[l].Over[A,T.ring,T.ring,setA,T.set,T.set,T.iota,H.identity T.ring,tp.1] ;
  module RT = FlatEvaluationBaseChange[l].Retarget[A,T.ring,setA,T.set,ET.base,T.iota,\ a -> refl (T.iota.1 a),tp.1] ;
  q-root : Id T.ring.R (ET.EB.value (Ch.PM.f.1 q)) T.ring.z =
   trans (ET.value q) (trans (RT.value q) tp.2.1) ;
  g-unit : RL[T.ring].unit (ET.EB.value (Ch.PM.f.1 Pt.g)) =
   subst (RL[T.ring].unit) (sym (trans (ET.value Pt.g) (RT.value Pt.g))) tp.2.2 ;
  module Mu = D.Into[T.ring,T.set,H.identity T.ring,tp.1,q-root,g-unit] ;
  mu : H.Hom D.ring T.ring = Mu.hom ;
  ret (t : T.ring.R) : Id T.ring.R (mu.1 (rho.1 t)) t = Mu.on-base t ;
  apoint : Pt.Point algebra = Pt.push S st.1 algebra left ;
  bpoint : Pt.Point algebra = Pt.push T tp algebra right ;
  a : D.ring.R = apoint.1 ;
  b : D.ring.R = bpoint.1 ;
  a-is-x : Id D.ring.R a D.x = trans (ap Ch.hom.1 Iso.forward-x) Ch.on-x ;
  same : Id T.ring.R (mu.1 a) (mu.1 b) =
   trans (ap mu.1 a-is-x) (trans Mu.on-x (sym (ret tp.1))) ;
  module EA = SE.At[D.ring,D.set,algebra.iota,a] ;
  module DU = FormallyEtale[l].Units[D.ring,D.set] ;
  qprime : RL[D.ring].unit (EA.derivative q) =
   subst (RL[D.ring].unit) (SE.deriv-value D.ring D.set algebra.iota a q)
    (DU.unit-right (EA.value g) (EA.value (SE.deriv q))
     (subst (RL[D.ring].unit) (EA.ev.2.2.2 g (SE.deriv q)) apoint.2.2)) ;
  module Rep = FlatPolynomialData[l].Coefficients[A,setA] ;
  module From (rep : Rep.Representation q) {
   module Elt = FlatSeparabilityElement[l].Over[A,D.ring,T.ring,setA,D.set,T.set,
    algebra.iota,mu,a,b,q,apoint.2.1,bpoint.2.1,qprime,same,rep] ;
   module Retract = FlatSeparableRetraction[l].Over[A,setA].At[q,g,S,T,algebra,st,u,left,right,
    mu,ret,Elt.e,Elt.image,Elt.equalizes,flat-D] ;
   theorem : FlatRelations[l].Over[S.ring,T.ring,u.1].Flat = Retract.theorem ;
  } ;
  module ST = FlatRelations[l].Over[S.ring,T.ring,u.1] ;
  theorem : ST.Flat = \ n a b r ->
   TC.bind (Rep.Representation q) (ST.Explanation[n,a,b])
    (\ rep -> From[rep].theorem n a b r) (Rep.representation q) ;
 } ;
} ;
