-- Restrict a flat A-algebra to the localized source A[1/j], when the
-- structure map extends.  Clearing finitely many coefficient denominators
-- gives a relation over A, whose explained columns work over A[1/j].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A B : CRing) (h : RingHom[l].Hom A B) (j : A.R)
 (g : RingHom[l].Hom PowerLocalization[l].Over[A,j].ring B)
 (over : (a : A.R) -> Id B.R (g.1 (PowerLocalization[l].Over[A,j].inclusion.1 a)) (h.1 a))
 (flat : FlatRelations[l].Over[A,B,h].Flat) {
 module Fr = LocalizationFlat[l].Fractions[A,j] ; module S = Fr.L ;
 module OA = FlatRelations[l].Over[A,B,h] ; module OS = FlatRelations[l].Over[S.ring,B,g] ;
 module SS = FiniteIdeal[l].Sums[S.ring] ; module SB = FiniteIdeal[l].Sums[B] ;
 module MS = FlatRelations[l].MapSums[A,S.ring,S.inclusion] ;
 module LB = RL[B] ; module LS = RL[S.ring] ;
 module Given (n : Nat) (a : Fin n -> S.ring.R) (b : Fin n -> B.R) (r : OS.Relation n a b)
  (d : Nat) (fr : (i : Fin n) -> Fr.Fraction (a i) d) {
  p (i : Fin n) : A.R = (fr i).1 ;
  denom : S.ring.R = Fr.PS.power (S.inclusion.1 j) d ;
  scalar : S.ring.R = Fr.PS.power Fr.u d ;
  cleared (i : Fin n) : Id B.R (h.1 (p i)) (B.mul (g.1 denom) (g.1 (a i))) =
   trans (sym (over (p i)))
    (trans (ap g.1 (Fr.numerator (a i) d (fr i))) (g.2.2.2 denom (a i))) ;
  relation : OA.Relation n p b =
   trans (SB.sum-cong n (\ i -> B.mul (h.1 (p i)) (b i))
    (\ i -> B.mul (g.1 denom) (B.mul (g.1 (a i)) (b i)))
    (\ i -> trans (ap (\ x -> B.mul x (b i)) (cleared i)) (sym (B.mulA (g.1 denom) (g.1 (a i)) (b i)))))
    (trans (SB.sum-scale (g.1 denom) n (\ i -> B.mul (g.1 (a i)) (b i)))
     (trans (ap (B.mul (g.1 denom)) r) (LB.mul-zero (g.1 denom)))) ;
  module Explained (e : OA.Explanation[n,p,b]) {
   column (v : Fin e.size) (i : Fin n) : S.ring.R = S.inclusion.1 (e.column v i) ;
   expands (i : Fin n) : Id B.R (b i) (SB.lin e.size (\ v -> g.1 (column v i)) e.generator) =
    trans (e.expands i) (SB.sum-cong e.size
     (\ v -> B.mul (h.1 (e.column v i)) (e.generator v))
     (\ v -> B.mul (g.1 (column v i)) (e.generator v))
     (\ v -> ap (\ x -> B.mul x (e.generator v)) (sym (over (e.column v i))))) ;
   relations (v : Fin e.size) : Id S.ring.R (SS.lin n a (column v)) S.ring.z =
    trans (SS.sum-cong n (\ i -> S.ring.mul (a i) (column v i))
     (\ i -> S.ring.mul scalar (S.ring.mul (S.inclusion.1 (p i)) (column v i)))
     (\ i -> trans (ap (\ x -> S.ring.mul x (column v i)) (fr i).2)
      (sym (S.ring.mulA scalar (S.inclusion.1 (p i)) (column v i)))))
     (trans (SS.sum-scale scalar n (\ i -> S.ring.mul (S.inclusion.1 (p i)) (column v i)))
      (trans (ap (S.ring.mul scalar) (sym (MS.lin n p (e.column v))))
       (trans (ap (\ x -> S.ring.mul scalar (S.inclusion.1 x)) (e.relations v))
        (trans (ap (S.ring.mul scalar) (RingHom[l].zero A S.ring S.inclusion)) (LS.mul-zero scalar))))) ;
   result : OS.Explanation[n,a,b] = new OS.Explanation[n,a,b,e.size,column,e.generator,expands,relations] ;
  } ;
  result : OS.Explained n a b =
   TC.map (OA.Explanation[n,p,b]) (OS.Explanation[n,a,b]) (\ e -> Explained[e].result) (flat n p b relation) ;
 } ;
 theorem : OS.Flat = \ n a b r ->
  TC.bind ((d : Nat) * ((i : Fin n) -> Fr.Fraction (a i) d)) (OS.Explanation[n,a,b])
   (\ w -> Given[n,a,b,r,w.1,w.2].result) (Fr.common n a) ;
} ;
