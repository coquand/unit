-- (A[X]/Q)[1/g], with an effective quotient and the explicit fraction
-- construction.  Its universal property is proved from those of the two
-- constructions.  No monicity or regularity hypotheses are required.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (q g : PolynomialRing[l].Extension[A,setA].Carrier) {
 module P = PolynomialRing[l].Extension[A,setA] ;
 module Q = FlatPrincipalQuotient[l].Over[P.ring,q] ;
 j : Q.Q.Carrier = Q.Q.include g ;
 module L = PowerLocalization[l].Over[Q.Q.ring,j] ;
 ring : CRing = L.ring ; set : Pr.isSet ring.R = L.set ;
 poly : H.Hom P.ring ring = H.compose P.ring Q.Q.ring ring L.inclusion Q.Q.projection ;
 base : H.Hom A ring = H.compose A P.ring ring poly P.inclusion ;
 x : ring.R = poly.1 P.variable ;
 root : Id ring.R (poly.1 q) ring.z =
  trans (ap L.inclusion.1 Q.root) (H.zero Q.Q.ring ring L.inclusion) ;
 unit : RL[ring].unit (poly.1 g) = L.invertible ;
 module Into (B : CRing) (setB : Pr.isSet B.R) (h : H.Hom A B) (b : B.R)
  (qzero : Id B.R (Universal[l].Property[A,B,setA,setB].Given[h,b].extend.1 q) B.z)
  (gunit : RL[B].unit (Universal[l].Property[A,B,setA,setB].Given[h,b].extend.1 g)) {
  module EV = Universal[l].Property[A,B,setA,setB].Given[h,b] ;
  module F = Q.Into[B,setB,EV.extend,qzero] ;
  gj : RL[B].unit (F.hom.1 j) = subst (RL[B].unit) (sym (F.beta g)) gunit ;
  module M = FlatPowerLocalization[l].Into[Q.Q.ring,j,B,setB,F.hom,gj] ;
  hom : H.Hom ring B = M.hom ;
  on-poly (p : P.Carrier) : Id B.R (hom.1 (poly.1 p)) (EV.extend.1 p) =
   trans (M.beta (Q.Q.include p)) (F.beta p) ;
  on-base (a : A.R) : Id B.R (hom.1 (base.1 a)) (h.1 a) =
   trans (on-poly (P.constant a)) (EV.on-constants a) ;
  on-x : Id B.R (hom.1 x) b = trans (on-poly P.variable) EV.on-variable ;
 } ;
 module Unique (B : CRing) (setB : Pr.isSet B.R) (f f' : H.Hom ring B)
  (constants : (a : A.R) -> Id B.R (f.1 (base.1 a)) (f'.1 (base.1 a)))
  (variable : Id B.R (f.1 x) (f'.1 x)) {
  h : H.Hom A B = H.compose A ring B f' base ;
  b : B.R = f'.1 x ;
  module EV = Universal[l].Property[A,B,setA,setB].Given[h,b] ;
  pf : H.Hom P.ring B = H.compose P.ring ring B f poly ;
  pg : H.Hom P.ring B = H.compose P.ring ring B f' poly ;
  first : Id (H.Hom P.ring B) pf EV.extend = EV.unique pf constants variable ;
  second : Id (H.Hom P.ring B) pg EV.extend = EV.unique pg (\ a -> refl (f'.1 (base.1 a))) (refl b) ;
  polys (p : P.Carrier) : Id B.R (f.1 (poly.1 p)) (f'.1 (poly.1 p)) =
   ap (\ m -> m.1 p) (trans first (sym second)) ;
  quotients : (v : Q.Q.Carrier) -> Id B.R (f.1 (L.inclusion.1 v)) (f'.1 (L.inclusion.1 v)) =
   Q.Q.Q.induction @l (\ v -> Id B.R (f.1 (L.inclusion.1 v)) (f'.1 (L.inclusion.1 v)))
    (\ v -> setB _ _) polys ;
  theorem : (v : ring.R) -> Id B.R (f.1 v) (f'.1 v) =
   FlatPowerLocalization[l].Unique[Q.Q.ring,j,B,setB,f,f',quotients].theorem ;
 } ;
} ;
module Change (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R)
 (h : H.Hom A B) (q g : PolynomialRing[l].Extension[A,setA].Carrier) {
 module PM = FlatPolynomialData[l].Map[A,B,setA,setB,h] ;
 module Source = Over[A,setA,q,g] ;
 module Target = Over[B,setB,PM.f.1 q,PM.f.1 g] ;
 module Quot = FlatPrincipalQuotient[l].Change[PM.P.ring,PM.Q.ring,PM.f,q] ;
 comp : H.Hom Source.Q.Q.ring Target.ring =
  H.compose Source.Q.Q.ring Target.Q.Q.ring Target.ring Target.L.inclusion Quot.map ;
 on-j : Id Target.ring.R (comp.1 Source.j) (Target.poly.1 (PM.f.1 g)) =
  ap Target.L.inclusion.1 (Quot.Induced.beta g) ;
 j-unit : RL[Target.ring].unit (comp.1 Source.j) = subst (RL[Target.ring].unit) (sym on-j) Target.unit ;
 module Map = FlatPowerLocalization[l].Into[Source.Q.Q.ring,Source.j,Target.ring,Target.set,comp,j-unit] ;
 hom : H.Hom Source.ring Target.ring = Map.hom ;
 on-poly (p : PM.P.Carrier) : Id Target.ring.R (hom.1 (Source.poly.1 p)) (Target.poly.1 (PM.f.1 p)) =
  trans (Map.beta (Source.Q.Q.include p)) (ap Target.L.inclusion.1 (Quot.Induced.beta p)) ;
 on-base (a : A.R) : Id Target.ring.R (hom.1 (Source.base.1 a)) (Target.base.1 (h.1 a)) =
  trans (on-poly (PM.P.constant a)) (ap Target.poly.1 (PM.UP.on-constants a)) ;
 on-x : Id Target.ring.R (hom.1 Source.x) Target.x =
  trans (on-poly PM.P.variable) (ap Target.poly.1 PM.UP.on-variable) ;
 module Flat (flat : FlatRelations[l].Over[A,B,h].Flat) {
  module PolyFlat = FlatPolynomialBaseChange[l].Over[A,B,setA,setB,h,flat] ;
  module QuotFlat = Quot.Flat[PolyFlat.theorem] ;
  module LocFlat = LocalizationFlat[l].Over[Source.Q.Q.ring,Target.Q.Q.ring,Quot.map,QuotFlat.theorem,Target.j] ;
  module AsSource = FlatLocalizedSource[l].Over[Source.Q.Q.ring,Target.ring,comp,Source.j,hom,Map.beta,LocFlat.flat] ;
  theorem : FlatRelations[l].Over[Source.ring,Target.ring,hom].Flat = AsSource.theorem ;
 } ;
} ;
