-- The last step of the flat case, with flatness over the source S.
-- No lifting property of T is used.  FlatQuotient supplies I = I^2;
-- the existing determinant and standard-localisation proofs are reused.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module EC = EtaleCase[l].Over[A,setA] ;
 module SE = StandardEtale[l].Over[A,setA] ;
 module RX = SE.RX ;
 module At (S T : C.Algebra) (u : C.Hom S T)
  (surj : (t : T.ring.R) -> Tr.Trunc[(s : S.ring.R) * Id T.ring.R (u.1.1 s) t].carrier)
  (flat : FlatRelations[l].Over[S.ring,T.ring,u.1].Flat)
  (r : Nat) (k : Fin r -> S.ring.R)
  (k-in : (i : Fin r) -> Id T.ring.R (u.1.1 (k i)) T.ring.z)
  (gen : (x : S.ring.R) -> Id T.ring.R (u.1.1 x) T.ring.z ->
   Tr.Trunc[(c : Fin r -> S.ring.R) * Id S.ring.R x (FiniteIdeal[l].Sums[S.ring].lin r k c)].carrier) {
  module SQ = EC.Section2[S,T,u,surj,r,k,k-in,gen] ;
  module FQ = FlatQuotient[l].Over[S.ring,T.ring,u.1,surj,flat] ;
  module SS = FiniteIdeal[l].Sums[S.ring] ;
  module ST = FiniteIdeal[l].Sums[T.ring] ;
  module MS = FlatRelations[l].MapSums[S.ring,T.ring,u.1] ;
  module LT = RL[T.ring] ;
  module For (i : Fin r) (w : FQ.Witness (k i)) {
   coeff : Fin r -> S.ring.R = (SS.coordinates r k i).1 ;
   equation : Id S.ring.R (k i) (SS.lin r k coeff) = sym (SS.coordinates r k i).2 ;
   b (j : Fin r) : S.ring.R = S.ring.mul w.1 (coeff j) ;
   b-in (j : Fin r) : SQ.Su.Kernel (b j) =
    trans (u.1.2.2.2 w.1 (coeff j))
     (trans (ap (\ z -> T.ring.mul z (u.1.1 (coeff j))) w.2.1) (LT.zero-mul (u.1.1 (coeff j)))) ;
   result : SQ.Certificate (k i) = (b,b-in,
    trans w.2.2 (trans (S.ring.mulC (k i) w.1)
     (trans (ap (S.ring.mul w.1) equation) (sym (SS.lin-scale r k coeff w.1))))) ;
  } ;
  certificate (i : Fin r) : Tr.Trunc[SQ.Certificate (k i)].carrier =
   TC.map (FQ.Witness (k i)) (SQ.Certificate (k i)) (\ w -> For[i,w].result) (FQ.theorem (k i) (k-in i)) ;
  certificates : Tr.Trunc[(i : Fin r) -> SQ.Certificate (k i)].carrier =
   AffineFinite[l].choice r (\ i -> SQ.Certificate (k i)) certificate ;
  module Standard (Q G : RX.Carrier) (st : SE.Points[Q,G].Standard S)
   (full : EC.Fractions[Q,G,S,st.1].Full) {
   Result : U l+ = (F : RX.Carrier) * SE.Points[Q,RX.ring.mul G F].Standard T ;
   from-fraction (cert : (i : Fin r) -> SQ.Certificate (k i))
    (ff : EC.Fractions[Q,G,S,st.1].Fraction SQ.Idem[cert].II.f) :
    Truncation[l+].Trunc[Result].carrier =
    Truncation[l+].Trunc[Result].inc (SQ.Localised[Q,G,st,cert,ff].F,SQ.Localised[Q,G,st,cert,ff].standard) ;
   from-cert (cert : (i : Fin r) -> SQ.Certificate (k i)) : Truncation[l+].Trunc[Result].carrier =
    Tr.Trunc[EC.Fractions[Q,G,S,st.1].Fraction SQ.Idem[cert].II.f].induction @(l+)
     (\ w -> Truncation[l+].Trunc[Result].carrier) (\ w -> Truncation[l+].Trunc[Result].proposition)
     (from-fraction cert) (full SQ.Idem[cert].II.f) ;
   theorem : Truncation[l+].Trunc[Result].carrier =
    Tr.Trunc[(i : Fin r) -> SQ.Certificate (k i)].induction @(l+)
     (\ w -> Truncation[l+].Trunc[Result].carrier) (\ w -> Truncation[l+].Trunc[Result].proposition)
     from-cert certificates ;
  } ;
 } ;
} ;
