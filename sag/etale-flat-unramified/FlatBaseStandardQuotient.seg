-- A finitely presented quotient of a standard etale algebra is standard
-- etale when the quotient is flat over the original coefficient ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ; module SE = StandardEtale[l].Over[A,setA] ;
 module P = SE.RX ;
 module At (q g : P.Carrier) (S T : C.Algebra) (st : SE.Points[q,g].Standard S)
  (full : EtaleCase[l].Over[A,setA].Fractions[q,g,S,st.1].Full)
  (u : C.Hom S T)
  (onto : (t : T.ring.R) -> Tr.Trunc[(s : S.ring.R) * Id T.ring.R (u.1.1 s) t].carrier)
  (flat : FlatRelations[l].Over[A,T.ring,T.iota].Flat)
  (r : Nat) (k : Fin r -> S.ring.R) (ki : (i : Fin r) -> Id T.ring.R (u.1.1 (k i)) T.ring.z)
  (gen : (s : S.ring.R) -> Id T.ring.R (u.1.1 s) T.ring.z ->
   Tr.Trunc[(c : Fin r -> S.ring.R) * Id S.ring.R s (FiniteIdeal[l].Sums[S.ring].lin r k c)].carrier) {
  module Transfer = FlatStandardTransfer[l].Over[A,setA].At[q,g,S,T,st,u,flat] ;
  module Quot = FlatStandardQuotient[l].Over[A,setA].At[S,T,u,onto,Transfer.theorem,r,k,ki,gen] ;
  module Std = Quot.Standard[q,g,st,full] ;
  Result : U l+ = Std.Result ;
  theorem : Truncation[l+].Trunc[Result].carrier = Std.theorem ;
 } ;
} ;
