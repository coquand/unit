-- Transport flatness along an isomorphism of source rings.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A B C : CRing) (h : RingHom[l].Hom A B)
 (j : RingHom[l].Hom C A) (k : RingHom[l].Hom A C)
 (jk : (a : A.R) -> Id A.R (j.1 (k.1 a)) a)
 (kj : (c : C.R) -> Id C.R (k.1 (j.1 c)) c)
 (flat : FlatRelations[l].Over[A,B,h].Flat) {
 comp : RingHom[l].Hom C B = RingHom[l].compose C A B h j ;
 module Along = FlatRelations[l].AlongBase[A,C,k,B,h,B,comp,RingHom[l].identity B,
  \ a -> ap h.1 (sym (jk a))] ;
 theorem : FlatRelations[l].Over[C,B,comp].Flat =
  \ n a b r -> Along.mere n (\ i -> j.1 (a i)) a (\ i -> kj (a i)) b
   (flat n (\ i -> j.1 (a i)) b r) ;
} ;
