-- Repeated coefficients, empty lists and the determinant-trick export.
-- F2 x F2 uses the same monic equation T^2+T for both basis vectors.
-- The collector keeps both occurrences and lifts both equations through
-- an explicit coefficient map without any representative choices.
level l ; open Ring[l] ; open Presentations[l] ;
module R = PrimitiveRegression[l] ;
module C = CoefficientCollection[l].Over[R.k.R] ;
module F = FiniteMonicCoefficientFamily[l].Over[R.k,R.B.bool-set,R.S,R.two,R.basis] ;
lower : List R.k.R = cons false (cons true nil) ;
module Root (a : R.Pair) {
 module H = MonicValueNaturality[l].Over[R.k,R.B.bool-set].Horner[R.S,a] ;
 theorem : Id R.Pair (F.IM.PC.value a (F.IM.coefficients lower)) R.z =
  trans (sym (H.integral-value lower)) (trans (sym (H.equation lower)) (R.annihilator a)) ;
} ;
witnesses : F.Witnesses = \ i -> (lower,Root[R.basis.vector i].theorem) ;
module Chosen = F.Chosen[witnesses] ;
collected : F.Data = Chosen.result ;
four-coefficients : Id Nat collected.count R.four = refl R.four ;
repeated-zero : Id R.k.R (collected.coefficient (inr tt)) false = refl false ;
repeated-one : Id R.k.R (collected.coefficient (inl (inr tt))) true = refl true ;
first-covered : C.Locations collected.count collected.coefficient (collected.lower R.i0) = collected.locations R.i0 ;
second-covered : C.Locations collected.count collected.coefficient (collected.lower R.i1) = collected.locations R.i1 ;
module Lifted = F.Given[collected].Lift[R.k,R.B.bool-set,RingHom[l].identity R.k,
 collected.coefficient,\ i -> refl (collected.coefficient i)] ;
first-lower : Id (List R.k.R) (Lifted.lower R.i0) lower = refl lower ;
second-lower : Id (List R.k.R) (Lifted.lower R.i1) lower = refl lower ;
first-root : Id R.Pair
 (MonicBasisUniversal[l].Values[R.k,R.A,Lifted.restricted.iota,R.basis.vector R.i0].value (Lifted.lower R.i0)) R.z = Lifted.roots R.i0 ;
second-root : Id R.Pair
 (MonicBasisUniversal[l].Values[R.k,R.A,Lifted.restricted.iota,R.basis.vector R.i1].value (Lifted.lower R.i1)) R.z = Lifted.roots R.i1 ;
empty-family : C.Collection[zero,\ i -> efq i] = C.family zero (\ i -> efq i) ;
empty-family-count : Id Nat empty-family.count zero = refl zero ;
empty-lists : C.Collection[R.two,\ i -> nil] = C.family R.two (\ i -> nil) ;
empty-list-count : Id Nat empty-lists.count zero = refl zero ;
constructed-annihilators : Truncation[l].Trunc[F.Data].carrier = F.theorem ;
