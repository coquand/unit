-- From a finite basis construct monic annihilators of every basis
-- vector and a single finite family containing every lower coefficient.
-- Only finitely many determinant-trick witnesses are selected, inside
-- truncation. For any coefficient subfield carrying explicit preimages
-- of that family, all monic equations lift back with actual lists.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module F = FiniteSpan[l].Over[k,S.ring,S.iota] ; module I = FiniteSpanIntegral[l].Over[k,S.ring,setk,S.set,S.iota] ;
 module IM = IntegralDescent[l].Map[k,S.ring,S.iota] ; module CC = CoefficientCollection[l].Over[k.R] ;
 module MV = MonicBasisUniversal[l] ;
 finite : F.Data = (n,basis.vector,\ a -> Tr.Trunc[F.Coordinates n basis.vector a].inc (basis.coordinate a,basis.reconstruction a)) ;
 record Data {
  lower : Fin n -> List k.R ;
  root (i : Fin n) : Id S.ring.R (MV.Values[k,S.ring,S.iota,basis.vector i].value (lower i)) S.ring.z ;
  count : Nat ;
  coefficient : Fin count -> k.R ;
  locations (i : Fin n) : CC.Locations count coefficient (lower i) ;
 } ;
 Witnesses : U l = (i : Fin n) -> IM.IntegralWitness (basis.vector i) ;
 module Chosen (w : Witnesses) {
  lower (i : Fin n) : List k.R = (w i).1 ;
  root (i : Fin n) : Id S.ring.R (MV.Values[k,S.ring,S.iota,basis.vector i].value (lower i)) S.ring.z =
   trans (MonicValueNaturality[l].Over[k,setk].Horner[S,basis.vector i].integral-value (lower i)) (w i).2 ;
  collection : CC.Collection[n,lower] = CC.family n lower ;
  result : Data = new Data[lower,root,collection.count,collection.coefficient,collection.locations] ;
 } ;
 witnesses : Tr.Trunc[Witnesses].carrier =
  AffineFinite[l].choice n (\ i -> IM.IntegralWitness (basis.vector i)) (\ i -> I.integral finite (basis.vector i)) ;
 theorem : Tr.Trunc[Data].carrier = TC.map Witnesses Data (\ w -> Chosen[w].result) witnesses ;
 module Given (d : Data) {
  module St = SelectedFactorStatement[l].Over[k,setk] ;
  ordinary-root (i : Fin n) : Id S.ring.R
   (MonicReduce[l].Horner[k,S.ring,S.iota,basis.vector i].horner (St.monic (d.lower i))) S.ring.z =
   trans (MonicValueNaturality[l].Over[k,setk].Horner[S,basis.vector i].equation (d.lower i)) (d.root i) ;
  module Lift (K0 : CRing) (setK0 : Pr.isSet K0.R) (inclusion : RingHom[l].Hom K0 k)
   (preimages : Fin d.count -> K0.R)
   (image-law : (i : Fin d.count) -> Id k.R (inclusion.1 (preimages i)) (d.coefficient i)) {
   module C0 = Algebras[l].Over[K0,setK0] ;
   restricted : C0.Algebra = C0.mkAlgebra S.ring S.set (RingHom[l].compose K0 k S.ring S.iota inclusion) ;
   module Lists = CC.Lift[K0.R,d.count,d.coefficient,inclusion.1,preimages,image-law] ;
   lower (i : Fin n) : List K0.R = Lists.lower (d.lower i) (d.locations i) ;
   image (i : Fin n) : Id (List k.R) (MV.map-list K0.R k.R inclusion.1 (lower i)) (d.lower i) =
    Lists.image (d.lower i) (d.locations i) ;
   roots (i : Fin n) : Id S.ring.R (MV.Values[K0,S.ring,restricted.iota,basis.vector i].value (lower i)) S.ring.z =
    trans (sym (MV.Change[K0,k,S.ring,inclusion,S.iota,basis.vector i].equation (lower i)))
     (trans (ap (MV.Values[k,S.ring,S.iota,basis.vector i].value) (image i)) (d.root i)) ;
   ordinary-lifted-root (i : Fin n) : Id S.ring.R
    (MonicReduce[l].Horner[K0,S.ring,restricted.iota,basis.vector i].horner
     (SelectedFactorStatement[l].Over[K0,setK0].monic (lower i))) S.ring.z =
    trans (MonicValueNaturality[l].Over[K0,setK0].Horner[restricted,basis.vector i].equation (lower i)) (roots i) ;
  } ;
 } ;
} ;
