-- Equivalences of dependent sums used to lift scheme covers.
level l ; open Prelude[l] ;
module Hi = Prelude[l+] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
eqind (A : U l) (P : (B : U l) -> Equiv A B -> U l+) (d : P A (idEquiv A))
 (B : U l) (e : Equiv A B) : P B e =
 Hi.subst (Equiv A B) (P B) (Axioms[l].idtoeqv A B (UA.ua A B e)) e
  ((univ @l A B).sec-eq e)
  (idJ (U l) A (\ T p -> P T (Axioms[l].idtoeqv A T p)) d B (UA.ua A B e)) ;
BaseMap (A B : U l) (e : Equiv A B) (Y : B -> U l)
 (u : (a : A) * Y (e.1 a)) : (b : B) * Y b = (e.1 u.1,u.2) ;
BaseProperty (A B : U l) (e : Equiv A B) : U l+ =
 (Y : B -> U l) -> isEquiv ((a : A) * Y (e.1 a)) ((b : B) * Y b) (BaseMap A B e Y) ;
base-is-equiv (A B : U l) (e : Equiv A B) : BaseProperty A B e =
 eqind A (BaseProperty A) (\ Y -> (idEquiv ((a : A) * Y a)).2) B e ;
base (A B : U l) (e : Equiv A B) (Y : B -> U l) :
 Equiv ((a : A) * Y (e.1 a)) ((b : B) * Y b) =
 (BaseMap A B e Y,base-is-equiv A B e Y) ;
module Fibres (X : U l) (A B : X -> U l) (e : (x : X) -> Equiv (A x) (B x)) {
 Source : U l = (x : X) * A x ; Target : U l = (x : X) * B x ;
 to (u : Source) : Target = (u.1,(e u.1).1 u.2) ;
 from (u : Target) : Source = (u.1,(e u.1).2.sec u.2) ;
 fb (u : Target) : Id Target (to (from u)) u =
  ap (B u.1) Target (\ b -> (u.1,b)) _ _ ((e u.1).2.sec-eq u.2) ;
 bf (u : Source) : Id Source (from (to u)) u =
  ap (A u.1) Source (\ a -> (u.1,a)) _ _ (sec-ret _ _ (e u.1).1 (e u.1).2 u.2) ;
 equivalence : Equiv Source Target = (to,qinv Source Target to from fb bf) ;
} ;
