-- Boundary checks for scheme Z-choice: empty schemes need no chart,
-- while a cover with sections cannot produce a point of an empty fibre.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module Basics = SchemeBasics[l].Over[R,setR] ;
 module Choice = SchemeChoice[l].Over[R,setR,axioms] ;
 module EmptyFamily (B : Empty -> U l) {
  inhabited : (x : Empty) -> Tr.Trunc[B x].carrier = split { } ;
  module E = Choice.FromCover[Empty,Basics.empty-cover,B,inhabited] ;
  choices : E.Choices = split { } ;
  patches : E.Standard[choices].Patches = split { } ;
  result : Choice.Witness Empty B = E.Standard[choices].Chosen[patches].result ;
  zero-charts : Id Nat result.1.size zero = refl zero ;
  theorem : Tr.Trunc[Choice.Witness Empty B].carrier = Choice.theorem Empty Basics.empty B inhabited ;
 } ;
 top-sections : Tr.Trunc[Choice.ImageWitness Top (\ x -> Top)].carrier =
  Choice.theorem-on-images Top Basics.top (\ x -> Top) (\ x -> Tr.Trunc[Top].inc tt) ;
 no-empty-section-cover (w : Choice.ImageWitness Top (\ x -> Empty)) : Empty =
  Tr.Trunc[(i : Fin w.1.size) * S.Image Top (w.1.charts i) tt].induction @l
   (\ t -> Empty) (\ t -> \ a b -> efq a)
   (\ a -> w.2 a.1 tt a.2) (w.1.covers tt) ;
 module Mere (B : Top -> U l) (inhabited : (x : Top) -> Tr.Trunc[B x].carrier) {
  #fails {
   -- Existence of a suitable cover remains propositional truncation.
   false-chosen-cover : Choice.Witness Top B = Choice.theorem Top Basics.top B inhabited ;
  } ;
 } ;
 #fails {
  -- Schemehood alone does not give a section of an empty family.
  false-empty-family : Tr.Trunc[Choice.ImageWitness Top (\ x -> Empty)].carrier =
   Choice.theorem-on-images Top Basics.top (\ x -> Empty) (\ x -> Tr.Trunc[Empty].inc tt) ;
 } ;
} ;
