-- SAG 5.6.2--3 from closure under dependent sums and scheme equalities.
-- The classifier is the actual fibre map; its inverse is the total space.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SS = SchemeSubtypes[l].Over[R,setR,axioms] ;
 module Equality = SchemeEquality[l].Over[R,setR,axioms] ;
 module FromSums (sums : (X : U l) -> S.Scheme X -> (Y : X -> U l) ->
  ((x : X) -> S.Scheme (Y x)) -> S.Scheme ((x : X) * Y x)) {
  module At (X : U l) (scheme : S.Scheme X) {
   fibre (Y : U l) (sY : S.Scheme Y) (f : Y -> X) (x : X) : S.Scheme (M.Fiber Y X f x) =
    sums Y sY (\ y -> Id X (f y) x) (\ y -> Equality.theorem X scheme (f y) x) ;
   module Classifier = FamilyClassification[l].Over[X].Structured[
    S.Scheme,S.proposition,\ Y -> sums X scheme Y,fibre] ;
   -- Left side is Σ(Y:Sch).(Y→X), right side is X→Sch.
   theorem-5-6-2 : Hi.Equiv ((Y : S.Schemes) * (Y.1 -> X)) (X -> S.Schemes) =
    Classifier.classification ;
   module Family (Y : X -> U l) {
    Total : U l = (x : X) * Y x ;
    pointwise : U l = (x : X) -> S.Scheme (Y x) ;
    to (s : S.Scheme Total) (x : X) : S.Scheme (Y x) =
     SB.along (M.Fiber Total X (\ t -> t.1) x) (Y x)
      FamilyClassification[l].Over[X].Projection[Y,x].equivalence
      (fibre Total s (\ t -> t.1) x) ;
    from (s : pointwise) : S.Scheme Total = sums X scheme Y s ;
    pointwise-prop : Pr.isProp pointwise =
     F.isProp-Pi X (\ x -> S.Scheme (Y x)) (\ x -> S.proposition (Y x)) ;
    equivalence : Pr.Equiv (S.Scheme Total) pointwise =
     (to,Pr.qinv _ _ to from (\ s -> pointwise-prop _ s) (\ s -> S.proposition Total _ s)) ;
   } ;
   module Subtype (Y : X -> U l) (prop : (x : X) -> Pr.isProp (Y x)) {
    module Fam = Family[Y] ;
    to (s : SS.Subscheme X Y) : Fam.pointwise = Fam.to s.2 ;
    from (s : Fam.pointwise) : SS.Subscheme X Y = (prop,Fam.from s) ;
    subscheme-prop : Pr.isProp (SS.Subscheme X Y) =
     Pr.isProp-Sigma ((x : X) -> Pr.isProp (Y x)) (\ h -> S.Scheme Fam.Total)
      (F.isProp-Pi X (\ x -> Pr.isProp (Y x)) (\ x -> F.isProp-isProp (Y x)))
      (\ h -> S.proposition Fam.Total) ;
    theorem-5-6-3 : Pr.Equiv (SS.Subscheme X Y) Fam.pointwise =
     (to,Pr.qinv _ _ to from (\ s -> Fam.pointwise-prop _ s) (\ s -> subscheme-prop _ s)) ;
   } ;
  } ;
 } ;
 -- The public interface has no extra closure hypothesis: 5.6.1 supplies it.
 module Ready = FromSums[SchemeSums[l].Over[R,setR,axioms].theorem] ;
 module At (X : U l) (scheme : S.Scheme X) {
  module C = Ready.At[X,scheme] ;
  fibre : (Y : U l) -> S.Scheme Y -> (f : Y -> X) -> (x : X) -> S.Scheme (M.Fiber Y X f x) = C.fibre ;
  theorem-5-6-2 : Hi.Equiv ((Y : S.Schemes) * (Y.1 -> X)) (X -> S.Schemes) = C.theorem-5-6-2 ;
  module Family (Y : X -> U l) {
   equivalence : Pr.Equiv (S.Scheme ((x : X) * Y x)) ((x : X) -> S.Scheme (Y x)) = C.Family[Y].equivalence ;
  } ;
  module Subtype (Y : X -> U l) (prop : (x : X) -> Pr.isProp (Y x)) {
   theorem-5-6-3 : Pr.Equiv (SS.Subscheme X Y) ((x : X) -> S.Scheme (Y x)) = C.Subtype[Y,prop].theorem-5-6-3 ;
  } ;
 } ;
} ;
