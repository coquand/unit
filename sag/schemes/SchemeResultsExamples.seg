-- Boundary cases for 5.4 and 5.5: true and empty opens, and a
-- scheme-valued equality type that is nevertheless empty.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SS = SchemeSubtypes[l].Over[R,setR,axioms] ;
 module SE = SchemeEquality[l].Over[R,setR,axioms] ;
 module AE = AffineEquality[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 empty-prop : Pr.isProp Empty = \ a b -> efq a ;
 empty-open-scheme : S.Scheme Empty = SS.open-proposition Empty OO.open-empty ;
 full-subscheme : SS.Subscheme Top (\ t -> Top) = SS.open-subscheme Top SB.top (\ t -> Top) (\ t -> OO.open-top) ;
 empty-closed : CP.Closed Empty =
  Tr.Trunc[CP.Witness Empty].inc
   (CP.from-iff Empty empty-prop (suc zero) (\ i -> R.o)
    (\ e -> efq e) (\ z -> axioms.loc.1 (z (inr tt)))) ;
 empty-closed-subscheme : SS.Subscheme Top (\ t -> Empty) =
  SS.closed-subscheme Top SB.top (\ t -> Empty) (\ t -> empty-closed) ;
 presentation : SA.P.Presentation = (suc zero,nil) ;
 Line : U l = SA.Sol presentation ;
 point (r : R.R) : Line = (\ i -> r,tt) ;
 scheme : S.Scheme Line = SB.solutions presentation ;
 equality-scheme : S.Scheme (Id Line (point R.z) (point R.o)) =
  SE.theorem Line scheme (point R.z) (point R.o) ;
 equality-closed : CP.Closed (Id Line (point R.z) (point R.o)) =
  AE.small-closed Line (Tr.Trunc[SA.Witness Line].inc (presentation,Pr.idEquiv Line)) (point R.z) (point R.o) ;
 distinct (p : Id Line (point R.z) (point R.o)) : Empty =
  axioms.loc.1 (sym (ap (\ t -> t.1 (inr tt)) p)) ;
 #fails {
  -- Schemehood of an equality type does not make its points equal.
  false-equality : Id Line (point R.z) (point R.o) = refl (point R.z) ;
 } ;
 #fails {
  -- A family with affine fibres is not automatically a proposition-valued subtype.
  false-subscheme : SS.Subscheme Top (\ t -> Line) =
   (\ t -> SA.sol-set presentation,scheme) ;
 } ;
} ;
