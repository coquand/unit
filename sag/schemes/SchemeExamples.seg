-- Regressions for the shared interface: smallness, empty covers,
-- affine introduction and the required embedding/covering hypotheses.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module S = Schemes[l].Over[R,setR] ;
 module B = SchemeBasics[l].Over[R,setR] ;
 module ST = SchemeSubtype[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 cover-small (X : U l) : U l = S.Cover[X] ;
 scheme-small (X : U l) : U l = S.Scheme X ;
 empty-is-set : Pr.isSet Empty = S.set Empty B.empty ;
 empty-subtype-definition : ST.Property Empty = ST.to-subtypes Empty B.empty ;
 empty-roundtrip : S.Scheme Empty = ST.from-subtypes Empty empty-subtype-definition ;
 affine-solutions (p : P.Presentation) : S.Scheme (SA.Sol p) = B.solutions p ;
 -- This application would fail if Cover lived at l+.
 choose-covers (zchoice : Ax.ZChoice) (A : C.Algebra) (fp : P.FP A)
  (Ys : C.Spec A -> U l) (ss : (x : C.Spec A) -> S.Scheme (Ys x)) :
  Tr.Trunc[Ax.ChoiceData A (\ x -> S.Cover[Ys x])].carrier =
  zchoice A fp (\ x -> S.Cover[Ys x]) ss ;
 module EmptyFlatten (axioms : Ax.Assumptions) {
  us : Fin zero -> Empty -> U l = split { } ;
  opens : (i : Fin zero) -> S.OP.OpenSubtype Empty (us i) = split { } ;
  schemes : (i : Fin zero) -> S.Scheme ((x : Empty) * us i x) = split { } ;
  covers : (x : Empty) -> Tr.Trunc[(i : Fin zero) * us i x].carrier = split { } ;
  scheme : S.Scheme Empty = SchemeCover[l].Over[R,setR,axioms].At[Empty,zero,us,opens,schemes,covers].theorem ;
 } ;
 #fails {
  -- An arbitrary map out of an affine domain does not supply its
  -- embedding proof (the subtype projection has a different domain).
  forged-embedding (p : P.Presentation) :
   SchemeMaps[l].Embedding (SA.Sol p) Top (\ a -> tt) =
   SchemeMaps[l].Subtype[Top,\ t -> Top,\ t -> FinSum[l].top-prop].embedding ;
 } ;
 #fails {
  -- An empty family cannot cover an inhabited type.
  empty-covers-point : (x : Top) -> Tr.Trunc[(i : Fin zero) * Top].carrier =
   \ x -> Tr.Trunc[(i : Fin zero) * Top].inc (tt,tt) ;
 } ;
} ;
