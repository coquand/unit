-- Padding finite covers with empty affine charts. This is distinct from
-- padding presentation variables: it bounds the number of charts in a fibre.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
pad (A : U l) (default : A) : (N n : Nat) -> (Fin n -> A) -> Fin N -> A = split {
 zero -> \ n hs i -> efq i ;
 suc N | ih -> split {
  zero -> \ hs i -> default ;
  suc n -> \ hs -> snoc (Fin N) A (ih n (\ i -> hs (inl i))) (hs (inr tt)) } } ;
entry (A : U l) (default : A) : (N n : Nat) -> CB.le n N -> (hs : Fin n -> A) -> (i : Fin n) ->
 (j : Fin N) * Id A (pad A default N n hs j) (hs i) = split {
 zero -> split { zero -> \ h hs i -> efq i ; suc n -> \ h -> efq h } ;
 suc N | ih -> split {
  zero -> \ h hs i -> efq i ;
  suc n -> \ h hs -> split {
   inl i -> (inl (ih n h (\ k -> hs (inl k)) i).1,(ih n h (\ k -> hs (inl k)) i).2) ;
   inr t -> (inr tt,ap (\ u -> hs (inr u)) (FinSum[l].top-prop tt t)) } } } ;
module Over (R : CRing) (setR : Pr.isSet R.R) (one-nz : Id R.R R.o R.z -> Empty) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module M = SchemeMaps[l] ;
 empty-presentation : SA.P.Presentation = (zero,cons (cst R.o) nil) ;
 EmptySol : U l = SA.Sol empty-presentation ;
 no-solution (a : EmptySol) : Empty = one-nz a.2.1 ;
 module EmptyChart (X : U l) {
  map (a : EmptySol) : X = efq (no-solution a) ;
  embedding : M.Embedding EmptySol X map = \ x a b -> efq (no-solution a.1) ;
  no-image (x : X) : M.Image EmptySol X map x -> Empty =
   Tr.Trunc[M.Fiber EmptySol X map x].induction @l
    (\ t -> Empty) (\ t -> \ a b -> efq a) (\ a -> no-solution a.1) ;
  image-empty (x : X) : Pr.Equiv (M.Image EmptySol X map x) Empty =
   (no-image x,Pr.qinv _ _ (no-image x) (\ e -> efq e)
    (\ e -> efq e) (\ u -> M.image-prop EmptySol X map x _ u)) ;
  chart : S.Chart[X] = new S.Chart[X,empty-presentation,map,embedding,
   \ x -> OP.along _ Empty (image-empty x) OO.open-empty] ;
 } ;
 module At (X : U l) (c : S.Cover[X]) (N : Nat) (bound : CB.le c.size N) {
  charts : Fin N -> S.Chart[X] = pad S.Chart[X] EmptyChart[X].chart N c.size c.charts ;
  covers (x : X) : Tr.Trunc[(j : Fin N) * S.Image X (charts j) x].carrier =
   Tr.Trunc[(i : Fin c.size) * S.Image X (c.charts i) x].induction @l
    (\ t -> Tr.Trunc[(j : Fin N) * S.Image X (charts j) x].carrier)
    (\ t -> Tr.Trunc[(j : Fin N) * S.Image X (charts j) x].proposition)
    (\ a -> Tr.Trunc[(j : Fin N) * S.Image X (charts j) x].inc
     ((entry S.Chart[X] EmptyChart[X].chart N c.size bound c.charts a.1).1,
      Pr.subst S.Chart[X] (\ z -> S.Image X z x) _ _
       (sym (entry S.Chart[X] EmptyChart[X].chart N c.size bound c.charts a.1).2) a.2)) (c.covers x) ;
  cover : S.Cover[X] = new S.Cover[X,N,charts,covers] ;
 } ;
} ;
