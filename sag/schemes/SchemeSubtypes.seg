-- SAG 5.4.1--3: open and closed subtypes of a scheme are schemes.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module ST = SchemeSubtype[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SC = SchemeCover[l].Over[R,setR,axioms] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module AO = SchemeAffineOpen[l].Over[R,setR,axioms] ;
 module CA = ClosedAffineGeneral[l].Over[R,setR,axioms] ;
 TotalScheme (X : U l) (sub : X -> U l) : U l = S.Scheme ((x : X) * sub x) ;
 -- 5.4.1 includes the assertion that this is a subtype.
 Subscheme (X : U l) (sub : X -> U l) : U l =
  ((x : X) -> Pr.isProp (sub x)) * TotalScheme X sub ;
 module Restrict (X : U l) (w : ST.Witness[X]) (sub : X -> U l) {
  Y : U l = (x : X) * sub x ;
  Ux (i : Fin w.size) : U l = (x : X) * w.subtypes i x ;
  local-type (i : Fin w.size) : U l = (u : Ux i) * sub u.1 ;
  us (i : Fin w.size) (y : Y) : U l = w.subtypes i y.1 ;
  opens (i : Fin w.size) (y : Y) : OP.Open (us i y) = w.opens i y.1 ;
  covers (y : Y) : Tr.Trunc[(i : Fin w.size) * us i y].carrier = w.covers y.1 ;
  exchange (i : Fin w.size) : Pr.Equiv (local-type i) ((y : Y) * us i y) =
   (\ u -> ((u.1.1,u.2),u.1.2),Pr.qinv (local-type i) ((y : Y) * us i y) (\ u -> ((u.1.1,u.2),u.1.2))
    (\ v -> ((v.1.1,v.2),v.1.2)) (\ v -> refl v) (\ u -> refl u)) ;
  theorem (locals : (i : Fin w.size) -> S.Scheme (local-type i)) : S.Scheme Y =
   SC.At[Y,w.size,us,opens,\ i -> SB.along _ _ (exchange i) (locals i),covers].theorem ;
 } ;
 open-with (X : U l) (w : ST.Witness[X]) (sub : X -> U l) (op : OP.OpenSubtype X sub) :
  TotalScheme X sub =
  Restrict[X,w,sub].theorem
   (\ i -> AO.theorem (Restrict[X,w,sub].Ux i) (w.affines i) (\ u -> sub u.1) (\ u -> op u.1)) ;
 closed-with (X : U l) (w : ST.Witness[X]) (sub : X -> U l) (cp : CP.ClosedSubtype X sub) :
  TotalScheme X sub =
  Restrict[X,w,sub].theorem
   (\ i -> SB.affine (Restrict[X,w,sub].local-type i)
    (CA.theorem (Restrict[X,w,sub].Ux i) (w.affines i) (\ u -> sub u.1) (\ u -> cp u.1))) ;
 open-subtype (X : U l) (s : S.Scheme X) (sub : X -> U l) (op : OP.OpenSubtype X sub) : TotalScheme X sub =
  Tr.Trunc[S.Cover[X]].induction @l (\ t -> TotalScheme X sub)
   (\ t -> S.proposition ((x : X) * sub x)) (\ c -> open-with X (ST.to-witness X c) sub op) s ;
 closed-subtype (X : U l) (s : S.Scheme X) (sub : X -> U l) (cp : CP.ClosedSubtype X sub) : TotalScheme X sub =
  Tr.Trunc[S.Cover[X]].induction @l (\ t -> TotalScheme X sub)
   (\ t -> S.proposition ((x : X) * sub x)) (\ c -> closed-with X (ST.to-witness X c) sub cp) s ;
 top-product (Q : U l) : Pr.Equiv (Top * Q) Q =
  (\ a -> a.2,Pr.qinv (Top * Q) Q (\ a -> a.2) (\ q -> (tt,q)) (\ q -> refl q)
   (\ a -> Pr.ap Top (Top * Q) (\ t -> (t,a.2)) tt a.1 (FinSum[l].top-prop tt a.1))) ;
 open-proposition (Q : U l) (op : OP.Open Q) : S.Scheme Q =
  SB.along (Top * Q) Q (top-product Q) (open-subtype Top SB.top (\ t -> Q) (\ t -> op)) ;
 open-subscheme (X : U l) (s : S.Scheme X) (sub : X -> U l) (op : OP.OpenSubtype X sub) : Subscheme X sub =
  (\ x -> OP.open-prop (sub x) (op x),open-subtype X s sub op) ;
 closed-subscheme (X : U l) (s : S.Scheme X) (sub : X -> U l) (cp : CP.ClosedSubtype X sub) : Subscheme X sub =
  (\ x -> CP.closed-prop (sub x) (cp x),closed-subtype X s sub cp) ;
} ;
