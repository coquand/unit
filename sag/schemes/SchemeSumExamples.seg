-- Boundary cases for dependent sums, padding and pullbacks.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module DS = SchemeSums[l].Over[R,setR,axioms] ;
 module PB = SchemePullbacks[l].Over[R,setR,axioms] ;
 module CovPad = SchemeCoverPadding[l].Over[R,setR,axioms.loc.1] ;
 module PP = PresentationPadding[l].Over[R,setR] ;
 trivial : SA.P.Presentation = (zero,nil) ;
 module Padded = PP.Padded[trivial,suc zero,tt] ;
 zeros : PP.Vector (suc zero) = \ i -> R.z ;
 ones : PP.Vector (suc zero) = \ i -> R.o ;
 zero-allowed : Padded.Condition zeros = (tt,refl zeros) ;
 one-refused (h : Padded.Condition ones) : Empty =
  axioms.loc.1 (sym (ap (\ v -> v (inr tt)) h.2)) ;
 #fails {
  -- The added variable is constrained to zero, not a free affine coordinate.
  false-padding : Padded.Condition ones = (tt,refl ones) ;
 } ;
 module EmptyCover = CovPad.At[Empty,SB.empty-cover,suc zero,tt] ;
 padded-empty-cover : S.Cover[Empty] = EmptyCover.cover ;
 added-slot-empty (a : S.Domain Empty (EmptyCover.charts (inr tt))) : Empty =
  CovPad.no-solution a ;
 empty-base (Y : Empty -> U l) : S.Scheme ((x : Empty) * Y x) =
  DS.theorem Empty SB.empty Y (\ x -> efq x) ;
 empty-fibres : S.Scheme (Top * Empty) =
  DS.theorem Top SB.top (\ t -> Empty) (\ t -> SB.empty) ;
 module Line = SchemeResultsExamples[l].Over[R,setR,axioms] ;
 left (t : Top) : Line.Line = Line.point R.z ;
 right (t : Top) : Line.Line = Line.point R.o ;
 Disjoint : U l = PB.Pullback Top Top Line.Line left right ;
 disjoint-scheme : S.Scheme Disjoint =
  PB.theorem Top Top Line.Line SB.top SB.top Line.scheme left right ;
 no-point (p : Disjoint) : Empty = Line.distinct p.2.2 ;
 #fails {
  -- A pullback can be a scheme and still have no points.
  false-pullback-point : Disjoint = (tt,tt,refl (Line.point R.z)) ;
 } ;
} ;
