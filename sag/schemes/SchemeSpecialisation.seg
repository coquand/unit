-- SAG 5.2.1: specialisation in a scheme is double-negated equality.
-- This implementation takes the full geometric-axiom bundle because
-- extending an open from an affine chart uses Transitivity.sigma.
-- The paper labels the statement Loc + SQC; removing the extra Z-choice
-- dependency would require a separate, weaker open-extension argument.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FH = Axioms[l+].FunExtLemmas[fe @l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ; module ST = SchemeSubtype[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module Sep = Separation[l].Over[R,setR,axioms.sqc,axioms.loc] ;
 module OT = Transitivity[l].Over[R,setR,axioms] ;
 module M = SchemeMaps[l] ;
 Specialises (X : U l) (x y : X) : U l+ = Sep.Specialises X x y ;
 NN (X : U l) (x y : X) : U l = (Id X x y -> Empty) -> Empty ;
 empty-prop : Pr.isProp Empty = \ a b -> efq a ;
 nn-prop (X : U l) (x y : X) : Pr.isProp (NN X x y) =
  F.isProp-Pi (Id X x y -> Empty) (\ n -> Empty) (\ n -> empty-prop) ;
 specialises-prop (X : U l) (x y : X) : Hi.isProp (Specialises X x y) =
  FH.isProp-Pi (X -> U l) (\ sub -> OP.OpenSubtype X sub -> sub x -> sub y)
   (\ sub -> FH.isProp-Pi (OP.OpenSubtype X sub) (\ o -> sub x -> sub y)
    (\ o -> F.isProp-Pi (sub x) (\ u -> sub y) (\ u -> OP.open-prop (sub y) (o y)))) ;
 module InChart (X : U l) (c : S.Chart[X]) (x y : X) (special : Specialises X x y)
  (ux : S.Image X c x) {
  image : X -> U l = S.Image X c ;
  prop (z : X) : Pr.isProp (image z) = M.image-prop (S.Domain X c) X c.map z ;
  Total : U l = (z : X) * image z ;
  uy : image y = special image c.open-image ux ;
  xx : Total = (x,ux) ; yy : Total = (y,uy) ;
  extend (sub : Total -> U l) (z : X) : U l = (u : image z) * sub (z,u) ;
  open-extend (sub : Total -> U l) (o : OP.OpenSubtype Total sub) : OP.OpenSubtype X (extend sub) =
   \ z -> OT.sigma (image z) (c.open-image z) (\ u -> sub (z,u)) (\ u -> o (z,u)) ;
  from-extend (sub : Total -> U l) (v : extend sub y) : sub yy =
   Pr.subst (image y) (\ u -> sub (y,u)) v.1 uy (prop y v.1 uy) v.2 ;
  inside : Sep.Specialises Total xx yy =
   \ sub o v -> from-extend sub (special (extend sub) (open-extend sub o) (ux,v)) ;
  theorem : NN X x y = \ ne ->
   Sep.specialises-nn Total (ST.chart-affine X c) xx yy inside
    (\ h -> ne (Pr.ap Total X (\ z -> z.1) xx yy h)) ;
 } ;
 module OnCover (X : U l) (c : S.Cover[X]) (x y : X) (special : Specialises X x y) {
  theorem : NN X x y =
   Tr.Trunc[(i : Fin c.size) * S.Image X (c.charts i) x].induction @l
    (\ t -> NN X x y) (\ t -> nn-prop X x y)
    (\ u -> InChart[X,c.charts u.1,x,y,special,u.2].theorem) (c.covers x) ;
 } ;
 specialises-nn (X : U l) (scheme : S.Scheme X) (x y : X) (special : Specialises X x y) : NN X x y =
  Tr.Trunc[S.Cover[X]].induction @l (\ t -> NN X x y) (\ t -> nn-prop X x y)
   (\ c -> OnCover[X,c,x,y,special].theorem) scheme ;
 nn-specialises (X : U l) (x y : X) : NN X x y -> Specialises X x y = Sep.nn-specialises X x y ;
 theorem (X : U l) (scheme : S.Scheme X) (x y : X) : Hi.Equiv (Specialises X x y) (NN X x y) =
  (specialises-nn X scheme x y,Hi.qinv _ _ (specialises-nn X scheme x y) (nn-specialises X x y)
   (\ nn -> nn-prop X x y _ nn) (\ special -> specialises-prop X x y _ special)) ;
} ;
