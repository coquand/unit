-- The classifier includes arbitrary maps, not just embeddings.
-- A two-point fibre remains a two-point fibre under classification.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module M = SchemeMaps[l] ;
module FC = FamilyClassification[l].Over[Top] ;
Two : U l = Plus Top Top ;
collapse (a : Two) : Top = tt ;
Fibre : U l = M.Fiber Two Top collapse tt ;
left : Fibre = (inl tt,refl tt) ;
right : Fibre = (inr tt,refl tt) ;
tag : Two -> U l = split { inl u -> Top ; inr u -> Empty } ;
distinct (p : Id Fibre left right) : Empty =
 Pr.subst Two tag (inl tt) (inr tt) (Pr.ap Fibre Two (\ w -> w.1) left right p) tt ;
not-proposition (prop : Pr.isProp Fibre) : Empty = distinct (prop left right) ;
as-family : FC.Families = FC.forward (Two,collapse) ;
correct-fibre : Id (U l) (as-family tt) Fibre = refl Fibre ;
round-trip-map : Id FC.Maps (FC.backward as-family) (Two,collapse) = FC.bf (Two,collapse) ;
projection-fibre : Pr.Equiv (FC.forward (FC.backward (\ x -> Two)) tt) Two =
 FC.Projection[\ x -> Two,tt].equivalence ;
 #fails {
  -- Fibre classification cannot silently collapse the two points.
  false-fibre-equality : Id Fibre left right = refl left ;
 } ;
module Geometric (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module Basics = SchemeBasics[l].Over[R,setR] ;
 module SS = SchemeSubtypes[l].Over[R,setR,axioms] ;
 module SchemesOverTop = SchemeFamilies[l].Over[R,setR,axioms].At[Top,Basics.top] ;
 empty-prop (t : Top) : Pr.isProp Empty = \ a b -> efq a ;
 empty-subscheme : SS.Subscheme Top (\ t -> Empty) =
  SchemesOverTop.Subtype[\ t -> Empty,empty-prop].theorem-5-6-3.2.sec (\ t -> Basics.empty) ;
 module Source (Y : U l) (scheme : S.Scheme Y) {
  Arrow : U l+ = (Z : S.Schemes) * (Z.1 -> Top) ;
  arrow : Arrow = ((Y,scheme),\ y -> tt) ;
  classified : Top -> S.Schemes = SchemesOverTop.theorem-5-6-2.1 arrow ;
  recovered : Id Arrow (SchemesOverTop.theorem-5-6-2.2.sec classified) arrow =
   Prelude[l+].sec-ret Arrow (Top -> S.Schemes)
    SchemesOverTop.theorem-5-6-2.1 SchemesOverTop.theorem-5-6-2.2 arrow ;
 } ;
} ;
