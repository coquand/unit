-- SAG 5.6.4: arbitrary pullbacks of schemes are schemes.
-- The pullback is the usual type of two points and a path between their images.
level l ;
module Pr = Prelude[l] ;
module Over (R : Ring[l].CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module DS = SchemeSums[l].Over[R,setR,axioms] ;
 module EQ = SchemeEquality[l].Over[R,setR,axioms] ;
 Pullback (X Y Z : U l) (f : X -> Z) (g : Y -> Z) : U l =
  (x : X) * (y : Y) * Id Z (f x) (g y) ;
 theorem (X Y Z : U l) (sX : S.Scheme X) (sY : S.Scheme Y) (sZ : S.Scheme Z)
  (f : X -> Z) (g : Y -> Z) : S.Scheme (Pullback X Y Z f g) =
  DS.theorem X sX (\ x -> (y : Y) * Id Z (f x) (g y))
   (\ x -> DS.theorem Y sY (\ y -> Id Z (f x) (g y)) (\ y -> EQ.theorem Z sZ (f x) (g y))) ;
 product (X Y : U l) (sX : S.Scheme X) (sY : S.Scheme Y) : S.Scheme (X * Y) =
  DS.theorem X sX (\ x -> Y) (\ x -> sY) ;
 fibre (X Y : U l) (sX : S.Scheme X) (sY : S.Scheme Y) (f : Y -> X) (x : X) :
  S.Scheme (SchemeMaps[l].Fiber Y X f x) =
  DS.theorem Y sY (\ y -> Id X (f y) x) (\ y -> EQ.theorem X sX (f y) x) ;
} ;
