-- The coefficient-annihilation consequence used in content arguments.
level l ; open Ring[l] ;
module Over (A : CRing) (p : Poly[l].PolyR[A].P) (g : A.R) (q : Poly[l].PolyR[A].P)
 (vanishes : (j : Nat) -> Id A.R (Poly[l].PolyR[A].coef (Mul[l].MulR[A].pmul p (cons g q)) j) A.z) {
 open A ; open RL[A] ; open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module C = CoefficientProducts[l].Over[A] ; open C ;
 module DM = DedekindMertens[l].Over[A] ;
 module S = DM.Statement[p,g,q] ;
 m : Nat = len {R} q ;
 zeros : AdditiveSpan[l].Group[A] = AdditiveSpan[l].mkGroup A (\ a -> Id R a z)
  (refl z)
  (\ a b ha hb -> trans (ap (\ t -> add t b) ha) (trans (ap (add z) hb) (addZ z)))
  (\ a ha -> trans (ap neg ha) neg-zero) ;
 on-generators (v : Word m * Nat) : Id R (Generators p (pmul p (cons g q)) m v) z =
  trans (ap (mul (product p m v.1)) (vanishes v.2)) (mul-zero (product p m v.1)) ;
 module Map = S.Target.CSpan.To[zeros,on-generators] ;
 result (w : Word (suc m)) (j : Nat) : Id R (mul (product p (suc m) w) (coef (cons g q) j)) z =
  Map.result (mul (product p (suc m) w) (coef (cons g q) j)) (DM.theorem p q g w j) ;
} ;
