-- The ideal generated by a family, represented by finite explicit sums.
-- Membership has witnesses; no propositional truncation is needed.
level l ; open Ring[l] ;
module Over (A : CRing) (I : U l) (generator : I -> A.R) {
 open A ; open RL[A] ;
 Index : U l = R * I ;
 family (v : Index) : R = mul v.1 (generator v.2) ;
 module CSpan = AdditiveSpan[l].Over[A,Index,family] ;
 module L = AdditiveSpan[l].Laws[A,CSpan.group] ;
 module Additive = AdditiveSpan[l].Over[A,I,generator] ;
 coefficient (i : I) : CSpan.Certificate (generator i) =
  L.transport (mul o (generator i)) (generator i) (one-left (generator i)) (CSpan.element (o,i)) ;
 module Scaled (s : R) {
  on-generators (v : Index) : CSpan.Certificate (mul s (family v)) =
   L.transport (mul (mul s v.1) (generator v.2)) (mul s (mul v.1 (generator v.2)))
    (sym (mulA s v.1 (generator v.2))) (CSpan.element (mul s v.1,v.2)) ;
  module Map = CSpan.To[L.scaled s,on-generators] ;
  result (a : R) (ha : CSpan.Certificate a) : CSpan.Certificate (mul s a) = Map.result a ha ;
 } ;
 multiply (s a : R) (ha : CSpan.Certificate a) : CSpan.Certificate (mul s a) = Scaled[s].result a ha ;
 module Include = Additive.To[CSpan.group,coefficient] ;
 from-subgroup (a : R) (ha : Additive.Certificate a) : CSpan.Certificate a = Include.result a ha ;
} ;
