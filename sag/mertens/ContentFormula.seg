-- Equality is expressed by explicit maps in both directions on membership
-- certificates, first for additive subgroups, then for generated ideals.
level l ; open Ring[l] ;
module Over (A : CRing) (p : Poly[l].PolyR[A].P) (g : A.R) (q : Poly[l].PolyR[A].P) {
 open A ; open RL[A] ; open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module C = CoefficientProducts[l].Over[A] ; open C ;
 module DM = DedekindMertens[l].Over[A] ;
 m : Nat = len {R} q ;
 wholeQ : P = cons g q ;
 h : P = pmul p wholeQ ;
 module Left = ContentProduct[p,wholeQ,suc m] ;
 module Right = ContentProduct[p,h,m] ;
 module LL = AdditiveSpan[l].Laws[A,Left.Span.group] ;

 forward-generator (v : Word (suc m) * Nat) : Right.Span.Certificate (Generators p wholeQ (suc m) v) =
  DM.theorem p q g v.1 v.2 ;
 module Forward = Left.Span.To[Right.Span.group,forward-generator] ;
 subgroup-forward (a : R) : Left.Span.Certificate a -> Right.Span.Certificate a = Forward.result a ;

 module ReverseGenerator (w : Word m) {
  t : R = product p m w ;
  module Coefficients = C.InGroup[LL.scaled t] ;
  products (i j : Nat) : Left.Span.Certificate (mul t (mul (coef p i) (coef wholeQ j))) =
   LL.transport (mul (mul (coef p i) t) (coef wholeQ j)) (mul t (mul (coef p i) (coef wholeQ j)))
    (trans (sym (mulA (coef p i) t (coef wholeQ j))) (mul-swap (coef p i) t (coef wholeQ j)))
    (Left.Span.element ((i,w),j)) ;
  result (k : Nat) : Left.Span.Certificate (mul t (coef h k)) =
   Coefficients.coefficient k p wholeQ (\ i b j -> products i j) ;
 } ;
 reverse-generator (v : Word m * Nat) : Left.Span.Certificate (Generators p h m v) =
  ReverseGenerator[v.1].result v.2 ;
 module Reverse = Right.Span.To[Left.Span.group,reverse-generator] ;
 subgroup-backward (a : R) : Right.Span.Certificate a -> Left.Span.Certificate a = Reverse.result a ;

 -- The same coefficient products generate c(P)^(m+1)c(Q) and c(P)^m c(PQ).
 module LeftIdeal = IdealSpan[l].Over[A,Word (suc m) * Nat,Generators p wholeQ (suc m)] ;
 module RightIdeal = IdealSpan[l].Over[A,Word m * Nat,Generators p h m] ;
 ideal-forward-generator (v : LeftIdeal.Index) : RightIdeal.Span.Certificate (LeftIdeal.family v) =
  RightIdeal.multiply v.1 (Generators p wholeQ (suc m) v.2)
   (RightIdeal.from-subgroup (Generators p wholeQ (suc m) v.2) (forward-generator v.2)) ;
 module IdealForward = LeftIdeal.Span.To[RightIdeal.Span.group,ideal-forward-generator] ;
 ideal-forward (a : R) : LeftIdeal.Span.Certificate a -> RightIdeal.Span.Certificate a = IdealForward.result a ;
 ideal-backward-generator (v : RightIdeal.Index) : LeftIdeal.Span.Certificate (RightIdeal.family v) =
  LeftIdeal.multiply v.1 (Generators p h m v.2)
   (LeftIdeal.from-subgroup (Generators p h m v.2) (reverse-generator v.2)) ;
 module IdealBackward = RightIdeal.Span.To[LeftIdeal.Span.group,ideal-backward-generator] ;
 ideal-backward (a : R) : RightIdeal.Span.Certificate a -> LeftIdeal.Span.Certificate a = IdealBackward.result a ;
} ;
