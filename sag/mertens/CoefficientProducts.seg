-- Coefficients of a product are sums of coefficient products. The bound on
-- the P index is retained for the ascending inner induction in mertens.pdf.
level l ; open Ring[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ; open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module J = FiniteJets[l].Over[A] ; module M = RawMultiplication[l].Laws[A] ;
 next (p q : P) (k : Nat) : Id R (coef (pmul p q) (suc k))
  (add (mul (coef q zero) (coef p (suc k))) (coef (pmul p (J.tail q)) k)) =
  trans (M.mul-comm p q (suc k))
   (trans (J.mul-next q p k)
    (ap (add (mul (coef q zero) (coef p (suc k)))) (M.mul-comm (J.tail q) p k))) ;
 module InGroup (K : AdditiveSpan[l].Group[A]) {
  module L = AdditiveSpan[l].Laws[A,K] ;
  Products (p q : P) (k : Nat) : U l =
   (i : Nat) -> FiniteJets[l].Lt (suc k) i -> (j : Nat) -> K.In (mul (coef p i) (coef q j)) ;
  tail-products (p q : P) (k : Nat) (h : Products p q (suc k)) : Products p (J.tail q) k =
   \ i b j -> L.transport (mul (coef p i) (coef q (suc j))) (mul (coef p i) (coef (J.tail q) j))
    (ap (mul (coef p i)) (sym (J.tail-coef q j))) (h i (FiniteJets[l].weaken (suc k) i b) (suc j)) ;
  coefficient : (k : Nat) (p q : P) -> Products p q k -> K.In (coef (pmul p q) k) = split {
   zero -> \ p q h -> L.transport (mul (coef p zero) (coef q zero)) (coef (pmul p q) zero)
    (sym (coef0-pmul p q)) (h zero tt zero) ;
   suc k | r -> \ p q h -> L.transport
    (add (mul (coef q zero) (coef p (suc k))) (coef (pmul p (J.tail q)) k)) (coef (pmul p q) (suc k))
    (sym (next p q k))
    (K.in-add (mul (coef q zero) (coef p (suc k))) (coef (pmul p (J.tail q)) k)
     (L.transport (mul (coef p (suc k)) (coef q zero)) (mul (coef q zero) (coef p (suc k)))
      (mulC (coef p (suc k)) (coef q zero)) (h (suc k) (FiniteJets[l].last (suc k)) zero))
     (r p (J.tail q) (tail-products p q k h))) } ;
 } ;
 Word : Nat -> U l = split { zero -> Top ; suc n | r -> Nat * r } ;
 product (p : P) : (n : Nat) -> Word n -> R = split {
  zero -> \ w -> o ; suc n | r -> \ w -> mul (coef p w.1) (r w.2) } ;
 Generators (p q : P) (n : Nat) : (Word n * Nat) -> R =
  \ w -> mul (product p n w.1) (coef q w.2) ;
 module ContentProduct (p q : P) (n : Nat) {
  module CSpan = AdditiveSpan[l].Over[A,Word n * Nat,Generators p q n] ;
 } ;
} ;
