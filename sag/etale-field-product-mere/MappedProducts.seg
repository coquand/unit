-- Transport the idempotent splitting recursion along any unital ring
-- map into S. Products and complements commute with that map. Explicit
-- transport of their equalities lets ProductsOnIdempotents glue both
-- image corners, including image idempotents that are zero.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra)
 (B : CRing) (setB : Pr.isSet B.R) (hom : H.Hom B S.ring) {
 module P = ProductsOnIdempotents[l].Over[k,setk,S] ;
 module Refine = FiniteRegularRefinement[l].Over[B,setB] ; module BI = Refine.PI ;
 module SI = PrimeIdempotents[l].Over[S.ring] ;
 square (e : B.R) (he : Refine.Square e) : P.Square (hom.1 e) = trans (sym (hom.2.2.2 e e)) (ap hom.1 he) ;
 Result (e : B.R) (he : Refine.Square e) : U l = P.Result (hom.1 e) (square e he) ;
 move (a b : S.ring.R) (eq : Id S.ring.R a b) (ha : P.Square a) (hb : P.Square b) (r : P.Result a ha) : P.Result b hb =
  subst (\ x -> (hx : P.Square x) -> P.Result x hx) eq (\ hx -> P.change a ha hx r) hb ;
 complement (f : B.R) : Id S.ring.R (hom.1 (BI.complement f)) (SI.complement (hom.1 f)) =
  trans (hom.2.2.1 B.o (B.neg f)) (cong2 S.ring.R S.ring.add _ _ _ _ hom.2.1 (H.negation B S.ring hom f)) ;
 product-complement (e f : B.R) : Id S.ring.R (hom.1 (B.mul e (BI.complement f)))
  (S.ring.mul (hom.1 e) (SI.complement (hom.1 f))) =
  trans (hom.2.2.2 e (BI.complement f)) (ap (S.ring.mul (hom.1 e)) (complement f)) ;
 glue (e f : B.R) (he : Refine.Square e) (hf : Refine.Square f)
  (left : Result (B.mul e f) (BI.product-idempotent e f he hf))
  (right : Result (B.mul e (BI.complement f)) (BI.product-idempotent e (BI.complement f) he (BI.complement-idempotent f hf))) : Result e he =
  P.glue (hom.1 e) (hom.1 f) (square e he) (square f hf)
   (move _ _ (hom.2.2.2 e f) (square (B.mul e f) (BI.product-idempotent e f he hf))
    (SI.product-idempotent (hom.1 e) (hom.1 f) (square e he) (square f hf)) left)
   (move _ _ (product-complement e f)
    (square (B.mul e (BI.complement f)) (BI.product-idempotent e (BI.complement f) he (BI.complement-idempotent f hf)))
    (SI.product-idempotent (hom.1 e) (SI.complement (hom.1 f)) (square e he) (SI.complement-idempotent (hom.1 f) (square f hf))) right) ;
 whole (r : Result B.o (B.mulO B.o)) : Tr.Trunc[ProductPresentation[l].Over[k,setk].At[S]].carrier =
  P.Whole.theorem (move (hom.1 B.o) S.ring.o hom.2.1 (square B.o (B.mulO B.o)) (S.ring.mulO S.ring.o) r) ;
} ;
