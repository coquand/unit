-- A regular polynomial on a finite free weak-field algebra has a unit
-- specialization on a sufficiently long list with pairwise unit differences.
-- Scan the determinant values with weak decisions. A unit value gives the
-- specialization by the adjugate. If every value is zero, the root bound
-- makes the determinant zero. Its regularity gives 1=0 in k[T], hence in
-- k, and the last specialization is then a unit as well.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier) {
 module At (S : Algebras[l].Over[k,setk].Algebra)
  (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n])
  (d : Nat) (p : Poly[l].PolyR[S.ring].P)
  (bound : PolynomialBounds[l].Over[S.ring].Bound (suc d) p)
  (regular : (q : PolynomialRing[l].Extension[S.ring,S.set].Carrier) ->
   Id (PolynomialRing[l].Extension[S.ring,S.set].Carrier)
    (PolynomialRing[l].Extension[S.ring,S.set].mulQ (PolynomialRing[l].Extension[S.ring,S.set].include p) q)
    PolynomialRing[l].Extension[S.ring,S.set].zeroQ ->
   Id (PolynomialRing[l].Extension[S.ring,S.set].Carrier) q PolynomialRing[l].Extension[S.ring,S.set].zeroQ) {
  module Data = FinitePolynomialSelection[l].Over[k,setk].At[S,n,b,d,p,bound,regular] ;
  module K = Data.K ; module Raw = Poly[l].PolyR[k] ;
  module RB = PolynomialRootBound[l].Over[k] ; module Field = FieldFlat[l].Over[k] ;
  module Given (candidates : Fin (suc Data.degree) -> k.R)
   (separated : RB.Separated (suc Data.degree) candidates) {
   values (i : Fin (suc Data.degree)) : k.R = Raw.ev Data.determinant-bound.raw (candidates i) ;
   Result : U l = (i : Fin (suc Data.degree)) *
    RL[S.ring].unit (Data.Evaluate[candidates i].Special.ES.evaluate Data.polynomial) ;
   module Vanishing (h : (i : Fin (suc Data.degree)) -> Id k.R (values i) k.z) {
    determinant-zero : Id K.Carrier Data.determinant K.zeroQ =
     trans (sym Data.determinant-bound.equation)
      (K.Q.relates Data.determinant-bound.raw nil
       (RB.Units.theorem (suc Data.degree) Data.determinant-bound.raw Data.determinant-bound.bounded candidates separated h)) ;
    polynomial-collapse : Id K.Carrier K.oneQ K.zeroQ =
     Data.Matrix.determinant-regular K.oneQ (trans (K.ring.mulO Data.determinant) determinant-zero) ;
    base-collapse : Id k.R k.o k.z = K.constant-injective k.o k.z
     (trans polynomial-collapse (sym (RingHom[l].zero k K.ring K.inclusion))) ;
    module Z = ZeroProduct[l].Collapse[k,base-collapse] ;
    last-unit : RL[k].unit (values (inr tt)) = (k.z,Z.equal _ _) ;
    result : Result = (inr tt,Data.Evaluate[candidates (inr tt)].unit last-unit) ;
   } ;
   choose : Field.Cases (suc Data.degree) values -> Result = split {
    inl h -> Vanishing[h].result ;
    inr u -> (u.1,Data.Evaluate[candidates u.1].unit u.2) } ;
   theorem : Tr.Trunc[Result].carrier =
    TC.map (Field.Cases (suc Data.degree) values) Result choose (Field.Mere[weak].cases (suc Data.degree) values) ;
  } ;
 } ;
} ;
