-- Run the weak large branch on the base algebra of F2 and on the zero
-- base. For the latter all scalar decisions say zero, while the scalar
-- family still has pairwise unit differences. This exercises the
-- vanishing-determinant success exit, not a nonzero-field contradiction.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module R = SeparatorRegression[l] ; module B = BooleanRing[l] ;
module MR = MereMinimalRegression[l] ; module Z = R.ZeroAlgebra ;
module Boolean (epsilon : R.Actual.Diag.Witness) {
 module Large = MereLargeFieldMonogenic[l].Over[R.k,B.bool-set,MR.weak,
  R.C.base,R.Actual.T.T,R.Actual.T.coproduct,R.one,R.base-basis,epsilon,SelectedCompleteRegression[l].reduced] ;
 module Ops = DiscreteFieldOperations[l].Over[R.k,B.bool-set,R.dec,R.nontrivial] ;
 inverse (a : R.k.R) (h : Not (Id R.k.R a R.k.z)) : RL[R.k].unit a = (Ops.inverse a,Ops.inverse-law a h) ;
 separated : PolynomialRootBound[l].Over[R.k].Separated Large.Search.count R.candidates =
  PolynomialRootBound[l].Over[R.k].Field[inverse].separated Large.Search.count R.candidates R.distinct ;
 theorem : Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]].carrier = Large.Given[R.candidates,separated].theorem ;
} ;
boolean-large : Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]].carrier =
 TC.bind R.Actual.Diag.Witness MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]
  (\ e -> Boolean[e].theorem) R.Actual.theorem ;
weak-zero (a : Z.ring.R) : Tr.Trunc[FieldFlat[l].Over[Z.ring].Decision a].carrier =
 Tr.Trunc[FieldFlat[l].Over[Z.ring].Decision a].inc (inl (MnSums[l].top-eq _ _)) ;
module C = MR.C ; module ZP = BasePresentation[l].Over[Z.ring,Z.set] ;
unique : FormallyEtale[l].Over[Z.ring,Z.set].Unique C.base =
 \ A N f g h -> C.ext C.base A f g (\ a -> trans (f.2 a) (sym (g.2 a))) ;
module Diag = DiagonalCertificate[l].Over[Z.ring,Z.set].Concrete[ZP.empty,C.base,ZP.presentation,unique] ;
module Zero (epsilon : Diag.Diag.Witness) {
 module Large = MereLargeFieldMonogenic[l].Over[Z.ring,Z.set,weak-zero,C.base,
  Diag.T.T,Diag.T.coproduct,R.one,MR.Basis.frame,epsilon,\ a h -> MnSums[l].top-eq _ _] ;
 candidates (i : Fin Large.Search.count) : Z.ring.R = tt ;
 separated : PolynomialRootBound[l].Over[Z.ring].Separated Large.Search.count candidates =
  \ i j h -> (tt,refl tt) ;
 theorem : Tr.Trunc[MonogenicPresentation[l].Over[Z.ring,Z.set].At[C.base]].carrier = Large.Given[candidates,separated].theorem ;
} ;
zero-large : Tr.Trunc[MonogenicPresentation[l].Over[Z.ring,Z.set].At[C.base]].carrier =
 TC.bind Diag.Diag.Witness MonogenicPresentation[l].Over[Z.ring,Z.set].At[C.base]
  (\ e -> Zero[e].theorem) Diag.theorem ;
