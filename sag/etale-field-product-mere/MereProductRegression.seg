-- Run the weak endpoint from fp/Unique, the finite-image branch on
-- F2^3 and the zero algebra, and the same small branch with the explicit
-- noninjective coefficient map F2 -> 0. No ambient equality operation is
-- passed to any new theorem. The latter still keeps its actual finite
-- coefficient field and verifies the degenerate image independently.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module R = SeparatorRegression[l] ; module B = BooleanRing[l] ;
module MR = MereMinimalRegression[l] ; module Z = R.ZeroAlgebra ; module H = RingHom[l] ;
module General = MereUnramifiedFieldProduct[l].Over[R.k,B.bool-set,MR.weak] ;
base : General.At[R.C.base,R.BaseP.finitely-presented,R.unique].Result = General.At[R.C.base,R.BaseP.finitely-presented,R.unique].theorem ;
module Functions (m : Nat) {
 module F = ProductRegression[l].Functions[m] ;
 module Apply = MereSmallFieldProduct[l].Over[R.k,B.bool-set,MR.weak,F.algebra,m,F.basis,F.reduced,F.nondegenerate,
  R.k,B.bool-set,R.dec,H.identity R.k,R.two,R.candidates,F.covers] ;
 theorem : Apply.Result = Apply.Given[F.lower,F.roots].theorem ;
} ;
three-factors : Functions[ProductRegression[l].three].Apply.Result = Functions[ProductRegression[l].three].theorem ;
zero-factors : Functions[zero].Apply.Result = Functions[zero].theorem ;
module Zero {
 module C = MR.C ; module P = BasePresentation[l].Over[Z.ring,Z.set] ;
 module ZeroGeneral = MereUnramifiedFieldProduct[l].Over[Z.ring,Z.set,MereLargeRegression[l].weak-zero] ;
 theorem : ZeroGeneral.At[C.base,P.finitely-presented,MereLargeRegression[l].unique].Result =
  ZeroGeneral.At[C.base,P.finitely-presented,MereLargeRegression[l].unique].theorem ;
 rho : H.Hom R.k Z.ring = (\ a -> tt,refl tt,\ a b -> refl tt,\ a b -> refl tt) ;
 collision : Id Z.ring.R (rho.1 false) (rho.1 true) = refl tt ;
 module Apply = MereSmallFieldProduct[l].Over[Z.ring,Z.set,MereLargeRegression[l].weak-zero,C.base,R.one,MR.Basis.frame,
  \ a h -> MnSums[l].top-eq _ _,\ a h -> MnSums[l].top-eq _ _,R.k,B.bool-set,R.dec,rho,
  R.two,R.candidates,ProductRegression[l].Functions[zero].covers] ;
 lower (i : Fin R.one) : List R.k.R = cons false nil ;
 roots : IteratedMonicBasis[l].Over[R.k,B.bool-set].Roots R.one lower Apply.restricted MR.Basis.frame.vector = \ i -> refl tt ;
 small : Apply.Result = Apply.Given[lower,roots].theorem ;
} ;
