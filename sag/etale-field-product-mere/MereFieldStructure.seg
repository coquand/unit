-- Finite span, basis and trace duality for a possibly zero weak field.
-- Finite span already uses merely zero-or-unit decisions. Gaussian
-- elimination now does too. Eliminate its normal forms inside the
-- finite-basis conclusion, then apply the decision-free trace theorem.
-- This supplies structural input to the product proof; it does not yet
-- construct a product or replace the remaining large/small argument.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ; module G = MereGaussian[l].Over[k,weak] ;
 module At (S : C.Algebra) (fp : P.FP S) (unique : FE.Unique S) {
  module Finite = UnramifiedFieldFiniteGeneral[l].Over[k,setk,weak].At[S,fp,unique] ;
  module Basis = FinitePresentedFieldBasis[l].Over[k,setk].At[S] ;
  module Trace = FiniteUnramifiedTrace[l].Over[k,setk] ;
  basis : Basis.Result = Basis.theorem G.normal-form fp Finite.finite ;
  module D = UnramifiedFieldStructure[l].Data[k,setk,S] ;
  module Given (w : Basis.Witness) {
   module T = Trace.At[S,w.1,w.2] ;
   construct (d : T.TD.Certificate) : D.Structure = new D.Structure[w.1,w.2,d,T.theorem fp unique] ;
   theorem : Tr.Trunc[D.Structure].carrier = TC.map T.TD.Certificate D.Structure construct (T.duality fp unique) ;
  } ;
  theorem : Tr.Trunc[D.Structure].carrier = TC.bind Basis.Witness D.Structure (\ w -> Given[w].theorem) basis ;
 } ;
} ;
