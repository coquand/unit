-- Degeneracy is a success case, with actual maps and inverse laws.
-- If 1=0, multiplication shows every element equals zero. Any algebra
-- with 1=0 is isomorphic to the monic quotient by 1. The derivative,
-- although zero, has an inverse in that zero quotient. A zero base
-- forces 1=0 in every algebra by its structure map.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Collapse (R : CRing) (one-zero : Id R.R R.o R.z) {
 zero (a : R.R) : Id R.R a R.z =
  trans (sym (R.mulO a)) (trans (ap (R.mul a) one-zero) (RL[R].mul-zero a)) ;
 equal (a b : R.R) : Id R.R a b = trans (zero a) (sym (zero b)) ;
} ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module P = ProductPresentation[l].Over[k,setk] ;
 module M = MonogenicPresentation[l].Over[k,setk] ;
 module Into (T : C.Algebra) (one-zero : Id T.ring.R T.ring.o T.ring.z) {
  module Z = Collapse[T.ring,one-zero] ;
  hom (S : C.Algebra) : C.Hom S T =
   ((\ a -> T.ring.z,Z.equal _ _,\ a b -> Z.equal _ _,\ a b -> Z.equal _ _),\ a -> Z.equal _ _) ;
 } ;
 module At (S : C.Algebra) (one-zero : Id S.ring.R S.ring.o S.ring.z) {
  module Q = MonicBasisUniversal[l].Over[k,setk].At[nil] ;
  module ZQ = Collapse[Q.Q.ring,Q.root] ; module ZS = Collapse[S.ring,one-zero] ;
  forward : C.Hom Q.Q S = Into[S,one-zero].hom Q.Q ;
  backward : C.Hom S Q.Q = Into[Q.Q,Q.root].hom S ;
  presentation : M.At[S] = new M.At[S,nil,forward,backward,
   \ a -> ZS.equal _ a,\ a -> ZQ.equal _ a,(Q.Q.ring.z,ZQ.equal _ _)] ;
  theorem : P.At[S] = P.monogenic S presentation ;
 } ;
 module BaseZero (one-zero : Id k.R k.o k.z) {
  algebra-zero (S : C.Algebra) : Id S.ring.R S.ring.o S.ring.z =
   trans (sym S.iota.2.1) (trans (ap S.iota.1 one-zero) (H.zero k S.ring S.iota)) ;
  theorem (S : C.Algebra) : P.At[S] = At[S,algebra-zero S].theorem ;
 } ;
} ;
