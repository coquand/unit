-- Exercise positive separation and minimality over F2 and over the zero
-- ring. In the zero ring deliberately answer every weak query by a unit:
-- span membership and separation can both hold, so disjointness is invalid.
-- Also construct separable monogenic maps for F2 x F2 and for the zero base.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module B = BooleanRing[l] ;
module R = PrimitiveRegression[l] ; module Z = SeparatorRegression[l].ZeroAlgebra ;
weak (a : R.k.R) : Tr.Trunc[FieldFlat[l].Over[R.k].Decision a].carrier =
 Tr.Trunc[FieldFlat[l].Over[R.k].Decision a].inc (R.dec a) ;
module Min = MereMinimalPolynomial[l].Over[R.k,B.bool-set,weak,R.S,R.two,R.basis,(true,false)] ;
bounded : Tr.Trunc[Min.Min.Minimal].carrier =
 Min.from-annihilator (cons false (cons true nil)) R.minimal-root ;
integral : Tr.Trunc[Min.Min.Minimal].carrier = Min.theorem ;
module Mono = MereGeneratedMonogenic[l].Over[R.k,B.bool-set,weak,R.S,R.two,R.basis,R.reduced,
 R.ND.nondegenerate R.perfect,(true,false),R.polynomial-generation] ;
split-monic : Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.S]].carrier = Mono.theorem ;
module Given (f : Min.Min.Minimal) {
 module I = MinimalPolynomialInjection[l].Over[R.k,B.bool-set,R.S,R.two,R.basis,(true,false)].At[f] ;
 inverse (a : R.Pair) : Id R.Pair (I.hom.1.1 (I.Monogenic[R.polynomial-generation].backward.1.1 a)) a =
  I.Monogenic[R.polynomial-generation].forward-backward a ;
 divides : Id Min.Min.B.Carrier (Min.Min.B.include R.f)
  (Min.Min.B.mulQ (Min.Min.B.include Min.Min.Given[f].polynomial)
   (Min.Min.B.include Min.Min.Given[f].Divides[R.f,R.minimal-root].d.1)) =
  Min.Min.Given[f].Divides[R.f,R.minimal-root].equation ;
} ;
module C = Algebras[l].Over[Z.ring,Z.set] ;
weak-zero (a : Z.ring.R) : Tr.Trunc[FieldFlat[l].Over[Z.ring].Decision a].carrier =
 Tr.Trunc[FieldFlat[l].Over[Z.ring].Decision a].inc (inr (tt,refl tt)) ;
module Basis = R.BaseBasis[Z.ring,Z.set] ;
module Zero = MereMinimalPolynomial[l].Over[Z.ring,Z.set,weak-zero,C.base,R.one,Basis.frame,tt] ;
zero-bound : Tr.Trunc[Zero.Min.Minimal].carrier = Zero.from-annihilator nil (MnSums[l].top-eq _ _) ;
zero-integral : Tr.Trunc[Zero.Min.Minimal].carrier = Zero.theorem ;
zero-finish : Zero.Min.Minimal = Zero.finish nil (MnSums[l].top-eq _ _) (inr (\ p bound root -> bound)) ;
degree-zero : Id Nat zero-finish.degree zero = refl zero ;
module Sep = MereLinearSeparation[l].Over[Z.ring,weak-zero].At[R.one,zero,\ j -> efq j,\ i -> tt] ;
functional : Sep.F.Functional = new Sep.F.Functional[\ a -> tt,\ a b -> refl tt,
 \ r a -> refl tt,\ i -> refl tt,refl tt] ;
span : GaussianVectors[l].Over[Z.ring].Span[R.one,zero,\ j -> efq j].Witness (\ i -> tt) = (\ i -> efq i,\ i -> refl tt) ;
overlap : Id Z.ring.R Z.ring.o Z.ring.z = Sep.F.On[functional].overlap span ;
zero-separate : Tr.Trunc[Sep.Result].carrier = Sep.theorem ;
generated (a : Z.ring.R) : Tr.Trunc[(p : Zero.Min.B.Carrier) * Id Z.ring.R (Zero.P.UP.extend.1 p) a].carrier =
 Tr.Trunc[(p : Zero.Min.B.Carrier) * Id Z.ring.R (Zero.P.UP.extend.1 p) a].inc
  (Zero.Min.B.zeroQ,MnSums[l].top-eq _ _) ;
module ZeroMono = MereGeneratedMonogenic[l].Over[Z.ring,Z.set,weak-zero,C.base,R.one,Basis.frame,
 \ a h -> MnSums[l].top-eq _ _,\ a h -> MnSums[l].top-eq _ _,tt,generated] ;
zero-monic : Tr.Trunc[MonogenicPresentation[l].Over[Z.ring,Z.set].At[C.base]].carrier = ZeroMono.theorem ;
