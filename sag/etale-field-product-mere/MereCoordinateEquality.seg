-- Compare finitely many coordinates using weak scalar decisions.
-- Equal coordinates reconstruct equal elements. A unit difference at
-- one coordinate sends any purported equality to 1=0 in the base.
-- The second alternative is relative negation, never ambient inequality.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier) {
 Collapse : U l = Id k.R k.o k.z ;
 module F = FieldFlat[l].Over[k] ; module L = RL[k] ;
 module At (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
  (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
  module B = TraceBasis[l].Over[k,setk,S].At[n,basis] ;
  difference (a b : S.ring.R) (i : Fin n) : k.R =
   k.add (basis.coordinate a i) (k.neg (basis.coordinate b i)) ;
  same (a b : S.ring.R) (h : (i : Fin n) -> Id k.R (difference a b i) k.z) : Id S.ring.R a b =
   B.coordinates-determine a b (\ i -> PolynomialRootBound[l].Over[k].sub-zero _ _ (h i)) ;
  collision (a b : S.ring.R) (i : Fin n) (u : L.unit (difference a b i)) (h : Id S.ring.R a b) : Collapse =
   trans (sym u.2)
    (trans (ap (\ c -> k.mul c u.1)
     (trans (ap (\ c -> k.add (basis.coordinate c i) (k.neg (basis.coordinate b i))) h)
      (k.addN (basis.coordinate b i)))) (L.zero-mul u.1)) ;
  choose (a b : S.ring.R) : F.Cases n (difference a b) -> Plus (Id S.ring.R a b) (Id S.ring.R a b -> Collapse) = split {
   inl h -> inl (same a b h) ; inr w -> inr (collision a b w.1 w.2) } ;
  theorem (a b : S.ring.R) : Tr.Trunc[Plus (Id S.ring.R a b) (Id S.ring.R a b -> Collapse)].carrier =
   TC.map (F.Cases n (difference a b)) (Plus (Id S.ring.R a b) (Id S.ring.R a b -> Collapse))
    (choose a b) (F.Mere[weak].cases n (difference a b)) ;
 } ;
} ;
