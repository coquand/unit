-- Positive lookup in a finite scalar family. Merely either find an
-- equal entry or give a unit difference from every entry. The latter
-- extends a unit-separated family, even when the base ring is zero.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier) {
 module FD = FiniteDistinct[l].Over[k.R,setk] ; module RB = PolynomialRootBound[l].Over[k] ; module L = RL[k] ;
 Apart (n : Nat) (v : Fin n -> k.R) (x : k.R) : U l =
  (i : Fin n) -> L.unit (k.add (v i) (k.neg x)) ;
 Result (n : Nat) (v : Fin n -> k.R) (x : k.R) : U l = Plus (FD.Member n v x) (Apart n v x) ;
 old-case (n : Nat) (v : Fin (suc n) -> k.R) (x : k.R)
  (unit : L.unit (k.add (v (inr tt)) (k.neg x))) : Result n (\ i -> v (inl i)) x -> Result (suc n) v x = split {
  inl w -> inl (inl w.1,w.2) ;
  inr h -> inr (AffineFinite[l].section n (\ i -> L.unit (k.add (v i) (k.neg x))) h unit) } ;
 last (n : Nat) (v : Fin (suc n) -> k.R) (x : k.R) (old : Result n (\ i -> v (inl i)) x) :
  Plus (Id k.R (k.add (v (inr tt)) (k.neg x)) k.z) (L.unit (k.add (v (inr tt)) (k.neg x))) -> Result (suc n) v x = split {
  inl h -> inl (inr tt,RB.sub-zero (v (inr tt)) x h) ;
  inr u -> old-case n v x u old } ;
 lookup : (n : Nat) (v : Fin n -> k.R) (x : k.R) -> Tr.Trunc[Result n v x].carrier = split {
  zero -> \ v x -> Tr.Trunc[Result zero v x].inc (inr (\ i -> efq i)) ;
  suc n | ih -> \ v x -> TC.map2 (Result n (\ i -> v (inl i)) x)
   (Plus (Id k.R (k.add (v (inr tt)) (k.neg x)) k.z) (L.unit (k.add (v (inr tt)) (k.neg x))))
   (Result (suc n) v x) (last n v x) (ih (\ i -> v (inl i)) x) (weak (k.add (v (inr tt)) (k.neg x))) } ;
 negate-unit (a : k.R) (u : L.unit a) : L.unit (k.neg a) =
  (k.neg u.1,trans (L.neg-mul-left a (k.neg u.1))
   (trans (ap k.neg (L.mul-neg a u.1)) (trans (L.neg-neg (k.mul a u.1)) u.2))) ;
 reverse (a b : k.R) (u : L.unit (k.add a (k.neg b))) : L.unit (k.add b (k.neg a)) =
  subst L.unit (trans (L.negsub a b) (k.addC (k.neg a) b)) (negate-unit (k.add a (k.neg b)) u) ;
 module Append (n : Nat) (v : Fin n -> k.R) (separated : RB.Separated n v)
  (x : k.R) (apart : Apart n v x) {
  vector : Fin (suc n) -> k.R = snoc (Fin n) k.R v x ;
  theorem : RB.Separated (suc n) vector = split {
   inl i -> split {
    inl j -> \ h -> separated i j (\ eq -> h (ap (\ a -> inl a) eq)) ;
    inr t -> \ h -> apart i } ;
   inr t -> split {
    inl j -> \ h -> reverse (v j) x (apart j) ;
    inr u -> \ h -> efq (h (ap (\ a -> inr a) (AffineFinite[l].top-eq t u))) } } ;
 } ;
} ;
