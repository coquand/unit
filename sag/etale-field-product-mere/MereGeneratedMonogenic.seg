-- A generated reduced finite-basis algebra with nondegenerate trace
-- over a weak field has an actual separable monic presentation, merely.
-- Obtain the minimal polynomial by bounded search. Its quotient embeds
-- by minimality, and generation constructs both inverse algebra maps.
-- Reducedness passes to this quotient. Weak coefficient stripping makes
-- it regular, so trace nondegeneracy makes the derivative invertible.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (x : S.ring.R)
 (generated : (a : S.ring.R) -> Tr.Trunc[(p : PolynomialRing[l].Extension[k,setk].Carrier) *
  Id S.ring.R (Universal[l].Property[k,S.ring,setk,S.set].Given[S.iota,x].extend.1 p) a].carrier) {
 module Search = MereMinimalPolynomial[l].Over[k,setk,weak,S,n,basis,x] ;
 module Build = GeneratedSeparableMonogenic[l].Over[k,setk,S,n,basis,reduced,nondegenerate,x,generated] ;
 module Given (f : Search.Min.Minimal) {
  module Image = Build.Injection.At[f] ;
  regular : PrincipalRegularity[l].Over[Image.Q.ring].Regular =
   FiniteReducedRegular[l].Over[k,setk,Image.Q,Image.M.degree,Image.M.basis,Image.Reduced[reduced].theorem].theorem weak ;
  theorem : Build.Target.At[S] = Build.Given[f].theorem regular ;
 } ;
 theorem : Tr.Trunc[Build.Target.At[S]].carrier =
  TC.map Search.Min.Minimal (Build.Target.At[S]) (\ f -> Given[f].theorem) Search.theorem ;
} ;
