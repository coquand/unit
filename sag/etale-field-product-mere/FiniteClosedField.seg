-- Verify a finite closed coefficient table. Its operations preserve
-- values in k. For each of the finitely many ring equations, compare
-- the two indices. If they differ, unit separation and their equal
-- values prove 1=0. Otherwise the table is an actual finite ring.
-- Verify the zero-or-inverse equations in the same way and compare
-- its one and zero indices. Success gives an actual nonzero finite
-- field mapping to k, with preimages of the original coefficients.
-- The map is deliberately not asserted injective.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module FS = FiniteScan[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (t : Nat) (coefficients : Fin t -> k.R)
 (n : Nat) (v : Fin n -> k.R) (separated : PolynomialRootBound[l].Over[k].Separated n v)
 (closed : MereFiniteClosure[l].Over[k,setk,weak,t,coefficients].At[n,v].Closed) {
 module Reflect = FiniteTableReflection[l].Over[k,n,v,separated] ;
 module Index = FinitePermutationFold[l].Index ;
 z : Fin n = closed.zero.1 ; o : Fin n = closed.one.1 ;
 add (a b : Fin n) : Fin n = (closed.addition a b).1 ;
 mul (a b : Fin n) : Fin n = (closed.multiplication a b).1 ;
 neg (a : Fin n) : Fin n = (closed.negation a).1 ;
 zero-image : Id k.R (v z) k.z = closed.zero.2 ;
 one-image : Id k.R (v o) k.o = closed.one.2 ;
 add-image (a b : Fin n) : Id k.R (v (add a b)) (k.add (v a) (v b)) = (closed.addition a b).2 ;
 mul-image (a b : Fin n) : Id k.R (v (mul a b)) (k.mul (v a) (v b)) = (closed.multiplication a b).2 ;
 neg-image (a : Fin n) : Id k.R (v (neg a)) (k.neg (v a)) = (closed.negation a).2 ;
 Eq (a b : Fin n) : U l = Id (Fin n) a b ;
 AddA : U l = (a b c : Fin n) -> Eq (add a (add b c)) (add (add a b) c) ;
 AddC : U l = (a b : Fin n) -> Eq (add a b) (add b a) ;
 AddZ : U l = (a : Fin n) -> Eq (add a z) a ;
 AddN : U l = (a : Fin n) -> Eq (add a (neg a)) z ;
 MulA : U l = (a b c : Fin n) -> Eq (mul a (mul b c)) (mul (mul a b) c) ;
 MulC : U l = (a b : Fin n) -> Eq (mul a b) (mul b a) ;
 MulO : U l = (a : Fin n) -> Eq (mul a o) a ;
 Dist : U l = (a b c : Fin n) -> Eq (mul a (add b c)) (add (mul a b) (mul a c)) ;
 Inverse (a : Fin n) : U l = Plus (Eq a z) ((b : Fin n) * Eq (mul a b) o) ;
 record Verified {
  addA : AddA ; addC : AddC ; addZ : AddZ ; addN : AddN ;
  mulA : MulA ; mulC : MulC ; mulO : MulO ; dist : Dist ;
  inverse : (a : Fin n) -> Inverse a ;
  nonzero : Not (Eq o z) ;
 } ;
 addA-image (a b c : Fin n) : Id k.R (v (add a (add b c))) (v (add (add a b) c)) =
  trans (add-image a (add b c))
   (trans (ap (k.add (v a)) (add-image b c))
    (trans (k.addA (v a) (v b) (v c))
     (sym (trans (add-image (add a b) c) (ap (\ x -> k.add x (v c)) (add-image a b)))))) ;
 addC-image (a b : Fin n) : Id k.R (v (add a b)) (v (add b a)) =
  trans (add-image a b) (trans (k.addC (v a) (v b)) (sym (add-image b a))) ;
 addZ-image (a : Fin n) : Id k.R (v (add a z)) (v a) =
  trans (add-image a z) (trans (ap (k.add (v a)) zero-image) (k.addZ (v a))) ;
 addN-image (a : Fin n) : Id k.R (v (add a (neg a))) (v z) =
  trans (add-image a (neg a)) (trans (ap (k.add (v a)) (neg-image a)) (trans (k.addN (v a)) (sym zero-image))) ;
 mulA-image (a b c : Fin n) : Id k.R (v (mul a (mul b c))) (v (mul (mul a b) c)) =
  trans (mul-image a (mul b c))
   (trans (ap (k.mul (v a)) (mul-image b c))
    (trans (k.mulA (v a) (v b) (v c))
     (sym (trans (mul-image (mul a b) c) (ap (\ x -> k.mul x (v c)) (mul-image a b)))))) ;
 mulC-image (a b : Fin n) : Id k.R (v (mul a b)) (v (mul b a)) =
  trans (mul-image a b) (trans (k.mulC (v a) (v b)) (sym (mul-image b a))) ;
 mulO-image (a : Fin n) : Id k.R (v (mul a o)) (v a) =
  trans (mul-image a o) (trans (ap (k.mul (v a)) one-image) (k.mulO (v a))) ;
 dist-image (a b c : Fin n) : Id k.R (v (mul a (add b c))) (v (add (mul a b) (mul a c))) =
  trans (mul-image a (add b c))
   (trans (ap (k.mul (v a)) (add-image b c))
    (trans (k.dist (v a) (v b) (v c))
     (sym (trans (add-image (mul a b) (mul a c))
      (cong2 k.R k.add _ _ _ _ (mul-image a b) (mul-image a c)))))) ;
 -- Finite verification of equations with one, two or three indices.
 unary (left right : Fin n -> Fin n) (images : (a : Fin n) -> Id k.R (v (left a)) (v (right a))) :
  Plus ((a : Fin n) -> Eq (left a) (right a)) Reflect.Collapse =
  FS.scan n (\ a -> Eq (left a) (right a)) Reflect.Collapse (\ a -> Reflect.reflect (left a) (right a) (images a)) ;
 binary (left right : Fin n -> Fin n -> Fin n)
  (images : (a b : Fin n) -> Id k.R (v (left a b)) (v (right a b))) :
  Plus ((a b : Fin n) -> Eq (left a b) (right a b)) Reflect.Collapse =
  FS.scan n (\ a -> (b : Fin n) -> Eq (left a b) (right a b)) Reflect.Collapse (\ a -> unary (left a) (right a) (images a)) ;
 ternary (left right : Fin n -> Fin n -> Fin n -> Fin n)
  (images : (a b c : Fin n) -> Id k.R (v (left a b c)) (v (right a b c))) :
  Plus ((a b c : Fin n) -> Eq (left a b c) (right a b c)) Reflect.Collapse =
  FS.scan n (\ a -> (b c : Fin n) -> Eq (left a b c) (right a b c)) Reflect.Collapse (\ a -> binary (left a) (right a) (images a)) ;
 inverse-case (a : Fin n) : MereFiniteClosure[l].Over[k,setk,weak,t,coefficients].At[n,v].Inverse a -> Plus (Inverse a) Reflect.Collapse = split {
  inl h -> FS.map (Eq a z) (Inverse a) Reflect.Collapse (\ eq -> inl eq) (Reflect.reflect a z (trans h (sym zero-image))) ;
  inr w -> FS.map (Eq (mul a w.1) o) (Inverse a) Reflect.Collapse (\ eq -> inr (w.1,eq))
   (Reflect.reflect (mul a w.1) o (trans (mul-image a w.1) (trans w.2 (sym one-image)))) } ;
 nonzero-case : Plus (Eq o z) (Not (Eq o z)) -> Plus (Not (Eq o z)) Reflect.Collapse = split {
  inl h -> inr (trans (sym one-image) (trans (ap v h) zero-image)) ; inr h -> inl h } ;
 Laws : U l = AddA * AddC * AddZ * AddN * MulA * MulC * MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z) ;
 laws : Plus Laws Reflect.Collapse =
  FS.join AddA (AddC * AddZ * AddN * MulA * MulC * MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
   (ternary (\ a b c -> add a (add b c)) (\ a b c -> add (add a b) c) addA-image)
   (FS.join AddC (AddZ * AddN * MulA * MulC * MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
    (binary add (\ a b -> add b a) addC-image)
    (FS.join AddZ (AddN * MulA * MulC * MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
     (unary (\ a -> add a z) (\ a -> a) addZ-image)
     (FS.join AddN (MulA * MulC * MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
      (unary (\ a -> add a (neg a)) (\ a -> z) addN-image)
      (FS.join MulA (MulC * MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
       (ternary (\ a b c -> mul a (mul b c)) (\ a b c -> mul (mul a b) c) mulA-image)
       (FS.join MulC (MulO * Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
        (binary mul (\ a b -> mul b a) mulC-image)
        (FS.join MulO (Dist * ((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
         (unary (\ a -> mul a o) (\ a -> a) mulO-image)
         (FS.join Dist (((a : Fin n) -> Inverse a) * Not (Eq o z)) Reflect.Collapse
          (ternary (\ a b c -> mul a (add b c)) (\ a b c -> add (mul a b) (mul a c)) dist-image)
          (FS.join ((a : Fin n) -> Inverse a) (Not (Eq o z)) Reflect.Collapse
           (FS.scan n Inverse Reflect.Collapse (\ a -> inverse-case a (closed.inversion a)))
           (nonzero-case (Index.decide n o z)))))))))) ;
 pack (d : Laws) : Verified = new Verified[d.1,d.2.1,d.2.2.1,d.2.2.2.1,d.2.2.2.2.1,
  d.2.2.2.2.2.1,d.2.2.2.2.2.2.1,d.2.2.2.2.2.2.2.1,d.2.2.2.2.2.2.2.2.1,d.2.2.2.2.2.2.2.2.2] ;
 theorem : Plus Verified Reflect.Collapse = FS.map Laws Verified Reflect.Collapse pack laws ;
 module Given (h : Verified) {
  ring : CRing = mkCRing (Fin n) z o add mul neg h.addA h.addC h.addZ h.addN h.mulA h.mulC h.mulO h.dist ;
  set : Pr.isSet ring.R = FiniteTableReflection[l].Discrete[Fin n,Index.decide n].set ;
  inclusion : RingHom[l].Hom ring k = (v,one-image,add-image,mul-image) ;
  field : SelectedFactorStatement[l].Over[ring,set].Field =
   new SelectedFactorStatement[l].Over[ring,set].Field[h.inverse,h.nonzero] ;
  coefficient (i : Fin t) : ring.R = (closed.coefficients-in i).1 ;
  coefficient-image (i : Fin t) : Id k.R (inclusion.1 (coefficient i)) (coefficients i) = (closed.coefficients-in i).2 ;
 } ;
} ;
