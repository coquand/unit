-- A finite enumeration spans any algebra: the coordinate at the chosen
-- index is one and all others are zero. The determinant trick supplies
-- monic relations, and coefficient stripping over the exact coefficient
-- field makes every element of a reduced enumerated algebra regular.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (K : CRing) (setK : Pr.isSet K.R)
 (dec : (a : K.R) -> Plus (Id K.R a K.z) (RL[K].unit a))
 (B : Algebras[l].Over[K,setK].Algebra)
 (n : Nat) (values : Fin n -> B.ring.R)
 (cover : (a : B.ring.R) -> (i : Fin n) * Id B.ring.R (values i) a)
 (reduced : (a : B.ring.R) -> Id B.ring.R (B.ring.mul a a) B.ring.z -> Id B.ring.R a B.ring.z) {
 module Spanning = FiniteSpan[l].Over[K,B.ring,B.iota] ;
 module Delta = MnSums[l].Over[K] ;
 module Rows = FieldFlat[l].Over[K].To[B.ring,B.iota] ;
 coordinates (a : B.ring.R) : Spanning.Coordinates n values a =
  (\ j -> Delta.delta n j (cover a).1,trans (Rows.row n (cover a).1 values) (cover a).2) ;
 finite : Spanning.Data = (n,values,\ a -> Tr.Trunc[Spanning.Coordinates n values a].inc (coordinates a)) ;
 module Integral = FiniteSpanIntegral[l].Over[K,B.ring,setK,B.set,B.iota] ;
 module Regular = ReducedIntegralRegular[l].Over[K,setK,B,reduced] ;
 module At (a : B.ring.R) {
  module Values = MonicValueNaturality[l].Over[K,setK].Horner[B,a] ;
  convert (w : Integral.IM.IntegralWitness a) : Regular.R.Witness a =
   Regular.Exact[dec].from-annihilator a w.1 (trans (Values.equation w.1) (trans (Values.integral-value w.1) w.2)) ;
 } ;
 theorem : Regular.R.Regular = \ a -> TC.map (Integral.IM.IntegralWitness a) (Regular.R.Witness a) (At[a].convert) (Integral.integral finite a) ;
} ;
