-- Assemble the weak large/small dichotomy. Base collapse supplies the
-- zero certificate; unit-separated scalars supply a global generator;
-- a finite coefficient field mapping to the base supplies the verified
-- finite image/product branch. The finite model map is never assumed
-- injective, and no exact equality operation on the base is selected.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (D : Algebras[l].Over[k,setk].Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness) {
 module Target = ProductPresentation[l].Over[k,setk] ; module Mono = MonogenicPresentation[l].Over[k,setk] ;
 module Monic = FiniteMonicCoefficientFamily[l].Over[k,setk,S,n,basis] ;
 module Large = MereLargeFieldMonogenic[l].Over[k,setk,weak,S,D,cp,n,basis,epsilon,reduced] ;
 Result : U l = Tr.Trunc[Target.At[S]].carrier ;
 module Given (m : Monic.Data) {
  module Coefficients = MereCoefficientDichotomy[l].Over[k,setk,weak,m.count,m.coefficient] ;
  large (many : Coefficients.Closure.Many Large.Search.count) : Result =
   TC.map (Mono.At[S]) (Target.At[S]) (Target.monogenic S) (Large.Given[many.1,many.2].theorem) ;
  module Small (s : Coefficients.Small) {
   module Model = Coefficients.Model[s] ; module K = Model.Field ;
   module Lift = Monic.Given[m].Lift[K.ring,K.set,K.inclusion,K.coefficient,K.coefficient-image] ;
   theorem : Result = MereSmallFieldProduct[l].Over[k,setk,weak,S,n,basis,reduced,nondegenerate,
    K.ring,K.set,K.field.decide,K.inclusion,s.1.1,Model.enumeration,Model.cover].Given[Lift.lower,Lift.roots].theorem ;
  } ;
  nonzero-cases : Plus (Coefficients.Closure.Many Large.Search.count) Coefficients.Small -> Result = split {
   inl many -> large many ; inr s -> Small[s].theorem } ;
  cases : Coefficients.Result Large.Search.degree -> Result = split {
   inl h -> Tr.Trunc[Target.At[S]].inc (ZeroProduct[l].Over[k,setk].BaseZero[h].theorem S) ;
   inr w -> nonzero-cases w } ;
  theorem : Result = TC.rec (Coefficients.Result Large.Search.degree) @l Result Tr.Trunc[Target.At[S]].proposition
   cases (Coefficients.theorem Large.Search.degree) ;
 } ;
 theorem : Result = TC.rec Monic.Data @l Result Tr.Trunc[Target.At[S]].proposition (\ m -> Given[m].theorem) Monic.theorem ;
} ;
