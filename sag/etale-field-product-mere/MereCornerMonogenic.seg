-- Polynomial representatives of the projected ambient basis generate
-- an idempotent corner. Choose its Gaussian basis merely, then transfer
-- reducedness and nondegenerate trace through the retraction. Apply the
-- weak generated-monogenic theorem. No exact equality in the base is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (e : S.ring.R) (he : Id S.ring.R (S.ring.mul e e) e) {
 module R = TraceRetraction[l].Idempotent[k,setk,S,e,he] ; module F = R.F ;
 module Basis = IdempotentFieldBasis[l].Data[k,setk,S,n,basis,e,he] ;
 module Target = MonogenicPresentation[l].Over[k,setk] ;
 module Lists (x : F.Carrier) (representative : Fin n -> List k.R)
  (equation : (i : Fin n) -> Id F.Carrier
   (MonicReduce[l].Horner[k,F.ring,R.iota,x].horner (representative i)) (F.project (basis.vector i))) {
  module Given (q : Basis.G.G.G.NormalForm[n,n,Basis.relations]) {
   module B = Basis.Given[q] ;
   module Spanning = IdempotentMonogenicSpan[l].Over[k,setk,S,n,basis,reduced,nondegenerate,e,he,B.rank,B.basis] ;
   module Generation = Spanning.Lists[x,representative,equation].Generation ;
   theorem : Tr.Trunc[Target.At[R.algebra]].carrier =
    MereGeneratedMonogenic[l].Over[k,setk,weak,R.algebra,B.rank,B.basis,Spanning.factor-reduced,
     Spanning.Trace.nondegenerate nondegenerate,x,Generation.theorem].theorem ;
  } ;
  theorem : Tr.Trunc[Target.At[R.algebra]].carrier =
   TC.bind Basis.G.G.G.NormalForm[n,n,Basis.relations] (Target.At[R.algebra])
    (\ q -> Given[q].theorem) (MereGaussian[l].Over[k,weak].normal-form n n Basis.relations) ;
 } ;
} ;
