-- A component is a retract with a nonunital section. The projection is
-- an algebra map; the section is additive, multiplicative and linear
-- over the ambient algebra. Its value at 1 is the support idempotent.
-- These data compose. The two projections of a binary product give
-- corners whose supports sum to 1, including when a factor is zero.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module Iso = AlgebraIsomorphism[l].Over[k,setk] ;
 record Retract (S T : C.Algebra) {
  projection : C.Hom S T ;
  section : T.ring.R -> S.ring.R ;
  zero : Id S.ring.R (section T.ring.z) S.ring.z ;
  add (a b : T.ring.R) : Id S.ring.R (section (T.ring.add a b)) (S.ring.add (section a) (section b)) ;
  mul (a b : T.ring.R) : Id S.ring.R (section (T.ring.mul a b)) (S.ring.mul (section a) (section b)) ;
  retraction (a : T.ring.R) : Id T.ring.R (projection.1.1 (section a)) a ;
  linear (b : T.ring.R) (a : S.ring.R) :
   Id S.ring.R (section (T.ring.mul b (projection.1.1 a))) (S.ring.mul (section b) a) ;
 } ;
 module At (S T : C.Algebra) (r : Retract[S,T]) {
  support : S.ring.R = r.section T.ring.o ;
  square : Id S.ring.R (S.ring.mul support support) support =
   trans (sym (r.mul T.ring.o T.ring.o)) (ap r.section (T.ring.mulO T.ring.o)) ;
  restriction (a : S.ring.R) : Id S.ring.R (r.section (r.projection.1.1 a)) (S.ring.mul support a) =
   trans (ap r.section (sym (RL[T.ring].one-left (r.projection.1.1 a)))) (r.linear T.ring.o a) ;
  constants (a : k.R) : Id S.ring.R (r.section (T.iota.1 a)) (S.ring.mul support (S.iota.1 a)) =
   trans (ap r.section (sym (r.projection.2 a))) (restriction (S.iota.1 a)) ;
 } ;
 compose (S T U0 : C.Algebra) (r : Retract[S,T]) (t : Retract[T,U0]) : Retract[S,U0] =
  new Retract[S,U0,C.compose S T U0 t.projection r.projection,\ a -> r.section (t.section a),
   trans (ap r.section t.zero) r.zero,
   \ a b -> trans (ap r.section (t.add a b)) (r.add (t.section a) (t.section b)),
   \ a b -> trans (ap r.section (t.mul a b)) (r.mul (t.section a) (t.section b)),
   \ a -> trans (ap t.projection.1.1 (r.retraction (t.section a))) (t.retraction a),
   \ b a -> trans (ap r.section (t.linear b (r.projection.1.1 a))) (r.linear (t.section b) a)] ;
 from-iso (S T : C.Algebra) (f : Iso.Iso[T,S]) : Retract[S,T] =
  new Retract[S,T,f.backward,f.forward.1.1,H.zero T.ring S.ring f.forward.1,
   f.forward.1.2.2.1,f.forward.1.2.2.2,f.backward-forward,
   \ b a -> trans (f.forward.1.2.2.2 b (f.backward.1.1 a))
    (ap (S.ring.mul (f.forward.1.1 b)) (f.forward-backward a))] ;
 module Pair (S T : C.Algebra) {
  module P = Iso.Product[S,T] ;
  first : C.Hom P.algebra S = ((\ a -> a.1,refl S.ring.o,\ a b -> refl (S.ring.add a.1 b.1),
   \ a b -> refl (S.ring.mul a.1 b.1)),\ a -> refl (S.iota.1 a)) ;
  second : C.Hom P.algebra T = ((\ a -> a.2,refl T.ring.o,\ a b -> refl (T.ring.add a.2 b.2),
   \ a b -> refl (T.ring.mul a.2 b.2)),\ a -> refl (T.iota.1 a)) ;
  left : Retract[P.algebra,S] = new Retract[P.algebra,S,first,\ a -> (a,T.ring.z),refl (S.ring.z,T.ring.z),
   \ a b -> P.eq _ _ (refl (S.ring.add a b)) (sym (T.ring.addZ T.ring.z)),
   \ a b -> P.eq _ _ (refl (S.ring.mul a b)) (sym (RL[T.ring].zero-mul T.ring.z)),
   \ a -> refl a,\ b a -> P.eq _ _ (refl (S.ring.mul b a.1)) (sym (RL[T.ring].zero-mul a.2))] ;
  right : Retract[P.algebra,T] = new Retract[P.algebra,T,second,\ a -> (S.ring.z,a),refl (S.ring.z,T.ring.z),
   \ a b -> P.eq _ _ (sym (S.ring.addZ S.ring.z)) (refl (T.ring.add a b)),
   \ a b -> P.eq _ _ (sym (RL[S.ring].zero-mul S.ring.z)) (refl (T.ring.mul a b)),
   \ a -> refl a,\ b a -> P.eq _ _ (sym (RL[S.ring].zero-mul a.1)) (refl (T.ring.mul b a.2))] ;
  sum-one : Id P.Carrier (P.ring.add (left.section S.ring.o) (right.section T.ring.o)) P.ring.o =
   P.eq _ _ (S.ring.addZ S.ring.o) (RL[T.ring].zl T.ring.o) ;
 } ;
} ;
