-- Verify an actual two-element coefficient table, its field operations,
-- and map to F2. Also verify the one-element zero table: its equal one
-- and zero indices give the explicit collapse branch. Run the full weak
-- bounded dichotomy on both bases, with no injective-map premise.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module R = SeparatorRegression[l] ; module B = BooleanRing[l] ;
module MR = MereMinimalRegression[l] ; module Z = R.ZeroAlgebra ;
module Closure = MereFiniteClosure[l].Over[R.k,B.bool-set,MR.weak,R.two,R.candidates] ;
module Here = Closure.At[R.two,R.candidates] ;
value-index : (a : R.k.R) -> Id R.k.R (R.candidates (R.index a)) a = split {
 false -> refl false ; true -> refl true } ;
member (a : R.k.R) : Here.In a = (R.index a,value-index a) ;
inverse-case (i : Fin R.two) : FieldFlat[l].Over[R.k].Decision (R.candidates i) -> Here.Inverse i = split {
 inl h -> inl h ;
 inr u -> inr (R.index u.1,trans (ap (R.k.mul (R.candidates i)) (value-index u.1)) u.2) } ;
closed : Here.Closed = new Here.Closed[member false,member true,\ i -> member (R.candidates i),
 \ i -> member (R.k.neg (R.candidates i)),\ i j -> member (R.k.add (R.candidates i) (R.candidates j)),
 \ i j -> member (R.k.mul (R.candidates i) (R.candidates j)),\ i -> inverse-case i (R.dec (R.candidates i))] ;
module Ops = DiscreteFieldOperations[l].Over[R.k,B.bool-set,R.dec,R.nontrivial] ;
inverse (a : R.k.R) (h : Not (Id R.k.R a R.k.z)) : RL[R.k].unit a = (Ops.inverse a,Ops.inverse-law a h) ;
separated : PolynomialRootBound[l].Over[R.k].Separated R.two R.candidates =
 PolynomialRootBound[l].Over[R.k].Field[inverse].separated R.two R.candidates R.distinct ;
module Table = FiniteClosedField[l].Over[R.k,B.bool-set,MR.weak,R.two,R.candidates,R.two,R.candidates,separated,closed] ;
retain : Plus Table.Verified (Id R.k.R R.k.o R.k.z) -> Table.Verified = split {
 inl h -> h ; inr h -> efq (R.nontrivial h) } ;
verified : Table.Verified = retain Table.theorem ;
module Model = Table.Given[verified] ;
coefficient-map (i : Fin R.two) : Id R.k.R (Model.inclusion.1 (Model.coefficient i)) (R.candidates i) = Model.coefficient-image i ;
model-nonzero : Not (Id Model.ring.R Model.ring.o Model.ring.z) = Model.field.nonzero ;
module Dichotomy = MereCoefficientDichotomy[l].Over[R.k,B.bool-set,MR.weak,R.two,R.candidates] ;
boolean-dichotomy : Tr.Trunc[Dichotomy.Result R.two].carrier = Dichotomy.theorem R.two ;
module ZeroClosure = MereFiniteClosure[l].Over[Z.ring,Z.set,MereLargeRegression[l].weak-zero,zero,\ i -> efq i] ;
module ZeroHere = ZeroClosure.At[R.one,\ i -> tt] ;
zero-member (a : Z.ring.R) : ZeroHere.In a = (inr tt,MnSums[l].top-eq _ _) ;
zero-closed : ZeroHere.Closed = new ZeroHere.Closed[zero-member tt,zero-member tt,\ i -> efq i,
 \ i -> zero-member tt,\ i j -> zero-member tt,\ i j -> zero-member tt,\ i -> inl (refl tt)] ;
module ZeroTable = FiniteClosedField[l].Over[Z.ring,Z.set,MereLargeRegression[l].weak-zero,zero,\ i -> efq i,
 R.one,\ i -> tt,\ i j h -> (tt,refl tt),zero-closed] ;
collapse : Plus ZeroTable.Verified (Id Z.ring.R Z.ring.o Z.ring.z) -> Id Z.ring.R Z.ring.o Z.ring.z = split {
 inl h -> efq (h.nonzero (refl (inr tt))) ; inr h -> h } ;
zero-verified : Id Z.ring.R Z.ring.o Z.ring.z = collapse ZeroTable.theorem ;
module ZeroDichotomy = MereCoefficientDichotomy[l].Over[Z.ring,Z.set,MereLargeRegression[l].weak-zero,zero,\ i -> efq i] ;
zero-dichotomy : Tr.Trunc[ZeroDichotomy.Result R.two].carrier = ZeroDichotomy.theorem R.two ;
