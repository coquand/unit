-- The tensor contraction needs only a normalized top-power functional.
-- Weak minimality merely supplies one. Its contraction gives a derivative
-- inverse, and units in a commutative set-ring form a proposition, so
-- elimination gives an actual inverse without choosing a functional.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (x : S.ring.R)
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (w : D.ring.R) (separator : Id D.ring.R
  (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference x) w)
  (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)))
 (a : k.R) (cs : List k.R)
 (root : Id S.ring.R (MonicBasisUniversal[l].Values[k,S.ring,S.iota,x].value (cons a cs)) S.ring.z)
 (no-roots : MinimalPolynomial[l].Over[k,setk,S,n,basis,x].NoRoots (suc (Poly[l].PolyR[k].plen cs))) {
 module F = MerePowerFunctional[l].Over[k,setk,weak,S,n,basis,x,Poly[l].PolyR[k].plen cs,no-roots] ;
 module Derivative = MonicDualValues[l].Over[k,S.ring,S.set,S.iota,x] ;
 from (f : F.Power.F.Functional) : RL[S.ring].unit (Derivative.slope (cons a cs)) =
  SeparatorDerivativeUnit[l].Over[k,setk,S,D,cp,n,basis,x,epsilon,w,separator,a,cs,root,no-roots,f].theorem ;
 theorem : RL[S.ring].unit (Derivative.slope (cons a cs)) =
  TC.rec F.Power.F.Functional @l (RL[S.ring].unit (Derivative.slope (cons a cs)))
   (FormallyEtale[l].Units[S.ring,S.set].unit-prop (Derivative.slope (cons a cs))) from F.theorem ;
} ;
