-- Coefficient change commutes with directional derivatives, by induction
-- on expressions. Consequently it commutes with every Jacobian entry and
-- determinant. The same proof also identifies the mapped equation list.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : RingHom[l].Hom R K) {
 module BC = MappedPresentation[l].Over[R,K,setR,setK,rho] ;
 module JR = ExpressionJets[l].Over[R,setR] ; module JK = ExpressionJets[l].Over[K,setK] ;
 module TR = JacobianTools[l].Over[R,setR] ; module TK = JacobianTools[l].Over[K,setK] ;
 module At (V : U l) (B : BC.CK.Algebra) (a v : V -> B.ring.R) {
  module X = JR.At[V,BC.restrict B,a] ; module Y = JK.At[V,B,a] ;
  derivative : (e : BC.PR.Expr V) -> Id B.ring.R (Y.derivative v (BC.expression V e)) (X.derivative v e) = split {
   var i -> refl (v i) ; cst r -> refl B.ring.z ;
   sumE e f | re rf -> cong2 B.ring.R B.ring.add _ _ _ _ re rf ;
   mulE e f | re rf -> cong2 B.ring.R B.ring.add _ _ _ _
    (cong2 B.ring.R B.ring.mul _ _ _ _ (BC.value V B a e) rf)
    (cong2 B.ring.R B.ring.mul _ _ _ _ re (BC.value V B a f)) } ;
 } ;
 family (V : U l) : (n : Nat) (f : Fin n -> BC.PR.Expr V) ->
  Id (BC.PK.Equations V) (BC.equations V (TR.family V n f)) (TK.family V n (\ i -> BC.expression V (f i))) = split {
   zero -> \ f -> refl nil ; suc n | rec -> \ f -> ap (\ es -> cons (BC.expression V (f (inr tt))) es) (rec (\ i -> f (inl i))) } ;
 module Given (n : Nat) (f : Fin n -> BC.PR.Expr (Fin n)) (g : Fin n -> BC.PK.Expr (Fin n))
  (eqimages : (i : Fin n) -> Id (BC.PK.Expr (Fin n)) (BC.expression (Fin n) (f i)) (g i)) {
  equations : Id (BC.PK.Equations (Fin n)) (BC.equations (Fin n) (TR.family (Fin n) n f)) (TK.family (Fin n) n g) =
   trans (family (Fin n) n f) (ap (TK.family (Fin n) n) (F.funext (Fin n) (\ i -> BC.PK.Expr (Fin n)) _ _ eqimages)) ;
  presentation : Id BC.PK.Presentation (BC.presentation JacobianLifting[l].Over[R,setR,n,f].pres) JacobianLifting[l].Over[K,setK,n,g].pres =
   ap (\ es -> (n,es)) equations ;
  module In (B : BC.CK.Algebra) (a : Fin n -> B.ring.R) {
   module X = JR.Finite[n,BC.restrict B,a] ; module Y = JK.Finite[n,B,a] ;
   partial (i j : Fin n) : Id B.ring.R (X.partial (f i) j) (Y.partial (g i) j) =
    trans (sym (At[Fin n,B,a,MnSums[l].Over[B.ring].delta n j].derivative (f i))) (ap (\ e -> Y.partial e j) (eqimages i)) ;
   determinant : Id B.ring.R (ExteriorModel[l].Over[B.ring].det n (\ j i -> X.partial (f i) j))
    (ExteriorModel[l].Over[B.ring].det n (\ j i -> Y.partial (g i) j)) =
    ap (ExteriorModel[l].Over[B.ring].det n) (F.funext (Fin n) (\ j -> Fin n -> B.ring.R) _ _
     (\ j -> F.funext (Fin n) (\ i -> B.ring.R) _ _ (\ i -> partial i j))) ;
  } ;
 } ;
} ;
