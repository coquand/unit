-- Finite presentations over a CFN ring are CFN. Construct the polynomial
-- algebra by adjoining variables and then the principal equation quotients.
-- Their CFN proofs use HilbertCFN and QuotCFN. Compare presentations to
-- transfer the result to the given algebra, using a zero-kernel quotient.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Principal (A : CRing) (q : A.R) {
 module Q = FlatPrincipalQuotient[l].Over[A,q] ;
 module CA = Coherent[l].Over[A,IdealPowers[l].regular A] ;
 gens (i : Fin (suc zero)) : A.R = q ;
 coordinate (a : A.R) (w : Q.Witness a) : CA.InFM (suc zero) gens a =
  (\ i -> w.1,trans (A.addZ (A.mul w.1 q)) (trans (A.mulC w.1 q) (sym w.2))) ;
 kernel (a : A.R) (h : Id Q.Q.Carrier (Q.Q.include a) Q.Q.zeroQ) : CA.Mem (suc zero) gens a =
  TC.map (Q.Witness a) (CA.InFM (suc zero) gens a) (coordinate a) (Q.Q.kernel a h) ;
 module QTransfer = QuotCFN[l].Over[A,Q.Q.ring,Q.Q.include,Q.Q.projection.2.1,
  Q.Q.projection.2.2.1,Q.Q.projection.2.2.2,Q.onto,suc zero,gens,\ i -> Q.root,kernel] ;
 theorem (K0 : U l) (c : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,Q.Q.ring] = QTransfer.cfn K0 c ;
} ;
module Iso (A B : CRing) (h : H.Hom A B) (e : Pr.isEquiv A.R B.R h.1) {
 module CA = Coherent[l].Over[A,IdealPowers[l].regular A] ;
 gens (i : Fin zero) : A.R = efq i ;
 onto (b : B.R) : Tr.Trunc[(a : A.R) * Id B.R (h.1 a) b].carrier = Tr.Trunc[(a : A.R) * Id B.R (h.1 a) b].inc (e.sec b,e.sec-eq b) ;
 kernel (a : A.R) (z : Id B.R (h.1 a) B.z) : CA.Mem zero gens a =
  Tr.Trunc[CA.InFM zero gens a].inc (gens,
   sym (Equivalences[l].injective A.R B.R h.1 e a A.z (trans z (sym (H.zero A B h))))) ;
 module QTransfer = QuotCFN[l].Over[A,B,h.1,h.2.1,h.2.2.1,h.2.2.2,onto,zero,gens,\ i -> efq i,kernel] ;
 theorem (K0 : U l) (c : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,B] = QTransfer.cfn K0 c ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) (K0 : U l) (cfn : CFN[l].CFN[K0,R]) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module QP = FlatQuotientPresentation[l].Over[R,setR] ;
 record Model (p : P.Presentation) {
  algebra : C.Algebra ; presentation : P.Presents p algebra ; finite : CFN[l].CFN[K0,algebra.ring] ;
 } ;
 initial : Model[(zero,nil)] = new Model[(zero,nil),C.base,QP.base-presentation,cfn] ;
 module PolynomialStep (n : Nat) (m : Model[(n,nil)]) {
  module Add = AddVariable[l].Over[R,setR].Extension[(n,nil),m.algebra,m.presentation] ;
  result : Model[(suc n,nil)] = new Model[(suc n,nil),Add.AX.algebra,Add.presentation,
   HilbertCFN[l].Over[K0,m.algebra.ring,m.algebra.set].poly m.finite] ;
 } ;
 free : (n : Nat) -> Model[(n,nil)] = split { zero -> initial ; suc n | m -> PolynomialStep[n,m].result } ;
 module EquationStep (n : Nat) (es : P.Equations (Fin n)) (m : Model[(n,es)]) (e : P.Expr (Fin n)) {
  module Pres = QP.At[n,es,m.algebra,m.presentation,e] ;
  result : Model[(n,cons e es)] = new Model[(n,cons e es),Pres.algebra,Pres.presentation,Principal[m.algebra.ring,Pres.q].theorem K0 m.finite] ;
 } ;
 build (n : Nat) : (es : P.Equations (Fin n)) -> Model[(n,es)] = split {
  nil -> free n ; cons e es | m -> EquationStep[n,es,m,e].result } ;
 module At (p : P.Presentation) (S : C.Algebra) (ps : P.Presents p S) {
  m : Model[p] = build p.1 p.2 ;
  module Comparison = PresentationComparison[l].Over[R,setR,p,m.algebra,S,m.presentation,ps] ;
  theorem : CFN[l].CFN[K0,S.ring] = Iso[m.algebra.ring,S.ring,Comparison.forward.1,Comparison.equivalence.2].theorem K0 m.finite ;
 } ;
} ;
