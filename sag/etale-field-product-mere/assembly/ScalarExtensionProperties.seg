-- Mapping-out scalar extension. Standard points commute with coefficients,
-- so their classifying algebras do too. Localisation commutes with scalar
-- extension by comparing maps out: in both orders these are a map of the
-- original algebra and an inverse for the same element. The comparisons
-- retain the actual inclusion maps and their commuting square.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Eqv = Equivalences[l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : H.Hom R K) {
 module BC = MappedPresentation[l].Over[R,K,setR,setK,rho] ; module CR = BC.CR ; module CK = BC.CK ;
 module IR = AffineInterface[l].Over[R,setR] ; module IK = AffineInterface[l].Over[K,setK] ;
 module SV = StandardScalarValues[l].Over[R,K,setR,setK,rho] ;
 module At (S : CR.Algebra) (T : CK.Algebra) (h : CR.Hom S (BC.restrict T)) {
  forward (B : CK.Algebra) (f : CK.Hom T B) : CR.Hom S (BC.restrict B) =
   CR.compose S (BC.restrict T) (BC.restrict B) (BC.restrict-map T B f) h ;
  IsExtension : U l+ = (B : CK.Algebra) -> Pr.isEquiv (CK.Hom T B) (CR.Hom S (BC.restrict B)) (forward B) ;
  module Given (universal : IsExtension) {
   backward (B : CK.Algebra) (g : CR.Hom S (BC.restrict B)) : CK.Hom T B = (universal B).sec g ;
   fb (B : CK.Algebra) (g : CR.Hom S (BC.restrict B)) : Id (CR.Hom S (BC.restrict B)) (forward B (backward B g)) g = (universal B).sec-eq g ;
   bf (B : CK.Algebra) (f : CK.Hom T B) : Id (CK.Hom T B) (backward B (forward B f)) f = Pr.sec-ret _ _ (forward B) (universal B) f ;
   module Standard (q g : SV.SR.RX.Carrier) (st : SV.SR.Points[q,g].Standard S) {
    module Points = SV.Points[q,g] ;
    point : Points.PK.Point T = Points.forward T (Points.PR.push S st.1 (BC.restrict T) h) ;
    module To (B : CK.Algebra) {
     chain : Pr.Equiv (CK.Hom T B) (Points.PK.Point B) =
      Eqv.compose (CK.Hom T B) (CR.Hom S (BC.restrict B)) (Points.PK.Point B) (forward B,universal B)
       (Eqv.compose (CR.Hom S (BC.restrict B)) (Points.PR.Point (BC.restrict B)) (Points.PK.Point B) (Points.PR.push S st.1 (BC.restrict B),st.2 (BC.restrict B)) (Points.equivalence B)) ;
     result : Pr.isEquiv (CK.Hom T B) (Points.PK.Point B) (Points.PK.push T point B) =
      Eqv.homotopy _ _ chain (Points.PK.push T point B)
       (\ f -> Points.PK.point-ext B _ _ (refl (f.1.1 (h.1.1 st.1.1)))) ;
    } ;
    theorem : Points.PK.Standard T = (point,\ B -> To[B].result) ;
   } ;
   module Localized (S' : CR.Algebra) (f : S.ring.R) (j : CR.Hom S S') (loc : IR.Localizes S S' f j)
    (T' : CK.Algebra) (h' : CR.Hom S' (BC.restrict T'))
    (universal' : (B : CK.Algebra) -> Pr.isEquiv (CK.Hom T' B) (CR.Hom S' (BC.restrict B))
     (\ t -> CR.compose S' (BC.restrict T') (BC.restrict B) (BC.restrict-map T' B t) h')) {
    source-map : CR.Hom S (BC.restrict T') = CR.compose S S' (BC.restrict T') h' j ;
    inclusion : CK.Hom T T' = backward T' source-map ;
    square (a : S.ring.R) : Id T'.ring.R (inclusion.1.1 (h.1.1 a)) (h'.1.1 (j.1.1 a)) =
     ap (\ k -> k.1.1 a) (fb T' source-map) ;
    unit : RL[T'.ring].unit (inclusion.1.1 (h.1.1 f)) =
     subst (RL[T'.ring].unit) (sym (square f)) (FormallyEtale[l].unit-map S'.ring T'.ring h'.1 (j.1.1 f) loc.1) ;
    module To (B : CK.Algebra) {
     source-data : U l = IR.LocalData S (BC.restrict B) f ;
     target-data : U l = IK.LocalData T B (h.1.1 f) ;
     to-source (d : target-data) : source-data = (forward B d.1,d.2) ;
     to-target (d : source-data) : target-data =
      (backward B d.1,subst (RL[B.ring].unit) (sym (ap (\ k -> k.1.1 f) (fb B d.1))) d.2) ;
     ts (d : target-data) : Id target-data (to-target (to-source d)) d =
      Pr.Sigma-eq (CK.Hom T B) (\ k -> RL[B.ring].unit (k.1.1 (h.1.1 f))) _ _ _ _ (bf B d.1)
       (FormallyEtale[l].Units[B.ring,B.set].unit-prop _) ;
     st (d : source-data) : Id source-data (to-source (to-target d)) d =
      Pr.Sigma-eq (CR.Hom S (BC.restrict B)) (\ k -> RL[B.ring].unit (k.1.1 f)) _ _ _ _ (fb B d.1)
       (FormallyEtale[l].Units[B.ring,B.set].unit-prop _) ;
     data-equivalence : Pr.Equiv source-data target-data = (to-target,Pr.qinv _ _ to-target to-source ts st) ;
     restriction (t : CK.Hom T' B) : CR.Hom S' (BC.restrict B) =
      CR.compose S' (BC.restrict T') (BC.restrict B) (BC.restrict-map T' B t) h' ;
     chain : Pr.Equiv (CK.Hom T' B) target-data =
      Eqv.compose (CK.Hom T' B) (CR.Hom S' (BC.restrict B)) target-data (restriction,universal' B)
       (Eqv.compose (CR.Hom S' (BC.restrict B)) source-data target-data (IR.local-map S S' (BC.restrict B) f j loc.1,loc.2 (BC.restrict B)) data-equivalence) ;
     -- The composite equivalence first extends the restricted source map.
     chain-base (t : CK.Hom T' B) : Id (CK.Hom T B) (chain.1 t).1
      (backward B (CR.compose S S' (BC.restrict B) (restriction t) j)) = refl (chain.1 t).1 ;
     chain-forward (t : CK.Hom T' B) : Id (CR.Hom S (BC.restrict B)) (forward B (chain.1 t).1)
      (CR.compose S S' (BC.restrict B) (restriction t) j) =
      trans (ap (forward B) (chain-base t)) (fb B (CR.compose S S' (BC.restrict B) (restriction t) j)) ;
     restriction-square (t : CK.Hom T' B) : Id (CR.Hom S (BC.restrict B))
      (forward B (CK.compose T T' B t inclusion)) (CR.compose S S' (BC.restrict B) (restriction t) j) =
      CR.ext S (BC.restrict B) _ _ (\ a -> ap t.1.1 (square a)) ;
     comparison (t : CK.Hom T' B) : Id target-data (IK.local-map T T' B (h.1.1 f) inclusion unit t) (chain.1 t) =
      Pr.Sigma-eq (CK.Hom T B) (\ k -> RL[B.ring].unit (k.1.1 (h.1.1 f))) _ _ _ _
       (Eqv.injective _ _ (forward B) (universal B) _ _ (trans (restriction-square t) (sym (chain-forward t))))
       (FormallyEtale[l].Units[B.ring,B.set].unit-prop _) ;
     theorem : Pr.isEquiv (CK.Hom T' B) target-data (IK.local-map T T' B (h.1.1 f) inclusion unit) =
      Eqv.homotopy _ _ chain (IK.local-map T T' B (h.1.1 f) inclusion unit) comparison ;
    } ;
    theorem : IK.Localizes T T' (h.1.1 f) inclusion = (unit,\ B -> To[B].theorem) ;
   } ;
  } ;
 } ;
} ;
