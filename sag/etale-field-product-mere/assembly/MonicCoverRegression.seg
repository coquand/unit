-- Exercise the unconditional cover endpoint on a nonreduced base,
-- redundant equations, a nilpotent localisation, and the zero base.
-- These are checked proof terms; no normal form of a truncated cover is
-- claimed. The generic identity case has no CFN hypothesis on the base.
level l ; open Ring[l] ;
module Big = Truncation[l+] ; module D = DirectRegression[l] ;
module Identity (R : CRing) (setR : Prelude[l].isSet R.R) {
 module B = D.Empty[R,setR] ;
 module Cover = LocallyMonicStandardEtale[l].Over[R,setR,B.C.base] ;
 theorem : Big.Trunc[Cover.Certified.Cover].carrier = Cover.theorem
  (Big.Trunc[B.P.Witness B.C.base].inc B.theorem.2) B.theorem.1 ;
} ;
module Nonreduced = LocallyMonicStandardEtale[l].Over[D.Z.ring,D.Z.set,D.NonreducedPoint.Q.C.base] ;
nonreduced : Big.Trunc[Nonreduced.Certified.Cover].carrier = Nonreduced.theorem
 (Big.Trunc[D.NonreducedPoint.Q.P.Witness D.NonreducedPoint.Q.C.base].inc D.NonreducedPoint.redundant-theorem.2)
 D.NonreducedPoint.redundant-theorem.1 ;
module Nilpotent = LocallyMonicStandardEtale[l].Over[D.Z.ring,D.Z.set,D.NilpotentLocalisation.L.algebra] ;
nilpotent-localisation : Big.Trunc[Nilpotent.Certified.Cover].carrier = Nilpotent.theorem
 (Big.Trunc[D.NilpotentLocalisation.P.Witness D.NilpotentLocalisation.L.algebra].inc D.NilpotentLocalisation.theorem.2)
 D.NilpotentLocalisation.theorem.1 ;
module Z = SeparatorRegression[l].ZeroAlgebra ;
module ZeroBase = Identity[Z.ring,Z.set] ;
zero-base : Big.Trunc[ZeroBase.Cover.Certified.Cover].carrier = ZeroBase.theorem ;
