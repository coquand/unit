-- Actual determinant localisations of coefficient-related square systems
-- form a scalar-extension square. The quotient presentations give the
-- first square; ScalarJacobian identifies the determinant; localisation
-- gives the second. The named system generators and determinant inverses
-- are preserved, hence every expression in those generators is preserved.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : RingHom[l].Hom R K)
 (n : Nat) (f : Fin n -> Presentations[l].Over[R,setR].Expr (Fin n))
 (g : Fin n -> Presentations[l].Over[K,setK].Expr (Fin n))
 (eqimages : (i : Fin n) -> Id (Presentations[l].Over[K,setK].Expr (Fin n)) (MappedPresentation[l].Over[R,K,setR,setK,rho].expression (Fin n) (f i)) (g i)) {
 module Scalar = ScalarJacobian[l].Over[R,K,setR,setK,rho] ; module BC = Scalar.BC ;
 module SJ = Scalar.Given[n,f,g,eqimages] ;
 module JR = JacobianLifting[l].Over[R,setR,n,f] ; module JK = JacobianLifting[l].Over[K,setK,n,g] ;
 module SP = ScalarExtensionProperties[l].Over[R,K,setR,setK,rho] ;
 module At (A : BC.CR.Algebra) (pa : BC.PR.Presents JR.pres A) (B : BC.CK.Algebra) (pb : BC.PK.Presents JK.pres B) {
  module Transport = EquationPresentationTransport[l].Over[K,setK,n,(BC.presentation JR.pres).2,JK.pres.2,SJ.equations,B,pb] ;
  module Quot = BC.At[A,JR.pres,pa,B,Transport.theorem] ;
  module X = JR.At[A,pa] ; module Y = JK.At[B,pb] ;
  determinant : Id B.ring.R (Quot.inclusion.1.1 X.delta) Y.delta =
   trans (JacobianTools[l].Over[R,setR].Natural[n,A,BC.restrict B,Quot.inclusion,pa.1.1,pb.1.1,Quot.inclusion-generators].determinant f)
    SJ.In[B,pb.1.1].determinant ;
  module Charts (e : BC.PR.Expr (Fin n)) (er : Id A.ring.R (BC.PR.eval (Fin n) A pa.1.1 e) X.delta)
   (d : BC.PK.Expr (Fin n)) (dr : Id B.ring.R (BC.PK.eval (Fin n) B pb.1.1 d) Y.delta) {
   module Source = X.Chart[e,er] ; module Target = Y.Chart[d,dr] ;
   module SR = SP.IR.Presented[A,JR.pres,pa,X.delta,e,er] ;
   module TK = SP.IK.Presented[B,JK.pres,pb,Y.delta,d,dr] ;
   module Localised = LocalizationScalarExtension[l].Over[R,K,setR,setK,rho].At[A,B,Quot.inclusion,
    \ C -> Quot.To[C].universal,Source.S,X.delta,Source.Loc.inclusion,SR.result.2.2.2,
    Target.S,Y.delta,Target.Loc.inclusion,TK.result.2.2.2,determinant] ;
   old-generator (i : Fin n) : Id Target.S.ring.R
    (Localised.inclusion.1.1 (Source.Loc.K.A.generators (inl i))) (Target.Loc.K.A.generators (inl i)) =
    trans (ap Localised.inclusion.1.1 (sym (Source.Loc.Canonical[Source.S].inclusion-gen i)))
     (trans (Localised.square (pa.1.1 i))
      (trans (ap Target.Loc.inclusion.1.1 (Quot.inclusion-generators i)) (Target.Loc.Canonical[Target.S].inclusion-gen i))) ;
   determinant-image : Id Target.S.ring.R (Localised.inclusion.1.1 (Source.Loc.inclusion.1.1 X.delta)) (Target.Loc.inclusion.1.1 Y.delta) =
    trans (Localised.square X.delta) (ap Target.Loc.inclusion.1.1 determinant) ;
   inverse-equation : Id Target.S.ring.R
    (Target.S.ring.mul (Target.Loc.inclusion.1.1 Y.delta) (Localised.inclusion.1.1 Source.Loc.inverse.1)) Target.S.ring.o =
    trans (ap (\ a -> Target.S.ring.mul a (Localised.inclusion.1.1 Source.Loc.inverse.1)) (sym determinant-image))
     (trans (sym (Localised.inclusion.1.2.2.2 (Source.Loc.inclusion.1.1 X.delta) Source.Loc.inverse.1))
      (trans (ap Localised.inclusion.1.1 Source.Loc.inverse.2) Localised.inclusion.1.2.1)) ;
   inverse-image : Id Target.S.ring.R (Localised.inclusion.1.1 Source.Loc.inverse.1) Target.Loc.inverse.1 =
    AffineRing[l].Laws[Target.S.ring,Target.S.set].inverse-unique _ _ _ inverse-equation Target.Loc.inverse.2 ;
   last-generator : Id Target.S.ring.R (Localised.inclusion.1.1 (Source.Loc.K.A.generators (inr tt))) (Target.Loc.K.A.generators (inr tt)) = inverse-image ;
   generators : (i : Fin (suc n)) -> Id Target.S.ring.R
    (Localised.inclusion.1.1 (Source.Loc.K.A.generators i)) (Target.Loc.K.A.generators i) =
    AffineFinite[l].section n (\ i -> Id Target.S.ring.R (Localised.inclusion.1.1 (Source.Loc.K.A.generators i)) (Target.Loc.K.A.generators i)) old-generator last-generator ;
   expression (a : BC.PR.Expr (Fin (suc n))) : Id Target.S.ring.R
    (Localised.inclusion.1.1 (BC.PR.eval (Fin (suc n)) Source.S Source.Loc.K.A.generators a))
    (BC.PK.eval (Fin (suc n)) Target.S Target.Loc.K.A.generators (BC.expression (Fin (suc n)) a)) =
    trans (BC.PR.natural (Fin (suc n)) Source.S (BC.restrict Target.S) Localised.inclusion Source.Loc.K.A.generators a)
     (trans (Generated[l].Over[R,setR].eval-ext (Fin (suc n)) (BC.restrict Target.S) _ Target.Loc.K.A.generators generators a)
      (sym (BC.value (Fin (suc n)) Target.S Target.Loc.K.A.generators a))) ;
  } ;
 } ;
} ;
