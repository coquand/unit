-- Specialise an actual finite cover of monic standard charts. Construct
-- each chart algebra by mapping its finite presentation, use scalar
-- extension of localisation and standard points, and map the unit sum.
-- All choices of presentations stay inside the final truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Big = Truncation[l+] ; module BTC = TruncationCombinators[l+] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : RingHom[l].Hom R K) {
 module SP = ScalarExtensionProperties[l].Over[R,K,setR,setK,rho] ; module BC = SP.BC ;
 module At (S : BC.CR.Algebra) (T : BC.CK.Algebra) (h : BC.CR.Hom S (BC.restrict T))
  (universal : SP.At[S,T,h].IsExtension) {
  module Given = SP.At[S,T,h].Given[universal] ;
  module MS = LocalDescent[l].Monic[R,setR,S.ring,S.set,S.iota] ;
  module MT = LocalDescent[l].Monic[K,setK,T.ring,T.set,T.iota] ;
  module CS = PrimalityCertifiedCover[l].Over[S.ring,MS.MonicChart] ;
  module CT = PrimalityCertifiedCover[l].Over[T.ring,MT.MonicChart] ;
  module Chart (f : S.ring.R) (c : MS.MonicChart f) {
   module Presented (p : BC.PR.Presentation) (ps : BC.PR.Presents p c.1.1) {
    module Mapped = BC.Constructed[c.1.1,p,ps] ;
    module Localised = Given.Localized[c.1.1,f,c.1.2.2.1,c.1.2.2.2,Mapped.algebra,Mapped.BC.inclusion,\ B -> Mapped.BC.To[B].universal] ;
    module Standard = SP.At[c.1.1,Mapped.algebra,Mapped.BC.inclusion].Given[\ B -> Mapped.BC.To[B].universal].Standard[
     HorrocksInterface[l].Over[R,setR].monic c.2.1,c.2.2.1,c.2.2.2] ;
    standard : SP.SV.SK.Points[HorrocksInterface[l].Over[K,setK].monic (SP.SV.lower c.2.1),SP.SV.PM.f.1 c.2.2.1].Standard Mapped.algebra =
     Prelude[l+].subst SP.SV.SK.RX.Carrier (\ q -> SP.SV.SK.Points[q,SP.SV.PM.f.1 c.2.2.1].Standard Mapped.algebra) _ _ (SP.SV.monic c.2.1) Standard.theorem ;
    result : MT.MonicChart (h.1.1 f) =
     ((Mapped.algebra,Mapped.finite-presentation,Localised.inclusion,Localised.theorem),SP.SV.lower c.2.1,SP.SV.PM.f.1 c.2.2.1,standard) ;
   } ;
   theorem : Big.Trunc[MT.MonicChart (h.1.1 f)].carrier =
    BTC.map (BC.PR.Witness c.1.1) (MT.MonicChart (h.1.1 f)) (\ w -> Presented[w.1,w.2].result) c.1.2.1 ;
  } ;
  module Cover (c : CS.Cover) {
   certificates : Big.Trunc[(i : Fin c.1) -> MT.MonicChart (h.1.1 (c.2.1 i))].carrier =
    FiniteLargeChoice[l].choice c.1 (\ i -> MT.MonicChart (h.1.1 (c.2.1 i))) (\ i -> Chart[c.2.1 i,c.2.2.2.1 i].theorem) ;
   equation : Id T.ring.R (FiniteIdeal[l].Sums[T.ring].lin c.1 (\ i -> h.1.1 (c.2.1 i)) (\ i -> h.1.1 (c.2.2.1 i))) T.ring.o =
    trans (sym (StandardOpens[l].SumMap[S.ring,T.ring,h.1].combination c.1 c.2.1 c.2.2.1)) (trans (ap h.1.1 c.2.2.2.2) h.1.2.1) ;
   theorem : Big.Trunc[CT.Cover].carrier = BTC.map ((i : Fin c.1) -> MT.MonicChart (h.1.1 (c.2.1 i))) CT.Cover
    (\ cs -> (c.1,\ i -> h.1.1 (c.2.1 i),\ i -> h.1.1 (c.2.2.1 i),cs,equation)) certificates ;
  } ;
  theorem (c : Big.Trunc[CS.Cover].carrier) : Big.Trunc[CT.Cover].carrier = BTC.bind CS.Cover CT.Cover (\ x -> Cover[x].theorem) c ;
 } ;
} ;
