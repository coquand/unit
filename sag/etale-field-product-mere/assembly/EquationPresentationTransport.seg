-- Replace the equation list by a proved equal list, retaining the named
-- generators. Solutions change only their proof of vanishing.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Eqv = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (es fs : Presentations[l].Over[R,setR].Equations (Fin n)) (same : Id (List (Presentations[l].Over[R,setR].Expr (Fin n))) es fs)
 (A : Algebras[l].Over[R,setR].Algebra) (pa : Presentations[l].Over[R,setR].Presents (n,fs) A) {
 module P = Presentations[l].Over[R,setR] ; module C = Algebras[l].Over[R,setR] ;
 solution : P.Solutions (n,es) A = (pa.1.1,subst (P.Zeros (Fin n) A pa.1.1) (sym same) pa.1.2) ;
 module To (B : C.Algebra) {
  forward (s : P.Solutions (n,fs) B) : P.Solutions (n,es) B = (s.1,subst (P.Zeros (Fin n) B s.1) (sym same) s.2) ;
  backward (s : P.Solutions (n,es) B) : P.Solutions (n,fs) B = (s.1,subst (P.Zeros (Fin n) B s.1) same s.2) ;
  eq : Pr.Equiv (P.Solutions (n,fs) B) (P.Solutions (n,es) B) = (forward,Pr.qinv _ _ forward backward
   (\ s -> P.solutions-ext (n,es) B _ s (\ i -> refl (s.1 i)))
   (\ s -> P.solutions-ext (n,fs) B _ s (\ i -> refl (s.1 i)))) ;
  chain : Pr.Equiv (C.Hom A B) (P.Solutions (n,es) B) =
   Eqv.compose (C.Hom A B) (P.Solutions (n,fs) B) (P.Solutions (n,es) B) (P.canonical (n,fs) A pa.1 B,pa.2 B) eq ;
  theorem : Pr.isEquiv (C.Hom A B) (P.Solutions (n,es) B) (P.canonical (n,es) A solution B) =
   Eqv.homotopy _ _ chain (P.canonical (n,es) A solution B) (\ h -> P.solutions-ext (n,es) B _ _ (\ i -> refl (h.1.1 (pa.1.1 i)))) ;
 } ;
 theorem : P.Presents (n,es) A = (solution,\ B -> To[B].theorem) ;
} ;
