-- Change coefficients in standard-etale points. Polynomial evaluation
-- commutes with the coefficient map by its universal property, including
-- evaluation in dual numbers. Thus both the root and derivative-unit
-- conditions agree. Monic lower coefficient lists remain monic.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : H.Hom R K) {
 module BC = MappedPresentation[l].Over[R,K,setR,setK,rho] ;
 module SR = StandardEtale[l].Over[R,setR] ; module SK = StandardEtale[l].Over[K,setK] ;
 module PM = FlatPolynomialData[l].Map[R,K,setR,setK,rho] ;
 module At (B : BC.CK.Algebra) (a : B.ring.R) {
  module VR = SR.At[B.ring,B.set,(BC.restrict B).iota,a] ;
  module VK = SK.At[B.ring,B.set,B.iota,a] ;
  value (p : SR.RX.Carrier) : Id B.ring.R (VK.value (PM.f.1 p)) (VR.value p) =
   ap (\ h -> h.1 p) (VR.UP.unique (H.compose SR.RX.ring SK.RX.ring B.ring VK.ev PM.f)
    (\ r -> trans (ap VK.value (PM.UP.on-constants r)) (VK.UP.on-constants (rho.1 r)))
    (trans (ap VK.value PM.UP.on-variable) VK.UP.on-variable)) ;
  dual-constant (r : R.R) : Id VR.DN.Pair (VK.dual.1 (rho.1 r)) (VR.dual.1 r) = refl (VR.dual.1 r) ;
  derivative (p : SR.RX.Carrier) : Id B.ring.R (VK.derivative (PM.f.1 p)) (VR.derivative p) =
   ap (\ h -> (h.1 p).2) (VR.UPe.unique (H.compose SR.RX.ring SK.RX.ring VR.DN.ring VK.evd PM.f)
    (\ r -> trans (ap VK.evd.1 (PM.UP.on-constants r)) (trans (VK.UPe.on-constants (rho.1 r)) (dual-constant r)))
    (trans (ap VK.evd.1 PM.UP.on-variable) VK.UPe.on-variable)) ;
  denominator (q g : SR.RX.Carrier) :
   Id B.ring.R (VK.value (SK.RX.ring.mul (PM.f.1 g) (SK.deriv (PM.f.1 q)))) (VR.value (SR.RX.ring.mul g (SR.deriv q))) =
   trans (VK.ev.2.2.2 (PM.f.1 g) (SK.deriv (PM.f.1 q)))
    (trans (cong2 B.ring.R B.ring.mul _ _ _ _ (value g)
     (trans (SK.deriv-value B.ring B.set B.iota a (PM.f.1 q))
      (trans (derivative q) (sym (SR.deriv-value B.ring B.set (BC.restrict B).iota a q)))))
     (sym (VR.ev.2.2.2 g (SR.deriv q)))) ;
 } ;
 module Points (q g : SR.RX.Carrier) {
  module PR = SR.Points[q,g] ; module PK = SK.Points[PM.f.1 q,PM.f.1 g] ;
  forward (B : BC.CK.Algebra) (p : PR.Point (BC.restrict B)) : PK.Point B =
   (p.1,trans (At[B,p.1].value q) p.2.1,subst (RL[B.ring].unit) (sym (At[B,p.1].denominator q g)) p.2.2) ;
  backward (B : BC.CK.Algebra) (p : PK.Point B) : PR.Point (BC.restrict B) =
   (p.1,trans (sym (At[B,p.1].value q)) p.2.1,subst (RL[B.ring].unit) (At[B,p.1].denominator q g) p.2.2) ;
  equivalence (B : BC.CK.Algebra) : Pr.Equiv (PR.Point (BC.restrict B)) (PK.Point B) =
   (forward B,Pr.qinv _ _ (forward B) (backward B)
    (\ p -> PK.point-ext B _ p (refl p.1)) (\ p -> PR.point-ext (BC.restrict B) _ p (refl p.1))) ;
 } ;
 lower : List R.R -> List K.R = PM.raw ;
 monic-list : (p : List R.R) -> Id (List K.R)
  (PM.raw (HorrocksInterface[l].Over[R,setR].monic-list p))
  (HorrocksInterface[l].Over[K,setK].monic-list (lower p)) = split {
   nil -> ap (\ a -> cons a nil) rho.2.1 ;
   cons a p | ih -> ap (\ xs -> cons (rho.1 a) xs) ih } ;
 monic (p : List R.R) : Id SK.RX.Carrier (PM.f.1 (HorrocksInterface[l].Over[R,setR].monic p))
  (HorrocksInterface[l].Over[K,setK].monic (lower p)) =
  trans (PM.on-list (HorrocksInterface[l].Over[R,setR].monic-list p)) (ap SK.RX.include (monic-list p)) ;
} ;
