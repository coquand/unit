-- Two actual localisations of scalar-extended algebras form another
-- scalar-extension square. Restricting maps from either localisation
-- gives the same base map with a unit at the distinguished element.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Eqv = Equivalences[l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : RingHom[l].Hom R K) {
 module SP = ScalarExtensionProperties[l].Over[R,K,setR,setK,rho] ; module BC = SP.BC ; module CR = BC.CR ; module CK = BC.CK ;
 module At (S : CR.Algebra) (T : CK.Algebra) (h : CR.Hom S (BC.restrict T)) (universal : SP.At[S,T,h].IsExtension)
  (S' : CR.Algebra) (f : S.ring.R) (j : CR.Hom S S') (ls : SP.IR.Localizes S S' f j)
  (T' : CK.Algebra) (g : T.ring.R) (k : CK.Hom T T') (lt : SP.IK.Localizes T T' g k)
  (image : Id T.ring.R (h.1.1 f) g) {
  module Given = SP.At[S,T,h].Given[universal] ;
  map : CR.Hom S (BC.restrict T') = CR.compose S (BC.restrict T) (BC.restrict T') (BC.restrict-map T T' k) h ;
  map-unit : RL[T'.ring].unit (map.1.1 f) = subst (RL[T'.ring].unit) (sym (ap k.1.1 image)) lt.1 ;
  inclusion : CR.Hom S' (BC.restrict T') = (ls.2 (BC.restrict T')).sec (map,map-unit) ;
  square (a : S.ring.R) : Id T'.ring.R (inclusion.1.1 (j.1.1 a)) (k.1.1 (h.1.1 a)) =
   ap (\ d -> d.1.1.1 a) ((ls.2 (BC.restrict T')).sec-eq (map,map-unit)) ;
  module To (B : CK.Algebra) {
   source-data : U l = SP.IR.LocalData S (BC.restrict B) f ;
   target-data : U l = SP.IK.LocalData T B g ;
   to-source (d : target-data) : source-data =
    (SP.At[S,T,h].forward B d.1,subst (RL[B.ring].unit) (sym (ap d.1.1.1 image)) d.2) ;
   to-target (d : source-data) : target-data =
    (Given.backward B d.1,subst (RL[B.ring].unit)
     (trans (sym (ap (\ a -> a.1.1 f) (Given.fb B d.1))) (ap (Given.backward B d.1).1.1 image)) d.2) ;
   st (d : source-data) : Id source-data (to-source (to-target d)) d =
    Pr.Sigma-eq (CR.Hom S (BC.restrict B)) (\ a -> RL[B.ring].unit (a.1.1 f)) _ _ _ _ (Given.fb B d.1)
     (FormallyEtale[l].Units[B.ring,B.set].unit-prop _) ;
   ts (d : target-data) : Id target-data (to-target (to-source d)) d =
    Pr.Sigma-eq (CK.Hom T B) (\ a -> RL[B.ring].unit (a.1.1 g)) _ _ _ _ (Given.bf B d.1)
     (FormallyEtale[l].Units[B.ring,B.set].unit-prop _) ;
   data-equivalence : Pr.Equiv target-data source-data = (to-source,Pr.qinv _ _ to-source to-target st ts) ;
   restricted : CK.Hom T' B -> source-data = \ t -> to-source (SP.IK.local-map T T' B g k lt.1 t) ;
   intermediate : Pr.Equiv (CK.Hom T' B) source-data =
    Eqv.compose (CK.Hom T' B) target-data source-data (SP.IK.local-map T T' B g k lt.1,lt.2 B) data-equivalence ;
   source-extension (d : source-data) : CR.Hom S' (BC.restrict B) = (ls.2 (BC.restrict B)).sec d ;
   source-forward : CR.Hom S' (BC.restrict B) -> source-data = SP.IR.local-map S S' (BC.restrict B) f j ls.1 ;
   source-equivalence : Pr.Equiv source-data (CR.Hom S' (BC.restrict B)) =
    (source-extension,Pr.qinv _ _ source-extension source-forward
     (\ t -> Pr.sec-ret _ _ source-forward (ls.2 (BC.restrict B)) t) (ls.2 (BC.restrict B)).sec-eq) ;
   chain : Pr.Equiv (CK.Hom T' B) (CR.Hom S' (BC.restrict B)) =
    Eqv.compose (CK.Hom T' B) source-data (CR.Hom S' (BC.restrict B)) intermediate source-equivalence ;
   -- Write the common source extension of the two mapping-out chains.
   chain-value (t : CK.Hom T' B) : Id (CR.Hom S' (BC.restrict B)) (chain.1 t) (source-extension (restricted t)) = refl (chain.1 t) ;
   chain-restrict (t : CK.Hom T' B) : Id source-data (source-forward (chain.1 t)) (restricted t) =
    trans (ap source-forward (chain-value t)) ((ls.2 (BC.restrict B)).sec-eq (restricted t)) ;
   restriction-square (t : CK.Hom T' B) : Id source-data (source-forward (SP.At[S',T',inclusion].forward B t)) (restricted t) =
    Pr.Sigma-eq (CR.Hom S (BC.restrict B)) (\ a -> RL[B.ring].unit (a.1.1 f)) _ _ _ _
     (CR.ext S (BC.restrict B) _ _ (\ a -> ap t.1.1 (square a)))
     (FormallyEtale[l].Units[B.ring,B.set].unit-prop _) ;
   comparison (t : CK.Hom T' B) : Id (CR.Hom S' (BC.restrict B)) (SP.At[S',T',inclusion].forward B t) (chain.1 t) =
    Eqv.injective _ _ source-forward (ls.2 (BC.restrict B)) _ _
     (trans (restriction-square t) (sym (chain-restrict t))) ;
   theorem : Pr.isEquiv (CK.Hom T' B) (CR.Hom S' (BC.restrict B)) (SP.At[S',T',inclusion].forward B) =
    Eqv.homotopy _ _ chain (SP.At[S',T',inclusion].forward B) comparison ;
  } ;
  theorem : SP.At[S',T',inclusion].IsExtension = \ B -> To[B].theorem ;
 } ;
} ;
