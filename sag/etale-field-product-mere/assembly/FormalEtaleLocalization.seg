-- A localisation of a formally etale algebra is formally etale.
-- Restrict a lifting problem to the original algebra. Lift uniquely
-- there; a unit modulo a square-zero ideal lifts to a unit, so the map
-- extends to the localisation. Both uniqueness and compatibility follow
-- from the localisation mapping-out property.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Eqv = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module FE = FormallyEtale[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module At (S T : C.Algebra) (f : S.ring.R) (j : C.Hom S T) (loc : I.Localizes S T f j) {
  module To (B : C.Algebra) {
   ext (h k : C.Hom T B) (same : Id (C.Hom S B) (C.compose S T B h j) (C.compose S T B k j)) : Id (C.Hom T B) h k =
    Eqv.injective _ _ (I.local-map S T B f j loc.1) (loc.2 B) h k
     (Pr.Sigma-eq (C.Hom S B) (\ g -> RL[B.ring].unit (g.1.1 f)) _ _ _ _ same (FormallyEtale[l].Units[B.ring,B.set].unit-prop _)) ;
  } ;
  module Unique (unique : FE.Unique S) (B : C.Algebra) (N : FE.SquareZero[B]) (h k : C.Hom T B)
   (same : Id (C.Hom T FE.Mod[B,N].algebra) (FE.reduce T B N h) (FE.reduce T B N k)) {
   module M = FE.Mod[B,N] ;
   old-same : Id (C.Hom S M.algebra) (FE.reduce S B N (C.compose S T B h j)) (FE.reduce S B N (C.compose S T B k j)) =
    C.ext S M.algebra _ _ (\ a -> ap (\ t -> t.1.1 (j.1.1 a)) same) ;
   theorem : Id (C.Hom T B) h k = To[B].ext h k (unique B N _ _ old-same) ;
  } ;
  unique (u : FE.Unique S) : FE.Unique T = \ B N h k same -> Unique[u,B,N,h,k,same].theorem ;
  module Lift (smooth : FE.Lift S) (B : C.Algebra) (N : FE.SquareZero[B]) (g : C.Hom T FE.Mod[B,N].algebra) {
   module M = FE.Mod[B,N] ; module Qr = StandardEtaleLift[l].Over[R,setR].Quot[B,N] ;
   old : C.Hom S M.algebra = C.compose S T M.algebra g j ;
   lifted : (h : C.Hom S B) * Id (C.Hom S M.algebra) (FE.reduce S B N h) old = smooth B N old ;
   image (a : S.ring.R) : Id M.Q.Carrier (M.Q.include (lifted.1.1.1 a)) (old.1.1 a) = ap (\ t -> t.1.1 a) lifted.2 ;
   residue-unit : RL[M.Q.ring].unit (M.Q.include (lifted.1.1.1 f)) =
    subst (RL[M.Q.ring].unit) (sym (image f)) (FormallyEtale[l].unit-map T.ring M.Q.ring g.1 (j.1.1 f) loc.1) ;
   unit : RL[B.ring].unit (lifted.1.1.1 f) = Qr.Unit[lifted.1.1.1 f,residue-unit].theorem ;
   hom : C.Hom T B = (loc.2 B).sec (lifted.1,unit) ;
   restricted : Id (C.Hom S B) (C.compose S T B hom j) lifted.1 = ap (\ d -> d.1) ((loc.2 B).sec-eq (lifted.1,unit)) ;
   reduced : Id (C.Hom T M.algebra) (FE.reduce T B N hom) g =
    To[M.algebra].ext _ _ (C.ext S M.algebra _ _ (\ a ->
     trans (ap M.Q.include (ap (\ t -> t.1.1 a) restricted)) (image a))) ;
   theorem : (h : C.Hom T B) * Id (C.Hom T M.algebra) (FE.reduce T B N h) g = (hom,reduced) ;
  } ;
  smooth (s : FE.Lift S) : FE.Lift T = \ B N g -> Lift[s,B,N,g].theorem ;
  theorem (e : FE.FormallyEtale S) : FE.FormallyEtale T = (smooth e.1,unique e.2) ;
 } ;
} ;
