-- Record all coefficient occurrences of a finite square system and one
-- extra expression in the system variables and the determinant inverse.
-- Replace occurrences by independent variables over Z. Evaluation returns
-- the original expressions; no equality test or injectivity is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module FF = FiniteFamilies[l] ; module CB = CoefficientBase[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (f : Fin n -> Presentations[l].Over[R,setR].Expr (Fin n))
 (g : Presentations[l].Over[R,setR].Expr (Fin (suc n))) {
 module Leaves = FiniteCoefficientData[l].Leaves[R,setR] ;
 sizes (i : Fin n) : Nat = Leaves.nc (Fin n) (f i) ;
 nf : Nat = FF.catN n sizes ; ng : Nat = Leaves.nc (Fin (suc n)) g ;
 number : Nat = plus nf ng ;
 coefficients : Fin number -> R.R = FF.app R.R nf ng (FF.cat R.R n sizes (\ i -> Leaves.leaf (Fin n) (f i))) (Leaves.leaf (Fin (suc n)) g) ;
 base : CRing = CB.ring number ; set : Pr.isSet base.R = CB.set number ;
 rho : RingHom[l].Hom base R = CB.Eval[R,setR].ev number coefficients ;
 cfn : CFN[l].CFN[CB.Codes,base] = CB.cfn number ;
 module Lift = Leaves.Lift[base,set,rho] ; module BC = MappedPresentation[l].Over[base,R,set,setR,rho] ;
 fi (i : Fin n) (k : Fin (sizes i)) : Fin number = FF.injL nf ng (FF.injC n sizes i k) ;
 gi (k : Fin ng) : Fin number = FF.injR nf ng k ;
 f-coefficient (i : Fin n) (k : Fin (sizes i)) : Id R.R (rho.1 (CB.var number (fi i k))) (Leaves.leaf (Fin n) (f i) k) =
  trans (CB.Eval[R,setR].ev-var number coefficients (fi i k))
   (trans (FF.app-injL R.R nf ng (FF.cat R.R n sizes (\ i -> Leaves.leaf (Fin n) (f i))) (Leaves.leaf (Fin (suc n)) g) (FF.injC n sizes i k))
    (FF.cat-injC R.R n sizes (\ i -> Leaves.leaf (Fin n) (f i)) i k)) ;
 g-coefficient (k : Fin ng) : Id R.R (rho.1 (CB.var number (gi k))) (Leaves.leaf (Fin (suc n)) g k) =
  trans (CB.Eval[R,setR].ev-var number coefficients (gi k))
   (FF.app-injR R.R nf ng (FF.cat R.R n sizes (\ i -> Leaves.leaf (Fin n) (f i))) (Leaves.leaf (Fin (suc n)) g) k) ;
 equation (i : Fin n) : BC.PR.Expr (Fin n) = Lift.lift (Fin n) (f i) (\ k -> CB.var number (fi i k)) ;
 extra : BC.PR.Expr (Fin (suc n)) = Lift.lift (Fin (suc n)) g (\ k -> CB.var number (gi k)) ;
 -- The earlier coefficient syntax and MappedPresentation use the same map.
 expression-map (V : U l) : (e : BC.PR.Expr V) -> Id (BC.PK.Expr V) (BC.expression V e) (Lift.M.mapE V e) = split {
  var i -> refl (var i) ; cst a -> refl (cst (rho.1 a)) ;
  sumE a b | ra rb -> cong2 (BC.PK.Expr V) (\ x y -> sumE x y) _ _ _ _ ra rb ;
  mulE a b | ra rb -> cong2 (BC.PK.Expr V) (\ x y -> mulE x y) _ _ _ _ ra rb } ;
 equation-image (i : Fin n) : Id (BC.PK.Expr (Fin n)) (BC.expression (Fin n) (equation i)) (f i) =
  trans (expression-map (Fin n) (equation i)) (Lift.lift-image (Fin n) (f i) (\ k -> CB.var number (fi i k)) (f-coefficient i)) ;
 extra-image : Id (BC.PK.Expr (Fin (suc n))) (BC.expression (Fin (suc n)) extra) g =
  trans (expression-map (Fin (suc n)) extra) (Lift.lift-image (Fin (suc n)) g (\ k -> CB.var number (gi k)) g-coefficient) ;
} ;
