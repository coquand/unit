-- Every finitely presented formally etale algebra has a finite cover by
-- monic standard-etale localisations, with an explicit unit equation.
--
-- JacobianOpenReduction writes E as a principal open of an actual square
-- Jacobian algebra. Represent its open element in the system generators
-- and determinant inverse. Descend just the system and this expression
-- to a polynomial coefficient ring over Z. The generic Jacobian algebra
-- and its extra open are formally etale by Jacobian lifting and stability
-- under localisation; their CFN property follows from their presentations.
-- Apply the constructive CFN cover there and specialise its actual charts
-- and unit equation. The extra open need not be idempotent in the generic
-- model. No descent of formal smoothness, injectivity, or equality decision
-- for the arbitrary base is assumed.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Big = Truncation[l+] ; module BTC = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (E : Algebras[l].Over[R,setR].Algebra) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module Reduction = JacobianOpenReduction[l].Over[R,setR].At[E] ;
 module Monic = LocalDescent[l].Monic[R,setR,E.ring,E.set,E.iota] ;
 module Certified = PrimalityCertifiedCover[l].Over[E.ring,Monic.MonicChart] ;
 module From (w : Reduction.Result) {
  module System = JacobianOpenReduction[l].Over[R,setR].SourceAt[w.system] ;
  module S = System.S ;
  Representation : U l = Generated[l].Over[R,setR].Representation S.Loc.pres S.S S.Loc.K.presentation w.denominator ;
  module Represented (r : Representation) {
   module Data = CoefficientSquareData[l].Over[R,setR,w.system.number,w.system.equation,r.1] ;
   module J0 = JacobianLifting[l].Over[Data.base,Data.set,w.system.number,Data.equation] ;
   module Q0 = PresentationExistence[l].Over[Data.base,Data.set,J0.pres] ;
   module Source0 = J0.At[Q0.A.algebra,Q0.presentation] ;
   module G0 = Generated[l].Over[Data.base,Data.set] ;
   DeterminantRep : U l = G0.Representation J0.pres Q0.A.algebra Q0.presentation Source0.delta ;
   module DeterminantChosen (d : DeterminantRep) {
    module Square = JacobianScalarExtension[l].Over[Data.base,R,Data.set,setR,Data.rho,w.system.number,Data.equation,w.system.equation,Data.equation-image].At[
     Q0.A.algebra,Q0.presentation,w.system.quotient,w.system.presentation].Charts[d.1,d.2,w.system.determinant-expression,w.system.determinant-rep] ;
    module S0 = Square.Source ;
    extra : S0.S.ring.R = Data.BC.PR.eval (Presentations[l].Fin (suc w.system.number)) S0.S S0.Loc.K.A.generators Data.extra ;
    extra-image : Id S.S.ring.R (Square.Localised.inclusion.1.1 extra) w.denominator =
     trans (Square.expression Data.extra)
      (trans (ap (P.eval (Presentations[l].Fin (suc w.system.number)) S.S S.Loc.K.A.generators) Data.extra-image) r.2) ;
    module Open0 = AffineInterface[l].Over[Data.base,Data.set].Presented[S0.S,S0.Loc.pres,S0.Loc.K.presentation,extra,Data.extra,refl extra] ;
    module Target = LocalizationScalarExtension[l].Over[Data.base,R,Data.set,setR,Data.rho].At[
     S0.S,S.S,Square.Localised.inclusion,Square.Localised.theorem,Open0.L.algebra,extra,Open0.L.inclusion,Open0.result.2.2.2,
     E,w.denominator,w.map,w.localizes,extra-image] ;
    module Formal = FormalEtaleLocalization[l].Over[Data.base,Data.set].At[S0.S,Open0.L.algebra,extra,Open0.L.inclusion,Open0.result.2.2.2] ;
    formal : FormallyEtale[l].Over[Data.base,Data.set].FormallyEtale Open0.L.algebra = Formal.theorem S0.etale.1 ;
    cfn : CFN[l].CFN[CoefficientBase[l].Codes,Open0.L.algebra.ring] =
     CFNPresentedAlgebra[l].Over[Data.base,Data.set,CoefficientBase[l].Codes,Data.cfn].At[Open0.L.pres,Open0.L.algebra,Open0.L.K.presentation].theorem ;
    module Cover0 = ConstructiveEtaleCover[l].Over[Data.base,Data.set,Open0.L.algebra.ring,Open0.L.algebra.set,Open0.L.algebra.iota,
     Open0.L.pres,Open0.L.K.presentation,formal.2] ;
    module Specialise = MonicCoverScalarExtension[l].Over[Data.base,R,Data.set,setR,Data.rho].At[
     Open0.L.algebra,E,Target.inclusion,Target.theorem] ;
    theorem : Big.Trunc[Certified.Cover].carrier = Specialise.theorem (Cover0.theorem formal.1 CoefficientBase[l].Codes cfn) ;
   } ;
   theorem : Big.Trunc[Certified.Cover].carrier = TC.rec DeterminantRep @l+ Big.Trunc[Certified.Cover].carrier Big.Trunc[Certified.Cover].proposition
    (\ d -> DeterminantChosen[d].theorem) (G0.Generated[J0.pres,Q0.A.algebra,Q0.presentation].generated Source0.delta) ;
  } ;
  theorem : Big.Trunc[Certified.Cover].carrier = TC.rec Representation @l+ Big.Trunc[Certified.Cover].carrier Big.Trunc[Certified.Cover].proposition
   (\ r -> Represented[r].theorem) (Generated[l].Over[R,setR].Generated[S.Loc.pres,S.S,S.Loc.K.presentation].generated w.denominator) ;
 } ;
 theorem (fp : P.FP E) (formal : FE.FormallyEtale E) : Big.Trunc[Certified.Cover].carrier =
  BTC.bind Reduction.Result Certified.Cover (\ w -> From[w].theorem) (Reduction.theorem fp formal) ;
} ;
