-- A supplied tensor separator yields a separable monic presentation over
-- a possibly zero weak field. Bounded search supplies its minimal
-- polynomial. Tensor contraction gives the derivative inverse in S;
-- weak regularity reflects it into the embedded monic quotient. The
-- existing tensor coordinate proof then constructs both inverse maps.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (x : S.ring.R) (w : D.ring.R)
 (separator : Id D.ring.R (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference x) w)
  (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
 module Search = MereMinimalPolynomial[l].Over[k,setk,weak,S,n,basis,x] ;
 module Build = SeparatorMonogenic[l].Over[k,setk,S,n,basis,reduced,D,cp,epsilon,x,w,separator] ;
 module Given (f : Search.Min.Minimal) {
  module Data = Build.Given[f] ; module Image = Data.Image ;
  image-unit-case : (cs : List k.R) -> Id (List k.R) f.lower cs -> RL[S.ring].unit (Build.Derivative.slope cs) = split {
   nil -> \ same -> (S.ring.z,trans (RL[S.ring].zero-mul S.ring.z) (sym (Data.root-at nil same))) ;
   cons a cs -> \ same -> MereSeparatorDerivative[l].Over[k,setk,weak,S,D,cp,n,basis,x,epsilon,w,separator,
    a,cs,Data.root-at (cons a cs) same,Data.no-roots-at (cons a cs) same].theorem } ;
  image-unit : RL[S.ring].unit (Build.Derivative.slope f.lower) = image-unit-case f.lower (refl f.lower) ;
  regular : PrincipalRegularity[l].Over[Image.Q.ring].Regular =
   FiniteReducedRegular[l].Over[k,setk,Image.Q,Image.M.degree,Image.M.basis,Image.Reduced[reduced].theorem].theorem weak ;
  theorem : Build.Target.At[S] = Data.WithUnit[image-unit,regular].theorem ;
 } ;
 theorem : Tr.Trunc[Build.Target.At[S]].carrier =
  TC.map Search.Min.Minimal (Build.Target.At[S]) (\ f -> Given[f].theorem) Search.theorem ;
} ;
