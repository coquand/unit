-- Minimality gives a normalized top-power functional even in a weak
-- field. Apply positive separation. A span witness makes its monic
-- relation have leading coefficient zero, hence 1=0. In that case the
-- zero functional has the required target value; no contradiction is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (x : S.ring.R)
 (m : Nat) (no-roots : MinimalPolynomial[l].Over[k,setk,S,n,basis,x].NoRoots (suc m)) {
 module Power = MinimalPowerFunctional[l].Over[k,setk,S,n,basis,x,m,no-roots] ;
 module P = Power.P ;
 module Sep = MereLinearSeparation[l].Over[k,weak].At[n,m,P.vectors m,basis.coordinate P.At[m].target] ;
 collapsed (h : Id k.R k.o k.z) : Power.F.Functional =
  new Power.F.Functional[\ a -> k.z,\ a b -> sym (k.addZ k.z),
   \ r a -> sym (RL[k].mul-zero r),\ i -> refl k.z,sym h] ;
 choose : Sep.Result -> Power.F.Functional = split {
  inl w -> collapsed Power.Witness[w].one-zero ; inr f -> f } ;
 theorem : Tr.Trunc[Power.F.Functional].carrier = TC.map Sep.Result Power.F.Functional choose Sep.theorem ;
} ;
