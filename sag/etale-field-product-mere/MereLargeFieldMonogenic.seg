-- The large branch over a weak field. A supplied sufficiently long
-- unit-separated scalar family gives a unit value of the diagonal
-- Kronecker polynomial. This constructs a tensor separator, then an
-- actual separable monic presentation. No distinctness, nonzero base,
-- exact zero test, or supplied generator is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z) {
 module Search = DiagonalSeparator[l].Over[k,setk].At[S,D,cp,n,basis,epsilon] ;
 module Selection = MerePolynomialSelection[l].Over[k,setk,weak].At[D,Search.TensorBasis.rank,Search.TensorBasis.basis,
  n,Search.RC.raw,Search.kron-bound (suc n) Search.RC.family,\ q h -> Search.RC.polynomial-regular q tt (\ i -> h)] ;
 module Given (candidates : Fin Search.count -> k.R)
  (separated : PolynomialRootBound[l].Over[k].Separated Search.count candidates) {
  module Good = Selection.Given[candidates,separated] ;
  separator : Tr.Trunc[Search.Data].carrier = TC.map Good.Result Search.Data
   (\ r -> Search.FromUnit[candidates r.1,r.2].result) Good.theorem ;
  finish (s : Search.Data) : Tr.Trunc[MonogenicPresentation[l].Over[k,setk].At[S]].carrier =
   MereSeparatorMonogenic[l].Over[k,setk,weak,S,n,basis,reduced,D,cp,epsilon,s.element,s.inverse,s.equation].theorem ;
  theorem : Tr.Trunc[MonogenicPresentation[l].Over[k,setk].At[S]].carrier =
   TC.bind Search.Data MonogenicPresentation[l].Over[k,setk].At[S] finish separator ;
 } ;
} ;
