-- Gaussian elimination with pointwise merely zero-or-unit decisions.
-- The pivot constructions themselves are decision-free. At each row,
-- scan its finitely many entries inside truncation, then recurse on
-- dimension. Only the chosen branch's normal form is needed. Neither
-- a global chosen decision operation nor 1 != 0 occurs in the result.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing)
 (weak : (a : A.R) -> Tr.Trunc[Plus (Id A.R a A.z) (RL[A].unit a)].carrier) {
 module O = GaussianQuotient[l].Operations[A] ;
 module Field = FieldFlat[l].Over[A] ; module D = Field.Mere[weak] ;
 module V = O.V ;
 step (n : Nat) (ih : (m : Nat) (v : Fin m -> V.Vec n) -> Tr.Trunc[O.NormalForm[n,m,v]].carrier)
  (m : Nat) (v : Fin m -> V.Vec (suc n)) :
  Field.Cases m (\ j -> v j (inr tt)) -> Tr.Trunc[O.NormalForm[suc n,m,v]].carrier = split {
   inl hz -> TC.map O.NormalForm[n,m,\ j -> (O.G.drop n).map (v j)] O.NormalForm[suc n,m,v]
    (\ q -> O.ZeroRow[n,m,v,hz,q].result) (ih m (\ j -> (O.G.drop n).map (v j))) ;
   inr p -> TC.map O.NormalForm[n,m,O.Pivot[n,m,v,p.1,p.2.1,p.2.2].h] O.NormalForm[suc n,m,v]
    (\ q -> O.Pivot[n,m,v,p.1,p.2.1,p.2.2].With[q].result) (ih m O.Pivot[n,m,v,p.1,p.2.1,p.2.2].h) } ;
 normal-form : (n m : Nat) (v : Fin m -> V.Vec n) -> Tr.Trunc[O.NormalForm[n,m,v]].carrier = split {
  zero -> \ m v -> Tr.Trunc[O.NormalForm[zero,m,v]].inc (O.initial m v) ;
  suc n | ih -> \ m v -> TC.bind (Field.Cases m (\ j -> v j (inr tt))) O.NormalForm[suc n,m,v]
   (step n ih m v) (D.cases m (\ j -> v j (inr tt))) } ;
} ;
