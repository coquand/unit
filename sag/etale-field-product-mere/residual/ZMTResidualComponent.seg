-- At the original ZMT element s, s=1 in E/mE. Consequently the actual
-- finite subalgebra B maps onto E/mE: s^N z=j(b) becomes z=j(b) there.
-- No injectivity of B/mB is asserted. IdealPowerClearing pulls every
-- zero equation back with its explicit positive power of s. The weak
-- product theorem and the relative quotient ideal then supply a
-- component outside q. Lifting its finite equations precedes refinement.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (p : Presentations[l].Over[A,setA].Presentation)
 (ps : Presentations[l].Over[A,setA].Presents p (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (unique : FormallyEtale[l].Over[A,setA].Unique (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c))
 (Bot : U l) (bot-prop : Pr.isProp Bot) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot)
 (q-proper : q E.o -> Bot) (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier) {
 module Bridge = RefinedZMT[l].Over[A,setA,E,setE,iota,p,ps,unique,q,q-zero,q-add,q-scale,Bot,bot-prop,q-prime,q-proper,q-dec] ;
 module LZ = Bridge.LZ ; module Z = LZ.Z ; module X = LZ.X ; module I = LZ.I ; module L = LZ.L ; module EM = LZ.EM ;
 module Residue = QuotientFibreBaseChange[l].Over[L.ring,L.set,Z.I,LZ.m-prop,Z.Ea] ;
 module F = Residue.Fibre ; module K = F.QR ; module C = F.QE ;
 module Presented = Residue.Presented[LZ.PM.mapped,LZ.PM.presents] ;
 module ResidueField = LocalResidueField[l].Over[L.ring,Z.I,LZ.m-prop,X.dec] ;
 module Product = MereUnramifiedFieldProduct[l].Over[K.ring,K.set,ResidueField.mere-decide].At[
  Residue.algebra,Presented.finite-presentation,Presented.unramified (LZ.PM.unramified unique)] ;
 q-prop (a : EM.Carrier) : Pr.isProp (I.q' a) = Tr.Trunc[I.Member a].proposition ;
 quotient-ideal : RegularIdeal[l].IdealPred[EM.ring] =
  new RegularIdeal[l].IdealPred[EM.ring,I.q',I.q'-zero,I.q'-add,I.q'-scale] ;
 contains-witness (a : EM.Carrier) (w : F.W.Wit a) : I.q' a =
  subst I.q' (sym (Z.wit-to a w).2) (LZ.q'-gens (Z.wit-to a w).1) ;
 contains (a : EM.Carrier) (h : F.InIE a) : I.q' a = TC.rec (F.W.Wit a) @l (I.q' a) (q-prop a) (contains-witness a) h ;
 module Ideal = RelativeQuotientIdeal[l].Over[EM.ring,F.IE,quotient-ideal,F.propIE,q-prop,contains,Bot,X.q'-proper,X.q'-dec] ;
 module Select = ProductComponent[l].Over[K.ring,K.set].Select[Residue.algebra,Ideal.In,Ideal.addition,Bot,Ideal.one,Ideal.decision] ;
 selected : Tr.Trunc[Select.Result].carrier = Select.theorem Product.theorem ;
 module At (c : Z.Z.Conclusion) {
  module ZD = Z.At[c] ; module SelectedLocal = Bridge.At[c].Selected ;
  eta : H.Hom ZD.B.ring C.ring = H.compose ZD.B.ring EM.ring C.ring C.projection ZD.B.incl ;
  eta-scalar (a : L.Carrier) : Id C.Carrier (eta.1 (ZD.B.iotaB.1 a)) (C.include (LZ.C.O.iota'.1 a)) = refl (eta.1 (ZD.B.iotaB.1 a)) ;
  square (a : L.Carrier) : Id C.Carrier (eta.1 (ZD.B.iotaB.1 a)) (F.iotaI.1 (K.include a)) = trans (eta-scalar a) (sym (F.iotaI-beta a)) ;
  s-image : Id C.Carrier (C.include ZD.s) C.oneQ = C.Q.relates ZD.s EM.ring.o c.2.1 ;
  module CP = AffinePowers[l].Over[C.ring] ;
  one-power : (n : Nat) -> Id C.Carrier (CP.power C.oneQ n) C.oneQ = split {
   zero -> refl C.oneQ ; suc n | ih -> trans (ap (C.ring.mul C.oneQ) ih) (C.ring.mulO C.oneQ) } ;
  power-image (n : Nat) : Id C.Carrier (C.include (Z.PE.power ZD.s n)) C.oneQ =
   trans (AffinePowers[l].power-map EM.ring C.ring C.projection ZD.s n)
    (trans (ap (\ a -> CP.power a n) s-image) (one-power n)) ;
  Rep (a : C.Carrier) : U l = (b : ZD.B.Carrier) * Id C.Carrier (eta.1 b) a ;
  from-zmt (a : EM.Carrier) (w : ZD.Zmt a) : Rep (C.include a) =
   (w.2.1,trans (sym (ap C.include w.2.2))
    (trans (C.projection.2.2.2 (Z.PE.power ZD.s w.1) a)
     (trans (ap (\ x -> C.ring.mul x (C.include a)) (power-image w.1)) (RL[C.ring].one-left (C.include a))))) ;
  onto : (a : C.Carrier) -> Tr.Trunc[Rep a].carrier =
   C.Q.induction @l (\ a -> Tr.Trunc[Rep a].carrier) (\ a -> Tr.Trunc[Rep a].proposition)
    (\ a -> TC.map (ZD.Zmt a) (Rep (C.include a)) (from-zmt a) (ZD.zmt a)) ;
  module Clear = IdealPowerClearing[l].Over[L.ring,I.m,ZD.B.ring,EM.ring,ZD.B.set,ZD.B.iotaB,LZ.C.O.iota',ZD.B.incl,
   \ a -> refl (LZ.C.O.iota'.1 a),ZD.sB] ;
  module Cleared = Clear.Given[ZD.zmt,Clear.Injective[ZD.B.incl-inj].kernel] ;
  module Convert = FibreIdealWitnesses[l].Over[L.ring,ZD.B.ring,I.m,ZD.B.iotaB] ;
  Witness (b : ZD.B.Carrier) : U l = (N : Nat) * Convert.G.InmB (ZD.B.ring.mul (Clear.PB.power ZD.sB N) b) ;
  clear (b : ZD.B.Carrier) (eq : Id C.Carrier (eta.1 b) C.zeroQ) : Tr.Trunc[Witness b].carrier =
   TC.map (Clear.PositiveWitness b) (Witness b)
    (\ w -> (suc w.1,Convert.forward _ w.2)) (Cleared.theorem b (C.kernel (ZD.B.incl.1 b) eq)) ;
  module Lift = ComponentEquationLift[l].Over[L.ring,K.ring,K.set,K.projection,F.surjR,
   ZD.B.ring,ZD.B.set,ZD.B.iotaB,C.ring,C.set,eta,onto,F.iotaI,square,Witness,clear] ;
  module ChosenComponent (selection : Select.Selected) {
   module Chosen = Lift.Given[selection.1,suc ZD.n',ZD.bs] ;
   module Witnessed (w : Chosen.Result) {
    el : Chosen.Elements = w.1 ; pol : Chosen.Polynomials = w.2.1 ;
    module Raw = Chosen.Raw[el,pol] ;
    module Natural = PolynomialNaturality[l].SameCoefficients[L.ring,ZD.B.ring,EM.ring,ZD.B.set,EM.set,ZD.B.iotaB,LZ.C.O.iota',ZD.B.incl,\ a -> refl (LZ.C.O.iota'.1 a),el.x] ;
    eps-out (h : I.q' (ZD.B.incl.1 el.eps)) : Bot = selection.2
     (subst Ideal.In el.eps-image (Ideal.forward (ZD.B.incl.1 el.eps) h)) ;
    power-product (k : Nat) (b : ZD.B.ring.R) : Id EM.ring.R (ZD.B.incl.1 (ZD.B.ring.mul (Clear.PB.power ZD.sB k) b))
     (EM.ring.mul (SelectedLocal.In0.PE.power (ZD.B.incl.1 ZD.sB) k) (ZD.B.incl.1 b)) =
     trans (ZD.B.incl.2.2.2 (Clear.PB.power ZD.sB k) b)
      (ap (\ a -> EM.ring.mul a (ZD.B.incl.1 b)) (AffinePowers[l].power-map ZD.B.ring EM.ring ZD.B.incl ZD.sB k)) ;
    root-image : Id EM.ring.R (ZD.B.incl.1 Raw.root-element)
     (EM.ring.mul (ZD.B.incl.1 el.eps) (MonicReduce[l].Horner[L.ring,EM.ring,LZ.C.O.iota',ZD.B.incl.1 el.x].horner pol.p)) =
     trans (ZD.B.incl.2.2.2 el.eps (Raw.V.HB.horner pol.p)) (ap (EM.ring.mul (ZD.B.incl.1 el.eps)) (Natural.value pol.p)) ;
    -- Name the common dual evaluation before changing naturality squares.
    natural-source (p : List L.Carrier) : Id ZD.B.Carrier (Natural.D.bvalue p).2
     (CornerHorner[l].DualValues[L.ring,ZD.B.ring,ZD.B.set,ZD.B.iotaB,el.x].slope p) = refl (Natural.D.bvalue p).2 ;
    natural-target (p : List L.Carrier) : Id EM.Carrier (Natural.D.cvalue p).2
     (SelectedLocal.In0.slope (ZD.B.incl.1 el.x) p) = refl (Natural.D.cvalue p).2 ;
    slope-image (p : List L.Carrier) : Id EM.Carrier (ZD.B.incl.1 (Raw.D.bvalue p).2)
     (SelectedLocal.In0.slope (ZD.B.incl.1 el.x) p) =
     trans (ap ZD.B.incl.1 (Raw.source-slope p))
      (trans (ap ZD.B.incl.1 (sym (natural-source p))) (trans (Natural.slope p) (natural-target p))) ;
    sep-value : Id EM.ring.R (ZD.B.incl.1 (ZD.B.ring.add (ZD.B.ring.mul (Raw.D.bvalue pol.p).2 el.w) (ZD.B.ring.neg ZD.B.ring.o)))
     (EM.ring.add (EM.ring.mul (SelectedLocal.In0.slope (ZD.B.incl.1 el.x) pol.p) (ZD.B.incl.1 el.w)) (EM.ring.neg EM.ring.o)) =
     trans (ZD.B.incl.2.2.1 (ZD.B.ring.mul (Raw.D.bvalue pol.p).2 el.w) (ZD.B.ring.neg ZD.B.ring.o))
      (cong2 EM.ring.R EM.ring.add _ _ _ _
       (trans (ZD.B.incl.2.2.2 (Raw.D.bvalue pol.p).2 el.w)
        (ap (\ a -> EM.ring.mul a (ZD.B.incl.1 el.w)) (slope-image pol.p)))
       (trans (H.negation ZD.B.ring EM.ring ZD.B.incl ZD.B.ring.o) (ap EM.ring.neg ZD.B.incl.2.1))) ;
    sep-image : Id EM.ring.R (ZD.B.incl.1 Raw.sep-element)
     (EM.ring.mul (ZD.B.incl.1 el.eps) (EM.ring.add (EM.ring.mul (SelectedLocal.In0.slope (ZD.B.incl.1 el.x) pol.p) (ZD.B.incl.1 el.w)) (EM.ring.neg EM.ring.o))) =
     trans (ZD.B.incl.2.2.2 el.eps (ZD.B.ring.add (ZD.B.ring.mul (Raw.D.bvalue pol.p).2 el.w) (ZD.B.ring.neg ZD.B.ring.o)))
      (ap (EM.ring.mul (ZD.B.incl.1 el.eps)) sep-value) ;
    root : SelectedLocal.PRoot el.eps el.x pol.p =
     (w.2.2.1.1,subst SelectedLocal.In0.IGE.InmB
      (trans (power-product w.2.2.1.1 Raw.root-element)
       (ap (EM.ring.mul (SelectedLocal.In0.PE.power (ZD.B.incl.1 ZD.sB) w.2.2.1.1)) root-image))
      (SelectedLocal.In0.to-E _ w.2.2.1.2)) ;
    separable : SelectedLocal.PSeparable el.eps el.x pol.p =
     (ZD.B.incl.1 el.w,w.2.2.2.1.1,subst SelectedLocal.In0.IGE.InmB
      (trans (power-product w.2.2.2.1.1 Raw.sep-element)
       (ap (EM.ring.mul (SelectedLocal.In0.PE.power (ZD.B.incl.1 ZD.sB) w.2.2.2.1.1)) sep-image))
      (SelectedLocal.In0.to-E _ w.2.2.2.1.2)) ;
    generates : SelectedLocal.PGenerates el.eps el.x = \ i -> (pol.cs i,w.2.2.2.2 i) ;
    piece : SelectedLocal.Piece el.eps el.x = (pol.p,root,separable,generates) ;
    datum : SelectedLocal.SelectedData = (el.eps,el.x,eps-out,piece) ;
   } ;
   selected-data : Tr.Trunc[SelectedLocal.SelectedData].carrier =
    TC.map Chosen.Result SelectedLocal.SelectedData (\ w -> Witnessed[w].datum) Chosen.theorem ;
   theorem : Tr.Trunc[LZ.At[c].Refined].carrier = Bridge.At[c].theorem selected-data ;
  } ;
  cases : Select.Result -> Tr.Trunc[LZ.At[c].Refined].carrier = split {
   inl b -> Tr.Trunc[LZ.At[c].Refined].inc (inl b) ;
   inr selection -> ChosenComponent[selection].theorem } ;
  theorem : Tr.Trunc[LZ.At[c].Refined].carrier = TC.bind Select.Result LZ.At[c].Refined cases selected ;
 } ;
 field (c : Z.Z.Conclusion) : Tr.Trunc[LZ.At[c].Refined].carrier = At[c].theorem ;
 theorem (smooth : FormallyEtale[l].Over[A,setA].Lift LZ.C.O.Mo.Ealg) : Truncation[l+].Trunc[LZ.Outcome].carrier =
  LZ.FieldCase[field,smooth].theorem ;
} ;
