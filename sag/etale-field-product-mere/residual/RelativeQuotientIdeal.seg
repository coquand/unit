-- An ideal q containing I induces a relative ideal on E/I. Factor the
-- quotient map E -> E/q through E/I and use its kernel. Effectiveness
-- gives q back on representatives. Relative membership decisions descend
-- merely, and 1 in the induced ideal gives Bot. No primality is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (E : CRing) (I q : RegularIdeal[l].IdealPred[E])
 (propI : (a : E.R) -> Pr.isProp (I.In a)) (propq : (a : E.R) -> Pr.isProp (q.In a))
 (contains : (a : E.R) -> I.In a -> q.In a)
 (Bot : U l) (proper : q.In E.o -> Bot)
 (decide : (a : E.R) -> Tr.Trunc[Plus (q.In a) (q.In a -> Bot)].carrier) {
 module Q = QuotientRing[l].Over[E,I,propI] ; module T = QuotientRing[l].Over[E,q,propq] ;
 module Map = QuotientRingDescent[l].Over[E,I,propI,T.ring,T.set,T.projection,\ a h -> T.to-zero a (contains a h)] ;
 In (x : Q.Carrier) : U l = Id T.Carrier (Map.hom.1 x) T.zeroQ ;
 prop (x : Q.Carrier) : Pr.isProp (In x) = T.set _ _ ;
 zero : In Q.zeroQ = H.zero Q.ring T.ring Map.hom ;
 addition (a b : Q.Carrier) (ha : In a) (hb : In b) : In (Q.addQ a b) =
  trans (Map.hom.2.2.1 a b) (trans (cong2 T.Carrier T.addQ _ _ _ _ ha hb) (T.ring.addZ T.zeroQ)) ;
 scale (a b : Q.Carrier) (hb : In b) : In (Q.mulQ a b) =
  trans (Map.hom.2.2.2 a b) (trans (ap (T.ring.mul (Map.hom.1 a)) hb) (RL[T.ring].mul-zero (Map.hom.1 a))) ;
 forward (a : E.R) (h : q.In a) : In (Q.include a) = trans (Map.beta a) (T.to-zero a h) ;
 backward (a : E.R) (h : In (Q.include a)) : q.In a = T.kernel a (trans (sym (Map.beta a)) h) ;
 one (h : In Q.oneQ) : Bot = proper (backward E.o h) ;
 Decision (x : Q.Carrier) : U l = Plus (In x) (In x -> Bot) ;
 choose (a : E.R) : Plus (q.In a) (q.In a -> Bot) -> Decision (Q.include a) = split {
  inl h -> inl (forward a h) ; inr h -> inr (\ p -> h (backward a p)) } ;
 decision : (x : Q.Carrier) -> Tr.Trunc[Decision x].carrier =
  Q.Q.induction @l (\ x -> Tr.Trunc[Decision x].carrier) (\ x -> Tr.Trunc[Decision x].proposition)
   (\ a -> TC.map (Plus (q.In a) (q.In a -> Bot)) (Decision (Q.include a)) (choose a) (decide a)) ;
} ;
