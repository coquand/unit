-- Discharge Fields in the hit-or-split cover theorem. At each finite
-- ideal node the weak residual product and component lifting supply
-- the repaired local boundary. The only extra base condition on this
-- endpoint is CFN of E; arbitrary-base specialization is a separate step.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (p : Presentations[l].Over[A,setA].Presentation)
 (ps : Presentations[l].Over[A,setA].Presents p (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (unique : FormallyEtale[l].Over[A,setA].Unique (Algebras[l].Over[A,setA].mkAlgebra E setE iota)) {
 module Cover = HitOrSplitLocal[l].Over[A,setA,E,setE,iota,p,ps,unique] ; module P = Cover.P ;
 module At (s : List E.R) (proper : Not (P.Mem s E.o)) (dec : Cover.HS.Decision s) {
  module Node = Cover.At[s,proper,dec] ;
  module LocalCase = ZMTResidualComponent[l].Over[A,setA,E,setE,iota,p,ps,unique,P.Mem s,P.At[s].zero,P.At[s].add,P.At[s].scale,
   Node.Bot,Tr.Trunc[P.Split s].proposition,Node.q-prime,Node.q-proper,Node.q-dec] ;
  field : Node.FieldCases = LocalCase.field ;
 } ;
 fields : Cover.Fields = \ s proper dec -> At[s,proper,dec].field ;
 local (smooth : FormallyEtale[l].Over[A,setA].Lift Cover.Mo.Ealg) : Cover.HS.Local = Cover.Given[fields].local smooth ;
 theorem (smooth : FormallyEtale[l].Over[A,setA].Lift Cover.Mo.Ealg)
  (K0 : U l) (cfn : CFN[l].CFN[K0,E]) : Truncation[l+].Trunc[Cover.HS.C.Cover].carrier =
  Cover.Given[fields].theorem smooth K0 cfn ;
} ;
