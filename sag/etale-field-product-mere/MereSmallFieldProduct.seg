-- The small branch uses the finite coefficient field only through its
-- map to k. The supplied monic equations give a finite free algebra Q
-- over that field and a map Q -> S. Enumerate Q and verify its finite
-- image model up to base collapse. Verify the coefficient map, then
-- refine the reduced model into finite fields and generate every image
-- corner. Collapse is a successful zero-base product certificate.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (K : CRing) (setK : Pr.isSet K.R) (dec : (a : K.R) -> Plus (Id K.R a K.z) (RL[K].unit a))
 (rho : H.Hom K k) (m : Nat) (values : Fin m -> K.R) (cover : (a : K.R) -> (i : Fin m) * Id K.R (values i) a) {
 module C = Algebras[l].Over[K,setK] ; module MB = IteratedMonicBasis[l].Over[K,setK] ;
 restricted : C.Algebra = C.mkAlgebra S.ring S.set (H.compose K k S.ring S.iota rho) ;
 module Equality = MereCoordinateEquality[l].Over[k,setk,weak] ;
 module Target = ProductPresentation[l].Over[k,setk] ;
 Result : U l = Tr.Trunc[Target.At[S]].carrier ;
 collapse (h : Equality.Collapse) : Result = Tr.Trunc[Target.At[S]].inc (ZeroProduct[l].Over[k,setk].BaseZero[h].theorem S) ;
 module Given (lower : Fin n -> List K.R) (roots : MB.Roots n lower restricted basis.vector) {
  monic : MB.Cover[n,lower] = MB.construct n lower ;
  Q : C.Algebra = monic.algebra ;
  u : C.Hom Q restricted = monic.extend restricted basis.vector roots ;
  module Free = FiniteFreeEnumeration[l].Over[K,setK,m,values,cover,Q,monic.rank,monic.basis] ;
  module Image = MereFiniteImage[l].Over[Q.ring,S.ring,S.set,u.1,Free.size,Free.enumeration,Free.covers,
   Equality.Collapse,Equality.At[S,n,basis].theorem,reduced] ;
  module Model (model : Image.Model) {
   module I = Image.At[model.1] ;
   module Coefficients = I.Coefficients[K,Q.iota,m,values,cover] ;
   module Given (laws : Coefficients.Laws) {
    module B = I.Table.Given[model.2] ;
    module Scalar = Coefficients.Given[model.2,laws] ;
    algebra : C.Algebra = C.mkAlgebra B.ring B.set Scalar.hom ;
    commutes (a : K.R) : Id S.ring.R (B.hom.1 (Scalar.hom.1 a)) (S.iota.1 (rho.1 a)) =
     trans (Scalar.commutes a) (u.2 a) ;
    preimage (i : Fin n) : B.ring.R = I.index (monic.generator i) ;
    generator-image (i : Fin n) : Id S.ring.R (B.hom.1 (preimage i)) (basis.vector i) =
     trans (I.index-image (monic.generator i)) (monic.beta restricted basis.vector roots i) ;
    enumeration (i : Fin model.1.size) : B.ring.R = i ;
    covers (a : B.ring.R) : (i : Fin model.1.size) * Id B.ring.R (enumeration i) a = (a,refl a) ;
    theorem : Result = MereModelProduct[l].Over[k,setk,weak,S,n,basis,reduced,nondegenerate,
     K,setK,dec,rho,algebra,FinitePermutationFold[l].Index.decide model.1.size,
     model.1.size,enumeration,covers,model.2.reduced,B.hom,commutes,preimage,generator-image].theorem ;
   } ;
   cases : Plus Coefficients.Laws Equality.Collapse -> Result = split {
    inl laws -> Given[laws].theorem ; inr h -> collapse h } ;
   theorem : Result = cases Coefficients.theorem ;
  } ;
  cases : Plus Image.Model Equality.Collapse -> Result = split {
   inl model -> Model[model].theorem ; inr h -> collapse h } ;
  theorem : Result = TC.rec (Plus Image.Model Equality.Collapse) @l Result Tr.Trunc[Target.At[S]].proposition cases Image.theorem ;
 } ;
} ;
