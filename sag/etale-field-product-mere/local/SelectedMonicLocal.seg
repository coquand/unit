-- Refine the ZMT element before requiring a generator. The multiplier
-- e only represents a residual idempotent; no equation e^2=e in B is
-- assumed. Since s and e are outside q relative to Bot, so is s'=s e.
-- Multiplying a ZMT numerator by e^k proves the new localisation law.
-- The identity (s e)^(N+1) w = (s e^N) (s^N (e w)) clears each
-- component equation. The resulting Factor is at s', and the existing
-- data theorem produces ChartData independent of the choice of s.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Tr.Trunc[Plus (m a) (RL[A].unit a)].carrier)
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (Bot : U l) (q-prime-out : (a c : E.R) -> (q a -> Bot) -> (q c -> Bot) -> q (E.mul a c) -> Bot) (q-proper : q E.o -> Bot)
 (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier)
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-out : q (j.1 s) -> Bot)
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier) {
 module Original = MonicFiniteLocal[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,
  E,setE,iota,q,q-zero,q-add,q-scale,q-m,Bot,q-prime-out,q-proper,q-dec,
  B,setB,iB,j,j-alg,n',bs,coord,s,s-out,zmt] ;
 module In0 = Original.In ;
 module RE = TheoremLocal[l].Refine[E] ; module RB = TheoremLocal[l].Refine[B] ;
 PRoot (eps x : B.R) (P : List A.R) : U l =
  (N : Nat) * In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.mul (j.1 eps) (MonicReduce[l].Horner[A,E,iota,j.1 x].horner P))) ;
 PSeparable (eps x : B.R) (P : List A.R) : U l =
  (w : E.R) * (N : Nat) * In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.mul (j.1 eps) (E.add (E.mul (In0.slope (j.1 x) P) w) (E.neg E.o)))) ;
 PGenerates (eps x : B.R) : U l =
  (i : Ps.Fin (suc n')) -> (C : List A.R) * (N : Nat) *
   In0.IGB.InmB (B.mul (In0.PB.power s N) (B.mul eps (B.add (bs i) (B.neg (MonicReduce[l].Horner[A,B,iB,x].horner C))))) ;
 Piece (eps x : B.R) : U l = (P : List A.R) * PRoot eps x P * PSeparable eps x P * PGenerates eps x ;
 ppoly {eps x : B.R} (F : Piece eps x) : List A.R = F.1 ;
 proot {eps x : B.R} (F : Piece eps x) : PRoot eps x (ppoly F) = F.2.1 ;
 pseparable {eps x : B.R} (F : Piece eps x) : PSeparable eps x (ppoly F) = F.2.2.1 ;
 pgenerates {eps x : B.R} (F : Piece eps x) : PGenerates eps x = F.2.2.2 ;

 module Selected (e x : B.R) (out : q (j.1 e) -> Bot) (F : Piece e x) {
   s' : B.R = B.mul s e ;
   js' : Id E.R (j.1 s') (E.mul (j.1 s) (j.1 e)) = j.2.2.2 s e ;
   s'-out (h : q (j.1 s')) : Bot = In0.prime-out (j.1 s) (j.1 e) s-out out (subst q js' h) ;
   Zmt' (z : E.R) : U l = (k : Nat) * (b : B.R) * Id E.R (E.mul (In0.PE.power (j.1 s') k) z) (j.1 b) ;
   zmt-at (z : E.R) (w : In0.Zmt z) : Zmt' z =
    (w.1,B.mul (In0.PB.power e w.1) w.2.1,calc E.R {
     E.mul (In0.PE.power (j.1 s') w.1) z
      =< ap (\ t -> E.mul (In0.PE.power t w.1) z) js' > E.mul (In0.PE.power (E.mul (j.1 s) (j.1 e)) w.1) z
      =< ap (\ t -> E.mul t z) (In0.PE.power-mul (j.1 s) (j.1 e) w.1)
       > E.mul (E.mul (In0.PE.power (j.1 s) w.1) (In0.PE.power (j.1 e) w.1)) z
      =< trans (ap (\ t -> E.mul t z) (E.mulC (In0.PE.power (j.1 s) w.1) (In0.PE.power (j.1 e) w.1)))
          (sym (E.mulA (In0.PE.power (j.1 e) w.1) (In0.PE.power (j.1 s) w.1) z))
       > E.mul (In0.PE.power (j.1 e) w.1) (E.mul (In0.PE.power (j.1 s) w.1) z)
      =< ap (E.mul (In0.PE.power (j.1 e) w.1)) w.2.2 > E.mul (In0.PE.power (j.1 e) w.1) (j.1 w.2.1)
      =< sym (trans (j.2.2.2 (In0.PB.power e w.1) w.2.1)
          (ap (\ t -> E.mul t (j.1 w.2.1)) (AffinePowers[l].power-map B E j e w.1)))
       > j.1 (B.mul (In0.PB.power e w.1) w.2.1) }) ;
   zmt' (z : E.R) : Tr.Trunc[Zmt' z].carrier = In0.TC.map (In0.Zmt z) (Zmt' z) (zmt-at z) (zmt z) ;
   module Lo = MonicFiniteLocal[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,
    E,setE,iota,q,q-zero,q-add,q-scale,q-m,Bot,q-prime-out,q-proper,q-dec,
    B,setB,iB,j,j-alg,n',bs,coord,s',s'-out,zmt'] ;
   -- s'^(N+1) w = (s eps^N) (s^N (eps w)), in E
   lift-E (N : Nat) (w : E.R) (h : In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.mul (j.1 e) w))) :
    In0.IGE.InmB (E.mul (In0.PE.power (j.1 s') (suc N)) w) =
    subst In0.IGE.InmB (sym (trans (ap (\ t -> E.mul (In0.PE.power t (suc N)) w) js') (RE.refine (j.1 s) (j.1 e) w N)))
     (In0.IGE.in-scale (E.mul (j.1 s) (In0.PE.power (j.1 e) N)) _ h) ;
   factor : Lo.In.Factor x =
    (ppoly F,(suc (proot F).1,lift-E (proot F).1 _ (proot F).2),
     ((pseparable F).1,suc (pseparable F).2.1,lift-E (pseparable F).2.1 _ (pseparable F).2.2),
     \ i -> ((pgenerates F i).1,suc (pgenerates F i).2.1,
       subst In0.IGB.InmB (sym (RB.refine s e (B.add (bs i) (B.neg (MonicReduce[l].Horner[A,B,iB,x].horner (pgenerates F i).1))) (pgenerates F i).2.1))
        (In0.IGB.in-scale (B.mul s (In0.PB.power e (pgenerates F i).2.1)) _ (pgenerates F i).2.2))) ;
   theorem : Tr.Trunc[Original.ChartData].carrier = Lo.Data[x,factor].theorem ;
 } ;
 SelectedData : U l = (e : B.R) * (x : B.R) * (q (j.1 e) -> Bot) * Piece e x ;
 theorem (fd : Tr.Trunc[SelectedData].carrier) : Tr.Trunc[Original.ChartData].carrier =
  TruncationCombinators[l].bind SelectedData Original.ChartData
   (\ w -> Selected[w.1,w.2.1,w.2.2.1,w.2.2.2].theorem) fd ;
} ;
