-- Bridge the selected finite equations into the repaired ZMT boundary.
-- The original s-out is proved using s=1 modulo mE before refinement.
-- SelectedMonicLocal then uses s'=s*eps and supplies the same ChartData
-- consumed by LocalisedZMT. No flatness or exact prime is an argument.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (p : Presentations[l].Over[A,setA].Presentation)
 (ps : Presentations[l].Over[A,setA].Presents p (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (unique : FormallyEtale[l].Over[A,setA].Unique (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c))
 (Bot : U l) (bot-prop : Pr.isProp Bot) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot)
 (q-proper : q E.o -> Bot) (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier) {
 module LZ = LocalisedZMT[l].Over[A,setA,E,setE,iota,p,ps,unique,q,q-zero,q-add,q-scale,
  Bot,bot-prop,q-prime,q-proper,q-dec] ;
 module At (c : LZ.Z.Z.Conclusion) {
  module ZD = LZ.Z.At[c] ; module X = LZ.X ; module I = LZ.I ; module L = LZ.L ; module EM = LZ.EM ;
  module Selected = SelectedMonicLocal[l].Over[L.ring,L.set,I.m,I.m-zero,I.m-add,I.m-scale,X.dec,
   EM.ring,EM.set,LZ.C.O.iota',I.q',I.q'-zero,I.q'-add,I.q'-scale,I.q-m,
   Bot,X.q'-prime-out,X.q'-proper,X.q'-dec,ZD.B.ring,ZD.B.set,ZD.B.iotaB,ZD.B.incl,
   \ a -> refl (LZ.C.O.iota'.1 a),ZD.n',ZD.bs,ZD.coord,ZD.sB,
   LZ.s-out (ZD.B.incl.1 ZD.sB) ZD.s-one,ZD.zmt] ;
  theorem (fd : Tr.Trunc[Selected.SelectedData].carrier) : Tr.Trunc[LZ.At[c].Refined].carrier =
   TruncationCombinators[l].map Selected.Original.ChartData LZ.At[c].Refined (\ d -> inr d) (Selected.theorem fd) ;
 } ;
} ;
