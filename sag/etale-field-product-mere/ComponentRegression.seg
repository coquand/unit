-- Apply the adapter to the existing computed small-field product of
-- F2^3. Selection at a coordinate needs no selected prime certificate.
-- Also retain a zero target, zero base, and a binary zero factor.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module B = BooleanRing[l] ; module R = SeparatorRegression[l] ;
module PR = ProductRegression[l] ; module C = ProductComponent[l].Over[R.k,B.bool-set] ;
module Three = PR.Functions[PR.three] ;
index : Fin PR.three = inr tt ;
q (a : Three.Carrier) : U l = Id R.k.R (a index) R.k.z ;
q-add (a b : Three.Carrier) (ha : q a) (hb : q b) : q (Three.ring.add a b) =
 trans (cong2 R.k.R R.k.add _ _ _ _ ha hb) (R.k.addZ R.k.z) ;
decision (a : Three.Carrier) : Tr.Trunc[Plus (q a) (q a -> Empty)].carrier =
 Tr.Trunc[Plus (q a) (q a -> Empty)].inc
  (DiscreteFieldOperations[l].Over[R.k,B.bool-set,R.dec,R.nontrivial].zero-dec (a index)) ;
module Selection = C.Select[Three.algebra,q,q-add,Empty,R.nontrivial,decision] ;
discard-empty : Selection.Result -> Selection.Selected = split {
 inl e -> efq e ; inr c -> c } ;
three-components : Tr.Trunc[Selection.Selected].carrier =
 TC.map Selection.Result Selection.Selected discard-empty (Selection.theorem PR.three-factors) ;
module Z = ZeroProduct[l].Over[R.k,B.bool-set] ;
zero-target : ProductPresentation[l].Over[R.k,B.bool-set].At[R.ZeroAlgebra.algebra] =
 Z.At[R.ZeroAlgebra.algebra,refl tt].theorem ;
module Product = ProductPresentation[l].Over[R.k,B.bool-set] ;
module Iso = AlgebraIsomorphism[l].Over[R.k,B.bool-set] ;
with-zero (p : Product.At[Three.algebra]) : Product.At[Iso.Product[R.ZeroAlgebra.algebra,Three.algebra].algebra] =
 Product.product R.ZeroAlgebra.algebra Three.algebra zero-target p ;
zero-factor : Tr.Trunc[Product.At[Iso.Product[R.ZeroAlgebra.algebra,Three.algebra].algebra]].carrier =
 TC.map Product.At[Three.algebra] Product.At[Iso.Product[R.ZeroAlgebra.algebra,Three.algebra].algebra] with-zero PR.three-factors ;
module ZeroBase = Algebras[l].Over[R.ZeroAlgebra.ring,R.ZeroAlgebra.set] ;
zero-base : ProductPresentation[l].Over[R.ZeroAlgebra.ring,R.ZeroAlgebra.set].At[ZeroBase.base] =
 ZeroProduct[l].Over[R.ZeroAlgebra.ring,R.ZeroAlgebra.set].BaseZero[refl tt].theorem ZeroBase.base ;
-- Every support is in the total ideal: the root membership gives Bot.
module Total = C.Select[Three.algebra,\ a -> Top,\ a b ha hb -> tt,Top,\ h -> tt,
 \ a -> Tr.Trunc[Plus Top (Top -> Top)].inc (inl tt)] ;
total-ideal : Tr.Trunc[Total.Result].carrier = Total.theorem PR.three-factors ;
-- A genuine weak-field normal form, including a zero base. No nonzero
-- assertion can be supplied for this second test.
module G = MereGaussian[l].Over[R.k,\ a -> Tr.Trunc[FieldFlat[l].Over[R.k].Decision a].inc (R.dec a)] ;
boolean-matrix : Tr.Trunc[G.O.NormalForm[R.two,R.two,\ j i -> MnSums[l].Over[R.k].delta R.two j i]].carrier =
 G.normal-form R.two R.two (\ j i -> MnSums[l].Over[R.k].delta R.two j i) ;
module GZ = MereGaussian[l].Over[R.ZeroAlgebra.ring,\ a ->
 Tr.Trunc[FieldFlat[l].Over[R.ZeroAlgebra.ring].Decision a].inc (inl (MnSums[l].top-eq a tt))] ;
zero-matrix : Tr.Trunc[GZ.O.NormalForm[R.two,R.two,\ j i -> tt]].carrier = GZ.normal-form R.two R.two (\ j i -> tt) ;
-- End-to-end weak-field structure: no basis is an input here.
module Structure = MereFieldStructure[l].Over[R.k,B.bool-set,
 \ a -> Tr.Trunc[FieldFlat[l].Over[R.k].Decision a].inc (R.dec a)].At[R.C.base,R.BaseP.finitely-presented,R.unique] ;
weak-structure : Tr.Trunc[Structure.D.Structure].carrier = Structure.theorem ;
module ZP = BasePresentation[l].Over[R.ZeroAlgebra.ring,R.ZeroAlgebra.set] ;
zero-unique : FormallyEtale[l].Over[R.ZeroAlgebra.ring,R.ZeroAlgebra.set].Unique ZeroBase.base =
 \ A N f g h -> ZeroBase.ext ZeroBase.base A f g (\ a -> trans (f.2 a) (sym (g.2 a))) ;
module ZeroStructure = MereFieldStructure[l].Over[R.ZeroAlgebra.ring,R.ZeroAlgebra.set,
 \ a -> Tr.Trunc[FieldFlat[l].Over[R.ZeroAlgebra.ring].Decision a].inc (inl (MnSums[l].top-eq a tt))].At[
 ZeroBase.base,ZP.finitely-presented,zero-unique] ;
zero-structure : Tr.Trunc[ZeroStructure.D.Structure].carrier = ZeroStructure.theorem ;
all-supports (p : Product.At[Three.algebra]) : Top = Total.Given[p].all-in (\ i -> tt) ;
