-- Equality of values in a unit-separated finite family either reflects
-- to equality of indices or proves 1=0. Only index equality is decided.
-- This is the finite verification step for coefficient tables; it does
-- not assert that their map into a possibly zero base is injective.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Index = FinitePermutationFold[l].Index ;
-- Decidable equality supplies sethood by local Hedberg. The intermediate
-- relation is mere equality; its decoder uses the supplied decision.
module Discrete (X : U l) (equal : (a b : X) -> Plus (Id X a b) (Not (Id X a b))) {
 decode (a b : X) : Plus (Id X a b) (Not (Id X a b)) -> Tr.Trunc[Id X a b].carrier -> Id X a b = split {
  inl h -> \ t -> h ;
  inr no -> \ t -> efq (TC.rec (Id X a b) @l Empty (\ x y -> efq x) no t) } ;
 set : Pr.isSet X = \ a -> Pr.Hedberg[X,a,\ b -> Tr.Trunc[Id X a b].carrier,
  \ b -> Tr.Trunc[Id X a b].proposition,Tr.Trunc[Id X a a].inc (refl a),
  \ b -> decode a b (equal a b)].hedberg ;
} ;
module Over (k : CRing) (n : Nat) (v : Fin n -> k.R)
 (separated : PolynomialRootBound[l].Over[k].Separated n v) {
 Collapse : U l = Id k.R k.o k.z ;
 module Collision (i j : Fin n) (different : Not (Id (Fin n) i j)) (same : Id k.R (v i) (v j)) {
  u : RL[k].unit (k.add (v i) (k.neg (v j))) = separated i j different ;
  difference-zero : Id k.R (k.add (v i) (k.neg (v j))) k.z =
   trans (ap (\ a -> k.add a (k.neg (v j))) same) (k.addN (v j)) ;
  theorem : Collapse = trans (sym u.2)
   (trans (ap (\ a -> k.mul a u.1) difference-zero) (RL[k].zero-mul u.1)) ;
 } ;
 choose (i j : Fin n) (same : Id k.R (v i) (v j)) :
  Plus (Id (Fin n) i j) (Not (Id (Fin n) i j)) -> Plus (Id (Fin n) i j) Collapse = split {
  inl h -> inl h ; inr h -> inr Collision[i,j,h,same].theorem } ;
 reflect (i j : Fin n) (same : Id k.R (v i) (v j)) : Plus (Id (Fin n) i j) Collapse =
  choose i j same (Index.decide n i j) ;
} ;
