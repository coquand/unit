-- Merely either exhibit span coefficients or a normalized separating
-- functional. First obtain a Gaussian quotient. Scan its coordinates:
-- all zero gives coefficients; a unit coordinate gives the functional.
-- Both outcomes are positive data and can overlap when 1=0.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier) {
 module G = MereGaussian[l].Over[k,weak] ; module V = G.V ;
 module Field = FieldFlat[l].Over[k] ; module D = Field.Mere[weak] ;
 module At (n m : Nat) (v : Fin m -> V.Vec n) (x : V.Vec n) {
  module F = FieldSeparatingFunctional[l].Data[k].At[n,m,v,x] ;
  Result : U l = Plus (V.Span[n,m,v].Witness x) F.Functional ;
  module Given (q : G.O.NormalForm[n,m,v]) {
   module K = FieldLinearMembership[l].FromNormalForm[k].At[n,m,v,q] ;
   choose : Field.Cases q.rank (q.project.map x) -> Result = split {
    inl hz -> inl (K.from-zero x hz) ;
    inr p -> inr F.Given[q].Pivot[p.1,p.2.1,p.2.2].theorem } ;
   theorem : Tr.Trunc[Result].carrier =
    TC.map (Field.Cases q.rank (q.project.map x)) Result choose (D.cases q.rank (q.project.map x)) ;
  } ;
  theorem : Tr.Trunc[Result].carrier =
   TC.bind G.O.NormalForm[n,m,v] Result (\ q -> Given[q].theorem) (G.normal-form n m v) ;
 } ;
} ;
