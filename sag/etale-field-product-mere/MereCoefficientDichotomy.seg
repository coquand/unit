-- Construct the coefficient dichotomy from weak decisions alone.
-- Bounded closure gives a long unit-separated family or a closed table.
-- Finite verification of a table gives either 1=0 or an actual finite
-- field model with a ring map into k and coefficient preimages. Keep
-- the finite model as its table and verified laws in the same universe.
-- The small branch must work with this map; it is not a subfield inclusion.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier)
 (t : Nat) (coefficients : Fin t -> k.R) {
 module Closure = MereFiniteClosure[l].Over[k,setk,weak,t,coefficients] ;
 module Check (c : Closure.ClosedData) {
  module Table = FiniteClosedField[l].Over[k,setk,weak,t,coefficients,c.1,c.2.1,c.2.2.1,c.2.2.2] ;
 } ;
 Small : U l = (c : Closure.ClosedData) * Check[c].Table.Verified ;
 Result (M : Nat) : U l = Plus (Id k.R k.o k.z) (Plus (Closure.Many (suc M)) Small) ;
 table-case (M : Nat) (c : Closure.ClosedData) :
  Plus Check[c].Table.Verified (Id k.R k.o k.z) -> Result M = split {
  inl h -> inr (inr (c,h)) ; inr h -> inl h } ;
 choose (M : Nat) : Plus (Closure.Many (suc M)) Closure.ClosedData -> Result M = split {
  inl v -> inr (inl v) ; inr c -> table-case M c Check[c].Table.theorem } ;
 theorem (M : Nat) : Tr.Trunc[Result M].carrier =
  TC.map (Plus (Closure.Many (suc M)) Closure.ClosedData) (Result M) (choose M) (Closure.theorem M) ;
 module Model (s : Small) {
  module Field = Check[s.1].Table.Given[s.2] ;
  enumeration (i : Fin s.1.1) : Field.ring.R = i ;
  injective (i j : Fin s.1.1) (h : Id Field.ring.R (enumeration i) (enumeration j)) : Id (Fin s.1.1) i j = h ;
  cover (a : Field.ring.R) : (i : Fin s.1.1) * Id Field.ring.R (enumeration i) a = (a,refl a) ;
 } ;
} ;
