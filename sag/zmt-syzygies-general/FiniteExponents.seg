-- Ordinary exponents for any finite variable set. The new variable is
-- inr tt and all old variables are inl i, matching CoefficientTower.
level l ; open Ring[l] ; open ZInt[l] ;
module Ps = Presentations[l] ; module Pr = Prelude[l] ; module LG = Logic[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ; module NA = NatArith[l] ;
Exp (n : Nat) : U l = Ps.Fin n -> Base.Nat ;
old (n : Nat) (u : Exp (suc n)) : Exp n = \ i -> u (inl i) ;
join (n : Nat) (u : Exp n) (k : Base.Nat) : Exp (suc n) = split { inl i -> u i ; inr t -> k } ;
ext (n : Nat) (u v : Exp n) (h : (i : Ps.Fin n) -> Id Base.Nat (u i) (v i)) : Id (Exp n) u v = FE.funext (Ps.Fin n) (\ i -> Base.Nat) u v h ;
top-eq (n : Nat) (u v : Exp (suc n)) (h : Id Base.Nat (u (inr tt)) (v (inr tt))) :
 (t : Top) -> Id Base.Nat (u (inr t)) (v (inr t)) = split { tt -> h } ;
split-at (n : Nat) (u v : Exp (suc n)) (h : Id Base.Nat (u (inr tt)) (v (inr tt))) (q : Id (Exp n) (old n u) (old n v)) :
 (i : Ps.Fin (suc n)) -> Id Base.Nat (u i) (v i) = split {
 inl i -> Pr.happly (Ps.Fin n) (\ i -> Base.Nat) _ _ q i ; inr t -> top-eq n u v h t } ;
split-eq (n : Nat) (u v : Exp (suc n)) (h : Id Base.Nat (u (inr tt)) (v (inr tt))) (q : Id (Exp n) (old n u) (old n v)) : Id (Exp (suc n)) u v =
 ext (suc n) u v (split-at n u v h q) ;
module DecideStep (n : Nat) (rec : (u v : Exp n) -> LG.Dec (Id (Exp n) u v)) (u v : Exp (suc n)) {
 inspect (h : Id Base.Nat (u (inr tt)) (v (inr tt))) : LG.Dec (Id (Exp n) (old n u) (old n v)) -> LG.Dec (Id (Exp (suc n)) u v) = split {
  yes q -> yes (split-eq n u v h q) ;
  no nq -> no (\ e -> nq (ap (old n) e)) } ;
 lower : LG.Dec (Id Base.Nat (u (inr tt)) (v (inr tt))) -> LG.Dec (Id (Exp (suc n)) u v) = split {
  yes h -> inspect h (rec (old n u) (old n v)) ;
  no nh -> no (\ e -> nh (ap (\ x -> x (inr tt)) e)) } ;
} ;
dec : (n : Nat) (u v : Exp n) -> LG.Dec (Id (Exp n) u v) = split {
 zero -> \ u v -> yes (ext zero u v (\ i -> absurd (Id Base.Nat (u i) (v i)) i)) ;
 suc n | rec -> \ u v -> DecideStep[n,rec,u,v].lower (nat-dec (u (inr tt)) (v (inr tt))) } ;
zeroE (n : Nat) : Exp n = \ i -> zero ;
bump (n : Nat) (u : Exp (suc n)) : Exp (suc n) = join n (old n u) (suc (u (inr tt))) ;
degree : (n : Nat) -> Exp n -> Base.Nat = split {
 zero -> \ u -> zero ; suc n | rec -> \ u -> NA.plus (u (inr tt)) (rec (old n u)) } ;
