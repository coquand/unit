-- Concrete rows, a three-column two-row matrix, and two successive
-- syzygy stages, over every CFN set-ring and over Z. Every theorem calls
-- the constructed generic kernel theorem; no generator is an assumption.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module CR = CubicResolution4[l] ; module PA = PolynomialAction4[l] ;
one : Base.Nat = suc zero ; three : Base.Nat = suc (suc (suc zero)) ;
five : Base.Nat = suc (suc (suc (suc (suc zero)))) ;
r1 : Nat = suc zero ; r2 : Nat = suc r1 ; r3 : Nat = suc r2 ;
pair (X : U l) (x y : X) : Ps.Fin r2 -> X = CR.pair X x y ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A]) {
 module T = HomogeneousKernel[l].Tower[K0,A,setA,cfn,r2] ; module H = T.H ; module G = T.T ;
 R : CRing = T.R ; module L = H.L ; module RL = RL[R] ;
 grading : CoefficientParts[l].Graded[A,r2,R] = G.grD r2 ;
 X : R.R = grading.var (inl (inr tt)) ; Y : R.R = grading.var (inr tt) ;
 hx : L.Hom (pos one) X = grading.var-hom (inl (inr tt)) ;
 hy : L.Hom (pos one) Y = grading.var-hom (inr tt) ;
 cube (x : R.R) : R.R = R.mul (R.mul x x) x ;
 hc (x : R.R) (h : L.Hom (pos one) x) : L.Hom (pos three) (cube x) = L.hom-mul _ _ _ _ (L.hom-mul _ _ _ _ h h) h ;
 zc (j : Ps.Fin r1) : Base.Nat = zero ;
 dc (i : Ps.Fin r2) : Base.Nat = three ; dr (i : Ps.Fin r2) : Base.Nat = one ;
 cubic (i : Ps.Fin r2) (j : Ps.Fin r1) : R.R = pair R.R (cube X) (cube Y) i ;
 h-cubic (i : Ps.Fin r2) (j : Ps.Fin r1) : L.Hom (PA.minus (pos (dc i)) (zc j)) (cubic i j) =
  CR.pair-ind (\ i -> L.Hom (pos three) (pair R.R (cube X) (cube Y) i)) (hc X hx) (hc Y hy) i ;
 nonmonomial (i : Ps.Fin r2) (j : Ps.Fin r1) : R.R = pair R.R (R.add (cube X) (cube Y)) (cube Y) i ;
 h-nonmonomial (i : Ps.Fin r2) (j : Ps.Fin r1) : L.Hom (PA.minus (pos (dc i)) (zc j)) (nonmonomial i j) =
  CR.pair-ind (\ i -> L.Hom (pos three) (pair R.R (R.add (cube X) (cube Y)) (cube Y) i)) (L.hom-add _ _ _ (hc X hx) (hc Y hy)) (hc Y hy) i ;
 repeated (i : Ps.Fin r2) (j : Ps.Fin r1) : R.R = X ;
 h-repeated (i : Ps.Fin r2) (j : Ps.Fin r1) : L.Hom (PA.minus (pos (dr i)) (zc j)) (repeated i j) = hx ;
 dz (i : Ps.Fin r1) : Base.Nat = five ;
 zero-matrix (i j : Ps.Fin r1) : R.R = R.z ;
 h-zero (i j : Ps.Fin r1) : L.Hom (PA.minus (pos (dz i)) (zc j)) (zero-matrix i j) = L.hom-zero (pos five) ;
 de (i : Ps.Fin zero) : Base.Nat = absurd Base.Nat i ;
 empty (i : Ps.Fin zero) (j : Ps.Fin r1) : R.R = absurd R.R i ;
 h-empty (i : Ps.Fin zero) (j : Ps.Fin r1) : L.Hom (PA.minus (pos (de i)) (zc j)) (empty i j) = absurd (L.Hom (PA.minus (pos (de i)) (zc j)) (empty i j)) i ;
 -- A genuine matrix S^3 -> S^2, with columns (X,0),(Y,X),(0,Y).
 dm (i : Ps.Fin r3) : Base.Nat = one ; cm (j : Ps.Fin r2) : Base.Nat = zero ;
 m-tail : Ps.Fin r2 -> H.Vec r2 = pair (H.Vec r2) (pair R.R X R.z) (pair R.R Y X) ;
 multiple : Ps.Fin r3 -> H.Vec r2 = split { inl i -> m-tail i ; inr u -> pair R.R R.z Y } ;
 h-tail (i : Ps.Fin r2) : (j : Ps.Fin r2) -> L.Hom (pos one) (m-tail i j) =
  CR.pair-ind (\ i -> (j : Ps.Fin r2) -> L.Hom (pos one) (m-tail i j))
   (CR.pair-ind (\ j -> L.Hom (pos one) (pair R.R X R.z j)) hx (L.hom-zero _))
   (CR.pair-ind (\ j -> L.Hom (pos one) (pair R.R Y X j)) hy hx) i ;
 h-multiple : (i : Ps.Fin r3) (j : Ps.Fin r2) -> L.Hom (PA.minus (pos (dm i)) (cm j)) (multiple i j) = split {
  inl i -> h-tail i ; inr u -> CR.pair-ind (\ j -> L.Hom (pos one) (pair R.R R.z Y j)) (L.hom-zero _) hy } ;
 module C = T.Input[r2,r1,dc,zc,cubic,h-cubic] ;
 module N = T.Input[r2,r1,dc,zc,nonmonomial,h-nonmonomial] ;
 module E = T.Input[r2,r1,dr,zc,repeated,h-repeated] ;
 module Z = T.Input[r1,r1,dz,zc,zero-matrix,h-zero] ;
 module V = T.Input[zero,r1,de,zc,empty,h-empty] ;
 module M = T.Input[r3,r2,dm,cm,multiple,h-multiple] ;
 cubic-gens : Tr.Trunc[C.M.Data].carrier = C.generators ;
 nonmonomial-gens : Tr.Trunc[N.M.Data].carrier = N.generators ;
 repeated-gens : Tr.Trunc[E.M.Data].carrier = E.generators ;
 zero-gens : Tr.Trunc[Z.M.Data].carrier = Z.generators ;
 empty-gens : Tr.Trunc[V.M.Data].carrier = V.generators ;
 matrix-gens : Tr.Trunc[M.M.Data].carrier = M.generators ;
 module St = HomogeneousStages[l].Tower[K0,A,setA,cfn,r2] ;
 state : St.State = (r3,(r2,(dm,(cm,(multiple,h-multiple))))) ;
 two-stages : Tr.Trunc[St.Initial (suc (suc zero)) state].carrier = St.initial (suc (suc zero)) state ;
 -- Nonzero concrete syzygy (-1,1) of the repeated-generator row.
 syz : H.Vec r2 = pair R.R (R.neg R.o) R.o ;
 h-one : L.Hom (pos zero) R.o = L.hom-one ;
 h-neg-one : L.Hom (pos zero) (R.neg R.o) = trans (L.pr-neg (pos zero) R.o) (ap R.neg h-one) ;
 syz-hom : H.HomV r2 dr (pos one) syz =
  CR.pair-ind (\ i -> L.Hom (pos zero) (syz i)) h-neg-one h-one ;
 syz-zero : E.M.Syz syz = H.F[r1].V.ext _ _ (\ j ->
  trans (H.F[r1].V.comb-at r2 syz repeated j)
   (trans (ap (R.add (R.mul R.o X)) (R.addZ (R.mul (R.neg R.o) X)))
    (trans (L.DL.G.cong-add (RL.one-left X) (trans (RL.neg-mul-left R.o X) (ap R.neg (RL.one-left X)))) (R.addN X)))) ;
 module Lift (w : E.M.Data) {
  p : Nat = w.1 ; e : Ps.Fin p -> Base.Nat = w.2.1 ; h : Ps.Fin p -> H.Vec r2 = w.2.2.1 ;
  witness : Tr.Trunc[(z : H.Vec p) * (H.HomV p e (pos one) z * Id (H.Vec r2) (H.F[r2].V.VS.comb p z h) syz)].carrier =
   w.2.2.2.2.2.2 (pos one) syz syz-hom syz-zero ;
 } ;
 repeated-lift : Tr.Trunc[(w : E.M.Data) * Tr.Trunc[(z : H.Vec w.1) *
  (H.HomV w.1 w.2.1 (pos one) z * Id (H.Vec r2) (H.F[r2].V.VS.comb w.1 z w.2.2.1) syz)].carrier].carrier =
  TC.map E.M.Data ((w : E.M.Data) * Tr.Trunc[(z : H.Vec w.1) * (H.HomV w.1 w.2.1 (pos one) z * Id (H.Vec r2) (H.F[r2].V.VS.comb w.1 z w.2.2.1) syz)].carrier) (\ w -> (w,Lift[w].witness)) E.generators ;
 -- Both target rank zero and negative shifted coefficient degrees.
 c0 (j : Ps.Fin zero) : Base.Nat = absurd Base.Nat j ;
 target0 (i : Ps.Fin r2) (j : Ps.Fin zero) : R.R = absurd R.R j ;
 h-target0 (i : Ps.Fin r2) (j : Ps.Fin zero) : L.Hom (PA.minus (pos (dr i)) (c0 j)) (target0 i j) =
  absurd (L.Hom (PA.minus (pos (dr i)) (c0 j)) (target0 i j)) j ;
 module T0 = T.Input[r2,zero,dr,c0,target0,h-target0] ;
 target0-gens : Tr.Trunc[T0.M.Data].carrier = T0.generators ;
 yzero (i : Ps.Fin r2) : R.R = R.z ;
 yzero-hom : H.HomV r2 dr (negsuc zero) yzero = \ i -> L.hom-zero (PA.minus (negsuc zero) one) ;
 yzero-syz : E.M.Syz yzero = H.F[r1].V.VS.comb-zero r2 repeated ;
 module Negative (w : E.M.Data) {
  witness : Tr.Trunc[(z : H.Vec w.1) * (H.HomV w.1 w.2.1 (negsuc zero) z * Id (H.Vec r2) (H.F[r2].V.VS.comb w.1 z w.2.2.1) yzero)].carrier =
   w.2.2.2.2.2.2 (negsuc zero) yzero yzero-hom yzero-syz ;
 } ;
 negative-lift : Tr.Trunc[(w : E.M.Data) * Tr.Trunc[(z : H.Vec w.1) * (H.HomV w.1 w.2.1 (negsuc zero) z * Id (H.Vec r2) (H.F[r2].V.VS.comb w.1 z w.2.2.1) yzero)].carrier].carrier =
  TC.map E.M.Data ((w : E.M.Data) * Tr.Trunc[(z : H.Vec w.1) * (H.HomV w.1 w.2.1 (negsuc zero) z * Id (H.Vec r2) (H.F[r2].V.VS.comb w.1 z w.2.2.1) yzero)].carrier) (\ w -> (w,Negative[w].witness)) E.generators ;

} ;
module OverZ {
 module Z = Over[Nat * Nat,ZRing[l].ring,int-set,ZCFN[l].cfn] ;
 matrix-gens : Tr.Trunc[Z.M.M.Data].carrier = Z.matrix-gens ;
 two-stages : Tr.Trunc[Z.St.Initial (suc (suc zero)) Z.state].carrier = Z.two-stages ;
} ;
