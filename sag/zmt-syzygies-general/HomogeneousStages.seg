-- HomogeneousStages: any prescribed finite initial sequence of homogeneous
-- syzygy matrices exists merely. At each successor step the checked kernel
-- construction supplies the next finite free module and matrix. Exactness
-- and all integer-degree lifts are retained in the Data at every step.
-- This is finite iteration, not termination or a bound on resolution length.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module PA = PolynomialAction4[l] ;

module Tower (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A]) (t : Nat) {
 module T = HomogeneousKernel[l].Tower[K0,A,setA,cfn,t] ; module H = T.H ;
 State : U l = (a : Nat) * ((r : Nat) * ((d : Ps.Fin a -> Base.Nat) * ((c : Ps.Fin r -> Base.Nat) *
  ((m : Ps.Fin a -> H.Vec r) * ((i : Ps.Fin a) (j : Ps.Fin r) -> H.L.Hom (PA.minus (pos (d i)) (c j)) (m i j)))))) ;
 module At (s : State) {
  a : Nat = s.1 ; r : Nat = s.2.1 ; d : Ps.Fin a -> Base.Nat = s.2.2.1 ; c : Ps.Fin r -> Base.Nat = s.2.2.2.1 ;
  m : Ps.Fin a -> H.Vec r = s.2.2.2.2.1 ;
  hm : (i : Ps.Fin a) (j : Ps.Fin r) -> H.L.Hom (PA.minus (pos (d i)) (c j)) (m i j) = s.2.2.2.2.2 ;
  module I = T.Input[a,r,d,c,m,hm] ; module M = I.M ;
 } ;
 next (s : State) (w : At[s].M.Data) : State = (w.1,(At[s].a,(w.2.1,(At[s].d,(w.2.2.1,w.2.2.2.1))))) ;
 Initial : Nat -> State -> U l = split {
  zero -> \ s -> Top ;
  suc n | rec -> \ s -> (w : At[s].M.Data) * rec (next s w) } ;
 Goal (n : Nat) : U l = (s : State) -> Tr.Trunc[Initial n s].carrier ;
 module Step (n : Nat) (ih : Goal n) (s : State) {
  goal : Tr.Trunc[Initial (suc n) s].carrier =
   TC.bind (At[s].M.Data) (Initial (suc n) s)
    (\ w -> TC.map (Initial n (next s w)) (Initial (suc n) s) (\ tail -> (w,tail)) (ih (next s w))) At[s].I.generators ;
 } ;
 initial : (n : Nat) -> Goal n = split {
  zero -> \ s -> Tr.Trunc[Top].inc tt ;
  suc n | rec -> \ s -> Step[n,rec,s].goal } ;
} ;
