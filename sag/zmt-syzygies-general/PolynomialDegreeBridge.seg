-- Degree bridge: the tower grading agrees with total exponent degree.
-- Every scalar monomial is homogeneous; filtering an ordinary term list
-- by any integer total degree computes its grading projection. Negative
-- parts are included. Coefficients and ring elements are never tested.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module E = FiniteExponents[l] ; module NA = NatArith[l] ;
module CP = CoefficientParts[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module P = PolynomialTowerBridge[l].Over[A,setA] ; module T = P.T ;
 module At (n : Nat) { module L = CP.Laws[A,n,T.D n,T.setD n,T.grD n] ; } ;
 module Step (n : Nat) {
  module S = CoefficientPolynomial[l].GradingStep[A,setA,n,T.D n,T.setD n,T.grD n] ;
  module M = P.Level[n] ; module L = At[suc n].L ;
  mono-hom (d : Base.Nat) (c : (T.D n).R) (hc : At[n].L.Hom (pos d) c) : (e : Base.Nat) ->
   L.Hom (pos (NA.plus e d)) (M.mono c e) = split {
   zero -> trans (S.pr-const (pos d) c) (ap S.E.constant hc) ;
   suc e | rec -> subst (L.Hom (pos (suc (NA.plus e d)))) ((T.D (suc n)).mulC (M.mono c e) S.E.variable)
    (L.hom-mul (pos (NA.plus e d)) (pos (suc zero)) (M.mono c e) S.E.variable rec (S.var-hom (inr tt))) } ;
 } ;
 HomGoal (n : Nat) : U l = (p : P.Term n) -> At[n].L.Hom (pos (E.degree n p.2)) (P.term n p) ;
 term-hom : (n : Nat) -> HomGoal n = split {
  zero -> \ p -> (T.grD zero).iota-hom p.1 ;
  suc n | rec -> \ p -> Step[n].mono-hom (E.degree n (E.old n p.2)) (P.term n (p.1,E.old n p.2)) (rec (p.1,E.old n p.2)) (p.2 (inr tt)) } ;
 module Filter (n : Nat) (k : Int) {
  keep (p : P.Term n) (ps : List (P.Term n)) : LG.Dec (Id Int (pos (E.degree n p.2)) k) -> List (P.Term n) = split {
   yes h -> cons p ps ; no nh -> ps } ;
  parts : List (P.Term n) -> List (P.Term n) = split {
   nil -> nil ; cons p ps | rec -> keep p rec (int-dec (pos (E.degree n p.2)) k) } ;
  step (p : P.Term n) (ps : List (P.Term n))
   (rec : Id (T.D n).R ((T.grD n).pr k (P.phi n ps)) (P.phi n (parts ps))) :
   (d : LG.Dec (Id Int (pos (E.degree n p.2)) k)) ->
    Id (T.D n).R ((T.D n).add ((T.grD n).pr k (P.term n p)) ((T.grD n).pr k (P.phi n ps))) (P.phi n (keep p (parts ps) d)) = split {
   yes h -> At[n].L.DL.G.cong-add
     (trans (ap (\ e -> (T.grD n).pr e (P.term n p)) (sym h)) (term-hom n p)) rec ;
   no nh -> trans (At[n].L.DL.G.cong-add
      (At[n].L.hom-other k (pos (E.degree n p.2)) (P.term n p) (term-hom n p) (\ h -> Pr.absurd Empty (nh (sym h)))) rec)
     (At[n].L.L.zl (P.phi n (parts ps))) } ;
  projection : (ps : List (P.Term n)) -> Id (T.D n).R ((T.grD n).pr k (P.phi n ps)) (P.phi n (parts ps)) = split {
   nil -> At[n].L.pr-zero k ;
   cons p ps | rec -> trans ((T.grD n).pr-add k (P.term n p) (P.phi n ps)) (step p ps rec (int-dec (pos (E.degree n p.2)) k)) } ;
  -- The projection has the same finite coefficient function as its filtered
  -- term list; this is the explicit comparison used by coefficient clients.
  coefficient (ps : List (P.Term n)) (v : E.Exp n) :
   Id A.R (P.Coeff n ((T.grD n).pr k (P.phi n ps)) v) (P.cf n (parts ps) v) =
   trans (ap (\ x -> P.Coeff n x v) (projection ps)) (P.coeff-phi n (parts ps) v) ;
 } ;
} ;
