-- Ordinary exponent bridges at zero and two variables. A repeated support
-- exponent contributes once, by the proved duplicate-removing construction.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module E = FiniteExponents[l] ; module FP = FinitePolynomial4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module P = PolynomialTowerBridge[l].Over[A,setA] ; module D = PolynomialDegreeBridge[l].Over[A,setA] ;
 r2 : Nat = suc (suc zero) ;
 exponent : E.Exp r2 = E.join (suc zero) (E.join zero (E.zeroE zero) (suc (suc (suc zero)))) zero ;
 p : List (P.Term r2) = cons (A.o,exponent) nil ;
 cubic-coeff : Id A.R (P.Coeff r2 (P.phi r2 p) exponent) A.o =
  trans (P.coeff-phi r2 p exponent)
   (trans (A.addZ (FP.sel A A.o (Id (E.Exp r2) exponent exponent) (E.dec r2 exponent exponent)))
    (FP.sel-yes A A.o (Id (E.Exp r2) exponent exponent) (refl exponent) (E.dec r2 exponent exponent))) ;
 cubic-degree : D.At[r2].L.Hom (pos (suc (suc (suc zero)))) (P.term r2 (A.o,exponent)) = D.term-hom r2 (A.o,exponent) ;
 base-coeff (a : A.R) (v : E.Exp zero) : Id A.R (P.Coeff zero a v) a = refl a ;
 zero-variables (a : A.R) : Tr.Trunc[P.Reps[zero].Rep a].carrier = P.rep zero a ;
 module RepeatedSupport {
  f (v : E.Exp r2) : A.R = FP.sel A A.o (Id (E.Exp r2) exponent v) (E.dec r2 exponent v) ;
  module S = P.Supported[r2,f] ;
  support : List (E.Exp r2) = cons exponent (cons exponent nil) ;
  outside (v : E.Exp r2) (h : S.LE.Mem v support -> Empty) : Id A.R (f v) A.z =
   FP.sel-no A A.o (Id (E.Exp r2) exponent v) (\ eq -> h (inl eq)) (E.dec r2 exponent v) ;
  representation : (x : (P.T.D r2).R) * ((v : E.Exp r2) -> Id A.R (P.Coeff r2 x v) (f v)) = S.represent support outside ;
  counted-once : Id A.R (P.Coeff r2 representation.1 exponent) A.o =
   trans (representation.2 exponent) (FP.sel-yes A A.o (Id (E.Exp r2) exponent exponent) (refl exponent) (E.dec r2 exponent exponent)) ;
 } ;
} ;
module OverZ {
 module Z = Over[ZRing[l].ring,int-set] ;
 counted-once : Id ZRing[l].ring.R (Z.P.Coeff Z.r2 Z.RepeatedSupport.representation.1 Z.exponent) ZRing[l].ring.o = Z.RepeatedSupport.counted-once ;
} ;
