-- ReesVec.seg: homogeneous pieces, theta_n, Q_n, Split(c), and Artin-Rees
-- from Split(c) (artin-rees.tex §5.1; R-modules only).
--
-- Informal proof.  Let I = (a,b), N = span ns in M.  A homogeneous
-- polynomial of degree n in U, V over M is a sequence g vanishing from
-- n + 1 on (U = 1).  theta_n is IdealPowers.Over.hsum:
--   theta_0 g = g_0,   theta_(n+1) g = a theta_n g + b^(n+1) g_(n+1),
-- and Q_n = { g | g vanishes from n + 1 on, theta_n g in N }.
-- Lemma theta.  (i) theta_n is linear (hsum-add, hsum-sm, hsum-zero).
--   (ii) if g_(n+1) = 0, theta_(n+1) g = a theta_n g (hsum-top).
--   (iii) theta_(n+1) (X q) = b theta_n q (hsum-X), by induction on n:
--   theta_1 (X q) = a 0 + b q_0, and
--   theta_(n+2) (X q) = a b theta_n q + b^(n+2) q_(n+1) = b theta_(n+1) q.
--   (v) theta_(n+1) g = a^(n+1) g_0 + b theta_n (g . suc) (hsum-shift).
--   (ii)+(iii): theta_(n+1) (p + X q) = a theta_n p + b theta_n q when
--   p_(n+1) = 0 (hsum-step).
--   (iv) x in I^n M iff x = theta_n g for some g vanishing from n + 1 on:
--   "if" is IdealPowers.homogeneous; "only if" (pow-hsum) by induction,
--   with g = g1 + X g2 for x = a x1 + b x2 (hsum-step).
--   Hence Q_n is a submodule, Q_n in Q_(n+1) (q-up) and X Q_n in Q_(n+1)
--   (q-X).
-- Split(c): for every n >= c (n = m + c) and g in Q_(n+1), merely
--   g = p + X q with p, q in Q_n (Halves).  The halves of g form a
--   submodule (halves-zero, -add, -sm); g = p + X 0 and g = 0 + X q
--   (halves-p, halves-q).
-- Lemma split-ar.  If Split(c), then x in I^(m+c) M cap N gives, merely,
--   x in I^m (I^c M cap N).  By (iv), x = theta_(m+c) g with g in
--   Q_(m+c); induction on m for all such g: for m = 0, theta_c g is in
--   I^c M (homogeneous) and in N; otherwise g = p + X q with p, q in
--   Q_(m-1+c), theta_(m+c) g = a theta p + b theta q (hsum-step), and the
--   induction hypothesis applies to p and q (ar-q, artin-rees-at).
-- The converse inclusion I^m (I^c M cap N) in I^(m+c) M cap N is
--   immediate (compose).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

module Over (A : CRing) (Md : IP.Mod[A]) (a b : A.R) (ns : List Md.M) {
  open Md ; module ML = IP.ModL[A,Md] ;
  module SQ = SeqPoly[l].Over[A,Md] ;
  module PM = IP.Over[A,Md,a,b] ;
  module MS = Spans[l].Over[A,Md] ; module OB = Saturation[l].SpanOps[A,Md] ;

  ------------------------------------------------------------------------
  -- Lemma theta

  -- b^n x is linear in x
  bs-add : (n : Nat) (x y : M) -> Id M (PM.bs n (madd x y)) (madd (PM.bs n x) (PM.bs n y)) = split {
    zero -> \ x y -> refl (madd x y) ;
    suc n | r -> \ x y -> trans (ap (sm b) (r x y)) (smD b (PM.bs n x) (PM.bs n y)) } ;
  bs-sm : (n : Nat) (c : A.R) (x : M) -> Id M (PM.bs n (sm c x)) (sm c (PM.bs n x)) = split {
    zero -> \ c x -> refl (sm c x) ;
    suc n | r -> \ c x -> trans (ap (sm b) (r c x)) (ML.sm-comm b c (PM.bs n x)) } ;
  bs-zero : (n : Nat) -> Id M (PM.bs n mz) mz = split {
    zero -> refl mz ;
    suc n | r -> trans (ap (sm b) r) (ML.sm-zero b) } ;

  -- (i)
  hsum-add : (n : Nat) (g g' : SQ.Seq) ->
    Id M (PM.hsum n (SQ.seq.madd g g')) (madd (PM.hsum n g) (PM.hsum n g')) = split {
    zero -> \ g g' -> refl (madd (g zero) (g' zero)) ;
    suc n | r -> \ g g' ->
      trans (ML.G.cong-add (trans (ap (sm a) (r g g')) (smD a (PM.hsum n g) (PM.hsum n g')))
                           (bs-add (suc n) (g (suc n)) (g' (suc n))))
            (ML.G.swap (sm a (PM.hsum n g)) (sm a (PM.hsum n g'))
                       (PM.bs (suc n) (g (suc n))) (PM.bs (suc n) (g' (suc n)))) } ;
  hsum-sm : (n : Nat) (c : A.R) (g : SQ.Seq) -> Id M (PM.hsum n (SQ.seq.sm c g)) (sm c (PM.hsum n g)) = split {
    zero -> \ c g -> refl (sm c (g zero)) ;
    suc n | r -> \ c g ->
      trans (ML.G.cong-add (trans (ap (sm a) (r c g)) (ML.sm-comm a c (PM.hsum n g)))
                           (bs-sm (suc n) c (g (suc n))))
            (sym (smD c (sm a (PM.hsum n g)) (PM.bs (suc n) (g (suc n))))) } ;
  hsum-zero : (n : Nat) -> Id M (PM.hsum n SQ.seq.mz) mz = split {
    zero -> refl mz ;
    suc n | r -> trans (ML.G.cong-add (trans (ap (sm a) r) (ML.sm-zero a)) (bs-zero (suc n))) (maddZ mz) } ;

  -- the coefficient of degree k of a sequence vanishing from k on
  van-at (k : Nat) (g : SQ.Seq) (h : SQ.Van k g) : Id M (g k) mz =
    subst (\ i -> Id M (g i) mz) (plus-zero k) (h zero) ;

  -- (ii)
  hsum-top (n : Nat) (g : SQ.Seq) (h : Id M (g (suc n)) mz) : Id M (PM.hsum (suc n) g) (sm a (PM.hsum n g)) =
    trans (ap (madd (sm a (PM.hsum n g))) (trans (ap (PM.bs (suc n)) h) (bs-zero (suc n))))
          (maddZ (sm a (PM.hsum n g))) ;

  -- (iii)
  hsum-X : (n : Nat) (q : SQ.Seq) -> Id M (PM.hsum (suc n) (SQ.Xs q)) (sm b (PM.hsum n q)) = split {
    zero -> \ q -> trans (ap (\ t -> madd t (sm b (q zero))) (ML.sm-zero a)) (ML.G.zl (sm b (q zero))) ;
    suc n | r -> \ q ->
      calc M { PM.hsum (suc (suc n)) (SQ.Xs q)
                 =< ap (\ t -> madd (sm a t) (PM.bs (suc (suc n)) (q (suc n)))) (r q) >
               madd (sm a (sm b (PM.hsum n q))) (sm b (PM.bs (suc n) (q (suc n))))
                 =< ap (\ t -> madd t (sm b (PM.bs (suc n) (q (suc n))))) (ML.sm-comm a b (PM.hsum n q)) >
               madd (sm b (sm a (PM.hsum n q))) (sm b (PM.bs (suc n) (q (suc n))))
                 =< sym (smD b (sm a (PM.hsum n q)) (PM.bs (suc n) (q (suc n)))) >
               sm b (PM.hsum (suc n) q) } } ;

  -- (v) theta_(n+1) g = a^(n+1) g_0 + b theta_n (g . suc), by induction on n
  as : Nat -> M -> M = split {
    zero -> \ x -> x ;
    suc n | r -> \ x -> sm a (r x) } ;
  hsum-shift : (n : Nat) (g : SQ.Seq) ->
    Id M (PM.hsum (suc n) g) (madd (as (suc n) (g zero)) (sm b (PM.hsum n (\ j -> g (suc j))))) = split {
    zero -> \ g -> refl (madd (sm a (g zero)) (sm b (g (suc zero)))) ;
    suc n | r -> \ g ->
      calc M { PM.hsum (suc (suc n)) g
                 =< ap (\ t -> madd (sm a t) (PM.bs (suc (suc n)) (g (suc (suc n))))) (r g) >
               madd (sm a (madd (as (suc n) (g zero)) (sm b (PM.hsum n (\ j -> g (suc j))))))
                    (sm b (PM.bs (suc n) (g (suc (suc n)))))
                 =< ap (\ t -> madd t (sm b (PM.bs (suc n) (g (suc (suc n))))))
                       (smD a (as (suc n) (g zero)) (sm b (PM.hsum n (\ j -> g (suc j))))) >
               madd (madd (as (suc (suc n)) (g zero)) (sm a (sm b (PM.hsum n (\ j -> g (suc j))))))
                    (sm b (PM.bs (suc n) (g (suc (suc n)))))
                 =< sym (maddA (as (suc (suc n)) (g zero)) (sm a (sm b (PM.hsum n (\ j -> g (suc j)))))
                               (sm b (PM.bs (suc n) (g (suc (suc n)))))) >
               madd (as (suc (suc n)) (g zero))
                    (madd (sm a (sm b (PM.hsum n (\ j -> g (suc j))))) (sm b (PM.bs (suc n) (g (suc (suc n))))))
                 =< ap (\ t -> madd (as (suc (suc n)) (g zero)) (madd t (sm b (PM.bs (suc n) (g (suc (suc n)))))))
                       (ML.sm-comm a b (PM.hsum n (\ j -> g (suc j)))) >
               madd (as (suc (suc n)) (g zero))
                    (madd (sm b (sm a (PM.hsum n (\ j -> g (suc j))))) (sm b (PM.bs (suc n) (g (suc (suc n))))))
                 =< ap (madd (as (suc (suc n)) (g zero)))
                       (sym (smD b (sm a (PM.hsum n (\ j -> g (suc j)))) (PM.bs (suc n) (g (suc (suc n)))))) >
               madd (as (suc (suc n)) (g zero)) (sm b (PM.hsum (suc n) (\ j -> g (suc j)))) } } ;

  -- (ii) and (iii): theta_(n+1) (p + X q) = a theta_n p + b theta_n q
  hsum-step (n : Nat) (p q : SQ.Seq) (hp : Id M (p (suc n)) mz) :
    Id M (PM.hsum (suc n) (SQ.seq.madd p (SQ.Xs q))) (madd (sm a (PM.hsum n p)) (sm b (PM.hsum n q))) =
    trans (hsum-add (suc n) p (SQ.Xs q)) (ML.G.cong-add (hsum-top n p hp) (hsum-X n q)) ;

  -- (iv), "only if"
  record HForm (n : Nat) (x : M) {
    g : SQ.Seq ;
    g-van : SQ.Van (suc n) g ;
    g-eq : Id M x (PM.hsum n g) ;
  } ;
  hform-step (n : Nat) (x : M) (h : PM.Pow (suc n) x) (w1 : HForm[n, h.1]) (w2 : HForm[n, h.2.1]) : HForm[suc n, x] =
    mkHForm (suc n) x (SQ.seq.madd w1.g (SQ.Xs w2.g))
      (SQ.van-add (suc (suc n)) w1.g (SQ.Xs w2.g) (SQ.van-up (suc n) w1.g w1.g-van) (\ j -> w2.g-van j))
      (trans h.2.2.2.2
        (trans (ML.G.cong-add (ap (sm a) w1.g-eq) (ap (sm b) w2.g-eq))
               (sym (hsum-step n w1.g w2.g (van-at (suc n) w1.g w1.g-van))))) ;
  pow-hsum : (n : Nat) (x : M) -> PM.Pow n x -> HForm[n, x] = split {
    zero -> \ x h -> mkHForm zero x (SQ.cst x) (SQ.van-emb (suc zero) (\ i -> x)) (refl x) ;
    suc n | r -> \ x h -> hform-step n x h (r h.1 h.2.2.1) (r h.2.1 h.2.2.2.1) } ;

  ------------------------------------------------------------------------
  -- Q_n

  record Q (n : Nat) (g : SQ.Seq) {
    van : SQ.Van (suc n) g ;
    inN : MS.Mm ns (PM.hsum n g) ;
  } ;

  q-zero (n : Nat) : Q[n, SQ.seq.mz] =
    mkQ n SQ.seq.mz (SQ.van-zero (suc n))
      (OB.mm-cong ns mz (PM.hsum n SQ.seq.mz) (sym (hsum-zero n)) (OB.mm-zero ns)) ;
  q-add (n : Nat) (g g' : SQ.Seq) (qg : Q[n, g]) (qg' : Q[n, g']) : Q[n, SQ.seq.madd g g'] =
    mkQ n (SQ.seq.madd g g') (SQ.van-add (suc n) g g' qg.van qg'.van)
      (OB.mm-cong ns (madd (PM.hsum n g) (PM.hsum n g')) (PM.hsum n (SQ.seq.madd g g')) (sym (hsum-add n g g'))
        (OB.mm-add ns (PM.hsum n g) (PM.hsum n g') qg.inN qg'.inN)) ;
  q-sm (n : Nat) (c : A.R) (g : SQ.Seq) (qg : Q[n, g]) : Q[n, SQ.seq.sm c g] =
    mkQ n (SQ.seq.sm c g) (SQ.van-sm (suc n) c g qg.van)
      (OB.mm-cong ns (sm c (PM.hsum n g)) (PM.hsum n (SQ.seq.sm c g)) (sym (hsum-sm n c g))
        (OB.mm-sm ns c (PM.hsum n g) qg.inN)) ;
  q-up (n : Nat) (g : SQ.Seq) (qg : Q[n, g]) : Q[suc n, g] =
    mkQ (suc n) g (SQ.van-up (suc n) g qg.van)
      (OB.mm-cong ns (sm a (PM.hsum n g)) (PM.hsum (suc n) g) (sym (hsum-top n g (van-at (suc n) g qg.van)))
        (OB.mm-sm ns a (PM.hsum n g) qg.inN)) ;
  q-X (n : Nat) (q : SQ.Seq) (qq : Q[n, q]) : Q[suc n, SQ.Xs q] =
    mkQ (suc n) (SQ.Xs q) (\ j -> qq.van j)
      (OB.mm-cong ns (sm b (PM.hsum n q)) (PM.hsum (suc n) (SQ.Xs q)) (sym (hsum-X n q))
        (OB.mm-sm ns b (PM.hsum n q) qq.inN)) ;

  ------------------------------------------------------------------------
  -- Split(c)

  record Halves (n : Nat) (g : SQ.Seq) {
    p : SQ.Seq ;
    q : SQ.Seq ;
    p-in : Q[n, p] ;
    q-in : Q[n, q] ;
    eq : Id SQ.Seq g (SQ.seq.madd p (SQ.Xs q)) ;
  } ;
  Split (c : Nat) : U l = (m : Nat) (g : SQ.Seq) -> Q[suc (plus m c), g] -> Tr.Trunc[Halves[plus m c, g]].carrier ;

  -- the halves of g form a submodule; g = p + X 0 and g = 0 + X q
  module SL = IP.ModL[A,SQ.seq] ;
  xs-zero-at : (j : Nat) -> Id M (SQ.Xs SQ.seq.mz j) mz = split { zero -> refl mz ; suc j -> refl mz } ;
  xs-zero : Id SQ.Seq (SQ.Xs SQ.seq.mz) SQ.seq.mz = SQ.sext _ _ xs-zero-at ;
  halves-zero (n : Nat) : Halves[n, SQ.seq.mz] =
    mkHalves n SQ.seq.mz SQ.seq.mz SQ.seq.mz (q-zero n) (q-zero n)
      (sym (trans (ap (SQ.seq.madd SQ.seq.mz) xs-zero) (SQ.seq.maddZ SQ.seq.mz))) ;
  halves-add (n : Nat) (g g' : SQ.Seq) (w : Halves[n, g]) (w' : Halves[n, g']) : Halves[n, SQ.seq.madd g g'] =
    mkHalves n (SQ.seq.madd g g') (SQ.seq.madd w.p w'.p) (SQ.seq.madd w.q w'.q)
      (q-add n w.p w'.p w.p-in w'.p-in) (q-add n w.q w'.q w.q-in w'.q-in)
      (trans (SL.G.cong-add w.eq w'.eq)
        (trans (SL.G.swap w.p (SQ.Xs w.q) w'.p (SQ.Xs w'.q))
          (ap (SQ.seq.madd (SQ.seq.madd w.p w'.p)) (sym (SQ.xs-add' w.q w'.q))))) ;
  halves-sm (n : Nat) (c : A.R) (g : SQ.Seq) (w : Halves[n, g]) : Halves[n, SQ.seq.sm c g] =
    mkHalves n (SQ.seq.sm c g) (SQ.seq.sm c w.p) (SQ.seq.sm c w.q)
      (q-sm n c w.p w.p-in) (q-sm n c w.q w.q-in)
      (trans (ap (SQ.seq.sm c) w.eq)
        (trans (SQ.seq.smD c w.p (SQ.Xs w.q)) (ap (SQ.seq.madd (SQ.seq.sm c w.p)) (sym (SQ.xs-sm' c w.q))))) ;
  halves-p (n : Nat) (g p : SQ.Seq) (e : Id SQ.Seq g p) (qp : Q[n, p]) : Halves[n, g] =
    mkHalves n g p SQ.seq.mz qp (q-zero n)
      (trans e (sym (trans (ap (SQ.seq.madd p) xs-zero) (SQ.seq.maddZ p)))) ;
  halves-q (n : Nat) (g q : SQ.Seq) (e : Id SQ.Seq g (SQ.Xs q)) (qq : Q[n, q]) : Halves[n, g] =
    mkHalves n g SQ.seq.mz q (q-zero n) qq (trans e (sym (SL.G.zl (SQ.Xs q)))) ;

  -- theta_(n+1) g = a theta_n p + b theta_n q
  halves-hsum (n : Nat) (g : SQ.Seq) (w : Halves[n, g]) :
    Id M (PM.hsum (suc n) g) (madd (sm a (PM.hsum n w.p)) (sm b (PM.hsum n w.q))) =
    trans (ap (PM.hsum (suc n)) w.eq) (hsum-step n w.p w.q (van-at (suc n) w.p w.p-in.van)) ;

  ------------------------------------------------------------------------
  -- Lemma split-ar

  -- I^c M cap N
  Core (c : Nat) (x : M) : U l = PM.Pow c x * MS.Mm ns x ;

  module FromSplit (c : Nat) (sp : Split c) {
    Res (m : Nat) (x : M) : U l = Tr.Trunc[PM.PowIn (Core c) m x].carrier ;

    ar-step (m : Nat) (g : SQ.Seq) (w : Halves[plus m c, g])
      (tp : Res m (PM.hsum (plus m c) w.p)) (tq : Res m (PM.hsum (plus m c) w.q)) :
      Res (suc m) (PM.hsum (suc (plus m c)) g) =
      TC.map2 (PM.PowIn (Core c) m (PM.hsum (plus m c) w.p)) (PM.PowIn (Core c) m (PM.hsum (plus m c) w.q))
        (PM.PowIn (Core c) (suc m) (PM.hsum (suc (plus m c)) g))
        (\ u v -> (PM.hsum (plus m c) w.p, (PM.hsum (plus m c) w.q, (u, (v, halves-hsum (plus m c) g w))))) tp tq ;

    ar-q : (m : Nat) (g : SQ.Seq) -> Q[plus m c, g] -> Res m (PM.hsum (plus m c) g) = split {
      zero -> \ g qg -> Tr.Trunc[Core c (PM.hsum c g)].inc (PM.homogeneous c g, qg.inN) ;
      suc m | r -> \ g qg ->
        TC.bind (Halves[plus m c, g]) (PM.PowIn (Core c) (suc m) (PM.hsum (suc (plus m c)) g))
          (\ w -> ar-step m g w (r w.p w.p-in) (r w.q w.q-in)) (sp m g qg) } ;

    -- x in I^(m+c) M cap N gives, merely, x in I^m (I^c M cap N)
    from-hform (m : Nat) (x : M) (hn : MS.Mm ns x) (w : HForm[plus m c, x]) : Res m x =
      subst (Res m) (sym w.g-eq)
        (ar-q m w.g (mkQ (plus m c) w.g w.g-van (OB.mm-cong ns x (PM.hsum (plus m c) w.g) w.g-eq hn))) ;
    artin-rees-at (m : Nat) (x : M) (hx : PM.Pow (plus m c) x) (hn : MS.Mm ns x) : Res m x =
      from-hform m x hn (pow-hsum (plus m c) x hx) ;
  } ;

  -- the easy inclusion: I^m (I^c M cap N) in I^(m+c) M cap N
  core-step (n : Nat) (x m1 m2 : M) (u : Core n m1) (v : Core n m2) (e : Id M x (madd (sm a m1) (sm b m2))) :
    Core (suc n) x =
    ((m1, (m2, (u.1, (v.1, e)))),
     OB.mm-cong ns (madd (sm a m1) (sm b m2)) x (sym e)
       (OB.mm-add ns (sm a m1) (sm b m2) (OB.mm-sm ns a m1 u.2) (OB.mm-sm ns b m2 v.2))) ;
  compose (c : Nat) : (m : Nat) (x : M) -> PM.PowIn (Core c) m x -> Core (plus m c) x = split {
    zero -> \ x h -> h ;
    suc m | r -> \ x h -> core-step (plus m c) x h.1 h.2.1 (r h.1 h.2.2.1) (r h.2.1 h.2.2.2.1) h.2.2.2.2 } ;
} ;
