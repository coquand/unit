-- XSpan.seg: the A[X]-submodule generated by finitely many sequences
-- (artin-rees.tex, §3).
--
-- For a family F_1..F_s of sequences, XS d g says that g = sum_i g_i F_i
-- with deg g_i <= d, in Ruitenburg's recursive form:
--   XS 0 g        g is an A-combination of the F_i;
--   XS (d+1) g    g = sum_i c_i F_i + X g' with XS d g'.
-- XS d is a submodule, grows with d, and X maps XS d into XS (d+1).
-- NM g: g is merely in XS d for some d, the A[X]-span itself; it is a
-- submodule closed under X and contains the F_i.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

-- the family with one coefficient 1: comb (delta i) F = F i
module Delta (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ; module S = Comb[l].Sums[A,Md] ;
  deltaS (s : Nat) (ih : Fin s -> Fin s -> A.R) : Fin (suc s) -> Fin (suc s) -> A.R = split {
    inl i -> snoc (Fin s) A.R (ih i) A.z ;
    inr t -> snoc (Fin s) A.R (\ k -> A.z) A.o } ;
  delta : (s : Nat) -> Fin s -> Fin s -> A.R = split {
    zero -> \ i k -> A.z ;
    suc s | ih -> deltaS s ih } ;
  comb-deltaS (s : Nat) (ih : (F : Fin s -> M) (i : Fin s) -> Id M (S.comb s (delta s i) F) (F i)) (F : Fin (suc s) -> M) :
    (i : Fin (suc s)) -> Id M (S.comb (suc s) (delta (suc s) i) F) (F i) = split {
    inl i -> trans (ap (\ t -> madd t (S.comb s (delta s i) (\ k -> F (inl k)))) (ML.zero-sm (F (inr tt))))
               (trans (ML.G.zl (S.comb s (delta s i) (\ k -> F (inl k)))) (ih (\ k -> F (inl k)) i)) ;
    inr t -> trans (ap (madd (sm A.o (F (inr tt)))) (S.comb-zero s (\ k -> F (inl k))))
               (trans (maddZ (sm A.o (F (inr tt))))
                 (trans (smO (F (inr tt))) (Blocks[l].top-eq M (\ t' -> F (inr t')) t))) } ;
  comb-delta : (s : Nat) (F : Fin s -> M) (i : Fin s) -> Id M (S.comb s (delta s i) F) (F i) = split {
    zero -> \ F i -> absurd (Id M (S.comb zero (delta zero i) F) (F i)) i ;
    suc s | ih -> comb-deltaS s ih } ;
} ;

module Over (A : CRing) (Md : IP.Mod[A]) (s : Nat) (F : Fin s -> SeqPoly[l].Over[A,Md].Seq) {
  module SQ = SeqPoly[l].Over[A,Md] ;
  Seq : U l = SQ.Seq ;
  Sq : IP.Mod[A] = SQ.seq ;
  module LQ = IP.ModL[A,Sq] ; module CS = Comb[l].Sums[A,Sq] ;
  Vs : U l = Fin s -> A.R ;
  cF (c : Vs) : Seq = CS.comb s c F ;
  vadd (c c' : Vs) : Vs = \ k -> A.add (c k) (c' k) ;
  vsm (a : A.R) (c : Vs) : Vs = \ k -> A.mul a (c k) ;
  vz : Vs = \ k -> A.z ;

  XS : Nat -> Seq -> U l = split {
    zero -> \ g -> (c : Vs) * Id Seq (cF c) g ;
    suc d | r -> \ g -> (c : Vs) * ((g' : Seq) * (r g' * Id Seq g (Sq.madd (cF c) (SQ.Xs g')))) } ;

  xs-mz-at : (j : Nat) -> Id Md.M (SQ.Xs Sq.mz j) Md.mz = split { zero -> refl Md.mz ; suc j -> refl Md.mz } ;
  xs-mz : Id Seq (SQ.Xs Sq.mz) Sq.mz = SQ.sext _ _ xs-mz-at ;
  -- cF 0 + X 0 = 0
  zero-dec : Id Seq Sq.mz (Sq.madd (cF vz) (SQ.Xs Sq.mz)) =
    sym (trans (LQ.G.cong-add (CS.comb-zero s F) xs-mz) (Sq.maddZ Sq.mz)) ;
  -- g = cF c + X 0
  lift-dec (c : Vs) (g : Seq) (e : Id Seq (cF c) g) : Id Seq g (Sq.madd (cF c) (SQ.Xs Sq.mz)) =
    sym (trans (ap (Sq.madd (cF c)) xs-mz) (trans (Sq.maddZ (cF c)) e)) ;
  -- X g = cF 0 + X g
  x-dec (g : Seq) : Id Seq (SQ.Xs g) (Sq.madd (cF vz) (SQ.Xs g)) =
    sym (trans (ap (\ t -> Sq.madd t (SQ.Xs g)) (CS.comb-zero s F)) (LQ.G.zl (SQ.Xs g))) ;

  xs-zero : (d : Nat) -> XS d Sq.mz = split {
    zero -> (vz, CS.comb-zero s F) ;
    suc d | r -> (vz, (Sq.mz, (r, zero-dec))) } ;

  add-dec (g g' g1 g1' : Seq) (c c' : Vs)
    (e : Id Seq g (Sq.madd (cF c) (SQ.Xs g1))) (e' : Id Seq g' (Sq.madd (cF c') (SQ.Xs g1'))) :
    Id Seq (Sq.madd g g') (Sq.madd (cF (vadd c c')) (SQ.Xs (Sq.madd g1 g1'))) =
    trans (LQ.G.cong-add e e')
      (trans (LQ.G.swap (cF c) (SQ.Xs g1) (cF c') (SQ.Xs g1'))
        (LQ.G.cong-add (sym (CS.comb-add s c c' F)) (sym (SQ.xs-add' g1 g1')))) ;
  xs-add : (d : Nat) (g g' : Seq) -> XS d g -> XS d g' -> XS d (Sq.madd g g') = split {
    zero -> \ g g' h h' -> (vadd h.1 h'.1, trans (CS.comb-add s h.1 h'.1 F) (LQ.G.cong-add h.2 h'.2)) ;
    suc d | r -> \ g g' h h' -> (vadd h.1 h'.1, (Sq.madd h.2.1 h'.2.1,
      (r h.2.1 h'.2.1 h.2.2.1 h'.2.2.1, add-dec g g' h.2.1 h'.2.1 h.1 h'.1 h.2.2.2 h'.2.2.2))) } ;

  sm-dec (a : A.R) (g g1 : Seq) (c : Vs) (e : Id Seq g (Sq.madd (cF c) (SQ.Xs g1))) :
    Id Seq (Sq.sm a g) (Sq.madd (cF (vsm a c)) (SQ.Xs (Sq.sm a g1))) =
    trans (ap (Sq.sm a) e)
      (trans (Sq.smD a (cF c) (SQ.Xs g1))
        (LQ.G.cong-add (sym (CS.comb-sm s a c F)) (sym (SQ.xs-sm' a g1)))) ;
  xs-sm : (d : Nat) (a : A.R) (g : Seq) -> XS d g -> XS d (Sq.sm a g) = split {
    zero -> \ a g h -> (vsm a h.1, trans (CS.comb-sm s a h.1 F) (ap (Sq.sm a) h.2)) ;
    suc d | r -> \ a g h -> (vsm a h.1, (Sq.sm a h.2.1, (r a h.2.1 h.2.2.1, sm-dec a g h.2.1 h.1 h.2.2.2))) } ;

  xs-up : (d : Nat) (g : Seq) -> XS d g -> XS (suc d) g = split {
    zero -> \ g h -> (h.1, (Sq.mz, ((vz, CS.comb-zero s F), lift-dec h.1 g h.2))) ;
    suc d | r -> \ g h -> (h.1, (h.2.1, (r h.2.1 h.2.2.1, h.2.2.2))) } ;
  xs-X (d : Nat) (g : Seq) (h : XS d g) : XS (suc d) (SQ.Xs g) = (vz, (g, (h, x-dec g))) ;
  xs-lift : (e : Nat) (g : Seq) -> XS zero g -> XS e g = split {
    zero -> \ g h -> h ;
    suc e | r -> \ g h -> xs-up e g (r g h) } ;
  xs-plus : (e : Nat) (d : Nat) (g : Seq) -> XS d g -> XS (plus e d) g = split {
    zero -> \ d g h -> h ;
    suc e | r -> \ d g h -> xs-up (plus e d) g (r d g h) } ;
  xs-cong (d : Nat) (g g' : Seq) (e : Id Seq g g') (h : XS d g) : XS d g' = subst (XS d) e h ;
  xs-gen (i : Fin s) : XS zero (F i) = (Delta[A,Sq].delta s i, Delta[A,Sq].comb-delta s F i) ;

  ------------------------------------------------------------------------
  -- the A[X]-span

  NW (g : Seq) : U l = (d : Nat) * XS d g ;
  NM (g : Seq) : U l = Tr.Trunc[NW g].carrier ;
  nm-prop (g : Seq) : Pr.isProp (NM g) = Tr.Trunc[NW g].proposition ;
  nm (d : Nat) (g : Seq) (h : XS d g) : NM g = Tr.Trunc[NW g].inc (d, h) ;
  nm-rec (g : Seq) (P : U l) (pP : Pr.isProp P) (k : NW g -> P) (h : NM g) : P =
    Tr.Trunc[NW g].induction @l (\ t -> P) (\ t -> pP) k h ;

  nm-zero : NM Sq.mz = nm zero Sq.mz (xs-zero zero) ;
  nm-gen (i : Fin s) : NM (F i) = nm zero (F i) (xs-gen i) ;
  nm-X (g : Seq) (h : NM g) : NM (SQ.Xs g) =
    nm-rec g (NM (SQ.Xs g)) (nm-prop (SQ.Xs g)) (\ w -> nm (suc w.1) (SQ.Xs g) (xs-X w.1 g w.2)) h ;
  nm-sm (a : A.R) (g : Seq) (h : NM g) : NM (Sq.sm a g) =
    nm-rec g (NM (Sq.sm a g)) (nm-prop (Sq.sm a g)) (\ w -> nm w.1 (Sq.sm a g) (xs-sm w.1 a g w.2)) h ;
  add-w (g g' : Seq) (w : NW g) (w' : NW g') : NM (Sq.madd g g') =
    nm (plus w'.1 w.1) (Sq.madd g g')
      (xs-add (plus w'.1 w.1) g g' (xs-plus w'.1 w.1 g w.2)
        (subst (\ d -> XS d g') (plus-comm w.1 w'.1) (xs-plus w.1 w'.1 g' w'.2))) ;
  nm-add (g g' : Seq) (h : NM g) (h' : NM g') : NM (Sq.madd g g') =
    nm-rec g (NM (Sq.madd g g')) (nm-prop (Sq.madd g g'))
      (\ w -> nm-rec g' (NM (Sq.madd g g')) (nm-prop (Sq.madd g g')) (\ w' -> add-w g g' w w') h') h ;
  nm-cong (g g' : Seq) (e : Id Seq g g') (h : NM g) : NM g' = subst NM e h ;

  nm-sum : (k : Nat) (u : Fin k -> Seq) -> ((j : Fin k) -> NM (u j)) -> NM (CS.sum k u) = split {
    zero -> \ u h -> nm-zero ;
    suc k | r -> \ u h -> nm-add (u (inr tt)) (CS.sum k (\ i -> u (inl i))) (h (inr tt)) (r (\ i -> u (inl i)) (\ i -> h (inl i))) } ;
  nm-comb (k : Nat) (c : Fin k -> A.R) (u : Fin k -> Seq) (h : (j : Fin k) -> NM (u j)) : NM (CS.comb k c u) =
    nm-sum k (\ j -> Sq.sm (c j) (u j)) (\ j -> nm-sm (c j) (u j) (h j)) ;
} ;
