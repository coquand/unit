-- ACLCertificateGeneral.seg: the ACL certificate for any two equations
-- P, Q given by their charts, homogeneous of degrees d0 + 1, e0 + 1, over a
-- gcd domain A which is CFN: no coded noetherian presentation of A
-- (artin-rees.tex §8, « Le certificat »).  As acl-zmt/ACLGeneral, with
--   * the lifting from ACLCorrectionGeneral (Theorem 14, degree -1),
--   * the dependence of ACLCertificate from (D) and (FL) of A,
--   * the sections and the restriction of ACLSections,
--   * (F2) from CechSections.Sec.F2D with the datum D0, P', Q', (S0), (S1)
--     of HomLambda.Data in degree 0:
--       kW0 = -(e' + d0 + 1),  kW0 + e' = -(d0 + 1) = kP + 1,
--       kW0 + d' = -(e0 + 1) = kQ + 1   (d0 + 1 = r + d', e0 + 1 = r + e').
-- The two uses of HomLambda.Data (degree -1 for the correction, degree 0
-- for (F2)) are the same datum D of ACLCorrectionGeneral: (S1) is stated
-- there in every degree.
-- Conclusion: for every ring map A -> L and x, y in L with p(x,y) = q(x,y)
-- = 0, merely s = 1 + a r + b t in L with s, s x, s y integral over A.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module NA = NatArith[l] ;
module ACG = ACLCorrectionGeneral[l] ;

module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) (a b : A.R)
  -- the two charts
  (muP : E3) (FP GP : Laurent3[l].Over[A].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[A].NonNegY FP) (yG : Laurent3[l].Over[A].NonNegY GP)
  (dF : Laurent3[l].Over[A].HomPI (deg muP) FP) (dG : Laurent3[l].Over[A].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[A].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[A].NonNegX FQ) (xG : Laurent3[l].Over[A].NonNegX GQ)
  (dF' : Laurent3[l].Over[A].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[A].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[A,G.set].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[A,G.set].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (Laurent3[l].Over[A].monoP muP))
  (pmuQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (Laurent3[l].Over[A].monoP muQ))
  (pP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- P, Q homogeneous of degrees d0 + 1, e0 + 1
  (d0 e0 : Nat)
  (hPd : Laurent3[l].Over[A].HomPI (pos (suc d0)) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (hQe : Laurent3[l].Over[A].HomPI (pos (suc e0)) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- exponents >= 0, and a non-zero coefficient of each
  (hP0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) zero)
  (hQ0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) zero)
  (m0 : E3) (nP0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) m0) A.z))
  (n0 : E3) (nQ0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) n0) A.z))
  -- A is CFN
  (K0 : U l) (cfn : CFN[l].CFN[K0,A])
  -- the target: x, y in L with p(x,y) = q(x,y) = 0
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (CechRestriction[l].Over[A,G.set,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) Lg.z)
  (hq : Id Lg.R (CechRestriction[l].Over[A,G.set,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) Lg.z) {
  -- the correction, in degree -1: merely h with d0 h in N1, h - z* in I K0
  module CG = ACG.Over[A,G,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,
    d0,e0,hPd,hQe,hP0,hQ0,m0,nP0,n0,nQ0,K0,cfn] ;
  module D = CG.D ;
  -- the sections of degree 0 and the restriction to the chart Z
  module SC = ACLSections[l].Over[A,G.set,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,
    CG.dg,CG.hdg,Lg,setL,iota,x,y,hp,hq] ;
  module F1 = SC.F1 ;

  ------------------------------------------------------------------------
  -- the degrees of (F2): kP + 1 = -(d0 + 1), kQ + 1 = -(e0 + 1)

  -- by definition of add at pos 1
  add-one-is (n : Nat) : Id Int (add (negsuc (suc n)) (pos (suc zero))) (negsuc n) = refl (negsuc n) ;
  k1-eq (mu : E3) (n : Nat) (h : Id Int (deg mu) (pos (suc n))) :
    Id Int (add (add (negsuc zero) (deg (neg3 mu))) (pos (suc zero))) (negsuc n) =
    trans (ap (\ v -> add v (pos (suc zero))) (CG.k-eq mu n h)) (add-one-is n) ;
  hkP1 : Id Int (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) (negsuc d0) = k1-eq muP d0 CG.dP ;
  hkQ1 : Id Int (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) (negsuc e0) = k1-eq muQ e0 CG.dQ ;
  -- (kP + 1) + deg muP = 0
  h01 : Id Int (add (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) (deg muP)) (pos zero) =
    trans (Presentations[l].cong2 Int add _ _ _ _ hkP1 CG.dP) (invr (negsuc d0)) ;
  h02 : Id Int (add (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) (deg muQ)) (pos zero) =
    trans (Presentations[l].cong2 Int add _ _ _ _ hkQ1 CG.dQ) (invr (negsuc e0)) ;
  dW0 : Nat = NA.plus D.e' d0 ;
  kW0 : Int = negsuc dW0 ;
  -- kW0 + e' = kP + 1
  hW1 : Id Int (add kW0 (pos D.e')) (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) =
    trans (CG.add-pos-is kW0 D.e') (trans (ACG.addP-negsuc D.e' d0) (sym hkP1)) ;
  -- (e0 + 1) + (kW0 + d') = 0: (e0 + 1) + d' = (r + e') + d' = e' + d0 + 1
  sum-a : Id Int (add (pos (suc e0)) (add kW0 (pos D.d'))) (add kW0 (add (pos D.d') (pos (suc e0)))) =
    trans (comm (pos (suc e0)) (add kW0 (pos D.d'))) (assoc kW0 (pos D.d') (pos (suc e0))) ;
  sum-b : Id Int (add (pos D.d') (pos (suc e0))) (pos (suc dW0)) =
    calc Int {
      add (pos D.d') (pos (suc e0))
        =< Degrees[l].add-pos D.d' (suc e0) > pos (NA.plus (suc e0) D.d')
        =< ap (\ k -> pos (NA.plus k D.d')) (sym D.sum-Q) > pos (NA.plus (NA.plus D.r D.e') D.d')
        =< ap (\ k -> pos k) (ACG.arith D.r D.d' D.e' d0 (sym D.sum-P)) > pos (suc dW0) } ;
  sum0 : Id Int (add (pos (suc e0)) (add kW0 (pos D.d'))) zeroZ =
    trans sum-a (trans (ap (add kW0) sum-b) (invr kW0)) ;
  -- kW0 + d' = kQ + 1
  hW2 : Id Int (add kW0 (pos D.d')) (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) =
    trans (ZG.neg-uniq (pos (suc e0)) (add kW0 (pos D.d')) sum0) (sym hkQ1) ;
  -- (S1) at the degrees kP + 1, kQ + 1
  s1 (al be : Laurent3[l].Over[A].Lau) (ha : CG.CMd.SL (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) al)
     (hb : CG.CMd.SL (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) be)
     (h : Laurent3[l].Over[A].EqL (Laurent3[l].Over[A].addL (Laurent3[l].Over[A].mulP D.P'h al) (Laurent3[l].Over[A].mulP D.Q'h be)) Laurent3[l].Over[A].zeroL) :
     (w : Laurent3[l].Over[A].Lau) * (CG.CMd.SL kW0 w *
       (Laurent3[l].Over[A].EqL al (Laurent3[l].Over[A].negL (Laurent3[l].Over[A].mulP D.Q'h w)) * Laurent3[l].Over[A].EqL be (Laurent3[l].Over[A].mulP D.P'h w))) =
    D.s1 kW0 al be (subst (\ k -> CG.CMd.SL k al) (sym hW1) ha) (subst (\ k -> CG.CMd.SL k be) (sym hW2) hb) h ;
  -- (F2): coordinates of closed sections
  module F2 = SC.Sc.F2D[kW0,D.D0h,D.P'h,D.Q'h,pos D.d',pos D.e',D.P'h-poly,D.Q'h-poly,hW1,hW2,h01,h02,dW0,refl kW0,D.fP,D.fQ,D.s0,s1] ;

  ------------------------------------------------------------------------
  -- the theorem

  module Z = ACLCertificate[l].Over[A,G.set,K0,cfn,a,b,Lg,setL,iota,x,y,
    F1.M0m.S.mod,SC.CMd.tmod,F1.d0K,F1.N1,F1.zsS,CG.lift,
    SC.Sc.C0.mod,SC.Sc.N0,SC.mX,SC.mY,SC.mZ,SC.Sc.Closed,SC.closedX,SC.closedY,SC.closedZ,SC.Sc.mulC,SC.Sc.oneS,SC.Sc.closed-one,SC.Sc.closed-mul,
    SC.res,SC.res-N0,SC.res-one,SC.res-mul,SC.chartX,SC.chartY,SC.zs-res,F2.ss,F2.kappa,F2.Phi,F2.decomp] ;
  -- s = 1 + a r + b t with s, s x, s y integral over A, merely
  certificate : Z.TCe.carrier = Z.certificate ;
  -- the conclusion is that of ACLZMTCong (and so of acl-zmt/ACLGeneral),
  -- whatever presentation of A one would pass there
  same-conclusion (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
    (onto : (c : A.R) -> Truncation[l].Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier) :
    Id (U l) (ACLZMTCong[l].Over[A,G.set,PA,nA,onto,a,b,Lg,setL,iota,x,y,
      F1.M0m.S.mod,SC.CMd.tmod,F1.d0K,F1.N1,F1.zsS,F1.r,F1.eF,F1.G,F1.rhoF,F1.degF,F1.vF,F1.hvF,F1.betaF,
      SC.Sc.C0.mod,SC.Sc.N0,SC.mX,SC.mY,SC.mZ,SC.Sc.Closed,SC.closedX,SC.closedY,SC.closedZ,SC.Sc.mulC,SC.Sc.oneS,SC.Sc.closed-one,SC.Sc.closed-mul,
      SC.res,SC.res-N0,SC.res-one,SC.res-mul,SC.chartX,SC.chartY,SC.zs-res,F2.ss,F2.kappa,F2.Phi,F2.decomp].Certificate) Z.Certificate =
    refl Z.Certificate ;
} ;
