-- ArtinRees.seg: Prop. split and Theorem 14 for I = (a,b), M = A^r and
-- N = span ns (artin-rees.tex §5.3).
--
-- Informal proof.  By Cor. 9 for the CFN ring R' (DegreeCor.gen 0), Q+ cap R'^r
-- is merely spanned by finitely many G_1..G_p; each G_i merely has a total
-- degree (Bigraded.deg-all), and c is the sum of these bounds (bnd).
-- Prop. split: Split(c).  Let S(u), for u in R'^r: for all n, pi_n u is
--   merely in Q_n, and for all m, pi_(m+c+1) u merely splits into halves
--   in Q_(m+c).  S holds at 0 and is closed under sums and constants
--   (Q_n and the halves are submodules), under U (pi_(n+1) (U u) = pi_n u,
--   in Q_(n+1) since Q_n is; the halves pi_(m+c) u + X 0) and under V
--   (pi_(n+1) (V u) = X pi_n u; halves 0 + X pi_(m+c) u); hence (Lemma rind)
--   under R'.  The G_i satisfy S: pi_n G_i in Q_n by Lemma good, and
--   pi_(m+c+1) G_i = 0.  So S holds on the span of the G_i, which contains
--   Q+ cap R'^r.  For g in Q_(m+c+1), iota_(m+c+1) g is in Q+ (Lemma tele)
--   and pi_(m+c+1) (iota_(m+c+1) g) = g (Bigraded.iota-pi): g splits.
-- Theorem 14.  Merely a bound c (before m and x) with
--   I^(m+c) M cap N in I^m (I^c M cap N) for all m (ReesVec, Lemma
--   split-ar); the converse inclusion is ReesVec.compose.
-- The reduction from a finitely presented M to M = A^r is the remark of
-- artin-rees.tex §5 and is not formalised here.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A]) (r : Nat) (a b : A.R)
  (ns : List (Comb[l].Free[A,r].Vec)) {
  module RP = ReesPlus[l].Over[K0,A,setA,cfn,r,a,b,ns] ;
  module BG = Bigraded[l].Over[A,setA,r] ;
  module RV = ReesVec[l].Over[A,BG.Fr.mod,a,b,ns] ;
  module S2 = SeqPoly[l].Over[BG.P2.S,BG.F2.mod] ;
  module SQ = SeqPoly[l].Over[A,BG.Fr.mod] ;
  module PM = IP.Over[A,BG.Fr.mod,a,b] ;
  module MS = Spans[l].Over[A,BG.Fr.mod] ;

  -- the vector of a block of degree 0
  top (u : S2.Blk (suc zero)) : BG.F2.Vec = u (inr tt) ;

  ------------------------------------------------------------------------
  -- the predicate S of Prop. split

  QAll (u : BG.F2.Vec) : U l = (n : Nat) -> Tr.Trunc[RV.Q[n, BG.pi n u]].carrier ;
  HAll (c : Nat) (u : BG.F2.Vec) : U l = (m : Nat) -> Tr.Trunc[RV.Halves[plus m c, BG.pi (suc (plus m c)) u]].carrier ;
  Sp (c : Nat) (u : BG.F2.Vec) : U l = QAll u * HAll c u ;
  qall-prop (u : BG.F2.Vec) : Pr.isProp (QAll u) =
    FE.isProp-Pi Nat (\ n -> Tr.Trunc[RV.Q[n, BG.pi n u]].carrier) (\ n -> Tr.Trunc[RV.Q[n, BG.pi n u]].proposition) ;
  hall-prop (c : Nat) (u : BG.F2.Vec) : Pr.isProp (HAll c u) =
    FE.isProp-Pi Nat (\ m -> Tr.Trunc[RV.Halves[plus m c, BG.pi (suc (plus m c)) u]].carrier)
      (\ m -> Tr.Trunc[RV.Halves[plus m c, BG.pi (suc (plus m c)) u]].proposition) ;
  sp-prop (c : Nat) (u : BG.F2.Vec) : Pr.isProp (Sp c u) =
    Pr.isProp-Sigma (QAll u) (\ q -> HAll c u) (qall-prop u) (\ q -> hall-prop c u) ;

  -- transport along an equality of sequences
  tq (n : Nat) (g g' : SQ.Seq) (e : Id SQ.Seq g g') (q : RV.Q[n, g]) : Tr.Trunc[RV.Q[n, g']].carrier =
    Tr.Trunc[RV.Q[n, g']].inc (subst (\ x -> RV.Q[n, x]) e q) ;
  th (n : Nat) (g g' : SQ.Seq) (e : Id SQ.Seq g g') (w : RV.Halves[n, g]) : Tr.Trunc[RV.Halves[n, g']].carrier =
    Tr.Trunc[RV.Halves[n, g']].inc (subst (\ x -> RV.Halves[n, x]) e w) ;

  sp-zero (c : Nat) : Sp c (BG.F2.mod.mz) =
    ((\ n -> tq n SQ.seq.mz (BG.pi n BG.F2.mod.mz) (sym (BG.pi-zero' n)) (RV.q-zero n)),
      (\ m -> th (plus m c) SQ.seq.mz (BG.pi (suc (plus m c)) BG.F2.mod.mz) (sym (BG.pi-zero' (suc (plus m c))))
                (RV.halves-zero (plus m c)))) ;
  sp-add (c : Nat) (x y : BG.F2.Vec) (sx : Sp c (x)) (sy : Sp c (y)) : Sp c (BG.F2.mod.madd x y) =
    ((\ n -> TC.bind2 (RV.Q[n, BG.pi n x]) (RV.Q[n, BG.pi n y]) (RV.Q[n, BG.pi n (BG.F2.mod.madd x y)])
         (\ qx qy -> tq n (SQ.seq.madd (BG.pi n x) (BG.pi n y)) (BG.pi n (BG.F2.mod.madd x y)) (sym (BG.pi-add' n x y))
            (RV.q-add n (BG.pi n x) (BG.pi n y) qx qy))
         (sx.1 n) (sy.1 n)),
      (\ m -> TC.bind2 (RV.Halves[plus m c, BG.pi (suc (plus m c)) x]) (RV.Halves[plus m c, BG.pi (suc (plus m c)) y])
         (RV.Halves[plus m c, BG.pi (suc (plus m c)) (BG.F2.mod.madd x y)])
         (\ wx wy -> th (plus m c) (SQ.seq.madd (BG.pi (suc (plus m c)) x) (BG.pi (suc (plus m c)) y))
            (BG.pi (suc (plus m c)) (BG.F2.mod.madd x y)) (sym (BG.pi-add' (suc (plus m c)) x y))
            (RV.halves-add (plus m c) (BG.pi (suc (plus m c)) x) (BG.pi (suc (plus m c)) y) wx wy))
         (sx.2 m) (sy.2 m))) ;
  sp-c (c : Nat) (k : A.R) (x : BG.F2.Vec) (sx : Sp c (x)) : Sp c (BG.F2.mod.sm (BG.cR k) x) =
    ((\ n -> TC.bind (RV.Q[n, BG.pi n x]) (RV.Q[n, BG.pi n (BG.F2.mod.sm (BG.cR k) x)])
         (\ q -> tq n (SQ.seq.sm k (BG.pi n x)) (BG.pi n (BG.F2.mod.sm (BG.cR k) x)) (sym (BG.pi-sm' n k x))
            (RV.q-sm n k (BG.pi n x) q))
         (sx.1 n)),
      (\ m -> TC.bind (RV.Halves[plus m c, BG.pi (suc (plus m c)) x])
         (RV.Halves[plus m c, BG.pi (suc (plus m c)) (BG.F2.mod.sm (BG.cR k) x)])
         (\ w -> th (plus m c) (SQ.seq.sm k (BG.pi (suc (plus m c)) x)) (BG.pi (suc (plus m c)) (BG.F2.mod.sm (BG.cR k) x))
            (sym (BG.pi-sm' (suc (plus m c)) k x)) (RV.halves-sm (plus m c) k (BG.pi (suc (plus m c)) x) w))
         (sx.2 m))) ;

  -- U: pi_(n+1) (U x) = pi_n x
  qall-U (x : BG.F2.Vec) (q : QAll x) : QAll (BG.F2.mod.sm BG.vU x) = split {
    zero -> tq zero SQ.seq.mz (BG.pi zero (BG.F2.mod.sm BG.vU x)) (sym (BG.pi-U0' x)) (RV.q-zero zero) ;
    suc n -> TC.bind (RV.Q[n, BG.pi n x]) (RV.Q[suc n, BG.pi (suc n) (BG.F2.mod.sm BG.vU x)])
      (\ qn -> tq (suc n) (BG.pi n x) (BG.pi (suc n) (BG.F2.mod.sm BG.vU x)) (sym (BG.pi-U' n x)) (RV.q-up n (BG.pi n x) qn))
      (q n) } ;
  sp-U (c : Nat) (x : BG.F2.Vec) (sx : Sp c (x)) : Sp c (BG.F2.mod.sm BG.vU x) =
    ((qall-U x sx.1),
      (\ m -> TC.map (RV.Q[plus m c, BG.pi (plus m c) x]) (RV.Halves[plus m c, BG.pi (suc (plus m c)) (BG.F2.mod.sm BG.vU x)])
         (RV.halves-p (plus m c) (BG.pi (suc (plus m c)) (BG.F2.mod.sm BG.vU x)) (BG.pi (plus m c) x) (BG.pi-U' (plus m c) x))
         (sx.1 (plus m c)))) ;
  -- V: pi_(n+1) (V x) = X pi_n x
  qall-V (x : BG.F2.Vec) (q : QAll x) : QAll (BG.F2.mod.sm BG.vV x) = split {
    zero -> tq zero SQ.seq.mz (BG.pi zero (BG.F2.mod.sm BG.vV x)) (sym (BG.pi-V0' x)) (RV.q-zero zero) ;
    suc n -> TC.bind (RV.Q[n, BG.pi n x]) (RV.Q[suc n, BG.pi (suc n) (BG.F2.mod.sm BG.vV x)])
      (\ qn -> tq (suc n) (SQ.Xs (BG.pi n x)) (BG.pi (suc n) (BG.F2.mod.sm BG.vV x)) (sym (BG.pi-V' n x)) (RV.q-X n (BG.pi n x) qn))
      (q n) } ;
  sp-V (c : Nat) (x : BG.F2.Vec) (sx : Sp c (x)) : Sp c (BG.F2.mod.sm BG.vV x) =
    ((qall-V x sx.1),
      (\ m -> TC.map (RV.Q[plus m c, BG.pi (plus m c) x]) (RV.Halves[plus m c, BG.pi (suc (plus m c)) (BG.F2.mod.sm BG.vV x)])
         (RV.halves-q (plus m c) (BG.pi (suc (plus m c)) (BG.F2.mod.sm BG.vV x)) (BG.pi (plus m c) x) (BG.pi-V' (plus m c) x))
         (sx.1 (plus m c)))) ;

  -- the generators: Lemma good and the total degree
  sp-gen (c : Nat) (u : S2.Blk (suc zero)) (nm : RP.XN.NM (S2.emb (suc zero) u)) (tv : BG.TotVan c (top u)) : Sp c (top u) =
    ((\ n -> Tr.Trunc[RV.Q[n, BG.pi n (top u)]].inc (RP.good-Q u (RP.good-nm (S2.emb (suc zero) u) nm) n)),
      (\ m -> th (plus m c) SQ.seq.mz (BG.pi (suc (plus m c)) (top u))
         (sym (SQ.sext (BG.pi (suc (plus m c)) (top u)) SQ.seq.mz (tv (suc m)))) (RV.halves-zero (plus m c)))) ;

  ------------------------------------------------------------------------
  -- Prop. split

  -- a common total degree of a list of vectors
  Bnd (s : List (S2.Blk (suc zero))) : U l = (c : Nat) * DegreeCor[l].AllL (S2.Blk (suc zero)) (\ x -> BG.TotVan c (top x)) s ;
  bnd-step (t : S2.Blk (suc zero)) (s : List (S2.Blk (suc zero))) (w : BG.TV (top t)) (ws : Bnd s) : Bnd (cons t s) =
    (plus w.1 ws.1,
     (BG.tv-up' ws.1 w.1 (top t) w.2,
      DegreeCor[l].all-imp (S2.Blk (suc zero)) (\ x -> BG.TotVan ws.1 (top x)) (\ x -> BG.TotVan (plus w.1 ws.1) (top x))
        (\ x -> BG.tv-up w.1 ws.1 (top x)) s ws.2)) ;
  bnd : (s : List (S2.Blk (suc zero))) -> Tr.Trunc[Bnd s].carrier = split {
    nil -> Tr.Trunc[Bnd nil].inc (zero, tt) ;
    cons t s | ih -> TC.map2 (BG.TV (top t)) (Bnd s) (Bnd (cons t s)) (bnd-step t s) (BG.deg-all (top t)) ih } ;

  module WithGens (Gs : List (S2.Blk (suc zero)))
    (gin : DegreeCor[l].AllL (S2.Blk (suc zero)) (\ x -> RP.XN.NM (S2.emb (suc zero) x)) Gs)
    (gsp : (u : S2.Blk (suc zero)) -> RP.XN.NM (S2.emb (suc zero) u) -> Spans[l].Over[BG.P2.S,S2.blk (suc zero)].Mm Gs u)
    (c : Nat) (gtv : DegreeCor[l].AllL (S2.Blk (suc zero)) (\ x -> BG.TotVan c (top x)) Gs) {
    module SI = BG.RInd[BG.F2.mod, \ x -> Sp c (x), sp-prop c, sp-zero c, sp-add c, sp-c c, sp-U c, sp-V c] ;
    module SC = DegreeCor[l].SpanClosed[BG.P2.S, S2.blk (suc zero), \ u -> Sp c (top u), \ u -> sp-prop c (top u),
      sp-zero c, \ u v -> sp-add c (top u) (top v), \ h u -> SI.rind h (top u)] ;
    all-sp : DegreeCor[l].AllL (S2.Blk (suc zero)) (\ u -> Sp c (top u)) Gs =
      DegreeCor[l].all-imp (S2.Blk (suc zero))
        (\ x -> RP.XN.NM (S2.emb (suc zero) x) * BG.TotVan c (top x)) (\ u -> Sp c (top u))
        (\ x h -> sp-gen c x h.1 h.2) Gs
        (DegreeCor[l].all-and (S2.Blk (suc zero)) (\ x -> RP.XN.NM (S2.emb (suc zero) x)) (\ x -> BG.TotVan c (top x)) Gs gin gtv) ;
    -- S at iota_n g, for g in Q_n
    sp-iota (n : Nat) (g : SQ.Seq) (hq : RV.Q[n, g]) : Sp c (BG.iota n g) =
      SC.mm-closed Gs (\ t -> BG.iota n g) all-sp (gsp (\ t -> BG.iota n g) (RP.tele-in n g hq.inN)) ;
    splits : RV.Split c = \ m g hq ->
      subst (\ x -> Tr.Trunc[RV.Halves[plus m c, x]].carrier)
        (SQ.sext (BG.pi (suc (plus m c)) (BG.iota (suc (plus m c)) g)) g (BG.iota-pi (suc (plus m c)) g hq.van))
        ((sp-iota (suc (plus m c)) g hq).2 m) ;
  } ;

  ------------------------------------------------------------------------
  -- Theorem 14

  record Bound {
    c : Nat ;
    decomp (m : Nat) (x : BG.Fr.Vec) : PM.Pow (plus m c) x -> MS.Mm ns x -> Tr.Trunc[PM.PowIn (RV.Core c) m x].carrier ;
  } ;
  from-split (c : Nat) (sp : RV.Split c) : Bound = mkBound c RV.FromSplit[c, sp].artin-rees-at ;
  from-gen (w : RP.DG.D.Gen zero) : Tr.Trunc[Bound].carrier =
    TC.map (Bnd w.1) Bound (\ bd -> from-split bd.1 WithGens[w.1, w.2.1, w.2.2, bd.1, bd.2].splits) (bnd w.1) ;
  artin-rees : Tr.Trunc[Bound].carrier = TC.bind (RP.DG.D.Gen zero) Bound from-gen (RP.DG.gen zero) ;
} ;
