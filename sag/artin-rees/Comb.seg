-- Comb.seg: finite sums and linear combinations in a module (IdealPowers
-- modules), the free module A^r = Fin r -> A, and the bridge between the
-- list spans of ModSpan and combinations of families.
--
-- comb k c u = sum_i c_i u_i.  Linear in c (comb-add, comb-sm, comb-zero)
-- and in u (comb-addv); sums commute (sum-swap); the coefficients of a
-- combination of coefficient vectors give the combination of combinations
-- (comb-comb).  A list s is the family elem s, indexed by Fin (len s) with
-- the head last; In s y holds iff y is a combination of elem s (in-fam,
-- fam-in).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Sums (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ; open ML ;

  sum : (n : Nat) -> (Ps.Fin n -> M) -> M = split {
    zero -> \ f -> mz ;
    suc n | r -> \ f -> madd (f (inr tt)) (r (\ i -> f (inl i))) } ;
  comb (n : Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> M) : M = sum n (\ k -> sm (c k) (u k)) ;

  sum-cong : (n : Nat) (f g : Ps.Fin n -> M) -> ((k : Ps.Fin n) -> Id M (f k) (g k)) -> Id M (sum n f) (sum n g) = split {
    zero -> \ f g h -> refl mz ;
    suc n | r -> \ f g h -> G.cong-add (h (inr tt)) (r (\ i -> f (inl i)) (\ i -> g (inl i)) (\ i -> h (inl i))) } ;

  sum-zero : (n : Nat) -> Id M (sum n (\ k -> mz)) mz = split {
    zero -> refl mz ;
    suc n | r -> trans (ap (madd mz) r) (maddZ mz) } ;

  sum-add : (n : Nat) (f g : Ps.Fin n -> M) ->
    Id M (sum n (\ k -> madd (f k) (g k))) (madd (sum n f) (sum n g)) = split {
    zero -> \ f g -> sym (maddZ mz) ;
    suc n | r -> \ f g ->
      trans (ap (madd (madd (f (inr tt)) (g (inr tt)))) (r (\ i -> f (inl i)) (\ i -> g (inl i))))
            (G.swap (f (inr tt)) (g (inr tt)) (sum n (\ i -> f (inl i))) (sum n (\ i -> g (inl i)))) } ;

  sum-neg : (n : Nat) (f : Ps.Fin n -> M) -> Id M (sum n (\ k -> mneg (f k))) (mneg (sum n f)) = split {
    zero -> \ f -> sym G.neg-zero ;
    suc n | r -> \ f -> trans (ap (madd (mneg (f (inr tt)))) (r (\ i -> f (inl i))))
                              (sym (G.neg-add (f (inr tt)) (sum n (\ i -> f (inl i))))) } ;

  sum-sm : (n : Nat) (d : A.R) (f : Ps.Fin n -> M) -> Id M (sm d (sum n f)) (sum n (\ k -> sm d (f k))) = split {
    zero -> \ d f -> sm-zero d ;
    suc n | r -> \ d f -> trans (smD d (f (inr tt)) (sum n (\ i -> f (inl i)))) (ap (madd (sm d (f (inr tt)))) (r d (\ i -> f (inl i)))) } ;

  sum-swap : (n p : Nat) (f : Ps.Fin n -> Ps.Fin p -> M) ->
    Id M (sum n (\ i -> sum p (f i))) (sum p (\ j -> sum n (\ i -> f i j))) = split {
    zero -> \ p f -> sym (sum-zero p) ;
    suc n | r -> \ p f ->
      trans (ap (madd (sum p (f (inr tt)))) (r p (\ i -> f (inl i))))
            (sym (sum-add p (f (inr tt)) (\ j -> sum n (\ i -> f (inl i) j)))) } ;

  comb-add (n : Nat) (c c' : Ps.Fin n -> A.R) (u : Ps.Fin n -> M) :
    Id M (comb n (\ k -> A.add (c k) (c' k)) u) (madd (comb n c u) (comb n c' u)) =
    trans (sum-cong n (\ k -> sm (A.add (c k) (c' k)) (u k)) (\ k -> madd (sm (c k) (u k)) (sm (c' k) (u k))) (\ k -> smE (c k) (c' k) (u k))) (sum-add n (\ k -> sm (c k) (u k)) (\ k -> sm (c' k) (u k))) ;

  comb-sm (n : Nat) (d : A.R) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> M) :
    Id M (comb n (\ k -> A.mul d (c k)) u) (sm d (comb n c u)) =
    trans (sum-cong n (\ k -> sm (A.mul d (c k)) (u k)) (\ k -> sm d (sm (c k) (u k))) (\ k -> sym (smA d (c k) (u k)))) (sym (sum-sm n d (\ k -> sm (c k) (u k)))) ;

  comb-zero (n : Nat) (u : Ps.Fin n -> M) : Id M (comb n (\ k -> A.z) u) mz =
    trans (sum-cong n (\ k -> sm A.z (u k)) (\ k -> mz) (\ k -> zero-sm (u k))) (sum-zero n) ;

  comb-addv (n : Nat) (c : Ps.Fin n -> A.R) (u u' : Ps.Fin n -> M) :
    Id M (comb n c (\ k -> madd (u k) (u' k))) (madd (comb n c u) (comb n c u')) =
    trans (sum-cong n (\ k -> sm (c k) (madd (u k) (u' k))) (\ k -> madd (sm (c k) (u k)) (sm (c k) (u' k))) (\ k -> smD (c k) (u k) (u' k))) (sum-add n (\ k -> sm (c k) (u k)) (\ k -> sm (c k) (u' k))) ;

  comb-vanish (n : Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> M) (h : (k : Ps.Fin n) -> Id M (u k) mz) :
    Id M (comb n c u) mz =
    trans (sum-cong n (\ k -> sm (c k) (u k)) (\ k -> mz) (\ k -> trans (ap (sm (c k)) (h k)) (sm-zero (c k)))) (sum-zero n) ;

  neg-sm (c : A.R) (x : M) : Id M (sm (A.neg c) x) (mneg (sm c x)) =
    G.neg-uniq (sm c x) (sm (A.neg c) x)
      (trans (sym (smE c (A.neg c) x)) (trans (ap (\ t -> sm t x) (A.addN c)) (zero-sm x))) ;
  comb-neg (n : Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> M) :
    Id M (comb n (\ k -> A.neg (c k)) u) (mneg (comb n c u)) =
    trans (sum-cong n (\ k -> sm (A.neg (c k)) (u k)) (\ k -> mneg (sm (c k) (u k))) (\ k -> neg-sm (c k) (u k))) (sum-neg n (\ k -> sm (c k) (u k))) ;
} ;

-- the free module A^r
module Free (A : CRing) (r : Nat) {
  Vec : U l = Ps.Fin r -> A.R ;
  ext (u v : Vec) (h : (k : Ps.Fin r) -> Id A.R (u k) (v k)) : Id Vec u v = FE.funext (Ps.Fin r) (\ k -> A.R) u v h ;
  module LA = RL[A] ;
  mod : IP.Mod[A] = IP.mkMod A Vec (\ k -> A.z) (\ u v k -> A.add (u k) (v k)) (\ u k -> A.neg (u k))
    (\ u v w -> ext _ _ (\ k -> A.addA (u k) (v k) (w k)))
    (\ u v -> ext _ _ (\ k -> A.addC (u k) (v k)))
    (\ u -> ext _ _ (\ k -> A.addZ (u k)))
    (\ u -> ext _ _ (\ k -> A.addN (u k)))
    (\ c u k -> A.mul c (u k))
    (\ c c' u -> ext _ _ (\ k -> A.mulA c c' (u k)))
    (\ u -> ext _ _ (\ k -> LA.one-left (u k)))
    (\ c u v -> ext _ _ (\ k -> A.dist c (u k) (v k)))
    (\ c c' u -> ext _ _ (\ k -> LA.dist-left c c' (u k))) ;
  module VS = Sums[A,mod] ;
  module RS = Sums[A,IP.regular A] ;
  -- sums in A^r are computed coordinatewise
  sum-at : (p : Nat) (f : Ps.Fin p -> Vec) (i : Ps.Fin r) -> Id A.R (VS.sum p f i) (RS.sum p (\ j -> f j i)) = split {
    zero -> \ f i -> refl A.z ;
    suc p | rr -> \ f i -> ap (A.add (f (inr tt) i)) (rr (\ j -> f (inl j)) i) } ;
  comb-at (p : Nat) (d : Ps.Fin p -> A.R) (f : Ps.Fin p -> Vec) (i : Ps.Fin r) :
    Id A.R (VS.comb p d f i) (RS.comb p d (\ j -> f j i)) = sum-at p (\ j k -> A.mul (d j) (f j k)) i ;
} ;

-- combinations of combinations
module Bilinear (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ; open ML ;
  module S = Sums[A,Md] ; module RS = Sums[A,IP.regular A] ;
  -- (sum_j g_j) x = sum_j g_j x
  sm-sum : (p : Nat) (g : Ps.Fin p -> A.R) (x : M) -> Id M (sm (RS.sum p g) x) (S.sum p (\ j -> sm (g j) x)) = split {
    zero -> \ g x -> zero-sm x ;
    suc p | r -> \ g x -> trans (smE (g (inr tt)) (RS.sum p (\ i -> g (inl i))) x)
                                (ap (madd (sm (g (inr tt)) x)) (r (\ i -> g (inl i)) x)) } ;
  comb-comb (k p : Nat) (d : Ps.Fin p -> A.R) (tau : Ps.Fin p -> Free[A,k].Vec) (u : Ps.Fin k -> M) :
    Id M (S.comb k (Free[A,k].VS.comb p d tau) u) (S.comb p d (\ j -> S.comb k (tau j) u)) =
    calc M { S.comb k (Free[A,k].VS.comb p d tau) u
      =< S.sum-cong k (\ i -> sm (Free[A,k].VS.comb p d tau i) (u i)) (\ i -> S.sum p (\ j -> sm (A.mul (d j) (tau j i)) (u i))) (\ i -> trans (ap (\ t -> sm t (u i)) (Free[A,k].comb-at p d tau i))
                                       (sm-sum p (\ j -> A.mul (d j) (tau j i)) (u i)))
      > S.sum k (\ i -> S.sum p (\ j -> sm (A.mul (d j) (tau j i)) (u i)))
      =< S.sum-swap k p (\ i j -> sm (A.mul (d j) (tau j i)) (u i))
      > S.sum p (\ j -> S.sum k (\ i -> sm (A.mul (d j) (tau j i)) (u i)))
      =< S.sum-cong p (\ j -> S.sum k (\ i -> sm (A.mul (d j) (tau j i)) (u i))) (\ j -> sm (d j) (S.comb k (tau j) u)) (\ j -> trans (S.sum-cong k (\ i -> sm (A.mul (d j) (tau j i)) (u i)) (\ i -> sm (d j) (sm (tau j i) (u i))) (\ i -> sym (smA (d j) (tau j i) (u i))))
                                       (sym (S.sum-sm k (d j) (\ i -> sm (tau j i) (u i)))))
      > S.comb p d (\ j -> S.comb k (tau j) u) } ;
  -- sum_i lam_i (u_i x) = (sum_i lam_i u_i) x
  comb-scaled (k : Nat) (lam u : Ps.Fin k -> A.R) (x : M) :
    Id M (S.comb k lam (\ i -> sm (u i) x)) (sm (RS.comb k lam u) x) =
    trans (S.sum-cong k (\ i -> sm (lam i) (sm (u i) x)) (\ i -> sm (A.mul (lam i) (u i)) x) (\ i -> smA (lam i) (u i) x))
      (sym (sm-sum k (\ i -> A.mul (lam i) (u i)) x)) ;
} ;

-- lists as families
module Lists (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ; open ML ;
  module S = Sums[A,Md] ; module SP = ModSpan[l].Over[A,Md] ;
  elem : (s : List M) -> Ps.Fin (len s) -> M = split {
    nil -> \ i -> absurd M i ;
    cons t s | r -> Ps.snoc (Ps.Fin (len s)) M r t } ;
  InF (n : Nat) (u : Ps.Fin n -> M) (y : M) : U l = (c : Ps.Fin n -> A.R) * Id M (S.comb n c u) y ;

  -- y - c t = w  when  c t + w = y
  split-sub (y t w : M) (c : A.R) (h : Id M (madd (sm c t) w) y) : Id M w (msub y (sm c t)) =
    calc M { w =< sym (G.zl w) > madd mz w
               =< ap (\ v -> madd v w) (sym (maddN (sm c t))) > madd (msub (sm c t) (sm c t)) w
               =< trans (sym (maddA (sm c t) (mneg (sm c t)) w))
                        (trans (ap (madd (sm c t)) (maddC (mneg (sm c t)) w)) (maddA (sm c t) w (mneg (sm c t))))
               > msub (madd (sm c t) w) (sm c t)
               =< ap (\ v -> msub v (sm c t)) h > msub y (sm c t) } ;
  join-sub (y t : M) (c : A.R) : Id M (madd (sm c t) (msub y (sm c t))) y =
    trans (maddC (sm c t) (msub y (sm c t)))
      (trans (sym (maddA y (mneg (sm c t)) (sm c t)))
        (trans (ap (madd y) (trans (maddC (mneg (sm c t)) (sm c t)) (maddN (sm c t)))) (maddZ y))) ;

  in-fam : (s : List M) (y : M) -> SP.In s y -> InF (len s) (elem s) y = split {
    nil -> \ y h -> (\ i -> absurd A.R i, sym h) ;
    cons t s | r -> \ y h -> (Ps.snoc (Ps.Fin (len s)) A.R (r (msub y (sm h.1 t)) h.2).1 h.1,
      trans (ap (madd (sm h.1 t)) (r (msub y (sm h.1 t)) h.2).2) (join-sub y t h.1)) } ;
  fam-in : (s : List M) (y : M) -> InF (len s) (elem s) y -> SP.In s y = split {
    nil -> \ y h -> sym h.2 ;
    cons t s | r -> \ y h -> (h.1 (inr tt),
      r (msub y (sm (h.1 (inr tt)) t)) (\ i -> h.1 (inl i),
        split-sub y t (S.comb (len s) (\ i -> h.1 (inl i)) (elem s)) (h.1 (inr tt)) h.2)) } ;
} ;
