-- HilbertD.seg: (D) for R[X] over a CFN ring (artin-rees.tex, §4 (D)).
--
-- RegBlocks: (D), (C), (FL) for the blocks A^k = Pow (regular A) k, from
--   Prop. 3 along the identity A^k = Free A k.
-- Fam: the A[X]-span of a family of sequences depends only on the family
--   pointwise (xs-fam).
-- bounds: u_1..u_k, y in R[X] merely have a common degree bound.
-- disc: with a bound N, the blocks f_i = trunc (kap u_i) of size N + 1
--   give N = A[X]-span of the kap u_i (Fam), Cor. 10 decides kap y in N,
--   and PolyCoef.SpanOf turns this into y in the R[X]-span of u.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

module RegBlocks (A : CRing) (disc : Coherent[l].Over[A,IP.regular A].Disc) (coh : Coherent[l].Over[A,IP.regular A].Coh)
  (flA : Coherent[l].Over[A,IP.regular A].FL) (k : Nat) {
  module FV = Comb[l].Free[A,k] ;
  module PW = Blocks[l].Pow[A,IP.regular A,k] ;
  P : IP.Mod[A] = FV.mod ;
  Q : IP.Mod[A] = PW.mod ;
  idf (v : FV.Vec) : PW.E = v ;
  idg (w : PW.E) : FV.Vec = w ;
  module T = LinIso[l].Over[A,P,Q,idf,\ x y -> refl (P.madd x y),\ c x -> refl (P.sm c x),
    idg,\ x y -> refl (Q.madd x y),\ c x -> refl (Q.sm c x),\ y -> refl y,\ x -> refl x] ;
  disc-blk : Coherent[l].Over[A,Q].Disc = T.disc (FreeDisc[l].Over[A,disc,coh].disc-vec k) ;
  coh-blk : Coherent[l].Over[A,Q].Coh = T.coh (FreeCoherent[l].Over[A,coh].coh-vec k) ;
  fl-blk : Coherent[l].Over[A,Q].FL = T.fl (FreeNoeth[l].Over[A,disc,coh,flA].fl-vec k) ;
} ;

-- two pointwise equal families have the same A[X]-span
module Fam (A : CRing) (Md : IP.Mod[A]) (k : Nat) (F F' : Fin k -> SeqPoly[l].Over[A,Md].Seq)
  (e : (i : Fin k) -> Id SeqPoly[l].Over[A,Md].Seq (F i) (F' i)) {
  module SQ = SeqPoly[l].Over[A,Md] ;
  module X1 = XSpan[l].Over[A,Md,k,F] ; module X2 = XSpan[l].Over[A,Md,k,F'] ;
  module CS = Comb[l].Sums[A,SQ.seq] ;
  cf (c : Fin k -> A.R) : Id SQ.Seq (X1.cF c) (X2.cF c) =
    CS.sum-cong k (\ i -> SQ.seq.sm (c i) (F i)) (\ i -> SQ.seq.sm (c i) (F' i)) (\ i -> ap (SQ.seq.sm (c i)) (e i)) ;
  xs-fam : (d : Nat) (g : SQ.Seq) -> X1.XS d g -> X2.XS d g = split {
    zero -> \ g h -> (h.1, trans (sym (cf h.1)) h.2) ;
    suc d | r -> \ g h -> (h.1, (h.2.1, (r h.2.1 h.2.2.1,
      trans h.2.2.2 (ap (\ t -> SQ.seq.madd t (SQ.Xs h.2.1)) (cf h.1))))) } ;
  nm-fam (g : SQ.Seq) (h : X1.NM g) : X2.NM g =
    X1.nm-rec g (X2.NM g) (X2.nm-prop g) (\ w -> X2.nm w.1 g (xs-fam w.1 g w.2)) h ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R) (disc : Coherent[l].Over[A,IP.regular A].Disc)
  (coh : Coherent[l].Over[A,IP.regular A].Coh) (flA : Coherent[l].Over[A,IP.regular A].FL) {
  module PCo = PolyCoef[l].Over[A,setA] ;
  module SQ = PCo.SQ ;
  S : CRing = PCo.S ;
  K : U l = PCo.K ;
  module CS = Coherent[l].Over[S,IP.regular S] ;

  ------------------------------------------------------------------------
  -- a common degree bound

  Bnd (k : Nat) (u : Fin k -> K) (y : K) : U l = (N : Nat) * (((i : Fin k) -> SQ.Van N (PCo.kap (u i))) * SQ.Van N (PCo.kap y)) ;
  -- vanishing from N on, then from M + N and N + M on
  van-r (M N : Nat) (g : SQ.Seq) (v : SQ.Van N g) : SQ.Van (plus M N) g = SQ.van-lift M N g v ;
  van-l (M N : Nat) (g : SQ.Seq) (v : SQ.Van M g) : SQ.Van (plus M N) g =
    subst (\ i -> SQ.Van i g) (plus-comm N M) (SQ.van-lift N M g v) ;
  bnd-cons (k : Nat) (u : Fin (suc k) -> K) (y : K) (b : PCo.Bound (u (inr tt))) (bs : Bnd k (\ i -> u (inl i)) y) :
    Bnd (suc k) u y =
    (plus b.1 bs.1, (Saturation[l].allS k (\ i -> SQ.Van (plus b.1 bs.1) (PCo.kap (u i)))
       (\ i -> van-r b.1 bs.1 (PCo.kap (u (inl i))) (bs.2.1 i)) (van-l b.1 bs.1 (PCo.kap (u (inr tt))) b.2),
     van-r b.1 bs.1 (PCo.kap y) bs.2.2)) ;
  bounds : (k : Nat) (u : Fin k -> K) (y : K) -> Tr.Trunc[Bnd k u y].carrier = split {
    zero -> \ u y -> Tr.Trunc[PCo.Bound y].induction @l (\ t -> Tr.Trunc[Bnd zero u y].carrier) (\ t -> Tr.Trunc[Bnd zero u y].proposition)
      (\ b -> Tr.Trunc[Bnd zero u y].inc (b.1, ((\ i -> absurd (SQ.Van b.1 (PCo.kap (u i))) i), b.2))) (PCo.bound y) ;
    suc k | r -> \ u y -> Tr.Trunc[PCo.Bound (u (inr tt))].induction @l (\ t -> Tr.Trunc[Bnd (suc k) u y].carrier)
      (\ t -> Tr.Trunc[Bnd (suc k) u y].proposition)
      (\ b -> Tr.Trunc[Bnd k (\ i -> u (inl i)) y].induction @l (\ t -> Tr.Trunc[Bnd (suc k) u y].carrier)
         (\ t -> Tr.Trunc[Bnd (suc k) u y].proposition)
         (\ bs -> Tr.Trunc[Bnd (suc k) u y].inc (bnd-cons k u y b bs)) (r (\ i -> u (inl i)) y))
      (PCo.bound (u (inr tt))) } ;

  ------------------------------------------------------------------------
  -- (D)

  discAll (k : Nat) : Coherent[l].Over[A,SQ.blk k].Disc = RegBlocks[A,disc,coh,flA,k].disc-blk ;
  cohAll (k : Nat) : Coherent[l].Over[A,SQ.blk k].Coh = RegBlocks[A,disc,coh,flA,k].coh-blk ;

  module AtBound (k : Nat) (u : Fin k -> K) (y : K) (b : Bnd k u y) {
    N : Nat = b.1 ;
    f (i : Fin k) : SQ.Blk (suc N) = SQ.trunc (suc N) (PCo.kap (u i)) ;
    ef (i : Fin k) : Id SQ.Seq (SQ.emb (suc N) (f i)) (PCo.kap (u i)) =
      SQ.sext _ _ (SQ.emb-trunc (suc N) (PCo.kap (u i)) (SQ.van-up N (PCo.kap (u i)) (b.2.1 i))) ;
    module D = DegreeCor[l].Over[A,IP.regular A,coh,N,discAll,cohAll,RegBlocks[A,disc,coh,flA,suc N].fl-blk,k,f] ;
    module SO = PCo.SpanOf[k,u] ;
    module F12 = Fam[A,IP.regular A,k,\ i -> SQ.emb (suc N) (f i),SO.F,ef] ;
    module F21 = Fam[A,IP.regular A,k,SO.F,\ i -> SQ.emb (suc N) (f i),\ i -> sym (ef i)] ;
    step : Plus (D.XN.NM (PCo.kap y)) (Not (D.XN.NM (PCo.kap y))) -> Plus (CS.Mem k u y) (Not (CS.Mem k u y)) = split {
      inl h -> inl (SO.to-span y (F12.nm-fam (PCo.kap y) h)) ;
      inr no -> inr (\ m -> no (F21.nm-fam (PCo.kap y) (SO.from-span y m))) } ;
    result : Plus (CS.Mem k u y) (Not (CS.Mem k u y)) = step (D.decide N (PCo.kap y) b.2.2) ;
  } ;

  disc-S : CS.Disc = \ k u y ->
    Tr.Trunc[Bnd k u y].induction @l (\ t -> Plus (CS.Mem k u y) (Not (CS.Mem k u y)))
      (\ t -> Coherent[l].dec-prop (CS.Mem k u y) Tr.Trunc[CS.InFM k u y].proposition)
      (\ b -> AtBound[k,u,y,b].result) (bounds k u y) ;
} ;
