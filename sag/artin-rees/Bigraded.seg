-- Bigraded.seg: R' = R[U][V], the homogeneous components pi_n, iota_n, and
-- induction on R' (artin-rees.tex §5.2).
--
-- Informal proof.
-- Double sequences (module Pi, over any module M).  D i j is the
--   coefficient of U^i V^j.  pi_n D is the sequence of the coefficients of
--   U^(n-j) V^j, j <= n, defined without subtraction:
--     pi_n D 0 = D n 0,  pi_0 D (j+1) = 0,  pi_(n+1) D (j+1) = pi_n D' j
--   with D' i j = D i (j+1).  U D and V D shift D in i and in j.
-- Lemma pi.  (i) pi_n is linear and vanishes from n + 1 on (pi-add,
--   pi-sm, pi-zero, pi-van).  (ii) pi_0 (U D) = 0, pi_(n+1) (U D) = pi_n D
--   (pi-U0, pi-U; induction on n).  (iii) pi_0 (V D) = 0,
--   pi_(n+1) (V D) = X pi_n D (pi-V0, pi-V; by definition).  (iv) for a
--   constant m, pi_0 m = m, pi_(n+1) m = 0 (pi-C0, pi-C).
-- R' (module Over).  R1 = A[U], R' = R1[V] (PolynomialRing twice, through
--   PolyCoef).  For H in R'^r, dd H i j is the vector of the coefficients
--   of U^i V^j of its coordinates (kap in V, then kap in U), and
--   pi_n H = pi_n (dd H).  dd is additive, dd (c H) = c dd H for c in A,
--   dd (U H) = U dd H, dd (V H) = V dd H, dd (lift m) = m constant
--   (PolyCoef kap-add, kap-cmul, kap-X, kap-const, in V then in U), so
--   Lemma pi holds for pi_n on R'^r.
-- iota_n.  A sequence g in M = A^r vanishing from n + 1 on is the
--   homogeneous polynomial sum_j g_j U^(n-j) V^j.  We build it by
--     iota_0 g = g_0,   iota_(n+1) g = U^(n+1) g_0 + V iota_n (g . suc),
--   and pi_n (iota_n g) = g (iota-pi): pi_(n+1) (U^(n+1) g_0) = g_0
--   constant (ii, iv) and pi_(n+1) (V x) = X pi_n x (iii).
-- Lemma rind.  A propositional predicate P on an R'-module, true at 0,
--   closed under sums, constants of A, U and V, is closed under every h in
--   R': under truncation h has a degree bound in V; h = h(0) + V tail h
--   (horner), and h(0) in R1 by the same induction in U.
-- Total degree.  TotVan c H: pi_n H = 0 for n >= c.  Merely true for some
--   c (deg): the predicate is closed under 0, sums, constants, U, V, holds
--   on constants (bound 1), hence (rind) on every h b_k, and
--   H = sum_k H_k b_k with b_k = lift e_k the standard basis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

plus-assoc : (a b c : Nat) -> Id Nat (plus (plus a b) c) (plus a (plus b c)) = split {
  zero -> \ b c -> refl (plus b c) ;
  suc a | r -> \ b c -> ap (\ k -> suc k) (r b c) } ;

------------------------------------------------------------------------
-- double sequences and pi_n

module Pi (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ;
  module SQ = SeqPoly[l].Over[A,Md] ;

  -- D i j: the coefficient of U^i V^j
  DS : U l = Nat -> Nat -> M ;

  pi0 (D : DS) : SQ.Seq = split {
    zero -> D zero zero ;
    suc j -> mz } ;
  piS (n : Nat) (ih : DS -> SQ.Seq) (D : DS) : SQ.Seq = split {
    zero -> D (suc n) zero ;
    suc j -> ih (\ i j' -> D i (suc j')) j } ;
  pi : Nat -> DS -> SQ.Seq = split {
    zero -> pi0 ;
    suc n | ih -> piS n ih } ;

  -- multiplication by U and by V
  dU (D : DS) : DS = \ i j -> SQ.Xs (\ i' -> D i' j) i ;
  dV (D : DS) : DS = \ i -> SQ.Xs (D i) ;
  -- the constant m
  dC (m : M) : DS = \ i j -> SQ.cst (SQ.cst m j) i ;

  -- (i)
  pi0-cong (D D' : DS) (h : (i j : Nat) -> Id M (D i j) (D' i j)) : (j : Nat) -> Id M (pi zero D j) (pi zero D' j) = split {
    zero -> h zero zero ;
    suc j -> refl mz } ;
  piS-cong (n : Nat) (ih : (D D' : DS) -> ((i j : Nat) -> Id M (D i j) (D' i j)) -> (j : Nat) -> Id M (pi n D j) (pi n D' j))
    (D D' : DS) (h : (i j : Nat) -> Id M (D i j) (D' i j)) : (j : Nat) -> Id M (pi (suc n) D j) (pi (suc n) D' j) = split {
    zero -> h (suc n) zero ;
    suc j -> ih (\ i j' -> D i (suc j')) (\ i j' -> D' i (suc j')) (\ i j' -> h i (suc j')) j } ;
  pi-cong : (n : Nat) (D D' : DS) -> ((i j : Nat) -> Id M (D i j) (D' i j)) -> (j : Nat) -> Id M (pi n D j) (pi n D' j) = split {
    zero -> pi0-cong ;
    suc n | ih -> piS-cong n ih } ;

  pi0-add (D D' : DS) : (j : Nat) -> Id M (pi zero (\ i j' -> madd (D i j') (D' i j')) j) (madd (pi zero D j) (pi zero D' j)) = split {
    zero -> refl (madd (D zero zero) (D' zero zero)) ;
    suc j -> sym (maddZ mz) } ;
  piS-add (n : Nat) (ih : (D D' : DS) (j : Nat) -> Id M (pi n (\ i j' -> madd (D i j') (D' i j')) j) (madd (pi n D j) (pi n D' j)))
    (D D' : DS) : (j : Nat) -> Id M (pi (suc n) (\ i j' -> madd (D i j') (D' i j')) j) (madd (pi (suc n) D j) (pi (suc n) D' j)) = split {
    zero -> refl (madd (D (suc n) zero) (D' (suc n) zero)) ;
    suc j -> ih (\ i j' -> D i (suc j')) (\ i j' -> D' i (suc j')) j } ;
  pi-add : (n : Nat) (D D' : DS) (j : Nat) -> Id M (pi n (\ i j' -> madd (D i j') (D' i j')) j) (madd (pi n D j) (pi n D' j)) = split {
    zero -> pi0-add ;
    suc n | ih -> piS-add n ih } ;

  pi0-sm (c : A.R) (D : DS) : (j : Nat) -> Id M (pi zero (\ i j' -> sm c (D i j')) j) (sm c (pi zero D j)) = split {
    zero -> refl (sm c (D zero zero)) ;
    suc j -> sym (ML.sm-zero c) } ;
  piS-sm (n : Nat) (ih : (c : A.R) (D : DS) (j : Nat) -> Id M (pi n (\ i j' -> sm c (D i j')) j) (sm c (pi n D j)))
    (c : A.R) (D : DS) : (j : Nat) -> Id M (pi (suc n) (\ i j' -> sm c (D i j')) j) (sm c (pi (suc n) D j)) = split {
    zero -> refl (sm c (D (suc n) zero)) ;
    suc j -> ih c (\ i j' -> D i (suc j')) j } ;
  pi-sm : (n : Nat) (c : A.R) (D : DS) (j : Nat) -> Id M (pi n (\ i j' -> sm c (D i j')) j) (sm c (pi n D j)) = split {
    zero -> pi0-sm ;
    suc n | ih -> piS-sm n ih } ;

  pi0-zero : (j : Nat) -> Id M (pi zero (\ i j' -> mz) j) mz = split {
    zero -> refl mz ;
    suc j -> refl mz } ;
  piS-zero (n : Nat) (ih : (j : Nat) -> Id M (pi n (\ i j' -> mz) j) mz) : (j : Nat) -> Id M (pi (suc n) (\ i j' -> mz) j) mz = split {
    zero -> refl mz ;
    suc j -> ih j } ;
  pi-zero : (n : Nat) (j : Nat) -> Id M (pi n (\ i j' -> mz) j) mz = split {
    zero -> pi0-zero ;
    suc n | ih -> piS-zero n ih } ;

  pi-van : (n : Nat) (D : DS) -> SQ.Van (suc n) (pi n D) = split {
    zero -> \ D j -> refl mz ;
    suc n | ih -> \ D j -> ih (\ i j' -> D i (suc j')) j } ;

  -- (ii)
  pi-U0 (D : DS) : (j : Nat) -> Id M (pi zero (dU D) j) mz = split {
    zero -> refl mz ;
    suc j -> refl mz } ;
  piU-zero (D : DS) : (j : Nat) -> Id M (pi (suc zero) (dU D) j) (pi zero D j) = split {
    zero -> refl (D zero zero) ;
    suc j -> pi-U0 (\ i j' -> D i (suc j')) j } ;
  piU-suc (n : Nat) (ih : (D : DS) (j : Nat) -> Id M (pi (suc n) (dU D) j) (pi n D j))
    (D : DS) : (j : Nat) -> Id M (pi (suc (suc n)) (dU D) j) (pi (suc n) D j) = split {
    zero -> refl (D (suc n) zero) ;
    suc j -> ih (\ i j' -> D i (suc j')) j } ;
  pi-U : (n : Nat) (D : DS) (j : Nat) -> Id M (pi (suc n) (dU D) j) (pi n D j) = split {
    zero -> piU-zero ;
    suc n | ih -> piU-suc n ih } ;

  -- (iii)
  pi-V0 (D : DS) : (j : Nat) -> Id M (pi zero (dV D) j) mz = split {
    zero -> refl mz ;
    suc j -> refl mz } ;
  pi-V (n : Nat) (D : DS) : (j : Nat) -> Id M (pi (suc n) (dV D) j) (SQ.Xs (pi n D) j) = split {
    zero -> refl mz ;
    suc j -> refl (pi n D j) } ;

  -- (iv)
  pi-C0 (m : M) : (j : Nat) -> Id M (pi zero (dC m) j) (SQ.cst m j) = split {
    zero -> refl m ;
    suc j -> refl mz } ;
  pi-C (n : Nat) (m : M) : (j : Nat) -> Id M (pi (suc n) (dC m) j) mz = split {
    zero -> refl mz ;
    suc j -> trans (pi-cong n (\ i j' -> SQ.cst mz i) (\ i j' -> mz) (\ i j' -> SQ.cst-zero i) j) (pi-zero n j) } ;
} ;

------------------------------------------------------------------------
-- R' = A[U][V]

module Over (A : CRing) (setA : Pr.isSet A.R) (r : Nat) {
  module P1 = PolyCoef[l].Over[A,setA] ;
  module P2 = PolyCoef[l].Over[P1.S,P1.E.set] ;
  module Fr = Comb[l].Free[A,r] ; module F2 = Comb[l].Free[P2.S,r] ;
  module DP = Pi[A,Fr.mod] ;
  module SQ = SeqPoly[l].Over[A,Fr.mod] ;
  module FL = IP.ModL[A,Fr.mod] ;

  -- the constants of A, U and V in R'
  cR (c : A.R) : P2.K = P2.E.constant (P1.E.constant c) ;
  vU : P2.K = P2.E.constant P1.E.variable ;
  vV : P2.K = P2.E.variable ;
  -- M = A^r in R'^r
  lift (m : Fr.Vec) : F2.Vec = \ k -> cR (m k) ;

  cR-zero : Id P2.K (cR A.z) P2.E.zeroQ =
    trans (ap P2.E.constant (RingHom[l].zero A P1.S P1.E.inclusion)) (RingHom[l].zero P1.S P2.S P2.E.inclusion) ;
  lift-add (x y : Fr.Vec) : Id F2.Vec (lift (Fr.mod.madd x y)) (F2.mod.madd (lift x) (lift y)) =
    F2.ext (lift (Fr.mod.madd x y)) (F2.mod.madd (lift x) (lift y)) (\ k ->
      trans (ap P2.E.constant (P1.E.constant-add (x k) (y k))) (P2.E.constant-add (P1.E.constant (x k)) (P1.E.constant (y k)))) ;
  lift-sm (c : A.R) (x : Fr.Vec) : Id F2.Vec (lift (Fr.mod.sm c x)) (F2.mod.sm (cR c) (lift x)) =
    F2.ext (lift (Fr.mod.sm c x)) (F2.mod.sm (cR c) (lift x)) (\ k ->
      trans (ap P2.E.constant (P1.E.constant-mul c (x k))) (P2.E.constant-mul (P1.E.constant c) (P1.E.constant (x k)))) ;
  lift-zero : Id F2.Vec (lift Fr.mod.mz) F2.mod.mz = F2.ext (lift Fr.mod.mz) F2.mod.mz (\ k -> cR-zero) ;
  module F2L = IP.ModL[P2.S,F2.mod] ;
  lift-comb : (p : Nat) (c : Fin p -> A.R) (u : Fin p -> Fr.Vec) ->
    Id F2.Vec (lift (Fr.VS.comb p c u)) (F2.VS.comb p (\ i -> cR (c i)) (\ i -> lift (u i))) = split {
    zero -> \ c u -> lift-zero ;
    suc p | ih -> \ c u ->
      trans (lift-add (Fr.mod.sm (c (inr tt)) (u (inr tt))) (Fr.VS.comb p (\ i -> c (inl i)) (\ i -> u (inl i))))
        (F2L.G.cong-add (lift-sm (c (inr tt)) (u (inr tt))) (ih (\ i -> c (inl i)) (\ i -> u (inl i)))) } ;

  -- the coefficients of U^i V^j of the coordinates of H
  dd (H : F2.Vec) : DP.DS = \ i j k -> P1.kap (P2.kap (H k) j) i ;
  -- pi_n
  pi (n : Nat) (H : F2.Vec) : SQ.Seq = DP.pi n (dd H) ;

  hp1 (s s' : P1.Seq) (e : Id P1.Seq s s') (i : Nat) : Id A.R (s i) (s' i) = Pr.happly Nat (\ t -> A.R) s s' e i ;
  hp2 (s s' : P2.Seq) (e : Id P2.Seq s s') (j : Nat) : Id P1.K (s j) (s' j) = Pr.happly Nat (\ t -> P1.K) s s' e j ;

  ------------------------------------------------------------------------
  -- dd

  dd-add (H H' : F2.Vec) (i j : Nat) : Id Fr.Vec (dd (F2.mod.madd H H') i j) (Fr.mod.madd (dd H i j) (dd H' i j)) =
    Fr.ext _ _ (\ k ->
      trans (ap (\ t -> P1.kap t i) (hp2 _ _ (P2.kap-add (H k) (H' k)) j))
            (hp1 _ _ (P1.kap-add (P2.kap (H k) j) (P2.kap (H' k) j)) i)) ;
  dd-sm (c : A.R) (H : F2.Vec) (i j : Nat) : Id Fr.Vec (dd (F2.mod.sm (cR c) H) i j) (Fr.mod.sm c (dd H i j)) =
    Fr.ext _ _ (\ k ->
      trans (ap (\ t -> P1.kap t i) (hp2 _ _ (P2.kap-cmul (P1.E.constant c) (H k)) j))
            (hp1 _ _ (P1.kap-cmul c (P2.kap (H k) j)) i)) ;
  dd-zero (i j : Nat) : Id Fr.Vec (dd F2.mod.mz i j) Fr.mod.mz =
    Fr.ext _ _ (\ k -> trans (ap (\ t -> P1.kap t i) (hp2 _ _ P2.kap-zero j)) (hp1 _ _ P1.kap-zero i)) ;

  -- X in A and in A^r
  xs-at (g : SQ.Seq) (k : Fin r) : (i : Nat) -> Id A.R (P1.SQ.Xs (\ i' -> g i' k) i) (SQ.Xs g i k) = split {
    zero -> refl A.z ;
    suc i -> refl (g i k) } ;
  dd-U (H : F2.Vec) (i j : Nat) : Id Fr.Vec (dd (F2.mod.sm vU H) i j) (DP.dU (dd H) i j) =
    Fr.ext _ _ (\ k ->
      trans (ap (\ t -> P1.kap t i) (hp2 _ _ (P2.kap-cmul P1.E.variable (H k)) j))
        (trans (P1.kap-X-at (P2.kap (H k) j) i) (xs-at (\ i' -> dd H i' j) k i))) ;

  dv-at (H : F2.Vec) (i : Nat) (k : Fin r) : (j : Nat) -> Id A.R (P1.kap (P2.SQ.Xs (P2.kap (H k)) j) i) (SQ.Xs (dd H i) j k) = split {
    zero -> hp1 _ _ P1.kap-zero i ;
    suc j -> refl (dd H i j k) } ;
  dd-V (H : F2.Vec) (i j : Nat) : Id Fr.Vec (dd (F2.mod.sm vV H) i j) (DP.dV (dd H) i j) =
    Fr.ext _ _ (\ k -> trans (ap (\ t -> P1.kap t i) (P2.kap-X-at (H k) j)) (dv-at H i k j)) ;

  -- a constant: the coefficient of degree 0 in V, then in U
  dl0 (m : Fr.Vec) (k : Fin r) : (i : Nat) -> Id A.R (P1.cseq (m k) i) (SQ.cst (SQ.cst m zero) i k) = split {
    zero -> refl (m k) ;
    suc i -> refl A.z } ;
  dl1 (m : Fr.Vec) (j : Nat) (k : Fin r) : (i : Nat) -> Id A.R A.z (SQ.cst (SQ.cst m (suc j)) i k) = split {
    zero -> refl A.z ;
    suc i -> refl A.z } ;
  dl-at (m : Fr.Vec) (i : Nat) (k : Fin r) : (j : Nat) -> Id A.R (P1.kap (P2.cseq (P1.E.constant (m k)) j) i) (DP.dC m i j k) = split {
    zero -> trans (hp1 _ _ (P1.kap-const (m k)) i) (dl0 m k i) ;
    suc j -> trans (hp1 _ _ P1.kap-zero i) (dl1 m j k i) } ;
  dd-lift (m : Fr.Vec) (i j : Nat) : Id Fr.Vec (dd (lift m) i j) (DP.dC m i j) =
    Fr.ext _ _ (\ k -> trans (ap (\ t -> P1.kap t i) (hp2 _ _ (P2.kap-const (P1.E.constant (m k))) j)) (dl-at m i k j)) ;

  ------------------------------------------------------------------------
  -- Lemma pi on R'^r

  pi-add (n : Nat) (H H' : F2.Vec) (j : Nat) : Id Fr.Vec (pi n (F2.mod.madd H H') j) (Fr.mod.madd (pi n H j) (pi n H' j)) =
    trans (DP.pi-cong n (dd (F2.mod.madd H H')) (\ i j' -> Fr.mod.madd (dd H i j') (dd H' i j')) (dd-add H H') j)
          (DP.pi-add n (dd H) (dd H') j) ;
  pi-sm (n : Nat) (c : A.R) (H : F2.Vec) (j : Nat) : Id Fr.Vec (pi n (F2.mod.sm (cR c) H) j) (Fr.mod.sm c (pi n H j)) =
    trans (DP.pi-cong n (dd (F2.mod.sm (cR c) H)) (\ i j' -> Fr.mod.sm c (dd H i j')) (dd-sm c H) j)
          (DP.pi-sm n c (dd H) j) ;
  pi-zero (n : Nat) (j : Nat) : Id Fr.Vec (pi n F2.mod.mz j) Fr.mod.mz =
    trans (DP.pi-cong n (dd F2.mod.mz) (\ i j' -> Fr.mod.mz) dd-zero j) (DP.pi-zero n j) ;
  pi-U0 (H : F2.Vec) (j : Nat) : Id Fr.Vec (pi zero (F2.mod.sm vU H) j) Fr.mod.mz =
    trans (DP.pi-cong zero (dd (F2.mod.sm vU H)) (DP.dU (dd H)) (dd-U H) j) (DP.pi-U0 (dd H) j) ;
  pi-U (n : Nat) (H : F2.Vec) (j : Nat) : Id Fr.Vec (pi (suc n) (F2.mod.sm vU H) j) (pi n H j) =
    trans (DP.pi-cong (suc n) (dd (F2.mod.sm vU H)) (DP.dU (dd H)) (dd-U H) j) (DP.pi-U n (dd H) j) ;
  pi-V0 (H : F2.Vec) (j : Nat) : Id Fr.Vec (pi zero (F2.mod.sm vV H) j) Fr.mod.mz =
    trans (DP.pi-cong zero (dd (F2.mod.sm vV H)) (DP.dV (dd H)) (dd-V H) j) (DP.pi-V0 (dd H) j) ;
  pi-V (n : Nat) (H : F2.Vec) (j : Nat) : Id Fr.Vec (pi (suc n) (F2.mod.sm vV H) j) (SQ.Xs (pi n H) j) =
    trans (DP.pi-cong (suc n) (dd (F2.mod.sm vV H)) (DP.dV (dd H)) (dd-V H) j) (DP.pi-V n (dd H) j) ;
  pi-lift0 (m : Fr.Vec) (j : Nat) : Id Fr.Vec (pi zero (lift m) j) (SQ.cst m j) =
    trans (DP.pi-cong zero (dd (lift m)) (DP.dC m) (dd-lift m) j) (DP.pi-C0 m j) ;
  pi-lift (n : Nat) (m : Fr.Vec) (j : Nat) : Id Fr.Vec (pi (suc n) (lift m) j) Fr.mod.mz =
    trans (DP.pi-cong (suc n) (dd (lift m)) (DP.dC m) (dd-lift m) j) (DP.pi-C n m j) ;
  pi-van (n : Nat) (H : F2.Vec) : SQ.Van (suc n) (pi n H) = DP.pi-van n (dd H) ;
  -- the same, as equalities of sequences
  pi-add' (n : Nat) (H H' : F2.Vec) : Id SQ.Seq (pi n (F2.mod.madd H H')) (SQ.seq.madd (pi n H) (pi n H')) =
    SQ.sext (pi n (F2.mod.madd H H')) (SQ.seq.madd (pi n H) (pi n H')) (pi-add n H H') ;
  pi-sm' (n : Nat) (c : A.R) (H : F2.Vec) : Id SQ.Seq (pi n (F2.mod.sm (cR c) H)) (SQ.seq.sm c (pi n H)) =
    SQ.sext (pi n (F2.mod.sm (cR c) H)) (SQ.seq.sm c (pi n H)) (pi-sm n c H) ;
  pi-zero' (n : Nat) : Id SQ.Seq (pi n F2.mod.mz) SQ.seq.mz = SQ.sext (pi n F2.mod.mz) SQ.seq.mz (pi-zero n) ;
  pi-U0' (H : F2.Vec) : Id SQ.Seq (pi zero (F2.mod.sm vU H)) SQ.seq.mz = SQ.sext (pi zero (F2.mod.sm vU H)) SQ.seq.mz (pi-U0 H) ;
  pi-U' (n : Nat) (H : F2.Vec) : Id SQ.Seq (pi (suc n) (F2.mod.sm vU H)) (pi n H) = SQ.sext (pi (suc n) (F2.mod.sm vU H)) (pi n H) (pi-U n H) ;
  pi-V0' (H : F2.Vec) : Id SQ.Seq (pi zero (F2.mod.sm vV H)) SQ.seq.mz = SQ.sext (pi zero (F2.mod.sm vV H)) SQ.seq.mz (pi-V0 H) ;
  pi-V' (n : Nat) (H : F2.Vec) : Id SQ.Seq (pi (suc n) (F2.mod.sm vV H)) (SQ.Xs (pi n H)) =
    SQ.sext (pi (suc n) (F2.mod.sm vV H)) (SQ.Xs (pi n H)) (pi-V n H) ;
  pi-lift' (n : Nat) (m : Fr.Vec) : Id SQ.Seq (pi (suc n) (lift m)) SQ.seq.mz = SQ.sext (pi (suc n) (lift m)) SQ.seq.mz (pi-lift n m) ;

  ------------------------------------------------------------------------
  -- iota_n

  -- U^k x
  uit : Nat -> F2.Vec -> F2.Vec = split {
    zero -> \ x -> x ;
    suc k | ih -> \ x -> F2.mod.sm vU (ih x) } ;
  pi-uit : (k : Nat) (x : F2.Vec) (j : Nat) -> Id Fr.Vec (pi k (uit k x) j) (pi zero x j) = split {
    zero -> \ x j -> refl (pi zero x j) ;
    suc k | ih -> \ x j -> trans (pi-U k (uit k x) j) (ih x j) } ;

  iota : Nat -> SQ.Seq -> F2.Vec = split {
    zero -> \ g -> lift (g zero) ;
    suc n | ih -> \ g -> F2.mod.madd (uit (suc n) (lift (g zero))) (F2.mod.sm vV (ih (\ j -> g (suc j)))) } ;

  iota0-pi (g : SQ.Seq) (v : SQ.Van (suc zero) g) : (j : Nat) -> Id Fr.Vec (SQ.cst (g zero) j) (g j) = split {
    zero -> refl (g zero) ;
    suc j -> sym (v j) } ;
  -- g_0 constant + X (g . suc) = g
  iotaS-pi (g : SQ.Seq) (p : SQ.Seq) (e : (j : Nat) -> Id Fr.Vec (p j) (g (suc j))) :
    (j : Nat) -> Id Fr.Vec (Fr.mod.madd (SQ.cst (g zero) j) (SQ.Xs p j)) (g j) = split {
    zero -> Fr.mod.maddZ (g zero) ;
    suc j -> trans (FL.G.zl (p j)) (e j) } ;
  iota-pi : (n : Nat) (g : SQ.Seq) -> SQ.Van (suc n) g -> (j : Nat) -> Id Fr.Vec (pi n (iota n g) j) (g j) = split {
    zero -> \ g v j -> trans (pi-lift0 (g zero) j) (iota0-pi g v j) ;
    suc n | ih -> \ g v j ->
      trans (pi-add (suc n) (uit (suc n) (lift (g zero))) (F2.mod.sm vV (iota n (\ j' -> g (suc j')))) j)
        (trans (FL.G.cong-add (trans (pi-uit (suc n) (lift (g zero)) j) (pi-lift0 (g zero) j))
                              (pi-V n (iota n (\ j' -> g (suc j'))) j))
          (iotaS-pi g (pi n (iota n (\ j' -> g (suc j')))) (ih (\ j' -> g (suc j')) (\ j' -> v j')) j)) } ;

  ------------------------------------------------------------------------
  -- Lemma rind

  module RInd (Md : IP.Mod[P2.S]) (P : Md.M -> U l) (pP : (x : Md.M) -> Pr.isProp (P x))
    (pz : P Md.mz) (padd : (x y : Md.M) -> P x -> P y -> P (Md.madd x y))
    (pc : (c : A.R) (x : Md.M) -> P x -> P (Md.sm (cR c) x))
    (pU : (x : Md.M) -> P x -> P (Md.sm vU x)) (pV : (x : Md.M) -> P x -> P (Md.sm vV x)) {
    open Md ; module ML = IP.ModL[P2.S,Md] ;

    -- the constants of R1 = A[U]
    const-hor (h : P1.K) :
      Id P2.K (P2.E.constant (P1.hor h)) (P2.E.addQ (cR (P1.c0 h)) (P2.E.mulQ vU (P2.E.constant (P1.PC.tail h)))) =
      trans (P2.E.constant-add (P1.E.constant (P1.c0 h)) (P1.E.mulQ P1.E.variable (P1.PC.tail h)))
        (ap (P2.E.addQ (cR (P1.c0 h))) (P2.E.constant-mul P1.E.variable (P1.PC.tail h))) ;
    sm-hor1 (h : P1.K) (x : M) :
      Id M (sm (P2.E.constant h) x) (madd (sm (cR (P1.c0 h)) x) (sm vU (sm (P2.E.constant (P1.PC.tail h)) x))) =
      trans (ap (\ t -> sm (P2.E.constant t) x) (P1.horner h))
        (trans (ap (\ t -> sm t x) (const-hor h))
          (trans (smE (cR (P1.c0 h)) (P2.E.mulQ vU (P2.E.constant (P1.PC.tail h))) x)
            (ap (madd (sm (cR (P1.c0 h)) x)) (sym (smA vU (P2.E.constant (P1.PC.tail h)) x))))) ;
    sm-const0 (h : P1.K) (v : P1.SQ.Van zero (P1.kap h)) (x : M) : Id M (sm (P2.E.constant h) x) mz =
      trans (ap (\ t -> sm (P2.E.constant t) x) (P1.van-zero-eq h v))
        (trans (ap (\ t -> sm t x) (RingHom[l].zero P1.S P2.S P2.E.inclusion)) (ML.zero-sm x)) ;
    inner : (d : Nat) (h : P1.K) -> P1.SQ.Van d (P1.kap h) -> (x : M) -> P x -> P (sm (P2.E.constant h) x) = split {
      zero -> \ h v x px -> subst P (sym (sm-const0 h v x)) pz ;
      suc d | ih -> \ h v x px -> subst P (sym (sm-hor1 h x))
        (padd (sm (cR (P1.c0 h)) x) (sm vU (sm (P2.E.constant (P1.PC.tail h)) x)) (pc (P1.c0 h) x px)
          (pU (sm (P2.E.constant (P1.PC.tail h)) x) (ih (P1.PC.tail h) (P1.tail-van h d v) x px))) } ;
    with-const (h : P1.K) (x : M) (px : P x) : P (sm (P2.E.constant h) x) =
      Tr.Trunc[P1.Bound h].induction @l (\ t -> P (sm (P2.E.constant h) x)) (\ t -> pP (sm (P2.E.constant h) x))
        (\ b -> inner b.1 h b.2 x px) (P1.bound h) ;

    -- R' = R1[V]
    sm-hor2 (h : P2.K) (x : M) :
      Id M (sm h x) (madd (sm (P2.E.constant (P2.c0 h)) x) (sm vV (sm (P2.PC.tail h) x))) =
      trans (ap (\ t -> sm t x) (P2.horner h))
        (trans (smE (P2.E.constant (P2.c0 h)) (P2.E.mulQ vV (P2.PC.tail h)) x)
          (ap (madd (sm (P2.E.constant (P2.c0 h)) x)) (sym (smA vV (P2.PC.tail h) x)))) ;
    outer : (d : Nat) (h : P2.K) -> P2.SQ.Van d (P2.kap h) -> (x : M) -> P x -> P (sm h x) = split {
      zero -> \ h v x px -> subst P (sym (trans (ap (\ t -> sm t x) (P2.van-zero-eq h v)) (ML.zero-sm x))) pz ;
      suc d | ih -> \ h v x px -> subst P (sym (sm-hor2 h x))
        (padd (sm (P2.E.constant (P2.c0 h)) x) (sm vV (sm (P2.PC.tail h) x)) (with-const (P2.c0 h) x px)
          (pV (sm (P2.PC.tail h) x) (ih (P2.PC.tail h) (P2.tail-van h d v) x px))) } ;
    rind (h : P2.K) (x : M) (px : P x) : P (sm h x) =
      Tr.Trunc[P2.Bound h].induction @l (\ t -> P (sm h x)) (\ t -> pP (sm h x))
        (\ b -> outer b.1 h b.2 x px) (P2.bound h) ;
  } ;

  ------------------------------------------------------------------------
  -- total degree

  TotVan (c : Nat) (H : F2.Vec) : U l = (m : Nat) (j : Nat) -> Id Fr.Vec (pi (plus m c) H j) Fr.mod.mz ;
  TV (H : F2.Vec) : U l = (c : Nat) * TotVan c H ;
  Deg (H : F2.Vec) : U l = Tr.Trunc[TV H].carrier ;

  tv-up (e c : Nat) (H : F2.Vec) (h : TotVan c H) : TotVan (plus e c) H = \ m j ->
    subst (\ n -> Id Fr.Vec (pi n H j) Fr.mod.mz) (plus-assoc m e c) (h (plus m e) j) ;
  tv-up' (e c : Nat) (H : F2.Vec) (h : TotVan c H) : TotVan (plus c e) H =
    subst (\ n -> TotVan n H) (plus-comm e c) (tv-up e c H h) ;

  tv-zero : TotVan zero F2.mod.mz = \ m j -> pi-zero (plus m zero) j ;
  tv-add (H H' : F2.Vec) (w : TV H) (w' : TV H') : TV (F2.mod.madd H H') =
    (plus w'.1 w.1, \ m j ->
      trans (pi-add (plus m (plus w'.1 w.1)) H H' j)
        (trans (FL.G.cong-add (tv-up w'.1 w.1 H w.2 m j) (tv-up' w.1 w'.1 H' w'.2 m j)) (Fr.mod.maddZ Fr.mod.mz))) ;
  tv-sm (c : A.R) (H : F2.Vec) (w : TV H) : TV (F2.mod.sm (cR c) H) =
    (w.1, \ m j -> trans (pi-sm (plus m w.1) c H j) (trans (ap (Fr.mod.sm c) (w.2 m j)) (FL.sm-zero c))) ;
  tv-U (H : F2.Vec) (w : TV H) : TV (F2.mod.sm vU H) =
    (suc w.1, \ m j -> subst (\ n -> Id Fr.Vec (pi n (F2.mod.sm vU H) j) Fr.mod.mz) (sym (plus-suc m w.1))
      (trans (pi-U (plus m w.1) H j) (w.2 m j))) ;
  xs-vanish (g : SQ.Seq) (h : (j : Nat) -> Id Fr.Vec (g j) Fr.mod.mz) : (j : Nat) -> Id Fr.Vec (SQ.Xs g j) Fr.mod.mz = split {
    zero -> refl Fr.mod.mz ;
    suc j -> h j } ;
  tv-V (H : F2.Vec) (w : TV H) : TV (F2.mod.sm vV H) =
    (suc w.1, \ m j -> subst (\ n -> Id Fr.Vec (pi n (F2.mod.sm vV H) j) Fr.mod.mz) (sym (plus-suc m w.1))
      (trans (pi-V (plus m w.1) H j) (xs-vanish (pi (plus m w.1) H) (w.2 m) j))) ;
  tv-lift (x : Fr.Vec) : TotVan (suc zero) (lift x) = \ m j ->
    subst (\ n -> Id Fr.Vec (pi n (lift x) j) Fr.mod.mz) (sym (plus-suc m zero)) (pi-lift (plus m zero) x j) ;

  deg-prop (H : F2.Vec) : Pr.isProp (Deg H) = Tr.Trunc[TV H].proposition ;
  deg (c : Nat) (H : F2.Vec) (h : TotVan c H) : Deg H = Tr.Trunc[TV H].inc (c, h) ;
  module DI = RInd[F2.mod, Deg, deg-prop, deg zero F2.mod.mz tv-zero,
    \ x y -> TC.map2 (TV x) (TV y) (TV (F2.mod.madd x y)) (tv-add x y),
    \ c x -> TC.map (TV x) (TV (F2.mod.sm (cR c) x)) (tv-sm c x),
    \ x -> TC.map (TV x) (TV (F2.mod.sm vU x)) (tv-U x),
    \ x -> TC.map (TV x) (TV (F2.mod.sm vV x)) (tv-V x)] ;

  -- the standard basis of R'^r is the lift of that of A^r
  module BA = FreeCoherent[l].Basis[A] ; module B2 = FreeCoherent[l].Basis[P2.S] ;
  basis-inl (k : Nat) (ih : (j i : Fin k) -> Id P2.K (B2.basis k j i) (cR (BA.basis k j i))) (j : Fin k) :
    (i : Fin (suc k)) -> Id P2.K (B2.basis (suc k) (inl j) i) (cR (BA.basis (suc k) (inl j) i)) = split {
    inl i -> ih j i ;
    inr t -> sym cR-zero } ;
  basis-inr (k : Nat) : (i : Fin (suc k)) -> Id P2.K (B2.basis (suc k) (inr tt) i) (cR (BA.basis (suc k) (inr tt) i)) = split {
    inl i -> sym cR-zero ;
    inr t -> refl P2.E.oneQ } ;
  basis-row (k : Nat) (ih : (j i : Fin k) -> Id P2.K (B2.basis k j i) (cR (BA.basis k j i))) :
    (j : Fin (suc k)) (i : Fin (suc k)) -> Id P2.K (B2.basis (suc k) j i) (cR (BA.basis (suc k) j i)) = split {
    inl j -> basis-inl k ih j ;
    inr t -> basis-inr k } ;
  basis-lift : (k : Nat) (j i : Fin k) -> Id P2.K (B2.basis k j i) (cR (BA.basis k j i)) = split {
    zero -> \ j i -> absurd (Id P2.K (B2.basis zero j i) (cR (BA.basis zero j i))) j ;
    suc k | ih -> basis-row k ih } ;
  deg-basis (j : Fin r) : Deg (B2.basis r j) =
    subst Deg (sym (F2.ext (B2.basis r j) (lift (BA.basis r j)) (basis-lift r j))) (deg (suc zero) (lift (BA.basis r j)) (tv-lift (BA.basis r j))) ;

  deg-sum : (p : Nat) (f : Fin p -> F2.Vec) -> ((i : Fin p) -> Deg (f i)) -> Deg (F2.VS.sum p f) = split {
    zero -> \ f h -> deg zero F2.mod.mz tv-zero ;
    suc p | ih -> \ f h -> TC.map2 (TV (f (inr tt))) (TV (F2.VS.sum p (\ i -> f (inl i))))
      (TV (F2.mod.madd (f (inr tt)) (F2.VS.sum p (\ i -> f (inl i)))))
      (tv-add (f (inr tt)) (F2.VS.sum p (\ i -> f (inl i)))) (h (inr tt)) (ih (\ i -> f (inl i)) (\ i -> h (inl i))) } ;
  -- every H in R'^r merely has a total degree
  deg-all (H : F2.Vec) : Deg H =
    subst Deg (B2.vec-basis r H)
      (deg-sum r (\ k -> F2.mod.sm (H k) (B2.basis r k)) (\ k -> DI.rind (H k) (B2.basis r k) (deg-basis k))) ;
} ;
