-- FreeCoherent.seg: coherence (C) of the free modules A^r over a coherent
-- ring (artin-rees.tex, Prop. 3, part (C)).
--
-- r = 0: every family of A^0 has all of A^k as syzygies, generated by the
-- standard basis (vec-basis).
-- r + 1: A^(r+1) = A^r + A with last coordinate pi and the rest rho.  For
-- u_1..u_k, the syzygies tau^1..tau^p of pi u (coherence of A) give
-- w_j = sum_i tau^j_i u_i with pi w_j = 0; the syzygies rs^1..rs^q of
-- rho w (induction) give the generators gens_l = sum_j rs^l_j tau^j.  If
-- sum c_i u_i = 0 then c = sum d_j tau^j, sum d_j rho w_j = 0, so
-- d = sum f_l rs^l and c = sum f_l gens_l (Bilinear.comb-comb).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
-- the standard basis (no coherence used)
module Basis (A : CRing) {
  module RS = Comb[l].Sums[A,IP.regular A] ; module RL = RL[A] ;
  Vec (r : Nat) : U l = Comb[l].Free[A,r].Vec ;

  basis-inl (k : Nat) (b : Fin k -> Fin k -> A.R) (j : Fin k) : Plus (Fin k) Top -> A.R = split {
    inl i -> b j i ; inr t -> A.z } ;
  basis-inr (k : Nat) : Plus (Fin k) Top -> A.R = split { inl i -> A.z ; inr t -> A.o } ;
  basis-row (k : Nat) (b : Fin k -> Fin k -> A.R) : Plus (Fin k) Top -> Plus (Fin k) Top -> A.R = split {
    inl j -> basis-inl k b j ; inr t -> basis-inr k } ;
  basis : (k : Nat) -> Fin k -> Fin k -> A.R = split {
    zero -> \ j i -> A.z ;
    suc k | b -> basis-row k b } ;

  basis-top (k : Nat) (c : Vec (suc k)) : (t : Top) ->
    Id A.R (RS.comb (suc k) c (\ j -> basis (suc k) j (inr t))) (c (inr t)) = split {
    tt -> trans (ap (A.add (A.mul (c (inr tt)) A.o))
                  (RS.comb-vanish k (\ j -> c (inl j)) (\ j -> A.z) (\ j -> refl A.z)))
           (trans (A.addZ (A.mul (c (inr tt)) A.o)) (A.mulO (c (inr tt)))) } ;
  basis-suc (k : Nat) (ih : (c : Vec k) (i : Fin k) -> Id A.R (RS.comb k c (\ j -> basis k j i)) (c i))
    (c : Vec (suc k)) : (i : Plus (Fin k) Top) -> Id A.R (RS.comb (suc k) c (\ j -> basis (suc k) j i)) (c i) = split {
    inl i -> trans (ap (\ t -> A.add t (RS.comb k (\ j -> c (inl j)) (\ j -> basis k j i))) (RL.mul-zero (c (inr tt))))
               (trans (RL.zl (RS.comb k (\ j -> c (inl j)) (\ j -> basis k j i))) (ih (\ j -> c (inl j)) i)) ;
    inr t -> basis-top k c t } ;
  comb-basis : (k : Nat) (c : Vec k) (i : Fin k) -> Id A.R (RS.comb k c (\ j -> basis k j i)) (c i) = split {
    zero -> \ c i -> absurd (Id A.R A.z (c i)) i ;
    suc k | ih -> basis-suc k ih } ;
  vec-basis (k : Nat) (c : Vec k) : Id (Vec k) (Comb[l].Free[A,k].VS.comb k c (basis k)) c =
    Comb[l].Free[A,k].ext (Comb[l].Free[A,k].VS.comb k c (basis k)) c
      (\ i -> trans (Comb[l].Free[A,k].comb-at k c (basis k) i) (comb-basis k c i)) ;
  -- the row e_j against a family: sum_i e_j,i u_i = u_j
  row-top (k : Nat) (u : Fin (suc k) -> A.R) : (t : Top) ->
    Id A.R (RS.comb (suc k) (basis (suc k) (inr t)) u) (u (inr t)) = split {
    tt -> trans (ap (A.add (A.mul A.o (u (inr tt)))) (RS.comb-zero k (\ i -> u (inl i))))
           (trans (A.addZ (A.mul A.o (u (inr tt)))) (RL.one-left (u (inr tt)))) } ;
  row-suc (k : Nat) (ih : (j : Fin k) (u : Fin k -> A.R) -> Id A.R (RS.comb k (basis k j) u) (u j))
    (u : Fin (suc k) -> A.R) : (j : Plus (Fin k) Top) -> Id A.R (RS.comb (suc k) (basis (suc k) j) u) (u j) = split {
    inl j -> trans (ap (\ t -> A.add t (RS.comb k (basis k j) (\ i -> u (inl i)))) (RL.zero-mul (u (inr tt))))
               (trans (RL.zl (RS.comb k (basis k j) (\ i -> u (inl i)))) (ih j (\ i -> u (inl i)))) ;
    inr t -> row-top k u t } ;
  comb-row : (k : Nat) (j : Fin k) (u : Fin k -> A.R) -> Id A.R (RS.comb k (basis k j) u) (u j) = split {
    zero -> \ j u -> absurd (Id A.R A.z (u j)) j ;
    suc k | ih -> \ j u -> row-suc k ih u j } ;

} ;

module Over (A : CRing) (coh : Coherent[l].Over[A,IP.regular A].Coh) {
  module RS = Comb[l].Sums[A,IP.regular A] ; module RL = RL[A] ;
  module CR = Coherent[l].Over[A,IP.regular A] ;
  Vec (r : Nat) : U l = Comb[l].Free[A,r].Vec ;
  V (r : Nat) : IP.Mod[A] = Comb[l].Free[A,r].mod ;

  basis (k : Nat) : Fin k -> Fin k -> A.R = Basis[A].basis k ;
  vec-basis (k : Nat) (c : Vec k) : Id (Vec k) (Comb[l].Free[A,k].VS.comb k c (basis k)) c = Basis[A].vec-basis k c ;

  ------------------------------------------------------------------------
  -- A^(r+1) = A^r + A

  last (r : Nat) (v : Vec (suc r)) : A.R = v (inr tt) ;
  rest (r : Nat) (v : Vec (suc r)) : Vec r = \ i -> v (inl i) ;

  pi-comb (r k : Nat) (c : Vec k) (u : Fin k -> Vec (suc r)) :
    Id A.R (last r (Comb[l].Free[A,suc r].VS.comb k c u)) (RS.comb k c (\ j -> last r (u j))) =
    Comb[l].Free[A,suc r].comb-at k c u (inr tt) ;
  rho-comb (r k : Nat) (c : Vec k) (u : Fin k -> Vec (suc r)) :
    Id (Vec r) (rest r (Comb[l].Free[A,suc r].VS.comb k c u)) (Comb[l].Free[A,r].VS.comb k c (\ j -> rest r (u j))) =
    Comb[l].Free[A,r].ext (rest r (Comb[l].Free[A,suc r].VS.comb k c u)) (Comb[l].Free[A,r].VS.comb k c (\ j -> rest r (u j)))
      (\ i -> trans (Comb[l].Free[A,suc r].comb-at k c u (inl i)) (sym (Comb[l].Free[A,r].comb-at k c (\ j -> rest r (u j)) i))) ;

  parts-top (r : Nat) (v w : Vec (suc r)) (h1 : Id A.R (last r v) (last r w)) : (t : Top) -> Id A.R (v (inr t)) (w (inr t)) = split {
    tt -> h1 } ;
  parts-at (r : Nat) (v w : Vec (suc r)) (h1 : Id A.R (last r v) (last r w)) (h2 : Id (Vec r) (rest r v) (rest r w)) :
    (k : Plus (Fin r) Top) -> Id A.R (v k) (w k) = split {
    inl i -> Pr.happly (Fin r) (\ i' -> A.R) (rest r v) (rest r w) h2 i ;
    inr t -> parts-top r v w h1 t } ;
  parts-eq (r : Nat) (v w : Vec (suc r)) (h1 : Id A.R (last r v) (last r w)) (h2 : Id (Vec r) (rest r v) (rest r w)) :
    Id (Vec (suc r)) v w = Comb[l].Free[A,suc r].ext v w (parts-at r v w h1 h2) ;

  ------------------------------------------------------------------------
  -- coherence of A^r

  vec0-eq (v w : Vec zero) : Id (Vec zero) v w = Comb[l].Free[A,zero].ext v w (\ i -> absurd (Id A.R (v i) (w i)) i) ;

  coh-zero (k : Nat) (u : Fin k -> Vec zero) : Tr.Trunc[Coherent[l].Over[A,V zero].CohW k u].carrier =
    Tr.Trunc[Coherent[l].Over[A,V zero].CohW k u].inc (k, (basis k,
      (\ j -> vec0-eq (Comb[l].Free[A,zero].VS.comb k (basis k j) u) (\ i -> A.z),
       \ c h -> Tr.Trunc[Coherent[l].Over[A,V zero].InFV k k (basis k) c].inc (c, vec-basis k c)))) ;

  module Step (r : Nat) (ih : Coherent[l].Over[A,V r].Coh) (k : Nat) (u : Fin k -> Vec (suc r)) {
    module CS = Coherent[l].Over[A,V (suc r)] ;
    module CV = Coherent[l].Over[A,V r] ;
    module VSk = Comb[l].Free[A,k].VS ;
    module VS1 = Comb[l].Free[A,suc r].VS ;
    module VSr = Comb[l].Free[A,r].VS ;
    pu (j : Fin k) : A.R = last r (u j) ;
    Goal : U l = Tr.Trunc[CS.CohW k u].carrier ;
    goal-prop : Pr.isProp Goal = Tr.Trunc[CS.CohW k u].proposition ;

    module Inner (p : Nat) (tau : Fin p -> Vec k) (tsyz : CR.SyzAll k pu p tau) (tuniv : CR.Univ k pu p tau) {
      w (j : Fin p) : Vec (suc r) = VS1.comb k (tau j) u ;
      rw (j : Fin p) : Vec r = rest r (w j) ;
      pw-zero (j : Fin p) : Id A.R (last r (w j)) A.z = trans (pi-comb r k (tau j) u) (tsyz j) ;

      module Inner2 (q : Nat) (rs : Fin q -> Vec p) (rsyz : CV.SyzAll p rw q rs) (runiv : CV.Univ p rw q rs) {
        gens (m : Fin q) : Vec k = Comb[l].Free[A,k].VS.comb p (rs m) tau ;
        gen-syz (m : Fin q) : CS.Syz k u (gens m) =
          trans (Comb[l].Bilinear[A,V (suc r)].comb-comb k p (rs m) tau u)
            (parts-eq r (VS1.comb p (rs m) w) (\ i -> A.z)
              (trans (pi-comb r p (rs m) w) (RS.comb-vanish p (rs m) (\ j -> last r (w j)) pw-zero))
              (trans (rho-comb r p (rs m) w) (rsyz m))) ;
        univ-gen (c : Vec k) (h : CS.Syz k u c) : CS.MemV k q gens c =
          Tr.Trunc[CR.InFV k p tau c].induction @l (\ t -> CS.MemV k q gens c) (\ t -> Tr.Trunc[CS.InFV k q gens c].proposition)
            (\ de -> Tr.Trunc[CV.InFV p q rs de.1].induction @l (\ t -> CS.MemV k q gens c) (\ t -> Tr.Trunc[CS.InFV k q gens c].proposition)
               (\ fq -> Tr.Trunc[CS.InFV k q gens c].inc (fq.1,
                  trans (sym (Comb[l].Bilinear[A,V k].comb-comb p q fq.1 rs tau))
                    (trans (ap (\ t -> VSk.comb p t tau) fq.2) de.2)))
               (runiv de.1
                 (trans (sym (rho-comb r p de.1 w))
                   (trans (ap (rest r) (sym (Comb[l].Bilinear[A,V (suc r)].comb-comb k p de.1 tau u)))
                     (trans (ap (\ t -> rest r (VS1.comb k t u)) de.2) (ap (rest r) h))))))
            (tuniv c (trans (sym (pi-comb r k c u)) (ap (last r) h))) ;
        result : Goal = Tr.Trunc[CS.CohW k u].inc (q, (gens, (gen-syz, univ-gen))) ;
      } ;
      result : Goal =
        Tr.Trunc[CV.CohW p rw].induction @l (\ t -> Goal) (\ t -> goal-prop)
          (\ x -> Inner2[x.1, x.2.1, x.2.2.1, x.2.2.2].result) (ih p rw) ;
    } ;
    result : Goal =
      Tr.Trunc[CR.CohW k pu].induction @l (\ t -> Goal) (\ t -> goal-prop)
        (\ x -> Inner[x.1, x.2.1, x.2.2.1, x.2.2.2].result) (coh k pu) ;
  } ;

  coh-vec : (r : Nat) -> Coherent[l].Over[A,V r].Coh = split {
    zero -> coh-zero ;
    suc r | ih -> \ k u -> Step[r, ih, k, u].result } ;
} ;
