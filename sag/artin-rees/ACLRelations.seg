-- ACLRelations.seg: artin-rees.tex §8, « La matrice des relations » and
-- « le module N », in the Cech model of sag/acl-zmt.
--
-- Notation (CechF1): P = PlP, Q = PlQ, homogeneous of degrees deg muP,
-- deg muQ; g = gg = muQ P - muP Q (gg-PQ); the generators of (F1) are
-- m_t = sigma(g X^t), t in ts = gens dg, and G rho = sum_t rho_t m_t;
-- N^1 = N1: the 1-cochains P U + Q V with U in S1 kP, V in S1 kQ
-- (kP = -1 - deg muP, kQ = -1 - deg muQ, written negsuc dn, negsuc en).
-- The data of HomLambda.Data, as in acl-zmt/CechZMTD0, in degree -1:
-- D0, P', Q' with P f = D0 (P' f), Q f = D0 (Q' f) (fP, fQ), (S0) for D0
-- (s0), (S1) for P', Q' at the degrees kP, kQ, with w of degree
-- kW = negsuc dW (s1; hW1, hW2: kW + deg Q' = kP, kW + deg P' = kQ).
--
-- q rho = sum_t rho_t X^t (degree -1 - dg), h eta = sum_s eta_s X^s,
-- s in gens dW (degree kW) (module LC);
--     al = muQ q - Q' h  (degree kP),   be = P' h - muP q  (degree kQ).
-- Definition (M).  M(rho,eta) = (al(u))_(u in gens dn) ++ (be(u))_(u in gens en):
--   the coefficients of pi(al) and pi(be) (pi-gens).
-- Lemma (G-sigma).  G rho = sigma(g q): sigma and the product by g are
--   linear (LinSum.map-comb).
-- Lemma (prim).  If M(rho,eta) = 0 then pi al = pi be = 0.  Let
--   c = G rho - (P sigma(al) + Q sigma(be)) and b = tau(c).  Then
--   d0 b = c, so G rho - d0 b = P sigma(al) + Q sigma(be) is in N^1.
--   Proof: P al + Q be = g q (P Q' = Q P'); d1 sigma(al) = al - pi al = al,
--   the same for be; d1 G rho = g q - pi(g q) = g q (degree -1); so
--   d1 c = 0; c has the supports, and the contraction gives d0 tau(c) = c.
-- Proposition (rel).  If G rho - d0 v = P U + Q V (v in K^0(-1), U in
--   S1 kP, V in S1 kQ), there is eta with M(rho,eta) = 0.
--   Proof: d1 of both sides: g q = P d1U + Q d1V, so with
--   al' = d1U - muQ q, be' = d1V + muP q: P al' + Q be' = 0, that is
--   D0 (P' al' + Q' be') = 0, and (S0) gives P' al' + Q' be' = 0; (S1)
--   gives w of degree kW with al' = -Q' w, be' = P' w.  Let eta_s = w(s),
--   so h = pi(w) (pi-gens).  Then, with w - pi w = d1 sigma(w),
--     al = d1U + Q' w - Q' pi(w) = d1 (U + Q' sigma w) ,
--     be = P' pi(w) - P' w + d1V = d1 (V - P' sigma w) ,
--   both d1 of 1-cochains with the supports, so pi al = pi be = 0.
-- Corollary (N).  N = {rho | merely v with G rho - d0 v in N^1} is a
--   submodule of A^r (the witnesses v add up, G and d0 are linear).  M is
--   linear on A^(r+r') (pairs x = (rho, eta) by Blocks.ix), so M x is the
--   combination of the columns M(e_k) with the coefficients x, and ker M is
--   the module of syzygies of the columns: by coherence of A^(nd+ne)
--   (FreeCoherent, Prop. 4) it is merely generated by g_1..g_p.  With
--   u_j = rho-part of g_j and b_j = b(g_j) (Lemma prim):
--   G u_j - d0 b_j in N^1, and N = span(u_j): span(u_j) in N since N is a
--   submodule containing the u_j; conversely for rho in N, Prop. rel gives
--   eta with (rho, eta) in ker M, a combination of the g_j, whose rho-part
--   is the same combination of the u_j.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module RC = ReesLiftingCong[l] ; module Tr = Truncation[l] ;
module Ps = Presentations[l] ; module CMn = CechMonomials[l] ; module CSt = CechSections[l] ;
module TC = TruncationCombinators[l] ;

-- a linear map commutes with the combinations of Comb.Sums (ACLZMT.LinSum
-- for the sums of Comb)
module LinComb (A : CRing) (Pm Qm : IP.Mod[A]) (F : IP.Lin[A,Pm,Qm]) {
  module SP = Comb[l].Sums[A,Pm] ; module SQ = Comb[l].Sums[A,Qm] ;
  map-comb : (n : Ring[l].Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> Pm.M) ->
    Id Qm.M (F.f (SP.comb n c u)) (SQ.comb n c (\ k -> F.f (u k))) = split {
    zero -> \ c u -> ACLZMT[l].LinSum[A,Pm,Qm,F].zero ;
    suc n | rr -> \ c u -> trans (F.f-add (Pm.sm (c (inr tt)) (u (inr tt))) (SP.comb n (\ i -> c (inl i)) (\ i -> u (inl i))))
                            (IP.ModL[A,Qm].G.cong-add (F.f-sm (c (inr tt)) (u (inr tt))) (rr (\ i -> c (inl i)) (\ i -> u (inl i)))) } ;
} ;
-- a submodule contains the combinations of its elements
sub-comb (A : CRing) (Md : IP.Mod[A]) (S : RC.Sub[A,Md]) : (n : Ring[l].Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> Md.M) ->
  ((k : Ps.Fin n) -> S.N (u k)) -> S.N (Comb[l].Sums[A,Md].comb n c u) = split {
  zero -> \ c u h -> S.n-zero ;
  suc n | rr -> \ c u h ->
    S.n-add (Md.sm (c (inr tt)) (u (inr tt))) (Comb[l].Sums[A,Md].comb n (\ i -> c (inl i)) (\ i -> u (inl i)))
      (S.n-sm (c (inr tt)) (u (inr tt)) (h (inr tt))) (rr (\ i -> c (inl i)) (\ i -> u (inl i)) (\ i -> h (inl i))) } ;

module Over (D : CRing) (setD : Pr.isSet D.R) (a b : D.R)
  -- the two charts (CechF1)
  (muP : E3) (FP GP : Laurent3[l].Over[D].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[D].NonNegY FP) (yG : Laurent3[l].Over[D].NonNegY GP)
  (dF : Laurent3[l].Over[D].HomPI (deg muP) FP) (dG : Laurent3[l].Over[D].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[D].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[D].NonNegX FQ) (xG : Laurent3[l].Over[D].NonNegX GQ)
  (dF' : Laurent3[l].Over[D].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[D].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[D,setD].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[D,setD].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[D,setD].IsPoly (deg muP) (Laurent3[l].Over[D].monoP muP))
  (pmuQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) (Laurent3[l].Over[D].monoP muQ))
  (pP : CechModules[l].Over[D,setD].IsPoly (deg muP) (FixedCochain[l].Over[D,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) (FixedCochain[l].Over[D,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- the degrees: deg g = dg, kP = -1 - deg muP = negsuc dn, kQ = negsuc en
  (dg : Nat) (hdg : Id Int (add (deg muP) (deg muQ)) (pos dg))
  (dn en : Nat) (hkP : Id Int (add (negsuc zero) (deg (neg3 muP))) (negsuc dn))
  (hkQ : Id Int (add (negsuc zero) (deg (neg3 muQ))) (negsuc en))
  (kW : Int) (dW : Nat) (hWn : Id Int kW (negsuc dW))
  -- a common divisor D0: P = D0 P', Q = D0 Q' as products on Laurent elements
  (D0 P' Q' : Laurent3[l].Over[D].LPoly) (dP' dQ' : Int)
  (pP' : CechModules[l].Over[D,setD].IsPoly dP' P') (pQ' : CechModules[l].Over[D,setD].IsPoly dQ' Q')
  (hW1 : Id Int (add kW dQ') (add (negsuc zero) (deg (neg3 muP))))
  (hW2 : Id Int (add kW dP') (add (negsuc zero) (deg (neg3 muQ))))
  (fP : (f : Laurent3[l].Over[D].Lau) -> Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].mulP (FixedCochain[l].Over[D,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) f) (Laurent3[l].Over[D].mulP D0 (Laurent3[l].Over[D].mulP P' f)))
  (fQ : (f : Laurent3[l].Over[D].Lau) -> Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].mulP (FixedCochain[l].Over[D,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) f) (Laurent3[l].Over[D].mulP D0 (Laurent3[l].Over[D].mulP Q' f)))
  -- (S0) for D0 and (S1) for P', Q'
  (s0 : (f : Laurent3[l].Over[D].Lau) -> LaurentList[l].Over[D].Fin f -> Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].mulP D0 f) Laurent3[l].Over[D].zeroL -> Laurent3[l].Over[D].EqL f Laurent3[l].Over[D].zeroL)
  (s1 : (al be : Laurent3[l].Over[D].Lau) ->
        CechModules[l].Over[D,setD].SL (add (negsuc zero) (deg (neg3 muP))) al ->
        CechModules[l].Over[D,setD].SL (add (negsuc zero) (deg (neg3 muQ))) be ->
        Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].addL (Laurent3[l].Over[D].mulP P' al) (Laurent3[l].Over[D].mulP Q' be)) Laurent3[l].Over[D].zeroL ->
        (w : Laurent3[l].Over[D].Lau) * (CechModules[l].Over[D,setD].SL kW w *
          (Laurent3[l].Over[D].EqL al (Laurent3[l].Over[D].negL (Laurent3[l].Over[D].mulP Q' w)) * Laurent3[l].Over[D].EqL be (Laurent3[l].Over[D].mulP P' w)))) {
  module LO = Laurent3[l].Over[D] ; open LO ;
  module CO = Cech3[l].Over[D] ;
  module CC = CechContraction[l].Over[D] ;
  module LL = LaurentList[l].Over[D] ;
  module CMd = CechModules[l].Over[D,setD] ;
  module COp = CechOps[l].Over[D,setD] ;
  module CH = CechH1Finite[l].Over[D] ;
  module CMO = CechMonomials[l].Over[D] ;
  module CS = CechSections[l].Over[D,setD] ;
  module F1 = CechF1[l].Over[D,setD,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,dg,hdg] ;
  module LT = IP.ModL[D,CMd.tmod] ;
  module ML = ACLZMT[l].ModSum[D,CMd.lmod] ;

  ------------------------------------------------------------------------
  -- combinations of the monomials X^t, t in gens n (degree -1 - n)

  mono-hom (n : Nat) : (xs : List CMn.N3) -> CSt.AllN (\ t -> Id Nat (suc (suc (CMn.size t))) n) xs ->
    (i : Ps.Fin (len {CMn.N3} xs)) -> Hom (negsuc n) (CH.mono (F1.nth xs i)) = split {
    nil -> \ h k -> Ring[l].efq k ;
    cons t xs | rr -> \ h -> split {
      inl i -> rr h.2 i ;
      inr u -> CH.hom-mono t (negsuc n) (ap (\ k -> negsuc k) h.1) } } ;

  module LC (n : Nat) (xs : List CMn.N3) (hxs : CSt.AllN (\ t -> Id Nat (suc (suc (CMn.size t))) n) xs) {
    k : Ring[l].Nat = len {CMn.N3} xs ;
    Vec : U l = Ps.Fin k -> D.R ;
    module S = CMd.ML[negsuc n].S ;
    module MS = ACLZMT[l].ModSum[D,S.mod] ;
    mono (i : Ps.Fin k) : S.E = (CH.mono (F1.nth xs i), (mono-hom n xs hxs i, CS.mono-fin (F1.nth xs i))) ;
    -- sum_i c_i X^(xs_i), with its degree and finite support
    cS (c : Vec) : S.E = MS.comb k c mono ;
    cL (c : Vec) : Lau = (cS c).1 ;
    -- as a combination of Laurent elements, and coefficientwise
    cL-comb (c : Vec) : Id Lau (cL c) (ML.comb k c (\ i -> CH.mono (F1.nth xs i))) =
      ACLZMT[l].LinSum[D,S.mod,CMd.lmod,S.incl].map-comb k c mono ;
    -- linear in the coefficients
    module CLS = CechF1[l].CombLin[D,S.mod] ;
    cL-add (c c' : Vec) : Id Lau (cL (\ i -> D.add (c i) (c' i))) (addL (cL c) (cL c')) = ap (\ u -> u.1) (CLS.comb-add k c c' mono) ;
    cL-sm (k0 : D.R) (c : Vec) : Id Lau (cL (\ i -> D.mul k0 (c i))) (scaleL k0 (cL c)) = ap (\ u -> u.1) (CLS.comb-sm k k0 c mono) ;
  } ;
  -- sums over a list, as combinations and termwise
  sum-list (F : CMn.N3 -> D.R) : (ys : List CMn.N3) ->
    EqL (ML.comb (len {CMn.N3} ys) (\ i -> F (F1.nth ys i)) (\ i -> CH.mono (F1.nth ys i)))
        (\ m -> CMO.sumL CMn.N3 (\ t -> D.mul (F t) (ifB (CMn.isExpo t m) D.o)) ys) = split {
    nil -> \ m -> refl D.z ;
    cons t ys | r -> \ m -> ap (D.add (D.mul (F t) (ifB (CMn.isExpo t m) D.o))) (r m) } ;
  -- a sum over ys vanishes when its terms at every nth ys i vanish
  sum-nth-zero (F : CMn.N3 -> D.R) : (ys : List CMn.N3) ->
    ((i : Ps.Fin (len {CMn.N3} ys)) -> Id D.R (F (F1.nth ys i)) D.z) -> Id D.R (CMO.sumL CMn.N3 F ys) D.z = split {
    nil -> \ h -> refl D.z ;
    cons t ys | r -> \ h -> CO.vanish-add (F t) (CMO.sumL CMn.N3 F ys) (h (inr tt)) (r (\ i -> h (inl i))) } ;
  -- the combination of the coefficients of f is pi(f) (pi-gens)
  cL-pi (n : Nat) (f : Lau) (hf : Hom (negsuc n) f) : EqL (LC[n,CMn.gens n,CSt.gens-size n].cL (\ i -> f (CMn.expo (F1.nth (CMn.gens n) i)))) (CC.pi f) = \ m ->
    trans (ap (\ u -> u m) (LC[n,CMn.gens n,CSt.gens-size n].cL-comb (\ i -> f (CMn.expo (F1.nth (CMn.gens n) i)))))
      (trans (sum-list (\ t -> f (CMn.expo t)) (CMn.gens n) m) (sym (CMO.pi-gens n f hf m))) ;
  -- pi(f) = 0 when the coefficients of f at the exponents of gens n vanish
  pi-zero (n : Nat) (f : Lau) (hf : Hom (negsuc n) f) (h : (i : Ps.Fin (len {CMn.N3} (CMn.gens n))) -> Id D.R (f (CMn.expo (F1.nth (CMn.gens n) i))) D.z) : EqL (CC.pi f) zeroL = \ m ->
    trans (CMO.pi-gens n f hf m)
      (sum-nth-zero (\ t -> D.mul (f (CMn.expo t)) (ifB (CMn.isExpo t m) D.o)) (CMn.gens n)
         (\ i -> trans (ap (\ x -> D.mul x (ifB (CMn.isExpo (F1.nth (CMn.gens n) i) m) D.o)) (h i)) (LO.L.zero-mul (ifB (CMn.isExpo (F1.nth (CMn.gens n) i) m) D.o)))) ;
  module Qr = LC[dg,F1.ts,CSt.gens-size dg] ;
  module Hs = LC[dW,CMn.gens dW,CSt.gens-size dW] ;

  ------------------------------------------------------------------------
  -- Lemma (G-sigma): G rho = sigma(g q_rho)

  sg : IP.Lin[D,Qr.S.mod,CMd.tmod] =
    CechModules[l].comp D Qr.S.mod CMd.lmod CMd.tmod Qr.S.incl
      (CechModules[l].comp D CMd.lmod CMd.lmod CMd.tmod (COp.mulPL F1.gg) COp.sigmaL) ;
  -- the common point: sum_t rho_t sigma(g X^t)
  G-mid (rh : Qr.Vec) : CO.Tri = ACLZMT[l].ModSum[D,CMd.tmod].comb Qr.k rh (\ k -> CC.sigma (mulP F1.gg (CH.mono (F1.nth F1.ts k)))) ;
  -- by definition of G (m_t = sigma(g X^t))
  G-is (rh : Qr.Vec) : Id CO.Tri (F1.G.f rh) (G-mid rh) = refl (F1.G.f rh) ;
  -- by linearity of sigma(g -)
  mid-is (rh : Qr.Vec) : Id CO.Tri (G-mid rh) (sg.f (Qr.cS rh)) =
    sym (ACLZMT[l].LinSum[D,Qr.S.mod,CMd.tmod,sg].map-comb Qr.k rh Qr.mono) ;
  -- by definition of sg
  sg-is (x : Qr.S.E) : Id CO.Tri (sg.f x) (CC.sigma (mulP F1.gg x.1)) = refl (sg.f x) ;
  G-sigma (rh : Qr.Vec) : Id CO.Tri (F1.G.f rh) (CC.sigma (mulP F1.gg (Qr.cL rh))) = trans (G-is rh) (trans (mid-is rh) (sg-is (Qr.cS rh))) ;

  ------------------------------------------------------------------------
  -- degrees

  -- kP + deg muP = -1 and kQ + deg muQ = -1
  kP-back : Id Int (add F1.kP (deg muP)) F1.m1 =
    trans (ap (\ t -> add (add F1.m1 t) (deg muP)) (F1.FC.deg-neg muP)) (F1.cancel-r F1.m1 (deg muP)) ;
  kQ-back : Id Int (add F1.kQ (deg muQ)) F1.m1 =
    trans (ap (\ t -> add (add F1.m1 t) (deg muQ)) (F1.FC.deg-neg muQ)) (F1.cancel-r F1.m1 (deg muQ)) ;
  -- the degree of q is kq = negsuc dg, that of h is kW
  q-SL (rh : Qr.Vec) : CMd.SL F1.kq (Qr.cL rh) = CS.slT (negsuc dg) F1.kq (sym F1.kq-is) (Qr.cL rh) (Qr.cS rh).2 ;
  h-SL (et : Hs.Vec) : CMd.SL kW (Hs.cL et) = CS.slT (negsuc dW) kW (sym hWn) (Hs.cL et) (Hs.cS et).2 ;
  -- g q has degree -1
  gq-SL (rh : Qr.Vec) : CMd.SL F1.m1 (mulP F1.gg (Qr.cL rh)) =
    CS.slT (add F1.kq F1.dPQ) F1.m1 F1.kq-g (mulP F1.gg (Qr.cL rh)) (COp.mulP-pres F1.kq F1.dPQ F1.gg (F1.to-poly F1.dPQ F1.gg F1.pgg) (Qr.cL rh) (q-SL rh)) ;
  -- the subspace SL is closed under f - g and f + g
  sl-sub (k : Int) (f g : Lau) (hf : CMd.SL k f) (hg : CMd.SL k g) : CMd.SL k (subL f g) =
    (CMd.van-add (CMd.CH k) f (negL g) hf.1 (CMd.van-neg (CMd.CH k) g hg.1), LL.fin-sub f g hf.2 hg.2) ;
  sl-add (k : Int) (f g : Lau) (hf : CMd.SL k f) (hg : CMd.SL k g) : CMd.SL k (addL f g) =
    (CMd.van-add (CMd.CH k) f g hf.1 hg.1, LL.fin-add f g hf.2 hg.2) ;
  muQq-SL (rh : Qr.Vec) : CMd.SL F1.kP (mulP (monoP muQ) (Qr.cL rh)) =
    CS.slT (add F1.kq (deg muQ)) F1.kP F1.kq-Q (mulP (monoP muQ) (Qr.cL rh)) (COp.mulP-pres F1.kq (deg muQ) (monoP muQ) pmuQ (Qr.cL rh) (q-SL rh)) ;
  muPq-SL (rh : Qr.Vec) : CMd.SL F1.kQ (mulP (monoP muP) (Qr.cL rh)) =
    CS.slT (add F1.kq (deg muP)) F1.kQ F1.kq-P (mulP (monoP muP) (Qr.cL rh)) (COp.mulP-pres F1.kq (deg muP) (monoP muP) pmuP (Qr.cL rh) (q-SL rh)) ;
  Q'h-SL (et : Hs.Vec) : CMd.SL F1.kP (mulP Q' (Hs.cL et)) =
    CS.slT (add kW dQ') F1.kP hW1 (mulP Q' (Hs.cL et)) (COp.mulP-pres kW dQ' Q' pQ' (Hs.cL et) (h-SL et)) ;
  P'h-SL (et : Hs.Vec) : CMd.SL F1.kQ (mulP P' (Hs.cL et)) =
    CS.slT (add kW dP') F1.kQ hW2 (mulP P' (Hs.cL et)) (COp.mulP-pres kW dP' P' pP' (Hs.cL et) (h-SL et)) ;

  ------------------------------------------------------------------------
  -- Definition (M)

  -- al = muQ q - Q' h  (degree kP),  be = P' h - muP q  (degree kQ)
  al (rh : Qr.Vec) (et : Hs.Vec) : Lau = subL (mulP (monoP muQ) (Qr.cL rh)) (mulP Q' (Hs.cL et)) ;
  be (rh : Qr.Vec) (et : Hs.Vec) : Lau = subL (mulP P' (Hs.cL et)) (mulP (monoP muP) (Qr.cL rh)) ;
  al-SL (rh : Qr.Vec) (et : Hs.Vec) : CMd.SL F1.kP (al rh et) = sl-sub F1.kP (mulP (monoP muQ) (Qr.cL rh)) (mulP Q' (Hs.cL et)) (muQq-SL rh) (Q'h-SL et) ;
  be-SL (rh : Qr.Vec) (et : Hs.Vec) : CMd.SL F1.kQ (be rh et) = sl-sub F1.kQ (mulP P' (Hs.cL et)) (mulP (monoP muP) (Qr.cL rh)) (P'h-SL et) (muPq-SL rh) ;

  module Ad = LC[dn,CMn.gens dn,CSt.gens-size dn] ;
  module Ae = LC[en,CMn.gens en,CSt.gens-size en] ;
  module MV = Comb[l].Free[D,plus Ad.k Ae.k] ;
  -- M(rho,eta): the coefficients of al at gens dn, then those of be at gens en
  Mv (rh : Qr.Vec) (et : Hs.Vec) : MV.Vec =
    FinCat[l].cat D.R Ad.k Ae.k (\ i -> al rh et (CMn.expo (F1.nth Ad.xs i))) (\ j -> be rh et (CMn.expo (F1.nth Ae.xs j))) ;
  -- M(rho,eta) = 0 iff pi al = pi be = 0 (pi-gens; at an all-negative exponent, pi f is f)
  module Zero (rh : Qr.Vec) (et : Hs.Vec) (hM : Id MV.Vec (Mv rh et) MV.mod.mz) {
    at (m : Ps.Fin (plus Ad.k Ae.k)) : Id D.R (Mv rh et m) D.z = ap (\ v -> v m) hM ;
    pi-al : EqL (CC.pi (al rh et)) zeroL =
      pi-zero dn (al rh et) (hom-tr F1.kP (negsuc dn) hkP (al rh et) (al-SL rh et).1)
        (\ i -> trans (sym (FinCat[l].cat-l D.R Ad.k Ae.k (\ i -> al rh et (CMn.expo (F1.nth Ad.xs i))) (\ j -> be rh et (CMn.expo (F1.nth Ae.xs j))) i))
                      (at (Blocks[l].ix Ad.k Ae.k (inl i)))) ;
    pi-be : EqL (CC.pi (be rh et)) zeroL =
      pi-zero en (be rh et) (hom-tr F1.kQ (negsuc en) hkQ (be rh et) (be-SL rh et).1)
        (\ j -> trans (sym (FinCat[l].cat-r D.R Ad.k Ae.k (\ i -> al rh et (CMn.expo (F1.nth Ad.xs i))) (\ j -> be rh et (CMn.expo (F1.nth Ae.xs j))) j))
                      (at (Blocks[l].ix Ad.k Ae.k (inr j)))) ;
  } ;
  zero-of (rh : Qr.Vec) (et : Hs.Vec) (ha : EqL (CC.pi (al rh et)) zeroL) (hb : EqL (CC.pi (be rh et)) zeroL) :
    Id MV.Vec (Mv rh et) MV.mod.mz =
    MV.ext (Mv rh et) MV.mod.mz
      (FinCat[l].cat-all D.R Ad.k Ae.k (\ i -> al rh et (CMn.expo (F1.nth Ad.xs i))) (\ j -> be rh et (CMn.expo (F1.nth Ae.xs j)))
         (\ x -> Id D.R x D.z) (\ i -> ha (CMn.expo (F1.nth Ad.xs i))) (\ j -> hb (CMn.expo (F1.nth Ae.xs j)))) ;

  ------------------------------------------------------------------------
  -- Lemma (prim)

  -- d1 sigma(f) = f when pi f = 0 (CechContraction.decomp)
  sig0 (f : Lau) (h : EqL (CC.pi f) zeroL) : EqL (CO.d1 (CC.sigma f)) f = \ m ->
    trans (CH.d1-sigma f m) (trans (ap (\ t -> D.add (f m) (D.neg t)) (h m)) (sub-z (f m))) ;
  -- d1 G rho = g q (g q has degree -1, so pi(g q) = 0)
  d1G (rh : Qr.Vec) : EqL (CO.d1 (F1.G.f rh)) (mulP F1.gg (Qr.cL rh)) = \ m ->
    trans (ap (\ t -> CO.d1 t m) (G-sigma rh)) (sig0 (mulP F1.gg (Qr.cL rh)) (CC.pi-deg (mulP F1.gg (Qr.cL rh)) (gq-SL rh).1) m) ;
  -- g f = P (muQ f) - Q (muP f)  (gg-PQ, products commute)
  g-exp (f : Lau) : EqL (mulP F1.gg f) (subL (mulP F1.PlP (mulP (monoP muQ) f)) (mulP F1.PlQ (mulP (monoP muP) f))) = \ m ->
    trans (F1.gg-PQ f m) (DG.cong-add (mulP-comm (monoP muQ) F1.PlP f m) (ap D.neg (mulP-comm (monoP muP) F1.PlQ f m))) ;
  -- P Q' f = Q P' f, both D0 P' Q' f
  cross (f : Lau) : EqL (mulP F1.PlP (mulP Q' f)) (mulP F1.PlQ (mulP P' f)) = \ m ->
    trans (fP (mulP Q' f) m) (trans (mulP-cong D0 (mulP P' (mulP Q' f)) (mulP Q' (mulP P' f)) (mulP-comm P' Q' f) m) (sym (fQ (mulP P' f) m))) ;
  -- (x - y) + (z - w) = x - w  when y = z
  ring1 (x y z w : D.R) (e : Id D.R y z) : Id D.R (D.add (D.add x (D.neg y)) (D.add z (D.neg w))) (D.add x (D.neg w)) =
    trans (ap (\ t -> D.add (D.add x (D.neg y)) (D.add t (D.neg w))) (sym e)) (sym (CS.ring-tel x y w)) ;
  -- P al + Q be = g q
  pq-g (rh : Qr.Vec) (et : Hs.Vec) : EqL (addL (mulP F1.PlP (al rh et)) (mulP F1.PlQ (be rh et))) (mulP F1.gg (Qr.cL rh)) = \ m ->
    calc D.R {
      D.add (mulP F1.PlP (al rh et) m) (mulP F1.PlQ (be rh et) m)
        =< DG.cong-add (mulP-sub F1.PlP (mulP (monoP muQ) (Qr.cL rh)) (mulP Q' (Hs.cL et)) m)
                       (mulP-sub F1.PlQ (mulP P' (Hs.cL et)) (mulP (monoP muP) (Qr.cL rh)) m)
        > D.add (D.add (mulP F1.PlP (mulP (monoP muQ) (Qr.cL rh)) m) (D.neg (mulP F1.PlP (mulP Q' (Hs.cL et)) m)))
                (D.add (mulP F1.PlQ (mulP P' (Hs.cL et)) m) (D.neg (mulP F1.PlQ (mulP (monoP muP) (Qr.cL rh)) m)))
        =< ring1 (mulP F1.PlP (mulP (monoP muQ) (Qr.cL rh)) m) (mulP F1.PlP (mulP Q' (Hs.cL et)) m)
                 (mulP F1.PlQ (mulP P' (Hs.cL et)) m) (mulP F1.PlQ (mulP (monoP muP) (Qr.cL rh)) m) (cross (Hs.cL et) m)
        > D.add (mulP F1.PlP (mulP (monoP muQ) (Qr.cL rh)) m) (D.neg (mulP F1.PlQ (mulP (monoP muP) (Qr.cL rh)) m))
        =< sym (g-exp (Qr.cL rh) m) > mulP F1.gg (Qr.cL rh) m } ;

  module Prim (rh : Qr.Vec) (et : Hs.Vec) (hM : Id MV.Vec (Mv rh et) MV.mod.mz) {
    module Z = Zero[rh,et,hM] ;
    sal : CO.Tri = CC.sigma (al rh et) ;
    sbe : CO.Tri = CC.sigma (be rh et) ;
    hsal : CMd.S1 F1.kP sal = COp.sigma-pres F1.kP (al rh et) (al-SL rh et) ;
    hsbe : CMd.S1 F1.kQ sbe = COp.sigma-pres F1.kQ (be rh et) (be-SL rh et) ;
    -- P sigma(al) + Q sigma(be), and c = G rho - (P sigma(al) + Q sigma(be))
    pw : CO.Tri = F1.NW1.comb sal sbe ;
    c : CO.Tri = LT.msub (F1.G.f rh) pw ;
    -- d1 pw = P al + Q be = g q
    d1pw : EqL (CO.d1 pw) (addL (mulP F1.PlP (al rh et)) (mulP F1.PlQ (be rh et))) = \ m ->
      trans (CO.d1-add (CO.mulT F1.PlP sal) (CO.mulT F1.PlQ sbe) m)
        (DG.cong-add (trans (CO.d1-mul F1.PlP sal m) (mulP-cong F1.PlP (CO.d1 sal) (al rh et) (sig0 (al rh et) Z.pi-al) m))
                     (trans (CO.d1-mul F1.PlQ sbe m) (mulP-cong F1.PlQ (CO.d1 sbe) (be rh et) (sig0 (be rh et) Z.pi-be) m))) ;
    d1c : EqL (CO.d1 c) zeroL = \ m ->
      calc D.R {
        CO.d1 c m
          =< CO.d1-add (F1.G.f rh) (CMd.negT pw) m > D.add (CO.d1 (F1.G.f rh) m) (CO.d1 (CMd.negT pw) m)
          =< DG.cong-add (d1G rh m) (trans (CO.d1-neg pw m) (ap D.neg (trans (d1pw m) (pq-g rh et m))))
          > D.add (mulP F1.gg (Qr.cL rh) m) (D.neg (mulP F1.gg (Qr.cL rh) m))
          =< D.addN (mulP F1.gg (Qr.cL rh) m) > D.z } ;
    -- the supports and degrees of c
    hG : CMd.S1 F1.m1 (F1.G.f rh) =
      subst (CMd.S1 F1.m1) (sym (G-sigma rh)) (COp.sigma-pres F1.m1 (mulP F1.gg (Qr.cL rh)) (gq-SL rh)) ;
    hpw : CMd.S1 F1.m1 pw =
      COp.s1-add F1.m1 (CO.mulT F1.PlP sal) (CO.mulT F1.PlQ sbe)
        (CS.s1T (add F1.kP (deg muP)) F1.m1 kP-back (CO.mulT F1.PlP sal) (CS.mulS1-pres F1.kP (deg muP) F1.PlP pP sal hsal))
        (CS.s1T (add F1.kQ (deg muQ)) F1.m1 kQ-back (CO.mulT F1.PlQ sbe) (CS.mulS1-pres F1.kQ (deg muQ) F1.PlQ pQ sbe hsbe)) ;
    hc : CMd.S1 F1.m1 c = COp.s1-add F1.m1 (F1.G.f rh) (CMd.negT pw) hG (COp.s1-neg F1.m1 pw hpw) ;
    -- the primitive b = tau(c): d0 b = c (contraction)
    bS : F1.M0m.S.E = (CC.tau c, COp.tau-pres F1.m1 c hc) ;
    con : CO.EqT (CO.d0 (CC.tau c)) c = CC.contraction c hc.1 d1c ;
    -- G rho - d0 b = P sigma(al) + Q sigma(be), in N^1
    prim-eq : Id CO.Tri (LT.msub (F1.G.f rh) (F1.d0K.f bS)) pw =
      trans (ap (LT.msub (F1.G.f rh)) (CMd.extT (CO.d0 (CC.tau c)) c con)) (LT.sub-sub-self (F1.G.f rh) pw) ;
    prim : F1.N1.N (LT.msub (F1.G.f rh) (F1.d0K.f bS)) =
      (sal, (sbe, (hsal, (hsbe, CS.idEqT (LT.msub (F1.G.f rh) (F1.d0K.f bS)) pw prim-eq)))) ;
  } ;

  ------------------------------------------------------------------------
  -- Proposition (rel)

  -- (x - y) + (z + w) = 0  when  x + z = y - w
  ring2 (x y z w : D.R) (e : Id D.R (D.add x z) (D.add y (D.neg w))) : Id D.R (D.add (D.add x (D.neg y)) (D.add z w)) D.z =
    calc D.R {
      D.add (D.add x (D.neg y)) (D.add z w)
        =< L.swap x (D.neg y) z w > D.add (D.add x z) (D.add (D.neg y) w)
        =< ap (D.add (D.add x z)) (sym (L.negsub y w)) > D.add (D.add x z) (D.neg (D.add y (D.neg w)))
        =< ap (\ t -> D.add t (D.neg (D.add y (D.neg w)))) e > D.add (D.add y (D.neg w)) (D.neg (D.add y (D.neg w)))
        =< D.addN (D.add y (D.neg w)) > D.z } ;
  -- y = x + z  when  x - y = -z
  ring3 (x y z : D.R) (e : Id D.R (D.add x (D.neg y)) (D.neg z)) : Id D.R y (D.add x z) =
    trans (sym (CS.r2 x y)) (trans (ap (\ t -> D.add x (D.neg t)) e) (ap (D.add x) (L.neg-neg z))) ;
  -- p - y = x - (z - p)  when  x + y = z
  ring4 (x y z p : D.R) (e : Id D.R (D.add x y) z) : Id D.R (D.add p (D.neg y)) (D.add x (D.neg (D.add z (D.neg p)))) =
    calc D.R {
      D.add p (D.neg y)
        =< ap (\ t -> D.add p (D.neg t)) (trans (sym (CO.add-sub-l x y)) (ap (\ t -> D.add t (D.neg x)) e))
        > D.add p (D.neg (D.add z (D.neg x)))
        =< ap (D.add p) (L.negsub z x) > D.add p (D.add (D.neg z) x)
        =< D.addA p (D.neg z) x > D.add (D.add p (D.neg z)) x
        =< D.addC (D.add p (D.neg z)) x > D.add x (D.add p (D.neg z))
        =< ap (D.add x) (trans (D.addC p (D.neg z)) (sym (L.negsub z p))) > D.add x (D.neg (D.add z (D.neg p))) } ;
  -- the product by H of d1 sigma(w) = w - pi w
  d1-Hsw (H : LPoly) (w : Lau) : EqL (CO.d1 (CO.mulT H (CC.sigma w))) (subL (mulP H w) (mulP H (CC.pi w))) = \ m ->
    trans (CO.d1-mul H (CC.sigma w) m) (trans (mulP-cong H (CO.d1 (CC.sigma w)) (subL w (CC.pi w)) (CH.d1-sigma w) m) (mulP-sub H w (CC.pi w) m)) ;

  module Rel (rh : Qr.Vec) (v : F1.M0m.S.E) (hN : F1.N1.N (LT.msub (F1.G.f rh) (F1.d0K.f v))) {
    -- the parts of the relation G rho - d0 v = P U + Q V
    Uc : CO.Tri = hN.1 ;
    Vc : CO.Tri = hN.2.1 ;
    hU : CMd.S1 F1.kP Uc = hN.2.2.1 ;
    hV : CMd.S1 F1.kQ Vc = hN.2.2.2.1 ;
    eN : CO.EqT (LT.msub (F1.G.f rh) (F1.d0K.f v)) (F1.NW1.comb Uc Vc) = hN.2.2.2.2 ;
    -- d1 of both sides: g q = P d1U + Q d1V
    e1 : EqL (mulP F1.gg (Qr.cL rh)) (addL (mulP F1.PlP (CO.d1 Uc)) (mulP F1.PlQ (CO.d1 Vc))) = \ m ->
      calc D.R {
        mulP F1.gg (Qr.cL rh) m
          =< sym (sub-z (mulP F1.gg (Qr.cL rh) m)) > D.add (mulP F1.gg (Qr.cL rh) m) (D.neg D.z)
          =< ap (\ t -> D.add (mulP F1.gg (Qr.cL rh) m) (D.neg t)) (sym (CO.d1d0 v.1 m))
          > D.add (mulP F1.gg (Qr.cL rh) m) (D.neg (CO.d1 (CO.d0 v.1) m))
          =< sym (DG.cong-add (d1G rh m) (CO.d1-neg (CO.d0 v.1) m))
          > D.add (CO.d1 (F1.G.f rh) m) (CO.d1 (CMd.negT (CO.d0 v.1)) m)
          =< sym (CO.d1-add (F1.G.f rh) (CMd.negT (CO.d0 v.1)) m) > CO.d1 (LT.msub (F1.G.f rh) (F1.d0K.f v)) m
          =< CO.d1-cong (LT.msub (F1.G.f rh) (F1.d0K.f v)) (F1.NW1.comb Uc Vc) eN m > CO.d1 (F1.NW1.comb Uc Vc) m
          =< CO.d1-add (CO.mulT F1.PlP Uc) (CO.mulT F1.PlQ Vc) m
          > D.add (CO.d1 (CO.mulT F1.PlP Uc) m) (CO.d1 (CO.mulT F1.PlQ Vc) m)
          =< DG.cong-add (CO.d1-mul F1.PlP Uc m) (CO.d1-mul F1.PlQ Vc m)
          > D.add (mulP F1.PlP (CO.d1 Uc) m) (mulP F1.PlQ (CO.d1 Vc) m) } ;
    -- al' = d1U - muQ q, be' = d1V + muP q: P al' + Q be' = 0
    al' : Lau = subL (CO.d1 Uc) (mulP (monoP muQ) (Qr.cL rh)) ;
    be' : Lau = addL (CO.d1 Vc) (mulP (monoP muP) (Qr.cL rh)) ;
    e2 : EqL (addL (mulP F1.PlP al') (mulP F1.PlQ be')) zeroL = \ m ->
      trans (DG.cong-add (mulP-sub F1.PlP (CO.d1 Uc) (mulP (monoP muQ) (Qr.cL rh)) m) (mulP-add F1.PlQ (CO.d1 Vc) (mulP (monoP muP) (Qr.cL rh)) m))
        (ring2 (mulP F1.PlP (CO.d1 Uc) m) (mulP F1.PlP (mulP (monoP muQ) (Qr.cL rh)) m)
               (mulP F1.PlQ (CO.d1 Vc) m) (mulP F1.PlQ (mulP (monoP muP) (Qr.cL rh)) m)
               (trans (sym (e1 m)) (g-exp (Qr.cL rh) m))) ;
    -- (S0): D0 (P' al' + Q' be') = P al' + Q be' = 0
    al'-SL : CMd.SL F1.kP al' = sl-sub F1.kP (CO.d1 Uc) (mulP (monoP muQ) (Qr.cL rh)) (CS.d1-SL F1.kP Uc hU) (muQq-SL rh) ;
    be'-SL : CMd.SL F1.kQ be' = sl-add F1.kQ (CO.d1 Vc) (mulP (monoP muP) (Qr.cL rh)) (CS.d1-SL F1.kQ Vc hV) (muPq-SL rh) ;
    e3 : EqL (addL (mulP P' al') (mulP Q' be')) zeroL =
      s0 (addL (mulP P' al') (mulP Q' be'))
        (LL.fin-add (mulP P' al') (mulP Q' be') (LL.fin-mulP P' al' al'-SL.2) (LL.fin-mulP Q' be' be'-SL.2))
        (\ m -> trans (mulP-add D0 (mulP P' al') (mulP Q' be') m) (trans (DG.cong-add (sym (fP al' m)) (sym (fQ be' m))) (e2 m))) ;
    -- (S1): w of degree kW with al' = -Q' w, be' = P' w
    sr : (w : Lau) * (CMd.SL kW w * (EqL al' (negL (mulP Q' w)) * EqL be' (mulP P' w))) = s1 al' be' al'-SL be'-SL e3 ;
    w : Lau = sr.1 ;
    hw : CMd.SL kW w = sr.2.1 ;
    ea : EqL al' (negL (mulP Q' w)) = sr.2.2.1 ;
    eb : EqL be' (mulP P' w) = sr.2.2.2 ;
    -- eta_s = w(s): h = pi(w)
    et : Hs.Vec = \ s -> w (CMn.expo (F1.nth Hs.xs s)) ;
    h-pi : EqL (Hs.cL et) (CC.pi w) = cL-pi dW w (hom-tr kW (negsuc dW) hWn w hw.1) ;
    sw : CO.Tri = CC.sigma w ;
    hsw : CMd.S1 kW sw = COp.sigma-pres kW w hw ;
    -- al = d1 (U + Q' sigma w)
    Aa : CO.Tri = CO.addT Uc (CO.mulT Q' sw) ;
    dA : EqL (al rh et) (CO.d1 Aa) = \ m ->
      calc D.R {
        al rh et m
          =< DG.cong-add (ring3 (CO.d1 Uc m) (mulP (monoP muQ) (Qr.cL rh) m) (mulP Q' w m) (ea m))
                         (ap D.neg (mulP-cong Q' (Hs.cL et) (CC.pi w) h-pi m))
          > D.add (D.add (CO.d1 Uc m) (mulP Q' w m)) (D.neg (mulP Q' (CC.pi w) m))
          =< sym (D.addA (CO.d1 Uc m) (mulP Q' w m) (D.neg (mulP Q' (CC.pi w) m)))
          > D.add (CO.d1 Uc m) (D.add (mulP Q' w m) (D.neg (mulP Q' (CC.pi w) m)))
          =< ap (D.add (CO.d1 Uc m)) (sym (d1-Hsw Q' w m)) > D.add (CO.d1 Uc m) (CO.d1 (CO.mulT Q' sw) m)
          =< sym (CO.d1-add Uc (CO.mulT Q' sw) m) > CO.d1 Aa m } ;
    -- be = d1 (V - P' sigma w)
    Bb : CO.Tri = CO.subT Vc (CO.mulT P' sw) ;
    dB : EqL (be rh et) (CO.d1 Bb) = \ m ->
      calc D.R {
        be rh et m
          =< ap (\ t -> D.add t (D.neg (mulP (monoP muP) (Qr.cL rh) m))) (mulP-cong P' (Hs.cL et) (CC.pi w) h-pi m)
          > D.add (mulP P' (CC.pi w) m) (D.neg (mulP (monoP muP) (Qr.cL rh) m))
          =< ring4 (CO.d1 Vc m) (mulP (monoP muP) (Qr.cL rh) m) (mulP P' w m) (mulP P' (CC.pi w) m) (eb m)
          > D.add (CO.d1 Vc m) (D.neg (D.add (mulP P' w m) (D.neg (mulP P' (CC.pi w) m))))
          =< ap (\ t -> D.add (CO.d1 Vc m) (D.neg t)) (sym (d1-Hsw P' w m))
          > D.add (CO.d1 Vc m) (D.neg (CO.d1 (CO.mulT P' sw) m))
          =< sym (CO.d1-sub Vc (CO.mulT P' sw) m) > CO.d1 Bb m } ;
    -- both have the supports, so pi al = pi be = 0
    pi-al : EqL (CC.pi (al rh et)) zeroL = \ m ->
      trans (CC.pi-cong (al rh et) (CO.d1 Aa) dA m)
        (CS.pi-d1 Aa (CO.supp1-add Uc (CO.mulT Q' sw) hU.1 (COp.supp1-mulT dQ' Q' pQ' sw hsw.1)) m) ;
    pi-be : EqL (CC.pi (be rh et)) zeroL = \ m ->
      trans (CC.pi-cong (be rh et) (CO.d1 Bb) dB m)
        (CS.pi-d1 Bb (CO.supp1-sub Vc (CO.mulT P' sw) hV.1 (COp.supp1-mulT dP' P' pP' sw hsw.1)) m) ;
    rel : Id MV.Vec (Mv rh et) MV.mod.mz = zero-of rh et pi-al pi-be ;
  } ;
  rel (rh : Qr.Vec) (v : F1.M0m.S.E) (hN : F1.N1.N (LT.msub (F1.G.f rh) (F1.d0K.f v))) :
    (et : Hs.Vec) * Id MV.Vec (Mv rh et) MV.mod.mz = (Rel[rh,v,hN].et, Rel[rh,v,hN].rel) ;

  ------------------------------------------------------------------------
  -- Corollary (N)

  -- the pairs (rho, eta): A^(r + r')
  module PV = Comb[l].Free[D,plus Qr.k Hs.k] ;
  module QV = Comb[l].Free[D,Qr.k] ;
  rho-of (x : PV.Vec) : Qr.Vec = \ i -> x (Blocks[l].ix Qr.k Hs.k (inl i)) ;
  eta-of (x : PV.Vec) : Hs.Vec = \ j -> x (Blocks[l].ix Qr.k Hs.k (inr j)) ;
  Mx (x : PV.Vec) : MV.Vec = Mv (rho-of x) (eta-of x) ;
  -- M is linear: al and be are differences of products of linear functions
  dl-add (H K : LPoly) (f f' g g' : Lau) (e : E3) :
    Id D.R (subL (mulP H (addL f f')) (mulP K (addL g g')) e) (D.add (subL (mulP H f) (mulP K g) e) (subL (mulP H f') (mulP K g') e)) =
    trans (DG.cong-add (mulP-add H f f' e) (ap D.neg (mulP-add K g g' e))) (sym (CO.sub-pair (mulP H f e) (mulP K g e) (mulP H f' e) (mulP K g' e))) ;
  dl-sm (H K : LPoly) (c : D.R) (f g : Lau) (e : E3) :
    Id D.R (subL (mulP H (scaleL c f)) (mulP K (scaleL c g)) e) (D.mul c (subL (mulP H f) (mulP K g) e)) =
    trans (DG.cong-add (mulP-scale H c f e) (ap D.neg (mulP-scale K c g e))) (COp.sub-scale c (mulP H f e) (mulP K g e)) ;
  al-add (x y : PV.Vec) (e : E3) : Id D.R (al (rho-of (PV.mod.madd x y)) (eta-of (PV.mod.madd x y)) e) (D.add (al (rho-of x) (eta-of x) e) (al (rho-of y) (eta-of y) e)) =
    trans (ap (\ f -> subL (mulP (monoP muQ) f) (mulP Q' (Hs.cL (eta-of (PV.mod.madd x y)))) e) (Qr.cL-add (rho-of x) (rho-of y)))
      (trans (ap (\ f -> subL (mulP (monoP muQ) (addL (Qr.cL (rho-of x)) (Qr.cL (rho-of y)))) (mulP Q' f) e) (Hs.cL-add (eta-of x) (eta-of y)))
        (dl-add (monoP muQ) Q' (Qr.cL (rho-of x)) (Qr.cL (rho-of y)) (Hs.cL (eta-of x)) (Hs.cL (eta-of y)) e)) ;
  be-add (x y : PV.Vec) (e : E3) : Id D.R (be (rho-of (PV.mod.madd x y)) (eta-of (PV.mod.madd x y)) e) (D.add (be (rho-of x) (eta-of x) e) (be (rho-of y) (eta-of y) e)) =
    trans (ap (\ f -> subL (mulP P' f) (mulP (monoP muP) (Qr.cL (rho-of (PV.mod.madd x y)))) e) (Hs.cL-add (eta-of x) (eta-of y)))
      (trans (ap (\ f -> subL (mulP P' (addL (Hs.cL (eta-of x)) (Hs.cL (eta-of y)))) (mulP (monoP muP) f) e) (Qr.cL-add (rho-of x) (rho-of y)))
        (dl-add P' (monoP muP) (Hs.cL (eta-of x)) (Hs.cL (eta-of y)) (Qr.cL (rho-of x)) (Qr.cL (rho-of y)) e)) ;
  al-sm (c : D.R) (x : PV.Vec) (e : E3) : Id D.R (al (rho-of (PV.mod.sm c x)) (eta-of (PV.mod.sm c x)) e) (D.mul c (al (rho-of x) (eta-of x) e)) =
    trans (ap (\ f -> subL (mulP (monoP muQ) f) (mulP Q' (Hs.cL (eta-of (PV.mod.sm c x)))) e) (Qr.cL-sm c (rho-of x)))
      (trans (ap (\ f -> subL (mulP (monoP muQ) (scaleL c (Qr.cL (rho-of x)))) (mulP Q' f) e) (Hs.cL-sm c (eta-of x)))
        (dl-sm (monoP muQ) Q' c (Qr.cL (rho-of x)) (Hs.cL (eta-of x)) e)) ;
  be-sm (c : D.R) (x : PV.Vec) (e : E3) : Id D.R (be (rho-of (PV.mod.sm c x)) (eta-of (PV.mod.sm c x)) e) (D.mul c (be (rho-of x) (eta-of x) e)) =
    trans (ap (\ f -> subL (mulP P' f) (mulP (monoP muP) (Qr.cL (rho-of (PV.mod.sm c x)))) e) (Hs.cL-sm c (eta-of x)))
      (trans (ap (\ f -> subL (mulP P' (scaleL c (Hs.cL (eta-of x)))) (mulP (monoP muP) f) e) (Qr.cL-sm c (rho-of x)))
        (dl-sm P' (monoP muP) c (Hs.cL (eta-of x)) (Qr.cL (rho-of x)) e)) ;
  -- the two blocks of a concatenation, pointwise
  catP-add (F F' F'' : Ps.Fin Ad.k -> D.R) (G G' G'' : Ps.Fin Ae.k -> D.R)
    (hF : (i : Ps.Fin Ad.k) -> Id D.R (F'' i) (D.add (F i) (F' i))) (hG : (j : Ps.Fin Ae.k) -> Id D.R (G'' j) (D.add (G j) (G' j))) :
    (z : Plus (Ps.Fin Ad.k) (Ps.Fin Ae.k)) -> Id D.R (FinCat[l].catP D.R Ad.k Ae.k F'' G'' z)
      (D.add (FinCat[l].catP D.R Ad.k Ae.k F G z) (FinCat[l].catP D.R Ad.k Ae.k F' G' z)) = split {
    inl i -> hF i ;
    inr j -> hG j } ;
  catP-sm (c : D.R) (F F' : Ps.Fin Ad.k -> D.R) (G G' : Ps.Fin Ae.k -> D.R)
    (hF : (i : Ps.Fin Ad.k) -> Id D.R (F' i) (D.mul c (F i))) (hG : (j : Ps.Fin Ae.k) -> Id D.R (G' j) (D.mul c (G j))) :
    (z : Plus (Ps.Fin Ad.k) (Ps.Fin Ae.k)) -> Id D.R (FinCat[l].catP D.R Ad.k Ae.k F' G' z) (D.mul c (FinCat[l].catP D.R Ad.k Ae.k F G z)) = split {
    inl i -> hF i ;
    inr j -> hG j } ;
  Mx-add (x y : PV.Vec) : Id MV.Vec (Mx (PV.mod.madd x y)) (MV.mod.madd (Mx x) (Mx y)) =
    MV.ext (Mx (PV.mod.madd x y)) (MV.mod.madd (Mx x) (Mx y)) (\ m ->
      catP-add (\ i -> al (rho-of x) (eta-of x) (CMn.expo (F1.nth Ad.xs i))) (\ i -> al (rho-of y) (eta-of y) (CMn.expo (F1.nth Ad.xs i)))
               (\ i -> al (rho-of (PV.mod.madd x y)) (eta-of (PV.mod.madd x y)) (CMn.expo (F1.nth Ad.xs i)))
               (\ j -> be (rho-of x) (eta-of x) (CMn.expo (F1.nth Ae.xs j))) (\ j -> be (rho-of y) (eta-of y) (CMn.expo (F1.nth Ae.xs j)))
               (\ j -> be (rho-of (PV.mod.madd x y)) (eta-of (PV.mod.madd x y)) (CMn.expo (F1.nth Ae.xs j)))
               (\ i -> al-add x y (CMn.expo (F1.nth Ad.xs i))) (\ j -> be-add x y (CMn.expo (F1.nth Ae.xs j)))
               (Blocks[l].xi Ad.k Ae.k m)) ;
  Mx-sm (c : D.R) (x : PV.Vec) : Id MV.Vec (Mx (PV.mod.sm c x)) (MV.mod.sm c (Mx x)) =
    MV.ext (Mx (PV.mod.sm c x)) (MV.mod.sm c (Mx x)) (\ m ->
      catP-sm c (\ i -> al (rho-of x) (eta-of x) (CMn.expo (F1.nth Ad.xs i))) (\ i -> al (rho-of (PV.mod.sm c x)) (eta-of (PV.mod.sm c x)) (CMn.expo (F1.nth Ad.xs i)))
                (\ j -> be (rho-of x) (eta-of x) (CMn.expo (F1.nth Ae.xs j))) (\ j -> be (rho-of (PV.mod.sm c x)) (eta-of (PV.mod.sm c x)) (CMn.expo (F1.nth Ae.xs j)))
                (\ i -> al-sm c x (CMn.expo (F1.nth Ad.xs i))) (\ j -> be-sm c x (CMn.expo (F1.nth Ae.xs j)))
                (Blocks[l].xi Ad.k Ae.k m)) ;
  ML-lin : IP.Lin[D,PV.mod,MV.mod] = IP.mkLin D PV.mod MV.mod Mx Mx-add Mx-sm ;
  -- the columns: M x = sum_k x_k M(e_k)
  module Bs = FreeCoherent[l].Basis[D] ;
  col (k : Ps.Fin (plus Qr.k Hs.k)) : MV.Vec = Mx (Bs.basis (plus Qr.k Hs.k) k) ;
  Mx-col (x : PV.Vec) : Id MV.Vec (Mx x) (MV.VS.comb (plus Qr.k Hs.k) x col) =
    trans (ap Mx (sym (Bs.vec-basis (plus Qr.k Hs.k) x))) (LinComb[D,PV.mod,MV.mod,ML-lin].map-comb (plus Qr.k Hs.k) x (Bs.basis (plus Qr.k Hs.k))) ;

  -- N = {rho | merely v in K^0(-1) with G rho - d0 v in N^1}, a submodule
  NW (rh : Qr.Vec) : U l = (v : F1.M0m.S.E) * F1.N1.N (LT.msub (F1.G.f rh) (F1.d0K.f v)) ;
  NN (rh : Qr.Vec) : U l = Tr.Trunc[NW rh].carrier ;
  module M0 = F1.M0m.S ;
  -- G rho - d0 v is linear in (rho, v)
  dlt (rh : Qr.Vec) (v : M0.E) : CO.Tri = LT.msub (F1.G.f rh) (F1.d0K.f v) ;
  dlt-zero : Id CO.Tri CMd.tmod.mz (dlt QV.mod.mz M0.mod.mz) =
    sym (trans (Ps.cong2 CO.Tri LT.msub _ _ _ _ (ACLZMT[l].LinSum[D,F1.FV.mod,CMd.tmod,F1.G].zero) (ACLZMT[l].LinSum[D,M0.mod,CMd.tmod,F1.d0K].zero))
               (LT.sub-self CMd.tmod.mz)) ;
  dlt-add (x y : Qr.Vec) (v v' : M0.E) : Id CO.Tri (CMd.tmod.madd (dlt x v) (dlt y v')) (dlt (QV.mod.madd x y) (M0.mod.madd v v')) =
    sym (trans (Ps.cong2 CO.Tri LT.msub _ _ _ _ (F1.G.f-add x y) (F1.d0K.f-add v v'))
               (LT.sub-swap (F1.G.f x) (F1.G.f y) (F1.d0K.f v) (F1.d0K.f v'))) ;
  dlt-neg (x : Qr.Vec) (v : M0.E) : Id CO.Tri (CMd.tmod.mneg (dlt x v)) (dlt (QV.mod.mneg x) (M0.mod.mneg v)) =
    sym (trans (Ps.cong2 CO.Tri LT.msub _ _ _ _ (CS.linNeg F1.FV.mod CMd.tmod F1.G x) (CS.linNeg M0.mod CMd.tmod F1.d0K v))
               (sym (LT.G.neg-add (F1.G.f x) (CMd.tmod.mneg (F1.d0K.f v))))) ;
  dlt-sm (c : D.R) (x : Qr.Vec) (v : M0.E) : Id CO.Tri (CMd.tmod.sm c (dlt x v)) (dlt (QV.mod.sm c x) (M0.mod.sm c v)) =
    sym (trans (Ps.cong2 CO.Tri LT.msub _ _ _ _ (F1.G.f-sm c x) (F1.d0K.f-sm c v)) (sym (LT.sm-sub c (F1.G.f x) (F1.d0K.f v)))) ;
  nw-zero : NW QV.mod.mz = (M0.mod.mz, F1.NL1.n-tr CMd.tmod.mz (dlt QV.mod.mz M0.mod.mz) dlt-zero F1.N1.n-zero) ;
  nw-add (x y : Qr.Vec) (hx : NW x) (hy : NW y) : NW (QV.mod.madd x y) =
    (M0.mod.madd hx.1 hy.1, F1.NL1.n-tr (CMd.tmod.madd (dlt x hx.1) (dlt y hy.1)) (dlt (QV.mod.madd x y) (M0.mod.madd hx.1 hy.1))
       (dlt-add x y hx.1 hy.1) (F1.N1.n-add (dlt x hx.1) (dlt y hy.1) hx.2 hy.2)) ;
  nw-neg (x : Qr.Vec) (hx : NW x) : NW (QV.mod.mneg x) =
    (M0.mod.mneg hx.1, F1.NL1.n-tr (CMd.tmod.mneg (dlt x hx.1)) (dlt (QV.mod.mneg x) (M0.mod.mneg hx.1)) (dlt-neg x hx.1) (F1.N1.n-neg (dlt x hx.1) hx.2)) ;
  nw-sm (c : D.R) (x : Qr.Vec) (hx : NW x) : NW (QV.mod.sm c x) =
    (M0.mod.sm c hx.1, F1.NL1.n-tr (CMd.tmod.sm c (dlt x hx.1)) (dlt (QV.mod.sm c x) (M0.mod.sm c hx.1)) (dlt-sm c x hx.1) (F1.N1.n-sm c (dlt x hx.1) hx.2)) ;
  NSub : RC.Sub[D,QV.mod] = RC.mkSub D QV.mod NN (Tr.Trunc[NW QV.mod.mz].inc nw-zero)
    (\ x y -> TC.map2 (NW x) (NW y) (NW (QV.mod.madd x y)) (nw-add x y))
    (\ x -> TC.map (NW x) (NW (QV.mod.mneg x)) (nw-neg x))
    (\ c x -> TC.map (NW x) (NW (QV.mod.sm c x)) (nw-sm c x)) ;

  -- membership in the span of a family of A^r
  MemQ (p : Ring[l].Nat) (us : Ps.Fin p -> Qr.Vec) (rh : Qr.Vec) : U l = FinCat[l].Vecs[D,Qr.k].MemV p us rh ;
  -- N = span(u_j) for generators (rho_j, eta_j) of ker M; b_j = b(rho_j, eta_j)
  module Gens (p : Ring[l].Nat) (gs : Ps.Fin p -> PV.Vec)
    (gsyz : Coherent[l].Over[D,MV.mod].SyzAll (plus Qr.k Hs.k) col p gs)
    (guniv : Coherent[l].Over[D,MV.mod].Univ (plus Qr.k Hs.k) col p gs) {
    us (j : Ps.Fin p) : Qr.Vec = rho-of (gs j) ;
    gM (j : Ps.Fin p) : Id MV.Vec (Mx (gs j)) MV.mod.mz = trans (Mx-col (gs j)) (gsyz j) ;
    bs (j : Ps.Fin p) : M0.E = Prim[us j,eta-of (gs j),gM j].bS ;
    bs-in (j : Ps.Fin p) : F1.N1.N (dlt (us j) (bs j)) = Prim[us j,eta-of (gs j),gM j].prim ;
    -- span(u_j) is in N (Lemma prim, N a submodule)
    from-span (rh : Qr.Vec) (h : MemQ p us rh) : NN rh =
      TC.rec (Coherent[l].Over[D,IP.regular D].InFV Qr.k p us rh) @l (NN rh) Tr.Trunc[NW rh].proposition
        (\ cw -> subst NN cw.2 (sub-comb D QV.mod NSub p cw.1 us (\ j -> Tr.Trunc[NW (us j)].inc (bs j, bs-in j)))) h ;
    -- N is in span(u_j) (Prop. rel, generation of ker M)
    module ToSpan (rh : Qr.Vec) (hw : NW rh) {
      et : Hs.Vec = (rel rh hw.1 hw.2).1 ;
      x : PV.Vec = FinCat[l].cat D.R Qr.k Hs.k rh et ;
      rx : Id Qr.Vec (rho-of x) rh = QV.ext (rho-of x) rh (\ i -> FinCat[l].cat-l D.R Qr.k Hs.k rh et i) ;
      ex : Id Hs.Vec (eta-of x) et = Comb[l].Free[D,Hs.k].ext (eta-of x) et (\ j -> FinCat[l].cat-r D.R Qr.k Hs.k rh et j) ;
      xM : Id MV.Vec (Mx x) MV.mod.mz = trans (ap (\ r -> Mv r (eta-of x)) rx) (trans (ap (Mv rh) ex) (rel rh hw.1 hw.2).2) ;
      mem : Coherent[l].Over[D,MV.mod].MemV (plus Qr.k Hs.k) p gs x = guniv x (trans (sym (Mx-col x)) xM) ;
      -- the rho-part of sum_j c_j g_j is sum_j c_j u_j
      part (c : Ps.Fin p -> D.R) (e : Id PV.Vec (PV.VS.comb p c gs) x) : Id Qr.Vec (QV.VS.comb p c us) rh =
        QV.ext (QV.VS.comb p c us) rh (\ i ->
          trans (QV.comb-at p c us i)
            (trans (sym (PV.comb-at p c gs (Blocks[l].ix Qr.k Hs.k (inl i))))
              (trans (ap (\ v -> v (Blocks[l].ix Qr.k Hs.k (inl i))) e) (FinCat[l].cat-l D.R Qr.k Hs.k rh et i)))) ;
      span : MemQ p us rh =
        TC.map (Coherent[l].Over[D,IP.regular D].InFV (plus Qr.k Hs.k) p gs x) (Coherent[l].Over[D,IP.regular D].InFV Qr.k p us rh)
          (\ cw -> (cw.1, part cw.1 cw.2)) mem ;
    } ;
    to-span (rh : Qr.Vec) (h : NN rh) : MemQ p us rh =
      TC.rec (NW rh) @l (MemQ p us rh) (FinCat[l].Vecs[D,Qr.k].memv-prop p us rh) (\ hw -> ToSpan[rh,hw].span) h ;
  } ;
  -- Corollary (N): merely u_1..u_p with primitives b_j, G u_j - d0 b_j in N^1, and N = span(u_j)
  CorN : U l = (p : Ring[l].Nat) * ((us : Ps.Fin p -> Qr.Vec) * ((bs : Ps.Fin p -> M0.E) *
    (((j : Ps.Fin p) -> F1.N1.N (dlt (us j) (bs j))) *
     ((rh : Qr.Vec) -> (NN rh -> MemQ p us rh) * (MemQ p us rh -> NN rh))))) ;
  corN (coh : Coherent[l].Over[D,IP.regular D].Coh) : Tr.Trunc[CorN].carrier =
    TC.map (Coherent[l].Over[D,MV.mod].CohW (plus Qr.k Hs.k) col) CorN
      (\ w -> (w.1, (Gens[w.1,w.2.1,w.2.2.1,w.2.2.2].us, (Gens[w.1,w.2.1,w.2.2.1,w.2.2.2].bs, (Gens[w.1,w.2.1,w.2.2.1,w.2.2.2].bs-in,
                \ rh -> (Gens[w.1,w.2.1,w.2.2.1,w.2.2.2].to-span rh, Gens[w.1,w.2.1,w.2.2.1,w.2.2.2].from-span rh))))))
      (FreeCoherent[l].Over[D,coh].coh-vec (plus Ad.k Ae.k) (plus Qr.k Hs.k) col) ;
} ;
