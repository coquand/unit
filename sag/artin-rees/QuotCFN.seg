-- QuotCFN.seg: quotients of CFN rings by finitely generated ideals
-- (artin-rees.tex, Prop. 12, quotient part).
--
-- Stated for a ring map f : A -> B, surjective under truncation, whose
-- kernel is the ideal of A generated by c_1..c_m (kc, ker).  The
-- library's QuotientRing by RegularIdeal.Generated is an instance
-- (QuotCFNInst.seg).
--
-- Everything is computed on lifts: a family u of B is merely f u' (finite
-- choice, lift-fam), and w = (u', c) is the family u' followed by c.
--   image: f (sum_k lam_k w_k) = sum_i f (lam_i) u_i, since f c_j = 0.
--   (D) y = f y' is in the span of u iff y' is in the span of w:
--       to-B by image; to-A: lift the coefficients mu to mu', then
--       y' - sum mu'_i u'_i is in the kernel, a combination nu of c, and
--       y' = sum mu'_i u'_i + sum nu_j c_j.
--   (C) the syzygies of u are generated by the images of the first n
--       coordinates of the syzygies gs of w: a syzygy mu of u lifts to mu',
--       sum mu'_i u'_i = sum nu_j c_j, so (mu', -nu) is a syzygy of w, a
--       combination d of gs, and mu = sum f(d_j) (f gs_j restricted).
--   (N) Transfer: the same codes, phi followed by f, still surjective.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module CN = CodedNoeth[l] ;

module Over (A B : CRing) (f : A.R -> B.R)
  (f-o : Id B.R (f A.o) B.o)
  (f-add : (a b : A.R) -> Id B.R (f (A.add a b)) (B.add (f a) (f b)))
  (f-mul : (a b : A.R) -> Id B.R (f (A.mul a b)) (B.mul (f a) (f b)))
  (surj : (y : B.R) -> Tr.Trunc[(x : A.R) * Id B.R (f x) y].carrier)
  (m : Nat) (c : Fin m -> A.R)
  (kc : (j : Fin m) -> Id B.R (f (c j)) B.z)
  (ker : (x : A.R) -> Id B.R (f x) B.z -> Coherent[l].Over[A,IP.regular A].Mem m c x) {
  module CA = Coherent[l].Over[A,IP.regular A] ; module CB = Coherent[l].Over[B,IP.regular B] ;
  module RSA = Comb[l].Sums[A,IP.regular A] ; module RSB = Comb[l].Sums[B,IP.regular B] ;
  module CSA = FinCat[l].CatSums[A,IP.regular A] ; module CSB = FinCat[l].CatSums[B,IP.regular B] ;
  module LA = RL[A] ; module LB = RL[B] ;

  f-z : Id B.R (f A.z) B.z =
    LB.add-cancel (f A.z) (f A.z) (trans (sym (f-add A.z A.z)) (ap f (A.addZ A.z))) ;
  f-neg (a : A.R) : Id B.R (f (A.neg a)) (B.neg (f a)) =
    LB.neg-uniq (f a) (f (A.neg a)) (trans (sym (f-add a (A.neg a))) (trans (ap f (A.addN a)) f-z)) ;
  f-sum : (n : Nat) (v : Fin n -> A.R) -> Id B.R (f (RSA.sum n v)) (RSB.sum n (\ k -> f (v k))) = split {
    zero -> \ v -> f-z ;
    suc n | r -> \ v -> trans (f-add (v (inr tt)) (RSA.sum n (\ i -> v (inl i))))
      (ap (B.add (f (v (inr tt)))) (r (\ i -> v (inl i)))) } ;
  f-comb (n : Nat) (d u : Fin n -> A.R) :
    Id B.R (f (RSA.comb n d u)) (RSB.comb n (\ k -> f (d k)) (\ k -> f (u k))) =
    trans (f-sum n (\ k -> A.mul (d k) (u k)))
      (RSB.sum-cong n (\ k -> f (A.mul (d k) (u k))) (\ k -> B.mul (f (d k)) (f (u k))) (\ k -> f-mul (d k) (u k))) ;

  -- a + (b - a) = b
  plus-diff (a b : A.R) : Id A.R (A.add a (A.add b (A.neg a))) b =
    calc A.R { A.add a (A.add b (A.neg a)) =< A.addC a (A.add b (A.neg a)) > A.add (A.add b (A.neg a)) a
                 =< sym (A.addA b (A.neg a) a) > A.add b (A.add (A.neg a) a)
                 =< ap (A.add b) (trans (A.addC (A.neg a) a) (A.addN a)) > A.add b A.z
                 =< A.addZ b > b } ;

  Lift (n : Nat) (v : Fin n -> B.R) : U l = (i : Fin n) -> (a : A.R) * Id B.R (f a) (v i) ;
  lift-fam (n : Nat) (v : Fin n -> B.R) : Tr.Trunc[Lift n v].carrier =
    FinCat[l].fchoice n (\ i -> (a : A.R) * Id B.R (f a) (v i)) (\ i -> surj (v i)) ;

  -- a family u of B with a lift u'
  module Lifted (n : Nat) (u : Fin n -> B.R) (u' : Fin n -> A.R) (eu : (i : Fin n) -> Id B.R (f (u' i)) (u i)) {
    w : Fin (plus n m) -> A.R = FinCat[l].cat A.R n m u' c ;
    ix (i : Fin n) : Fin (plus n m) = Blocks[l].ix n m (inl i) ;
    jx (j : Fin m) : Fin (plus n m) = Blocks[l].ix n m (inr j) ;

    image (lam : Fin (plus n m) -> A.R) :
      Id B.R (f (RSA.comb (plus n m) lam w)) (RSB.comb n (\ i -> f (lam (ix i))) u) =
      calc B.R { f (RSA.comb (plus n m) lam w)
                   =< f-comb (plus n m) lam w > RSB.comb (plus n m) (\ k -> f (lam k)) (\ k -> f (w k))
                   =< CSB.sum-split n m (\ k -> B.mul (f (lam k)) (f (w k)))
                   > B.add (RSB.sum n (\ i -> B.mul (f (lam (ix i))) (f (w (ix i)))))
                           (RSB.sum m (\ j -> B.mul (f (lam (jx j))) (f (w (jx j)))))
                   =< ap (B.add (RSB.sum n (\ i -> B.mul (f (lam (ix i))) (f (w (ix i))))))
                         (trans (RSB.sum-cong m (\ j -> B.mul (f (lam (jx j))) (f (w (jx j)))) (\ j -> B.z)
                                   (\ j -> trans (ap (\ t -> B.mul (f (lam (jx j))) (f t)) (FinCat[l].cat-r A.R n m u' c j))
                                             (trans (ap (B.mul (f (lam (jx j)))) (kc j)) (LB.mul-zero (f (lam (jx j)))))))
                                (RSB.sum-zero m))
                   > B.add (RSB.sum n (\ i -> B.mul (f (lam (ix i))) (f (w (ix i))))) B.z
                   =< B.addZ (RSB.sum n (\ i -> B.mul (f (lam (ix i))) (f (w (ix i)))))
                   > RSB.sum n (\ i -> B.mul (f (lam (ix i))) (f (w (ix i))))
                   =< RSB.sum-cong n (\ i -> B.mul (f (lam (ix i))) (f (w (ix i)))) (\ i -> B.mul (f (lam (ix i))) (u i))
                        (\ i -> ap (\ t -> B.mul (f (lam (ix i))) t)
                                  (trans (ap f (FinCat[l].cat-l A.R n m u' c i)) (eu i)))
                   > RSB.comb n (\ i -> f (lam (ix i))) u } ;

    -- f of a combination of u' with lifted coefficients
    image-lift (mu : Fin n -> B.R) (lm : Lift n mu) :
      Id B.R (f (RSA.comb n (\ i -> (lm i).1) u')) (RSB.comb n mu u) =
      trans (f-comb n (\ i -> (lm i).1) u')
        (RSB.sum-cong n (\ i -> B.mul (f (lm i).1) (f (u' i))) (\ i -> B.mul (mu i) (u i))
           (\ i -> trans (ap (\ t -> B.mul t (f (u' i))) (lm i).2) (ap (B.mul (mu i)) (eu i)))) ;

    ----------------------------------------------------------------------
    -- (D)

    to-B (y : B.R) (y' : A.R) (ey : Id B.R (f y') y) (h : CA.InFM (plus n m) w y') : CB.InFM n u y =
      (\ i -> f (h.1 (ix i)), trans (sym (image h.1)) (trans (ap f h.2) ey)) ;

    to-A-at (y : B.R) (y' : A.R) (ey : Id B.R (f y') y) (h : CB.InFM n u y) (lm : Lift n h.1) : CA.Mem (plus n m) w y' =
      let { mu' : Fin n -> A.R = \ i -> (lm i).1 ;
            x : A.R = A.add y' (A.neg (RSA.comb n mu' u')) ;
            fx : Id B.R (f x) B.z =
              calc B.R { f x =< f-add y' (A.neg (RSA.comb n mu' u')) > B.add (f y') (f (A.neg (RSA.comb n mu' u')))
                           =< ap (B.add (f y')) (f-neg (RSA.comb n mu' u')) > B.add (f y') (B.neg (f (RSA.comb n mu' u')))
                           =< ap (\ t -> B.add t (B.neg (f (RSA.comb n mu' u')))) ey > B.add y (B.neg (f (RSA.comb n mu' u')))
                           =< ap (\ t -> B.add y (B.neg t)) (trans (image-lift h.1 lm) h.2) > B.add y (B.neg y)
                           =< B.addN y > B.z } } in
      Tr.Trunc[CA.InFM m c x].induction @l (\ t -> CA.Mem (plus n m) w y') (\ t -> Tr.Trunc[CA.InFM (plus n m) w y'].proposition)
        (\ nu -> Tr.Trunc[CA.InFM (plus n m) w y'].inc (FinCat[l].cat A.R n m mu' nu.1,
           trans (CSA.comb-cat n m mu' nu.1 u' c)
             (trans (ap (A.add (RSA.comb n mu' u')) nu.2) (plus-diff (RSA.comb n mu' u') y'))))
        (ker x fx) ;
    to-A (y : B.R) (y' : A.R) (ey : Id B.R (f y') y) (h : CB.InFM n u y) : CA.Mem (plus n m) w y' =
      Tr.Trunc[Lift n h.1].induction @l (\ t -> CA.Mem (plus n m) w y') (\ t -> Tr.Trunc[CA.InFM (plus n m) w y'].proposition)
        (\ lm -> to-A-at y y' ey h lm) (lift-fam n h.1) ;

    decide (y : B.R) (y' : A.R) (ey : Id B.R (f y') y) :
      Plus (CA.Mem (plus n m) w y') (Not (CA.Mem (plus n m) w y')) -> Plus (CB.Mem n u y) (Not (CB.Mem n u y)) = split {
      inl h -> inl (Tr.Trunc[CA.InFM (plus n m) w y'].induction @l (\ t -> CB.Mem n u y) (\ t -> Tr.Trunc[CB.InFM n u y].proposition)
                      (\ g -> Tr.Trunc[CB.InFM n u y].inc (to-B y y' ey g)) h) ;
      inr nh -> inr (\ hb -> nh (Tr.Trunc[CB.InFM n u y].induction @l (\ t -> CA.Mem (plus n m) w y')
                      (\ t -> Tr.Trunc[CA.InFM (plus n m) w y'].proposition) (\ g -> to-A y y' ey g) hb)) } ;

    ----------------------------------------------------------------------
    -- (C)

    module CohOf (p : Nat) (gs : Fin p -> CA.Vec (plus n m)) (sa : CA.SyzAll (plus n m) w p gs)
      (un : CA.Univ (plus n m) w p gs) {
      module FA = Comb[l].Free[A,plus n m] ; module FB = Comb[l].Free[B,n] ;
      gsB (j : Fin p) : CB.Vec n = \ i -> f (gs j (ix i)) ;
      saB : CB.SyzAll n u p gsB = \ j -> trans (sym (image (gs j))) (trans (ap f (sa j)) f-z) ;

      unB-at (mu : CB.Vec n) (smu : CB.Syz n u mu) (lm : Lift n mu) : CB.MemV n p gsB mu =
        let { mu' : Fin n -> A.R = \ i -> (lm i).1 ;
              x : A.R = RSA.comb n mu' u' ;
              fx : Id B.R (f x) B.z = trans (image-lift mu lm) smu } in
        Tr.Trunc[CA.InFM m c x].induction @l (\ t -> CB.MemV n p gsB mu) (\ t -> Tr.Trunc[CB.InFV n p gsB mu].proposition)
          (\ nu ->
            let { lam : CA.Vec (plus n m) = FinCat[l].cat A.R n m mu' (\ j -> A.neg (nu.1 j)) ;
                  slam : CA.Syz (plus n m) w lam =
                    calc A.R { RSA.comb (plus n m) lam w
                                 =< CSA.comb-cat n m mu' (\ j -> A.neg (nu.1 j)) u' c
                                 > A.add x (RSA.comb m (\ j -> A.neg (nu.1 j)) c)
                                 =< ap (A.add x) (trans (RSA.comb-neg m nu.1 c) (ap A.neg nu.2)) > A.add x (A.neg x)
                                 =< A.addN x > A.z } } in
            Tr.Trunc[CA.InFV (plus n m) p gs lam].induction @l (\ t -> CB.MemV n p gsB mu)
              (\ t -> Tr.Trunc[CB.InFV n p gsB mu].proposition)
              (\ dd -> Tr.Trunc[CB.InFV n p gsB mu].inc (\ j -> f (dd.1 j),
                 FB.ext (FB.VS.comb p (\ j -> f (dd.1 j)) gsB) mu (\ i ->
                   calc B.R { FB.VS.comb p (\ j -> f (dd.1 j)) gsB i
                                =< FB.comb-at p (\ j -> f (dd.1 j)) gsB i > RSB.comb p (\ j -> f (dd.1 j)) (\ j -> gsB j i)
                                =< sym (f-comb p dd.1 (\ j -> gs j (ix i))) > f (RSA.comb p dd.1 (\ j -> gs j (ix i)))
                                =< ap f (sym (FA.comb-at p dd.1 gs (ix i))) > f (FA.VS.comb p dd.1 gs (ix i))
                                =< ap (\ v -> f (v (ix i))) dd.2 > f (lam (ix i))
                                =< ap f (FinCat[l].cat-l A.R n m mu' (\ j -> A.neg (nu.1 j)) i) > f (mu' i)
                                =< (lm i).2 > mu i })))
              (un lam slam))
          (ker x fx) ;
      unB : CB.Univ n u p gsB = \ mu smu ->
        Tr.Trunc[Lift n mu].induction @l (\ t -> CB.MemV n p gsB mu) (\ t -> Tr.Trunc[CB.InFV n p gsB mu].proposition)
          (\ lm -> unB-at mu smu lm) (lift-fam n mu) ;
      cohw : Tr.Trunc[CB.CohW n u].carrier = Tr.Trunc[CB.CohW n u].inc (p, (gsB, (saB, unB))) ;
    } ;
  } ;

  disc (dA : CA.Disc) : CB.Disc = \ n u y ->
    Tr.Trunc[Lift n u].induction @l (\ t -> Plus (CB.Mem n u y) (Not (CB.Mem n u y)))
      (\ t -> Coherent[l].dec-prop (CB.Mem n u y) (Tr.Trunc[CB.InFM n u y].proposition))
      (\ lu -> Tr.Trunc[(a : A.R) * Id B.R (f a) y].induction @l (\ t -> Plus (CB.Mem n u y) (Not (CB.Mem n u y)))
         (\ t -> Coherent[l].dec-prop (CB.Mem n u y) (Tr.Trunc[CB.InFM n u y].proposition))
         (\ ly -> Lifted[n, u, \ i -> (lu i).1, \ i -> (lu i).2].decide y ly.1 ly.2
                    (dA (plus n m) (FinCat[l].cat A.R n m (\ i -> (lu i).1) c) ly.1))
         (surj y))
      (lift-fam n u) ;

  coh (cA : CA.Coh) : CB.Coh = \ n u ->
    Tr.Trunc[Lift n u].induction @l (\ t -> Tr.Trunc[CB.CohW n u].carrier) (\ t -> Tr.Trunc[CB.CohW n u].proposition)
      (\ lu -> Tr.Trunc[CA.CohW (plus n m) (FinCat[l].cat A.R n m (\ i -> (lu i).1) c)].induction @l
         (\ t -> Tr.Trunc[CB.CohW n u].carrier) (\ t -> Tr.Trunc[CB.CohW n u].proposition)
         (\ q -> Lifted[n, u, \ i -> (lu i).1, \ i -> (lu i).2].CohOf[q.1, q.2.1, q.2.2.1, q.2.2.2].cohw)
         (cA (plus n m) (FinCat[l].cat A.R n m (\ i -> (lu i).1) c)))
      (lift-fam n u) ;

  ------------------------------------------------------------------------
  -- (N)

  module NoethB (K0 : U l) (cc : CN.CT) (P0 : CN.PresK[A, CN.El K0 cc])
    (nt : Span[l].Over[A, CN.pres A (CN.El K0 cc) P0].Noeth) (sA : CN.Over[A, CN.pres A (CN.El K0 cc) P0].Surj) {
    module TF = Transfer[l].Over[A,B,f,f-o,f-add,f-mul,CN.pres A (CN.El K0 cc) P0] ;
    surjB : CN.Over[B,TF.image].Surj = \ x ->
      Tr.Trunc[(a : A.R) * Id B.R (f a) x].induction @l (\ t -> Tr.Trunc[(k : CN.El K0 cc) * Id B.R (f (P0.phi k)) x].carrier)
        (\ t -> Tr.Trunc[(k : CN.El K0 cc) * Id B.R (f (P0.phi k)) x].proposition)
        (\ ae -> Tr.Trunc[(k : CN.El K0 cc) * Id A.R (P0.phi k) ae.1].induction @l
           (\ t -> Tr.Trunc[(k : CN.El K0 cc) * Id B.R (f (P0.phi k)) x].carrier)
           (\ t -> Tr.Trunc[(k : CN.El K0 cc) * Id B.R (f (P0.phi k)) x].proposition)
           (\ ke -> Tr.Trunc[(k : CN.El K0 cc) * Id B.R (f (P0.phi k)) x].inc (ke.1, trans (ap f ke.2) ae.2))
           (sA ae.1))
        (surj x) ;
    np : CN.NP K0 B = (cc, (CN.ofPres B TF.image, (TF.noeth nt, surjB))) ;
  } ;

  cfn (K0 : U l) (cA : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,B] =
    CFN[l].mkCFN K0 B (disc cA.disc) (coh cA.coh)
      (Tr.Trunc[CN.NP K0 A].induction @l (\ t -> Tr.Trunc[CN.NP K0 B].carrier) (\ t -> Tr.Trunc[CN.NP K0 B].proposition)
         (\ np -> Tr.Trunc[CN.NP K0 B].inc NoethB[K0, np.1, np.2.1, np.2.2.1, np.2.2.2].np) cA.noeth) ;
} ;
