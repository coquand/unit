-- ZCFN.seg: Z is CFN, with base the codes Nat * Nat (artin-rees.tex,
-- Prop. 13 for Z).
--
-- Informal proof.
--   (gcd) For u_1..u_k in Z there are G in Nat, b in Z^k and q in Z^k with
--     sum_i b_i u_i = G  and  u_i = q_i G  (gcdF): by induction on k, with
--     G = 0 for k = 0; for u_(k+1) = x = +-n, Euclid (ZArith.euclid) on
--     G and n gives g = s G + t n, G = a g, n = b g, and the new data are
--     g, (s b_i, +-t), (q_i a, +-b).
--   (D) If G = 0, every u_i is 0, and y is in the span iff y = 0 (|y| = 0
--     is decidable).  If G = k + 1, y is in the span iff (k+1) divides y
--     (ZArith.div-dec): y = d G = sum (d b_i) u_i, and a combination
--     sum c_i u_i = (sum c_i q_i) G is a multiple of G (combq).
--   (C) If G = 0, every vector is a syzygy: the standard basis.  If
--     G = k + 1, the syzygies are generated by g_i = e_i - q_i b:
--     sum_m g_i,m u_m = u_i - q_i G = 0 (gen-syz), and for a syzygy lam,
--     (sum_i lam_i q_i) G = sum lam_i u_i = 0, so sum lam_i q_i = 0
--     (ZArith.cancel) and sum_i lam_i g_i = lam - (sum lam_i q_i) b = lam
--     (gen-univ).
--   (N) The presentation of Integers.Over (codes (a, b) for a - b) is
--     noetherian (Euclid's tree, Integers.noeth); every x is +-n, the
--     value of (n, 0) or (0, n).
level l ; open Ring[l] ; open Presentations[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module CN = CodedNoeth[l] ; module ZA = ZArith[l] ; module ZR = ZRing[l] ;
module J = Integers[l].Over[ZR.ring] ;
module CZ = Coherent[l].Over[ZR.ring,IP.regular ZR.ring] ; module RS = Comb[l].Sums[ZR.ring,IP.regular ZR.ring] ;
module BL = Comb[l].Bilinear[ZR.ring,IP.regular ZR.ring] ; module BS = FreeCoherent[l].Basis[ZR.ring] ;
module RZ = RL[ZR.ring] ;

------------------------------------------------------------------------
-- (gcd)

record GcdF (k : Nat) (u : Fin k -> Int) {
  G : Nat ;
  bz : Fin k -> Int ;
  bez : Id Int (RS.comb k bz u) (J.iota G) ;
  q : Fin k -> Int ;
  eq : (i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota G)) ;
} ;

-- for x = +-n: the coefficient tx with tx x = t n, and bx with x = bx g
module SignCoef (x : Int) (n : Nat) (t b g : Int) (eb : Id Int (J.iota n) (ZR.mul b g)) {
  tx-of : ZA.Sign x n -> Int = split { inl e -> t ; inr e -> neg t } ;
  etx : (sg : ZA.Sign x n) -> Id Int (ZR.mul (tx-of sg) x) (ZR.mul t (J.iota n)) = split {
    inl e -> ap (ZR.mul t) e ;
    inr e -> calc Int {
      ZR.mul (neg t) x =< ap (ZR.mul (neg t)) e > ZR.mul (neg t) (neg (J.iota n))
        =< RZ.neg-mul-left t (neg (J.iota n)) > neg (ZR.mul t (neg (J.iota n)))
        =< ap neg (RZ.mul-neg t (J.iota n)) > neg (neg (ZR.mul t (J.iota n)))
        =< RZ.neg-neg (ZR.mul t (J.iota n)) > ZR.mul t (J.iota n) } } ;
  bx-of : ZA.Sign x n -> Int = split { inl e -> b ; inr e -> neg b } ;
  ebx : (sg : ZA.Sign x n) -> Id Int x (ZR.mul (bx-of sg) g) = split {
    inl e -> trans e eb ;
    inr e -> trans e (trans (ap neg eb) (sym (RZ.neg-mul-left b g))) } ;
} ;

module Ext (k : Nat) (u : Fin (suc k) -> Int) (P : GcdF[k,\ i -> u (inl i)]) {
  x : Int = u (inr tt) ;
  n : Nat = (ZA.abs x).1 ;
  sg : ZA.Sign x n = (ZA.abs x).2 ;
  E : ZA.Gcd2[P.G,n] = ZA.euclid P.G n ;
  module SC = SignCoef[x,n,E.t,E.b,J.iota E.g,E.eb] ;
  bz : Fin (suc k) -> Int = snoc (Fin k) Int (\ i -> ZR.mul E.s (P.bz i)) (SC.tx-of sg) ;
  -- by definition of the sum over Fin (k+1)
  comb-is : Id Int (RS.comb (suc k) bz u) (add (ZR.mul (SC.tx-of sg) x) (RS.comb k (\ i -> ZR.mul E.s (P.bz i)) (\ i -> u (inl i)))) =
    refl (RS.comb (suc k) bz u) ;
  bez : Id Int (RS.comb (suc k) bz u) (J.iota E.g) =
    calc Int {
      RS.comb (suc k) bz u
        =< comb-is > add (ZR.mul (SC.tx-of sg) x) (RS.comb k (\ i -> ZR.mul E.s (P.bz i)) (\ i -> u (inl i)))
        =< Ps.cong2 Int add _ _ _ _ (SC.etx sg) (trans (RS.comb-sm k E.s P.bz (\ i -> u (inl i))) (ap (ZR.mul E.s) P.bez))
        > add (ZR.mul E.t (J.iota n)) (ZR.mul E.s (J.iota P.G))
        =< comm (ZR.mul E.t (J.iota n)) (ZR.mul E.s (J.iota P.G)) > add (ZR.mul E.s (J.iota P.G)) (ZR.mul E.t (J.iota n))
        =< sym E.bez > J.iota E.g } ;
  q : Fin (suc k) -> Int = snoc (Fin k) Int (\ i -> ZR.mul (P.q i) E.a) (SC.bx-of sg) ;
  eq-top : (t : Top) -> Id Int (u (inr t)) (ZR.mul (q (inr t)) (J.iota E.g)) = split { tt -> SC.ebx sg } ;
  eq : (i : Fin (suc k)) -> Id Int (u i) (ZR.mul (q i) (J.iota E.g)) = split {
    inl i -> trans (P.eq i) (trans (ap (ZR.mul (P.q i)) E.ea) (ZR.mulA (P.q i) E.a (J.iota E.g))) ;
    inr t -> eq-top t } ;
  res : GcdF[suc k,u] = mkGcdF (suc k) u E.g bz bez q eq ;
} ;

no-fin (C : Fin zero -> U l) (i : Fin zero) : C i = absurd (C i) i ;
gcdF : (k : Nat) (u : Fin k -> Int) -> GcdF[k,u] = split {
  zero -> \ u -> mkGcdF zero u zero (no-fin (\ i -> Int)) (refl zeroZ) (no-fin (\ i -> Int))
                  (no-fin (\ i -> Id Int (u i) (ZR.mul (no-fin (\ j -> Int) i) zeroZ))) ;
  suc k | r -> \ u -> Ext[k,u,r (\ i -> u (inl i))].res } ;

-- a combination of the u_i is (sum c_i q_i) G
module Fam (k : Nat) (u : Fin k -> Int) (G : Nat) (q : Fin k -> Int) (eq : (i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota G))) {
  combq (c : Fin k -> Int) : Id Int (RS.comb k c u) (ZR.mul (RS.comb k c q) (J.iota G)) =
    trans (RS.sum-cong k (\ i -> ZR.mul (c i) (u i)) (\ i -> ZR.mul (c i) (ZR.mul (q i) (J.iota G))) (\ i -> ap (ZR.mul (c i)) (eq i)))
          (BL.comb-scaled k c q (J.iota G)) ;
} ;

------------------------------------------------------------------------
-- (D)

module DiscZero (k : Nat) (u : Fin k -> Int) (y : Int) (q : Fin k -> Int)
  (eq : (i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota zero))) {
  -- by definition of mul: x 0 = 0
  hz (i : Fin k) : Id Int (u i) zeroZ = eq i ;
  yes (e : Id Int y zeroZ) : CZ.Mem k u y =
    Tr.Trunc[CZ.InFM k u y].inc (\ i -> zeroZ, trans (RS.comb-zero k u) (sym e)) ;
  no (ne : Not (Id Int y zeroZ)) : Not (CZ.Mem k u y) = \ m ->
    Tr.Trunc[CZ.InFM k u y].induction @l (\ t -> Empty) (\ t -> Coherent[l].empty-prop)
      (\ c -> ne (trans (sym c.2) (RS.comb-vanish k c.1 u hz))) m ;
  -- y = 0 iff |y| = 0
  dec-y : (m : Nat) -> ZA.Sign y m -> Plus (Id Int y zeroZ) (Not (Id Int y zeroZ)) = split {
    zero -> \ s -> inl (ZA.sign-at-zero y s) ;
    suc m -> \ s -> inr (\ e -> suc-zero m (ZA.sign-unique y (suc m) zero s (inl e))) } ;
  res-of : Plus (Id Int y zeroZ) (Not (Id Int y zeroZ)) -> Plus (CZ.Mem k u y) (Not (CZ.Mem k u y)) = split {
    inl e -> inl (yes e) ;
    inr ne -> inr (no ne) } ;
  res : Plus (CZ.Mem k u y) (Not (CZ.Mem k u y)) = res-of (dec-y (ZA.abs y).1 (ZA.abs y).2) ;
} ;

module DiscPos (k : Nat) (u : Fin k -> Int) (y : Int) (G : Nat) (bz : Fin k -> Int)
  (bez : Id Int (RS.comb k bz u) (J.iota (suc G))) (q : Fin k -> Int)
  (eq : (i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota (suc G)))) {
  module F = Fam[k,u,suc G,q,eq] ;
  -- y = d G = sum (d b_i) u_i
  yes (dv : ZA.DivBy G y) : CZ.Mem k u y =
    Tr.Trunc[CZ.InFM k u y].inc (\ i -> ZR.mul dv.1 (bz i),
      trans (RS.comb-sm k dv.1 bz u) (trans (ap (ZR.mul dv.1) bez) (sym dv.2))) ;
  no (nd : Not (ZA.DivBy G y)) : Not (CZ.Mem k u y) = \ m ->
    Tr.Trunc[CZ.InFM k u y].induction @l (\ t -> Empty) (\ t -> Coherent[l].empty-prop)
      (\ c -> nd (RS.comb k c.1 q, trans (sym c.2) (F.combq c.1))) m ;
  res-of : Plus (ZA.DivBy G y) (Not (ZA.DivBy G y)) -> Plus (CZ.Mem k u y) (Not (CZ.Mem k u y)) = split {
    inl dv -> inl (yes dv) ;
    inr nd -> inr (no nd) } ;
  res : Plus (CZ.Mem k u y) (Not (CZ.Mem k u y)) = res-of (ZA.div-dec G y) ;
} ;

discG (k : Nat) (u : Fin k -> Int) (y : Int) : (G : Nat) (bz : Fin k -> Int) -> Id Int (RS.comb k bz u) (J.iota G) ->
  (q : Fin k -> Int) -> ((i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota G))) -> Plus (CZ.Mem k u y) (Not (CZ.Mem k u y)) = split {
  zero -> \ bz bez q eq -> DiscZero[k,u,y,q,eq].res ;
  suc G -> \ bz bez q eq -> DiscPos[k,u,y,G,bz,bez,q,eq].res } ;
disc-of (k : Nat) (u : Fin k -> Int) (y : Int) (P : GcdF[k,u]) : Plus (CZ.Mem k u y) (Not (CZ.Mem k u y)) =
  discG k u y P.G P.bz P.bez P.q P.eq ;
disc : CZ.Disc = \ k u y -> disc-of k u y (gcdF k u) ;

------------------------------------------------------------------------
-- (C)

-- every u_i is 0: the standard basis
coh-zero (k : Nat) (u : Fin k -> Int) (hz : (i : Fin k) -> Id Int (u i) zeroZ) : CZ.CohW k u =
  (k, (BS.basis k, (\ j -> RS.comb-vanish k (BS.basis k j) u hz,
    \ lam s -> Tr.Trunc[CZ.InFV k k (BS.basis k) lam].inc (lam, BS.vec-basis k lam)))) ;

-- G = k + 1: the generators e_i - q_i b
module Gens (k : Nat) (u : Fin k -> Int) (G : Nat) (bz : Fin k -> Int)
  (bez : Id Int (RS.comb k bz u) (J.iota (suc G))) (q : Fin k -> Int)
  (eq : (i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota (suc G)))) {
  module FV = Comb[l].Free[ZR.ring,k] ;
  module F = Fam[k,u,suc G,q,eq] ;
  K (m : Fin k) : Int = neg (bz m) ;
  gen (i : Fin k) : CZ.Vec k = \ m -> add (BS.basis k i m) (ZR.mul (q i) (K m)) ;
  comb-K : Id Int (RS.comb k K u) (neg (J.iota (suc G))) = trans (RS.comb-neg k bz u) (ap neg bez) ;
  gen-syz (i : Fin k) : CZ.Syz k u (gen i) =
    calc Int {
      RS.comb k (gen i) u
        =< RS.comb-add k (BS.basis k i) (\ m -> ZR.mul (q i) (K m)) u
        > add (RS.comb k (BS.basis k i) u) (RS.comb k (\ m -> ZR.mul (q i) (K m)) u)
        =< Ps.cong2 Int add _ _ _ _ (BS.comb-row k i u) (trans (RS.comb-sm k (q i) K u) (ap (ZR.mul (q i)) comb-K))
        > add (u i) (ZR.mul (q i) (neg (J.iota (suc G))))
        =< ap (add (u i)) (trans (RZ.mul-neg (q i) (J.iota (suc G))) (ap neg (sym (eq i)))) > add (u i) (neg (u i))
        =< invr (u i) > zeroZ } ;
  gen-univ (lam : CZ.Vec k) (s : CZ.Syz k u lam) (m : Fin k) : Id Int (FV.VS.comb k lam gen m) (lam m) =
    calc Int {
      FV.VS.comb k lam gen m
        =< FV.comb-at k lam gen m > RS.comb k lam (\ i -> gen i m)
        =< RS.comb-addv k lam (\ i -> BS.basis k i m) (\ i -> ZR.mul (q i) (K m))
        > add (RS.comb k lam (\ i -> BS.basis k i m)) (RS.comb k lam (\ i -> ZR.mul (q i) (K m)))
        =< Ps.cong2 Int add _ _ _ _ (BS.comb-basis k lam m) (BL.comb-scaled k lam q (K m))
        > add (lam m) (ZR.mul (RS.comb k lam q) (K m))
        =< ap (\ t -> add (lam m) (ZR.mul t (K m))) (ZA.cancel G (RS.comb k lam q) (trans (sym (F.combq lam)) s))
        > add (lam m) (ZR.mul zeroZ (K m))
        =< ap (add (lam m)) (ZR.mul-zero-l (K m)) > lam m } ;
  cohw : CZ.CohW k u =
    (k, (gen, (gen-syz, \ lam s -> Tr.Trunc[CZ.InFV k k gen lam].inc (lam, FV.ext (FV.VS.comb k lam gen) lam (gen-univ lam s))))) ;
} ;

cohG (k : Nat) (u : Fin k -> Int) : (G : Nat) (bz : Fin k -> Int) -> Id Int (RS.comb k bz u) (J.iota G) ->
  (q : Fin k -> Int) -> ((i : Fin k) -> Id Int (u i) (ZR.mul (q i) (J.iota G))) -> CZ.CohW k u = split {
  zero -> \ bz bez q eq -> coh-zero k u eq ;
  suc G -> \ bz bez q eq -> Gens[k,u,G,bz,bez,q,eq].cohw } ;
coh-of (k : Nat) (u : Fin k -> Int) (P : GcdF[k,u]) : CZ.CohW k u = cohG k u P.G P.bz P.bez P.q P.eq ;
coh : CZ.Coh = \ k u -> Tr.Trunc[CZ.CohW k u].inc (coh-of k u (gcdF k u)) ;

------------------------------------------------------------------------
-- (N)

surj-of (x : Int) (n : Nat) : ZA.Sign x n -> Tr.Trunc[(c : Nat * Nat) * Id Int (J.val c) x].carrier = split {
  inl e -> Tr.Trunc[(c : Nat * Nat) * Id Int (J.val c) x].inc ((n, zero), sym e) ;
  inr e -> Tr.Trunc[(c : Nat * Nat) * Id Int (J.val c) x].inc ((zero, n), trans (zero-l (neg (J.iota n))) (sym e)) } ;
surj : CN.Over[ZR.ring,J.pres].Surj = \ x -> surj-of x (ZA.abs x).1 (ZA.abs x).2 ;
np : CN.NP (Nat * Nat) ZR.ring = (base, (CN.ofPres ZR.ring J.pres, (J.noeth, surj))) ;

cfn : CFN[l].CFN[Nat * Nat,ZR.ring] =
  CFN[l].mkCFN (Nat * Nat) ZR.ring disc coh (Tr.Trunc[CN.NP (Nat * Nat) ZR.ring].inc np) ;
