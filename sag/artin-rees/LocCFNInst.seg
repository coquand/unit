-- LocCFNInst.seg: the library localisation A[1/c] (PowerLocalization) is
-- CFN when A is (artin-rees.tex, Prop. 12).
--
-- inclusion: the ring map; invertible: the inverse of c; every element is
-- merely a fraction x / c^n (representatives, fraction-equation); the
-- kernel is killed by a power of c (kernel).  Then LocCFN applies.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;

module Over (A : CRing) (c : A.R) {
  module PL = PowerLocalization[l].Over[A,c] ;
  B : CRing = PL.ring ;
  module AP = AffinePowers[l].Over[A] ;
  f : A.R -> B.R = PL.inclusion.1 ;
  Den (y : B.R) : U l = (n : Nat) * (x : A.R) * Id B.R (B.mul (f (AP.power c n)) y) (f x) ;
  den (y : B.R) : Tr.Trunc[Den y].carrier =
    Tr.Trunc[PL.L.Representatives y].induction @l (\ w -> Tr.Trunc[Den y].carrier) (\ w -> Tr.Trunc[Den y].proposition)
      (\ rp -> Tr.Trunc[Den y].inc (rp.1.2.2.1, (rp.1.1,
         trans (ap (\ s -> B.mul (f s) y) (sym rp.1.2.2.2))
           (trans (ap (B.mul (f rp.1.2.1)) (sym rp.2)) (PL.L.fraction-equation rp.1)))))
      (PL.L.representatives y) ;
  module LC = LocCFN[l].Over[A, B, f, PL.inclusion.2.1, PL.inclusion.2.2.1, PL.inclusion.2.2.2,
    c, PL.invertible.1, PL.invertible.2, den, PL.kernel] ;
  localization (K0 : U l) (cA : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,B] = LC.cfn K0 cA ;
} ;
