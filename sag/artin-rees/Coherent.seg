-- Coherent.seg: strong discreteness (D), coherence (C) and the principle
-- of free lists (FL) for a module; CFN rings (artin-rees.tex, Def. 1).
--
-- (D) Disc: membership of y in the span of a finite family is decidable.
--     Only the decision is data; the witness is under truncation.
-- (C) Coh: the syzygies of a finite family u are the combinations of a
--     finite family gs of syzygies, under truncation.
-- (FL) for a proposition-valued Phi on lists: if Phi (x::s) for every x
--     outside the span of the free list s gives Phi s, then Phi holds on
--     every free list.  From Noeth by ModSpan.FreeInd.
-- CFN rings are in CFN.seg.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;

empty-prop : Pr.isProp Empty = \ e e' -> absurd (Id Empty e e') e ;

-- deciding a proposition is a proposition
dec-prop (P : U l) (pP : Pr.isProp P) : Pr.isProp (Plus P (Not P)) = split {
  inl a -> split { inl b -> ap (\ x -> inl x) (pP a b) ;
                   inr n -> absurd (Id (Plus P (Not P)) (inl a) (inr n)) (n a) } ;
  inr n -> split { inl b -> absurd (Id (Plus P (Not P)) (inr n) (inl b)) (n b) ;
                   inr m -> ap (\ x -> inr x) (FE.isProp-Pi P (\ a -> Empty) (\ a -> empty-prop) n m) } } ;

module Over (A : CRing) (Md : IP.Mod[A]) {
  open Md ;
  module S = Comb[l].Sums[A,Md] ; module SP = ModSpan[l].Over[A,Md] ; module LS = Comb[l].Lists[A,Md] ;

  -- (D)
  InFM (n : Nat) (u : Fin n -> M) (y : M) : U l = LS.InF n u y ;
  Mem (n : Nat) (u : Fin n -> M) (y : M) : U l = Tr.Trunc[InFM n u y].carrier ;
  Disc : U l = (n : Nat) (u : Fin n -> M) (y : M) -> Plus (Mem n u y) (Not (Mem n u y)) ;

  -- (C)
  Vec (n : Nat) : U l = Comb[l].Free[A,n].Vec ;
  InFV (n : Nat) (p : Nat) (gs : Fin p -> Vec n) (c : Vec n) : U l = Comb[l].Lists[A,Comb[l].Free[A,n].mod].InF p gs c ;
  MemV (n : Nat) (p : Nat) (gs : Fin p -> Vec n) (c : Vec n) : U l = Tr.Trunc[InFV n p gs c].carrier ;
  Syz (n : Nat) (u : Fin n -> M) (c : Vec n) : U l = Id M (S.comb n c u) mz ;
  SyzAll (n : Nat) (u : Fin n -> M) (p : Nat) (gs : Fin p -> Vec n) : U l = (j : Fin p) -> Syz n u (gs j) ;
  Univ (n : Nat) (u : Fin n -> M) (p : Nat) (gs : Fin p -> Vec n) : U l = (c : Vec n) -> Syz n u c -> MemV n p gs c ;
  CohW (n : Nat) (u : Fin n -> M) : U l = (p : Nat) * ((gs : Fin p -> Vec n) * (SyzAll n u p gs * Univ n u p gs)) ;
  Coh : U l = (n : Nat) (u : Fin n -> M) -> Tr.Trunc[CohW n u].carrier ;

  -- (FL)
  FL : U (l+) = (Phi : List M -> U l) -> ((s : List M) -> Pr.isProp (Phi s)) ->
    ((s : List M) -> SP.Free s -> ((x : M) -> Not (SP.In s x) -> Phi (cons x s)) -> Phi s) ->
    (s : List M) -> SP.Free s -> Phi s ;

  fl-noeth (n : SP.Noeth) : FL = \ Phi pPhi step -> SP.FreeInd[Phi,step].from-noeth n ;
  fl-mere (n : Tr.Trunc[SP.Noeth].carrier) : FL = \ Phi pPhi step s f ->
    Tr.Trunc[SP.Noeth].induction @l (\ t -> Phi s) (\ t -> pPhi s) (\ m -> SP.FreeInd[Phi,step].from-noeth m s f) n ;
} ;
