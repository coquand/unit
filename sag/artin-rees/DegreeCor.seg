-- DegreeCor.seg: Cor. 10 of artin-rees.tex.  Membership in N = sum A[X] f_i
-- is decidable, and N cap M[X]_m is finitely generated, for every m.
--
-- Kernel: for a linear h : P -> Q with Q coherent and a list L of P, the
--   elements of span L killed by h are, merely, the span of a list of such
--   elements: the combinations sum_j sigma^k_j L_j for generators sigma^k
--   of the syzygies of h L (as in Lemma 7).
-- Powers P: XL e is the list of the sequences X^i p_j, i <= e; XS e g for
--   the family p gives g in span (XL e) (xs-in).  Its elements vanish from
--   e + n + 1 on and lie in N when the p_j do.
-- AtDeg: with P saturated and K = e + n + 1, a sequence g vanishing from K
--   on is in N iff its first K coefficients are in the span of WB, the
--   truncations of XL e (Thm. 9 one way, closure of N the other way).
--   (D) for blocks of size K decides this (dec).
-- decide: a sequence vanishing from some k on is in N or not.
-- GenAt m (e = m, K = m + n + 1): H keeps the coefficients of degree > m;
--   Kernel for H on WB, then truncation to M[X]_m = Blk (suc m), gives a
--   list of elements of N cap M[X]_m spanning it (gen).  No case on m < n.
-- Free: the instance M = A^r over a CFN ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

------------------------------------------------------------------------
-- predicates on all elements of a list

AllL (X : U l) (Q : X -> U l) : List X -> U l = split {
  nil -> Top ;
  cons t s | r -> Q t * r } ;
all-map (X Y : U l) (h : X -> Y) (Q : X -> U l) (Q' : Y -> U l) (k : (x : X) -> Q x -> Q' (h x)) :
  (s : List X) -> AllL X Q s -> AllL Y Q' (LinIso[l].mapL X Y h s) = split {
  nil -> \ a -> tt ;
  cons t s | r -> \ a -> (k t a.1, r a.2) } ;
all-mapT (X Y : U l) (h : X -> Y) (Q' : Y -> U l) (k : (x : X) -> Q' (h x)) :
  (s : List X) -> AllL Y Q' (LinIso[l].mapL X Y h s) = split {
  nil -> tt ;
  cons t s | r -> (k t, r) } ;
all-app (X : U l) (Q : X -> U l) : (s s' : List X) -> AllL X Q s -> AllL X Q s' -> AllL X Q (Bar[l].app s s') = split {
  nil -> \ s' a a' -> a' ;
  cons t s | r -> \ s' a a' -> (a.1, r s' a.2 a') } ;
all-and (X : U l) (Q Q' : X -> U l) : (s : List X) -> AllL X Q s -> AllL X Q' s -> AllL X (\ x -> Q x * Q' x) s = split {
  nil -> \ a a' -> tt ;
  cons t s | r -> \ a a' -> ((a.1, a'.1), r a.2 a'.2) } ;

all-imp (X : U l) (Q Q' : X -> U l) (k : (x : X) -> Q x -> Q' x) : (s : List X) -> AllL X Q s -> AllL X Q' s = split {
  nil -> \ a -> tt ;
  cons t s | r -> \ a -> (k t a.1, r a.2) } ;

module ListOf (A : CRing) (Md : IP.Mod[A]) {
  module MS = Spans[l].Over[A,Md] ;
  all-of (Q : Md.M -> U l) : (k : Nat) (u : Fin k -> Md.M) -> ((j : Fin k) -> Q (u j)) -> AllL Md.M Q (MS.list-of k u) = split {
    zero -> \ u h -> tt ;
    suc k | r -> \ u h -> (h (inr tt), r (\ i -> u (inl i)) (\ i -> h (inl i))) } ;
} ;

-- a submodule predicate holding on a list holds on its span
module SpanClosed (A : CRing) (Md : IP.Mod[A]) (Q : Md.M -> U l) (pQ : (x : Md.M) -> Pr.isProp (Q x))
  (qz : Q Md.mz) (qadd : (x y : Md.M) -> Q x -> Q y -> Q (Md.madd x y)) (qsm : (c : A.R) (x : Md.M) -> Q x -> Q (Md.sm c x)) {
  open Md ; module ML = IP.ModL[A,Md] ; module SP = ModSpan[l].Over[A,Md] ; module MS = Spans[l].Over[A,Md] ;
  in-closed : (s : List M) (y : M) -> AllL M Q s -> SP.In s y -> Q y = split {
    nil -> \ y a h -> subst Q (sym h) qz ;
    cons t s | r -> \ y a h -> subst Q (MS.sub-add y (sm h.1 t))
      (qadd (ML.msub y (sm h.1 t)) (sm h.1 t) (r (ML.msub y (sm h.1 t)) a.2 h.2) (qsm h.1 t a.1)) } ;
  mm-closed (s : List M) (y : M) (a : AllL M Q s) (m : MS.Mm s y) : Q y = MS.mm-rec s y (Q y) (pQ y) (in-closed s y a) m ;
} ;

-- spans of concatenations
module AppSpan (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module MS = Spans[l].Over[A,Md] ; module OB = Saturation[l].SpanOps[A,Md] ;
  sub-app-l : (s s' : List M) -> MS.Sub s (Bar[l].app s s') = split {
    nil -> \ s' y h -> MS.mm-rec nil y (MS.Mm s' y) (MS.mm-prop s' y) (\ e -> OB.mm-cong s' mz y (sym e) (OB.mm-zero s')) h ;
    cons t s | r -> \ s' -> MS.cons-mono t s (Bar[l].app s s') (r s') } ;
  sub-app-r : (s s' : List M) -> MS.Sub s' (Bar[l].app s s') = split {
    nil -> \ s' y h -> h ;
    cons t s | r -> \ s' -> MS.sub-trans s' (Bar[l].app s s') (cons t (Bar[l].app s s')) (r s') (MS.weak-sub t (Bar[l].app s s')) } ;
} ;

------------------------------------------------------------------------
-- the kernel of a linear map on a span

module Kernel (A : CRing) (P Q : IP.Mod[A]) (h : P.M -> Q.M)
  (hadd : (x y : P.M) -> Id Q.M (h (P.madd x y)) (Q.madd (h x) (h y)))
  (hsm : (c : A.R) (x : P.M) -> Id Q.M (h (P.sm c x)) (Q.sm c (h x)))
  (cohQ : Coherent[l].Over[A,Q].Coh) (L : List P.M) {
  module HM = LinIso[l].Map[A,P,Q,h,hadd,hsm] ;
  module LP = Comb[l].Lists[A,P] ; module SP = Comb[l].Sums[A,P] ; module MP = Spans[l].Over[A,P] ;
  module CQ = Coherent[l].Over[A,Q] ;
  pe (j : Fin (len L)) : P.M = LP.elem L j ;
  hp (j : Fin (len L)) : Q.M = h (pe j) ;
  Kill (x : P.M) : U l = MP.Mm L x * Id Q.M (h x) Q.mz ;
  KerW : U l = (KL : List P.M) * (AllL P.M Kill KL *
    ((y : P.M) -> MP.Mm L y -> Id Q.M (h y) Q.mz -> MP.Mm KL y)) ;

  module WithGens (p : Nat) (sg : Fin p -> Comb[l].Free[A,len L].Vec)
    (ssyz : CQ.SyzAll (len L) hp p sg) (suniv : CQ.Univ (len L) hp p sg) {
    w (k : Fin p) : P.M = SP.comb (len L) (sg k) pe ;
    kill (k : Fin p) : Kill (w k) =
      (MP.mm L (w k) (LP.fam-in L (w k) (sg k, refl (w k))), trans (HM.comb-map (len L) (sg k) pe) (ssyz k)) ;
    KL : List P.M = MP.list-of p w ;
    module Compl (y : P.M) (z : Id Q.M (h y) Q.mz) (lam : Comb[l].Free[A,len L].Vec) (e : Id P.M (SP.comb (len L) lam pe) y) {
      syz : CQ.Syz (len L) hp lam = trans (sym (HM.comb-map (len L) lam pe)) (trans (ap h e) z) ;
      path (mu : Fin p -> A.R) (emu : Id Comb[l].Free[A,len L].Vec (Comb[l].Free[A,len L].VS.comb p mu sg) lam) :
        Id P.M (SP.comb p mu w) y =
        trans (sym (Comb[l].Bilinear[A,P].comb-comb (len L) p mu sg pe))
          (trans (ap (\ t -> SP.comb (len L) t pe) emu) e) ;
      result : MP.Mm KL y =
        Tr.Trunc[CQ.InFV (len L) p sg lam].induction @l (\ t -> MP.Mm KL y) (\ t -> MP.mm-prop KL y)
          (\ me -> MP.mm KL y (MP.in-lf p w y (me.1, path me.1 me.2)))
          (suniv lam syz) ;
    } ;
    kuniv (y : P.M) (m : MP.Mm L y) (z : Id Q.M (h y) Q.mz) : MP.Mm KL y =
      MP.mm-rec L y (MP.Mm KL y) (MP.mm-prop KL y)
        (\ i -> Compl[y, z, (LP.in-fam L y i).1, (LP.in-fam L y i).2].result) m ;
    res : KerW = (KL, (ListOf[A,P].all-of Kill p w kill, kuniv)) ;
  } ;
  result : Tr.Trunc[KerW].carrier =
    Tr.Trunc[CQ.CohW (len L) hp].induction @l (\ t -> Tr.Trunc[KerW].carrier) (\ t -> Tr.Trunc[KerW].proposition)
      (\ x -> Tr.Trunc[KerW].inc WithGens[x.1, x.2.1, x.2.2.1, x.2.2.2].res) (cohQ (len L) hp) ;
} ;

------------------------------------------------------------------------
-- Cor. 10

module Over (A : CRing) (Md : IP.Mod[A]) (cohM : Coherent[l].Over[A,Md].Coh) (n : Nat)
  (discAll : (k : Nat) -> Coherent[l].Over[A,SeqPoly[l].Over[A,Md].blk k].Disc)
  (cohAll : (k : Nat) -> Coherent[l].Over[A,SeqPoly[l].Over[A,Md].blk k].Coh)
  (flB : Coherent[l].Over[A,SeqPoly[l].Over[A,Md].blk (suc n)].FL)
  (s : Nat) (f : Fin s -> SeqPoly[l].Over[A,Md].Blk (suc n)) {
  module SQ = SeqPoly[l].Over[A,Md] ;
  module S = Saturation[l].Over[A,Md,cohM,n,discAll (suc n),flB,s,f] ;
  Seq : U l = SQ.Seq ;
  Sq : IP.Mod[A] = SQ.seq ;
  module XN = S.XN ;
  module SPq = ModSpan[l].Over[A,Sq] ; module MSq = Spans[l].Over[A,Sq] ;
  module OSq = Saturation[l].SpanOps[A,Sq] ; module ASq = AppSpan[A,Sq] ;
  module XM = LinIso[l].Map[A,Sq,Sq,SQ.Xs,SQ.xs-add',SQ.xs-sm'] ;
  mapL (X Y : U l) (h : X -> Y) (s : List X) : List Y = LinIso[l].mapL X Y h s ;

  -- the sequences X^i p_j, i <= e
  module Powers (P : List S.BM) {
    G (j : Fin (len P)) : Seq = S.emb (S.LB.elem P j) ;
    module XP = XSpan[l].Over[A,Md,len P,G] ;
    G0 : List Seq = mapL S.BM Seq S.emb P ;
    XL : Nat -> List Seq = split {
      zero -> G0 ;
      suc e | r -> Bar[l].app G0 (mapL Seq Seq SQ.Xs r) } ;

    van : (e : Nat) -> AllL Seq (SQ.Van (plus e (suc n))) (XL e) = split {
      zero -> all-mapT S.BM Seq S.emb (SQ.Van (suc n)) (\ x -> SQ.van-emb (suc n) x) P ;
      suc e | r -> all-app Seq (SQ.Van (plus (suc e) (suc n))) G0 (mapL Seq Seq SQ.Xs (XL e))
        (all-mapT S.BM Seq S.emb (SQ.Van (plus (suc e) (suc n)))
           (\ x -> SQ.van-lift (suc e) (suc n) (S.emb x) (SQ.van-emb (suc n) x)) P)
        (all-map Seq Seq SQ.Xs (SQ.Van (plus e (suc n))) (SQ.Van (plus (suc e) (suc n))) (\ x v -> v) (XL e) r) } ;

    g0-nm : (q : List S.BM) -> S.AllN q -> AllL Seq XN.NM (mapL S.BM Seq S.emb q) = split {
      nil -> \ a -> tt ;
      cons t q | r -> \ a -> (a.1, r a.2) } ;
    nm (an : S.AllN P) : (e : Nat) -> AllL Seq XN.NM (XL e) = split {
      zero -> g0-nm P an ;
      suc e | r -> all-app Seq XN.NM G0 (mapL Seq Seq SQ.Xs (XL e)) (g0-nm P an)
        (all-map Seq Seq SQ.Xs XN.NM XN.NM XN.nm-X (XL e) r) } ;

    g0-in (c : Fin (len P) -> A.R) : MSq.Mm G0 (XP.cF c) =
      MSq.mm G0 (XP.cF c)
        (SPq.in-tr G0 (S.emb (S.CB.comb (len P) c (S.LB.elem P))) (XP.cF c) (S.EM.comb-map (len P) c (S.LB.elem P))
          (S.EM.in-map P (S.CB.comb (len P) c (S.LB.elem P))
            (S.LB.fam-in P (S.CB.comb (len P) c (S.LB.elem P)) (c, refl (S.CB.comb (len P) c (S.LB.elem P)))))) ;
    x-in (L : List Seq) (y : Seq) (m : MSq.Mm L y) : MSq.Mm (mapL Seq Seq SQ.Xs L) (SQ.Xs y) =
      MSq.mm-rec L y (MSq.Mm (mapL Seq Seq SQ.Xs L) (SQ.Xs y)) (MSq.mm-prop (mapL Seq Seq SQ.Xs L) (SQ.Xs y))
        (\ i -> MSq.mm (mapL Seq Seq SQ.Xs L) (SQ.Xs y) (XM.in-map L y i)) m ;
    xs-in : (e : Nat) (g : Seq) -> XP.XS e g -> MSq.Mm (XL e) g = split {
      zero -> \ g h -> OSq.mm-cong G0 (XP.cF h.1) g h.2 (g0-in h.1) ;
      suc e | r -> \ g h -> OSq.mm-cong (XL (suc e)) (Sq.madd (XP.cF h.1) (SQ.Xs h.2.1)) g (sym h.2.2.2)
        (OSq.mm-add (XL (suc e)) (XP.cF h.1) (SQ.Xs h.2.1)
          (ASq.sub-app-l G0 (mapL Seq Seq SQ.Xs (XL e)) (XP.cF h.1) (g0-in h.1))
          (ASq.sub-app-r G0 (mapL Seq Seq SQ.Xs (XL e)) (SQ.Xs h.2.1) (x-in (XL e) h.2.1 (r h.2.1 h.2.2.1)))) } ;
  } ;

  -- membership in N at the degree bound K = e + n + 1
  module AtDeg (P : List S.BM) (hf : (i : Fin s) -> S.MB.Mm P (f i)) (sat : S.Sat P) (an : S.AllN P) (e : Nat) {
    module PW = Powers[P] ;
    module L2 = S.Lemma2[P, hf, sat] ;
    K : Nat = plus e (suc n) ;
    BK : IP.Mod[A] = SQ.blk K ;
    BKM : U l = SQ.Blk K ;
    module TK = LinIso[l].Map[A,Sq,BK,SQ.trunc K,SQ.trunc-add' K,SQ.trunc-sm' K] ;
    module EK = LinIso[l].Map[A,BK,Sq,SQ.emb K,SQ.emb-add' K,SQ.emb-sm' K] ;
    module MK = Spans[l].Over[A,BK] ;
    WB : List BKM = mapL Seq BKM (SQ.trunc K) (PW.XL e) ;
    InK (x : BKM) : U l = XN.NM (SQ.emb K x) ;
    wb-in : AllL BKM InK WB =
      all-map Seq BKM (SQ.trunc K) (\ y -> SQ.Van K y * XN.NM y) InK
        (\ y q -> XN.nm-cong y (SQ.emb K (SQ.trunc K y)) (sym (SQ.sext _ _ (SQ.emb-trunc K y q.1))) q.2)
        (PW.XL e) (all-and Seq (SQ.Van K) XN.NM (PW.XL e) (PW.van e) (PW.nm an e)) ;
    kz : InK BK.mz = XN.nm-cong Sq.mz (SQ.emb K BK.mz) (sym EK.hz) XN.nm-zero ;
    kadd (x y : BKM) (hx : InK x) (hy : InK y) : InK (BK.madd x y) =
      XN.nm-cong (Sq.madd (SQ.emb K x) (SQ.emb K y)) (SQ.emb K (BK.madd x y)) (sym (SQ.emb-add' K x y))
        (XN.nm-add (SQ.emb K x) (SQ.emb K y) hx hy) ;
    ksm (c : A.R) (x : BKM) (hx : InK x) : InK (BK.sm c x) =
      XN.nm-cong (Sq.sm c (SQ.emb K x)) (SQ.emb K (BK.sm c x)) (sym (SQ.emb-sm' K c x)) (XN.nm-sm c (SQ.emb K x) hx) ;
    module KC = SpanClosed[A,BK,InK,\ x -> XN.nm-prop (SQ.emb K x),kz,kadd,ksm] ;

    to-wb (g : Seq) (v : SQ.Van K g) (h : XN.NM g) : MK.Mm WB (SQ.trunc K g) =
      Tr.Trunc[PW.XP.XS e g].induction @l (\ t -> MK.Mm WB (SQ.trunc K g)) (\ t -> MK.mm-prop WB (SQ.trunc K g))
        (\ x -> MSq.mm-rec (PW.XL e) g (MK.Mm WB (SQ.trunc K g)) (MK.mm-prop WB (SQ.trunc K g))
           (\ i -> MK.mm WB (SQ.trunc K g) (TK.in-map (PW.XL e) g i)) (PW.xs-in e g x))
        (L2.lemma2 e g v h) ;
    from-wb (g : Seq) (v : SQ.Van K g) (m : MK.Mm WB (SQ.trunc K g)) : XN.NM g =
      XN.nm-cong (SQ.emb K (SQ.trunc K g)) g (SQ.sext _ _ (SQ.emb-trunc K g v)) (KC.mm-closed WB (SQ.trunc K g) wb-in m) ;

    dec-step (g : Seq) (v : SQ.Van K g) :
      Plus (MK.Mm WB (SQ.trunc K g)) (Not (MK.Mm WB (SQ.trunc K g))) -> Plus (XN.NM g) (Not (XN.NM g)) = split {
      inl m -> inl (from-wb g v m) ;
      inr no -> inr (\ h -> no (to-wb g v h)) } ;
    dec (g : Seq) (v : SQ.Van K g) : Plus (XN.NM g) (Not (XN.NM g)) =
      dec-step g v (MK.dec-list (discAll K) WB (SQ.trunc K g)) ;
  } ;

  ------------------------------------------------------------------------
  -- membership in N is decidable

  Dec (g : Seq) : U l = Plus (XN.NM g) (Not (XN.NM g)) ;
  van-K (k : Nat) (g : Seq) (v : SQ.Van k g) : SQ.Van (plus k (suc n)) g =
    subst (\ i -> SQ.Van i g) (plus-comm (suc n) k) (SQ.van-lift (suc n) k g v) ;
  decide (k : Nat) (g : Seq) (v : SQ.Van k g) : Dec g =
    Tr.Trunc[S.Saturated].induction @l (\ t -> Dec g) (\ t -> Coherent[l].dec-prop (XN.NM g) (XN.nm-prop g))
      (\ x -> AtDeg[x.1, x.2.1, x.2.2.2, x.2.2.1, k].dec g (van-K k g v)) S.saturate ;

  ------------------------------------------------------------------------
  -- N cap M[X]_m is finitely generated

  Gen (m : Nat) : U l = (Gs : List (SQ.Blk (suc m))) *
    (AllL (SQ.Blk (suc m)) (\ x -> XN.NM (SQ.emb (suc m) x)) Gs *
     ((u : SQ.Blk (suc m)) -> XN.NM (SQ.emb (suc m) u) -> Spans[l].Over[A,SQ.blk (suc m)].Mm Gs u)) ;

  plus-assoc : (a b c : Nat) -> Id Nat (plus (plus a b) c) (plus a (plus b c)) = split {
    zero -> \ b c -> refl (plus b c) ;
    suc a | r -> \ b c -> ap (\ k -> suc k) (r b c) } ;
  -- a + (b + c) = b + (a + c)
  plus-swap (a b c : Nat) : Id Nat (plus a (plus b c)) (plus b (plus a c)) =
    trans (sym (plus-assoc a b c)) (trans (ap (\ k -> plus k c) (plus-comm a b)) (plus-assoc b a c)) ;
  -- n + (m + 1) = m + (n + 1)
  deg-eq (m : Nat) : Id Nat (plus n (suc m)) (plus m (suc n)) =
    trans (plus-suc n m) (trans (ap (\ k -> suc k) (plus-comm n m)) (sym (plus-suc m n))) ;

  module GenAt (P : List S.BM) (hf : (i : Fin s) -> S.MB.Mm P (f i)) (sat : S.Sat P) (an : S.AllN P) (m : Nat) {
    module D = AtDeg[P, hf, sat, an, m] ;
    K : Nat = D.K ;
    BK : IP.Mod[A] = D.BK ;
    BKM : U l = D.BKM ;
    B1 : IP.Mod[A] = SQ.blk (suc m) ;
    B1M : U l = SQ.Blk (suc m) ;

    -- H keeps the coefficients of degree > m
    sh (g : Seq) : Seq = \ j -> g (plus (suc m) j) ;
    H (x : BKM) : BKM = SQ.trunc K (sh (SQ.emb K x)) ;
    hadd (x y : BKM) : Id BKM (H (BK.madd x y)) (BK.madd (H x) (H y)) =
      trans (ap (\ g -> SQ.trunc K (sh g)) (SQ.emb-add' K x y)) (SQ.trunc-add' K (sh (SQ.emb K x)) (sh (SQ.emb K y))) ;
    hsm (c : A.R) (x : BKM) : Id BKM (H (BK.sm c x)) (BK.sm c (H x)) =
      trans (ap (\ g -> SQ.trunc K (sh g)) (SQ.emb-sm' K c x)) (SQ.trunc-sm' K c (sh (SQ.emb K x))) ;
    -- phi: truncation to M[X]_m
    phi (x : BKM) : B1M = SQ.trunc (suc m) (SQ.emb K x) ;
    padd (x y : BKM) : Id B1M (phi (BK.madd x y)) (B1.madd (phi x) (phi y)) =
      trans (ap (SQ.trunc (suc m)) (SQ.emb-add' K x y)) (SQ.trunc-add' (suc m) (SQ.emb K x) (SQ.emb K y)) ;
    psm (c : A.R) (x : BKM) : Id B1M (phi (BK.sm c x)) (B1.sm c (phi x)) =
      trans (ap (SQ.trunc (suc m)) (SQ.emb-sm' K c x)) (SQ.trunc-sm' (suc m) c (SQ.emb K x)) ;
    module PM = LinIso[l].Map[A,BK,B1,phi,padd,psm] ;
    module KR = Kernel[A,BK,BK,H,hadd,hsm,cohAll K,D.WB] ;
    module M1 = Spans[l].Over[A,B1] ;

    -- an element killed by H vanishes from m + 1 on
    van-sh (x : BKM) : SQ.Van K (sh (SQ.emb K x)) = \ j ->
      subst (\ i -> Id Md.M (SQ.emb K x i) Md.mz) (plus-swap K (suc m) j) (SQ.van-emb K x (plus (suc m) j)) ;
    killed-van (x : BKM) (z : Id BKM (H x) BK.mz) : SQ.Van (suc m) (SQ.emb K x) = \ j ->
      trans (sym (SQ.emb-trunc K (sh (SQ.emb K x)) (van-sh x) j))
        (trans (Pr.happly Nat (\ i -> Md.M) (SQ.emb K (H x)) (SQ.emb K BK.mz) (ap (SQ.emb K) z) j)
          (Pr.happly Nat (\ i -> Md.M) (SQ.emb K BK.mz) Sq.mz D.EK.hz j)) ;
    phi-emb (x : BKM) (z : Id BKM (H x) BK.mz) : Id Seq (SQ.emb (suc m) (phi x)) (SQ.emb K x) =
      SQ.sext _ _ (SQ.emb-trunc (suc m) (SQ.emb K x) (killed-van x z)) ;
    gen-in (x : BKM) (k : KR.Kill x) : XN.NM (SQ.emb (suc m) (phi x)) =
      XN.nm-cong (SQ.emb K x) (SQ.emb (suc m) (phi x)) (sym (phi-emb x k.2)) (D.KC.mm-closed D.WB x D.wb-in k.1) ;

    -- an element u of N cap M[X]_m, padded to degree K
    module Pad (u : B1M) (h : XN.NM (SQ.emb (suc m) u)) {
      g : Seq = SQ.emb (suc m) u ;
      vK : SQ.Van K g = subst (\ i -> SQ.Van i g) (deg-eq m) (SQ.van-lift n (suc m) g (SQ.van-emb (suc m) u)) ;
      pad : BKM = SQ.trunc K g ;
      et : Id Seq (SQ.emb K pad) g = SQ.sext _ _ (SQ.emb-trunc K g vK) ;
      hz : Id BKM (H pad) BK.mz =
        trans (ap (\ y -> SQ.trunc K (sh y)) et)
          (trans (ap (SQ.trunc K) (SQ.sext (sh g) Sq.mz (\ j -> SQ.van-emb (suc m) u j))) D.TK.hz) ;
      back : Id B1M (phi pad) u =
        trans (ap (SQ.trunc (suc m)) et) (Blocks[l].Pow[A,Md,suc m].ext _ _ (SQ.trunc-emb (suc m) u)) ;
      result (KL : List BKM) (kuniv : (y : BKM) -> D.MK.Mm D.WB y -> Id BKM (H y) BK.mz -> D.MK.Mm KL y) :
        M1.Mm (mapL BKM B1M phi KL) u =
        D.MK.mm-rec KL pad (M1.Mm (mapL BKM B1M phi KL) u) (M1.mm-prop (mapL BKM B1M phi KL) u)
          (\ i -> M1.mm (mapL BKM B1M phi KL) u (M1.SP.in-tr (mapL BKM B1M phi KL) (phi pad) u back (PM.in-map KL pad i)))
          (kuniv pad (D.to-wb g vK h) hz) ;
    } ;

    finish (w : KR.KerW) : Gen m =
      (mapL BKM B1M phi w.1,
       (all-map BKM B1M phi KR.Kill (\ x -> XN.NM (SQ.emb (suc m) x)) gen-in w.1 w.2.1,
        \ u h -> Pad[u, h].result w.1 w.2.2)) ;
    result : Tr.Trunc[Gen m].carrier =
      Tr.Trunc[KR.KerW].induction @l (\ t -> Tr.Trunc[Gen m].carrier) (\ t -> Tr.Trunc[Gen m].proposition)
        (\ w -> Tr.Trunc[Gen m].inc (finish w)) KR.result ;
  } ;

  gen (m : Nat) : Tr.Trunc[Gen m].carrier =
    Tr.Trunc[S.Saturated].induction @l (\ t -> Tr.Trunc[Gen m].carrier) (\ t -> Tr.Trunc[Gen m].proposition)
      (\ x -> GenAt[x.1, x.2.1, x.2.2.2, x.2.2.1, m].result) S.saturate ;
} ;

-- the instance M = A^r over a CFN ring
module Free (A : CRing) (disc : Coherent[l].Over[A,IP.regular A].Disc) (coh : Coherent[l].Over[A,IP.regular A].Coh)
  (flA : Coherent[l].Over[A,IP.regular A].FL) (r n s : Nat)
  (f : Fin s -> SeqPoly[l].Over[A,Comb[l].Free[A,r].mod].Blk (suc n)) {
  module D = Over[A,Comb[l].Free[A,r].mod,FreeCoherent[l].Over[A,coh].coh-vec r,n,
    \ k -> Blocks[l].Over[A,disc,coh,flA,r,k].disc-pow,
    \ k -> Blocks[l].Over[A,disc,coh,flA,r,k].coh-pow,
    Blocks[l].Over[A,disc,coh,flA,r,suc n].fl-pow,s,f] ;
  decide (k : Nat) (g : D.Seq) (v : D.SQ.Van k g) : D.Dec g = D.decide k g v ;
  gen (m : Nat) : Tr.Trunc[D.Gen m].carrier = D.gen m ;
} ;
