-- Blocks.seg: the power module M^k = Fin k -> M, and (D), (C), (FL) for
-- (A^r)^k over a CFN ring (artin-rees.tex, §3: M[X]_n = A^(r(n+1))).
--
-- Pow Md k: families of k elements of Md, with the operations pointwise.
-- times k r = r k (times (suc k) r = times k r + r).  The index maps
-- ix : Fin a + Fin b -> Fin (a + b) and xi back are inverse; from them
-- jx k : Fin k -> Fin r -> Fin (times k r), with inverse (xk, xr).
-- Precomposition with these index maps is a linear isomorphism
-- A^(times k r) = (A^r)^k (linearity holds by computation), and LinIso
-- transfers (D), (C), (FL) from Prop. 3.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

-- the power module
module Pow (A : CRing) (Md : IP.Mod[A]) (k : Nat) {
  open Md ;
  E : U l = Fin k -> M ;
  ext (u v : E) (h : (j : Fin k) -> Id M (u j) (v j)) : Id E u v = FE.funext (Fin k) (\ j -> M) u v h ;
  module ML = IP.ModL[A,Md] ;
  mod : IP.Mod[A] = IP.mkMod A E (\ j -> mz) (\ u v j -> madd (u j) (v j)) (\ u j -> mneg (u j))
    (\ u v w -> ext _ _ (\ j -> maddA (u j) (v j) (w j)))
    (\ u v -> ext _ _ (\ j -> maddC (u j) (v j)))
    (\ u -> ext _ _ (\ j -> maddZ (u j)))
    (\ u -> ext _ _ (\ j -> maddN (u j)))
    (\ c u j -> sm c (u j))
    (\ c c' u -> ext _ _ (\ j -> smA c c' (u j)))
    (\ u -> ext _ _ (\ j -> smO (u j)))
    (\ c u v -> ext _ _ (\ j -> smD c (u j) (v j)))
    (\ c c' u -> ext _ _ (\ j -> smE c c' (u j))) ;
} ;

------------------------------------------------------------------------
-- index maps

top-eq (X : U l) (h : Top -> X) : (t : Top) -> Id X (h tt) (h t) = split { tt -> refl (h tt) } ;

ixS (a b : Nat) (ih : Plus (Fin a) (Fin b) -> Fin (plus a b)) : Plus (Fin (suc a)) (Fin b) -> Fin (plus (suc a) b) = split {
  inl i -> snoc (Fin a) (Fin (plus (suc a) b)) (\ i' -> inl (ih (inl i'))) (inr tt) i ;
  inr j -> inl (ih (inr j)) } ;
ix : (a b : Nat) -> Plus (Fin a) (Fin b) -> Fin (plus a b) = split {
  zero -> \ b -> split { inl e -> absurd (Fin b) e ; inr j -> j } ;
  suc a | ih -> \ b -> ixS a b (ih b) } ;

xiL (a b : Nat) : Plus (Fin a) (Fin b) -> Plus (Fin (suc a)) (Fin b) = split {
  inl i -> inl (inl i) ;
  inr j -> inr j } ;
xiS (a b : Nat) (ih : Fin (plus a b) -> Plus (Fin a) (Fin b)) : Fin (plus (suc a) b) -> Plus (Fin (suc a)) (Fin b) = split {
  inl n -> xiL a b (ih n) ;
  inr t -> inl (inr tt) } ;
xi : (a b : Nat) -> Fin (plus a b) -> Plus (Fin a) (Fin b) = split {
  zero -> \ b j -> inr j ;
  suc a | ih -> \ b -> xiS a b (ih b) } ;

-- xi (ix x) = x
xi-ix-top (a b : Nat) (ih : Plus (Fin a) (Fin b) -> Fin (plus a b)) (ih' : Fin (plus a b) -> Plus (Fin a) (Fin b))
  (e : (x : Plus (Fin a) (Fin b)) -> Id (Plus (Fin a) (Fin b)) (ih' (ih x)) x) :
  (i : Fin (suc a)) -> Id (Plus (Fin (suc a)) (Fin b)) (xiS a b ih' (ixS a b ih (inl i))) (inl i) = split {
  inl i -> ap (xiL a b) (e (inl i)) ;
  inr t -> top-eq (Plus (Fin (suc a)) (Fin b)) (\ t' -> inl (inr t')) t } ;
xi-ix-suc (a b : Nat) (e : (x : Plus (Fin a) (Fin b)) -> Id (Plus (Fin a) (Fin b)) (xi a b (ix a b x)) x) :
  (x : Plus (Fin (suc a)) (Fin b)) -> Id (Plus (Fin (suc a)) (Fin b)) (xi (suc a) b (ix (suc a) b x)) x = split {
  inl i -> xi-ix-top a b (ix a b) (xi a b) e i ;
  inr j -> ap (xiL a b) (e (inr j)) } ;
xi-ix : (a b : Nat) (x : Plus (Fin a) (Fin b)) -> Id (Plus (Fin a) (Fin b)) (xi a b (ix a b x)) x = split {
  zero -> \ b -> split { inl e -> absurd (Id (Plus (Fin zero) (Fin b)) (xi zero b (ix zero b (inl e))) (inl e)) e ;
                         inr j -> refl (inr j) } ;
  suc a | ih -> \ b -> xi-ix-suc a b (ih b) } ;

-- ix (xi n) = n
ix-xiL (a b : Nat) : (x : Plus (Fin a) (Fin b)) -> Id (Fin (plus (suc a) b)) (ix (suc a) b (xiL a b x)) (inl (ix a b x)) = split {
  inl i -> refl (inl (ix a b (inl i))) ;
  inr j -> refl (inl (ix a b (inr j))) } ;
ix-xi-suc (a b : Nat) (e : (n : Fin (plus a b)) -> Id (Fin (plus a b)) (ix a b (xi a b n)) n) :
  (n : Fin (plus (suc a) b)) -> Id (Fin (plus (suc a) b)) (ix (suc a) b (xi (suc a) b n)) n = split {
  inl n -> trans (ix-xiL a b (xi a b n)) (ap (\ m -> inl m) (e n)) ;
  inr t -> top-eq (Fin (plus (suc a) b)) (\ t' -> inr t') t } ;
ix-xi : (a b : Nat) (n : Fin (plus a b)) -> Id (Fin (plus a b)) (ix a b (xi a b n)) n = split {
  zero -> \ b n -> refl n ;
  suc a | ih -> \ b -> ix-xi-suc a b (ih b) } ;

------------------------------------------------------------------------
-- blocks of size r

times (r : Nat) : Nat -> Nat = split {
  zero -> zero ;
  suc k | t -> plus t r } ;

module Idx (r : Nat) {
  jxS (k : Nat) (ih : Fin k -> Fin r -> Fin (times r k)) : Fin (suc k) -> Fin r -> Fin (times r (suc k)) = split {
    inl j -> \ i -> ix (times r k) r (inl (ih j i)) ;
    inr t -> \ i -> ix (times r k) r (inr i) } ;
  jx : (k : Nat) -> Fin k -> Fin r -> Fin (times r k) = split {
    zero -> \ j i -> absurd (Fin zero) j ;
    suc k | ih -> jxS k ih } ;

  xkP (k : Nat) (ih : Fin (times r k) -> Fin k) : Plus (Fin (times r k)) (Fin r) -> Fin (suc k) = split {
    inl m -> inl (ih m) ;
    inr i -> inr tt } ;
  xrP (k : Nat) (ih : Fin (times r k) -> Fin r) : Plus (Fin (times r k)) (Fin r) -> Fin r = split {
    inl m -> ih m ;
    inr i -> i } ;
  xk : (k : Nat) -> Fin (times r k) -> Fin k = split {
    zero -> \ n -> n ;
    suc k | ih -> \ n -> xkP k ih (xi (times r k) r n) } ;
  xr : (k : Nat) -> Fin (times r k) -> Fin r = split {
    zero -> \ n -> absurd (Fin r) n ;
    suc k | ih -> \ n -> xrP k ih (xi (times r k) r n) } ;

  -- the two coordinates of jx j i
  xk-jxS (k : Nat) (e : (j : Fin k) (i : Fin r) -> Id (Fin k) (xk k (jx k j i)) j) :
    (j : Fin (suc k)) (i : Fin r) -> Id (Fin (suc k)) (xk (suc k) (jx (suc k) j i)) j = split {
    inl j -> \ i -> trans (ap (xkP k (xk k)) (xi-ix (times r k) r (inl (jx k j i)))) (ap (\ m -> inl m) (e j i)) ;
    inr t -> \ i -> trans (ap (xkP k (xk k)) (xi-ix (times r k) r (inr i)))
                      (top-eq (Fin (suc k)) (\ t' -> inr t') t) } ;
  xk-jx : (k : Nat) (j : Fin k) (i : Fin r) -> Id (Fin k) (xk k (jx k j i)) j = split {
    zero -> \ j i -> absurd (Id (Fin zero) (xk zero (jx zero j i)) j) j ;
    suc k | e -> xk-jxS k e } ;

  xr-jxS (k : Nat) (e : (j : Fin k) (i : Fin r) -> Id (Fin r) (xr k (jx k j i)) i) :
    (j : Fin (suc k)) (i : Fin r) -> Id (Fin r) (xr (suc k) (jx (suc k) j i)) i = split {
    inl j -> \ i -> trans (ap (xrP k (xr k)) (xi-ix (times r k) r (inl (jx k j i)))) (e j i) ;
    inr t -> \ i -> ap (xrP k (xr k)) (xi-ix (times r k) r (inr i)) } ;
  xr-jx : (k : Nat) (j : Fin k) (i : Fin r) -> Id (Fin r) (xr k (jx k j i)) i = split {
    zero -> \ j i -> absurd (Id (Fin r) (xr zero (jx zero j i)) i) j ;
    suc k | e -> xr-jxS k e } ;

  -- jx (xk n) (xr n) = n
  jx-xP (k : Nat) (e : (n : Fin (times r k)) -> Id (Fin (times r k)) (jx k (xk k n) (xr k n)) n) :
    (x : Plus (Fin (times r k)) (Fin r)) ->
    Id (Fin (times r (suc k))) (jx (suc k) (xkP k (xk k) x) (xrP k (xr k) x)) (ix (times r k) r x) = split {
    inl m -> ap (\ z -> ix (times r k) r (inl z)) (e m) ;
    inr i -> refl (ix (times r k) r (inr i)) } ;
  jx-x : (k : Nat) (n : Fin (times r k)) -> Id (Fin (times r k)) (jx k (xk k n) (xr k n)) n = split {
    zero -> \ n -> absurd (Id (Fin zero) (jx zero (xk zero n) (xr zero n)) n) n ;
    suc k | e -> \ n -> trans (jx-xP k e (xi (times r k) r n)) (ix-xi (times r k) r n) } ;
} ;

------------------------------------------------------------------------
-- (A^r)^k = A^(times r k), and (D), (C), (FL) for (A^r)^k

module Over (A : CRing) (disc : Coherent[l].Over[A,IP.regular A].Disc) (coh : Coherent[l].Over[A,IP.regular A].Coh)
  (flA : Coherent[l].Over[A,IP.regular A].FL) (r k : Nat) {
  module I = Idx[r] ;
  m : Nat = times r k ;
  module FV = Comb[l].Free[A,m] ;
  module FR = Comb[l].Free[A,r] ;
  module PW = Pow[A,FR.mod,k] ;
  P : IP.Mod[A] = FV.mod ;
  Q : IP.Mod[A] = PW.mod ;

  f (v : FV.Vec) : PW.E = \ j i -> v (I.jx k j i) ;
  g (w : PW.E) : FV.Vec = \ n -> w (I.xk k n) (I.xr k n) ;
  fadd (x y : FV.Vec) : Id PW.E (f (P.madd x y)) (Q.madd (f x) (f y)) = refl (f (P.madd x y)) ;
  fsm (c : A.R) (x : FV.Vec) : Id PW.E (f (P.sm c x)) (Q.sm c (f x)) = refl (f (P.sm c x)) ;
  gadd (x y : PW.E) : Id FV.Vec (g (Q.madd x y)) (P.madd (g x) (g y)) = refl (g (Q.madd x y)) ;
  gsm (c : A.R) (x : PW.E) : Id FV.Vec (g (Q.sm c x)) (P.sm c (g x)) = refl (g (Q.sm c x)) ;

  -- w j' i' = w j i  from  j' = j  and  i' = i
  at2 (w : PW.E) (j j' : Fin k) (i i' : Fin r) (e : Id (Fin k) j' j) (e' : Id (Fin r) i' i) : Id A.R (w j' i') (w j i) =
    trans (ap (\ z -> w z i') e) (ap (w j) e') ;
  fg (w : PW.E) : Id PW.E (f (g w)) w =
    PW.ext (f (g w)) w (\ j -> FR.ext (f (g w) j) (w j) (\ i ->
      at2 w j (I.xk k (I.jx k j i)) i (I.xr k (I.jx k j i)) (I.xk-jx k j i) (I.xr-jx k j i))) ;
  gf (v : FV.Vec) : Id FV.Vec (g (f v)) v = FV.ext (g (f v)) v (\ n -> ap v (I.jx-x k n)) ;

  module T = LinIso[l].Over[A,P,Q,f,fadd,fsm,g,gadd,gsm,fg,gf] ;
  module FC = FreeCoherent[l].Over[A,coh] ;
  module FD = FreeDisc[l].Over[A,disc,coh] ;
  module FN = FreeNoeth[l].Over[A,disc,coh,flA] ;
  disc-pow : Coherent[l].Over[A,Q].Disc = T.disc (FD.disc-vec m) ;
  coh-pow : Coherent[l].Over[A,Q].Coh = T.coh (FC.coh-vec m) ;
  fl-pow : Coherent[l].Over[A,Q].FL = T.fl (FN.fl-vec m) ;
} ;
