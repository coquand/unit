-- ACLCorrection.seg: artin-rees.tex §8, « La correction »: the datum
-- ReesLiftingCong.Lift of the Cech model, from Cor. N (ACLRelations.corN),
-- Theorem 14 and PowSpan, for A CFN (no coded noetherian presentation).
--
-- Notation of ACLRelations and CechF1: rho_n = F1.rhoF n (for n = k + 1 the
-- coefficients of q_n at the exponents ts, in I^k), c_n = F1.vF n (= cS n
-- for n >= 1, in I^n K^0(-1)), z* = F1.zsS, and (beta_n) = F1.betaF n:
--     d0 z* - (G rho_n + d0 c_n)  in N^1 ;
-- dlt rho v = G rho - d0 v, and N = {rho | merely v with dlt rho v in N^1}.
--
-- Lemma (rho-N).  rho_n is in N, with v = z* - c_n:
--   dlt rho_n (z* - c_n) = -(d0 z* - (G rho_n + d0 c_n))   (neg-beta).
-- Lemma (corr).  Let u_1..u_p, b_1..b_p with dlt u_j b_j in N^1.  If
--   y = sum_j lambda_j u_j with every lambda_j in I^m (PowSpan.InP m on the
--   list of the u_j), then w = sum_j lambda_j b_j is in I^m K^0(-1) and
--   dlt y w is in N^1.  Recursion on p: lambda b is in I^m K^0 when lambda
--   is in I^m (IdealPowers.Mult), and dlt is linear:
--     dlt y (lambda b + w') = lambda dlt u b + dlt (y - lambda u) w' .
-- Proposition (correction).  For every m, merely h in K^0(-1) with
--   d0 h in N^1 and h - z* in I^m K^0(-1).
--   Proof.  Cor. N gives u_j, b_j with dlt u_j b_j in N^1 and N = span(u_j);
--   Theorem 14 for span(u_j) in A^r (PowSpan.Free.coefficients) a bound c.
--   Let k = m + c and n = k + 1.  rho_n is in I^k A^r (the coefficient
--   vector of q_n, MapPow) and in N (rho-N), so rho_n = sum_j lambda_j u_j
--   with lambda_j in I^m; corr gives w'; let w = c_n + w' and h = z* - w.
--   Then
--     d0 h = (d0 z* - (G rho_n + d0 c_n)) + (G rho_n - d0 w')   (cor-sum)
--   is in N^1, and h - z* = (z* - z*) - w is in I^m, since c_n is in
--   I^(k+1), contained in I^(c+m) and in I^m.  All the choices (generators,
--   bound, coefficients) are under truncation; the conclusion is a
--   proposition.
-- For m = 1 this is the datum ReesLiftingCong.Over.Lift of the data (F1)
-- (lift-rc: the same type, for any presentation of A one would pass there).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module RC = ReesLiftingCong[l] ; module Tr = Truncation[l] ;
module Ps = Presentations[l] ; module CMn = CechMonomials[l] ; module TC = TruncationCombinators[l] ;

-- a family as a list (head last, as Comb.Lists.elem), and a combination of
-- the family as a member of the span of the list
module FamList (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ; open ML ;
  module LS = Comb[l].Lists[A,Md] ; module SP = ModSpan[l].Over[A,Md] ;
  toList : (p : Ring[l].Nat) -> (Ps.Fin p -> M) -> List M = split {
    zero -> \ u -> nil ;
    suc p | r -> \ u -> cons (u (inr tt)) (r (\ i -> u (inl i))) } ;
  in-of : (p : Ring[l].Nat) (u : Ps.Fin p -> M) (y : M) -> LS.InF p u y -> SP.In (toList p u) y = split {
    zero -> \ u y h -> sym h.2 ;
    suc p | r -> \ u y h -> (h.1 (inr tt),
      r (\ i -> u (inl i)) (msub y (sm (h.1 (inr tt)) (u (inr tt))))
        (\ i -> h.1 (inl i), LS.split-sub y (u (inr tt)) (LS.S.comb p (\ i -> h.1 (inl i)) (\ i -> u (inl i))) (h.1 (inr tt)) h.2)) } ;
} ;

-- group identities
module Grp (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module ML = IP.ModL[A,Md] ; open ML ;
  -- (x - y) + (y - w) = x - w
  tele (x y w : M) : Id M (madd (msub x y) (msub y w)) (msub x w) =
    calc M {
      madd (msub x y) (msub y w)
        =< sym (maddA x (mneg y) (msub y w)) > madd x (madd (mneg y) (msub y w))
        =< ap (madd x) (maddA (mneg y) y (mneg w)) > madd x (madd (madd (mneg y) y) (mneg w))
        =< ap (\ t -> madd x (madd t (mneg w))) (trans (maddC (mneg y) y) (maddN y)) > madd x (madd mz (mneg w))
        =< ap (madd x) (G.zl (mneg w)) > msub x w } ;
  -- g - (z - c) = -(z - (g + c))
  neg-beta (z g c : M) : Id M (msub g (msub z c)) (mneg (msub z (madd g c))) =
    calc M {
      msub g (msub z c)
        =< ap (madd g) (trans (G.neg-add z (mneg c)) (ap (madd (mneg z)) (G.neg-neg c))) > madd g (madd (mneg z) c)
        =< maddA g (mneg z) c > madd (madd g (mneg z)) c
        =< ap (\ t -> madd t c) (maddC g (mneg z)) > madd (madd (mneg z) g) c
        =< sym (maddA (mneg z) g c) > madd (mneg z) (madd g c)
        =< ap (madd (mneg z)) (sym (G.neg-neg (madd g c))) > madd (mneg z) (mneg (mneg (madd g c)))
        =< sym (G.neg-add z (mneg (madd g c))) > mneg (msub z (madd g c)) } ;
  -- (z - (g + c)) + (g - w) = z - (c + w)
  cor-sum (z g c w : M) : Id M (madd (msub z (madd g c)) (msub g w)) (msub z (madd c w)) =
    calc M {
      madd (msub z (madd g c)) (msub g w)
        =< ap (\ t -> madd t (msub g w)) (trans (sym (sub-sub z g c)) (sub-comm z g c)) > madd (msub (msub z c) g) (msub g w)
        =< tele (msub z c) g w > msub (msub z c) w
        =< sub-sub z c w > msub z (madd c w) } ;
} ;

module Over (D : CRing) (setD : Pr.isSet D.R) (a b : D.R)
  -- the two charts (CechF1)
  (muP : E3) (FP GP : Laurent3[l].Over[D].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[D].NonNegY FP) (yG : Laurent3[l].Over[D].NonNegY GP)
  (dF : Laurent3[l].Over[D].HomPI (deg muP) FP) (dG : Laurent3[l].Over[D].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[D].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[D].NonNegX FQ) (xG : Laurent3[l].Over[D].NonNegX GQ)
  (dF' : Laurent3[l].Over[D].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[D].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[D,setD].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[D,setD].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[D,setD].IsPoly (deg muP) (Laurent3[l].Over[D].monoP muP))
  (pmuQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) (Laurent3[l].Over[D].monoP muQ))
  (pP : CechModules[l].Over[D,setD].IsPoly (deg muP) (FixedCochain[l].Over[D,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[D,setD].IsPoly (deg muQ) (FixedCochain[l].Over[D,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- the degrees: deg g = dg, kP = -1 - deg muP = negsuc dn, kQ = negsuc en
  (dg : Nat) (hdg : Id Int (add (deg muP) (deg muQ)) (pos dg))
  (dn en : Nat) (hkP : Id Int (add (negsuc zero) (deg (neg3 muP))) (negsuc dn))
  (hkQ : Id Int (add (negsuc zero) (deg (neg3 muQ))) (negsuc en))
  (kW : Int) (dW : Nat) (hWn : Id Int kW (negsuc dW))
  -- a common divisor D0: P = D0 P', Q = D0 Q' as products on Laurent elements
  (D0 P' Q' : Laurent3[l].Over[D].LPoly) (dP' dQ' : Int)
  (pP' : CechModules[l].Over[D,setD].IsPoly dP' P') (pQ' : CechModules[l].Over[D,setD].IsPoly dQ' Q')
  (hW1 : Id Int (add kW dQ') (add (negsuc zero) (deg (neg3 muP))))
  (hW2 : Id Int (add kW dP') (add (negsuc zero) (deg (neg3 muQ))))
  (fP : (f : Laurent3[l].Over[D].Lau) -> Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].mulP (FixedCochain[l].Over[D,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) f) (Laurent3[l].Over[D].mulP D0 (Laurent3[l].Over[D].mulP P' f)))
  (fQ : (f : Laurent3[l].Over[D].Lau) -> Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].mulP (FixedCochain[l].Over[D,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) f) (Laurent3[l].Over[D].mulP D0 (Laurent3[l].Over[D].mulP Q' f)))
  -- (S0) for D0 and (S1) for P', Q'
  (s0 : (f : Laurent3[l].Over[D].Lau) -> LaurentList[l].Over[D].Fin f -> Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].mulP D0 f) Laurent3[l].Over[D].zeroL -> Laurent3[l].Over[D].EqL f Laurent3[l].Over[D].zeroL)
  (s1 : (al be : Laurent3[l].Over[D].Lau) ->
        CechModules[l].Over[D,setD].SL (add (negsuc zero) (deg (neg3 muP))) al ->
        CechModules[l].Over[D,setD].SL (add (negsuc zero) (deg (neg3 muQ))) be ->
        Laurent3[l].Over[D].EqL (Laurent3[l].Over[D].addL (Laurent3[l].Over[D].mulP P' al) (Laurent3[l].Over[D].mulP Q' be)) Laurent3[l].Over[D].zeroL ->
        (w : Laurent3[l].Over[D].Lau) * (CechModules[l].Over[D,setD].SL kW w *
          (Laurent3[l].Over[D].EqL al (Laurent3[l].Over[D].negL (Laurent3[l].Over[D].mulP Q' w)) * Laurent3[l].Over[D].EqL be (Laurent3[l].Over[D].mulP P' w))))
  -- A is CFN (Theorem 14)
  (K0 : U l) (cfn : CFN[l].CFN[K0,D]) {
  module R = ACLRelations[l].Over[D,setD,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,
    dg,hdg,dn,en,hkP,hkQ,kW,dW,hWn,D0,P',Q',dP',dQ',pP',pQ',hW1,hW2,fP,fQ,s0,s1] ;
  module F1 = R.F1 ; module CO = R.CO ; module CMd = R.CMd ; module COp = R.COp ;
  module M0 = R.M0 ; module Fr = R.QV ;
  module L0 = IP.ModL[D,M0.mod] ; module LT = R.LT ;
  module PA = IP.Over[D,IP.regular D,a,b] ; module PV = IP.Over[D,Fr.mod,a,b] ;
  module P0 = IP.Over[D,M0.mod,a,b] ; module MP0 = IP.Mult[D,M0.mod,a,b] ;
  module FC = FiniteCorrection[l].Over[D,M0.mod,CMd.tmod,F1.d0K,a,b] ;
  module TG = Grp[D,CMd.tmod] ;
  module FL = FamList[D,Fr.mod] ; module LV = FL.ML ;
  module PS = PowSpan[l].Over[D,Fr.mod,a,b] ;

  -- the conclusion: h with d0 h in N^1 and h - z* in I^m K^0(-1)
  LiftAt (m : Ring[l].Nat) : U l = (h : M0.E) * (F1.N1.N (F1.d0K.f h) * P0.Pow m (L0.msub h F1.zsS)) ;

  ------------------------------------------------------------------------
  -- rho_(k+1) is in I^k A^r

  -- the coefficients at the exponents ts, a linear map
  coord : IP.Lin[D,F1.MLq.S.mod,Fr.mod] =
    IP.mkLin D F1.MLq.S.mod Fr.mod (\ q k -> (COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f q)
      (\ q q' -> Fr.ext (\ k -> (COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f (F1.MLq.S.mod.madd q q'))
                        (\ k -> D.add ((COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f q) ((COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f q'))
                        (\ k -> (COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f-add q q'))
      (\ c q -> Fr.ext (\ k -> (COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f (F1.MLq.S.mod.sm c q))
                       (\ k -> D.mul c ((COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f q))
                       (\ k -> (COp.evalS F1.kq (CMn.expo (F1.nth F1.ts k))).f-sm c q)) ;
  -- by definition of rhoF
  rho-is (k : Ring[l].Nat) : Id Fr.Vec (coord.f (F1.qS (suc k))) (F1.rhoF (suc k)) = refl (F1.rhoF (suc k)) ;
  rho-pow (k : Ring[l].Nat) : PV.Pow k (F1.rhoF (suc k)) =
    PV.pow-tr k (coord.f (F1.qS (suc k))) (F1.rhoF (suc k)) (rho-is k)
      (IP.MapPow[D,F1.MLq.S.mod,Fr.mod,coord,a,b].pow-map k (F1.qS (suc k)) (F1.qS-pow k)) ;

  ------------------------------------------------------------------------
  -- Lemma (rho-N)

  module RhoN (n : Ring[l].Nat) {
    rho : Fr.Vec = F1.rhoF n ;
    cn : M0.E = F1.vF n ;
    -- beta_n = d0 z* - (G rho_n + d0 c_n)
    beta : CO.Tri = LT.msub (F1.d0K.f F1.zsS) (CMd.tmod.madd (F1.G.f rho) (F1.d0K.f cn)) ;
    v : M0.E = L0.msub F1.zsS cn ;
    eq : Id CO.Tri (CMd.tmod.mneg beta) (R.dlt rho v) =
      sym (trans (ap (LT.msub (F1.G.f rho)) (FC.d-sub F1.zsS cn)) (TG.neg-beta (F1.d0K.f F1.zsS) (F1.G.f rho) (F1.d0K.f cn))) ;
    nw : R.NW rho = (v, F1.NL1.n-tr (CMd.tmod.mneg beta) (R.dlt rho v) eq (F1.N1.n-neg beta (F1.betaF n))) ;
  } ;

  ------------------------------------------------------------------------
  -- Lemma (corr)

  Corr (m : Ring[l].Nat) (y : Fr.Vec) : U l = (w : M0.E) * (P0.Pow m w * F1.N1.N (R.dlt y w)) ;
  -- lambda x is in I^m K^0 when lambda is in I^m
  smul-pow (m : Ring[l].Nat) (c : D.R) (x : M0.E) (h : PA.Pow m c) : P0.Pow m (M0.mod.sm c x) =
    subst (\ j -> P0.Pow j (M0.mod.sm c x)) (Ring[l].plus-zero m) (MP0.pow-mul m zero c x h tt) ;
  corr-nil (m : Ring[l].Nat) (y : Fr.Vec) (h : PS.InP m nil y) : Corr m y =
    (M0.mod.mz, (P0.pow-zero m,
      F1.NL1.n-tr CMd.tmod.mz (R.dlt y M0.mod.mz) (trans R.dlt-zero (ap (\ x -> R.dlt x M0.mod.mz) (sym h))) F1.N1.n-zero)) ;
  module Step (m : Ring[l].Nat) (t : Fr.Vec) (bt : M0.E) (gt : F1.N1.N (R.dlt t bt)) (s : List Fr.Vec) (y : Fr.Vec)
    (h : PS.InP m (cons t s) y) (rest : Corr m (LV.msub y (Fr.mod.sm (PS.coef-of m t s y h) t))) {
    c : D.R = PS.coef-of m t s y h ;
    y' : Fr.Vec = LV.msub y (Fr.mod.sm c t) ;
    w : M0.E = M0.mod.madd (M0.mod.sm c bt) rest.1 ;
    pw : P0.Pow m w = P0.pow-add m (M0.mod.sm c bt) rest.1 (smul-pow m c bt (PS.pow-of m t s y h)) rest.2.1 ;
    -- dlt y w = c dlt t bt + dlt y' w'
    eq : Id CO.Tri (CMd.tmod.madd (CMd.tmod.sm c (R.dlt t bt)) (R.dlt y' rest.1)) (R.dlt y w) =
      trans (ap (\ z -> CMd.tmod.madd z (R.dlt y' rest.1)) (R.dlt-sm c t bt))
        (trans (R.dlt-add (Fr.mod.sm c t) y' (M0.mod.sm c bt) rest.1)
               (ap (\ x -> R.dlt x w) (FL.LS.join-sub y t c))) ;
    nw : F1.N1.N (R.dlt y w) =
      F1.NL1.n-tr (CMd.tmod.madd (CMd.tmod.sm c (R.dlt t bt)) (R.dlt y' rest.1)) (R.dlt y w) eq
        (F1.N1.n-add (CMd.tmod.sm c (R.dlt t bt)) (R.dlt y' rest.1) (F1.N1.n-sm c (R.dlt t bt) gt) rest.2.2) ;
    res : Corr m y = (w, (pw, nw)) ;
  } ;
  corr (m : Ring[l].Nat) : (p : Ring[l].Nat) (us : Ps.Fin p -> Fr.Vec) (bs : Ps.Fin p -> M0.E)
    (gd : (j : Ps.Fin p) -> F1.N1.N (R.dlt (us j) (bs j))) (y : Fr.Vec) -> PS.InP m (FL.toList p us) y -> Corr m y = split {
    zero -> \ us bs gd y h -> corr-nil m y h ;
    suc p | r -> \ us bs gd y h ->
      Step[m,us (inr tt),bs (inr tt),gd (inr tt),FL.toList p (\ i -> us (inl i)),y,h,
           r (\ i -> us (inl i)) (\ i -> bs (inl i)) (\ i -> gd (inl i))
             (LV.msub y (Fr.mod.sm (PS.coef-of m (us (inr tt)) (FL.toList p (\ i -> us (inl i))) y h) (us (inr tt))))
             (PS.rest-of m (us (inr tt)) (FL.toList p (\ i -> us (inl i))) y h)].res } ;

  ------------------------------------------------------------------------
  -- Proposition (correction)

  -- the generators of N given by Cor. N
  module From (cg : R.CorN) {
    p : Ring[l].Nat = cg.1 ;
    us (j : Ps.Fin p) : Fr.Vec = cg.2.1 j ;
    bs (j : Ps.Fin p) : M0.E = cg.2.2.1 j ;
    good (j : Ps.Fin p) : F1.N1.N (R.dlt (us j) (bs j)) = cg.2.2.2.1 j ;
    to-span (rh : Fr.Vec) (h : R.NN rh) : R.MemQ p us rh = (cg.2.2.2.2 rh).1 h ;
    ns : List Fr.Vec = FL.toList p us ;
    -- Theorem 14 for span(u_j)
    module PF = PowSpan[l].Free[K0,D,setD,cfn,R.Qr.k,a,b,ns] ;
    -- N is in the span of the list ns
    mm (rh : Fr.Vec) (h : R.NN rh) : PF.AR.MS.Mm ns rh =
      TC.map (FL.LS.InF p us rh) (FL.SP.In ns rh) (FL.in-of p us rh) (to-span rh h) ;
    module At (m : Ring[l].Nat) (cb : PF.CoefBound) {
      c : Ring[l].Nat = cb.1 ;
      k : Ring[l].Nat = plus m c ;
      module RN = RhoN[suc k] ;
      -- rho_(k+1) = sum_j lambda_j u_j, lambda_j in I^m, merely
      coefs : Tr.Trunc[PS.InP m ns RN.rho].carrier =
        cb.2 m RN.rho (rho-pow k) (mm RN.rho (Tr.Trunc[R.NW RN.rho].inc RN.nw)) ;
      -- c_n in I^m: I^(k+1) is in I^(c+m) and in I^m
      cn-pow : P0.Pow m RN.cn =
        P0.pow-drop c m RN.cn (subst (\ j -> P0.Pow j RN.cn) (Ring[l].plus-comm m c) (P0.pow-down k RN.cn (F1.c-pow k))) ;
      module Fix (ip : PS.InP m ns RN.rho) {
        cr : Corr m RN.rho = corr m p us bs good RN.rho ip ;
        w : M0.E = M0.mod.madd RN.cn cr.1 ;
        h : M0.E = L0.msub F1.zsS w ;
        -- d0 h = beta_n + dlt rho_n w'
        dh : Id CO.Tri (CMd.tmod.madd RN.beta (R.dlt RN.rho cr.1)) (F1.d0K.f h) =
          trans (TG.cor-sum (F1.d0K.f F1.zsS) (F1.G.f RN.rho) (F1.d0K.f RN.cn) (F1.d0K.f cr.1))
            (sym (trans (FC.d-sub F1.zsS w) (ap (LT.msub (F1.d0K.f F1.zsS)) (F1.d0K.f-add RN.cn cr.1)))) ;
        closed : F1.N1.N (F1.d0K.f h) =
          F1.NL1.n-tr (CMd.tmod.madd RN.beta (R.dlt RN.rho cr.1)) (F1.d0K.f h) dh
            (F1.N1.n-add RN.beta (R.dlt RN.rho cr.1) (F1.betaF (suc k)) cr.2.2) ;
        -- h - z* = (z* - z*) - w
        congruent : P0.Pow m (L0.msub h F1.zsS) =
          P0.pow-tr m (L0.msub (L0.msub F1.zsS F1.zsS) w) (L0.msub h F1.zsS) (sym (L0.sub-comm F1.zsS w F1.zsS))
            (P0.pow-sub m (L0.msub F1.zsS F1.zsS) w
              (P0.pow-tr m M0.mod.mz (L0.msub F1.zsS F1.zsS) (sym (L0.sub-self F1.zsS)) (P0.pow-zero m))
              (P0.pow-add m RN.cn cr.1 cn-pow cr.2.1)) ;
        res : LiftAt m = (h, (closed, congruent)) ;
      } ;
      lift : Tr.Trunc[LiftAt m].carrier = TC.map (PS.InP m ns RN.rho) (LiftAt m) (\ ip -> Fix[ip].res) coefs ;
    } ;
    lift-at (m : Ring[l].Nat) : Tr.Trunc[LiftAt m].carrier =
      TC.bind PF.CoefBound (LiftAt m) (\ cb -> At[m,cb].lift) PF.coefficients ;
  } ;
  correction (m : Ring[l].Nat) : Tr.Trunc[LiftAt m].carrier =
    TC.bind R.CorN (LiftAt m) (\ cg -> From[cg].lift-at m) (R.corN cfn.coh) ;
  lift : Tr.Trunc[LiftAt (suc zero)].carrier = correction (suc zero) ;
  -- the datum ReesLiftingCong.Over.Lift of (F1), whatever presentation of D is passed there
  lift-rc (PA : Span[l].Pres[D]) (nA : Span[l].Over[D,PA].Noeth)
    (onto : (c : D.R) -> Tr.Trunc[(k : PA.K) * Id D.R (PA.phi k) c].carrier) :
    RC.Over[D,setD,PA,nA,onto,a,b,M0.mod,CMd.tmod,F1.d0K,F1.N1,F1.zsS,F1.r,F1.eF,F1.G,F1.rhoF,F1.degF,F1.vF,F1.hvF,F1.betaF].TL.carrier = lift ;
} ;
