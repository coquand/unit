-- QuotCFNInst.seg: the library quotient A/(c_1..c_m) (QuotientRing of
-- RegularIdeal.Generated) is CFN when A is (artin-rees.tex, Prop. 12).
--
-- The projection is a surjective ring map (Quotient induction) whose
-- kernel is the ideal generated by c (QuotientRing.kernel); its
-- coordinates (FiniteIdeal: sum c_i v_i) are a combination in the sense of
-- Comb (sum v_i c_i).  Then QuotCFN applies.
level l ; open Ring[l] ; open Presentations[l] ;
module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

module Over (A : CRing) (m : Nat) (c : Fin m -> A.R) {
  module G = RegularIdeal[l].Generated[A,m,c] ;
  module QR = QuotientRing[l].Over[A,G.ideal,G.in-prop] ;
  B : CRing = QR.ring ;
  module FI = FiniteIdeal[l].Sums[A] ; module RSA = Comb[l].Sums[A,IP.regular A] ;
  module CA = Coherent[l].Over[A,IP.regular A] ;

  sum-eq : (n : Nat) (g : Fin n -> A.R) -> Id A.R (FI.sum n g) (RSA.sum n g) = split {
    zero -> \ g -> refl A.z ;
    suc n | r -> \ g -> ap (A.add (g (inr tt))) (r (\ i -> g (inl i))) } ;
  coords (x : A.R) (h : FI.Coordinates m c x) : CA.InFM m c x =
    (h.1, trans (RSA.sum-cong m (\ k -> A.mul (h.1 k) (c k)) (\ k -> A.mul (c k) (h.1 k)) (\ k -> A.mulC (h.1 k) (c k)))
            (trans (sym (sum-eq m (\ k -> A.mul (c k) (h.1 k)))) h.2)) ;
  ker (x : A.R) (h : Id B.R (QR.include x) B.z) : CA.Mem m c x =
    Tr.Trunc[FI.Coordinates m c x].induction @l (\ t -> CA.Mem m c x) (\ t -> Tr.Trunc[CA.InFM m c x].proposition)
      (\ v -> Tr.Trunc[CA.InFM m c x].inc (coords x v)) (QR.kernel x h) ;
  surj (y : B.R) : Tr.Trunc[(x : A.R) * Id B.R (QR.include x) y].carrier =
    QR.Q.induction @l (\ t -> Tr.Trunc[(x : A.R) * Id B.R (QR.include x) t].carrier)
      (\ t -> Tr.Trunc[(x : A.R) * Id B.R (QR.include x) t].proposition)
      (\ x -> Tr.Trunc[(x' : A.R) * Id B.R (QR.include x') (QR.include x)].inc (x, refl (QR.include x))) y ;
  kc (j : Fin m) : Id B.R (QR.include (c j)) B.z = QR.to-zero (c j) (G.generator j) ;

  module Q = QuotCFN[l].Over[A, B, QR.include, refl QR.oneQ, \ a b -> sym (QR.Add.beta a b),
    \ a b -> sym (QR.Multiply.beta a b), surj, m, c, kc, ker] ;
  quotient (K0 : U l) (cA : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,B] = Q.cfn K0 cA ;
} ;
