-- Kill.seg: the uniform Kill and StableAnnihilator.Stable (artin-rees.tex,
-- Cor. kill), from Artin-Rees for (f).
--
-- Informal proof.  By (C) for the one-element family (f), Ann(f) is
-- generated by the g_j = gs_j (last coordinates of the syzygies):
-- g_j f = 0 (ann-gen), and x f = 0 gives x in (g) (in-ann); since E is a
-- set, y in (g) gives y f = 0 (ann-of-in).  Artin-Rees for (f) and
-- J = Ann(f), with bound c, at n = 1: if x is in f^(1+c) E and in
-- Ann(f), then x = f y with y in Ann(f), so x = 0 (kill).  If
-- f^(c+2) v = 0, then x = f^(c+1) v is in Ann(f) and in f^(1+c) E, so
-- f^(c+1) v = 0: Stable f (c+1) (stable).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A]) (f : A.R) {
  module CA = Coherent[l].Over[A,IP.regular A] ; module RS = Comb[l].Sums[A,IP.regular A] ;
  module SA = StableAnnihilator[l].Over[A] ; module L = RL[A] ;
  -- the one-element family (f)
  ff : Fin (suc zero) -> A.R = \ i -> f ;

  module Ann (p : Nat) (gs : Fin p -> CA.Vec (suc zero)) (sa : CA.SyzAll (suc zero) ff p gs)
    (un : CA.Univ (suc zero) ff p gs) {
    module FV = Comb[l].Free[A,suc zero] ;
    g (j : Fin p) : A.R = gs j (inr tt) ;
    ann-gen (j : Fin p) : Id A.R (A.mul (g j) f) A.z = trans (sym (A.addZ (A.mul (g j) f))) (sa j) ;
    in-ann (x : A.R) (h : Id A.R (A.mul x f) A.z) : CA.Mem p g x =
      Tr.Trunc[CA.InFV (suc zero) p gs (\ i -> x)].induction @l (\ w -> CA.Mem p g x) (\ w -> Tr.Trunc[CA.InFM p g x].proposition)
        (\ dd -> Tr.Trunc[CA.InFM p g x].inc (dd.1, trans (sym (FV.comb-at p dd.1 gs (inr tt))) (ap (\ v -> v (inr tt)) dd.2)))
        (un (\ i -> x) (trans (A.addZ (A.mul x f)) h)) ;
    -- (sum_j d_j g_j) f = sum_j d_j (g_j f) = 0
    ann-comb (d : Fin p -> A.R) : Id A.R (A.mul (RS.comb p d g) f) A.z =
      calc A.R { A.mul (RS.comb p d g) f
                   =< sym (Comb[l].Bilinear[A,IP.regular A].comb-scaled p d g f) > RS.comb p d (\ j -> A.mul (g j) f)
                   =< RS.comb-vanish p d (\ j -> A.mul (g j) f) ann-gen > A.z } ;
    ann-of-in (y : A.R) (h : CA.Mem p g y) : Id A.R (A.mul y f) A.z =
      Tr.Trunc[CA.InFM p g y].induction @l (\ w -> Id A.R (A.mul y f) A.z) (\ w -> setA (A.mul y f) A.z)
        (\ dd -> trans (ap (\ t -> A.mul t f) (sym dd.2)) (ann-comb dd.1)) h ;

    module AR = ArtinReesPrincipal[l].Over[K0,A,cfn,p,g,f] ;
    -- x in f^(1+c) E and in Ann(f) is 0
    kill (b : AR.Bound) (x : A.R) (hx : AR.InP (suc b.c) x) (hm : AR.LS.Mj x) : Id A.R x A.z =
      Tr.Trunc[AR.Decomp[suc zero,b.c,x]].induction @l (\ w -> Id A.R x A.z) (\ w -> setA x A.z)
        (\ dc -> calc A.R { x =< dc.y-eq > A.mul (A.mul f A.o) dc.y
                              =< ap (\ t -> A.mul t dc.y) (A.mulO f) > A.mul f dc.y
                              =< A.mulC f dc.y > A.mul dc.y f
                              =< ann-of-in dc.y dc.y-in > A.z })
        (b.decomp (suc zero) x hx hm) ;

    -- the power of StableAnnihilator is that of AffinePowers
    spow : (n : Nat) -> Id A.R (SA.power f n) (AR.LS.pw n) = split {
      zero -> refl A.o ;
      suc n | r -> ap (A.mul f) r } ;
    stable-of (b : AR.Bound) : SA.Stable f (suc b.c) = \ v h ->
      let { x : A.R = A.mul (AR.LS.pw (suc b.c)) v ;
            -- x f = f^(c+2) v = 0
            xf : Id A.R (A.mul x f) A.z =
              calc A.R { A.mul x f =< A.mulC x f > A.mul f x
                           =< A.mulA f (AR.LS.pw (suc b.c)) v > A.mul (AR.LS.pw (suc (suc b.c))) v
                           =< ap (\ t -> A.mul t v) (sym (spow (suc (suc b.c)))) > A.mul (SA.power f (suc (suc b.c))) v
                           =< h > A.z } } in
      trans (ap (\ t -> A.mul t v) (spow (suc b.c)))
        (kill b x (Tr.Trunc[(m : A.R) * Id A.R x (A.mul (AR.LS.pw (suc b.c)) m)].inc (v, refl x)) (in-ann x xf)) ;
    stable : Tr.Trunc[(N : Nat) * SA.Stable f N].carrier =
      Tr.Trunc[AR.Bound].induction @l (\ w -> Tr.Trunc[(N : Nat) * SA.Stable f N].carrier)
        (\ w -> Tr.Trunc[(N : Nat) * SA.Stable f N].proposition)
        (\ b -> Tr.Trunc[(N : Nat) * SA.Stable f N].inc (suc b.c, stable-of b)) AR.artin-rees ;
  } ;

  -- Cor. kill: merely N with f^(N+1) v = 0 -> f^N v = 0
  stable : Tr.Trunc[(N : Nat) * SA.Stable f N].carrier =
    Tr.Trunc[CA.CohW (suc zero) ff].induction @l (\ w -> Tr.Trunc[(N : Nat) * SA.Stable f N].carrier)
      (\ w -> Tr.Trunc[(N : Nat) * SA.Stable f N].proposition)
      (\ q -> Ann[q.1, q.2.1, q.2.2.1, q.2.2.2].stable) (cfn.coh (suc zero) ff) ;
} ;
