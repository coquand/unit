-- FinCat.seg: finite choice, and concatenation of finite families.
--
-- fchoice: a finite family of mere existences gives the mere existence of
--   a family (induction on n).
-- cat F G: the family F, then G, indexed by Fin (a + b) through
--   Blocks.xi; cat-l, cat-r: its values at ix (inl i), ix (inr j);
--   cat-all: a property of all F i and all G j holds on cat F G.
-- sum-split: a sum over Fin (a + b) is the sum over the two parts;
--   comb-cat: comb (cat c c') (cat F G) = comb c F + comb c' G.
-- memv-cat, memv-add, memv-zero: generators of A^n given as a
--   concatenation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

fchoice : (n : Nat) (Q : Fin n -> U l) -> ((i : Fin n) -> Tr.Trunc[Q i].carrier) ->
  Tr.Trunc[(i : Fin n) -> Q i].carrier = split {
  zero -> \ Q h -> Tr.Trunc[(i : Fin zero) -> Q i].inc (\ i -> absurd (Q i) i) ;
  suc n | r -> \ Q h ->
    Tr.Trunc[(i : Fin n) -> Q (inl i)].induction @l (\ t -> Tr.Trunc[(i : Fin (suc n)) -> Q i].carrier)
      (\ t -> Tr.Trunc[(i : Fin (suc n)) -> Q i].proposition)
      (\ g -> Tr.Trunc[Q (inr tt)].induction @l (\ t -> Tr.Trunc[(i : Fin (suc n)) -> Q i].carrier)
         (\ t -> Tr.Trunc[(i : Fin (suc n)) -> Q i].proposition)
         (\ q -> Tr.Trunc[(i : Fin (suc n)) -> Q i].inc (Saturation[l].allS n Q g q)) (h (inr tt)))
      (r (\ i -> Q (inl i)) (\ i -> h (inl i))) } ;

catP (X : U l) (a b : Nat) (F : Fin a -> X) (G : Fin b -> X) : Plus (Fin a) (Fin b) -> X = split {
  inl i -> F i ;
  inr j -> G j } ;
cat (X : U l) (a b : Nat) (F : Fin a -> X) (G : Fin b -> X) (m : Fin (plus a b)) : X =
  catP X a b F G (Blocks[l].xi a b m) ;
cat-l (X : U l) (a b : Nat) (F : Fin a -> X) (G : Fin b -> X) (i : Fin a) :
  Id X (cat X a b F G (Blocks[l].ix a b (inl i))) (F i) = ap (catP X a b F G) (Blocks[l].xi-ix a b (inl i)) ;
cat-r (X : U l) (a b : Nat) (F : Fin a -> X) (G : Fin b -> X) (j : Fin b) :
  Id X (cat X a b F G (Blocks[l].ix a b (inr j))) (G j) = ap (catP X a b F G) (Blocks[l].xi-ix a b (inr j)) ;

catP-all (X : U l) (a b : Nat) (F : Fin a -> X) (G : Fin b -> X) (Q : X -> U l)
  (hF : (i : Fin a) -> Q (F i)) (hG : (j : Fin b) -> Q (G j)) : (x : Plus (Fin a) (Fin b)) -> Q (catP X a b F G x) = split {
  inl i -> hF i ;
  inr j -> hG j } ;
cat-all (X : U l) (a b : Nat) (F : Fin a -> X) (G : Fin b -> X) (Q : X -> U l)
  (hF : (i : Fin a) -> Q (F i)) (hG : (j : Fin b) -> Q (G j)) (m : Fin (plus a b)) : Q (cat X a b F G m) =
  catP-all X a b F G Q hF hG (Blocks[l].xi a b m) ;

module CatSums (A : CRing) (Md : IP.Mod[A]) {
  open Md ; module S = Comb[l].Sums[A,Md] ; module ML = IP.ModL[A,Md] ;
  sum-split : (a b : Nat) (h : Fin (plus a b) -> M) ->
    Id M (S.sum (plus a b) h)
      (madd (S.sum a (\ i -> h (Blocks[l].ix a b (inl i)))) (S.sum b (\ j -> h (Blocks[l].ix a b (inr j))))) = split {
    zero -> \ b h -> sym (ML.G.zl (S.sum b h)) ;
    suc a | r -> \ b h -> trans (ap (madd (h (inr tt))) (r b (\ m -> h (inl m))))
      (maddA (h (inr tt)) (S.sum a (\ i -> h (inl (Blocks[l].ix a b (inl i))))) (S.sum b (\ j -> h (inl (Blocks[l].ix a b (inr j)))))) } ;
  comb-cat (a b : Nat) (c : Fin a -> A.R) (c' : Fin b -> A.R) (F : Fin a -> M) (G : Fin b -> M) :
    Id M (S.comb (plus a b) (cat A.R a b c c') (cat M a b F G)) (madd (S.comb a c F) (S.comb b c' G)) =
    trans (sum-split a b (\ m -> sm (cat A.R a b c c' m) (cat M a b F G m)))
      (ML.G.cong-add
        (S.sum-cong a (\ i -> sm (cat A.R a b c c' (Blocks[l].ix a b (inl i))) (cat M a b F G (Blocks[l].ix a b (inl i))))
           (\ i -> sm (c i) (F i))
           (\ i -> trans (ap (\ t -> sm t (cat M a b F G (Blocks[l].ix a b (inl i)))) (cat-l A.R a b c c' i))
                     (ap (sm (c i)) (cat-l M a b F G i))))
        (S.sum-cong b (\ j -> sm (cat A.R a b c c' (Blocks[l].ix a b (inr j))) (cat M a b F G (Blocks[l].ix a b (inr j))))
           (\ j -> sm (c' j) (G j))
           (\ j -> trans (ap (\ t -> sm t (cat M a b F G (Blocks[l].ix a b (inr j)))) (cat-r A.R a b c c' j))
                     (ap (sm (c' j)) (cat-r M a b F G j))))) ;
} ;

-- membership in the span of finitely many vectors of A^n
module Vecs (A : CRing) (n : Nat) {
  module FV = Comb[l].Free[A,n] ;
  Vec : U l = FV.Vec ;
  V : IP.Mod[A] = FV.mod ;
  module CO = Coherent[l].Over[A,IP.regular A] ;
  module CV = CatSums[A,V] ;
  MemV (p : Nat) (gs : Fin p -> Vec) (c : Vec) : U l = CO.MemV n p gs c ;
  memv-prop (p : Nat) (gs : Fin p -> Vec) (c : Vec) : Pr.isProp (MemV p gs c) = Tr.Trunc[CO.InFV n p gs c].proposition ;
  memv-cat (a b : Nat) (F : Fin a -> Vec) (G : Fin b -> Vec) (x y : Vec) (hx : MemV a F x) (hy : MemV b G y) :
    MemV (plus a b) (cat Vec a b F G) (V.madd x y) =
    Tr.Trunc[CO.InFV n a F x].induction @l (\ t -> MemV (plus a b) (cat Vec a b F G) (V.madd x y))
      (\ t -> memv-prop (plus a b) (cat Vec a b F G) (V.madd x y))
      (\ cx -> Tr.Trunc[CO.InFV n b G y].induction @l (\ t -> MemV (plus a b) (cat Vec a b F G) (V.madd x y))
         (\ t -> memv-prop (plus a b) (cat Vec a b F G) (V.madd x y))
         (\ cy -> Tr.Trunc[CO.InFV n (plus a b) (cat Vec a b F G) (V.madd x y)].inc
            (cat A.R a b cx.1 cy.1,
             trans (CV.comb-cat a b cx.1 cy.1 F G) (IP.ModL[A,V].G.cong-add cx.2 cy.2))) hy) hx ;
  memv-zero (p : Nat) (gs : Fin p -> Vec) : MemV p gs V.mz =
    Tr.Trunc[CO.InFV n p gs V.mz].inc ((\ k -> A.z), Comb[l].Sums[A,V].comb-zero p gs) ;
  memv-add (p : Nat) (gs : Fin p -> Vec) (x y : Vec) (hx : MemV p gs x) (hy : MemV p gs y) : MemV p gs (V.madd x y) =
    Tr.Trunc[CO.InFV n p gs x].induction @l (\ t -> MemV p gs (V.madd x y)) (\ t -> memv-prop p gs (V.madd x y))
      (\ cx -> Tr.Trunc[CO.InFV n p gs y].induction @l (\ t -> MemV p gs (V.madd x y)) (\ t -> memv-prop p gs (V.madd x y))
         (\ cy -> Tr.Trunc[CO.InFV n p gs (V.madd x y)].inc ((\ k -> A.add (cx.1 k) (cy.1 k)),
            trans (Comb[l].Sums[A,V].comb-add p cx.1 cy.1 gs) (IP.ModL[A,V].G.cong-add cx.2 cy.2))) hy) hx ;
  memv-comb (p : Nat) (gs : Fin p -> Vec) (c : Fin p -> A.R) : MemV p gs (Comb[l].Sums[A,V].comb p c gs) =
    Tr.Trunc[CO.InFV n p gs (Comb[l].Sums[A,V].comb p c gs)].inc (c, refl (Comb[l].Sums[A,V].comb p c gs)) ;
  memv-cong (p : Nat) (gs : Fin p -> Vec) (x y : Vec) (e : Id Vec x y) (h : MemV p gs x) : MemV p gs y = subst (MemV p gs) e h ;
} ;
