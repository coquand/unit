-- ACLCorrectionGeneral.seg: the parameters of ACLRelations (and so of
-- ACLCorrection) from the datum D0, P', Q', (S0), (S1) of the gcd library
-- (HomLambda.Data), for P, Q given by their charts (FixedCochain),
-- homogeneous of degrees d0 + 1, e0 + 1, over a gcd domain A which is CFN.
-- As acl-zmt/ACLGeneral (which instantiates CechZMTD0 in degree 0), here in
-- degree -1:
--   kP = -1 - deg muP = -(d0 + 2),  kQ = -(e0 + 2),  so dn = d0 + 1, en = e0 + 1;
--   kW = -(e' + d0 + 2):  kW + e' = kP,  and  kW + d' = kQ  since
--   d0 + 1 = r + d', e0 + 1 = r + e'  (HomDivisor: D0, P', Q' homogeneous of
--   degrees r, d', e').
-- (S1) of HomLambda is stated at the degrees kW + e', kW + d'; it is
-- transported to kP, kQ along these identities.  Then Cor. N and the
-- correction hold with no other hypothesis than A CFN (coherence for Cor. N,
-- Theorem 14 for the correction).
-- addN-neg0, addP-negsuc and arith are those of acl-zmt/ACLGeneral (not
-- linked here: it would bring CechZMTD0 and the rest of the ACL assembly).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module NA = NatArith[l] ;

-- -1 - (n + 1) = -(n + 2)
addN-neg0 : (n : Nat) -> Id Int (addN (negsuc zero) n) (negsuc (suc n)) = split {
  zero -> refl (negsuc (suc zero)) ;
  suc n | r -> ap predZ r } ;
-- -(e + n + 1) + e = -(n + 1)
addP-negsuc : (e n : Nat) -> Id Int (addP (negsuc (NA.plus e n)) e) (negsuc n) = split {
  zero -> \ n -> refl (negsuc n) ;
  suc e | r -> \ n -> trans (ap (\ k -> sucZ (addP (negsuc k) e)) (sym (NA.plus-suc e n))) (ap sucZ (r (suc n))) } ;
-- (r + e') + d' = suc (e' + d0)  when  suc d0 = r + d'
arith (r d' e' d0 : Nat) (hd : Id Nat (suc d0) (NA.plus r d')) :
  Id Nat (NA.plus (NA.plus r e') d') (suc (NA.plus e' d0)) =
  trans (ap (\ k -> NA.plus k d') (NA.plus-comm r e'))
   (trans (NA.plus-assoc e' r d') (trans (ap (NA.plus e') (sym hd)) (NA.plus-suc e' d0))) ;

module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) (a b : A.R)
  -- the two charts
  (muP : E3) (FP GP : Laurent3[l].Over[A].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[A].NonNegY FP) (yG : Laurent3[l].Over[A].NonNegY GP)
  (dF : Laurent3[l].Over[A].HomPI (deg muP) FP) (dG : Laurent3[l].Over[A].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[A].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[A].NonNegX FQ) (xG : Laurent3[l].Over[A].NonNegX GQ)
  (dF' : Laurent3[l].Over[A].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[A].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[A,G.set].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[A,G.set].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (Laurent3[l].Over[A].monoP muP))
  (pmuQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (Laurent3[l].Over[A].monoP muQ))
  (pP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- P, Q homogeneous of degrees d0 + 1, e0 + 1
  (d0 e0 : Nat)
  (hPd : Laurent3[l].Over[A].HomPI (pos (suc d0)) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (hQe : Laurent3[l].Over[A].HomPI (pos (suc e0)) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- exponents >= 0, and a non-zero coefficient of each
  (hP0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) zero)
  (hQ0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) zero)
  (m0 : E3) (nP0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) m0) A.z))
  (n0 : E3) (nQ0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) n0) A.z))
  -- A is CFN
  (K0 : U l) (cfn : CFN[l].CFN[K0,A]) {
  module FCo = FixedCochain[l].Over[A,a,b] ;
  module CMd = CechModules[l].Over[A,G.set] ;
  PlP : Laurent3[l].Over[A].LPoly = FCo.XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl ;
  PlQ : Laurent3[l].Over[A].LPoly = FCo.YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl ;
  -- deg muP = d0 + 1, deg muQ = e0 + 1 (the first terms of the lists of P and Q)
  dP : Id Int (deg muP) (pos (suc d0)) = hPd.1 ;
  dQ : Id Int (deg muQ) (pos (suc e0)) = hQe.1 ;
  dg : Nat = NA.plus (suc e0) (suc d0) ;
  hdg : Id Int (add (deg muP) (deg muQ)) (pos dg) =
    trans (Presentations[l].cong2 Int add _ _ _ _ dP dQ) (Degrees[l].add-pos (suc d0) (suc e0)) ;
  -- -1 - deg mu = -(n + 2) when deg mu = n + 1
  k-eq (mu : E3) (n : Nat) (h : Id Int (deg mu) (pos (suc n))) :
    Id Int (add (negsuc zero) (deg (neg3 mu))) (negsuc (suc n)) =
    trans (ap (add (negsuc zero)) (trans (FCo.deg-neg mu) (ap neg h))) (addN-neg0 n) ;
  hkP : Id Int (add (negsuc zero) (deg (neg3 muP))) (negsuc (suc d0)) = k-eq muP d0 dP ;
  hkQ : Id Int (add (negsuc zero) (deg (neg3 muQ))) (negsuc (suc e0)) = k-eq muQ e0 dQ ;
  -- the datum of the gcd library
  module HL = HomLambda[l].Over[A,G] ;
  module D = HL.Data[PlP,PlQ,hP0,hQ0,m0,nP0,n0,nQ0,suc d0,suc e0,hPd,hQe] ;
  dW : Nat = NA.plus D.e' (suc d0) ;
  kW : Int = negsuc dW ;
  -- kW + e' = kP
  -- by definition of add at pos
  add-pos-is (k : Int) (n : Nat) : Id Int (add k (pos n)) (addP k n) = refl (add k (pos n)) ;
  hW1 : Id Int (add kW (pos D.e')) (add (negsuc zero) (deg (neg3 muP))) =
    trans (add-pos-is kW D.e') (trans (addP-negsuc D.e' (suc d0)) (sym hkP)) ;
  -- (e0 + 2) + (kW + d') = 0: e0 + 2 + d' = (r + e') + d' + 1 = e' + d0 + 2
  sum-a : Id Int (add (pos (suc (suc e0))) (add kW (pos D.d'))) (add kW (add (pos D.d') (pos (suc (suc e0))))) =
    trans (comm (pos (suc (suc e0))) (add kW (pos D.d'))) (assoc kW (pos D.d') (pos (suc (suc e0)))) ;
  -- by definition of plus at suc
  plus-suc-is (k n : Nat) : Id Nat (NA.plus (suc k) n) (suc (NA.plus k n)) = refl (NA.plus (suc k) n) ;
  sum-b : Id Int (add (pos D.d') (pos (suc (suc e0)))) (pos (suc (NA.plus (NA.plus D.r D.e') D.d'))) =
    calc Int {
      add (pos D.d') (pos (suc (suc e0)))
        =< Degrees[l].add-pos D.d' (suc (suc e0)) > pos (NA.plus (suc (suc e0)) D.d')
        =< ap (\ k -> pos (NA.plus (suc k) D.d')) (sym D.sum-Q) > pos (NA.plus (suc (NA.plus D.r D.e')) D.d')
        =< ap (\ k -> pos k) (plus-suc-is (NA.plus D.r D.e') D.d') > pos (suc (NA.plus (NA.plus D.r D.e') D.d')) } ;
  sum-c : Id Nat (NA.plus (NA.plus D.r D.e') D.d') dW =
    trans (arith D.r D.d' D.e' d0 (sym D.sum-P)) (sym (NA.plus-suc D.e' d0)) ;
  -- kW + (dW + 1) = 0
  sum-d : Id Int (add kW (pos (suc dW))) zeroZ = invr kW ;
  sum-bc : Id Int (add (pos D.d') (pos (suc (suc e0)))) (pos (suc dW)) = trans sum-b (ap (\ k -> pos (suc k)) sum-c) ;
  sum0 : Id Int (add (pos (suc (suc e0))) (add kW (pos D.d'))) zeroZ = trans sum-a (trans (ap (add kW) sum-bc) sum-d) ;
  -- kW + d' = kQ
  hW2 : Id Int (add kW (pos D.d')) (add (negsuc zero) (deg (neg3 muQ))) =
    trans (ZG.neg-uniq (pos (suc (suc e0))) (add kW (pos D.d')) sum0) (sym hkQ) ;
  -- (S1) at the degrees kP, kQ
  s1 (al be : Laurent3[l].Over[A].Lau) (ha : CMd.SL (add (negsuc zero) (deg (neg3 muP))) al)
     (hb : CMd.SL (add (negsuc zero) (deg (neg3 muQ))) be)
     (h : Laurent3[l].Over[A].EqL (Laurent3[l].Over[A].addL (Laurent3[l].Over[A].mulP D.P'h al) (Laurent3[l].Over[A].mulP D.Q'h be)) Laurent3[l].Over[A].zeroL) :
     (w : Laurent3[l].Over[A].Lau) * (CMd.SL kW w *
       (Laurent3[l].Over[A].EqL al (Laurent3[l].Over[A].negL (Laurent3[l].Over[A].mulP D.Q'h w)) * Laurent3[l].Over[A].EqL be (Laurent3[l].Over[A].mulP D.P'h w))) =
    D.s1 kW al be (subst (\ k -> CMd.SL k al) (sym hW1) ha) (subst (\ k -> CMd.SL k be) (sym hW2) hb) h ;
  -- §8: the relation matrix, Lemma prim, Prop. rel, Cor. N
  module R = ACLRelations[l].Over[A,G.set,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,
    dg,hdg,suc d0,suc e0,hkP,hkQ,kW,dW,refl kW,D.D0h,D.P'h,D.Q'h,pos D.d',pos D.e',D.P'h-poly,D.Q'h-poly,hW1,hW2,D.fP,D.fQ,D.s0,s1] ;
  corN : Tr.Trunc[R.CorN].carrier = R.corN cfn.coh ;
  -- §8, the correction: the datum ReesLiftingCong.Lift, merely
  module C = ACLCorrection[l].Over[A,G.set,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,
    dg,hdg,suc d0,suc e0,hkP,hkQ,kW,dW,refl kW,D.D0h,D.P'h,D.Q'h,pos D.d',pos D.e',D.P'h-poly,D.Q'h-poly,hW1,hW2,D.fP,D.fQ,D.s0,s1,K0,cfn] ;
  lift : Tr.Trunc[C.LiftAt (suc zero)].carrier = C.lift ;
} ;
