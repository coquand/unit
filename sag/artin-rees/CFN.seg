-- CFN.seg: CFN rings (artin-rees.tex, Def. 1).
--
-- (D) and (C) for A as a module over itself (Coherent), and (N): merely a
-- presentation of A by codes El K0 c, noetherian in the sense of
-- Coquand-Persson and surjective under truncation (CodedNoeth.NP).  The
-- base K0 of the codes is a parameter: the integers for rings of finite
-- presentation over Z, the elements of k for a discrete field k.  The three
-- fields are propositions, and CFN K0 A is in U l.
-- fl: the principle of free lists, from (N).
level l ; open Ring[l] ; open Presentations[l] ;
module IP = IdealPowers[l] ; module CN = CodedNoeth[l] ;
record CFN (K0 : U l) (A : CRing) {
  disc : Coherent[l].Over[A,IP.regular A].Disc ;
  coh : Coherent[l].Over[A,IP.regular A].Coh ;
  noeth : Truncation[l].Trunc[CN.NP K0 A].carrier ;
} ;
fl (K0 : U l) (A : CRing) (c : CFN[K0,A]) : Coherent[l].Over[A,IP.regular A].FL = \ Phi pPhi step s f ->
  Truncation[l].Trunc[CN.NP K0 A].induction @l (\ t -> Phi s) (\ t -> pPhi s)
    (\ np -> CN.Over[A, CN.pres A (CN.El K0 np.1) np.2.1].fl np.2.2.2 np.2.2.1 Phi pPhi step s f) c.noeth ;

-- the shape of Noetheriannote.Calculus.Noeth: a predicate in U l
Noeth (K0 : U l) (A : CRing) (setA : Prelude[l].isSet A.R) : U l = CFN[K0,A] ;
