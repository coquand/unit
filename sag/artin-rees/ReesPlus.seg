-- ReesPlus.seg: the Rees module Q+ in the model of DegreeCor, the
-- evaluation E, Lemma good and Lemma tele (artin-rees.tex §5.3).
--
-- Informal proof.  R' = A[U][V] is CFN (Thm. 10 twice).  In R'^r[Y]
-- (sequences of R'^r, DegreeCor with n = 1), Q+ is the R'[Y]-span of the
-- generators, blocks of degree <= 1 in Y:
--   n_i (constant),  (U - aY) e_k,  (V - bY) e_k      (i <= s, k <= r).
-- Evaluation.  eps_n H = theta_n (pi_n H) for H in R'^r: the coefficient
--   of Y^n after U -> aY, V -> bY.  By Lemmas theta and pi: eps_n is
--   A-linear, eps_0 (U H) = 0, eps_(n+1) (U H) = a eps_n H, eps_0 (V H) = 0,
--   eps_(n+1) (V H) = b eps_n H.  For G in R'^r[Y],
--     E_0 G = eps_0 G_0,   E_(t+1) G = eps_(t+1) G_0 + E_t (G . suc),
--   so E_t G = sum_(k <= t) eps_(t-k) G_k.  E is A-linear,
--   E_0 (U G) = 0, E_(t+1) (U G) = a E_t G (induction on t), the same for
--   V and b, E_0 (Y G) = 0, E_(t+1) (Y G) = E_t G.
-- Lemma good.  G is good if E_t G is in N for all t.  Being good is closed
--   under 0, sums, constants of A, U, V (above) and Y, hence (Lemma rind)
--   under R'[Y]; the generators are good: E (n_i) = (n_i, 0, ...),
--   E_0 ((U - aY) e_k) = 0 and E_(t+1) = a eps_t e_k - a eps_t e_k = 0, the
--   same for V.  So every element of Q+ is good (good-nm).  For u in R'^r
--   (degree 0 in Y), E_n u = eps_n u, hence u good gives pi_n u in Q_n
--   (good-Q).
-- Lemma tele.  Write x ~ y for x - y in Q+.  Phi(w) = h w - Y c w is
--   R'-linear in w, and Phi(e_k) is the generator (h - cY) e_k, so
--   h w ~ Y (c w) for every w in R'^r (gen-cg), for (h,c) = (U,a), (V,b).
--   Then U^k x ~ Y^k (a^k x) for x in A^r (upow-cg), by induction, and by
--   induction on n, for every g:
--     iota_n g ~ Y^n theta_n g                                       (tele)
--   since iota_(n+1) g = U^(n+1) g_0 + V iota_n (g . suc) and
--   theta_(n+1) g = a^(n+1) g_0 + b theta_n (g . suc) (Lemma theta (v)):
--   V iota_n (g . suc) ~ V Y^n theta_n (g . suc) ~ Y^(n+1) b theta_n (g . suc).
--   If theta_n g is in N, Y^n theta_n g is an A-combination of the Y^n n_i,
--   in Q+ (nm-N), so iota_n g is in Q+ (tele-in).
-- Only multiplications by U, V, Y and constants are used, and only the easy
-- direction of the division by U - aY, V - bY.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A]) (r : Nat) (a b : A.R)
  (ns : List (Comb[l].Free[A,r].Vec)) {
  module BG = Bigraded[l].Over[A,setA,r] ;
  module RV = ReesVec[l].Over[A,BG.Fr.mod,a,b,ns] ;
  module SQ = SeqPoly[l].Over[A,BG.Fr.mod] ;
  module S2 = SeqPoly[l].Over[BG.P2.S,BG.F2.mod] ;
  module L2 = IP.ModL[BG.P2.S,S2.seq] ;
  module PM = IP.Over[A,BG.Fr.mod,a,b] ;
  module MS = Spans[l].Over[A,BG.Fr.mod] ; module OB = Saturation[l].SpanOps[A,BG.Fr.mod] ;
  module LS = Comb[l].Lists[A,BG.Fr.mod] ;

  ------------------------------------------------------------------------
  -- R' is CFN; the generators; Q+

  module H1 = HilbertCFN[l].Over[K0,A,setA] ;
  module H2 = HilbertCFN[l].Over[K0,BG.P1.S,BG.P1.E.set] ;
  cfn2 : CFN[l].CFN[K0,BG.P2.S] = H2.poly (H1.poly cfn) ;

  -- the block x0 + Y x1
  blk2 (x0 x1 : BG.F2.Vec) : S2.Blk (suc (suc zero)) = snoc (Fin (suc zero)) BG.F2.Vec (\ t -> x1) x0 ;
  -- n_i
  gN (i : Fin (len ns)) : S2.Blk (suc (suc zero)) = blk2 (BG.lift (LS.elem ns i)) BG.F2.mod.mz ;
  -- (h - cY) e_k
  gL (h : BG.P2.K) (c : A.R) (k : Fin r) : S2.Blk (suc (suc zero)) =
    blk2 (BG.F2.mod.sm h (BG.B2.basis r k)) (BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) (BG.B2.basis r k))) ;
  gens : Fin (plus (len ns) (plus r r)) -> S2.Blk (suc (suc zero)) =
    FinCat[l].cat (S2.Blk (suc (suc zero))) (len ns) (plus r r) gN
      (FinCat[l].cat (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b)) ;

  module DG = DegreeCor[l].Free[BG.P2.S, cfn2.disc, cfn2.coh, CFN[l].fl K0 BG.P2.S cfn2, r, suc zero,
    plus (len ns) (plus r r), gens] ;
  -- Q+
  module XN = DG.D.XN ;

  gens-in (i : Fin (plus (len ns) (plus r r))) : XN.NM (S2.emb (suc (suc zero)) (gens i)) = XN.nm-gen i ;
  -- membership of a block x, from its index
  blk-in (x : S2.Blk (suc (suc zero))) (i : Fin (plus (len ns) (plus r r))) (e : Id (S2.Blk (suc (suc zero))) (gens i) x) :
    XN.NM (S2.emb (suc (suc zero)) x) =
    subst (\ y -> XN.NM (S2.emb (suc (suc zero)) y)) e (gens-in i) ;
  gN-in (i : Fin (len ns)) : XN.NM (S2.emb (suc (suc zero)) (gN i)) =
    blk-in (gN i) (Blocks[l].ix (len ns) (plus r r) (inl i))
      (FinCat[l].cat-l (S2.Blk (suc (suc zero))) (len ns) (plus r r) gN
        (FinCat[l].cat (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b)) i) ;
  gU-in (k : Fin r) : XN.NM (S2.emb (suc (suc zero)) (gL BG.vU a k)) =
    blk-in (gL BG.vU a k) (Blocks[l].ix (len ns) (plus r r) (inr (Blocks[l].ix r r (inl k))))
      (trans (FinCat[l].cat-r (S2.Blk (suc (suc zero))) (len ns) (plus r r) gN
                (FinCat[l].cat (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b)) (Blocks[l].ix r r (inl k)))
             (FinCat[l].cat-l (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b) k)) ;
  gV-in (k : Fin r) : XN.NM (S2.emb (suc (suc zero)) (gL BG.vV b k)) =
    blk-in (gL BG.vV b k) (Blocks[l].ix (len ns) (plus r r) (inr (Blocks[l].ix r r (inr k))))
      (trans (FinCat[l].cat-r (S2.Blk (suc (suc zero))) (len ns) (plus r r) gN
                (FinCat[l].cat (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b)) (Blocks[l].ix r r (inr k)))
             (FinCat[l].cat-r (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b) k)) ;

  ------------------------------------------------------------------------
  -- evaluation

  eps (n : Nat) (H : BG.F2.Vec) : BG.Fr.Vec = PM.hsum n (BG.pi n H) ;

  eps-add (n : Nat) (H H' : BG.F2.Vec) : Id BG.Fr.Vec (eps n (BG.F2.mod.madd H H')) (BG.Fr.mod.madd (eps n H) (eps n H')) =
    trans (ap (PM.hsum n) (BG.pi-add' n H H')) (RV.hsum-add n (BG.pi n H) (BG.pi n H')) ;
  eps-sm (n : Nat) (c : A.R) (H : BG.F2.Vec) : Id BG.Fr.Vec (eps n (BG.F2.mod.sm (BG.cR c) H)) (BG.Fr.mod.sm c (eps n H)) =
    trans (ap (PM.hsum n) (BG.pi-sm' n c H)) (RV.hsum-sm n c (BG.pi n H)) ;
  eps-zero (n : Nat) : Id BG.Fr.Vec (eps n BG.F2.mod.mz) BG.Fr.mod.mz =
    trans (ap (PM.hsum n) (BG.pi-zero' n)) (RV.hsum-zero n) ;
  eps-neg (n : Nat) (H : BG.F2.Vec) : Id BG.Fr.Vec (eps n (BG.F2.mod.mneg H)) (BG.Fr.mod.mneg (eps n H)) =
    BG.FL.G.neg-uniq (eps n H) (eps n (BG.F2.mod.mneg H))
      (trans (sym (eps-add n H (BG.F2.mod.mneg H))) (trans (ap (eps n) (BG.F2.mod.maddN H)) (eps-zero n))) ;
  eps-U0 (H : BG.F2.Vec) : Id BG.Fr.Vec (eps zero (BG.F2.mod.sm BG.vU H)) BG.Fr.mod.mz = BG.pi-U0 H zero ;
  eps-U (n : Nat) (H : BG.F2.Vec) : Id BG.Fr.Vec (eps (suc n) (BG.F2.mod.sm BG.vU H)) (BG.Fr.mod.sm a (eps n H)) =
    trans (ap (PM.hsum (suc n)) (BG.pi-U' n H))
      (RV.hsum-top n (BG.pi n H) (RV.van-at (suc n) (BG.pi n H) (BG.pi-van n H))) ;
  eps-V0 (H : BG.F2.Vec) : Id BG.Fr.Vec (eps zero (BG.F2.mod.sm BG.vV H)) BG.Fr.mod.mz = BG.pi-V0 H zero ;
  eps-V (n : Nat) (H : BG.F2.Vec) : Id BG.Fr.Vec (eps (suc n) (BG.F2.mod.sm BG.vV H)) (BG.Fr.mod.sm b (eps n H)) =
    trans (ap (PM.hsum (suc n)) (BG.pi-V' n H)) (RV.hsum-X n (BG.pi n H)) ;
  eps-lift (n : Nat) (m : BG.Fr.Vec) : Id BG.Fr.Vec (eps (suc n) (BG.lift m)) BG.Fr.mod.mz =
    trans (ap (PM.hsum (suc n)) (BG.pi-lift' n m)) (RV.hsum-zero (suc n)) ;

  E : Nat -> S2.Seq -> BG.Fr.Vec = split {
    zero -> \ G -> eps zero (G zero) ;
    suc t | ih -> \ G -> BG.Fr.mod.madd (eps (suc t) (G zero)) (ih (\ k -> G (suc k))) } ;

  E-add : (t : Nat) (G G' : S2.Seq) -> Id BG.Fr.Vec (E t (S2.seq.madd G G')) (BG.Fr.mod.madd (E t G) (E t G')) = split {
    zero -> \ G G' -> eps-add zero (G zero) (G' zero) ;
    suc t | ih -> \ G G' ->
      trans (BG.FL.G.cong-add (eps-add (suc t) (G zero) (G' zero)) (ih (\ k -> G (suc k)) (\ k -> G' (suc k))))
        (BG.FL.G.swap (eps (suc t) (G zero)) (eps (suc t) (G' zero)) (E t (\ k -> G (suc k))) (E t (\ k -> G' (suc k)))) } ;
  E-sm : (t : Nat) (c : A.R) (G : S2.Seq) -> Id BG.Fr.Vec (E t (S2.seq.sm (BG.cR c) G)) (BG.Fr.mod.sm c (E t G)) = split {
    zero -> \ c G -> eps-sm zero c (G zero) ;
    suc t | ih -> \ c G ->
      trans (BG.FL.G.cong-add (eps-sm (suc t) c (G zero)) (ih c (\ k -> G (suc k))))
        (sym (BG.Fr.mod.smD c (eps (suc t) (G zero)) (E t (\ k -> G (suc k))))) } ;
  E-zero : (t : Nat) -> Id BG.Fr.Vec (E t S2.seq.mz) BG.Fr.mod.mz = split {
    zero -> eps-zero zero ;
    suc t | ih -> trans (BG.FL.G.cong-add (eps-zero (suc t)) ih) (BG.Fr.mod.maddZ BG.Fr.mod.mz) } ;
  -- E (h G) for h = U, V: c E
  module Shift (h : BG.P2.K) (c : A.R)
    (e0 : (H : BG.F2.Vec) -> Id BG.Fr.Vec (eps zero (BG.F2.mod.sm h H)) BG.Fr.mod.mz)
    (es : (n : Nat) (H : BG.F2.Vec) -> Id BG.Fr.Vec (eps (suc n) (BG.F2.mod.sm h H)) (BG.Fr.mod.sm c (eps n H))) {
    E-h : (t : Nat) (G : S2.Seq) -> Id BG.Fr.Vec (E (suc t) (S2.seq.sm h G)) (BG.Fr.mod.sm c (E t G)) = split {
      zero -> \ G -> trans (BG.FL.G.cong-add (es zero (G zero)) (e0 (G (suc zero)))) (BG.Fr.mod.maddZ (BG.Fr.mod.sm c (E zero G))) ;
      suc t | ih -> \ G ->
        trans (BG.FL.G.cong-add (es (suc t) (G zero)) (ih (\ k -> G (suc k))))
          (sym (BG.Fr.mod.smD c (eps (suc t) (G zero)) (E t (\ k -> G (suc k))))) } ;
  } ;
  module SU = Shift[BG.vU, a, eps-U0, eps-U] ;
  module SV = Shift[BG.vV, b, eps-V0, eps-V] ;
  E-Y (t : Nat) (G : S2.Seq) : Id BG.Fr.Vec (E (suc t) (S2.Xs G)) (E t G) =
    trans (ap (\ x -> BG.Fr.mod.madd x (E t G)) (eps-zero (suc t))) (BG.FL.G.zl (E t G)) ;
  -- a sequence of degree 0 in Y
  E-blk1 : (t : Nat) (u : S2.Blk (suc zero)) -> Id BG.Fr.Vec (E t (S2.emb (suc zero) u)) (eps t (u (inr tt))) = split {
    zero -> \ u -> refl (eps zero (u (inr tt))) ;
    suc t -> \ u -> trans (ap (BG.Fr.mod.madd (eps (suc t) (u (inr tt)))) (E-zero t)) (BG.Fr.mod.maddZ (eps (suc t) (u (inr tt)))) } ;

  ------------------------------------------------------------------------
  -- Lemma good

  Good (G : S2.Seq) : U l = (t : Nat) -> MS.Mm ns (E t G) ;
  good-prop (G : S2.Seq) : Pr.isProp (Good G) = FE.isProp-Pi Nat (\ t -> MS.Mm ns (E t G)) (\ t -> MS.mm-prop ns (E t G)) ;

  in-N (x y : BG.Fr.Vec) (e : Id BG.Fr.Vec x y) (h : MS.Mm ns y) : MS.Mm ns x = OB.mm-cong ns y x (sym e) h ;
  in-zero (x : BG.Fr.Vec) (e : Id BG.Fr.Vec x BG.Fr.mod.mz) : MS.Mm ns x = in-N x BG.Fr.mod.mz e (OB.mm-zero ns) ;

  good-zero : Good S2.seq.mz = \ t -> in-zero (E t S2.seq.mz) (E-zero t) ;
  good-add (G G' : S2.Seq) (h : Good G) (h' : Good G') : Good (S2.seq.madd G G') = \ t ->
    in-N (E t (S2.seq.madd G G')) (BG.Fr.mod.madd (E t G) (E t G')) (E-add t G G')
      (OB.mm-add ns (E t G) (E t G') (h t) (h' t)) ;
  good-c (c : A.R) (G : S2.Seq) (h : Good G) : Good (S2.seq.sm (BG.cR c) G) = \ t ->
    in-N (E t (S2.seq.sm (BG.cR c) G)) (BG.Fr.mod.sm c (E t G)) (E-sm t c G) (OB.mm-sm ns c (E t G) (h t)) ;
  good-shift (G' G : S2.Seq) (c : A.R) (h0 : Id BG.Fr.Vec (E zero G') BG.Fr.mod.mz)
    (hs : (t : Nat) -> Id BG.Fr.Vec (E (suc t) G') (BG.Fr.mod.sm c (E t G))) (h : Good G) : Good G' = split {
    zero -> in-zero (E zero G') h0 ;
    suc t -> in-N (E (suc t) G') (BG.Fr.mod.sm c (E t G)) (hs t) (OB.mm-sm ns c (E t G) (h t)) } ;
  good-U (G : S2.Seq) (h : Good G) : Good (S2.seq.sm BG.vU G) =
    good-shift (S2.seq.sm BG.vU G) G a (eps-U0 (G zero)) (\ t -> SU.E-h t G) h ;
  good-V (G : S2.Seq) (h : Good G) : Good (S2.seq.sm BG.vV G) =
    good-shift (S2.seq.sm BG.vV G) G b (eps-V0 (G zero)) (\ t -> SV.E-h t G) h ;
  good-Y (G : S2.Seq) (h : Good G) : Good (S2.Xs G) = split {
    zero -> in-zero (E zero (S2.Xs G)) (eps-zero zero) ;
    suc t -> in-N (E (suc t) (S2.Xs G)) (E t G) (E-Y t G) (h t) } ;

  module GI = BG.RInd[S2.seq, Good, good-prop, good-zero, good-add, good-c, good-U, good-V] ;

  -- the generators are good
  elem-N (i : Fin (len ns)) : MS.Mm ns (LS.elem ns i) =
    MS.mm ns (LS.elem ns i) (LS.fam-in ns (LS.elem ns i)
      (XSpan[l].Delta[A,BG.Fr.mod].delta (len ns) i, XSpan[l].Delta[A,BG.Fr.mod].comb-delta (len ns) (LS.elem ns) i)) ;
  good-gN (i : Fin (len ns)) : Good (S2.emb (suc (suc zero)) (gN i)) = split {
    zero -> in-N (E zero (S2.emb (suc (suc zero)) (gN i))) (LS.elem ns i) (BG.pi-lift0 (LS.elem ns i) zero) (elem-N i) ;
    suc t -> in-zero (E (suc t) (S2.emb (suc (suc zero)) (gN i)))
      (trans (BG.FL.G.cong-add (eps-lift t (LS.elem ns i)) (trans (E-blk1 t (\ x -> BG.F2.mod.mz)) (eps-zero t)))
             (BG.Fr.mod.maddZ BG.Fr.mod.mz)) } ;
  module GoodL (h : BG.P2.K) (c : A.R)
    (e0 : (H : BG.F2.Vec) -> Id BG.Fr.Vec (eps zero (BG.F2.mod.sm h H)) BG.Fr.mod.mz)
    (es : (n : Nat) (H : BG.F2.Vec) -> Id BG.Fr.Vec (eps (suc n) (BG.F2.mod.sm h H)) (BG.Fr.mod.sm c (eps n H))) (k : Fin r) {
    e : BG.F2.Vec = BG.B2.basis r k ;
    -- c eps_t e - c eps_t e = 0
    cancel (t : Nat) : Id BG.Fr.Vec (E (suc t) (S2.emb (suc (suc zero)) (gL h c k))) BG.Fr.mod.mz =
      calc BG.Fr.Vec {
        E (suc t) (S2.emb (suc (suc zero)) (gL h c k))
          =< BG.FL.G.cong-add (es t e) (E-blk1 t (\ x -> BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) e))) >
        BG.Fr.mod.madd (BG.Fr.mod.sm c (eps t e)) (eps t (BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) e)))
          =< ap (BG.Fr.mod.madd (BG.Fr.mod.sm c (eps t e)))
                (trans (eps-neg t (BG.F2.mod.sm (BG.cR c) e)) (ap BG.Fr.mod.mneg (eps-sm t c e))) >
        BG.Fr.mod.madd (BG.Fr.mod.sm c (eps t e)) (BG.Fr.mod.mneg (BG.Fr.mod.sm c (eps t e)))
          =< BG.Fr.mod.maddN (BG.Fr.mod.sm c (eps t e)) >
        BG.Fr.mod.mz } ;
    good : Good (S2.emb (suc (suc zero)) (gL h c k)) = split {
      zero -> in-zero (E zero (S2.emb (suc (suc zero)) (gL h c k))) (e0 e) ;
      suc t -> in-zero (E (suc t) (S2.emb (suc (suc zero)) (gL h c k))) (cancel t) } ;
  } ;
  good-gens (i : Fin (plus (len ns) (plus r r))) : Good (S2.emb (suc (suc zero)) (gens i)) =
    FinCat[l].cat-all (S2.Blk (suc (suc zero))) (len ns) (plus r r) gN
      (FinCat[l].cat (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b))
      (\ x -> Good (S2.emb (suc (suc zero)) x)) good-gN
      (FinCat[l].cat-all (S2.Blk (suc (suc zero))) r r (gL BG.vU a) (gL BG.vV b) (\ x -> Good (S2.emb (suc (suc zero)) x))
         (\ k -> GoodL[BG.vU, a, eps-U0, eps-U, k].good) (\ k -> GoodL[BG.vV, b, eps-V0, eps-V, k].good)) i ;

  -- every element of Q+ is good
  good-sum : (p : Nat) (u : Fin p -> S2.Seq) -> ((i : Fin p) -> Good (u i)) -> Good (XN.CS.sum p u) = split {
    zero -> \ u h -> good-zero ;
    suc p | ih -> \ u h -> good-add (u (inr tt)) (XN.CS.sum p (\ i -> u (inl i))) (h (inr tt)) (ih (\ i -> u (inl i)) (\ i -> h (inl i))) } ;
  good-cF (c : XN.Vs) : Good (XN.cF c) =
    good-sum (plus (len ns) (plus r r)) (\ i -> S2.seq.sm (c i) (XN.F i))
      (\ i -> GI.rind (c i) (XN.F i) (good-gens i)) ;
  good-xs : (d : Nat) (g : S2.Seq) -> XN.XS d g -> Good g = split {
    zero -> \ g h -> subst Good h.2 (good-cF h.1) ;
    suc d | ih -> \ g h -> subst Good (sym h.2.2.2)
      (good-add (XN.cF h.1) (S2.Xs h.2.1) (good-cF h.1) (good-Y h.2.1 (ih h.2.1 h.2.2.1))) } ;
  good-nm (g : S2.Seq) (h : XN.NM g) : Good g = XN.nm-rec g (Good g) (good-prop g) (\ w -> good-xs w.1 g w.2) h ;

  -- for u of degree 0 in Y: pi_n u in Q_n
  good-Q (u : S2.Blk (suc zero)) (hg : Good (S2.emb (suc zero) u)) (n : Nat) : RV.Q[n, BG.pi n (u (inr tt))] =
    RV.mkQ n (BG.pi n (u (inr tt))) (BG.pi-van n (u (inr tt)))
      (in-N (eps n (u (inr tt))) (E n (S2.emb (suc zero) u)) (sym (E-blk1 n u)) (hg n)) ;

  ------------------------------------------------------------------------
  -- Lemma tele

  -- x ~ y
  Cg (x y : S2.Seq) : U l = XN.NM (L2.msub x y) ;
  -- (x - y) + (y - z) = x - z
  sub-chain (x y z : S2.Seq) : Id S2.Seq (S2.seq.madd (L2.msub x y) (L2.msub y z)) (L2.msub x z) =
    calc S2.Seq {
      S2.seq.madd (L2.msub x y) (L2.msub y z)
        =< sym (S2.seq.maddA x (S2.seq.mneg y) (L2.msub y z)) >
      S2.seq.madd x (S2.seq.madd (S2.seq.mneg y) (L2.msub y z))
        =< ap (S2.seq.madd x) (S2.seq.maddA (S2.seq.mneg y) y (S2.seq.mneg z)) >
      S2.seq.madd x (S2.seq.madd (S2.seq.madd (S2.seq.mneg y) y) (S2.seq.mneg z))
        =< ap (\ t -> S2.seq.madd x (S2.seq.madd t (S2.seq.mneg z))) (trans (S2.seq.maddC (S2.seq.mneg y) y) (S2.seq.maddN y)) >
      S2.seq.madd x (S2.seq.madd S2.seq.mz (S2.seq.mneg z))
        =< ap (S2.seq.madd x) (L2.G.zl (S2.seq.mneg z)) >
      L2.msub x z } ;
  cg-eq (x y : S2.Seq) (e : Id S2.Seq x y) : Cg x y =
    XN.nm-cong S2.seq.mz (L2.msub x y) (sym (trans (ap (L2.msub x) (sym e)) (S2.seq.maddN x))) XN.nm-zero ;
  cg-trans (x y z : S2.Seq) (h : Cg x y) (h' : Cg y z) : Cg x z =
    XN.nm-cong (S2.seq.madd (L2.msub x y) (L2.msub y z)) (L2.msub x z) (sub-chain x y z)
      (XN.nm-add (L2.msub x y) (L2.msub y z) h h') ;
  cg-eql (x x' y : S2.Seq) (e : Id S2.Seq x x') (h : Cg x' y) : Cg x y = subst (\ t -> Cg t y) (sym e) h ;
  cg-eqr (x y y' : S2.Seq) (h : Cg x y) (e : Id S2.Seq y y') : Cg x y' = subst (Cg x) e h ;
  cg-add (x y x' y' : S2.Seq) (h : Cg x y) (h' : Cg x' y') : Cg (S2.seq.madd x x') (S2.seq.madd y y') =
    XN.nm-cong (S2.seq.madd (L2.msub x y) (L2.msub x' y')) (L2.msub (S2.seq.madd x x') (S2.seq.madd y y'))
      (sym (L2.sub-swap x x' y y')) (XN.nm-add (L2.msub x y) (L2.msub x' y') h h') ;
  cg-sm (h : BG.P2.K) (x y : S2.Seq) (c : Cg x y) : Cg (S2.seq.sm h x) (S2.seq.sm h y) =
    XN.nm-cong (S2.seq.sm h (L2.msub x y)) (L2.msub (S2.seq.sm h x) (S2.seq.sm h y)) (L2.sm-sub h x y)
      (XN.nm-sm h (L2.msub x y) c) ;

  -- Y^n
  Yp : Nat -> S2.Seq -> S2.Seq = split {
    zero -> \ z -> z ;
    suc n | ih -> \ z -> ih (S2.Xs z) } ;
  yp-add : (n : Nat) (x y : S2.Seq) -> Id S2.Seq (Yp n (S2.seq.madd x y)) (S2.seq.madd (Yp n x) (Yp n y)) = split {
    zero -> \ x y -> refl (S2.seq.madd x y) ;
    suc n | ih -> \ x y -> trans (ap (Yp n) (S2.xs-add' x y)) (ih (S2.Xs x) (S2.Xs y)) } ;
  yp-sm : (n : Nat) (h : BG.P2.K) (x : S2.Seq) -> Id S2.Seq (Yp n (S2.seq.sm h x)) (S2.seq.sm h (Yp n x)) = split {
    zero -> \ h x -> refl (S2.seq.sm h x) ;
    suc n | ih -> \ h x -> trans (ap (Yp n) (S2.xs-sm' h x)) (ih h (S2.Xs x)) } ;
  nm-Yp : (n : Nat) (x : S2.Seq) -> XN.NM x -> XN.NM (Yp n x) = split {
    zero -> \ x h -> h ;
    suc n | ih -> \ x h -> ih (S2.Xs x) (XN.nm-X x h) } ;
  module YpOf (n : Nat) {
    module YM = LinIso[l].Map[BG.P2.S,S2.seq,S2.seq,Yp n,yp-add n,yp-sm n] ;
    cg (x y : S2.Seq) (c : Cg x y) : Cg (Yp n x) (Yp n y) =
      XN.nm-cong (Yp n (L2.msub x y)) (L2.msub (Yp n x) (Yp n y)) (YM.hsub x y) (nm-Yp n (L2.msub x y) c) ;
    -- w -> Y^n w, R'-linear
    ycst (w : BG.F2.Vec) : S2.Seq = Yp n (S2.cst w) ;
    ycst-add (w w' : BG.F2.Vec) : Id S2.Seq (ycst (BG.F2.mod.madd w w')) (S2.seq.madd (ycst w) (ycst w')) =
      trans (ap (Yp n) (S2.cst-add' w w')) (yp-add n (S2.cst w) (S2.cst w')) ;
    ycst-sm (h : BG.P2.K) (w : BG.F2.Vec) : Id S2.Seq (ycst (BG.F2.mod.sm h w)) (S2.seq.sm h (ycst w)) =
      trans (ap (Yp n) (S2.cst-sm' h w)) (yp-sm n h (S2.cst w)) ;
    module CM = LinIso[l].Map[BG.P2.S,BG.F2.mod,S2.seq,ycst,ycst-add,ycst-sm] ;
  } ;

  -- Phi(w) = h w - Y c w
  Phi (h : BG.P2.K) (c : A.R) (w : BG.F2.Vec) : S2.Seq =
    L2.msub (S2.seq.sm h (S2.cst w)) (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) w))) ;
  phi-add (h : BG.P2.K) (c : A.R) (w w' : BG.F2.Vec) :
    Id S2.Seq (Phi h c (BG.F2.mod.madd w w')) (S2.seq.madd (Phi h c w) (Phi h c w')) =
    trans (ap (\ t -> L2.msub t (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) (BG.F2.mod.madd w w')))))
              (trans (ap (S2.seq.sm h) (S2.cst-add' w w')) (S2.seq.smD h (S2.cst w) (S2.cst w'))))
      (trans (ap (L2.msub (S2.seq.madd (S2.seq.sm h (S2.cst w)) (S2.seq.sm h (S2.cst w'))))
                 (trans (ap (\ t -> S2.Xs (S2.cst t)) (BG.F2.mod.smD (BG.cR c) w w'))
                   (trans (ap S2.Xs (S2.cst-add' (BG.F2.mod.sm (BG.cR c) w) (BG.F2.mod.sm (BG.cR c) w')))
                     (S2.xs-add' (S2.cst (BG.F2.mod.sm (BG.cR c) w)) (S2.cst (BG.F2.mod.sm (BG.cR c) w'))))))
        (L2.sub-swap (S2.seq.sm h (S2.cst w)) (S2.seq.sm h (S2.cst w'))
          (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) w))) (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) w'))))) ;
  phi-sm (h : BG.P2.K) (c : A.R) (h' : BG.P2.K) (w : BG.F2.Vec) :
    Id S2.Seq (Phi h c (BG.F2.mod.sm h' w)) (S2.seq.sm h' (Phi h c w)) =
    trans (ap (\ t -> L2.msub t (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) (BG.F2.mod.sm h' w)))))
              (trans (ap (S2.seq.sm h) (S2.cst-sm' h' w)) (L2.sm-comm h h' (S2.cst w))))
      (trans (ap (L2.msub (S2.seq.sm h' (S2.seq.sm h (S2.cst w))))
                 (trans (ap (\ t -> S2.Xs (S2.cst t)) (BG.F2L.sm-comm (BG.cR c) h' w))
                   (trans (ap S2.Xs (S2.cst-sm' h' (BG.F2.mod.sm (BG.cR c) w)))
                     (S2.xs-sm' h' (S2.cst (BG.F2.mod.sm (BG.cR c) w))))))
        (sym (L2.sm-sub h' (S2.seq.sm h (S2.cst w)) (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) w)))))) ;
  -- Phi(e_k) is the generator (h - cY) e_k
  phi-at1 (h : BG.P2.K) (c : A.R) (w : BG.F2.Vec) : (j : Nat) ->
    Id BG.F2.Vec (Phi h c w (suc j)) (S2.emb (suc (suc zero)) (blk2 (BG.F2.mod.sm h w) (BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) w))) (suc j)) = split {
    zero -> trans (ap (\ t -> BG.F2.mod.madd t (BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) w))) (BG.F2L.sm-zero h))
                  (BG.F2L.G.zl (BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) w))) ;
    suc j -> trans (BG.F2L.G.cong-add (BG.F2L.sm-zero h) BG.F2L.G.neg-zero) (BG.F2.mod.maddZ BG.F2.mod.mz) } ;
  phi-at (h : BG.P2.K) (c : A.R) (w : BG.F2.Vec) : (j : Nat) ->
    Id BG.F2.Vec (Phi h c w j) (S2.emb (suc (suc zero)) (blk2 (BG.F2.mod.sm h w) (BG.F2.mod.mneg (BG.F2.mod.sm (BG.cR c) w))) j) = split {
    zero -> trans (ap (BG.F2.mod.madd (BG.F2.mod.sm h w)) BG.F2L.G.neg-zero) (BG.F2.mod.maddZ (BG.F2.mod.sm h w)) ;
    suc j -> phi-at1 h c w j } ;

  module PhiOf (h : BG.P2.K) (c : A.R) (gin : (k : Fin r) -> XN.NM (S2.emb (suc (suc zero)) (gL h c k))) {
    module PL = LinIso[l].Map[BG.P2.S,BG.F2.mod,S2.seq,Phi h c,phi-add h c,phi-sm h c] ;
    phi-gen (k : Fin r) : XN.NM (Phi h c (BG.B2.basis r k)) =
      XN.nm-cong (S2.emb (suc (suc zero)) (gL h c k)) (Phi h c (BG.B2.basis r k))
        (sym (S2.sext _ _ (phi-at h c (BG.B2.basis r k)))) (gin k) ;
    phi-nm (w : BG.F2.Vec) : XN.NM (Phi h c w) =
      XN.nm-cong (XN.CS.comb r w (\ k -> Phi h c (BG.B2.basis r k))) (Phi h c w)
        (trans (sym (PL.comb-map r w (BG.B2.basis r))) (ap (Phi h c) (BG.B2.vec-basis r w)))
        (XN.nm-comb r w (\ k -> Phi h c (BG.B2.basis r k)) phi-gen) ;
    -- h x ~ Y (c x)
    gen-cg (x : BG.Fr.Vec) : Cg (S2.seq.sm h (S2.cst (BG.lift x))) (S2.Xs (S2.cst (BG.lift (BG.Fr.mod.sm c x)))) =
      cg-eqr (S2.seq.sm h (S2.cst (BG.lift x))) (S2.Xs (S2.cst (BG.F2.mod.sm (BG.cR c) (BG.lift x))))
        (S2.Xs (S2.cst (BG.lift (BG.Fr.mod.sm c x)))) (phi-nm (BG.lift x))
        (ap (\ t -> S2.Xs (S2.cst t)) (sym (BG.lift-sm c x))) ;
  } ;
  module GU = PhiOf[BG.vU, a, gU-in] ;
  module GV = PhiOf[BG.vV, b, gV-in] ;

  -- U^k x ~ Y^k (a^k x)
  upow-cg : (k : Nat) (x : BG.Fr.Vec) -> Cg (S2.cst (BG.uit k (BG.lift x))) (Yp k (S2.cst (BG.lift (RV.as k x)))) = split {
    zero -> \ x -> cg-eq (S2.cst (BG.lift x)) (S2.cst (BG.lift x)) (refl (S2.cst (BG.lift x))) ;
    suc k | ih -> \ x ->
      cg-eql (S2.cst (BG.uit (suc k) (BG.lift x))) (S2.seq.sm BG.vU (S2.cst (BG.uit k (BG.lift x))))
        (Yp (suc k) (S2.cst (BG.lift (RV.as (suc k) x))))
        (S2.cst-sm' BG.vU (BG.uit k (BG.lift x)))
        (cg-trans (S2.seq.sm BG.vU (S2.cst (BG.uit k (BG.lift x)))) (S2.seq.sm BG.vU (Yp k (S2.cst (BG.lift (RV.as k x)))))
          (Yp (suc k) (S2.cst (BG.lift (RV.as (suc k) x))))
          (cg-sm BG.vU (S2.cst (BG.uit k (BG.lift x))) (Yp k (S2.cst (BG.lift (RV.as k x)))) (ih x))
          (cg-eql (S2.seq.sm BG.vU (Yp k (S2.cst (BG.lift (RV.as k x))))) (Yp k (S2.seq.sm BG.vU (S2.cst (BG.lift (RV.as k x)))))
            (Yp (suc k) (S2.cst (BG.lift (RV.as (suc k) x))))
            (sym (yp-sm k BG.vU (S2.cst (BG.lift (RV.as k x)))))
            (YpOf[k].cg (S2.seq.sm BG.vU (S2.cst (BG.lift (RV.as k x)))) (S2.Xs (S2.cst (BG.lift (RV.as (suc k) x))))
              (GU.gen-cg (RV.as k x))))) } ;

  -- iota_n g ~ Y^n theta_n g
  module TeleStep (n : Nat) (g : SQ.Seq)
    (ih : Cg (S2.cst (BG.iota n (\ j -> g (suc j)))) (Yp n (S2.cst (BG.lift (PM.hsum n (\ j -> g (suc j))))))) {
    g0 : BG.Fr.Vec = g zero ;
    th : BG.Fr.Vec = PM.hsum n (\ j -> g (suc j)) ;
    io : BG.F2.Vec = BG.iota n (\ j -> g (suc j)) ;
    -- the two sides, split
    lhs : Id S2.Seq (S2.cst (BG.iota (suc n) g))
            (S2.seq.madd (S2.cst (BG.uit (suc n) (BG.lift g0))) (S2.seq.sm BG.vV (S2.cst io))) =
      trans (S2.cst-add' (BG.uit (suc n) (BG.lift g0)) (BG.F2.mod.sm BG.vV io))
        (ap (S2.seq.madd (S2.cst (BG.uit (suc n) (BG.lift g0)))) (S2.cst-sm' BG.vV io)) ;
    rhs : Id S2.Seq (S2.seq.madd (Yp (suc n) (S2.cst (BG.lift (RV.as (suc n) g0)))) (Yp (suc n) (S2.cst (BG.lift (BG.Fr.mod.sm b th)))))
            (Yp (suc n) (S2.cst (BG.lift (PM.hsum (suc n) g)))) =
      sym (trans (ap (\ t -> YpOf[suc n].ycst (BG.lift t)) (RV.hsum-shift n g))
            (trans (ap (YpOf[suc n].ycst) (BG.lift-add (RV.as (suc n) g0) (BG.Fr.mod.sm b th)))
              (YpOf[suc n].ycst-add (BG.lift (RV.as (suc n) g0)) (BG.lift (BG.Fr.mod.sm b th))))) ;
    -- V iota_n (g . suc) ~ Y^(n+1) b theta_n (g . suc)
    v-part : Cg (S2.seq.sm BG.vV (S2.cst io)) (Yp (suc n) (S2.cst (BG.lift (BG.Fr.mod.sm b th)))) =
      cg-trans (S2.seq.sm BG.vV (S2.cst io)) (S2.seq.sm BG.vV (Yp n (S2.cst (BG.lift th))))
        (Yp (suc n) (S2.cst (BG.lift (BG.Fr.mod.sm b th))))
        (cg-sm BG.vV (S2.cst io) (Yp n (S2.cst (BG.lift th))) ih)
        (cg-eql (S2.seq.sm BG.vV (Yp n (S2.cst (BG.lift th)))) (Yp n (S2.seq.sm BG.vV (S2.cst (BG.lift th))))
          (Yp (suc n) (S2.cst (BG.lift (BG.Fr.mod.sm b th))))
          (sym (yp-sm n BG.vV (S2.cst (BG.lift th))))
          (YpOf[n].cg (S2.seq.sm BG.vV (S2.cst (BG.lift th))) (S2.Xs (S2.cst (BG.lift (BG.Fr.mod.sm b th))))
            (GV.gen-cg th))) ;
    result : Cg (S2.cst (BG.iota (suc n) g)) (Yp (suc n) (S2.cst (BG.lift (PM.hsum (suc n) g)))) =
      cg-eql (S2.cst (BG.iota (suc n) g)) (S2.seq.madd (S2.cst (BG.uit (suc n) (BG.lift g0))) (S2.seq.sm BG.vV (S2.cst io)))
        (Yp (suc n) (S2.cst (BG.lift (PM.hsum (suc n) g)))) lhs
        (cg-eqr (S2.seq.madd (S2.cst (BG.uit (suc n) (BG.lift g0))) (S2.seq.sm BG.vV (S2.cst io)))
          (S2.seq.madd (Yp (suc n) (S2.cst (BG.lift (RV.as (suc n) g0)))) (Yp (suc n) (S2.cst (BG.lift (BG.Fr.mod.sm b th)))))
          (Yp (suc n) (S2.cst (BG.lift (PM.hsum (suc n) g))))
          (cg-add (S2.cst (BG.uit (suc n) (BG.lift g0))) (Yp (suc n) (S2.cst (BG.lift (RV.as (suc n) g0))))
            (S2.seq.sm BG.vV (S2.cst io)) (Yp (suc n) (S2.cst (BG.lift (BG.Fr.mod.sm b th))))
            (upow-cg (suc n) g0) v-part)
          rhs) ;
  } ;
  tele : (n : Nat) (g : SQ.Seq) -> Cg (S2.cst (BG.iota n g)) (Yp n (S2.cst (BG.lift (PM.hsum n g)))) = split {
    zero -> \ g -> cg-eq (S2.cst (BG.lift (g zero))) (S2.cst (BG.lift (g zero))) (refl (S2.cst (BG.lift (g zero)))) ;
    suc n | ih -> \ g -> TeleStep[n, g, ih (\ j -> g (suc j))].result } ;

  -- Y^n y in Q+ for y in N
  gN-cst (x : BG.F2.Vec) : (j : Nat) -> Id BG.F2.Vec (S2.emb (suc (suc zero)) (blk2 x BG.F2.mod.mz) j) (S2.cst x j) = split {
    zero -> refl x ;
    suc j -> S2.cst-zero j } ;
  module NOf (n : Nat) {
    module CM = YpOf[n].CM ;
    gen (i : Fin (len ns)) : XN.NM (YpOf[n].ycst (BG.lift (LS.elem ns i))) =
      nm-Yp n (S2.cst (BG.lift (LS.elem ns i)))
        (XN.nm-cong (S2.emb (suc (suc zero)) (gN i)) (S2.cst (BG.lift (LS.elem ns i)))
          (S2.sext _ _ (gN-cst (BG.lift (LS.elem ns i)))) (gN-in i)) ;
    from-fam (y : BG.Fr.Vec) (ce : LS.InF (len ns) (LS.elem ns) y) : XN.NM (YpOf[n].ycst (BG.lift y)) =
      XN.nm-cong (XN.CS.comb (len ns) (\ i -> BG.cR (ce.1 i)) (\ i -> YpOf[n].ycst (BG.lift (LS.elem ns i))))
        (YpOf[n].ycst (BG.lift y))
        (trans (sym (CM.comb-map (len ns) (\ i -> BG.cR (ce.1 i)) (\ i -> BG.lift (LS.elem ns i))))
          (ap YpOf[n].ycst (trans (sym (BG.lift-comb (len ns) ce.1 (LS.elem ns))) (ap BG.lift ce.2))))
        (XN.nm-comb (len ns) (\ i -> BG.cR (ce.1 i)) (\ i -> YpOf[n].ycst (BG.lift (LS.elem ns i))) gen) ;
    nm-N (y : BG.Fr.Vec) (hy : MS.Mm ns y) : XN.NM (YpOf[n].ycst (BG.lift y)) =
      MS.mm-rec ns y (XN.NM (YpOf[n].ycst (BG.lift y))) (XN.nm-prop (YpOf[n].ycst (BG.lift y)))
        (\ i -> from-fam y (LS.in-fam ns y i)) hy ;
  } ;

  -- Lemma tele: if theta_n g is in N, iota_n g is in Q+
  tele-in (n : Nat) (g : SQ.Seq) (hN : MS.Mm ns (PM.hsum n g)) : XN.NM (S2.cst (BG.iota n g)) =
    XN.nm-cong (S2.seq.madd (L2.msub (S2.cst (BG.iota n g)) (Yp n (S2.cst (BG.lift (PM.hsum n g)))))
                            (Yp n (S2.cst (BG.lift (PM.hsum n g)))))
      (S2.cst (BG.iota n g))
      (Spans[l].Over[BG.P2.S,S2.seq].sub-add (S2.cst (BG.iota n g)) (Yp n (S2.cst (BG.lift (PM.hsum n g)))))
      (XN.nm-add (L2.msub (S2.cst (BG.iota n g)) (Yp n (S2.cst (BG.lift (PM.hsum n g)))))
        (Yp n (S2.cst (BG.lift (PM.hsum n g)))) (tele n g) (NOf[n].nm-N (PM.hsum n g) hN)) ;
} ;
