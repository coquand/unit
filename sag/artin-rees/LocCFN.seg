-- LocCFN.seg: localisations A[1/c] of CFN rings are CFN (artin-rees.tex,
-- Prop. 12, localisation part).
--
-- Stated for a ring map f : A -> B with v in B inverse to f c, every y of
-- B merely with f (c^n) y = f x (den), and f x = 0 only if merely
-- c^n x = 0 (ker).  The library's PowerLocalization is an instance
-- (LocCFNInst.seg).  E n = f (c^n) and V n = v^n are inverse.
--   common: a finite family has merely a common denominator,
--     E n mu_i = f m_i (induction, multiplying the denominators).
--   With E n u_i = f a_i, the combinations of u and of f a agree up to
--   the unit E n (en-comb).
--   (D) with E n' y = f y': y is in the span of u iff y' is in the
--       saturation J : c^infinity of J = (a) (LocStable.Inf): from-inf
--       divides by E t E n'; to-inf takes common denominators of the
--       coefficients, and the kernel gives the power of c.  LocStable
--       decides J : c^infinity.
--   (C) the syzygies of u are generated by the f gs_j, gs generators of
--       the syzygies of a: for a syzygy lam of u, E n' lam_i = f m_i,
--       c^t m is a syzygy of a, a combination d of gs, and
--       lam = V t V n' f d.
--   (N) Coquand-Persson's Hilbert.Over with X = v on the image of the
--       codes of A: codes List K; y = f x V n is the monomial x X^n.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module CN = CodedNoeth[l] ;

module Over (A B : CRing) (f : A.R -> B.R)
  (f-o : Id B.R (f A.o) B.o)
  (f-add : (a b : A.R) -> Id B.R (f (A.add a b)) (B.add (f a) (f b)))
  (f-mul : (a b : A.R) -> Id B.R (f (A.mul a b)) (B.mul (f a) (f b)))
  (c : A.R) (v : B.R) (cv : Id B.R (B.mul (f c) v) B.o)
  (den : (y : B.R) -> Tr.Trunc[(n : Nat) * (x : A.R) * Id B.R (B.mul (f (AffinePowers[l].Over[A].power c n)) y) (f x)].carrier)
  (ker : (x : A.R) -> Id B.R (f x) B.z ->
     Tr.Trunc[(n : Nat) * Id A.R (A.mul (AffinePowers[l].Over[A].power c n) x) A.z].carrier) {
  module CA = Coherent[l].Over[A,IP.regular A] ; module CB = Coherent[l].Over[B,IP.regular B] ;
  module RSA = Comb[l].Sums[A,IP.regular A] ; module RSB = Comb[l].Sums[B,IP.regular B] ;
  module LA = RL[A] ; module LB = RL[B] ;
  module AP = AffinePowers[l].Over[A] ; module BP = AffinePowers[l].Over[B] ;
  pw (n : Nat) : A.R = AP.power c n ;
  E (n : Nat) : B.R = f (pw n) ;
  V (n : Nat) : B.R = BP.power v n ;

  f-z : Id B.R (f A.z) B.z =
    LB.add-cancel (f A.z) (f A.z) (trans (sym (f-add A.z A.z)) (ap f (A.addZ A.z))) ;
  f-neg (a : A.R) : Id B.R (f (A.neg a)) (B.neg (f a)) =
    LB.neg-uniq (f a) (f (A.neg a)) (trans (sym (f-add a (A.neg a))) (trans (ap f (A.addN a)) f-z)) ;
  f-sum : (n : Nat) (w : Fin n -> A.R) -> Id B.R (f (RSA.sum n w)) (RSB.sum n (\ i -> f (w i))) = split {
    zero -> \ w -> f-z ;
    suc n | r -> \ w -> trans (f-add (w (inr tt)) (RSA.sum n (\ i -> w (inl i))))
      (ap (B.add (f (w (inr tt)))) (r (\ i -> w (inl i)))) } ;
  f-comb (n : Nat) (d u : Fin n -> A.R) :
    Id B.R (f (RSA.comb n d u)) (RSB.comb n (\ i -> f (d i)) (\ i -> f (u i))) =
    trans (f-sum n (\ i -> A.mul (d i) (u i)))
      (RSB.sum-cong n (\ i -> f (A.mul (d i) (u i))) (\ i -> B.mul (f (d i)) (f (u i))) (\ i -> f-mul (d i) (u i))) ;

  -- E n V n = 1, and its consequences
  ev : (n : Nat) -> Id B.R (B.mul (E n) (V n)) B.o = split {
    zero -> trans (B.mulO (f A.o)) f-o ;
    suc n | r -> calc B.R { B.mul (f (A.mul c (pw n))) (B.mul v (V n))
                              =< ap (\ t -> B.mul t (B.mul v (V n))) (f-mul c (pw n)) > B.mul (B.mul (f c) (E n)) (B.mul v (V n))
                              =< LB.mul-four (f c) (E n) v (V n) > B.mul (B.mul (f c) v) (B.mul (E n) (V n))
                              =< Presentations[l].cong2 B.R B.mul _ _ _ _ cv r > B.mul B.o B.o
                              =< B.mulO B.o > B.o } } ;
  unE (n : Nat) (x : B.R) : Id B.R (B.mul (V n) (B.mul (E n) x)) x =
    calc B.R { B.mul (V n) (B.mul (E n) x) =< B.mulA (V n) (E n) x > B.mul (B.mul (V n) (E n)) x
                 =< ap (\ t -> B.mul t x) (trans (B.mulC (V n) (E n)) (ev n)) > B.mul B.o x
                 =< LB.one-left x > x } ;
  unEE (t n : Nat) (x : B.R) : Id B.R (B.mul (V t) (B.mul (V n) (B.mul (E t) (B.mul (E n) x)))) x =
    trans (ap (B.mul (V t)) (trans (LB.mul-swap (V n) (E t) (B.mul (E n) x)) (ap (B.mul (E t)) (unE n x)))) (unE t x) ;
  e-add (n n' : Nat) : Id B.R (E (plus n n')) (B.mul (E n) (E n')) = trans (ap f (AP.power-add c n n')) (f-mul (pw n) (pw n')) ;
  -- a + (-b) = 0 gives a = b
  eq-of-sub (x y : A.R) (h : Id A.R (A.add x (A.neg y)) A.z) : Id A.R x y =
    calc A.R { x =< sym (A.addZ x) > A.add x A.z
                 =< ap (A.add x) (sym (trans (A.addC (A.neg y) y) (A.addN y))) > A.add x (A.add (A.neg y) y)
                 =< A.addA x (A.neg y) y > A.add (A.add x (A.neg y)) y
                 =< ap (\ t -> A.add t y) h > A.add A.z y
                 =< LA.zl y > y } ;

  ------------------------------------------------------------------------
  -- common denominators

  Den (k : Nat) (mu : Fin k -> B.R) : U l =
    (n : Nat) * (m : Fin k -> A.R) * ((i : Fin k) -> Id B.R (B.mul (E n) (mu i)) (f (m i))) ;
  merge (k : Nat) (mu : Fin (suc k) -> B.R) (d : Den k (\ i -> mu (inl i)))
    (d' : (n : Nat) * (x : A.R) * Id B.R (B.mul (E n) (mu (inr tt))) (f x)) : Den (suc k) mu =
    (plus d.1 d'.1, (snoc (Fin k) A.R (\ i -> A.mul (pw d'.1) (d.2.1 i)) (A.mul (pw d.1) d'.2.1),
     Saturation[l].allS k (\ j -> Id B.R (B.mul (E (plus d.1 d'.1)) (mu j))
                                 (f (snoc (Fin k) A.R (\ i -> A.mul (pw d'.1) (d.2.1 i)) (A.mul (pw d.1) d'.2.1) j)))
       (\ i -> calc B.R { B.mul (E (plus d.1 d'.1)) (mu (inl i))
                           =< ap (\ t -> B.mul t (mu (inl i))) (trans (e-add d.1 d'.1) (B.mulC (E d.1) (E d'.1)))
                           > B.mul (B.mul (E d'.1) (E d.1)) (mu (inl i))
                           =< sym (B.mulA (E d'.1) (E d.1) (mu (inl i))) > B.mul (E d'.1) (B.mul (E d.1) (mu (inl i)))
                           =< ap (B.mul (E d'.1)) (d.2.2 i) > B.mul (E d'.1) (f (d.2.1 i))
                           =< sym (f-mul (pw d'.1) (d.2.1 i)) > f (A.mul (pw d'.1) (d.2.1 i)) })
       (calc B.R { B.mul (E (plus d.1 d'.1)) (mu (inr tt))
                     =< ap (\ t -> B.mul t (mu (inr tt))) (e-add d.1 d'.1) > B.mul (B.mul (E d.1) (E d'.1)) (mu (inr tt))
                     =< sym (B.mulA (E d.1) (E d'.1) (mu (inr tt))) > B.mul (E d.1) (B.mul (E d'.1) (mu (inr tt)))
                     =< ap (B.mul (E d.1)) d'.2.2 > B.mul (E d.1) (f d'.2.1)
                     =< sym (f-mul (pw d.1) d'.2.1) > f (A.mul (pw d.1) d'.2.1) }))) ;
  common : (k : Nat) (mu : Fin k -> B.R) -> Tr.Trunc[Den k mu].carrier = split {
    zero -> \ mu -> Tr.Trunc[Den zero mu].inc (zero, (\ i -> absurd A.R i, \ i -> absurd (Id B.R (B.mul (E zero) (mu i)) (f (absurd A.R i))) i)) ;
    suc k | r -> \ mu ->
      Tr.Trunc[Den k (\ i -> mu (inl i))].induction @l (\ t -> Tr.Trunc[Den (suc k) mu].carrier) (\ t -> Tr.Trunc[Den (suc k) mu].proposition)
        (\ d -> Tr.Trunc[(n : Nat) * (x : A.R) * Id B.R (B.mul (E n) (mu (inr tt))) (f x)].induction @l
           (\ t -> Tr.Trunc[Den (suc k) mu].carrier) (\ t -> Tr.Trunc[Den (suc k) mu].proposition)
           (\ d' -> Tr.Trunc[Den (suc k) mu].inc (merge k mu d d'))
           (den (mu (inr tt))))
        (r (\ i -> mu (inl i))) } ;

  ------------------------------------------------------------------------
  -- a family u with E n u_i = f a_i

  module Lifted (k : Nat) (u : Fin k -> B.R) (n : Nat) (a : Fin k -> A.R)
    (eu : (i : Fin k) -> Id B.R (B.mul (E n) (u i)) (f (a i))) {
    module LS = LocStable[l].Over[A,k,a,c] ;
    en-comb (lam : Fin k -> A.R) : Id B.R (B.mul (E n) (RSB.comb k (\ i -> f (lam i)) u)) (f (RSA.comb k lam a)) =
      calc B.R { B.mul (E n) (RSB.comb k (\ i -> f (lam i)) u)
                   =< sym (RSB.comb-sm k (E n) (\ i -> f (lam i)) u) > RSB.comb k (\ i -> B.mul (E n) (f (lam i))) u
                   =< RSB.sum-cong k (\ i -> B.mul (B.mul (E n) (f (lam i))) (u i)) (\ i -> B.mul (f (lam i)) (f (a i)))
                        (\ i -> trans (sym (B.mulA (E n) (f (lam i)) (u i)))
                                  (trans (LB.mul-swap (E n) (f (lam i)) (u i)) (ap (B.mul (f (lam i))) (eu i))))
                   > RSB.comb k (\ i -> f (lam i)) (\ i -> f (a i))
                   =< sym (f-comb k lam a) > f (RSA.comb k lam a) } ;
    -- a combination with coefficients E n' mu_i = f m_i
    comb-den (mu : Fin k -> B.R) (d : Den k mu) :
      Id B.R (f (RSA.comb k d.2.1 a)) (B.mul (E n) (B.mul (E d.1) (RSB.comb k mu u))) =
      trans (sym (en-comb d.2.1))
        (ap (B.mul (E n)) (trans (RSB.sum-cong k (\ i -> B.mul (f (d.2.1 i)) (u i)) (\ i -> B.mul (B.mul (E d.1) (mu i)) (u i))
                                    (\ i -> ap (\ t -> B.mul t (u i)) (sym (d.2.2 i))))
                                 (RSB.comb-sm k (E d.1) mu u))) ;

    ----------------------------------------------------------------------
    -- (D)

    from-inf-at (y : B.R) (n' : Nat) (y' : A.R) (ey : Id B.R (B.mul (E n') y) (f y')) (t : Nat)
      (g : CA.InFM k a (A.mul (pw t) y')) : CB.InFM k u y =
      (\ i -> B.mul (V t) (B.mul (V n') (B.mul (E n) (f (g.1 i)))),
       calc B.R { RSB.comb k (\ i -> B.mul (V t) (B.mul (V n') (B.mul (E n) (f (g.1 i))))) u
                    =< RSB.comb-sm k (V t) (\ i -> B.mul (V n') (B.mul (E n) (f (g.1 i)))) u
                    > B.mul (V t) (RSB.comb k (\ i -> B.mul (V n') (B.mul (E n) (f (g.1 i)))) u)
                    =< ap (B.mul (V t)) (RSB.comb-sm k (V n') (\ i -> B.mul (E n) (f (g.1 i))) u)
                    > B.mul (V t) (B.mul (V n') (RSB.comb k (\ i -> B.mul (E n) (f (g.1 i))) u))
                    =< ap (\ s -> B.mul (V t) (B.mul (V n') s))
                          (trans (RSB.comb-sm k (E n) (\ i -> f (g.1 i)) u) (en-comb g.1))
                    > B.mul (V t) (B.mul (V n') (f (RSA.comb k g.1 a)))
                    =< ap (\ s -> B.mul (V t) (B.mul (V n') s))
                          (trans (ap f g.2) (trans (f-mul (pw t) y') (ap (B.mul (E t)) (sym ey))))
                    > B.mul (V t) (B.mul (V n') (B.mul (E t) (B.mul (E n') y)))
                    =< unEE t n' y > y }) ;
    from-inf (y : B.R) (n' : Nat) (y' : A.R) (ey : Id B.R (B.mul (E n') y) (f y')) (h : LS.Inf y') : CB.Mem k u y =
      Tr.Trunc[(t : Nat) * LS.I t y'].induction @l (\ w -> CB.Mem k u y) (\ w -> Tr.Trunc[CB.InFM k u y].proposition)
        (\ th -> Tr.Trunc[CA.InFM k a (A.mul (pw th.1) y')].induction @l (\ w -> CB.Mem k u y)
           (\ w -> Tr.Trunc[CB.InFM k u y].proposition)
           (\ g -> Tr.Trunc[CB.InFM k u y].inc (from-inf-at y n' y' ey th.1 g)) th.2)
        h ;

    -- P - Q with f P = f Q
    module ToInf (y : B.R) (n' : Nat) (y' : A.R) (ey : Id B.R (B.mul (E n') y) (f y'))
      (mu : Fin k -> B.R) (emu : Id B.R (RSB.comb k mu u) y) (d : Den k mu) {
      P : A.R = A.mul (pw d.1) (A.mul (pw n) y') ;
      Q : A.R = A.mul (pw n') (RSA.comb k d.2.1 a) ;
      fP : Id B.R (f P) (B.mul (E d.1) (B.mul (E n) (B.mul (E n') y))) =
        trans (f-mul (pw d.1) (A.mul (pw n) y'))
          (ap (B.mul (E d.1)) (trans (f-mul (pw n) y') (ap (B.mul (E n)) (sym ey)))) ;
      fQ : Id B.R (f Q) (B.mul (E d.1) (B.mul (E n) (B.mul (E n') y))) =
        calc B.R { f Q =< f-mul (pw n') (RSA.comb k d.2.1 a) > B.mul (E n') (f (RSA.comb k d.2.1 a))
                     =< ap (B.mul (E n')) (trans (comb-den mu d) (ap (\ s -> B.mul (E n) (B.mul (E d.1) s)) emu))
                     > B.mul (E n') (B.mul (E n) (B.mul (E d.1) y))
                     =< LB.mul-swap (E n') (E n) (B.mul (E d.1) y) > B.mul (E n) (B.mul (E n') (B.mul (E d.1) y))
                     =< ap (B.mul (E n)) (LB.mul-swap (E n') (E d.1) y) > B.mul (E n) (B.mul (E d.1) (B.mul (E n') y))
                     =< LB.mul-swap (E n) (E d.1) (B.mul (E n') y) > B.mul (E d.1) (B.mul (E n) (B.mul (E n') y)) } ;
      fx : Id B.R (f (A.add P (A.neg Q))) B.z =
        calc B.R { f (A.add P (A.neg Q)) =< f-add P (A.neg Q) > B.add (f P) (f (A.neg Q))
                     =< ap (B.add (f P)) (f-neg Q) > B.add (f P) (B.neg (f Q))
                     =< ap (\ s -> B.add (f P) (B.neg s)) (trans fQ (sym fP)) > B.add (f P) (B.neg (f P))
                     =< B.addN (f P) > B.z } ;
      T (t : Nat) : Nat = plus t (plus d.1 n) ;
      at (te : (t : Nat) * Id A.R (A.mul (pw t) (A.add P (A.neg Q))) A.z) : LS.I (T te.1) y' =
        Tr.Trunc[CA.InFM k a (A.mul (pw (T te.1)) y')].inc (\ i -> A.mul (pw te.1) (A.mul (pw n') (d.2.1 i)),
          calc A.R { RSA.comb k (\ i -> A.mul (pw te.1) (A.mul (pw n') (d.2.1 i))) a
                       =< RSA.comb-sm k (pw te.1) (\ i -> A.mul (pw n') (d.2.1 i)) a
                       > A.mul (pw te.1) (RSA.comb k (\ i -> A.mul (pw n') (d.2.1 i)) a)
                       =< ap (A.mul (pw te.1)) (RSA.comb-sm k (pw n') d.2.1 a) > A.mul (pw te.1) Q
                       =< sym (eq-of-sub (A.mul (pw te.1) P) (A.mul (pw te.1) Q)
                                (trans (sym (trans (A.dist (pw te.1) P (A.neg Q)) (ap (A.add (A.mul (pw te.1) P)) (LA.mul-neg (pw te.1) Q))))
                                       te.2))
                       > A.mul (pw te.1) P
                       =< ap (A.mul (pw te.1)) (A.mulA (pw d.1) (pw n) y') > A.mul (pw te.1) (A.mul (A.mul (pw d.1) (pw n)) y')
                       =< A.mulA (pw te.1) (A.mul (pw d.1) (pw n)) y' > A.mul (A.mul (pw te.1) (A.mul (pw d.1) (pw n))) y'
                       =< ap (\ s -> A.mul (A.mul (pw te.1) s) y') (sym (AP.power-add c d.1 n))
                       > A.mul (A.mul (pw te.1) (pw (plus d.1 n))) y'
                       =< ap (\ s -> A.mul s y') (sym (AP.power-add c te.1 (plus d.1 n))) > A.mul (pw (T te.1)) y' }) ;
      inf : LS.Inf y' =
        Tr.Trunc[(t : Nat) * Id A.R (A.mul (pw t) (A.add P (A.neg Q))) A.z].induction @l (\ w -> LS.Inf y') (\ w -> LS.inf-prop y')
          (\ te -> Tr.Trunc[(t : Nat) * LS.I t y'].inc (T te.1, at te))
          (ker (A.add P (A.neg Q)) fx) ;
    } ;
    to-inf (y : B.R) (n' : Nat) (y' : A.R) (ey : Id B.R (B.mul (E n') y) (f y')) (h : CB.Mem k u y) : LS.Inf y' =
      Tr.Trunc[CB.InFM k u y].induction @l (\ w -> LS.Inf y') (\ w -> LS.inf-prop y')
        (\ g -> Tr.Trunc[Den k g.1].induction @l (\ w -> LS.Inf y') (\ w -> LS.inf-prop y')
           (\ d -> ToInf[y, n', y', ey, g.1, g.2, d].inf) (common k g.1))
        h ;

    decide (y : B.R) (n' : Nat) (y' : A.R) (ey : Id B.R (B.mul (E n') y) (f y')) :
      Plus (LS.Inf y') (Not (LS.Inf y')) -> Plus (CB.Mem k u y) (Not (CB.Mem k u y)) = split {
      inl h -> inl (from-inf y n' y' ey h) ;
      inr nh -> inr (\ hb -> nh (to-inf y n' y' ey hb)) } ;

    ----------------------------------------------------------------------
    -- (C)

    module CohOf (p : Nat) (gs : Fin p -> CA.Vec k) (sa : CA.SyzAll k a p gs) (un : CA.Univ k a p gs) {
      module FA = Comb[l].Free[A,k] ; module FB = Comb[l].Free[B,k] ;
      gsB (j : Fin p) : CB.Vec k = \ i -> f (gs j i) ;
      cancel (x : B.R) (h : Id B.R (B.mul (E n) x) B.z) : Id B.R x B.z =
        trans (sym (unE n x)) (trans (ap (B.mul (V n)) h) (LB.mul-zero (V n))) ;
      saB : CB.SyzAll k u p gsB = \ j -> cancel (RSB.comb k (gsB j) u) (trans (en-comb (gs j)) (trans (ap f (sa j)) f-z)) ;

      unB-at (lam : CB.Vec k) (slam : CB.Syz k u lam) (d : Den k lam)
        (te : (t : Nat) * Id A.R (A.mul (pw t) (RSA.comb k d.2.1 a)) A.z) : CB.MemV k p gsB lam =
        let { t : Nat = te.1 ;
              m' : CA.Vec k = \ i -> A.mul (pw t) (d.2.1 i) ;
              sm' : CA.Syz k a m' = trans (RSA.comb-sm k (pw t) d.2.1 a) te.2 } in
        Tr.Trunc[CA.InFV k p gs m'].induction @l (\ w -> CB.MemV k p gsB lam) (\ w -> Tr.Trunc[CB.InFV k p gsB lam].proposition)
          (\ dd -> Tr.Trunc[CB.InFV k p gsB lam].inc (\ j -> B.mul (V t) (B.mul (V d.1) (f (dd.1 j))),
             FB.ext (FB.VS.comb p (\ j -> B.mul (V t) (B.mul (V d.1) (f (dd.1 j)))) gsB) lam (\ i ->
               calc B.R { FB.VS.comb p (\ j -> B.mul (V t) (B.mul (V d.1) (f (dd.1 j)))) gsB i
                            =< FB.comb-at p (\ j -> B.mul (V t) (B.mul (V d.1) (f (dd.1 j)))) gsB i
                            > RSB.comb p (\ j -> B.mul (V t) (B.mul (V d.1) (f (dd.1 j)))) (\ j -> gsB j i)
                            =< RSB.comb-sm p (V t) (\ j -> B.mul (V d.1) (f (dd.1 j))) (\ j -> gsB j i)
                            > B.mul (V t) (RSB.comb p (\ j -> B.mul (V d.1) (f (dd.1 j))) (\ j -> gsB j i))
                            =< ap (B.mul (V t)) (RSB.comb-sm p (V d.1) (\ j -> f (dd.1 j)) (\ j -> gsB j i))
                            > B.mul (V t) (B.mul (V d.1) (RSB.comb p (\ j -> f (dd.1 j)) (\ j -> gsB j i)))
                            =< ap (\ s -> B.mul (V t) (B.mul (V d.1) s))
                                  (trans (sym (f-comb p dd.1 (\ j -> gs j i)))
                                    (trans (ap f (sym (FA.comb-at p dd.1 gs i))) (ap (\ w -> f (w i)) dd.2)))
                            > B.mul (V t) (B.mul (V d.1) (f (m' i)))
                            =< ap (\ s -> B.mul (V t) (B.mul (V d.1) s))
                                  (trans (f-mul (pw t) (d.2.1 i)) (ap (B.mul (E t)) (sym (d.2.2 i))))
                            > B.mul (V t) (B.mul (V d.1) (B.mul (E t) (B.mul (E d.1) (lam i))))
                            =< unEE t d.1 (lam i) > lam i })))
          (un m' sm') ;
      unB : CB.Univ k u p gsB = \ lam slam ->
        Tr.Trunc[Den k lam].induction @l (\ w -> CB.MemV k p gsB lam) (\ w -> Tr.Trunc[CB.InFV k p gsB lam].proposition)
          (\ d -> Tr.Trunc[(t : Nat) * Id A.R (A.mul (pw t) (RSA.comb k d.2.1 a)) A.z].induction @l
             (\ w -> CB.MemV k p gsB lam) (\ w -> Tr.Trunc[CB.InFV k p gsB lam].proposition)
             (\ te -> unB-at lam slam d te)
             (ker (RSA.comb k d.2.1 a)
                (trans (comb-den lam d) (trans (ap (\ s -> B.mul (E n) (B.mul (E d.1) s)) slam)
                   (trans (ap (B.mul (E n)) (LB.mul-zero (E d.1))) (LB.mul-zero (E n)))))))
          (common k lam) ;
      cohw : Tr.Trunc[CB.CohW k u].carrier = Tr.Trunc[CB.CohW k u].inc (p, (gsB, (saB, unB))) ;
    } ;
  } ;

  disc (dA : CA.Disc) (cA : CA.Coh) (fl : CA.FL) : CB.Disc = \ k u y ->
    Tr.Trunc[Den k u].induction @l (\ w -> Plus (CB.Mem k u y) (Not (CB.Mem k u y)))
      (\ w -> Coherent[l].dec-prop (CB.Mem k u y) (Tr.Trunc[CB.InFM k u y].proposition))
      (\ du -> Tr.Trunc[(n : Nat) * (x : A.R) * Id B.R (B.mul (E n) y) (f x)].induction @l
         (\ w -> Plus (CB.Mem k u y) (Not (CB.Mem k u y)))
         (\ w -> Coherent[l].dec-prop (CB.Mem k u y) (Tr.Trunc[CB.InFM k u y].proposition))
         (\ dy -> Lifted[k, u, du.1, du.2.1, du.2.2].decide y dy.1 dy.2.1 dy.2.2
                    (LocStable[l].Over[A,k,du.2.1,c].dec-inf dA cA fl dy.2.1))
         (den y))
      (common k u) ;

  coh (cA : CA.Coh) : CB.Coh = \ k u ->
    Tr.Trunc[Den k u].induction @l (\ w -> Tr.Trunc[CB.CohW k u].carrier) (\ w -> Tr.Trunc[CB.CohW k u].proposition)
      (\ du -> Tr.Trunc[CA.CohW k du.2.1].induction @l (\ w -> Tr.Trunc[CB.CohW k u].carrier) (\ w -> Tr.Trunc[CB.CohW k u].proposition)
         (\ q -> Lifted[k, u, du.1, du.2.1, du.2.2].CohOf[q.1, q.2.1, q.2.2.1, q.2.2.2].cohw)
         (cA k du.2.1))
      (common k u) ;

  ------------------------------------------------------------------------
  -- (N)

  module NoethB (K0 : U l) (cc : CN.CT) (P0 : CN.PresK[A, CN.El K0 cc])
    (nt : Span[l].Over[A, CN.pres A (CN.El K0 cc) P0].Noeth) (sA : CN.Over[A, CN.pres A (CN.El K0 cc) P0].Surj) {
    module TF = Transfer[l].Over[A,B,f,f-o,f-add,f-mul,CN.pres A (CN.El K0 cc) P0] ;
    P1 : Span[l].Pres[B] = TF.image ;
    module PP = PolyPres[l].Over[B,P1,v] ;
    module HB = Hilbert[l].Over[B,P1,v] ;
    pow-eq : (n : Nat) -> Id B.R (PP.pow n) (V n) = split {
      zero -> refl B.o ;
      suc n | r -> ap (B.mul v) r } ;
    Code (y : B.R) : U l = (cs : List (CN.El K0 cc)) * Id B.R (PP.ev cs) y ;
    code-at (y : B.R) (dy : (n : Nat) * (x : A.R) * Id B.R (B.mul (E n) y) (f x))
      (ke : (k : CN.El K0 cc) * Id A.R (P0.phi k) dy.2.1) : Code y =
      (PP.monomial ke.1 dy.1,
       calc B.R { PP.ev (PP.monomial ke.1 dy.1) =< PP.ev-monomial ke.1 dy.1 > B.mul (f (P0.phi ke.1)) (PP.pow dy.1)
                    =< Presentations[l].cong2 B.R B.mul _ _ _ _ (trans (ap f ke.2) (sym dy.2.2)) (pow-eq dy.1)
                    > B.mul (B.mul (E dy.1) y) (V dy.1)
                    =< B.mulC (B.mul (E dy.1) y) (V dy.1) > B.mul (V dy.1) (B.mul (E dy.1) y)
                    =< unE dy.1 y > y }) ;
    surjB : CN.Over[B,PP.pres].Surj = \ y ->
      Tr.Trunc[(n : Nat) * (x : A.R) * Id B.R (B.mul (E n) y) (f x)].induction @l (\ w -> Tr.Trunc[Code y].carrier)
        (\ w -> Tr.Trunc[Code y].proposition)
        (\ dy -> Tr.Trunc[(k : CN.El K0 cc) * Id A.R (P0.phi k) dy.2.1].induction @l (\ w -> Tr.Trunc[Code y].carrier)
           (\ w -> Tr.Trunc[Code y].proposition) (\ ke -> Tr.Trunc[Code y].inc (code-at y dy ke)) (sA dy.2.1))
        (den y) ;
    np : CN.NP K0 B = (list cc, (CN.ofPres B PP.pres, (HB.hilbert (TF.noeth nt), surjB))) ;
  } ;

  cfn (K0 : U l) (cA : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,B] =
    CFN[l].mkCFN K0 B (disc cA.disc cA.coh (CFN[l].fl K0 A cA)) (coh cA.coh)
      (Tr.Trunc[CN.NP K0 A].induction @l (\ t -> Tr.Trunc[CN.NP K0 B].carrier) (\ t -> Tr.Trunc[CN.NP K0 B].proposition)
         (\ np -> Tr.Trunc[CN.NP K0 B].inc NoethB[K0, np.1, np.2.1, np.2.2.1, np.2.2.2].np) cA.noeth) ;
} ;
