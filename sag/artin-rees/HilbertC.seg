-- HilbertC.seg: (C) for R[X] over a CFN ring (artin-rees.tex, §4 (C)).
--
-- For u_1..u_k in R[X]: a common degree bound N, the blocks f_i of the
-- u_i in M[X]_N, a saturated list P (Prop. 8) and v_j = p_j in R[X].
--   C: u_i = sum_j C_ij v_j with C_ij constants (hf, cu);
--   B: v_j = sum_i B_ji u_i (an, through PolyCoef.SpanOf, bv);
--   theta: generators of the syzygies of v (Schreyer).
-- The syzygies of u are generated by B^T theta^l and e_i - B^T C^T e_i:
-- for a syzygy lam of u, C^T lam is a syzygy of v, so C^T lam = sum a_l
-- theta^l, and lam = sum_i lam_i (e_i - B^T C^T e_i) + sum_l a_l B^T theta^l.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R) (disc : Coherent[l].Over[A,IP.regular A].Disc)
  (coh : Coherent[l].Over[A,IP.regular A].Coh) (flA : Coherent[l].Over[A,IP.regular A].FL) {
  module SC = Schreyer[l].Over[A,setA,disc,coh,flA] ;
  module T = SC.T ; module HD = SC.HD ; module E = T.E ; module SQ = T.SQ ; module PCo = T.PCo ;
  S : CRing = T.S ;
  K : U l = T.K ;
  Seq : U l = T.Seq ;
  module CSo = Coherent[l].Over[S,IP.regular S] ;
  module CS = T.CS ;
  module DS = XSpan[l].Delta[S,IP.regular S] ;

  -- the standard basis is symmetric, and sum_i lam_i e_i = lam
  dsymS (s : Nat) (ih : (i j : Fin s) -> Id S.R (DS.delta s i j) (DS.delta s j i)) :
    (i j : Fin (suc s)) -> Id S.R (DS.delta (suc s) i j) (DS.delta (suc s) j i) = split {
    inl i -> split { inl j -> ih i j ; inr t -> refl S.z } ;
    inr t -> split { inl j -> refl S.z ; inr t' -> refl S.o } } ;
  dsym : (s : Nat) (i j : Fin s) -> Id S.R (DS.delta s i j) (DS.delta s j i) = split {
    zero -> \ i j -> absurd (Id S.R (DS.delta zero i j) (DS.delta zero j i)) i ;
    suc s | ih -> dsymS s ih } ;
  vec-delta (k : Nat) (lam : Comb[l].Free[S,k].Vec) : Id Comb[l].Free[S,k].Vec (Comb[l].Free[S,k].VS.comb k lam (DS.delta k)) lam =
    Comb[l].Free[S,k].ext _ _ (\ m ->
      trans (Comb[l].Free[S,k].comb-at k lam (DS.delta k) m)
        (trans (CS.sum-cong k (\ i -> S.mul (lam i) (DS.delta k i m)) (\ i -> S.mul (DS.delta k m i) (lam i))
                  (\ i -> trans (S.mulC (lam i) (DS.delta k i m)) (ap (\ x -> S.mul x (lam i)) (dsym k i m))))
          (DS.comb-delta k lam m))) ;

  -- combinations with pointwise equal families
  comb-eq (m : Nat) (c : Fin m -> K) (F G : Fin m -> K) (e : (j : Fin m) -> Id K (F j) (G j)) :
    Id K (CS.comb m c F) (CS.comb m c G) =
    CS.sum-cong m (\ j -> S.mul (c j) (F j)) (\ j -> S.mul (c j) (G j)) (\ j -> ap (S.mul (c j)) (e j)) ;

  module Data (k : Nat) (u : Fin k -> K) (t : Nat) (v : Fin t -> K)
    (Cm : Fin k -> Comb[l].Free[A,t].Vec) (cu : (i : Fin k) -> Id K (CS.comb t (\ j -> E.constant (Cm i j)) v) (u i))
    (Bm : Fin t -> Comb[l].Free[S,k].Vec) (bv : (j : Fin t) -> Id K (CS.comb k (Bm j) u) (v j))
    (q : Nat) (theta : Fin q -> Comb[l].Free[S,t].Vec) (tsyz : CSo.SyzAll t v q theta) (tuniv : CSo.Univ t v q theta) {
    module Fk = Comb[l].Free[S,k] ; module Ft = Comb[l].Free[S,t] ;
    module Bk = Comb[l].Bilinear[S,Fk.mod] ; module BR = Comb[l].Bilinear[S,IP.regular S] ;
    module LK = IP.ModL[S,Fk.mod] ;
    module VK = FinCat[l].Vecs[S,k] ;
    VecK : U l = Fk.Vec ;
    BT (x : Ft.Vec) : VecK = Fk.VS.comb t x Bm ;
    Ct (i : Fin k) : Ft.Vec = \ j -> E.constant (Cm i j) ;
    eps (i : Fin k) : VecK = \ m -> E.addQ (DS.delta k i m) (E.negQ (BT (Ct i) m)) ;
    gen1 (m : Fin q) : VecK = BT (theta m) ;
    p : Nat = plus q k ;
    gens : Fin p -> VecK = FinCat[l].cat VecK q k gen1 eps ;
    SyzU (x : VecK) : U l = CSo.Syz k u x ;

    -- B^T of a syzygy of v is a syzygy of u
    bt-comb (x : Ft.Vec) : Id K (CS.comb k (BT x) u) (CS.comb t x v) =
      trans (BR.comb-comb k t x Bm u) (comb-eq t x (\ j -> CS.comb k (Bm j) u) v bv) ;
    gen1-syz (m : Fin q) : SyzU (gen1 m) = trans (bt-comb (theta m)) (tsyz m) ;
    LS-cong (x x' y y' : K) (e : Id K x x') (e' : Id K y y') : Id K (S.add x y) (S.add x' y') =
      trans (ap (\ z -> S.add z y) e) (ap (S.add x') e') ;
    eps-syz (i : Fin k) : SyzU (eps i) =
      trans (CS.comb-add k (DS.delta k i) (\ m -> E.negQ (BT (Ct i) m)) u)
        (trans (LS-cong (CS.comb k (DS.delta k i) u) (u i) (CS.comb k (\ m -> E.negQ (BT (Ct i) m)) u) (E.negQ (u i)) (DS.comb-delta k u i)
                  (trans (CS.comb-neg k (BT (Ct i)) u) (ap E.negQ (trans (bt-comb (Ct i)) (cu i)))))
          (S.addN (u i))) ;
    gens-syz : CSo.SyzAll k u p gens = FinCat[l].cat-all VecK q k gen1 eps SyzU gen1-syz eps-syz ;

    -- every syzygy of u
    module Univ (lam : VecK) (sz : SyzU lam) {
      y : Ft.Vec = Ft.VS.comb k lam Ct ;
      ysyz : CSo.Syz t v y =
        trans (BR.comb-comb t k lam Ct v) (trans (comb-eq k lam (\ i -> CS.comb t (Ct i) v) u cu) sz) ;
      neg-v (x : VecK) : VecK = \ m -> E.negQ (x m) ;
      comb-negv (c : Fin k -> K) (F : Fin k -> VecK) : Id VecK (Fk.VS.comb k c (\ i -> neg-v (F i))) (neg-v (Fk.VS.comb k c F)) =
        Fk.ext _ _ (\ m -> trans (Fk.comb-at k c (\ i -> neg-v (F i)) m)
          (trans (CS.sum-cong k (\ i -> S.mul (c i) (E.negQ (F i m))) (\ i -> E.negQ (S.mul (c i) (F i m)))
                    (\ i -> T.RS.mul-neg (c i) (F i m)))
            (trans (CS.sum-neg k (\ i -> S.mul (c i) (F i m))) (ap E.negQ (sym (Fk.comb-at k c F m)))))) ;
      -- sum_i lam_i eps_i = lam - B^T y
      eps-comb : Id VecK (Fk.VS.comb k lam eps) (Fk.mod.madd lam (neg-v (BT y))) =
        trans (Fk.VS.comb-addv k lam (DS.delta k) (\ i -> neg-v (BT (Ct i))))
          (LK.G.cong-add (vec-delta k lam)
            (trans (comb-negv lam (\ i -> BT (Ct i))) (ap neg-v (sym (Bk.comb-comb t k lam Ct Bm))))) ;
      module Gen (a : Fin q -> K) (ea : Id Ft.Vec (Ft.VS.comb q a theta) y) {
        gen1-comb : Id VecK (Fk.VS.comb q a gen1) (BT y) =
          trans (sym (Bk.comb-comb t q a theta Bm)) (ap BT ea) ;
        total : Id VecK (Fk.mod.madd (Fk.VS.comb q a gen1) (Fk.VS.comb k lam eps)) lam =
          trans (LK.G.cong-add gen1-comb eps-comb)
            (trans (Fk.mod.maddC (BT y) (Fk.mod.madd lam (neg-v (BT y))))
              (Spans[l].Over[S,Fk.mod].sub-add lam (BT y))) ;
        result : VK.MemV p gens lam =
          VK.memv-cong p gens (Fk.mod.madd (Fk.VS.comb q a gen1) (Fk.VS.comb k lam eps)) lam total
            (VK.memv-cat q k gen1 eps (Fk.VS.comb q a gen1) (Fk.VS.comb k lam eps) (VK.memv-comb q gen1 a) (VK.memv-comb k eps lam)) ;
      } ;
      result : VK.MemV p gens lam =
        Tr.Trunc[CSo.InFV t q theta y].induction @l (\ x -> VK.MemV p gens lam) (\ x -> VK.memv-prop p gens lam)
          (\ ae -> Gen[ae.1, ae.2].result) (tuniv y ysyz) ;
    } ;
    cohw : CSo.CohW k u = (p, (gens, (gens-syz, \ lam sz -> Univ[lam, sz].result))) ;
  } ;

  ------------------------------------------------------------------------
  -- assembling the data

  module AtBound (k : Nat) (u : Fin k -> K) (bd : HD.Bnd k u E.zeroQ) {
    module AB = HD.AtBound[k,u,E.zeroQ,bd] ;
    N : Nat = AB.N ;
    module ST = Saturation[l].Over[A,IP.regular A,coh,N,HD.discAll (suc N),HilbertD[l].RegBlocks[A,disc,coh,flA,suc N].fl-blk,k,AB.f] ;
    module WithSat (P : List ST.BM) (hf : (i : Fin k) -> ST.MB.Mm P (AB.f i)) (an : ST.AllN P) (sat : ST.Sat P) {
      module SY = SC.SyzP[N,P,sat] ;
      t : Nat = SY.t ;
      Cq (i : Fin k) : U l = (c : Comb[l].Free[A,t].Vec) * Id K (CS.comb t (\ j -> E.constant (c j)) SY.v) (u i) ;
      cq (i : Fin k) : Tr.Trunc[Cq i].carrier =
        ST.MB.mm-rec P (AB.f i) (Tr.Trunc[Cq i].carrier) Tr.Trunc[Cq i].proposition
          (\ h -> Tr.Trunc[Cq i].inc ((SY.LB.in-fam P (AB.f i) h).1,
             T.kap-inj _ _ (trans (SY.kap-cv (SY.LB.in-fam P (AB.f i) h).1)
               (trans (ap (SQ.emb (suc N)) (SY.LB.in-fam P (AB.f i) h).2) (AB.ef i)))))
          (hf i) ;
      Bq (j : Fin t) : U l = (c : Comb[l].Free[S,k].Vec) * Id K (CS.comb k c u) (SY.v j) ;
      bq (j : Fin t) : Tr.Trunc[Bq j].carrier =
        Tr.Trunc[CSo.InFM k u (SY.v j)].induction @l (\ x -> Tr.Trunc[Bq j].carrier) (\ x -> Tr.Trunc[Bq j].proposition)
          (\ h -> Tr.Trunc[Bq j].inc h)
          (AB.SO.to-span (SY.v j)
            (AB.SO.XN.nm-cong (SQ.emb (suc N) (SY.pe j)) (T.kap (SY.v j)) (sym (T.kap-toS (suc N) (SY.pe j)))
              (AB.F12.nm-fam (SQ.emb (suc N) (SY.pe j)) (ST.elem-n P an j)))) ;
      result : Tr.Trunc[CSo.CohW k u].carrier =
        Tr.Trunc[(i : Fin k) -> Cq i].induction @l (\ x -> Tr.Trunc[CSo.CohW k u].carrier) (\ x -> Tr.Trunc[CSo.CohW k u].proposition)
          (\ cc -> Tr.Trunc[(j : Fin t) -> Bq j].induction @l (\ x -> Tr.Trunc[CSo.CohW k u].carrier) (\ x -> Tr.Trunc[CSo.CohW k u].proposition)
             (\ bb -> Tr.Trunc[CSo.CohW t SY.v].induction @l (\ x -> Tr.Trunc[CSo.CohW k u].carrier) (\ x -> Tr.Trunc[CSo.CohW k u].proposition)
                (\ th -> Tr.Trunc[CSo.CohW k u].inc
                   Data[k, u, t, SY.v, \ i -> (cc i).1, \ i -> (cc i).2, \ j -> (bb j).1, \ j -> (bb j).2,
                        th.1, th.2.1, th.2.2.1, th.2.2.2].cohw)
                SY.coh-v)
             (FinCat[l].fchoice t Bq bq))
          (FinCat[l].fchoice k Cq cq) ;
    } ;
    result : Tr.Trunc[CSo.CohW k u].carrier =
      Tr.Trunc[ST.Saturated].induction @l (\ x -> Tr.Trunc[CSo.CohW k u].carrier) (\ x -> Tr.Trunc[CSo.CohW k u].proposition)
        (\ x -> WithSat[x.1, x.2.1, x.2.2.1, x.2.2.2].result) ST.saturate ;
  } ;

  coh-S : CSo.Coh = \ k u ->
    Tr.Trunc[HD.Bnd k u E.zeroQ].induction @l (\ x -> Tr.Trunc[CSo.CohW k u].carrier) (\ x -> Tr.Trunc[CSo.CohW k u].proposition)
      (\ bd -> AtBound[k, u, bd].result) (HD.bounds k u E.zeroQ) ;
} ;
