-- CFNCalculus.seg: for a fixed base K0 of codes, the CFN rings form a
-- Noetheriannote.Calculus (artin-rees.tex, §7).
--
-- Proof.  Noeth A = CFN K0 A, a proposition in U l (CFN.Noeth).  It is
-- stable under the three constructions of the Calculus, each stated on the
-- library's own ring:
--   A[X]               (PolynomialRing.Extension)  Thm. 10    HilbertCFN.poly
--   A/(c_1..c_m)       (QuotientRing, Generated)   Prop. 12   QuotCFNInst.quotient
--   A[1/c]             (PowerLocalization)         Prop. 12   LocCFNInst.localization
-- and in a CFN ring the annihilators of the powers of c merely stabilise:
-- Kill.stable gives merely N with StableAnnihilator.Stable c N (N = b + 1
-- for an Artin-Rees bound b of Ann(c) along (c)), which is the field
-- stable as it stands.
-- The component Noetheriannote.reduction is not given here.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;

module Over (K0 : U l) {
  calculus : Noetheriannote[l].Calculus =
    Noetheriannote[l].mkCalculus (CFN[l].Noeth K0)
      (\ A setA cA -> HilbertCFN[l].Over[K0,A,setA].poly cA)
      (\ A setA m c cA -> QuotCFNInst[l].Over[A,m,c].quotient K0 cA)
      (\ A setA c cA -> LocCFNInst[l].Over[A,c].localization K0 cA)
      (\ A setA cA c -> Kill[l].Over[K0,A,setA,cA,c].stable) ;
  -- by definition, the predicate of the calculus is CFN K0
  noeth-cfn (A : CRing) (setA : Pr.isSet A.R) : Id (U l) (calculus.Noeth A setA) (CFN[l].CFN[K0,A]) =
    refl (CFN[l].CFN[K0,A]) ;
} ;
