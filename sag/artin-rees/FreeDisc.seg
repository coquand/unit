-- FreeDisc.seg: strong discreteness (D) of the free modules A^r over a
-- coherent strongly discrete ring (artin-rees.tex, Prop. 3, part (D)).
--
-- For y in A^(r+1) and u_1..u_k: decide pi y in span(pi u).  If not, y is
-- not in span(u).  If pi y = sum lam_i pi u_i, then y is in span(u) iff
-- y' = rho y - sum lam_i rho u_i is in the span of the rho w_j, where
-- w_j = sum tau^j_i u_i for generators tau^j of Syz(pi u): if y = sum nu_i u_i
-- then nu - lam is a syzygy of pi u, so nu - lam = sum mu_j tau^j and
-- y' = sum mu_j rho w_j.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (disc : Coherent[l].Over[A,IP.regular A].Disc) (coh : Coherent[l].Over[A,IP.regular A].Coh) {
  module RS = Comb[l].Sums[A,IP.regular A] ; module RL = RL[A] ;
  module CR = Coherent[l].Over[A,IP.regular A] ;
  module FC = FreeCoherent[l].Over[A,coh] ; open FC ;

  disc-zero (k : Nat) (u : Fin k -> Vec zero) (y : Vec zero) :
    Plus (Coherent[l].Over[A,V zero].Mem k u y) (Not (Coherent[l].Over[A,V zero].Mem k u y)) =
    inl (Tr.Trunc[Coherent[l].Over[A,V zero].InFM k u y].inc
      (\ j -> A.z, vec0-eq (Comb[l].Free[A,zero].VS.comb k (\ j -> A.z) u) y)) ;

  module Step (r : Nat) (ih : Coherent[l].Over[A,V r].Disc) (k : Nat) (u : Fin k -> Vec (suc r)) (y : Vec (suc r)) {
    module CS = Coherent[l].Over[A,V (suc r)] ;
    module CV = Coherent[l].Over[A,V r] ;
    module VSk = Comb[l].Free[A,k].VS ;
    module VS1 = Comb[l].Free[A,suc r].VS ;
    module VSr = Comb[l].Free[A,r].VS ;
    module MLr = IP.ModL[A,V r] ;
    pu (j : Fin k) : A.R = last r (u j) ;
    ru (j : Fin k) : Vec r = rest r (u j) ;
    Goal : U l = Plus (CS.Mem k u y) (Not (CS.Mem k u y)) ;
    vadd (n : Nat) (a b : Vec n) : Vec n = \ i -> A.add (a i) (b i) ;
    goal-prop : Pr.isProp Goal = Coherent[l].dec-prop (CS.Mem k u y) Tr.Trunc[CS.InFM k u y].proposition ;

    add-sub (a b : Vec r) : Id (Vec r) (vadd r a (MLr.msub b a)) b =
      trans ((V r).maddC a (MLr.msub b a))
        (trans (sym ((V r).maddA b ((V r).mneg a) a))
          (trans (ap (vadd r b) (trans ((V r).maddC ((V r).mneg a) a) ((V r).maddN a))) ((V r).maddZ b))) ;

    project (m : CS.Mem k u y) : CR.Mem k pu (last r y) =
      Tr.Trunc[CS.InFM k u y].induction @l (\ t -> CR.Mem k pu (last r y)) (\ t -> Tr.Trunc[CR.InFM k pu (last r y)].proposition)
        (\ ce -> Tr.Trunc[CR.InFM k pu (last r y)].inc (ce.1, trans (sym (pi-comb r k ce.1 u)) (ap (last r) ce.2))) m ;

    module Yes (lam : Vec k) (e1 : Id A.R (RS.comb k lam pu) (last r y))
      (p : Nat) (tau : Fin p -> Vec k) (tsyz : CR.SyzAll k pu p tau) (tuniv : CR.Univ k pu p tau) {
      w (j : Fin p) : Vec (suc r) = VS1.comb k (tau j) u ;
      rw (j : Fin p) : Vec r = rest r (w j) ;
      pw-zero (j : Fin p) : Id A.R (last r (w j)) A.z = trans (pi-comb r k (tau j) u) (tsyz j) ;
      y' : Vec r = MLr.msub (rest r y) (VSr.comb k lam ru) ;

      module Found (mu : Vec p) (e2 : Id (Vec r) (VSr.comb p mu rw) y') {
        kappa : Vec k = vadd k lam (VSk.comb p mu tau) ;
        comb-kappa : Id (Vec (suc r)) (VS1.comb k kappa u) (vadd (suc r) (VS1.comb k lam u) (VS1.comb p mu w)) =
          trans (VS1.comb-add k lam (VSk.comb p mu tau) u)
            (ap (vadd (suc r) (VS1.comb k lam u)) (Comb[l].Bilinear[A,V (suc r)].comb-comb k p mu tau u)) ;
        last-eq : Id A.R (A.add (last r (VS1.comb k lam u)) (last r (VS1.comb p mu w))) (last r y) =
          trans (ap (\ t -> A.add t (last r (VS1.comb p mu w))) (trans (pi-comb r k lam u) e1))
            (trans (ap (A.add (last r y)) (trans (pi-comb r p mu w) (RS.comb-vanish p mu (\ j -> last r (w j)) pw-zero)))
              (A.addZ (last r y))) ;
        rest-eq1 : Id (Vec r) (vadd r (rest r (VS1.comb k lam u)) (rest r (VS1.comb p mu w)))
                              (vadd r (VSr.comb k lam ru) (rest r (VS1.comb p mu w))) =
          ap (\ t -> vadd r t (rest r (VS1.comb p mu w))) (rho-comb r k lam u) ;
        rest-eq2 : Id (Vec r) (vadd r (VSr.comb k lam ru) (rest r (VS1.comb p mu w))) (vadd r (VSr.comb k lam ru) y') =
          ap (vadd r (VSr.comb k lam ru)) (trans (rho-comb r p mu w) e2) ;
        rest-eq : Id (Vec r) (vadd r (rest r (VS1.comb k lam u)) (rest r (VS1.comb p mu w))) (rest r y) =
          trans rest-eq1 (trans rest-eq2 (add-sub (VSr.comb k lam ru) (rest r y))) ;
        kappa-eq : Id (Vec (suc r)) (VS1.comb k kappa u) y =
          trans comb-kappa (parts-eq r (vadd (suc r) (VS1.comb k lam u) (VS1.comb p mu w)) y last-eq rest-eq) ;
      } ;

      module Missing (no : Not (CV.Mem p rw y')) (m : CS.Mem k u y) {
        module Sub (nu : Vec k) (e3 : Id (Vec (suc r)) (VS1.comb k nu u) y) {
          delta : Vec k = IP.ModL[A,V k].msub nu lam ;
          comb-delta : Id (Vec (suc r)) (VS1.comb k delta u) (IP.ModL[A,V (suc r)].msub (VS1.comb k nu u) (VS1.comb k lam u)) =
            trans (VS1.comb-add k nu (\ j -> A.neg (lam j)) u)
              (ap (vadd (suc r) (VS1.comb k nu u)) (VS1.comb-neg k lam u)) ;
          syz : CR.Syz k pu delta =
            trans (RS.comb-add k nu (\ j -> A.neg (lam j)) pu)
              (trans (ap (A.add (RS.comb k nu pu)) (RS.comb-neg k lam pu))
                (trans (ap (\ t -> A.add t (A.neg (RS.comb k lam pu))) (trans (sym (pi-comb r k nu u)) (ap (last r) e3)))
                  (trans (ap (\ t -> A.add (last r y) (A.neg t)) e1) (A.addN (last r y))))) ;
          absurd-from (de : Comb[l].Lists[A,V k].InF p tau delta) : Empty =
            no (Tr.Trunc[CV.InFM p rw y'].inc (de.1,
              trans (sym (rho-comb r p de.1 w))
                (trans (ap (rest r) (sym (Comb[l].Bilinear[A,V (suc r)].comb-comb k p de.1 tau u)))
                  (trans (ap (\ t -> rest r (VS1.comb k t u)) de.2)
                    (trans (ap (rest r) comb-delta)
                      (trans (ap (\ t -> MLr.msub (rest r t) (rest r (VS1.comb k lam u))) e3)
                        (ap (MLr.msub (rest r y)) (rho-comb r k lam u)))))))) ;
          result : Empty =
            Tr.Trunc[CR.InFV k p tau delta].induction @l (\ t -> Empty) (\ t -> Coherent[l].empty-prop) absurd-from (tuniv delta syz) ;
        } ;
        result : Empty =
          Tr.Trunc[CS.InFM k u y].induction @l (\ t -> Empty) (\ t -> Coherent[l].empty-prop) (\ ne -> Sub[ne.1, ne.2].result) m ;
      } ;

      decide : Plus (CV.Mem p rw y') (Not (CV.Mem p rw y')) -> Goal = split {
        inl yes2 -> Tr.Trunc[CV.InFM p rw y'].induction @l (\ t -> Goal) (\ t -> goal-prop)
          (\ me -> inl (Tr.Trunc[CS.InFM k u y].inc (Found[me.1, me.2].kappa, Found[me.1, me.2].kappa-eq))) yes2 ;
        inr no2 -> inr (\ m -> Missing[no2, m].result) } ;
      result : Goal = decide (ih p rw y') ;
    } ;

    module Lifted (lam : Vec k) (e1 : Id A.R (RS.comb k lam pu) (last r y)) {
      result : Goal =
        Tr.Trunc[CR.CohW k pu].induction @l (\ t -> Goal) (\ t -> goal-prop)
          (\ x -> Yes[lam, e1, x.1, x.2.1, x.2.2.1, x.2.2.2].result) (coh k pu) ;
    } ;
    decide : Plus (CR.Mem k pu (last r y)) (Not (CR.Mem k pu (last r y))) -> Goal = split {
      inl yes -> Tr.Trunc[CR.InFM k pu (last r y)].induction @l (\ t -> Goal) (\ t -> goal-prop)
        (\ le -> Lifted[le.1, le.2].result) yes ;
      inr no -> inr (\ m -> no (project m)) } ;
    result : Goal = decide (disc k pu (last r y)) ;
  } ;

  disc-vec : (r : Nat) -> Coherent[l].Over[A,V r].Disc = split {
    zero -> disc-zero ;
    suc r | ih -> \ k u y -> Step[r, ih, k, u, y].result } ;
} ;
