-- LocStable.seg: the saturation J : c^infinity of a finitely generated
-- ideal is detachable (artin-rees.tex, Prop. 12, localisation part).
--
-- A has (D), (C) and the principle of free lists; J = (a_1..a_k), c in A,
-- I n = J : c^n = { x | c^n x in J }.  The I n increase.
-- stab: merely K with I (K+1) included in I K.  By the principle of free
--   lists on Phi s = "for every n with span s included in I n, stab":
--   the generators g_j of I (n+1) are the last coordinates of the syzygies
--   of (a_1..a_k, c^(n+1)) (gen-in, g-in).  Decide each g_j in span s.  If
--   all are, I (n+1) is in span s, hence in I n: K = n.  Otherwise the
--   free list s extends by a g_j outside span s, and span (g_j :: s) is in
--   I (n+1).
-- reach: then I t is included in I K for every t (down: c^(j+K+1) x in J
--   gives c x in I (j+K), in I K by induction, so x in I (K+1), in I K).
-- dec-inf: membership in J : c^infinity (merely some t with x in I t) is
--   decidable: it is x in I K.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Over (A : CRing) (k : Nat) (a : Fin k -> A.R) (c : A.R) {
  module CA = Coherent[l].Over[A,IP.regular A] ; module RSA = Comb[l].Sums[A,IP.regular A] ;
  module MS = Spans[l].Over[A,IP.regular A] ; module SO = Saturation[l].SpanOps[A,IP.regular A] ;
  module SP = ModSpan[l].Over[A,IP.regular A] ; module LA = RL[A] ;
  module AP = AffinePowers[l].Over[A] ;
  pw (n : Nat) : A.R = AP.power c n ;

  ------------------------------------------------------------------------
  -- J and the I n

  Mj (y : A.R) : U l = CA.Mem k a y ;
  mj-prop (y : A.R) : Pr.isProp (Mj y) = Tr.Trunc[CA.InFM k a y].proposition ;
  mj-cong (y y' : A.R) (e : Id A.R y y') (h : Mj y) : Mj y' = subst Mj e h ;
  mj-zero : Mj A.z = Tr.Trunc[CA.InFM k a A.z].inc (\ i -> A.z, RSA.comb-zero k a) ;
  mj-add (y y' : A.R) (h : Mj y) (h' : Mj y') : Mj (A.add y y') =
    Tr.Trunc[CA.InFM k a y].induction @l (\ t -> Mj (A.add y y')) (\ t -> mj-prop (A.add y y'))
      (\ g -> Tr.Trunc[CA.InFM k a y'].induction @l (\ t -> Mj (A.add y y')) (\ t -> mj-prop (A.add y y'))
         (\ g' -> Tr.Trunc[CA.InFM k a (A.add y y')].inc (\ i -> A.add (g.1 i) (g'.1 i),
            trans (RSA.comb-add k g.1 g'.1 a) (Presentations[l].cong2 A.R A.add _ _ _ _ g.2 g'.2))) h') h ;
  mj-sm (d y : A.R) (h : Mj y) : Mj (A.mul d y) =
    Tr.Trunc[CA.InFM k a y].induction @l (\ t -> Mj (A.mul d y)) (\ t -> mj-prop (A.mul d y))
      (\ g -> Tr.Trunc[CA.InFM k a (A.mul d y)].inc (\ i -> A.mul d (g.1 i), trans (RSA.comb-sm k d g.1 a) (ap (A.mul d) g.2))) h ;

  I (n : Nat) (x : A.R) : U l = Mj (A.mul (pw n) x) ;
  i-prop (n : Nat) (x : A.R) : Pr.isProp (I n x) = mj-prop (A.mul (pw n) x) ;
  i-cong (n : Nat) (x x' : A.R) (e : Id A.R x x') (h : I n x) : I n x' = subst (I n) e h ;
  i-zero (n : Nat) : I n A.z = mj-cong A.z (A.mul (pw n) A.z) (sym (LA.mul-zero (pw n))) mj-zero ;
  i-add (n : Nat) (x x' : A.R) (h : I n x) (h' : I n x') : I n (A.add x x') =
    mj-cong (A.add (A.mul (pw n) x) (A.mul (pw n) x')) (A.mul (pw n) (A.add x x')) (sym (A.dist (pw n) x x'))
      (mj-add (A.mul (pw n) x) (A.mul (pw n) x') h h') ;
  i-sm (n : Nat) (d x : A.R) (h : I n x) : I n (A.mul d x) =
    mj-cong (A.mul d (A.mul (pw n) x)) (A.mul (pw n) (A.mul d x)) (LA.mul-swap d (pw n) x) (mj-sm d (A.mul (pw n) x) h) ;
  -- c^(n+1) x = c (c^n x) and = c^n (c x)
  i-suc (n : Nat) (x : A.R) (h : I n x) : I (suc n) x =
    mj-cong (A.mul c (A.mul (pw n) x)) (A.mul (pw (suc n)) x) (A.mulA c (pw n) x) (mj-sm c (A.mul (pw n) x) h) ;
  i-shift (n : Nat) (x : A.R) (h : I (suc n) x) : I n (A.mul c x) =
    mj-cong (A.mul (pw (suc n)) x) (A.mul (pw n) (A.mul c x)) (AP.power-commute c n x) h ;
  i-unshift (n : Nat) (x : A.R) (h : I n (A.mul c x)) : I (suc n) x =
    mj-cong (A.mul (pw n) (A.mul c x)) (A.mul (pw (suc n)) x) (sym (AP.power-commute c n x)) h ;

  Stab : U l = Tr.Trunc[(K : Nat) * ((x : A.R) -> I (suc K) x -> I K x)].carrier ;
  stab-prop : Pr.isProp Stab = Tr.Trunc[(K : Nat) * ((x : A.R) -> I (suc K) x -> I K x)].proposition ;

  ------------------------------------------------------------------------
  -- generators of I (n+1)

  fam (n : Nat) : Fin (suc k) -> A.R = snoc (Fin k) A.R a (pw (suc n)) ;

  module Gens (n : Nat) (p : Nat) (gs : Fin p -> CA.Vec (suc k)) (sa : CA.SyzAll (suc k) (fam n) p gs)
    (un : CA.Univ (suc k) (fam n) p gs) {
    module FA = Comb[l].Free[A,suc k] ;
    g (j : Fin p) : A.R = gs j (inr tt) ;
    g-in (j : Fin p) : I (suc n) (g j) =
      Tr.Trunc[CA.InFM k a (A.mul (pw (suc n)) (g j))].inc (\ i -> A.neg (gs j (inl i)),
        calc A.R { RSA.comb k (\ i -> A.neg (gs j (inl i))) a
                     =< RSA.comb-neg k (\ i -> gs j (inl i)) a > A.neg (RSA.comb k (\ i -> gs j (inl i)) a)
                     =< sym (LA.neg-uniq (RSA.comb k (\ i -> gs j (inl i)) a) (A.mul (g j) (pw (suc n)))
                          (trans (A.addC (RSA.comb k (\ i -> gs j (inl i)) a) (A.mul (g j) (pw (suc n)))) (sa j)))
                     > A.mul (g j) (pw (suc n))
                     =< A.mulC (g j) (pw (suc n)) > A.mul (pw (suc n)) (g j) }) ;
    gen-at (x : A.R) (mu : CA.InFM k a (A.mul (pw (suc n)) x)) : Tr.Trunc[CA.InFM p g x].carrier =
      let { lam : CA.Vec (suc k) = snoc (Fin k) A.R (\ i -> A.neg (mu.1 i)) x ;
            slam : CA.Syz (suc k) (fam n) lam =
              calc A.R { A.add (A.mul x (pw (suc n))) (RSA.comb k (\ i -> A.neg (mu.1 i)) a)
                           =< ap (A.add (A.mul x (pw (suc n)))) (trans (RSA.comb-neg k mu.1 a) (ap A.neg mu.2))
                           > A.add (A.mul x (pw (suc n))) (A.neg (A.mul (pw (suc n)) x))
                           =< ap (\ t -> A.add t (A.neg (A.mul (pw (suc n)) x))) (A.mulC x (pw (suc n)))
                           > A.add (A.mul (pw (suc n)) x) (A.neg (A.mul (pw (suc n)) x))
                           =< A.addN (A.mul (pw (suc n)) x) > A.z } } in
      Tr.Trunc[CA.InFV (suc k) p gs lam].induction @l (\ t -> Tr.Trunc[CA.InFM p g x].carrier)
        (\ t -> Tr.Trunc[CA.InFM p g x].proposition)
        (\ dd -> Tr.Trunc[CA.InFM p g x].inc (dd.1,
           trans (sym (FA.comb-at p dd.1 gs (inr tt))) (ap (\ v -> v (inr tt)) dd.2)))
        (un lam slam) ;
    gen-in (x : A.R) (h : I (suc n) x) : Tr.Trunc[CA.InFM p g x].carrier =
      Tr.Trunc[CA.InFM k a (A.mul (pw (suc n)) x)].induction @l (\ t -> Tr.Trunc[CA.InFM p g x].carrier)
        (\ t -> Tr.Trunc[CA.InFM p g x].proposition) (\ mu -> gen-at x mu) h ;
  } ;

  ------------------------------------------------------------------------
  -- stab, by the principle of free lists

  Phi (s : List A.R) : U l = (n : Nat) -> ((x : A.R) -> MS.Mm s x -> I n x) -> Stab ;
  phi-prop (s : List A.R) : Pr.isProp (Phi s) =
    FE.isProp-Pi Nat (\ n -> ((x : A.R) -> MS.Mm s x -> I n x) -> Stab)
      (\ n -> FE.isProp-Pi ((x : A.R) -> MS.Mm s x -> I n x) (\ h -> Stab) (\ h -> stab-prop)) ;

  module Step (dA : CA.Disc) (s : List A.R) (hyp : (x : A.R) -> Not (SP.In s x) -> Phi (cons x s))
    (n : Nat) (sub : (x : A.R) -> MS.Mm s x -> I n x) (p : Nat) (gs : Fin p -> CA.Vec (suc k))
    (sa : CA.SyzAll (suc k) (fam n) p gs) (un : CA.Univ (suc k) (fam n) p gs) {
    module GN = Gens[n,p,gs,sa,un] ;
    all-in (all : (j : Fin p) -> MS.Mm s (GN.g j)) : Stab =
      Tr.Trunc[(K : Nat) * ((x : A.R) -> I (suc K) x -> I K x)].inc (n, \ x h ->
        Tr.Trunc[CA.InFM p GN.g x].induction @l (\ t -> I n x) (\ t -> i-prop n x)
          (\ dd -> sub x (SO.mm-cong s (RSA.comb p dd.1 GN.g) x dd.2 (SO.mm-comb s p dd.1 GN.g all)))
          (GN.gen-in x h)) ;
    -- span (g_j :: s) is in I (n+1)
    sub-cons (j : Fin p) (y : A.R) (h : MS.Mm (cons (GN.g j) s) y) : I (suc n) y =
      MS.mm-rec (cons (GN.g j) s) y (I (suc n) y) (i-prop (suc n) y)
        (\ e -> i-cong (suc n) (A.add (A.add y (A.neg (A.mul e.1 (GN.g j)))) (A.mul e.1 (GN.g j))) y
                  (MS.sub-add y (A.mul e.1 (GN.g j)))
                  (i-add (suc n) (A.add y (A.neg (A.mul e.1 (GN.g j)))) (A.mul e.1 (GN.g j))
                     (i-suc n (A.add y (A.neg (A.mul e.1 (GN.g j))))
                        (sub (A.add y (A.neg (A.mul e.1 (GN.g j)))) (MS.mm s (A.add y (A.neg (A.mul e.1 (GN.g j)))) e.2)))
                     (i-sm (suc n) e.1 (GN.g j) (GN.g-in j))))
        h ;
    one-out (jn : (j : Fin p) * Not (MS.Mm s (GN.g j))) : Stab =
      hyp (GN.g jn.1) (\ i -> jn.2 (MS.mm s (GN.g jn.1) i)) (suc n) (sub-cons jn.1) ;
    result : Saturation[l].AllOr p (\ j -> MS.Mm s (GN.g j)) -> Stab = split {
      inl all -> all-in all ;
      inr jn -> one-out jn } ;
    stab : Stab = result (Saturation[l].all-or p (\ j -> MS.Mm s (GN.g j)) (\ j -> MS.dec-list dA s (GN.g j))) ;
  } ;

  step (dA : CA.Disc) (cA : CA.Coh) (s : List A.R) (fs : SP.Free s) (hyp : (x : A.R) -> Not (SP.In s x) -> Phi (cons x s)) :
    Phi s = \ n sub ->
    Tr.Trunc[CA.CohW (suc k) (fam n)].induction @l (\ t -> Stab) (\ t -> stab-prop)
      (\ q -> Step[dA, s, hyp, n, sub, q.1, q.2.1, q.2.2.1, q.2.2.2].stab) (cA (suc k) (fam n)) ;

  stab (dA : CA.Disc) (cA : CA.Coh) (fl : CA.FL) : Stab =
    fl Phi phi-prop (step dA cA) nil tt zero
      (\ x h -> MS.mm-rec nil x (I zero x) (i-prop zero x) (\ e -> i-cong zero A.z x (sym e) (i-zero zero)) h) ;

  ------------------------------------------------------------------------
  -- reach and the decision

  module Reach (K : Nat) (st : (x : A.R) -> I (suc K) x -> I K x) {
    down : (j : Nat) (x : A.R) -> I (plus j K) x -> I K x = split {
      zero -> \ x h -> h ;
      suc j | r -> \ x h -> st x (i-unshift K x (r (A.mul c x) (i-shift (plus j K) x h))) } ;
    up : (j : Nat) (t : Nat) (x : A.R) -> I t x -> I (plus j t) x = split {
      zero -> \ t x h -> h ;
      suc j | r -> \ t x h -> i-suc (plus j t) x (r t x h) } ;
    reach (t : Nat) (x : A.R) (h : I t x) : I K x =
      down t x (subst {Nat} (\ m -> I m x) {plus K t} {plus t K} (plus-comm K t) (up K t x h)) ;
  } ;

  Inf (x : A.R) : U l = Tr.Trunc[(t : Nat) * I t x].carrier ;
  inf-prop (x : A.R) : Pr.isProp (Inf x) = Tr.Trunc[(t : Nat) * I t x].proposition ;

  decide-at (K : Nat) (st : (x : A.R) -> I (suc K) x -> I K x) (x : A.R) :
    Plus (I K x) (Not (I K x)) -> Plus (Inf x) (Not (Inf x)) = split {
    inl h -> inl (Tr.Trunc[(t : Nat) * I t x].inc (K, h)) ;
    inr nh -> inr (\ hi -> Tr.Trunc[(t : Nat) * I t x].induction @l (\ w -> Empty) (\ w -> Coherent[l].empty-prop)
                      (\ th -> nh (Reach[K,st].reach th.1 x th.2)) hi) } ;

  dec-inf (dA : CA.Disc) (cA : CA.Coh) (fl : CA.FL) (x : A.R) : Plus (Inf x) (Not (Inf x)) =
    Tr.Trunc[(K : Nat) * ((x' : A.R) -> I (suc K) x' -> I K x')].induction @l (\ w -> Plus (Inf x) (Not (Inf x)))
      (\ w -> Coherent[l].dec-prop (Inf x) (inf-prop x))
      (\ ks -> decide-at ks.1 ks.2 x (dA k a (A.mul (pw ks.1) x)))
      (stab dA cA fl) ;
} ;
