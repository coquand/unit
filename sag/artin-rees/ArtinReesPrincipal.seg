-- ArtinReesPrincipal.seg: Artin-Rees for a principal ideal (f) and a
-- finitely generated ideal J = (a_1..a_k) (artin-rees.tex, Prop. arp).
--
-- Informal proof.  J : f^t increases with t and merely stabilises at some
-- K (LocStable.stab); then J : f^t is in J : f^K for every t
-- (LocStable.Reach.reach).  Take c = K.  If x = f^(n+K) m is in J, then m
-- is in J : f^(n+K), so in J : f^K, and y = f^K m is in f^K R and in J,
-- with x = f^n y (decompose).  Conversely f^n y, for y = f^c m' in J, is
-- f^(n+c) m' and in J (compose).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;

module Over (K0 : U l) (A : CRing) (cfn : CFN[l].CFN[K0,A]) (k : Nat) (a : Fin k -> A.R) (f : A.R) {
  module LS = LocStable[l].Over[A,k,a,f] ;
  module AP = AffinePowers[l].Over[A] ;

  -- x in f^n R
  InP (n : Nat) (x : A.R) : U l = Tr.Trunc[(m : A.R) * Id A.R x (A.mul (LS.pw n) m)].carrier ;
  inp-prop (n : Nat) (x : A.R) : Pr.isProp (InP n x) = Tr.Trunc[(m : A.R) * Id A.R x (A.mul (LS.pw n) m)].proposition ;

  -- x = f^n y with y in f^c R and in J
  record Decomp (n c : Nat) (x : A.R) {
    y : A.R ;
    y-pow : InP c y ;
    y-in : LS.Mj y ;
    y-eq : Id A.R x (A.mul (LS.pw n) y) ;
  } ;
  -- the bound c of Artin-Rees, before n and x
  record Bound {
    c : Nat ;
    decomp (n : Nat) (x : A.R) : InP (plus n c) x -> LS.Mj x -> Tr.Trunc[Decomp[n,c,x]].carrier ;
  } ;

  -- f^(n+K) m = f^n (f^K m)
  pow-split (n K : Nat) (m : A.R) : Id A.R (A.mul (LS.pw (plus n K)) m) (A.mul (LS.pw n) (A.mul (LS.pw K) m)) =
    trans (ap (\ t -> A.mul t m) (AP.power-add f n K)) (sym (A.mulA (LS.pw n) (LS.pw K) m)) ;

  module FromStab (K : Nat) (st : (x : A.R) -> LS.I (suc K) x -> LS.I K x) {
    decompose-at (n : Nat) (x : A.R) (hj : LS.Mj x) (me : (m : A.R) * Id A.R x (A.mul (LS.pw (plus n K)) m)) :
      Decomp[n,K,x] =
      let { m : A.R = me.1 ;
            m-in : LS.I (plus n K) m = LS.mj-cong x (A.mul (LS.pw (plus n K)) m) me.2 hj } in
      mkDecomp n K x (A.mul (LS.pw K) m)
        (Tr.Trunc[(m' : A.R) * Id A.R (A.mul (LS.pw K) m) (A.mul (LS.pw K) m')].inc (m, refl (A.mul (LS.pw K) m)))
        (LS.Reach[K,st].reach (plus n K) m m-in)
        (trans me.2 (pow-split n K m)) ;
    bound : Bound = mkBound K (\ n x hx hj ->
      Tr.Trunc[(m : A.R) * Id A.R x (A.mul (LS.pw (plus n K)) m)].induction @l (\ w -> Tr.Trunc[Decomp[n,K,x]].carrier)
        (\ w -> Tr.Trunc[Decomp[n,K,x]].proposition)
        (\ me -> Tr.Trunc[Decomp[n,K,x]].inc (decompose-at n x hj me)) hx) ;
  } ;

  -- Prop. arp
  artin-rees : Tr.Trunc[Bound].carrier =
    Tr.Trunc[(K : Nat) * ((x : A.R) -> LS.I (suc K) x -> LS.I K x)].induction @l (\ w -> Tr.Trunc[Bound].carrier)
      (\ w -> Tr.Trunc[Bound].proposition)
      (\ ks -> Tr.Trunc[Bound].inc FromStab[ks.1, ks.2].bound)
      (LS.stab cfn.disc cfn.coh (CFN[l].fl K0 A cfn)) ;

  -- the easy inclusion: f^n (f^c R cap J) is in f^(n+c) R cap J
  compose (n c : Nat) (y : A.R) (hp : InP c y) (hj : LS.Mj y) : InP (plus n c) (A.mul (LS.pw n) y) * LS.Mj (A.mul (LS.pw n) y) =
    (Tr.Trunc[(m : A.R) * Id A.R y (A.mul (LS.pw c) m)].induction @l (\ w -> InP (plus n c) (A.mul (LS.pw n) y))
       (\ w -> inp-prop (plus n c) (A.mul (LS.pw n) y))
       (\ me -> Tr.Trunc[(m : A.R) * Id A.R (A.mul (LS.pw n) y) (A.mul (LS.pw (plus n c)) m)].inc (me.1,
          trans (ap (A.mul (LS.pw n)) me.2) (sym (pow-split n c me.1))))
       hp,
     LS.mj-sm (LS.pw n) y hj) ;
} ;
