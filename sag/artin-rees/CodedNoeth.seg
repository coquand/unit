-- CodedNoeth.seg: noetherianity carried by codes (artin-rees.tex, §4 (N)).
--
-- For a presentation P of R (Span.Pres: codes K, phi : K -> R) with
-- Coquand-Persson noetherianity (Good bars nil, combinations with code
-- coefficients) and phi surjective under truncation (Surj), the principle
-- of free lists holds for R as a module over itself (fl):
--   a code combination is an element combination (in-el), so a good code
--   list gives a good list of elements (good-el);
--   bar induction on code lists with Psi cs = "phi cs free -> Phi (phi cs)":
--   at a node, an element x outside the span is merely phi c, and Phi is a
--   proposition;
--   a list of elements is merely phi of a list of codes (lift).
-- NP K0 R: such a presentation whose codes are El K0 c for a code type
-- c : CT, built from the base K0 by lists (artin-rees-handoff.txt §10).
-- Only these code types occur: Hilbert's theorem goes from K to List K,
-- a quotient keeps the codes.  The code type is data, not a type in U l,
-- so NP K0 R is in U l (and not in U l+, as a Sigma over Span.Pres would be).
level l ; open Ring[l] ; open Presentations[l] ; open Bar[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

------------------------------------------------------------------------
-- code types

data CT = base | list (c : CT) ;
El (K0 : U l) : CT -> U l = split { base -> K0 ; list c | r -> List r } ;
el-base (K0 : U l) : Id (U l) (El K0 base) K0 = refl K0 ;
el-list (K0 : U l) (c : CT) : Id (U l) (El K0 (list c)) (List (El K0 c)) = refl (List (El K0 c)) ;

-- a presentation (Span.Pres) with its code type K fixed
record PresK (S : CRing) (K : U l) {
  phi : K -> S.R ;
  kz : K ;
  ko : K ;
  kadd : K -> K -> K ;
  kmul : K -> K -> K ;
  kneg : K -> K ;
  phi-z : Id S.R (phi kz) S.z ;
  phi-o : Id S.R (phi ko) S.o ;
  phi-add (x y : K) : Id S.R (phi (kadd x y)) (S.add (phi x) (phi y)) ;
  phi-mul (x y : K) : Id S.R (phi (kmul x y)) (S.mul (phi x) (phi y)) ;
  phi-neg (x : K) : Id S.R (phi (kneg x)) (S.neg (phi x)) ;
} ;
pres (S : CRing) (K : U l) (P : PresK[S,K]) : Span[l].Pres[S] =
  Span[l].mkPres S K P.phi P.kz P.ko P.kadd P.kmul P.kneg P.phi-z P.phi-o P.phi-add P.phi-mul P.phi-neg ;
ofPres (S : CRing) (P : Span[l].Pres[S]) : PresK[S,P.K] =
  mkPresK S P.K P.phi P.kz P.ko P.kadd P.kmul P.kneg P.phi-z P.phi-o P.phi-add P.phi-mul P.phi-neg ;

module Over (R : CRing) (P : Span[l].Pres[R]) {
  module SP = Span[l].Over[R,P] ; module MS = ModSpan[l].Over[R,IP.regular R] ;
  module CO = Coherent[l].Over[R,IP.regular R] ;
  K : U l = P.K ;
  phiL (cs : List K) : List R.R = LinIso[l].mapL K R.R P.phi cs ;

  in-el : (s : List K) (y : R.R) -> SP.In s y -> MS.In (phiL s) y = split {
    nil -> \ y h -> h ;
    cons t s | r -> \ y h -> (P.phi h.1, r (R.add y (R.neg (R.mul (P.phi h.1) (P.phi t)))) h.2) } ;
  good-elS (t : K) (s : List K) (r : SP.Good s -> MS.Good (phiL s)) : SP.Good (cons t s) -> MS.Good (phiL (cons t s)) = split {
    inl i -> inl (in-el s (P.phi t) i) ;
    inr g -> inr (r g) } ;
  good-el : (s : List K) -> SP.Good s -> MS.Good (phiL s) = split {
    nil -> \ g -> g ;
    cons t s | r -> good-elS t s r } ;

  down-valid : (t : Tree K) (s : List K) -> SP.G.Valid t s -> (x : K) -> SP.G.Bars (cons x s) = split {
    leaf -> \ s q x -> (leaf, inr q) ;
    node f | r -> \ s v x -> (f x, v x) } ;
  at : (s : List K) -> SP.Noeth -> SP.G.Bars s = split {
    nil -> \ b -> b ;
    cons x s | r -> \ b -> down-valid (r b).1 s (r b).2 x } ;

  Surj : U l = (x : R.R) -> Tr.Trunc[(c : K) * Id R.R (P.phi c) x].carrier ;
  Lift (s : List R.R) : U l = (cs : List K) * Id (List R.R) (phiL cs) s ;
  cons2 (x x' : R.R) (s s' : List R.R) (e : Id R.R x x') (e' : Id (List R.R) s s') : Id (List R.R) (cons x s) (cons x' s') =
    Pr.trans (List R.R) (cons x s) (cons x' s) (cons x' s')
      (Pr.ap R.R (List R.R) (\ z -> cons z s) x x' e) (Pr.ap (List R.R) (List R.R) (\ z -> cons x' z) s s' e') ;
  lift (surj : Surj) : (s : List R.R) -> Tr.Trunc[Lift s].carrier = split {
    nil -> Tr.Trunc[Lift nil].inc (nil, refl nil) ;
    cons x s | r -> Tr.Trunc[(c : K) * Id R.R (P.phi c) x].induction @l (\ t -> Tr.Trunc[Lift (cons x s)].carrier)
      (\ t -> Tr.Trunc[Lift (cons x s)].proposition)
      (\ ce -> Tr.Trunc[Lift s].induction @l (\ t -> Tr.Trunc[Lift (cons x s)].carrier) (\ t -> Tr.Trunc[Lift (cons x s)].proposition)
         (\ lc -> Tr.Trunc[Lift (cons x s)].inc (cons ce.1 lc.1, cons2 (P.phi ce.1) x (phiL lc.1) s ce.2 lc.2)) r)
      (surj x) } ;

  module FLc (surj : Surj) (nt : SP.Noeth) (Phi : List R.R -> U l) (pPhi : (s : List R.R) -> Pr.isProp (Phi s))
    (step : (s : List R.R) -> MS.Free s -> ((x : R.R) -> Not (MS.In s x) -> Phi (cons x s)) -> Phi s) {
    Psi (cs : List K) : U l = MS.Free (phiL cs) -> Phi (phiL cs) ;
    base (cs : List K) (g : SP.Good cs) : Psi cs = \ f -> absurd (Phi (phiL cs)) (MS.good-free (phiL cs) (good-el cs g) f) ;
    extend (cs : List K) (f : MS.Free (phiL cs)) (h : (c : K) -> Psi (cons c cs)) (x : R.R) (nx : Not (MS.In (phiL cs) x)) :
      Phi (cons x (phiL cs)) =
      Tr.Trunc[(c : K) * Id R.R (P.phi c) x].induction @l (\ t -> Phi (cons x (phiL cs))) (\ t -> pPhi (cons x (phiL cs)))
        (\ ce -> subst (\ y -> Phi (cons y (phiL cs))) ce.2
           (h ce.1 ((\ i -> nx (MS.in-tr (phiL cs) (P.phi ce.1) x ce.2 i)), f)))
        (surj x) ;
    ind (cs : List K) (h : (c : K) -> Psi (cons c cs)) : Psi cs = \ f -> step (phiL cs) f (extend cs f h) ;
    module I = SP.G.Ind[Psi, base, ind] ;
    codes (cs : List K) (f : MS.Free (phiL cs)) : Phi (phiL cs) = I.bars cs (at cs nt) f ;
    result (s : List R.R) (f : MS.Free s) : Phi s =
      Tr.Trunc[Lift s].induction @l (\ t -> Phi s) (\ t -> pPhi s)
        (\ lc -> subst Phi lc.2 (codes lc.1 (subst MS.Free (sym lc.2) f))) (lift surj s) ;
  } ;
  fl (surj : Surj) (nt : SP.Noeth) : CO.FL = \ Phi pPhi step -> FLc[surj, nt, Phi, pPhi, step].result ;
} ;

NP (K0 : U l) (R : CRing) : U l =
  (c : CT) * (P : PresK[R, El K0 c]) * (Span[l].Over[R, pres R (El K0 c) P].Noeth * Over[R, pres R (El K0 c) P].Surj) ;
