-- HilbertCFN.seg: if A is CFN then A[X] is CFN (artin-rees.tex, Thm. 11).
--
-- (D): HilbertD.  (C): HilbertC.  Both use the principle of free lists of
-- A, obtained from its codes (CFN.fl).
-- (N): the codes of A (El K0 c), carried to A[X] along the constants
-- (Transfer, same codes), give the polynomial codes (El K0 (list c)) of Coquand-Persson's Hilbert theorem
-- (Hilbert.hilbert, PolyPres).  They are surjective under truncation: a
-- representative a_0 + X (a_1 + ...) of an element has its coefficients
-- merely coded, and evL of the codes is the element (horner); ev (rev cs)
-- = evL cs.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) {
  module PCo = PolyCoef[l].Over[A,setA] ;
  module E = PCo.E ;
  S : CRing = PCo.S ;
  module CN = CodedNoeth[l] ;
  module CA = Coherent[l].Over[A,IP.regular A] ;
  module CS = Coherent[l].Over[S,IP.regular S] ;

  ------------------------------------------------------------------------
  -- (N)

  module NoethS (c : CN.CT) (P0 : CN.PresK[A, CN.El K0 c])
    (nt : Span[l].Over[A, CN.pres A (CN.El K0 c) P0].Noeth) (surj : CN.Over[A, CN.pres A (CN.El K0 c) P0].Surj) {
    P : Span[l].Pres[A] = CN.pres A (CN.El K0 c) P0 ;
    module TF = Transfer[l].Over[A,S,E.constant,refl E.oneQ,E.constant-add,E.constant-mul,P] ;
    P1 : Span[l].Pres[S] = TF.image ;
    module PP = PolyPres[l].Over[S,P1,E.variable] ;
    module HB = Hilbert[l].Over[S,P1,E.variable] ;
    noeth : Span[l].Over[S,PP.pres].Noeth = HB.hilbert (TF.noeth nt) ;

    LC (p : List A.R) : U l = (cs : List P.K) * Id S.R (PP.evL cs) (E.include p) ;
    lc-step (a : A.R) (p : List A.R) (ce : (c : P.K) * Id A.R (P.phi c) a) (x : LC p) : LC (cons a p) =
      (cons ce.1 x.1,
       trans (trans (ap (\ z -> E.addQ (E.constant z) (E.mulQ E.variable (PP.evL x.1))) ce.2)
                    (ap (\ z -> E.addQ (E.constant a) (E.mulQ E.variable z)) x.2))
         (sym (E.horner a p))) ;
    lc : (p : List A.R) -> Tr.Trunc[LC p].carrier = split {
      nil -> Tr.Trunc[LC nil].inc (nil, refl E.zeroQ) ;
      cons a p | r -> Tr.Trunc[(c : P.K) * Id A.R (P.phi c) a].induction @l (\ t -> Tr.Trunc[LC (cons a p)].carrier)
        (\ t -> Tr.Trunc[LC (cons a p)].proposition)
        (\ ce -> Tr.Trunc[LC p].induction @l (\ t -> Tr.Trunc[LC (cons a p)].carrier) (\ t -> Tr.Trunc[LC (cons a p)].proposition)
           (\ x -> Tr.Trunc[LC (cons a p)].inc (lc-step a p ce x)) r)
        (surj a) } ;
    Code (x : S.R) : U l = (c : List P.K) * Id S.R (PP.ev c) x ;
    surjS : CN.Over[S,PP.pres].Surj = \ x ->
      E.Q.induction @l (\ y -> Tr.Trunc[Code y].carrier) (\ y -> Tr.Trunc[Code y].proposition)
        (\ p -> Tr.Trunc[LC p].induction @l (\ t -> Tr.Trunc[Code (E.include p)].carrier) (\ t -> Tr.Trunc[Code (E.include p)].proposition)
           (\ y -> Tr.Trunc[Code (E.include p)].inc (PP.rev y.1, trans (PP.ev-rev y.1) y.2)) (lc p))
        x ;
    np : CN.NP K0 S = (list c, (CN.ofPres S PP.pres, (noeth, surjS))) ;
  } ;

  ------------------------------------------------------------------------
  -- Thm. 11

  module Of (c : CFN[l].CFN[K0,A]) {
    flA : CA.FL = CFN[l].fl K0 A c ;
    module HD = HilbertD[l].Over[A,setA,c.disc,c.coh,flA] ;
    module HC = HilbertC[l].Over[A,setA,c.disc,c.coh,flA] ;
    noeth : Tr.Trunc[CN.NP K0 S].carrier =
      Tr.Trunc[CN.NP K0 A].induction @l (\ t -> Tr.Trunc[CN.NP K0 S].carrier) (\ t -> Tr.Trunc[CN.NP K0 S].proposition)
        (\ np -> Tr.Trunc[CN.NP K0 S].inc NoethS[np.1, np.2.1, np.2.2.1, np.2.2.2].np) c.noeth ;
    cfn : CFN[l].CFN[K0,S] = CFN[l].mkCFN K0 S HD.disc-S HC.coh-S noeth ;
  } ;
  poly (c : CFN[l].CFN[K0,A]) : CFN[l].CFN[K0,S] = Of[c].cfn ;
} ;
