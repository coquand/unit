-- Examples.seg: dialogue trees of small terms, computed.
--   t0 = K 3 : a leaf;  t1 = (alpha |-> alpha 2) : one query at 2.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Dialogue[l] ; open Models[l] ; open Brouwer[l] ; open Height[l] ;

num : Nat -> Tm = split { zero -> Zero ; suc n | r -> App iota Succ r } ;
has-num : (n : Nat) -> Has (num n) iota = split { zero -> refl iota ; suc n | r -> (refl nat2, r) } ;
three : Nat = suc (suc (suc zero)) ;
two : Nat = suc (suc zero) ;

-- t0 = K 3, of type (N -> N) -> N
t0 : Tm = App iota (K iota nat2) (num three) ;
h0 : Has t0 FT = (refl (kTy iota nat2), has-num three) ;
tree0 : Id (B Nat) (tree t0 h0) (eta three) = refl (eta three) ;
height0 : Id Br (height (tree t0 h0)) Zb = refl Zb ;

-- the identity I = S K K at type s
I (s : Ty) : Tm = App (kTy s s) (App (kTy s (arr s s)) (S s (arr s s) s) (K s (arr s s))) (K s s) ;
hI (s : Ty) : Has (I s) (arr s s) = ((refl (sTy s (arr s s) s), refl (kTy s (arr s s))), refl (kTy s s)) ;
-- t1 = S I (K 2), the functional alpha |-> alpha 2
t1 : Tm = App (arr nat2 iota) (App (arr nat2 nat2) (S nat2 iota iota) (I nat2)) (App iota (K iota nat2) (num two)) ;
h1 : Has t1 FT = ((refl (sTy nat2 iota iota), hI nat2), (refl (kTy iota nat2), has-num two)) ;
tree1 : Id (B Nat) (tree t1 h1) (beta (\ m -> eta m) two) = refl (beta (\ m -> eta m) two) ;
meaning1 (a : Baire) : Id Nat (meaning t1 h1 a) (a two) = refl (a two) ;
height1 : Id Br (height (tree t1 h1)) (Lb (\ n -> Sb Zb)) = refl (Lb (\ n -> Sb Zb)) ;
