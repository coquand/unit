-- Tuples.seg: graded tuples of ordinal data (Agda BrouwerOrdinals.MoveTuple).
--
-- A tuple of width n is a constant, an exponent, the exponent of that
-- exponent, and so on, grade 0 first, so that the tail is the tuple of the
-- higher grades.  An entry of grade i may only be moved by entries of grade
-- >= i (an exponent growing with the constant below it would leave eps0
-- under iteration, the iterates of x |-> w^x from 1 having supremum eps0).
-- Here: the tuples Tup n, their componentwise order leT (Agda ⊑, with the
-- width explicit), all entries below eps0 (AllLt, Agda All<), the sum of
-- the entries tsum, its monotonicity and its bound below eps0, and the cost
-- of a doubling,  X + X <= X * w.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ; open Affine[l] ;

-- Agda: Tup, tsum
Tup : Nat -> U l = split { zero -> Top ; suc n | r -> Br * r } ;
tsum : (n : Nat) -> Tup n -> Br = split {
  zero -> \ t -> Zb ;
  suc n | r -> \ t -> add t.1 (r t.2) } ;

-- Agda: _⊑_, ⊑-refl, ⊑-trans, All<
leT : (n : Nat) -> Tup n -> Tup n -> U l = split {
  zero -> \ t u -> Top ;
  suc n | r -> \ t u -> Le t.1 u.1 * r t.2 u.2 } ;
leT-refl : (n : Nat) -> (t : Tup n) -> leT n t t = split {
  zero -> \ t -> tt ;
  suc n | r -> \ t -> (le-refl t.1, r t.2) } ;
leT-trans : (n : Nat) -> (t u v : Tup n) -> leT n t u -> leT n u v -> leT n t v = split {
  zero -> \ t u v p q -> tt ;
  suc n | r -> \ t u v p q -> (le-trans t.1 u.1 v.1 p.1 q.1, r t.2 u.2 v.2 p.2 q.2) } ;
AllLt : (n : Nat) -> Tup n -> U l = split {
  zero -> \ t -> Top ;
  suc n | r -> \ t -> Lt t.1 eps0 * r t.2 } ;

-- Agda: tsum-mono, tsum-<-ε₀
tsum-mono : (n : Nat) -> (t u : Tup n) -> leT n t u -> Le (tsum n t) (tsum n u) = split {
  zero -> \ t u p -> tt ;
  suc n | r -> \ t u p -> add-mono t.1 u.1 (tsum n t.2) (tsum n u.2) p.1 (r t.2 u.2 p.2) } ;
tsum-lt-eps0 : (n : Nat) -> (t : Tup n) -> AllLt n t -> Lt (tsum n t) eps0 = split {
  zero -> \ t p -> Z-lt-eps0 ;
  suc n | r -> \ t p -> add-lt-eps0 t.1 (tsum n t.2) p.1 (r t.2 p.2) } ;

-- Agda: dup-ω
dup-omega (X : Br) : Le (add X X) (mul X omega) =
  substH (\ z -> Le z (mul X omega)) (mul-two X) (mul-mono-right X two omega (num-le-omega (suc (suc zero)))) ;
