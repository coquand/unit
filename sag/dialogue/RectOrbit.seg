-- RectOrbit.seg: iterating an action read from a datum (Agda
-- BrouwerOrdinals.RectOrbitAct), the clause for the recursor.
--
-- For an input u dominating (in the prefix order) a datum d of width
-- WD p p and a start x, every iterate of the square action read from d,
-- started at x, is below the action at u of one datum rorbitD n p
-- (rorbit-act).  By induction on the widths: the tail of an iterate is the
-- iterate of the tail action (rtail-iter), below the datum one order down;
-- the head grows by at most one move (Moves.seg) per step, the move with
-- constant T + E0 and exponent S X (T the sum and X the exponent value of
-- that lower datum), so all heads are below its orbit at x (move-orbit-rec);
-- this orbit is below the value at u of the cascade (1, orbEI): the
-- constant of the move is a finite multiple of M = (u0 + tsum u + 1) *
-- w^VT, and the exponent S((S X * w) * w) is absorbed by the successor,
-- two bumps and a successor of the cascade ssh dominating X, joined with
-- the sum cascade VT.
--
-- Deviations: Agda iter is Models.iterN.  The exponent bound X <= VX of
-- the Agda (valSc-⊑ then valSc-ssh) and the steps of the head bound are
-- as in the Agda; a <= M and E0 <= M share u0 <= M (uM).  Agda's ≤-S ≤-Z
-- (1 <= S a) is tt.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ;
open MultClosure[l] ; open Affine[l] ; open Moves[l] ; open Tuples[l] ; open Cascade[l] ; open Rect[l] ;
open RectAlgebra[l] ; open RectApply[l] ;

------------------------------------------------------------------------
-- the orbit datum

-- Agda: orbEI
orbEI (n p : Nat) (D : RD n p) : Sc n =
  joinSc n (sumRD n p D) (sucSc n (bumpSc n (bumpSc n (sucSc n (ssh n p (zeroRD n (suc p)) D))))) ;

-- Agda: rorbitD
rorbitD : (n : Nat) -> (p : Nat) -> RD n p = split {
  zero -> zeroRD zero ;
  suc n | r -> split {
    zero -> tt ;
    suc p -> ((one, orbEI n p (r p)), r p) } } ;

-- Agda: orbEI-All<
orbEI-AllLt (n p : Nat) (D : RD n p) (h : RDAllLt n p D) : ScAllLt n (orbEI n p D) =
  joinSc-AllLt n (sumRD n p D) (sucSc n (bumpSc n (bumpSc n (sucSc n (ssh n p (zeroRD n (suc p)) D)))))
    (sumRD-AllLt n p D h)
    (sucSc-AllLt n (bumpSc n (bumpSc n (sucSc n (ssh n p (zeroRD n (suc p)) D))))
      (bumpSc-AllLt n (bumpSc n (sucSc n (ssh n p (zeroRD n (suc p)) D)))
        (bumpSc-AllLt n (sucSc n (ssh n p (zeroRD n (suc p)) D))
          (sucSc-AllLt n (ssh n p (zeroRD n (suc p)) D)
            (ssh-AllLt n p (zeroRD n (suc p)) D (zeroRD-AllLt n (suc p)) h))))) ;

-- Agda: rorbitD-All<
rorbitD-AllLt : (n : Nat) -> (p : Nat) -> RDAllLt n p (rorbitD n p) = split {
  zero -> zeroRD-AllLt zero ;
  suc n | r -> split {
    zero -> tt ;
    suc p -> ((S-lt-eps0 Zb Z-lt-eps0, orbEI-AllLt n p (rorbitD n p) (r p)), r p) } } ;

------------------------------------------------------------------------
-- iterating

-- Agda: rtail-iter
rtail-iter (k : Nat) (d : Tup (WD (suc k) (suc k))) (x : Tup (suc k)) : (n : Nat)
  -> Id (Tup k) (Models[l].iterN (Tup (suc k)) (rect (suc k) (suc k) (rdOf (suc k) (suc k) d)) x n).2
                (Models[l].iterN (Tup k) (rect k k (rdOf k k d.2)) x.2 n) = split {
  zero -> refl x.2 ;
  suc n | r -> apH (rect k k (rdOf k k d.2)) r } ;

-- Agda: rorbit-act (the case of positive widths)
rorbit-step (n k : Nat) (d : Tup (WD (suc k) (suc k))) (x : Tup (suc k)) (u : Tup (suc n))
  (hu : AllLt (suc n) u) (hd : leInit (WD (suc k) (suc k)) (suc n) d u) (hx : leInit (suc k) (suc n) x u)
  (tbd : (j : Nat) -> leT k (Models[l].iterN (Tup k) (rect k k (rdOf k k d.2)) x.2 j) (rect n k (rorbitD n k) u.2))
  (j : Nat)
  : leT (suc k) (Models[l].iterN (Tup (suc k)) (rect (suc k) (suc k) (rdOf (suc k) (suc k) d)) x j)
      (rect (suc n) (suc k) (rorbitD (suc n) (suc k)) u) =
  (le-trans (hdf j) (img (orbit mv) x.1) (valSc (suc n) (one, orbEI n k (rorbitD n k)) u) (hbd j) fin, tl j)
 where {
   R : Tup (suc k) -> Tup (suc k) = rect (suc k) (suc k) (rdOf (suc k) (suc k) d) ;
   it (i : Nat) : Tup (suc k) = Models[l].iterN (Tup (suc k)) R x i ;
   E : Sc (suc k) = tupToSc (suc k) (pre (suc (suc k)) (suc k) d) ;
   dA : AllLt (WD (suc k) (suc k)) d = leInit-AllLt (WD (suc k) (suc k)) (suc n) d u hd hu ;
   Ep : ScAllLt (suc k) E = tupToSc-AllLt (suc k) (pre (suc (suc k)) (suc k) d) (pre-AllLt (suc (suc k)) (suc k) d dA) ;
   Dt : Tup k = rect n k (rorbitD n k) u.2 ;
   DtA : AllLt k Dt = rect-AllLt n k (rorbitD n k) u.2 (rorbitD-AllLt n k) hu.2 ;
   tl (i : Nat) : leT k (it i).2 Dt = substH (\ z -> leT k z Dt) (symH (rtail-iter k d x i)) (tbd i) ;
   T : Br = tsum k Dt ;
   T-lt : Lt T eps0 = tsum-lt-eps0 k Dt DtA ;
   X : Br = valSc k E.2 Dt ;
   X-lt : Lt X eps0 = valSc-lt-eps0 k E.2 Dt Ep.2 DtA ;
   mv : Move = padMove (add T E.1) (Sb X) (add-lt-eps0 T E.1 T-lt Ep.1) tt (S-lt-eps0 X X-lt) ;
   hdf (i : Nat) : Br = (it i).1 ;
   padle (y : Br) : Le y (mul (Sb y) omega) = le-trans y (Sb y) (mul (Sb y) omega) (S-increasing y) (le-mul-right (Sb y) omega omega-pos) ;
   base (i : Nat) : Le (add (add (hdf i) (tsum k (it i).2)) E.1) (add (hdf i) (add T E.1)) =
     substH (\ z -> Le (add (add (hdf i) (tsum k (it i).2)) E.1) z) (add-assoc (hdf i) T E.1)
       (add-mono-left (add (hdf i) (tsum k (it i).2)) (add (hdf i) T)
         (add-mono-right (hdf i) (tsum k (it i).2) T (tsum-mono k (it i).2 Dt (tl i))) E.1) ;
   step (i : Nat) : Le (hdf (suc i)) (img mv (hdf i)) =
     le-trans (hdf (suc i)) (mul (add (hdf i) (add T E.1)) (wexp (valSc k E.2 (it i).2))) (img mv (hdf i))
       (mul-mono-left (add (add (hdf i) (tsum k (it i).2)) E.1) (add (hdf i) (add T E.1)) (base i) (wexp (valSc k E.2 (it i).2)))
       (mul-mono-right (add (hdf i) (add T E.1)) (wexp (valSc k E.2 (it i).2)) (wexp (mul (Sb X) omega))
         (wexp-mono (valSc k E.2 (it i).2) (mul (Sb X) omega)
           (le-trans (valSc k E.2 (it i).2) X (mul (Sb X) omega) (valSc-mono k E.2 (it i).2 Dt (tl i)) (padle X)))) ;
   hbd (i : Nat) : Le (hdf i) (img (orbit mv) x.1) = move-orbit-rec mv hdf x.1 (le-refl x.1) step i ;
   VT : Br = valSc n (sumRD n k (rorbitD n k)) u.2 ;
   T-le : Le T VT = tsum-rect n k (rorbitD n k) u.2 ;
   Dd : RD n (suc k) = zeroRD n (suc k) ;
   dpre-le : leT (suc k) (pre (suc k) k d.2) (rect n (suc k) Dd u.2) =
     rect-leInit n (suc k) u.2 (pre (suc k) k d.2)
       (leInit-trans (suc k) (maxN (suc k) k) n (pre (suc k) k d.2) d.2 u.2 (pre-leInit (suc k) k d.2) hd.2) ;
   Ex : Sc n = ssh n k Dd (rorbitD n k) ;
   VX : Br = valSc n Ex u.2 ;
   X-le : Le X VX =
     le-trans X (valSc k (tupToSc k (rect n (suc k) Dd u.2)) Dt) VX
       (valSc-leSc k E.2 (tupToSc k (rect n (suc k) Dd u.2))
         (tupToSc-mono k (pre (suc k) k d.2) (rect n (suc k) Dd u.2) dpre-le) Dt)
       (valSc-ssh n k Dd (rorbitD n k) u.2) ;
   s : Br = add u.1 (tsum n u.2) ;
   A' : Br = add s one ;
   M : Br = mul A' (wexp VT) ;
   A'-le-M : Le A' M = le-mul-right A' (wexp VT) (one-le-wexp VT) ;
   uM : Le u.1 M = le-trans u.1 A' M (le-trans u.1 s A' (add-increasing-right u.1 (tsum n u.2)) (S-increasing s)) A'-le-M ;
   a-le-M : Le x.1 M = le-trans x.1 u.1 M hx.1 uM ;
   T-le-M : Le T M = le-trans T VT M T-le (le-trans VT (wexp VT) M (le-wexp VT) (le-mul-left A' (wexp VT) tt)) ;
   E0-le-M : Le E.1 M = le-trans E.1 u.1 M hd.1 uM ;
   A-fm : FinMult (add x.1 (add T E.1)) M =
     fm-add M x.1 (add T E.1) (fm-base M x.1 a-le-M) (fm-add M T E.1 (fm-base M T T-le-M) (fm-base M E.1 E0-le-M)) ;
   BB : Br = mul (mul (Sb X) omega) omega ;
   Eb : Sc n = sucSc n (bumpSc n (bumpSc n (sucSc n Ex))) ;
   v1 : Le (Sb VX) (valSc n (sucSc n Ex) u.2) = valSc-suc n Ex u.2 ;
   v2 : Le (mul (Sb VX) omega) (valSc n (bumpSc n (sucSc n Ex)) u.2) =
     le-trans (mul (Sb VX) omega) (mul (valSc n (sucSc n Ex) u.2) omega) (valSc n (bumpSc n (sucSc n Ex)) u.2)
       (mul-mono-left (Sb VX) (valSc n (sucSc n Ex) u.2) v1 omega) (valSc-bump n (sucSc n Ex) u.2) ;
   v3 : Le (mul (mul (Sb VX) omega) omega) (valSc n (bumpSc n (bumpSc n (sucSc n Ex))) u.2) =
     le-trans (mul (mul (Sb VX) omega) omega) (mul (valSc n (bumpSc n (sucSc n Ex)) u.2) omega)
       (valSc n (bumpSc n (bumpSc n (sucSc n Ex))) u.2)
       (mul-mono-left (mul (Sb VX) omega) (valSc n (bumpSc n (sucSc n Ex)) u.2) v2 omega)
       (valSc-bump n (bumpSc n (sucSc n Ex)) u.2) ;
   SBB-le : Le (Sb BB) (valSc n Eb u.2) =
     le-trans (Sb BB) (Sb (valSc n (bumpSc n (bumpSc n (sucSc n Ex))) u.2)) (valSc n Eb u.2)
       (le-trans BB (mul (mul (Sb VX) omega) omega) (valSc n (bumpSc n (bumpSc n (sucSc n Ex))) u.2)
         (mul-mono-left (mul (Sb X) omega) (mul (Sb VX) omega) (mul-mono-left (Sb X) (Sb VX) X-le omega) omega) v3)
       (valSc-suc n (bumpSc n (bumpSc n (sucSc n Ex))) u.2) ;
   expbd : Le (add VT (Sb BB)) (valSc n (orbEI n k (rorbitD n k)) u.2) =
     le-trans (add VT (Sb BB)) (add VT (valSc n Eb u.2)) (valSc n (orbEI n k (rorbitD n k)) u.2)
       (add-mono-right VT (Sb BB) (valSc n Eb u.2) SBB-le)
       (valSc-join n (sumRD n k (rorbitD n k)) Eb u.2) ;
   eqM : Id Br (mul M (wexp (Sb BB))) (mul A' (wexp (add VT (Sb BB)))) = calc Br {
     mul (mul A' (wexp VT)) (wexp (Sb BB)) =< mul-assoc A' (wexp VT) (wexp (Sb BB)) >
     mul A' (mul (wexp VT) (wexp (Sb BB))) =< apH (mul A') (wexp-mul VT (Sb BB)) >
     mul A' (wexp (add VT (Sb BB))) } ;
   fin : Le (img (orbit mv) x.1) (valSc (suc n) (one, orbEI n k (rorbitD n k)) u) =
     le-trans (img (orbit mv) x.1) (mul M (wexp (Sb BB))) (valSc (suc n) (one, orbEI n k (rorbitD n k)) u)
       (fm-mul M (add x.1 (add T E.1)) BB A-fm)
       (substH (\ z -> Le z (mul A' (wexp (valSc n (orbEI n k (rorbitD n k)) u.2)))) (symH eqM)
         (mul-mono-right A' (wexp (add VT (Sb BB))) (wexp (valSc n (orbEI n k (rorbitD n k)) u.2))
           (wexp-mono (add VT (Sb BB)) (valSc n (orbEI n k (rorbitD n k)) u.2) expbd))) ;
 } ;
-- Agda: rorbit-act
rorbit-act : (n : Nat) -> (p : Nat) -> (d : Tup (WD p p)) -> (x : Tup p) -> (u : Tup n)
  -> AllLt n u -> leInit (WD p p) n d u -> leInit p n x u
  -> (j : Nat) -> leT p (Models[l].iterN (Tup p) (rect p p (rdOf p p d)) x j) (rect n p (rorbitD n p) u) = split {
  zero -> split {
    zero -> \ d x u hu hd hx j -> tt ;
    suc k -> \ d x u hu hd hx j ->
      absurd (leT (suc k) (Models[l].iterN (Tup (suc k)) (rect (suc k) (suc k) (rdOf (suc k) (suc k) d)) x j)
                (rect zero (suc k) (rorbitD zero (suc k)) u)) hx } ;
  suc n | r -> split {
    zero -> \ d x u hu hd hx j -> tt ;
    suc k -> \ d x u hu hd hx -> rorbit-step n k d x u hu hd hx (r k d.2 x.2 u.2 hu.2 hd.2 hx.2) } } ;
