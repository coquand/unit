-- Brouwer.seg: Brouwer ordinal codes and their order.
-- Agda defines the order as an inductive family; Unit has none, so it is
-- defined by recursion, with the same meaning:
--   Z <= b;   L f <= b iff f n <= b for all n;
--   S a <= Z never;  S a <= S b iff a <= b;  S a <= L g iff S a <= g n for some n.
-- Reflexivity, transitivity, the upper bound f n <= L f, and addition
-- (by recursion on the second argument).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;

data Br = Zb | Sb (b : Br) | Lb (f : Nat -> Br) ;

le-S (r : Br -> U l) : Br -> U l = split { Zb -> Empty ; Sb b -> r b ; Lb g | s -> (n : Nat) * s n } ;
Le : Br -> Br -> U l = split {
  Zb -> \ b -> Top ;
  Sb a | r -> le-S r ;
  Lb f | rs -> \ b -> (n : Nat) -> rs n b } ;

-- a <= f n gives a <= L f
le-l : (a : Br) -> (f : Nat -> Br) -> (n : Nat) -> Le a (f n) -> Le a (Lb f) = split {
  Zb -> \ f n h -> tt ;
  Sb a -> \ f n h -> (n, h) ;
  Lb g | ih -> \ f n h m -> ih m f n (h m) } ;
le-refl : (a : Br) -> Le a a = split {
  Zb -> tt ;
  Sb a | r -> r ;
  Lb f | r -> \ n -> le-l (f n) f n (r n) } ;
upper (f : Nat -> Br) (n : Nat) : Le (f n) (Lb f) = le-l (f n) f n (le-refl (f n)) ;
le-L-mono (f g : Nat -> Br) (p : (n : Nat) -> Le (f n) (g n)) : Le (Lb f) (Lb g) = \ n -> le-l (f n) g n (p n) ;

-- transitivity, by induction on the three codes
trans-SS (a : Br) (ih : (b c : Br) -> Le a b -> Le b c -> Le a c) (b : Br)
  : (c : Br) -> Le (Sb a) (Sb b) -> Le (Sb b) c -> Le (Sb a) c = split {
  Zb -> \ p q -> absurd (Le (Sb a) Zb) q ;
  Sb c -> \ p q -> ih b c p q ;
  Lb g | rc -> \ p q -> (q.1, rc q.1 p q.2) } ;
trans-S (a : Br) (ih : (b c : Br) -> Le a b -> Le b c -> Le a c)
  : (b : Br) -> (c : Br) -> Le (Sb a) b -> Le b c -> Le (Sb a) c = split {
  Zb -> \ c p q -> absurd (Le (Sb a) c) p ;
  Sb b -> trans-SS a ih b ;
  Lb g | rb -> \ c p q -> rb p.1 c p.2 (q p.1) } ;
le-trans : (a : Br) -> (b c : Br) -> Le a b -> Le b c -> Le a c = split {
  Zb -> \ b c p q -> tt ;
  Sb a | ih -> trans-S a ih ;
  Lb f | ih -> \ b c p q n -> ih n b c (p n) q } ;

add (a : Br) : Br -> Br = split { Zb -> a ; Sb b | r -> Sb r ; Lb f | r -> Lb r } ;
