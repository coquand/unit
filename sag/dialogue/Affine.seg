-- Affine.seg: iterating  b |-> (b + c) * M  for a limit multiplier M, and
-- finite multiples (Agda BrouwerOrdinals.MultAffine and BrouwerOrdinals.Absorb).
--
-- MultAffine.  The fold  b*m + d <= (b + d)*m  fails for a limit multiplier
-- (1*w + 1 = w + 1 > w = 2*w), so the constant c is not moved out of the
-- product; the product is moved inward instead.  For M positive with
-- 2*M <= M:
--   crux:      c <= Y  gives  (Y + c)*M <= Y*M,  since Y + c <= Y + Y = Y*2
--              and Y*2*M = Y*(2*M) <= Y*M;
--   orbit-inv: the k-th iterate from a is below (a + c) * M^k  (pw M k),
--              by crux at Y = (a + c) * M^k, which is above c as M^k >= 1.
-- The multipliers used later are  w^(X*w)  with X >= 1; they absorb
-- doubling (dbl-wexp): 2 * w^(X*k) <= w * w^(X*k) = w^(1 + X*k) and
-- 1 + X*k <= S (X*k) <= X*(k+1).  Also (w^d)^k <= w^(d*k) (pw-wexp) and
-- n*w <= w.
--
-- Absorb.  x << M (FinMult x M): x is below some finite multiple M*k.  It
-- holds of x <= M, is closed under +, and  x << M  gives
-- x * w^e <= M * w^(S e)  (since k * w^e <= w^(S e)),  x <= M*w  and
-- x*w <= M*w.
--
-- Agda iter is Models.iterN; Agda ι⊕ (a sum of numerals is a numeral) is
-- Ordinals.num-plus, with the witness plusN.  New: mul-two (Y*2 = Y + Y,
-- the common step of crux and Tuples.dup-omega).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ; open MultClosure[l] ;

------------------------------------------------------------------------
-- powers of a multiplier

-- Agda: pw
pw (m : Br) : Nat -> Br = split { zero -> Sb Zb ; suc k | r -> mul r m } ;

-- Agda: pw-ω^
pw-wexp (d : Br) : (k : Nat) -> Le (pw (wexp d) k) (wexp (mul d (numB k))) = split {
  zero -> le-refl one ;
  suc k | r -> substH (\ z -> Le (pw (wexp d) (suc k)) z) (wexp-mul (mul d (numB k)) d)
    (mul-mono-left (pw (wexp d) k) (wexp (mul d (numB k))) r (wexp d)) } ;

-- Agda: ιn⊗ω-≤-ω
num-mul-omega-le (n : Nat) : Le (mul (numB n) omega) omega = \ j ->
  substH (\ x -> Le x omega) (symH (num-times n j)) (upper numB (timesN n j)) ;

-- Y * 2 = Y + Y
mul-two (Y : Br) : Id Br (mul Y two) (add Y Y) = apH (\ z -> add z Y) (Z-left-unit Y) ;

-- Agda: dbl-ω^ (and its per)
dbl-wexp-per (X : Br) (Xpos : Le one X) (k : Nat)
  : Le (mul two (wexp (mul X (numB k)))) (wexp (mul X omega)) =
  le-trans (mul two A) (mul omega A) (wexp (mul X omega)) step-a
    (substH (\ z -> Le z (wexp (mul X omega))) (symH step-b)
      (le-trans (wexp (add one (mul X (numB k)))) (wexp (mul X (numB (suc k)))) (wexp (mul X omega))
        step-c step-d))
 where {
   A : Br = wexp (mul X (numB k)) ;
   step-a : Le (mul two A) (mul omega A) = mul-mono-left two omega (upper numB (suc (suc zero))) A ;
   step-b : Id Br (mul omega A) (wexp (add one (mul X (numB k)))) = calc Br {
     mul omega A =< apH (\ z -> mul z A) (symH wexp-one) >
     mul (wexp one) A =< wexp-mul one (mul X (numB k)) >
     wexp (add one (mul X (numB k))) } ;
   exp-le : Le (add one (mul X (numB k))) (mul X (numB (suc k))) =
     le-trans (add one (mul X (numB k))) (Sb (mul X (numB k))) (add (mul X (numB k)) X)
       (one-add-le-S (mul X (numB k))) (add-mono-right (mul X (numB k)) one X Xpos) ;
   step-c : Le (wexp (add one (mul X (numB k)))) (wexp (mul X (numB (suc k)))) =
     wexp-mono (add one (mul X (numB k))) (mul X (numB (suc k))) exp-le ;
   step-d : Le (wexp (mul X (numB (suc k)))) (wexp (mul X omega)) =
     upper (\ j -> wexp (mul X (numB j))) (suc k) ;
 } ;
dbl-wexp (X : Br) (Xpos : Le one X) : Le (mul two (wexp (mul X omega))) (wexp (mul X omega)) =
  dbl-wexp-per X Xpos ;

------------------------------------------------------------------------
-- a positive multiplier absorbing doubling

module LimitMult (M : Br) (Mpos : Le one M) (dbl : Le (mul two M) M) {

  -- Agda: crux
  crux (Y c : Br) (cY : Le c Y) : Le (mul (add Y c) M) (mul Y M) =
    le-trans (mul (add Y c) M) (mul (mul Y two) M) (mul Y M)
      (mul-mono-left (add Y c) (mul Y two) step12 M) final
   where {
     step12 : Le (add Y c) (mul Y two) =
       substH (\ z -> Le (add Y c) z) (symH (mul-two Y)) (add-mono-right Y c Y cY) ;
     final : Le (mul (mul Y two) M) (mul Y M) =
       substH (\ z -> Le z (mul Y M)) (symH (mul-assoc Y two M)) (mul-mono-right Y (mul two M) M dbl) ;
   } ;

  -- Agda: mbody, pw-pos
  mbody (c b : Br) : Br = mul (add b c) M ;
  pw-pos : (k : Nat) -> Le one (pw M k) = split {
    zero -> le-refl one ;
    suc k | r -> le-trans one (pw M k) (mul (pw M k) M) r
      (substH (\ z -> Le z (mul (pw M k) M)) (Z-left-unit (pw M k)) (mul-mono-right (pw M k) one M Mpos)) } ;

  -- Agda: orbit-inv (the successor case)
  orbit-step (a c : Br) (k : Nat) (r : Le (Models[l].iterN Br (mbody c) a k) (mul (add a c) (pw M k)))
    : Le (mbody c (Models[l].iterN Br (mbody c) a k)) (mul (add a c) (pw M (suc k))) =
    substH (\ z -> Le (mbody c (Models[l].iterN Br (mbody c) a k)) z) (mul-assoc (add a c) (pw M k) M)
      (le-trans (mbody c (Models[l].iterN Br (mbody c) a k)) (mul (add Y c) M) (mul Y M) body-mono (crux Y c cY))
   where {
     Y : Br = mul (add a c) (pw M k) ;
     body-mono : Le (mbody c (Models[l].iterN Br (mbody c) a k)) (mul (add Y c) M) =
       mul-mono-left (add (Models[l].iterN Br (mbody c) a k) c) (add Y c)
         (add-mono-left (Models[l].iterN Br (mbody c) a k) Y r c) M ;
     cY : Le c Y = le-trans c (add a c) Y (add-increasing-left a c)
       (substH (\ z -> Le z Y) (Z-left-unit (add a c)) (mul-mono-right (add a c) one (pw M k) (pw-pos k))) ;
   } ;
  -- Agda: orbit-inv
  orbit-inv (a c : Br) : (k : Nat) -> Le (Models[l].iterN Br (mbody c) a k) (mul (add a c) (pw M k)) = split {
    zero -> substH (\ z -> Le a z) (symH (Z-left-unit (add a c))) (add-increasing-right a c) ;
    suc k | r -> orbit-step a c k r } ;
} ;

-- Agda: ω-pos
omega-pos : Le one omega = upper numB (suc zero) ;

------------------------------------------------------------------------
-- finite multiples

-- Agda: ι⊗ω^
num-mul-wexp (k : Nat) : (e : Br) -> Le (mul (numB k) (wexp e)) (wexp (Sb e)) = split {
  Zb -> substH (\ z -> Le (add Zb (numB k)) z) (symH (one-mul omega))
          (substH (\ z -> Le z omega) (symH (Z-left-unit (numB k))) (num-le-omega k)) ;
  Sb e | r -> substH (\ z -> Le z (mul (wexp (Sb e)) omega)) (mul-assoc (numB k) (wexp e) omega)
          (mul-mono-left (mul (numB k) (wexp e)) (wexp (Sb e)) r omega) ;
  Lb f | r -> \ n -> le-trans (mul (numB k) (wexp (f n))) (wexp (Sb (f n))) (wexp (Sb (Lb f))) (r n)
          (mul-mono-left (wexp (f n)) (wexp (Lb f)) (upper (\ m -> wexp (f m)) n) omega) } ;

-- Agda: _⋖_, ⋖-base, ⋖-⊕
FinMult (x M : Br) : U l = (k : Nat) * Le x (mul M (numB k)) ;
fm-base (M x : Br) (p : Le x M) : FinMult x M =
  (suc zero, substH (\ z -> Le x z) (symH (Z-left-unit M)) p) ;
fm-add (M x y : Br) (hx : FinMult x M) (hy : FinMult y M) : FinMult (add x y) M =
  (plusN hx.1 hy.1,
   substH (\ z -> Le (add x y) (mul M z)) (symH (num-plus hx.1 hy.1))
     (substH (\ z -> Le (add x y) z) (symH (mul-left-distrib M (numB hx.1) (numB hy.1)))
       (add-mono x (mul M (numB hx.1)) y (mul M (numB hy.1)) hx.2 hy.2))) ;

-- Agda: ⋖-⊗
fm-mul (M x e : Br) (h : FinMult x M) : Le (mul x (wexp e)) (mul M (wexp (Sb e))) =
  le-trans (mul x (wexp e)) (mul (mul M (numB h.1)) (wexp e)) (mul M (wexp (Sb e)))
    (mul-mono-left x (mul M (numB h.1)) h.2 (wexp e))
    (substH (\ z -> Le z (mul M (wexp (Sb e)))) (symH (mul-assoc M (numB h.1) (wexp e)))
      (mul-mono-right M (mul (numB h.1) (wexp e)) (wexp (Sb e)) (num-mul-wexp h.1 e))) ;

-- Agda: ⋖-⊗ω, ⋖-ω
fm-le-omega (M x : Br) (h : FinMult x M) : Le x (mul M omega) =
  le-trans x (mul M (numB h.1)) (mul M omega) h.2 (mul-mono-right M (numB h.1) omega (num-le-omega h.1)) ;
fm-omega (M x : Br) (h : FinMult x M) : Le (mul x omega) (mul M omega) =
  le-trans (mul x omega) (mul (mul M (numB h.1)) omega) (mul M omega)
    (mul-mono-left x (mul M (numB h.1)) h.2 omega)
    (substH (\ z -> Le z (mul M omega)) (symH (mul-assoc M (numB h.1) omega))
      (mul-mono-right M (mul (numB h.1) omega) omega (num-mul-omega-le h.1))) ;
