-- Epsilon0.seg: base-omega exponentiation, the tower, epsilon_0 and the
-- strict order, and the closure of epsilon_0 (Agda BrouwerOrdinals.Epsilon0).
--
-- wexp a = omega^a:  w^0 = 1,  w^(S a) = w^a * w,  w^(L f) = L (w^(f n));
-- tower 0 = w,  tower (n+1) = w^(tower n);  eps0 = L tower;  a < b  is
-- S a <= b.
--
-- add a, mul a and wexp are monotone in their argument by one generic
-- lemma (MonoRight): a map F commuting with limits by definition, with
-- F 0 <= F c and F a <= F b => F (S a) <= F (S b), is monotone (the Agda
-- proves the three by the same induction on the derivation of b <= c).
-- The tower is strictly increasing: S (tower n) <= w^(tower n), by descent
-- to the base w < w^w through  S (w^a) <= w^a + w^a <= w^a * w.
-- A code below eps0 is below some level  tower j  (the second component
-- of  S a <= L tower  is  S a <= tower j); two such are pushed to a common
-- level by max, and an operation F, monotone in both arguments with
-- F (tower n) (tower n) <= tower (n+1), stays below eps0 (Closure2;
-- instances: add here, mul in MultClosure).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ;

-- Agda: S-increasing
S-increasing : (a : Br) -> Le a (Sb a) = split {
  Zb -> tt ;
  Sb a | r -> r ;
  Lb f | r -> \ n -> le-trans (f n) (Sb (f n)) (Sb (Lb f)) (r n) (upper f n) } ;

-- Agda: ⊕-increasing-right
add-increasing-right (a : Br) : (b : Br) -> Le a (add a b) = split {
  Zb -> le-refl a ;
  Sb b | r -> le-trans a (add a b) (Sb (add a b)) r (S-increasing (add a b)) ;
  Lb f | r -> le-l a (\ n -> add a (f n)) zero (r zero) } ;

-- monotonicity of a map commuting with limits
module MonoRight (F : Br -> Br)
    (z : (c : Br) -> Le (F Zb) (F c))
    (s : (a b : Br) -> Le (F a) (F b) -> Le (F (Sb a)) (F (Sb b)))
    (lim-left : (f : Nat -> Br) (c : Br) -> ((n : Nat) -> Le (F (f n)) c) -> Le (F (Lb f)) c)
    (lim-right : (x : Br) (f : Nat -> Br) (n : Nat) -> Le x (F (f n)) -> Le x (F (Lb f))) {
  mono-S (a : Br) (ih : (c : Br) -> Le a c -> Le (F a) (F c))
    : (c : Br) -> Le (Sb a) c -> Le (F (Sb a)) (F c) = split {
    Zb -> \ p -> absurd (Le (F (Sb a)) (F Zb)) p ;
    Sb c -> \ p -> s a c (ih c p) ;
    Lb g | r -> \ p -> lim-right (F (Sb a)) g p.1 (r p.1 p.2) } ;
  mono : (b : Br) -> (c : Br) -> Le b c -> Le (F b) (F c) = split {
    Zb -> \ c p -> z c ;
    Sb a | ih -> mono-S a ih ;
    Lb f | ih -> \ c p -> lim-left f (F c) (\ n -> ih n c (p n)) } ;
} ;

-- Agda: ⊕-mono-right
add-mono-right (a : Br) : (b c : Br) -> Le b c -> Le (add a b) (add a c) =
  MonoRight[add a, add-increasing-right a, \ x y p -> p, \ f c h -> h,
    \ x f n h -> le-l x (\ m -> add a (f m)) n h].mono ;

-- Agda: Z-left-unit
Z-left-unit : (a : Br) -> Id Br (add Zb a) a = split {
  Zb -> refl Zb ;
  Sb a | r -> apH (\ x -> Sb x) r ;
  Lb f | r -> lim-ext (\ n -> add Zb (f n)) f r } ;

-- Agda: ⊗-mono-left
mul-mono-left (a a' : Br) (p : Le a a') : (c : Br) -> Le (mul a c) (mul a' c) = split {
  Zb -> tt ;
  Sb c | r -> le-trans (add (mul a c) a) (add (mul a' c) a) (add (mul a' c) a')
    (add-mono-left (mul a c) (mul a' c) r a) (add-mono-right (mul a' c) a a' p) ;
  Lb f | r -> le-L-mono (\ n -> mul a (f n)) (\ n -> mul a' (f n)) r } ;

-- Agda: ⊗-mono-right
mul-mono-right (a : Br) : (b c : Br) -> Le b c -> Le (mul a b) (mul a c) =
  MonoRight[mul a, \ c -> tt, \ x y p -> add-mono-left (mul a x) (mul a y) p a, \ f c h -> h,
    \ x f n h -> le-l x (\ m -> mul a (f m)) n h].mono ;

------------------------------------------------------------------------
-- exponentiation, the tower, eps0, the strict order

-- Agda: ω^_, tower, ε₀, _<_
wexp : Br -> Br = split { Zb -> Sb Zb ; Sb a | r -> mul r omega ; Lb f | r -> Lb r } ;
tower : Nat -> Br = split { zero -> omega ; suc n | r -> wexp r } ;
eps0 : Br = Lb tower ;
Lt (a b : Br) : U l = Le (Sb a) b ;

-- Agda: one-≤-ω^
one-le-wexp : (b : Br) -> Le one (wexp b) = split {
  Zb -> le-refl one ;
  Sb b | r -> le-l one (\ n -> mul (wexp b) (numB n)) (suc zero)
    (substH (\ x -> Le one x) (symH (Z-left-unit (wexp b))) r) ;
  Lb f | r -> le-l one (\ n -> wexp (f n)) zero (r zero) } ;

-- Agda: ω^-mono
wexp-mono : (a b : Br) -> Le a b -> Le (wexp a) (wexp b) =
  MonoRight[wexp, one-le-wexp, \ x y p -> mul-mono-left (wexp x) (wexp y) p omega, \ f c h -> h,
    \ x f n h -> le-l x (\ m -> wexp (f m)) n h].mono ;

-- Agda: ι[_]≤ω
num-le-omega (m : Nat) : Le (numB m) omega = upper numB m ;

-- Agda: ω^-double  (w^a + w^a = w^a * 2 <= w^a * w)
wexp-double (a : Br) : Le (add (wexp a) (wexp a)) (mul (wexp a) omega) =
  substH (\ x -> Le x (mul (wexp a) omega)) (apH (\ x -> add x (wexp a)) (Z-left-unit (wexp a)))
    (upper (\ n -> mul (wexp a) (numB n)) (suc (suc zero))) ;

-- Agda: S-ω^-step  (S (w^a) <= w^a + w^a, since 1 <= w^a)
S-wexp-step (a : Br) : Le (Sb (wexp a)) (mul (wexp a) omega) =
  le-trans (Sb (wexp a)) (add (wexp a) (wexp a)) (mul (wexp a) omega)
    (add-mono-right (wexp a) one (wexp a) (one-le-wexp a)) (wexp-double a) ;

-- Agda: ≤-ω^
le-wexp : (a : Br) -> Le a (wexp a) = split {
  Zb -> tt ;
  Sb a | r -> le-trans (Sb a) (Sb (wexp a)) (mul (wexp a) omega) r (S-wexp-step a) ;
  Lb f | r -> le-L-mono f (\ n -> wexp (f n)) r } ;

-- Agda: SZ-⊗  (1 * y = y)
one-mul : (y : Br) -> Id Br (mul one y) y = split {
  Zb -> refl Zb ;
  Sb y | r -> apH (\ x -> Sb x) r ;
  Lb f | r -> lim-ext (\ n -> mul one (f n)) f r } ;

-- Agda: one-⊗-ι, ω^-ι1  (w = w^1)
one-mul-num (n : Nat) : Id Br (mul one (numB n)) (numB n) = one-mul (numB n) ;
wexp-one : Id Br (wexp one) omega = lim-ext (\ n -> mul one (numB n)) numB one-mul-num ;

-- Agda: ω<ω^ω
omega-lt-wexp-omega : Lt omega (wexp omega) =
  substH (\ x -> Lt x (wexp omega)) wexp-one
    (le-trans (Sb (wexp one)) (wexp two) (wexp omega) (S-wexp-step one)
      (wexp-mono two omega (num-le-omega (suc (suc zero))))) ;

-- Agda: tower-strict, tower-<-ε₀
tower-strict : (n : Nat) -> Lt (tower n) (wexp (tower n)) = split {
  zero -> omega-lt-wexp-omega ;
  suc m | r -> le-trans (Sb (tower (suc m))) (wexp (Sb (tower m))) (wexp (tower (suc m)))
    (S-wexp-step (tower m)) (wexp-mono (Sb (tower m)) (tower (suc m)) r) } ;
tower-lt-eps0 (n : Nat) : Lt (tower n) eps0 = le-l (Sb (tower n)) tower (suc n) (tower-strict n) ;

-- Agda: tower-mono-step, tower-double
tower-mono-step (n : Nat) : Le (tower n) (tower (suc n)) =
  le-trans (tower n) (Sb (tower n)) (tower (suc n)) (S-increasing (tower n)) (tower-strict n) ;
tower-double : (n : Nat) -> Le (add (tower n) (tower n)) (tower (suc n)) = split {
  zero -> substH (\ x -> Le (add x x) (tower (suc zero))) wexp-one
    (le-trans (add (wexp one) (wexp one)) (wexp two) (wexp omega) (wexp-double one)
      (wexp-mono two omega (num-le-omega (suc (suc zero))))) ;
  suc m -> le-trans (add (tower (suc m)) (tower (suc m))) (wexp (Sb (tower m))) (tower (suc (suc m)))
    (wexp-double (tower m)) (wexp-mono (Sb (tower m)) (tower (suc m)) (tower-strict m)) } ;

------------------------------------------------------------------------
-- maximum and order on Nat

-- Agda: maxℕ, _≤ℕ_, ≤ℕ-refl, ≤ℕ-maxL, ≤ℕ-maxR
maxN : Nat -> Nat -> Nat = split {
  zero -> \ n -> n ;
  suc m | r -> split { zero -> suc m ; suc n -> suc (r n) } } ;
leN : Nat -> Nat -> U l = split {
  zero -> \ n -> Top ;
  suc m | r -> split { zero -> Empty ; suc n -> r n } } ;
leN-refl : (n : Nat) -> leN n n = split { zero -> tt ; suc n | r -> r } ;
leN-maxL : (m n : Nat) -> leN m (maxN m n) = split {
  zero -> \ n -> tt ;
  suc m | r -> split { zero -> leN-refl (suc m) ; suc n -> r n } } ;
leN-maxR : (m n : Nat) -> leN n (maxN m n) = split {
  zero -> \ n -> leN-refl n ;
  suc m | r -> split { zero -> tt ; suc n -> r n } } ;

-- Agda: tower-mono-ℕ
tower-mono-zero : (n : Nat) -> Le (tower zero) (tower n) = split {
  zero -> le-refl omega ;
  suc n | r -> le-trans omega (tower n) (tower (suc n)) r (tower-mono-step n) } ;
tower-mono-N : (m n : Nat) -> leN m n -> Le (tower m) (tower n) = split {
  zero -> \ n p -> tower-mono-zero n ;
  suc m | r -> split {
    zero -> \ p -> absurd (Le (tower (suc m)) omega) p ;
    suc n -> \ p -> wexp-mono (tower m) (tower n) (r n p) } } ;

------------------------------------------------------------------------
-- closure of eps0

-- S a <= tower j and j <= J give a <= tower J
below-level (a : Br) (j J : Nat) (h : leN j J) (q : Lt a (tower j)) : Le a (tower J) =
  le-trans a (Sb a) (tower J) (S-increasing a)
    (le-trans (Sb a) (tower j) (tower J) q (tower-mono-N j J h)) ;

-- an operation monotone in both arguments with F (tower n) (tower n) <= tower (n+1)
-- preserves being below eps0  (Agda: the common body of ⊕-<-ε₀ and ⊗-<-ε₀)
module Closure2 (F : Br -> Br -> Br)
    (mono : (a a' b b' : Br) -> Le a a' -> Le b b' -> Le (F a b) (F a' b'))
    (sq : (n : Nat) -> Le (F (tower n) (tower n)) (tower (suc n))) {
  close (a b : Br) (pa : Lt a eps0) (pb : Lt b eps0) : Lt (F a b) eps0 =
    le-trans (Sb (F a b)) (Sb (tower (suc J))) eps0 ab (tower-lt-eps0 (suc J))
   where {
     J : Nat = maxN pa.1 pb.1 ;
     ab : Le (F a b) (tower (suc J)) =
       le-trans (F a b) (F (tower J) (tower J)) (tower (suc J))
         (mono a (tower J) b (tower J)
           (below-level a pa.1 J (leN-maxL pa.1 pb.1) pa.2)
           (below-level b pb.1 J (leN-maxR pa.1 pb.1) pb.2))
         (sq J) ;
   } ;
} ;

-- addition is monotone in both arguments
add-mono (a a' b b' : Br) (p : Le a a') (q : Le b b') : Le (add a b) (add a' b') =
  le-trans (add a b) (add a' b) (add a' b') (add-mono-left a a' p b) (add-mono-right a' b b' q) ;

-- Agda: ⊕-<-ε₀
add-lt-eps0 (a b : Br) : Lt a eps0 -> Lt b eps0 -> Lt (add a b) eps0 =
  Closure2[add, add-mono, tower-double].close a b ;

-- Agda: S-<-ε₀, ω^-<-ε₀
S-lt-eps0 (a : Br) (p : Lt a eps0) : Lt (Sb a) eps0 =
  le-trans (Sb (Sb a)) (Sb (tower p.1)) eps0 p.2 (tower-lt-eps0 p.1) ;
wexp-lt-eps0 (a : Br) (p : Lt a eps0) : Lt (wexp a) eps0 =
  le-trans (Sb (wexp a)) (Sb (tower (suc p.1))) eps0
    (wexp-mono a (tower p.1) (le-trans a (Sb a) (tower p.1) (S-increasing a) p.2))
    (tower-lt-eps0 (suc p.1)) ;

------------------------------------------------------------------------
-- a code is below its product by a positive code

-- Agda: x-≤-x⊗, y-≤-⊗
le-mul-right (x y : Br) (ypos : Le one y) : Le x (mul x y) =
  le-trans x (mul x one) (mul x y) (substH (\ z -> Le x z) (symH (Z-left-unit x)) (le-refl x))
    (mul-mono-right x one y ypos) ;
le-mul-left (x y : Br) (xpos : Le one x) : Le y (mul x y) =
  substH (\ z -> Le z (mul x y)) (one-mul y) (mul-mono-left one x xpos y) ;

-- Agda: ι<ε₀, Z<ε₀, ω<ε₀
num-lt-eps0 (m : Nat) : Lt (numB m) eps0 =
  le-trans (Sb (numB m)) (Sb omega) eps0 (num-le-omega m) (tower-lt-eps0 zero) ;
Z-lt-eps0 : Lt Zb eps0 = num-lt-eps0 zero ;
omega-lt-eps0 : Lt omega eps0 = tower-lt-eps0 zero ;
