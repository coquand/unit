-- RectAlgebra.seg: the algebra of rectangular data (Agda
-- BrouwerOrdinals.RectAlgebra and BrouwerOrdinals.RectSum).
--
-- RectAlgebra.  Domination of data is transitive (leSc-trans, leRD-trans);
-- a successor and a join dominate their arguments.  The zero datum
-- (zeroRD), the join of two data (joinRD, above both), padding a datum to
-- more output orders by zero cascades (padRD; the first orders of its
-- action are the action of the datum, rect-padRD), the sum of two tuples
-- (taddTup) and of a tuple and a longer one (padd), the flattening of a
-- datum into a tuple (flatRD) whose reading dominates the datum
-- (flatRD-ge).  The prefix order leInit (Agda ⊴: t ⊴ u when t is below
-- the first entries of u, across widths): an input dominating a tuple
-- gives the action of the zero datum above it (rect-leInit).  Adding a
-- code at order 0 inside the datum (addRDc), when the code is below the
-- first input entry (rect-addNuc).  All operations keep data below eps0.
--
-- RectSum.  The sum of the outputs of a datum is below one cascade read
-- off the datum (sumRD, tsum-rect): the cascades of the orders joined, the
-- higher ones widened by upSc.
--
-- Deviation (from RD 0 q = Tup q, see Rect.seg): on width 0 the
-- operations on data are the operations on tuples, without a separate
-- clause by recursion on q: zeroRD 0 = zeroTup, joinRD 0 = taddTup,
-- padRD 0 = padTup (new name for Agda's padRD zero clauses), leRD-trans 0
-- = Tuples.leT-trans, sucRD-AllLt 0 = sucTup-AllLt (new), flatRD 0 =
-- flat0 (new; the identity at q >= 1), addRDc 0 = addTupc (new),
-- sumRD 0 = tsum, tsum-rect 0 = le-refl.  So taddTup and its lemmas come
-- before joinRD (Agda: after).  Top has no eta: pre-padTup at width 0 is
-- isTop (Base).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ;
open Tuples[l] ; open Cascade[l] ; open Rect[l] ;

------------------------------------------------------------------------
-- transitivity of domination; successor and join dominate

-- Agda: ⊑Sc-trans
leSc-trans : (k : Nat) -> (E F G : Sc k) -> leSc k E F -> leSc k F G -> leSc k E G = split {
  zero -> \ E F G p q -> le-trans E F G p q ;
  suc k | r -> \ E F G p q -> (le-trans E.1 F.1 G.1 p.1 q.1, r E.2 F.2 G.2 p.2 q.2) } ;

-- Agda: ⊑RD-trans
leRD-trans : (p : Nat) -> (q : Nat) -> (D D' D'' : RD p q) -> leRD p q D D' -> leRD p q D' D'' -> leRD p q D D'' = split {
  zero -> leT-trans ;
  suc p | r -> split {
    zero -> \ D D' D'' h h' -> tt ;
    suc q -> \ D D' D'' h h' -> (leSc-trans (suc p) D.1 D'.1 D''.1 h.1 h'.1, r q D.2 D'.2 D''.2 h.2 h'.2) } } ;

-- Agda: sucSc-⊒
sucSc-ge : (k : Nat) -> (E : Sc k) -> leSc k E (sucSc k E) = split {
  zero -> \ c -> S-increasing c ;
  suc k | r -> \ E -> (S-increasing E.1, r E.2) } ;

-- Agda: joinSc-left, joinSc-right
joinSc-left : (k : Nat) -> (E F : Sc k) -> leSc k E (joinSc k E F) = split {
  zero -> \ c d -> add-increasing-right c d ;
  suc k | r -> \ E F -> (add-increasing-right E.1 F.1,
    leSc-trans k E.2 (joinSc k E.2 F.2) (sucSc k (joinSc k E.2 F.2)) (r E.2 F.2) (sucSc-ge k (joinSc k E.2 F.2))) } ;
joinSc-right : (k : Nat) -> (E F : Sc k) -> leSc k F (joinSc k E F) = split {
  zero -> \ c d -> add-increasing-left c d ;
  suc k | r -> \ E F -> (add-increasing-left E.1 F.1,
    leSc-trans k F.2 (joinSc k E.2 F.2) (sucSc k (joinSc k E.2 F.2)) (r E.2 F.2) (sucSc-ge k (joinSc k E.2 F.2))) } ;

------------------------------------------------------------------------
-- zero data

-- Agda: zeroTup, zeroTup-All<
zeroTup : (n : Nat) -> Tup n = split { zero -> tt ; suc n | r -> (Zb, r) } ;
zeroTup-AllLt : (n : Nat) -> AllLt n (zeroTup n) = split { zero -> tt ; suc n | r -> (Z-lt-eps0, r) } ;

-- Agda: zeroRD, zeroRD-All<
zeroRD : (n : Nat) -> (k : Nat) -> RD n k = split {
  zero -> zeroTup ;
  suc n | r -> split { zero -> tt ; suc k -> (zeroSc (suc n), r k) } } ;
zeroRD-AllLt : (n : Nat) -> (k : Nat) -> RDAllLt n k (zeroRD n k) = split {
  zero -> zeroTup-AllLt ;
  suc n | r -> split { zero -> tt ; suc k -> (zeroSc-AllLt (suc n), r k) } } ;

------------------------------------------------------------------------
-- sums of tuples

-- Agda: taddTup, taddTup-left, taddTup-right, taddTup-All<
taddTup : (n : Nat) -> Tup n -> Tup n -> Tup n = split {
  zero -> \ t u -> tt ;
  suc n | r -> \ t u -> (add t.1 u.1, r t.2 u.2) } ;
taddTup-left : (n : Nat) -> (t u : Tup n) -> leT n t (taddTup n t u) = split {
  zero -> \ t u -> tt ;
  suc n | r -> \ t u -> (add-increasing-right t.1 u.1, r t.2 u.2) } ;
taddTup-right : (n : Nat) -> (t u : Tup n) -> leT n u (taddTup n t u) = split {
  zero -> \ t u -> tt ;
  suc n | r -> \ t u -> (add-increasing-left t.1 u.1, r t.2 u.2) } ;
taddTup-AllLt : (n : Nat) -> (t u : Tup n) -> AllLt n t -> AllLt n u -> AllLt n (taddTup n t u) = split {
  zero -> \ t u ht hu -> tt ;
  suc n | r -> \ t u ht hu -> (add-lt-eps0 t.1 u.1 ht.1 hu.1, r t.2 u.2 ht.2 hu.2) } ;

-- Agda: padd, padd-right, padd-left, padd-All<
padd : (a : Nat) -> (b : Nat) -> Tup a -> Tup (maxN a b) -> Tup (maxN a b) = split {
  zero -> \ b t u -> u ;
  suc a | r -> split {
    zero -> \ t u -> taddTup (suc a) t u ;
    suc b -> \ t u -> (add t.1 u.1, r b t.2 u.2) } } ;
padd-right : (a : Nat) -> (b : Nat) -> (t : Tup a) -> (u : Tup (maxN a b)) -> leT (maxN a b) u (padd a b t u) = split {
  zero -> \ b t u -> leT-refl b u ;
  suc a | r -> split {
    zero -> \ t u -> taddTup-right (suc a) t u ;
    suc b -> \ t u -> (add-increasing-left t.1 u.1, r b t.2 u.2) } } ;
padd-left : (a : Nat) -> (b : Nat) -> (t : Tup a) -> (u : Tup (maxN a b)) -> leT a t (pre a b (padd a b t u)) = split {
  zero -> \ b t u -> tt ;
  suc a | r -> split {
    zero -> \ t u -> taddTup-left (suc a) t u ;
    suc b -> \ t u -> (add-increasing-right t.1 u.1, r b t.2 u.2) } } ;
padd-AllLt : (a : Nat) -> (b : Nat) -> (t : Tup a) -> (u : Tup (maxN a b)) -> AllLt a t -> AllLt (maxN a b) u
  -> AllLt (maxN a b) (padd a b t u) = split {
  zero -> \ b t u ht hu -> hu ;
  suc a | r -> split {
    zero -> \ t u ht hu -> taddTup-AllLt (suc a) t u ht hu ;
    suc b -> \ t u ht hu -> (add-lt-eps0 t.1 u.1 ht.1 hu.1, r b t.2 u.2 ht.2 hu.2) } } ;

------------------------------------------------------------------------
-- join of data

-- Agda: joinRD, joinRD-left, joinRD-right, joinRD-All<
joinRD : (n : Nat) -> (k : Nat) -> RD n k -> RD n k -> RD n k = split {
  zero -> taddTup ;
  suc n | r -> split {
    zero -> \ D D' -> tt ;
    suc k -> \ D D' -> (joinSc (suc n) D.1 D'.1, r k D.2 D'.2) } } ;
joinRD-left : (n : Nat) -> (k : Nat) -> (D D' : RD n k) -> leRD n k D (joinRD n k D D') = split {
  zero -> taddTup-left ;
  suc n | r -> split {
    zero -> \ D D' -> tt ;
    suc k -> \ D D' -> (joinSc-left (suc n) D.1 D'.1, r k D.2 D'.2) } } ;
joinRD-right : (n : Nat) -> (k : Nat) -> (D D' : RD n k) -> leRD n k D' (joinRD n k D D') = split {
  zero -> taddTup-right ;
  suc n | r -> split {
    zero -> \ D D' -> tt ;
    suc k -> \ D D' -> (joinSc-right (suc n) D.1 D'.1, r k D.2 D'.2) } } ;
joinRD-AllLt : (n : Nat) -> (k : Nat) -> (D D' : RD n k) -> RDAllLt n k D -> RDAllLt n k D'
  -> RDAllLt n k (joinRD n k D D') = split {
  zero -> taddTup-AllLt ;
  suc n | r -> split {
    zero -> \ D D' h h' -> tt ;
    suc k -> \ D D' h h' -> (joinSc-AllLt (suc n) D.1 D'.1 h.1 h'.1, r k D.2 D'.2 h.2 h'.2) } } ;

------------------------------------------------------------------------
-- padding a datum with zero cascades

-- Agda: padRD zero (the clauses at width 0)
padTup : (a : Nat) -> (b : Nat) -> Tup a -> Tup (maxN a b) = split {
  zero -> \ b D -> zeroTup b ;
  suc a | r -> split {
    zero -> \ D -> D ;
    suc b -> \ D -> (D.1, r b D.2) } } ;
-- Agda: padRD
padRD : (n : Nat) -> (a : Nat) -> (b : Nat) -> RD n a -> RD n (maxN a b) = split {
  zero -> padTup ;
  suc n | r -> split {
    zero -> \ b D -> zeroRD (suc n) b ;
    suc a -> split {
      zero -> \ D -> D ;
      suc b -> \ D -> (D.1, r a b D.2) } } } ;

-- Agda: rect-padRD (and its clauses at width 0)
pre-padTup : (a : Nat) -> (b : Nat) -> (D : Tup a) -> Id (Tup a) (pre a b (padTup a b D)) D = split {
  zero -> \ b D -> isTop tt D ;
  suc a | r -> split {
    zero -> \ D -> refl D ;
    suc b -> \ D -> apH (\ y -> (D.1, y)) (r b D.2) } } ;
rect-padRD : (n : Nat) -> (a : Nat) -> (b : Nat) -> (D : RD n a) -> (x : Tup n)
  -> Id (Tup a) (pre a b (rect n (maxN a b) (padRD n a b D) x)) (rect n a D x) = split {
  zero -> \ a b D x -> pre-padTup a b D ;
  suc n | r -> split {
    zero -> \ b D x -> refl tt ;
    suc a -> split {
      zero -> \ D x -> refl (rect (suc n) (suc a) D x) ;
      suc b -> \ D x -> apH (\ y -> (valSc (suc n) D.1 x, y)) (r a b D.2 x.2) } } } ;

-- Agda: padRD-All<
padTup-AllLt : (a : Nat) -> (b : Nat) -> (D : Tup a) -> AllLt a D -> AllLt (maxN a b) (padTup a b D) = split {
  zero -> \ b D h -> zeroTup-AllLt b ;
  suc a | r -> split {
    zero -> \ D h -> h ;
    suc b -> \ D h -> (h.1, r b D.2 h.2) } } ;
padRD-AllLt : (n : Nat) -> (a : Nat) -> (b : Nat) -> (D : RD n a) -> RDAllLt n a D -> RDAllLt n (maxN a b) (padRD n a b D) = split {
  zero -> padTup-AllLt ;
  suc n | r -> split {
    zero -> \ b D h -> zeroRD-AllLt (suc n) b ;
    suc a -> split {
      zero -> \ D h -> h ;
      suc b -> \ D h -> (h.1, r a b D.2 h.2) } } } ;

------------------------------------------------------------------------
-- flattening a datum

-- Agda: flatRD zero (the clauses at width 0)
flat0 : (q : Nat) -> Tup q -> Tup (WD zero q) = split {
  zero -> \ D -> zeroTup (suc zero) ;
  suc q -> \ D -> D } ;
-- Agda: flatRD
flatRD : (p : Nat) -> (q : Nat) -> RD p q -> Tup (WD p q) = split {
  zero -> flat0 ;
  suc p | r -> split {
    zero -> \ D -> zeroTup (suc (suc p)) ;
    suc q -> \ D -> (D.1.1, padd (suc p) q (scToTup p D.1.2) (r q D.2)) } } ;

-- Agda: flatRD-⊒
flat0-ge : (q : Nat) -> (D : Tup q) -> leT q D (top0 q (flat0 q D)) = split {
  zero -> \ D -> tt ;
  suc q -> \ D -> leT-refl (suc q) D } ;
flatRD-ge : (p : Nat) -> (q : Nat) -> (D : RD p q) -> leRD p q D (rdOf p q (flatRD p q D)) = split {
  zero -> flat0-ge ;
  suc p | r -> split {
    zero -> \ D -> tt ;
    suc q -> \ D ->
      ((le-refl D.1.1,
        scToTup-le p D.1.2 (pre (suc p) q (padd (suc p) q (scToTup p D.1.2) (flatRD p q D.2)))
          (padd-left (suc p) q (scToTup p D.1.2) (flatRD p q D.2))),
       leRD-trans p q D.2 (rdOf p q (flatRD p q D.2)) (rdOf p q (padd (suc p) q (scToTup p D.1.2) (flatRD p q D.2)))
         (r q D.2)
         (rdOf-mono p q (flatRD p q D.2) (padd (suc p) q (scToTup p D.1.2) (flatRD p q D.2))
           (padd-right (suc p) q (scToTup p D.1.2) (flatRD p q D.2)))) } } ;

-- Agda: flatRD-All<
flat0-AllLt : (q : Nat) -> (D : Tup q) -> AllLt q D -> AllLt (WD zero q) (flat0 q D) = split {
  zero -> \ D h -> zeroTup-AllLt (suc zero) ;
  suc q -> \ D h -> h } ;
flatRD-AllLt : (p : Nat) -> (q : Nat) -> (D : RD p q) -> RDAllLt p q D -> AllLt (WD p q) (flatRD p q D) = split {
  zero -> flat0-AllLt ;
  suc p | r -> split {
    zero -> \ D h -> zeroTup-AllLt (suc (suc p)) ;
    suc q -> \ D h -> (h.1.1,
      padd-AllLt (suc p) q (scToTup p D.1.2) (flatRD p q D.2) (scToTup-AllLt p D.1.2 h.1.2) (r q D.2 h.2)) } } ;

------------------------------------------------------------------------
-- the prefix order across widths

-- Agda: _⊴_  (t ⊴ u)
leInit : (k : Nat) -> (n : Nat) -> Tup k -> Tup n -> U l = split {
  zero -> \ n t u -> Top ;
  suc k | r -> split {
    zero -> \ t u -> Empty ;
    suc n -> \ t u -> Le t.1 u.1 * r n t.2 u.2 } } ;

-- Agda: ⊴-refl, ⊴-trans
leInit-refl : (n : Nat) -> (u : Tup n) -> leInit n n u u = split {
  zero -> \ u -> tt ;
  suc n | r -> \ u -> (le-refl u.1, r u.2) } ;
leInit-trans : (k : Nat) -> (n j : Nat) -> (t : Tup k) -> (u : Tup n) -> (v : Tup j)
  -> leInit k n t u -> leInit n j u v -> leInit k j t v = split {
  zero -> \ n j t u v h h' -> tt ;
  suc k | r -> split {
    zero -> \ j t u v h h' -> absurd (leInit (suc k) j t v) h ;
    suc n -> split {
      zero -> \ t u v h h' -> absurd Empty h' ;
      suc j -> \ t u v h h' -> (le-trans t.1 u.1 v.1 h.1 h'.1, r n j t.2 u.2 v.2 h.2 h'.2) } } } ;

-- Agda: ≤-<-ε₀, ⊴-All<
le-lt-eps0 (a b : Br) (h : Le a b) (h' : Lt b eps0) : Lt a eps0 = le-trans (Sb a) (Sb b) eps0 h h' ;
leInit-AllLt : (k : Nat) -> (n : Nat) -> (t : Tup k) -> (u : Tup n) -> leInit k n t u -> AllLt n u -> AllLt k t = split {
  zero -> \ n t u h hu -> tt ;
  suc k | r -> split {
    zero -> \ t u h hu -> absurd (AllLt (suc k) t) h ;
    suc n -> \ t u h hu -> (le-lt-eps0 t.1 u.1 h.1 hu.1, r n t.2 u.2 h.2 hu.2) } } ;

-- Agda: pre-⊴
pre-leInit : (a : Nat) -> (b : Nat) -> (t : Tup (maxN a b)) -> leInit a (maxN a b) (pre a b t) t = split {
  zero -> \ b t -> tt ;
  suc a | r -> split {
    zero -> \ t -> leInit-refl (suc a) t ;
    suc b -> \ t -> (le-refl t.1, r b t.2) } } ;

-- Agda: rect-⊴
rect-leInit : (n : Nat) -> (k : Nat) -> (u : Tup n) -> (t : Tup k) -> leInit k n t u
  -> leT k t (rect n k (zeroRD n k) u) = split {
  zero -> split {
    zero -> \ u t h -> tt ;
    suc k -> \ u t h -> absurd (leT (suc k) t (zeroTup (suc k))) h } ;
  suc n | r -> split {
    zero -> \ u t h -> tt ;
    suc k -> \ u t h -> (le-trans t.1 u.1 (valSc (suc n) (zeroSc (suc n)) u) h.1 (valSc-increasing n Zb (zeroSc n) u.1 u.2),
                         r k u.2 t.2 h.2) } } ;

------------------------------------------------------------------------
-- successor and the adjustment at order 0

-- Agda: sucRD-All< (and its clauses at width 0)
sucTup-AllLt : (n : Nat) -> (t : Tup n) -> AllLt n t -> AllLt n (sucTup n t) = split {
  zero -> \ t h -> tt ;
  suc n | r -> \ t h -> (S-lt-eps0 t.1 h.1, r t.2 h.2) } ;
sucRD-AllLt : (p : Nat) -> (q : Nat) -> (D : RD p q) -> RDAllLt p q D -> RDAllLt p q (sucRD p q D) = split {
  zero -> sucTup-AllLt ;
  suc p | r -> split {
    zero -> \ D h -> tt ;
    suc q -> \ D h -> (sucSc-AllLt (suc p) D.1 h.1, r q D.2 h.2) } } ;

-- Agda: addRDc (and its clauses at width 0)
addTupc : (p : Nat) -> Tup p -> Tup p = split {
  zero -> \ D -> tt ;
  suc p -> \ D -> (D.1, sucTup p D.2) } ;
addRDc : (n : Nat) -> (p : Nat) -> RD n p -> RD n p = split {
  zero -> addTupc ;
  suc n -> split {
    zero -> \ D -> tt ;
    suc p -> \ D -> (joinSc (suc n) D.1 (zeroSc (suc n)), sucRD n p D.2) } } ;

-- Agda: rect-addνc
rect-addNuc : (n : Nat) -> (p : Nat) -> (D : RD n p) -> (u : Tup n) -> (v : Br) -> leInit (suc zero) n (v, tt) u
  -> leT p (addNu p (rect n p D u) v) (rect n p (addRDc n p D) u) = split {
  zero -> split {
    zero -> \ D u v h -> tt ;
    suc p -> \ D u v h -> absurd (leT (suc p) (addNu (suc p) D v) (addTupc (suc p) D)) h } ;
  suc n -> split {
    zero -> \ D u v h -> tt ;
    suc p -> \ D u v h ->
      (le-trans (add (valSc (suc n) D.1 u) v) (add (valSc (suc n) D.1 u) (valSc (suc n) (zeroSc (suc n)) u))
         (valSc (suc n) (joinSc (suc n) D.1 (zeroSc (suc n))) u)
         (add-mono-right (valSc (suc n) D.1 u) v (valSc (suc n) (zeroSc (suc n)) u)
           (le-trans v u.1 (valSc (suc n) (zeroSc (suc n)) u) h.1 (valSc-increasing n Zb (zeroSc n) u.1 u.2)))
         (valSc-join (suc n) D.1 (zeroSc (suc n)) u),
       rect-sucRD n p D.2 u.2) } } ;

-- Agda: addRDc-All<
addTupc-AllLt : (p : Nat) -> (D : Tup p) -> AllLt p D -> AllLt p (addTupc p D) = split {
  zero -> \ D h -> tt ;
  suc p -> \ D h -> (h.1, sucTup-AllLt p D.2 h.2) } ;
addRDc-AllLt : (n : Nat) -> (p : Nat) -> (D : RD n p) -> RDAllLt n p D -> RDAllLt n p (addRDc n p D) = split {
  zero -> addTupc-AllLt ;
  suc n -> split {
    zero -> \ D h -> tt ;
    suc p -> \ D h -> (joinSc-AllLt (suc n) D.1 (zeroSc (suc n)) h.1 (zeroSc-AllLt (suc n)), sucRD-AllLt n p D.2 h.2) } } ;

------------------------------------------------------------------------
-- RectSum: the sum of the outputs

-- Agda: sumRD
sumRD : (p : Nat) -> (q : Nat) -> RD p q -> Sc p = split {
  zero -> tsum ;
  suc p | r -> split {
    zero -> \ D -> zeroSc (suc p) ;
    suc q -> \ D -> joinSc (suc p) D.1 (upSc p (r q D.2)) } } ;

-- Agda: tsum-rect
tsum-rect : (p : Nat) -> (q : Nat) -> (D : RD p q) -> (x : Tup p) -> Le (tsum q (rect p q D x)) (valSc p (sumRD p q D) x) = split {
  zero -> \ q D x -> le-refl (tsum q D) ;
  suc p | r -> split {
    zero -> \ D x -> tt ;
    suc q -> \ D x ->
      le-trans (add (valSc (suc p) D.1 x) (tsum q (rect p q D.2 x.2)))
        (add (valSc (suc p) D.1 x) (valSc (suc p) (upSc p (sumRD p q D.2)) x))
        (valSc (suc p) (sumRD (suc p) (suc q) D) x)
        (add-mono-right (valSc (suc p) D.1 x) (tsum q (rect p q D.2 x.2)) (valSc (suc p) (upSc p (sumRD p q D.2)) x)
          (le-trans (tsum q (rect p q D.2 x.2)) (valSc p (sumRD p q D.2) x.2) (valSc (suc p) (upSc p (sumRD p q D.2)) x)
            (r q D.2 x.2) (valSc-up p (sumRD p q D.2) x.1 x.2)))
        (valSc-join (suc p) D.1 (upSc p (sumRD p q D.2)) x) } } ;

-- Agda: sumRD-All<
sumRD-AllLt : (p : Nat) -> (q : Nat) -> (D : RD p q) -> RDAllLt p q D -> ScAllLt p (sumRD p q D) = split {
  zero -> tsum-lt-eps0 ;
  suc p | r -> split {
    zero -> \ D h -> zeroSc-AllLt (suc p) ;
    suc q -> \ D h -> joinSc-AllLt (suc p) D.1 (upSc p (sumRD p q D.2)) h.1 (upSc-AllLt p (sumRD p q D.2) (r q D.2 h.2)) } } ;
