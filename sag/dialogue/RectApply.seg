-- RectApply.seg: composing a datum read from an action with an action
-- (Agda BrouwerOrdinals.RectApply), the clause for S.
--
-- Given data DF (with outputs read as a datum of width p) and DG (of width
-- p), acting on one input x, the action of the datum read from DF x on
-- DG x is dominated by the action at x of one datum sh DF DG.  Per output
-- order the cascade is ssh: at the last order the head of DF; on width 0
-- the value itself; otherwise the head cascades of DG and DF joined with
-- the sum of DG (Jsh) supply the constant and translations, and the
-- exponent cascades are joined with the cascade one order up (valSc-ssh:
-- the exponent of a product is the sum of the exponents, by wexp-mul).
-- hdRD is the head cascade of a datum, preRD the restriction to the first
-- output orders (rect-preRD).
--
-- Deviations: preRD 0 is Rect.pre (RD 0 q = Tup q), so its clauses at
-- width 0 are those of pre; rdOf-zero-id is leT-refl, kept as a name.
-- In valSc-ssh the transport along valSc-hdRD at the last order is not
-- needed (it is a refl at each width).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ;
open MultClosure[l] ; open Tuples[l] ; open Cascade[l] ; open Rect[l] ; open RectAlgebra[l] ;

------------------------------------------------------------------------
-- head and restriction

-- Agda: hdRD, valSc-hdRD, hdRD-All<
hdRD : (m : Nat) -> (n : Nat) -> RD m (suc n) -> Sc m = split {
  zero -> \ n D -> D.1 ;
  suc m -> \ n D -> D.1 } ;
valSc-hdRD : (m : Nat) -> (n : Nat) -> (D : RD m (suc n)) -> (x : Tup m)
  -> Id Br (valSc m (hdRD m n D) x) (rect m (suc n) D x).1 = split {
  zero -> \ n D x -> refl D.1 ;
  suc m -> \ n D x -> refl (valSc (suc m) D.1 x) } ;
hdRD-AllLt : (m : Nat) -> (n : Nat) -> (D : RD m (suc n)) -> RDAllLt m (suc n) D -> ScAllLt m (hdRD m n D) = split {
  zero -> \ n D h -> h.1 ;
  suc m -> \ n D h -> h.1 } ;

-- Agda: preRD, rect-preRD, preRD-All<
preRD : (m : Nat) -> (a : Nat) -> (b : Nat) -> RD m (maxN a b) -> RD m a = split {
  zero -> pre ;
  suc m | r -> split {
    zero -> \ b D -> tt ;
    suc a -> split {
      zero -> \ D -> D ;
      suc b -> \ D -> (D.1, r a b D.2) } } } ;
rect-preRD : (m : Nat) -> (a : Nat) -> (b : Nat) -> (D : RD m (maxN a b)) -> (x : Tup m)
  -> Id (Tup a) (rect m a (preRD m a b D) x) (pre a b (rect m (maxN a b) D x)) = split {
  zero -> \ a b D x -> refl (pre a b D) ;
  suc m | r -> split {
    zero -> \ b D x -> refl tt ;
    suc a -> split {
      zero -> \ D x -> refl (rect (suc m) (suc a) D x) ;
      suc b -> \ D x -> apH (\ y -> (valSc (suc m) D.1 x, y)) (r a b D.2 x.2) } } } ;
preRD-AllLt : (m : Nat) -> (a : Nat) -> (b : Nat) -> (D : RD m (maxN a b)) -> RDAllLt m (maxN a b) D
  -> RDAllLt m a (preRD m a b D) = split {
  zero -> pre-AllLt ;
  suc m | r -> split {
    zero -> \ b D h -> tt ;
    suc a -> split {
      zero -> \ D h -> h ;
      suc b -> \ D h -> (h.1, r a b D.2 h.2) } } } ;

------------------------------------------------------------------------
-- the cascade of one output order

-- Agda: Jsh
Jsh (m p : Nat) (DF : RD (suc m) (suc (suc p))) (DG : RD (suc m) (suc p)) : Sc (suc m) =
  joinSc (suc m) (joinSc (suc m) (hdRD (suc m) p DG) (sumRD (suc m) (suc p) DG)) (hdRD (suc m) (suc p) DF) ;

-- Agda: ssh
ssh : (m : Nat) -> (p : Nat) -> RD m (suc p) -> RD m p -> Sc m = split {
  zero -> split {
    zero -> \ DF DG -> hdRD zero zero DF ;
    suc p -> \ DF DG -> valSc (suc p) (tupToSc (suc p) (rect zero (suc (suc p)) DF tt)) (rect zero (suc p) DG tt) } ;
  suc m | r -> split {
    zero -> \ DF DG -> hdRD (suc m) zero DF ;
    suc p -> \ DF DG -> ((Jsh m p DF DG).1, joinSc m (Jsh m p DF DG).2 (r p DF.2 DG.2)) } } ;

-- Agda: valSc-ssh (the case of positive widths)
valSc-ssh-step (m p : Nat) (DF : RD (suc m) (suc (suc p))) (DG : RD (suc m) (suc p)) (x : Tup (suc m))
  (ih : Le (valSc p (tupToSc p (rect m (suc p) DF.2 x.2)) (rect m p DG.2 x.2)) (valSc m (ssh m p DF.2 DG.2) x.2))
  : Le (valSc (suc p) (tupToSc (suc p) (rect (suc m) (suc (suc p)) DF x)) (rect (suc m) (suc p) DG x))
       (valSc (suc m) (ssh (suc m) (suc p) DF DG) x) =
  le-trans (mul (add (add v0 TL) u0) (wexp X)) (mul VJ (wexp Z2)) target step
    (substH (\ z -> Le z target) (symH eqAB) last)
 where {
   s : Br = add x.1 (tsum m x.2) ;
   u0 : Br = valSc (suc m) (hdRD (suc m) (suc p) DF) x ;
   v0 : Br = valSc (suc m) (hdRD (suc m) p DG) x ;
   V' : Tup p = rect m p DG.2 x.2 ;
   TL : Br = tsum p V' ;
   Jm : Sc (suc m) = Jsh m p DF DG ;
   VJ : Br = valSc (suc m) Jm x ;
   YJ : Br = valSc m Jm.2 x.2 ;
   Z2 : Br = valSc m (ssh m p DF.2 DG.2) x.2 ;
   target : Br = mul (add s Jm.1) (wexp (valSc m (joinSc m Jm.2 (ssh m p DF.2 DG.2)) x.2)) ;
   J1 : Sc (suc m) = joinSc (suc m) (hdRD (suc m) p DG) (sumRD (suc m) (suc p) DG) ;
   sum-le : Le TL (valSc (suc m) (sumRD (suc m) (suc p) DG) x) =
     le-trans TL (add v0 TL) (valSc (suc m) (sumRD (suc m) (suc p) DG) x)
       (add-increasing-left v0 TL) (tsum-rect (suc m) (suc p) DG x) ;
   base-le : Le (add (add v0 TL) u0) VJ =
     le-trans (add (add v0 TL) u0) (add (valSc (suc m) J1 x) u0) VJ
       (add-mono-left (add v0 TL) (valSc (suc m) J1 x)
         (le-trans (add v0 TL) (add v0 (valSc (suc m) (sumRD (suc m) (suc p) DG) x)) (valSc (suc m) J1 x)
           (add-mono-right v0 TL (valSc (suc m) (sumRD (suc m) (suc p) DG) x) sum-le)
           (valSc-join (suc m) (hdRD (suc m) p DG) (sumRD (suc m) (suc p) DG) x))
         u0)
       (valSc-join (suc m) J1 (hdRD (suc m) (suc p) DF) x) ;
   X : Br = valSc p (tupToSc p (rect m (suc p) DF.2 x.2)) V' ;
   step : Le (mul (add (add v0 TL) u0) (wexp X)) (mul VJ (wexp Z2)) =
     le-trans (mul (add (add v0 TL) u0) (wexp X)) (mul VJ (wexp X)) (mul VJ (wexp Z2))
       (mul-mono-left (add (add v0 TL) u0) VJ base-le (wexp X))
       (mul-mono-right VJ (wexp X) (wexp Z2) (wexp-mono X Z2 ih)) ;
   eqAB : Id Br (mul VJ (wexp Z2)) (mul (add s Jm.1) (wexp (add YJ Z2))) = calc Br {
     mul (mul (add s Jm.1) (wexp YJ)) (wexp Z2) =< mul-assoc (add s Jm.1) (wexp YJ) (wexp Z2) >
     mul (add s Jm.1) (mul (wexp YJ) (wexp Z2)) =< apH (mul (add s Jm.1)) (wexp-mul YJ Z2) >
     mul (add s Jm.1) (wexp (add YJ Z2)) } ;
   last : Le (mul (add s Jm.1) (wexp (add YJ Z2))) target =
     mul-mono-right (add s Jm.1) (wexp (add YJ Z2)) (wexp (valSc m (joinSc m Jm.2 (ssh m p DF.2 DG.2)) x.2))
       (wexp-mono (add YJ Z2) (valSc m (joinSc m Jm.2 (ssh m p DF.2 DG.2)) x.2)
         (valSc-join m Jm.2 (ssh m p DF.2 DG.2) x.2)) ;
 } ;
-- Agda: valSc-ssh
valSc-ssh : (m : Nat) -> (p : Nat) -> (DF : RD m (suc p)) -> (DG : RD m p) -> (x : Tup m)
  -> Le (valSc p (tupToSc p (rect m (suc p) DF x)) (rect m p DG x)) (valSc m (ssh m p DF DG) x) = split {
  zero -> split {
    zero -> \ DF DG x -> le-refl DF.1 ;
    suc p -> \ DF DG x -> le-refl (valSc (suc p) (tupToSc (suc p) DF) DG) } ;
  suc m | r -> split {
    zero -> \ DF DG x -> le-refl (valSc (suc m) DF.1 x) ;
    suc p -> \ DF DG x -> valSc-ssh-step m p DF DG x (r p DF.2 DG.2 x.2) } } ;

-- Agda: ssh-All< (its hJ)
Jsh-AllLt (m p : Nat) (DF : RD (suc m) (suc (suc p))) (DG : RD (suc m) (suc p))
  (hF : RDAllLt (suc m) (suc (suc p)) DF) (hG : RDAllLt (suc m) (suc p) DG) : ScAllLt (suc m) (Jsh m p DF DG) =
  joinSc-AllLt (suc m) (joinSc (suc m) (hdRD (suc m) p DG) (sumRD (suc m) (suc p) DG)) (hdRD (suc m) (suc p) DF)
    (joinSc-AllLt (suc m) (hdRD (suc m) p DG) (sumRD (suc m) (suc p) DG)
      (hdRD-AllLt (suc m) p DG hG) (sumRD-AllLt (suc m) (suc p) DG hG))
    (hdRD-AllLt (suc m) (suc p) DF hF) ;
-- Agda: ssh-All<
ssh-AllLt : (m : Nat) -> (p : Nat) -> (DF : RD m (suc p)) -> (DG : RD m p) -> RDAllLt m (suc p) DF -> RDAllLt m p DG
  -> ScAllLt m (ssh m p DF DG) = split {
  zero -> split {
    zero -> \ DF DG hF hG -> hF.1 ;
    suc p -> \ DF DG hF hG ->
      valSc-lt-eps0 (suc p) (tupToSc (suc p) DF) DG (tupToSc-AllLt (suc p) DF hF) hG } ;
  suc m | r -> split {
    zero -> \ DF DG hF hG -> hF.1 ;
    suc p -> \ DF DG hF hG ->
      ((Jsh-AllLt m p DF DG hF hG).1,
       joinSc-AllLt m (Jsh m p DF DG).2 (ssh m p DF.2 DG.2) (Jsh-AllLt m p DF DG hF hG).2 (r p DF.2 DG.2 hF.2 hG.2)) } } ;

------------------------------------------------------------------------
-- the composed datum

-- Agda: rdOf-zero-id
rdOf-zero-id (q : Nat) (d : Tup (suc q)) (y : Tup zero)
  : leT (suc q) (rect zero (suc q) (rdOf zero (suc q) d) y) d = leT-refl (suc q) d ;

-- Agda: ssub-head
ssub-head (m p q : Nat) (DF : RD m (WD (suc p) (suc q))) (DG : RD m (suc p)) (x : Tup m)
  : Le (valSc (suc p) (tupToSc (suc p) (pre (suc (suc p)) (suc q) (rect m (WD (suc p) (suc q)) DF x))) (rect m (suc p) DG x))
       (valSc m (ssh m (suc p) (preRD m (suc (suc p)) (suc q) DF) DG) x) =
  substH (\ u -> Le (valSc (suc p) (tupToSc (suc p) u) (rect m (suc p) DG x)) (valSc m (ssh m (suc p) DF1 DG) x))
    (rect-preRD m (suc (suc p)) (suc q) DF x)
    (valSc-ssh m (suc p) DF1 DG x)
 where {
   DF1 : RD m (suc (suc p)) = preRD m (suc (suc p)) (suc q) DF ;
 } ;

-- Agda: sh
sh : (m : Nat) -> (p : Nat) -> (q : Nat) -> RD m (WD p q) -> RD m p -> RD m q = split {
  zero -> split {
    zero -> split {
      zero -> \ DF DG -> tt ;
      suc q -> \ DF DG -> DF } ;
    suc p | r -> split {
      zero -> \ DF DG -> tt ;
      suc q -> \ DF DG -> (ssh zero (suc p) (preRD zero (suc (suc p)) (suc q) DF) DG, r q DF.2 DG.2) } } ;
  suc m | r -> split {
    zero -> split {
      zero -> \ DF DG -> tt ;
      suc q -> \ DF DG -> DF } ;
    suc p -> split {
      zero -> \ DF DG -> tt ;
      suc q -> \ DF DG -> (ssh (suc m) (suc p) (preRD (suc m) (suc (suc p)) (suc q) DF) DG, r p q DF.2 DG.2) } } } ;

-- Agda: rect-ssub
rect-ssub : (m : Nat) -> (p : Nat) -> (q : Nat) -> (DF : RD m (WD p q)) -> (DG : RD m p) -> (x : Tup m)
  -> leT q (rect p q (rdOf p q (rect m (WD p q) DF x)) (rect m p DG x)) (rect m q (sh m p q DF DG) x) = split {
  zero -> split {
    zero -> split {
      zero -> \ DF DG x -> tt ;
      suc q -> \ DF DG x -> rdOf-zero-id q DF x } ;
    suc p | r -> split {
      zero -> \ DF DG x -> tt ;
      suc q -> \ DF DG x -> (ssub-head zero p q DF DG x, r q DF.2 DG.2 x) } } ;
  suc m | r -> split {
    zero -> split {
      zero -> \ DF DG x -> tt ;
      suc q -> \ DF DG x -> rdOf-zero-id q (rect (suc m) (suc q) DF x) tt } ;
    suc p -> split {
      zero -> \ DF DG x -> tt ;
      suc q -> \ DF DG x -> (ssub-head (suc m) p q DF DG x, r p q DF.2 DG.2 x.2) } } } ;

-- Agda: sh-All<
sh-AllLt : (m : Nat) -> (p : Nat) -> (q : Nat) -> (DF : RD m (WD p q)) -> (DG : RD m p)
  -> RDAllLt m (WD p q) DF -> RDAllLt m p DG -> RDAllLt m q (sh m p q DF DG) = split {
  zero -> split {
    zero -> split {
      zero -> \ DF DG hF hG -> tt ;
      suc q -> \ DF DG hF hG -> hF } ;
    suc p | r -> split {
      zero -> \ DF DG hF hG -> tt ;
      suc q -> \ DF DG hF hG ->
        (ssh-AllLt zero (suc p) (preRD zero (suc (suc p)) (suc q) DF) DG
           (preRD-AllLt zero (suc (suc p)) (suc q) DF hF) hG,
         r q DF.2 DG.2 hF.2 hG.2) } } ;
  suc m | r -> split {
    zero -> split {
      zero -> \ DF DG hF hG -> tt ;
      suc q -> \ DF DG hF hG -> hF } ;
    suc p -> split {
      zero -> \ DF DG hF hG -> tt ;
      suc q -> \ DF DG hF hG ->
        (ssh-AllLt (suc m) (suc p) (preRD (suc m) (suc (suc p)) (suc q) DF) DG
           (preRD-AllLt (suc m) (suc (suc p)) (suc q) DF hF) hG,
         r p q DF.2 DG.2 hF.2 hG.2) } } } ;
