-- Height.seg: the height of a dialogue tree, a Brouwer code:
--   height (eta n) = Z,   height (beta phi i) = L (n |-> S (height (phi n))).
-- Relabelling the leaves keeps the height; grafting trees of height <= b
-- at the leaves of d gives height <= b + height d; the generic sequence
-- adds at most one.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Dialogue[l] ; open Brouwer[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

height : B Nat -> Br = split { eta n -> Zb ; beta phi i | r -> Lb (\ n -> Sb (r n)) } ;

height-relabel (f : Nat -> Nat) : (d : B Nat) -> Id Br (height (fmap Nat Nat f d)) (height d) = split {
  eta n -> refl Zb ;
  beta phi i | r -> apH (\ g -> Lb g) (FL.funext Nat (\ n -> Br)
    (\ n -> Sb (height (fmap Nat Nat f (phi n)))) (\ n -> Sb (height (phi n))) (\ n -> apH (\ b -> Sb b) (r n))) } ;

height-kleisli (g : Nat -> B Nat) (b : Br) (bound : (k : Nat) -> Le (height (g k)) b)
  : (d : B Nat) -> Le (height (kleisli Nat Nat g d)) (add b (height d)) = split {
  eta k -> bound k ;
  beta phi i | r -> le-L-mono (\ n -> Sb (height (kleisli Nat Nat g (phi n)))) (\ n -> Sb (add b (height (phi n)))) r } ;

height-generic : (d : B Nat) -> Le (height (generic d)) (Sb (height d)) = split {
  eta n -> \ m -> tt ;
  beta phi i | r -> \ m -> le-trans (height (generic (phi m))) (Sb (height (phi m))) (Lb (\ n -> Sb (height (phi n))))
    (r m) (upper (\ n -> Sb (height (phi n))) m) } ;
