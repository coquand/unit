-- Lower.seg: terms and trees of prescribed height (Agda DialogueTrees.Examples).
--
-- Three terms of System T, written with the combinators, whose trees are
-- computed: a leaf (K 0), one query (f |-> f 0), and the term
-- f |-> iter f (f 0) (f 0), which asks the oracle at 0 and then as many
-- further times as the answer says; its tree has height omega = tower 0
-- (both bounds).  The lower bound: one application of the oracle raises a
-- numeral below the height by one, by induction on the numeral, carried
-- through a single branch.  The upper bound: k applications raise the
-- height by at most k.
--
-- Then the trees: every code a is below the height of the tree tree-of a
-- read off the code, so the trees reach every height, eps0 included; but
-- a < S a for every code (S-irrefl), so by the main theorem tree-of eps0 is
-- the tree of no term.
--
-- Agda I is Examples.I (the middle K has type s -> s -> s here, not
-- s -> N -> s).  As in Bound.seg, no-term-of-height-eps0 is stated for
-- every typed term (Omega allowed); the three example terms are Omega-free
-- and come with the proofs.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Dialogue[l] ; open Models[l] ;
open Brouwer[l] ; open Height[l] ; open Ordinals[l] ; open Epsilon0[l] ; open Bound[l] ;

-- Agda: I, as a term of T
I-free (s : Ty) : OmegaFree (Examples[l].I s) = ((tt, tt), tt) ;

------------------------------------------------------------------------
-- the three terms

-- Agda: leaf-term  (K 0)
leaf-term : Tm = App iota (K iota nat2) Zero ;
leaf-has : Has leaf-term FT = (refl (kTy iota nat2), refl iota) ;
leaf-free : OmegaFree leaf-term = (tt, tt) ;

-- Agda: query-term  (S I (K 0): f |-> f 0)
query-term : Tm = App (arr nat2 iota) (App (arr nat2 nat2) (S nat2 iota iota) (Examples[l].I nat2)) (App iota (K iota nat2) Zero) ;
query-has : Has query-term FT = ((refl (sTy nat2 iota iota), Examples[l].hI nat2), (refl (kTy iota nat2), refl iota)) ;
query-free : OmegaFree query-term = ((tt, I-free nat2), (tt, tt)) ;

-- Agda: iterated-term  (S (S (S (K Iter) I) q) q: f |-> iter f (f 0) (f 0))
iter-I : Tm = App (arr nat2 nat2) (App (arr nat2 (iterTy iota)) (S nat2 nat2 (arr iota (arr iota iota)))
    (App (iterTy iota) (K (iterTy iota) nat2) (Iter iota))) (Examples[l].I nat2) ;
iter-I-has : Has iter-I (arr nat2 (arr iota (arr iota iota))) =
  ((refl (sTy nat2 nat2 (arr iota (arr iota iota))), (refl (kTy (iterTy iota) nat2), refl (iterTy iota))), Examples[l].hI nat2) ;
iter-I-free : OmegaFree iter-I = ((tt, (tt, tt)), I-free nat2) ;
iterated-term : Tm = App (arr nat2 iota) (App (arr nat2 (arr iota iota)) (S nat2 iota iota)
    (App (arr nat2 iota) (App (arr nat2 (arr iota (arr iota iota))) (S nat2 iota (arr iota iota)) iter-I) query-term)) query-term ;
iterated-has : Has iterated-term FT =
  ((refl (sTy nat2 iota iota), ((refl (sTy nat2 iota (arr iota iota)), iter-I-has), query-has)), query-has) ;
iterated-free : OmegaFree iterated-term = ((tt, ((tt, iter-I-free), query-free)), query-free) ;

-- the tree of one query at 0
q0 : B Nat = beta (\ m -> eta m) zero ;

-- Agda: leaf-tree, query-tree, iterated-tree  (by computation)
leaf-tree : Id (B Nat) (tree leaf-term leaf-has) (eta zero) = refl (eta zero) ;
query-tree : Id (B Nat) (tree query-term query-has) q0 = refl q0 ;
iterated-tree : Id (B Nat) (tree iterated-term iterated-has) (beta (\ j -> iterN (B Nat) generic q0 j) zero) =
  refl (beta (\ j -> iterN (B Nat) generic q0 j) zero) ;

-- Agda: leaf-height, query-height-≤, query-height-≥
leaf-height : Id Br (height (tree leaf-term leaf-has)) Zb = refl Zb ;
query-height-le : Le (height (tree query-term query-has)) (Sb Zb) = \ n -> tt ;
query-height-ge : Le (Sb Zb) (height (tree query-term query-has)) = (zero, tt) ;

------------------------------------------------------------------------
-- the height of the iterated term

-- Agda: ι-generic  (one oracle call raises a numeral below the height by one)
iota-generic-zero : (d : B Nat) -> Le (numB (suc zero)) (height (generic d)) = split {
  eta n -> (zero, tt) ;
  beta phi i -> (zero, tt) } ;
iota-generic : (k : Nat) -> (d : B Nat) -> Le (numB k) (height d) -> Le (numB (suc k)) (height (generic d)) = split {
  zero -> \ d p -> iota-generic-zero d ;
  suc k | r -> split {
    eta n -> \ p -> absurd (Le (numB (suc (suc k))) (height (generic (eta n)))) p ;
    beta phi i -> \ p -> (p.1, r (phi p.1) p.2) } } ;

-- Agda: ι-iter
iota-iter : (k : Nat) -> (d : B Nat) -> Le (numB k) (height (iterN (B Nat) generic d k)) = split {
  zero -> \ d -> tt ;
  suc k | r -> \ d -> iota-generic k (iterN (B Nat) generic d k) (r d) } ;

-- Agda: iter-generic-≤  (k oracle calls raise the height by at most k)
iter-generic-le : (k : Nat) -> (d : B Nat) -> Le (height (iterN (B Nat) generic d k)) (add (height d) (numB k)) = split {
  zero -> \ d -> le-refl (height d) ;
  suc k | r -> \ d -> le-trans (height (generic (iterN (B Nat) generic d k))) (Sb (height (iterN (B Nat) generic d k)))
    (Sb (add (height d) (numB k))) (height-generic (iterN (B Nat) generic d k)) (r d) } ;

-- Agda: one⊕ι
one-add-num : (k : Nat) -> Id Br (add (Sb Zb) (numB k)) (numB (suc k)) = split {
  zero -> refl (Sb Zb) ;
  suc k | r -> apH (\ x -> Sb x) r } ;

-- the j-th subtree of the tree of the iterated term
itj (j : Nat) : B Nat = iterN (B Nat) generic q0 j ;

-- Agda: iterated-height-≥
iterated-height-ge : Le (tower zero) (height (tree iterated-term iterated-has)) = \ j ->
  le-l (numB j) (\ m -> Sb (height (itj m))) j
    (le-trans (numB j) (height (itj j)) (Sb (height (itj j))) (iota-iter j q0) (S-increasing (height (itj j)))) ;

-- Agda: iterated-height-≤ (base≤, step)
base-le : Le (height q0) (Sb Zb) = \ n -> tt ;
iterated-step (j : Nat) : Le (height (itj j)) (numB (suc j)) =
  le-trans (height (itj j)) (add (height q0) (numB j)) (numB (suc j)) (iter-generic-le j q0)
    (substH (\ x -> Le (add (height q0) (numB j)) x) (one-add-num j) (add-mono-left (height q0) (Sb Zb) base-le (numB j))) ;
iterated-height-le : Le (height (tree iterated-term iterated-has)) (tower zero) = \ j ->
  le-l (Sb (height (itj j))) numB (suc (suc j)) (iterated-step j) ;

------------------------------------------------------------------------
-- the tree read off a code

-- Agda: tree-of
tree-of : Br -> B Nat = split {
  Zb -> eta zero ;
  Sb a | r -> beta (\ n -> r) zero ;
  Lb f | r -> beta r zero } ;

-- Agda: code-≤-height
code-le-height : (a : Br) -> Le a (height (tree-of a)) = split {
  Zb -> tt ;
  Sb a | r -> (zero, r) ;
  Lb f | r -> \ n -> le-l (f n) (\ m -> Sb (height (tree-of (f m)))) n
    (le-trans (f n) (height (tree-of (f n))) (Sb (height (tree-of (f n)))) (r n) (S-increasing (height (tree-of (f n))))) } ;

-- Agda: approximant, epsilon₀
approximant (n : Nat) : Le (tower n) (height (tree-of (tower n))) = code-le-height (tower n) ;
epsilon0 : Le eps0 (height (tree-of eps0)) = code-le-height eps0 ;

-- Agda: S-irrefl
S-irrefl : (a : Br) -> Le (Sb a) a -> Empty = split {
  Zb -> \ p -> p ;
  Sb a | r -> \ p -> r p ;
  Lb f | r -> \ p -> r p.1 (le-trans (Sb (f p.1)) (Sb (Lb f)) (f p.1) (upper f p.1) p.2) } ;

-- Agda: no-term-of-height-ε₀
no-term-of-height-eps0 (e : Tm) (h : Has e FT) (q : Id (B Nat) (tree e h) (tree-of eps0)) : Empty =
  S-irrefl eps0 (le-trans (Sb eps0) (Sb (height (tree e h))) eps0
    (substH (\ x -> Le eps0 (height x)) (symH q) epsilon0) (dialogue-tree-height-lt-eps0 e h)) ;
