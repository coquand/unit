-- Predicate.seg: the hereditary predicate over the types of System T
-- (Agda DialogueTrees.Predicate).
--
-- The majorant of a term is bounded by a tuple of ordinal data, graded by
-- the order of its type,  ord iota = 0,  ord (s => t) = max (ord s + 1) (ord t),
-- of width wd t = ord t + 1.  The width of a datum for s => t is the width
-- WD (wd s) (wd t) of a datum for a graded map from width wd s to width wd t
-- (definitionally), so at an arrow the datum is read as such a map (rdOf)
-- and applied (rect).  The predicate Dom: at iota the majorant is below the
-- sum of the datum; at an arrow, for every argument with a datum below eps0
-- satisfying the predicate, the value satisfies it at the applied datum.
--
-- Common properties: Dom is monotone in the datum (reading and action are
-- monotone), closed under the supremum MajSup (upper bound of L, then
-- under the argument), and under the translation MajAdd by v when the
-- datum is adjusted by addNu (rect-addNu); at iota it gives a bound below
-- eps0.  The clauses for Zero, Succ (the action of a square map is
-- inflationary), Omega (the oracle adds one query, paid by the slot 1 of
-- order zero, x + 1 <= (a + 1) * w^s), K (rect-arg-ge then rect-rdOf-ge:
-- the kept datum survives both applications), and application (the arrow
-- clause read forwards).
--
-- Deviations: Agda ≤-L hs and ≤-S h are hs and h (Le is recursive); the
-- datum of order zero d : Tup 1 is (d.1, tt) by eta, so the Agda pattern
-- (z , ⋆) is d.1; Agda ⊑-trans is leT-trans, ⊕-mono-left/right are
-- add-mono-left/right, x-≤-x⊗ is le-mul-right, one-≤-ω^ is one-le-wexp.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Brouwer[l] ; open Ordinals[l] ;
open Epsilon0[l] ; open Tuples[l] ; open Cascade[l] ; open Rect[l] ; open Majorant[l] ;

------------------------------------------------------------------------
-- the predicate

-- Agda: ord, wd
ord : Ty -> Nat = split { iota -> zero ; arr s t | a b -> maxN (suc a) b } ;
wd (t : Ty) : Nat = suc (ord t) ;

-- Agda: Dom
Dom : (t : Ty) -> MV t -> Tup (wd t) -> U l = split {
  iota -> \ a d -> Le a (tsum (suc zero) d) ;
  arr s t | ds dt -> \ F d -> (x : MV s) -> (e : Tup (wd s)) -> AllLt (wd s) e -> ds x e
    -> dt (F x) (rect (wd s) (wd t) (rdOf (wd s) (wd t) d) e) } ;

------------------------------------------------------------------------
-- monotone, closed under supremum and translation, bounded at iota

-- Agda: Dom-mono
Dom-mono : (t : Ty) -> (x : MV t) -> (d d' : Tup (wd t)) -> Dom t x d -> leT (wd t) d d' -> Dom t x d' = split {
  iota -> \ a d d' h p -> le-trans a (tsum (suc zero) d) (tsum (suc zero) d') h (tsum-mono (suc zero) d d' p) ;
  arr s t | ms mt -> \ F d d' h p x e ae he ->
    mt (F x) (rect (wd s) (wd t) (rdOf (wd s) (wd t) d) e) (rect (wd s) (wd t) (rdOf (wd s) (wd t) d') e)
      (h x e ae he)
      (rect-leRD (wd s) (wd t) (rdOf (wd s) (wd t) d) (rdOf (wd s) (wd t) d') (rdOf-mono (wd s) (wd t) d d' p) e) } ;

-- Agda: Dom-sup
Dom-sup : (t : Ty) -> (h : Nat -> MV t) -> (d : Tup (wd t)) -> ((n : Nat) -> Dom t (h n) d) -> Dom t (MajSup t h) d = split {
  iota -> \ h d hs -> hs ;
  arr s t | ss st -> \ h d hs x e ae he ->
    st (\ n -> h n x) (rect (wd s) (wd t) (rdOf (wd s) (wd t) d) e) (\ n -> hs n x e ae he) } ;

-- Agda: Dom-⊕
Dom-add : (t : Ty) -> (x : MV t) -> (nu dnu : Br) -> (d : Tup (wd t)) -> Dom t x d -> Le nu dnu
  -> Dom t (MajAdd t x nu) (addNu (wd t) d dnu) = split {
  iota -> \ a nu dnu d h hnu ->
    le-trans (add a nu) (add d.1 nu) (add d.1 dnu) (add-mono-left a d.1 h nu) (add-mono-right d.1 nu dnu hnu) ;
  arr s t | as at -> \ F nu dnu d h hnu x e ae he ->
    Dom-mono t (MajAdd t (F x) nu) (addNu (wd t) (rect (wd s) (wd t) (rdOf (wd s) (wd t) d) e) dnu)
      (rect (wd s) (wd t) (rdOf (wd s) (wd t) (addNu (wd (arr s t)) d dnu)) e)
      (at (F x) nu dnu (rect (wd s) (wd t) (rdOf (wd s) (wd t) d) e) (h x e ae he) hnu)
      (rect-addNu (wd s) (wd t) d e dnu) } ;

-- Agda: Dom-<-ε₀
Dom-lt-eps0 (a : Br) (d : Tup (suc zero)) (h : Dom iota a d) (p : AllLt (suc zero) d) : Lt a eps0 =
  le-trans (Sb a) (Sb (tsum (suc zero) d)) eps0 h (tsum-lt-eps0 (suc zero) d p) ;

------------------------------------------------------------------------
-- the clauses that follow from these properties

-- Agda: Zero-clause, Succ-clause, Ω-clause
Zero-clause (d : Tup (suc zero)) : Dom iota mu-Zero d = tt ;
Succ-clause (d : Tup (wd nat2)) : Dom nat2 mu-Succ d = \ x e ae hx ->
  le-trans x (tsum (suc zero) e) (tsum (suc zero) (rect (suc zero) (suc zero) (rdOf (suc zero) (suc zero) d) e)) hx
    (tsum-mono (suc zero) e (rect (suc zero) (suc zero) (rdOf (suc zero) (suc zero) d) e)
      (rect-increasing (suc zero) (rdOf (suc zero) (suc zero) d) e)) ;
Omega-clause (s : Br) : Dom nat2 mu-Omega (Sb Zb, (s, tt)) = \ x e ae hx ->
  le-trans (Sb x) (Sb e.1) (mul (Sb e.1) (wexp s)) hx (le-mul-right (Sb e.1) (wexp s) (one-le-wexp s)) ;

-- Agda: app-clause
app-clause (s t : Ty) (F : MV (arr s t)) (x : MV s) (d : Tup (wd (arr s t))) (e : Tup (wd s))
  (hF : Dom (arr s t) F d) (ae : AllLt (wd s) e) (hx : Dom s x e)
  : Dom t (F x) (rect (wd s) (wd t) (rdOf (wd s) (wd t) d) e) = hF x e ae hx ;

-- Agda: K-clause
K-clause (s u : Ty) (d : Tup (wd (kTy s u))) : Dom (kTy s u) (mu-K s u) d = \ x e ae he y f af hf ->
  Dom-mono s x e (rect (wd u) (wd s) (rdOf (wd u) (wd s) (g e)) f) he
    (leT-trans (wd s) e (topq (wd u) (wd s) (g e)) (rect (wd u) (wd s) (rdOf (wd u) (wd s) (g e)) f)
      (rect-arg-ge (wd u) (wd s) (rdOf (wd s) (wd (arr u s)) d) e)
      (rect-rdOf-ge (wd u) (wd s) (g e) f))
 where {
   g (e : Tup (wd s)) : Tup (wd (arr u s)) = rect (wd s) (wd (arr u s)) (rdOf (wd s) (wd (arr u s)) d) e ;
 } ;
