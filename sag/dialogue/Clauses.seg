-- Clauses.seg: the clauses for S and for the recursor (Agda
-- DialogueTrees.SClause and DialogueTrees.IterClause).
--
-- S.  The proof is the one a reader of  \ f g a -> f a (g a)  writes.  The
-- three data dF, dG, e arrive one at a time and are combined, in the order
-- in which they are bound, into one tuple u3 = cmb e (cmb dG dF); each is
-- below u3 in the prefix order, so its predicate passes to the action of
-- the zero datum at u3 (rect-leInit).  The body is two applications over
-- that one tuple (rect-ssub twice: the datum B = sh (sh DF De) (sh DG De));
-- the three binders are undone by rect-curry, rect-curry and flatRD-ge
-- (currying with an empty context).  The datum dS depends only on the
-- three widths.
--
-- Recursor.  The data dphi, da, dnu are combined into u3 = cmb dnu (cmb da
-- dphi); every iterate datum of the step from da is below the orbit
-- datum's action at u3 (rorbit-act), so the predicate holds for the
-- supremum of the iterates (Dom-sup) at that bound D, and for the
-- translation by nu at addNu D v (Dom-add, v the code of the count); the
-- translation is absorbed by addRDc (rect-addNuc, v belonging to u3), and
-- the binders are undone as for S.
--
-- Deviations: Agda's `module _ (ρ σ τ : type)` and `module _ (σ : type)`
-- are the parameterised modules SDatum and IDatum; Agda's clause is a
-- lambda with a where block, here the clause at given arguments
-- (S-clause-at, Iter-clause-at, the data d1 d2 of the binders named in the
-- module) and the clause as its abstraction.  The two inductions of the
-- Agda's where block (dseq<, domseq) are module definitions (a split may
-- not stand in a where).  Agda iter is Models.iterN, ⊴ is leInit, rect-⊴
-- is rect-leInit, ⊑-trans is leT-trans, flatRD-⊒ is flatRD-ge.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Brouwer[l] ; open Ordinals[l] ;
open Epsilon0[l] ; open Tuples[l] ; open Cascade[l] ; open Rect[l] ; open RectAlgebra[l] ;
open RectApply[l] ; open RectCurry[l] ; open RectOrbit[l] ; open Majorant[l] ; open Predicate[l] ;

------------------------------------------------------------------------
-- the clause for S

module SDatum (r s u : Ty) {
  -- Agda: m p q WF WG W2 n₂ n₃
  m : Nat = wd r ;
  p : Nat = wd s ;
  q : Nat = wd u ;
  WF : Nat = WD m (WD p q) ;
  WG : Nat = WD m p ;
  W2 : Nat = WD WG (WD m q) ;
  n2 : Nat = maxN WG WF ;
  n3 : Nat = maxN m n2 ;

  -- Agda: De DF DG A₁ A₂ B B₂ B₃ dS
  De : RD n3 m = zeroRD n3 m ;
  DF : RD n3 WF = zeroRD n3 WF ;
  DG : RD n3 WG = zeroRD n3 WG ;
  A1 : RD n3 (WD p q) = sh n3 m (WD p q) DF De ;
  A2 : RD n3 p = sh n3 m p DG De ;
  B : RD n3 q = sh n3 p q A1 A2 ;
  B2 : RD n2 (WD m q) = curryD m n2 q B ;
  B3 : RD WF W2 = curryD WG WF (WD m q) B2 ;
  dS : Tup (WD WF W2) = flatRD WF W2 B3 ;

  -- Agda: A₁-All<, A₂-All<, B-All<, dS-All<
  A1-AllLt : RDAllLt n3 (WD p q) A1 = sh-AllLt n3 m (WD p q) DF De (zeroRD-AllLt n3 WF) (zeroRD-AllLt n3 m) ;
  A2-AllLt : RDAllLt n3 p A2 = sh-AllLt n3 m p DG De (zeroRD-AllLt n3 WG) (zeroRD-AllLt n3 m) ;
  B-AllLt : RDAllLt n3 q B = sh-AllLt n3 p q A1 A2 A1-AllLt A2-AllLt ;
  dS-AllLt : AllLt (WD WF W2) dS =
    flatRD-AllLt WF W2 B3 (curryD-AllLt WG WF (WD m q) B2 (curryD-AllLt m n2 q B B-AllLt)) ;

  -- Agda: d1, d2  (the data after the first two binders)
  d1 (dF : Tup WF) : Tup W2 = rect WF W2 (rdOf WF W2 dS) dF ;
  d2 (dF : Tup WF) (dG : Tup WG) : Tup (WD m q) = rect WG (WD m q) (rdOf WG (WD m q) (d1 dF)) dG ;

  -- Agda: S-clause (its body, at the arguments)
  S-clause-at (F : MV (arr r (arr s u))) (dF : Tup WF) (aF : AllLt WF dF) (hF : Dom (arr r (arr s u)) F dF)
    (G : MV (arr r s)) (dG : Tup WG) (aG : AllLt WG dG) (hG : Dom (arr r s) G dG)
    (a : MV r) (e : Tup m) (ae : AllLt m e) (ha : Dom r a e)
    : Dom u (mu-S r s u F G a) (rect m q (rdOf m q (d2 dF dG)) e) =
    Dom-mono u (F a (G a)) (rect n3 q B u3) (rect m q (rdOf m q (d2 dF dG)) e) body fin
   where {
     u2 : Tup n2 = cmb WG WF dG dF ;
     u3 : Tup n3 = cmb m n2 e u2 ;
     Au2 : AllLt n2 u2 = cmb-AllLt WG WF dG dF aG aF ;
     Au3 : AllLt n3 u3 = cmb-AllLt m n2 e u2 ae Au2 ;
     e-le : leInit m n3 e u3 = cmb-leInit-left m n2 e u2 ;
     dG-le : leInit WG n3 dG u3 =
       leInit-trans WG n2 n3 dG u2 u3 (cmb-leInit-left WG WF dG dF) (cmb-leInit-right m n2 e u2) ;
     dF-le : leInit WF n3 dF u3 =
       leInit-trans WF n2 n3 dF u2 u3 (cmb-leInit-right WG WF dG dF) (cmb-leInit-right m n2 e u2) ;
     ea : Tup m = rect n3 m De u3 ;
     fa : Tup WF = rect n3 WF DF u3 ;
     ga : Tup WG = rect n3 WG DG u3 ;
     Aea : AllLt m ea = rect-AllLt n3 m De u3 (zeroRD-AllLt n3 m) Au3 ;
     hea : Dom r a ea = Dom-mono r a e ea ha (rect-leInit n3 m u3 e e-le) ;
     hfa : Dom (arr r (arr s u)) F fa = Dom-mono (arr r (arr s u)) F dF fa hF (rect-leInit n3 WF u3 dF dF-le) ;
     hga : Dom (arr r s) G ga = Dom-mono (arr r s) G dG ga hG (rect-leInit n3 WG u3 dG dG-le) ;
     h1 : Dom (arr s u) (F a) (rect n3 (WD p q) A1 u3) =
       Dom-mono (arr s u) (F a) (rect m (WD p q) (rdOf m (WD p q) fa) ea) (rect n3 (WD p q) A1 u3)
         (hfa a ea Aea hea) (rect-ssub n3 m (WD p q) DF De u3) ;
     h2 : Dom s (G a) (rect n3 p A2 u3) =
       Dom-mono s (G a) (rect m p (rdOf m p ga) ea) (rect n3 p A2 u3) (hga a ea Aea hea) (rect-ssub n3 m p DG De u3) ;
     A2All : AllLt p (rect n3 p A2 u3) = rect-AllLt n3 p A2 u3 A2-AllLt Au3 ;
     body : Dom u (F a (G a)) (rect n3 q B u3) =
       Dom-mono u (F a (G a)) (rect p q (rdOf p q (rect n3 (WD p q) A1 u3)) (rect n3 p A2 u3)) (rect n3 q B u3)
         (h1 (G a) (rect n3 p A2 u3) A2All h2) (rect-ssub n3 p q A1 A2 u3) ;
     g1 : leT W2 (rect WF W2 B3 dF) (d1 dF) = rect-leRD WF W2 B3 (rdOf WF W2 dS) (flatRD-ge WF W2 B3) dF ;
     g2 : leT (WD m q) (rect n2 (WD m q) B2 u2) (d2 dF dG) =
       leT-trans (WD m q) (rect n2 (WD m q) B2 u2) (rect WG (WD m q) (rdOf WG (WD m q) (rect WF W2 B3 dF)) dG) (d2 dF dG)
         (rect-curry WG WF (WD m q) B2 dG dF)
         (rect-leRD WG (WD m q) (rdOf WG (WD m q) (rect WF W2 B3 dF)) (rdOf WG (WD m q) (d1 dF))
           (rdOf-mono WG (WD m q) (rect WF W2 B3 dF) (d1 dF) g1) dG) ;
     fin : leT q (rect n3 q B u3) (rect m q (rdOf m q (d2 dF dG)) e) =
       leT-trans q (rect n3 q B u3) (rect m q (rdOf m q (rect n2 (WD m q) B2 u2)) e) (rect m q (rdOf m q (d2 dF dG)) e)
         (rect-curry m n2 q B e u2)
         (rect-leRD m q (rdOf m q (rect n2 (WD m q) B2 u2)) (rdOf m q (d2 dF dG))
           (rdOf-mono m q (rect n2 (WD m q) B2 u2) (d2 dF dG) g2) e) ;
   } ;

  -- Agda: S-clause
  S-clause : Dom (sTy r s u) (mu-S r s u) dS = S-clause-at ;
} ;

------------------------------------------------------------------------
-- the clause for the recursor

module IDatum (s : Ty) {
  -- Agda: p Wφ Wν Wa n₂ n₃
  p : Nat = wd s ;
  Wphi : Nat = WD p p ;
  Wnu : Nat = WD (suc zero) p ;
  Wa : Nat = WD p Wnu ;
  n2 : Nat = maxN p Wphi ;
  n3 : Nat = maxN (suc zero) n2 ;

  -- Agda: DI DI₂ DI₃ dI dI-All<
  DI : RD n3 p = addRDc n3 p (rorbitD n3 p) ;
  DI2 : RD n2 Wnu = curryD (suc zero) n2 p DI ;
  DI3 : RD Wphi Wa = curryD p Wphi Wnu DI2 ;
  dI : Tup (WD Wphi Wa) = flatRD Wphi Wa DI3 ;
  dI-AllLt : AllLt (WD Wphi Wa) dI =
    flatRD-AllLt Wphi Wa DI3 (curryD-AllLt p Wphi Wnu DI2 (curryD-AllLt (suc zero) n2 p DI
      (addRDc-AllLt n3 p (rorbitD n3 p) (rorbitD-AllLt n3 p)))) ;

  -- Agda: dseq, dseq<, domseq (in Iter-clause's where)
  dseq (dphi : Tup Wphi) (da : Tup p) (n : Nat) : Tup p = Models[l].iterN (Tup p) (rect p p (rdOf p p dphi)) da n ;
  dseq-AllLt (dphi : Tup Wphi) (aphi : AllLt Wphi dphi) (da : Tup p) (aa : AllLt p da)
    : (n : Nat) -> AllLt p (dseq dphi da n) = split {
    zero -> aa ;
    suc n | r -> rect-AllLt p p (rdOf p p dphi) (dseq dphi da n) (rdOf-AllLt p p dphi aphi) r } ;
  domseq (phi : MV (arr s s)) (dphi : Tup Wphi) (aphi : AllLt Wphi dphi) (hphi : Dom (arr s s) phi dphi)
    (a : MV s) (da : Tup p) (aa : AllLt p da) (ha : Dom s a da)
    : (n : Nat) -> Dom s (Models[l].iterN (MV s) phi a n) (dseq dphi da n) = split {
    zero -> ha ;
    suc n | r -> hphi (Models[l].iterN (MV s) phi a n) (dseq dphi da n) (dseq-AllLt dphi aphi da aa n) r } ;

  -- Agda: d1, d2  (the data after the first two binders)
  d1 (dphi : Tup Wphi) : Tup Wa = rect Wphi Wa (rdOf Wphi Wa dI) dphi ;
  d2 (dphi : Tup Wphi) (da : Tup p) : Tup Wnu = rect p Wnu (rdOf p Wnu (d1 dphi)) da ;

  -- Agda: Iter-clause (its body, at the arguments)
  Iter-clause-at (phi : MV (arr s s)) (dphi : Tup Wphi) (aphi : AllLt Wphi dphi) (hphi : Dom (arr s s) phi dphi)
    (a : MV s) (da : Tup p) (aa : AllLt p da) (ha : Dom s a da)
    (nu : Br) (dnu : Tup (suc zero)) (anu : AllLt (suc zero) dnu) (hnu : Dom iota nu dnu)
    : Dom s (mu-Iter s phi a nu) (rect (suc zero) p (rdOf (suc zero) p (d2 dphi da)) dnu) =
    Dom-mono s (mu-Iter s phi a nu) (addNu p D v) (rect (suc zero) p (rdOf (suc zero) p (d2 dphi da)) dnu) main fin
   where {
     v : Br = dnu.1 ;
     u2 : Tup n2 = cmb p Wphi da dphi ;
     u3 : Tup n3 = cmb (suc zero) n2 dnu u2 ;
     Au2 : AllLt n2 u2 = cmb-AllLt p Wphi da dphi aa aphi ;
     Au3 : AllLt n3 u3 = cmb-AllLt (suc zero) n2 dnu u2 anu Au2 ;
     dnu-le : leInit (suc zero) n3 dnu u3 = cmb-leInit-left (suc zero) n2 dnu u2 ;
     da-le : leInit p n3 da u3 =
       leInit-trans p n2 n3 da u2 u3 (cmb-leInit-left p Wphi da dphi) (cmb-leInit-right (suc zero) n2 dnu u2) ;
     dphi-le : leInit Wphi n3 dphi u3 =
       leInit-trans Wphi n2 n3 dphi u2 u3 (cmb-leInit-right p Wphi da dphi) (cmb-leInit-right (suc zero) n2 dnu u2) ;
     D : Tup p = rect n3 p (rorbitD n3 p) u3 ;
     bd (n : Nat) : leT p (dseq dphi da n) D = rorbit-act n3 p dphi da u3 Au3 dphi-le da-le n ;
     sup : Dom s (MajSup s (Models[l].iterN (MV s) phi a)) D =
       Dom-sup s (Models[l].iterN (MV s) phi a) D (\ n ->
         Dom-mono s (Models[l].iterN (MV s) phi a n) (dseq dphi da n) D (domseq phi dphi aphi hphi a da aa ha n) (bd n)) ;
     main : Dom s (mu-Iter s phi a nu) (addNu p D v) =
       Dom-add s (MajSup s (Models[l].iterN (MV s) phi a)) nu v D sup hnu ;
     g3 : leT Wa (rect Wphi Wa DI3 dphi) (d1 dphi) = rect-leRD Wphi Wa DI3 (rdOf Wphi Wa dI) (flatRD-ge Wphi Wa DI3) dphi ;
     g2 : leT Wnu (rect n2 Wnu DI2 u2) (d2 dphi da) =
       leT-trans Wnu (rect n2 Wnu DI2 u2) (rect p Wnu (rdOf p Wnu (rect Wphi Wa DI3 dphi)) da) (d2 dphi da)
         (rect-curry p Wphi Wnu DI2 da dphi)
         (rect-leRD p Wnu (rdOf p Wnu (rect Wphi Wa DI3 dphi)) (rdOf p Wnu (d1 dphi))
           (rdOf-mono p Wnu (rect Wphi Wa DI3 dphi) (d1 dphi) g3) da) ;
     g1 : leT p (rect n3 p DI u3) (rect (suc zero) p (rdOf (suc zero) p (d2 dphi da)) dnu) =
       leT-trans p (rect n3 p DI u3) (rect (suc zero) p (rdOf (suc zero) p (rect n2 Wnu DI2 u2)) dnu)
         (rect (suc zero) p (rdOf (suc zero) p (d2 dphi da)) dnu)
         (rect-curry (suc zero) n2 p DI dnu u2)
         (rect-leRD (suc zero) p (rdOf (suc zero) p (rect n2 Wnu DI2 u2)) (rdOf (suc zero) p (d2 dphi da))
           (rdOf-mono (suc zero) p (rect n2 Wnu DI2 u2) (d2 dphi da) g2) dnu) ;
     fin : leT p (addNu p D v) (rect (suc zero) p (rdOf (suc zero) p (d2 dphi da)) dnu) =
       leT-trans p (addNu p D v) (rect n3 p DI u3) (rect (suc zero) p (rdOf (suc zero) p (d2 dphi da)) dnu)
         (rect-addNuc n3 p (rorbitD n3 p) u3 v dnu-le) g1 ;
   } ;

  -- Agda: Iter-clause
  Iter-clause : Dom (iterTy s) (mu-Iter s) dI = Iter-clause-at ;
} ;
