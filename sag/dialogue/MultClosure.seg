-- MultClosure.seg: the closure of eps0 under multiplication (Agda
-- BrouwerOrdinals.MultClosure).
--
-- The exponent law  w^a * w^b = w^(a+b)  (induction on b, through
-- associativity of the product) and  tower n + tower n <= tower (n+1)
-- give  tower n * tower n = w^(tower m + tower m) <= tower (n+1); the
-- closure is then Closure2 of Epsilon0 at mul.  Also  1 + b <= S b.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ;

-- Agda: S⊕≤S
one-add-le-S : (b : Br) -> Le (add one b) (Sb b) = split {
  Zb -> le-refl one ;
  Sb b | r -> r ;
  Lb f | r -> \ n -> le-trans (add one (f n)) (Sb (f n)) (Sb (Lb f)) (r n) (upper f n) } ;

-- Agda: ω^⊗
wexp-mul (a : Br) : (b : Br) -> Id Br (mul (wexp a) (wexp b)) (wexp (add a b)) = split {
  Zb -> Z-left-unit (wexp a) ;
  Sb b | r -> calc Br {
    mul (wexp a) (mul (wexp b) omega) =< symH (mul-assoc (wexp a) (wexp b) omega) >
    mul (mul (wexp a) (wexp b)) omega =< apH (\ z -> mul z omega) r >
    mul (wexp (add a b)) omega } ;
  Lb f | r -> lim-ext (\ n -> mul (wexp a) (wexp (f n))) (\ n -> wexp (add a (f n))) r } ;

-- Agda: tower-sq
omega-sq : Id Br (mul omega omega) (wexp two) = calc Br {
  mul omega omega =< apH (\ z -> mul z z) (symH wexp-one) >
  mul (wexp one) (wexp one) =< wexp-mul one one >
  wexp two } ;
tower-sq : (n : Nat) -> Le (mul (tower n) (tower n)) (tower (suc n)) = split {
  zero -> substH (\ z -> Le z (tower (suc zero))) (symH omega-sq)
    (wexp-mono two omega (num-le-omega (suc (suc zero)))) ;
  suc m -> substH (\ z -> Le z (tower (suc (suc m)))) (symH (wexp-mul (tower m) (tower m)))
    (wexp-mono (add (tower m) (tower m)) (tower (suc m)) (tower-double m)) } ;

-- the product is monotone in both arguments
mul-mono (a a' b b' : Br) (p : Le a a') (q : Le b b') : Le (mul a b) (mul a' b') =
  le-trans (mul a b) (mul a' b) (mul a' b') (mul-mono-left a a' p b) (mul-mono-right a' b b' q) ;

-- Agda: ⊗-<-ε₀
mul-lt-eps0 (a b : Br) : Lt a eps0 -> Lt b eps0 -> Lt (mul a b) eps0 =
  Closure2[mul, mul-mono, tower-sq].close a b ;
