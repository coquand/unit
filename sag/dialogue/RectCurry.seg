-- RectCurry.seg: currying a datum (Agda BrouwerOrdinals.RectCurry), the
-- clause for application of a datum to a split input.
--
-- An input of width max p n is combined from y of width p and x of width
-- n by adding entrywise (cmb); both are below it in the prefix order.  A
-- datum D on the combined input is curried into curryD D, a datum on x
-- whose output, read as a datum on y, dominates D (rect-curry).  At each
-- output order the cascade of D is moved to the x side by scurryD: one
-- successor on its constant and two exponents of the product by w
-- (valSc-scurry: S (value) * w is below the value of the curried cascade;
-- the step absorbs the finite multiple of the constant into the next
-- exponent by FinMult, Affine.seg).  The curried data of the orders are
-- padded to a common width and joined (padRD, joinRD).
--
-- Deviations (RD 0 q = Tup q): tupToRD0 is the identity and rect-tupToRD0
-- a refl lemma, kept as names; rdOf-zero-id' is leT-refl; the transports
-- along rect-tupToRD0 disappear; tupToRD0-All< is the identity.
-- hdOf (suc n) E = (E, zeroRD n 0): Agda's RD n 0 is 1 for every n, here
-- only once n is a numeral.  Agda ≤-S ≤-Z (1 <= S a) is tt.  In valSc-scurry the two steps
-- 1 <= bR and c <= bR share the step S c <= bR (cb).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ; open Ordinals[l] ; open Epsilon0[l] ;
open MultClosure[l] ; open Affine[l] ; open Tuples[l] ; open Cascade[l] ; open Rect[l] ; open RectAlgebra[l] ;

------------------------------------------------------------------------
-- combining two inputs

-- Agda: cmb
cmb : (p : Nat) -> (n : Nat) -> Tup p -> Tup n -> Tup (maxN p n) = split {
  zero -> \ n y x -> x ;
  suc p | r -> split {
    zero -> \ y x -> y ;
    suc n -> \ y x -> (add y.1 x.1, r n y.2 x.2) } } ;

-- Agda: cmb-⊴-left, cmb-⊴-right, cmb-All<
cmb-leInit-left : (p : Nat) -> (n : Nat) -> (y : Tup p) -> (x : Tup n) -> leInit p (maxN p n) y (cmb p n y x) = split {
  zero -> \ n y x -> tt ;
  suc p | r -> split {
    zero -> \ y x -> leInit-refl (suc p) y ;
    suc n -> \ y x -> (add-increasing-right y.1 x.1, r n y.2 x.2) } } ;
cmb-leInit-right : (p : Nat) -> (n : Nat) -> (y : Tup p) -> (x : Tup n) -> leInit n (maxN p n) x (cmb p n y x) = split {
  zero -> \ n y x -> leInit-refl n x ;
  suc p | r -> split {
    zero -> \ y x -> tt ;
    suc n -> \ y x -> (add-increasing-left y.1 x.1, r n y.2 x.2) } } ;
cmb-AllLt : (p : Nat) -> (n : Nat) -> (y : Tup p) -> (x : Tup n) -> AllLt p y -> AllLt n x
  -> AllLt (maxN p n) (cmb p n y x) = split {
  zero -> \ n y x hy hx -> hx ;
  suc p | r -> split {
    zero -> \ y x hy hx -> hy ;
    suc n -> \ y x hy hx -> (add-lt-eps0 y.1 x.1 hy.1 hx.1, r n y.2 x.2 hy.2 hx.2) } } ;

-- Agda: tsum-cmb-⋖
tsum-cmb-fm : (p : Nat) -> (n : Nat) -> (y : Tup p) -> (x : Tup n) -> (M : Br) -> Le (tsum p y) M -> Le (tsum n x) M
  -> FinMult (tsum (maxN p n) (cmb p n y x)) M = split {
  zero -> \ n y x M hy hx -> fm-base M (tsum n x) hx ;
  suc p | r -> split {
    zero -> \ y x M hy hx -> fm-base M (tsum (suc p) y) hy ;
    suc n -> \ y x M hy hx ->
      fm-add M (add y.1 x.1) (tsum (maxN p n) (cmb p n y.2 x.2))
        (fm-add M y.1 x.1
          (fm-base M y.1 (le-trans y.1 (add y.1 (tsum p y.2)) M (add-increasing-right y.1 (tsum p y.2)) hy))
          (fm-base M x.1 (le-trans x.1 (add x.1 (tsum n x.2)) M (add-increasing-right x.1 (tsum n x.2)) hx)))
        (r n y.2 x.2 M
          (le-trans (tsum p y.2) (add y.1 (tsum p y.2)) M (add-increasing-left y.1 (tsum p y.2)) hy)
          (le-trans (tsum n x.2) (add x.1 (tsum n x.2)) M (add-increasing-left x.1 (tsum n x.2)) hx)) } } ;

------------------------------------------------------------------------
-- one cascade as a datum, tuples as data on width 0

-- Agda: hdOf, hdOf-val
hdOf : (n : Nat) -> Sc n -> RD n (suc zero) = split {
  zero -> \ c -> (c, tt) ;
  suc n -> \ E -> (E, zeroRD n zero) } ;
hdOf-val : (n : Nat) -> (E : Sc n) -> (x : Tup n) -> Id Br (rect n (suc zero) (hdOf n E) x).1 (valSc n E x) = split {
  zero -> \ c x -> refl c ;
  suc n -> \ E x -> refl (valSc (suc n) E x) } ;

-- Agda: tupToRD0, rect-tupToRD0  (the identity, as RD 0 k = Tup k)
tupToRD0 (k : Nat) (t : Tup k) : RD zero k = t ;
rect-tupToRD0 (k : Nat) (t : Tup k) (x : Tup zero) : Id (Tup k) (rect zero k (tupToRD0 k t) x) t = refl t ;

-- Agda: tupToSc-scToTup
tupToSc-scToTup : (j : Nat) -> (E : Sc j) -> Id (Sc j) (tupToSc j (scToTup j E)) E = split {
  zero -> \ c -> refl c ;
  suc j | r -> \ E -> apH (\ y -> (E.1, y)) (r E.2) } ;

-- Agda: valSc-base
valSc-base (k : Nat) (c : Br) (E : Sc k) (a : Br) (t : Tup k)
  : Le (add (add a (tsum k t)) c) (valSc (suc k) (c, E) (a, t)) =
  le-mul-right (add (add a (tsum k t)) c) (wexp (valSc k E t)) (one-le-wexp (valSc k E t)) ;

------------------------------------------------------------------------
-- currying one cascade

-- Agda: scurryD
scurryD : (p : Nat) -> (n : Nat) -> Sc (maxN p n) -> RD n (suc p) = split {
  zero -> \ n E -> hdOf n (bumpSc n (sucSc n E)) ;
  suc p | r -> split {
    zero -> \ E -> tupToRD0 (suc (suc p)) (scToTup (suc p) (bumpSc (suc p) (sucSc (suc p) E))) ;
    suc n -> \ E -> ((Sb E.1, zeroSc n), r n E.2) } } ;

-- Agda: valSc-scurry (the case of positive widths)
valSc-scurry-step (p n : Nat) (E : Sc (suc (maxN p n))) (y : Tup (suc p)) (x : Tup (suc n))
  (ih : Le (mul (Sb (valSc (maxN p n) E.2 (cmb p n y.2 x.2))) omega) (valSc p (tupToSc p (rect n (suc p) (scurryD p n E.2) x.2)) y.2))
  : Le (mul (Sb (valSc (maxN (suc p) (suc n)) E (cmb (suc p) (suc n) y x))) omega)
       (valSc (suc p) (tupToSc (suc p) (rect (suc n) (suc (suc p)) (scurryD (suc p) (suc n) E) x)) y) =
  le-trans (mul (Sb (mul bL (wexp XL))) omega) (mul Y omega) (mul bR (wexp XR))
    (fm-omega Y (Sb (mul bL (wexp XL))) sj)
    (le-trans (mul Y omega) (mul bR (wexp (Sb (Sb XL)))) (mul bR (wexp XR)) fin last)
 where {
   c : Br = E.1 ;
   T : Br = tsum (maxN p n) (cmb p n y.2 x.2) ;
   XL : Br = valSc (maxN p n) E.2 (cmb p n y.2 x.2) ;
   bL : Br = add (add (add y.1 x.1) T) c ;
   A0 : Br = valSc (suc n) (Sb c, zeroSc n) x ;
   R : Tup (suc p) = rect n (suc p) (scurryD p n E.2) x.2 ;
   XR : Br = valSc p (tupToSc p R) y.2 ;
   bR : Br = add (add y.1 (tsum p y.2)) A0 ;
   Y : Br = mul bR (wexp (Sb XL)) ;
   Ab : Le (add (add x.1 (tsum n x.2)) (Sb c)) A0 = valSc-base n (Sb c) (zeroSc n) x.1 x.2 ;
   A-le : Le A0 bR = add-increasing-left (add y.1 (tsum p y.2)) A0 ;
   AbR : Le (add (add x.1 (tsum n x.2)) (Sb c)) bR = le-trans (add (add x.1 (tsum n x.2)) (Sb c)) A0 bR Ab A-le ;
   x0-le : Le x.1 bR = le-trans x.1 A0 bR (valSc-increasing n (Sb c) (zeroSc n) x.1 x.2) A-le ;
   sumx-le : Le (tsum n x.2) bR =
     le-trans (tsum n x.2) (add x.1 (tsum n x.2)) bR (add-increasing-left x.1 (tsum n x.2))
       (le-trans (add x.1 (tsum n x.2)) (add (add x.1 (tsum n x.2)) (Sb c)) bR
         (add-increasing-right (add x.1 (tsum n x.2)) (Sb c)) AbR) ;
   cb : Le (Sb c) bR = le-trans (Sb c) (add (add x.1 (tsum n x.2)) (Sb c)) bR (add-increasing-left (add x.1 (tsum n x.2)) (Sb c)) AbR ;
   c-le : Le c bR = le-trans c (Sb c) bR (S-increasing c) cb ;
   one-le : Le one bR = le-trans one (Sb c) bR tt cb ;
   y0-le : Le y.1 bR = le-trans y.1 (add y.1 (tsum p y.2)) bR (add-increasing-right y.1 (tsum p y.2))
     (add-increasing-right (add y.1 (tsum p y.2)) A0) ;
   sumy-le : Le (tsum p y.2) bR = le-trans (tsum p y.2) (add y.1 (tsum p y.2)) bR (add-increasing-left y.1 (tsum p y.2))
     (add-increasing-right (add y.1 (tsum p y.2)) A0) ;
   bL-fm : FinMult bL bR =
     fm-add bR (add (add y.1 x.1) T) c
       (fm-add bR (add y.1 x.1) T
         (fm-add bR y.1 x.1 (fm-base bR y.1 y0-le) (fm-base bR x.1 x0-le))
         (tsum-cmb-fm p n y.2 x.2 bR sumy-le sumx-le))
       (fm-base bR c c-le) ;
   v-le : Le (mul bL (wexp XL)) Y = fm-mul bR bL XL bL-fm ;
   oneY : Le one Y = le-trans one bR Y one-le (le-mul-right bR (wexp (Sb XL)) (one-le-wexp (Sb XL))) ;
   sj : FinMult (Sb (mul bL (wexp XL))) Y =
     fm-add Y (mul bL (wexp XL)) one (fm-base Y (mul bL (wexp XL)) v-le) (fm-base Y one oneY) ;
   fin : Le (mul Y omega) (mul bR (wexp (Sb (Sb XL)))) =
     substH (\ z -> Le z (mul bR (wexp (Sb (Sb XL))))) (symH (mul-assoc bR (wexp (Sb XL)) omega))
       (le-refl (mul bR (wexp (Sb (Sb XL))))) ;
   exp-le : Le (Sb (Sb XL)) XR =
     le-trans (Sb (Sb XL)) (mul (Sb XL) omega) XR
       (fm-le-omega (Sb XL) (Sb (Sb XL))
         (fm-add (Sb XL) (Sb XL) one (fm-base (Sb XL) (Sb XL) (le-refl (Sb XL))) (fm-base (Sb XL) one tt)))
       ih ;
   last : Le (mul bR (wexp (Sb (Sb XL)))) (mul bR (wexp XR)) =
     mul-mono-right bR (wexp (Sb (Sb XL))) (wexp XR) (wexp-mono (Sb (Sb XL)) XR exp-le) ;
 } ;
-- Agda: valSc-scurry
valSc-scurry : (p : Nat) -> (n : Nat) -> (E : Sc (maxN p n)) -> (y : Tup p) -> (x : Tup n)
  -> Le (mul (Sb (valSc (maxN p n) E (cmb p n y x))) omega) (valSc p (tupToSc p (rect n (suc p) (scurryD p n E) x)) y) = split {
  zero -> \ n E y x ->
    substH (\ z -> Le (mul (Sb (valSc n E x)) omega) z) (symH (hdOf-val n (bumpSc n (sucSc n E)) x))
      (le-trans (mul (Sb (valSc n E x)) omega) (mul (valSc n (sucSc n E) x) omega) (valSc n (bumpSc n (sucSc n E)) x)
        (mul-mono-left (Sb (valSc n E x)) (valSc n (sucSc n E) x) (valSc-suc n E x) omega)
        (valSc-bump n (sucSc n E) x)) ;
  suc p | r -> split {
    zero -> \ E y x ->
      substH (\ V -> Le (mul (Sb (valSc (suc p) E y)) omega) (valSc (suc p) V y))
        (symH (tupToSc-scToTup (suc p) (bumpSc (suc p) (sucSc (suc p) E))))
        (le-trans (mul (Sb (valSc (suc p) E y)) omega) (mul (valSc (suc p) (sucSc (suc p) E) y) omega)
          (valSc (suc p) (bumpSc (suc p) (sucSc (suc p) E)) y)
          (mul-mono-left (Sb (valSc (suc p) E y)) (valSc (suc p) (sucSc (suc p) E) y) (valSc-suc (suc p) E y) omega)
          (valSc-bump (suc p) (sucSc (suc p) E) y)) ;
    suc n -> \ E y x -> valSc-scurry-step p n E y x (r n E.2 y.2 x.2) } } ;

------------------------------------------------------------------------
-- currying a datum

-- Agda: rdOf-zero-id′
rdOf-zero-id' (q : Nat) (d : Tup (suc q)) (y : Tup zero)
  : leT (suc q) d (rect zero (suc q) (rdOf zero (suc q) d) y) = leT-refl (suc q) d ;

-- Agda: curryD
curryD : (p : Nat) -> (n : Nat) -> (q : Nat) -> RD (maxN p n) q -> RD n (WD p q) = split {
  zero -> \ n -> split {
    zero -> \ D -> zeroRD n (suc zero) ;
    suc q -> \ D -> D } ;
  suc p | r -> split {
    zero -> split {
      zero -> \ D -> zeroRD zero (suc (suc p)) ;
      suc q -> \ D -> tupToRD0 (WD (suc p) (suc q)) (flatRD (suc p) (suc q) D) } ;
    suc n -> split {
      zero -> \ D -> zeroRD (suc n) (suc (suc p)) ;
      suc q -> \ D -> joinRD (suc n) (suc (WD p q))
        (padRD (suc n) (suc (suc p)) (suc q) (scurryD (suc p) (suc n) D.1))
        (zeroSc (suc n), r n q D.2) } } } ;

-- Agda: rect-curry (the case of positive widths)
rect-curry-step (p n q : Nat) (Es : Sc (suc (maxN p n))) (D : RD (maxN p n) q) (y : Tup (suc p)) (x : Tup (suc n))
  (ih : leT q (rect (maxN p n) q D (cmb p n y.2 x.2)) (rect p q (rdOf p q (rect n (WD p q) (curryD p n q D) x.2)) y.2))
  : leT (suc q) (rect (suc (maxN p n)) (suc q) (Es, D) (cmb (suc p) (suc n) y x))
      (rect (suc p) (suc q) (rdOf (suc p) (suc q) (rect (suc n) (WD (suc p) (suc q)) (curryD (suc p) (suc n) (suc q) (Es, D)) x)) y) =
  (head, tail)
 where {
   P : RD (suc n) (suc (WD p q)) = padRD (suc n) (suc (suc p)) (suc q) (scurryD (suc p) (suc n) Es) ;
   C : RD (suc n) (suc (WD p q)) = (zeroSc (suc n), curryD p n q D) ;
   Dj : RD (suc n) (suc (WD p q)) = joinRD (suc n) (suc (WD p q)) P C ;
   d : Tup (suc (WD p q)) = rect (suc n) (suc (WD p q)) Dj x ;
   Rs : Tup (suc (suc p)) = rect (suc n) (suc (suc p)) (scurryD (suc p) (suc n) Es) x ;
   V : Br = valSc (suc (maxN p n)) Es (cmb (suc p) (suc n) y x) ;
   Rs-le : leT (suc (suc p)) Rs (pre (suc (suc p)) (suc q) d) =
     substH (\ z -> leT (suc (suc p)) z (pre (suc (suc p)) (suc q) d))
       (rect-padRD (suc n) (suc (suc p)) (suc q) (scurryD (suc p) (suc n) Es) x)
       (pre-mono (suc (suc p)) (suc q) (rect (suc n) (suc (WD p q)) P x) d
         (rect-leRD (suc n) (suc (WD p q)) P Dj (joinRD-left (suc n) (suc (WD p q)) P C) x)) ;
   head : Le V (valSc (suc p) (tupToSc (suc p) (pre (suc (suc p)) (suc q) d)) y) =
     le-trans V (mul (Sb V) omega) (valSc (suc p) (tupToSc (suc p) (pre (suc (suc p)) (suc q) d)) y)
       (le-trans V (Sb V) (mul (Sb V) omega) (S-increasing V) (le-mul-right (Sb V) omega omega-pos))
       (le-trans (mul (Sb V) omega) (valSc (suc p) (tupToSc (suc p) Rs) y)
         (valSc (suc p) (tupToSc (suc p) (pre (suc (suc p)) (suc q) d)) y)
         (valSc-scurry (suc p) (suc n) Es y x)
         (valSc-leSc (suc p) (tupToSc (suc p) Rs) (tupToSc (suc p) (pre (suc (suc p)) (suc q) d))
           (tupToSc-mono (suc p) Rs (pre (suc (suc p)) (suc q) d) Rs-le) y)) ;
   tail : leT q (rect (maxN p n) q D (cmb p n y.2 x.2)) (rect p q (rdOf p q d.2) y.2) =
     leT-trans q (rect (maxN p n) q D (cmb p n y.2 x.2))
       (rect p q (rdOf p q (rect n (WD p q) (curryD p n q D) x.2)) y.2)
       (rect p q (rdOf p q d.2) y.2)
       ih
       (rect-leRD p q (rdOf p q (rect n (WD p q) (curryD p n q D) x.2)) (rdOf p q d.2)
         (rdOf-mono p q (rect n (WD p q) (curryD p n q D) x.2) d.2
           (rect-leRD n (WD p q) (curryD p n q D) Dj.2 (joinRD-right n (WD p q) P.2 (curryD p n q D)) x.2))
         y.2) ;
 } ;
-- Agda: rect-curry
rect-curry : (p : Nat) -> (n : Nat) -> (q : Nat) -> (D : RD (maxN p n) q) -> (y : Tup p) -> (x : Tup n)
  -> leT q (rect (maxN p n) q D (cmb p n y x)) (rect p q (rdOf p q (rect n (WD p q) (curryD p n q D) x)) y) = split {
  zero -> \ n -> split {
    zero -> \ D y x -> tt ;
    suc q -> \ D y x -> rdOf-zero-id' q (rect n (suc q) D x) y } ;
  suc p | r -> split {
    zero -> split {
      zero -> \ D y x -> tt ;
      suc q -> \ D y x ->
        rect-leRD (suc p) (suc q) D (rdOf (suc p) (suc q) (flatRD (suc p) (suc q) D)) (flatRD-ge (suc p) (suc q) D) y } ;
    suc n -> split {
      zero -> \ D y x -> tt ;
      suc q -> \ D y x -> rect-curry-step p n q D.1 D.2 y x (r n q D.2 y.2 x.2) } } } ;

------------------------------------------------------------------------
-- below eps0

-- Agda: hdOf-All<, tupToRD0-All<
hdOf-AllLt : (n : Nat) -> (E : Sc n) -> ScAllLt n E -> RDAllLt n (suc zero) (hdOf n E) = split {
  zero -> \ c h -> (h, tt) ;
  suc n -> \ E h -> (h, zeroRD-AllLt n zero) } ;
tupToRD0-AllLt (k : Nat) (t : Tup k) (h : AllLt k t) : RDAllLt zero k (tupToRD0 k t) = h ;

-- Agda: scurryD-All<
scurryD-AllLt : (p : Nat) -> (n : Nat) -> (E : Sc (maxN p n)) -> ScAllLt (maxN p n) E -> RDAllLt n (suc p) (scurryD p n E) = split {
  zero -> \ n E h -> hdOf-AllLt n (bumpSc n (sucSc n E)) (bumpSc-AllLt n (sucSc n E) (sucSc-AllLt n E h)) ;
  suc p | r -> split {
    zero -> \ E h ->
      tupToRD0-AllLt (suc (suc p)) (scToTup (suc p) (bumpSc (suc p) (sucSc (suc p) E)))
        (scToTup-AllLt (suc p) (bumpSc (suc p) (sucSc (suc p) E))
          (bumpSc-AllLt (suc p) (sucSc (suc p) E) (sucSc-AllLt (suc p) E h))) ;
    suc n -> \ E h -> ((S-lt-eps0 E.1 h.1, zeroSc-AllLt n), r n E.2 h.2) } } ;

-- Agda: curryD-All<
curryD-AllLt : (p : Nat) -> (n : Nat) -> (q : Nat) -> (D : RD (maxN p n) q) -> RDAllLt (maxN p n) q D
  -> RDAllLt n (WD p q) (curryD p n q D) = split {
  zero -> \ n -> split {
    zero -> \ D h -> zeroRD-AllLt n (suc zero) ;
    suc q -> \ D h -> h } ;
  suc p | r -> split {
    zero -> split {
      zero -> \ D h -> zeroRD-AllLt zero (suc (suc p)) ;
      suc q -> \ D h -> tupToRD0-AllLt (WD (suc p) (suc q)) (flatRD (suc p) (suc q) D) (flatRD-AllLt (suc p) (suc q) D h) } ;
    suc n -> split {
      zero -> \ D h -> zeroRD-AllLt (suc n) (suc (suc p)) ;
      suc q -> \ D h ->
        joinRD-AllLt (suc n) (suc (WD p q))
          (padRD (suc n) (suc (suc p)) (suc q) (scurryD (suc p) (suc n) D.1))
          (zeroSc (suc n), curryD p n q D.2)
          (padRD-AllLt (suc n) (suc (suc p)) (suc q) (scurryD (suc p) (suc n) D.1)
            (scurryD-AllLt (suc p) (suc n) D.1 h.1))
          (zeroSc-AllLt (suc n), r n q D.2 h.2) } } } ;
