-- Sharpness.seg: terms attaining every approximant of eps0, so that the
-- bound is least (Agda DialogueTrees.Sharpness).
--
-- Church ordinals over a type s inhabit  O s = s -> (s -> s) -> ((N -> s) -> s) -> s.
-- Zero, successor, limit and addition keep s; multiplication and
-- exponentiation consume an encoding one level up (mulT : O s -> O (O s) -> O s,
-- expT : O (O s) -> O (O s) -> O s), so  tower n  is written at its own type
-- (towerT n s : O s, with n nestings of O).  All are closed Omega-free
-- terms of T, compiled by bracket abstraction (Bracket.seg).  towerTerm n
-- runs towerT n iota against the oracle through the algebra
--   zero |-> 0,   x |-> iter id x (alpha 0),   phi |-> phi (alpha 0):
-- the successor puts one query above x, the limit hands its query to the
-- sequence.
--
-- Lower bound by parametricity: CRel s P c a says that c sends every
-- algebra realising zero, successor and limit (realisation an arbitrary
-- relation P at s; the limit fed Kleisli extensions only) to a
-- realisation of the fold of the code a.  The dialogue semantics of each
-- compiled term computes (the refl lemmas ..D-eq), so each construction
-- preserves CRel, moving the code along fold-wise operations (mulC, expC),
-- which agree with mul and wexp on the codes used (expC-wexp).  At iota
-- with P d a = a <= height d, the algebra of towerTerm realises the three
-- constructors, so tower n <= height (tree (towerTerm n)).
--
-- Agda Rel is CRel (Rel is the record of logical relations of SystemT);
-- Agda ⟪ t ⟫ is Eval[DM].ev t, named zerD sucD .. per term.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Dialogue[l] ; open Models[l] ;
open Brouwer[l] ; open Height[l] ; open Ordinals[l] ; open Epsilon0[l] ; open Bound[l] ; open Bracket[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

------------------------------------------------------------------------
-- the Church ordinals in T

-- Agda: 𝓞
lmT (s : Ty) : Ty = arr (arr iota s) s ;
O (s : Ty) : Ty = arr s (arr (arr s s) (arr (lmT s) s)) ;
-- the context of an algebra (z, succ, lim) after G
alg (G : Cx) (s : Ty) : Cx = ext (ext (ext G s) (arr s s)) (lmT s) ;

-- Agda: zerᵀ  (z s l |-> z)
zerT (s : Ty) : Tm = close (alg emp s) (var (suc (suc zero))) s ;
zerT-has (s : Ty) : Has (zerT s) (O s) = close-has (alg emp s) (var (suc (suc zero))) s (refl s) ;
zerT-free (s : Ty) : OmegaFree (zerT s) = close-free (alg emp s) (var (suc (suc zero))) s (refl s) ;

-- Agda: sucᵀ  (c z s l |-> s (c z s l))
sucB (s : Ty) : Ex = app s (var (suc zero))
  (app (lmT s) (app (arr s s) (app s (var (suc (suc (suc zero)))) (var (suc (suc zero)))) (var (suc zero))) (var zero)) ;
sucB-has (s : Ty) : HasE (alg (ext emp (O s)) s) (sucB s) s =
  (refl (arr s s), (((refl (O s), refl s), refl (arr s s)), refl (lmT s))) ;
sucT (s : Ty) : Tm = close (alg (ext emp (O s)) s) (sucB s) s ;
sucT-has (s : Ty) : Has (sucT s) (arr (O s) (O s)) = close-has (alg (ext emp (O s)) s) (sucB s) s (sucB-has s) ;
sucT-free (s : Ty) : OmegaFree (sucT s) = close-free (alg (ext emp (O s)) s) (sucB s) s (sucB-has s) ;

-- Agda: limᵀ  (g z s l |-> l (x |-> g x z s l))
limG (s : Ty) : Cx = alg (ext emp (arr iota (O s))) s ;
limI (s : Ty) : Ex = app (lmT s) (app (arr s s) (app s (app iota (var (suc (suc (suc (suc zero))))) (var zero))
  (var (suc (suc (suc zero))))) (var (suc (suc zero)))) (var (suc zero)) ;
limI-has (s : Ty) : HasE (ext (limG s) iota) (limI s) s =
  ((((refl (arr iota (O s)), refl iota), refl s), refl (arr s s)), refl (lmT s)) ;
limB (s : Ty) : Ex = app (arr iota s) (var zero) (abs iota (limI s) s) ;
limB-has (s : Ty) : HasE (limG s) (limB s) s = (refl (lmT s), abs-has (limG s) iota (limI s) s (limI-has s)) ;
limT (s : Ty) : Tm = close (limG s) (limB s) s ;
limT-has (s : Ty) : Has (limT s) (lmT (O s)) = close-has (limG s) (limB s) s (limB-has s) ;
limT-free (s : Ty) : OmegaFree (limT s) = close-free (limG s) (limB s) s (limB-has s) ;

-- Agda: addᵀ  (a b z s l |-> a (b z s l) s l)
addG (s : Ty) : Cx = alg (ext (ext emp (O s)) (O s)) s ;
addB (s : Ty) : Ex = app (lmT s) (app (arr s s) (app s (var (suc (suc (suc (suc zero)))))
  (app (lmT s) (app (arr s s) (app s (var (suc (suc (suc zero)))) (var (suc (suc zero)))) (var (suc zero))) (var zero)))
  (var (suc zero))) (var zero) ;
addB-has (s : Ty) : HasE (addG s) (addB s) s =
  (((refl (O s), (((refl (O s), refl s), refl (arr s s)), refl (lmT s))), refl (arr s s)), refl (lmT s)) ;
addT (s : Ty) : Tm = close (addG s) (addB s) s ;
addT-has (s : Ty) : Has (addT s) (arr (O s) (arr (O s) (O s))) = close-has (addG s) (addB s) s (addB-has s) ;
addT-free (s : Ty) : OmegaFree (addT s) = close-free (addG s) (addB s) s (addB-has s) ;

-- Agda: mulᵀ  (a b |-> b zerᵀ (r |-> addᵀ r a) limᵀ)
mulG (s : Ty) : Cx = ext (ext emp (O s)) (O (O s)) ;
mulI (s : Ty) : Ex = app (O s) (app (O s) (con (addT s)) (var zero)) (var (suc (suc zero))) ;
mulI-has (s : Ty) : HasE (ext (mulG s) (O s)) (mulI s) (O s) = (((addT-has s, addT-free s), refl (O s)), refl (O s)) ;
mulB (s : Ty) : Ex = app (lmT (O s)) (app (arr (O s) (O s)) (app (O s) (var zero) (con (zerT s))) (abs (O s) (mulI s) (O s)))
  (con (limT s)) ;
mulB-has (s : Ty) : HasE (mulG s) (mulB s) (O s) =
  (((refl (O (O s)), (zerT-has s, zerT-free s)), abs-has (mulG s) (O s) (mulI s) (O s) (mulI-has s)), (limT-has s, limT-free s)) ;
mulT (s : Ty) : Tm = close (mulG s) (mulB s) (O s) ;
mulT-has (s : Ty) : Has (mulT s) (arr (O s) (arr (O (O s)) (O s))) = close-has (mulG s) (mulB s) (O s) (mulB-has s) ;
mulT-free (s : Ty) : OmegaFree (mulT s) = close-free (mulG s) (mulB s) (O s) (mulB-has s) ;

-- Agda: expᵀ  (a b |-> b (sucᵀ zerᵀ) (r |-> mulᵀ r a) limᵀ)
oneT (s : Ty) : Tm = App (O s) (sucT s) (zerT s) ;
oneT-has (s : Ty) : Has (oneT s) (O s) = (sucT-has s, zerT-has s) ;
oneT-free (s : Ty) : OmegaFree (oneT s) = (sucT-free s, zerT-free s) ;
expG (s : Ty) : Cx = ext (ext emp (O (O s))) (O (O s)) ;
expI (s : Ty) : Ex = app (O (O s)) (app (O s) (con (mulT s)) (var zero)) (var (suc (suc zero))) ;
expI-has (s : Ty) : HasE (ext (expG s) (O s)) (expI s) (O s) = (((mulT-has s, mulT-free s), refl (O s)), refl (O (O s))) ;
expB (s : Ty) : Ex = app (lmT (O s)) (app (arr (O s) (O s)) (app (O s) (var zero) (con (oneT s))) (abs (O s) (expI s) (O s)))
  (con (limT s)) ;
expB-has (s : Ty) : HasE (expG s) (expB s) (O s) =
  (((refl (O (O s)), (oneT-has s, oneT-free s)), abs-has (expG s) (O s) (expI s) (O s) (expI-has s)), (limT-has s, limT-free s)) ;
expT (s : Ty) : Tm = close (expG s) (expB s) (O s) ;
expT-has (s : Ty) : Has (expT s) (arr (O (O s)) (arr (O (O s)) (O s))) = close-has (expG s) (expB s) (O s) (expB-has s) ;
expT-free (s : Ty) : OmegaFree (expT s) = close-free (expG s) (expB s) (O s) (expB-has s) ;

-- Agda: finᵀ, ωᵀ
finT (s : Ty) : Tm = App (O s) (App (arr (O s) (O s)) (Iter (O s)) (sucT s)) (zerT s) ;
finT-has (s : Ty) : Has (finT s) (arr iota (O s)) = ((refl (iterTy (O s)), sucT-has s), zerT-has s) ;
finT-free (s : Ty) : OmegaFree (finT s) = ((tt, sucT-free s), zerT-free s) ;
omegaT (s : Ty) : Tm = App (arr iota (O s)) (limT s) (finT s) ;
omegaT-has (s : Ty) : Has (omegaT s) (O s) = (limT-has s, finT-has s) ;
omegaT-free (s : Ty) : OmegaFree (omegaT s) = (limT-free s, finT-free s) ;

-- Agda: towerᵀ
towerT : Nat -> Ty -> Tm = split {
  zero -> \ s -> omegaT s ;
  suc n | r -> \ s -> App (O (O s)) (App (O (O s)) (expT s) (omegaT (O s))) (r (O s)) } ;
towerT-has : (n : Nat) -> (s : Ty) -> Has (towerT n s) (O s) = split {
  zero -> \ s -> omegaT-has s ;
  suc n | r -> \ s -> ((expT-has s, omegaT-has (O s)), r (O s)) } ;
towerT-free : (n : Nat) -> (s : Ty) -> OmegaFree (towerT n s) = split {
  zero -> \ s -> omegaT-free s ;
  suc n | r -> \ s -> ((expT-free s, omegaT-free (O s)), r (O s)) } ;

-- Agda: tower-term  (the n-th approximant run against the oracle)
twG : Cx = ext emp nat2 ;
-- x |-> iter I x (alpha 0)
twS : Ex = app iota (app iota (app nat2 (con (Iter iota)) (con (Examples[l].I iota))) (var zero)) (app iota (var (suc zero)) (con Zero)) ;
twS-has : HasE (ext twG iota) twS iota =
  ((((refl (iterTy iota), tt), (Examples[l].hI iota, ((tt, tt), tt))), refl iota), (refl nat2, (refl iota, tt))) ;
-- phi |-> phi (alpha 0)
twL : Ex = app iota (var zero) (app iota (var (suc zero)) (con Zero)) ;
twL-has : HasE (ext twG nat2) twL iota = (refl nat2, (refl nat2, (refl iota, tt))) ;
twB (n : Nat) : Ex = app (lmT iota) (app (arr iota iota) (app iota (con (towerT n iota)) (con Zero)) (abs iota twS iota))
  (abs nat2 twL iota) ;
twB-has (n : Nat) : HasE twG (twB n) iota =
  ((((towerT-has n iota, towerT-free n iota), (refl iota, tt)), abs-has twG iota twS iota twS-has), abs-has twG nat2 twL iota twL-has) ;
towerTerm (n : Nat) : Tm = close twG (twB n) iota ;
towerTerm-has (n : Nat) : Has (towerTerm n) FT = close-has twG (twB n) iota (twB-has n) ;
towerTerm-free (n : Nat) : OmegaFree (towerTerm n) = close-free twG (twB n) iota (twB-has n) ;

------------------------------------------------------------------------
-- the dialogue semantics of the terms, by computation

-- Agda: ⟪ zerᵀ ⟫ .. ⟪ towerᵀ n s ⟫
zerD (s : Ty) : BV (O s) = Eval[DM].ev (zerT s) (O s) (zerT-has s) ;
sucD (s : Ty) : BV (arr (O s) (O s)) = Eval[DM].ev (sucT s) (arr (O s) (O s)) (sucT-has s) ;
limD (s : Ty) : BV (lmT (O s)) = Eval[DM].ev (limT s) (lmT (O s)) (limT-has s) ;
addD (s : Ty) : BV (arr (O s) (arr (O s) (O s))) = Eval[DM].ev (addT s) (arr (O s) (arr (O s) (O s))) (addT-has s) ;
mulD (s : Ty) : BV (arr (O s) (arr (O (O s)) (O s))) = Eval[DM].ev (mulT s) (arr (O s) (arr (O (O s)) (O s))) (mulT-has s) ;
expD (s : Ty) : BV (arr (O (O s)) (arr (O (O s)) (O s))) = Eval[DM].ev (expT s) (arr (O (O s)) (arr (O (O s)) (O s))) (expT-has s) ;
omegaD (s : Ty) : BV (O s) = Eval[DM].ev (omegaT s) (O s) (omegaT-has s) ;
towerD (n : Nat) (s : Ty) : BV (O s) = Eval[DM].ev (towerT n s) (O s) (towerT-has n s) ;

zerD-eq (s : Ty) (z : BV s) (f : BV (arr s s)) (g : BV (lmT s)) : Id (BV s) (zerD s z f g) z = refl z ;
opaque zerT ;
sucD-eq (s : Ty) (c : BV (O s)) (z : BV s) (f : BV (arr s s)) (g : BV (lmT s))
  : Id (BV s) (sucD s c z f g) (f (c z f g)) = refl (f (c z f g)) ;
opaque sucT ;
limD-eq (s : Ty) (c : B Nat -> BV (O s)) (z : BV s) (f : BV (arr s s)) (g : BV (lmT s))
  : Id (BV s) (limD s c z f g) (g (\ x -> c x z f g)) = refl (g (\ x -> c x z f g)) ;
opaque limT ;
addD-eq (s : Ty) (a b : BV (O s)) (z : BV s) (f : BV (arr s s)) (g : BV (lmT s))
  : Id (BV s) (addD s a b z f g) (a (b z f g) f g) = refl (a (b z f g) f g) ;
opaque addT ;
mulD-eq (s : Ty) (a : BV (O s)) (b : BV (O (O s)))
  : Id (BV (O s)) (mulD s a b) (b (zerD s) (\ r -> addD s r a) (limD s)) = refl (b (zerD s) (\ r -> addD s r a) (limD s)) ;
opaque mulT ;
expD-eq (s : Ty) (a b : BV (O (O s)))
  : Id (BV (O s)) (expD s a b) (b (sucD s (zerD s)) (\ r -> mulD s r a) (limD s)) = refl (b (sucD s (zerD s)) (\ r -> mulD s r a) (limD s)) ;
opaque expT ;
omegaD-eq (s : Ty) : Id (BV (O s)) (omegaD s) (limD s (KE (O s) (iterN (BV (O s)) (sucD s) (zerD s)))) =
  refl (limD s (KE (O s) (iterN (BV (O s)) (sucD s) (zerD s)))) ;
towerD-eq (n : Nat) (s : Ty) : Id (BV (O s)) (towerD (suc n) s) (expD s (omegaD (O s)) (towerD n (O s))) =
  refl (expD s (omegaD (O s)) (towerD n (O s))) ;

------------------------------------------------------------------------
-- folds of Brouwer codes

-- Agda: fold, mulᶜ, expᶜ, towerᶜ
fold (z : Br) (s : Br -> Br) (g : (Nat -> Br) -> Br) : Br -> Br = split {
  Zb -> z ;
  Sb a | r -> s r ;
  Lb f | r -> g r } ;
mulC (a : Br) : Br -> Br = fold Zb (\ r -> add a r) (\ f -> Lb f) ;
expC (a : Br) : Br -> Br = fold (Sb Zb) (\ r -> mulC r a) (\ f -> Lb f) ;
towerC : Nat -> Br = split { zero -> omega ; suc n | r -> expC omega r } ;

-- Agda: fold-id, fold-⊕
fold-id : (a : Br) -> Id Br (fold Zb (\ x -> Sb x) (\ f -> Lb f) a) a = split {
  Zb -> refl Zb ;
  Sb a | r -> apH (\ x -> Sb x) r ;
  Lb f | r -> lim-ext (\ n -> fold Zb (\ x -> Sb x) (\ g -> Lb g) (f n)) f r } ;
fold-add (z : Br) (s : Br -> Br) (g : (Nat -> Br) -> Br) (a : Br)
  : (b : Br) -> Id Br (fold z s g (add a b)) (fold (fold z s g a) s g b) = split {
  Zb -> refl (fold z s g a) ;
  Sb b | r -> apH s r ;
  Lb f | r -> apH g (FL.funext Nat (\ n -> Br) (\ n -> fold z s g (add a (f n))) (\ n -> fold (fold z s g a) s g (f n)) r) } ;

-- Agda: ⊗-ι-swap, mulᶜ-ι, mulᶜ-ω, expᶜ-ω^, towerᶜ-tower
mul-num-swap (x : Br) : (n : Nat) -> Id Br (add x (mul x (numB n))) (add (mul x (numB n)) x) = split {
  zero -> symH (Z-left-unit x) ;
  suc n | r -> calc Br {
    add x (add (mul x (numB n)) x) =< symH (add-assoc x (mul x (numB n)) x) >
    add (add x (mul x (numB n))) x =< apH (\ z -> add z x) r >
    add (add (mul x (numB n)) x) x } } ;
mulC-num (x : Br) : (n : Nat) -> Id Br (mulC x (numB n)) (mul x (numB n)) = split {
  zero -> refl Zb ;
  suc n | r -> calc Br {
    add x (mulC x (numB n)) =< apH (\ z -> add x z) r >
    add x (mul x (numB n)) =< mul-num-swap x n >
    add (mul x (numB n)) x } } ;
mulC-omega (x : Br) : Id Br (mulC x omega) (mul x omega) =
  lim-ext (\ n -> mulC x (numB n)) (\ n -> mul x (numB n)) (mulC-num x) ;
expC-wexp : (b : Br) -> Id Br (expC omega b) (wexp b) = split {
  Zb -> refl (Sb Zb) ;
  Sb b | r -> calc Br {
    mulC (expC omega b) omega =< mulC-omega (expC omega b) >
    mul (expC omega b) omega =< apH (\ z -> mul z omega) r >
    mul (wexp b) omega } ;
  Lb f | r -> lim-ext (\ n -> expC omega (f n)) (\ n -> wexp (f n)) r } ;
towerC-tower : (n : Nat) -> Id Br (towerC n) (tower n) = split {
  zero -> refl omega ;
  suc n | r -> calc Br {
    expC omega (towerC n) =< apH (\ z -> expC omega z) r >
    expC omega (tower n) =< expC-wexp (tower n) >
    wexp (tower n) } } ;

------------------------------------------------------------------------
-- the parametric relation

-- Agda: Rel
CRel (s : Ty) (P : BV s -> Br -> U l) (c : BV (O s)) (a : Br) : U l =
  (z : BV s) (f : BV s -> BV s) (g : (B Nat -> BV s) -> BV s) (z' : Br) (f' : Br -> Br) (g' : (Nat -> Br) -> Br)
  -> P z z'
  -> ((x : BV s) (y : Br) -> P x y -> P (f x) (f' y))
  -> ((k : Nat -> BV s) (h : Nat -> Br) -> ((j : Nat) -> P (k j) (h j)) -> P (g (KE s k)) (g' h))
  -> P (c z f g) (fold z' f' g' a) ;

-- Agda: zerᵀ-Rel, sucᵀ-Rel, limᵀ-Rel, addᵀ-Rel, mulᵀ-Rel, expᵀ-Rel
zerT-Rel (s : Ty) (P : BV s -> Br -> U l) : CRel s P (zerD s) Zb = \ z f g z' f' g' hz hs hl ->
  substH (\ x -> P x z') (symH (zerD-eq s z f g)) hz ;
sucT-Rel (s : Ty) (P : BV s -> Br -> U l) (c : BV (O s)) (a : Br) (rho : CRel s P c a) : CRel s P (sucD s c) (Sb a) =
  \ z f g z' f' g' hz hs hl -> substH (\ x -> P x (f' (fold z' f' g' a))) (symH (sucD-eq s c z f g))
    (hs (c z f g) (fold z' f' g' a) (rho z f g z' f' g' hz hs hl)) ;
limT-Rel (s : Ty) (P : BV s -> Br -> U l) (k : Nat -> BV (O s)) (h : Nat -> Br) (rho : (j : Nat) -> CRel s P (k j) (h j))
  : CRel s P (limD s (KE (O s) k)) (Lb h) = \ z f g z' f' g' hz hs hl ->
  substH (\ x -> P x (g' (\ j -> fold z' f' g' (h j)))) (symH (limD-eq s (KE (O s) k) z f g))
    (hl (\ j -> k j z f g) (\ j -> fold z' f' g' (h j)) (\ j -> rho j z f g z' f' g' hz hs hl)) ;
addT-Rel (s : Ty) (P : BV s -> Br -> U l) (a : BV (O s)) (a' : Br) (b : BV (O s)) (b' : Br)
  (ra : CRel s P a a') (rb : CRel s P b b') : CRel s P (addD s a b) (add b' a') = \ z f g z' f' g' hz hs hl ->
  substH (\ x -> P x (fold z' f' g' (add b' a'))) (symH (addD-eq s a b z f g))
    (substH (\ x -> P (a (b z f g) f g) x) (symH (fold-add z' f' g' b' a'))
      (ra (b z f g) f g (fold z' f' g' b') f' g' (rb z f g z' f' g' hz hs hl) hs hl)) ;
mulT-Rel (s : Ty) (P : BV s -> Br -> U l) (a : BV (O s)) (a' : Br) (b : BV (O (O s))) (b' : Br)
  (ra : CRel s P a a') (rb : CRel (O s) (CRel s P) b b') : CRel s P (mulD s a b) (mulC a' b') =
  substH (\ c -> CRel s P c (mulC a' b')) (symH (mulD-eq s a b))
    (rb (zerD s) (\ r -> addD s r a) (limD s) Zb (\ r -> add a' r) (\ f -> Lb f)
      (zerT-Rel s P) (\ x y rx -> addT-Rel s P x y a a' rx ra) (\ k h rk -> limT-Rel s P k h rk)) ;
expT-Rel (s : Ty) (P : BV s -> Br -> U l) (a : BV (O (O s))) (a' : Br) (b : BV (O (O s))) (b' : Br)
  (ra : CRel (O s) (CRel s P) a a') (rb : CRel (O s) (CRel s P) b b') : CRel s P (expD s a b) (expC a' b') =
  substH (\ c -> CRel s P c (expC a' b')) (symH (expD-eq s a b))
    (rb (sucD s (zerD s)) (\ r -> mulD s r a) (limD s) (Sb Zb) (\ r -> mulC r a') (\ f -> Lb f)
      (sucT-Rel s P (zerD s) Zb (zerT-Rel s P)) (\ x y rx -> mulT-Rel s P x y a a' rx ra) (\ k h rk -> limT-Rel s P k h rk)) ;

-- Agda: finᵀ-Rel, ωᵀ-Rel, towerᵀ-Rel
finT-Rel (s : Ty) (P : BV s -> Br -> U l) : (j : Nat) -> CRel s P (iterN (BV (O s)) (sucD s) (zerD s) j) (numB j) = split {
  zero -> zerT-Rel s P ;
  suc j | r -> sucT-Rel s P (iterN (BV (O s)) (sucD s) (zerD s) j) (numB j) r } ;
omegaT-Rel (s : Ty) (P : BV s -> Br -> U l) : CRel s P (omegaD s) omega =
  substH (\ c -> CRel s P c omega) (symH (omegaD-eq s))
    (limT-Rel s P (iterN (BV (O s)) (sucD s) (zerD s)) numB (finT-Rel s P)) ;
towerT-Rel : (n : Nat) -> (s : Ty) -> (P : BV s -> Br -> U l) -> CRel s P (towerD n s) (towerC n) = split {
  zero -> \ s P -> omegaT-Rel s P ;
  suc n | r -> \ s P -> substH (\ c -> CRel s P c (towerC (suc n))) (symH (towerD-eq n s))
    (expT-Rel s P (omegaD (O s)) omega (towerD n (O s)) (towerC n) (omegaT-Rel (O s) (CRel s P)) (r (O s) (CRel s P))) } ;

------------------------------------------------------------------------
-- the lower bound

-- Agda: tower-attained (R₀, s₀, l₀, hz, hs, hl, main, e)
P0 (d : B Nat) (a : Br) : U l = Le a (height d) ;
s0 (x : B Nat) : B Nat = kleisli Nat Nat (iterN (B Nat) (\ y -> y) x) (beta (\ m -> eta m) zero) ;
l0 (phi : B Nat -> B Nat) : B Nat = phi (beta (\ m -> eta m) zero) ;
hz0 : P0 (eta zero) Zb = tt ;
hs0 (x : B Nat) (y : Br) (p : P0 x y) : P0 (s0 x) (Sb y) = (zero, p) ;
hl0 (k : Nat -> B Nat) (h : Nat -> Br) (p : (j : Nat) -> P0 (k j) (h j)) : P0 (l0 (KE iota k)) (Lb h) = \ j ->
  le-l (h j) (\ m -> Sb (height (k m))) j (le-trans (h j) (height (k j)) (Sb (height (k j))) (p j) (S-increasing (height (k j)))) ;
-- the tree of towerTerm n is the fold of towerT n iota through this algebra
tree-towerTerm (n : Nat) : Id (B Nat) (tree (towerTerm n) (towerTerm-has n)) (towerD n iota (eta zero) s0 l0) =
  refl (towerD n iota (eta zero) s0 l0) ;
tower-attained (n : Nat) : Le (tower n) (height (tree (towerTerm n) (towerTerm-has n))) =
  substH (\ x -> Le x (height (tree (towerTerm n) (towerTerm-has n))))
    (transH (fold-id (towerC n)) (towerC-tower n))
    (towerT-Rel n iota P0 (eta zero) s0 l0 Zb (\ x -> Sb x) (\ f -> Lb f) hz0 hs0 hl0) ;

-- Agda: tower-term-below-ε₀, heights-cofinal, ε₀-least
tower-term-below-eps0 (n : Nat) : Lt (height (tree (towerTerm n) (towerTerm-has n))) eps0 =
  dialogue-tree-height-lt-eps0 (towerTerm n) (towerTerm-has n) ;
heights-cofinal (a : Br) (p : Lt a eps0)
  : (e : Tm) * ((h : Has e FT) * (OmegaFree e * Le a (height (tree e h)))) =
  (towerTerm p.1, (towerTerm-has p.1, (towerTerm-free p.1,
    le-trans a (tower p.1) (height (tree (towerTerm p.1) (towerTerm-has p.1)))
      (le-trans a (Sb a) (tower p.1) (S-increasing a) p.2) (tower-attained p.1)))) ;
eps0-least (b : Br) (phi : (e : Tm) -> (h : Has e FT) -> OmegaFree e -> Le (height (tree e h)) b) : Le eps0 b = \ n ->
  le-trans (tower n) (height (tree (towerTerm n) (towerTerm-has n))) b (tower-attained n)
    (phi (towerTerm n) (towerTerm-has n) (towerTerm-free n)) ;
