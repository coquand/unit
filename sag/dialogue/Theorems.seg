-- Theorems.seg: the main theorems, restated (Agda DialogueTrees.Main).
--
-- Each statement is written out with the abbreviations unfolded: the
-- strict order as a successor on the left, eps0 as the limit of the tower;
-- a term of System T is a term e with a typing h : Has e FT,
-- FT = (N -> N) -> N, and OmegaFree e (Omega is the oracle, not a term
-- of T); its dialogue tree is tree e h (e applied to the generic sequence
-- in the dialogue model, Models.seg), and the height a Brouwer code
-- (Height.seg).  Each is proved by the proof term of the development.
--
-- The upper bound holds for every typed e, Omega allowed, so in
-- particular for the terms of T.  The terms of the lower bound and of
-- cofinality are Omega-free, and the least-bound statement quantifies over
-- the Omega-free terms only (its strongest form).  no-tower-bound (not in
-- the Agda's Main) says the same with the tower levels: no level bounds
-- the heights of all the terms of T.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Dialogue[l] ; open Models[l] ;
open Brouwer[l] ; open Height[l] ; open Ordinals[l] ; open Epsilon0[l] ; open Bound[l] ; open Lower[l] ;
open Sharpness[l] ;

-- Agda: restated  (the upper bound)
restated (e : Tm) (h : Has e FT) : Le (Sb (height (tree e h))) (Lb tower) =
  dialogue-tree-height-lt-eps0 e h ;

-- Agda: no-S≤Z, example, witness  (the order is not degenerate, the theorem not vacuous)
no-SZ-le-Z (p : Le (Sb Zb) Zb) : Empty = p ;
example : (e : Tm) * ((h : Has e FT) * OmegaFree e) = (leaf-term, (leaf-has, leaf-free)) ;
witness : Le (Sb (height (tree example.1 example.2.1))) (Lb tower) =
  dialogue-tree-height-lt-eps0 example.1 example.2.1 ;

-- Agda: tree-type, height-type
tree-type : (e : Tm) -> Has e FT -> B Nat = tree ;
height-type : B Nat -> Br = height ;

-- Agda: tower-base, tower-step, ε₀-is-limit-of-tower
tower-base : Id Br (tower zero) (Lb numB) = refl (Lb numB) ;
tower-step (n : Nat) : Id Br (tower (suc n)) (wexp (tower n)) = refl (wexp (tower n)) ;
eps0-is-limit-of-tower : Id Br eps0 (Lb tower) = refl (Lb tower) ;

-- Agda: attained  (the lower bound: the n-th term is a term of T, and its
-- tree has height at least tower n)
attained (n : Nat) : OmegaFree (towerTerm n) * Le (tower n) (height (tree (towerTerm n) (towerTerm-has n))) =
  (towerTerm-free n, tower-attained n) ;

-- Agda: cofinal  (every code strictly below the limit of the tower is
-- below the height of the tree of some term of T)
cofinal (a : Br) (p : Le (Sb a) (Lb tower))
  : (e : Tm) * ((h : Has e FT) * (OmegaFree e * Le a (height (tree e h)))) =
  heights-cofinal a p ;

-- Agda: least  (a code above the height of the tree of every term of T is
-- above the limit of the tower)
least (b : Br) (phi : (e : Tm) -> (h : Has e FT) -> OmegaFree e -> Le (height (tree e h)) b) : Le (Lb tower) b =
  eps0-least b phi ;

-- Agda: term-type  (the terms of the lower bound are terms of T of type (N -> N) -> N)
term-type (n : Nat) : (e : Tm) * ((h : Has e FT) * OmegaFree e) = (towerTerm n, (towerTerm-has n, towerTerm-free n)) ;

-- no level of the tower bounds the heights of all the terms of T
no-tower-bound (n : Nat) (phi : (e : Tm) -> (h : Has e FT) -> OmegaFree e -> Le (height (tree e h)) (tower n)) : Empty =
  S-irrefl (tower n) (le-trans (Sb (tower n)) (tower (suc n)) (tower n) (tower-strict n) (least (tower n) phi (suc n))) ;
