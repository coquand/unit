-- Bound.seg: the tuple model, the predicate as a logical relation, and the
-- bound  height (tree e) < eps0  (Agda DialogueTrees.Fundamental).
--
-- The tuple model TupM: a value at t is a datum of width wd t with all
-- entries below eps0; application reads the datum of the function as a
-- graded map and applies it (rect after rdOf), which keeps the entries
-- below eps0 (rect-AllLt, rdOf-AllLt); the constants are the data of the
-- Agda's fundamental: zeroTup for Zero, Succ and K, (1, (0, tt)) for the
-- oracle, dI for the recursor, dS for S.
--
-- The relation DR between MajM and TupM is Dom on the datum of the value.
-- At an arrow, Dom quantifies over a datum e, its bound AllLt e, and
-- Dom s x e; a value of TupM at s is exactly the pair (e, AllLt e), so
-- after currying this is the logical lifting, and r-ap is application of
-- the hypothesis (Agda app-clause), by definition.  The constant fields
-- are the clauses (Predicate, Clauses).  So the generic fundamental lemma
-- Fund[MajM, TupM, DR].fund replaces the Agda's induction on terms, and at
-- iota the datum is one code below eps0 above the majorant (Dom-lt-eps0).
-- With Majorant.dialogue-height-lt-eps0:
--   height (tree e) <= muTree e <= tsum (tuple of e Omega) < eps0.
--
-- Deviations: the Agda's fundamental returns the datum, its bound and the
-- predicate as one Σ; here the datum with its bound is Eval[TupM].ev and
-- the predicate is fundamental.  As in Majorant.seg, the final theorem is
-- stated for every typed e : (N -> N) -> N (Omega allowed), applied to
-- Omega; the Agda's t : T is the special case OmegaFree e.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SystemT[l] ; open Models[l] ; open Brouwer[l] ;
open Height[l] ; open Epsilon0[l] ; open Tuples[l] ; open Rect[l] ; open RectAlgebra[l] ;
open Majorant[l] ; open Predicate[l] ; open Clauses[l] ;

------------------------------------------------------------------------
-- the tuple model

-- values: data below eps0
TV (t : Ty) : U l = (d : Tup (wd t)) * AllLt (wd t) d ;

-- Agda: fundamental, the case _·_
tap (s t : Ty) (f : TV (arr s t)) (x : TV s) : TV t =
  (rect (wd s) (wd t) (rdOf (wd s) (wd t) f.1) x.1,
   rect-AllLt (wd s) (wd t) (rdOf (wd s) (wd t) f.1) x.1 (rdOf-AllLt (wd s) (wd t) f.1 f.2) x.2) ;

-- Agda: fundamental, the cases of the constants
tup-Zero : TV iota = (zeroTup (suc zero), zeroTup-AllLt (suc zero)) ;
tup-Succ : TV nat2 = (zeroTup (wd nat2), zeroTup-AllLt (wd nat2)) ;
tup-Omega : TV nat2 = ((Sb Zb, (Zb, tt)), (S-lt-eps0 Zb Z-lt-eps0, (Z-lt-eps0, tt))) ;
tup-Iter (s : Ty) : TV (iterTy s) = (IDatum[s].dI, IDatum[s].dI-AllLt) ;
tup-K (s u : Ty) : TV (kTy s u) = (zeroTup (wd (kTy s u)), zeroTup-AllLt (wd (kTy s u))) ;
tup-S (r s u : Ty) : TV (sTy r s u) = (SDatum[r, s, u].dS, SDatum[r, s, u].dS-AllLt) ;

TupM : Model = new Model[TV, tap, tup-Zero, tup-Succ, tup-Omega, tup-Iter, tup-K, tup-S] ;

------------------------------------------------------------------------
-- the predicate as a logical relation

DomR (t : Ty) (x : MV t) (y : TV t) : U l = Dom t x y.1 ;

-- Agda: app-clause (at values of TupM)
DomR-ap (s t : Ty) (F : MV (arr s t)) (g : TV (arr s t)) (x : MV s) (y : TV s)
  (rf : DomR (arr s t) F g) (rx : DomR s x y) : DomR t (F x) (tap s t g y) =
  app-clause s t F x g.1 y.1 rf y.2 rx ;

DR : Rel[MajM, TupM] = new Rel[MajM, TupM, DomR, DomR-ap,
  Zero-clause (zeroTup (suc zero)), Succ-clause (zeroTup (wd nat2)), Omega-clause Zb,
  \ s -> IDatum[s].Iter-clause,
  \ s u -> K-clause s u (zeroTup (wd (kTy s u))),
  \ r s u -> SDatum[r, s, u].S-clause] ;

------------------------------------------------------------------------
-- the bound

-- Agda: fundamental  (the datum with its bound is Eval[TupM].ev e t h)
fundamental (e : Tm) (t : Ty) (h : Has e t) : Dom t (Eval[MajM].ev e t h) (Eval[TupM].ev e t h).1 =
  Fund[MajM, TupM, DR].fund e t h ;

-- Agda: μᵀ-<-ε₀
mu-lt-eps0 (e : Tm) (h : Has e iota) : Lt (Eval[MajM].ev e iota h) eps0 =
  Dom-lt-eps0 (Eval[MajM].ev e iota h) (Eval[TupM].ev e iota h).1 (fundamental e iota h) (Eval[TupM].ev e iota h).2 ;

-- Agda: dialogue-tree-height-<-ε₀
dialogue-tree-height-lt-eps0 (e : Tm) (h : Has e FT) : Lt (height (tree e h)) eps0 =
  dialogue-height-lt-eps0 e h (mu-lt-eps0 (App nat2 e Omega) (h, refl nat2)) ;
