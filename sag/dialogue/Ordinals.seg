-- Ordinals.seg: numerals, omega, multiplication and the laws of the
-- product (Agda BrouwerOrdinals.Multiplication; the rest of Order is in
-- Brouwer.seg).
--
-- mul a b recurses on b as add does:  a*0 = 0,  a*(S b) = a*b + a,
-- a*(L f) = L (a * f n).  Proofs by induction on the right argument; the
-- limit cases of the equations use function extensionality (lim-ext).
-- Only LEFT distributivity  c*(x+y) = c*x + c*y  holds (on the right,
-- (1+w)*2 = 1+w+1+w  differs from  1*2 + w*2 = 1+1+w+w); it gives
-- associativity of the product.  The numerals are a homomorphism for + and *.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Brouwer[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

-- two limits of pointwise equal sequences are equal
lim-ext (f g : Nat -> Br) (h : (n : Nat) -> Id Br (f n) (g n)) : Id Br (Lb f) (Lb g) =
  apH (\ k -> Lb k) (FL.funext Nat (\ n -> Br) f g h) ;

-- Agda: ι[_], ω, _⊗_
numB : Nat -> Br = split { zero -> Zb ; suc n | r -> Sb r } ;
omega : Br = Lb numB ;
mul (a : Br) : Br -> Br = split { Zb -> Zb ; Sb b | r -> add r a ; Lb f | r -> Lb r } ;

one : Br = numB (suc zero) ;
two : Br = numB (suc (suc zero)) ;

------------------------------------------------------------------------
-- addition

-- Agda: ⊕-mono-left
add-mono-left (a a' : Br) (p : Le a a') : (c : Br) -> Le (add a c) (add a' c) = split {
  Zb -> p ;
  Sb c | r -> r ;
  Lb f | r -> le-L-mono (\ n -> add a (f n)) (\ n -> add a' (f n)) r } ;

-- Agda: ⊕-assoc
add-assoc (a b : Br) : (c : Br) -> Id Br (add (add a b) c) (add a (add b c)) = split {
  Zb -> refl (add a b) ;
  Sb c | r -> apH (\ x -> Sb x) r ;
  Lb f | r -> lim-ext (\ n -> add (add a b) (f n)) (\ n -> add a (add b (f n))) r } ;

-- Agda: ⊕-increasing-left
add-increasing-left (d : Br) : (x : Br) -> Le x (add d x) = split {
  Zb -> tt ;
  Sb x | r -> r ;
  Lb f | r -> le-L-mono f (\ n -> add d (f n)) r } ;

------------------------------------------------------------------------
-- the product

-- Agda: ⊗-left-distrib
mul-left-distrib (c x : Br) : (y : Br) -> Id Br (mul c (add x y)) (add (mul c x) (mul c y)) = split {
  Zb -> refl (mul c x) ;
  Sb y | r -> calc Br {
    add (mul c (add x y)) c =< apH (\ z -> add z c) r >
    add (add (mul c x) (mul c y)) c =< add-assoc (mul c x) (mul c y) c >
    add (mul c x) (add (mul c y) c) } ;
  Lb f | r -> lim-ext (\ n -> mul c (add x (f n))) (\ n -> add (mul c x) (mul c (f n))) r } ;

-- Agda: ⊗-assoc
mul-assoc (a b : Br) : (c : Br) -> Id Br (mul (mul a b) c) (mul a (mul b c)) = split {
  Zb -> refl Zb ;
  Sb c | r -> calc Br {
    add (mul (mul a b) c) (mul a b) =< apH (\ z -> add z (mul a b)) r >
    add (mul a (mul b c)) (mul a b) =< symH (mul-left-distrib a (mul b c) b) >
    mul a (add (mul b c) b) } ;
  Lb f | r -> lim-ext (\ n -> mul (mul a b) (f n)) (\ n -> mul a (mul b (f n))) r } ;

------------------------------------------------------------------------
-- the numerals

-- Agda: _+ℕ_, ι-+-homo
plusN (m : Nat) : Nat -> Nat = split { zero -> m ; suc n | r -> suc r } ;
num-plus (m : Nat) : (n : Nat) -> Id Br (numB (plusN m n)) (add (numB m) (numB n)) = split {
  zero -> refl (numB m) ;
  suc n | r -> apH (\ x -> Sb x) r } ;

-- Agda: _·ℕ_, ι-*-homo
timesN (m : Nat) : Nat -> Nat = split { zero -> zero ; suc n | r -> plusN r m } ;
num-times (m : Nat) : (n : Nat) -> Id Br (mul (numB m) (numB n)) (numB (timesN m n)) = split {
  zero -> refl Zb ;
  suc n | r -> calc Br {
    add (mul (numB m) (numB n)) (numB m) =< apH (\ z -> add z (numB m)) r >
    add (numB (timesN m n)) (numB m) =< symH (num-plus (timesN m n) m) >
    numB (plusN (timesN m n) m) } } ;
