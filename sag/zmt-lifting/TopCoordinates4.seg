-- TopCoordinates4.seg: the twenty top coordinates of C^3(-7) (handoff §7).
--
-- T20 (TopList4) has length 20 (t20-length, by computation), no
-- duplicates and is exhaustive.  For w in C^3(-7),
--   top(w)_k = w_0123(-t_k),   t_k = (a_0,..,a_3) the k-th quadruple,
-- a vector of V = D^20 (top: D-linear by definition, the operations being
-- pointwise).  Expansion: for p in V,
--   expand p = sum_k p_k X^(-t_k)      (mono: the monomial x X^e, at m equal
--                                        to x if m = e, else 0).
-- Theorem (pi-expand): pi(w) = expand (top w), pointwise:
--   * if some exponent of m is >= 0, pi w (m) = 0 and m is no top exponent
--     (a top exponent has four negative coordinates: not-top0 .. not-top3),
--     so every term of the sum is 0 (sum-vanish);
--   * if all four are negative and deg m = -7, m = -t for the quadruple
--     t = (n_i + 1) in T20 (top-mem); the terms at the other entries vanish
--     since T20 has no duplicates and -t determines t (sum-single), so the
--     sum is top(w) at t = w(m) = pi w (m);
--   * if all four are negative and deg m /= -7, w(m) = 0 by homogeneity,
--     and a term at an entry equal to m is w(m) = 0.
-- Corollary (pi-zero): top(w) = 0 implies pi(w) = 0.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open TopList4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module LG = Logic[l] ; module Ps = Presentations[l] ;
module NA = NatArith[l] ;

twenty : Nat = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc
  (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))) ;
t20-length : Id Nat (len T20) twenty = refl twenty ;

-- -t determines t
negsuc-inj (a b : Base.Nat) (e : Id Int (negsuc a) (negsuc b)) : Id Base.Nat a b = NA.code-eq a b (encode (negsuc a) (negsuc b) e) ;
topExp-inj : (q q' : Q4) -> Id E4 (topExp q) (topExp q') -> Id Q4 q q' = split {
  q4 a b c d -> split {
    q4 a' b' c' d' -> \ e -> q4-eq a b c d a' b' c' d'
      (negsuc-inj a a' (ap e0 e)) (negsuc-inj b b' (ap e1 e)) (negsuc-inj c c' (ap e2 e)) (negsuc-inj d d' (ap e3 e)) } } ;

-- an exponent with a coordinate >= 0 is not a top exponent
not-top0 (n : Base.Nat) (b c d : Int) : (q : Q4) -> Id E4 (ex (pos n) b c d) (topExp q) -> Base.Empty = split {
  q4 a0 a1 a2 a3 -> \ e -> encode (pos n) (negsuc a0) (ap e0 e) } ;
not-top1 (a : Int) (n : Base.Nat) (c d : Int) : (q : Q4) -> Id E4 (ex a (pos n) c d) (topExp q) -> Base.Empty = split {
  q4 a0 a1 a2 a3 -> \ e -> encode (pos n) (negsuc a1) (ap e1 e) } ;
not-top2 (a b : Int) (n : Base.Nat) (d : Int) : (q : Q4) -> Id E4 (ex a b (pos n) d) (topExp q) -> Base.Empty = split {
  q4 a0 a1 a2 a3 -> \ e -> encode (pos n) (negsuc a2) (ap e2 e) } ;
not-top3 (a b c : Int) (n : Base.Nat) : (q : Q4) -> Id E4 (ex a b c (pos n)) (topExp q) -> Base.Empty = split {
  q4 a0 a1 a2 a3 -> \ e -> encode (pos n) (negsuc a3) (ap e3 e) } ;

-- the entry at an index is a member
elem-mem : (ls : List Q4) (k : Ps.Fin (len ls)) -> MemQ (elemQ ls k) ls = split {
  nil -> \ k -> absurd (MemQ (elemQ nil k) nil) k ;
  cons t s | r -> split {
    inl i -> inr (r i) ;
    inr u -> inl (refl t) } } ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ; module CC = Cech4Contraction[l].Over[D,setD] ;
  module RS = Comb[l].Sums[D,IP.regular D] ;
  module V = Comb[l].Free[D,len T20] ;
  module G = C.Deg[mSeven] ;

  -- the top coordinates
  topv (w : Sq -> E4 -> D.R) : V.Vec = \ k -> w s0123 (topExp (elemQ T20 k)) ;
  top : IP.Lin[D,G.C3.mod,V.mod] =
    IP.mkLin D G.C3.mod V.mod (\ w -> topv (G.C3.val w))
      (\ w w' -> refl (\ k -> D.add (G.C3.val w s0123 (topExp (elemQ T20 k))) (G.C3.val w' s0123 (topExp (elemQ T20 k)))))
      (\ r w -> refl (\ k -> D.mul r (G.C3.val w s0123 (topExp (elemQ T20 k))))) ;

  -- the monomial x X^e, at m
  monoD (x : D.R) (P : U l) : LG.Dec P -> D.R = split { yes p -> x ; no n -> D.z } ;
  mono (e : E4) (x : D.R) (m : E4) : D.R = monoD x (Id E4 m e) (dec-e4 m e) ;
  monoD-zero (x : D.R) (P : U l) (h : P -> Id D.R x D.z) : (d : LG.Dec P) -> Id D.R (monoD x P d) D.z = split {
    yes p -> h p ; no n -> refl D.z } ;
  monoD-at (x : D.R) (P : U l) (p : P) : (d : LG.Dec P) -> Id D.R (monoD x P d) x = split {
    yes p' -> refl x ; no n -> Pr.absurd (Id D.R D.z x) (n p) } ;

  -- sum_{q in ls} f(q) X^(topExp q), at m
  sumQ (ls : List Q4) (f : Q4 -> D.R) (m : E4) : D.R =
    RS.sum (len ls) (\ k -> mono (topExp (elemQ ls k)) (f (elemQ ls k)) m) ;
  -- by definition of sumQ and RS.sum
  sumQ-cons (t : Q4) (s : List Q4) (f : Q4 -> D.R) (m : E4) :
    Id D.R (sumQ (cons t s) f m) (D.add (mono (topExp t) (f t) m) (sumQ s f m)) = refl (sumQ (cons t s) f m) ;

  -- every term vanishes
  sum-vanish (ls : List Q4) (f : Q4 -> D.R) (m : E4)
    (h : (k : Ps.Fin (len ls)) -> Id E4 m (topExp (elemQ ls k)) -> Id D.R (f (elemQ ls k)) D.z) : Id D.R (sumQ ls f m) D.z =
    trans (RS.sum-cong (len ls) (\ k -> mono (topExp (elemQ ls k)) (f (elemQ ls k)) m) (\ k -> D.z)
             (\ k -> monoD-zero (f (elemQ ls k)) (Id E4 m (topExp (elemQ ls k))) (h k) (dec-e4 m (topExp (elemQ ls k)))))
          (RS.sum-zero (len ls)) ;

  -- a single term survives: q in ls, ls without duplicates
  module Single (t : Q4) (s : List Q4) (f : Q4 -> D.R) (q : Q4) (nd : NoDup (cons t s)) {
    -- topExp q at an entry of s is q itself, a member of s
    in-s (k : Ps.Fin (len s)) (e : Id E4 (topExp q) (topExp (elemQ s k))) : MemQ q s =
      subst (\ x -> MemQ x s) (sym (topExp-inj q (elemQ s k) e)) (elem-mem s k) ;
    head (e : Id Q4 t q) : Id D.R (sumQ (cons t s) f (topExp q)) (f q) =
      calc D.R { sumQ (cons t s) f (topExp q)
                   =< ap (\ x -> D.add x (sumQ s f (topExp q))) (monoD-at (f t) (Id E4 (topExp q) (topExp t)) (ap topExp (sym e)) (dec-e4 (topExp q) (topExp t)))
                   > D.add (f t) (sumQ s f (topExp q))
                   =< ap (D.add (f t)) (sum-vanish s f (topExp q) (\ k e' -> Pr.absurd (Id D.R (f (elemQ s k)) D.z)
                        (nd.1 (subst (\ x -> MemQ x s) (sym e) (in-s k e')))))
                   > D.add (f t) D.z
                   =< trans (D.addZ (f t)) (ap f e) > f q } ;
    tail (h : MemQ q s) (ih : Id D.R (sumQ s f (topExp q)) (f q)) : Id D.R (sumQ (cons t s) f (topExp q)) (f q) =
      calc D.R { sumQ (cons t s) f (topExp q)
                   =< ap (\ x -> D.add x (sumQ s f (topExp q)))
                        (monoD-zero (f t) (Id E4 (topExp q) (topExp t))
                          (\ e -> Pr.absurd (Id D.R (f t) D.z) (nd.1 (subst (\ x -> MemQ x s) (topExp-inj q t e) h)))
                          (dec-e4 (topExp q) (topExp t)))
                   > D.add D.z (sumQ s f (topExp q))
                   =< trans (C.DL.G.zl (sumQ s f (topExp q))) ih > f q } ;
  } ;
  sum-single : (ls : List Q4) (f : Q4 -> D.R) (q : Q4) (nd : NoDup ls) (mq : MemQ q ls) -> Id D.R (sumQ ls f (topExp q)) (f q) = split {
    nil -> \ f q nd mq -> Pr.absurd (Id D.R (sumQ nil f (topExp q)) (f q)) mq ;
    cons t s | r -> \ f q nd -> split {
      inl e -> Single[t,s,f,q,nd].head e ;
      inr h -> Single[t,s,f,q,nd].tail h (r f q nd.2 h) } } ;

  -- the expansion sum_k p_k X^(-t_k)
  expand (p : V.Vec) (i : Sq) (m : E4) : D.R = RS.sum (len T20) (\ k -> mono (topExp (elemQ T20 k)) (p k) m) ;
  expand-zero (i : Sq) (m : E4) : Id D.R (expand V.mod.mz i m) D.z =
    trans (RS.sum-cong (len T20) (\ k -> mono (topExp (elemQ T20 k)) D.z m) (\ k -> D.z)
             (\ k -> monoD-zero D.z (Id E4 m (topExp (elemQ T20 k))) (\ e -> refl D.z) (dec-e4 m (topExp (elemQ T20 k)))))
          (RS.sum-zero (len T20)) ;

  ------------------------------------------------------------------------
  -- pi(w) = expand (top w)

  module Expand (w : G.C3.El) {
    c : Sq -> E4 -> D.R = G.C3.val w ;
    f (q : Q4) : D.R = c s0123 (topExp q) ;
    -- expand (top w) is sumQ T20 f, by definition
    PhiE (m : E4) : U l = Id D.R (CC.pi c s0123 m) (sumQ T20 f m) ;
    -- an exponent with a coordinate >= 0: both sides are 0
    pos0 (n : Base.Nat) (x1 x2 x3 : Int) : PhiE (ex (pos n) x1 x2 x3) =
      sym (sum-vanish T20 f (ex (pos n) x1 x2 x3) (\ k e -> Pr.absurd (Id D.R (f (elemQ T20 k)) D.z) (not-top0 n x1 x2 x3 (elemQ T20 k) e))) ;
    pos1 (n0 n : Base.Nat) (x2 x3 : Int) : PhiE (ex (negsuc n0) (pos n) x2 x3) =
      sym (sum-vanish T20 f (ex (negsuc n0) (pos n) x2 x3) (\ k e -> Pr.absurd (Id D.R (f (elemQ T20 k)) D.z) (not-top1 (negsuc n0) n x2 x3 (elemQ T20 k) e))) ;
    pos2 (n0 n1 n : Base.Nat) (x3 : Int) : PhiE (ex (negsuc n0) (negsuc n1) (pos n) x3) =
      sym (sum-vanish T20 f (ex (negsuc n0) (negsuc n1) (pos n) x3) (\ k e -> Pr.absurd (Id D.R (f (elemQ T20 k)) D.z) (not-top2 (negsuc n0) (negsuc n1) n x3 (elemQ T20 k) e))) ;
    pos3 (n0 n1 n2 n : Base.Nat) : PhiE (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) =
      sym (sum-vanish T20 f (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (\ k e -> Pr.absurd (Id D.R (f (elemQ T20 k)) D.z) (not-top3 (negsuc n0) (negsuc n1) (negsuc n2) n (elemQ T20 k) e))) ;
    -- all four exponents negative
    module Neg4 (n0 n1 n2 n3 : Base.Nat) {
      m : E4 = ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3) ;
      top-case (e : Id Int (deg m) mSeven) : PhiE m =
        sym (sum-single T20 f (q4 n0 n1 n2 n3) t20-nodup (top-mem n0 n1 n2 n3 e)) ;
      -- w(m) = 0 by homogeneity
      w-zero (ne : LG.Not (Id Int (deg m) mSeven)) : Id D.R (c s0123 m) D.z =
        G.C3.van w s0123 m (inl (\ x -> Pr.absurd Empty (ne x))) ;
      other-case (ne : LG.Not (Id Int (deg m) mSeven)) : PhiE m =
        trans (w-zero ne) (sym (sum-vanish T20 f m (\ k e -> trans (ap (c s0123) (sym e)) (w-zero ne)))) ;
      by-degree : LG.Dec (Id Int (deg m) mSeven) -> PhiE m = split {
        yes e -> top-case e ;
        no ne -> other-case ne } ;
      res : PhiE m = by-degree (int-dec (deg m) mSeven) ;
    } ;
    at : (m : E4) -> PhiE m = Cech4Contraction[l].Signs[PhiE, pos0, pos1, pos2, pos3, \ n0 n1 n2 n3 -> Neg4[n0,n1,n2,n3].res].elim ;
  } ;
  pi-expand (w : G.C3.El) : (i : Sq) (m : E4) -> Id D.R (CC.pi (G.C3.val w) i m) (expand (top.f w) i m) = split {
    s0123 -> Expand[w].at } ;

  -- top(w) = 0 gives pi(w) = 0
  pi-zero (w : G.C3.El) (h : Id V.Vec (top.f w) V.mod.mz) : Id G.C3.El (CC.Contr[mSeven].piE w) G.C3.mod.mz =
    G.C3.eq (CC.Contr[mSeven].piE w) G.C3.mod.mz (\ i m ->
      trans (pi-expand w i m) (trans (ap (\ p -> expand p i m) h) (expand-zero i m))) ;
} ;
