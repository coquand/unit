-- CertifiedDependence.seg: Stage 1, the finite relation-certificate lemma
-- with partners given only under truncation (zmt-formal-cohomology.tex,
-- « A further shortcut: do not generate the finite kernel »).
--
-- Theorem (certificate).  Let D be CFN (CFN.CFN K0 D), Z a D-module, v a
-- natural number, V = D^v, and R a relation certificate between Z and V
-- (RelationCertificate.Rel).  Let b : Nat -> Z with, for every n, merely a
-- p : V with Gam(b_n, p).  Then merely there is qs = [q_(N-1),..,q_0], N =
-- len qs, with B(b_N - sum_{i<N} q_i b_i).
--
-- No function Nat -> V choosing the partners is formed.  Proof by the
-- principle of free lists in V (CFN.fl via FreeNoeth.fl-vec), following
-- SeqDependence.Over with chosen prefixes in place of a given sequence.
-- For a list s of vectors put
--   Chi s = for every n and every prefix c of length n of chosen partners
--           (RelationCertificate.Seq.Prefix) with span s included in
--           span (partners c), merely a certificate          (a proposition).
-- Step: s free, Chi (x :: s) for x outside span s, n, c and span s in
-- span (partners c).  The goal is a proposition, so eliminate the ONE mere
-- partner of b_n: p with g : Gam(b_n, p).  Decide p in span s by (D) for V
-- (FreeDisc.disc-vec).  If yes, p is merely in span (partners c), and
-- RelationCertificate.Seq.dependent gives a certificate at N = n.  If no,
-- Chi (p :: s) holds; extend c by (p, g) to a prefix of length n+1, whose
-- partners p :: partners c span a module containing span (p :: s); apply
-- it.  (FL) gives Chi nil, used at n = 0 with the empty prefix.
-- Every type is in U l: the free lists, the prefixes and the goal.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Over (K0 : U l) (D : CRing) (cfn : CFN[l].CFN[K0,D]) (Zm : IP.Mod[D]) (v : Nat)
  (R : RelationCertificate[l].Rel[D,Zm,Comb[l].Free[D,v].mod]) (b : Nat -> Zm.M)
  (partner : (n : Nat) -> Tr.Trunc[(p : Comb[l].Free[D,v].Vec) * R.Gam (b n) p].carrier) {
  module FV = Comb[l].Free[D,v] ;
  module RC = RelationCertificate[l].Over[D,Zm,FV.mod,R] ;
  module RS = RC.Seq[b] ;
  module MS = Spans[l].Over[D,FV.mod] ;
  module FD = FreeDisc[l].Over[D,cfn.disc,cfn.coh] ;
  module FN = FreeNoeth[l].Over[D,cfn.disc,cfn.coh,CFN[l].fl K0 D cfn] ;
  module TG = Tr.Trunc[RS.Cert] ;

  Partner (n : Nat) : U l = (p : FV.Vec) * R.Gam (b n) p ;

  Chi (s : List FV.Vec) : U l = (n : Nat) (c : RS.Prefix n) -> MS.Sub s (RS.partners n c) -> TG.carrier ;
  chi-prop (s : List FV.Vec) : Pr.isProp (Chi s) =
    FE.isProp-Pi Nat (\ n -> (c : RS.Prefix n) -> MS.Sub s (RS.partners n c) -> TG.carrier)
      (\ n -> FE.isProp-Pi (RS.Prefix n) (\ c -> MS.Sub s (RS.partners n c) -> TG.carrier)
        (\ c -> FE.isProp-Pi (MS.Sub s (RS.partners n c)) (\ h -> TG.carrier) (\ h -> TG.proposition))) ;

  module Step (s : List FV.Vec) (hyp : (x : FV.Vec) -> Not (MS.SP.In s x) -> Chi (cons x s))
    (n : Nat) (c : RS.Prefix n) (sub : MS.Sub s (RS.partners n c)) (pg : Partner n) {
    -- the chosen partner and its certificate
    p : FV.Vec = pg.1 ;
    g : R.Gam (b n) p = pg.2 ;
    -- p in span s, so merely in span (partners c): a certificate at n
    yes (h : MS.Mm s p) : TG.carrier =
      MS.mm-rec (RS.partners n c) p TG.carrier TG.proposition
        (\ i -> TG.inc (RS.dependent n c p g i)) (sub p h) ;
    -- p outside span s: extend the prefix by (p, g)
    no (h : Not (MS.Mm s p)) : TG.carrier =
      hyp p (\ i -> h (MS.mm s p i)) (suc n) (c, pg) (MS.cons-mono p s (RS.partners n c) sub) ;
    result : Plus (MS.Mm s p) (Not (MS.Mm s p)) -> TG.carrier = split {
      inl h -> yes h ;
      inr h -> no h } ;
    cert : TG.carrier = result (MS.dec-list (FD.disc-vec v) s p) ;
  } ;
  -- eliminate the one mere partner of b_n
  step (s : List FV.Vec) (hyp : (x : FV.Vec) -> Not (MS.SP.In s x) -> Chi (cons x s)) : Chi s =
    \ n c sub -> TC.rec (Partner n) @l TG.carrier TG.proposition (\ pg -> Step[s,hyp,n,c,sub,pg].cert) (partner n) ;

  certificate : TG.carrier =
    FN.fl-vec v Chi chi-prop (\ s fs hyp -> step s hyp) nil tt zero tt (\ y h -> h) ;
} ;
