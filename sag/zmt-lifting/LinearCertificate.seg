-- LinearCertificate.seg: the test instance of Stage 1 (handoff §4).
--
-- For a D-linear map L : D^v -> Z put
--   Gam(z,p) := z = L(p),     B(z) := z = 0.
-- Closure: 0 = L(0); z = L p, z' = L p' give z + z' = L(p + p');
-- z = L p gives c z = L(c p).  Zero-reflection: z = L(0) = 0.
-- Neither Z noetherian nor equality in Z decidable is assumed.  The
-- theorem: if every b_n is merely L(p) for some p, then merely
-- b_N - sum_{i<N} q_i b_i = 0.  v = 0 and N = 0 are covered by the generic
-- proof without case distinction (at-zero: the instance V = D^0).
level l ; open Ring[l] ;
module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

module Over (K0 : U l) (D : CRing) (cfn : CFN[l].CFN[K0,D]) (Zm : IP.Mod[D]) (v : Nat)
  (L : IP.Lin[D,Comb[l].Free[D,v].mod,Zm]) {
  module FV = Comb[l].Free[D,v] ;
  module ZL = IP.ModL[D,Zm] ; module VL = IP.ModL[D,FV.mod] ;

  -- L(0) = 0
  lin-zero : Id Zm.M (L.f FV.mod.mz) Zm.mz = RelationCertificate[l].LinL[D,FV.mod,Zm,L].f-zero ;

  Gam (z : Zm.M) (p : FV.Vec) : U l = Id Zm.M z (L.f p) ;
  B (z : Zm.M) : U l = Id Zm.M z Zm.mz ;

  rel : RelationCertificate[l].Rel[D,Zm,FV.mod] =
    RelationCertificate[l].mkRel D Zm FV.mod B Gam
      (sym lin-zero)
      (\ z z' p p' g g' -> trans (ZL.G.cong-add g g') (sym (L.f-add p p')))
      (\ c z p g -> trans (ap (Zm.sm c) g) (sym (L.f-sm c p)))
      (\ z g -> trans g lin-zero) ;

  -- every b_n merely in the image of L => merely b_N = sum_{i<N} q_i b_i
  module Dep (b : Nat -> Zm.M) (partner : (n : Nat) -> Tr.Trunc[(p : FV.Vec) * Gam (b n) p].carrier) {
    module CD = CertifiedDependence[l].Over[K0,D,cfn,Zm,v,rel,b,partner] ;
    certificate : Tr.Trunc[CD.RS.Cert].carrier = CD.certificate ;
  } ;
} ;

-- the degenerate rank v = 0
at-zero (K0 : U l) (D : CRing) (cfn : CFN[l].CFN[K0,D]) (Zm : IP.Mod[D])
  (L : IP.Lin[D,Comb[l].Free[D,zero].mod,Zm]) (b : Nat -> Zm.M)
  (partner : (n : Nat) -> Tr.Trunc[(p : Comb[l].Free[D,zero].Vec) * Over[K0,D,cfn,Zm,zero,L].Gam (b n) p].carrier) :
  Tr.Trunc[Over[K0,D,cfn,Zm,zero,L].Dep[b,partner].CD.RS.Cert].carrier =
  Over[K0,D,cfn,Zm,zero,L].Dep[b,partner].certificate ;
