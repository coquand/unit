-- CubicExample.seg: a nonzero top cycle (handoff §10), over any
-- commutative set-ring D; the coordinate is 1, nonzero when 1 /= 0 (over Z
-- by one-ne-zero).
--
-- w = X_0^-1 X_1^-1 X_2^-1 X_3^-4 in C^3(-7): exponent (-1,-1,-1,-4), the
-- top exponent of tq = (0,0,0,3), i.e. a = (1,1,1,4).  Put
--   u_023 = Q w  (exponent (-1, 2,-1,-4)),  other components of u zero;
--   v_123 = P w  (exponent ( 2,-1,-1,-4)),  other components of v zero;
--   b_23  = P Q w (exponent ( 2, 2,-1,-4)),  other components of b zero.
-- Each is a single monomial satisfying its chart condition (the exponents
-- outside the chart are 2 >= 0) and of the right degree (-4, -4, -1); a
-- monomial at m vanishes at every other exponent, so the vanishing
-- conditions reduce to: m = (that exponent) is not Bad (bad-*).  With the
-- fixed alternating convention
--   (d b)_012 = (0 - 0) + 0,  (d b)_013 = (0 - 0) + 0,
--   (d b)_023 = (PQw - 0) + 0 = (P u)_023,  (d b)_123 = (PQw - 0) + 0 = (Q v)_123,
-- so d b = P u + Q v (e1).  The raising formula gives
--   X_0^-3 (d v) = X_0^-3 ((((P w - 0) + 0) - 0)) = w      (raises-w),
-- hence d u = -Q w and d v = P w (eu, ev, from CubicCertificate.Raise) and
-- Gam(b, top w).  The coordinate of top w at tq (the index of the head of
-- T20) is 1 (coord), so top w /= 0 as soon as 1 /= 0 (nonzero).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open TopList4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;

-- the exponents of the example
ew : E4 = topExp tq ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module CK = CubicCertificate[l].Over[D,setD] ;
  module C = CK.C ; module CC = CK.CC ; module TP = CK.TP ;
  module G1 = CK.G1 ; module G4 = CK.G4 ; module G7 = CK.G7 ;

  -- the monomial X^e with coefficient 1, at m
  mon (e : E4) (m : E4) : D.R = TP.mono e D.o m ;
  -- it vanishes away from e
  mon-away (e m : E4) (h : Id E4 m e -> Empty) : Id D.R (mon e m) D.z =
    TP.monoD-zero D.o (Id E4 m e) (\ q -> absurd (Id D.R D.o D.z) (h q)) (dec-e4 m e) ;
  -- a single-point support
  away1 (e m : E4) (nm : Not (Mem m (cons e nil))) (q : Id E4 m e) : Empty = nm (inl (sym q)) ;

  ------------------------------------------------------------------------
  -- w in C^3(-7)

  wv : Sq -> E4 -> D.R = \ i m -> mon ew m ;
  bad-w (m : E4) : Bad mSeven full m -> Id E4 m ew -> Empty = split {
    inl ne -> \ q -> ne (ap deg q) ;
    inr o -> \ q -> out-full m o } ;
  w-van : G7.C3.Van wv = split { s0123 -> \ m b -> mon-away ew m (bad-w m b) } ;
  wE : G7.C3.El =
    G7.C3.mk wv (Tr.Trunc[G7.C3.SuppW wv].inc (cons ew nil, \ i m nm -> mon-away ew m (away1 ew m nm))) w-van ;

  ------------------------------------------------------------------------
  -- u_023 = Q w, v_123 = P w, b_23 = P Q w

  uv : Tri -> E4 -> D.R = split {
    t012 -> \ m -> D.z ; t013 -> \ m -> D.z ; t023 -> \ m -> mon ew (sh1 m) ; t123 -> \ m -> D.z } ;
  vv : Tri -> E4 -> D.R = split {
    t012 -> \ m -> D.z ; t013 -> \ m -> D.z ; t023 -> \ m -> D.z ; t123 -> \ m -> mon ew (sh0 m) } ;
  bv : Ed -> E4 -> D.R = split {
    e01 -> \ m -> D.z ; e02 -> \ m -> D.z ; e03 -> \ m -> D.z ;
    e12 -> \ m -> D.z ; e13 -> \ m -> D.z ; e23 -> \ m -> mon ew (sh1 (sh0 m)) } ;

  -- the exponents of the three monomials
  eu-at (m : E4) (q : Id E4 (sh1 m) ew) : Id E4 m (up1 ew) = trans (sym (up1-sh1 m)) (ap up1 q) ;
  ev-at (m : E4) (q : Id E4 (sh0 m) ew) : Id E4 m (up0 ew) = trans (sym (up0-sh0 m)) (ap up0 q) ;
  eb-at (m : E4) (q : Id E4 (sh1 (sh0 m)) ew) : Id E4 m (up0 (up1 ew)) =
    trans (sym (up0-sh0 m)) (ap up0 (eu-at (sh0 m) q)) ;

  -- none of them is Bad for its chart and degree
  out-u : Out (setTri t023) (up1 ew) -> Empty = split { o0 h -> h ; o1 h -> h ; o2 h -> h ; o3 h -> h } ;
  out-v : Out (setTri t123) (up0 ew) -> Empty = split { o0 h -> h ; o1 h -> h ; o2 h -> h ; o3 h -> h } ;
  out-b : Out (setEd e23) (up0 (up1 ew)) -> Empty = split { o0 h -> h ; o1 h -> h ; o2 h -> h ; o3 h -> h } ;
  bad-u (m : E4) (e : Id E4 m (up1 ew)) : Bad mFour (setTri t023) m -> Empty = split {
    inl ne -> ne (ap deg e) ;
    inr o -> out-u (subst (Out (setTri t023)) e o) } ;
  bad-v (m : E4) (e : Id E4 m (up0 ew)) : Bad mFour (setTri t123) m -> Empty = split {
    inl ne -> ne (ap deg e) ;
    inr o -> out-v (subst (Out (setTri t123)) e o) } ;
  bad-b (m : E4) (e : Id E4 m (up0 (up1 ew))) : Bad mOne (setEd e23) m -> Empty = split {
    inl ne -> ne (ap deg e) ;
    inr o -> out-b (subst (Out (setEd e23)) e o) } ;

  u-van : G4.C2.Van uv = split {
    t012 -> \ m b -> refl D.z ; t013 -> \ m b -> refl D.z ; t123 -> \ m b -> refl D.z ;
    t023 -> \ m b -> mon-away ew (sh1 m) (\ q -> bad-u m (eu-at m q) b) } ;
  u-vanish : G4.C2.Vanish (cons (up1 ew) nil) uv = split {
    t012 -> \ m n -> refl D.z ; t013 -> \ m n -> refl D.z ; t123 -> \ m n -> refl D.z ;
    t023 -> \ m n -> mon-away ew (sh1 m) (\ q -> away1 (up1 ew) m n (eu-at m q)) } ;
  v-van : G4.C2.Van vv = split {
    t012 -> \ m b -> refl D.z ; t013 -> \ m b -> refl D.z ; t023 -> \ m b -> refl D.z ;
    t123 -> \ m b -> mon-away ew (sh0 m) (\ q -> bad-v m (ev-at m q) b) } ;
  v-vanish : G4.C2.Vanish (cons (up0 ew) nil) vv = split {
    t012 -> \ m n -> refl D.z ; t013 -> \ m n -> refl D.z ; t023 -> \ m n -> refl D.z ;
    t123 -> \ m n -> mon-away ew (sh0 m) (\ q -> away1 (up0 ew) m n (ev-at m q)) } ;
  b-van : G1.C1.Van bv = split {
    e01 -> \ m b -> refl D.z ; e02 -> \ m b -> refl D.z ; e03 -> \ m b -> refl D.z ;
    e12 -> \ m b -> refl D.z ; e13 -> \ m b -> refl D.z ;
    e23 -> \ m b -> mon-away ew (sh1 (sh0 m)) (\ q -> bad-b m (eb-at m q) b) } ;
  b-vanish : G1.C1.Vanish (cons (up0 (up1 ew)) nil) bv = split {
    e01 -> \ m n -> refl D.z ; e02 -> \ m n -> refl D.z ; e03 -> \ m n -> refl D.z ;
    e12 -> \ m n -> refl D.z ; e13 -> \ m n -> refl D.z ;
    e23 -> \ m n -> mon-away ew (sh1 (sh0 m)) (\ q -> away1 (up0 (up1 ew)) m n (eb-at m q)) } ;

  uE : G4.C2.El = G4.C2.mk uv (Tr.Trunc[G4.C2.SuppW uv].inc (cons (up1 ew) nil, u-vanish)) u-van ;
  vE : G4.C2.El = G4.C2.mk vv (Tr.Trunc[G4.C2.SuppW vv].inc (cons (up0 ew) nil, v-vanish)) v-van ;
  bE : G1.C1.El = G1.C1.mk bv (Tr.Trunc[G1.C1.SuppW bv].inc (cons (up0 (up1 ew)) nil, b-vanish)) b-van ;

  ------------------------------------------------------------------------
  -- d b = P u + Q v

  -- (0 - 0) + 0 = 0 + 0 ;  (x - 0) + 0 = x + 0 ;  (x - 0) + 0 = 0 + y when x = y
  s0 : Id D.R (D.add (C.DL.msub D.z D.z) D.z) (D.add D.z D.z) = ap (\ t -> D.add t D.z) CC.zz ;
  s1 (x : D.R) : Id D.R (D.add (C.DL.msub x D.z) D.z) (D.add x D.z) = ap (\ t -> D.add t D.z) (C.sub-zero-r x) ;
  s2 (x y : D.R) (e : Id D.R x y) : Id D.R (D.add (C.DL.msub x D.z) D.z) (D.add D.z y) =
    trans (CC.H1 x) (trans e (sym (C.DL.G.zl y))) ;
  e1-pt : (j : Tri) (m : E4) -> Id D.R (C.d1 bv j m) (D.add (uv j (sh0 m)) (vv j (sh1 m))) = split {
    t012 -> \ m -> s0 ; t013 -> \ m -> s0 ;
    t023 -> \ m -> s1 (mon ew (sh1 (sh0 m))) ;
    t123 -> \ m -> s2 (mon ew (sh1 (sh0 m))) (mon ew (sh0 (sh1 m))) (ap (mon ew) (sym (sh-comm m))) } ;
  e1 : CK.E1 bE uE vE =
    G1.C2.eq ((C.D1 mOne).f bE) (G1.C2.mod.madd (CK.S2.P.f uE) (CK.S2.Q.f vE)) e1-pt ;

  ------------------------------------------------------------------------
  -- the raising formula recovers w

  module R = CK.Raise[bE,uE,vE,e1] ;
  raises-w-pt : (i : Sq) (m : E4) -> Id D.R (G7.C3.val R.w i m) (wv i m) = split {
    s0123 -> \ m -> trans (CC.H13 (mon ew (sh0 (up0 m)))) (ap (mon ew) (sh0-up0 m)) } ;
  raises-w : Id G7.C3.El R.w wE = G7.C3.eq R.w wE raises-w-pt ;
  -- d u = -Q w and d v = P w
  eu : CK.E2u uE wE = subst (CK.E2u uE) raises-w R.eu ;
  ev : CK.E2v vE wE = subst (CK.E2v vE) raises-w R.ev ;
  witness : CK.Witness bE (TP.top.f wE) = CK.mkWit bE (TP.top.f wE) uE vE wE e1 eu ev (refl (TP.top.f wE)) ;
  gam : CK.Gam bE (TP.top.f wE) = Tr.Trunc[CK.Witness bE (TP.top.f wE)].inc witness ;

  -- the coordinate at tq (the head of T20) is 1
  coord : Id D.R (TP.top.f wE (inr tt)) D.o = TP.monoD-at D.o (Id E4 ew ew) (refl ew) (dec-e4 ew ew) ;
  nonzero (nz : Not (Id D.R D.o D.z)) : Not (Id TP.V.Vec (TP.top.f wE) TP.V.mod.mz) =
    \ e -> nz (trans (sym coord) (ap (\ p -> p (inr tt)) e)) ;
} ;

-- over Z: 1 /= 0
one-ne-zero : Not (Id Int (ZRing[l].one) zeroZ) = \ e -> Pr.absurd Empty (encode ZRing[l].one zeroZ e) ;
module OverZ {
  module X = Over[ZRing[l].ring, int-set] ;
  nonzero-Z : Not (Id X.TP.V.Vec (X.TP.top.f X.wE) X.TP.V.mod.mz) = X.nonzero one-ne-zero ;
} ;
