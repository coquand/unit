-- Cech4Contraction.seg: the free-cochain contractions of the four-chart
-- complex (handoff §6): pi and sigma on C^3(k), and the contractions of
-- closed cochains in C^2(k) and C^1(k) (in particular k = -4 and k = -1).
--
-- Selection (Signs, sel).  At an exponent m = (a,b,c,d) let j be the first
-- coordinate with exponent >= 0, decided by the signs of a, b, c, d (no
-- decision in D); when all four are negative there is no j.
--
-- Cone at a fixed vertex j (cone1, cone2, cone3).  With c~ the alternating
-- extension of c (c~ = 0 on repeated indices),
--   (cone_j c)_E = c~_(j,E) = (-1)^p c_(E+j)   if j is not in E,
--   (cone_j c)_E = 0                           if j is in E,
-- p the position of j in the increasing enumeration of E+j.  For every raw
-- family c and every exponent (htpy1, htpy2, top3):
--   d0 (cone_j c) + cone_j (d1 c) = c      on C^1,
--   d1 (cone_j c) + cone_j (d2 c) = c      on C^2,
--   d2 (cone_j w) = w                      on C^3.
-- These are 44 identities in the abelian group D, of 16 shapes H1 .. H16
-- (each shape lemma is proved below; the tables were checked against a
-- direct computation of the signs).
--
-- Selected contraction (h1, h2, h3): (h c)_E (m) = (cone_j c)_E (m) for the
-- selected j of m, and 0 if every exponent of m is negative.  pi w (m) = w(m)
-- if every exponent is negative, 0 otherwise: it retains the monomials with
-- all four exponents negative.  Since d is pointwise in m, at an exponent
-- with selected j the identities above hold verbatim (htpy1-sel, ..).  At an
-- exponent with all coordinates negative, h = 0 and pi w = w; a component of
-- C^1 or C^2 vanishes there by its chart condition (E is not all of
-- {0,1,2,3}), so (allneg1, allneg2, allneg3)
--   d h c + h d c = c   (q = 1, 2, c satisfying the chart conditions),
--   d (h w) + pi w = w  (q = 3), i.e. d sigma w = w - pi w with sigma = h3.
-- Chart conditions: at the selected j (exponent >= 0), Bad at E gives Bad
-- at E + j (bad-swap0 .. 3: the flag of j does not matter), so
-- (h c)_E (m) = +- c_(E+j)(m) = 0; finite support: the same list.
-- Consequences (Contr): for closed c in C^2(k), a = h2 c has d a = c; for
-- closed c in C^1(k), h = h1 c has d h = c (h3 (d c) = 0 and h2 (d c) = 0);
-- pi (d u) = 0 for u in C^2(k) (pi-d).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

-- the flag of a coordinate with exponent >= 0 does not matter for Bad
bad-swap0 (k : Int) (s0 s1 s2 s3 t : Fl) (n : Base.Nat) (b c d : Int) :
  Bad k (sub s0 s1 s2 s3) (ex (pos n) b c d) -> Bad k (sub t s1 s2 s3) (ex (pos n) b c d) = split {
  inl h -> inl h ; inr h -> inr (out-swap0 s0 s1 s2 s3 t n b c d h) } ;
bad-swap1 (k : Int) (s0 s1 s2 s3 t : Fl) (a : Int) (n : Base.Nat) (c d : Int) :
  Bad k (sub s0 s1 s2 s3) (ex a (pos n) c d) -> Bad k (sub s0 t s2 s3) (ex a (pos n) c d) = split {
  inl h -> inl h ; inr h -> inr (out-swap1 s0 s1 s2 s3 t a n c d h) } ;
bad-swap2 (k : Int) (s0 s1 s2 s3 t : Fl) (a b : Int) (n : Base.Nat) (d : Int) :
  Bad k (sub s0 s1 s2 s3) (ex a b (pos n) d) -> Bad k (sub s0 s1 t s3) (ex a b (pos n) d) = split {
  inl h -> inl h ; inr h -> inr (out-swap2 s0 s1 s2 s3 t a b n d h) } ;
bad-swap3 (k : Int) (s0 s1 s2 s3 t : Fl) (a b c : Int) (n : Base.Nat) :
  Bad k (sub s0 s1 s2 s3) (ex a b c (pos n)) -> Bad k (sub s0 s1 s2 t) (ex a b c (pos n)) = split {
  inl h -> inl h ; inr h -> inr (out-swap3 s0 s1 s2 s3 t a b c n h) } ;

-- elimination of an exponent by its first coordinate >= 0
module Signs (Phi : E4 -> U l)
  (f0 : (n : Base.Nat) (b c d : Int) -> Phi (ex (pos n) b c d))
  (f1 : (n0 n : Base.Nat) (c d : Int) -> Phi (ex (negsuc n0) (pos n) c d))
  (f2 : (n0 n1 n : Base.Nat) (d : Int) -> Phi (ex (negsuc n0) (negsuc n1) (pos n) d))
  (f3 : (n0 n1 n2 n : Base.Nat) -> Phi (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)))
  (fn : (n0 n1 n2 n3 : Base.Nat) -> Phi (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) {
  at3 (n0 n1 n2 : Base.Nat) : (d : Int) -> Phi (ex (negsuc n0) (negsuc n1) (negsuc n2) d) = split {
    pos n -> f3 n0 n1 n2 n ; negsuc n3 -> fn n0 n1 n2 n3 } ;
  at2 (n0 n1 : Base.Nat) (d : Int) : (c : Int) -> Phi (ex (negsuc n0) (negsuc n1) c d) = split {
    pos n -> f2 n0 n1 n d ; negsuc n2 -> at3 n0 n1 n2 d } ;
  at1 (n0 : Base.Nat) (c d : Int) : (b : Int) -> Phi (ex (negsuc n0) b c d) = split {
    pos n -> f1 n0 n c d ; negsuc n1 -> at2 n0 n1 d c } ;
  at0 (b c d : Int) : (a : Int) -> Phi (ex a b c d) = split {
    pos n -> f0 n b c d ; negsuc n0 -> at1 n0 c d b } ;
  elim : (m : E4) -> Phi m = split { ex a b c d -> at0 b c d a } ;
} ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ;
  module LO = C.LO ; module DL = C.DL ;

  -- g j at the selected vertex j of m, x if every exponent is negative
  sel (g : Pt -> D.R) (x : D.R) : E4 -> D.R =
    Signs[\ m -> D.R, \ n b c d -> g p0, \ n0 n c d -> g p1, \ n0 n1 n d -> g p2, \ n0 n1 n2 n -> g p3,
          \ n0 n1 n2 n3 -> x].elim ;

  ------------------------------------------------------------------------
  -- the sixteen shapes

  -- (x - z) + y = (x + y) - z
  sub-add-comm (x z y : D.R) : Id D.R (D.add (DL.msub x z) y) (DL.msub (D.add x y) z) =
    calc D.R { D.add (DL.msub x z) y =< sym (D.addA x (D.neg z) y) > D.add x (D.add (D.neg z) y)
                 =< ap (D.add x) (D.addC (D.neg z) y) > D.add x (D.add y (D.neg z))
                 =< D.addA x y (D.neg z) > DL.msub (D.add x y) z } ;
  -- a + -(a - w) = w
  add-neg-sub (a w : D.R) : Id D.R (D.add a (D.neg (DL.msub a w))) w =
    trans (ap (D.add a) (C.neg-sub a w)) (C.add-sub-cancel a w) ;
  -- 0 - 0 = 0
  zz : Id D.R (DL.msub D.z D.z) D.z = D.addN D.z ;
  -- (0 - 0) + x = x
  zz-add (x : D.R) : Id D.R (D.add (DL.msub D.z D.z) x) x = trans (ap (\ t -> D.add t x) zz) (DL.G.zl x) ;

  H1 (x : D.R) : Id D.R (D.add (DL.msub x D.z) D.z) x = trans (D.addZ (DL.msub x D.z)) (C.sub-zero-r x) ;
  H2 (x y z : D.R) : Id D.R (D.add (DL.msub x y) (D.add (DL.msub z x) y)) z =
    trans (ap (D.add (DL.msub x y)) (C.sub-add z x y)) (C.add-sub-cancel (DL.msub x y) z) ;
  H3 (x : D.R) : Id D.R (D.add (DL.msub D.z (D.neg x)) D.z) x =
    trans (D.addZ (DL.msub D.z (D.neg x))) (C.zero-sub-neg x) ;
  H4 (x y z : D.R) : Id D.R (D.add (DL.msub x (D.neg y)) (D.neg (D.add (DL.msub x z) y))) z =
    trans (ap (D.add (DL.msub x (D.neg y)))
             (trans (ap D.neg (sub-add-comm x z y))
               (trans (C.neg-sub (D.add x y) z) (ap (DL.msub z) (sym (C.sub-neg x y))))))
          (C.add-sub-cancel (DL.msub x (D.neg y)) z) ;
  H5 (x y z : D.R) : Id D.R (D.add (DL.msub (D.neg x) (D.neg y)) (D.add (DL.msub x y) z)) z =
    trans (ap (\ t -> D.add t (D.add (DL.msub x y) z)) (sym (DL.G.neg-add x (D.neg y))))
          (C.neg-add-cancel (DL.msub x y) z) ;
  H6 (x : D.R) : Id D.R (D.add (D.add (DL.msub x D.z) D.z) D.z) x = trans (D.addZ _) (H1 x) ;
  H7 (x y z w : D.R) : Id D.R (D.add (D.add (DL.msub x y) z) (DL.msub (D.add (DL.msub w x) y) z)) w =
    trans (ap (D.add (D.add (DL.msub x y) z))
             (trans (ap (\ t -> DL.msub t z) (C.sub-add w x y)) (DL.sub-sub w (DL.msub x y) z)))
          (C.add-sub-cancel (D.add (DL.msub x y) z) w) ;
  H8 (x : D.R) : Id D.R (D.add (D.add (DL.msub D.z (D.neg x)) D.z) D.z) x = trans (D.addZ _) (H3 x) ;
  -- ((x - w) + y) - z = (((x - -y) + -z) - w)
  H9-step (x y z w : D.R) :
    Id D.R (DL.msub (D.add (DL.msub x w) y) z) (DL.msub (D.add (DL.msub x (D.neg y)) (D.neg z)) w) =
    calc D.R { DL.msub (D.add (DL.msub x w) y) z
                 =< ap (\ t -> DL.msub t z) (sub-add-comm x w y) > DL.msub (DL.msub (D.add x y) w) z
                 =< DL.sub-comm (D.add x y) w z > DL.msub (DL.msub (D.add x y) z) w
                 =< ap (\ t -> DL.msub (DL.msub t z) w) (sym (C.sub-neg x y)) > DL.msub (DL.msub (DL.msub x (D.neg y)) z) w } ;
  H9 (x y z w : D.R) :
    Id D.R (D.add (D.add (DL.msub x (D.neg y)) (D.neg z)) (D.neg (DL.msub (D.add (DL.msub x w) y) z))) w =
    trans (ap (\ t -> D.add (D.add (DL.msub x (D.neg y)) (D.neg z)) (D.neg t)) (H9-step x y z w))
          (add-neg-sub (D.add (DL.msub x (D.neg y)) (D.neg z)) w) ;
  H10 (x : D.R) : Id D.R (D.add (D.add (DL.msub D.z D.z) x) D.z) x = trans (D.addZ _) (zz-add x) ;
  -- ((u + w) - z) = w - (-u + z)
  H11-step (u w z : D.R) : Id D.R (DL.msub (D.add u w) z) (DL.msub w (D.add (D.neg u) z)) =
    calc D.R { DL.msub (D.add u w) z =< ap (\ t -> DL.msub t z) (D.addC u w) > DL.msub (D.add w u) z
                 =< sym (D.addA w u (D.neg z)) > D.add w (D.add u (D.neg z))
                 =< ap (\ t -> D.add w (D.add t (D.neg z))) (sym (DL.G.neg-neg u)) > D.add w (D.add (D.neg (D.neg u)) (D.neg z))
                 =< ap (D.add w) (sym (DL.G.neg-add (D.neg u) z)) > DL.msub w (D.add (D.neg u) z) } ;
  H11 (x y z w : D.R) :
    Id D.R (D.add (D.add (DL.msub (D.neg x) (D.neg y)) z) (DL.msub (D.add (DL.msub x y) w) z)) w =
    trans (ap (\ t -> D.add (D.add t z) (DL.msub (D.add (DL.msub x y) w) z)) (sym (DL.G.neg-add x (D.neg y))))
      (trans (ap (D.add (D.add (D.neg (DL.msub x y)) z)) (H11-step (DL.msub x y) w z))
             (C.add-sub-cancel (D.add (D.neg (DL.msub x y)) z) w)) ;
  H12 (x y z w : D.R) : Id D.R (D.add (D.add (DL.msub x y) z) (D.neg (DL.msub (D.add (DL.msub x y) z) w))) w =
    add-neg-sub (D.add (DL.msub x y) z) w ;
  H13 (x : D.R) : Id D.R (DL.msub (D.add (DL.msub x D.z) D.z) D.z) x = trans (C.sub-zero-r _) (H1 x) ;
  H14 (x : D.R) : Id D.R (DL.msub (D.add (DL.msub D.z (D.neg x)) D.z) D.z) x = trans (C.sub-zero-r _) (H3 x) ;
  H15 (x : D.R) : Id D.R (DL.msub (D.add (DL.msub D.z D.z) x) D.z) x = trans (C.sub-zero-r _) (zz-add x) ;
  H16 (x : D.R) : Id D.R (DL.msub (D.add (DL.msub D.z D.z) D.z) (D.neg x)) x =
    trans (ap (\ t -> DL.msub t (D.neg x)) (zz-add D.z)) (C.zero-sub-neg x) ;

  -- where every exponent is negative
  allneg1 (x : D.R) (hx : Id D.R x D.z) : Id D.R (D.add (DL.msub D.z D.z) D.z) x = trans (zz-add D.z) (sym hx) ;
  allneg2 (x : D.R) (hx : Id D.R x D.z) : Id D.R (D.add (D.add (DL.msub D.z D.z) D.z) D.z) x =
    trans (D.addZ _) (allneg1 x hx) ;
  allneg3 (x : D.R) : Id D.R (D.add (DL.msub (D.add (DL.msub D.z D.z) D.z) D.z) x) x =
    trans (ap (\ t -> D.add t x) (trans (C.sub-zero-r (D.add (DL.msub D.z D.z) D.z)) (zz-add D.z))) (DL.G.zl x) ;

  ------------------------------------------------------------------------
  -- cones and the selected contraction

  cone1 (c : Ed -> E4 -> D.R) : Pt -> Pt -> E4 -> D.R = split {
    p0 -> split {
      p0 -> \ m -> D.z ;
      p1 -> \ m -> c e01 m ;
      p2 -> \ m -> c e02 m ;
      p3 -> \ m -> c e03 m } ;
    p1 -> split {
      p0 -> \ m -> D.neg (c e01 m) ;
      p1 -> \ m -> D.z ;
      p2 -> \ m -> c e12 m ;
      p3 -> \ m -> c e13 m } ;
    p2 -> split {
      p0 -> \ m -> D.neg (c e02 m) ;
      p1 -> \ m -> D.neg (c e12 m) ;
      p2 -> \ m -> D.z ;
      p3 -> \ m -> c e23 m } ;
    p3 -> split {
      p0 -> \ m -> D.neg (c e03 m) ;
      p1 -> \ m -> D.neg (c e13 m) ;
      p2 -> \ m -> D.neg (c e23 m) ;
      p3 -> \ m -> D.z } } ;
  cone2 (c : Tri -> E4 -> D.R) : Pt -> Ed -> E4 -> D.R = split {
    p0 -> split {
      e01 -> \ m -> D.z ;
      e02 -> \ m -> D.z ;
      e03 -> \ m -> D.z ;
      e12 -> \ m -> c t012 m ;
      e13 -> \ m -> c t013 m ;
      e23 -> \ m -> c t023 m } ;
    p1 -> split {
      e01 -> \ m -> D.z ;
      e02 -> \ m -> D.neg (c t012 m) ;
      e03 -> \ m -> D.neg (c t013 m) ;
      e12 -> \ m -> D.z ;
      e13 -> \ m -> D.z ;
      e23 -> \ m -> c t123 m } ;
    p2 -> split {
      e01 -> \ m -> c t012 m ;
      e02 -> \ m -> D.z ;
      e03 -> \ m -> D.neg (c t023 m) ;
      e12 -> \ m -> D.z ;
      e13 -> \ m -> D.neg (c t123 m) ;
      e23 -> \ m -> D.z } ;
    p3 -> split {
      e01 -> \ m -> c t013 m ;
      e02 -> \ m -> c t023 m ;
      e03 -> \ m -> D.z ;
      e12 -> \ m -> c t123 m ;
      e13 -> \ m -> D.z ;
      e23 -> \ m -> D.z } } ;
  cone3 (c : Sq -> E4 -> D.R) : Pt -> Tri -> E4 -> D.R = split {
    p0 -> split {
      t012 -> \ m -> D.z ;
      t013 -> \ m -> D.z ;
      t023 -> \ m -> D.z ;
      t123 -> \ m -> c s0123 m } ;
    p1 -> split {
      t012 -> \ m -> D.z ;
      t013 -> \ m -> D.z ;
      t023 -> \ m -> D.neg (c s0123 m) ;
      t123 -> \ m -> D.z } ;
    p2 -> split {
      t012 -> \ m -> D.z ;
      t013 -> \ m -> c s0123 m ;
      t023 -> \ m -> D.z ;
      t123 -> \ m -> D.z } ;
    p3 -> split {
      t012 -> \ m -> D.neg (c s0123 m) ;
      t013 -> \ m -> D.z ;
      t023 -> \ m -> D.z ;
      t123 -> \ m -> D.z } } ;

  h1 (c : Ed -> E4 -> D.R) : Pt -> E4 -> D.R = \ i m -> sel (\ j -> cone1 c j i m) D.z m ;
  h2 (c : Tri -> E4 -> D.R) : Ed -> E4 -> D.R = \ i m -> sel (\ j -> cone2 c j i m) D.z m ;
  h3 (c : Sq -> E4 -> D.R) : Tri -> E4 -> D.R = \ i m -> sel (\ j -> cone3 c j i m) D.z m ;
  pi (c : Sq -> E4 -> D.R) : Sq -> E4 -> D.R = \ i m -> sel (\ j -> D.z) (c i m) m ;

  ------------------------------------------------------------------------
  -- the cone identities for a fixed vertex j (all exponents, no condition)

  htpy1 (c : Ed -> E4 -> D.R) : (j : Pt) (E : Ed) (m : E4) ->
    Id D.R (D.add (C.d0 (cone1 c j) E m) (cone2 (C.d1 c) j E m)) (c E m) = split {
    p0 -> split {
      e01 -> \ m -> H1 (c e01 m) ;
      e02 -> \ m -> H1 (c e02 m) ;
      e03 -> \ m -> H1 (c e03 m) ;
      e12 -> \ m -> H2 (c e02 m) (c e01 m) (c e12 m) ;
      e13 -> \ m -> H2 (c e03 m) (c e01 m) (c e13 m) ;
      e23 -> \ m -> H2 (c e03 m) (c e02 m) (c e23 m) } ;
    p1 -> split {
      e01 -> \ m -> H3 (c e01 m) ;
      e02 -> \ m -> H4 (c e12 m) (c e01 m) (c e02 m) ;
      e03 -> \ m -> H4 (c e13 m) (c e01 m) (c e03 m) ;
      e12 -> \ m -> H1 (c e12 m) ;
      e13 -> \ m -> H1 (c e13 m) ;
      e23 -> \ m -> H2 (c e13 m) (c e12 m) (c e23 m) } ;
    p2 -> split {
      e01 -> \ m -> H5 (c e12 m) (c e02 m) (c e01 m) ;
      e02 -> \ m -> H3 (c e02 m) ;
      e03 -> \ m -> H4 (c e23 m) (c e02 m) (c e03 m) ;
      e12 -> \ m -> H3 (c e12 m) ;
      e13 -> \ m -> H4 (c e23 m) (c e12 m) (c e13 m) ;
      e23 -> \ m -> H1 (c e23 m) } ;
    p3 -> split {
      e01 -> \ m -> H5 (c e13 m) (c e03 m) (c e01 m) ;
      e02 -> \ m -> H5 (c e23 m) (c e03 m) (c e02 m) ;
      e03 -> \ m -> H3 (c e03 m) ;
      e12 -> \ m -> H5 (c e23 m) (c e13 m) (c e12 m) ;
      e13 -> \ m -> H3 (c e13 m) ;
      e23 -> \ m -> H3 (c e23 m) } } ;

  htpy2 (c : Tri -> E4 -> D.R) : (j : Pt) (E : Tri) (m : E4) ->
    Id D.R (D.add (C.d1 (cone2 c j) E m) (cone3 (C.d2 c) j E m)) (c E m) = split {
    p0 -> split {
      t012 -> \ m -> H6 (c t012 m) ;
      t013 -> \ m -> H6 (c t013 m) ;
      t023 -> \ m -> H6 (c t023 m) ;
      t123 -> \ m -> H7 (c t023 m) (c t013 m) (c t012 m) (c t123 m) } ;
    p1 -> split {
      t012 -> \ m -> H8 (c t012 m) ;
      t013 -> \ m -> H8 (c t013 m) ;
      t023 -> \ m -> H9 (c t123 m) (c t013 m) (c t012 m) (c t023 m) ;
      t123 -> \ m -> H6 (c t123 m) } ;
    p2 -> split {
      t012 -> \ m -> H10 (c t012 m) ;
      t013 -> \ m -> H11 (c t123 m) (c t023 m) (c t012 m) (c t013 m) ;
      t023 -> \ m -> H8 (c t023 m) ;
      t123 -> \ m -> H8 (c t123 m) } ;
    p3 -> split {
      t012 -> \ m -> H12 (c t123 m) (c t023 m) (c t013 m) (c t012 m) ;
      t013 -> \ m -> H10 (c t013 m) ;
      t023 -> \ m -> H10 (c t023 m) ;
      t123 -> \ m -> H10 (c t123 m) } } ;

  -- d (cone_j w) = w on the top component
  top3 (c : Sq -> E4 -> D.R) : (j : Pt) (m : E4) ->
    Id D.R (D.add (C.d2 (cone3 c j) s0123 m) D.z) (c s0123 m) = split {
    p0 -> \ m -> trans (D.addZ _) (H13 (c s0123 m)) ;
    p1 -> \ m -> trans (D.addZ _) (H14 (c s0123 m)) ;
    p2 -> \ m -> trans (D.addZ _) (H15 (c s0123 m)) ;
    p3 -> \ m -> trans (D.addZ _) (H16 (c s0123 m)) } ;

  ------------------------------------------------------------------------
  -- the selected contraction: d h c + h d c = c (q = 1, 2), d h w + pi w = w

  htpy1-sel (k : Int) (c : Ed -> E4 -> D.R) (v : C.Deg[k].C1.Van c) : (E : Ed) (m : E4) ->
    Id D.R (D.add (C.d0 (h1 c) E m) (h2 (C.d1 c) E m)) (c E m) = split {
    e01 -> Signs[\ m -> Id D.R (D.add (C.d0 (h1 c) e01 m) (h2 (C.d1 c) e01 m)) (c e01 m),
        \ n x1 x2 x3 -> htpy1 c p0 e01 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy1 c p1 e01 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy1 c p2 e01 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy1 c p3 e01 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg1 (c e01 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v e01 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o2 tt)))].elim ;
    e02 -> Signs[\ m -> Id D.R (D.add (C.d0 (h1 c) e02 m) (h2 (C.d1 c) e02 m)) (c e02 m),
        \ n x1 x2 x3 -> htpy1 c p0 e02 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy1 c p1 e02 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy1 c p2 e02 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy1 c p3 e02 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg1 (c e02 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v e02 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o1 tt)))].elim ;
    e03 -> Signs[\ m -> Id D.R (D.add (C.d0 (h1 c) e03 m) (h2 (C.d1 c) e03 m)) (c e03 m),
        \ n x1 x2 x3 -> htpy1 c p0 e03 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy1 c p1 e03 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy1 c p2 e03 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy1 c p3 e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg1 (c e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o1 tt)))].elim ;
    e12 -> Signs[\ m -> Id D.R (D.add (C.d0 (h1 c) e12 m) (h2 (C.d1 c) e12 m)) (c e12 m),
        \ n x1 x2 x3 -> htpy1 c p0 e12 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy1 c p1 e12 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy1 c p2 e12 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy1 c p3 e12 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg1 (c e12 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v e12 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o0 tt)))].elim ;
    e13 -> Signs[\ m -> Id D.R (D.add (C.d0 (h1 c) e13 m) (h2 (C.d1 c) e13 m)) (c e13 m),
        \ n x1 x2 x3 -> htpy1 c p0 e13 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy1 c p1 e13 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy1 c p2 e13 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy1 c p3 e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg1 (c e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o0 tt)))].elim ;
    e23 -> Signs[\ m -> Id D.R (D.add (C.d0 (h1 c) e23 m) (h2 (C.d1 c) e23 m)) (c e23 m),
        \ n x1 x2 x3 -> htpy1 c p0 e23 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy1 c p1 e23 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy1 c p2 e23 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy1 c p3 e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg1 (c e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o0 tt)))].elim } ;

  htpy2-sel (k : Int) (c : Tri -> E4 -> D.R) (v : C.Deg[k].C2.Van c) : (E : Tri) (m : E4) ->
    Id D.R (D.add (C.d1 (h2 c) E m) (h3 (C.d2 c) E m)) (c E m) = split {
    t012 -> Signs[\ m -> Id D.R (D.add (C.d1 (h2 c) t012 m) (h3 (C.d2 c) t012 m)) (c t012 m),
        \ n x1 x2 x3 -> htpy2 c p0 t012 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy2 c p1 t012 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy2 c p2 t012 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy2 c p3 t012 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg2 (c t012 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v t012 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o3 tt)))].elim ;
    t013 -> Signs[\ m -> Id D.R (D.add (C.d1 (h2 c) t013 m) (h3 (C.d2 c) t013 m)) (c t013 m),
        \ n x1 x2 x3 -> htpy2 c p0 t013 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy2 c p1 t013 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy2 c p2 t013 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy2 c p3 t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg2 (c t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o2 tt)))].elim ;
    t023 -> Signs[\ m -> Id D.R (D.add (C.d1 (h2 c) t023 m) (h3 (C.d2 c) t023 m)) (c t023 m),
        \ n x1 x2 x3 -> htpy2 c p0 t023 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy2 c p1 t023 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy2 c p2 t023 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy2 c p3 t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg2 (c t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o1 tt)))].elim ;
    t123 -> Signs[\ m -> Id D.R (D.add (C.d1 (h2 c) t123 m) (h3 (C.d2 c) t123 m)) (c t123 m),
        \ n x1 x2 x3 -> htpy2 c p0 t123 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> htpy2 c p1 t123 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> htpy2 c p2 t123 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> htpy2 c p3 t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg2 (c t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (v t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o0 tt)))].elim } ;

  top3-sel (k : Int) (c : Sq -> E4 -> D.R) : (E : Sq) (m : E4) ->
    Id D.R (D.add (C.d2 (h3 c) E m) (pi c E m)) (c E m) = split {
    s0123 -> Signs[\ m -> Id D.R (D.add (C.d2 (h3 c) s0123 m) (pi c s0123 m)) (c s0123 m),
        \ n x1 x2 x3 -> top3 c p0 (ex (pos n) x1 x2 x3),
        \ n0 n x2 x3 -> top3 c p1 (ex (negsuc n0) (pos n) x2 x3),
        \ n0 n1 n x3 -> top3 c p2 (ex (negsuc n0) (negsuc n1) (pos n) x3),
        \ n0 n1 n2 n -> top3 c p3 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)),
        \ n0 n1 n2 n3 -> allneg3 (c s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)))].elim } ;

  ------------------------------------------------------------------------
  -- the chart conditions and finite support of h c: at the selected vertex j
  -- (exponent >= 0), Bad at E gives Bad at E + j (bad-swap), and the value
  -- is +- c_(E+j) or 0; where every exponent is negative h c is 0

  van-h1 (k : Int) (c : Ed -> E4 -> D.R) (v : C.Deg[k].C1.Van c) : C.Deg[k].C0.Van (h1 c) = split {
    p0 -> Signs[\ m -> BadI Pt setPt k p0 m -> Id D.R (h1 c p0 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> LO.zero-neg (c e01 (ex (negsuc n0) (pos n) x2 x3)) (v e01 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k inside outside outside outside inside (negsuc n0) n x2 x3 b)),
        \ n0 n1 n x3 -> \ b -> LO.zero-neg (c e02 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (v e02 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k inside outside outside outside inside (negsuc n0) (negsuc n1) n x3 b)),
        \ n0 n1 n2 n -> \ b -> LO.zero-neg (c e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (v e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k inside outside outside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b)),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    p1 -> Signs[\ m -> BadI Pt setPt k p1 m -> Id D.R (h1 c p1 m) D.z,
        \ n x1 x2 x3 -> \ b -> v e01 (ex (pos n) x1 x2 x3) (bad-swap0 k outside inside outside outside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> LO.zero-neg (c e12 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (v e12 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k outside inside outside outside inside (negsuc n0) (negsuc n1) n x3 b)),
        \ n0 n1 n2 n -> \ b -> LO.zero-neg (c e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (v e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k outside inside outside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b)),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    p2 -> Signs[\ m -> BadI Pt setPt k p2 m -> Id D.R (h1 c p2 m) D.z,
        \ n x1 x2 x3 -> \ b -> v e02 (ex (pos n) x1 x2 x3) (bad-swap0 k outside outside inside outside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> v e12 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k outside outside inside outside inside (negsuc n0) n x2 x3 b),
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> LO.zero-neg (c e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (v e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k outside outside inside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b)),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    p3 -> Signs[\ m -> BadI Pt setPt k p3 m -> Id D.R (h1 c p3 m) D.z,
        \ n x1 x2 x3 -> \ b -> v e03 (ex (pos n) x1 x2 x3) (bad-swap0 k outside outside outside inside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> v e13 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k outside outside outside inside inside (negsuc n0) n x2 x3 b),
        \ n0 n1 n x3 -> \ b -> v e23 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k outside outside outside inside inside (negsuc n0) (negsuc n1) n x3 b),
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim } ;

  van-h2 (k : Int) (c : Tri -> E4 -> D.R) (v : C.Deg[k].C2.Van c) : C.Deg[k].C1.Van (h2 c) = split {
    e01 -> Signs[\ m -> BadI Ed setEd k e01 m -> Id D.R (h2 c e01 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> v t012 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k inside inside outside outside inside (negsuc n0) (negsuc n1) n x3 b),
        \ n0 n1 n2 n -> \ b -> v t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k inside inside outside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    e02 -> Signs[\ m -> BadI Ed setEd k e02 m -> Id D.R (h2 c e02 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> LO.zero-neg (c t012 (ex (negsuc n0) (pos n) x2 x3)) (v t012 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k inside outside inside outside inside (negsuc n0) n x2 x3 b)),
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> v t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k inside outside inside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    e03 -> Signs[\ m -> BadI Ed setEd k e03 m -> Id D.R (h2 c e03 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> LO.zero-neg (c t013 (ex (negsuc n0) (pos n) x2 x3)) (v t013 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k inside outside outside inside inside (negsuc n0) n x2 x3 b)),
        \ n0 n1 n x3 -> \ b -> LO.zero-neg (c t023 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (v t023 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k inside outside outside inside inside (negsuc n0) (negsuc n1) n x3 b)),
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    e12 -> Signs[\ m -> BadI Ed setEd k e12 m -> Id D.R (h2 c e12 m) D.z,
        \ n x1 x2 x3 -> \ b -> v t012 (ex (pos n) x1 x2 x3) (bad-swap0 k outside inside inside outside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> v t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k outside inside inside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    e13 -> Signs[\ m -> BadI Ed setEd k e13 m -> Id D.R (h2 c e13 m) D.z,
        \ n x1 x2 x3 -> \ b -> v t013 (ex (pos n) x1 x2 x3) (bad-swap0 k outside inside outside inside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> LO.zero-neg (c t123 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (v t123 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k outside inside outside inside inside (negsuc n0) (negsuc n1) n x3 b)),
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    e23 -> Signs[\ m -> BadI Ed setEd k e23 m -> Id D.R (h2 c e23 m) D.z,
        \ n x1 x2 x3 -> \ b -> v t023 (ex (pos n) x1 x2 x3) (bad-swap0 k outside outside inside inside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> v t123 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k outside outside inside inside inside (negsuc n0) n x2 x3 b),
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim } ;

  van-h3 (k : Int) (c : Sq -> E4 -> D.R) (v : C.Deg[k].C3.Van c) : C.Deg[k].C2.Van (h3 c) = split {
    t012 -> Signs[\ m -> BadI Tri setTri k t012 m -> Id D.R (h3 c t012 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> LO.zero-neg (c s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (v s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) (bad-swap3 k inside inside inside outside inside (negsuc n0) (negsuc n1) (negsuc n2) n b)),
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    t013 -> Signs[\ m -> BadI Tri setTri k t013 m -> Id D.R (h3 c t013 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> v s0123 (ex (negsuc n0) (negsuc n1) (pos n) x3) (bad-swap2 k inside inside outside inside inside (negsuc n0) (negsuc n1) n x3 b),
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    t023 -> Signs[\ m -> BadI Tri setTri k t023 m -> Id D.R (h3 c t023 m) D.z,
        \ n x1 x2 x3 -> \ b -> refl D.z,
        \ n0 n x2 x3 -> \ b -> LO.zero-neg (c s0123 (ex (negsuc n0) (pos n) x2 x3)) (v s0123 (ex (negsuc n0) (pos n) x2 x3) (bad-swap1 k inside outside inside inside inside (negsuc n0) n x2 x3 b)),
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim ;
    t123 -> Signs[\ m -> BadI Tri setTri k t123 m -> Id D.R (h3 c t123 m) D.z,
        \ n x1 x2 x3 -> \ b -> v s0123 (ex (pos n) x1 x2 x3) (bad-swap0 k outside inside inside inside inside n x1 x2 x3 b),
        \ n0 n x2 x3 -> \ b -> refl D.z,
        \ n0 n1 n x3 -> \ b -> refl D.z,
        \ n0 n1 n2 n -> \ b -> refl D.z,
        \ n0 n1 n2 n3 -> \ b -> refl D.z].elim } ;

  vanish-h1 (k : Int) (s : List E4) (c : Ed -> E4 -> D.R) (w : C.Deg[k].C1.Vanish s c) : C.Deg[k].C0.Vanish s (h1 c) = split {
    p0 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h1 c p0 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> LO.zero-neg (c e01 (ex (negsuc n0) (pos n) x2 x3)) (w e01 (ex (negsuc n0) (pos n) x2 x3) nm),
        \ n0 n1 n x3 -> \ nm -> LO.zero-neg (c e02 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (w e02 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm),
        \ n0 n1 n2 n -> \ nm -> LO.zero-neg (c e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (w e03 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm),
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    p1 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h1 c p1 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w e01 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> LO.zero-neg (c e12 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (w e12 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm),
        \ n0 n1 n2 n -> \ nm -> LO.zero-neg (c e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (w e13 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm),
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    p2 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h1 c p2 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w e02 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> w e12 (ex (negsuc n0) (pos n) x2 x3) nm,
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> LO.zero-neg (c e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (w e23 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm),
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    p3 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h1 c p3 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w e03 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> w e13 (ex (negsuc n0) (pos n) x2 x3) nm,
        \ n0 n1 n x3 -> \ nm -> w e23 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm,
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim } ;

  vanish-h2 (k : Int) (s : List E4) (c : Tri -> E4 -> D.R) (w : C.Deg[k].C2.Vanish s c) : C.Deg[k].C1.Vanish s (h2 c) = split {
    e01 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h2 c e01 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> w t012 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm,
        \ n0 n1 n2 n -> \ nm -> w t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    e02 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h2 c e02 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> LO.zero-neg (c t012 (ex (negsuc n0) (pos n) x2 x3)) (w t012 (ex (negsuc n0) (pos n) x2 x3) nm),
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> w t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    e03 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h2 c e03 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> LO.zero-neg (c t013 (ex (negsuc n0) (pos n) x2 x3)) (w t013 (ex (negsuc n0) (pos n) x2 x3) nm),
        \ n0 n1 n x3 -> \ nm -> LO.zero-neg (c t023 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (w t023 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm),
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    e12 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h2 c e12 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w t012 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> w t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    e13 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h2 c e13 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w t013 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> LO.zero-neg (c t123 (ex (negsuc n0) (negsuc n1) (pos n) x3)) (w t123 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm),
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    e23 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h2 c e23 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w t023 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> w t123 (ex (negsuc n0) (pos n) x2 x3) nm,
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim } ;

  vanish-h3 (k : Int) (s : List E4) (c : Sq -> E4 -> D.R) (w : C.Deg[k].C3.Vanish s c) : C.Deg[k].C2.Vanish s (h3 c) = split {
    t012 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h3 c t012 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> LO.zero-neg (c s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n))) (w s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (pos n)) nm),
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    t013 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h3 c t013 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> w s0123 (ex (negsuc n0) (negsuc n1) (pos n) x3) nm,
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    t023 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h3 c t023 m) D.z,
        \ n x1 x2 x3 -> \ nm -> refl D.z,
        \ n0 n x2 x3 -> \ nm -> LO.zero-neg (c s0123 (ex (negsuc n0) (pos n) x2 x3)) (w s0123 (ex (negsuc n0) (pos n) x2 x3) nm),
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim ;
    t123 -> Signs[\ m -> Not (Mem m s) -> Id D.R (h3 c t123 m) D.z,
        \ n x1 x2 x3 -> \ nm -> w s0123 (ex (pos n) x1 x2 x3) nm,
        \ n0 n x2 x3 -> \ nm -> refl D.z,
        \ n0 n1 n x3 -> \ nm -> refl D.z,
        \ n0 n1 n2 n -> \ nm -> refl D.z,
        \ n0 n1 n2 n3 -> \ nm -> refl D.z].elim } ;

  -- pi: finite support and chart conditions
  van-pi (k : Int) (c : Sq -> E4 -> D.R) (v : C.Deg[k].C3.Van c) : C.Deg[k].C3.Van (pi c) = split {
    s0123 -> Signs[\ m -> BadI Sq setSq k s0123 m -> Id D.R (pi c s0123 m) D.z,
      \ n x1 x2 x3 -> \ b -> refl D.z, \ n0 n x2 x3 -> \ b -> refl D.z,
      \ n0 n1 n x3 -> \ b -> refl D.z, \ n0 n1 n2 n -> \ b -> refl D.z,
      \ n0 n1 n2 n3 -> \ b -> v s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) b].elim } ;
  vanish-pi (k : Int) (s : List E4) (c : Sq -> E4 -> D.R) (w : C.Deg[k].C3.Vanish s c) : C.Deg[k].C3.Vanish s (pi c) = split {
    s0123 -> Signs[\ m -> Not (Mem m s) -> Id D.R (pi c s0123 m) D.z,
      \ n x1 x2 x3 -> \ nm -> refl D.z, \ n0 n x2 x3 -> \ nm -> refl D.z,
      \ n0 n1 n x3 -> \ nm -> refl D.z, \ n0 n1 n2 n -> \ nm -> refl D.z,
      \ n0 n1 n2 n3 -> \ nm -> w s0123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) nm].elim } ;

  ------------------------------------------------------------------------
  -- the contractions on the chart modules

  module Contr (k : Int) {
    module G = C.Deg[k] ;

    -- an operation preserving the vanishing lists keeps finite support
    keep (I J : U l) (BI : I -> E4 -> U l) (BJ : J -> E4 -> U l) (F : (I -> E4 -> D.R) -> J -> E4 -> D.R)
      (fv : (s : List E4) (c : I -> E4 -> D.R) -> LO.Chart[I,BI].Vanish s c -> LO.Chart[J,BJ].Vanish s (F c))
      (c : I -> E4 -> D.R) (sc : LO.Chart[I,BI].Supp c) : LO.Chart[J,BJ].Supp (F c) =
      TC.map (LO.Chart[I,BI].SuppW c) (LO.Chart[J,BJ].SuppW (F c)) (\ w -> (w.1, fv w.1 c w.2)) sc ;

    -- (a) pi and (b) sigma on C^3(k)
    piE (w : G.C3.El) : G.C3.El =
      G.C3.mk (pi (G.C3.val w)) (keep Sq Sq (BadI Sq setSq k) (BadI Sq setSq k) pi (vanish-pi k) (G.C3.val w) (G.C3.supp w))
        (van-pi k (G.C3.val w) (G.C3.van w)) ;
    sigma (w : G.C3.El) : G.C2.El =
      G.C2.mk (h3 (G.C3.val w)) (keep Sq Tri (BadI Sq setSq k) (BadI Tri setTri k) h3 (vanish-h3 k) (G.C3.val w) (G.C3.supp w))
        (van-h3 k (G.C3.val w) (G.C3.van w)) ;
    -- d sigma w + pi w = w
    sigma-eq (w : G.C3.El) : Id G.C3.El (G.C3.mod.madd ((C.D2 k).f (sigma w)) (piE w)) w =
      G.C3.eq (G.C3.mod.madd ((C.D2 k).f (sigma w)) (piE w)) w (top3-sel k (G.C3.val w)) ;

    -- pi (d u) = 0 for u in C^2(k): where every exponent is negative, each
    -- component of u vanishes (its chart is not all of {0,1,2,3}); elsewhere
    -- pi is 0
    pid-pt (u : G.C2.El) : (i : Sq) (m : E4) -> Id D.R (pi (C.d2 (G.C2.val u)) i m) D.z = split {
      s0123 -> Signs[\ m -> Id D.R (pi (C.d2 (G.C2.val u)) s0123 m) D.z,
        \ n x1 x2 x3 -> refl D.z, \ n0 n x2 x3 -> refl D.z,
        \ n0 n1 n x3 -> refl D.z, \ n0 n1 n2 n -> refl D.z,
        \ n0 n1 n2 n3 -> C.zero-Q
          (G.C2.val u t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)))
          (G.C2.val u t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)))
          (G.C2.val u t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)))
          (G.C2.val u t012 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)))
          (G.C2.van u t123 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o0 tt)))
          (G.C2.van u t023 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o1 tt)))
          (G.C2.van u t013 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o2 tt)))
          (G.C2.van u t012 (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3)) (inr (o3 tt)))].elim } ;
    pi-d (u : G.C2.El) : Id G.C3.El (piE ((C.D2 k).f u)) G.C3.mod.mz =
      G.C3.eq (piE ((C.D2 k).f u)) G.C3.mod.mz (pid-pt u) ;

    -- the contractions h1 : C^1(k) -> C^0(k) and h2 : C^2(k) -> C^1(k)
    con1 (c : G.C1.El) : G.C0.El =
      G.C0.mk (h1 (G.C1.val c)) (keep Ed Pt (BadI Ed setEd k) (BadI Pt setPt k) h1 (vanish-h1 k) (G.C1.val c) (G.C1.supp c))
        (van-h1 k (G.C1.val c) (G.C1.van c)) ;
    con2 (c : G.C2.El) : G.C1.El =
      G.C1.mk (h2 (G.C2.val c)) (keep Tri Ed (BadI Tri setTri k) (BadI Ed setEd k) h2 (vanish-h2 k) (G.C2.val c) (G.C2.supp c))
        (van-h2 k (G.C2.val c) (G.C2.van c)) ;

    -- x + 0 = y when x + z = y and z = 0
    drop-zero (x z y : D.R) (hz : Id D.R z D.z) (h : Id D.R (D.add x z) y) : Id D.R x y =
      trans (sym (D.addZ x)) (trans (ap (D.add x) (sym hz)) h) ;

    -- (c) a closed c in C^2(k) is d (con2 c)
    con2-eq (c : G.C2.El) (closed : Id G.C3.El ((C.D2 k).f c) G.C3.mod.mz) : Id G.C2.El ((C.D1 k).f (con2 c)) c =
      G.C2.eq ((C.D1 k).f (con2 c)) c (\ E m ->
        drop-zero (C.d1 (h2 (G.C2.val c)) E m) (h3 (C.d2 (G.C2.val c)) E m) (G.C2.val c E m)
          (vanish-h3 k nil (C.d2 (G.C2.val c)) (\ i m' nm -> ap (\ x -> G.C3.val x i m') closed) E m (\ e -> e))
          (htpy2-sel k (G.C2.val c) (G.C2.van c) E m)) ;
    -- (d) a closed c in C^1(k) is d (con1 c)
    con1-eq (c : G.C1.El) (closed : Id G.C2.El ((C.D1 k).f c) G.C2.mod.mz) : Id G.C1.El ((C.D0 k).f (con1 c)) c =
      G.C1.eq ((C.D0 k).f (con1 c)) c (\ E m ->
        drop-zero (C.d0 (h1 (G.C1.val c)) E m) (h2 (C.d1 (G.C1.val c)) E m) (G.C1.val c E m)
          (vanish-h2 k nil (C.d1 (G.C1.val c)) (\ i m' nm -> ap (\ x -> G.C2.val x i m') closed) E m (\ e -> e))
          (htpy1-sel k (G.C1.val c) (G.C1.van c) E m)) ;
  } ;
} ;
