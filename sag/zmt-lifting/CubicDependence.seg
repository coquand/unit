-- CubicDependence.seg: Stage 1 for the cubic certificate relation
-- (handoff §10), D a CFN set-ring.
--
-- Theorem (dependence).  Let b_0, b_1, .. in C^1(-1) be such that every b_n
-- merely has u_n, v_n in C^2(-4) with d b_n = P u_n + Q v_n.  Then merely
-- there are qs = [q_(N-1),..,q_0] (N = len qs) and h in C^0(-1),
-- a_0, a_1 in C^1(-4) with
--     b_N - sum_{i<N} q_i b_i = (d h + P a_0) + Q a_1 .
-- Proof: CubicCertificate.partner gives, for each n, merely a partner
-- p in D^20 with Gam(b_n, p) (raising, one n at a time: no sequence of
-- u_n, v_n, w_n is chosen); CertifiedDependence.certificate for the relation
-- CubicCertificate.rel gives merely qs with B(b_N - sum q_i b_i), and B is
-- itself a truncation, which is flattened (bind).
-- The relation, its closure, the contractions and the zero-reflection are
-- all constructed (CubicCertificate); the only hypotheses are D, its being
-- a set, and CFN.
-- dependence-Z: the instance D = Z (ZCFN.cfn, Z a set by int-set).
level l ; open Ring[l] ; open TopList4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) {
  module CK = CubicCertificate[l].Over[D,setD] ;
  module G1 = CK.G1 ; module ML1 = IP.ModL[D,G1.C1.mod] ;

  module Seq (b : Nat -> G1.C1.El) (lift : (n : Nat) -> Tr.Trunc[CK.Lifted (b n)].carrier) {
    module CD = CertifiedDependence[l].Over[K0,D,cfn,G1.C1.mod,len T20,CK.rel,b,\ n -> CK.partner (b n) (lift n)] ;
    -- b_N - sum_{i<N} q_i b_i, N = len qs
    rest (qs : List D.R) : G1.C1.El = ML1.msub (b (len qs)) (CD.RS.sumL qs) ;
    Result : U l = (qs : List D.R) * CK.Bdry (rest qs) ;
    flat (c : CD.RS.Cert) : Tr.Trunc[Result].carrier =
      TC.map (CK.Bdry (rest c.1)) Result (\ bd -> (c.1, bd)) c.2 ;
    dependence : Tr.Trunc[Result].carrier = TC.bind CD.RS.Cert Result flat CD.certificate ;
  } ;
} ;

-- over Z
module OverZ {
  module Z = Over[Nat * Nat, ZRing[l].ring, ZInt[l].int-set, ZCFN[l].cfn] ;
  dependence-Z (b : Nat -> Z.G1.C1.El) (lift : (n : Nat) -> Tr.Trunc[Z.CK.Lifted (b n)].carrier) :
    Tr.Trunc[Z.Seq[b,lift].Result].carrier = Z.Seq[b,lift].dependence ;
} ;
