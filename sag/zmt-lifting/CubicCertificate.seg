-- CubicCertificate.seg: the certificate relation of the four-chart cubic
-- example J = (P, Q) = (X_0^3, X_1^3), twisted by -1 (handoff §8, §9),
-- over any commutative set-ring D.
--
-- Z = C^1(-1), all chart 1-cochains of degree -1 (not a quotient), and
-- V = D^20 (TopCoordinates4).
--   (E1)  u, v in C^2(-4) with  d b = P u + Q v ;
--   (E2)  w in C^3(-7) with  d u = -Q w  and  d v = P w ;
--   Gam(b,p) := merely u, v, w with (E1), (E2) and top(w) = p ;
--   B(b)     := merely h in C^0(-1), a_0, a_1 in C^1(-4) with
--               b = (d h + P a_0) + Q a_1                       (Bdry).
--
-- Raising (Raise): given (E1), put w = X_0^(-3) (d v) in C^3(-7).  Then
--   P (d u) + Q (d v) = d (P u + Q v) = d d b = 0             (rel)
-- (d commutes with P, Q: Cech4.Comm), and
--   d v = P w                     (P X_0^(-3) = id),
--   P (d u) = -Q (d v) = -Q P w = P (-Q w),  so  d u = -Q w   (X_0^(-3) P = id).
-- So p = top(w) is a finite partner of b (partner); the top syzygy (-Q, P)
-- is supplied by this formula, without a syzygy theorem.
--
-- Closure (gam-zero, gam-add, gam-sm): witnesses add and scale
-- componentwise, d, P, Q and top being linear.
--
-- Zero-reflection (Reflect), proved: let top(w) = 0.  Then pi(w) = 0
-- (TopCoordinates4.pi-zero) and t = sigma(w) in C^2(-7) has d t = w
-- (Cech4Contraction.sigma-eq).  Put  u' = u + Q t,  v' = v - P t  in C^2(-4):
--   d u' = -Q w + Q d t = -Q w + Q w = 0,
--   d v' =  P w - P d t =  P w - P w = 0.
-- Contract (Contr.con2-eq at -4): a_0 = h u', a_1 = h v' with d a_0 = u',
-- d a_1 = v'.  Then c = (b - P a_0) - Q a_1 in C^1(-1) is closed:
--   d c = (P u + Q v) - P u' - Q v'
--       = (P u + Q v) - (P u + P Q t) - (Q v - Q P t) = 0     (P Q = Q P).
-- Contract (Contr.con1-eq at -1): h with d h = c, so b = (d h + P a_0) + Q a_1.
-- The constructed primitive is exported (Reflect.bdry), and the
-- proposition-level implication is reflect.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open TopList4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ; module CC = Cech4Contraction[l].Over[D,setD] ;
  module TP = TopCoordinates4[l].Over[D,setD] ;
  module G1 = C.Deg[mOne] ; module G4 = C.Deg[mFour] ; module G7 = C.Deg[mSeven] ;
  module V = TP.V ;
  -- P = X_0^3 and Q = X_1^3 between the degrees used
  module S1 = C.Shift[Ed,setEd,mFour] ;      -- C^1(-4) -> C^1(-1)
  module S2 = C.Shift[Tri,setTri,mFour] ;    -- C^2(-4) -> C^2(-1)
  module S3 = C.Shift[Sq,setSq,mFour] ;      -- C^3(-4) -> C^3(-1)
  module T2 = C.Shift[Tri,setTri,mSeven] ;   -- C^2(-7) -> C^2(-4)
  module T3 = C.Shift[Sq,setSq,mSeven] ;     -- C^3(-7) -> C^3(-4)
  -- X_0^(-3)
  module Pi4 = C.Pinv[mFour] ;               -- C^3(-4) -> C^3(-7)
  module Pi1 = C.Pinv[mOne] ;                -- C^3(-1) -> C^3(-4)
  -- linear-map lemmas of the maps used
  module RCL = RelationCertificate[l] ;
  module LD1 = RCL.LinL[D,G1.C1.mod,G1.C2.mod,C.D1 mOne] ;
  module LD2 = RCL.LinL[D,G4.C2.mod,G4.C3.mod,C.D2 mFour] ;
  module LS3 = RCL.LinL[D,S3.CA.mod,S3.CB.mod,S3.P] ;
  module LT2 = RCL.LinL[D,T2.CA.mod,T2.CB.mod,T2.P] ;
  module LS2Q = RCL.LinL[D,S2.CA.mod,S2.CB.mod,S2.Q] ;
  module LT3Q = RCL.LinL[D,T3.CA.mod,T3.CB.mod,T3.Q] ;
  module LS2P = RCL.LinL[D,S2.CA.mod,S2.CB.mod,S2.P] ;
  module LT3P = RCL.LinL[D,T3.CA.mod,T3.CB.mod,T3.P] ;
  module LTop = RCL.LinL[D,G7.C3.mod,V.mod,TP.top] ;
  module ML1 = IP.ModL[D,G1.C1.mod] ; module ML2 = IP.ModL[D,G1.C2.mod] ; module ML3 = IP.ModL[D,G1.C3.mod] ;
  module MF2 = IP.ModL[D,G4.C2.mod] ; module MF3 = IP.ModL[D,G4.C3.mod] ; module MS3 = IP.ModL[D,G7.C3.mod] ;

  -- identities of an abelian group (module)
  module Grp (Mm : IP.Mod[D]) {
    module ML = IP.ModL[D,Mm] ; open Mm ;
    -- (y - w) + w = y
    sub-add-back (y w : M) : Id M (madd (ML.msub y w) w) y =
      trans (sym (maddA y (mneg w) w)) (trans (ap (madd y) (trans (maddC (mneg w) w) (maddN w))) (maddZ y)) ;
    -- (((b - x) - y) + x) + y = b
    back (b x y : M) : Id M (madd (madd (ML.msub (ML.msub b x) y) x) y) b =
      calc M { madd (madd (ML.msub (ML.msub b x) y) x) y
                 =< ap (\ t -> madd (madd t x) y) (ML.sub-comm b x y) > madd (madd (ML.msub (ML.msub b y) x) x) y
                 =< ap (\ t -> madd t y) (sub-add-back (ML.msub b y) x) > madd (ML.msub b y) y
                 =< sub-add-back b y > b } ;
    -- ((a + b) - (a + r)) - (b - r) = 0
    cancel-pair (a b r : M) : Id M (ML.msub (ML.msub (madd a b) (madd a r)) (ML.msub b r)) mz =
      calc M { ML.msub (ML.msub (madd a b) (madd a r)) (ML.msub b r)
                 =< ap (\ t -> ML.msub t (ML.msub b r)) (trans (ML.sub-swap a b a r) (trans (ap (\ t -> madd t (ML.msub b r)) (maddN a)) (ML.G.zl (ML.msub b r))))
                 > ML.msub (ML.msub b r) (ML.msub b r)
                 =< maddN (ML.msub b r) > mz } ;
    -- -x + x = 0
    neg-self (x : M) : Id M (madd (mneg x) x) mz = trans (maddC (mneg x) x) (maddN x) ;
    -- x + 0 = w gives x = w
    drop-zero (x z w : M) (hz : Id M z mz) (h : Id M (madd x z) w) : Id M x w =
      trans (sym (maddZ x)) (trans (ap (madd x) (sym hz)) h) ;
  } ;
  module GF3 = Grp[G4.C3.mod] ; module GG1 = Grp[G1.C1.mod] ; module GG2 = Grp[G1.C2.mod] ; module GS3 = Grp[G7.C3.mod] ;

  -- X_0^(-3) inverts P on C^3
  pinv-P (x : G4.C3.El) : Id G4.C3.mod.M (Pi1.lin.f (S3.P.f x)) x =
    G4.C3.eq (Pi1.lin.f (S3.P.f x)) x (\ i m -> ap (G4.C3.val x i) (sh0-up0 m)) ;
  P-pinv (y : G4.C3.El) : Id G4.C3.mod.M (T3.P.f (Pi4.lin.f y)) y =
    G4.C3.eq (T3.P.f (Pi4.lin.f y)) y (\ i m -> ap (G4.C3.val y i) (up0-sh0 m)) ;

  ------------------------------------------------------------------------
  -- the relation

  E1 (b : G1.C1.El) (u v : G4.C2.El) : U l = Id G1.C2.mod.M ((C.D1 mOne).f b) (G1.C2.mod.madd (S2.P.f u) (S2.Q.f v)) ;
  E2u (u : G4.C2.El) (w : G7.C3.El) : U l = Id G4.C3.mod.M ((C.D2 mFour).f u) (G4.C3.mod.mneg (T3.Q.f w)) ;
  E2v (v : G4.C2.El) (w : G7.C3.El) : U l = Id G4.C3.mod.M ((C.D2 mFour).f v) (T3.P.f w) ;
  Witness (b : G1.C1.El) (p : V.Vec) : U l =
    (u : G4.C2.El) * ((v : G4.C2.El) * ((w : G7.C3.El) * (E1 b u v * ((E2u u w * E2v v w) * Id V.Vec (TP.top.f w) p)))) ;
  Gam (b : G1.C1.El) (p : V.Vec) : U l = Tr.Trunc[Witness b p].carrier ;

  Bdry (b : G1.C1.El) : U l = (h : G1.C0.El) * ((a0 : G4.C1.El) * ((a1 : G4.C1.El) *
    Id G1.C1.mod.M b (G1.C1.mod.madd (G1.C1.mod.madd ((C.D0 mOne).f h) (S1.P.f a0)) (S1.Q.f a1)))) ;
  B (b : G1.C1.El) : U l = Tr.Trunc[Bdry b].carrier ;

  -- accessors
  module Wit (b : G1.C1.El) (p : V.Vec) (x : Witness b p) {
    u : G4.C2.El = x.1 ;
    v : G4.C2.El = x.2.1 ;
    w : G7.C3.El = x.2.2.1 ;
    e1 : E1 b u v = x.2.2.2.1 ;
    eu : E2u u w = x.2.2.2.2.1.1 ;
    ev : E2v v w = x.2.2.2.2.1.2 ;
    etop : Id V.Vec (TP.top.f w) p = x.2.2.2.2.2 ;
  } ;
  mkWit (b : G1.C1.El) (p : V.Vec) (u v : G4.C2.El) (w : G7.C3.El) (e1 : E1 b u v) (eu : E2u u w) (ev : E2v v w)
    (et : Id V.Vec (TP.top.f w) p) : Witness b p = (u, (v, (w, (e1, ((eu, ev), et))))) ;

  ------------------------------------------------------------------------
  -- raising: a finite partner from (E1)

  module Raise (b : G1.C1.El) (u v : G4.C2.El) (e1 : E1 b u v) {
    du : G4.C3.El = (C.D2 mFour).f u ;
    dv : G4.C3.El = (C.D2 mFour).f v ;
    w : G7.C3.El = Pi4.lin.f dv ;
    -- P du + Q dv = d (P u + Q v) = d d b = 0
    rel : Id G1.C3.mod.M (G1.C3.mod.madd (S3.P.f du) (S3.Q.f dv)) G1.C3.mod.mz =
      calc G1.C3.mod.M {
        G1.C3.mod.madd (S3.P.f du) (S3.Q.f dv)
          =< ML3.G.cong-add (sym (C.Comm[mFour].d2-P u)) (sym (C.Comm[mFour].d2-Q v))
          > G1.C3.mod.madd ((C.D2 mOne).f (S2.P.f u)) ((C.D2 mOne).f (S2.Q.f v))
          =< sym ((C.D2 mOne).f-add (S2.P.f u) (S2.Q.f v)) > (C.D2 mOne).f (G1.C2.mod.madd (S2.P.f u) (S2.Q.f v))
          =< ap (C.D2 mOne).f (sym e1) > (C.D2 mOne).f ((C.D1 mOne).f b)
          =< C.DD1 mOne b > G1.C3.mod.mz } ;
    -- d v = P w
    ev : E2v v w = sym (P-pinv dv) ;
    -- P du = -Q dv = -Q P w = -P Q w = P (-Q w)
    Pdu : Id G1.C3.mod.M (S3.P.f du) (S3.P.f (G4.C3.mod.mneg (T3.Q.f w))) =
      calc G1.C3.mod.M {
        S3.P.f du
          =< ML3.G.neg-uniq (S3.Q.f dv) (S3.P.f du) (trans (G1.C3.mod.maddC (S3.Q.f dv) (S3.P.f du)) rel)
          > G1.C3.mod.mneg (S3.Q.f dv)
          =< ap (\ y -> G1.C3.mod.mneg (S3.Q.f y)) ev > G1.C3.mod.mneg (S3.Q.f (T3.P.f w))
          =< ap G1.C3.mod.mneg (C.PQ[Sq,setSq,mSeven].comm w) > G1.C3.mod.mneg (S3.P.f (T3.Q.f w))
          =< sym (LS3.f-neg (T3.Q.f w)) > S3.P.f (G4.C3.mod.mneg (T3.Q.f w)) } ;
    eu : E2u u w =
      calc G4.C3.mod.M { du =< sym (pinv-P du) > Pi1.lin.f (S3.P.f du)
                        =< ap Pi1.lin.f Pdu > Pi1.lin.f (S3.P.f (G4.C3.mod.mneg (T3.Q.f w)))
                        =< pinv-P (G4.C3.mod.mneg (T3.Q.f w)) > G4.C3.mod.mneg (T3.Q.f w) } ;
    witness : Witness b (TP.top.f w) = mkWit b (TP.top.f w) u v w e1 eu ev (refl (TP.top.f w)) ;
  } ;

  Lifted (b : G1.C1.El) : U l = (u : G4.C2.El) * ((v : G4.C2.El) * E1 b u v) ;
  Partner (b : G1.C1.El) : U l = (p : V.Vec) * Gam b p ;
  partner (b : G1.C1.El) (h : Tr.Trunc[Lifted b].carrier) : Tr.Trunc[Partner b].carrier =
    TC.map (Lifted b) (Partner b)
      (\ x -> (TP.top.f (Raise[b,x.1,x.2.1,x.2.2].w), Tr.Trunc[Witness b (TP.top.f (Raise[b,x.1,x.2.1,x.2.2].w))].inc (Raise[b,x.1,x.2.1,x.2.2].witness))) h ;

  ------------------------------------------------------------------------
  -- linear closure

  module Zero {
    module LD0 = RCL.LinL[D,G4.C2.mod,G4.C3.mod,C.D2 mFour] ;
    e1 : E1 G1.C1.mod.mz G4.C2.mod.mz G4.C2.mod.mz =
      trans LD1.f-zero (sym (trans (ML2.G.cong-add LS2P.f-zero LS2Q.f-zero) (G1.C2.mod.maddZ G1.C2.mod.mz))) ;
    eu : E2u G4.C2.mod.mz G7.C3.mod.mz = trans LD2.f-zero (sym (trans (ap G4.C3.mod.mneg LT3Q.f-zero) MF3.G.neg-zero)) ;
    ev : E2v G4.C2.mod.mz G7.C3.mod.mz = trans LD2.f-zero (sym LT3P.f-zero) ;
    witness : Witness G1.C1.mod.mz V.mod.mz =
      mkWit G1.C1.mod.mz V.mod.mz G4.C2.mod.mz G4.C2.mod.mz G7.C3.mod.mz e1 eu ev LTop.f-zero ;
  } ;
  gam-zero : Gam G1.C1.mod.mz V.mod.mz = Tr.Trunc[Witness G1.C1.mod.mz V.mod.mz].inc Zero.witness ;

  module Add (b b' : G1.C1.El) (p p' : V.Vec) (x : Witness b p) (x' : Witness b' p') {
    module X = Wit[b,p,x] ; module X' = Wit[b',p',x'] ;
    u : G4.C2.El = G4.C2.mod.madd X.u X'.u ;
    v : G4.C2.El = G4.C2.mod.madd X.v X'.v ;
    w : G7.C3.El = G7.C3.mod.madd X.w X'.w ;
    e1 : E1 (G1.C1.mod.madd b b') u v =
      calc G1.C2.mod.M {
        (C.D1 mOne).f (G1.C1.mod.madd b b')
          =< (C.D1 mOne).f-add b b' > G1.C2.mod.madd ((C.D1 mOne).f b) ((C.D1 mOne).f b')
          =< ML2.G.cong-add X.e1 X'.e1
          > G1.C2.mod.madd (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v)) (G1.C2.mod.madd (S2.P.f X'.u) (S2.Q.f X'.v))
          =< ML2.G.swap (S2.P.f X.u) (S2.Q.f X.v) (S2.P.f X'.u) (S2.Q.f X'.v)
          > G1.C2.mod.madd (G1.C2.mod.madd (S2.P.f X.u) (S2.P.f X'.u)) (G1.C2.mod.madd (S2.Q.f X.v) (S2.Q.f X'.v))
          =< ML2.G.cong-add (sym (S2.P.f-add X.u X'.u)) (sym (S2.Q.f-add X.v X'.v))
          > G1.C2.mod.madd (S2.P.f u) (S2.Q.f v) } ;
    eu : E2u u w =
      calc G4.C3.mod.M {
        (C.D2 mFour).f u =< (C.D2 mFour).f-add X.u X'.u > G4.C3.mod.madd ((C.D2 mFour).f X.u) ((C.D2 mFour).f X'.u)
          =< MF3.G.cong-add X.eu X'.eu > G4.C3.mod.madd (G4.C3.mod.mneg (T3.Q.f X.w)) (G4.C3.mod.mneg (T3.Q.f X'.w))
          =< sym (MF3.G.neg-add (T3.Q.f X.w) (T3.Q.f X'.w)) > G4.C3.mod.mneg (G4.C3.mod.madd (T3.Q.f X.w) (T3.Q.f X'.w))
          =< ap G4.C3.mod.mneg (sym (T3.Q.f-add X.w X'.w)) > G4.C3.mod.mneg (T3.Q.f w) } ;
    ev : E2v v w =
      calc G4.C3.mod.M {
        (C.D2 mFour).f v =< (C.D2 mFour).f-add X.v X'.v > G4.C3.mod.madd ((C.D2 mFour).f X.v) ((C.D2 mFour).f X'.v)
          =< MF3.G.cong-add X.ev X'.ev > G4.C3.mod.madd (T3.P.f X.w) (T3.P.f X'.w)
          =< sym (T3.P.f-add X.w X'.w) > T3.P.f w } ;
    et : Id V.Vec (TP.top.f w) (V.mod.madd p p') =
      trans (TP.top.f-add X.w X'.w) (IP.ModL[D,V.mod].G.cong-add X.etop X'.etop) ;
    witness : Witness (G1.C1.mod.madd b b') (V.mod.madd p p') = mkWit (G1.C1.mod.madd b b') (V.mod.madd p p') u v w e1 eu ev et ;
  } ;
  gam-add (b b' : G1.C1.El) (p p' : V.Vec) (g : Gam b p) (g' : Gam b' p') : Gam (G1.C1.mod.madd b b') (V.mod.madd p p') =
    TC.map2 (Witness b p) (Witness b' p') (Witness (G1.C1.mod.madd b b') (V.mod.madd p p'))
      (\ x x' -> Add[b,b',p,p',x,x'].witness) g g' ;

  module Scale (r : D.R) (b : G1.C1.El) (p : V.Vec) (x : Witness b p) {
    module X = Wit[b,p,x] ;
    u : G4.C2.El = G4.C2.mod.sm r X.u ;
    v : G4.C2.El = G4.C2.mod.sm r X.v ;
    w : G7.C3.El = G7.C3.mod.sm r X.w ;
    e1 : E1 (G1.C1.mod.sm r b) u v =
      calc G1.C2.mod.M {
        (C.D1 mOne).f (G1.C1.mod.sm r b) =< (C.D1 mOne).f-sm r b > G1.C2.mod.sm r ((C.D1 mOne).f b)
          =< ap (G1.C2.mod.sm r) X.e1 > G1.C2.mod.sm r (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v))
          =< G1.C2.mod.smD r (S2.P.f X.u) (S2.Q.f X.v) > G1.C2.mod.madd (G1.C2.mod.sm r (S2.P.f X.u)) (G1.C2.mod.sm r (S2.Q.f X.v))
          =< ML2.G.cong-add (sym (S2.P.f-sm r X.u)) (sym (S2.Q.f-sm r X.v)) > G1.C2.mod.madd (S2.P.f u) (S2.Q.f v) } ;
    eu : E2u u w =
      calc G4.C3.mod.M {
        (C.D2 mFour).f u =< (C.D2 mFour).f-sm r X.u > G4.C3.mod.sm r ((C.D2 mFour).f X.u)
          =< ap (G4.C3.mod.sm r) X.eu > G4.C3.mod.sm r (G4.C3.mod.mneg (T3.Q.f X.w))
          =< MF3.sm-neg r (T3.Q.f X.w) > G4.C3.mod.mneg (G4.C3.mod.sm r (T3.Q.f X.w))
          =< ap G4.C3.mod.mneg (sym (T3.Q.f-sm r X.w)) > G4.C3.mod.mneg (T3.Q.f w) } ;
    ev : E2v v w =
      calc G4.C3.mod.M {
        (C.D2 mFour).f v =< (C.D2 mFour).f-sm r X.v > G4.C3.mod.sm r ((C.D2 mFour).f X.v)
          =< ap (G4.C3.mod.sm r) X.ev > G4.C3.mod.sm r (T3.P.f X.w)
          =< sym (T3.P.f-sm r X.w) > T3.P.f w } ;
    et : Id V.Vec (TP.top.f w) (V.mod.sm r p) = trans (TP.top.f-sm r X.w) (ap (V.mod.sm r) X.etop) ;
    witness : Witness (G1.C1.mod.sm r b) (V.mod.sm r p) = mkWit (G1.C1.mod.sm r b) (V.mod.sm r p) u v w e1 eu ev et ;
  } ;
  gam-sm (r : D.R) (b : G1.C1.El) (p : V.Vec) (g : Gam b p) : Gam (G1.C1.mod.sm r b) (V.mod.sm r p) =
    TC.map (Witness b p) (Witness (G1.C1.mod.sm r b) (V.mod.sm r p)) (\ x -> Scale[r,b,p,x].witness) g ;

  ------------------------------------------------------------------------
  -- zero-reflection: Gam(b, 0) gives B(b), with the primitive constructed

  module Reflect (b : G1.C1.El) (x : Witness b V.mod.mz) {
    module X = Wit[b,V.mod.mz,x] ;
    -- pi w = 0, so t = sigma w has d t = w
    pi0 : Id G7.C3.mod.M (CC.Contr[mSeven].piE X.w) G7.C3.mod.mz = TP.pi-zero X.w X.etop ;
    t : G7.C2.El = CC.Contr[mSeven].sigma X.w ;
    dt : Id G7.C3.mod.M ((C.D2 mSeven).f t) X.w =
      GS3.drop-zero ((C.D2 mSeven).f t) (CC.Contr[mSeven].piE X.w) X.w pi0 (CC.Contr[mSeven].sigma-eq X.w) ;
    -- u' = u + Q t, v' = v - P t
    u' : G4.C2.El = G4.C2.mod.madd X.u (T2.Q.f t) ;
    v' : G4.C2.El = MF2.msub X.v (T2.P.f t) ;
    du' : Id G4.C3.mod.M ((C.D2 mFour).f u') G4.C3.mod.mz =
      calc G4.C3.mod.M {
        (C.D2 mFour).f u' =< (C.D2 mFour).f-add X.u (T2.Q.f t) > G4.C3.mod.madd ((C.D2 mFour).f X.u) ((C.D2 mFour).f (T2.Q.f t))
          =< MF3.G.cong-add X.eu (C.Comm[mSeven].d2-Q t) > G4.C3.mod.madd (G4.C3.mod.mneg (T3.Q.f X.w)) (T3.Q.f ((C.D2 mSeven).f t))
          =< ap (\ y -> G4.C3.mod.madd (G4.C3.mod.mneg (T3.Q.f X.w)) (T3.Q.f y)) dt > G4.C3.mod.madd (G4.C3.mod.mneg (T3.Q.f X.w)) (T3.Q.f X.w)
          =< GF3.neg-self (T3.Q.f X.w) > G4.C3.mod.mz } ;
    dv' : Id G4.C3.mod.M ((C.D2 mFour).f v') G4.C3.mod.mz =
      calc G4.C3.mod.M {
        (C.D2 mFour).f v' =< LD2.f-sub X.v (T2.P.f t) > MF3.msub ((C.D2 mFour).f X.v) ((C.D2 mFour).f (T2.P.f t))
          =< ap (\ y -> MF3.msub y ((C.D2 mFour).f (T2.P.f t))) X.ev > MF3.msub (T3.P.f X.w) ((C.D2 mFour).f (T2.P.f t))
          =< ap (MF3.msub (T3.P.f X.w)) (trans (C.Comm[mSeven].d2-P t) (ap T3.P.f dt)) > MF3.msub (T3.P.f X.w) (T3.P.f X.w)
          =< G4.C3.mod.maddN (T3.P.f X.w) > G4.C3.mod.mz } ;
    -- contract in degree -4
    a0 : G4.C1.El = CC.Contr[mFour].con2 u' ;
    a1 : G4.C1.El = CC.Contr[mFour].con2 v' ;
    da0 : Id G4.C2.mod.M ((C.D1 mFour).f a0) u' = CC.Contr[mFour].con2-eq u' du' ;
    da1 : Id G4.C2.mod.M ((C.D1 mFour).f a1) v' = CC.Contr[mFour].con2-eq v' dv' ;
    -- c = (b - P a0) - Q a1 is closed
    c : G1.C1.El = ML1.msub (ML1.msub b (S1.P.f a0)) (S1.Q.f a1) ;
    R : G1.C2.El = S2.P.f (T2.Q.f t) ;
    Pu' : Id G1.C2.mod.M (S2.P.f u') (G1.C2.mod.madd (S2.P.f X.u) R) = S2.P.f-add X.u (T2.Q.f t) ;
    Qv' : Id G1.C2.mod.M (S2.Q.f v') (ML2.msub (S2.Q.f X.v) R) =
      trans (LS2Q.f-sub X.v (T2.P.f t)) (ap (ML2.msub (S2.Q.f X.v)) (C.PQ[Tri,setTri,mSeven].comm t)) ;
    dc : Id G1.C2.mod.M ((C.D1 mOne).f c) G1.C2.mod.mz =
      calc G1.C2.mod.M {
        (C.D1 mOne).f c
          =< trans (LD1.f-sub (ML1.msub b (S1.P.f a0)) (S1.Q.f a1)) (ap (\ y -> ML2.msub y ((C.D1 mOne).f (S1.Q.f a1))) (LD1.f-sub b (S1.P.f a0)))
          > ML2.msub (ML2.msub ((C.D1 mOne).f b) ((C.D1 mOne).f (S1.P.f a0))) ((C.D1 mOne).f (S1.Q.f a1))
          =< ap (\ y -> ML2.msub (ML2.msub ((C.D1 mOne).f b) y) ((C.D1 mOne).f (S1.Q.f a1))) (trans (C.Comm[mFour].d1-P a0) (ap S2.P.f da0))
          > ML2.msub (ML2.msub ((C.D1 mOne).f b) (S2.P.f u')) ((C.D1 mOne).f (S1.Q.f a1))
          =< ap (ML2.msub (ML2.msub ((C.D1 mOne).f b) (S2.P.f u'))) (trans (C.Comm[mFour].d1-Q a1) (ap S2.Q.f da1))
          > ML2.msub (ML2.msub ((C.D1 mOne).f b) (S2.P.f u')) (S2.Q.f v')
          =< ap (\ y -> ML2.msub (ML2.msub y (S2.P.f u')) (S2.Q.f v')) X.e1
          > ML2.msub (ML2.msub (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v)) (S2.P.f u')) (S2.Q.f v')
          =< ap (\ y -> ML2.msub (ML2.msub (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v)) y) (S2.Q.f v')) Pu'
          > ML2.msub (ML2.msub (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v)) (G1.C2.mod.madd (S2.P.f X.u) R)) (S2.Q.f v')
          =< ap (ML2.msub (ML2.msub (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v)) (G1.C2.mod.madd (S2.P.f X.u) R))) Qv'
          > ML2.msub (ML2.msub (G1.C2.mod.madd (S2.P.f X.u) (S2.Q.f X.v)) (G1.C2.mod.madd (S2.P.f X.u) R)) (ML2.msub (S2.Q.f X.v) R)
          =< GG2.cancel-pair (S2.P.f X.u) (S2.Q.f X.v) R > G1.C2.mod.mz } ;
    -- contract in degree -1
    h : G1.C0.El = CC.Contr[mOne].con1 c ;
    dh : Id G1.C1.mod.M ((C.D0 mOne).f h) c = CC.Contr[mOne].con1-eq c dc ;
    eqb : Id G1.C1.mod.M b (G1.C1.mod.madd (G1.C1.mod.madd ((C.D0 mOne).f h) (S1.P.f a0)) (S1.Q.f a1)) =
      sym (trans (ap (\ y -> G1.C1.mod.madd (G1.C1.mod.madd y (S1.P.f a0)) (S1.Q.f a1)) dh) (GG1.back b (S1.P.f a0) (S1.Q.f a1))) ;
    bdry : Bdry b = (h, (a0, (a1, eqb))) ;
  } ;
  reflect (b : G1.C1.El) (g : Gam b V.mod.mz) : B b =
    TC.map (Witness b V.mod.mz) (Bdry b) (\ x -> Reflect[b,x].bdry) g ;

  -- the relation certificate (RelationCertificate.Rel) of the cubic example
  rel : RelationCertificate[l].Rel[D,G1.C1.mod,V.mod] =
    RelationCertificate[l].mkRel D G1.C1.mod V.mod B Gam gam-zero gam-add gam-sm reflect ;
} ;
