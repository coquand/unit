-- TopList4.seg: the twenty top exponents (handoff §7).
--
-- T20 lists the quadruples (n_0,..,n_3) of natural numbers with sum 3, in
-- lexicographic order; a_i = n_i + 1 >= 1 with sum a_i = 7, and the top
-- exponent of the quadruple is (-a_0,..,-a_3) = (negsuc n_0, .., negsuc n_3)
-- (topExp).
--   * length 20: TopCoordinates4.t20-length (by computation);
--   * no duplicates (t20-nodup): equality of quadruples is decidable
--     (nat-dec), so membership and NoDup are decidable (dec-mem,
--     dec-nodup); the decision for T20 computes to yes;
--   * exhaustive (exhaust): if n_0 + (n_1 + (n_2 + n_3)) = 3 then the
--     quadruple is in T20.  Case analysis on n_0, then n_1, then n_2 (each
--     either a value <= the remaining sum, or too large, which contradicts
--     the equation since addition recurses on its first argument); n_3 is
--     then determined.  The case tree (ex0-x-j, ex1-a-j, ex2-ab-j) was
--     generated mechanically and is checked.
--   * the degree of an all-negative exponent (deg-allneg):
--       deg (negsuc n_0, .., negsuc n_3) = negsuc (n_0+n_1+n_2+n_3+3),
--     so degree -7 forces sum n_i = 3 (top-mem).
-- position: a member of a list sits at some index k : Fin (len l) (elemQ).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ;
module Pr = Prelude[l] ; module NA = NatArith[l] ; module LG = Logic[l] ; module Ps = Presentations[l] ;

one : Nat = suc zero ;
two : Nat = suc one ;
three : Nat = suc two ;
six : Nat = suc (suc (suc three)) ;

-- the twists used: -7, -4 = -7 + 3, -1 = -4 + 3 (so that P, Q : C(k) -> C(k+3)
-- connect them by one unfolding)
mSeven : Int = negsuc six ;
mFour : Int = suc3 mSeven ;
mOne : Int = suc3 mFour ;

data Q4 = q4 (n0 : Nat) (n1 : Nat) (n2 : Nat) (n3 : Nat) ;

topExp : Q4 -> E4 = split { q4 n0 n1 n2 n3 -> ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3) } ;

-- the quadruple of the example of CubicExample: top exponent (-1,-1,-1,-4),
-- the head of T20
tq : Q4 = q4 zero zero zero three ;

MemQ (q : Q4) : List Q4 -> U l = split {
  nil -> Empty ;
  cons x xs | r -> Plus (Id Q4 x q) r } ;
NoDup : List Q4 -> U l = split {
  nil -> Top ;
  cons x xs | r -> LG.Not (MemQ x xs) * r } ;

------------------------------------------------------------------------
-- decidability

q0 : Q4 -> Nat = split { q4 a b c d -> a } ;
q1 : Q4 -> Nat = split { q4 a b c d -> b } ;
q2 : Q4 -> Nat = split { q4 a b c d -> c } ;
q3 : Q4 -> Nat = split { q4 a b c d -> d } ;
q4-eq (a b c d a' b' c' d' : Nat) (p : Id Nat a a') (q : Id Nat b b') (r : Id Nat c c') (s : Id Nat d d') :
  Id Q4 (q4 a b c d) (q4 a' b' c' d') =
  Pr.trans Q4 (q4 a b c d) (q4 a' b c d) (q4 a' b' c' d') (Pr.ap Nat Q4 (\ x -> q4 x b c d) a a' p)
    (Pr.trans Q4 (q4 a' b c d) (q4 a' b' c d) (q4 a' b' c' d') (Pr.ap Nat Q4 (\ x -> q4 a' x c d) b b' q)
      (Pr.trans Q4 (q4 a' b' c d) (q4 a' b' c' d) (q4 a' b' c' d') (Pr.ap Nat Q4 (\ x -> q4 a' b' x d) c c' r)
        (Pr.ap Nat Q4 (\ x -> q4 a' b' c' x) d d' s))) ;
dec-q4-from (a b c d a' b' c' d' : Nat) : LG.Dec (Id Nat a a') -> LG.Dec (Id Nat b b') -> LG.Dec (Id Nat c c') ->
  LG.Dec (Id Nat d d') -> LG.Dec (Id Q4 (q4 a b c d) (q4 a' b' c' d')) = split {
  yes p -> split {
    yes q -> split {
      yes r -> split {
        yes s -> yes (q4-eq a b c d a' b' c' d' p q r s) ;
        no n -> no (\ e -> n (Pr.ap Q4 Nat q3 (q4 a b c d) (q4 a' b' c' d') e)) } ;
      no n -> \ s -> no (\ e -> n (Pr.ap Q4 Nat q2 (q4 a b c d) (q4 a' b' c' d') e)) } ;
    no n -> \ r s -> no (\ e -> n (Pr.ap Q4 Nat q1 (q4 a b c d) (q4 a' b' c' d') e)) } ;
  no n -> \ q r s -> no (\ e -> n (Pr.ap Q4 Nat q0 (q4 a b c d) (q4 a' b' c' d') e)) } ;
dec-q4 : (x y : Q4) -> LG.Dec (Id Q4 x y) = split {
  q4 a b c d -> split {
    q4 a' b' c' d' -> dec-q4-from a b c d a' b' c' d' (nat-dec a a') (nat-dec b b') (nat-dec c c') (nat-dec d d') } } ;

-- a sum of two refuted alternatives is empty
case-plus (A B : U l) : Plus A B -> LG.Not A -> LG.Not B -> Empty = split {
  inl a -> \ n m -> n a ;
  inr b -> \ n m -> m b } ;
dec-plus (A B : U l) : LG.Dec A -> LG.Dec B -> LG.Dec (Plus A B) = split {
  yes a -> \ d -> yes (inl a) ;
  no n -> split {
    yes b -> yes (inr b) ;
    no m -> no (\ h -> case-plus A B h n m) } } ;
dec-times (A B : U l) : LG.Dec A -> LG.Dec B -> LG.Dec (A * B) = split {
  yes a -> split {
    yes b -> yes (a, b) ;
    no m -> no (\ h -> m h.2) } ;
  no n -> \ d -> no (\ h -> n h.1) } ;
dec-not (A : U l) : LG.Dec A -> LG.Dec (LG.Not A) = split {
  yes a -> no (\ f -> f a) ;
  no n -> yes n } ;

dec-mem (q : Q4) : (ls : List Q4) -> LG.Dec (MemQ q ls) = split {
  nil -> no (\ e -> e) ;
  cons x xs | r -> dec-plus (Id Q4 x q) (MemQ q xs) (dec-q4 x q) r } ;
dec-nodup : (ls : List Q4) -> LG.Dec (NoDup ls) = split {
  nil -> yes tt ;
  cons x xs | r -> dec-times (LG.Not (MemQ x xs)) (NoDup xs) (dec-not (MemQ x xs) (dec-mem x xs)) r } ;

IsYes (A : U l) : LG.Dec A -> U l = split { yes a -> Top ; no n -> Empty } ;
from-yes (A : U l) : (d : LG.Dec A) -> IsYes A d -> A = split {
  yes a -> \ t -> a ;
  no n -> \ e -> Pr.absurd A e } ;

------------------------------------------------------------------------
-- the list

T20 : List Q4 =
  cons (q4 zero zero zero three) (
  cons (q4 zero zero one two) (
  cons (q4 zero zero two one) (
  cons (q4 zero zero three zero) (
  cons (q4 zero one zero two) (
  cons (q4 zero one one one) (
  cons (q4 zero one two zero) (
  cons (q4 zero two zero one) (
  cons (q4 zero two one zero) (
  cons (q4 zero three zero zero) (
  cons (q4 one zero zero two) (
  cons (q4 one zero one one) (
  cons (q4 one zero two zero) (
  cons (q4 one one zero one) (
  cons (q4 one one one zero) (
  cons (q4 one two zero zero) (
  cons (q4 two zero zero one) (
  cons (q4 two zero one zero) (
  cons (q4 two one zero zero) (
  cons (q4 three zero zero zero) nil))))))))))))))))))) ;

ex2-30-1 (n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r n3)) zero -> MemQ (q4 three zero (suc r) n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 three zero (suc zero) n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus zero n3))) (suc (NA.plus zero n3)) zero e (NA.code-refl (suc (NA.plus zero n3)))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 three zero (suc (suc r)) n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus (suc r) n3))) (suc (NA.plus (suc r) n3)) zero e (NA.code-refl (suc (NA.plus (suc r) n3)))) } ;
ex2-30-0 (n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r n3) zero -> MemQ (q4 three zero r n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 three zero zero x) zero n3 (Pr.sym Nat n3 zero (NA.code-eq n3 zero (Pr.subst Nat (NA.code (NA.plus zero n3)) (NA.plus zero n3) zero e (NA.code-refl (NA.plus zero n3))))))))))))))))))))))))) ;
  suc r -> ex2-30-1 n3 r } ;
ex1-3-1 (n2 n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r (NA.plus n2 n3))) zero -> MemQ (q4 three (suc r) n2 n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 three (suc zero) n2 n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus zero (NA.plus n2 n3)))) (suc (NA.plus zero (NA.plus n2 n3))) zero e (NA.code-refl (suc (NA.plus zero (NA.plus n2 n3))))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 three (suc (suc r)) n2 n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus (suc r) (NA.plus n2 n3)))) (suc (NA.plus (suc r) (NA.plus n2 n3))) zero e (NA.code-refl (suc (NA.plus (suc r) (NA.plus n2 n3))))) } ;
ex1-3-0 (n2 n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r (NA.plus n2 n3)) zero -> MemQ (q4 three r n2 n3) T20 = split {
  zero -> \ e -> ex2-30-0 n3 n2 (NA.code-eq (NA.plus n2 n3) zero (Pr.subst Nat (NA.code (NA.plus zero (NA.plus n2 n3))) (NA.plus zero (NA.plus n2 n3)) zero e (NA.code-refl (NA.plus zero (NA.plus n2 n3))))) ;
  suc r -> ex1-3-1 n2 n3 r } ;
ex2-21-1 (n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r n3)) zero -> MemQ (q4 two one (suc r) n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 two one (suc zero) n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus zero n3))) (suc (NA.plus zero n3)) zero e (NA.code-refl (suc (NA.plus zero n3)))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 two one (suc (suc r)) n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus (suc r) n3))) (suc (NA.plus (suc r) n3)) zero e (NA.code-refl (suc (NA.plus (suc r) n3)))) } ;
ex2-21-0 (n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r n3) zero -> MemQ (q4 two one r n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 two one zero x) zero n3 (Pr.sym Nat n3 zero (NA.code-eq n3 zero (Pr.subst Nat (NA.code (NA.plus zero n3)) (NA.plus zero n3) zero e (NA.code-refl (NA.plus zero n3)))))))))))))))))))))))) ;
  suc r -> ex2-21-1 n3 r } ;
ex2-20-2 (n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (NA.plus r n3))) one -> MemQ (q4 two zero (suc (suc r)) n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 two zero (suc (suc zero)) n3) T20) (Pr.subst Nat (NA.code (suc (suc (NA.plus zero n3)))) (suc (suc (NA.plus zero n3))) one e (NA.code-refl (suc (suc (NA.plus zero n3))))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 two zero (suc (suc (suc r))) n3) T20) (Pr.subst Nat (NA.code (suc (suc (NA.plus (suc r) n3)))) (suc (suc (NA.plus (suc r) n3))) one e (NA.code-refl (suc (suc (NA.plus (suc r) n3))))) } ;
ex2-20-1 (n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r n3)) one -> MemQ (q4 two zero (suc r) n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 two zero one x) zero n3 (Pr.sym Nat n3 zero (NA.code-eq n3 zero (Pr.subst Nat (NA.code (suc (NA.plus zero n3))) (suc (NA.plus zero n3)) one e (NA.code-refl (suc (NA.plus zero n3)))))))))))))))))))))))) ;
  suc r -> ex2-20-2 n3 r } ;
ex2-20-0 (n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r n3) one -> MemQ (q4 two zero r n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 two zero zero x) one n3 (Pr.sym Nat n3 one (NA.code-eq n3 one (Pr.subst Nat (NA.code (NA.plus zero n3)) (NA.plus zero n3) one e (NA.code-refl (NA.plus zero n3)))))))))))))))))))))) ;
  suc r -> ex2-20-1 n3 r } ;
ex1-2-2 (n2 n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (NA.plus r (NA.plus n2 n3)))) one -> MemQ (q4 two (suc (suc r)) n2 n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 two (suc (suc zero)) n2 n3) T20) (Pr.subst Nat (NA.code (suc (suc (NA.plus zero (NA.plus n2 n3))))) (suc (suc (NA.plus zero (NA.plus n2 n3)))) one e (NA.code-refl (suc (suc (NA.plus zero (NA.plus n2 n3)))))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 two (suc (suc (suc r))) n2 n3) T20) (Pr.subst Nat (NA.code (suc (suc (NA.plus (suc r) (NA.plus n2 n3))))) (suc (suc (NA.plus (suc r) (NA.plus n2 n3)))) one e (NA.code-refl (suc (suc (NA.plus (suc r) (NA.plus n2 n3)))))) } ;
ex1-2-1 (n2 n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r (NA.plus n2 n3))) one -> MemQ (q4 two (suc r) n2 n3) T20 = split {
  zero -> \ e -> ex2-21-0 n3 n2 (NA.code-eq (NA.plus n2 n3) zero (Pr.subst Nat (NA.code (suc (NA.plus zero (NA.plus n2 n3)))) (suc (NA.plus zero (NA.plus n2 n3))) one e (NA.code-refl (suc (NA.plus zero (NA.plus n2 n3)))))) ;
  suc r -> ex1-2-2 n2 n3 r } ;
ex1-2-0 (n2 n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r (NA.plus n2 n3)) one -> MemQ (q4 two r n2 n3) T20 = split {
  zero -> \ e -> ex2-20-0 n3 n2 (NA.code-eq (NA.plus n2 n3) one (Pr.subst Nat (NA.code (NA.plus zero (NA.plus n2 n3))) (NA.plus zero (NA.plus n2 n3)) one e (NA.code-refl (NA.plus zero (NA.plus n2 n3))))) ;
  suc r -> ex1-2-1 n2 n3 r } ;
ex2-12-1 (n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r n3)) zero -> MemQ (q4 one two (suc r) n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 one two (suc zero) n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus zero n3))) (suc (NA.plus zero n3)) zero e (NA.code-refl (suc (NA.plus zero n3)))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 one two (suc (suc r)) n3) T20) (Pr.subst Nat (NA.code (suc (NA.plus (suc r) n3))) (suc (NA.plus (suc r) n3)) zero e (NA.code-refl (suc (NA.plus (suc r) n3)))) } ;
ex2-12-0 (n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r n3) zero -> MemQ (q4 one two r n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 one two zero x) zero n3 (Pr.sym Nat n3 zero (NA.code-eq n3 zero (Pr.subst Nat (NA.code (NA.plus zero n3)) (NA.plus zero n3) zero e (NA.code-refl (NA.plus zero n3))))))))))))))))))))) ;
  suc r -> ex2-12-1 n3 r } ;
ex2-11-2 (n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (NA.plus r n3))) one -> MemQ (q4 one one (suc (suc r)) n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 one one (suc (suc zero)) n3) T20) (Pr.subst Nat (NA.code (suc (suc (NA.plus zero n3)))) (suc (suc (NA.plus zero n3))) one e (NA.code-refl (suc (suc (NA.plus zero n3))))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 one one (suc (suc (suc r))) n3) T20) (Pr.subst Nat (NA.code (suc (suc (NA.plus (suc r) n3)))) (suc (suc (NA.plus (suc r) n3))) one e (NA.code-refl (suc (suc (NA.plus (suc r) n3))))) } ;
ex2-11-1 (n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r n3)) one -> MemQ (q4 one one (suc r) n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 one one one x) zero n3 (Pr.sym Nat n3 zero (NA.code-eq n3 zero (Pr.subst Nat (NA.code (suc (NA.plus zero n3))) (suc (NA.plus zero n3)) one e (NA.code-refl (suc (NA.plus zero n3))))))))))))))))))))) ;
  suc r -> ex2-11-2 n3 r } ;
ex2-11-0 (n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r n3) one -> MemQ (q4 one one r n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 one one zero x) one n3 (Pr.sym Nat n3 one (NA.code-eq n3 one (Pr.subst Nat (NA.code (NA.plus zero n3)) (NA.plus zero n3) one e (NA.code-refl (NA.plus zero n3))))))))))))))))))) ;
  suc r -> ex2-11-1 n3 r } ;
ex2-10-3 (n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (suc (NA.plus r n3)))) two -> MemQ (q4 one zero (suc (suc (suc r))) n3) T20 = split {
  zero -> \ e -> Pr.absurd (MemQ (q4 one zero (suc (suc (suc zero))) n3) T20) (Pr.subst Nat (NA.code (suc (suc (suc (NA.plus zero n3))))) (suc (suc (suc (NA.plus zero n3)))) two e (NA.code-refl (suc (suc (suc (NA.plus zero n3)))))) ;
  suc r -> \ e -> Pr.absurd (MemQ (q4 one zero (suc (suc (suc (suc r)))) n3) T20) (Pr.subst Nat (NA.code (suc (suc (suc (NA.plus (suc r) n3))))) (suc (suc (suc (NA.plus (suc r) n3)))) two e (NA.code-refl (suc (suc (suc (NA.plus (suc r) n3)))))) } ;
ex2-10-2 (n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (NA.plus r n3))) two -> MemQ (q4 one zero (suc (suc r)) n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 one zero two x) zero n3 (Pr.sym Nat n3 zero (NA.code-eq n3 zero (Pr.subst Nat (NA.code (suc (suc (NA.plus zero n3)))) (suc (suc (NA.plus zero n3))) two e (NA.code-refl (suc (suc (NA.plus zero n3)))))))))))))))))))) ;
  suc r -> ex2-10-3 n3 r } ;
ex2-10-1 (n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r n3)) two -> MemQ (q4 one zero (suc r) n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 one zero one x) one n3 (Pr.sym Nat n3 one (NA.code-eq n3 one (Pr.subst Nat (NA.code (suc (NA.plus zero n3))) (suc (NA.plus zero n3)) two e (NA.code-refl (suc (NA.plus zero n3)))))))))))))))))) ;
  suc r -> ex2-10-2 n3 r } ;
ex2-10-0 (n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r n3) two -> MemQ (q4 one zero r n3) T20 = split {
  zero -> \ e -> inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (Pr.ap Nat Q4 (\ x -> q4 one zero zero x) two n3 (Pr.sym Nat n3 two (NA.code-eq n3 two (Pr.subst Nat (NA.code (NA.plus zero n3)) (NA.plus zero n3) two e (NA.code-refl (NA.plus zero n3)))))))))))))))) ;
