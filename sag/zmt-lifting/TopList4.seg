t20-nodup : NoDup T20 = from-yes (NoDup T20) (dec-nodup T20) tt ;

exhaust (n0 n1 n2 n3 : Nat) (e : Id Nat (NA.plus n0 (NA.plus n1 (NA.plus n2 n3))) three) : MemQ (q4 n0 n1 n2 n3) T20 =
  ex0-x-0 n1 n2 n3 n0 e ;

------------------------------------------------------------------------
-- degrees of all-negative exponents

-- negsuc a + negsuc n = negsuc (n + a + 1)
addN-neg (a : Nat) : (n : Nat) -> Id Int (addN (negsuc a) n) (negsuc (suc (NA.plus n a))) = split {
  zero -> refl (negsuc (suc a)) ;
  suc m | r -> ap predZ r } ;

-- n3 + (n2 + (n1 + n0)) = n0 + (n1 + (n2 + n3))
plus-rev (n0 n1 n2 n3 : Nat) : Id Nat (NA.plus n3 (NA.plus n2 (NA.plus n1 n0))) (NA.plus n0 (NA.plus n1 (NA.plus n2 n3))) =
  calc Nat {
    NA.plus n3 (NA.plus n2 (NA.plus n1 n0))
      =< NA.plus-comm n3 (NA.plus n2 (NA.plus n1 n0)) > NA.plus (NA.plus n2 (NA.plus n1 n0)) n3
      =< NA.plus-assoc n2 (NA.plus n1 n0) n3 > NA.plus n2 (NA.plus (NA.plus n1 n0) n3)
      =< NA.plus-comm n2 (NA.plus (NA.plus n1 n0) n3) > NA.plus (NA.plus (NA.plus n1 n0) n3) n2
      =< NA.plus-assoc (NA.plus n1 n0) n3 n2 > NA.plus (NA.plus n1 n0) (NA.plus n3 n2)
      =< ap (\ x -> NA.plus x (NA.plus n3 n2)) (NA.plus-comm n1 n0) > NA.plus (NA.plus n0 n1) (NA.plus n3 n2)
      =< ap (NA.plus (NA.plus n0 n1)) (NA.plus-comm n3 n2) > NA.plus (NA.plus n0 n1) (NA.plus n2 n3)
      =< NA.plus-assoc n0 n1 (NA.plus n2 n3) > NA.plus n0 (NA.plus n1 (NA.plus n2 n3)) } ;

-- n3 + (n2 + (n1 + n0) + 1) + 1 = n0 + n1 + n2 + n3 + 2
sum-shape (n0 n1 n2 n3 : Nat) :
  Id Nat (NA.plus n3 (suc (NA.plus n2 (suc (NA.plus n1 n0))))) (suc (suc (NA.plus n0 (NA.plus n1 (NA.plus n2 n3))))) =
  calc Nat {
    NA.plus n3 (suc (NA.plus n2 (suc (NA.plus n1 n0))))
      =< NA.plus-suc n3 (NA.plus n2 (suc (NA.plus n1 n0))) > suc (NA.plus n3 (NA.plus n2 (suc (NA.plus n1 n0))))
      =< ap (\ x -> suc (NA.plus n3 x)) (NA.plus-suc n2 (NA.plus n1 n0)) > suc (NA.plus n3 (suc (NA.plus n2 (NA.plus n1 n0))))
      =< ap (\ x -> suc x) (NA.plus-suc n3 (NA.plus n2 (NA.plus n1 n0))) > suc (suc (NA.plus n3 (NA.plus n2 (NA.plus n1 n0))))
      =< ap (\ x -> suc (suc x)) (plus-rev n0 n1 n2 n3) > suc (suc (NA.plus n0 (NA.plus n1 (NA.plus n2 n3)))) } ;

deg-allneg (n0 n1 n2 n3 : Nat) :
  Id Int (deg (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) (negsuc (suc (suc (suc (NA.plus n0 (NA.plus n1 (NA.plus n2 n3))))))) =
  calc Int {
    add (add (add (negsuc n0) (negsuc n1)) (negsuc n2)) (negsuc n3)
      =< ap (\ x -> add (add x (negsuc n2)) (negsuc n3)) (addN-neg n0 n1) > add (add (negsuc (suc (NA.plus n1 n0))) (negsuc n2)) (negsuc n3)
      =< ap (\ x -> add x (negsuc n3)) (addN-neg (suc (NA.plus n1 n0)) n2) > add (negsuc (suc (NA.plus n2 (suc (NA.plus n1 n0))))) (negsuc n3)
      =< addN-neg (suc (NA.plus n2 (suc (NA.plus n1 n0)))) n3 > negsuc (suc (NA.plus n3 (suc (NA.plus n2 (suc (NA.plus n1 n0))))))
      =< ap (\ x -> negsuc (suc x)) (sum-shape n0 n1 n2 n3) > negsuc (suc (suc (suc (NA.plus n0 (NA.plus n1 (NA.plus n2 n3)))))) } ;

-- an all-negative exponent of degree -7 is a top exponent
module TopMem (n0 n1 n2 n3 : Nat) (e : Id Int (deg (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) mSeven) {
  sum : Nat = NA.plus n0 (NA.plus n1 (NA.plus n2 n3)) ;
  m : E4 = ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3) ;
  e1 : Id Int (negsuc (suc (suc (suc sum)))) mSeven =
    Pr.trans Int (negsuc (suc (suc (suc sum)))) (deg m) mSeven (Pr.sym Int (deg m) (negsuc (suc (suc (suc sum)))) (deg-allneg n0 n1 n2 n3)) e ;
  e2 : Id Nat sum three = NA.code-eq sum three (encode (negsuc (suc (suc (suc sum)))) mSeven e1) ;
  mem : MemQ (q4 n0 n1 n2 n3) T20 = exhaust n0 n1 n2 n3 e2 ;
} ;
top-mem (n0 n1 n2 n3 : Nat) (e : Id Int (deg (ex (negsuc n0) (negsuc n1) (negsuc n2) (negsuc n3))) mSeven) :
  MemQ (q4 n0 n1 n2 n3) T20 = TopMem[n0,n1,n2,n3,e].mem ;

------------------------------------------------------------------------
-- indices

elemQ : (ls : List Q4) -> Ps.Fin (len ls) -> Q4 = split {
  nil -> \ i -> absurd Q4 i ;
  cons t s | r -> Ps.snoc (Ps.Fin (len s)) Q4 r t } ;
Position (q : Q4) (ls : List Q4) : U l = (k : Ps.Fin (len ls)) * Id Q4 (elemQ ls k) q ;
position (q : Q4) : (ls : List Q4) -> MemQ q ls -> Position q ls = split {
  nil -> \ h -> Pr.absurd (Position q nil) h ;
  cons t s | r -> split {
    inl e -> (inr tt, e) ;
    inr h -> (inl (r h).1, (r h).2) } } ;
