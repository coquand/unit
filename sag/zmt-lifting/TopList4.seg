ex1-1-3 (n2 n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (suc (NA.plus r (NA.plus n2 n3))))) two -> MemQ (q4 one (suc (suc (suc r))) n2 n3) T20 = split {
