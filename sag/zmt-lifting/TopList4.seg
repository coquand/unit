  suc r -> \ e -> Pr.absurd (MemQ (q4 one (suc (suc (suc (suc r)))) n2 n3) T20) (Pr.subst Nat (NA.code (suc (suc (suc (NA.plus (suc r) (NA.plus n2 n3)))))) (suc (suc (suc (NA.plus (suc r) (NA.plus n2 n3))))) two e (NA.code-refl (suc (suc (suc (NA.plus (suc r) (NA.plus n2 n3))))))) } ;
ex1-1-2 (n2 n3 : Nat) : (r : Nat) -> Id Nat (suc (suc (NA.plus r (NA.plus n2 n3)))) two -> MemQ (q4 one (suc (suc r)) n2 n3) T20 = split {
  zero -> \ e -> ex2-12-0 n3 n2 (NA.code-eq (NA.plus n2 n3) zero (Pr.subst Nat (NA.code (suc (suc (NA.plus zero (NA.plus n2 n3))))) (suc (suc (NA.plus zero (NA.plus n2 n3)))) two e (NA.code-refl (suc (suc (NA.plus zero (NA.plus n2 n3))))))) ;
  suc r -> ex1-1-3 n2 n3 r } ;
ex1-1-1 (n2 n3 : Nat) : (r : Nat) -> Id Nat (suc (NA.plus r (NA.plus n2 n3))) two -> MemQ (q4 one (suc r) n2 n3) T20 = split {
  zero -> \ e -> ex2-11-0 n3 n2 (NA.code-eq (NA.plus n2 n3) one (Pr.subst Nat (NA.code (suc (NA.plus zero (NA.plus n2 n3)))) (suc (NA.plus zero (NA.plus n2 n3))) two e (NA.code-refl (suc (NA.plus zero (NA.plus n2 n3)))))) ;
  suc r -> ex1-1-2 n2 n3 r } ;
ex1-1-0 (n2 n3 : Nat) : (r : Nat) -> Id Nat (NA.plus r (NA.plus n2 n3)) two -> MemQ (q4 one r n2 n3) T20 = split {
  zero -> \ e -> ex2-10-0 n3 n2 (NA.code-eq (NA.plus n2 n3) two (Pr.subst Nat (NA.code (NA.plus zero (NA.plus n2 n3))) (NA.plus zero (NA.plus n2 n3)) two e (NA.code-refl (NA.plus zero (NA.plus n2 n3))))) ;
