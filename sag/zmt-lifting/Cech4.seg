-- Cech4.seg: the four-chart Cech complex of S = D[X_0,..,X_3] twisted by k
-- (handoff §5), with the fixed alternating convention.
--
-- Components.  Subsets of {0,1,2,3} of size q+1, ordered increasingly:
--   C^0: p0..p3 (Pt),  C^1: e01 e02 e03 e12 e13 e23 (Ed),
--   C^2: t012 t013 t023 t123 (Tri),  C^3: s0123 (Sq),
-- 4, 6, 4, 1 components.  C^q(k) = Laurent4.Over.Chart for the index type of
-- degree q and the vanishing set
--   Bad k E m  :=  deg m /= k  or  Out E m,
-- i.e. a component c_E is homogeneous of degree k with negative exponents
-- only at the indices of E (Deg k).
--
-- Differential (restrictions are inclusions of coefficient functions):
--   (d c)_ij   = c_j - c_i                                   (d0)
--   (d c)_ijk  = (c_jk - c_ik) + c_ij                        (d1)
--   (d c)_0123 = ((c_123 - c_023) + c_013) - c_012           (d2)
-- pointwise in the exponent.  Each output component involves only
-- components on faces E' of E, and Out E m implies Out E' m (out-face), so
-- d preserves the vanishing conditions; finite support is kept with the
-- same list.  D-linearity (d0-add .. d2-sm): the three shapes
-- x - y, (x - y) + z, ((x - y) + z) - w are additive and commute with
-- scalars.  d d = 0 (dd0, dd1):
--   ((c_k - c_j) - (c_k - c_i)) + (c_j - c_i) = 0,
--   (((c23-c13)+c12) - ((c23-c03)+c02)) + ((c13-c03)+c01) - ((c12-c02)+c01) = 0.
--
-- Shifts.  P = X_0^3 and Q = X_1^3 map C^q(k) to C^q(k+3) (Shift): a negative
-- exponent stays negative after subtracting 3, and the degree drops by 3.
-- X_0^(-3) maps C^3(k) to C^3(k-3) (pinv): on the fully inverted chart there
-- is no sign condition.  d commutes with the shifts definitionally
-- pointwise (both sides read c at the same shifted exponent), and P Q = Q P.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ;

------------------------------------------------------------------------
-- components and chart conditions

data Pt = p0 | p1 | p2 | p3 ;
data Ed = e01 | e02 | e03 | e12 | e13 | e23 ;
data Tri = t012 | t013 | t023 | t123 ;
data Sq = s0123 ;

setPt : Pt -> Sub4 = split {
  p0 -> sub inside outside outside outside ;
  p1 -> sub outside inside outside outside ;
  p2 -> sub outside outside inside outside ;
  p3 -> sub outside outside outside inside } ;
setEd : Ed -> Sub4 = split {
  e01 -> sub inside inside outside outside ;
  e02 -> sub inside outside inside outside ;
  e03 -> sub inside outside outside inside ;
  e12 -> sub outside inside inside outside ;
  e13 -> sub outside inside outside inside ;
  e23 -> sub outside outside inside inside } ;
setTri : Tri -> Sub4 = split {
  t012 -> sub inside inside inside outside ;
  t013 -> sub inside inside outside inside ;
  t023 -> sub inside outside inside inside ;
  t123 -> sub outside inside inside inside } ;
setSq : Sq -> Sub4 = split { s0123 -> full } ;

Bad (k : Int) (E : Sub4) (m : E4) : U l = Plus (Not (Id Int (deg m) k)) (Out E m) ;
BadI (I : U l) (set : I -> Sub4) (k : Int) (i : I) (m : E4) : U l = Bad k (set i) m ;

-- the inclusions of faces used by d (each Le4 reduces to Top * (Top * (Top * Top)))
ok4 : Top * (Top * (Top * Top)) = (tt, (tt, (tt, tt))) ;

bad-face (k : Int) (E' E : Sub4) (le : Le4 E' E) (m : E4) : Bad k E m -> Bad k E' m = split {
  inl h -> inl h ;
  inr h -> inr (out-face E' E le m h) } ;
bad-sh0 (k : Int) (E : Sub4) (m : E4) : Bad (suc3 k) E m -> Bad k E (sh0 m) = split {
  inl h -> inl (not-deg-pred k (deg m) (deg (sh0 m)) (deg-sh0 m) h) ;
  inr h -> inr (out-sh0 E m h) } ;
bad-sh1 (k : Int) (E : Sub4) (m : E4) : Bad (suc3 k) E m -> Bad k E (sh1 m) = split {
  inl h -> inl (not-deg-pred k (deg m) (deg (sh1 m)) (deg-sh1 m) h) ;
  inr h -> inr (out-sh1 E m h) } ;
bad-up0 (k : Int) (m : E4) : Bad (pred3 k) full m -> Bad k full (up0 m) = split {
  inl h -> inl (not-deg-suc k (deg m) (deg (up0 m)) (deg-up0 m) h) ;
  inr h -> absurd (Bad k full (up0 m)) (out-full m h) } ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module LO = Laurent4[l].Over[D,setD] ;
  module DL = IP.ModL[D,IP.regular D] ;

  ------------------------------------------------------------------------
  -- identities of the abelian group of D

  -- -(a - b) = b - a
  neg-sub (a b : D.R) : Id D.R (D.neg (DL.msub a b)) (DL.msub b a) =
    calc D.R { D.neg (DL.msub a b) =< DL.G.neg-add a (D.neg b) > D.add (D.neg a) (D.neg (D.neg b))
                 =< ap (D.add (D.neg a)) (DL.G.neg-neg b) > D.add (D.neg a) b
                 =< D.addC (D.neg a) b > DL.msub b a } ;
  -- a - 0 = a
  sub-zero-r (a : D.R) : Id D.R (DL.msub a D.z) a = trans (ap (D.add a) DL.G.neg-zero) (D.addZ a) ;
  -- a - (-b) = a + b
  sub-neg (a b : D.R) : Id D.R (DL.msub a (D.neg b)) (D.add a b) = ap (D.add a) (DL.G.neg-neg b) ;
  -- 0 - (-a) = a
  zero-sub-neg (a : D.R) : Id D.R (DL.msub D.z (D.neg a)) a = trans (sub-neg D.z a) (DL.G.zl a) ;
  -- a + (w - a) = w
  add-sub-cancel (a w : D.R) : Id D.R (D.add a (DL.msub w a)) w =
    calc D.R { D.add a (DL.msub w a) =< D.addC a (DL.msub w a) > D.add (DL.msub w a) a
                 =< sym (D.addA w (D.neg a) a) > D.add w (D.add (D.neg a) a)
                 =< ap (D.add w) (trans (D.addC (D.neg a) a) (D.addN a)) > D.add w D.z
                 =< D.addZ w > w } ;
  -- -a + (a + z) = z
  neg-add-cancel (a z : D.R) : Id D.R (D.add (D.neg a) (D.add a z)) z =
    calc D.R { D.add (D.neg a) (D.add a z) =< D.addA (D.neg a) a z > D.add (D.add (D.neg a) a) z
                 =< ap (\ t -> D.add t z) (trans (D.addC (D.neg a) a) (D.addN a)) > D.add D.z z
                 =< DL.G.zl z > z } ;
  -- (c - b) - (c - a) = a - b
  sub-sub-same (c a b : D.R) : Id D.R (DL.msub (DL.msub c b) (DL.msub c a)) (DL.msub a b) =
    calc D.R { DL.msub (DL.msub c b) (DL.msub c a) =< ap (D.add (DL.msub c b)) (neg-sub c a) > D.add (DL.msub c b) (DL.msub a c)
                 =< DL.G.swap c (D.neg b) a (D.neg c) > D.add (D.add c a) (D.add (D.neg b) (D.neg c))
                 =< DL.G.cong-add (D.addC c a) (D.addC (D.neg b) (D.neg c)) > D.add (D.add a c) (D.add (D.neg c) (D.neg b))
                 =< sym (D.addA a c (D.add (D.neg c) (D.neg b))) > D.add a (D.add c (D.add (D.neg c) (D.neg b)))
                 =< ap (D.add a) (trans (D.addA c (D.neg c) (D.neg b)) (trans (ap (\ t -> D.add t (D.neg b)) (D.addN c)) (DL.G.zl (D.neg b))))
                 > DL.msub a b } ;
  -- (w - x) + y = w - (x - y)
  sub-add (w x y : D.R) : Id D.R (D.add (DL.msub w x) y) (DL.msub w (DL.msub x y)) =
    calc D.R { D.add (DL.msub w x) y =< sym (D.addA w (D.neg x) y) > D.add w (D.add (D.neg x) y)
                 =< ap (D.add w) (trans (D.addC (D.neg x) y) (sym (neg-sub x y))) > DL.msub w (DL.msub x y) } ;

  -- vanishing of the three shapes
  zero-sub (x y : D.R) (hx : Id D.R x D.z) (hy : Id D.R y D.z) : Id D.R (DL.msub x y) D.z =
    LO.zero-add x (D.neg y) hx (LO.zero-neg y hy) ;
  zero-T (x y z : D.R) (hx : Id D.R x D.z) (hy : Id D.R y D.z) (hz : Id D.R z D.z) :
    Id D.R (D.add (DL.msub x y) z) D.z = LO.zero-add (DL.msub x y) z (zero-sub x y hx hy) hz ;
  zero-Q (x y z w : D.R) (hx : Id D.R x D.z) (hy : Id D.R y D.z) (hz : Id D.R z D.z) (hw : Id D.R w D.z) :
    Id D.R (DL.msub (D.add (DL.msub x y) z) w) D.z = zero-sub (D.add (DL.msub x y) z) w (zero-T x y z hx hy hz) hw ;

  -- linearity of the three shapes
  sub-lin-add (x y x' y' : D.R) : Id D.R (DL.msub (D.add x x') (D.add y y')) (D.add (DL.msub x y) (DL.msub x' y')) =
    DL.sub-swap x x' y y' ;
  T-lin-add (x y z x' y' z' : D.R) :
    Id D.R (D.add (DL.msub (D.add x x') (D.add y y')) (D.add z z')) (D.add (D.add (DL.msub x y) z) (D.add (DL.msub x' y') z')) =
    trans (ap (\ t -> D.add t (D.add z z')) (sub-lin-add x y x' y')) (DL.G.swap (DL.msub x y) (DL.msub x' y') z z') ;
  Q-lin-add (x y z w x' y' z' w' : D.R) :
    Id D.R (DL.msub (D.add (DL.msub (D.add x x') (D.add y y')) (D.add z z')) (D.add w w'))
           (D.add (DL.msub (D.add (DL.msub x y) z) w) (DL.msub (D.add (DL.msub x' y') z') w')) =
    trans (ap (\ t -> DL.msub t (D.add w w')) (T-lin-add x y z x' y' z'))
      (sub-lin-add (D.add (DL.msub x y) z) w (D.add (DL.msub x' y') z') w') ;
  sub-lin-sm (r x y : D.R) : Id D.R (D.mul r (DL.msub x y)) (DL.msub (D.mul r x) (D.mul r y)) = DL.sm-sub r x y ;
  T-lin-sm (r x y z : D.R) : Id D.R (D.mul r (D.add (DL.msub x y) z)) (D.add (DL.msub (D.mul r x) (D.mul r y)) (D.mul r z)) =
    trans (D.dist r (DL.msub x y) z) (ap (\ t -> D.add t (D.mul r z)) (sub-lin-sm r x y)) ;
  Q-lin-sm (r x y z w : D.R) :
    Id D.R (D.mul r (DL.msub (D.add (DL.msub x y) z) w)) (DL.msub (D.add (DL.msub (D.mul r x) (D.mul r y)) (D.mul r z)) (D.mul r w)) =
    trans (sub-lin-sm r (D.add (DL.msub x y) z) w) (ap (\ t -> DL.msub t (D.mul r w)) (T-lin-sm r x y z)) ;

  ------------------------------------------------------------------------
  -- the cochain modules

  Lau : IP.Mod[D] = LO.powM E4 (IP.regular D) ;

  module Deg (k : Int) {
    module C0 = LO.Chart[Pt, BadI Pt setPt k] ;
    module C1 = LO.Chart[Ed, BadI Ed setEd k] ;
    module C2 = LO.Chart[Tri, BadI Tri setTri k] ;
    module C3 = LO.Chart[Sq, BadI Sq setSq k] ;
  } ;

  ------------------------------------------------------------------------
  -- the differential on raw families

  d0 (c : Pt -> E4 -> D.R) : Ed -> E4 -> D.R = split {
    e01 -> \ m -> DL.msub (c p1 m) (c p0 m) ;
    e02 -> \ m -> DL.msub (c p2 m) (c p0 m) ;
    e03 -> \ m -> DL.msub (c p3 m) (c p0 m) ;
    e12 -> \ m -> DL.msub (c p2 m) (c p1 m) ;
    e13 -> \ m -> DL.msub (c p3 m) (c p1 m) ;
    e23 -> \ m -> DL.msub (c p3 m) (c p2 m) } ;
  d1 (c : Ed -> E4 -> D.R) : Tri -> E4 -> D.R = split {
    t012 -> \ m -> D.add (DL.msub (c e12 m) (c e02 m)) (c e01 m) ;
    t013 -> \ m -> D.add (DL.msub (c e13 m) (c e03 m)) (c e01 m) ;
    t023 -> \ m -> D.add (DL.msub (c e23 m) (c e03 m)) (c e02 m) ;
    t123 -> \ m -> D.add (DL.msub (c e23 m) (c e13 m)) (c e12 m) } ;
  d2 (c : Tri -> E4 -> D.R) : Sq -> E4 -> D.R = split {
    s0123 -> \ m -> DL.msub (D.add (DL.msub (c t123 m) (c t023 m)) (c t013 m)) (c t012 m) } ;

  -- linearity
  d0-add (c c' : Pt -> E4 -> D.R) : (j : Ed) (m : E4) ->
    Id D.R (d0 (\ i m -> D.add (c i m) (c' i m)) j m) (D.add (d0 c j m) (d0 c' j m)) = split {
    e01 -> \ m -> sub-lin-add (c p1 m) (c p0 m) (c' p1 m) (c' p0 m) ;
    e02 -> \ m -> sub-lin-add (c p2 m) (c p0 m) (c' p2 m) (c' p0 m) ;
    e03 -> \ m -> sub-lin-add (c p3 m) (c p0 m) (c' p3 m) (c' p0 m) ;
    e12 -> \ m -> sub-lin-add (c p2 m) (c p1 m) (c' p2 m) (c' p1 m) ;
    e13 -> \ m -> sub-lin-add (c p3 m) (c p1 m) (c' p3 m) (c' p1 m) ;
    e23 -> \ m -> sub-lin-add (c p3 m) (c p2 m) (c' p3 m) (c' p2 m) } ;
  d0-sm (r : D.R) (c : Pt -> E4 -> D.R) : (j : Ed) (m : E4) ->
    Id D.R (d0 (\ i m -> D.mul r (c i m)) j m) (D.mul r (d0 c j m)) = split {
    e01 -> \ m -> sym (sub-lin-sm r (c p1 m) (c p0 m)) ;
    e02 -> \ m -> sym (sub-lin-sm r (c p2 m) (c p0 m)) ;
    e03 -> \ m -> sym (sub-lin-sm r (c p3 m) (c p0 m)) ;
    e12 -> \ m -> sym (sub-lin-sm r (c p2 m) (c p1 m)) ;
    e13 -> \ m -> sym (sub-lin-sm r (c p3 m) (c p1 m)) ;
    e23 -> \ m -> sym (sub-lin-sm r (c p3 m) (c p2 m)) } ;
  d1-add (c c' : Ed -> E4 -> D.R) : (j : Tri) (m : E4) ->
    Id D.R (d1 (\ i m -> D.add (c i m) (c' i m)) j m) (D.add (d1 c j m) (d1 c' j m)) = split {
    t012 -> \ m -> T-lin-add (c e12 m) (c e02 m) (c e01 m) (c' e12 m) (c' e02 m) (c' e01 m) ;
    t013 -> \ m -> T-lin-add (c e13 m) (c e03 m) (c e01 m) (c' e13 m) (c' e03 m) (c' e01 m) ;
    t023 -> \ m -> T-lin-add (c e23 m) (c e03 m) (c e02 m) (c' e23 m) (c' e03 m) (c' e02 m) ;
    t123 -> \ m -> T-lin-add (c e23 m) (c e13 m) (c e12 m) (c' e23 m) (c' e13 m) (c' e12 m) } ;
  d1-sm (r : D.R) (c : Ed -> E4 -> D.R) : (j : Tri) (m : E4) ->
    Id D.R (d1 (\ i m -> D.mul r (c i m)) j m) (D.mul r (d1 c j m)) = split {
    t012 -> \ m -> sym (T-lin-sm r (c e12 m) (c e02 m) (c e01 m)) ;
    t013 -> \ m -> sym (T-lin-sm r (c e13 m) (c e03 m) (c e01 m)) ;
    t023 -> \ m -> sym (T-lin-sm r (c e23 m) (c e03 m) (c e02 m)) ;
    t123 -> \ m -> sym (T-lin-sm r (c e23 m) (c e13 m) (c e12 m)) } ;
  d2-add (c c' : Tri -> E4 -> D.R) : (j : Sq) (m : E4) ->
    Id D.R (d2 (\ i m -> D.add (c i m) (c' i m)) j m) (D.add (d2 c j m) (d2 c' j m)) = split {
    s0123 -> \ m -> Q-lin-add (c t123 m) (c t023 m) (c t013 m) (c t012 m) (c' t123 m) (c' t023 m) (c' t013 m) (c' t012 m) } ;
  d2-sm (r : D.R) (c : Tri -> E4 -> D.R) : (j : Sq) (m : E4) ->
    Id D.R (d2 (\ i m -> D.mul r (c i m)) j m) (D.mul r (d2 c j m)) = split {
    s0123 -> \ m -> sym (Q-lin-sm r (c t123 m) (c t023 m) (c t013 m) (c t012 m)) } ;

  rd0 : IP.Lin[D,LO.powM Pt Lau,LO.powM Ed Lau] =
    IP.mkLin D (LO.powM Pt Lau) (LO.powM Ed Lau) d0
      (\ c c' -> LO.ext Ed _ _ (d0-add c c')) (\ r c -> LO.ext Ed _ _ (d0-sm r c)) ;
  rd1 : IP.Lin[D,LO.powM Ed Lau,LO.powM Tri Lau] =
    IP.mkLin D (LO.powM Ed Lau) (LO.powM Tri Lau) d1
      (\ c c' -> LO.ext Tri _ _ (d1-add c c')) (\ r c -> LO.ext Tri _ _ (d1-sm r c)) ;
  rd2 : IP.Lin[D,LO.powM Tri Lau,LO.powM Sq Lau] =
    IP.mkLin D (LO.powM Tri Lau) (LO.powM Sq Lau) d2
      (\ c c' -> LO.ext Sq _ _ (d2-add c c')) (\ r c -> LO.ext Sq _ _ (d2-sm r c)) ;

  -- vanishing conditions: a component of d c vanishes where all its terms do
  module VanD (k : Int) {
    module G = Deg[k] ;
    -- Bad at E gives Bad at a face E'
    bf (E' E : Sub4) (le : Le4 E' E) (m : E4) (h : Bad k E m) : Bad k E' m = bad-face k E' E le m h ;
    d0-van (c : Pt -> E4 -> D.R) (v : G.C0.Van c) : G.C1.Van (d0 c) = split {
      e01 -> \ m h -> zero-sub (c p1 m) (c p0 m) (v p1 m (bf (setPt p1) (setEd e01) ok4 m h)) (v p0 m (bf (setPt p0) (setEd e01) ok4 m h)) ;
      e02 -> \ m h -> zero-sub (c p2 m) (c p0 m) (v p2 m (bf (setPt p2) (setEd e02) ok4 m h)) (v p0 m (bf (setPt p0) (setEd e02) ok4 m h)) ;
      e03 -> \ m h -> zero-sub (c p3 m) (c p0 m) (v p3 m (bf (setPt p3) (setEd e03) ok4 m h)) (v p0 m (bf (setPt p0) (setEd e03) ok4 m h)) ;
      e12 -> \ m h -> zero-sub (c p2 m) (c p1 m) (v p2 m (bf (setPt p2) (setEd e12) ok4 m h)) (v p1 m (bf (setPt p1) (setEd e12) ok4 m h)) ;
      e13 -> \ m h -> zero-sub (c p3 m) (c p1 m) (v p3 m (bf (setPt p3) (setEd e13) ok4 m h)) (v p1 m (bf (setPt p1) (setEd e13) ok4 m h)) ;
      e23 -> \ m h -> zero-sub (c p3 m) (c p2 m) (v p3 m (bf (setPt p3) (setEd e23) ok4 m h)) (v p2 m (bf (setPt p2) (setEd e23) ok4 m h)) } ;
    d1-van (c : Ed -> E4 -> D.R) (v : G.C1.Van c) : G.C2.Van (d1 c) = split {
      t012 -> \ m h -> zero-T (c e12 m) (c e02 m) (c e01 m)
        (v e12 m (bf (setEd e12) (setTri t012) ok4 m h)) (v e02 m (bf (setEd e02) (setTri t012) ok4 m h)) (v e01 m (bf (setEd e01) (setTri t012) ok4 m h)) ;
      t013 -> \ m h -> zero-T (c e13 m) (c e03 m) (c e01 m)
        (v e13 m (bf (setEd e13) (setTri t013) ok4 m h)) (v e03 m (bf (setEd e03) (setTri t013) ok4 m h)) (v e01 m (bf (setEd e01) (setTri t013) ok4 m h)) ;
      t023 -> \ m h -> zero-T (c e23 m) (c e03 m) (c e02 m)
        (v e23 m (bf (setEd e23) (setTri t023) ok4 m h)) (v e03 m (bf (setEd e03) (setTri t023) ok4 m h)) (v e02 m (bf (setEd e02) (setTri t023) ok4 m h)) ;
      t123 -> \ m h -> zero-T (c e23 m) (c e13 m) (c e12 m)
        (v e23 m (bf (setEd e23) (setTri t123) ok4 m h)) (v e13 m (bf (setEd e13) (setTri t123) ok4 m h)) (v e12 m (bf (setEd e12) (setTri t123) ok4 m h)) } ;
    d2-van (c : Tri -> E4 -> D.R) (v : G.C2.Van c) : G.C3.Van (d2 c) = split {
      s0123 -> \ m h -> zero-Q (c t123 m) (c t023 m) (c t013 m) (c t012 m)
        (v t123 m (bf (setTri t123) full ok4 m h)) (v t023 m (bf (setTri t023) full ok4 m h))
        (v t013 m (bf (setTri t013) full ok4 m h)) (v t012 m (bf (setTri t012) full ok4 m h)) } ;

    -- finite support, with the same list
    d0-vanish (s : List E4) (c : Pt -> E4 -> D.R) (h : G.C0.Vanish s c) : G.C1.Vanish s (d0 c) = split {
      e01 -> \ m n -> zero-sub (c p1 m) (c p0 m) (h p1 m n) (h p0 m n) ;
      e02 -> \ m n -> zero-sub (c p2 m) (c p0 m) (h p2 m n) (h p0 m n) ;
      e03 -> \ m n -> zero-sub (c p3 m) (c p0 m) (h p3 m n) (h p0 m n) ;
      e12 -> \ m n -> zero-sub (c p2 m) (c p1 m) (h p2 m n) (h p1 m n) ;
      e13 -> \ m n -> zero-sub (c p3 m) (c p1 m) (h p3 m n) (h p1 m n) ;
      e23 -> \ m n -> zero-sub (c p3 m) (c p2 m) (h p3 m n) (h p2 m n) } ;
    d1-vanish (s : List E4) (c : Ed -> E4 -> D.R) (h : G.C1.Vanish s c) : G.C2.Vanish s (d1 c) = split {
      t012 -> \ m n -> zero-T (c e12 m) (c e02 m) (c e01 m) (h e12 m n) (h e02 m n) (h e01 m n) ;
      t013 -> \ m n -> zero-T (c e13 m) (c e03 m) (c e01 m) (h e13 m n) (h e03 m n) (h e01 m n) ;
      t023 -> \ m n -> zero-T (c e23 m) (c e03 m) (c e02 m) (h e23 m n) (h e03 m n) (h e02 m n) ;
      t123 -> \ m n -> zero-T (c e23 m) (c e13 m) (c e12 m) (h e23 m n) (h e13 m n) (h e12 m n) } ;
    d2-vanish (s : List E4) (c : Tri -> E4 -> D.R) (h : G.C2.Vanish s c) : G.C3.Vanish s (d2 c) = split {
      s0123 -> \ m n -> zero-Q (c t123 m) (c t023 m) (c t013 m) (c t012 m) (h t123 m n) (h t023 m n) (h t013 m n) (h t012 m n) } ;

    -- the differential on C^q(k)
    module R0 = LO.Restrict[Pt,Ed,BadI Pt setPt k,BadI Ed setEd k,rd0,\ s -> s,d0-vanish,d0-van] ;
    module R1 = LO.Restrict[Ed,Tri,BadI Ed setEd k,BadI Tri setTri k,rd1,\ s -> s,d1-vanish,d1-van] ;
    module R2 = LO.Restrict[Tri,Sq,BadI Tri setTri k,BadI Sq setSq k,rd2,\ s -> s,d2-vanish,d2-van] ;
  } ;
  D0 (k : Int) : IP.Lin[D,Deg[k].C0.mod,Deg[k].C1.mod] = VanD[k].R0.lin ;
  D1 (k : Int) : IP.Lin[D,Deg[k].C1.mod,Deg[k].C2.mod] = VanD[k].R1.lin ;
  D2 (k : Int) : IP.Lin[D,Deg[k].C2.mod,Deg[k].C3.mod] = VanD[k].R2.lin ;

  ------------------------------------------------------------------------
  -- d d = 0

  -- ((c - b) - (c - a)) + (b - a) = 0
  dd0-shape (a b c : D.R) : Id D.R (D.add (DL.msub (DL.msub c b) (DL.msub c a)) (DL.msub b a)) D.z =
    calc D.R { D.add (DL.msub (DL.msub c b) (DL.msub c a)) (DL.msub b a)
                 =< ap (\ t -> D.add t (DL.msub b a)) (sub-sub-same c a b) > D.add (DL.msub a b) (DL.msub b a)
                 =< ap (D.add (DL.msub a b)) (sym (neg-sub a b)) > D.add (DL.msub a b) (D.neg (DL.msub a b))
                 =< D.addN (DL.msub a b) > D.z } ;
  -- the composite C^1 -> C^3
  dd1-shape (c01 c02 c03 c12 c13 c23 : D.R) :
    Id D.R (DL.msub (D.add (DL.msub (D.add (DL.msub c23 c13) c12) (D.add (DL.msub c23 c03) c02)) (D.add (DL.msub c13 c03) c01))
                    (D.add (DL.msub c12 c02) c01)) D.z =
    calc D.R {
      DL.msub (D.add (DL.msub (D.add (DL.msub c23 c13) c12) (D.add (DL.msub c23 c03) c02)) (D.add (DL.msub c13 c03) c01))
              (D.add (DL.msub c12 c02) c01)
        =< ap (\ t -> DL.msub (D.add t (D.add (DL.msub c13 c03) c01)) (D.add (DL.msub c12 c02) c01))
              (trans (DL.sub-swap (DL.msub c23 c13) c12 (DL.msub c23 c03) c02)
                     (ap (\ t -> D.add t (DL.msub c12 c02)) (sub-sub-same c23 c03 c13)))
        > DL.msub (D.add (D.add (DL.msub c03 c13) (DL.msub c12 c02)) (D.add (DL.msub c13 c03) c01)) (D.add (DL.msub c12 c02) c01)
        =< ap (\ t -> DL.msub t (D.add (DL.msub c12 c02) c01))
              (trans (DL.G.swap (DL.msub c03 c13) (DL.msub c12 c02) (DL.msub c13 c03) c01)
                     (trans (ap (\ t -> D.add t (D.add (DL.msub c12 c02) c01))
                               (trans (ap (D.add (DL.msub c03 c13)) (sym (neg-sub c03 c13))) (D.addN (DL.msub c03 c13))))
                            (DL.G.zl (D.add (DL.msub c12 c02) c01))))
        > DL.msub (D.add (DL.msub c12 c02) c01) (D.add (DL.msub c12 c02) c01)
        =< D.addN (D.add (DL.msub c12 c02) c01) > D.z } ;

  dd0 (c : Pt -> E4 -> D.R) : (j : Tri) (m : E4) -> Id D.R (d1 (d0 c) j m) D.z = split {
    t012 -> \ m -> dd0-shape (c p0 m) (c p1 m) (c p2 m) ;
    t013 -> \ m -> dd0-shape (c p0 m) (c p1 m) (c p3 m) ;
    t023 -> \ m -> dd0-shape (c p0 m) (c p2 m) (c p3 m) ;
    t123 -> \ m -> dd0-shape (c p1 m) (c p2 m) (c p3 m) } ;
  dd1 (c : Ed -> E4 -> D.R) : (j : Sq) (m : E4) -> Id D.R (d2 (d1 c) j m) D.z = split {
    s0123 -> \ m -> dd1-shape (c e01 m) (c e02 m) (c e03 m) (c e12 m) (c e13 m) (c e23 m) } ;

  DD0 (k : Int) (x : Deg[k].C0.El) : Id Deg[k].C2.El ((D1 k).f ((D0 k).f x)) Deg[k].C2.mod.mz =
    Deg[k].C2.eq ((D1 k).f ((D0 k).f x)) Deg[k].C2.mod.mz (dd0 (Deg[k].C0.val x)) ;
  DD1 (k : Int) (x : Deg[k].C1.El) : Id Deg[k].C3.El ((D2 k).f ((D1 k).f x)) Deg[k].C3.mod.mz =
    Deg[k].C3.eq ((D2 k).f ((D1 k).f x)) Deg[k].C3.mod.mz (dd1 (Deg[k].C1.val x)) ;

  ------------------------------------------------------------------------
  -- multiplication by the fixed monomials

  -- f |-> f o s, on raw families: linear by definition
  rsh (I : U l) (s : E4 -> E4) : IP.Lin[D,LO.powM I Lau,LO.powM I Lau] =
    IP.mkLin D (LO.powM I Lau) (LO.powM I Lau) (\ c i m -> c i (s m))
      (\ c c' -> refl (\ i m -> D.add (c i (s m)) (c' i (s m))))
      (\ r c -> refl (\ i m -> D.mul r (c i (s m)))) ;

  module Shift (I : U l) (set : I -> Sub4) (k : Int) {
    module CA = LO.Chart[I, BadI I set k] ;
    module CB = LO.Chart[I, BadI I set (suc3 k)] ;
    van-P (c : I -> E4 -> D.R) (v : CA.Van c) : CB.Van (\ i m -> c i (sh0 m)) =
      \ i m h -> v i (sh0 m) (bad-sh0 k (set i) m h) ;
    van-Q (c : I -> E4 -> D.R) (v : CA.Van c) : CB.Van (\ i m -> c i (sh1 m)) =
      \ i m h -> v i (sh1 m) (bad-sh1 k (set i) m h) ;
    module RP = LO.Restrict[I,I,BadI I set k,BadI I set (suc3 k),rsh I sh0,mapL up0,
      \ s c h -> LO.vanish-shift I sh0 up0 up0-sh0 c s h, van-P] ;
    module RQ = LO.Restrict[I,I,BadI I set k,BadI I set (suc3 k),rsh I sh1,mapL up1,
      \ s c h -> LO.vanish-shift I sh1 up1 up1-sh1 c s h, van-Q] ;
    -- P = X_0^3 and Q = X_1^3 : C(k) -> C(k+3)
    P : IP.Lin[D,CA.mod,CB.mod] = RP.lin ;
    Q : IP.Lin[D,CA.mod,CB.mod] = RQ.lin ;
  } ;

  -- d commutes with the shifts: both sides read c at the shifted exponent
  d0-sh (s : E4 -> E4) (c : Pt -> E4 -> D.R) : (j : Ed) (m : E4) -> Id D.R (d0 (\ i m' -> c i (s m')) j m) (d0 c j (s m)) = split {
    e01 -> \ m -> refl (d0 c e01 (s m)) ; e02 -> \ m -> refl (d0 c e02 (s m)) ; e03 -> \ m -> refl (d0 c e03 (s m)) ;
    e12 -> \ m -> refl (d0 c e12 (s m)) ; e13 -> \ m -> refl (d0 c e13 (s m)) ; e23 -> \ m -> refl (d0 c e23 (s m)) } ;
  d1-sh (s : E4 -> E4) (c : Ed -> E4 -> D.R) : (j : Tri) (m : E4) -> Id D.R (d1 (\ i m' -> c i (s m')) j m) (d1 c j (s m)) = split {
    t012 -> \ m -> refl (d1 c t012 (s m)) ; t013 -> \ m -> refl (d1 c t013 (s m)) ;
    t023 -> \ m -> refl (d1 c t023 (s m)) ; t123 -> \ m -> refl (d1 c t123 (s m)) } ;
  d2-sh (s : E4 -> E4) (c : Tri -> E4 -> D.R) : (j : Sq) (m : E4) -> Id D.R (d2 (\ i m' -> c i (s m')) j m) (d2 c j (s m)) = split {
    s0123 -> \ m -> refl (d2 c s0123 (s m)) } ;
  module Comm (k : Int) {
    module S1 = Shift[Ed,setEd,k] ; module S2 = Shift[Tri,setTri,k] ; module S3 = Shift[Sq,setSq,k] ;
    module H = Deg[suc3 k] ;
    module S0 = Shift[Pt,setPt,k] ;
    d0-P (x : Deg[k].C0.El) : Id H.C1.El ((D0 (suc3 k)).f (S0.P.f x)) (S1.P.f ((D0 k).f x)) =
      H.C1.eq ((D0 (suc3 k)).f (S0.P.f x)) (S1.P.f ((D0 k).f x)) (d0-sh sh0 (Deg[k].C0.val x)) ;
    d0-Q (x : Deg[k].C0.El) : Id H.C1.El ((D0 (suc3 k)).f (S0.Q.f x)) (S1.Q.f ((D0 k).f x)) =
      H.C1.eq ((D0 (suc3 k)).f (S0.Q.f x)) (S1.Q.f ((D0 k).f x)) (d0-sh sh1 (Deg[k].C0.val x)) ;
    d1-P (x : Deg[k].C1.El) : Id H.C2.El ((D1 (suc3 k)).f (S1.P.f x)) (S2.P.f ((D1 k).f x)) =
      H.C2.eq ((D1 (suc3 k)).f (S1.P.f x)) (S2.P.f ((D1 k).f x)) (d1-sh sh0 (Deg[k].C1.val x)) ;
    d1-Q (x : Deg[k].C1.El) : Id H.C2.El ((D1 (suc3 k)).f (S1.Q.f x)) (S2.Q.f ((D1 k).f x)) =
      H.C2.eq ((D1 (suc3 k)).f (S1.Q.f x)) (S2.Q.f ((D1 k).f x)) (d1-sh sh1 (Deg[k].C1.val x)) ;
    d2-P (x : Deg[k].C2.El) : Id H.C3.El ((D2 (suc3 k)).f (S2.P.f x)) (S3.P.f ((D2 k).f x)) =
      H.C3.eq ((D2 (suc3 k)).f (S2.P.f x)) (S3.P.f ((D2 k).f x)) (d2-sh sh0 (Deg[k].C2.val x)) ;
    d2-Q (x : Deg[k].C2.El) : Id H.C3.El ((D2 (suc3 k)).f (S2.Q.f x)) (S3.Q.f ((D2 k).f x)) =
      H.C3.eq ((D2 (suc3 k)).f (S2.Q.f x)) (S3.Q.f ((D2 k).f x)) (d2-sh sh1 (Deg[k].C2.val x)) ;
  } ;
  -- P Q = Q P
  module PQ (I : U l) (set : I -> Sub4) (k : Int) {
    module SA = Shift[I,set,k] ; module SB = Shift[I,set,suc3 k] ;
    comm (x : SA.CA.El) : Id SB.CB.El (SB.Q.f (SA.P.f x)) (SB.P.f (SA.Q.f x)) =
      SB.CB.eq (SB.Q.f (SA.P.f x)) (SB.P.f (SA.Q.f x)) (\ i m -> ap (SA.CA.val x i) (sh-comm m)) ;
  } ;

  -- X_0^(-3) on the fully inverted chart: C^3(k) -> C^3(k-3)
  module Pinv (k : Int) {
    module CA = Deg[k].C3 ; module CB = Deg[pred3 k].C3 ;
    van-up (c : Sq -> E4 -> D.R) (v : CA.Van c) : CB.Van (\ i m -> c i (up0 m)) = split {
      s0123 -> \ m h -> v s0123 (up0 m) (bad-up0 k m h) } ;
    module R = LO.Restrict[Sq,Sq,BadI Sq setSq k,BadI Sq setSq (pred3 k),rsh Sq up0,mapL sh0,
      \ s c h -> LO.vanish-shift Sq up0 sh0 sh0-up0 c s h, van-up] ;
    lin : IP.Lin[D,CA.mod,CB.mod] = R.lin ;
  } ;
} ;
