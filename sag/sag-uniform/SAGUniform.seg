-- The other worker's revised proof, now instantiated with a theorem
-- derived from uniform SQC. There is no separate wn hypothesis.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Main (R : CRing) (setR : Pr.isSet R.R) (loc : Mul[l].Local[R])
 (sqc : Presentations[l].Over[R,setR].SQC) {
 module Certificate = UniformNullstellensatz[l].Over[R,setR,sqc] ;
 module Proof = Mul[l].SAG[R,loc,Certificate.wn-nn] ;
 -- Fact2 says f=0, or f is a unit scalar times a product of positive
 -- powers of pairwise distinct linear factors, coefficientwise.
 lemma-2-2-4 (f : Poly[l].PolyR[R].P) : Roots[l].NN (Proof.Fact2 f) = Proof.lemma-2-2-4-full f ;
} ;
