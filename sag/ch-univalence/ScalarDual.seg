-- Hom_A(M,B) as a B-module, for a homomorphism h:A -> B.
-- Intrinsic and contravariant in M; no chosen basis in this definition.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (h : RingHom[l].Hom A B) {
 module LA = Lines[l].Over[A,setA] ; module FA = LA.FM ;
 module LB = Lines[l].Over[B,setB] ; module FB = LB.FM ;
 module BR = RL[B] ; module A7 = Alg73[l] ;
 -- B with its restricted A-module structure.
 restricted : FA.Module = new A7.Mod[FA.MO.ring,B.R,setB,B.z,B.add,B.neg,
  B.addA,B.addC,B.addZ,B.addN,\ a x -> B.mul (h.1 a) x,
  \ a b x -> trans (B.mulA (h.1 a) (h.1 b) x) (ap (\ c -> B.mul c x) (sym (h.2.2.2 a b))),
  \ x -> trans (ap (\ c -> B.mul c x) h.2.1) (BR.one-left x),
  \ a x y -> B.dist (h.1 a) x y,
  \ a b x -> trans (ap (\ c -> B.mul c x) (h.2.2.1 a b)) (BR.dist-left (h.1 a) (h.1 b) x)] ;
 module At (M : FA.Module) {
  module H = LA.Hom[M,restricted] ;
  sc (b : B.R) (f : H.T) : H.T =
   (\ x -> B.mul b (f.1 x),
    \ x y -> trans (ap (B.mul b) (f.2.1 x y)) (B.dist b (f.1 x) (f.1 y)),
    \ a x -> trans (ap (B.mul b) (f.2.2 a x)) (BR.mul-swap b (h.1 a) (f.1 x))) ;
  mod : FB.Module = new A7.Mod[FB.MO.ring,H.T,H.set,H.hz,H.hadd,H.hneg,
   H.hmod.maddA,H.hmod.maddC,H.hmod.maddZ,H.hmod.maddN,sc,
   \ a b f -> H.eq _ _ (\ x -> B.mulA a b (f.1 x)),
   \ f -> H.eq _ _ (\ x -> BR.one-left (f.1 x)),
   \ a f g -> H.eq _ _ (\ x -> B.dist a (f.1 x) (g.1 x)),
   \ a b f -> H.eq _ _ (\ x -> BR.dist-left a b (f.1 x))] ;
  pre (f : FA.SM.Linear M M) (u : H.T) : H.T =
   (\ x -> u.1 (f.1 x),
    \ x y -> trans (ap u.1 (f.2.1 x y)) (u.2.1 (f.1 x) (f.1 y)),
    \ a x -> trans (ap u.1 (f.2.2 a x)) (u.2.2 a (f.1 x))) ;
  pre-linear (f : FA.SM.Linear M M) : FB.SM.Linear mod mod =
   (pre f,\ u v -> H.eq _ _ (\ x -> refl (B.add (u.1 (f.1 x)) (v.1 (f.1 x)))),
    \ b u -> H.eq _ _ (\ x -> refl (B.mul b (u.1 (f.1 x))))) ;
 } ;
} ;
