-- Endomorphisms with their independently defined pointwise operations.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module LN = Lines[l].Over[A,setA] ;
 module FM = LN.FM ; module SM = LN.SM ;
 module NT = Natural[l].Over[A,setA] ;
 module NA = NCAlgebra[l].Over[A,setA] ;
 module At (M : FM.Module) {
  module H = LN.Hom[M,M] ;
  V : FM.Module = H.hmod ;
  one : H.T = (\ x -> x,\ x y -> refl (M.madd x y),\ a x -> refl (M.sm a x)) ;
  mul (f g : H.T) : H.T = NT.comp M M M f g ;
  algebra : NA.Algebra = new NA.Algebra[H.T,H.set,H.hz,H.hadd,H.hneg,H.hsc,one,mul,
   V.maddA,V.maddC,V.maddZ,V.maddN,V.smO,V.smA,V.smD,V.smE,
   \ f g h -> H.eq _ _ (\ x -> refl (f.1 (g.1 (h.1 x)))),
   \ f -> H.eq _ _ (\ x -> refl (f.1 x)),
   \ f -> H.eq _ _ (\ x -> refl (f.1 x)),
   \ f g h -> H.eq _ _ (\ x -> f.2.1 (g.1 x) (h.1 x)),
   \ f g h -> H.eq _ _ (\ x -> refl (M.madd (f.1 (h.1 x)) (g.1 (h.1 x)))),
   \ a f g -> H.eq _ _ (\ x -> refl (M.sm a (f.1 (g.1 x)))),
   \ a f g -> H.eq _ _ (\ x -> f.2.2 a (g.1 x))] ;
 } ;
} ;
