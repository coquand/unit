-- Explicit rank-two characteristic polynomial, with arbitrary entries.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Arithmetic (R0 : CRing) {
 open R0 ; module L = RL[R0] ;
 both-neg (a b : R) : Id R (mul (neg a) (neg b)) (mul a b) =
  trans (L.neg-mul-left a (neg b)) (trans (ap neg (L.mul-neg a b)) (L.neg-neg (mul a b))) ;
 product (t a d : R) : Id R (mul (add t a) (add t d)) (add (mul a d) (mul t (add (add a d) t))) =
  calc R {
   mul (add t a) (add t d)
    =< Ps.cong2 R mul _ _ _ _ (addC t a) (addC t d) > mul (add a t) (add d t)
    =< dist (add a t) d t > add (mul (add a t) d) (mul (add a t) t)
    =< Ps.cong2 R add _ _ _ _ (L.dist-left a t d) (L.dist-left a t t) > add (add (mul a d) (mul t d)) (add (mul a t) (mul t t))
    =< sym (addA (mul a d) (mul t d) (add (mul a t) (mul t t))) > add (mul a d) (add (mul t d) (add (mul a t) (mul t t)))
    =< ap (add (mul a d)) (L.add-swap (mul t d) (mul a t) (mul t t)) > add (mul a d) (add (mul a t) (add (mul t d) (mul t t)))
    =< ap (\ x -> add (mul a d) (add x (add (mul t d) (mul t t)))) (mulC a t) > add (mul a d) (add (mul t a) (add (mul t d) (mul t t)))
    =< ap (add (mul a d)) (addA (mul t a) (mul t d) (mul t t)) > add (mul a d) (add (add (mul t a) (mul t d)) (mul t t))
    =< ap (\ x -> add (mul a d) (add x (mul t t))) (sym (dist t a d)) > add (mul a d) (add (mul t (add a d)) (mul t t))
    =< ap (add (mul a d)) (sym (dist t (add a d) t)) > add (mul a d) (mul t (add (add a d) t)) } ;
 quadratic (t a d k : R) : Id R (add (mul (add t a) (add t d)) k)
  (add (add (mul a d) k) (mul t (add (add a d) t))) =
  trans (ap (\ x -> add x k) (product t a d))
   (trans (sym (addA (mul a d) (mul t (add (add a d) t)) k))
    (trans (ap (add (mul a d)) (addC (mul t (add (add a d) t)) k))
     (addA (mul a d) k (mul t (add (add a d) t))))) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 open A ; module L = RL[A] ;
 module CP = CharPoly[l].Over[A,setA] ; module B = CP.B ; module BL = RL[B.ring] ;
 module EA = ExteriorModel[l].Over[A] ; module EB = ExteriorModel[l].Over[B.ring] ;
 module AR = Arithmetic[A] ; module AB = Arithmetic[B.ring] ;
 one : Nat = suc zero ; two : Nat = suc one ;
 i0 : Ps.Fin two = inl (inr tt) ; i1 : Ps.Fin two = inr tt ;
 one-index : (i : Ps.Fin one) -> Id (Ps.Fin one) i (inr tt) = split {
  inl e -> efq e ; inr t -> ap (\ s -> inr s) (MnSums[l].top-eq t tt) } ;
 two-ind (P : Ps.Fin two -> U l) (p0 : P i0) (p1 : P i1) : (i : Ps.Fin two) -> P i = split {
  inl k -> subst (\ j -> P (inl j)) (sym (one-index k)) p0 ;
  inr t -> subst (\ s -> P (inr s)) (sym (MnSums[l].top-eq t tt)) p1 } ;
 diag (a : R) : Id B.Carrier (B.addQ (B.mulQ B.variable (B.constant o)) (B.constant (neg a))) (B.addQ B.variable (B.constant (neg a))) =
  ap (\ x -> B.addQ x (B.constant (neg a))) (B.ring.mulO B.variable) ;
 off (a : R) : Id B.Carrier (B.addQ (B.mulQ B.variable (B.constant z)) (B.constant (neg a))) (B.constant (neg a)) =
  trans (ap (\ x -> B.addQ x (B.constant (neg a)))
   (trans (ap (B.mulQ B.variable) (RingHom[l].zero A B.ring B.inclusion)) (BL.mul-zero B.variable)))
    (BL.zl (B.constant (neg a))) ;
 module At (u v w z0 : R) {
  a : CP.DT.Mat two = EA.mat2 u v w z0 ;
  du : B.Carrier = B.addQ B.variable (B.constant (neg u)) ;
  dz : B.Carrier = B.addQ B.variable (B.constant (neg z0)) ;
  matrix : Ps.Fin two -> Ps.Fin two -> B.Carrier = EB.mat2 du (B.constant (neg v)) (B.constant (neg w)) dz ;
  entry : (j i : Ps.Fin two) -> Id B.Carrier (CP.charmat two a j i) (matrix j i) =
   two-ind (\ j -> (i : Ps.Fin two) -> Id B.Carrier (CP.charmat two a j i) (matrix j i))
    (two-ind (\ i -> Id B.Carrier (CP.charmat two a i0 i) (matrix i0 i)) (diag u) (off w))
    (two-ind (\ i -> Id B.Carrier (CP.charmat two a i1 i) (matrix i1 i)) (off v) (diag z0)) ;
  matrix-eq : Id (Ps.Fin two -> Ps.Fin two -> B.Carrier) (CP.charmat two a) matrix =
   FE.funext (Ps.Fin two) (\ j -> Ps.Fin two -> B.Carrier) (CP.charmat two a) matrix
    (\ j -> FE.funext (Ps.Fin two) (\ i -> B.Carrier) (CP.charmat two a j) (matrix j) (entry j)) ;
  trace : R = add u z0 ;
  determinant : R = add (mul u z0) (neg (mul v w)) ;
  polynomial : B.Carrier = B.addQ (B.constant determinant) (B.mulQ B.variable (B.addQ (B.constant (neg trace)) B.variable)) ;
  neg-product (x y : R) : Id B.Carrier (B.mulQ (B.constant (neg x)) (B.constant (neg y))) (B.constant (mul x y)) =
   trans (sym (B.constant-mul (neg x) (neg y))) (ap B.constant (AR.both-neg x y)) ;
  constant-term : Id B.Carrier
   (B.addQ (B.mulQ (B.constant (neg u)) (B.constant (neg z0))) (B.negQ (B.mulQ (B.constant (neg v)) (B.constant (neg w)))))
   (B.constant determinant) =
   trans (Ps.cong2 B.Carrier B.addQ _ _ _ _ (neg-product u z0)
    (trans (ap B.negQ (neg-product v w)) (sym (RingHom[l].negation A B.ring B.inclusion (mul v w)))))
    (sym (B.constant-add (mul u z0) (neg (mul v w)))) ;
  linear-term : Id B.Carrier (B.addQ (B.constant (neg u)) (B.constant (neg z0))) (B.constant (neg trace)) =
   trans (sym (B.constant-add (neg u) (neg z0))) (ap B.constant (sym (L.neg-add u z0))) ;
  formula : Id B.Carrier (CP.char two a) polynomial =
   trans (ap (EB.det two) matrix-eq)
    (trans (EB.det2-formula du (B.constant (neg v)) (B.constant (neg w)) dz)
     (trans (AB.quadratic B.variable (B.constant (neg u)) (B.constant (neg z0)) (B.negQ (B.mulQ (B.constant (neg v)) (B.constant (neg w)))))
      (Ps.cong2 B.Carrier B.addQ _ _ _ _ constant-term
       (ap (\ x -> B.mulQ B.variable (B.addQ x B.variable)) linear-term)))) ;
 } ;
} ;
