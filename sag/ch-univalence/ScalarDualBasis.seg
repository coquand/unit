-- A basis of M induces a B-basis of Hom_A(M,B), by evaluation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (h : RingHom[l].Hom A B) {
 module SD = ScalarDual[l].Over[A,B,setA,setB,h] ; module FA = SD.FA ; module FB = SD.FB ;
 module AD = MnSums[l].Over[A] ; module BD = MnSums[l].Over[B] ; module S = BD.S ; module BR = SD.BR ;
 module ED = SD.LA.ED ;
 delta-map : (n : Nat) (i j : Ps.Fin n) -> Id B.R (h.1 (AD.delta n i j)) (BD.delta n i j) = split {
  zero -> \ i j -> RingHom[l].zero A B h ;
  suc n | ih -> split {
   inl i -> split { inl j -> ih i j ; inr t -> RingHom[l].zero A B h } ;
   inr t -> split { inl j -> RingHom[l].zero A B h ; inr u -> h.2.1 } } } ;
 module Basis (M : FA.Module) (n : Nat) (e : FA.MS.LinEquiv M (FA.Free n)) {
  module D = SD.At[M] ; module I = ED.Inv[M,FA.Free n,e] ;
  vec (j : Ps.Fin n) : M.M = I.inv (FA.basis n j) ;
  coords (u : D.H.T) : FB.MX.Vec n = \ j -> u.1 (vec j) ;
  value (v : FB.MX.Vec n) (x : M.M) : B.R = S.sum n (\ j -> B.mul (h.1 (e.1.1 x j)) (v j)) ;
  make (v : FB.MX.Vec n) : D.H.T =
   (value v,
    \ x y -> trans (S.sum-cong n (\ j -> B.mul (h.1 (e.1.1 (M.madd x y) j)) (v j))
       (\ j -> B.add (B.mul (h.1 (e.1.1 x j)) (v j)) (B.mul (h.1 (e.1.1 y j)) (v j)))
       (\ j -> trans (ap (\ a -> B.mul (h.1 a) (v j)) (ap (\ w -> w j) (e.2.1 x y)))
        (trans (ap (\ a -> B.mul a (v j)) (h.2.2.1 (e.1.1 x j) (e.1.1 y j)))
         (BR.dist-left (h.1 (e.1.1 x j)) (h.1 (e.1.1 y j)) (v j)))))
      (S.sum-add n (\ j -> B.mul (h.1 (e.1.1 x j)) (v j)) (\ j -> B.mul (h.1 (e.1.1 y j)) (v j))),
    \ a x -> trans (S.sum-cong n (\ j -> B.mul (h.1 (e.1.1 (M.sm a x) j)) (v j))
       (\ j -> B.mul (h.1 a) (B.mul (h.1 (e.1.1 x j)) (v j)))
       (\ j -> trans (ap (\ b -> B.mul (h.1 b) (v j)) (ap (\ w -> w j) (e.2.2 a x)))
        (trans (ap (\ b -> B.mul b (v j)) (h.2.2.2 a (e.1.1 x j)))
         (sym (B.mulA (h.1 a) (h.1 (e.1.1 x j)) (v j))))))
      (S.sum-scale (h.1 a) n (\ j -> B.mul (h.1 (e.1.1 x j)) (v j)))) ;
  veq (v w : FB.MX.Vec n) (p : (j : Ps.Fin n) -> Id B.R (v j) (w j)) : Id (FB.MX.Vec n) v w =
   FE.funext (Ps.Fin n) (\ j -> B.R) v w p ;
  coords-make (v : FB.MX.Vec n) : Id (FB.MX.Vec n) (coords (make v)) v =
   veq _ _ (\ i -> trans (S.sum-cong n (\ j -> B.mul (h.1 (e.1.1 (vec i) j)) (v j))
     (\ j -> B.mul (BD.delta n i j) (v j))
     (\ j -> ap (\ b -> B.mul b (v j)) (trans (ap h.1 (ap (\ w -> w j) (I.inv-eq (FA.basis n i)))) (delta-map n i j))))
    (BD.sum-delta n i v)) ;
  restricted-sum : (k : Nat) (v : Ps.Fin k -> B.R) ->
   Id B.R (FA.T64.msum SD.restricted k v) (S.sum k v) = split {
    zero -> \ v -> refl B.z ; suc k | ih -> \ v -> ap (B.add (v (inr tt))) (ih (\ i -> v (inl i))) } ;
  module Expand (u : D.H.T) {
   lin : FA.SM.Linear (FA.Free n) SD.restricted =
    (\ v -> u.1 (I.inv v),
     \ x y -> trans (ap u.1 (I.inv-add x y)) (u.2.1 (I.inv x) (I.inv y)),
     \ a x -> trans (ap u.1 (I.inv-scale a x)) (u.2.2 a (I.inv x))) ;
   at (x : M.M) : Id B.R (u.1 x) (value (coords u) x) =
    trans (sym (ap u.1 (I.ret-eq x)))
     (trans (ap lin.1 (FA.expand n (e.1.1 x)))
      (trans (FA.lin-msum (FA.Free n) SD.restricted lin n (\ j -> (FA.Free n).sm (e.1.1 x j) (FA.basis n j)))
       (trans (restricted-sum n (\ j -> lin.1 ((FA.Free n).sm (e.1.1 x j) (FA.basis n j))))
        (S.sum-cong n (\ j -> lin.1 ((FA.Free n).sm (e.1.1 x j) (FA.basis n j)))
          (\ j -> B.mul (h.1 (e.1.1 x j)) (u.1 (vec j))) (\ j -> lin.2.2 (e.1.1 x j) (FA.basis n j)))))) ;
  } ;
  make-coords (u : D.H.T) : Id D.H.T (make (coords u)) u = D.H.eq _ _ (\ x -> sym (Expand[u].at x)) ;
  equiv : FB.MS.LinEquiv D.mod (FB.Free n) =
   ((coords,Pr.qinv D.H.T (FB.MX.Vec n) coords make coords-make make-coords),
    \ u v -> refl (coords (D.H.hadd u v)),\ b u -> refl (coords (D.sc b u))) ;
  -- The dual coordinate vector evaluates to h(the corresponding coordinate).
  dual-value (j : Ps.Fin n) (x : M.M) :
   Id B.R ((make (FB.basis n j)).1 x) (h.1 (e.1.1 x j)) =
   trans (S.sum-cong n (\ k -> B.mul (h.1 (e.1.1 x k)) (BD.delta n j k))
     (\ k -> B.mul (h.1 (e.1.1 x k)) (BD.delta n k j))
     (\ k -> ap (B.mul (h.1 (e.1.1 x k))) (BD.delta-sym n j k)))
    (BD.sum-delta-right n j (\ k -> h.1 (e.1.1 x k))) ;
 } ;
} ;
