-- Join the independent determinant definition to the SIP-transported theorem.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module IC = IntrinsicCharPoly[l].Over[A,setA] ; module FA = IC.FA ;
 module PK = CHPackageTransport[l].Over[A,setA] ;
 module EN = IC.EN ;
 module At (M : FA.Module) (n : Nat) (bM : FA.FinFree M n) (f : FA.SM.Linear M M) {
  module IP = IC.At[M,n,bM,f] ; module E = EN.At[M] ;
  module Basis (e : FA.MS.LinEquiv M (FA.Free n)) {
   module I = IC.SB.ED.Inv[M,FA.Free n,e] ;
   inverse : FA.MS.LinEquiv (FA.Free n) M =
    ((I.inv,Pr.qinv (FA.Free n).M M.M I.inv e.1.1 I.ret-eq I.inv-eq),I.inv-add,I.inv-scale) ;
   module CHN = EndCayleyHamilton[l].Over[A,setA,n] ;
   module CH = CHN.WithBasis[M,inverse] ;
   module CO = IP.Coordinates[e] ;
   -- The inverse equivalences in the assembled coordinate map compute.
   coordinates : Id PK.B.Carrier (CHN.MC.chi (CH.matrix f)) (IC.CP.char n CO.a) = refl (IC.CP.char n CO.a) ;
   transported-polynomial : Id PK.B.Carrier (CH.chi f) IP.chi =
    trans (CH.chi-coordinates f) (trans coordinates (sym CO.comparison)) ;
   theorem : PK.V.Root E.algebra f IP.chi =
    subst (\ p -> PK.V.Root E.algebra f p) transported-polynomial (CH.cayley-hamilton f) ;
  } ;
  cayley-hamilton : PK.V.Root E.algebra f IP.chi =
   TC.rec (FA.MS.LinEquiv M (FA.Free n)) @l (PK.V.Root E.algebra f IP.chi)
    (E.H.set _ _) (\ e -> Basis[e].theorem) bM ;
  on-vector (x : M.M) : Id M.M ((PK.V.ev E.algebra f IP.chi).1 x) M.mz =
   ap (\ u -> u.1 x) cayley-hamilton ;
  basis-independent (e e' : FA.MS.LinEquiv M (FA.Free n)) :
   Id PK.B.Carrier (IC.CP.char n IP.Coordinates[e].a) (IC.CP.char n IP.Coordinates[e'].a) =
   trans (sym IP.Coordinates[e].comparison) IP.Coordinates[e'].comparison ;
 } ;
} ;
