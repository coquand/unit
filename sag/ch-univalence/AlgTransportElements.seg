-- Public computation of SIP on elements, without unfolding sip.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module S = AlgSIP[l].Over[A,setA] ; module SU = AlgSIPUA[l].Over[A,setA] ;
 carrier (E : S.Alg) : U l = E.A ;
 move (E F : S.Alg) (s : Id S.Alg E F) (t : E.A) : F.A =
  Hi.subst S.Alg (\ G -> G.A) E F s t ;
 move-iso (E F : S.Alg) (s : Id S.Alg E F) (t : E.A) :
  Id F.A (move E F s t) ((SU.idToIso E F s).1.1 t) =
  idJ S.Alg E (\ G q -> (x : E.A) -> Id G.A (move E G q x) ((SU.idToIso E G q).1.1 x))
   (\ x -> refl x) F s t ;
 on-element (E F : S.Alg) (phi : S.AlgIso E F) (t : E.A) :
  Id F.A (move E F (SU.sip E F phi) t) (phi.1.1 t) =
  trans (move-iso E F (SU.sip E F phi) t)
   (ap (\ u -> u.1.1 t) (SU.idToIso-sip E F phi)) ;
 on-zero (E F : S.Alg) (s : Id S.Alg E F) : Id F.A (move E F s E.zero) F.zero =
  idJ S.Alg E (\ G q -> Id G.A (move E G q E.zero) G.zero) (refl E.zero) F s ;
} ;
