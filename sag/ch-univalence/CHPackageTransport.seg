-- Transport a function choosing annihilators, together with its theorem.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module V = PolyEvalTransport[l].Over[A,setA] ; module T = V.T ; module S = V.S ; module SU = V.SU ; module B = V.B ;
 Package (E : S.Alg) : U l = (c : E.A -> B.Carrier) * ((t : E.A) -> V.Root E t (c t)) ;
 along (E F : S.Alg) (s : Id S.Alg E F) (c : Package E) : Package F =
  Hi.subst S.Alg (\ G -> Package G) E F s c ;
 path-value (E F : S.Alg) (s : Id S.Alg E F) (c : Package E) (t : E.A) :
  Id B.Carrier ((along E F s c).1 (T.move E F s t)) (c.1 t) =
  idJ S.Alg E (\ G q -> Id B.Carrier ((along E G q c).1 (T.move E G q t)) (c.1 t))
   (refl (c.1 t)) F s ;
 via-sip (E F : S.Alg) (phi : S.AlgIso E F) (c : Package E) : Package F =
  along E F (SU.sip E F phi) c ;
 sip-value (E F : S.Alg) (phi : S.AlgIso E F) (c : Package E) (t : E.A) :
  Id B.Carrier ((via-sip E F phi c).1 (phi.1.1 t)) (c.1 t) =
  trans (sym (ap (via-sip E F phi c).1 (T.on-element E F phi t)))
   (path-value E F (SU.sip E F phi) c t) ;
 inverse-value (E F : S.Alg) (phi : S.AlgIso E F) (c : Package E) (f : F.A) :
  Id B.Carrier ((via-sip E F phi c).1 f) (c.1 (phi.1.2.sec f)) =
  trans (sym (ap (via-sip E F phi c).1 (phi.1.2.sec-eq f)))
   (sip-value E F phi c (phi.1.2.sec f)) ;
 module Matrix (n : Nat) {
  module MA = MnAlgebra[l].Over[A,setA,n] ;
  module CP = CharPoly[l].Over[A,setA] ;
  chi (b : MA.Mat) : B.Carrier = CP.char n (\ j i -> b i j) ;
  theorem (b : MA.Mat) : V.Root MA.algebra b (chi b) =
   MatrixCayleyHamilton[l].Over[A,setA,n,\ j i -> b i j].cayley-hamilton ;
  package : Package MA.algebra = (chi,theorem) ;
 } ;
} ;
