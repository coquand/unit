-- Composing and reversing algebra isomorphisms, through their public laws.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module S = AlgSIP[l].Over[A,setA] ;
 comp (E F G : S.Alg) (phi : S.AlgIso E F) (psi : S.AlgIso F G) : S.AlgIso E G =
  (Equivalences[l].compose E.A F.A G.A phi.1 psi.1,
   \ x y -> trans (ap psi.1.1 (phi.2.1 x y)) (psi.2.1 (phi.1.1 x) (phi.1.1 y)),
   \ a x -> trans (ap psi.1.1 (phi.2.2.1 a x)) (psi.2.2.1 a (phi.1.1 x)),
   \ x y -> trans (ap psi.1.1 (phi.2.2.2.1 x y)) (psi.2.2.2.1 (phi.1.1 x) (phi.1.1 y)),
   trans (ap psi.1.1 phi.2.2.2.2) psi.2.2.2.2) ;
 module Inverse (E F : S.Alg) (phi : S.AlgIso E F) {
  f : E.A -> F.A = phi.1.1 ;
  g : F.A -> E.A = phi.1.2.sec ;
  fg (y : F.A) : Id F.A (f (g y)) y = phi.1.2.sec-eq y ;
  gf (x : E.A) : Id E.A (g (f x)) x = Pr.sec-ret E.A F.A f phi.1.2 x ;
  inj (x y : E.A) : Id F.A (f x) (f y) -> Id E.A x y = Equivalences[l].injective E.A F.A f phi.1.2 x y ;
  equiv : Pr.Equiv F.A E.A = (g,Pr.qinv F.A E.A g f gf fg) ;
  hom : S.Hom F E g =
   (\ x y -> inj _ _ (trans (fg (F.add x y))
      (sym (trans (phi.2.1 (g x) (g y)) (Presentations[l].cong2 F.A F.add _ _ _ _ (fg x) (fg y))))),
    \ a x -> inj _ _ (trans (fg (F.scale a x))
      (sym (trans (phi.2.2.1 a (g x)) (ap (F.scale a) (fg x))))),
    \ x y -> inj _ _ (trans (fg (F.mul x y))
      (sym (trans (phi.2.2.2.1 (g x) (g y)) (Presentations[l].cong2 F.A F.mul _ _ _ _ (fg x) (fg y))))),
    inj _ _ (trans (fg F.one) (sym phi.2.2.2.2))) ;
  iso : S.AlgIso F E = (equiv,hom) ;
 } ;
} ;
