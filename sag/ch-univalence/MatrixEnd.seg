-- The coordinate isomorphism: columns are images of basis vectors.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 open A ; module L = RL[A] ;
 module EN = EndAlgebra[l].Over[A,setA] ; module FM = EN.FM ;
 module MX = FM.MX ; module S = MX.S ;
 module MA = MnAlgebra[l].Over[A,setA,n] ;
 module E = EN.At[FM.Free n] ;
 module IS = AlgIsoOps[l].Over[A,setA] ;
 module D = MnSums[l].Over[A] ;
 V : U l = MX.Vec n ;
 veq (u v : V) (h : (i : Ps.Fin n) -> Id R (u i) (v i)) : Id V u v = FE.funext (Ps.Fin n) (\ i -> R) u v h ;
 coord (f : E.H.T) : MA.Mat = \ i j -> f.1 (FM.basis n j) i ;
 act (b : MA.Mat) : E.H.T =
  (MX.apply n n (\ j i -> b i j),
   \ u v -> veq _ _ (\ i -> trans
    (S.sum-cong n (\ j -> mul (add (u j) (v j)) (b i j)) (\ j -> add (mul (u j) (b i j)) (mul (v j) (b i j))) (\ j -> L.dist-left (u j) (v j) (b i j)))
    (S.sum-add n (\ j -> mul (u j) (b i j)) (\ j -> mul (v j) (b i j)))),
   \ c u -> veq _ _ (\ i -> MX.apply-scale n n (\ j k -> b k j) c u i)) ;
 coord-act (b : MA.Mat) : Id MA.Mat (coord (act b)) b =
  MA.mat-eq _ _ (\ i j -> D.sum-delta n j (\ k -> b i k)) ;
 act-coord (f : E.H.T) : Id E.H.T (act (coord f)) f =
  E.H.eq _ _ (\ v -> veq _ _ (\ i -> sym (FM.apply-mat n n f v i))) ;
 coord-equiv : Pr.Equiv E.H.T MA.Mat = (coord,Pr.qinv E.H.T MA.Mat coord act coord-act act-coord) ;
 coord-mul (f g : E.H.T) : Id MA.Mat (coord (E.mul f g)) (MA.mmul (coord f) (coord g)) =
  MA.mat-eq _ _ (\ i j -> trans (FM.apply-mat n n f (g.1 (FM.basis n j)) i)
    (S.sum-cong n (\ k -> mul (g.1 (FM.basis n j) k) (f.1 (FM.basis n k) i)) (\ k -> mul (f.1 (FM.basis n k) i) (g.1 (FM.basis n j) k)) (\ k -> mulC (g.1 (FM.basis n j) k) (f.1 (FM.basis n k) i)))) ;
 coord-one : Id MA.Mat (coord E.one) MA.mone = MA.mat-eq _ _ (\ i j -> D.delta-sym n j i) ;
 to-matrix : IS.S.AlgIso E.algebra MA.algebra =
  (coord-equiv,\ f g -> refl (coord (E.H.hadd f g)),\ c f -> refl (coord (E.H.hsc c f)),coord-mul,coord-one) ;
 module Back = IS.Inverse[E.algebra,MA.algebra,to-matrix] ;
 to-end : IS.S.AlgIso MA.algebra E.algebra = Back.iso ;
} ;
