-- Evaluation is a dependent construction on pointed algebras.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module T = AlgTransportElements[l].Over[A,setA] ; module S = T.S ; module SU = T.SU ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 ev (E : S.Alg) (t : E.A) (p : B.Carrier) : E.A = PolyEval[l].Over[A,setA,E,t].evaluate p ;
 path-eval (E F : S.Alg) (s : Id S.Alg E F) (t : E.A) (p : B.Carrier) :
  Id F.A (T.move E F s (ev E t p)) (ev F (T.move E F s t) p) =
  idJ S.Alg E (\ G q -> Id G.A (T.move E G q (ev E t p)) (ev G (T.move E G q t) p))
   (refl (ev E t p)) F s ;
 sip-eval (E F : S.Alg) (phi : S.AlgIso E F) (t : E.A) (p : B.Carrier) :
  Id F.A (T.move E F (SU.sip E F phi) (ev E t p)) (ev F (phi.1.1 t) p) =
  trans (path-eval E F (SU.sip E F phi) t p)
   (ap (\ x -> ev F x p) (T.on-element E F phi t)) ;
 Root (E : S.Alg) (t : E.A) (p : B.Carrier) : U l = Id E.A (ev E t p) E.zero ;
 path-root (E F : S.Alg) (s : Id S.Alg E F) (t : E.A) (p : B.Carrier) :
  Root E t p -> Root F (T.move E F s t) p =
  idJ S.Alg E (\ G q -> Root E t p -> Root G (T.move E G q t) p) (\ h -> h) F s ;
 sip-root (E F : S.Alg) (phi : S.AlgIso E F) (t : E.A) (p : B.Carrier) (h : Root E t p) :
  Root F (phi.1.1 t) p =
  subst (\ x -> Root F x p) (T.on-element E F phi t) (path-root E F (SU.sip E F phi) t p h) ;
} ;
