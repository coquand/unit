-- Conjugation of independently defined endomorphism algebras.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module EN = EndAlgebra[l].Over[A,setA] ; module FM = EN.FM ;
 module NT = EN.NT ; module ED = EN.LN.ED ; module MS = FM.MS ;
 module S = AlgSIP[l].Over[A,setA] ;
 module At (M N : FM.Module) (e : MS.LinEquiv M N) {
  module SrcE = EN.At[M] ; module ENd = EN.At[N] ;
  module I = ED.Inv[M,N,e] ;
  module H = NT.HomIso[M,N,M,N,e,e] ;
  product (f g : SrcE.H.T) : Id ENd.H.T (H.fun (SrcE.mul f g)) (ENd.mul (H.fun f) (H.fun g)) =
   ENd.H.eq _ _ (\ x -> sym (ap (\ v -> e.1.1 (f.1 v)) (I.ret-eq (g.1 (I.inv x))))) ;
  unit : Id ENd.H.T (H.fun SrcE.one) ENd.one = ENd.H.eq _ _ I.inv-eq ;
  iso : S.AlgIso SrcE.algebra ENd.algebra = (H.equiv.1,H.map.2.1,H.map.2.2,product,unit) ;
 } ;
} ;
