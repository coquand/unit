-- The intrinsic characteristic polynomial is invariant under conjugation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module IC = IntrinsicCharPoly[l].Over[A,setA] ; module FA = IC.FA ;
 module ED = IC.SB.ED ; module CJ = EndConjugation[l].Over[A,setA] ;
 module At (M N : FA.Module) (n : Nat) (bM : FA.FinFree M n) (bN : FA.FinFree N n)
  (j : FA.MS.LinEquiv M N) (f : FA.SM.Linear M M) {
  module J = ED.Inv[M,N,j] ; module C = CJ.At[M,N,j] ;
  module P = IC.At[M,n,bM,f] ; module Q = IC.At[N,n,bN,C.H.fun f] ;
  module Basis (e : FA.MS.LinEquiv M (FA.Free n)) {
   module I = ED.Inv[M,FA.Free n,e] ;
   forward (y : N.M) : (FA.Free n).M = e.1.1 (J.inv y) ;
   backward (x : (FA.Free n).M) : N.M = j.1.1 (I.inv x) ;
   fb (x : (FA.Free n).M) : Id (FA.Free n).M (forward (backward x)) x =
    trans (ap e.1.1 (J.ret-eq (I.inv x))) (I.inv-eq x) ;
   bf (y : N.M) : Id N.M (backward (forward y)) y =
    trans (ap j.1.1 (I.ret-eq (J.inv y))) (J.inv-eq y) ;
   basisN : FA.MS.LinEquiv N (FA.Free n) =
    ((forward,Pr.qinv N.M (FA.Free n).M forward backward fb bf),
     \ x y -> trans (ap e.1.1 (J.inv-add x y)) (e.2.1 (J.inv x) (J.inv y)),
     \ a x -> trans (ap e.1.1 (J.inv-scale a x)) (e.2.2 a (J.inv x))) ;
   module PC = P.Coordinates[e] ; module QC = Q.Coordinates[basisN] ;
   entry (k i : Presentations[l].Fin n) : Id A.R (QC.a k i) (PC.a k i) =
    trans (ap (\ v -> e.1.1 v i) (J.ret-eq (f.1 (J.inv (j.1.1 (I.inv (FA.basis n k)))))))
     (ap (\ v -> e.1.1 (f.1 v) i) (J.ret-eq (I.inv (FA.basis n k)))) ;
   matrices : Id (IC.CP.DT.Mat n) QC.a PC.a =
    FE.funext (Presentations[l].Fin n) (\ k -> Presentations[l].Fin n -> A.R) QC.a PC.a
     (\ k -> FE.funext (Presentations[l].Fin n) (\ i -> A.R) (QC.a k) (PC.a k) (entry k)) ;
   result : Id IC.B.Carrier Q.chi P.chi =
    trans QC.comparison (trans (ap (IC.CP.char n) matrices) (sym PC.comparison)) ;
  } ;
  natural : Id IC.B.Carrier Q.chi P.chi =
   TC.rec (FA.MS.LinEquiv M (FA.Free n)) @l (Id IC.B.Carrier Q.chi P.chi) (IC.B.set _ _)
    (\ e -> Basis[e].result) bM ;
 } ;
} ;
