-- Boundary ranks, a symbolic non-symmetric matrix, and a shear of bases.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 open A ; module L = RL[A] ;
 module PK = CHPackageTransport[l].Over[A,setA] ; module B = PK.B ;
 module QP = QuadraticPolynomial[l].Over[A,setA] ;
 module CP = CharPoly[l].Over[A,setA] ; module EB = ExteriorModel[l].Over[B.ring] ;
 module EN = EndAlgebra[l].Over[A,setA] ; module FM = EN.FM ;
 module ZeroRank {
  module MC = PK.Matrix[zero] ;
  empty : MC.MA.Mat = \ i -> efq i ;
  polynomial : Id B.Carrier (MC.chi empty) B.oneQ = refl B.oneQ ;
  module ME = MatrixEnd[l].Over[A,setA,zero] ;
  module EV = PolyEval[l].Over[A,setA,ME.E.algebra,ME.to-end.1.1 empty] ;
  root : PK.V.Root ME.E.algebra (ME.to-end.1.1 empty) B.oneQ =
   subst (\ p -> PK.V.Root ME.E.algebra (ME.to-end.1.1 empty) p) polynomial
    (PK.V.sip-root MC.MA.algebra ME.E.algebra ME.to-end empty (MC.chi empty) (MC.theorem empty)) ;
  identity-zero : Id ME.E.H.T ME.E.one ME.E.H.hz = trans (sym EV.preserves-one) root ;
 } ;
 module OneRank (c : R) {
  module MC = PK.Matrix[QP.one] ;
  b : MC.MA.Mat = \ i j -> c ;
  polynomial : Id B.Carrier (MC.chi b) (B.addQ B.variable (B.constant (neg c))) =
   trans (EB.clean-id (CP.charmat QP.one (\ j i -> c) (inr tt) (inr tt))) (QP.diag c) ;
  module ME = MatrixEnd[l].Over[A,setA,QP.one] ;
  root : PK.V.Root ME.E.algebra (ME.to-end.1.1 b) (B.addQ B.variable (B.constant (neg c))) =
   subst (\ p -> PK.V.Root ME.E.algebra (ME.to-end.1.1 b) p) polynomial
    (PK.V.sip-root MC.MA.algebra ME.E.algebra ME.to-end b (MC.chi b) (MC.theorem b)) ;
 } ;
 module TwoRank (u v w z0 : R) (M : FM.Module) (e : FM.MS.LinEquiv (FM.Free QP.two) M) {
  module Q = QP.At[u,v,w,z0] ;
  module CHN = EndCayleyHamilton[l].Over[A,setA,QP.two] ; module CH = CHN.WithBasis[M,e] ;
  matrix : CHN.ME.MA.Mat = \ i j -> Q.a j i ;
  f : CH.E.H.T = CH.phi.1.1 matrix ;
  polynomial : Id B.Carrier (CH.chi f) Q.polynomial =
   trans (PK.sip-value CHN.ME.MA.algebra CH.E.algebra CH.phi CHN.MC.package matrix) Q.formula ;
  root : PK.V.Root CH.E.algebra f Q.polynomial =
   subst (\ p -> PK.V.Root CH.E.algebra f p) polynomial (CH.cayley-hamilton f) ;
  module EV = PolyEval[l].Over[A,setA,CH.E.algebra,f] ;
  E : PK.S.Alg = CH.E.algebra ;
  value : Id E.A (EV.evaluate Q.polynomial)
   (E.add (EV.c Q.determinant) (E.mul f (E.add (EV.c (neg Q.trace)) f))) =
   trans (EV.preserves-add (B.constant Q.determinant) (B.mulQ B.variable (B.addQ (B.constant (neg Q.trace)) B.variable)))
    (Ps.cong2 E.A E.add _ _ _ _ (EV.on-constant Q.determinant)
     (trans (EV.preserves-mul B.variable (B.addQ (B.constant (neg Q.trace)) B.variable))
      (Ps.cong2 E.A E.mul _ _ _ _ EV.on-variable
       (trans (EV.preserves-add (B.constant (neg Q.trace)) B.variable)
        (Ps.cong2 E.A E.add _ _ _ _ (EV.on-constant (neg Q.trace)) EV.on-variable))))) ;
  horner : Id E.A (E.add (EV.c Q.determinant) (E.mul f (E.add (EV.c (neg Q.trace)) f))) E.zero = trans (sym value) root ;
  -- f^2(x) - trace(B) f(x) + det(B) x = 0, in ordinary module notation.
  quadratic (x : M.M) :
   Id M.M (M.madd (M.madd (f.1 (f.1 x)) (M.sm (neg Q.trace) (f.1 x))) (M.sm Q.determinant x)) M.mz =
   trans (sym (trans (ap (M.madd (M.sm Q.determinant x)) (f.2.1 (M.sm (neg Q.trace) x) (f.1 x)))
    (trans (ap (\ y -> M.madd (M.sm Q.determinant x) (M.madd y (f.1 (f.1 x)))) (f.2.2 (neg Q.trace) x))
     (trans (ap (M.madd (M.sm Q.determinant x)) (M.maddC (M.sm (neg Q.trace) (f.1 x)) (f.1 (f.1 x))))
      (M.maddC (M.sm Q.determinant x) (M.madd (f.1 (f.1 x)) (M.sm (neg Q.trace) (f.1 x))))))))
    (ap (\ g -> g.1 x) horner) ;
 } ;
 module Shear (c : R) {
  module ME = MatrixEnd[l].Over[A,setA,QP.two] ;
  M : FM.Module = FM.Free QP.two ;
  vec2 (a b : R) : M.M = ExteriorModel[l].Over[A].vec2 a b ;
  shift (d : R) (x : M.M) : M.M = vec2 (add (x QP.i0) (mul d (x QP.i1))) (x QP.i1) ;
  linear (d : R) : FM.SM.Linear M M =
   (shift d,
    \ x y -> ME.veq _ _ (QP.two-ind (\ i -> Id R (shift d (M.madd x y) i) (M.madd (shift d x) (shift d y) i))
     (trans (ap (add (add (x QP.i0) (y QP.i0))) (dist d (x QP.i1) (y QP.i1)))
      (L.swap (x QP.i0) (y QP.i0) (mul d (x QP.i1)) (mul d (y QP.i1)))) (refl (add (x QP.i1) (y QP.i1)))),
    \ a x -> ME.veq _ _ (QP.two-ind (\ i -> Id R (shift d (M.sm a x) i) (M.sm a (shift d x) i))
     (trans (ap (add (mul a (x QP.i0))) (L.mul-swap d a (x QP.i1))) (sym (dist a (x QP.i0) (mul d (x QP.i1)))))
     (refl (mul a (x QP.i1))))) ;
  forth (x : M.M) : Id M.M (shift c (shift (neg c) x)) x =
   ME.veq _ _ (QP.two-ind (\ i -> Id R (shift c (shift (neg c) x) i) (x i))
    (trans (ap (\ y -> add (add (x QP.i0) y) (mul c (x QP.i1))) (L.neg-mul-left c (x QP.i1)))
     (trans (sym (addA (x QP.i0) (neg (mul c (x QP.i1))) (mul c (x QP.i1))))
      (trans (ap (add (x QP.i0)) (L.neg-cancel (mul c (x QP.i1)))) (addZ (x QP.i0)))))
    (refl (x QP.i1))) ;
  back (x : M.M) : Id M.M (shift (neg c) (shift c x)) x =
   ME.veq _ _ (QP.two-ind (\ i -> Id R (shift (neg c) (shift c x) i) (x i))
    (trans (ap (add (add (x QP.i0) (mul c (x QP.i1)))) (L.neg-mul-left c (x QP.i1)))
      (L.add-neg-cancel (x QP.i0) (mul c (x QP.i1)))) (refl (x QP.i1))) ;
  e : FM.MS.LinEquiv M M =
   ((shift c,Pr.qinv M.M M.M (shift c) (shift (neg c)) forth back),(linear c).2.1,(linear c).2.2) ;
  module C = EndConjugation[l].Over[A,setA].At[M,M,e] ;
  conjugation (f : ME.E.H.T) (x : M.M) :
   Id M.M ((C.H.fun f).1 x) (shift c (f.1 (shift (neg c) x))) = refl (shift c (f.1 (shift (neg c) x))) ;
  finite : FM.FinFree M QP.two = Tr.Trunc[FM.MS.LinEquiv M M].inc (FM.MS.idLin M) ;
  module Intrinsic (f : ME.E.H.T) {
   module N = CharPolyNaturality[l].Over[A,setA].At[M,M,QP.two,finite,finite,e,f] ;
   invariant : Id B.Carrier N.Q.chi N.P.chi = N.natural ;
  } ;
 } ;
} ;
