-- Intrinsic characteristic polynomial on the polynomial dual Hom_A(M,A[T]).
-- Its top exterior determinant is independent of bases. A basis is only
-- used to prove finite freeness and the coordinate comparison.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module CP = CharPoly[l].Over[A,setA] ;
 module SB = ScalarDualBasis[l].Over[A,B.ring,setA,B.set,B.inclusion] ;
 module SD = SB.SD ; module FA = SD.FA ; module FB = SD.FB ;
 module EB = EndAlgebra[l].Over[B.ring,B.set] ;
 module DE = DetEnd[l].Over[B.ring,B.set] ;
 module TP = ExteriorTranspose[l].Over[B.ring,B.set] ;
 module BM = ExteriorModel[l].Over[B.ring] ;
 module EN = EndAlgebra[l].Over[A,setA] ;
 module At (M : FA.Module) (n : Nat) (bM : FA.FinFree M n) (f : FA.SM.Linear M M) {
  module D = SD.At[M] ; module EDual = EB.At[D.mod] ;
  finite : FB.FinFree D.mod n = TC.map (FA.MS.LinEquiv M (FA.Free n)) (FB.MS.LinEquiv D.mod (FB.Free n))
   (\ e -> SB.Basis[M,n,e].equiv) bM ;
  pencil : FB.SM.Linear D.mod D.mod = EDual.H.hadd (EDual.H.hsc B.variable EDual.one) (EDual.H.hneg (D.pre-linear f)) ;
  module DT = DE.At[D.mod,n,finite,pencil] ;
  chi : B.Carrier = DT.Delta ;
  module Coordinates (e : FA.MS.LinEquiv M (FA.Free n)) {
   module BS = SB.Basis[M,n,e] ;
   module DB = DT.Basis[BS.equiv] ;
   a : CP.DT.Mat n = \ j i -> e.1.1 (f.1 (BS.vec j)) i ;
   -- Matrix of the pencil on the polynomial dual = transpose(TI-a).
   entry (j i : Ps.Fin n) : Id B.Carrier (DB.A j i) (CP.charmat n a i j) =
    Ps.cong2 B.Carrier B.addQ _ _ _ _
     (ap (B.mulQ B.variable)
      (trans (ap (\ v -> v i) (BS.coords-make (FB.basis n j)))
       (trans (SB.BD.delta-sym n j i) (sym (SB.delta-map n i j)))))
     (trans (ap B.negQ (BS.dual-value j (f.1 (BS.vec i))))
       (sym (RingHom[l].negation A B.ring B.inclusion (a i j)))) ;
   matrix-eq : Id (DE.DT.Mat n) DB.A (TP.transpose n (CP.charmat n a)) =
    FE.funext (Ps.Fin n) (\ j -> Ps.Fin n -> B.Carrier) DB.A (TP.transpose n (CP.charmat n a))
     (\ j -> FE.funext (Ps.Fin n) (\ i -> B.Carrier) (DB.A j) (TP.transpose n (CP.charmat n a) j)
       (\ i -> trans (entry j i) (sym (TP.transpose-value n (CP.charmat n a) j i)))) ;
   comparison : Id B.Carrier chi (CP.char n a) =
    trans (DT.delta-coords BS.equiv)
     (trans (ap (BM.det n) matrix-eq) (sym (TP.det-transpose n (CP.charmat n a)))) ;
  } ;
  -- These assertions eliminate the mere basis only into propositions.
  monic : Id A.R (CP.coef chi n) A.o =
   TC.rec (FA.MS.LinEquiv M (FA.Free n)) @l (Id A.R (CP.coef chi n) A.o) (setA _ _)
    (\ e -> trans (ap (\ p -> CP.coef p n) Coordinates[e].comparison) (CP.char-monic n Coordinates[e].a)) bM ;
  bounded : CP.Bounded (suc n) chi = \ k ->
   TC.rec (FA.MS.LinEquiv M (FA.Free n)) @l (Id A.R (CP.coef chi (plus (suc n) k)) A.z) (setA _ _)
    (\ e -> trans (ap (\ p -> CP.coef p (plus (suc n) k)) Coordinates[e].comparison) (CP.char-bounded n Coordinates[e].a k)) bM ;
 } ;
} ;
