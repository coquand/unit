-- Client: matrix Cayley-Hamilton, transported as a package by AlgSIP.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module ME = MatrixEnd[l].Over[A,setA,n] ; module FM = ME.FM ;
 module CJ = EndConjugation[l].Over[A,setA] ;
 module PK = CHPackageTransport[l].Over[A,setA] ; module MC = PK.Matrix[n] ;
 module WithBasis (M : FM.Module) (e : FM.MS.LinEquiv (FM.Free n) M) {
  module C = CJ.At[FM.Free n,M,e] ; module E = C.ENd ;
  phi : PK.S.AlgIso ME.MA.algebra E.algebra = ME.IS.comp ME.MA.algebra ME.E.algebra E.algebra ME.to-end C.iso ;
  package : PK.Package E.algebra = PK.via-sip ME.MA.algebra E.algebra phi MC.package ;
  matrix (f : E.H.T) : ME.MA.Mat = phi.1.2.sec f ;
  chi (f : E.H.T) : PK.B.Carrier = package.1 f ;
  chi-coordinates (f : E.H.T) : Id PK.B.Carrier (chi f) (MC.chi (matrix f)) =
   PK.inverse-value ME.MA.algebra E.algebra phi MC.package f ;
  cayley-hamilton (f : E.H.T) : PK.V.Root E.algebra f (chi f) = package.2 f ;
  based-cayley-hamilton (f : E.H.T) : PK.V.Root E.algebra f (MC.chi (matrix f)) =
   subst (\ p -> PK.V.Root E.algebra f p) (chi-coordinates f) (cayley-hamilton f) ;
  on-vector (f : E.H.T) (x : M.M) :
   Id M.M ((PK.V.ev E.algebra f (MC.chi (matrix f))).1 x) M.mz =
   ap (\ u -> u.1 x) (based-cayley-hamilton f) ;
 } ;
} ;
