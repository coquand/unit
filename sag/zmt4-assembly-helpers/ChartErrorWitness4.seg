-- Realize an explicit chart-ring ideal error witness as an actual
-- homogeneous singleton Cech witness. No choice or coherence is needed.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Sub4)
 (t : Nat) (b : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) (k : Int) {
 module D = ChartDegreePart4[l].Over[A,setA,E] ; module R = D.R ;
 module Part = D.Part[k].Into[Sq] ;
 module Product = ChartPartMultiplication4[l].Over[A,setA,E] ;
 module RC = ReesChart4[l].Over[A,setA,t,b,s,p,e,hp] ;
 module CJ = RC.JC[Sq,\ i -> E,k] ;
 J (q : Ps.Fin s) : R.ring.R = R.inclusion.1 (R.B.phi (p q)) ;
 module W = SectionsErrorWitness[l].Over[R.ring,t,\ j -> D.iota.1 (b j),s,J] ;
 module LL = RelationCertificate[l].LinL[A,D.moduleM,Part.C.mod,Part.lin] ;
 module Transport = IdealPowerWitnessTransport[l].Over[R.ring,A,IP.regular R.ring,Part.C.mod,t,
   \ j -> D.iota.1 (b j),b,Part.element,LL.f-zero,Part.lin.f-add,
   \ j x -> Part.lin.f-sm (b j) x] ;
 coefficients (ys : Ps.Fin s -> R.ring.R) : CJ.F.E1.El =
   \ q -> D.Part[minus k (e q)].Into[Sq].element (ys q) ;
 project-sum (ys : Ps.Fin s -> R.ring.R) :
   Id CJ.E.El (Part.element (W.C.value ys)) (CJ.F.A.f (coefficients ys)) =
   trans (Transport.map-sum s (\ q -> R.ring.mul (J q) (ys q)))
     (CJ.S0.sum-cong s (\ q -> Part.element (R.ring.mul (J q) (ys q)))
       (\ q -> (CJ.F.gi q).f (coefficients ys q))
       (\ q -> Product.Product[k,e q,p q,hp q].equation (ys q))) ;
 module Realize (depth : Base.Nat) (x : R.ring.R) (wit : W.Witness depth x) {
   w : CJ.E.El = Part.element (W.part depth x wit) ;
   ideal : CJ.FC.Wit depth w = Transport.witness depth (W.part depth x wit) (W.ideal depth x wit) ;
   remainder : CJ.JW (CJ.ML.msub (Part.element x) w) =
     (coefficients (W.coeff depth x wit),
       trans (sym (Transport.map-sub x (W.part depth x wit)))
         (trans (ap Part.element (W.equation depth x wit)) (project-sum (W.coeff depth x wit)))) ;
   result : (v : CJ.E.El) * (CJ.FC.Wit depth v * CJ.JW (CJ.ML.msub (Part.element x) v)) =
     (w,(ideal,remainder)) ;
 } ;
} ;
