-- Construct primitive generation on a selected factor from an actual
-- inverse of Delta z off the diagonal. All relative bases, coordinates,
-- minimal polynomials and polynomial representatives are constructed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (q : PrimeIdempotents[l].Over[S.ring].Prime) {
 module C = Algebras[l].Over[k,setk] ; module St = SelectedFactorStatement[l].Over[k,setk].At[S] ;
 record GeneratorData (z : S.ring.R) {
  e : S.ring.R ; square : Id S.ring.R (S.ring.mul e e) e ; outside : Not (q.ideal.In e) ;
  representative : S.ring.R -> List k.R ;
  equation (a : S.ring.R) : Id S.ring.R (S.ring.mul e (S.ring.add a (S.ring.neg (St.value z (representative a))))) S.ring.z ;
 } ;
 module Separator (D : C.Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
  (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
  (z : S.ring.R) (w : D.ring.R)
  (inverse : Id D.ring.R
   (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference z) w)
   (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
  module Coordinates = TensorRelativeCoordinates[l].Over[k,setk,S,D,cp,n,basis,epsilon,z,w,inverse] ;
  module Injection = MinimalPolynomialInjection[l].Over[k,setk,field,S,n,basis,z] ;
  module Given (f : Injection.Min.Minimal) {
   module I = Injection.At[f] ; module Reg = I.Reduced[reduced] ; module Prime = I.Prime[q] ;
   module Select = SelectedFiniteAlgebraBasis[l].Over[k,setk,I.Q,S,I.hom,I.M.degree,n,I.M.basis,basis,Prime.theorem,Reg.regular] ;
   module Chosen (r : Select.B.Result) {
    module F = Select.Factor[r] ;
    module Relative = Coordinates.Relative[F.BasePart.algebra,F.Target.algebra,F.inclusion,F.Target.projection] ;
    contains : Id F.Target.F.Carrier (F.Target.F.project z) (F.inclusion.1.1 (F.BasePart.F.project I.M.x)) =
     sym (trans (F.Relative.square I.M.x) (ap F.Target.F.project I.beta)) ;
    module Coords = Relative.Basis[r.rank,r.basis,F.BasePart.F.project I.M.x,contains] ;
    module Generation = MonicCoordinateGeneration[l].Over[k,setk,f.lower,S,I.hom,r.e,r.idempotent,q,r.outside] ;
    module Build = Generation.At[r.rank,r.basis,Coords.theorem F.Target.F.onto] ;
    module Finish (g : Generation.Result) {
     equation (a : S.ring.R) : Id S.ring.R
      (S.ring.mul g.value (S.ring.add a (S.ring.neg (St.value z (g.representative a))))) S.ring.z =
       trans (ap (\ x -> S.ring.mul g.value (S.ring.add a (S.ring.neg (St.value x (g.representative a))))) (sym I.beta)) (g.equation a) ;
     result : GeneratorData[z] = new GeneratorData[z,g.value,g.idempotent,g.outside,g.representative,equation] ;
    } ;
    theorem : Tr.Trunc[GeneratorData[z]].carrier =
     TC.map Generation.Result GeneratorData[z] (\ g -> Finish[g].result) (Build.theorem Reg.regular) ;
   } ;
   theorem : Tr.Trunc[GeneratorData[z]].carrier = TC.bind Select.B.Result GeneratorData[z] (\ r -> Chosen[r].theorem) Select.theorem ;
  } ;
  theorem : Tr.Trunc[GeneratorData[z]].carrier = TC.bind Injection.Min.Minimal GeneratorData[z] (\ f -> Given[f].theorem) Injection.Min.theorem ;
 } ;
} ;
