-- Add a selected simple-root equation for the separator z and intersect
-- the two selected idempotents. This is the exact local field target.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (perfect : PerfectTraceNondegenerate[l].Over[k,setk,S,n,basis].Perfect)
 (q : PrimeIdempotents[l].Over[S.ring].Prime) {
 module G = SeparatorSelectedGenerator[l].Over[k,setk,field,S,n,basis,reduced,q] ;
 module Sep = SelectedSeparableAnnihilator[l].Over[k,setk,field,S,n,basis,reduced,perfect,q] ;
 module St = G.St ; module PI = PrimeIdempotents[l].Over[S.ring] ; module L = RL[S.ring] ;
 module Combine (z : S.ring.R) (g : G.GeneratorData[z]) (s : Sep.Result[z]) {
  e : S.ring.R = S.ring.mul g.e s.idempotent ;
  out-case : Plus (q.ideal.In g.e) (q.ideal.In s.idempotent) -> Empty = split {
   inl h -> g.outside h ; inr h -> s.outside h } ;
  outside : Not (q.ideal.In e) = \ h -> out-case (q.prime g.e s.idempotent h) ;
  preserve (a : S.ring.R) (eq : Id S.ring.R (S.ring.mul s.idempotent a) S.ring.z) :
   Id S.ring.R (S.ring.mul e a) S.ring.z =
    trans (sym (S.ring.mulA g.e s.idempotent a))
     (trans (ap (S.ring.mul g.e) eq) (L.mul-zero g.e)) ;
  generates (i : Fin n) : Id S.ring.R
   (S.ring.mul e (S.ring.add (basis.vector i) (S.ring.neg (St.value z (g.representative (basis.vector i)))))) S.ring.z =
    trans (sym (S.ring.mulA g.e s.idempotent (S.ring.add (basis.vector i) (S.ring.neg (St.value z (g.representative (basis.vector i)))))))
     (trans (L.mul-swap g.e s.idempotent (S.ring.add (basis.vector i) (S.ring.neg (St.value z (g.representative (basis.vector i))))))
      (trans (ap (S.ring.mul s.idempotent) (g.equation (basis.vector i))) (L.mul-zero s.idempotent))) ;
  result : St.Selected[n,basis,q] = new St.Selected[n,basis,q,e,PI.product-idempotent g.e s.idempotent g.square s.square,
   outside,z,s.lower,preserve _ s.root,s.inverse,preserve _ s.separable,\ i -> g.representative (basis.vector i),generates] ;
 } ;
 module Separator (D : Algebras[l].Over[k,setk].Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
  (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
  (z : S.ring.R) (w : D.ring.R)
  (inverse : Id D.ring.R
   (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference z) w)
   (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
  theorem : Tr.Trunc[St.Selected[n,basis,q]].carrier =
   TC.map2 G.GeneratorData[z] Sep.Result[z] (St.Selected[n,basis,q]) (\ g s -> Combine[z,g,s].result)
    G.Separator[D,cp,epsilon,z,w,inverse].theorem (Sep.theorem z) ;
 } ;
} ;
