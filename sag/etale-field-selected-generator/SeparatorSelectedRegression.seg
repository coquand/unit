-- Full assembled theorem over F2, using the presented tensor, its
-- CONSTRUCTED diagonal certificate and the constructed perfect trace.
-- The base tensor's multiplication map is injective, so its diagonal
-- is 1 and the complementary separator inverse is 0. Run both z=0 and
-- z=1, including the minimal-polynomial, selected-basis, coordinate and
-- simple-root constructions. No selected factor is supplied to this test.
-- A separate explicit F2 x F2 test checks the final intersection step.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module R = PrimitiveRegression[l] ; module B = BooleanRing[l] ;
k : CRing = B.two-ring ; module L = RL[k] ;
module C = Algebras[l].Over[k,B.bool-set] ;
module Trace = TraceRegression[l].BaseCase[k,B.bool-set] ;
module D = Trace.ActualTensor ; module DK = D.Diag.DK ; module DL = RL[D.T.T.ring] ;
reduced (a : k.R) (h : Id k.R (k.mul a a) k.z) : Id k.R a k.z = trans (sym (B.and-self a)) h ;
member (a : k.R) : U l = Id k.R a k.z ;
ideal : RegularIdeal[l].IdealPred[k] = RegularIdeal[l].mkIdealPred k member (refl k.z)
 (\ a b ha hb -> trans (cong2 k.R k.add _ _ _ _ ha hb) (k.addZ k.z))
 (\ a b hb -> trans (ap (k.mul a) hb) (L.mul-zero a)) ;
prime : PrimeIdempotents[l].Over[k].Prime = new PrimeIdempotents[l].Over[k].Prime[
 ideal,\ a -> B.bool-set a k.z,R.nonzero,R.prime-and,R.prime-dec] ;
perfect : PerfectTraceNondegenerate[l].Over[k,B.bool-set,C.base,TraceRegression[l].one,Trace.basis].Perfect = Trace.theorem ;
module Main = SeparatorSelectedFactor[l].Over[k,B.bool-set,R.field,C.base,TraceRegression[l].one,Trace.basis,reduced,perfect,prime] ;
retraction : C.Hom D.T.T D.T.T = C.compose D.T.T C.base D.T.T DK.left DK.mu ;
retraction-eq : Id (C.Hom D.T.T D.T.T) retraction (C.identity D.T.T) =
 DK.hom-ext D.T.T retraction (C.identity D.T.T)
  (\ a -> ap DK.left.1.1 (DK.mu-left a))
  (\ a -> trans (ap DK.left.1.1 (DK.mu-right a)) (trans (DK.left.2 a) (sym (DK.right.2 a)))) ;
restore (a : D.T.T.ring.R) : Id D.T.T.ring.R (DK.left.1.1 (DK.mu.1.1 a)) a =
 ap (\ h -> h.1.1 a) retraction-eq ;
module WithDiagonal (epsilon : D.Diag.Witness) {
 diagonal-one : Id D.T.T.ring.R epsilon.epsilon D.T.T.ring.o =
  trans (sym (restore epsilon.epsilon)) (trans (ap DK.left.1.1 epsilon.mu-one) DK.left.1.2.1) ;
 complement-zero : Id D.T.T.ring.R (D.T.T.ring.add D.T.T.ring.o (D.T.T.ring.neg epsilon.epsilon)) D.T.T.ring.z =
  trans (ap (\ a -> D.T.T.ring.add D.T.T.ring.o (D.T.T.ring.neg a)) diagonal-one) (D.T.T.ring.addN D.T.T.ring.o) ;
 inverse (z : k.R) : Id D.T.T.ring.R (D.T.T.ring.mul (DK.difference z) D.T.T.ring.z)
  (D.T.T.ring.add D.T.T.ring.o (D.T.T.ring.neg epsilon.epsilon)) =
  trans (DL.mul-zero (DK.difference z)) (sym complement-zero) ;
 full (z : k.R) : Tr.Trunc[Main.St.Selected[TraceRegression[l].one,Trace.basis,prime]].carrier =
  Main.Separator[D.T.T,D.T.coproduct,epsilon,z,D.T.T.ring.z,inverse z].theorem ;
 generation (z : k.R) : Tr.Trunc[Main.G.GeneratorData[z]].carrier =
  Main.G.Separator[D.T.T,D.T.coproduct,epsilon,z,D.T.T.ring.z,inverse z].theorem ;
} ;
constructed (z : k.R) : Tr.Trunc[Main.St.Selected[TraceRegression[l].one,Trace.basis,prime]].carrier =
 TC.bind D.Diag.Witness (Main.St.Selected[TraceRegression[l].one,Trace.basis,prime])
  (\ epsilon -> WithDiagonal[epsilon].full z) D.theorem ;
at-zero : Tr.Trunc[Main.St.Selected[TraceRegression[l].one,Trace.basis,prime]].carrier = constructed false ;
at-one : Tr.Trunc[Main.St.Selected[TraceRegression[l].one,Trace.basis,prime]].carrier = constructed true ;
input : Main.St.Input = new Main.St.Input[R.field,TraceRegression[l].one,Trace.basis,perfect,prime] ;
exact-target : Main.St.Result input = at-zero ;
-- Explicit nontrivial intersection: generation already holds on the
-- first factor of F2 x F2, whereas T is a simple equation on the whole
-- algebra for the chosen generator 0. The combined factor stays first.
module PairMain = SeparatorSelectedFactor[l].Over[R.k,B.bool-set,R.field,R.S,R.two,R.basis,R.reduced,R.perfect,R.q] ;
generation-data : PairMain.G.GeneratorData[R.z] = new PairMain.G.GeneratorData[R.z,
 R.result.value,R.result.idempotent,R.result.outside,R.Global.representation,R.all-representations] ;
simple-data : PairMain.Sep.Result[R.z] = new PairMain.Sep.Result[R.z,
 R.o,R.idem R.o,R.nonzero,cons false nil,refl R.z,refl R.z,R.o,refl R.z] ;
combined : PairMain.St.Selected[R.two,R.basis,R.q] = PairMain.Combine[R.z,generation-data,simple-data].result ;
combined-first-factor : Id R.Pair combined.idempotent (true,false) = refl (true,false) ;
combined-kills-second : Id R.Pair (R.A.mul combined.idempotent (false,true)) R.z = refl R.z ;
combined-generates-second : Id R.Pair
 (R.A.mul combined.idempotent (R.A.add (R.basis.vector R.i1)
  (R.A.neg (PairMain.St.value combined.generator (combined.representation R.i1))))) R.z = combined.generates R.i1 ;
