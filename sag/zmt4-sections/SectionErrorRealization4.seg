-- Realize a constructed family of native chart-ring errors, then assemble
-- the actual I^p witness and J coefficients in the global chart module.
-- This is a bookkeeping wrapper around the proved local/global helpers.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (b : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> TPoly A.R) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q))
 (I : U l) (set : I -> Sub4) (n : Nat) (ix : Ps.Fin n -> I)
 (cover : (i : I) -> (j : Ps.Fin n) * Id I (ix j) i) (k : Int) {
 module Assembly = ChartErrorAssembly4[l].Over[A,setA,t,b,s,p,e,hp,I,set,n,ix,cover,k] ;
 module Local (i : I) { module R = ChartErrorWitness4[l].Over[A,setA,set i,t,b,s,p,e,hp,k] ; } ;
 module Input (depth : Base.Nat) (x : (i : I) -> Local[i].R.R.ring.R)
   (witness : (i : I) -> Local[i].R.W.Witness depth (x i)) {
   module Real (i : I) { module V = Local[i].R.Realize[depth,x i,witness i] ; } ;
   xs : Assembly.CS.P.El = \ i -> Local[i].R.Part.element (x i) ;
   ws : Assembly.CS.P.El = \ i -> Real[i].V.w ;
   module Global = Assembly.Assemble[depth,xs,ws,\ i -> Real[i].V.ideal,\ i -> Real[i].V.remainder] ;
   w : Assembly.CJ.E.El = Global.w ;
   ideal : Assembly.CJ.FC.Wit depth w = Global.ideal ;
   remainder : Assembly.CJ.JW (Assembly.CJ.ML.msub (Assembly.CS.assemble xs) w) = Global.remainder ;
   error : Assembly.CJ.IJW depth (Assembly.CS.assemble xs) = Global.error ;
 } ;
} ;
