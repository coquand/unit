-- Homogeneous residual equations with the monic part left visible.
-- A recursive reversed lower polynomial gives M_k=X_k^d+Z Qbar_k.
-- Choose delta larger than all H-term degree bounds and set
-- P_k=Z^delta M_k-sum_j b_j hom_(d+delta)(H_kj).
-- These generators are free choices: no equality to the earlier homT
-- of an expanded residual expression is needed. Dehomogenisation is
-- nevertheless exactly the original residual equation in the same E.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module NA = NatArith[l] ;
module ST0 = ZMT4Setup[l] ; module ZM = ZMT4Certificate[l] ;
module BR = PolynomialRing4Bridge[l] ; module WP = WeightedParts4[l] ;
module ZC = ZMTCertificate[l] ;
zexp : N4 = nx (suc zero) zero zero zero ;
zeroexp : N4 = nx zero zero zero zero ;
module Over (A : CRing) (setA : Pr.isSet A.R) (D0 : ResidualAlgebra[l].Residual[A,setA,ZM.three]) {
 module ST = ST0.Over[A,setA,D0] ; module FD = ST.FD ; module CO = ST.CO ;
 E : CRing = ST.E ; module LE = RL[E] ; module PAA = ST.PAA ;
 module EV = ZC.Eval[A,E,ST.iota] ; module EI = FD.EQ.At[FD.algebra,FD.y] ;
 module FS = FiniteIdeal[l].Sums[E] ;
 xp (q : Ps.Fin ZM.three) : Base.Nat -> N4 = split {
   zero -> zeroexp ; suc d | rec -> addN4 (ST.exS q) rec } ;
 size-var2 : (q : Ps.Fin (suc (suc zero))) -> Id Base.Nat (size (ST.exS (inl q))) (suc zero) = split {
   inl q -> sizeVar1 q ; inr t -> refl (suc zero) }
 where { sizeVar1 : (q : Ps.Fin (suc zero)) -> Id Base.Nat (size (ST.exS (inl (inl q)))) (suc zero) = split {
   inl e -> absurd (Id Base.Nat (size (ST.exS (inl (inl (inl e))))) (suc zero)) e ; inr t -> refl (suc zero) } } ;
 size-var : (q : Ps.Fin ZM.three) -> Id Base.Nat (size (ST.exS q)) (suc zero) = split {
   inl q -> size-var2 q ; inr t -> refl (suc zero) } ;
 size-xp (q : Ps.Fin ZM.three) : (d : Base.Nat) -> Id Base.Nat (size (xp q d)) d = split {
   zero -> refl zero ; suc d | rec -> trans (ZM.size-add (ST.exS q) (xp q d))
     (trans (ap (\ x -> NA.plus x (size (xp q d))) (size-var q)) (ap (\ x -> suc x) rec)) } ;
 mon-var (q : Ps.Fin ZM.three) : Id E.R (CO.mon (ST.exS q)) (FD.y q) =
   trans (sym (LE.one-left (CO.mon (ST.exS q))))
     (trans (ap (\ x -> E.mul x (CO.mon (ST.exS q))) (sym ST.iota.2.1))
       (trans (sym (ST.deh-term A.o (ST.exS q))) (ST.deh-var q))) ;
 mon-xp (q : Ps.Fin ZM.three) : (d : Base.Nat) -> Id E.R (CO.mon (xp q d)) (CO.bpow (FD.y q) d) = split {
   zero -> ST.one3 ; suc d | rec -> trans (CO.mon-add (ST.exS q) (xp q d))
     (Ps.cong2 E.R E.mul _ _ _ _ (mon-var q) rec) } ;
 bpow-cast (x : E.R) : (d : Nat) -> Id E.R (CO.bpow x (BR.toB d)) (EV.PF.pow x d) = split {
   zero -> refl E.o ; suc d | rec -> ap (E.mul x) rec } ;
 scalar (c : A.R) (p : TPoly A.R) : TPoly A.R = PAA.scaleT (c,zeroexp) p ;
 hom-scalar (c : A.R) (e : Base.Nat) (p : TPoly A.R) (hp : HomDeg A.R e p) : HomDeg A.R e (scalar c p) =
   subst (\ d -> HomDeg A.R d (scalar c p)) (NA.plus-zero e) (CO.hom-scaleT c zeroexp e p hp) ;
 deh-scalar (c : A.R) (p : TPoly A.R) : Id E.R (CO.deh (scalar c p)) (E.mul (ST.iota.1 c) (CO.deh p)) =
   trans (CO.deh-scale c zeroexp p) (ap (\ v -> E.mul v (CO.deh p))
     (trans (ap (E.mul (ST.iota.1 c)) ST.one3) (E.mulO (ST.iota.1 c)))) ;
 zscale (b : Base.Nat) (p : TPoly A.R) : TPoly A.R = PAA.scaleT (A.o,nx b zero zero zero) p ;
 deh-zscale (b : Base.Nat) (p : TPoly A.R) : Id E.R (CO.deh (zscale b p)) (CO.deh p) =
   trans (CO.deh-scale A.o (nx b zero zero zero) p)
     (trans (ap (\ v -> E.mul v (CO.deh p))
       (trans (ap (E.mul (ST.iota.1 A.o)) ST.one3) (trans (E.mulO (ST.iota.1 A.o)) ST.iota.2.1))) (LE.one-left (CO.deh p))) ;
 lower (q : Ps.Fin ZM.three) : (d : Nat) -> (Ps.Fin d -> A.R) -> TPoly A.R = split {
   zero -> \ c -> nil ; suc d | rec -> \ c -> zscale (suc zero)
     (Bar[l].app (cons (c (inr tt),xp q (BR.toB d)) nil) (rec (\ i -> c (inl i)))) } ;
 hom-lower (q : Ps.Fin ZM.three) : (d : Nat) (c : Ps.Fin d -> A.R) -> HomDeg A.R (BR.toB d) (lower q d c) = split {
   zero -> \ c -> tt ; suc d | rec -> \ c -> Pr.subst Base.Nat (\ e -> HomDeg A.R e (lower q (suc d) c))
     (NA.plus (BR.toB d) (size zexp)) (BR.toB (suc d))
     (trans (ap (NA.plus (BR.toB d)) (ZM.sizeZ (suc zero)))
       (trans (NA.plus-suc (BR.toB d) zero) (ap (\ x -> suc x) (NA.plus-zero (BR.toB d)))))
     (CO.hom-scaleT A.o zexp (BR.toB d)
       (Bar[l].app (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i))))
       (ST0.hom-app A.R (BR.toB d) (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i)))
         (size-xp q (BR.toB d),tt) (rec (\ i -> c (inl i))))) } ;
 deh-lower (q : Ps.Fin ZM.three) : (d : Nat) (c : Ps.Fin d -> A.R) ->
   Id E.R (CO.deh (lower q d c)) (FS.sum d (\ i -> E.mul (EV.PF.pw (FD.y q) d i) (ST.iota.1 (c i)))) = split {
   zero -> \ c -> refl E.z ; suc d | rec -> \ c ->
     trans (deh-zscale (suc zero) (Bar[l].app (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i)))))
       (trans (ST.deh-app (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i))))
         (Ps.cong2 E.R E.add _ _ _ _
           (trans (ST.deh-term (c (inr tt)) (xp q (BR.toB d)))
             (trans (ap (E.mul (ST.iota.1 (c (inr tt)))) (trans (mon-xp q (BR.toB d)) (bpow-cast (FD.y q) d)))
               (E.mulC (ST.iota.1 (c (inr tt))) (EV.PF.pow (FD.y q) d))))
           (rec (\ i -> c (inl i))))) } ;
 monic (q : Ps.Fin ZM.three) : TPoly A.R = Bar[l].app
   (cons (A.o,xp q (BR.toB (D0.P q).deg)) nil) (lower q (D0.P q).deg (D0.P q).low) ;
 hom-monic (q : Ps.Fin ZM.three) : HomDeg A.R (BR.toB (D0.P q).deg) (monic q) =
   ST0.hom-app A.R (BR.toB (D0.P q).deg) (cons (A.o,xp q (BR.toB (D0.P q).deg)) nil) (lower q (D0.P q).deg (D0.P q).low)
     (size-xp q (BR.toB (D0.P q).deg),tt)
     (hom-lower q (D0.P q).deg (D0.P q).low) ;
 deh-monic (q : Ps.Fin ZM.three) : Id E.R (CO.deh (monic q)) (EV.mev (D0.P q) (FD.y q)) =
   trans (ST.deh-app _ _) (Ps.cong2 E.R E.add _ _ _ _
     (trans (ST.deh-term A.o (xp q (BR.toB (D0.P q).deg)))
       (trans (ap (\ x -> E.mul x (CO.mon (xp q (BR.toB (D0.P q).deg)))) ST.iota.2.1)
         (trans (LE.one-left (CO.mon (xp q (BR.toB (D0.P q).deg))))
           (trans (mon-xp q (BR.toB (D0.P q).deg)) (bpow-cast (FD.y q) (D0.P q).deg)))))
     (deh-lower q (D0.P q).deg (D0.P q).low)) ;
 bound (q : Ps.Fin ZM.three) (j : Ps.Fin D0.t) : Base.Nat = ST0.bndT A.R (ST.tl (D0.H q j)) ;
 delta (q : Ps.Fin ZM.three) : Base.Nat = suc (WP.sumN D0.t (bound q)) ;
 e (q : Ps.Fin ZM.three) : Base.Nat = NA.plus (BR.toB (D0.P q).deg) (delta q) ;
 le-bound (q : Ps.Fin ZM.three) (j : Ps.Fin D0.t) : NA.Le (bound q j) (e q) =
   NA.le-trans _ _ _ (WP.le-sumN D0.t (bound q) j)
     (NA.le-trans _ _ _ (suc zero,refl (delta q)) (NA.le-sum-r (delta q) (BR.toB (D0.P q).deg))) ;
 all-mono (a b : Base.Nat) (le : NA.Le a b) : (p : TPoly A.R) -> ST0.AllLe A.R a p -> ST0.AllLe A.R b p = split {
   nil -> \ h -> tt ; cons t p | rec -> \ h -> (NA.le-trans _ _ _ h.1 le,rec h.2) } ;
 hT (q : Ps.Fin ZM.three) (j : Ps.Fin D0.t) : TPoly A.R = ST.homT (e q) (ST.tl (D0.H q j)) ;
 hhT (q : Ps.Fin ZM.three) (j : Ps.Fin D0.t) : HomDeg A.R (e q) (hT q j) = ST.hom-homT (e q) (ST.tl (D0.H q j)) ;
 deh-hT (q : Ps.Fin ZM.three) (j : Ps.Fin D0.t) : Id E.R (CO.deh (hT q j)) (EI.I.ev (D0.H q j)) =
   trans (ST.deh-homT (e q) (ST.tl (D0.H q j))
     (all-mono (bound q j) (e q) (le-bound q j) (ST.tl (D0.H q j)) (ST0.bnd-le A.R (ST.tl (D0.H q j)))))
     (ST.deh-tl (D0.H q j)) ;
 sum-hom (dd : Base.Nat) : (t : Nat) (p : Ps.Fin t -> TPoly A.R) -> ((j : Ps.Fin t) -> HomDeg A.R dd (p j)) -> HomDeg A.R dd (PAA.psum t p) = split {
   zero -> \ p h -> tt ; suc t | rec -> \ p h -> ST0.hom-app A.R dd _ _ (h (inr tt)) (rec (\ i -> p (inl i)) (\ i -> h (inl i))) } ;
 deh-sum : (t : Nat) (p : Ps.Fin t -> TPoly A.R) -> Id E.R (CO.deh (PAA.psum t p)) (FS.sum t (\ j -> CO.deh (p j))) = split {
   zero -> \ p -> refl E.z ; suc t | rec -> \ p -> trans (ST.deh-app _ _) (ap (E.add (CO.deh (p (inr tt)))) (rec (\ i -> p (inl i)))) } ;
 error (q : Ps.Fin ZM.three) : TPoly A.R = PAA.psum D0.t (\ j -> scalar (D0.b j) (hT q j)) ;
 hom-error (q : Ps.Fin ZM.three) : HomDeg A.R (e q) (error q) = sum-hom (e q) D0.t (\ j -> scalar (D0.b j) (hT q j))
   (\ j -> hom-scalar (D0.b j) (e q) (hT q j) (hhT q j)) ;
 deh-error (q : Ps.Fin ZM.three) : Id E.R (CO.deh (error q))
   (FS.sum D0.t (\ j -> E.mul (ST.iota.1 (D0.b j)) (EI.I.ev (D0.H q j)))) =
   trans (deh-sum D0.t (\ j -> scalar (D0.b j) (hT q j)))
     (FS.sum-cong D0.t (\ j -> CO.deh (scalar (D0.b j) (hT q j)))
       (\ j -> E.mul (ST.iota.1 (D0.b j)) (EI.I.ev (D0.H q j))) (\ j -> trans (deh-scalar (D0.b j) (hT q j))
     (ap (E.mul (ST.iota.1 (D0.b j))) (deh-hT q j)))) ;
 P (q : Ps.Fin ZM.three) : TPoly A.R = Bar[l].app (zscale (delta q) (monic q)) (scalar (A.neg A.o) (error q)) ;
 hp (q : Ps.Fin ZM.three) : HomDeg A.R (e q) (P q) = ST0.hom-app A.R (e q) _ _
   (subst (\ d -> HomDeg A.R d (zscale (delta q) (monic q)))
     (ap (NA.plus (BR.toB (D0.P q).deg)) (ZM.sizeZ (delta q)))
       (CO.hom-scaleT A.o (nx (delta q) zero zero zero) (BR.toB (D0.P q).deg) (monic q) (hom-monic q)))
   (hom-scalar (A.neg A.o) (e q) (error q) (hom-error q)) ;
 deh-P (q : Ps.Fin ZM.three) : Id E.R (CO.deh (P q)) E.z =
   trans (ST.deh-app _ _) (trans (Ps.cong2 E.R E.add _ _ _ _
     (trans (deh-zscale (delta q) (monic q)) (deh-monic q))
     (trans (deh-scalar (A.neg A.o) (error q)) (trans (EI.neg-one (CO.deh (error q))) (ap E.neg (deh-error q)))))
     (trans (ap (\ v -> E.add v (E.neg (FS.sum D0.t (\ j -> E.mul (ST.iota.1 (D0.b j)) (EI.I.ev (D0.H q j)))))) (FD.y-holds q))
       (E.addN (FS.sum D0.t (\ j -> E.mul (ST.iota.1 (D0.b j)) (EI.I.ev (D0.H q j))))))) ;
} ;
