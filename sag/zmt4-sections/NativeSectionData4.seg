-- Instantiate all monic/chart algebra in the CONSTRUCTED native chart
-- rings. The affine section is a function of n, with no choices.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module BR = PolynomialRing4Bridge[l] ;
module ZM = ZMT4Certificate[l] ; module CC = ChartCoordinates4[l] ;
module SE = SectionExpression4[l] ; module SW = SectionsErrorWitness[l] ;
affine1 : Ps.Fin (suc zero) -> Pt = split { inl e -> absurd Pt e ; inr t -> p1 } ;
affine2 : Ps.Fin (suc (suc zero)) -> Pt = split { inl i -> affine1 i ; inr t -> p2 } ;
affine : Ps.Fin ZM.three -> Pt = split { inl i -> affine2 i ; inr t -> p3 } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (D0 : ResidualAlgebra[l].Residual[A,setA,ZM.three]) {
 module ST = MonicFriendlySetup[l].Over[A,setA,D0] ;
 module MC = MonicChartRelation[l].Over[A,setA,D0] ;
 exp1 : (i : Ps.Fin (suc zero)) -> Id N4 (CC.unitN (affine1 i)) (ST.ST.exS (inl (inl i))) = split {
   inl e -> absurd (Id N4 (CC.unitN (affine1 (inl e))) (ST.ST.exS (inl (inl (inl e))))) e ; inr t -> refl (CC.unitN p1) } ;
 exp2 : (i : Ps.Fin (suc (suc zero))) -> Id N4 (CC.unitN (affine2 i)) (ST.ST.exS (inl i)) = split {
   inl i -> exp1 i ; inr t -> refl (CC.unitN p2) } ;
 exp : (i : Ps.Fin ZM.three) -> Id N4 (CC.unitN (affine i)) (ST.ST.exS i) = split {
   inl i -> exp2 i ; inr t -> refl (CC.unitN p3) } ;
 module AtChart (E : Sub4) {
   module R = ChartLaurentRing4[l].Over[A,setA,E] ; module D = ChartDegreePart4[l].Over[A,setA,E] ;
   module C = CC.Over[A,setA,E] ; module Read = MC.To[R.ring,R.inclusion] ;
   module P = SectionsPowerAlgebra[l].Over[R.ring] ; module Units = ChartUnitAlgebra[l].Over[R.ring] ;
   module L = RL[R.ring] ;
   J (q : Ps.Fin ZM.three) : R.ring.R = R.inclusion.1 (R.B.phi (ST.P q)) ;
   module W = SW.Over[R.ring,D0.t,\ j -> D.iota.1 (D0.b j),ZM.three,J] ;
   variable (q : Ps.Fin ZM.three) : Id R.ring.R (C.variable (affine q)) (Read.X q) =
     ap (\ u -> R.inclusion.1 (R.B.term A.o u)) (exp q) ;
   module Affine (q : Ps.Fin ZM.three) (has : Le4 (setPt (affine q)) E) {
     module Inv = C.Inverse[affine q,has] ;
     unit : Id R.ring.R (R.ring.mul (Read.X q) Inv.inverse) R.ring.o =
       trans (ap (\ x -> R.ring.mul x Inv.inverse) (sym (variable q))) Inv.law ;
     module Rel = Read.Chart[q,Inv.inverse,unit] ;
     ys : Ps.Fin ZM.three -> R.ring.R = FiniteSingleCoefficient[l].Over[R.ring].single ZM.three q Rel.ve ;
     J-equation : Id R.ring.R (W.C.value ys) (R.ring.mul Rel.ve (Read.T.read (ST.P q))) =
       trans (FiniteSingleCoefficient[l].Over[R.ring].equation ZM.three J q Rel.ve) (R.ring.mulC (J q) Rel.ve) ;
     relation : Id R.ring.R Rel.Gvalue (R.ring.add (W.F.gen Rel.error-coeff) (W.C.value ys)) =
       trans Rel.relation (ap (R.ring.add Rel.error-value) (sym J-equation)) ;
     module GP = W.Power[Rel.Gvalue,Rel.error-coeff,ys,relation] ;
     module At (n : Nat) {
       p : Base.Nat = suc (BR.toB n) ;
       module Bound = SectionsDenominatorAlgebra[l].Bound[ZM.three,ST.delta,p] ;
       module Expr = SE.Expression[R.ring,Read.X q,Read.z,Inv.inverse,unit,(D0.P q).deg,
         \ i -> Read.T.scalar.1 ((D0.P q).low i),p,Bound.M] ;
       section : R.ring.R = Expr.section ;
       power-error : W.Witness p (P.power Rel.Gvalue p) = GP.witness p ;
       first-error : W.Witness (suc zero) (P.power Rel.Gvalue (suc zero)) = GP.witness (suc zero) ;
     } ;
   } ;
 } ;
 module Restriction (E F : Sub4) (le : Le4 E F) (q : Ps.Fin ZM.three)
   (hs : Le4 (setPt (affine q)) E) (ht : Le4 (setPt (affine q)) F) {
   module Source = AtChart[E] ; module Target = AtChart[F] ;
   module S = Source.Affine[q,hs] ; module T = Target.Affine[q,ht] ;
   module Map = ChartRestriction4[l].Over[A,setA,E,F,le] ;
   module Coords = CC.Restriction[A,setA,E,F,le] ;
   x-map : Id Target.R.ring.R (Map.hom.1 (Source.Read.X q)) (Target.Read.X q) =
     Map.constant (Source.R.B.term A.o (ST.ST.exS q)) ;
   z-map : Id Target.R.ring.R (Map.hom.1 Source.Read.z) Target.Read.z = Map.constant (Source.R.B.term A.o MonicFriendlySetup[l].zexp) ;
   c-map (i : Ps.Fin (D0.P q).deg) :
     Id Target.R.ring.R (Map.hom.1 (Source.Read.T.scalar.1 ((D0.P q).low i))) (Target.Read.T.scalar.1 ((D0.P q).low i)) =
     Map.constant (Source.R.B.cst ((D0.P q).low i)) ;
   module Natural = SE.Natural[Source.R.ring,Target.R.ring,Map.hom,
     Source.Read.X q,Source.Read.z,S.Inv.inverse,S.unit,
     Target.Read.X q,Target.Read.z,T.Inv.inverse,T.unit,x-map,z-map,Coords.Inverse[affine q,hs,ht].equation] ;
   module Coeff = Natural.At[(D0.P q).deg,\ i -> Source.Read.T.scalar.1 ((D0.P q).low i),\ i -> Target.Read.T.scalar.1 ((D0.P q).low i),c-map] ;
   section (n : Nat) : Id Target.R.ring.R (Map.hom.1 (S.At[n].section)) (T.At[n].section) = Coeff.Bound[S.At[n].p,S.At[n].Bound.M].section ;
   coefficient (n : Nat) (m : E4) : Id A.R (Source.R.coeff (S.At[n].section) m) (Target.R.coeff (T.At[n].section) m) =
     trans (sym (Map.coefficient (S.At[n].section) m)) (ap (\ x -> Target.R.coeff x m) (section n)) ;
 } ;
} ;
