-- Actual front-half section/witness regressions, without supplied
-- correction inputs. The nonreduced instance additionally checks that
-- the constructed order-two error is zero because (2)^2=0 in Z/4Z.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module BR = PolynomialRing4Bridge[l] ;
module IP = IdealPowers[l] ; module F = FiniteFibreSections4[l] ; module D = SectionsRegressionData4[l] ;
module Point (A : CRing) (setA : Pr.isSet A.R) {
 module Data = D.Point[A,setA] ; module S = F.Over[A,setA,Data.D0] ;
 witness (n : Nat) : S.CJ1.FC.Wit (suc (BR.toB n)) (S.w n) = S.wit n ;
 remainder (n : Nat) : S.CJ1.JW (S.CJ1.ML.msub (S.d.f (S.z n)) (S.w n)) = S.remainder n ;
 compatibility (n : Nat) : S.CJ0.IJ (suc zero) (S.CJ0.ML.msub (S.z n) (S.z zero)) = S.compatibility n ;
 normalisation (n : Nat) (m : E4) : Id A.R (S.CJ0.E.val (S.z n) p0 m)
   (S.C.D.AtChart[setPt p0].R.FP.delta0 (PolynomialAction4[l].addE m (nx (suc zero) zero zero zero))) = S.hz n m ;
} ;
module ZeroFibre (A : CRing) (setA : Pr.isSet A.R) {
 module Data = D.ZeroFibre[A,setA] ; module S = F.Over[A,setA,Data.D0] ;
 degree-zero : Id Nat Data.monic.deg zero = Data.monic-degree-zero ;
 witness (n : Nat) : S.CJ1.FC.Wit (suc (BR.toB n)) (S.w n) = S.wit n ;
 remainder (n : Nat) : S.CJ1.JW (S.CJ1.ML.msub (S.d.f (S.z n)) (S.w n)) = S.remainder n ;
 compatibility (n : Nat) : S.CJ0.IJ (suc zero) (S.CJ0.ML.msub (S.z n) (S.z zero)) = S.compatibility n ;
} ;
module Nonreduced {
 module Data = D.Nonreduced ; A : CRing = Data.A ;
 module S = F.Over[A,Data.setA,Data.D0] ;
 one : Nat = suc zero ; idx : Ps.Fin one = inr tt ;
 module NilpotentWitness (Md : IP.Mod[A]) {
   module P = FiniteIdealPowers[l].Over[A,Md,one,Data.b] ; module L = IP.ModL[A,Md] ;
   zero (x : Md.M) (w : P.Wit (suc (suc zero)) x) : Id Md.M x Md.mz =
     trans w.2.2
       (trans (Md.maddZ (Md.sm (Data.b idx) (w.1 idx)))
         (trans (ap (Md.sm (Data.b idx))
           (trans (w.2.1 idx).2.2 (Md.maddZ (Md.sm (Data.b idx) ((w.2.1 idx).1 idx)))))
           (trans (Md.smA (Data.b idx) (Data.b idx) ((w.2.1 idx).1 idx))
             (trans (ap (\ a -> Md.sm a ((w.2.1 idx).1 idx)) (Data.nilpotent idx)) (L.zero-sm ((w.2.1 idx).1 idx)))))) ;
 } ;
 witness (n : Nat) : S.CJ1.FC.Wit (suc (BR.toB n)) (S.w n) = S.wit n ;
 remainder (n : Nat) : S.CJ1.JW (S.CJ1.ML.msub (S.d.f (S.z n)) (S.w n)) = S.remainder n ;
 order-two-error-zero : Id S.CJ1.E.El (S.w one) S.CJ1.E.mod.mz = NilpotentWitness[S.CJ1.E.mod].zero (S.w one) (S.wit one) ;
 compatibility (n : Nat) : S.CJ0.IJ (suc zero) (S.CJ0.ML.msub (S.z n) (S.z zero)) = S.compatibility n ;
} ;
