-- Reversed monic polynomials on an affine projective chart. If xv=1,
-- u=zv, divide the homogeneous monic expression by x^d. Its lower part
-- is exactly u Q(u), with Q constructed recursively from the coefficients.
level l ; open Ring[l] ;
module Ps = Presentations[l] ; module BR = PolynomialRing4Bridge[l] ;
module Over (R : CRing) (x z v : R.R) (unit : Id R.R (R.mul x v) R.o) {
 module P = SectionsPowerAlgebra[l].Over[R] ; module L = RL[R] ;
 u : R.R = R.mul z v ;
 lower : (d : Nat) -> (Ps.Fin d -> R.R) -> R.R = split {
   zero -> \ c -> R.z ; suc d | rec -> \ c -> R.mul z
     (R.add (R.mul (c (inr tt)) (P.power x (BR.toB d))) (rec (\ i -> c (inl i)))) } ;
 quotient : (d : Nat) -> (Ps.Fin d -> R.R) -> R.R = split {
   zero -> \ c -> R.z ; suc d | rec -> \ c -> R.add (c (inr tt)) (R.mul u (rec (\ i -> c (inl i)))) } ;
 v-unit : Id R.R (R.mul v x) R.o = trans (R.mulC v x) unit ;
 power-unit : (d : Nat) -> Id R.R (R.mul (P.power v (BR.toB d)) (P.power x (BR.toB d))) R.o = split {
   zero -> L.one-left R.o ; suc d | rec -> trans (L.mul-four v (P.power v (BR.toB d)) x (P.power x (BR.toB d)))
     (trans (ap (\ a -> R.mul a (R.mul (P.power v (BR.toB d)) (P.power x (BR.toB d)))) v-unit)
       (trans (L.one-left (R.mul (P.power v (BR.toB d)) (P.power x (BR.toB d)))) rec)) } ;
 head (d : Nat) (c : R.R) :
   Id R.R (R.mul (P.power v (BR.toB d)) (R.mul c (P.power x (BR.toB d)))) c =
   trans (L.mul-swap (P.power v (BR.toB d)) c (P.power x (BR.toB d)))
     (trans (ap (R.mul c) (power-unit d)) (R.mulO c)) ;
 lower-factor : (d : Nat) (c : Ps.Fin d -> R.R) ->
   Id R.R (R.mul (P.power v (BR.toB d)) (lower d c)) (R.mul u (quotient d c)) = split {
   zero -> \ c -> trans (L.mul-zero R.o) (sym (L.mul-zero u)) ;
   suc d | rec -> \ c -> trans
     (L.mul-four v (P.power v (BR.toB d)) z (R.add (R.mul (c (inr tt)) (P.power x (BR.toB d))) (lower d (\ i -> c (inl i)))))
     (trans (ap (\ a -> R.mul a (R.mul (P.power v (BR.toB d)) (R.add (R.mul (c (inr tt)) (P.power x (BR.toB d))) (lower d (\ i -> c (inl i)))))) (R.mulC v z))
       (trans (ap (R.mul u) (R.dist (P.power v (BR.toB d)) (R.mul (c (inr tt)) (P.power x (BR.toB d))) (lower d (\ i -> c (inl i)))))
         (ap (R.mul u) (Ps.cong2 R.R R.add _ _ _ _ (head d (c (inr tt))) (rec (\ i -> c (inl i))))))) } ;
 monic (d : Nat) (c : Ps.Fin d -> R.R) : R.R = R.add (P.power x (BR.toB d)) (lower d c) ;
 monic-factor (d : Nat) (c : Ps.Fin d -> R.R) :
   Id R.R (R.mul (P.power v (BR.toB d)) (monic d c)) (R.add R.o (R.mul u (quotient d c))) =
   trans (R.dist (P.power v (BR.toB d)) (P.power x (BR.toB d)) (lower d c))
     (Ps.cong2 R.R R.add _ _ _ _ (power-unit d) (lower-factor d c)) ;
} ;
