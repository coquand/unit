-- FINITE-FIBRE SECTIONS, constructed from residual data alone.
-- z_n is explicit on every chart and exactly Z^-1 on the chart Z.
-- Its boundary has explicit I^(n+1) and J witnesses. Compatibility with
-- z_0 has an explicit I+J witness, then is propositionally truncated only
-- to match the unchanged ReesCorrection interface. No sequence of
-- choices and no finite-fibre section assumption occurs.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module ZM = ZMT4Certificate[l] ; module BR = PolynomialRing4Bridge[l] ;
module CF = ChartFamilyAssembly4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (D0 : ResidualAlgebra[l].Residual[A,setA,ZM.three]) {
 module ST = MonicFriendlySetup[l].Over[A,setA,D0] ;
 module C = SectionComponents4[l].Over[A,setA,D0] ;
 module CH = ReesChart4[l].Over[A,setA,D0.t,D0.b,ZM.three,ST.P,ST.e,ST.hp] ;
 module CJ0 = CH.JC[Pt,setPt,TopList4[l].mOne] ; module CJ1 = CH.JC[Ed,setEd,TopList4[l].mOne] ;
 module CE = Cech4[l].Over[A,setA] ;
 d : IdealPowers[l].Lin[A,CJ0.E.mod,CJ1.E.mod] = CE.D0 TopList4[l].mOne ;
 z (n : Nat) : CJ0.E.El = C.z n ;
 module Edges = SectionErrorRealization4[l].Over[A,setA,D0.t,D0.b,ZM.three,ST.P,ST.e,ST.hp,
   Ed,setEd,CF.six,CF.ed,CF.cover-ed,TopList4[l].mOne] ;
 module Edge (n : Nat) {
   module V = Edges.Input[suc (BR.toB n),\ e -> C.Edge[e].raw n,C.edge-witness n] ;
 } ;
 w (n : Nat) : CJ1.E.El = Edge[n].V.w ;
 wit (n : Nat) : CJ1.FC.Wit (suc (BR.toB n)) (w n) = Edge[n].V.ideal ;
 remainder (n : Nat) : CJ1.JW (CJ1.ML.msub (d.f (z n)) (w n)) =
   subst CJ1.JW (ap (\ x -> CJ1.ML.msub x (w n)) (C.edge-equation n)) Edge[n].V.remainder ;
 module Points = SectionErrorRealization4[l].Over[A,setA,D0.t,D0.b,ZM.three,ST.P,ST.e,ST.hp,
   Pt,setPt,CF.four,CF.pt,CF.cover-pt,TopList4[l].mOne] ;
 module Compatibility (n : Nat) {
   module V = Points.Input[suc zero,\ k -> C.Point[k].compat n,C.compat-witness n] ;
   witness : CJ0.IJW (suc zero) (CJ0.ML.msub (z n) (z zero)) =
     subst (CJ0.IJW (suc zero)) (C.compat-equation n) V.error ;
 } ;
 compatibility (n : Nat) : CJ0.IJ (suc zero) (CJ0.ML.msub (z n) (z zero)) =
   Tr.Trunc[CJ0.IJW (suc zero) (CJ0.ML.msub (z n) (z zero))].inc Compatibility[n].witness ;
 hz (n : Nat) (m : E4) : Id A.R (CJ0.E.val (z n) p0 m)
   (C.D.AtChart[setPt p0].R.FP.delta0 (PolynomialAction4[l].addE m (nx (suc zero) zero zero zero))) = C.hz0 n m ;
 hz0 (m : E4) : Id A.R (CJ0.E.val (z zero) p0 m)
   (C.D.AtChart[setPt p0].R.FP.delta0 (PolynomialAction4[l].addE m (nx (suc zero) zero zero zero))) = hz zero m ;
} ;
