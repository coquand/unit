-- Common denominator exponents and the exact conversion used on
-- overlaps: u^M H^p = ratio^M v^(M-delta*p) G^p for u=ratio*v,
-- G=v^delta H. The complementary exponent is supplied constructively
-- by the finite natural bound, never by a subtraction choice.
level l ; open Ring[l] ;
module NA = NatArith[l] ; module Ps = Presentations[l] ; module WP = WeightedParts4[l] ;
times (a : Base.Nat) : Base.Nat -> Base.Nat = split { zero -> zero ; suc p | rec -> NA.plus a rec } ;
positive-bound (a : Base.Nat) : (p : Base.Nat) -> NA.Le a (times a (suc p)) = split {
 zero -> (zero,sym (NA.plus-zero a)) ;
 suc p | rec -> NA.le-trans a (times a (suc p)) (NA.plus a (times a (suc p))) rec (NA.le-sum-r (times a (suc p)) a) } ;
module Bound (s : Nat) (delta : Ps.Fin s -> Base.Nat) (p : Base.Nat) {
 M : Base.Nat = WP.sumN s (\ k -> times (delta k) (suc p)) ;
 enough (k : Ps.Fin s) : NA.Le (times (delta k) p) M =
   NA.le-trans _ _ _ (NA.le-sum-r (times (delta k) p) (delta k)) (WP.le-sumN s (\ k -> times (delta k) (suc p)) k) ;
 compatible (k : Ps.Fin s) : NA.Le (delta k) M =
   NA.le-trans _ _ _ (positive-bound (delta k) p) (WP.le-sumN s (\ k -> times (delta k) (suc p)) k) ;
} ;
module Over (R : CRing) {
 module P = SectionsPowerAlgebra[l].Over[R] ; module L = RL[R] ;
 power-power (x : R.R) (d : Base.Nat) : (p : Base.Nat) -> Id R.R (P.power (P.power x d) p) (P.power x (times d p)) = split {
 zero -> refl R.o ; suc p | rec -> trans (ap (R.mul (P.power x d)) rec) (sym (P.power-add x d (times d p))) } ;
 module Clear (u v ratio H G : R.R) (eu : Id R.R u (R.mul ratio v))
   (delta p M : Base.Nat) (eG : Id R.R G (R.mul (P.power v delta) H)) (le : NA.Le (times delta p) M) {
   slack : Base.Nat = le.1 ;
   G-power : Id R.R (P.power G p) (R.mul (P.power v (times delta p)) (P.power H p)) =
     trans (ap (\ x -> P.power x p) eG)
       (trans (P.power-mul (P.power v delta) H p) (ap (\ x -> R.mul x (P.power H p)) (power-power v delta p))) ;
   v-power : Id R.R (P.power v M) (R.mul (P.power v slack) (P.power v (times delta p))) =
     trans (ap (P.power v) (sym le.2)) (P.power-add v slack (times delta p)) ;
   multiplier : R.R = R.mul (P.power ratio M) (P.power v slack) ;
   equation : Id R.R (R.mul (P.power u M) (P.power H p)) (R.mul multiplier (P.power G p)) =
     trans (ap (\ x -> R.mul x (P.power H p)) (trans (ap (\ x -> P.power x M) eu) (P.power-mul ratio v M)))
       (trans (ap (\ x -> R.mul (R.mul (P.power ratio M) x) (P.power H p)) v-power)
         (trans (sym (R.mulA (P.power ratio M) (R.mul (P.power v slack) (P.power v (times delta p))) (P.power H p)))
           (trans (ap (R.mul (P.power ratio M)) (sym (R.mulA (P.power v slack) (P.power v (times delta p)) (P.power H p))))
             (trans (R.mulA (P.power ratio M) (P.power v slack) (R.mul (P.power v (times delta p)) (P.power H p)))
               (ap (R.mul multiplier) (sym G-power)))))) ;
 } ;
} ;
