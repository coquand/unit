-- Explicit powers of H=1+uQ again have the form 1+uQ_p. The quotient
-- Q_p is a recursive formula, never an existentially chosen polynomial.
-- Natural-power arithmetic below also supplies denominator clearing.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module NA = NatArith[l] ;
module Over (R : CRing) {
 module L = RL[R] ; module M = IP.ModL[R,IP.regular R] ;
 power (x : R.R) : Base.Nat -> R.R = split { zero -> R.o ; suc p | rec -> R.mul x rec } ;
 power-add (x : R.R) : (p q : Base.Nat) -> Id R.R (power x (NA.plus p q)) (R.mul (power x p) (power x q)) = split {
 zero -> \ q -> sym (L.one-left (power x q)) ;
 suc p | rec -> \ q -> trans (ap (R.mul x) (rec q)) (R.mulA x (power x p) (power x q)) } ;
 power-mul (x y : R.R) : (p : Base.Nat) -> Id R.R (power (R.mul x y) p) (R.mul (power x p) (power y p)) = split {
 zero -> sym (L.one-left R.o) ; suc p | rec -> trans (ap (R.mul (R.mul x y)) rec)
   (L.mul-four x y (power x p) (power y p)) } ;
 module PowersOfOne (u Q H : R.R) (hH : Id R.R H (R.add R.o (R.mul u Q))) {
   quotient : Base.Nat -> R.R = split { zero -> R.z ; suc p | rec -> R.add Q (R.mul H rec) } ;
   factor : (p : Base.Nat) -> Id R.R (power H p) (R.add R.o (R.mul u (quotient p))) = split {
   zero -> sym (trans (ap (R.add R.o) (L.mul-zero u)) (R.addZ R.o)) ;
   suc p | rec -> calc R.R {
     R.mul H (power H p)
       =< ap (R.mul H) rec > R.mul H (R.add R.o (R.mul u (quotient p)))
       =< R.dist H R.o (R.mul u (quotient p)) > R.add (R.mul H R.o) (R.mul H (R.mul u (quotient p)))
       =< Ps.cong2 R.R R.add _ _ _ _ (trans (R.mulO H) hH) (L.mul-swap H u (quotient p))
       > R.add (R.add R.o (R.mul u Q)) (R.mul u (R.mul H (quotient p)))
       =< sym (R.addA R.o (R.mul u Q) (R.mul u (R.mul H (quotient p))))
       > R.add R.o (R.add (R.mul u Q) (R.mul u (R.mul H (quotient p))))
       =< ap (R.add R.o) (sym (R.dist u Q (R.mul H (quotient p))))
       > R.add R.o (R.mul u (quotient (suc p))) } } ;
 } ;
} ;
