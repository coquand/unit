-- Small unit and ratio identities used for affine/Z overlaps.
level l ; open Ring[l] ; open ZInt[l] ;
module Ps = Presentations[l] ;
module Over (R : CRing) {
 module P = SectionsPowerAlgebra[l].Over[R] ; module L = RL[R] ;
 one-power : (p : Base.Nat) -> Id R.R (P.power R.o p) R.o = split {
   zero -> refl R.o ; suc p | rec -> trans (L.one-left (P.power R.o p)) rec } ;
 ratio (Z x y vx vy : R.R) (ey : Id R.R (R.mul y vy) R.o) :
   Id R.R (R.mul Z vx) (R.mul (R.mul y vx) (R.mul Z vy)) =
   sym (trans (L.mul-four y vx Z vy)
     (trans (ap (\ c -> R.mul c (R.mul vx vy)) (R.mulC y Z))
       (trans (L.mul-four Z y vx vy)
         (trans (ap (R.mul (R.mul Z vx)) ey) (R.mulO (R.mul Z vx)))))) ;
 inverse-ratio (Z x vZ vx : R.R) (eZ : Id R.R (R.mul Z vZ) R.o) (ex : Id R.R (R.mul x vx) R.o) :
   Id R.R R.o (R.mul (R.mul x vZ) (R.mul Z vx)) =
   sym (trans (ap (R.mul (R.mul x vZ)) (R.mulC Z vx))
     (trans (L.mul-four x vZ vx Z)
       (trans (Ps.cong2 R.R R.mul _ _ _ _ ex (trans (R.mulC vZ Z) eZ)) (L.one-left R.o)))) ;
 factor-one (x : R.R) (p : Base.Nat) : Id R.R x (R.mul x (P.power R.o p)) =
   sym (trans (ap (R.mul x) (one-power p)) (R.mulO x)) ;
 error-one (a H : R.R) (p : Base.Nat) : Id R.R (R.mul a (P.power H (suc p)))
   (R.mul (R.mul a (P.power H p)) (P.power H (suc zero))) =
   trans (ap (R.mul a) (R.mulC H (P.power H p)))
     (trans (R.mulA a (P.power H p) H)
       (ap (R.mul (R.mul a (P.power H p))) (sym (R.mulO H)))) ;
} ;
