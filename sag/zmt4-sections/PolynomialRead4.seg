-- Read the ordinary four-variable term lists through ANY ring hom out
-- of their constructed polynomial ring. All operation comparisons are
-- named applications of the already checked polynomial tower bridge.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module BR = PolynomialRing4Bridge[l] ;
module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
zero-add : (u : N4) -> Id N4 (addN4 (nx zero zero zero zero) u) u = split { nx a b c d -> refl (nx a b c d) } ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module B = BR.Over[A,setA] ;
 base12 : RH.Hom A B.L2.T = RH.compose A B.L1.T B.L2.T B.L2.X.inclusion B.L1.X.inclusion ;
 base123 : RH.Hom A B.L3.T = RH.compose A B.L2.T B.L3.T B.L3.X.inclusion base12 ;
 base : RH.Hom A B.S = RH.compose A B.L3.T B.S B.L4.X.inclusion base123 ;
 module To (R : CRing) (f : RH.Hom B.S R) {
   module L = RL[R] ; module P = SectionsPowerAlgebra[l].Over[R] ;
   module S = Comb[l].Sums[R,IP.regular R] ;
   scalar : RH.Hom A R = RH.compose A B.S R f base ;
   term (c : A.R) (u : N4) : R.R = f.1 (B.term c u) ;
   read (p : TPoly A.R) : R.R = f.1 (B.phi p) ;
   read-zero : Id R.R (read nil) R.z = RH.zero B.S R f ;
   single (c : A.R) (u : N4) : Id R.R (read (cons (c,u) nil)) (term c u) =
     trans (f.2.2.1 (B.term c u) B.S.z) (trans (ap (R.add (term c u)) read-zero) (R.addZ (term c u))) ;
   app (p q : TPoly A.R) : Id R.R (read (Bar[l].app p q)) (R.add (read p) (read q)) =
     trans (ap f.1 (B.phi-app p q)) (f.2.2.1 (B.phi p) (B.phi q)) ;
   scale (c : A.R) (u : N4) (p : TPoly A.R) :
     Id R.R (read (B.PA.scaleT (c,u) p)) (R.mul (term c u) (read p)) =
     trans (ap f.1 (B.phi-scaleT (c,u) p)) (f.2.2.2 (B.term c u) (B.phi p)) ;
   constant (c : A.R) : Id R.R (term c (nx zero zero zero zero)) (scalar.1 c) =
     ap f.1 (B.term-zero c) ;
   term-one : Id R.R (term A.o (nx zero zero zero zero)) R.o = trans (constant A.o) scalar.2.1 ;
   product (c c' : A.R) (u v : N4) :
     Id R.R (R.mul (term c u) (term c' v)) (term (A.mul c c') (addN4 u v)) =
     trans (sym (f.2.2.2 (B.term c u) (B.term c' v))) (ap f.1 (B.term-mul c c' u v)) ;
   coefficient (c : A.R) (u : N4) : Id R.R (term c u) (R.mul (scalar.1 c) (term A.o u)) =
     trans (ap (\ a -> term a u) (sym (A.mulO c)))
       (trans (ap (term (A.mul c A.o)) (sym (zero-add u)))
       (trans (sym (product c A.o (nx zero zero zero zero) u))
         (ap (\ v -> R.mul v (term A.o u)) (constant c)))) ;
   sum : (t : Nat) (p : Ps.Fin t -> TPoly A.R) ->
     Id R.R (read (B.PA.psum t p)) (S.sum t (\ j -> read (p j))) = split {
     zero -> \ p -> read-zero ; suc t | rec -> \ p -> trans (app (p (inr tt)) (B.PA.psum t (\ i -> p (inl i))))
       (ap (R.add (read (p (inr tt)))) (rec (\ i -> p (inl i)))) } ;
 } ;
} ;
