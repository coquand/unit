-- Concrete residual inputs for front-half section regressions: the
-- finite point, a zero fibre with degree-zero monic equations, and a
-- nonreduced base with a genuinely nonzero ideal generator.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module ZM = ZMT4Certificate[l] ;
module ZC = ZMTCertificate[l] ; module RA = ResidualAlgebra[l] ;
module Point (A : CRing) (setA : Pr.isSet A.R) {
 module P = Presentations[l].Over[A,setA] ;
 monic : ZC.Monic[A] = ZC.mkMonic A (suc zero) (\ i -> A.z) ;
 D0 : RA.Residual[A,setA,ZM.three] = RA.mkResidual A setA ZM.three zero
   (\ j -> absurd A.R j) (\ i -> monic) (\ i j -> absurd (P.Expr (Ps.Fin ZM.three)) j) ;
 module Setup = MonicFriendlySetup[l].Over[A,setA,D0] ;
 delta-one (q : Ps.Fin ZM.three) : Id Base.Nat (Setup.delta q) (suc zero) = refl (suc zero) ;
 degree-two (q : Ps.Fin ZM.three) : Id Base.Nat (Setup.e q) (suc (suc zero)) = refl (suc (suc zero)) ;
} ;
module ZeroFibre (A : CRing) (setA : Pr.isSet A.R) {
 module P = Presentations[l].Over[A,setA] ;
 monic : ZC.Monic[A] = ZC.mkMonic A zero (\ i -> absurd A.R i) ;
 D0 : RA.Residual[A,setA,ZM.three] = RA.mkResidual A setA ZM.three zero
   (\ j -> absurd A.R j) (\ i -> monic) (\ i j -> absurd (P.Expr (Ps.Fin ZM.three)) j) ;
 module Setup = MonicFriendlySetup[l].Over[A,setA,D0] ;
 monic-degree-zero : Id Nat monic.deg zero = refl zero ;
 degree-one (q : Ps.Fin ZM.three) : Id Base.Nat (Setup.e q) (suc zero) = refl (suc zero) ;
} ;
module Nonreduced {
 module Z4 = ZMod4[l] ;
 A : CRing = Z4.ring ; setA : Pr.isSet A.R = Z4.set ;
 module P = Presentations[l].Over[A,setA] ;
 monic : ZC.Monic[A] = ZC.mkMonic A (suc (suc zero)) (\ i -> A.z) ;
 b (j : Ps.Fin (suc zero)) : A.R = q2 ;
 D0 : RA.Residual[A,setA,ZM.three] = RA.mkResidual A setA ZM.three (suc zero) b
   (\ i -> monic) (\ i j -> cst A.o) ;
 module Setup = MonicFriendlySetup[l].Over[A,setA,D0] ;
 nilpotent (j : Ps.Fin (suc zero)) : Id A.R (A.mul (b j) (b j)) A.z = refl A.z ;
 degree-three (q : Ps.Fin ZM.three) : Id Base.Nat (Setup.e q) (suc (suc (suc zero))) = refl (suc (suc (suc zero))) ;
} ;
