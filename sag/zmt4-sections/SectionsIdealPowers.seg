-- Calculus of EXPLICIT finite ideal-power witness trees. Multiplication
-- by any ring element, addition and powers retain witnesses. A power
-- congruence modulo an explicitly generated ideal is constructed by a
-- telescoping recursion, with no binomial expansion or choices.
level l ; open Ring[l] ;
module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module Pr = Prelude[l] ;
module Over (R : CRing) (t : Nat) (b : Ps.Fin t -> R.R) {
 module F = FiniteIdealPowers[l].Over[R,IP.regular R,t,b] ;
 module S = Comb[l].Sums[R,IP.regular R] ; module L = RL[R] ;
 module G = IP.ModL[R,IP.regular R] ; module P = SectionsPowerAlgebra[l].Over[R] ;
 mul-gen (c : R.R) (xs : Ps.Fin t -> R.R) :
   Id R.R (R.mul c (F.gen xs)) (F.gen (\ j -> R.mul c (xs j))) =
   trans (S.sum-sm t c (\ j -> R.mul (b j) (xs j)))
     (S.sum-cong t (\ j -> R.mul c (R.mul (b j) (xs j))) (\ j -> R.mul (b j) (R.mul c (xs j))) (\ j -> L.mul-swap c (b j) (xs j))) ;
 scale (c : R.R) : (p : Base.Nat) (x : R.R) -> F.Wit p x -> F.Wit p (R.mul c x) = split {
   zero -> \ x w -> tt ;
   suc p | rec -> \ x w -> (\ j -> R.mul c (w.1 j),
     (\ j -> rec (w.1 j) (w.2.1 j),trans (ap (R.mul c) w.2.2) (mul-gen c w.1))) } ;
 add : (p : Base.Nat) (x y : R.R) -> F.Wit p x -> F.Wit p y -> F.Wit p (R.add x y) = split {
   zero -> \ x y wx wy -> tt ;
   suc p | rec -> \ x y wx wy -> (\ j -> R.add (wx.1 j) (wy.1 j),
     (\ j -> rec (wx.1 j) (wy.1 j) (wx.2.1 j) (wy.2.1 j),
       trans (G.G.cong-add wx.2.2 wy.2.2) (sym (S.comb-addv t b wx.1 wy.1)))) } ;
 neg (p : Base.Nat) (x : R.R) (w : F.Wit p x) : F.Wit p (R.neg x) =
   F.wit-tr p (R.mul (R.neg R.o) x) (R.neg x)
     (trans (L.neg-mul-left R.o x) (ap R.neg (L.one-left x))) (scale (R.neg R.o) p x w) ;
 sub (p : Base.Nat) (x y : R.R) (wx : F.Wit p x) (wy : F.Wit p y) : F.Wit p (G.msub x y) = add p x (R.neg y) wx (neg p y wy) ;
 module Power (xs : Ps.Fin t -> R.R) {
   x : R.R = F.gen xs ;
   witness : (p : Base.Nat) -> F.Wit p (P.power x p) = split {
     zero -> tt ; suc p | rec -> (\ j -> R.mul (xs j) (P.power x p),
       (\ j -> scale (xs j) p (P.power x p) rec,
         trans (R.mulC x (P.power x p))
           (trans (mul-gen (P.power x p) xs)
             (S.sum-cong t (\ j -> R.mul (b j) (R.mul (P.power x p) (xs j))) (\ j -> R.mul (b j) (R.mul (xs j) (P.power x p))) (\ j -> ap (R.mul (b j)) (R.mulC (P.power x p) (xs j))))))) } ;
 } ;
 module Congruence (s : Nat) (J : Ps.Fin s -> R.R) {
   module JS = Comb[l].Sums[R,IP.regular R] ;
   value (ys : Ps.Fin s -> R.R) : R.R = JS.comb s J ys ;
   scale-value (c : R.R) (ys : Ps.Fin s -> R.R) : Id R.R (R.mul c (value ys)) (value (\ j -> R.mul c (ys j))) =
     trans (JS.sum-sm s c (\ j -> R.mul (J j) (ys j))) (JS.sum-cong s (\ j -> R.mul c (R.mul (J j) (ys j))) (\ j -> R.mul (J j) (R.mul c (ys j))) (\ j -> L.mul-swap c (J j) (ys j))) ;
   add-value (xs ys : Ps.Fin s -> R.R) : Id R.R (R.add (value xs) (value ys)) (value (\ j -> R.add (xs j) (ys j))) =
     sym (JS.comb-addv s J xs ys) ;
   chain (x y z : R.R) : Id R.R (R.add (G.msub x y) (G.msub y z)) (G.msub x z) =
     trans (sym (R.addA x (R.neg y) (R.add y (R.neg z))))
       (trans (ap (R.add x) (R.addA (R.neg y) y (R.neg z)))
         (trans (ap (\ c -> R.add x (R.add c (R.neg z))) (trans (R.addC (R.neg y) y) (R.addN y)))
           (ap (R.add x) (G.G.zl (R.neg z))))) ;
   telescoping (x y z w : R.R) : Id R.R (G.msub (R.mul x z) (R.mul y w))
     (R.add (R.mul x (G.msub z w)) (R.mul (G.msub x y) w)) =
     sym (trans (G.G.cong-add (G.sm-sub x z w)
       (trans (L.dist-left x (R.neg y) w) (ap (R.add (R.mul x w)) (L.neg-mul-left y w))))
       (chain (R.mul x z) (R.mul x w) (R.mul y w))) ;
   module PowerDifference (x y : R.R) (ys : Ps.Fin s -> R.R) (eq : Id R.R (G.msub x y) (value ys)) {
     coeff : Base.Nat -> Ps.Fin s -> R.R = split {
       zero -> \ j -> R.z ; suc p | rec -> \ j -> R.add (R.mul x (rec j)) (R.mul (P.power y p) (ys j)) } ;
     equation : (p : Base.Nat) -> Id R.R (G.msub (P.power x p) (P.power y p)) (value (coeff p)) = split {
       zero -> trans (R.addN R.o) (sym (JS.comb-vanish s J (\ j -> R.z) (\ j -> refl R.z))) ;
       suc p | rec -> trans (telescoping x y (P.power x p) (P.power y p))
         (trans (G.G.cong-add (trans (ap (R.mul x) rec) (scale-value x (coeff p)))
           (trans (ap (\ v -> R.mul v (P.power y p)) eq)
             (trans (R.mulC (value ys) (P.power y p)) (scale-value (P.power y p) ys))))
           (add-value (\ j -> R.mul x (coeff p j)) (\ j -> R.mul (P.power y p) (ys j)))) } ;
   } ;
 } ;
} ;
