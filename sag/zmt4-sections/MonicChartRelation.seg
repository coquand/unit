-- The monic-friendly equations give the REQUIRED chart relation.
-- In any ring receiving S, with x_k v=1, set u=Zv. The normalised
-- monic part is H=1+uQ, and
--   u^delta H = sum_j b_j (v^e h_kj) + v^e P_k.
-- This is derived from the constructed residual polynomials, not assumed.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module BR = PolynomialRing4Bridge[l] ; module NA = NatArith[l] ; module IP = IdealPowers[l] ;
module MS = MonicFriendlySetup[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (D0 : ResidualAlgebra[l].Residual[A,setA,ZMT4Certificate[l].three]) {
 module ST = MS.Over[A,setA,D0] ; module PR = PolynomialRead4[l].Over[A,setA] ; module B = PR.B ;
 module To (R : CRing) (f : RH.Hom B.S R) {
   module T = PR.To[R,f] ; module P = SectionsPowerAlgebra[l].Over[R] ; module L = RL[R] ;
   module G = IP.ModL[R,IP.regular R] ; module S = T.S ;
   z : R.R = T.term A.o MS.zexp ;
   X (q : Ps.Fin ZMT4Certificate[l].three) : R.R = T.term A.o (ST.ST.exS q) ;
   read-X (q : Ps.Fin ZMT4Certificate[l].three) : (d : Base.Nat) -> Id R.R (T.term A.o (ST.xp q d)) (P.power (X q) d) = split {
     zero -> T.term-one ; suc d | rec ->
       trans (ap (\ c -> T.term c (ST.xp q (suc d))) (sym (A.mulO A.o)))
         (trans (sym (T.product A.o A.o (ST.ST.exS q) (ST.xp q d))) (ap (R.mul (X q)) rec)) } ;
   read-Z : (d : Base.Nat) -> Id R.R (T.term A.o (nx d zero zero zero)) (P.power z d) = split {
     zero -> T.term-one ; suc d | rec ->
       trans (ap (\ c -> T.term c (nx (suc d) zero zero zero)) (sym (A.mulO A.o)))
         (trans (sym (T.product A.o A.o MS.zexp (nx d zero zero zero))) (ap (R.mul z) rec)) } ;
   read-head (q : Ps.Fin ZMT4Certificate[l].three) (d : Nat) (c : A.R) :
     Id R.R (T.read (cons (c,ST.xp q (BR.toB d)) nil)) (R.mul (T.scalar.1 c) (P.power (X q) (BR.toB d))) =
     trans (T.single c (ST.xp q (BR.toB d)))
       (trans (T.coefficient c (ST.xp q (BR.toB d))) (ap (R.mul (T.scalar.1 c)) (read-X q (BR.toB d)))) ;
   module Chart (q : Ps.Fin ZMT4Certificate[l].three) (v : R.R) (unit : Id R.R (R.mul (X q) v) R.o) {
     module N = NormalizedMonicAlgebra[l].Over[R,X q,z,v,unit] ;
     d : Nat = (D0.P q).deg ;
     u : R.R = N.u ; Q : R.R = N.quotient d (\ i -> T.scalar.1 ((D0.P q).low i)) ;
     H : R.R = R.add R.o (R.mul u Q) ;
     lower-read : (a : Nat) (c : Ps.Fin a -> A.R) ->
       Id R.R (T.read (ST.lower q a c)) (N.lower a (\ i -> T.scalar.1 (c i))) = split {
       zero -> \ c -> T.read-zero ; suc a | rec -> \ c ->
         trans (T.scale A.o MS.zexp (Bar[l].app (cons (c (inr tt),ST.xp q (BR.toB a)) nil) (ST.lower q a (\ i -> c (inl i)))))
           (ap (R.mul z) (trans (T.app (cons (c (inr tt),ST.xp q (BR.toB a)) nil) (ST.lower q a (\ i -> c (inl i))))
             (Ps.cong2 R.R R.add _ _ _ _ (read-head q a (c (inr tt))) (rec (\ i -> c (inl i)))))) } ;
     monic-read : Id R.R (T.read (ST.monic q)) (N.monic d (\ i -> T.scalar.1 ((D0.P q).low i))) =
       trans (T.app _ _) (Ps.cong2 R.R R.add _ _ _ _
         (trans (T.single A.o (ST.xp q (BR.toB d))) (read-X q (BR.toB d)))
         (lower-read d (D0.P q).low)) ;
     normalised-monic : Id R.R (R.mul (P.power v (BR.toB d)) (T.read (ST.monic q))) H =
       trans (ap (R.mul (P.power v (BR.toB d))) monic-read) (N.monic-factor d (\ i -> T.scalar.1 ((D0.P q).low i))) ;
     Gvalue : R.R = R.mul (P.power u (ST.delta q)) H ;
     ve : R.R = P.power v (ST.e q) ;
     leading : R.R = T.read (ST.zscale (ST.delta q) (ST.monic q)) ;
     read-leading : Id R.R leading (R.mul (P.power z (ST.delta q)) (T.read (ST.monic q))) =
       trans (T.scale A.o (nx (ST.delta q) zero zero zero) (ST.monic q))
         (ap (\ t -> R.mul t (T.read (ST.monic q))) (read-Z (ST.delta q))) ;
     normalised-leading : Id R.R (R.mul ve leading) Gvalue =
       trans (ap (R.mul ve) read-leading)
         (trans (ap (\ t -> R.mul t (R.mul (P.power z (ST.delta q)) (T.read (ST.monic q))))
           (trans (P.power-add v (BR.toB d) (ST.delta q)) (R.mulC (P.power v (BR.toB d)) (P.power v (ST.delta q)))))
           (trans (L.mul-four (P.power v (ST.delta q)) (P.power v (BR.toB d)) (P.power z (ST.delta q)) (T.read (ST.monic q)))
             (Ps.cong2 R.R R.mul _ _ _ _
               (trans (R.mulC (P.power v (ST.delta q)) (P.power z (ST.delta q))) (sym (P.power-mul z v (ST.delta q)))) normalised-monic))) ;
     error-coeff (j : Ps.Fin D0.t) : R.R = R.mul ve (T.read (ST.hT q j)) ;
     error-value : R.R = S.comb D0.t (\ j -> T.scalar.1 (D0.b j)) error-coeff ;
     read-error : Id R.R (T.read (ST.error q)) (S.sum D0.t (\ j -> R.mul (T.scalar.1 (D0.b j)) (T.read (ST.hT q j)))) =
       trans (T.sum D0.t (\ j -> ST.scalar (D0.b j) (ST.hT q j)))
         (S.sum-cong D0.t _ _ (\ j -> trans (T.scale (D0.b j) MS.zeroexp (ST.hT q j))
           (ap (\ c -> R.mul c (T.read (ST.hT q j))) (T.constant (D0.b j))))) ;
     normalised-error : Id R.R (R.mul ve (T.read (ST.error q))) error-value =
       trans (ap (R.mul ve) read-error)
         (trans (S.sum-sm D0.t ve (\ j -> R.mul (T.scalar.1 (D0.b j)) (T.read (ST.hT q j))))
           (S.sum-cong D0.t (\ j -> R.mul ve (R.mul (T.scalar.1 (D0.b j)) (T.read (ST.hT q j))))
             (\ j -> R.mul (T.scalar.1 (D0.b j)) (error-coeff j))
             (\ j -> L.mul-swap ve (T.scalar.1 (D0.b j)) (T.read (ST.hT q j))))) ;
     negative-one (x : R.R) : Id R.R (R.mul (T.scalar.1 (A.neg A.o)) x) (R.neg x) =
       trans (ap (\ c -> R.mul c x) (trans (RH.negation A R T.scalar A.o) (ap R.neg T.scalar.2.1)))
         (trans (L.neg-mul-left R.o x) (ap R.neg (L.one-left x))) ;
     read-P : Id R.R (T.read (ST.P q)) (G.msub leading (T.read (ST.error q))) =
       trans (T.app (ST.zscale (ST.delta q) (ST.monic q)) (ST.scalar (A.neg A.o) (ST.error q))) (ap (R.add leading)
         (trans (T.scale (A.neg A.o) MS.zeroexp (ST.error q))
           (trans (ap (\ c -> R.mul c (T.read (ST.error q))) (T.constant (A.neg A.o))) (negative-one (T.read (ST.error q)))))) ;
     normalised-P : Id R.R (R.mul ve (T.read (ST.P q))) (G.msub Gvalue error-value) =
       trans (ap (R.mul ve) read-P)
         (trans (G.sm-sub ve leading (T.read (ST.error q)))
           (Ps.cong2 R.R G.msub _ _ _ _ normalised-leading normalised-error)) ;
     relation : Id R.R Gvalue (R.add error-value (R.mul ve (T.read (ST.P q)))) =
       sym (trans (ap (R.add error-value) normalised-P)
         (trans (R.addA error-value Gvalue (R.neg error-value))
           (trans (ap (\ c -> R.add c (R.neg error-value)) (R.addC error-value Gvalue)) (L.add-neg-cancel Gvalue error-value)))) ;
   } ;
 } ;
} ;
