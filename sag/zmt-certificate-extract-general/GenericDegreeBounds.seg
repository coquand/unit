-- Complementary-summand degree bounds and a constructive coordinate
-- dichotomy: a monomial is bounded by the sum of the thresholds, or one
-- coordinate factors off y_i^(a_i+1). Works also in zero variables.
level l ; open Ring[l] ;
module NA=NatArith[l] ; module N=FiniteExponents[l] ; module Ps=Presentations[l] ;
module RB=ReesBridge4[l] ; module Pr=Prelude[l] ;
Le (a b : Base.Nat) : U l=(r : Base.Nat)*Id Base.Nat (NA.plus a r) b ;
swap4 (a b c d : Base.Nat) : Id Base.Nat (NA.plus (NA.plus a b) (NA.plus c d)) (NA.plus (NA.plus a c) (NA.plus b d))=
 trans (NA.plus-assoc a b (NA.plus c d))
  (trans (ap (NA.plus a) (sym (NA.plus-assoc b c d)))
   (trans (ap (\x -> NA.plus a (NA.plus x d)) (NA.plus-comm b c))
    (trans (ap (NA.plus a) (NA.plus-assoc c b d)) (sym (NA.plus-assoc a c (NA.plus b d)))))) ;
le-add (a b c d : Base.Nat) (h : Le a b) (q : Le c d) : Le (NA.plus a c) (NA.plus b d)=
 (NA.plus h.1 q.1,trans (swap4 a c h.1 q.1) (Ps.cong2 Base.Nat NA.plus _ _ _ _ h.2 q.2)) ;
le-trans (a b c : Base.Nat) (h : Le a b) (q : Le b c) : Le a c=
 (NA.plus h.1 q.1,trans (sym (NA.plus-assoc a h.1 q.1)) (trans (ap (\x -> NA.plus x q.1) h.2) q.2)) ;
le-tr (a b c : Base.Nat) (h : Le a b) (q : Id Base.Nat b c) : Le a c=(h.1,trans h.2 q) ;
le-refl (a : Base.Nat) : Le a a=(zero,NA.plus-zero a) ;
le-next (a : Base.Nat) : Le a (suc a)=(suc zero,trans (NA.plus-suc a zero) (ap (\x -> suc x) (NA.plus-zero a))) ;
le-suc (a b : Base.Nat) (h : Le a b) : Le (suc a) (suc b)=(h.1,ap (\x -> suc x) h.2) ;
pull (a b c : Base.Nat) : Id Base.Nat (NA.plus (NA.plus a b) c) (NA.plus (NA.plus a c) b)=
 trans (NA.plus-assoc a b c) (trans (ap (NA.plus a) (NA.plus-comm b c)) (sym (NA.plus-assoc a c b))) ;
module Over (E : CRing) {
 module M=GenericDehomogenisation[l].Monomials[E] ; module P=M.P ; module L=RL[E] ;
 Large (n : Nat) (y : Ps.Fin n -> E.R) (u a : N.Exp n) : U l=
  (i : Ps.Fin n)*((v : N.Exp n)*
   (Id Base.Nat (N.degree n u) (NA.plus (N.degree n v) (suc (a i))) *
    Id E.R (M.value n y u) (E.mul (M.value n y v) (P.power (y i) (suc (a i)))))) ;
 Result (n : Nat) (y : Ps.Fin n -> E.R) (u a : N.Exp n) : U l=Plus (Le (N.degree n u) (N.degree n a)) (Large n y u a) ;
 module Step (n : Nat) (y : Ps.Fin (suc n) -> E.R) (u a : N.Exp (suc n)) {
  module Tail { yy (i : Ps.Fin n) : E.R=y (inl i) ; } ;

  module TailLarge (w : Large n Tail.yy (N.old n u) (N.old n a)) {
   v : N.Exp (suc n)=N.join n w.2.1 (u (inr tt)) ;
   degree : Id Base.Nat (N.degree (suc n) u) (NA.plus (N.degree (suc n) v) (suc (a (inl w.1))))=
    trans (ap (NA.plus (u (inr tt))) w.2.2.1)
     (sym (NA.plus-assoc (u (inr tt)) (N.degree n w.2.1) (suc (a (inl w.1))))) ;
   oldmon : E.R=M.value n Tail.yy w.2.1 ;
   powold : E.R=P.power (y (inl w.1)) (suc (a (inl w.1))) ;
   pownew : E.R=P.power (y (inr tt)) (u (inr tt)) ;
   mon : Id E.R (M.value (suc n) y u) (E.mul (M.value (suc n) y v) powold)=
    trans (ap (\z -> E.mul z pownew) w.2.2.2)
     (trans (sym (E.mulA oldmon powold pownew))
      (trans (ap (E.mul oldmon) (E.mulC powold pownew)) (E.mulA oldmon pownew powold))) ;
   result : Large (suc n) y u a=(inl w.1,(v,(degree,mon))) ;
  } ;
  lift-large (w : Large n Tail.yy (N.old n u) (N.old n a)) : Large (suc n) y u a=TailLarge[w].result ;
  tail-case (h : Le (u (inr tt)) (a (inr tt))) : Result n Tail.yy (N.old n u) (N.old n a) -> Result (suc n) y u a=split {
   inl q -> inl (le-add (u (inr tt)) (a (inr tt)) (N.degree n (N.old n u)) (N.degree n (N.old n a)) h q) ;
   inr w -> inr (lift-large w) } ;

  module HeadLarge (r : Base.Nat) (eq : Id Base.Nat (u (inr tt)) (NA.plus (suc r) (a (inr tt)))) {
   head-eq : Id Base.Nat (u (inr tt)) (NA.plus r (suc (a (inr tt))))=trans eq (sym (NA.plus-suc r (a (inr tt)))) ;
   v : N.Exp (suc n)=N.join n (N.old n u) r ;
   degree : Id Base.Nat (N.degree (suc n) u) (NA.plus (N.degree (suc n) v) (suc (a (inr tt))))=
    trans (ap (\x -> NA.plus x (N.degree n (N.old n u))) head-eq)
     (pull r (suc (a (inr tt))) (N.degree n (N.old n u))) ;
   mon : Id E.R (M.value (suc n) y u) (E.mul (M.value (suc n) y v) (P.power (y (inr tt)) (suc (a (inr tt)))))=
    trans (ap (\x -> E.mul (M.value n Tail.yy (N.old n u)) (P.power (y (inr tt)) x)) head-eq)
     (trans (ap (E.mul (M.value n Tail.yy (N.old n u))) (P.power-add (y (inr tt)) r (suc (a (inr tt)))))
      (E.mulA (M.value n Tail.yy (N.old n u)) (P.power (y (inr tt)) r) (P.power (y (inr tt)) (suc (a (inr tt)))))) ;
   result : Large (suc n) y u a=(inr tt,(v,(degree,mon))) ;
  } ;
  head-large (r : Base.Nat) (eq : Id Base.Nat (u (inr tt)) (NA.plus (suc r) (a (inr tt)))) : Large (suc n) y u a=HeadLarge[r,eq].result ;
  inspect (tail : Result n Tail.yy (N.old n u) (N.old n a)) : RB.Dich (u (inr tt)) (a (inr tt)) -> Result (suc n) y u a=split {
   inl h -> tail-case h tail ; inr h -> inr (head-large h.1 h.2) } ;
 } ;
 classify : (n : Nat) (y : Ps.Fin n -> E.R) (u a : N.Exp n) -> Result n y u a=split {
  zero -> \y u a -> inl (zero,refl zero) ;
  suc n | rec -> \y u a -> Step[n,y,u,a].inspect (rec (\i -> y (inl i)) (N.old n u) (N.old n a)) (RB.dich (u (inr tt)) (a (inr tt))) } ;
} ;
-- A degree with a positive excess above d cannot also be bounded by d.
not-over (u d b : Base.Nat) (big : Id Base.Nat u (NA.plus (suc b) d)) (small : Le u d) : Empty=
 WeightedParts4[l].not-le-suc d (NA.plus b small.1)
  (trans (NA.plus-suc (NA.plus b small.1) d)
   (trans (ap (\x -> suc x) (pull b small.1 d))
    (trans (ap (\x -> NA.plus x small.1) (sym big)) small.2))) ;
