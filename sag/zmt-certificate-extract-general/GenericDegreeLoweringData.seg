-- The exact finite input supplied by corrected-section extraction.
-- Z is the newest homogeneous coordinate, set to1 by dehomogenisation.
-- All displayed homogeneous degrees are nonnegative natural integers;
-- zero polynomial lists and empty affine/ideal generator lists are valid.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module RH=RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (E : CRing) (setE : Pr.isSet E.R)
 (iota : RH.Hom R E) (m : Nat) (y : Ps.Fin m -> E.R) (t : Nat) (b : Ps.Fin t -> R.R) {
 module Ev=GenericDehomogenisation[l].Over[R,E,setR,iota,m,y] ;
 module X=CechPolynomialAction[l].Over[R,setR,suc m] ;
 module P=SectionsPowerAlgebra[l].Over[E] ;
 module Ideal=FiniteIdeal[l].Over[E,t,\j -> iota.1 (b j)] ;
 record Data {
  s : E.R ;
  degree : Base.Nat ;
  sT : Ev.Polys ;
  homS : X.Hom (pos degree) sT ;
  valueS : Id E.R (Ev.deh sT) s ;
  a : Ps.Fin m -> Base.Nat ;
  q : Ps.Fin m -> Ev.Polys ;
  homQ (i : Ps.Fin m) : X.Hom (pos (a i)) (q i) ;
  lower (i : Ps.Fin m) : Id E.R (E.mul s (P.power (y i) (suc (a i)))) (Ev.deh (q i)) ;
  congruence : Ideal.Certificate s E.o ;
 } ;
} ;
