-- Certificates from fully constructed lowering data, including four
-- affine generators, empty affine/ideal families, and a nonreduced ring
-- with genuinely nonzero generators. No stability or finiteness is input.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module RH=RingHom[l] ;
module N=FiniteExponents[l] ; module ZC=ZMTCertificate[l] ;
one : Nat=suc zero ; two : Nat=suc one ; three : Nat=suc two ; four : Nat=suc three ;
module ZeroPoint (R : CRing) (setR : Pr.isSet R.R) (m : Nat) {
 iota : RH.Hom R R=RH.identity R ;
 y (i : Ps.Fin m) : R.R=R.z ;
 b (j : Ps.Fin zero) : R.R=absurd R.R j ;
 module C=GenericDegreeLoweringCertificate[l].Over[R,setR,R,setR,iota,m,y,zero,b] ;
 module D=C.Input ; module Ev=D.Ev ; module LE=RL[R] ;
 sT : Ev.Polys=cons (R.o,N.zeroE (suc m)) nil ;
 hsT : D.X.Hom (pos zero) sT=(ap (\a -> pos a) (CoordinateExponents[l].zero-degree (suc m)),tt) ;
 dehS : Id R.R (Ev.deh sT) R.o=
  trans (R.addZ (R.mul R.o (Ev.mon (N.zeroE (suc m)))))
   (trans (LE.one-left (Ev.mon (N.zeroE (suc m)))) (CoordinateExponents[l].Monomials[R].zero-value m y)) ;
 a (i : Ps.Fin m) : Base.Nat=zero ;
 q (i : Ps.Fin m) : Ev.Polys=nil ;
 hq (i : Ps.Fin m) : D.X.Hom (pos (a i)) (q i)=tt ;
 lower (i : Ps.Fin m) : Id R.R (R.mul R.o (D.P.power (y i) (suc (a i)))) (Ev.deh (q i))=
  trans (LE.one-left (R.mul R.z R.o)) (R.mulO R.z) ;
 input : D.Data=D.mkData R.o zero sT hsT dehS a q hq lower (D.Ideal.reflexive R.o) ;
 certificate : ZC.ZMTCert[R,R,iota,m,y,zero,b]=C.certificate input ;
 module W=C.WithData[input] ;
 degree-zero : Id Base.Nat W.d zero=CoordinateExponents[l].zero-degree m ;
 small : W.Reduced (N.zeroE m)=W.small (N.zeroE m) (GenericDegreeBounds[l].le-refl (N.degree m (N.zeroE m))) ;
 module Variable (i : Ps.Fin m) {
  u : N.Exp m=CoordinateExponents[l].axis m i ;
  bound : GenericDegreeBounds[l].Le (N.degree m u) (suc W.d)=
   (zero,trans (NatArith[l].plus-zero (N.degree m u))
    (trans (CoordinateExponents[l].degree m i) (sym (ap (\d -> suc d) degree-zero)))) ;
  reduced : W.Reduced u=W.reduction u bound ;
 } ;
} ;
module Empty=ZeroPoint[ZRing[l].ring,ZRing[l].set,zero] ;
module Four=ZeroPoint[ZRing[l].ring,ZRing[l].set,four] ;
module Nonreduced {
 module R=ZMod4[l] ;
 iota : RH.Hom R.ring R.ring=RH.identity R.ring ;
 y (i : Ps.Fin four) : R.ring.R=q2 ;
 b (i : Ps.Fin one) : R.ring.R=q2 ;
 module C=GenericDegreeLoweringCertificate[l].Over[R.ring,R.set,R.ring,R.set,iota,four,y,one,b] ;
 module D=C.Input ;
 sT : D.Ev.Polys=cons (q1,N.zeroE (suc four)) nil ;
 hsT : D.X.Hom (pos zero) sT=(ap (\a -> pos a) (CoordinateExponents[l].zero-degree (suc four)),tt) ;
 dehS : Id R.ring.R (D.Ev.deh sT) q1=
  trans (R.ring.addZ (R.ring.mul q1 (D.Ev.mon (N.zeroE (suc four)))))
   (trans (RL[R.ring].one-left (D.Ev.mon (N.zeroE (suc four)))) (CoordinateExponents[l].Monomials[R.ring].zero-value four y)) ;
 a (i : Ps.Fin four) : Base.Nat=suc zero ;
 q (i : Ps.Fin four) : D.Ev.Polys=nil ;
 hq (i : Ps.Fin four) : D.X.Hom (pos (a i)) (q i)=tt ;
 lower (i : Ps.Fin four) : Id R.ring.R (R.ring.mul q1 (D.P.power (y i) (suc (a i)))) (D.Ev.deh (q i))=refl q0 ;
 input : D.Data=D.mkData q1 zero sT hsT dehS a q hq lower (D.Ideal.reflexive q1) ;
 certificate : ZC.ZMTCert[R.ring,R.ring,iota,four,y,one,b]=C.certificate input ;
} ;
