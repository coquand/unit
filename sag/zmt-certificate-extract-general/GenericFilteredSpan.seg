-- One concrete finite module generated by monomials of affine degree<=d.
-- A static finite box may contain redundant zero generators. Expansion
-- selects an actual index for each bounded monomial, then adds unit
-- coordinate vectors; repeated exponents are never counted twice.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module RH=RingHom[l] ;
module N=FiniteExponents[l] ; module B=GenericDegreeBounds[l] ; module NA=NatArith[l] ;
module FL=FiniteLookup[l] ; module L=GenericLaurent[l] ; module RB=ReesBridge4[l] ;
module Lists (Ex : U l) {
 find : (xs : List Ex) (u : Ex) -> L.Mem Ex u xs -> (j : Ps.Fin (FL.length Ex xs))*Id Ex (FL.at Ex xs j) u=split {
  nil -> \u h -> absurd ((j : Ps.Fin zero)*Id Ex (FL.at Ex nil j) u) h ;
  cons x xs | rec -> \u -> choose x xs u (rec u) }
 where { choose (x : Ex) (xs : List Ex) (u : Ex)
  (rec : L.Mem Ex u xs -> (j : Ps.Fin (FL.length Ex xs))*Id Ex (FL.at Ex xs j) u) :
   L.Mem Ex u (cons x xs) -> (j : Ps.Fin (FL.length Ex (cons x xs)))*Id Ex (FL.at Ex (cons x xs) j) u=split {
   inl e -> (inr tt,e) ; inr h -> (inl (rec h).1,(rec h).2) } } ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) (E : CRing) (setE : Pr.isSet E.R)
 (iota : RH.Hom R E) (m : Nat) (y : Ps.Fin m -> E.R) (d : Base.Nat) {
 module Ev=GenericDehomogenisation[l].Over[R,E,setR,iota,m,y] ; module M=Ev.M ; module LE=RL[E] ;
 module F=FibreSpan[l].Over[R,E,iota,zero,\j -> absurd E.R j] ; module S=FiniteIdeal[l].Sums[E] ;
 module X=CechPolynomialAction[l].Over[R,setR,suc m] ;
 mon (u : N.Exp m) : E.R=M.value m y u ;
 Bound (b : Base.Nat) : Ev.Polys -> U l=split { nil -> Top ; cons u p | rec -> B.Le (N.degree m (N.old m u.2)) b * rec } ;
 from-hom (b : Base.Nat) : (p : Ev.Polys) -> X.Hom (pos b) p -> Bound b p=split {
  nil -> \h -> tt ; cons u p | rec -> \h ->
   ((u.2 (inr tt),trans (NA.plus-comm (N.degree m (N.old m u.2)) (u.2 (inr tt))) (ap FinitePolynomial4[l].posN h.1)),rec h.2) } ;
 weaken (a b : Base.Nat) (le : B.Le a b) : (p : Ev.Polys) -> Bound a p -> Bound b p=split {
  nil -> \h -> tt ; cons u p | rec -> \h -> (B.le-trans _ _ _ h.1 le,rec h.2) } ;
 box : List (N.Exp m)=FiniteExponentBoxes[l].boxes m d ;
 rank : Nat=FL.length (N.Exp m) box ;
 exps : Ps.Fin rank -> N.Exp m=FL.at (N.Exp m) box ;
 gen-case (u : N.Exp m) : RB.Dich (N.degree m u) d -> E.R=split { inl h -> mon u ; inr h -> E.z } ;
 gen (u : N.Exp m) : E.R=gen-case u (RB.dich (N.degree m u) d) ;
 g (j : Ps.Fin rank) : E.R=gen (exps j) ;
 gen-at-case (u : N.Exp m) (h : B.Le (N.degree m u) d) : (q : RB.Dich (N.degree m u) d) -> Id E.R (gen-case u q) (mon u)=split {
  inl q -> refl (mon u) ; inr q -> absurd (Id E.R E.z (mon u)) (B.not-over (N.degree m u) d q.1 q.2 h) } ;
 gen-at (u : N.Exp m) (h : B.Le (N.degree m u) d) : Id E.R (gen u) (mon u)=gen-at-case u h (RB.dich (N.degree m u) d) ;
 index (u : N.Exp m) (h : B.Le (N.degree m u) d) : (j : Ps.Fin rank)*Id (N.Exp m) (exps j) u=
  Lists[N.Exp m].find box u (FiniteExponentBoxes[l].box-cover m d u h.1 h.2) ;
 Rep (x : E.R) : U l=(al : Ps.Fin rank -> R.R)*Id E.R x (F.comb rank g al) ;
 zero : Rep E.z=(\j -> R.z,sym (F.comb-zero rank g)) ;
 add (x z : E.R) (px : Rep x) (pz : Rep z) : Rep (E.add x z)=
  (\j -> R.add (px.1 j) (pz.1 j),trans (Ps.cong2 E.R E.add _ _ _ _ px.2 pz.2) (sym (F.comb-add rank g px.1 pz.1))) ;
 scale (c : R.R) (x : E.R) (px : Rep x) : Rep (E.mul (iota.1 c) x)=
  (\j -> R.mul c (px.1 j),trans (ap (E.mul (iota.1 c)) px.2) (sym (F.comb-scale rank g c px.1))) ;
 transport (x z : E.R) (eq : Id E.R x z) (p : Rep x) : Rep z=(p.1,trans (sym eq) p.2) ;
 monomial (u : N.Exp m) (h : B.Le (N.degree m u) d) : Rep (mon u)=
  (F.unit rank (index u h).1,sym (trans (F.unit-comb rank g (index u h).1)
    (trans (ap gen (index u h).2) (gen-at u h)))) ;
 expand : (p : Ev.Polys) -> Bound d p -> Rep (Ev.deh p)=split {
  nil -> \h -> zero ; cons u p | rec -> \h -> add (Ev.term u.1 u.2) (Ev.deh p)
   (scale u.1 (mon (N.old m u.2)) (monomial (N.old m u.2) h.1)) (rec h.2) } ;
 zero-bound : B.Le (N.degree m (N.zeroE m)) d=(d,ap (\x -> NA.plus x d) (CoordinateExponents[l].zero-degree m)) ;
 mon-one : Id E.R (mon (N.zeroE m)) E.o=CoordinateExponents[l].Monomials[E].zero-value m y ;
 one : Rep E.o=transport (mon (N.zeroE m)) E.o mon-one (monomial (N.zeroE m) zero-bound) ;
 Acts (z : E.R) : U l=(j : Ps.Fin rank) -> Rep (E.mul z (g j)) ;
 module Integral (z : E.R) (act : Acts z) {
  matrix (j i : Ps.Fin rank) : R.R=(act i).1 j ;
  equation (i : Ps.Fin rank) : Id E.R (E.mul z (g i)) (Determinant[l].Over[E,setE].act rank (\j k -> iota.1 (matrix j k)) g i)=(act i).2 ;
  module DI=DeterminantTrick[l].Integral[R,setR,E,setE,iota,z,rank,matrix,g,equation] ;
  faithful : Id E.R (S.lin rank (\j -> iota.1 (one.1 j)) g) E.o=
   trans (S.sum-cong rank (\j -> E.mul (iota.1 (one.1 j)) (g j)) (\j -> E.mul (g j) (iota.1 (one.1 j))) (\j -> E.mulC (iota.1 (one.1 j)) (g j))) (sym one.2) ;
  module Faithful=DI.Faithful[\j -> iota.1 (one.1 j),faithful] ;
  module CM=CharacteristicMonic[l].Expansion[R,setR,E,setE,iota,z].CharMonic[rank,matrix] ;
  polynomial : ZMTCertificate[l].Monic[R]=CM.P ;
  root : Id E.R (ZMTCertificate[l].Eval[R,E,iota].mev polynomial z) E.z=trans (sym CM.ev-chi) Faithful.root ;
 } ;
} ;
