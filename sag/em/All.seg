-- Eilenberg-MacLane spaces in plain HoTT (DW1.pdf, Wärn) and what CCA.pdf
-- (Cherubini-Coquand-Geerligs-Moeneclaey) uses of them: Appendices A, B.
-- No SSD axioms here.  Design: ../CCA-DESIGN.md, ../HANDOFF-CCA-B.md.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 -- funext is used through its laws only (happly-funext, funext-happly)
 opaque fe ;
 import Truncation ; import TruncationCombinators ; import FinChoice ; import Quotient ; import RingHom ; import Equivalences ;
 import Torsor ; import TorsorId ; import Groupoid ; import Gerbe ; import TrivialGerbe ;
 -- DW1 §2-§3
 import NatArith ; import HLevels ; import Connected ; import EquivProp ; import Lemma4 ; import FundThm ; import TruncUp ; import PtEquivOps ; import Completion ; import Deloop ; import Retracts ; import DeloopMaps ; import Whitehead ; import EM ;
 -- CCA Appendix A (non-abelian)
 import Group ; import GTorsor ; import CechComplex ; import CechNA ;
 -- fibre sequences (B2)
 import LoopCalc ; import Fibres ; import EMMaps ; import Bijection ; import PiEquiv ; import FibSeq ; import Exact ; import Eps ; import ImageGroup ;
 -- CCA Cor. A.0.7, A.0.8 as bijections of sets
 import CorA07 ; import FibreTorsor ;
 -- higher Čech complexes (A's cca/Cochains) and the dimension shift
 import Cochains ; import CechHigher ;
 -- CCA Lemma B.0.1
 import ConstantMap ; import CechZero ;
 -- pullback of Čech classes (for CCA Lemma 3.1.5)
 import CechPull ;
 -- Cor. A.0.7, A.0.8 as isomorphisms of pointed sets
 import CorA07Pt ;
 -- CCA Def. 3.2.1: eps is x |-> K(ev_x)
 import EpsEv ;
 -- CCA Thm 3.3.2 as a natural group isomorphism (form A)
 import QGrp ; import PiOne ; import Puppe ; import LoopConj ; import PiPt ; import LES ; import CechGroups ; import Snake ; import CechLES ; import Coker ; import KFun ; import CechNat ; import CechH0 ; import ImageMap ;
} ;
