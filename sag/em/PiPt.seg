-- Products of pointed maps over a type X (for Pₘ(B) = (x : X) -> K(B x, m)).
--   PiMap f      x |-> f x on points, pointed by funext of the pointings
--   pi-comp      PiMap (f ; g) = PiMap f ; PiMap g   (both pointings have
--                the same happly: happly-trans, happly-ap, happly-funext)
--   pi-fib       Fib (PiMap f) ~ (x : X) -> Fib (f x)  (pointwise
--                pairs; happly is an equivalence), over the projections
--   pi-loop      for the deloopings K(h, m) of homomorphisms h x:
--                psi (loop (PiMap K(h, m+1)) w) = PiMap K(h, m) (psi w),
--                psi = Eps.psi : Ω Pₘ₊₁ ~ Pₘ (pointwise: happly of loop
--                PiMap is loop of the components, and loopK).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ; open Torsor[l] ; open Puppe[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Eq = Equivalences[l] ;

-- happly of ap of a pointwise map
happly-ap-pi (X : U l) (Y Z : X -> U l) (G : (x : X) -> Y x -> Z x) (g : (x : X) -> Y x) : (g' : (x : X) -> Y x)
  (P : Id ((x : X) -> Y x) g g') (x : X) ->
  Id (Id (Z x) (G x (g x)) (G x (g' x)))
    (happly X Z (\ x1 -> G x1 (g x1)) (\ x1 -> G x1 (g' x1)) (ap ((x1 : X) -> Y x1) ((x1 : X) -> Z x1) (\ h x1 -> G x1 (h x1)) g g' P) x)
    (ap (Y x) (Z x) (G x) (g x) (g' x) (happly X Y g g' P x)) =
  \ g' P x -> idJ ((x1 : X) -> Y x1) g (\ g1 P1 -> Id (Id (Z x) (G x (g x)) (G x (g1 x)))
      (happly X Z (\ x1 -> G x1 (g x1)) (\ x1 -> G x1 (g1 x1)) (ap ((x1 : X) -> Y x1) ((x1 : X) -> Z x1) (\ h x1 -> G x1 (h x1)) g g1 P1) x)
      (ap (Y x) (Z x) (G x) (g x) (g1 x) (happly X Y g g1 P1 x)))
    (refl (refl (G x (g x)))) g' P ;
-- happly of an inverse
happly-sym (X : U l) (Z : X -> U l) (f : (x : X) -> Z x) : (g : (x : X) -> Z x) (P : Id ((x : X) -> Z x) f g) (x : X) ->
  Id (Id (Z x) (g x) (f x)) (happly X Z g f (sym ((x1 : X) -> Z x1) f g P) x) (sym (Z x) (f x) (g x) (happly X Z f g P x)) =
  \ g P x -> idJ ((x1 : X) -> Z x1) f (\ g1 P1 -> Id (Id (Z x) (g1 x) (f x)) (happly X Z g1 f (sym ((x1 : X) -> Z x1) f g1 P1) x)
      (sym (Z x) (f x) (g1 x) (happly X Z f g1 P1 x))) (refl (refl (f x))) g P ;
-- two paths with the same happly are equal
happly-inj (X : U l) (Z : X -> U l) (f g : (x : X) -> Z x) (P Q : Id ((x : X) -> Z x) f g)
  (h : (x : X) -> Id (Id (Z x) (f x) (g x)) (happly X Z f g P x) (happly X Z f g Q x)) : Id (Id ((x : X) -> Z x) f g) P Q =
  transH (symH (FL.funext-happly X Z f g P))
    (transH (apH (FL.funext X Z f g) (FL.funext X (\ x -> Id (Z x) (f x) (g x)) (happly X Z f g P) (happly X Z f g Q) h))
            (FL.funext-happly X Z f g Q)) ;

module Pi (X : U l) {
  PiMap (Y Z : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (f : (x : X) -> PtMap (Y x) (y x) (Z x) (z x)) :
    PtMap ((x : X) -> Y x) y ((x : X) -> Z x) z =
    (\ g x -> (f x).1 (g x), FL.funext X Z (\ x -> (f x).1 (y x)) z (\ x -> (f x).2)) ;

  -- the pointings of PiMap (f ; g) and PiMap f ; PiMap g agree pointwise,
  -- for maps given by components f1, f2, g1, g2
  module PiComp (Y Z W : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (w : (x : X) -> W x)
    (f1 : (x : X) -> Y x -> Z x) (f2 : (x : X) -> Id (Z x) (f1 x (y x)) (z x))
    (g1 : (x : X) -> Z x -> W x) (g2 : (x : X) -> Id (W x) (g1 x (z x)) (w x)) {
    gf (x : X) : W x = g1 x (f1 x (y x)) ;
    gz (x : X) : W x = g1 x (z x) ;
    Pf : Id ((x : X) -> Z x) (\ x -> f1 x (y x)) z = FL.funext X Z (\ x -> f1 x (y x)) z f2 ;
    Pg : Id ((x : X) -> W x) gz w = FL.funext X W gz w g2 ;
    Pgf : Id ((x : X) -> W x) gf gz = ap ((x : X) -> Z x) ((x : X) -> W x) (\ h x -> g1 x (h x)) (\ x -> f1 x (y x)) z Pf ;
    -- pointwise composite of the pointings
    comp2 (x : X) : Id (W x) (gf x) (w x) = trans (W x) (gf x) (gz x) (w x) (ap (Z x) (W x) (g1 x) (f1 x (y x)) (z x) (f2 x)) (g2 x) ;
    at (x : X) : Id (Id (W x) (gf x) (w x)) (happly X W gf w (FL.funext X W gf w comp2) x)
        (happly X W gf w (trans ((x1 : X) -> W x1) gf gz w Pgf Pg) x) = calc (Id (W x) (gf x) (w x)) {
      happly X W gf w (FL.funext X W gf w comp2) x
        =< happly X (\ x1 -> Id (W x1) (gf x1) (w x1)) _ _ (FL.happly-funext X W gf w comp2) x > comp2 x
        =< symH (transH (apH (\ a -> trans (W x) (gf x) (gz x) (w x) (ap (Z x) (W x) (g1 x) (f1 x (y x)) (z x) a) (happly X W gz w Pg x))
                           (happly X (\ x1 -> Id (Z x1) (f1 x1 (y x1)) (z x1)) _ _ (FL.happly-funext X Z (\ x1 -> f1 x1 (y x1)) z f2) x))
                        (apH (trans (W x) (gf x) (gz x) (w x) (ap (Z x) (W x) (g1 x) (f1 x (y x)) (z x) (f2 x)))
                           (happly X (\ x1 -> Id (W x1) (gz x1) (w x1)) _ _ (FL.happly-funext X W gz w g2) x))) >
      trans (W x) (gf x) (gz x) (w x) (ap (Z x) (W x) (g1 x) (f1 x (y x)) (z x) (happly X Z (\ x1 -> f1 x1 (y x1)) z Pf x)) (happly X W gz w Pg x)
        =< symH (apH (\ a -> trans (W x) (gf x) (gz x) (w x) a (happly X W gz w Pg x))
             (happly-ap-pi X Z W g1 (\ x1 -> f1 x1 (y x1)) z Pf x)) >
      trans (W x) (gf x) (gz x) (w x) (happly X W gf gz Pgf x) (happly X W gz w Pg x)
        =< symH (Eps[l].happly-trans X W gf gz Pgf w Pg x) >
      happly X W gf w (trans ((x1 : X) -> W x1) gf gz w Pgf Pg) x } ;
    pointing : Id (Id ((x : X) -> W x) gf w) (FL.funext X W gf w comp2) (trans ((x1 : X) -> W x1) gf gz w Pgf Pg) =
      happly-inj X W gf w (FL.funext X W gf w comp2) (trans ((x1 : X) -> W x1) gf gz w Pgf Pg) at ;
  } ;
  pi-comp (Y Z W : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (w : (x : X) -> W x)
    (f : (x : X) -> PtMap (Y x) (y x) (Z x) (z x)) (g : (x : X) -> PtMap (Z x) (z x) (W x) (w x)) :
    Id (PtMap ((x : X) -> Y x) y ((x : X) -> W x) w)
      (PiMap Y W y w (\ x -> ptcomp (Y x) (y x) (Z x) (z x) (W x) (w x) (f x) (g x)))
      (ptcomp ((x : X) -> Y x) y ((x : X) -> Z x) z ((x : X) -> W x) w (PiMap Y Z y z f) (PiMap Z W z w g)) =
    ap (Id ((x : X) -> W x) (\ x -> (g x).1 ((f x).1 (y x))) w) (PtMap ((x : X) -> Y x) y ((x : X) -> W x) w)
      (\ q -> (\ h x -> (g x).1 ((f x).1 (h x)), q)) _ _
      PiComp[Y, Z, W, y, z, w, \ x -> (f x).1, \ x -> (f x).2, \ x -> (g x).1, \ x -> (g x).2].pointing ;

  -- happly of the looping of a product is the looping of the components
  module PiLoopAt (Y Z : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (F : (x : X) -> PtMap (Y x) (y x) (Z x) (z x)) {
    module MP = Maps[(x : X) -> Y x, y, (x : X) -> Z x, z] ;
    F1 (x : X) : Y x -> Z x = (F x).1 ;
    F2 (x : X) : Id (Z x) (F1 x (y x)) (z x) = (F x).2 ;
    Fy : (x : X) -> Z x = \ x -> F1 x (y x) ;
    hw (w : Id ((x : X) -> Y x) y y) (x : X) : Id (Y x) (y x) (y x) = happly X Y y y w x ;
    apw (w : Id ((x : X) -> Y x) y y) : Id ((x : X) -> Z x) Fy Fy = ap ((x : X) -> Y x) ((x : X) -> Z x) (PiMap Y Z y z F).1 y y w ;
    -- happly of the pointing of (PiMap Y Z y z F) is the pointing of F x
    h-pt (x : X) : Id (Id (Z x) (Fy x) (z x)) (happly X Z Fy z (PiMap Y Z y z F).2 x) (F2 x) =
      happly X (\ x1 -> Id (Z x1) (Fy x1) (z x1)) _ _ (FL.happly-funext X Z Fy z F2) x ;
    h-ap (w : Id ((x : X) -> Y x) y y) (x : X) : Id (Id (Z x) (Fy x) (Fy x)) (happly X Z Fy Fy (apw w) x) (ap (Y x) (Z x) (F1 x) (y x) (y x) (hw w x)) =
      happly-ap-pi X Y Z F1 y y w x ;
    at (w : Id ((x : X) -> Y x) y y) (x : X) :
      Id (Id (Z x) (z x) (z x)) (happly X Z z z ((MP.loop (PiMap Y Z y z F)).1 w) x) ((Maps[Y x, y x, Z x, z x].loop (F x)).1 (hw w x)) = calc (Id (Z x) (z x) (z x)) {
      happly X Z z z ((MP.loop (PiMap Y Z y z F)).1 w) x
        =< apH (\ u -> happly X Z z z u x) (MP.loop-ap (PiMap Y Z y z F) w) >
      happly X Z z z (trans ((x1 : X) -> Z x1) z Fy z (sym ((x1 : X) -> Z x1) Fy z (PiMap Y Z y z F).2) (trans ((x1 : X) -> Z x1) Fy Fy z (apw w) (PiMap Y Z y z F).2)) x
        =< Eps[l].happly-trans X Z z Fy (sym ((x1 : X) -> Z x1) Fy z (PiMap Y Z y z F).2) z (trans ((x1 : X) -> Z x1) Fy Fy z (apw w) (PiMap Y Z y z F).2) x >
      trans (Z x) (z x) (Fy x) (z x) (happly X Z z Fy (sym ((x1 : X) -> Z x1) Fy z (PiMap Y Z y z F).2) x) (happly X Z Fy z (trans ((x1 : X) -> Z x1) Fy Fy z (apw w) (PiMap Y Z y z F).2) x)
        =< apH (trans (Z x) (z x) (Fy x) (z x) (happly X Z z Fy (sym ((x1 : X) -> Z x1) Fy z (PiMap Y Z y z F).2) x))
             (transH (Eps[l].happly-trans X Z Fy Fy (apw w) z (PiMap Y Z y z F).2 x)
               (transH (apH (\ a -> trans (Z x) (Fy x) (Fy x) (z x) a (happly X Z Fy z (PiMap Y Z y z F).2 x)) (h-ap w x))
                       (apH (trans (Z x) (Fy x) (Fy x) (z x) (ap (Y x) (Z x) (F1 x) (y x) (y x) (hw w x))) (h-pt x)))) >
      trans (Z x) (z x) (Fy x) (z x) (happly X Z z Fy (sym ((x1 : X) -> Z x1) Fy z (PiMap Y Z y z F).2) x)
        (trans (Z x) (Fy x) (Fy x) (z x) (ap (Y x) (Z x) (F1 x) (y x) (y x) (hw w x)) (F2 x))
        =< apH (\ a -> trans (Z x) (z x) (Fy x) (z x) a (trans (Z x) (Fy x) (Fy x) (z x) (ap (Y x) (Z x) (F1 x) (y x) (y x) (hw w x)) (F2 x)))
             (transH (happly-sym X Z Fy z (PiMap Y Z y z F).2 x) (apH (sym (Z x) (Fy x) (z x)) (h-pt x))) >
      trans (Z x) (z x) (Fy x) (z x) (sym (Z x) (Fy x) (z x) (F2 x)) (trans (Z x) (Fy x) (Fy x) (z x) (ap (Y x) (Z x) (F1 x) (y x) (y x) (hw w x)) (F2 x))
        =< symH (Maps[Y x, y x, Z x, z x].loop-ap (F x) (hw w x)) >
      (Maps[Y x, y x, Z x, z x].loop (F x)).1 (hw w x) } ;
  } ;
  happly-loop (Y Z : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (F : (x : X) -> PtMap (Y x) (y x) (Z x) (z x))
    (w : Id ((x : X) -> Y x) y y) (x : X) :
    Id (Id (Z x) (z x) (z x)) (happly X Z z z ((Maps[(x1 : X) -> Y x1, y, (x1 : X) -> Z x1, z].loop (PiMap Y Z y z F)).1 w) x)
      ((Maps[Y x, y x, Z x, z x].loop (F x)).1 (happly X Y y y w x)) = PiLoopAt[Y, Z, y, z, F].at w x ;

  -- equal families give equal products
  pi-resp (Y Z : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (f g : (x : X) -> PtMap (Y x) (y x) (Z x) (z x))
    (e : (x : X) -> Id (PtMap (Y x) (y x) (Z x) (z x)) (f x) (g x)) :
    Id (PtMap ((x : X) -> Y x) y ((x : X) -> Z x) z) (PiMap Y Z y z f) (PiMap Y Z y z g) =
    apH (PiMap Y Z y z) (FL.funext X (\ x -> PtMap (Y x) (y x) (Z x) (z x)) f g e) ;

  -- the fibre of a product is the product of the fibres
  module PiFib (Y Z : X -> U l) (y : (x : X) -> Y x) (z : (x : X) -> Z x) (f : (x : X) -> PtMap (Y x) (y x) (Z x) (z x)) {
    to (w : (x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) : (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) = (\ x -> (w x).1, FL.funext X Z (\ x -> (f x).1 ((w x).1)) z (\ x -> (w x).2)) ;
    from (v : (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f))) (x : X) : (Fib (Y x) (y x) (Z x) (z x) (f x)) = (v.1 x, happly X Z (\ x1 -> (f x1).1 (v.1 x1)) z v.2 x) ;
    to-from (v : (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f))) : Id (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) (to (from v)) v =
      ap (Id ((x : X) -> Z x) (\ x -> (f x).1 (v.1 x)) z) (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) (\ q -> (v.1, q)) _ v.2
        (FL.funext-happly X Z (\ x -> (f x).1 (v.1 x)) z v.2) ;
    from-to (w : (x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) : Id ((x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) (from (to w)) w =
      FL.funext X (\ xq -> Fib (Y xq) (y xq) (Z xq) (z xq) (f xq)) (from (to w)) w (\ x ->
        ap (Id (Z x) ((f x).1 ((w x).1)) (z x)) ((Fib (Y x) (y x) (Z x) (z x) (f x))) (\ q -> ((w x).1, q)) _ (w x).2
          (happly X (\ x1 -> Id (Z x1) ((f x1).1 ((w x1).1)) (z x1)) _ _
             (FL.happly-funext X Z (\ x1 -> (f x1).1 ((w x1).1)) z (\ x1 -> (w x1).2)) x)) ;
    pi-fib : PtEquiv ((x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) (\ xq -> fpt (Y xq) (y xq) (Z xq) (z xq) (f xq)) (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) (fpt ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) = ((to, refl (fpt ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f))), qinv ((x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) to from to-from from-to) ;
    -- over the projections
    pi-fib-over : Id (PtMap ((x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) (\ xq -> fpt (Y xq) (y xq) (Z xq) (z xq) (f xq)) ((x : X) -> Y x) y)
      (ptcomp ((x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) (\ xq -> fpt (Y xq) (y xq) (Z xq) (z xq) (f xq)) (Fib ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) (fpt ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)) ((x : X) -> Y x) y pi-fib.1 (fpr ((x : X) -> Y x) y ((x : X) -> Z x) z (PiMap Y Z y z f)))
      (PiMap (\ xq -> Fib (Y xq) (y xq) (Z xq) (z xq) (f xq)) Y (\ xq -> fpt (Y xq) (y xq) (Z xq) (z xq) (f xq)) y (\ x -> fpr (Y x) (y x) (Z x) (z x) (f x))) =
      ap (Id ((x : X) -> Y x) y y) (PtMap ((x : X) -> (Fib (Y x) (y x) (Z x) (z x) (f x))) (\ xq -> fpt (Y xq) (y xq) (Z xq) (z xq) (f xq)) ((x : X) -> Y x) y) (\ q -> (\ w x -> (w x).1, q)) _ _
        (symH (FL.funext-happly X Y y y (refl y))) ;
  } ;
} ;

-- the looping of a product of deloopings
module PiLoop (X : U l) (Ga Gb : X -> Ab) (h : (x : X) -> Hom (Ga x) (Gb x)) (m : Nat) {
  module EA = Eps[l].Eps[X, Ga] ;
  module EB = Eps[l].Eps[X, Gb] ;
  module KH (x : X) { module M = KMap[Ga x, Gb x, h x] ; } ;
  F : PtMap (EA.P (suc m)) (EA.pP (suc m)) (EB.P (suc m)) (EB.pP (suc m)) =
    Pi[X].PiMap (\ x -> EA.KA[x].K.K (suc m)) (\ x -> EB.KA[x].K.K (suc m)) (EA.pP (suc m)) (EB.pP (suc m)) (\ x -> KH[x].M.K (suc m)) ;
  G : PtMap (EA.P m) (EA.pP m) (EB.P m) (EB.pP m) =
    Pi[X].PiMap (\ x -> EA.KA[x].K.K m) (\ x -> EB.KA[x].K.K m) (EA.pP m) (EB.pP m) (\ x -> KH[x].M.K m) ;
  module MF = Maps[EA.P (suc m), EA.pP (suc m), EB.P (suc m), EB.pP (suc m)] ;
  module Mx (x : X) { module M = Maps[EA.KA[x].K.K (suc m), EA.KA[x].K.pt (suc m), EB.KA[x].K.K (suc m), EB.KA[x].K.pt (suc m)] ; } ;
  -- happly of the looping is the looping of the components
  happly-loop (w : EA.OP m) (x : X) :
    Id ((Id (EB.KA[x].K.K (suc m)) (EB.KA[x].K.pt (suc m)) (EB.KA[x].K.pt (suc m)))) (happly X (\ x1 -> EB.KA[x1].K.K (suc m)) (EB.pP (suc m)) (EB.pP (suc m)) ((MF.loop F).1 w) x)
      ((Mx[x].M.loop (KH[x].M.K (suc m))).1 (happly X (\ x1 -> EA.KA[x1].K.K (suc m)) (EA.pP (suc m)) (EA.pP (suc m)) w x)) =
    Pi[X].happly-loop (\ x1 -> EA.KA[x1].K.K (suc m)) (\ x1 -> EB.KA[x1].K.K (suc m)) (EA.pP (suc m)) (EB.pP (suc m)) (\ x1 -> KH[x1].M.K (suc m)) w x ;
  -- psi (loop F w) = G (psi w)
  pi-loop (w : EA.OP m) : Id (EB.P m) (EB.psi-fun m ((MF.loop F).1 w)) (G.1 (EA.psi-fun m w)) =
    FL.funext X (\ x -> EB.KA[x].K.K m) (EB.psi-fun m ((MF.loop F).1 w)) (G.1 (EA.psi-fun m w)) (\ x -> calc (EB.KA[x].K.K m) {
      (EB.KA[x].K.e m).1.1 (happly X (\ x1 -> EB.KA[x1].K.K (suc m)) (EB.pP (suc m)) (EB.pP (suc m)) ((MF.loop F).1 w) x)
        =< apH (EB.KA[x].K.e m).1.1 (happly-loop w x) >
      (EB.KA[x].K.e m).1.1 ((Mx[x].M.loop (KH[x].M.K (suc m))).1 (happly X (\ x1 -> EA.KA[x1].K.K (suc m)) (EA.pP (suc m)) (EA.pP (suc m)) w x))
        =< apH (EB.KA[x].K.e m).1.1 (pt-happly ((Id (EA.KA[x].K.K (suc m)) (EA.KA[x].K.pt (suc m)) (EA.KA[x].K.pt (suc m)))) (refl (EA.KA[x].K.pt (suc m))) ((Id (EB.KA[x].K.K (suc m)) (EB.KA[x].K.pt (suc m)) (EB.KA[x].K.pt (suc m)))) (refl (EB.KA[x].K.pt (suc m)))
             (Mx[x].M.loop (KH[x].M.K (suc m))) (KH[x].M.conj m (KH[x].M.K m)) (KH[x].M.loopK m)
             (happly X (\ x1 -> EA.KA[x1].K.K (suc m)) (EA.pP (suc m)) (EA.pP (suc m)) w x)) >
      (EB.KA[x].K.e m).1.1 ((pt-inv ((Id (EB.KA[x].K.K (suc m)) (EB.KA[x].K.pt (suc m)) (EB.KA[x].K.pt (suc m)))) (refl (EB.KA[x].K.pt (suc m))) (EB.KA[x].K.K m) (EB.KA[x].K.pt m) (EB.KA[x].K.e m)).1.1
