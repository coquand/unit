-- The map of fibres along a pointed square, and the naturality of the
-- boundary (for the naturality of δ in CCA Lemma B.0.4).
-- For pointed f : E -> B, f' : E' -> B', u : E -> E', v : B -> B' and a
-- pointed equality sq : u ; f' = f ; v (homotopy hs, coherence c at e0):
--   fm (e, q) = (u e, hs e . ap v q . v0) : Fib f -> Fib f',  pointed (by c),
--   over u, and
--   dd' (loop v g) = fm (dd g)      for g a loop at b0
-- (Puppe.dd l = (e0, f0 . l); both sides lie over e0' = u e0, and their
-- second components agree by c and loop-ap).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Fibres[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Gp = Groupoid[l] ;

-- the coherence of a path of pointed maps
pt-coh (X : U l) (x0 : X) (Y : U l) (y0 : Y) (P : PtMap X x0 Y y0) : (Q : PtMap X x0 Y y0) (r : Id (PtMap X x0 Y y0) P Q) ->
  Id (Id Y (P.1 x0) y0) P.2 (trans Y (P.1 x0) (Q.1 x0) y0 (happly X (\ x -> Y) P.1 Q.1 (ap (PtMap X x0 Y y0) (X -> Y) (\ R -> R.1) P Q r) x0) Q.2) =
  \ Q r -> idJ (PtMap X x0 Y y0) P (\ Q1 r1 -> Id (Id Y (P.1 x0) y0) P.2
      (trans Y (P.1 x0) (Q1.1 x0) y0 (happly X (\ x -> Y) P.1 Q1.1 (ap (PtMap X x0 Y y0) (X -> Y) (\ R -> R.1) P Q1 r1) x0) Q1.2))
    (symH (trans-refl-l Y (P.1 x0) y0 P.2)) Q r ;

-- (h . (a . w)) . (w^-1 . (g . w)) = h . ((a . g) . w), J on w
reassoc (Y : U l) (y1 y2 y3 : Y) (h : Id Y y1 y2) (a : Id Y y2 y3) (g : Id Y y3 y3) : (y4 : Y) (w : Id Y y3 y4) ->
  Id (Id Y y1 y4) (trans Y y1 y4 y4 (trans Y y1 y2 y4 h (trans Y y2 y3 y4 a w)) (trans Y y4 y3 y4 (sym Y y3 y4 w) (trans Y y3 y3 y4 g w)))
    (trans Y y1 y2 y4 h (trans Y y2 y3 y4 (trans Y y2 y3 y3 a g) w)) =
  \ y4 w -> idJ Y y3 (\ y5 w1 -> Id (Id Y y1 y5) (trans Y y1 y5 y5 (trans Y y1 y2 y5 h (trans Y y2 y3 y5 a w1)) (trans Y y5 y3 y5 (sym Y y3 y5 w1) (trans Y y3 y3 y5 g w1)))
      (trans Y y1 y2 y5 h (trans Y y2 y3 y5 (trans Y y2 y3 y3 a g) w1)))
    (transH (apH (trans Y y1 y3 y3 (trans Y y1 y2 y3 h a)) (trans-refl-l Y y3 y3 g)) (Gp.tassoc Y y1 y2 y3 h a y3 g)) y4 w ;

module FibMap (E : U l) (e0 : E) (B : U l) (b0 : B) (E' : U l) (e0' : E') (B' : U l) (b0' : B')
  (f : PtMap E e0 B b0) (f' : PtMap E' e0' B' b0') (u : PtMap E e0 E' e0') (v : PtMap B b0 B' b0')
  (sq : Id (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v)) {
  -- the parts of the four pointed maps
  ff (e : E) : B = f.1 e ;  f0 : Id B (f.1 e0) b0 = f.2 ;
  ff' (e : E') : B' = f'.1 e ;  f0' : Id B' (f'.1 e0') b0' = f'.2 ;
  fu (e : E) : E' = u.1 e ;  u0 : Id E' (u.1 e0) e0' = u.2 ;
  fv (b : B) : B' = v.1 b ;  v0 : Id B' (v.1 b0) b0' = v.2 ;
  F : U l = Fib E e0 B b0 f ;
  F' : U l = Fib E' e0' B' b0' f' ;
  hs (e : E) : Id B' (ff' (fu e)) (fv (ff e)) =
    happly E (\ x -> B') (\ x -> ff' (fu x)) (\ x -> fv (ff x))
      (ap (PtMap E e0 B' b0') (E -> B') (\ R -> R.1) (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v) sq) e ;
  -- ap f' u0 . f'0 = hs e0 . (ap v f0 . v0)
  c : Id (Id B' (ff' (fu e0)) b0') (trans B' (ff' (fu e0)) (ff' e0') b0' (ap E' B' ff' (fu e0) e0' u0) f0')
      (trans B' (ff' (fu e0)) (fv (ff e0)) b0' (hs e0) (trans B' (fv (ff e0)) (fv b0) b0' (ap B B' fv (ff e0) b0 f0) v0)) =
    pt-coh E e0 B' b0' (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v) sq ;
  fm-fun (w : F) : F' = (fu w.1, trans B' (ff' (fu w.1)) (fv (ff w.1)) b0' (hs w.1) (trans B' (fv (ff w.1)) (fv b0) b0' (ap B B' fv (ff w.1) b0 w.2) v0)) ;
  -- transport along sym p in the fibre is precomposition with ap f' p
  tr-sym (x y : E') (p : Id E' x y) (a : Id B' (ff' y) b0') :
    Id (Id B' (ff' x) b0') (subst E' (\ z -> Id B' (ff' z) b0') y x (sym E' x y p) a) (trans B' (ff' x) (ff' y) b0' (ap E' B' ff' x y p) a) =
    transH (Gp.transport-fib E' B' ff' b0' y x (sym E' x y p) a)
      (apH (\ r -> trans B' (ff' x) (ff' y) b0' r a)
        (transH (Puppe[l].ap-sym E' B' ff' y x (sym E' x y p)) (apH (ap E' B' ff' x y) (Gp.sym-sym E' x y p)))) ;
  -- the pointing
  fm-pt-q : Id (Id B' (ff' e0') b0') (subst E' (\ z -> Id B' (ff' z) b0') (fu e0) e0' u0 (fm-fun (fpt E e0 B b0 f)).2) f0' = calc (Id B' (ff' e0') b0') {
      subst E' (\ z -> Id B' (ff' z) b0') (fu e0) e0' u0 (fm-fun (fpt E e0 B b0 f)).2
        =< Gp.transport-fib E' B' ff' b0' (fu e0) e0' u0 (fm-fun (fpt E e0 B b0 f)).2 >
      trans B' (ff' e0') (ff' (fu e0)) b0' (sym B' (ff' (fu e0)) (ff' e0') (ap E' B' ff' (fu e0) e0' u0)) (fm-fun (fpt E e0 B b0 f)).2
        =< apH (trans B' (ff' e0') (ff' (fu e0)) b0' (sym B' (ff' (fu e0)) (ff' e0') (ap E' B' ff' (fu e0) e0' u0))) (symH c) >
      trans B' (ff' e0') (ff' (fu e0)) b0' (sym B' (ff' (fu e0)) (ff' e0') (ap E' B' ff' (fu e0) e0' u0))
        (trans B' (ff' (fu e0)) (ff' e0') b0' (ap E' B' ff' (fu e0) e0' u0) f0')
        =< trans-cancel B' (ff' (fu e0)) (ff' e0') b0' (ap E' B' ff' (fu e0) e0' u0) f0' > f0' } ;
  fm-pt : Id F' (fm-fun (fpt E e0 B b0 f)) (fpt E' e0' B' b0' f') =
    Sigma-path E' (\ z -> Id B' (ff' z) b0') (fu e0) e0' (fm-fun (fpt E e0 B b0 f)).2 f0' u0 fm-pt-q ;
  fm : PtMap F (fpt E e0 B b0 f) F' (fpt E' e0' B' b0' f') = (fm-fun, fm-pt) ;
  -- over u
  fm-over : Id (PtMap F (fpt E e0 B b0 f) E' e0') (ptcomp F (fpt E e0 B b0 f) F' (fpt E' e0' B' b0' f') E' e0' fm (fpr E' e0' B' b0' f'))
      (ptcomp F (fpt E e0 B b0 f) E e0 E' e0' (fpr E e0 B b0 f) u) =
    ptmap-path F (fpt E e0 B b0 f) E' e0' (\ w -> fu w.1) (\ w -> fu w.1)
      (ptcomp F (fpt E e0 B b0 f) F' (fpt E' e0' B' b0' f') E' e0' fm (fpr E' e0' B' b0' f')).2
      (ptcomp F (fpt E e0 B b0 f) E e0 E' e0' (fpr E e0 B b0 f) u).2 (\ w -> refl (fu w.1))
      (transH (LiftUnique[l].sigma-path-fst E' (\ z -> Id B' (ff' z) b0') (fu e0) (fm-fun (fpt E e0 B b0 f)).2 e0' f0' u0 fm-pt-q)
        (symH (transH (trans-refl-l E' (fu e0) e0' (trans E' (fu e0) (fu e0) e0' (refl (fu e0)) u0)) (trans-refl-l E' (fu e0) e0' u0)))) ;
  -- the boundary is natural
  dd-nat (g : Id B b0 b0) : Id F' (Puppe[l].Puppe[E', e0', B', b0', f'].dd.1 ((Maps[B, b0, B', b0'].loop v).1 g))
      (fm-fun (Puppe[l].Puppe[E, e0, B, b0, f].dd.1 g)) =
    Sigma-path E' (\ z -> Id B' (ff' z) b0') e0' (fu e0) (trans B' (ff' e0') b0' b0' f0' ((Maps[B, b0, B', b0'].loop v).1 g))
      (fm-fun (Puppe[l].Puppe[E, e0, B, b0, f].dd.1 g)).2 (sym E' (fu e0) e0' u0) (calc (Id B' (ff' (fu e0)) b0') {
      subst E' (\ z -> Id B' (ff' z) b0') e0' (fu e0) (sym E' (fu e0) e0' u0) (trans B' (ff' e0') b0' b0' f0' ((Maps[B, b0, B', b0'].loop v).1 g))
        =< tr-sym (fu e0) e0' u0 (trans B' (ff' e0') b0' b0' f0' ((Maps[B, b0, B', b0'].loop v).1 g)) >
      trans B' (ff' (fu e0)) (ff' e0') b0' (ap E' B' ff' (fu e0) e0' u0) (trans B' (ff' e0') b0' b0' f0' ((Maps[B, b0, B', b0'].loop v).1 g))
        =< symH (Gp.tassoc B' (ff' (fu e0)) (ff' e0') b0' (ap E' B' ff' (fu e0) e0' u0) f0' b0' ((Maps[B, b0, B', b0'].loop v).1 g)) >
      trans B' (ff' (fu e0)) b0' b0' (trans B' (ff' (fu e0)) (ff' e0') b0' (ap E' B' ff' (fu e0) e0' u0) f0') ((Maps[B, b0, B', b0'].loop v).1 g)
        =< apH (\ a -> trans B' (ff' (fu e0)) b0' b0' a ((Maps[B, b0, B', b0'].loop v).1 g)) c >
      trans B' (ff' (fu e0)) b0' b0' (trans B' (ff' (fu e0)) (fv (ff e0)) b0' (hs e0) (trans B' (fv (ff e0)) (fv b0) b0' (ap B B' fv (ff e0) b0 f0) v0))
        ((Maps[B, b0, B', b0'].loop v).1 g)
        =< apH (trans B' (ff' (fu e0)) b0' b0' (trans B' (ff' (fu e0)) (fv (ff e0)) b0' (hs e0) (trans B' (fv (ff e0)) (fv b0) b0' (ap B B' fv (ff e0) b0 f0) v0)))
             (Maps[B, b0, B', b0'].loop-ap v g) >
      trans B' (ff' (fu e0)) b0' b0' (trans B' (ff' (fu e0)) (fv (ff e0)) b0' (hs e0) (trans B' (fv (ff e0)) (fv b0) b0' (ap B B' fv (ff e0) b0 f0) v0))
        (trans B' b0' (fv b0) b0' (sym B' (fv b0) b0' v0) (trans B' (fv b0) (fv b0) b0' (ap B B' fv b0 b0 g) v0))
        =< reassoc B' (ff' (fu e0)) (fv (ff e0)) (fv b0) (hs e0) (ap B B' fv (ff e0) b0 f0) (ap B B' fv b0 b0 g) b0' v0 >
      trans B' (ff' (fu e0)) (fv (ff e0)) b0' (hs e0) (trans B' (fv (ff e0)) (fv b0) b0' (trans B' (fv (ff e0)) (fv b0) (fv b0) (ap B B' fv (ff e0) b0 f0) (ap B B' fv b0 b0 g)) v0)
        =< apH (\ a -> trans B' (ff' (fu e0)) (fv (ff e0)) b0' (hs e0) (trans B' (fv (ff e0)) (fv b0) b0' a v0))
             (symH (Gp.ap-trans B B' fv (ff e0) b0 b0 f0 g)) >
      (fm-fun (Puppe[l].Puppe[E, e0, B, b0, f].dd.1 g)).2 }) ;
} ;
