-- Homomorphisms of abelian groups (a map preserving +; it preserves 0),
-- and the product of a family of abelian groups.  Function
-- extensionality only.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

Hom (Ga Gb : Ab) : U l = (h : Ga.A -> Gb.A) * ((x y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) ;

hom-unit (Ga Gb : Ab) (h : Hom Ga Gb) : Id Gb.A (h.1 Ga.o) Gb.o =
  transH (AbL[Gb].solve (h.1 Ga.o) (h.1 Ga.o) (h.1 Ga.o)
            (symH (transH (apH h.1 (symH (Ga.unitr Ga.o))) (h.2 Ga.o Ga.o))))
         (Gb.invr (h.1 Ga.o)) ;

-- the product of abelian groups
prod-ab (S : U l) (A : S -> Ab) : Ab = new Ab[(x : S) -> (A x).A, FL.isSet-Pi S (\ x -> (A x).A) (\ x -> (A x).setA),
  \ x -> (A x).o, \ f g x -> (A x).add (f x) (g x), \ f x -> (A x).inv (f x),
  \ f g h -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).assoc (f x) (g x) (h x)),
  \ f g -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).comm (f x) (g x)),
  \ f -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).unitr (f x)),
  \ f -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).invr (f x))] ;
