-- DW1 Lemma 4 and Corollary 5.
--
-- Lemma 4.  Let (A, a0) be pointed and (c-1)-connected, B : A -> U a family
-- of (c+t-2)-truncated types and b0 : B a0.  Then the type of pointed
-- sections  PtSec = (f : (a : A) -> B a) * (f a0 = b0)  is (t-2)-truncated.
-- (DW1: n = c-1, m = t-2.)  Proof by induction on c, for all A, B:
--  c = 0.  A is only pointed; Pi a. B a is (t-2)-truncated, and so are the
--     identity types of B a0.
--  c+1.  Spreading a pointed section over the paths from a0: PtSec is a
--     retract (by definition, `spread` / `collect`) of  Pi a. C a  with
--         C a = (y : B a) * ((q : a0 = a) -> y = q_* b0).
--     Being (t-2)-truncated is a proposition and a is merely a0, so it
--     suffices that C a0 is (t-2)-truncated.  C a0 is a retract (by
--     definition) of  Sigma over the singleton  (y, w : y = b0)  of
--         D (y, w) = (h : (q : a0 = a0) -> y = q_* b0) * (h refl = w),
--     and D (b0, refl) is, by definition, the type of pointed sections of
--     q |-> (b0 = q_* b0) over the loop space (a0 = a0, refl), which is
--     (c-1)-connected with (c+t-2)-truncated fibres: the induction
--     hypothesis.
--
-- Corollary 5.  (i) If A is (c-1)-connected and B (c+t-2)-truncated,
-- A ->pt B is (t-2)-truncated: Lemma 4 for a constant family.  (ii) For
-- t >= 1 the pointed equivalences A ~pt B, a subtype of A ->pt B, are
-- (t-2)-truncated too.  DW1 also covers t = 0 through bi-invertible
-- pointed maps; that case is not used (Cor. 6 needs Cor. 5 at levels
-- n+m+1 >= -1 only).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ;
module Tr = Truncation[l] ;
module N = NatArith[l] ;

PtSec (A : U l) (a0 : A) (B : A -> U l) (b0 : B a0) : U l =
  (f : (a : A) -> B a) * Id (B a0) (f a0) b0 ;

module Spreading (A : U l) (a0 : A) (B : A -> U l) (b0 : B a0) {
  C (a : A) : U l = (y : B a) * ((q : Id A a0 a) -> Id (B a) y (subst A B a0 a q b0)) ;
  spread (u : PtSec A a0 B b0) (a : A) : C a =
    (u.1 a, \ q -> idJ A a0 (\ a1 q1 -> Id (B a1) (u.1 a1) (subst A B a0 a1 q1 b0)) u.2 a q) ;
  collect (g : (a : A) -> C a) : PtSec A a0 B b0 = (\ a -> (g a).1, (g a0).2 (refl a0)) ;
  collect-spread (u : PtSec A a0 B b0) : Id (PtSec A a0 B b0) (collect (spread u)) u = refl u ;

  -- C a0 over the singleton at b0
  Sing : U l = (y : B a0) * Id (B a0) y b0 ;
  D (yw : Sing) : U l =
    (h : (q : Id A a0 a0) -> Id (B a0) yw.1 (subst A B a0 a0 q b0)) * Id (Id (B a0) yw.1 b0) (h (refl a0)) yw.2 ;
  -- the loop family
  E (q : Id A a0 a0) : U l = Id (B a0) b0 (subst A B a0 a0 q b0) ;
  D-centre : Id (U l) (D (b0, refl b0)) (PtSec (Id A a0 a0) (refl a0) E (refl b0)) =
    refl (PtSec (Id A a0 a0) (refl a0) E (refl b0)) ;
  into (w : C a0) : (yw : Sing) * D yw = ((w.1, w.2 (refl a0)), (w.2, refl (w.2 (refl a0)))) ;
  outof (z : (yw : Sing) * D yw) : C a0 = (z.1.1, z.2.1) ;
  outof-into (w : C a0) : Id (C a0) (outof (into w)) w = refl w ;
} ;

lemma4 (t : Nat) : (c : Nat) (A : U l) (a0 : A) -> isConn (suc c) A -> (B : A -> U l)
  -> ((a : A) -> isTrunc (N.plus c t) (B a)) -> (b0 : B a0) -> isTrunc t (PtSec A a0 B b0) = split {
  zero -> \ A a0 cA B tB b0 ->
    trunc-Sigma t ((a : A) -> B a) (\ f -> Id (B a0) (f a0) b0) (trunc-Pi t A B tB)
      (\ f -> trunc-suc t (B a0) (tB a0) (f a0) b0) ;
  suc c | r -> \ A a0 cA B tB b0 ->
    retract-trunc t (PtSec A a0 B b0) ((a : A) -> Spreading[A, a0, B, b0].C a)
      (Spreading[A, a0, B, b0].spread) (Spreading[A, a0, B, b0].collect) (Spreading[A, a0, B, b0].collect-spread)
      (trunc-Pi t A (Spreading[A, a0, B, b0].C)
        (conn-elim c A a0 cA (\ a -> isTrunc t (Spreading[A, a0, B, b0].C a))
          (\ a -> trunc-prop t (Spreading[A, a0, B, b0].C a))
          (retract-trunc t (Spreading[A, a0, B, b0].C a0)
             ((yw : Spreading[A, a0, B, b0].Sing) * Spreading[A, a0, B, b0].D yw)
             (Spreading[A, a0, B, b0].into) (Spreading[A, a0, B, b0].outof) (Spreading[A, a0, B, b0].outof-into)
             (trunc-Sigma-contr t Spreading[A, a0, B, b0].Sing Spreading[A, a0, B, b0].D (sing (B a0) b0)
               (r (Id A a0 a0) (refl a0) (conn-id (suc c) A cA a0 a0) Spreading[A, a0, B, b0].E
                  (\ q -> tB a0 b0 (subst A B a0 a0 q b0)) (refl b0)))))) } ;

------------------------------------------------------------------------
-- Corollary 5

PtMap (A : U l) (a0 : A) (B : U l) (b0 : B) : U l = PtSec A a0 (\ a -> B) b0 ;

PtEquiv (A : U l) (a0 : A) (B : U l) (b0 : B) : U l = (f : PtMap A a0 B b0) * isEquiv A B f.1 ;

cor5-map (t c : Nat) (A : U l) (a0 : A) (cA : isConn (suc c) A) (B : U l) (b0 : B)
  (tB : isTrunc (N.plus c t) B) : isTrunc t (PtMap A a0 B b0) =
  lemma4 t c A a0 cA (\ a -> B) (\ a -> tB) b0 ;

cor5-equiv (t c : Nat) (A : U l) (a0 : A) (cA : isConn (suc c) A) (B : U l) (b0 : B)
  (tB : isTrunc (N.plus c (suc t)) B) : isTrunc (suc t) (PtEquiv A a0 B b0) =
  trunc-sub t (PtMap A a0 B b0) (\ f -> isEquiv A B f.1) (cor5-map (suc t) c A a0 cA B b0 tB)
    (\ f -> EquivProp[l].isEquiv-prop A B f.1) ;
