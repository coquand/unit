-- Ȟ¹ = 0 in the vanishing form of CechHigher (Cochains) gives Ȟ¹ = 0 in
-- the form of CechNA (torsors, univalence), for an abelian group B.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ; open AbHom[l] ; open FinChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module Cc = Cochains[l] ;
module IG = ImageGroup[l] ;

-- Ȟ¹ = 0 in this form gives Ȟ¹ = 0 in the form of CechNA (for ab-grp B).
-- A CechNA cocycle d gives the cochain phi (y0, y1) = d y0 y1, a cocycle:
-- delta phi (v, a, b) = d a b - (d v b - d v a) = 0 (d a b + d v a = d v b).
-- If delta psi = phi, i.e. psi (y1) - psi (y0) = d y0 y1, then
-- g y = - psi (y) bounds d: - psi y1 + (psi y1 - psi y0) = - psi y0.

module H1Bridge (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (B : X -> Ab) {
  module CB = Cc.Cech[X, Y, B] ;
  module NA = CechNA[l].CechNA[X, Y, hY, \ x -> Group[l].ab-grp (B x)] ;
  -- 1-tuples are determined by their point
  one (x : X) (y : Y x) : Cc.Cochains[B x, Y x].Tup (suc zero) = \ i -> y ;
  one-pt (x : X) (t : Cc.Cochains[B x, Y x].Tup (suc zero)) : (i : Fin (suc zero)) -> Id (Y x) (t i) (t none) = split {
    none -> refl (t none) ; some e -> absurd (Id (Y x) (t (some e)) (t none)) e } ;
  one-eq (x : X) (t : Cc.Cochains[B x, Y x].Tup (suc zero)) : Id (Cc.Cochains[B x, Y x].Tup (suc zero)) t (one x (t none)) =
    FL.funext (Fin (suc zero)) (\ i -> Y x) t (one x (t none)) (one-pt x t) ;
  pair (x : X) (y0 y1 : Y x) : Cc.Cochains[B x, Y x].Tup (suc (suc zero)) = split { none -> y0 ; some j -> y1 } ;
  module Given (d : NA.C1) (c : NA.Cocycle d) {
    phi : CB.Ch (suc (suc zero)) = \ x s -> d x (s none) (s (some none)) ;
    -- (X + Z) - Z = X
    cancel (x : X) (a b : (B x).A) : Id (B x).A (Cc.AbSub[B x].sub ((B x).add a b) b) a =
      transH ((B x).assoc a b ((B x).inv b)) (transH (apH ((B x).add a) ((B x).invr b)) ((B x).unitr a)) ;
    cocycle : CB.isCocycle (suc zero) phi = \ x s -> calc (B x).A {
      CB.d (suc (suc zero)) phi x s
        =< apH (\ z -> Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none)))) (Cc.AbSub[B x].sub z (d x (s none) (s (some none)))))
             (symH (c x (s none) (s (some none)) (s (some (some none))))) >
      Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none))))
        (Cc.AbSub[B x].sub ((B x).add (d x (s (some none)) (s (some (some none)))) (d x (s none) (s (some none)))) (d x (s none) (s (some none))))
        =< apH (Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none))))) (cancel x (d x (s (some none)) (s (some (some none)))) (d x (s none) (s (some none)))) >
      Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none)))) (d x (s (some none)) (s (some (some none))))
        =< Cc.AbSub[B x].sub-self (d x (s (some none)) (s (some (some none)))) > (B x).o } ;
    module Bd (psi : CB.Ch (suc zero)) (b : CB.Bounds (suc zero) phi psi) {
      g : NA.C0 = \ x y -> (B x).inv (psi x (one x y)) ;
      -- psi (y1) - psi (y0) = d y0 y1
      diff (x : X) (y0 y1 : Y x) : Id (B x).A (Cc.AbSub[B x].sub (psi x (one x y1)) (psi x (one x y0))) (d x y0 y1) =
        transH (apH (\ t -> Cc.AbSub[B x].sub (psi x (one x y1)) (psi x t))
                  (symH (one-eq x (Cc.Cochains[B x, Y x].cons zero y0 (Cc.Cochains[B x, Y x].tail zero (Cc.Cochains[B x, Y x].tail (suc zero) (pair x y0 y1)))))))
          (b x (pair x y0 y1)) ;
      bounds : NA.Bounds d g = \ x y0 y1 -> calc (B x).A {
        (B x).add (g x y1) (d x y0 y1) =< apH ((B x).add (g x y1)) (symH (diff x y0 y1)) >
        (B x).add ((B x).inv (psi x (one x y1))) ((B x).add (psi x (one x y1)) ((B x).inv (psi x (one x y0))))
          =< symH ((B x).assoc ((B x).inv (psi x (one x y1))) (psi x (one x y1)) ((B x).inv (psi x (one x y0)))) >
        (B x).add ((B x).add ((B x).inv (psi x (one x y1))) (psi x (one x y1))) ((B x).inv (psi x (one x y0)))
          =< apH (\ z -> (B x).add z ((B x).inv (psi x (one x y0)))) (AbL[B x].invl (psi x (one x y1))) >
        (B x).add (B x).o ((B x).inv (psi x (one x y0))) =< AbL[B x].unitl ((B x).inv (psi x (one x y0))) >
        g x y0 } ;
    } ;
  } ;
  h1zero (z : CB.Vanish (suc zero)) : NA.H1Zero = \ d c ->
    TC.map ((psi : CB.Ch (suc zero)) * CB.Bounds (suc zero) (Given[d, c].phi) psi) ((g : NA.C0) * NA.Bounds d g)
      (\ w -> (Given[d, c].Bd[w.1, w.2].g, Given[d, c].Bd[w.1, w.2].bounds))
      (z (Given[d, c].phi) (Given[d, c].cocycle)) ;
} ;
