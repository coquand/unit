-- Whitehead's principle for 0-connected types, as used for K(A, 1) and
-- in CCA Lemma 3.2.3: a pointed map F : (A, a0) -> (B, b0) of 0-connected
-- types whose looping (DeloopMaps.Maps.loop) is an equivalence is an
-- equivalence.  It is an embedding if A is only 0-connected.
--  1. |loop F| = conj_pF o ap F (DeloopMaps loop-ap), and conjugation by a
--     path is an equivalence (J on the path), so ap F at (a0, a0) is one.
--  2. Being an equivalence is a proposition, so by connectedness of A,
--     ap F is an equivalence at every (x, y): F is an embedding, its
--     fibres are propositions (Groupoid.emb-fib-prop).
--  3. If B is 0-connected each fibre is merely inhabited (b is merely
--     b0 = F a0), hence contractible.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open DeloopMaps[l] ;
module Tr = Truncation[l] ;
module E = Equivalences[l] ;

fib (X Y : U l) (g : X -> Y) (y : Y) : U l = (x : X) * Id Y (g x) y ;

contr-equiv (X Y : U l) (g : X -> Y) (c : (y : Y) -> isContr (fib X Y g y)) : isEquiv X Y g =
  qinv X Y g (\ y -> (c y).1.1) (\ y -> (c y).1.2)
    (\ x -> ap (fib X Y g (g x)) X (\ w -> w.1) (c (g x)).1 (x, refl (g x)) ((c (g x)).2 (x, refl (g x)))) ;

-- the inverse of an equivalence
inv-equiv (X Y : U l) (g : X -> Y) (e : isEquiv X Y g) : isEquiv Y X e.sec =
  qinv Y X e.sec g (sec-ret X Y g e) e.sec-eq ;

-- 2-out-of-3: if k o g is an equivalence and k is one, so is g
cancel-equiv (X Y Z : U l) (g : X -> Y) (k : Y -> Z) (ek : isEquiv Y Z k)
  (ekg : isEquiv X Z (\ x -> k (g x))) : isEquiv X Y g =
  E.homotopy X Y (E.compose X Z Y ((\ x -> k (g x)), ekg) (ek.sec, inv-equiv Y Z k ek)) g
    (\ x -> sym Y (ek.sec (k (g x))) (g x) (sec-ret Y Z k ek (g x))) ;

-- conjugation by a path
conj (B : U l) (c b : B) (p : Id B c b) (w : Id B c c) : Id B b b = trans B b c b (sym B c b p) (trans B c c b w p) ;
conj-equiv (B : U l) (c b : B) (p : Id B c b) : isEquiv (Id B c c) (Id B b b) (conj B c b p) =
  idJ B c (\ b1 p1 -> isEquiv (Id B c c) (Id B b1 b1) (conj B c b1 p1))
    (E.homotopy (Id B c c) (Id B c c) (idEquiv (Id B c c)) (conj B c c (refl c)) (\ w -> trans-refl-l B c c w))
    b p ;

module Pointed (A : U l) (a0 : A) (B : U l) (b0 : B) (F : PtMap A a0 B b0)
  (cA : isConn (suc (suc zero)) A)
  (el : isEquiv ((Id A a0 a0)) ((Id B b0 b0)) (Maps[A, a0, B, b0].loop F).1) {
  ap0 : isEquiv (Id A a0 a0) (Id B (F.1 a0) (F.1 a0)) (ap A B F.1 a0 a0) =
    cancel-equiv (Id A a0 a0) (Id B (F.1 a0) (F.1 a0)) (Id B b0 b0) (ap A B F.1 a0 a0)
      (conj B (F.1 a0) b0 F.2) (conj-equiv B (F.1 a0) b0 F.2)
      (E.homotopy (Id A a0 a0) (Id B b0 b0) ((Maps[A, a0, B, b0].loop F).1, el)
         (\ q -> conj B (F.1 a0) b0 F.2 (ap A B F.1 a0 a0 q))
         (\ q -> sym (Id B b0 b0) ((Maps[A, a0, B, b0].loop F).1 q) (conj B (F.1 a0) b0 F.2 (ap A B F.1 a0 a0 q))
                   (Maps[A, a0, B, b0].loop-ap F q))) ;
  emb (x y : A) : isEquiv (Id A x y) (Id B (F.1 x) (F.1 y)) (ap A B F.1 x y) =
    conn-elim2 zero A a0 cA (\ x1 y1 -> isEquiv (Id A x1 y1) (Id B (F.1 x1) (F.1 y1)) (ap A B F.1 x1 y1))
      (\ x1 y1 -> EquivProp[l].isEquiv-prop (Id A x1 y1) (Id B (F.1 x1) (F.1 y1)) (ap A B F.1 x1 y1)) ap0 x y ;
  fib-prop (b : B) : isProp (fib A B F.1 b) = Groupoid[l].emb-fib-prop A B F.1 emb b ;
  equiv (cB : isConn (suc (suc zero)) B) : isEquiv A B F.1 =
    contr-equiv A B F.1 (\ b ->
      conn-elim zero B b0 cB (\ b1 -> isContr (fib A B F.1 b1)) (\ b1 -> Torsor[l].isProp-isContr (fib A B F.1 b1))
        ((a0, F.2), \ v -> fib-prop b0 (a0, F.2) v) b) ;
} ;
