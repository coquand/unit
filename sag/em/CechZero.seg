-- CCA Lemma B.0.1: Ȟ⁰(X, Y, A) = H⁰(X, A), naturally, for Y x merely
-- inhabited.
--
-- H⁰(X, A) = ||(x : X) -> K(A x, 0)||₀ = (x : X) -> A x (a set).  Ȟ⁰ is the
-- group of 0-cocycles of A's Cochains.Cech: alpha x : (Fin 1 -> Y x) -> A x
-- with delta alpha = 0 (pointwise addition).
--   A constant family a gives the cocycle x |-> (t |-> a x): its
--   differential at (v, w) is a x - a x (by definition).
--   Conversely the cocycle condition at v . t says alpha x t = alpha x (v),
--   so alpha x is weakly constant on the merely inhabited Fin 1 -> Y x and
--   has a value (ConstantMap).
-- The two are inverse: the value of a constant map is the constant; a
-- cocycle is its value at every t (and being a cocycle is a proposition).
-- The map from H⁰ is additive and natural in A by definition.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ; open AbHom[l] ; open FinChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Cc = Cochains[l] ;

module CechZero (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (A : X -> Ab) {
  module CA = Cc.Cech[X, Y, A] ;
  module K (x : X) { module C = Cc.Cochains[A x, Y x] ; module S = Cc.AbSub[A x] ; } ;
  -- the 0-cocycles
  Z0 : U l = (alpha : CA.Ch (suc zero)) * CA.isCocycle zero alpha ;
  cocycle-prop (alpha : CA.Ch (suc zero)) : isProp (CA.isCocycle zero alpha) =
    FL.isProp-Pi X (\ x -> (s : K[x].C.Tup (suc (suc zero))) -> Id (A x).A (CA.d (suc zero) alpha x s) (A x).o) (\ x ->
      FL.isProp-Pi (K[x].C.Tup (suc (suc zero))) (\ s -> Id (A x).A (CA.d (suc zero) alpha x s) (A x).o)
        (\ s -> (A x).setA (CA.d (suc zero) alpha x s) (A x).o)) ;
  H0 : U l = (x : X) -> (A x).A ;

  -- from H⁰: the constant cochains
  const (a : H0) : CA.Ch (suc zero) = \ x t -> a x ;
  const-cocycle (a : H0) : CA.isCocycle zero (const a) = \ x s -> K[x].S.sub-self (a x) ;
  from (a : H0) : Z0 = (const a, const-cocycle a) ;

  -- to H⁰: the value of a cocycle
  module Value (z : Z0) (x : X) {
    f : K[x].C.Tup (suc zero) -> (A x).A = z.1 x ;
    -- the 1-tuple (v) for v = t' none, whatever the empty tail
    single-at (t' : K[x].C.Tup (suc zero)) (u : K[x].C.Tup zero) : (i : Fin (suc zero)) -> Id (Y x) (K[x].C.cons zero (t' none) u i) (t' i) = split {
      none -> refl (t' none) ; some e -> absurd (Id (Y x) (u e) (t' (some e))) e } ;
    single (t' : K[x].C.Tup (suc zero)) (u : K[x].C.Tup zero) : Id (K[x].C.Tup (suc zero)) (K[x].C.cons zero (t' none) u) t' =
      FL.funext (Fin (suc zero)) (\ i -> Y x) (K[x].C.cons zero (t' none) u) t' (single-at t' u) ;
    -- the cocycle condition at (t' none) . t
    wc (t t' : K[x].C.Tup (suc zero)) : Id (A x).A (f t) (f t') =
      symH (transH (symH (apH f (single t' (K[x].C.tail zero t))))
        (K[x].S.sub-zero (f t) (f (K[x].C.cons zero (t' none) (K[x].C.tail zero t))) (z.2 x (K[x].C.cons (suc zero) (t' none) t)))) ;
    inh : Tr.Trunc[K[x].C.Tup (suc zero)].carrier = TC.map (Y x) (K[x].C.Tup (suc zero)) (\ y -> \ i -> y) (hY x) ;
    module M = ConstantMap[l].Constant[K[x].C.Tup (suc zero), (A x).A, (A x).setA, f, wc] ;
    value : (A x).A = M.value inh ;
    value-at (t : K[x].C.Tup (suc zero)) : Id (A x).A value (f t) = M.value-at inh t ;
  } ;
  to (z : Z0) : H0 = \ x -> Value[z, x].value ;

  to-from (a : H0) : Id H0 (to (from a)) a =
    FL.funext X (\ x -> (A x).A) (to (from a)) a (\ x ->
      TC.rec (Y x) @l (Id (A x).A (to (from a) x) (a x)) ((A x).setA (to (from a) x) (a x))
        (\ y -> Value[from a, x].value-at (\ i -> y)) (hY x)) ;
  from-to (z : Z0) : Id Z0 (from (to z)) z =
    Sigma-eq (CA.Ch (suc zero)) (CA.isCocycle zero) (const (to z)) z.1 (const-cocycle (to z)) z.2
      (FL.funext X (\ x -> K[x].C.C (suc zero)) (const (to z)) z.1 (\ x ->
        FL.funext (K[x].C.Tup (suc zero)) (\ t -> (A x).A) (const (to z) x) (z.1 x) (\ t -> Value[z, x].value-at t)))
      (cocycle-prop z.1) ;
  -- Lemma B.0.1
  lemmaB01 : Equiv H0 Z0 = (from, qinv H0 Z0 from to from-to to-from) ;
  -- the isomorphism is additive (pointwise addition on both sides) ...
  from-add (a b : H0) : Id (CA.Ch (suc zero)) (const (\ x -> (A x).add (a x) (b x))) (\ x t -> (A x).add (const a x t) (const b x t)) =
    refl (const (\ x -> (A x).add (a x) (b x))) ;
} ;

-- ... and natural in A: for homomorphisms h x : A x -> B x, from commutes with h
module Natural0 (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (A B : X -> Ab) (h : (x : X) -> Hom (A x) (B x)) {
  module ZA = CechZero[X, Y, hY, A] ;
  module ZB = CechZero[X, Y, hY, B] ;
  natural (a : ZA.H0) : Id (ZB.CA.Ch (suc zero)) (ZB.const (\ x -> (h x).1 (a x))) (\ x t -> (h x).1 (ZA.const a x t)) =
    refl (ZB.const (\ x -> (h x).1 (a x))) ;
} ;
