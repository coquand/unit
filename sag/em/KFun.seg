-- K(-, m) is a functor on homomorphisms of abelian groups:
--     K(h o g, m) = K(g, m) ; K(h, m)      as pointed maps, for every m,
-- and equal homomorphisms have equal deloopings.
-- Induction on m.  m = 0: both are h o g on points, and the pointings
-- agree (the target is a set).  m + 1: K(A, m+1) is m-connected and
-- K(C, m+1) is (m+1)-truncated, so pointed maps with equal loopings are
-- equal (LoopCalc.unique-loop, unique-loop1 at m = 0), and
--   loop (K g ; K h) = loop K g ; loop K h = conj (K g m) ; conj (K h m)
--                    = conj (K g m ; K h m) = conj (K (h g) m) = loop K (h g)
-- with conj F = e ; F ; e^-1 (loopK) and conj-comp (the middle e^-1 ; e
-- cancels).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
open HLevels[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ; open Torsor[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module N = NatArith[l] ;
module EMf = EM[l] ;

-- conj F ; conj F' = conj (F ; F'), conj F = e ; F ; e^-1
conj-comp (OA : U l) (oa : OA) (A : U l) (a : A) (OB : U l) (ob : OB) (B : U l) (b : B) (OC : U l) (oc : OC) (C : U l) (c : C)
  (eA : PtEquiv OA oa A a) (eB : PtEquiv OB ob B b) (eC : PtEquiv OC oc C c) (F : PtMap A a B b) (F' : PtMap B b C c) :
  Id (PtMap OA oa OC oc)
    (ptcomp OA oa OB ob OC oc (ptcomp OA oa B b OB ob (ptcomp OA oa A a B b eA.1 F) (pt-inv OB ob B b eB).1)
                              (ptcomp OB ob C c OC oc (ptcomp OB ob B b C c eB.1 F') (pt-inv OC oc C c eC).1))
    (ptcomp OA oa C c OC oc (ptcomp OA oa A a C c eA.1 (ptcomp A a B b C c F F')) (pt-inv OC oc C c eC).1) = calc (PtMap OA oa OC oc) {
  ptcomp OA oa OB ob OC oc (ptcomp OA oa B b OB ob (ptcomp OA oa A a B b eA.1 F) (pt-inv OB ob B b eB).1)
                           (ptcomp OB ob C c OC oc (ptcomp OB ob B b C c eB.1 F') (pt-inv OC oc C c eC).1)
    =< ptcomp-assoc OA oa B b OB ob OC oc (ptcomp OA oa A a B b eA.1 F) (pt-inv OB ob B b eB).1
         (ptcomp OB ob C c OC oc (ptcomp OB ob B b C c eB.1 F') (pt-inv OC oc C c eC).1) >
  ptcomp OA oa B b OC oc (ptcomp OA oa A a B b eA.1 F)
    (ptcomp B b OB ob OC oc (pt-inv OB ob B b eB).1 (ptcomp OB ob C c OC oc (ptcomp OB ob B b C c eB.1 F') (pt-inv OC oc C c eC).1))
    =< apH (ptcomp OA oa B b OC oc (ptcomp OA oa A a B b eA.1 F)) (calc (PtMap B b OC oc) {
         ptcomp B b OB ob OC oc (pt-inv OB ob B b eB).1 (ptcomp OB ob C c OC oc (ptcomp OB ob B b C c eB.1 F') (pt-inv OC oc C c eC).1)
           =< symH (ptcomp-assoc B b OB ob C c OC oc (pt-inv OB ob B b eB).1 (ptcomp OB ob B b C c eB.1 F') (pt-inv OC oc C c eC).1) >
         ptcomp B b C c OC oc (ptcomp B b OB ob C c (pt-inv OB ob B b eB).1 (ptcomp OB ob B b C c eB.1 F')) (pt-inv OC oc C c eC).1
           =< apH (\ G -> ptcomp B b C c OC oc G (pt-inv OC oc C c eC).1) (symH (ptcomp-assoc B b OB ob B b C c (pt-inv OB ob B b eB).1 eB.1 F')) >
         ptcomp B b C c OC oc (ptcomp B b B b C c (ptcomp B b OB ob B b (pt-inv OB ob B b eB).1 eB.1) F') (pt-inv OC oc C c eC).1
           =< apH (\ G -> ptcomp B b C c OC oc (ptcomp B b B b C c G F') (pt-inv OC oc C c eC).1) (pt-inv-r OB ob B b eB) >
         ptcomp B b C c OC oc (ptcomp B b B b C c (ptid B b) F') (pt-inv OC oc C c eC).1
           =< apH (\ G -> ptcomp B b C c OC oc G (pt-inv OC oc C c eC).1) (ptcomp-idl B b C c F') >
         ptcomp B b C c OC oc F' (pt-inv OC oc C c eC).1 }) >
  ptcomp OA oa B b OC oc (ptcomp OA oa A a B b eA.1 F) (ptcomp B b C c OC oc F' (pt-inv OC oc C c eC).1)
    =< symH (ptcomp-assoc OA oa B b C c OC oc (ptcomp OA oa A a B b eA.1 F) F' (pt-inv OC oc C c eC).1) >
  ptcomp OA oa C c OC oc (ptcomp OA oa B b C c (ptcomp OA oa A a B b eA.1 F) F') (pt-inv OC oc C c eC).1
    =< apH (\ G -> ptcomp OA oa C c OC oc G (pt-inv OC oc C c eC).1) (ptcomp-assoc OA oa A a B b C c eA.1 F F') >
  ptcomp OA oa C c OC oc (ptcomp OA oa A a C c eA.1 (ptcomp A a B b C c F F')) (pt-inv OC oc C c eC).1 } ;

-- maps out of K(A, m+1) into K(B, m+1) with equal loopings are equal
module Unloop (Ga Gb : Ab) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  tB (n : Nat) : isTrunc (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) (B.K (suc (suc n))) =
    trunc-index (B.K (suc (suc n))) (N.plus n (suc (suc (suc (suc n))))) (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) (EMf.idx n)
      (trunc-lift (suc (suc (suc (suc n)))) (B.K (suc (suc n))) (B.trunc (suc n)) n) ;
  unloop : (m : Nat) (F F' : PtMap (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m))) ->
    Id (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO)
      (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop F) (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop F') ->
    Id (PtMap (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m))) F F' = split {
    zero -> \ F F' e -> unique-loop1 zero (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (A.conn zero) (B.trunc zero) F F' e ;
    suc n -> \ F F' e -> unique-loop (suc n) (A.K (suc (suc n))) (A.pt (suc (suc n))) (B.K (suc (suc n))) (B.pt (suc (suc n)))
      (A.conn (suc n)) (tB n) F F' e } ;
} ;

-- the composite homomorphism
hcomp (Ga Gb Gc : Ab) (g : Hom Ga Gb) (h : Hom Gb Gc) : Hom Ga Gc =
  (\ a -> h.1 (g.1 a), \ x y -> transH (apH h.1 (g.2 x y)) (h.2 (g.1 x) (g.1 y))) ;

module Comp (Ga Gb Gc : Ab) (g : Hom Ga Gb) (h : Hom Gb Gc) {
  module A = KK[Ga] ; module B = KK[Gb] ; module C = KK[Gc] ;
  module KG = KMap[Ga, Gb, g] ;
  module KH = KMap[Gb, Gc, h] ;
  module KHG = KMap[Ga, Gc, hcomp Ga Gb Gc g h] ;
  Stmt (m : Nat) : U l = Id (PtMap (A.K m) (A.pt m) (C.K m) (C.pt m)) (KHG.K m)
    (ptcomp (A.K m) (A.pt m) (B.K m) (B.pt m) (C.K m) (C.pt m) (KG.K m) (KH.K m)) ;
  base : Stmt zero =
    ptmap-path Ga.A Ga.o Gc.A Gc.o (KHG.K zero).1 (ptcomp Ga.A Ga.o Gb.A Gb.o Gc.A Gc.o (KG.K zero) (KH.K zero)).1
      (KHG.K zero).2 (ptcomp Ga.A Ga.o Gb.A Gb.o Gc.A Gc.o (KG.K zero) (KH.K zero)).2 (\ a -> refl (h.1 (g.1 a)))
      (Gc.setA (h.1 (g.1 Ga.o)) Gc.o (KHG.K zero).2
         (trans Gc.A (h.1 (g.1 Ga.o)) (h.1 (g.1 Ga.o)) Gc.o (refl (h.1 (g.1 Ga.o))) (ptcomp Ga.A Ga.o Gb.A Gb.o Gc.A Gc.o (KG.K zero) (KH.K zero)).2)) ;
  module Step (m : Nat) (ih : Stmt m) {
    module MA = Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)] ;
    loops : Id MA.PMO (MA.loop (KHG.K (suc m))) (MA.loop (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (KG.K (suc m)) (KH.K (suc m)))) =
      calc MA.PMO {
      MA.loop (KHG.K (suc m)) =< KHG.loopK m > KHG.conj m (KHG.K m)
        =< apH (KHG.conj m) ih > KHG.conj m (ptcomp (A.K m) (A.pt m) (B.K m) (B.pt m) (C.K m) (C.pt m) (KG.K m) (KH.K m))
        =< symH (conj-comp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m)
             ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (C.K m) (C.pt m) (A.e m) (B.e m) (C.e m) (KG.K m) (KH.K m)) >
      ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (KG.conj m (KG.K m)) (KH.conj m (KH.K m))
        =< symH (transH (apH (\ G -> ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) G
                                      (Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (KH.K (suc m)))) (KG.loopK m))
                        (apH (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (KG.conj m (KG.K m))) (KH.loopK m))) >
      ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m)))
        (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (KG.K (suc m))) (Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (KH.K (suc m)))
        =< symH (loop-comp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (KG.K (suc m)) (KH.K (suc m))) >
      MA.loop (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (KG.K (suc m)) (KH.K (suc m))) } ;
    result : Stmt (suc m) = Unloop[Ga, Gc].unloop m (KHG.K (suc m))
      (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (KG.K (suc m)) (KH.K (suc m))) loops ;
  } ;
  -- K(h o g, m) = K(g, m) ; K(h, m)
  k-comp : (m : Nat) -> Stmt m = split {
    zero -> base ;
    suc m | r -> Step[m, r].result } ;
} ;

-- equal homomorphisms have equal deloopings
hom-path (Ga Gb : Ab) (g g' : Hom Ga Gb) (e : (a : Ga.A) -> Id Gb.A (g.1 a) (g'.1 a)) : Id (Hom Ga Gb) g g' =
  Sigma-eq (Ga.A -> Gb.A) (\ f -> (x y : Ga.A) -> Id Gb.A (f (Ga.add x y)) (Gb.add (f x) (f y))) g.1 g'.1 g.2 g'.2
    (FL.funext Ga.A (\ a -> Gb.A) g.1 g'.1 e)
    (FL.isProp-Pi Ga.A (\ x -> (y : Ga.A) -> Id Gb.A (g'.1 (Ga.add x y)) (Gb.add (g'.1 x) (g'.1 y))) (\ x ->
      FL.isProp-Pi Ga.A (\ y -> Id Gb.A (g'.1 (Ga.add x y)) (Gb.add (g'.1 x) (g'.1 y))) (\ y -> Gb.setA (g'.1 (Ga.add x y)) (Gb.add (g'.1 x) (g'.1 y))))) ;
k-resp (Ga Gb : Ab) (g g' : Hom Ga Gb) (e : (a : Ga.A) -> Id Gb.A (g.1 a) (g'.1 a)) (m : Nat) :
  Id (PtMap (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m)) (KMap[Ga, Gb, g].K m) (KMap[Ga, Gb, g'].K m) =
  apH (\ h -> KMap[Ga, Gb, h].K m) (hom-path Ga Gb g g' e) ;
