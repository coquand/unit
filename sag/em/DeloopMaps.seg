-- DW1 §3: deloopings of maps.  Pointed (A, a0), (B, b0); OA = (a0 = a0),
-- OB = (b0 = b0) pointed by refl; f : OA ->pt OB.
--
--   D a b h p : OA ->pt OB,  |D a b h p| q = (h p)^-1 . h (p . q),
--       for h : (a = a0) -> (b = b0) and p : a = a0;
--   C a b = (h : (a = a0) -> (b = b0)) * ((p : a = a0) -> f = D a b h p);
--   the looping of F : A ->pt B is  loop F = D a0 (F a0) (Kf F a0) refl,
--       Kf F a p : F a = b0 by J on p from the pointing of F (loop-ap:
--       |loop F| q = pF^-1 . ap F q . pF);
--   Unloop f = (F : A ->pt B) * (f = loop F)       (DW1: Omega^-1 f).
--
-- Lemma 9, as a retract  Unloop f <| (a : A) -> (b : B) * C a b:
--   for a fixed underlying F, (pF, f = loop F) is a retract of
--   (pF, (a p) -> f = D a (F a) (Kf F a) p) (J, i.e. Yoneda: evaluate at
--   (a0, refl)); Kf is an equivalence from F a0 = b0 to the maps
--   H : (a : A) -> (a = a0) -> F a = b0 (evaluation at (a0, refl)), so
--   Sigma over it is a retract of Sigma over H (Retracts.rt-base); and
--   (H, (a p) -> f = D a (F a) (H a) p) is (a : A) -> C a (F a).
-- Corollary 10: A c-connected, B (2c+t)-truncated (t = m+2) give
--   Unloop f (t-2)-truncated.  Each (b : B) * C a b is; by connectedness
--   take a = a0; adding the singleton (b, h refl) and contracting it, then
--   adding the singleton (h, f = h) and contracting it, it is a retract of
--   pointed sections of p |-> (f = D a0 b0 |f| p) over OA, with
--   (c+t-1)-truncated fibres over a (c-1)-connected base: Lemma 4.
--   The second contraction uses E h : h = D a0 b0 |h| refl, a path of
--   pointed maps whose pointing part is the coherence `coh` (J).
-- Corollary 11 (t = 0): Unloop f is contractible.
-- Corollary 12, for c = 0 (all that is used): A 0-connected, B
--   1-truncated, f multiplicative; then Unloop f is contractible.  It is a
--   proposition (Corollary 10, t = 1), and C a0 b0 holds with h = |f|:
--   (f p)^-1 f (p q) = f q by multiplicativity; the pointing part is in
--   the set OB.  By connectedness every (b : B) * C a b is inhabited.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open Retracts[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module G = Groupoid[l] ;
module N = NatArith[l] ;

-- the other singleton
singL (T : U l) (t : T) : isContr ((y : T) * Id T t y) =
  ((t, refl t), \ w -> idJ T t (\ y1 q1 -> Id ((y : T) * Id T t y) (t, refl t) (y1, q1)) (refl (t, refl t)) w.1 w.2) ;

------------------------------------------------------------------------
-- paths of pointed maps

-- transport of a pointing along a path of maps
subst-pt (X : U l) (x0 : X) (Y : U l) (y0 : Y) (k k' : X -> Y) (P : Id (X -> Y) k k') (w : Id Y (k x0) y0) :
  Id (Id Y (k' x0) y0) (subst (X -> Y) (\ g -> Id Y (g x0) y0) k k' P w)
    (trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (happly X (\ x -> Y) k k' P x0)) w) =
  idJ (X -> Y) k (\ k1 P1 -> Id (Id Y (k1 x0) y0) (subst (X -> Y) (\ g -> Id Y (g x0) y0) k k1 P1 w)
      (trans Y (k1 x0) (k x0) y0 (sym Y (k x0) (k1 x0) (happly X (\ x -> Y) k k1 P1 x0)) w))
    (sym (Id Y (k x0) y0) (trans Y (k x0) (k x0) y0 (refl (k x0)) w) w (trans-refl-l Y (k x0) y0 w)) k' P ;

-- two pointed maps are equal by a homotopy H and a coherence at the point
ptmap-path (X : U l) (x0 : X) (Y : U l) (y0 : Y) (k k' : X -> Y) (w : Id Y (k x0) y0) (w' : Id Y (k' x0) y0)
  (H : (x : X) -> Id Y (k x) (k' x)) (c : Id (Id Y (k x0) y0) w (trans Y (k x0) (k' x0) y0 (H x0) w'))
  : Id (PtMap X x0 Y y0) (k, w) (k', w') =
  Sigma-path (X -> Y) (\ g -> Id Y (g x0) y0) k k' w w' (FL.funext X (\ x -> Y) k k' H)
    (calc (Id Y (k' x0) y0) {
      subst (X -> Y) (\ g -> Id Y (g x0) y0) k k' (FL.funext X (\ x -> Y) k k' H) w
        =< subst-pt X x0 Y y0 k k' (FL.funext X (\ x -> Y) k k' H) w >
      trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (happly X (\ x -> Y) k k' (FL.funext X (\ x -> Y) k k' H) x0)) w
        =< ap (Id Y (k x0) (k' x0)) (Id Y (k' x0) y0) (\ e -> trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) e) w)
             (happly X (\ x -> Y) k k' (FL.funext X (\ x -> Y) k k' H) x0) (H x0)
             (happly X (\ x -> Id Y (k x) (k' x)) (happly X (\ x -> Y) k k' (FL.funext X (\ x -> Y) k k' H)) H
                (FL.happly-funext X (\ x -> Y) k k' H) x0) >
      trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (H x0)) w
        =< ap (Id Y (k x0) y0) (Id Y (k' x0) y0) (trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (H x0)))
             w (trans Y (k x0) (k' x0) y0 (H x0) w') c >
      trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (H x0)) (trans Y (k x0) (k' x0) y0 (H x0) w')
        =< trans-cancel Y (k x0) (k' x0) y0 (H x0) w' >
      w' }) ;

------------------------------------------------------------------------

module Maps (A : U l) (a0 : A) (B : U l) (b0 : B) {
  OA : U l = Id A a0 a0 ;
  OB : U l = Id B b0 b0 ;
  PMO : U l = PtMap OA (refl a0) OB (refl b0) ;

  D (a : A) (b : B) (h : Id A a a0 -> Id B b b0) (p : Id A a a0) : PMO =
    (\ q -> trans B b0 b b0 (sym B b b0 (h p)) (h (trans A a a0 a0 p q)), trans-sym-l B b b0 (h p)) ;

  Kf (F : A -> B) (pF : Id B (F a0) b0) (a : A) (p : Id A a a0) : Id B (F a) b0 =
    idJR A a0 (\ a1 p1 -> Id B (F a1) b0) pF a p ;

  loop (F : PtMap A a0 B b0) : PMO = D a0 (F.1 a0) (Kf F.1 F.2 a0) (refl a0) ;

  -- Kf is conjugated ap; so the looping is the usual one
  kf-ap (F : A -> B) (pF : Id B (F a0) b0) (a : A) (p : Id A a a0) :
    Id (Id B (F a) b0) (Kf F pF a p) (trans B (F a) (F a0) b0 (ap A B F a a0 p) pF) =
    idJR A a0 (\ a1 p1 -> Id (Id B (F a1) b0) (Kf F pF a1 p1) (trans B (F a1) (F a0) b0 (ap A B F a1 a0 p1) pF))
      (sym (Id B (F a0) b0) (trans B (F a0) (F a0) b0 (refl (F a0)) pF) pF (trans-refl-l B (F a0) b0 pF)) a p ;
  loop-ap (F : PtMap A a0 B b0) (q : OA) :
    Id OB ((loop F).1 q) (trans B b0 (F.1 a0) b0 (sym B (F.1 a0) b0 F.2) (trans B (F.1 a0) (F.1 a0) b0 (ap A B F.1 a0 a0 q) F.2)) =
    transH (ap OA OB (\ q1 -> trans B b0 (F.1 a0) b0 (sym B (F.1 a0) b0 F.2) (Kf F.1 F.2 a0 q1))
              (trans A a0 a0 a0 (refl a0) q) q (trans-refl-l A a0 a0 q))
           (ap (Id B (F.1 a0) b0) OB (trans B b0 (F.1 a0) b0 (sym B (F.1 a0) b0 F.2))
              (Kf F.1 F.2 a0 q) (trans B (F.1 a0) (F.1 a0) b0 (ap A B F.1 a0 a0 q) F.2) (kf-ap F.1 F.2 a0 q)) ;

  -- E h : h = D a0 b0 |h| refl
  eG (r : OB) (w : Id OB r (refl b0)) (s : OB) : Id OB s (trans B b0 b0 b0 (sym B b0 b0 r) s) =
    trans OB s (trans B b0 b0 b0 (refl b0) s) (trans B b0 b0 b0 (sym B b0 b0 r) s)
      (sym OB (trans B b0 b0 b0 (refl b0) s) s (trans-refl-l B b0 b0 s))
      (ap OB OB (\ z -> trans B b0 b0 b0 (sym B b0 b0 z) s) (refl b0) r (sym OB r (refl b0) w)) ;
  coh (r : OB) (w : Id OB r (refl b0)) :
    Id (Id OB r (refl b0)) w (trans OB r (trans B b0 b0 b0 (sym B b0 b0 r) r) (refl b0) (eG r w r) (trans-sym-l B b0 b0 r)) =
    idJR OB (refl b0) (\ r1 w1 -> Id (Id OB r1 (refl b0)) w1
        (trans OB r1 (trans B b0 b0 b0 (sym B b0 b0 r1) r1) (refl b0) (eG r1 w1 r1) (trans-sym-l B b0 b0 r1)))
      (refl (refl (refl b0))) r w ;
  E (hs : PMO) : Id PMO hs (D a0 b0 hs.1 (refl a0)) =
    ptmap-path OA (refl a0) OB (refl b0) hs.1 (D a0 b0 hs.1 (refl a0)).1 hs.2 (trans-sym-l B b0 b0 (hs.1 (refl a0)))
      (\ q -> trans OB (hs.1 q) (trans B b0 b0 b0 (sym B b0 b0 (hs.1 (refl a0))) (hs.1 q))
                (trans B b0 b0 b0 (sym B b0 b0 (hs.1 (refl a0))) (hs.1 (trans A a0 a0 a0 (refl a0) q)))
                (eG (hs.1 (refl a0)) hs.2 (hs.1 q))
                (ap OA OB (\ q1 -> trans B b0 b0 b0 (sym B b0 b0 (hs.1 (refl a0))) (hs.1 q1))
                   q (trans A a0 a0 a0 (refl a0) q) (sym OA (trans A a0 a0 a0 (refl a0) q) q (trans-refl-l A a0 a0 q))))
      (coh (hs.1 (refl a0)) hs.2) ;

  ----------------------------------------------------------------------

  module Over (f : PMO) {
    C (a : A) (b : B) : U l = (h : Id A a a0 -> Id B b b0) * ((p : Id A a a0) -> Id PMO f (D a b h p)) ;
    Unloop : U l = (F : PtMap A a0 B b0) * Id PMO f (loop F) ;
    Rel : U l = (a : A) -> (b : B) * C a b ;

    -- Lemma 9, for a fixed underlying map F
    module Fixed (F : A -> B) {
      OS : U l = (pF : Id B (F a0) b0) * Id PMO f (loop (F, pF)) ;
      Hom (a : A) : U l = Id A a a0 -> Id B (F a) b0 ;
      Ys : U l = (a : A) -> Hom a ;
      M (H : Ys) (a : A) (p : Id A a a0) : U l = Id PMO f (D a (F a) (H a) p) ;
      Phi (H : Ys) : U l = (a : A) (p : Id A a a0) -> M H a p ;
      yoneda (pF : Id B (F a0) b0) : Retract[M (Kf F pF) a0 (refl a0), Phi (Kf F pF)] =
        new Retract[M (Kf F pF) a0 (refl a0), Phi (Kf F pF),
          \ e a p -> idJR A a0 (\ a1 p1 -> M (Kf F pF) a1 p1) e a p, \ w -> w a0 (refl a0), \ e -> refl e] ;
      ev (H : Ys) : Id B (F a0) b0 = H a0 (refl a0) ;
      kf-ev (H : Ys) : Id Ys (Kf F (ev H)) H =
        FL.funext A Hom (Kf F (ev H)) H (\ a -> FL.funext (Id A a a0) (\ p -> Id B (F a) b0) (Kf F (ev H) a) (H a)
          (\ p -> idJR A a0 (\ a1 p1 -> Id (Id B (F a1) b0) (Kf F (ev H) a1 p1) (H a1 p1)) (refl (ev H)) a p)) ;
      kf-equiv : Equiv (Id B (F a0) b0) Ys =
        (Kf F, qinv (Id B (F a0) b0) Ys (Kf F) ev kf-ev (\ pF -> refl pF)) ;
      step : Retract[OS, (a : A) -> C a (F a)] =
        rt-comp OS ((pF : Id B (F a0) b0) * Phi (Kf F pF)) ((a : A) -> C a (F a))
          (rt-Sigma (Id B (F a0) b0) (\ pF -> M (Kf F pF) a0 (refl a0)) (\ pF -> Phi (Kf F pF)) yoneda)
          (rt-comp ((pF : Id B (F a0) b0) * Phi (Kf F pF)) ((H : Ys) * Phi H) ((a : A) -> C a (F a))
             (rt-base (Id B (F a0) b0) Ys kf-equiv Phi)
             (new Retract[(H : Ys) * Phi H, (a : A) -> C a (F a), \ w a -> (w.1 a, w.2 a),
                \ g -> (\ a -> (g a).1, \ a -> (g a).2), \ w -> refl w])) ;
    } ;

    lemma9 : Retract[Unloop, Rel] =
      rt-comp Unloop ((F : A -> B) * Fixed[F].OS) Rel
        (new Retract[Unloop, (F : A -> B) * Fixed[F].OS, \ w -> (w.1.1, w.1.2, w.2),
           \ v -> ((v.1, v.2.1), v.2.2), \ w -> refl w])
        (rt-comp ((F : A -> B) * Fixed[F].OS) ((F : A -> B) * ((a : A) -> C a (F a))) Rel
           (rt-Sigma (A -> B) (\ F -> Fixed[F].OS) (\ F -> (a : A) -> C a (F a)) (\ F -> Fixed[F].step))
           (new Retract[(F : A -> B) * ((a : A) -> C a (F a)), Rel, \ w a -> (w.1 a, w.2 a),
              \ k -> (\ a -> (k a).1, \ a -> (k a).2), \ w -> refl w])) ;

    ------------------------------------------------------------------
    -- Corollary 10

    module Levels (c t : Nat) (cA : isConn (suc (suc c)) A) (tB : isTrunc (N.plus (suc c) (N.plus (suc c) t)) B) {
      cOA : isConn (suc c) OA = conn-id (suc c) A cA a0 a0 ;
      tPMO : isTrunc (suc (N.plus c t)) PMO = cor5-map (suc (N.plus c t)) c OA (refl a0) cOA OB (refl b0) (tB b0 b0) ;

      -- (b : B) * C a0 b, after the two singleton contractions
      Sing : U l = (b : B) * Id B b b0 ;
      G1 (bq : Sing) : U l =
        (h : OA -> Id B bq.1 b0) * (w : Id (Id B bq.1 b0) (h (refl a0)) bq.2) * ((p : OA) -> Id PMO f (D a0 bq.1 h p)) ;
      s1 (v : (b : B) * C a0 b) : (bq : Sing) * G1 bq = ((v.1, v.2.1 (refl a0)), (v.2.1, refl (v.2.1 (refl a0)), v.2.2)) ;
      r1 (v : (bq : Sing) * G1 bq) : (b : B) * C a0 b = (v.1.1, v.2.1, v.2.2.2) ;
      X1 : U l = (hs : PMO) * ((p : OA) -> Id PMO f (D a0 b0 hs.1 p)) ;
      s2 (v : G1 (b0, refl b0)) : X1 = ((v.1, v.2.1), v.2.2) ;
      r2 (v : X1) : G1 (b0, refl b0) = (v.1.1, v.1.2, v.2) ;
      Sing2 : U l = (hs : PMO) * Id PMO f hs ;
      G2 (he : Sing2) : U l = (k : (p : OA) -> Id PMO f (D a0 b0 he.1.1 p)) *
        Id (Id PMO f (D a0 b0 he.1.1 (refl a0))) (k (refl a0)) (trans PMO f he.1 (D a0 b0 he.1.1 (refl a0)) he.2 (E he.1)) ;
      s3 (v : X1) : (he : Sing2) * G2 he =
        ((v.1, trans PMO f (D a0 b0 v.1.1 (refl a0)) v.1 (v.2 (refl a0)) (sym PMO v.1 (D a0 b0 v.1.1 (refl a0)) (E v.1))),
         (v.2, sym (Id PMO f (D a0 b0 v.1.1 (refl a0)))
                 (trans PMO f v.1 (D a0 b0 v.1.1 (refl a0))
                    (trans PMO f (D a0 b0 v.1.1 (refl a0)) v.1 (v.2 (refl a0)) (sym PMO v.1 (D a0 b0 v.1.1 (refl a0)) (E v.1)))
                    (E v.1))
                 (v.2 (refl a0))
                 (G.cancel-r' PMO f v.1 (D a0 b0 v.1.1 (refl a0)) (v.2 (refl a0)) (E v.1)))) ;
      r3 (v : (he : Sing2) * G2 he) : X1 = (v.1.1, v.2.1) ;
      -- by definition, the fibre at the centre (f, refl) is a type of pointed sections
      g2-centre : Id (U l) (G2 (f, refl f))
          (PtSec OA (refl a0) (\ p -> Id PMO f (D a0 b0 f.1 p)) (trans PMO f f (D a0 b0 f.1 (refl a0)) (refl f) (E f))) =
        refl (PtSec OA (refl a0) (\ p -> Id PMO f (D a0 b0 f.1 p)) (trans PMO f f (D a0 b0 f.1 (refl a0)) (refl f) (E f))) ;
      cell0 : isTrunc t ((b : B) * C a0 b) =
        retract-trunc t ((b : B) * C a0 b) ((bq : Sing) * G1 bq) s1 r1 (\ v -> refl v)
          (trunc-Sigma-contr t Sing G1 (sing B b0)
            (retract-trunc t (G1 (b0, refl b0)) X1 s2 r2 (\ v -> refl v)
              (retract-trunc t X1 ((he : Sing2) * G2 he) s3 r3 (\ v -> refl v)
                (trunc-Sigma-contr t Sing2 G2 (singL PMO f)
                  (lemma4 t c OA (refl a0) cOA (\ p -> Id PMO f (D a0 b0 f.1 p))
                     (\ p -> tPMO f (D a0 b0 f.1 p)) (trans PMO f f (D a0 b0 f.1 (refl a0)) (refl f) (E f))))))) ;
      cell (a : A) : isTrunc t ((b : B) * C a b) =
        conn-elim c A a0 cA (\ a1 -> isTrunc t ((b : B) * C a1 b)) (\ a1 -> trunc-prop t ((b : B) * C a1 b)) cell0 a ;
      cor10 : isTrunc t Unloop =
        rt-trunc t Unloop Rel lemma9 (trunc-Pi t A (\ a -> (b : B) * C a b) cell) ;
    } ;

    -- Corollary 11
    cor11 (c : Nat) (cA : isConn (suc (suc c)) A) (tB : isTrunc (N.plus (suc c) (N.plus (suc c) zero)) B) : isContr Unloop =
      Levels[c, zero, cA, tB].cor10 ;

    -- Corollary 12, for A 0-connected and B 1-truncated
    module Mult (cA : isConn (suc (suc zero)) A) (tB : isTrunc (suc (suc (suc zero))) B)
      (m : (p q : OA) -> Id OB (f.1 (trans A a0 a0 a0 p q)) (trans B b0 b0 b0 (f.1 p) (f.1 q))) {
      module L = Levels[zero, suc zero, cA, tB] ;
      hm (p q : OA) : Id OB (f.1 q) (trans B b0 b0 b0 (sym B b0 b0 (f.1 p)) (f.1 (trans A a0 a0 a0 p q))) =
        sym OB (trans B b0 b0 b0 (sym B b0 b0 (f.1 p)) (f.1 (trans A a0 a0 a0 p q))) (f.1 q)
          (trans OB (trans B b0 b0 b0 (sym B b0 b0 (f.1 p)) (f.1 (trans A a0 a0 a0 p q)))
             (trans B b0 b0 b0 (sym B b0 b0 (f.1 p)) (trans B b0 b0 b0 (f.1 p) (f.1 q))) (f.1 q)
             (ap OB OB (trans B b0 b0 b0 (sym B b0 b0 (f.1 p))) (f.1 (trans A a0 a0 a0 p q))
                (trans B b0 b0 b0 (f.1 p) (f.1 q)) (m p q))
             (trans-cancel B b0 b0 b0 (f.1 p) (f.1 q))) ;
      mult-cell (p : OA) : Id PMO f (D a0 b0 f.1 p) =
        ptmap-path OA (refl a0) OB (refl b0) f.1 (D a0 b0 f.1 p).1 f.2 (trans-sym-l B b0 b0 (f.1 p)) (hm p)
          (trunc-one-prop (Id OB (f.1 (refl a0)) (refl b0)) (tB b0 b0 (f.1 (refl a0)) (refl b0)) f.2
             (trans OB (f.1 (refl a0)) ((D a0 b0 f.1 p).1 (refl a0)) (refl b0) (hm p (refl a0)) (trans-sym-l B b0 b0 (f.1 p)))) ;
      cell0 : (b : B) * C a0 b = (b0, f.1, mult-cell) ;
      rel : Rel = \ a -> conn-elim zero A a0 cA (\ a1 -> (b : B) * C a1 b)
        (\ a1 -> trunc-one-prop ((b : B) * C a1 b) (L.cell a1)) cell0 a ;
      cor12 : isContr Unloop = (lemma9.r rel, \ v -> trunc-one-prop Unloop L.cor10 (lemma9.r rel) v) ;
    } ;
  } ;
} ;
