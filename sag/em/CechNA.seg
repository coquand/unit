-- Non-abelian Čech cohomology in degree 1 (CCA Def. 3.1.1, 3.1.2,
-- Appendix A), in the vanishing form.  X a type, Y x merely inhabited,
-- G x groups.  Left torsors (GTorsor), so CCA's formulas are mirrored;
-- written without inverses:
--   a cocycle is  delta : (x : X) -> Y x -> Y x -> G x  with
--       delta y1 y2 . delta y0 y1 = delta y0 y2,
--   it is trivial (cohomologous to the unit cocycle) if merely there is
--   gamma : (x : X) -> Y x -> G x  with  gamma y1 . delta y0 y1 = gamma y0
--   (Bounds), and  Ȟ¹(X, Y, G) = 0  is: every cocycle is trivial (H1Zero);
--   H¹(X, G) = 0  is: every alpha : (x : X) -> BG x is merely trivial
--   (CohZero; BG x = G x-torsors).
--
-- Lemma A.0.1: a section t of Y makes every cocycle trivial, with
--   gamma y = delta y (t x) (the cocycle condition).
-- Lemma A.0.2 (i): points beta x y of alpha x give the cocycle
--   phi y0 y1 = the g with g . beta y0 = beta y1.
-- Lemma A.0.6, vanishing form (`Trivialise`): if phi is trivial by gamma,
--   the points gamma y . beta y do not depend on y, so (Y x merely
--   inhabited, CechComplex.Constant) give a point of alpha x, and alpha x
--   is trivial.
-- Lemma A.0.4: for a cocycle delta (one x), psi delta = the gamma :
--   Y -> G with Bounds, with g . gamma = (y |-> g . gamma y), is a torsor,
--   with points H ybar = (y |-> delta y ybar) (cocycle condition).
-- Cor. A.0.8, vanishing form: if H¹((x : X) * Y x, G o pr1) = 0, then
--   H¹(X, G) = 0 iff Ȟ¹(X, Y, G) = 0.  (=>: psi of a cocycle has a point,
--   which is a bounding gamma; this direction needs no hypothesis.
--   <=: alpha restricted to (x : X) * Y x is merely trivial, i.e. has
--   points over Y; then Trivialise.)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open Group[l] ; open GTorsor[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;

-- H¹(X, G) = 0
CohZero (X : U l) (G : X -> Grp) : U l+ = (alpha : (x : X) -> GTor[G x].Tor) ->
  T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].carrier ;

module CechNA (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (G : X -> Grp) {
  C0 : U l = (x : X) -> Y x -> (G x).G ;
  C1 : U l = (x : X) -> Y x -> Y x -> (G x).G ;
  Cocycle (d : C1) : U l = (x : X) (y0 y1 y2 : Y x) ->
    Id (G x).G ((G x).mul (d x y1 y2) (d x y0 y1)) (d x y0 y2) ;
  Bounds (d : C1) (g : C0) : U l = (x : X) (y0 y1 : Y x) ->
    Id (G x).G ((G x).mul (g x y1) (d x y0 y1)) (g x y0) ;
  Trivial (d : C1) : U l = Tr.Trunc[(g : C0) * Bounds d g].carrier ;
  -- Ȟ¹(X, Y, G) = 0
  H1Zero : U l = (d : C1) -> Cocycle d -> Trivial d ;

  -- Lemma A.0.1
  lemmaA01 (t : (x : X) -> Y x) : H1Zero = \ d c ->
    Tr.Trunc[(g : C0) * Bounds d g].inc (\ x y -> d x y (t x), \ x y0 y1 -> c x y0 y1 (t x)) ;

  -- Lemma A.0.2 (i): the cocycle of points
  module Points (alpha : (x : X) -> GTor[G x].Tor) (beta : (x : X) -> Y x -> (alpha x).1) {
    phi : C1 = \ x y0 y1 -> GTor[G x].D[(alpha x).1, (alpha x).2].diff (beta x y0) (beta x y1) ;
    cocycle : Cocycle phi = \ x y0 y1 y2 ->
      symH (GTor[G x].D[(alpha x).1, (alpha x).2].uniq (beta x y0) (beta x y2) ((G x).mul (phi x y1 y2) (phi x y0 y1)) (calc (alpha x).1 {
        GTor[G x].D[(alpha x).1, (alpha x).2].act ((G x).mul (phi x y1 y2) (phi x y0 y1)) (beta x y0)
          =< GTor[G x].D[(alpha x).1, (alpha x).2].ad (phi x y1 y2) (phi x y0 y1) (beta x y0) >
        GTor[G x].D[(alpha x).1, (alpha x).2].act (phi x y1 y2) (GTor[G x].D[(alpha x).1, (alpha x).2].act (phi x y0 y1) (beta x y0))
          =< apH (GTor[G x].D[(alpha x).1, (alpha x).2].act (phi x y1 y2)) (GTor[G x].D[(alpha x).1, (alpha x).2].dact (beta x y0) (beta x y1)) >
        GTor[G x].D[(alpha x).1, (alpha x).2].act (phi x y1 y2) (beta x y1)
          =< GTor[G x].D[(alpha x).1, (alpha x).2].dact (beta x y1) (beta x y2) > beta x y2 })) ;

    -- Lemma A.0.6, vanishing form
    module Trivialise (g : C0) (b : Bounds phi g) {
      moved (x : X) (y : Y x) : (alpha x).1 = GTor[G x].D[(alpha x).1, (alpha x).2].act (g x y) (beta x y) ;
      const (x : X) (y0 y1 : Y x) : Id (alpha x).1 (moved x y1) (moved x y0) = calc (alpha x).1 {
        GTor[G x].D[(alpha x).1, (alpha x).2].act (g x y1) (beta x y1)
          =< apH (GTor[G x].D[(alpha x).1, (alpha x).2].act (g x y1)) (symH (GTor[G x].D[(alpha x).1, (alpha x).2].dact (beta x y0) (beta x y1))) >
        GTor[G x].D[(alpha x).1, (alpha x).2].act (g x y1) (GTor[G x].D[(alpha x).1, (alpha x).2].act (phi x y0 y1) (beta x y0))
          =< symH (GTor[G x].D[(alpha x).1, (alpha x).2].ad (g x y1) (phi x y0 y1) (beta x y0)) >
        GTor[G x].D[(alpha x).1, (alpha x).2].act ((G x).mul (g x y1) (phi x y0 y1)) (beta x y0)
          =< apH (\ a -> GTor[G x].D[(alpha x).1, (alpha x).2].act a (beta x y0)) (b x y0 y1) >
        GTor[G x].D[(alpha x).1, (alpha x).2].act (g x y0) (beta x y0) } ;
      point (x : X) : (alpha x).1 =
        CechComplex[l].Constant[Y x, (alpha x).1, GTor[G x].D[(alpha x).1, (alpha x).2].sT, moved x, \ u v -> const x v u].value (hY x) ;
      trivial (x : X) : Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv) =
        P1.sym (GTor[G x].Tor) (GTor[G x].triv) (alpha x) (GTor[G x].pt-triv (alpha x) (point x)) ;
    } ;
    trivialise (z : Trivial phi) : T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].carrier =
      TC.rec ((g : C0) * Bounds phi g) @(l+) (T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].carrier)
        T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].proposition
        (\ w -> T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].inc Trivialise[w.1, w.2].trivial) z ;
  } ;
} ;

------------------------------------------------------------------------
-- Lemma A.0.4: the torsor of a cocycle (for one x)

module Psi (Y : U l) (hY : Tr.Trunc[Y].carrier) (Gr : Grp) (d : Y -> Y -> Gr.G)
  (c : (y0 y1 y2 : Y) -> Id Gr.G (Gr.mul (d y1 y2) (d y0 y1)) (d y0 y2)) {
  open Gr ;
  open GrpL[Gr] ;
  module T = GTor[Gr] ;
  Cond (g : Y -> G) : U l = (y0 y1 : Y) -> Id G (mul (g y1) (d y0 y1)) (g y0) ;
  cond-prop (g : Y -> G) : isProp (Cond g) =
    FL.isProp-Pi Y (\ y0 -> (y1 : Y) -> Id G (mul (g y1) (d y0 y1)) (g y0)) (\ y0 ->
    FL.isProp-Pi Y (\ y1 -> Id G (mul (g y1) (d y0 y1)) (g y0)) (\ y1 -> setG (mul (g y1) (d y0 y1)) (g y0))) ;
  P : U l = (g : Y -> G) * Cond g ;
  setP : isSet P = Torsor[l].isSet-sub (Y -> G) Cond (FL.isSet-Pi Y (\ y -> G) (\ y -> setG)) cond-prop ;
  P-eq (u v : P) (h : (y : Y) -> Id G (u.1 y) (v.1 y)) : Id P u v =
    Sigma-eq (Y -> G) Cond u.1 v.1 u.2 v.2 (FL.funext Y (\ y -> G) u.1 v.1 h) (cond-prop v.1) ;
  act (a : G) (u : P) : P =
    (\ y -> mul a (u.1 y), \ y0 y1 -> transH (assoc a (u.1 y1) (d y0 y1)) (apH (mul a) (u.2 y0 y1))) ;
  -- (i) the points
  H (yb : Y) : P = (\ y -> d y yb, \ y0 y1 -> c y0 y1 yb) ;
  -- (ii) the torsor
  ad : T.AD P act = \ a b u -> P-eq (act (mul a b) u) (act a (act b u)) (\ y -> assoc a b (u.1 y)) ;
  ze : T.ZE P act = \ u -> P-eq (act e u) u (\ y -> unitl (u.1 y)) ;
  -- for u, v : P and y0 : Y, g0 = v y0 . (u y0)^-1 moves u to v:
  -- (g0 . u y) . d y0 y = g0 . u y0 = v y0 = v y . d y0 y, cancel d y0 y
  rcancel (a b c : G) (h : Id G (mul a c) (mul b c)) : Id G a b = transH (solve-r a c (mul b c) h) (cancr' c b) ;
  g0 (u v : P) (y0 : Y) : G = mul (v.1 y0) (inv (u.1 y0)) ;
  moves (u v : P) (y0 y : Y) : Id G (mul (g0 u v y0) (u.1 y)) (v.1 y) =
    rcancel (mul (g0 u v y0) (u.1 y)) (v.1 y) (d y0 y) (calc G {
      mul (mul (g0 u v y0) (u.1 y)) (d y0 y) =< assoc (g0 u v y0) (u.1 y) (d y0 y) >
      mul (g0 u v y0) (mul (u.1 y) (d y0 y)) =< apH (mul (g0 u v y0)) (u.2 y0 y) >
      mul (g0 u v y0) (u.1 y0) =< cancr (u.1 y0) (v.1 y0) >
      v.1 y0 =< symH (v.2 y0 y) > mul (v.1 y) (d y0 y) }) ;
  ftk (y0 : Y) (u v : P) : isContr ((a : G) * Id P (act a u) v) =
    ((g0 u v y0, P-eq (act (g0 u v y0) u) v (moves u v y0)),
     \ z -> Sigma-eq G (\ a -> Id P (act a u) v) (g0 u v y0) z.1 (P-eq (act (g0 u v y0) u) v (moves u v y0)) z.2
       (symH (solve-r z.1 (u.1 y0) (v.1 y0)
          (happly Y (\ y -> G) (act z.1 u).1 v.1 (ap P (Y -> G) (\ w -> w.1) (act z.1 u) v z.2) y0)))
       (setP (act z.1 u) v)) ;
  ft : T.FT P act = \ u v ->
    Tr.Trunc[Y].induction @l (\ y -> isContr ((a : G) * Id P (act a u) v))
      (\ y -> Torsor[l].isProp-isContr ((a : G) * Id P (act a u) v)) (\ y0 -> ftk y0 u v) hY ;
  tor : T.Tor = (P, (act, setP, ad, ze, ft, TC.map Y P H hY)) ;
} ;

------------------------------------------------------------------------
-- Corollary A.0.8, vanishing form

module CorA08 (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (G : X -> Grp) {
  module C = CechNA[X, Y, hY, G] ;
  -- H¹(X, G) = 0 gives Ȟ¹(X, Y, G) = 0: the torsor of a cocycle has a point
  forward (z : CohZero X G) : C.H1Zero = \ d c ->
    TC1.rec ((x : X) -> Id (GTor[G x].Tor) (Psi[Y x, hY x, G x, d x, c x].tor) (GTor[G x].triv)) @l (C.Trivial d)
      Tr.Trunc[(g : C.C0) * C.Bounds d g].proposition
      (\ q -> Tr.Trunc[(g : C.C0) * C.Bounds d g].inc
         (\ x -> (GTor[G x].triv-pt (Psi[Y x, hY x, G x, d x, c x].tor)
                    (P1.sym (GTor[G x].Tor) (Psi[Y x, hY x, G x, d x, c x].tor) (GTor[G x].triv) (q x))).1,
          \ x -> (GTor[G x].triv-pt (Psi[Y x, hY x, G x, d x, c x].tor)
                    (P1.sym (GTor[G x].Tor) (Psi[Y x, hY x, G x, d x, c x].tor) (GTor[G x].triv) (q x))).2))
      (z (\ x -> Psi[Y x, hY x, G x, d x, c x].tor)) ;
  -- if H¹((x : X) * Y x, G) = 0, then Ȟ¹(X, Y, G) = 0 gives H¹(X, G) = 0
  backward (hyp : CohZero ((x : X) * Y x) (\ w -> G w.1)) (z : C.H1Zero) : CohZero X G = \ alpha ->
    TC1.rec ((w : (x : X) * Y x) -> Id (GTor[G w.1].Tor) (alpha w.1) (GTor[G w.1].triv)) @(l+)
      (T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].carrier)
      T1.Trunc[(x : X) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].proposition
      (\ q -> C.Points[alpha, \ x y -> GTor[G x].triv-pt (alpha x)
                 (P1.sym (GTor[G x].Tor) (alpha x) (GTor[G x].triv) (q (x, y)))].trivialise
         (z (C.Points[alpha, \ x y -> GTor[G x].triv-pt (alpha x)
                 (P1.sym (GTor[G x].Tor) (alpha x) (GTor[G x].triv) (q (x, y)))].phi)
            (C.Points[alpha, \ x y -> GTor[G x].triv-pt (alpha x)
                 (P1.sym (GTor[G x].Tor) (alpha x) (GTor[G x].triv) (q (x, y)))].cocycle)))
      (hyp (\ w -> alpha w.1)) ;
} ;
