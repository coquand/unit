-- G-torsors for a group G, not necessarily abelian (CCA Def. A.0.3), as in
-- pn/Torsor.TorBase and pn/TorsorId.TorId for abelian groups, whose
-- arguments use no commutativity: for Gr = ab-grp A the structure TorStr
-- is pn's A-torsor structure by definition.
--
-- Convention: a LEFT action (as pn/Torsor), so CCA's right G-torsors are
-- left torsors here and CCA's formulas are mirrored (Appendix A:
-- beta(y0)^-1 beta(y1) becomes "the g with g . beta y0 = beta y1").
--
--   HE        an equivariant map of torsors is a bijection
--   contr     (Y : Tor) * Hom X Y is contractible (induction on
--             equivalences), so decode : Hom X Y -> X = Y (TorsorId)
--   triv      the trivial torsor G (left multiplication)
--   pt-triv   a point p of X gives triv = X (a |-> a . p is equivariant);
--   triv-pt   conversely a path triv = X gives the point (transport of e)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open Group[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module E1 = FunExtUA[l+] ;

module GTor (Gr : Grp) {
  open Gr ;
  open GrpL[Gr] ;

  AD (T : U l) (act : G -> T -> T) : U l = (a b : G) (t : T) -> Id T (act (mul a b) t) (act a (act b t)) ;
  ZE (T : U l) (act : G -> T -> T) : U l = (t : T) -> Id T (act e t) t ;
  FT (T : U l) (act : G -> T -> T) : U l = (t t' : T) -> isContr ((a : G) * Id T (act a t) t') ;
  Rest3 (T : U l) (act : G -> T -> T) : U l = (ft : FT T act) * Tr.Trunc[T].carrier ;
  Rest2 (T : U l) (act : G -> T -> T) : U l = (ze : ZE T act) * Rest3 T act ;
  Rest (T : U l) (act : G -> T -> T) : U l = (ad : AD T act) * Rest2 T act ;
  Laws (T : U l) (act : G -> T -> T) : U l = (sT : isSet T) * Rest T act ;
  TorStr (T : U l) : U l = (act : G -> T -> T) * Laws T act ;

  laws-prop (T : U l) (act : G -> T -> T) : isProp (Laws T act) =
    isProp-Sigma (isSet T) (\ sT -> Rest T act) (Torsor[l].isProp-isSet T) (\ sT ->
    isProp-Sigma (AD T act) (\ x -> Rest2 T act)
      (FL.isProp-Pi G (\ a -> (b : G) (t : T) -> Id T (act (mul a b) t) (act a (act b t))) (\ a ->
       FL.isProp-Pi G (\ b -> (t : T) -> Id T (act (mul a b) t) (act a (act b t))) (\ b ->
       FL.isProp-Pi T (\ t -> Id T (act (mul a b) t) (act a (act b t))) (\ t ->
         sT (act (mul a b) t) (act a (act b t)))))) (\ x ->
    isProp-Sigma (ZE T act) (\ x' -> Rest3 T act)
      (FL.isProp-Pi T (\ t -> Id T (act e t) t) (\ t -> sT (act e t) t)) (\ x' ->
    isProp-Sigma (FT T act) (\ x'' -> Tr.Trunc[T].carrier)
      (FL.isProp-Pi T (\ t -> (t' : T) -> isContr ((a : G) * Id T (act a t) t')) (\ t ->
       FL.isProp-Pi T (\ t' -> isContr ((a : G) * Id T (act a t) t')) (\ t' ->
         Torsor[l].isProp-isContr ((a : G) * Id T (act a t) t'))))
      (\ x'' -> Tr.Trunc[T].proposition)))) ;

  -- the difference: the a with  a . t = t'
  module D (T : U l) (s : TorStr T) {
    act : G -> T -> T = s.1 ;
    sT : isSet T = s.2.1 ;
    ad : AD T act = s.2.2.1 ;
    ze : ZE T act = s.2.2.2.1 ;
    ft : FT T act = s.2.2.2.2.1 ;
    inh : Tr.Trunc[T].carrier = s.2.2.2.2.2 ;
    diff (t t' : T) : G = (ft t t').1.1 ;
    dact (t t' : T) : Id T (act (diff t t') t) t' = (ft t t').1.2 ;
    uniq (t t' : T) (a : G) (p : Id T (act a t) t') : Id G (diff t t') a =
      ap ((b : G) * Id T (act b t) t') G (\ w -> w.1) (ft t t').1 (a, p) ((ft t t').2 (a, p)) ;
  } ;

  Tor : U l+ = (T : U l) * TorStr T ;

  EqvH (X Y : Tor) (f : X.1 -> Y.1) : U l = (a : G) (t : X.1) -> Id Y.1 (f (X.2.1 a t)) (Y.2.1 a (f t)) ;
  Hom (X Y : Tor) : U l = (f : X.1 -> Y.1) * EqvH X Y f ;
  idhom (X : Tor) : Hom X X = (\ t -> t, \ a t -> refl (X.2.1 a t)) ;
  idtohom (X Y : Tor) (p : Id Tor X Y) : Hom X Y = idJ Tor X (\ Z q -> Hom X Z) (idhom X) Y p ;
  eqvh-prop (X Y : Tor) (f : X.1 -> Y.1) : isProp (EqvH X Y f) =
    FL.isProp-Pi G (\ a -> (t : X.1) -> Id Y.1 (f (X.2.1 a t)) (Y.2.1 a (f t))) (\ a ->
    FL.isProp-Pi X.1 (\ t -> Id Y.1 (f (X.2.1 a t)) (Y.2.1 a (f t))) (\ t ->
      Y.2.2.1 (f (X.2.1 a t)) (Y.2.1 a (f t)))) ;

  -- an equivariant map of torsors is a bijection
  module HE (X Y : Tor) (f : Hom X Y) {
    module DX = D[X.1, X.2] ;
    module DY = D[Y.1, Y.2] ;
    Fib (y : Y.1) : U l = (t : X.1) * Id Y.1 (f.1 t) y ;
    cen (t0 : X.1) (y : Y.1) : Fib y =
      (X.2.1 (DY.diff (f.1 t0) y) t0, transH (f.2 (DY.diff (f.1 t0) y) t0) (DY.dact (f.1 t0) y)) ;
    same (t0 : X.1) (y : Y.1) (z : Fib y) : Id G (DY.diff (f.1 t0) y) (DX.diff t0 z.1) =
      DY.uniq (f.1 t0) y (DX.diff t0 z.1) (calc Y.1 {
        Y.2.1 (DX.diff t0 z.1) (f.1 t0)
          =< symH (f.2 (DX.diff t0 z.1) t0) > f.1 (X.2.1 (DX.diff t0 z.1) t0)
          =< ap X.1 Y.1 f.1 (X.2.1 (DX.diff t0 z.1) t0) z.1 (DX.dact t0 z.1) > f.1 z.1
          =< z.2 > y }) ;
    fibk (t0 : X.1) (y : Y.1) : isContr (Fib y) =
      (cen t0 y,
       \ z -> Sigma-eq X.1 (\ t -> Id Y.1 (f.1 t) y) (cen t0 y).1 z.1 (cen t0 y).2 z.2
                (transH (ap G X.1 (\ b -> X.2.1 b t0) (DY.diff (f.1 t0) y) (DX.diff t0 z.1) (same t0 y z))
                        (DX.dact t0 z.1))
                (DY.sT (f.1 z.1) y)) ;
    fib (y : Y.1) : isContr (Fib y) =
      Tr.Trunc[X.1].induction @l (\ x -> isContr (Fib y)) (\ x -> Torsor[l].isProp-isContr (Fib y))
        (\ t0 -> fibk t0 y) DX.inh ;
    equiv : Equiv X.1 Y.1 =
      (f.1, qinv X.1 Y.1 f.1 (\ y -> (fib y).1.1) (\ y -> (fib y).1.2)
              (\ t -> ap (Fib (f.1 t)) X.1 (\ z -> z.1) (fib (f.1 t)).1 (t, refl (f.1 t))
                        ((fib (f.1 t)).2 (t, refl (f.1 t))))) ;
  } ;

  -- (Y : Tor) * Hom X Y is contractible
  TH (X : Tor) : U l+ = (Y : Tor) * Hom X Y ;
  base-path (X : Tor) (s2 : TorStr X.1) (p : Id (TorStr X.1) X.2 s2)
    : (h : EqvH X (X.1, s2) (\ t -> t)) -> Id (TH X) (X, idhom X) ((X.1, s2), (\ t -> t, h)) =
    idJ (TorStr X.1) X.2
      (\ s3 q -> (h : EqvH X (X.1, s3) (\ t -> t)) -> Id (TH X) (X, idhom X) ((X.1, s3), (\ t -> t, h)))
      (\ h -> P1.ap (EqvH X X (\ t -> t)) (TH X) (\ h' -> (X, (\ t -> t, h'))) (idhom X).2 h
                (eqvh-prop X X (\ t -> t) (idhom X).2 h))
      s2 p ;
  Mot (X : Tor) (T' : U l) (e1 : Equiv X.1 T') : U l+ =
    (s' : TorStr T') -> (h : EqvH X (T', s') e1.1) -> Id (TH X) (X, idhom X) ((T', s'), (e1.1, h)) ;
  mot-base (X : Tor) : Mot X X.1 (idEquiv X.1) = \ s' h ->
    base-path X s'
      (Sigma-eq (G -> X.1 -> X.1) (Laws X.1) X.2.1 s'.1 X.2.2 s'.2
        (FL.funext G (\ a -> X.1 -> X.1) X.2.1 s'.1 (\ a ->
           FL.funext X.1 (\ t -> X.1) (X.2.1 a) (s'.1 a) (\ t -> h a t)))
        (laws-prop X.1 s'.1))
      h ;
  contr (X : Tor) : E1.isContr (TH X) =
    ((X, idhom X), \ w -> Torsor[l].eqind X.1 (Mot X) (mot-base X) w.1.1 HE[X, w.1, w.2].equiv w.1.2 w.2.2) ;
  decode (X Y : Tor) (f : Hom X Y) : Id Tor X Y =
    P1.ap (TH X) Tor (\ w -> w.1) (X, idhom X) (Y, f) (E1.pathC (TH X) (contr X) (X, idhom X) (Y, f)) ;

  ----------------------------------------------------------------------
  -- the trivial torsor, and points as trivialisations

  gft : FT G mul = \ t t' ->
    ((mul t' (inv t), cancr t t'),
     \ z -> Sigma-eq G (\ a -> Id G (mul a t) t') (mul t' (inv t)) z.1 (cancr t t') z.2
              (symH (solve-r z.1 t t' z.2)) (setG (mul z.1 t) t')) ;
  triv : Tor = (G, (mul, setG, assoc, unitl, gft, Tr.Trunc[G].inc e)) ;

  pt-hom (X : Tor) (p : X.1) : Hom triv X = (\ a -> X.2.1 a p, \ a t -> X.2.2.2.1 a t p) ;
  pt-triv (X : Tor) (p : X.1) : Id Tor triv X = decode triv X (pt-hom X p) ;
  triv-pt (X : Tor) (q : Id Tor triv X) : X.1 = (idtohom triv X q).1 e ;
} ;
