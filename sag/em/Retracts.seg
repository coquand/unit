-- Retracts A <| B (s : A -> B, r : B -> A, r (s a) = a) as a record, and
-- the operations used to chain them: identity, composition, Sigma of
-- retracts, and Sigma over an equivalence of bases
--     (x : X) * Phi (K x)  <|  (y : Y) * Phi y    for K : X ~ Y
-- (univalence: induction on K, Torsor.eqind).  Levels pass to retracts
-- (HLevels.retract-trunc).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open HLevels[l] ;

record Retract (A B : U l) {
  s : A -> B ;
  r : B -> A ;
  h (a : A) : Id A (r (s a)) a ;
} ;

rt-trunc (n : Nat) (A B : U l) (R : Retract[A, B]) (t : isTrunc n B) : isTrunc n A =
  retract-trunc n A B R.s R.r R.h t ;

rt-id (A : U l) : Retract[A, A] = new Retract[A, A, \ a -> a, \ a -> a, \ a -> refl a] ;

rt-comp (A B C : U l) (R : Retract[A, B]) (Q : Retract[B, C]) : Retract[A, C] =
  new Retract[A, C, \ a -> Q.s (R.s a), \ c -> R.r (Q.r c),
    \ a -> trans A (R.r (Q.r (Q.s (R.s a)))) (R.r (R.s a)) a (ap B A R.r (Q.r (Q.s (R.s a))) (R.s a) (Q.h (R.s a))) (R.h a)] ;

-- a family of retracts gives a retract of Sigma types
rt-Sigma (X : U l) (P Q : X -> U l) (R : (x : X) -> Retract[P x, Q x]) :
  Retract[(x : X) * P x, (x : X) * Q x] =
  new Retract[(x : X) * P x, (x : X) * Q x, \ w -> (w.1, (R w.1).s w.2), \ w -> (w.1, (R w.1).r w.2),
    \ w -> ap (P w.1) ((x : X) * P x) (\ u -> (w.1, u)) ((R w.1).r ((R w.1).s w.2)) w.2 ((R w.1).h w.2)] ;

-- Sigma over an equivalence of bases
rt-base (X Y : U l) (K : Equiv X Y) (Phi : Y -> U l) : Retract[(x : X) * Phi (K.1 x), (y : Y) * Phi y] =
  Axioms[l].UnivalenceLemmas[univ @l].eqind X (\ Y1 K1 -> (Phi1 : Y1 -> U l) -> Retract[(x : X) * Phi1 (K1.1 x), (y : Y1) * Phi1 y])
    (\ Phi1 -> rt-id ((x : X) * Phi1 x)) Y K Phi ;
