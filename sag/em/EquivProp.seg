-- Being an equivalence (Prelude.isEquiv, bi-invertible) is a proposition.
-- Same argument as chatelet/Prop331Paths.isEquiv-prop, which is not linked
-- here because it sits behind the algebra files (AlgebraPointsIdentity):
-- by induction on equivalences (Torsor.eqind) it suffices to take the
-- identity, where both halves are  (s : A -> A) * (s ~ id),  a singleton
-- by function extensionality.  Eta for the record isEquiv is its
-- eliminator.
level l ; open Base ; open Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

eta (A B : U l) (f : A -> B) : (e : isEquiv A B f) ->
  Id (isEquiv A B f) (struct { sec = e.sec ; sec-eq = e.sec-eq ; ret = e.ret ; ret-eq = e.ret-eq }) e = split {
  IsEquiv s se r re -> refl (struct { sec = s ; sec-eq = se ; ret = r ; ret-eq = re }) } ;

half-prop (A : U l) : isProp ((s : A -> A) * ((b : A) -> Id A (s b) b)) =
  retract-prop ((s : A -> A) * ((b : A) -> Id A (s b) b)) ((s : A -> A) * Id (A -> A) s (\ b -> b))
    (\ w -> (w.1, FL.funext A (\ b -> A) w.1 (\ b -> b) w.2))
    (\ w -> (w.1, happly A (\ b -> A) w.1 (\ b -> b) w.2))
    (\ w -> ap ((b : A) -> Id A (w.1 b) b) ((s : A -> A) * ((b : A) -> Id A (s b) b)) (\ h -> (w.1, h))
       (happly A (\ b -> A) w.1 (\ b -> b) (FL.funext A (\ b -> A) w.1 (\ b -> b) w.2)) w.2
       (FL.happly-funext A (\ b -> A) w.1 (\ b -> b) w.2))
    (\ u v -> FunExtUA[l].pathC ((s : A -> A) * Id (A -> A) s (\ b -> b)) (FunExtUA[l].sing (A -> A) (\ b -> b)) u v) ;

id-equiv-prop (A : U l) : isProp (isEquiv A A (\ a -> a)) =
  retract-prop (isEquiv A A (\ a -> a))
    (((s : A -> A) * ((b : A) -> Id A (s b) b)) * ((s : A -> A) * ((b : A) -> Id A (s b) b)))
    (\ e -> ((e.sec, e.sec-eq), (e.ret, e.ret-eq)))
    (\ w -> struct { sec = w.1.1 ; sec-eq = w.1.2 ; ret = w.2.1 ; ret-eq = w.2.2 })
    (eta A A (\ a -> a))
    (isProp-Sigma ((s : A -> A) * ((b : A) -> Id A (s b) b)) (\ w -> (s : A -> A) * ((b : A) -> Id A (s b) b))
       (half-prop A) (\ w -> half-prop A)) ;

isEquiv-prop (A B : U l) (f : A -> B) : isProp (isEquiv A B f) = \ e1 e2 ->
  Torsor[l].eqind A (\ B' d -> isProp (isEquiv A B' d.1)) (id-equiv-prop A) B (f, e1) e1 e2 ;
