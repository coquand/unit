-- Connectedness levels (DW1 footnote 2), indexed by Nat with offset 2:
--     isConn n X   means   X is (n-2)-connected:
-- every type is (-2)-connected, and X is (n-1)-connected iff it is merely
-- inhabited and its identity types are (n-2)-connected.
--   conn-prop     being (n-2)-connected is a proposition
--   conn-elim     over a pointed (n-1)-connected type with n >= 1 (so at
--                 least 0-connected), a family of propositions holding at
--                 the point holds everywhere: x is merely a0, then J.
--   conn-down     (n-1)-connected types are (n-2)-connected
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

isConn : Nat -> U l -> U l = split {
  zero -> \ X -> Top ;
  suc n | r -> \ X -> Tr.Trunc[X].carrier * ((x y : X) -> r (Id X x y)) } ;

-- by definition
isConn-suc (n : Nat) (X : U l) :
  Id (U l) (isConn (suc n) X) (Tr.Trunc[X].carrier * ((x y : X) -> isConn n (Id X x y))) =
  refl (Tr.Trunc[X].carrier * ((x y : X) -> isConn n (Id X x y))) ;

-- accessors
conn-inh (n : Nat) (X : U l) (c : isConn (suc n) X) : Tr.Trunc[X].carrier = c.1 ;
conn-id (n : Nat) (X : U l) (c : isConn (suc n) X) (x y : X) : isConn n (Id X x y) = c.2 x y ;
-- in a 0-connected type any two points are merely equal
conn-path (n : Nat) (X : U l) (c : isConn (suc (suc n)) X) (x y : X) : Tr.Trunc[Id X x y].carrier =
  conn-inh n (Id X x y) (conn-id (suc n) X c x y) ;

conn-prop : (n : Nat) (X : U l) -> isProp (isConn n X) = split {
  zero -> \ X -> isTop ;
  suc n | r -> \ X -> isProp-Sigma Tr.Trunc[X].carrier (\ h -> (x y : X) -> isConn n (Id X x y))
    Tr.Trunc[X].proposition (\ h -> FL.isProp-Pi X (\ x -> (y : X) -> isConn n (Id X x y)) (\ x ->
      FL.isProp-Pi X (\ y -> isConn n (Id X x y)) (\ y -> r (Id X x y)))) } ;

conn-down : (n : Nat) (X : U l) -> isConn (suc n) X -> isConn n X = split {
  zero -> \ X c -> tt ;
  suc n | r -> \ X c -> (c.1, \ x y -> r (Id X x y) (c.2 x y)) } ;

conn-elim (n : Nat) (X : U l) (a0 : X) (c : isConn (suc (suc n)) X) (P : X -> U l)
  (pP : (x : X) -> isProp (P x)) (p0 : P a0) (x : X) : P x =
  Tr.Trunc[Id X a0 x].induction @l (\ q -> P x) (\ q -> pP x)
    (\ q -> subst X P a0 x q p0) (conn-path n X c a0 x) ;

-- two variables: a family of propositions over X x X holding at (a0, a0)
conn-elim2 (n : Nat) (X : U l) (a0 : X) (c : isConn (suc (suc n)) X) (P : X -> X -> U l)
  (pP : (x y : X) -> isProp (P x y)) (p0 : P a0 a0) (x y : X) : P x y =
  conn-elim n X a0 c (\ x1 -> P x1 y) (\ x1 -> pP x1 y)
    (conn-elim n X a0 c (\ y1 -> P a0 y1) (\ y1 -> pP a0 y1) p0 y) x ;

-- a pointed type whose loop spaces at the point are (n-2)-connected, and
-- which is 0-connected, is (n-1)-connected
conn-from-point (n : Nat) (X : U l) (a0 : X) (c0 : (x y : X) -> Tr.Trunc[Id X x y].carrier)
  (cl : isConn (suc n) (Id X a0 a0)) : isConn (suc (suc n)) X =
  (Tr.Trunc[X].inc a0, \ x y ->
    Tr.Trunc[Id X a0 x].induction @l (\ q -> isConn (suc n) (Id X x y)) (\ q -> conn-prop (suc n) (Id X x y))
      (\ q -> Tr.Trunc[Id X a0 y].induction @l (\ q' -> isConn (suc n) (Id X x y)) (\ q' -> conn-prop (suc n) (Id X x y))
         (\ q' -> idJ X a0 (\ x1 q1 -> isConn (suc n) (Id X x1 y))
                    (idJ X a0 (\ y1 q1 -> isConn (suc n) (Id X a0 y1)) cl y q') x q)
         (c0 a0 y))
      (c0 a0 x)) ;

-- an n-connected type (n >= 0) is 0-connected
conn-zero : (n : Nat) (X : U l) -> isConn (suc (suc n)) X -> isConn (suc (suc zero)) X = split {
  zero -> \ X c -> c ;
  suc n | r -> \ X c -> r X (conn-down (suc (suc n)) X c) } ;
