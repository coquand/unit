-- Eilenberg-MacLane spaces K(A, n) for an abelian group A (DW1 §4.1).
--
-- K(A, 1): the small A-torsors TrivG.K (pn/TrivialGerbe, pointed by the
--   trivial torsor), 0-connected and 1-truncated, with band
--   (x = x) ~ A at every x (Z.kb), a group isomorphism.
-- K(A, 2): by Corollary 8 (n = 0), T K(A, 1) is the delooping as soon as
--   it is merely inhabited, e.g. by a homogeneous structure
--   mu : (x : K(A,1)) -> K(A,1) ~pt (K(A,1), x).  DW1 obtains it from the
--   centre Z(A) = A; here directly: for each x the group isomorphism
--   f_x = band_x^-1 o band_k0 : (k0 = k0) -> (x = x) is multiplicative,
--   so by Corollary 12 it deloops to a pointed map K(A,1) ->pt (K(A,1), x)
--   whose looping is f_x, an equivalence; by Whitehead's principle the
--   map is an equivalence.
-- K(A, n+3) = T K(A, n+2) (Corollary 7: K(A, n+2) is (n+1)-connected and
--   (n+2)-truncated, and n+2 <= 2(n+1)), by recursion on n, with the
--   levels of T X (Deloop.Torsors.Deloop.tor-conn, tor-trunc) and
--   Omega K(A, n+3) ~pt K(A, n+2) (Theorem 2).
-- Indexing: em n = K(A, n+1), isConn (n+2) (n-connected), isTrunc (n+3)
--   ((n+1)-truncated).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ;
open Torsor[l] ;
module Tr = Truncation[l] ; module P1 = Prelude[l+] ; module N = NatArith[l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ;
module TD = Deloop[l] ;

-- the index arithmetic of Corollary 7 for K(A, n+2):  n+4 <= 2(n+2)
idx (n : Nat) : Id Nat (N.plus n (suc (suc (suc (suc n))))) (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) = calc Nat {
  N.plus n (suc (suc (suc (suc n))))
    =< N.plus-suc n (suc (suc (suc n))) > suc (N.plus n (suc (suc (suc n))))
    =< apH (\ k -> suc k) (N.plus-suc n (suc (suc n))) > suc (suc (N.plus n (suc (suc n))))
    =< ap Nat Nat (\ k -> suc (suc (N.plus n (suc (suc k))))) n (N.plus n zero) (sym Nat (N.plus n zero) n (N.plus-zero n)) >
  suc (suc (N.plus n (suc (suc (N.plus n zero))))) } ;

module EM1 (Gr : Ab) {
  open Gr ;
  open AbL[Gr] ;
  module Z = TrivialGerbe[l].TrivG[Gr] ;
  K1 : U l = Z.K ;
  k0 : K1 = Z.k0 ;
  conn1 : isConn (suc (suc zero)) K1 = (Tr.Trunc[K1].inc k0, \ x y -> (Z.k-conn x y, \ p q -> tt)) ;
  trunc1 : isTrunc (suc (suc (suc zero))) K1 = \ x y -> set-trunc (Id K1 x y) (Z.k-gpd x y) ;

  -- the band, a group isomorphism (x = x) ~ A
  band (x : K1) (lp : Id K1 x x) : A = Z.kb x lp ;
  unband (x : K1) (c : A) : Id K1 x x = (Z.kb-be x c).1.1 ;
  band-unband (x : K1) (c : A) : Id A (band x (unband x c)) c = (Z.kb-be x c).1.2 ;
  band-inj (x : K1) (u v : Id K1 x x) (e : Id A (band x u) (band x v)) : Id (Id K1 x x) u v =
    ap ((lp : Id K1 x x) * Id A (band x lp) (band x v)) (Id K1 x x) (\ w -> w.1) (u, e) (v, refl (band x v))
      (pathC ((lp : Id K1 x x) * Id A (band x lp) (band x v)) (Z.kb-be x (band x v)) (u, e) (v, refl (band x v))) ;
  unband-band (x : K1) (lp : Id K1 x x) : Id (Id K1 x x) (unband x (band x lp)) lp =
    band-inj x (unband x (band x lp)) lp (band-unband x (band x lp)) ;
  band-equiv (x : K1) : Equiv (Id K1 x x) A =
    (band x, qinv (Id K1 x x) A (band x) (unband x) (band-unband x) (unband-band x)) ;
  band-hom (x : K1) (p q : Id K1 x x) : Id A (band x (trans K1 x x x p q)) (add (band x p) (band x q)) = Z.kb-hom x p q ;
  band-unit (x : K1) : Id A (band x (refl x)) o =
    transH (solve (band x (refl x)) (band x (refl x)) (band x (refl x)) (symH (band-hom x (refl x) (refl x))))
      (invr (band x (refl x))) ;

  -- f_x = band_x^-1 o band_k0
  fx (x : K1) (q : Id K1 k0 k0) : Id K1 x x = unband x (band k0 q) ;
  fx-pt (x : K1) : Id (Id K1 x x) (fx x (refl k0)) (refl x) =
    band-inj x (fx x (refl k0)) (refl x)
      (transH (band-unband x (band k0 (refl k0))) (transH (band-unit k0) (symH (band-unit x)))) ;
  fx-mult (x : K1) (p q : Id K1 k0 k0) :
    Id (Id K1 x x) (fx x (trans K1 k0 k0 k0 p q)) (trans K1 x x x (fx x p) (fx x q)) =
    band-inj x (fx x (trans K1 k0 k0 k0 p q)) (trans K1 x x x (fx x p) (fx x q)) (calc A {
      band x (fx x (trans K1 k0 k0 k0 p q))
        =< band-unband x (band k0 (trans K1 k0 k0 k0 p q)) > band k0 (trans K1 k0 k0 k0 p q)
        =< band-hom k0 p q > add (band k0 p) (band k0 q)
        =< symH (apH (\ c -> add c (band k0 q)) (band-unband x (band k0 p))) > add (band x (fx x p)) (band k0 q)
        =< symH (apH (add (band x (fx x p))) (band-unband x (band k0 q))) > add (band x (fx x p)) (band x (fx x q))
        =< symH (band-hom x (fx x p) (fx x q)) > band x (trans K1 x x x (fx x p) (fx x q)) }) ;
  fx-equiv (x : K1) : isEquiv (Id K1 k0 k0) (Id K1 x x) (fx x) =
    (E.compose (Id K1 k0 k0) A (Id K1 x x) (band-equiv k0) (unband x, W.inv-equiv (Id K1 x x) A (band x) (band-equiv x).2)).2 ;
  fpt (x : K1) : Maps[K1, k0, K1, x].PMO = (fx x, fx-pt x) ;

  -- Corollary 12 deloops f_x; Whitehead makes it an equivalence
  cell (x : K1) : isContr (Maps[K1, k0, K1, x].Over[fpt x].Unloop) =
    Maps[K1, k0, K1, x].Over[fpt x].Mult[conn1, trunc1, fx-mult x].cor12 ;
  mu-map (x : K1) : PtMap K1 k0 K1 x = (cell x).1.1 ;
  mu-loop (x : K1) : Id (Maps[K1, k0, K1, x].PMO) (fpt x) (Maps[K1, k0, K1, x].loop (mu-map x)) = (cell x).1.2 ;
  mu-loop-equiv (x : K1) : isEquiv (Id K1 k0 k0) (Id K1 x x) (Maps[K1, k0, K1, x].loop (mu-map x)).1 =
    E.homotopy (Id K1 k0 k0) (Id K1 x x) (fx x, fx-equiv x) (Maps[K1, k0, K1, x].loop (mu-map x)).1
      (\ q -> sym (Id K1 x x) (fx x q) ((Maps[K1, k0, K1, x].loop (mu-map x)).1 q)
         (happly (Id K1 k0 k0) (\ q1 -> Id K1 x x) (fx x) (Maps[K1, k0, K1, x].loop (mu-map x)).1
            (ap (Maps[K1, k0, K1, x].PMO) (Id K1 k0 k0 -> Id K1 x x) (\ g -> g.1) (fpt x) (Maps[K1, k0, K1, x].loop (mu-map x))
               (mu-loop x)) q)) ;
  mu (x : K1) : PtEquiv K1 k0 K1 x =
    (mu-map x, W.Pointed[K1, k0, K1, x, mu-map x, conn1, mu-loop-equiv x].equiv conn1) ;
} ;

------------------------------------------------------------------------
-- K(A, 2)

module EM2 (Gr : Ab) {
  open EM1[Gr] ;
  module T = TD.Torsors[K1, k0] ;
  pc : isContr T.PT = T.cor8 zero conn1 trunc1 (Tr.Trunc[T.Tor].inc (T.homog mu)) ;
  module D = T.Deloop[pc] ;
  K2 : U l = T.Tor ;
  k2 : K2 = D.ptT ;
  conn2 : isConn (suc (suc (suc zero))) K2 = D.tor-conn (suc zero) conn1 ;
  trunc2 : isTrunc (suc (suc (suc (suc zero)))) K2 = D.tor-trunc (suc (suc (suc zero))) trunc1 ;
  loops2 : PtEquiv (Id K2 k2 k2) (refl k2) K1 k0 = D.theorem2 ;
} ;

------------------------------------------------------------------------
-- K(A, n+2), n >= 0

record Stage (n : Nat) {
  X : U l ;
  pt : X ;
  conn : isConn (suc (suc (suc n))) X ;
  trunc : isTrunc (suc (suc (suc (suc n)))) X ;
} ;

module Step (n : Nat) (S : Stage[n]) {
  module T = TD.Torsors[S.X, S.pt] ;
  tX : isTrunc (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) S.X =
    trunc-index S.X (N.plus n (suc (suc (suc (suc n))))) (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) (idx n)
      (trunc-lift (suc (suc (suc (suc n)))) S.X S.trunc n) ;
  pc : isContr T.PT = T.cor7 (suc n) S.conn tX ;
  module D = T.Deloop[pc] ;
  next : Stage[suc n] = new Stage[suc n, T.Tor, D.ptT, D.tor-conn (suc (suc n)) S.conn,
    D.tor-trunc (suc (suc (suc (suc n)))) S.trunc] ;
  loops : PtEquiv (Id T.Tor D.ptT D.ptT) (refl D.ptT) S.X S.pt = D.theorem2 ;
} ;

module EMn (Gr : Ab) {
  open EM1[Gr] ;
  open EM2[Gr] ;
  stage2 : Stage[zero] = new Stage[zero, K2, k2, conn2, trunc2] ;
  -- (Kstage n).X = K(A, n+2)
  Kstage : (n : Nat) -> Stage[n] = split {
    zero -> stage2 ;
    suc n | r -> Step[n, r].next } ;
  -- Omega K(A, n+3) ~pt K(A, n+2)
  loops (n : Nat) : PtEquiv (Id (Kstage (suc n)).X (Kstage (suc n)).pt (Kstage (suc n)).pt)
      (refl (Kstage (suc n)).pt) (Kstage n).X (Kstage n).pt =
    Step[n, Kstage n].loops ;
} ;

------------------------------------------------------------------------
-- The interface: K n = K(A, n+1) for all n : Nat, pointed, n-connected,
-- (n+1)-truncated, with Omega K(A, n+2) ~pt K(A, n+1) and
-- Omega K(A, 1) ~ A (the band at the base point, a group isomorphism);
-- identity types of K(A, n+2) are merely K(A, n+1), those of K(A, 1)
-- merely A (each identity type is merely a loop space, by connectedness).

module EMSpace (Gr : Ab) {
  open Gr ;
  module E1 = EM1[Gr] ;
  module E2 = EM2[Gr] ;
  module En = EMn[Gr] ;
  K : Nat -> U l = split { zero -> E1.K1 ; suc n -> (En.Kstage n).X } ;
  pt : (n : Nat) -> K n = split { zero -> E1.k0 ; suc n -> (En.Kstage n).pt } ;
  conn : (n : Nat) -> isConn (suc (suc n)) (K n) = split { zero -> E1.conn1 ; suc n -> (En.Kstage n).conn } ;
  trunc : (n : Nat) -> isTrunc (suc (suc (suc n))) (K n) = split { zero -> E1.trunc1 ; suc n -> (En.Kstage n).trunc } ;
  loops : (n : Nat) -> PtEquiv (Id (K (suc n)) (pt (suc n)) (pt (suc n))) (refl (pt (suc n))) (K n) (pt n) = split {
    zero -> E2.loops2 ; suc n -> En.loops n } ;
  loop0 : Equiv (Id (K zero) (pt zero) (pt zero)) A = E1.band-equiv E1.k0 ;
  loop0-hom (p q : Id (K zero) (pt zero) (pt zero)) :
    Id A (loop0.1 (trans (K zero) (pt zero) (pt zero) (pt zero) p q)) (add (loop0.1 p) (loop0.1 q)) =
    E1.band-hom E1.k0 p q ;

  -- identity types are merely loop spaces
  paths-loops (X : U l) (x0 : X) (c : isConn (suc (suc zero)) X) (Y : U l) (e : Equiv (Id X x0 x0) Y) (x y : X) :
    Tr.Trunc[Equiv (Id X x y) Y].carrier =
    conn-elim2 zero X x0 c (\ x1 y1 -> Tr.Trunc[Equiv (Id X x1 y1) Y].carrier)
      (\ x1 y1 -> Tr.Trunc[Equiv (Id X x1 y1) Y].proposition) (Tr.Trunc[Equiv (Id X x0 x0) Y].inc e) x y ;
  paths (n : Nat) (x y : K (suc n)) : Tr.Trunc[Equiv (Id (K (suc n)) x y) (K n)].carrier =
    paths-loops (K (suc n)) (pt (suc n)) (conn-zero (suc n) (K (suc n)) (conn (suc n)))
      (K n) (PtEquivOps[l].Acc[Id (K (suc n)) (pt (suc n)) (pt (suc n)), refl (pt (suc n)), K n, pt n, loops n].equiv) x y ;
  paths0 (x y : K zero) : Tr.Trunc[Equiv (Id (K zero) x y) A].carrier =
    paths-loops (K zero) (pt zero) (conn zero) A loop0 x y ;
} ;
