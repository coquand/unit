-- The quotient of a type by a congruence, as a group (by replacement:
-- Quotient).  A carries e, mul, inv satisfying the group laws up to Id;
-- rel is an equivalence relation respected by mul and inv.  The quotient
-- A / rel is a group with [a] [b] = [a b], [a]^-1 = [a^-1] (by definition
-- on representatives: cls-mul, cls-inv), and the laws hold on
-- representatives.  Instances: π₁ (rel = merely equal loops, PiOne) and
-- the Čech groups (rel = differ by a coboundary).
--
-- A map of such data (f : A -> A' with rel a b -> rel' (f a) (f b) and
-- f (a b) = f a f b) induces a homomorphism of the quotients (Map).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module QGrp (A : U l) (rel : A -> A -> U l) (prop : (a b : A) -> isProp (rel a b))
  (rr : (a : A) -> rel a a) (rs : (a b : A) -> rel a b -> rel b a) (rt : (a b c : A) -> rel a b -> rel b c -> rel a c)
  (e : A) (mul : A -> A -> A) (inv : A -> A)
  (mul-resp : (a a' b b' : A) -> rel a a' -> rel b b' -> rel (mul a b) (mul a' b'))
  (inv-resp : (a a' : A) -> rel a a' -> rel (inv a) (inv a'))
  (assoc : (x y z : A) -> Id A (mul (mul x y) z) (mul x (mul y z)))
  (unitl : (x : A) -> Id A (mul e x) x) (unitr : (x : A) -> Id A (mul x e) x)
  (invl : (x : A) -> Id A (mul (inv x) x) e) (invr : (x : A) -> Id A (mul x (inv x)) e) {
  module Q = Quotient[l].Quot[A, rel, prop, rr, rs, rt] ;
  G : U l = Q.Q ;
  cls (a : A) : G = Q.inc a ;
  -- equal representatives give equal classes
  cls-eq (a b : A) (p : Id A a b) : Id G (cls a) (cls b) = apH cls p ;

  -- multiplication, one argument at a time
  module R (a : A) { module D = Q.Descend[G, Q.set, \ b -> cls (mul a b), \ b b' r -> Q.relates (mul a b) (mul a b') (mul-resp a a b b' (rr a) r)] ; } ;
  mulR (a : A) (q : G) : G = R[a].D.map q ;
  mulR-resp (a a' : A) (r : rel a a') : Id (G -> G) (mulR a) (mulR a') =
    FL.funext G (\ q -> G) (mulR a) (mulR a') (\ q ->
      Q.induction @l (\ q1 -> Id G (mulR a q1) (mulR a' q1)) (\ q1 -> Q.set (mulR a q1) (mulR a' q1))
        (\ b -> transH (R[a].D.beta b) (transH (Q.relates (mul a b) (mul a' b) (mul-resp a a' b b r (rr b))) (symH (R[a'].D.beta b)))) q) ;
  module M = Q.Descend[G -> G, FL.isSet-Pi G (\ q -> G) (\ q -> Q.set), mulR, mulR-resp] ;
  mulQ (q r : G) : G = M.map q r ;
  cls-mul (a b : A) : Id G (mulQ (cls a) (cls b)) (cls (mul a b)) =
    transH (happly G (\ q -> G) (M.map (cls a)) (mulR a) (M.beta a) (cls b)) (R[a].D.beta b) ;
  module I = Q.Descend[G, Q.set, \ a -> cls (inv a), \ a a' r -> Q.relates (inv a) (inv a') (inv-resp a a' r)] ;
  invQ (q : G) : G = I.map q ;
  cls-inv (a : A) : Id G (invQ (cls a)) (cls (inv a)) = I.beta a ;

  -- the laws, on representatives
  assocQ (x y z : G) : Id G (mulQ (mulQ x y) z) (mulQ x (mulQ y z)) =
    Q.induction @l (\ x1 -> Id G (mulQ (mulQ x1 y) z) (mulQ x1 (mulQ y z))) (\ x1 -> Q.set (mulQ (mulQ x1 y) z) (mulQ x1 (mulQ y z))) (\ a ->
    Q.induction @l (\ y1 -> Id G (mulQ (mulQ (cls a) y1) z) (mulQ (cls a) (mulQ y1 z))) (\ y1 -> Q.set (mulQ (mulQ (cls a) y1) z) (mulQ (cls a) (mulQ y1 z))) (\ b ->
    Q.induction @l (\ z1 -> Id G (mulQ (mulQ (cls a) (cls b)) z1) (mulQ (cls a) (mulQ (cls b) z1))) (\ z1 -> Q.set (mulQ (mulQ (cls a) (cls b)) z1) (mulQ (cls a) (mulQ (cls b) z1))) (\ c -> calc G {
      mulQ (mulQ (cls a) (cls b)) (cls c) =< apH (\ q -> mulQ q (cls c)) (cls-mul a b) > mulQ (cls (mul a b)) (cls c)
        =< cls-mul (mul a b) c > cls (mul (mul a b) c)
        =< cls-eq (mul (mul a b) c) (mul a (mul b c)) (assoc a b c) > cls (mul a (mul b c))
        =< symH (cls-mul a (mul b c)) > mulQ (cls a) (cls (mul b c))
        =< symH (apH (mulQ (cls a)) (cls-mul b c)) > mulQ (cls a) (mulQ (cls b) (cls c)) }) z) y) x ;
  unitlQ (x : G) : Id G (mulQ (cls e) x) x =
    Q.induction @l (\ x1 -> Id G (mulQ (cls e) x1) x1) (\ x1 -> Q.set (mulQ (cls e) x1) x1)
      (\ a -> transH (cls-mul e a) (cls-eq (mul e a) a (unitl a))) x ;
  unitrQ (x : G) : Id G (mulQ x (cls e)) x =
    Q.induction @l (\ x1 -> Id G (mulQ x1 (cls e)) x1) (\ x1 -> Q.set (mulQ x1 (cls e)) x1)
      (\ a -> transH (cls-mul a e) (cls-eq (mul a e) a (unitr a))) x ;
  invlQ (x : G) : Id G (mulQ (invQ x) x) (cls e) =
    Q.induction @l (\ x1 -> Id G (mulQ (invQ x1) x1) (cls e)) (\ x1 -> Q.set (mulQ (invQ x1) x1) (cls e))
      (\ a -> transH (apH (\ q -> mulQ q (cls a)) (cls-inv a)) (transH (cls-mul (inv a) a) (cls-eq (mul (inv a) a) e (invl a)))) x ;
  invrQ (x : G) : Id G (mulQ x (invQ x)) (cls e) =
    Q.induction @l (\ x1 -> Id G (mulQ x1 (invQ x1)) (cls e)) (\ x1 -> Q.set (mulQ x1 (invQ x1)) (cls e))
      (\ a -> transH (apH (mulQ (cls a)) (cls-inv a)) (transH (cls-mul a (inv a)) (cls-eq (mul a (inv a)) e (invr a)))) x ;
  grp : Grp = new Grp[G, Q.set, cls e, mulQ, invQ, assocQ, unitlQ, unitrQ, invlQ, invrQ] ;
} ;

-- a homomorphism of groups
GHom (H K : Grp) : U l = (f : H.G -> K.G) * ((x y : H.G) -> Id K.G (f (H.mul x y)) (K.mul (f x) (f y))) ;

-- a map of the data induces a homomorphism of the quotients
module Map (A : U l) (rel : A -> A -> U l) (prop : (a b : A) -> isProp (rel a b))
  (rr : (a : A) -> rel a a) (rs : (a b : A) -> rel a b -> rel b a) (rt : (a b c : A) -> rel a b -> rel b c -> rel a c)
  (A' : U l) (rel' : A' -> A' -> U l) (prop' : (a b : A') -> isProp (rel' a b))
  (rr' : (a : A') -> rel' a a) (rs' : (a b : A') -> rel' a b -> rel' b a) (rt' : (a b c : A') -> rel' a b -> rel' b c -> rel' a c)
  (f : A -> A') (resp : (a b : A) -> rel a b -> rel' (f a) (f b)) {
  module Q = Quotient[l].Quot[A, rel, prop, rr, rs, rt] ;
  module Q' = Quotient[l].Quot[A', rel', prop', rr', rs', rt'] ;
  module D = Q.Descend[Q'.Q, Q'.set, \ a -> Q'.inc (f a), \ a b r -> Q'.relates (f a) (f b) (resp a b r)] ;
  map (q : Q.Q) : Q'.Q = D.map q ;
  map-cls (a : A) : Id Q'.Q (map (Q.inc a)) (Q'.inc (f a)) = D.beta a ;
} ;

-- homomorphisms preserve the unit and inverses, and kernels are normal
module GHomL (H K : Grp) (f : GHom H K) {
  module LK = GrpL[K] ;
  -- f e = f e f e, cancel
  hom-e : Id K.G (f.1 H.e) K.e = calc K.G {
    f.1 H.e =< symH (LK.cancl (f.1 H.e) (f.1 H.e)) > K.mul (K.inv (f.1 H.e)) (K.mul (f.1 H.e) (f.1 H.e))
      =< apH (K.mul (K.inv (f.1 H.e))) (symH (transH (apH f.1 (symH (H.unitl H.e))) (f.2 H.e H.e))) > K.mul (K.inv (f.1 H.e)) (f.1 H.e)
      =< K.invl (f.1 H.e) > K.e } ;
  -- f (x^-1) f x = e
  hom-inv (x : H.G) : Id K.G (f.1 (H.inv x)) (K.inv (f.1 x)) = calc K.G {
    f.1 (H.inv x) =< symH (K.unitr (f.1 (H.inv x))) > K.mul (f.1 (H.inv x)) K.e
      =< apH (K.mul (f.1 (H.inv x))) (symH (K.invr (f.1 x))) > K.mul (f.1 (H.inv x)) (K.mul (f.1 x) (K.inv (f.1 x)))
      =< symH (K.assoc (f.1 (H.inv x)) (f.1 x) (K.inv (f.1 x))) > K.mul (K.mul (f.1 (H.inv x)) (f.1 x)) (K.inv (f.1 x))
      =< apH (\ z -> K.mul z (K.inv (f.1 x))) (transH (symH (f.2 (H.inv x) x)) (transH (apH f.1 (H.invl x)) hom-e)) > K.mul K.e (K.inv (f.1 x))
      =< K.unitl (K.inv (f.1 x)) > K.inv (f.1 x) } ;
  -- f (a^-1 x a) = e when f x = e
  conj-ker (a x : H.G) (h : Id K.G (f.1 x) K.e) : Id K.G (f.1 (H.mul (H.inv a) (H.mul x a))) K.e = calc K.G {
    f.1 (H.mul (H.inv a) (H.mul x a)) =< f.2 (H.inv a) (H.mul x a) > K.mul (f.1 (H.inv a)) (f.1 (H.mul x a))
      =< apH (K.mul (f.1 (H.inv a))) (transH (f.2 x a) (transH (apH (\ z -> K.mul z (f.1 a)) h) (K.unitl (f.1 a)))) > K.mul (f.1 (H.inv a)) (f.1 a)
      =< apH (\ z -> K.mul z (f.1 a)) (hom-inv a) > K.mul (K.inv (f.1 a)) (f.1 a)
      =< K.invl (f.1 a) > K.e } ;
} ;
