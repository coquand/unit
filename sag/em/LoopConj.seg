-- Conjugating loops by paths, and the loopings of homotopic maps.
--   conj p u = p^-1 . u . p    (p : x = y, u : x = x; a loop at y)
--   loop F q = conj F0 (ap F q)            (DeloopMaps.loop-ap)
--   conj (p . q) = conj q o conj p,  conj p (u . v) = conj p u . conj p v,
--   conj p refl = refl,  conj p^-1 (conj p u) = u      (J on p, resp. q)
--   naturality: for H : J ~ K, ap K q = conj (H a) (ap J q) on a loop q
--   loop-homotopy: for pointed J, K and an unpointed H : J ~ K,
--     loop K q = conj c (loop J q),  c = J0^-1 . H a0 . K0.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ;
module Gp = Groupoid[l] ;

conj (X : U l) (x y : X) (p : Id X x y) (u : Id X x x) : Id X y y = trans X y x y (sym X x y p) (trans X x x y u p) ;

conj-refl-loop (X : U l) (x : X) (u : Id X x x) : Id (Id X x x) (conj X x x (refl x) u) u = trans-refl-l X x x u ;
conj-trans (X : U l) (x y : X) (p : Id X x y) (u : Id X x x) : (z : X) (q : Id X y z) ->
  Id (Id X z z) (conj X x z (trans X x y z p q) u) (conj X y z q (conj X x y p u)) =
  \ z q -> idJ X y (\ z1 q1 -> Id (Id X z1 z1) (conj X x z1 (trans X x y z1 p q1) u) (conj X y z1 q1 (conj X x y p u)))
    (symH (conj-refl-loop X y (conj X x y p u))) z q ;
conj-mult (X : U l) (x y : X) (p : Id X x y) (u v : Id X x x) :
  Id (Id X y y) (conj X x y p (trans X x x x u v)) (trans X y y y (conj X x y p u) (conj X x y p v)) =
  idJ X x (\ y1 p1 -> Id (Id X y1 y1) (conj X x y1 p1 (trans X x x x u v)) (trans X y1 y1 y1 (conj X x y1 p1 u) (conj X x y1 p1 v)))
    (transH (trans-refl-l X x x (trans X x x x u v))
      (symH (transH (apH (\ a -> trans X x x x a (conj X x x (refl x) v)) (trans-refl-l X x x u))
                    (apH (trans X x x x u) (trans-refl-l X x x v))))) y p ;
conj-refl (X : U l) (x y : X) (p : Id X x y) : Id (Id X y y) (conj X x y p (refl x)) (refl y) =
  transH (apH (trans X y x y (sym X x y p)) (trans-refl-l X x y p)) (trans-sym-l X x y p) ;
conj-back (X : U l) (x y : X) (p : Id X x y) (u : Id X x x) : Id (Id X x x) (conj X y x (sym X x y p) (conj X x y p u)) u =
  idJ X x (\ y1 p1 -> Id (Id X x x) (conj X y1 x (sym X x y1 p1) (conj X x y1 p1 u)) u)
    (transH (trans-refl-l X x x (conj X x x (refl x) u)) (trans-refl-l X x x u)) y p ;
-- inverting conj p
conj-sym-back (X : U l) (x y : X) (p : Id X x y) (v : Id X y y) : Id (Id X y y) (conj X x y p (conj X y x (sym X x y p) v)) v =
  transH (apH (\ r -> conj X x y r (conj X y x (sym X x y p) v)) (symH (Gp.sym-sym X x y p)))
    (conj-back X y x (sym X x y p) v) ;

-- ap along a homotopy
ap-homotopy (A B : U l) (J K : A -> B) (H : (a : A) -> Id B (J a) (K a)) (a : A) : (a' : A) (q : Id A a a') ->
  Id (Id B (K a) (K a')) (ap A B K a a' q) (trans B (K a) (J a) (K a') (sym B (J a) (K a) (H a)) (trans B (J a) (J a') (K a') (ap A B J a a' q) (H a'))) =
  \ a' q -> idJ A a (\ a1 q1 -> Id (Id B (K a) (K a1)) (ap A B K a a1 q1)
      (trans B (K a) (J a) (K a1) (sym B (J a) (K a) (H a)) (trans B (J a) (J a1) (K a1) (ap A B J a a1 q1) (H a1))))
    (symH (transH (apH (trans B (K a) (J a) (K a) (sym B (J a) (K a) (H a))) (trans-refl-l B (J a) (K a) (H a)))
                  (trans-sym-l B (J a) (K a) (H a)))) a' q ;

module LoopHomotopy (A : U l) (a0 : A) (B : U l) (b0 : B) (J K : PtMap A a0 B b0) (H : (a : A) -> Id B (J.1 a) (K.1 a)) {
  module M = Maps[A, a0, B, b0] ;
  c : Id B b0 b0 = trans B b0 (J.1 a0) b0 (sym B (J.1 a0) b0 J.2) (trans B (J.1 a0) (K.1 a0) b0 (H a0) K.2) ;
  -- ap J q = conj J0^-1 (loop J q)
  ap-J (q : Id A a0 a0) : Id (Id B (J.1 a0) (J.1 a0)) (ap A B J.1 a0 a0 q) (conj B b0 (J.1 a0) (sym B (J.1 a0) b0 J.2) ((M.loop J).1 q)) =
    symH (transH (apH (conj B b0 (J.1 a0) (sym B (J.1 a0) b0 J.2)) (M.loop-ap J q))
                 (conj-back B (J.1 a0) b0 J.2 (ap A B J.1 a0 a0 q))) ;
  loop-homotopy (q : Id A a0 a0) : Id (Id B b0 b0) ((M.loop K).1 q) (conj B b0 b0 c ((M.loop J).1 q)) = calc (Id B b0 b0) {
    (M.loop K).1 q =< M.loop-ap K q > conj B (K.1 a0) b0 K.2 (ap A B K.1 a0 a0 q)
      =< apH (conj B (K.1 a0) b0 K.2) (ap-homotopy A B J.1 K.1 H a0 a0 q) >
    conj B (K.1 a0) b0 K.2 (conj B (J.1 a0) (K.1 a0) (H a0) (ap A B J.1 a0 a0 q))
      =< apH (\ u -> conj B (K.1 a0) b0 K.2 (conj B (J.1 a0) (K.1 a0) (H a0) u)) (ap-J q) >
    conj B (K.1 a0) b0 K.2 (conj B (J.1 a0) (K.1 a0) (H a0) (conj B b0 (J.1 a0) (sym B (J.1 a0) b0 J.2) ((M.loop J).1 q)))
      =< symH (apH (conj B (K.1 a0) b0 K.2) (conj-trans B b0 (J.1 a0) (sym B (J.1 a0) b0 J.2) ((M.loop J).1 q) (K.1 a0) (H a0))) >
    conj B (K.1 a0) b0 K.2 (conj B b0 (K.1 a0) (trans B b0 (J.1 a0) (K.1 a0) (sym B (J.1 a0) b0 J.2) (H a0)) ((M.loop J).1 q))
      =< symH (conj-trans B b0 (K.1 a0) (trans B b0 (J.1 a0) (K.1 a0) (sym B (J.1 a0) b0 J.2) (H a0)) ((M.loop J).1 q) b0 K.2) >
    conj B b0 b0 (trans B b0 (K.1 a0) b0 (trans B b0 (J.1 a0) (K.1 a0) (sym B (J.1 a0) b0 J.2) (H a0)) K.2) ((M.loop J).1 q)
      =< apH (\ r -> conj B b0 b0 r ((M.loop J).1 q)) (Gp.tassoc B b0 (J.1 a0) (K.1 a0) (sym B (J.1 a0) b0 J.2) (H a0) b0 K.2) >
    conj B b0 b0 c ((M.loop J).1 q) } ;
} ;
