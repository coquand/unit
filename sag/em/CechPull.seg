-- Pulling non-abelian Čech classes back along a map of covers, and its
-- injectivity (used for CCA Lemma 3.1.5).
--
-- For f x : Y' x -> Y x over X (both merely inhabited) a cocycle d on Y
-- gives the cocycle d o (f x f) on Y', and cohomologous cocycles give
-- cohomologous ones (iota o f): a map Ȟ¹(X, Y, G) -> Ȟ¹(X, Y', G).
-- It is injective: both are subsets of H¹(X, G) (Cor. A.0.7, Ψ), and Ψ
-- commutes with the pullback, psi (f^* d) = psi d, by the equivariant map
-- gamma |-> gamma o f.  So if f^* d ~ f^* d', then
--   psi d = psi (f^* d) = psi (f^* d') = psi d'  (merely),
-- and d ~ d' (CorA07.reflect, Lemma A.0.5).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ; open GTorsor[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module P1 = Prelude[l+] ; module Pa1 = Paths[l+] ;
module B1 = Bijection[l+] ;

-- psi d = psi (f^* d), for one x
module PsiPull (Y Y' : U l) (hY : Tr.Trunc[Y].carrier) (hY' : Tr.Trunc[Y'].carrier) (Gr : Grp) (f : Y' -> Y)
  (d : Y -> Y -> Gr.G) (c : (y0 y1 y2 : Y) -> Id Gr.G (Gr.mul (d y1 y2) (d y0 y1)) (d y0 y2)) {
  open Gr ;
  module S = Psi[Y, hY, Gr, d, c] ;
  module S' = Psi[Y', hY', Gr, \ y0 y1 -> d (f y0) (f y1), \ y0 y1 y2 -> c (f y0) (f y1) (f y2)] ;
  map (u : S.P) : S'.P = (\ y -> u.1 (f y), \ y0 y1 -> u.2 (f y0) (f y1)) ;
  hom : GTor[Gr].Hom S.tor S'.tor = (map, \ a u -> S'.P-eq (map (S.act a u)) (S'.act a (map u)) (\ y -> refl (mul a (u.1 (f y))))) ;
  path : Id (GTor[Gr].Tor) S.tor S'.tor = GTor[Gr].decode S.tor S'.tor hom ;
} ;

module Pull (X : U l) (Y Y' : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (hY' : (x : X) -> Tr.Trunc[Y' x].carrier)
  (G : X -> Grp) (f : (x : X) -> Y' x -> Y x) {
  module A = CorA07[l].CorA07[X, Y, hY, G] ;
  module A' = CorA07[l].CorA07[X, Y', hY', G] ;
  cyc (u : A.Cyc) : A'.Cyc =
    (\ x y0 y1 -> u.1 x (f x y0) (f x y1), \ x y0 y1 y2 -> u.2 x (f x y0) (f x y1) (f x y2)) ;
  coh (u v : A.Cyc) (h : A.Coh u v) : A'.Coh (cyc u) (cyc v) =
    TC.map ((i : A.C.C0) * ((x : X) -> CorA07[l].Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x)))
      ((i : A'.C.C0) * ((x : X) -> CorA07[l].Conj[G x, Y' x].Rel ((cyc u).1 x) ((cyc v).1 x) (i x)))
      (\ w -> (\ x y -> w.1 x (f x y), \ x y0 y1 -> w.2 x (f x y0) (f x y1))) h ;
  module M = A.QC.Descend[A'.Cech, A'.QC.set, \ u -> A'.QC.inc (cyc u), \ u v h -> A'.QC.relates (cyc u) (cyc v) (coh u v h)] ;
  -- the pullback of classes
  map (q : A.Cech) : A'.Cech = M.map q ;
  map-inc (u : A.Cyc) : Id A'.Cech (map (A.QC.inc u)) (A'.QC.inc (cyc u)) = M.beta u ;

  -- Ψ commutes with the pullback
  psi-pull (u : A.Cyc) : Id A.Fam (A.psi u) (A'.psi (cyc u)) =
    FL1.funext X (\ x -> GTor[G x].Tor) (A.psi u) (A'.psi (cyc u))
      (\ x -> PsiPull[Y x, Y' x, hY x, hY' x, G x, f x, u.1 x, u.2 x].path) ;
  reflect (u v : A.Cyc) (h : A'.Coh (cyc u) (cyc v)) : A.Coh u v =
    A.reflect u v (TC1.map (Id A.Fam (A'.psi (cyc u)) (A'.psi (cyc v))) (Id A.Fam (A.psi u) (A.psi v))
      (\ p -> Pa1.transH (psi-pull u) (Pa1.transH p (Pa1.symH (psi-pull v)))) (A'.respect (cyc u) (cyc v) h)) ;
  injective : B1.Injective map = \ q r ->
    A.QC.induction @(l+) (\ q -> Id A'.Cech (map q) (map r) -> Id A.Cech q r)
      (\ q -> FL1.isProp-Pi (Id A'.Cech (map q) (map r)) (\ p -> Id A.Cech q r) (\ p -> A.QC.set q r))
      (\ u -> A.QC.induction @(l+) (\ r -> Id A'.Cech (map (A.QC.inc u)) (map r) -> Id A.Cech (A.QC.inc u) r)
        (\ r -> FL1.isProp-Pi (Id A'.Cech (map (A.QC.inc u)) (map r)) (\ p -> Id A.Cech (A.QC.inc u) r) (\ p -> A.QC.set (A.QC.inc u) r))
        (\ v p -> A.QC.relates u v (reflect u v (A'.QC.effective (cyc u) (cyc v)
           (Pa1.transH (Pa1.symH (map-inc u)) (Pa1.transH p (map-inc v)))))) r) q ;
} ;
