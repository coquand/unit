-- The fibre sequence of a short exact sequence 0 -> A -i-> B -p-> C -> 0 of
-- abelian groups: for every m (K(A, 0) = A),
--     K(A, m) ~ Fib (K p m),   z |-> (K i m z, h z),
-- where h : K p m o K i m = const (null).  So K(A, m) -> K(B, m) ->
-- K(C, m) is a fibre sequence, with K i m the fibre inclusion.
--
--  null: m = 0 is exactness (p o i = 0).  For m+1, by unique-loop1 it
--    suffices that loop (K i ; K p) = loop const:
--    loop (K i ; K p) = (e_A ; K i m ; e_B^-1) ; (e_B ; K p m ; e_C^-1)
--                     = e_A ; (K i m ; K p m) ; e_C^-1 = e_A ; const ; e_C^-1 = const.
--  equivalence: by induction on m, for EVERY pointed M : K(A, m) ->
--    Fib (K p m) with fpr o M = K i m.  m = 0: M is injective (i is) and
--    onto (exactness), a map of sets.  m+1: Fib (K p (m+1)) is 0-connected
--    (Fibres.FibConn: loop (K p (m+1)) is onto), so by Whitehead it is
--    enough that loop M is an equivalence.  Moving loop M along e_A,
--    Omega Fib ~ Fib (loop K p) (omega-fib) and Fib (loop K p) ~ Fib (K p m)
--    (fib-equiv, the square of loopK) gives M'' : K(A, m) -> Fib (K p m)
--    with fpr o M'' = K i m (the compatibilities of omega-fib, fib-equiv,
--    loop-comp, loopK); by induction M'' is an equivalence, so loop M is.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ;
open Torsor[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module N = NatArith[l] ;
module W = Whitehead[l] ;
module Eq = Equivalences[l] ;
module Bj = Bijection[l] ;

-- m+3 <= 2m+3
idx1 (m : Nat) : Id Nat (N.plus m (suc (suc (suc m)))) (N.plus (suc m) (N.plus (suc m) (suc zero))) =
  transH (N.plus-suc m (suc (suc m)))
    (ap Nat Nat (\ k -> suc (N.plus m (suc k))) (suc m) (N.plus m (suc zero))
       (sym Nat (N.plus m (suc zero)) (suc m) (transH (N.plus-suc m zero) (ap Nat Nat (\ k -> suc k) (N.plus m zero) m (N.plus-zero m))))) ;

-- 2-out-of-3 on the right: if g o h and h are equivalences, so is g
cancel-equiv-r (X Y Z : U l) (h : X -> Y) (g : Y -> Z) (eh : isEquiv X Y h) (egh : isEquiv X Z (\ x -> g (h x))) : isEquiv Y Z g =
  Eq.homotopy Y Z (Eq.compose Y X Z (eh.sec, W.inv-equiv X Y h eh) ((\ x -> g (h x)), egh)) g
    (\ y -> apH g (symH (eh.sec-eq y))) ;

-- if loop f is onto, so is ap f at the point (conjugation is an equivalence)
loop-surj-ap (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0)
  (s : (v : Id Y y0 y0) -> Tr.Trunc[Bj.Fibre (Maps[X, x0, Y, y0].loop f).1 v].carrier)
  (u : Id Y (f.1 x0) (f.1 x0)) : Tr.Trunc[(q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u].carrier =
  TC.map (Bj.Fibre (Maps[X, x0, Y, y0].loop f).1 (W.conj Y (f.1 x0) y0 f.2 u))
    ((q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u)
    (\ w -> (w.1, Eq.injective (Id Y (f.1 x0) (f.1 x0)) (Id Y y0 y0) (W.conj Y (f.1 x0) y0 f.2) (W.conj-equiv Y (f.1 x0) y0 f.2)
                    (ap X Y f.1 x0 x0 w.1) u (transH (symH (Maps[X, x0, Y, y0].loop-ap f w.1)) w.2)))
    (s (W.conj Y (f.1 x0) y0 f.2 u)) ;

module SES (Ga Gb Gc : Ab) (i : Hom Ga Gb) (p : Hom Gb Gc) (inj : Bj.Injective i.1)
  (pi0 : (a : Ga.A) -> Id Gc.A (p.1 (i.1 a)) Gc.o)
  (ex : (b : Gb.A) -> Id Gc.A (p.1 b) Gc.o -> Tr.Trunc[Bj.Fibre i.1 b].carrier)
  (sur : (c : Gc.A) -> Tr.Trunc[Bj.Fibre p.1 c].carrier) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  module C = KK[Gc] ;
  module Ki = KMap[Ga, Gb, i] ;
  module Kp = KMap[Gb, Gc, p] ;
  FibK (m : Nat) : U l = Fib (B.K m) (B.pt m) (C.K m) (C.pt m) (Kp.K m) ;
  fptK (m : Nat) : FibK m = fpt (B.K m) (B.pt m) (C.K m) (C.pt m) (Kp.K m) ;
  fprK (m : Nat) : PtMap (FibK m) (fptK m) (B.K m) (B.pt m) = fpr (B.K m) (B.pt m) (C.K m) (C.pt m) (Kp.K m) ;
  Null (m : Nat) : U l = Id (PtMap (A.K m) (A.pt m) (C.K m) (C.pt m))
    (ptcomp (A.K m) (A.pt m) (B.K m) (B.pt m) (C.K m) (C.pt m) (Ki.K m) (Kp.K m)) (ptconst (A.K m) (A.pt m) (C.K m) (C.pt m)) ;
  tC (m : Nat) : isTrunc (N.plus (suc m) (N.plus (suc m) (suc zero))) (C.K (suc m)) =
    trunc-index (C.K (suc m)) (N.plus m (suc (suc (suc m)))) (N.plus (suc m) (N.plus (suc m) (suc zero))) (idx1 m)
      (trunc-lift (suc (suc (suc m))) (C.K (suc m)) (C.trunc m) m) ;

  -- the objects at levels m, m+1
  module Obj (m : Nat) {
    eA : PtMap ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) = (A.e m).1 ;
    eB : PtMap ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m) = (B.e m).1 ;
    eC : PtMap ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (C.K m) (C.pt m) = (C.e m).1 ;
    eAi : PtMap (A.K m) (A.pt m) ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) = (pt-inv ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (A.e m)).1 ;
    eBi : PtMap (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) = (pt-inv ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (B.e m)).1 ;
    eCi : PtMap (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) = (pt-inv ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (C.K m) (C.pt m) (C.e m)).1 ;
    Fi : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m) = Ki.K m ;
    Fp : PtMap (B.K m) (B.pt m) (C.K m) (C.pt m) = Kp.K m ;
    P : PtMap ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) = ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) eA Fi ;
    Q : PtMap ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) = ptcomp ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (C.K m) (C.pt m) eB Fp ;
  } ;

  -- K p o K i is null
  module NullStep (m : Nat) (r : Null m) {
    open Obj[m] ;
    s5 : Id (PtMap (B.K m) (B.pt m) (C.K m) (C.pt m)) (ptcomp (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) eBi Q) Fp =
      transH (symH (ptcomp-assoc (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (C.K m) (C.pt m) eBi eB Fp))
        (transH (apH (\ X -> ptcomp (B.K m) (B.pt m) (B.K m) (B.pt m) (C.K m) (C.pt m) X Fp) (pt-inv-r ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (B.e m))) (ptcomp-idl (B.K m) (B.pt m) (C.K m) (C.pt m) Fp)) ;
    s9 : Id (PtMap ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m)) (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (C.K m) (C.pt m) P Fp) (ptconst ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m)) =
      transH (ptcomp-assoc ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (C.K m) (C.pt m) eA Fi Fp)
        (transH (apH (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (C.K m) (C.pt m) eA) r) (comp-const-r ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (C.K m) (C.pt m) eA)) ;
    chain : Id (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].PMO)
        (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop
           (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m))))
        (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop (ptconst (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m)))) =
      calc (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].PMO) {
        Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop
          (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m)))
          =< loop-comp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m)) >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (Ki.K (suc m)))
          (Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (Kp.K (suc m)))
          =< transH (apH (\ X -> ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) X (Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (Kp.K (suc m)))) (Ki.loopK m))
                    (apH (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (Ki.conj m Fi)) (Kp.loopK m)) >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) P eBi) (ptcomp ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) Q eCi)
          =< ptcomp-assoc ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P eBi (ptcomp ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) Q eCi) >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P (ptcomp (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) eBi (ptcomp ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) Q eCi))
          =< apH (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P) (symH (ptcomp-assoc (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) eBi Q eCi)) >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P (ptcomp (B.K m) (B.pt m) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (ptcomp (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (C.K m) (C.pt m) eBi Q) eCi)
          =< apH (\ X -> ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P (ptcomp (B.K m) (B.pt m) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) X eCi)) s5 >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P (ptcomp (B.K m) (B.pt m) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) Fp eCi)
          =< symH (ptcomp-assoc ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) P Fp eCi) >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (C.K m) (C.pt m) P Fp) eCi
          =< apH (\ X -> ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) X eCi) s9 >
        ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) (ptconst ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m)) eCi
          =< comp-const-l ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (C.K m) (C.pt m) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m))) eCi >
        ptconst ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) ((Id (C.K (suc m)) (C.pt (suc m)) (C.pt (suc m)))) (refl (C.pt (suc m)))
          =< symH (loop-const (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m))) >
        Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop (ptconst (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m))) } ;
    next : Null (suc m) =
      unique-loop1 m (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (A.conn m) (tC m)
        (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m)))
        (ptconst (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m))) chain ;
  } ;
  null0 : Null zero =
    ptmap-path Ga.A Ga.o Gc.A Gc.o (\ a -> p.1 (i.1 a)) (\ a -> Gc.o)
      (trans Gc.A (p.1 (i.1 Ga.o)) (p.1 Gb.o) Gc.o (ap Gb.A Gc.A p.1 (i.1 Ga.o) Gb.o (hom-unit Ga Gb i)) (hom-unit Gb Gc p))
      (refl Gc.o) pi0
      (Gc.setA (p.1 (i.1 Ga.o)) Gc.o _ _) ;
  null : (m : Nat) -> Null m = split {
    zero -> null0 ;
    suc m | r -> NullStep[m, r].next } ;

  -- the comparison map, and what is proved of every such map
  module Cmp (m : Nat) { module L = Lift[A.K m, A.pt m, B.K m, B.pt m, C.K m, C.pt m, Kp.K m, Ki.K m, null m] ; } ;
  Over (m : Nat) (M : PtMap (A.K m) (A.pt m) (FibK m) (fptK m)) : U l =
    Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (ptcomp (A.K m) (A.pt m) (FibK m) (fptK m) (B.K m) (B.pt m) M (fprK m)) (Ki.K m) ;

  -- m = 0: a map of sets, injective and onto
  module Bottom (M : PtMap Ga.A Ga.o (FibK zero) (fptK zero)) (e : Over zero M) {
    ei (a : Ga.A) : Id Gb.A (M.1 a).1 (i.1 a) =
      happly Ga.A (\ a1 -> Gb.A) (\ a1 -> (M.1 a1).1) i.1
        (ap (PtMap Ga.A Ga.o Gb.A Gb.o) (Ga.A -> Gb.A) (\ w -> w.1)
           (ptcomp Ga.A Ga.o (FibK zero) (fptK zero) Gb.A Gb.o M (fprK zero)) (Ki.K zero) e) a ;
    setF : isSet (FibK zero) = isSet-Sigma Gb.A (\ b -> Id Gc.A (p.1 b) Gc.o) Gb.setA
      (\ b -> prop-to-set (Id Gc.A (p.1 b) Gc.o) (Gc.setA (p.1 b) Gc.o)) ;
    injM : Bj.Injective M.1 = \ a a' q ->
      inj a a' (transH (symH (ei a)) (transH (ap (FibK zero) Gb.A (\ w -> w.1) (M.1 a) (M.1 a') q) (ei a'))) ;
