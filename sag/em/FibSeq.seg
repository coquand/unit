-- The fibre sequence of a short exact sequence 0 -> A -i-> B -p-> C -> 0 of
-- abelian groups: for every m (K(A, 0) = A),
--     K(A, m) ~ Fib (K p m),   z |-> (K i m z, h z),
-- where h : K p m o K i m = const (null).  So K(A, m) -> K(B, m) ->
-- K(C, m) is a fibre sequence, with K i m the fibre inclusion.
--
--  null: m = 0 is exactness (p o i = 0).  For m+1, by unique-loop1 it
--    suffices that loop (K i ; K p) = loop const:
--    loop (K i ; K p) = (e_A ; K i m ; e_B^-1) ; (e_B ; K p m ; e_C^-1)
--                     = e_A ; (K i m ; K p m) ; e_C^-1 = e_A ; const ; e_C^-1 = const.
--  equivalence: by induction on m, for EVERY pointed M : K(A, m) ->
--    Fib (K p m) with fpr o M = K i m.  m = 0: M is injective (i is) and
--    onto (exactness), a map of sets.  m+1: Fib (K p (m+1)) is 0-connected
--    (Fibres.FibConn: loop (K p (m+1)) is onto), so by Whitehead it is
--    enough that loop M is an equivalence.  Moving loop M along e_A,
--    Omega Fib ~ Fib (loop K p) (omega-fib) and Fib (loop K p) ~ Fib (K p m)
--    (fib-equiv, the square of loopK) gives M'' : K(A, m) -> Fib (K p m)
--    with fpr o M'' = K i m (the compatibilities of omega-fib, fib-equiv,
--    loop-comp, loopK); by induction M'' is an equivalence, so loop M is.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ;
open Torsor[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module N = NatArith[l] ;
module W = Whitehead[l] ;
module Eq = Equivalences[l] ;
module Bj = Bijection[l] ;

-- m+3 <= 2m+3
idx1 (m : Nat) : Id Nat (N.plus m (suc (suc (suc m)))) (N.plus (suc m) (N.plus (suc m) (suc zero))) =
  transH (N.plus-suc m (suc (suc m)))
    (ap Nat Nat (\ k -> suc (N.plus m (suc k))) (suc m) (N.plus m (suc zero))
       (sym Nat (N.plus m (suc zero)) (suc m) (transH (N.plus-suc m zero) (ap Nat Nat (\ k -> suc k) (N.plus m zero) m (N.plus-zero m))))) ;

-- 2-out-of-3 on the right: if g o h and h are equivalences, so is g
cancel-equiv-r (X Y Z : U l) (h : X -> Y) (g : Y -> Z) (eh : isEquiv X Y h) (egh : isEquiv X Z (\ x -> g (h x))) : isEquiv Y Z g =
  Eq.homotopy Y Z (Eq.compose Y X Z (eh.sec, W.inv-equiv X Y h eh) ((\ x -> g (h x)), egh)) g
    (\ y -> apH g (symH (eh.sec-eq y))) ;

-- if loop f is onto, so is ap f at the point (conjugation is an equivalence)
loop-surj-ap (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0)
  (s : (v : Id Y y0 y0) -> Tr.Trunc[Bj.Fibre (Maps[X, x0, Y, y0].loop f).1 v].carrier)
  (u : Id Y (f.1 x0) (f.1 x0)) : Tr.Trunc[(q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u].carrier =
  TC.map (Bj.Fibre (Maps[X, x0, Y, y0].loop f).1 (W.conj Y (f.1 x0) y0 f.2 u))
    ((q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u)
    (\ w -> (w.1, Eq.injective (Id Y (f.1 x0) (f.1 x0)) (Id Y y0 y0) (W.conj Y (f.1 x0) y0 f.2) (W.conj-equiv Y (f.1 x0) y0 f.2)
                    (ap X Y f.1 x0 x0 w.1) u (transH (symH (Maps[X, x0, Y, y0].loop-ap f w.1)) w.2)))
    (s (W.conj Y (f.1 x0) y0 f.2 u)) ;

module SES (Ga Gb Gc : Ab) (i : Hom Ga Gb) (p : Hom Gb Gc) (inj : Bj.Injective i.1)
  (pi0 : (a : Ga.A) -> Id Gc.A (p.1 (i.1 a)) Gc.o)
  (ex : (b : Gb.A) -> Id Gc.A (p.1 b) Gc.o -> Tr.Trunc[Bj.Fibre i.1 b].carrier)
  (sur : (c : Gc.A) -> Tr.Trunc[Bj.Fibre p.1 c].carrier) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  module C = KK[Gc] ;
  module Ki = KMap[Ga, Gb, i] ;
  module Kp = KMap[Gb, Gc, p] ;
  FibK (m : Nat) : U l = Fib (B.K m) (B.pt m) (C.K m) (C.pt m) (Kp.K m) ;
  fptK (m : Nat) : FibK m = fpt (B.K m) (B.pt m) (C.K m) (C.pt m) (Kp.K m) ;
  fprK (m : Nat) : PtMap (FibK m) (fptK m) (B.K m) (B.pt m) = fpr (B.K m) (B.pt m) (C.K m) (C.pt m) (Kp.K m) ;
  Null (m : Nat) : U l = Id (PtMap (A.K m) (A.pt m) (C.K m) (C.pt m))
    (ptcomp (A.K m) (A.pt m) (B.K m) (B.pt m) (C.K m) (C.pt m) (Ki.K m) (Kp.K m)) (ptconst (A.K m) (A.pt m) (C.K m) (C.pt m)) ;
  tC (m : Nat) : isTrunc (N.plus (suc m) (N.plus (suc m) (suc zero))) (C.K (suc m)) =
    trunc-index (C.K (suc m)) (N.plus m (suc (suc (suc m)))) (N.plus (suc m) (N.plus (suc m) (suc zero))) (idx1 m)
      (trunc-lift (suc (suc (suc m))) (C.K (suc m)) (C.trunc m) m) ;

  -- the objects at levels m, m+1
  module Obj (m : Nat) {
    X0 : U l = A.K m ;  x0 : X0 = A.pt m ;
    Y0 : U l = B.K m ;  y0 : Y0 = B.pt m ;
    Z0 : U l = C.K m ;  z0 : Z0 = C.pt m ;
    OA : U l = A.OK m ; oa : OA = refl (A.pt (suc m)) ;
    OB : U l = B.OK m ; ob : OB = refl (B.pt (suc m)) ;
    OC : U l = C.OK m ; oc : OC = refl (C.pt (suc m)) ;
    eA : PtMap OA oa X0 x0 = (A.e m).1 ;
    eB : PtMap OB ob Y0 y0 = (B.e m).1 ;
    eC : PtMap OC oc Z0 z0 = (C.e m).1 ;
    eAi : PtMap X0 x0 OA oa = (pt-inv OA oa X0 x0 (A.e m)).1 ;
    eBi : PtMap Y0 y0 OB ob = (pt-inv OB ob Y0 y0 (B.e m)).1 ;
    eCi : PtMap Z0 z0 OC oc = (pt-inv OC oc Z0 z0 (C.e m)).1 ;
    Fi : PtMap X0 x0 Y0 y0 = Ki.K m ;
    Fp : PtMap Y0 y0 Z0 z0 = Kp.K m ;
    P : PtMap OA oa Y0 y0 = ptcomp OA oa X0 x0 Y0 y0 eA Fi ;
    Q : PtMap OB ob Z0 z0 = ptcomp OB ob Y0 y0 Z0 z0 eB Fp ;
  } ;

  -- K p o K i is null
  module NullStep (m : Nat) (r : Null m) {
    open Obj[m] ;
    s5 : Id (PtMap Y0 y0 Z0 z0) (ptcomp Y0 y0 OB ob Z0 z0 eBi Q) Fp =
      transH (symH (ptcomp-assoc Y0 y0 OB ob Y0 y0 Z0 z0 eBi eB Fp))
        (transH (apH (\ X -> ptcomp Y0 y0 Y0 y0 Z0 z0 X Fp) (pt-inv-r OB ob Y0 y0 (B.e m))) (ptcomp-idl Y0 y0 Z0 z0 Fp)) ;
    s9 : Id (PtMap OA oa Z0 z0) (ptcomp OA oa Y0 y0 Z0 z0 P Fp) (ptconst OA oa Z0 z0) =
      transH (ptcomp-assoc OA oa X0 x0 Y0 y0 Z0 z0 eA Fi Fp)
        (transH (apH (ptcomp OA oa X0 x0 Z0 z0 eA) r) (comp-const-r OA oa X0 x0 Z0 z0 eA)) ;
    chain : Id (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].PMO)
        (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop
           (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m))))
        (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop (ptconst (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m)))) =
      calc (Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].PMO) {
        Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop
          (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m)))
          =< loop-comp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m)) >
        ptcomp OA oa OB ob OC oc (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (Ki.K (suc m)))
          (Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (Kp.K (suc m)))
          =< transH (apH (\ X -> ptcomp OA oa OB ob OC oc X (Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (Kp.K (suc m)))) (Ki.loopK m))
                    (apH (ptcomp OA oa OB ob OC oc (Ki.conj m Fi)) (Kp.loopK m)) >
        ptcomp OA oa OB ob OC oc (ptcomp OA oa Y0 y0 OB ob P eBi) (ptcomp OB ob Z0 z0 OC oc Q eCi)
          =< ptcomp-assoc OA oa Y0 y0 OB ob OC oc P eBi (ptcomp OB ob Z0 z0 OC oc Q eCi) >
        ptcomp OA oa Y0 y0 OC oc P (ptcomp Y0 y0 OB ob OC oc eBi (ptcomp OB ob Z0 z0 OC oc Q eCi))
          =< apH (ptcomp OA oa Y0 y0 OC oc P) (symH (ptcomp-assoc Y0 y0 OB ob Z0 z0 OC oc eBi Q eCi)) >
        ptcomp OA oa Y0 y0 OC oc P (ptcomp Y0 y0 Z0 z0 OC oc (ptcomp Y0 y0 OB ob Z0 z0 eBi Q) eCi)
          =< apH (\ X -> ptcomp OA oa Y0 y0 OC oc P (ptcomp Y0 y0 Z0 z0 OC oc X eCi)) s5 >
        ptcomp OA oa Y0 y0 OC oc P (ptcomp Y0 y0 Z0 z0 OC oc Fp eCi)
          =< symH (ptcomp-assoc OA oa Y0 y0 Z0 z0 OC oc P Fp eCi) >
        ptcomp OA oa Z0 z0 OC oc (ptcomp OA oa Y0 y0 Z0 z0 P Fp) eCi
          =< apH (\ X -> ptcomp OA oa Z0 z0 OC oc X eCi) s9 >
        ptcomp OA oa Z0 z0 OC oc (ptconst OA oa Z0 z0) eCi
          =< comp-const-l OA oa Z0 z0 OC oc eCi >
        ptconst OA oa OC oc
          =< symH (loop-const (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m))) >
        Maps[A.K (suc m), A.pt (suc m), C.K (suc m), C.pt (suc m)].loop (ptconst (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m))) } ;
    next : Null (suc m) =
      unique-loop1 m (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (A.conn m) (tC m)
        (ptcomp (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Ki.K (suc m)) (Kp.K (suc m)))
        (ptconst (A.K (suc m)) (A.pt (suc m)) (C.K (suc m)) (C.pt (suc m))) chain ;
  } ;
  null0 : Null zero =
    ptmap-path Ga.A Ga.o Gc.A Gc.o (\ a -> p.1 (i.1 a)) (\ a -> Gc.o)
      (trans Gc.A (p.1 (i.1 Ga.o)) (p.1 Gb.o) Gc.o (ap Gb.A Gc.A p.1 (i.1 Ga.o) Gb.o (hom-unit Ga Gb i)) (hom-unit Gb Gc p))
      (refl Gc.o) pi0
      (Gc.setA (p.1 (i.1 Ga.o)) Gc.o _ _) ;
  null : (m : Nat) -> Null m = split {
    zero -> null0 ;
    suc m | r -> NullStep[m, r].next } ;

  -- the comparison map, and what is proved of every such map
  module Cmp (m : Nat) { module L = Lift[A.K m, A.pt m, B.K m, B.pt m, C.K m, C.pt m, Kp.K m, Ki.K m, null m] ; } ;
  Over (m : Nat) (M : PtMap (A.K m) (A.pt m) (FibK m) (fptK m)) : U l =
    Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (ptcomp (A.K m) (A.pt m) (FibK m) (fptK m) (B.K m) (B.pt m) M (fprK m)) (Ki.K m) ;

  -- m = 0: a map of sets, injective and onto
  module Bottom (M : PtMap Ga.A Ga.o (FibK zero) (fptK zero)) (e : Over zero M) {
    ei (a : Ga.A) : Id Gb.A (M.1 a).1 (i.1 a) =
      happly Ga.A (\ a1 -> Gb.A) (\ a1 -> (M.1 a1).1) i.1
        (ap (PtMap Ga.A Ga.o Gb.A Gb.o) (Ga.A -> Gb.A) (\ w -> w.1)
           (ptcomp Ga.A Ga.o (FibK zero) (fptK zero) Gb.A Gb.o M (fprK zero)) (Ki.K zero) e) a ;
    setF : isSet (FibK zero) = isSet-Sigma Gb.A (\ b -> Id Gc.A (p.1 b) Gc.o) Gb.setA
      (\ b -> prop-to-set (Id Gc.A (p.1 b) Gc.o) (Gc.setA (p.1 b) Gc.o)) ;
    injM : Bj.Injective M.1 = \ a a' q ->
      inj a a' (transH (symH (ei a)) (transH (ap (FibK zero) Gb.A (\ w -> w.1) (M.1 a) (M.1 a') q) (ei a'))) ;
    surjM (w : FibK zero) : Tr.Trunc[Bj.Fibre M.1 w].carrier =
      TC.map (Bj.Fibre i.1 w.1) (Bj.Fibre M.1 w)
        (\ v -> (v.1, Sigma-eq Gb.A (\ b -> Id Gc.A (p.1 b) Gc.o) (M.1 v.1).1 w.1 (M.1 v.1).2 w.2 (transH (ei v.1) v.2)
                  (Gc.setA (p.1 w.1) Gc.o)))
        (ex w.1 w.2) ;
    equiv : isEquiv Ga.A (FibK zero) M.1 = Bj.Bij[Ga.A, FibK zero, setF, M.1, injM, surjM].equiv ;
  } ;

  -- K p m is onto
  kp-onto : (m : Nat) (c : C.K m) -> Tr.Trunc[Bj.Fibre (Kp.K m).1 c].carrier = split {
    zero -> sur ;
    suc n -> \ c -> TC.map (Id (C.K (suc n)) (C.pt (suc n)) c) (Bj.Fibre (Kp.K (suc n)).1 c)
      (\ q -> (B.pt (suc n), transH (Kp.K (suc n)).2 q)) (conn-path n (C.K (suc n)) (C.conn n) (C.pt (suc n)) c) } ;

  -- m+1 from m
  module Step (m : Nat) (ih : (M : PtMap (A.K m) (A.pt m) (FibK m) (fptK m)) -> Over m M -> isEquiv (A.K m) (FibK m) M.1)
    (M : PtMap (A.K (suc m)) (A.pt (suc m)) (FibK (suc m)) (fptK (suc m))) (e : Over (suc m) M) {
    open Obj[m] ;
    F1 : U l = FibK (suc m) ;  f1 : F1 = fptK (suc m) ;
    Om : U l = Id F1 f1 f1 ;  om : Om = refl f1 ;
    LKp : PtMap OB ob OC oc = Maps[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m)].loop (Kp.K (suc m)) ;
    L : U l = Fib OB ob OC oc LKp ;  l0 : L = fpt OB ob OC oc LKp ;
    Fm : U l = FibK m ;  fm : Fm = fptK m ;
    OFp : OF (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Kp.K (suc m)) =
      omega-fib (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Kp.K (suc m)) ;
    sq : Id (PtMap OB ob Z0 z0) (ptcomp OB ob OC oc Z0 z0 LKp eC) (ptcomp OB ob Y0 y0 Z0 z0 eB Fp) =
      transH (apH (\ X -> ptcomp OB ob OC oc Z0 z0 X eC) (Kp.loopK m))
        (transH (ptcomp-assoc OB ob Z0 z0 OC oc Z0 z0 Q eCi eC)
          (transH (apH (ptcomp OB ob Z0 z0 Z0 z0 Q) (pt-inv-r OC oc Z0 z0 (C.e m))) (ptcomp-idr OB ob Z0 z0 Q))) ;
    FEp : FibSq OB ob OC oc Y0 y0 Z0 z0 (B.e m) LKp Fp =
      fib-equiv OB ob OC oc Y0 y0 Z0 z0 (B.e m) (C.e m) LKp Fp sq ;
    LM : PtMap OA oa Om om = Maps[A.K (suc m), A.pt (suc m), F1, f1].loop M ;
    fprL : PtMap L l0 OB ob = fpr OB ob OC oc LKp ;
    fprF : PtMap F1 f1 (B.K (suc m)) (B.pt (suc m)) = fprK (suc m) ;
    N1 : PtMap X0 x0 Om om = ptcomp X0 x0 OA oa Om om eAi LM ;
    N2 : PtMap X0 x0 L l0 = ptcomp X0 x0 Om om L l0 N1 OFp.1.1 ;
    M2 : PtMap X0 x0 Fm fm = ptcomp X0 x0 L l0 Fm fm N2 FEp.1.1 ;
    -- fpr o (e_A^-1 ; loop M ; Omega-fib) = e_A^-1 ; loop (fpr o M) = e_A^-1 ; e_A ; K i m ; e_B^-1
    u1 : Id (PtMap X0 x0 OB ob) (ptcomp X0 x0 L l0 OB ob N2 fprL) (ptcomp X0 x0 OA oa OB ob eAi (ptcomp OA oa Y0 y0 OB ob P eBi)) =
      calc (PtMap X0 x0 OB ob) {
        ptcomp X0 x0 L l0 OB ob N2 fprL =< ptcomp-assoc X0 x0 Om om L l0 OB ob N1 OFp.1.1 fprL >
        ptcomp X0 x0 Om om OB ob N1 (ptcomp Om om L l0 OB ob OFp.1.1 fprL) =< apH (ptcomp X0 x0 Om om OB ob N1) OFp.2 >
        ptcomp X0 x0 Om om OB ob N1 (Maps[F1, f1, B.K (suc m), B.pt (suc m)].loop fprF)
          =< ptcomp-assoc X0 x0 OA oa Om om OB ob eAi LM (Maps[F1, f1, B.K (suc m), B.pt (suc m)].loop fprF) >
        ptcomp X0 x0 OA oa OB ob eAi (ptcomp OA oa Om om OB ob LM (Maps[F1, f1, B.K (suc m), B.pt (suc m)].loop fprF))
          =< apH (ptcomp X0 x0 OA oa OB ob eAi)
               (symH (loop-comp (A.K (suc m)) (A.pt (suc m)) F1 f1 (B.K (suc m)) (B.pt (suc m)) M fprF)) >
        ptcomp X0 x0 OA oa OB ob eAi (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop
          (ptcomp (A.K (suc m)) (A.pt (suc m)) F1 f1 (B.K (suc m)) (B.pt (suc m)) M fprF))
          =< apH (\ X -> ptcomp X0 x0 OA oa OB ob eAi (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop X)) e >
        ptcomp X0 x0 OA oa OB ob eAi (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (Ki.K (suc m)))
          =< apH (ptcomp X0 x0 OA oa OB ob eAi) (Ki.loopK m) >
        ptcomp X0 x0 OA oa OB ob eAi (ptcomp OA oa Y0 y0 OB ob P eBi) } ;
    -- ... ; e_B = K i m
    u2 : Id (PtMap X0 x0 Y0 y0) (ptcomp X0 x0 OB ob Y0 y0 (ptcomp X0 x0 OA oa OB ob eAi (ptcomp OA oa Y0 y0 OB ob P eBi)) eB) Fi =
      calc (PtMap X0 x0 Y0 y0) {
        ptcomp X0 x0 OB ob Y0 y0 (ptcomp X0 x0 OA oa OB ob eAi (ptcomp OA oa Y0 y0 OB ob P eBi)) eB
          =< ptcomp-assoc X0 x0 OA oa OB ob Y0 y0 eAi (ptcomp OA oa Y0 y0 OB ob P eBi) eB >
        ptcomp X0 x0 OA oa Y0 y0 eAi (ptcomp OA oa OB ob Y0 y0 (ptcomp OA oa Y0 y0 OB ob P eBi) eB)
          =< apH (ptcomp X0 x0 OA oa Y0 y0 eAi)
               (transH (ptcomp-assoc OA oa Y0 y0 OB ob Y0 y0 P eBi eB)
                  (transH (apH (ptcomp OA oa Y0 y0 Y0 y0 P) (pt-inv-r OB ob Y0 y0 (B.e m))) (ptcomp-idr OA oa Y0 y0 P))) >
        ptcomp X0 x0 OA oa Y0 y0 eAi P
          =< symH (ptcomp-assoc X0 x0 OA oa X0 x0 Y0 y0 eAi eA Fi) >
        ptcomp X0 x0 X0 x0 Y0 y0 (ptcomp X0 x0 OA oa X0 x0 eAi eA) Fi
          =< apH (\ X -> ptcomp X0 x0 X0 x0 Y0 y0 X Fi) (pt-inv-r OA oa X0 x0 (A.e m)) >
        ptcomp X0 x0 X0 x0 Y0 y0 (ptid X0 x0) Fi =< ptcomp-idl X0 x0 Y0 y0 Fi > Fi } ;
    e2 : Over m M2 = calc (PtMap X0 x0 Y0 y0) {
      ptcomp X0 x0 Fm fm Y0 y0 M2 (fprK m) =< ptcomp-assoc X0 x0 L l0 Fm fm Y0 y0 N2 FEp.1.1 (fprK m) >
      ptcomp X0 x0 L l0 Y0 y0 N2 (ptcomp L l0 Fm fm Y0 y0 FEp.1.1 (fprK m)) =< apH (ptcomp X0 x0 L l0 Y0 y0 N2) FEp.2 >
      ptcomp X0 x0 L l0 Y0 y0 N2 (ptcomp L l0 OB ob Y0 y0 fprL eB) =< symH (ptcomp-assoc X0 x0 L l0 OB ob Y0 y0 N2 fprL eB) >
      ptcomp X0 x0 OB ob Y0 y0 (ptcomp X0 x0 L l0 OB ob N2 fprL) eB =< apH (\ X -> ptcomp X0 x0 OB ob Y0 y0 X eB) u1 >
      ptcomp X0 x0 OB ob Y0 y0 (ptcomp X0 x0 OA oa OB ob eAi (ptcomp OA oa Y0 y0 OB ob P eBi)) eB =< u2 > Fi } ;
    -- so loop M is an equivalence
    eM2 : isEquiv X0 Fm M2.1 = ih M2 e2 ;
    eLM : isEquiv OA Om LM.1 =
      cancel-equiv-r X0 OA Om eAi.1 LM.1 (W.inv-equiv OA X0 eA.1 (A.e m).2)
        (W.cancel-equiv X0 Om Fm (\ z -> LM.1 (eAi.1 z)) (\ w -> FEp.1.1.1 (OFp.1.1.1 w))
           (Eq.compose Om L Fm (OFp.1.1.1, OFp.1.2) (FEp.1.1.1, FEp.1.2)).2 eM2) ;
    -- the fibre is 0-connected
    lkp-onto (v : OC) : Tr.Trunc[Bj.Fibre LKp.1 v].carrier =
      TC.map (Bj.Fibre Fp.1 (eC.1 v)) (Bj.Fibre LKp.1 v)
        (\ w -> ((B.e m).2.sec w.1, transH
           (happly OB (\ q -> OC) LKp.1 (Kp.conj m Fp).1 (ap (PtMap OB ob OC oc) (OB -> OC) (\ g -> g.1) LKp (Kp.conj m Fp) (Kp.loopK m)) ((B.e m).2.sec w.1))
           (transH (apH (\ z -> eCi.1 (Fp.1 z)) ((B.e m).2.sec-eq w.1))
             (transH (apH eCi.1 w.2) (sec-ret OC Z0 eC.1 (C.e m).2 v)))))
        (kp-onto m (eC.1 v)) ;
    cF : isConn (suc (suc zero)) F1 =
      FibConn[B.K (suc m), B.pt (suc m), C.K (suc m), C.pt (suc m), Kp.K (suc m), conn-zero m (B.K (suc m)) (B.conn m),
        loop-surj-ap (B.K (suc m)) (B.pt (suc m)) (C.K (suc m)) (C.pt (suc m)) (Kp.K (suc m)) lkp-onto].conn ;
    equiv : isEquiv (A.K (suc m)) F1 M.1 =
      W.Pointed[A.K (suc m), A.pt (suc m), F1, f1, M, conn-zero m (A.K (suc m)) (A.conn m), eLM].equiv cF ;
  } ;

  every : (m : Nat) (M : PtMap (A.K m) (A.pt m) (FibK m) (fptK m)) -> Over m M -> isEquiv (A.K m) (FibK m) M.1 = split {
    zero -> \ M e -> Bottom[M, e].equiv ;
    suc m | ih -> \ M e -> Step[m, ih, M, e].equiv } ;

  -- the fibre sequence
  fibre (m : Nat) : isEquiv (A.K m) (FibK m) Cmp[m].L.lift.1 = every m Cmp[m].L.lift Cmp[m].L.lift-fst ;
} ;
