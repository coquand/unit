-- CCA Def. 3.2.1 and Lemmas 3.2.2-3.2.4 (plain HoTT): for a type S and
-- abelian groups A x (x : S), the map
--     eps m : K(Pi A, m) ->pt (x : S) -> K(A x, m),
-- defined by delooping (DW1 Cor. 11, 12): eps 0 = id (K(-, 0) is the
-- group), eps (m+1) the delooping of  e ; eps m ; psi^-1, where
--     psi m : Omega ((x : S) -> K(A x, m+1)) ~pt (x : S) -> K(A x, m)
-- is happly followed by the e_x.  So loop (eps (m+1)) = e ; eps m ; psi^-1
-- (loop-eps), which is what CCA Lemma 3.2.3 uses (it is the canonical map:
-- both are determined by their loopings, not needed here).
--   Lemma 3.2.3  eps m an equivalence  =>  eps (m+1) an embedding
--                (Whitehead.Pointed.emb: its looping is an equivalence)
--   Lemma 3.2.4  (x : S) -> K(A x, m+1) 0-connected  =>  eps (m+1) onto
--   Lemma 3.2.2  eps (m+1) an equivalence  =>  H^(m+1)(S, A) = 0
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open EMMaps[l] ;
open Torsor[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module N = NatArith[l] ;
module Eq = Equivalences[l] ;
module W = Whitehead[l] ;
module EMf = EM[l] ;

-- the product of abelian groups
prod-ab (S : U l) (A : S -> Ab) : Ab = new Ab[(x : S) -> (A x).A, FL.isSet-Pi S (\ x -> (A x).A) (\ x -> (A x).setA),
  \ x -> (A x).o, \ f g x -> (A x).add (f x) (g x), \ f x -> (A x).inv (f x),
  \ f g h -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).assoc (f x) (g x) (h x)),
  \ f g -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).comm (f x) (g x)),
  \ f -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).unitr (f x)),
  \ f -> FL.funext S (\ x -> (A x).A) _ _ (\ x -> (A x).invr (f x))] ;

-- happly sends composition to pointwise composition
happly-trans (X : U l) (B : X -> U l) (f g : (x : X) -> B x) (p : Id ((x : X) -> B x) f g) :
  (h : (x : X) -> B x) (q : Id ((x : X) -> B x) g h) (x : X) ->
  Id (Id (B x) (f x) (h x)) (happly X B f h (trans ((x1 : X) -> B x1) f g h p q) x) (trans (B x) (f x) (g x) (h x) (happly X B f g p x) (happly X B g h q x)) =
  \ h q x -> idJ ((x1 : X) -> B x1) g (\ h1 q1 -> Id (Id (B x) (f x) (h1 x)) (happly X B f h1 (trans ((x1 : X) -> B x1) f g h1 p q1) x)
      (trans (B x) (f x) (g x) (h1 x) (happly X B f g p x) (happly X B g h1 q1 x)))
    (refl (happly X B f g p x)) h q ;

module Eps (S : U l) (A : S -> Ab) {
  PA : Ab = prod-ab S A ;
  module KP = KK[PA] ;
  module KA (x : S) { module K = KK[A x] ; } ;
  P (m : Nat) : U l = (x : S) -> KA[x].K.K m ;
  pP (m : Nat) : P m = \ x -> KA[x].K.pt m ;
  OP (m : Nat) : U l = Id (P (suc m)) (pP (suc m)) (pP (suc m)) ;
  -- psi m : Omega (P (m+1)) ~pt P m
  psi-fun (m : Nat) (w : OP m) : P m = \ x -> (KA[x].K.e m).1.1 (happly S (\ x1 -> KA[x1].K.K (suc m)) (pP (suc m)) (pP (suc m)) w x) ;
  psi (m : Nat) : PtEquiv (OP m) (refl (pP (suc m))) (P m) (pP m) =
    ((psi-fun m, FL.funext S (\ x -> KA[x].K.K m) (psi-fun m (refl (pP (suc m)))) (pP m) (\ x -> (KA[x].K.e m).1.2)),
     (Eq.compose (OP m) ((x : S) -> KA[x].K.OK m) (P m)
        (happly S (\ x1 -> KA[x1].K.K (suc m)) (pP (suc m)) (pP (suc m)), fe @l S (\ x1 -> KA[x1].K.K (suc m)) (pP (suc m)) (pP (suc m)))
        ((\ a x -> (KA[x].K.e m).1.1 (a x)),
         PiEquiv[l].pi-equiv S (\ x -> KA[x].K.OK m) (\ x -> KA[x].K.K m) (\ x -> (KA[x].K.e m).1.1) (\ x -> (KA[x].K.e m).2))).2) ;
  conjE (m : Nat) (F : PtMap (KP.K m) (KP.pt m) (P m) (pP m)) : Maps[KP.K (suc m), KP.pt (suc m), P (suc m), pP (suc m)].PMO =
    ptcomp (KP.OK m) (refl (KP.pt (suc m))) (P m) (pP m) (OP m) (refl (pP (suc m)))
      (ptcomp (KP.OK m) (refl (KP.pt (suc m))) (KP.K m) (KP.pt m) (P m) (pP m) (KP.e m).1 F)
      (pt-inv (OP m) (refl (pP (suc m))) (P m) (pP m) (psi m)).1 ;

  eps0 : PtMap (KP.K zero) (KP.pt zero) (P zero) (pP zero) = (\ a -> a, refl (pP zero)) ;
  -- level 1: the looping is multiplicative (psi 0 is, and so its inverse)
  psi0-mult (u v : OP zero) : Id (P zero) (psi-fun zero (trans (P (suc zero)) (pP (suc zero)) (pP (suc zero)) (pP (suc zero)) u v))
      (\ x -> (A x).add (psi-fun zero u x) (psi-fun zero v x)) =
    FL.funext S (\ x -> (A x).A) _ _ (\ x ->
      transH (apH (KA[x].K.E1.band KA[x].K.E1.k0)
                (happly-trans S (\ x1 -> KA[x1].K.K (suc zero)) (pP (suc zero)) (pP (suc zero)) u (pP (suc zero)) v x))
        (KA[x].K.E1.band-hom KA[x].K.E1.k0
           (happly S (\ x1 -> KA[x1].K.K (suc zero)) (pP (suc zero)) (pP (suc zero)) u x)
           (happly S (\ x1 -> KA[x1].K.K (suc zero)) (pP (suc zero)) (pP (suc zero)) v x))) ;
  mult0 (p q : KP.OK zero) :
    Id (OP zero) ((conjE zero eps0).1 (trans (KP.K (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) p q))
      (trans (P (suc zero)) (pP (suc zero)) (pP (suc zero)) (pP (suc zero)) ((conjE zero eps0).1 p) ((conjE zero eps0).1 q)) =
    Eq.injective (OP zero) (P zero) (psi-fun zero) (psi zero).2 _ _ (calc (P zero) {
      psi-fun zero ((conjE zero eps0).1 (trans (KP.K (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) p q))
        =< (psi zero).2.sec-eq (KP.E1.band KP.E1.k0 (trans (KP.K (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) p q)) >
      KP.E1.band KP.E1.k0 (trans (KP.K (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) (KP.pt (suc zero)) p q)
        =< KP.E1.band-hom KP.E1.k0 p q >
      (\ x -> (A x).add (KP.E1.band KP.E1.k0 p x) (KP.E1.band KP.E1.k0 q x))
        =< symH (FL.funext S (\ x -> (A x).A) _ _ (\ x ->
              transH (apH (\ c -> (A x).add c (psi-fun zero ((conjE zero eps0).1 q) x))
                        (happly S (\ x1 -> (A x1).A) _ _ ((psi zero).2.sec-eq (KP.E1.band KP.E1.k0 p)) x))
                (apH ((A x).add (KP.E1.band KP.E1.k0 p x))
                   (happly S (\ x1 -> (A x1).A) _ _ ((psi zero).2.sec-eq (KP.E1.band KP.E1.k0 q)) x)))) >
      (\ x -> (A x).add (psi-fun zero ((conjE zero eps0).1 p) x) (psi-fun zero ((conjE zero eps0).1 q) x))
        =< symH (psi0-mult ((conjE zero eps0).1 p) ((conjE zero eps0).1 q)) >
      psi-fun zero (trans (P (suc zero)) (pP (suc zero)) (pP (suc zero)) (pP (suc zero)) ((conjE zero eps0).1 p) ((conjE zero eps0).1 q)) }) ;
  tP0 : isTrunc (suc (suc (suc zero))) (P (suc zero)) =
    trunc-Pi (suc (suc (suc zero))) S (\ x -> KA[x].K.K (suc zero)) (\ x -> KA[x].K.trunc zero) ;
  cell0 : isContr (Maps[KP.K (suc zero), KP.pt (suc zero), P (suc zero), pP (suc zero)].Over[conjE zero eps0].Unloop) =
    Maps[KP.K (suc zero), KP.pt (suc zero), P (suc zero), pP (suc zero)].Over[conjE zero eps0].Mult[KP.conn zero, tP0, mult0].cor12 ;
  -- higher levels
  tPS (n : Nat) : isTrunc (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) (P (suc (suc n))) =
    trunc-Pi (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) S (\ x -> KA[x].K.K (suc (suc n)))
      (\ x -> trunc-index (KA[x].K.K (suc (suc n))) (N.plus n (suc (suc (suc (suc n))))) (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero))
         (EMf.idx n) (trunc-lift (suc (suc (suc (suc n)))) (KA[x].K.K (suc (suc n))) (KA[x].K.trunc (suc n)) n)) ;
  cellS (n : Nat) (F : PtMap (KP.K (suc n)) (KP.pt (suc n)) (P (suc n)) (pP (suc n))) :
    isContr (Maps[KP.K (suc (suc n)), KP.pt (suc (suc n)), P (suc (suc n)), pP (suc (suc n))].Over[conjE (suc n) F].Unloop) =
    Maps[KP.K (suc (suc n)), KP.pt (suc (suc n)), P (suc (suc n)), pP (suc (suc n))].Over[conjE (suc n) F].cor11 (suc n)
      (KP.conn (suc n)) (tPS n) ;
  epsS : (n : Nat) -> PtMap (KP.K (suc n)) (KP.pt (suc n)) (P (suc n)) (pP (suc n)) = split {
    zero -> cell0.1.1 ;
    suc n | r -> (cellS n r).1.1 } ;
  eps : (m : Nat) -> PtMap (KP.K m) (KP.pt m) (P m) (pP m) = split { zero -> eps0 ; suc n -> epsS n } ;
  loop-eps : (m : Nat) -> Id (Maps[KP.K (suc m), KP.pt (suc m), P (suc m), pP (suc m)].PMO)
      (Maps[KP.K (suc m), KP.pt (suc m), P (suc m), pP (suc m)].loop (eps (suc m))) (conjE m (eps m)) = split {
    zero -> symH cell0.1.2 ;
    suc n -> symH (cellS n (epsS n)).1.2 } ;

  -- Lemma 3.2.3: if eps m is an equivalence, eps (m+1) is an embedding
  module Emb (m : Nat) (eq : isEquiv (KP.K m) (P m) (eps m).1) {
    LE : PtMap (KP.OK m) (refl (KP.pt (suc m))) (OP m) (refl (pP (suc m))) =
      Maps[KP.K (suc m), KP.pt (suc m), P (suc m), pP (suc m)].loop (eps (suc m)) ;
    el : isEquiv (KP.OK m) (OP m) LE.1 =
      Eq.homotopy (KP.OK m) (OP m)
        (Eq.compose (KP.OK m) (P m) (OP m)
           (Eq.compose (KP.OK m) (KP.K m) (P m) ((KP.e m).1.1, (KP.e m).2) ((eps m).1, eq))
           ((psi m).2.sec, W.inv-equiv (OP m) (P m) (psi-fun m) (psi m).2))
        LE.1
        (happly (KP.OK m) (\ q -> OP m) LE.1 (conjE m (eps m)).1
           (ap (Maps[KP.K (suc m), KP.pt (suc m), P (suc m), pP (suc m)].PMO) (KP.OK m -> OP m) (\ g -> g.1) LE (conjE m (eps m)) (loop-eps m))) ;
    module WP = W.Pointed[KP.K (suc m), KP.pt (suc m), P (suc m), pP (suc m), eps (suc m), conn-zero m (KP.K (suc m)) (KP.conn m), el] ;
    emb : (y y' : KP.K (suc m)) -> isEquiv (Id (KP.K (suc m)) y y') (Id (P (suc m)) ((eps (suc m)).1 y) ((eps (suc m)).1 y'))
        (ap (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 y y') = WP.emb ;
    -- Lemma 3.2.4 and the conclusion: if moreover H^(m+1)(S, A) = 0, eps (m+1) is an equivalence
    onto (c : isConn (suc (suc zero)) (P (suc m))) (y : P (suc m)) : Tr.Trunc[W.fib (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 y].carrier =
      TC.map (Id (P (suc m)) (pP (suc m)) y) (W.fib (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 y)
        (\ q -> (KP.pt (suc m), trans (P (suc m)) ((eps (suc m)).1 (KP.pt (suc m))) (pP (suc m)) y (eps (suc m)).2 q))
        (conn-path zero (P (suc m)) c (pP (suc m)) y) ;
    equiv (c : isConn (suc (suc zero)) (P (suc m))) : isEquiv (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 =
      W.contr-equiv (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 (\ y ->
        TC.rec (W.fib (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 y) @l (isContr (W.fib (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 y))
          (Torsor[l].isProp-isContr (W.fib (KP.K (suc m)) (P (suc m)) (eps (suc m)).1 y))
          (\ w -> (w, \ v -> WP.fib-prop y w v)) (onto c y)) ;
  } ;

  -- Lemma 3.2.2: if eps (m+1) is an equivalence, H^(m+1)(S, A) = 0
  vanish (m : Nat) (eq : isEquiv (KP.K (suc m)) (P (suc m)) (eps (suc m)).1) : isConn (suc (suc zero)) (P (suc m)) =
    Deloop[l].equiv-conn (suc (suc zero)) (P (suc m)) (KP.K (suc m)) (Bijection[l].inverse (KP.K (suc m)) (P (suc m)) ((eps (suc m)).1, eq))
      (conn-zero m (KP.K (suc m)) (KP.conn m)) ;
} ;

------------------------------------------------------------------------
-- For the constant family A over T and the diagonal i : A -> A^T,
--     eps m o K i m = diag m : K(A, m) -> (T -> K(A, m)),  y |-> (t |-> y).
-- m = 0: by definition up to the pointing (a set).  m+1: unique-loop1;
-- loop (K i ; eps) = e ; (K i m ; eps m) ; psi^-1 = e ; diag m ; psi^-1
-- (as in FibSeq.NullStep), and loop diag ; psi = e ; diag m (happly of
-- ap diag is constant; the pointing by funext of refl).

ap-diag (T Y : U l) (u v : Y) (p : Id Y u v) :
  Id (Id (T -> Y) (\ t -> u) (\ t -> v)) (ap Y (T -> Y) (\ y t -> y) u v p) (FL.funext T (\ t -> Y) (\ t -> u) (\ t -> v) (\ t -> p)) =
  idJ Y u (\ v1 p1 -> Id (Id (T -> Y) (\ t -> u) (\ t -> v1)) (ap Y (T -> Y) (\ y t -> y) u v1 p1) (FL.funext T (\ t -> Y) (\ t -> u) (\ t -> v1) (\ t -> p1)))
    (symH (FL.funext-happly T (\ t -> Y) (\ t -> u) (\ t -> u) (refl (\ t -> u)))) v p ;
happly-ap-diag (T Y : U l) (u v : Y) (p : Id Y u v) (t : T) :
  Id (Id Y u v) (happly T (\ t1 -> Y) (\ t1 -> u) (\ t1 -> v) (ap Y (T -> Y) (\ y t1 -> y) u v p) t) p =
  idJ Y u (\ v1 p1 -> Id (Id Y u v1) (happly T (\ t1 -> Y) (\ t1 -> u) (\ t1 -> v1) (ap Y (T -> Y) (\ y t1 -> y) u v1 p1) t) p1)
    (refl (refl u)) v p ;

module Diag (T : U l) (Ga : Ab) {
  module E = Eps[T, \ t -> Ga] ;
  module KA = KK[Ga] ;
  i : Hom Ga E.PA = (\ a t -> a, \ x y -> refl (\ t -> Ga.add x y)) ;
  module Ki = KMap[Ga, E.PA, i] ;
  diag (m : Nat) : PtMap (KA.K m) (KA.pt m) (E.P m) (E.pP m) = (\ y t -> y, refl (E.pP m)) ;
  Claim (m : Nat) : U l = Id (PtMap (KA.K m) (KA.pt m) (E.P m) (E.pP m))
    (ptcomp (KA.K m) (KA.pt m) (E.KP.K m) (E.KP.pt m) (E.P m) (E.pP m) (Ki.K m) (E.eps m)) (diag m) ;
  claim0 : Claim zero =
    ptmap-path Ga.A Ga.o (E.P zero) (E.pP zero) (\ a t -> a) (\ a t -> a)
      (trans (E.P zero) (i.1 Ga.o) (i.1 Ga.o) (E.pP zero) (ap (E.P zero) (E.P zero) (\ a -> a) (i.1 Ga.o) (E.pP zero) (hom-unit Ga E.PA i)) (refl (E.pP zero)))
      (refl (E.pP zero)) (\ a -> refl (\ t -> a))
      (E.PA.setA (i.1 Ga.o) (E.pP zero) _ _) ;
  tPd (m : Nat) : isTrunc (N.plus (suc m) (N.plus (suc m) (suc zero))) (E.P (suc m)) =
    trunc-Pi (N.plus (suc m) (N.plus (suc m) (suc zero))) T (\ t -> KA.K (suc m)) (\ t ->
      trunc-index (KA.K (suc m)) (N.plus m (suc (suc (suc m)))) (N.plus (suc m) (N.plus (suc m) (suc zero))) (FibSeq[l].idx1 m)
        (trunc-lift (suc (suc (suc m))) (KA.K (suc m)) (KA.trunc m) m)) ;

  module DStep (m : Nat) (r : Claim m) {
    X0 : U l = KA.K m ;  x0 : X0 = KA.pt m ;
    OA : U l = KA.OK m ;  oa : OA = refl (KA.pt (suc m)) ;
    Y0 : U l = E.KP.K m ;  y0 : Y0 = E.KP.pt m ;
    OB : U l = E.KP.OK m ;  ob : OB = refl (E.KP.pt (suc m)) ;
    Z0 : U l = E.P m ;  z0 : Z0 = E.pP m ;
    OZ : U l = E.OP m ;  oz : OZ = refl (E.pP (suc m)) ;
    eA : PtMap OA oa X0 x0 = (KA.e m).1 ;
    eB : PtMap OB ob Y0 y0 = (E.KP.e m).1 ;
    eBi : PtMap Y0 y0 OB ob = (pt-inv OB ob Y0 y0 (E.KP.e m)).1 ;
    ps : PtMap OZ oz Z0 z0 = (E.psi m).1 ;
    psi : PtMap Z0 z0 OZ oz = (pt-inv OZ oz Z0 z0 (E.psi m)).1 ;
    Fi : PtMap X0 x0 Y0 y0 = Ki.K m ;
    Fe : PtMap Y0 y0 Z0 z0 = E.eps m ;
    P : PtMap OA oa Y0 y0 = ptcomp OA oa X0 x0 Y0 y0 eA Fi ;
    Q : PtMap OB ob Z0 z0 = ptcomp OB ob Y0 y0 Z0 z0 eB Fe ;
    dg : PtMap (KA.K (suc m)) (KA.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) = diag (suc m) ;
    LD0 : PtMap OA oa OZ oz = Maps[KA.K (suc m), KA.pt (suc m), E.P (suc m), E.pP (suc m)].loop dg ;
    -- happly of the looping of diag is constant
    hd (q : OA) (t : T) : Id OA (happly T (\ t1 -> KA.K (suc m)) (E.pP (suc m)) (E.pP (suc m)) (LD0.1 q) t) q =
      transH (apH (\ w -> happly T (\ t1 -> KA.K (suc m)) (E.pP (suc m)) (E.pP (suc m)) w t)
                (transH (Maps[KA.K (suc m), KA.pt (suc m), E.P (suc m), E.pP (suc m)].loop-ap dg q)
                   (trans-refl-l (E.P (suc m)) (E.pP (suc m)) (E.pP (suc m)) (ap (KA.K (suc m)) (E.P (suc m)) dg.1 (KA.pt (suc m)) (KA.pt (suc m)) q))))
        (happly-ap-diag T (KA.K (suc m)) (KA.pt (suc m)) (KA.pt (suc m)) q t) ;
    LD : Id (PtMap OA oa Z0 z0) (ptcomp OA oa OZ oz Z0 z0 LD0 ps) (ptcomp OA oa X0 x0 Z0 z0 eA (diag m)) =
      ptmap-path OA oa Z0 z0 (\ q -> ps.1 (LD0.1 q)) (\ q t -> eA.1 q)
        (trans Z0 (ps.1 (LD0.1 oa)) (ps.1 oz) z0 (ap OZ Z0 ps.1 (LD0.1 oa) oz LD0.2) ps.2)
        (trans Z0 (\ t -> eA.1 oa) (\ t -> x0) z0 (ap X0 Z0 (diag m).1 (eA.1 oa) x0 eA.2) (refl z0))
        (\ q -> FL.funext T (\ t -> X0) (ps.1 (LD0.1 q)) (\ t -> eA.1 q) (\ t -> apH eA.1 (hd q t)))
        (calc (Id Z0 (\ t -> eA.1 oa) z0) {
          trans Z0 (\ t -> eA.1 oa) (\ t -> eA.1 oa) z0 (refl (\ t -> eA.1 oa)) ps.2
            =< trans-refl-l Z0 (\ t -> eA.1 oa) z0 ps.2 > ps.2
            =< symH (ap-diag T X0 (eA.1 oa) x0 eA.2) > ap X0 Z0 (diag m).1 (eA.1 oa) x0 eA.2
            =< symH (trans-refl-l Z0 (\ t -> eA.1 oa) z0 (ap X0 Z0 (diag m).1 (eA.1 oa) x0 eA.2)) >
          trans Z0 (\ t -> eA.1 oa) (\ t -> eA.1 oa) z0 (refl (\ t -> eA.1 oa)) (ap X0 Z0 (diag m).1 (eA.1 oa) x0 eA.2)
            =< apH (\ z -> trans Z0 (\ t -> eA.1 oa) (\ t -> eA.1 oa) z0 z (ap X0 Z0 (diag m).1 (eA.1 oa) x0 eA.2))
                 (symH (FL.funext-happly T (\ t -> X0) (\ t -> eA.1 oa) (\ t -> eA.1 oa) (refl (\ t -> eA.1 oa)))) >
          trans Z0 (\ t -> eA.1 oa) (\ t -> eA.1 oa) z0 (FL.funext T (\ t -> X0) (\ t -> eA.1 oa) (\ t -> eA.1 oa) (\ t -> refl (eA.1 oa)))
            (ap X0 Z0 (diag m).1 (eA.1 oa) x0 eA.2) }) ;
    loop-diag : Id (PtMap OA oa OZ oz) LD0 (ptcomp OA oa Z0 z0 OZ oz (ptcomp OA oa X0 x0 Z0 z0 eA (diag m)) psi) =
      calc (PtMap OA oa OZ oz) {
        LD0 =< symH (Fibres[l].ptcomp-idr OA oa OZ oz LD0) > ptcomp OA oa OZ oz OZ oz LD0 (ptid OZ oz)
          =< apH (ptcomp OA oa OZ oz OZ oz LD0) (symH (pt-inv-l OZ oz Z0 z0 (E.psi m))) >
        ptcomp OA oa OZ oz OZ oz LD0 (ptcomp OZ oz Z0 z0 OZ oz ps psi)
          =< symH (ptcomp-assoc OA oa OZ oz Z0 z0 OZ oz LD0 ps psi) >
        ptcomp OA oa Z0 z0 OZ oz (ptcomp OA oa OZ oz Z0 z0 LD0 ps) psi
          =< apH (\ X -> ptcomp OA oa Z0 z0 OZ oz X psi) LD >
        ptcomp OA oa Z0 z0 OZ oz (ptcomp OA oa X0 x0 Z0 z0 eA (diag m)) psi } ;
    s5 : Id (PtMap Y0 y0 Z0 z0) (ptcomp Y0 y0 OB ob Z0 z0 eBi Q) Fe =
      transH (symH (ptcomp-assoc Y0 y0 OB ob Y0 y0 Z0 z0 eBi eB Fe))
        (transH (apH (\ X -> ptcomp Y0 y0 Y0 y0 Z0 z0 X Fe) (pt-inv-r OB ob Y0 y0 (E.KP.e m))) (Fibres[l].ptcomp-idl Y0 y0 Z0 z0 Fe)) ;
    s9 : Id (PtMap OA oa Z0 z0) (ptcomp OA oa Y0 y0 Z0 z0 P Fe) (ptcomp OA oa X0 x0 Z0 z0 eA (diag m)) =
      transH (ptcomp-assoc OA oa X0 x0 Y0 y0 Z0 z0 eA Fi Fe) (apH (ptcomp OA oa X0 x0 Z0 z0 eA) r) ;
    chain : Id (PtMap OA oa OZ oz)
        (Maps[KA.K (suc m), KA.pt (suc m), E.P (suc m), E.pP (suc m)].loop
           (ptcomp (KA.K (suc m)) (KA.pt (suc m)) (E.KP.K (suc m)) (E.KP.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) (Ki.K (suc m)) (E.eps (suc m))))
        LD0 =
      calc (PtMap OA oa OZ oz) {
        Maps[KA.K (suc m), KA.pt (suc m), E.P (suc m), E.pP (suc m)].loop
          (ptcomp (KA.K (suc m)) (KA.pt (suc m)) (E.KP.K (suc m)) (E.KP.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) (Ki.K (suc m)) (E.eps (suc m)))
          =< loop-comp (KA.K (suc m)) (KA.pt (suc m)) (E.KP.K (suc m)) (E.KP.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) (Ki.K (suc m)) (E.eps (suc m)) >
        ptcomp OA oa OB ob OZ oz (Maps[KA.K (suc m), KA.pt (suc m), E.KP.K (suc m), E.KP.pt (suc m)].loop (Ki.K (suc m)))
          (Maps[E.KP.K (suc m), E.KP.pt (suc m), E.P (suc m), E.pP (suc m)].loop (E.eps (suc m)))
          =< transH (apH (\ X -> ptcomp OA oa OB ob OZ oz X (Maps[E.KP.K (suc m), E.KP.pt (suc m), E.P (suc m), E.pP (suc m)].loop (E.eps (suc m)))) (Ki.loopK m))
                    (apH (ptcomp OA oa OB ob OZ oz (Ki.conj m Fi)) (E.loop-eps m)) >
        ptcomp OA oa OB ob OZ oz (ptcomp OA oa Y0 y0 OB ob P eBi) (ptcomp OB ob Z0 z0 OZ oz Q psi)
          =< ptcomp-assoc OA oa Y0 y0 OB ob OZ oz P eBi (ptcomp OB ob Z0 z0 OZ oz Q psi) >
        ptcomp OA oa Y0 y0 OZ oz P (ptcomp Y0 y0 OB ob OZ oz eBi (ptcomp OB ob Z0 z0 OZ oz Q psi))
          =< apH (ptcomp OA oa Y0 y0 OZ oz P) (symH (ptcomp-assoc Y0 y0 OB ob Z0 z0 OZ oz eBi Q psi)) >
        ptcomp OA oa Y0 y0 OZ oz P (ptcomp Y0 y0 Z0 z0 OZ oz (ptcomp Y0 y0 OB ob Z0 z0 eBi Q) psi)
          =< apH (\ X -> ptcomp OA oa Y0 y0 OZ oz P (ptcomp Y0 y0 Z0 z0 OZ oz X psi)) s5 >
        ptcomp OA oa Y0 y0 OZ oz P (ptcomp Y0 y0 Z0 z0 OZ oz Fe psi)
          =< symH (ptcomp-assoc OA oa Y0 y0 Z0 z0 OZ oz P Fe psi) >
        ptcomp OA oa Z0 z0 OZ oz (ptcomp OA oa Y0 y0 Z0 z0 P Fe) psi
          =< apH (\ X -> ptcomp OA oa Z0 z0 OZ oz X psi) s9 >
        ptcomp OA oa Z0 z0 OZ oz (ptcomp OA oa X0 x0 Z0 z0 eA (diag m)) psi
          =< symH loop-diag > LD0 } ;
    next : Claim (suc m) =
      unique-loop1 m (KA.K (suc m)) (KA.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) (KA.conn m) (tPd m)
        (ptcomp (KA.K (suc m)) (KA.pt (suc m)) (E.KP.K (suc m)) (E.KP.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) (Ki.K (suc m)) (E.eps (suc m)))
        dg chain ;
  } ;
  claim : (m : Nat) -> Claim m = split {
    zero -> claim0 ;
    suc m | r -> DStep[m, r].next } ;
} ;
