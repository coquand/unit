-- Eckmann-Hilton: 2-loops commute, so π₁ of a loop space, and of any type
-- pointed equivalent to one, is abelian (used for the naturality of δ: maps
-- equal up to a pointwise homotopy induce conjugate, hence equal, maps on
-- π₁).
--   interchange: for a : p = p', b : q = q' (paths of loops),
--     ap (- . q) a . ap (p' . -) b = ap (p . -) b . ap (- . q') a   (J on a);
--   at p = q = refl: ap (- . refl) a = a (trans by J on its second path:
--   - . refl is the identity), ap (refl . -) b = b (conjugate by
--   trans-refl-l refl = refl).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Fibres[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module LC = LoopConj[l] ;

module EH (Z : U l) (z0 : Z) {
  O : U l = Id Z z0 z0 ;
  comp (p q : O) : O = trans Z z0 z0 z0 p q ;
  interchange (p : O) (q q' : O) (b : Id O q q') : (p' : O) (a : Id O p p') ->
    Id (Id O (comp p q) (comp p' q'))
      (trans O (comp p q) (comp p' q) (comp p' q') (ap O O (\ x -> comp x q) p p' a) (ap O O (comp p') q q' b))
      (trans O (comp p q) (comp p q') (comp p' q') (ap O O (comp p) q q' b) (ap O O (\ x -> comp x q') p p' a)) =
    \ p' a -> idJ O p (\ p1 a1 -> Id (Id O (comp p q) (comp p1 q'))
        (trans O (comp p q) (comp p1 q) (comp p1 q') (ap O O (\ x -> comp x q) p p1 a1) (ap O O (comp p1) q q' b))
        (trans O (comp p q) (comp p q') (comp p1 q') (ap O O (comp p) q q' b) (ap O O (\ x -> comp x q') p p1 a1)))
      (trans-refl-l O (comp p q) (comp p q') (ap O O (comp p) q q' b)) p' a ;
  -- whiskering by refl
  whisk-r (a : Id O (refl z0) (refl z0)) : Id (Id O (refl z0) (refl z0)) (ap O O (\ x -> comp x (refl z0)) (refl z0) (refl z0) a) a =
    ap-id O (refl z0) (refl z0) a ;
  whisk-l (b : Id O (refl z0) (refl z0)) : Id (Id O (refl z0) (refl z0)) (ap O O (comp (refl z0)) (refl z0) (refl z0) b) b =
    transH (LC.ap-homotopy O O (\ x -> x) (comp (refl z0)) (\ x -> symH (trans-refl-l Z z0 z0 x)) (refl z0) (refl z0) b)
      (transH (trans-refl-l O (refl z0) (refl z0) (trans O (refl z0) (refl z0) (refl z0) (ap O O (\ x -> x) (refl z0) (refl z0) b) (refl (refl z0))))
              (ap-id O (refl z0) (refl z0) b)) ;
  -- 2-loops commute
  eh (a b : Id O (refl z0) (refl z0)) : Id (Id O (refl z0) (refl z0)) (trans O (refl z0) (refl z0) (refl z0) a b) (trans O (refl z0) (refl z0) (refl z0) b a) = calc (Id O (refl z0) (refl z0)) {
    trans O (refl z0) (refl z0) (refl z0) a b
      =< symH (transH (apH (\ x -> trans O (refl z0) (refl z0) (refl z0) x (ap O O (comp (refl z0)) (refl z0) (refl z0) b)) (whisk-r a))
                      (apH (trans O (refl z0) (refl z0) (refl z0) a) (whisk-l b))) >
    trans O (refl z0) (refl z0) (refl z0) (ap O O (\ x -> comp x (refl z0)) (refl z0) (refl z0) a) (ap O O (comp (refl z0)) (refl z0) (refl z0) b)
      =< interchange (refl z0) (refl z0) (refl z0) b (refl z0) a >
    trans O (refl z0) (refl z0) (refl z0) (ap O O (comp (refl z0)) (refl z0) (refl z0) b) (ap O O (\ x -> comp x (refl z0)) (refl z0) (refl z0) a)
      =< transH (apH (\ x -> trans O (refl z0) (refl z0) (refl z0) x (ap O O (\ x1 -> comp x1 (refl z0)) (refl z0) (refl z0) a)) (whisk-l b))
                (apH (trans O (refl z0) (refl z0) (refl z0) b) (whisk-r a)) >
    trans O (refl z0) (refl z0) (refl z0) b a } ;
} ;

-- π₁ of a type pointed equivalent to a loop space is abelian
module Abelian (Z : U l) (z0 : Z) (Y : U l) (y0 : Y) (e : PtEquiv (Id Z z0 z0) (refl z0) Y y0) {
  module E = EH[Z, z0] ;
  module PY = PiOne[l].PiOne[Y, y0] ;
  module I = PiOne[l].Induced[Id Z z0 z0, refl z0, Y, y0, e.1] ;
  einv : PtMap Y y0 (Id Z z0 z0) (refl z0) = (pt-inv (Id Z z0 z0) (refl z0) Y y0 e).1 ;
  -- every loop of Y is loop e of a 2-loop
  back (q : PY.O) : Id PY.O (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q)) q =
    transH (symH (Puppe[l].pt-happly PY.O (refl y0) PY.O (refl y0)
                    (Maps[Y, y0, Y, y0].loop (ptcomp Y y0 (Id Z z0 z0) (refl z0) Y y0 einv e.1))
                    (ptcomp PY.O (refl y0) (Id (Id Z z0 z0) (refl z0) (refl z0)) (refl (refl z0)) PY.O (refl y0) (Maps[Y, y0, Id Z z0 z0, refl z0].loop einv) (I.MF.loop e.1))
                    (loop-comp Y y0 (Id Z z0 z0) (refl z0) Y y0 einv e.1) q))
      (transH (apH (\ H -> (Maps[Y, y0, Y, y0].loop H).1 q) (pt-inv-r (Id Z z0 z0) (refl z0) Y y0 e)) (Puppe[l].loop-id Y y0 q)) ;
  -- loops of Y commute up to a path
  comm (q r : PY.O) : Id PY.O (PY.comp q r) (PY.comp r q) = calc PY.O {
    PY.comp q r =< symH (transH (apH (\ a -> PY.comp a (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r))) (back q)) (apH (PY.comp q) (back r))) >
    PY.comp (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q)) (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r))
      =< symH (I.loop-mult ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q) ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r)) >
    I.L (I.PY.comp ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q) ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r))
      =< apH I.L (E.eh ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q) ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r)) >
    I.L (I.PY.comp ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r) ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q))
      =< I.loop-mult ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r) ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q) >
    PY.comp (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 r)) (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q))
      =< transH (apH (\ a -> PY.comp a (I.L ((Maps[Y, y0, Id Z z0 z0, refl z0].loop einv).1 q))) (back r)) (apH (PY.comp r) (back q)) >
    PY.comp r q } ;
  -- conjugation is trivial on π₁
  conj-cls (c u : PY.O) : Id PY.grp.G (PY.cls (LC.conj Y y0 y0 c u)) (PY.cls u) =
    apH PY.cls (calc PY.O {
      LC.conj Y y0 y0 c u =< apH (PY.comp (PY.rev c)) (comm u c) > PY.comp (PY.rev c) (PY.comp c u)
        =< trans-cancel Y y0 y0 y0 c u > u }) ;
} ;
