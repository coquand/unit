-- The base case of CCA Thm 3.3.2 (A): H⁰(X, B) = Ȟ⁰(X, Y, B), naturally,
-- as groups (Lemma B.0.1 with the group structures).
--   H⁰(X, B) = π₁(P₁(B)), P₁(B) = (x : X) -> K(B x, 1); psi 0 : Ω P₁ ~ P₀ =
--   (x : X) -> B x is multiplicative (Eps.psi0-mult); a constant family a
--   is the 0-cocycle t |-> a x (zeta, its differential a x - a x by
--   definition).  Phi0 [w] = [zeta (psi w)].
--   Injective: [zeta a] = [zeta a'] means zeta a - zeta a' = 0 (Ȟ⁰ = Z⁰), so
--   a x = a' x at any point of the merely inhabited Y x; psi is an
--   equivalence.  Onto: every 0-cocycle is zeta of its value (CechZero).
--   Natural in h: psi commutes with the products of K(h) (PiLoop at m = 0).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ; open FinChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module Eq = Equivalences[l] ;
module Cc = Cochains[l] ;
module CG = CechGroups[l] ;

module Degree0 (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (B : X -> Ab) {
  module EB = Eps[l].Eps[X, B] ;
  module PO = PiOne[l].PiOne[EB.P (suc zero), EB.pP (suc zero)] ;
  module CB = CG.CechGrp[X, Y, B] ;
  module Q0 = CB.H[zero].Q ;
  module CZ = CechZero[l].CechZero[X, Y, hY, B] ;
  H0 : Group[l].Grp = PO.grp ;
  -- the constant cocycle of a family
  const (a : EB.P zero) : (CB.Ch-ab (suc zero)).A = \ x t -> a x ;
  zeta (a : EB.P zero) : CB.Z[zero].K.ab.A = (const a,
    FL.funext X (\ x -> Cc.Cochains[B x, Y x].C (suc (suc zero))) ((CB.dhom (suc zero)).1 (const a)) (CB.Ch-ab (suc (suc zero))).o (\ x ->
      FL.funext (Cc.Cochains[B x, Y x].Tup (suc (suc zero))) (\ t -> (B x).A) ((CB.dhom (suc zero)).1 (const a) x) ((CB.Ch-ab (suc (suc zero))).o x)
        (\ s -> Cc.AbSub[B x].sub-self (a x)))) ;
  zeta-add (a b : EB.P zero) : Id CB.Z[zero].K.ab.A (zeta (\ x -> (B x).add (a x) (b x))) (CB.Z[zero].K.ab.add (zeta a) (zeta b)) =
    CB.Z[zero].K.eqA (zeta (\ x -> (B x).add (a x) (b x))) (CB.Z[zero].K.ab.add (zeta a) (zeta b)) (refl (\ x t -> (B x).add (a x) (b x))) ;
  f (w : PO.O) : Q0.QG.grp.G = Q0.QG.cl (zeta (EB.psi-fun zero w)) ;
  module D = PO.P.Q.Descend[Q0.QG.grp.G, Q0.QG.grp.setG, f,
    \ w w' r -> TC.rec (Id PO.O w w') @l (Id Q0.QG.grp.G (f w) (f w')) (Q0.QG.grp.setG (f w) (f w')) (apH f) r] ;
  phi0 (x : H0.G) : Q0.QG.grp.G = D.map x ;
  phi0-cl (w : PO.O) : Id Q0.QG.grp.G (phi0 (PO.cls w)) (f w) = D.beta w ;
  hom : QGrp[l].GHom H0 Q0.QG.grp = (phi0, \ x y ->
    PO.P.Q.induction @l (\ x1 -> Id Q0.QG.grp.G (phi0 (H0.mul x1 y)) (Q0.QG.grp.mul (phi0 x1) (phi0 y))) (\ x1 -> Q0.QG.grp.setG (phi0 (H0.mul x1 y)) (Q0.QG.grp.mul (phi0 x1) (phi0 y))) (\ u ->
    PO.P.Q.induction @l (\ y1 -> Id Q0.QG.grp.G (phi0 (H0.mul (PO.cls u) y1)) (Q0.QG.grp.mul (phi0 (PO.cls u)) (phi0 y1))) (\ y1 -> Q0.QG.grp.setG (phi0 (H0.mul (PO.cls u) y1)) (Q0.QG.grp.mul (phi0 (PO.cls u)) (phi0 y1))) (\ v -> calc Q0.QG.grp.G {
      phi0 (H0.mul (PO.cls u) (PO.cls v)) =< apH phi0 (PO.P.cls-mul u v) > phi0 (PO.cls (PO.comp u v))
        =< phi0-cl (PO.comp u v) > Q0.QG.cl (zeta (EB.psi-fun zero (PO.comp u v)))
        =< apH (\ a -> Q0.QG.cl (zeta a)) (EB.psi0-mult u v) > Q0.QG.cl (zeta (\ x -> (B x).add (EB.psi-fun zero u x) (EB.psi-fun zero v x)))
        =< apH Q0.QG.cl (zeta-add (EB.psi-fun zero u) (EB.psi-fun zero v)) > Q0.QG.cl (CB.Z[zero].K.ab.add (zeta (EB.psi-fun zero u)) (zeta (EB.psi-fun zero v)))
        =< symH (Q0.QG.cl-mul (zeta (EB.psi-fun zero u)) (zeta (EB.psi-fun zero v))) > Q0.QG.grp.mul (f u) (f v)
        =< symH (transH (apH (\ a -> Q0.QG.grp.mul a (phi0 (PO.cls v))) (phi0-cl u)) (apH (Q0.QG.grp.mul (f u)) (phi0-cl v))) >
      Q0.QG.grp.mul (phi0 (PO.cls u)) (phi0 (PO.cls v)) }) y) x) ;
  -- injective
  module Inj (w w' : PO.O) (h : Id Q0.QG.grp.G (f w) (f w')) {
    a : EB.P zero = EB.psi-fun zero w ;
    a' : EB.P zero = EB.psi-fun zero w' ;
    zero-diff : Id (CB.Ch-ab (suc zero)).A (Q0.AA.AS.sub (zeta a) (zeta a')).1 (CB.Ch-ab (suc zero)).o =
      Q0.QG.cl-eff (zeta a) (zeta a') h ;
    pt (x : X) (y : Y x) : Id (B x).A (a x) (a' x) =
      symH (Cc.AbSub[B x].sub-zero (a x) (a' x)
        (happly (Cc.Cochains[B x, Y x].Tup (suc zero)) (\ t -> (B x).A) ((Q0.AA.AS.sub (zeta a) (zeta a')).1 x) ((CB.Ch-ab (suc zero)).o x)
           (happly X (\ x1 -> Cc.Cochains[B x1, Y x1].C (suc zero)) (Q0.AA.AS.sub (zeta a) (zeta a')).1 (CB.Ch-ab (suc zero)).o zero-diff x) (\ i -> y))) ;
    eq : Id (EB.P zero) a a' = FL.funext X (\ x -> (B x).A) a a' (\ x ->
      TC.rec (Y x) @l (Id (B x).A (a x) (a' x)) ((B x).setA (a x) (a' x)) (pt x) (hY x)) ;
    loops : Id PO.O w w' = Eq.injective PO.O (EB.P zero) (EB.psi-fun zero) (EB.psi zero).2 w w' eq ;
  } ;
  injective : Bj.Injective phi0 = \ x x' ->
    PO.P.Q.induction @l (\ x1 -> Id Q0.QG.grp.G (phi0 x1) (phi0 x') -> Id H0.G x1 x')
      (\ x1 -> FL.isProp-Pi (Id Q0.QG.grp.G (phi0 x1) (phi0 x')) (\ e -> Id H0.G x1 x') (\ e -> PO.P.Q.set x1 x')) (\ w ->
    PO.P.Q.induction @l (\ x2 -> Id Q0.QG.grp.G (phi0 (PO.cls w)) (phi0 x2) -> Id H0.G (PO.cls w) x2)
      (\ x2 -> FL.isProp-Pi (Id Q0.QG.grp.G (phi0 (PO.cls w)) (phi0 x2)) (\ e -> Id H0.G (PO.cls w) x2) (\ e -> PO.P.Q.set (PO.cls w) x2)) (\ w' e ->
      apH PO.cls (Inj[w, w', transH (symH (phi0-cl w)) (transH e (phi0-cl w'))].loops)) x') x ;
  -- onto
  module Onto (u : CB.Z[zero].K.ab.A) {
    u0 : CZ.Z0 = (u.1, \ x s -> happly (Cc.Cochains[B x, Y x].Tup (suc (suc zero))) (\ t -> (B x).A) ((CB.dhom (suc zero)).1 u.1 x) ((CB.Ch-ab (suc (suc zero))).o x)
      (happly X (\ x1 -> Cc.Cochains[B x1, Y x1].C (suc (suc zero))) ((CB.dhom (suc zero)).1 u.1) (CB.Ch-ab (suc (suc zero))).o u.2 x) s) ;
    a : EB.P zero = CZ.to u0 ;
    w : PO.O = (EB.psi zero).2.sec a ;
    hit : Id Q0.QG.grp.G (phi0 (PO.cls w)) (Q0.QG.cl u) = calc Q0.QG.grp.G {
      phi0 (PO.cls w) =< phi0-cl w > Q0.QG.cl (zeta (EB.psi-fun zero w))
        =< apH (\ b -> Q0.QG.cl (zeta b)) ((EB.psi zero).2.sec-eq a) > Q0.QG.cl (zeta a)
        =< Q0.QG.cl-eq (zeta a) u (CB.Z[zero].K.eqA (zeta a) u (apH (\ z -> z.1) (CZ.from-to u0))) > Q0.QG.cl u } ;
  } ;
  onto (z : Q0.QG.grp.G) : Tr.Trunc[Bj.Fibre phi0 z].carrier =
    Q0.QG.ind @l (\ z1 -> Tr.Trunc[Bj.Fibre phi0 z1].carrier) (\ z1 -> Tr.Trunc[Bj.Fibre phi0 z1].proposition)
      (\ u -> Tr.Trunc[Bj.Fibre phi0 (Q0.QG.cl u)].inc (PO.cls Onto[u].w, Onto[u].hit)) z ;
} ;

-- naturality: Phi0' o h_* = h_* o Phi0
module Natural0 (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (B B' : X -> Ab) (h : (x : X) -> Hom (B x) (B' x)) {
  module S = Degree0[X, Y, hY, B] ;
  module T = Degree0[X, Y, hY, B'] ;
  module PL = PiPt[l].PiLoop[X, B, B', h, zero] ;
  module HM = PiOne[l].Induced[S.EB.P (suc zero), S.EB.pP (suc zero), T.EB.P (suc zero), T.EB.pP (suc zero), PL.F] ;
  module CM = CG.CechMap[X, Y, B, B', h] ;
  natural (x : S.H0.G) : Id T.Q0.QG.grp.G (T.phi0 (HM.map x)) ((CM.hstar zero).1 (S.phi0 x)) =
    S.PO.P.Q.induction @l (\ x1 -> Id T.Q0.QG.grp.G (T.phi0 (HM.map x1)) ((CM.hstar zero).1 (S.phi0 x1)))
      (\ x1 -> T.Q0.QG.grp.setG (T.phi0 (HM.map x1)) ((CM.hstar zero).1 (S.phi0 x1))) (\ w -> calc T.Q0.QG.grp.G {
      T.phi0 (HM.map (S.PO.cls w)) =< apH T.phi0 (HM.map-cls w) > T.phi0 (T.PO.cls (HM.L w))
        =< T.phi0-cl (HM.L w) > T.Q0.QG.cl (T.zeta (T.EB.psi-fun zero (HM.L w)))
        =< apH (\ b -> T.Q0.QG.cl (T.zeta b)) (PL.pi-loop w) > T.Q0.QG.cl (T.zeta (PL.G.1 (S.EB.psi-fun zero w)))
        =< T.Q0.QG.cl-eq (T.zeta (PL.G.1 (S.EB.psi-fun zero w))) (CM.Zmap zero (S.zeta (S.EB.psi-fun zero w)))
             (T.CB.Z[zero].K.eqA (T.zeta (PL.G.1 (S.EB.psi-fun zero w))) (CM.Zmap zero (S.zeta (S.EB.psi-fun zero w)))
                (refl (\ x1 t -> (h x1).1 (S.EB.psi-fun zero w x1)))) >
      T.Q0.QG.cl (CM.Zmap zero (S.zeta (S.EB.psi-fun zero w)))
        =< symH (CM.Mq[zero].map-cl (S.zeta (S.EB.psi-fun zero w))) > (CM.hstar zero).1 (S.Q0.QG.cl (S.zeta (S.EB.psi-fun zero w)))
        =< apH (CM.hstar zero).1 (symH (S.phi0-cl w)) > (CM.hstar zero).1 (S.phi0 (S.PO.cls w)) }) x ;
} ;
