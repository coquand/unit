-- Lifts through a fibre are unique when pointed maps into the base form a set.
-- For f : (X, x0) ->pt (Y, y0) and pointed M1, M2 : Z -> Fib f with equal
-- projections (e : M1 ; fpr = M2 ; fpr), if PtMap Z Y is a set then
--     M1 z = M2 z      for every z.
-- Each M gives the null-homotopy N M : (M ; fpr) ; f = const, z |-> (M z).2
-- (the pointing: (M z0).2 = ap f (ap fst M0) . f0, J on M0).  Moving N M1
-- along e gives a second null-homotopy of (M1 ; fpr) ; f, equal to N M1
-- (a set); evaluating at z, (M1 z).2 = ap f (G z) . (M2 z).2 with G z the
-- value of e at z, which is the path M1 z = M2 z in Fib f.
-- (Used for maps between K(A, m) and K(B, m), m >= 1: Lemma4.cor5-map.)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Fibres[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Gp = Groupoid[l] ;

-- the first component of a Sigma-path
sigma-path-fst (A : U l) (B : A -> U l) (a : A) (b : B a) : (a' : A) (b' : B a') (p : Id A a a') (q : Id (B a') (subst A B a a' p b) b') ->
  Id (Id A a a') (ap ((x : A) * B x) A (\ w -> w.1) (a, b) (a', b') (Sigma-path A B a a' b b' p q)) p =
  \ a' b' p q -> idJ A a (\ a1 p1 -> (b1 : B a1) (q1 : Id (B a1) (subst A B a a1 p1 b) b1) ->
      Id (Id A a a1) (ap ((x : A) * B x) A (\ w -> w.1) (a, b) (a1, b1) (Sigma-path A B a a1 b b1 p1 q1)) p1)
    (\ b1 q1 -> idJ (B a) b (\ b2 q2 -> Id (Id A a a) (ap ((x : A) * B x) A (\ w -> w.1) (a, b) (a, b2) (Sigma-path A B a a b b2 (refl a) q2)) (refl a))
       (refl (refl a)) b1 q1) a' p b' q ;

module LiftUnique (Z : U l) (z0 : Z) (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0)
  (sY : isSet (PtMap Z z0 Y y0))
  (M1 M2 : PtMap Z z0 (Fib X x0 Y y0 f) (fpt X x0 Y y0 f))
  (e : Id (PtMap Z z0 X x0) (ptcomp Z z0 (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) X x0 M1 (fpr X x0 Y y0 f))
                            (ptcomp Z z0 (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) X x0 M2 (fpr X x0 Y y0 f))) {
  F : U l = Fib X x0 Y y0 f ;
  -- the value of a path of pointed maps at z
  at-z (P Q : PtMap Z z0 Y y0) (r : Id (PtMap Z z0 Y y0) P Q) (z : Z) : Id Y (P.1 z) (Q.1 z) =
    happly Z (\ z1 -> Y) P.1 Q.1 (ap (PtMap Z z0 Y y0) (Z -> Y) (\ R -> R.1) P Q r) z ;
  -- the pointing of a point of the fibre
  pt-snd (w : F) (p : Id F w (fpt X x0 Y y0 f)) :
    Id (Id Y (f.1 w.1) y0) (trans Y (f.1 w.1) (f.1 x0) y0 (ap X Y f.1 w.1 x0 (ap F X (\ v -> v.1) w (fpt X x0 Y y0 f) p)) f.2) w.2 =
    idJR F (fpt X x0 Y y0 f) (\ w1 p1 -> Id (Id Y (f.1 w1.1) y0) (trans Y (f.1 w1.1) (f.1 x0) y0 (ap X Y f.1 w1.1 x0 (ap F X (\ v -> v.1) w1 (fpt X x0 Y y0 f) p1)) f.2) w1.2)
      (trans-refl-l Y (f.1 x0) y0 f.2) w p ;
  module N (M : PtMap Z z0 F (fpt X x0 Y y0 f)) {
    g : PtMap Z z0 X x0 = ptcomp Z z0 F (fpt X x0 Y y0 f) X x0 M (fpr X x0 Y y0 f) ;
    H (z : Z) : Id Y (f.1 (g.1 z)) y0 = (M.1 z).2 ;
    P : Id (Z -> Y) (\ z -> f.1 (g.1 z)) (\ z -> y0) = FL.funext Z (\ z -> Y) (\ z -> f.1 (g.1 z)) (\ z -> y0) H ;
    q : Id (Id Y y0 y0) (subst (Z -> Y) (\ k -> Id Y (k z0) y0) (\ z -> f.1 (g.1 z)) (\ z -> y0) P (ptcomp Z z0 X x0 Y y0 g f).2) (refl y0) =
      calc (Id Y y0 y0) {
      subst (Z -> Y) (\ k -> Id Y (k z0) y0) (\ z -> f.1 (g.1 z)) (\ z -> y0) P (ptcomp Z z0 X x0 Y y0 g f).2
        =< subst-pt Z z0 Y y0 (\ z -> f.1 (g.1 z)) (\ z -> y0) P (ptcomp Z z0 X x0 Y y0 g f).2 >
      trans Y y0 (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) y0 (happly Z (\ z -> Y) (\ z -> f.1 (g.1 z)) (\ z -> y0) P z0)) (ptcomp Z z0 X x0 Y y0 g f).2
        =< apH (\ a -> trans Y y0 (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) y0 a) (ptcomp Z z0 X x0 Y y0 g f).2)
             (happly Z (\ z -> Id Y (f.1 (g.1 z)) y0) _ _ (FL.happly-funext Z (\ z -> Y) (\ z -> f.1 (g.1 z)) (\ z -> y0) H) z0) >
      trans Y y0 (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) y0 (H z0)) (ptcomp Z z0 X x0 Y y0 g f).2
        =< apH (trans Y y0 (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) y0 (H z0))) (pt-snd (M.1 z0) M.2) >
      trans Y y0 (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) y0 (H z0)) (H z0)
        =< trans-sym-l Y (f.1 (g.1 z0)) y0 (H z0) > refl y0 } ;
    null : Id (PtMap Z z0 Y y0) (ptcomp Z z0 X x0 Y y0 g f) (ptconst Z z0 Y y0) =
      Sigma-path (Z -> Y) (\ k -> Id Y (k z0) y0) (\ z -> f.1 (g.1 z)) (\ z -> y0) (ptcomp Z z0 X x0 Y y0 g f).2 (refl y0) P q ;
    null-at (z : Z) : Id (Id Y (f.1 (g.1 z)) y0) (at-z (ptcomp Z z0 X x0 Y y0 g f) (ptconst Z z0 Y y0) null z) (M.1 z).2 =
      transH (apH (\ P -> happly Z (\ z1 -> Y) (\ z1 -> f.1 (g.1 z1)) (\ z1 -> y0) P z)
                (sigma-path-fst (Z -> Y) (\ k -> Id Y (k z0) y0) (\ z1 -> f.1 (g.1 z1)) (ptcomp Z z0 X x0 Y y0 g f).2 (\ z1 -> y0) (refl y0) P q))
        (happly Z (\ z1 -> Id Y (f.1 (g.1 z1)) y0) _ _ (FL.happly-funext Z (\ z1 -> Y) (\ z1 -> f.1 (g.1 z1)) (\ z1 -> y0) (\ z1 -> (M.1 z1).2)) z) ;
  } ;
  -- post-composing a path of pointed maps with f, at z
  comp-at (P Q : PtMap Z z0 X x0) (r : Id (PtMap Z z0 X x0) P Q) (z : Z) :
    Id (Id Y (f.1 (P.1 z)) (f.1 (Q.1 z))) (at-z (ptcomp Z z0 X x0 Y y0 P f) (ptcomp Z z0 X x0 Y y0 Q f) (apH (\ R -> ptcomp Z z0 X x0 Y y0 R f) r) z)
      (ap X Y f.1 (P.1 z) (Q.1 z) (happly Z (\ z1 -> X) P.1 Q.1 (ap (PtMap Z z0 X x0) (Z -> X) (\ R -> R.1) P Q r) z)) =
    idJ (PtMap Z z0 X x0) P (\ Q1 r1 -> Id (Id Y (f.1 (P.1 z)) (f.1 (Q1.1 z)))
        (at-z (ptcomp Z z0 X x0 Y y0 P f) (ptcomp Z z0 X x0 Y y0 Q1 f) (apH (\ R -> ptcomp Z z0 X x0 Y y0 R f) r1) z)
        (ap X Y f.1 (P.1 z) (Q1.1 z) (happly Z (\ z1 -> X) P.1 Q1.1 (ap (PtMap Z z0 X x0) (Z -> X) (\ R -> R.1) P Q1 r1) z)))
      (refl (refl (f.1 (P.1 z)))) Q r ;
  -- values along a composite path
  at-trans (P Q R : PtMap Z z0 Y y0) (r : Id (PtMap Z z0 Y y0) P Q) (s : Id (PtMap Z z0 Y y0) Q R) (z : Z) :
    Id (Id Y (P.1 z) (R.1 z)) (at-z P R (trans (PtMap Z z0 Y y0) P Q R r s) z) (trans Y (P.1 z) (Q.1 z) (R.1 z) (at-z P Q r z) (at-z Q R s z)) =
    idJ (PtMap Z z0 Y y0) Q (\ R1 s1 -> Id (Id Y (P.1 z) (R1.1 z)) (at-z P R1 (trans (PtMap Z z0 Y y0) P Q R1 r s1) z)
        (trans Y (P.1 z) (Q.1 z) (R1.1 z) (at-z P Q r z) (at-z Q R1 s1 z)))
      (refl (at-z P Q r z)) R s ;
  module N1 = N[M1] ;
  module N2 = N[M2] ;
  moved : Id (PtMap Z z0 Y y0) (ptcomp Z z0 X x0 Y y0 N1.g f) (ptconst Z z0 Y y0) =
    trans (PtMap Z z0 Y y0) (ptcomp Z z0 X x0 Y y0 N1.g f) (ptcomp Z z0 X x0 Y y0 N2.g f) (ptconst Z z0 Y y0)
      (apH (\ R -> ptcomp Z z0 X x0 Y y0 R f) e) N2.null ;
  same : Id (Id (PtMap Z z0 Y y0) (ptcomp Z z0 X x0 Y y0 N1.g f) (ptconst Z z0 Y y0)) N1.null moved =
    sY (ptcomp Z z0 X x0 Y y0 N1.g f) (ptconst Z z0 Y y0) N1.null moved ;
  G (z : Z) : Id X (M1.1 z).1 (M2.1 z).1 = happly Z (\ z1 -> X) N1.g.1 N2.g.1 (ap (PtMap Z z0 X x0) (Z -> X) (\ R -> R.1) N1.g N2.g e) z ;
  -- (M1 z).2 = ap f (G z) . (M2 z).2
  snd-eq (z : Z) : Id (Id Y (f.1 (M1.1 z).1) y0) (M1.1 z).2 (trans Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0 (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z)) (M2.1 z).2) =
    calc (Id Y (f.1 (M1.1 z).1) y0) {
    (M1.1 z).2 =< symH (N1.null-at z) > at-z (ptcomp Z z0 X x0 Y y0 N1.g f) (ptconst Z z0 Y y0) N1.null z
      =< apH (\ P -> at-z (ptcomp Z z0 X x0 Y y0 N1.g f) (ptconst Z z0 Y y0) P z) same > at-z (ptcomp Z z0 X x0 Y y0 N1.g f) (ptconst Z z0 Y y0) moved z
      =< at-trans (ptcomp Z z0 X x0 Y y0 N1.g f) (ptcomp Z z0 X x0 Y y0 N2.g f) (ptconst Z z0 Y y0) (apH (\ R -> ptcomp Z z0 X x0 Y y0 R f) e) N2.null z >
    trans Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0
      (at-z (ptcomp Z z0 X x0 Y y0 N1.g f) (ptcomp Z z0 X x0 Y y0 N2.g f) (apH (\ R -> ptcomp Z z0 X x0 Y y0 R f) e) z)
      (at-z (ptcomp Z z0 X x0 Y y0 N2.g f) (ptconst Z z0 Y y0) N2.null z)
      =< transH (apH (\ a -> trans Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0 a (at-z (ptcomp Z z0 X x0 Y y0 N2.g f) (ptconst Z z0 Y y0) N2.null z))
                  (comp-at N1.g N2.g e z))
           (apH (trans Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0 (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z))) (N2.null-at z)) >
    trans Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0 (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z)) (M2.1 z).2 } ;
  result (z : Z) : Id F (M1.1 z) (M2.1 z) =
    Sigma-path X (\ x -> Id Y (f.1 x) y0) (M1.1 z).1 (M2.1 z).1 (M1.1 z).2 (M2.1 z).2 (G z) (calc (Id Y (f.1 (M2.1 z).1) y0) {
      subst X (\ x -> Id Y (f.1 x) y0) (M1.1 z).1 (M2.1 z).1 (G z) (M1.1 z).2
        =< Gp.transport-fib X Y f.1 y0 (M1.1 z).1 (M2.1 z).1 (G z) (M1.1 z).2 >
      trans Y (f.1 (M2.1 z).1) (f.1 (M1.1 z).1) y0 (sym Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z))) (M1.1 z).2
        =< apH (trans Y (f.1 (M2.1 z).1) (f.1 (M1.1 z).1) y0 (sym Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z)))) (snd-eq z) >
      trans Y (f.1 (M2.1 z).1) (f.1 (M1.1 z).1) y0 (sym Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z)))
        (trans Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0 (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z)) (M2.1 z).2)
        =< trans-cancel Y (f.1 (M1.1 z).1) (f.1 (M2.1 z).1) y0 (ap X Y f.1 (M1.1 z).1 (M2.1 z).1 (G z)) (M2.1 z).2 > (M2.1 z).2 }) ;
} ;
