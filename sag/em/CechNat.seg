-- The Čech connecting homomorphism is natural (CCA Lemma B.0.5, "natural in
-- the short exact sequence"): for a map (hA, hB, hC) of short exact
-- sequences of families (i' hA = hB i, p' hB = hC p),
--     δ' o hC_* = hA_* o δ      on Ȟⁿ(X, Y, C).
-- On a cocycle u with lift F: hB o F is a lift of hC o u, and
-- i' (hA o b) = hB o (i o b) = hB o dF = d (hB o F), so the cocycle it
-- gives is hA o b (i' injective).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module Cc = Cochains[l] ;
module CG = CechGroups[l] ;

module CechNat (X : U l) (Y : X -> U l)
  (Ga Gb Gc : X -> Ab) (i : (x : X) -> Hom (Ga x) (Gb x)) (p : (x : X) -> Hom (Gb x) (Gc x))
  (inj : (x : X) -> Bj.Injective (i x).1)
  (pi0 : (x : X) (a : (Ga x).A) -> Id (Gc x).A ((p x).1 ((i x).1 a)) (Gc x).o)
  (ex : (x : X) (b : (Gb x).A) -> Id (Gc x).A ((p x).1 b) (Gc x).o -> Tr.Trunc[Bj.Fibre (i x).1 b].carrier)
  (lifts : (k : Nat) (phi : Cc.Cech[X, Y, Gc].Ch (suc k)) -> Tr.Trunc[(Phi : Cc.Cech[X, Y, Gb].Ch (suc k)) *
     ((x : X) (t : Cc.Cochains[Gb x, Y x].Tup (suc k)) -> Id (Gc x).A ((p x).1 (Phi x t)) (phi x t))].carrier)
  (Ga' Gb' Gc' : X -> Ab) (i' : (x : X) -> Hom (Ga' x) (Gb' x)) (p' : (x : X) -> Hom (Gb' x) (Gc' x))
  (inj' : (x : X) -> Bj.Injective (i' x).1)
  (pi0' : (x : X) (a : (Ga' x).A) -> Id (Gc' x).A ((p' x).1 ((i' x).1 a)) (Gc' x).o)
  (ex' : (x : X) (b : (Gb' x).A) -> Id (Gc' x).A ((p' x).1 b) (Gc' x).o -> Tr.Trunc[Bj.Fibre (i' x).1 b].carrier)
  (lifts' : (k : Nat) (phi : Cc.Cech[X, Y, Gc'].Ch (suc k)) -> Tr.Trunc[(Phi : Cc.Cech[X, Y, Gb'].Ch (suc k)) *
     ((x : X) (t : Cc.Cochains[Gb' x, Y x].Tup (suc k)) -> Id (Gc' x).A ((p' x).1 (Phi x t)) (phi x t))].carrier)
  (hA : (x : X) -> Hom (Ga x) (Ga' x)) (hB : (x : X) -> Hom (Gb x) (Gb' x)) (hC : (x : X) -> Hom (Gc x) (Gc' x))
  (sqi : (x : X) (a : (Ga x).A) -> Id (Gb' x).A ((i' x).1 ((hA x).1 a)) ((hB x).1 ((i x).1 a)))
  (sqp : (x : X) (b : (Gb x).A) -> Id (Gc' x).A ((p' x).1 ((hB x).1 b)) ((hC x).1 ((p x).1 b)))
  (n : Nat) {
  module L1 = CechLES[l].CechLES[X, Y, Ga, Gb, Gc, i, p, inj, pi0, ex, lifts, n] ;
  module L2 = CechLES[l].CechLES[X, Y, Ga', Gb', Gc', i', p', inj', pi0', ex', lifts', n] ;
  module MA = CG.CechMap[X, Y, Ga, Ga', hA] ;
  module MB = CG.CechMap[X, Y, Gb, Gb', hB] ;
  module MC = CG.CechMap[X, Y, Gc, Gc', hC] ;
  -- pointwise squares, on whole cochains
  sq-i (j : Nat) (a : (L1.GA.Ch-ab j).A) : Id ((L2.GB.Ch-ab j).A) ((L2.MI.M j).1 ((MA.M j).1 a)) ((MB.M j).1 ((L1.MI.M j).1 a)) =
    FL.funext X (\ x -> Cc.Cochains[Gb' x, Y x].C j) ((L2.MI.M j).1 ((MA.M j).1 a)) ((MB.M j).1 ((L1.MI.M j).1 a)) (\ x ->
      FL.funext (Cc.Cochains[Gb' x, Y x].Tup j) (\ t -> (Gb' x).A) ((L2.MI.M j).1 ((MA.M j).1 a) x) ((MB.M j).1 ((L1.MI.M j).1 a) x) (\ t -> sqi x (a x t))) ;
  sq-p (j : Nat) (b : (L1.GB.Ch-ab j).A) : Id ((L2.GC.Ch-ab j).A) ((L2.MP.M j).1 ((MB.M j).1 b)) ((MC.M j).1 ((L1.MP.M j).1 b)) =
    FL.funext X (\ x -> Cc.Cochains[Gc' x, Y x].C j) ((L2.MP.M j).1 ((MB.M j).1 b)) ((MC.M j).1 ((L1.MP.M j).1 b)) (\ x ->
      FL.funext (Cc.Cochains[Gc' x, Y x].Tup j) (\ t -> (Gc' x).A) ((L2.MP.M j).1 ((MB.M j).1 b) x) ((MC.M j).1 ((L1.MP.M j).1 b) x) (\ t -> sqp x (b x t))) ;
  -- the image of a lift is a lift
  module At (u : L1.S.ZC.ab.A) (F : L1.S.Lift u) {
    u' : L2.S.ZC.ab.A = MC.Zmap n u ;
    F' : L2.S.Lift u' = ((MB.M (suc n)).1 F.1, transH (sq-p (suc n) F.1) (apH (MC.M (suc n)).1 F.2)) ;
    module B1 = L1.S.FromLift[u, F] ;
    module B2 = L2.S.FromLift[u', F'] ;
    beta : Id ((L2.GA.Ch-ab (suc (suc n))).A) B2.beta ((MA.M (suc (suc n))).1 B1.beta) =
      L2.inj-ch (suc (suc n)) B2.beta ((MA.M (suc (suc n))).1 B1.beta) (calc ((L2.GB.Ch-ab (suc (suc n))).A) {
        (L2.MI.M (suc (suc n))).1 B2.beta =< B2.fib.2 > (L2.GB.dhom (suc n)).1 ((MB.M (suc n)).1 F.1)
          =< MB.sq (suc n) F.1 > (MB.M (suc (suc n))).1 ((L1.GB.dhom (suc n)).1 F.1)
          =< apH (MB.M (suc (suc n))).1 (symH B1.fib.2) > (MB.M (suc (suc n))).1 ((L1.MI.M (suc (suc n))).1 B1.beta)
          =< symH (sq-i (suc (suc n)) B1.beta) > (L2.MI.M (suc (suc n))).1 ((MA.M (suc (suc n))).1 B1.beta) }) ;
    z-eq : Id L2.S.ZA.ab.A B2.z (MA.Zmap (suc n) B1.z) = L2.S.ZA.eqA B2.z (MA.Zmap (suc n) B1.z) beta ;
    natural : Id (L2.GA.H[suc n].Q.QG.grp).G (L2.S.delta0 u') ((MA.hstar (suc n)).1 (L1.S.delta0 u)) = calc (L2.GA.H[suc n].Q.QG.grp).G {
      L2.S.delta0 u' =< L2.S.D[u'].value-at F' > L2.S.HA.QG.cl B2.z
        =< L2.S.HA.QG.cl-eq B2.z (MA.Zmap (suc n) B1.z) z-eq > L2.S.HA.QG.cl (MA.Zmap (suc n) B1.z)
        =< symH (MA.Mq[suc n].map-cl B1.z) > (MA.hstar (suc n)).1 (L1.S.HA.QG.cl B1.z)
        =< apH (MA.hstar (suc n)).1 (symH (L1.S.D[u].value-at F)) > (MA.hstar (suc n)).1 (L1.S.delta0 u) } ;
  } ;
  -- δ' o hC_* = hA_* o δ
  natural (y : (L1.GC.H[n].Q.QG.grp).G) :
    Id (L2.GA.H[suc n].Q.QG.grp).G (L2.delta.1 ((MC.hstar n).1 y)) ((MA.hstar (suc n)).1 (L1.delta.1 y)) =
    L1.GC.H[n].Q.QG.ind @l (\ y1 -> Id (L2.GA.H[suc n].Q.QG.grp).G (L2.delta.1 ((MC.hstar n).1 y1)) ((MA.hstar (suc n)).1 (L1.delta.1 y1)))
      (\ y1 -> (L2.GA.H[suc n].Q.QG.grp).setG (L2.delta.1 ((MC.hstar n).1 y1)) ((MA.hstar (suc n)).1 (L1.delta.1 y1))) (\ u ->
      TC.rec (L1.S.Lift u) @l (Id (L2.GA.H[suc n].Q.QG.grp).G (L2.delta.1 ((MC.hstar n).1 (L1.GC.H[n].Q.QG.cl u))) ((MA.hstar (suc n)).1 (L1.delta.1 (L1.GC.H[n].Q.QG.cl u))))
        ((L2.GA.H[suc n].Q.QG.grp).setG (L2.delta.1 ((MC.hstar n).1 (L1.GC.H[n].Q.QG.cl u))) ((MA.hstar (suc n)).1 (L1.delta.1 (L1.GC.H[n].Q.QG.cl u))))
        (\ F -> calc (L2.GA.H[suc n].Q.QG.grp).G {
          L2.delta.1 ((MC.hstar n).1 (L1.GC.H[n].Q.QG.cl u)) =< apH L2.delta.1 (MC.Mq[n].map-cl u) > L2.delta.1 (L2.GC.H[n].Q.QG.cl (MC.Zmap n u))
            =< L2.OQ.delta-cls (MC.Zmap n u) > L2.S.delta0 (MC.Zmap n u)
            =< At[u, F].natural > (MA.hstar (suc n)).1 (L1.S.delta0 u)
            =< apH (MA.hstar (suc n)).1 (symH (L1.OQ.delta-cls u)) > (MA.hstar (suc n)).1 (L1.delta.1 (L1.GC.H[n].Q.QG.cl u)) })
        (L1.lift-ch n u.1)) y ;
} ;
