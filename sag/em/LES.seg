-- The long exact cohomology sequence in the degrees used by CCA Lemma B.0.4:
-- for a family over X of short exact sequences 0 -> A x -> E x -> L x -> 0
-- and n : Nat,
--     Hⁿ(X, E) -p*-> Hⁿ(X, L) -δ-> Hⁿ⁺¹(X, A)
-- is exact, and δ is onto when Hⁿ⁺¹(X, E) = 0.
--
-- Groups.  Hⁿ(X, B) is π₁(Pₙ₊₁(B)), Pₘ(B) = (x : X) -> K(B x, m) (it is
--   ||Pₙ(B)||₀ through psi : Ω Pₙ₊₁ ~ Pₙ, Eps); maps are π₁ of pointed
--   maps (PiOne.Induced), so they are homomorphisms.
-- The boundary.  At m = n+2: Pₘ(A) ~ Fib (Pₘ(p)) over Pₘ(i) (G: the
--   pointwise fibre sequences FibSeq.SES.fibre, and PiPt.pi-fib), and
--     D = psi^-1 ; dd ; G^-1 : Pₙ₊₁(L) -> Ω Pₘ(L) -> Fib (Pₘ p) -> Pₘ(A),
--   dd the boundary of Puppe; δ = π₁ D.
-- δ onto.  Pₙ₊₁(L) ~ Fib (Pₘ(i)) over D (psi^-1, Puppe 1 for Pₘ(p),
--   fib-equiv along G), so by GEX every loop of Pₘ(A) killed by Pₘ(i) is
--   loop D of a loop; when Pₙ₊₁(E) is 0-connected every loop of Pₘ(E) is
--   merely refl (psi).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ; open Torsor[l] ; open Puppe[l] ; open Connected[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Eq = Equivalences[l] ;
module Bj = Bijection[l] ;
module Gp = Groupoid[l] ;
module LC = LoopConj[l] ;

-- if Phi ; a = b ; e with Phi, e pointed equivalences, then Phi^-1 ; b = a ; e^-1
swap-inv (U0 : U l) (u0 : U0) (V0 : U l) (v0 : V0) (W0 : U l) (w0 : W0) (Z0 : U l) (z0 : Z0)
  (P : PtEquiv U0 u0 V0 v0) (e : PtEquiv W0 w0 Z0 z0) (a : PtMap V0 v0 Z0 z0) (b : PtMap U0 u0 W0 w0)
  (sq : Id (PtMap U0 u0 Z0 z0) (ptcomp U0 u0 V0 v0 Z0 z0 P.1 a) (ptcomp U0 u0 W0 w0 Z0 z0 b e.1)) :
  Id (PtMap V0 v0 W0 w0) (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b) (ptcomp V0 v0 Z0 z0 W0 w0 a (pt-inv W0 w0 Z0 z0 e).1) = calc (PtMap V0 v0 W0 w0) {
  ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b
    =< symH (ptcomp-idr V0 v0 W0 w0 (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b)) >
  ptcomp V0 v0 W0 w0 W0 w0 (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b) (ptid W0 w0)
    =< symH (apH (ptcomp V0 v0 W0 w0 W0 w0 (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b)) (pt-inv-l W0 w0 Z0 z0 e)) >
  ptcomp V0 v0 W0 w0 W0 w0 (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b) (ptcomp W0 w0 Z0 z0 W0 w0 e.1 (pt-inv W0 w0 Z0 z0 e).1)
    =< symH (ptcomp-assoc V0 v0 W0 w0 Z0 z0 W0 w0 (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b) e.1 (pt-inv W0 w0 Z0 z0 e).1) >
  ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 W0 w0 Z0 z0 (ptcomp V0 v0 U0 u0 W0 w0 (pt-inv U0 u0 V0 v0 P).1 b) e.1) (pt-inv W0 w0 Z0 z0 e).1
    =< apH (\ F -> ptcomp V0 v0 Z0 z0 W0 w0 F (pt-inv W0 w0 Z0 z0 e).1) (ptcomp-assoc V0 v0 U0 u0 W0 w0 Z0 z0 (pt-inv U0 u0 V0 v0 P).1 b e.1) >
  ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 U0 u0 Z0 z0 (pt-inv U0 u0 V0 v0 P).1 (ptcomp U0 u0 W0 w0 Z0 z0 b e.1)) (pt-inv W0 w0 Z0 z0 e).1
    =< apH (\ F -> ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 U0 u0 Z0 z0 (pt-inv U0 u0 V0 v0 P).1 F) (pt-inv W0 w0 Z0 z0 e).1) (symH sq) >
  ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 U0 u0 Z0 z0 (pt-inv U0 u0 V0 v0 P).1 (ptcomp U0 u0 V0 v0 Z0 z0 P.1 a)) (pt-inv W0 w0 Z0 z0 e).1
    =< apH (\ F -> ptcomp V0 v0 Z0 z0 W0 w0 F (pt-inv W0 w0 Z0 z0 e).1) (symH (ptcomp-assoc V0 v0 U0 u0 V0 v0 Z0 z0 (pt-inv U0 u0 V0 v0 P).1 P.1 a)) >
  ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 V0 v0 Z0 z0 (ptcomp V0 v0 U0 u0 V0 v0 (pt-inv U0 u0 V0 v0 P).1 P.1) a) (pt-inv W0 w0 Z0 z0 e).1
    =< apH (\ F -> ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 V0 v0 Z0 z0 F a) (pt-inv W0 w0 Z0 z0 e).1) (pt-inv-r U0 u0 V0 v0 P) >
  ptcomp V0 v0 Z0 z0 W0 w0 (ptcomp V0 v0 V0 v0 Z0 z0 (ptid V0 v0) a) (pt-inv W0 w0 Z0 z0 e).1
    =< apH (\ F -> ptcomp V0 v0 Z0 z0 W0 w0 F (pt-inv W0 w0 Z0 z0 e).1) (ptcomp-idl V0 v0 Z0 z0 a) >
  ptcomp V0 v0 Z0 z0 W0 w0 a (pt-inv W0 w0 Z0 z0 e).1 } ;

module LES (X : U l) (Ga Gb Gc : X -> Ab) (i : (x : X) -> Hom (Ga x) (Gb x)) (p : (x : X) -> Hom (Gb x) (Gc x))
  (inj : (x : X) -> Bj.Injective (i x).1)
  (pi0 : (x : X) (a : (Ga x).A) -> Id (Gc x).A ((p x).1 ((i x).1 a)) (Gc x).o)
  (ex : (x : X) (b : (Gb x).A) -> Id (Gc x).A ((p x).1 b) (Gc x).o -> Tr.Trunc[Bj.Fibre (i x).1 b].carrier)
  (sur : (x : X) (c : (Gc x).A) -> Tr.Trunc[Bj.Fibre (p x).1 c].carrier) (n : Nat) {
  module EA = Eps[l].Eps[X, Ga] ;
  module EB = Eps[l].Eps[X, Gb] ;
  module EC = Eps[l].Eps[X, Gc] ;
  module SX (x : X) { module F = FibSeq[l].SES[Ga x, Gb x, Gc x, i x, p x, inj x, pi0 x, ex x, sur x] ; } ;
  -- the product maps
  Pi (m : Nat) : PtMap (EA.P m) (EA.pP m) (EB.P m) (EB.pP m) =
    PiPt[l].Pi[X].PiMap (\ x -> EA.KA[x].K.K m) (\ x -> EB.KA[x].K.K m) (EA.pP m) (EB.pP m) (\ x -> SX[x].F.Ki.K m) ;
  Pp (m : Nat) : PtMap (EB.P m) (EB.pP m) (EC.P m) (EC.pP m) =
    PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K m) (\ x -> EC.KA[x].K.K m) (EB.pP m) (EC.pP m) (\ x -> SX[x].F.Kp.K m) ;

  -- Pₘ(A) ~ Fib (Pₘ(p)) over Pₘ(i), at m = n+2
  module PF = PiPt[l].Pi[X].PiFib[\ x -> EB.KA[x].K.K (suc (suc n)), \ x -> EC.KA[x].K.K (suc (suc n)), EB.pP (suc (suc n)), EC.pP (suc (suc n)), \ x -> SX[x].F.Kp.K (suc (suc n))] ;
  lift (x : X) : PtMap (EA.KA[x].K.K (suc (suc n))) (EA.KA[x].K.pt (suc (suc n))) ((Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) ((fpt ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) = SX[x].F.Cmp[(suc (suc n))].L.lift ;
  Glift : PtMap (EA.P (suc (suc n))) (EA.pP (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) =
    PiPt[l].Pi[X].PiMap (\ x -> EA.KA[x].K.K (suc (suc n))) (\ xq -> Fib ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (EA.pP (suc (suc n))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) lift ;
  G : PtEquiv (EA.P (suc (suc n))) (EA.pP (suc (suc n))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (fpt (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) =
    (ptcomp (EA.P (suc (suc n))) (EA.pP (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (fpt (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) Glift PF.pi-fib.1,
     (Eq.compose (EA.P (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n)))))
        (Glift.1, PiEquiv[l].pi-equiv X (\ x -> EA.KA[x].K.K (suc (suc n))) (\ xq -> Fib ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (\ x -> (lift x).1) (\ x -> SX[x].F.fibre (suc (suc n))))
        (PF.pi-fib.1.1, PF.pi-fib.2)).2) ;
  Gover : Id (PtMap (EA.P (suc (suc n))) (EA.pP (suc (suc n))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))))
    (ptcomp (EA.P (suc (suc n))) (EA.pP (suc (suc n))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (fpt (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) G.1 (fpr (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (Pp (suc (suc n))))) (Pi (suc (suc n))) =
    calc (PtMap (EA.P (suc (suc n))) (EA.pP (suc (suc n))) (EB.P (suc (suc n))) (EB.pP (suc (suc n)))) {
    ptcomp (EA.P (suc (suc n))) (EA.pP (suc (suc n))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (fpt (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) G.1 (fpr (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (Pp (suc (suc n))))
      =< ptcomp-assoc (EA.P (suc (suc n))) (EA.pP (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (fpt (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) Glift PF.pi-fib.1
           (fpr (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (Pp (suc (suc n)))) >
    ptcomp (EA.P (suc (suc n))) (EA.pP (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) Glift
      (ptcomp ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (Fib (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (fpt (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (PiPt[l].Pi[X].PiMap (\ x -> EB.KA[x].K.K (suc (suc n))) (\ x -> EC.KA[x].K.K (suc (suc n))) (EB.pP (suc (suc n))) (EC.pP (suc (suc n))) (\ x -> SX[x].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) PF.pi-fib.1 (fpr (EB.P (suc (suc n))) (EB.pP (suc (suc n))) (EC.P (suc (suc n))) (EC.pP (suc (suc n))) (Pp (suc (suc n)))))
      =< apH (ptcomp (EA.P (suc (suc n))) (EA.pP (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) Glift) PF.pi-fib-over >
    ptcomp (EA.P (suc (suc n))) (EA.pP (suc (suc n))) ((x : X) -> (Fib ((EB.KA[x].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) x) ((EC.KA[x].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) x) ((SX[x].F.Kp.K (suc (suc n)))))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (EB.P (suc (suc n))) (EB.pP (suc (suc n))) Glift
      (PiPt[l].Pi[X].PiMap (\ xq -> Fib ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (\ x -> EB.KA[x].K.K (suc (suc n))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (EB.pP (suc (suc n))) (\ x -> fpr (EB.KA[x].K.K (suc (suc n))) (EB.KA[x].K.pt (suc (suc n))) (EC.KA[x].K.K (suc (suc n))) (EC.KA[x].K.pt (suc (suc n))) (SX[x].F.Kp.K (suc (suc n)))))
      =< symH (PiPt[l].Pi[X].pi-comp (\ x -> EA.KA[x].K.K (suc (suc n))) (\ xq -> Fib ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (\ x -> EB.KA[x].K.K (suc (suc n))) (EA.pP (suc (suc n))) (\ xq -> fpt ((EB.KA[xq].K.K (suc (suc n)))) ((EB.pP (suc (suc n))) xq) ((EC.KA[xq].K.K (suc (suc n)))) ((EC.pP (suc (suc n))) xq) ((SX[xq].F.Kp.K (suc (suc n))))) (EB.pP (suc (suc n))) lift
