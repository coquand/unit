-- A product of equivalences is an equivalence.
level l ;
open Base ; open Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

pi-equiv (X : U l) (A B : X -> U l) (f : (x : X) -> A x -> B x) (e : (x : X) -> isEquiv (A x) (B x) (f x)) :
  isEquiv ((x : X) -> A x) ((x : X) -> B x) (\ a x -> f x (a x)) =
  qinv ((x : X) -> A x) ((x : X) -> B x) (\ a x -> f x (a x)) (\ b x -> (e x).sec (b x))
    (\ b -> F.funext X B (\ x -> f x ((e x).sec (b x))) b (\ x -> (e x).sec-eq (b x)))
    (\ a -> F.funext X A (\ x -> (e x).sec (f x (a x))) a (\ x -> sec-ret (A x) (B x) (f x) (e x) (a x))) ;
