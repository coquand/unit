-- DW1 §2: the type T X of X-torsors, Lemma 3, Corollaries 6-8, and the
-- existence half of Theorem 2, with the levels of T X.
--
-- Definition 1, small (DW1 footnote 1): the underlying type of a torsor
-- ranges over BAut X, the image of the point X in U (replacement,
-- Completion.Complete), with inclusion el : BAut X -> U:
--     T X = (k : BAut X) * ||el k|| * ((y : el k) -> X ~pt (el k, y)).
-- Pointed torsors, regrouped:  PT = (k : BAut X) * PP (el k),
--     PP Y = ||Y|| * ((y : Y) -> X ~pt (Y, y)) * Y.
--
-- Lemma 3, in the form used (levels): if the pointed sections
--     PtSec X x0 (x |-> X ~pt (X, x)) id
-- are (t-2)-truncated, so is PT.  Proof, as in DW1 but with retracts:
--  - large version PTL = (Y : U) * PP Y: drop ||Y|| (implied by the
--    point) and add the singleton (p, mu y = p): PTL is a retract of
--        (w : (Z : U) * (z : Z) * X ~pt (Z, z)) * Fam w,
--        Fam (Z, z, p) = (mu : (y : Z) -> X ~pt (Z, y)) * (mu z = p);
--    the base is contractible (pointed univalence, PtEquiv.pt-univ), and
--    the fibre at the centre (X, x0, id) is by definition the pointed
--    sections above.
--  - PT from PTL: PT is a retract (by definition) of
--        (u : PTL) * ((k : BAut X) * el k = u.1),
--    whose second factor is contractible: a proposition since el is an
--    embedding, inhabited by k0 since X ~ u.1 (any mu y).
-- Corollary 6: X (c)-connected and (2c+t+2)-truncated (indices: isConn
-- (c+2), isTrunc ((c+1)+((c+1)+t))): Lemma 4 for the family
-- x |-> X ~pt (X, x), which is (c+t+1)-truncated by Corollary 5 (ii).
-- Corollary 7 (t = 0): PT is contractible.  Corollary 8 (t = 1): PT is a
-- proposition, merely inhabited if T X is, so contractible.
--
-- Theorem 2 (existence): if PT is contractible, with centre (ptT, y0),
-- then by the fundamental theorem of identity types for t |-> el t,
-- (ptT = t) ~ el t by transport of y0; hence
--     Omega (T X, ptT) ~pt (el ptT, y0) ~pt (X, x0)
-- (the second is mu_ptT (y0) inverted).  Moreover T X is 0-connected
-- (a torsor merely has a point, hence merely equals ptT), so its identity
-- types are all merely Omega (T X, ptT); so T X is (c)-connected and
-- (n-1)-truncated when X is (c-1)-connected and (n-2)-truncated.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module P1 = Prelude[l+] ; module H1 = HLevels[l+] ; module TU = TruncUp[l] ;
module N = NatArith[l] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;

-- connectedness along an equivalence (univalence)
equiv-conn (n : Nat) (A B : U l) (e : Equiv A B) (c : isConn n B) : isConn n A =
  P1.subst (U l) (\ Z -> isConn n Z) B A (P1.sym (U l) A B (UL.ua A B e)) c ;

module Torsors (X : U l) (x0 : X) {
  module BA = Completion[l].Complete[Top, \ u -> X] ;
  BAut : U l = BA.base ;
  el (k : BAut) : U l = BA.extension k ;
  k0 : BAut = BA.quotient tt ;
  el0 : Id (U l) (el k0) X = BA.triangle tt ;

  -- Definition 1
  Mu (Y : U l) : U l = (y : Y) -> PtEquiv X x0 Y y ;
  Tor : U l = (k : BAut) * Tr.Trunc[el k].carrier * Mu (el k) ;
  tor-inh (t : Tor) : Tr.Trunc[el t.1].carrier = t.2.1 ;
  tor-mu (t : Tor) : Mu (el t.1) = t.2.2 ;

  -- a homogeneous structure on X is a torsor (with underlying type X,
  -- moved into BAut X along el k0 = X)
  homog (mu : Mu X) : Tor =
    (k0, P1.subst (U l) (\ Z -> Tr.Trunc[Z].carrier * Mu Z) X (el k0) (P1.sym (U l) (el k0) X el0)
           (Tr.Trunc[X].inc x0, mu)) ;

  -- pointed torsors
  PP (Y : U l) : U l = Tr.Trunc[Y].carrier * Mu Y * Y ;
  PT : U l = (k : BAut) * PP (el k) ;
  PTL : U l+ = (Y : U l) * PP Y ;

  ----------------------------------------------------------------------
  -- Lemma 3 (large version)

  Fam (w : PtUniv X x0) : U l = (mu : Mu w.1) * Id (PtEquiv X x0 w.1 w.2.1) (mu w.2.1) w.2.2 ;
  -- by definition, at the centre of PtUniv
  fam-centre : Id (U l) (Fam (X, x0, idPt X x0)) (PtSec X x0 (\ x -> PtEquiv X x0 X x) (idPt X x0)) =
    refl (PtSec X x0 (\ x -> PtEquiv X x0 X x) (idPt X x0)) ;
  Big : U l+ = (w : PtUniv X x0) * Fam w ;
  l3-s (u : PTL) : Big = ((u.1, u.2.2.2, u.2.2.1 u.2.2.2), (u.2.2.1, refl (u.2.2.1 u.2.2.2))) ;
  l3-r (v : Big) : PTL = (v.1.1, Tr.Trunc[v.1.1].inc v.1.2.1, v.2.1, v.1.2.1) ;
  l3-rs (u : PTL) : Id PTL (l3-r (l3-s u)) u =
    P1.ap Tr.Trunc[u.1].carrier PTL (\ h -> (u.1, h, u.2.2.1, u.2.2.2)) (Tr.Trunc[u.1].inc u.2.2.2) u.2.1
      (Tr.Trunc[u.1].proposition (Tr.Trunc[u.1].inc u.2.2.2) u.2.1) ;
  lemma3-large (t : Nat) (h : isTrunc t (PtSec X x0 (\ x -> PtEquiv X x0 X x) (idPt X x0))) : H1.isTrunc t PTL =
    H1.retract-trunc t PTL Big l3-s l3-r l3-rs
      (H1.trunc-Sigma-contr t (PtUniv X x0) (\ w -> Fam w) (pt-univ X x0) (TU.trunc-up t (Fam (X, x0, idPt X x0)) h)) ;

  ----------------------------------------------------------------------
  -- from the large to the small pointed torsors

  Fib (Y : U l) : U l+ = (k : BAut) * Id (U l) (el k) Y ;
  fib-prop (Y : U l) : P1.isProp (Fib Y) =
    Groupoid[l+].emb-fib-prop BAut (U l) el (\ a b -> BA.Identity[a, b].embedding) Y ;
  fib-contr (Y : U l) (pp : PP Y) : FunExtUA[l+].isContr (Fib Y) =
    ((k0, P1.trans (U l) (el k0) X Y el0 (UL.ua X Y Acc[X, x0, Y, pp.2.2, pp.2.1 pp.2.2].equiv)),
     \ w -> fib-prop Y (k0, P1.trans (U l) (el k0) X Y el0 (UL.ua X Y Acc[X, x0, Y, pp.2.2, pp.2.1 pp.2.2].equiv)) w) ;
  S2 : U l+ = (u : PTL) * Fib u.1 ;
  sm-s (v : PT) : S2 = ((el v.1, v.2), (v.1, refl (el v.1))) ;
  sm-r (w : S2) : PT = (w.2.1, P1.subst (U l) (\ Y -> PP Y) w.1.1 (el w.2.1) (P1.sym (U l) (el w.2.1) w.1.1 w.2.2) w.1.2) ;
  sm-rs (v : PT) : Id PT (sm-r (sm-s v)) v = refl v ;
  small (t : Nat) (h : H1.isTrunc t PTL) : isTrunc t PT =
    TU.trunc-down t PT (H1.retract-trunc t PT S2 sm-s sm-r sm-rs
      (H1.trunc-Sigma t PTL (\ u -> Fib u.1) h (\ u -> H1.contr-trunc t (Fib u.1) (fib-contr u.1 u.2)))) ;

  -- Lemma 3
  lemma3 (t : Nat) (h : isTrunc t (PtSec X x0 (\ x -> PtEquiv X x0 X x) (idPt X x0))) : isTrunc t PT =
    small t (lemma3-large t h) ;

  ----------------------------------------------------------------------
  -- Corollaries 6, 7, 8

  cor6 (c t : Nat) (cX : isConn (suc (suc c)) X) (tX : isTrunc (N.plus (suc c) (N.plus (suc c) t)) X) : isTrunc t PT =
    lemma3 t (lemma4 t (suc c) X x0 cX (\ x -> PtEquiv X x0 X x)
      (\ x -> cor5-equiv (N.plus c t) (suc c) X x0 cX X x tX) (idPt X x0)) ;

  cor7 (c : Nat) (cX : isConn (suc (suc c)) X) (tX : isTrunc (N.plus (suc c) (N.plus (suc c) zero)) X) : isContr PT =
    cor6 c zero cX tX ;

  cor8 (c : Nat) (cX : isConn (suc (suc c)) X) (tX : isTrunc (N.plus (suc c) (N.plus (suc c) (suc zero))) X)
    (inh : Tr.Trunc[Tor].carrier) : isContr PT =
    Tr.Trunc[Tor].induction @l (\ v -> isContr PT) (\ v -> Torsor[l].isProp-isContr PT)
      (\ t0 -> Tr.Trunc[el t0.1].induction @l (\ v -> isContr PT) (\ v -> Torsor[l].isProp-isContr PT)
         (\ y -> ((t0.1, tor-inh t0, tor-mu t0, y), \ v ->
                   trunc-one-prop PT (cor6 c (suc zero) cX tX) (t0.1, tor-inh t0, tor-mu t0, y) v))
         (tor-inh t0))
      inh ;

  ----------------------------------------------------------------------
  -- Theorem 2 (existence of the delooping)

  module Deloop (pc : isContr PT) {
    ck : BAut = pc.1.1 ;
    cmu : Mu (el ck) = pc.1.2.2.1 ;
    cy : el ck = pc.1.2.2.2 ;
    ptT : Tor = (ck, pc.1.2.1, cmu) ;

    TotT : U l = (t : Tor) * el t.1 ;
    tot-s (w : TotT) : PT = (w.1.1, w.1.2.1, w.1.2.2, w.2) ;
    tot-r (v : PT) : TotT = ((v.1, v.2.1, v.2.2.1), v.2.2.2) ;
    tot-contr : isContr TotT = retract-contr TotT PT tot-s tot-r (\ w -> refl w) pc ;

    module F = FundThm[l].FT[Tor, ptT, \ t -> el t.1, cy, tot-contr] ;

    loops : PtEquiv (Id Tor ptT ptT) (refl ptT) (el ck) cy = ((F.tr ptT, refl cy), F.equiv ptT) ;
    theorem2 : PtEquiv (Id Tor ptT ptT) (refl ptT) X x0 =
      pt-comp (Id Tor ptT ptT) (refl ptT) (el ck) cy X x0 loops (pt-inv X x0 (el ck) cy (cmu cy)) ;
    loop-equiv : Equiv (Id Tor ptT ptT) X = Acc[Id Tor ptT ptT, refl ptT, X, x0, theorem2].equiv ;

    -- T X is 0-connected
    from-pt (t : Tor) : Tr.Trunc[Id Tor ptT t].carrier = TC.map (el t.1) (Id Tor ptT t) (F.un t) (tor-inh t) ;
    tor-path (t t' : Tor) : Tr.Trunc[Id Tor t t'].carrier =
      TC.map2 (Id Tor ptT t) (Id Tor ptT t') (Id Tor t t') (\ p q -> trans Tor t ptT t' (sym Tor ptT t p) q)
        (from-pt t) (from-pt t') ;
    conn0 : isConn (suc (suc zero)) Tor = (Tr.Trunc[Tor].inc ptT, \ x y -> (tor-path x y, \ p q -> tt)) ;

    -- levels of T X
    tor-conn (n : Nat) (cX : isConn (suc n) X) : isConn (suc (suc n)) Tor =
      conn-from-point n Tor ptT tor-path (equiv-conn (suc n) (Id Tor ptT ptT) X loop-equiv cX) ;
    tor-trunc (n : Nat) (tX : isTrunc n X) : isTrunc (suc n) Tor =
      conn-elim2 zero Tor ptT conn0 (\ a b -> isTrunc n (Id Tor a b)) (\ a b -> trunc-prop n (Id Tor a b))
        (equiv-trunc n (Id Tor ptT ptT) X loop-equiv tX) ;
  } ;
} ;
