-- CCA Prop. 3.1.4 = Cor. A.0.7 and Cor. A.0.8 as isomorphisms of pointed
-- sets (G not necessarily abelian: Ȟ¹ and H¹ are pointed sets).
--
-- The base points: the class of the unit cocycle (y0, y1 |-> e) in
-- Ȟ¹(X, Y, G); the trivial family with its points y |-> e in H¹(X, Y, G);
-- the trivial family in H¹(X, G).
-- psi of the unit cocycle is the torsor of the g : Y -> G with
-- g y1 . e = g y0; the constant maps g |-> (y |-> g) are an equivariant map
-- from the trivial torsor G, so psi(unit) = triv (no point of Y needed).
-- So Ψ̄ sends the base point to the base point; forget does by definition.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ; open GTorsor[l] ; open CechNA[l] ;
module Tr = Truncation[l] ;
module T1 = Truncation[l+] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Pa1 = Paths[l+] ;

-- psi of the unit cocycle is the trivial torsor, for one x
module PsiUnit (Y : U l) (hY : Tr.Trunc[Y].carrier) (Gr : Grp) {
  open Gr ;
  module S = Psi[Y, hY, Gr, \ y0 y1 -> e, \ y0 y1 y2 -> unitr e] ;
  const (g : G) : S.P = (\ y -> g, \ y0 y1 -> unitr g) ;
  hom : GTor[Gr].Hom (GTor[Gr].triv) S.tor =
    (const, \ a g -> S.P-eq (const (mul a g)) (S.act a (const g)) (\ y -> refl (mul a g))) ;
  path : Id (GTor[Gr].Tor) S.tor (GTor[Gr].triv) = Pa1.symH (GTor[Gr].decode (GTor[Gr].triv) S.tor hom) ;
} ;

module CorA07Pt (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (G : X -> Grp) {
  module A = CorA07[l].CorA07[X, Y, hY, G] ;
  -- the base points
  unit : A.Cyc = (\ x y0 y1 -> (G x).e, \ x y0 y1 y2 -> (G x).unitr (G x).e) ;
  base-cech : A.Cech = A.QC.inc unit ;
  triv : A.Fam = \ x -> GTor[G x].triv ;
  triv-pointed : A.Pointed triv = Tr.Trunc[(x : X) -> Y x -> (triv x).1].inc (\ x y -> (G x).e) ;
  base-h1y : A.H1Y = A.QY.inc (triv, triv-pointed) ;
  base-h1 : A.H1 = A.QF.inc triv ;

  psi-unit : Id A.Fam (A.psi unit) triv =
    FL1.funext X (\ x -> GTor[G x].Tor) (A.psi unit) triv (\ x -> PsiUnit[Y x, hY x, G x].path) ;
  -- Cor. A.0.7 (Prop. 3.1.4) preserves the base point
  corA07-pointed : Id A.H1Y (A.corA07.1 base-cech) base-h1y =
    Pa1.transH (A.PsiBar.beta unit)
      (A.QY.relates (A.psi' unit) (triv, triv-pointed) (T1.Trunc[Id A.Fam (A.psi unit) triv].inc psi-unit)) ;
  forget-pointed : Id A.H1 (A.forget base-h1y) base-h1 = A.Forget.beta (triv, triv-pointed) ;
  -- Cor. A.0.8 preserves the base point
  corA08-pointed (hyp : CohZero ((x : X) * Y x) (\ w -> G w.1)) : Id A.H1 ((A.A08[hyp].corA08).1 base-cech) base-h1 =
    Pa1.transH (Pa1.apH A.forget corA07-pointed) forget-pointed ;
} ;
