-- Higher Čech cohomology in the vanishing form (CCA Def. 3.3.1) and the
-- Čech dimension shift used for Thm 3.3.2 in the form (C'):
--   if Ȟ^(m+1)(X, Y, B) = 0 for all m, then the same holds for L B.
-- The differential is worker A's cca/Cochains (ordered cochains,
-- delta phi (v . t) = phi t - delta (phi_v) t; a cochain of length k has
-- degree k - 1), taken fibrewise over X.
--
--   The complex and Ȟ^k = 0 are A's Cochains.Cech[X, Y, B] (Ch, d,
--                   isCocycle, Bounds, Vanish k); Ȟ^(n+1) = 0 is Vanish (suc n).
--   Natural         delta is natural in the coefficients: for a
--                   homomorphism h, delta (h o phi) = h o delta phi
--                   (induction on the length; h preserves differences).
--
-- Part (1), Cone: Ȟ^(n+1)(X, Y, B^Y) = 0 for every n (B^Y x = Y x -> B x).
--   For a cocycle phi put  psi x t = (s |-> phi x (s . t) s).  At s,
--   (delta psi t) s = delta (ev_s o phi x)_s t (Natural for ev_s), and
--   ev_s o phi x is a cocycle (Natural), so by A's cone lemma at v = s this
--   is (ev_s o phi x) t = phi x t s.
--
-- Part (3), Shift (given part (2), lifts along p : B^Y -> L, as a
--   hypothesis `Lifts`; over a Stone space it is ccacoh/LiftStone).
--   If Ȟ^(n+2)(B) = 0 then Ȟ^(n+1)(L) = 0.  Let phi be an L-cocycle of
--   length n+2, Phi a lift.  p (delta Phi) = delta phi = 0, so
--   delta Phi = i beta for a unique beta (exactness, i injective);
--   i (delta beta) = delta delta Phi = 0, so beta is a B-cocycle and
--   merely beta = delta gamma.  Phi' = Phi - i gamma is a cocycle
--   (delta Phi' = i beta - i beta), so Phi' = delta Theta by Cone, and
--   delta (p o Theta) = p Phi' = p Phi - p i gamma = phi.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ; open FinChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module Cc = Cochains[l] ;
module IG = ImageGroup[l] ;

------------------------------------------------------------------------
-- naturality of delta in the coefficients

module Natural (Y : U l) (Ga Gb : Ab) (h : Hom Ga Gb) {
  module CA = Cc.Cochains[Ga, Y] ;
  module CB = Cc.Cochains[Gb, Y] ;
  hom-sub (a b : Ga.A) : Id Gb.A (h.1 (Cc.AbSub[Ga].sub a b)) (Cc.AbSub[Gb].sub (h.1 a) (h.1 b)) =
    transH (h.2 a (Ga.inv b)) (apH (Gb.add (h.1 a)) (IG.hom-inv Ga Gb h b)) ;
  map (k : Nat) (phi : CA.C k) : CB.C k = \ t -> h.1 (phi t) ;
  natural : (k : Nat) (phi : CA.C k) (s : CA.Tup (suc k)) -> Id Gb.A (CB.delta k (map k phi) s) (h.1 (CA.delta k phi s)) = split {
    zero -> \ phi s -> refl (h.1 (phi (CA.tail zero s))) ;
    suc k | r -> \ phi s -> calc Gb.A {
      CB.delta (suc k) (map (suc k) phi) s
        =< apH (Cc.AbSub[Gb].sub (h.1 (phi (CA.tail (suc k) s)))) (r (CA.at k (s none) phi) (CA.tail (suc k) s)) >
      Cc.AbSub[Gb].sub (h.1 (phi (CA.tail (suc k) s))) (h.1 (CA.delta k (CA.at k (s none) phi) (CA.tail (suc k) s)))
        =< symH (hom-sub (phi (CA.tail (suc k) s)) (CA.delta k (CA.at k (s none) phi) (CA.tail (suc k) s))) >
      h.1 (CA.delta (suc k) phi s) } } ;
} ;

------------------------------------------------------------------------
-- the short exact sequences 0 -> B -> B^Y -> L -> 0 over X

module Shift (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (B : X -> Ab) {
  module IX (x : X) { module C2 = IG.Cech[Y x, hY x, B x] ; } ;
  AS (x : X) : Ab = IX[x].C2.AT ;
  L (x : X) : Ab = IX[x].C2.L ;
  i (x : X) : Hom (B x) (AS x) = IX[x].C2.i ;
  p (x : X) : Hom (AS x) (L x) = IX[x].C2.p ;
  module CB = Cc.Cech[X, Y, B] ;
  module CS = Cc.Cech[X, Y, AS] ;
  module CL = Cc.Cech[X, Y, L] ;
  module Ni (x : X) { module M = Natural[Y x, B x, AS x, i x] ; } ;
  module Np (x : X) { module M = Natural[Y x, AS x, L x, p x] ; } ;

  -- Part (1): Ȟ^(n+1)(X, Y, B^Y) = 0
  ev (x : X) (s : Y x) : Hom (AS x) (B x) = (\ f -> f s, \ f g -> refl ((B x).add (f s) (g s))) ;
  module Ne (x : X) (s : Y x) { module M = Natural[Y x, AS x, B x, ev x s] ; } ;
  contract (k : Nat) (phi : CS.Ch (suc k)) : CS.Ch k = \ x t s -> phi x (Cc.Cochains[AS x, Y x].cons k s t) s ;
  -- ev_s o phi x is a cocycle at (s . t)
  ev-cocycle (k : Nat) (phi : CS.Ch (suc k)) (c : CS.isCocycle k phi) (x : X) (s : Y x) (t : Cc.Cochains[AS x, Y x].Tup (suc k)) :
    Id (B x).A (Cc.Cochains[B x, Y x].delta (suc k) (Ne[x, s].M.map (suc k) (phi x)) (Cc.Cochains[AS x, Y x].cons (suc k) s t)) (B x).o =
    transH (Ne[x, s].M.natural (suc k) (phi x) (Cc.Cochains[AS x, Y x].cons (suc k) s t)) (apH (\ f -> f s) (c x (Cc.Cochains[AS x, Y x].cons (suc k) s t))) ;
  cone-at (k : Nat) (phi : CS.Ch (suc k)) (c : CS.isCocycle k phi) (x : X) (t : Cc.Cochains[AS x, Y x].Tup (suc k)) (s : Y x) :
    Id (B x).A (CS.d k (contract k phi) x t s) (phi x t s) =
    transH (symH (Ne[x, s].M.natural k (contract k phi x) t))
      (Cc.Cochains[B x, Y x].cone k s (Ne[x, s].M.map (suc k) (phi x)) t (ev-cocycle k phi c x s t)) ;
  cone-bound (k : Nat) (phi : CS.Ch (suc k)) (c : CS.isCocycle k phi) : CS.Bounds k phi (contract k phi) = \ x t ->
    FL.funext (Y x) (\ s -> (B x).A) (CS.d k (contract k phi) x t) (phi x t) (cone-at k phi c x t) ;
  vanishS (n : Nat) : CS.Vanish (suc n) = \ phi c ->
    Tr.Trunc[(psi : CS.Ch (suc n)) * CS.Bounds (suc n) phi psi].inc (contract (suc n) phi, cone-bound (suc n) phi c) ;

  -- Part (2) as a hypothesis: L-cochains lift along p
  Lift (k : Nat) (phi : CL.Ch k) : U l = (Phi : CS.Ch k) * ((x : X) (t : Cc.Cochains[AS x, Y x].Tup k) -> Id (L x).A ((p x).1 (Phi x t)) (phi x t)) ;
  Lifts (k : Nat) : U l = (phi : CL.Ch k) -> Tr.Trunc[Lift k phi].carrier ;

  -- Part (3): the chase
  fibre-prop (x : X) (f : (AS x).A) : isProp (Bj.Fibre (i x).1 f) = \ w w' ->
    Sigma-eq (B x).A (\ a -> Id (AS x).A ((i x).1 a) f) w.1 w'.1 w.2 w'.2
      (IX[x].C2.inj w.1 w'.1 (transH w.2 (symH w'.2))) ((AS x).setA ((i x).1 w'.1) f) ;
  module Chase (n : Nat) (hyp : CB.Vanish (suc (suc n))) (phi : CL.Ch (suc (suc n))) (c : CL.isCocycle (suc n) phi)
    (w : Lift (suc (suc n)) phi) {
    Phi : CS.Ch (suc (suc n)) = w.1 ;
    -- p (delta Phi) = delta phi = 0
    pd (x : X) (s : Cc.Cochains[AS x, Y x].Tup (suc (suc (suc n)))) : Id (L x).A ((p x).1 (CS.d (suc (suc n)) Phi x s)) (L x).o =
      transH (symH (Np[x].M.natural (suc (suc n)) (Phi x) s))
        (transH (Cc.Cochains[L x, Y x].delta-cong (suc (suc n)) (Np[x].M.map (suc (suc n)) (Phi x)) (phi x) (w.2 x) s) (c x s)) ;
    -- delta Phi = i beta
    bfib (x : X) (s : Cc.Cochains[AS x, Y x].Tup (suc (suc (suc n)))) : Bj.Fibre (i x).1 (CS.d (suc (suc n)) Phi x s) =
      TC.rec (Bj.Fibre (i x).1 (CS.d (suc (suc n)) Phi x s)) @l (Bj.Fibre (i x).1 (CS.d (suc (suc n)) Phi x s))
        (fibre-prop x (CS.d (suc (suc n)) Phi x s)) (\ f -> f)
        (IX[x].C2.ex (CS.d (suc (suc n)) Phi x s) (pd x s)) ;
    beta : CB.Ch (suc (suc (suc n))) = \ x s -> (bfib x s).1 ;
    -- beta is a cocycle: i (delta beta) = delta delta Phi = 0 = i 0
    dbeta : CB.isCocycle (suc (suc n)) beta = \ x s -> IX[x].C2.inj (CB.d (suc (suc (suc n))) beta x s) (B x).o (calc (AS x).A {
      (i x).1 (CB.d (suc (suc (suc n))) beta x s)
        =< symH (Ni[x].M.natural (suc (suc (suc n))) (beta x) s) >
      Cc.Cochains[AS x, Y x].delta (suc (suc (suc n))) (Ni[x].M.map (suc (suc (suc n))) (beta x)) s
        =< Cc.Cochains[AS x, Y x].delta-cong (suc (suc (suc n))) (Ni[x].M.map (suc (suc (suc n))) (beta x)) (CS.d (suc (suc n)) Phi x) (\ t -> (bfib x t).2) s >
      Cc.Cochains[AS x, Y x].delta (suc (suc (suc n))) (CS.d (suc (suc n)) Phi x) s
        =< Cc.Cochains[AS x, Y x].delta-delta (suc (suc n)) (Phi x) s >
      (AS x).o =< symH (hom-unit (B x) (AS x) (i x)) >
      (i x).1 (B x).o }) ;
    module G (gamma : CB.Ch (suc (suc n))) (bg : CB.Bounds (suc (suc n)) beta gamma) {
      Phi' : CS.Ch (suc (suc n)) = \ x t -> Cc.AbSub[AS x].sub (Phi x t) ((i x).1 (gamma x t)) ;
      -- delta (i gamma) = i (delta gamma) = i beta = delta Phi
      dig (x : X) (s : Cc.Cochains[AS x, Y x].Tup (suc (suc (suc n)))) :
        Id (AS x).A (Cc.Cochains[AS x, Y x].delta (suc (suc n)) (Ni[x].M.map (suc (suc n)) (gamma x)) s) (CS.d (suc (suc n)) Phi x s) =
        transH (Ni[x].M.natural (suc (suc n)) (gamma x) s) (transH (apH (i x).1 (bg x s)) (bfib x s).2) ;
      cyc : CS.isCocycle (suc n) Phi' = \ x s -> calc (AS x).A {
        CS.d (suc (suc n)) Phi' x s
          =< Cc.Cochains[AS x, Y x].delta-sub (suc (suc n)) (Phi x) (Ni[x].M.map (suc (suc n)) (gamma x)) s >
        Cc.AbSub[AS x].sub (CS.d (suc (suc n)) Phi x s) (Cc.Cochains[AS x, Y x].delta (suc (suc n)) (Ni[x].M.map (suc (suc n)) (gamma x)) s)
          =< apH (Cc.AbSub[AS x].sub (CS.d (suc (suc n)) Phi x s)) (dig x s) >
        Cc.AbSub[AS x].sub (CS.d (suc (suc n)) Phi x s) (CS.d (suc (suc n)) Phi x s)
          =< Cc.AbSub[AS x].sub-self (CS.d (suc (suc n)) Phi x s) > (AS x).o } ;
      -- p o Theta bounds phi
      module T (theta : CS.Ch (suc n)) (bt : CS.Bounds (suc n) Phi' theta) {
        psi : CL.Ch (suc n) = \ x t -> (p x).1 (theta x t) ;
        bound : CL.Bounds (suc n) phi psi = \ x s -> calc (L x).A {
          CL.d (suc n) psi x s =< Np[x].M.natural (suc n) (theta x) s >
          (p x).1 (CS.d (suc n) theta x s) =< apH (p x).1 (bt x s) >
          (p x).1 (Phi' x s) =< Np[x].M.hom-sub (Phi x s) ((i x).1 (gamma x s)) >
          Cc.AbSub[L x].sub ((p x).1 (Phi x s)) ((p x).1 ((i x).1 (gamma x s)))
            =< apH (Cc.AbSub[L x].sub ((p x).1 (Phi x s))) (IX[x].C2.pi0 (gamma x s)) >
          Cc.AbSub[L x].sub ((p x).1 (Phi x s)) (L x).o =< Cc.AbSub[L x].sub-o ((p x).1 (Phi x s)) >
          (p x).1 (Phi x s) =< w.2 x s > phi x s } ;
      } ;
      result : Tr.Trunc[(psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi].carrier =
        TC.map ((theta : CS.Ch (suc n)) * CS.Bounds (suc n) Phi' theta) ((psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi)
          (\ v -> (T[v.1, v.2].psi, T[v.1, v.2].bound)) (vanishS n Phi' cyc) ;
    } ;
    result : Tr.Trunc[(psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi].carrier =
      TC.rec ((gamma : CB.Ch (suc (suc n))) * CB.Bounds (suc (suc n)) beta gamma) @l (Tr.Trunc[(psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi].carrier)
        Tr.Trunc[(psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi].proposition
        (\ v -> G[v.1, v.2].result) (hyp beta dbeta) ;
  } ;
  -- the dimension shift: Ȟ^(n+2)(B) = 0 gives Ȟ^(n+1)(L) = 0
  shift (n : Nat) (lifts : Lifts (suc (suc n))) (hyp : CB.Vanish (suc (suc n))) : CL.Vanish (suc n) = \ phi c ->
    TC.rec (Lift (suc (suc n)) phi) @l (Tr.Trunc[(psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi].carrier)
      Tr.Trunc[(psi : CL.Ch (suc n)) * CL.Bounds (suc n) phi psi].proposition
      (\ w -> Chase[n, hyp, phi, c, w].result) (lifts phi) ;
} ;

------------------------------------------------------------------------
-- Ȟ¹ = 0 in this form gives Ȟ¹ = 0 in the form of CechNA (for ab-grp B).
-- A CechNA cocycle d gives the cochain phi (y0, y1) = d y0 y1, a cocycle:
-- delta phi (v, a, b) = d a b - (d v b - d v a) = 0 (d a b + d v a = d v b).
-- If delta psi = phi, i.e. psi (y1) - psi (y0) = d y0 y1, then
-- g y = - psi (y) bounds d: - psi y1 + (psi y1 - psi y0) = - psi y0.

module H1Bridge (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (B : X -> Ab) {
  module CB = Cc.Cech[X, Y, B] ;
  module NA = CechNA[l].CechNA[X, Y, hY, \ x -> Group[l].ab-grp (B x)] ;
  -- 1-tuples are determined by their point
  one (x : X) (y : Y x) : Cc.Cochains[B x, Y x].Tup (suc zero) = \ i -> y ;
  one-pt (x : X) (t : Cc.Cochains[B x, Y x].Tup (suc zero)) : (i : Fin (suc zero)) -> Id (Y x) (t i) (t none) = split {
    none -> refl (t none) ; some e -> absurd (Id (Y x) (t (some e)) (t none)) e } ;
  one-eq (x : X) (t : Cc.Cochains[B x, Y x].Tup (suc zero)) : Id (Cc.Cochains[B x, Y x].Tup (suc zero)) t (one x (t none)) =
    FL.funext (Fin (suc zero)) (\ i -> Y x) t (one x (t none)) (one-pt x t) ;
  pair (x : X) (y0 y1 : Y x) : Cc.Cochains[B x, Y x].Tup (suc (suc zero)) = split { none -> y0 ; some j -> y1 } ;
  module Given (d : NA.C1) (c : NA.Cocycle d) {
    phi : CB.Ch (suc (suc zero)) = \ x s -> d x (s none) (s (some none)) ;
    -- (X + Z) - Z = X
    cancel (x : X) (a b : (B x).A) : Id (B x).A (Cc.AbSub[B x].sub ((B x).add a b) b) a =
      transH ((B x).assoc a b ((B x).inv b)) (transH (apH ((B x).add a) ((B x).invr b)) ((B x).unitr a)) ;
    cocycle : CB.isCocycle (suc zero) phi = \ x s -> calc (B x).A {
      CB.d (suc (suc zero)) phi x s
        =< apH (\ z -> Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none)))) (Cc.AbSub[B x].sub z (d x (s none) (s (some none)))))
             (symH (c x (s none) (s (some none)) (s (some (some none))))) >
      Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none))))
        (Cc.AbSub[B x].sub ((B x).add (d x (s (some none)) (s (some (some none)))) (d x (s none) (s (some none)))) (d x (s none) (s (some none))))
        =< apH (Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none))))) (cancel x (d x (s (some none)) (s (some (some none)))) (d x (s none) (s (some none)))) >
      Cc.AbSub[B x].sub (d x (s (some none)) (s (some (some none)))) (d x (s (some none)) (s (some (some none))))
        =< Cc.AbSub[B x].sub-self (d x (s (some none)) (s (some (some none)))) > (B x).o } ;
    module Bd (psi : CB.Ch (suc zero)) (b : CB.Bounds (suc zero) phi psi) {
      g : NA.C0 = \ x y -> (B x).inv (psi x (one x y)) ;
      -- psi (y1) - psi (y0) = d y0 y1
      diff (x : X) (y0 y1 : Y x) : Id (B x).A (Cc.AbSub[B x].sub (psi x (one x y1)) (psi x (one x y0))) (d x y0 y1) =
        transH (apH (\ t -> Cc.AbSub[B x].sub (psi x (one x y1)) (psi x t))
                  (symH (one-eq x (Cc.Cochains[B x, Y x].cons zero y0 (Cc.Cochains[B x, Y x].tail zero (Cc.Cochains[B x, Y x].tail (suc zero) (pair x y0 y1)))))))
          (b x (pair x y0 y1)) ;
      bounds : NA.Bounds d g = \ x y0 y1 -> calc (B x).A {
        (B x).add (g x y1) (d x y0 y1) =< apH ((B x).add (g x y1)) (symH (diff x y0 y1)) >
        (B x).add ((B x).inv (psi x (one x y1))) ((B x).add (psi x (one x y1)) ((B x).inv (psi x (one x y0))))
          =< symH ((B x).assoc ((B x).inv (psi x (one x y1))) (psi x (one x y1)) ((B x).inv (psi x (one x y0)))) >
        (B x).add ((B x).add ((B x).inv (psi x (one x y1))) (psi x (one x y1))) ((B x).inv (psi x (one x y0)))
          =< apH (\ z -> (B x).add z ((B x).inv (psi x (one x y0)))) (AbL[B x].invl (psi x (one x y1))) >
        (B x).add (B x).o ((B x).inv (psi x (one x y0))) =< AbL[B x].unitl ((B x).inv (psi x (one x y0))) >
        g x y0 } ;
    } ;
  } ;
  h1zero (z : CB.Vanish (suc zero)) : NA.H1Zero = \ d c ->
    TC.map ((psi : CB.Ch (suc zero)) * CB.Bounds (suc zero) (Given[d, c].phi) psi) ((g : NA.C0) * NA.Bounds d g)
      (\ w -> (Given[d, c].Bd[w.1, w.2].g, Given[d, c].Bd[w.1, w.2].bounds))
      (z (Given[d, c].phi) (Given[d, c].cocycle)) ;
} ;
