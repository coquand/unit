-- The connecting homomorphism of em/LES is natural: for a map (hA, hB, hC)
-- of families of short exact sequences (i' hA = hB i, p' hB = hC p),
--     δ' o (hC)_* = (hA)_* o δ        on Hⁿ(X, C)
-- ((h)_* = π₁ of the product of the K(h), PiPt.PiLoop.F).  This discharges
-- the hypothesis NatDelta of ccacoh/Thm332A.
--   Pointwise, δ is d_x = lift^-1 o dd o e^-1 : K(C x, n+1) -> K(A x, n+2)
--   (D-at: Ginv is pointwise, the pointing of the product is funext of the
--   pointings, psi is pointwise).  d is natural, up to a path:
--     e'^-1 (K hC z) = loop (K hC) (e^-1 z)             (loopK)
--     dd' (loop (K hC) g) = fm (dd g)                    (FibMap, the square
--                              K hB ; K p' = K p ; K hC from KFun)
--     lift' (K hA a) = fm (lift a)                       (LiftUnique: both
--                              lift K hA ; K i' = K i ; K hB, and pointed maps
--                              K(A, m) -> K(C', m) form a set, Lemma 4)
--   So the two composites P(C) -> P(A') agree pointwise, and their loopings
--   are conjugate (LoopHomotopy); π₁ of P(A') is abelian (EH, it is a loop
--   space through psi), so δ' (hC)_* = (hA)_* δ.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ; open Torsor[l] ; open HLevels[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module N = NatArith[l] ;
module LC = LoopConj[l] ;
module KF = KFun[l] ;

-- 4 + n = (2 + n) + 2
idx2 (n : Nat) : Id Nat (suc (suc (suc (suc n)))) (N.plus (suc (suc n)) (suc (suc zero))) =
  ap Nat Nat (\ k -> suc (suc k)) (suc (suc n)) (N.plus n (suc (suc zero)))
    (symH (transH (N.plus-suc n (suc zero)) (ap Nat Nat (\ k -> suc k) (N.plus n (suc zero)) (suc n)
       (transH (N.plus-suc n zero) (ap Nat Nat (\ k -> suc k) (N.plus n zero) n (N.plus-zero n)))))) ;
-- pointed maps K(A, m+2) -> K(B, m+2) form a set (Lemma 4)
ptmap-set (Ga Gb : Ab) (n : Nat) : isSet (PtMap (KK[Ga].K (suc (suc n))) (KK[Ga].pt (suc (suc n))) (KK[Gb].K (suc (suc n))) (KK[Gb].pt (suc (suc n)))) =
  trunc-set (PtMap (KK[Ga].K (suc (suc n))) (KK[Ga].pt (suc (suc n))) (KK[Gb].K (suc (suc n))) (KK[Gb].pt (suc (suc n))))
    (cor5-map (suc (suc zero)) (suc (suc n)) (KK[Ga].K (suc (suc n))) (KK[Ga].pt (suc (suc n))) (KK[Ga].conn (suc n))
       (KK[Gb].K (suc (suc n))) (KK[Gb].pt (suc (suc n)))
       (trunc-index (KK[Gb].K (suc (suc n))) (suc (suc (suc (suc n)))) (N.plus (suc (suc n)) (suc (suc zero))) (idx2 n) (KK[Gb].trunc (suc n)))) ;

module LESNat (X : U l) (Ga Gb Gc : X -> Ab) (i : (x : X) -> Hom (Ga x) (Gb x)) (p : (x : X) -> Hom (Gb x) (Gc x))
  (inj : (x : X) -> Bj.Injective (i x).1)
  (pi0 : (x : X) (a : (Ga x).A) -> Id (Gc x).A ((p x).1 ((i x).1 a)) (Gc x).o)
  (ex : (x : X) (b : (Gb x).A) -> Id (Gc x).A ((p x).1 b) (Gc x).o -> Tr.Trunc[Bj.Fibre (i x).1 b].carrier)
  (sur : (x : X) (c : (Gc x).A) -> Tr.Trunc[Bj.Fibre (p x).1 c].carrier)
  (Ga' Gb' Gc' : X -> Ab) (i' : (x : X) -> Hom (Ga' x) (Gb' x)) (p' : (x : X) -> Hom (Gb' x) (Gc' x))
  (inj' : (x : X) -> Bj.Injective (i' x).1)
  (pi0' : (x : X) (a : (Ga' x).A) -> Id (Gc' x).A ((p' x).1 ((i' x).1 a)) (Gc' x).o)
  (ex' : (x : X) (b : (Gb' x).A) -> Id (Gc' x).A ((p' x).1 b) (Gc' x).o -> Tr.Trunc[Bj.Fibre (i' x).1 b].carrier)
  (sur' : (x : X) (c : (Gc' x).A) -> Tr.Trunc[Bj.Fibre (p' x).1 c].carrier)
  (hA : (x : X) -> Hom (Ga x) (Ga' x)) (hB : (x : X) -> Hom (Gb x) (Gb' x)) (hC : (x : X) -> Hom (Gc x) (Gc' x))
  (sqi : (x : X) (a : (Ga x).A) -> Id (Gb' x).A ((i' x).1 ((hA x).1 a)) ((hB x).1 ((i x).1 a)))
  (sqp : (x : X) (b : (Gb x).A) -> Id (Gc' x).A ((p' x).1 ((hB x).1 b)) ((hC x).1 ((p x).1 b)))
  (n : Nat) {
  module L1 = LES[l].LES[X, Ga, Gb, Gc, i, p, inj, pi0, ex, sur, n] ;
  module L2 = LES[l].LES[X, Ga', Gb', Gc', i', p', inj', pi0', ex', sur', n] ;
  -- the maps on Hⁿ⁺¹(A) and Hⁿ(C)
  module PLA = PiPt[l].PiLoop[X, Ga, Ga', hA, suc n] ;
  module PLC = PiPt[l].PiLoop[X, Gc, Gc', hC, n] ;
  module HA = PiOne[l].Induced[L1.EA.P (suc (suc n)), L1.EA.pP (suc (suc n)), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n)), PLA.F] ;
  module HC = PiOne[l].Induced[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EC.P (suc n), L2.EC.pP (suc n), PLC.F] ;

  -- pointwise, at x
  module At (x : X) {
    module KA = KK[Ga x] ; module KA' = KK[Ga' x] ;
    module KB = KK[Gb x] ; module KB' = KK[Gb' x] ;
    module KC = KK[Gc x] ; module KC' = KK[Gc' x] ;
    module F1 = L1.SX[x].F ;
    module F2 = L2.SX[x].F ;
    module MA = KMap[Ga x, Ga' x, hA x] ;
    module MB = KMap[Gb x, Gb' x, hB x] ;
    module MC = KMap[Gc x, Gc' x, hC x] ;
    -- the boundary at x
    einv (z : KC.K (suc n)) : KC.OK (suc n) = (KC.e (suc n)).2.sec z ;
    einv' (z : KC'.K (suc n)) : KC'.OK (suc n) = (KC'.e (suc n)).2.sec z ;
    module P1 = Puppe[l].Puppe[KB.K (suc (suc n)), KB.pt (suc (suc n)), KC.K (suc (suc n)), KC.pt (suc (suc n)), F1.Kp.K (suc (suc n))] ;
    module P2 = Puppe[l].Puppe[KB'.K (suc (suc n)), KB'.pt (suc (suc n)), KC'.K (suc (suc n)), KC'.pt (suc (suc n)), F2.Kp.K (suc (suc n))] ;
    d (z : KC.K (suc n)) : KA.K (suc (suc n)) = (F1.fibre (suc (suc n))).sec (P1.dd.1 (einv z)) ;
    d' (z : KC'.K (suc n)) : KA'.K (suc (suc n)) = (F2.fibre (suc (suc n))).sec (P2.dd.1 (einv' z)) ;
    -- the square K hB ; K p' = K p ; K hC
    sq : Id (PtMap (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))))
        (ptcomp (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n)))
           (MB.K (suc (suc n))) (F2.Kp.K (suc (suc n))))
        (ptcomp (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n)))
           (F1.Kp.K (suc (suc n))) (MC.K (suc (suc n)))) =
      transH (symH (KF.Comp[Gb x, Gb' x, Gc' x, hB x, p' x].k-comp (suc (suc n))))
        (transH (KF.k-resp (Gb x) (Gc' x) (KF.hcomp (Gb x) (Gb' x) (Gc' x) (hB x) (p' x)) (KF.hcomp (Gb x) (Gc x) (Gc' x) (p x) (hC x)) (sqp x) (suc (suc n)))
                (KF.Comp[Gb x, Gc x, Gc' x, p x, hC x].k-comp (suc (suc n)))) ;
    module FM = FibMap[l].FibMap[KB.K (suc (suc n)), KB.pt (suc (suc n)), KC.K (suc (suc n)), KC.pt (suc (suc n)),
      KB'.K (suc (suc n)), KB'.pt (suc (suc n)), KC'.K (suc (suc n)), KC'.pt (suc (suc n)),
      F1.Kp.K (suc (suc n)), F2.Kp.K (suc (suc n)), MB.K (suc (suc n)), MC.K (suc (suc n)), sq] ;
    lift : PtMap (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) = F1.Cmp[suc (suc n)].L.lift ;
    lift' : PtMap (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) = F2.Cmp[suc (suc n)].L.lift ;
    -- both lifts of K hA ; K i' = K i ; K hB
    over : Id (PtMap (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))))
      (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
         (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (MA.K (suc (suc n))) lift')
         (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))))
      (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
         (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) lift FM.fm)
         (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n))))) =
      calc (PtMap (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))) {
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
        (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (MA.K (suc (suc n))) lift')
        (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n))))
        =< ptcomp-assoc (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
             (MA.K (suc (suc n))) lift' (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (MA.K (suc (suc n)))
        (ptcomp (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) lift'
           (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))))
        =< apH (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (MA.K (suc (suc n))))
             F2.Cmp[suc (suc n)].L.lift-fst >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (MA.K (suc (suc n))) (F2.Ki.K (suc (suc n)))
        =< symH (KF.Comp[Ga x, Ga' x, Gb' x, hA x, i' x].k-comp (suc (suc n))) >
      KMap[Ga x, Gb' x, KF.hcomp (Ga x) (Ga' x) (Gb' x) (hA x) (i' x)].K (suc (suc n))
        =< KF.k-resp (Ga x) (Gb' x) (KF.hcomp (Ga x) (Ga' x) (Gb' x) (hA x) (i' x)) (KF.hcomp (Ga x) (Gb x) (Gb' x) (i x) (hB x)) (sqi x) (suc (suc n)) >
      KMap[Ga x, Gb' x, KF.hcomp (Ga x) (Gb x) (Gb' x) (i x) (hB x)].K (suc (suc n))
        =< KF.Comp[Ga x, Gb x, Gb' x, i x, hB x].k-comp (suc (suc n)) >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (F1.Ki.K (suc (suc n))) (MB.K (suc (suc n)))
        =< symH (apH (\ G -> ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) G (MB.K (suc (suc n))))
             F1.Cmp[suc (suc n)].L.lift-fst) >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
        (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (KB.K (suc (suc n))) (KB.pt (suc (suc n))) lift
           (fpr (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))))
        (MB.K (suc (suc n)))
        =< ptcomp-assoc (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
             lift (fpr (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (MB.K (suc (suc n))) >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) lift
        (ptcomp (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
           (fpr (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (MB.K (suc (suc n))))
        =< symH (apH (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) lift) FM.fm-over) >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) lift
        (ptcomp (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) FM.fm
           (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))))
        =< symH (ptcomp-assoc (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
             lift FM.fm (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n))))) >
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (KB'.K (suc (suc n))) (KB'.pt (suc (suc n)))
        (ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) lift FM.fm)
        (fpr (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) } ;
    module LU = LiftUnique[l].LiftUnique[KA.K (suc (suc n)), KA.pt (suc (suc n)), KB'.K (suc (suc n)), KB'.pt (suc (suc n)),
      KC'.K (suc (suc n)), KC'.pt (suc (suc n)), F2.Kp.K (suc (suc n)), ptmap-set (Ga x) (Gc' x) n,
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (KA'.K (suc (suc n))) (KA'.pt (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (MA.K (suc (suc n))) lift',
      ptcomp (KA.K (suc (suc n))) (KA.pt (suc (suc n))) (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (fpt (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n)))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) (fpt (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) lift FM.fm, over] ;
    -- K hA (lift^-1 w) = lift'^-1 (fm w)
    lift-nat (w : (Fib (KB.K (suc (suc n))) (KB.pt (suc (suc n))) (KC.K (suc (suc n))) (KC.pt (suc (suc n))) (F1.Kp.K (suc (suc n))))) : Id (KA'.K (suc (suc n))) ((MA.K (suc (suc n))).1 ((F1.fibre (suc (suc n))).sec w)) ((F2.fibre (suc (suc n))).sec (FM.fm-fun w)) = calc (KA'.K (suc (suc n))) {
      (MA.K (suc (suc n))).1 ((F1.fibre (suc (suc n))).sec w)
        =< symH (sec-ret (KA'.K (suc (suc n))) (Fib (KB'.K (suc (suc n))) (KB'.pt (suc (suc n))) (KC'.K (suc (suc n))) (KC'.pt (suc (suc n))) (F2.Kp.K (suc (suc n)))) lift'.1 (F2.fibre (suc (suc n))) ((MA.K (suc (suc n))).1 ((F1.fibre (suc (suc n))).sec w))) >
      (F2.fibre (suc (suc n))).sec (lift'.1 ((MA.K (suc (suc n))).1 ((F1.fibre (suc (suc n))).sec w)))
        =< apH (F2.fibre (suc (suc n))).sec (LU.result ((F1.fibre (suc (suc n))).sec w)) >
      (F2.fibre (suc (suc n))).sec (FM.fm-fun (lift.1 ((F1.fibre (suc (suc n))).sec w)))
        =< apH (\ v -> (F2.fibre (suc (suc n))).sec (FM.fm-fun v)) ((F1.fibre (suc (suc n))).sec-eq w) >
      (F2.fibre (suc (suc n))).sec (FM.fm-fun w) } ;
    -- e'^-1 (K hC z) = loop (K hC) (e^-1 z)
    e-nat (z : KC.K (suc n)) : Id (KC'.OK (suc n)) ((Maps[KC.K (suc (suc n)), KC.pt (suc (suc n)), KC'.K (suc (suc n)), KC'.pt (suc (suc n))].loop (MC.K (suc (suc n)))).1 (einv z))
        (einv' ((MC.K (suc n)).1 z)) =
      transH (Puppe[l].pt-happly (KC.OK (suc n)) (refl (KC.pt (suc (suc n)))) (KC'.OK (suc n)) (refl (KC'.pt (suc (suc n))))
                (Maps[KC.K (suc (suc n)), KC.pt (suc (suc n)), KC'.K (suc (suc n)), KC'.pt (suc (suc n))].loop (MC.K (suc (suc n)))) (MC.conj (suc n) (MC.K (suc n)))
                (MC.loopK (suc n)) (einv z))
        (apH (\ c -> einv' ((MC.K (suc n)).1 c)) ((KC.e (suc n)).2.sec-eq z)) ;
    -- d is natural
    d-nat (z : KC.K (suc n)) : Id (KA'.K (suc (suc n))) ((MA.K (suc (suc n))).1 (d z)) (d' ((MC.K (suc n)).1 z)) = calc (KA'.K (suc (suc n))) {
      (MA.K (suc (suc n))).1 (d z) =< lift-nat (P1.dd.1 (einv z)) > (F2.fibre (suc (suc n))).sec (FM.fm-fun (P1.dd.1 (einv z)))
        =< apH (F2.fibre (suc (suc n))).sec (symH (FM.dd-nat (einv z))) >
      (F2.fibre (suc (suc n))).sec (P2.dd.1 ((Maps[KC.K (suc (suc n)), KC.pt (suc (suc n)), KC'.K (suc (suc n)), KC'.pt (suc (suc n))].loop (MC.K (suc (suc n)))).1 (einv z)))
        =< apH (\ g -> (F2.fibre (suc (suc n))).sec (P2.dd.1 g)) (e-nat z) > d' ((MC.K (suc n)).1 z) } ;
  } ;
  -- D is pointwise d
  module DAt (y : L1.EC.P (suc n)) (x : X) {
    lp : L1.EC.OP (suc n) = (L1.EC.psi (suc n)).2.sec y ;
    hl : Id (At[x].KC.OK (suc n)) (happly X (\ x1 -> L1.EC.KA[x1].K.K (suc (suc n))) (L1.EC.pP (suc (suc n))) (L1.EC.pP (suc (suc n))) lp x) (At[x].einv (y x)) =
      transH (symH (sec-ret (At[x].KC.OK (suc n)) (At[x].KC.K (suc n)) (At[x].KC.e (suc n)).1.1 (At[x].KC.e (suc n)).2
                      (happly X (\ x1 -> L1.EC.KA[x1].K.K (suc (suc n))) (L1.EC.pP (suc (suc n))) (L1.EC.pP (suc (suc n))) lp x)))
        (apH (At[x].KC.e (suc n)).2.sec (happly X (\ x1 -> L1.EC.KA[x1].K.K (suc n)) (L1.EC.psi-fun (suc n) lp) y ((L1.EC.psi (suc n)).2.sec-eq y) x)) ;
    snd : Id (Id (At[x].KC.K (suc (suc n))) ((At[x].F1.Kp.K (suc (suc n))).1 (At[x].KB.pt (suc (suc n)))) (At[x].KC.pt (suc (suc n))))
        (happly X (\ x1 -> L1.EC.KA[x1].K.K (suc (suc n))) (\ x1 -> (L1.SX[x1].F.Kp.K (suc (suc n))).1 (L1.EB.pP (suc (suc n)) x1)) (L1.EC.pP (suc (suc n)))
           (trans (L1.EC.P (suc (suc n))) (\ x1 -> (L1.SX[x1].F.Kp.K (suc (suc n))).1 (L1.EB.pP (suc (suc n)) x1)) (L1.EC.pP (suc (suc n))) (L1.EC.pP (suc (suc n)))
              (L1.Pp (suc (suc n))).2 lp) x)
        (At[x].P1.dd.1 (At[x].einv (y x))).2 =
      transH (Eps[l].happly-trans X (\ x1 -> L1.EC.KA[x1].K.K (suc (suc n))) (\ x1 -> (L1.SX[x1].F.Kp.K (suc (suc n))).1 (L1.EB.pP (suc (suc n)) x1))
                (L1.EC.pP (suc (suc n))) (L1.Pp (suc (suc n))).2 (L1.EC.pP (suc (suc n))) lp x)
        (transH (apH (\ a -> trans (At[x].KC.K (suc (suc n))) ((At[x].F1.Kp.K (suc (suc n))).1 (At[x].KB.pt (suc (suc n)))) (At[x].KC.pt (suc (suc n))) (At[x].KC.pt (suc (suc n))) a
                                (happly X (\ x1 -> L1.EC.KA[x1].K.K (suc (suc n))) (L1.EC.pP (suc (suc n))) (L1.EC.pP (suc (suc n))) lp x))
                   (happly X (\ x1 -> Id (L1.EC.KA[x1].K.K (suc (suc n))) ((L1.SX[x1].F.Kp.K (suc (suc n))).1 (L1.EB.pP (suc (suc n)) x1)) (L1.EC.pP (suc (suc n)) x1)) _ _
                      (FL.happly-funext X (\ x1 -> L1.EC.KA[x1].K.K (suc (suc n))) (\ x1 -> (L1.SX[x1].F.Kp.K (suc (suc n))).1 (L1.EB.pP (suc (suc n)) x1)) (L1.EC.pP (suc (suc n)))
                         (\ x1 -> (L1.SX[x1].F.Kp.K (suc (suc n))).2)) x))
                (apH (trans (At[x].KC.K (suc (suc n))) ((At[x].F1.Kp.K (suc (suc n))).1 (At[x].KB.pt (suc (suc n)))) (At[x].KC.pt (suc (suc n))) (At[x].KC.pt (suc (suc n)))
                        (At[x].F1.Kp.K (suc (suc n))).2) hl)) ;
    at : Id (At[x].KA.K (suc (suc n))) (L1.D.1 y x) (At[x].d (y x)) =
      ap (Fib (At[x].KB.K (suc (suc n))) (At[x].KB.pt (suc (suc n))) (At[x].KC.K (suc (suc n))) (At[x].KC.pt (suc (suc n))) (At[x].F1.Kp.K (suc (suc n)))) (At[x].KA.K (suc (suc n))) (At[x].F1.fibre (suc (suc n))).sec _ _
        (ap (Id (At[x].KC.K (suc (suc n))) ((At[x].F1.Kp.K (suc (suc n))).1 (At[x].KB.pt (suc (suc n)))) (At[x].KC.pt (suc (suc n)))) (Fib (At[x].KB.K (suc (suc n))) (At[x].KB.pt (suc (suc n))) (At[x].KC.K (suc (suc n))) (At[x].KC.pt (suc (suc n))) (At[x].F1.Kp.K (suc (suc n)))) (\ q -> (At[x].KB.pt (suc (suc n)), q)) _ _ snd) ;
  } ;
  -- the same for L2
  module DAt' (y : L2.EC.P (suc n)) (x : X) {
    lp : L2.EC.OP (suc n) = (L2.EC.psi (suc n)).2.sec y ;
    hl : Id (At[x].KC'.OK (suc n)) (happly X (\ x1 -> L2.EC.KA[x1].K.K (suc (suc n))) (L2.EC.pP (suc (suc n))) (L2.EC.pP (suc (suc n))) lp x) (At[x].einv' (y x)) =
      transH (symH (sec-ret (At[x].KC'.OK (suc n)) (At[x].KC'.K (suc n)) (At[x].KC'.e (suc n)).1.1 (At[x].KC'.e (suc n)).2
                      (happly X (\ x1 -> L2.EC.KA[x1].K.K (suc (suc n))) (L2.EC.pP (suc (suc n))) (L2.EC.pP (suc (suc n))) lp x)))
        (apH (At[x].KC'.e (suc n)).2.sec (happly X (\ x1 -> L2.EC.KA[x1].K.K (suc n)) (L2.EC.psi-fun (suc n) lp) y ((L2.EC.psi (suc n)).2.sec-eq y) x)) ;
    snd : Id (Id (At[x].KC'.K (suc (suc n))) ((At[x].F2.Kp.K (suc (suc n))).1 (At[x].KB'.pt (suc (suc n)))) (At[x].KC'.pt (suc (suc n))))
        (happly X (\ x1 -> L2.EC.KA[x1].K.K (suc (suc n))) (\ x1 -> (L2.SX[x1].F.Kp.K (suc (suc n))).1 (L2.EB.pP (suc (suc n)) x1)) (L2.EC.pP (suc (suc n)))
           (trans (L2.EC.P (suc (suc n))) (\ x1 -> (L2.SX[x1].F.Kp.K (suc (suc n))).1 (L2.EB.pP (suc (suc n)) x1)) (L2.EC.pP (suc (suc n))) (L2.EC.pP (suc (suc n)))
              (L2.Pp (suc (suc n))).2 lp) x)
        (At[x].P2.dd.1 (At[x].einv' (y x))).2 =
      transH (Eps[l].happly-trans X (\ x1 -> L2.EC.KA[x1].K.K (suc (suc n))) (\ x1 -> (L2.SX[x1].F.Kp.K (suc (suc n))).1 (L2.EB.pP (suc (suc n)) x1))
                (L2.EC.pP (suc (suc n))) (L2.Pp (suc (suc n))).2 (L2.EC.pP (suc (suc n))) lp x)
        (transH (apH (\ a -> trans (At[x].KC'.K (suc (suc n))) ((At[x].F2.Kp.K (suc (suc n))).1 (At[x].KB'.pt (suc (suc n)))) (At[x].KC'.pt (suc (suc n))) (At[x].KC'.pt (suc (suc n))) a
                                (happly X (\ x1 -> L2.EC.KA[x1].K.K (suc (suc n))) (L2.EC.pP (suc (suc n))) (L2.EC.pP (suc (suc n))) lp x))
                   (happly X (\ x1 -> Id (L2.EC.KA[x1].K.K (suc (suc n))) ((L2.SX[x1].F.Kp.K (suc (suc n))).1 (L2.EB.pP (suc (suc n)) x1)) (L2.EC.pP (suc (suc n)) x1)) _ _
                      (FL.happly-funext X (\ x1 -> L2.EC.KA[x1].K.K (suc (suc n))) (\ x1 -> (L2.SX[x1].F.Kp.K (suc (suc n))).1 (L2.EB.pP (suc (suc n)) x1)) (L2.EC.pP (suc (suc n)))
                         (\ x1 -> (L2.SX[x1].F.Kp.K (suc (suc n))).2)) x))
                (apH (trans (At[x].KC'.K (suc (suc n))) ((At[x].F2.Kp.K (suc (suc n))).1 (At[x].KB'.pt (suc (suc n)))) (At[x].KC'.pt (suc (suc n))) (At[x].KC'.pt (suc (suc n)))
                        (At[x].F2.Kp.K (suc (suc n))).2) hl)) ;
    at : Id (At[x].KA'.K (suc (suc n))) (L2.D.1 y x) (At[x].d' (y x)) =
      ap (Fib (At[x].KB'.K (suc (suc n))) (At[x].KB'.pt (suc (suc n))) (At[x].KC'.K (suc (suc n))) (At[x].KC'.pt (suc (suc n))) (At[x].F2.Kp.K (suc (suc n)))) (At[x].KA'.K (suc (suc n))) (At[x].F2.fibre (suc (suc n))).sec _ _
        (ap (Id (At[x].KC'.K (suc (suc n))) ((At[x].F2.Kp.K (suc (suc n))).1 (At[x].KB'.pt (suc (suc n)))) (At[x].KC'.pt (suc (suc n)))) (Fib (At[x].KB'.K (suc (suc n))) (At[x].KB'.pt (suc (suc n))) (At[x].KC'.K (suc (suc n))) (At[x].KC'.pt (suc (suc n))) (At[x].F2.Kp.K (suc (suc n)))) (\ q -> (At[x].KB'.pt (suc (suc n)), q)) _ _ snd) ;
  } ;
  -- the two composites P(C) -> P(A') agree pointwise
  J1 : PtMap (L1.EC.P (suc n)) (L1.EC.pP (suc n)) (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) =
    ptcomp (L1.EC.P (suc n)) (L1.EC.pP (suc n)) (L1.EA.P (suc (suc n))) (L1.EA.pP (suc (suc n))) (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) L1.D PLA.F ;
  J2 : PtMap (L1.EC.P (suc n)) (L1.EC.pP (suc n)) (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) =
    ptcomp (L1.EC.P (suc n)) (L1.EC.pP (suc n)) (L2.EC.P (suc n)) (L2.EC.pP (suc n)) (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) PLC.F L2.D ;
  H (y : L1.EC.P (suc n)) : Id (L2.EA.P (suc (suc n))) (J1.1 y) (J2.1 y) =
    FL.funext X (\ x -> L2.EA.KA[x].K.K (suc (suc n))) (J1.1 y) (J2.1 y) (\ x ->
      transH (apH (At[x].MA.K (suc (suc n))).1 (DAt[y, x].at)) (transH (At[x].d-nat (y x)) (symH (DAt'[PLC.F.1 y, x].at)))) ;
  module LHo = LC.LoopHomotopy[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n)), J1, J2, H] ;
  module Ab = EH[l].Abelian[L2.EA.P (suc (suc (suc n))), L2.EA.pP (suc (suc (suc n))), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n)), L2.EA.psi (suc (suc n))] ;
  -- δ' o (hC)_* = (hA)_* o δ
  natural (y : L1.HC.grp.G) : Id L2.HA.grp.G (L2.delta.1 (HC.map y)) (HA.map (L1.delta.1 y)) =
    L1.HC.P.Q.induction @l (\ y1 -> Id L2.HA.grp.G (L2.delta.1 (HC.map y1)) (HA.map (L1.delta.1 y1)))
      (\ y1 -> L2.HA.P.Q.set (L2.delta.1 (HC.map y1)) (HA.map (L1.delta.1 y1))) (\ q -> calc L2.HA.grp.G {
      L2.delta.1 (HC.map (L1.HC.cls q)) =< apH L2.delta.1 (HC.map-cls q) > L2.delta.1 (L2.HC.cls (HC.L q))
        =< L2.Dl.map-cls (HC.L q) > L2.HA.cls (L2.Dl.L (HC.L q))
        =< apH L2.HA.cls (symH (Puppe[l].pt-happly L1.HC.O (refl (L1.EC.pP (suc n))) L2.HA.O (refl (L2.EA.pP (suc (suc n))))
             (Maps[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n))].loop J2)
             (ptcomp L1.HC.O (refl (L1.EC.pP (suc n))) L2.HC.O (refl (L2.EC.pP (suc n))) L2.HA.O (refl (L2.EA.pP (suc (suc n)))) (HC.MF.loop PLC.F) (L2.Dl.MF.loop L2.D))
             (loop-comp (L1.EC.P (suc n)) (L1.EC.pP (suc n)) (L2.EC.P (suc n)) (L2.EC.pP (suc n)) (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) PLC.F L2.D) q)) >
      L2.HA.cls ((Maps[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n))].loop J2).1 q)
        =< apH L2.HA.cls (LHo.loop-homotopy q) >
      L2.HA.cls (LC.conj (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) (L2.EA.pP (suc (suc n))) LHo.c ((Maps[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n))].loop J1).1 q))
        =< Ab.conj-cls LHo.c ((Maps[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n))].loop J1).1 q) >
      L2.HA.cls ((Maps[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n))].loop J1).1 q)
        =< apH L2.HA.cls (Puppe[l].pt-happly L1.HC.O (refl (L1.EC.pP (suc n))) L2.HA.O (refl (L2.EA.pP (suc (suc n))))
             (Maps[L1.EC.P (suc n), L1.EC.pP (suc n), L2.EA.P (suc (suc n)), L2.EA.pP (suc (suc n))].loop J1)
             (ptcomp L1.HC.O (refl (L1.EC.pP (suc n))) L1.HA.O (refl (L1.EA.pP (suc (suc n)))) L2.HA.O (refl (L2.EA.pP (suc (suc n)))) (L1.Dl.MF.loop L1.D) (HA.MF.loop PLA.F))
             (loop-comp (L1.EC.P (suc n)) (L1.EC.pP (suc n)) (L1.EA.P (suc (suc n))) (L1.EA.pP (suc (suc n))) (L2.EA.P (suc (suc n))) (L2.EA.pP (suc (suc n))) L1.D PLA.F) q) >
      L2.HA.cls (HA.L (L1.Dl.L q))
        =< symH (HA.map-cls (L1.Dl.L q)) > HA.map (L1.HA.cls (L1.Dl.L q))
        =< apH HA.map (symH (L1.Dl.map-cls q)) > HA.map (L1.delta.1 (L1.HC.cls q)) }) y ;
} ;
