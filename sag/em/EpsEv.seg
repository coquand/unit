-- CCA Def. 3.2.1: the map eps m : K(Pi A, m) -> (x : S) -> K(A x, m) of Eps
-- (defined by delooping) is the canonical map  z |-> (x |-> K(ev_x, m) z),
-- ev_x : Pi A -> A x the evaluation homomorphism:
--     ev_x o eps m = K(ev_x, m)       as pointed maps, for every m and x.
--
-- Induction on m.  m = 0: eps 0 is the identity, K(ev_x, 0) = ev_x (the
-- pointings agree: A x is a set).  m + 1: K(Pi A, m+1) is m-connected
-- and K(A x, m+1) is (m+1)-truncated, so pointed maps with equal loopings
-- are equal (LoopCalc.unique-loop, unique-loop1 at m = 0).  The loopings:
--   loop (ev o eps (m+1)) = loop eps (m+1) ; loop ev            (loop-comp)
--                         = e ; eps m ; psi^-1 ; loop ev         (loop-eps)
--                         = e ; eps m ; ev ; e_x^-1              (Square)
--                         = e ; K(ev_x, m) ; e_x^-1              (induction)
--                         = loop K(ev_x, m+1)                    (loopK)
-- Square: psi^-1 ; loop ev = ev ; e_x^-1, from  psi ; ev = loop ev ; e_x
--   (psi w = x |-> e_x (happly w x), and loop ev w = ap ev w = happly w x;
--   the pointings agree at w = refl: ap ev (funext h) = h x),
--   with the inverse laws pt-inv-l, pt-inv-r and the unit laws of ptcomp.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open EMMaps[l] ;
open Torsor[l] ; open Fibres[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

-- ap of an evaluation is happly
ap-ev (X : U l) (B : X -> U l) (f g : (x : X) -> B x) (p : Id ((x : X) -> B x) f g) (x : X) :
  Id (Id (B x) (f x) (g x)) (ap ((x1 : X) -> B x1) (B x) (\ h -> h x) f g p) (happly X B f g p x) =
  idJ ((x1 : X) -> B x1) f (\ g1 p1 -> Id (Id (B x) (f x) (g1 x)) (ap ((x1 : X) -> B x1) (B x) (\ h -> h x) f g1 p1) (happly X B f g1 p1 x))
    (refl (refl (f x))) g p ;
module EpsEv (S : U l) (A : S -> Ab) {
  module E = Eps[l].Eps[S, A] ;
  module KP = E.KP ;
  -- the evaluation homomorphism and its deloopings
  ev (x : S) : Hom E.PA (A x) = (\ f -> f x, \ f g -> refl ((A x).add (f x) (g x))) ;
  module KE (x : S) { module M = KMap[E.PA, A x, ev x] ; } ;

  module At (x : S) (m : Nat) {
    module K = E.KA[x].K ;
    -- evaluation at x, a pointed map at levels m and m + 1
    evP : PtMap (E.P m) (E.pP m) (K.K m) (K.pt m) = (\ f -> f x, refl (K.pt m)) ;
    evS : PtMap (E.P (suc m)) (E.pP (suc m)) (K.K (suc m)) (K.pt (suc m)) = (\ f -> f x, refl (K.pt (suc m))) ;
    LE : PtMap (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) =
      Maps[E.P (suc m), E.pP (suc m), K.K (suc m), K.pt (suc m)].loop evS ;
    ex : PtEquiv ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) = K.e m ;
    exInv : PtMap (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) = (pt-inv ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) ex).1 ;
    psiInv : PtMap (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) = (pt-inv (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (E.psi m)).1 ;

    -- loop ev w = happly w x
    loop-ev (w : E.OP m) : Id ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (happly S (\ x1 -> E.KA[x1].K.K (suc m)) (E.pP (suc m)) (E.pP (suc m)) w x) (LE.1 w) =
      symH (transH (Maps[E.P (suc m), E.pP (suc m), K.K (suc m), K.pt (suc m)].loop-ap evS w)
        (transH (trans-refl-l (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m))
                   (ap (E.P (suc m)) (K.K (suc m)) (\ f -> f x) (E.pP (suc m)) (E.pP (suc m)) w))
                (ap-ev S (\ x1 -> E.KA[x1].K.K (suc m)) (E.pP (suc m)) (E.pP (suc m)) w x))) ;
    -- the pointing of psi ; ev is the pointing of e_x
    h0 (x1 : S) : Id (E.KA[x1].K.K m) ((E.KA[x1].K.e m).1.1 (refl (E.KA[x1].K.pt (suc m)))) (E.KA[x1].K.pt m) = (E.KA[x1].K.e m).1.2 ;
    point-l : Id (Id (K.K m) (ex.1.1 (refl (K.pt (suc m)))) (K.pt m))
      (ap (E.P m) (K.K m) (\ f -> f x) (E.psi-fun m (refl (E.pP (suc m)))) (E.pP m) (E.psi m).1.2) ex.1.2 =
      transH (ap-ev S (\ x1 -> E.KA[x1].K.K m) (E.psi-fun m (refl (E.pP (suc m)))) (E.pP m) (E.psi m).1.2 x)
        (happly S (\ x1 -> Id (E.KA[x1].K.K m) ((E.KA[x1].K.e m).1.1 (refl (E.KA[x1].K.pt (suc m)))) (E.KA[x1].K.pt m))
           (happly S (\ x1 -> E.KA[x1].K.K m) (E.psi-fun m (refl (E.pP (suc m)))) (E.pP m) (E.psi m).1.2) h0
           (FL.happly-funext S (\ x1 -> E.KA[x1].K.K m) (E.psi-fun m (refl (E.pP (suc m)))) (E.pP m) h0) x) ;
    point-r : Id (Id (K.K m) (ex.1.1 (refl (K.pt (suc m)))) (K.pt m))
      (trans (K.K m) (ex.1.1 (refl (K.pt (suc m)))) (ex.1.1 (refl (K.pt (suc m)))) (K.pt m)
         (ap ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (K.K m) ex.1.1 (refl (K.pt (suc m))) (refl (K.pt (suc m))) (loop-ev (refl (E.pP (suc m)))))
         (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) LE ex.1).2)
      ex.1.2 =
      transH (trans-refl-l (K.K m) (ex.1.1 (refl (K.pt (suc m)))) (K.pt m)
                (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) LE ex.1).2)
        (trans-refl-l (K.K m) (ex.1.1 (refl (K.pt (suc m)))) (K.pt m) ex.1.2) ;
    -- psi ; ev = loop ev ; e_x
    square : Id (PtMap (E.OP m) (refl (E.pP (suc m))) (K.K m) (K.pt m))
      (ptcomp (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) (E.psi m).1 evP)
      (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) LE ex.1) =
      ptmap-path (E.OP m) (refl (E.pP (suc m))) (K.K m) (K.pt m)
        (ptcomp (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) (E.psi m).1 evP).1
        (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) LE ex.1).1
        (ptcomp (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) (E.psi m).1 evP).2
        (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) LE ex.1).2
        (\ w -> ap ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (K.K m) ex.1.1 (happly S (\ x1 -> E.KA[x1].K.K (suc m)) (E.pP (suc m)) (E.pP (suc m)) w x) (LE.1 w) (loop-ev w))
        (transH point-l (symH point-r)) ;
    -- psi^-1 ; loop ev = ev ; e_x^-1
    square-inv : Id (PtMap (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))))
      (ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv LE)
      (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv) = calc (PtMap (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))) {
      ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv LE
        =< symH (apH (ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv)
             (ptcomp-idr (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) LE)) >
      ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
        (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) LE (ptid ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))))
        =< symH (apH (\ G -> ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
                   (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) LE G))
             (pt-inv-l ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) ex)) >
      ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
        (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) LE
          (ptcomp ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) ex.1 exInv))
        =< symH (apH (ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv)
             (ptcomp-assoc (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) LE ex.1 exInv)) >
      ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
        (ptcomp (E.OP m) (refl (E.pP (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
          (ptcomp (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (K.K m) (K.pt m) LE ex.1) exInv)
        =< symH (apH (\ G -> ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
                   (ptcomp (E.OP m) (refl (E.pP (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) G exInv)) square) >
      ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
        (ptcomp (E.OP m) (refl (E.pP (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
          (ptcomp (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) (E.psi m).1 evP) exInv)
        =< apH (ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv)
             (ptcomp-assoc (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (E.psi m).1 evP exInv) >
      ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) psiInv
        (ptcomp (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (E.psi m).1
          (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv))
        =< symH (ptcomp-assoc (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
             psiInv (E.psi m).1 (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv)) >
      ptcomp (E.P m) (E.pP m) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
        (ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) psiInv (E.psi m).1)
        (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv)
        =< apH (\ G -> ptcomp (E.P m) (E.pP m) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) G
                 (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv))
             (pt-inv-r (E.OP m) (refl (E.pP (suc m))) (E.P m) (E.pP m) (E.psi m)) >
      ptcomp (E.P m) (E.pP m) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (ptid (E.P m) (E.pP m))
        (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv)
        =< ptcomp-idl (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv) >
      ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) evP exInv } ;

    -- the two sides of the claim at m
    lhs : PtMap (KP.K m) (KP.pt m) (K.K m) (K.pt m) = ptcomp (KP.K m) (KP.pt m) (E.P m) (E.pP m) (K.K m) (K.pt m) (E.eps m) evP ;
    rhs : PtMap (KP.K m) (KP.pt m) (K.K m) (K.pt m) = KE[x].M.K m ;
  } ;

  -- over the m-connected K(Pi A, m+1), maps into K(A x, m+1) with equal loopings are equal
  unloop : (m : Nat) (x : S) (F F' : PtMap (KP.K (suc m)) (KP.pt (suc m)) (E.KA[x].K.K (suc m)) (E.KA[x].K.pt (suc m))) ->
    Id (Maps[KP.K (suc m), KP.pt (suc m), E.KA[x].K.K (suc m), E.KA[x].K.pt (suc m)].PMO)
      (Maps[KP.K (suc m), KP.pt (suc m), E.KA[x].K.K (suc m), E.KA[x].K.pt (suc m)].loop F)
      (Maps[KP.K (suc m), KP.pt (suc m), E.KA[x].K.K (suc m), E.KA[x].K.pt (suc m)].loop F') ->
    Id (PtMap (KP.K (suc m)) (KP.pt (suc m)) (E.KA[x].K.K (suc m)) (E.KA[x].K.pt (suc m))) F F' = split {
    zero -> \ x F F' e -> unique-loop1 zero (KP.K (suc zero)) (KP.pt (suc zero)) (E.KA[x].K.K (suc zero)) (E.KA[x].K.pt (suc zero))
      (KP.conn zero) (E.KA[x].K.trunc zero) F F' e ;
    suc n -> \ x F F' e -> unique-loop (suc n) (KP.K (suc (suc n))) (KP.pt (suc (suc n))) (E.KA[x].K.K (suc (suc n))) (E.KA[x].K.pt (suc (suc n)))
      (KP.conn (suc n)) (KE[x].M.tB n) F F' e } ;

  -- m = 0: both are evaluation; A x is a set
  base (x : S) : Id (PtMap (KP.K zero) (KP.pt zero) (E.KA[x].K.K zero) (E.KA[x].K.pt zero)) At[x, zero].lhs At[x, zero].rhs =
    ptmap-path (KP.K zero) (KP.pt zero) (E.KA[x].K.K zero) (E.KA[x].K.pt zero)
      At[x, zero].lhs.1 At[x, zero].rhs.1 At[x, zero].lhs.2 At[x, zero].rhs.2 (\ a -> refl (a x))
      ((A x).setA (A x).o (A x).o At[x, zero].lhs.2
         (trans (A x).A (A x).o (A x).o (A x).o (refl (A x).o) At[x, zero].rhs.2)) ;

  -- m + 1: the loopings agree
  module Step (x : S) (m : Nat)
    (ih : Id (PtMap (KP.K m) (KP.pt m) (E.KA[x].K.K m) (E.KA[x].K.pt m)) At[x, m].lhs At[x, m].rhs) {
    module T = At[x, m] ;
    module K = T.K ;
    module MS = Maps[KP.K (suc m), KP.pt (suc m), K.K (suc m), K.pt (suc m)] ;
    eP : PtMap ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (KP.K m) (KP.pt m) = (KP.e m).1 ;
    EE : PtMap ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) =
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (KP.K m) (KP.pt m) (E.P m) (E.pP m) eP (E.eps m) ;
    loops : Id MS.PMO (MS.loop At[x, suc m].lhs) (MS.loop At[x, suc m].rhs) = calc MS.PMO {
      MS.loop At[x, suc m].lhs
        =< loop-comp (KP.K (suc m)) (KP.pt (suc m)) (E.P (suc m)) (E.pP (suc m)) (K.K (suc m)) (K.pt (suc m)) (E.eps (suc m)) T.evS >
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
        (Maps[KP.K (suc m), KP.pt (suc m), E.P (suc m), E.pP (suc m)].loop (E.eps (suc m))) T.LE
        =< apH (\ G -> ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) G T.LE)
             (E.loop-eps m) >
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
        (ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) EE T.psiInv) T.LE
        =< ptcomp-assoc ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
             EE T.psiInv T.LE >
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) EE
        (ptcomp (E.P m) (E.pP m) (E.OP m) (refl (E.pP (suc m))) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) T.psiInv T.LE)
        =< apH (ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) EE) T.square-inv >
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) EE
        (ptcomp (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) T.evP T.exInv)
        =< symH (ptcomp-assoc ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
             EE T.evP T.exInv) >
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
        (ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (E.P m) (E.pP m) (K.K m) (K.pt m) EE T.evP) T.exInv
        =< apH (\ G -> ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m))) G T.exInv)
             (ptcomp-assoc ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (KP.K m) (KP.pt m) (E.P m) (E.pP m) (K.K m) (K.pt m) eP (E.eps m) T.evP) >
      ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
        (ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (KP.K m) (KP.pt m) (K.K m) (K.pt m) eP T.lhs) T.exInv
        =< apH (\ F -> ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (K.K m) (K.pt m) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (refl (K.pt (suc m)))
                 (ptcomp ((Id (KP.K (suc m)) (KP.pt (suc m)) (KP.pt (suc m)))) (refl (KP.pt (suc m))) (KP.K m) (KP.pt m) (K.K m) (K.pt m) eP F) T.exInv) ih >
      KE[x].M.conj m T.rhs
        =< symH (KE[x].M.loopK m) >
      MS.loop At[x, suc m].rhs } ;
    result : Id (PtMap (KP.K (suc m)) (KP.pt (suc m)) (K.K (suc m)) (K.pt (suc m))) At[x, suc m].lhs At[x, suc m].rhs =
      unloop m x At[x, suc m].lhs At[x, suc m].rhs loops ;
  } ;

  -- ev_x o eps m = K(ev_x, m)
  claim : (m : Nat) (x : S) -> Id (PtMap (KP.K m) (KP.pt m) (E.KA[x].K.K m) (E.KA[x].K.pt m)) At[x, m].lhs At[x, m].rhs = split {
    zero -> base ;
    suc m | r -> \ x -> Step[x, m, r x].result } ;
  -- Def. 3.2.1: eps m z = (x |-> K(ev_x, m) z)
  eps-ev (m : Nat) (z : KP.K m) (x : S) : Id (E.KA[x].K.K m) ((E.eps m).1 z x) ((KE[x].M.K m).1 z) =
    happly (KP.K m) (\ z1 -> E.KA[x].K.K m) At[x, m].lhs.1 At[x, m].rhs.1
      (ap (PtMap (KP.K m) (KP.pt m) (E.KA[x].K.K m) (E.KA[x].K.pt m)) (KP.K m -> E.KA[x].K.K m) (\ F -> F.1)
        At[x, m].lhs At[x, m].rhs (claim m x)) z ;
} ;
