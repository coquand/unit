-- Pointed maps and their loopings (DeloopMaps.Maps.loop).
--   ptcomp, ptid     composition and identity of pointed maps
--   pt-inv-l, -r     an inverse of a pointed equivalence (PtEquivOps.pt-inv)
--                    is one on both sides (induction on pointed
--                    equivalences: for the identity both sides are refl)
--   loop-comp        loop (G o F) = loop G o loop F  (J on the pointings;
--                    then loop-ap on each side)
--   unique-loop      over a c-connected A, maps into a (2c+2)-truncated B
--                    with equal loopings are equal (Corollary 11)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ;
module N = NatArith[l] ;
module P1 = Prelude[l+] ;

ptcomp (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (F : PtMap A a0 B b0) (G : PtMap B b0 C c0) : PtMap A a0 C c0 =
  (\ a -> G.1 (F.1 a), trans C (G.1 (F.1 a0)) (G.1 b0) c0 (ap B C G.1 (F.1 a0) b0 F.2) G.2) ;
ptid (A : U l) (a0 : A) : PtMap A a0 A a0 = (\ a -> a, refl a0) ;

ap-ap (A B C : U l) (f : A -> B) (g : B -> C) (x y : A) (p : Id A x y) :
  Id (Id C (g (f x)) (g (f y))) (ap B C g (f x) (f y) (ap A B f x y p)) (ap A C (\ a -> g (f a)) x y p) =
  idJ A x (\ y1 p1 -> Id (Id C (g (f x)) (g (f y1))) (ap B C g (f x) (f y1) (ap A B f x y1 p1)) (ap A C (\ a -> g (f a)) x y1 p1))
    (refl (refl (g (f x)))) y p ;

-- by definition, the map of a composite of pointed equivalences
pt-comp-map (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (e : PtEquiv A a0 B b0) (d : PtEquiv B b0 C c0) :
  Id (PtMap A a0 C c0) (pt-comp A a0 B b0 C c0 e d).1 (ptcomp A a0 B b0 C c0 e.1 d.1) = refl (ptcomp A a0 B b0 C c0 e.1 d.1) ;

pt-inv-l (A : U l) (a0 : A) (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) :
  Id (PtMap A a0 A a0) (ptcomp A a0 B b0 A a0 e.1 (pt-inv A a0 B b0 e).1) (ptid A a0) =
  ptEqInd A a0 (\ Z z p -> Id (PtMap A a0 A a0) (ptcomp A a0 Z z A a0 p.1 (pt-inv A a0 Z z p).1) (ptid A a0))
    (refl (ptid A a0)) B b0 e ;
pt-inv-r (A : U l) (a0 : A) (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) :
  Id (PtMap B b0 B b0) (ptcomp B b0 A a0 B b0 (pt-inv A a0 B b0 e).1 e.1) (ptid B b0) =
  ptEqInd A a0 (\ Z z p -> Id (PtMap Z z Z z) (ptcomp Z z A a0 Z z (pt-inv A a0 Z z p).1 p.1) (ptid Z z))
    (refl (ptid A a0)) B b0 e ;

-- loop (G o F) = loop G o loop F
module Comp (A : U l) (a0 : A) (B C : U l) (F1 : A -> B) (G1 : B -> C) {
  module MA = Maps[A, a0, C, G1 (F1 a0)] ;
  module MF = Maps[A, a0, B, F1 a0] ;
  module MG = Maps[B, F1 a0, C, G1 (F1 a0)] ;
  -- with refl pointings
  H (q : Id A a0 a0) :
    Id (Id C (G1 (F1 a0)) (G1 (F1 a0))) ((MA.loop (\ a -> G1 (F1 a), refl (G1 (F1 a0)))).1 q)
      ((MG.loop (G1, refl (G1 (F1 a0)))).1 ((MF.loop (F1, refl (F1 a0))).1 q)) =
    transH (MA.loop-ap (\ a -> G1 (F1 a), refl (G1 (F1 a0))) q)
      (transH (ap (Id C (G1 (F1 a0)) (G1 (F1 a0))) (Id C (G1 (F1 a0)) (G1 (F1 a0))) (trans C (G1 (F1 a0)) (G1 (F1 a0)) (G1 (F1 a0)) (refl (G1 (F1 a0))))
                 (ap A C (\ a -> G1 (F1 a)) a0 a0 q) (ap B C G1 (F1 a0) (F1 a0) (trans B (F1 a0) (F1 a0) (F1 a0) (refl (F1 a0)) (ap A B F1 a0 a0 q)))
                 (transH (symH (ap-ap A B C F1 G1 a0 a0 q))
                    (ap (Id B (F1 a0) (F1 a0)) (Id C (G1 (F1 a0)) (G1 (F1 a0))) (ap B C G1 (F1 a0) (F1 a0))
                       (ap A B F1 a0 a0 q) (trans B (F1 a0) (F1 a0) (F1 a0) (refl (F1 a0)) (ap A B F1 a0 a0 q))
                       (symH (trans-refl-l B (F1 a0) (F1 a0) (ap A B F1 a0 a0 q))))))
        (symH (transH (MG.loop-ap (G1, refl (G1 (F1 a0))) ((MF.loop (F1, refl (F1 a0))).1 q))
                (ap (Id B (F1 a0) (F1 a0)) (Id C (G1 (F1 a0)) (G1 (F1 a0)))
                   (\ z -> trans C (G1 (F1 a0)) (G1 (F1 a0)) (G1 (F1 a0)) (refl (G1 (F1 a0))) (ap B C G1 (F1 a0) (F1 a0) z))
                   ((MF.loop (F1, refl (F1 a0))).1 q) (trans B (F1 a0) (F1 a0) (F1 a0) (refl (F1 a0)) (ap A B F1 a0 a0 q))
                   (MF.loop-ap (F1, refl (F1 a0)) q))))) ;
  base : Id MA.PMO (MA.loop (\ a -> G1 (F1 a), refl (G1 (F1 a0))))
      (ptcomp MF.OA (refl a0) MF.OB (refl (F1 a0)) MG.OB (refl (G1 (F1 a0))) (MF.loop (F1, refl (F1 a0))) (MG.loop (G1, refl (G1 (F1 a0))))) =
    ptmap-path MA.OA (refl a0) MA.OB (refl (G1 (F1 a0)))
      (MA.loop (\ a -> G1 (F1 a), refl (G1 (F1 a0)))).1
      (\ q -> (MG.loop (G1, refl (G1 (F1 a0)))).1 ((MF.loop (F1, refl (F1 a0))).1 q))
      (MA.loop (\ a -> G1 (F1 a), refl (G1 (F1 a0)))).2
      (ptcomp MF.OA (refl a0) MF.OB (refl (F1 a0)) MG.OB (refl (G1 (F1 a0))) (MF.loop (F1, refl (F1 a0))) (MG.loop (G1, refl (G1 (F1 a0))))).2
      H (refl (refl (refl (G1 (F1 a0))))) ;
} ;

loop-comp (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (F : PtMap A a0 B b0) (G : PtMap B b0 C c0) :
  Id (Maps[A, a0, C, c0].PMO) (Maps[A, a0, C, c0].loop (ptcomp A a0 B b0 C c0 F G))
    (ptcomp (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) (Id C c0 c0) (refl c0) (Maps[A, a0, B, b0].loop F) (Maps[B, b0, C, c0].loop G)) =
  idJ B (F.1 a0) (\ b1 p1 -> (c1 : C) (G1 : PtMap B b1 C c1) ->
      Id (Maps[A, a0, C, c1].PMO) (Maps[A, a0, C, c1].loop (ptcomp A a0 B b1 C c1 (F.1, p1) G1))
        (ptcomp (Id A a0 a0) (refl a0) (Id B b1 b1) (refl b1) (Id C c1 c1) (refl c1) (Maps[A, a0, B, b1].loop (F.1, p1)) (Maps[B, b1, C, c1].loop G1)))
    (\ c1 G1 -> idJ C (G1.1 (F.1 a0)) (\ c2 p2 ->
        Id (Maps[A, a0, C, c2].PMO) (Maps[A, a0, C, c2].loop (ptcomp A a0 B (F.1 a0) C c2 (F.1, refl (F.1 a0)) (G1.1, p2)))
          (ptcomp (Id A a0 a0) (refl a0) (Id B (F.1 a0) (F.1 a0)) (refl (F.1 a0)) (Id C c2 c2) (refl c2)
             (Maps[A, a0, B, F.1 a0].loop (F.1, refl (F.1 a0))) (Maps[B, F.1 a0, C, c2].loop (G1.1, p2))))
        Comp[A, a0, B, C, F.1, G1.1].base c1 G1.2)
    b0 F.2 c0 G ;

-- maps with equal loopings are equal (Corollary 11)
unique-loop (c : Nat) (A : U l) (a0 : A) (B : U l) (b0 : B) (cA : isConn (suc (suc c)) A)
  (tB : isTrunc (N.plus (suc c) (N.plus (suc c) zero)) B) (F F' : PtMap A a0 B b0)
  (e : Id (Maps[A, a0, B, b0].PMO) (Maps[A, a0, B, b0].loop F) (Maps[A, a0, B, b0].loop F')) : Id (PtMap A a0 B b0) F F' =
  ap (Maps[A, a0, B, b0].Over[Maps[A, a0, B, b0].loop F].Unloop) (PtMap A a0 B b0) (\ w -> w.1)
    (F, refl (Maps[A, a0, B, b0].loop F)) (F', e)
    (pathC (Maps[A, a0, B, b0].Over[Maps[A, a0, B, b0].loop F].Unloop)
       (Maps[A, a0, B, b0].Over[Maps[A, a0, B, b0].loop F].cor11 c cA tB)
       (F, refl (Maps[A, a0, B, b0].loop F)) (F', e)) ;

-- associativity (J on the three pointings; then both sides are refl)
ptcomp-assoc (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (D : U l) (d0 : D)
  (F : PtMap A a0 B b0) (G : PtMap B b0 C c0) (H : PtMap C c0 D d0) :
  Id (PtMap A a0 D d0) (ptcomp A a0 C c0 D d0 (ptcomp A a0 B b0 C c0 F G) H) (ptcomp A a0 B b0 D d0 F (ptcomp B b0 C c0 D d0 G H)) =
  idJ B (F.1 a0) (\ b1 p1 -> (c1 : C) (G1 : PtMap B b1 C c1) (d1 : D) (H1 : PtMap C c1 D d1) ->
      Id (PtMap A a0 D d1) (ptcomp A a0 C c1 D d1 (ptcomp A a0 B b1 C c1 (F.1, p1) G1) H1)
        (ptcomp A a0 B b1 D d1 (F.1, p1) (ptcomp B b1 C c1 D d1 G1 H1)))
    (\ c1 G1 -> idJ C (G1.1 (F.1 a0)) (\ c2 p2 -> (d1 : D) (H1 : PtMap C c2 D d1) ->
        Id (PtMap A a0 D d1) (ptcomp A a0 C c2 D d1 (ptcomp A a0 B (F.1 a0) C c2 (F.1, refl (F.1 a0)) (G1.1, p2)) H1)
          (ptcomp A a0 B (F.1 a0) D d1 (F.1, refl (F.1 a0)) (ptcomp B (F.1 a0) C c2 D d1 (G1.1, p2) H1)))
      (\ d1 H1 -> idJ D (H1.1 (G1.1 (F.1 a0))) (\ d2 p3 ->
          Id (PtMap A a0 D d2) (ptcomp A a0 C (G1.1 (F.1 a0)) D d2 (ptcomp A a0 B (F.1 a0) C (G1.1 (F.1 a0)) (F.1, refl (F.1 a0)) (G1.1, refl (G1.1 (F.1 a0)))) (H1.1, p3))
            (ptcomp A a0 B (F.1 a0) D d2 (F.1, refl (F.1 a0)) (ptcomp B (F.1 a0) C (G1.1 (F.1 a0)) D d2 (G1.1, refl (G1.1 (F.1 a0))) (H1.1, p3))))
        (refl (\ a -> H1.1 (G1.1 (F.1 a)), refl (H1.1 (G1.1 (F.1 a0))))) d1 H1.2)
      c1 G1.2)
    b0 F.2 c0 G d0 H ;

-- constant maps
ptconst (A : U l) (a0 : A) (B : U l) (b0 : B) : PtMap A a0 B b0 = (\ a -> b0, refl b0) ;
ap-const (A B : U l) (b : B) (x y : A) (p : Id A x y) : Id (Id B b b) (ap A B (\ a -> b) x y p) (refl b) =
  idJ A x (\ y1 p1 -> Id (Id B b b) (ap A B (\ a -> b) x y1 p1) (refl b)) (refl (refl b)) y p ;
comp-const-r (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (F : PtMap A a0 B b0) :
  Id (PtMap A a0 C c0) (ptcomp A a0 B b0 C c0 F (ptconst B b0 C c0)) (ptconst A a0 C c0) =
  ap (Id C c0 c0) (PtMap A a0 C c0) (\ e -> (\ a -> c0, e)) (ap B C (\ b -> c0) (F.1 a0) b0 F.2) (refl c0)
    (ap-const B C c0 (F.1 a0) b0 F.2) ;
comp-const-l (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (G : PtMap B b0 C c0) :
  Id (PtMap A a0 C c0) (ptcomp A a0 B b0 C c0 (ptconst A a0 B b0) G) (ptconst A a0 C c0) =
  ptmap-path A a0 C c0 (\ a -> G.1 b0) (\ a -> c0) (trans C (G.1 b0) (G.1 b0) c0 (refl (G.1 b0)) G.2) (refl c0)
    (\ a -> trans C (G.1 b0) (G.1 b0) c0 (refl (G.1 b0)) G.2)
    (refl (trans C (G.1 b0) (G.1 b0) c0 (refl (G.1 b0)) G.2)) ;
loop-const (A : U l) (a0 : A) (B : U l) (b0 : B) :
  Id (Maps[A, a0, B, b0].PMO) (Maps[A, a0, B, b0].loop (ptconst A a0 B b0)) (ptconst (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0)) =
  ptmap-path (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) (Maps[A, a0, B, b0].loop (ptconst A a0 B b0)).1 (\ q -> refl b0)
    (Maps[A, a0, B, b0].loop (ptconst A a0 B b0)).2 (refl (refl b0))
    (\ q -> transH (Maps[A, a0, B, b0].loop-ap (ptconst A a0 B b0) q)
       (transH (trans-refl-l B b0 b0 (ap A B (\ a -> b0) a0 a0 q)) (ap-const A B b0 a0 a0 q)))
    (refl (refl (refl b0))) ;

-- maps with equal loopings are equal (Corollary 10 at m = -1: Unloop is a
-- proposition), over a c-connected A into a (2c+3)-truncated B
unique-loop1 (c : Nat) (A : U l) (a0 : A) (B : U l) (b0 : B) (cA : isConn (suc (suc c)) A)
  (tB : isTrunc (N.plus (suc c) (N.plus (suc c) (suc zero))) B) (F F' : PtMap A a0 B b0)
  (e : Id (Maps[A, a0, B, b0].PMO) (Maps[A, a0, B, b0].loop F) (Maps[A, a0, B, b0].loop F')) : Id (PtMap A a0 B b0) F F' =
  ap (Maps[A, a0, B, b0].Over[Maps[A, a0, B, b0].loop F].Unloop) (PtMap A a0 B b0) (\ w -> w.1)
    (F, refl (Maps[A, a0, B, b0].loop F)) (F', e)
    (trunc-one-prop (Maps[A, a0, B, b0].Over[Maps[A, a0, B, b0].loop F].Unloop)
       (Maps[A, a0, B, b0].Over[Maps[A, a0, B, b0].loop F].Levels[c, suc zero, cA, tB].cor10)
       (F, refl (Maps[A, a0, B, b0].loop F)) (F', e)) ;
