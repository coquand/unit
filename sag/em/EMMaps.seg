-- Homomorphisms of abelian groups and their deloopings (DW1 §4.1: the
-- elimination principle of K(A, n)).  KK[A] indexes K(A, m) for all m,
-- with K(A, 0) = A, and e m : Omega K(A, m+1) ~pt K(A, m) (the band for
-- m = 0, EMSpace.loops above).  For h : A -> B,
--   K h 0 = h,  K h (m+1) = the delooping of  e_B^-1 o K h m o e_A,
-- by Corollary 12 for m = 0 (the band is a group isomorphism, so the map
-- is multiplicative) and Corollary 11 for m >= 1 (K(B, m+2) is
-- (m+2)-truncated, m+2 <= 2(m+1)); loopK m records  loop (K h (m+1)) =
-- e_A ; K h m ; e_B^-1.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Torsor[l] ;
module N = NatArith[l] ;
module EMf = EM[l] ;

Hom (Ga Gb : Ab) : U l = (h : Ga.A -> Gb.A) * ((x y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) ;

hom-unit (Ga Gb : Ab) (h : Hom Ga Gb) : Id Gb.A (h.1 Ga.o) Gb.o =
  transH (AbL[Gb].solve (h.1 Ga.o) (h.1 Ga.o) (h.1 Ga.o)
            (symH (transH (apH h.1 (symH (Ga.unitr Ga.o))) (h.2 Ga.o Ga.o))))
         (Gb.invr (h.1 Ga.o)) ;

module KK (Gr : Ab) {
  module ES = EMf.EMSpace[Gr] ;
  module E1 = EMf.EM1[Gr] ;
  K : Nat -> U l = split { zero -> Gr.A ; suc n -> ES.K n } ;
  pt : (m : Nat) -> K m = split { zero -> Gr.o ; suc n -> ES.pt n } ;
  e : (m : Nat) -> PtEquiv (Id (K (suc m)) (pt (suc m)) (pt (suc m))) (refl (pt (suc m))) (K m) (pt m) = split {
    zero -> ((ES.loop0.1, E1.band-unit E1.k0), ES.loop0.2) ;
    suc n -> ES.loops n } ;
  conn (m : Nat) : isConn (suc (suc m)) (K (suc m)) = ES.conn m ;
  trunc (m : Nat) : isTrunc (suc (suc (suc m))) (K (suc m)) = ES.trunc m ;
} ;

module KMap (Ga Gb : Ab) (h : Hom Ga Gb) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  map0 : PtMap Ga.A Ga.o Gb.A Gb.o = (h.1, hom-unit Ga Gb h) ;
  -- e_A ; F ; e_B^-1
  conj (m : Nat) (F : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) : Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO =
    ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (B.K m) (B.pt m) ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m)))
      (ptcomp ((Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (A.e m).1 F)
      (pt-inv ((Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m)))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (B.e m)).1 ;

  -- level 1: Corollary 12.  On loops, conj 0 map0 is c0 = unband o h o band
  c0 (p : (Id (A.E1.K1) (A.E1.k0) (A.E1.k0))) : (Id (B.E1.K1) (B.E1.k0) (B.E1.k0)) = B.E1.unband B.E1.k0 (h.1 (A.E1.band A.E1.k0 p)) ;
  c0-conj (p : (Id (A.E1.K1) (A.E1.k0) (A.E1.k0))) : Id (Id (B.E1.K1) (B.E1.k0) (B.E1.k0)) ((conj zero map0).1 p) (c0 p) = refl (c0 p) ;
  -- c0 is multiplicative: the band is a group isomorphism
  c0-mult (p q : (Id (A.E1.K1) (A.E1.k0) (A.E1.k0))) : Id (Id (B.E1.K1) (B.E1.k0) (B.E1.k0)) (c0 (trans (A.E1.K1) (A.E1.k0) (A.E1.k0) (A.E1.k0) p q)) (trans (B.E1.K1) (B.E1.k0) (B.E1.k0) (B.E1.k0) (c0 p) (c0 q)) =
    B.E1.band-inj B.E1.k0 (c0 (trans (A.E1.K1) (A.E1.k0) (A.E1.k0) (A.E1.k0) p q)) (trans (B.E1.K1) (B.E1.k0) (B.E1.k0) (B.E1.k0) (c0 p) (c0 q))
      (calc Gb.A {
        B.E1.band B.E1.k0 (c0 (trans (A.E1.K1) (A.E1.k0) (A.E1.k0) (A.E1.k0) p q))
          =< B.E1.band-unband B.E1.k0 (h.1 (A.E1.band A.E1.k0 (trans (A.E1.K1) (A.E1.k0) (A.E1.k0) (A.E1.k0) p q))) >
        h.1 (A.E1.band A.E1.k0 (trans (A.E1.K1) (A.E1.k0) (A.E1.k0) (A.E1.k0) p q))
          =< apH h.1 (A.E1.band-hom A.E1.k0 p q) >
        h.1 (Ga.add (A.E1.band A.E1.k0 p) (A.E1.band A.E1.k0 q))
          =< h.2 (A.E1.band A.E1.k0 p) (A.E1.band A.E1.k0 q) >
        Gb.add (h.1 (A.E1.band A.E1.k0 p)) (h.1 (A.E1.band A.E1.k0 q))
          =< symH (apH (\ c -> Gb.add c (h.1 (A.E1.band A.E1.k0 q))) (B.E1.band-unband B.E1.k0 (h.1 (A.E1.band A.E1.k0 p)))) >
        Gb.add (B.E1.band B.E1.k0 (c0 p)) (h.1 (A.E1.band A.E1.k0 q))
          =< symH (apH (Gb.add (B.E1.band B.E1.k0 (c0 p))) (B.E1.band-unband B.E1.k0 (h.1 (A.E1.band A.E1.k0 q)))) >
        Gb.add (B.E1.band B.E1.k0 (c0 p)) (B.E1.band B.E1.k0 (c0 q))
          =< symH (B.E1.band-hom B.E1.k0 (c0 p) (c0 q)) >
        B.E1.band B.E1.k0 (trans (B.E1.K1) (B.E1.k0) (B.E1.k0) (B.E1.k0) (c0 p) (c0 q)) }) ;
  mult0 (p q : (Id (A.ES.K zero) (A.ES.pt zero) (A.ES.pt zero))) :
    Id (Id (B.ES.K zero) (B.ES.pt zero) (B.ES.pt zero)) ((conj zero map0).1 (trans (A.ES.K zero) (A.ES.pt zero) (A.ES.pt zero) (A.ES.pt zero) p q)) (trans (B.ES.K zero) (B.ES.pt zero) (B.ES.pt zero) (B.ES.pt zero) ((conj zero map0).1 p) ((conj zero map0).1 q)) =
    transH (c0-conj (trans (A.ES.K zero) (A.ES.pt zero) (A.ES.pt zero) (A.ES.pt zero) p q)) (transH (c0-mult p q)
      (symH (transH (apH (\ u -> trans (B.ES.K zero) (B.ES.pt zero) (B.ES.pt zero) (B.ES.pt zero) u ((conj zero map0).1 q)) (c0-conj p)) (apH (trans (B.ES.K zero) (B.ES.pt zero) (B.ES.pt zero) (B.ES.pt zero) (c0 p)) (c0-conj q))))) ;
  cell0 : isContr (Maps[A.K (suc zero), A.pt (suc zero), B.K (suc zero), B.pt (suc zero)].Over[conj zero map0].Unloop) =
    Maps[A.K (suc zero), A.pt (suc zero), B.K (suc zero), B.pt (suc zero)].Over[conj zero map0].Mult[A.conn zero, B.trunc zero, mult0].cor12 ;

  -- higher levels: Corollary 11
  tB (n : Nat) : isTrunc (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) (B.K (suc (suc n))) =
    trunc-index (B.K (suc (suc n))) (N.plus n (suc (suc (suc (suc n))))) (N.plus (suc (suc n)) (N.plus (suc (suc n)) zero)) (EMf.idx n)
      (trunc-lift (suc (suc (suc (suc n)))) (B.K (suc (suc n))) (B.trunc (suc n)) n) ;
  cellS (n : Nat) (F : PtMap (A.K (suc n)) (A.pt (suc n)) (B.K (suc n)) (B.pt (suc n))) :
    isContr (Maps[A.K (suc (suc n)), A.pt (suc (suc n)), B.K (suc (suc n)), B.pt (suc (suc n))].Over[conj (suc n) F].Unloop) =
    Maps[A.K (suc (suc n)), A.pt (suc (suc n)), B.K (suc (suc n)), B.pt (suc (suc n))].Over[conj (suc n) F].cor11 (suc n)
      (A.conn (suc n)) (tB n) ;

  Kmap : (n : Nat) -> PtMap (A.K (suc n)) (A.pt (suc n)) (B.K (suc n)) (B.pt (suc n)) = split {
    zero -> cell0.1.1 ;
    suc n | r -> (cellS n r).1.1 } ;
  K : (m : Nat) -> PtMap (A.K m) (A.pt m) (B.K m) (B.pt m) = split { zero -> map0 ; suc n -> Kmap n } ;
  loopK : (m : Nat) -> Id (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO)
      (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (K (suc m))) (conj m (K m)) = split {
    zero -> symH cell0.1.2 ;
    suc n -> symH (cellS n (Kmap n)).1.2 } ;
} ;
