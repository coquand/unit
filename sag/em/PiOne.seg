-- π₁ of a pointed type as a group, and π₁ of a pointed map as a
-- homomorphism.
--   π₁(Y, y0) = the loops at y0 modulo being merely equal (QGrp), with
--   path composition: the groupoid laws (tassoc, trans-refl-l, refl,
--   trans-sym-l, trans-sym-r).
--   For F : (Y, y0) ->pt (Z, z0), loop F q = F0^-1 . ap F q . F0
--   (DeloopMaps.loop-ap) preserves composition: by J on the pointing
--   F0 it is ap F up to refl, and ap preserves trans (ap-trans).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ; open Lemma4[l] ; open DeloopMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Gp = Groupoid[l] ;

module PiOne (Y : U l) (y0 : Y) {
  O : U l = Id Y y0 y0 ;
  Same (u v : O) : U l = Tr.Trunc[Id O u v].carrier ;
  same-prop (u v : O) : isProp (Same u v) = Tr.Trunc[Id O u v].proposition ;
  same-refl (u : O) : Same u u = Tr.Trunc[Id O u u].inc (refl u) ;
  same-sym (u v : O) (h : Same u v) : Same v u = TC.map (Id O u v) (Id O v u) (sym O u v) h ;
  same-trans (u v w : O) (h : Same u v) (k : Same v w) : Same u w = TC.map2 (Id O u v) (Id O v w) (Id O u w) (trans O u v w) h k ;
  comp (u v : O) : O = trans Y y0 y0 y0 u v ;
  rev (u : O) : O = sym Y y0 y0 u ;
  comp-resp (a a' b b' : O) (r : Same a a') (s : Same b b') : Same (comp a b) (comp a' b') =
    TC.map2 (Id O a a') (Id O b b') (Id O (comp a b) (comp a' b'))
      (\ p q -> transH (apH (\ z -> comp z b) p) (apH (comp a') q)) r s ;
  rev-resp (a a' : O) (r : Same a a') : Same (rev a) (rev a') = TC.map (Id O a a') (Id O (rev a) (rev a')) (apH rev) r ;
  module P = QGrp[l].QGrp[O, Same, same-prop, same-refl, same-sym, same-trans, refl y0, comp, rev, comp-resp, rev-resp,
    \ x y z -> Gp.tassoc Y y0 y0 y0 x y y0 z, \ x -> trans-refl-l Y y0 y0 x, \ x -> refl x,
    \ x -> trans-sym-l Y y0 y0 x, \ x -> Gp.trans-sym-r Y y0 y0 x] ;
  grp : Grp = P.grp ;
  cls (u : O) : grp.G = P.cls u ;
} ;

-- conjugating ap by a path preserves composition
conj-mult (Y Z : U l) (y0 : Y) (f : Y -> Z) (p q : Id Y y0 y0) : (z0 : Z) (w : Id Z (f y0) z0) ->
  Id (Id Z z0 z0)
    (trans Z z0 (f y0) z0 (sym Z (f y0) z0 w) (trans Z (f y0) (f y0) z0 (ap Y Z f y0 y0 (trans Y y0 y0 y0 p q)) w))
    (trans Z z0 z0 z0 (trans Z z0 (f y0) z0 (sym Z (f y0) z0 w) (trans Z (f y0) (f y0) z0 (ap Y Z f y0 y0 p) w))
                      (trans Z z0 (f y0) z0 (sym Z (f y0) z0 w) (trans Z (f y0) (f y0) z0 (ap Y Z f y0 y0 q) w))) =
  \ z0 w -> idJ Z (f y0) (\ z1 w1 -> Id (Id Z z1 z1)
      (trans Z z1 (f y0) z1 (sym Z (f y0) z1 w1) (trans Z (f y0) (f y0) z1 (ap Y Z f y0 y0 (trans Y y0 y0 y0 p q)) w1))
      (trans Z z1 z1 z1 (trans Z z1 (f y0) z1 (sym Z (f y0) z1 w1) (trans Z (f y0) (f y0) z1 (ap Y Z f y0 y0 p) w1))
                        (trans Z z1 (f y0) z1 (sym Z (f y0) z1 w1) (trans Z (f y0) (f y0) z1 (ap Y Z f y0 y0 q) w1))))
    (calc (Id Z (f y0) (f y0)) {
      trans Z (f y0) (f y0) (f y0) (refl (f y0)) (ap Y Z f y0 y0 (trans Y y0 y0 y0 p q))
        =< trans-refl-l Z (f y0) (f y0) (ap Y Z f y0 y0 (trans Y y0 y0 y0 p q)) >
      ap Y Z f y0 y0 (trans Y y0 y0 y0 p q)
        =< Gp.ap-trans Y Z f y0 y0 y0 p q >
      trans Z (f y0) (f y0) (f y0) (ap Y Z f y0 y0 p) (ap Y Z f y0 y0 q)
        =< symH (transH (apH (\ a -> trans Z (f y0) (f y0) (f y0) a (trans Z (f y0) (f y0) (f y0) (refl (f y0)) (ap Y Z f y0 y0 q)))
                           (trans-refl-l Z (f y0) (f y0) (ap Y Z f y0 y0 p)))
                        (apH (trans Z (f y0) (f y0) (f y0) (ap Y Z f y0 y0 p)) (trans-refl-l Z (f y0) (f y0) (ap Y Z f y0 y0 q)))) >
      trans Z (f y0) (f y0) (f y0) (trans Z (f y0) (f y0) (f y0) (refl (f y0)) (ap Y Z f y0 y0 p))
                                   (trans Z (f y0) (f y0) (f y0) (refl (f y0)) (ap Y Z f y0 y0 q)) }) z0 w ;

module Induced (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap Y y0 Z z0) {
  module PY = PiOne[Y, y0] ;
  module PZ = PiOne[Z, z0] ;
  module MF = Maps[Y, y0, Z, z0] ;
  L (q : PY.O) : PZ.O = (MF.loop F).1 q ;
  -- loop F preserves composition
  loop-mult (p q : PY.O) : Id PZ.O (L (PY.comp p q)) (PZ.comp (L p) (L q)) = calc PZ.O {
    L (PY.comp p q) =< MF.loop-ap F (PY.comp p q) >
    trans Z z0 (F.1 y0) z0 (sym Z (F.1 y0) z0 F.2) (trans Z (F.1 y0) (F.1 y0) z0 (ap Y Z F.1 y0 y0 (PY.comp p q)) F.2)
      =< conj-mult Y Z y0 F.1 p q z0 F.2 >
    PZ.comp (trans Z z0 (F.1 y0) z0 (sym Z (F.1 y0) z0 F.2) (trans Z (F.1 y0) (F.1 y0) z0 (ap Y Z F.1 y0 y0 p) F.2))
            (trans Z z0 (F.1 y0) z0 (sym Z (F.1 y0) z0 F.2) (trans Z (F.1 y0) (F.1 y0) z0 (ap Y Z F.1 y0 y0 q) F.2))
      =< symH (transH (apH (PZ.comp (L p)) (MF.loop-ap F q))
                      (apH (\ a -> PZ.comp a (trans Z z0 (F.1 y0) z0 (sym Z (F.1 y0) z0 F.2) (trans Z (F.1 y0) (F.1 y0) z0 (ap Y Z F.1 y0 y0 q) F.2)))
                         (MF.loop-ap F p))) >
    PZ.comp (L p) (L q) } ;
  module Mp = QGrp[l].Map[PY.O, PY.Same, PY.same-prop, PY.same-refl, PY.same-sym, PY.same-trans,
    PZ.O, PZ.Same, PZ.same-prop, PZ.same-refl, PZ.same-sym, PZ.same-trans, L, \ a b -> TC.map (Id PY.O a b) (Id PZ.O (L a) (L b)) (apH L)] ;
  -- π₁ F
  map (x : PY.grp.G) : PZ.grp.G = Mp.map x ;
  map-cls (q : PY.O) : Id PZ.grp.G (map (PY.cls q)) (PZ.cls (L q)) = Mp.map-cls q ;
  hom : QGrp[l].GHom PY.grp PZ.grp = (map, \ x y ->
    PY.P.Q.induction @l (\ x1 -> Id PZ.grp.G (map (PY.grp.mul x1 y)) (PZ.grp.mul (map x1) (map y)))
      (\ x1 -> PZ.P.Q.set (map (PY.grp.mul x1 y)) (PZ.grp.mul (map x1) (map y))) (\ a ->
    PY.P.Q.induction @l (\ y1 -> Id PZ.grp.G (map (PY.grp.mul (PY.cls a) y1)) (PZ.grp.mul (map (PY.cls a)) (map y1)))
      (\ y1 -> PZ.P.Q.set (map (PY.grp.mul (PY.cls a) y1)) (PZ.grp.mul (map (PY.cls a)) (map y1))) (\ b -> calc PZ.grp.G {
      map (PY.grp.mul (PY.cls a) (PY.cls b)) =< apH map (PY.P.cls-mul a b) > map (PY.cls (PY.comp a b))
        =< map-cls (PY.comp a b) > PZ.cls (L (PY.comp a b))
        =< apH PZ.cls (loop-mult a b) > PZ.cls (PZ.comp (L a) (L b))
        =< symH (PZ.P.cls-mul (L a) (L b)) > PZ.grp.mul (PZ.cls (L a)) (PZ.cls (L b))
        =< symH (transH (apH (\ u -> PZ.grp.mul u (map (PY.cls b))) (map-cls a)) (apH (PZ.grp.mul (PZ.cls (L a))) (map-cls b))) >
      PZ.grp.mul (map (PY.cls a)) (map (PY.cls b)) }) y) x) ;
} ;
