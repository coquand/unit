-- CCA Lemma B.0.5 (in the degrees used) and the missing Lemma B.0.7, on
-- the Čech complexes: for a family over X of short exact sequences
-- 0 -> A x -> B x -> C x -> 0 whose C-cochains lift to B-cochains (as for
-- B = A^S over a Stone cover: ccacoh/LiftStone), the sequence
--     Ȟⁿ(X, Y, B) -p*-> Ȟⁿ(X, Y, C) -δ-> Ȟⁿ⁺¹(X, Y, A)
-- is exact and δ is a homomorphism; δ is onto when Ȟⁿ⁺¹(X, Y, B) = 0.
-- (B.0.6 is the case B = A^Y, where Ȟⁿ⁺¹(B) = 0 is Lemma B.0.2.)
-- It is Snake on the cochain groups Ch-ab (CechGroups): i, p act by
-- composition (CechMap), injectivity and exactness hold pointwise (the
-- fibres of i are propositions, so pointwise mere preimages are a
-- cochain), d d = 0 is Cochains.delta-delta.  δ kills the coboundaries of
-- Ȟⁿ(C): for n = 0 there are none; for n = j+1, u = d psi with psi lifting
-- to Psi, and d Psi is a lift of u that is a cocycle.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module Cc = Cochains[l] ;
module CG = CechGroups[l] ;

module CechLES (X : U l) (Y : X -> U l) (Ga Gb Gc : X -> Ab) (i : (x : X) -> Hom (Ga x) (Gb x)) (p : (x : X) -> Hom (Gb x) (Gc x))
  (inj : (x : X) -> Bj.Injective (i x).1)
  (pi0 : (x : X) (a : (Ga x).A) -> Id (Gc x).A ((p x).1 ((i x).1 a)) (Gc x).o)
  (ex : (x : X) (b : (Gb x).A) -> Id (Gc x).A ((p x).1 b) (Gc x).o -> Tr.Trunc[Bj.Fibre (i x).1 b].carrier)
  (lifts : (k : Nat) (phi : Cc.Cech[X, Y, Gc].Ch (suc k)) -> Tr.Trunc[(Phi : Cc.Cech[X, Y, Gb].Ch (suc k)) *
     ((x : X) (t : Cc.Cochains[Gb x, Y x].Tup (suc k)) -> Id (Gc x).A ((p x).1 (Phi x t)) (phi x t))].carrier)
  (n : Nat) {
  module GA = CG.CechGrp[X, Y, Ga] ;
  module GB = CG.CechGrp[X, Y, Gb] ;
  module GC = CG.CechGrp[X, Y, Gc] ;
  module MI = CG.CechMap[X, Y, Ga, Gb, i] ;
  module MP = CG.CechMap[X, Y, Gb, Gc, p] ;
  -- pointwise facts for whole cochains
  inj-ch (j : Nat) : Bj.Injective (MI.M j).1 = \ a a' e ->
    FL.funext X (\ x -> Cc.Cochains[Ga x, Y x].C j) a a' (\ x -> FL.funext (Cc.Cochains[Ga x, Y x].Tup j) (\ t -> (Ga x).A) (a x) (a' x) (\ t ->
      inj x (a x t) (a' x t) (happly (Cc.Cochains[Gb x, Y x].Tup j) (\ t1 -> (Gb x).A) ((MI.M j).1 a x) ((MI.M j).1 a' x)
        (happly X (\ x1 -> Cc.Cochains[Gb x1, Y x1].C j) ((MI.M j).1 a) ((MI.M j).1 a') e x) t))) ;
  pi-ch (j : Nat) (a : GA.CB.Ch j) : Id (GC.CB.Ch j) ((MP.M j).1 ((MI.M j).1 a)) (GC.Ch-ab j).o =
    FL.funext X (\ x -> Cc.Cochains[Gc x, Y x].C j) ((MP.M j).1 ((MI.M j).1 a)) (GC.Ch-ab j).o (\ x ->
      FL.funext (Cc.Cochains[Gc x, Y x].Tup j) (\ t -> (Gc x).A) ((MP.M j).1 ((MI.M j).1 a) x) ((GC.Ch-ab j).o x) (\ t -> pi0 x (a x t))) ;
  module ExCh (j : Nat) (b : GB.CB.Ch j) (e : Id (GC.CB.Ch j) ((MP.M j).1 b) (GC.Ch-ab j).o) {
    at (x : X) (t : Cc.Cochains[Gb x, Y x].Tup j) : Bj.Fibre (i x).1 (b x t) =
      TC.rec (Bj.Fibre (i x).1 (b x t)) @l (Bj.Fibre (i x).1 (b x t)) (Snake[l].fibre-prop (Ga x) (Gb x) (i x) (inj x) (b x t)) (\ w -> w)
        (ex x (b x t) (happly (Cc.Cochains[Gc x, Y x].Tup j) (\ t1 -> (Gc x).A) ((MP.M j).1 b x) ((GC.Ch-ab j).o x)
           (happly X (\ x1 -> Cc.Cochains[Gc x1, Y x1].C j) ((MP.M j).1 b) (GC.Ch-ab j).o e x) t)) ;
    fib : Bj.Fibre (MI.M j).1 b = (\ x t -> (at x t).1,
      FL.funext X (\ x -> Cc.Cochains[Gb x, Y x].C j) (\ x t -> (i x).1 (at x t).1) b (\ x ->
        FL.funext (Cc.Cochains[Gb x, Y x].Tup j) (\ t -> (Gb x).A) (\ t -> (i x).1 (at x t).1) (b x) (\ t -> (at x t).2))) ;
  } ;
  ex-ch (j : Nat) (b : GB.CB.Ch j) (e : Id (GC.CB.Ch j) ((MP.M j).1 b) (GC.Ch-ab j).o) : Tr.Trunc[Bj.Fibre (MI.M j).1 b].carrier =
    Tr.Trunc[Bj.Fibre (MI.M j).1 b].inc ExCh[j, b, e].fib ;
  dd-B (j : Nat) (b : GB.CB.Ch j) : Id (GB.CB.Ch (suc (suc j))) ((GB.dhom (suc j)).1 ((GB.dhom j).1 b)) (GB.Ch-ab (suc (suc j))).o =
    FL.funext X (\ x -> Cc.Cochains[Gb x, Y x].C (suc (suc j))) ((GB.dhom (suc j)).1 ((GB.dhom j).1 b)) (GB.Ch-ab (suc (suc j))).o (\ x ->
      FL.funext (Cc.Cochains[Gb x, Y x].Tup (suc (suc j))) (\ t -> (Gb x).A) ((GB.dhom (suc j)).1 ((GB.dhom j).1 b) x) ((GB.Ch-ab (suc (suc j))).o x)
        (Cc.Cochains[Gb x, Y x].delta-delta j (b x))) ;
  lift-ch (k : Nat) (c : GC.CB.Ch (suc k)) : Tr.Trunc[Bj.Fibre (MP.M (suc k)).1 c].carrier =
    TC.map ((Phi : GB.CB.Ch (suc k)) * ((x : X) (t : Cc.Cochains[Gb x, Y x].Tup (suc k)) -> Id (Gc x).A ((p x).1 (Phi x t)) (c x t)))
      (Bj.Fibre (MP.M (suc k)).1 c)
      (\ w -> (w.1, FL.funext X (\ x -> Cc.Cochains[Gc x, Y x].C (suc k)) ((MP.M (suc k)).1 w.1) c (\ x ->
         FL.funext (Cc.Cochains[Gc x, Y x].Tup (suc k)) (\ t -> (Gc x).A) ((MP.M (suc k)).1 w.1 x) (c x) (w.2 x)))) (lifts k c) ;

  module S = Snake[l].Snake[GA.Ch-ab (suc n), GA.Ch-ab (suc (suc n)), GA.Ch-ab (suc (suc (suc n))),
    GB.Ch-ab (suc n), GB.Ch-ab (suc (suc n)), GB.Ch-ab (suc (suc (suc n))), GC.Ch-ab (suc n), GC.Ch-ab (suc (suc n)),
    GA.dhom (suc n), GA.dhom (suc (suc n)), GB.dhom (suc n), GB.dhom (suc (suc n)), GC.dhom (suc n),
    MI.M (suc n), MI.M (suc (suc n)), MI.M (suc (suc (suc n))), MP.M (suc n), MP.M (suc (suc n)),
    \ a -> MI.sq (suc n) a, \ a -> MI.sq (suc (suc n)) a, \ b -> MP.sq (suc n) b, dd-B (suc n),
    inj-ch (suc (suc n)), inj-ch (suc (suc (suc n))), pi-ch (suc n), ex-ch (suc n), ex-ch (suc (suc n)), pi-ch (suc (suc n)),
    lift-ch n, GA.Bnd (suc n), GA.bnd-prop (suc n), GA.bnd-0 (suc n), GA.bnd-add (suc n), GA.bnd-inv (suc n),
    \ z r -> r, \ z r -> r] ;

  -- the coboundaries of Ȟⁿ(C) have lifts that are cocycles
  bnd-lift : (k : Nat) (u : GC.Z[k].K.ab.A) -> GC.Bnd k u ->
    Tr.Trunc[(F : Bj.Fibre (MP.M (suc k)).1 u.1) * Id (GB.CB.Ch (suc (suc k))) ((GB.dhom (suc k)).1 F.1) (GB.Ch-ab (suc (suc k))).o].carrier = split {
    zero -> \ u r -> Tr.Trunc[(F : Bj.Fibre (MP.M (suc zero)).1 u.1) * Id (GB.CB.Ch (suc (suc zero))) ((GB.dhom (suc zero)).1 F.1) (GB.Ch-ab (suc (suc zero))).o].inc
      (((GB.Ch-ab (suc zero)).o, transH (hom-unit (GB.Ch-ab (suc zero)) (GC.Ch-ab (suc zero)) (MP.M (suc zero))) (symH r)),
       hom-unit (GB.Ch-ab (suc zero)) (GB.Ch-ab (suc (suc zero))) (GB.dhom (suc zero))) ;
    suc j -> \ u r -> TC.bind (Bj.Fibre (GC.dhom (suc j)).1 u.1)
      ((F : Bj.Fibre (MP.M (suc (suc j))).1 u.1) * Id (GB.CB.Ch (suc (suc (suc j)))) ((GB.dhom (suc (suc j))).1 F.1) (GB.Ch-ab (suc (suc (suc j)))).o)
      (\ w -> TC.map (Bj.Fibre (MP.M (suc j)).1 w.1)
         ((F : Bj.Fibre (MP.M (suc (suc j))).1 u.1) * Id (GB.CB.Ch (suc (suc (suc j)))) ((GB.dhom (suc (suc j))).1 F.1) (GB.Ch-ab (suc (suc (suc j)))).o)
         (\ v -> (((GB.dhom (suc j)).1 v.1, transH (symH (MP.sq (suc j) v.1)) (transH (apH (GC.dhom (suc j)).1 v.2) w.2)), dd-B (suc j) v.1))
         (lift-ch j w.1)) r } ;
  kills (u : S.ZC.C) (r : GC.Bnd n u) : Id S.HA.QG.grp.G (S.delta0 u) S.HA.QG.grp.e =
    TC.rec ((F : Bj.Fibre (MP.M (suc n)).1 u.1) * Id (GB.CB.Ch (suc (suc n))) ((GB.dhom (suc n)).1 F.1) (GB.Ch-ab (suc (suc n))).o) @l
      (Id S.HA.QG.grp.G (S.delta0 u) S.HA.QG.grp.e) (S.HA.QG.grp.setG (S.delta0 u) S.HA.QG.grp.e)
      (\ w -> S.Kill[u, w.1, w.2].unit) (bnd-lift n u r) ;
  module OQ = S.OnQuot[GC.Bnd n, GC.bnd-prop n, GC.bnd-0 n, GC.bnd-add n, GC.bnd-inv n, kills] ;
  -- the connecting homomorphism  Ȟⁿ(C) -> Ȟⁿ⁺¹(A)
  delta : QGrp[l].GHom (GC.H[n].Q.QG.grp) (GA.H[suc n].Q.QG.grp) = OQ.delta-hom ;
  pstar : QGrp[l].GHom (GB.H[n].Q.QG.grp) (GC.H[n].Q.QG.grp) = MP.hstar n ;
  -- exactness
  zmap-pZ (w : GB.Z[n].K.ab.A) : Id GC.Z[n].K.ab.A (MP.Zmap n w) (S.pZ w) = GC.Z[n].K.eqA (MP.Zmap n w) (S.pZ w) (refl ((MP.M (suc n)).1 w.1)) ;
  delta-pstar (y : (GB.H[n].Q.QG.grp).G) : Id (GA.H[suc n].Q.QG.grp).G (delta.1 (pstar.1 y)) (GA.H[suc n].Q.QG.grp).e =
    GB.H[n].Q.QG.ind @l (\ y1 -> Id (GA.H[suc n].Q.QG.grp).G (delta.1 (pstar.1 y1)) (GA.H[suc n].Q.QG.grp).e)
      (\ y1 -> GA.H[suc n].Q.QG.grp.setG (delta.1 (pstar.1 y1)) (GA.H[suc n].Q.QG.grp).e) (\ w -> calc (GA.H[suc n].Q.QG.grp).G {
      delta.1 (pstar.1 (GB.H[n].Q.QG.cl w)) =< apH delta.1 (MP.Mq[n].map-cl w) > delta.1 (GC.H[n].Q.QG.cl (MP.Zmap n w))
        =< OQ.delta-cls (MP.Zmap n w) > S.delta0 (MP.Zmap n w)
        =< apH S.delta0 (zmap-pZ w) > S.delta0 (S.pZ w)
        =< S.delta-p w > (GA.H[suc n].Q.QG.grp).e }) y ;
  ker-im (y : (GC.H[n].Q.QG.grp).G) (h : Id (GA.H[suc n].Q.QG.grp).G (delta.1 y) (GA.H[suc n].Q.QG.grp).e) : Tr.Trunc[Bj.Fibre pstar.1 y].carrier =
    GC.H[n].Q.QG.ind @l (\ y1 -> Id (GA.H[suc n].Q.QG.grp).G (delta.1 y1) (GA.H[suc n].Q.QG.grp).e -> Tr.Trunc[Bj.Fibre pstar.1 y1].carrier)
      (\ y1 -> FL.isProp-Pi (Id (GA.H[suc n].Q.QG.grp).G (delta.1 y1) (GA.H[suc n].Q.QG.grp).e) (\ h1 -> Tr.Trunc[Bj.Fibre pstar.1 y1].carrier)
                 (\ h1 -> Tr.Trunc[Bj.Fibre pstar.1 y1].proposition))
      (\ u h1 -> TC.map ((w : GB.Z[n].K.ab.A) * Id GC.Z[n].K.ab.A (S.pZ w) u) (Bj.Fibre pstar.1 (GC.H[n].Q.QG.cl u))
         (\ v -> (GB.H[n].Q.QG.cl v.1, transH (MP.Mq[n].map-cl v.1) (apH GC.H[n].Q.QG.cl (transH (zmap-pZ v.1) v.2))))
         (S.ker-im u (transH (symH (OQ.delta-cls u)) h1))) y h ;
  -- δ is onto when Ȟⁿ⁺¹(B) = 0
  module Onto (vanB : GB.CB.Vanish (suc n)) {
    vB (b : GB.CB.Ch (suc (suc n))) (e : Id (GB.CB.Ch (suc (suc (suc n)))) ((GB.dhom (suc (suc n))).1 b) (GB.Ch-ab (suc (suc (suc n)))).o) :
      Tr.Trunc[Bj.Fibre (GB.dhom (suc n)).1 b].carrier =
      TC.map ((beta : GB.CB.Ch (suc n)) * GB.CB.Bounds (suc n) b beta) (Bj.Fibre (GB.dhom (suc n)).1 b)
        (\ w -> (w.1, FL.funext X (\ x -> Cc.Cochains[Gb x, Y x].C (suc (suc n))) ((GB.dhom (suc n)).1 w.1) b (\ x ->
           FL.funext (Cc.Cochains[Gb x, Y x].Tup (suc (suc n))) (\ t -> (Gb x).A) ((GB.dhom (suc n)).1 w.1 x) (b x) (w.2 x))))
        (vanB b (\ x s -> happly (Cc.Cochains[Gb x, Y x].Tup (suc (suc (suc n)))) (\ t1 -> (Gb x).A)
            ((GB.dhom (suc (suc n))).1 b x) ((GB.Ch-ab (suc (suc (suc n)))).o x)
            (happly X (\ x1 -> Cc.Cochains[Gb x1, Y x1].C (suc (suc (suc n)))) ((GB.dhom (suc (suc n))).1 b) (GB.Ch-ab (suc (suc (suc n)))).o e x) s)) ;
    onto (z : (GA.H[suc n].Q.QG.grp).G) : Tr.Trunc[Bj.Fibre delta.1 z].carrier =
      GA.H[suc n].Q.QG.ind @l (\ z1 -> Tr.Trunc[Bj.Fibre delta.1 z1].carrier) (\ z1 -> Tr.Trunc[Bj.Fibre delta.1 z1].proposition)
        (\ zz -> TC.map ((u : S.ZC.C) * Id S.HA.QG.grp.G (S.delta0 u) (S.HA.QG.cl zz)) (Bj.Fibre delta.1 (GA.H[suc n].Q.QG.cl zz))
           (\ v -> (GC.H[n].Q.QG.cl v.1, transH (OQ.delta-cls v.1) v.2)) (S.Onto[vB, zz].result)) z ;
  } ;
} ;
