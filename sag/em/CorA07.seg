-- CCA Cor. A.0.7 and Cor. A.0.8 as bijections of sets (degree 1, G not
-- necessarily abelian), completing the vanishing forms of CechNA.
-- Conventions of CechNA (left torsors, formulas mirrored, no inverses in
-- the statements).
--
-- The sets.
--   Ȟ¹(X, Y, G) (Def. 3.1.2) = cocycles (Cyc) modulo being cohomologous:
--     d ~ d'  iff merely iota : C0 with  iota y1 . d' y0 y1 = d y0 y1 . iota y0
--     (Conj; for d' the unit cocycle this is CechNA.Bounds).  An
--     equivalence relation (inverses for symmetry, products for
--     transitivity).
--   H¹(X, G) = ||(x : X) -> BG x||₀, the set quotient of Fam by merely
--     equal (Quotient, by replacement).
--   H¹(X, Y, G) (Def. 3.1.2 with Lemma 3.1.3) = the quotient of the
--     pointed families (alpha, merely beta : (x : X) -> Y x -> alpha x) by
--     the same relation; `forget` embeds it in H¹(X, G).
--
-- Ψ (Lemma A.0.4).  psi d x = the torsor CechNA.Psi of d x; it has the
--   points H, so Psi' d is a pointed family.  (iii) If d ~ d' by iota,
--   gamma |-> (y |-> gamma y . iota y) is an equivariant map
--   psi d x -> psi d' x, so psi d = psi d' (GTor.decode, funext).  Hence Ψ
--   descends to the quotients: psibar.
--
-- psibar is injective (Lemma A.0.5).  Let p : psi d = psi d'.  Two families
--   of points beta, beta' of one alpha give cohomologous cocycles of points
--   (Lemma A.0.2 (ii), `points-coh`: iota y = the a with a . beta' y = beta y;
--   both iota y1 . phi' y0 y1 and phi y0 y1 . iota y0 move beta' y0 to
--   beta y1).  And the cocycle of the points H of psi d is d itself
--   (`phi-H`: d y0 y1 moves H y0 = (y |-> d y y0) to H y1, the cocycle
--   condition).  So for every family of points b of psi d,
--   d ~ phi(psi d, H) ~ phi(psi d, b) (`reach-base`); by induction on p this
--   holds for the points of psi d', in particular H', and
--   phi(psi d', H') ~ d'.
--
-- psibar is surjective (Lemma A.0.6).  Given alpha with points beta, let
--   d = phi(alpha, beta).  Then p |-> (y |-> the a with a . beta y = p)
--   is an equivariant map alpha x -> psi d x (`a06`), so Psi' d is alpha.
--
-- Cor. A.0.7: psibar is a bijection (Bijection.Bij).
-- Cor. A.0.8: if H¹((x : X) * Y x, G o pr1) = 0, every alpha is merely
--   pointed over Y, so `forget` is also surjective, and
--   H¹(X, G) = H¹(X, Y, G) = Ȟ¹(X, Y, G).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open Group[l] ; open GTorsor[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module P1 = Prelude[l+] ; module Pa1 = Paths[l+] ;
module Q1 = Quotient[l+] ;
module B1 = Bijection[l+] ;

------------------------------------------------------------------------
-- cohomologous cocycles, for one x

module Conj (Gr : Grp) (Y : U l) {
  open Gr ;
  open GrpL[Gr] ;
  -- iota y1 . d' y0 y1 = d y0 y1 . iota y0
  Rel (d d' : Y -> Y -> G) (i : Y -> G) : U l = (y0 y1 : Y) -> Id G (mul (i y1) (d' y0 y1)) (mul (d y0 y1) (i y0)) ;
  rel-refl (d : Y -> Y -> G) : Rel d d (\ y -> e) = \ y0 y1 -> transH (unitl (d y0 y1)) (symH (unitr (d y0 y1))) ;
  -- d' = i1^-1 . (d . i0), so  i1^-1 . d = d' . i0^-1
  rel-sym (d d' : Y -> Y -> G) (i : Y -> G) (h : Rel d d' i) : Rel d' d (\ y -> inv (i y)) = \ y0 y1 -> symH (calc G {
    mul (d' y0 y1) (inv (i y0))
      =< apH (\ z -> mul z (inv (i y0))) (solve-l (d' y0 y1) (i y1) (mul (d y0 y1) (i y0)) (h y0 y1)) >
    mul (mul (inv (i y1)) (mul (d y0 y1) (i y0))) (inv (i y0))
      =< assoc (inv (i y1)) (mul (d y0 y1) (i y0)) (inv (i y0)) >
    mul (inv (i y1)) (mul (mul (d y0 y1) (i y0)) (inv (i y0)))
      =< apH (mul (inv (i y1))) (cancr' (i y0) (d y0 y1)) >
    mul (inv (i y1)) (d y0 y1) }) ;
  -- (i1 . j1) . d'' = i1 . (d' . j0) = (d . i0) . j0
  rel-trans (d d' d'' : Y -> Y -> G) (i j : Y -> G) (h : Rel d d' i) (k : Rel d' d'' j)
    : Rel d d'' (\ y -> mul (i y) (j y)) = \ y0 y1 -> calc G {
    mul (mul (i y1) (j y1)) (d'' y0 y1) =< assoc (i y1) (j y1) (d'' y0 y1) >
    mul (i y1) (mul (j y1) (d'' y0 y1)) =< apH (mul (i y1)) (k y0 y1) >
    mul (i y1) (mul (d' y0 y1) (j y0)) =< symH (assoc (i y1) (d' y0 y1) (j y0)) >
    mul (mul (i y1) (d' y0 y1)) (j y0) =< apH (\ z -> mul z (j y0)) (h y0 y1) >
    mul (mul (d y0 y1) (i y0)) (j y0) =< assoc (d y0 y1) (i y0) (j y0) >
    mul (d y0 y1) (mul (i y0) (j y0)) } ;
} ;

------------------------------------------------------------------------
-- Lemma A.0.4 (iii): cohomologous cocycles give equal torsors

module PsiMap (Y : U l) (hY : Tr.Trunc[Y].carrier) (Gr : Grp)
  (d : Y -> Y -> Gr.G) (c : (y0 y1 y2 : Y) -> Id Gr.G (Gr.mul (d y1 y2) (d y0 y1)) (d y0 y2))
  (d' : Y -> Y -> Gr.G) (c' : (y0 y1 y2 : Y) -> Id Gr.G (Gr.mul (d' y1 y2) (d' y0 y1)) (d' y0 y2))
  (i : Y -> Gr.G) (h : Conj[Gr, Y].Rel d d' i) {
  open Gr ;
  module S = Psi[Y, hY, Gr, d, c] ;
  module S' = Psi[Y, hY, Gr, d', c'] ;
  -- (g1 . i1) . d' = g1 . (d . i0) = (g1 . d) . i0 = g0 . i0
  cond (u : S.P) : S'.Cond (\ y -> mul (u.1 y) (i y)) = \ y0 y1 -> calc G {
    mul (mul (u.1 y1) (i y1)) (d' y0 y1) =< assoc (u.1 y1) (i y1) (d' y0 y1) >
    mul (u.1 y1) (mul (i y1) (d' y0 y1)) =< apH (mul (u.1 y1)) (h y0 y1) >
    mul (u.1 y1) (mul (d y0 y1) (i y0)) =< symH (assoc (u.1 y1) (d y0 y1) (i y0)) >
    mul (mul (u.1 y1) (d y0 y1)) (i y0) =< apH (\ z -> mul z (i y0)) (u.2 y0 y1) >
    mul (u.1 y0) (i y0) } ;
  map (u : S.P) : S'.P = (\ y -> mul (u.1 y) (i y), cond u) ;
  hom : GTor[Gr].Hom S.tor S'.tor = (map, \ a u ->
    S'.P-eq (map (S.act a u)) (S'.act a (map u)) (\ y -> assoc a (u.1 y) (i y))) ;
  path : Id (GTor[Gr].Tor) S.tor S'.tor = GTor[Gr].decode S.tor S'.tor hom ;
} ;

------------------------------------------------------------------------

module CorA07 (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (G : X -> Grp) {
  module C = CechNA[l].CechNA[X, Y, hY, G] ;

  -- Ȟ¹(X, Y, G)
  Cyc : U l = (d : C.C1) * C.Cocycle d ;
  Coh (u v : Cyc) : U l = Tr.Trunc[(i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x))].carrier ;
  coh-prop (u v : Cyc) : isProp (Coh u v) = Tr.Trunc[(i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x))].proposition ;
  coh-refl (u : Cyc) : Coh u u =
    Tr.Trunc[(i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (u.1 x) (i x))].inc
      (\ x y -> (G x).e, \ x -> Conj[G x, Y x].rel-refl (u.1 x)) ;
  coh-sym (u v : Cyc) (h : Coh u v) : Coh v u =
    TC.map ((i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x)))
      ((i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (v.1 x) (u.1 x) (i x)))
      (\ w -> (\ x y -> (G x).inv (w.1 x y), \ x -> Conj[G x, Y x].rel-sym (u.1 x) (v.1 x) (w.1 x) (w.2 x))) h ;
  coh-trans (u v w : Cyc) (h : Coh u v) (k : Coh v w) : Coh u w =
    TC.rec ((i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x))) @l (Coh u w) (coh-prop u w)
      (\ a -> TC.map ((j : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (v.1 x) (w.1 x) (j x)))
        ((i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (w.1 x) (i x)))
        (\ b -> (\ x y -> (G x).mul (a.1 x y) (b.1 x y),
                 \ x -> Conj[G x, Y x].rel-trans (u.1 x) (v.1 x) (w.1 x) (a.1 x) (b.1 x) (a.2 x) (b.2 x))) k) h ;
  module QC = Q1.Quot[Cyc, \ u v -> Coh u v, coh-prop, coh-refl, coh-sym, coh-trans] ;
  Cech : U l+ = QC.Q ;

  -- H¹(X, G) and H¹(X, Y, G)
  Fam : U l+ = (x : X) -> GTor[G x].Tor ;
  Same (a b : Fam) : U l+ = T1.Trunc[Id Fam a b].carrier ;
  same-prop (a b : Fam) : P1.isProp (Same a b) = T1.Trunc[Id Fam a b].proposition ;
  same-refl (a : Fam) : Same a a = T1.Trunc[Id Fam a a].inc (refl a) ;
  same-sym (a b : Fam) (h : Same a b) : Same b a =
    TC1.map (Id Fam a b) (Id Fam b a) (P1.sym Fam a b) h ;
  same-trans (a b c : Fam) (h : Same a b) (k : Same b c) : Same a c =
    TC1.rec (Id Fam a b) @(l+) (Same a c) (same-prop a c)
      (\ p -> TC1.map (Id Fam b c) (Id Fam a c) (P1.trans Fam a b c p) k) h ;
  module QF = Q1.Quot[Fam, Same, same-prop, same-refl, same-sym, same-trans] ;
  H1 : U l+ = QF.Q ;

  -- Lemma 3.1.3: alpha o pi = 0 iff alpha has points over Y
  Pointed (a : Fam) : U l = Tr.Trunc[(x : X) -> Y x -> (a x).1].carrier ;
  PFam : U l+ = (a : Fam) * Pointed a ;
  PSame (u v : PFam) : U l+ = Same u.1 v.1 ;
  module QY = Q1.Quot[PFam, PSame, \ u v -> same-prop u.1 v.1, \ u -> same-refl u.1,
    \ u v -> same-sym u.1 v.1, \ u v w -> same-trans u.1 v.1 w.1] ;
  H1Y : U l+ = QY.Q ;

  -- H¹(X, Y, G) is a subset of H¹(X, G)
  module Forget = QY.Descend[H1, QF.set, \ u -> QF.inc u.1, \ u v h -> QF.relates u.1 v.1 h] ;
  forget : H1Y -> H1 = Forget.map ;
  forget-injective : B1.Injective forget = \ q r ->
    QY.induction @(l+) (\ q -> Id H1 (forget q) (forget r) -> Id H1Y q r)
      (\ q -> FL1.isProp-Pi (Id H1 (forget q) (forget r)) (\ p -> Id H1Y q r) (\ p -> QY.set q r))
      (\ u -> QY.induction @(l+) (\ r -> Id H1 (forget (QY.inc u)) (forget r) -> Id H1Y (QY.inc u) r)
        (\ r -> FL1.isProp-Pi (Id H1 (forget (QY.inc u)) (forget r)) (\ p -> Id H1Y (QY.inc u) r) (\ p -> QY.set (QY.inc u) r))
        (\ v p -> QY.relates u v (QF.effective u.1 v.1
           (Pa1.transH (Pa1.symH (Forget.beta u)) (Pa1.transH p (Forget.beta v))))) r) q ;

  -- Ψ (Lemma A.0.4)
  psi (u : Cyc) : Fam = \ x -> Psi[Y x, hY x, G x, u.1 x, u.2 x].tor ;
  pts (u : Cyc) : (x : X) -> Y x -> (psi u x).1 = \ x -> Psi[Y x, hY x, G x, u.1 x, u.2 x].H ;
  psi' (u : Cyc) : PFam = (psi u, Tr.Trunc[(x : X) -> Y x -> (psi u x).1].inc (pts u)) ;
  respect (u v : Cyc) (h : Coh u v) : Same (psi u) (psi v) =
    TC.rec ((i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x))) @(l+) (Same (psi u) (psi v)) (same-prop (psi u) (psi v))
      (\ w -> T1.Trunc[Id Fam (psi u) (psi v)].inc (FL1.funext X (\ x -> GTor[G x].Tor) (psi u) (psi v)
        (\ x -> PsiMap[Y x, hY x, G x, u.1 x, u.2 x, v.1 x, v.2 x, w.1 x, w.2 x].path))) h ;
  module PsiBar = QC.Descend[H1Y, QY.set, \ u -> QY.inc (psi' u), \ u v h -> QY.relates (psi' u) (psi' v) (respect u v h)] ;
  psibar : Cech -> H1Y = PsiBar.map ;

  -- the cocycle of a family of points (Lemma A.0.2 (i))
  cyc (a : Fam) (b : (x : X) -> Y x -> (a x).1) : Cyc = (C.Points[a, b].phi, C.Points[a, b].cocycle) ;

  -- Lemma A.0.2 (ii): two families of points give cohomologous cocycles
  module PointsCoh (a : Fam) (b b' : (x : X) -> Y x -> (a x).1) (x : X) {
    module D = GTor[G x].D[(a x).1, (a x).2] ;
    i (y : Y x) : (G x).G = D.diff (b' x y) (b x y) ;
    phi : Y x -> Y x -> (G x).G = C.Points[a, b].phi x ;
    phi' : Y x -> Y x -> (G x).G = C.Points[a, b'].phi x ;
    -- both sides move b' y0 to b y1
    lhs (y0 y1 : Y x) : Id (a x).1 (D.act ((G x).mul (i y1) (phi' y0 y1)) (b' x y0)) (b x y1) = calc (a x).1 {
      D.act ((G x).mul (i y1) (phi' y0 y1)) (b' x y0) =< D.ad (i y1) (phi' y0 y1) (b' x y0) >
      D.act (i y1) (D.act (phi' y0 y1) (b' x y0)) =< apH (D.act (i y1)) (D.dact (b' x y0) (b' x y1)) >
      D.act (i y1) (b' x y1) =< D.dact (b' x y1) (b x y1) > b x y1 } ;
    rhs (y0 y1 : Y x) : Id (a x).1 (D.act ((G x).mul (phi y0 y1) (i y0)) (b' x y0)) (b x y1) = calc (a x).1 {
      D.act ((G x).mul (phi y0 y1) (i y0)) (b' x y0) =< D.ad (phi y0 y1) (i y0) (b' x y0) >
      D.act (phi y0 y1) (D.act (i y0) (b' x y0)) =< apH (D.act (phi y0 y1)) (D.dact (b' x y0) (b x y0)) >
      D.act (phi y0 y1) (b x y0) =< D.dact (b x y0) (b x y1) > b x y1 } ;
    rel : Conj[G x, Y x].Rel phi phi' i = \ y0 y1 ->
      transH (symH (D.uniq (b' x y0) (b x y1) ((G x).mul (i y1) (phi' y0 y1)) (lhs y0 y1)))
        (D.uniq (b' x y0) (b x y1) ((G x).mul (phi y0 y1) (i y0)) (rhs y0 y1)) ;
  } ;
  points-coh (a : Fam) (b b' : (x : X) -> Y x -> (a x).1) : Coh (cyc a b) (cyc a b') =
    Tr.Trunc[(i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (C.Points[a, b].phi x) (C.Points[a, b'].phi x) (i x))].inc
      (\ x -> PointsCoh[a, b, b', x].i, \ x -> PointsCoh[a, b, b', x].rel) ;

  -- Lemma A.0.5: the cocycle of the points H of psi u is u
  module PhiH (u : Cyc) (x : X) {
    module S = Psi[Y x, hY x, G x, u.1 x, u.2 x] ;
    moves (y0 y1 : Y x) : Id S.P (S.act (u.1 x y0 y1) (S.H y0)) (S.H y1) =
      S.P-eq (S.act (u.1 x y0 y1) (S.H y0)) (S.H y1) (\ y -> u.2 x y y0 y1) ;
    eq (y0 y1 : Y x) : Id (G x).G (C.Points[psi u, pts u].phi x y0 y1) (u.1 x y0 y1) =
      GTor[G x].D[S.P, (S.tor).2].uniq (S.H y0) (S.H y1) (u.1 x y0 y1) (moves y0 y1) ;
  } ;
  -- equal cocycles are cohomologous (iota = e)
  eq-coh (u v : Cyc) (h : (x : X) (y0 y1 : Y x) -> Id (G x).G (u.1 x y0 y1) (v.1 x y0 y1)) : Coh u v =
    Tr.Trunc[(i : C.C0) * ((x : X) -> Conj[G x, Y x].Rel (u.1 x) (v.1 x) (i x))].inc
      (\ x y -> (G x).e, \ x y0 y1 -> transH ((G x).unitl (v.1 x y0 y1))
         (transH (symH (h x y0 y1)) (symH ((G x).unitr (u.1 x y0 y1))))) ;
  phi-H (u : Cyc) : Coh u (cyc (psi u) (pts u)) =
    eq-coh u (cyc (psi u) (pts u)) (\ x y0 y1 -> symH (PhiH[u, x].eq y0 y1)) ;

  -- injectivity (Lemma A.0.5)
  Reach (u : Cyc) (a : Fam) : U l+ = (b : (x : X) -> Y x -> (a x).1) -> Coh u (cyc a b) ;
  reach-base (u : Cyc) : Reach u (psi u) = \ b ->
    coh-trans u (cyc (psi u) (pts u)) (cyc (psi u) b) (phi-H u) (points-coh (psi u) (pts u) b) ;
  reflect-path (u v : Cyc) (p : Id Fam (psi u) (psi v)) : Coh u v =
    coh-trans u (cyc (psi v) (pts v)) v
      (idJ Fam (psi u) (\ a q -> Reach u a) (reach-base u) (psi v) p (pts v))
      (coh-sym v (cyc (psi v) (pts v)) (phi-H v)) ;
  reflect (u v : Cyc) (h : Same (psi u) (psi v)) : Coh u v =
    TC1.rec (Id Fam (psi u) (psi v)) @l (Coh u v) (coh-prop u v) (reflect-path u v) h ;
  injective : B1.Injective psibar = \ q r ->
    QC.induction @(l+) (\ q -> Id H1Y (psibar q) (psibar r) -> Id Cech q r)
      (\ q -> FL1.isProp-Pi (Id H1Y (psibar q) (psibar r)) (\ p -> Id Cech q r) (\ p -> QC.set q r))
      (\ u -> QC.induction @(l+) (\ r -> Id H1Y (psibar (QC.inc u)) (psibar r) -> Id Cech (QC.inc u) r)
        (\ r -> FL1.isProp-Pi (Id H1Y (psibar (QC.inc u)) (psibar r)) (\ p -> Id Cech (QC.inc u) r) (\ p -> QC.set (QC.inc u) r))
        (\ v p -> QC.relates u v (reflect u v (QY.effective (psi' u) (psi' v)
           (Pa1.transH (Pa1.symH (PsiBar.beta u)) (Pa1.transH p (PsiBar.beta v)))))) r) q ;

  -- Lemma A.0.6: alpha is psi of the cocycle of its points
  module A06 (a : Fam) (b : (x : X) -> Y x -> (a x).1) (x : X) {
    module D = GTor[G x].D[(a x).1, (a x).2] ;
    module S = Psi[Y x, hY x, G x, C.Points[a, b].phi x, C.Points[a, b].cocycle x] ;
    -- the a with a . b y = p
    gam (p : (a x).1) (y : Y x) : (G x).G = D.diff (b x y) p ;
    moves (p : (a x).1) (y0 y1 : Y x) : Id (a x).1 (D.act ((G x).mul (gam p y1) (S.d y0 y1)) (b x y0)) p = calc (a x).1 {
      D.act ((G x).mul (gam p y1) (S.d y0 y1)) (b x y0) =< D.ad (gam p y1) (S.d y0 y1) (b x y0) >
      D.act (gam p y1) (D.act (S.d y0 y1) (b x y0)) =< apH (D.act (gam p y1)) (D.dact (b x y0) (b x y1)) >
      D.act (gam p y1) (b x y1) =< D.dact (b x y1) p > p } ;
    map (p : (a x).1) : S.P = (gam p, \ y0 y1 -> symH (D.uniq (b x y0) p ((G x).mul (gam p y1) (S.d y0 y1)) (moves p y0 y1))) ;
    equivariant (g : (G x).G) (p : (a x).1) (y : Y x) : Id (G x).G (gam (D.act g p) y) ((G x).mul g (gam p y)) =
      D.uniq (b x y) (D.act g p) ((G x).mul g (gam p y))
        (transH (D.ad g (gam p y) (b x y)) (apH (D.act g) (D.dact (b x y) p))) ;
    hom : GTor[G x].Hom (a x) S.tor = (map, \ g p ->
      S.P-eq (map (D.act g p)) (S.act g (map p)) (equivariant g p)) ;
    path : Id (GTor[G x].Tor) (a x) S.tor = GTor[G x].decode (a x) S.tor hom ;
  } ;
  a06 (a : Fam) (b : (x : X) -> Y x -> (a x).1) : Same (psi (cyc a b)) a =
    T1.Trunc[Id Fam (psi (cyc a b)) a].inc (P1.sym Fam a (psi (cyc a b))
      (FL1.funext X (\ x -> GTor[G x].Tor) a (psi (cyc a b)) (\ x -> A06[a, b, x].path))) ;

  -- surjectivity
  surjective (q : H1Y) : T1.Trunc[B1.Fibre psibar q].carrier =
    QY.induction @(l+) (\ q -> T1.Trunc[B1.Fibre psibar q].carrier) (\ q -> T1.Trunc[B1.Fibre psibar q].proposition)
      (\ w -> TC.rec ((x : X) -> Y x -> (w.1 x).1) @(l+) (T1.Trunc[B1.Fibre psibar (QY.inc w)].carrier)
        T1.Trunc[B1.Fibre psibar (QY.inc w)].proposition
        (\ b -> T1.Trunc[B1.Fibre psibar (QY.inc w)].inc (QC.inc (cyc w.1 b),
           Pa1.transH (PsiBar.beta (cyc w.1 b)) (QY.relates (psi' (cyc w.1 b)) w (a06 w.1 b)))) w.2) q ;

  -- Cor. A.0.7: Ȟ¹(X, Y, G) = H¹(X, Y, G)
  corA07 : P1.Equiv Cech H1Y = (psibar, B1.Bij[Cech, H1Y, QY.set, psibar, injective, surjective].equiv) ;

  -- Cor. A.0.8: if H¹((x : X) * Y x, G o pr1) = 0, then H¹(X, G) = Ȟ¹(X, Y, G)
  module A08 (hyp : CohZero ((x : X) * Y x) (\ w -> G w.1)) {
    pointed (a : Fam) : Pointed a =
      TC1.rec ((w : (x : X) * Y x) -> Id (GTor[G w.1].Tor) (a w.1) (GTor[G w.1].triv)) @l (Pointed a)
        Tr.Trunc[(x : X) -> Y x -> (a x).1].proposition
        (\ t -> Tr.Trunc[(x : X) -> Y x -> (a x).1].inc (\ x y ->
           GTor[G x].triv-pt (a x) (P1.sym (GTor[G x].Tor) (a x) (GTor[G x].triv) (t (x, y)))))
        (hyp (\ w -> a w.1)) ;
    forget-surjective (q : H1) : T1.Trunc[B1.Fibre forget q].carrier =
      QF.induction @(l+) (\ q -> T1.Trunc[B1.Fibre forget q].carrier) (\ q -> T1.Trunc[B1.Fibre forget q].proposition)
        (\ a -> T1.Trunc[B1.Fibre forget (QF.inc a)].inc (QY.inc (a, pointed a), Forget.beta (a, pointed a))) q ;
    forget-equiv : P1.Equiv H1Y H1 = (forget, B1.Bij[H1Y, H1, QF.set, forget, forget-injective, forget-surjective].equiv) ;
    corA08 : P1.Equiv Cech H1 = Equivalences[l+].compose Cech H1Y H1 corA07 forget-equiv ;
  } ;
} ;
