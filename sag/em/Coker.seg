-- Isomorphic cokernels (the step of CCA Thm 3.3.2: "from the induction
-- hypothesis we conclude there is an isomorphism").  Two exact rows of
-- groups
--     G1 -p-> G2 -d-> G3 -> 0        K1 -q-> K2 -e-> K3 -> 0
-- (d, e onto; d p = 1, e q = 1; ker d in im p, ker e in im q), f1 : G1 -> K1
-- onto, f2 : G2 -> K2 bijective, q f1 = f2 p.  Then
--     f3 (d y) = e (f2 y)
-- defines a group isomorphism G3 -> K3.
--   Well defined: if d y = d y' then d (y y'^-1) = 1, so y y'^-1 = p x and
--   f2 y = f2 (p x) f2 y' = q (f1 x) f2 y', which e sends to e (f2 y').
--   (d is onto, so G3 is covered: ConstantMap on the fibres of d.)
--   A homomorphism (d is one), onto (e and f2 are), with trivial kernel:
--   e (f2 y) = 1 gives f2 y = q x' = q (f1 x) = f2 (p x), so y = p x and
--   d y = 1.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Bj = Bijection[l] ;
module QG = QGrp[l] ;

module Coker (G1 G2 G3 K1 K2 K3 : Grp) (p : QG.GHom G1 G2) (d : QG.GHom G2 G3) (q : QG.GHom K1 K2) (e : QG.GHom K2 K3)
  (d-onto : (z : G3.G) -> Tr.Trunc[Bj.Fibre d.1 z].carrier)
  (dp : (x : G1.G) -> Id G3.G (d.1 (p.1 x)) G3.e)
  (dker : (y : G2.G) -> Id G3.G (d.1 y) G3.e -> Tr.Trunc[Bj.Fibre p.1 y].carrier)
  (e-onto : (z : K3.G) -> Tr.Trunc[Bj.Fibre e.1 z].carrier)
  (eq : (x : K1.G) -> Id K3.G (e.1 (q.1 x)) K3.e)
  (eker : (y : K2.G) -> Id K3.G (e.1 y) K3.e -> Tr.Trunc[Bj.Fibre q.1 y].carrier)
  (f1 : QG.GHom G1 K1) (f1-onto : (x : K1.G) -> Tr.Trunc[Bj.Fibre f1.1 x].carrier)
  (f2 : QG.GHom G2 K2) (f2-inj : Bj.Injective f2.1) (f2-onto : (y : K2.G) -> Tr.Trunc[Bj.Fibre f2.1 y].carrier)
  (sq : (x : G1.G) -> Id K2.G (q.1 (f1.1 x)) (f2.1 (p.1 x))) {
  module L2 = GrpL[G2] ; module L3 = GrpL[G3] ; module LK = GrpL[K2] ; module LK3 = GrpL[K3] ;
  module HD = QG.GHomL[G2, G3, d] ;
  module HE = QG.GHomL[K2, K3, e] ;
  module HF2 = QG.GHomL[G2, K2, f2] ;
  -- y = (y y'^-1) y'
  split-mul (y y' : G2.G) : Id G2.G y (G2.mul (G2.mul y (G2.inv y')) y') = symH (L2.cancr y' y) ;
  -- d (y y'^-1) = 1 when d y = d y'
  d-diff (y y' : G2.G) (h : Id G3.G (d.1 y) (d.1 y')) : Id G3.G (d.1 (G2.mul y (G2.inv y'))) G3.e = calc G3.G {
    d.1 (G2.mul y (G2.inv y')) =< d.2 y (G2.inv y') > G3.mul (d.1 y) (d.1 (G2.inv y'))
      =< apH (G3.mul (d.1 y)) (HD.hom-inv y') > G3.mul (d.1 y) (G3.inv (d.1 y'))
      =< apH (\ a -> G3.mul a (G3.inv (d.1 y'))) h > G3.mul (d.1 y') (G3.inv (d.1 y'))
      =< G3.invr (d.1 y') > G3.e } ;
  -- e (f2 y) = e (f2 y') when y y'^-1 = p x
  module Wc (y y' : G2.G) (w : Bj.Fibre p.1 (G2.mul y (G2.inv y'))) {
    same : Id K3.G (e.1 (f2.1 y)) (e.1 (f2.1 y')) = calc K3.G {
      e.1 (f2.1 y) =< apH (\ a -> e.1 (f2.1 a)) (split-mul y y') > e.1 (f2.1 (G2.mul (G2.mul y (G2.inv y')) y'))
        =< apH e.1 (f2.2 (G2.mul y (G2.inv y')) y') > e.1 (K2.mul (f2.1 (G2.mul y (G2.inv y'))) (f2.1 y'))
        =< e.2 (f2.1 (G2.mul y (G2.inv y'))) (f2.1 y') > K3.mul (e.1 (f2.1 (G2.mul y (G2.inv y')))) (e.1 (f2.1 y'))
        =< apH (\ a -> K3.mul (e.1 (f2.1 a)) (e.1 (f2.1 y'))) (symH w.2) > K3.mul (e.1 (f2.1 (p.1 w.1))) (e.1 (f2.1 y'))
        =< apH (\ a -> K3.mul (e.1 a) (e.1 (f2.1 y'))) (symH (sq w.1)) > K3.mul (e.1 (q.1 (f1.1 w.1))) (e.1 (f2.1 y'))
        =< apH (\ a -> K3.mul a (e.1 (f2.1 y'))) (eq (f1.1 w.1)) > K3.mul K3.e (e.1 (f2.1 y'))
        =< K3.unitl (e.1 (f2.1 y')) > e.1 (f2.1 y') } ;
  } ;
  wc (z : G3.G) (w w' : Bj.Fibre d.1 z) : Id K3.G (e.1 (f2.1 w.1)) (e.1 (f2.1 w'.1)) =
    TC.rec (Bj.Fibre p.1 (G2.mul w.1 (G2.inv w'.1))) @l (Id K3.G (e.1 (f2.1 w.1)) (e.1 (f2.1 w'.1))) (K3.setG (e.1 (f2.1 w.1)) (e.1 (f2.1 w'.1)))
      (\ v -> Wc[w.1, w'.1, v].same) (dker (G2.mul w.1 (G2.inv w'.1)) (d-diff w.1 w'.1 (transH w.2 (symH w'.2)))) ;
  module F (z : G3.G) {
    module CM = ConstantMap[l].Constant[Bj.Fibre d.1 z, K3.G, K3.setG, \ w -> e.1 (f2.1 w.1), wc z] ;
    value : K3.G = CM.value (d-onto z) ;
  } ;
  f3 (z : G3.G) : K3.G = F[z].value ;
  -- f3 (d y) = e (f2 y)
  f3-d (y : G2.G) : Id K3.G (f3 (d.1 y)) (e.1 (f2.1 y)) = F[d.1 y].CM.value-at (d-onto (d.1 y)) (y, refl (d.1 y)) ;
  f3-hom (z z' : G3.G) : Id K3.G (f3 (G3.mul z z')) (K3.mul (f3 z) (f3 z')) =
    TC.rec (Bj.Fibre d.1 z) @l (Id K3.G (f3 (G3.mul z z')) (K3.mul (f3 z) (f3 z'))) (K3.setG (f3 (G3.mul z z')) (K3.mul (f3 z) (f3 z'))) (\ w ->
    TC.rec (Bj.Fibre d.1 z') @l (Id K3.G (f3 (G3.mul z z')) (K3.mul (f3 z) (f3 z'))) (K3.setG (f3 (G3.mul z z')) (K3.mul (f3 z) (f3 z'))) (\ w' -> calc K3.G {
      f3 (G3.mul z z') =< apH f3 (symH (transH (d.2 w.1 w'.1) (transH (apH (\ a -> G3.mul a (d.1 w'.1)) w.2) (apH (G3.mul z) w'.2)))) >
      f3 (d.1 (G2.mul w.1 w'.1)) =< f3-d (G2.mul w.1 w'.1) > e.1 (f2.1 (G2.mul w.1 w'.1))
        =< apH e.1 (f2.2 w.1 w'.1) > e.1 (K2.mul (f2.1 w.1) (f2.1 w'.1)) =< e.2 (f2.1 w.1) (f2.1 w'.1) > K3.mul (e.1 (f2.1 w.1)) (e.1 (f2.1 w'.1))
        =< symH (transH (apH (\ a -> K3.mul (f3 a) (f3 z')) (symH w.2)) (transH (apH (\ a -> K3.mul (f3 (d.1 w.1)) (f3 a)) (symH w'.2))
             (transH (apH (\ a -> K3.mul a (f3 (d.1 w'.1))) (f3-d w.1)) (apH (K3.mul (e.1 (f2.1 w.1))) (f3-d w'.1))))) >
      K3.mul (f3 z) (f3 z') }) (d-onto z')) (d-onto z) ;
  iso : QG.GHom G3 K3 = (f3, f3-hom) ;
  module HF3 = QG.GHomL[G3, K3, iso] ;
  -- trivial kernel
  module Ker (y : G2.G) (h : Id K3.G (e.1 (f2.1 y)) K3.e) {
    from-x (x : G1.G) (s : Id K2.G (q.1 (f1.1 x)) (f2.1 y)) : Id G3.G (d.1 y) G3.e =
      transH (apH d.1 (symH (f2-inj (p.1 x) y (transH (symH (sq x)) s)))) (dp x) ;
    result : Id G3.G (d.1 y) G3.e =
      TC.rec (Bj.Fibre q.1 (f2.1 y)) @l (Id G3.G (d.1 y) G3.e) (G3.setG (d.1 y) G3.e) (\ w ->
        TC.rec (Bj.Fibre f1.1 w.1) @l (Id G3.G (d.1 y) G3.e) (G3.setG (d.1 y) G3.e)
          (\ v -> from-x v.1 (transH (apH q.1 v.2) w.2)) (f1-onto w.1)) (eker (f2.1 y) h) ;
  } ;
  -- injective
  module Inj (y y' : G2.G) (h : Id K3.G (e.1 (f2.1 y)) (e.1 (f2.1 y'))) {
    k : Id K3.G (e.1 (f2.1 (G2.mul y (G2.inv y')))) K3.e = calc K3.G {
      e.1 (f2.1 (G2.mul y (G2.inv y'))) =< apH e.1 (f2.2 y (G2.inv y')) > e.1 (K2.mul (f2.1 y) (f2.1 (G2.inv y')))
        =< e.2 (f2.1 y) (f2.1 (G2.inv y')) > K3.mul (e.1 (f2.1 y)) (e.1 (f2.1 (G2.inv y')))
        =< apH (K3.mul (e.1 (f2.1 y))) (transH (apH e.1 (HF2.hom-inv y')) (HE.hom-inv (f2.1 y'))) > K3.mul (e.1 (f2.1 y)) (K3.inv (e.1 (f2.1 y')))
        =< apH (\ a -> K3.mul a (K3.inv (e.1 (f2.1 y')))) h > K3.mul (e.1 (f2.1 y')) (K3.inv (e.1 (f2.1 y')))
        =< K3.invr (e.1 (f2.1 y')) > K3.e } ;
    dd : Id G3.G (d.1 y) (d.1 y') = calc G3.G {
      d.1 y =< apH d.1 (split-mul y y') > d.1 (G2.mul (G2.mul y (G2.inv y')) y')
        =< d.2 (G2.mul y (G2.inv y')) y' > G3.mul (d.1 (G2.mul y (G2.inv y'))) (d.1 y')
        =< apH (\ a -> G3.mul a (d.1 y')) (Ker[G2.mul y (G2.inv y'), k].result) > G3.mul G3.e (d.1 y')
        =< G3.unitl (d.1 y') > d.1 y' } ;
  } ;
  injective : Bj.Injective f3 = \ z z' h ->
    TC.rec (Bj.Fibre d.1 z) @l (Id G3.G z z') (G3.setG z z') (\ w ->
    TC.rec (Bj.Fibre d.1 z') @l (Id G3.G z z') (G3.setG z z') (\ w' ->
      transH (symH w.2) (transH (Inj[w.1, w'.1, transH (symH (f3-d w.1)) (transH (apH f3 w.2) (transH h (transH (apH f3 (symH w'.2)) (f3-d w'.1))))].dd) w'.2))
      (d-onto z')) (d-onto z) ;
  onto (z : K3.G) : Tr.Trunc[Bj.Fibre f3 z].carrier =
    TC.bind (Bj.Fibre e.1 z) (Bj.Fibre f3 z) (\ w ->
      TC.map (Bj.Fibre f2.1 w.1) (Bj.Fibre f3 z) (\ v -> (d.1 v.1, transH (f3-d v.1) (transH (apH e.1 v.2) w.2))) (f2-onto w.1)) (e-onto z) ;
  equiv : Equiv G3.G K3.G = (f3, Bj.Bij[G3.G, K3.G, K3.setG, f3, injective, onto].equiv) ;
} ;
