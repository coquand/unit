-- Exactness of  H^m(S, C) -> H^(m+1)(S, A) -> H^(m+1)(S, B)  in the
-- 0-connected form (CCA-DESIGN §4), for a family over S of short exact
-- sequences 0 -> A x -> B x -> C x -> 0 and any m:
--   if (x : S) -> K(C x, m) is 0-connected, and alpha : (x : S) ->
--   K(A x, m+1) has K i o alpha merely trivial, then alpha is merely
--   trivial.
-- Proof.  Let r x : K i (alpha x) = pt.  By the fibre sequence
-- (FibSeq.SES.fibre) G : K(A x, m+1) ~ Fib (K p), G z = (K i z, h z).
-- Moving G (alpha x) along r x gives (pt, u x), u x : K p pt = pt, and
-- v x = (K p pt-path)^-1 . u x is a loop of K(C x, m+1), i.e. a point of
-- K(C x, m).  The loops (x : S) -> Omega K(C x, m+1) are 0-connected, so
-- merely v = refl uniformly; then G (alpha x) = (pt, pt-path) = G pt, and
-- alpha x = pt (G is an equivalence).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ; open EMMaps[l] ; open AbHom[l] ;
open Torsor[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Eq = Equivalences[l] ;
module Bj = Bijection[l] ;
module FS = FibSeq[l] ;

module Exact (S : U l) (Ga Gb Gc : S -> Ab) (i : (x : S) -> Hom (Ga x) (Gb x)) (p : (x : S) -> Hom (Gb x) (Gc x))
  (inj : (x : S) -> Bj.Injective (i x).1)
  (pi0 : (x : S) (a : (Ga x).A) -> Id (Gc x).A ((p x).1 ((i x).1 a)) (Gc x).o)
  (ex : (x : S) (b : (Gb x).A) -> Id (Gc x).A ((p x).1 b) (Gc x).o -> Tr.Trunc[Bj.Fibre (i x).1 b].carrier)
  (sur : (x : S) (c : (Gc x).A) -> Tr.Trunc[Bj.Fibre (p x).1 c].carrier) (m : Nat) {
  module At (x : S) { module E = FS.SES[Ga x, Gb x, Gc x, i x, p x, inj x, pi0 x, ex x, sur x] ; } ;
  KA (x : S) : U l = At[x].E.A.K (suc m) ;
  KB (x : S) : U l = At[x].E.B.K (suc m) ;
  KC (x : S) : U l = At[x].E.C.K (suc m) ;
  OC (x : S) : U l = (Id (At[x].E.C.K (suc m)) (At[x].E.C.pt (suc m)) (At[x].E.C.pt (suc m))) ;
  Ki (x : S) : PtMap (KA x) (At[x].E.A.pt (suc m)) (KB x) (At[x].E.B.pt (suc m)) = At[x].E.Ki.K (suc m) ;
  Kp (x : S) : PtMap (KB x) (At[x].E.B.pt (suc m)) (KC x) (At[x].E.C.pt (suc m)) = At[x].E.Kp.K (suc m) ;

  module Given (cC : isConn (suc (suc zero)) ((x : S) -> At[x].E.C.K m)) (alpha : (x : S) -> KA x)
    (r : (x : S) -> Id (KB x) ((Ki x).1 (alpha x)) (At[x].E.B.pt (suc m))) {
    G (x : S) : PtMap (KA x) (At[x].E.A.pt (suc m)) (At[x].E.FibK (suc m)) (At[x].E.fptK (suc m)) = At[x].E.Cmp[suc m].L.lift ;
    u (x : S) : Id (KC x) ((Kp x).1 (At[x].E.B.pt (suc m))) (At[x].E.C.pt (suc m)) =
      subst (KB x) (\ y -> Id (KC x) ((Kp x).1 y) (At[x].E.C.pt (suc m))) ((Ki x).1 (alpha x)) (At[x].E.B.pt (suc m)) (r x)
        (At[x].E.Cmp[suc m].L.hz (alpha x)) ;
    moved (x : S) : Id (At[x].E.FibK (suc m)) ((G x).1 (alpha x)) (At[x].E.B.pt (suc m), u x) =
      Sigma-path (KB x) (\ y -> Id (KC x) ((Kp x).1 y) (At[x].E.C.pt (suc m))) ((Ki x).1 (alpha x)) (At[x].E.B.pt (suc m))
        (At[x].E.Cmp[suc m].L.hz (alpha x)) (u x) (r x) (refl (u x)) ;
    v (x : S) : OC x = trans (KC x) (At[x].E.C.pt (suc m)) ((Kp x).1 (At[x].E.B.pt (suc m))) (At[x].E.C.pt (suc m))
      (sym (KC x) ((Kp x).1 (At[x].E.B.pt (suc m))) (At[x].E.C.pt (suc m)) (Kp x).2) (u x) ;
    -- the loops of the K(C x, m+1) are 0-connected
    cO : isConn (suc (suc zero)) ((x : S) -> OC x) =
      Deloop[l].equiv-conn (suc (suc zero)) ((x : S) -> OC x) ((x : S) -> At[x].E.C.K m)
        ((\ a x -> (At[x].E.C.e m).1.1 (a x)),
         PiEquiv[l].pi-equiv S OC (\ x -> At[x].E.C.K m) (\ x -> (At[x].E.C.e m).1.1) (\ x -> (At[x].E.C.e m).2))
        cC ;
    -- from v x = refl
    back (q : Id ((x : S) -> OC x) v (\ x -> refl (At[x].E.C.pt (suc m)))) (x : S) :
      Id (KA x) (alpha x) (At[x].E.A.pt (suc m)) =
      Eq.injective (KA x) (At[x].E.FibK (suc m)) (G x).1 (At[x].E.fibre (suc m)) (alpha x) (At[x].E.A.pt (suc m))
        (calc (At[x].E.FibK (suc m)) {
          (G x).1 (alpha x) =< moved x >
          (At[x].E.B.pt (suc m), u x)
            =< apH (\ e -> (At[x].E.B.pt (suc m), e))
                 (transH (symH (Fibres[l].trans-cancel' (KC x) ((Kp x).1 (At[x].E.B.pt (suc m))) (At[x].E.C.pt (suc m)) (At[x].E.C.pt (suc m)) (Kp x).2 (u x)))
                    (apH (trans (KC x) ((Kp x).1 (At[x].E.B.pt (suc m))) (At[x].E.C.pt (suc m)) (At[x].E.C.pt (suc m)) (Kp x).2)
                       (happly S OC v (\ x1 -> refl (At[x1].E.C.pt (suc m))) q x))) >
          At[x].E.fptK (suc m) =< symH (G x).2 > (G x).1 (At[x].E.A.pt (suc m)) }) ;
    result : Tr.Trunc[(x : S) -> Id (KA x) (alpha x) (At[x].E.A.pt (suc m))].carrier =
      TC.map (Id ((x : S) -> OC x) v (\ x -> refl (At[x].E.C.pt (suc m)))) ((x : S) -> Id (KA x) (alpha x) (At[x].E.A.pt (suc m)))
        back (conn-path zero ((x : S) -> OC x) cO v (\ x -> refl (At[x].E.C.pt (suc m)))) ;
  } ;

  exact (cC : isConn (suc (suc zero)) ((x : S) -> At[x].E.C.K m)) (alpha : (x : S) -> KA x)
    (z : Tr.Trunc[(x : S) -> Id (KB x) ((Ki x).1 (alpha x)) (At[x].E.B.pt (suc m))].carrier) :
    Tr.Trunc[(x : S) -> Id (KA x) (alpha x) (At[x].E.A.pt (suc m))].carrier =
    TC.bind ((x : S) -> Id (KB x) ((Ki x).1 (alpha x)) (At[x].E.B.pt (suc m)))
      ((x : S) -> Id (KA x) (alpha x) (At[x].E.A.pt (suc m))) (\ r -> Given[cC, alpha, r].result) z ;
} ;
