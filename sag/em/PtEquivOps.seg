-- Pointed equivalences (Lemma4.PtEquiv = (f : A ->pt B) * isEquiv f):
-- accessors, identity, composition, inverse, and induction on pointed
-- equivalences: for (Z, z) with p : X ~pt (Z, z), a statement about
-- (Z, z, p) follows from the one about (X, x0, id) (univalence: Torsor.eqind
-- on the equivalence, then J on the pointing path).  Consequence
-- (pointed univalence): (Z : U) * (z : Z) * X ~pt (Z, z) is contractible.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open Lemma4[l] ;
module P1 = Prelude[l+] ;

module Acc (A : U l) (a0 : A) (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) {
  fun : A -> B = e.1.1 ;
  pt : Id B (fun a0) b0 = e.1.2 ;
  eq : isEquiv A B fun = e.2 ;
  inv : B -> A = e.2.sec ;
  equiv : Equiv A B = (fun, eq) ;
} ;

idPt (X : U l) (x0 : X) : PtEquiv X x0 X x0 = ((\ x -> x, refl x0), (idEquiv X).2) ;

pt-comp (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C)
  (e : PtEquiv A a0 B b0) (d : PtEquiv B b0 C c0) : PtEquiv A a0 C c0 =
  ((\ a -> Acc[B, b0, C, c0, d].fun (Acc[A, a0, B, b0, e].fun a),
    trans C (Acc[B, b0, C, c0, d].fun (Acc[A, a0, B, b0, e].fun a0)) (Acc[B, b0, C, c0, d].fun b0) c0
      (ap B C Acc[B, b0, C, c0, d].fun (Acc[A, a0, B, b0, e].fun a0) b0 Acc[A, a0, B, b0, e].pt)
      Acc[B, b0, C, c0, d].pt),
   (Equivalences[l].compose A B C Acc[A, a0, B, b0, e].equiv Acc[B, b0, C, c0, d].equiv).2) ;

pt-inv (A : U l) (a0 : A) (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) : PtEquiv B b0 A a0 =
  ((Acc[A, a0, B, b0, e].inv,
    trans A (Acc[A, a0, B, b0, e].inv b0) (Acc[A, a0, B, b0, e].inv (Acc[A, a0, B, b0, e].fun a0)) a0
      (ap B A Acc[A, a0, B, b0, e].inv b0 (Acc[A, a0, B, b0, e].fun a0)
         (sym B (Acc[A, a0, B, b0, e].fun a0) b0 Acc[A, a0, B, b0, e].pt))
      (sec-ret A B Acc[A, a0, B, b0, e].fun Acc[A, a0, B, b0, e].eq a0)),
   qinv B A Acc[A, a0, B, b0, e].inv Acc[A, a0, B, b0, e].fun
     (sec-ret A B Acc[A, a0, B, b0, e].fun Acc[A, a0, B, b0, e].eq) Acc[A, a0, B, b0, e].eq.sec-eq) ;

-- induction on pointed equivalences out of (X, x0)
ptEqInd (X : U l) (x0 : X) (P : (Z : U l) (z : Z) -> PtEquiv X x0 Z z -> U l+)
  (d : P X x0 (idPt X x0)) (Z : U l) (z : Z) (p : PtEquiv X x0 Z z) : P Z z p =
  Torsor[l].eqind X (\ Z1 e1 -> (z1 : Z1) (q1 : Id Z1 (e1.1 x0) z1) -> P Z1 z1 ((e1.1, q1), e1.2))
    (\ z1 q1 -> idJ X x0 (\ z2 q2 -> P X z2 ((\ x -> x, q2), (idEquiv X).2)) d z1 q1)
    Z (p.1.1, p.2) z p.1.2 ;

-- pointed univalence
PtUniv (X : U l) (x0 : X) : U l+ = (Z : U l) * (z : Z) * PtEquiv X x0 Z z ;

pt-univ (X : U l) (x0 : X) : FunExtUA[l+].isContr (PtUniv X x0) =
  ((X, x0, idPt X x0), \ w ->
    ptEqInd X x0 (\ Z z p -> Id (PtUniv X x0) (X, x0, idPt X x0) (Z, z, p))
      (refl (X, x0, idPt X x0)) w.1 w.2.1 w.2.2) ;
