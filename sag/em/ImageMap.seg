-- A homomorphism h : A -> A' induces a map of the short exact sequences
-- 0 -> A -> A^T -> L -> 0 of ImageGroup.Cech (L the image of the Čech
-- differential d f (t, t') = f t' - f t):
--   Eh f = h o f,   Lh (y, _) = (h o y, _)   (h o d f = d (h o f), h
--   preserves differences);  i' (h a) = Eh (i a) by definition,
--   p' (Eh f) = Lh (p f) on the underlying functions.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module IG = ImageGroup[l] ;
module CG = CechGroups[l] ;

module ImageMap (T : U l) (hT : Tr.Trunc[T].carrier) (Ga Ga' : Ab) (h : Hom Ga Ga') {
  module C = IG.Cech[T, hT, Ga] ;
  module C' = IG.Cech[T, hT, Ga'] ;
  Eh : Hom C.AT C'.AT = (\ f t -> h.1 (f t), \ f g -> FL.funext T (\ t -> Ga'.A) (\ t -> h.1 (Ga.add (f t) (g t)))
    (\ t -> Ga'.add (h.1 (f t)) (h.1 (g t))) (\ t -> h.2 (f t) (g t))) ;
  -- h o d f = d (h o f)
  dnat (f : T -> Ga.A) : Id (C'.AT2).A (\ w -> h.1 (C.dfun f w)) (C'.dfun (\ t -> h.1 (f t))) =
    FL.funext (T * T) (\ w -> Ga'.A) (\ w -> h.1 (C.dfun f w)) (C'.dfun (\ t -> h.1 (f t))) (\ w -> CG.hom-sub Ga Ga' h (f w.2) (f w.1)) ;
  lmap (u : C.L.A) : C'.L.A = (\ w -> h.1 (u.1 w),
    TC.map (Bj.Fibre C.d.1 u.1) (Bj.Fibre C'.d.1 (\ w -> h.1 (u.1 w)))
      (\ v -> ((Eh.1 v.1), transH (symH (dnat v.1)) (apH (\ y w -> h.1 (y w)) v.2))) u.2) ;
  Lh : Hom C.L C'.L = (lmap, \ u v -> C'.I.eqC (lmap (C.L.add u v)) (C'.L.add (lmap u) (lmap v))
    (FL.funext (T * T) (\ w -> Ga'.A) (\ w -> h.1 (Ga.add (u.1 w) (v.1 w))) (\ w -> Ga'.add (h.1 (u.1 w)) (h.1 (v.1 w))) (\ w -> h.2 (u.1 w) (v.1 w)))) ;
  sqi (a : Ga.A) : Id C'.AT.A (C'.i.1 (h.1 a)) (Eh.1 (C.i.1 a)) = refl (\ t -> h.1 a) ;
  sqp (f : C.AT.A) : Id C'.L.A (C'.p.1 (Eh.1 f)) (Lh.1 (C.p.1 f)) =
    C'.I.eqC (C'.p.1 (Eh.1 f)) (Lh.1 (C.p.1 f)) (symH (dnat f)) ;
} ;
