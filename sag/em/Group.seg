-- Groups (not necessarily abelian), for CCA §3.1 and Appendix A, with the
-- cancellation laws used there.  An abelian group (Torsor.Ab) is a group
-- (ab-grp), with the same carrier, unit and operation by definition.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;

record Grp {
  G : U l ;
  setG : isSet G ;
  e : G ;
  mul : G -> G -> G ;
  inv : G -> G ;
  assoc (x y z : G) : Id G (mul (mul x y) z) (mul x (mul y z)) ;
  unitl (x : G) : Id G (mul e x) x ;
  unitr (x : G) : Id G (mul x e) x ;
  invl (x : G) : Id G (mul (inv x) x) e ;
  invr (x : G) : Id G (mul x (inv x)) e ;
} ;

module GrpL (Gr : Grp) {
  open Gr ;
  -- x^-1 (x y) = y
  cancl (x y : G) : Id G (mul (inv x) (mul x y)) y = calc G {
    mul (inv x) (mul x y) =< symH (assoc (inv x) x y) > mul (mul (inv x) x) y
      =< apH (\ z -> mul z y) (invl x) > mul e y
      =< unitl y > y } ;
  -- x (x^-1 y) = y
  cancl' (x y : G) : Id G (mul x (mul (inv x) y)) y = calc G {
    mul x (mul (inv x) y) =< symH (assoc x (inv x) y) > mul (mul x (inv x)) y
      =< apH (\ z -> mul z y) (invr x) > mul e y
      =< unitl y > y } ;
  -- (y x^-1) x = y
  cancr (x y : G) : Id G (mul (mul y (inv x)) x) y = calc G {
    mul (mul y (inv x)) x =< assoc y (inv x) x > mul y (mul (inv x) x)
      =< apH (mul y) (invl x) > mul y e
      =< unitr y > y } ;
  -- (y x) x^-1 = y
  cancr' (x y : G) : Id G (mul (mul y x) (inv x)) y = calc G {
    mul (mul y x) (inv x) =< assoc y x (inv x) > mul y (mul x (inv x))
      =< apH (mul y) (invr x) > mul y e
      =< unitr y > y } ;
  -- a x = b gives a = b x^-1;  x a = b gives a = x^-1 b
  solve-r (a x b : G) (h : Id G (mul a x) b) : Id G a (mul b (inv x)) =
    transH (symH (cancr' x a)) (apH (\ z -> mul z (inv x)) h) ;
  solve-l (a x b : G) (h : Id G (mul x a) b) : Id G a (mul (inv x) b) =
    transH (symH (cancl x a)) (apH (mul (inv x)) h) ;
} ;

ab-grp (Gr : Torsor[l].Ab) : Grp =
  new Grp[Gr.A, Gr.setA, Gr.o, Gr.add, Gr.inv, Gr.assoc, Torsor[l].AbL[Gr].unitl, Gr.unitr,
    Torsor[l].AbL[Gr].invl, Gr.invr] ;
