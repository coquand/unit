-- For a short exact sequence of abelian groups 0 -> A -i-> B -p-> C -> 0
-- (in the form of ImageGroup / Exact: i injective, p i = 0, ker p in im i,
-- p onto), the fibre of p over c : C is an A-torsor (left action
-- a . b = i a + b, GTor of ab-grp A).
--   act    p (i a + b) = p (i a) + p b = 0 + c = c;
--   free   i a + b = b' = i a' + b gives i a = i a', so a = a' (inj);
--   trans  p (b' - b) = c - c = 0, so merely b' - b = i a (ex), and then
--          i a + b = b'; the type of such a is a proposition (free), so
--          it is contractible;
--   inh    p is onto.
-- Used to lift sections of C along p over a Stone space
-- (ccacoh/LiftStone: H¹ = 0 makes this torsor family trivial).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open Torsor[l] ; open EMMaps[l] ; open Group[l] ; open GTorsor[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Bj = Bijection[l] ;

module FibreTorsor (Ga Gb Gc : Ab) (i : Hom Ga Gb) (p : Hom Gb Gc)
  (inj : Bj.Injective i.1)
  (pi0 : (a : Ga.A) -> Id Gc.A (p.1 (i.1 a)) Gc.o)
  (ex : (b : Gb.A) -> Id Gc.A (p.1 b) Gc.o -> Tr.Trunc[Bj.Fibre i.1 b].carrier)
  (sur : (c : Gc.A) -> Tr.Trunc[Bj.Fibre p.1 c].carrier) (c : Gc.A) {
  F : U l = Bj.Fibre p.1 c ;
  setF : isSet F = isSet-Sigma Gb.A (\ b -> Id Gc.A (p.1 b) c) Gb.setA (\ b -> prop-to-set (Id Gc.A (p.1 b) c) (Gc.setA (p.1 b) c)) ;
  F-eq (u v : F) (e : Id Gb.A u.1 v.1) : Id F u v =
    Sigma-eq Gb.A (\ b -> Id Gc.A (p.1 b) c) u.1 v.1 u.2 v.2 e (Gc.setA (p.1 v.1) c) ;
  moved (a : Ga.A) (u : F) : Id Gc.A (p.1 (Gb.add (i.1 a) u.1)) c = calc Gc.A {
    p.1 (Gb.add (i.1 a) u.1) =< p.2 (i.1 a) u.1 >
    Gc.add (p.1 (i.1 a)) (p.1 u.1) =< apH (\ z -> Gc.add z (p.1 u.1)) (pi0 a) >
    Gc.add Gc.o (p.1 u.1) =< AbL[Gc].unitl (p.1 u.1) >
    p.1 u.1 =< u.2 > c } ;
  act (a : Ga.A) (u : F) : F = (Gb.add (i.1 a) u.1, moved a u) ;
  ad : GTor[ab-grp Ga].AD F act = \ a a' u -> F-eq (act (Ga.add a a') u) (act a (act a' u))
    (transH (apH (\ z -> Gb.add z u.1) (i.2 a a')) (Gb.assoc (i.1 a) (i.1 a') u.1)) ;
  ze : GTor[ab-grp Ga].ZE F act = \ u -> F-eq (act Ga.o u) u
    (transH (apH (\ z -> Gb.add z u.1) (hom-unit Ga Gb i)) (AbL[Gb].unitl u.1)) ;
  -- free: the a moving u to v is unique
  Moves (u v : F) : U l = (a : Ga.A) * Id F (act a u) v ;
  moves-prop (u v : F) : isProp (Moves u v) = \ w w' ->
    Sigma-eq Ga.A (\ a -> Id F (act a u) v) w.1 w'.1 w.2 w'.2
      (inj w.1 w'.1 (transH (AbL[Gb].solve (i.1 w.1) u.1 v.1 (ap F Gb.A (\ t -> t.1) (act w.1 u) v w.2))
                            (symH (AbL[Gb].solve (i.1 w'.1) u.1 v.1 (ap F Gb.A (\ t -> t.1) (act w'.1 u) v w'.2)))))
      (setF (act w'.1 u) v) ;
  -- transitive: p (v - u) = 0
  dv (u v : F) : Gb.A = Gb.add v.1 (Gb.inv u.1) ;
  pdv (u v : F) : Id Gc.A (p.1 (dv u v)) Gc.o = calc Gc.A {
    p.1 (Gb.add v.1 (Gb.inv u.1)) =< p.2 v.1 (Gb.inv u.1) >
    Gc.add (p.1 v.1) (p.1 (Gb.inv u.1)) =< apH (Gc.add (p.1 v.1)) (ImageGroup[l].hom-inv Gb Gc p u.1) >
    Gc.add (p.1 v.1) (Gc.inv (p.1 u.1)) =< apH (\ z -> Gc.add z (Gc.inv (p.1 u.1))) v.2 >
    Gc.add c (Gc.inv (p.1 u.1)) =< apH (\ z -> Gc.add c (Gc.inv z)) u.2 >
    Gc.add c (Gc.inv c) =< Gc.invr c > Gc.o } ;
  -- (v - u) + u = v
  back (u v : F) : Id Gb.A (Gb.add (dv u v) u.1) v.1 = calc Gb.A {
    Gb.add (Gb.add v.1 (Gb.inv u.1)) u.1 =< Gb.assoc v.1 (Gb.inv u.1) u.1 >
    Gb.add v.1 (Gb.add (Gb.inv u.1) u.1) =< apH (Gb.add v.1) (AbL[Gb].invl u.1) >
    Gb.add v.1 Gb.o =< Gb.unitr v.1 > v.1 } ;
  centre (u v : F) : Moves u v =
    TC.rec (Bj.Fibre i.1 (dv u v)) @l (Moves u v) (moves-prop u v)
      (\ f -> (f.1, F-eq (act f.1 u) v (transH (apH (\ z -> Gb.add z u.1) f.2) (back u v))))
      (ex (dv u v) (pdv u v)) ;
  ft : GTor[ab-grp Ga].FT F act = \ u v -> (centre u v, \ z -> moves-prop u v (centre u v) z) ;
  tor : GTor[ab-grp Ga].Tor = (F, (act, setF, ad, ze, ft, sur c)) ;
} ;
