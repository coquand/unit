-- The connecting map of a short exact sequence of complexes, in the degrees
-- of CCA Lemma B.0.5 (and the missing Lemma B.0.7), as algebra on abelian
-- groups.  Three rows of complexes
--     A1 -dA1-> A2 -dA2-> A3
--     B1 -dB1-> B2 -dB2-> B3          (dB2 dB1 = 0)
--     C1 -dC1-> C2
-- with i : A -> B, p : B -> C commuting with d, i2, i3 injective,
-- ker p_k in im i_k (k = 1, 2), p1 i1 = 0, p1 onto (merely).
-- Cocycles Z = ker d; Ȟ(A) = Z(A2) / im dA1; the C-side quotient Bnd C is a
-- parameter, together with lifts of its elements to B-cocycles.
--   For u in Z(C1) and a lift F (p1 F = u): p2 (dB1 F) = dC1 u = 0, so
--   dB1 F = i2 b for a unique b (beta); i3 (dA2 b) = dB2 dB1 F = 0, so b is
--   a cocycle.  Two lifts differ by i1 g (ker p1 in im i1), and then
--   i2 (b - b') = dB1 (i1 g) = i2 (dA1 g): b - b' is a coboundary.  So
--   δ u = [b] is well defined (u merely has a lift: ConstantMap), additive
--   (lifts add), and kills Bnd C (a lift that is a cocycle gives b = 0).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open AbHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;
module IG = ImageGroup[l] ;
module CG = CechGroups[l] ;

-- the fibre of an injective map into a set is a proposition
fibre-prop (A B : Ab) (h : Hom A B) (inj : Bj.Injective h.1) (b : B.A) : isProp (Bj.Fibre h.1 b) = \ w w' ->
  Sigma-eq A.A (\ a -> Id B.A (h.1 a) b) w.1 w'.1 w.2 w'.2 (inj w.1 w'.1 (transH w.2 (symH w'.2))) (B.setA (h.1 w'.1) b) ;
-- an injective homomorphism reflects o
inj-o (A B : Ab) (h : Hom A B) (inj : Bj.Injective h.1) (a : A.A) (e : Id B.A (h.1 a) B.o) : Id A.A a A.o =
  inj a A.o (transH e (symH (hom-unit A B h))) ;
module Snake (A1 A2 A3 B1 B2 B3 C1 C2 : Ab)
  (dA1 : Hom A1 A2) (dA2 : Hom A2 A3) (dB1 : Hom B1 B2) (dB2 : Hom B2 B3) (dC1 : Hom C1 C2)
  (i1 : Hom A1 B1) (i2 : Hom A2 B2) (i3 : Hom A3 B3) (p1 : Hom B1 C1) (p2 : Hom B2 C2)
  (sqA1 : (a : A1.A) -> Id B2.A (dB1.1 (i1.1 a)) (i2.1 (dA1.1 a)))
  (sqA2 : (a : A2.A) -> Id B3.A (dB2.1 (i2.1 a)) (i3.1 (dA2.1 a)))
  (sqC : (b : B1.A) -> Id C2.A (dC1.1 (p1.1 b)) (p2.1 (dB1.1 b)))
  (ddB : (b : B1.A) -> Id B3.A (dB2.1 (dB1.1 b)) B3.o)
  (inj2 : Bj.Injective i2.1) (inj3 : Bj.Injective i3.1)
  (pi1 : (a : A1.A) -> Id C1.A (p1.1 (i1.1 a)) C1.o)
  (ex1 : (b : B1.A) -> Id C1.A (p1.1 b) C1.o -> Tr.Trunc[Bj.Fibre i1.1 b].carrier)
  (ex2 : (b : B2.A) -> Id C2.A (p2.1 b) C2.o -> Tr.Trunc[Bj.Fibre i2.1 b].carrier)
  (pi2 : (a : A2.A) -> Id C2.A (p2.1 (i2.1 a)) C2.o)
  (lift1 : (c : C1.A) -> Tr.Trunc[Bj.Fibre p1.1 c].carrier)
  -- the A-side coboundaries, as a subgroup predicate equivalent to the image of dA1
  (PA : CG.Kern[A2, A3, dA2].ab.A -> U l) (pPA : (z : CG.Kern[A2, A3, dA2].ab.A) -> isProp (PA z)) (pa0 : PA CG.Kern[A2, A3, dA2].ab.o)
  (paadd : (z z' : CG.Kern[A2, A3, dA2].ab.A) -> PA z -> PA z' -> PA (CG.Kern[A2, A3, dA2].ab.add z z'))
  (painv : (z : CG.Kern[A2, A3, dA2].ab.A) -> PA z -> PA (CG.Kern[A2, A3, dA2].ab.inv z))
  (toA : (z : CG.Kern[A2, A3, dA2].ab.A) -> PA z -> Tr.Trunc[Bj.Fibre dA1.1 z.1].carrier)
  (fromA : (z : CG.Kern[A2, A3, dA2].ab.A) -> Tr.Trunc[Bj.Fibre dA1.1 z.1].carrier -> PA z) {
  module ZA = CG.Kern[A2, A3, dA2] ;
  module ZB = CG.Kern[B1, B2, dB1] ;
  module ZC = CG.Kern[C1, C2, dC1] ;
  module HA = CG.QAb[ZA.ab, PA, pPA, pa0, paadd, painv] ;
  module SA = Cochains[l].AbSub[A2] ;
  module SB1 = Cochains[l].AbSub[B1] ;
  module SB2 = Cochains[l].AbSub[B2] ;

  -- a lift of u
  Lift (u : ZC.ab.A) : U l = Bj.Fibre p1.1 u.1 ;
  module FromLift (u : ZC.ab.A) (F : Lift u) {
    dF : B2.A = dB1.1 F.1 ;
    p-dF : Id C2.A (p2.1 dF) C2.o = transH (symH (sqC F.1)) (transH (apH dC1.1 F.2) u.2) ;
    fib : Bj.Fibre i2.1 dF =
      TC.rec (Bj.Fibre i2.1 dF) @l (Bj.Fibre i2.1 dF) (fibre-prop A2 B2 i2 inj2 dF) (\ w -> w) (ex2 dF p-dF) ;
    beta : A2.A = fib.1 ;
    cocycle : Id A3.A (dA2.1 beta) A3.o =
      inj-o A3 B3 i3 inj3 (dA2.1 beta) (transH (symH (sqA2 beta)) (transH (apH dB2.1 fib.2) (ddB F.1))) ;
    z : ZA.ab.A = (beta, cocycle) ;
  } ;
  -- two lifts give the same class
  module Two (u : ZC.ab.A) (F F' : Lift u) {
    module L = FromLift[u, F] ;
    module L' = FromLift[u, F'] ;
    diff-p : Id C1.A (p1.1 (SB1.sub F.1 F'.1)) C1.o =
      transH (CG.hom-sub B1 C1 p1 F.1 F'.1) (transH (apH (\ c -> Cochains[l].AbSub[C1].sub c (p1.1 F'.1)) F.2)
        (transH (apH (Cochains[l].AbSub[C1].sub u.1) F'.2) (Cochains[l].AbSub[C1].sub-self u.1))) ;
    -- i2 (b - b') = dB1 (F - F') = dB1 (i1 g) = i2 (dA1 g)
    from-g (g : Bj.Fibre i1.1 (SB1.sub F.1 F'.1)) : Bj.Fibre dA1.1 (SA.sub L.beta L'.beta) =
      (g.1, inj2 (dA1.1 g.1) (SA.sub L.beta L'.beta) (calc B2.A {
        i2.1 (dA1.1 g.1) =< symH (sqA1 g.1) > dB1.1 (i1.1 g.1)
          =< apH dB1.1 g.2 > dB1.1 (SB1.sub F.1 F'.1)
          =< CG.hom-sub B1 B2 dB1 F.1 F'.1 > SB2.sub L.dF L'.dF
          =< symH (transH (apH (\ b -> SB2.sub b (i2.1 L'.beta)) L.fib.2) (apH (SB2.sub L.dF) L'.fib.2)) > SB2.sub (i2.1 L.beta) (i2.1 L'.beta)
          =< symH (CG.hom-sub A2 B2 i2 L.beta L'.beta) > i2.1 (SA.sub L.beta L'.beta) })) ;
    same : Id HA.QG.grp.G (HA.QG.cl L.z) (HA.QG.cl L'.z) =
      HA.QG.cl-rel L.z L'.z (fromA (HA.AA.AS.sub L.z L'.z) (TC.map (Bj.Fibre i1.1 (SB1.sub F.1 F'.1)) (Bj.Fibre dA1.1 (SA.sub L.beta L'.beta)) from-g (ex1 (SB1.sub F.1 F'.1) diff-p))) ;
  } ;
  -- δ on cocycles
  module D (u : ZC.ab.A) {
    module CM = ConstantMap[l].Constant[Lift u, HA.QG.grp.G, HA.QG.grp.setG, \ F -> HA.QG.cl FromLift[u, F].z, \ F F' -> Two[u, F, F'].same] ;
    value : HA.QG.grp.G = CM.value (lift1 u.1) ;
    value-at (F : Lift u) : Id HA.QG.grp.G value (HA.QG.cl FromLift[u, F].z) = CM.value-at (lift1 u.1) F ;
  } ;
  delta0 (u : ZC.ab.A) : HA.QG.grp.G = D[u].value ;
  -- lifts are additive, so δ is
  module Add (u u' : ZC.ab.A) (F : Lift u) (F' : Lift u') {
    module L = FromLift[u, F] ;
    module L' = FromLift[u', F'] ;
    FF : Lift (ZC.ab.add u u') = (B1.add F.1 F'.1, transH (p1.2 F.1 F'.1) (transH (apH (\ c -> C1.add c (p1.1 F'.1)) F.2) (apH (C1.add u.1) F'.2))) ;
    module LL = FromLift[ZC.ab.add u u', FF] ;
    beta-add : Id A2.A LL.beta (A2.add L.beta L'.beta) = inj2 LL.beta (A2.add L.beta L'.beta) (calc B2.A {
      i2.1 LL.beta =< LL.fib.2 > dB1.1 (B1.add F.1 F'.1) =< dB1.2 F.1 F'.1 > B2.add L.dF L'.dF
        =< symH (transH (apH (\ b -> B2.add b (i2.1 L'.beta)) L.fib.2) (apH (B2.add L.dF) L'.fib.2)) > B2.add (i2.1 L.beta) (i2.1 L'.beta)
        =< symH (i2.2 L.beta L'.beta) > i2.1 (A2.add L.beta L'.beta) }) ;
    cls-add : Id HA.QG.grp.G (HA.QG.cl LL.z) (HA.QG.grp.mul (HA.QG.cl L.z) (HA.QG.cl L'.z)) =
      transH (HA.QG.cl-eq LL.z (ZA.ab.add L.z L'.z) (ZA.eqA LL.z (ZA.ab.add L.z L'.z) beta-add)) (symH (HA.QG.cl-mul L.z L'.z)) ;
  } ;
  delta0-add (u u' : ZC.ab.A) : Id HA.QG.grp.G (delta0 (ZC.ab.add u u')) (HA.QG.grp.mul (delta0 u) (delta0 u')) =
    TC.rec (Lift u) @l (Id HA.QG.grp.G (delta0 (ZC.ab.add u u')) (HA.QG.grp.mul (delta0 u) (delta0 u'))) (HA.QG.grp.setG (delta0 (ZC.ab.add u u')) (HA.QG.grp.mul (delta0 u) (delta0 u'))) (\ F ->
    TC.rec (Lift u') @l (Id HA.QG.grp.G (delta0 (ZC.ab.add u u')) (HA.QG.grp.mul (delta0 u) (delta0 u'))) (HA.QG.grp.setG (delta0 (ZC.ab.add u u')) (HA.QG.grp.mul (delta0 u) (delta0 u'))) (\ F' -> calc HA.QG.grp.G {
      delta0 (ZC.ab.add u u') =< D[ZC.ab.add u u'].value-at Add[u, u', F, F'].FF > HA.QG.cl Add[u, u', F, F'].LL.z
        =< Add[u, u', F, F'].cls-add > HA.QG.grp.mul (HA.QG.cl FromLift[u, F].z) (HA.QG.cl FromLift[u', F'].z)
        =< symH (transH (apH (\ q -> HA.QG.grp.mul q (delta0 u')) (D[u].value-at F)) (apH (HA.QG.grp.mul (HA.QG.cl FromLift[u, F].z)) (D[u'].value-at F'))) >
      HA.QG.grp.mul (delta0 u) (delta0 u') }) (lift1 u'.1)) (lift1 u.1) ;
  -- a lift that is a cocycle gives the unit
  module Kill (u : ZC.ab.A) (F : Lift u) (c : Id B2.A (dB1.1 F.1) B2.o) {
    module L = FromLift[u, F] ;
    beta-o : Id A2.A L.beta A2.o = inj-o A2 B2 i2 inj2 L.beta (transH L.fib.2 c) ;
    unit : Id HA.QG.grp.G (delta0 u) HA.QG.grp.e =
      transH (D[u].value-at F) (HA.QG.cl-eq L.z ZA.ab.o (ZA.eqA L.z ZA.ab.o beta-o)) ;
  } ;

  -- exactness, on cocycles
  pZ (w : ZB.ab.A) : ZC.ab.A = (p1.1 w.1, transH (sqC w.1) (transH (apH p2.1 w.2) (hom-unit B2 C2 p2))) ;
  -- δ p = 0
  delta-p (w : ZB.ab.A) : Id HA.QG.grp.G (delta0 (pZ w)) HA.QG.grp.e = Kill[pZ w, (w.1, refl (p1.1 w.1)), w.2].unit ;
  -- ker δ in im p
  module KerIm (u : ZC.ab.A) (F : Lift u) (h : Id HA.QG.grp.G (delta0 u) HA.QG.grp.e) {
    module L = FromLift[u, F] ;
    bnd : Tr.Trunc[Bj.Fibre dA1.1 (HA.AA.AS.sub L.z ZA.ab.o).1].carrier =
      toA (HA.AA.AS.sub L.z ZA.ab.o) (HA.QG.cl-eff L.z ZA.ab.o (transH (symH (D[u].value-at F)) h)) ;
    module FromG (g : Bj.Fibre dA1.1 (SA.sub L.beta A2.o)) {
      w : ZB.ab.A = (SB1.sub F.1 (i1.1 g.1), calc B2.A {
          dB1.1 (SB1.sub F.1 (i1.1 g.1)) =< CG.hom-sub B1 B2 dB1 F.1 (i1.1 g.1) > SB2.sub L.dF (dB1.1 (i1.1 g.1))
            =< apH (SB2.sub L.dF) (sqA1 g.1) > SB2.sub L.dF (i2.1 (dA1.1 g.1))
            =< apH (\ b -> SB2.sub b (i2.1 (dA1.1 g.1))) (symH L.fib.2) > SB2.sub (i2.1 L.beta) (i2.1 (dA1.1 g.1))
            =< symH (CG.hom-sub A2 B2 i2 L.beta (dA1.1 g.1)) > i2.1 (SA.sub L.beta (dA1.1 g.1))
            =< apH i2.1 (transH (apH (SA.sub L.beta) (transH g.2 (SA.sub-o L.beta))) (SA.sub-self L.beta)) > i2.1 A2.o
            =< hom-unit A2 B2 i2 > B2.o }) ;
      eq : Id ZC.ab.A (pZ w) u = ZC.eqA (pZ w) u (calc C1.A {
          p1.1 (SB1.sub F.1 (i1.1 g.1)) =< CG.hom-sub B1 C1 p1 F.1 (i1.1 g.1) > Cochains[l].AbSub[C1].sub (p1.1 F.1) (p1.1 (i1.1 g.1))
            =< transH (apH (Cochains[l].AbSub[C1].sub (p1.1 F.1)) (pi1 g.1)) (Cochains[l].AbSub[C1].sub-o (p1.1 F.1)) > p1.1 F.1
            =< F.2 > u.1 }) ;
    } ;
    from-g (g : Bj.Fibre dA1.1 (SA.sub L.beta A2.o)) : (w : ZB.ab.A) * Id ZC.ab.A (pZ w) u = (FromG[g].w, FromG[g].eq) ;
    result : Tr.Trunc[(w : ZB.ab.A) * Id ZC.ab.A (pZ w) u].carrier =
      TC.map (Bj.Fibre dA1.1 (SA.sub L.beta A2.o)) ((w : ZB.ab.A) * Id ZC.ab.A (pZ w) u) from-g bnd ;
  } ;
  ker-im (u : ZC.ab.A) (h : Id HA.QG.grp.G (delta0 u) HA.QG.grp.e) : Tr.Trunc[(w : ZB.ab.A) * Id ZC.ab.A (pZ w) u].carrier =
    TC.rec (Lift u) @l (Tr.Trunc[(w : ZB.ab.A) * Id ZC.ab.A (pZ w) u].carrier) Tr.Trunc[(w : ZB.ab.A) * Id ZC.ab.A (pZ w) u].proposition
      (\ F -> KerIm[u, F, h].result) (lift1 u.1) ;
  -- δ onto, when the B-cocycles in B2 are coboundaries
  module Onto (vanB : (b : B2.A) -> Id B3.A (dB2.1 b) B3.o -> Tr.Trunc[Bj.Fibre dB1.1 b].carrier) (z : ZA.ab.A) {
    i-cocycle : Id B3.A (dB2.1 (i2.1 z.1)) B3.o = transH (sqA2 z.1) (transH (apH i3.1 z.2) (hom-unit A3 B3 i3)) ;
    module FromT (T : Bj.Fibre dB1.1 (i2.1 z.1)) {
      u : ZC.ab.A = (p1.1 T.1, transH (sqC T.1) (transH (apH p2.1 T.2) (pi2 z.1))) ;
      module L = FromLift[u, (T.1, refl (p1.1 T.1))] ;
      beta-z : Id A2.A L.beta z.1 = inj2 L.beta z.1 (transH L.fib.2 T.2) ;
      hit : Id HA.QG.grp.G (delta0 u) (HA.QG.cl z) =
        transH (D[u].value-at (T.1, refl (p1.1 T.1))) (HA.QG.cl-eq L.z z (ZA.eqA L.z z beta-z)) ;
    } ;
    result : Tr.Trunc[(u : ZC.ab.A) * Id HA.QG.grp.G (delta0 u) (HA.QG.cl z)].carrier =
      TC.map (Bj.Fibre dB1.1 (i2.1 z.1)) ((u : ZC.ab.A) * Id HA.QG.grp.G (delta0 u) (HA.QG.cl z)) (\ T -> (FromT[T].u, FromT[T].hit))
        (vanB (i2.1 z.1) i-cocycle) ;
  } ;
  -- on the quotient of Z(C1) by a subgroup that δ kills
  module OnQuot (PC : ZC.ab.A -> U l) (pPC : (u : ZC.ab.A) -> isProp (PC u)) (pc0 : PC ZC.ab.o)
    (pcadd : (u v : ZC.ab.A) -> PC u -> PC v -> PC (ZC.ab.add u v)) (pcinv : (u : ZC.ab.A) -> PC u -> PC (ZC.ab.inv u))
    (kills : (u : ZC.ab.A) -> PC u -> Id HA.QG.grp.G (delta0 u) HA.QG.grp.e) {
    module HC = CG.QAb[ZC.ab, PC, pPC, pc0, pcadd, pcinv] ;
    -- u = (u - u') + u'
    split-sub (u u' : ZC.ab.A) : Id ZC.ab.A u (ZC.ab.add (HC.AA.AS.sub u u') u') = symH (ZC.eqA (ZC.ab.add (HC.AA.AS.sub u u') u') u (calc C1.A {
      C1.add (C1.add u.1 (C1.inv u'.1)) u'.1 =< C1.assoc u.1 (C1.inv u'.1) u'.1 > C1.add u.1 (C1.add (C1.inv u'.1) u'.1)
        =< apH (C1.add u.1) (AbL[C1].invl u'.1) > C1.add u.1 C1.o =< C1.unitr u.1 > u.1 })) ;
    respect (u u' : ZC.ab.A) (r : PC (HC.AA.AS.sub u u')) : Id HA.QG.grp.G (delta0 u) (delta0 u') = calc HA.QG.grp.G {
      delta0 u =< apH delta0 (split-sub u u') > delta0 (ZC.ab.add (HC.AA.AS.sub u u') u')
        =< delta0-add (HC.AA.AS.sub u u') u' > HA.QG.grp.mul (delta0 (HC.AA.AS.sub u u')) (delta0 u')
        =< apH (\ q -> HA.QG.grp.mul q (delta0 u')) (kills (HC.AA.AS.sub u u') r) > HA.QG.grp.mul HA.QG.grp.e (delta0 u')
        =< HA.QG.grp.unitl (delta0 u') > delta0 u' } ;
    module DQ = HC.QG.Q.Descend[HA.QG.grp.G, HA.QG.grp.setG, delta0, respect] ;
    delta (q : HC.QG.grp.G) : HA.QG.grp.G = DQ.map q ;
    delta-cls (u : ZC.ab.A) : Id HA.QG.grp.G (delta (HC.QG.cl u)) (delta0 u) = DQ.beta u ;
    delta-hom : QGrp[l].GHom HC.QG.grp HA.QG.grp = (delta, \ q r ->
      HC.QG.ind @l (\ q1 -> Id HA.QG.grp.G (delta (HC.QG.grp.mul q1 r)) (HA.QG.grp.mul (delta q1) (delta r))) (\ q1 -> HA.QG.grp.setG (delta (HC.QG.grp.mul q1 r)) (HA.QG.grp.mul (delta q1) (delta r))) (\ u ->
      HC.QG.ind @l (\ r1 -> Id HA.QG.grp.G (delta (HC.QG.grp.mul (HC.QG.cl u) r1)) (HA.QG.grp.mul (delta (HC.QG.cl u)) (delta r1))) (\ r1 -> HA.QG.grp.setG (delta (HC.QG.grp.mul (HC.QG.cl u) r1)) (HA.QG.grp.mul (delta (HC.QG.cl u)) (delta r1))) (\ v -> calc HA.QG.grp.G {
        delta (HC.QG.grp.mul (HC.QG.cl u) (HC.QG.cl v)) =< apH delta (HC.QG.cl-mul u v) > delta (HC.QG.cl (ZC.ab.add u v))
          =< delta-cls (ZC.ab.add u v) > delta0 (ZC.ab.add u v) =< delta0-add u v > HA.QG.grp.mul (delta0 u) (delta0 v)
          =< symH (transH (apH (\ a -> HA.QG.grp.mul a (delta (HC.QG.cl v))) (delta-cls u)) (apH (HA.QG.grp.mul (delta0 u)) (delta-cls v))) >
        HA.QG.grp.mul (delta (HC.QG.cl u)) (delta (HC.QG.cl v)) }) r) q) ;
  } ;
} ;
