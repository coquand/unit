-- Fibres of pointed maps.  For f : (X, x0) ->pt (Y, y0):
--   Fib f = (x : X) * (f x = y0), pointed by (x0, pf); fpr : Fib f ->pt X.
--   omega-fib     Omega (Fib f) ~pt Fib (loop f), compatibly with the
--                 projections: fpr o Phi = loop fpr.  By J on pf it suffices
--                 that pf = refl; then by the fundamental theorem of identity
--                 types (b = v) ~ R v with R (x, p) = (q : x0 = x) *
--                 (ap f q . p = refl) (the total space is contractible: the
--                 singleton (x, q), then the fibre of p |-> refl . p over
--                 refl), and R b is Fib (loop f) up to loop-ap.
--   fib-equiv     a square of pointed maps with pointed equivalences on
--                 the sides gives a pointed equivalence of fibres, over the
--                 side on the domains (induction on pointed equivalences,
--                 then J on the square).
--   fib-conn      Fib f is 0-connected if X is, and every loop at f x0 is
--                 merely ap f of a loop at x0.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module P1 = Prelude[l+] ;
module G = Groupoid[l] ;

Fib (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) : U l = (x : X) * Id Y (f.1 x) y0 ;
fpt (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) : Fib X x0 Y y0 f = (x0, f.2) ;
fpr (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) : PtMap (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) X x0 =
  (\ w -> w.1, refl x0) ;

-- trans a (trans a^-1 p) = p
trans-cancel' (A : U l) (x y z : A) (a : Id A x y) (p : Id A x z) : Id (Id A x z) (trans A x y z a (trans A y x z (sym A x y a) p)) p =
  idJ A x (\ y1 a1 -> Id (Id A x z) (trans A x y1 z a1 (trans A y1 x z (sym A x y1 a1) p)) p)
    (transH (trans-refl-l A x z (trans A x x z (refl x) p)) (trans-refl-l A x z p)) y a ;
ap-id (A : U l) (x y : A) (p : Id A x y) : Id (Id A x y) (ap A A (\ a -> a) x y p) p =
  idJ A x (\ y1 p1 -> Id (Id A x y1) (ap A A (\ a -> a) x y1 p1) p1) (refl (refl x)) y p ;

-- identity laws of pointed composition
ptcomp-idl (A : U l) (a0 : A) (B : U l) (b0 : B) (F : PtMap A a0 B b0) : Id (PtMap A a0 B b0) (ptcomp A a0 A a0 B b0 (ptid A a0) F) F =
  ap (Id B (F.1 a0) b0) (PtMap A a0 B b0) (\ e -> (F.1, e)) (trans B (F.1 a0) (F.1 a0) b0 (refl (F.1 a0)) F.2) F.2
    (trans-refl-l B (F.1 a0) b0 F.2) ;
ptcomp-idr (A : U l) (a0 : A) (B : U l) (b0 : B) (F : PtMap A a0 B b0) : Id (PtMap A a0 B b0) (ptcomp A a0 B b0 B b0 F (ptid B b0)) F =
  ap (Id B (F.1 a0) b0) (PtMap A a0 B b0) (\ e -> (F.1, e)) (ap B B (\ b -> b) (F.1 a0) b0 F.2) F.2 (ap-id B (F.1 a0) b0 F.2) ;

-- Sigma of fibrewise equivalences
sigma-equiv (A : U l) (P Q : A -> U l) (e : (a : A) -> Equiv (P a) (Q a)) : Equiv ((a : A) * P a) ((a : A) * Q a) =
  (\ w -> (w.1, (e w.1).1 w.2),
   qinv ((a : A) * P a) ((a : A) * Q a) (\ w -> (w.1, (e w.1).1 w.2)) (\ w -> (w.1, (e w.1).2.sec w.2))
     (\ w -> ap (Q w.1) ((a : A) * Q a) (\ u -> (w.1, u)) ((e w.1).1 ((e w.1).2.sec w.2)) w.2 ((e w.1).2.sec-eq w.2))
     (\ w -> ap (P w.1) ((a : A) * P a) (\ u -> (w.1, u)) ((e w.1).2.sec ((e w.1).1 w.2)) w.2
               (sec-ret (P w.1) (Q w.1) (e w.1).1 (e w.1).2 w.2))) ;

-- composing with a fixed path is an equivalence
trans-equiv (A : U l) (x y z : A) (a : Id A x y) : Equiv (Id A y z) (Id A x z) =
  (trans A x y z a, qinv (Id A y z) (Id A x z) (trans A x y z a) (trans A y x z (sym A x y a))
     (trans-cancel' A x y z a) (trans-cancel A x y z a)) ;

------------------------------------------------------------------------
-- Omega (Fib f) ~ Fib (loop f), for f pointed by refl

module OmegaFib0 (X : U l) (x0 : X) (Y : U l) (f1 : X -> Y) {
  F0 : PtMap X x0 Y (f1 x0) = (f1, refl (f1 x0)) ;
  Fb : U l = Fib X x0 Y (f1 x0) F0 ;
  b : Fb = fpt X x0 Y (f1 x0) F0 ;
  R (v : Fb) : U l = (q : Id X x0 v.1) *
    Id (Id Y (f1 x0) (f1 x0)) (trans Y (f1 x0) (f1 v.1) (f1 x0) (ap X Y f1 x0 v.1 q) v.2) (refl (f1 x0)) ;
  r : R b = (refl x0, refl (refl (f1 x0))) ;
  Sg : U l = (x : X) * Id X x0 x ;
  Fam (s : Sg) : U l = (p : Id Y (f1 s.1) (f1 x0)) *
    Id (Id Y (f1 x0) (f1 x0)) (trans Y (f1 x0) (f1 s.1) (f1 x0) (ap X Y f1 x0 s.1 s.2) p) (refl (f1 x0)) ;
  -- the fibre over refl of p |-> refl . p is contractible
  fam0-s (w : Fam (x0, refl x0)) : (p : Id Y (f1 x0) (f1 x0)) * Id (Id Y (f1 x0) (f1 x0)) p (refl (f1 x0)) =
    (w.1, trans (Id Y (f1 x0) (f1 x0)) w.1 (trans Y (f1 x0) (f1 x0) (f1 x0) (refl (f1 x0)) w.1) (refl (f1 x0))
            (sym (Id Y (f1 x0) (f1 x0)) (trans Y (f1 x0) (f1 x0) (f1 x0) (refl (f1 x0)) w.1) w.1 (trans-refl-l Y (f1 x0) (f1 x0) w.1)) w.2) ;
  fam0-r (w : (p : Id Y (f1 x0) (f1 x0)) * Id (Id Y (f1 x0) (f1 x0)) p (refl (f1 x0))) : Fam (x0, refl x0) =
    (w.1, trans (Id Y (f1 x0) (f1 x0)) (trans Y (f1 x0) (f1 x0) (f1 x0) (refl (f1 x0)) w.1) w.1 (refl (f1 x0))
            (trans-refl-l Y (f1 x0) (f1 x0) w.1) w.2) ;
  fam0-rs (w : Fam (x0, refl x0)) : Id (Fam (x0, refl x0)) (fam0-r (fam0-s w)) w =
    ap (Id (Id Y (f1 x0) (f1 x0)) (trans Y (f1 x0) (f1 x0) (f1 x0) (refl (f1 x0)) w.1) (refl (f1 x0))) (Fam (x0, refl x0))
      (\ e -> (w.1, e)) (fam0-r (fam0-s w)).2 w.2
      (trans-cancel' (Id Y (f1 x0) (f1 x0)) (trans Y (f1 x0) (f1 x0) (f1 x0) (refl (f1 x0)) w.1) w.1 (refl (f1 x0))
         (trans-refl-l Y (f1 x0) (f1 x0) w.1) w.2) ;
  fam-contr : isContr (Fam (x0, refl x0)) =
    retract-contr (Fam (x0, refl x0)) ((p : Id Y (f1 x0) (f1 x0)) * Id (Id Y (f1 x0) (f1 x0)) p (refl (f1 x0)))
      fam0-s fam0-r fam0-rs (sing (Id Y (f1 x0) (f1 x0)) (refl (f1 x0))) ;
  Tot : U l = (v : Fb) * R v ;
  tot-s (t : Tot) : (s : Sg) * Fam s = ((t.1.1, t.2.1), (t.1.2, t.2.2)) ;
  tot-r (u : (s : Sg) * Fam s) : Tot = ((u.1.1, u.2.1), (u.1.2, u.2.2)) ;
  tot-contr : isContr Tot =
    retract-contr Tot ((s : Sg) * Fam s) tot-s tot-r (\ t -> refl t) (trunc-Sigma-contr zero Sg Fam (singL X x0) fam-contr) ;
  module FTb = FundThm[l].FT[Fb, b, R, r, tot-contr] ;

  module M = Maps[X, x0, Y, f1 x0] ;
  rho (q : Id X x0 x0) : Id M.OB (ap X Y f1 x0 x0 q) ((M.loop F0).1 q) =
    symH (transH (M.loop-ap F0 q) (trans-refl-l Y (f1 x0) (f1 x0) (ap X Y f1 x0 x0 q))) ;
  Fl : U l = Fib M.OA (refl x0) M.OB (refl (f1 x0)) (M.loop F0) ;
  move (q : Id X x0 x0) : Equiv (Id M.OB (ap X Y f1 x0 x0 q) (refl (f1 x0))) (Id M.OB ((M.loop F0).1 q) (refl (f1 x0))) =
    trans-equiv M.OB ((M.loop F0).1 q) (ap X Y f1 x0 x0 q) (refl (f1 x0)) (symH (rho q)) ;
  phi-equiv : Equiv (Id Fb b b) Fl =
    Equivalences[l].compose (Id Fb b b) (R b) Fl (FTb.tr b, FTb.equiv b)
      (sigma-equiv M.OA (\ q -> Id M.OB (ap X Y f1 x0 x0 q) (refl (f1 x0))) (\ q -> Id M.OB ((M.loop F0).1 q) (refl (f1 x0))) move) ;
  phi : PtEquiv (Id Fb b b) (refl b) Fl (fpt M.OA (refl x0) M.OB (refl (f1 x0)) (M.loop F0)) =
    ((phi-equiv.1, refl (fpt M.OA (refl x0) M.OB (refl (f1 x0)) (M.loop F0))), phi-equiv.2) ;
  -- the first component of transport in R is ap fpr
  tr-fst (v : Fb) (w : Id Fb b v) : Id (Id X x0 v.1) (FTb.tr v w).1 (ap Fb X (\ u -> u.1) b v w) =
    idJ Fb b (\ v1 w1 -> Id (Id X x0 v1.1) (FTb.tr v1 w1).1 (ap Fb X (\ u -> u.1) b v1 w1)) (refl (refl x0)) v w ;
  module MP = Maps[Fb, b, X, x0] ;
  compat : Id (PtMap (Id Fb b b) (refl b) M.OA (refl x0))
      (ptcomp (Id Fb b b) (refl b) Fl (fpt M.OA (refl x0) M.OB (refl (f1 x0)) (M.loop F0)) M.OA (refl x0)
         phi.1 (fpr M.OA (refl x0) M.OB (refl (f1 x0)) (M.loop F0)))
      (MP.loop (fpr X x0 Y (f1 x0) F0)) =
    ptmap-path (Id Fb b b) (refl b) M.OA (refl x0) (\ w -> (phi.1.1 w).1) (MP.loop (fpr X x0 Y (f1 x0) F0)).1
      (refl (refl x0)) (MP.loop (fpr X x0 Y (f1 x0) F0)).2
      (\ w -> transH (tr-fst b w) (transH (symH (trans-refl-l X x0 x0 (ap Fb X (\ u -> u.1) b b w)))
                (symH (MP.loop-ap (fpr X x0 Y (f1 x0) F0) w))))
      (refl (refl (refl x0))) ;
} ;

-- in general
OF (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) : U l =
  (Phi : PtEquiv (Id (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) (fpt X x0 Y y0 f)) (refl (fpt X x0 Y y0 f))
          (Fib (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop f))
          (fpt (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop f))) *
  Id (PtMap (Id (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) (fpt X x0 Y y0 f)) (refl (fpt X x0 Y y0 f)) (Id X x0 x0) (refl x0))
    (ptcomp (Id (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) (fpt X x0 Y y0 f)) (refl (fpt X x0 Y y0 f))
       (Fib (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop f))
       (fpt (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop f)) (Id X x0 x0) (refl x0)
       Phi.1 (fpr (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop f)))
    (Maps[Fib X x0 Y y0 f, fpt X x0 Y y0 f, X, x0].loop (fpr X x0 Y y0 f)) ;
omega-fib (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) : OF X x0 Y y0 f =
  idJ Y (f.1 x0) (\ y1 p1 -> OF X x0 Y y1 (f.1, p1)) (OmegaFib0[X, x0, Y, f.1].phi, OmegaFib0[X, x0, Y, f.1].compat) y0 f.2 ;

------------------------------------------------------------------------
-- fibres along a square of pointed equivalences

FibSq (X : U l) (x0 : X) (Y : U l) (y0 : Y) (X' : U l) (x0' : X') (Y' : U l) (y0' : Y')
  (eX : PtEquiv X x0 X' x0') (f : PtMap X x0 Y y0) (f' : PtMap X' x0' Y' y0') : U l =
  (Phi : PtEquiv (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) (Fib X' x0' Y' y0' f') (fpt X' x0' Y' y0' f')) *
  Id (PtMap (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) X' x0')
    (ptcomp (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) (Fib X' x0' Y' y0' f') (fpt X' x0' Y' y0' f') X' x0' Phi.1 (fpr X' x0' Y' y0' f'))
    (ptcomp (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) X x0 X' x0' (fpr X x0 Y y0 f) eX.1) ;

fib-path (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f f' : PtMap X x0 Y y0) (e : Id (PtMap X x0 Y y0) f f') :
  FibSq X x0 Y y0 X x0 Y y0 (idPt X x0) f f' =
  idJ (PtMap X x0 Y y0) f (\ f1 e1 -> FibSq X x0 Y y0 X x0 Y y0 (idPt X x0) f f1)
    (idPt (Fib X x0 Y y0 f) (fpt X x0 Y y0 f), refl (fpr X x0 Y y0 f)) f' e ;

fib-equiv (X : U l) (x0 : X) (Y : U l) (y0 : Y) (X' : U l) (x0' : X') (Y' : U l) (y0' : Y')
  (eX : PtEquiv X x0 X' x0') (eY : PtEquiv Y y0 Y' y0') (f : PtMap X x0 Y y0) (f' : PtMap X' x0' Y' y0')
  (sq : Id (PtMap X x0 Y' y0') (ptcomp X x0 Y y0 Y' y0' f eY.1) (ptcomp X x0 X' x0' Y' y0' eX.1 f')) :
  FibSq X x0 Y y0 X' x0' Y' y0' eX f f' =
  ptEqInd X x0 (\ X1 x1 e1 -> (Y1 : U l) (y1 : Y1) (eY1 : PtEquiv Y y0 Y1 y1) (f1 : PtMap X1 x1 Y1 y1)
      (sq1 : Id (PtMap X x0 Y1 y1) (ptcomp X x0 Y y0 Y1 y1 f eY1.1) (ptcomp X x0 X1 x1 Y1 y1 e1.1 f1)) ->
      FibSq X x0 Y y0 X1 x1 Y1 y1 e1 f f1)
    (\ Y1 y1 eY1 -> ptEqInd Y y0 (\ Y2 y2 e2 -> (f1 : PtMap X x0 Y2 y2)
        (sq1 : Id (PtMap X x0 Y2 y2) (ptcomp X x0 Y y0 Y2 y2 f e2.1) (ptcomp X x0 X x0 Y2 y2 (idPt X x0).1 f1)) ->
        FibSq X x0 Y y0 X x0 Y2 y2 (idPt X x0) f f1)
      (\ f1 sq1 -> fib-path X x0 Y y0 f f1
         (transH (symH (ptcomp-idr X x0 Y y0 f)) (transH sq1 (ptcomp-idl X x0 Y y0 f1))))
      Y1 y1 eY1)
    X' x0' eX Y' y0' eY f' sq ;

------------------------------------------------------------------------
-- 0-connectedness of a fibre

-- (u . u'^-1)^-1 . u = u'
cancel-u (B : U l) (x y b : B) (u : Id B y b) (u' : Id B x b) :
  Id (Id B x b) (trans B x y b (sym B y x (trans B y b x u (sym B x b u'))) u) u' =
  idJ B y (\ b1 u1 -> (u2 : Id B x b1) -> Id (Id B x b1) (trans B x y b1 (sym B y x (trans B y b1 x u1 (sym B x b1 u2))) u1) u2)
    (\ u2 -> transH (ap (Id B y x) (Id B x y) (sym B y x) (trans B y y x (refl y) (sym B x y u2)) (sym B x y u2)
                       (trans-refl-l B y x (sym B x y u2)))
                    (G.sym-sym B x y u2))
    b u u' ;

module FibConn (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) (cX : isConn (suc (suc zero)) X)
  (surj : (u : Id Y (f.1 x0) (f.1 x0)) -> Tr.Trunc[(q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u].carrier) {
  F : U l = Fib X x0 Y y0 f ;
  base (p p' : Id Y (f.1 x0) y0) : Tr.Trunc[Id F (x0, p) (x0, p')].carrier =
    TC.map ((q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) (trans Y (f.1 x0) y0 (f.1 x0) p (sym Y (f.1 x0) y0 p')))
      (Id F (x0, p) (x0, p'))
      (\ w -> Sigma-path X (\ x -> Id Y (f.1 x) y0) x0 x0 p p' w.1 (calc (Id Y (f.1 x0) y0) {
         subst X (\ x -> Id Y (f.1 x) y0) x0 x0 w.1 p =< G.transport-fib X Y f.1 y0 x0 x0 w.1 p >
         trans Y (f.1 x0) (f.1 x0) y0 (sym Y (f.1 x0) (f.1 x0) (ap X Y f.1 x0 x0 w.1)) p
           =< ap (Id Y (f.1 x0) (f.1 x0)) (Id Y (f.1 x0) y0) (\ z -> trans Y (f.1 x0) (f.1 x0) y0 (sym Y (f.1 x0) (f.1 x0) z) p)
                (ap X Y f.1 x0 x0 w.1) (trans Y (f.1 x0) y0 (f.1 x0) p (sym Y (f.1 x0) y0 p')) w.2 >
         trans Y (f.1 x0) (f.1 x0) y0 (sym Y (f.1 x0) (f.1 x0) (trans Y (f.1 x0) y0 (f.1 x0) p (sym Y (f.1 x0) y0 p'))) p
           =< cancel-u Y (f.1 x0) (f.1 x0) y0 p p' > p' }))
      (surj (trans Y (f.1 x0) y0 (f.1 x0) p (sym Y (f.1 x0) y0 p'))) ;
  paths (w w' : F) : Tr.Trunc[Id F w w'].carrier =
    conn-elim2 zero X x0 cX (\ x x' -> (p : Id Y (f.1 x) y0) (p' : Id Y (f.1 x') y0) -> Tr.Trunc[Id F (x, p) (x', p')].carrier)
      (\ x x' -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id Y (f.1 x) y0) (\ p -> (p' : Id Y (f.1 x') y0) -> Tr.Trunc[Id F (x, p) (x', p')].carrier)
         (\ p -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id Y (f.1 x') y0) (\ p' -> Tr.Trunc[Id F (x, p) (x', p')].carrier)
            (\ p' -> Tr.Trunc[Id F (x, p) (x', p')].proposition)))
      base w.1 w'.1 w.2 w'.2 ;
  conn : isConn (suc (suc zero)) F = (Tr.Trunc[F].inc (fpt X x0 Y y0 f), \ w w' -> (paths w w', \ a b -> tt)) ;
} ;

------------------------------------------------------------------------
-- a map g with a null composite f o g = const lifts to the fibre

fst-Sigma-path (A : U l) (B : A -> U l) (a a' : A) (b : B a) (b' : B a') (p : Id A a a') (q : Id (B a') (subst A B a a' p b) b') :
  Id (Id A a a') (ap ((x : A) * B x) A (\ w -> w.1) (a, b) (a', b') (Sigma-path A B a a' b b' p q)) p =
  idJ A a (\ a1 p1 -> (b1 : B a1) (q1 : Id (B a1) (subst A B a a1 p1 b) b1) ->
      Id (Id A a a1) (ap ((x : A) * B x) A (\ w -> w.1) (a, b) (a1, b1) (Sigma-path A B a a1 b b1 p1 q1)) p1)
    (\ b1 q1 -> idJ (B a) b (\ b2 q2 -> Id (Id A a a) (ap ((x : A) * B x) A (\ w -> w.1) (a, b) (a, b2) (Sigma-path A B a a b b2 (refl a) q2)) (refl a))
       (refl (refl a)) b1 q1)
    a' p b' q ;

module Lift (Z : U l) (z0 : Z) (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) (g : PtMap Z z0 X x0)
  (th : Id (PtMap Z z0 Y y0) (ptcomp Z z0 X x0 Y y0 g f) (ptconst Z z0 Y y0)) {
  P : Id (Z -> Y) (\ z -> f.1 (g.1 z)) (\ z -> y0) = ap (PtMap Z z0 Y y0) (Z -> Y) (\ w -> w.1) (ptcomp Z z0 X x0 Y y0 g f) (ptconst Z z0 Y y0) th ;
  hz (z : Z) : Id Y (f.1 (g.1 z)) y0 = happly Z (\ z1 -> Y) (\ z1 -> f.1 (g.1 z1)) (\ z1 -> y0) P z ;
  -- the pointing part of th
  k1 : Id (Id Y y0 y0) (trans Y y0 (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) y0 (hz z0)) (trans Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2)) (refl y0) =
    transH (symH (subst-pt Z z0 Y y0 (\ z -> f.1 (g.1 z)) (\ z -> y0) P (trans Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2)))
      (Sigma-snd (Z -> Y) (\ k -> Id Y (k z0) y0) (\ z -> f.1 (g.1 z)) (\ z -> y0)
         (trans Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2) (refl y0) th) ;
  e1 : Id (Id Y (f.1 (g.1 z0)) y0) (trans Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2) (hz z0) =
    transH (symH (trans-cancel' Y (f.1 (g.1 z0)) y0 y0 (hz z0) (trans Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2)))
      (apH (trans Y (f.1 (g.1 z0)) y0 y0 (hz z0)) k1) ;
  pt-q : Id (Id Y (f.1 x0) y0) (subst X (\ x -> Id Y (f.1 x) y0) (g.1 z0) x0 g.2 (hz z0)) f.2 =
    calc (Id Y (f.1 x0) y0) {
      subst X (\ x -> Id Y (f.1 x) y0) (g.1 z0) x0 g.2 (hz z0) =< G.transport-fib X Y f.1 y0 (g.1 z0) x0 g.2 (hz z0) >
      trans Y (f.1 x0) (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) (f.1 x0) (ap X Y f.1 (g.1 z0) x0 g.2)) (hz z0)
        =< apH (trans Y (f.1 x0) (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) (f.1 x0) (ap X Y f.1 (g.1 z0) x0 g.2))) (symH e1) >
      trans Y (f.1 x0) (f.1 (g.1 z0)) y0 (sym Y (f.1 (g.1 z0)) (f.1 x0) (ap X Y f.1 (g.1 z0) x0 g.2))
        (trans Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2)
        =< trans-cancel Y (f.1 (g.1 z0)) (f.1 x0) y0 (ap X Y f.1 (g.1 z0) x0 g.2) f.2 > f.2 } ;
  pt-path : Id (Fib X x0 Y y0 f) (g.1 z0, hz z0) (fpt X x0 Y y0 f) =
    Sigma-path X (\ x -> Id Y (f.1 x) y0) (g.1 z0) x0 (hz z0) f.2 g.2 pt-q ;
  lift : PtMap Z z0 (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) = (\ z -> (g.1 z, hz z), pt-path) ;
  lift-fst : Id (PtMap Z z0 X x0) (ptcomp Z z0 (Fib X x0 Y y0 f) (fpt X x0 Y y0 f) X x0 lift (fpr X x0 Y y0 f)) g =
    ap (Id X (g.1 z0) x0) (PtMap Z z0 X x0) (\ e -> (g.1, e))
      (ap (Fib X x0 Y y0 f) X (\ w -> w.1) (g.1 z0, hz z0) (fpt X x0 Y y0 f) pt-path) g.2
      (fst-Sigma-path X (\ x -> Id Y (f.1 x) y0) (g.1 z0) x0 (hz z0) f.2 g.2 pt-q) ;
} ;
