-- The Puppe sequence of a pointed map, and exactness of looped fibre
-- sequences (for the long exact cohomology sequence, CCA Lemma B.0.4).
-- For f : (E, e0) ->pt (B, b0) with fibre F = Fib f (Fibres):
--   dd        the boundary  ΩB -> F,  l |-> (e0, f0 . l)  (pointed by refl)
--   puppe1    ΩB ~ Fib (fpr f), l |-> (dd l, refl), over dd (by
--             definition): the inverse sends ((e, q), r : e = e0) to
--             f0^-1 . r_* q, and the two composites are the identity by
--             J on r, resp. trans-cancel.
--   GEX       exactness at E of the looped sequence: if M : F' ~ Fib f
--             lies over j : F' -> E, every loop g at e0 with
--             loop f g = refl merely is loop j of a loop at the base
--             of F'.  By omega-fib (Ω Fib f ~ Fib (loop f) over the
--             projections) (g, s) comes from a loop of Fib f, and M moves
--             it to F' (loop of the inverse; loop-comp).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Gp = Groupoid[l] ;

-- equal pointed maps have equal values
pt-happly (A : U l) (a0 : A) (B : U l) (b0 : B) (F G : PtMap A a0 B b0) (e : Id (PtMap A a0 B b0) F G) (a : A) : Id B (F.1 a) (G.1 a) =
  happly A (\ x -> B) F.1 G.1 (ap (PtMap A a0 B b0) (A -> B) (\ H -> H.1) F G e) a ;

-- the looping of the identity is the identity
loop-id (A : U l) (a0 : A) (q : Id A a0 a0) : Id (Id A a0 a0) ((Maps[A, a0, A, a0].loop (ptid A a0)).1 q) q =
  transH (Maps[A, a0, A, a0].loop-ap (ptid A a0) q)
    (transH (trans-refl-l A a0 a0 (ap A A (\ a -> a) a0 a0 q)) (ap-id A a0 a0 q)) ;

module Puppe (E : U l) (e0 : E) (B : U l) (b0 : B) (f : PtMap E e0 B b0) {
  F : U l = Fib E e0 B b0 f ;
  fp : F = fpt E e0 B b0 f ;
  OB : U l = Id B b0 b0 ;
  -- the boundary
  dd : PtMap OB (refl b0) F fp = (\ q -> (e0, trans B (f.1 e0) b0 b0 f.2 q), refl fp) ;
  g : PtMap F fp E e0 = fpr E e0 B b0 f ;
  G : U l = Fib F fp E e0 g ;
  gp : G = fpt F fp E e0 g ;
  -- ΩB ~ Fib (fpr f)
  p1 (q : OB) : G = (dd.1 q, refl e0) ;
  q1 (w : G) : OB = trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2) (subst E (\ e -> Id B (f.1 e) b0) w.1.1 e0 w.2 w.1.2) ;
  p1q1-gen (e : E) (r : Id E e e0) : (u : Id B (f.1 e) b0) -> Id G (p1 (q1 ((e, u), r))) ((e, u), r) =
    idJR E e0 (\ e1 r1 -> (u : Id B (f.1 e1) b0) -> Id G (p1 (q1 ((e1, u), r1))) ((e1, u), r1))
      (\ u -> ap (Id B (f.1 e0) b0) G (\ v -> ((e0, v), refl e0))
         (trans B (f.1 e0) b0 b0 f.2 (trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2) u)) u
         (trans-cancel' B (f.1 e0) b0 b0 f.2 u)) e r ;
  p1q1 (w : G) : Id G (p1 (q1 w)) w = p1q1-gen w.1.1 w.2 w.1.2 ;
  q1p1 (q : OB) : Id OB (q1 (p1 q)) q = trans-cancel B (f.1 e0) b0 b0 f.2 q ;
  puppe1 : PtEquiv OB (refl b0) G gp = ((p1, refl gp), qinv OB G p1 q1 p1q1 q1p1) ;
  -- over the boundary, by definition
  puppe1-over : Id (PtMap OB (refl b0) F fp) (ptcomp OB (refl b0) G gp F fp puppe1.1 (fpr F fp E e0 g)) dd = refl dd ;
} ;

-- exactness at the middle of a looped fibre sequence
module GEX (F' : U l) (f0 : F') (E : U l) (e0 : E) (B : U l) (b0 : B) (j : PtMap F' f0 E e0) (f : PtMap E e0 B b0)
  (M : PtEquiv F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f))
  (over : Id (PtMap F' f0 E e0) (ptcomp F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 M.1 (fpr E e0 B b0 f)) j) {
  F : U l = Fib E e0 B b0 f ;
  fp : F = fpt E e0 B b0 f ;
  OE : U l = Id E e0 e0 ;
  OF : U l = Id F fp fp ;
  OF' : U l = Id F' f0 f0 ;
  Lf : PtMap OE (refl e0) (Id B b0 b0) (refl b0) = Maps[E, e0, B, b0].loop f ;
  Lfpr : PtMap OF (refl fp) OE (refl e0) = Maps[F, fp, E, e0].loop (fpr E e0 B b0 f) ;
  Minv : PtMap F fp F' f0 = (pt-inv F' f0 F fp M).1 ;
  OFf : Fibres[l].OF E e0 B b0 f = omega-fib E e0 B b0 f ;
  -- every loop of Fib f is moved by loop M from a loop of F'
  back (lam : OF) : Id OF ((Maps[F', f0, F, fp].loop M.1).1 ((Maps[F, fp, F', f0].loop Minv).1 lam)) lam =
    transH (symH (pt-happly OF (refl fp) OF (refl fp)
                    (Maps[F, fp, F, fp].loop (ptcomp F fp F' f0 F fp Minv M.1))
                    (ptcomp OF (refl fp) OF' (refl f0) OF (refl fp) (Maps[F, fp, F', f0].loop Minv) (Maps[F', f0, F, fp].loop M.1))
                    (loop-comp F fp F' f0 F fp Minv M.1) lam))
      (transH (apH (\ H -> (Maps[F, fp, F, fp].loop H).1 lam) (pt-inv-r F' f0 F fp M)) (loop-id F fp lam)) ;
  -- loop j o loop Minv = loop fpr
  via (lam : OF) : Id OE ((Maps[F', f0, E, e0].loop j).1 ((Maps[F, fp, F', f0].loop Minv).1 lam)) (Lfpr.1 lam) = calc OE {
    (Maps[F', f0, E, e0].loop j).1 ((Maps[F, fp, F', f0].loop Minv).1 lam)
      =< symH (apH (\ H -> (Maps[F', f0, E, e0].loop H).1 ((Maps[F, fp, F', f0].loop Minv).1 lam)) over) >
    (Maps[F', f0, E, e0].loop (ptcomp F' f0 F fp E e0 M.1 (fpr E e0 B b0 f))).1 ((Maps[F, fp, F', f0].loop Minv).1 lam)
      =< pt-happly OF' (refl f0) OE (refl e0)
           (Maps[F', f0, E, e0].loop (ptcomp F' f0 F fp E e0 M.1 (fpr E e0 B b0 f)))
           (ptcomp OF' (refl f0) OF (refl fp) OE (refl e0) (Maps[F', f0, F, fp].loop M.1) Lfpr)
           (loop-comp F' f0 F fp E e0 M.1 (fpr E e0 B b0 f)) ((Maps[F, fp, F', f0].loop Minv).1 lam) >
    Lfpr.1 ((Maps[F', f0, F, fp].loop M.1).1 ((Maps[F, fp, F', f0].loop Minv).1 lam))
      =< apH Lfpr.1 (back lam) > Lfpr.1 lam } ;
  -- the loop of Fib f over (g, s)
  module At (g : OE) (s : Id (Id B b0 b0) (Lf.1 g) (refl b0)) {
    z : Fib OE (refl e0) (Id B b0 b0) (refl b0) Lf = (g, s) ;
    lam : OF = OFf.1.2.sec z ;
    proj : Id OE (Lfpr.1 lam) g = transH
      (symH (pt-happly OF (refl fp) OE (refl e0)
               (ptcomp OF (refl fp) (Fib OE (refl e0) (Id B b0 b0) (refl b0) Lf) (fpt OE (refl e0) (Id B b0 b0) (refl b0) Lf) OE (refl e0)
                  OFf.1.1 (fpr OE (refl e0) (Id B b0 b0) (refl b0) Lf))
               Lfpr OFf.2 lam))
      (apH (\ w -> w.1) (OFf.1.2.sec-eq z)) ;
    mu : OF' = (Maps[F, fp, F', f0].loop Minv).1 lam ;
    hit : Id OE ((Maps[F', f0, E, e0].loop j).1 mu) g = transH (via lam) proj ;
  } ;
  exact (g : OE) (h : Tr.Trunc[Id (Id B b0 b0) (Lf.1 g) (refl b0)].carrier) :
    Tr.Trunc[(mu : OF') * Id OE ((Maps[F', f0, E, e0].loop j).1 mu) g].carrier =
    TC.map (Id (Id B b0 b0) (Lf.1 g) (refl b0)) ((mu : OF') * Id OE ((Maps[F', f0, E, e0].loop j).1 mu) g)
      (\ s -> (At[g, s].mu, At[g, s].hit)) h ;
} ;

-- ap commutes with inverses
ap-sym (X Y : U l) (h : X -> Y) (a b : X) (q : Id X a b) : Id (Id Y (h b) (h a)) (sym Y (h a) (h b) (ap X Y h a b q)) (ap X Y h b a (sym X a b q)) =
  idJ X a (\ b1 q1 -> Id (Id Y (h b1) (h a)) (sym Y (h a) (h b1) (ap X Y h a b1 q1)) (ap X Y h b1 a (sym X a b1 q1))) (refl (refl (h a))) b q ;

-- Puppe 2: ΩE ~ Fib (dd), from Puppe 1 for f and for fpr f (Fibres.fib-equiv
-- along puppe1); the projection is g |-> loop f g^-1.
module Puppe2 (E : U l) (e0 : E) (B : U l) (b0 : B) (f : PtMap E e0 B b0) {
  module P = Puppe[E, e0, B, b0, f] ;
  module Q = Puppe[P.F, P.fp, E, e0, P.g] ;
  OE : U l = Id E e0 e0 ;
  FD : U l = Fib P.OB (refl b0) P.F P.fp P.dd ;
  fd : FD = fpt P.OB (refl b0) P.F P.fp P.dd ;
  FS : FibSq P.OB (refl b0) P.F P.fp P.G P.gp P.F P.fp P.puppe1 P.dd Q.g =
    fib-equiv P.OB (refl b0) P.F P.fp P.G P.gp P.F P.fp P.puppe1 (idPt P.F P.fp) P.dd Q.g
      (ptcomp-idr P.OB (refl b0) P.F P.fp P.dd) ;
  Phi : PtEquiv FD fd Q.G Q.gp = FS.1 ;
  puppe2 : PtEquiv OE (refl e0) FD fd = pt-comp OE (refl e0) Q.G Q.gp FD fd Q.puppe1 (pt-inv FD fd Q.G Q.gp Phi) ;
  -- the projection
  j : PtMap OE (refl e0) P.OB (refl b0) = ptcomp OE (refl e0) FD fd P.OB (refl b0) puppe2.1 (fpr P.OB (refl b0) P.F P.fp P.dd) ;
  -- fpr o Phi = puppe1 o fpr, so fpr (Phi^-1 y) = q1 y.1
  fst-inv (y : Q.G) : Id P.OB (Phi.2.sec y).1 (P.q1 y.1) = calc P.OB {
    (Phi.2.sec y).1 =< symH (P.q1p1 (Phi.2.sec y).1) > P.q1 (P.p1 (Phi.2.sec y).1)
      =< apH P.q1 (symH (transH (pt-happly FD fd P.G P.gp
              (ptcomp FD fd Q.G Q.gp P.G P.gp Phi.1 (fpr P.G P.gp P.F P.fp Q.g))
              (ptcomp FD fd P.OB (refl b0) P.G P.gp (fpr P.OB (refl b0) P.F P.fp P.dd) P.puppe1.1) FS.2 (Phi.2.sec y))
            (refl (P.p1 (Phi.2.sec y).1)))) >
    P.q1 (Phi.1.1 (Phi.2.sec y)).1 =< apH (\ w -> P.q1 w.1) (Phi.2.sec-eq y) > P.q1 y.1 } ;
  j-at (g : OE) : Id P.OB (j.1 g) ((Maps[E, e0, B, b0].loop f).1 (sym E e0 e0 g)) = calc P.OB {
    j.1 g =< fst-inv (Q.p1 g) > P.q1 (Q.dd.1 g)
      =< apH (trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2))
           (transH (Gp.transport-fib E B f.1 b0 e0 e0 (trans E e0 e0 e0 (refl e0) g) f.2)
             (apH (\ q -> trans B (f.1 e0) (f.1 e0) b0 q f.2)
               (transH (apH (\ q -> sym B (f.1 e0) (f.1 e0) (ap E B f.1 e0 e0 q)) (trans-refl-l E e0 e0 g))
                       (ap-sym E B f.1 e0 e0 g)))) >
    trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2) (trans B (f.1 e0) (f.1 e0) b0 (ap E B f.1 e0 e0 (sym E e0 e0 g)) f.2)
      =< symH (Maps[E, e0, B, b0].loop-ap f (sym E e0 e0 g)) > (Maps[E, e0, B, b0].loop f).1 (sym E e0 e0 g) } ;
} ;
