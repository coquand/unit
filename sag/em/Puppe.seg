-- The Puppe sequence of a pointed map, and exactness of looped fibre
-- sequences (for the long exact cohomology sequence, CCA Lemma B.0.4).
-- For f : (E, e0) ->pt (B, b0) with fibre F = Fib f (Fibres):
--   dd        the boundary  ΩB -> F,  l |-> (e0, f0 . l)  (pointed by refl)
--   puppe1    ΩB ~ Fib (fpr f), l |-> (dd l, refl), over dd (by
--             definition): the inverse sends ((e, q), r : e = e0) to
--             f0^-1 . r_* q, and the two composites are the identity by
--             J on r, resp. trans-cancel.
--   GEX       exactness at E of the looped sequence: if M : F' ~ Fib f
--             lies over j : F' -> E, every loop g at e0 with
--             loop f g = refl merely is loop j of a loop at the base
--             of F'.  By omega-fib (Ω Fib f ~ Fib (loop f) over the
--             projections) (g, s) comes from a loop of Fib f, and M moves
--             it to F' (loop of the inverse; loop-comp).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Fibres[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Gp = Groupoid[l] ;

-- equal pointed maps have equal values
pt-happly (A : U l) (a0 : A) (B : U l) (b0 : B) (F G : PtMap A a0 B b0) (e : Id (PtMap A a0 B b0) F G) (a : A) : Id B (F.1 a) (G.1 a) =
  happly A (\ x -> B) F.1 G.1 (ap (PtMap A a0 B b0) (A -> B) (\ H -> H.1) F G e) a ;

-- the looping of the identity is the identity
loop-id (A : U l) (a0 : A) (q : Id A a0 a0) : Id (Id A a0 a0) ((Maps[A, a0, A, a0].loop (ptid A a0)).1 q) q =
  transH (Maps[A, a0, A, a0].loop-ap (ptid A a0) q)
    (transH (trans-refl-l A a0 a0 (ap A A (\ a -> a) a0 a0 q)) (ap-id A a0 a0 q)) ;

module Puppe (E : U l) (e0 : E) (B : U l) (b0 : B) (f : PtMap E e0 B b0) {
  -- the boundary
  dd : PtMap (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) = (\ q -> (e0, trans B (f.1 e0) b0 b0 f.2 q), refl (fpt E e0 B b0 f)) ;
  -- ΩB ~ Fib (fpr f)
  p1 (q : (Id B b0 b0)) : (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) = (dd.1 q, refl e0) ;
  q1 (w : (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) : (Id B b0 b0) = trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2) (subst E (\ e -> Id B (f.1 e) b0) w.1.1 e0 w.2 w.1.2) ;
  p1q1-gen (e : E) (r : Id E e e0) : (u : Id B (f.1 e) b0) -> Id (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (p1 (q1 ((e, u), r))) ((e, u), r) =
    idJR E e0 (\ e1 r1 -> (u : Id B (f.1 e1) b0) -> Id (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (p1 (q1 ((e1, u), r1))) ((e1, u), r1))
      (\ u -> ap (Id B (f.1 e0) b0) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (\ v -> ((e0, v), refl e0))
         (trans B (f.1 e0) b0 b0 f.2 (trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2) u)) u
         (trans-cancel' B (f.1 e0) b0 b0 f.2 u)) e r ;
  p1q1 (w : (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) : Id (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (p1 (q1 w)) w = p1q1-gen w.1.1 w.2 w.1.2 ;
  q1p1 (q : (Id B b0 b0)) : Id (Id B b0 b0) (q1 (p1 q)) q = trans-cancel B (f.1 e0) b0 b0 f.2 q ;
  puppe1 : PtEquiv (Id B b0 b0) (refl b0) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) = ((p1, refl (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))), qinv (Id B b0 b0) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) p1 q1 p1q1 q1p1) ;
  -- over the boundary, by definition
  puppe1-over : Id (PtMap (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f)) (ptcomp (Id B b0 b0) (refl b0) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) puppe1.1 (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) dd = refl dd ;
} ;

-- exactness at the middle of a looped fibre sequence
module GEX (F' : U l) (f0 : F') (E : U l) (e0 : E) (B : U l) (b0 : B) (j : PtMap F' f0 E e0) (f : PtMap E e0 B b0)
  (M : PtEquiv F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f))
  (over : Id (PtMap F' f0 E e0) (ptcomp F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 M.1 (fpr E e0 B b0 f)) j) {
  Lf : PtMap (Id E e0 e0) (refl e0) (Id B b0 b0) (refl b0) = Maps[E, e0, B, b0].loop f ;
  Lfpr : PtMap (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Id E e0 e0) (refl e0) = Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), E, e0].loop (fpr E e0 B b0 f) ;
  Minv : PtMap (Fib E e0 B b0 f) (fpt E e0 B b0 f) F' f0 = (pt-inv F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) M).1 ;
  OFf : Fibres[l].OF E e0 B b0 f = omega-fib E e0 B b0 f ;
  -- every loop of Fib f is moved by loop M from a loop of F'
  back (lam : (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f))) : Id (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) ((Maps[F', f0, (Fib E e0 B b0 f), (fpt E e0 B b0 f)].loop M.1).1 ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam)) lam =
    transH (symH (pt-happly (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f))
                    (Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), (Fib E e0 B b0 f), (fpt E e0 B b0 f)].loop (ptcomp (Fib E e0 B b0 f) (fpt E e0 B b0 f) F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) Minv M.1))
                    (ptcomp (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Id F' f0 f0) (refl f0) (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv) (Maps[F', f0, (Fib E e0 B b0 f), (fpt E e0 B b0 f)].loop M.1))
                    (loop-comp (Fib E e0 B b0 f) (fpt E e0 B b0 f) F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) Minv M.1) lam))
      (transH (apH (\ H -> (Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), (Fib E e0 B b0 f), (fpt E e0 B b0 f)].loop H).1 lam) (pt-inv-r F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) M)) (loop-id (Fib E e0 B b0 f) (fpt E e0 B b0 f) lam)) ;
  -- loop j o loop Minv = loop fpr
  via (lam : (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f))) : Id (Id E e0 e0) ((Maps[F', f0, E, e0].loop j).1 ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam)) (Lfpr.1 lam) = calc (Id E e0 e0) {
    (Maps[F', f0, E, e0].loop j).1 ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam)
      =< symH (apH (\ H -> (Maps[F', f0, E, e0].loop H).1 ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam)) over) >
    (Maps[F', f0, E, e0].loop (ptcomp F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 M.1 (fpr E e0 B b0 f))).1 ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam)
      =< pt-happly (Id F' f0 f0) (refl f0) (Id E e0 e0) (refl e0)
           (Maps[F', f0, E, e0].loop (ptcomp F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 M.1 (fpr E e0 B b0 f)))
           (ptcomp (Id F' f0 f0) (refl f0) (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Id E e0 e0) (refl e0) (Maps[F', f0, (Fib E e0 B b0 f), (fpt E e0 B b0 f)].loop M.1) Lfpr)
           (loop-comp F' f0 (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 M.1 (fpr E e0 B b0 f)) ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam) >
    Lfpr.1 ((Maps[F', f0, (Fib E e0 B b0 f), (fpt E e0 B b0 f)].loop M.1).1 ((Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam))
      =< apH Lfpr.1 (back lam) > Lfpr.1 lam } ;
  -- the loop of Fib f over (g, s)
  module At (g : (Id E e0 e0)) (s : Id (Id B b0 b0) (Lf.1 g) (refl b0)) {
    z : Fib (Id E e0 e0) (refl e0) (Id B b0 b0) (refl b0) Lf = (g, s) ;
    lam : (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) = OFf.1.2.sec z ;
    proj : Id (Id E e0 e0) (Lfpr.1 lam) g = transH
      (symH (pt-happly (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Id E e0 e0) (refl e0)
               (ptcomp (Id (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpt E e0 B b0 f)) (refl (fpt E e0 B b0 f)) (Fib (Id E e0 e0) (refl e0) (Id B b0 b0) (refl b0) Lf) (fpt (Id E e0 e0) (refl e0) (Id B b0 b0) (refl b0) Lf) (Id E e0 e0) (refl e0)
                  OFf.1.1 (fpr (Id E e0 e0) (refl e0) (Id B b0 b0) (refl b0) Lf))
               Lfpr OFf.2 lam))
      (apH (\ w -> w.1) (OFf.1.2.sec-eq z)) ;
    mu : (Id F' f0 f0) = (Maps[(Fib E e0 B b0 f), (fpt E e0 B b0 f), F', f0].loop Minv).1 lam ;
    hit : Id (Id E e0 e0) ((Maps[F', f0, E, e0].loop j).1 mu) g = transH (via lam) proj ;
  } ;
  exact (g : (Id E e0 e0)) (h : Tr.Trunc[Id (Id B b0 b0) (Lf.1 g) (refl b0)].carrier) :
    Tr.Trunc[(mu : (Id F' f0 f0)) * Id (Id E e0 e0) ((Maps[F', f0, E, e0].loop j).1 mu) g].carrier =
    TC.map (Id (Id B b0 b0) (Lf.1 g) (refl b0)) ((mu : (Id F' f0 f0)) * Id (Id E e0 e0) ((Maps[F', f0, E, e0].loop j).1 mu) g)
      (\ s -> (At[g, s].mu, At[g, s].hit)) h ;
} ;

-- ap commutes with inverses
ap-sym (X Y : U l) (h : X -> Y) (a b : X) (q : Id X a b) : Id (Id Y (h b) (h a)) (sym Y (h a) (h b) (ap X Y h a b q)) (ap X Y h b a (sym X a b q)) =
  idJ X a (\ b1 q1 -> Id (Id Y (h b1) (h a)) (sym Y (h a) (h b1) (ap X Y h a b1 q1)) (ap X Y h b1 a (sym X a b1 q1))) (refl (refl (h a))) b q ;

-- Puppe 2: ΩE ~ Fib (dd), from Puppe 1 for f and for fpr f (Fibres.fib-equiv
-- along puppe1); the projection is g |-> loop f g^-1.
module Puppe2 (E : U l) (e0 : E) (B : U l) (b0 : B) (f : PtMap E e0 B b0) {
  module P = Puppe[E, e0, B, b0, f] ;
  module Q = Puppe[(Fib E e0 B b0 f), (fpt E e0 B b0 f), E, e0, (fpr E e0 B b0 f)] ;
  FS : FibSq (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.puppe1 P.dd (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) =
    fib-equiv (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.puppe1 (idPt (Fib E e0 B b0 f) (fpt E e0 B b0 f)) P.dd (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))
      (ptcomp-idr (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) ;
  Phi : PtEquiv (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (Fib (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) (fpt (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) = FS.1 ;
  puppe2 : PtEquiv (Id E e0 e0) (refl e0) (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) = pt-comp (Id E e0 e0) (refl e0) (Fib (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) (fpt (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) Q.puppe1 (pt-inv (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (Fib (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) (fpt (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) Phi) ;
  -- the projection
  j : PtMap (Id E e0 e0) (refl e0) (Id B b0 b0) (refl b0) = ptcomp (Id E e0 e0) (refl e0) (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (Id B b0 b0) (refl b0) puppe2.1 (fpr (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) ;
  -- fpr o Phi = puppe1 o fpr, so fpr (Phi^-1 y) = q1 y.1
  fst-inv (y : (Fib (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)))) : Id (Id B b0 b0) (Phi.2.sec y).1 (P.q1 y.1) = calc (Id B b0 b0) {
    (Phi.2.sec y).1 =< symH (P.q1p1 (Phi.2.sec y).1) > P.q1 (P.p1 (Phi.2.sec y).1)
      =< apH P.q1 (symH (transH (pt-happly (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))
              (ptcomp (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (Fib (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) (fpt (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) Phi.1 (fpr (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (Fib E e0 B b0 f) (fpt E e0 B b0 f) (fpr (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f))))
              (ptcomp (Fib (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (fpt (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) (Id B b0 b0) (refl b0) (Fib (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpt (Fib E e0 B b0 f) (fpt E e0 B b0 f) E e0 (fpr E e0 B b0 f)) (fpr (Id B b0 b0) (refl b0) (Fib E e0 B b0 f) (fpt E e0 B b0 f) P.dd) P.puppe1.1) FS.2 (Phi.2.sec y))
            (refl (P.p1 (Phi.2.sec y).1)))) >
    P.q1 (Phi.1.1 (Phi.2.sec y)).1 =< apH (\ w -> P.q1 w.1) (Phi.2.sec-eq y) > P.q1 y.1 } ;
  j-at (g : (Id E e0 e0)) : Id (Id B b0 b0) (j.1 g) ((Maps[E, e0, B, b0].loop f).1 (sym E e0 e0 g)) = calc (Id B b0 b0) {
    j.1 g =< fst-inv (Q.p1 g) > P.q1 (Q.dd.1 g)
      =< apH (trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2))
           (transH (Gp.transport-fib E B f.1 b0 e0 e0 (trans E e0 e0 e0 (refl e0) g) f.2)
             (apH (\ q -> trans B (f.1 e0) (f.1 e0) b0 q f.2)
               (transH (apH (\ q -> sym B (f.1 e0) (f.1 e0) (ap E B f.1 e0 e0 q)) (trans-refl-l E e0 e0 g))
                       (ap-sym E B f.1 e0 e0 g)))) >
    trans B b0 (f.1 e0) b0 (sym B (f.1 e0) b0 f.2) (trans B (f.1 e0) (f.1 e0) b0 (ap E B f.1 e0 e0 (sym E e0 e0 g)) f.2)
      =< symH (Maps[E, e0, B, b0].loop-ap f (sym E e0 e0 g)) > (Maps[E, e0, B, b0].loop f).1 (sym E e0 e0 g) } ;
} ;
