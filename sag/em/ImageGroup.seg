-- The cokernel L = A^T / A of CCA Thm 3.2.5, represented as the image of
-- the Čech differential  d : A^T -> A^(T x T),  d f (t, t') = f t' - f t,
-- so that no quotient is needed (the paper: "L(x) is a quotient of overtly
-- discrete groups"; here it is a Sigma over A^(T x T) of truncated fibres).
--   img-ab h     the image of a homomorphism h : G -> H, a subgroup of H
--   Cech T A     for T merely inhabited: the short exact sequence
--                0 -> A -i-> A^T -p-> Im d -> 0, i the diagonal (as in
--                Eps.Diag), p the corestriction of d.  Exactness: d f = 0
--                means f is constant, f = i (f t0) for a point t0 of T.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Bj = Bijection[l] ;

-- laws of abelian groups used below
module AbMore (G : Ab) {
  open G ;
  open AbL[G] ;
  -- a + b = o gives b = -a
  inv-unique (a b : A) (h : Id A (add a b) o) : Id A b (inv a) = calc A {
    b =< symH (unitl b) > add o b =< apH (\ c -> add c b) (symH (invl a)) > add (add (inv a) a) b
      =< assoc (inv a) a b > add (inv a) (add a b) =< apH (add (inv a)) h > add (inv a) o =< unitr (inv a) > inv a } ;
  -- (a + b) + (c + e) = (a + c) + (b + e)
  shuffle (a b c e : A) : Id A (add (add a b) (add c e)) (add (add a c) (add b e)) = calc A {
    add (add a b) (add c e) =< assoc a b (add c e) > add a (add b (add c e))
      =< apH (add a) (symH (assoc b c e)) > add a (add (add b c) e)
      =< apH (\ z -> add a (add z e)) (comm b c) > add a (add (add c b) e)
      =< apH (add a) (assoc c b e) > add a (add c (add b e))
      =< symH (assoc a c (add b e)) > add (add a c) (add b e) } ;
  inv-add (a b : A) : Id A (inv (add a b)) (add (inv a) (inv b)) =
    symH (inv-unique (add a b) (add (inv a) (inv b))
      (transH (shuffle a b (inv a) (inv b)) (transH (apH (\ z -> add z (add b (inv b))) (invr a))
        (transH (apH (add o) (invr b)) (unitr o))))) ;
} ;

hom-inv (Ga Gb : Ab) (h : Hom Ga Gb) (x : Ga.A) : Id Gb.A (h.1 (Ga.inv x)) (Gb.inv (h.1 x)) =
  AbMore[Gb].inv-unique (h.1 x) (h.1 (Ga.inv x))
    (transH (symH (h.2 x (Ga.inv x))) (transH (apH h.1 (Ga.invr x)) (hom-unit Ga Gb h))) ;

module Img (Ga Gb : Ab) (h : Hom Ga Gb) {
  Cond (y : Gb.A) : U l = Tr.Trunc[Bj.Fibre h.1 y].carrier ;
  C : U l = (y : Gb.A) * Cond y ;
  setC : isSet C = isSet-sub Gb.A Cond Gb.setA (\ y -> Tr.Trunc[Bj.Fibre h.1 y].proposition) ;
  eqC (u v : C) (e : Id Gb.A u.1 v.1) : Id C u v = Sigma-eq Gb.A Cond u.1 v.1 u.2 v.2 e (Tr.Trunc[Bj.Fibre h.1 v.1].proposition) ;
  o : C = (Gb.o, Tr.Trunc[Bj.Fibre h.1 Gb.o].inc (Ga.o, hom-unit Ga Gb h)) ;
  add (u v : C) : C = (Gb.add u.1 v.1,
    TC.map2 (Bj.Fibre h.1 u.1) (Bj.Fibre h.1 v.1) (Bj.Fibre h.1 (Gb.add u.1 v.1))
      (\ a b -> (Ga.add a.1 b.1, transH (h.2 a.1 b.1) (transH (apH (\ z -> Gb.add z (h.1 b.1)) a.2) (apH (Gb.add u.1) b.2)))) u.2 v.2) ;
  inv (u : C) : C = (Gb.inv u.1,
    TC.map (Bj.Fibre h.1 u.1) (Bj.Fibre h.1 (Gb.inv u.1)) (\ a -> (Ga.inv a.1, transH (hom-inv Ga Gb h a.1) (apH Gb.inv a.2))) u.2) ;
  ab : Ab = new Ab[C, setC, o, add, inv,
    \ u v w -> eqC (add (add u v) w) (add u (add v w)) (Gb.assoc u.1 v.1 w.1),
    \ u v -> eqC (add u v) (add v u) (Gb.comm u.1 v.1),
    \ u -> eqC (add u o) u (Gb.unitr u.1),
    \ u -> eqC (add u (inv u)) o (Gb.invr u.1)] ;
  -- the corestriction, onto by definition
  core : Hom Ga ab = (\ a -> (h.1 a, Tr.Trunc[Bj.Fibre h.1 (h.1 a)].inc (a, refl (h.1 a))),
    \ a b -> eqC (h.1 (Ga.add a b), Tr.Trunc[Bj.Fibre h.1 (h.1 (Ga.add a b))].inc (Ga.add a b, refl (h.1 (Ga.add a b))))
                 (add (h.1 a, Tr.Trunc[Bj.Fibre h.1 (h.1 a)].inc (a, refl (h.1 a))) (h.1 b, Tr.Trunc[Bj.Fibre h.1 (h.1 b)].inc (b, refl (h.1 b))))
                 (h.2 a b)) ;
  core-onto (u : C) : Tr.Trunc[Bj.Fibre core.1 u].carrier =
    TC.map (Bj.Fibre h.1 u.1) (Bj.Fibre core.1 u) (\ a -> (a.1, eqC (core.1 a.1) u a.2)) u.2 ;
} ;

module Cech (T : U l) (hT : Tr.Trunc[T].carrier) (Ga : Ab) {
  open Ga ;
  module M = AbMore[Ga] ;
  AT : Ab = Eps[l].prod-ab T (\ t -> Ga) ;
  AT2 : Ab = Eps[l].prod-ab (T * T) (\ w -> Ga) ;
  i : Hom Ga AT = (\ a t -> a, \ x y -> refl (\ t -> add x y)) ;
  dfun (f : T -> A) (w : T * T) : A = add (f w.2) (inv (f w.1)) ;
  d : Hom AT AT2 = (dfun, \ f g -> FL.funext (T * T) (\ w -> A) (dfun (\ t -> add (f t) (g t))) (\ w -> add (dfun f w) (dfun g w))
    (\ w -> transH (apH (add (add (f w.2) (g w.2))) (M.inv-add (f w.1) (g w.1))) (M.shuffle (f w.2) (g w.2) (inv (f w.1)) (inv (g w.1))))) ;
  module I = Img[AT, AT2, d] ;
  L : Ab = I.ab ;
  p : Hom AT L = I.core ;
  -- the short exact sequence
  inj : Bj.Injective i.1 = \ a a' q ->
    Tr.Trunc[T].induction @l (\ v -> Id A a a') (\ v -> setA a a')
      (\ t -> happly T (\ t1 -> A) (\ t1 -> a) (\ t1 -> a') q t) hT ;
  pi0 (a : A) : Id L.A (p.1 (i.1 a)) L.o =
    I.eqC (p.1 (i.1 a)) L.o (FL.funext (T * T) (\ w -> A) (dfun (\ t -> a)) (\ w -> o) (\ w -> invr a)) ;
  canc (x y : A) : Id A (add (add y (inv x)) x) y = transH (assoc y (inv x) x) (transH (apH (add y) (AbL[Ga].invl x)) (unitr y)) ;
  constant (f : T -> A) (z : Id L.A (p.1 f) L.o) (t t' : T) : Id A (f t) (f t') =
    symH (transH (symH (canc (f t) (f t')))
            (transH (apH (\ c -> add c (f t))
                       (happly (T * T) (\ w -> A) (dfun f) (\ w -> o) (ap L.A AT2.A (\ u -> u.1) (p.1 f) L.o z) (t, t')))
                    (AbL[Ga].unitl (f t)))) ;
  ex (f : T -> A) (z : Id L.A (p.1 f) L.o) : Tr.Trunc[Bj.Fibre i.1 f].carrier =
    TC.map T (Bj.Fibre i.1 f) (\ t0 -> (f t0, FL.funext T (\ t -> A) (\ t -> f t0) f (constant f z t0))) hT ;
  sur (u : L.A) : Tr.Trunc[Bj.Fibre p.1 u].carrier = I.core-onto u ;
} ;
