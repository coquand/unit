-- The fundamental theorem of identity types (Rijke, Thm 11.2.2), as used
-- in the proof of DW1 Theorem 2.  For x : X, R : X -> U with r : R x and
-- (y : X) * R y contractible, transport of r,
--     tr y : (x = y) -> R y,     tr y p = p_* r,
-- is an equivalence.  Its inverse is the first component of the path from
-- (x, r) to (y, rho) in the contractible total space; tr (un rho) = rho is
-- Prelude.Sigma-snd, and un (tr p) = p is J with pathC-refl at refl.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;

module FT (X : U l) (x : X) (R : X -> U l) (r : R x) (c : isContr ((y : X) * R y)) {
  tr (y : X) (p : Id X x y) : R y = subst X R x y p r ;
  -- by definition
  tr-refl : Id (R x) (tr x (refl x)) r = refl r ;
  un (y : X) (rho : R y) : Id X x y =
    ap ((z : X) * R z) X (\ w -> w.1) (x, r) (y, rho) (pathC ((z : X) * R z) c (x, r) (y, rho)) ;
  tr-un (y : X) (rho : R y) : Id (R y) (tr y (un y rho)) rho =
    Sigma-snd X R x y r rho (pathC ((z : X) * R z) c (x, r) (y, rho)) ;
  un-tr (y : X) (p : Id X x y) : Id (Id X x y) (un y (tr y p)) p =
    idJ X x (\ y1 p1 -> Id (Id X x y1) (un y1 (tr y1 p1)) p1)
      (ap (Id ((z : X) * R z) (x, r) (x, r)) (Id X x x) (ap ((z : X) * R z) X (\ w -> w.1) (x, r) (x, r))
         (pathC ((z : X) * R z) c (x, r) (x, r)) (refl (x, r)) (pathC-refl ((z : X) * R z) c (x, r)))
      y p ;
  equiv (y : X) : isEquiv (Id X x y) (R y) (tr y) =
    qinv (Id X x y) (R y) (tr y) (un y) (tr-un y) (un-tr y) ;
} ;
