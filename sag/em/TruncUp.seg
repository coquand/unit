-- isTrunc at two levels: for X : U l, HLevels[l].isTrunc n X and
-- HLevels[l+].isTrunc n X unfold to the same type; by induction on n.
level l ;
open Base ;
module H = HLevels[l] ; module H1 = HLevels[l+] ;

trunc-up : (n : Nat) (X : U l) -> H.isTrunc n X -> H1.isTrunc n X = split {
  zero -> \ X c -> c ;
  suc n | r -> \ X t x y -> r (Id X x y) (t x y) } ;

trunc-down : (n : Nat) (X : U l) -> H1.isTrunc n X -> H.isTrunc n X = split {
  zero -> \ X c -> c ;
  suc n | r -> \ X t x y -> r (Id X x y) (t x y) } ;
