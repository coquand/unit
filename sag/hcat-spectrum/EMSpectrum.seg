-- Assemble the already constructed Eilenberg-MacLane spaces into
-- pointed Omega-spectrum data. Space 0 is the abelian group as a set;
-- Space (n+1) is K(A,n+1). The first structure equivalence is the band
-- Omega K(A,1) ~ A, pointed by band-unit. The remaining equivalences
-- are EM.EMSpace.loops. No categorical or stability axioms are added.
-- This constructs an object, not the higher category of spectra,
-- its copowers, or the comparison of homology with singular chains.
level l ; open Base ; open Prelude[l] ; open Lemma4[l] ;

record OmegaSpectrum {
 space (n : Nat) : U l ;
 point (n : Nat) : space n ;
 step (n : Nat) : PtEquiv
  (Id (space (suc n)) (point (suc n)) (point (suc n))) (refl (point (suc n)))
  (space n) (point n) ;
} ;

module Coefficient (Gr : Torsor[l].Ab) {
 module K = EM[l].EMSpace[Gr] ;
 space : Nat -> U l = split { zero -> Gr.A ; suc n -> K.K n } ;
 point : (n : Nat) -> space n = split { zero -> Gr.o ; suc n -> K.pt n } ;
 step : (n : Nat) -> PtEquiv
  (Id (space (suc n)) (point (suc n)) (point (suc n))) (refl (point (suc n)))
  (space n) (point n) = split {
   zero -> ((K.loop0.1, K.E1.band-unit K.E1.k0), K.loop0.2) ;
   suc n -> K.loops n } ;
 spectrum : OmegaSpectrum = new OmegaSpectrum[space, point, step] ;
 zero-space : Id (U l) (spectrum.space zero) Gr.A = refl Gr.A ;
 positive-space (n : Nat) : Id (U l) (spectrum.space (suc n)) (K.K n) = refl (K.K n) ;
 zero-addition (p q : Id (spectrum.space (suc zero)) (spectrum.point (suc zero)) (spectrum.point (suc zero))) :
  Id Gr.A ((spectrum.step zero).1.1 (Paths[l].transH p q))
   (Gr.add ((spectrum.step zero).1.1 p) ((spectrum.step zero).1.1 q)) = K.loop0-hom p q ;
 opaque spectrum ;
} ;
