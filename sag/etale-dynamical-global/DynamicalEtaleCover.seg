-- The constructive finite-tree counterpart of ClassicalEtaleCover.
-- Leaves already contain charts over the original base. Constructing
-- these leaves from the local theorem is a separate obligation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Big = Truncation[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R)
 (iota : RingHom[l].Hom A E) {
 module St = Local[l].Statement[A,setA,E,setE,iota,\ s -> Empty] ;
 module C = St.C ; module SE = St.SE ;
 Chart (s : E.R) : U l+ = (T : C.Algebra) * (i : C.Hom St.Ealg T) * St.IsLocalisation T i s *
  (Q G : SE.RX.Carrier) * SE.Points[Q,G].Standard T ;
 module Global = DynamicalCertifiedCover[l].Over[E,setE,Chart] ;
 theorem : Global.Proof.Cover Global.T.root -> Big.Trunc[Global.Cover].carrier = Global.theorem ;
 EtaleChart (s : E.R) : U l+ = (T : C.Algebra) * (i : C.Hom St.Ealg T) * St.IsLocalisation T i s *
  (Q G : SE.RX.Carrier) * SE.Points[Q,G].Standard T * FormallyEtale[l].Over[A,setA].Etale T ;
 module FlatGlobal = DynamicalCertifiedCover[l].Over[E,setE,EtaleChart] ;
 flat-theorem : FlatGlobal.Proof.Cover FlatGlobal.T.root -> Big.Trunc[FlatGlobal.Cover].carrier = FlatGlobal.theorem ;
 monic-terms : List A.R -> List A.R = FirstUnitData[l].monic A ;
 MonicChart (s : E.R) : U l+ = (lower : List A.R) * (T : C.Algebra) *
  (i : C.Hom St.Ealg T) * St.IsLocalisation T i s * (G : SE.RX.Carrier) *
  SE.Points[SE.RX.include (monic-terms lower),G].Standard T ;
 forget-monic (s : E.R) (h : MonicChart s) : Chart s =
  (h.2.1,h.2.2.1,h.2.2.2.1,SE.RX.include (monic-terms h.1),h.2.2.2.2.1,h.2.2.2.2.2) ;
 module MonicGlobal = DynamicalCertifiedCover[l].Over[E,setE,MonicChart] ;
 monic-theorem : MonicGlobal.Proof.Cover MonicGlobal.T.root -> Big.Trunc[MonicGlobal.Cover].carrier = MonicGlobal.theorem ;
} ;
