-- Localising a standard algebra at F(x) is standard for (Q,G F).
-- This upgrades StandardEtale.Localise from points to the full
-- algebra universal property, retaining Q (and hence its monicity).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Algebras[l].Over[A,setA].Algebra)
 (Q G : StandardEtale[l].Over[A,setA].RX.Carrier)
 (st : StandardEtale[l].Over[A,setA].Points[Q,G].Standard E)
 (F0 : StandardEtale[l].Over[A,setA].RX.Carrier) {
 module SE = StandardEtale[l].Over[A,setA] ; module C = SE.C ;
 module St = Local[l].Statement[A,setA,E.ring,E.set,E.iota,\ s -> Empty] ;
 module Pg = SE.Points[Q,G] ;
 module Pgf = SE.Points[Q,SE.RX.ring.mul G F0] ;
 f : E.ring.R = SE.At[E.ring,E.set,E.iota,st.1.1].value F0 ;
 module Given (T : C.Algebra) (i : C.Hom E T) (localisation : St.IsLocalisation T i f) {
  y : T.ring.R = i.1.1 st.1.1 ;
  module N = SE.Natural[E.ring,T.ring,E.set,T.set,E.iota,T.iota,i.1,i.2,st.1.1] ;
  point : Pgf.Point T = (y,SE.Localise[Q,G,F0,T,y].from (Pg.push E st.1 T i).2
   (subst RL[T.ring].unit (N.value F0) localisation.1)) ;
  module To (B : C.Algebra) {
   Data : U l = (h : C.Hom E B) * RL[B.ring].unit (h.1.1 f) ;
   restrict : C.Hom T B -> Data = St.Restrict T i f localisation.1 B ;
   forward : C.Hom T B -> Pgf.Point B = Pgf.push T point B ;
   module AtPoint (p : Pgf.Point B) {
    pg : Pg.Point B = (p.1,SE.Localise[Q,G,F0,B,p.1].to p.2) ;
    h : C.Hom E B = (st.2 B).sec pg ;
    on-generator : Id B.ring.R (h.1.1 st.1.1) p.1 = ap (\ x -> x.1) ((st.2 B).sec-eq pg) ;
    module HN = SE.Natural[E.ring,B.ring,E.set,B.set,E.iota,B.iota,h.1,h.2,st.1.1] ;
    unit : RL[B.ring].unit (h.1.1 f) =
     subst RL[B.ring].unit (sym (trans (HN.value F0)
      (ap (\ b -> SE.At[B.ring,B.set,B.iota,b].value F0) on-generator)))
      (SE.Localise[Q,G,F0,B,p.1].to-unit p.2) ;
    datum : Data = (h,unit) ;
    extension : C.Hom T B = (localisation.2 B).sec datum ;
    restricted : Id (C.Hom E B) (C.compose E T B extension i) h =
     ap (\ d -> d.1) ((localisation.2 B).sec-eq datum) ;
    on-y : Id B.ring.R (extension.1.1 y) p.1 =
     trans (ap (\ h -> h.1.1 st.1.1) restricted) on-generator ;
   } ;
   backward (p : Pgf.Point B) : C.Hom T B = AtPoint[p].extension ;
   fb (p : Pgf.Point B) : Id (Pgf.Point B) (forward (backward p)) p =
    Pgf.point-ext B _ p AtPoint[p].on-y ;
   source-eq (h : C.Hom T B) :
    Id (C.Hom E B) (C.compose E T B (backward (forward h)) i) (C.compose E T B h i) =
    Equivalences[l].injective _ _ (Pg.push E st.1 B) (st.2 B) _ _
     (Pg.point-ext B _ _ AtPoint[forward h].on-y) ;
   bf (h : C.Hom T B) : Id (C.Hom T B) (backward (forward h)) h =
    Equivalences[l].injective _ _ restrict (localisation.2 B) _ _
     (Pr.Sigma-eq (C.Hom E B) (\ k -> RL[B.ring].unit (k.1.1 f))
      _ _ _ _ (source-eq h) (FormallyEtale[l].Units[B.ring,B.set].unit-prop _)) ;
   universal : Pr.isEquiv (C.Hom T B) (Pgf.Point B) forward = Pr.qinv _ _ forward backward fb bf ;
  } ;
  standard : Pgf.Standard T = (point,\ B -> To[B].universal) ;
 } ;
 -- A presentation and an expression for f construct the localisation,
 -- rather than assuming that an algebra satisfying its property exists.
 module Presented (p : Presentations[l].Over[A,setA].Presentation)
  (pa : Presentations[l].Over[A,setA].Presents p E)
  (expression : Presentations[l].Over[A,setA].Expr (Presentations[l].Fin p.1))
  (rep : Id E.ring.R (Presentations[l].Over[A,setA].eval (Presentations[l].Fin p.1) E pa.1.1 expression) f) {
  module Lc = Localization[l].Over[A,setA,E,p,pa,f,expression,rep] ;
  localisation : St.IsLocalisation Lc.algebra Lc.inclusion f =
   (Lc.inverse,\ B -> Equivalences[l].homotopy _ _ Lc.Canonical[B].equivalence
    (St.Restrict Lc.algebra Lc.inclusion f Lc.inverse B)
    (\ h -> Lc.To[B].data-ext _ _ (refl (C.compose E Lc.algebra B h Lc.inclusion)))) ;
  standard : Pgf.Standard Lc.algebra = Given[Lc.algebra,Lc.inclusion,localisation].standard ;
  module Charts = DynamicalEtaleCover[l].Over[A,setA,E.ring,E.set,E.iota] ;
  chart : Charts.Chart f = (Lc.algebra,Lc.inclusion,localisation,Q,SE.RX.ring.mul G F0,standard) ;
 } ;
} ;
