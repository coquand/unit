-- A constructed two-branch cover at a and 1-a. Neither is assumed a unit.
level l ; open Ring[l] ; open Presentations[l] ;
module Big = Truncation[l+] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) (Certificate : A.R -> U l+) (a : A.R) {
 module Global = DynamicalCertifiedCover[l].Over[A,setA,Certificate] ;
 module T = Global.T ;
 b : A.R = A.add A.o (A.neg a) ;
 left : T.State = T.radical T.root a ;
 right : T.State = T.invert T.root a ;
 module LN = T.At[left].N ; module RN = T.At[right].N ;
 left-denominator : T.Denominator left b =
  (A.o,LN.M.one,A.neg a,IdealArithmetic[l].Over[A,setA].In[LN.I].negative a (LN.J.generator (inr tt)),refl b) ;
 right-denominator : T.Denominator right a =
  (a,RN.M.generator (inr tt),A.z,RN.J.zero-member,sym (A.addZ a)) ;
 tree : T.Tree = branch a leaf leaf ;
 leaves (cb : Certificate b) (ca : Certificate a) : Global.Proof.Leaves tree T.root =
  ((b,left-denominator,cb),(a,right-denominator,ca)) ;
 given (cb : Certificate b) (ca : Certificate a) : Big.Trunc[Global.Cover].carrier =
  Global.At[tree,leaves cb ca].result ;
 theorem (cb : Big.Trunc[Certificate b].carrier) (ca : Big.Trunc[Certificate a].carrier) :
  Big.Trunc[Global.Cover].carrier =
  TruncationCombinators[l+].bind2 (Certificate b) (Certificate a) Global.Cover given cb ca ;
} ;
