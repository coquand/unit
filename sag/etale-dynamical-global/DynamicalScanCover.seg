-- Composition with a real finite decision procedure. The scan is
-- constructed here; only the continuation producing chart leaves is input.
level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) (Certificate : A.R -> U l+)
 (cs : List A.R) {
 module Global = DynamicalCertifiedCover[l].Over[A,setA,Certificate] ;
 module Scan = DynamicalCoefficientScan[l].Over[A,setA] ;
 module Input = Scan.Input[Global.T.root,cs] ;
 module Given (finish : (state : Global.T.State) -> Input.Outcome state -> Global.Proof.Cover state) {
  module Continue = Global.Trees.FromSmall[Input.Outcome,Global.Leaf,finish] ;
  tree : Global.Proof.Cover Global.T.root = Continue.bind Global.T.root (Scan.scan cs Global.T.root) ;
  theorem : Truncation[l+].Trunc[Global.Cover].carrier = Global.theorem tree ;
 } ;
} ;
