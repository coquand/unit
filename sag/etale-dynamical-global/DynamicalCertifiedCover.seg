-- Finite radical/unit proofs give certified principal covers.
-- The certificates may contain algebras and universal properties.
-- Only denominators are passed to the small comaximality theorem;
-- the certificates are retained by structural recursion, without resizing.
level l ; open Ring[l] ; open Presentations[l] ;
module Big = Truncation[l+] ;
section (n : Nat) (B : Fin (suc n) -> U l+)
 (old : (i : Fin n) -> B (inl i)) (last : B (inr tt)) : (i : Fin (suc n)) -> B i = split {
 inl i -> old i ;
 inr t -> idJ Top tt (\ u h -> B (inr u)) last t (AffineFinite[l].top-eq tt t) } ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) (Certificate : A.R -> U l+) {
 module T = FormalMonoidTree[l].Over[A,setA] ;
 module Small = FormalMonoidCover[l].Over[A,setA] ;
 module Trees = LargeTreeCover[l].Over[A,setA] ;
 module FS = FinSum[l] ;
 module S = FiniteIdeal[l].Sums[A] ;
 Leaf (state : T.State) : U l+ = (s : A.R) * T.Denominator state s * Certificate s ;
 module Proof = Trees.For[Leaf] ;
 Cover : U l+ = (n : Nat) * (s a : Fin n -> A.R) *
  ((i : Fin n) -> Certificate (s i)) * Id A.R (S.lin n s a) A.o ;
 erase : (tree : T.Tree) (state : T.State) -> Proof.Leaves tree state -> Small.Choices tree state = split {
  leaf -> \ state w -> (w.1,w.2.1) ;
  branch a left right | il ir -> \ state w ->
   (il (T.radical state a) w.1,ir (T.invert state a) w.2) } ;
 combine (n : Nat) (f : Fin n -> A.R) (a : (i : Fin n) -> Certificate (f i)) :
  (m : Nat) (g : Fin m -> A.R) -> ((i : Fin m) -> Certificate (g i)) ->
  (i : Fin (plus m n)) -> Certificate (FS.cases n A.R f m g i) = split {
  zero -> \ g b -> a ;
  suc m | ih -> \ g b -> section (plus m n)
   (\ i -> Certificate (FS.cases n A.R f (suc m) g i))
   (ih (\ i -> g (inl i)) (\ i -> b (inl i))) (b (inr tt)) } ;
 certificates : (tree : T.Tree) (state : T.State) (w : Proof.Leaves tree state) ->
  (i : Fin (Small.count tree)) -> Certificate (Small.values tree state (erase tree state w) i) = split {
  leaf -> \ state w i -> w.2.2 ;
  branch a left right | il ir -> \ state w ->
   combine (Small.count left) (Small.values left (T.radical state a) (erase left (T.radical state a) w.1))
    (il (T.radical state a) w.1)
    (Small.count right) (Small.values right (T.invert state a) (erase right (T.invert state a) w.2))
    (ir (T.invert state a) w.2) } ;
 module At (tree : T.Tree) (leaves : Proof.Leaves tree T.root) {
  module P = Small.At[tree,erase tree T.root leaves] ;
  assemble (w : P.Coordinates) : Cover =
   (P.n,P.fs,w.1,certificates tree T.root leaves,w.2) ;
  result : Big.Trunc[Cover].carrier =
   TruncationCombinators[l].rec P.Coordinates @l+ Big.Trunc[Cover].carrier Big.Trunc[Cover].proposition
    (\ w -> Big.Trunc[Cover].inc (assemble w)) P.partition ;
 } ;
 theorem : Proof.Cover T.root -> Big.Trunc[Cover].carrier =
  TruncationCombinators[l+].rec (Proof.Witness T.root) @l+ Big.Trunc[Cover].carrier Big.Trunc[Cover].proposition
   (\ w -> At[w.1,w.2].result) ;
} ;
