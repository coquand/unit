-- A finite prefix: all earlier coefficients radical, this one a unit.
level l ; open Ring[l] ;
module Over (A : CRing) (m : A.R -> U l) {
 First : List A.R -> U l = split {
  nil -> Empty ;
  cons c cs | r -> Plus (RL[A].unit c) (m c * r) } ;
} ;
map (X Y : U l) (f : X -> Y) : List X -> List Y = split {
 nil -> nil ; cons x xs | r -> cons (f x) r } ;
monic (A : CRing) : List A.R -> List A.R = split {
 nil -> cons A.o nil ; cons c cs | r -> cons c r } ;
