-- Constructed branches, large certificates, the first-unit algebra,
-- and actual presented standard algebras; no primewise oracle occurs.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Big = Truncation[l+] ;
module LargeCertificates (A : CRing) (setA : Pr.isSet A.R) (a : A.R) {
 b : A.R = A.add A.o (A.neg a) ;
 Certificate (s : A.R) : U l+ = (X : U l) * X * Plus (Id A.R s a) (Id A.R s b) ;
 module Pair = DynamicalComplementaryCover[l].Over[A,setA,Certificate,a] ;
 theorem : Big.Trunc[Pair.Global.Cover].carrier =
  Pair.given (Top,tt,inr (refl b)) (Top,tt,inl (refl a)) ;
 two-leaves : Id Nat (Pair.Global.Small.count Pair.tree) (suc (suc zero)) = refl (suc (suc zero)) ;
 left-value : Id A.R (Pair.Global.Small.values Pair.tree Pair.T.root
  (Pair.Global.erase Pair.tree Pair.T.root (Pair.leaves (Top,tt,inr (refl b)) (Top,tt,inl (refl a))))
  (inl (inr tt))) b = refl b ;
 right-value : Id A.R (Pair.Global.Small.values Pair.tree Pair.T.root
  (Pair.Global.erase Pair.tree Pair.T.root (Pair.leaves (Top,tt,inr (refl b)) (Top,tt,inl (refl a))))
  (inr tt)) a = refl a ;
} ;
module Scans (A : CRing) (setA : Pr.isSet A.R) (a b : A.R) {
 module S = DynamicalCoefficientScan[l].Over[A,setA] ;
 constant : S.Input[S.T.root,nil].Cover.Cover S.T.root = S.scan nil S.T.root ;
 linear : S.Input[S.T.root,cons a nil].Cover.Cover S.T.root = S.scan (cons a nil) S.T.root ;
 quadratic : S.Input[S.T.root,cons a (cons b nil)].Cover.Cover S.T.root = S.scan (cons a (cons b nil)) S.T.root ;
 -- Continue the actual small scan into a universe-valued certificate.
 Certificate (s : A.R) : U l+ = (X : U l) * X * Id A.R s A.o ;
 module Run = DynamicalScanCover[l].Over[A,setA,Certificate,cons a (cons b nil)] ;
 finish (state : S.T.State) (w : Run.Input.Outcome state) : Run.Global.Proof.Cover state =
  Run.Global.Proof.immediate state (A.o,S.T.At[state].N.S.unit,Top,tt,refl A.o) ;
 theorem : Big.Trunc[Run.Global.Cover].carrier = Run.Given[finish].theorem ;
} ;
module FirstRelation (A : CRing) {
 I (a : A.R) : U l = Id A.R a A.z ;
 zero-member : I A.z = refl A.z ;
 addition (a b : A.R) (ha : I a) (hb : I b) : I (A.add a b) =
  trans (Presentations[l].cong2 A.R A.add _ _ _ _ ha hb) (A.addZ A.z) ;
 scale (a b : A.R) (hb : I b) : I (A.mul a b) = trans (ap (A.mul a) hb) (RL[A].mul-zero a) ;
 module R = FirstUnitRelation[l].Over[A,I,A,RingHom[l].identity A,I,zero-member,addition,scale,\ a h -> h,A.z] ;
 cs : List A.R = cons A.z (cons A.o nil) ;
 first : R.First cs = inr (refl A.z,inl (A.o,A.mulO A.o)) ;
 root : I (R.Hs.horner cs) = trans (ap (A.add A.z) (RL[A].zero-mul (R.Hs.horner (cons A.o nil)))) (A.addZ A.z) ;
 module L = R.Lemma[cs,first,root] ;
 skipped : Id Nat L.k (suc zero) = refl (suc zero) ;
 idempotent : I (A.add (A.mul L.Ide.e L.Ide.e) (A.neg L.Ide.e)) = L.Ide.idempotent ;
 multiple : Id A.R L.Ide.e (A.mul A.z L.Ide.cofactor) = L.Ide.e-multiple ;
 annihilates (n : Nat) (w : A.R) (h : I (A.mul (R.AP.power A.z n) w)) : I (A.mul L.Ide.e w) = L.Ide.kill n w h ;
 module Constant (one-zero : I A.o) {
  terms : List A.R = cons A.o nil ;
  root0 : I (R.Hs.horner terms) =
   trans (trans (ap (A.add A.o) (RL[A].zero-mul A.z)) (A.addZ A.o)) one-zero ;
  module L0 = R.Lemma[terms,inl (A.o,A.mulO A.o),root0] ;
  skipped0 : Id Nat L0.k zero = refl zero ;
  idempotent0 : I (A.add (A.mul L0.Ide.e L0.Ide.e) (A.neg L0.Ide.e)) = L0.Ide.idempotent ;
 } ;
} ;
module ConstructedStandard (A : CRing) (setA : Pr.isSet A.R) (a : A.R) {
 module SE = StandardEtale[l].Over[A,setA] ; module RX = SE.RX ;
 lower : List A.R = cons A.z nil ;
 terms : List A.R = cons A.z (cons A.o nil) ;
 derivative-X : Id RX.Carrier (SE.deriv RX.variable) RX.ring.o =
  ap (\ p -> p.2) SE.At[RX.ring,RX.set,RX.inclusion,RX.variable].UPe.on-variable ;
 denominator-one : Id RX.Carrier SE.Points[RX.variable,RX.ring.o].g RX.ring.o =
  trans (ap (RX.ring.mul RX.ring.o) derivative-X) (RX.ring.mulO RX.ring.o) ;
 module S = StandardAlgebra[l].Over[A,setA].Build[RX.variable,RX.ring.o,terms,cons A.o nil,
  refl RX.variable,sym denominator-one] ;
 module Pair = DynamicalStandardCover[l].Over[A,setA,S.S,lower,RX.ring.o,S.standard,
  S.Loc.pres,S.Loc.K.presentation,RX.constant a] ;
 theorem : Big.Trunc[Pair.Charts.MonicGlobal.Cover].carrier = Pair.theorem ;
} ;
