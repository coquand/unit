-- Two actual monic standard charts of a presented standard algebra,
-- obtained by inverting F(x) and 1-F(x). Their finite cover is constructed
-- through a radical/unit tree; no local theorem or prime oracle is input.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Big = Truncation[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Algebras[l].Over[A,setA].Algebra)
 (lower : List A.R) (G : StandardEtale[l].Over[A,setA].RX.Carrier)
 (st : StandardEtale[l].Over[A,setA].Points[StandardEtale[l].Over[A,setA].RX.include
   (FirstUnitData[l].monic A lower),G].Standard E)
 (p : Presentations[l].Over[A,setA].Presentation) (pa : Presentations[l].Over[A,setA].Presents p E)
 (F0 : StandardEtale[l].Over[A,setA].RX.Carrier) {
 module Charts = DynamicalEtaleCover[l].Over[A,setA,E.ring,E.set,E.iota] ;
 module SE = Charts.SE ; module RX = SE.RX ;
 module Gen = Generated[l].Over[A,setA] ;
 Q : RX.Carrier = RX.include (FirstUnitData[l].monic A lower) ;
 module X = SE.At[E.ring,E.set,E.iota,st.1.1] ;
 module At (F1 : RX.Carrier) {
  module S = StandardChartLocalisation[l].Over[A,setA,E,Q,G,st,F1] ;
  f : E.ring.R = S.f ;
  make (r : Gen.Representation p E pa f) : Charts.MonicChart f =
   (lower,S.Presented[p,pa,r.1,r.2].Lc.algebra,S.Presented[p,pa,r.1,r.2].Lc.inclusion,
    S.Presented[p,pa,r.1,r.2].localisation,RX.ring.mul G F1,S.Presented[p,pa,r.1,r.2].standard) ;
  chart : Big.Trunc[Charts.MonicChart f].carrier =
   TruncationCombinators[l].rec (Gen.Representation p E pa f) @l+
    Big.Trunc[Charts.MonicChart f].carrier Big.Trunc[Charts.MonicChart f].proposition
    (\ r -> Big.Trunc[Charts.MonicChart f].inc (make r)) (Gen.Generated[p,E,pa].generated f) ;
 } ;
 complement : RX.Carrier = RX.ring.add RX.ring.o (RX.ring.neg F0) ;
 value-complement : Id E.ring.R (X.value complement) (E.ring.add E.ring.o (E.ring.neg (X.value F0))) =
  trans (X.ev.2.2.1 RX.ring.o (RX.ring.neg F0))
   (Presentations[l].cong2 E.ring.R E.ring.add _ _ _ _ X.ev.2.1
    (RingHom[l].negation RX.ring E.ring X.ev F0)) ;
 module Pair = DynamicalComplementaryCover[l].Over[E.ring,E.set,Charts.MonicChart,X.value F0] ;
 complement-chart : Big.Trunc[Charts.MonicChart Pair.b].carrier =
  idJ E.ring.R (X.value complement) (\ s eq -> Big.Trunc[Charts.MonicChart s].carrier)
   At[complement].chart Pair.b value-complement ;
 theorem : Big.Trunc[Charts.MonicGlobal.Cover].carrier = Pair.theorem complement-chart At[F0].chart ;
} ;
