-- GradedDependence.seg: a graded relation among the elements of a Rees
-- module generated in given degrees, from coded noetherianity
-- (finite-lifting.tex §2-§3; handoff §5).
--
-- A has a noetherian presentation PA onto which every element merely
-- lifts (k[a,b], k a discrete field: Field, Generated, Transfer), I = (a,b),
-- R = sum_n I^n T^n.  Let e_1, .., e_r be degrees and, for n >= 1, rho_n in
-- A^r with  rho_n,k in I^(n - e_k)  (and rho_n,k = 0 if n < e_k): the
-- coordinates of the n-th element of a sequence in the graded module
-- generated in degrees e_k.  Then there merely are N >= 1 and
-- r_i in I^(N-i) (1 <= i < N) with
--     rho_N = sum_{i<N} r_i rho_i .                                    (rel)
-- Proof.  In S = A[T] (+) A[T]^r (SquareZero) take the codes of the
-- subring generated by the constants (PA), aT, bT and g_k = (0, T^e_k u_k)
-- (Generated): they are noetherian.  w_n = (0, rho_n T^n) merely has a code,
-- since rho_n,k T^(n-e_k) is a polynomial in aT, bT with coefficients in A.
-- Walking the bar tree along these codes (no choice: the walk is in the
-- truncation) gives an initial segment w_m, .., w_1 that is good: some
-- w_N = sum_{i<N} phi(c_i) w_i.  The T-part of every code value has j-th
-- coefficient in I^j (inv-code: constants are in degree 0, aT and bT raise
-- the degree, g_k has no T-part), and the coefficient of T^N in the k-th
-- component gives (rel) with r_i = coef_(N-i) of the T-part of phi(c_i).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module H = RingHom[l] ; module IP = IdealPowers[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R)
  (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
  (onto : (c : A.R) -> Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier)
  (a b : A.R) {
  module LA = RL[A] ;
  module PW = IP.Over[A,IP.regular A,a,b] ;
  module CP = CharPoly[l].Over[A,setA] ;
  module B = CP.B ;
  Bg : CRing = B.ring ;
  module LB = RL[Bg] ;
  module GB = ExteriorAlgebra[l].AG[Bg.R,Bg.z,Bg.add,Bg.neg,Bg.addA,Bg.addC,Bg.addZ,Bg.addN] ;

  ------------------------------------------------------------------------
  -- A[T]: powers of T and their coefficients

  tpow : Nat -> Bg.R = split { zero -> Bg.o ; suc n | rr -> Bg.mul B.variable rr } ;
  const (c : A.R) : Bg.R = B.constant c ;

  -- coef (T^i f) (i + j) = coef f j
  coef-tpow : (i j : Nat) (f : Bg.R) -> Id A.R (CP.coef (Bg.mul (tpow i) f) (plus i j)) (CP.coef f j) = split {
    zero -> \ j f -> ap (\ g -> CP.coef g j) (LB.one-left f) ;
    suc i | ih -> \ j f ->
      trans (ap (\ g -> CP.coef g (suc (plus i j))) (sym (Bg.mulA B.variable (tpow i) f)))
        (trans (CP.coef-variable (Bg.mul (tpow i) f) (suc (plus i j))) (ih j f)) } ;

  -- f (c T^i) = c (T^i f)
  mono-swap (f : Bg.R) (c : A.R) (i : Nat) :
    Id Bg.R (Bg.mul f (Bg.mul (const c) (tpow i))) (Bg.mul (const c) (Bg.mul (tpow i) f)) =
    trans (LB.mul-swap f (const c) (tpow i)) (ap (Bg.mul (const c)) (Bg.mulC f (tpow i))) ;
  -- the coefficient of T^(i+j) in f (c T^i) is c coef_j(f)
  coef-mono (f : Bg.R) (c : A.R) (i j : Nat) :
    Id A.R (CP.coef (Bg.mul f (Bg.mul (const c) (tpow i))) (plus i j)) (A.mul c (CP.coef f j)) =
    trans (ap (\ g -> CP.coef g (plus i j)) (mono-swap f c i))
      (trans (CP.coef-scale c (Bg.mul (tpow i) f) (plus i j)) (ap (A.mul c) (coef-tpow i j f))) ;
  -- the coefficient of T^i in c T^i is c
  coef-top (c : A.R) (i : Nat) : Id A.R (CP.coef (Bg.mul (const c) (tpow i)) (plus i zero)) c =
    trans (ap (\ g -> CP.coef g (plus i zero)) (sym (LB.one-left (Bg.mul (const c) (tpow i)))))
      (trans (coef-mono Bg.o c i zero) (trans (ap (A.mul c) (CP.coef-const0 A.o)) (A.mulO c))) ;

  tpow-add : (i j : Nat) -> Id Bg.R (tpow (plus i j)) (Bg.mul (tpow i) (tpow j)) = split {
    zero -> \ j -> sym (LB.one-left (tpow j)) ;
    suc i | ih -> \ j -> trans (ap (Bg.mul B.variable) (ih j)) (Bg.mulA B.variable (tpow i) (tpow j)) } ;

  ------------------------------------------------------------------------
  -- the invariant: coef_j in I^j

  InvB (f : Bg.R) : U l = (j : Nat) -> PW.Pow j (CP.coef f j) ;

  inv-tr (f g : Bg.R) (e : Id Bg.R f g) (h : InvB f) : InvB g = subst InvB e h ;
  inv-zero : InvB Bg.z = \ j -> PW.pow-tr j A.z (CP.coef Bg.z j) (sym (CP.coef-zero j)) (PW.pow-zero j) ;
  inv-add (f g : Bg.R) (hf : InvB f) (hg : InvB g) : InvB (Bg.add f g) =
    \ j -> PW.pow-tr j (A.add (CP.coef f j) (CP.coef g j)) (CP.coef (Bg.add f g) j) (sym (CP.coef-add f g j))
             (PW.pow-add j (CP.coef f j) (CP.coef g j) (hf j) (hg j)) ;
  inv-const (c : A.R) : InvB (const c) = split {
    zero -> tt ;
    suc j -> PW.pow-tr (suc j) A.z (CP.coef (const c) (suc j)) (sym (CP.coef-constS c j)) (PW.pow-zero (suc j)) } ;
  -- a coef_j(f) is in I^(j+1); b coef_j(f) as well
  times-a (j : Nat) (u : A.R) (h : PW.Pow j u) : PW.Pow (suc j) (A.mul a u) =
    (u, (A.z, (h, (PW.pow-zero j, sym (trans (ap (A.add (A.mul a u)) (LA.mul-zero b)) (A.addZ (A.mul a u))))))) ;
  times-b (j : Nat) (u : A.R) (h : PW.Pow j u) : PW.Pow (suc j) (A.mul b u) =
    (A.z, (u, (PW.pow-zero j, (h, sym (trans (ap (\ t -> A.add t (A.mul b u)) (LA.mul-zero a)) (LA.zl (A.mul b u))))))) ;
  -- coef_j ((c T) f) = c coef_(j-1) f
  coef-cT (c : A.R) (f : Bg.R) : (j : Nat) ->
    Id A.R (CP.coef (Bg.mul (Bg.mul (const c) B.variable) f) j) (A.mul c (CP.shifted f j)) = \ j ->
    trans (ap (\ g -> CP.coef g j) (sym (Bg.mulA (const c) B.variable f)))
      (trans (CP.coef-scale c (Bg.mul B.variable f) j) (ap (A.mul c) (CP.coef-variable f j))) ;
  inv-aT (f : Bg.R) (hf : InvB f) : InvB (Bg.mul (Bg.mul (const a) B.variable) f) = split {
    zero -> tt ;
    suc j -> PW.pow-tr (suc j) (A.mul a (CP.coef f j)) _ (sym (coef-cT a f (suc j))) (times-a j (CP.coef f j) (hf j)) } ;
  inv-bT (f : Bg.R) (hf : InvB f) : InvB (Bg.mul (Bg.mul (const b) B.variable) f) = split {
    zero -> tt ;
    suc j -> PW.pow-tr (suc j) (A.mul b (CP.coef f j)) _ (sym (coef-cT b f (suc j))) (times-b j (CP.coef f j) (hf j)) } ;

  ------------------------------------------------------------------------
  -- the ring S = A[T] (+) A[T]^r and its generators

  module Rees (r : Nat) (e : Ps.Fin r -> Nat) {
    module SZ = SquareZero[l].Over[Bg,r] ;
    S : CRing = SZ.ring ;
    module LS = RL[S] ;
    module MB = MnSums[l].Over[Bg] ;
    cst : H.Hom A S = H.compose A Bg S SZ.incl-hom B.inclusion ;
    module TA = Transfer[l].Over[A,S,cst.1,cst.2.1,cst.2.2.1,cst.2.2.2,PA] ;
    module Gn = Generated[l].Over[S,TA.image,TA.noeth nA] ;

    aT : S.R = SZ.incl (Bg.mul (const a) B.variable) ;
    bT : S.R = SZ.incl (Bg.mul (const b) B.variable) ;
    -- g_k = (0, T^e_k u_k)
    gk (k : Ps.Fin r) : S.R = SZ.mod (\ k' -> Bg.mul (MB.delta r k' k) (tpow (e k))) ;

    -- the list f(last), .., f(first) of a family on Fin n
    listF : (n : Nat) -> (Ps.Fin n -> S.R) -> List S.R = split {
      zero -> \ f -> nil ;
      suc n | rr -> \ f -> cons (f (inr tt)) (rr (\ i -> f (inl i))) } ;
    xs : List S.R = Bar[l].app (listF r gk) (cons bT (cons aT nil)) ;
    Q : Span[l].Pres[S] = Gn.gen xs ;

    -- the invariant on S: on the T-part
    InvS (s : S.R) : U l = InvB s.1 ;
    Keeps (x : S.R) : U l = (s : S.R) -> InvS s -> InvS (S.mul x s) ;
    keeps-aT : Keeps aT = \ s h -> inv-aT s.1 h ;
    keeps-bT : Keeps bT = \ s h -> inv-bT s.1 h ;
    keeps-gk (k : Ps.Fin r) : Keeps (gk k) = \ s h -> inv-tr Bg.z (Bg.mul Bg.z s.1) (sym (LB.zero-mul s.1)) inv-zero ;

    AllKeep : List S.R -> U l = split { nil -> Top ; cons x ys | rr -> Keeps x * rr } ;
    allkeep-app : (ys zs : List S.R) -> AllKeep ys -> AllKeep zs -> AllKeep (Bar[l].app ys zs) = split {
      nil -> \ zs h h' -> h' ;
      cons y ys | rr -> \ zs h h' -> (h.1, rr zs h.2 h') } ;
    allkeep-g : (n : Nat) (f : Ps.Fin n -> S.R) -> ((k : Ps.Fin n) -> Keeps (f k)) -> AllKeep (listF n f) = split {
      zero -> \ f h -> tt ;
      suc n | rr -> \ f h -> (h (inr tt), rr (\ i -> f (inl i)) (\ i -> h (inl i))) } ;
    allkeep-xs : AllKeep xs =
      allkeep-app (listF r gk) (cons bT (cons aT nil)) (allkeep-g r gk keeps-gk) (keeps-bT, (keeps-aT, tt)) ;

    inv-S-tr (s s' : S.R) (h : Id S.R s s') (i : InvS s) : InvS s' = subst InvS h i ;

    -- every code value satisfies the invariant
    module Level (ys : List S.R) (x : S.R) (kx : Keeps x)
      (ih : (c : (Gn.gen ys).K) -> InvS ((Gn.gen ys).phi c)) {
      module PP = PolyPres[l].Over[S,Gn.gen ys,x] ;
      inv-pow (y : S.R) (hy : InvS y) : (n : Nat) -> InvS (S.mul y (PP.pow n)) = split {
        zero -> inv-S-tr y (S.mul y S.o) (sym (S.mulO y)) hy ;
        suc n | rr -> inv-S-tr (S.mul x (S.mul y (PP.pow n))) (S.mul y (S.mul x (PP.pow n)))
                        (LS.mul-swap x y (PP.pow n)) (kx (S.mul y (PP.pow n)) rr) } ;
      inv-ev : (cs : List (Gn.gen ys).K) -> InvS (PP.ev cs) = split {
        nil -> inv-zero ;
        cons c cs | rr -> inv-add (S.mul ((Gn.gen ys).phi c) (PP.pow (len cs))).1 (PP.ev cs).1
                            (inv-pow ((Gn.gen ys).phi c) (ih c) (len cs)) rr } ;
    } ;
    inv-code : (ys : List S.R) -> AllKeep ys -> (c : (Gn.gen ys).K) -> InvS ((Gn.gen ys).phi c) = split {
      nil -> \ h c -> inv-const (PA.phi c) ;
      cons x ys | rr -> \ h -> Level[ys,x,h.1,rr h.2].inv-ev } ;

    ------------------------------------------------------------------------
    -- codes of the generators, of the c T^d, and of the elements w_n

    module CS = CodedSubring[l].Over[S,Q] ;
    module SQ = Span[l].Over[S,Q] ;

    Mem (x : S.R) : List S.R -> U l = split { nil -> Empty ; cons y ys | rr -> Plus (Id S.R y x) rr } ;
    lifts-cons (x y : S.R) (ys : List S.R) (ih : Mem x ys -> (c : (Gn.gen ys).K) * Id S.R ((Gn.gen ys).phi c) x) :
      Plus (Id S.R y x) (Mem x ys) -> (c : (Gn.gen (cons y ys)).K) * Id S.R ((Gn.gen (cons y ys)).phi c) x = split {
      inl e -> (Gn.var y ys, trans (Gn.var-phi y ys) e) ;
      inr h -> (Gn.up y ys (ih h).1, trans (Gn.up-phi y ys (ih h).1) (ih h).2) } ;
    lifts-mem (x : S.R) : (ys : List S.R) -> Mem x ys -> (c : (Gn.gen ys).K) * Id S.R ((Gn.gen ys).phi c) x = split {
      nil -> \ h -> efq h ;
      cons y ys | rr -> \ h -> lifts-cons x y ys rr h } ;
    mem-app-l (x : S.R) : (ys zs : List S.R) -> Mem x ys -> Mem x (Bar[l].app ys zs) = split {
      nil -> \ zs h -> efq h ;
      cons y ys | rr -> \ zs -> split { inl e -> inl e ; inr h -> inr (rr zs h) } } ;
    mem-app-r (x : S.R) : (ys zs : List S.R) -> Mem x zs -> Mem x (Bar[l].app ys zs) = split {
      nil -> \ zs h -> h ;
      cons y ys | rr -> \ zs h -> inr (rr zs h) } ;
    topElim (Qt : Top -> U l) (q : Qt tt) : (t : Top) -> Qt t = split { tt -> q } ;
    mem-listF : (n : Nat) (f : Ps.Fin n -> S.R) (k : Ps.Fin n) -> Mem (f k) (listF n f) = split {
      zero -> \ f k -> efq k ;
      suc n | rr -> \ f -> split {
        inl k -> inr (rr (\ i -> f (inl i)) k) ;
        inr t -> topElim (\ t' -> Mem (f (inr t')) (listF (suc n) f)) (inl (refl (f (inr tt)))) t } } ;
    coded-mem (x : S.R) (h : Mem x xs) : CS.Coded x = CS.known (lifts-mem x xs h).1 x (lifts-mem x xs h).2 ;
    coded-aT : CS.Coded aT = coded-mem aT (mem-app-r aT (listF r gk) (cons bT (cons aT nil)) (inr (inl (refl aT)))) ;
    coded-bT : CS.Coded bT = coded-mem bT (mem-app-r bT (listF r gk) (cons bT (cons aT nil)) (inl (refl bT))) ;
    coded-gk (k : Ps.Fin r) : CS.Coded (gk k) =
      coded-mem (gk k) (mem-app-l (gk k) (listF r gk) (cons bT (cons aT nil)) (mem-listF r gk k)) ;
    coded-const (c : A.R) : CS.Coded (cst.1 c) =
      Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].induction @l (\ t -> CS.Coded (cst.1 c)) (\ t -> CS.coded-prop (cst.1 c))
        (\ kc -> CS.known (Gn.base xs kc.1) (cst.1 c) (trans (Gn.base-phi xs kc.1) (ap cst.1 kc.2))) (onto c) ;
    coded-tr (u v : S.R) (e : Id S.R u v) (h : CS.Coded u) : CS.Coded v = subst CS.Coded e h ;

    -- (alpha g1 + beta g2) (T P) = (alpha T) (g1 P) + (beta T) (g2 P)
    split-step (al g1 be g2 P : Bg.R) :
      Id Bg.R (Bg.mul (Bg.add (Bg.mul al g1) (Bg.mul be g2)) (Bg.mul B.variable P))
              (Bg.add (Bg.mul (Bg.mul al B.variable) (Bg.mul g1 P)) (Bg.mul (Bg.mul be B.variable) (Bg.mul g2 P))) =
      trans (LB.dist-left (Bg.mul al g1) (Bg.mul be g2) (Bg.mul B.variable P))
            (GB.cong-add (LB.mul-four al g1 B.variable P) (LB.mul-four be g2 B.variable P)) ;
    incl-add (u v : Bg.R) : Id S.R (SZ.incl (Bg.add u v)) (S.add (SZ.incl u) (SZ.incl v)) = SZ.incl-hom.2.2.1 u v ;
    incl-mul (u v : Bg.R) : Id S.R (SZ.incl (Bg.mul u v)) (S.mul (SZ.incl u) (SZ.incl v)) = SZ.incl-hom.2.2.2 u v ;

    -- c in I^d gives c T^d coded
    coded-pow : (d : Nat) (c : A.R) -> PW.Pow d c -> CS.Coded (SZ.incl (Bg.mul (const c) (tpow d))) = split {
      zero -> \ c h -> coded-tr (cst.1 c) (SZ.incl (Bg.mul (const c) Bg.o)) (ap SZ.incl (sym (Bg.mulO (const c)))) (coded-const c) ;
      suc d | rr -> \ c h ->
        coded-tr (S.add (S.mul aT (SZ.incl (Bg.mul (const h.1) (tpow d)))) (S.mul bT (SZ.incl (Bg.mul (const h.2.1) (tpow d)))))
          (SZ.incl (Bg.mul (const c) (tpow (suc d))))
          (sym (calc S.R {
             SZ.incl (Bg.mul (const c) (tpow (suc d)))
               =< ap (\ u -> SZ.incl (Bg.mul (const u) (tpow (suc d)))) h.2.2.2.2
               > SZ.incl (Bg.mul (const (A.add (A.mul a h.1) (A.mul b h.2.1))) (tpow (suc d)))
               =< ap (\ u -> SZ.incl (Bg.mul u (tpow (suc d))))
                    (trans (B.constant-add (A.mul a h.1) (A.mul b h.2.1))
                           (GB.cong-add (B.constant-mul a h.1) (B.constant-mul b h.2.1)))
               > SZ.incl (Bg.mul (Bg.add (Bg.mul (const a) (const h.1)) (Bg.mul (const b) (const h.2.1))) (tpow (suc d)))
               =< ap SZ.incl (split-step (const a) (const h.1) (const b) (const h.2.1) (tpow d))
               > SZ.incl (Bg.add (Bg.mul (Bg.mul (const a) B.variable) (Bg.mul (const h.1) (tpow d)))
                                 (Bg.mul (Bg.mul (const b) B.variable) (Bg.mul (const h.2.1) (tpow d))))
               =< trans (incl-add (Bg.mul (Bg.mul (const a) B.variable) (Bg.mul (const h.1) (tpow d)))
                                  (Bg.mul (Bg.mul (const b) B.variable) (Bg.mul (const h.2.1) (tpow d))))
                        (Ps.cong2 S.R S.add _ _ _ _
                           (incl-mul (Bg.mul (const a) B.variable) (Bg.mul (const h.1) (tpow d)))
                           (incl-mul (Bg.mul (const b) B.variable) (Bg.mul (const h.2.1) (tpow d))))
               > S.add (S.mul aT (SZ.incl (Bg.mul (const h.1) (tpow d)))) (S.mul bT (SZ.incl (Bg.mul (const h.2.1) (tpow d)))) }))
          (CS.coded-add (S.mul aT (SZ.incl (Bg.mul (const h.1) (tpow d)))) (S.mul bT (SZ.incl (Bg.mul (const h.2.1) (tpow d))))
             (CS.coded-mul aT (SZ.incl (Bg.mul (const h.1) (tpow d))) coded-aT (rr h.1 h.2.2.1))
             (CS.coded-mul bT (SZ.incl (Bg.mul (const h.2.1) (tpow d))) coded-bT (rr h.2.1 h.2.2.2.1))) } ;

    ------------------------------------------------------------------------
    -- the sequence:  w_n = (0, rho_n T^n),  rho_n,k in I^(n - e_k)

    module Seq (rho : Nat -> Ps.Fin r -> A.R)
      (deg : (n : Nat) (k : Ps.Fin r) ->
         Plus ((d : Nat) * (Id Nat n (plus d (e k)) * PW.Pow d (rho n k))) (Id A.R (rho n k) A.z)) {
      module SS = FiniteIdeal[l].Sums[S] ; module SB = FiniteIdeal[l].Sums[Bg] ;

      X (n : Nat) (k : Ps.Fin r) : Bg.R = Bg.mul (const (rho n k)) (tpow n) ;
      w (n : Nat) : S.R = SZ.mod (X n) ;
      term (n : Nat) (k : Ps.Fin r) : S.R = SZ.mod (\ k' -> Bg.mul (MB.delta r k' k) (X n k)) ;

      -- (c P) (d Q) = d (c (P Q))
      re4 (c P dd Qq : Bg.R) : Id Bg.R (Bg.mul (Bg.mul c P) (Bg.mul dd Qq)) (Bg.mul dd (Bg.mul c (Bg.mul P Qq))) =
        trans (LB.mul-swap (Bg.mul c P) dd Qq) (ap (Bg.mul dd) (sym (Bg.mulA c P Qq))) ;
      term-deg (n : Nat) (k : Ps.Fin r) :
        Plus ((d : Nat) * (Id Nat n (plus d (e k)) * PW.Pow d (rho n k))) (Id A.R (rho n k) A.z) -> CS.Coded (term n k) = split {
        inl dh -> coded-tr (S.mul (SZ.incl (Bg.mul (const (rho n k)) (tpow dh.1))) (gk k)) (term n k)
                    (trans (SZ.times-mod (SZ.incl (Bg.mul (const (rho n k)) (tpow dh.1))) (\ k' -> Bg.mul (MB.delta r k' k) (tpow (e k))))
                       (SZ.eqE _ _ (refl Bg.z)
                          (\ k' -> trans (re4 (const (rho n k)) (tpow dh.1) (MB.delta r k' k) (tpow (e k)))
                                     (ap (\ u -> Bg.mul (MB.delta r k' k) (Bg.mul (const (rho n k)) u))
                                         (trans (sym (tpow-add dh.1 (e k))) (ap tpow (sym dh.2.1)))))))
                    (CS.coded-mul (SZ.incl (Bg.mul (const (rho n k)) (tpow dh.1))) (gk k) (coded-pow dh.1 (rho n k) dh.2.2) (coded-gk k)) ;
        inr z0 -> coded-tr S.z (term n k)
                    (SZ.eqE _ _ (refl Bg.z)
                       (\ k' -> sym (trans (ap (\ u -> Bg.mul (MB.delta r k' k) (Bg.mul (const u) (tpow n))) z0)
                                       (trans (ap (\ u -> Bg.mul (MB.delta r k' k) (Bg.mul u (tpow n))) (H.zero A Bg B.inclusion))
                                              (trans (ap (Bg.mul (MB.delta r k' k)) (LB.zero-mul (tpow n))) (LB.mul-zero (MB.delta r k' k)))))))
                    (CS.known Q.kz S.z Q.phi-z) } ;

      sum-mod : (m : Nat) (v : Ps.Fin m -> SZ.Vec) ->
        Id S.R (SS.sum m (\ k -> SZ.mod (v k))) (SZ.mod (\ k' -> SB.sum m (\ k -> v k k'))) = split {
        zero -> \ v -> refl S.z ;
        suc m | rr -> \ v -> trans (ap (S.add (SZ.mod (v (inr tt)))) (rr (\ i -> v (inl i))))
                                    (SZ.eqE _ _ (Bg.addZ Bg.z) (\ k' -> refl (Bg.add (v (inr tt) k') (SB.sum m (\ k -> v (inl k) k'))))) } ;
      coded-sum : (m : Nat) (f : Ps.Fin m -> S.R) -> ((k : Ps.Fin m) -> CS.Coded (f k)) -> CS.Coded (SS.sum m f) = split {
        zero -> \ f h -> CS.known Q.kz S.z Q.phi-z ;
        suc m | rr -> \ f h -> CS.coded-add (f (inr tt)) (SS.sum m (\ i -> f (inl i))) (h (inr tt)) (rr (\ i -> f (inl i)) (\ i -> h (inl i))) } ;
      w-sum (n : Nat) : Id S.R (SS.sum r (term n)) (w n) =
        trans (sum-mod r (\ k k' -> Bg.mul (MB.delta r k' k) (X n k)))
              (SZ.eqE _ _ (refl Bg.z) (\ k' -> MB.sum-delta r k' (\ k -> X n k))) ;
      coded-w (n : Nat) : CS.Coded (w n) =
        coded-tr (SS.sum r (term n)) (w n) (w-sum n) (coded-sum r (term n) (\ k -> term-deg n k (deg n k))) ;

      ------------------------------------------------------------------------
      -- the walk along the bar tree, in the truncation

      -- cs codes [w_m, .., w_1]
      CodedL : List Q.K -> Nat -> U l = split {
        nil -> split { zero -> Top ; suc m -> Empty } ;
        cons c cs | rr -> split { zero -> Empty ; suc m -> Id S.R (Q.phi c) (w (suc m)) * rr m } } ;
      Found : U l = (m : Nat) * ((cs : List Q.K) * (CodedL cs m * SQ.Good cs)) ;
      module TF = Tr.Trunc[Found] ;
      walk : (t : Bar[l].Tree Q.K) (m : Nat) (cs : List Q.K) -> CodedL cs m -> SQ.G.Valid t cs -> TF.carrier = split {
        leaf -> \ m cs cd g -> TF.inc (m, (cs, (cd, g))) ;
        node f | rr -> \ m cs cd v ->
          Tr.Trunc[CS.Lifts (w (suc m))].induction @l (\ u -> TF.carrier) (\ u -> TF.proposition)
            (\ ce -> rr ce.1 (suc m) (cons ce.1 cs) (ce.2, cd) (v ce.1)) (coded-w (suc m)) } ;
      found : TF.carrier = walk (Gn.noeth xs).1 zero nil tt (Gn.noeth xs).2 ;

      ------------------------------------------------------------------------
      -- the relation

      -- r_i in I^(N-i), head first
      Grades : List A.R -> Nat -> U l = split {
        nil -> \ j -> Top ;
        cons x xs' | rr -> \ j -> PW.Pow (suc j) x * rr (suc j) } ;
      -- sum_i r_i rho_i, the head with index len (tail) + 1
      sumRel (k : Ps.Fin r) : List A.R -> A.R = split {
        nil -> A.z ;
        cons x xs' | rr -> A.add (A.mul x (rho (suc (len xs')) k)) rr } ;

      Ext (m j N : Nat) (y : S.R) : U l =
        (rs : List A.R) * (Id Nat (len rs) m * (Grades rs j * ((k : Ps.Fin r) -> Id A.R (CP.coef (y.2 k) N) (sumRel k rs)))) ;

      -- (y - u) + u = y in S
      sub-add-S (y u : S.R) : Id S.R (S.add (S.add y (S.neg u)) u) y =
        trans (sym (S.addA y (S.neg u) u)) (trans (ap (S.add y) (LS.neg-cancel u)) (S.addZ y)) ;

      -- the k-th component of phi(c) w_i
      comp (f : S.R) (i : Nat) (k : Ps.Fin r) :
        Id Bg.R ((S.mul f (w i)).2 k) (Bg.mul f.1 (X i k)) =
        trans (ap (Bg.add (Bg.mul f.1 (X i k))) (LB.zero-mul (f.2 k))) (Bg.addZ (Bg.mul f.1 (X i k))) ;

      extract-cons (t : Q.K) (s' : List Q.K) (m' : Nat) (cd : CodedL (cons t s') (suc m'))
        (ih : (j N : Nat) -> Id Nat N (plus m' (suc j)) -> (y : S.R) -> SQ.In s' y -> Ext m' j N y)
        (j N : Nat) (hN : Id Nat N (plus (suc m') (suc j))) (y : S.R) (h : SQ.In (cons t s') y) : Ext (suc m') j N y =
        (cons r1 E.1, (ap (\ q -> suc q) E.2.1, ((inv-code xs allkeep-xs h.1 (suc j), E.2.2.1),
          \ k -> calc A.R {
            CP.coef (y.2 k) N
              =< ap (\ u -> CP.coef (u.2 k) N) (sym (sub-add-S y (S.mul (Q.phi h.1) (Q.phi t))))
              > CP.coef (Bg.add (y'.2 k) ((S.mul (Q.phi h.1) (Q.phi t)).2 k)) N
              =< CP.coef-add (y'.2 k) ((S.mul (Q.phi h.1) (Q.phi t)).2 k) N
              > A.add (CP.coef (y'.2 k) N) (CP.coef ((S.mul (Q.phi h.1) (Q.phi t)).2 k) N)
              =< ap (A.add (CP.coef (y'.2 k) N))
                   (trans (ap (\ u -> CP.coef ((S.mul (Q.phi h.1) u).2 k) N) cd.1)
                     (trans (ap (\ u -> CP.coef u N) (comp (Q.phi h.1) (suc m') k))
                       (trans (ap (CP.coef (Bg.mul (Q.phi h.1).1 (X (suc m') k))) hN)
                              (coef-mono (Q.phi h.1).1 (rho (suc m') k) (suc m') (suc j)))))
              > A.add (CP.coef (y'.2 k) N) (A.mul (rho (suc m') k) r1)
              =< Ps.cong2 A.R A.add _ _ _ _ (E.2.2.2 k)
                   (trans (A.mulC (rho (suc m') k) r1) (ap (\ q -> A.mul r1 (rho (suc q) k)) (sym E.2.1)))
              > A.add (sumRel k E.1) (A.mul r1 (rho (suc (len E.1)) k))
              =< A.addC (sumRel k E.1) (A.mul r1 (rho (suc (len E.1)) k))
              > sumRel k (cons r1 E.1) })))
        where {
          y' : S.R = S.add y (S.neg (S.mul (Q.phi h.1) (Q.phi t))) ;
          r1 : A.R = CP.coef (Q.phi h.1).1 (suc j) ;
          E : Ext m' (suc j) N y' = ih (suc j) N (trans hN (sym (plus-suc m' (suc j)))) y' h.2 } ;

      extract : (s : List Q.K) (m : Nat) -> CodedL s m -> (j N : Nat) -> Id Nat N (plus m (suc j)) ->
        (y : S.R) -> SQ.In s y -> Ext m j N y = split {
        nil -> split {
          zero -> \ cd j N hN y h -> (nil, (refl zero, (tt, \ k -> trans (ap (\ u -> CP.coef (u.2 k) N) h) (CP.coef-zero N)))) ;
          suc m -> \ cd -> efq cd } ;
        cons t s' | rr -> split {
          zero -> \ cd -> efq cd ;
          suc m' -> \ cd -> extract-cons t s' m' cd (rr m' cd.2) } } ;

      Result : U l = (rs : List A.R) * (Grades rs zero * ((k : Ps.Fin r) -> Id A.R (rho (suc (len rs)) k) (sumRel k rs))) ;

      top-index (m : Nat) : Id Nat (suc m) (plus m (suc zero)) = sym (trans (plus-suc m zero) (ap (\ q -> suc q) (plus-zero m))) ;
      from-good (c : Q.K) (s : List Q.K) (m : Nat) (cd : CodedL (cons c s) (suc m)) (h : SQ.In s (Q.phi c)) : Result =
        (E.1, (E.2.2.1, \ k -> trans (ap (\ q -> rho (suc q) k) E.2.1)
           (trans (sym (trans (ap (\ q -> CP.coef (X (suc m) k) q) (sym (plus-zero (suc m)))) (coef-top (rho (suc m) k) (suc m))))
             (trans (ap (\ u -> CP.coef (u.2 k) (suc m)) (sym cd.1)) (E.2.2.2 k)))))
        where { E : Ext m zero (suc m) (Q.phi c) = extract s m cd.2 zero (suc m) (top-index m) (Q.phi c) h } ;
      good-cons (c : Q.K) (s : List Q.K) (m : Nat) (cd : CodedL (cons c s) (suc m)) (ih : SQ.Good s -> Result) :
        Plus (SQ.In s (Q.phi c)) (SQ.Good s) -> Result = split {
        inl h -> from-good c s m cd h ;
        inr g -> ih g } ;
      good-split : (cs : List Q.K) (m : Nat) -> CodedL cs m -> SQ.Good cs -> Result = split {
        nil -> \ m cd g -> efq g ;
        cons c s | rr -> split {
          zero -> \ cd -> efq cd ;
          suc m -> \ cd -> good-cons c s m cd (rr m cd.2) } } ;

      -- the graded relation, merely
      module TR = Tr.Trunc[Result] ;
      dependence : TR.carrier =
        TF.induction @l (\ u -> TR.carrier) (\ u -> TR.proposition)
          (\ fd -> TR.inc (good-split fd.2.1 fd.1 fd.2.2.1 fd.2.2.2)) found ;
    } ;
  } ;
} ;
