-- CechZMT.seg: the cohomological construction, assembled
-- (acl-zmt-formalisation.tex, section Assemblage, with the two shortcuts).
--
-- For two equations given by their charts (FixedCochain):
--     P = muP + a FP + b GP  (chart XZ),   Q = muQ + a FQ + b GQ  (chart YZ),
-- the Cech model provides every parameter of ACLZMTCong:
--   * K0 = 0-cochains of degree -1, K1 = 1-cochains, N1 = P U + Q V
--     (CechModules, CechOps), z* = (0, 0, Z^-1);
--   * (F1): the generators m_t = sigma(g X^(expo t)), g = muQ P - muP Q, and
--     the classes beta_n (CechF1, no Groebner basis, no ring A[U,V]);
--   * C0 = sections of degree 0, N0, closed sections, 1 and the product
--     (CechSections), the multiplications by X, Y, Z;
--   * (F2): kappa and Phi from the syzygy datum (S1) (CechSections.F2);
--   * the restriction to the chart Z (CechRestriction), which kills N0
--     because res P = p(x,y) = 0 and res Q = q(x,y) = 0.
-- CONDITIONAL on: the coded noetherian presentation (PA, nA, onto) of A,
-- the datum (S1) for P, Q in the degrees below, and the integer identities
-- between the degrees (equalities of integers, refl for given degrees).
-- No other hypothesis.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module IP = IdealPowers[l] ; module RC = ReesLiftingCong[l] ;
module Tr = Truncation[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R)
  (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
  (onto : (c : A.R) -> Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier)
  (a b : A.R)
  -- the two charts
  (muP : E3) (FP GP : Laurent3[l].Over[A].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[A].NonNegY FP) (yG : Laurent3[l].Over[A].NonNegY GP)
  (dF : Laurent3[l].Over[A].HomPI (deg muP) FP) (dG : Laurent3[l].Over[A].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[A].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[A].NonNegX FQ) (xG : Laurent3[l].Over[A].NonNegX GQ)
  (dF' : Laurent3[l].Over[A].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[A].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[A,setA].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[A,setA].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[A,setA].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[A,setA].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[A,setA].IsPoly (deg muP) (Laurent3[l].Over[A].monoP muP))
  (pmuQ : CechModules[l].Over[A,setA].IsPoly (deg muQ) (Laurent3[l].Over[A].monoP muQ))
  (pP : CechModules[l].Over[A,setA].IsPoly (deg muP) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[A,setA].IsPoly (deg muQ) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- the degrees
  (dg : Nat) (hdg : Id Int (add (deg muP) (deg muQ)) (pos dg))
  (kW : Int) (dW : Nat)
  (hW1 : Id Int (add kW (deg muQ)) (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))))
  (hW2 : Id Int (add kW (deg muP)) (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))))
  (h01 : Id Int (add (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) (deg muP)) (pos zero))
  (h02 : Id Int (add (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) (deg muQ)) (pos zero))
  (hWn : Id Int kW (negsuc dW))
  -- the syzygy datum (S1)
  (s1 : (al be : Laurent3[l].Over[A].Lau) ->
        CechModules[l].Over[A,setA].SL (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) al ->
        CechModules[l].Over[A,setA].SL (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) be ->
        Laurent3[l].Over[A].EqL (Laurent3[l].Over[A].addL (Laurent3[l].Over[A].mulP (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) al)
                                                        (Laurent3[l].Over[A].mulP (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) be))
                                 Laurent3[l].Over[A].zeroL ->
        (w : Laurent3[l].Over[A].Lau) * (CechModules[l].Over[A,setA].SL kW w *
          (Laurent3[l].Over[A].EqL al (Laurent3[l].Over[A].negL (Laurent3[l].Over[A].mulP (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) w))
           * Laurent3[l].Over[A].EqL be (Laurent3[l].Over[A].mulP (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) w))))
  -- the target: x, y in L with p(x,y) = q(x,y) = 0, i.e. res P = res Q = 0
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (CechRestriction[l].Over[A,setA,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) Lg.z)
  (hq : Id Lg.R (CechRestriction[l].Over[A,setA,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) Lg.z) {
  module LO = Laurent3[l].Over[A] ; open LO ;
  module CO = Cech3[l].Over[A] ;
  module LL = LaurentList[l].Over[A] ;
  module CMd = CechModules[l].Over[A,setA] ;
  module COp = CechOps[l].Over[A,setA] ;
  module CS = CechSections[l].Over[A,setA] ;
  module F1 = CechF1[l].Over[A,setA,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',pFP,pGP,pFQ,pGQ,pmuP,pmuQ,dg,hdg] ;
  PlP : LPoly = F1.PlP ;
  PlQ : LPoly = F1.PlQ ;
  one : Int = pos (suc zero) ;
  kP1 : Int = add F1.kP one ;
  kQ1 : Int = add F1.kQ one ;
  module Sc = CS.Sec[PlP,PlQ,deg muP,deg muQ,pP,pQ,kP1,kQ1] ;
  module F2 = Sc.F2[kW,hW1,hW2,h01,h02,dW,hWn,s1] ;
  module R = CechRestriction[l].Over[A,setA,Lg,setL,iota,x,y] ;
  module LT = ACLZMT[l].LinearTarget[A,Lg,iota] ;
  module LLg = RL[Lg] ;

  ------------------------------------------------------------------------
  -- the multiplications by X, Y, Z, from degree -1 to degree 0

  e3 (i j k : Int) : E3 = (i, (j, k)) ;
  monoX : LPoly = monoP (e3 one zeroZ zeroZ) ;
  monoY : LPoly = monoP (e3 zeroZ one zeroZ) ;
  monoZ : LPoly = monoP (e3 zeroZ zeroZ one) ;
  pX : CMd.IsPoly one monoX = ((refl false, tt), ((refl false, tt), ((refl false, tt), (refl one, tt)))) ;
  pY : CMd.IsPoly one monoY = ((refl false, tt), ((refl false, tt), ((refl false, tt), (refl one, tt)))) ;
  pZ : CMd.IsPoly one monoZ = ((refl false, tt), ((refl false, tt), ((refl false, tt), (refl one, tt)))) ;
  mulM (g : LPoly) (pg : CMd.IsPoly one g) : IP.Lin[A,F1.M0m.S.mod,Sc.C0.mod] =
    Sc.C0.into F1.M0m.S.mod (CechModules[l].comp A F1.M0m.S.mod CMd.tmod CMd.tmod F1.M0m.S.incl (COp.mulTL g))
      (\ w -> CS.mulS0-pres F1.m1 one g pg w.1 w.2) ;
  mX : IP.Lin[A,F1.M0m.S.mod,Sc.C0.mod] = mulM monoX pX ;
  mY : IP.Lin[A,F1.M0m.S.mod,Sc.C0.mod] = mulM monoY pY ;
  mZ : IP.Lin[A,F1.M0m.S.mod,Sc.C0.mod] = mulM monoZ pZ ;

  -- closed cochains stay closed: delta0 (M w) = M (P U + Q V) = P (M U) + Q (M V)
  closedM (g : LPoly) (pg : CMd.IsPoly one g) (w : F1.M0m.S.E) (hw : F1.N1.N (F1.d0K.f w)) : Sc.Closed ((mulM g pg).f w) =
    (CO.mulT g hw.1, (CO.mulT g hw.2.1,
      (CS.mulS1-pres F1.kP one g pg hw.1 hw.2.2.1, (CS.mulS1-pres F1.kQ one g pg hw.2.1 hw.2.2.2.1,
       (pt (CO.t2 w.1) (CO.t1 w.1) (CO.t1 hw.1) (CO.t1 hw.2.1) hw.2.2.2.2.1,
        (pt (CO.t3 w.1) (CO.t1 w.1) (CO.t2 hw.1) (CO.t2 hw.2.1) hw.2.2.2.2.2.1,
         pt (CO.t3 w.1) (CO.t2 w.1) (CO.t3 hw.1) (CO.t3 hw.2.1) hw.2.2.2.2.2.2))))))
    where {
      pt (f1 f0 U1 V1 : Lau) (e : EqL (subL f1 f0) (addL (mulP PlP U1) (mulP PlQ V1))) :
        EqL (subL (mulP g f1) (mulP g f0)) (addL (mulP PlP (mulP g U1)) (mulP PlQ (mulP g V1))) =
        \ m -> trans (sym (mulP-sub g f1 f0 m))
                 (trans (mulP-cong g (subL f1 f0) (addL (mulP PlP U1) (mulP PlQ V1)) e m)
                   (trans (mulP-add g (mulP PlP U1) (mulP PlQ V1) m)
                          (DG.cong-add (mulP-comm g PlP U1 m) (mulP-comm g PlQ V1 m)))) } ;
  closedX (w : F1.M0m.S.E) (hw : F1.N1.N (F1.d0K.f w)) : Sc.Closed (mX.f w) = closedM monoX pX w hw ;
  closedY (w : F1.M0m.S.E) (hw : F1.N1.N (F1.d0K.f w)) : Sc.Closed (mY.f w) = closedM monoY pY w hw ;
  closedZ (w : F1.M0m.S.E) (hw : F1.N1.N (F1.d0K.f w)) : Sc.Closed (mZ.f w) = closedM monoZ pZ w hw ;

  ------------------------------------------------------------------------
  -- the restriction to the chart Z

  resC (c : Sc.C0.E) : Lg.R = R.resF (CO.t3 c.1) c.2.2.2.2.2 ;
  res : IP.Lin[A,Sc.C0.mod,LT.mod] =
    IP.mkLin A Sc.C0.mod LT.mod resC
      (\ c c' -> R.resF-add (CO.t3 c.1) (CO.t3 c'.1) c.2.2.2.2.2 c'.2.2.2.2.2 (Sc.C0.mod.madd c c').2.2.2.2.2)
      (\ k c -> R.resF-sm k (CO.t3 c.1) c.2.2.2.2.2 (Sc.C0.mod.sm k c).2.2.2.2.2) ;
  -- lists with exponents of X and Y >= 0
  nnP (k : Int) (g : LPoly) (pg : CMd.IsPoly k g) : R.NN g = nn g pg.1 pg.2.1
    where { nn : (g : LPoly) -> NonNegX g -> NonNegY g -> R.NN g = split {
              nil -> \ hx hy -> tt ;
              cons t g | r -> \ hx hy -> ((hx.1, hy.1), r hx.2 hy.2) } } ;
  nn-of (g : LPoly) (pg : CMd.IsPoly (deg muP) g) : R.NN g = nn g pg.1 pg.2.1
    where { nn : (g : LPoly) -> NonNegX g -> NonNegY g -> R.NN g = split {
              nil -> \ hx hy -> tt ;
              cons t g | r -> \ hx hy -> ((hx.1, hy.1), r hx.2 hy.2) } } ;
  nn-ofQ (g : LPoly) (pg : CMd.IsPoly (deg muQ) g) : R.NN g = nn g pg.1 pg.2.1
    where { nn : (g : LPoly) -> NonNegX g -> NonNegY g -> R.NN g = split {
              nil -> \ hx hy -> tt ;
              cons t g | r -> \ hx hy -> ((hx.1, hy.1), r hx.2 hy.2) } } ;
  res-N0 (c : Sc.C0.E) (hN : Sc.N0.N c) : Id Lg.R (resC c) Lg.z =
    R.ElimL[CO.t3 hN.1,hN.2.2.1.2.2.2.2,resC c,Lg.z,\ w ->
      R.ElimL[CO.t3 hN.2.1,hN.2.2.2.1.2.2.2.2,resC c,Lg.z,\ w' ->
        trans (R.DR.beta (CO.t3 c.1) c.2.2.2.2.2
                 (Bar[l].app (LL.mulL PlP R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g)
                             (LL.mulL PlQ R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g))
                 (\ m -> trans (LL.coef-app (LL.mulL PlP R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g)
                                            (LL.mulL PlQ R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g) m)
                           (trans (DG.cong-add
                                    (trans (LL.coef-mulL PlP R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g m)
                                           (mulP-cong PlP (LL.coef R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g) (CO.t3 hN.1)
                                              R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].e m))
                                    (trans (LL.coef-mulL PlQ R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g m)
                                           (mulP-cong PlQ (LL.coef R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g) (CO.t3 hN.2.1)
                                              R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].e m)))
                                  (sym (hN.2.2.2.2.2.2 m)))))
          (trans (R.RS.sumPsi-app (LL.mulL PlP R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g)
                                  (LL.mulL PlQ R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g))
            (trans (Ps.cong2 Lg.R Lg.add _ _ _ _
                      (trans (R.resL-mulL PlP R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g (nn-of PlP pP)
                                R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].nn)
                             (trans (ap (\ s -> Lg.mul s (R.resL R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g)) hp)
                                    (trans (Lg.mulC Lg.z (R.resL R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g))
                                           (LLg.mul-zero (R.resL R.RepXY[CO.t3 hN.1,hN.2.2.1.1.2.2.1,hN.2.2.1.1.2.2.2,w].g)))))
                      (trans (R.resL-mulL PlQ R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g (nn-ofQ PlQ pQ)
                                R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].nn)
                             (trans (ap (\ s -> Lg.mul s (R.resL R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g)) hq)
                                    (trans (Lg.mulC Lg.z (R.resL R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g))
                                           (LLg.mul-zero (R.resL R.RepXY[CO.t3 hN.2.1,hN.2.2.2.1.1.2.2.1,hN.2.2.2.1.1.2.2.2,w'].g))))))
                   (Lg.addZ Lg.z)))].out].out ;

  -- res 1 = 1, res (c c') = res c res c'
  one-val : Id Lg.R (Lg.add (Lg.mul (iota.1 A.o) (Lg.mul Lg.o Lg.o)) Lg.z) Lg.o =
    trans (Lg.addZ (Lg.mul (iota.1 A.o) (Lg.mul Lg.o Lg.o)))
      (trans (ap (\ s -> Lg.mul s (Lg.mul Lg.o Lg.o)) iota.2.1) (trans (LLg.one-left (Lg.mul Lg.o Lg.o)) (Lg.mulO Lg.o))) ;
  res-one : Id Lg.R (resC Sc.oneS) Lg.o =
    trans (R.DR.beta CS.delta Sc.oneS.2.2.2.2.2 (cons (A.o, LaurentList[l].zero3) nil) (\ m -> refl (CS.delta m))) one-val ;
  res-mul (c c' : Sc.C0.E) : Id Lg.R (resC (Sc.mulC c c')) (Lg.mul (resC c) (resC c')) =
    R.resF-prod (CO.t3 c.1) (CO.t3 c'.1) c.2.2.2.2.2 c'.2.2.2.2.2 c.2.1.2.2.1 c.2.1.2.2.2 c'.2.1.2.2.1 c'.2.1.2.2.2
      (Sc.mulC c c').2.2.2.2.2 ;

  -- the charts: res (X w) = x res (Z w), res (Y w) = y res (Z w)
  resM (g : LPoly) (pg : CMd.IsPoly one g) (w : F1.M0m.S.E) :
    Id Lg.R (resC ((mulM g pg).f w)) (Lg.mul (R.resL g) (R.resF (CO.t3 w.1) w.2.2.2.2.2)) =
    R.resF-mulP g (nnP one g pg) (CO.t3 w.1) w.2.2.2.2.2 w.2.1.2.2.1 w.2.1.2.2.2 ((mulM g pg).f w).2.2.2.2.2 ;
  resLX : Id Lg.R (R.resL monoX) x =
    trans (Lg.addZ (Lg.mul (iota.1 A.o) (Lg.mul (Lg.mul x Lg.o) Lg.o)))
      (trans (ap (\ s -> Lg.mul s (Lg.mul (Lg.mul x Lg.o) Lg.o)) iota.2.1)
        (trans (LLg.one-left (Lg.mul (Lg.mul x Lg.o) Lg.o)) (trans (Lg.mulO (Lg.mul x Lg.o)) (Lg.mulO x)))) ;
  resLY : Id Lg.R (R.resL monoY) y =
    trans (Lg.addZ (Lg.mul (iota.1 A.o) (Lg.mul Lg.o (Lg.mul y Lg.o))))
      (trans (ap (\ s -> Lg.mul s (Lg.mul Lg.o (Lg.mul y Lg.o))) iota.2.1)
        (trans (LLg.one-left (Lg.mul Lg.o (Lg.mul y Lg.o))) (trans (LLg.one-left (Lg.mul y Lg.o)) (Lg.mulO y)))) ;
  resLZ : Id Lg.R (R.resL monoZ) Lg.o = one-val ;
  resZ (w : F1.M0m.S.E) : Id Lg.R (resC (mZ.f w)) (R.resF (CO.t3 w.1) w.2.2.2.2.2) =
    trans (resM monoZ pZ w) (trans (ap (\ s -> Lg.mul s (R.resF (CO.t3 w.1) w.2.2.2.2.2)) resLZ) (LLg.one-left (R.resF (CO.t3 w.1) w.2.2.2.2.2))) ;
  chartX (w : F1.M0m.S.E) : Id Lg.R (resC (mX.f w)) (Lg.mul x (resC (mZ.f w))) =
    trans (resM monoX pX w) (trans (ap (\ s -> Lg.mul s (R.resF (CO.t3 w.1) w.2.2.2.2.2)) resLX) (ap (Lg.mul x) (sym (resZ w)))) ;
  chartY (w : F1.M0m.S.E) : Id Lg.R (resC (mY.f w)) (Lg.mul y (resC (mZ.f w))) =
    trans (resM monoY pY w) (trans (ap (\ s -> Lg.mul s (R.resF (CO.t3 w.1) w.2.2.2.2.2)) resLY) (ap (Lg.mul y) (sym (resZ w)))) ;
  -- res (Z Z^-1) = 1
  zs-res : Id Lg.R (resC (mZ.f F1.zsS)) Lg.o =
    trans (resZ F1.zsS)
      (trans (R.DR.beta F1.FC.zinv F1.zinv-fin (cons (A.o, FixedCochain[l].zeta) nil)
                (\ m -> trans (A.addZ (LL.coefT (A.o, FixedCochain[l].zeta) m)) (F1.zinv-coef-pt m (LaurentList[l].dec3 FixedCochain[l].zeta m))))
             one-val) ;

  ------------------------------------------------------------------------
  -- the theorem

  module Z = ACLZMTCong[l].Over[A,setA,PA,nA,onto,a,b,Lg,setL,iota,x,y,
