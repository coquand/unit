-- ACLControl.seg: the control example of the handoff (§11),
--     p = x (1 + a x) ,   q = y (1 + a x) ,
-- where P, Q have the common factor Z + a X (no regularity of the pair).
-- For every ring map A -> L and x, y in L with p = q = 0,
--     s = 1 + a x   satisfies   s^2 = s ,  s x = 0 ,  s y = 0 ,
-- so s = 1 + a r + b t (r = x, t = 0) and s, s x, s y are roots of monic
-- polynomials of degree 2 over A (IntegralSections with m_0 = 1, m_1 = s).
-- Each identity is checked by the verified normaliser.
level l ; open Ring[l] ; open Base ; open PolyExpr[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ;
module RN0 = RingNormal[l] ; module EX = ACLExample[l] ;

two : Nat = suc (suc zero) ;
g0 : Ps.Fin two = inl (inr tt) ;
g1 : Ps.Fin two = inr tt ;
pick2 (X : U l) (v0 v1 : X) : Ps.Fin two -> X = EX.elim2 (\ i -> X) v0 v1 ;

pC : Ex = addE vx (mulE va (mulE vx vx)) ;
qC : Ex = addE vy (mulE va (mulE vx vy)) ;
sC : Ex = addE oneE (mulE va vx) ;

module Over (A : CRing) (setA : Pr.isSet A.R) (a b : A.R)
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (eval Lg (iota.1 a) (iota.1 b) x y pC) Lg.z)
  (hq : Id Lg.R (eval Lg (iota.1 a) (iota.1 b) x y qC) Lg.z) {
  al : Lg.R = iota.1 a ;
  be : Lg.R = iota.1 b ;
  val (e : Ex) : Lg.R = eval Lg al be x y e ;
  module RN = RingNormal[l].Over[Lg,al,be,x,y] ;
  module LL = RL[Lg] ;
  module SL = FiniteIdeal[l].Sums[Lg] ;

  -- an expression with the normal form of p U + q W vanishes
  modpq (e cu cv : Ex)
    (h : Id (List RN0.Term) (RN0.norm e) (RN0.norm (addE (mulE pC cu) (mulE qC cv)))) : Id Lg.R (val e) Lg.z =
    trans (RN.same-value e (addE (mulE pC cu) (mulE qC cv)) h)
      (trans (Ps.cong2 Lg.R Lg.add (Lg.mul (val pC) (val cu)) Lg.z (Lg.mul (val qC) (val cv)) Lg.z
                (trans (ap (\ t -> Lg.mul t (val cu)) hp) (LL.zero-mul (val cu)))
                (trans (ap (\ t -> Lg.mul t (val cv)) hq) (LL.zero-mul (val cv))))
             (Lg.addZ Lg.z)) ;
  sub-eq (d e : Lg.R) (h : Id Lg.R (Lg.add d (Lg.neg e)) Lg.z) : Id Lg.R d e =
    trans (sym (trans (sym (Lg.addA d (Lg.neg e) e)) (trans (ap (Lg.add d) (LL.neg-cancel e)) (Lg.addZ d))))
          (trans (ap (\ t -> Lg.add t e) h) (LL.zl e)) ;

  mE : Ps.Fin two -> Ex = pick2 Ex oneE sC ;
  m (i : Ps.Fin two) : Lg.R = val (mE i) ;
  -- m_i m_j = m_(i+j), with s^2 = s
  gam (i j k : Ps.Fin two) : A.R = pick2 (Ps.Fin two -> Ps.Fin two -> A.R)
    (pick2 (Ps.Fin two -> A.R) (pick2 A.R A.o A.z) (pick2 A.R A.z A.o))
    (pick2 (Ps.Fin two -> A.R) (pick2 A.R A.z A.o) (pick2 A.R A.z A.o)) i j k ;
  Cell (i j : Ps.Fin two) : U l = Id Lg.R (Lg.mul (m i) (m j)) (SL.sum two (\ k -> Lg.mul (m k) (iota.1 (gam i j k)))) ;
  -- the right-hand sides, with iota(0) = 0, iota(1) = 1
  rhs (u0 u1 : A.R) (e0 : Ex) (h0 : Id Lg.R (iota.1 u0) (val e0)) (e1 : Ex) (h1 : Id Lg.R (iota.1 u1) (val e1)) :
    Id Lg.R (SL.sum two (\ k -> Lg.mul (m k) (iota.1 (pick2 A.R u0 u1 k))))
            (val (addE (mulE sC e1) (addE (mulE oneE e0) zeroE))) =
    Ps.cong2 Lg.R Lg.add _ _ _ _ (ap (Lg.mul (m g1)) h1) (ap (\ t -> Lg.add (Lg.mul (m g0) t) Lg.z) h0) ;
  i0 : Id Lg.R (iota.1 A.z) (val zeroE) = H.zero A Lg iota ;
  i1 : Id Lg.R (iota.1 A.o) (val oneE) = iota.2.1 ;
  cell (i j : Ps.Fin two) (u0 u1 : A.R) (e0 e1 : Ex) (h0 : Id Lg.R (iota.1 u0) (val e0)) (h1 : Id Lg.R (iota.1 u1) (val e1))
    (hg : Id (Ps.Fin two -> A.R) (gam i j) (pick2 A.R u0 u1)) (cu cv : Ex)
    (h : Id (List RN0.Term) (RN0.norm (addE (mulE (mE i) (mE j)) (negE (addE (mulE sC e1) (addE (mulE oneE e0) zeroE)))))
                            (RN0.norm (addE (mulE pC cu) (mulE qC cv)))) : Cell i j =
    trans (sub-eq (Lg.mul (m i) (m j)) (val (addE (mulE sC e1) (addE (mulE oneE e0) zeroE)))
             (modpq (addE (mulE (mE i) (mE j)) (negE (addE (mulE sC e1) (addE (mulE oneE e0) zeroE)))) cu cv h))
          (sym (trans (ap (\ g -> SL.sum two (\ k -> Lg.mul (m k) (iota.1 (g k)))) hg) (rhs u0 u1 e0 h0 e1 h1))) ;
  table : (i j : Ps.Fin two) -> Cell i j =
    EX.elim2 (\ i -> (j : Ps.Fin two) -> Cell i j)
      (EX.elim2 (Cell g0)
         (cell g0 g0 A.o A.z oneE zeroE i1 i0 (refl (gam g0 g0)) zeroE zeroE (refl (RN0.norm (addE (mulE pC zeroE) (mulE qC zeroE)))))
         (cell g0 g1 A.z A.o zeroE oneE i0 i1 (refl (gam g0 g1)) zeroE zeroE (refl (RN0.norm (addE (mulE pC zeroE) (mulE qC zeroE))))))
      (EX.elim2 (Cell g1)
         (cell g1 g0 A.z A.o zeroE oneE i0 i1 (refl (gam g1 g0)) zeroE zeroE (refl (RN0.norm (addE (mulE pC zeroE) (mulE qC zeroE)))))
         (cell g1 g1 A.z A.o zeroE oneE i0 i1 (refl (gam g1 g1)) va zeroE (refl (RN0.norm (addE (mulE pC va) (mulE qC zeroE)))))) ;

  e : Ps.Fin two -> Lg.R = pick2 Lg.R Lg.o Lg.z ;
  one : Id Lg.R (SL.lin two e m) Lg.o =
    RN.same-value (addE (mulE zeroE sC) (addE (mulE oneE oneE) zeroE)) oneE (refl (RN0.norm oneE)) ;
  module IS = IntegralSections[l].Over[A,setA,Lg,setL,iota,two,m,e,one,gam,table] ;

  s : Lg.R = val sC ;
  -- s = 0 * 1 + 1 * s ,  s x = 0 ,  s y = 0 , modulo (p, q)
  coord (ee : Ex) (u0 u1 : A.R) (e0 e1 : Ex) (h0 : Id Lg.R (iota.1 u0) (val e0)) (h1 : Id Lg.R (iota.1 u1) (val e1)) (cu cv : Ex)
    (h : Id (List RN0.Term) (RN0.norm (addE ee (negE (addE (mulE sC e1) (addE (mulE oneE e0) zeroE)))))
                            (RN0.norm (addE (mulE pC cu) (mulE qC cv)))) :
    Id Lg.R (val ee) (IS.elt (pick2 A.R u0 u1)) =
    trans (sub-eq (val ee) (val (addE (mulE sC e1) (addE (mulE oneE e0) zeroE)))
             (modpq (addE ee (negE (addE (mulE sC e1) (addE (mulE oneE e0) zeroE)))) cu cv h))
          (sym (rhs u0 u1 e0 h0 e1 h1)) ;
  coord-s : Id Lg.R s (IS.elt (pick2 A.R A.z A.o)) =
    coord sC A.z A.o zeroE oneE i0 i1 zeroE zeroE (refl (RN0.norm (addE (mulE pC zeroE) (mulE qC zeroE)))) ;
  coord-sx : Id Lg.R (Lg.mul s x) (IS.elt (pick2 A.R A.z A.z)) =
    coord (mulE sC vx) A.z A.z zeroE zeroE i0 i0 oneE zeroE (refl (RN0.norm (addE (mulE pC oneE) (mulE qC zeroE)))) ;
  coord-sy : Id Lg.R (Lg.mul s y) (IS.elt (pick2 A.R A.z A.z)) =
    coord (mulE sC vy) A.z A.z zeroE zeroE i0 i0 zeroE oneE (refl (RN0.norm (addE (mulE pC zeroE) (mulE qC oneE)))) ;
  residual : Id Lg.R s (Lg.add Lg.o (Lg.add (Lg.mul al x) (Lg.mul be Lg.z))) =
    RN.same-value sC (addE oneE (addE (mulE va vx) (mulE vb zeroE))) (refl (RN0.norm (addE oneE (addE (mulE va vx) (mulE vb zeroE))))) ;

  module CP = CharPoly[l].Over[A,setA] ;
  MonicRoot (v : Lg.R) : U l =
    (f : CP.B.Carrier) * (CP.Bounded (suc two) f * (Id A.R (CP.coef f two) A.o
      * Id Lg.R ((Universal[l].Property[A,Lg,setA,setL].Given[iota,v].extend).1 f) Lg.z)) ;
  monic-root (c : Ps.Fin two -> A.R) (v : Lg.R) (h : Id Lg.R v (IS.elt c)) : MonicRoot v =
    subst MonicRoot (sym h) (IS.At[c].chi, IS.At[c].integral) ;
  certificate :
    ((r t : Lg.R) * Id Lg.R s (Lg.add Lg.o (Lg.add (Lg.mul al r) (Lg.mul be t))))
    * (MonicRoot s * (MonicRoot (Lg.mul s x) * MonicRoot (Lg.mul s y))) =
    ((x, (Lg.z, residual)),
     (monic-root (pick2 A.R A.z A.o) s coord-s,
      (monic-root (pick2 A.R A.z A.z) (Lg.mul s x) coord-sx,
       monic-root (pick2 A.R A.z A.z) (Lg.mul s y) coord-sy))) ;
} ;
