-- ACLS1.seg: the syzygy datum (S1) for the example of ACL §4.4, over
-- A = k[b][a], k any commutative ring (acl-zmt-formalisation.tex, Remarque
-- (S1) pour l'exemple d'ACL, in the form found before formalising: no
-- integrality is needed).
--
--     P = -Z^2 a + P0 ,  P0 = XZ + b (XY + 2 X^2) ,
--     Q =  U   a + Q0 ,  U = X^2 + XY ,  Q0 = YZ + b (Y^2 - Z^2) ,
--     R = Z^2 Q + U P = Z^2 Q0 + U P0   (no a).
-- For alpha, beta Laurent of degree -2, finitely supported, with
-- P alpha + Q beta = 0, there is a unique w of degree -4 with
-- alpha = -Q w and beta = P w.
-- Proof, on the coefficients of the powers of a (CharPoly.coef):
--  (C) If P f has no positive power of a, then f = 0: the coefficient of
--      a^(j+1) of P f is  -f_j(m - Z^2) + (terms of f_(j+1)) , so f vanishes
--      from the top degree down.
--  (D) For r without a, R r has no a either and its constant term is R0' r0;
--      on the coefficients of the powers of b, R0' r0 = 0 gives, from b^0
--      up, R00 r0_[i] = 0 with  R00 h (m) = h(m-(0,1,3)) + h(m-(3,0,1)) + h(m-(2,1,1)) ,
--      and R00 h = 0 forces h = 0 from the largest exponent of X down
--      (finite support).  So R r = 0 gives r = 0.
--  (Div) beta = P w0 + r with r without a: subtract P(c a^n) to kill the top
--      coefficient of beta (the coefficient of a in P is -Z^2, a unit).
--  Then  P (Z^2 (alpha + Q w0) - U r) + R r = Z^2 (P alpha + Q beta) = 0 , so by
--  (C) and (D) r = 0: beta = P w0.  The component w of degree -4 of w0
--  still has P w = beta, and P (alpha + Q w) = 0 gives alpha = -Q w by (C).
--  w is unique by (C), so it is obtained from the truncation.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ;
module Ps = Presentations[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;

-- finite support through an additive map between two rings
module CrossFin (D D' : CRing) (psi : D.R -> D'.R)
  (padd : (u v : D.R) -> Id D'.R (psi (D.add u v)) (D'.add (psi u) (psi v))) {
  module L1 = LaurentList[l].Over[D] ; module L2 = LaurentList[l].Over[D'] ;
  psi0 : Id D'.R (psi D.z) D'.z = RL[D'].add-cancel (psi D.z) (psi D.z) (sym (trans (ap psi (sym (D.addZ D.z))) (padd D.z D.z))) ;
  mapT (t : L1.Term) : L2.Term = (psi t.1, t.2) ;
  term (t : L1.Term) (m : E3) : (d : LG.Dec (Id E3 t.2 m)) -> Id D'.R (L2.ifD d (psi t.1)) (psi (L1.ifD d t.1)) = split {
    yes p -> refl (psi t.1) ;
    no n -> sym psi0 } ;
  coef-map (m : E3) : (g : L1.LO.LPoly) -> Id D'.R (L2.coef (CechMonomials[l].mapL L1.Term L2.Term mapT g) m) (psi (L1.coef g m)) = split {
    nil -> sym psi0 ;
    cons t g | r -> trans (Ps.cong2 D'.R D'.add _ _ _ _ (term t m (LaurentList[l].dec3 t.2 m)) r) (sym (padd (L1.coefT t m) (L1.coef g m))) } ;
  fin (f : E3 -> D.R) (h : L1.Fin f) : L2.Fin (\ m -> psi (f m)) =
    Tr.Trunc[L1.FinW f].induction @l (\ u -> L2.Fin (\ m -> psi (f m))) (\ u -> L2.fin-prop (\ m -> psi (f m)))
      (\ w -> Tr.Trunc[L2.FinW (\ m -> psi (f m))].inc (CechMonomials[l].mapL L1.Term L2.Term mapT w.1, \ m -> trans (coef-map m w.1) (ap psi (w.2 m)))) h ;
} ;

module Over (k : CRing) (setk : Pr.isSet k.R) {
  module E1 = PolynomialRing[l].Extension[k,setk] ;
  R1 : CRing = E1.ring ;
  module E2 = PolynomialRing[l].Extension[R1,E1.set] ;
  A : CRing = E2.ring ;
  setA : Pr.isSet A.R = E2.set ;
  bv : R1.R = E1.variable ;
  a : A.R = E2.variable ;
  b : A.R = E2.constant bv ;
  module CPa = CharPoly[l].Over[R1,E1.set] ;
  module CPb = CharPoly[l].Over[k,setk] ;
  module LA = Laurent3[l].Over[A] ;
  module LR = Laurent3[l].Over[R1] ;
  module Lk = Laurent3[l].Over[k] ;
  module RA = RL[A] ; module RR = RL[R1] ; module Rk = RL[k] ;
  module DA = ACLCech[l].Data[A,setA,a,b] ;
  PlP : LA.LPoly = DA.PlP ;
  PlQ : LA.LPoly = DA.PlQ ;

  e3 (i j l' : Int) : E3 = (i, (j, l')) ;
  p1 : Int = pos (suc zero) ;
  p2 : Int = pos (suc (suc zero)) ;
  eXZ : E3 = e3 p1 zeroZ p1 ;
  eYZ : E3 = e3 zeroZ p1 p1 ;
  eZ2 : E3 = e3 zeroZ zeroZ p2 ;
  eXY : E3 = e3 p1 p1 zeroZ ;
  eX2 : E3 = e3 p2 zeroZ zeroZ ;
  eY2 : E3 = e3 zeroZ p2 zeroZ ;

  ------------------------------------------------------------------------
  -- coefficients of the powers of a

  -- the coefficient of a^j of an element of A
  ca (u : A.R) (j : Ring[l].Nat) : R1.R = CPa.coef u j ;
  sh (u : A.R) (j : Ring[l].Nat) : R1.R = CPa.shifted u j ;
  two1 : R1.R = R1.add R1.o R1.o ;
  -- the six coefficients that occur in P and Q
  c-one (u : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.mul A.o u) j) (ca u j) =
    trans (CPa.coef-scale R1.o u j) (RR.one-left (ca u j)) ;
  c-mina (u : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.mul (A.mul a (A.neg A.o)) u) j) (R1.neg (sh u j)) =
    trans (ap (\ t -> ca t j) (trans (ap (\ t -> A.mul t u) (trans (RA.mul-neg a A.o) (ap A.neg (A.mulO a)))) (RA.neg-mul-left a u)))
      (trans (CPa.coef-neg (A.mul a u) j) (ap R1.neg (CPa.coef-variable u j))) ;
  c-a (u : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.mul (A.mul a A.o) u) j) (sh u j) =
    trans (ap (\ t -> ca (A.mul t u) j) (A.mulO a)) (CPa.coef-variable u j) ;
  c-b (u : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.mul (A.mul b A.o) u) j) (R1.mul bv (ca u j)) =
    trans (ap (\ t -> ca (A.mul t u) j) (A.mulO b)) (CPa.coef-scale bv u j) ;
  -- b (1 + 1) = constant (bv (1 + 1)) ,  b (-1) = constant (-bv)
  b2-const : Id A.R (A.mul b (A.add A.o A.o)) (E2.constant (R1.mul bv two1)) =
    trans (ap (A.mul b) (sym (E2.constant-add R1.o R1.o))) (sym (E2.constant-mul bv two1)) ;
  bn-const : Id A.R (A.mul b (A.neg A.o)) (E2.constant (R1.neg bv)) =
    trans (trans (RA.mul-neg b A.o) (ap A.neg (A.mulO b))) (sym (H.negation R1 A E2.inclusion bv)) ;
  c-2b (u : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.mul (A.mul b (A.add A.o A.o)) u) j) (R1.mul (R1.mul bv two1) (ca u j)) =
    trans (ap (\ t -> ca (A.mul t u) j) b2-const) (CPa.coef-scale (R1.mul bv two1) u j) ;
  c-mb (u : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.mul (A.mul b (A.neg A.o)) u) j) (R1.mul (R1.neg bv) (ca u j)) =
    trans (ap (\ t -> ca (A.mul t u) j) bn-const) (CPa.coef-scale (R1.neg bv) u j) ;
  c-add (u v : A.R) (j : Ring[l].Nat) : Id R1.R (ca (A.add u v) j) (R1.add (ca u j) (ca v j)) = CPa.coef-add u v j ;
  c-z (j : Ring[l].Nat) : Id R1.R (ca A.z j) R1.z = CPa.coef-zero j ;

  -- the coefficient of a^j of P f and Q f
  fP (f : LA.Lau) (m : E3) (j : Ring[l].Nat) : R1.R =
    R1.add (ca (f (sub3 m eXZ)) j)
      (R1.add (R1.neg (sh (f (sub3 m eZ2)) j))
        (R1.add (R1.mul bv (ca (f (sub3 m eXY)) j)) (R1.mul (R1.mul bv two1) (ca (f (sub3 m eX2)) j)))) ;
  fQ (f : LA.Lau) (m : E3) (j : Ring[l].Nat) : R1.R =
    R1.add (ca (f (sub3 m eYZ)) j)
      (R1.add (sh (f (sub3 m eX2)) j)
        (R1.add (sh (f (sub3 m eXY)) j)
          (R1.add (R1.mul bv (ca (f (sub3 m eY2)) j)) (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j))))) ;
  coefP (f : LA.Lau) (m : E3) (j : Ring[l].Nat) : Id R1.R (ca (LA.mulP PlP f m) j) (fP f m j) =
    (trans (c-add (A.mul A.o (f (sub3 m eXZ))) (A.add (A.mul (A.mul a (A.neg A.o)) (f (sub3 m eZ2))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z))) j) (Ps.cong2 R1.R R1.add (ca (A.mul A.o (f (sub3 m eXZ))) j) (ca (f (sub3 m eXZ)) j) (ca (A.add (A.mul (A.mul a (A.neg A.o)) (f (sub3 m eZ2))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z))) j) (R1.add (R1.neg (sh (f (sub3 m eZ2)) j)) (R1.add (R1.mul bv (ca (f (sub3 m eXY)) j)) (R1.mul (R1.mul bv two1) (ca (f (sub3 m eX2)) j)))) (c-one (f (sub3 m eXZ)) j) (trans (c-add (A.mul (A.mul a (A.neg A.o)) (f (sub3 m eZ2))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z)) j) (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul a (A.neg A.o)) (f (sub3 m eZ2))) j) (R1.neg (sh (f (sub3 m eZ2)) j)) (ca (A.add (A.mul (A.mul b A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z)) j) (R1.add (R1.mul bv (ca (f (sub3 m eXY)) j)) (R1.mul (R1.mul bv two1) (ca (f (sub3 m eX2)) j))) (c-mina (f (sub3 m eZ2)) j) (trans (c-add (A.mul (A.mul b A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z) j) (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul b A.o) (f (sub3 m eXY))) j) (R1.mul bv (ca (f (sub3 m eXY)) j)) (ca (A.add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z) j) (R1.mul (R1.mul bv two1) (ca (f (sub3 m eX2)) j)) (c-b (f (sub3 m eXY)) j) (trans (c-add (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) A.z j) (trans (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul b (A.add A.o A.o)) (f (sub3 m eX2))) j) (R1.mul (R1.mul bv two1) (ca (f (sub3 m eX2)) j)) (ca A.z j) R1.z (c-2b (f (sub3 m eX2)) j) (c-z j)) (R1.addZ (R1.mul (R1.mul bv two1) (ca (f (sub3 m eX2)) j))))))))))) ;
  coefQ (f : LA.Lau) (m : E3) (j : Ring[l].Nat) : Id R1.R (ca (LA.mulP PlQ f m) j) (fQ f m j) =
    (trans (c-add (A.mul A.o (f (sub3 m eYZ))) (A.add (A.mul (A.mul a A.o) (f (sub3 m eX2))) (A.add (A.mul (A.mul a A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z)))) j) (Ps.cong2 R1.R R1.add (ca (A.mul A.o (f (sub3 m eYZ))) j) (ca (f (sub3 m eYZ)) j) (ca (A.add (A.mul (A.mul a A.o) (f (sub3 m eX2))) (A.add (A.mul (A.mul a A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z)))) j) (R1.add (sh (f (sub3 m eX2)) j) (R1.add (sh (f (sub3 m eXY)) j) (R1.add (R1.mul bv (ca (f (sub3 m eY2)) j)) (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j))))) (c-one (f (sub3 m eYZ)) j) (trans (c-add (A.mul (A.mul a A.o) (f (sub3 m eX2))) (A.add (A.mul (A.mul a A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z))) j) (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul a A.o) (f (sub3 m eX2))) j) (sh (f (sub3 m eX2)) j) (ca (A.add (A.mul (A.mul a A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z))) j) (R1.add (sh (f (sub3 m eXY)) j) (R1.add (R1.mul bv (ca (f (sub3 m eY2)) j)) (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j)))) (c-a (f (sub3 m eX2)) j) (trans (c-add (A.mul (A.mul a A.o) (f (sub3 m eXY))) (A.add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z)) j) (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul a A.o) (f (sub3 m eXY))) j) (sh (f (sub3 m eXY)) j) (ca (A.add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z)) j) (R1.add (R1.mul bv (ca (f (sub3 m eY2)) j)) (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j))) (c-a (f (sub3 m eXY)) j) (trans (c-add (A.mul (A.mul b A.o) (f (sub3 m eY2))) (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z) j) (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul b A.o) (f (sub3 m eY2))) j) (R1.mul bv (ca (f (sub3 m eY2)) j)) (ca (A.add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z) j) (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j)) (c-b (f (sub3 m eY2)) j) (trans (c-add (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) A.z j) (trans (Ps.cong2 R1.R R1.add (ca (A.mul (A.mul b (A.neg A.o)) (f (sub3 m eZ2))) j) (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j)) (ca A.z j) R1.z (c-mb (f (sub3 m eZ2)) j) (c-z j)) (R1.addZ (R1.mul (R1.neg bv) (ca (f (sub3 m eZ2)) j))))))))))))) ;

  ------------------------------------------------------------------------
  -- (C) if P f has no positive power of a, then f = 0

  aBound (f : LA.Lau) (N : Ring[l].Nat) : U l = (m : E3) (i : Ring[l].Nat) -> Id R1.R (ca (f m) (plus N i)) R1.z ;
  aFree (g : LA.Lau) : U l = aBound g (suc zero) ;
  up (m e : E3) : E3 = sub3 m (neg3 e) ;
  -- x0 + (-y + (c1 x1 + c2 x2)) = 0 with x0 = x1 = x2 = 0 gives y = 0
  alg-y (x0 y x1 x2 c1 c2 : R1.R) (h0 : Id R1.R x0 R1.z) (h1 : Id R1.R x1 R1.z) (h2 : Id R1.R x2 R1.z)
    (h : Id R1.R (R1.add x0 (R1.add (R1.neg y) (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) R1.z) : Id R1.R y R1.z =
    trans (sym (RR.neg-neg y)) (trans (ap R1.neg (trans (sym simp) h)) RR.neg-zero)
    where {
      simp : Id R1.R (R1.add x0 (R1.add (R1.neg y) (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) (R1.neg y) =
        trans (ap (\ t -> R1.add t (R1.add (R1.neg y) (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) h0)
          (trans (RR.zl (R1.add (R1.neg y) (R1.add (R1.mul c1 x1) (R1.mul c2 x2))))
            (trans (ap (R1.add (R1.neg y))
                       (trans (Ps.cong2 R1.R R1.add _ _ _ _ (trans (ap (R1.mul c1) h1) (RR.mul-zero c1)) (trans (ap (R1.mul c2) h2) (RR.mul-zero c2)))
                              (R1.addZ R1.z)))
                   (R1.addZ (R1.neg y)))) } ;
  module Down (f : LA.Lau) (N : Ring[l].Nat) (hb : aBound f (suc N)) (hfree : aFree (LA.mulP PlP f)) {
    hbs (u : E3) : Id R1.R (ca (f u) (suc N)) R1.z = trans (ap (\ q -> ca (f u) (suc q)) (sym (plus-zero N))) (hb u zero) ;
    top (m : E3) : Id R1.R (ca (f m) N) R1.z =
      subst (\ q -> Id R1.R (ca (f q) N) R1.z) (sub3-cancel m eZ2)
        (alg-y (ca (f (sub3 (up m eZ2) eXZ)) (suc N)) (ca (f (sub3 (up m eZ2) eZ2)) N)
               (ca (f (sub3 (up m eZ2) eXY)) (suc N)) (ca (f (sub3 (up m eZ2) eX2)) (suc N)) bv (R1.mul bv two1)
               (hbs (sub3 (up m eZ2) eXZ)) (hbs (sub3 (up m eZ2) eXY)) (hbs (sub3 (up m eZ2) eX2))
               (trans (sym (coefP f (up m eZ2) (suc N))) (hfree (up m eZ2) N))) ;
    at : (m : E3) (i : Ring[l].Nat) -> Id R1.R (ca (f m) (plus N i)) R1.z = \ m -> at-i m
      where { at-i (m : E3) : (i : Ring[l].Nat) -> Id R1.R (ca (f m) (plus N i)) R1.z = split {
                zero -> trans (ap (ca (f m)) (plus-zero N)) (top m) ;
                suc i -> trans (ap (ca (f m)) (plus-suc N i)) (hb m i) } } ;
  } ;
  stepC (f : LA.Lau) : (N : Ring[l].Nat) -> aBound f N -> aFree (LA.mulP PlP f) -> (m : E3) (j : Ring[l].Nat) -> Id R1.R (ca (f m) j) R1.z = split {
    zero -> \ hb hf m j -> hb m j ;
    suc N | r -> \ hb hf -> r (Down[f,N,hb,hf].at) hf } ;
  f-zero (f : LA.Lau) (N : Ring[l].Nat) (hb : aBound f N) (hf : aFree (LA.mulP PlP f)) (m : E3) : Id A.R (f m) A.z =
    CPa.coef-ext (f m) A.z (\ j -> trans (stepC f N hb hf m j) (sym (c-z j))) ;

  ------------------------------------------------------------------------
  -- R = Z^2 Q + X^2 P + XY P keeps the functions without a

  mono-coef (e : E3) (h : LA.Lau) (m : E3) (j : Ring[l].Nat) : Id R1.R (ca (LA.mulP (LA.monoP e) h m) j) (ca (h (sub3 m e)) j) =
    trans (c-add (A.mul A.o (h (sub3 m e))) A.z j)
      (trans (Ps.cong2 R1.R R1.add _ _ _ _ (c-one (h (sub3 m e)) j) (c-z j)) (R1.addZ (ca (h (sub3 m e)) j))) ;
  Ropr (g : LA.Lau) : LA.Lau =
    LA.addL (LA.mulP (LA.monoP eZ2) (LA.mulP PlQ g)) (LA.addL (LA.mulP (LA.monoP eX2) (LA.mulP PlP g)) (LA.mulP (LA.monoP eXY) (LA.mulP PlP g))) ;
  coefR (g : LA.Lau) (m : E3) (j : Ring[l].Nat) :
    Id R1.R (ca (Ropr g m) j) (R1.add (fQ g (sub3 m eZ2) j) (R1.add (fP g (sub3 m eX2) j) (fP g (sub3 m eXY) j))) =
    trans (c-add (LA.mulP (LA.monoP eZ2) (LA.mulP PlQ g) m) (A.add (LA.mulP (LA.monoP eX2) (LA.mulP PlP g) m) (LA.mulP (LA.monoP eXY) (LA.mulP PlP g) m)) j)
      (Ps.cong2 R1.R R1.add _ _ _ _ (trans (mono-coef eZ2 (LA.mulP PlQ g) m j) (coefQ g (sub3 m eZ2) j))
        (trans (c-add (LA.mulP (LA.monoP eX2) (LA.mulP PlP g) m) (LA.mulP (LA.monoP eXY) (LA.mulP PlP g) m) j)
          (Ps.cong2 R1.R R1.add _ _ _ _ (trans (mono-coef eX2 (LA.mulP PlP g) m j) (coefP g (sub3 m eX2) j))
                                         (trans (mono-coef eXY (LA.mulP PlP g) m j) (coefP g (sub3 m eXY) j))))) ;
  -- for r without a:  the a^(j+1) coefficients of P r and Q r
  module Free (r : LA.Lau) (hr : aFree r) {
    z1 (u : E3) (j : Ring[l].Nat) : Id R1.R (ca (r u) (suc j)) R1.z = hr u j ;
    -- x0 + (y + (c1 x1 + c2 x2)) = y  when x0 = x1 = x2 = 0
    simp (x0 y x1 x2 c1 c2 : R1.R) (h0 : Id R1.R x0 R1.z) (h1 : Id R1.R x1 R1.z) (h2 : Id R1.R x2 R1.z) :
      Id R1.R (R1.add x0 (R1.add y (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) y =
      trans (ap (\ t -> R1.add t (R1.add y (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) h0)
        (trans (RR.zl (R1.add y (R1.add (R1.mul c1 x1) (R1.mul c2 x2))))
          (trans (ap (R1.add y) (trans (Ps.cong2 R1.R R1.add _ _ _ _ (trans (ap (R1.mul c1) h1) (RR.mul-zero c1)) (trans (ap (R1.mul c2) h2) (RR.mul-zero c2)))
                                       (R1.addZ R1.z)))
                 (R1.addZ y))) ;
    fP-suc (m : E3) (j : Ring[l].Nat) : Id R1.R (fP r m (suc j)) (R1.neg (ca (r (sub3 m eZ2)) j)) =
      simp (ca (r (sub3 m eXZ)) (suc j)) (R1.neg (ca (r (sub3 m eZ2)) j)) (ca (r (sub3 m eXY)) (suc j)) (ca (r (sub3 m eX2)) (suc j))
           bv (R1.mul bv two1) (z1 (sub3 m eXZ) j) (z1 (sub3 m eXY) j) (z1 (sub3 m eX2) j) ;
    fQ-suc (m : E3) (j : Ring[l].Nat) : Id R1.R (fQ r m (suc j)) (R1.add (ca (r (sub3 m eX2)) j) (ca (r (sub3 m eXY)) j)) =
      trans (ap (\ t -> R1.add t (R1.add (ca (r (sub3 m eX2)) j) (R1.add (ca (r (sub3 m eXY)) j)
                         (R1.add (R1.mul bv (ca (r (sub3 m eY2)) (suc j))) (R1.mul (R1.neg bv) (ca (r (sub3 m eZ2)) (suc j))))))) (z1 (sub3 m eYZ) j))
        (trans (RR.zl (R1.add (ca (r (sub3 m eX2)) j) (R1.add (ca (r (sub3 m eXY)) j)
                         (R1.add (R1.mul bv (ca (r (sub3 m eY2)) (suc j))) (R1.mul (R1.neg bv) (ca (r (sub3 m eZ2)) (suc j)))))))
          (ap (R1.add (ca (r (sub3 m eX2)) j))
            (trans (ap (R1.add (ca (r (sub3 m eXY)) j))
                       (trans (Ps.cong2 R1.R R1.add _ _ _ _ (trans (ap (R1.mul bv) (z1 (sub3 m eY2) j)) (RR.mul-zero bv))
                                                         (trans (ap (R1.mul (R1.neg bv)) (z1 (sub3 m eZ2) j)) (RR.mul-zero (R1.neg bv))))
                              (R1.addZ R1.z)))
                   (R1.addZ (ca (r (sub3 m eXY)) j))))) ;
    -- (p + q) + (-p' + -q') = 0  when p = p', q = q'
    cancel2 (p q p' q' : R1.R) (e : Id R1.R p p') (e' : Id R1.R q q') :
      Id R1.R (R1.add (R1.add p q) (R1.add (R1.neg p') (R1.neg q'))) R1.z =
      trans (ap (R1.add (R1.add p q)) (trans (sym (RR.neg-add p' q')) (ap R1.neg (sym (Ps.cong2 R1.R R1.add _ _ _ _ e e')))))
            (R1.addN (R1.add p q)) ;
    R-free : aFree (Ropr r) = \ m i ->
      trans (coefR r m (suc i))
        (trans (Ps.cong2 R1.R R1.add _ _ _ _ (fQ-suc (sub3 m eZ2) i) (Ps.cong2 R1.R R1.add _ _ _ _ (fP-suc (sub3 m eX2) i) (fP-suc (sub3 m eXY) i)))
          (cancel2 (ca (r (sub3 (sub3 m eZ2) eX2)) i) (ca (r (sub3 (sub3 m eZ2) eXY)) i)
                   (ca (r (sub3 (sub3 m eX2) eZ2)) i) (ca (r (sub3 (sub3 m eXY) eZ2)) i)
                   (ap (\ u -> ca (r u) i) (sub3-comm m eZ2 eX2)) (ap (\ u -> ca (r u) i) (sub3-comm m eZ2 eXY)))) ;
    -- r is its constant term
    r0 (u : E3) : R1.R = ca (r u) zero ;
    r-is (u : E3) (h0 : Id R1.R (r0 u) R1.z) : Id A.R (r u) A.z =
      CPa.coef-ext (r u) A.z (\ j -> trans (r-split u h0 j) (sym (c-z j)))
      where { r-split (u : E3) (h0 : Id R1.R (r0 u) R1.z) : (j : Ring[l].Nat) -> Id R1.R (ca (r u) j) R1.z = split {
                zero -> h0 ;
                suc j -> z1 u j } } ;
  } ;
  -- the constant term of R r, for r without a
  P0h (h : LR.Lau) (m : E3) : R1.R =
    R1.add (h (sub3 m eXZ)) (R1.add (R1.neg R1.z) (R1.add (R1.mul bv (h (sub3 m eXY))) (R1.mul (R1.mul bv two1) (h (sub3 m eX2))))) ;
  Q0h (h : LR.Lau) (m : E3) : R1.R =
    R1.add (h (sub3 m eYZ)) (R1.add R1.z (R1.add R1.z (R1.add (R1.mul bv (h (sub3 m eY2))) (R1.mul (R1.neg bv) (h (sub3 m eZ2)))))) ;
  R0h (h : LR.Lau) (m : E3) : R1.R = R1.add (Q0h h (sub3 m eZ2)) (R1.add (P0h h (sub3 m eX2)) (P0h h (sub3 m eXY))) ;
  coefR0 (r : LA.Lau) (m : E3) : Id R1.R (ca (Ropr r m) zero) (R0h (\ u -> ca (r u) zero) m) = coefR r m zero ;

  ------------------------------------------------------------------------
  -- coefficients of the powers of b

  cb (u : R1.R) (i : Ring[l].Nat) : k.R = CPb.coef u i ;
  shb (u : R1.R) (i : Ring[l].Nat) : k.R = CPb.shifted u i ;
  two-k : k.R = k.add k.o k.o ;
  two1-c : Id R1.R two1 (E1.constant two-k) = sym (E1.constant-add k.o k.o) ;
  cb-bv (y : R1.R) (i : Ring[l].Nat) : Id k.R (cb (R1.mul bv y) i) (shb y i) = CPb.coef-variable y i ;
  cb-2bv (y : R1.R) (i : Ring[l].Nat) : Id k.R (cb (R1.mul (R1.mul bv two1) y) i) (shb (R1.mul two1 y) i) =
    trans (ap (\ t -> cb t i) (sym (R1.mulA bv two1 y))) (cb-bv (R1.mul two1 y) i) ;
  cb-mbv (y : R1.R) (i : Ring[l].Nat) : Id k.R (cb (R1.mul (R1.neg bv) y) i) (k.neg (shb y i)) =
    trans (ap (\ t -> cb t i) (RR.neg-mul-left bv y)) (trans (CPb.coef-neg (R1.mul bv y) i) (ap k.neg (cb-bv y i))) ;
  cb-two (y : R1.R) (i : Ring[l].Nat) : Id k.R (cb (R1.mul two1 y) i) (k.mul two-k (cb y i)) =
    trans (ap (\ t -> cb (R1.mul t y) i) two1-c) (CPb.coef-scale two-k y i) ;
  cb-add (u v : R1.R) (i : Ring[l].Nat) : Id k.R (cb (R1.add u v) i) (k.add (cb u i) (cb v i)) = CPb.coef-add u v i ;
  cb-z (i : Ring[l].Nat) : Id k.R (cb R1.z i) k.z = CPb.coef-zero i ;
  cb-nz (i : Ring[l].Nat) : Id k.R (cb (R1.neg R1.z) i) k.z = trans (CPb.coef-neg R1.z i) (trans (ap k.neg (cb-z i)) Rk.neg-zero) ;

  -- the shifted coefficients vanish (all at b^0; at b^(i+1) when the b^i coefficients vanish)
  ShZ (h : LR.Lau) (i : Ring[l].Nat) : U l = (x : E3) -> Id k.R (shb (h x) i) k.z ;
  sh-two (h : LR.Lau) : (i : Ring[l].Nat) -> ShZ h i -> (x : E3) -> Id k.R (shb (R1.mul two1 (h x)) i) k.z = split {
    zero -> \ hz x -> refl k.z ;
    suc i -> \ hz x -> trans (cb-two (h x) i) (trans (ap (k.mul two-k) (hz x)) (Rk.mul-zero two-k)) } ;
  -- u + (v + (w + w')) = u  when v = w = w' = 0
  k3 (u v w w' : k.R) (hv : Id k.R v k.z) (hw : Id k.R w k.z) (hw' : Id k.R w' k.z) : Id k.R (k.add u (k.add v (k.add w w'))) u =
    trans (ap (k.add u) (trans (Ps.cong2 k.R k.add _ _ _ _ hv (trans (Ps.cong2 k.R k.add _ _ _ _ hw hw') (k.addZ k.z))) (k.addZ k.z))) (k.addZ u) ;
  cbP0 (h : LR.Lau) (m : E3) (i : Ring[l].Nat) (hz : ShZ h i) : Id k.R (cb (P0h h m) i) (cb (h (sub3 m eXZ)) i) =
    trans (cb-add (h (sub3 m eXZ)) (R1.add (R1.neg R1.z) (R1.add (R1.mul bv (h (sub3 m eXY))) (R1.mul (R1.mul bv two1) (h (sub3 m eX2))))) i)
     (trans (ap (k.add (cb (h (sub3 m eXZ)) i))
              (trans (cb-add (R1.neg R1.z) (R1.add (R1.mul bv (h (sub3 m eXY))) (R1.mul (R1.mul bv two1) (h (sub3 m eX2)))) i)
                (ap (k.add (cb (R1.neg R1.z) i))
                  (trans (cb-add (R1.mul bv (h (sub3 m eXY))) (R1.mul (R1.mul bv two1) (h (sub3 m eX2))) i)
                         (Ps.cong2 k.R k.add _ _ _ _ (cb-bv (h (sub3 m eXY)) i) (cb-2bv (h (sub3 m eX2)) i))))))
       (k3 (cb (h (sub3 m eXZ)) i) (cb (R1.neg R1.z) i) (shb (h (sub3 m eXY)) i) (shb (R1.mul two1 (h (sub3 m eX2))) i)
           (cb-nz i) (hz (sub3 m eXY)) (sh-two h i hz (sub3 m eX2)))) ;
  cbQ0 (h : LR.Lau) (m : E3) (i : Ring[l].Nat) (hz : ShZ h i) : Id k.R (cb (Q0h h m) i) (cb (h (sub3 m eYZ)) i) =
    trans (cb-add (h (sub3 m eYZ)) (R1.add R1.z (R1.add R1.z (R1.add (R1.mul bv (h (sub3 m eY2))) (R1.mul (R1.neg bv) (h (sub3 m eZ2)))))) i)
     (trans (ap (k.add (cb (h (sub3 m eYZ)) i))
              (trans (cb-add R1.z (R1.add R1.z (R1.add (R1.mul bv (h (sub3 m eY2))) (R1.mul (R1.neg bv) (h (sub3 m eZ2))))) i)
                (ap (k.add (cb R1.z i))
                  (trans (cb-add R1.z (R1.add (R1.mul bv (h (sub3 m eY2))) (R1.mul (R1.neg bv) (h (sub3 m eZ2)))) i)
                    (ap (k.add (cb R1.z i))
                      (trans (cb-add (R1.mul bv (h (sub3 m eY2))) (R1.mul (R1.neg bv) (h (sub3 m eZ2))) i)
                             (Ps.cong2 k.R k.add _ _ _ _ (cb-bv (h (sub3 m eY2)) i) (cb-mbv (h (sub3 m eZ2)) i))))))))
       (k3 (cb (h (sub3 m eYZ)) i) (cb R1.z i) (cb R1.z i) (k.add (shb (h (sub3 m eY2)) i) (k.neg (shb (h (sub3 m eZ2)) i)))
           (cb-z i) (cb-z i)
           (trans (Ps.cong2 k.R k.add _ _ _ _ (hz (sub3 m eY2)) (trans (ap k.neg (hz (sub3 m eZ2))) Rk.neg-zero)) (k.addZ k.z)))) ;
  R00k (g : Lk.Lau) (m : E3) : k.R =
    k.add (g (sub3 (sub3 m eZ2) eYZ)) (k.add (g (sub3 (sub3 m eX2) eXZ)) (g (sub3 (sub3 m eXY) eXZ))) ;
  cbR0 (h : LR.Lau) (m : E3) (i : Ring[l].Nat) (hz : ShZ h i) : Id k.R (cb (R0h h m) i) (R00k (\ u -> cb (h u) i) m) =
    trans (cb-add (Q0h h (sub3 m eZ2)) (R1.add (P0h h (sub3 m eX2)) (P0h h (sub3 m eXY))) i)
      (Ps.cong2 k.R k.add _ _ _ _ (cbQ0 h (sub3 m eZ2) i hz)
        (trans (cb-add (P0h h (sub3 m eX2)) (P0h h (sub3 m eXY)) i)
               (Ps.cong2 k.R k.add _ _ _ _ (cbP0 h (sub3 m eX2) i hz) (cbP0 h (sub3 m eXY) i hz)))) ;

  ------------------------------------------------------------------------
  -- (X) R00 g = 0 forces g = 0 for g finitely supported: from the largest
  -- exponent of X down, since  g(p) = -(g(p + (3,-1,-2)) + g(p + (1,-1,0)))

  module XD (g : Lk.Lau) (fg : LaurentList[l].Over[k].Fin g) (hR : (m : E3) -> Id k.R (R00k g m) k.z) {
    module Lk' = LaurentList[l].Over[k] ;
    V (x : Int) : U l = (m : E3) -> Id Int (ex m) x -> Id k.R (g m) k.z ;
    V-tr (x x' : Int) (e : Id Int x x') (h : V x) : V x' = subst V e h ;
    k-mid (u v w : k.R) (hu : Id k.R u k.z) (hw : Id k.R w k.z) (h : Id k.R (k.add u (k.add v w)) k.z) : Id k.R v k.z =
      trans (sym (trans (Ps.cong2 k.R k.add _ _ _ _ hu (trans (ap (k.add v) hw) (k.addZ v))) (Rk.zl v))) h ;
    step (x : Int) (h1 : V (sucZ x)) (h3 : V (sucZ (sucZ (sucZ x)))) : V x =
      \ p ep -> subst (\ q -> Id k.R (g q) k.z) (trans (ap (\ u -> sub3 u eXZ) (sub3-cancel (up p eXZ) eX2)) (sub3-cancel p eXZ))
        (k-mid (g (sub3 (sub3 (up (up p eXZ) eX2) eZ2) eYZ)) (g (sub3 (sub3 (up (up p eXZ) eX2) eX2) eXZ)) (g (sub3 (sub3 (up (up p eXZ) eX2) eXY) eXZ))
               (h3 (sub3 (sub3 (up (up p eXZ) eX2) eZ2) eYZ) (ap (\ t -> sucZ (sucZ (sucZ t))) ep))
               (h1 (sub3 (sub3 (up (up p eXZ) eX2) eXY) eXZ)
                   (trans (ap predZ (pred-suc (sucZ (sucZ (ex p))))) (trans (pred-suc (sucZ (ex p))) (ap sucZ ep))))
               (hR (up (up p eXZ) eX2))) ;

    -- the bound on the exponents of X of a list
    posPart : Int -> Nat = split { pos n -> n ; negsuc n -> zero } ;
    Bsum : List (k.R * E3) -> Nat = split { nil -> zero ; cons t ts | r -> NA.plus (posPart (ex t.2)) r } ;
    lt-self : (n x : Nat) -> Id Nat (suc (NA.plus x n)) n -> Empty = split {
      zero -> \ x e -> not-code (suc (NA.plus x zero)) zero e ;
      suc n | r -> \ x e -> r x (trans (sym (NA.plus-suc x n)) (NA.suc-inj e)) } ;
    no-big (n c b : Nat) (e : Id Nat (NA.plus c (suc (NA.plus n b))) n) : Empty =
      lt-self n (NA.plus c b)
        (trans (sym (trans (NA.plus-suc c (NA.plus n b))
                           (ap (\ q -> suc q) (trans (ap (NA.plus c) (NA.plus-comm n b)) (sym (NA.plus-assoc c b n)))))) e) ;
    le-suc (a b : Nat) (h : NA.Le a b) : NA.Le (suc a) (suc b) = (h.1, trans (NA.plus-suc h.1 a) (ap (\ q -> suc q) h.2)) ;
    int-big (b : Nat) (n : Nat) : (y : Int) -> Id Int y (pos n) -> NA.Le (suc (NA.plus (posPart y) b)) n -> Empty = split {
      pos i -> \ hy hl' -> no-big n hl'.1 b (subst (\ q -> Id Nat (NA.plus hl'.1 (suc (NA.plus q b))) n) (NA.code-eq i n (encode (pos i) (pos n) hy)) hl'.2) ;
      negsuc i -> \ hy hl' -> encode (negsuc i) (pos n) hy } ;
    big-zero : (ts : List (k.R * E3)) (m : E3) (n : Nat) -> Id Int (ex m) (pos n) -> NA.Le (suc (Bsum ts)) n -> Id k.R (Lk'.coef ts m) k.z = split {
      nil -> \ m n hm hl -> refl k.z ;
      cons t ts | r -> \ m n hm hl ->
        trans (Ps.cong2 k.R k.add _ _ _ _
                 (Lk'.ifD-no (\ q -> int-big (Bsum ts) n (ex t.2) (trans (ap ex q) hm) hl) (LaurentList[l].dec3 t.2 m) t.1)
                 (r m n hm (NA.le-trans (suc (Bsum ts)) (suc (NA.plus (posPart (ex t.2)) (Bsum ts))) n
                              (le-suc (Bsum ts) (NA.plus (posPart (ex t.2)) (Bsum ts)) (NA.le-sum-r (Bsum ts) (posPart (ex t.2)))) hl)))
              (k.addZ k.z) } ;

    -- predecessors
    it : Nat -> Int -> Int = split { zero -> \ y -> y ; suc n | r -> \ y -> predZ (r y) } ;
    it-pred : (n : Nat) (y : Int) -> Id Int (it n (predZ y)) (predZ (it n y)) = split {
      zero -> \ y -> refl (predZ y) ;
      suc n | r -> \ y -> ap predZ (r y) } ;
    it-pos : (d n : Nat) -> Id Int (it d (pos (NA.plus d n))) (pos n) = split {
      zero -> \ n -> refl (pos n) ;
      suc d | r -> \ n -> trans (sym (it-pred d (pos (suc (NA.plus d n))))) (r n) } ;
    it-neg : (n : Nat) -> Id Int (it (suc n) (pos zero)) (negsuc n) = split {
      zero -> refl (negsuc zero) ;
      suc n | r -> ap predZ r } ;
    it-add : (a b : Nat) (y : Int) -> Id Int (it (NA.plus a b) y) (it a (it b y)) = split {
      zero -> \ b y -> refl (it b y) ;
      suc a | r -> \ b y -> ap predZ (r b y) } ;
    -- every natural number is above b or below b + 1
    cmp : (n m : Nat) -> Plus (NA.Le (suc m) n) (NA.Le n (suc m)) = split {
      zero -> \ m -> inr (suc m, NA.plus-zero (suc m)) ;
      suc n | r -> split {
        zero -> inl (n, trans (NA.plus-suc n zero) (ap (\ q -> suc q) (NA.plus-zero n))) ;
        suc m -> cmp-suc n m (r m) } }
      where { cmp-suc (n m : Nat) : Plus (NA.Le (suc m) n) (NA.Le n (suc m)) -> Plus (NA.Le (suc (suc m)) (suc n)) (NA.Le (suc n) (suc (suc m))) = split {
                inl h -> inl (h.1, trans (NA.plus-suc h.1 (suc m)) (ap (\ q -> suc q) h.2)) ;
                inr h -> inr (h.1, trans (NA.plus-suc h.1 n) (ap (\ q -> suc q) h.2)) } } ;

    module W (w : Lk'.FinW g) {
      B : Nat = Bsum w.1 ;
      vbig (n : Nat) (hl : NA.Le (suc B) n) : V (pos n) = \ m em -> trans (sym (w.2 m)) (big-zero w.1 m n em hl) ;
      X0 : Int = pos (suc B) ;
      T (n : Nat) : U l = V (it n X0) * (V (sucZ (it n X0)) * V (sucZ (sucZ (it n X0)))) ;
      T0 : T zero = (vbig (suc B) (NA.le-refl (suc B)), (vbig (suc (suc B)) (suc zero, refl (suc (suc B))),
                      vbig (suc (suc (suc B))) (suc (suc zero), refl (suc (suc (suc B)))))) ;
      Tsuc (n : Nat) (t : T n) : T (suc n) =
        (step (predZ (it n X0)) (V-tr (it n X0) (sucZ (predZ (it n X0))) (sym (suc-pred (it n X0))) t.1)
                                (V-tr (sucZ (sucZ (it n X0))) (sucZ (sucZ (sucZ (predZ (it n X0))))) (sym (ap (\ q -> sucZ (sucZ q)) (suc-pred (it n X0)))) t.2.2),
         (V-tr (it n X0) (sucZ (predZ (it n X0))) (sym (suc-pred (it n X0))) t.1,
          V-tr (sucZ (it n X0)) (sucZ (sucZ (predZ (it n X0)))) (sym (ap sucZ (suc-pred (it n X0)))) t.2.1)) ;
      Tall : (n : Nat) -> T n = split { zero -> T0 ; suc n | r -> Tsuc n r } ;
      it-B : Id Int (it (suc B) X0) (pos zero) =
        trans (ap (\ q -> it (suc B) (pos q)) (sym (NA.plus-zero (suc B)))) (it-pos (suc B) zero) ;
      all-pos (n : Nat) : Plus (NA.Le (suc B) n) (NA.Le n (suc B)) -> V (pos n) = split {
        inl h -> vbig n h ;
        inr h -> V-tr (it h.1 X0) (pos n) (trans (ap (\ q -> it h.1 (pos q)) (sym h.2)) (it-pos h.1 n)) (Tall h.1).1 } ;
      all : (x : Int) -> V x = split {
        pos n -> all-pos n (cmp n B) ;
        negsuc n -> V-tr (it (NA.plus (suc n) (suc B)) X0) (negsuc n)
                      (trans (it-add (suc n) (suc B) X0) (trans (ap (it (suc n)) it-B) (it-neg n)))
                      (Tall (NA.plus (suc n) (suc B))).1 } ;
    } ;
    zero-at (m : E3) : Id k.R (g m) k.z =
      Tr.Trunc[Lk'.FinW g].induction @l (\ u -> Id k.R (g m) k.z) (\ u -> setk (g m) k.z) (\ w -> W[w].all (ex m) m (refl (ex m))) fg ;
  } ;

  ------------------------------------------------------------------------
  -- (D) R0' h = 0 forces h = 0, on the coefficients of b from b^0 up

  module SD (h : LR.Lau) (fh : LaurentList[l].Over[R1].Fin h) (hz : (m : E3) -> Id R1.R (R0h h m) R1.z) {
    hb (i : Ring[l].Nat) : Lk.Lau = \ u -> cb (h u) i ;
    fin-hb (i : Ring[l].Nat) : LaurentList[l].Over[k].Fin (hb i) = CrossFin[R1,k,\ u -> cb u i,\ u v -> cb-add u v i].fin h fh ;
    coeffs : (i : Ring[l].Nat) (x : E3) -> Id k.R (cb (h x) i) k.z = split {
      zero -> XD[hb zero,fin-hb zero,\ m -> trans (sym (cbR0 h m zero (\ x -> refl k.z))) (trans (ap (\ t -> cb t zero) (hz m)) (cb-z zero))].zero-at ;
      suc i | r -> XD[hb (suc i),fin-hb (suc i),\ m -> trans (sym (cbR0 h m (suc i) (\ x -> r x))) (trans (ap (\ t -> cb t (suc i)) (hz m)) (cb-z (suc i)))].zero-at } ;
    out (m : E3) : Id R1.R (h m) R1.z = CPb.coef-ext (h m) R1.z (\ i -> trans (coeffs i m) (sym (cb-z i))) ;
  } ;

  ------------------------------------------------------------------------
  -- (Div) beta = P w0 + r with r without a

  module LLA = LaurentList[l].Over[A] ;
  liftAt : Ring[l].Nat -> R1.R -> A.R = split { zero -> \ c -> E2.constant c ; suc n | r -> \ c -> A.mul a (r c) } ;
  lift-top : (n : Ring[l].Nat) (c : R1.R) -> Id R1.R (ca (liftAt n c) n) c = split {
    zero -> \ c -> CPa.coef-const0 c ;
    suc n | r -> \ c -> trans (CPa.coef-variable (liftAt n c) (suc n)) (r c) } ;
  lift-hi : (n : Ring[l].Nat) (c : R1.R) (i : Ring[l].Nat) -> Id R1.R (ca (liftAt n c) (plus n (suc i))) R1.z = split {
    zero -> \ c i -> CPa.coef-constS c i ;
    suc n | r -> \ c i -> trans (CPa.coef-variable (liftAt n c) (suc (plus n (suc i)))) (r c i) } ;
  lift-add : (n : Ring[l].Nat) (u v : R1.R) -> Id A.R (liftAt n (R1.add u v)) (A.add (liftAt n u) (liftAt n v)) = split {
    zero -> \ u v -> E2.constant-add u v ;
    suc n | r -> \ u v -> trans (ap (A.mul a) (r u v)) (A.dist a (liftAt n u) (liftAt n v)) } ;
  fin-lift (n : Ring[l].Nat) (g : LR.Lau) (fg : LaurentList[l].Over[R1].Fin g) : LLA.Fin (\ m -> liftAt n (g m)) =
    CrossFin[R1,A,liftAt n,lift-add n].fin g fg ;
  aBound-up (f : LA.Lau) (N : Ring[l].Nat) (hb : aBound f N) : aBound f (suc N) =
    \ m i -> trans (ap (ca (f m)) (sym (plus-suc N i))) (hb m (suc i)) ;
  -- x0 + (y + (c1 x1 + c2 x2)) = y  when x0 = x1 = x2 = 0
  simp4 (x0 y x1 x2 c1 c2 : R1.R) (h0 : Id R1.R x0 R1.z) (h1 : Id R1.R x1 R1.z) (h2 : Id R1.R x2 R1.z) :
    Id R1.R (R1.add x0 (R1.add y (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) y =
    trans (ap (\ t -> R1.add t (R1.add y (R1.add (R1.mul c1 x1) (R1.mul c2 x2)))) h0)
      (trans (RR.zl (R1.add y (R1.add (R1.mul c1 x1) (R1.mul c2 x2))))
        (trans (ap (R1.add y) (trans (Ps.cong2 R1.R R1.add _ _ _ _ (trans (ap (R1.mul c1) h1) (RR.mul-zero c1)) (trans (ap (R1.mul c2) h2) (RR.mul-zero c2)))
                                     (R1.addZ R1.z)))
               (R1.addZ y))) ;
  -- the a^(N+1) coefficient is removed by  P (c a^N) ,  c(m) = - beta_(N+1)(m + Z^2)
  module Top (be : LA.Lau) (N : Ring[l].Nat) (hb : aBound be (suc (suc N))) {
    top (m : E3) : R1.R = ca (be m) (suc N) ;
    gc (m : E3) : R1.R = R1.neg (top (up m eZ2)) ;
    fl (m : E3) : A.R = liftAt N (gc m) ;
    be' : LA.Lau = LA.subL be (LA.mulP PlP fl) ;
    hiN (u : E3) (i : Ring[l].Nat) : Id R1.R (ca (fl u) (plus N (suc i))) R1.z = lift-hi N (gc u) i ;
    sN : Id Ring[l].Nat (suc N) (plus N (suc zero)) = sym (trans (plus-suc N zero) (ap (\ q -> suc q) (plus-zero N))) ;
    up-back (m : E3) : Id E3 (up (sub3 m eZ2) eZ2) m = trans (sub3-comm m eZ2 (neg3 eZ2)) (sub3-cancel m eZ2) ;
    -- the coefficient a^(N+1) of P fl is  -fl_N(m - Z^2) = top(m)
    pf-top (m : E3) : Id R1.R (fP fl m (suc N)) (top m) =
      trans (simp4 (ca (fl (sub3 m eXZ)) (suc N)) (R1.neg (ca (fl (sub3 m eZ2)) N)) (ca (fl (sub3 m eXY)) (suc N)) (ca (fl (sub3 m eX2)) (suc N)) bv (R1.mul bv two1)
                    (trans (ap (ca (fl (sub3 m eXZ))) sN) (hiN (sub3 m eXZ) zero))
                    (trans (ap (ca (fl (sub3 m eXY))) sN) (hiN (sub3 m eXY) zero))
                    (trans (ap (ca (fl (sub3 m eX2))) sN) (hiN (sub3 m eX2) zero)))
        (trans (ap R1.neg (trans (lift-top N (gc (sub3 m eZ2))) (ap (\ q -> R1.neg (top q)) (up-back m)))) (RR.neg-neg (top m)))
 ;
    -- higher coefficients of P fl vanish
    pf-hi (m : E3) (i : Ring[l].Nat) : Id R1.R (fP fl m (suc (plus N (suc i)))) R1.z =
      trans (simp4 (ca (fl (sub3 m eXZ)) (suc (plus N (suc i)))) (R1.neg (ca (fl (sub3 m eZ2)) (plus N (suc i))))
                 (ca (fl (sub3 m eXY)) (suc (plus N (suc i)))) (ca (fl (sub3 m eX2)) (suc (plus N (suc i)))) bv (R1.mul bv two1)
                 (trans (ap (ca (fl (sub3 m eXZ))) (sym (plus-suc N (suc i)))) (hiN (sub3 m eXZ) (suc i)))
                 (trans (ap (ca (fl (sub3 m eXY))) (sym (plus-suc N (suc i)))) (hiN (sub3 m eXY) (suc i)))
                 (trans (ap (ca (fl (sub3 m eX2))) (sym (plus-suc N (suc i)))) (hiN (sub3 m eX2) (suc i))))
            (trans (ap R1.neg (hiN (sub3 m eZ2) i)) RR.neg-zero) ;
    -- fl is finitely supported when be is
    module Fl (fb : LLA.Fin be) {
      ftop : LaurentList[l].Over[R1].Fin top = CrossFin[A,R1,\ u -> ca u (suc N),\ u v -> c-add u v (suc N)].fin be fb ;
      fshift : LaurentList[l].Over[R1].Fin (\ m -> top (up m eZ2)) =
        LaurentList[l].Over[R1].fin-cong (LR.mulP (LR.monoP (neg3 eZ2)) top) (\ m -> top (up m eZ2)) (LR.mulP-mono (neg3 eZ2) top)
          (LaurentList[l].Over[R1].fin-mulP (LR.monoP (neg3 eZ2)) top ftop) ;
      fgc : LaurentList[l].Over[R1].Fin gc = LaurentList[l].Over[R1].fin-neg (\ m -> top (up m eZ2)) fshift ;
      ffl : LLA.Fin fl = fin-lift N gc fgc ;
    } ;
    -- be' = be - P fl has a-degree <= N
    sub-coef (m : E3) (j : Ring[l].Nat) : Id R1.R (ca (be' m) j) (R1.add (ca (be m) j) (R1.neg (fP fl m j))) =
      trans (c-add (be m) (A.neg (LA.mulP PlP fl m)) j) (ap (R1.add (ca (be m) j)) (trans (CPa.coef-neg (LA.mulP PlP fl m) j) (ap R1.neg (coefP fl m j)))) ;
    bound' : aBound be' (suc N) = \ m -> bnd m
      where { bnd (m : E3) : (i : Ring[l].Nat) -> Id R1.R (ca (be' m) (plus (suc N) i)) R1.z = split {
                zero -> trans (ap (ca (be' m)) (ap (\ q -> suc q) (plus-zero N)))
                          (trans (sub-coef m (suc N)) (trans (ap (\ t -> R1.add (top m) (R1.neg t)) (pf-top m)) (R1.addN (top m)))) ;
                suc i -> trans (sub-coef m (suc (plus N (suc i))))
                           (trans (Ps.cong2 R1.R R1.add _ _ _ _ (trans (ap (ca (be m)) (ap (\ q -> suc q) (plus-suc N i))) (hb m i))
                                                               (trans (ap R1.neg (pf-hi m i)) RR.neg-zero))
                                  (R1.addZ R1.z)) } } ;
  } ;
  Split (be : LA.Lau) : U l =
    (w : LA.Lau) * ((r : LA.Lau) * (LLA.Fin w * (LLA.Fin r * (aFree r * LA.EqL be (LA.addL (LA.mulP PlP w) r))))) ;
  module TS (be : LA.Lau) { module T = Tr.Trunc[Split be] ; } ;
  divide : (N : Ring[l].Nat) (be : LA.Lau) -> LLA.Fin be -> aBound be (suc N) -> TS[be].T.carrier = split {
    zero -> \ be fb hb -> TS[be].T.inc (LA.zeroL, (be, (LLA.fin-zero, (fb, (hb,
               \ m -> sym (trans (ap (\ t -> A.add t (be m)) (LA.mulP-zero PlP m)) (RA.zl (be m)))))))) ;
    suc N | ih -> \ be fb hb ->
      TS[Top[be,N,hb].be'].T.induction @l (\ u -> TS[be].T.carrier) (\ u -> TS[be].T.proposition)
        (\ sp -> TS[be].T.inc (LA.addL sp.1 Top[be,N,hb].fl, (sp.2.1, (LLA.fin-add sp.1 Top[be,N,hb].fl sp.2.2.1 Top[be,N,hb].Fl[fb].ffl, (sp.2.2.2.1, (sp.2.2.2.2.1,
                   \ m -> calc A.R {
                     be m =< sym (Cech3[l].Over[A].sub-add (be m) (LA.mulP PlP Top[be,N,hb].fl m)) > A.add (Top[be,N,hb].be' m) (LA.mulP PlP Top[be,N,hb].fl m)
                          =< ap (\ t -> A.add t (LA.mulP PlP Top[be,N,hb].fl m)) (sp.2.2.2.2.2 m)
                          > A.add (A.add (LA.mulP PlP sp.1 m) (sp.2.1 m)) (LA.mulP PlP Top[be,N,hb].fl m)
                          =< trans (sym (A.addA (LA.mulP PlP sp.1 m) (sp.2.1 m) (LA.mulP PlP Top[be,N,hb].fl m)))
                               (trans (ap (A.add (LA.mulP PlP sp.1 m)) (A.addC (sp.2.1 m) (LA.mulP PlP Top[be,N,hb].fl m)))
                                      (A.addA (LA.mulP PlP sp.1 m) (LA.mulP PlP Top[be,N,hb].fl m) (sp.2.1 m)))
                          > A.add (A.add (LA.mulP PlP sp.1 m) (LA.mulP PlP Top[be,N,hb].fl m)) (sp.2.1 m)
                          =< ap (\ t -> A.add t (sp.2.1 m)) (sym (LA.mulP-add PlP sp.1 Top[be,N,hb].fl m))
                          > A.add (LA.mulP PlP (LA.addL sp.1 Top[be,N,hb].fl) m) (sp.2.1 m) }))))))
        (ih Top[be,N,hb].be' (LLA.fin-sub be (LA.mulP PlP Top[be,N,hb].fl) fb (LLA.fin-mulP PlP Top[be,N,hb].fl Top[be,N,hb].Fl[fb].ffl)) Top[be,N,hb].bound') } ;

  ------------------------------------------------------------------------
  -- bounds on the powers of a, from finite support

  plus-assoc' : (x y w : Ring[l].Nat) -> Id Ring[l].Nat (plus (plus x y) w) (plus x (plus y w)) = split {
    zero -> \ y w -> refl (plus y w) ;
    suc x | r -> \ y w -> ap (\ q -> suc q) (r y w) } ;
  poly-bound : (p : CPa.P.P) (i : Ring[l].Nat) -> Id R1.R (CPa.P.coef p (plus (len {R1.R} p) i)) R1.z = split {
    nil -> \ i -> refl R1.z ;
    cons c p | r -> \ i -> r i } ;
  Bnd (x : A.R) : U l = (N : Ring[l].Nat) * ((i : Ring[l].Nat) -> Id R1.R (ca x (plus N i)) R1.z) ;
  module TB (x : A.R) { module T = Tr.Trunc[Bnd x] ; } ;
  elem-bound (x : A.R) : TB[x].T.carrier =
    E2.Q.induction @l (\ q -> TB[q].T.carrier) (\ q -> TB[q].T.proposition)
      (\ p -> TB[E2.include p].T.inc (len {R1.R} p, \ i -> trans (CPa.coef-include p (plus (len {R1.R} p) i)) (poly-bound p i))) x ;
  BndF (f : LA.Lau) : U l = (N : Ring[l].Nat) * aBound f N ;
  module TF (f : LA.Lau) { module T = Tr.Trunc[BndF f] ; } ;
  ifD-ca (c : A.R) (j : Ring[l].Nat) (m e : E3) (h : (i : Ring[l].Nat) -> Id R1.R (ca c (plus j i)) R1.z) :
    (d : LG.Dec (Id E3 e m)) -> (i : Ring[l].Nat) -> Id R1.R (ca (LLA.ifD d c) (plus j i)) R1.z = split {
    yes p -> h ;
    no n -> \ i -> c-z (plus j i) } ;
  -- the sum of two bounds bounds both
  bnd-l (N1 N2 i : Ring[l].Nat) : Id Ring[l].Nat (plus (plus N1 N2) i) (plus N1 (plus N2 i)) = plus-assoc' N1 N2 i ;
  bnd-r (N1 N2 i : Ring[l].Nat) : Id Ring[l].Nat (plus (plus N1 N2) i) (plus N2 (plus N1 i)) =
    trans (ap (\ q -> plus q i) (plus-comm N1 N2)) (plus-assoc' N2 N1 i) ;
  list-bound : (g : LA.LPoly) -> TF[LLA.coef g].T.carrier = split {
    nil -> TF[LLA.coef nil].T.inc (zero, \ m i -> c-z i) ;
    cons t g | r ->
      TB[t.1].T.induction @l (\ u -> TF[LLA.coef (cons t g)].T.carrier) (\ u -> TF[LLA.coef (cons t g)].T.proposition) (\ b1 ->
        TF[LLA.coef g].T.induction @l (\ u -> TF[LLA.coef (cons t g)].T.carrier) (\ u -> TF[LLA.coef (cons t g)].T.proposition) (\ b2 ->
          TF[LLA.coef (cons t g)].T.inc (plus b1.1 b2.1, \ m i ->
            trans (c-add (LLA.coefT t m) (LLA.coef g m) (plus (plus b1.1 b2.1) i))
              (trans (Ps.cong2 R1.R R1.add _ _ _ _
                        (trans (ap (ca (LLA.coefT t m)) (bnd-l b1.1 b2.1 i)) (ifD-ca t.1 b1.1 m t.2 b1.2 (LaurentList[l].dec3 t.2 m) (plus b2.1 i)))
                        (trans (ap (ca (LLA.coef g m)) (bnd-r b1.1 b2.1 i)) (b2.2 m (plus b1.1 i))))
                     (R1.addZ R1.z)))) r) (elem-bound t.1) } ;
  fin-bound (f : LA.Lau) (h : LLA.Fin f) : TF[f].T.carrier =
    Tr.Trunc[LLA.FinW f].induction @l (\ u -> TF[f].T.carrier) (\ u -> TF[f].T.proposition)
      (\ w -> TF[LLA.coef w.1].T.induction @l (\ u -> TF[f].T.carrier) (\ u -> TF[f].T.proposition)
                (\ bb -> TF[f].T.inc (bb.1, \ m i -> trans (ap (\ t -> ca t (plus bb.1 i)) (sym (w.2 m))) (bb.2 m i))) (list-bound w.1)) h ;

  -- P is injective on finitely supported functions
  Pinj (f : LA.Lau) (fin : LLA.Fin f) (h : LA.EqL (LA.mulP PlP f) LA.zeroL) (m : E3) : Id A.R (f m) A.z =
    TF[f].T.induction @l (\ u -> Id A.R (f m) A.z) (\ u -> setA (f m) A.z)
      (\ bb -> f-zero f bb.1 bb.2 (\ m' i -> trans (ap (\ t -> ca t (plus (suc zero) i)) (h m')) (c-z (plus (suc zero) i))) m) (fin-bound f fin) ;

  ------------------------------------------------------------------------
  -- the homogeneous component of degree k

  module CCA = CechContraction[l].Over[A] ;
  qdk (kk : Int) (m : E3) : Bool = LaurentList[l].toB (int-dec (deg m) kk) ;
  hproj (kk : Int) (f : LA.Lau) : LA.Lau = \ m -> LA.ifB (qdk kk m) (f m) ;
  toB-no {X : U l} (n : LG.Not X) : (d : LG.Dec X) -> Id Bool (LaurentList[l].toB d) false = split {
    yes p -> P.absurd (Id Bool true false) (n p) ;
    no n' -> refl false } ;
  toB-iff {X Y : U l} (fxy : X -> Y) (fyx : Y -> X) : (d : LG.Dec X) (d' : LG.Dec Y) -> Id Bool (LaurentList[l].toB d) (LaurentList[l].toB d') = split {
    yes p -> split { yes q -> refl true ; no n -> P.absurd (Id Bool true false) (n (fxy p)) } ;
    no n -> split { yes q -> P.absurd (Id Bool false true) (n (fyx q)) ; no n' -> refl false } } ;
  hproj-hom (kk : Int) (f : LA.Lau) : LA.Hom kk (hproj kk f) =
    \ m ne -> ap (\ bb -> LA.ifB bb (f m)) (toB-no ne (int-dec (deg m) kk)) ;
  hproj-fin (kk : Int) (f : LA.Lau) (h : LLA.Fin f) : LLA.Fin (hproj kk f) =
    LLA.Point[\ m v -> LA.ifB (qdk kk m) v,\ m u v -> CCA.ifB-add (qdk kk m) u v].fin-point f h ;
  hp-pt (kk : Int) (f : LA.Lau) (h : LA.Hom kk f) (m : E3) : (bb : Bool) -> Id Bool (qdk kk m) bb -> Id A.R (hproj kk f m) (f m) = split {
    true -> \ e -> ap (\ c -> LA.ifB c (f m)) e ;
    false -> \ e -> trans (ap (\ c -> LA.ifB c (f m)) e) (sym (h m (CechSections[l].toB-false (int-dec (deg m) kk) e))) } ;
  hproj-id (kk : Int) (f : LA.Lau) (h : LA.Hom kk f) : LA.EqL (hproj kk f) f = \ m -> hp-pt kk f h m (qdk kk m) (refl (qdk kk m)) ;
  -- g (f_k) = (g f)_(k+k') for g homogeneous of degree k'
  q-shift (kk k' : Int) (m e : E3) (he : Id Int (deg e) k') : Id Bool (qdk kk (sub3 m e)) (qdk (add kk k') m) =
    toB-iff (\ x -> sub-solve (deg m) k' kk (trans (sym (trans (deg-sub m e) (ap (\ y -> add (deg m) (neg y)) he))) x))
            (\ y -> trans (trans (deg-sub m e) (ap (\ z -> add (deg m) (neg z)) he))
                          (trans (ap (\ z -> add z (neg k')) y) (FixedCochain[l].add-sub kk k')))
            (int-dec (deg (sub3 m e)) kk) (int-dec (deg m) (add kk k')) ;
  hproj-mul (kk k' : Int) (f : LA.Lau) : (g : LA.LPoly) -> LA.HomPI k' g -> LA.EqL (LA.mulP g (hproj kk f)) (hproj (add kk k') (LA.mulP g f)) = split {
    nil -> \ hg m -> sym (CCA.ifB-zero (qdk (add kk k') m)) ;
    cons t g | r -> \ hg m ->
      trans (Ps.cong2 A.R A.add _ _ _ _
               (trans (ap (\ bb -> A.mul t.1 (LA.ifB bb (f (sub3 m t.2)))) (q-shift kk k' m t.2 hg.1))
                      (sym (CCA.ifB-scale (qdk (add kk k') m) t.1 (f (sub3 m t.2)))))
               (r hg.2 m))
            (sym (CCA.ifB-add (qdk (add kk k') m) (A.mul t.1 (f (sub3 m t.2))) (LA.mulP g f m))) } ;

  ------------------------------------------------------------------------
  -- (S1)

  module CMdA = CechModules[l].Over[A,setA] ;
  module COA = Cech3[l].Over[A] ;
  eqL-prop (f g : LA.Lau) : Pr.isProp (LA.EqL f g) = FE.isProp-Pi E3 (\ m -> Id A.R (f m) (g m)) (\ m -> setA (f m) (g m)) ;
  two : Int = pos (suc (suc zero)) ;
  hPl : LA.HomPI two PlP = (refl two, (refl two, (refl two, (refl two, tt)))) ;
  Z2l : LA.LPoly = LA.monoP eZ2 ;
  X2l : LA.LPoly = LA.monoP eX2 ;
  XYl : LA.LPoly = LA.monoP eXY ;

  module S1M (al be : LA.Lau) (hal : CMdA.SL DA.kP1 al) (hbe : CMdA.SL DA.kQ1 be)
    (eq : LA.EqL (LA.addL (LA.mulP PlP al) (LA.mulP PlQ be)) LA.zeroL) {
    Res : U l = (w : LA.Lau) * (CMdA.SL DA.kW w * (LA.EqL al (LA.negL (LA.mulP PlQ w)) * LA.EqL be (LA.mulP PlP w))) ;
    module TR = Tr.Trunc[Res] ;
    rest-prop (w : LA.Lau) : Pr.isProp (CMdA.SL DA.kW w * (LA.EqL al (LA.negL (LA.mulP PlQ w)) * LA.EqL be (LA.mulP PlP w))) =
      CMdA.prod3-prop (CMdA.SL DA.kW w) (LA.EqL al (LA.negL (LA.mulP PlQ w))) (LA.EqL be (LA.mulP PlP w))
        (CMdA.pair-prop (LA.Hom DA.kW w) (LLA.Fin w) (CMdA.hom-prop DA.kW w) (LLA.fin-prop w))
        (eqL-prop al (LA.negL (LA.mulP PlQ w))) (eqL-prop be (LA.mulP PlP w)) ;
    -- w is unique: P (w - w') = 0
    w-unique (x y : Res) : Id LA.Lau x.1 y.1 =
      CMdA.ext x.1 y.1 (\ m -> COA.sub-eq (x.1 m) (y.1 m)
        (Pinj (LA.subL x.1 y.1) (LLA.fin-sub x.1 y.1 x.2.1.2 y.2.1.2)
          (\ m' -> trans (LA.mulP-sub PlP x.1 y.1 m')
                     (trans (Ps.cong2 A.R A.add _ _ _ _ (sym (x.2.2.2 m')) (ap A.neg (sym (y.2.2.2 m')))) (A.addN (be m')))) m)) ;
    res-prop : Pr.isProp Res = \ x y ->
      Pr.Sigma-eq LA.Lau (\ w -> CMdA.SL DA.kW w * (LA.EqL al (LA.negL (LA.mulP PlQ w)) * LA.EqL be (LA.mulP PlP w)))
        x.1 y.1 x.2 y.2 (w-unique x y) (rest-prop y.1) ;

    module After (w0 r : LA.Lau) (fw0 : LLA.Fin w0) (fr : LLA.Fin r) (hr : aFree r)
      (ebe : LA.EqL be (LA.addL (LA.mulP PlP w0) r)) {
      Uop (x : LA.Lau) : LA.Lau = LA.addL (LA.mulP X2l x) (LA.mulP XYl x) ;
      fz : LA.Lau = LA.addL (LA.mulP Z2l (LA.addL al (LA.mulP PlQ w0))) (LA.negL (Uop r)) ;
      ffz : LLA.Fin fz =
        LLA.fin-add (LA.mulP Z2l (LA.addL al (LA.mulP PlQ w0))) (LA.negL (Uop r))
          (LLA.fin-mulP Z2l (LA.addL al (LA.mulP PlQ w0)) (LLA.fin-add al (LA.mulP PlQ w0) hal.2 (LLA.fin-mulP PlQ w0 fw0)))
          (LLA.fin-neg (Uop r) (LLA.fin-add (LA.mulP X2l r) (LA.mulP XYl r) (LLA.fin-mulP X2l r fr) (LLA.fin-mulP XYl r fr))) ;
      -- (P al + P (Q w0)) + Q r = P al + Q (P w0 + r) = P al + Q be = 0
      inner (m : E3) : Id A.R (A.add (A.add (LA.mulP PlP al m) (LA.mulP PlP (LA.mulP PlQ w0) m)) (LA.mulP PlQ r m)) A.z =
        calc A.R {
          A.add (A.add (LA.mulP PlP al m) (LA.mulP PlP (LA.mulP PlQ w0) m)) (LA.mulP PlQ r m)
            =< sym (A.addA (LA.mulP PlP al m) (LA.mulP PlP (LA.mulP PlQ w0) m) (LA.mulP PlQ r m))
            > A.add (LA.mulP PlP al m) (A.add (LA.mulP PlP (LA.mulP PlQ w0) m) (LA.mulP PlQ r m))
            =< ap (\ t -> A.add (LA.mulP PlP al m) (A.add t (LA.mulP PlQ r m))) (LA.mulP-comm PlP PlQ w0 m)
            > A.add (LA.mulP PlP al m) (A.add (LA.mulP PlQ (LA.mulP PlP w0) m) (LA.mulP PlQ r m))
            =< ap (A.add (LA.mulP PlP al m)) (sym (LA.mulP-add PlQ (LA.mulP PlP w0) r m))
            > A.add (LA.mulP PlP al m) (LA.mulP PlQ (LA.addL (LA.mulP PlP w0) r) m)
            =< ap (A.add (LA.mulP PlP al m)) (LA.mulP-cong PlQ (LA.addL (LA.mulP PlP w0) r) be (\ k -> sym (ebe k)) m)
            > A.add (LA.mulP PlP al m) (LA.mulP PlQ be m)
            =< eq m > A.z } ;
      -- P fz + R r = Z^2 (P al + Q be) = 0
      ident (m : E3) : Id A.R (A.add (LA.mulP PlP fz m) (Ropr r m)) A.z =
        calc A.R {
          A.add (LA.mulP PlP fz m) (Ropr r m)
            =< ap (\ t -> A.add t (Ropr r m))
                 (trans (LA.mulP-add PlP (LA.mulP Z2l (LA.addL al (LA.mulP PlQ w0))) (LA.negL (Uop r)) m)
                   (Ps.cong2 A.R A.add _ _ _ _
                      (trans (LA.mulP-comm PlP Z2l (LA.addL al (LA.mulP PlQ w0)) m)
                             (LA.mulP-cong Z2l (LA.mulP PlP (LA.addL al (LA.mulP PlQ w0))) (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0)))
                                (LA.mulP-add PlP al (LA.mulP PlQ w0)) m))
                      (trans (LA.mulP-neg PlP (Uop r) m)
                             (ap A.neg (trans (LA.mulP-add PlP (LA.mulP X2l r) (LA.mulP XYl r) m)
                                              (Ps.cong2 A.R A.add _ _ _ _ (LA.mulP-comm PlP X2l r m) (LA.mulP-comm PlP XYl r m)))))))
            > A.add (A.add (LA.mulP Z2l (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0))) m)
                           (A.neg (A.add (LA.mulP X2l (LA.mulP PlP r) m) (LA.mulP XYl (LA.mulP PlP r) m))))
                    (A.add (LA.mulP Z2l (LA.mulP PlQ r) m) (A.add (LA.mulP X2l (LA.mulP PlP r) m) (LA.mulP XYl (LA.mulP PlP r) m)))
            =< ring-SW (LA.mulP Z2l (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0))) m) (LA.mulP Z2l (LA.mulP PlQ r) m)
                       (A.add (LA.mulP X2l (LA.mulP PlP r) m) (LA.mulP XYl (LA.mulP PlP r) m))
            > A.add (LA.mulP Z2l (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0))) m) (LA.mulP Z2l (LA.mulP PlQ r) m)
            =< sym (LA.mulP-add Z2l (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0))) (LA.mulP PlQ r) m)
            > LA.mulP Z2l (LA.addL (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0))) (LA.mulP PlQ r)) m
            =< LA.mulP-cong Z2l (LA.addL (LA.addL (LA.mulP PlP al) (LA.mulP PlP (LA.mulP PlQ w0))) (LA.mulP PlQ r)) LA.zeroL inner m
            > LA.mulP Z2l LA.zeroL m
            =< LA.mulP-zero Z2l m > A.z }
        where {
          ring-SW (S W T : A.R) : Id A.R (A.add (A.add S (A.neg T)) (A.add W T)) (A.add S W) =
            trans (sym (A.addA S (A.neg T) (A.add W T)))
              (ap (A.add S) (trans (RA.add-swap (A.neg T) W T) (trans (ap (A.add W) (RA.neg-cancel T)) (A.addZ W)))) } ;
      Pfz-neg (m : E3) : Id A.R (LA.mulP PlP fz m) (A.neg (Ropr r m)) =
        RA.neg-uniq (Ropr r m) (LA.mulP PlP fz m) (trans (A.addC (Ropr r m) (LA.mulP PlP fz m)) (ident m)) ;
      free-Pfz : aFree (LA.mulP PlP fz) = \ m i ->
        trans (ap (\ t -> ca t (plus (suc zero) i)) (Pfz-neg m))
          (trans (CPa.coef-neg (Ropr r m) (plus (suc zero) i)) (trans (ap R1.neg (Free[r,hr].R-free m i)) RR.neg-zero)) ;
      fr0 : LaurentList[l].Over[R1].Fin (\ u -> ca (r u) zero) = CrossFin[A,R1,\ u -> ca u zero,\ u v -> c-add u v zero].fin r fr ;
      module B (bz : BndF fz) {
        fz0 (m : E3) : Id A.R (fz m) A.z = f-zero fz bz.1 bz.2 free-Pfz m ;
        Rr0 (m : E3) : Id A.R (Ropr r m) A.z =
          trans (sym (RA.neg-neg (Ropr r m)))
            (trans (ap A.neg (sym (Pfz-neg m)))
              (trans (ap A.neg (trans (LA.mulP-cong PlP fz LA.zeroL fz0 m) (LA.mulP-zero PlP m))) RA.neg-zero)) ;
        r0z (m : E3) : Id R1.R (ca (r m) zero) R1.z =
          SD[\ u -> ca (r u) zero,fr0,\ m' -> trans (sym (coefR0 r m')) (trans (ap (\ t -> ca t zero) (Rr0 m')) (c-z zero))].out m ;
        rz (m : E3) : Id A.R (r m) A.z = Free[r,hr].r-is m (r0z m) ;
        bePw0 (m : E3) : Id A.R (be m) (LA.mulP PlP w0 m) =
          trans (ebe m) (trans (ap (A.add (LA.mulP PlP w0 m)) (rz m)) (A.addZ (LA.mulP PlP w0 m))) ;
        w : LA.Lau = hproj DA.kW w0 ;
        fw : LLA.Fin w = hproj-fin DA.kW w0 fw0 ;
        Pw (m : E3) : Id A.R (LA.mulP PlP w m) (be m) =
          trans (hproj-mul DA.kW two w0 PlP hPl m)
            (trans (ap (LA.ifB (qdk DA.kQ1 m)) (sym (bePw0 m))) (hproj-id DA.kQ1 be hbe.1 m)) ;
        z0 (m : E3) : Id A.R (LA.addL al (LA.mulP PlQ w) m) A.z =
          Pinj (LA.addL al (LA.mulP PlQ w)) (LLA.fin-add al (LA.mulP PlQ w) hal.2 (LLA.fin-mulP PlQ w fw))
            (\ m' -> trans (LA.mulP-add PlP al (LA.mulP PlQ w) m')
                       (trans (ap (A.add (LA.mulP PlP al m')) (trans (LA.mulP-comm PlP PlQ w m') (LA.mulP-cong PlQ (LA.mulP PlP w) be Pw m')))
                              (eq m'))) m ;
        res : Res = (w, ((hproj-hom DA.kW w0, fw),
                         (\ m -> RA.neg-uniq (LA.mulP PlQ w m) (al m) (trans (A.addC (LA.mulP PlQ w m) (al m)) (z0 m)),
                          \ m -> sym (Pw m)))) ;
      } ;
      result : TR.carrier = TF[fz].T.induction @l (\ u -> TR.carrier) (\ u -> TR.proposition) (\ bz -> TR.inc B[bz].res) (fin-bound fz ffz) ;
    } ;
    main : TR.carrier =
      TF[be].T.induction @l (\ u -> TR.carrier) (\ u -> TR.proposition)
        (\ bb -> TS[be].T.induction @l (\ u -> TR.carrier) (\ u -> TR.proposition)
                   (\ sp -> After[sp.1,sp.2.1,sp.2.2.1,sp.2.2.2.1,sp.2.2.2.2.1,sp.2.2.2.2.2].result)
                   (divide bb.1 be hbe.2 (aBound-up be bb.1 bb.2)))
        (fin-bound be hbe.2) ;
    res : Res = TR.induction @l (\ u -> Res) (\ u -> res-prop) (\ x -> x) main ;
  } ;
  -- the datum (S1) for the example of ACL, over k[b][a]
  s1 : DA.S1T = \ al be hal hbe eq -> S1M[al,be,hal,hbe,eq].res ;
} ;
