-- CechH1Finite.seg: generators of H^1 of N(-1), N = D[X,Y,Z]/J, on the
-- three charts (finite-cohomology.tex, Proposition 1 and its proof;
-- handoff §6).
--
-- J = (g_1, .., g_r) with g_j homogeneous of degree d_j >= 0.  A 1-cochain
-- of N(-1) is represented by a 1-cochain b of O(-1) (Laurent coefficients
-- with the support conditions), and it is a cocycle modulo J when
--     delta1 b = sum_j g_j q_j                                        (2)
-- for Laurent elements q_j, homogeneous of degree -d_j-1 (the membership
-- witness of delta1 b in the localised J).  The theorem:
--     b = sum_j g_j sigma(q_j) + b* + delta0 c ,
--     b* = sum_j sigma(g_j pi(q_j)) ,   c = tau(b - sum_j g_j sigma(q_j) - b*) .
-- The first sum is in J C^1, so modulo J, b and b* have the same class.
-- Proof: by decomp, delta1 sigma(q) = q - pi(q); g_j pi(q_j) has degree -1,
-- so pi(g_j pi(q_j)) = 0 and delta1 sigma(g_j pi(q_j)) = g_j pi(q_j); hence
-- delta1 (sum_j g_j sigma(q_j) + b*) = sum_j g_j q_j = delta1 b, and the
-- difference is closed and satisfies the support conditions, so it is
-- delta0 of its tau (contraction).  Each pi(q_j) is a D-combination of the
-- monomials X^-alpha Y^-beta Z^-gamma, alpha, beta, gamma >= 1,
-- alpha + beta + gamma = d_j + 1 (binom(d_j,2) of them), so b* is a
-- D-combination of the classes sigma(g_j X^-alpha Y^-beta Z^-gamma)
-- (generators, below).  No coefficient of D is tested for zero, no
-- syzygy of J is used.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;

module Over (D : CRing) {
  module LO = Laurent3[l].Over[D] ; open LO ;
  module CO = Cech3[l].Over[D] ; open CO ;
  module CC = CechContraction[l].Over[D] ; open CC ;
  module CM = CechMonomials[l] ; module CMO = CechMonomials[l].Over[D] ;

  -- a generator g of degree d with its witness q
  Gen : U l = LPoly * (Nat * Lau) ;
  gpoly (w : Gen) : LPoly = w.1 ;
  gdeg (w : Gen) : Nat = w.2.1 ;
  gwit (w : Gen) : Lau = w.2.2 ;

  GoodGen (w : Gen) : U l =
    NonNeg (gpoly w) * (HomP (gdeg w) (gpoly w) * Hom (negsuc (gdeg w)) (gwit w)) ;

  ------------------------------------------------------------------------
  -- one generator

  hom-cong (k k' : Int) (e : Id Int k k') (f : Lau) (h : Hom k f) : Hom k' f =
    subst (\ j -> Hom j f) e h ;
  hom-pi (k : Int) (f : Lau) (h : Hom k f) : Hom k (pi f) =
    \ m ne -> trans (ifB-cong (and (nx m) (and (ny m) (nz m))) (f m) D.z (h m ne)) (ifB-zero (and (nx m) (and (ny m) (nz m)))) ;

  -- g pi(q) has degree -1
  hom-gpi (w : Gen) (gw : GoodGen w) : Hom (negsuc zero) (mulP (gpoly w) (pi (gwit w))) =
    hom-cong (add (negsuc (gdeg w)) (pos (gdeg w))) (negsuc zero) (addP-negsuc (gdeg w))
      (mulP (gpoly w) (pi (gwit w)))
      (hom-mul (negsuc (gdeg w)) (gdeg w) (pi (gwit w)) (hom-pi (negsuc (gdeg w)) (gwit w) gw.2.2) (gpoly w) gw.2.1) ;

  -- delta1 sigma(q) = q - pi(q)
  d1-sigma (q : Lau) : EqL (d1 (sigma q)) (subL q (pi q)) =
    \ m -> trans (sym (add-sub-l (pi q m) (d1 (sigma q) m))) (ap (\ t -> D.add t (D.neg (pi q m))) (decomp q m)) ;

  -- the two parts of one generator
  uPart (w : Gen) : Tri = mulT (gpoly w) (sigma (gwit w)) ;
  bPart (w : Gen) : Tri = sigma (mulP (gpoly w) (pi (gwit w))) ;

  -- (x - y) + (y - 0) = x, written for the two parts
  part-sum (x y p : D.R) (hp : Id D.R p D.z) : Id D.R (D.add (D.add x (D.neg y)) (D.add y (D.neg p))) x =
    calc D.R { D.add (D.add x (D.neg y)) (D.add y (D.neg p))
                 =< ap (\ t -> D.add (D.add x (D.neg y)) (D.add y (D.neg t))) hp > D.add (D.add x (D.neg y)) (D.add y (D.neg D.z))
                 =< ap (D.add (D.add x (D.neg y))) (sub-z y) > D.add (D.add x (D.neg y)) y
                 =< sub-add x y > x } ;

  -- delta1 (g sigma(q) + sigma(g pi(q))) = g q
  d1-parts (w : Gen) (gw : GoodGen w) : EqL (d1 (addT (uPart w) (bPart w))) (mulP (gpoly w) (gwit w)) =
    \ m -> calc D.R {
      d1 (addT (uPart w) (bPart w)) m
        =< d1-add (uPart w) (bPart w) m > D.add (d1 (uPart w) m) (d1 (bPart w) m)
        =< DG.cong-add (trans (d1-mul (gpoly w) (sigma (gwit w)) m)
                          (trans (mulP-cong (gpoly w) (d1 (sigma (gwit w))) (subL (gwit w) (pi (gwit w))) (d1-sigma (gwit w)) m)
                                 (mulP-sub (gpoly w) (gwit w) (pi (gwit w)) m)))
                       (d1-sigma (mulP (gpoly w) (pi (gwit w))) m)
        > D.add (D.add (mulP (gpoly w) (gwit w) m) (D.neg (mulP (gpoly w) (pi (gwit w)) m)))
                (D.add (mulP (gpoly w) (pi (gwit w)) m) (D.neg (pi (mulP (gpoly w) (pi (gwit w))) m)))
        =< part-sum (mulP (gpoly w) (gwit w) m) (mulP (gpoly w) (pi (gwit w)) m)
             (pi (mulP (gpoly w) (pi (gwit w))) m)
             (pi-deg (mulP (gpoly w) (pi (gwit w))) (hom-gpi w gw) m)
        > mulP (gpoly w) (gwit w) m } ;

  ------------------------------------------------------------------------
  -- a finite list of generators

  sumJ : List Gen -> Lau = split {
    nil -> zeroL ;
    cons w ws | r -> addL (mulP (gpoly w) (gwit w)) r } ;
  uW : List Gen -> Tri = split {
    nil -> zeroT ;
    cons w ws | r -> addT (uPart w) r } ;
  bW : List Gen -> Tri = split {
    nil -> zeroT ;
    cons w ws | r -> addT (bPart w) r } ;
  GoodW : List Gen -> U l = split {
    nil -> Top ;
    cons w ws | r -> GoodGen w * r } ;

  -- (u + b) + (u' + b') = (u + u') + ... rearranged: delta1 is computed termwise
  d1-W : (ws : List Gen) -> GoodW ws -> EqL (d1 (addT (uW ws) (bW ws))) (sumJ ws) = split {
    nil -> \ gw m -> trans (d1-cong (addT zeroT zeroT) zeroT
                             (\ x -> D.addZ D.z, (\ x -> D.addZ D.z, \ x -> D.addZ D.z)) m) (d1-zero m) ;
    cons w ws | r -> \ gw m ->
      calc D.R {
        d1 (addT (uW (cons w ws)) (bW (cons w ws))) m
          =< d1-cong (addT (uW (cons w ws)) (bW (cons w ws))) (addT (addT (uPart w) (bPart w)) (addT (uW ws) (bW ws)))
               (\ x -> L.swap (t1 (uPart w) x) (t1 (uW ws) x) (t1 (bPart w) x) (t1 (bW ws) x),
                (\ x -> L.swap (t2 (uPart w) x) (t2 (uW ws) x) (t2 (bPart w) x) (t2 (bW ws) x),
                 \ x -> L.swap (t3 (uPart w) x) (t3 (uW ws) x) (t3 (bPart w) x) (t3 (bW ws) x))) m
          > d1 (addT (addT (uPart w) (bPart w)) (addT (uW ws) (bW ws))) m
          =< d1-add (addT (uPart w) (bPart w)) (addT (uW ws) (bW ws)) m
          > D.add (d1 (addT (uPart w) (bPart w)) m) (d1 (addT (uW ws) (bW ws)) m)
          =< DG.cong-add (d1-parts w gw.1 m) (r gw.2 m) > sumJ (cons w ws) m } } ;

  supp-uW : (ws : List Gen) -> GoodW ws -> Supp1 (uW ws) = split {
    nil -> \ gw -> supp1-zero ;
    cons w ws | r -> \ gw ->
      supp1-add (uPart w) (uW ws) (supp1-mul (gpoly w) gw.1.1 (sigma (gwit w)) (supp-sigma (gwit w))) (r gw.2) } ;
  supp-bW : (ws : List Gen) -> Supp1 (bW ws) = split {
    nil -> supp1-zero ;
    cons w ws | r -> supp1-add (bPart w) (bW ws) (supp-sigma (mulP (gpoly w) (pi (gwit w)))) r } ;

  ------------------------------------------------------------------------
  -- the generators sigma(g X^(expo t))

  mono (t : CM.N3) : Lau = \ m -> ifB (CM.isExpo t m) D.o ;
  genCoc (g : LPoly) (t : CM.N3) : Tri = sigma (mulP g (mono t)) ;

  -- X^(expo t) has degree -(size t)-3
  hom-mono-b (t : CM.N3) (k : Int) (e : Id Int (negsuc (suc (suc (CM.size t)))) k) (m : E3)
    (ne : LG.Not (Id Int (deg m) k)) : (bb : Bool) -> Id Bool (CM.isExpo t m) bb -> Id D.R (ifB bb D.o) D.z = split {
    true -> \ x -> P.absurd (Id D.R D.o D.z)
              (ne (trans (ap deg (CM.isExpo-sound t m x)) (trans (CMO.deg-expo t) e))) ;
    false -> \ x -> refl D.z } ;
  hom-mono (t : CM.N3) (k : Int) (e : Id Int (negsuc (suc (suc (CM.size t)))) k) : Hom k (mono t) =
    \ m ne -> hom-mono-b t k e m ne (CM.isExpo t m) (refl (CM.isExpo t m)) ;

  -- each generator is a cocycle modulo J:  delta1 sigma(g X^(expo t)) = g X^(expo t)
  gen-cocycle (g : LPoly) (d : Nat) (hg : HomP d g) (t : CM.N3) (e : Id Nat (suc (suc (CM.size t))) d) :
    EqL (d1 (genCoc g t)) (mulP g (mono t)) =
    \ m -> trans (d1-sigma (mulP g (mono t)) m)
             (trans (ap (\ y -> D.add (mulP g (mono t) m) (D.neg y))
                        (pi-deg (mulP g (mono t))
                           (hom-cong (add (negsuc d) (pos d)) (negsuc zero) (addP-negsuc d) (mulP g (mono t))
                              (hom-mul (negsuc d) d (mono t) (hom-mono t (negsuc d) (ap (\ k -> negsuc k) e)) g hg)) m))
                    (sub-z (mulP g (mono t) m))) ;

  -- finite sums of Laurent elements and of triples
  sumLau (ts : List CM.N3) (F : CM.N3 -> Lau) : Lau = \ m -> CMO.sumL CM.N3 (\ t -> F t m) ts ;
  sumT (ts : List CM.N3) (H : CM.N3 -> Tri) : Tri =
    mkT (sumLau ts (\ t -> t1 (H t))) (sumLau ts (\ t -> t2 (H t))) (sumLau ts (\ t -> t3 (H t))) ;

  mulP-sum (g : LPoly) (F : CM.N3 -> Lau) : (ts : List CM.N3) -> EqL (mulP g (sumLau ts F)) (sumLau ts (\ t -> mulP g (F t))) = split {
    nil -> mulP-zero g ;
    cons t ts | r -> \ m -> trans (mulP-add g (F t) (sumLau ts F) m) (ap (D.add (mulP g (F t) m)) (r m)) } ;
  sigma-sum (F : CM.N3 -> Lau) : (ts : List CM.N3) -> EqT (sigma (sumLau ts F)) (sumT ts (\ t -> sigma (F t))) = split {
    nil -> sigma-zero ;
    cons t ts | r ->
      ((\ m -> trans ((sigma-add (F t) (sumLau ts F)).1 m) (ap (D.add (t1 (sigma (F t)) m)) (r.1 m))),
       ((\ m -> trans ((sigma-add (F t) (sumLau ts F)).2.1 m) (ap (D.add (t2 (sigma (F t)) m)) (r.2.1 m))),
        (\ m -> trans ((sigma-add (F t) (sumLau ts F)).2.2 m) (ap (D.add (t3 (sigma (F t)) m)) (r.2.2 m))))) } ;
  sumT-cong (H H' : CM.N3 -> Tri) (e : (t : CM.N3) -> EqT (H t) (H' t)) (ts : List CM.N3) : EqT (sumT ts H) (sumT ts H') =
    (\ m -> CMO.sumL-cong CM.N3 (\ t -> t1 (H t) m) (\ t -> t1 (H' t) m) (\ t -> (e t).1 m) ts,
     (\ m -> CMO.sumL-cong CM.N3 (\ t -> t2 (H t) m) (\ t -> t2 (H' t) m) (\ t -> (e t).2.1 m) ts,
      \ m -> CMO.sumL-cong CM.N3 (\ t -> t3 (H t) m) (\ t -> t3 (H' t) m) (\ t -> (e t).2.2 m) ts)) ;

  -- the coefficients q(expo t) of one generator
  genSum (w : Gen) : Tri = sumT (CM.gens (gdeg w)) (\ t -> scaleT (gwit w (CM.expo t)) (genCoc (gpoly w) t)) ;

  -- sigma(g pi(q)) = sum_{t in gens d} q(expo t) sigma(g X^(expo t))
  bPart-gens (w : Gen) (gw : GoodGen w) : EqT (bPart w) (genSum w) =
    eqT-trans (bPart w) (sigma (sumLau (CM.gens (gdeg w)) (\ t -> scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t))))) (genSum w)
      (sigma-cong (mulP (gpoly w) (pi (gwit w))) (sumLau (CM.gens (gdeg w)) (\ t -> scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t))))
        (\ m -> trans (mulP-cong (gpoly w) (pi (gwit w)) (sumLau (CM.gens (gdeg w)) (\ t -> scaleL (gwit w (CM.expo t)) (mono t)))
                          (CMO.pi-gens (gdeg w) (gwit w) gw.2.2) m)
                 (trans (mulP-sum (gpoly w) (\ t -> scaleL (gwit w (CM.expo t)) (mono t)) (CM.gens (gdeg w)) m)
                        (CMO.sumL-cong CM.N3 (\ t -> mulP (gpoly w) (scaleL (gwit w (CM.expo t)) (mono t)) m)
                           (\ t -> scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t)) m)
                           (\ t -> mulP-scale (gpoly w) (gwit w (CM.expo t)) (mono t) m) (CM.gens (gdeg w))))))
      (eqT-trans (sigma (sumLau (CM.gens (gdeg w)) (\ t -> scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t)))))
         (sumT (CM.gens (gdeg w)) (\ t -> sigma (scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t))))) (genSum w)
         (sigma-sum (\ t -> scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t))) (CM.gens (gdeg w)))
         (sumT-cong (\ t -> sigma (scaleL (gwit w (CM.expo t)) (mulP (gpoly w) (mono t))))
            (\ t -> scaleT (gwit w (CM.expo t)) (genCoc (gpoly w) t))
            (\ t -> sigma-scale (gwit w (CM.expo t)) (mulP (gpoly w) (mono t))) (CM.gens (gdeg w)))) ;

  genW : List Gen -> Tri = split {
    nil -> zeroT ;
    cons w ws | r -> addT (genSum w) r } ;
  bW-gens : (ws : List Gen) -> GoodW ws -> EqT (bW ws) (genW ws) = split {
    nil -> \ gw -> eqT-refl zeroT ;
    cons w ws | r -> \ gw ->
      (\ m -> DG.cong-add ((bPart-gens w gw.1).1 m) ((r gw.2).1 m),
       (\ m -> DG.cong-add ((bPart-gens w gw.1).2.1 m) ((r gw.2).2.1 m),
        \ m -> DG.cong-add ((bPart-gens w gw.1).2.2 m) ((r gw.2).2.2 m))) } ;

  ------------------------------------------------------------------------
  -- the theorem

  module Reduce (ws : List Gen) (gw : GoodW ws) (b : Tri) (sb : Supp1 b)
    (cocycle : EqL (d1 b) (sumJ ws)) {
    -- the part in J C^1, and b*
    u : Tri = uW ws ;
    bstar : Tri = bW ws ;
    diff : Tri = subT b (addT u bstar) ;

    closed : EqL (d1 diff) zeroL =
      \ m -> trans (d1-sub b (addT u bstar) m)
               (trans (DG.cong-add (cocycle m) (ap D.neg (d1-W ws gw m))) (D.addN (sumJ ws m))) ;
    supp-diff : Supp1 diff = supp1-sub b (addT u bstar) sb (supp1-add u bstar (supp-uW ws gw) (supp-bW ws)) ;

    c : Tri = tau diff ;
    -- delta0 c = b - (u + b*)
    boundary : EqT (d0 c) diff = contraction diff supp-diff closed ;

    -- b = (u + b*) + delta0 c
    reduce : EqT b (addT (addT u bstar) (d0 c)) =
      (\ m -> trans (sym (sub-add-l (t1 b m) (t1 (addT u bstar) m))) (ap (D.add (t1 (addT u bstar) m)) (sym (boundary.1 m))),
       (\ m -> trans (sym (sub-add-l (t2 b m) (t2 (addT u bstar) m))) (ap (D.add (t2 (addT u bstar) m)) (sym (boundary.2.1 m))),
        \ m -> trans (sym (sub-add-l (t3 b m) (t3 (addT u bstar) m))) (ap (D.add (t3 (addT u bstar) m)) (sym (boundary.2.2 m))))) ;
    -- the explicit generators: b = (sum_j g_j sigma(q_j)) + sum_j sum_t q_j(expo t) sigma(g_j X^(expo t)) + delta0 c
    generators : Tri = genW ws ;
    generation : EqT b (addT (addT u generators) (d0 c)) =
      eqT-trans b (addT (addT u bstar) (d0 c)) (addT (addT u generators) (d0 c)) reduce
        (\ m -> ap (\ y -> D.add (D.add (t1 u m) y) (t1 (d0 c) m)) ((bW-gens ws gw).1 m),
         (\ m -> ap (\ y -> D.add (D.add (t2 u m) y) (t2 (d0 c) m)) ((bW-gens ws gw).2.1 m),
          \ m -> ap (\ y -> D.add (D.add (t3 u m) y) (t3 (d0 c) m)) ((bW-gens ws gw).2.2 m))) ;
  } ;
} ;
