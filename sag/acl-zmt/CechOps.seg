-- CechOps.seg: the linear maps of the Cech model and the congruences
-- (acl-zmt-formalisation.tex, Lemme modele (1); Liste item 3).
--
-- sigma, tau, pi (CechContraction), the products by a polynomial g
-- (nonnegative exponents, every term of degree k'), delta0 and the
-- evaluation at an exponent are linear on the function modules lmod and
-- tmod of CechModules, and they preserve the conditions: degrees (shifted
-- by k' for g), supports, finite support.  sigma and tau and pi are
-- pointwise additive maps (CechModules.van-point, LaurentList.Point); tau
-- always lands in the 0-cochains with the support conditions.
--
-- The congruences.  For lists P, Q (the two equations), NW P Q kP kQ b says
-- b = P U + Q V componentwise with U, V cochains of degrees kP, kQ (with
-- supports and finite support): the submodule N^j of the note, with the
-- witnesses.  It is a submodule (Sub of ReesLiftingCong), for 1-cochains
-- (S1 witnesses) and for 0-cochains (S0 witnesses).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module IP = IdealPowers[l] ; module RC = ReesLiftingCong[l] ;

-- Boolean facts for the selections
not-t (b : Bool) (e : Id Bool b true) : Id Bool (not b) false = ap not e ;
and-f-l (b c : Bool) (e : Id Bool b false) : Id Bool (and b c) false = subst (\ x -> Id Bool (and x c) false) (sym e) (refl false) ;
and-f-r : (b c : Bool) -> Id Bool c false -> Id Bool (and b c) false = split {
  true -> \ c e -> e ; false -> \ c e -> refl false } ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module LO = Laurent3[l].Over[D] ; open LO ;
  module CO = Cech3[l].Over[D] ;
  module CC = CechContraction[l].Over[D] ;
  module LL = LaurentList[l].Over[D] ;
  module CMd = CechModules[l].Over[D,setD] ; open CMd ;

  ifB-at-false (b : Bool) (e : Id Bool b false) (v : D.R) : Id D.R (ifB b v) D.z =
    trans (ap (\ x -> ifB x v) e) (refl D.z) ;

  ------------------------------------------------------------------------
  -- sigma

  phXY (m : E3) (v : D.R) : D.R = CC.selXY (CC.nx m) (CC.ny m) (CC.nz m) v ;
  phXZ (m : E3) (v : D.R) : D.R = CC.selXZ (CC.nx m) (CC.ny m) (CC.nz m) v ;
  phYZ (m : E3) (v : D.R) : D.R = CC.selYZ (CC.nx m) (CC.ny m) (CC.nz m) v ;
  phPi (m : E3) (v : D.R) : D.R = CC.selPi (CC.nx m) (CC.ny m) (CC.nz m) v ;
  -- ifB b (-v), additively
  ifBn-add (b : Bool) (u v : D.R) : Id D.R (ifB b (D.neg (D.add u v))) (D.add (ifB b (D.neg u)) (ifB b (D.neg v))) =
    trans (CC.ifB-cong b (D.neg (D.add u v)) (D.add (D.neg u) (D.neg v)) (L.neg-add u v)) (CC.ifB-add b (D.neg u) (D.neg v)) ;
  ifBn-zero (b : Bool) : Id D.R (ifB b (D.neg D.z)) D.z = trans (CC.ifB-cong b (D.neg D.z) D.z L.neg-zero) (CC.ifB-zero b) ;
  phXY-add (m : E3) (u v : D.R) : Id D.R (phXY m (D.add u v)) (D.add (phXY m u) (phXY m v)) = CC.ifB-add (and (CC.nx m) (and (CC.ny m) (not (CC.nz m)))) u v ;
  phXZ-add (m : E3) (u v : D.R) : Id D.R (phXZ m (D.add u v)) (D.add (phXZ m u) (phXZ m v)) = ifBn-add (and (CC.nx m) (not (CC.ny m))) u v ;
  phYZ-add (m : E3) (u v : D.R) : Id D.R (phYZ m (D.add u v)) (D.add (phYZ m u) (phYZ m v)) = CC.ifB-add (not (CC.nx m)) u v ;
  phPi-add (m : E3) (u v : D.R) : Id D.R (phPi m (D.add u v)) (D.add (phPi m u) (phPi m v)) = CC.ifB-add (and (CC.nx m) (and (CC.ny m) (CC.nz m))) u v ;
  phXY-0 (m : E3) : Id D.R (phXY m D.z) D.z = CC.ifB-zero (and (CC.nx m) (and (CC.ny m) (not (CC.nz m)))) ;
  phXZ-0 (m : E3) : Id D.R (phXZ m D.z) D.z = ifBn-zero (and (CC.nx m) (not (CC.ny m))) ;
  phYZ-0 (m : E3) : Id D.R (phYZ m D.z) D.z = CC.ifB-zero (not (CC.nx m)) ;
  phPi-0 (m : E3) : Id D.R (phPi m D.z) D.z = CC.ifB-zero (and (CC.nx m) (and (CC.ny m) (CC.nz m))) ;

  sigmaL : IP.Lin[D,lmod,tmod] = linLT CC.sigma CC.sigma-add CC.sigma-scale ;
  sigma-pres (k : Int) (f : Lau) (h : SL k f) : S1 k (CC.sigma f) =
    (CC.supp-sigma f,
     ((van-point (CH k) phXY phXY-0 f h.1, (van-point (CH k) phXZ phXZ-0 f h.1, van-point (CH k) phYZ phYZ-0 f h.1)),
      (LL.Point[phXY,phXY-add].fin-point f h.2, (LL.Point[phXZ,phXZ-add].fin-point f h.2, LL.Point[phYZ,phYZ-add].fin-point f h.2)))) ;
  sigmaS (k : Int) : IP.Lin[D,ML[k].S.mod,M1[k].S.mod] =
    M1[k].S.into ML[k].S.mod (CechModules[l].comp D ML[k].S.mod lmod tmod ML[k].S.incl sigmaL) (\ x -> sigma-pres k x.1 x.2) ;

  ------------------------------------------------------------------------
  -- pi

  pi-add (f g : Lau) : EqL (CC.pi (addL f g)) (addL (CC.pi f) (CC.pi g)) = \ m -> phPi-add m (f m) (g m) ;
  pi-scale (c : D.R) (f : Lau) : EqL (CC.pi (scaleL c f)) (scaleL c (CC.pi f)) =
    \ m -> CC.ifB-scale (and (CC.nx m) (and (CC.ny m) (CC.nz m))) c (f m) ;
  piL : IP.Lin[D,lmod,lmod] = linL CC.pi pi-add pi-scale ;
  pi-pres (k : Int) (f : Lau) (h : SL k f) : SL k (CC.pi f) =
    (van-point (CH k) phPi phPi-0 f h.1, LL.Point[phPi,phPi-add].fin-point f h.2) ;
  piS (k : Int) : IP.Lin[D,ML[k].S.mod,ML[k].S.mod] =
    ML[k].S.into ML[k].S.mod (CechModules[l].comp D ML[k].S.mod lmod lmod ML[k].S.incl piL) (\ x -> pi-pres k x.1 x.2) ;

  ------------------------------------------------------------------------
  -- tau

  phX (m : E3) (v : D.R) : D.R = CC.selX (CC.nx m) (CC.ny m) (CC.nz m) v ;
  phY (m : E3) (v : D.R) : D.R = CC.selY (CC.nx m) (CC.ny m) (CC.nz m) v ;
  phZ (m : E3) (v : D.R) : D.R = CC.selZ (CC.nx m) (CC.ny m) (CC.nz m) v ;
  phX-add (m : E3) (u v : D.R) : Id D.R (phX m (D.add u v)) (D.add (phX m u) (phX m v)) = ifBn-add (and (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m)))) u v ;
  phY-add (m : E3) (u v : D.R) : Id D.R (phY m (D.add u v)) (D.add (phY m u) (phY m v)) = CC.ifB-add (and (not (CC.nx m)) (not (CC.nz m))) u v ;
  phZ-add (m : E3) (u v : D.R) : Id D.R (phZ m (D.add u v)) (D.add (phZ m u) (phZ m v)) = CC.ifB-add (and (not (CC.nx m)) (not (CC.ny m))) u v ;
  phX-0 (m : E3) : Id D.R (phX m D.z) D.z = ifBn-zero (and (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m)))) ;
  phY-0 (m : E3) : Id D.R (phY m D.z) D.z = CC.ifB-zero (and (not (CC.nx m)) (not (CC.nz m))) ;
  phZ-0 (m : E3) : Id D.R (phZ m D.z) D.z = CC.ifB-zero (and (not (CC.nx m)) (not (CC.ny m))) ;
  phX-scale (m : E3) (c v : D.R) : Id D.R (phX m (D.mul c v)) (D.mul c (phX m v)) =
    trans (CC.ifB-cong (and (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m)))) (D.neg (D.mul c v)) (D.mul c (D.neg v)) (sym (L.mul-neg c v)))
          (CC.ifB-scale (and (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m)))) c (D.neg v)) ;
  phY-scale (m : E3) (c v : D.R) : Id D.R (phY m (D.mul c v)) (D.mul c (phY m v)) = CC.ifB-scale (and (not (CC.nx m)) (not (CC.nz m))) c v ;
  phZ-scale (m : E3) (c v : D.R) : Id D.R (phZ m (D.mul c v)) (D.mul c (phZ m v)) = CC.ifB-scale (and (not (CC.nx m)) (not (CC.ny m))) c v ;

  tau-add (u v : CO.Tri) : CO.EqT (CC.tau (CO.addT u v)) (CO.addT (CC.tau u) (CC.tau v)) =
    (\ m -> phX-add m (CO.t1 u m) (CO.t1 v m), (\ m -> phY-add m (CO.t1 u m) (CO.t1 v m), \ m -> phZ-add m (CO.t2 u m) (CO.t2 v m))) ;
  tau-scale (c : D.R) (u : CO.Tri) : CO.EqT (CC.tau (CO.scaleT c u)) (CO.scaleT c (CC.tau u)) =
    (\ m -> phX-scale m c (CO.t1 u m), (\ m -> phY-scale m c (CO.t1 u m), \ m -> phZ-scale m c (CO.t2 u m))) ;
  tauL : IP.Lin[D,tmod,tmod] = linT CC.tau tau-add tau-scale ;

  -- tau(b) satisfies the support conditions of a 0-cochain, for every b
  tau-supp0 (b : CO.Tri) : CO.Supp0 (CC.tau b) =
    ((\ m e -> ifB-at-false (and (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m))))
                 (and-f-r (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m))) (and-f-l (not (CC.ny m)) (not (CC.nz m)) (not-t (CC.ny m) e))) (D.neg (CO.t1 b m)),
      \ m e -> ifB-at-false (and (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m))))
                 (and-f-r (CC.nx m) (and (not (CC.ny m)) (not (CC.nz m))) (and-f-r (not (CC.ny m)) (not (CC.nz m)) (not-t (CC.nz m) e))) (D.neg (CO.t1 b m))),
     ((\ m e -> ifB-at-false (and (not (CC.nx m)) (not (CC.nz m))) (and-f-l (not (CC.nx m)) (not (CC.nz m)) (not-t (CC.nx m) e)) (CO.t1 b m),
       \ m e -> ifB-at-false (and (not (CC.nx m)) (not (CC.nz m))) (and-f-r (not (CC.nx m)) (not (CC.nz m)) (not-t (CC.nz m) e)) (CO.t1 b m)),
      (\ m e -> ifB-at-false (and (not (CC.nx m)) (not (CC.ny m))) (and-f-l (not (CC.nx m)) (not (CC.ny m)) (not-t (CC.nx m) e)) (CO.t2 b m),
       \ m e -> ifB-at-false (and (not (CC.nx m)) (not (CC.ny m))) (and-f-r (not (CC.nx m)) (not (CC.ny m)) (not-t (CC.ny m) e)) (CO.t2 b m)))) ;
  tau-homT (k : Int) (b : CO.Tri) (h : HomT k b) : HomT k (CC.tau b) =
    (van-point (CH k) phX phX-0 (CO.t1 b) h.1, (van-point (CH k) phY phY-0 (CO.t1 b) h.1, van-point (CH k) phZ phZ-0 (CO.t2 b) h.2.1)) ;
  tau-finT (b : CO.Tri) (h : FinT b) : FinT (CC.tau b) =
    (LL.Point[phX,phX-add].fin-point (CO.t1 b) h.1, (LL.Point[phY,phY-add].fin-point (CO.t1 b) h.1, LL.Point[phZ,phZ-add].fin-point (CO.t2 b) h.2.1)) ;
  tau-pres (k : Int) (b : CO.Tri) (h : S1 k b) : S0 k (CC.tau b) = (tau-supp0 b, (tau-homT k b h.2.1, tau-finT b h.2.2)) ;
  tauS (k : Int) : IP.Lin[D,M1[k].S.mod,M0[k].S.mod] =
    M0[k].S.into M1[k].S.mod (CechModules[l].comp D M1[k].S.mod tmod tmod M1[k].S.incl tauL) (\ x -> tau-pres k x.1 x.2) ;

  ------------------------------------------------------------------------
  -- products by a polynomial

  mulPL (g : LPoly) : IP.Lin[D,lmod,lmod] = linL (mulP g) (mulP-add g) (\ c f -> mulP-scale g c f) ;
  mulT-add (g : LPoly) (u v : CO.Tri) : CO.EqT (CO.mulT g (CO.addT u v)) (CO.addT (CO.mulT g u) (CO.mulT g v)) =
    (mulP-add g (CO.t1 u) (CO.t1 v), (mulP-add g (CO.t2 u) (CO.t2 v), mulP-add g (CO.t3 u) (CO.t3 v))) ;
  mulT-scale (g : LPoly) (c : D.R) (u : CO.Tri) : CO.EqT (CO.mulT g (CO.scaleT c u)) (CO.scaleT c (CO.mulT g u)) =
    (mulP-scale g c (CO.t1 u), (mulP-scale g c (CO.t2 u), mulP-scale g c (CO.t3 u))) ;
  mulTL (g : LPoly) : IP.Lin[D,tmod,tmod] = linT (CO.mulT g) (mulT-add g) (mulT-scale g) ;

  mulP-pres (k k' : Int) (g : LPoly) (pg : IsPoly k' g) (f : Lau) (h : SL k f) : SL (add k k') (mulP g f) =
    (hom-mulI k k' f h.1 g pg.2.2.2, LL.fin-mulP g f h.2) ;
  homT-mul (k k' : Int) (g : LPoly) (pg : IsPoly k' g) (u : CO.Tri) (h : HomT k u) : HomT (add k k') (CO.mulT g u) =
    (hom-mulI k k' (CO.t1 u) h.1 g pg.2.2.2, (hom-mulI k k' (CO.t2 u) h.2.1 g pg.2.2.2, hom-mulI k k' (CO.t3 u) h.2.2 g pg.2.2.2)) ;
  finT-mul (g : LPoly) (u : CO.Tri) (h : FinT u) : FinT (CO.mulT g u) =
    (LL.fin-mulP g (CO.t1 u) h.1, (LL.fin-mulP g (CO.t2 u) h.2.1, LL.fin-mulP g (CO.t3 u) h.2.2)) ;
  supp1-mulT (k' : Int) (g : LPoly) (pg : IsPoly k' g) (u : CO.Tri) (h : CO.Supp1 u) : CO.Supp1 (CO.mulT g u) =
    (nnz-mulZ g pg.2.2.1 (CO.t1 u) h.1, (nny-mulY g pg.2.1 (CO.t2 u) h.2.1, nnx-mulX g pg.1 (CO.t3 u) h.2.2)) ;
  supp0-mulT (k' : Int) (g : LPoly) (pg : IsPoly k' g) (u : CO.Tri) (h : CO.Supp0 u) : CO.Supp0 (CO.mulT g u) =
    ((nny-mulY g pg.2.1 (CO.t1 u) h.1.1, nnz-mulZ g pg.2.2.1 (CO.t1 u) h.1.2),
     ((nnx-mulX g pg.1 (CO.t2 u) h.2.1.1, nnz-mulZ g pg.2.2.1 (CO.t2 u) h.2.1.2),
      (nnx-mulX g pg.1 (CO.t3 u) h.2.2.1, nny-mulY g pg.2.1 (CO.t3 u) h.2.2.2))) ;
  mulSL (k k' : Int) (g : LPoly) (pg : IsPoly k' g) : IP.Lin[D,ML[k].S.mod,ML[add k k'].S.mod] =
    ML[add k k'].S.into ML[k].S.mod (CechModules[l].comp D ML[k].S.mod lmod lmod ML[k].S.incl (mulPL g)) (\ x -> mulP-pres k k' g pg x.1 x.2) ;
  mulS1 (k k' : Int) (g : LPoly) (pg : IsPoly k' g) : IP.Lin[D,M1[k].S.mod,M1[add k k'].S.mod] =
    M1[add k k'].S.into M1[k].S.mod (CechModules[l].comp D M1[k].S.mod tmod tmod M1[k].S.incl (mulTL g))
      (\ x -> (supp1-mulT k' g pg x.1 x.2.1, (homT-mul k k' g pg x.1 x.2.2.1, finT-mul g x.1 x.2.2.2))) ;
  mulS0 (k k' : Int) (g : LPoly) (pg : IsPoly k' g) : IP.Lin[D,M0[k].S.mod,M0[add k k'].S.mod] =
    M0[add k k'].S.into M0[k].S.mod (CechModules[l].comp D M0[k].S.mod tmod tmod M0[k].S.incl (mulTL g))
      (\ x -> (supp0-mulT k' g pg x.1 x.2.1, (homT-mul k k' g pg x.1 x.2.2.1, finT-mul g x.1 x.2.2.2))) ;

  ------------------------------------------------------------------------
  -- delta0 and the evaluation at an exponent

  d0-add (u v : CO.Tri) : CO.EqT (CO.d0 (CO.addT u v)) (CO.addT (CO.d0 u) (CO.d0 v)) =
    (\ m -> sym (CO.sub-pair (CO.t2 u m) (CO.t1 u m) (CO.t2 v m) (CO.t1 v m)),
     (\ m -> sym (CO.sub-pair (CO.t3 u m) (CO.t1 u m) (CO.t3 v m) (CO.t1 v m)),
      \ m -> sym (CO.sub-pair (CO.t3 u m) (CO.t2 u m) (CO.t3 v m) (CO.t2 v m)))) ;
  sub-scale (c x y : D.R) : Id D.R (D.add (D.mul c x) (D.neg (D.mul c y))) (D.mul c (D.add x (D.neg y))) =
    trans (ap (D.add (D.mul c x)) (sym (L.mul-neg c y))) (sym (D.dist c x (D.neg y))) ;
  d0-scale (c : D.R) (u : CO.Tri) : CO.EqT (CO.d0 (CO.scaleT c u)) (CO.scaleT c (CO.d0 u)) =
    (\ m -> sub-scale c (CO.t2 u m) (CO.t1 u m), (\ m -> sub-scale c (CO.t3 u m) (CO.t1 u m), \ m -> sub-scale c (CO.t3 u m) (CO.t2 u m))) ;
  d0L : IP.Lin[D,tmod,tmod] = linT CO.d0 d0-add d0-scale ;
  evalL (m0 : E3) : IP.Lin[D,lmod,IP.regular D] =
    IP.mkLin D lmod (IP.regular D) (\ f -> f m0) (\ f g -> refl (D.add (f m0) (g m0))) (\ c f -> refl (D.mul c (f m0))) ;
  evalS (k : Int) (m0 : E3) : IP.Lin[D,ML[k].S.mod,IP.regular D] =
    CechModules[l].comp D ML[k].S.mod lmod (IP.regular D) ML[k].S.incl (evalL m0) ;

  ------------------------------------------------------------------------
  -- the congruences:  b = P U + Q V  with witnesses

  -- (p u + q v) + (p u' + q v') = p (u + u') + q (v + v'), pointwise
  pq-add (pu qv pu' qv' : D.R) :
    Id D.R (D.add (D.add pu qv) (D.add pu' qv')) (D.add (D.add pu pu') (D.add qv qv')) = L.swap pu qv pu' qv' ;

  module NW (Wit : Int -> CO.Tri -> U l)
    (w-zero : (k : Int) -> Wit k CO.zeroT)
    (w-add : (k : Int) (u v : CO.Tri) -> Wit k u -> Wit k v -> Wit k (CO.addT u v))
    (w-neg : (k : Int) (u : CO.Tri) -> Wit k u -> Wit k (negT u))
    (w-sm : (k : Int) (c : D.R) (u : CO.Tri) -> Wit k u -> Wit k (CO.scaleT c u))
    (P Q : LPoly) (kP kQ : Int) {
    comb (Wu Wv : CO.Tri) : CO.Tri = CO.addT (CO.mulT P Wu) (CO.mulT Q Wv) ;
    N (b : CO.Tri) : U l = (Wu : CO.Tri) * ((Wv : CO.Tri) * (Wit kP Wu * (Wit kQ Wv * CO.EqT b (comb Wu Wv)))) ;
    pt-zero (p q : LPoly) (Wu Wv : CO.Tri) (h : CO.EqT Wu CO.zeroT) (h' : CO.EqT Wv CO.zeroT) : CO.EqT CO.zeroT (CO.addT (CO.mulT p Wu) (CO.mulT q Wv)) =
      (\ m -> sym (trans (CO.vanish-add (mulP p (CO.t1 Wu) m) (mulP q (CO.t1 Wv) m)
                   (trans (mulP-cong p (CO.t1 Wu) zeroL h.1 m) (mulP-zero p m)) (trans (mulP-cong q (CO.t1 Wv) zeroL h'.1 m) (mulP-zero q m))) (refl D.z)),
       (\ m -> sym (CO.vanish-add (mulP p (CO.t2 Wu) m) (mulP q (CO.t2 Wv) m)
                   (trans (mulP-cong p (CO.t2 Wu) zeroL h.2.1 m) (mulP-zero p m)) (trans (mulP-cong q (CO.t2 Wv) zeroL h'.2.1 m) (mulP-zero q m))),
        \ m -> sym (CO.vanish-add (mulP p (CO.t3 Wu) m) (mulP q (CO.t3 Wv) m)
                   (trans (mulP-cong p (CO.t3 Wu) zeroL h.2.2 m) (mulP-zero p m)) (trans (mulP-cong q (CO.t3 Wv) zeroL h'.2.2 m) (mulP-zero q m))))) ;
    -- one component
    c-add (p q : LPoly) (Wu Wv Wu2 Wv2 : Lau) (x x' : Lau) (e : EqL x (addL (mulP p Wu) (mulP q Wv))) (e' : EqL x' (addL (mulP p Wu2) (mulP q Wv2))) :
      EqL (addL x x') (addL (mulP p (addL Wu Wu2)) (mulP q (addL Wv Wv2))) =
      \ m -> trans (DG.cong-add (e m) (e' m))
               (trans (pq-add (mulP p Wu m) (mulP q Wv m) (mulP p Wu2 m) (mulP q Wv2 m))
                      (sym (DG.cong-add (mulP-add p Wu Wu2 m) (mulP-add q Wv Wv2 m)))) ;
    c-neg (p q : LPoly) (Wu Wv : Lau) (x : Lau) (e : EqL x (addL (mulP p Wu) (mulP q Wv))) :
      EqL (negL x) (addL (mulP p (negL Wu)) (mulP q (negL Wv))) =
      \ m -> trans (ap D.neg (e m)) (trans (L.neg-add (mulP p Wu m) (mulP q Wv m)) (sym (DG.cong-add (mulP-neg p Wu m) (mulP-neg q Wv m)))) ;
    c-sm (p q : LPoly) (c : D.R) (Wu Wv : Lau) (x : Lau) (e : EqL x (addL (mulP p Wu) (mulP q Wv))) :
      EqL (scaleL c x) (addL (mulP p (scaleL c Wu)) (mulP q (scaleL c Wv))) =
      \ m -> trans (ap (D.mul c) (e m)) (trans (D.dist c (mulP p Wu m) (mulP q Wv m)) (sym (DG.cong-add (mulP-scale p c Wu m) (mulP-scale q c Wv m)))) ;
    sub : RC.Sub[D,tmod] = RC.mkSub D tmod N
      (CO.zeroT, (CO.zeroT, (w-zero kP, (w-zero kQ, pt-zero P Q CO.zeroT CO.zeroT (CO.eqT-refl CO.zeroT) (CO.eqT-refl CO.zeroT)))))
      (\ x y hx hy -> (CO.addT hx.1 hy.1, (CO.addT hx.2.1 hy.2.1, (w-add kP hx.1 hy.1 hx.2.2.1 hy.2.2.1, (w-add kQ hx.2.1 hy.2.1 hx.2.2.2.1 hy.2.2.2.1,
         (c-add P Q (CO.t1 hx.1) (CO.t1 hx.2.1) (CO.t1 hy.1) (CO.t1 hy.2.1) (CO.t1 x) (CO.t1 y) hx.2.2.2.2.1 hy.2.2.2.2.1,
          (c-add P Q (CO.t2 hx.1) (CO.t2 hx.2.1) (CO.t2 hy.1) (CO.t2 hy.2.1) (CO.t2 x) (CO.t2 y) hx.2.2.2.2.2.1 hy.2.2.2.2.2.1,
           c-add P Q (CO.t3 hx.1) (CO.t3 hx.2.1) (CO.t3 hy.1) (CO.t3 hy.2.1) (CO.t3 x) (CO.t3 y) hx.2.2.2.2.2.2 hy.2.2.2.2.2.2)))))))
      (\ x hx -> (negT hx.1, (negT hx.2.1, (w-neg kP hx.1 hx.2.2.1, (w-neg kQ hx.2.1 hx.2.2.2.1,
         (c-neg P Q (CO.t1 hx.1) (CO.t1 hx.2.1) (CO.t1 x) hx.2.2.2.2.1,
          (c-neg P Q (CO.t2 hx.1) (CO.t2 hx.2.1) (CO.t2 x) hx.2.2.2.2.2.1,
           c-neg P Q (CO.t3 hx.1) (CO.t3 hx.2.1) (CO.t3 x) hx.2.2.2.2.2.2)))))))
      (\ c x hx -> (CO.scaleT c hx.1, (CO.scaleT c hx.2.1, (w-sm kP c hx.1 hx.2.2.1, (w-sm kQ c hx.2.1 hx.2.2.2.1,
         (c-sm P Q c (CO.t1 hx.1) (CO.t1 hx.2.1) (CO.t1 x) hx.2.2.2.2.1,
          (c-sm P Q c (CO.t2 hx.1) (CO.t2 hx.2.1) (CO.t2 x) hx.2.2.2.2.2.1,
           c-sm P Q c (CO.t3 hx.1) (CO.t3 hx.2.1) (CO.t3 x) hx.2.2.2.2.2.2))))))) ;
  } ;

  -- the witnesses: 1-cochains (for N^1) and 0-cochains (for N^0)
  s1-zero (k : Int) : S1 k CO.zeroT = (CO.supp1-zero, (homT-zero k, finT-zero)) ;
  s1-add (k : Int) (u v : CO.Tri) (hu : S1 k u) (hv : S1 k v) : S1 k (CO.addT u v) =
    (CO.supp1-add u v hu.1 hv.1, (homT-add k u v hu.2.1 hv.2.1, finT-add u v hu.2.2 hv.2.2)) ;
  s1-neg (k : Int) (u : CO.Tri) (hu : S1 k u) : S1 k (negT u) = (supp1-neg u hu.1, (homT-neg k u hu.2.1, finT-neg u hu.2.2)) ;
  s1-sm (k : Int) (c : D.R) (u : CO.Tri) (hu : S1 k u) : S1 k (CO.scaleT c u) = (supp1-sm c u hu.1, (homT-sm k c u hu.2.1, finT-sm c u hu.2.2)) ;
  s0-zero (k : Int) : S0 k CO.zeroT = (supp0-zero, (homT-zero k, finT-zero)) ;
  s0-add (k : Int) (u v : CO.Tri) (hu : S0 k u) (hv : S0 k v) : S0 k (CO.addT u v) =
    (supp0-add u v hu.1 hv.1, (homT-add k u v hu.2.1 hv.2.1, finT-add u v hu.2.2 hv.2.2)) ;
  s0-neg (k : Int) (u : CO.Tri) (hu : S0 k u) : S0 k (negT u) = (supp0-neg u hu.1, (homT-neg k u hu.2.1, finT-neg u hu.2.2)) ;
  s0-sm (k : Int) (c : D.R) (u : CO.Tri) (hu : S0 k u) : S0 k (CO.scaleT c u) = (supp0-sm c u hu.1, (homT-sm k c u hu.2.1, finT-sm c u hu.2.2)) ;
} ;
