-- ACLFinalGeneral.seg: the example of ACL §4.4 by the GENERAL route of
-- ACLGeneral: the datum (S0)/(S1) comes from the gcd library (sag/gcd: gcd
-- of P, Q in k[b][a][X][Y][Z], homogeneous divisors, Laurent bridge), not
-- from the specific proof of ACLS1.  The gcd computed is a unit times 1;
-- nothing about it is used beyond HomLambda.Data.  For k a discrete field
-- (with 1 /= 0), A = k[b][a],
--     p = x - a + b x y + 2 b x^2 ,   q = y - b + a x^2 + a x y + b y^2 ,
-- for every ring map A -> L and x, y in L with p(x,y) = q(x,y) = 0 there
-- merely is s in L with  s = 1 + a r + b t  and s, s x, s y roots of monic
-- polynomials over A.  ACHIEVED: every hypothesis is discharged.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module PE = PolyExpr[l] ; module AD = ACLExampleData[l] ;

module Over (k : CRing) (setk : Pr.isSet k.R)
  (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o))
  (one-nonzero : Not (Id k.R k.o k.z)) {
  module F = ACLFinal[l].Over[k,setk,dec] ;
  module IT = Iterate[l].Over[k,setk,dec,one-nonzero] ;
  A : CRing = F.A ;
  setA : Pr.isSet A.R = F.S.setA ;
  a : A.R = F.S.a ;
  b : A.R = F.S.b ;
  G : GcdDomain[l].GcdDomain[A] = IT.gcdA ;
  module DA = ACLCech[l].Data[A,setA,a,b] ;
  module FA = DA.FA ;
  module LL = LaurentList[l].Over[A] ;
  two : Int = DA.two ;
  -- the coefficient 1 of XZ in P (of YZ in Q) is not 0
  o4 : Id A.R (A.add A.o (A.add A.z (A.add A.z (A.add A.z A.z)))) A.o =
   trans (ap (A.add A.o) (trans (ap (A.add A.z) (trans (ap (A.add A.z) (A.addZ A.z)) (A.addZ A.z))) (A.addZ A.z))) (A.addZ A.o) ;
  o5 : Id A.R (A.add A.o (A.add A.z (A.add A.z (A.add A.z (A.add A.z A.z))))) A.o =
   trans (ap (A.add A.o) (trans (ap (A.add A.z) (trans (ap (A.add A.z) (trans (ap (A.add A.z) (A.addZ A.z)) (A.addZ A.z))) (A.addZ A.z))) (A.addZ A.z))) (A.addZ A.o) ;
  nP0 : Not (Id A.R (LL.coef DA.PlP FA.muP) A.z) = \ e -> G.nontrivial (trans (sym o4) e) ;
  nQ0 : Not (Id A.R (LL.coef DA.PlQ FA.muQ) A.z) = \ e -> G.nontrivial (trans (sym o5) e) ;

  module Example (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
    (hp : Id Lg.R (PE.eval Lg (iota.1 a) (iota.1 b) x y AD.p-ex) Lg.z)
    (hq : Id Lg.R (PE.eval Lg (iota.1 a) (iota.1 b) x y AD.q-ex) Lg.z) {
    module RQ = ACLCech[l].ResPQ[A,setA,a,b,Lg,setL,iota,x,y,hp,hq] ;
    module AG = ACLGeneral[l].Over[A,G,F.PA,F.nA,F.onto,a,b,
    FA.muP,FA.FP,FA.GP,refl false,(refl false,tt),(refl false,(refl false,tt)),(refl two,tt),(refl two,(refl two,tt)),
    FA.muQ,FA.FQ,FA.GQ,refl false,(refl false,(refl false,tt)),(refl false,(refl false,tt)),(refl two,(refl two,tt)),(refl two,(refl two,tt)),
    ((refl false, tt), ((refl false, tt), ((refl false, tt), (refl two, tt)))),((refl false, (refl false, tt)), ((refl false, (refl false, tt)), ((refl false, (refl false, tt)), (refl two, (refl two, tt))))),((refl false, (refl false, tt)), ((refl false, (refl false, tt)), ((refl false, (refl false, tt)), (refl two, (refl two, tt))))),((refl false, (refl false, tt)), ((refl false, (refl false, tt)), ((refl false, (refl false, tt)), (refl two, (refl two, tt))))),((refl false, tt), ((refl false, tt), ((refl false, tt), (refl two, tt)))),((refl false, tt), ((refl false, tt), ((refl false, tt), (refl two, tt)))),((refl false, (refl false, (refl false, (refl false, tt)))), ((refl false, (refl false, (refl false, (refl false, tt)))), ((refl false, (refl false, (refl false, (refl false, tt)))), (refl two, (refl two, (refl two, (refl two, tt))))))),((refl false, (refl false, (refl false, (refl false, (refl false, tt))))), ((refl false, (refl false, (refl false, (refl false, (refl false, tt))))), ((refl false, (refl false, (refl false, (refl false, (refl false, tt))))), (refl two, (refl two, (refl two, (refl two, (refl two, tt)))))))),
      suc zero,suc zero,
      (refl two, (refl two, (refl two, (refl two, tt)))),
      (refl two, (refl two, (refl two, (refl two, (refl two, tt))))),
      (zero, refl zero),(zero, refl zero),FA.muP,nP0,FA.muQ,nQ0,
      Lg,setL,iota,x,y,RQ.hP,RQ.hQ] ;
    certificate : AG.CZ.Z.TC.carrier = AG.certificate ;
  } ;
} ;
