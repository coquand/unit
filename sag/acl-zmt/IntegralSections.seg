-- IntegralSections.seg: monic equations from a finite generating family
-- (handoff §9; finite-cohomology.tex §4).
--
-- Let iota : A -> L be a ring map to a commutative ring, m_1, .., m_n in L
-- with 1 = sum_k e_k m_k, and structure constants gamma in A with
--     m_i m_j = sum_k m_k gamma_ijk .
-- For t = sum_l m_l c_l (c in A), t m_i = sum_j m_j a_ji with
--     a_ji = sum_l c_l gamma_lij ,
-- so Cayley-Hamilton (DeterminantTrick.Integral) gives chi_a, monic of
-- degree n with coefficients in A, and chi_a(t) = 0.  In the application
-- L is B (or any A-algebra where p = q = 0), the m_k are the images of
-- generators of the global sections C (including 1), and t is one of s,
-- sx, sy.  No basis is needed: the m_k need not be independent.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ;

-- a ring map commutes with finite sums
module HomSum (S T : CRing) (h : H.Hom S T) {
  module SS = FiniteIdeal[l].Sums[S] ; module ST = FiniteIdeal[l].Sums[T] ;
  hom-sum : (n : Nat) (v : Ps.Fin n -> S.R) -> Id T.R (h.1 (SS.sum n v)) (ST.sum n (\ i -> h.1 (v i))) = split {
    zero -> \ v -> H.zero S T h ;
    suc n | ih -> \ v -> trans (h.2.2.1 (v (inr tt)) (SS.sum n (\ i -> v (inl i))))
                          (ap (T.add (h.1 (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R) (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg)
  (n : Nat) (m : Ps.Fin n -> Lg.R)
  (e : Ps.Fin n -> Lg.R) (one : Id Lg.R (FiniteIdeal[l].Sums[Lg].lin n e m) Lg.o)
  (gam : Ps.Fin n -> Ps.Fin n -> Ps.Fin n -> A.R)
  (table : (i j : Ps.Fin n) -> Id Lg.R (Lg.mul (m i) (m j))
     (FiniteIdeal[l].Sums[Lg].sum n (\ k -> Lg.mul (m k) (iota.1 (gam i j k))))) {
  module SA = FiniteIdeal[l].Sums[A] ; module SL = FiniteIdeal[l].Sums[Lg] ;
  module ML = MnSums[l].Over[Lg] ; module LL = RL[Lg] ;
  module HS = HomSum[A,Lg,iota] ;
  module DT = Determinant[l].Over[A,setA] ;

  -- the element with coordinates c, and its matrix
  elt (c : Ps.Fin n -> A.R) : Lg.R = SL.sum n (\ l -> Lg.mul (m l) (iota.1 (c l))) ;
  mat (c : Ps.Fin n -> A.R) : DT.Mat n = \ j i -> SA.sum n (\ l -> A.mul (c l) (gam l i j)) ;

  -- (m c) w = c (m w)
  swap1 (u c w : Lg.R) : Id Lg.R (Lg.mul (Lg.mul u c) w) (Lg.mul c (Lg.mul u w)) =
    trans (sym (Lg.mulA u c w)) (LL.mul-swap u c w) ;
  -- c (m g) = m (c g)
  swap2 (c u g : Lg.R) : Id Lg.R (Lg.mul c (Lg.mul u g)) (Lg.mul u (Lg.mul c g)) = LL.mul-swap c u g ;

  -- t m_i = sum_j m_j a_ji
  eq (c : Ps.Fin n -> A.R) (i : Ps.Fin n) :
    Id Lg.R (Lg.mul (elt c) (m i)) (Determinant[l].Over[Lg,setL].act n (\ j i' -> iota.1 (mat c j i')) m i) =
    calc Lg.R {
      Lg.mul (elt c) (m i)
        =< sym (ML.sum-scale-right (m i) n (\ l -> Lg.mul (m l) (iota.1 (c l))))
        > SL.sum n (\ l -> Lg.mul (Lg.mul (m l) (iota.1 (c l))) (m i))
        =< SL.sum-cong n (\ l -> Lg.mul (Lg.mul (m l) (iota.1 (c l))) (m i))
             (\ l -> Lg.mul (iota.1 (c l)) (SL.sum n (\ j -> Lg.mul (m j) (iota.1 (gam l i j)))))
             (\ l -> trans (swap1 (m l) (iota.1 (c l)) (m i)) (ap (Lg.mul (iota.1 (c l))) (table l i)))
        > SL.sum n (\ l -> Lg.mul (iota.1 (c l)) (SL.sum n (\ j -> Lg.mul (m j) (iota.1 (gam l i j)))))
        =< SL.sum-cong n (\ l -> Lg.mul (iota.1 (c l)) (SL.sum n (\ j -> Lg.mul (m j) (iota.1 (gam l i j)))))
             (\ l -> SL.sum n (\ j -> Lg.mul (m j) (Lg.mul (iota.1 (c l)) (iota.1 (gam l i j)))))
             (\ l -> trans (sym (SL.sum-scale (iota.1 (c l)) n (\ j -> Lg.mul (m j) (iota.1 (gam l i j)))))
                       (SL.sum-cong n (\ j -> Lg.mul (iota.1 (c l)) (Lg.mul (m j) (iota.1 (gam l i j))))
                          (\ j -> Lg.mul (m j) (Lg.mul (iota.1 (c l)) (iota.1 (gam l i j))))
                          (\ j -> swap2 (iota.1 (c l)) (m j) (iota.1 (gam l i j)))))
        > SL.sum n (\ l -> SL.sum n (\ j -> Lg.mul (m j) (Lg.mul (iota.1 (c l)) (iota.1 (gam l i j)))))
        =< ML.exchange n n (\ l j -> Lg.mul (m j) (Lg.mul (iota.1 (c l)) (iota.1 (gam l i j))))
        > SL.sum n (\ j -> SL.sum n (\ l -> Lg.mul (m j) (Lg.mul (iota.1 (c l)) (iota.1 (gam l i j)))))
        =< SL.sum-cong n (\ j -> SL.sum n (\ l -> Lg.mul (m j) (Lg.mul (iota.1 (c l)) (iota.1 (gam l i j)))))
             (\ j -> Lg.mul (m j) (iota.1 (mat c j i)))
             (\ j -> trans (SL.sum-scale (m j) n (\ l -> Lg.mul (iota.1 (c l)) (iota.1 (gam l i j))))
                       (ap (Lg.mul (m j))
                         (sym (trans (HS.hom-sum n (\ l -> A.mul (c l) (gam l i j)))
                                (SL.sum-cong n (\ l -> iota.1 (A.mul (c l) (gam l i j)))
                                   (\ l -> Lg.mul (iota.1 (c l)) (iota.1 (gam l i j)))
                                   (\ l -> iota.2.2.2 (c l) (gam l i j)))))))
        > SL.sum n (\ j -> Lg.mul (m j) (iota.1 (mat c j i))) } ;

  -- t = sum_l m_l c_l is a root of chi_(mat c), monic of degree n over A
  module At (c : Ps.Fin n -> A.R) {
    module I = DeterminantTrick[l].Integral[A,setA,Lg,setL,iota,elt c,n,mat c,m,eq c] ;
    module CP = CharPoly[l].Over[A,setA] ;
    chi : CP.B.Carrier = I.chi ;
    -- evaluation A[X] -> L at t
    value (f : CP.B.Carrier) : Lg.R = I.ev.1 f ;
    integral : CP.Bounded (suc n) chi * (Id A.R (CP.coef chi n) A.o * Id Lg.R (value chi) Lg.z) =
      I.Faithful[e,one].integral ;
  } ;
} ;
