-- ReesLifting.seg: a section lifted from all finite orders to a global one
-- (finite-lifting.tex, Proposition 2, with one cochain z* at every order;
-- handoff §3-§5).
--
-- K0 -> K1 is A-linear (d), I = (a,b), z* in K0 with d z* in I^n K1 for
-- all n.  The finiteness of the Rees module M = sum_n H^1(I^n K) is given
-- through the classes beta_n = [d z*] in degree n: a linear G : A^r -> K1
-- (G rho = sum_k rho_k m_k, the generators m_k of degree e_k) and, for each
-- n >= 1, rho_n with rho_n,k in I^(n - e_k) (0 if n < e_k) and v_n in I^n K0
-- with  d z* = G rho_n + d v_n .
-- With a coded noetherian A (GradedDependence) there merely is N and
-- r_i in I^(N-i) with rho_N = sum_i r_i rho_i; then
--     d z* - sum_i r_i d z* = d v ,   v = v_N - sum_i r_i v_i in I^N K0 ,
-- because the G-parts cancel (G is linear), and the finite correction
-- (FiniteCorrection.Fixed) gives h with d h = 0 and h - z* in I K0.
-- Only the finitely many data up to N are used.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module IP = IdealPowers[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

-- the free module A^r
module Free (A : CRing) (r : Nat) {
  Vec : U l = Ps.Fin r -> A.R ;
  ext (u v : Vec) (h : (k : Ps.Fin r) -> Id A.R (u k) (v k)) : Id Vec u v = FE.funext (Ps.Fin r) (\ k -> A.R) u v h ;
  module LA = RL[A] ;
  mod : IP.Mod[A] = IP.mkMod A Vec (\ k -> A.z) (\ u v k -> A.add (u k) (v k)) (\ u k -> A.neg (u k))
    (\ u v w -> ext _ _ (\ k -> A.addA (u k) (v k) (w k)))
    (\ u v -> ext _ _ (\ k -> A.addC (u k) (v k)))
    (\ u -> ext _ _ (\ k -> A.addZ (u k)))
    (\ u -> ext _ _ (\ k -> A.addN (u k)))
    (\ c u k -> A.mul c (u k))
    (\ c c' u -> ext _ _ (\ k -> A.mulA c c' (u k)))
    (\ u -> ext _ _ (\ k -> LA.one-left (u k)))
    (\ c u v -> ext _ _ (\ k -> A.dist c (u k) (v k)))
    (\ c c' u -> ext _ _ (\ k -> LA.dist-left c c' (u k))) ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R)
  (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
  (onto : (c : A.R) -> Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier)
  (a b : A.R)
  (K0 K1 : IP.Mod[A]) (d : IP.Lin[A,K0,K1])
  (zs : K0.M)
  -- the generators of M and the classes beta_n
  (r : Nat) (e : Ps.Fin r -> Nat)
  (G : IP.Lin[A,Free[A,r].mod,K1])
  (rho : Nat -> Ps.Fin r -> A.R)
  (deg : (n : Nat) (k : Ps.Fin r) ->
     Plus ((dd : Nat) * (Id Nat n (plus dd (e k)) * IP.Over[A,IP.regular A,a,b].Pow dd (rho n k))) (Id A.R (rho n k) A.z))
  (v : Nat -> K0.M) (hv : (n : Nat) -> IP.Over[A,K0,a,b].Pow n (v n))
  (beta : (n : Nat) -> Id K1.M (d.f zs) (K1.madd (G.f (rho n)) (d.f (v n)))) {
  module PW = IP.Over[A,IP.regular A,a,b] ;
  module P0 = IP.Over[A,K0,a,b] ; module M0 = IP.Mult[A,K0,a,b] ;
  module L0 = IP.ModL[A,K0] ; module L1 = IP.ModL[A,K1] ;
  module FC = FiniteCorrection[l].Over[A,K0,K1,d,a,b] ;
  module GD = GradedDependence[l].Over[A,setA,PA,nA,onto,a,b] ;
  module SQ = GD.Rees[r,e].Seq[rho,deg] ;
  module FV = Free[A,r] ;

  -- sum_i r_i v_i, sum_i r_i rho_i (the head with index len (tail) + 1)
  vSum : List A.R -> K0.M = split {
    nil -> K0.mz ;
    cons x xs | rr -> K0.madd (K0.sm x (v (suc (len xs)))) rr } ;
  rhoSum : List A.R -> FV.Vec = split {
    nil -> \ k -> A.z ;
    cons x xs | rr -> \ k -> A.add (A.mul x (rho (suc (len xs)) k)) (rr k) } ;
  rhoSum-is (k : Ps.Fin r) : (rs : List A.R) -> Id A.R (rhoSum rs k) (SQ.sumRel k rs) = split {
    nil -> refl A.z ;
    cons x xs | rr -> ap (A.add (A.mul x (rho (suc (len xs)) k))) rr } ;

  -- the degrees
  coeffs : (rs : List A.R) (j : Nat) -> SQ.Grades rs j -> FC.CoeffsA rs j = split {
    nil -> \ j g -> tt ;
    cons x xs | rr -> \ j g -> (g.1, rr (suc j) g.2) } ;
  suc-plus (j m : Nat) : Id Nat (plus (suc (suc j)) m) (plus (suc j) (suc m)) =
    ap (\ q -> suc q) (sym (plus-suc j m)) ;
  vsum-pow : (rs : List A.R) (j : Nat) -> SQ.Grades rs j -> P0.Pow (plus (suc j) (len rs)) (vSum rs) = split {
    nil -> \ j g -> P0.pow-zero (plus (suc j) zero) ;
    cons x xs | rr -> \ j g ->
      P0.pow-add (plus (suc j) (suc (len xs))) (K0.sm x (v (suc (len xs)))) (vSum xs)
        (M0.pow-mul (suc j) (suc (len xs)) x (v (suc (len xs))) g.1 (hv (suc (len xs))))
        (subst (\ q -> P0.Pow q (vSum xs)) (suc-plus j (len xs)) (rr (suc j) g.2)) } ;

  -- d (sum_i r_i v_i) = sum_i r_i d z* - G (sum_i r_i rho_i)
  d-vsum : (rs : List A.R) -> Id K1.M (d.f (vSum rs)) (L1.msub (FC.dcomb (FC.fixed zs rs)) (G.f (rhoSum rs))) = split {
    nil -> trans FC.d-zero (sym (trans (ap (\ t -> L1.msub K1.mz t) (G-zero)) (K1.maddN K1.mz))) ;
    cons x xs | rr -> calc K1.M {
      d.f (K0.madd (K0.sm x (v (suc (len xs)))) (vSum xs))
        =< d.f-add (K0.sm x (v (suc (len xs)))) (vSum xs)
        > K1.madd (d.f (K0.sm x (v (suc (len xs))))) (d.f (vSum xs))
        =< L1.G.cong-add (trans (d.f-sm x (v (suc (len xs)))) (ap (K1.sm x) (dv (suc (len xs))))) rr
        > K1.madd (K1.sm x (L1.msub (d.f zs) (G.f (rho (suc (len xs))))))
                  (L1.msub (FC.dcomb (FC.fixed zs xs)) (G.f (rhoSum xs)))
        =< L1.G.cong-add (L1.sm-sub x (d.f zs) (G.f (rho (suc (len xs))))) (refl (L1.msub (FC.dcomb (FC.fixed zs xs)) (G.f (rhoSum xs))))
        > K1.madd (L1.msub (K1.sm x (d.f zs)) (K1.sm x (G.f (rho (suc (len xs))))))
                  (L1.msub (FC.dcomb (FC.fixed zs xs)) (G.f (rhoSum xs)))
        =< sym (L1.sub-swap (K1.sm x (d.f zs)) (FC.dcomb (FC.fixed zs xs)) (K1.sm x (G.f (rho (suc (len xs))))) (G.f (rhoSum xs)))
        > L1.msub (K1.madd (K1.sm x (d.f zs)) (FC.dcomb (FC.fixed zs xs)))
                  (K1.madd (K1.sm x (G.f (rho (suc (len xs))))) (G.f (rhoSum xs)))
        =< ap (L1.msub (K1.madd (K1.sm x (d.f zs)) (FC.dcomb (FC.fixed zs xs))))
             (sym (trans (G.f-add (FV.mod.sm x (rho (suc (len xs)))) (rhoSum xs))
                         (ap (\ t -> K1.madd t (G.f (rhoSum xs))) (G.f-sm x (rho (suc (len xs)))))))
        > L1.msub (FC.dcomb (FC.fixed zs (cons x xs))) (G.f (rhoSum (cons x xs))) } }
    where {
      G-zero : Id K1.M (G.f (\ k -> A.z)) K1.mz =
        trans (ap G.f (sym (IP.ModL[A,FV.mod].zero-sm (\ k -> A.z)))) (trans (G.f-sm A.z (\ k -> A.z)) (L1.zero-sm (G.f (\ k -> A.z)))) ;
      dv (n : Nat) : Id K1.M (d.f (v n)) (L1.msub (d.f zs) (G.f (rho n))) =
        sym (trans (ap (\ t -> L1.msub t (G.f (rho n))) (beta n))
              (trans (ap (\ t -> K1.madd t (K1.mneg (G.f (rho n)))) (K1.maddC (G.f (rho n)) (d.f (v n))))
                     (trans (sym (K1.maddA (d.f (v n)) (G.f (rho n)) (K1.mneg (G.f (rho n)))))
                            (trans (ap (K1.madd (d.f (v n))) (K1.maddN (G.f (rho n)))) (K1.maddZ (d.f (v n))))))) } ;

  module Lifted (rs : List A.R) (g : SQ.Grades rs zero)
    (rel : (k : Ps.Fin r) -> Id A.R (rho (suc (len rs)) k) (SQ.sumRel k rs)) {
    N : Nat = suc (len rs) ;
    vv : K0.M = L0.msub (v N) (vSum rs) ;
    hvv : P0.Pow (suc (len rs)) vv =
      P0.pow-sub N (v N) (vSum rs) (hv N) (vsum-pow rs zero g) ;
    -- rho_N = sum_i r_i rho_i, as vectors
    rel-vec : Id FV.Vec (rho N) (rhoSum rs) = FV.ext (rho N) (rhoSum rs) (\ k -> trans (rel k) (sym (rhoSum-is k rs))) ;
    -- d z* - sum_i r_i d z* = d v
    star : Id K1.M (L1.msub (d.f zs) (FC.dcomb (FC.fixed zs rs))) (d.f vv) =
      sym (calc K1.M {
        d.f vv
          =< FC.d-sub (v N) (vSum rs) > L1.msub (d.f (v N)) (d.f (vSum rs))
          =< L1.G.cong-add (dv-top) (ap K1.mneg (d-vsum rs))
          > L1.msub (L1.msub (d.f zs) (G.f (rhoSum rs))) (L1.msub (FC.dcomb (FC.fixed zs rs)) (G.f (rhoSum rs)))
          =< L1.sub-cancel (d.f zs) (FC.dcomb (FC.fixed zs rs)) (G.f (rhoSum rs))
          > L1.msub (d.f zs) (FC.dcomb (FC.fixed zs rs)) })
      where {
        dv-top : Id K1.M (d.f (v N)) (L1.msub (d.f zs) (G.f (rhoSum rs))) =
          trans (sym (trans (ap (\ t -> L1.msub t (G.f (rho N))) (beta N))
                   (trans (ap (\ t -> K1.madd t (K1.mneg (G.f (rho N)))) (K1.maddC (G.f (rho N)) (d.f (v N))))
                     (trans (sym (K1.maddA (d.f (v N)) (G.f (rho N)) (K1.mneg (G.f (rho N)))))
                            (trans (ap (K1.madd (d.f (v N))) (K1.maddN (G.f (rho N)))) (K1.maddZ (d.f (v N))))))))
                (ap (\ t -> L1.msub (d.f zs) (G.f t)) rel-vec) } ;
    module K = FC.Fixed[zs,rs,coeffs rs zero g,vv,hvv,star] ;
  } ;

  -- the lifted section: d h = 0 and h - z* in I K0, merely
  Lift : U l = (h : K0.M) * (Id K1.M (d.f h) K1.mz * P0.Pow (suc zero) (L0.msub h zs)) ;
  module TL = Tr.Trunc[Lift] ;
  lift : TL.carrier =
    SQ.TR.induction @l (\ u -> TL.carrier) (\ u -> TL.proposition)
      (\ res -> TL.inc (Lifted[res.1,res.2.1,res.2.2].K.h, (Lifted[res.1,res.2.1,res.2.2].K.closed, Lifted[res.1,res.2.1,res.2.2].K.congruent)))
      SQ.dependence ;
} ;
