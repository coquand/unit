-- ACLControlGeneral.seg: the control example of the handoff (§11) by the
-- general route (ACLGeneralK), where the common factor of P and Q is NOT a
-- unit:
--     p = x (1 + a x) ,  q = y (1 + a x) ,
--     P = XZ + a X^2 ,   Q = YZ + a XY ,   D0 = gcd(P,Q) ~ Z + a X ,
-- for k a discrete field (1 /= 0), A = k[b][a], every ring map A -> L and
-- x, y in L with p(x,y) = q(x,y) = 0: merely s = 1 + a r + b t with s, s x,
-- s y integral over A.  ACHIEVED.  Compare ACLControl (direct certificate,
-- s = 1 + a x); here s comes from the cohomological construction with the
-- data (S0) for D0 and (S1) for P', Q'.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ; open PolyExpr[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module RN0 = RingNormal[l] ; module CC = ACLControl[l] ;

module Over (k : CRing) (setk : Pr.isSet k.R)
  (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o))
  (one-nonzero : Not (Id k.R k.o k.z)) {
  module GK = ACLGeneralK[l].Over[k,setk,dec,one-nonzero] ;
  A : CRing = GK.A ;
  a : A.R = GK.a ;
  b : A.R = GK.b ;
  module LO = Laurent3[l].Over[A] ;
  module LL = LaurentList[l].Over[A] ;
  one : Int = pos (suc zero) ;
  two : Int = pos (suc (suc zero)) ;
  e3 (i j l' : Int) : E3 = (i, (j, l')) ;
  -- the charts: P = XZ + a X^2, Q = YZ + a XY
  muP : E3 = e3 one zeroZ one ;
  FP : LO.LPoly = cons (A.o, e3 two zeroZ zeroZ) nil ;
  GP : LO.LPoly = nil ;
  muQ : E3 = e3 zeroZ one one ;
  FQ : LO.LPoly = cons (A.o, e3 one one zeroZ) nil ;
  GQ : LO.LPoly = nil ;
  module FC = FixedCochain[l].Over[A,a,b] ;
  module XZ = FC.XZ[muP,FP,GP,refl false,(refl false,tt),tt,(refl two,tt),tt] ;
  module YZ = FC.YZ[muQ,FQ,GQ,refl false,(refl false,tt),tt,(refl two,tt),tt] ;
  PL : LO.LPoly = XZ.C.Pl ;
  QL : LO.LPoly = YZ.C.Pl ;
  -- the coefficient 1 of XZ (of YZ) is not 0
  o2 : Id A.R (A.add A.o (A.add A.z A.z)) A.o = trans (ap (A.add A.o) (A.addZ A.z)) (A.addZ A.o) ;
  nP0 : Not (Id A.R (LL.coef PL muP) A.z) = \ e -> GK.G.nontrivial (trans (sym o2) e) ;
  nQ0 : Not (Id A.R (LL.coef QL muQ) A.z) = \ e -> GK.G.nontrivial (trans (sym o2) e) ;

  module Example (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
    (hp : Id Lg.R (eval Lg (iota.1 a) (iota.1 b) x y CC.pC) Lg.z)
    (hq : Id Lg.R (eval Lg (iota.1 a) (iota.1 b) x y CC.qC) Lg.z) {
    module R = CechRestriction[l].Over[A,GK.G.set,Lg,setL,iota,x,y] ;
    module PM = PolyExpr[l].Map[A,Lg,iota] ;
    module RN = RingNormal[l].Over[Lg,iota.1 a,iota.1 b,x,y] ;
    al : Lg.R = iota.1 a ;
    be : Lg.R = iota.1 b ;
    val (e : Ex) : Lg.R = eval Lg al be x y e ;
    hev (e : Ex) : Id Lg.R (iota.1 (eval A a b a b e)) (eval Lg al be al be e) = PM.hom-eval a b a b e ;
    -- res P and res Q as polynomial expressions
    eP : Ex = addE (mulE oneE (mulE (mulE vx oneE) oneE)) (addE (mulE (mulE va oneE) (mulE (mulE vx (mulE vx oneE)) oneE)) zeroE) ;
    eQ : Ex = addE (mulE oneE (mulE oneE (mulE vy oneE))) (addE (mulE (mulE va oneE) (mulE (mulE vx oneE) (mulE vy oneE))) zeroE) ;
    c2 (u v w z' : Lg.R) (e : Id Lg.R u v) (e' : Id Lg.R w z') : Id Lg.R (Lg.add u w) (Lg.add v z') = Ps.cong2 Lg.R Lg.add u v w z' e e' ;
    resP : Id Lg.R (R.resL PL) (val eP) =
      c2 _ _ _ _ (ap (\ s -> Lg.mul s (Lg.mul (Lg.mul x Lg.o) Lg.o)) iota.2.1)
        (c2 _ _ _ _ (ap (\ s -> Lg.mul s (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) (hev (mulE va oneE))) (refl Lg.z)) ;
    resQ : Id Lg.R (R.resL QL) (val eQ) =
      c2 _ _ _ _ (ap (\ s -> Lg.mul s (Lg.mul Lg.o (Lg.mul y Lg.o))) iota.2.1)
        (c2 _ _ _ _ (ap (\ s -> Lg.mul s (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (hev (mulE va oneE))) (refl Lg.z)) ;
    hP : Id Lg.R (R.resL PL) Lg.z = trans resP (trans (RN.same-value eP CC.pC (refl (RN0.norm CC.pC))) hp) ;
    hQ : Id Lg.R (R.resL QL) Lg.z = trans resQ (trans (RN.same-value eQ CC.qC (refl (RN0.norm CC.qC))) hq) ;
    -- every chart condition by computation
    module CH = GK.Charts[muP,FP,GP,refl false,(refl false,tt),tt,(refl two,tt),tt,
      muQ,FQ,GQ,refl false,(refl false,tt),tt,(refl two,tt),tt,
      ((refl false,tt),((refl false,tt),((refl false,tt),(refl two,tt)))),(tt,(tt,(tt,tt))),
      ((refl false,tt),((refl false,tt),((refl false,tt),(refl two,tt)))),(tt,(tt,(tt,tt))),
      ((refl false,tt),((refl false,tt),((refl false,tt),(refl two,tt)))),
      ((refl false,tt),((refl false,tt),((refl false,tt),(refl two,tt)))),
      ((refl false,(refl false,tt)),((refl false,(refl false,tt)),((refl false,(refl false,tt)),(refl two,(refl two,tt))))),
      ((refl false,(refl false,tt)),((refl false,(refl false,tt)),((refl false,(refl false,tt)),(refl two,(refl two,tt))))),
      suc zero,suc zero,(refl two,(refl two,tt)),(refl two,(refl two,tt)),
      (zero, refl zero),(zero, refl zero),muP,nP0,muQ,nQ0,
      Lg,setL,iota,x,y,hP,hQ] ;
    certificate : CH.AG.CZ.Z.TC.carrier = CH.certificate ;
  } ;
} ;
