-- ACLZMT.seg: the conditional ZMT certificate of ACL §4.3 (handoff §1, §9;
-- milestone 2).  CONDITIONAL: the Cech model and the two finiteness data
-- are parameters (listed below); they are not constructed here.
--
-- Conclusion (certificate): for every ring map iota : A -> L to a
-- commutative ring with x, y in L (in the application L = B = A[x,y]/(p,q)),
-- there merely is s in L with
--     s = 1 + a r + b t ,   s, s x, s y roots of monic polynomials over A.
--
-- Parameters, all visible:
--   * A with a coded noetherian presentation (PA, nA, onto), a, b
--     (A = k[a,b], k a discrete field: Field + Generated);
--   * the Cech complex K0 -> K1 -> K2 of O_W(-1) on the three charts
--     (d1 d0 = 0), the 0-cochains C0 -> C1 of O_W, the multiplications
--     X, Y, Z : K0 -> C0 (keeping closed cochains closed), the product of
--     closed sections and the restriction res : C0 -> L to the chart Z,
--     dehomogenised (additive, A-linear through iota, multiplicative on
--     closed sections, res X w = x res Z w, res Y w = y res Z w);
--   * the fixed cochain z* (handoff §3): d0 z* in I^n K1 for all n, and
--     res (Z z*) = 1;
--   * F1, finiteness of the Rees module M = sum_n H^1(I^n K): generators
--     G : A^r -> K1 in degrees e_k, and for every cocycle w in I^n K1 a
--     graded rho (rho_k in I^(n - e_k), 0 if n < e_k) and v in I^n K0 with
--     w = G rho + d0 v;
--   * F2, finiteness of C = H^0(W, O_W) = ker(C0 -> C1): closed c_1..c_m
--     generating every closed section, with 1 a combination of them.
-- Proof: F1 on the classes beta_n = [d0 z*] and ReesLifting (coded
-- noetherianity, finite correction) give h closed with h - z* in I K0;
-- Z h, X h, Y h are closed; F2 gives their coordinates and the structure
-- constants of the c_i c_j; IntegralSections (Cayley-Hamilton) gives the
-- monic equations of s = res (Z h), s x = res (X h), s y = res (Y h); and
-- s - 1 = res (Z (h - z*)) is in I L.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module H = RingHom[l] ; module IP = IdealPowers[l] ;

-- L as an A-module through iota
module LinearTarget (A : CRing) (Lg : CRing) (iota : H.Hom A Lg) {
  module LL = RL[Lg] ;
  mod : IP.Mod[A] = IP.mkMod A Lg.R Lg.z Lg.add Lg.neg Lg.addA Lg.addC Lg.addZ Lg.addN
    (\ c u -> Lg.mul (iota.1 c) u)
    (\ c c' u -> trans (Lg.mulA (iota.1 c) (iota.1 c') u) (ap (\ t -> Lg.mul t u) (sym (iota.2.2.2 c c'))))
    (\ u -> trans (ap (\ t -> Lg.mul t u) iota.2.1) (LL.one-left u))
    (\ c u u' -> Lg.dist (iota.1 c) u u')
    (\ c c' u -> trans (ap (\ t -> Lg.mul t u) (iota.2.2.1 c c')) (LL.dist-left (iota.1 c) (iota.1 c') u)) ;
} ;

-- finite sums in a module, and linear maps
module ModSum (A : CRing) (Md : IP.Mod[A]) {
  sum : (n : Nat) -> (Ps.Fin n -> Md.M) -> Md.M = split {
    zero -> \ f -> Md.mz ;
    suc n | rr -> \ f -> Md.madd (f (inr tt)) (rr (\ i -> f (inl i))) } ;
  comb (n : Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> Md.M) : Md.M = sum n (\ k -> Md.sm (c k) (u k)) ;
} ;
module LinSum (A : CRing) (P Q : IP.Mod[A]) (F : IP.Lin[A,P,Q]) {
  module SP = ModSum[A,P] ; module SQ = ModSum[A,Q] ;
  zero : Id Q.M (F.f P.mz) Q.mz =
    trans (ap F.f (sym (IP.ModL[A,P].zero-sm P.mz))) (trans (F.f-sm A.z P.mz) (IP.ModL[A,Q].zero-sm (F.f P.mz))) ;
  map-comb : (n : Nat) (c : Ps.Fin n -> A.R) (u : Ps.Fin n -> P.M) ->
    Id Q.M (F.f (SP.comb n c u)) (SQ.comb n c (\ k -> F.f (u k))) = split {
    zero -> \ c u -> zero ;
    suc n | rr -> \ c u -> trans (F.f-add (P.sm (c (inr tt)) (u (inr tt))) (SP.comb n (\ i -> c (inl i)) (\ i -> u (inl i))))
                            (IP.ModL[A,Q].G.cong-add (F.f-sm (c (inr tt)) (u (inr tt))) (rr (\ i -> c (inl i)) (\ i -> u (inl i)))) } ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R)
  (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
  (onto : (c : A.R) -> Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier)
  (a b : A.R)
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  -- the Cech complex of O_W(-1)
  (K0 K1 K2 : IP.Mod[A]) (d0 : IP.Lin[A,K0,K1]) (d1 : IP.Lin[A,K1,K2])
  (d1d0 : (c : K0.M) -> Id K2.M (d1.f (d0.f c)) K2.mz)
  -- the 0-cochains of O_W, and the multiplications by X, Y, Z
  (C0 C1 : IP.Mod[A]) (e0 : IP.Lin[A,C0,C1])
  (mX mY mZ : IP.Lin[A,K0,C0])
  (closedX : (w : K0.M) -> Id K1.M (d0.f w) K1.mz -> Id C1.M (e0.f (mX.f w)) C1.mz)
  (closedY : (w : K0.M) -> Id K1.M (d0.f w) K1.mz -> Id C1.M (e0.f (mY.f w)) C1.mz)
  (closedZ : (w : K0.M) -> Id K1.M (d0.f w) K1.mz -> Id C1.M (e0.f (mZ.f w)) C1.mz)
  -- the ring of global sections and the restriction to the chart Z
  (mulC : C0.M -> C0.M -> C0.M) (oneC : C0.M)
  (closed-mul : (c c' : C0.M) -> Id C1.M (e0.f c) C1.mz -> Id C1.M (e0.f c') C1.mz -> Id C1.M (e0.f (mulC c c')) C1.mz)
  (res : IP.Lin[A,C0,LinearTarget[A,Lg,iota].mod])
  (res-one : Id Lg.R (res.f oneC) Lg.o)
  (res-mul : (c c' : C0.M) -> Id C1.M (e0.f c) C1.mz -> Id C1.M (e0.f c') C1.mz ->
     Id Lg.R (res.f (mulC c c')) (Lg.mul (res.f c) (res.f c')))
  (chartX : (w : K0.M) -> Id Lg.R (res.f (mX.f w)) (Lg.mul x (res.f (mZ.f w))))
  (chartY : (w : K0.M) -> Id Lg.R (res.f (mY.f w)) (Lg.mul y (res.f (mZ.f w))))
  -- the fixed cochain
  (zs : K0.M) (zs-res : Id Lg.R (res.f (mZ.f zs)) Lg.o)
  (fixed : (n : Nat) -> IP.Over[A,K1,a,b].Pow n (d0.f zs))
  -- F1: the Rees module M is generated in degrees e_k
  (r : Nat) (e : Ps.Fin r -> Nat) (G : IP.Lin[A,ReesLifting[l].Free[A,r].mod,K1])
  (gen1 : (n : Nat) (w : K1.M) -> IP.Over[A,K1,a,b].Pow n w -> Id K2.M (d1.f w) K2.mz ->
     (rho : Ps.Fin r -> A.R)
     * (((k : Ps.Fin r) -> Plus ((dd : Nat) * (Id Nat n (plus dd (e k)) * IP.Over[A,IP.regular A,a,b].Pow dd (rho k)))
                                 (Id A.R (rho k) A.z))
     * ((v : K0.M) * (IP.Over[A,K0,a,b].Pow n v * Id K1.M w (K1.madd (G.f rho) (d0.f v))))))
  -- F2: C is generated over A by closed c_1..c_m, and 1 is a combination
  (m : Nat) (cs : Ps.Fin m -> C0.M) (cs-closed : (k : Ps.Fin m) -> Id C1.M (e0.f (cs k)) C1.mz)
  (eone : Ps.Fin m -> A.R) (one-comb : Id C0.M (ModSum[A,C0].comb m eone cs) oneC)
  (gen2 : (u : C0.M) -> Id C1.M (e0.f u) C1.mz -> (c : Ps.Fin m -> A.R) * Id C0.M u (ModSum[A,C0].comb m c cs)) {

  module LT = LinearTarget[A,Lg,iota] ;
  module SL = FiniteIdeal[l].Sums[Lg] ;
  module LL = RL[Lg] ;
  module RS = LinSum[A,C0,LT.mod,res] ;
  module P0 = IP.Over[A,K0,a,b] ; module L0 = IP.ModL[A,K0] ;

  ------------------------------------------------------------------------
  -- step 1: the lift h (ReesLifting, through F1 on beta_n = [d0 z*])

  g1 (n : Nat) : (rho : Ps.Fin r -> A.R) * (((k : Ps.Fin r) -> Plus ((dd : Nat) * (Id Nat n (plus dd (e k)) * IP.Over[A,IP.regular A,a,b].Pow dd (rho k))) (Id A.R (rho k) A.z))
     * ((v : K0.M) * (P0.Pow n v * Id K1.M (d0.f zs) (K1.madd (G.f rho) (d0.f v))))) =
    gen1 n (d0.f zs) (fixed n) (d1d0 zs) ;
  module RL0 = ReesLifting[l].Over[A,setA,PA,nA,onto,a,b,K0,K1,d0,zs,r,e,G,
    \ n -> (g1 n).1, \ n -> (g1 n).2.1, \ n -> (g1 n).2.2.1, \ n -> (g1 n).2.2.2.1, \ n -> (g1 n).2.2.2.2] ;

  ------------------------------------------------------------------------
  -- step 2: monic equations from F2 (IntegralSections)

  mres (k : Ps.Fin m) : Lg.R = res.f (cs k) ;
  -- sums in L as an A-module are the sums of L
  lt-sum : (n : Nat) (f : Ps.Fin n -> Lg.R) -> Id Lg.R (ModSum[A,LT.mod].sum n f) (SL.sum n f) = split {
    zero -> \ f -> refl Lg.z ;
    suc n | rr -> \ f -> ap (Lg.add (f (inr tt))) (rr (\ i -> f (inl i))) } ;
  -- res (sum_k c_k u_k) = sum_k u_k iota(c_k), in the order of IntegralSections
  res-comb (c : Ps.Fin m -> A.R) : Id Lg.R (res.f (ModSum[A,C0].comb m c cs)) (SL.sum m (\ k -> Lg.mul (mres k) (iota.1 (c k)))) =
    trans (RS.map-comb m c cs)
      (trans (lt-sum m (\ k -> Lg.mul (iota.1 (c k)) (mres k)))
        (SL.sum-cong m (\ k -> Lg.mul (iota.1 (c k)) (mres k)) (\ k -> Lg.mul (mres k) (iota.1 (c k)))
           (\ k -> Lg.mulC (iota.1 (c k)) (mres k)))) ;
  eL (k : Ps.Fin m) : Lg.R = iota.1 (eone k) ;
  one : Id Lg.R (SL.lin m eL mres) Lg.o =
    trans (sym (lt-sum m (\ k -> Lg.mul (eL k) (mres k))))
      (trans (sym (RS.map-comb m eone cs)) (trans (ap res.f one-comb) res-one)) ;
  gam (i j : Ps.Fin m) : Ps.Fin m -> A.R = (gen2 (mulC (cs i) (cs j)) (closed-mul (cs i) (cs j) (cs-closed i) (cs-closed j))).1 ;
  table (i j : Ps.Fin m) : Id Lg.R (Lg.mul (mres i) (mres j)) (SL.sum m (\ k -> Lg.mul (mres k) (iota.1 (gam i j k)))) =
    trans (sym (res-mul (cs i) (cs j) (cs-closed i) (cs-closed j)))
      (trans (ap res.f (gen2 (mulC (cs i) (cs j)) (closed-mul (cs i) (cs j) (cs-closed i) (cs-closed j))).2) (res-comb (gam i j))) ;
  module IS = IntegralSections[l].Over[A,setA,Lg,setL,iota,m,mres,eL,one,gam,table] ;

  module CP = CharPoly[l].Over[A,setA] ;
  MonicRoot (v : Lg.R) : U l =
    (f : CP.B.Carrier) * (CP.Bounded (suc m) f * (Id A.R (CP.coef f m) A.o
      * Id Lg.R ((Universal[l].Property[A,Lg,setA,setL].Given[iota,v].extend).1 f) Lg.z)) ;
  -- a closed section has a monic equation over A after restriction
  monic (u : C0.M) (hu : Id C1.M (e0.f u) C1.mz) : MonicRoot (res.f u) =
    subst MonicRoot (sym (trans (ap res.f (gen2 u hu).2) (res-comb (gen2 u hu).1)))
      (IS.At[(gen2 u hu).1].chi, IS.At[(gen2 u hu).1].integral) ;

  ------------------------------------------------------------------------
  -- the certificate

  Certificate : U l =
    (s : Lg.R) * (((rr tt' : Lg.R) * Id Lg.R s (Lg.add Lg.o (Lg.add (Lg.mul (iota.1 a) rr) (Lg.mul (iota.1 b) tt'))))
      * (MonicRoot s * (MonicRoot (Lg.mul s x) * MonicRoot (Lg.mul s y)))) ;

  module From (h : K0.M) (closed : Id K1.M (d0.f h) K1.mz) (cong : P0.Pow (suc zero) (L0.msub h zs)) {
    s : Lg.R = res.f (mZ.f h) ;
    sx : Id Lg.R (res.f (mX.f h)) (Lg.mul s x) = trans (chartX h) (Lg.mulC x s) ;
    sy : Id Lg.R (res.f (mY.f h)) (Lg.mul s y) = trans (chartY h) (Lg.mulC y s) ;
    -- h - z* = a m1 + b m2, so s - 1 = a res(Z m1) + b res(Z m2)
    m1 : K0.M = cong.1 ;
    m2 : K0.M = cong.2.1 ;
    split-h : Id K0.M (K0.madd zs (L0.msub h zs)) h =
      trans (K0.maddC zs (L0.msub h zs))
        (trans (sym (K0.maddA h (K0.mneg zs) zs)) (trans (ap (K0.madd h) (trans (K0.maddC (K0.mneg zs) zs) (K0.maddN zs))) (K0.maddZ h))) ;
    resZ-add (u w : K0.M) : Id Lg.R (res.f (mZ.f (K0.madd u w))) (Lg.add (res.f (mZ.f u)) (res.f (mZ.f w))) =
      trans (ap res.f (mZ.f-add u w)) (res.f-add (mZ.f u) (mZ.f w)) ;
    resZ-sm (c : A.R) (u : K0.M) : Id Lg.R (res.f (mZ.f (K0.sm c u))) (Lg.mul (iota.1 c) (res.f (mZ.f u))) =
      trans (ap res.f (mZ.f-sm c u)) (res.f-sm c (mZ.f u)) ;
    residual : Id Lg.R s (Lg.add Lg.o (Lg.add (Lg.mul (iota.1 a) (res.f (mZ.f m1))) (Lg.mul (iota.1 b) (res.f (mZ.f m2))))) =
      calc Lg.R {
        s =< ap (\ t -> res.f (mZ.f t)) (sym split-h) > res.f (mZ.f (K0.madd zs (L0.msub h zs)))
          =< resZ-add zs (L0.msub h zs) > Lg.add (res.f (mZ.f zs)) (res.f (mZ.f (L0.msub h zs)))
          =< IP.ModL[A,LT.mod].G.cong-add zs-res
               (trans (ap (\ t -> res.f (mZ.f t)) cong.2.2.2.2)
                 (trans (resZ-add (K0.sm a m1) (K0.sm b m2))
                   (IP.ModL[A,LT.mod].G.cong-add (resZ-sm a m1) (resZ-sm b m2))))
          > Lg.add Lg.o (Lg.add (Lg.mul (iota.1 a) (res.f (mZ.f m1))) (Lg.mul (iota.1 b) (res.f (mZ.f m2)))) } ;
    cert : Certificate =
      (s, ((res.f (mZ.f m1), (res.f (mZ.f m2), residual)),
           (monic (mZ.f h) (closedZ h closed),
            (subst MonicRoot sx (monic (mX.f h) (closedX h closed)),
             subst MonicRoot sy (monic (mY.f h) (closedY h closed)))))) ;
  } ;

  module TC = Tr.Trunc[Certificate] ;
  -- the conditional theorem
  certificate : TC.carrier =
    RL0.TL.induction @l (\ u -> TC.carrier) (\ u -> TC.proposition)
      (\ lf -> TC.inc (From[lf.1,lf.2.1,lf.2.2].cert)) RL0.lift ;
} ;
