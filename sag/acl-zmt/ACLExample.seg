-- ACLExample.seg: the example of ACL §4.4, as a certificate checked by Unit
-- (handoff §11, "cas concret obligatoire").
--
--   p = x - a + b x y + 2 b x^2 ,   q = y - b + a x^2 + a x y + b y^2 .
--
-- For every commutative ring A with a, b, every ring map A -> L to a
-- commutative ring and x, y in L with p(x,y) = q(x,y) = 0 (so for
-- B = A[x,y]/(p,q), with A = Q[a,b] or its localisation at (a,b)):
--     s = (1 + a x + b y)(1 + 2 b x + b y)^2      (the element u of ACL §4.4)
-- satisfies  s = 1 + a r + b t  (r, t polynomials in a, b, x, y), and s,
-- s x, s y are roots of monic polynomials of degree 4 with coefficients in
-- A (certificate).  The same element as the paper is found; the monic
-- polynomials are characteristic polynomials (Cayley-Hamilton), not the
-- displayed polynomial of the paper.
--
-- Proof.  m_0 = 1, m_1, m_2, m_3 (ACLExampleData) satisfy
--     m_i m_j = sum_k m_k g_ijk + p U_ij + q V_ij ,
--     e = sum_k m_k c^e_k + p U_e + q V_e     (e = s, s x, s y),
-- each checked by the verified normaliser (refl on normal forms).  With
-- p = q = 0 these are a multiplication table and coordinates, and
-- IntegralSections gives the monic equations.  The data come from an
-- untrusted script (acl_example_identities.py): the m_k are the
-- dehomogenised global sections c_t = tau(P u_1 + Q u_2) of
-- finite-cohomology.tex §4; Unit checks only the identities.
--
-- This is a direct certificate for the example: it is NOT obtained by
-- instantiating the general conditional theorem (ACLZMT), whose
-- finiteness data are not constructed here.
level l ; open Ring[l] ; open Base ; open PolyExpr[l] ; open ACLExampleData[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ;
module RN0 = RingNormal[l] ;

four : Nat = suc (suc (suc (suc zero))) ;

-- dependent elimination of Fin 4 (m_0 at f0, .., m_3 at f3)
topElim (Q : Top -> U l) (q : Q tt) : (t : Top) -> Q t = split { tt -> q } ;
elim1 (P : Ps.Fin (suc zero) -> U l) (p0 : P (inr tt)) : (i : Ps.Fin (suc zero)) -> P i = split {
  inl e -> efq e ;
  inr t -> topElim (\ s -> P (inr s)) p0 t } ;
elim2 (P : Ps.Fin (suc (suc zero)) -> U l) (p0 : P (inl (inr tt))) (p1 : P (inr tt)) : (i : Ps.Fin (suc (suc zero))) -> P i = split {
  inl i -> elim1 (\ k -> P (inl k)) p0 i ;
  inr t -> topElim (\ s -> P (inr s)) p1 t } ;
elim3 (P : Ps.Fin (suc (suc (suc zero))) -> U l) (p0 : P (inl (inl (inr tt)))) (p1 : P (inl (inr tt))) (p2 : P (inr tt)) :
  (i : Ps.Fin (suc (suc (suc zero)))) -> P i = split {
  inl i -> elim2 (\ k -> P (inl k)) p0 p1 i ;
  inr t -> topElim (\ s -> P (inr s)) p2 t } ;
elim4 (P : Ps.Fin four -> U l) (p0 : P (inl (inl (inl (inr tt))))) (p1 : P (inl (inl (inr tt)))) (p2 : P (inl (inr tt))) (p3 : P (inr tt)) :
  (i : Ps.Fin four) -> P i = split {
  inl i -> elim3 (\ k -> P (inl k)) p0 p1 p2 i ;
  inr t -> topElim (\ s -> P (inr s)) p3 t } ;
pick4 (X : U l) (v0 v1 v2 v3 : X) : Ps.Fin four -> X = elim4 (\ i -> X) v0 v1 v2 v3 ;
f0 : Ps.Fin four = inl (inl (inl (inr tt))) ;
f1 : Ps.Fin four = inl (inl (inr tt)) ;
f2 : Ps.Fin four = inl (inr tt) ;
f3 : Ps.Fin four = inr tt ;

-- the generators and the multiplication table, as expressions
mE : Ps.Fin four -> Ex = pick4 Ex oneE m1-ex m2-ex m3-ex ;
-- sum_k m_k c_k, in the order of FiniteIdeal.Sums.sum
combE (c : Ps.Fin four -> Ex) : Ex =
  addE (mulE (mE f3) (c f3)) (addE (mulE (mE f2) (c f2)) (addE (mulE (mE f1) (c f1)) (addE (mulE (mE f0) (c f0)) zeroE))) ;
gam00 : Ps.Fin four -> Ex = pick4 Ex g00-0 g00-1 g00-2 g00-3 ;
gam01 : Ps.Fin four -> Ex = pick4 Ex g01-0 g01-1 g01-2 g01-3 ;
gam02 : Ps.Fin four -> Ex = pick4 Ex g02-0 g02-1 g02-2 g02-3 ;
gam03 : Ps.Fin four -> Ex = pick4 Ex g03-0 g03-1 g03-2 g03-3 ;
gam10 : Ps.Fin four -> Ex = pick4 Ex g10-0 g10-1 g10-2 g10-3 ;
gam11 : Ps.Fin four -> Ex = pick4 Ex g11-0 g11-1 g11-2 g11-3 ;
gam12 : Ps.Fin four -> Ex = pick4 Ex g12-0 g12-1 g12-2 g12-3 ;
gam13 : Ps.Fin four -> Ex = pick4 Ex g13-0 g13-1 g13-2 g13-3 ;
gam20 : Ps.Fin four -> Ex = pick4 Ex g20-0 g20-1 g20-2 g20-3 ;
gam21 : Ps.Fin four -> Ex = pick4 Ex g21-0 g21-1 g21-2 g21-3 ;
gam22 : Ps.Fin four -> Ex = pick4 Ex g22-0 g22-1 g22-2 g22-3 ;
gam23 : Ps.Fin four -> Ex = pick4 Ex g23-0 g23-1 g23-2 g23-3 ;
gam30 : Ps.Fin four -> Ex = pick4 Ex g30-0 g30-1 g30-2 g30-3 ;
gam31 : Ps.Fin four -> Ex = pick4 Ex g31-0 g31-1 g31-2 g31-3 ;
gam32 : Ps.Fin four -> Ex = pick4 Ex g32-0 g32-1 g32-2 g32-3 ;
gam33 : Ps.Fin four -> Ex = pick4 Ex g33-0 g33-1 g33-2 g33-3 ;
gamE : Ps.Fin four -> Ps.Fin four -> Ps.Fin four -> Ex =
  pick4 (Ps.Fin four -> Ps.Fin four -> Ex)
    (pick4 (Ps.Fin four -> Ex) gam00 gam01 gam02 gam03)
    (pick4 (Ps.Fin four -> Ex) gam10 gam11 gam12 gam13)
    (pick4 (Ps.Fin four -> Ex) gam20 gam21 gam22 gam23)
    (pick4 (Ps.Fin four -> Ex) gam30 gam31 gam32 gam33) ;
s-c : Ps.Fin four -> Ex = pick4 Ex s-c0 s-c1 s-c2 s-c3 ;
sx-c : Ps.Fin four -> Ex = pick4 Ex sx-c0 sx-c1 sx-c2 sx-c3 ;
sy-c : Ps.Fin four -> Ex = pick4 Ex sy-c0 sy-c1 sy-c2 sy-c3 ;

module Over (A : CRing) (setA : Pr.isSet A.R) (a b : A.R)
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (eval Lg (iota.1 a) (iota.1 b) x y p-ex) Lg.z)
  (hq : Id Lg.R (eval Lg (iota.1 a) (iota.1 b) x y q-ex) Lg.z) {
  al : Lg.R = iota.1 a ;
  be : Lg.R = iota.1 b ;
  -- values in L, and coefficients in A
  val (e : Ex) : Lg.R = eval Lg al be x y e ;
  valA (e : Ex) : A.R = eval A a b a b e ;
  module RN = RingNormal[l].Over[Lg,al,be,x,y] ;
  module PM = PolyExpr[l].Map[A,Lg,iota] ;
  module LL = RL[Lg] ;
  module SL = FiniteIdeal[l].Sums[Lg] ;

  -- an expression with the normal form of p U + q W vanishes
  modpq (e cu cv : Ex)
    (h : Id (List RN0.Term) (RN0.norm e) (RN0.norm (addE (mulE p-ex cu) (mulE q-ex cv)))) : Id Lg.R (val e) Lg.z =
    trans (RN.same-value e (addE (mulE p-ex cu) (mulE q-ex cv)) h)
      (trans (Ps.cong2 Lg.R Lg.add (Lg.mul (val p-ex) (val cu)) Lg.z (Lg.mul (val q-ex) (val cv)) Lg.z
                (trans (ap (\ t -> Lg.mul t (val cu)) hp) (LL.zero-mul (val cu)))
                (trans (ap (\ t -> Lg.mul t (val cv)) hq) (LL.zero-mul (val cv))))
             (Lg.addZ Lg.z)) ;
  -- d - e = 0 gives d = e
  sub-eq (d e : Lg.R) (h : Id Lg.R (Lg.add d (Lg.neg e)) Lg.z) : Id Lg.R d e =
    trans (sym (trans (sym (Lg.addA d (Lg.neg e) e)) (trans (ap (Lg.add d) (LL.neg-cancel e)) (Lg.addZ d))))
          (trans (ap (\ t -> Lg.add t e) h) (LL.zl e)) ;
  -- the coefficients through iota
  coeffs (c : Ps.Fin four -> Ex) :
    Id Lg.R (SL.sum four (\ k -> Lg.mul (val (mE k)) (eval Lg al be al be (c k))))
            (SL.sum four (\ k -> Lg.mul (val (mE k)) (iota.1 (valA (c k))))) =
    SL.sum-cong four (\ k -> Lg.mul (val (mE k)) (eval Lg al be al be (c k))) (\ k -> Lg.mul (val (mE k)) (iota.1 (valA (c k))))
      (\ k -> ap (Lg.mul (val (mE k))) (sym (PM.hom-eval a b a b (c k)))) ;

  m (i : Ps.Fin four) : Lg.R = val (mE i) ;
  gam (i j k : Ps.Fin four) : A.R = valA (gamE i j k) ;
  Cell (i j : Ps.Fin four) : U l = Id Lg.R (Lg.mul (m i) (m j)) (SL.sum four (\ k -> Lg.mul (m k) (iota.1 (gam i j k)))) ;
  cell00 : Cell f0 f0 =
    trans (sub-eq (Lg.mul (m f0) (m f0)) (val (combE gam00))
             (modpq (addE (mulE (mE f0) (mE f0)) (negE (combE gam00))) U00 V00 (refl (RN0.norm (addE (mulE p-ex U00) (mulE q-ex V00))))))
          (coeffs gam00) ;
  cell01 : Cell f0 f1 =
    trans (sub-eq (Lg.mul (m f0) (m f1)) (val (combE gam01))
             (modpq (addE (mulE (mE f0) (mE f1)) (negE (combE gam01))) U01 V01 (refl (RN0.norm (addE (mulE p-ex U01) (mulE q-ex V01))))))
          (coeffs gam01) ;
  cell02 : Cell f0 f2 =
    trans (sub-eq (Lg.mul (m f0) (m f2)) (val (combE gam02))
             (modpq (addE (mulE (mE f0) (mE f2)) (negE (combE gam02))) U02 V02 (refl (RN0.norm (addE (mulE p-ex U02) (mulE q-ex V02))))))
          (coeffs gam02) ;
  cell03 : Cell f0 f3 =
    trans (sub-eq (Lg.mul (m f0) (m f3)) (val (combE gam03))
             (modpq (addE (mulE (mE f0) (mE f3)) (negE (combE gam03))) U03 V03 (refl (RN0.norm (addE (mulE p-ex U03) (mulE q-ex V03))))))
          (coeffs gam03) ;
  cell10 : Cell f1 f0 =
    trans (sub-eq (Lg.mul (m f1) (m f0)) (val (combE gam10))
             (modpq (addE (mulE (mE f1) (mE f0)) (negE (combE gam10))) U10 V10 (refl (RN0.norm (addE (mulE p-ex U10) (mulE q-ex V10))))))
          (coeffs gam10) ;
  cell11 : Cell f1 f1 =
    trans (sub-eq (Lg.mul (m f1) (m f1)) (val (combE gam11))
             (modpq (addE (mulE (mE f1) (mE f1)) (negE (combE gam11))) U11 V11 (refl (RN0.norm (addE (mulE p-ex U11) (mulE q-ex V11))))))
          (coeffs gam11) ;
  cell12 : Cell f1 f2 =
    trans (sub-eq (Lg.mul (m f1) (m f2)) (val (combE gam12))
             (modpq (addE (mulE (mE f1) (mE f2)) (negE (combE gam12))) U12 V12 (refl (RN0.norm (addE (mulE p-ex U12) (mulE q-ex V12))))))
          (coeffs gam12) ;
  cell13 : Cell f1 f3 =
    trans (sub-eq (Lg.mul (m f1) (m f3)) (val (combE gam13))
             (modpq (addE (mulE (mE f1) (mE f3)) (negE (combE gam13))) U13 V13 (refl (RN0.norm (addE (mulE p-ex U13) (mulE q-ex V13))))))
          (coeffs gam13) ;
  cell20 : Cell f2 f0 =
    trans (sub-eq (Lg.mul (m f2) (m f0)) (val (combE gam20))
             (modpq (addE (mulE (mE f2) (mE f0)) (negE (combE gam20))) U20 V20 (refl (RN0.norm (addE (mulE p-ex U20) (mulE q-ex V20))))))
          (coeffs gam20) ;
  cell21 : Cell f2 f1 =
    trans (sub-eq (Lg.mul (m f2) (m f1)) (val (combE gam21))
             (modpq (addE (mulE (mE f2) (mE f1)) (negE (combE gam21))) U21 V21 (refl (RN0.norm (addE (mulE p-ex U21) (mulE q-ex V21))))))
          (coeffs gam21) ;
  cell22 : Cell f2 f2 =
    trans (sub-eq (Lg.mul (m f2) (m f2)) (val (combE gam22))
             (modpq (addE (mulE (mE f2) (mE f2)) (negE (combE gam22))) U22 V22 (refl (RN0.norm (addE (mulE p-ex U22) (mulE q-ex V22))))))
          (coeffs gam22) ;
  cell23 : Cell f2 f3 =
    trans (sub-eq (Lg.mul (m f2) (m f3)) (val (combE gam23))
             (modpq (addE (mulE (mE f2) (mE f3)) (negE (combE gam23))) U23 V23 (refl (RN0.norm (addE (mulE p-ex U23) (mulE q-ex V23))))))
          (coeffs gam23) ;
  cell30 : Cell f3 f0 =
    trans (sub-eq (Lg.mul (m f3) (m f0)) (val (combE gam30))
             (modpq (addE (mulE (mE f3) (mE f0)) (negE (combE gam30))) U30 V30 (refl (RN0.norm (addE (mulE p-ex U30) (mulE q-ex V30))))))
          (coeffs gam30) ;
  cell31 : Cell f3 f1 =
    trans (sub-eq (Lg.mul (m f3) (m f1)) (val (combE gam31))
             (modpq (addE (mulE (mE f3) (mE f1)) (negE (combE gam31))) U31 V31 (refl (RN0.norm (addE (mulE p-ex U31) (mulE q-ex V31))))))
          (coeffs gam31) ;
  cell32 : Cell f3 f2 =
    trans (sub-eq (Lg.mul (m f3) (m f2)) (val (combE gam32))
             (modpq (addE (mulE (mE f3) (mE f2)) (negE (combE gam32))) U32 V32 (refl (RN0.norm (addE (mulE p-ex U32) (mulE q-ex V32))))))
          (coeffs gam32) ;
  cell33 : Cell f3 f3 =
    trans (sub-eq (Lg.mul (m f3) (m f3)) (val (combE gam33))
             (modpq (addE (mulE (mE f3) (mE f3)) (negE (combE gam33))) U33 V33 (refl (RN0.norm (addE (mulE p-ex U33) (mulE q-ex V33))))))
          (coeffs gam33) ;
  table : (i j : Ps.Fin four) -> Cell i j =
    elim4 (\ i -> (j : Ps.Fin four) -> Cell i j)
      (elim4 (Cell f0) cell00 cell01 cell02 cell03)
      (elim4 (Cell f1) cell10 cell11 cell12 cell13)
      (elim4 (Cell f2) cell20 cell21 cell22 cell23)
      (elim4 (Cell f3) cell30 cell31 cell32 cell33) ;

  -- 1 = sum_k e_k m_k with e = (1, 0, 0, 0)
  e : Ps.Fin four -> Lg.R = pick4 Lg.R Lg.o Lg.z Lg.z Lg.z ;
  one : Id Lg.R (SL.lin four e m) Lg.o =
    RN.same-value (addE (mulE zeroE (mE f3)) (addE (mulE zeroE (mE f2)) (addE (mulE zeroE (mE f1)) (addE (mulE oneE (mE f0)) zeroE))))
      oneE (refl (RN0.norm oneE)) ;

  module IS = IntegralSections[l].Over[A,setA,Lg,setL,iota,four,m,e,one,gam,table] ;

  -- s, s x, s y and their coordinates on the m_k
  s : Lg.R = val s-ex ;
  coord (ee : Ex) (c : Ps.Fin four -> Ex) (cu cv : Ex)
    (h : Id (List RN0.Term) (RN0.norm (addE ee (negE (combE c)))) (RN0.norm (addE (mulE p-ex cu) (mulE q-ex cv)))) :
    Id Lg.R (val ee) (val (combE c)) = sub-eq (val ee) (val (combE c)) (modpq (addE ee (negE (combE c))) cu cv h) ;
  coord-s : Id Lg.R s (IS.elt (\ k -> valA (s-c k))) =
    trans (coord s-ex s-c U-s V-s (refl (RN0.norm (addE (mulE p-ex U-s) (mulE q-ex V-s))))) (coeffs s-c) ;
  coord-sx : Id Lg.R (Lg.mul s x) (IS.elt (\ k -> valA (sx-c k))) =
    trans (coord (mulE s-ex vx) sx-c U-sx V-sx (refl (RN0.norm (addE (mulE p-ex U-sx) (mulE q-ex V-sx))))) (coeffs sx-c) ;
  coord-sy : Id Lg.R (Lg.mul s y) (IS.elt (\ k -> valA (sy-c k))) =
    trans (coord (mulE s-ex vy) sy-c U-sy V-sy (refl (RN0.norm (addE (mulE p-ex U-sy) (mulE q-ex V-sy))))) (coeffs sy-c) ;

  -- s = 1 + a r + b t
  residual : Id Lg.R s (Lg.add Lg.o (Lg.add (Lg.mul al (val r-ex)) (Lg.mul be (val t-ex)))) =
    RN.same-value s-ex (addE oneE (addE (mulE va r-ex) (mulE vb t-ex)))
      (refl (RN0.norm (addE oneE (addE (mulE va r-ex) (mulE vb t-ex))))) ;

  ------------------------------------------------------------------------
  -- the certificate

  module CP = CharPoly[l].Over[A,setA] ;
  -- f of degree <= 4 with X^4-coefficient 1 (monic of degree 4), coefficients in A, and f(v) = 0 in L
  MonicRoot (v : Lg.R) : U l =
    (f : CP.B.Carrier) * (CP.Bounded (suc four) f * (Id A.R (CP.coef f four) A.o
      * Id Lg.R ((Universal[l].Property[A,Lg,setA,setL].Given[iota,v].extend).1 f) Lg.z)) ;
  monic-root (c : Ps.Fin four -> A.R) (v : Lg.R) (h : Id Lg.R v (IS.elt c)) : MonicRoot v =
    subst MonicRoot (sym h) (IS.At[c].chi, IS.At[c].integral) ;

  certificate :
    ((r t : Lg.R) * Id Lg.R s (Lg.add Lg.o (Lg.add (Lg.mul al r) (Lg.mul be t))))
    * (MonicRoot s * (MonicRoot (Lg.mul s x) * MonicRoot (Lg.mul s y))) =
    ((val r-ex, (val t-ex, residual)),
     (monic-root (\ k -> valA (s-c k)) s coord-s,
      (monic-root (\ k -> valA (sx-c k)) (Lg.mul s x) coord-sx,
       monic-root (\ k -> valA (sy-c k)) (Lg.mul s y) coord-sy))) ;
} ;
