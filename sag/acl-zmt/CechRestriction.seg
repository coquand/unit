-- CechRestriction.seg: the restriction of the sections to the chart Z,
-- dehomogenised (acl-zmt-formalisation.tex, Lemme modele (3) and (4);
-- Lemme regroupement; Liste item 3).
--
-- For x, y in a ring L (through iota : A -> L), a list g of terms c X^e
-- restricts to  res(g) = sum_{c X^e in g} iota(c) x^(e_X) y^(e_Y)
-- (the exponent of Z is forgotten; negative exponents of X or Y give 0).
-- By the regrouping lemma res(g) depends only on coef g, so it is defined on
-- finitely supported functions (LaurentList.Descend).  On lists whose
-- exponents of X and Y are >= 0 it is multiplicative: res(g h) = res g res h.
-- Every function used has the support conditions of the chart Z (exponents
-- of X and Y >= 0), so it is the meaning of such a list (filtering).
-- Consequences: res is A-linear on the sections of degree 0, res 1 = 1,
-- res(c c') = res c res c', res(X w) = x res(Z w), res(Y w) = y res(Z w),
-- res(Z Z^-1) = 1, and res kills N0 = P U + Q V as soon as p(x,y) = res P = 0
-- and q(x,y) = res Q = 0.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module IP = IdealPowers[l] ; module RC = ReesLiftingCong[l] ;
module Tr = Truncation[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ; module NA = NatArith[l] ; module CMn = CechMonomials[l] ;

and-false-cases : (b c : Bool) -> Id Bool (and b c) false -> Plus (Id Bool b false) (Id Bool c false) = split {
  true -> \ c h -> inr h ;
  false -> \ c h -> inl (refl false) } ;

module Over (A : CRing) (setA : Pr.isSet A.R) (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R) {
  module LO = Laurent3[l].Over[A] ; open LO ;
  module CO = Cech3[l].Over[A] ;
  module LL = LaurentList[l].Over[A] ;
  module CMd = CechModules[l].Over[A,setA] ;
  module CS = CechSections[l].Over[A,setA] ;
  module LLg = RL[Lg] ; module LA = RL[A] ;

  pw (u : Lg.R) : Nat -> Lg.R = split { zero -> Lg.o ; suc n | r -> Lg.mul u r } ;
  xp : Int -> Lg.R = split { pos n -> pw x n ; negsuc n -> Lg.z } ;
  yp : Int -> Lg.R = split { pos n -> pw y n ; negsuc n -> Lg.z } ;
  psiR (e : E3) (c : A.R) : Lg.R = Lg.mul (iota.1 c) (Lg.mul (xp (ex e)) (yp (ey e))) ;
  psiR-add (e : E3) (u v : A.R) : Id Lg.R (psiR e (A.add u v)) (Lg.add (psiR e u) (psiR e v)) =
    trans (ap (\ t -> Lg.mul t (Lg.mul (xp (ex e)) (yp (ey e)))) (iota.2.2.1 u v)) (LLg.dist-left (iota.1 u) (iota.1 v) (Lg.mul (xp (ex e)) (yp (ey e)))) ;
  module RS = LL.Sums[Lg,psiR,psiR-add] ;
  module RG = LL.Regroup[Lg,psiR,psiR-add] ;
  resL (g : LPoly) : Lg.R = RS.sumPsi g ;
  module DR = LL.Descend[Lg.R,setL,resL,RG.respects] ;
  resF (f : Lau) (hf : LL.Fin f) : Lg.R = DR.value f hf ;

  ------------------------------------------------------------------------
  -- lists

  resL-scale (c : A.R) : (g : LPoly) -> Id Lg.R (resL (scaleList c g)) (Lg.mul (iota.1 c) (resL g)) = split {
    nil -> sym (LLg.mul-zero (iota.1 c)) ;
    cons t g | r -> trans (Ps.cong2 Lg.R Lg.add _ _ _ _
                            (trans (ap (\ s -> Lg.mul s (Lg.mul (xp (ex t.2)) (yp (ey t.2)))) (iota.2.2.2 c t.1))
                                   (sym (Lg.mulA (iota.1 c) (iota.1 t.1) (Lg.mul (xp (ex t.2)) (yp (ey t.2))))))
                            r)
                     (sym (Lg.dist (iota.1 c) (psiR t.2 t.1) (resL g))) } ;

  -- exponents of X and Y >= 0
  NN : LPoly -> U l = split { nil -> Top ; cons t g | r -> (Id Bool (isNeg (ex t.2)) false * Id Bool (isNeg (ey t.2)) false) * r } ;
  pw-add (u : Lg.R) : (i j : Nat) -> Id Lg.R (pw u (NA.plus i j)) (Lg.mul (pw u i) (pw u j)) = split {
    zero -> \ j -> sym (LLg.one-left (pw u j)) ;
    suc i | r -> \ j -> trans (ap (Lg.mul u) (r j)) (Lg.mulA u (pw u i) (pw u j)) } ;
  xp-add : (a b : Int) -> Id Bool (isNeg a) false -> Id Bool (isNeg b) false -> Id Lg.R (xp (add a b)) (Lg.mul (xp a) (xp b)) = split {
    pos i -> split {
      pos j -> \ ha hb -> trans (ap xp (CechSections[l].add-pos i j)) (trans (pw-add x j i) (Lg.mulC (pw x j) (pw x i))) ;
      negsuc j -> \ ha hb -> P.absurd (Id Lg.R (xp (add (pos i) (negsuc j))) (Lg.mul (xp (pos i)) (xp (negsuc j)))) (encodeB true false hb) } ;
    negsuc i -> \ b ha hb -> P.absurd (Id Lg.R (xp (add (negsuc i) b)) (Lg.mul (xp (negsuc i)) (xp b))) (encodeB true false ha) } ;
  yp-add : (a b : Int) -> Id Bool (isNeg a) false -> Id Bool (isNeg b) false -> Id Lg.R (yp (add a b)) (Lg.mul (yp a) (yp b)) = split {
    pos i -> split {
      pos j -> \ ha hb -> trans (ap yp (CechSections[l].add-pos i j)) (trans (pw-add y j i) (Lg.mulC (pw y j) (pw y i))) ;
      negsuc j -> \ ha hb -> P.absurd (Id Lg.R (yp (add (pos i) (negsuc j))) (Lg.mul (yp (pos i)) (yp (negsuc j)))) (encodeB true false hb) } ;
    negsuc i -> \ b ha hb -> P.absurd (Id Lg.R (yp (add (negsuc i) b)) (Lg.mul (yp (negsuc i)) (yp b))) (encodeB true false ha) } ;
  psiR-shift (t u : LL.Term) (nt : Id Bool (isNeg (ex t.2)) false * Id Bool (isNeg (ey t.2)) false)
    (nu : Id Bool (isNeg (ex u.2)) false * Id Bool (isNeg (ey u.2)) false) :
    Id Lg.R (psiR (LaurentList[l].add3 t.2 u.2) (A.mul t.1 u.1)) (Lg.mul (psiR t.2 t.1) (psiR u.2 u.1)) =
    calc Lg.R {
      psiR (LaurentList[l].add3 t.2 u.2) (A.mul t.1 u.1)
        =< Ps.cong2 Lg.R Lg.mul _ _ _ _ (iota.2.2.2 t.1 u.1)
             (Ps.cong2 Lg.R Lg.mul _ _ _ _ (xp-add (ex t.2) (ex u.2) nt.1 nu.1) (yp-add (ey t.2) (ey u.2) nt.2 nu.2))
        > Lg.mul (Lg.mul (iota.1 t.1) (iota.1 u.1)) (Lg.mul (Lg.mul (xp (ex t.2)) (xp (ex u.2))) (Lg.mul (yp (ey t.2)) (yp (ey u.2))))
        =< ap (Lg.mul (Lg.mul (iota.1 t.1) (iota.1 u.1))) (LLg.mul-four (xp (ex t.2)) (xp (ex u.2)) (yp (ey t.2)) (yp (ey u.2)))
        > Lg.mul (Lg.mul (iota.1 t.1) (iota.1 u.1)) (Lg.mul (Lg.mul (xp (ex t.2)) (yp (ey t.2))) (Lg.mul (xp (ex u.2)) (yp (ey u.2))))
        =< LLg.mul-four (iota.1 t.1) (iota.1 u.1) (Lg.mul (xp (ex t.2)) (yp (ey t.2))) (Lg.mul (xp (ex u.2)) (yp (ey u.2)))
        > Lg.mul (psiR t.2 t.1) (psiR u.2 u.1) } ;
  resL-map (t : LL.Term) (nt : Id Bool (isNeg (ex t.2)) false * Id Bool (isNeg (ey t.2)) false) :
    (h : LPoly) -> NN h -> Id Lg.R (resL (CMn.mapL LL.Term LL.Term (LL.shiftT t) h)) (Lg.mul (psiR t.2 t.1) (resL h)) = split {
    nil -> \ nh -> sym (LLg.mul-zero (psiR t.2 t.1)) ;
    cons u h | r -> \ nh -> trans (Ps.cong2 Lg.R Lg.add _ _ _ _ (psiR-shift t u nt nh.1) (r nh.2))
                            (sym (Lg.dist (psiR t.2 t.1) (psiR u.2 u.1) (resL h))) } ;
  resL-mulL : (g h : LPoly) -> NN g -> NN h -> Id Lg.R (resL (LL.mulL g h)) (Lg.mul (resL g) (resL h)) = split {
    nil -> \ h ng nh -> sym (trans (Lg.mulC Lg.z (resL h)) (LLg.mul-zero (resL h))) ;
    cons t g | r -> \ h ng nh ->
      trans (RS.sumPsi-app (CMn.mapL LL.Term LL.Term (LL.shiftT t) h) (LL.mulL g h))
        (trans (Ps.cong2 Lg.R Lg.add _ _ _ _ (resL-map t ng.1 h nh) (r h ng.2 nh))
               (sym (LLg.dist-left (psiR t.2 t.1) (resL g) (resL h)))) } ;

  -- a representing list with exponents of X and Y >= 0
  qXY (e : E3) : Bool = and (not (isNeg (ex e))) (not (isNeg (ey e))) ;
  vanXY (f : Lau) (hx : NNX f) (hy : NNY f) (m : E3) (h : Id Bool (qXY m) false) : Id A.R (f m) A.z =
    vanXY-c (and-false-cases (not (isNeg (ex m))) (not (isNeg (ey m))) h)
    where { vanXY-c : Plus (Id Bool (not (isNeg (ex m))) false) (Id Bool (not (isNeg (ey m))) false) -> Id A.R (f m) A.z = split {
              inl e -> hx m (CechSections[l].not-false (isNeg (ex m)) e) ;
              inr e -> hy m (CechSections[l].not-false (isNeg (ey m)) e) } } ;
  allq-nn : (g : LPoly) -> LL.AllQ qXY g -> NN g = split {
    nil -> \ h -> tt ;
    cons t g | r -> \ h -> ((CechSections[l].not-true (isNeg (ex t.2)) (CMn.and-l (not (isNeg (ex t.2))) (not (isNeg (ey t.2))) h.1),
                              CechSections[l].not-true (isNeg (ey t.2)) (CMn.and-r (not (isNeg (ex t.2))) (not (isNeg (ey t.2))) h.1)), r h.2) } ;
  module RepXY (f : Lau) (hx : NNX f) (hy : NNY f) (w : LL.FinW f) {
    g : LPoly = LL.filt qXY w.1 ;
    e : EqL (LL.coef g) f = LL.filt-coef qXY f (vanXY f hx hy) w.1 w.2 ;
    nn : NN g = allq-nn g (LL.allq-filt qXY w.1) ;
  } ;
  -- eliminating the truncation into an equation of L
  module ElimL (f : Lau) (hf : LL.Fin f) (a b : Lg.R) (step : LL.FinW f -> Id Lg.R a b) {
    out : Id Lg.R a b = Tr.Trunc[LL.FinW f].induction @l (\ u -> Id Lg.R a b) (\ u -> setL a b) step hf ;
  } ;

  ------------------------------------------------------------------------
  -- resF on functions

  resF-add (f g : Lau) (hf : LL.Fin f) (hg : LL.Fin g) (hfg : LL.Fin (addL f g)) :
    Id Lg.R (resF (addL f g) hfg) (Lg.add (resF f hf) (resF g hg)) =
    ElimL[f,hf,resF (addL f g) hfg,Lg.add (resF f hf) (resF g hg),\ w ->
      ElimL[g,hg,resF (addL f g) hfg,Lg.add (resF f hf) (resF g hg),\ w' ->
        trans (DR.beta (addL f g) hfg (Bar[l].app w.1 w'.1) (\ m -> trans (LL.coef-app w.1 w'.1 m) (DG.cong-add (w.2 m) (w'.2 m))))
          (trans (RS.sumPsi-app w.1 w'.1) (sym (Presentations[l].cong2 Lg.R Lg.add _ _ _ _ (DR.beta f hf w.1 w.2) (DR.beta g hg w'.1 w'.2))))].out].out ;
  resF-sm (c : A.R) (f : Lau) (hf : LL.Fin f) (hcf : LL.Fin (scaleL c f)) :
    Id Lg.R (resF (scaleL c f) hcf) (Lg.mul (iota.1 c) (resF f hf)) =
    ElimL[f,hf,resF (scaleL c f) hcf,Lg.mul (iota.1 c) (resF f hf),\ w ->
      trans (DR.beta (scaleL c f) hcf (scaleList c w.1) (\ m -> trans (LL.coef-scaleList c w.1 m) (ap (A.mul c) (w.2 m))))
        (trans (resL-scale c w.1) (ap (Lg.mul (iota.1 c)) (sym (DR.beta f hf w.1 w.2))))].out ;
  -- a polynomial g with exponents >= 0 times f
  resF-mulP (g : LPoly) (ng : NN g) (f : Lau) (hf : LL.Fin f) (hx : NNX f) (hy : NNY f) (hgf : LL.Fin (mulP g f)) :
    Id Lg.R (resF (mulP g f) hgf) (Lg.mul (resL g) (resF f hf)) =
    ElimL[f,hf,resF (mulP g f) hgf,Lg.mul (resL g) (resF f hf),\ w ->
      trans (DR.beta (mulP g f) hgf (LL.mulL g RepXY[f,hx,hy,w].g)
               (\ m -> trans (LL.coef-mulL g RepXY[f,hx,hy,w].g m) (mulP-cong g (LL.coef RepXY[f,hx,hy,w].g) f RepXY[f,hx,hy,w].e m)))
        (trans (resL-mulL g RepXY[f,hx,hy,w].g ng RepXY[f,hx,hy,w].nn)
               (ap (Lg.mul (resL g)) (sym (DR.beta f hf RepXY[f,hx,hy,w].g RepXY[f,hx,hy,w].e))))].out ;
  -- the product of two finitely supported functions
  resF-prod (f g : Lau) (hf : LL.Fin f) (hg : LL.Fin g) (hx : NNX f) (hy : NNY f) (gx : NNX g) (gy : NNY g) (hfg : LL.Fin (CS.prod f g hf)) :
    Id Lg.R (resF (CS.prod f g hf) hfg) (Lg.mul (resF f hf) (resF g hg)) =
    ElimL[f,hf,resF (CS.prod f g hf) hfg,Lg.mul (resF f hf) (resF g hg),\ w ->
      ElimL[g,hg,resF (CS.prod f g hf) hfg,Lg.mul (resF f hf) (resF g hg),\ w' ->
        trans (DR.beta (CS.prod f g hf) hfg (LL.mulL RepXY[f,hx,hy,w].g RepXY[g,gx,gy,w'].g)
                 (\ m -> trans (LL.coef-mulL RepXY[f,hx,hy,w].g RepXY[g,gx,gy,w'].g m)
                           (trans (mulP-cong RepXY[f,hx,hy,w].g (LL.coef RepXY[g,gx,gy,w'].g) g RepXY[g,gx,gy,w'].e m)
                                  (sym (CS.PR.prod-beta f g hf RepXY[f,hx,hy,w].g RepXY[f,hx,hy,w].e m)))))
          (trans (resL-mulL RepXY[f,hx,hy,w].g RepXY[g,gx,gy,w'].g RepXY[f,hx,hy,w].nn RepXY[g,gx,gy,w'].nn)
                 (Presentations[l].cong2 Lg.R Lg.mul _ _ _ _ (sym (DR.beta f hf RepXY[f,hx,hy,w].g RepXY[f,hx,hy,w].e))
                                                       (sym (DR.beta g hg RepXY[g,gx,gy,w'].g RepXY[g,gx,gy,w'].e))))].out].out ;
} ;
