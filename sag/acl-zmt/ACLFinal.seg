-- ACLFinal.seg: the example of ACL §4.4 by the cohomological construction,
-- with every datum constructed: for k a discrete field and A = k[b][a],
--     p = x - a + b x y + 2 b x^2 ,   q = y - b + a x^2 + a x y + b y^2 ,
-- for every ring map A -> L and x, y in L with p(x,y) = q(x,y) = 0 there
-- merely is s in L with  s = 1 + a r + b t  and s, s x, s y roots of monic
-- polynomials over A.
--
-- The proof is ACLCech (CechZMT, ACLZMTCong: finite correction, Rees
-- lifting, the two shortcuts (F1) and (F2)) with
--   * (S1) from ACLS1 (any commutative ring k);
--   * the coded noetherian presentation of A: the discrete field k is
--     noetherian (Field), its image in A (Transfer) with a and b adjoined is
--     noetherian (Generated, Hilbert basis theorem), and every element of A
--     merely has a code: A = R1[a] and R1 = k[b] are quotients of lists of
--     coefficients, and Horner's rule writes include (c :: p) = c + a p
--     (CodedSubring: codes are closed under the ring operations).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ;
module PE = PolyExpr[l] ; module AD = ACLExampleData[l] ;

module Over (k : CRing) (setk : Pr.isSet k.R)
  (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o)) {
  module S = ACLS1[l].Over[k,setk] ;
  A : CRing = S.A ;
  h : H.Hom k A = H.compose k S.R1 A S.E2.inclusion S.E1.inclusion ;
  module TA = Transfer[l].Over[k,A,h.1,h.2.1,h.2.2.1,h.2.2.2,Field[l].self k] ;
  module Gn = Generated[l].Over[A,TA.image,TA.noeth (Field[l].Over[k,dec].noeth)] ;
  xs : List A.R = cons S.a (cons S.b nil) ;
  PA : Span[l].Pres[A] = Gn.gen xs ;
  nA : Span[l].Over[A,PA].Noeth = Gn.noeth xs ;
  module C = CodedSubring[l].Over[A,PA] ;

  -- every element of A merely has a code
  coded-k (c : k.R) : C.Coded (h.1 c) = C.known (Gn.base xs c) (h.1 c) (Gn.base-phi xs c) ;
  coded-a : C.Coded S.a = C.known (Gn.var S.a (cons S.b nil)) S.a (Gn.var-phi S.a (cons S.b nil)) ;
  coded-b : C.Coded S.b =
    C.known (Gn.up S.a (cons S.b nil) (Gn.var S.b nil)) S.b (trans (Gn.up-phi S.a (cons S.b nil) (Gn.var S.b nil)) (Gn.var-phi S.b nil)) ;
  coded-z : C.Coded A.z = C.known PA.kz A.z PA.phi-z ;
  -- constant (d + b q) = h d + b constant q
  eqn (d : k.R) (q : List k.R) :
    Id A.R (S.E2.constant (S.E1.include (cons d q))) (A.add (h.1 d) (A.mul S.b (S.E2.constant (S.E1.include q)))) =
    trans (ap S.E2.constant (S.E1.horner d q))
      (trans (S.E2.constant-add (S.E1.constant d) (S.E1.mulQ S.E1.variable (S.E1.include q)))
             (ap (A.add (h.1 d)) (S.E2.constant-mul S.E1.variable (S.E1.include q)))) ;
  coded-R1-list : (q : List k.R) -> C.Coded (S.E2.constant (S.E1.include q)) = split {
    nil -> subst C.Coded (sym (H.zero S.R1 A S.E2.inclusion)) coded-z ;
    cons d q | r -> subst C.Coded (sym (eqn d q))
      (C.coded-add (h.1 d) (A.mul S.b (S.E2.constant (S.E1.include q))) (coded-k d) (C.coded-mul S.b (S.E2.constant (S.E1.include q)) coded-b r)) } ;
  coded-R1 (c : S.R1.R) : C.Coded (S.E2.constant c) =
    S.E1.Q.induction @l (\ q -> C.Coded (S.E2.constant q)) (\ q -> C.coded-prop (S.E2.constant q)) coded-R1-list c ;
  coded-list : (p : List S.R1.R) -> C.Coded (S.E2.include p) = split {
    nil -> coded-z ;
    cons c p | r -> subst C.Coded (sym (S.E2.horner c p))
      (C.coded-add (S.E2.constant c) (A.mul S.a (S.E2.include p)) (coded-R1 c) (C.coded-mul S.a (S.E2.include p) coded-a r)) } ;
  onto (x : A.R) : C.Coded x = S.E2.Q.induction @l (\ q -> C.Coded q) (\ q -> C.coded-prop q) coded-list x ;

  -- the theorem
  module Example (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
    (hp : Id Lg.R (PE.eval Lg (iota.1 S.a) (iota.1 S.b) x y AD.p-ex) Lg.z)
    (hq : Id Lg.R (PE.eval Lg (iota.1 S.a) (iota.1 S.b) x y AD.q-ex) Lg.z) {
    module AC = ACLCech[l].Over[A,S.setA,PA,nA,onto,S.a,S.b,S.s1,Lg,setL,iota,x,y,hp,hq] ;
    certificate : AC.CZ.Z.TC.carrier = AC.certificate ;
  } ;
} ;
