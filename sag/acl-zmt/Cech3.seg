-- Cech3.seg: the Cech complex of the three standard charts of P^2_D, on
-- Laurent coefficients (handoff §2 and §6).
--
-- A 0-cochain is (c_X, c_Y, c_Z), a 1-cochain is (b_XY, b_XZ, b_YZ), a
-- 2-cochain is one Laurent element on XYZ:
--     delta0 c = (c_Y - c_X, c_Z - c_X, c_Z - c_Y) ,
--     delta1 b = (b_YZ - b_XZ) + b_XY ,
-- and delta1 delta0 = 0.  The localisation at the variables of a chart is
-- the support condition: the variables not inverted have exponents >= 0
-- wherever the coefficient is nonzero (NNX, NNY, NNZ of Laurent3).  So
--     c_X : NNY, NNZ    c_Y : NNX, NNZ    c_Z : NNX, NNY
--     b_XY : NNZ        b_XZ : NNY        b_YZ : NNX .
-- The product by a polynomial with nonnegative exponents acts on each
-- component and commutes with delta0 and delta1.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;

module Over (D : CRing) {
  module LO = Laurent3[l].Over[D] ; open LO ;

  -- triples of Laurent elements: 0-cochains and 1-cochains
  Tri : U l = Lau * (Lau * Lau) ;
  mkT (u v w : Lau) : Tri = (u, (v, w)) ;
  t1 (c : Tri) : Lau = c.1 ;
  t2 (c : Tri) : Lau = c.2.1 ;
  t3 (c : Tri) : Lau = c.2.2 ;

  EqT (c c' : Tri) : U l = EqL (t1 c) (t1 c') * (EqL (t2 c) (t2 c') * EqL (t3 c) (t3 c')) ;
  zeroT : Tri = mkT zeroL zeroL zeroL ;
  addT (c c' : Tri) : Tri = mkT (addL (t1 c) (t1 c')) (addL (t2 c) (t2 c')) (addL (t3 c) (t3 c')) ;
  subT (c c' : Tri) : Tri = mkT (subL (t1 c) (t1 c')) (subL (t2 c) (t2 c')) (subL (t3 c) (t3 c')) ;
  scaleT (a : D.R) (c : Tri) : Tri = mkT (scaleL a (t1 c)) (scaleL a (t2 c)) (scaleL a (t3 c)) ;
  mulT (g : LPoly) (c : Tri) : Tri = mkT (mulP g (t1 c)) (mulP g (t2 c)) (mulP g (t3 c)) ;

  eqT-refl (c : Tri) : EqT c c = (\ m -> refl (t1 c m), (\ m -> refl (t2 c m), \ m -> refl (t3 c m))) ;
  eqT-sym (c c' : Tri) (e : EqT c c') : EqT c' c =
    (\ m -> sym (e.1 m), (\ m -> sym (e.2.1 m), \ m -> sym (e.2.2 m))) ;
  eqT-trans (c c' c'' : Tri) (e : EqT c c') (e' : EqT c' c'') : EqT c c'' =
    (\ m -> trans (e.1 m) (e'.1 m), (\ m -> trans (e.2.1 m) (e'.2.1 m), \ m -> trans (e.2.2 m) (e'.2.2 m))) ;

  -- the differentials
  d0 (c : Tri) : Tri = mkT (subL (t2 c) (t1 c)) (subL (t3 c) (t1 c)) (subL (t3 c) (t2 c)) ;
  d1 (b : Tri) : Lau = addL (subL (t3 b) (t2 b)) (t1 b) ;

  ------------------------------------------------------------------------
  -- ring identities

  -- (x - u) + u = x
  sub-add (x u : D.R) : Id D.R (D.add (D.add x (D.neg u)) u) x =
    trans (sym (D.addA x (D.neg u) u)) (trans (ap (D.add x) (L.neg-cancel u)) (D.addZ x)) ;
  -- y + (x - y) = x
  sub-add-l (x y : D.R) : Id D.R (D.add y (D.add x (D.neg y))) x =
    trans (D.addC y (D.add x (D.neg y))) (sub-add x y) ;
  -- (p + y) - p = y
  add-sub-l (p y : D.R) : Id D.R (D.add (D.add p y) (D.neg p)) y =
    trans (ap (\ t -> D.add t (D.neg p)) (D.addC p y)) (L.add-neg-cancel y p) ;
  -- ((w - v) - (w - u)) + (v - u) = 0
  dd-zero (u v w : D.R) :
    Id D.R (D.add (D.add (D.add w (D.neg v)) (D.neg (D.add w (D.neg u)))) (D.add v (D.neg u))) D.z =
    calc D.R { D.add (D.add (D.add w (D.neg v)) (D.neg (D.add w (D.neg u)))) (D.add v (D.neg u))
                 =< ap (\ t -> D.add (D.add (D.add w (D.neg v)) t) (D.add v (D.neg u))) (L.negsub w u)
                 > D.add (D.add (D.add w (D.neg v)) (D.add (D.neg w) u)) (D.add v (D.neg u))
                 =< ap (\ t -> D.add t (D.add v (D.neg u))) (L.swap w (D.neg v) (D.neg w) u)
                 > D.add (D.add (D.add w (D.neg w)) (D.add (D.neg v) u)) (D.add v (D.neg u))
                 =< ap (\ t -> D.add (D.add t (D.add (D.neg v) u)) (D.add v (D.neg u))) (D.addN w)
                 > D.add (D.add D.z (D.add (D.neg v) u)) (D.add v (D.neg u))
                 =< ap (\ t -> D.add t (D.add v (D.neg u))) (L.zl (D.add (D.neg v) u))
                 > D.add (D.add (D.neg v) u) (D.add v (D.neg u))
                 =< L.swap (D.neg v) u v (D.neg u) > D.add (D.add (D.neg v) v) (D.add u (D.neg u))
                 =< DG.cong-add (L.neg-cancel v) (D.addN u) > D.add D.z D.z
                 =< D.addZ D.z > D.z } ;
  -- (x - y) + (x' - y') = (x + x') - (y + y')
  sub-pair (x y x' y' : D.R) :
    Id D.R (D.add (D.add x (D.neg y)) (D.add x' (D.neg y'))) (D.add (D.add x x') (D.neg (D.add y y'))) =
    trans (L.swap x (D.neg y) x' (D.neg y')) (ap (D.add (D.add x x')) (sym (L.neg-add y y'))) ;
  -- ((a - b) + c) + ((a' - b') + c') = ((a + a') - (b + b')) + (c + c')
  lin3 (a b c a' b' c' : D.R) :
    Id D.R (D.add (D.add (D.add a (D.neg b)) c) (D.add (D.add a' (D.neg b')) c'))
           (D.add (D.add (D.add a a') (D.neg (D.add b b'))) (D.add c c')) =
    trans (L.swap (D.add a (D.neg b)) c (D.add a' (D.neg b')) c')
          (ap (\ t -> D.add t (D.add c c')) (sub-pair a b a' b')) ;
  -- -((a - b) + c) = (-a - -b) + -c
  neg3 (a b c : D.R) :
    Id D.R (D.neg (D.add (D.add a (D.neg b)) c)) (D.add (D.add (D.neg a) (D.neg (D.neg b))) (D.neg c)) =
    trans (L.neg-add (D.add a (D.neg b)) c) (ap (\ t -> D.add t (D.neg c)) (L.neg-add a (D.neg b))) ;
  -- x - y = 0 gives x = y
  sub-eq (x y : D.R) (h : Id D.R (D.add x (D.neg y)) D.z) : Id D.R x y =
    trans (sym (sub-add x y)) (trans (ap (\ t -> D.add t y) h) (L.zl y)) ;

  d1d0 (c : Tri) : EqL (d1 (d0 c)) zeroL = \ m -> dd-zero (t1 c m) (t2 c m) (t3 c m) ;

  -- delta1 is linear
  d1-add (b b' : Tri) : EqL (d1 (addT b b')) (addL (d1 b) (d1 b')) =
    \ m -> sym (lin3 (t3 b m) (t2 b m) (t1 b m) (t3 b' m) (t2 b' m) (t1 b' m)) ;
  d1-neg (b : Tri) : EqL (d1 (mkT (negL (t1 b)) (negL (t2 b)) (negL (t3 b)))) (negL (d1 b)) =
    \ m -> sym (neg3 (t3 b m) (t2 b m) (t1 b m)) ;
  d1-sub (b b' : Tri) : EqL (d1 (subT b b')) (subL (d1 b) (d1 b')) =
    \ m -> trans (sym (lin3 (t3 b m) (t2 b m) (t1 b m) (D.neg (t3 b' m)) (D.neg (t2 b' m)) (D.neg (t1 b' m))))
                 (ap (D.add (d1 b m)) (sym (neg3 (t3 b' m) (t2 b' m) (t1 b' m)))) ;
  d1-zero : EqL (d1 zeroT) zeroL = \ m -> trans (ap (\ t -> D.add t D.z) (D.addN D.z)) (D.addZ D.z) ;
  d1-cong (b b' : Tri) (e : EqT b b') : EqL (d1 b) (d1 b') =
    \ m -> DG.cong-add (DG.cong-add (e.2.2 m) (ap D.neg (e.2.1 m))) (e.1 m) ;

  -- the product by g commutes with delta1
  d1-mul (g : LPoly) (b : Tri) : EqL (d1 (mulT g b)) (mulP g (d1 b)) =
    \ m -> sym (trans (mulP-add g (subL (t3 b) (t2 b)) (t1 b) m)
                      (ap (\ t -> D.add t (mulP g (t1 b) m)) (mulP-sub g (t3 b) (t2 b) m))) ;

  ------------------------------------------------------------------------
  -- supports

  Supp0 (c : Tri) : U l = (NNY (t1 c) * NNZ (t1 c)) * ((NNX (t2 c) * NNZ (t2 c)) * (NNX (t3 c) * NNY (t3 c))) ;
  Supp1 (b : Tri) : U l = NNZ (t1 b) * (NNY (t2 b) * NNX (t3 b)) ;

  -- a pointwise combination of vanishing coefficients vanishes
  vanish-sub (x y : D.R) (hx : Id D.R x D.z) (hy : Id D.R y D.z) : Id D.R (D.add x (D.neg y)) D.z =
    trans (DG.cong-add hx (trans (ap D.neg hy) L.neg-zero)) (D.addZ D.z) ;
  vanish-add (x y : D.R) (hx : Id D.R x D.z) (hy : Id D.R y D.z) : Id D.R (D.add x y) D.z =
    trans (DG.cong-add hx hy) (D.addZ D.z) ;

  supp1-sub (b b' : Tri) (h : Supp1 b) (h' : Supp1 b') : Supp1 (subT b b') =
    (\ m e -> vanish-sub (t1 b m) (t1 b' m) (h.1 m e) (h'.1 m e),
     (\ m e -> vanish-sub (t2 b m) (t2 b' m) (h.2.1 m e) (h'.2.1 m e),
      \ m e -> vanish-sub (t3 b m) (t3 b' m) (h.2.2 m e) (h'.2.2 m e))) ;
  supp1-add (b b' : Tri) (h : Supp1 b) (h' : Supp1 b') : Supp1 (addT b b') =
    (\ m e -> vanish-add (t1 b m) (t1 b' m) (h.1 m e) (h'.1 m e),
     (\ m e -> vanish-add (t2 b m) (t2 b' m) (h.2.1 m e) (h'.2.1 m e),
      \ m e -> vanish-add (t3 b m) (t3 b' m) (h.2.2 m e) (h'.2.2 m e))) ;
  supp1-zero : Supp1 zeroT = (\ m e -> refl D.z, (\ m e -> refl D.z, \ m e -> refl D.z)) ;
  supp1-mul (g : LPoly) (ng : NonNeg g) (b : Tri) (h : Supp1 b) : Supp1 (mulT g b) =
    (nnz-mul g ng (t1 b) h.1, (nny-mul g ng (t2 b) h.2.1, nnx-mul g ng (t3 b) h.2.2)) ;
  supp1-cong (b b' : Tri) (e : EqT b b') (h : Supp1 b) : Supp1 b' =
    (\ m x -> trans (sym (e.1 m)) (h.1 m x),
     (\ m x -> trans (sym (e.2.1 m)) (h.2.1 m x), \ m x -> trans (sym (e.2.2 m)) (h.2.2 m x))) ;
} ;
