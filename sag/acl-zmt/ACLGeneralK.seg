-- ACLGeneralK.seg: ACL §4 by the cohomological construction for ANY two
-- equations over A = k[b][a], k a discrete field (1 /= 0):
--   P = muP + a FP + b GP  (chart XZ),   Q = muQ + a FQ + b GQ  (chart YZ),
-- homogeneous of degrees d0 + 1, e0 + 1, with exponents >= 0 and a non-zero
-- coefficient each (conditions of form, checked by computation for given
-- charts).  For every ring map A -> L and x, y in L with res P = res Q = 0
-- (i.e. p(x,y) = q(x,y) = 0) there merely is s = 1 + a r + b t in L with
-- s, s x, s y integral over A.
-- ACLGeneral with: the coded noetherian presentation of k[b][a] (ACLFinal),
-- the gcd domain k[b][a] (sag/gcd, Iterate).  No other hypothesis.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;

module Over (k : CRing) (setk : Pr.isSet k.R)
  (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o))
  (one-nonzero : Not (Id k.R k.o k.z)) {
  module F = ACLFinal[l].Over[k,setk,dec] ;
  module IT = Iterate[l].Over[k,setk,dec,one-nonzero] ;
  A : CRing = F.A ;
  a : A.R = F.S.a ;
  b : A.R = F.S.b ;
  G : GcdDomain[l].GcdDomain[A] = IT.gcdA ;
  module Charts
  -- the two charts
  (muP : E3) (FP GP : Laurent3[l].Over[A].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[A].NonNegY FP) (yG : Laurent3[l].Over[A].NonNegY GP)
  (dF : Laurent3[l].Over[A].HomPI (deg muP) FP) (dG : Laurent3[l].Over[A].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[A].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[A].NonNegX FQ) (xG : Laurent3[l].Over[A].NonNegX GQ)
  (dF' : Laurent3[l].Over[A].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[A].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[A,G.set].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[A,G.set].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (Laurent3[l].Over[A].monoP muP))
  (pmuQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (Laurent3[l].Over[A].monoP muQ))
  (pP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- P, Q homogeneous of degrees d0 + 1, e0 + 1
  (d0 e0 : Nat)
  (hPd : Laurent3[l].Over[A].HomPI (pos (suc d0)) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (hQe : Laurent3[l].Over[A].HomPI (pos (suc e0)) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- exponents >= 0, and a non-zero coefficient of each
  (hP0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) zero)
  (hQ0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) zero)
  (m0 : E3) (nP0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) m0) A.z))
  (n0 : E3) (nQ0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) n0) A.z))
  -- the target: x, y in L with p(x,y) = q(x,y) = 0
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (CechRestriction[l].Over[A,G.set,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) Lg.z)
  (hq : Id Lg.R (CechRestriction[l].Over[A,G.set,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) Lg.z) {
    module AG = ACLGeneral[l].Over[A,G,F.PA,F.nA,F.onto,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',
      pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,d0,e0,hPd,hQe,hP0,hQ0,m0,nP0,n0,nQ0,Lg,setL,iota,x,y,hp,hq] ;
    certificate : AG.CZ.Z.TC.carrier = AG.certificate ;
  } ;
} ;
