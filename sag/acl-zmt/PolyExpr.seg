-- PolyExpr.seg: polynomial expressions in a, b, x, y with integer
-- literals, their value in a commutative ring, and ring maps.
--
-- eval computes to the same term as the expressions printed by
-- sag/horrocks/ring_normalise.py (0, 1, n+1 = 1 + n, x - y = x + (-y)), so
-- an identity generated for an expression is an identity about its value,
-- by conversion.  A ring map commutes with the value (hom-eval).
level l ; open Ring[l] ;

data Ex = va | vb | vx | vy | zeroE | oneE | addE (e f : Ex) | mulE (e f : Ex) | negE (e : Ex) ;

eval (Rg : CRing) (a b x y : Rg.R) : Ex -> Rg.R = split {
  va -> a ; vb -> b ; vx -> x ; vy -> y ;
  zeroE -> Rg.z ; oneE -> Rg.o ;
  addE e f | re rf -> Rg.add re rf ;
  mulE e f | re rf -> Rg.mul re rf ;
  negE e | re -> Rg.neg re } ;

-- a ring map commutes with the value
module Map (S T : CRing) (h : RingHom[l].Hom S T) {
  module RH = RingHom[l] ;
  hom-eval (a b x y : S.R) : (e : Ex) ->
    Id T.R (h.1 (eval S a b x y e)) (eval T (h.1 a) (h.1 b) (h.1 x) (h.1 y) e) = split {
    va -> refl (h.1 a) ; vb -> refl (h.1 b) ; vx -> refl (h.1 x) ; vy -> refl (h.1 y) ;
    zeroE -> RH.zero S T h ;
    oneE -> h.2.1 ;
    addE e f | re rf -> trans (h.2.2.1 (eval S a b x y e) (eval S a b x y f)) (Presentations[l].cong2 T.R T.add _ _ _ _ re rf) ;
    mulE e f | re rf -> trans (h.2.2.2 (eval S a b x y e) (eval S a b x y f)) (Presentations[l].cong2 T.R T.mul _ _ _ _ re rf) ;
    negE e | re -> trans (RH.negation S T h (eval S a b x y e)) (ap T.neg re) } ;
} ;
