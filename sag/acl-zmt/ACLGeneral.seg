-- ACLGeneral.seg: the cohomological construction for any two equations P, Q
-- given by their charts (FixedCochain), homogeneous of degrees d0+1, e0+1,
-- over a gcd domain A with a coded noetherian presentation: CechZMTD0 with
-- the datum D0, P', Q', (S0), (S1) of the gcd library (sag/gcd,
-- HomLambda.Data).  The degree identities of CechZMTD0 are proved here:
--   kW = -(e' + d0 + 1) ,  kW + e' = -(d0+1) = kP1 ,
--   kW + d' = -(e0+1) = kQ1  since  d0 + 1 = r + d', e0 + 1 = r + e' .
-- CONDITIONAL on the coded noetherian presentation (PA, nA, onto) of A only;
-- the degree identities of the charts are derived from hPd, hQe.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ;
module NA = NatArith[l] ;

-- -1 - (n + 1) = -(n + 2)
addN-neg0 : (n : Nat) -> Id Int (addN (negsuc zero) n) (negsuc (suc n)) = split {
  zero -> refl (negsuc (suc zero)) ;
  suc n | r -> ap predZ r } ;
-- -(e + n + 1) + e = -(n + 1)
addP-negsuc : (e n : Nat) -> Id Int (addP (negsuc (NA.plus e n)) e) (negsuc n) = split {
  zero -> \ n -> refl (negsuc n) ;
  suc e | r -> \ n -> trans (ap (\ k -> sucZ (addP (negsuc k) e)) (sym (NA.plus-suc e n))) (ap sucZ (r (suc n))) } ;
-- (r + e') + d' = suc (e' + d0)  when  suc d0 = r + d'
arith (r d' e' d0 : Nat) (hd : Id Nat (suc d0) (NA.plus r d')) :
  Id Nat (NA.plus (NA.plus r e') d') (suc (NA.plus e' d0)) =
  trans (ap (\ k -> NA.plus k d') (NA.plus-comm r e'))
   (trans (NA.plus-assoc e' r d') (trans (ap (NA.plus e') (sym hd)) (NA.plus-suc e' d0))) ;

module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A])
  (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
  (onto : (c : A.R) -> Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier)
  (a b : A.R)
  -- the two charts
  (muP : E3) (FP GP : Laurent3[l].Over[A].LPoly)
  (th-y : Id Bool (isNeg (ey (neg3 muP))) false)
  (yF : Laurent3[l].Over[A].NonNegY FP) (yG : Laurent3[l].Over[A].NonNegY GP)
  (dF : Laurent3[l].Over[A].HomPI (deg muP) FP) (dG : Laurent3[l].Over[A].HomPI (deg muP) GP)
  (muQ : E3) (FQ GQ : Laurent3[l].Over[A].LPoly)
  (th-x : Id Bool (isNeg (ex (neg3 muQ))) false)
  (xF : Laurent3[l].Over[A].NonNegX FQ) (xG : Laurent3[l].Over[A].NonNegX GQ)
  (dF' : Laurent3[l].Over[A].HomPI (deg muQ) FQ) (dG' : Laurent3[l].Over[A].HomPI (deg muQ) GQ)
  (pFP : CechModules[l].Over[A,G.set].IsPoly (deg muP) FP) (pGP : CechModules[l].Over[A,G.set].IsPoly (deg muP) GP)
  (pFQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) FQ) (pGQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) GQ)
  (pmuP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (Laurent3[l].Over[A].monoP muP))
  (pmuQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (Laurent3[l].Over[A].monoP muQ))
  (pP : CechModules[l].Over[A,G.set].IsPoly (deg muP) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (pQ : CechModules[l].Over[A,G.set].IsPoly (deg muQ) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- P, Q homogeneous of degrees d0 + 1, e0 + 1
  (d0 e0 : Nat)
  (hPd : Laurent3[l].Over[A].HomPI (pos (suc d0)) (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl))
  (hQe : Laurent3[l].Over[A].HomPI (pos (suc e0)) (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl))
  -- exponents >= 0, and a non-zero coefficient of each
  (hP0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) zero)
  (hQ0 : Shift[l].Le' (Shift[l].Over[A,G].Bsum (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) zero)
  (m0 : E3) (nP0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl) m0) A.z))
  (n0 : E3) (nQ0 : Not (Id A.R (LaurentList[l].Over[A].coef (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl) n0) A.z))
  -- the target: x, y in L with p(x,y) = q(x,y) = 0
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (CechRestriction[l].Over[A,G.set,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl)) Lg.z)
  (hq : Id Lg.R (CechRestriction[l].Over[A,G.set,Lg,setL,iota,x,y].resL (FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl)) Lg.z) {
  module FCo = FixedCochain[l].Over[A,a,b] ;
  -- the degree identities of the charts, from deg muP = d0 + 1, deg muQ = e0 + 1
  -- (the first terms of the lists of P and Q)
  dP : Id Int (deg muP) (pos (suc d0)) = hPd.1 ;
  dQ : Id Int (deg muQ) (pos (suc e0)) = hQe.1 ;
  kP1-eq (mu : E3) (n : Nat) (h : Id Int (deg mu) (pos (suc n))) :
    Id Int (add (add (negsuc zero) (deg (neg3 mu))) (pos (suc zero))) (negsuc n) =
    trans (ap (\ v -> add (add (negsuc zero) v) (pos (suc zero))) (trans (FCo.deg-neg mu) (ap neg h)))
          (ap sucZ (addN-neg0 n)) ;
  hkP : Id Int (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) (negsuc d0) = kP1-eq muP d0 dP ;
  hkQ : Id Int (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) (negsuc e0) = kP1-eq muQ e0 dQ ;
  h01 : Id Int (add (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) (deg muP)) (pos zero) =
    trans (Presentations[l].cong2 Int add _ _ _ _ hkP dP) (invr (negsuc d0)) ;
  h02 : Id Int (add (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) (deg muQ)) (pos zero) =
    trans (Presentations[l].cong2 Int add _ _ _ _ hkQ dQ) (invr (negsuc e0)) ;
  dg : Nat = NA.plus (suc e0) (suc d0) ;
  hdg : Id Int (add (deg muP) (deg muQ)) (pos dg) =
    trans (Presentations[l].cong2 Int add _ _ _ _ dP dQ) (Degrees[l].add-pos (suc d0) (suc e0)) ;
  module HL = HomLambda[l].Over[A,G] ;
  module D = HL.Data[(FixedCochain[l].Over[A,a,b].XZ[muP,FP,GP,th-y,yF,yG,dF,dG].C.Pl),(FixedCochain[l].Over[A,a,b].YZ[muQ,FQ,GQ,th-x,xF,xG,dF',dG'].C.Pl),hP0,hQ0,m0,nP0,n0,nQ0,suc d0,suc e0,hPd,hQe] ;
  dW : Nat = NA.plus D.e' d0 ;
  kW : Int = negsuc dW ;
  hW1 : Id Int (add kW (pos D.e')) (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) = trans (addP-negsuc D.e' d0) (sym hkP) ;
  -- (kW + d') + (e0 + 1) = 0
  sum0 : Id Int (add (pos (suc e0)) (add kW (pos D.d'))) zeroZ =
    trans (comm (pos (suc e0)) (add kW (pos D.d')))
     (trans (assoc kW (pos D.d') (pos (suc e0)))
      (trans (ap (add kW) (trans (Degrees[l].add-pos D.d' (suc e0))
                               (ap (\ k -> pos (NA.plus k D.d')) (sym D.sum-Q))))
       (trans (ap (\ k -> add kW (pos k)) (arith D.r D.d' D.e' d0 (sym D.sum-P))) (invr kW)))) ;
  hW2 : Id Int (add kW (pos D.d')) (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) =
    trans (ZG.neg-uniq (pos (suc e0)) (add kW (pos D.d')) sum0) (sym hkQ) ;
  s1 (al be : Laurent3[l].Over[A].Lau) (ha : CechModules[l].Over[A,G.set].SL (add (add (negsuc zero) (deg (neg3 muP))) (pos (suc zero))) al)
     (hb : CechModules[l].Over[A,G.set].SL (add (add (negsuc zero) (deg (neg3 muQ))) (pos (suc zero))) be)
     (h : Laurent3[l].Over[A].EqL (Laurent3[l].Over[A].addL (Laurent3[l].Over[A].mulP D.P'h al) (Laurent3[l].Over[A].mulP D.Q'h be)) Laurent3[l].Over[A].zeroL) :
     (w : Laurent3[l].Over[A].Lau) * (CechModules[l].Over[A,G.set].SL kW w *
       (Laurent3[l].Over[A].EqL al (Laurent3[l].Over[A].negL (Laurent3[l].Over[A].mulP D.Q'h w)) * Laurent3[l].Over[A].EqL be (Laurent3[l].Over[A].mulP D.P'h w))) =
    D.s1 kW al be (subst (\ k -> CechModules[l].Over[A,G.set].SL k al) (sym hW1) ha)
                  (subst (\ k -> CechModules[l].Over[A,G.set].SL k be) (sym hW2) hb) h ;
  module CZ = CechZMTD0[l].Over[A,G.set,PA,nA,onto,a,b,muP,FP,GP,th-y,yF,yG,dF,dG,muQ,FQ,GQ,th-x,xF,xG,dF',dG',
    pFP,pGP,pFQ,pGQ,pmuP,pmuQ,pP,pQ,dg,hdg,kW,dW,D.D0h,D.P'h,D.Q'h,pos D.d',pos D.e',D.P'h-poly,D.Q'h-poly,
    hW1,hW2,h01,h02,refl kW,D.fP,D.fQ,D.s0,s1,Lg,setL,iota,x,y,hp,hq] ;
  -- s = 1 + a r + b t with s, s x, s y integral over A, merely
  certificate : CZ.Z.TC.carrier = CZ.certificate ;
} ;
