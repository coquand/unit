-- FixedCochain.seg: one cochain at every order (handoff §3).
--
-- z* = (0, 0, Z^-1) in K^0(-1), so  delta0 z* = (0, Z^-1, Z^-1).  On the
-- chart XZ, write the homogenised p as
--     P = mu + a F + b G ,     mu = X Z^(d-1) ,
-- with F, G homogeneous of degree d (exponent of Y >= 0), and let
-- theta = mu^-1 = X^-1 Z^(1-d).  The operator  E = a A + b B ,
-- A f = -theta F f , B f = -theta G f , satisfies (E-eq)
--     E f = f - theta P f
-- (the Laurent form of 1 = a(-f/x) + b(-g/x) on B[1/x]).  A, B and E
-- commute (products by polynomials commute), so
--     E^n f is in I^n L  (epow-in: E^(n+1) f = a A(E^n f) + b B(E^n f),
--                         and A E^n f = E^n A f),
--     f - E^n f = P u_n ,  u_(n+1) = u_n + theta E^n f     (div).
-- For f = Z^-1:  Z^-1 = E^n Z^-1 + P u_n  with E^n Z^-1 in I^n L_XZ(-1):
-- the leaves of the tree satisfy the support condition of the chart XZ
-- (exponent of Y >= 0) and have degree -1.  The chart YZ is the same with q.
-- So delta0 z* is in I^n K^1(-1) + (P, Q) K^1(-1) for every n, by explicit
-- witnesses (no Hensel lifting, no choice).  The Laurent elements form a
-- module by function extensionality (lmod).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module IP = IdealPowers[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
module CM = CechMonomials[l] ;

-- equality of integers, as a Boolean
eqZb : Int -> Int -> Bool = split {
  pos m -> split { pos n -> eqN m n ; negsuc n -> false } ;
  negsuc m -> split { pos n -> false ; negsuc n -> eqN m n } } ;
eqZb-sound : (x y : Int) -> Id Bool (eqZb x y) true -> Id Int x y = split {
  pos m -> split {
    pos n -> \ e -> ap (\ k -> pos k) (CM.eqN-sound m n e) ;
    negsuc n -> \ e -> P.absurd (Id Int (pos m) (negsuc n)) (encodeB false true e) } ;
  negsuc m -> split {
    pos n -> \ e -> P.absurd (Id Int (negsuc m) (pos n)) (encodeB false true e) ;
    negsuc n -> \ e -> ap (\ k -> negsuc k) (CM.eqN-sound m n e) } } ;

-- the exponent of Z^-1
zeta : E3 = (zeroZ, (zeroZ, negsuc zero)) ;
isZeta (m : E3) : Bool = and (eqZb (ex m) zeroZ) (and (eqZb (ey m) zeroZ) (eqZb (ez m) (negsuc zero))) ;
isZeta-sound (m : E3) (e : Id Bool (isZeta m) true) : Id E3 m zeta =
  CM.pair3 (ex m) (ey m) (ez m) zeroZ zeroZ (negsuc zero)
    (eqZb-sound (ex m) zeroZ (CM.and-l (eqZb (ex m) zeroZ) (and (eqZb (ey m) zeroZ) (eqZb (ez m) (negsuc zero))) e))
    (eqZb-sound (ey m) zeroZ (CM.and-l (eqZb (ey m) zeroZ) (eqZb (ez m) (negsuc zero))
       (CM.and-r (eqZb (ex m) zeroZ) (and (eqZb (ey m) zeroZ) (eqZb (ez m) (negsuc zero))) e)))
    (eqZb-sound (ez m) (negsuc zero) (CM.and-r (eqZb (ey m) zeroZ) (eqZb (ez m) (negsuc zero))
       (CM.and-r (eqZb (ex m) zeroZ) (and (eqZb (ey m) zeroZ) (eqZb (ez m) (negsuc zero))) e))) ;
-- a negative exponent of X or Y is not that of Z^-1
zeta-negX : (x : Int) (y w : Int) -> Id Bool (isNeg x) true -> Id Bool (isZeta (x,(y,w))) false = split {
  pos n -> \ y w e -> P.absurd (Id Bool (isZeta (pos n,(y,w))) false) (encodeB false true e) ;
  negsuc n -> \ y w e -> refl false } ;
zeta-negY (x : Int) : (y : Int) (w : Int) -> Id Bool (isNeg y) true -> Id Bool (isZeta (x,(y,w))) false = split {
  pos n -> \ w e -> P.absurd (Id Bool (isZeta (x,(pos n,w))) false) (encodeB false true e) ;
  negsuc n -> \ w e -> CM.and-false (eqZb x zeroZ) } ;

-- k + d - d = k
add-sub (k d : Int) : Id Int (add (add k d) (neg d)) k =
  trans (assoc k d (neg d)) (ap (add k) (invr d)) ;

module Over (D : CRing) (a b : D.R) {
  module LO = Laurent3[l].Over[D] ; open LO ;
  module CO = Cech3[l].Over[D] ;

  -- the Laurent elements as a module (function extensionality)
  ext (f g : Lau) (h : EqL f g) : Id Lau f g = FE.funext E3 (\ m -> D.R) f g h ;
  lmod : IP.Mod[D] = IP.mkMod D Lau zeroL addL negL
    (\ f g h -> ext _ _ (\ m -> D.addA (f m) (g m) (h m)))
    (\ f g -> ext _ _ (\ m -> D.addC (f m) (g m)))
    (\ f -> ext _ _ (\ m -> D.addZ (f m)))
    (\ f -> ext _ _ (\ m -> D.addN (f m)))
    scaleL
    (\ c c' f -> ext _ _ (\ m -> D.mulA c c' (f m)))
    (\ f -> ext _ _ (\ m -> L.one-left (f m)))
    (\ c f g -> ext _ _ (\ m -> D.dist c (f m) (g m)))
    (\ c c' f -> ext _ _ (\ m -> L.dist-left c c' (f m))) ;
  module PL = IP.Over[D,lmod,a,b] ;

  zinv : Lau = \ m -> ifB (isZeta m) D.o ;

  -- Z^-1 has degree -1, and nonnegative exponents of X and Y
  zinv-b (m : E3) : (bb : Bool) -> Id Bool (isZeta m) bb -> (Id E3 m zeta -> Empty) -> Id D.R (ifB bb D.o) D.z = split {
    true -> \ e ne -> P.absurd (Id D.R D.o D.z) (ne (isZeta-sound m e)) ;
    false -> \ e ne -> refl D.z } ;
  zinv-hom : Hom (negsuc zero) zinv =
    \ m ne -> zinv-b m (isZeta m) (refl (isZeta m)) (\ p -> ne (ap deg p)) ;
  zinv-nnx : NNX zinv = \ m e -> ap (\ c -> ifB c D.o) (zeta-negX (ex m) (ey m) (ez m) e) ;
  zinv-nny : NNY zinv = \ m e -> ap (\ c -> ifB c D.o) (zeta-negY (ex m) (ey m) (ez m) e) ;

  ------------------------------------------------------------------------
  -- one chart:  P = mu + a F + b G

  module Chart (mu : E3) (F G : LPoly) (S : Lau -> U l) (s-zinv : S zinv)
    (s-op : (H : LPoly) -> Plus (Id LPoly H F) (Id LPoly H G) -> (f : Lau) -> S f ->
            S (negL (mulP (monoP (neg3 mu)) (mulP H f)))) {
    th : LPoly = monoP (neg3 mu) ;
    Pl : LPoly = cons (D.o, mu) (Bar[l].app (scaleList a F) (scaleList b G)) ;
    Op (H : LPoly) (f : Lau) : Lau = negL (mulP th (mulP H f)) ;
    Eop (f : Lau) : Lau = addL (scaleL a (Op F f)) (scaleL b (Op G f)) ;

    -- P f = mu f + (a F f + b G f)
    P-split (f : Lau) : EqL (mulP Pl f) (addL (mulP (monoP mu) f) (addL (scaleL a (mulP F f)) (scaleL b (mulP G f)))) =
      \ m -> DG.cong-add (sym (D.addZ (D.mul D.o (f (sub3 m mu)))))
               (trans (mulP-app (scaleList a F) (scaleList b G) f m)
                      (DG.cong-add (mulP-scaleList a F f m) (mulP-scaleList b G f m))) ;
    -- theta P f = f + (a theta F f + b theta G f)
    th-split (f : Lau) :
      EqL (mulP th (mulP Pl f)) (addL f (addL (scaleL a (mulP th (mulP F f))) (scaleL b (mulP th (mulP G f))))) =
      \ m -> trans (mulP-cong th (mulP Pl f) _ (P-split f) m)
        (trans (mulP-add th (mulP (monoP mu) f) (addL (scaleL a (mulP F f)) (scaleL b (mulP G f))) m)
          (DG.cong-add (mono-cancel mu f m)
            (trans (mulP-add th (scaleL a (mulP F f)) (scaleL b (mulP G f)) m)
                   (DG.cong-add (mulP-scale th a (mulP F f) m) (mulP-scale th b (mulP G f) m))))) ;
    -- a (-X) + b (-Y) = v - (v + (a X + b Y))
    ring1 (v X Y : D.R) :
      Id D.R (D.add (D.mul a (D.neg X)) (D.mul b (D.neg Y))) (D.add v (D.neg (D.add v (D.add (D.mul a X) (D.mul b Y))))) =
      sym (calc D.R {
        D.add v (D.neg (D.add v (D.add (D.mul a X) (D.mul b Y))))
          =< ap (D.add v) (L.neg-add v (D.add (D.mul a X) (D.mul b Y)))
          > D.add v (D.add (D.neg v) (D.neg (D.add (D.mul a X) (D.mul b Y))))
          =< D.addA v (D.neg v) (D.neg (D.add (D.mul a X) (D.mul b Y)))
          > D.add (D.add v (D.neg v)) (D.neg (D.add (D.mul a X) (D.mul b Y)))
          =< ap (\ t -> D.add t (D.neg (D.add (D.mul a X) (D.mul b Y)))) (D.addN v)
          > D.add D.z (D.neg (D.add (D.mul a X) (D.mul b Y)))
          =< L.zl (D.neg (D.add (D.mul a X) (D.mul b Y))) > D.neg (D.add (D.mul a X) (D.mul b Y))
          =< L.neg-add (D.mul a X) (D.mul b Y) > D.add (D.neg (D.mul a X)) (D.neg (D.mul b Y))
          =< DG.cong-add (sym (L.mul-neg a X)) (sym (L.mul-neg b Y))
          > D.add (D.mul a (D.neg X)) (D.mul b (D.neg Y)) }) ;
    -- E f = f - theta P f
    E-eq (f : Lau) : EqL (Eop f) (subL f (mulP th (mulP Pl f))) =
      \ m -> trans (ring1 (f m) (mulP th (mulP F f) m) (mulP th (mulP G f) m))
                   (ap (\ t -> D.add (f m) (D.neg t)) (sym (th-split f m))) ;

    -- the operators are linear and commute
    Op-cong (H : LPoly) (f g : Lau) (e : EqL f g) : EqL (Op H f) (Op H g) =
      \ m -> ap D.neg (mulP-cong th (mulP H f) (mulP H g) (mulP-cong H f g e) m) ;
    Op-add (H : LPoly) (f g : Lau) : EqL (Op H (addL f g)) (addL (Op H f) (Op H g)) =
      \ m -> trans (ap D.neg (trans (mulP-cong th (mulP H (addL f g)) _ (mulP-add H f g) m)
                                    (mulP-add th (mulP H f) (mulP H g) m)))
                   (L.neg-add (mulP th (mulP H f) m) (mulP th (mulP H g) m)) ;
    Op-scale (H : LPoly) (c : D.R) (f : Lau) : EqL (Op H (scaleL c f)) (scaleL c (Op H f)) =
      \ m -> trans (ap D.neg (trans (mulP-cong th (mulP H (scaleL c f)) _ (mulP-scale H c f) m)
                                    (mulP-scale th c (mulP H f) m)))
                   (sym (L.mul-neg c (mulP th (mulP H f) m))) ;
    -- Op H (Op H' f) = theta theta H H' f
    NF (H H' : LPoly) (f : Lau) : Lau = mulP th (mulP th (mulP H (mulP H' f))) ;
    Op-Op (H H' : LPoly) (f : Lau) : EqL (Op H (Op H' f)) (NF H H' f) =
      \ m -> trans (ap D.neg (trans (mulP-cong th (mulP H (Op H' f)) _ (mulP-neg H (mulP th (mulP H' f))) m)
                                    (mulP-neg th (mulP H (mulP th (mulP H' f))) m)))
               (trans (L.neg-neg (mulP th (mulP H (mulP th (mulP H' f))) m))
                      (mulP-cong th (mulP H (mulP th (mulP H' f))) _ (mulP-comm H th (mulP H' f)) m)) ;
    Op-comm (H H' : LPoly) (f : Lau) : EqL (Op H (Op H' f)) (Op H' (Op H f)) =
      \ m -> trans (Op-Op H H' f m)
               (trans (mulP-cong th (mulP th (mulP H (mulP H' f))) _ (mulP-cong th _ _ (mulP-comm H H' f)) m)
                      (sym (Op-Op H' H f m))) ;
    Eop-cong (f g : Lau) (e : EqL f g) : EqL (Eop f) (Eop g) =
      \ m -> DG.cong-add (ap (D.mul a) (Op-cong F f g e m)) (ap (D.mul b) (Op-cong G f g e m)) ;
    -- Op H (E f) = E (Op H f)
    Op-E (H : LPoly) (f : Lau) : EqL (Op H (Eop f)) (Eop (Op H f)) =
      \ m -> trans (Op-add H (scaleL a (Op F f)) (scaleL b (Op G f)) m)
               (DG.cong-add (trans (Op-scale H a (Op F f) m) (ap (D.mul a) (Op-comm H F f m)))
                            (trans (Op-scale H b (Op G f) m) (ap (D.mul b) (Op-comm H G f m)))) ;

    Epow : Ring[l].Nat -> Lau -> Lau = split { zero -> \ f -> f ; suc n | r -> \ f -> Eop (r f) } ;
    Epow-cong : (n : Ring[l].Nat) (f g : Lau) -> EqL f g -> EqL (Epow n f) (Epow n g) = split {
      zero -> \ f g e -> e ;
      suc n | r -> \ f g e -> Eop-cong (Epow n f) (Epow n g) (r f g e) } ;
    Op-Epow (H : LPoly) : (n : Ring[l].Nat) (f : Lau) -> EqL (Op H (Epow n f)) (Epow n (Op H f)) = split {
      zero -> \ f m -> refl (Op H f m) ;
      suc n | r -> \ f m -> trans (Op-E H (Epow n f) m) (Eop-cong (Op H (Epow n f)) (Epow n (Op H f)) (r f) m) } ;

    -- E^n f is in I^n L, with leaves in S
    epow-in : (n : Ring[l].Nat) (f : Lau) -> S f -> PL.PowIn S n (Epow n f) = split {
      zero -> \ f h -> h ;
      suc n | r -> \ f h ->
        (Op F (Epow n f), (Op G (Epow n f),
          (subst {Lau} (PL.PowIn S n) (ext (Epow n (Op F f)) (Op F (Epow n f)) (\ m -> sym (Op-Epow F n f m))) (r (Op F f) (s-op F (inl (refl F)) f h)),
          (subst {Lau} (PL.PowIn S n) (ext (Epow n (Op G f)) (Op G (Epow n f)) (\ m -> sym (Op-Epow G n f m))) (r (Op G f) (s-op G (inr (refl G)) f h)),
           refl (Eop (Epow n f)))))) } ;

    -- f - E^n f = P u_n
    u : Ring[l].Nat -> Lau -> Lau = split { zero -> \ f -> zeroL ; suc n | r -> \ f -> addL (r f) (mulP th (Epow n f)) } ;
    -- (x - y) + (y - w) = x - w
    ring2 (xx yy ww : D.R) : Id D.R (D.add (D.add xx (D.neg yy)) (D.add yy (D.neg ww))) (D.add xx (D.neg ww)) =
      trans (sym (D.addA xx (D.neg yy) (D.add yy (D.neg ww))))
        (ap (D.add xx) (trans (D.addA (D.neg yy) yy (D.neg ww)) (trans (ap (\ t -> D.add t (D.neg ww)) (L.neg-cancel yy)) (L.zl (D.neg ww))))) ;
    -- y - E y = theta P y
    diffE (g : Lau) : EqL (subL g (Eop g)) (mulP th (mulP Pl g)) =
      \ m -> trans (ap (\ t -> D.add (g m) (D.neg t)) (E-eq g m))
               (trans (ap (D.add (g m)) (L.negsub (g m) (mulP th (mulP Pl g) m)))
                 (trans (D.addA (g m) (D.neg (g m)) (mulP th (mulP Pl g) m))
                   (trans (ap (\ t -> D.add t (mulP th (mulP Pl g) m)) (D.addN (g m))) (L.zl (mulP th (mulP Pl g) m))))) ;
    div : (n : Ring[l].Nat) (f : Lau) -> EqL (subL f (Epow n f)) (mulP Pl (u n f)) = split {
      zero -> \ f m -> trans (D.addN (f m)) (sym (mulP-zero Pl m)) ;
      suc n | r -> \ f m ->
        calc D.R { D.add (f m) (D.neg (Eop (Epow n f) m))
                     =< sym (ring2 (f m) (Epow n f m) (Eop (Epow n f) m))
                     > D.add (D.add (f m) (D.neg (Epow n f m))) (D.add (Epow n f m) (D.neg (Eop (Epow n f) m)))
                     =< DG.cong-add (r f m) (trans (diffE (Epow n f) m) (mulP-comm th Pl (Epow n f) m))
                     > D.add (mulP Pl (u n f) m) (mulP Pl (mulP th (Epow n f)) m)
                     =< sym (mulP-add Pl (u n f) (mulP th (Epow n f)) m)
                     > mulP Pl (u (suc n) f) m } } ;

    -- Z^-1 = E^n Z^-1 + P u_n , with E^n Z^-1 in I^n L (leaves in S)
    fixed (n : Ring[l].Nat) : (w : Lau) * (PL.PowIn S n w * ((uu : Lau) * EqL zinv (addL w (mulP Pl uu)))) =
      (Epow n zinv, (epow-in n zinv s-zinv, (u n zinv,
        \ m -> trans (sym (CO.sub-add-l (zinv m) (Epow n zinv m))) (ap (D.add (Epow n zinv m)) (div n zinv m))))) ;
  } ;

  ------------------------------------------------------------------------
  -- the charts XZ (with p) and YZ (with q)

  -- deg(-e) = -(deg e)
  deg-neg (e : E3) : Id Int (deg (neg3 e)) (neg (deg e)) =
    sym (trans (ZG.neg-add (ex e) (add (ey e) (ez e))) (ap (add (neg (ex e))) (ZG.neg-add (ey e) (ez e)))) ;
  -- (-1 + deg mu) + deg(-mu) = -1
  deg-back (mu : E3) : Id Int (add (add (negsuc zero) (deg mu)) (deg (neg3 mu))) (negsuc zero) =
    trans (ap (add (add (negsuc zero) (deg mu))) (deg-neg mu)) (add-sub (negsuc zero) (deg mu)) ;

  -- P = mu + a F + b G on XZ: the exponent of Y in mu is 0, F and G have exponents of Y >= 0
  -- and degree deg mu.  The leaves: exponent of Y >= 0, degree -1.
  SXZ (f : Lau) : U l = NNY f * Hom (negsuc zero) f ;
  module XZ (mu : E3) (F G : LPoly) (th-y : Id Bool (isNeg (ey (neg3 mu))) false)
    (yF : NonNegY F) (yG : NonNegY G) (dF : HomPI (deg mu) F) (dG : HomPI (deg mu) G) {
    pick (H : LPoly) : Plus (Id LPoly H F) (Id LPoly H G) -> NonNegY H * HomPI (deg mu) H = split {
      inl e -> subst (\ K -> NonNegY K * HomPI (deg mu) K) (sym e) (yF, dF) ;
      inr e -> subst (\ K -> NonNegY K * HomPI (deg mu) K) (sym e) (yG, dG) } ;
    s-op (H : LPoly) (w : Plus (Id LPoly H F) (Id LPoly H G)) (f : Lau) (h : SXZ f) :
      SXZ (negL (mulP (monoP (neg3 mu)) (mulP H f))) =
      (neg-nny (mulP (monoP (neg3 mu)) (mulP H f))
         (nny-mulY (monoP (neg3 mu)) (th-y, tt) (mulP H f) (nny-mulY H (pick H w).1 f h.1)),
       neg-hom (negsuc zero) (mulP (monoP (neg3 mu)) (mulP H f))
         (hom-tr (add (add (negsuc zero) (deg mu)) (deg (neg3 mu))) (negsuc zero) (deg-back mu) (mulP (monoP (neg3 mu)) (mulP H f))
           (hom-mulI (add (negsuc zero) (deg mu)) (deg (neg3 mu)) (mulP H f)
              (hom-mulI (negsuc zero) (deg mu) f h.2 H (pick H w).2) (monoP (neg3 mu)) (refl (deg (neg3 mu)), tt)))) ;
    module C = Chart[mu,F,G,SXZ,(zinv-nny,zinv-hom),s-op] ;
  } ;

  SYZ (f : Lau) : U l = NNX f * Hom (negsuc zero) f ;
  module YZ (mu : E3) (F G : LPoly) (th-x : Id Bool (isNeg (ex (neg3 mu))) false)
    (xF : NonNegX F) (xG : NonNegX G) (dF : HomPI (deg mu) F) (dG : HomPI (deg mu) G) {
    pick (H : LPoly) : Plus (Id LPoly H F) (Id LPoly H G) -> NonNegX H * HomPI (deg mu) H = split {
      inl e -> subst (\ K -> NonNegX K * HomPI (deg mu) K) (sym e) (xF, dF) ;
      inr e -> subst (\ K -> NonNegX K * HomPI (deg mu) K) (sym e) (xG, dG) } ;
    s-op (H : LPoly) (w : Plus (Id LPoly H F) (Id LPoly H G)) (f : Lau) (h : SYZ f) :
      SYZ (negL (mulP (monoP (neg3 mu)) (mulP H f))) =
      (neg-nnx (mulP (monoP (neg3 mu)) (mulP H f))
         (nnx-mulX (monoP (neg3 mu)) (th-x, tt) (mulP H f) (nnx-mulX H (pick H w).1 f h.1)),
       neg-hom (negsuc zero) (mulP (monoP (neg3 mu)) (mulP H f))
         (hom-tr (add (add (negsuc zero) (deg mu)) (deg (neg3 mu))) (negsuc zero) (deg-back mu) (mulP (monoP (neg3 mu)) (mulP H f))
           (hom-mulI (add (negsuc zero) (deg mu)) (deg (neg3 mu)) (mulP H f)
              (hom-mulI (negsuc zero) (deg mu) f h.2 H (pick H w).2) (monoP (neg3 mu)) (refl (deg (neg3 mu)), tt)))) ;
    module C = Chart[mu,F,G,SYZ,(zinv-nnx,zinv-hom),s-op] ;
  } ;

  -- delta0 z* = (0, Z^-1, Z^-1) is in I^n K^1(-1) + (P,Q) K^1(-1), componentwise:
  -- the component XY is 0, the components XZ and YZ are C.fixed of the two charts.
  zs : CO.Tri = CO.mkT zeroL zeroL zinv ;
  d0-zs : CO.EqT (CO.d0 zs) (CO.mkT zeroL zinv zinv) =
    (\ m -> D.addN D.z, (\ m -> sub-z (zinv m), \ m -> sub-z (zinv m))) ;
} ;

-- The example of ACL §4.4:  p = x + a(-1) + b(xy + 2x^2) ,  q = y + a(x^2 + xy) + b(y^2 - 1),
-- homogenised in degree 2:  P = XZ + a(-Z^2) + b(XY + 2X^2) ,  Q = YZ + a(X^2 + XY) + b(Y^2 - Z^2).
-- The hypotheses of the two charts hold by computation.
module ACL (D : CRing) (a b : D.R) {
  module O = Over[D,a,b] ;
  e3 (i j k : Int) : E3 = (i, (j, k)) ;
  one' : Int = pos (suc zero) ;
  two' : Int = pos (suc (suc zero)) ;
  muP : E3 = e3 one' zeroZ one' ;
  FP : O.LO.LPoly = cons (D.neg D.o, e3 zeroZ zeroZ two') nil ;
  GP : O.LO.LPoly = cons (D.o, e3 one' one' zeroZ) (cons (D.add D.o D.o, e3 two' zeroZ zeroZ) nil) ;
  muQ : E3 = e3 zeroZ one' one' ;
  FQ : O.LO.LPoly = cons (D.o, e3 two' zeroZ zeroZ) (cons (D.o, e3 one' one' zeroZ) nil) ;
  GQ : O.LO.LPoly = cons (D.o, e3 zeroZ two' zeroZ) (cons (D.neg D.o, e3 zeroZ zeroZ two') nil) ;
  module XZ = O.XZ[muP,FP,GP,refl false,(refl false,tt),(refl false,(refl false,tt)),
    (refl two',tt),(refl two',(refl two',tt))] ;
  module YZ = O.YZ[muQ,FQ,GQ,refl false,(refl false,(refl false,tt)),(refl false,(refl false,tt)),
    (refl two',(refl two',tt)),(refl two',(refl two',tt))] ;
  -- for every n:  Z^-1 = E^n Z^-1 + P u  on XZ, and the same with Q on YZ
  fixed-XZ (n : Ring[l].Nat) : (w : O.LO.Lau) * (O.PL.PowIn O.SXZ n w * ((uu : O.LO.Lau) * O.LO.EqL O.zinv (O.LO.addL w (O.LO.mulP XZ.C.Pl uu)))) = XZ.C.fixed n ;
  fixed-YZ (n : Ring[l].Nat) : (w : O.LO.Lau) * (O.PL.PowIn O.SYZ n w * ((uu : O.LO.Lau) * O.LO.EqL O.zinv (O.LO.addL w (O.LO.mulP YZ.C.Pl uu)))) = YZ.C.fixed n ;
} ;
