-- ACLCech.seg: the example of ACL §4.4 through the cohomological
-- construction (acl-zmt-formalisation.tex, Assemblage; Liste item 6).
--
--     p = x - a + b x y + 2 b x^2 ,   q = y - b + a x^2 + a x y + b y^2 ,
--     P = XZ + a(-Z^2) + b(XY + 2X^2) ,   Q = YZ + a(X^2 + XY) + b(Y^2 - Z^2) .
-- The charts and degrees are those of FixedCochain.ACL (d = e = 2): all the
-- hypotheses of CechZMT on them hold by computation (refl), the generator
-- g = YZ P - XZ Q has degree 4, the syzygies live in degree -4 = negsuc 3
-- (three all-negative monomials), and res P = p(x,y), res Q = q(x,y) are
-- checked by the verified normaliser RingNormal.
-- This file is CONDITIONAL on (S1) (parameter s1) and on the coded noetherian
-- presentation of A; ACLCechS1 discharges (S1) for A = k[b][a].
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module PE = PolyExpr[l] ; module AD = ACLExampleData[l] ; open PolyExpr[l] ;

module Data (A : CRing) (setA : Pr.isSet A.R) (a b : A.R) {
  module FA = FixedCochain[l].ACL[A,a,b] ;
  module LO = Laurent3[l].Over[A] ; open LO ;
  module CMd = CechModules[l].Over[A,setA] ;
  PlP : LPoly = FA.XZ.C.Pl ;
  PlQ : LPoly = FA.YZ.C.Pl ;
  one : Int = pos (suc zero) ;
  two : Int = pos (suc (suc zero)) ;
  kP1 : Int = add (add (negsuc zero) (deg (neg3 FA.muP))) one ;
  kQ1 : Int = add (add (negsuc zero) (deg (neg3 FA.muQ))) one ;
  kW : Int = negsuc (suc (suc (suc zero))) ;
  -- the syzygy datum (S1) for P, Q: degrees -2, -2 and -4
  S1T : U l = (al be : Lau) -> CMd.SL kP1 al -> CMd.SL kQ1 be ->
    EqL (addL (mulP PlP al) (mulP PlQ be)) zeroL ->
    (w : Lau) * (CMd.SL kW w * (EqL al (negL (mulP PlQ w)) * EqL be (mulP PlP w))) ;
} ;

-- res P = p(x,y) and res Q = q(x,y) on the chart Z, by the verified normaliser
module ResPQ (A : CRing) (setA : Pr.isSet A.R) (a b : A.R)
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (PE.eval Lg (iota.1 a) (iota.1 b) x y AD.p-ex) Lg.z)
  (hq : Id Lg.R (PE.eval Lg (iota.1 a) (iota.1 b) x y AD.q-ex) Lg.z) {
  module DA = Data[A,setA,a,b] ;
  module FA = DA.FA ;
  module R = CechRestriction[l].Over[A,setA,Lg,setL,iota,x,y] ;
  module PM = PE.Map[A,Lg,iota] ;
  module RN = RingNormal[l].Over[Lg,iota.1 a,iota.1 b,x,y] ;
  module RN0 = RingNormal[l] ;
  al : Lg.R = iota.1 a ;
  be : Lg.R = iota.1 b ;
  val (e : PE.Ex) : Lg.R = PE.eval Lg al be x y e ;
  hev (e : PE.Ex) : Id Lg.R (iota.1 (PE.eval A a b a b e)) (PE.eval Lg al be al be e) = PM.hom-eval a b a b e ;

  -- res P and res Q as polynomial expressions
  eP : PE.Ex =
    addE (mulE oneE (mulE (mulE vx oneE) oneE))
     (addE (mulE (mulE va (negE oneE)) (mulE oneE oneE))
      (addE (mulE (mulE vb oneE) (mulE (mulE vx oneE) (mulE vy oneE)))
       (addE (mulE (mulE vb (addE oneE oneE)) (mulE (mulE vx (mulE vx oneE)) oneE)) zeroE))) ;
  eQ : PE.Ex =
    addE (mulE oneE (mulE oneE (mulE vy oneE)))
     (addE (mulE (mulE va oneE) (mulE (mulE vx (mulE vx oneE)) oneE))
      (addE (mulE (mulE va oneE) (mulE (mulE vx oneE) (mulE vy oneE)))
       (addE (mulE (mulE vb oneE) (mulE oneE (mulE vy (mulE vy oneE))))
        (addE (mulE (mulE vb (negE oneE)) (mulE oneE oneE)) zeroE)))) ;
  c2 (u v : Lg.R) (w z : Lg.R) (e : Id Lg.R u v) (e' : Id Lg.R w z) : Id Lg.R (Lg.add u w) (Lg.add v z) = Ps.cong2 Lg.R Lg.add u v w z e e' ;
  m2 (u v : Lg.R) (w : Lg.R) (e : Id Lg.R u v) : Id Lg.R (Lg.mul u w) (Lg.mul v w) = ap (\ s -> Lg.mul s w) e ;
  resP : Id Lg.R (R.resL DA.PlP) (val eP) =
    (c2 (Lg.mul (iota.1 (A.o)) (Lg.mul (Lg.mul x Lg.o) Lg.o)) (Lg.mul (Lg.o) (Lg.mul (Lg.mul x Lg.o) Lg.o)) (Lg.add (Lg.mul (iota.1 (A.mul a (A.neg A.o))) (Lg.mul Lg.o Lg.o)) (Lg.add (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.add A.o A.o))) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z))) (Lg.add (Lg.mul (Lg.mul al (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) (Lg.add (Lg.mul (Lg.mul be Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (Lg.mul be (Lg.add Lg.o Lg.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z))) (m2 (iota.1 (A.o)) (Lg.o) (Lg.mul (Lg.mul x Lg.o) Lg.o) iota.2.1) (c2 (Lg.mul (iota.1 (A.mul a (A.neg A.o))) (Lg.mul Lg.o Lg.o)) (Lg.mul (Lg.mul al (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) (Lg.add (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.add A.o A.o))) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z)) (Lg.add (Lg.mul (Lg.mul be Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (Lg.mul be (Lg.add Lg.o Lg.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z)) (m2 (iota.1 (A.mul a (A.neg A.o))) (Lg.mul al (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o) (hev (mulE va (negE oneE)))) (c2 (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.mul (Lg.mul be Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.add A.o A.o))) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z) (Lg.add (Lg.mul (Lg.mul be (Lg.add Lg.o Lg.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z) (m2 (iota.1 (A.mul b A.o)) (Lg.mul be Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o)) (hev (mulE vb oneE))) (c2 (Lg.mul (iota.1 (A.mul b (A.add A.o A.o))) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) (Lg.mul (Lg.mul be (Lg.add Lg.o Lg.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) Lg.z Lg.z (m2 (iota.1 (A.mul b (A.add A.o A.o))) (Lg.mul be (Lg.add Lg.o Lg.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o) (hev (mulE vb (addE oneE oneE)))) refl Lg.z)))) ;
  resQ : Id Lg.R (R.resL DA.PlQ) (val eQ) =
    (c2 (Lg.mul (iota.1 (A.o)) (Lg.mul Lg.o (Lg.mul y Lg.o))) (Lg.mul (Lg.o) (Lg.mul Lg.o (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul a A.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) (Lg.add (Lg.mul (iota.1 (A.mul a A.o)) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.neg A.o))) (Lg.mul Lg.o Lg.o)) Lg.z)))) (Lg.add (Lg.mul (Lg.mul al Lg.o) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) (Lg.add (Lg.mul (Lg.mul al Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (Lg.mul be Lg.o) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (Lg.mul be (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) Lg.z)))) (m2 (iota.1 (A.o)) (Lg.o) (Lg.mul Lg.o (Lg.mul y Lg.o)) iota.2.1) (c2 (Lg.mul (iota.1 (A.mul a A.o)) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) (Lg.mul (Lg.mul al Lg.o) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o)) (Lg.add (Lg.mul (iota.1 (A.mul a A.o)) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.neg A.o))) (Lg.mul Lg.o Lg.o)) Lg.z))) (Lg.add (Lg.mul (Lg.mul al Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (Lg.mul be Lg.o) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (Lg.mul be (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) Lg.z))) (m2 (iota.1 (A.mul a A.o)) (Lg.mul al Lg.o) (Lg.mul (Lg.mul x (Lg.mul x Lg.o)) Lg.o) (hev (mulE va oneE))) (c2 (Lg.mul (iota.1 (A.mul a A.o)) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.mul (Lg.mul al Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o))) (Lg.add (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.neg A.o))) (Lg.mul Lg.o Lg.o)) Lg.z)) (Lg.add (Lg.mul (Lg.mul be Lg.o) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (Lg.mul be (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) Lg.z)) (m2 (iota.1 (A.mul a A.o)) (Lg.mul al Lg.o) (Lg.mul (Lg.mul x Lg.o) (Lg.mul y Lg.o)) (hev (mulE va oneE))) (c2 (Lg.mul (iota.1 (A.mul b A.o)) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.mul (Lg.mul be Lg.o) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o)))) (Lg.add (Lg.mul (iota.1 (A.mul b (A.neg A.o))) (Lg.mul Lg.o Lg.o)) Lg.z) (Lg.add (Lg.mul (Lg.mul be (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) Lg.z) (m2 (iota.1 (A.mul b A.o)) (Lg.mul be Lg.o) (Lg.mul Lg.o (Lg.mul y (Lg.mul y Lg.o))) (hev (mulE vb oneE))) (c2 (Lg.mul (iota.1 (A.mul b (A.neg A.o))) (Lg.mul Lg.o Lg.o)) (Lg.mul (Lg.mul be (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o)) Lg.z Lg.z (m2 (iota.1 (A.mul b (A.neg A.o))) (Lg.mul be (Lg.neg Lg.o)) (Lg.mul Lg.o Lg.o) (hev (mulE vb (negE oneE)))) refl Lg.z))))) ;
  hP : Id Lg.R (R.resL DA.PlP) Lg.z = trans resP (trans (RN.same-value eP AD.p-ex (refl (RN0.norm AD.p-ex))) hp) ;
  hQ : Id Lg.R (R.resL DA.PlQ) Lg.z = trans resQ (trans (RN.same-value eQ AD.q-ex (refl (RN0.norm AD.q-ex))) hq) ;

} ;

module Over (A : CRing) (setA : Pr.isSet A.R)
  (PA : Span[l].Pres[A]) (nA : Span[l].Over[A,PA].Noeth)
  (onto : (c : A.R) -> Tr.Trunc[(k : PA.K) * Id A.R (PA.phi k) c].carrier)
  (a b : A.R) (s1 : Data[A,setA,a,b].S1T)
  (Lg : CRing) (setL : Pr.isSet Lg.R) (iota : H.Hom A Lg) (x y : Lg.R)
  (hp : Id Lg.R (PE.eval Lg (iota.1 a) (iota.1 b) x y AD.p-ex) Lg.z)
  (hq : Id Lg.R (PE.eval Lg (iota.1 a) (iota.1 b) x y AD.q-ex) Lg.z) {
  module RQ = ResPQ[A,setA,a,b,Lg,setL,iota,x,y,hp,hq] ;
  module DA = Data[A,setA,a,b] ;
  module FA = DA.FA ;
  hP : Id Lg.R (RQ.R.resL DA.PlP) Lg.z = RQ.hP ;
  hQ : Id Lg.R (RQ.R.resL DA.PlQ) Lg.z = RQ.hQ ;

  -- the data of CechZMT, by computation
  two : Int = DA.two ;
  module CZ = CechZMT[l].Over[A,setA,PA,nA,onto,a,b,
    FA.muP,FA.FP,FA.GP,refl false,(refl false,tt),(refl false,(refl false,tt)),(refl two,tt),(refl two,(refl two,tt)),
    FA.muQ,FA.FQ,FA.GQ,refl false,(refl false,(refl false,tt)),(refl false,(refl false,tt)),(refl two,(refl two,tt)),(refl two,(refl two,tt)),
    ((refl false, tt), ((refl false, tt), ((refl false, tt), (refl two, tt)))),((refl false, (refl false, tt)), ((refl false, (refl false, tt)), ((refl false, (refl false, tt)), (refl two, (refl two, tt))))),((refl false, (refl false, tt)), ((refl false, (refl false, tt)), ((refl false, (refl false, tt)), (refl two, (refl two, tt))))),((refl false, (refl false, tt)), ((refl false, (refl false, tt)), ((refl false, (refl false, tt)), (refl two, (refl two, tt))))),((refl false, tt), ((refl false, tt), ((refl false, tt), (refl two, tt)))),((refl false, tt), ((refl false, tt), ((refl false, tt), (refl two, tt)))),((refl false, (refl false, (refl false, (refl false, tt)))), ((refl false, (refl false, (refl false, (refl false, tt)))), ((refl false, (refl false, (refl false, (refl false, tt)))), (refl two, (refl two, (refl two, (refl two, tt))))))),((refl false, (refl false, (refl false, (refl false, (refl false, tt))))), ((refl false, (refl false, (refl false, (refl false, (refl false, tt))))), ((refl false, (refl false, (refl false, (refl false, (refl false, tt))))), (refl two, (refl two, (refl two, (refl two, (refl two, tt)))))))),
    suc (suc (suc (suc zero))),refl (pos (suc (suc (suc (suc zero))))),
    DA.kW,suc (suc (suc zero)),
    refl (negsuc (suc zero)),refl (negsuc (suc zero)),refl (pos zero),refl (pos zero),refl DA.kW,
    s1,Lg,setL,iota,x,y,hP,hQ] ;

  -- the conclusion: s = 1 + a r + b t with s, s x, s y integral over A, merely
  certificate : CZ.Z.TC.carrier = CZ.certificate ;
} ;
