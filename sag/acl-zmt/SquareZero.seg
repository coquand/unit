-- SquareZero.seg: the ring  E = B (+) B^r  with square-zero ideal
-- (finite-lifting.tex §3; handoff §5):
--     (u, v) (u', v') = (u u', u v' + u' v) .
-- B^r is the free module (functions Fin r -> B); its elements are equal
-- when their components are (function extensionality, a consequence of
-- univalence in the ambient segment).  A relation of ideal type
--     (0, w) = sum_i (q_i, w'_i) (0, w_i)
-- in E is the module relation  w = sum_i q_i w_i , which is what the
-- noetherian argument extracts (GradedDependence).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Over (Bg : CRing) (r : Nat) {
  module LB = RL[Bg] ;
  module GB = ExteriorAlgebra[l].AG[Bg.R,Bg.z,Bg.add,Bg.neg,Bg.addA,Bg.addC,Bg.addZ,Bg.addN] ;

  Vec : U l = Ps.Fin r -> Bg.R ;
  Car : U l = Bg.R * Vec ;

  -- equality from the components
  eqE (s s' : Car) (p : Id Bg.R s.1 s'.1) (q : (k : Ps.Fin r) -> Id Bg.R (s.2 k) (s'.2 k)) : Id Car s s' =
    calc Car { s =< ap (\ u -> (u, s.2)) p > (s'.1, s.2)
                 =< ap (\ v -> (s'.1, v)) (FE.funext (Ps.Fin r) (\ k -> Bg.R) s.2 s'.2 q) > s' } ;

  zeroE : Car = (Bg.z, \ k -> Bg.z) ;
  oneE : Car = (Bg.o, \ k -> Bg.z) ;
  addE (s s' : Car) : Car = (Bg.add s.1 s'.1, \ k -> Bg.add (s.2 k) (s'.2 k)) ;
  negE (s : Car) : Car = (Bg.neg s.1, \ k -> Bg.neg (s.2 k)) ;
  mulE (s s' : Car) : Car = (Bg.mul s.1 s'.1, \ k -> Bg.add (Bg.mul s.1 (s'.2 k)) (Bg.mul s'.1 (s.2 k))) ;

  -- u (u' A + u'' B) + (u' u'') C = (u u') A + u'' (u B + u' C)
  assoc-v (u u' u'' A B C : Bg.R) :
    Id Bg.R (Bg.add (Bg.mul u (Bg.add (Bg.mul u' A) (Bg.mul u'' B))) (Bg.mul (Bg.mul u' u'') C))
            (Bg.add (Bg.mul (Bg.mul u u') A) (Bg.mul u'' (Bg.add (Bg.mul u B) (Bg.mul u' C)))) =
    calc Bg.R {
      Bg.add (Bg.mul u (Bg.add (Bg.mul u' A) (Bg.mul u'' B))) (Bg.mul (Bg.mul u' u'') C)
        =< ap (\ t -> Bg.add t (Bg.mul (Bg.mul u' u'') C)) (Bg.dist u (Bg.mul u' A) (Bg.mul u'' B))
        > Bg.add (Bg.add (Bg.mul u (Bg.mul u' A)) (Bg.mul u (Bg.mul u'' B))) (Bg.mul (Bg.mul u' u'') C)
        =< sym (Bg.addA (Bg.mul u (Bg.mul u' A)) (Bg.mul u (Bg.mul u'' B)) (Bg.mul (Bg.mul u' u'') C))
        > Bg.add (Bg.mul u (Bg.mul u' A)) (Bg.add (Bg.mul u (Bg.mul u'' B)) (Bg.mul (Bg.mul u' u'') C))
        =< GB.cong-add (Bg.mulA u u' A)
             (GB.cong-add (LB.mul-swap u u'' B) (trans (ap (\ t -> Bg.mul t C) (Bg.mulC u' u'')) (sym (Bg.mulA u'' u' C))))
        > Bg.add (Bg.mul (Bg.mul u u') A) (Bg.add (Bg.mul u'' (Bg.mul u B)) (Bg.mul u'' (Bg.mul u' C)))
        =< ap (Bg.add (Bg.mul (Bg.mul u u') A)) (sym (Bg.dist u'' (Bg.mul u B) (Bg.mul u' C)))
        > Bg.add (Bg.mul (Bg.mul u u') A) (Bg.mul u'' (Bg.add (Bg.mul u B) (Bg.mul u' C))) } ;
  -- u (A + A') + (u' + u'') C = (u A + u' C) + (u A' + u'' C)
  dist-v (u u' u'' A A' C : Bg.R) :
    Id Bg.R (Bg.add (Bg.mul u (Bg.add A A')) (Bg.mul (Bg.add u' u'') C))
            (Bg.add (Bg.add (Bg.mul u A) (Bg.mul u' C)) (Bg.add (Bg.mul u A') (Bg.mul u'' C))) =
    trans (GB.cong-add (Bg.dist u A A') (LB.dist-left u' u'' C))
          (LB.swap (Bg.mul u A) (Bg.mul u A') (Bg.mul u' C) (Bg.mul u'' C)) ;

  ring : CRing = mkCRing Car zeroE oneE addE mulE negE
    (\ s s' s'' -> eqE _ _ (Bg.addA s.1 s'.1 s''.1) (\ k -> Bg.addA (s.2 k) (s'.2 k) (s''.2 k)))
    (\ s s' -> eqE _ _ (Bg.addC s.1 s'.1) (\ k -> Bg.addC (s.2 k) (s'.2 k)))
    (\ s -> eqE _ _ (Bg.addZ s.1) (\ k -> Bg.addZ (s.2 k)))
    (\ s -> eqE _ _ (Bg.addN s.1) (\ k -> Bg.addN (s.2 k)))
    (\ s s' s'' -> eqE _ _ (Bg.mulA s.1 s'.1 s''.1) (\ k -> assoc-v s.1 s'.1 s''.1 (s''.2 k) (s'.2 k) (s.2 k)))
    (\ s s' -> eqE _ _ (Bg.mulC s.1 s'.1) (\ k -> Bg.addC (Bg.mul s.1 (s'.2 k)) (Bg.mul s'.1 (s.2 k))))
    (\ s -> eqE _ _ (Bg.mulO s.1)
       (\ k -> trans (GB.cong-add (LB.mul-zero s.1) (LB.one-left (s.2 k))) (LB.zl (s.2 k))))
    (\ s s' s'' -> eqE _ _ (Bg.dist s.1 s'.1 s''.1) (\ k -> dist-v s.1 s'.1 s''.1 (s'.2 k) (s''.2 k) (s.2 k))) ;

  -- B as constants, and the product of an element with one of the module
  incl (u : Bg.R) : Car = (u, \ k -> Bg.z) ;
  mod (v : Vec) : Car = (Bg.z, v) ;
  -- (u, v) (0, w) = (0, u w)
  times-mod (s : Car) (w : Vec) : Id Car (mulE s (mod w)) (mod (\ k -> Bg.mul s.1 (w k))) =
    eqE _ _ (LB.mul-zero s.1) (\ k -> trans (ap (Bg.add (Bg.mul s.1 (w k))) (LB.zero-mul (s.2 k))) (Bg.addZ (Bg.mul s.1 (w k)))) ;
  incl-hom : RingHom[l].Hom Bg ring =
    (incl, refl oneE,
     \ u u' -> eqE _ _ (refl (Bg.add u u')) (\ k -> sym (Bg.addZ Bg.z)),
     \ u u' -> eqE _ _ (refl (Bg.mul u u'))
                 (\ k -> sym (trans (GB.cong-add (LB.mul-zero u) (LB.mul-zero u')) (Bg.addZ Bg.z)))) ;
} ;
