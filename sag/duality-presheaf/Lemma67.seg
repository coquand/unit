-- Lemma67.seg (DUALITY.md P2.2, jonas.pdf Lemma 67), for context maps.
-- Given a levelwise equivalence f : T -> G and a fibrant D-modal Q over G,
-- restriction El(G , Q) -> El(T , Q[f]) is an equivalence of Unit types.
--
-- Informal text (the paper's proof, on elements).  The diagram
--     El(G , Q)    -De->  El(DG , D~Q)       -tau_G^*->  El(G , D~Q[tau_G])
--       |f^*                 |(Df)^*                         |f^*
--     El(T , Q[f]) -De->  El(DT , D~Q[Df])   -tau_T^*->  El(T , D~Q[tau_G][f])
-- (bottom maps followed by the transports along DT-sub and along
-- D~Q[Df][tau_T] = D~Q[tau_G][f], by subT-o and tau-nat) commutes: the
-- left square is De-sub, the right square is subt-o twice and tau-nat.
-- Each horizontal composite is, up to transports, the action of tau_Q
-- (hc-tau), an equivalence since Q and Q[f] are D-modal (post-eq,
-- Modal-sub).  (Df)^* is an equivalence: Df is an internal equivalence
-- (D-eq) and D~Q is fibrant (DT-fib, restr-eq).  Lemma 66 (P2.1).
-- Coherence: every step is a transport identity proved by J on ONE path
-- (TM.trE-tr, TM.trE-sym, TM.trE-sub, TM.trE-apS); no two law-paths are compared.

level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module L67 (C : T2[l, k].PCwF) (S : T2[l, k].Site[C]) (Dd : T2[l, k].DS[C, S]) {
  module DR = T2[l, k].Der[C] ;
  module TM = TE[l, k].TEm[C] ;

  --------------------------------------------------------------------
  -- transports of elements

  -- f after an equivalence after a transport, up to homotopy
  eq3 (A A' B B' : U l) (P : A -> A') (e : A' -> B') (R : B' -> B) (f : A -> B)
    (eP : isEquiv A A' P) (ee : isEquiv A' B' e) (eR : isEquiv B' B R) (h : (x : A) -> Id B (f x) (R (e (P x)))) : isEquiv A B f =
    Equivalences[k].homotopy A B
      (Equivalences[k].compose A B' B (Equivalences[k].compose A A' B' (P, eP) (e, ee)) (R, eR)) f h ;

  --------------------------------------------------------------------
  -- the diagram

  module D67 (T G : C.Ctx) (f : C.Sub T G) (lf : DR.Pts[S].LEqC T G f) (Q : C.Ty G) (fQ : Dd.Fib G Q) (mQ : Dd.Modal G Q) {
    Q' : C.Ty (Dd.DC G) = Dd.DT G Q ;
    Qt : C.Ty G = C.subT G (Dd.DC G) Q' (Dd.tauC G) ;
    Qf : C.Ty T = C.subT T G Q f ;
    QD : C.Ty (Dd.DC T) = C.subT (Dd.DC T) (Dd.DC G) Q' (Dd.DSb T G f) ;
    Qtf : C.Ty T = C.subT T G Qt f ;

    -- the transport of the right column: D~Q[Df][tau_T] = D~Q[tau_G][f]
    so1 : Id (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) (C.subT T (Dd.DC T) QD (Dd.tauC T)) =
      C.subT-o T (Dd.DC T) (Dd.DC G) Q' (Dd.DSb T G f) (Dd.tauC T) ;
    apn : Id (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) (C.subT T (Dd.DC G) Q' (C.o T G (Dd.DC G) (Dd.tauC G) f)) =
      ap (C.Sub T (Dd.DC G)) (C.Ty T) (\ t -> C.subT T (Dd.DC G) Q' t) (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T)) (C.o T G (Dd.DC G) (Dd.tauC G) f) (Dd.tau-nat T G f) ;
    so2 : Id (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T G (Dd.DC G) (Dd.tauC G) f)) Qtf = C.subT-o T G (Dd.DC G) Q' (Dd.tauC G) f ;

    -- the maps
    s0 (x : C.El G Q) : C.El (Dd.DC G) Q' = Dd.De G Q x ;
    r0 (y : C.El (Dd.DC G) Q') : C.El G Qt = C.subt G (Dd.DC G) Q' y (Dd.tauC G) ;
    s1 (x : C.El T Qf) : C.El (Dd.DC T) QD = DR.trE (Dd.DC T) (Dd.DT T Qf) QD (Dd.DT-sub T G Q f) (Dd.De T Qf x) ;
    r1 (y : C.El (Dd.DC T) QD) : C.El T Qtf =
      DR.trE T (C.subT T (Dd.DC T) QD (Dd.tauC T)) Qtf
        (trans (C.Ty T) (C.subT T (Dd.DC T) QD (Dd.tauC T)) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) Qtf
           (sym (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) (C.subT T (Dd.DC T) QD (Dd.tauC T)) so1)
           (trans (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) (C.subT T (Dd.DC G) Q' (C.o T G (Dd.DC G) (Dd.tauC G) f)) Qtf apn so2))
        (C.subt T (Dd.DC T) QD y (Dd.tauC T)) ;
    a (x : C.El G Q) : C.El T Qf = C.subt T G Q x f ;
    b (y : C.El (Dd.DC G) Q') : C.El (Dd.DC T) QD = C.subt (Dd.DC T) (Dd.DC G) Q' y (Dd.DSb T G f) ;
    c (z : C.El G Qt) : C.El T Qtf = C.subt T G Qt z f ;

    -- the left square
    sq1 (x : C.El G Q) : Id (C.El (Dd.DC T) QD) (b (s0 x)) (s1 (a x)) =
      sym (C.El (Dd.DC T) QD) (s1 (a x)) (b (s0 x)) (Dd.De-sub T G Q f x) ;

    -- the right square: r1 (b y) = c (r0 y) through the points
    --   tr R (tr P z0) , tr R w , tr so2 (tr apn w) , tr so2 (subt y m2)
    sq2 (y : C.El (Dd.DC G) Q') : Id (C.El T Qtf) (c (r0 y)) (r1 (b y)) =
      sym (C.El T Qtf) (r1 (b y)) (c (r0 y))
        (trans (C.El T Qtf) (r1 (b y)) (DR.trE T A2 Qtf R w) (c (r0 y))
          (trans (C.El T Qtf) (r1 (b y)) (DR.trE T A2 Qtf R (DR.trE T A1 A2 P z0)) (DR.trE T A2 Qtf R w)
             (sym (C.El T Qtf) (DR.trE T A2 Qtf R (DR.trE T A1 A2 P z0)) (r1 (b y)) (TM.trE-tr T A1 A2 Qtf P R z0))
             (ap (C.El T A2) (C.El T Qtf) (DR.trE T A2 Qtf R) (DR.trE T A1 A2 P z0) w step2))
          (trans (C.El T Qtf) (DR.trE T A2 Qtf R w) (DR.trE T A3 Qtf so2 (DR.trE T A2 A3 apn w)) (c (r0 y))
             (sym (C.El T Qtf) (DR.trE T A3 Qtf so2 (DR.trE T A2 A3 apn w)) (DR.trE T A2 Qtf R w) (TM.trE-tr T A2 A3 Qtf apn so2 w))
             (trans (C.El T Qtf) (DR.trE T A3 Qtf so2 (DR.trE T A2 A3 apn w)) (DR.trE T A3 Qtf so2 (C.subt T (Dd.DC G) Q' y m2)) (c (r0 y))
                (ap (C.El T A3) (C.El T Qtf) (DR.trE T A3 Qtf so2) (DR.trE T A2 A3 apn w) (C.subt T (Dd.DC G) Q' y m2)
                    (TM.trE-apS T (Dd.DC G) Q' m1 m2 (Dd.tau-nat T G f) y))
                (C.subt-o T G (Dd.DC G) Q' y (Dd.tauC G) f))))
     where {
      m1 : C.Sub T (Dd.DC G) = C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T) ;
      m2 : C.Sub T (Dd.DC G) = C.o T G (Dd.DC G) (Dd.tauC G) f ;
      A1 : C.Ty T = C.subT T (Dd.DC T) QD (Dd.tauC T) ;
      A2 : C.Ty T = C.subT T (Dd.DC G) Q' m1 ;
      A3 : C.Ty T = C.subT T (Dd.DC G) Q' m2 ;
      P : Id (C.Ty T) A1 A2 = sym (C.Ty T) A2 A1 so1 ;
      R : Id (C.Ty T) A2 Qtf = trans (C.Ty T) A2 A3 Qtf apn so2 ;
      z0 : C.El T A1 = C.subt T (Dd.DC T) QD (b y) (Dd.tauC T) ;
      w : C.El T A2 = C.subt T (Dd.DC G) Q' y m1 ;
      -- tr P z0 = w : subt-o, then the transport back cancels
      step2 : Id (C.El T A2) (DR.trE T A1 A2 P z0) w =
        trans (C.El T A2) (DR.trE T A1 A2 P z0) (DR.trE T A1 A2 P (DR.trE T A2 A1 so1 w)) w
          (ap (C.El T A1) (C.El T A2) (DR.trE T A1 A2 P) z0 (DR.trE T A2 A1 so1 w)
              (sym (C.El T A1) (DR.trE T A2 A1 so1 w) z0 (C.subt-o T (Dd.DC T) (Dd.DC G) Q' y (Dd.DSb T G f) (Dd.tauC T))))
          (TM.trE-sym T A2 A1 so1 w) ;
     } ;

    --------------------------------------------------------------------
    -- the three equivalences

    -- r0 s0 is tau_Q's action, up to transports
    e0 : isEquiv (C.El G Q) (C.El G Qt) (\ x -> r0 (s0 x)) =
      eq3 (C.El G Q) (C.El G (C.subT G G Q (C.id G))) (C.El G Qt) (C.El G (C.subT G G Qt (C.id G)))
        (DR.trE G Q (C.subT G G Q (C.id G)) (sym (C.Ty G) (C.subT G G Q (C.id G)) Q (C.subT-id G Q)))
        (DR.postAt G G Q Qt (Dd.tauT G Q) (C.id G))
        (DR.trE G (C.subT G G Qt (C.id G)) Qt (C.subT-id G Qt))
        (\ x -> r0 (s0 x))
        (TM.trE-eq G Q (C.subT G G Q (C.id G)) (sym (C.Ty G) (C.subT G G Q (C.id G)) Q (C.subT-id G Q)))
        (Dd.post-eq G G Q Qt (Dd.tauT G Q) (C.id G) mQ)
        (TM.trE-eq G (C.subT G G Qt (C.id G)) Qt (C.subT-id G Qt))
        (\ x -> Dd.hc-tau G Q x) ;

    -- r1 s1 is tau_{Q[f]}'s action, up to transports
    eT : isEquiv (C.El T Qf) (C.El T (C.subT T (Dd.DC T) (Dd.DT T Qf) (Dd.tauC T))) (\ x -> C.subt T (Dd.DC T) (Dd.DT T Qf) (Dd.De T Qf x) (Dd.tauC T)) =
      eq3 (C.El T Qf) (C.El T (C.subT T T Qf (C.id T))) (C.El T QtT) (C.El T (C.subT T T QtT (C.id T)))
        (DR.trE T Qf (C.subT T T Qf (C.id T)) (sym (C.Ty T) (C.subT T T Qf (C.id T)) Qf (C.subT-id T Qf)))
        (DR.postAt T T Qf QtT (Dd.tauT T Qf) (C.id T))
        (DR.trE T (C.subT T T QtT (C.id T)) QtT (C.subT-id T QtT))
        (\ x -> C.subt T (Dd.DC T) (Dd.DT T Qf) (Dd.De T Qf x) (Dd.tauC T))
        (TM.trE-eq T Qf (C.subT T T Qf (C.id T)) (sym (C.Ty T) (C.subT T T Qf (C.id T)) Qf (C.subT-id T Qf)))
        (Dd.post-eq T T Qf QtT (Dd.tauT T Qf) (C.id T) (Dd.Modal-sub T G Q f mQ))
        (TM.trE-eq T (C.subT T T QtT (C.id T)) QtT (C.subT-id T QtT))
        (\ x -> Dd.hc-tau T Qf x)
     where { QtT : C.Ty T = C.subT T (Dd.DC T) (Dd.DT T Qf) (Dd.tauC T) ; } ;

    -- r1 s1 = (transports) after the above: TM.trE-sub moves the DT-sub
    -- transport out of the restriction along tau_T
    e1 : isEquiv (C.El T Qf) (C.El T Qtf) (\ x -> r1 (s1 x)) =
      Equivalences[k].homotopy (C.El T Qf) (C.El T Qtf)
        (Equivalences[k].compose (C.El T Qf) (C.El T (C.subT T (Dd.DC T) QD (Dd.tauC T))) (C.El T Qtf)
           (Equivalences[k].compose (C.El T Qf) (C.El T QtT) (C.El T (C.subT T (Dd.DC T) QD (Dd.tauC T)))
              (\ x -> C.subt T (Dd.DC T) (Dd.DT T Qf) (Dd.De T Qf x) (Dd.tauC T), eT)
              (DR.trE T QtT (C.subT T (Dd.DC T) QD (Dd.tauC T)) apD, TM.trE-eq T QtT (C.subT T (Dd.DC T) QD (Dd.tauC T)) apD))
           (\ z -> r1z z, TM.trE-eq T (C.subT T (Dd.DC T) QD (Dd.tauC T)) Qtf RR))
        (\ x -> r1 (s1 x))
        (\ x -> ap (C.El T (C.subT T (Dd.DC T) QD (Dd.tauC T))) (C.El T Qtf) r1z _ _
                   (TM.trE-sub T (Dd.DC T) (Dd.tauC T) (Dd.DT T Qf) QD (Dd.DT-sub T G Q f) (Dd.De T Qf x)))
     where {
      QtT : C.Ty T = C.subT T (Dd.DC T) (Dd.DT T Qf) (Dd.tauC T) ;
      apD : Id (C.Ty T) QtT (C.subT T (Dd.DC T) QD (Dd.tauC T)) =
        ap (C.Ty (Dd.DC T)) (C.Ty T) (\ X -> C.subT T (Dd.DC T) X (Dd.tauC T)) (Dd.DT T Qf) QD (Dd.DT-sub T G Q f) ;
      RR : Id (C.Ty T) (C.subT T (Dd.DC T) QD (Dd.tauC T)) Qtf =
        trans (C.Ty T) (C.subT T (Dd.DC T) QD (Dd.tauC T)) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) Qtf
          (sym (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) (C.subT T (Dd.DC T) QD (Dd.tauC T)) so1)
          (trans (C.Ty T) (C.subT T (Dd.DC G) Q' (C.o T (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) (Dd.tauC T))) (C.subT T (Dd.DC G) Q' (C.o T G (Dd.DC G) (Dd.tauC G) f)) Qtf apn so2) ;
      r1z (z : C.El T (C.subT T (Dd.DC T) QD (Dd.tauC T))) : C.El T Qtf = DR.trE T (C.subT T (Dd.DC T) QD (Dd.tauC T)) Qtf RR z ;
     } ;

    -- (Df)^* : Df is an internal equivalence (S2.4), D~Q is fibrant
    eb : isEquiv (C.El (Dd.DC G) Q') (C.El (Dd.DC T) QD) b =
      Dd.restr-eq (Dd.DC T) (Dd.DC G) (Dd.DSb T G f) Q' (Dd.D-eq T G f lf) (Dd.DT-fib G Q fQ) ;

    module LL = Lemma66[k].L66[C.El G Q, C.El (Dd.DC G) Q', C.El G Qt, C.El T Qf, C.El (Dd.DC T) QD, C.El T Qtf,
      s0, r0, s1, r1, a, b, c, sq1, sq2, e0, e1, eb] ;

    -- Lemma 67
    lemma67 : isEquiv (C.El G Q) (C.El T Qf) (\ x -> C.subt T G Q x f) = LL.ea ;
  } ;
} ;
