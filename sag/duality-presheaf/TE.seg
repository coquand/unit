-- TE.seg: transports of elements along paths of types, and the relation
-- "x is a transport of y" (TE), for a presheaf CwF of T2.
--   trE-eq, trE-tr, trE-sym, trE-sub, trE-apS : transport identities, each
--     by J on ONE path (no comparison of law-paths);
--   TE x y = (P : A = B) * (trE P x = y), with teR, teTr, teS, teT, teSub;
--   teAny : a TE gives trE P' x = y for ANY path P' : A = B.  This is the
--     only use of PCwF.isSetTy (types form a set).

level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module TEm (C : T2[l, k].PCwF) {
  module DR = T2[l, k].Der[C] ;

  trE-eq (G : C.Ctx) (A B : C.Ty G) (P : Id (C.Ty G) A B) : isEquiv (C.El G A) (C.El G B) (DR.trE G A B P) =
    idJ (C.Ty G) A (\ B2 P2 -> isEquiv (C.El G A) (C.El G B2) (DR.trE G A B2 P2))
      (qinv (C.El G A) (C.El G A) (DR.trE G A A (refl A)) (\ z -> z) (\ z -> refl z) (\ z -> refl z)) B P ;

  trE-tr (G : C.Ctx) (A B E : C.Ty G) (P : Id (C.Ty G) A B) (Q : Id (C.Ty G) B E) (z : C.El G A)
    : Id (C.El G E) (DR.trE G B E Q (DR.trE G A B P z)) (DR.trE G A E (trans (C.Ty G) A B E P Q) z) =
    idJ (C.Ty G) B (\ E2 Q2 -> Id (C.El G E2) (DR.trE G B E2 Q2 (DR.trE G A B P z)) (DR.trE G A E2 (trans (C.Ty G) A B E2 P Q2) z))
      (refl (DR.trE G A B P z)) E Q ;

  trE-sym (G : C.Ctx) (A B : C.Ty G) (P : Id (C.Ty G) A B) (z : C.El G A)
    : Id (C.El G A) (DR.trE G B A (sym (C.Ty G) A B P) (DR.trE G A B P z)) z =
    idJ (C.Ty G) A (\ B2 P2 -> Id (C.El G A) (DR.trE G B2 A (sym (C.Ty G) A B2 P2) (DR.trE G A B2 P2 z)) z) (refl z) B P ;

  -- transport commutes with restriction
  trE-sub (T G : C.Ctx) (s : C.Sub T G) (A B : C.Ty G) (P : Id (C.Ty G) A B) (z : C.El G A)
    : Id (C.El T (C.subT T G B s)) (C.subt T G B (DR.trE G A B P z) s)
         (DR.trE T (C.subT T G A s) (C.subT T G B s) (ap (C.Ty G) (C.Ty T) (\ X -> C.subT T G X s) A B P) (C.subt T G A z s)) =
    idJ (C.Ty G) A (\ B2 P2 -> Id (C.El T (C.subT T G B2 s)) (C.subt T G B2 (DR.trE G A B2 P2 z) s)
                                 (DR.trE T (C.subT T G A s) (C.subT T G B2 s) (ap (C.Ty G) (C.Ty T) (\ X -> C.subT T G X s) A B2 P2) (C.subt T G A z s)))
      (refl (C.subt T G A z s)) B P ;

  -- restriction along a path of substitutions is a transport
  trE-apS (T G : C.Ctx) (Q : C.Ty G) (s s' : C.Sub T G) (e : Id (C.Sub T G) s s') (y : C.El G Q)
    : Id (C.El T (C.subT T G Q s')) (DR.trE T (C.subT T G Q s) (C.subT T G Q s') (ap (C.Sub T G) (C.Ty T) (\ t -> C.subT T G Q t) s s' e) (C.subt T G Q y s))
         (C.subt T G Q y s') =
    idJ (C.Sub T G) s (\ s2 e2 -> Id (C.El T (C.subT T G Q s2)) (DR.trE T (C.subT T G Q s) (C.subT T G Q s2) (ap (C.Sub T G) (C.Ty T) (\ t -> C.subT T G Q t) s s2 e2) (C.subt T G Q y s))
                                     (C.subt T G Q y s2))
      (refl (C.subt T G Q y s)) s' e ;

  ----------------------------------------------------------------------
  -- x is a transport of y

  TE (G : C.Ctx) (A B : C.Ty G) (x : C.El G A) (y : C.El G B) : U k = (P : Id (C.Ty G) A B) * Id (C.El G B) (DR.trE G A B P x) y ;

  teR (G : C.Ctx) (A : C.Ty G) (x y : C.El G A) (e : Id (C.El G A) x y) : TE G A A x y = (refl A, e) ;

  teTr (G : C.Ctx) (A B : C.Ty G) (P : Id (C.Ty G) A B) (x : C.El G A) : TE G A B x (DR.trE G A B P x) = (P, refl (DR.trE G A B P x)) ;

  teS (G : C.Ctx) (A B : C.Ty G) (x : C.El G A) (y : C.El G B) (h : TE G A B x y) : TE G B A y x =
    (sym (C.Ty G) A B h.1,
     trans (C.El G A) (DR.trE G B A (sym (C.Ty G) A B h.1) y) (DR.trE G B A (sym (C.Ty G) A B h.1) (DR.trE G A B h.1 x)) x
       (ap (C.El G B) (C.El G A) (DR.trE G B A (sym (C.Ty G) A B h.1)) y (DR.trE G A B h.1 x) (sym (C.El G B) (DR.trE G A B h.1 x) y h.2))
       (trE-sym G A B h.1 x)) ;

  teT (G : C.Ctx) (A B E : C.Ty G) (x : C.El G A) (y : C.El G B) (z : C.El G E) (h1 : TE G A B x y) (h2 : TE G B E y z) : TE G A E x z =
    (trans (C.Ty G) A B E h1.1 h2.1,
     trans (C.El G E) (DR.trE G A E (trans (C.Ty G) A B E h1.1 h2.1) x) (DR.trE G B E h2.1 (DR.trE G A B h1.1 x)) z
       (sym (C.El G E) (DR.trE G B E h2.1 (DR.trE G A B h1.1 x)) (DR.trE G A E (trans (C.Ty G) A B E h1.1 h2.1) x) (trE-tr G A B E h1.1 h2.1 x))
       (trans (C.El G E) (DR.trE G B E h2.1 (DR.trE G A B h1.1 x)) (DR.trE G B E h2.1 y) z
          (ap (C.El G B) (C.El G E) (DR.trE G B E h2.1) (DR.trE G A B h1.1 x) y h1.2) h2.2)) ;

  teSub (T G : C.Ctx) (s : C.Sub T G) (A B : C.Ty G) (x : C.El G A) (y : C.El G B) (h : TE G A B x y)
    : TE T (C.subT T G A s) (C.subT T G B s) (C.subt T G A x s) (C.subt T G B y s) =
    (ap (C.Ty G) (C.Ty T) (\ X -> C.subT T G X s) A B h.1,
     trans (C.El T (C.subT T G B s)) (DR.trE T (C.subT T G A s) (C.subT T G B s) (ap (C.Ty G) (C.Ty T) (\ X -> C.subT T G X s) A B h.1) (C.subt T G A x s))
       (C.subt T G B (DR.trE G A B h.1 x) s) (C.subt T G B y s)
       (sym (C.El T (C.subT T G B s)) (C.subt T G B (DR.trE G A B h.1 x) s) (DR.trE T (C.subT T G A s) (C.subT T G B s) (ap (C.Ty G) (C.Ty T) (\ X -> C.subT T G X s) A B h.1) (C.subt T G A x s))
          (trE-sub T G s A B h.1 x))
       (ap (C.El G B) (C.El T (C.subT T G B s)) (\ z -> C.subt T G B z s) (DR.trE G A B h.1 x) y h.2)) ;

  -- types form a set, so the path of a TE is irrelevant
  teAny (G : C.Ctx) (A B : C.Ty G) (x : C.El G A) (y : C.El G B) (h : TE G A B x y) (P : Id (C.Ty G) A B)
    : Id (C.El G B) (DR.trE G A B P x) y =
    trans (C.El G B) (DR.trE G A B P x) (DR.trE G A B h.1 x) y
      (ap (Id (C.Ty G) A B) (C.El G B) (\ Q -> DR.trE G A B Q x) P h.1 (C.isSetTy G A B P h.1)) h.2 ;

  ----------------------------------------------------------------------
  -- maps into a context extension, through their parts

  -- the q-part of a map into G.A
  qv (D G : C.Ctx) (A : C.Ty G) (t : C.Sub D (C.ext G A)) : C.El D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) = (DR.extFwd D G A t).2 ;

  -- restriction along a path of substitutions
  teApS (T G : C.Ctx) (Q : C.Ty G) (s s' : C.Sub T G) (e : Id (C.Sub T G) s s') (y : C.El G Q)
    : TE T (C.subT T G Q s) (C.subT T G Q s') (C.subt T G Q y s) (C.subt T G Q y s') =
    (ap (C.Sub T G) (C.Ty T) (\ t -> C.subT T G Q t) s s' e, trE-apS T G Q s s' e y) ;

  -- the parts of a pair
  qvPair (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (a : C.El D (C.subT D G A s))
    : TE D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) (C.subT D G A s) (qv D G A (C.pair D G A s a)) a =
    teT D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)))
          (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.pair D G A s a)) (C.subT D G A s)
          (qv D G A (C.pair D G A s a)) (C.subt D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A) (C.pair D G A s a)) a
      (teS D (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.pair D G A s a)) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)))
          (C.subt D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A) (C.pair D G A s a)) (qv D G A (C.pair D G A s a))
          (teTr D (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.pair D G A s a)) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)))
             (sym (C.Ty D) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.pair D G A s a))
                  (C.subT-o D (C.ext G A) G A (C.p G A) (C.pair D G A s a)))
             (C.subt D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A) (C.pair D G A s a))))
      (DR.wkp D G A A s a, C.q-pair D G A s a) ;

  -- the parts of a composite
  pO (T D G : C.Ctx) (A : C.Ty G) (t : C.Sub D (C.ext G A)) (r : C.Sub T D)
    : Id (C.Sub T G) (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r)) (C.o T D G (C.o D (C.ext G A) G (C.p G A) t) r) =
    sym (C.Sub T G) (C.o T D G (C.o D (C.ext G A) G (C.p G A) t) r) (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r))
      (C.o-assoc T D (C.ext G A) G (C.p G A) t r) ;

  qvO (T D G : C.Ctx) (A : C.Ty G) (t : C.Sub D (C.ext G A)) (r : C.Sub T D)
    : TE T (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r))) (C.subT T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) r)
          (qv T G A (C.o T D (C.ext G A) t r)) (C.subt T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (qv D G A t) r) =
    teT T (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r))) (C.subT T (C.ext G A) Ap (C.o T D (C.ext G A) t r))
          (C.subT T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) r)
          (qv T G A (C.o T D (C.ext G A) t r)) (C.subt T (C.ext G A) Ap (C.q G A) (C.o T D (C.ext G A) t r)) (C.subt T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (qv D G A t) r)
      (teS T (C.subT T (C.ext G A) Ap (C.o T D (C.ext G A) t r)) (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r)))
          (C.subt T (C.ext G A) Ap (C.q G A) (C.o T D (C.ext G A) t r)) (qv T G A (C.o T D (C.ext G A) t r))
          (teTr T (C.subT T (C.ext G A) Ap (C.o T D (C.ext G A) t r)) (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r)))
             (sym (C.Ty T) (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) t r))) (C.subT T (C.ext G A) Ap (C.o T D (C.ext G A) t r))
                  (C.subT-o T (C.ext G A) G A (C.p G A) (C.o T D (C.ext G A) t r)))
             (C.subt T (C.ext G A) Ap (C.q G A) (C.o T D (C.ext G A) t r))))
      (teT T (C.subT T (C.ext G A) Ap (C.o T D (C.ext G A) t r)) (C.subT T D (C.subT D (C.ext G A) Ap t) r) (C.subT T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) r)
          (C.subt T (C.ext G A) Ap (C.q G A) (C.o T D (C.ext G A) t r)) (C.subt T D (C.subT D (C.ext G A) Ap t) (C.subt D (C.ext G A) Ap (C.q G A) t) r)
          (C.subt T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (qv D G A t) r)
         (C.subT-o T D (C.ext G A) Ap t r, C.subt-o T D (C.ext G A) Ap (C.q G A) t r)
         (teSub T D r (C.subT D (C.ext G A) Ap t) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (C.subt D (C.ext G A) Ap (C.q G A) t) (qv D G A t)
            (teTr D (C.subT D (C.ext G A) Ap t) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t))
               (sym (C.Ty D) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (C.subT D (C.ext G A) Ap t) (C.subT-o D (C.ext G A) G A (C.p G A) t))
               (C.subt D (C.ext G A) Ap (C.q G A) t))))
   where { Ap : C.Ty (C.ext G A) = C.subT (C.ext G A) G A (C.p G A) ; } ;

  -- two maps into G.A with equal parts are equal (extEquiv is injective)
  subExt (D G : C.Ctx) (A : C.Ty G) (t t' : C.Sub D (C.ext G A))
    (e : Id (C.Sub D G) (C.o D (C.ext G A) G (C.p G A) t) (C.o D (C.ext G A) G (C.p G A) t'))
    (h : TE D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t')) (qv D G A t) (qv D G A t'))
    : Id (C.Sub D (C.ext G A)) t t' =
    Equivalences[k].injective (C.Sub D (C.ext G A)) ((s : C.Sub D G) * C.El D (C.subT D G A s)) (DR.extFwd D G A) (DR.extEquiv D G A).2 t t'
      (Sigma-path (C.Sub D G) (\ s -> C.El D (C.subT D G A s)) (C.o D (C.ext G A) G (C.p G A) t) (C.o D (C.ext G A) G (C.p G A) t') (qv D G A t) (qv D G A t') e
         (trans (C.El D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t')))
            (subst (C.Sub D G) (\ s -> C.El D (C.subT D G A s)) (C.o D (C.ext G A) G (C.p G A) t) (C.o D (C.ext G A) G (C.p G A) t') e (qv D G A t))
            (DR.trE D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t'))
               (ap (C.Sub D G) (C.Ty D) (\ s -> C.subT D G A s) (C.o D (C.ext G A) G (C.p G A) t) (C.o D (C.ext G A) G (C.p G A) t') e) (qv D G A t))
            (qv D G A t')
            (subst-ap (C.Sub D G) (C.Ty D) (\ s -> C.subT D G A s) (\ X -> C.El D X) (C.o D (C.ext G A) G (C.p G A) t) (C.o D (C.ext G A) G (C.p G A) t') e (qv D G A t))
            (teAny D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t)) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) t')) (qv D G A t) (qv D G A t') h
               (ap (C.Sub D G) (C.Ty D) (\ s -> C.subT D G A s) (C.o D (C.ext G A) G (C.p G A) t) (C.o D (C.ext G A) G (C.p G A) t') e)))) ;

  ----------------------------------------------------------------------
  -- maps out of / into an extension by a type, moved along a path of types

  -- a map into D.X1, moved to D.X2
  trSub (D' D : C.Ctx) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (w : C.Sub D' (C.ext D X1)) : C.Sub D' (C.ext D X2) =
    subst (C.Ty D) (\ X -> C.Sub D' (C.ext D X)) X1 X2 PA w ;

  pTrW (D' D : C.Ctx) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (w : C.Sub D' (C.ext D X1))
    : Id (C.Sub D' D) (C.o D' (C.ext D X2) D (C.p D X2) (trSub D' D X1 X2 PA w)) (C.o D' (C.ext D X1) D (C.p D X1) w) =
    idJ (C.Ty D) X1 (\ X2' PA' -> Id (C.Sub D' D) (C.o D' (C.ext D X2') D (C.p D X2') (trSub D' D X1 X2' PA' w)) (C.o D' (C.ext D X1) D (C.p D X1) w))
      (refl (C.o D' (C.ext D X1) D (C.p D X1) w)) X2 PA ;

  qTrW (D' D : C.Ctx) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (w : C.Sub D' (C.ext D X1))
    : TE D' (C.subT D' D X2 (C.o D' (C.ext D X2) D (C.p D X2) (trSub D' D X1 X2 PA w))) (C.subT D' D X1 (C.o D' (C.ext D X1) D (C.p D X1) w))
         (qv D' D X2 (trSub D' D X1 X2 PA w)) (qv D' D X1 w) =
    idJ (C.Ty D) X1 (\ X2' PA' -> TE D' (C.subT D' D X2' (C.o D' (C.ext D X2') D (C.p D X2') (trSub D' D X1 X2' PA' w))) (C.subT D' D X1 (C.o D' (C.ext D X1) D (C.p D X1) w))
                                     (qv D' D X2' (trSub D' D X1 X2' PA' w)) (qv D' D X1 w))
      (teR D' (C.subT D' D X1 (C.o D' (C.ext D X1) D (C.p D X1) w)) (qv D' D X1 w) (qv D' D X1 w) (refl (qv D' D X1 w))) X2 PA ;

  -- a map out of D.X1, moved to D.X2
  trDom (D H : C.Ctx) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (t : C.Sub (C.ext D X1) H) : C.Sub (C.ext D X2) H =
    subst (C.Ty D) (\ X -> C.Sub (C.ext D X) H) X1 X2 PA t ;

  pTrD (D G : C.Ctx) (A : C.Ty G) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (t : C.Sub (C.ext D X1) (C.ext G A)) (gg : C.Sub D G)
    (e : Id (C.Sub (C.ext D X1) G) (C.o (C.ext D X1) (C.ext G A) G (C.p G A) t) (C.o (C.ext D X1) D G gg (C.p D X1)))
    : Id (C.Sub (C.ext D X2) G) (C.o (C.ext D X2) (C.ext G A) G (C.p G A) (trDom D (C.ext G A) X1 X2 PA t)) (C.o (C.ext D X2) D G gg (C.p D X2)) =
    idJ (C.Ty D) X1 (\ X2' PA' -> Id (C.Sub (C.ext D X2') G) (C.o (C.ext D X2') (C.ext G A) G (C.p G A) (trDom D (C.ext G A) X1 X2' PA' t)) (C.o (C.ext D X2') D G gg (C.p D X2')))
      e X2 PA ;

  qTrD (D G : C.Ctx) (A : C.Ty G) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (t : C.Sub (C.ext D X1) (C.ext G A))
    (h : TE (C.ext D X1) (C.subT (C.ext D X1) G A (C.o (C.ext D X1) (C.ext G A) G (C.p G A) t)) (C.subT (C.ext D X1) D X1 (C.p D X1)) (qv (C.ext D X1) G A t) (C.q D X1))
    : TE (C.ext D X2) (C.subT (C.ext D X2) G A (C.o (C.ext D X2) (C.ext G A) G (C.p G A) (trDom D (C.ext G A) X1 X2 PA t))) (C.subT (C.ext D X2) D X2 (C.p D X2))
         (qv (C.ext D X2) G A (trDom D (C.ext G A) X1 X2 PA t)) (C.q D X2) =
    idJ (C.Ty D) X1 (\ X2' PA' -> TE (C.ext D X2') (C.subT (C.ext D X2') G A (C.o (C.ext D X2') (C.ext G A) G (C.p G A) (trDom D (C.ext G A) X1 X2' PA' t))) (C.subT (C.ext D X2') D X2' (C.p D X2'))
                                       (qv (C.ext D X2') G A (trDom D (C.ext G A) X1 X2' PA' t)) (C.q D X2'))
      h X2 PA ;
} ;

