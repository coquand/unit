-- Lemma66.seg (DUALITY.md P2.1, jonas.pdf Lemma 66): in the reading (A)
-- (internal to cSet), Lemma 66 is a statement about types of Unit, proved
-- here.  Given a diagram
--     A0 -s0-> B0 -r0-> C0
--     |a       |b       |c
--     A1 -s1-> B1 -r1-> C1
-- with b s0 ~ s1 a and c r0 ~ r1 b, if r0 s0, r1 s1 and b are
-- equivalences, so are a and c.
--
-- Informal text (the paper's proof).  k := r0 b^-1 s1 : A1 -> C0 has
-- k a ~ r0 s0 and c k ~ r1 s1, so k a and c k are equivalences.  Then
-- (2-out-of-6) k is an equivalence: a (k a)^-1 is a section and
-- (c k)^-1 c a retraction.  So a ~ k^-1 (k a) and c ~ (c k) k^-1 are
-- equivalences.

level l ;
open Base ;
open Prelude[l] ;

-- the inverse of an equivalence, as an equivalence
invEquiv (A B : U l) (f : A -> B) (e : isEquiv A B f) : Equiv B A =
  (e.sec, qinv B A e.sec f (sec-ret A B f e) e.sec-eq) ;

-- 2-out-of-6, in the form used: if k a and c k are equivalences, so is k
sixK (A0 A1 C0 C1 : U l) (a : A0 -> A1) (k : A1 -> C0) (c : C0 -> C1)
  (eka : isEquiv A0 C0 (\ x -> k (a x))) (eck : isEquiv A1 C1 (\ y -> c (k y))) : isEquiv A1 C0 k =
  new IsEquiv[A1, C0, k,
    sec := \ z -> a (eka.sec z),
    sec-eq := \ z -> eka.sec-eq z,
    ret := \ z -> eck.ret (c z),
    ret-eq := \ y -> eck.ret-eq y] ;

module L66 (A0 B0 C0 A1 B1 C1 : U l)
  (s0 : A0 -> B0) (r0 : B0 -> C0) (s1 : A1 -> B1) (r1 : B1 -> C1)
  (a : A0 -> A1) (b : B0 -> B1) (c : C0 -> C1)
  (sq1 : (x : A0) -> Id B1 (b (s0 x)) (s1 (a x)))
  (sq2 : (y : B0) -> Id C1 (c (r0 y)) (r1 (b y)))
  (e0 : isEquiv A0 C0 (\ x -> r0 (s0 x))) (e1 : isEquiv A1 C1 (\ y -> r1 (s1 y))) (eb : isEquiv B0 B1 b) {

  k (y : A1) : C0 = r0 (eb.sec (s1 y)) ;

  -- k a ~ r0 s0
  ka (x : A0) : Id C0 (r0 (s0 x)) (k (a x)) =
    sym C0 (k (a x)) (r0 (s0 x))
      (trans C0 (k (a x)) (r0 (eb.sec (b (s0 x)))) (r0 (s0 x))
         (ap B1 C0 (\ z -> r0 (eb.sec z)) (s1 (a x)) (b (s0 x)) (sym B1 (b (s0 x)) (s1 (a x)) (sq1 x)))
         (ap B0 C0 r0 (eb.sec (b (s0 x))) (s0 x) (sec-ret B0 B1 b eb (s0 x)))) ;

  -- c k ~ r1 s1
  ck (y : A1) : Id C1 (r1 (s1 y)) (c (k y)) =
    sym C1 (c (k y)) (r1 (s1 y))
      (trans C1 (c (k y)) (r1 (b (eb.sec (s1 y)))) (r1 (s1 y))
         (sq2 (eb.sec (s1 y)))
         (ap B1 C1 r1 (b (eb.sec (s1 y))) (s1 y) (eb.sec-eq (s1 y)))) ;

  eka : isEquiv A0 C0 (\ x -> k (a x)) =
    Equivalences[l].homotopy A0 C0 (\ x -> r0 (s0 x), e0) (\ x -> k (a x)) (\ x -> sym C0 (r0 (s0 x)) (k (a x)) (ka x)) ;

  eck : isEquiv A1 C1 (\ y -> c (k y)) =
    Equivalences[l].homotopy A1 C1 (\ y -> r1 (s1 y), e1) (\ y -> c (k y)) (\ y -> sym C1 (r1 (s1 y)) (c (k y)) (ck y)) ;

  ek : isEquiv A1 C0 k = sixK A0 A1 C0 C1 a k c eka eck ;

  -- a = k^-1 (k a)
  ea : isEquiv A0 A1 a =
    Equivalences[l].homotopy A0 A1 (Equivalences[l].compose A0 C0 A1 (\ x -> k (a x), eka) (invEquiv A1 C0 k ek)) a
      (\ x -> sym A1 (ek.sec (k (a x))) (a x) (sec-ret A1 C0 k ek (a x))) ;

  -- c = (c k) k^-1
  ec : isEquiv C0 C1 c =
    Equivalences[l].homotopy C0 C1 (Equivalences[l].compose C0 A1 C1 (invEquiv A1 C0 k ek) (\ y -> c (k y), eck)) c
      (\ z -> sym C1 (c (k (ek.sec z))) (c z) (ap C0 C1 c (k (ek.sec z)) z (ek.sec-eq z))) ;
} ;
