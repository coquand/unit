-- Prop69.seg (DUALITY.md P2.3, jonas.pdf Prop 69, the modal Yoneda lemma).
-- A homotopy representation d : yo x -> Th of a (levelwise fibrant)
-- context Th is a levelwise equivalence; for P : Ty Th fibrant and
-- D-modal, El(Th , P) -> P(x , d) = El(yo x , P[d]), u |-> u(x , d) = u[d],
-- is an equivalence.  It is Lemma 67 at f = d (P(x , d) is the fibre by
-- definition, T2.Der.Pts.fib).

level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module P69 (C : T2[l, k].PCwF) (S : T2[l, k].Site[C]) (Dd : T2[l, k].DS[C, S])
  (Th : C.Ctx) (x : S.Ob) (d : C.Sub (S.yo x) Th) (lw : T2[l, k].Der[C].Pts[S].LEqC (S.yo x) Th d)
  (P : C.Ty Th) (fP : Dd.Fib Th P) (mP : Dd.Modal Th P) {
  prop69 : isEquiv (C.El Th P) (T2[l, k].Der[C].Pts[S].fib Th P x d) (\ u -> C.subt (S.yo x) Th P u d) =
    Lemma67[l, k].L67[C, S, Dd].D67[S.yo x, Th, d, lw, P, fP, mP].lemma67 ;
} ;
