-- T2.seg (DUALITY.md Tier 2, reading (A): internal to cSet, so Unit is the
-- internal language).  The abstract presheaf model P = PSh(C) and the
-- structure D, as records; no proofs here.  Premise rows of DUALITY.md §3:
--   PCwF      S2.1  the presheaf CwF: Sub and El are Unit TYPES (no isSet
--                   fields), laws are Unit Id (an internal path; the strict
--                   versions are an instantiation obligation, DUALITY.md §4)
--   Site      S2.1  the small category C and its representables yo x
--   PiS       S2.1  Pi with its universal property (an Iso of Unit types)
--                   and its stability
--   DS        S2.2-S2.4, S2.6  fibrancy, internal equivalences and what
--                   they give on elements, D on contexts / types / elements,
--                   tau, D-modality, the strict squares of Lemma 67's
--                   diagram, Lemma 12 / Prop 13, and S2.6 isoT (an iso is
--                   an equivalence; Prop 17 is proved from it in
--                   duality-levelwise/Prop17.seg)
-- Derived (module Der): points pts G x = Sub (yo x) G, fibres
-- fib G A x g = El (yo x) A[g] (by definition, as in DUALITY.md), the
-- action of a map of types on elements (postAt), levelwise equivalences.
--
-- Levels: Sub and El live in U l, Ctx and Ty in U k (k one level up in the
-- instance, where Ty(G) contains the kappa-small data of Tier 3).
-- Every context is levelwise fibrant: its points are Unit types.

level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

------------------------------------------------------------------------
-- S2.1: the presheaf CwF

record PCwF {
  Ctx : U k ;
  Sub (D G : Ctx) : U l ;
  id (G : Ctx) : Sub G G ;
  o (T D G : Ctx) (s : Sub D G) (t : Sub T D) : Sub T G ;
  o-idl (D G : Ctx) (s : Sub D G) : Id (Sub D G) (o D G G (id G) s) s ;
  o-idr (D G : Ctx) (s : Sub D G) : Id (Sub D G) (o D D G s (id D)) s ;
  o-assoc (Q T D G : Ctx) (s : Sub D G) (t : Sub T D) (u : Sub Q T)
    : Id (Sub Q G) (o Q T G (o T D G s t) u) (o Q D G s (o Q T D t u)) ;

  Ty (G : Ctx) : U k ;
  -- types form a set (the homotopical shadow of judgemental type
  -- equalities; Sub and El are NOT sets).  Used only through TE.teAny.
  isSetTy (G : Ctx) : isSet (Ty G) ;
  subT (D G : Ctx) (A : Ty G) (s : Sub D G) : Ty D ;
  subT-id (G : Ctx) (A : Ty G) : Id (Ty G) (subT G G A (id G)) A ;
  subT-o (T D G : Ctx) (A : Ty G) (s : Sub D G) (t : Sub T D)
    : Id (Ty T) (subT T G A (o T D G s t)) (subT T D (subT D G A s) t) ;

  El (G : Ctx) (A : Ty G) : U l ;
  subt (D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) : El D (subT D G A s) ;
  subt-o (T D G : Ctx) (A : Ty G) (a : El G A) (s : Sub D G) (t : Sub T D)
    : Id (El T (subT T D (subT D G A s) t))
         (subst (Ty T) (\ X -> El T X) (subT T G A (o T D G s t)) (subT T D (subT D G A s) t) (subT-o T D G A s t) (subt T G A a (o T D G s t)))
         (subt T D (subT D G A s) (subt D G A a s) t) ;

  -- terms along the identity (the functor law matching subT-id)
  subt-id (G : Ctx) (A : Ty G) (a : El G A)
    : Id (El G A) (subst (Ty G) (\ X -> El G X) (subT G G A (id G)) A (subT-id G A) (subt G G A a (id G))) a ;

  -- context extension
  ext (G : Ctx) (A : Ty G) : Ctx ;
  p (G : Ctx) (A : Ty G) : Sub (ext G A) G ;
  q (G : Ctx) (A : Ty G) : El (ext G A) (subT (ext G A) G A (p G A)) ;
  pair (D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s)) : Sub D (ext G A) ;
  p-pair (D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s))
    : Id (Sub D G) (o D (ext G A) G (p G A) (pair D G A s a)) s ;
  -- q at a pair is the element, over the path A[p][pair s a] = A[s]
  -- (subT-o, then p-pair: Der.wkp)
  q-pair (D G : Ctx) (A : Ty G) (s : Sub D G) (a : El D (subT D G A s))
    : Id (El D (subT D G A s))
         (subst (Ty D) (\ X -> El D X) (subT D (ext G A) (subT (ext G A) G A (p G A)) (pair D G A s a)) (subT D G A s)
            (trans (Ty D) (subT D (ext G A) (subT (ext G A) G A (p G A)) (pair D G A s a)) (subT D G A (o D (ext G A) G (p G A) (pair D G A s a))) (subT D G A s)
               (sym (Ty D) (subT D G A (o D (ext G A) G (p G A) (pair D G A s a))) (subT D (ext G A) (subT (ext G A) G A (p G A)) (pair D G A s a))
                    (subT-o D (ext G A) G A (p G A) (pair D G A s a)))
               (ap (Sub D G) (Ty D) (\ t -> subT D G A t) (o D (ext G A) G (p G A) (pair D G A s a)) s (p-pair D G A s a)))
            (subt D (ext G A) (subT (ext G A) G A (p G A)) (q G A) (pair D G A s a)))
         a ;
  -- a map into G.A is the pair of its parts
  pair-eta (D G : Ctx) (A : Ty G) (sg : Sub D (ext G A))
    : Id (Sub D (ext G A))
         (pair D G A (o D (ext G A) G (p G A) sg)
            (subst (Ty D) (\ X -> El D X) (subT D (ext G A) (subT (ext G A) G A (p G A)) sg) (subT D G A (o D (ext G A) G (p G A) sg))
               (sym (Ty D) (subT D G A (o D (ext G A) G (p G A) sg)) (subT D (ext G A) (subT (ext G A) G A (p G A)) sg) (subT-o D (ext G A) G A (p G A) sg))
               (subt D (ext G A) (subT (ext G A) G A (p G A)) (q G A) sg)))
         sg ;
} ;

------------------------------------------------------------------------
-- S2.1: the small category C and its representables

record Site (C : PCwF) {
  Ob : U l ;
  Hom (y x : Ob) : U l ;
  idH (x : Ob) : Hom x x ;
  compH (z y x : Ob) (f : Hom y x) (g : Hom z y) : Hom z x ;
  yo (x : Ob) : C.Ctx ;
  yoH (y x : Ob) (f : Hom y x) : C.Sub (yo y) (yo x) ;
  yoH-id (x : Ob) : Id (C.Sub (yo x) (yo x)) (yoH x x (idH x)) (C.id (yo x)) ;
  yoH-o (z y x : Ob) (f : Hom y x) (g : Hom z y)
    : Id (C.Sub (yo z) (yo x)) (yoH z x (compH z y x f g)) (C.o (yo z) (yo y) (yo x) (yoH y x f) (yoH z y g)) ;
  -- Yoneda for representables: the points of yo x at y are the maps y -> x
  yoH-eq (y x : Ob) : isEquiv (Hom y x) (C.Sub (yo y) (yo x)) (yoH y x) ;
} ;

------------------------------------------------------------------------
-- derived: transports, points, fibres, maps of types on elements

module Der (C : PCwF) {
  -- the weakening of B along p, at a pair, is B along s
  wkp (D G : C.Ctx) (A B : C.Ty G) (s : C.Sub D G) (a : C.El D (C.subT D G A s))
    : Id (C.Ty D) (C.subT D (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) (C.pair D G A s a)) (C.subT D G B s) =
    trans (C.Ty D) (C.subT D (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) (C.pair D G A s a))
      (C.subT D G B (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) (C.subT D G B s)
      (sym (C.Ty D) (C.subT D G B (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)))
                    (C.subT D (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) (C.pair D G A s a))
                    (C.subT-o D (C.ext G A) G B (C.p G A) (C.pair D G A s a)))
      (ap (C.Sub D G) (C.Ty D) (\ t -> C.subT D G B t) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)) s (C.p-pair D G A s a)) ;

  -- transport of elements along a path of types
  trE (G : C.Ctx) (A B : C.Ty G) (P : Id (C.Ty G) A B) (a : C.El G A) : C.El G B = subst (C.Ty G) (\ X -> C.El G X) A B P a ;

  -- a map of types A -> B over G is an element of B weakened over G.A;
  -- its action on elements over D along s
  Map (G : C.Ctx) (A B : C.Ty G) : U l = C.El (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) ;

  postAt (D G : C.Ctx) (A B : C.Ty G) (m : Map G A B) (s : C.Sub D G) (a : C.El D (C.subT D G A s)) : C.El D (C.subT D G B s) =
    trE D (C.subT D (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) (C.pair D G A s a)) (C.subT D G B s) (wkp D G A B s a)
      (C.subt D (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) m (C.pair D G A s a)) ;

  -- restriction of elements along a substitution
  restr (T G : C.Ctx) (s : C.Sub T G) (Q : C.Ty G) (a : C.El G Q) : C.El T (C.subT T G Q s) = C.subt T G Q a s ;

  -- the lift of s : D -> G to D.A[s] -> G.A
  lift (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) : C.Sub (C.ext D (C.subT D G A s)) (C.ext G A) =
    C.pair (C.ext D (C.subT D G A s)) G A (C.o (C.ext D (C.subT D G A s)) D G s (C.p D (C.subT D G A s)))
      (trE (C.ext D (C.subT D G A s)) (C.subT (C.ext D (C.subT D G A s)) D (C.subT D G A s) (C.p D (C.subT D G A s)))
         (C.subT (C.ext D (C.subT D G A s)) G A (C.o (C.ext D (C.subT D G A s)) D G s (C.p D (C.subT D G A s))))
         (sym (C.Ty (C.ext D (C.subT D G A s))) (C.subT (C.ext D (C.subT D G A s)) G A (C.o (C.ext D (C.subT D G A s)) D G s (C.p D (C.subT D G A s))))
              (C.subT (C.ext D (C.subT D G A s)) D (C.subT D G A s) (C.p D (C.subT D G A s)))
              (C.subT-o (C.ext D (C.subT D G A s)) D G A s (C.p D (C.subT D G A s))))
         (C.q D (C.subT D G A s))) ;

  -- maps into G.A are pairs: Sub D (G.A) = Sigma (s : Sub D G) El D A[s]
  extFwd (D G : C.Ctx) (A : C.Ty G) (sg : C.Sub D (C.ext G A)) : (s : C.Sub D G) * C.El D (C.subT D G A s) =
    (C.o D (C.ext G A) G (C.p G A) sg,
     trE D (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) sg) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) sg))
       (sym (C.Ty D) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) sg)) (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) sg) (C.subT-o D (C.ext G A) G A (C.p G A) sg))
       (C.subt D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A) sg)) ;

  extBwd (D G : C.Ctx) (A : C.Ty G) (w : (s : C.Sub D G) * C.El D (C.subT D G A s)) : C.Sub D (C.ext G A) = C.pair D G A w.1 w.2 ;

  -- transport along two paths of types, composed
  trE-trans (D : C.Ctx) (X Y Z : C.Ty D) (P : Id (C.Ty D) X Y) (Q : Id (C.Ty D) Y Z) (z : C.El D X)
    : Id (C.El D Z) (trE D Y Z Q (trE D X Y P z)) (trE D X Z (trans (C.Ty D) X Y Z P Q) z) =
    idJ (C.Ty D) Y (\ Z2 Q2 -> Id (C.El D Z2) (trE D Y Z2 Q2 (trE D X Y P z)) (trE D X Z2 (trans (C.Ty D) X Y Z2 P Q2) z))
      (refl (trE D X Y P z)) Z Q ;

  extEquiv (D G : C.Ctx) (A : C.Ty G) : Equiv (C.Sub D (C.ext G A)) ((s : C.Sub D G) * C.El D (C.subT D G A s)) =
    (extFwd D G A,
     qinv (C.Sub D (C.ext G A)) ((s : C.Sub D G) * C.El D (C.subT D G A s)) (extFwd D G A) (extBwd D G A)
       (\ w -> Sigma-path (C.Sub D G) (\ s -> C.El D (C.subT D G A s)) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2)) w.1
           (extFwd D G A (C.pair D G A w.1 w.2)).2 w.2 (C.p-pair D G A w.1 w.2)
           (trans (C.El D (C.subT D G A w.1))
              (subst (C.Sub D G) (\ s -> C.El D (C.subT D G A s)) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2)) w.1 (C.p-pair D G A w.1 w.2) (extFwd D G A (C.pair D G A w.1 w.2)).2)
              (trE D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2))) (C.subT D G A w.1)
                 (ap (C.Sub D G) (C.Ty D) (\ t -> C.subT D G A t) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2)) w.1 (C.p-pair D G A w.1 w.2))
                 (extFwd D G A (C.pair D G A w.1 w.2)).2)
              w.2
              (subst-ap (C.Sub D G) (C.Ty D) (\ t -> C.subT D G A t) (\ X -> C.El D X) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2)) w.1 (C.p-pair D G A w.1 w.2)
                 (extFwd D G A (C.pair D G A w.1 w.2)).2)
              (trans (C.El D (C.subT D G A w.1)) _ _ w.2
                 (trE-trans D (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.pair D G A w.1 w.2)) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2))) (C.subT D G A w.1)
                    (sym (C.Ty D) (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2))) (C.subT D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.pair D G A w.1 w.2)) (C.subT-o D (C.ext G A) G A (C.p G A) (C.pair D G A w.1 w.2)))
                    (ap (C.Sub D G) (C.Ty D) (\ t -> C.subT D G A t) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A w.1 w.2)) w.1 (C.p-pair D G A w.1 w.2))
                    (C.subt D (C.ext G A) (C.subT (C.ext G A) G A (C.p G A)) (C.q G A) (C.pair D G A w.1 w.2)))
                 (C.q-pair D G A w.1 w.2))))
       (\ sg -> C.pair-eta D G A sg)) ;

  module Pts (S : Site[C]) {
    -- points of G at x, and the fibre of A at a point (by definition)
    pts (G : C.Ctx) (x : S.Ob) : U l = C.Sub (S.yo x) G ;
    fib (G : C.Ctx) (A : C.Ty G) (x : S.Ob) (g : pts G x) : U l = C.El (S.yo x) (C.subT (S.yo x) G A g) ;

    -- a context map acts on points; it is a levelwise equivalence when
    -- this action is an equivalence of Unit types at every x
    onPts (T G : C.Ctx) (s : C.Sub T G) (x : S.Ob) (g : pts T x) : pts G x = C.o (S.yo x) T G s g ;
    LEqC (T G : C.Ctx) (s : C.Sub T G) : U k = (x : S.Ob) -> isEquiv (pts T x) (pts G x) (onPts T G s x) ;

    -- a map of types acts on fibres; levelwise equivalence of maps of types
    onFib (G : C.Ctx) (A B : C.Ty G) (m : Map G A B) (x : S.Ob) (g : pts G x) (a : fib G A x g) : fib G B x g =
      postAt (S.yo x) G A B m g a ;
    LEqT (G : C.Ctx) (A B : C.Ty G) (m : Map G A B) : U k =
      (x : S.Ob) (g : pts G x) -> isEquiv (fib G A x g) (fib G B x g) (onFib G A B m x g) ;
  } ;
} ;

------------------------------------------------------------------------
-- S2.1: Pi, with its universal property and its stability

record PiS (C : PCwF) {
  Pi (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : C.Ty G ;
  -- El(G , Pi A B) = El(G.A , B), an iso of Unit types
  lam (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B) : C.El G (Pi G A B) ;
  app (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f : C.El G (Pi G A B)) : C.El (C.ext G A) B ;
  app-lam (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (b : C.El (C.ext G A) B) : Id (C.El (C.ext G A) B) (app G A B (lam G A B b)) b ;
  lam-app (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f : C.El G (Pi G A B)) : Id (C.El G (Pi G A B)) (lam G A B (app G A B f)) f ;
  -- stability: (Pi A B)[s] = Pi A[s] B[lift s]
  Pi-nat (D G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (s : C.Sub D G)
    : Id (C.Ty D) (C.subT D G (Pi G A B) s) (Pi D (C.subT D G A s) (C.subT (C.ext D (C.subT D G A s)) (C.ext G A) B (Der[C].lift D G A s))) ;
  -- lam is stable: lam b along s is a transport of lam of b along lift s
  -- (a TE: some path of types, then equal elements)
  lam-nat (D G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (s : C.Sub D G) (b : C.El (C.ext G A) B)
    : (P : Id (C.Ty D) (C.subT D G (Pi G A B) s) (Pi D (C.subT D G A s) (C.subT (C.ext D (C.subT D G A s)) (C.ext G A) B (Der[C].lift D G A s))))
      * Id (C.El D (Pi D (C.subT D G A s) (C.subT (C.ext D (C.subT D G A s)) (C.ext G A) B (Der[C].lift D G A s))))
           (Der[C].trE D (C.subT D G (Pi G A B) s) (Pi D (C.subT D G A s) (C.subT (C.ext D (C.subT D G A s)) (C.ext G A) B (Der[C].lift D G A s))) P
              (C.subt D G (Pi G A B) (lam G A B b) s))
           (lam D (C.subT D G A s) (C.subT (C.ext D (C.subT D G A s)) (C.ext G A) B (Der[C].lift D G A s))
              (C.subt (C.ext D (C.subT D G A s)) (C.ext G A) B b (Der[C].lift D G A s))) ;
} ;

------------------------------------------------------------------------
-- S2.2-S2.4, S2.6: fibrancy, internal equivalences, D

record DS (C : PCwF) (S : Site[C]) {
  -- S2.2: fibrant types, stable under substitution
  Fib (G : C.Ctx) (A : C.Ty G) : U l ;
  Fib-sub (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) : Fib G A -> Fib D (C.subT D G A s) ;

  -- S2.2: internal equivalences (El(1 , is-equiv)) of context maps and of
  -- maps of types, as abstract structures
  IsEqC (T G : C.Ctx) (s : C.Sub T G) : U l ;
  IsEqT (G : C.Ctx) (A B : C.Ty G) (m : Der[C].Map G A B) : U l ;

  -- S2.2: precomposition with an internal equivalence of (fibrant)
  -- contexts is an equivalence on elements of a fibrant type (Rijke
  -- 13.4.1, through PSh(C)(1 , -))
  restr-eq (T G : C.Ctx) (s : C.Sub T G) (Q : C.Ty G) : IsEqC T G s -> Fib G Q
    -> isEquiv (C.El G Q) (C.El T (C.subT T G Q s)) (Der[C].restr T G s Q) ;
  -- S2.2: an internal equivalence of types acts on elements as an
  -- equivalence (PSh(C)(D , -) preserves equivalences)
  post-eq (D G : C.Ctx) (A B : C.Ty G) (m : Der[C].Map G A B) (s : C.Sub D G) : IsEqT G A B m
    -> isEquiv (C.El D (C.subT D G A s)) (C.El D (C.subT D G B s)) (Der[C].postAt D G A B m s) ;

  -- S2.3: D on contexts and substitutions, the unit on contexts
  DC (G : C.Ctx) : C.Ctx ;
  DSb (T G : C.Ctx) (s : C.Sub T G) : C.Sub (DC T) (DC G) ;
  tauC (G : C.Ctx) : C.Sub G (DC G) ;
  tau-nat (T G : C.Ctx) (s : C.Sub T G)
    : Id (C.Sub T (DC G)) (C.o T (DC T) (DC G) (DSb T G s) (tauC T)) (C.o T G (DC G) (tauC G) s) ;

  -- S2.3: D on types (the family action D~) and on elements
  DT (G : C.Ctx) (Q : C.Ty G) : C.Ty (DC G) ;
  De (G : C.Ctx) (Q : C.Ty G) (a : C.El G Q) : C.El (DC G) (DT G Q) ;
  DT-sub (T G : C.Ctx) (Q : C.Ty G) (s : C.Sub T G)
    : Id (C.Ty (DC T)) (DT T (C.subT T G Q s)) (C.subT (DC T) (DC G) (DT G Q) (DSb T G s)) ;
  -- the left square of Lemma 67's diagram: De commutes with restriction
  De-sub (T G : C.Ctx) (Q : C.Ty G) (s : C.Sub T G) (a : C.El G Q)
    : Id (C.El (DC T) (C.subT (DC T) (DC G) (DT G Q) (DSb T G s)))
         (Der[C].trE (DC T) (DT T (C.subT T G Q s)) (C.subT (DC T) (DC G) (DT G Q) (DSb T G s)) (DT-sub T G Q s)
            (De T (C.subT T G Q s) (C.subt T G Q a s)))
         (C.subt (DC T) (DC G) (DT G Q) (De G Q a) (DSb T G s)) ;

  -- S2.3: the unit on types, tau_Q : Q -> (D~Q)[tau], and D-modality
  tauT (G : C.Ctx) (Q : C.Ty G) : Der[C].Map G Q (C.subT G (DC G) (DT G Q) (tauC G)) ;
  -- the horizontal composite of Lemma 67's diagram (De, then restriction
  -- along tau) is the action of tau_Q on elements
  hc-tau (G : C.Ctx) (Q : C.Ty G) (a : C.El G Q)
    : Id (C.El G (C.subT G (DC G) (DT G Q) (tauC G)))
         (Der[C].restr G (DC G) (tauC G) (DT G Q) (De G Q a))
         (Der[C].trE G (C.subT G G (C.subT G (DC G) (DT G Q) (tauC G)) (C.id G)) (C.subT G (DC G) (DT G Q) (tauC G))
            (C.subT-id G (C.subT G (DC G) (DT G Q) (tauC G)))
            (Der[C].postAt G G Q (C.subT G (DC G) (DT G Q) (tauC G)) (tauT G Q) (C.id G)
               (Der[C].trE G Q (C.subT G G Q (C.id G)) (sym (C.Ty G) (C.subT G G Q (C.id G)) Q (C.subT-id G Q)) a))) ;
  Modal (G : C.Ctx) (Q : C.Ty G) : U l = IsEqT G Q (C.subT G (DC G) (DT G Q) (tauC G)) (tauT G Q) ;
  Modal-sub (T G : C.Ctx) (Q : C.Ty G) (s : C.Sub T G) : Modal G Q -> Modal T (C.subT T G Q s) ;
  DT-fib (G : C.Ctx) (Q : C.Ty G) : Fib G Q -> Fib (DC G) (DT G Q) ;

  -- S2.4 (Lemma 12 corrected, Prop 13): D sends a levelwise equivalence
  -- (of contexts, all levelwise fibrant) to an internal equivalence
  D-eq (T G : C.Ctx) (s : C.Sub T G) : Der[C].Pts[S].LEqC T G s -> IsEqC (DC T) (DC G) (DSb T G s) ;

  -- S2.6 (replaces the former premise Prop 17, now proved in
  -- duality-levelwise/Prop17.seg): a map of types with a two-sided
  -- inverse is an internal equivalence.  Composition of maps of types is
  -- n . m = postAt (G.A) n p_A m, the identity is q.
  isoT (G : C.Ctx) (A B : C.Ty G) (m : Der[C].Map G A B) (n : Der[C].Map G B A)
    (nm : Id (Der[C].Map G A A) (Der[C].postAt (C.ext G A) G B A n (C.p G A) m) (C.q G A))
    (mn : Id (Der[C].Map G B B) (Der[C].postAt (C.ext G B) G A B m (C.p G B) n) (C.q G B))
    : IsEqT G A B m ;
} ;

------------------------------------------------------------------------
-- Definition 70: a local homotopy representation of A : Ty G.  At every
-- point g of G at x: an object x.g, p_g : x.g -> x, q_g in the fibre of A
-- at g p_g, such that <p_g , q_g> : yo (x.g) -> yo x . A[g] is a
-- levelwise equivalence.  (Remark 71, stability under substitution, is a
-- construction on this record, not a premise.)

record LocRep (C : PCwF) (S : Site[C]) (G : C.Ctx) (A : C.Ty G) {
  xg (x : S.Ob) (g : C.Sub (S.yo x) G) : S.Ob ;
  pg (x : S.Ob) (g : C.Sub (S.yo x) G) : S.Hom (xg x g) x ;
  qg (x : S.Ob) (g : C.Sub (S.yo x) G)
    : C.El (S.yo (xg x g)) (C.subT (S.yo (xg x g)) G A (C.o (S.yo (xg x g)) (S.yo x) G g (S.yoH (xg x g) x (pg x g)))) ;
  -- the representing map <p_g , q_g>
  pq (x : S.Ob) (g : C.Sub (S.yo x) G) : C.Sub (S.yo (xg x g)) (C.ext (S.yo x) (C.subT (S.yo x) G A g)) =
    C.pair (S.yo (xg x g)) (S.yo x) (C.subT (S.yo x) G A g) (S.yoH (xg x g) x (pg x g))
      (Der[C].trE (S.yo (xg x g)) (C.subT (S.yo (xg x g)) G A (C.o (S.yo (xg x g)) (S.yo x) G g (S.yoH (xg x g) x (pg x g))))
         (C.subT (S.yo (xg x g)) (S.yo x) (C.subT (S.yo x) G A g) (S.yoH (xg x g) x (pg x g)))
         (C.subT-o (S.yo (xg x g)) (S.yo x) G A g (S.yoH (xg x g) x (pg x g))) (qg x g)) ;
  lw (x : S.Ob) (g : C.Sub (S.yo x) G) : Der[C].Pts[S].LEqC (S.yo (xg x g)) (C.ext (S.yo x) (C.subT (S.yo x) G A g)) (pq x g) ;
} ;

------------------------------------------------------------------------
-- S2.8: fibrant and D-modal types are closed under Pi (paper §2.2.2, §5:
-- the inner model of DT-modal types has Pi)

record ModPi (C : PCwF) (S : Site[C]) (PI : PiS[C]) (Dd : DS[C, S]) {
  Fib-Pi (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : Dd.Fib (C.ext G A) B -> Dd.Fib G (PI.Pi G A B) ;
  Modal-Pi (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : Dd.Fib G A -> Dd.Modal (C.ext G A) B -> Dd.Modal G (PI.Pi G A B) ;
} ;
