      -- (1) Remark 60's square, at s
      remark60 : Id (C.El Dp (C.subT Dp GA P L.lpt)) (L.ev72 u) rhs =
        TM.teAny Dp (C.subT Dp GA P L.lpt) (C.subT Dp GA P L.lpt) (L.ev72 u) rhs chain (refl (C.subT Dp GA P L.lpt)) ;
    } ;

    -- (2) if m_(x.g , lpt) o S(p_g) is an equivalence, so is (lambda m)_(x , g)
    remark60-eq (eK : isEquiv (C.El Lx (C.subT Lx G Sf g)) (C.El Dp (C.subT Dp GA P L.lpt)) (\ s -> Pt[s].rhs))
