        (Equivalences[k].compose (C.El Lx (C.subT Lx G Sf g)) (C.El Dp (C.subT Dp GA P L.lpt)) (T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g)
           (\ s -> Pt[s].rhs, eK)
           (Lemma66[k].invEquiv (T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g) (C.El Dp (C.subT Dp GA P L.lpt)) L.ev72 L.lemma72))
        (\ s -> Pt[s].u)
        (\ s -> trans (T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g) (Pt[s].u) (L.lemma72.sec (L.ev72 (Pt[s].u))) (L.lemma72.sec (Pt[s].rhs))
           (sym (T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g) (L.lemma72.sec (L.ev72 (Pt[s].u))) (Pt[s].u)
              (sec-ret (T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g) (C.El Dp (C.subT Dp GA P L.lpt)) L.ev72 L.lemma72 (Pt[s].u)))
           (ap (C.El Dp (C.subT Dp GA P L.lpt)) (T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g) L.lemma72.sec (L.ev72 (Pt[s].u)) (Pt[s].rhs) (Pt[s].remark60))) ;
