-- Remark60.seg (DUALITY.md P2.5, jonas.pdf Remark 60).  For S over G, A
-- over G with a local homotopy representation, P over G.A fibrant and
-- D-modal, and m : S[p_A] -> P over G.A, the transpose lambda m : S ->
-- Pi_A P over G.  At a point g of G at x:
--   (1) remark60: ev o (lambda m)_(x , g) = e o m_(x.g , lpt') o S(p_g)
--       (a path of functions on the fibre of S at g), where ev is Lemma 72's
--       evaluation for the presentation A[p_S][sigma] of A[g] (sigma =
--       (g , s)), and e transports along lpt' = lpt;
--   (2) remark60-eq: if m_(x.g , lpt) o S(p_g) is an equivalence, so is
--       (lambda m)_(x , g)  (from (1), Lemma 72 and 2-out-of-3).
--
-- Informal text.  lambda m = lam of m along the exchange
-- ex : G.S.A[p_S] -> G.A.S[p_A] (the pair of lift p_S and q_S weakened).
-- At s in S(x , g), sigma = (g , s); by lam-nat, (lambda m)[sigma] is a
-- transport of lam (body[lift sigma]), so its evaluation is body along
-- lift sigma, then along <p , q> (moved to the domain A[p_S][sigma]):
-- m along tau1 = ex o lift sigma o <p , q>'.  And m_(x.g , lpt) (S(p_g) s)
-- is m along tau2 = (lpt , s[p_g]).  tau1 = tau2 by subExt (twice: into
-- G.A.S[p_A], then into G.A), their parts being computed by pO, qvO, qvPair,
-- p-pair and lpt-ext.

level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module R60 (C : T2[l, k].PCwF) (S : T2[l, k].Site[C]) (PI : T2[l, k].PiS[C]) (Dd : T2[l, k].DS[C, S])
  (G : C.Ctx) (A : C.Ty G) (rep : T2[l, k].LocRep[C, S, G, A])
  (P : C.Ty (C.ext G A)) (fP : Dd.Fib (C.ext G A) P) (mP : Dd.Modal (C.ext G A) P)
  (Sf : C.Ty G) (m : T2[l, k].Der[C].Map (C.ext G A) (C.subT (C.ext G A) G Sf (C.p G A)) P) {
  module DR = T2[l, k].Der[C] ;
  module TM = TE[l, k].TEm[C] ;

  --------------------------------------------------------------------
  -- the two extensions and the exchange

  GA : C.Ctx = C.ext G A ;
  pA : C.Sub GA G = C.p G A ;
  SA : C.Ty GA = C.subT GA G Sf pA ;
  GAS : C.Ctx = C.ext GA SA ;
  pSA : C.Sub GAS GA = C.p GA SA ;
  GS : C.Ctx = C.ext G Sf ;
  pS : C.Sub GS G = C.p G Sf ;
  AS : C.Ty GS = C.subT GS G A pS ;
  GSA : C.Ctx = C.ext GS AS ;
  pAS : C.Sub GSA GS = C.p GS AS ;

  -- lift p_S is a pair (Der.lift); its first part
  alS : C.El GSA (C.subT GSA G A (C.o GSA GS G pS pAS)) =
    DR.trE GSA (C.subT GSA GS AS pAS) (C.subT GSA G A (C.o GSA GS G pS pAS))
      (sym (C.Ty GSA) (C.subT GSA G A (C.o GSA GS G pS pAS)) (C.subT GSA GS AS pAS) (C.subT-o GSA GS G A pS pAS)) (C.q GS AS) ;
  lS : C.Sub GSA GA = DR.lift GS G A pS ;
  lS-p : Id (C.Sub GSA G) (C.o GSA GA G pA lS) (C.o GSA GS G pS pAS) = C.p-pair GSA G A (C.o GSA GS G pS pAS) alS ;

  -- q_S weakened, as an element of S[p_A] along lift p_S
  wq : C.El GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) = C.subt GSA GS (C.subT GS G Sf pS) (C.q G Sf) pAS ;
  exP : Id (C.Ty GSA) (C.subT GSA GS (C.subT GS G Sf pS) pAS) (C.subT GSA GA SA lS) =
    trans (C.Ty GSA) (C.subT GSA GS (C.subT GS G Sf pS) pAS) (C.subT GSA G Sf (C.o GSA GS G pS pAS)) (C.subT GSA GA SA lS)
      (sym (C.Ty GSA) (C.subT GSA G Sf (C.o GSA GS G pS pAS)) (C.subT GSA GS (C.subT GS G Sf pS) pAS) (C.subT-o GSA GS G Sf pS pAS))
      (trans (C.Ty GSA) (C.subT GSA G Sf (C.o GSA GS G pS pAS)) (C.subT GSA G Sf (C.o GSA GA G pA lS)) (C.subT GSA GA SA lS)
         (ap (C.Sub GSA G) (C.Ty GSA) (\ t -> C.subT GSA G Sf t) (C.o GSA GS G pS pAS) (C.o GSA GA G pA lS)
             (sym (C.Sub GSA G) (C.o GSA GA G pA lS) (C.o GSA GS G pS pAS) lS-p))
         (C.subT-o GSA GA G Sf pA lS)) ;
  exq : C.El GSA (C.subT GSA GA SA lS) = DR.trE GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) (C.subT GSA GA SA lS) exP wq ;

  ex : C.Sub GSA GAS = C.pair GSA GA SA lS exq ;

  --------------------------------------------------------------------
  -- the transpose

  BS : C.Ty GSA = C.subT GSA GA P lS ;

  body : C.El GSA BS =
    DR.trE GSA (C.subT GSA GAS (C.subT GAS GA P pSA) ex) BS (DR.wkp GSA GA SA P lS exq) (C.subt GSA GAS (C.subT GAS GA P pSA) m ex) ;

  lamm : DR.Map G Sf (PI.Pi G A P) =
    DR.trE GS (PI.Pi GS AS BS) (C.subT GS G (PI.Pi G A P) pS)
      (sym (C.Ty GS) (C.subT GS G (PI.Pi G A P) pS) (PI.Pi GS AS BS) (PI.Pi-nat GS G A P pS)) (PI.lam GS AS BS body) ;

  --------------------------------------------------------------------
  -- evaluations at two presentations of the domain agree (J on the type
  -- path, on the map path, on the codomain path; then teAny)

  evCmpB (D D' : C.Ctx) (X1 : C.Ty D) (B1 B2 : C.Ty (C.ext D X1)) (c : Id (C.Ty (C.ext D X1)) B1 B2)
    (F1 : C.El D (PI.Pi D X1 B1)) (F2 : C.El D (PI.Pi D X1 B2)) (h : TM.TE D (PI.Pi D X1 B1) (PI.Pi D X1 B2) F1 F2) (w : C.Sub D' (C.ext D X1))
    : TM.TE D' (C.subT D' (C.ext D X1) B1 w) (C.subT D' (C.ext D X1) B2 w)
        (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F1) w) (C.subt D' (C.ext D X1) B2 (PI.app D X1 B2 F2) w) =
    idJ (C.Ty (C.ext D X1)) B1
      (\ B2' c' -> (F2' : C.El D (PI.Pi D X1 B2')) -> TM.TE D (PI.Pi D X1 B1) (PI.Pi D X1 B2') F1 F2'
          -> TM.TE D' (C.subT D' (C.ext D X1) B1 w) (C.subT D' (C.ext D X1) B2' w)
               (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F1) w) (C.subt D' (C.ext D X1) B2' (PI.app D X1 B2' F2') w))
      (\ F2' h' -> TM.teR D' (C.subT D' (C.ext D X1) B1 w) (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F1) w) (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F2') w)
          (ap (C.El D (PI.Pi D X1 B1)) (C.El D' (C.subT D' (C.ext D X1) B1 w)) (\ F -> C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F) w) F1 F2'
              (TM.teAny D (PI.Pi D X1 B1) (PI.Pi D X1 B1) F1 F2' h' (refl (PI.Pi D X1 B1)))))
      B2 c F2 h ;

  evCompare (D D' H : C.Ctx) (Q : C.Ty H) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2)
    (f1 : C.Sub (C.ext D X1) H) (f2 : C.Sub (C.ext D X2) H) (Pf : Id (C.Sub (C.ext D X2) H) (TM.trDom D H X1 X2 PA f1) f2)
    (B1 : C.Ty (C.ext D X1)) (QB1 : Id (C.Ty (C.ext D X1)) B1 (C.subT (C.ext D X1) H Q f1))
    (B2 : C.Ty (C.ext D X2)) (QB2 : Id (C.Ty (C.ext D X2)) B2 (C.subT (C.ext D X2) H Q f2))
    (F1 : C.El D (PI.Pi D X1 B1)) (F2 : C.El D (PI.Pi D X2 B2)) (h : TM.TE D (PI.Pi D X1 B1) (PI.Pi D X2 B2) F1 F2) (w : C.Sub D' (C.ext D X1))
    : TM.TE D' (C.subT D' (C.ext D X1) B1 w) (C.subT D' (C.ext D X2) B2 (TM.trSub D' D X1 X2 PA w))
        (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F1) w) (C.subt D' (C.ext D X2) B2 (PI.app D X2 B2 F2) (TM.trSub D' D X1 X2 PA w)) =
    idJ (C.Ty D) X1
      (\ X2' PA' -> (f2' : C.Sub (C.ext D X2') H) -> Id (C.Sub (C.ext D X2') H) (TM.trDom D H X1 X2' PA' f1) f2'
          -> (B2' : C.Ty (C.ext D X2')) -> Id (C.Ty (C.ext D X2')) B2' (C.subT (C.ext D X2') H Q f2')
          -> (F2' : C.El D (PI.Pi D X2' B2')) -> TM.TE D (PI.Pi D X1 B1) (PI.Pi D X2' B2') F1 F2'
          -> TM.TE D' (C.subT D' (C.ext D X1) B1 w) (C.subT D' (C.ext D X2') B2' (TM.trSub D' D X1 X2' PA' w))
               (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F1) w) (C.subt D' (C.ext D X2') B2' (PI.app D X2' B2' F2') (TM.trSub D' D X1 X2' PA' w)))
      (\ f2' Pf' ->
         idJ (C.Sub (C.ext D X1) H) f1
           (\ f3 Pf3 -> (B2' : C.Ty (C.ext D X1)) -> Id (C.Ty (C.ext D X1)) B2' (C.subT (C.ext D X1) H Q f3)
               -> (F2' : C.El D (PI.Pi D X1 B2')) -> TM.TE D (PI.Pi D X1 B1) (PI.Pi D X1 B2') F1 F2'
               -> TM.TE D' (C.subT D' (C.ext D X1) B1 w) (C.subT D' (C.ext D X1) B2' w)
                    (C.subt D' (C.ext D X1) B1 (PI.app D X1 B1 F1) w) (C.subt D' (C.ext D X1) B2' (PI.app D X1 B2' F2') w))
           (\ B2' QB2' F2' h' -> evCmpB D D' X1 B1 B2'
               (trans (C.Ty (C.ext D X1)) B1 (C.subT (C.ext D X1) H Q f1) B2' QB1 (sym (C.Ty (C.ext D X1)) B2' (C.subT (C.ext D X1) H Q f1) QB2'))
               F1 F2' h' w)
           f2' Pf')
      X2 PA f2 Pf B2 QB2 F2 h ;

  --------------------------------------------------------------------
  -- at a point g of G at x

  module At (x : S.Ob) (g : C.Sub (S.yo x) G) {
    module L = Lemma72[l, k].L72[C, S, PI, Dd, G, A, rep, P, fP, mP, x, g] ;
    Lx : C.Ctx = S.yo x ;
    Dp : C.Ctx = L.Dp ;
    PSA : C.Ty GAS = C.subT GAS GA P pSA ;

    module Pt (s : C.El Lx (C.subT Lx G Sf g)) {
      sg : C.Sub Lx GS = C.pair Lx G Sf g s ;
      sg-p : Id (C.Sub Lx G) (C.o Lx GS G pS sg) g = C.p-pair Lx G Sf g s ;
      ASs : C.Ty Lx = C.subT Lx GS AS sg ;
      Es : C.Ctx = C.ext Lx ASs ;
      ps : C.Sub Es Lx = C.p Lx ASs ;
      als : C.El Es (C.subT Es GS AS (C.o Es Lx GS sg ps)) =
        DR.trE Es (C.subT Es Lx ASs ps) (C.subT Es GS AS (C.o Es Lx GS sg ps))
          (sym (C.Ty Es) (C.subT Es GS AS (C.o Es Lx GS sg ps)) (C.subT Es Lx ASs ps) (C.subT-o Es Lx GS AS sg ps)) (C.q Lx ASs) ;
      ls : C.Sub Es GSA = DR.lift Lx GS AS sg ;
      ls-p : Id (C.Sub Es GS) (C.o Es GSA GS pAS ls) (C.o Es Lx GS sg ps) = C.p-pair Es GS AS (C.o Es Lx GS sg ps) als ;
      BSs : C.Ty Es = C.subT Es GSA BS ls ;

      -- the two presentations of the domain: A[g] = A[p_S][sigma]
      PA : Id (C.Ty Lx) L.Ag ASs =
        trans (C.Ty Lx) L.Ag (C.subT Lx G A (C.o Lx GS G pS sg)) ASs
          (ap (C.Sub Lx G) (C.Ty Lx) (\ t -> C.subT Lx G A t) g (C.o Lx GS G pS sg) (sym (C.Sub Lx G) (C.o Lx GS G pS sg) g sg-p))
          (C.subT-o Lx GS G A pS sg) ;
      w2 : C.Sub Dp Es = TM.trSub Dp Lx L.Ag ASs PA L.pq ;
      rho : C.Sub Dp GSA = C.o Dp Es GSA ls w2 ;

      -- the evaluated element, and its two forms
      u : T2[l, k].Der[C].Pts[S].fib G (PI.Pi G A P) x g = DR.Pts[S].onFib G Sf (PI.Pi G A P) lamm x g s ;
      F1 : C.El Lx (PI.Pi Lx L.Ag L.Pg) = L.t1 u ;
      F2 : C.El Lx (PI.Pi Lx ASs BSs) = PI.lam Lx ASs BSs (C.subt Es GSA BS body ls) ;

      hF : TM.TE Lx (PI.Pi Lx L.Ag L.Pg) (PI.Pi Lx ASs BSs) F1 F2 =
        TM.teT Lx (PI.Pi Lx L.Ag L.Pg) (C.subT Lx G (PI.Pi G A P) g) (PI.Pi Lx ASs BSs) F1 u F2
          (TM.teS Lx (C.subT Lx G (PI.Pi G A P) g) (PI.Pi Lx L.Ag L.Pg) u F1 (TM.teTr Lx (C.subT Lx G (PI.Pi G A P) g) (PI.Pi Lx L.Ag L.Pg) L.piN u))
        (TM.teT Lx (C.subT Lx G (PI.Pi G A P) g) (C.subT Lx GS (C.subT GS G (PI.Pi G A P) pS) sg) (PI.Pi Lx ASs BSs) u (C.subt Lx GS (C.subT GS G (PI.Pi G A P) pS) lamm sg) F2
          (TM.teS Lx (C.subT Lx GS (C.subT GS G (PI.Pi G A P) pS) sg) (C.subT Lx G (PI.Pi G A P) g) (C.subt Lx GS (C.subT GS G (PI.Pi G A P) pS) lamm sg) u
             (TM.teTr Lx (C.subT Lx GS (C.subT GS G (PI.Pi G A P) pS) sg) (C.subT Lx G (PI.Pi G A P) g) (DR.wkp Lx G Sf (PI.Pi G A P) g s) (C.subt Lx GS (C.subT GS G (PI.Pi G A P) pS) lamm sg)))
        (TM.teT Lx (C.subT Lx GS (C.subT GS G (PI.Pi G A P) pS) sg) (C.subT Lx GS (PI.Pi GS AS BS) sg) (PI.Pi Lx ASs BSs)
            (C.subt Lx GS (C.subT GS G (PI.Pi G A P) pS) lamm sg) (C.subt Lx GS (PI.Pi GS AS BS) (PI.lam GS AS BS body) sg) F2
          (TM.teSub Lx GS sg (C.subT GS G (PI.Pi G A P) pS) (PI.Pi GS AS BS) lamm (PI.lam GS AS BS body)
             (TM.teS GS (PI.Pi GS AS BS) (C.subT GS G (PI.Pi G A P) pS) (PI.lam GS AS BS body) lamm
                (TM.teTr GS (PI.Pi GS AS BS) (C.subT GS G (PI.Pi G A P) pS)
                   (sym (C.Ty GS) (C.subT GS G (PI.Pi G A P) pS) (PI.Pi GS AS BS) (PI.Pi-nat GS G A P pS)) (PI.lam GS AS BS body))))
          (PI.lam-nat Lx GS AS BS sg body))) ;

      -- the map of domains: the moved lift g is lift p_S after lift sigma
      lS-ls : C.Sub Es GA = C.o Es GSA GA lS ls ;
      Pf-e : Id (C.Sub Es G) (C.o Es GA G pA (TM.trDom Lx GA L.Ag ASs PA L.lg)) (C.o Es GA G pA lS-ls) =
        trans (C.Sub Es G) (C.o Es GA G pA (TM.trDom Lx GA L.Ag ASs PA L.lg)) (C.o Es Lx G g ps) (C.o Es GA G pA lS-ls)
          (TM.pTrD Lx G A L.Ag ASs PA L.lg g (C.p-pair L.Eg G A L.sl L.al))
          (sym (C.Sub Es G) (C.o Es GA G pA lS-ls) (C.o Es Lx G g ps)
             (trans (C.Sub Es G) (C.o Es GA G pA lS-ls) (C.o Es GSA G (C.o GSA GA G pA lS) ls) (C.o Es Lx G g ps)
                (TM.pO Es GSA G A lS ls)
                (trans (C.Sub Es G) (C.o Es GSA G (C.o GSA GA G pA lS) ls) (C.o Es GSA G (C.o GSA GS G pS pAS) ls) (C.o Es Lx G g ps)
                   (ap (C.Sub GSA G) (C.Sub Es G) (\ t -> C.o Es GSA G t ls) (C.o GSA GA G pA lS) (C.o GSA GS G pS pAS) lS-p)
                   (trans (C.Sub Es G) (C.o Es GSA G (C.o GSA GS G pS pAS) ls) (C.o Es GS G pS (C.o Es GSA GS pAS ls)) (C.o Es Lx G g ps)
                      (C.o-assoc Es GSA GS G pS pAS ls)
                      (trans (C.Sub Es G) (C.o Es GS G pS (C.o Es GSA GS pAS ls)) (C.o Es GS G pS (C.o Es Lx GS sg ps)) (C.o Es Lx G g ps)
                         (ap (C.Sub Es GS) (C.Sub Es G) (\ t -> C.o Es GS G pS t) (C.o Es GSA GS pAS ls) (C.o Es Lx GS sg ps) ls-p)
                         (trans (C.Sub Es G) (C.o Es GS G pS (C.o Es Lx GS sg ps)) (C.o Es Lx G (C.o Lx GS G pS sg) ps) (C.o Es Lx G g ps)
                            (sym (C.Sub Es G) (C.o Es Lx G (C.o Lx GS G pS sg) ps) (C.o Es GS G pS (C.o Es Lx GS sg ps)) (C.o-assoc Es Lx GS G pS sg ps))
                            (ap (C.Sub Lx G) (C.Sub Es G) (\ t -> C.o Es Lx G t ps) (C.o Lx GS G pS sg) g sg-p))))))) ;

      -- q-part of lift sigma, and of lift p_S at a map
      qls : TM.TE Es (C.subT Es GS AS (C.o Es GSA GS pAS ls)) (C.subT Es Lx ASs ps) (TM.qv Es GS AS ls) (C.q Lx ASs) =
        TM.teT Es (C.subT Es GS AS (C.o Es GSA GS pAS ls)) (C.subT Es GS AS (C.o Es Lx GS sg ps)) (C.subT Es Lx ASs ps) (TM.qv Es GS AS ls) als (C.q Lx ASs)
          (TM.qvPair Es GS AS (C.o Es Lx GS sg ps) als)
          (TM.teS Es (C.subT Es Lx ASs ps) (C.subT Es GS AS (C.o Es Lx GS sg ps)) (C.q Lx ASs) als
             (TM.teTr Es (C.subT Es Lx ASs ps) (C.subT Es GS AS (C.o Es Lx GS sg ps))
                (sym (C.Ty Es) (C.subT Es GS AS (C.o Es Lx GS sg ps)) (C.subT Es Lx ASs ps) (C.subT-o Es Lx GS AS sg ps)) (C.q Lx ASs))) ;

      -- q (lift p_S) along a map r is q_{GS,AS} along r, read as the q-part of r
      qlSr (Tc : C.Ctx) (r : C.Sub Tc GSA)
        : TM.TE Tc (C.subT Tc G A (C.o Tc GA G pA (C.o Tc GSA GA lS r))) (C.subT Tc GS AS (C.o Tc GSA GS pAS r))
            (TM.qv Tc G A (C.o Tc GSA GA lS r)) (TM.qv Tc GS AS r) =
        TM.teT Tc (C.subT Tc G A (C.o Tc GA G pA (C.o Tc GSA GA lS r))) (C.subT Tc GSA (C.subT GSA G A (C.o GSA GA G pA lS)) r) (C.subT Tc GS AS (C.o Tc GSA GS pAS r))
            (TM.qv Tc G A (C.o Tc GSA GA lS r)) (C.subt Tc GSA (C.subT GSA G A (C.o GSA GA G pA lS)) (TM.qv GSA G A lS) r) (TM.qv Tc GS AS r)
          (TM.qvO Tc GSA G A lS r)
        (TM.teT Tc (C.subT Tc GSA (C.subT GSA G A (C.o GSA GA G pA lS)) r) (C.subT Tc GSA (C.subT GSA G A (C.o GSA GS G pS pAS)) r) (C.subT Tc GS AS (C.o Tc GSA GS pAS r))
            (C.subt Tc GSA (C.subT GSA G A (C.o GSA GA G pA lS)) (TM.qv GSA G A lS) r) (C.subt Tc GSA (C.subT GSA G A (C.o GSA GS G pS pAS)) alS r) (TM.qv Tc GS AS r)
          (TM.teSub Tc GSA r (C.subT GSA G A (C.o GSA GA G pA lS)) (C.subT GSA G A (C.o GSA GS G pS pAS)) (TM.qv GSA G A lS) alS
             (TM.qvPair GSA G A (C.o GSA GS G pS pAS) alS))
        (TM.teT Tc (C.subT Tc GSA (C.subT GSA G A (C.o GSA GS G pS pAS)) r) (C.subT Tc GSA (C.subT GSA GS AS pAS) r) (C.subT Tc GS AS (C.o Tc GSA GS pAS r))
            (C.subt Tc GSA (C.subT GSA G A (C.o GSA GS G pS pAS)) alS r) (C.subt Tc GSA (C.subT GSA GS AS pAS) (C.q GS AS) r) (TM.qv Tc GS AS r)
          (TM.teSub Tc GSA r (C.subT GSA G A (C.o GSA GS G pS pAS)) (C.subT GSA GS AS pAS) alS (C.q GS AS)
             (TM.teS GSA (C.subT GSA GS AS pAS) (C.subT GSA G A (C.o GSA GS G pS pAS)) (C.q GS AS) alS
                (TM.teTr GSA (C.subT GSA GS AS pAS) (C.subT GSA G A (C.o GSA GS G pS pAS))
                   (sym (C.Ty GSA) (C.subT GSA G A (C.o GSA GS G pS pAS)) (C.subT GSA GS AS pAS) (C.subT-o GSA GS G A pS pAS)) (C.q GS AS))))
          (TM.teTr Tc (C.subT Tc GSA (C.subT GSA GS AS pAS) r) (C.subT Tc GS AS (C.o Tc GSA GS pAS r))
             (sym (C.Ty Tc) (C.subT Tc GS AS (C.o Tc GSA GS pAS r)) (C.subT Tc GSA (C.subT GSA GS AS pAS) r) (C.subT-o Tc GSA GS AS pAS r))
             (C.subt Tc GSA (C.subT GSA GS AS pAS) (C.q GS AS) r)))) ;

      Pf : Id (C.Sub Es GA) (TM.trDom Lx GA L.Ag ASs PA L.lg) lS-ls =
        TM.subExt Es G A (TM.trDom Lx GA L.Ag ASs PA L.lg) lS-ls Pf-e
          (TM.teT Es (C.subT Es G A (C.o Es GA G pA (TM.trDom Lx GA L.Ag ASs PA L.lg))) (C.subT Es Lx ASs ps) (C.subT Es G A (C.o Es GA G pA lS-ls))
              (TM.qv Es G A (TM.trDom Lx GA L.Ag ASs PA L.lg)) (C.q Lx ASs) (TM.qv Es G A lS-ls)
            (TM.qTrD Lx G A L.Ag ASs PA L.lg
               (TM.teT L.Eg (C.subT L.Eg G A (C.o L.Eg GA G pA L.lg)) (C.subT L.Eg G A L.sl) (C.subT L.Eg Lx L.Ag L.pE) (TM.qv L.Eg G A L.lg) L.al (C.q Lx L.Ag)
                  (TM.qvPair L.Eg G A L.sl L.al)
                  (TM.teS L.Eg (C.subT L.Eg Lx L.Ag L.pE) (C.subT L.Eg G A L.sl) (C.q Lx L.Ag) L.al
                     (TM.teTr L.Eg (C.subT L.Eg Lx L.Ag L.pE) (C.subT L.Eg G A L.sl)
                        (sym (C.Ty L.Eg) (C.subT L.Eg G A L.sl) (C.subT L.Eg Lx L.Ag L.pE) (C.subT-o L.Eg Lx G A g L.pE)) (C.q Lx L.Ag)))))
            (TM.teS Es (C.subT Es G A (C.o Es GA G pA lS-ls)) (C.subT Es Lx ASs ps) (TM.qv Es G A lS-ls) (C.q Lx ASs)
               (TM.teT Es (C.subT Es G A (C.o Es GA G pA lS-ls)) (C.subT Es GS AS (C.o Es GSA GS pAS ls)) (C.subT Es Lx ASs ps) (TM.qv Es G A lS-ls) (TM.qv Es GS AS ls) (C.q Lx ASs)
                  (qlSr Es ls) qls))) ;

      -- the evaluation of F2 along the moved <p , q> is m along tau1
      E3 : Id (C.Sub Dp GS) (C.o Dp GSA GS pAS rho) (C.o Dp Lx GS sg L.yp) =
        trans (C.Sub Dp GS) (C.o Dp GSA GS pAS rho) (C.o Dp Es GS (C.o Es GSA GS pAS ls) w2) (C.o Dp Lx GS sg L.yp)
          (sym (C.Sub Dp GS) (C.o Dp Es GS (C.o Es GSA GS pAS ls) w2) (C.o Dp GSA GS pAS rho) (C.o-assoc Dp Es GSA GS pAS ls w2))
          (trans (C.Sub Dp GS) (C.o Dp Es GS (C.o Es GSA GS pAS ls) w2) (C.o Dp Es GS (C.o Es Lx GS sg ps) w2) (C.o Dp Lx GS sg L.yp)
             (ap (C.Sub Es GS) (C.Sub Dp GS) (\ t -> C.o Dp Es GS t w2) (C.o Es GSA GS pAS ls) (C.o Es Lx GS sg ps) ls-p)
             (trans (C.Sub Dp GS) (C.o Dp Es GS (C.o Es Lx GS sg ps) w2) (C.o Dp Lx GS sg (C.o Dp Es Lx ps w2)) (C.o Dp Lx GS sg L.yp)
                (C.o-assoc Dp Es Lx GS sg ps w2)
                (ap (C.Sub Dp Lx) (C.Sub Dp GS) (\ t -> C.o Dp Lx GS sg t) (C.o Dp Es Lx ps w2) L.yp
                   (trans (C.Sub Dp Lx) (C.o Dp Es Lx ps w2) (C.o Dp L.Eg Lx L.pE L.pq) L.yp
                      (TM.pTrW Dp Lx L.Ag ASs PA L.pq) (C.p-pair Dp Lx L.Ag L.yp L.bq))))) ;

      -- the restriction of s to lpt (S(p_g) s, moved to the point lpt)
      Prs : Id (C.Ty Dp) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT Dp GA SA L.lpt) =
        trans (C.Ty Dp) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT Dp G Sf L.s2) (C.subT Dp GA SA L.lpt)
          (sym (C.Ty Dp) (C.subT Dp G Sf L.s2) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT-o Dp Lx G Sf g L.yp))
          (trans (C.Ty Dp) (C.subT Dp G Sf L.s2) (C.subT Dp G Sf L.s1) (C.subT Dp GA SA L.lpt)
             (ap (C.Sub Dp G) (C.Ty Dp) (\ t -> C.subT Dp G Sf t) L.s2 L.s1 (sym (C.Sub Dp G) L.s1 L.s2 L.lpt-e))
             (C.subT-o Dp GA G Sf pA L.lpt)) ;
      rs : C.El Dp (C.subT Dp GA SA L.lpt) = DR.trE Dp (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT Dp GA SA L.lpt) Prs (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp) ;

      tau1 : C.Sub Dp GAS = C.o Dp GSA GAS ex rho ;
      tau2 : C.Sub Dp GAS = C.pair Dp GA SA L.lpt rs ;

      -- lift p_S after rho is lpt
      E2 : Id (C.Sub Dp GA) (C.o Dp GSA GA lS rho) L.lpt =
        TM.subExt Dp G A (C.o Dp GSA GA lS rho) L.lpt
          (trans (C.Sub Dp G) (C.o Dp GA G pA (C.o Dp GSA GA lS rho)) L.s2 L.s1
             (trans (C.Sub Dp G) (C.o Dp GA G pA (C.o Dp GSA GA lS rho)) (C.o Dp GSA G (C.o GSA GA G pA lS) rho) L.s2
                (TM.pO Dp GSA G A lS rho)
                (trans (C.Sub Dp G) (C.o Dp GSA G (C.o GSA GA G pA lS) rho) (C.o Dp GSA G (C.o GSA GS G pS pAS) rho) L.s2
                   (ap (C.Sub GSA G) (C.Sub Dp G) (\ t -> C.o Dp GSA G t rho) (C.o GSA GA G pA lS) (C.o GSA GS G pS pAS) lS-p)
                   (trans (C.Sub Dp G) (C.o Dp GSA G (C.o GSA GS G pS pAS) rho) (C.o Dp GS G pS (C.o Dp GSA GS pAS rho)) L.s2
                      (C.o-assoc Dp GSA GS G pS pAS rho)
                      (trans (C.Sub Dp G) (C.o Dp GS G pS (C.o Dp GSA GS pAS rho)) (C.o Dp GS G pS (C.o Dp Lx GS sg L.yp)) L.s2
                         (ap (C.Sub Dp GS) (C.Sub Dp G) (\ t -> C.o Dp GS G pS t) (C.o Dp GSA GS pAS rho) (C.o Dp Lx GS sg L.yp) E3)
                         (trans (C.Sub Dp G) (C.o Dp GS G pS (C.o Dp Lx GS sg L.yp)) (C.o Dp Lx G (C.o Lx GS G pS sg) L.yp) L.s2
                            (sym (C.Sub Dp G) (C.o Dp Lx G (C.o Lx GS G pS sg) L.yp) (C.o Dp GS G pS (C.o Dp Lx GS sg L.yp)) (C.o-assoc Dp Lx GS G pS sg L.yp))
                            (ap (C.Sub Lx G) (C.Sub Dp G) (\ t -> C.o Dp Lx G t L.yp) (C.o Lx GS G pS sg) g sg-p))))))
             (sym (C.Sub Dp G) L.s1 L.s2 L.lpt-e))
          (TM.teT Dp (C.subT Dp G A (C.o Dp GA G pA (C.o Dp GSA GA lS rho))) (C.subT Dp G A L.s2) (C.subT Dp G A L.s1)
              (TM.qv Dp G A (C.o Dp GSA GA lS rho)) (rep.qg x g) (TM.qv Dp G A L.lpt)
            (TM.teT Dp (C.subT Dp G A (C.o Dp GA G pA (C.o Dp GSA GA lS rho))) (C.subT Dp GS AS (C.o Dp GSA GS pAS rho)) (C.subT Dp G A L.s2)
                (TM.qv Dp G A (C.o Dp GSA GA lS rho)) (TM.qv Dp GS AS rho) (rep.qg x g)
              (qlSr Dp rho)
            (TM.teT Dp (C.subT Dp GS AS (C.o Dp GSA GS pAS rho)) (C.subT Dp Es (C.subT Es GS AS (C.o Es GSA GS pAS ls)) w2) (C.subT Dp G A L.s2)
                (TM.qv Dp GS AS rho) (C.subt Dp Es (C.subT Es GS AS (C.o Es GSA GS pAS ls)) (TM.qv Es GS AS ls) w2) (rep.qg x g)
              (TM.qvO Dp Es GS AS ls w2)
            (TM.teT Dp (C.subT Dp Es (C.subT Es GS AS (C.o Es GSA GS pAS ls)) w2) (C.subT Dp Es (C.subT Es Lx ASs ps) w2) (C.subT Dp G A L.s2)
                (C.subt Dp Es (C.subT Es GS AS (C.o Es GSA GS pAS ls)) (TM.qv Es GS AS ls) w2) (C.subt Dp Es (C.subT Es Lx ASs ps) (C.q Lx ASs) w2) (rep.qg x g)
              (TM.teSub Dp Es w2 (C.subT Es GS AS (C.o Es GSA GS pAS ls)) (C.subT Es Lx ASs ps) (TM.qv Es GS AS ls) (C.q Lx ASs) qls)
            (TM.teT Dp (C.subT Dp Es (C.subT Es Lx ASs ps) w2) (C.subT Dp Lx ASs (C.o Dp Es Lx ps w2)) (C.subT Dp G A L.s2)
                (C.subt Dp Es (C.subT Es Lx ASs ps) (C.q Lx ASs) w2) (TM.qv Dp Lx ASs w2) (rep.qg x g)
              (TM.teTr Dp (C.subT Dp Es (C.subT Es Lx ASs ps) w2) (C.subT Dp Lx ASs (C.o Dp Es Lx ps w2))
                 (sym (C.Ty Dp) (C.subT Dp Lx ASs (C.o Dp Es Lx ps w2)) (C.subT Dp Es (C.subT Es Lx ASs ps) w2) (C.subT-o Dp Es Lx ASs ps w2))
                 (C.subt Dp Es (C.subT Es Lx ASs ps) (C.q Lx ASs) w2))
            (TM.teT Dp (C.subT Dp Lx ASs (C.o Dp Es Lx ps w2)) (C.subT Dp Lx L.Ag (C.o Dp L.Eg Lx L.pE L.pq)) (C.subT Dp G A L.s2)
                (TM.qv Dp Lx ASs w2) (TM.qv Dp Lx L.Ag L.pq) (rep.qg x g)
              (TM.qTrW Dp Lx L.Ag ASs PA L.pq)
            (TM.teT Dp (C.subT Dp Lx L.Ag (C.o Dp L.Eg Lx L.pE L.pq)) (C.subT Dp Lx L.Ag L.yp) (C.subT Dp G A L.s2)
                (TM.qv Dp Lx L.Ag L.pq) L.bq (rep.qg x g)
              (TM.qvPair Dp Lx L.Ag L.yp L.bq)
              (TM.teS Dp (C.subT Dp G A L.s2) (C.subT Dp Lx L.Ag L.yp) (rep.qg x g) L.bq
                 (TM.teTr Dp (C.subT Dp G A L.s2) (C.subT Dp Lx L.Ag L.yp) (C.subT-o Dp Lx G A g L.yp) (rep.qg x g)))))))))
            (TM.teS Dp (C.subT Dp G A L.s1) (C.subT Dp G A L.s2) (TM.qv Dp G A L.lpt) (rep.qg x g) L.lpt-te)) ;

      -- tau1 = tau2
      E1 : Id (C.Sub Dp GAS) tau1 tau2 =
        TM.subExt Dp GA SA tau1 tau2
          (trans (C.Sub Dp GA) (C.o Dp GAS GA pSA tau1) L.lpt (C.o Dp GAS GA pSA tau2)
             (trans (C.Sub Dp GA) (C.o Dp GAS GA pSA tau1) (C.o Dp GSA GA (C.o GSA GAS GA pSA ex) rho) L.lpt
                (TM.pO Dp GSA GA SA ex rho)
                (trans (C.Sub Dp GA) (C.o Dp GSA GA (C.o GSA GAS GA pSA ex) rho) (C.o Dp GSA GA lS rho) L.lpt
                   (ap (C.Sub GSA GA) (C.Sub Dp GA) (\ t -> C.o Dp GSA GA t rho) (C.o GSA GAS GA pSA ex) lS (C.p-pair GSA GA SA lS exq))
                   E2))
             (sym (C.Sub Dp GA) (C.o Dp GAS GA pSA tau2) L.lpt (C.p-pair Dp GA SA L.lpt rs)))
          (TM.teT Dp (C.subT Dp GA SA (C.o Dp GAS GA pSA tau1)) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT Dp GA SA (C.o Dp GAS GA pSA tau2))
              (TM.qv Dp GA SA tau1) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp) (TM.qv Dp GA SA tau2)
            (TM.teT Dp (C.subT Dp GA SA (C.o Dp GAS GA pSA tau1)) (C.subT Dp GSA (C.subT GSA GA SA (C.o GSA GAS GA pSA ex)) rho) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                (TM.qv Dp GA SA tau1) (C.subt Dp GSA (C.subT GSA GA SA (C.o GSA GAS GA pSA ex)) (TM.qv GSA GA SA ex) rho) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
              (TM.qvO Dp GSA GA SA ex rho)
            (TM.teT Dp (C.subT Dp GSA (C.subT GSA GA SA (C.o GSA GAS GA pSA ex)) rho) (C.subT Dp GSA (C.subT GSA GA SA lS) rho) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                (C.subt Dp GSA (C.subT GSA GA SA (C.o GSA GAS GA pSA ex)) (TM.qv GSA GA SA ex) rho) (C.subt Dp GSA (C.subT GSA GA SA lS) exq rho) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
              (TM.teSub Dp GSA rho (C.subT GSA GA SA (C.o GSA GAS GA pSA ex)) (C.subT GSA GA SA lS) (TM.qv GSA GA SA ex) exq (TM.qvPair GSA GA SA lS exq))
            (TM.teT Dp (C.subT Dp GSA (C.subT GSA GA SA lS) rho) (C.subT Dp GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) rho) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                (C.subt Dp GSA (C.subT GSA GA SA lS) exq rho) (C.subt Dp GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) wq rho) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
              (TM.teSub Dp GSA rho (C.subT GSA GA SA lS) (C.subT GSA GS (C.subT GS G Sf pS) pAS) exq wq
                 (TM.teS GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) (C.subT GSA GA SA lS) wq exq (TM.teTr GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) (C.subT GSA GA SA lS) exP wq)))
            (TM.teT Dp (C.subT Dp GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) rho) (C.subT Dp GS (C.subT GS G Sf pS) (C.o Dp GSA GS pAS rho)) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                (C.subt Dp GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) wq rho) (C.subt Dp GS (C.subT GS G Sf pS) (C.q G Sf) (C.o Dp GSA GS pAS rho)) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
              (TM.teS Dp (C.subT Dp GS (C.subT GS G Sf pS) (C.o Dp GSA GS pAS rho)) (C.subT Dp GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) rho)
                 (C.subt Dp GS (C.subT GS G Sf pS) (C.q G Sf) (C.o Dp GSA GS pAS rho)) (C.subt Dp GSA (C.subT GSA GS (C.subT GS G Sf pS) pAS) wq rho)
                 (C.subT-o Dp GSA GS (C.subT GS G Sf pS) pAS rho, C.subt-o Dp GSA GS (C.subT GS G Sf pS) (C.q G Sf) pAS rho))
            (TM.teT Dp (C.subT Dp GS (C.subT GS G Sf pS) (C.o Dp GSA GS pAS rho)) (C.subT Dp GS (C.subT GS G Sf pS) (C.o Dp Lx GS sg L.yp)) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                (C.subt Dp GS (C.subT GS G Sf pS) (C.q G Sf) (C.o Dp GSA GS pAS rho)) (C.subt Dp GS (C.subT GS G Sf pS) (C.q G Sf) (C.o Dp Lx GS sg L.yp)) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
              (TM.teApS Dp GS (C.subT GS G Sf pS) (C.o Dp GSA GS pAS rho) (C.o Dp Lx GS sg L.yp) E3 (C.q G Sf))
            (TM.teT Dp (C.subT Dp GS (C.subT GS G Sf pS) (C.o Dp Lx GS sg L.yp)) (C.subT Dp Lx (C.subT Lx GS (C.subT GS G Sf pS) sg) L.yp) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                (C.subt Dp GS (C.subT GS G Sf pS) (C.q G Sf) (C.o Dp Lx GS sg L.yp)) (C.subt Dp Lx (C.subT Lx GS (C.subT GS G Sf pS) sg) (C.subt Lx GS (C.subT GS G Sf pS) (C.q G Sf) sg) L.yp) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
              (C.subT-o Dp Lx GS (C.subT GS G Sf pS) sg L.yp, C.subt-o Dp Lx GS (C.subT GS G Sf pS) (C.q G Sf) sg L.yp)
              (TM.teSub Dp Lx L.yp (C.subT Lx GS (C.subT GS G Sf pS) sg) (C.subT Lx G Sf g) (C.subt Lx GS (C.subT GS G Sf pS) (C.q G Sf) sg) s
                 (TM.teT Lx (C.subT Lx GS (C.subT GS G Sf pS) sg) (C.subT Lx G Sf (C.o Lx GS G pS sg)) (C.subT Lx G Sf g)
                     (C.subt Lx GS (C.subT GS G Sf pS) (C.q G Sf) sg) (TM.qv Lx G Sf sg) s
                   (TM.teTr Lx (C.subT Lx GS (C.subT GS G Sf pS) sg) (C.subT Lx G Sf (C.o Lx GS G pS sg))
                      (sym (C.Ty Lx) (C.subT Lx G Sf (C.o Lx GS G pS sg)) (C.subT Lx GS (C.subT GS G Sf pS) sg) (C.subT-o Lx GS G Sf pS sg))
                      (C.subt Lx GS (C.subT GS G Sf pS) (C.q G Sf) sg))
                   (TM.qvPair Lx G Sf g s)))))))))
            (TM.teS Dp (C.subT Dp GA SA (C.o Dp GAS GA pSA tau2)) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (TM.qv Dp GA SA tau2) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
               (TM.teT Dp (C.subT Dp GA SA (C.o Dp GAS GA pSA tau2)) (C.subT Dp GA SA L.lpt) (C.subT Dp Lx (C.subT Lx G Sf g) L.yp)
                   (TM.qv Dp GA SA tau2) rs (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)
                 (TM.qvPair Dp GA SA L.lpt rs)
                 (TM.teS Dp (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT Dp GA SA L.lpt) (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp) rs
                    (TM.teTr Dp (C.subT Dp Lx (C.subT Lx G Sf g) L.yp) (C.subT Dp GA SA L.lpt) Prs (C.subt Dp Lx (C.subT Lx G Sf g) s L.yp)))))) ;

      -- the right-hand side: m at lpt, applied to S(p_g) s
      rhs : C.El Dp (C.subT Dp GA P L.lpt) = DR.Pts[S].onFib GA SA P m L.xg L.lpt rs ;

      chain : TM.TE Dp (C.subT Dp GA P L.lpt) (C.subT Dp GA P L.lpt) (L.ev72 u) rhs =
        TM.teT Dp (C.subT Dp GA P L.lpt) (C.subT Dp L.Eg L.Pg L.pq) (C.subT Dp GA P L.lpt) (L.ev72 u) (C.subt Dp L.Eg L.Pg (PI.app Lx L.Ag L.Pg F1) L.pq) rhs
          (TM.teS Dp (C.subT Dp L.Eg L.Pg L.pq) (C.subT Dp GA P L.lpt) (C.subt Dp L.Eg L.Pg (PI.app Lx L.Ag L.Pg F1) L.pq) (L.ev72 u)
             (TM.teTr Dp (C.subT Dp L.Eg L.Pg L.pq) (C.subT Dp GA P L.lpt) L.oN (C.subt Dp L.Eg L.Pg (PI.app Lx L.Ag L.Pg F1) L.pq)))
        (TM.teT Dp (C.subT Dp L.Eg L.Pg L.pq) (C.subT Dp Es BSs w2) (C.subT Dp GA P L.lpt) (C.subt Dp L.Eg L.Pg (PI.app Lx L.Ag L.Pg F1) L.pq) (C.subt Dp Es BSs (PI.app Lx ASs BSs F2) w2) rhs
          (evCompare Lx Dp GA P L.Ag ASs PA L.lg lS-ls Pf L.Pg (refl L.Pg) BSs
             (sym (C.Ty Es) (C.subT Es GA P lS-ls) BSs (C.subT-o Es GSA GA P lS ls)) F1 F2 hF L.pq)
        (TM.teT Dp (C.subT Dp Es BSs w2) (C.subT Dp Es BSs w2) (C.subT Dp GA P L.lpt) (C.subt Dp Es BSs (PI.app Lx ASs BSs F2) w2) (C.subt Dp Es BSs (C.subt Es GSA BS body ls) w2) rhs
          (TM.teR Dp (C.subT Dp Es BSs w2) (C.subt Dp Es BSs (PI.app Lx ASs BSs F2) w2) (C.subt Dp Es BSs (C.subt Es GSA BS body ls) w2)
             (ap (C.El Es BSs) (C.El Dp (C.subT Dp Es BSs w2)) (\ z -> C.subt Dp Es BSs z w2) (PI.app Lx ASs BSs F2) (C.subt Es GSA BS body ls)
                 (PI.app-lam Lx ASs BSs (C.subt Es GSA BS body ls))))
        (TM.teT Dp (C.subT Dp Es BSs w2) (C.subT Dp GSA BS rho) (C.subT Dp GA P L.lpt) (C.subt Dp Es BSs (C.subt Es GSA BS body ls) w2) (C.subt Dp GSA BS body rho) rhs
          (TM.teS Dp (C.subT Dp GSA BS rho) (C.subT Dp Es BSs w2) (C.subt Dp GSA BS body rho) (C.subt Dp Es BSs (C.subt Es GSA BS body ls) w2)
             (C.subT-o Dp Es GSA BS ls w2, C.subt-o Dp Es GSA BS body ls w2))
