-- Lemma72.seg (DUALITY.md P2.4, jonas.pdf Lemma 72 = Lemma 59).  For A over
-- G with a local homotopy representation (LocRep) and P over G.A fibrant
-- and D-modal, at a point g of G at x the map
--   ev72 : (Pi_A P)(x , g) -> P(x.g , lpt) ,   lpt = (lift g) <p_g , q_g>,
-- u |-> u_{p_g}(q_g) (Pi-nat, app, restriction along <p_g , q_g>), is an
-- equivalence of Unit types.
--
-- Informal text.  (Pi_A P)(x , g) = El(yo x , (Pi_A P)[g]) by definition;
-- = El(yo x , Pi_{A[g]} P[lift g]) (Pi-nat); = El(yo x . A[g] , P[lift g])
-- (app, an iso: app-lam, lam-app); -> El(yo (x.g) , P[lift g][<p,q>]),
-- restriction along the levelwise equivalence <p_g , q_g>, an equivalence
-- by Prop 69 (P[lift g] is fibrant and D-modal: Fib-sub, Modal-sub);
-- = P(x.g , lpt) (subT-o).  The point lpt is the paper's (g p_g , q_g):
-- extEquiv identifies it with that pair.

level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module L72 (C : T2[l, k].PCwF) (S : T2[l, k].Site[C]) (PI : T2[l, k].PiS[C]) (Dd : T2[l, k].DS[C, S])
  (G : C.Ctx) (A : C.Ty G) (rep : T2[l, k].LocRep[C, S, G, A])
  (P : C.Ty (C.ext G A)) (fP : Dd.Fib (C.ext G A) P) (mP : Dd.Modal (C.ext G A) P)
  (x : S.Ob) (g : C.Sub (S.yo x) G) {
  module DR = T2[l, k].Der[C] ;
  module L7 = Lemma67[l, k].L67[C, S, Dd] ;
  module TM = TE[l, k].TEm[C] ;

  Ag : C.Ty (S.yo x) = C.subT (S.yo x) G A g ;
  Eg : C.Ctx = C.ext (S.yo x) Ag ;
  lg : C.Sub Eg (C.ext G A) = DR.lift (S.yo x) G A g ;
  Pg : C.Ty Eg = C.subT Eg (C.ext G A) P lg ;
  xg : S.Ob = rep.xg x g ;
  pq : C.Sub (S.yo xg) Eg = rep.pq x g ;

  -- the point (g p_g , q_g) of G.A at x.g
  lpt : C.Sub (S.yo xg) (C.ext G A) = C.o (S.yo xg) Eg (C.ext G A) lg pq ;

  piN : Id (C.Ty (S.yo x)) (C.subT (S.yo x) G (PI.Pi G A P) g) (PI.Pi (S.yo x) Ag Pg) = PI.Pi-nat (S.yo x) G A P g ;
  oN : Id (C.Ty (S.yo xg)) (C.subT (S.yo xg) Eg Pg pq) (C.subT (S.yo xg) (C.ext G A) P lpt) =
    sym (C.Ty (S.yo xg)) (C.subT (S.yo xg) (C.ext G A) P lpt) (C.subT (S.yo xg) Eg Pg pq) (C.subT-o (S.yo xg) Eg (C.ext G A) P lg pq) ;

  ----------------------------------------------------------------------
  -- lpt-ext: the point lpt is the pair (g p_g , q_g).  First component by
  -- o-assoc and p-pair; second by a TE chain (subt-o, q-pair at lift and at
  -- <p , q>, the transports defining them), closed by TE.teAny (isSetTy).

  Dp : C.Ctx = S.yo xg ;
  pE : C.Sub Eg (S.yo x) = C.p (S.yo x) Ag ;
  yp : C.Sub Dp (S.yo x) = S.yoH xg x (rep.pg x g) ;
  sl : C.Sub Eg G = C.o Eg (S.yo x) G g pE ;
  Ap : C.Ty (C.ext G A) = C.subT (C.ext G A) G A (C.p G A) ;
  -- the second component of lift g, and of <p , q>
  al : C.El Eg (C.subT Eg G A sl) =
    DR.trE Eg (C.subT Eg (S.yo x) Ag pE) (C.subT Eg G A sl) (sym (C.Ty Eg) (C.subT Eg G A sl) (C.subT Eg (S.yo x) Ag pE) (C.subT-o Eg (S.yo x) G A g pE))
      (C.q (S.yo x) Ag) ;
  bq : C.El Dp (C.subT Dp (S.yo x) Ag yp) =
    DR.trE Dp (C.subT Dp G A (C.o Dp (S.yo x) G g yp)) (C.subT Dp (S.yo x) Ag yp) (C.subT-o Dp (S.yo x) G A g yp) (rep.qg x g) ;

  s1 : C.Sub Dp G = C.o Dp (C.ext G A) G (C.p G A) lpt ;
  s2 : C.Sub Dp G = C.o Dp (S.yo x) G g yp ;

  lpt-e : Id (C.Sub Dp G) s1 s2 =
    trans (C.Sub Dp G) s1 (C.o Dp Eg G (C.o Eg (C.ext G A) G (C.p G A) lg) pq) s2
      (sym (C.Sub Dp G) (C.o Dp Eg G (C.o Eg (C.ext G A) G (C.p G A) lg) pq) s1 (C.o-assoc Dp Eg (C.ext G A) G (C.p G A) lg pq))
      (trans (C.Sub Dp G) (C.o Dp Eg G (C.o Eg (C.ext G A) G (C.p G A) lg) pq) (C.o Dp Eg G sl pq) s2
         (ap (C.Sub Eg G) (C.Sub Dp G) (\ t -> C.o Dp Eg G t pq) (C.o Eg (C.ext G A) G (C.p G A) lg) sl (C.p-pair Eg G A sl al))
         (trans (C.Sub Dp G) (C.o Dp Eg G sl pq) (C.o Dp (S.yo x) G g (C.o Dp Eg (S.yo x) pE pq)) s2
            (C.o-assoc Dp Eg (S.yo x) G g pE pq)
            (ap (C.Sub Dp (S.yo x)) (C.Sub Dp G) (\ t -> C.o Dp (S.yo x) G g t) (C.o Dp Eg (S.yo x) pE pq) yp (C.p-pair Dp (S.yo x) Ag yp bq)))) ;

  lpt-te : TM.TE Dp (C.subT Dp G A s1) (C.subT Dp G A s2) (DR.extFwd Dp G A lpt).2 (rep.qg x g) =
    TM.teT Dp (C.subT Dp G A s1) (C.subT Dp (S.yo x) Ag yp) (C.subT Dp G A s2) (DR.extFwd Dp G A lpt).2 bq (rep.qg x g)
    (TM.teT Dp (C.subT Dp G A s1) (C.subT Dp Eg (C.subT Eg (S.yo x) Ag pE) pq) (C.subT Dp (S.yo x) Ag yp) (DR.extFwd Dp G A lpt).2 (C.subt Dp Eg (C.subT Eg (S.yo x) Ag pE) (C.q (S.yo x) Ag) pq) bq
    (TM.teT Dp (C.subT Dp G A s1) (C.subT Dp Eg (C.subT Eg G A sl) pq) (C.subT Dp Eg (C.subT Eg (S.yo x) Ag pE) pq) (DR.extFwd Dp G A lpt).2 (C.subt Dp Eg (C.subT Eg G A sl) al pq) (C.subt Dp Eg (C.subT Eg (S.yo x) Ag pE) (C.q (S.yo x) Ag) pq)
    (TM.teT Dp (C.subT Dp G A s1) (C.subT Dp Eg (C.subT Eg (C.ext G A) Ap lg) pq) (C.subT Dp Eg (C.subT Eg G A sl) pq) (DR.extFwd Dp G A lpt).2 (C.subt Dp Eg (C.subT Eg (C.ext G A) Ap lg) (C.subt Eg (C.ext G A) Ap (C.q G A) lg) pq) (C.subt Dp Eg (C.subT Eg G A sl) al pq)
    (TM.teT Dp (C.subT Dp G A s1) (C.subT Dp (C.ext G A) Ap lpt) (C.subT Dp Eg (C.subT Eg (C.ext G A) Ap lg) pq) (DR.extFwd Dp G A lpt).2 (C.subt Dp (C.ext G A) Ap (C.q G A) lpt) (C.subt Dp Eg (C.subT Eg (C.ext G A) Ap lg) (C.subt Eg (C.ext G A) Ap (C.q G A) lg) pq)
       -- extFwd's second component is a transport of q at lpt
       (TM.teS Dp (C.subT Dp (C.ext G A) Ap lpt) (C.subT Dp G A s1) (C.subt Dp (C.ext G A) Ap (C.q G A) lpt) (DR.extFwd Dp G A lpt).2
          (TM.teTr Dp (C.subT Dp (C.ext G A) Ap lpt) (C.subT Dp G A s1) (sym (C.Ty Dp) (C.subT Dp G A s1) (C.subT Dp (C.ext G A) Ap lpt) (C.subT-o Dp (C.ext G A) G A (C.p G A) lpt)) (C.subt Dp (C.ext G A) Ap (C.q G A) lpt)))
       -- q at lpt = q at lg, at pq (subt-o)
       (C.subT-o Dp Eg (C.ext G A) Ap lg pq, C.subt-o Dp Eg (C.ext G A) Ap (C.q G A) lg pq))
       -- q at lg = al (q-pair), at pq
       (TM.teSub Dp Eg pq (C.subT Eg (C.ext G A) Ap lg) (C.subT Eg G A sl) (C.subt Eg (C.ext G A) Ap (C.q G A) lg) al
          (DR.wkp Eg G A A sl al, C.q-pair Eg G A sl al)))
       -- al is a transport of q, at pq
       (TM.teSub Dp Eg pq (C.subT Eg G A sl) (C.subT Eg (S.yo x) Ag pE) al (C.q (S.yo x) Ag)
          (TM.teS Eg (C.subT Eg (S.yo x) Ag pE) (C.subT Eg G A sl) (C.q (S.yo x) Ag) al
             (TM.teTr Eg (C.subT Eg (S.yo x) Ag pE) (C.subT Eg G A sl) (sym (C.Ty Eg) (C.subT Eg G A sl) (C.subT Eg (S.yo x) Ag pE) (C.subT-o Eg (S.yo x) G A g pE)) (C.q (S.yo x) Ag)))))
       -- q at pq = bq (q-pair)
       (DR.wkp Dp (S.yo x) Ag Ag yp bq, C.q-pair Dp (S.yo x) Ag yp bq))
       -- bq is a transport of q_g
       (TM.teS Dp (C.subT Dp G A s2) (C.subT Dp (S.yo x) Ag yp) (rep.qg x g) bq
          (TM.teTr Dp (C.subT Dp G A s2) (C.subT Dp (S.yo x) Ag yp) (C.subT-o Dp (S.yo x) G A g yp) (rep.qg x g))) ;

  -- (a) lpt read as a pair is (g p_g , q_g)
  lpt-ext : Id ((s : C.Sub Dp G) * C.El Dp (C.subT Dp G A s)) (DR.extFwd Dp G A lpt) (s2, rep.qg x g) =
    Sigma-path (C.Sub Dp G) (\ s -> C.El Dp (C.subT Dp G A s)) s1 s2 (DR.extFwd Dp G A lpt).2 (rep.qg x g) lpt-e
      (trans (C.El Dp (C.subT Dp G A s2))
         (subst (C.Sub Dp G) (\ s -> C.El Dp (C.subT Dp G A s)) s1 s2 lpt-e (DR.extFwd Dp G A lpt).2)
         (DR.trE Dp (C.subT Dp G A s1) (C.subT Dp G A s2) (ap (C.Sub Dp G) (C.Ty Dp) (\ t -> C.subT Dp G A t) s1 s2 lpt-e) (DR.extFwd Dp G A lpt).2)
         (rep.qg x g)
         (subst-ap (C.Sub Dp G) (C.Ty Dp) (\ t -> C.subT Dp G A t) (\ X -> C.El Dp X) s1 s2 lpt-e (DR.extFwd Dp G A lpt).2)
         (TM.teAny Dp (C.subT Dp G A s1) (C.subT Dp G A s2) (DR.extFwd Dp G A lpt).2 (rep.qg x g) lpt-te
            (ap (C.Sub Dp G) (C.Ty Dp) (\ t -> C.subT Dp G A t) s1 s2 lpt-e))) ;

  -- the four steps
  t1 (u : C.El (S.yo x) (C.subT (S.yo x) G (PI.Pi G A P) g)) : C.El (S.yo x) (PI.Pi (S.yo x) Ag Pg) =
    DR.trE (S.yo x) (C.subT (S.yo x) G (PI.Pi G A P) g) (PI.Pi (S.yo x) Ag Pg) piN u ;
  t2 (v : C.El (S.yo x) (PI.Pi (S.yo x) Ag Pg)) : C.El Eg Pg = PI.app (S.yo x) Ag Pg v ;
  t3 (w : C.El Eg Pg) : C.El (S.yo xg) (C.subT (S.yo xg) Eg Pg pq) = C.subt (S.yo xg) Eg Pg w pq ;
  t4 (z : C.El (S.yo xg) (C.subT (S.yo xg) Eg Pg pq)) : C.El (S.yo xg) (C.subT (S.yo xg) (C.ext G A) P lpt) =
    DR.trE (S.yo xg) (C.subT (S.yo xg) Eg Pg pq) (C.subT (S.yo xg) (C.ext G A) P lpt) oN z ;

  -- u |-> u_{p_g}(q_g)
  ev72 (u : DR.Pts[S].fib G (PI.Pi G A P) x g) : DR.Pts[S].fib (C.ext G A) P xg lpt = t4 (t3 (t2 (t1 u))) ;

  appEq : isEquiv (C.El (S.yo x) (PI.Pi (S.yo x) Ag Pg)) (C.El Eg Pg) t2 =
    qinv (C.El (S.yo x) (PI.Pi (S.yo x) Ag Pg)) (C.El Eg Pg) t2 (PI.lam (S.yo x) Ag Pg)
      (PI.app-lam (S.yo x) Ag Pg) (PI.lam-app (S.yo x) Ag Pg) ;

  restrEq : isEquiv (C.El Eg Pg) (C.El (S.yo xg) (C.subT (S.yo xg) Eg Pg pq)) t3 =
    Prop69[l, k].P69[C, S, Dd, Eg, xg, pq, rep.lw x g, Pg, Dd.Fib-sub Eg (C.ext G A) P lg fP, Dd.Modal-sub Eg (C.ext G A) P lg mP].prop69 ;

  -- Lemma 72
  lemma72 : isEquiv (DR.Pts[S].fib G (PI.Pi G A P) x g) (DR.Pts[S].fib (C.ext G A) P xg lpt) ev72 =
    (Equivalences[k].compose F0 F3 F5
       (Equivalences[k].compose F0 F2 F3
          (Equivalences[k].compose F0 F1 F2 (t1, TM.trE-eq (S.yo x) (C.subT (S.yo x) G (PI.Pi G A P) g) (PI.Pi (S.yo x) Ag Pg) piN) (t2, appEq))
          (t3, restrEq))
       (t4, TM.trE-eq (S.yo xg) (C.subT (S.yo xg) Eg Pg pq) (C.subT (S.yo xg) (C.ext G A) P lpt) oN)).2
   where {
    F0 : U l = C.El (S.yo x) (C.subT (S.yo x) G (PI.Pi G A P) g) ;
    F1 : U l = C.El (S.yo x) (PI.Pi (S.yo x) Ag Pg) ;
    F2 : U l = C.El Eg Pg ;
    F3 : U l = C.El (S.yo xg) (C.subT (S.yo xg) Eg Pg pq) ;
    F5 : U l = C.El (S.yo xg) (C.subT (S.yo xg) (C.ext G A) P lpt) ;
   } ;
} ;
