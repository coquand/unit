-- ZMT4Regression.seg: checked instances.
--
-- 1. The certificate end at the point y = 0 of any commutative set-ring A
--    (E = A, iota = identity, I = 0): s = 1 (sT = [1 Z^0], D = 0) and
--    s y_k^1 = 0 = deh [] (q_k = [], m_k = 0) are the degree-lowering
--    relations; d = 0, the box {0}^3 has one generator, so every monic
--    equation produced by the determinant trick has degree 1 (deg-one).
-- 2. Homogenisation: for D0 over any ring, every generator of J has the
--    degree e_q and dehomogenises to 0 (instances of hp, deh-P are the
--    theorems; nothing about A is decided).
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module ZM = ZMT4Certificate[l] ;
module ZC = ZMTCertificate[l] ;

module Point (A : CRing) (setA : Pr.isSet A.R) {
  module CO = ZM.Over[A,setA,A,setA,RH.identity A,\ k -> A.z] ;
  module LA = RL[A] ;
  sT : TPoly A.R = cons (A.o, nx zero zero zero zero) nil ;
  -- deh [1 Z^0] = 1
  one : Id A.R (CO.deh sT) A.o =
    trans (A.addZ (A.mul A.o (CO.mon3 zero zero zero))) (trans (LA.one-left (CO.mon3 zero zero zero)) (trans (LA.one-left (A.mul A.o A.o)) (LA.one-left A.o))) ;
  -- 1 . 0^1 = 0 = deh []
  dl (k : Ps.Fin ZM.three) : Id A.R (A.mul A.o (CO.bpow A.z (suc zero))) (CO.deh nil) =
    trans (LA.one-left (A.mul A.z A.o)) (trans (A.mulO A.z) (refl A.z)) ;
  cong : FiniteIdeal[l].Over[A,zero,\ j -> A.z].Certificate A.o A.o = FiniteIdeal[l].Over[A,zero,\ j -> A.z].reflexive A.o ;
  module DA = CO.Data[A.o,zero,sT,(refl zero, tt),one,\ k -> zero,\ k -> nil,\ k -> tt,dl,zero,\ j -> A.z,cong] ;
  certificate : ZC.ZMTCert[A,A,RH.identity A,ZM.three,\ k -> A.z,zero,\ j -> A.z] = DA.certificate ;
  -- d = 0 and one generator: the monic equations have degree 1
  deg-one : Id Nat DA.IS.P.deg (suc zero) = refl (suc zero) ;
} ;

module Setup (A : CRing) (setA : Pr.isSet A.R) (D0 : ResidualAlgebra[l].Residual[A,setA,ZM.three]) {
  module ST = ZMT4Setup[l].Over[A,setA,D0] ;
  hom-J (q : Ps.Fin ZM.three) : HomDeg A.R (ST.e q) (ST.P q) = ST.hp q ;
  deh-J (q : Ps.Fin ZM.three) : Id ST.E.R (ST.CO.deh (ST.P q)) ST.E.z = ST.deh-P q ;
} ;
