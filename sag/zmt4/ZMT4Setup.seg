-- ZMT4Setup.seg: the residual algebra E = F(D0) for three generators, its
-- defining equations as term lists, their homogenisations P_q in
-- A[Z, X_1, X_2, X_3] (the generators of J), and dehomogenisation.
--
-- Data: residual data D0 over a commutative set-ring A with n = 3
-- (ResidualAlgebra.Residual: t, b, monic P_i, expressions H_ij), E = F(D0)
-- the residual algebra with generators y_1, y_2, y_3 (the equations
--     f_i = P_i(X_i) - sum_j b_j H_ij(X)
-- hold at y: FD.y-holds, FD.UA.solution).
-- Term lists.  tl sends an expression in X_1..X_3 to a term list with
-- exponents (0, u_1, u_2, u_3): var X_k |-> 1 X_k, constant c |-> c X^0,
-- sum |-> concatenation, product |-> PolynomialAction4.pmul.  Read at
-- Z = 1, X_k = y_k (ZMT4Certificate.deh, now with deh-app, deh-pmul):
--     deh (tl e) = e(y)                                            (deh-tl)
-- so deh (tl f_i) = f_i(y) = 0 (deh-f).
-- Homogenisation.  bndT p = the sum of the total degrees of the terms of p
-- bounds each of them (bnd-le); homT e p gives every term c X^u with
-- size u + k = e the exponent u + k e_0 (ReesBridge4.dich; a term with
-- size u > e would be dropped, but under the bound none is: deh-homT), so
--     P_q = homT e_q (tl f_q),  e_q = bndT (tl f_q),
-- has every term of degree e_q (hp) and deh P_q = 0 (deh-P): J = (P_q)
-- lies in the kernel of dehomogenisation.  No equality in A or E is
-- decided; only total degrees are compared.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module NA = NatArith[l] ;
module RA = ResidualAlgebra[l] ; module RB = ReesBridge4[l] ; module ZM = ZMT4Certificate[l] ;

-- every term has total degree at most e
AllLe (R0 : U l) (e : Base.Nat) : TPoly R0 -> U l = split {
  nil -> Top ;
  cons t p | r -> NA.Le (size t.2) e * r } ;
hom-app (R0 : U l) (dd : Base.Nat) : (p q : TPoly R0) -> HomDeg R0 dd p -> HomDeg R0 dd q -> HomDeg R0 dd (Bar[l].app p q) = split {
  nil -> \ q hp hq -> hq ;
  cons u p | r -> \ q hp hq -> (hp.1, r q hp.2 hq) } ;
all-app (R0 : U l) (e : Base.Nat) : (p q : TPoly R0) -> AllLe R0 e p -> AllLe R0 e q -> AllLe R0 e (Bar[l].app p q) = split {
  nil -> \ q hp hq -> hq ;
  cons u p | r -> \ q hp hq -> (hp.1, r q hp.2 hq) } ;
-- the sum of the degrees bounds each degree
bndT (R0 : U l) : TPoly R0 -> Base.Nat = split {
  nil -> zero ;
  cons t p | r -> NA.plus (size t.2) r } ;
all-mono (R0 : U l) (e a : Base.Nat) : (p : TPoly R0) -> AllLe R0 e p -> AllLe R0 (NA.plus a e) p = split {
  nil -> \ h -> tt ;
  cons t p | r -> \ h -> (NA.le-trans (size t.2) e (NA.plus a e) h.1 (NA.le-sum-r e a), r h.2) } ;
bnd-le (R0 : U l) : (p : TPoly R0) -> AllLe R0 (bndT R0 p) p = split {
  nil -> tt ;
  cons t p | r -> (NA.le-sum-l (bndT R0 p) (size t.2), all-mono R0 (bndT R0 p) (size t.2) p r) } ;

module Over (A : CRing) (setA : Pr.isSet A.R) (D0 : RA.Residual[A,setA,ZM.three]) {
  module FD = RA.Algebra[A,setA,ZM.three,D0] ;
  E : CRing = FD.ring ;
  setE : Pr.isSet E.R = FD.algebra.set ;
  iota : RH.Hom A E = FD.algebra.iota ;
  module CO = ZM.Over[A,setA,E,setE,iota,FD.y] ;
  module PAA = PolynomialAction4[l].Over[A,setA] ;
  module EX = Presentations[l].Over[A,setA] ;
  module LE = RL[E] ;

  ------------------------------------------------------------------------
  -- dehomogenisation is additive and multiplicative

  deh-app : (p q : TPoly A.R) -> Id E.R (CO.deh (Bar[l].app p q)) (E.add (CO.deh p) (CO.deh q)) = split {
    nil -> \ q -> sym (LE.zl (CO.deh q)) ;
    cons t p | r -> \ q -> trans (ap (E.add (E.mul (iota.1 t.1) (CO.mon t.2))) (r q)) (E.addA (E.mul (iota.1 t.1) (CO.mon t.2)) (CO.deh p) (CO.deh q)) } ;
  deh-pmul : (p q : TPoly A.R) -> Id E.R (CO.deh (PAA.pmul p q)) (E.mul (CO.deh p) (CO.deh q)) = split {
    nil -> \ q -> sym (LE.zero-mul (CO.deh q)) ;
    cons t p | r -> \ q -> calc E.R {
      CO.deh (Bar[l].app (PAA.scaleT t q) (PAA.pmul p q))
        =< deh-app (PAA.scaleT t q) (PAA.pmul p q) > E.add (CO.deh (PAA.scaleT t q)) (CO.deh (PAA.pmul p q))
        =< Ps.cong2 E.R E.add _ _ _ _ (CO.deh-scale t.1 t.2 q) (r q)
        > E.add (E.mul (E.mul (iota.1 t.1) (CO.mon t.2)) (CO.deh q)) (E.mul (CO.deh p) (CO.deh q))
        =< sym (LE.dist-left (E.mul (iota.1 t.1) (CO.mon t.2)) (CO.deh p) (CO.deh q))
        > E.mul (CO.deh (cons t p)) (CO.deh q) } } ;

  ------------------------------------------------------------------------
  -- expressions as term lists

  -- the exponent of X_k (y_k is y i_k, ZMT4Certificate)
  exS2 : Ps.Fin (suc (suc zero)) -> N4 = split {
    inl k -> nx zero (suc zero) zero zero ;
    inr u -> nx zero zero (suc zero) zero } ;
  exS : Ps.Fin ZM.three -> N4 = split {
    inl k -> exS2 k ;
    inr u -> nx zero zero zero (suc zero) } ;
  tl : EX.Expr (Ps.Fin ZM.three) -> TPoly A.R = split {
    var v -> cons (A.o, exS v) nil ;
    cst r -> cons (r, nx zero zero zero zero) nil ;
    sumE p q | rp rq -> Bar[l].app rp rq ;
    mulE p q | rp rq -> PAA.pmul rp rq } ;
  -- a single term, and the monomials of degree <= 1
  deh-term (c : A.R) (u : N4) : Id E.R (CO.deh (cons (c, u) nil)) (E.mul (iota.1 c) (CO.mon u)) =
    E.addZ (E.mul (iota.1 c) (CO.mon u)) ;
  one3 : Id E.R (CO.mon3 zero zero zero) E.o = trans (LE.one-left (E.mul E.o E.o)) (LE.one-left E.o) ;
  mon-x1 : Id E.R (CO.mon3 (suc zero) zero zero) (FD.y ZM.i1) =
    trans (ap (E.mul (E.mul (FD.y ZM.i1) E.o)) (LE.one-left E.o)) (trans (E.mulO (E.mul (FD.y ZM.i1) E.o)) (E.mulO (FD.y ZM.i1))) ;
  mon-x2 : Id E.R (CO.mon3 zero (suc zero) zero) (FD.y ZM.i2) =
    trans (LE.one-left (E.mul (E.mul (FD.y ZM.i2) E.o) E.o)) (trans (E.mulO (E.mul (FD.y ZM.i2) E.o)) (E.mulO (FD.y ZM.i2))) ;
  mon-x3 : Id E.R (CO.mon3 zero zero (suc zero)) (FD.y ZM.i3) =
    trans (LE.one-left (E.mul E.o (E.mul (FD.y ZM.i3) E.o))) (trans (LE.one-left (E.mul (FD.y ZM.i3) E.o)) (E.mulO (FD.y ZM.i3))) ;
  one-term (u : N4) (v : E.R) (h : Id E.R (CO.mon u) v) : Id E.R (CO.deh (cons (A.o, u) nil)) v =
    trans (deh-term A.o u) (trans (ap (\ w -> E.mul w (CO.mon u)) iota.2.1) (trans (LE.one-left (CO.mon u)) h)) ;
  deh-var1T : (u : Top) -> Id E.R (CO.deh (cons (A.o, exS (inl (inl (inr u)))) nil)) (FD.y (inl (inl (inr u)))) = split {
    tt -> one-term (nx zero (suc zero) zero zero) (FD.y ZM.i1) mon-x1 } ;
  deh-var1 : (k : Ps.Fin (suc zero)) -> Id E.R (CO.deh (cons (A.o, exS (inl (inl k))) nil)) (FD.y (inl (inl k))) = split {
    inl k -> absurd (Id E.R (CO.deh (cons (A.o, exS (inl (inl (inl k)))) nil)) (FD.y (inl (inl (inl k))))) k ;
    inr u -> deh-var1T u } ;
  deh-var2T : (u : Top) -> Id E.R (CO.deh (cons (A.o, exS (inl (inr u))) nil)) (FD.y (inl (inr u))) = split {
    tt -> one-term (nx zero zero (suc zero) zero) (FD.y ZM.i2) mon-x2 } ;
  deh-var3T : (u : Top) -> Id E.R (CO.deh (cons (A.o, exS (inr u)) nil)) (FD.y (inr u)) = split {
    tt -> one-term (nx zero zero zero (suc zero)) (FD.y ZM.i3) mon-x3 } ;
  deh-var2 : (k : Ps.Fin (suc (suc zero))) -> Id E.R (CO.deh (cons (A.o, exS (inl k)) nil)) (FD.y (inl k)) = split {
    inl k -> deh-var1 k ;
    inr u -> deh-var2T u } ;
  deh-var : (v : Ps.Fin ZM.three) -> Id E.R (CO.deh (cons (A.o, exS v) nil)) (FD.y v) = split {
    inl k -> deh-var2 k ;
    inr u -> deh-var3T u } ;
  -- deh (tl e) = e(y)
  deh-tl : (e : EX.Expr (Ps.Fin ZM.three)) -> Id E.R (CO.deh (tl e)) (EX.eval (Ps.Fin ZM.three) FD.algebra FD.y e) = split {
    var v -> deh-var v ;
    cst r -> trans (deh-term r (nx zero zero zero zero)) (trans (ap (E.mul (iota.1 r)) one3) (E.mulO (iota.1 r))) ;
    sumE p q | rp rq -> trans (deh-app (tl p) (tl q)) (Ps.cong2 E.R E.add _ _ _ _ rp rq) ;
    mulE p q | rp rq -> trans (deh-pmul (tl p) (tl q)) (Ps.cong2 E.R E.mul _ _ _ _ rp rq) } ;
  -- the residual equations vanish at y
  fT (q : Ps.Fin ZM.three) : TPoly A.R = tl (FD.EQ.res q) ;
  deh-f (q : Ps.Fin ZM.three) : Id E.R (CO.deh (fT q)) E.z =
    trans (deh-tl (FD.EQ.res q)) (FD.EQ.At[FD.algebra,FD.y].zeros-elim ZM.three FD.EQ.res FD.UA.solution.2 q) ;

  ------------------------------------------------------------------------
  -- homogenisation

  homTerm (e : Base.Nat) (t : A.R * N4) : RB.Dich (size t.2) e -> TPoly A.R = split {
    inl w -> cons (t.1, addN4 t.2 (nx w.1 zero zero zero)) nil ;
    inr w -> nil } ;
  homT (e : Base.Nat) : TPoly A.R -> TPoly A.R = split {
    nil -> nil ;
    cons t p | r -> Bar[l].app (homTerm e t (RB.dich (size t.2) e)) r } ;
  hom-term (e : Base.Nat) (t : A.R * N4) : (w : RB.Dich (size t.2) e) -> HomDeg A.R e (homTerm e t w) = split {
    inl w -> (trans (ZM.size-add t.2 (nx w.1 zero zero zero)) (trans (ap (NA.plus (size t.2)) (ZM.sizeZ w.1)) w.2), tt) ;
    inr w -> tt } ;
  hom-homT (e : Base.Nat) : (p : TPoly A.R) -> HomDeg A.R e (homT e p) = split {
    nil -> tt ;
    cons t p | r -> hom-app A.R e (homTerm e t (RB.dich (size t.2) e)) (homT e p) (hom-term e t (RB.dich (size t.2) e)) r } ;
  deh-term-hom (e : Base.Nat) (t : A.R * N4) (le : NA.Le (size t.2) e) : (w : RB.Dich (size t.2) e) ->
    Id E.R (CO.deh (homTerm e t w)) (CO.deh (cons t nil)) = split {
    inl w -> trans (deh-term t.1 (addN4 t.2 (nx w.1 zero zero zero)))
               (trans (ap (E.mul (iota.1 t.1)) (trans (CO.mon-add t.2 (nx w.1 zero zero zero)) (trans (ap (E.mul (CO.mon t.2)) one3) (E.mulO (CO.mon t.2)))))
                 (sym (deh-term t.1 t.2))) ;
    inr w -> absurd (Id E.R (CO.deh nil) (CO.deh (cons t nil)))
      (ZM.not-over le.1 w.1 e (trans (ap (NA.plus le.1) (sym w.2)) le.2)) } ;
  deh-homT (e : Base.Nat) : (p : TPoly A.R) -> AllLe A.R e p -> Id E.R (CO.deh (homT e p)) (CO.deh p) = split {
    nil -> \ h -> refl E.z ;
    cons t p | r -> \ h -> calc E.R {
      CO.deh (Bar[l].app (homTerm e t (RB.dich (size t.2) e)) (homT e p))
        =< deh-app (homTerm e t (RB.dich (size t.2) e)) (homT e p)
        > E.add (CO.deh (homTerm e t (RB.dich (size t.2) e))) (CO.deh (homT e p))
        =< Ps.cong2 E.R E.add _ _ _ _ (trans (deh-term-hom e t h.1 (RB.dich (size t.2) e)) (deh-term t.1 t.2)) (r h.2)
        > CO.deh (cons t p) } } ;

  -- THE GENERATORS OF J: P_q = the homogenisation of f_q, of degree e_q
  e (q : Ps.Fin ZM.three) : Base.Nat = bndT A.R (fT q) ;
  P (q : Ps.Fin ZM.three) : TPoly A.R = homT (e q) (fT q) ;
  hp (q : Ps.Fin ZM.three) : HomDeg A.R (e q) (P q) = hom-homT (e q) (fT q) ;
  deh-P (q : Ps.Fin ZM.three) : Id E.R (CO.deh (P q)) E.z = trans (deh-homT (e q) (fT q) (bnd-le A.R (fT q))) (deh-f q) ;
} ;
