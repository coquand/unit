-- ZMT4Assembly.seg: the correction composed with the extraction -- a
-- CONDITIONAL statement, not the final theorem (README §3).
--
-- For residual data D0 over a CFN ring A (three variables), a GenAt list w
-- and fixed bounds fw of the Rees kernel list (ReesRings4 / ReesFiniteList4),
-- and the inputs of ReesCorrection4.List[w,fw].Seq -- c_n (coefficient
-- degree n+1, merely lifted along KG), z_n with ev c_n = d z_n modulo J and
-- z_n - z_0 in I C^0(M) -- and z_0 = Z^-1 on the chart Z (hz0):
--   ReesCorrection4 ... Seq.correction gives merely z with d z in J C^1(-1)
--   and z - z_0 in I C^0(M); ZMT4Extract.Sec.extract turns it into a
--   certificate.                                           (certificate)
-- This checks that the interfaces of the correction and of the extraction
-- match (the same chart modules, congruences and differential, by
-- definition).  The inputs (c, lift, z, hz, hcompat, hz0) are the remaining
-- obligations (D) and (E) of README §3; they are parameters here, and this
-- module is NOT claimed to prove UniversalZMT 3.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open CoefficientParts[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module ZM = ZMT4Certificate[l] ; module RA = ResidualAlgebra[l] ; module ZC = ZMTCertificate[l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) (D0 : RA.Residual[A,setA,ZM.three]) {
  module X = ZMT4Extract[l].Over[A,setA,D0] ;
  module ST = X.ST ;
  module RC = ReesCorrection4[l].Over[K0,A,setA,cfnA,D0.t,D0.b,ZM.three,ST.P,ST.e,ST.hp] ;
  ZT : U l = ZC.ZMTCert[A,ST.E,ST.iota,ZM.three,ST.FD.y,D0.t,D0.b] ;
  module Inputs (w : RC.WC.ReesW) (fw : RC.WC.WithGens[w].F.FixedW)
    (c : Nat -> RC.List[w,fw].ED.WD.E1.El) (hc : (n : Nat) -> RC.List[w,fw].ED.WD.DF.P1.Hom (cdeg (suc n)) (c n))
    (lift : (n : Nat) -> Tr.Trunc[RC.List[w,fw].ED.WD.CI.Lifted (c n)].carrier)
    (z : Nat -> RC.CJ0.E.El) (hz : (n : Nat) -> RC.CJ1.Cong (RC.List[w,fw].ED.EC1.evc (c n)) (RC.d (z n)))
    (hcompat : (n : Nat) -> RC.CJ0.IJ (suc zero) (RC.CJ0.ML.msub (z n) (z zero)))
    (hz0 : (m : E4) -> Id A.R (RC.CJ0.E.val (z zero) p0 m) (X.FPA.delta0 (addE m (nx (suc zero) zero zero zero)))) {
    module SQ = RC.List[w,fw].Seq[c,hc,lift,z,hz,hcompat] ;
    -- CONDITIONAL on the inputs: merely the certificate
    certificate : Tr.Trunc[ZT].carrier =
      TC.bind SQ.Corrected ZT (\ cz -> X.Sec[cz.1,z zero,hz0].extract cz.2.1 cz.2.2) SQ.correction ;
  } ;
} ;
