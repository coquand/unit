-- Theorem 4.4 (DESIGN.md §4.4): for q : C -> B fully faithful and
-- essentially surjective and E a category, precomposition
-- q^* : Fun(B,E) -> Fun(C,E) is fully faithful (Lemma A) and split
-- essentially surjective (Lemma B: G is q^* of the descended functor, up
-- to the natural iso of Lemma B).
level k l m n j ; open Base ;
constraint k <= j ; constraint l <= j ; constraint m <= j ; constraint n <= j ;
module CB = Category[k,l] ; module CE = Category[m,n] ;
module FC = Functor[k,l,k,l] ; module FC2 = FunctorCat[k,l,m,n,j] ;
module FF = Functor[j,j,j,j] ;

module Theorem (C B : CB.Precategory) (E : CE.Category) (q : FC.Functor[C,B])
  (ff : FC.FullyFaithful C B q) (es : FC.EssSurj C B q) {
 module Q = FC2.Precompose[C,B,E.pre,q] ;
 fully-faithful : FF.FullyFaithful FC2.FunCat[B,E.pre].pre FC2.FunCat[C,E.pre].pre Q.star =
  \ G H -> PrecomposeFF[k,l,m,n,j].LemmaA[C,B,E.pre,q,ff,es,G,H].equiv ;
 split-ess-surj : FF.SplitEssSurj FC2.FunCat[B,E.pre].pre FC2.FunCat[C,E.pre].pre Q.star =
  \ G -> (Descent[k,l,m,n,j].LemmaB[C,B,E,q,ff,es,G].functor, Descent[k,l,m,n,j].LemmaB[C,B,E,q,ff,es,G].iso) ;
} ;
