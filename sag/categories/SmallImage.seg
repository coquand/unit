-- Small full image (DESIGN.md §3, doc/univalent-categories.tex Thm 2.1).
-- D : Category[k,l] (objects in U k, arrows in U l), F : A -> D.ob with
-- A : U l.
--
-- D.ob is locally small (Category.Objects), so replacement gives
-- A --quotient--> carrier --inclusion--> D.ob with carrier : U l, the
-- triangle inclusion (quotient p) = F p, ap inclusion an equivalence
-- (embedding), and quotient surjective onto propositions of any size.
--  pre: objects carrier, arrows D(i a, i b), the rest from D at i a, i b, ..
--   By definition Iso_pre(a,b) = Iso_D(i a, i b) (iso).
--  idtoiso-ap: idtoiso_pre a b p = idtoiso_D (i a) (i b) (ap i p), by J on p;
--   at refl both are the identity iso of D at i a (iso-id).
--  univalent: the right side is a composite of two equivalences (embedding,
--   univalence of D); idtoiso_pre is pointwise equal to it.  The composite
--   passes through D.ob : U k, so it is at level k \/ l; lower restates it
--   at l.
--  inclusion: the identity on arrows, a fully faithful functor.
--  one-type: the object type of a category is a 1-type.
--  generated: every a is merely (p, iso F p ~ i a), by surjectivity, from
--   (p, idtoiso of the triangle inverted) at quotient p.
--  fibre-prop: the fibre of inclusion over x is a proposition.  Over i b,
--   u = ap i (unap u) (unap-eq) and (a, ap i r) = (b, refl) by J on r; a
--   general (b, v) reduces to this by J on v.
--  from-fibre, to-fibre: x is in the image iff merely isomorphic to some
--   F p; transport generated along v, resp. eliminate the truncation into
--   the proposition fibre with (quotient p, triangle p . isotoid e).
--  generator-paths: (q p = q p') ~ (i q p = i q p') ~ (F p = F p')
--   ~ Iso (F p) (F p'): embedding, conjugation by the triangles, univalence
--   of D.  automorphisms: (q p = q p) ~ Aut (F p).
level k l ; open Base ;
module P = Prelude[k \/ l] ; module Pl = Prelude[l] ;
module E = EquivalenceLemmas[k \/ l] ;
module R = Replacement[l,k] ;
module CD = Category[k,l] ; module CS = Category[l,l] ;
module Fun = Functor[l,l,k,l] ;
module Tr = Truncation[l] ;

module SmallFullImage (D : CD.Category) (A : U l) (F : A -> D.pre.ob) {
 image : R.Image[A,D.pre.ob,F] = images @l @k A D.pre.ob CD.Objects[D].locally-small F ;

 pre : CS.Precategory = new CS.Precategory[image.carrier,
  \ a b -> D.pre.hom (image.inclusion a) (image.inclusion b),
  \ a b -> D.pre.hom-set (image.inclusion a) (image.inclusion b),
  \ a -> D.pre.idn (image.inclusion a),
  \ a b c -> D.pre.comp (image.inclusion a) (image.inclusion b) (image.inclusion c),
  \ a b -> D.pre.unit-l (image.inclusion a) (image.inclusion b),
  \ a b -> D.pre.unit-r (image.inclusion a) (image.inclusion b),
  \ w a b c -> D.pre.assoc (image.inclusion w) (image.inclusion a) (image.inclusion b) (image.inclusion c)] ;
 -- by definition
 iso (a b : image.carrier) : Id (U l) (pre.Iso a b) (D.pre.Iso (image.inclusion a) (image.inclusion b)) =
  refl (pre.Iso a b) ;

 -- by definition: the identity iso of pre is that of D
 iso-id (a : image.carrier) : Id (pre.Iso a a) (pre.iso-id a) (D.pre.iso-id (image.inclusion a)) =
  refl (pre.iso-id a) ;
 idtoiso-ap (a b : image.carrier) (p : Id image.carrier a b) :
  Id (pre.Iso a b) (pre.idtoiso a b p)
   (D.pre.idtoiso (image.inclusion a) (image.inclusion b) (P.ap image.carrier D.pre.ob image.inclusion a b p)) =
  idJ image.carrier a (\ b1 p1 -> Id (pre.Iso a b1) (pre.idtoiso a b1 p1)
    (D.pre.idtoiso (image.inclusion a) (image.inclusion b1) (P.ap image.carrier D.pre.ob image.inclusion a b1 p1)))
   (iso-id a) b p ;

 univalent : CS.Univalent pre = \ a b ->
  EquivalenceLemmas[l].lower @k (Id image.carrier a b) (pre.Iso a b) (pre.idtoiso a b) (E.homotopy (Id image.carrier a b) (pre.Iso a b)
   (\ p -> D.pre.idtoiso (image.inclusion a) (image.inclusion b) (P.ap image.carrier D.pre.ob image.inclusion a b p))
   (pre.idtoiso a b)
   (\ p -> P.sym (pre.Iso a b) (pre.idtoiso a b p)
     (D.pre.idtoiso (image.inclusion a) (image.inclusion b) (P.ap image.carrier D.pre.ob image.inclusion a b p))
     (idtoiso-ap a b p))
   (E.compose (Id image.carrier a b) (Id D.pre.ob (image.inclusion a) (image.inclusion b))
     (D.pre.Iso (image.inclusion a) (image.inclusion b))
     (D.pre.idtoiso (image.inclusion a) (image.inclusion b))
     (P.ap image.carrier D.pre.ob image.inclusion a b)
     (D.univalent (image.inclusion a) (image.inclusion b)) (image.embedding a b))) ;

 category : CS.Category = new CS.Category[pre, univalent] ;

 inclusion : Fun.Functor[pre, D.pre] = new Fun.Functor[pre, D.pre, image.inclusion,
  \ a b f -> f,
  \ a -> refl (D.pre.idn (image.inclusion a)),
  \ a b c g f -> refl (D.pre.comp (image.inclusion a) (image.inclusion b) (image.inclusion c) g f)] ;
 fully-faithful : Fun.FullyFaithful pre D.pre inclusion = \ a b ->
  Pl.qinv (pre.hom a b) (pre.hom a b) (\ f -> f) (\ f -> f) (\ f -> refl f) (\ f -> refl f) ;

 one-type (a b : image.carrier) : Pl.isSet (Id image.carrier a b) = CS.Objects[category].one-type a b ;

 -- 1. every object is merely isomorphic to a generator
 Generated (x : D.pre.ob) : U l = Tr.Trunc[(p : A) * D.pre.Iso (F p) x].carrier ;
 generated : (a : image.carrier) -> Generated (image.inclusion a) =
  (surjections @l @k @l A D.pre.ob CD.Objects[D].locally-small F
    (\ a -> Generated (image.inclusion a))
    (\ a -> Tr.Trunc[(p : A) * D.pre.Iso (F p) (image.inclusion a)].proposition)).sec
   (\ p -> Tr.Trunc[(p1 : A) * D.pre.Iso (F p1) (image.inclusion (image.quotient p))].inc
     (p, D.pre.idtoiso (F p) (image.inclusion (image.quotient p))
          (P.sym D.pre.ob (image.inclusion (image.quotient p)) (F p) (image.triangle p)))) ;

 -- 2. the fibres of the inclusion are propositions
 -- the inverse of ap inclusion, and its section property
 unap (a b : image.carrier) (u : Id D.pre.ob (image.inclusion a) (image.inclusion b)) : Id image.carrier a b =
  (image.embedding a b).sec u ;
 unap-eq (a b : image.carrier) (u : Id D.pre.ob (image.inclusion a) (image.inclusion b)) :
  Id (Id D.pre.ob (image.inclusion a) (image.inclusion b))
   (P.ap image.carrier D.pre.ob image.inclusion a b (unap a b u)) u =
  (image.embedding a b).sec-eq u ;
 Fibre (x : D.pre.ob) : U (k \/ l) = (a : image.carrier) * Id D.pre.ob (image.inclusion a) x ;
 at-refl (b a : image.carrier) (r : Id image.carrier a b) :
  Id (Fibre (image.inclusion b)) (a, P.ap image.carrier D.pre.ob image.inclusion a b r) (b, refl (image.inclusion b)) =
  Paths[k \/ l].idJR image.carrier b
   (\ a1 r1 -> Id (Fibre (image.inclusion b)) (a1, P.ap image.carrier D.pre.ob image.inclusion a1 b r1)
     (b, refl (image.inclusion b)))
   (refl (b, refl (image.inclusion b))) a r ;
 at-image (b a : image.carrier) (u : Id D.pre.ob (image.inclusion a) (image.inclusion b)) :
  Id (Fibre (image.inclusion b)) (a, u) (b, refl (image.inclusion b)) =
  P.trans (Fibre (image.inclusion b)) (a, u)
   (a, P.ap image.carrier D.pre.ob image.inclusion a b (unap a b u))
   (b, refl (image.inclusion b))
   (P.ap (Id D.pre.ob (image.inclusion a) (image.inclusion b)) (Fibre (image.inclusion b)) (\ v -> (a, v))
     u (P.ap image.carrier D.pre.ob image.inclusion a b (unap a b u))
     (P.sym (Id D.pre.ob (image.inclusion a) (image.inclusion b))
       (P.ap image.carrier D.pre.ob image.inclusion a b (unap a b u)) u
       (unap-eq a b u)))
   (at-refl b a (unap a b u)) ;
 centre (b : image.carrier) (x : D.pre.ob) (v : Id D.pre.ob (image.inclusion b) x) :
  (w : Fibre x) -> Id (Fibre x) w (b, v) =
  idJ D.pre.ob (image.inclusion b) (\ x1 v1 -> (w : Fibre x1) -> Id (Fibre x1) w (b, v1))
   (\ w -> at-image b w.1 w.2) x v ;
 fibre-prop (x : D.pre.ob) : P.isProp (Fibre x) = \ w w' -> centre w'.1 x w'.2 w ;

 -- 2. x is in the image iff it is merely isomorphic to a generator
 from-fibre (x : D.pre.ob) (w : Fibre x) : Generated x =
  P.subst D.pre.ob (\ y -> Generated y) (image.inclusion w.1) x w.2 (generated w.1) ;
 to-fibre (x : D.pre.ob) : Generated x -> Fibre x =
  Tr.Trunc[(p : A) * D.pre.Iso (F p) x].induction @(k \/ l) (\ t -> Fibre x) (\ t -> fibre-prop x)
   (\ w -> (image.quotient w.1,
     P.trans D.pre.ob (image.inclusion (image.quotient w.1)) (F w.1) x
      (image.triangle w.1) (D.isotoid (F w.1) x w.2))) ;

 -- 3. paths between generators are isomorphisms; automorphisms are kept
 generator-paths (p p' : A) :
  P.Equiv (Id image.carrier (image.quotient p) (image.quotient p')) (D.pre.Iso (F p) (F p')) =
  E.then (Id image.carrier (image.quotient p) (image.quotient p')) (Id D.pre.ob (F p) (F p'))
   (D.pre.Iso (F p) (F p'))
   (E.then (Id image.carrier (image.quotient p) (image.quotient p'))
     (Id D.pre.ob (image.inclusion (image.quotient p)) (image.inclusion (image.quotient p')))
     (Id D.pre.ob (F p) (F p'))
     (P.ap image.carrier D.pre.ob image.inclusion (image.quotient p) (image.quotient p'),
      image.embedding (image.quotient p) (image.quotient p'))
     (E.conjugate D.pre.ob (image.inclusion (image.quotient p)) (F p)
       (image.inclusion (image.quotient p')) (F p') (image.triangle p) (image.triangle p')))
   (D.pre.idtoiso (F p) (F p'), D.univalent (F p) (F p')) ;
 automorphisms (p : A) :
  P.Equiv (Id image.carrier (image.quotient p) (image.quotient p)) (D.pre.Iso (F p) (F p)) =
  generator-paths p p ;
} ;
