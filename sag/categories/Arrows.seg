-- Arrows of a precategory with the objects hidden (examples/hidden.seg),
-- for the equational steps of DESIGN.md §4.  Composition; an equation
-- composed on the left or on the right; the unit and associativity laws;
-- the parts of an iso (arrow, inverse, the two identities).
--  undo-r: (h o e) o e^-1 = h, as h o (e o e^-1) = h o 1 = h; so h o e =
--   h' o e gives h = h' (cancel-r).  undo-l, cancel-l on the other side.
--  square-inv: h o a = b o k with a, b isos gives k o a^-1 = b^-1 o h.
--  iso-inv: (e^-1, e) with the two identities exchanged.
--  iso-cmp: e' o e with inverse e^-1 o e'^-1; (e^-1 o e'^-1) o (e' o e)
--   = e^-1 o (e'^-1 o (e' o e)) = e^-1 o e = 1 (undo-l), and symmetrically
--   with the inverses (undo-l at the inverse isos).
--  isIso-prop: two inverses g, g' of f agree, g = g o (f o g') = (g o f) o
--   g' = g' (unit laws); the two identities are in sets.  So an iso is
--   determined by its arrow (iso-eq).
level k l ; open Base ;
module Pl = Prelude[l] ; module H = Paths[l] ;
module CC = Category[k,l] ;

module Arrows (C : CC.Precategory) {
 cmp {x y z : C.ob} (g : C.hom y z) (f : C.hom x y) : C.hom x z = C.comp x y z g f ;
 left {x y z : C.ob} (g : C.hom y z) {f f' : C.hom x y} (p : Id (C.hom x y) f f') :
  Id (C.hom x z) (cmp g f) (cmp g f') = Pl.ap (C.hom x y) (C.hom x z) (\ f1 -> cmp g f1) f f' p ;
 right {x y z : C.ob} {g g' : C.hom y z} (p : Id (C.hom y z) g g') (f : C.hom x y) :
  Id (C.hom x z) (cmp g f) (cmp g' f) = Pl.ap (C.hom y z) (C.hom x z) (\ g1 -> cmp g1 f) g g' p ;
 unit-l {x y : C.ob} (f : C.hom x y) : Id (C.hom x y) (cmp (C.idn y) f) f = C.unit-l x y f ;
 unit-r {x y : C.ob} (f : C.hom x y) : Id (C.hom x y) (cmp f (C.idn x)) f = C.unit-r x y f ;
 assoc {w x y z : C.ob} (h : C.hom y z) (g : C.hom x y) (f : C.hom w x) :
  Id (C.hom w z) (cmp h (cmp g f)) (cmp (cmp h g) f) = C.assoc w x y z f g h ;

 -- the parts of an iso
 arr {x y : C.ob} (e : C.Iso x y) : C.hom x y = e.1 ;
 inv {x y : C.ob} (e : C.Iso x y) : C.hom y x = e.2.1 ;
 inv-arr {x y : C.ob} (e : C.Iso x y) : Id (C.hom x x) (cmp (inv e) (arr e)) (C.idn x) = e.2.2.1 ;
 arr-inv {x y : C.ob} (e : C.Iso x y) : Id (C.hom y y) (cmp (arr e) (inv e)) (C.idn y) = e.2.2.2 ;

 undo-r {x y z : C.ob} (h : C.hom y z) (e : C.Iso x y) : Id (C.hom y z) (cmp (cmp h (arr e)) (inv e)) h =
  H.transH (H.symH (assoc h (arr e) (inv e))) (H.transH (left h (arr-inv e)) (unit-r h)) ;
 undo-l {x y w : C.ob} (e : C.Iso x y) (h : C.hom w x) : Id (C.hom w x) (cmp (inv e) (cmp (arr e) h)) h =
  H.transH (assoc (inv e) (arr e) h) (H.transH (right (inv-arr e) h) (unit-l h)) ;
 cancel-r {x y z : C.ob} (e : C.Iso x y) {h h' : C.hom y z}
  (p : Id (C.hom x z) (cmp h (arr e)) (cmp h' (arr e))) : Id (C.hom y z) h h' =
  H.transH (H.symH (undo-r h e)) (H.transH (right p (inv e)) (undo-r h' e)) ;
 cancel-l {x y w : C.ob} (e : C.Iso x y) {h h' : C.hom w x}
  (p : Id (C.hom w y) (cmp (arr e) h) (cmp (arr e) h')) : Id (C.hom w x) h h' =
  H.transH (H.symH (undo-l e h)) (H.transH (left (inv e) p) (undo-l e h')) ;

 -- a square with isos a, b on two opposite sides: h o a = b o k gives
 -- k o a^-1 = b^-1 o (b o (k o a^-1)) = b^-1 o ((b o k) o a^-1)
 -- = b^-1 o ((h o a) o a^-1) = b^-1 o h
 square-inv {x1 x2 y1 y2 : C.ob} (a : C.Iso x1 x2) (b : C.Iso y1 y2) {h : C.hom x2 y2} {k : C.hom x1 y1}
  (p : Id (C.hom x1 y2) (cmp h (arr a)) (cmp (arr b) k)) : Id (C.hom x2 y1) (cmp k (inv a)) (cmp (inv b) h) =
  H.transH (H.symH (undo-l b (cmp k (inv a))))
   (H.transH (left (inv b) (assoc (arr b) k (inv a)))
    (H.transH (left (inv b) (right (H.symH p) (inv a))) (left (inv b) (undo-r h a)))) ;

 iso-inv {x y : C.ob} (e : C.Iso x y) : C.Iso y x = (inv e, arr e, arr-inv e, inv-arr e) ;
 iso-cmp {x y z : C.ob} (e' : C.Iso y z) (e : C.Iso x y) : C.Iso x z =
  (cmp (arr e') (arr e), cmp (inv e) (inv e'),
   H.transH (H.symH (assoc (inv e) (inv e') (cmp (arr e') (arr e))))
    (H.transH (left (inv e) (undo-l e' (arr e))) (inv-arr e)),
   H.transH (H.symH (assoc (arr e') (arr e) (cmp (inv e) (inv e'))))
    (H.transH (left (arr e') (undo-l (iso-inv e) (inv e'))) (arr-inv e'))) ;

 -- an iso is determined by its arrow
 isIso-prop {x y : C.ob} (f : C.hom x y) : Pl.isProp (C.isIso x y f) = \ u v ->
  Pl.Sigma-eq (C.hom y x)
   (\ g -> Id (C.hom x x) (cmp g f) (C.idn x) * Id (C.hom y y) (cmp f g) (C.idn y))
   u.1 v.1 u.2 v.2
   (H.transH (H.symH (unit-r u.1))
     (H.transH (left u.1 (H.symH v.2.2))
       (H.transH (assoc u.1 f v.1) (H.transH (right u.2.1 v.1) (unit-l v.1)))))
   (Pl.isProp-Sigma (Id (C.hom x x) (cmp v.1 f) (C.idn x)) (\ w -> Id (C.hom y y) (cmp f v.1) (C.idn y))
     (C.hom-set x x (cmp v.1 f) (C.idn x)) (\ w -> C.hom-set y y (cmp f v.1) (C.idn y))) ;
 iso-eq {x y : C.ob} (e e' : C.Iso x y) (p : Id (C.hom x y) (arr e) (arr e')) : Id (C.Iso x y) e e' =
  Pl.Sigma-eq (C.hom x y) (C.isIso x y) e.1 e'.1 e.2 e'.2 p (isIso-prop (arr e')) ;
} ;
