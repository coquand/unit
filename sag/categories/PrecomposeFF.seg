-- Lemma A (DESIGN.md §4.2): q^* is fully faithful.  q : C -> B fully
-- faithful and essentially surjective, E a precategory, G, H : B -> E.
-- For beta : Nat(Gq,Hq) and gamma : E(Gb,Hb), Cond gamma c u (for c : C
-- and any arrow u : B(qc,b)) is gamma o G u = H u o beta_c, and
-- T_b = (gamma : E(Gb,Hb)) * ((c : C) (u : B(qc,b)) -> Cond gamma c u).
--
--  transfer: if u' o q f = u and Cond gamma c' u', then Cond gamma c u:
--   gamma o G u = gamma o G (u' o q f) = gamma o (G u' o G q f)
--   = (gamma o G u') o G q f = (H u' o beta_c') o G q f
--   = H u' o (beta_c' o G q f) = H u' o (H q f o beta_c)   (beta natural)
--   = (H u' o H q f) o beta_c = H (u' o q f) o beta_c = H u o beta_c.
--  T-prop: the conditions are propositions (hom sets, fe); for gamma =
--   gamma', a proposition, merely pick (c, e), e : Iso_B(qc,b): then
--   gamma o G e = H e o beta_c = gamma' o G e, and G e is an iso.
--  T-inh: T_b is a proposition, so merely pick (c0, e0); gamma0 =
--   (H e0 o beta_c0) o G e0^-1, and gamma0 o G e0 = H e0 o beta_c0
--   (undo-r at the inverse of G e0); for (c, u), u = e0 o q (lift e0 u)
--   (lift-eq), and transfer.
--  alpha_b is the first component; cond: Cond alpha_b c u for all (c, u).
--  natural: H g o alpha_b = alpha_b' o G g is a proposition; merely pick
--   (c, e) for b and cancel G e:  (H g o alpha_b) o G e
--   = H g o (alpha_b o G e) = H g o (H e o beta_c) = (H g o H e) o beta_c
--   = H (g o e) o beta_c = alpha_b' o G (g o e)   (cond at (c, g o e))
--   = alpha_b' o (G g o G e) = (alpha_b' o G g) o G e.
--  restrict: q^* alpha = beta, componentwise from cond at (c, 1):
--   alpha_qc = alpha_qc o 1 = alpha_qc o G 1 = H 1 o beta_c = 1 o beta_c
--   = beta_c.
--  unique: if q^* alpha' = beta then alpha'_b satisfies the conditions
--   (alpha'_b o G u = H u o alpha'_qc = H u o beta_c, naturality of
--   alpha' at u), so alpha'_b = alpha_b (T-prop) and alpha' = alpha.
--  equiv: beta |-> alpha is inverse to q^* (restrict, unique).
level k l m n j ; open Base ;
constraint k <= j ; constraint l <= j ; constraint m <= j ; constraint n <= j ;
module CB = Category[k,l] ; module CE = Category[m,n] ;
module FB = Functor[k,l,m,n] ; module FC = Functor[k,l,k,l] ;
module FC2 = FunctorCat[k,l,m,n,j] ;
module P = Prelude[j] ; module Hn = Paths[n] ;
module FE = Axioms[j].FunExtLemmas[fe @j] ;

module LemmaA (C B : CB.Precategory) (E : CE.Precategory) (q : FC.Functor[C,B])
  (ff : FC.FullyFaithful C B q) (es : FC.EssSurj C B q) (G H : FB.Functor[B,E]) {
 module AB = Arrows[k,l].Arrows[B] ; module AE = Arrows[m,n].Arrows[E] ;
 module L = FC.Faithful[C,B,q,ff] ;
 module MG = FB.Maps[B,E,G] ; module MH = FB.Maps[B,E,H] ;
 module Q = FC2.Precompose[C,B,E,q] ;
 module NB = FC2.NatTrans[B,E,G,H] ; module NC = FC2.NatTrans[C,E,Q.functor G,Q.functor H] ;
 module Tr = Truncation[k \/ l] ;

 module Fix (beta : NC.Nat) {
  Cond (b : B.ob) (gamma : E.hom (G.obj b) (H.obj b)) (c : C.ob) (u : B.hom (q.obj c) b) : U n =
   Id (E.hom (G.obj (q.obj c)) (H.obj b)) (AE.cmp gamma (G.map (q.obj c) b u)) (AE.cmp (H.map (q.obj c) b u) (NC.at beta c)) ;
  Conds (b : B.ob) (gamma : E.hom (G.obj b) (H.obj b)) : U j =
   (c : C.ob) (u : B.hom (q.obj c) b) -> Cond b gamma c u ;
  T (b : B.ob) : U j = (gamma : E.hom (G.obj b) (H.obj b)) * Conds b gamma ;

  transfer {c c' : C.ob} {b : B.ob} {gamma : E.hom (G.obj b) (H.obj b)} {u' : B.hom (q.obj c') b}
   {f : C.hom c c'} {u : B.hom (q.obj c) b}
   (w : Id (B.hom (q.obj c) b) (AB.cmp u' (q.map c c' f)) u) (h : Cond b gamma c' u') : Cond b gamma c u =
   Hn.transH (AE.left gamma (MG.map-eq (Paths[l].symH w)))
   (Hn.transH (AE.left gamma (MG.map-cmp u' (q.map c c' f)))
   (Hn.transH (AE.assoc gamma (G.map (q.obj c') b u') (G.map (q.obj c) (q.obj c') (q.map c c' f)))
   (Hn.transH (AE.right h (G.map (q.obj c) (q.obj c') (q.map c c' f)))
   (Hn.transH (Hn.symH (AE.assoc (H.map (q.obj c') b u') (NC.at beta c') (G.map (q.obj c) (q.obj c') (q.map c c' f))))
   (Hn.transH (AE.left (H.map (q.obj c') b u') (Hn.symH (NC.natural beta f)))
   (Hn.transH (AE.assoc (H.map (q.obj c') b u') (H.map (q.obj c) (q.obj c') (q.map c c' f)) (NC.at beta c))
   (Hn.transH (AE.right (Hn.symH (MH.map-cmp u' (q.map c c' f))) (NC.at beta c))
    (AE.right (MH.map-eq w) (NC.at beta c))))))))) ;

  conds-prop (b : B.ob) (gamma : E.hom (G.obj b) (H.obj b)) : P.isProp (Conds b gamma) =
   FE.isProp-Pi C.ob (\ c -> (u : B.hom (q.obj c) b) -> Cond b gamma c u) (\ c ->
    FE.isProp-Pi (B.hom (q.obj c) b) (\ u -> Cond b gamma c u) (\ u ->
     E.hom-set (G.obj (q.obj c)) (H.obj b) (AE.cmp gamma (G.map (q.obj c) b u)) (AE.cmp (H.map (q.obj c) b u) (NC.at beta c)))) ;
  gamma-eq (b : B.ob) (t t' : T b) : Id (E.hom (G.obj b) (H.obj b)) t.1 t'.1 =
   Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @n (\ x -> Id (E.hom (G.obj b) (H.obj b)) t.1 t'.1)
    (\ x -> E.hom-set (G.obj b) (H.obj b) t.1 t'.1)
    (\ w -> AE.cancel-r (MG.map-iso w.2) (Hn.transH (t.2 w.1 (AB.arr w.2)) (Hn.symH (t'.2 w.1 (AB.arr w.2)))))
    (es b) ;
  T-prop (b : B.ob) : P.isProp (T b) = \ t t' ->
   P.Sigma-eq (E.hom (G.obj b) (H.obj b)) (Conds b) t.1 t'.1 t.2 t'.2 (gamma-eq b t t') (conds-prop b t'.1) ;

  at-generator (b : B.ob) (c0 : C.ob) (e0 : B.Iso (q.obj c0) b) : T b =
   (AE.cmp (AE.cmp (H.map (q.obj c0) b (AB.arr e0)) (NC.at beta c0)) (G.map b (q.obj c0) (AB.inv e0)),
    \ c u -> transfer (L.lift-eq e0 u)
     (AE.undo-r (AE.cmp (H.map (q.obj c0) b (AB.arr e0)) (NC.at beta c0)) (AE.iso-inv (MG.map-iso e0)))) ;
  T-inh (b : B.ob) : T b =
   Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @j (\ x -> T b) (\ x -> T-prop b)
    (\ w -> at-generator b w.1 w.2) (es b) ;

  alpha : NB.Comp = \ b -> (T-inh b).1 ;
  cond (b : B.ob) (c : C.ob) (u : B.hom (q.obj c) b) : Cond b (alpha b) c u = (T-inh b).2 c u ;

  natural (b b' : B.ob) (g : B.hom b b') : NB.Square alpha b b' g =
   Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @n (\ x -> NB.Square alpha b b' g)
    (\ x -> E.hom-set (G.obj b) (H.obj b') (AE.cmp (H.map b b' g) (alpha b)) (AE.cmp (alpha b') (G.map b b' g)))
    (\ w -> AE.cancel-r (MG.map-iso w.2)
     (Hn.transH (Hn.symH (AE.assoc (H.map b b' g) (alpha b) (G.map (q.obj w.1) b (AB.arr w.2))))
     (Hn.transH (AE.left (H.map b b' g) (cond b w.1 (AB.arr w.2)))
     (Hn.transH (AE.assoc (H.map b b' g) (H.map (q.obj w.1) b (AB.arr w.2)) (NC.at beta w.1))
     (Hn.transH (AE.right (Hn.symH (MH.map-cmp g (AB.arr w.2))) (NC.at beta w.1))
     (Hn.transH (Hn.symH (cond b' w.1 (AB.cmp g (AB.arr w.2))))
     (Hn.transH (AE.left (alpha b') (MG.map-cmp g (AB.arr w.2)))
      (AE.assoc (alpha b') (G.map b b' g) (G.map (q.obj w.1) b (AB.arr w.2))))))))))
    (es b) ;
  nat : NB.Nat = (alpha, natural) ;

  at-q (c : C.ob) : Id (E.hom (G.obj (q.obj c)) (H.obj (q.obj c))) (alpha (q.obj c)) (NC.at beta c) =
   Hn.transH (Hn.symH (AE.unit-r (alpha (q.obj c))))
   (Hn.transH (AE.left (alpha (q.obj c)) (Hn.symH (G.map-idn (q.obj c))))
   (Hn.transH (cond (q.obj c) c (B.idn (q.obj c)))
   (Hn.transH (AE.right (H.map-idn (q.obj c)) (NC.at beta c))
    (AE.unit-l (NC.at beta c))))) ;
  restrict : Id NC.Nat (Q.nat G H nat) beta = NC.nat-eq (Q.nat G H nat) beta at-q ;

  -- alpha'_b satisfies the conditions when q^* alpha' = beta
  of-nat (a' : NB.Nat) (p : Id NC.Nat (Q.nat G H a') beta) (b : B.ob) : T b =
   (NB.at a' b, \ c u ->
    Hn.transH (Hn.symH (NB.natural a' u))
     (AE.left (H.map (q.obj c) b u)
      (P.ap NC.Nat (E.hom (G.obj (q.obj c)) (H.obj (q.obj c))) (\ t -> NC.at t c) (Q.nat G H a') beta p))) ;
  unique (a' : NB.Nat) (p : Id NC.Nat (Q.nat G H a') beta) : Id NB.Nat a' nat =
   NB.nat-eq a' nat (\ b ->
    P.ap (T b) (E.hom (G.obj b) (H.obj b)) (\ t -> t.1) (of-nat a' p b) (T-inh b) (T-prop b (of-nat a' p b) (T-inh b))) ;
 } ;

 equiv : P.isEquiv NB.Nat NC.Nat (Q.nat G H) =
  P.qinv NB.Nat NC.Nat (Q.nat G H) (\ beta -> Fix[beta].nat) (\ beta -> Fix[beta].restrict)
   (\ a' -> P.sym NB.Nat a' (Fix[Q.nat G H a'].nat) (Fix[Q.nat G H a'].unique a' (refl (Q.nat G H a')))) ;
} ;
