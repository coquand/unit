-- Univalence of functor categories (DESIGN.md §4.7): for B a precategory
-- and E a category, Fun(B,E) is a category.  By FromTotal (§4.6) it
-- suffices that Total F = (G : Fun(B,E)) * Iso_Fun(F,G) is a proposition.
--
--  component: an iso of functors (alpha, beta, p, p') has iso components
--   (alpha_b, beta_b, p_b, p'_b), p_b the component at b of beta o alpha
--   = 1 (composite and identity are componentwise).
--  FromComponents: a natural alpha with iso components a_b is an iso of
--   functors; the inverses are natural (square-inv), the identities hold
--   componentwise (nat-eq).
--  The Sigma form S = (o : Obj) * Rest o, Obj = (G0 : B -> E) *
--   ((b : B) -> Iso_E(Fb, G0 b)), Rest o = (G1 : Maps o) * (L : Laws o G1)
--   * naturality of the arrows of o.2 from F to functor o G1 L.  s takes
--   the components of G and of the iso, r builds the functor and the iso
--   (FromComponents).  r (s (G, i)) = (G, i): by the eliminator of the
--   functor record G is constructed (built), and then the first components
--   agree by definition, the second are isos with the same components.
--  S is a proposition: Obj is a retract of (b : B) -> Singl (F b), a
--   product of propositions (singl-prop, fe); in Rest o, G1 g o a_b =
--   a_b' o F g = G1' g o a_b, cancel the iso a_b (maps-eq, fe); laws and
--   naturality are propositions (hom sets).  Total, a retract of S, is a
--   proposition.
level k l m n j ; open Base ;
constraint k <= j ; constraint l <= j ; constraint m <= j ; constraint n <= j ;
module CB = Category[k,l] ; module CE = Category[m,n] ; module CF = Category[j,j] ;
module FB = Functor[k,l,m,n] ; module FC2 = FunctorCat[k,l,m,n,j] ;
module P = Prelude[j] ; module Hn = Paths[n] ;
module FE = Axioms[j].FunExtLemmas[fe @j] ;

module Univalence (B : CB.Precategory) (E : CE.Category) {
 module AE = Arrows[m,n].Arrows[E.pre] ;
 module FunB = FC2.FunCat[B,E.pre] ;
 module AF = Arrows[j,j].Arrows[FunB.pre] ;
 module SE = CE.Singletons[E.pre] ;

 -- the components of an iso of functors are isos
 component (F G : FB.Functor[B,E.pre]) (i : FunB.pre.Iso F G) (b : B.ob) : E.pre.Iso (F.obj b) (G.obj b) =
  (FC2.NatTrans[B,E.pre,F,G].at (AF.arr i) b, FC2.NatTrans[B,E.pre,G,F].at (AF.inv i) b,
   P.ap (FunB.pre.hom F F) (E.pre.hom (F.obj b) (F.obj b)) (\ a -> FC2.NatTrans[B,E.pre,F,F].at a b)
    (AF.cmp (AF.inv i) (AF.arr i)) (FunB.pre.idn F) (AF.inv-arr i),
   P.ap (FunB.pre.hom G G) (E.pre.hom (G.obj b) (G.obj b)) (\ a -> FC2.NatTrans[B,E.pre,G,G].at a b)
    (AF.cmp (AF.arr i) (AF.inv i)) (FunB.pre.idn G) (AF.arr-inv i)) ;
 -- by definition
 component-arr (F G : FB.Functor[B,E.pre]) (i : FunB.pre.Iso F G) (b : B.ob) :
  Id (E.pre.hom (F.obj b) (G.obj b)) (AE.arr (component F G i b)) (FC2.NatTrans[B,E.pre,F,G].at (AF.arr i) b) =
  refl (FC2.NatTrans[B,E.pre,F,G].at (AF.arr i) b) ;

 -- a natural transformation with iso components is an iso of functors
 module FromComponents (F G : FB.Functor[B,E.pre]) (a : (b : B.ob) -> E.pre.Iso (F.obj b) (G.obj b))
   (nu : FC2.NatTrans[B,E.pre,F,G].Natural (\ b -> AE.arr (a b))) {
  alpha : FC2.NatTrans[B,E.pre,F,G].Nat = (\ b -> AE.arr (a b), nu) ;
  beta : FC2.NatTrans[B,E.pre,G,F].Nat =
   (\ b -> AE.inv (a b), \ b b' g -> AE.square-inv (a b) (a b') (nu b b' g)) ;
  iso : FunB.pre.Iso F G =
   (alpha, beta,
    FC2.NatTrans[B,E.pre,F,F].nat-eq (FunB.comp F G F beta alpha) (FunB.idn F) (\ b -> AE.inv-arr (a b)),
    FC2.NatTrans[B,E.pre,G,G].nat-eq (FunB.comp G F G alpha beta) (FunB.idn G) (\ b -> AE.arr-inv (a b))) ;
 } ;

 module Fix (F : FB.Functor[B,E.pre]) {
  Total : U j = CF.Singletons[FunB.pre].Singl F ;

  -- the Sigma form
  Obj : U j = (G0 : B.ob -> E.pre.ob) * ((b : B.ob) -> E.pre.Iso (F.obj b) (G0 b)) ;
  Maps (G0 : B.ob -> E.pre.ob) : U j = (b b' : B.ob) -> B.hom b b' -> E.pre.hom (G0 b) (G0 b') ;
  MapIdn (G0 : B.ob -> E.pre.ob) (G1 : Maps G0) : U j =
   (b : B.ob) -> Id (E.pre.hom (G0 b) (G0 b)) (G1 b b (B.idn b)) (E.pre.idn (G0 b)) ;
  MapComp (G0 : B.ob -> E.pre.ob) (G1 : Maps G0) : U j =
   (b b' b'' : B.ob) (g' : B.hom b' b'') (g : B.hom b b') ->
    Id (E.pre.hom (G0 b) (G0 b'')) (G1 b b'' (B.comp b b' b'' g' g))
     (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g)) ;
  Laws (G0 : B.ob -> E.pre.ob) (G1 : Maps G0) : U j = MapIdn G0 G1 * MapComp G0 G1 ;
  functor (G0 : B.ob -> E.pre.ob) (G1 : Maps G0) (L : Laws G0 G1) : FB.Functor[B,E.pre] =
   new FB.Functor[B,E.pre, G0, G1, L.1, L.2] ;
  Natural (o : Obj) (G1 : Maps o.1) (L : Laws o.1 G1) : U j =
   FC2.NatTrans[B,E.pre,F,functor o.1 G1 L].Natural (\ b -> AE.arr (o.2 b)) ;
  Rest (o : Obj) : U j = (G1 : Maps o.1) * (L : Laws o.1 G1) * Natural o G1 L ;
  S : U j = (o : Obj) * Rest o ;

  s (t : Total) : S =
   ((t.1.obj, component F t.1 t.2),
    (t.1.map, (t.1.map-idn, t.1.map-comp), \ b b' g -> FC2.NatTrans[B,E.pre,F,t.1].natural (AF.arr t.2) g)) ;
  r (w : S) : Total =
   (functor w.1.1 w.2.1 w.2.2.1, FromComponents[F, functor w.1.1 w.2.1 w.2.2.1, w.1.2, w.2.2.2].iso) ;

  -- at a constructed functor G, r (s (G, i)) = (G, i): the same functor by
  -- definition, and isos with the same components
  module Built (G0 : B.ob -> E.pre.ob) (G1 : Maps G0) (li : MapIdn G0 G1) (lc : MapComp G0 G1) {
   G : FB.Functor[B,E.pre] = functor G0 G1 (li, lc) ;
   -- the iso rebuilt from the components of i
   rebuilt (i : FunB.pre.Iso F G) : FunB.pre.Iso F G =
    FromComponents[F, G, component F G i, \ b b' g -> FC2.NatTrans[B,E.pre,F,G].natural (AF.arr i) g].iso ;
   -- by definition
   r-s (i : FunB.pre.Iso F G) : Id Total (r (s (G, i))) (G, rebuilt i) = refl (G, rebuilt i) ;
   rebuilt-at (i : FunB.pre.Iso F G) (b : B.ob) :
    Id (E.pre.hom (F.obj b) (G.obj b)) (FC2.NatTrans[B,E.pre,F,G].at (AF.arr (rebuilt i)) b) (AE.arr (component F G i b)) =
    refl (AE.arr (component F G i b)) ;
   same (i : FunB.pre.Iso F G) : Id (FunB.pre.Iso F G) (rebuilt i) i =
    AF.iso-eq (rebuilt i) i
     (FC2.NatTrans[B,E.pre,F,G].nat-eq (AF.arr (rebuilt i)) (AF.arr i)
       (\ b -> Hn.transH (rebuilt-at i b) (component-arr F G i b))) ;
   eq (i : FunB.pre.Iso F G) : Id Total (r (s (G, i))) (G, i) =
    P.trans Total (r (s (G, i))) (G, rebuilt i) (G, i) (r-s i)
     (P.ap (FunB.pre.Iso F G) Total (\ i1 -> (G, i1)) (rebuilt i) i (same i)) ;
  } ;
  -- by the eliminator of the functor record
  rs : (G : FB.Functor[B,E.pre]) (i : FunB.pre.Iso F G) -> Id Total (r (s (G, i))) (G, i) =
   split { Functor G0 G1 li lc -> Built[G0,G1,li,lc].eq } ;

  -- S is a proposition
  obj-prop : P.isProp Obj =
   P.retract-prop Obj ((b : B.ob) -> SE.Singl (F.obj b))
    (\ o b -> (o.1 b, o.2 b)) (\ h -> (\ b -> (h b).1, \ b -> (h b).2)) (\ o -> refl o)
    (FE.isProp-Pi B.ob (\ b -> SE.Singl (F.obj b)) (\ b -> CE.Objects[E].singl-prop (F.obj b))) ;
  square (o : Obj) (u : Rest o) (b b' : B.ob) (g : B.hom b b') :
   Id (E.pre.hom (F.obj b) (o.1 b')) (AE.cmp (u.1 b b' g) (AE.arr (o.2 b))) (AE.cmp (AE.arr (o.2 b')) (F.map b b' g)) =
   u.2.2 b b' g ;
  maps-eq (o : Obj) (u v : Rest o) : Id (Maps o.1) u.1 v.1 =
   FE.funext B.ob (\ b -> (b' : B.ob) -> B.hom b b' -> E.pre.hom (o.1 b) (o.1 b')) u.1 v.1 (\ b ->
    FE.funext B.ob (\ b' -> B.hom b b' -> E.pre.hom (o.1 b) (o.1 b')) (u.1 b) (v.1 b) (\ b' ->
     FE.funext (B.hom b b') (\ g -> E.pre.hom (o.1 b) (o.1 b')) (u.1 b b') (v.1 b b') (\ g ->
      AE.cancel-r (o.2 b) (Hn.transH (square o u b b' g) (Hn.symH (square o v b b' g)))))) ;
  laws-prop (G0 : B.ob -> E.pre.ob) (G1 : Maps G0) : P.isProp (Laws G0 G1) =
   P.isProp-Sigma (MapIdn G0 G1) (\ li -> MapComp G0 G1)
    (FE.isProp-Pi B.ob (\ b -> Id (E.pre.hom (G0 b) (G0 b)) (G1 b b (B.idn b)) (E.pre.idn (G0 b))) (\ b ->
      E.pre.hom-set (G0 b) (G0 b) (G1 b b (B.idn b)) (E.pre.idn (G0 b))))
    (\ li -> FE.isProp-Pi B.ob (\ b -> (b' b'' : B.ob) (g' : B.hom b' b'') (g : B.hom b b') ->
       Id (E.pre.hom (G0 b) (G0 b'')) (G1 b b'' (B.comp b b' b'' g' g))
        (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g))) (\ b ->
     FE.isProp-Pi B.ob (\ b' -> (b'' : B.ob) (g' : B.hom b' b'') (g : B.hom b b') ->
       Id (E.pre.hom (G0 b) (G0 b'')) (G1 b b'' (B.comp b b' b'' g' g))
        (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g))) (\ b' ->
     FE.isProp-Pi B.ob (\ b'' -> (g' : B.hom b' b'') (g : B.hom b b') ->
       Id (E.pre.hom (G0 b) (G0 b'')) (G1 b b'' (B.comp b b' b'' g' g))
        (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g))) (\ b'' ->
     FE.isProp-Pi (B.hom b' b'') (\ g' -> (g : B.hom b b') ->
       Id (E.pre.hom (G0 b) (G0 b'')) (G1 b b'' (B.comp b b' b'' g' g))
        (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g))) (\ g' ->
     FE.isProp-Pi (B.hom b b') (\ g ->
       Id (E.pre.hom (G0 b) (G0 b'')) (G1 b b'' (B.comp b b' b'' g' g))
        (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g))) (\ g ->
      E.pre.hom-set (G0 b) (G0 b'') (G1 b b'' (B.comp b b' b'' g' g))
       (E.pre.comp (G0 b) (G0 b') (G0 b'') (G1 b' b'' g') (G1 b b' g)))))))) ;
  rest-prop (o : Obj) : P.isProp (Rest o) = \ u v ->
   P.Sigma-eq (Maps o.1) (\ G1 -> (L : Laws o.1 G1) * Natural o G1 L) u.1 v.1 u.2 v.2 (maps-eq o u v)
    (P.isProp-Sigma (Laws o.1 v.1) (\ L -> Natural o v.1 L) (laws-prop o.1 v.1)
      (\ L -> FC2.NatTrans[B,E.pre,F,functor o.1 v.1 L].natural-prop (\ b -> AE.arr (o.2 b)))) ;
  s-prop : P.isProp S = P.isProp-Sigma Obj Rest obj-prop rest-prop ;

  total-prop : P.isProp Total = P.retract-prop Total S s r (\ t -> rs t.1 t.2) s-prop ;
 } ;

 univalent : CF.Univalent FunB.pre = CF.FromTotal[FunB.pre, \ F -> Fix[F].total-prop].univalent ;
 category : CF.Category = new CF.Category[FunB.pre, univalent] ;
} ;
