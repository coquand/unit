-- sag/categories: univalent categories as structured 1-types
-- (doc/univalent-categories.tex, DESIGN.md).  Same Theory segment as
-- sag/replacement: univalence and the two parts of replacement; function
-- extensionality is derived from univalence, as in sag/replacement.
import Base ;
import Prelude ;
import Paths ;
import Axioms ;
import FunExtUA ;
import Replacement ;

module Theory
  (univ : [l] Axioms[l].Univalence)
  (images : [l] [k] Replacement[l,k].Images)
  (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
  fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
  import Truncation ;
  import TruncationCombinators ;
  import Equivalences ;
  import Category ;
  import Arrows ;
  import Functor ;
  import FunctorCat ;
  import PrecomposeFF ;
  import Descent ;
  import UniversalProperty ;
  import SmallImage ;
  import CompletionUP ;
} ;
