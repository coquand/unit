-- Functor categories (DESIGN.md §4.1).  B, C : Precategory[k,l],
-- E : Precategory[m,n]; Fun(B,E) has objects in U j and
-- arrows in U j.
--
--  NatTrans: a natural transformation alpha : G -> H is a family of
--   components alpha_b : E(Gb,Hb) with H g o alpha_b = alpha_b' o G g.
--   Naturality is a proposition (hom sets, fe), so two natural
--   transformations are equal when their components are (nat-eq, fe), and
--   Nat(G,H) is a set (a Sigma of a set of families and propositions).
--  FunCat: identity and vertical composite componentwise.  Naturality of
--   the identity: G g o 1 = G g = 1 o G g.  Of beta o alpha:
--   K g o (beta_b o alpha_b) = (K g o beta_b) o alpha_b
--   = (beta_b' o H g) o alpha_b = beta_b' o (H g o alpha_b)
--   = beta_b' o (alpha_b' o G g) = (beta_b' o alpha_b') o G g.
--   The laws hold componentwise (nat-eq).
--  Precompose: for q : C -> B, G o q on objects and arrows; it preserves
--   identities and composites as q and G do.  (q^* alpha)_c = alpha_{qc},
--   natural at f as alpha is at q f.  q^* preserves identities and
--   composites componentwise by definition (nat-eq of refl).
level k l m n j ; open Base ;
constraint k <= j ; constraint l <= j ; constraint m <= j ; constraint n <= j ;
module CB = Category[k,l] ; module CE = Category[m,n] ;
module CF = Category[j,j] ;
module FB = Functor[k,l,m,n] ; module FC = Functor[k,l,k,l] ;
module FF = Functor[j,j,j,j] ;
module P = Prelude[j] ; module Hn = Paths[n] ;
module FE = Axioms[j].FunExtLemmas[fe @j] ;

module NatTrans (B : CB.Precategory) (E : CE.Precategory) (G H : FB.Functor[B,E]) {
 module AE = Arrows[m,n].Arrows[E] ;
 Comp : U j = (b : B.ob) -> E.hom (G.obj b) (H.obj b) ;
 Square (alpha : Comp) (b b' : B.ob) (g : B.hom b b') : U n =
  Id (E.hom (G.obj b) (H.obj b')) (AE.cmp (H.map b b' g) (alpha b)) (AE.cmp (alpha b') (G.map b b' g)) ;
 Natural (alpha : Comp) : U j = (b b' : B.ob) (g : B.hom b b') -> Square alpha b b' g ;
 natural-prop (alpha : Comp) : P.isProp (Natural alpha) =
  FE.isProp-Pi B.ob (\ b -> (b' : B.ob) (g : B.hom b b') -> Square alpha b b' g) (\ b ->
   FE.isProp-Pi B.ob (\ b' -> (g : B.hom b b') -> Square alpha b b' g) (\ b' ->
    FE.isProp-Pi (B.hom b b') (\ g -> Square alpha b b' g) (\ g ->
     E.hom-set (G.obj b) (H.obj b') (AE.cmp (H.map b b' g) (alpha b)) (AE.cmp (alpha b') (G.map b b' g))))) ;
 Nat : U j = (alpha : Comp) * Natural alpha ;
 at (a : Nat) (b : B.ob) : E.hom (G.obj b) (H.obj b) = a.1 b ;
 natural (a : Nat) {b b' : B.ob} (g : B.hom b b') :
  Id (E.hom (G.obj b) (H.obj b')) (AE.cmp (H.map b b' g) (at a b)) (AE.cmp (at a b') (G.map b b' g)) = a.2 b b' g ;
 nat-eq (a a' : Nat) (h : (b : B.ob) -> Id (E.hom (G.obj b) (H.obj b)) (at a b) (at a' b)) : Id Nat a a' =
  P.Sigma-eq Comp Natural a.1 a'.1 a.2 a'.2
   (FE.funext B.ob (\ b -> E.hom (G.obj b) (H.obj b)) a.1 a'.1 h) (natural-prop a'.1) ;
 set : P.isSet Nat =
  P.isSet-Sigma Comp Natural (FE.isSet-Pi B.ob (\ b -> E.hom (G.obj b) (H.obj b)) (\ b -> E.hom-set (G.obj b) (H.obj b)))
   (\ alpha -> P.prop-to-set (Natural alpha) (natural-prop alpha)) ;
} ;

module FunCat (B : CB.Precategory) (E : CE.Precategory) {
 module AE = Arrows[m,n].Arrows[E] ;
 idn (G : FB.Functor[B,E]) : NatTrans[B,E,G,G].Nat =
  (\ b -> E.idn (G.obj b),
   \ b b' g -> Hn.transH (AE.unit-r (G.map b b' g)) (Hn.symH (AE.unit-l (G.map b b' g)))) ;
 comp (G H K : FB.Functor[B,E]) (beta : NatTrans[B,E,H,K].Nat) (alpha : NatTrans[B,E,G,H].Nat) :
  NatTrans[B,E,G,K].Nat =
  (\ b -> AE.cmp (NatTrans[B,E,H,K].at beta b) (NatTrans[B,E,G,H].at alpha b),
   \ b b' g ->
    Hn.transH (AE.assoc (K.map b b' g) (NatTrans[B,E,H,K].at beta b) (NatTrans[B,E,G,H].at alpha b))
     (Hn.transH (AE.right (NatTrans[B,E,H,K].natural beta g) (NatTrans[B,E,G,H].at alpha b))
      (Hn.transH (Hn.symH (AE.assoc (NatTrans[B,E,H,K].at beta b') (H.map b b' g) (NatTrans[B,E,G,H].at alpha b)))
       (Hn.transH (AE.left (NatTrans[B,E,H,K].at beta b') (NatTrans[B,E,G,H].natural alpha g))
        (AE.assoc (NatTrans[B,E,H,K].at beta b') (NatTrans[B,E,G,H].at alpha b') (G.map b b' g)))))) ;
 pre : CF.Precategory = new CF.Precategory[FB.Functor[B,E],
  \ G H -> NatTrans[B,E,G,H].Nat,
  \ G H -> NatTrans[B,E,G,H].set,
  idn,
  comp,
  \ G H alpha -> NatTrans[B,E,G,H].nat-eq (comp G H H (idn H) alpha) alpha
   (\ b -> AE.unit-l (NatTrans[B,E,G,H].at alpha b)),
  \ G H alpha -> NatTrans[B,E,G,H].nat-eq (comp G G H alpha (idn G)) alpha
   (\ b -> AE.unit-r (NatTrans[B,E,G,H].at alpha b)),
  \ F G H K alpha beta gamma -> NatTrans[B,E,F,K].nat-eq
   (comp F H K gamma (comp F G H beta alpha)) (comp F G K (comp G H K gamma beta) alpha)
   (\ b -> AE.assoc (NatTrans[B,E,H,K].at gamma b) (NatTrans[B,E,G,H].at beta b) (NatTrans[B,E,F,G].at alpha b))] ;
} ;

module Precompose (C B : CB.Precategory) (E : CE.Precategory) (q : FC.Functor[C,B]) {
 functor (G : FB.Functor[B,E]) : FB.Functor[C,E] = new FB.Functor[C,E,
  \ c -> G.obj (q.obj c),
  \ c c' f -> G.map (q.obj c) (q.obj c') (q.map c c' f),
  \ c -> Hn.transH
   (P.ap (B.hom (q.obj c) (q.obj c)) (E.hom (G.obj (q.obj c)) (G.obj (q.obj c)))
     (G.map (q.obj c) (q.obj c)) (q.map c c (C.idn c)) (B.idn (q.obj c)) (q.map-idn c))
   (G.map-idn (q.obj c)),
  \ c c' c'' g f -> Hn.transH
   (P.ap (B.hom (q.obj c) (q.obj c'')) (E.hom (G.obj (q.obj c)) (G.obj (q.obj c'')))
     (G.map (q.obj c) (q.obj c'')) (q.map c c'' (C.comp c c' c'' g f))
     (B.comp (q.obj c) (q.obj c') (q.obj c'') (q.map c' c'' g) (q.map c c' f)) (q.map-comp c c' c'' g f))
   (G.map-comp (q.obj c) (q.obj c') (q.obj c'') (q.map c' c'' g) (q.map c c' f))] ;
 nat (G H : FB.Functor[B,E]) (alpha : NatTrans[B,E,G,H].Nat) : NatTrans[C,E,functor G,functor H].Nat =
  (\ c -> NatTrans[B,E,G,H].at alpha (q.obj c),
   \ c c' f -> NatTrans[B,E,G,H].natural alpha (q.map c c' f)) ;
 star : FF.Functor[FunCat[B,E].pre, FunCat[C,E].pre] = new FF.Functor[FunCat[B,E].pre, FunCat[C,E].pre,
  functor,
  nat,
  \ G -> NatTrans[C,E,functor G,functor G].nat-eq (nat G G (FunCat[B,E].idn G)) (FunCat[C,E].idn (functor G))
   (\ c -> refl (E.idn (G.obj (q.obj c)))),
  \ G H K beta alpha -> NatTrans[C,E,functor G,functor K].nat-eq
   (nat G K (FunCat[B,E].comp G H K beta alpha))
   (FunCat[C,E].comp (functor G) (functor H) (functor K) (nat H K beta) (nat G H alpha))
   (\ c -> refl (NatTrans[C,E,functor G,functor K].at (nat G K (FunCat[B,E].comp G H K beta alpha)) c))] ;
} ;
