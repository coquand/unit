-- Instance 4.5 (DESIGN.md §4.5): the universal property of the small full
-- image.  D : Category[k,l], F : A -> D.ob with A : U l, D_F the small full
-- image (SmallImage), i its inclusion.
--  C_F: objects A, arrows C_F(a,b) = D(Fa,Fb), the rest from D.
--  t_a = idtoiso of the triangle : Iso_D(i q a, F a).
--  q : C_F -> D_F is the quotient on objects and conjugation on arrows,
--   q h = t_b^-1 o (h o t_a).  q 1 = t_a^-1 o (1 o t_a) = t_a^-1 o t_a = 1.
--   q (g o h) = t_c^-1 o ((g o h) o t_a) = t_c^-1 o (g o (h o t_a))
--   = t_c^-1 o (g o (t_b o (t_b^-1 o (h o t_a))))
--   = t_c^-1 o ((g o t_b) o (t_b^-1 o (h o t_a))) = q g o q h.
--  fully faithful: the inverse is h' |-> t_b o (h' o t_a^-1); the two
--   composites are the identity by undo-l / undo-r.
--  essentially surjective: from generated (SmallImage, 1.), an iso
--   e : F p ~ i a gives e o t_p : i q p ~ i a.
--  Then q^* : Fun(D_F,E) -> Fun(C_F,E) is fully faithful and split
--   essentially surjective for every category E (Theorem 4.4).
--  Both functor categories are categories (DESIGN.md §4.7, D_F and C_F
--   only as precategories), so q^* on objects, G |-> G o q, is an
--   equivalence of types Fun(D_F,E) ~ Fun(C_F,E) (§4.8, §4.9).
level k l m n j ; open Base ;
constraint l <= j ; constraint m <= j ; constraint n <= j ;
module CD = Category[k,l] ; module CS = Category[l,l] ; module CE = Category[m,n] ;
module FS = Functor[l,l,l,l] ;
module H = Paths[l] ;

module Instance (D : CD.Category) (A : U l) (F : A -> D.pre.ob) {
 module AD = Arrows[k,l].Arrows[D.pre] ;
 module SFI = SmallImage[k,l].SmallFullImage[D,A,F] ;

 pre : CS.Precategory = new CS.Precategory[A,
  \ a b -> D.pre.hom (F a) (F b),
  \ a b -> D.pre.hom-set (F a) (F b),
  \ a -> D.pre.idn (F a),
  \ a b c -> D.pre.comp (F a) (F b) (F c),
  \ a b -> D.pre.unit-l (F a) (F b),
  \ a b -> D.pre.unit-r (F a) (F b),
  \ w a b c -> D.pre.assoc (F w) (F a) (F b) (F c)] ;

 t (a : A) : D.pre.Iso (SFI.image.inclusion (SFI.image.quotient a)) (F a) =
  D.pre.idtoiso (SFI.image.inclusion (SFI.image.quotient a)) (F a) (SFI.image.triangle a) ;

 conj (a b : A) (h : D.pre.hom (F a) (F b)) : D.pre.hom (SFI.image.inclusion (SFI.image.quotient a)) (SFI.image.inclusion (SFI.image.quotient b)) =
  AD.cmp (AD.inv (t b)) (AD.cmp h (AD.arr (t a))) ;
 conj-idn (a : A) : Id (D.pre.hom (SFI.image.inclusion (SFI.image.quotient a)) (SFI.image.inclusion (SFI.image.quotient a)))
  (conj a a (D.pre.idn (F a))) (D.pre.idn (SFI.image.inclusion (SFI.image.quotient a))) =
  H.transH (AD.left (AD.inv (t a)) (AD.unit-l (AD.arr (t a)))) (AD.inv-arr (t a)) ;
 conj-comp (a b c : A) (g : D.pre.hom (F b) (F c)) (h : D.pre.hom (F a) (F b)) :
  Id (D.pre.hom (SFI.image.inclusion (SFI.image.quotient a)) (SFI.image.inclusion (SFI.image.quotient c))) (conj a c (AD.cmp g h))
   (AD.cmp (conj b c g) (conj a b h)) =
  H.transH (AD.left (AD.inv (t c)) (H.symH (AD.assoc g h (AD.arr (t a)))))
  (H.transH (AD.left (AD.inv (t c)) (AD.left g (H.symH (AD.undo-l (AD.iso-inv (t b)) (AD.cmp h (AD.arr (t a)))))))
  (H.transH (AD.left (AD.inv (t c)) (AD.assoc g (AD.arr (t b)) (conj a b h)))
   (AD.assoc (AD.inv (t c)) (AD.cmp g (AD.arr (t b))) (conj a b h)))) ;
 q : FS.Functor[pre, SFI.pre] = new FS.Functor[pre, SFI.pre, SFI.image.quotient, conj, conj-idn, conj-comp] ;

 unconj (a b : A) (h : D.pre.hom (SFI.image.inclusion (SFI.image.quotient a)) (SFI.image.inclusion (SFI.image.quotient b))) : D.pre.hom (F a) (F b) =
  AD.cmp (AD.arr (t b)) (AD.cmp h (AD.inv (t a))) ;
 conj-unconj (a b : A) (h : D.pre.hom (SFI.image.inclusion (SFI.image.quotient a)) (SFI.image.inclusion (SFI.image.quotient b))) :
  Id (D.pre.hom (SFI.image.inclusion (SFI.image.quotient a)) (SFI.image.inclusion (SFI.image.quotient b))) (conj a b (unconj a b h)) h =
  H.transH (AD.left (AD.inv (t b))
    (H.transH (H.symH (AD.assoc (AD.arr (t b)) (AD.cmp h (AD.inv (t a))) (AD.arr (t a))))
      (AD.left (AD.arr (t b)) (AD.undo-r h (AD.iso-inv (t a))))))
   (AD.undo-l (t b) h) ;
 unconj-conj (a b : A) (h : D.pre.hom (F a) (F b)) : Id (D.pre.hom (F a) (F b)) (unconj a b (conj a b h)) h =
  H.transH (AD.left (AD.arr (t b))
    (H.transH (H.symH (AD.assoc (AD.inv (t b)) (AD.cmp h (AD.arr (t a))) (AD.inv (t a))))
      (AD.left (AD.inv (t b)) (AD.undo-r h (t a)))))
   (AD.undo-l (AD.iso-inv (t b)) h) ;
 fully-faithful : FS.FullyFaithful pre SFI.pre q = \ a b ->
  Prelude[l].qinv (pre.hom a b) (SFI.pre.hom (SFI.image.quotient a) (SFI.image.quotient b)) (conj a b) (unconj a b)
   (conj-unconj a b) (unconj-conj a b) ;
 ess-surj : FS.EssSurj pre SFI.pre q = \ d ->
  TruncationCombinators[l].map ((p : A) * D.pre.Iso (F p) (SFI.image.inclusion d))
   ((p : A) * SFI.pre.Iso (SFI.image.quotient p) d)
   (\ w -> (w.1, AD.iso-cmp w.2 (t w.1)))
   (SFI.generated d) ;

 -- for every category E, q^* : Fun(D_F,E) -> Fun(C_F,E) is fully faithful
 -- and split essentially surjective
 module ForEvery (E : CE.Category) {
  module T = UniversalProperty[l,l,m,n,j].Theorem[pre, SFI.pre, E, q, fully-faithful, ess-surj] ;
  star-fully-faithful : Functor[j,j,j,j].FullyFaithful
   FunctorCat[l,l,m,n,j].FunCat[SFI.pre,E.pre].pre FunctorCat[l,l,m,n,j].FunCat[pre,E.pre].pre T.Q.star = T.fully-faithful ;
  star-split-ess-surj : Functor[j,j,j,j].SplitEssSurj
   FunctorCat[l,l,m,n,j].FunCat[SFI.pre,E.pre].pre FunctorCat[l,l,m,n,j].FunCat[pre,E.pre].pre T.Q.star = T.split-ess-surj ;
  -- the functor categories are categories, and q^* is an equivalence of
  -- object types
  fun-D : Category[j,j].Category = FunctorUnivalence[l,l,m,n,j].Univalence[SFI.pre,E].category ;
  fun-C : Category[j,j].Category = FunctorUnivalence[l,l,m,n,j].Univalence[pre,E].category ;
  equiv : Prelude[j].isEquiv (Functor[l,l,m,n].Functor[SFI.pre,E.pre]) (Functor[l,l,m,n].Functor[pre,E.pre]) T.Q.functor =
   EquivObjects[j,j,j,j,j].Corollary[fun-D, fun-C, T.Q.star, star-fully-faithful, star-split-ess-surj].equiv ;
 } ;
} ;
