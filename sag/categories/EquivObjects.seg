-- Corollary (DESIGN.md §4.8): a fully faithful, split essentially
-- surjective functor P : X -> Y between categories is an equivalence on
-- object types.  S y = (x : X) * Iso_Y(P x, y), Fib y = (x : X) * (P x = y).
--
--  along: for p : x = x' and e : Iso_Y(P x', y), (x, e o P (idtoiso p)) =
--   (x', e), by J on p; at refl, e o P 1 = e o 1 = e (iso-eq).
--  lifted: for (x, e), (x', e') in S y, the iso phi of X lifting
--   e'^-1 o e (reflect-iso), so e' o P phi = e (lifted-eq, by lift-eq).
--  S-prop: (x, e) = (x, e' o P phi)                       (lifted-eq)
--                 = (x, e' o P (idtoiso (isotoid phi)))  (univalence of X)
--                 = (x', e')                             (along).
--  Fib-prop: Fib y is a retract of S y (idtoiso, isotoid; sec-ret of the
--   univalence of Y).  point: (c_y, isotoid e_y), from the splitting.
--  equiv: the section y |-> c_y, with P c_y = y; it is also a retraction,
--   the point of Fib (P x) being (x, refl) (Fib-prop).
level k1 l1 k2 l2 j ; open Base ;
constraint k1 <= j ; constraint l1 <= j ; constraint k2 <= j ; constraint l2 <= j ;
module C1 = Category[k1,l1] ; module C2 = Category[k2,l2] ;
module F12 = Functor[k1,l1,k2,l2] ;
module P = Prelude[j] ; module H2 = Paths[l2] ;

module Corollary (X : C1.Category) (Y : C2.Category) (Pf : F12.Functor[X.pre, Y.pre])
  (ff : F12.FullyFaithful X.pre Y.pre Pf) (se : F12.SplitEssSurj X.pre Y.pre Pf) {
 module AY = Arrows[k2,l2].Arrows[Y.pre] ;
 module MP = F12.Maps[X.pre,Y.pre,Pf] ;
 module L = F12.Faithful[X.pre,Y.pre,Pf,ff] ;

 S (y : Y.pre.ob) : U j = (x : X.pre.ob) * Y.pre.Iso (Pf.obj x) y ;
 Fib (y : Y.pre.ob) : U j = (x : X.pre.ob) * Id Y.pre.ob (Pf.obj x) y ;

 along (y : Y.pre.ob) (x x' : X.pre.ob) (p : Id X.pre.ob x x') :
  (e : Y.pre.Iso (Pf.obj x') y) -> Id (S y) (x, AY.iso-cmp e (MP.map-iso (X.pre.idtoiso x x' p))) (x', e) =
  idJ X.pre.ob x
   (\ x1 p1 -> (e : Y.pre.Iso (Pf.obj x1) y) -> Id (S y) (x, AY.iso-cmp e (MP.map-iso (X.pre.idtoiso x x1 p1))) (x1, e))
   (\ e -> P.ap (Y.pre.Iso (Pf.obj x) y) (S y) (\ e1 -> (x, e1)) (AY.iso-cmp e (MP.map-iso (X.pre.iso-id x))) e
     (AY.iso-eq (AY.iso-cmp e (MP.map-iso (X.pre.iso-id x))) e
       (H2.transH (AY.left (AY.arr e) (Pf.map-idn x)) (AY.unit-r (AY.arr e)))))
   x' p ;

 lifted (y : Y.pre.ob) (u v : S y) : X.pre.Iso u.1 v.1 = L.reflect-iso (AY.iso-cmp (AY.iso-inv v.2) u.2) ;
 -- by definition the arrow of lifted is lift v.2 (arr u.2)
 lifted-eq (y : Y.pre.ob) (u v : S y) :
  Id (Y.pre.hom (Pf.obj u.1) y) (AY.cmp (AY.arr v.2) (Pf.map u.1 v.1 (Arrows[k1,l1].Arrows[X.pre].arr (lifted y u v)))) (AY.arr u.2) =
  L.lift-eq v.2 (AY.arr u.2) ;

 S-prop (y : Y.pre.ob) : P.isProp (S y) = \ u v ->
  calc (S y) {
   u
    =< P.ap (Y.pre.Iso (Pf.obj u.1) y) (S y) (\ e1 -> (u.1, e1)) u.2 (AY.iso-cmp v.2 (MP.map-iso (lifted y u v)))
        (AY.iso-eq u.2 (AY.iso-cmp v.2 (MP.map-iso (lifted y u v))) (H2.symH (lifted-eq y u v))) >
   (u.1, AY.iso-cmp v.2 (MP.map-iso (lifted y u v)))
    =< P.ap (X.pre.Iso u.1 v.1) (S y) (\ phi -> (u.1, AY.iso-cmp v.2 (MP.map-iso phi)))
        (lifted y u v) (X.pre.idtoiso u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v)))
        (P.sym (X.pre.Iso u.1 v.1) (X.pre.idtoiso u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v))) (lifted y u v)
          ((X.univalent u.1 v.1).sec-eq (lifted y u v))) >
   (u.1, AY.iso-cmp v.2 (MP.map-iso (X.pre.idtoiso u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v)))))
    =< along y u.1 v.1 (X.isotoid u.1 v.1 (lifted y u v)) v.2 >
   v } ;

 Fib-prop (y : Y.pre.ob) : P.isProp (Fib y) =
  P.retract-prop (Fib y) (S y)
   (\ w -> (w.1, Y.pre.idtoiso (Pf.obj w.1) y w.2)) (\ w -> (w.1, Y.isotoid (Pf.obj w.1) y w.2))
   (\ w -> P.ap (Id Y.pre.ob (Pf.obj w.1) y) (Fib y) (\ q -> (w.1, q))
     (Y.isotoid (Pf.obj w.1) y (Y.pre.idtoiso (Pf.obj w.1) y w.2)) w.2
     (Prelude[k2 \/ l2].sec-ret (Id Y.pre.ob (Pf.obj w.1) y) (Y.pre.Iso (Pf.obj w.1) y)
       (Y.pre.idtoiso (Pf.obj w.1) y) (Y.univalent (Pf.obj w.1) y) w.2))
   (S-prop y) ;

 point (y : Y.pre.ob) : Fib y = ((se y).1, Y.isotoid (Pf.obj (se y).1) y (se y).2) ;

 equiv : P.isEquiv X.pre.ob Y.pre.ob Pf.obj =
  P.qinv X.pre.ob Y.pre.ob Pf.obj (\ y -> (point y).1) (\ y -> (point y).2)
   (\ x -> P.ap (Fib (Pf.obj x)) X.pre.ob (\ w -> w.1) (point (Pf.obj x)) (x, refl (Pf.obj x))
     (Fib-prop (Pf.obj x) (point (Pf.obj x)) (x, refl (Pf.obj x)))) ;
} ;
