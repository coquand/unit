-- Equivalences (bi-invertible maps, Prelude.isEquiv) used by the
-- categories: the inverse of an equivalence is one (its section, with
-- sec-eq and sec-ret); composites of equivalences are equivalences; a map
-- pointwise equal to an equivalence is one.  Conjugation: for paths
-- u : x = x' and v : y = y' in A, (x = y) ~ (x' = y'), by J on u and v,
-- the identity at refl.  An equivalence of small types stated at a higher
-- level is one at the small level (lower).
level l ; open Base ; open Prelude[l] ;

inverse (A B : U l) (e : Equiv A B) : Equiv B A =
 (e.2.sec, qinv B A e.2.sec e.1 (sec-ret A B e.1 e.2) e.2.sec-eq) ;

compose (A B C : U l) (g : B -> C) (f : A -> B) (eg : isEquiv B C g) (ef : isEquiv A B f) :
 isEquiv A C (\ a -> g (f a)) =
 struct { sec = \ c -> ef.sec (eg.sec c) ;
          sec-eq = \ c -> trans C (g (f (ef.sec (eg.sec c)))) (g (eg.sec c)) c
                           (ap B C g (f (ef.sec (eg.sec c))) (eg.sec c) (ef.sec-eq (eg.sec c))) (eg.sec-eq c) ;
          ret = \ c -> ef.ret (eg.ret c) ;
          ret-eq = \ a -> trans A (ef.ret (eg.ret (g (f a)))) (ef.ret (f a)) a
                           (ap B A ef.ret (eg.ret (g (f a))) (f a) (eg.ret-eq (f a))) (ef.ret-eq a) } ;

homotopy (A B : U l) (f g : A -> B) (h : (a : A) -> Id B (f a) (g a)) (ef : isEquiv A B f) :
 isEquiv A B g =
 struct { sec = ef.sec ;
          sec-eq = \ b -> trans B (g (ef.sec b)) (f (ef.sec b)) b (sym B (f (ef.sec b)) (g (ef.sec b)) (h (ef.sec b))) (ef.sec-eq b) ;
          ret = ef.ret ;
          ret-eq = \ a -> trans A (ef.ret (g a)) (ef.ret (f a)) a
                           (ap B A ef.ret (g a) (f a) (sym B (f a) (g a) (h a))) (ef.ret-eq a) } ;

-- composite of two equivalences, as an element of Equiv
then (A B C : U l) (f : Equiv A B) (g : Equiv B C) : Equiv A C =
 (\ a -> g.1 (f.1 a), compose A B C g.1 f.1 g.2 f.2) ;

conjugate (A : U l) (x x' y y' : A) (u : Id A x x') (v : Id A y y') : Equiv (Id A x y) (Id A x' y') =
 idJ A x (\ x1 u1 -> Equiv (Id A x y) (Id A x1 y'))
  (idJ A y (\ y1 v1 -> Equiv (Id A x y) (Id A x y1)) (idEquiv (Id A x y)) y' v) x' u ;

-- an equivalence of types in U l, given at a higher level, is one at
-- level l: the same four components
lower : [m] (A B : U l) (f : A -> B) -> Prelude[l \/ m].isEquiv A B f -> isEquiv A B f =
 <m> \ A B f e -> struct { sec = e.sec ; sec-eq = e.sec-eq ; ret = e.ret ; ret-eq = e.ret-eq } ;
