-- Lemma B (DESIGN.md §4.3): descent of functors.  q : C -> B fully
-- faithful and essentially surjective, E a category, G : C -> E.  There
-- are H : B -> E and a natural iso H o q ~ G.
--
--  Squares b b' y V S T: for all c, c' : C, f : C(c,c'), e : Iso_B(qc,b),
--   e' : Iso_B(qc',b'), e' o q f = V c e implies S = T in E(Gc,y); a
--   proposition (hom sets, fe).
--  X_b = (x : E) * (h : (c : C) -> Iso_B(qc,b) -> Iso_E(Gc,x)) * Compat,
--   Compat: e' o q f = e implies h c' e' o G f = h c e.
--  Singl x0 = (x : E) * Iso_E(x0,x) is a proposition: a retract of the
--   based path space (x, isotoid), (x, idtoiso), by univalence of E.
--  At b c0 e0 (a generator (c0, e0) of b): out (x, h, k) = (x, h c0 e0);
--   into (x, phi) has h c e = phi o G f_e, f_e the iso of C lifting
--   e0^-1 o e (reflect-iso), so e0 o q f_e = e (lifted-eq).  Compat of
--   into: from e' o q f = e, e0 o q (f_e' o f) = e (paste1), so
--   f_e' o f = f_e (unique) and (phi o G f_e') o G f = phi o G (f_e' o f)
--   = phi o G f_e.  into (out (x, h, k)) = (x, h, k): Compat at
--   (c, c0, f_e, e, e0) is h c0 e0 o G f_e = h c e; Compat is a
--   proposition.
--  X-prop: X_b is a retract of Singl (G c0) for a merely chosen (c0, e0).
--  X-inh: X_b is a proposition, so merely pick (c0, e0) and take
--   into (G c0, 1).  H b, eta b are its first two components.
--  Y_g = (phi : E(Hb,Hb')) * Squares at phi: e' o q f = g o e implies
--   phi o eta_b c e = eta_b' c' e' o G f.
--  Y-prop: merely pick (c, e), (c', e') and f = lift e' (g o e); then
--   phi o eta_b c e = eta_b' c' e' o G f = phi' o eta_b c e; cancel.
--  Y-inh: merely pick (c, e), (c', e'); phi0 = (eta_b' c' e' o G f0) o
--   (eta_b c e)^-1, f0 = lift e' (g o e).  For (d, d', f, u, u') with
--   u' o q f = g o u: m = lift e u, m' = lift e' u', so
--   eta_b c e o G m = eta_b d u and eta_b' c' e' o G m' = eta_b' d' u'
--   (Compat), and f0 o m = m' o f (both are lifts of g o u along e':
--   paste, paste1, unique).  Then phi0 o eta_b d u
--   = phi0 o (eta_b c e o G m) = (phi0 o eta_b c e) o G m
--   = (eta_b' c' e' o G f0) o G m = eta_b' c' e' o (G f0 o G m)
--   = eta_b' c' e' o G (f0 o m) = eta_b' c' e' o G (m' o f)
--   = eta_b' c' e' o (G m' o G f) = (eta_b' c' e' o G m') o G f
--   = eta_b' d' u' o G f.
--  H g is the first component.  H 1 = 1: 1 satisfies the squares at 1
--   (1 o eta_b c e = eta_b c e = eta_b c' e' o G f by Compat).
--  H (g' o g) = H g' o H g: the composite satisfies the squares at g' o g;
--   merely pick (c', e') for b'; f1 = lift e' (g o e), f2 = lift e''
--   (g' o e'), f2 o f1 = f (paste, unique), and
--   (H g' o H g) o eta = H g' o (H g o eta) = H g' o (eta' o G f1)
--   = (H g' o eta') o G f1 = (eta'' o G f2) o G f1 = eta'' o (G f2 o G f1)
--   = eta'' o G (f2 o f1) = eta'' o G f.
--  unit: eta_qc c 1 : G c -> H q c is natural (the square of H (q f) at
--   (c, c', f, 1, 1)); its inverse counit is natural (square-inv); they
--   form an iso of Fun(C,E), componentwise.
level k l m n j ; open Base ;
constraint k <= j ; constraint l <= j ; constraint m <= j ; constraint n <= j ;
module CB = Category[k,l] ; module CE = Category[m,n] ;
module FB = Functor[k,l,m,n] ; module FC = Functor[k,l,k,l] ;
module FC2 = FunctorCat[k,l,m,n,j] ;
module P = Prelude[j] ; module Hn = Paths[n] ;
module FE = Axioms[j].FunExtLemmas[fe @j] ;

module LemmaB (C B : CB.Precategory) (E : CE.Category) (q : FC.Functor[C,B])
  (ff : FC.FullyFaithful C B q) (es : FC.EssSurj C B q) (G : FB.Functor[C,E.pre]) {
 module AB = Arrows[k,l].Arrows[B] ; module AC = Arrows[k,l].Arrows[C] ;
 module AE = Arrows[m,n].Arrows[E.pre] ;
 module L = FC.Faithful[C,B,q,ff] ; module MG = FB.Maps[C,E.pre,G] ;
 module Tr = Truncation[k \/ l] ;

 Squares (b b' : B.ob) (y : E.pre.ob) (V : (c : C.ob) -> B.Iso (q.obj c) b -> B.hom (q.obj c) b')
  (S T : (c c' : C.ob) -> C.hom c c' -> B.Iso (q.obj c) b -> B.Iso (q.obj c') b' -> E.pre.hom (G.obj c) y) :
  U j =
  (c c' : C.ob) (f : C.hom c c') (e : B.Iso (q.obj c) b) (e' : B.Iso (q.obj c') b') ->
   Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e) ->
   Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e') ;
 squares-prop (b b' : B.ob) (y : E.pre.ob) (V : (c : C.ob) -> B.Iso (q.obj c) b -> B.hom (q.obj c) b')
  (S T : (c c' : C.ob) -> C.hom c c' -> B.Iso (q.obj c) b -> B.Iso (q.obj c') b' -> E.pre.hom (G.obj c) y) :
  P.isProp (Squares b b' y V S T) =
  FE.isProp-Pi C.ob (\ c -> (c' : C.ob) (f : C.hom c c') (e : B.Iso (q.obj c) b) (e' : B.Iso (q.obj c') b') ->
    Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e) ->
    Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e')) (\ c ->
  FE.isProp-Pi C.ob (\ c' -> (f : C.hom c c') (e : B.Iso (q.obj c) b) (e' : B.Iso (q.obj c') b') ->
    Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e) ->
    Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e')) (\ c' ->
  FE.isProp-Pi (C.hom c c') (\ f -> (e : B.Iso (q.obj c) b) (e' : B.Iso (q.obj c') b') ->
    Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e) ->
    Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e')) (\ f ->
  FE.isProp-Pi (B.Iso (q.obj c) b) (\ e -> (e' : B.Iso (q.obj c') b') ->
    Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e) ->
    Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e')) (\ e ->
  FE.isProp-Pi (B.Iso (q.obj c') b') (\ e' ->
    Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e) ->
    Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e')) (\ e' ->
  FE.isProp-Pi (Id (B.hom (q.obj c) b') (AB.cmp (AB.arr e') (q.map c c' f)) (V c e))
   (\ w -> Id (E.pre.hom (G.obj c) y) (S c c' f e e') (T c c' f e e')) (\ w ->
   E.pre.hom-set (G.obj c) y (S c c' f e e') (T c c' f e e'))))))) ;

 -- objects
 Legs (b : B.ob) (x : E.pre.ob) : U j = (c : C.ob) -> B.Iso (q.obj c) b -> E.pre.Iso (G.obj c) x ;
 Compat (b : B.ob) (x : E.pre.ob) (h : Legs b x) : U j =
  Squares b b x (\ c e -> AB.arr e)
   (\ c c' f e e' -> AE.cmp (AE.arr (h c' e')) (G.map c c' f)) (\ c c' f e e' -> AE.arr (h c e)) ;
 Cocone (b : B.ob) (x : E.pre.ob) : U j = (h : Legs b x) * Compat b x h ;
 X (b : B.ob) : U j = (x : E.pre.ob) * Cocone b x ;

 Singl (x0 : E.pre.ob) : U j = (x : E.pre.ob) * E.pre.Iso x0 x ;
 PathSp (x0 : E.pre.ob) : U m = (x : E.pre.ob) * Id E.pre.ob x0 x ;
 path-centre (x0 : E.pre.ob) (u : PathSp x0) : Id (PathSp x0) (x0, refl x0) u =
  idJ E.pre.ob x0 (\ y p -> Id (PathSp x0) (x0, refl x0) (y, p)) (refl (x0, refl x0)) u.1 u.2 ;
 path-prop (x0 : E.pre.ob) : P.isProp (PathSp x0) = \ u v ->
  P.trans (PathSp x0) u (x0, refl x0) v (P.sym (PathSp x0) (x0, refl x0) u (path-centre x0 u)) (path-centre x0 v) ;
 singl-prop (x0 : E.pre.ob) : P.isProp (Singl x0) =
  P.retract-prop (Singl x0) (PathSp x0)
   (\ s -> (s.1, E.isotoid x0 s.1 s.2)) (\ p -> (p.1, E.pre.idtoiso x0 p.1 p.2))
   (\ s -> P.ap (E.pre.Iso x0 s.1) (Singl x0) (\ i -> (s.1, i))
     (E.pre.idtoiso x0 s.1 (E.isotoid x0 s.1 s.2)) s.2 ((E.univalent x0 s.1).sec-eq s.2))
   (path-prop x0) ;

 module At (b : B.ob) (c0 : C.ob) (e0 : B.Iso (q.obj c0) b) {
  lifted (c : C.ob) (e : B.Iso (q.obj c) b) : C.Iso c c0 = L.reflect-iso (AB.iso-cmp (AB.iso-inv e0) e) ;
  -- by definition the arrow of lifted is lift e0 e
  lifted-eq (c : C.ob) (e : B.Iso (q.obj c) b) :
   Id (B.hom (q.obj c) b) (AB.cmp (AB.arr e0) (q.map c c0 (AC.arr (lifted c e)))) (AB.arr e) =
   L.lift-eq e0 (AB.arr e) ;
  out (xi : X b) : Singl (G.obj c0) = (xi.1, xi.2.1 c0 e0) ;
  legs (s : Singl (G.obj c0)) : Legs b s.1 = \ c e -> AE.iso-cmp s.2 (MG.map-iso (lifted c e)) ;
  compat (s : Singl (G.obj c0)) : Compat b s.1 (legs s) = \ c c' f e e' w ->
   Hn.transH (Hn.symH (AE.assoc (AE.arr s.2) (G.map c' c0 (AC.arr (lifted c' e'))) (G.map c c' f)))
   (Hn.transH (AE.left (AE.arr s.2) (Hn.symH (MG.map-cmp (AC.arr (lifted c' e')) f)))
    (AE.left (AE.arr s.2) (MG.map-eq (L.unique e0 (L.paste1 (lifted-eq c' e') w) (lifted-eq c e))))) ;
  into (s : Singl (G.obj c0)) : X b = (s.1, legs s, compat s) ;
  legs-out (xi : X b) : Id (Legs b xi.1) (legs (out xi)) xi.2.1 =
   FE.funext C.ob (\ c -> B.Iso (q.obj c) b -> E.pre.Iso (G.obj c) xi.1) (legs (out xi)) xi.2.1 (\ c ->
    FE.funext (B.Iso (q.obj c) b) (\ e -> E.pre.Iso (G.obj c) xi.1) (legs (out xi) c) (xi.2.1 c) (\ e ->
     AE.iso-eq (legs (out xi) c e) (xi.2.1 c e) (xi.2.2 c c0 (AC.arr (lifted c e)) e e0 (lifted-eq c e)))) ;
  into-out (xi : X b) : Id (X b) (into (out xi)) xi =
   P.ap (Cocone b xi.1) (X b) (\ y -> (xi.1, y)) (legs (out xi), compat (out xi)) xi.2
    (P.Sigma-eq (Legs b xi.1) (\ h -> Compat b xi.1 h) (legs (out xi)) xi.2.1 (compat (out xi)) xi.2.2
     (legs-out xi)
     (squares-prop b b xi.1 (\ c e -> AB.arr e)
       (\ c c' f e e' -> AE.cmp (AE.arr (xi.2.1 c' e')) (G.map c c' f)) (\ c c' f e e' -> AE.arr (xi.2.1 c e)))) ;
 } ;

 X-prop (b : B.ob) : P.isProp (X b) =
  Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @j (\ t -> P.isProp (X b))
   (\ t -> FE.isProp-isProp (X b))
   (\ w -> P.retract-prop (X b) (Singl (G.obj w.1)) At[b,w.1,w.2].out At[b,w.1,w.2].into
     At[b,w.1,w.2].into-out (singl-prop (G.obj w.1)))
   (es b) ;
 X-inh (b : B.ob) : X b =
  Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @j (\ t -> X b) (\ t -> X-prop b)
   (\ w -> At[b,w.1,w.2].into (G.obj w.1, E.pre.iso-id (G.obj w.1)))
   (es b) ;

 obj (b : B.ob) : E.pre.ob = (X-inh b).1 ;
 eta (b : B.ob) : Legs b (obj b) = (X-inh b).2.1 ;
 eta-compat (b : B.ob) : Compat b (obj b) (eta b) = (X-inh b).2.2 ;

 -- arrows
 Sqs (b b' : B.ob) (g : B.hom b b') (phi : E.pre.hom (obj b) (obj b')) : U j =
  Squares b b' (obj b') (\ c e -> AB.cmp g (AB.arr e))
   (\ c c' f e e' -> AE.cmp phi (AE.arr (eta b c e))) (\ c c' f e e' -> AE.cmp (AE.arr (eta b' c' e')) (G.map c c' f)) ;
 Y (b b' : B.ob) (g : B.hom b b') : U j = (phi : E.pre.hom (obj b) (obj b')) * Sqs b b' g phi ;

 phi-eq (b b' : B.ob) (g : B.hom b b') (y y' : Y b b' g) : Id (E.pre.hom (obj b) (obj b')) y.1 y'.1 =
  Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @n (\ t -> Id (E.pre.hom (obj b) (obj b')) y.1 y'.1)
   (\ t -> E.pre.hom-set (obj b) (obj b') y.1 y'.1)
   (\ w -> Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b'].induction @n (\ t -> Id (E.pre.hom (obj b) (obj b')) y.1 y'.1)
     (\ t -> E.pre.hom-set (obj b) (obj b') y.1 y'.1)
     (\ w' -> AE.cancel-r (eta b w.1 w.2)
       (Hn.transH (y.2 w.1 w'.1 (L.lift w'.2 (AB.cmp g (AB.arr w.2))) w.2 w'.2 (L.lift-eq w'.2 (AB.cmp g (AB.arr w.2))))
        (Hn.symH (y'.2 w.1 w'.1 (L.lift w'.2 (AB.cmp g (AB.arr w.2))) w.2 w'.2 (L.lift-eq w'.2 (AB.cmp g (AB.arr w.2)))))))
     (es b'))
   (es b) ;
 Y-prop (b b' : B.ob) (g : B.hom b b') : P.isProp (Y b b' g) = \ y y' ->
  P.Sigma-eq (E.pre.hom (obj b) (obj b')) (\ phi -> Sqs b b' g phi) y.1 y'.1 y.2 y'.2 (phi-eq b b' g y y')
   (squares-prop b b' (obj b') (\ c e -> AB.cmp g (AB.arr e))
     (\ c c' f e e' -> AE.cmp y'.1 (AE.arr (eta b c e))) (\ c c' f e e' -> AE.cmp (AE.arr (eta b' c' e')) (G.map c c' f))) ;

 module Pair (b b' : B.ob) (g : B.hom b b') (c : C.ob) (e : B.Iso (q.obj c) b) (c' : C.ob) (e' : B.Iso (q.obj c') b') {
  f0 : C.hom c c' = L.lift e' (AB.cmp g (AB.arr e)) ;
  phi0 : E.pre.hom (obj b) (obj b') =
   AE.cmp (AE.cmp (AE.arr (eta b' c' e')) (G.map c c' f0)) (AE.inv (eta b c e)) ;
  square (d d' : C.ob) (f : C.hom d d') (u : B.Iso (q.obj d) b) (u' : B.Iso (q.obj d') b')
   (w : Id (B.hom (q.obj d) b') (AB.cmp (AB.arr u') (q.map d d' f)) (AB.cmp g (AB.arr u))) :
   Id (E.pre.hom (G.obj d) (obj b')) (AE.cmp phi0 (AE.arr (eta b d u))) (AE.cmp (AE.arr (eta b' d' u')) (G.map d d' f)) =
   Hn.transH (AE.left phi0 (Hn.symH (eta-compat b d c (L.lift e (AB.arr u)) u e (L.lift-eq e (AB.arr u)))))
   (Hn.transH (AE.assoc phi0 (AE.arr (eta b c e)) (G.map d c (L.lift e (AB.arr u))))
   (Hn.transH (AE.right (AE.undo-r (AE.cmp (AE.arr (eta b' c' e')) (G.map c c' f0)) (AE.iso-inv (eta b c e)))
                (G.map d c (L.lift e (AB.arr u))))
   (Hn.transH (Hn.symH (AE.assoc (AE.arr (eta b' c' e')) (G.map c c' f0) (G.map d c (L.lift e (AB.arr u)))))
   (Hn.transH (AE.left (AE.arr (eta b' c' e')) (Hn.symH (MG.map-cmp f0 (L.lift e (AB.arr u)))))
   (Hn.transH (AE.left (AE.arr (eta b' c' e'))
                (MG.map-eq (L.unique e'
                  (L.paste (L.lift-eq e' (AB.cmp g (AB.arr e))) (L.lift-eq e (AB.arr u)))
                  (L.paste1 (L.lift-eq e' (AB.arr u')) w))))
   (Hn.transH (AE.left (AE.arr (eta b' c' e')) (MG.map-cmp (L.lift e' (AB.arr u')) f))
   (Hn.transH (AE.assoc (AE.arr (eta b' c' e')) (G.map d' c' (L.lift e' (AB.arr u'))) (G.map d d' f))
    (AE.right (eta-compat b' d' c' (L.lift e' (AB.arr u')) u' e' (L.lift-eq e' (AB.arr u'))) (G.map d d' f))))))))) ;
  y : Y b b' g = (phi0, square) ;
 } ;
 Y-inh (b b' : B.ob) (g : B.hom b b') : Y b b' g =
  Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b].induction @j (\ t -> Y b b' g) (\ t -> Y-prop b b' g)
   (\ w -> Tr.Trunc[(c : C.ob) * B.Iso (q.obj c) b'].induction @j (\ t -> Y b b' g) (\ t -> Y-prop b b' g)
     (\ w' -> Pair[b,b',g,w.1,w.2,w'.1,w'.2].y)
     (es b'))
   (es b) ;

 map (b b' : B.ob) (g : B.hom b b') : E.pre.hom (obj b) (obj b') = (Y-inh b b' g).1 ;
 square (b b' : B.ob) (g : B.hom b b') : Sqs b b' g (map b b' g) = (Y-inh b b' g).2 ;

 -- functoriality
 idn-square (b : B.ob) : Sqs b b (B.idn b) (E.pre.idn (obj b)) = \ c c' f e e' w ->
  Hn.transH (AE.unit-l (AE.arr (eta b c e)))
   (Hn.symH (eta-compat b c c' f e e' (Paths[l].transH w (AB.unit-l (AB.arr e))))) ;
 map-idn (b : B.ob) : Id (E.pre.hom (obj b) (obj b)) (map b b (B.idn b)) (E.pre.idn (obj b)) =
  P.ap (Y b b (B.idn b)) (E.pre.hom (obj b) (obj b)) (\ y -> y.1) (Y-inh b b (B.idn b)) (E.pre.idn (obj b), idn-square b)
   (Y-prop b b (B.idn b) (Y-inh b b (B.idn b)) (E.pre.idn (obj b), idn-square b)) ;

 comp-square (b b' b'' : B.ob) (g' : B.hom b' b'') (g : B.hom b b') :
  Sqs b b'' (AB.cmp g' g) (AE.cmp (map b' b'' g') (map b b' g)) = \ c c'' f e e'' w ->
  Tr.Trunc[(c' : C.ob) * B.Iso (q.obj c') b'].induction @n
   (\ t -> Id (E.pre.hom (G.obj c) (obj b'')) (AE.cmp (AE.cmp (map b' b'' g') (map b b' g)) (AE.arr (eta b c e)))
            (AE.cmp (AE.arr (eta b'' c'' e'')) (G.map c c'' f)))
   (\ t -> E.pre.hom-set (G.obj c) (obj b'') (AE.cmp (AE.cmp (map b' b'' g') (map b b' g)) (AE.arr (eta b c e)))
            (AE.cmp (AE.arr (eta b'' c'' e'')) (G.map c c'' f)))
   (\ v ->
    Hn.transH (Hn.symH (AE.assoc (map b' b'' g') (map b b' g) (AE.arr (eta b c e))))
    (Hn.transH (AE.left (map b' b'' g')
                 (square b b' g c v.1 (L.lift v.2 (AB.cmp g (AB.arr e))) e v.2 (L.lift-eq v.2 (AB.cmp g (AB.arr e)))))
    (Hn.transH (AE.assoc (map b' b'' g') (AE.arr (eta b' v.1 v.2)) (G.map c v.1 (L.lift v.2 (AB.cmp g (AB.arr e)))))
    (Hn.transH (AE.right (square b' b'' g' v.1 c'' (L.lift e'' (AB.cmp g' (AB.arr v.2))) v.2 e''
                           (L.lift-eq e'' (AB.cmp g' (AB.arr v.2))))
                 (G.map c v.1 (L.lift v.2 (AB.cmp g (AB.arr e)))))
    (Hn.transH (Hn.symH (AE.assoc (AE.arr (eta b'' c'' e'')) (G.map v.1 c'' (L.lift e'' (AB.cmp g' (AB.arr v.2))))
                          (G.map c v.1 (L.lift v.2 (AB.cmp g (AB.arr e))))))
    (Hn.transH (AE.left (AE.arr (eta b'' c'' e''))
                 (Hn.symH (MG.map-cmp (L.lift e'' (AB.cmp g' (AB.arr v.2))) (L.lift v.2 (AB.cmp g (AB.arr e))))))
     (AE.left (AE.arr (eta b'' c'' e''))
       (MG.map-eq (L.unique e''
         (Paths[l].transH (L.paste (L.lift-eq e'' (AB.cmp g' (AB.arr v.2))) (L.lift-eq v.2 (AB.cmp g (AB.arr e))))
           (AB.assoc g' g (AB.arr e)))
         w)))))))))
   (es b') ;
 map-comp (b b' b'' : B.ob) (g' : B.hom b' b'') (g : B.hom b b') :
  Id (E.pre.hom (obj b) (obj b'')) (map b b'' (AB.cmp g' g)) (AE.cmp (map b' b'' g') (map b b' g)) =
  P.ap (Y b b'' (AB.cmp g' g)) (E.pre.hom (obj b) (obj b'')) (\ y -> y.1)
   (Y-inh b b'' (AB.cmp g' g)) (AE.cmp (map b' b'' g') (map b b' g), comp-square b b' b'' g' g)
   (Y-prop b b'' (AB.cmp g' g) (Y-inh b b'' (AB.cmp g' g)) (AE.cmp (map b' b'' g') (map b b' g), comp-square b b' b'' g' g)) ;

 functor : FB.Functor[B,E.pre] = new FB.Functor[B,E.pre, obj, map, map-idn, map-comp] ;

 -- the natural iso G ~ H o q
 module Q = FC2.Precompose[C,B,E.pre,q] ;
 module FunC = FC2.FunCat[C,E.pre] ;
 module NU = FC2.NatTrans[C,E.pre,G,Q.functor functor] ;
 module NE = FC2.NatTrans[C,E.pre,Q.functor functor,G] ;
 unit-leg (c : C.ob) : E.pre.Iso (G.obj c) (obj (q.obj c)) = eta (q.obj c) c (B.iso-id (q.obj c)) ;
 unit-square (c c' : C.ob) (f : C.hom c c') :
  Id (E.pre.hom (G.obj c) (obj (q.obj c'))) (AE.cmp (map (q.obj c) (q.obj c') (q.map c c' f)) (AE.arr (unit-leg c)))
   (AE.cmp (AE.arr (unit-leg c')) (G.map c c' f)) =
  square (q.obj c) (q.obj c') (q.map c c' f) c c' f (B.iso-id (q.obj c)) (B.iso-id (q.obj c'))
   (Paths[l].transH (AB.unit-l (q.map c c' f)) (Paths[l].symH (AB.unit-r (q.map c c' f)))) ;
 unit : NU.Nat = (\ c -> AE.arr (unit-leg c), unit-square) ;
 counit : NE.Nat = (\ c -> AE.inv (unit-leg c), \ c c' f -> AE.square-inv (unit-leg c) (unit-leg c') (unit-square c c' f)) ;
 iso : FunC.pre.Iso (Q.functor functor) G =
  (counit, unit,
   FC2.NatTrans[C,E.pre,Q.functor functor,Q.functor functor].nat-eq
    (FunC.comp (Q.functor functor) G (Q.functor functor) unit counit) (FunC.idn (Q.functor functor))
    (\ c -> AE.arr-inv (unit-leg c)),
   FC2.NatTrans[C,E.pre,G,G].nat-eq (FunC.comp G (Q.functor functor) G counit unit) (FunC.idn G)
    (\ c -> AE.inv-arr (unit-leg c))) ;
} ;
