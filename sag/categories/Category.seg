-- Categories as structured 1-types (DESIGN.md §1).  Objects in U k,
-- arrows in U l.
--
-- A precategory: objects, hom sets, identities, composition, the unit and
-- associativity laws; nothing is asked of the object type.  An iso is an
-- arrow with a two-sided inverse; Iso x y is a set (a Sigma of sets).
-- idtoiso is J with value the identity iso at refl.  A category is a
-- precategory whose idtoiso maps are equivalences; isotoid is the section.
-- Then x = y is small (it is equivalent to Iso x y), and a set (a retract
-- of the set Iso x y): the object type of a category is a 1-type.
--
-- Univalence from total spaces (DESIGN.md §4.6).  Singl x = (y : C) *
-- Iso x y.  In a category Singl x is a proposition: a retract of the based
-- path space PathSp x (isotoid, idtoiso; sec-eq), a proposition by J.
-- Conversely (FromTotal), if every Singl x is a proposition, put
-- isotoid e = ap fst of the path (x, 1) = (y, e); along any path Q from
-- (x, 1), idtoiso (ap fst Q) is the second component (J on Q), so
-- idtoiso (isotoid e) = e; and isotoid (idtoiso p) = p by J on p, the path
-- (x, 1) = (x, 1) being a loop in a proposition, hence refl.
level k l ; open Base ;
module Pl = Prelude[l] ; module P = Prelude[k \/ l] ;
module R = Replacement[l,k] ;

record Precategory {
 ob : U k ;
 hom : ob -> ob -> U l ;
 hom-set (x y : ob) : Pl.isSet (hom x y) ;
 idn (x : ob) : hom x x ;
 comp (x y z : ob) : hom y z -> hom x y -> hom x z ;
 unit-l (x y : ob) (f : hom x y) : Id (hom x y) (comp x y y (idn y) f) f ;
 unit-r (x y : ob) (f : hom x y) : Id (hom x y) (comp x x y f (idn x)) f ;
 assoc (w x y z : ob) (f : hom w x) (g : hom x y) (h : hom y z) :
  Id (hom w z) (comp w y z h (comp w x y g f)) (comp w x z (comp x y z h g) f) ;

 isIso (x y : ob) (f : hom x y) : U l =
  (g : hom y x) * Id (hom x x) (comp x y x g f) (idn x) * Id (hom y y) (comp y x y f g) (idn y) ;
 Iso (x y : ob) : U l = (f : hom x y) * isIso x y f ;
 iso-id (x : ob) : Iso x x = (idn x, idn x, unit-l x x (idn x), unit-l x x (idn x)) ;
 idtoiso (x y : ob) (p : Id ob x y) : Iso x y = idJ ob x (\ y1 p1 -> Iso x y1) (iso-id x) y p ;
} ;

module IsoSet (C : Precategory) {
 -- Iso x y is a set: hom sets, and identity types of sets
 set (x y : C.ob) : Pl.isSet (C.Iso x y) =
  Pl.isSet-Sigma (C.hom x y) (C.isIso x y) (C.hom-set x y) (\ f ->
   Pl.isSet-Sigma (C.hom y x)
    (\ g -> Id (C.hom x x) (C.comp x y x g f) (C.idn x) * Id (C.hom y y) (C.comp y x y f g) (C.idn y))
    (C.hom-set y x) (\ g ->
     Pl.isSet-Sigma (Id (C.hom x x) (C.comp x y x g f) (C.idn x))
      (\ u -> Id (C.hom y y) (C.comp y x y f g) (C.idn y))
      (Pl.prop-to-set (Id (C.hom x x) (C.comp x y x g f) (C.idn x)) (C.hom-set x x (C.comp x y x g f) (C.idn x)))
      (\ u -> Pl.prop-to-set (Id (C.hom y y) (C.comp y x y f g) (C.idn y)) (C.hom-set y y (C.comp y x y f g) (C.idn y))))) ;
 -- by definition
 idtoiso-refl (x : C.ob) : Id (C.Iso x x) (C.idtoiso x x (refl x)) (C.iso-id x) = refl (C.iso-id x) ;
} ;

Univalent (C : Precategory) : U (k \/ l) =
 (x y : C.ob) -> P.isEquiv (Id C.ob x y) (C.Iso x y) (C.idtoiso x y) ;

module Singletons (C : Precategory) {
 Singl (x : C.ob) : U (k \/ l) = (y : C.ob) * C.Iso x y ;
 PathSp (x : C.ob) : U k = (y : C.ob) * Id C.ob x y ;
 path-centre (x : C.ob) (u : PathSp x) : Id (PathSp x) (x, refl x) u =
  idJ C.ob x (\ y p -> Id (PathSp x) (x, refl x) (y, p)) (refl (x, refl x)) u.1 u.2 ;
 path-prop (x : C.ob) : P.isProp (PathSp x) = \ u v ->
  P.trans (PathSp x) u (x, refl x) v (P.sym (PathSp x) (x, refl x) u (path-centre x u)) (path-centre x v) ;
} ;

-- a precategory whose singletons of isos are propositions is univalent
module FromTotal (C : Precategory) (tp : (x : C.ob) -> P.isProp (Singletons[C].Singl x)) {
 module S = Singletons[C] ;
 isotoid (x y : C.ob) (e : C.Iso x y) : Id C.ob x y =
  P.ap (S.Singl x) C.ob (\ w -> w.1) (x, C.iso-id x) (y, e) (tp x (x, C.iso-id x) (y, e)) ;
 idtoiso-fst (x : C.ob) (w : S.Singl x) (Q : Id (S.Singl x) (x, C.iso-id x) w) :
  Id (C.Iso x w.1) (C.idtoiso x w.1 (P.ap (S.Singl x) C.ob (\ w1 -> w1.1) (x, C.iso-id x) w Q)) w.2 =
  idJ (S.Singl x) (x, C.iso-id x)
   (\ w2 Q2 -> Id (C.Iso x w2.1) (C.idtoiso x w2.1 (P.ap (S.Singl x) C.ob (\ w1 -> w1.1) (x, C.iso-id x) w2 Q2)) w2.2)
   (refl (C.iso-id x)) w Q ;
 idtoiso-isotoid (x y : C.ob) (e : C.Iso x y) : Id (C.Iso x y) (C.idtoiso x y (isotoid x y e)) e =
  idtoiso-fst x (y, e) (tp x (x, C.iso-id x) (y, e)) ;
 loop (x : C.ob) : Id (Id (S.Singl x) (x, C.iso-id x) (x, C.iso-id x)) (tp x (x, C.iso-id x) (x, C.iso-id x)) (refl (x, C.iso-id x)) =
  P.loop-refl (S.Singl x) (P.prop-to-set (S.Singl x) (tp x)) (x, C.iso-id x) (tp x (x, C.iso-id x) (x, C.iso-id x)) ;
 isotoid-idtoiso (x y : C.ob) (p : Id C.ob x y) : Id (Id C.ob x y) (isotoid x y (C.idtoiso x y p)) p =
  idJ C.ob x (\ y1 p1 -> Id (Id C.ob x y1) (isotoid x y1 (C.idtoiso x y1 p1)) p1)
   (P.ap (Id (S.Singl x) (x, C.iso-id x) (x, C.iso-id x)) (Id C.ob x x)
     (\ Q -> P.ap (S.Singl x) C.ob (\ w -> w.1) (x, C.iso-id x) (x, C.iso-id x) Q)
     (tp x (x, C.iso-id x) (x, C.iso-id x)) (refl (x, C.iso-id x)) (loop x))
   y p ;
 univalent : Univalent C = \ x y ->
  P.qinv (Id C.ob x y) (C.Iso x y) (C.idtoiso x y) (isotoid x y) (idtoiso-isotoid x y) (isotoid-idtoiso x y) ;
} ;

record Category {
 pre : Precategory ;
 univalent : Univalent pre ;
 isotoid (x y : pre.ob) (e : pre.Iso x y) : Id pre.ob x y = (univalent x y).sec e ;
} ;

module Objects (C : Category) {
 -- the paths between two objects form a small type
 small (x y : C.pre.ob) : R.Small (Id C.pre.ob x y) =
  (C.pre.Iso x y,
   Equivalences[k \/ l].inverse (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y, C.univalent x y)) ;
 locally-small : R.LocallySmall C.pre.ob = small ;
 -- the object type is a 1-type
 one-type (x y : C.pre.ob) : P.isSet (Id C.pre.ob x y) =
  P.isSet-retract (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y) (C.isotoid x y)
   (P.sec-ret (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y) (C.univalent x y))
   (IsoSet[C.pre].set x y) ;
 -- the singletons of isos are propositions
 module S = Singletons[C.pre] ;
 singl-prop (x : C.pre.ob) : P.isProp (S.Singl x) =
  P.retract-prop (S.Singl x) (S.PathSp x)
   (\ s -> (s.1, C.isotoid x s.1 s.2)) (\ p -> (p.1, C.pre.idtoiso x p.1 p.2))
   (\ s -> P.ap (C.pre.Iso x s.1) (S.Singl x) (\ i -> (s.1, i))
     (C.pre.idtoiso x s.1 (C.isotoid x s.1 s.2)) s.2 ((C.univalent x s.1).sec-eq s.2))
   (S.path-prop x) ;
} ;
