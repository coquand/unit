-- Categories as structured 1-types (DESIGN.md §1).  Objects in U k,
-- arrows in U l.
--
-- A precategory: objects, hom sets, identities, composition, the unit and
-- associativity laws; nothing is asked of the object type.  An iso is an
-- arrow with a two-sided inverse; Iso x y is a set (a Sigma of sets).
-- idtoiso is J with value the identity iso at refl.  A category is a
-- precategory whose idtoiso maps are equivalences; isotoid is the section.
-- Then x = y is small (it is equivalent to Iso x y), and a set (a retract
-- of the set Iso x y): the object type of a category is a 1-type.
level k l ; open Base ;
module Pl = Prelude[l] ; module P = Prelude[k \/ l] ;
module R = Replacement[l,k] ;

record Precategory {
 ob : U k ;
 hom : ob -> ob -> U l ;
 hom-set (x y : ob) : Pl.isSet (hom x y) ;
 idn (x : ob) : hom x x ;
 comp (x y z : ob) : hom y z -> hom x y -> hom x z ;
 unit-l (x y : ob) (f : hom x y) : Id (hom x y) (comp x y y (idn y) f) f ;
 unit-r (x y : ob) (f : hom x y) : Id (hom x y) (comp x x y f (idn x)) f ;
 assoc (w x y z : ob) (f : hom w x) (g : hom x y) (h : hom y z) :
  Id (hom w z) (comp w y z h (comp w x y g f)) (comp w x z (comp x y z h g) f) ;

 isIso (x y : ob) (f : hom x y) : U l =
  (g : hom y x) * Id (hom x x) (comp x y x g f) (idn x) * Id (hom y y) (comp y x y f g) (idn y) ;
 Iso (x y : ob) : U l = (f : hom x y) * isIso x y f ;
 iso-id (x : ob) : Iso x x = (idn x, idn x, unit-l x x (idn x), unit-l x x (idn x)) ;
 idtoiso (x y : ob) (p : Id ob x y) : Iso x y = idJ ob x (\ y1 p1 -> Iso x y1) (iso-id x) y p ;
} ;

module IsoSet (C : Precategory) {
 -- Iso x y is a set: hom sets, and identity types of sets
 set (x y : C.ob) : Pl.isSet (C.Iso x y) =
  Pl.isSet-Sigma (C.hom x y) (C.isIso x y) (C.hom-set x y) (\ f ->
   Pl.isSet-Sigma (C.hom y x)
    (\ g -> Id (C.hom x x) (C.comp x y x g f) (C.idn x) * Id (C.hom y y) (C.comp y x y f g) (C.idn y))
    (C.hom-set y x) (\ g ->
     Pl.isSet-Sigma (Id (C.hom x x) (C.comp x y x g f) (C.idn x))
      (\ u -> Id (C.hom y y) (C.comp y x y f g) (C.idn y))
      (Pl.prop-to-set (Id (C.hom x x) (C.comp x y x g f) (C.idn x)) (C.hom-set x x (C.comp x y x g f) (C.idn x)))
      (\ u -> Pl.prop-to-set (Id (C.hom y y) (C.comp y x y f g) (C.idn y)) (C.hom-set y y (C.comp y x y f g) (C.idn y))))) ;
 -- by definition
 idtoiso-refl (x : C.ob) : Id (C.Iso x x) (C.idtoiso x x (refl x)) (C.iso-id x) = refl (C.iso-id x) ;
} ;

Univalent (C : Precategory) : U (k \/ l) =
 (x y : C.ob) -> P.isEquiv (Id C.ob x y) (C.Iso x y) (C.idtoiso x y) ;

record Category {
 pre : Precategory ;
 univalent : Univalent pre ;
 isotoid (x y : pre.ob) (e : pre.Iso x y) : Id pre.ob x y = (univalent x y).sec e ;
} ;

module Objects (C : Category) {
 -- the paths between two objects form a small type
 small (x y : C.pre.ob) : R.Small (Id C.pre.ob x y) =
  (C.pre.Iso x y,
   Equivalences[k \/ l].inverse (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y, C.univalent x y)) ;
 locally-small : R.LocallySmall C.pre.ob = small ;
 -- the object type is a 1-type
 one-type (x y : C.pre.ob) : P.isSet (Id C.pre.ob x y) =
  P.isSet-retract (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y) (C.isotoid x y)
   (P.sec-ret (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y) (C.univalent x y))
   (IsoSet[C.pre].set x y) ;
} ;
