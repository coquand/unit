-- Formal unramifiedness survives arbitrary scalar extension constructed
-- by a mapped finite presentation. Restrict square-zero test algebras to
-- R and precompose with the base-change inclusion; uniqueness over R,
-- followed by the mapping-out equivalence, gives uniqueness over K.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module E = Equivalences[l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : H.Hom R K) {
 module BC = MappedPresentation[l].Over[R,K,setR,setK,rho] ;
 module CR = BC.CR ; module CK = BC.CK ; module PR = BC.PR ; module PK = BC.PK ;
 module ER = FormallyEtale[l].Over[R,setR] ; module EK = FormallyEtale[l].Over[K,setK] ;
 square-zero (B : CK.Algebra) (N : EK.SquareZero[B]) : ER.SquareZero[BC.restrict B] =
  ER.mkSquareZero (BC.restrict B) N.ideal N.prop N.square ;
 module At (S : CR.Algebra) (p : PR.Presentation) (ps : PR.Presents p S)
  (T : CK.Algebra) (pt : PK.Presents (BC.presentation p) T) (unique : ER.Unique S) {
  module Change = BC.At[S,p,ps,T,pt] ;
  module Test (B : CK.Algebra) (N : EK.SquareZero[B]) (f g : CK.Hom T B)
   (same : Id (CK.Hom T EK.Mod[B,N].algebra) (EK.reduce T B N f) (EK.reduce T B N g)) {
   oldN : ER.SquareZero[BC.restrict B] = square-zero B N ;
   module QK = EK.Mod[B,N] ; module QR = ER.Mod[BC.restrict B,oldN] ;
   module To = Change.To[B] ;
   oldf : CR.Hom S (BC.restrict B) = To.forward f ;
   oldg : CR.Hom S (BC.restrict B) = To.forward g ;
   classes (a : S.ring.R) :
    Id QR.Q.Carrier (QR.Q.include (oldf.1.1 a)) (QR.Q.include (oldg.1.1 a)) =
    Pr.ap (CK.Hom T QK.algebra) QR.Q.Carrier (\ h -> h.1.1 (Change.inclusion.1.1 a)) _ _ same ;
   reduced : Id (CR.Hom S QR.algebra)
    (ER.reduce S (BC.restrict B) oldN oldf) (ER.reduce S (BC.restrict B) oldN oldg) =
    CR.ext S QR.algebra _ _ classes ;
   old-equal : Id (CR.Hom S (BC.restrict B)) oldf oldg = unique (BC.restrict B) oldN oldf oldg reduced ;
   result : Id (CK.Hom T B) f g =
    E.injective (CK.Hom T B) (CR.Hom S (BC.restrict B)) To.forward To.universal f g old-equal ;
  } ;
  theorem : EK.Unique T = \ B N f g same -> Test[B,N,f,g,same].result ;
 } ;
 module Constructed (S : CR.Algebra) (p : PR.Presentation) (ps : PR.Presents p S) (unique : ER.Unique S) {
  module Model = BC.Constructed[S,p,ps] ;
  algebra : CK.Algebra = Model.algebra ;
  finite-presentation : PK.FP algebra = Model.finite-presentation ;
  unramified : EK.Unique algebra = At[S,p,ps,algebra,Model.presents,unique].theorem ;
 } ;
} ;
