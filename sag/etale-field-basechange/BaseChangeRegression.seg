-- Empty presentation and the presented point X=a, over arbitrary
-- scalar maps. The concrete map Z/4 -> (Z/4)/(2) sends the nonzero
-- nilpotent coefficient 2 to zero, so coefficient transport is exercised.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module AtPoint (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 one : Nat = suc zero ;
 equation : P.Expr (Fin one) = sumE (var (inr tt)) (cst (R.neg a)) ;
 presentation : P.Presentation = (one,cons equation nil) ;
 solution : P.Solutions presentation C.base = (\ i -> a,R.addN a,tt) ;
 module To (B : C.Algebra) {
  arrow : C.Hom C.base B = (B.iota,\ r -> refl (B.iota.1 r)) ;
  extend (s : P.Solutions presentation B) : C.Hom C.base B = arrow ;
  root (s : P.Solutions presentation B) : Id B.ring.R (s.1 (inr tt)) (B.iota.1 a) =
   FormallyEtale[l].Units[B.ring,B.set].sub-zero (s.1 (inr tt)) (B.iota.1 a)
    (trans (ap (B.ring.add (s.1 (inr tt))) (sym (H.negation R B.ring B.iota a))) s.2.1) ;
  fb (s : P.Solutions presentation B) :
   Id (P.Solutions presentation B) (P.canonical presentation C.base solution B (extend s)) s =
   P.solutions-ext presentation B _ _
    (AffineFinite[l].section zero (\ i -> Id B.ring.R (B.iota.1 a) (s.1 i)) (\ i -> efq i) (sym (root s))) ;
  bf (f : C.Hom C.base B) :
   Id (C.Hom C.base B) (extend (P.canonical presentation C.base solution B f)) f =
   C.ext C.base B _ _ (\ r -> sym (f.2 r)) ;
  universal : Pr.isEquiv (C.Hom C.base B) (P.Solutions presentation B) (P.canonical presentation C.base solution B) =
   Pr.qinv _ _ (P.canonical presentation C.base solution B) extend fb bf ;
 } ;
 presents : P.Presents presentation C.base = (solution,\ B -> To[B].universal) ;
} ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : H.Hom R K) {
 module BC = MappedPresentation[l].Over[R,K,setR,setK,rho] ;
 module UB = UnramifiedBaseChange[l].Over[R,K,setR,setK,rho] ;
 module B = BasePresentation[l].Over[R,setR] ;
 base-unique : UB.ER.Unique BC.CR.base = \ A N f g eq ->
  BC.CR.ext BC.CR.base A f g (\ r -> trans (f.2 r) (sym (g.2 r))) ;
 module EmptyPresentation = UB.Constructed[BC.CR.base,B.empty,B.presentation,base-unique] ;
 empty-unique : UB.EK.Unique EmptyPresentation.algebra = EmptyPresentation.unramified ;
 empty-fp : BC.PK.FP EmptyPresentation.algebra = EmptyPresentation.finite-presentation ;
 module Point (a : R.R) {
  module P0 = AtPoint[R,setR,a] ;
  module Model = UB.Constructed[BC.CR.base,P0.presentation,P0.presents,base-unique] ;
  unramified : UB.EK.Unique Model.algebra = Model.unramified ;
  fp : BC.PK.FP Model.algebra = Model.finite-presentation ;
  base-map : BC.CR.Hom BC.CR.base (BC.restrict BC.CK.base) =
   (rho,\ r -> refl (rho.1 r)) ;
  module Target = Model.Model.BC.To[BC.CK.base] ;
  evaluation : BC.CK.Hom Model.algebra BC.CK.base = Target.backward base-map ;
  value : Id K.R (evaluation.1.1 (Model.Model.presents.1.1 (inr tt))) (rho.1 a) =
   Target.backward-generators base-map (inr tt) ;
 } ;
} ;
module Z = ZMod4[l] ;
module IdealTwo = FiniteGeneratedIdeal[l].Over[Z.ring,suc zero,\ i -> q2] ;
module Residue = QuotientRing[l].Over[Z.ring,IdealTwo.ideal,IdealTwo.prop] ;
module Concrete = Over[Z.ring,Residue.ring,Z.set,Residue.set,Residue.projection] ;
module Two = Concrete.Point[q2] ;
two-zero : Id Residue.Carrier (Residue.include q2) Residue.zeroQ =
 Residue.to-zero q2 (IdealTwo.generator (inr tt)) ;
mapped-coefficient-zero : Id Residue.Carrier
 (Concrete.BC.PK.eval (Fin (suc zero)) Concrete.BC.CK.base (\ i -> Residue.zeroQ)
  (Concrete.BC.expression (Fin (suc zero)) (cst q2))) Residue.zeroQ = two-zero ;
point-evaluates-zero : Id Residue.Carrier
 (Two.evaluation.1.1 (Two.Model.Model.presents.1.1 (inr tt))) Residue.zeroQ = trans Two.value two-zero ;
