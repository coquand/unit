-- The final theorem starts with finite presentation and formal
-- unramifiedness: no span, basis, trace or selected factor is supplied.
-- Test F2 and the constructed standard algebra for X^2-X, at its point 1.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module H = RingHom[l] ;
module B = BooleanRing[l] ; module R = PrimitiveRegression[l] ; module F = FieldFiniteRegression[l] ;
module C = Algebras[l].Over[R.k,B.bool-set] ; module K = RL[R.k] ;
module General = UnramifiedFieldSelected[l].Over[R.k,B.bool-set,R.field] ;
module BaseTest = General.At[C.base,F.BaseP.finitely-presented,F.base-unique,SeparatorSelectedRegression[l].prime] ;
base : BaseTest.Result = BaseTest.theorem ;
module KnownBasis = BaseTest.GivenBasis[TraceRegression[l].one,SeparatorSelectedRegression[l].Trace.basis] ;
base-with-basis : Tr.Trunc[BaseTest.Target.Selected[TraceRegression[l].one,SeparatorSelectedRegression[l].Trace.basis,
 SeparatorSelectedRegression[l].prime]].carrier = KnownBasis.theorem ;
module PrimeFromPoint (S : C.Algebra) (point : C.Hom S C.base) {
 member (a : S.ring.R) : U l = Id R.k.R (point.1.1 a) R.k.z ;
 ideal : RegularIdeal[l].IdealPred[S.ring] = RegularIdeal[l].mkIdealPred S.ring member
  (H.zero S.ring R.k point.1)
  (\ a b ha hb -> trans (point.1.2.2.1 a b)
   (trans (cong2 R.k.R R.k.add _ _ _ _ ha hb) (R.k.addZ R.k.z)))
  (\ a b hb -> trans (point.1.2.2.2 a b) (trans (ap (R.k.mul (point.1.1 a)) hb) (K.mul-zero (point.1.1 a)))) ;
 proper : Not (member S.ring.o) = \ h -> R.nonzero (trans (sym point.1.2.1) h) ;
 prime (a b : S.ring.R) (h : member (S.ring.mul a b)) : Plus (member a) (member b) =
  R.prime-and (point.1.1 a) (point.1.1 b) (trans (sym (point.1.2.2.2 a b)) h) ;
 q : PrimeIdempotents[l].Over[S.ring].Prime = new PrimeIdempotents[l].Over[S.ring].Prime[
  ideal,\ a -> B.bool-set _ _,proper,prime,\ a -> R.prime-dec (point.1.1 a)] ;
} ;
module Q = FieldRegularRegression[l] ;
module Quadratic (rq : Q.Reps.Representation Q.q) (rg : Q.Reps.Representation Q.Pt.g) {
 module A = Q.Test[rq,rg] ; module Point = PrimeFromPoint[A.S,A.v] ;
 module Theorem = General.At[A.S,A.fp,A.etale.1.2,Point.q] ;
 result : Theorem.Result = Theorem.theorem ;
 generator-outside : Not (Point.member A.x) = \ h -> R.nonzero (trans (sym A.vx) h) ;
 nonzero : Not (Id A.S.ring.R A.x A.S.ring.z) = A.nonzero ;
} ;
Regression : U l = (rq : Q.Reps.Representation Q.q) * (rg : Q.Reps.Representation Q.Pt.g) * Quadratic[rq,rg].Theorem.Result ;
quadratic : Tr.Trunc[Regression].carrier = TC.map2
 (Q.Reps.Representation Q.q) (Q.Reps.Representation Q.Pt.g) Regression
 (\ rq rg -> (rq,rg,Quadratic[rq,rg].result)) (Q.Reps.representation Q.q) (Q.Reps.representation Q.Pt.g) ;
