-- The selected separable monogenic factor exists, starting from the
-- original field hypotheses. Finiteness, basis, perfect trace, reducedness,
-- tensor diagonal, scalar search and small-field branch are all proved.
-- The specified prime is retained throughout; no prime is chosen.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ; module DC = DiagonalCertificate[l].Over[k,setk] ;
 module At (S : C.Algebra) (fp : P.FP S) (unique : FE.Unique S)
  (q : PrimeIdempotents[l].Over[S.ring].Prime) {
  module Target = SelectedFactorStatement[l].Over[k,setk].At[S] ;
  module Regular = UnramifiedFieldRegular[l].Over[k,setk,field.decide].At[S,fp,unique] ;
  module Reg = PrincipalRegularity[l].Over[S.ring] ; module L = RL[S.ring] ;
  module Structure = UnramifiedFieldStructure[l].Over[k,setk,field.decide,field.nonzero].At[S,fp,unique] ;
  square-witness (a : S.ring.R) (h : Id S.ring.R (S.ring.mul a a) S.ring.z)
   (w : Reg.Witness a) : Id S.ring.R a S.ring.z =
    trans w.2 (trans (ap (\ x -> S.ring.mul x w.1) h) (L.zero-mul w.1)) ;
  reduced (a : S.ring.R) (h : Id S.ring.R (S.ring.mul a a) S.ring.z) : Id S.ring.R a S.ring.z =
   TC.rec (Reg.Witness a) @l (Id S.ring.R a S.ring.z) (S.set a S.ring.z)
    (square-witness a h) (Regular.regular a) ;
  module GivenBasis (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
   perfect : PerfectTraceNondegenerate[l].Over[k,setk,S,n,basis].Perfect =
    FiniteUnramifiedTrace[l].Over[k,setk].At[S,n,basis].theorem fp unique ;
   input : Target.Input = new Target.Input[field,n,basis,perfect,q] ;
   from-diagonal (d : DC.Result S) : Target.Result input =
    SelectedFactorComplete[l].Over[k,setk].At[S,input,reduced,d.1,d.2.1,d.2.2].theorem ;
   theorem : Tr.Trunc[Target.Selected[n,basis,q]].carrier =
    Truncation[l+].Trunc[DC.Result S].induction @l
     (\ d -> Target.Result input) (\ d -> Tr.Trunc[Target.Selected[n,basis,q]].proposition)
     from-diagonal (DC.exists S fp unique) ;
  } ;
  record Certificate {
   dimension : Nat ;
   basis : TraceBasis[l].Over[k,setk,S].Basis[dimension] ;
   selected : Target.Selected[dimension,basis,q] ;
  } ;
  Result : U l = Tr.Trunc[Certificate].carrier ;
  module Given (s : Structure.Structure) {
   module Select = GivenBasis[s.dimension,s.coordinates] ;
   result : Result = TC.map (Target.Selected[s.dimension,s.coordinates,q]) Certificate
    (\ c -> new Certificate[s.dimension,s.coordinates,c]) Select.theorem ;
  } ;
  finite : FiniteSpan[l].Over[k,S.ring,S.iota].Finite = Structure.finite ;
  theorem : Result = TC.bind Structure.Structure Certificate (\ s -> Given[s].result) Structure.theorem ;
 } ;
} ;
