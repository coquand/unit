-- Localised membership on an arbitrary chart intersection. Clear a common
-- denominator supported in that chart for BOTH the D-valued input and the
-- A-valued J multipliers. The resulting evaluated polynomial really belongs
-- to the polynomial ideal J, so the checked Rees membership theorem applies
-- to the SAME fixed KG list. No localisation/flatness hypothesis is added.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ; open ShiftedCech4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module CD = ChartDenominators4[l] ;
module FP0 = FinitePolynomial4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (t : Nat) (a : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
 module PM = ReesPolynomialMembership4[l].Over[K0,A,setA,cfnA,t,a,s,p,e,hp] ;
 module BG = PM.BG ; module EV = BG.EV ; module BD = PM.BD ; module BR = PM.RR.BR ;
 module FD = FinitePolynomial4[l].Over[BG.D,BG.setD] ; module FA = FinitePolynomial4[l].Over[A,setA] ;
 module PAD = BG.PAD ; module PAA = EV.PAA ; module RSA = EV.RSA ; module RK = PM.RK ;
 module DC = CD.Over[BG.D,BG.setD] ; module AC = CD.Over[A,setA] ;
 module HR = HomogeneousCoefficientRepresentation4[l].Over[A,t,BG.D,BG.setD,BG.GD] ;
 ev-delta (m : E4) : Id A.R (EV.ev.1 (FD.delta0 m)) (FA.delta0 m) =
  trans (FP0.sel-map BG.D A EV.ev.1 EV.ev-zero BG.D.o (Id E4 m FP0.zeroE) (dec-e4 m FP0.zeroE))
   (ap (\ x -> FP0.sel A x (Id E4 m FP0.zeroE) (dec-e4 m FP0.zeroE)) EV.ev.2.1) ;
 ev-cf (q : TPoly BG.D.R) (m : E4) : Id A.R (EV.ev.1 (FD.cf q m)) (FA.cf (EV.evT q) m) =
  trans (EV.ev-mulP q FD.delta0 m)
    (PAA.mulP-cong (EV.evT q) (\ m -> EV.ev.1 (FD.delta0 m)) FA.delta0 ev-delta m) ;
 module Chart (E : Sub4) (S : List E4) (n : Base.Nat) (f : E4 -> BG.D.R)
  (fs : (m : E4) -> Not (Mem m S) -> Id BG.D.R (f m) BG.D.z)
  (fv : (m : E4) -> Out E m -> Id BG.D.R (f m) BG.D.z)
  (fh : (m : E4) -> BG.BA.GL.Hom (pos n) (f m))
  (v : Ps.Fin s -> E4 -> A.R)
  (vs : (q : Ps.Fin s) (m : E4) -> Not (Mem m S) -> Id A.R (v q m) A.z)
  (vv : (q : Ps.Fin s) (m : E4) -> Out E m -> Id A.R (v q m) A.z)
  (eq : (m : E4) -> Id A.R (EV.ev.1 (f m)) (RSA.sum s (\ q -> PAA.mulP (p q) (v q) m))) {
  module C = DC.Clear[E,S] ; module CF = C.Function[f,fs,fv] ;
  module DRep = HR.Rep[n,CF.raw,CF.polynomial,\ m -> fh (subE m C.L),CF.support,CF.support-van] ;
  q : TPoly BG.D.R = DRep.q ;
  module AEntry (j : Ps.Fin s) { module F = AC.Clear[E,S].Function[v j,vs j,vv j] ; } ;
  apoly (j : Ps.Fin s) : TPoly A.R = AEntry[j].F.representation.1 ;
  polynomial-equation (m : E4) : Id A.R (FA.cf (EV.evT q) m) (FA.cf (PAA.psum s (\ j -> PAA.pmul (p j) (apoly j))) m) = calc A.R {
   FA.cf (EV.evT q) m =< sym (ev-cf q m) > EV.ev.1 (FD.cf q m)
    =< ap EV.ev.1 (DRep.equation m) > EV.ev.1 (f (subE m C.L))
    =< eq (subE m C.L) > RSA.sum s (\ j -> PAA.mulP (p j) (v j) (subE m C.L))
    =< RSA.sum-cong s _ _ (\ j -> sym (PAA.mulP-shift (\ x -> subE x C.L) (\ x u -> subE-comm x C.L u) (p j) (v j) m))
    > RSA.sum s (\ j -> PAA.mulP (p j) (\ x -> v j (subE x C.L)) m)
    =< RSA.sum-cong s _ _ (\ j -> PAA.mulP-cong (p j) (\ x -> v j (subE x C.L)) (FA.cf (apoly j))
        (\ x -> sym (AEntry[j].F.representation.2 x)) m)
    > RSA.sum s (\ j -> PAA.mulP (p j) (FA.cf (apoly j)) m)
    =< RSA.sum-cong s _ _ (\ j -> sym (FA.cf-pmul (p j) (apoly j) m))
    > RSA.sum s (\ j -> FA.cf (PAA.pmul (p j) (apoly j)) m)
    =< sym (FA.cf-psum s (\ j -> PAA.pmul (p j) (apoly j)) m)
    > FA.cf (PAA.psum s (\ j -> PAA.pmul (p j) (apoly j))) m } ;
  phi-equation : Id BR.S.R (BR.phi (EV.evT q)) (BR.phi (PAA.psum s (\ j -> PAA.pmul (p j) (apoly j)))) =
   BR.phi-eq-of-cf (EV.evT q) (PAA.psum s (\ j -> PAA.pmul (p j) (apoly j))) polynomial-equation ;
  in-J : RK.InJ (BR.phi (EV.evT q)) = Tr.Trunc[RK.JW (BR.phi (EV.evT q))].inc
   (\ j -> BR.phi (apoly j),trans phi-equation
    (trans (BR.phi-psum s (\ j -> PAA.pmul (p j) (apoly j)))
      (BR.SS.sum-cong s (\ j -> BR.phi (PAA.pmul (p j) (apoly j))) (\ j -> BR.S.mul (BR.phi (apoly j)) (BR.phi (p j))) (\ j -> trans (BR.phi-pmul (p j) (apoly j)) (BR.S.mulC (BR.phi (p j)) (BR.phi (apoly j))))))) ;
  module Fixed (w : PM.RC.WC.ReesW) (fw : PM.RC.WC.WithGens[w].F.FixedW) {
   module M = PM.List[w,fw] ;
   membership : M.GI.In (BD.phi q) = M.fixed-membership n q DRep.homogeneous in-J ;
  } ;
 } ;
} ;
