-- Finite choice and support union for the four three-chart intersections.
-- These are finite dependent products only, eliminated into truncation.
level l ; open Ring[l] ; open Laurent4[l] ; open Cech4[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
join (P : Tri -> U l) (a : P t012) (b : P t013) (c : P t023) (d : P t123) : (i : Tri) -> P i = split {
 t012 -> a ; t013 -> b ; t023 -> c ; t123 -> d } ;
choice (P : Tri -> U l) (h : (i : Tri) -> Tr.Trunc[P i].carrier) : Tr.Trunc[(i : Tri) -> P i].carrier =
 TC.bind (P t012) ((i : Tri) -> P i) (\ a ->
  TC.bind (P t013) ((i : Tri) -> P i) (\ b ->
   TC.map2 (P t023) (P t123) ((i : Tri) -> P i) (\ c d -> join P a b c d) (h t023) (h t123)) (h t013)) (h t012) ;
union (f : Tri -> List E4) : List E4 = appL (f t012) (appL (f t013) (appL (f t023) (f t123))) ;
member (f : Tri -> List E4) : (i : Tri) (m : E4) -> Mem m (f i) -> Mem m (union f) = split {
 t012 -> \ m h -> mem-appl m (f t012) (appL (f t013) (appL (f t023) (f t123))) h ;
 t013 -> \ m h -> mem-appr m (f t012) (appL (f t013) (appL (f t023) (f t123)))
  (mem-appl m (f t013) (appL (f t023) (f t123)) h) ;
 t023 -> \ m h -> mem-appr m (f t012) (appL (f t013) (appL (f t023) (f t123)))
  (mem-appr m (f t013) (appL (f t023) (f t123)) (mem-appl m (f t023) (f t123) h)) ;
 t123 -> \ m h -> mem-appr m (f t012) (appL (f t013) (appL (f t023) (f t123)))
  (mem-appr m (f t013) (appL (f t023) (f t123)) (mem-appr m (f t023) (f t123) h)) } ;
