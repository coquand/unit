-- Gate (E), in the exact interface of the unchanged Rees correction.
-- Coefficient homogeneity of c passes through delta; evaluated delta(c)
-- in the ORIGINAL equation ideal then gives the actual fixed-KG lift.
-- All local membership/generation is constructed in preceding files.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TL = TopList4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (t : Nat) (a : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
 module G = ReesCochainMembership4[l].Over[K0,A,setA,cfnA,t,a,s,p,e,hp] ;
 module PM = G.PM ; module BG = G.BG ; module CC = BG.BA.CC ; module C = G.EV.CD ;
 module DF = CC.Diff[TL.mOne] ;
 module List (w : PM.RC.WC.ReesW) (fw : PM.RC.WC.WithGens[w].F.FixedW) {
  module L = G.List[w,fw] ; module KG = L.KG ; module CI = L.CI ;
  module Degree = L.Degree[TL.mOne] ; module J = Degree.J ; module EC = Degree.EC ;
  module Input (n : Base.Nat) (c : CI.F1.E0.El) (hc : DF.P1.Hom (pos n) c)
   (jy : J.InJ (EC.evc (CI.D1.d0.f c))) {
   delta : CI.F2.E0.El = CI.D1.d0.f c ;
   projection : Id CI.F2.E0.El (DF.P2.proj (pos n) delta) delta =
    trans (DF.D1-proj (pos n) c) (ap (C.D1 TL.mOne).f (DF.P1.proj-hom (pos n) c hc)) ;
   homogeneous : DF.P2.Hom (pos n) delta = \ i m -> ap (\ y -> CI.F2.E0.val y i m) projection ;
   lift : Tr.Trunc[CI.Lifted c].carrier = Degree.Input[n,delta,homogeneous,jy].lift ;
  } ;
 } ;
} ;
