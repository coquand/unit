-- E regressions: zero inputs at multiple U-degrees and arbitrary fixed KG;
-- a NONZERO proper-chart cochain with J=(1), so the returned KG action at
-- X0^-1 is exactly 1; and explicit subset-supported denominator arithmetic
-- with a forbidden support entry. All lifts use the new constructed theorem.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open ShiftedCech4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FP = FinitePolynomial4[l] ; module TL = TopList4[l] ;
one : Nat = suc zero ; threeB : Base.Nat = suc (suc (suc zero)) ;
negative0 : E4 = ex (negsuc zero) (pos zero) (pos zero) (pos zero) ;
forbidden3 : E4 = ex (pos zero) (pos zero) (pos zero) (negsuc zero) ;
list : List E4 = cons negative0 (cons forbidden3 nil) ;
masked-bound : Id N4 (ChartDenominators4[l].mask (setTri t012) (LaurentSyzygyLift4[l].bound list)) (nx (suc zero) zero zero zero) = refl (nx (suc zero) zero zero zero) ;
sub-zero : (m : E4) -> Id E4 (subE m (nx zero zero zero zero)) m = split { ex a b c d -> refl (ex a b c d) } ;
no-out : Out (setTri t012) negative0 -> Empty = split { o0 h -> h ; o1 h -> h ; o2 h -> h ; o3 h -> h } ;
module General (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (t : Nat) (a : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R) (e : Ps.Fin s -> Base.Nat)
 (hp : (j : Ps.Fin s) -> HomDeg A.R (e j) (p j)) {
 module E = ReesCochainLift4[l].Over[K0,A,setA,cfnA,t,a,s,p,e,hp] ;
 module Chosen (w : E.PM.RC.WC.ReesW) (fw : E.PM.RC.WC.WithGens[w].F.FixedW) {
  module L = E.List[w,fw] ;
  module Case (n : Base.Nat) {
   c : L.CI.F1.E0.El = L.CI.F1.E0.mod.mz ;
   hc : E.DF.P1.Hom (pos n) c = E.DF.P1.hom-zero (pos n) ;
   jy : L.J.InJ (L.EC.evc (L.CI.D1.d0.f c)) =
    subst L.J.InJ (sym (trans (ap L.EC.evc RelationCertificate[l].LinL[E.BG.D,L.CI.F1.E0.mod,L.CI.F2.E0.mod,L.CI.D1.d0].f-zero) L.EC.evc-zero))
     (Tr.Trunc[L.J.JW L.J.E.mod.mz].inc L.J.jw-zero) ;
   lift : Tr.Trunc[L.CI.Lifted c].carrier = L.Input[n,c,hc,jy].lift ;
  } ;
  module Degree0 = Case[zero] ; module Degree3 = Case[threeB] ;
 } ;
} ;
module UnitEquation (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) {
 p (j : Ps.Fin one) : TPoly A.R = cons (A.o,nx zero zero zero zero) nil ;
 e (j : Ps.Fin one) : Base.Nat = zero ;
 hp (j : Ps.Fin one) : HomDeg A.R (e j) (p j) = (refl zero,tt) ;
 module G = ReesCochainMembership4[l].Over[K0,A,setA,cfnA,zero,\ j -> absurd A.R j,one,p,e,hp] ;
 module BG = G.BG ; module EV = G.EV ;
 module EC = EV.EvChart[Tri,BadI Tri setTri TL.mOne] ;
 module J = G.CH.JC[Tri,setTri,TL.mOne] ;
 mono (m : E4) : A.R = FP.sel A A.o (Id E4 m negative0) (dec-e4 m negative0) ;
 mono-supp (m : E4) (nm : Not (Mem m list)) : Id A.R (mono m) A.z =
  FP.sel-no A A.o (Id E4 m negative0) (\ eq -> nm (inl (sym eq))) (dec-e4 m negative0) ;
 mono-van (m : E4) : Bad TL.mOne (setTri t012) m -> Id A.R (mono m) A.z = split {
  inl ne -> FP.sel-no A A.o (Id E4 m negative0) (\ eq -> ne (ap deg eq)) (dec-e4 m negative0) ;
  inr bad -> FP.sel-no A A.o (Id E4 m negative0) (\ eq -> no-out (subst (Out (setTri t012)) eq bad)) (dec-e4 m negative0) } ;
 raw : Tri -> E4 -> A.R = split { t012 -> mono ; t013 -> \ m -> A.z ; t023 -> \ m -> A.z ; t123 -> \ m -> A.z } ;
 supp : (i : Tri) (m : E4) -> Not (Mem m list) -> Id A.R (raw i m) A.z = split {
  t012 -> mono-supp ; t013 -> \ m h -> refl A.z ; t023 -> \ m h -> refl A.z ; t123 -> \ m h -> refl A.z } ;
 van : (i : Tri) (m : E4) -> Bad TL.mOne (setTri i) m -> Id A.R (raw i m) A.z = split {
  t012 -> mono-van ; t013 -> \ m b -> refl A.z ; t023 -> \ m b -> refl A.z ; t123 -> \ m b -> refl A.z } ;
 y : EC.CHD.El = EC.CHD.mk raw (Tr.Trunc[EC.CHD.SuppW raw].inc (list,supp)) van ;
 yh : EC.P.Hom (pos zero) y = \ i m -> BG.GD.iota-hom (raw i m) ;
 value-one : Id A.R (EC.CHD.val y t012 negative0) A.o = FP.sel-yes A A.o (Id E4 negative0 negative0) (refl negative0) (dec-e4 negative0 negative0) ;
 one-act (f : E4 -> A.R) (m : E4) : Id A.R (EV.PAA.mulP (p (inr tt)) f m) (f m) =
  trans (A.addZ (A.mul A.o (f (subE m (nx zero zero zero zero)))))
   (trans (RL[A].one-left (f (subE m (nx zero zero zero zero)))) (ap f (sub-zero m))) ;
 witness : J.JW (EC.evc y) = (\ j -> EC.evc y,
  J.E.eq _ _ (\ i m -> sym (trans (EC.SCA.val-sum one (\ q -> (J.F.gi q).f (EC.evc y)) i m)
   (trans (A.addZ (EV.PAA.mulP (p (inr tt)) (J.E.val (EC.evc y) i) m)) (one-act (J.E.val (EC.evc y) i) m))))) ;
 membership : J.InJ (EC.evc y) = Tr.Trunc[J.JW (EC.evc y)].inc witness ;
 module Chosen (w : G.PM.RC.WC.ReesW) (fw : G.PM.RC.WC.WithGens[w].F.FixedW) {
  module L = G.List[w,fw].Degree[TL.mOne] ;
  lift : Tr.Trunc[L.Input[zero,y,yh,membership].Result].carrier = L.Input[zero,y,yh,membership].lift ;
  one-result : Tr.Trunc[(z : L.F.E1.El) * Id A.R (L.F.E0.val (L.F.A.f z) t012 negative0) A.o].carrier =
   TC.map L.Input[zero,y,yh,membership].Result ((z : L.F.E1.El) * Id A.R (L.F.E0.val (L.F.A.f z) t012 negative0) A.o)
    (\ x -> (x.1,trans (sym (ap (\ y -> L.F.E0.val y t012 negative0) x.2)) value-one)) lift ;
 } ;
 Constructed : U l = (w : G.PM.RC.WC.ReesW) * ((fw : G.PM.RC.WC.WithGens[w].F.FixedW) *
  Tr.Trunc[(z : Chosen[w,fw].L.F.E1.El) * Id A.R (Chosen[w,fw].L.F.E0.val (Chosen[w,fw].L.F.A.f z) t012 negative0) A.o].carrier) ;
 constructed : Tr.Trunc[Constructed].carrier = TC.map G.PM.RC.WC.ListW Constructed
  (\ ww -> (ww.1,(ww.2.1,Chosen[ww.1,ww.2.1].one-result))) G.PM.RC.WC.finite-list ;

} ;
module OverZ {
 module Unit = UnitEquation[Nat * Nat,ZRing[l].ring,int-set,ZCFN[l].cfn] ;
 unit-constructed : Tr.Trunc[Unit.Constructed].carrier = Unit.constructed ;
 module Empty = General[Nat * Nat,ZRing[l].ring,int-set,ZCFN[l].cfn,zero,\ j -> absurd ZRing[l].ring.R j,
  zero,\ j -> absurd (TPoly ZRing[l].ring.R) j,\ j -> absurd Base.Nat j,
  \ j -> absurd (HomDeg ZRing[l].ring.R (absurd Base.Nat j) (absurd (TPoly ZRing[l].ring.R) j)) j] ;
} ;
