-- Assemble the constructed local KG memberships on the four Tri charts
-- into actual cochain-family lifts. The input and original J multipliers
-- receive one common finite support; local choices and support lists remain
-- under the final truncation. The same fixed KG is used throughout.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open ShiftedCech4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module LSL = LaurentSyzygyLift4[l] ; module TF = TriFiniteChoice4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (t : Nat) (a : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
 module LP = LocalizedReesLift4[l].Over[K0,A,setA,cfnA,t,a,s,p,e,hp] ;
 module PM = LP.PM ; module BG = LP.BG ; module EV = LP.LM.EV ; module CH = PM.RC.CH ;
 module HM = LP.HM ; module SC = LP.SC ; module LO = HM.LO ;
 module List (w : PM.RC.WC.ReesW) (fw : PM.RC.WC.WithGens[w].F.FixedW) {
  module L = LP.List[w,fw] ; module KG = L.KG ; module CI = KG.ED.WD.CI ;
  module Degree (k : Int) {
   module F = HM.Fam[CI.M0,Tri,setTri,k] ;
   module EC = EV.EvChart[Tri,BadI Tri setTri k] ;
   module J = CH.JC[Tri,setTri,k] ;
   module Input (n : Base.Nat) (y : F.E0.El) (hy : EC.P.Hom (pos n) y) (jy : J.InJ (EC.evc y)) {
    Result : U l = (z : F.E1.El) * Id F.E0.El y (F.A.f z) ;
    module ChosenJ (v : J.JW (EC.evc y)) (ys : F.E0.SuppW (F.E0.val y))
     (vs : (q : Ps.Fin s) -> EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].SuppW
       (EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].val (v.1 q))) {
     S : List E4 = appL ys.1 (LSL.catL s (\ q -> (vs q).1)) ;
     module Local (i : Tri) {
      f (m : E4) : BG.D.R = F.E0.val y i m ;
      fs (m : E4) (nm : Not (Mem m S)) : Id BG.D.R (f m) BG.D.z =
       ys.2 i m (\ h -> nm (mem-appl m ys.1 (LSL.catL s (\ q -> (vs q).1)) h)) ;
      fv (m : E4) (bad : Out (setTri i) m) : Id BG.D.R (f m) BG.D.z = F.E0.van y i m (inr bad) ;
      fx (m : E4) (bad : Not (Id Int (deg m) k)) : Id BG.D.R (f m) BG.D.z = F.E0.van y i m (inl bad) ;
      vf (q : Ps.Fin s) (m : E4) : A.R = EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].val (v.1 q) i m ;
      vfs (q : Ps.Fin s) (m : E4) (nm : Not (Mem m S)) : Id A.R (vf q m) A.z =
       (vs q).2 i m (\ h -> nm (mem-appr m ys.1 (LSL.catL s (\ q -> (vs q).1)) (LSL.mem-cat s (\ q -> (vs q).1) q m h))) ;
      vfv (q : Ps.Fin s) (m : E4) (bad : Out (setTri i) m) : Id A.R (vf q m) A.z =
       EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].van (v.1 q) i m (inr bad) ;
      equation (m : E4) : Id A.R (EV.ev.1 (f m)) (EV.RSA.sum s (\ q -> EV.PAA.mulP (p q) (vf q) m)) =
       trans (ap (\ x -> J.E.val x i m) v.2)
        (EC.SCA.val-sum s (\ q -> (J.F.gi q).f (v.1 q)) i m) ;
      module C = L.Chart[setTri i,S,n,k,f,fs,fv,hy i,fx,vf,vfs,vfv,equation] ;
     } ;
     Choices : U l = (i : Tri) -> Local[i].C.Data ;
     choices : Tr.Trunc[Choices].carrier = TF.choice (\ i -> Local[i].C.Data) (\ i -> Local[i].C.local-data) ;
     module Chosen (cc : Choices) {
      module At (i : Tri) { module Z = Local[i].C.From[(cc i).1,(cc i).2] ; } ;
      raw (j : Ps.Fin KG.K.na) (i : Tri) (m : E4) : BG.D.R = At[i].Z.value j m ;
      support (j : Ps.Fin KG.K.na) : List E4 = TF.union (\ i -> At[i].Z.support j) ;
      vanish (j : Ps.Fin KG.K.na) (i : Tri) (m : E4) (nm : Not (Mem m (support j))) : Id BG.D.R (raw j i m) BG.D.z =
       At[i].Z.vanish j m (\ h -> nm (TF.member (\ i -> At[i].Z.support j) i m h)) ;
      van (j : Ps.Fin KG.K.na) (i : Tri) (m : E4) : Bad (minus k (KG.dX j)) (setTri i) m -> Id BG.D.R (raw j i m) BG.D.z = split {
       inl ne -> At[i].Z.degree j m ne ; inr bad -> At[i].Z.chart j m bad } ;
      z (j : Ps.Fin KG.K.na) : (F.C1 j).M = LO.Chart[Tri,BadI Tri setTri (minus k (KG.dX j))].mk (raw j)
       (Tr.Trunc[LO.Chart[Tri,BadI Tri setTri (minus k (KG.dX j))].SuppW (raw j)].inc (support j,vanish j)) (van j) ;
      equation : Id F.E0.El y (F.A.f z) = F.E0.eq _ _ (\ i m ->
       trans (sym (At[i].Z.equation m))
        (sym (SC.ChartSums[Tri,BadI Tri setTri k].val-sum KG.K.na (\ j -> (F.gi j).f (z j)) i m))) ;
      result : Result = (z,equation) ;
     } ;
     lift : Tr.Trunc[Result].carrier = TC.map Choices Result (\ cc -> Chosen[cc].result) choices ;
    } ;
    module WithJ (v : J.JW (EC.evc y)) {
     Supports : U l = (q : Ps.Fin s) -> EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].SuppW
       (EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].val (v.1 q)) ;
     supports : Tr.Trunc[Supports].carrier = LSL.fin-choice s
      (\ q -> EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].SuppW (EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].val (v.1 q)))
      (\ q -> EV.CA.LO.Chart[Tri,BadI Tri setTri (minus k (e q))].supp (v.1 q)) ;
     lift : Tr.Trunc[Result].carrier = TC.bind (F.E0.SuppW (F.E0.val y)) Result
      (\ ys -> TC.bind Supports Result (\ vs -> ChosenJ[v,ys,vs].lift) supports) (F.E0.supp y) ;
    } ;
    lift : Tr.Trunc[Result].carrier = TC.bind (J.JW (EC.evc y)) Result (\ v -> WithJ[v].lift) jy ;
   } ;
  } ;
 } ;
} ;
