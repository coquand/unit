-- Finite coefficient functions with homogeneous U-coefficients have
-- term-list representatives retaining that coefficient degree. The existing
-- explicit support representation uses only those coefficients (once per
-- exponent), so its terms inherit the degree without a choice principle.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open PolynomialAction4[l] ; open ShiftedCech4[l] ;
open CoefficientParts[l] ; open FinitePolynomial4[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) {
 module FP = FinitePolynomial4[l].Over[D,setD] ; module BA = BihomogeneousAction4[l].Over[A,t,D,setD,G] ;
 app (n : Base.Nat) : (p q : TPoly D.R) -> BA.CoefHom n p -> BA.CoefHom n q -> BA.CoefHom n (Bar[l].app p q) = split {
  nil -> \ q hp hq -> hq ; cons u p | rec -> \ q hp hq -> (hp.1,rec q hp.2 hq) } ;
 module Rep (n : Base.Nat) (f : E4 -> D.R)
  (neg : (m : E4) -> Out none m -> Id D.R (f m) D.z)
  (hf : (m : E4) -> BA.GL.Hom (pos n) (f m))
  (S : List E4) (supp : (m : E4) -> Not (Mem m S) -> Id D.R (f m) D.z) {
  module R = FP.Rep[f,neg] ;
  term-hom (m : E4) : (cl : Plus ((u : N4) * Id E4 (emb u) m) (Out none m)) -> BA.CoefHom n (R.termOf m cl) = split {
   inl w -> (hf m,tt) ; inr bad -> tt } ;
  list-hom : (ss : List E4) -> BA.CoefHom n (R.tl ss) = split {
   nil -> tt ; cons m ms | rec -> app n (R.termOf m (classify m)) (R.tl ms) (term-hom m (classify m)) rec } ;
  q : TPoly D.R = R.poly S ;
  homogeneous : BA.CoefHom n q = list-hom (FinitePolynomial4[l].NE.nub S) ;
  equation (m : E4) : Id D.R (FP.cf q m) (f m) = R.At[S,supp,m].eq ;
 } ;
} ;
