-- Project the fixed polynomial KG membership coefficients to X-degree
-- k+|L|-d_j, for EVERY integer degree, then translate back by the chart-
-- supported denominator. Every output is finitely supported and has the
-- original chart condition and degree k-d_j. Their exact KG action is f.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open ShiftedCech4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module CD = ChartDenominators4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (t : Nat) (a : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
 module LM = LocalizedReesMembership4[l].Over[K0,A,setA,cfnA,t,a,s,p,e,hp] ;
 module PM = LM.PM ; module BG = LM.BG ; module BD = LM.BD ; module FD = LM.FD ; module PAD = LM.PAD ;
 module HM = HomogeneousMatrices4[l].Over[BG.D,BG.setD] ; module SC = HM.SC ;
 module WP = WeightedParts4[l].Over[BG.D,BG.setD] ;
 module RS = Comb[l].Sums[BG.D,IP.regular BG.D] ; module DL = IP.ModL[BG.D,IP.regular BG.D] ;
 module List (w : PM.RC.WC.ReesW) (fw : PM.RC.WC.WithGens[w].F.FixedW) {
  module M = PM.List[w,fw] ; module KG = M.LS ;
  module Chart (E : Sub4) (S : List E4) (n : Base.Nat) (k : Int) (f : E4 -> BG.D.R)
   (fs : (m : E4) -> Not (Mem m S) -> Id BG.D.R (f m) BG.D.z)
   (fv : (m : E4) -> Out E m -> Id BG.D.R (f m) BG.D.z)
   (fh : (m : E4) -> BG.BA.GL.Hom (pos n) (f m))
   (fx : (m : E4) -> Not (Id Int (deg m) k) -> Id BG.D.R (f m) BG.D.z)
   (v : Ps.Fin s -> E4 -> A.R)
   (vs : (q : Ps.Fin s) (m : E4) -> Not (Mem m S) -> Id A.R (v q m) A.z)
   (vv : (q : Ps.Fin s) (m : E4) -> Out E m -> Id A.R (v q m) A.z)
   (eq : (m : E4) -> Id A.R (LM.EV.ev.1 (f m)) (LM.RSA.sum s (\ q -> LM.PAA.mulP (p q) (v q) m))) {
   module P = LM.Chart[E,S,n,f,fs,fv,fh,v,vs,vv,eq] ;
   L : N4 = P.C.L ; top : Int = addP k (size L) ;
   source-van (m : E4) : Bad top none m -> Id BG.D.R (P.CF.raw m) BG.D.z = split {
    inl ne -> fx (subE m L) (not-deg-subE k top m L (minus-addP k (size L)) ne) ;
    inr bad -> P.CF.polynomial m bad } ;
   Coordinates : U l = M.GI.S.Coordinates M.K.na M.gs (BD.phi P.q) ;
   regular-sum : (a0 : Nat) (xs : Ps.Fin a0 -> BD.S.R) -> Id BD.S.R (M.GI.S.sum a0 xs) (BD.SS.sum a0 xs) = split {
    zero -> \ xs -> refl BD.S.z ; suc a0 | rec -> \ xs -> ap (BD.S.add (xs (inr tt))) (rec (\ i -> xs (inl i))) } ;
   module From (co : Coordinates) (reps : (j : Ps.Fin M.K.na) -> BD.RepW (co.1 j)) {
    b (j : Ps.Fin M.K.na) : TPoly BG.D.R = (reps j).1 ;
    term-equation (j : Ps.Fin M.K.na) : Id BD.S.R (BD.S.mul (M.gs j) (co.1 j)) (BD.phi (BD.PA.pmul (KG.gD j) (b j))) =
     trans (ap (BD.S.mul (M.gs j)) (sym (reps j).2)) (sym (BD.phi-pmul (KG.gD j) (b j))) ;
    sum-equation : Id BD.S.R (M.GI.S.lin M.K.na M.gs co.1) (BD.phi (BD.PA.psum M.K.na (\ j -> BD.PA.pmul (KG.gD j) (b j)))) =
     trans (regular-sum M.K.na (\ j -> BD.S.mul (M.gs j) (co.1 j)))
      (trans (BD.SS.sum-cong M.K.na (\ j -> BD.S.mul (M.gs j) (co.1 j)) (\ j -> BD.phi (BD.PA.pmul (KG.gD j) (b j))) term-equation)
       (sym (BD.phi-psum M.K.na (\ j -> BD.PA.pmul (KG.gD j) (b j))))) ;
    poly-equation : Id BD.S.R (BD.phi P.q) (BD.phi (BD.PA.psum M.K.na (\ j -> BD.PA.pmul (KG.gD j) (b j)))) = trans (sym co.2) sum-equation ;
    source-equation (m : E4) : Id BG.D.R (RS.sum M.K.na (\ j -> PAD.mulP (KG.gD j) (FD.cf (b j)) m)) (f (subE m L)) =
     trans (RS.sum-cong M.K.na _ _ (\ j -> sym (FD.cf-pmul (KG.gD j) (b j) m)))
      (trans (sym (FD.cf-psum M.K.na (\ j -> PAD.pmul (KG.gD j) (b j)) m))
       (trans (BD.cf-eq-of-phi (PAD.psum M.K.na (\ j -> PAD.pmul (KG.gD j) (b j))) P.q (sym poly-equation) m) (P.DRep.equation m))) ;
    part (j : Ps.Fin M.K.na) : E4 -> BG.D.R = WP.part (minus top (KG.dX j)) (FD.cf (b j)) ;
    projected-equation (m : E4) : Id BG.D.R (RS.sum M.K.na (\ j -> PAD.mulP (KG.gD j) (part j) m)) (f (subE m L)) =
     trans (RS.sum-cong M.K.na _ _ (\ j -> WP.mulP-part (minus top (KG.dX j)) top (FD.cf (b j)) m (KG.gD j) (HM.hg-shifts top (KG.dX j) (KG.gD j) (KG.hgD j))))
      (trans (sym (WP.part-sum top M.K.na (\ j x -> PAD.mulP (KG.gD j) (FD.cf (b j)) x) m))
       (trans (WP.part-cong top (\ x -> RS.sum M.K.na (\ j -> PAD.mulP (KG.gD j) (FD.cf (b j)) x)) P.CF.raw source-equation m)
        (WP.part-id top P.CF.raw source-van m))) ;
    value (j : Ps.Fin M.K.na) (m : E4) : BG.D.R = part j (addE m L) ;
    equation (m : E4) : Id BG.D.R (RS.sum M.K.na (\ j -> PAD.mulP (KG.gD j) (value j) m)) (f m) =
     trans (RS.sum-cong M.K.na _ _ (\ j -> PAD.mulP-shift (\ x -> addE x L) (\ x u -> subE-addE-comm x L u) (KG.gD j) (part j) m))
      (trans (projected-equation (addE m L)) (ap f (subE-addE m L))) ;
    polynomial (j : Ps.Fin M.K.na) (m : E4) (bad : Out none m) : Id BG.D.R (part j m) BG.D.z =
     WP.part-van (minus top (KG.dX j)) (FD.cf (b j)) (\ x o -> FD.cf-neg x o (b j)) m (inr bad) ;
    chart (j : Ps.Fin M.K.na) (m : E4) (bad : Out E m) : Id BG.D.R (value j m) BG.D.z =
     polynomial j (addE m L) (CD.to-none E (addE m L) (CD.out-add E m (LaurentSyzygyLift4[l].bound S) bad)) ;
    degree (j : Ps.Fin M.K.na) (m : E4) (ne : Not (Id Int (deg m) (minus k (KG.dX j)))) : Id BG.D.R (value j m) BG.D.z =
     WP.part-van (minus top (KG.dX j)) (FD.cf (b j)) (\ x o -> FD.cf-neg x o (b j)) (addE m L)
      (inl (not-deg-addE (minus k (KG.dX j)) (minus top (KG.dX j)) m L (addP-minus k (KG.dX j) (size L)) ne)) ;
    support (j : Ps.Fin M.K.na) : List E4 = mapL (\ x -> subE x L) (SC.suppL (cons FinitePolynomial4[l].zeroE nil) (b j)) ;
    vanish (j : Ps.Fin M.K.na) (m : E4) (out : Not (Mem m (support j))) : Id BG.D.R (value j m) BG.D.z =
     trans (ap (\ x -> FinitePolynomial4[l].sel BG.D x (Id Int (deg (addE m L)) (minus top (KG.dX j))) (int-dec (deg (addE m L)) (minus top (KG.dX j))))
       (FD.cf-supp (b j) (addE m L) (\ h -> out (mem-tr (support j) (subE (addE m L) L) m (subE-addE m L)
          (mem-map (\ x -> subE x L) (addE m L) (SC.suppL (cons FinitePolynomial4[l].zeroE nil) (b j)) h)))))
      (FinitePolynomial4[l].sel-zero BG.D (Id Int (deg (addE m L)) (minus top (KG.dX j))) (int-dec (deg (addE m L)) (minus top (KG.dX j)))) ;
   } ;
   Data : U l = (co : Coordinates) * ((j : Ps.Fin M.K.na) -> BD.RepW (co.1 j)) ;
   representatives (co : Coordinates) : Tr.Trunc[(j : Ps.Fin M.K.na) -> BD.RepW (co.1 j)].carrier =
    LaurentSyzygyLift4[l].fin-choice M.K.na (\ j -> BD.RepW (co.1 j)) (\ j -> BD.rep (co.1 j)) ;
   local-data : Tr.Trunc[Data].carrier = TC.bind Coordinates Data
    (\ co -> TC.map ((j : Ps.Fin M.K.na) -> BD.RepW (co.1 j)) Data (\ reps -> (co,reps)) (representatives co)) P.Fixed[w,fw].membership ;
  } ;
 } ;
} ;
