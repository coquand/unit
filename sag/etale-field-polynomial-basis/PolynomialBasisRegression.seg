-- Actual bases, including a nonreduced coefficient ring and rank zero.
-- Check explicit lists, their distinct coefficients and degree bounds.
level l ; open Ring[l] ; open Presentations[l] ;
module Z = ZMod4[l] ;
module T = TraceRegression[l].Nonreduced ;
module B = PolynomialBasis[l].Over[Z.ring,Z.set,T.C.base,suc zero,T.basis] ;
module D = PolynomialBasisBounds[l].Over[Z.ring,Z.set,T.C.base,suc zero,T.basis] ;
index : Fin (suc zero) = inr tt ;
raw : List Z.ring.R = cons q2 (cons q3 (cons q1 nil)) ;
same-list : Id (List Z.ring.R) (B.coordinateRaw raw index) raw = refl raw ;
coordinates : Id B.K.Carrier (B.coordinate (B.P.include raw) index) (B.K.include raw) =
 B.coordinate-list raw index ;
coefficient-one : Id Z.ring.R (D.CK.PC.coef (B.coordinate (B.P.include raw) index) (suc zero)) q3 =
 trans (D.coefficient index (suc zero) (B.P.include raw)) (D.CS.PC.coef-include raw (suc zero)) ;
degree-bound : D.CK.Bound (suc (suc (suc zero))) (B.coordinate (B.P.include raw) index) = D.raw-bound raw index ;
shifted : Id B.K.Carrier (B.coordinate (B.P.mulQ B.P.variable (B.P.include raw)) index)
 (B.K.mulQ B.K.variable (B.K.include raw)) =
 trans (B.coordinate-variable (B.P.include raw) index) (ap (B.K.mulQ B.K.variable) coordinates) ;
reconstructed : Id B.P.Carrier
 (B.PS.sum (suc zero) (\ j -> B.P.mulQ (B.scalar.1 (B.coordinate (B.P.include raw) j)) (B.P.constant (T.basis.vector j))))
 (B.P.include raw) = B.reconstruction (B.P.include raw) ;
module Empty = TraceRegression[l].ZeroCase[Z.ring,Z.set] ;
module E = PolynomialBasis[l].Over[Z.ring,Z.set,Empty.algebra,zero,Empty.basis] ;
empty-basis : TraceBasis[l].Over[E.K.ring,E.K.set,E.algebra].Basis[zero] = E.basis ;
empty-reconstruct (p : E.P.Carrier) : Id E.P.Carrier E.P.ring.z p = E.reconstruction p ;
