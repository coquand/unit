-- Polynomial basis coordinates act coefficient by coefficient. Thus a
-- uniform degree bound is retained, without choosing representatives.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra)
 (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module B = PolynomialBasis[l].Over[k,setk,S,n,b] ;
 module CK = FlatPolynomialData[l].Coefficients[k,setk] ;
 module CS = FlatPolynomialData[l].Coefficients[S.ring,S.set] ;
 module TB = TraceBasis[l].Over[k,setk,S].At[n,b] ;
 raw-length : (p : List S.ring.R) (i : Fin n) ->
  Id Nat (CK.Raw.plen (B.coordinateRaw p i)) (CS.Raw.plen p) = split {
  nil -> \ i -> refl zero ; cons a p | ih -> \ i -> ap (\ d -> suc d) (ih i) } ;
 raw-coefficient : (p : List S.ring.R) (i : Fin n) (d : Nat) ->
  Id k.R (CK.Raw.coef (B.coordinateRaw p i) d) (b.coordinate (CS.Raw.coef p d) i) = split {
  nil -> \ i d -> sym (TB.zero i) ;
  cons a p | ih -> \ i -> split { zero -> refl (b.coordinate a i) ; suc d -> ih i d } } ;
 coefficient (i : Fin n) (d : Nat) : (p : B.P.Carrier) ->
  Id k.R (CK.PC.coef (B.coordinate p i) d) (b.coordinate (CS.PC.coef p d) i) =
  B.P.Q.induction @l
   (\ p -> Id k.R (CK.PC.coef (B.coordinate p i) d) (b.coordinate (CS.PC.coef p d) i))
   (\ p -> setk _ _)
   (\ p -> trans (ap (\ t -> CK.PC.coef t d) (B.coordinate-list p i))
    (trans (CK.PC.coef-include (B.coordinateRaw p i) d)
     (trans (raw-coefficient p i d)
      (ap (\ a -> b.coordinate a i) (sym (CS.PC.coef-include p d)))))) ;
 bound (d : Nat) (p : B.P.Carrier) (h : CS.Bound d p) (i : Fin n) :
  CK.Bound d (B.coordinate p i) = \ r le ->
  trans (coefficient i r p) (trans (ap (\ a -> b.coordinate a i) (h r le)) (TB.zero i)) ;
 raw-bound (p : List S.ring.R) (i : Fin n) :
  CK.Bound (CS.Raw.plen p) (B.coordinate (B.P.include p) i) =
  bound (CS.Raw.plen p) (B.P.include p)
   (\ d le -> trans (CS.PC.coef-include p d) (CS.raw-bound p d le)) i ;
} ;
