-- cffr Lemma 6.1: multiplication by any x = b . a in the ideal (a) kills
-- each H^p(a; E).
--
-- In the exterior algebra (ExteriorVectorContraction.mixed):
--     c_b (a ^ w) + a ^ c_b (w) = (b . a) w .
-- Contraction lowers degrees by one (deg-contract, induction on n with
-- contract (x0, x1) = (c' x0 + b_n alpha(x1), c' x1)) and kills degree 0
-- (contract-deg0).  With coefficients in E (Coefficients: compose,
-- apply-plus, apply-ext, apply-scale) the same identity holds for the
-- maps (c_b)_E and d = (a ^ -)_E (homotopy).  So if d alpha = 0 then
--     x alpha = c_b (d alpha) + d (c_b alpha) = d (c_b alpha) ,
-- with c_b alpha of degree p - 1 when alpha has degree p = q + 1; in
-- degree 0, c_b alpha = 0 and x alpha = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Tr = Truncation[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module CO = C.Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = ExteriorHomogeneous[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 ---------------------------------------------------------------------
 -- contraction kills degree 0
 contract-deg0 : (n : Nat) (v : AL.Vec n) (x : Ext n) -> DG.Deg n zero x -> Id (Ext n) (VC.contract n v x) (ezero n) = split {
  zero -> \ v x d -> VC.contract-zero-def v x ;
  suc n | r -> \ v x d -> trans (VC.contract-step-def n v x) (ExteriorAlgebra[l].pair-eq
   (trans (ap (\ t -> eadd n t (escale n (VC.vector-last n v) (alpha n (second n x)))) (r (VC.vector-prefix n v) (first n x) (HO.deg-left n zero x d)))
    (trans (ap (\ t -> eadd n (ezero n) (escale n (VC.vector-last n v) (alpha n t))) (HO.deg-right0 n x d))
     (trans (ap (\ t -> eadd n (ezero n) (escale n (VC.vector-last n v) t)) (EA.alpha-zero n))
      (trans (ap (eadd n (ezero n)) (EA.escale-zero n (VC.vector-last n v))) (EA.eaddZ n (ezero n))))))
   (trans (ap (VC.contract n (VC.vector-prefix n v)) (HO.deg-right0 n x d)) (VC.contract-zero n (VC.vector-prefix n v)))) } ;
 -- contraction lowers the degree by one
 module Lower (n : Nat) (r : (p : Nat) (v : AL.Vec n) (x : Ext n) -> DG.Deg n (suc p) x -> DG.Deg n p (VC.contract n v x))
  (v : AL.Vec (suc n)) (x : Ext (suc n)) {
  pv : AL.Vec n = VC.vector-prefix n v ;
  left : Ext n = eadd n (VC.contract n pv (first n x)) (escale n (VC.vector-last n v) (alpha n (second n x))) ;
  right : Ext n = VC.contract n pv (second n x) ;
  left-deg (p : Nat) (d : DG.Deg (suc n) (suc p) x) : DG.Deg n p left =
   DG.deg-add n p (VC.contract n pv (first n x)) (escale n (VC.vector-last n v) (alpha n (second n x)))
    (r p pv (first n x) (HO.deg-left n (suc p) x d))
    (HO.deg-scale n p (VC.vector-last n v) (alpha n (second n x)) (DG.deg-alpha n p (second n x) (HO.deg-rightS n p x d))) ;
  result : (p : Nat) -> DG.Deg (suc n) (suc p) x -> DG.Deg (suc n) p (VC.contract (suc n) v x) = split {
   zero -> \ d -> DG.deg-eq (suc n) zero (VC.contract-step-def n v x)
    (HO.deg-pair0 n left right (left-deg zero d) (contract-deg0 n pv (second n x) (HO.deg-rightS n zero x d))) ;
   suc p -> \ d -> DG.deg-eq (suc n) (suc p) (VC.contract-step-def n v x)
    (HO.deg-pairS n p left right (left-deg (suc p) d) (r p pv (second n x) (HO.deg-rightS n (suc p) x d))) } ;
 } ;
 deg-contract : (n : Nat) (p : Nat) (v : AL.Vec n) (x : Ext n) -> DG.Deg n (suc p) x -> DG.Deg n p (VC.contract n v x) = split {
  zero -> \ p v x d -> DG.deg-eq zero p (VC.contract-zero-def v x) (DG.deg-zero zero p) ;
  suc n | r -> \ p v x -> Lower[n,r,v,x].result p } ;

 ---------------------------------------------------------------------
 -- with coefficients in E
 module WithE (E : A7.Mod[RingBridge[l].Over[Rg,setR].ring]) (n : Nat) (a b : AL.Vec n) {
  module KZ = Koszul[l].Over[Rg,setR,E] ;
  module CF = KZ.CF ;
  module KA = KZ.K[n,a] ;
  module CK = KZ.CX.Cx[KA.complex] ;
  module MV = A7.MA[CF.MO.ring,CF.V n] ;
  c (x : Ext n) : Ext n = VC.contract n b x ;
  c-linear : CO.LinearMap n n c = (VC.contract-add n b,\ s x -> VC.contract-scale n b s x) ;
  s : R = VC.vdot n b a ;
  -- c_b d + d c_b = (b . a)
  homotopy (u : (CF.V n).M) :
   Id (CF.V n).M ((CF.V n).madd (CF.apply n n c (CF.apply n n KA.wedge u)) (CF.apply n n KA.wedge (CF.apply n n c u))) ((CF.V n).sm s u) =
   calc (CF.V n).M {
    (CF.V n).madd (CF.apply n n c (CF.apply n n KA.wedge u)) (CF.apply n n KA.wedge (CF.apply n n c u))
     =< trans (ap (\ t -> (CF.V n).madd t (CF.apply n n KA.wedge (CF.apply n n c u))) (CF.compose n n n KA.wedge c c-linear u))
          (ap ((CF.V n).madd (CF.apply n n (\ x -> c (KA.wedge x)) u)) (CF.compose n n n c KA.wedge KA.wedge-linear u)) >
    (CF.V n).madd (CF.apply n n (\ x -> c (KA.wedge x)) u) (CF.apply n n (\ x -> KA.wedge (c x)) u)
     =< sym (CF.apply-plus n n (\ x -> c (KA.wedge x)) (\ x -> KA.wedge (c x)) u) >
    CF.apply n n (\ x -> eadd n (c (KA.wedge x)) (KA.wedge (c x))) u
     =< CF.apply-ext n n (\ x -> eadd n (c (KA.wedge x)) (KA.wedge (c x))) (\ x -> escale n s x) (VC.mixed n b a) u >
    CF.apply n n (\ x -> escale n s x) u
     =< CF.apply-scale n s u > (CF.V n).sm s u } ;
  -- c_b on degrees
  c-degree (p : Nat) (I : C.Index n) (e : Id Nat (BA.count n I) (suc p)) : DG.Deg n p (c (CO.basis n I)) =
   deg-contract n p b (CO.basis n I) (subst (\ k -> DG.Deg n k (CO.basis n I)) e (BA.basis-degree n I)) ;
  module Vanish0 (u : (CF.V n).M) (su : KZ.Supp n zero u) (J : C.Index n) {
   term (I : C.Index n) : Plus (Id Nat (BA.count n I) zero) (Not (Id Nat (BA.count n I) zero)) ->
    Id E.M (E.sm (CO.coeff n (c (CO.basis n I)) J) (u I)) E.mz = split {
    inl e -> trans (ap (\ t -> E.sm (CO.coeff n t J) (u I))
       (contract-deg0 n b (CO.basis n I) (subst (\ k -> DG.Deg n k (CO.basis n I)) e (BA.basis-degree n I))))
      (trans (ap (\ t -> E.sm t (u I)) (CO.coeff-zero n J)) (CF.ME.sm-zl (u I))) ;
    inr ne -> trans (ap (E.sm (CO.coeff n (c (CO.basis n I)) J)) (su I ne)) (CF.ME.sm-zr (CO.coeff n (c (CO.basis n I)) J)) } ;
   result : Id E.M (CF.apply n n c u J) E.mz =
    CF.sum-zeros n (\ I -> E.sm (CO.coeff n (c (CO.basis n I)) J) (u I)) (\ I -> term I (Koszul[l].DecNat.dec (BA.count n I) zero)) ;
  } ;
  -- c_b kills degree 0
  c-zero (u : (CF.V n).M) (su : KZ.Supp n zero u) : Id (CF.V n).M (CF.apply n n c u) (CF.V n).mz =
   CF.veq n (CF.apply n n c u) (CF.V n).mz (\ J -> Vanish0[u,su,J].result) ;
  module SM0 = CF.SM.Lin[CF.V n,CF.V n,CF.lin n n c] ;
  module SMd = CF.SM.Lin[CF.V n,CF.V n,CF.lin n n KA.wedge] ;
  c-of-zero : Id (CF.V n).M (CF.apply n n c (CF.V n).mz) (CF.V n).mz = SM0.map-z ;
  -- Lemma 6.1 on vectors: a cocycle u of degree 0 has x u = 0; one of
  -- degree q + 1 has x u = d (c_b u)
  kill-zero (u : (CF.V n).M) (su : KZ.Supp n zero u) (cu : Id (CF.V n).M (CF.apply n n KA.wedge u) (CF.V n).mz) :
   Id (CF.V n).M ((CF.V n).sm s u) (CF.V n).mz = calc (CF.V n).M {
    (CF.V n).sm s u =< sym (homotopy u) >
    (CF.V n).madd (CF.apply n n c (CF.apply n n KA.wedge u)) (CF.apply n n KA.wedge (CF.apply n n c u))
     =< ap (\ t -> (CF.V n).madd (CF.apply n n c t) (CF.apply n n KA.wedge (CF.apply n n c u))) cu >
    (CF.V n).madd (CF.apply n n c (CF.V n).mz) (CF.apply n n KA.wedge (CF.apply n n c u))
     =< ap (\ t -> (CF.V n).madd (CF.apply n n c (CF.V n).mz) (CF.apply n n KA.wedge t)) (c-zero u su) >
    (CF.V n).madd (CF.apply n n c (CF.V n).mz) (CF.apply n n KA.wedge (CF.V n).mz)
     =< trans (ap (\ t -> (CF.V n).madd t (CF.apply n n KA.wedge (CF.V n).mz)) c-of-zero) (ap ((CF.V n).madd (CF.V n).mz) SMd.map-z) >
    (CF.V n).madd (CF.V n).mz (CF.V n).mz =< (CF.V n).maddZ (CF.V n).mz > (CF.V n).mz } ;
  kill-suc (u : (CF.V n).M) (cu : Id (CF.V n).M (CF.apply n n KA.wedge u) (CF.V n).mz) :
   Id (CF.V n).M (CF.apply n n KA.wedge (CF.apply n n c u)) ((CF.V n).sm s u) = calc (CF.V n).M {
    CF.apply n n KA.wedge (CF.apply n n c u)
     =< sym (MV.mzl (CF.apply n n KA.wedge (CF.apply n n c u))) >
    (CF.V n).madd (CF.V n).mz (CF.apply n n KA.wedge (CF.apply n n c u))
     =< ap (\ t -> (CF.V n).madd t (CF.apply n n KA.wedge (CF.apply n n c u))) (sym (trans (ap (CF.apply n n c) cu) c-of-zero)) >
    (CF.V n).madd (CF.apply n n c (CF.apply n n KA.wedge u)) (CF.apply n n KA.wedge (CF.apply n n c u))
     =< homotopy u > (CF.V n).sm s u } ;
  -- c_b u, of degree q, for u of degree q + 1
  lower (q : Nat) (u : KZ.Deg[n,suc q].S.E) : KZ.Deg[n,q].S.E = (CF.apply n n c u.1,KZ.apply-supp n n c (suc q) q (c-degree q) u.1 u.2) ;
  -- Lemma 6.1
  kills : (p : Nat) (u : CK.M p) -> CK.Cocycle p u -> CK.Bnd p ((KA.Ck p).sm s u) = split {
   zero -> \ u cu -> KZ.Deg[n,zero].S.eq ((KA.Ck zero).sm s u) (CK.o zero) (kill-zero u.1 u.2 (ap (\ t -> t.1) cu)) ;
   suc q -> \ u cu -> Tr.Trunc[Bijection[l].Fibre (CK.d q) ((KA.Ck (suc q)).sm s u)].inc
    (lower q u,KZ.Deg[n,suc q].S.eq (KA.dmap q (lower q u)) ((KA.Ck (suc q)).sm s u) (kill-suc u.1 (ap (\ t -> t.1) cu))) } ;
 } ;
} ;
