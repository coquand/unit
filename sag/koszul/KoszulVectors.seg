-- Koszul vectors of degree 0, 1, 2 from families, for the explicit forms of
-- the grade (cffr §6, items 2 and 3).  Everything is by recursion on n,
-- with a vector on Index(n+1) written (u0, u1) (vplus) as in KoszulCone.
--
-- Signs: tw_J = twist J 1 satisfies tw_empty = 1, tw_(inl J) = tw_J,
-- tw_(inr J) = - tw_J (from coeff-alpha at basis vectors, since twist is
-- opaque).
-- vec0 e     = (vec0 e, 0)                          e at the empty subset
-- vec1 y     = (vec1 y', vec0 y_last)               y_i at {i}
-- vec2 x     = (vec2 x', vec1 (i |-> x_(i,last)))   x_ij at {i, j}, i < j
-- These have degree 0, 1, 2; every vector of degree 0 (1) is vec0 (vec1)
-- of its values at the empty subset (the singletons).  On vec0 and vec1,
-- tw_J acts as 1 and -1.  With the cone recursion:
--   d (vec0 e) = vec1 (i |-> a_i e) ,
--   d (vec1 y) = vec2 (i, j |-> a_i y_j - a_j y_i) .
-- For an alternating family x (x_ji = - x_ij, x_ii = 0), vec2 x = 0 gives
-- x = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module KX = KoszulExact[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (E : A7.Mod[RingBridge[l].Over[Rg,setR].ring]) {
 open Rg ;
 module CO = C.Over[Rg,setR] ;
 module HO = ExteriorHomogeneous[l].Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module G1 = GradeOne[l].Over[Rg,setR] ;
 module KZ = Koszul[l].Over[Rg,setR,E] ;
 module CF = KZ.CF ; module ME = CF.ME ;
 module KC = KoszulCone[l].Over[Rg,setR,E] ;
 open ExteriorModel[l].Over[Rg] ;

 ---------------------------------------------------------------------
 -- signs
 coeff-basis-self : (n : Nat) (J : C.Index n) -> Id R (CO.coeff n (CO.basis n J) J) o = split {
  zero -> \ J -> refl o ;
  suc n | r -> split { inl J -> r J ; inr J -> r J } } ;
 tw (n : Nat) (J : C.Index n) : R = HO.twist n J o ;
 tw-zero : Id R (tw zero tt) o = sym (HO.coeff-alpha zero o tt) ;
 tw-inl (n : Nat) (J : C.Index n) : Id R (tw (suc n) (inl J)) (tw n J) =
  trans (ap (HO.twist (suc n) (inl J)) (sym (coeff-basis-self n J)))
   (trans (sym (HO.coeff-alpha (suc n) (CO.basis (suc n) (inl J)) (inl J)))
    (trans (HO.coeff-alpha n (CO.basis n J) J) (ap (HO.twist n J) (coeff-basis-self n J)))) ;
 tw-inr (n : Nat) (J : C.Index n) : Id R (tw (suc n) (inr J)) (neg (tw n J)) =
  trans (ap (HO.twist (suc n) (inr J)) (sym (coeff-basis-self n J)))
   (trans (sym (HO.coeff-alpha (suc n) (CO.basis (suc n) (inr J)) (inr J)))
    (trans (HO.coeff-neg n (alpha n (CO.basis n J)) J)
     (ap neg (trans (HO.coeff-alpha n (CO.basis n J) J) (ap (HO.twist n J) (coeff-basis-self n J)))))) ;
 neg-sm (b : R) (x : E.M) : Id E.M (E.sm (neg b) x) (E.mneg (E.sm b x)) =
  ME.mneg-uniq (E.sm b x) (E.sm (neg b) x) (trans (sym (E.smE b (neg b) x)) (trans (ap (\ t -> E.sm t x) (addN b)) (ME.sm-zl x))) ;

 ---------------------------------------------------------------------
 -- the vectors
 vplus (n : Nat) (u0 u1 : (CF.V n).M) : (CF.V (suc n)).M = KX.plus-fn (C.Index n) (C.Index n) (\ I -> E.M) u0 u1 ;
 vec0 : (n : Nat) -> E.M -> (CF.V n).M = split {
  zero -> \ e I -> e ;
  suc n | r -> \ e -> vplus n (r e) (CF.V n).mz } ;
 vec1 : (n : Nat) -> (Ps.Fin n -> E.M) -> (CF.V n).M = split {
  zero -> \ y -> (CF.V zero).mz ;
  suc n | r -> \ y -> vplus n (r (\ i -> y (inl i))) (vec0 n (y (inr tt))) } ;
 vec2 : (n : Nat) -> (Ps.Fin n -> Ps.Fin n -> E.M) -> (CF.V n).M = split {
  zero -> \ x -> (CF.V zero).mz ;
  suc n | r -> \ x -> vplus n (r (\ i j -> x (inl i) (inl j))) (vec1 n (\ i -> x (inl i) (inr tt))) } ;

 -- pointwise linearity
 vec0-add : (n : Nat) (e f : E.M) (J : C.Index n) -> Id E.M (vec0 n (E.madd e f) J) (E.madd (vec0 n e J) (vec0 n f J)) = split {
  zero -> \ e f J -> refl (E.madd e f) ;
  suc n | r -> \ e f -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec0 (suc n) (E.madd e f) J) (E.madd (vec0 (suc n) e J) (vec0 (suc n) f J)))
   (\ J -> r e f J) (\ J -> sym (E.maddZ E.mz)) } ;
 vec0-sm : (n : Nat) (c : R) (e : E.M) (J : C.Index n) -> Id E.M (vec0 n (E.sm c e) J) (E.sm c (vec0 n e J)) = split {
  zero -> \ c e J -> refl (E.sm c e) ;
  suc n | r -> \ c e -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec0 (suc n) (E.sm c e) J) (E.sm c (vec0 (suc n) e J)))
   (\ J -> r c e J) (\ J -> sym (ME.sm-zr c)) } ;
 vec1-add : (n : Nat) (p q : Ps.Fin n -> E.M) (J : C.Index n) -> Id E.M (vec1 n (\ i -> E.madd (p i) (q i)) J) (E.madd (vec1 n p J) (vec1 n q J)) = split {
  zero -> \ p q J -> sym (E.maddZ E.mz) ;
  suc n | r -> \ p q -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec1 (suc n) (\ i -> E.madd (p i) (q i)) J) (E.madd (vec1 (suc n) p J) (vec1 (suc n) q J)))
   (\ J -> r (\ i -> p (inl i)) (\ i -> q (inl i)) J) (\ J -> vec0-add n (p (inr tt)) (q (inr tt)) J) } ;
 vec1-sm : (n : Nat) (c : R) (y : Ps.Fin n -> E.M) (J : C.Index n) -> Id E.M (vec1 n (\ i -> E.sm c (y i)) J) (E.sm c (vec1 n y J)) = split {
  zero -> \ c y J -> sym (ME.sm-zr c) ;
  suc n | r -> \ c y -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec1 (suc n) (\ i -> E.sm c (y i)) J) (E.sm c (vec1 (suc n) y J)))
   (\ J -> r c (\ i -> y (inl i)) J) (\ J -> vec0-sm n c (y (inr tt)) J) } ;
 vec1-ext : (n : Nat) (p q : Ps.Fin n -> E.M) (h : (i : Ps.Fin n) -> Id E.M (p i) (q i)) (J : C.Index n) -> Id E.M (vec1 n p J) (vec1 n q J) = split {
  zero -> \ p q h J -> refl E.mz ;
  suc n | r -> \ p q h -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec1 (suc n) p J) (vec1 (suc n) q J))
   (\ J -> r (\ i -> p (inl i)) (\ i -> q (inl i)) (\ i -> h (inl i)) J) (\ J -> ap (\ e -> vec0 n e J) (h (inr tt))) } ;
 vec0-zero : (n : Nat) (J : C.Index n) -> Id E.M (vec0 n E.mz J) E.mz = split {
  zero -> \ J -> refl E.mz ;
  suc n | r -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec0 (suc n) E.mz J) E.mz) r (\ J -> refl E.mz) } ;
 vec1-zero : (n : Nat) (J : C.Index n) -> Id E.M (vec1 n (\ i -> E.mz) J) E.mz = split {
  zero -> \ J -> refl E.mz ;
  suc n | r -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec1 (suc n) (\ i -> E.mz) J) E.mz) r (vec0-zero n) } ;
 vec2-zero : (n : Nat) (J : C.Index n) -> Id E.M (vec2 n (\ i j -> E.mz) J) E.mz = split {
  zero -> \ J -> refl E.mz ;
  suc n | r -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec2 (suc n) (\ i j -> E.mz) J) E.mz) r (vec1-zero n) } ;
 vec2-ext : (n : Nat) (p q : Ps.Fin n -> Ps.Fin n -> E.M) (h : (i j : Ps.Fin n) -> Id E.M (p i j) (q i j)) (J : C.Index n) -> Id E.M (vec2 n p J) (vec2 n q J) = split {
  zero -> \ p q h J -> refl E.mz ;
  suc n | r -> \ p q h -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec2 (suc n) p J) (vec2 (suc n) q J))
   (\ J -> r (\ i j -> p (inl i) (inl j)) (\ i j -> q (inl i) (inl j)) (\ i j -> h (inl i) (inl j)) J)
   (\ J -> vec1-ext n (\ i -> p (inl i) (inr tt)) (\ i -> q (inl i) (inr tt)) (\ i -> h (inl i) (inr tt)) J) } ;

 -- signs on vec0, vec1
 vec0-tw : (n : Nat) (e : E.M) (J : C.Index n) -> Id E.M (E.sm (tw n J) (vec0 n e J)) (vec0 n e J) = split {
  zero -> \ e -> KX.top-fn (\ J -> Id E.M (E.sm (tw zero J) (vec0 zero e J)) (vec0 zero e J)) (trans (ap (\ t -> E.sm t e) tw-zero) (E.smO e)) ;
  suc n | r -> \ e -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (E.sm (tw (suc n) J) (vec0 (suc n) e J)) (vec0 (suc n) e J))
   (\ J -> trans (ap (\ t -> E.sm t (vec0 n e J)) (tw-inl n J)) (r e J)) (\ J -> ME.sm-zr (tw (suc n) (inr J))) } ;
 vec1-tw : (n : Nat) (y : Ps.Fin n -> E.M) (J : C.Index n) -> Id E.M (E.sm (tw n J) (vec1 n y J)) (E.mneg (vec1 n y J)) = split {
  zero -> \ y J -> trans (ME.sm-zr (tw zero J)) (sym ME.mneg-z) ;
  suc n | r -> \ y -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (E.sm (tw (suc n) J) (vec1 (suc n) y J)) (E.mneg (vec1 (suc n) y J)))
   (\ J -> trans (ap (\ t -> E.sm t (vec1 n (\ i -> y (inl i)) J)) (tw-inl n J)) (r (\ i -> y (inl i)) J))
   (\ J -> trans (ap (\ t -> E.sm t (vec0 n (y (inr tt)) J)) (tw-inr n J))
    (trans (neg-sm (tw n J) (vec0 n (y (inr tt)) J)) (ap E.mneg (vec0-tw n (y (inr tt)) J)))) } ;

 -- values and supports
 vec0-empty : (n : Nat) (e : E.M) -> Id E.M (vec0 n e (G1.empty n)) e = split {
  zero -> \ e -> refl e ; suc n | r -> r } ;
 vec1-single-step (n : Nat) (y : Ps.Fin (suc n) -> E.M) (r : (y' : Ps.Fin n -> E.M) (i : Ps.Fin n) -> Id E.M (vec1 n y' (G1.single n i)) (y' i)) :
  (i : Ps.Fin (suc n)) -> Id E.M (vec1 (suc n) y (G1.single (suc n) i)) (y i) = split {
  inl i -> r (\ k -> y (inl k)) i ;
  inr t -> KX.top-fn (\ t' -> Id E.M (vec1 (suc n) y (G1.single (suc n) (inr t'))) (y (inr t'))) (vec0-empty n (y (inr tt))) t } ;
 vec1-single : (n : Nat) (y : Ps.Fin n -> E.M) (i : Ps.Fin n) -> Id E.M (vec1 n y (G1.single n i)) (y i) = split {
  zero -> \ y i -> efq i ;
  suc n | r -> \ y -> vec1-single-step n y r } ;
 suc-ne (m k : Nat) (ne : Not (Id Nat m k)) : Not (Id Nat (suc m) (suc k)) = \ e -> ne (suc-inj e) ;
 vec0-supp : (n : Nat) (e : E.M) -> KZ.Supp n zero (vec0 n e) = split {
  zero -> \ e I ne -> efq (ne (refl zero)) ;
  suc n | r -> \ e -> KX.plus-fn (C.Index n) (C.Index n) (\ I -> Not (Id Nat (BA.count (suc n) I) zero) -> Id E.M (vec0 (suc n) e I) E.mz)
   (\ I ne -> r e I ne) (\ I ne -> refl E.mz) } ;
 vec1-supp : (n : Nat) (y : Ps.Fin n -> E.M) -> KZ.Supp n (suc zero) (vec1 n y) = split {
  zero -> \ y I ne -> refl E.mz ;
  suc n | r -> \ y -> KX.plus-fn (C.Index n) (C.Index n) (\ I -> Not (Id Nat (BA.count (suc n) I) (suc zero)) -> Id E.M (vec1 (suc n) y I) E.mz)
   (\ I ne -> r (\ i -> y (inl i)) I ne) (\ I ne -> vec0-supp n (y (inr tt)) I (\ e -> ne (ap (\ k -> suc k) e))) } ;
 vec2-supp : (n : Nat) (x : Ps.Fin n -> Ps.Fin n -> E.M) -> KZ.Supp n (suc (suc zero)) (vec2 n x) = split {
  zero -> \ x I ne -> refl E.mz ;
  suc n | r -> \ x -> KX.plus-fn (C.Index n) (C.Index n) (\ I -> Not (Id Nat (BA.count (suc n) I) (suc (suc zero))) -> Id E.M (vec2 (suc n) x I) E.mz)
   (\ I ne -> r (\ i j -> x (inl i) (inl j)) I ne) (\ I ne -> vec1-supp n (\ i -> x (inl i) (inr tt)) I (\ e -> ne (ap (\ k -> suc k) e))) } ;
 -- concentration
 conc0 : (n : Nat) (u : (CF.V n).M) -> KZ.Supp n zero u -> (J : C.Index n) -> Id E.M (u J) (vec0 n (u (G1.empty n)) J) = split {
  zero -> \ u su -> KX.top-fn (\ J -> Id E.M (u J) (vec0 zero (u (G1.empty zero)) J)) (refl (u tt)) ;
  suc n | r -> \ u su -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (u J) (vec0 (suc n) (u (G1.empty (suc n))) J))
   (\ J -> r (\ I -> u (inl I)) (\ I ne -> su (inl I) ne) J)
   (\ J -> su (inr J) (\ e -> suc-zero (BA.count n J) e)) } ;
 conc1 : (n : Nat) (u : (CF.V n).M) -> KZ.Supp n (suc zero) u -> (J : C.Index n) -> Id E.M (u J) (vec1 n (\ i -> u (G1.single n i)) J) = split {
  zero -> \ u su J -> su J (\ e -> zero-suc zero e) ;
  suc n | r -> \ u su -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (u J) (vec1 (suc n) (\ i -> u (G1.single (suc n) i)) J))
   (\ J -> r (\ I -> u (inl I)) (\ I ne -> su (inl I) ne) J)
   (\ J -> conc0 n (\ I -> u (inr I)) (\ I ne -> su (inr I) (suc-ne (BA.count n I) zero ne)) J) } ;

 ---------------------------------------------------------------------
 -- d on vec0, vec1
 dvec0 : (n : Nat) (a : Ps.Fin n -> R) (e : E.M) (J : C.Index n) ->
  Id E.M (CF.apply n n KZ.K[n,a].wedge (vec0 n e) J) (vec1 n (\ i -> E.sm (a i) e) J) = split {
  zero -> \ a e J -> trans (ap (\ t -> E.sm t e) (RL[Rg].zero-mul o)) (ME.sm-zl e) ;
  suc n | r -> \ a e -> KX.plus-fn (C.Index n) (C.Index n)
   (\ J -> Id E.M (CF.apply (suc n) (suc n) KZ.K[suc n,a].wedge (vec0 (suc n) e) J) (vec1 (suc n) (\ i -> E.sm (a i) e) J))
   (\ J -> trans (KC.Step[n,a,vec0 (suc n) e].at-inl J) (r (\ k -> a (inl k)) e J))
   (\ J -> calc E.M {
     CF.apply (suc n) (suc n) KZ.K[suc n,a].wedge (vec0 (suc n) e) (inr J)
      =< KC.Step[n,a,vec0 (suc n) e].at-inr J >
     E.madd (E.sm (a (inr tt)) (E.sm (tw n J) (vec0 n e J))) (CF.apply n n KZ.K[n,\ k -> a (inl k)].wedge (CF.V n).mz J)
      =< ap (\ v -> E.madd (E.sm (a (inr tt)) (E.sm (tw n J) (vec0 n e J))) (v J)) CF.SM.Lin[CF.V n,CF.V n,CF.lin n n KZ.K[n,\ k -> a (inl k)].wedge].map-z >
     E.madd (E.sm (a (inr tt)) (E.sm (tw n J) (vec0 n e J))) E.mz
      =< E.maddZ (E.sm (a (inr tt)) (E.sm (tw n J) (vec0 n e J))) > E.sm (a (inr tt)) (E.sm (tw n J) (vec0 n e J))
      =< ap (E.sm (a (inr tt))) (vec0-tw n e J) > E.sm (a (inr tt)) (vec0 n e J)
      =< sym (vec0-sm n (a (inr tt)) e J) > vec0 n (E.sm (a (inr tt)) e) J }) } ;
 -- a_i y_j - a_j y_i
 alt (n : Nat) (a : Ps.Fin n -> R) (y : Ps.Fin n -> E.M) (i j : Ps.Fin n) : E.M = E.madd (E.sm (a i) (y j)) (E.mneg (E.sm (a j) (y i))) ;
 -- the inr part of d (vec1 y), for the parts a', c of a and y', y_last of y
 inr-part (n : Nat) (a' : Ps.Fin n -> R) (c : R) (y' : Ps.Fin n -> E.M) (yl : E.M) (J : C.Index n) :
  Id E.M (E.madd (E.sm c (E.sm (tw n J) (vec1 n y' J))) (vec1 n (\ i -> E.sm (a' i) yl) J))
   (vec1 n (\ i -> E.madd (E.sm (a' i) yl) (E.mneg (E.sm c (y' i)))) J) = calc E.M {
   E.madd (E.sm c (E.sm (tw n J) (vec1 n y' J))) (vec1 n (\ i -> E.sm (a' i) yl) J)
    =< E.maddC (E.sm c (E.sm (tw n J) (vec1 n y' J))) (vec1 n (\ i -> E.sm (a' i) yl) J) >
   E.madd (vec1 n (\ i -> E.sm (a' i) yl) J) (E.sm c (E.sm (tw n J) (vec1 n y' J)))
    =< ap (E.madd (vec1 n (\ i -> E.sm (a' i) yl) J)) (calc E.M {
       E.sm c (E.sm (tw n J) (vec1 n y' J))
        =< ap (E.sm c) (vec1-tw n y' J) > E.sm c (E.mneg (vec1 n y' J))
        =< ME.sm-neg c (vec1 n y' J) > E.mneg (E.sm c (vec1 n y' J))
        =< ap E.mneg (sym (vec1-sm n c y' J)) > E.mneg (vec1 n (\ i -> E.sm c (y' i)) J)
        =< sym (trans (vec1-sm n (neg o) (\ i -> E.sm c (y' i)) J) (trans (neg-sm o (vec1 n (\ i -> E.sm c (y' i)) J)) (ap E.mneg (E.smO (vec1 n (\ i -> E.sm c (y' i)) J))))) >
       vec1 n (\ i -> E.sm (neg o) (E.sm c (y' i))) J
        =< vec1-ext n (\ i -> E.sm (neg o) (E.sm c (y' i))) (\ i -> E.mneg (E.sm c (y' i)))
            (\ i -> trans (neg-sm o (E.sm c (y' i))) (ap E.mneg (E.smO (E.sm c (y' i))))) J >
       vec1 n (\ i -> E.mneg (E.sm c (y' i))) J }) >
   E.madd (vec1 n (\ i -> E.sm (a' i) yl) J) (vec1 n (\ i -> E.mneg (E.sm c (y' i))) J)
    =< sym (vec1-add n (\ i -> E.sm (a' i) yl) (\ i -> E.mneg (E.sm c (y' i))) J) >
   vec1 n (\ i -> E.madd (E.sm (a' i) yl) (E.mneg (E.sm c (y' i)))) J } ;
 dvec1 : (n : Nat) (a : Ps.Fin n -> R) (y : Ps.Fin n -> E.M) (J : C.Index n) ->
  Id E.M (CF.apply n n KZ.K[n,a].wedge (vec1 n y) J) (vec2 n (alt n a y) J) = split {
  zero -> \ a y J -> ap (\ v -> v J) CF.SM.Lin[CF.V zero,CF.V zero,CF.lin zero zero KZ.K[zero,a].wedge].map-z ;
  suc n | r -> \ a y -> KX.plus-fn (C.Index n) (C.Index n)
   (\ J -> Id E.M (CF.apply (suc n) (suc n) KZ.K[suc n,a].wedge (vec1 (suc n) y) J) (vec2 (suc n) (alt (suc n) a y) J))
   (\ J -> trans (KC.Step[n,a,vec1 (suc n) y].at-inl J) (r (\ k -> a (inl k)) (\ k -> y (inl k)) J))
   (\ J -> trans (KC.Step[n,a,vec1 (suc n) y].at-inr J)
     (trans (ap (E.madd (E.sm (a (inr tt)) (E.sm (tw n J) (vec1 n (\ k -> y (inl k)) J)))) (dvec0 n (\ k -> a (inl k)) (y (inr tt)) J))
      (inr-part n (\ k -> a (inl k)) (a (inr tt)) (\ k -> y (inl k)) (y (inr tt)) J))) } ;

 ---------------------------------------------------------------------
 -- vec2 of an alternating family vanishes only for x = 0
 AltFamily (n : Nat) (x : Ps.Fin n -> Ps.Fin n -> E.M) : U l =
  ((i j : Ps.Fin n) -> Id E.M (x j i) (E.mneg (x i j))) * ((i : Ps.Fin n) -> Id E.M (x i i) E.mz) ;
 module Vec2Zero (n : Nat) (x : Ps.Fin (suc n) -> Ps.Fin (suc n) -> E.M) (ax : AltFamily (suc n) x)
  (r : (i j : Ps.Fin n) -> Id E.M (x (inl i) (inl j)) E.mz) (last : (i : Ps.Fin n) -> Id E.M (x (inl i) (inr tt)) E.mz) {
  row-inl (i : Ps.Fin n) : (j : Ps.Fin (suc n)) -> Id E.M (x (inl i) j) E.mz = KX.plus-fn (Ps.Fin n) Top (\ j -> Id E.M (x (inl i) j) E.mz)
   (\ j -> r i j) (KX.top-fn (\ t -> Id E.M (x (inl i) (inr t)) E.mz) (last i)) ;
  row-inr (t : Top) : (j : Ps.Fin (suc n)) -> Id E.M (x (inr t) j) E.mz = KX.plus-fn (Ps.Fin n) Top (\ j -> Id E.M (x (inr t) j) E.mz)
   (\ j -> trans (ax.1 (inl j) (inr t)) (trans (ap E.mneg (row-inl j (inr t))) ME.mneg-z))
   (\ t' -> trans (ap (\ s -> x (inr t) (inr s)) (G1.top-eq t')) (trans (ap (\ s -> x (inr s) (inr tt)) (G1.top-eq t)) (ax.2 (inr tt)))) ;
  result (i j : Ps.Fin (suc n)) : Id E.M (x i j) E.mz =
   KX.plus-fn (Ps.Fin n) Top (\ i -> Id E.M (x i j) E.mz) (\ i -> row-inl i j) (\ t -> row-inr t j) i ;
 } ;
 vec2-inv : (n : Nat) (x : Ps.Fin n -> Ps.Fin n -> E.M) -> AltFamily n x -> ((J : C.Index n) -> Id E.M (vec2 n x J) E.mz) ->
  (i j : Ps.Fin n) -> Id E.M (x i j) E.mz = split {
  zero -> \ x ax h i -> efq i ;
  suc n | r -> \ x ax h -> Vec2Zero[n,x,ax,
    r (\ i j -> x (inl i) (inl j)) (\ i j -> ax.1 (inl i) (inl j),\ i -> ax.2 (inl i)) (\ J -> h (inl J)),
    \ i -> trans (sym (vec1-single n (\ k -> x (inl k) (inr tt)) i)) (h (inr (G1.single n i)))].result } ;
} ;
