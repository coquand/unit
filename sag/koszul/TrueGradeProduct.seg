-- cffr Proposition 6.6 with the true grade: Gr(I) >= k and Gr(K) >= k mod J
-- give Gr(P) >= k mod J for every list P with I_i K_j in (P) for all i, j
-- (in particular P generating I K).
--
-- (cons, ctete "we thus get") c in P regular mod J and Gr(P) >= k
-- mod (J, c) give Gr(P) >= k + 1 mod J: prepend c to a witness.
-- (Product) Induction on k.  Let f be the Kronecker polynomial of I over D
-- (in D[X]) and g that of K over D[X] (in D[X][Y]); f is regular mod J
-- since I is, g since K is (K stays regular in D[X]); so c = f g is regular
-- mod J (c x in J gives g x in J gives x in J).  c is in I, in K and in P
-- (f in I, g in K, and x g in P when x K_j in P for all j).  Over D[X][Y]
-- (base change twice) Gr(I) >= k + 1 and Gr(K) >= k + 1, so by Theorem 9
-- Gr(I) >= k and Gr(K) >= k mod (J, c); by induction Gr(P) >= k
-- mod (J, c); by cons Gr(P) >= k + 1 mod J over D[X][Y], and over D by the
-- tower.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ; module T9 = TrueGradeThm9[l] ; module TB = TrueGradeBase[l] ;

---------------------------------------------------------------------
-- cons
module Cons (D : TG.RD) (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (c : D.1.R)
 (ci : TG.InI D n I c) (rc : TG.RegEl D m J c) (w : (q : Nat) * TG.Seq D k (suc m) (TG.extend D m J c) n I q) {
 q : Nat = w.1 ;
 h (x : D.1.R) : (TG.ext q D).1.R = (TG.incl q D).1 x ;
 e : Ps.Fin (suc k) -> (TG.ext q D).1.R = Ps.snoc (Ps.Fin k) (TG.ext q D).1.R w.2.1 (h c) ;
 result : TG.Seq D (suc k) m J n I q =
  (e,KoszulExact[l].plus-fn (Ps.Fin k) Top (\ i -> TG.InI (TG.ext q D) n (TG.img q D n I) (e i)) w.2.2.1 (\ t -> TT.up-in q D n I c ci),
   (TT.up-el q D m J c rc,
    TT.regseq-list (TG.ext q D) k (suc m) (TG.img q D (suc m) (TG.extend D m J c)) (TG.extend (TG.ext q D) m (TG.img q D m J) (h c))
     (T9.img-extend q D m J c) w.2.1 w.2.2.2)) ;
} ;
cons (D : TG.RD) (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (c : D.1.R)
 (ci : TG.InI D n I c) (rc : TG.RegEl D m J c) (g : TG.TGr k D (suc m) (TG.extend D m J c) n I) : TG.TGr (suc k) D m J n I =
 TC.map ((q : Nat) * TG.Seq D k (suc m) (TG.extend D m J c) n I q) ((q : Nat) * TG.Seq D (suc k) m J n I q)
  (\ w -> (w.1,Cons[D,k,m,J,n,I,c,ci,rc,w].result)) g ;

---------------------------------------------------------------------
-- x g in (P) when g in (K) and x K_j in (P)
module MulIn (S : TG.RD) (q : Nat) (P : Ps.Fin q -> S.1.R) (n : Nat) (K : Ps.Fin n -> S.1.R) (x g : S.1.R)
 (hg : TG.InI S n K g) (h : (j : Ps.Fin n) -> TG.InI S q P (S.1.mul x (K j))) {
 module TI = TrueGradeIdeals[l].Over[S.1,S.2] ;
 module SS = FiniteIdeal[l].Sums[S.1] ;
 module L = RL[S.1] ;
 expand (v : Ps.Fin n -> S.1.R) : Id S.1.R (SS.sum n (\ j -> S.1.mul (v j) (S.1.mul x (K j)))) (S.1.mul x (SS.lin n K v)) =
  trans (SS.sum-cong n (\ j -> S.1.mul (v j) (S.1.mul x (K j))) (\ j -> S.1.mul x (S.1.mul (K j) (v j)))
    (\ j -> trans (L.mul-swap (v j) x (K j)) (ap (S.1.mul x) (S.1.mulC (v j) (K j)))))
   (SS.sum-scale x n (\ j -> S.1.mul (K j) (v j))) ;
 result : TG.InI S q P (S.1.mul x g) = TC.rec (SS.Coordinates n K g) @l (TG.InI S q P (S.1.mul x g)) (TI.in-prop q P (S.1.mul x g)) (\ v ->
  subst (TG.InI S q P) (trans (expand v.1) (ap (S.1.mul x) v.2))
   (TI.in-sum q P n (\ j -> S.1.mul (v.1 j) (S.1.mul x (K j))) (\ j -> RI.Generated[S.1,q,P].ideal.in-mul (v.1 j) (S.1.mul x (K j)) (h j)))) hg ;
} ;
-- a product of regular elements is regular
reg-mul (S : TG.RD) (m : Nat) (J : Ps.Fin m -> S.1.R) (f g : S.1.R) (rf : TG.RegEl S m J f) (rg : TG.RegEl S m J g) : TG.RegEl S m J (S.1.mul f g) =
 \ x t k -> rg x tt (rf (S.1.mul g x) tt (subst (TG.InI S m J) (sym (S.1.mulA f g x)) k)) ;

-- Gr(I) >= k + 1 gives Gr(I) >= 1
to-one : (k : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) ->
 TG.TGr (suc k) D m J n I -> TG.TGr (suc zero) D m J n I = split {
 zero -> \ D m J n I g -> g ;
 suc k | r -> \ D m J n I g -> r D m J n I (TG.mono (suc k) D m J n I g) } ;

---------------------------------------------------------------------
-- Proposition 6.6
ProdIn (D : TG.RD) (n : Nat) (I : Ps.Fin n -> D.1.R) (n' : Nat) (K : Ps.Fin n' -> D.1.R) (q : Nat) (P : Ps.Fin q -> D.1.R) : U l =
 (i : Ps.Fin n) (j : Ps.Fin n') -> TG.InI D q P (D.1.mul (I i) (K j)) ;
IH66 (k : Nat) : U l+ = (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (n' : Nat) (K : Ps.Fin n' -> D.1.R)
 (q : Nat) (P : Ps.Fin q -> D.1.R) -> ProdIn D n I n' K q P -> TG.TGr k D m J n I -> TG.TGr k D m J n' K -> TG.TGr k D m J q P ;
module Step66 (k : Nat) (r : IH66 k) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (n' : Nat) (K : Ps.Fin n' -> D.1.R)
 (q : Nat) (P : Ps.Fin q -> D.1.R) (hP : ProdIn D n I n' K q P) (gI : TG.TGr (suc k) D m J n I) (gK : TG.TGr (suc k) D m J n' K) {
 D1 : TG.RD = TG.ext1 D ;
 D2 : TG.RD = TG.ext1 D1 ;
 c1 (x : D.1.R) : D1.1.R = TG.PolyX[D].X.constant x ;
 c2 (x : D1.1.R) : D2.1.R = TG.PolyX[D1].X.constant x ;
 cc (x : D.1.R) : D2.1.R = c2 (c1 x) ;
 hom2 : RH.Hom D.1 D2.1 = RH.compose D.1 D1.1 D2.1 TG.PolyX[D1].X.inclusion TG.PolyX[D].X.inclusion ;
 J1 : Ps.Fin m -> D1.1.R = \ i -> c1 (J i) ;
 J2 : Ps.Fin m -> D2.1.R = \ i -> cc (J i) ;
 I2 : Ps.Fin n -> D2.1.R = \ i -> cc (I i) ;
 K1 : Ps.Fin n' -> D1.1.R = \ i -> c1 (K i) ;
 K2 : Ps.Fin n' -> D2.1.R = \ i -> cc (K i) ;
 P2 : Ps.Fin q -> D2.1.R = \ i -> cc (P i) ;
 -- I, K regular mod J; K stays regular over D[X]
 rI : TG.RegId D m J n I = T9.gr1-to D m J n I (to-one k D m J n I gI) ;
 rK : TG.RegId D m J n' K = T9.gr1-to D m J n' K (to-one k D m J n' K gK) ;
 rK1 : TG.RegId D1 m J1 n' K1 = PolyRegularMod[l].Over[D.1,D.2,m,J].Ideal[n',K].up rK ;
 -- f, g and c = f g
 f : D1.1.R = T9.Kron[D].f n I ;
 g : D2.1.R = T9.Kron[D1].f n' K1 ;
 cE : D2.1.R = D2.1.mul (c2 f) g ;
 fI2 : TG.InI D2 n I2 (c2 f) = TT.Up1[D1].inI n (\ i -> c1 (I i)) f (T9.Kron[D].f-in n I) ;
 gK2 : TG.InI D2 n' K2 g = T9.Kron[D1].f-in n' K1 ;
 cJ : TG.RegEl D2 m J2 cE = reg-mul D2 m J2 (c2 f) g (TT.Up1[D1].el m J1 f (T9.Kron[D].f-reg m J n I rI)) (T9.Kron[D1].f-reg m J1 n' K1 rK1) ;
 cI : TG.InI D2 n I2 cE = subst (TG.InI D2 n I2) (D2.1.mulC g (c2 f)) (RI.Generated[D2.1,n,I2].ideal.in-mul g (c2 f) fI2) ;
 cK : TG.InI D2 n' K2 cE = RI.Generated[D2.1,n',K2].ideal.in-mul (c2 f) g gK2 ;
 hP2 : ProdIn D2 n I2 n' K2 q P2 = \ i j -> subst (TG.InI D2 q P2) (hom2.2.2.2 (I i) (K j)) (TB.hom-in D D2 hom2 q P (D.1.mul (I i) (K j)) (hP i j)) ;
 cP : TG.InI D2 q P2 cE = MulIn[D2,q,P2,n',K2,c2 f,g,gK2,\ j ->
   subst (TG.InI D2 q P2) (D2.1.mulC (K2 j) (c2 f))
    (MulIn[D2,q,P2,n,I2,K2 j,c2 f,fI2,\ i -> subst (TG.InI D2 q P2) (D2.1.mulC (I2 i) (K2 j)) (hP2 i j)].result)].result ;
 -- Theorem 9 for I and K over D[X][Y], then induction mod (J, c)
 tI : TG.TGr k D2 (suc m) (TG.extend D2 m J2 cE) n I2 =
  T9.thm9 k D2 m J2 n I2 cE cI cJ (TB.base-change (suc k) D1 m J1 n (\ i -> c1 (I i)) (TB.base-change (suc k) D m J n I gI)) ;
 tK : TG.TGr k D2 (suc m) (TG.extend D2 m J2 cE) n' K2 =
  T9.thm9 k D2 m J2 n' K2 cE cK cJ (TB.base-change (suc k) D1 m J1 n' K1 (TB.base-change (suc k) D m J n' K gK)) ;
 ih : TG.TGr k D2 (suc m) (TG.extend D2 m J2 cE) q P2 = r D2 (suc m) (TG.extend D2 m J2 cE) n I2 n' K2 q P2 hP2 tI tK ;
 result : TG.TGr (suc k) D m J q P = TT.tower (suc k) D m J q P (suc (suc zero)) (cons D2 k m J2 q P2 cE cP cJ ih) ;
} ;
prop66 : (k : Nat) -> IH66 k = split {
 zero -> \ D m J n I n' K q P hP gI gK -> T9.gr0 D m J q P ;
 suc k | r -> \ D m J n I n' K q P hP gI gK -> Step66[k,r,D,m,J,n,I,n',K,q,P,hP,gI,gK].result } ;
