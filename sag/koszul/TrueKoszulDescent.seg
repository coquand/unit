-- Descent of the Koszul grade along D -> D[X], for the quotients D/J
-- (step (A1) of the comparison, CFFR-DESIGN §2).
--
-- Exterior coefficients along a ring map h (cffr/BaseChange): coeff (B x) =
-- h (coeff x), B e_I = e_I, so the Koszul matrix coefficient
-- coeff_J (a ^ e_I) goes to coeff_J (h a ^ e_I) (wedge-coeff).  Hence an
-- additive map phi : E -> E' with phi (r u) = h(r) phi(u) commutes with
-- the Koszul differentials of a and h a (DTransfer).
-- psi : D/J -> D[X]/J, [t] |-> [t] (constants), and phi : D[X]/J -> D/J,
-- [g] |-> [g(0)] (ev0), are such maps, along D -> D[X] and ev0, and
-- phi psi = id.  So a cocycle alpha over D gives the cocycle psi alpha over
-- D[X]; if psi alpha = d beta then alpha = phi psi alpha = d (phi beta)
-- (in degree 0, psi alpha = 0 gives alpha = 0).  Thus Gr(a; D[X]/J) >= k
-- gives Gr(a; D/J) >= k, and by induction along ext p.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Bj = Bijection[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ; module TG = TrueGrade[l] ; module TB = TrueGradeBase[l] ;
module KX = KoszulExact[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

---------------------------------------------------------------------
-- exterior coefficients along a ring map
module ExtBase (A B : TG.RD) (h : RH.Hom A.1 B.1) {
 module BC = BaseChange[l].Over[A.1,B.1,h] ;
 module CA = C.Over[A.1,A.2] ; module CB = C.Over[B.1,B.2] ;
 B-coeff : (n : Nat) (x : BC.M.Ext n) (J : C.Index n) -> Id B.1.R (CB.coeff n (BC.B n x) J) (h.1 (CA.coeff n x J)) = split {
  zero -> \ x J -> refl (h.1 x) ;
  suc n | r -> \ x -> split { inl J -> r x.1 J ; inr J -> r x.2 J } } ;
 B-basis : (n : Nat) (I : C.Index n) -> Id (BC.N.Ext n) (BC.B n (CA.basis n I)) (CB.basis n I) = split {
  zero -> \ I -> BC.f-one ;
  suc n | r -> split { inl I -> BC.pair (r I) (BC.B-zero n) ; inr I -> BC.pair (BC.B-zero n) (r I) } } ;
 wedge-coeff (n : Nat) (a : Ps.Fin n -> A.1.R) (I J : C.Index n) :
  Id B.1.R (h.1 (CA.coeff n (BC.M.emul n (BC.M.gen n a) (CA.basis n I)) J)) (CB.coeff n (BC.N.emul n (BC.N.gen n (\ k -> h.1 (a k))) (CB.basis n I)) J) =
  trans (sym (B-coeff n (BC.M.emul n (BC.M.gen n a) (CA.basis n I)) J))
   (ap (\ w -> CB.coeff n w J) (trans (BC.B-mul n (BC.M.gen n a) (CA.basis n I))
    (trans (ap (\ g -> BC.N.emul n g (BC.B n (CA.basis n I))) (BC.B-gen n a)) (ap (BC.N.emul n (BC.N.gen n (\ k -> h.1 (a k)))) (B-basis n I))))) ;
} ;
-- the size of a subset does not depend on the ring
count-same (A B : TG.RD) : (n : Nat) (I : C.Index n) -> Id Nat (ExteriorBasis[l].Over[A.1,A.2].count n I) (ExteriorBasis[l].Over[B.1,B.2].count n I) = split {
 zero -> \ I -> refl zero ;
 suc n | r -> split { inl I -> r I ; inr I -> ap (\ k -> suc k) (r I) } } ;
-- semilinear maps commute with Koszul differentials
module DTransfer (A B : TG.RD) (h : RH.Hom A.1 B.1)
 (EA : A7.Mod[RingBridge[l].Over[A.1,A.2].ring]) (EB : A7.Mod[RingBridge[l].Over[B.1,B.2].ring]) (phi : EA.M -> EB.M)
 (phi-add : (u v : EA.M) -> Id EB.M (phi (EA.madd u v)) (EB.madd (phi u) (phi v)))
 (phi-sm : (r : A.1.R) (u : EA.M) -> Id EB.M (phi (EA.sm r u)) (EB.sm (h.1 r) (phi u))) (n : Nat) (a : Ps.Fin n -> A.1.R) {
 module KA = Koszul[l].Over[A.1,A.2,EA] ; module KB = Koszul[l].Over[B.1,B.2,EB] ;
 module EBa = ExtBase[A,B,h] ;
 d-map (u : (KA.CF.V n).M) (J : C.Index n) :
  Id EB.M (phi (KA.CF.apply n n KA.K[n,a].wedge u J)) (KB.CF.apply n n KB.K[n,\ k -> h.1 (a k)].wedge (\ I -> phi (u I)) J) =
  trans (C.SumMap[EA.M,EB.M,EA.madd,EB.madd,phi,phi-add].map n (\ I -> EA.sm (EBa.CA.coeff n (KA.K[n,a].wedge (EBa.CA.basis n I)) J) (u I)))
   (KB.CF.SE.cong n (\ I -> phi (EA.sm (EBa.CA.coeff n (KA.K[n,a].wedge (EBa.CA.basis n I)) J) (u I)))
    (\ I -> EB.sm (EBa.CB.coeff n (KB.K[n,\ k -> h.1 (a k)].wedge (EBa.CB.basis n I)) J) (phi (u I)))
    (\ I -> trans (phi-sm (EBa.CA.coeff n (KA.K[n,a].wedge (EBa.CA.basis n I)) J) (u I))
     (ap (\ r -> EB.sm r (phi (u I))) (EBa.wedge-coeff n a I J)))) ;
} ;

---------------------------------------------------------------------
-- one indeterminate
module Down (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R) {
 module TQ = TrueKoszulQuot[l].Over[D.1,D.2] ;
 module TQ1 = TrueKoszulQuot[l].Over[(TG.ext1 D).1,(TG.ext1 D).2] ;
 module Q = TQ.QJ[m,J].Q ;
 module Q1 = TQ1.QJ[m,\ i -> TG.PolyX[D].X.constant (J i)].Q ;
 module PR = PolyRegular[l].Over[D.1,D.2] ;
 E : TQ.MO.Module = TQ.quot m J ;
 E1 : TQ1.MO.Module = TQ1.quot m (\ i -> TG.PolyX[D].X.constant (J i)) ;
 -- constants and ev0 on differences
 c-sub (t t' : D.1.R) : Id (TG.ext1 D).1.R (TG.PolyX[D].X.constant (Q.MP.sub t' t)) (Q1.MP.sub (TG.PolyX[D].X.constant t') (TG.PolyX[D].X.constant t)) =
  trans (TG.PolyX[D].X.inclusion.2.2.1 t' (D.1.neg t)) (ap ((TG.ext1 D).1.add (TG.PolyX[D].X.constant t')) (RH.negation D.1 (TG.ext1 D).1 TG.PolyX[D].X.inclusion t)) ;
 e-sub (g g' : (TG.ext1 D).1.R) : Id D.1.R (PR.ev0.1 (Q1.MP.sub g' g)) (Q.MP.sub (PR.ev0.1 g') (PR.ev0.1 g)) =
  trans (PR.ev0.2.2.1 g' ((TG.ext1 D).1.neg g)) (ap (D.1.add (PR.ev0.1 g')) (RH.negation (TG.ext1 D).1 D.1 PR.ev0 g)) ;
 -- psi
 resp (t t' : D.1.R) (r : Q.rel t t') : Id Q1.C (Q1.inc (TG.PolyX[D].X.constant t)) (Q1.inc (TG.PolyX[D].X.constant t')) =
  Q1.Q.relates (TG.PolyX[D].X.constant t) (TG.PolyX[D].X.constant t')
   (subst RI.Generated[(TG.ext1 D).1,m,\ i -> TG.PolyX[D].X.constant (J i)].In (c-sub t t')
    (TB.hom-in D (TG.ext1 D) TG.PolyX[D].X.inclusion m J (Q.MP.sub t' t) r)) ;
 module PSI = Q.Q.Descend[Q1.C,Q1.Q.set,\ t -> Q1.inc (TG.PolyX[D].X.constant t),resp] ;
 psi (u : Q.C) : Q1.C = PSI.map u ;
 -- phi
 resp' (g g' : (TG.ext1 D).1.R) (r : Q1.rel g g') : Id Q.C (Q.inc (PR.ev0.1 g)) (Q.inc (PR.ev0.1 g')) =
  Q.Q.relates (PR.ev0.1 g) (PR.ev0.1 g') (subst RI.Generated[D.1,m,J].In (e-sub g g')
   (TB.ini-list D m (\ i -> PR.ev0.1 (TG.PolyX[D].X.constant (J i))) J (\ i -> PR.ev0-constant (J i)) (PR.ev0.1 (Q1.MP.sub g' g))
    (TB.hom-in (TG.ext1 D) D PR.ev0 m (\ i -> TG.PolyX[D].X.constant (J i)) (Q1.MP.sub g' g) r))) ;
 module PHI = Q1.Q.Descend[Q.C,Q.Q.set,\ g -> Q.inc (PR.ev0.1 g),resp'] ;
 phi (u : Q1.C) : Q.C = PHI.map u ;
 -- laws
 -- the laws, on representatives, in the quotients' own terms
 psi-add-inc (s t : D.1.R) : Id Q1.C (psi (Q.add (Q.inc s) (Q.inc t))) (Q1.add (psi (Q.inc s)) (psi (Q.inc t))) = calc Q1.C {
  psi (Q.add (Q.inc s) (Q.inc t)) =< ap psi (Q.add-inc s t) > psi (Q.inc (D.1.add s t))
   =< PSI.beta (D.1.add s t) > Q1.inc (TG.PolyX[D].X.constant (D.1.add s t))
   =< ap Q1.inc (TG.PolyX[D].X.inclusion.2.2.1 s t) > Q1.inc ((TG.ext1 D).1.add (TG.PolyX[D].X.constant s) (TG.PolyX[D].X.constant t))
   =< sym (Q1.add-inc (TG.PolyX[D].X.constant s) (TG.PolyX[D].X.constant t)) > Q1.add (Q1.inc (TG.PolyX[D].X.constant s)) (Q1.inc (TG.PolyX[D].X.constant t))
   =< ap (\ w -> Q1.add w (Q1.inc (TG.PolyX[D].X.constant t))) (sym (PSI.beta s)) > Q1.add (psi (Q.inc s)) (Q1.inc (TG.PolyX[D].X.constant t))
   =< ap (Q1.add (psi (Q.inc s))) (sym (PSI.beta t)) > Q1.add (psi (Q.inc s)) (psi (Q.inc t)) } ;
 PsiAdd (u v : Q.C) : U l = Id Q1.C (psi (Q.add u v)) (Q1.add (psi u) (psi v)) ;
 psi-add (u v : Q.C) : PsiAdd u v =
  Q.Ind1 (\ u -> (v : Q.C) -> PsiAdd u v)
   (\ s v -> Q.Ind1 (PsiAdd (Q.inc s)) (psi-add-inc s) (\ v -> Q1.Q.set _ _) v)
   (\ u -> F.isProp-Pi Q.C (PsiAdd u) (\ v -> Q1.Q.set _ _)) u v ;
 psi-sm-inc (r t : D.1.R) : Id Q1.C (psi (Q.scale r (Q.inc t))) (Q1.scale (TG.PolyX[D].X.constant r) (psi (Q.inc t))) = calc Q1.C {
  psi (Q.scale r (Q.inc t)) =< ap psi (Q.Scale[r].D.beta t) > psi (Q.inc (D.1.mul r t))
   =< PSI.beta (D.1.mul r t) > Q1.inc (TG.PolyX[D].X.constant (D.1.mul r t))
   =< ap Q1.inc (TG.PolyX[D].X.inclusion.2.2.2 r t) > Q1.inc ((TG.ext1 D).1.mul (TG.PolyX[D].X.constant r) (TG.PolyX[D].X.constant t))
   =< sym (Q1.Scale[TG.PolyX[D].X.constant r].D.beta (TG.PolyX[D].X.constant t)) > Q1.scale (TG.PolyX[D].X.constant r) (Q1.inc (TG.PolyX[D].X.constant t))
   =< ap (Q1.scale (TG.PolyX[D].X.constant r)) (sym (PSI.beta t)) > Q1.scale (TG.PolyX[D].X.constant r) (psi (Q.inc t)) } ;
 PsiSm (r : D.1.R) (u : Q.C) : U l = Id Q1.C (psi (Q.scale r u)) (Q1.scale (TG.PolyX[D].X.constant r) (psi u)) ;
 psi-sm (r : D.1.R) (u : Q.C) : PsiSm r u = Q.Ind1 (PsiSm r) (psi-sm-inc r) (\ u -> Q1.Q.set _ _) u ;
 phi-add-inc (s t : (TG.ext1 D).1.R) : Id Q.C (phi (Q1.add (Q1.inc s) (Q1.inc t))) (Q.add (phi (Q1.inc s)) (phi (Q1.inc t))) = calc Q.C {
  phi (Q1.add (Q1.inc s) (Q1.inc t)) =< ap phi (Q1.add-inc s t) > phi (Q1.inc ((TG.ext1 D).1.add s t))
   =< PHI.beta ((TG.ext1 D).1.add s t) > Q.inc (PR.ev0.1 ((TG.ext1 D).1.add s t))
   =< ap Q.inc (PR.ev0.2.2.1 s t) > Q.inc (D.1.add (PR.ev0.1 s) (PR.ev0.1 t))
   =< sym (Q.add-inc (PR.ev0.1 s) (PR.ev0.1 t)) > Q.add (Q.inc (PR.ev0.1 s)) (Q.inc (PR.ev0.1 t))
   =< ap (\ w -> Q.add w (Q.inc (PR.ev0.1 t))) (sym (PHI.beta s)) > Q.add (phi (Q1.inc s)) (Q.inc (PR.ev0.1 t))
   =< ap (Q.add (phi (Q1.inc s))) (sym (PHI.beta t)) > Q.add (phi (Q1.inc s)) (phi (Q1.inc t)) } ;
 PhiAdd (u v : Q1.C) : U l = Id Q.C (phi (Q1.add u v)) (Q.add (phi u) (phi v)) ;
 phi-add (u v : Q1.C) : PhiAdd u v =
  Q1.Ind1 (\ u -> (v : Q1.C) -> PhiAdd u v)
   (\ s v -> Q1.Ind1 (PhiAdd (Q1.inc s)) (phi-add-inc s) (\ v -> Q.Q.set _ _) v)
   (\ u -> F.isProp-Pi Q1.C (PhiAdd u) (\ v -> Q.Q.set _ _)) u v ;
 phi-sm-inc (r t : (TG.ext1 D).1.R) : Id Q.C (phi (Q1.scale r (Q1.inc t))) (Q.scale (PR.ev0.1 r) (phi (Q1.inc t))) = calc Q.C {
  phi (Q1.scale r (Q1.inc t)) =< ap phi (Q1.Scale[r].D.beta t) > phi (Q1.inc ((TG.ext1 D).1.mul r t))
   =< PHI.beta ((TG.ext1 D).1.mul r t) > Q.inc (PR.ev0.1 ((TG.ext1 D).1.mul r t))
   =< ap Q.inc (PR.ev0.2.2.2 r t) > Q.inc (D.1.mul (PR.ev0.1 r) (PR.ev0.1 t))
   =< sym (Q.Scale[PR.ev0.1 r].D.beta (PR.ev0.1 t)) > Q.scale (PR.ev0.1 r) (Q.inc (PR.ev0.1 t))
   =< ap (Q.scale (PR.ev0.1 r)) (sym (PHI.beta t)) > Q.scale (PR.ev0.1 r) (phi (Q1.inc t)) } ;
 PhiSm (r : (TG.ext1 D).1.R) (u : Q1.C) : U l = Id Q.C (phi (Q1.scale r u)) (Q.scale (PR.ev0.1 r) (phi u)) ;
 phi-sm (r : (TG.ext1 D).1.R) (u : Q1.C) : PhiSm r u = Q1.Ind1 (PhiSm r) (phi-sm-inc r) (\ u -> Q.Q.set _ _) u ;
 phi-psi (u : E.M) : Id E.M (phi (psi u)) u =
  Q.Ind1 (\ u -> Id E.M (phi (psi u)) u)
   (\ t -> trans (ap phi (PSI.beta t)) (trans (PHI.beta (TG.PolyX[D].X.constant t)) (ap Q.inc (PR.ev0-constant t))))
   (\ u -> E.setM _ _) u ;
 psi-zero : Id E1.M (psi E.mz) E1.mz = trans (PSI.beta D.1.z) (ap Q1.inc (RH.zero D.1 (TG.ext1 D).1 TG.PolyX[D].X.inclusion)) ;
 phi-zero : Id E.M (phi E1.mz) E.mz = trans (PHI.beta (TG.ext1 D).1.z) (ap Q.inc (RH.zero (TG.ext1 D).1 D.1 PR.ev0)) ;
 -- the Koszul complexes
 module KD = Koszul[l].Over[D.1,D.2,E] ;
 module KD1 = Koszul[l].Over[(TG.ext1 D).1,(TG.ext1 D).2,E1] ;
 a1 : Ps.Fin n -> (TG.ext1 D).1.R = \ k -> TG.PolyX[D].X.constant (a k) ;
 module CK = TQ.GR.CX.Cx[KD.K[n,a].complex] ;
 module CK1 = TQ1.GR.CX.Cx[KD1.K[n,a1].complex] ;
 module TPsi = DTransfer[D,TG.ext1 D,TG.PolyX[D].X.inclusion,E,E1,psi,psi-add,psi-sm,n,a] ;
 module TPhi = DTransfer[TG.ext1 D,D,PR.ev0,E1,E,phi,phi-add,phi-sm,n,a1] ;
 -- ev0 (constant a) = a
 d-phi (w : (KD1.CF.V n).M) (J : C.Index n) :
  Id E.M (phi (KD1.CF.apply n n KD1.K[n,a1].wedge w J)) (KD.CF.apply n n KD.K[n,a].wedge (\ I -> phi (w I)) J) =
  trans (TPhi.d-map w J) (ap (\ L -> KD.CF.apply n n KD.K[n,L].wedge (\ I -> phi (w I)) J)
   (F.funext (Ps.Fin n) (\ k -> D.1.R) (\ k -> PR.ev0.1 (a1 k)) a (\ k -> PR.ev0-constant (a k)))) ;
 -- the two maps on degree k
 up (k : Nat) (u : KD.Deg[n,k].S.E) : KD1.Deg[n,k].S.E = (\ I -> psi (u.1 I),\ I ne -> trans (ap psi (u.2 I (\ e -> ne (trans (sym (count-same D (TG.ext1 D) n I)) e)))) psi-zero) ;
 down (k : Nat) (w : KD1.Deg[n,k].S.E) : KD.Deg[n,k].S.E = (\ I -> phi (w.1 I),\ I ne -> trans (ap phi (w.2 I (\ e -> ne (trans (sym (count-same (TG.ext1 D) D n I)) e)))) phi-zero) ;
 up-cocycle (k : Nat) (u : CK.M k) (c : CK.Cocycle k u) : CK1.Cocycle k (up k u) =
  KD1.Deg[n,suc k].S.eq (KD1.K[n,a1].dmap k (up k u)) (CK1.o (suc k)) (KD1.CF.veq n (KD1.CF.apply n n KD1.K[n,a1].wedge (up k u).1) (KD1.CF.V n).mz
   (\ J -> trans (sym (TPsi.d-map u.1 J)) (trans (ap (\ t -> psi (t.1 J)) c) psi-zero))) ;
 -- on vectors: psi u = 0 gives u = 0; d w = psi u gives d (phi w) = u
 zero-vec (u : (KD.CF.V n).M) (h : Id (KD1.CF.V n).M (\ I -> psi (u I)) (KD1.CF.V n).mz) : Id (KD.CF.V n).M u (KD.CF.V n).mz =
  KD.CF.veq n u (KD.CF.V n).mz (\ I -> trans (sym (phi-psi (u I))) (trans (ap (\ t -> phi (t I)) h) phi-zero)) ;
 bnd-vec (u : (KD.CF.V n).M) (w : (KD1.CF.V n).M) (h : Id (KD1.CF.V n).M (KD1.CF.apply n n KD1.K[n,a1].wedge w) (\ I -> psi (u I))) :
  Id (KD.CF.V n).M (KD.CF.apply n n KD.K[n,a].wedge (\ I -> phi (w I))) u =
  KD.CF.veq n (KD.CF.apply n n KD.K[n,a].wedge (\ I -> phi (w I))) u (\ J -> trans (sym (d-phi w J)) (trans (ap (\ t -> phi (t J)) h) (phi-psi (u J)))) ;
 -- H^k vanishing goes down
 vanish : (k : Nat) -> CK1.Vanish k -> CK.Vanish k = split {
  zero -> \ v u c -> KD.Deg[n,zero].S.eq u (CK.o zero) (zero-vec u.1 (ap (\ t -> t.1) (v (up zero u) (up-cocycle zero u c)))) ;
  suc j -> \ v u c -> TC.map (Bj.Fibre (CK1.d j) (up (suc j) u)) (Bj.Fibre (CK.d j) u)
   (\ b -> (down j b.1,KD.Deg[n,suc j].S.eq (KD.K[n,a].dmap j (down j b.1)) u (bnd-vec u.1 b.1.1 (ap (\ t -> t.1) b.2))))
   (v (up (suc j) u) (up-cocycle (suc j) u c)) } ;
 upto : (k : Nat) -> CK1.Upto k -> CK.Upto k = split {
  zero -> \ g -> tt ;
  suc k | r -> \ g -> (r g.1,vanish k g.2) } ;
} ;
-- along ext p
down-step (p : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R) (k : Nat)
 (g : Grade[l].Over[(TG.ext1 (TG.ext p D)).1,(TG.ext1 (TG.ext p D)).2].Gr
  (TrueKoszulQuot[l].Over[(TG.ext1 (TG.ext p D)).1,(TG.ext1 (TG.ext p D)).2].quot m (\ i -> TG.PolyX[TG.ext p D].X.constant (TG.img p D m J i)))
  n (\ i -> TG.PolyX[TG.ext p D].X.constant (TG.img p D n a i)) k) :
 Grade[l].Over[(TG.ext p D).1,(TG.ext p D).2].Gr (TrueKoszulQuot[l].Over[(TG.ext p D).1,(TG.ext p D).2].quot m (TG.img p D m J)) n (TG.img p D n a) k =
 Down[TG.ext p D,m,TG.img p D m J,n,TG.img p D n a].upto k g ;
down-p : (p : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R) (k : Nat) ->
 Grade[l].Over[(TG.ext p D).1,(TG.ext p D).2].Gr (TrueKoszulQuot[l].Over[(TG.ext p D).1,(TG.ext p D).2].quot m (TG.img p D m J)) n (TG.img p D n a) k ->
 Grade[l].Over[D.1,D.2].Gr (TrueKoszulQuot[l].Over[D.1,D.2].quot m J) n a k = split {
 zero -> \ D m J n a k g -> g ;
 suc p | r -> \ D m J n a k g -> r D m J n a k (down-step p D m J n a k g) } ;
