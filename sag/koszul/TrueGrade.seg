-- The true grade (ctete Definition 5), relative to a finitely generated
-- ideal J (coordinator's decision: "modulo" is elementwise, no quotient
-- rings).
--
-- Rings come with their set condition (RD).  Indeterminates are adjoined
-- one at a time, on top: ext 0 D = D, ext (p+1) D = (ext p D)[X], with the
-- inclusion D -> ext p D (incl); a list in D is carried along it (img).
-- "a regular mod J" and "I regular mod J" are RegularIdeal's, for R acting
-- modulo the ideal Generated by J.
--
-- A regular sequence mod J (RegSeq) a_1, ..., a_k: a_1 regular mod J,
-- a_2 regular mod (J, a_1), ...; as a list on Fin k, the head is at the
-- last index (inr tt), the rest on inl.  Gr(I) >= k mod J (ctete Def. 5):
-- merely, after p new indeterminates, I contains a regular sequence mod J
-- of length k.  Dropping the last term gives Gr(I) >= k from
-- Gr(I) >= k + 1 (mono).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
-- a ring and its set condition
RD : U l+ = (Rg : CRing) * Pr.isSet Rg.R ;
module PolyX (D : RD) { module X = PolynomialRing[l].Extension[D.1,D.2] ; } ;
-- one new indeterminate
ext1 (D : RD) : RD = (PolyX[D].X.ring,PolyX[D].X.set) ;
-- p new indeterminates, the last on top
ext : Nat -> RD -> RD = split { zero -> \ D -> D ; suc p | r -> \ D -> ext1 (r D) } ;
incl : (p : Nat) (D : RD) -> RH.Hom D.1 (ext p D).1 = split {
 zero -> \ D -> RH.identity D.1 ;
 suc p | r -> \ D -> RH.compose D.1 (ext p D).1 (ext1 (ext p D)).1 PolyX[ext p D].X.inclusion (r D) } ;
img (p : Nat) (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) : Ps.Fin m -> (ext p D).1.R = \ i -> (incl p D).1 (J i) ;
-- a regular mod J, I regular mod J
RegEl (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (a : D.1.R) : U l =
 RI.Over[D.1,RI.modulo D.1 (RI.Generated[D.1,m,J].ideal)].ElementUnder (\ x -> Top) a ;
RegId (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) : U l =
 RI.Over[D.1,RI.modulo D.1 (RI.Generated[D.1,m,J].ideal)].Regular (Ps.Fin n) I ;
-- membership in the ideal generated by I
InI (D : RD) (n : Nat) (I : Ps.Fin n -> D.1.R) (x : D.1.R) : U l = RI.Generated[D.1,n,I].In x ;
-- (J, c)
extend (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (c : D.1.R) : Ps.Fin (suc m) -> D.1.R = Ps.snoc (Ps.Fin m) D.1.R J c ;
-- a regular sequence mod J
RegSeq (D : RD) : (k : Nat) (m : Nat) -> (Ps.Fin m -> D.1.R) -> (Ps.Fin k -> D.1.R) -> U l = split {
 zero -> \ m J a -> Top ;
 suc k | r -> \ m J a -> RegEl D m J (a (inr tt)) * r (suc m) (extend D m J (a (inr tt))) (\ i -> a (inl i)) } ;
-- in I
InSeq (D : RD) (n : Nat) (I : Ps.Fin n -> D.1.R) (k : Nat) (a : Ps.Fin k -> D.1.R) : U l = (i : Ps.Fin k) -> InI D n I (a i) ;
-- Gr(I) >= k mod J
Seq (D : RD) (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (p : Nat) : U l =
 (a : Ps.Fin k -> (ext p D).1.R) * InSeq (ext p D) n (img p D n I) k a * RegSeq (ext p D) k m (img p D m J) a ;
TGr (k : Nat) (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) : U l =
 Tr.Trunc[(p : Nat) * Seq D k m J n I p].carrier ;
tgr-prop (k : Nat) (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) : Pr.isProp (TGr k D m J n I) =
 Tr.Trunc[(p : Nat) * Seq D k m J n I p].proposition ;

-- dropping the last term
drop : (k : Nat) (A : U l) -> (Ps.Fin (suc k) -> A) -> Ps.Fin k -> A = split {
 zero -> \ A a i -> efq i ;
 suc k | r -> \ A a -> Ps.snoc (Ps.Fin k) A (r A (\ i -> a (inl i))) (a (inr tt)) } ;
drop-reg (D : RD) : (k m : Nat) (J : Ps.Fin m -> D.1.R) (a : Ps.Fin (suc k) -> D.1.R) -> RegSeq D (suc k) m J a -> RegSeq D k m J (drop k D.1.R a) = split {
 zero -> \ m J a h -> tt ;
 suc k | r -> \ m J a h -> (h.1,r (suc m) (extend D m J (a (inr tt))) (\ i -> a (inl i)) h.2) } ;
drop-in (A : U l) (P : A -> U l) : (k : Nat) (a : Ps.Fin (suc k) -> A) -> ((i : Ps.Fin (suc k)) -> P (a i)) -> (i : Ps.Fin k) -> P (drop k A a i) = split {
 zero -> \ a h i -> efq i ;
 suc k | r -> \ a h -> KoszulExact[l].plus-fn (Ps.Fin k) Top (\ i -> P (drop (suc k) A a i))
  (r (\ i -> a (inl i)) (\ i -> h (inl i))) (KoszulExact[l].top-fn (\ t -> P (drop (suc k) A a (inr t))) (h (inr tt))) } ;
-- Gr(I) >= k + 1 gives Gr(I) >= k
mono (k : Nat) (D : RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (g : TGr (suc k) D m J n I) : TGr k D m J n I =
 TC.map ((p : Nat) * Seq D (suc k) m J n I p) ((p : Nat) * Seq D k m J n I p)
  (\ w -> (w.1,drop k (ext w.1 D).1.R w.2.1,drop-in (ext w.1 D).1.R (InI (ext w.1 D) n (img w.1 D n I)) k w.2.1 w.2.2.1,
   drop-reg (ext w.1 D) k m (img w.1 D m J) w.2.1 w.2.2.2)) g ;
