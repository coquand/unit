-- C(a; -) is a functor, exact on short exact sequences (cffr §5.2: "any
-- map E -> F defines canonically a complex map C_k(a; E) -> C_k(a; F)
-- and if E -> F -> G is exact then so is C_k(a; E) -> C_k(a; F) -> C_k(a; G)").
--
-- A linear phi : E -> F acts on coefficient vectors coordinatewise; it
-- commutes with every f_E, since phi (sum_I r_I alpha_I) = sum_I r_I
-- phi(alpha_I) (commute), and it keeps supports since phi 0 = 0.  So it
-- is a map of Koszul complexes.
-- For 0 -> E -i-> F -p-> G -> 0 exact, the maps of complexes form a short
-- exact sequence, coordinatewise: i is injective and p i = 0 in each
-- coordinate; a vector y with p y = 0 has merely a preimage in each
-- coordinate, hence (choice over the finite type Index n, by induction
-- on n) merely a preimage vector, of the same degree since i e_I = y_I = 0
-- forces e_I = 0; a vector z of degree k has merely, in each coordinate I,
-- a preimage w_I, which we take to be 0 when |I| /= k (then z_I = 0), so
-- that the lift has degree k.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Bj = Bijection[l] ;
-- choice over Index n
top-fn (P : Top -> U l) (p : P tt) : (I : Top) -> P I = split { tt -> p } ;
plus-fn (A B : U l) (P : Plus A B -> U l) (f : (a : A) -> P (inl a)) (g : (b : B) -> P (inr b)) : (x : Plus A B) -> P x = split {
 inl a -> f a ; inr b -> g b } ;
choice : (n : Nat) (P : C.Index n -> U l) -> ((I : C.Index n) -> Tr.Trunc[P I].carrier) -> Tr.Trunc[(I : C.Index n) -> P I].carrier = split {
 zero -> \ P h -> TC.map (P tt) ((I : C.Index zero) -> P I) (top-fn P) (h tt) ;
 suc n | r -> \ P h -> TC.map2 ((I : C.Index n) -> P (inl I)) ((I : C.Index n) -> P (inr I)) ((I : C.Index (suc n)) -> P I)
  (plus-fn (C.Index n) (C.Index n) P) (r (\ I -> P (inl I)) (\ I -> h (inl I))) (r (\ I -> P (inr I)) (\ I -> h (inr I))) } ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module CO = C.Over[Rg,setR] ;
 module CX = Complexes[l].Over[MO.ring] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 ---------------------------------------------------------------------
 -- functoriality
 module Fun (E F : MO.Module) (phi : SM.Linear E F) (n : Nat) (a : Ps.Fin n -> R) {
  module KE = Koszul[l].Over[Rg,setR,E] ; module KF = Koszul[l].Over[Rg,setR,F] ;
  module LE = KE.K[n,a] ; module LF = KF.K[n,a] ;
  module LP = SM.Lin[E,F,phi] ;
  vmap (k : Nat) (u : (KE.CF.V k).M) : (KF.CF.V k).M = \ I -> phi.1 (u I) ;
  commute (k m : Nat) (f : Ext k -> Ext m) (u : (KE.CF.V k).M) :
   Id (KF.CF.V m).M (KF.CF.apply k m f (vmap k u)) (vmap m (KE.CF.apply k m f u)) =
   KF.CF.veq m (KF.CF.apply k m f (vmap k u)) (vmap m (KE.CF.apply k m f u)) (\ J -> sym (calc F.M {
    phi.1 (KE.CF.SE.sum k (\ I -> E.sm (CO.coeff m (f (CO.basis k I)) J) (u I)))
     =< C.SumMap[E.M,F.M,E.madd,F.madd,phi.1,phi.2.1].map k (\ I -> E.sm (CO.coeff m (f (CO.basis k I)) J) (u I)) >
    KF.CF.SE.sum k (\ I -> phi.1 (E.sm (CO.coeff m (f (CO.basis k I)) J) (u I)))
     =< KF.CF.SE.cong k (\ I -> phi.1 (E.sm (CO.coeff m (f (CO.basis k I)) J) (u I))) (\ I -> F.sm (CO.coeff m (f (CO.basis k I)) J) (phi.1 (u I)))
          (\ I -> phi.2.2 (CO.coeff m (f (CO.basis k I)) J) (u I)) >
    KF.CF.SE.sum k (\ I -> F.sm (CO.coeff m (f (CO.basis k I)) J) (phi.1 (u I))) })) ;
  supp-map (p : Nat) (u : (KE.CF.V n).M) (su : KE.Supp n p u) : KF.Supp n p (vmap n u) = \ I ne ->
   trans (ap phi.1 (su I ne)) LP.map-z ;
  dmap (p : Nat) (u : KE.Deg[n,p].S.E) : KF.Deg[n,p].S.E = (vmap n u.1,supp-map p u.1 u.2) ;
  lin-map (p : Nat) : SM.Linear (LE.Ck p) (LF.Ck p) = (dmap p,
   \ u v -> KF.Deg[n,p].S.eq (dmap p ((LE.Ck p).madd u v)) ((LF.Ck p).madd (dmap p u) (dmap p v))
    (KF.CF.veq n (vmap n ((KE.CF.V n).madd u.1 v.1)) ((KF.CF.V n).madd (vmap n u.1) (vmap n v.1)) (\ I -> phi.2.1 (u.1 I) (v.1 I))),
   \ c u -> KF.Deg[n,p].S.eq (dmap p ((LE.Ck p).sm c u)) ((LF.Ck p).sm c (dmap p u))
    (KF.CF.veq n (vmap n ((KE.CF.V n).sm c u.1)) ((KF.CF.V n).sm c (vmap n u.1)) (\ I -> phi.2.2 c (u.1 I)))) ;
  sq (p : Nat) (u : KE.Deg[n,p].S.E) : Id KF.Deg[n,suc p].S.E (LF.dmap p (dmap p u)) (dmap (suc p) (LE.dmap p u)) =
   KF.Deg[n,suc p].S.eq (LF.dmap p (dmap p u)) (dmap (suc p) (LE.dmap p u)) (commute n n LE.wedge u.1) ;
  map : CX.Map[LE.complex,LF.complex] = new CX.Map[LE.complex,LF.complex,lin-map,sq] ;
 } ;

 ---------------------------------------------------------------------
 -- exactness
 module Ses (E F G : MO.Module) (i : SM.Linear E F) (p : SM.Linear F G)
  (inj : Bj.Injective i.1) (pi : (x : E.M) -> Id G.M (p.1 (i.1 x)) G.mz)
  (ex : (y : F.M) -> Id G.M (p.1 y) G.mz -> Tr.Trunc[Bj.Fibre i.1 y].carrier)
  (onto : (z : G.M) -> Tr.Trunc[Bj.Fibre p.1 z].carrier) (n : Nat) (a : Ps.Fin n -> R) {
  module FI = Fun[E,F,i,n,a] ; module FP = Fun[F,G,p,n,a] ;
  module KE = FI.KE ; module KF = FI.KF ; module KG = FP.KF ;
  module LI = SM.Lin[E,F,i] ; module LP = SM.Lin[F,G,p] ;
  inj-k (k : Nat) : Bj.Injective (FI.dmap k) = \ u v h -> KE.Deg[n,k].S.eq u v
   (KE.CF.veq n u.1 v.1 (\ I -> inj (u.1 I) (v.1 I) (ap (\ t -> t.1 I) h))) ;
  pi-k (k : Nat) (x : KE.Deg[n,k].S.E) : Id KG.Deg[n,k].S.E (FP.dmap k (FI.dmap k x)) (KG.Deg[n,k].S.carrier).mz =
   KG.Deg[n,k].S.eq (FP.dmap k (FI.dmap k x)) (KG.Deg[n,k].S.carrier).mz (KG.CF.veq n (FP.vmap n (FI.vmap n x.1)) (KG.CF.V n).mz (\ I -> pi (x.1 I))) ;
  -- ker p in im i, by choice over Index n
  module Ex (k : Nat) (y : KF.Deg[n,k].S.E) (h : Id KG.Deg[n,k].S.E (FP.dmap k y) (KG.Deg[n,k].S.carrier).mz) {
   lift (c : (I : C.Index n) -> Bj.Fibre i.1 (y.1 I)) : Bj.Fibre (FI.dmap k) y =
    ((\ I -> (c I).1,\ I ne -> inj (c I).1 E.mz (trans (c I).2 (trans (y.2 I ne) (sym LI.map-z)))),
     KF.Deg[n,k].S.eq (FI.dmap k (\ I -> (c I).1,\ I ne -> inj (c I).1 E.mz (trans (c I).2 (trans (y.2 I ne) (sym LI.map-z))))) y
      (KF.CF.veq n (FI.vmap n (\ I -> (c I).1)) y.1 (\ I -> (c I).2))) ;
   result : Tr.Trunc[Bj.Fibre (FI.dmap k) y].carrier =
    TC.map ((I : C.Index n) -> Bj.Fibre i.1 (y.1 I)) (Bj.Fibre (FI.dmap k) y) lift
     (choice n (\ I -> Bj.Fibre i.1 (y.1 I)) (\ I -> ex (y.1 I) (ap (\ t -> t.1 I) h))) ;
  } ;
  -- p onto, keeping degrees
  module Onto (k : Nat) (z : KG.Deg[n,k].S.E) {
   P (I : C.Index n) : U l = (w : F.M) * Id G.M (p.1 w) (z.1 I) * (Not (Id Nat (BA.count n I) k) -> Id F.M w F.mz) ;
   point (I : C.Index n) : Plus (Id Nat (BA.count n I) k) (Not (Id Nat (BA.count n I) k)) ->
    Tr.Trunc[P I].carrier = split {
    inl e -> TC.map (Bj.Fibre p.1 (z.1 I)) (P I) (\ w -> (w.1,w.2,\ ne -> efq (ne e))) (onto (z.1 I)) ;
    inr ne -> Tr.Trunc[P I].inc (F.mz,trans LP.map-z (sym (z.2 I ne)),\ ne' -> refl F.mz) } ;
   lift (c : (I : C.Index n) -> P I) : Bj.Fibre (FP.dmap k) z =
    ((\ I -> (c I).1,\ I ne -> (c I).2.2 ne),
     KG.Deg[n,k].S.eq (FP.dmap k (\ I -> (c I).1,\ I ne -> (c I).2.2 ne)) z (KG.CF.veq n (FP.vmap n (\ I -> (c I).1)) z.1 (\ I -> (c I).2.1))) ;
   result : Tr.Trunc[Bj.Fibre (FP.dmap k) z].carrier =
    TC.map ((I : C.Index n) -> P I) (Bj.Fibre (FP.dmap k) z) lift
     (choice n P (\ I -> point I (Koszul[l].DecNat.dec (BA.count n I) k))) ;
  } ;
  ses : CX.SES[FI.LE.complex,FI.LF.complex,FP.LF.complex] = new CX.SES[FI.LE.complex,FI.LF.complex,FP.LF.complex,FI.map,FP.map,
   inj-k,pi-k,\ k y h -> Ex[k,y,h].result,\ k z -> Onto[k,z].result] ;
 } ;
} ;
