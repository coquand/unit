-- Ideals generated by lists, for the true grade (ring D, list J).
--
-- x is in (J, a) iff merely x - a w is in J for some w (coordinates of
-- (J, a) are those of J and one more for a).  So RelRegular's Z + (a)
-- (with Z = (J)) and the ideal Generated by (J, a) have the same elements,
-- and regularity modulo one is regularity modulo the other (plus-*).
-- Regularity and regular sequences only depend on the elements of the
-- ideal (same-*); (J, a, f) and (J, f, a) have the same elements
-- (swap-same).  If c is in I and regular mod L then I is regular mod L:
-- I x in L gives c x = sum_i v_i (I_i x) in L (elem-ideal).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module TG = TrueGrade[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 D : TG.RD = (Rg,setR) ;
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 sub (x y : R) : R = add x (neg y) ;
 In (m : Nat) (K : Ps.Fin m -> R) (x : R) : U l = RI.Generated[Rg,m,K].In x ;
 in-prop (m : Nat) (K : Ps.Fin m -> R) (x : R) : Pr.isProp (In m K x) = RI.Generated[Rg,m,K].in-prop x ;
 -- ring identities
 add-sub (y x : R) : Id R (add y (sub x y)) x =
  trans (addC y (sub x y)) (trans (sym (addA x (neg y) y)) (trans (ap (add x) (L.neg-cancel y)) (addZ x))) ;
 sub-add (y u : R) : Id R (sub (add y u) y) u = trans (ap (\ t -> sub t y) (addC y u)) (L.add-neg-cancel u y) ;
 sub-sub (x p q : R) : Id R (sub (sub x p) q) (sub (sub x q) p) =
  trans (sym (addA x (neg p) (neg q))) (trans (ap (add x) (addC (neg p) (neg q))) (addA x (neg q) (neg p))) ;

 ---------------------------------------------------------------------
 -- x in (J, a) iff x - a w in J
 module Plus (m : Nat) (J : Ps.Fin m -> R) (a : R) {
  K : Ps.Fin (suc m) -> R = TG.extend D m J a ;
  to (x w : R) (h : In m J (sub x (mul a w))) : In (suc m) K x =
   TC.map (S.Coordinates m J (sub x (mul a w))) (S.Coordinates (suc m) K x)
    (\ v -> (Ps.snoc (Ps.Fin m) R v.1 w,trans (ap (add (mul a w)) v.2) (add-sub (mul a w) x))) h ;
  from-coords (x : R) (v : S.Coordinates (suc m) K x) : (w : R) * In m J (sub x (mul a w)) =
   (v.1 (inr tt),Tr.Trunc[S.Coordinates m J (sub x (mul a (v.1 (inr tt))))].inc (\ i -> v.1 (inl i),
    sym (trans (ap (\ t -> sub t (mul a (v.1 (inr tt)))) (sym v.2)) (sub-add (mul a (v.1 (inr tt))) (S.lin m J (\ i -> v.1 (inl i))))))) ;
  from (x : R) (h : In (suc m) K x) : Tr.Trunc[(w : R) * In m J (sub x (mul a w))].carrier =
   TC.map (S.Coordinates (suc m) K x) ((w : R) * In m J (sub x (mul a w))) (from-coords x) h ;
  -- with RelRegular modulo (J)
  module RR = RelRegular[l].Over[Rg,RI.Generated[Rg,m,J].ideal] ;
  plus-to (x : R) (h : RR.InMod a x) : In (suc m) K x =
   TC.rec ((w : R) * RR.Cong x (mul a w)) @l (In (suc m) K x) (in-prop (suc m) K x) (\ u -> to x u.1 u.2) h ;
  plus-from (x : R) (h : In (suc m) K x) : RR.InMod a x = from x h ;
  reg-id-to (n : Nat) (I : Ps.Fin n -> R) (h : RR.RegIdealMod a n I) : TG.RegId D (suc m) K n I =
   \ x t k -> plus-to x (h x tt (\ i -> plus-from (mul (I i) x) (k i))) ;
  reg-id-from (n : Nat) (I : Ps.Fin n -> R) (h : TG.RegId D (suc m) K n I) : RR.RegIdealMod a n I =
   \ x t k -> plus-from x (h x tt (\ i -> plus-to (mul (I i) x) (k i))) ;
  reg-el-to (b : R) (h : RR.RegModMod a b) : TG.RegEl D (suc m) K b =
   \ x t k -> plus-to x (h x tt (plus-from (mul b x) k)) ;
  reg-el-from (b : R) (h : TG.RegEl D (suc m) K b) : RR.RegModMod a b =
   \ x t k -> plus-from x (h x tt (plus-to (mul b x) k)) ;
 } ;

 ---------------------------------------------------------------------
 -- lists with the same elements
 Same (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) : U l =
  (x : R) -> (In m1 L1 x -> In m2 L2 x) * (In m2 L2 x -> In m1 L1 x) ;
 same-el (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : Same m1 L1 m2 L2) (b : R)
  (r : TG.RegEl D m1 L1 b) : TG.RegEl D m2 L2 b = \ x t k -> (h x).1 (r x tt ((h (mul b x)).2 k)) ;
 same-id (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : Same m1 L1 m2 L2) (n : Nat) (I : Ps.Fin n -> R)
  (r : TG.RegId D m1 L1 n I) : TG.RegId D m2 L2 n I = \ x t k -> (h x).1 (r x tt (\ i -> (h (mul (I i) x)).2 (k i))) ;
 same-ext (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : Same m1 L1 m2 L2) (c : R) :
  Same (suc m1) (TG.extend D m1 L1 c) (suc m2) (TG.extend D m2 L2 c) = \ x ->
  (\ e -> TC.rec ((w : R) * In m1 L1 (sub x (mul c w))) @l (In (suc m2) (TG.extend D m2 L2 c) x) (in-prop (suc m2) (TG.extend D m2 L2 c) x)
     (\ u -> Plus[m2,L2,c].to x u.1 ((h (sub x (mul c u.1))).1 u.2)) (Plus[m1,L1,c].from x e),
   \ e -> TC.rec ((w : R) * In m2 L2 (sub x (mul c w))) @l (In (suc m1) (TG.extend D m1 L1 c) x) (in-prop (suc m1) (TG.extend D m1 L1 c) x)
     (\ u -> Plus[m1,L1,c].to x u.1 ((h (sub x (mul c u.1))).2 u.2)) (Plus[m2,L2,c].from x e)) ;
 same-seq : (k m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : Same m1 L1 m2 L2) (a : Ps.Fin k -> R) ->
  TG.RegSeq D k m1 L1 a -> TG.RegSeq D k m2 L2 a = split {
  zero -> \ m1 L1 m2 L2 h a s -> tt ;
  suc k | r -> \ m1 L1 m2 L2 h a s -> (same-el m1 L1 m2 L2 h (a (inr tt)) s.1,
   r (suc m1) (TG.extend D m1 L1 (a (inr tt))) (suc m2) (TG.extend D m2 L2 (a (inr tt))) (same-ext m1 L1 m2 L2 h (a (inr tt))) (\ i -> a (inl i)) s.2) } ;
 -- (J, a, f) and (J, f, a)
 module Swap (m : Nat) (J : Ps.Fin m -> R) (a f : R) {
  one (x : R) (e : In (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J a) f) x) : In (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J f) a) x =
   TC.rec ((w : R) * In (suc m) (TG.extend D m J a) (sub x (mul f w))) @l (In (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J f) a) x)
    (in-prop (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J f) a) x) (\ u ->
    TC.rec ((w : R) * In m J (sub (sub x (mul f u.1)) (mul a w))) @l (In (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J f) a) x)
     (in-prop (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J f) a) x) (\ u' ->
     Plus[suc m,TG.extend D m J f,a].to x u'.1 (Plus[m,J,f].to (sub x (mul a u'.1)) u.1
      (subst (In m J) (sub-sub x (mul f u.1) (mul a u'.1)) u'.2)))
     (Plus[m,J,a].from (sub x (mul f u.1)) u.2)) (Plus[suc m,TG.extend D m J a,f].from x e) ;
 } ;
 swap-same (m : Nat) (J : Ps.Fin m -> R) (a f : R) :
  Same (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J a) f) (suc (suc m)) (TG.extend D (suc m) (TG.extend D m J f) a) =
  \ x -> (Swap[m,J,a,f].one x,Swap[m,J,f,a].one x) ;

 ---------------------------------------------------------------------
 -- an element of I regular mod L makes I regular mod L
 in-sum (m : Nat) (K : Ps.Fin m -> R) : (n : Nat) (v : Ps.Fin n -> R) -> ((i : Ps.Fin n) -> In m K (v i)) -> In m K (S.sum n v) = split {
  zero -> \ v h -> RI.Generated[Rg,m,K].ideal.in-zero ;
  suc n | r -> \ v h -> RI.Generated[Rg,m,K].ideal.in-add (v (inr tt)) (S.sum n (\ i -> v (inl i))) (h (inr tt)) (r (\ i -> v (inl i)) (\ i -> h (inl i))) } ;
 module ElemIdeal (m : Nat) (K : Ps.Fin m -> R) (n : Nat) (I : Ps.Fin n -> R) (c : R) (ci : TG.InI D n I c) (rc : TG.RegEl D m K c)
  (x : R) (k : (i : Ps.Fin n) -> In m K (mul (I i) x)) {
  expand (v : Ps.Fin n -> R) : Id R (S.sum n (\ i -> mul (v i) (mul (I i) x))) (mul (S.lin n I v) x) = sym (calc R {
   mul (S.sum n (\ i -> mul (I i) (v i))) x =< mulC (S.sum n (\ i -> mul (I i) (v i))) x > mul x (S.sum n (\ i -> mul (I i) (v i)))
    =< sym (S.sum-scale x n (\ i -> mul (I i) (v i))) > S.sum n (\ i -> mul x (mul (I i) (v i)))
    =< S.sum-cong n (\ i -> mul x (mul (I i) (v i))) (\ i -> mul (v i) (mul (I i) x)) (\ i ->
       trans (L.mul-swap x (I i) (v i)) (trans (ap (mul (I i)) (mulC x (v i))) (L.mul-swap (I i) (v i) x))) >
   S.sum n (\ i -> mul (v i) (mul (I i) x)) }) ;
  cx : In m K (mul c x) = TC.rec (S.Coordinates n I c) @l (In m K (mul c x)) (in-prop m K (mul c x)) (\ v ->
   subst (In m K) (trans (expand v.1) (ap (\ t -> mul t x) v.2))
    (in-sum m K n (\ i -> mul (v.1 i) (mul (I i) x)) (\ i -> RI.Generated[Rg,m,K].ideal.in-mul (v.1 i) (mul (I i) x) (k i)))) ci ;
  result : In m K x = rc x tt cx ;
 } ;
 elem-ideal (m : Nat) (K : Ps.Fin m -> R) (n : Nat) (I : Ps.Fin n -> R) (c : R) (ci : TG.InI D n I c) (rc : TG.RegEl D m K c) :
  TG.RegId D m K n I = \ x t k -> ElemIdeal[m,K,n,I,c,ci,rc,x,k].result ;
} ;
