-- cffr §6, item 1: Gr(a; E) >= 1 iff a_1, ..., a_N is regular for E
-- (a_i x = 0 for all i gives x = 0).
--
-- Coordinates.  The empty subset (all generators absent) and the
-- singletons {i}; |I| = 0 forces I = empty, |J| = 1 forces J = {i}
-- (induction on n, from the clauses of count).  The coefficient of 1 at
-- the empty subset is 1, the coefficient of a = gen a at {i} is a_i.
--
-- A vector of degree 0 is concentrated at the empty subset:
-- u = 1 (x) u_empty (Coefficients.tens), since coeff_I(1) = 0 for
-- |I| /= 0 (1 has degree 0).  And d (1 (x) e) = (a ^ 1) (x) e = a (x) e
-- (apply-tens), whose coefficient at {i} is a_i e and which vanishes at
-- |J| /= 1.  So 1 (x) e is a cocycle iff a_i e = 0 for all i, and
-- H^0(a; E) = 0 says exactly that such e are 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module CO = C.Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = ExteriorHomogeneous[l].Over[Rg,setR] ;
 module MO = Modules[l].Over[Rg,setR] ;
 module GR = Grade[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 ---------------------------------------------------------------------
 -- the empty subset and the singletons
 empty : (n : Nat) -> C.Index n = split { zero -> tt ; suc n | r -> inl r } ;
 single-step (n : Nat) (r : Ps.Fin n -> C.Index n) : Ps.Fin (suc n) -> C.Index (suc n) = split {
  inl i -> inl (r i) ; inr t -> inr (empty n) } ;
 single : (n : Nat) -> Ps.Fin n -> C.Index n = split {
  zero -> \ i -> efq i ; suc n | r -> single-step n r } ;
 count-empty : (n : Nat) -> Id Nat (BA.count n (empty n)) zero = split { zero -> refl zero ; suc n | r -> r } ;
 -- |I| = 0 forces I = empty
 top-eq : (t : Top) -> Id Top t tt = split { tt -> refl tt } ;
 classify0 : (n : Nat) (I : C.Index n) -> Id Nat (BA.count n I) zero -> Id (C.Index n) I (empty n) = split {
  zero -> \ I e -> top-eq I ;
  suc n | r -> split {
   inl I -> \ e -> ap (\ J -> inl J) (r I e) ;
   inr I -> \ e -> efq (suc-zero (BA.count n I) e) } } ;
 -- |J| = 1 forces J = {i}
 Single (n : Nat) (J : C.Index n) : U l = (i : Ps.Fin n) * Id (C.Index n) J (single n i) ;
 classify1-inl (n : Nat) (J : C.Index n) (w : Single n J) : Single (suc n) (inl J) = (inl w.1,ap (\ K -> inl K) w.2) ;
 classify1 : (n : Nat) (J : C.Index n) -> Id Nat (BA.count n J) (suc zero) -> Single n J = split {
  zero -> \ J e -> efq (zero-suc zero e) ;
  suc n | r -> split {
   inl J -> \ e -> classify1-inl n J (r J e) ;
   inr J -> \ e -> (inr tt,ap (\ K -> inr K) (classify0 n J (suc-inj e))) } } ;
 -- coefficients
 coeff-emb-empty : (n : Nat) (c : R) -> Id R (CO.coeff n (emb n c) (empty n)) c = split {
  zero -> \ c -> refl c ; suc n | r -> r } ;
 coeff-one-empty (n : Nat) : Id R (CO.coeff n (eone n) (empty n)) o = coeff-emb-empty n o ;
 coeff-gen-step (n : Nat) (a : Ps.Fin (suc n) -> R) (r : (b : Ps.Fin n -> R) (i : Ps.Fin n) -> Id R (CO.coeff n (gen n b) (single n i)) (b i)) :
  (i : Ps.Fin (suc n)) -> Id R (CO.coeff (suc n) (gen (suc n) a) (single (suc n) i)) (a i) = split {
  inl i -> r (\ k -> a (inl k)) i ;
  inr t -> KoszulExact[l].top-fn (\ t' -> Id R (CO.coeff (suc n) (gen (suc n) a) (single (suc n) (inr t'))) (a (inr t'))) (coeff-emb-empty n (a (inr tt))) t } ;
 coeff-gen-single : (n : Nat) (a : Ps.Fin n -> R) (i : Ps.Fin n) -> Id R (CO.coeff n (gen n a) (single n i)) (a i) = split {
  zero -> \ a i -> efq i ;
  suc n | r -> \ a -> coeff-gen-step n a r } ;

 ---------------------------------------------------------------------
 -- a module as an R-set with zero (RegularIdeal.Action)
 action (E : MO.Module) : RegularIdeal[l].Action[Rg] =
  RegularIdeal[l].mkAction Rg E.M (\ x -> Id E.M x E.mz) E.sm (\ a b x -> sym (E.smA a b x)) E.smO
   (\ b x h -> trans (ap (E.sm b) h) (A7.MA[MO.ring,E].sm-zr b)) ;
 module Item1 (E : MO.Module) (N : Nat) (a : Ps.Fin N -> R) {
  module KZ = Koszul[l].Over[Rg,setR,E] ;
  module CF = KZ.CF ; module ME = CF.ME ;
  module KA = KZ.K[N,a] ;
  -- a is E-regular (cffr/RegularIdeal)
  module RI = RegularIdeal[l].Over[Rg,action E] ;
  Regular : U l = RI.Regular (Ps.Fin N) a ;
  -- 1 (x) e, of degree 0
  one-supp (e : E.M) : KZ.Supp N zero (CF.tens N (eone N) e) = \ I ne ->
   trans (ap (\ c -> E.sm c e) (HO.coeff-support N zero (eone N) (DG.deg-emb N o) I ne)) (ME.sm-zl e) ;
  one-vec (e : E.M) : KZ.Deg[N,zero].S.E = (CF.tens N (eone N) e,one-supp e) ;
  one-at-empty (e : E.M) : Id E.M (CF.tens N (eone N) e (empty N)) e =
   trans (ap (\ c -> E.sm c e) (coeff-one-empty N)) (E.smO e) ;
  -- d (1 (x) e) = a (x) e
  d-one (e : E.M) : Id (CF.V N).M (CF.apply N N KA.wedge (CF.tens N (eone N) e)) (CF.tens N (gen N a) e) =
   trans (CF.apply-tens N N KA.wedge KA.wedge-linear (eone N) e) (ap (\ x -> CF.tens N x e) (EA.one-right N (gen N a))) ;
  -- a vector of degree 0 is 1 (x) u_empty
  module Conc (u : KZ.Deg[N,zero].S.E) (I : C.Index N) {
   at-empty : Id E.M (u.1 (empty N)) (CF.tens N (eone N) (u.1 (empty N)) (empty N)) = sym (one-at-empty (u.1 (empty N))) ;
   case : Plus (Id Nat (BA.count N I) zero) (Not (Id Nat (BA.count N I) zero)) ->
    Id E.M (u.1 I) (CF.tens N (eone N) (u.1 (empty N)) I) = split {
    inl e -> subst (\ J -> Id E.M (u.1 J) (CF.tens N (eone N) (u.1 (empty N)) J)) (sym (classify0 N I e)) at-empty ;
    inr ne -> trans (u.2 I ne) (sym (one-supp (u.1 (empty N)) I ne)) } ;
   result : Id E.M (u.1 I) (CF.tens N (eone N) (u.1 (empty N)) I) = case (Koszul[l].DecNat.dec (BA.count N I) zero) ;
  } ;
  concentrated (u : KZ.Deg[N,zero].S.E) : Id (CF.V N).M u.1 (CF.tens N (eone N) (u.1 (empty N))) =
   CF.veq N u.1 (CF.tens N (eone N) (u.1 (empty N))) (\ I -> Conc[u,I].result) ;
  -- a (x) e vanishes iff a_i e = 0 for all i
  module Vanishes (e : E.M) (h : (i : Ps.Fin N) -> Id E.M (E.sm (a i) e) E.mz) (J : C.Index N) {
   case : Plus (Id Nat (BA.count N J) (suc zero)) (Not (Id Nat (BA.count N J) (suc zero))) ->
    Id E.M (CF.tens N (gen N a) e J) E.mz = split {
    inl c -> subst (\ K -> Id E.M (CF.tens N (gen N a) e K) E.mz) (sym (classify1 N J c).2)
     (trans (ap (\ x -> E.sm x e) (coeff-gen-single N a (classify1 N J c).1)) (h (classify1 N J c).1)) ;
    inr nc -> trans (ap (\ x -> E.sm x e) (HO.coeff-support N (suc zero) (gen N a) (DG.deg-gen N a) J nc)) (ME.sm-zl e) } ;
   result : Id E.M (CF.tens N (gen N a) e J) E.mz = case (Koszul[l].DecNat.dec (BA.count N J) (suc zero)) ;
  } ;
  -- Gr(a; E) >= 1 gives regularity
  forward (g : GR.Gr E N a (suc zero)) : Regular = \ e t h ->
   trans (sym (one-at-empty e)) (ap (\ v -> v.1 (empty N)) (g.2 (one-vec e)
    (KZ.Deg[N,suc zero].S.eq (KA.dmap zero (one-vec e)) (KA.Ck (suc zero)).mz
     (trans (d-one e) (CF.veq N (CF.tens N (gen N a) e) (CF.V N).mz (\ J -> Vanishes[e,h,J].result)))))) ;
  -- regularity gives Gr(a; E) >= 1
  module Back (reg : Regular) (u : KZ.Deg[N,zero].S.E) (c : Id (CF.V N).M (CF.apply N N KA.wedge u.1) (CF.V N).mz) {
   e : E.M = u.1 (empty N) ;
   d-u : Id (CF.V N).M (CF.tens N (gen N a) e) (CF.V N).mz =
    trans (sym (d-one e)) (trans (ap (CF.apply N N KA.wedge) (sym (concentrated u))) c) ;
   e-zero : Id E.M e E.mz = reg e tt (\ i -> trans (sym (ap (\ x -> E.sm x e) (coeff-gen-single N a i))) (ap (\ v -> v (single N i)) d-u)) ;
   result : Id (CF.V N).M u.1 (CF.V N).mz = trans (concentrated u)
    (CF.veq N (CF.tens N (eone N) e) (CF.V N).mz (\ I -> trans (ap (E.sm (CO.coeff N (eone N) I)) e-zero) (ME.sm-zr (CO.coeff N (eone N) I)))) ;
  } ;
  back (reg : Regular) : GR.Gr E N a (suc zero) = (tt,\ u c ->
   KZ.Deg[N,zero].S.eq u (KA.Ck zero).mz (Back[reg,u,ap (\ t -> t.1) c].result)) ;
 } ;
} ;
