-- Base change of the true grade along D -> D[X]: Gr(I) >= k mod J over D
-- gives Gr(I) >= k mod J over D[X] (the new variable goes BELOW the
-- variables of a witness).
--
-- (Maps) A ring map h preserves regularity when a regular mod L gives
-- h a regular mod h L.  Then it carries regular sequences (preserves-seq)
-- and membership (hom-in: it keeps linear combinations).  The constant
-- inclusion S -> S[X] preserves regularity (PolyRegularMod.element-up), so
-- does an isomorphism (pull the membership back with the inverse), and so
-- does a composite.
-- (Polynomials) By the universal property of A[X] (polynomial/Universal):
-- a map A -> B gives A[X] -> B[X] (constants by the map, X to X); two maps
-- out of A[X] that agree on constants and on X agree; the swap of A[X][Y]
-- (X <-> Y, constants of A fixed) is its own inverse.
-- (Commutation) theta_p : ext1 (ext p D) ~ ext p (ext1 D) by induction:
-- theta_0 = id, theta_(p+1) = (theta_p)[Y] o swap.  It sends the constant
-- of incl_p x to incl_p of the constant of x.
-- (Base change) phi_p = theta_p o (constants) : ext p D -> ext p (ext1 D)
-- preserves regularity and sends the images of D to the images of D[X];
-- a witness over ext p D gives one over ext p (ext1 D).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

---------------------------------------------------------------------
-- maps preserving regularity
hom-in (S S' : TG.RD) (h : RH.Hom S.1 S'.1) (n : Nat) (I : Ps.Fin n -> S.1.R) (x : S.1.R) (e : TG.InI S n I x) :
 TG.InI S' n (\ i -> h.1 (I i)) (h.1 x) =
 TC.map (FiniteIdeal[l].Sums[S.1].Coordinates n I x) (FiniteIdeal[l].Sums[S'.1].Coordinates n (\ i -> h.1 (I i)) (h.1 x))
  (\ v -> (\ i -> h.1 (v.1 i),trans (sym (StandardOpens[l].SumMap[S.1,S'.1,h].combination n I v.1)) (ap h.1 v.2))) e ;
ini-list (S : TG.RD) (n : Nat) (L L' : Ps.Fin n -> S.1.R) (h : (i : Ps.Fin n) -> Id S.1.R (L i) (L' i)) (x : S.1.R) (e : TG.InI S n L x) : TG.InI S n L' x =
 subst (\ K -> TG.InI S n K x) (F.funext (Ps.Fin n) (\ i -> S.1.R) L L' h) e ;
Preserves (S S' : TG.RD) (h : RH.Hom S.1 S'.1) : U l =
 (m : Nat) (L : Ps.Fin m -> S.1.R) (a : S.1.R) -> TG.RegEl S m L a -> TG.RegEl S' m (\ i -> h.1 (L i)) (h.1 a) ;
preserves-seq (S S' : TG.RD) (h : RH.Hom S.1 S'.1) (P : Preserves S S' h) : (k m : Nat) (L : Ps.Fin m -> S.1.R) (a : Ps.Fin k -> S.1.R) ->
 TG.RegSeq S k m L a -> TG.RegSeq S' k m (\ i -> h.1 (L i)) (\ i -> h.1 (a i)) = split {
 zero -> \ m L a s -> tt ;
 suc k | r -> \ m L a s -> (P m L (a (inr tt)) s.1,
  TT.regseq-list S' k (suc m) (\ i -> h.1 (TG.extend S m L (a (inr tt)) i)) (TG.extend S' m (\ i -> h.1 (L i)) (h.1 (a (inr tt))))
   (TT.map-snoc (Ps.Fin m) S.1.R S'.1.R h.1 L (a (inr tt))) (\ i -> h.1 (a (inl i)))
   (r (suc m) (TG.extend S m L (a (inr tt))) (\ i -> a (inl i)) s.2)) } ;
pres-compose (S S' S'' : TG.RD) (h : RH.Hom S.1 S'.1) (h' : RH.Hom S'.1 S''.1) (P : Preserves S S' h) (P' : Preserves S' S'' h') :
 Preserves S S'' (RH.compose S.1 S'.1 S''.1 h' h) = \ m L a r -> P' m (\ i -> h.1 (L i)) (h.1 a) (P m L a r) ;
pres-incl (D : TG.RD) : Preserves D (TG.ext1 D) TG.PolyX[D].X.inclusion = \ m L a r -> TT.Up1[D].el m L a r ;
-- isomorphisms
Iso (S S' : TG.RD) : U l = (h : RH.Hom S.1 S'.1) * (g : RH.Hom S'.1 S.1) *
 ((x : S.1.R) -> Id S.1.R (g.1 (h.1 x)) x) * ((y : S'.1.R) -> Id S'.1.R (h.1 (g.1 y)) y) ;
module IsoPres (S S' : TG.RD) (i : Iso S S') (m : Nat) (L : Ps.Fin m -> S.1.R) (a : S.1.R) (r : TG.RegEl S m L a)
 (y : S'.1.R) (k : TG.InI S' m (\ j -> i.1.1 (L j)) (S'.1.mul (i.1.1 a) y)) {
 k1 : TG.InI S m (\ j -> i.2.1.1 (i.1.1 (L j))) (i.2.1.1 (S'.1.mul (i.1.1 a) y)) = hom-in S' S i.2.1 m (\ j -> i.1.1 (L j)) (S'.1.mul (i.1.1 a) y) k ;
 k2 : TG.InI S m L (S.1.mul a (i.2.1.1 y)) =
  subst (TG.InI S m L) (trans (i.2.1.2.2.2 (i.1.1 a) y) (ap (\ t -> S.1.mul t (i.2.1.1 y)) (i.2.2.1 a)))
   (ini-list S m (\ j -> i.2.1.1 (i.1.1 (L j))) L (\ j -> i.2.2.1 (L j)) (i.2.1.1 (S'.1.mul (i.1.1 a) y)) k1) ;
 result : TG.InI S' m (\ j -> i.1.1 (L j)) y = subst (TG.InI S' m (\ j -> i.1.1 (L j))) (i.2.2.2 y) (hom-in S S' i.1 m L (i.2.1.1 y) (r (i.2.1.1 y) tt k2)) ;
} ;
iso-pres (S S' : TG.RD) (i : Iso S S') : Preserves S S' i.1 = \ m L a r y t k -> IsoPres[S,S',i,m,L,a,r,y,k].result ;
iso-id (S : TG.RD) : Iso S S = (RH.identity S.1,RH.identity S.1,\ x -> refl x,\ y -> refl y) ;
iso-compose (S1 S2 S3 : TG.RD) (i : Iso S1 S2) (j : Iso S2 S3) : Iso S1 S3 =
 (RH.compose S1.1 S2.1 S3.1 j.1 i.1,RH.compose S3.1 S2.1 S1.1 i.2.1 j.2.1,
  \ x -> trans (ap i.2.1.1 (j.2.2.1 (i.1.1 x))) (i.2.2.1 x),
  \ y -> trans (ap j.1.1 (i.2.2.2 (j.2.1.1 y))) (j.2.2.2 y)) ;

---------------------------------------------------------------------
-- polynomials
-- maps out of A[X] agreeing on constants and on X agree
module Agree (A C : TG.RD) (g g' : RH.Hom (TG.ext1 A).1 C.1)
 (hc : (a : A.1.R) -> Id C.1.R (g.1 (TG.PolyX[A].X.constant a)) (g'.1 (TG.PolyX[A].X.constant a)))
 (hv : Id C.1.R (g.1 TG.PolyX[A].X.variable) (g'.1 TG.PolyX[A].X.variable)) {
 module G = Universal[l].Property[A.1,C.1,A.2,C.2].Given[RH.compose A.1 (TG.ext1 A).1 C.1 g' TG.PolyX[A].X.inclusion,g'.1 TG.PolyX[A].X.variable] ;
 path : Id (RH.Hom (TG.ext1 A).1 C.1) g g' = trans (G.unique g hc hv) (sym (G.unique g' (\ a -> refl (g'.1 (TG.PolyX[A].X.constant a))) (refl (g'.1 TG.PolyX[A].X.variable)))) ;
 at (z : (TG.ext1 A).1.R) : Id C.1.R (g.1 z) (g'.1 z) = ap (\ u -> u.1 z) path ;
} ;
-- A[X] -> B[X] from A -> B
module Map1 (A B : TG.RD) (h : RH.Hom A.1 B.1) {
 module G = Universal[l].Property[A.1,(TG.ext1 B).1,A.2,(TG.ext1 B).2].Given[RH.compose A.1 B.1 (TG.ext1 B).1 TG.PolyX[B].X.inclusion h,TG.PolyX[B].X.variable] ;
 map : RH.Hom (TG.ext1 A).1 (TG.ext1 B).1 = G.extend ;
 on-c (a : A.1.R) : Id (TG.ext1 B).1.R (map.1 (TG.PolyX[A].X.constant a)) (TG.PolyX[B].X.constant (h.1 a)) = G.on-constants a ;
 on-x : Id (TG.ext1 B).1.R (map.1 TG.PolyX[A].X.variable) TG.PolyX[B].X.variable = G.on-variable ;
} ;
module IsoExt1 (A B : TG.RD) (i : Iso A B) {
 module M = Map1[A,B,i.1] ; module N = Map1[B,A,i.2.1] ;
 gh (z : (TG.ext1 A).1.R) : Id (TG.ext1 A).1.R (N.map.1 (M.map.1 z)) z =
  Agree[A,TG.ext1 A,RH.compose (TG.ext1 A).1 (TG.ext1 B).1 (TG.ext1 A).1 N.map M.map,RH.identity (TG.ext1 A).1,
   \ a -> trans (ap N.map.1 (M.on-c a)) (trans (N.on-c (i.1.1 a)) (ap TG.PolyX[A].X.constant (i.2.2.1 a))),
   trans (ap N.map.1 M.on-x) N.on-x].at z ;
 hg (y : (TG.ext1 B).1.R) : Id (TG.ext1 B).1.R (M.map.1 (N.map.1 y)) y =
  Agree[B,TG.ext1 B,RH.compose (TG.ext1 B).1 (TG.ext1 A).1 (TG.ext1 B).1 M.map N.map,RH.identity (TG.ext1 B).1,
   \ b -> trans (ap M.map.1 (N.on-c b)) (trans (M.on-c (i.2.1.1 b)) (ap TG.PolyX[B].X.constant (i.2.2.2 b))),
   trans (ap M.map.1 N.on-x) M.on-x].at y ;
 iso : Iso (TG.ext1 A) (TG.ext1 B) = (M.map,N.map,gh,hg) ;
} ;
iso-ext1 (A B : TG.RD) (i : Iso A B) : Iso (TG.ext1 A) (TG.ext1 B) = IsoExt1[A,B,i].iso ;
-- the swap of A[X][Y]
module Swap (A : TG.RD) {
 cX (a : A.1.R) : (TG.ext1 A).1.R = TG.PolyX[A].X.constant a ;
 cY (u : (TG.ext1 A).1.R) : (TG.ext1 (TG.ext1 A)).1.R = TG.PolyX[TG.ext1 A].X.constant u ;
 X : (TG.ext1 A).1.R = TG.PolyX[A].X.variable ;
 Y : (TG.ext1 (TG.ext1 A)).1.R = TG.PolyX[TG.ext1 A].X.variable ;
 -- X |-> Y
 module GI = Universal[l].Property[A.1,(TG.ext1 (TG.ext1 A)).1,A.2,(TG.ext1 (TG.ext1 A)).2].Given[RH.compose A.1 (TG.ext1 A).1 (TG.ext1 (TG.ext1 A)).1 TG.PolyX[TG.ext1 A].X.inclusion TG.PolyX[A].X.inclusion,Y] ;
 inner : RH.Hom (TG.ext1 A).1 (TG.ext1 (TG.ext1 A)).1 = GI.extend ;
 -- Y |-> X
 module GS = Universal[l].Property[(TG.ext1 A).1,(TG.ext1 (TG.ext1 A)).1,(TG.ext1 A).2,(TG.ext1 (TG.ext1 A)).2].Given[inner,cY X] ;
 swap : RH.Hom (TG.ext1 (TG.ext1 A)).1 (TG.ext1 (TG.ext1 A)).1 = GS.extend ;
 swap-cc (a : A.1.R) : Id (TG.ext1 (TG.ext1 A)).1.R (swap.1 (cY (cX a))) (cY (cX a)) = trans (GS.on-constants (cX a)) (GI.on-constants a) ;
 -- swap (swap (cY u)) = cY u, from the maps A[X] -> A[X][Y]
 module In1 = Agree[A,(TG.ext1 (TG.ext1 A)),RH.compose (TG.ext1 A).1 (TG.ext1 (TG.ext1 A)).1 (TG.ext1 (TG.ext1 A)).1 swap inner,TG.PolyX[TG.ext1 A].X.inclusion,
  \ a -> trans (ap swap.1 (GI.on-constants a)) (swap-cc a),
  trans (ap swap.1 GI.on-variable) GS.on-variable] ;
 swap-swap (z : (TG.ext1 (TG.ext1 A)).1.R) : Id (TG.ext1 (TG.ext1 A)).1.R (swap.1 (swap.1 z)) z =
  Agree[TG.ext1 A,(TG.ext1 (TG.ext1 A)),RH.compose (TG.ext1 (TG.ext1 A)).1 (TG.ext1 (TG.ext1 A)).1 (TG.ext1 (TG.ext1 A)).1 swap swap,RH.identity (TG.ext1 (TG.ext1 A)).1,
   \ u -> trans (ap swap.1 (GS.on-constants u)) (In1.at u),
   trans (ap swap.1 GS.on-variable) (trans (GS.on-constants X) GI.on-variable)].at z ;
 iso : Iso (TG.ext1 (TG.ext1 A)) (TG.ext1 (TG.ext1 A)) = (swap,swap,swap-swap,swap-swap) ;
} ;

---------------------------------------------------------------------
-- ext1 (ext p D) ~ ext p (ext1 D)
theta : (p : Nat) (D : TG.RD) -> Iso (TG.ext1 (TG.ext p D)) (TG.ext p (TG.ext1 D)) = split {
 zero -> \ D -> iso-id (TG.ext1 D) ;
 suc p | r -> \ D -> iso-compose (TG.ext1 (TG.ext1 (TG.ext p D))) (TG.ext1 (TG.ext1 (TG.ext p D))) (TG.ext1 (TG.ext p (TG.ext1 D)))
  Swap[TG.ext p D].iso (iso-ext1 (TG.ext1 (TG.ext p D)) (TG.ext p (TG.ext1 D)) (r D)) } ;
module CompatStep (p : Nat) (D : TG.RD) (x : D.1.R)
 (r : Id (TG.ext p (TG.ext1 D)).1.R ((theta p D).1.1 (TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 x))) ((TG.incl p (TG.ext1 D)).1 (TG.PolyX[D].X.constant x))) {
 module M = Map1[TG.ext1 (TG.ext p D),TG.ext p (TG.ext1 D),(theta p D).1] ;
 u : (TG.ext1 (TG.ext p D)).1.R = TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 x) ;
 result : Id (TG.ext1 (TG.ext p (TG.ext1 D))).1.R (M.map.1 (Swap[TG.ext p D].swap.1 (TG.PolyX[TG.ext1 (TG.ext p D)].X.constant u)))
  (TG.PolyX[TG.ext p (TG.ext1 D)].X.constant ((TG.incl p (TG.ext1 D)).1 (TG.PolyX[D].X.constant x))) =
  trans (ap M.map.1 (Swap[TG.ext p D].swap-cc ((TG.incl p D).1 x)))
   (trans (M.on-c u) (ap TG.PolyX[TG.ext p (TG.ext1 D)].X.constant r)) ;
} ;
theta-compat : (p : Nat) (D : TG.RD) (x : D.1.R) ->
 Id (TG.ext p (TG.ext1 D)).1.R ((theta p D).1.1 (TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 x))) ((TG.incl p (TG.ext1 D)).1 (TG.PolyX[D].X.constant x)) = split {
 zero -> \ D x -> refl (TG.PolyX[D].X.constant x) ;
 suc p | r -> \ D x -> CompatStep[p,D,x,r D x].result } ;

---------------------------------------------------------------------
-- base change
module BaseStep (D : TG.RD) (p : Nat) {
 c (x : D.1.R) : (TG.ext1 D).1.R = TG.PolyX[D].X.constant x ;
 phi : RH.Hom (TG.ext p D).1 (TG.ext p (TG.ext1 D)).1 =
  RH.compose (TG.ext p D).1 (TG.ext1 (TG.ext p D)).1 (TG.ext p (TG.ext1 D)).1 (theta p D).1 TG.PolyX[TG.ext p D].X.inclusion ;
 pres : Preserves (TG.ext p D) (TG.ext p (TG.ext1 D)) phi =
  pres-compose (TG.ext p D) (TG.ext1 (TG.ext p D)) (TG.ext p (TG.ext1 D)) TG.PolyX[TG.ext p D].X.inclusion (theta p D).1
   (pres-incl (TG.ext p D)) (iso-pres (TG.ext1 (TG.ext p D)) (TG.ext p (TG.ext1 D)) (theta p D)) ;
 -- phi on images of D
 on-img (m : Nat) (L : Ps.Fin m -> D.1.R) (i : Ps.Fin m) : Id (TG.ext p (TG.ext1 D)).1.R (phi.1 (TG.img p D m L i)) (TG.img p (TG.ext1 D) m (\ j -> c (L j)) i) =
  theta-compat p D (L i) ;
 seq (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (w : TG.Seq D k m J n I p) : TG.Seq (TG.ext1 D) k m (\ j -> c (J j)) n (\ j -> c (I j)) p =
  (\ i -> phi.1 (w.1 i),
   \ i -> ini-list (TG.ext p (TG.ext1 D)) n (\ j -> phi.1 (TG.img p D n I j)) (TG.img p (TG.ext1 D) n (\ j -> c (I j))) (on-img n I) (phi.1 (w.1 i))
    (hom-in (TG.ext p D) (TG.ext p (TG.ext1 D)) phi n (TG.img p D n I) (w.1 i) (w.2.1 i)),
   TT.regseq-list (TG.ext p (TG.ext1 D)) k m (\ j -> phi.1 (TG.img p D m J j)) (TG.img p (TG.ext1 D) m (\ j -> c (J j))) (on-img m J) (\ i -> phi.1 (w.1 i))
    (preserves-seq (TG.ext p D) (TG.ext p (TG.ext1 D)) phi pres k m (TG.img p D m J) w.1 w.2.2)) ;
} ;
-- Gr(I) >= k mod J over D gives it over D[X]
base-change (k : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (g : TG.TGr k D m J n I) :
 TG.TGr k (TG.ext1 D) m (\ j -> TG.PolyX[D].X.constant (J j)) n (\ j -> TG.PolyX[D].X.constant (I j)) =
 TC.map ((p : Nat) * TG.Seq D k m J n I p) ((p : Nat) * TG.Seq (TG.ext1 D) k m (\ j -> TG.PolyX[D].X.constant (J j)) n (\ j -> TG.PolyX[D].X.constant (I j)) p)
  (\ w -> (w.1,BaseStep[D,w.1].seq k m J n I w.2)) g ;
