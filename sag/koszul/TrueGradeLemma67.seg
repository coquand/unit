-- cffr Lemma 6.7 with the true grade: Gr(x_1, ..., x_m) >= k mod J and
-- Gr(a) >= k mod J over each D[1/x_i] give Gr(a) >= k mod J over D.
--
-- Induction on k (for all rings and J).  Step k + 1: x is regular mod J,
-- and a is regular mod J in each D[1/x_i] (Gr >= 1), hence in D (Lemma 2.3
-- mod J, cffr/LocalRegularMod).  With f the Kronecker polynomial of a over
-- D and g that of x over D[X], y = f g in D[X][Y] is regular mod J and lies
-- in (a) and in (x) (as in Proposition 6.6).  Theorem 9 gives Gr(x) >= k
-- mod (J, y) over D[X][Y].  Over D[1/x_i][X][Y], base change and
-- Theorem 9 (the image of y is the product of the Kronecker polynomials of
-- the images: MapKron) give Gr(a) >= k mod (J, y); the isomorphism
-- D[X][Y][1/x_i] ~ D[1/x_i][X][Y] (TrueGradeLocal.Comm twice) moves this
-- to D[X][Y][1/x_i].  By induction Gr(a) >= k mod (J, y) over D[X][Y];
-- then cons and the tower give Gr(a) >= k + 1 mod J over D.
-- A list containing a unit is regular (unit-reg).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ; module T9 = TrueGradeThm9[l] ; module TB = TrueGradeBase[l] ;
module TP = TrueGradeProduct[l] ; module TS = TrueGradeIso[l] ; module TL = TrueGradeLocal[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

-- grade over pointwise equal lists
tgr-list (D : TG.RD) (k m : Nat) (J J' : Ps.Fin m -> D.1.R) (hJ : (i : Ps.Fin m) -> Id D.1.R (J i) (J' i))
 (n : Nat) (I I' : Ps.Fin n -> D.1.R) (hI : (i : Ps.Fin n) -> Id D.1.R (I i) (I' i)) (g : TG.TGr k D m J n I) : TG.TGr k D m J' n I' =
 subst (\ K -> TG.TGr k D m J' n K) (F.funext (Ps.Fin n) (\ i -> D.1.R) I I' hI)
  (subst (\ K -> TG.TGr k D m K n I) (F.funext (Ps.Fin m) (\ i -> D.1.R) J J' hJ) g) ;
-- a list containing a unit is regular
unit-reg (S : TG.RD) (mJ : Nat) (J : Ps.Fin mJ -> S.1.R) (m : Nat) (x : Ps.Fin m -> S.1.R) (i0 : Ps.Fin m) (u : RL[S.1].unit (x i0)) :
 TG.RegId S mJ J m x = \ y t k ->
 subst (TG.InI S mJ J) (calc S.1.R {
   S.1.mul u.1 (S.1.mul (x i0) y) =< S.1.mulA u.1 (x i0) y > S.1.mul (S.1.mul u.1 (x i0)) y
    =< ap (\ s -> S.1.mul s y) (trans (S.1.mulC u.1 (x i0)) u.2) > S.1.mul S.1.o y
    =< RL[S.1].one-left y > y })
  (RI.Generated[S.1,mJ,J].ideal.in-mul u.1 (S.1.mul (x i0) y) (k i0)) ;
-- an isomorphism, reversed
iso-flip (S S' : TG.RD) (i : TB.Iso S S') : TB.Iso S' S = (i.2.1,i.1,i.2.2.2,i.2.2.1) ;

---------------------------------------------------------------------
IH67 (k : Nat) : U l+ = (D : TG.RD) (mJ : Nat) (J : Ps.Fin mJ -> D.1.R) (m : Nat) (x : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R) ->
 TG.TGr k D mJ J m x ->
 ((i : Ps.Fin m) -> TG.TGr k (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j))) ->
 TG.TGr k D mJ J n a ;
module Step67 (k : Nat) (r : IH67 k) (D : TG.RD) (mJ : Nat) (J : Ps.Fin mJ -> D.1.R) (m : Nat) (x : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R)
 (gx : TG.TGr (suc k) D mJ J m x)
 (ga : (i : Ps.Fin m) -> TG.TGr (suc k) (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j))) {
 J1 : Ps.Fin mJ -> (TG.ext1 D).1.R = \ j -> TG.PolyX[D].X.constant (J j) ;
 J2 : Ps.Fin mJ -> (TG.ext1 (TG.ext1 D)).1.R = \ j -> TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (J j)) ;
 x1 : Ps.Fin m -> (TG.ext1 D).1.R = \ j -> TG.PolyX[D].X.constant (x j) ;
 x2 : Ps.Fin m -> (TG.ext1 (TG.ext1 D)).1.R = \ j -> TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x j)) ;
 a2 : Ps.Fin n -> (TG.ext1 (TG.ext1 D)).1.R = \ j -> TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (a j)) ;
 -- regularity of x and a
 rX : TG.RegId D mJ J m x = T9.gr1-to D mJ J m x (TP.to-one k D mJ J m x gx) ;
 rA-local (i : Ps.Fin m) : TG.RegId (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j)) =
  T9.gr1-to (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j))
   (TP.to-one k (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j)) (ga i)) ;
 rA : TG.RegId D mJ J n a = LocalRegularMod[l].AtFractions[D.1,D.2,mJ,J,m,x].LR.Ideal[rX,Ps.Fin n,a,rA-local].result ;
 rX1 : TG.RegId (TG.ext1 D) mJ J1 m x1 = PolyRegularMod[l].Over[D.1,D.2,mJ,J].Ideal[m,x].up rX ;
 -- y = f g
 f : (TG.ext1 D).1.R = T9.Kron[D].f n a ;
 g : (TG.ext1 (TG.ext1 D)).1.R = T9.Kron[(TG.ext1 D)].f m x1 ;
 y : (TG.ext1 (TG.ext1 D)).1.R = (TG.ext1 (TG.ext1 D)).1.mul (TG.PolyX[TG.ext1 D].X.constant f) g ;
 fa2 : TG.InI (TG.ext1 (TG.ext1 D)) n a2 (TG.PolyX[TG.ext1 D].X.constant f) = TT.Up1[(TG.ext1 D)].inI n (\ j -> TG.PolyX[D].X.constant (a j)) f (T9.Kron[D].f-in n a) ;
 yJ : TG.RegEl (TG.ext1 (TG.ext1 D)) mJ J2 y = TP.reg-mul (TG.ext1 (TG.ext1 D)) mJ J2 (TG.PolyX[TG.ext1 D].X.constant f) g (TT.Up1[(TG.ext1 D)].el mJ J1 f (T9.Kron[D].f-reg mJ J n a rA)) (T9.Kron[(TG.ext1 D)].f-reg mJ J1 m x1 rX1) ;
 ya : TG.InI (TG.ext1 (TG.ext1 D)) n a2 y = subst (TG.InI (TG.ext1 (TG.ext1 D)) n a2) ((TG.ext1 (TG.ext1 D)).1.mulC g (TG.PolyX[TG.ext1 D].X.constant f)) (RI.Generated[(TG.ext1 (TG.ext1 D)).1,n,a2].ideal.in-mul g (TG.PolyX[TG.ext1 D].X.constant f) fa2) ;
 yx : TG.InI (TG.ext1 (TG.ext1 D)) m x2 y = RI.Generated[(TG.ext1 (TG.ext1 D)).1,m,x2].ideal.in-mul (TG.PolyX[TG.ext1 D].X.constant f) g (T9.Kron[(TG.ext1 D)].f-in m x1) ;
 -- Gr(x) >= k mod (J, y) over D[X][Y]
 tx : TG.TGr k (TG.ext1 (TG.ext1 D)) (suc mJ) (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y) m x2 =
  T9.thm9 k (TG.ext1 (TG.ext1 D)) mJ J2 m x2 y yx yJ (TB.base-change (suc k) (TG.ext1 D) mJ J1 m x1 (TB.base-change (suc k) D mJ J m x gx)) ;
 -- in each localization
 module Local (i : Ps.Fin m) {
  module C2 = TL.Comm2[D,x i] ;
  -- the image of y
  fL : (TG.ext1 (TL.Loc D (x i))).1.R = T9.Kron[(TL.Loc D (x i))].f n (\ j -> (TL.loc D (x i)).1 (a j)) ;
  gL : (TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.R = T9.Kron[(TG.ext1 (TL.Loc D (x i)))].f m (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (x j))) ;
  kron-list (T : TG.RD) (q : Nat) (L L' : Ps.Fin q -> T.1.R) (h : (j : Ps.Fin q) -> Id T.1.R (L j) (L' j)) : Id (TG.ext1 T).1.R (T9.Kron[T].f q L) (T9.Kron[T].f q L') =
   ap (T9.Kron[T].f q) (F.funext (Ps.Fin q) (\ j -> T.1.R) L L' h) ;
  psi-y : Id (TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.R (C2.psi.1 y) ((TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.mul (TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant fL) gL) =
   trans (C2.psi.2.2.2 (TG.PolyX[TG.ext1 D].X.constant f) g)
    (trans (ap (\ t -> (TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.mul t (C2.psi.1 g)) (trans (C2.M2.on-c f) (ap TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant (TS.MapKron[D,(TL.Loc D (x i)),(TL.loc D (x i))].kron-map n a))))
     (ap ((TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.mul (TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant fL)) (trans (TS.MapKron[(TG.ext1 D),(TG.ext1 (TL.Loc D (x i))),C2.C0.PM.map].kron-map m x1) (kron-list (TG.ext1 (TL.Loc D (x i))) m (\ j -> C2.C0.PM.map.1 (TG.PolyX[D].X.constant (x j))) (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (x j))) (\ j -> C2.C0.PM.on-c (x j)))))) ;
  -- lists over D[1/x_i][X][Y]
  JL : Ps.Fin mJ -> (TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.R = \ j -> TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant (TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (J j))) ;
  aL : Ps.Fin n -> (TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.R = \ j -> TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant (TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (a j))) ;
  xL1 : Ps.Fin m -> (TG.ext1 (TL.Loc D (x i))).1.R = \ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (x j)) ;
  rXL : TG.RegId (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) m (\ j -> (TL.loc D (x i)).1 (x j)) = unit-reg (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) m (\ j -> (TL.loc D (x i)).1 (x j)) i (TL.x-unit D (x i)) ;
  yL : TG.RegEl (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (C2.psi.1 y) = subst (TG.RegEl (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL) (sym psi-y)
   (TP.reg-mul (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant fL) gL (TT.Up1[(TG.ext1 (TL.Loc D (x i)))].el mJ (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (J j))) fL (T9.Kron[(TL.Loc D (x i))].f-reg mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j)) (rA-local i)))
    (T9.Kron[(TG.ext1 (TL.Loc D (x i)))].f-reg mJ (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (J j))) m xL1 (PolyRegularMod[l].Over[(TL.Loc D (x i)).1,(TL.Loc D (x i)).2,mJ,\ j -> (TL.loc D (x i)).1 (J j)].Ideal[m,\ j -> (TL.loc D (x i)).1 (x j)].up rXL))) ;
  yaL : TG.InI (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) n aL (C2.psi.1 y) = subst (TG.InI (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) n aL) (sym (trans psi-y ((TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1.mulC (TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant fL) gL)))
   (RI.Generated[(TG.ext1 (TG.ext1 (TL.Loc D (x i)))).1,n,aL].ideal.in-mul gL (TG.PolyX[TG.ext1 (TL.Loc D (x i))].X.constant fL) (TT.Up1[(TG.ext1 (TL.Loc D (x i)))].inI n (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (a j))) fL (T9.Kron[(TL.Loc D (x i))].f-in n (\ j -> (TL.loc D (x i)).1 (a j))))) ;
  -- Theorem 9 over D[1/x_i][X][Y]
  tL : TG.TGr k (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) (suc mJ) (TG.extend (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (C2.psi.1 y)) n aL =
   T9.thm9 k (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL n aL (C2.psi.1 y) yaL yL
    (TB.base-change (suc k) (TG.ext1 (TL.Loc D (x i))) mJ (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (J j))) n (\ j -> TG.PolyX[(TL.Loc D (x i))].X.constant ((TL.loc D (x i)).1 (a j)))
     (TB.base-change (suc k) (TL.Loc D (x i)) mJ (\ j -> (TL.loc D (x i)).1 (J j)) n (\ j -> (TL.loc D (x i)).1 (a j)) (ga i))) ;
  -- C2.back to D[X][Y][1/x_i]
  pj (j : Ps.Fin (suc mJ)) : Id (TL.Loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1.R (C2.iso.2.1.1 (TG.extend (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (C2.psi.1 y) j)) ((TL.loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1 (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y j)) =
   KoszulExact[l].plus-fn (Ps.Fin mJ) Top (\ j -> Id (TL.Loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1.R (C2.iso.2.1.1 (TG.extend (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (C2.psi.1 y) j)) ((TL.loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1 (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y j)))
    (\ j -> trans (ap C2.iso.2.1.1 (sym (C2.psi-cc (J j)))) (C2.back (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (J j))))) (\ t -> C2.back y) j ;
  result : TG.TGr k (TL.Loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))) (suc mJ) (\ j -> (TL.loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1 (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y j)) n (\ j -> (TL.loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1 (a2 j)) =
   tgr-list (TL.Loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))) k (suc mJ) (\ j -> C2.iso.2.1.1 (TG.extend (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (C2.psi.1 y) j)) (\ j -> (TL.loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1 (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y j)) pj
    n (\ j -> C2.iso.2.1.1 (aL j)) (\ j -> (TL.loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))).1 (a2 j)) (\ j -> trans (ap C2.iso.2.1.1 (sym (C2.psi-cc (a j)))) (C2.back (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (a j)))))
    (TS.tgr-iso (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) (TL.Loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))) (iso-flip (TL.Loc (TG.ext1 (TG.ext1 D)) (TG.PolyX[TG.ext1 D].X.constant (TG.PolyX[D].X.constant (x i)))) (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) C2.iso) k (suc mJ) (TG.extend (TG.ext1 (TG.ext1 (TL.Loc D (x i)))) mJ JL (C2.psi.1 y)) n aL tL) ;
 } ;
 ih : TG.TGr k (TG.ext1 (TG.ext1 D)) (suc mJ) (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y) n a2 = r (TG.ext1 (TG.ext1 D)) (suc mJ) (TG.extend (TG.ext1 (TG.ext1 D)) mJ J2 y) m x2 n a2 tx (\ i -> Local[i].result) ;
 result : TG.TGr (suc k) D mJ J n a = TT.tower (suc k) D mJ J n a (suc (suc zero)) (TP.cons (TG.ext1 (TG.ext1 D)) k mJ J2 n a2 y ya yJ ih) ;
} ;
lemma67 : (k : Nat) -> IH67 k = split {
 zero -> \ D mJ J m x n a gx ga -> T9.gr0 D mJ J n a ;
 suc k | r -> \ D mJ J m x n a gx ga -> Step67[k,r,D,mJ,J,m,x,n,a,gx,ga].result } ;
