-- cffr §6, item 2: Gr(a; E) >= 2 iff Gr(a; E) >= 1 and, whenever a family
-- y_i in E has a_i y_j - a_j y_i = 0 for all i, j, there is e with
-- y_i = a_i e (merely).
--
-- A cocycle of degree 1 is vec1 y with y_i its value at {i} (conc1), and
-- d (vec1 y) = vec2 (a_i y_j - a_j y_i) (dvec1); this alternating family
-- vanishes iff its vec2 does (vec2-inv).  A coboundary of degree 1 is
-- d (vec0 e) = vec1 (a_i e) (dvec0, conc0).  Both directions follow, with
-- vec1 y = vec1 y' iff y = y' (values at the singletons).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Bj = Bijection[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module G1 = GradeOne[l].Over[Rg,setR] ;
 module Item2 (E : MO.Module) (N : Nat) (a : Ps.Fin N -> R) {
  module KV = KoszulVectors[l].Over[Rg,setR,E] ;
  module KZ = KV.KZ ; module CF = KZ.CF ; module ME = CF.ME ;
  module KA = KZ.K[N,a] ;
  module CK = GR.CX.Cx[KA.complex] ;
  -- the explicit condition
  Explicit : U l = (y : Ps.Fin N -> E.M) -> ((i j : Ps.Fin N) -> Id E.M (KV.alt N a y i j) E.mz) ->
   Tr.Trunc[(e : E.M) * ((i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e))].carrier ;
  -- a_i y_j - a_j y_i is alternating
  alt-alt (y : Ps.Fin N -> E.M) : KV.AltFamily N (KV.alt N a y) =
   (\ i j -> sym (trans (ME.neg-add (E.sm (a i) (y j)) (E.mneg (E.sm (a j) (y i))))
     (trans (ap (E.madd (E.mneg (E.sm (a i) (y j)))) (ME.neg-neg (E.sm (a j) (y i)))) (E.maddC (E.mneg (E.sm (a i) (y j))) (E.sm (a j) (y i))))),
    \ i -> E.maddN (E.sm (a i) (y i))) ;
  -- degree 1 and 0 vectors from families
  one (y : Ps.Fin N -> E.M) : KZ.Deg[N,suc zero].S.E = (KV.vec1 N y,KV.vec1-supp N y) ;
  zero-vec (e : E.M) : KZ.Deg[N,zero].S.E = (KV.vec0 N e,KV.vec0-supp N e) ;
  -- d (vec0 e) = vec1 y when y_i = a_i e
  d-zero-vec (e : E.M) (y : Ps.Fin N -> E.M) (h : (i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e)) :
   Id (CF.V N).M (CF.apply N N KA.wedge (KV.vec0 N e)) (KV.vec1 N y) =
   CF.veq N (CF.apply N N KA.wedge (KV.vec0 N e)) (KV.vec1 N y) (\ J ->
    trans (KV.dvec0 N a e J) (KV.vec1-ext N (\ i -> E.sm (a i) e) y (\ i -> sym (h i)) J)) ;
  -- Gr(a; E) >= 2 gives the explicit condition
  module Forward (g : GR.Gr E N a (suc (suc zero))) (y : Ps.Fin N -> E.M) (h : (i j : Ps.Fin N) -> Id E.M (KV.alt N a y i j) E.mz) {
   cocycle : CK.Cocycle (suc zero) (one y) = KZ.Deg[N,suc (suc zero)].S.eq (KA.dmap (suc zero) (one y)) (CK.o (suc (suc zero)))
    (CF.veq N (CF.apply N N KA.wedge (KV.vec1 N y)) (CF.V N).mz (\ J ->
     trans (KV.dvec1 N a y J) (trans (KV.vec2-ext N (KV.alt N a y) (\ i j -> E.mz) h J) (KV.vec2-zero N J)))) ;
   from (w : Bj.Fibre (CK.d zero) (one y)) : (e : E.M) * ((i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e)) =
    (w.1.1 (G1.empty N),\ i -> calc E.M {
      y i =< sym (KV.vec1-single N y i) > KV.vec1 N y (G1.single N i)
       =< sym (ap (\ t -> t.1 (G1.single N i)) w.2) > CF.apply N N KA.wedge w.1.1 (G1.single N i)
       =< ap (\ v -> CF.apply N N KA.wedge v (G1.single N i)) (CF.veq N w.1.1 (KV.vec0 N (w.1.1 (G1.empty N))) (KV.conc0 N w.1.1 w.1.2)) >
      CF.apply N N KA.wedge (KV.vec0 N (w.1.1 (G1.empty N))) (G1.single N i)
       =< KV.dvec0 N a (w.1.1 (G1.empty N)) (G1.single N i) > KV.vec1 N (\ k -> E.sm (a k) (w.1.1 (G1.empty N))) (G1.single N i)
       =< KV.vec1-single N (\ k -> E.sm (a k) (w.1.1 (G1.empty N))) i > E.sm (a i) (w.1.1 (G1.empty N)) }) ;
   result : Tr.Trunc[(e : E.M) * ((i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e))].carrier =
    TC.map (Bj.Fibre (CK.d zero) (one y)) ((e : E.M) * ((i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e))) from (g.2 (one y) cocycle) ;
  } ;
  forward (g : GR.Gr E N a (suc (suc zero))) : GR.Gr E N a (suc zero) * Explicit = (g.1,\ y h -> Forward[g,y,h].result) ;
  -- and conversely
  module Back (ex : Explicit) (u : KZ.Deg[N,suc zero].S.E) (c : CK.Cocycle (suc zero) u) {
   y : Ps.Fin N -> E.M = \ i -> u.1 (G1.single N i) ;
   is-vec1 : Id (CF.V N).M u.1 (KV.vec1 N y) = CF.veq N u.1 (KV.vec1 N y) (KV.conc1 N u.1 u.2) ;
   vanish (i j : Ps.Fin N) : Id E.M (KV.alt N a y i j) E.mz = KV.vec2-inv N (KV.alt N a y) (alt-alt y) (\ J ->
    trans (sym (KV.dvec1 N a y J)) (trans (ap (\ v -> CF.apply N N KA.wedge v J) (sym is-vec1)) (ap (\ t -> t.1 J) c))) i j ;
   from (w : (e : E.M) * ((i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e))) : Bj.Fibre (CK.d zero) u =
    (zero-vec w.1,KZ.Deg[N,suc zero].S.eq (KA.dmap zero (zero-vec w.1)) u (trans (d-zero-vec w.1 y w.2) (sym is-vec1))) ;
   result : CK.Bnd (suc zero) u = TC.map ((e : E.M) * ((i : Ps.Fin N) -> Id E.M (y i) (E.sm (a i) e))) (Bj.Fibre (CK.d zero) u) from (ex y vanish) ;
  } ;
  back (g1 : GR.Gr E N a (suc zero)) (ex : Explicit) : GR.Gr E N a (suc (suc zero)) = (g1,\ u c -> Back[ex,u,c].result) ;
 } ;
} ;
