-- cffr §6, item 3: Gr(a; E) >= 3 iff Gr(a; E) >= 2 and, whenever an
-- alternating family x_ij in E has a_i x_jk - a_j x_ik + a_k x_ij = 0 for
-- all i, j, k, there is y with x_ij = a_i y_j - a_j y_i (merely).
--
-- A cocycle of degree 2 is vec2 x for the alternating family x of its
-- values (conc2, fam2-alt), and d (vec2 x) = vec3 (a_i x_jk - a_j x_ik +
-- a_k x_ij) (dvec2); that family is alternating, so it vanishes iff its
-- vec3 does (vec3-inv).  A coboundary of degree 2 is d (vec1 y) =
-- vec2 (a_i y_j - a_j y_i) (dvec1, conc1); vec2 x = vec2 x' gives x = x'
-- for alternating families (vec2-inv on the difference).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Bj = Bijection[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module G1 = GradeOne[l].Over[Rg,setR] ;
 module Item3 (E : MO.Module) (N : Nat) (a : Ps.Fin N -> R) {
  module KV = KoszulVectors[l].Over[Rg,setR,E] ;
  module K3 = KoszulVectors3[l].Over[Rg,setR,E] ;
  module KZ = KV.KZ ; module CF = KZ.CF ; module ME = CF.ME ;
  module KA = KZ.K[N,a] ;
  module CK = GR.CX.Cx[KA.complex] ;
  module I2 = GradeTwo[l].Over[Rg,setR].Item2[E,N,a] ;
  -- the explicit condition
  Explicit : U l = (x : Ps.Fin N -> Ps.Fin N -> E.M) -> KV.AltFamily N x -> ((i j k : Ps.Fin N) -> Id E.M (K3.alt3 N a x i j k) E.mz) ->
   Tr.Trunc[(y : Ps.Fin N -> E.M) * ((i j : Ps.Fin N) -> Id E.M (x i j) (KV.alt N a y i j))].carrier ;
  two (x : Ps.Fin N -> Ps.Fin N -> E.M) : KZ.Deg[N,suc (suc zero)].S.E = (KV.vec2 N x,KV.vec2-supp N x) ;
  -- x - z is alternating when x and z are
  diff-alt (x z : Ps.Fin N -> Ps.Fin N -> E.M) (ax : KV.AltFamily N x) (az : KV.AltFamily N z) :
   KV.AltFamily N (\ i j -> E.madd (x i j) (E.mneg (z i j))) =
   (\ i j -> trans (ap (\ t -> E.madd t (E.mneg (z j i))) (ax.1 i j)) (trans (ap (\ t -> E.madd (E.mneg (x i j)) (E.mneg t)) (az.1 i j))
     (sym (ME.neg-add (x i j) (E.mneg (z i j))))),
    \ i -> trans (ap (\ t -> E.madd t (E.mneg (z i i))) (ax.2 i)) (trans (ap (\ t -> E.madd E.mz (E.mneg t)) (az.2 i)) (E.maddN E.mz))) ;
  -- vec2 x = vec2 z gives x = z, for alternating families
  vec2-eq (x z : Ps.Fin N -> Ps.Fin N -> E.M) (ax : KV.AltFamily N x) (az : KV.AltFamily N z)
   (h : (J : ExteriorCoordinates[l].Index N) -> Id E.M (KV.vec2 N x J) (KV.vec2 N z J)) (i j : Ps.Fin N) : Id E.M (x i j) (z i j) =
   ME.sub-zero (x i j) (z i j) (KV.vec2-inv N (\ i j -> E.madd (x i j) (E.mneg (z i j))) (diff-alt x z ax az) (\ J ->
    trans (K3.vec2-add N x (\ i j -> E.mneg (z i j)) J) (trans (ap (E.madd (KV.vec2 N x J)) (K3.vec2-neg N z J))
     (trans (ap (\ t -> E.madd t (E.mneg (KV.vec2 N z J))) (h J)) (E.maddN (KV.vec2 N z J))))) i j) ;
  -- Gr(a; E) >= 3 gives the explicit condition
  module Forward (g : GR.Gr E N a (suc (suc (suc zero)))) (x : Ps.Fin N -> Ps.Fin N -> E.M) (ax : KV.AltFamily N x)
   (h : (i j k : Ps.Fin N) -> Id E.M (K3.alt3 N a x i j k) E.mz) {
   cocycle : CK.Cocycle (suc (suc zero)) (two x) = KZ.Deg[N,suc (suc (suc zero))].S.eq (KA.dmap (suc (suc zero)) (two x)) (CK.o (suc (suc (suc zero))))
    (CF.veq N (CF.apply N N KA.wedge (KV.vec2 N x)) (CF.V N).mz (\ J ->
     trans (K3.dvec2 N a x J) (trans (K3.vec3-ext N (K3.alt3 N a x) (\ i j k -> E.mz) h J) (K3.vec3-zero N J)))) ;
   module From (w : Bj.Fibre (CK.d (suc zero)) (two x)) {
    y : Ps.Fin N -> E.M = \ i -> w.1.1 (G1.single N i) ;
    same (J : ExteriorCoordinates[l].Index N) : Id E.M (KV.vec2 N x J) (KV.vec2 N (KV.alt N a y) J) = calc E.M {
     KV.vec2 N x J =< sym (ap (\ t -> t.1 J) w.2) > CF.apply N N KA.wedge w.1.1 J
      =< ap (\ v -> CF.apply N N KA.wedge v J) (CF.veq N w.1.1 (KV.vec1 N y) (KV.conc1 N w.1.1 w.1.2)) > CF.apply N N KA.wedge (KV.vec1 N y) J
      =< KV.dvec1 N a y J > KV.vec2 N (KV.alt N a y) J } ;
    result : (y' : Ps.Fin N -> E.M) * ((i j : Ps.Fin N) -> Id E.M (x i j) (KV.alt N a y' i j)) =
     (y,vec2-eq x (KV.alt N a y) ax (I2.alt-alt y) same) ;
   } ;
   result : Tr.Trunc[(y : Ps.Fin N -> E.M) * ((i j : Ps.Fin N) -> Id E.M (x i j) (KV.alt N a y i j))].carrier =
    TC.map (Bj.Fibre (CK.d (suc zero)) (two x)) ((y : Ps.Fin N -> E.M) * ((i j : Ps.Fin N) -> Id E.M (x i j) (KV.alt N a y i j)))
     (\ w -> From[w].result) (g.2 (two x) cocycle) ;
  } ;
  forward (g : GR.Gr E N a (suc (suc (suc zero)))) : GR.Gr E N a (suc (suc zero)) * Explicit = (g.1,\ x ax h -> Forward[g,x,ax,h].result) ;
  -- and conversely
  module Back (ex : Explicit) (u : KZ.Deg[N,suc (suc zero)].S.E) (c : CK.Cocycle (suc (suc zero)) u) {
   x : Ps.Fin N -> Ps.Fin N -> E.M = K3.fam2 N u.1 ;
   ax : KV.AltFamily N x = K3.fam2-alt N u.1 ;
   is-vec2 : Id (CF.V N).M u.1 (KV.vec2 N x) = CF.veq N u.1 (KV.vec2 N x) (K3.conc2 N u.1 u.2) ;
   vanish (i j k : Ps.Fin N) : Id E.M (K3.alt3 N a x i j k) E.mz =
    K3.vec3-inv N (K3.alt3 N a x) K3.Alt3Of[N,a,x,ax].result (\ J ->
     trans (sym (K3.dvec2 N a x J)) (trans (ap (\ v -> CF.apply N N KA.wedge v J) (sym is-vec2)) (ap (\ t -> t.1 J) c))) i j k ;
   from (w : (y : Ps.Fin N -> E.M) * ((i j : Ps.Fin N) -> Id E.M (x i j) (KV.alt N a y i j))) : Bj.Fibre (CK.d (suc zero)) u =
    (I2.one w.1,KZ.Deg[N,suc (suc zero)].S.eq (KA.dmap (suc zero) (I2.one w.1)) u
     (trans (CF.veq N (CF.apply N N KA.wedge (KV.vec1 N w.1)) (KV.vec2 N x) (\ J ->
       trans (KV.dvec1 N a w.1 J) (KV.vec2-ext N (KV.alt N a w.1) x (\ i j -> sym (w.2 i j)) J))) (sym is-vec2))) ;
   result : CK.Bnd (suc (suc zero)) u =
    TC.map ((y : Ps.Fin N -> E.M) * ((i j : Ps.Fin N) -> Id E.M (x i j) (KV.alt N a y i j))) (Bj.Fibre (CK.d (suc zero)) u) from (ex x ax vanish) ;
  } ;
  back (g2 : GR.Gr E N a (suc (suc zero))) (ex : Explicit) : GR.Gr E N a (suc (suc (suc zero))) = (g2,\ u c -> Back[ex,u,c].result) ;
 } ;
} ;
