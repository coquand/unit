-- cffr §4: exactness modulo a (Lemma 4.1, Corollary 4.2).
--
-- a is H-regular: a h = 0 gives h = 0.  E -A-> F -B-> G is exact at F:
-- B A = 0 and ker B is in im A.  It is exact modulo a at F when
-- B y = a z gives y = A x + a y1 (merely); this is exactness of
-- E/aE -> F/aF -> G/aG at F/aF, written on representatives.
--
-- Lemma 4.1 has two steps.
-- (lift) F -B-> G -C-> H with C B = 0, ker C in im B, a H-regular: if
--   B y = a z then z is in im B.  Indeed a (C z) = C (a z) = C (B y) = 0,
--   so C z = 0.
-- (step) ker B in im A: if B y = a z and z = B y1, then
--   B (y - a y1) = a z - a z = 0, so y - a y1 = A x and y = A x + a y1.
-- Lemma 4.1 (E -> F -> G -> H exact at F and G, a H-regular): E -> F -> G
-- is exact modulo a at F: (lift) then (step).
-- Corollary 4.2 (0 -> E -> F -> G -> 0 exact, a G-regular): modulo a the
-- sequence is still exact.  At E: A e = a f gives f = A e' by (lift) (for
-- E -> F -> G), so A e = A (a e') and e = a e'.  At F: (step), with
-- z = B y1 since B is onto.  At G: B is onto.
level l ; open Ring[l] ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Bj = Bijection[l] ;
module Over (Rg : A7.CRing) {
 module SM = Submodules[l].Over[Rg] ;
 -- a is H-regular
 Regular (a : Rg.R) (H : SM.Module) : U l = (h : H.M) -> Id H.M (H.sm a h) H.mz -> Id H.M h H.mz ;
 -- im f, merely
 InIm (P Q : SM.Module) (f : SM.Linear P Q) (y : Q.M) : U l = Tr.Trunc[Bj.Fibre f.1 y].carrier ;
 -- y in im A + a F, merely
 InImMod (a : Rg.R) (E F : SM.Module) (A : SM.Linear E F) (y : F.M) : U l =
  Tr.Trunc[(x : E.M) * (y1 : F.M) * Id F.M y (F.madd (A.1 x) (F.sm a y1))].carrier ;
 -- exact at the middle: B A = 0 and ker B in im A
 record Exact (E F G : SM.Module) (A : SM.Linear E F) (B : SM.Linear F G) {
  comp (x : E.M) : Id G.M (B.1 (A.1 x)) G.mz ;
  ker (y : F.M) : Id G.M (B.1 y) G.mz -> InIm E F A y ;
 } ;
 -- exact modulo a at the middle
 ExactMod (a : Rg.R) (E F G : SM.Module) (A : SM.Linear E F) (B : SM.Linear F G) : U l =
  (y : F.M) (z : G.M) -> Id G.M (B.1 y) (G.sm a z) -> InImMod a E F A y ;

 -- (lift)
 module Lift (a : Rg.R) (F G H : SM.Module) (B : SM.Linear F G) (C : SM.Linear G H)
  (ex : Exact[F,G,H,B,C]) (reg : Regular a H) (y : F.M) (z : G.M) (e : Id G.M (B.1 y) (G.sm a z)) {
  C-zero : Id H.M (C.1 z) H.mz = reg (C.1 z) (calc H.M {
   H.sm a (C.1 z) =< symH (C.2.2 a z) > C.1 (G.sm a z)
    =< apH C.1 (symH e) > C.1 (B.1 y)
    =< ex.comp y > H.mz }) ;
  result : InIm F G B z = ex.ker z C-zero ;
 } ;
 -- (step)
 module Step (a : Rg.R) (E F G : SM.Module) (A : SM.Linear E F) (B : SM.Linear F G)
  (ex : Exact[E,F,G,A,B]) (y : F.M) (z : G.M) (e : Id G.M (B.1 y) (G.sm a z)) (w : Bj.Fibre B.1 z) {
  module MF = A7.MA[Rg,F] ; module MG = A7.MA[Rg,G] ;
  y0 : F.M = MF.sub y (F.sm a w.1) ;
  B-zero : Id G.M (B.1 y0) G.mz = calc G.M {
   B.1 y0 =< SM.Lin[F,G,B].map-sub y (F.sm a w.1) > MG.sub (B.1 y) (B.1 (F.sm a w.1))
    =< apH (MG.sub (B.1 y)) (transH (B.2.2 a w.1) (apH (G.sm a) w.2)) > MG.sub (B.1 y) (G.sm a z)
    =< apH (\ t -> MG.sub t (G.sm a z)) e > MG.sub (G.sm a z) (G.sm a z)
    =< MG.sub-self (G.sm a z) > G.mz } ;
  -- (y - a w) + a w = y
  cancel : Id F.M (F.madd y0 (F.sm a w.1)) y = calc F.M {
   F.madd (F.madd y (F.mneg (F.sm a w.1))) (F.sm a w.1)
    =< symH (F.maddA y (F.mneg (F.sm a w.1)) (F.sm a w.1)) > F.madd y (F.madd (F.mneg (F.sm a w.1)) (F.sm a w.1))
    =< apH (F.madd y) (transH (F.maddC (F.mneg (F.sm a w.1)) (F.sm a w.1)) (F.maddN (F.sm a w.1))) > F.madd y F.mz
    =< F.maddZ y > y } ;
  back (x : Bj.Fibre A.1 y0) : Id F.M y (F.madd (A.1 x.1) (F.sm a w.1)) =
   transH (symH cancel) (apH (\ t -> F.madd t (F.sm a w.1)) (symH x.2)) ;
  result : InImMod a E F A y = TC.map (Bj.Fibre A.1 y0) ((x : E.M) * (y1 : F.M) * Id F.M y (F.madd (A.1 x) (F.sm a y1)))
   (\ x -> (x.1,w.1,back x)) (ex.ker y0 B-zero) ;
 } ;

 -- Lemma 4.1
 module Lemma41 (a : Rg.R) (E F G H : SM.Module) (A : SM.Linear E F) (B : SM.Linear F G) (C : SM.Linear G H)
  (exF : Exact[E,F,G,A,B]) (exG : Exact[F,G,H,B,C]) (reg : Regular a H) {
  result : ExactMod a E F G A B = \ y z e ->
   TC.rec (Bj.Fibre B.1 z) @l (InImMod a E F A y) Tr.Trunc[(x : E.M) * (y1 : F.M) * Id F.M y (F.madd (A.1 x) (F.sm a y1))].proposition
    (\ w -> Step[a,E,F,G,A,B,exF,y,z,e,w].result) (Lift[a,F,G,H,B,C,exG,reg,y,z,e].result) ;
 } ;
 -- Corollary 4.2: a short exact sequence stays exact modulo a G-regular a
 module Cor42 (a : Rg.R) (E F G : SM.Module) (A : SM.Linear E F) (B : SM.Linear F G)
  (inj : Bj.Injective A.1) (ex : Exact[E,F,G,A,B]) (onto : (z : G.M) -> InIm F G B z) (reg : Regular a G) {
  -- at E: A e in a F gives e in a E
  module AtE (e : E.M) (f : F.M) (h : Id F.M (A.1 e) (F.sm a f)) {
   from (x : Bj.Fibre A.1 f) : Bj.Fibre (E.sm a) e = (x.1,inj (E.sm a x.1) e (calc F.M {
    A.1 (E.sm a x.1) =< A.2.2 a x.1 > F.sm a (A.1 x.1) =< apH (F.sm a) x.2 > F.sm a f =< symH h > A.1 e })) ;
   result : Tr.Trunc[Bj.Fibre (E.sm a) e].carrier =
    TC.map (Bj.Fibre A.1 f) (Bj.Fibre (E.sm a) e) from (Lift[a,E,F,G,A,B,ex,reg,e,f,h].result) ;
  } ;
  at-e (e : E.M) (f : F.M) (h : Id F.M (A.1 e) (F.sm a f)) : Tr.Trunc[Bj.Fibre (E.sm a) e].carrier = AtE[e,f,h].result ;
  -- at F
  at-f : ExactMod a E F G A B = \ y z e ->
   TC.rec (Bj.Fibre B.1 z) @l (InImMod a E F A y) Tr.Trunc[(x : E.M) * (y1 : F.M) * Id F.M y (F.madd (A.1 x) (F.sm a y1))].proposition
    (\ w -> Step[a,E,F,G,A,B,ex,y,z,e,w].result) (onto z) ;
 } ;
} ;
