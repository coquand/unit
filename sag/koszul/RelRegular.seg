-- ctete §1, Lemma 1, Corollary 2, Lemma 3, modulo an ideal (so that they
-- apply "modulo a regular sequence").  The ideal is given by its membership
-- predicate Z (cffr/RegularIdeal.IdealPred); for a finitely generated J,
-- Z x is "x is merely in J"; Z x = (x = 0) gives the statements of ctete.
-- Regularity is RegularIdeal's, for R acting modulo Z (RegMod) or modulo
-- Z + (a) (RegModMod, RegIdealMod); Z + (a) is itself an IdealPred (plus).
--
-- x == y means Z (x - y); x in Z + (a) means merely x == a w; a is
-- regular mod Z when Z (a x) gives Z x, hence (cancel) a x == a y gives
-- x == y.  Z + (a) is closed under sums and multiples, so b in I + Z and
-- I x in Z + (a) give b x in Z + (a).
--
-- Lemma 1.  a, b regular mod Z and a y == b x: if x == a w then
--   a y == b x == b a w = a (b w), so y == b w (cancel).
-- Corollary 2.  a, b regular mod Z: if a is regular mod Z + (b) then b is
--   regular mod Z + (a).  If b x == a y, then a y is in Z + (b), so y is
--   (a regular mod Z + (b)), and Lemma 1 (a y == b x, for b, a) gives x in
--   Z + (a).  So (a, b) is a regular sequence mod Z iff (b, a) is.
-- Lemma 3.  a, b regular mod Z, b in I + Z: if I is regular mod Z + (b)
--   then it is regular mod Z + (a).  Let I x be in Z + (a).  Then b x == a y
--   for some y; for each i, I_i x == a w_i, so
--   a (I_i y) == I_i b x == b a w_i = a (b w_i) and I_i y == b w_i; so y is
--   in Z + (b), and x is in Z + (a) by Lemma 1.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ;
module Over (Rg : CRing) (ZI : RI.IdealPred[Rg]) {
 open Rg ; module L = RL[Rg] ;
 module IL = RI.IdealLaws[Rg,ZI] ;
 Z (x : R) : U l = ZI.In x ;
 z0 : Z z = ZI.in-zero ;
 zadd (x y : R) (hx : Z x) (hy : Z y) : Z (add x y) = ZI.in-add x y hx hy ;
 zmul (r x : R) (h : Z x) : Z (mul r x) = ZI.in-mul r x h ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 sub (x y : R) : R = add x (neg y) ;
 zeq (x y : R) (e : Id R x y) (h : Z x) : Z y = subst Z e h ;
 -- x == y
 Cong (x y : R) : U l = Z (sub x y) ;
 -- x in Z + (a)
 InMod (a x : R) : U l = Tr.Trunc[(w : R) * Cong x (mul a w)].carrier ;
 inmod-prop (a x : R) : Pr.isProp (InMod a x) = Tr.Trunc[(w : R) * Cong x (mul a w)].proposition ;
 -- a regular mod Z
 RegMod (a : R) : U l = RI.Over[Rg,RI.modulo Rg ZI].ElementUnder (\ x -> Top) a ;

 ---------------------------------------------------------------------
 -- ring identities
 sub-self (x : R) : Id R (sub x x) z = addN x ;
 sub-chain (x y w : R) : Id R (add (sub x y) (sub y w)) (sub x w) = calc R {
  add (add x (neg y)) (add y (neg w)) =< sym (addA x (neg y) (add y (neg w))) > add x (add (neg y) (add y (neg w)))
   =< ap (add x) (addA (neg y) y (neg w)) > add x (add (add (neg y) y) (neg w))
   =< ap (\ t -> add x (add t (neg w))) (L.neg-cancel y) > add x (add z (neg w))
   =< ap (add x) (L.zl (neg w)) > add x (neg w) } ;
 sub-flip (x y : R) : Id R (neg (sub x y)) (sub y x) = trans (L.negsub x y) (addC (neg x) y) ;
 sub-mul (a x y : R) : Id R (mul a (sub x y)) (sub (mul a x) (mul a y)) =
  trans (dist a x (neg y)) (ap (add (mul a x)) (L.mul-neg a y)) ;
 sub-add (x y u v : R) : Id R (add (sub x y) (sub u v)) (sub (add x u) (add y v)) =
  trans (L.swap x (neg y) u (neg v)) (ap (add (add x u)) (sym (L.neg-add y v))) ;
 zneg (x : R) (h : Z x) : Z (neg x) = IL.in-neg x h ;
 -- == is a congruence
 cong-eq (x y : R) (e : Id R x y) : Cong x y = zeq z (sub x y) (trans (sym (sub-self x)) (ap (sub x) e)) z0 ;
 cong-refl (x : R) : Cong x x = cong-eq x x (refl x) ;
 cong-sym (x y : R) (h : Cong x y) : Cong y x = zeq (neg (sub x y)) (sub y x) (sub-flip x y) (zneg (sub x y) h) ;
 cong-trans (x y w : R) (h : Cong x y) (k : Cong y w) : Cong x w = zeq (add (sub x y) (sub y w)) (sub x w) (sub-chain x y w) (zadd (sub x y) (sub y w) h k) ;
 cong-add (x y u v : R) (h : Cong x y) (k : Cong u v) : Cong (add x u) (add y v) =
  zeq (add (sub x y) (sub u v)) (sub (add x u) (add y v)) (sub-add x y u v) (zadd (sub x y) (sub u v) h k) ;
 cong-mul (r x y : R) (h : Cong x y) : Cong (mul r x) (mul r y) = zeq (mul r (sub x y)) (sub (mul r x) (mul r y)) (sub-mul r x y) (zmul r (sub x y) h) ;
 cong-zero (x : R) (h : Z x) : Cong x z = zeq x (sub x z) (sym (trans (ap (add x) L.neg-zero) (addZ x))) h ;
 zero-cong (x : R) (h : Cong x z) : Z x = zeq (sub x z) x (trans (ap (add x) L.neg-zero) (addZ x)) h ;
 -- cancellation
 cancel (a : R) (ra : RegMod a) (x y : R) (h : Cong (mul a x) (mul a y)) : Cong x y =
  ra (sub x y) tt (zeq (sub (mul a x) (mul a y)) (mul a (sub x y)) (sym (sub-mul a x y)) h) ;
 -- Z + (a) is closed under sums, multiples and ==
 inmod-zero (a : R) : InMod a z = Tr.Trunc[(w : R) * Cong z (mul a w)].inc (z,cong-eq z (mul a z) (sym (L.mul-zero a))) ;
 inmod-add (a x y : R) (hx : InMod a x) (hy : InMod a y) : InMod a (add x y) =
  TC.map2 ((w : R) * Cong x (mul a w)) ((w : R) * Cong y (mul a w)) ((w : R) * Cong (add x y) (mul a w))
   (\ u v -> (add u.1 v.1,cong-trans (add x y) (add (mul a u.1) (mul a v.1)) (mul a (add u.1 v.1))
     (cong-add x (mul a u.1) y (mul a v.1) u.2 v.2) (cong-eq _ _ (sym (dist a u.1 v.1))))) hx hy ;
 inmod-mul (a r x : R) (hx : InMod a x) : InMod a (mul r x) =
  TC.map ((w : R) * Cong x (mul a w)) ((w : R) * Cong (mul r x) (mul a w))
   (\ u -> (mul r u.1,cong-trans (mul r x) (mul r (mul a u.1)) (mul a (mul r u.1)) (cong-mul r x (mul a u.1) u.2) (cong-eq _ _ (L.mul-swap r a u.1)))) hx ;
 inmod-cong (a x y : R) (h : Cong x y) (hy : InMod a y) : InMod a x =
  TC.map ((w : R) * Cong y (mul a w)) ((w : R) * Cong x (mul a w)) (\ u -> (u.1,cong-trans x y (mul a u.1) h u.2)) hy ;
 inmod-sum (a : R) : (n : Nat) (v : Ps.Fin n -> R) -> ((i : Ps.Fin n) -> InMod a (v i)) -> InMod a (S.sum n v) = split {
  zero -> \ v h -> inmod-zero a ;
  suc n | r -> \ v h -> inmod-add a (v (inr tt)) (S.sum n (\ i -> v (inl i))) (h (inr tt)) (r (\ i -> v (inl i)) (\ i -> h (inl i))) } ;

 -- Z + (a), as an ideal
 plus (a : R) : RI.IdealPred[Rg] = RI.mkIdealPred Rg (InMod a) (inmod-zero a) (inmod-add a) (\ r x h -> inmod-mul a r x h) ;
 -- a regular mod Z + (b)
 RegModMod (b a : R) : U l = RI.Over[Rg,RI.modulo Rg (plus b)].ElementUnder (\ x -> Top) a ;

 ---------------------------------------------------------------------
 -- Lemma 1
 lemma1 (a b : R) (ra : RegMod a) (rb : RegMod b) (x y : R) (h : Cong (mul a y) (mul b x)) (hx : InMod a x) : InMod b y =
  TC.map ((w : R) * Cong x (mul a w)) ((w : R) * Cong y (mul b w)) (\ u ->
   (u.1,cancel a ra y (mul b u.1) (cong-trans (mul a y) (mul b x) (mul a (mul b u.1)) h
    (cong-trans (mul b x) (mul b (mul a u.1)) (mul a (mul b u.1)) (cong-mul b x (mul a u.1) u.2) (cong-eq _ _ (L.mul-swap b a u.1)))))) hx ;
 -- Corollary 2
 cor2 (a b : R) (ra : RegMod a) (rb : RegMod b) (h : RegModMod b a) : RegModMod a b = \ x tx t ->
  TC.rec ((y : R) * Cong (mul b x) (mul a y)) @l (InMod a x) (inmod-prop a x) (\ u ->
   lemma1 b a rb ra u.1 x u.2
    (h u.1 tt (Tr.Trunc[(w : R) * Cong (mul a u.1) (mul b w)].inc (x,cong-sym (mul b x) (mul a u.1) u.2)))) t ;

 ---------------------------------------------------------------------
 -- Lemma 3
 -- b in I + Z
 InI (n : Nat) (I : Ps.Fin n -> R) (b : R) : U l = Tr.Trunc[(c : Ps.Fin n -> R) * Cong b (S.lin n I c)].carrier ;
 -- I regular mod Z + (a)
 RegIdealMod (a : R) (n : Nat) (I : Ps.Fin n -> R) : U l = RI.Over[Rg,RI.modulo Rg (plus a)].Regular (Ps.Fin n) I ;
 module Lemma3 (a b : R) (ra : RegMod a) (rb : RegMod b) (n : Nat) (I : Ps.Fin n -> R) (ib : InI n I b) (hb : RegIdealMod b n I)
  (x : R) (hx : (i : Ps.Fin n) -> InMod a (mul (I i) x)) {
  -- b x is in Z + (a)
  expand (c : Ps.Fin n -> R) : Id R (mul x (S.lin n I c)) (S.sum n (\ i -> mul (c i) (mul (I i) x))) = calc R {
   mul x (S.sum n (\ i -> mul (I i) (c i)))
    =< sym (S.sum-scale x n (\ i -> mul (I i) (c i))) > S.sum n (\ i -> mul x (mul (I i) (c i)))
    =< S.sum-cong n (\ i -> mul x (mul (I i) (c i))) (\ i -> mul (c i) (mul (I i) x)) (\ i ->
       trans (L.mul-swap x (I i) (c i)) (trans (ap (mul (I i)) (mulC x (c i))) (L.mul-swap (I i) (c i) x))) >
   S.sum n (\ i -> mul (c i) (mul (I i) x)) } ;
  bx : InMod a (mul b x) = TC.rec ((c : Ps.Fin n -> R) * Cong b (S.lin n I c)) @l (InMod a (mul b x)) (inmod-prop a (mul b x)) (\ c ->
   inmod-cong a (mul b x) (S.sum n (\ i -> mul (c.1 i) (mul (I i) x)))
    (cong-trans (mul b x) (mul x (S.lin n I c.1)) (S.sum n (\ i -> mul (c.1 i) (mul (I i) x)))
     (cong-trans (mul b x) (mul x b) (mul x (S.lin n I c.1)) (cong-eq _ _ (mulC b x)) (cong-mul x b (S.lin n I c.1) c.2))
     (cong-eq _ _ (expand c.1)))
    (inmod-sum a n (\ i -> mul (c.1 i) (mul (I i) x)) (\ i -> inmod-mul a (c.1 i) (mul (I i) x) (hx i)))) ib ;
  -- if b x == a y then I y is in Z + (b), so y is, and x is in Z + (a)
  module Y (y : R) (c : Cong (mul b x) (mul a y)) {
   module Term (i : Ps.Fin n) (u : (w : R) * Cong (mul (I i) x) (mul a w)) {
    chain : Cong (mul a (mul (I i) y)) (mul a (mul b u.1)) =
     cong-trans (mul a (mul (I i) y)) (mul (I i) (mul a y)) (mul a (mul b u.1)) (cong-eq _ _ (L.mul-swap a (I i) y))
      (cong-trans (mul (I i) (mul a y)) (mul (I i) (mul b x)) (mul a (mul b u.1)) (cong-mul (I i) (mul a y) (mul b x) (cong-sym (mul b x) (mul a y) c))
       (cong-trans (mul (I i) (mul b x)) (mul b (mul (I i) x)) (mul a (mul b u.1)) (cong-eq _ _ (L.mul-swap (I i) b x))
        (cong-trans (mul b (mul (I i) x)) (mul b (mul a u.1)) (mul a (mul b u.1)) (cong-mul b (mul (I i) x) (mul a u.1) u.2)
         (cong-eq _ _ (L.mul-swap b a u.1))))) ;
    result : InMod b (mul (I i) y) = Tr.Trunc[(w : R) * Cong (mul (I i) y) (mul b w)].inc
     (u.1,cancel a ra (mul (I i) y) (mul b u.1) chain) ;
   } ;
   iy (i : Ps.Fin n) : InMod b (mul (I i) y) = TC.rec ((w : R) * Cong (mul (I i) x) (mul a w)) @l (InMod b (mul (I i) y)) (inmod-prop b (mul (I i) y))
    (\ u -> Term[i,u].result) (hx i) ;
   result : InMod a x = lemma1 b a rb ra y x c (hb y tt iy) ;
  } ;
  result : InMod a x = TC.rec ((y : R) * Cong (mul b x) (mul a y)) @l (InMod a x) (inmod-prop a x) (\ u -> Y[u.1,u.2].result) bx ;
 } ;
 lemma3 (a b : R) (ra : RegMod a) (rb : RegMod b) (n : Nat) (I : Ps.Fin n -> R) (ib : InI n I b) (hb : RegIdealMod b n I) : RegIdealMod a n I =
  \ x t hx -> Lemma3[a,b,ra,rb,n,I,ib,hb,x,hx].result ;
} ;
