-- Localization and polynomials commute: S[X][1/x] ~ S[1/x][X], compatibly
-- with the constants of S and with X.
--
-- Loc D x is cffr/LocalRegular.Invert (the localization at the powers of
-- x), with its set condition.  Two maps out of D[1/x] that agree on the
-- constants agree: for a fraction q = a / s, s q = a, and g (s) is a unit.
-- alpha : S[X][1/x] -> S[1/x][X] is the map out of the localization
-- (horrocks/MonoidLocalizationMap) of S[X] -> S[1/x][X] (constants by
-- S -> S[1/x], X to X), which inverts x.  beta : S[1/x][X] -> S[X][1/x]
-- is given (polynomial/Universal) on S[1/x] by the map out of the
-- localization of S -> S[X] -> S[X][1/x], and sends X to X.  Both
-- composites are identities: they agree with the identity on generators
-- (constants and X, and constants of the localizations).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RH = RingHom[l] ; module LR = LocalRegular[l] ; module AP = AffinePowers[l] ;
module TG = TrueGrade[l] ; module TB = TrueGradeBase[l] ;

-- the localization at x
Loc (D : TG.RD) (x : D.1.R) : TG.RD = (LR.Invert[D.1,x].ring,LR.Invert[D.1,x].B.set) ;
loc (D : TG.RD) (x : D.1.R) : RH.Hom D.1 (Loc D x).1 = LR.Invert[D.1,x].inclusion ;
-- units
hom-unit (A B : CRing) (h : RH.Hom A B) (a : A.R) (u : RL[A].unit a) : RL[B].unit (h.1 a) =
 (h.1 u.1,trans (sym (h.2.2.2 a u.1)) (trans (ap h.1 u.2) h.2.1)) ;
cancel-unit (C : CRing) (c u y y' : C.R) (hu : Id C.R (C.mul c u) C.o) (h : Id C.R (C.mul c y) (C.mul c y')) : Id C.R y y' = calc C.R {
 y =< sym (RL[C].one-left y) > C.mul C.o y
  =< ap (\ t -> C.mul t y) (sym (trans (C.mulC u c) hu)) > C.mul (C.mul u c) y
  =< sym (C.mulA u c y) > C.mul u (C.mul c y)
  =< ap (C.mul u) h > C.mul u (C.mul c y')
  =< C.mulA u c y' > C.mul (C.mul u c) y'
  =< ap (\ t -> C.mul t y') (trans (C.mulC u c) hu) > C.mul C.o y'
  =< RL[C].one-left y' > y' } ;
-- x is a unit in D[1/x]
x-unit (D : TG.RD) (x : D.1.R) : RL[(Loc D x).1].unit ((loc D x).1 x) =
 LR.Invert[D.1,x].B.inverse x (suc zero,sym (D.1.mulO x)) ;
-- powers of x become units under a map inverting x
powers-unit (D : TG.RD) (x : D.1.R) (C : TG.RD) (h : RH.Hom D.1 C.1) (u : RL[C.1].unit (h.1 x)) (s : D.1.R) (hs : LR.Invert[D.1,x].Powers s) :
 RL[C.1].unit (h.1 s) =
 subst (\ t -> RL[C.1].unit t) (sym (trans (ap h.1 hs.2) (AP.power-map D.1 C.1 h x hs.1)))
  (AP.Over[C.1].Units[C.2].power-unit (h.1 x) u hs.1) ;
-- maps out of D[1/x] agreeing on constants agree
module LocUnique (D : TG.RD) (x : D.1.R) (C : TG.RD) (g g' : RH.Hom (Loc D x).1 C.1)
 (hc : (a : D.1.R) -> Id C.1.R (g.1 ((loc D x).1 a)) (g'.1 ((loc D x).1 a))) {
 module IV = LR.Invert[D.1,x] ; module B = IV.B ;
 at-fraction (p : B.Raw.Fraction) : Id C.1.R (g.1 (B.include p)) (g'.1 (B.include p)) =
  cancel-unit C.1 (g.1 (B.constant p.2.1)) (hom-unit (Loc D x).1 C.1 g (B.constant p.2.1) (B.inverse p.2.1 p.2.2)).1 (g.1 (B.include p)) (g'.1 (B.include p))
   (hom-unit (Loc D x).1 C.1 g (B.constant p.2.1) (B.inverse p.2.1 p.2.2)).2
   (calc C.1.R {
     C.1.mul (g.1 (B.constant p.2.1)) (g.1 (B.include p)) =< sym (g.2.2.2 (B.constant p.2.1) (B.include p)) > g.1 (B.mulQ (B.constant p.2.1) (B.include p))
      =< ap g.1 (B.fraction-equation p) > g.1 (B.constant p.1)
      =< hc p.1 > g'.1 (B.constant p.1)
      =< ap g'.1 (sym (B.fraction-equation p)) > g'.1 (B.mulQ (B.constant p.2.1) (B.include p))
      =< g'.2.2.2 (B.constant p.2.1) (B.include p) > C.1.mul (g'.1 (B.constant p.2.1)) (g'.1 (B.include p))
      =< ap (\ t -> C.1.mul t (g'.1 (B.include p))) (sym (hc p.2.1)) > C.1.mul (g.1 (B.constant p.2.1)) (g'.1 (B.include p)) }) ;
 at (q : (Loc D x).1.R) : Id C.1.R (g.1 q) (g'.1 q) =
  TC.rec (B.Representatives q) @l (Id C.1.R (g.1 q) (g'.1 q)) (C.2 (g.1 q) (g'.1 q))
   (\ r -> trans (ap g.1 (sym r.2)) (trans (at-fraction r.1) (ap g'.1 r.2))) (B.representatives q) ;
} ;

---------------------------------------------------------------------
-- S[X][1/x] ~ S[1/x][X]
module Comm (S : TG.RD) (x : S.1.R) {
 -- alpha
 module PM = TB.Map1[S,(Loc S x),(loc S x)] ;
 x-unit-LX : RL[(TG.ext1 (Loc S x)).1].unit (PM.map.1 (TG.PolyX[S].X.constant x)) =
  subst (\ t -> RL[(TG.ext1 (Loc S x)).1].unit t) (sym (PM.on-c x)) (hom-unit (Loc S x).1 (TG.ext1 (Loc S x)).1 TG.PolyX[(Loc S x)].X.inclusion ((loc S x).1 x) (x-unit S x)) ;
 module MA = MonoidLocalizationMap[l].Over[(TG.ext1 S).1,LR.Invert[(TG.ext1 S).1,TG.PolyX[S].X.constant x].Powers,LR.Invert[(TG.ext1 S).1,TG.PolyX[S].X.constant x].one,LR.Invert[(TG.ext1 S).1,TG.PolyX[S].X.constant x].product,
  (TG.ext1 (Loc S x)).1,(TG.ext1 (Loc S x)).2,PM.map,powers-unit (TG.ext1 S) (TG.PolyX[S].X.constant x) (TG.ext1 (Loc S x)) PM.map x-unit-LX] ;
 alpha : RH.Hom (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 (TG.ext1 (Loc S x)).1 = MA.hom ;
 alpha-c (p : (TG.ext1 S).1.R) : Id (TG.ext1 (Loc S x)).1.R (alpha.1 ((loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 p)) (PM.map.1 p) = MA.constants p ;
 -- beta
 incS : RH.Hom S.1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 = RH.compose S.1 (TG.ext1 S).1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 (loc (TG.ext1 S) (TG.PolyX[S].X.constant x)) TG.PolyX[S].X.inclusion ;
 x-unit-LS : RL[(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1].unit (incS.1 x) = x-unit (TG.ext1 S) (TG.PolyX[S].X.constant x) ;
 module MB = MonoidLocalizationMap[l].Over[S.1,LR.Invert[S.1,x].Powers,LR.Invert[S.1,x].one,LR.Invert[S.1,x].product,
  (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1,(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).2,incS,powers-unit S x (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)) incS x-unit-LS] ;
 module GB = Universal[l].Property[(Loc S x).1,(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1,(Loc S x).2,(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).2].Given[MB.hom,(loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 TG.PolyX[S].X.variable] ;
 beta : RH.Hom (TG.ext1 (Loc S x)).1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 = GB.extend ;
 -- beta o PM.map agrees with the inclusion of S[X]
 module BP = TB.Agree[S,(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)),RH.compose (TG.ext1 S).1 (TG.ext1 (Loc S x)).1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 beta PM.map,(loc (TG.ext1 S) (TG.PolyX[S].X.constant x)),
  \ a -> trans (ap beta.1 (PM.on-c a)) (trans (GB.on-constants ((loc S x).1 a)) (MB.constants a)),
  trans (ap beta.1 PM.on-x) GB.on-variable] ;
 beta-alpha (q : (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1.R) : Id (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1.R (beta.1 (alpha.1 q)) q =
  LocUnique[(TG.ext1 S),TG.PolyX[S].X.constant x,(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)),RH.compose (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 (TG.ext1 (Loc S x)).1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 beta alpha,RH.identity (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1,
   \ p -> trans (ap beta.1 (alpha-c p)) (BP.at p)].at q ;
 -- alpha o beta is the identity on S[1/x][X]
 module AB = LocUnique[S,x,(TG.ext1 (Loc S x)),RH.compose (Loc S x).1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 (TG.ext1 (Loc S x)).1 alpha MB.hom,TG.PolyX[(Loc S x)].X.inclusion,
  \ a -> trans (ap alpha.1 (MB.constants a)) (trans (alpha-c (TG.PolyX[S].X.constant a)) (PM.on-c a))] ;
 alpha-beta (y : (TG.ext1 (Loc S x)).1.R) : Id (TG.ext1 (Loc S x)).1.R (alpha.1 (beta.1 y)) y =
  TB.Agree[(Loc S x),(TG.ext1 (Loc S x)),RH.compose (TG.ext1 (Loc S x)).1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 (TG.ext1 (Loc S x)).1 alpha beta,RH.identity (TG.ext1 (Loc S x)).1,
   \ q -> trans (ap alpha.1 (GB.on-constants q)) (AB.at q),
   trans (ap alpha.1 GB.on-variable) (trans (alpha-c TG.PolyX[S].X.variable) PM.on-x)].at y ;
 iso : TB.Iso (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)) (TG.ext1 (Loc S x)) = (alpha,beta,beta-alpha,alpha-beta) ;
} ;

---------------------------------------------------------------------
-- two variables: S[X][Y][1/x] ~ S[1/x][X][Y]
module Comm2 (S : TG.RD) (x : S.1.R) {
 module C0 = Comm[S,x] ;
 module C1 = Comm[TG.ext1 S,TG.PolyX[S].X.constant x] ;
 iso : TB.Iso (Loc (TG.ext1 (TG.ext1 S)) (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant x))) (TG.ext1 (TG.ext1 (Loc S x))) = TB.iso-compose (Loc (TG.ext1 (TG.ext1 S)) (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant x))) (TG.ext1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x))) (TG.ext1 (TG.ext1 (Loc S x))) C1.iso (TB.iso-ext1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)) (TG.ext1 (Loc S x)) C0.iso) ;
 -- S[X][Y] -> S[1/x][X][Y], by coefficients
 module M2 = TB.Map1[(TG.ext1 S),(TG.ext1 (Loc S x)),C0.PM.map] ;
 psi : RH.Hom (TG.ext1 (TG.ext1 S)).1 (TG.ext1 (TG.ext1 (Loc S x))).1 = M2.map ;
 module ML = TB.Map1[(Loc (TG.ext1 S) (TG.PolyX[S].X.constant x)),(TG.ext1 (Loc S x)),C0.alpha] ;
 module CP = TB.Agree[(TG.ext1 S),TG.ext1 (TG.ext1 (Loc S x)),RH.compose (TG.ext1 (TG.ext1 S)).1 (TG.ext1 (Loc (TG.ext1 S) (TG.PolyX[S].X.constant x))).1 (TG.ext1 (TG.ext1 (Loc S x))).1 ML.map C1.PM.map,psi,
  \ q -> trans (ap ML.map.1 (C1.PM.on-c q)) (trans (ML.on-c ((loc (TG.ext1 S) (TG.PolyX[S].X.constant x)).1 q)) (trans (ap TG.PolyX[(TG.ext1 (Loc S x))].X.constant (C0.alpha-c q)) (sym (M2.on-c q)))),
  trans (ap ML.map.1 C1.PM.on-x) (trans ML.on-x (sym M2.on-x))] ;
 -- the isomorphism on S[X][Y] is psi
 th-c (p : (TG.ext1 (TG.ext1 S)).1.R) : Id (TG.ext1 (TG.ext1 (Loc S x))).1.R (iso.1.1 ((loc (TG.ext1 (TG.ext1 S)) (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant x))).1 p)) (psi.1 p) = trans (ap ML.map.1 (C1.alpha-c p)) (CP.at p) ;
 back (p : (TG.ext1 (TG.ext1 S)).1.R) : Id (Loc (TG.ext1 (TG.ext1 S)) (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant x))).1.R (iso.2.1.1 (psi.1 p)) ((loc (TG.ext1 (TG.ext1 S)) (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant x))).1 p) = trans (ap iso.2.1.1 (sym (th-c p))) (iso.2.2.1 ((loc (TG.ext1 (TG.ext1 S)) (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant x))).1 p)) ;
 psi-cc (z : S.1.R) : Id (TG.ext1 (TG.ext1 (Loc S x))).1.R (psi.1 (TG.PolyX[TG.ext1 S].X.constant (TG.PolyX[S].X.constant z))) (TG.PolyX[(TG.ext1 (Loc S x))].X.constant (TG.PolyX[Loc S x].X.constant ((loc S x).1 z))) =
  trans (M2.on-c (TG.PolyX[S].X.constant z)) (ap TG.PolyX[(TG.ext1 (Loc S x))].X.constant (C0.PM.on-c z)) ;
} ;
