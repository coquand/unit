-- Koszul vectors of degree 3, and degree-2 vectors as alternating families
-- (cffr §6, item 3).  As in KoszulVectors, by recursion on n:
-- vec3 w = (vec3 w', vec2 (i, j |-> w_(i,j,last))).
-- On vec2, tw_J acts as 1 (two signs).  With the cone recursion,
--   d (vec2 x) = vec3 (i, j, k |-> a_i x_jk - a_j x_ik + a_k x_ij) .
-- A vector of degree 2 is vec2 of the alternating family of its values
-- (fam2: x_(i,last) is the value at {i, last}, x_(last,i) its negative,
-- x_(last,last) = 0; conc2).  For x alternating, a_i x_jk - a_j x_ik +
-- a_k x_ij is alternating (it changes sign when two indices are
-- exchanged and vanishes when two are equal), and vec3 of such a family
-- vanishes only for the zero family (eight cases on whether i, j, k are
-- the last index).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module KX = KoszulExact[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (E : A7.Mod[RingBridge[l].Over[Rg,setR].ring]) {
 open Rg ;
 module KV = KoszulVectors[l].Over[Rg,setR,E] ;
 module KZ = KV.KZ ; module CF = KZ.CF ; module ME = CF.ME ; module KC = KV.KC ;
 module G1 = KV.G1 ;
 module BA = KV.BA ;
 open ExteriorModel[l].Over[Rg] ;
 tw (n : Nat) (J : C.Index n) : R = KV.tw n J ;

 ---------------------------------------------------------------------
 -- vec3, and linearity of vec2
 vec3 : (n : Nat) -> (Ps.Fin n -> Ps.Fin n -> Ps.Fin n -> E.M) -> (CF.V n).M = split {
  zero -> \ w -> (CF.V zero).mz ;
  suc n | r -> \ w -> KV.vplus n (r (\ i j k -> w (inl i) (inl j) (inl k))) (KV.vec2 n (\ i j -> w (inl i) (inl j) (inr tt))) } ;
 vec2-add : (n : Nat) (p q : Ps.Fin n -> Ps.Fin n -> E.M) (J : C.Index n) ->
  Id E.M (KV.vec2 n (\ i j -> E.madd (p i j) (q i j)) J) (E.madd (KV.vec2 n p J) (KV.vec2 n q J)) = split {
  zero -> \ p q J -> sym (E.maddZ E.mz) ;
  suc n | r -> \ p q -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (KV.vec2 (suc n) (\ i j -> E.madd (p i j) (q i j)) J) (E.madd (KV.vec2 (suc n) p J) (KV.vec2 (suc n) q J)))
   (\ J -> r (\ i j -> p (inl i) (inl j)) (\ i j -> q (inl i) (inl j)) J) (\ J -> KV.vec1-add n (\ i -> p (inl i) (inr tt)) (\ i -> q (inl i) (inr tt)) J) } ;
 vec2-sm : (n : Nat) (c : R) (x : Ps.Fin n -> Ps.Fin n -> E.M) (J : C.Index n) ->
  Id E.M (KV.vec2 n (\ i j -> E.sm c (x i j)) J) (E.sm c (KV.vec2 n x J)) = split {
  zero -> \ c x J -> sym (ME.sm-zr c) ;
  suc n | r -> \ c x -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (KV.vec2 (suc n) (\ i j -> E.sm c (x i j)) J) (E.sm c (KV.vec2 (suc n) x J)))
   (\ J -> r c (\ i j -> x (inl i) (inl j)) J) (\ J -> KV.vec1-sm n c (\ i -> x (inl i) (inr tt)) J) } ;
 vec2-neg (n : Nat) (x : Ps.Fin n -> Ps.Fin n -> E.M) (J : C.Index n) : Id E.M (KV.vec2 n (\ i j -> E.mneg (x i j)) J) (E.mneg (KV.vec2 n x J)) =
  trans (KV.vec2-ext n (\ i j -> E.mneg (x i j)) (\ i j -> E.sm (neg o) (x i j)) (\ i j -> sym (trans (KV.neg-sm o (x i j)) (ap E.mneg (E.smO (x i j))))) J)
   (trans (vec2-sm n (neg o) x J) (trans (KV.neg-sm o (KV.vec2 n x J)) (ap E.mneg (E.smO (KV.vec2 n x J))))) ;
 vec3-zero : (n : Nat) (J : C.Index n) -> Id E.M (vec3 n (\ i j k -> E.mz) J) E.mz = split {
  zero -> \ J -> refl E.mz ;
  suc n | r -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec3 (suc n) (\ i j k -> E.mz) J) E.mz) r (KV.vec2-zero n) } ;
 vec3-ext : (n : Nat) (p q : Ps.Fin n -> Ps.Fin n -> Ps.Fin n -> E.M) (h : (i j k : Ps.Fin n) -> Id E.M (p i j k) (q i j k)) (J : C.Index n) ->
  Id E.M (vec3 n p J) (vec3 n q J) = split {
  zero -> \ p q h J -> refl E.mz ;
  suc n | r -> \ p q h -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (vec3 (suc n) p J) (vec3 (suc n) q J))
   (\ J -> r (\ i j k -> p (inl i) (inl j) (inl k)) (\ i j k -> q (inl i) (inl j) (inl k)) (\ i j k -> h (inl i) (inl j) (inl k)) J)
   (\ J -> KV.vec2-ext n (\ i j -> p (inl i) (inl j) (inr tt)) (\ i j -> q (inl i) (inl j) (inr tt)) (\ i j -> h (inl i) (inl j) (inr tt)) J) } ;
 -- tw acts as 1 on vec2
 vec2-tw : (n : Nat) (x : Ps.Fin n -> Ps.Fin n -> E.M) (J : C.Index n) -> Id E.M (E.sm (tw n J) (KV.vec2 n x J)) (KV.vec2 n x J) = split {
  zero -> \ x J -> ME.sm-zr (tw zero J) ;
  suc n | r -> \ x -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (E.sm (tw (suc n) J) (KV.vec2 (suc n) x J)) (KV.vec2 (suc n) x J))
   (\ J -> trans (ap (\ t -> E.sm t (KV.vec2 n (\ i j -> x (inl i) (inl j)) J)) (KV.tw-inl n J)) (r (\ i j -> x (inl i) (inl j)) J))
   (\ J -> trans (ap (\ t -> E.sm t (KV.vec1 n (\ i -> x (inl i) (inr tt)) J)) (KV.tw-inr n J))
    (trans (KV.neg-sm (tw n J) (KV.vec1 n (\ i -> x (inl i) (inr tt)) J))
     (trans (ap E.mneg (KV.vec1-tw n (\ i -> x (inl i) (inr tt)) J)) (ME.neg-neg (KV.vec1 n (\ i -> x (inl i) (inr tt)) J))))) } ;

 ---------------------------------------------------------------------
 -- d on vec2
 alt3 (n : Nat) (a : Ps.Fin n -> R) (x : Ps.Fin n -> Ps.Fin n -> E.M) (i j k : Ps.Fin n) : E.M =
  E.madd (E.madd (E.sm (a i) (x j k)) (E.mneg (E.sm (a j) (x i k)))) (E.sm (a k) (x i j)) ;
 inr-part2 (n : Nat) (a' : Ps.Fin n -> R) (c : R) (x' : Ps.Fin n -> Ps.Fin n -> E.M) (y : Ps.Fin n -> E.M) (J : C.Index n) :
  Id E.M (E.madd (E.sm c (E.sm (tw n J) (KV.vec2 n x' J))) (KV.vec2 n (KV.alt n a' y) J))
   (KV.vec2 n (\ i j -> E.madd (KV.alt n a' y i j) (E.sm c (x' i j))) J) = calc E.M {
   E.madd (E.sm c (E.sm (tw n J) (KV.vec2 n x' J))) (KV.vec2 n (KV.alt n a' y) J)
    =< ap (\ t -> E.madd (E.sm c t) (KV.vec2 n (KV.alt n a' y) J)) (vec2-tw n x' J) >
   E.madd (E.sm c (KV.vec2 n x' J)) (KV.vec2 n (KV.alt n a' y) J)
    =< E.maddC (E.sm c (KV.vec2 n x' J)) (KV.vec2 n (KV.alt n a' y) J) >
   E.madd (KV.vec2 n (KV.alt n a' y) J) (E.sm c (KV.vec2 n x' J))
    =< ap (E.madd (KV.vec2 n (KV.alt n a' y) J)) (sym (vec2-sm n c x' J)) >
   E.madd (KV.vec2 n (KV.alt n a' y) J) (KV.vec2 n (\ i j -> E.sm c (x' i j)) J)
    =< sym (vec2-add n (KV.alt n a' y) (\ i j -> E.sm c (x' i j)) J) >
   KV.vec2 n (\ i j -> E.madd (KV.alt n a' y i j) (E.sm c (x' i j))) J } ;
 dvec2 : (n : Nat) (a : Ps.Fin n -> R) (x : Ps.Fin n -> Ps.Fin n -> E.M) (J : C.Index n) ->
  Id E.M (CF.apply n n KZ.K[n,a].wedge (KV.vec2 n x) J) (vec3 n (alt3 n a x) J) = split {
  zero -> \ a x J -> ap (\ v -> v J) CF.SM.Lin[CF.V zero,CF.V zero,CF.lin zero zero KZ.K[zero,a].wedge].map-z ;
  suc n | r -> \ a x -> KX.plus-fn (C.Index n) (C.Index n)
   (\ J -> Id E.M (CF.apply (suc n) (suc n) KZ.K[suc n,a].wedge (KV.vec2 (suc n) x) J) (vec3 (suc n) (alt3 (suc n) a x) J))
   (\ J -> trans (KC.Step[n,a,KV.vec2 (suc n) x].at-inl J) (r (\ k -> a (inl k)) (\ i j -> x (inl i) (inl j)) J))
   (\ J -> trans (KC.Step[n,a,KV.vec2 (suc n) x].at-inr J)
     (trans (ap (E.madd (E.sm (a (inr tt)) (E.sm (tw n J) (KV.vec2 n (\ i j -> x (inl i) (inl j)) J)))) (KV.dvec1 n (\ k -> a (inl k)) (\ i -> x (inl i) (inr tt)) J))
      (inr-part2 n (\ k -> a (inl k)) (a (inr tt)) (\ i j -> x (inl i) (inl j)) (\ i -> x (inl i) (inr tt)) J))) } ;

 ---------------------------------------------------------------------
 -- degree 2 vectors as alternating families
 row-l (n : Nat) (f : Ps.Fin n -> Ps.Fin n -> E.M) (u1 : (CF.V n).M) (i : Ps.Fin n) : Ps.Fin (suc n) -> E.M = split {
  inl j -> f i j ; inr t -> u1 (G1.single n i) } ;
 row-r (n : Nat) (u1 : (CF.V n).M) : Ps.Fin (suc n) -> E.M = split {
  inl j -> E.mneg (u1 (G1.single n j)) ; inr t -> E.mz } ;
 fam2-step (n : Nat) (f : Ps.Fin n -> Ps.Fin n -> E.M) (u1 : (CF.V n).M) : Ps.Fin (suc n) -> Ps.Fin (suc n) -> E.M = split {
  inl i -> row-l n f u1 i ; inr t -> row-r n u1 } ;
 fam2 : (n : Nat) -> (CF.V n).M -> Ps.Fin n -> Ps.Fin n -> E.M = split {
  zero -> \ u i -> efq i ;
  suc n | r -> \ u -> fam2-step n (r (\ I -> u (inl I))) (\ I -> u (inr I)) } ;
 conc2 : (n : Nat) (u : (CF.V n).M) -> KZ.Supp n (suc (suc zero)) u -> (J : C.Index n) -> Id E.M (u J) (KV.vec2 n (fam2 n u) J) = split {
  zero -> \ u su J -> su J (\ e -> zero-suc (suc zero) e) ;
  suc n | r -> \ u su -> KX.plus-fn (C.Index n) (C.Index n) (\ J -> Id E.M (u J) (KV.vec2 (suc n) (fam2 (suc n) u) J))
   (\ J -> r (\ I -> u (inl I)) (\ I ne -> su (inl I) ne) J)
   (\ J -> KV.conc1 n (\ I -> u (inr I)) (\ I ne -> su (inr I) (KV.suc-ne (BA.count n I) (suc zero) ne)) J) } ;
 module Fam2Alt (n : Nat) (u : (CF.V (suc n)).M) (r : KV.AltFamily n (fam2 n (\ I -> u (inl I)))) {
  x : Ps.Fin (suc n) -> Ps.Fin (suc n) -> E.M = fam2 (suc n) u ;
  u1 : (CF.V n).M = \ I -> u (inr I) ;
  anti-l (i : Ps.Fin n) : (j : Ps.Fin (suc n)) -> Id E.M (x j (inl i)) (E.mneg (x (inl i) j)) = split {
   inl j -> r.1 i j ; inr t -> refl (E.mneg (u1 (G1.single n i))) } ;
  anti-r (t : Top) : (j : Ps.Fin (suc n)) -> Id E.M (x j (inr t)) (E.mneg (x (inr t) j)) = split {
   inl j -> sym (ME.neg-neg (u1 (G1.single n j))) ; inr t' -> sym ME.mneg-z } ;
  anti (i j : Ps.Fin (suc n)) : Id E.M (x j i) (E.mneg (x i j)) =
   KX.plus-fn (Ps.Fin n) Top (\ i -> Id E.M (x j i) (E.mneg (x i j))) (\ i -> anti-l i j) (\ t -> anti-r t j) i ;
  diag (i : Ps.Fin (suc n)) : Id E.M (x i i) E.mz =
   KX.plus-fn (Ps.Fin n) Top (\ i -> Id E.M (x i i) E.mz) (\ i -> r.2 i) (\ t -> refl E.mz) i ;
 } ;
 fam2-alt : (n : Nat) (u : (CF.V n).M) -> KV.AltFamily n (fam2 n u) = split {
  zero -> \ u -> (\ i j -> efq i,\ i -> efq i) ;
  suc n | r -> \ u -> (Fam2Alt[n,u,r (\ I -> u (inl I))].anti,Fam2Alt[n,u,r (\ I -> u (inl I))].diag) } ;

 ---------------------------------------------------------------------
 -- alternating families of three indices
 Alt3 (n : Nat) (w : Ps.Fin n -> Ps.Fin n -> Ps.Fin n -> E.M) : U l =
  ((i j k : Ps.Fin n) -> Id E.M (w j i k) (E.mneg (w i j k))) * ((i j k : Ps.Fin n) -> Id E.M (w i k j) (E.mneg (w i j k))) *
  ((i k : Ps.Fin n) -> Id E.M (w i i k) E.mz) * ((i j : Ps.Fin n) -> Id E.M (w i j j) E.mz) ;
 -- module identities
 swap23 (p q s : E.M) : Id E.M (E.madd (E.madd p q) s) (E.madd (E.madd p s) q) =
  trans (sym (E.maddA p q s)) (trans (ap (E.madd p) (E.maddC q s)) (E.maddA p s q)) ;
 negsum (P Q R : E.M) : Id E.M (E.mneg (E.madd (E.madd P (E.mneg Q)) R)) (E.madd (E.madd (E.mneg P) Q) (E.mneg R)) =
  trans (ME.neg-add (E.madd P (E.mneg Q)) R) (ap (\ t -> E.madd t (E.mneg R)) (trans (ME.neg-add P (E.mneg Q)) (ap (E.madd (E.mneg P)) (ME.neg-neg Q)))) ;
 g1 (P Q R : E.M) : Id E.M (E.madd (E.madd Q (E.mneg P)) (E.mneg R)) (E.mneg (E.madd (E.madd P (E.mneg Q)) R)) =
  trans (ap (\ t -> E.madd t (E.mneg R)) (E.maddC Q (E.mneg P))) (sym (negsum P Q R)) ;
 g2 (P Q R : E.M) : Id E.M (E.madd (E.madd (E.mneg P) (E.mneg R)) Q) (E.mneg (E.madd (E.madd P (E.mneg Q)) R)) =
  trans (swap23 (E.mneg P) (E.mneg R) Q) (sym (negsum P Q R)) ;
 module Alt3Of (n : Nat) (a : Ps.Fin n -> R) (x : Ps.Fin n -> Ps.Fin n -> E.M) (ax : KV.AltFamily n x) {
  w (i j k : Ps.Fin n) : E.M = alt3 n a x i j k ;
  a1 (i j k : Ps.Fin n) : Id E.M (w j i k) (E.mneg (w i j k)) =
   trans (ap (E.madd (E.madd (E.sm (a j) (x i k)) (E.mneg (E.sm (a i) (x j k))))) (trans (ap (E.sm (a k)) (ax.1 i j)) (ME.sm-neg (a k) (x i j))))
    (g1 (E.sm (a i) (x j k)) (E.sm (a j) (x i k)) (E.sm (a k) (x i j))) ;
  a2 (i j k : Ps.Fin n) : Id E.M (w i k j) (E.mneg (w i j k)) =
   trans (ap (\ t -> E.madd (E.madd t (E.mneg (E.sm (a k) (x i j)))) (E.sm (a j) (x i k))) (trans (ap (E.sm (a i)) (ax.1 j k)) (ME.sm-neg (a i) (x j k))))
    (g2 (E.sm (a i) (x j k)) (E.sm (a j) (x i k)) (E.sm (a k) (x i j))) ;
  a3 (i k : Ps.Fin n) : Id E.M (w i i k) E.mz =
   trans (ap (E.madd (E.madd (E.sm (a i) (x i k)) (E.mneg (E.sm (a i) (x i k))))) (trans (ap (E.sm (a k)) (ax.2 i)) (ME.sm-zr (a k))))
    (trans (E.maddZ (E.madd (E.sm (a i) (x i k)) (E.mneg (E.sm (a i) (x i k))))) (E.maddN (E.sm (a i) (x i k)))) ;
  a4 (i j : Ps.Fin n) : Id E.M (w i j j) E.mz =
   trans (ap (\ t -> E.madd (E.madd t (E.mneg (E.sm (a j) (x i j)))) (E.sm (a j) (x i j))) (trans (ap (E.sm (a i)) (ax.2 j)) (ME.sm-zr (a i))))
    (trans (ap (\ t -> E.madd t (E.sm (a j) (x i j))) (ME.mzl (E.mneg (E.sm (a j) (x i j)))))
     (trans (E.maddC (E.mneg (E.sm (a j) (x i j))) (E.sm (a j) (x i j))) (E.maddN (E.sm (a j) (x i j))))) ;
  result : Alt3 n w = (a1,a2,a3,a4) ;
 } ;
 -- vec3 of an alternating family vanishes only for 0
 module Vec3Zero (n : Nat) (w : Ps.Fin (suc n) -> Ps.Fin (suc n) -> Ps.Fin (suc n) -> E.M) (aw : Alt3 (suc n) w)
  (r : (i j k : Ps.Fin n) -> Id E.M (w (inl i) (inl j) (inl k)) E.mz) (last : (i j : Ps.Fin n) -> Id E.M (w (inl i) (inl j) (inr tt)) E.mz) {
  tt-eq (t : Top) : Id (Ps.Fin (suc n)) (inr t) (inr tt) = ap (\ s -> inr s) (G1.top-eq t) ;
  zero-at (i j k k' : Ps.Fin (suc n)) (e : Id (Ps.Fin (suc n)) k k') (h : Id E.M (w i j k') E.mz) : Id E.M (w i j k) E.mz =
   trans (ap (w i j) e) h ;
  f-ll (i j : Ps.Fin n) (k : Ps.Fin (suc n)) : Id E.M (w (inl i) (inl j) k) E.mz =
   KX.plus-fn (Ps.Fin n) Top (\ k -> Id E.M (w (inl i) (inl j) k) E.mz) (r i j) (\ t -> zero-at (inl i) (inl j) (inr t) (inr tt) (tt-eq t) (last i j)) k ;
  f-lr (i : Ps.Fin n) (t : Top) (k : Ps.Fin (suc n)) : Id E.M (w (inl i) (inr t) k) E.mz =
   KX.plus-fn (Ps.Fin n) Top (\ k -> Id E.M (w (inl i) (inr t) k) E.mz)
    (\ k -> trans (aw.2.1 (inl i) (inl k) (inr t)) (trans (ap E.mneg (f-ll i k (inr t))) ME.mneg-z))
    (\ t' -> zero-at (inl i) (inr t) (inr t') (inr t) (trans (tt-eq t') (sym (tt-eq t))) (aw.2.2.2 (inl i) (inr t))) k ;
  f-r (t : Top) (j k : Ps.Fin (suc n)) : Id E.M (w (inr t) j k) E.mz =
   trans (aw.1 j (inr t) k) (trans (ap E.mneg (KX.plus-fn (Ps.Fin n) Top (\ j -> Id E.M (w j (inr t) k) E.mz)
     (\ i -> f-lr i t k) (\ t' -> trans (ap (\ s -> w s (inr t) k) (trans (tt-eq t') (sym (tt-eq t)))) (aw.2.2.1 (inr t) k)) j)) ME.mneg-z) ;
  result (i j k : Ps.Fin (suc n)) : Id E.M (w i j k) E.mz =
   KX.plus-fn (Ps.Fin n) Top (\ i -> Id E.M (w i j k) E.mz)
    (\ i -> KX.plus-fn (Ps.Fin n) Top (\ j -> Id E.M (w (inl i) j k) E.mz) (\ j -> f-ll i j k) (\ t -> f-lr i t k) j)
    (\ t -> f-r t j k) i ;
 } ;
 vec3-inv : (n : Nat) (w : Ps.Fin n -> Ps.Fin n -> Ps.Fin n -> E.M) -> Alt3 n w -> ((J : C.Index n) -> Id E.M (vec3 n w J) E.mz) ->
  (i j k : Ps.Fin n) -> Id E.M (w i j k) E.mz = split {
  zero -> \ w aw h i -> efq i ;
  suc n | r -> \ w aw h -> Vec3Zero[n,w,aw,
   r (\ i j k -> w (inl i) (inl j) (inl k))
    (\ i j k -> aw.1 (inl i) (inl j) (inl k),\ i j k -> aw.2.1 (inl i) (inl j) (inl k),\ i k -> aw.2.2.1 (inl i) (inl k),\ i j -> aw.2.2.2 (inl i) (inl j))
    (\ J -> h (inl J)),
   KV.vec2-inv n (\ i j -> w (inl i) (inl j) (inr tt)) (\ i j -> aw.1 (inl i) (inl j) (inr tt),\ i -> aw.2.2.1 (inl i) (inr tt)) (\ J -> h (inr J))].result } ;
} ;
