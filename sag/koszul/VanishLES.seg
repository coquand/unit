-- The long exact sequence of a short exact sequence of complexes
-- 0 -> A -> B -> C -> 0 (i, p), in the vanishing form used by cffr §6.
--
-- (1) at H^k(C) (connecting-map step): H^k(B) = 0 and H^(k+1)(A) = 0
--     give H^k(C) = 0.  em/Snake, at the degrees (k, k+1, k+2): for a
--     cocycle u of C^k, its class delta u lies in H^(k+1)(A), which is
--     trivial, so u = p w for a cocycle w of B^k (Snake.ker-im); w is a
--     coboundary, and p sends coboundaries to coboundaries.
-- (2) at H^k(A) (exactness at H(A)): if z is in A^k, i z is a coboundary
--     and H^(k-1)(C) = 0, then z is a coboundary.  For k = 0: i z = 0, so
--     z = 0 (i injective).  For k = j+1: i z = dB w; p w is a cocycle
--     (dC p w = p dB w = p i z = 0), hence a coboundary, so we can change
--     w, keeping dB w, into some w' with p w' = 0 (adjust: if p w = dC v,
--     lift v to v' and take w' = w - dB v'; if j = 0, p w = 0 already);
--     then w' = i e and i (dA e) = dB (i e) = dB w' = i z, so dA e = z.
-- (3) H^k(B) = 0 and H^(k-1)(C) = 0 give H^k(A) = 0: (2), with i z a
--     cocycle of B^k.
-- In terms of Upto k (H^i = 0 for i < k), by induction on k:
-- cffr Lemma 6.2: Upto A (k+1) and Upto B k give Upto C k, by (1);
-- cffr Lemma 6.3: Upto B (k+1) and Upto C k give Upto A (k+1), by (3);
-- the same with i zero on cohomology (every i z with z a cocycle is a
-- coboundary) instead of Upto B (k+1), by (2) (used for Thm 6.4 and
-- Lemma 6.5).
level l ; open Ring[l] ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Bj = Bijection[l] ; module CG = CechGroups[l] ;
module Over (Rg : A7.CRing) {
 module CO = Complexes[l].Over[Rg] ;
 module SM = CO.SM ;
 module LES (A B C : CO.Complex) (S : CO.SES[A,B,C]) {
  module CA = CO.Cx[A] ; module CB = CO.Cx[B] ; module CC = CO.Cx[C] ;
  module MI = CO.MapL[A,B,S.i] ; module MP = CO.MapL[B,C,S.p] ;

  ---------------------------------------------------------------------
  -- (1) at H^k(C), by em/Snake
  module AtC (k : Nat) (vanB : CB.Vanish k) (vanA : CA.Vanish (suc k)) {
   module IM = SM.Image[A.C k,A.C (suc k),A.d k] ;
   module ZA = CG.Kern[CA.ab (suc k),CA.ab (suc (suc k)),CA.dh (suc k)] ;
   -- the coboundaries of A^(k+1), among its cocycles
   PA (z : ZA.ab.A) : U l = CA.Bnd (suc k) z.1 ;
   module SN = Snake[l].Snake[CA.ab k,CA.ab (suc k),CA.ab (suc (suc k)),CB.ab k,CB.ab (suc k),CB.ab (suc (suc k)),CC.ab k,CC.ab (suc k),
    CA.dh k,CA.dh (suc k),CB.dh k,CB.dh (suc k),CC.dh k,
    MI.hm k,MI.hm (suc k),MI.hm (suc (suc k)),MP.hm k,MP.hm (suc k),
    S.i.sq k,S.i.sq (suc k),S.p.sq k,B.dd k,S.inj (suc k),S.inj (suc (suc k)),
    S.pi k,S.ex k,S.ex (suc k),S.pi (suc k),S.onto k,
    PA,\ z -> CA.bnd-prop (suc k) z.1,IM.sub.zero,\ z z' -> IM.add z.1 z'.1,\ z -> IM.sub.neg z.1,
    \ z h -> h,\ z h -> h] ;
   module HA = SN.HA.QG ;
   -- H^(k+1)(A) = 0: every class is the unit
   trivial (q : HA.grp.G) : Id HA.grp.G q HA.grp.e =
    HA.ind @l (\ q1 -> Id HA.grp.G q1 HA.grp.e) (\ q1 -> HA.grp.setG q1 HA.grp.e)
     (\ z -> HA.cl-rel z ZA.ab.o (vanA (SN.HA.AA.AS.sub z ZA.ab.o).1 (SN.HA.AA.AS.sub z ZA.ab.o).2)) q ;
   vanish : CC.Vanish k = \ u c ->
    TC.rec ((w : SN.ZB.ab.A) * Id SN.ZC.ab.A (SN.pZ w) (u,c)) @l (CC.Bnd k u) (CC.bnd-prop k u)
     (\ w -> substH (CC.Bnd k) (apH (\ t -> t.1) w.2) (MP.bnd k w.1.1 (vanB w.1.1 w.1.2)))
     (SN.ker-im (u,c) (trivial (SN.delta0 (u,c)))) ;
  } ;

  ---------------------------------------------------------------------
  -- (2) at H^k(A)
  -- a w' with p w' = 0 and the same dB
  Adjusted (j : Nat) (w : CB.M j) : U l =
   (w' : CB.M j) * Id (CC.M j) (MP.app j w') (CC.o j) * Id (CB.M (suc j)) (CB.d j w') (CB.d j w) ;
  module Adjust (m : Nat) (w : CB.M (suc m)) (v : Bj.Fibre (CC.d m) (MP.app (suc m) w)) (v' : Bj.Fibre (MP.app m) v.1) {
   module MB = A7.MA[Rg,B.C (suc m)] ; module MB2 = A7.MA[Rg,B.C (suc (suc m))] ; module MC = A7.MA[Rg,C.C (suc m)] ;
   w' : CB.M (suc m) = MB.sub w (CB.d m v'.1) ;
   p-zero : Id (CC.M (suc m)) (MP.app (suc m) w') (CC.o (suc m)) = calc (CC.M (suc m)) {
    MP.app (suc m) w' =< SM.Lin[B.C (suc m),C.C (suc m),S.p.f (suc m)].map-sub w (CB.d m v'.1) >
    MC.sub (MP.app (suc m) w) (MP.app (suc m) (CB.d m v'.1))
     =< apH (MC.sub (MP.app (suc m) w)) (symH (S.p.sq m v'.1)) > MC.sub (MP.app (suc m) w) (CC.d m (MP.app m v'.1))
     =< apH (\ t -> MC.sub (MP.app (suc m) w) (CC.d m t)) v'.2 > MC.sub (MP.app (suc m) w) (CC.d m v.1)
     =< apH (MC.sub (MP.app (suc m) w)) v.2 > MC.sub (MP.app (suc m) w) (MP.app (suc m) w)
     =< MC.sub-self (MP.app (suc m) w) > CC.o (suc m) } ;
   d-same : Id (CB.M (suc (suc m))) (CB.d (suc m) w') (CB.d (suc m) w) = calc (CB.M (suc (suc m))) {
    CB.d (suc m) w' =< SM.Lin[B.C (suc m),B.C (suc (suc m)),B.d (suc m)].map-sub w (CB.d m v'.1) >
    MB2.sub (CB.d (suc m) w) (CB.d (suc m) (CB.d m v'.1))
     =< apH (MB2.sub (CB.d (suc m) w)) (B.dd m v'.1) > MB2.sub (CB.d (suc m) w) (CB.o (suc (suc m)))
     =< apH ((B.C (suc (suc m))).madd (CB.d (suc m) w)) MB2.mneg-z > (B.C (suc (suc m))).madd (CB.d (suc m) w) (CB.o (suc (suc m)))
     =< (B.C (suc (suc m))).maddZ (CB.d (suc m) w) > CB.d (suc m) w } ;
   result : Adjusted (suc m) w = (w',p-zero,d-same) ;
  } ;
  adjust : (j : Nat) (w : CB.M j) -> CC.Bnd j (MP.app j w) -> Tr.Trunc[Adjusted j w].carrier = split {
   zero -> \ w b -> Tr.Trunc[Adjusted zero w].inc (w,b,refl (CB.d zero w)) ;
   suc m -> \ w -> TC.rec (Bj.Fibre (CC.d m) (MP.app (suc m) w)) @l (Tr.Trunc[Adjusted (suc m) w].carrier)
    Tr.Trunc[Adjusted (suc m) w].proposition
    (\ v -> TC.map (Bj.Fibre (MP.app m) v.1) (Adjusted (suc m) w) (\ v' -> Adjust[m,w,v,v'].result) (S.onto m v.1)) } ;
  -- from an adjusted w' for i z = dB w, z = dA e
  module Pull (j : Nat) (z : CA.M (suc j)) (w : Bj.Fibre (CB.d j) (MI.app (suc j) z)) (w' : Adjusted j w.1) (e : Bj.Fibre (MI.app j) w'.1) {
   d-e : Id (CA.M (suc j)) (CA.d j e.1) z = S.inj (suc j) (CA.d j e.1) z (calc (CB.M (suc j)) {
    MI.app (suc j) (CA.d j e.1) =< symH (S.i.sq j e.1) > CB.d j (MI.app j e.1)
     =< apH (CB.d j) e.2 > CB.d j w'.1
     =< w'.2.2 > CB.d j w.1
     =< w.2 > MI.app (suc j) z }) ;
  } ;
  -- p w is a cocycle
  p-cocycle (j : Nat) (z : CA.M (suc j)) (w : Bj.Fibre (CB.d j) (MI.app (suc j) z)) : CC.Cocycle j (MP.app j w.1) =
   transH (S.p.sq j w.1) (transH (apH (MP.app (suc j)) w.2) (S.pi (suc j) z)) ;
  at-a : (k : Nat) (z : CA.M k) -> CB.Bnd k (MI.app k z) -> CC.VanishBelow k -> CA.Bnd k z = split {
   zero -> \ z h t -> S.inj zero z (CA.o zero) (transH h (symH (MI.app-o zero))) ;
   suc j -> \ z h vanC ->
    TC.rec (Bj.Fibre (CB.d j) (MI.app (suc j) z)) @l (CA.Bnd (suc j) z) (CA.bnd-prop (suc j) z) (\ w ->
    TC.rec (Adjusted j w.1) @l (CA.Bnd (suc j) z) (CA.bnd-prop (suc j) z) (\ w' ->
     TC.map (Bj.Fibre (MI.app j) w'.1) (Bj.Fibre (CA.d j) z) (\ e -> (e.1,Pull[j,z,w,w',e].d-e)) (S.ex j w'.1 w'.2.1))
     (adjust j w.1 (vanC (MP.app j w.1) (p-cocycle j z w)))) h } ;

  ---------------------------------------------------------------------
  -- (3) H^k(B) = 0 and H^(k-1)(C) = 0 give H^k(A) = 0
  vanish-a (k : Nat) (vanB : CB.Vanish k) (vanC : CC.VanishBelow k) : CA.Vanish k = \ z c ->
   at-a k z (vanB (MI.app k z) (MI.cocycle k z c)) vanC ;

  ---------------------------------------------------------------------
  -- Lemma 6.2
  lemma62 : (k : Nat) -> CA.Upto (suc k) -> CB.Upto k -> CC.Upto k = split {
   zero -> \ gA gB -> tt ;
   suc k | r -> \ gA gB -> (r gA.1 gB.1,AtC[k,gB.2,gA.2].vanish) } ;
  -- Lemma 6.3
  lemma63 : (k : Nat) -> CB.Upto (suc k) -> CC.Upto k -> CA.Upto (suc k) = split {
   zero -> \ gB gC -> (tt,vanish-a zero gB.2 tt) ;
   suc k | r -> \ gB gC -> (r gB.1 gC.1,vanish-a (suc k) gB.2 gC.2) } ;
  -- i is zero on cohomology
  Zero : U l = (k : Nat) (z : CA.M k) -> CA.Cocycle k z -> CB.Bnd k (MI.app k z) ;
  lemma-zero (iz : Zero) : (k : Nat) -> CC.Upto k -> CA.Upto (suc k) = split {
   zero -> \ gC -> (tt,\ z c -> at-a zero z (iz zero z c) tt) ;
   suc k | r -> \ gC -> (r gC.1,\ z c -> at-a (suc k) z (iz (suc k) z c) gC.2) } ;
 } ;
} ;
