-- The quotient module R/J of a list J, and Lemma 6.5 for x regular mod J
-- with the quotient R/(J, x) (step (A1) of the comparison, CFFR-DESIGN §2).
--
-- R/J is cokernel7's QuotientModule of R by the ideal Generated by J.  For
-- x = sum_i v_i a_i (= vdot v a, lin-vdot) regular mod J,
--   0 -> R/J -x-> R/J -p-> R/(J, x) -> 0
-- is exact: x is (R/J)-regular (x t in J gives t in J); p [t] = [t] is
-- well defined since J is in (J, x); p (x u) = 0; p [t] = 0 means t is in
-- (J, x), i.e. t - x w is in J for some w, so [t] = x [w]; p is onto.
-- Multiplication by x = v . a is zero on H(a; R/J) (Grade.MultZero, up to
-- x = vdot v a), so Gr(a; R/(J, x)) >= k gives Gr(a; R/J) >= k + 1
-- (VanishLES.lemma-zero), which is the half of cffr Lemma 6.5 we need.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Bj = Bijection[l] ;
module RI = RegularIdeal[l] ; module TG = TrueGrade[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module QM = QuotientModule[l].Over[MO.ring] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module L = RL[Rg] ;
 -- sum_i a_i v_i = v . a
 lin-vdot : (n : Nat) (a v : Ps.Fin n -> R) -> Id R (S.lin n a v) (VC.vdot n v a) = split {
  zero -> \ a v -> sym (VC.vdot-zero-def v a) ;
  suc n | r -> \ a v -> sym (trans (VC.vdot-step-def n v a)
   (trans (ap (\ t -> add t (mul (VC.vector-last n v) (VC.vector-last n a)))
     (trans (ap (\ w -> VC.vdot n w (VC.vector-prefix n a)) (F.funext (Ps.Fin n) (\ i -> R) (VC.vector-prefix n v) (\ i -> v (inl i)) (VC.vector-prefix-value n v)))
      (trans (ap (VC.vdot n (\ i -> v (inl i))) (F.funext (Ps.Fin n) (\ i -> R) (VC.vector-prefix n a) (\ i -> a (inl i)) (VC.vector-prefix-value n a)))
       (sym (r (\ i -> a (inl i)) (\ i -> v (inl i)))))))
    (trans (addC (S.lin n (\ i -> a (inl i)) (\ i -> v (inl i))) (mul (VC.vector-last n v) (VC.vector-last n a)))
     (ap (\ t -> add t (S.lin n (\ i -> a (inl i)) (\ i -> v (inl i)))) (trans (trans (ap (\ s -> mul s (VC.vector-last n a)) (VC.vector-last-value n v)) (ap (mul (v (inr tt))) (VC.vector-last-value n a))) (mulC (v (inr tt)) (a (inr tt)))))))) } ;

 ---------------------------------------------------------------------
 -- R/J
 ideal-sub (m : Nat) (J : Ps.Fin m -> R) : Submodules[l].Submodule[MO.ring,MO.regular] =
  new Submodules[l].Submodule[MO.ring,MO.regular,RI.Generated[Rg,m,J].In,RI.Generated[Rg,m,J].in-prop,
   RI.Generated[Rg,m,J].ideal.in-zero,RI.Generated[Rg,m,J].ideal.in-add,
   RI.IdealLaws[Rg,RI.Generated[Rg,m,J].ideal].in-neg,RI.Generated[Rg,m,J].ideal.in-mul] ;
 module QJ (m : Nat) (J : Ps.Fin m -> R) { module Q = QM.Quot[MO.regular,ideal-sub m J] ; } ;
 quot (m : Nat) (J : Ps.Fin m -> R) : MO.Module = QJ[m,J].Q.carrier ;

 ---------------------------------------------------------------------
 module Lemma65J (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a : Ps.Fin n -> R) (c : R) (rc : TG.RegEl (Rg,setR) m J c)
  (v : Ps.Fin n -> R) (ev : Id R (S.lin n a v) c) {
  module Q1 = QJ[m,J].Q ;
  module Q2 = QJ[suc m,TG.extend (Rg,setR) m J c].Q ;
  E : MO.Module = quot m J ;
  E2 : MO.Module = quot (suc m) (TG.extend (Rg,setR) m J c) ;
  module ME = A7.MA[MO.ring,E] ;
  -- c is (R/J)-regular
  RegM (u : Q1.C) : U l = Id Q1.C (Q1.scale c u) (Q1.inc z) -> Id Q1.C u (Q1.inc z) ;
  reg-inc (t : R) : RegM (Q1.inc t) = \ h -> Q1.in-kernel t (rc t tt (Q1.kernel (mul c t) (trans (sym (Q1.Scale[c].D.beta t)) h))) ;
  reg (u : Q1.C) : RegM u = Q1.Ind1 RegM reg-inc
   (\ u -> F.isProp-Pi (Id Q1.C (Q1.scale c u) (Q1.inc z)) (\ h -> Id Q1.C u (Q1.inc z)) (\ h -> Q1.Q.set u (Q1.inc z))) u ;
  inj : Bj.Injective (E.sm c) = \ u u' h -> ME.sub-zero u u' (reg (ME.sub u u')
   (trans (ME.sm-sub c u u') (trans (ap (\ t -> ME.sub t (E.sm c u')) h) (ME.sub-self (E.sm c u'))))) ;
  -- p : R/J -> R/(J, c)
  resp (t t' : R) (r : Q1.rel t t') : Id Q2.C (Q2.inc t) (Q2.inc t') =
   Q2.Q.relates t t' (TrueGradeThm9[l].Kron[(Rg,setR)].gen-inl m (TG.extend (Rg,setR) m J c) (Q1.MP.sub t' t) r) ;
  module PD = Q1.Q.Descend[Q2.C,Q2.Q.set,Q2.inc,resp] ;
  p-add-inc (s t : R) : Id Q2.C (PD.map (Q1.add (Q1.inc s) (Q1.inc t))) (Q2.add (PD.map (Q1.inc s)) (PD.map (Q1.inc t))) = calc Q2.C {
   PD.map (Q1.add (Q1.inc s) (Q1.inc t)) =< ap PD.map (Q1.add-inc s t) > PD.map (Q1.inc (add s t))
    =< PD.beta (add s t) > Q2.inc (add s t)
    =< sym (Q2.add-inc s t) > Q2.add (Q2.inc s) (Q2.inc t)
    =< ap (\ w -> Q2.add w (Q2.inc t)) (sym (PD.beta s)) > Q2.add (PD.map (Q1.inc s)) (Q2.inc t)
    =< ap (Q2.add (PD.map (Q1.inc s))) (sym (PD.beta t)) > Q2.add (PD.map (Q1.inc s)) (PD.map (Q1.inc t)) } ;
  PAdd (u v : Q1.C) : U l = Id Q2.C (PD.map (Q1.add u v)) (Q2.add (PD.map u) (PD.map v)) ;
  p-add (u v : Q1.C) : PAdd u v =
   Q1.Ind1 (\ u -> (v : Q1.C) -> PAdd u v) (\ s v -> Q1.Ind1 (PAdd (Q1.inc s)) (p-add-inc s) (\ v -> Q2.Q.set _ _) v)
    (\ u -> F.isProp-Pi Q1.C (PAdd u) (\ v -> Q2.Q.set _ _)) u v ;
  p-sm-inc (r t : R) : Id Q2.C (PD.map (Q1.scale r (Q1.inc t))) (Q2.scale r (PD.map (Q1.inc t))) = calc Q2.C {
   PD.map (Q1.scale r (Q1.inc t)) =< ap PD.map (Q1.Scale[r].D.beta t) > PD.map (Q1.inc (mul r t))
    =< PD.beta (mul r t) > Q2.inc (mul r t)
    =< sym (Q2.Scale[r].D.beta t) > Q2.scale r (Q2.inc t)
    =< ap (Q2.scale r) (sym (PD.beta t)) > Q2.scale r (PD.map (Q1.inc t)) } ;
  PSm (r : R) (u : Q1.C) : U l = Id Q2.C (PD.map (Q1.scale r u)) (Q2.scale r (PD.map u)) ;
  p-sm (r : R) (u : Q1.C) : PSm r u = Q1.Ind1 (PSm r) (p-sm-inc r) (\ u -> Q2.Q.set _ _) u ;
  p : SM.Linear E E2 = (PD.map,p-add,p-sm) ;
  PiM (u : Q1.C) : U l = Id Q2.C (PD.map (Q1.scale c u)) (Q2.inc z) ;
  in-c (t : R) : RI.Generated[Rg,suc m,TG.extend (Rg,setR) m J c].In (mul c t) =
   subst RI.Generated[Rg,suc m,TG.extend (Rg,setR) m J c].In (mulC t c)
    (RI.Generated[Rg,suc m,TG.extend (Rg,setR) m J c].ideal.in-mul t c (RI.Generated[Rg,suc m,TG.extend (Rg,setR) m J c].generator (inr tt))) ;
  pi-inc (t : R) : PiM (Q1.inc t) = calc Q2.C {
   PD.map (Q1.scale c (Q1.inc t)) =< ap PD.map (Q1.Scale[c].D.beta t) > PD.map (Q1.inc (mul c t))
    =< PD.beta (mul c t) > Q2.inc (mul c t)
    =< Q2.in-kernel (mul c t) (in-c t) > Q2.inc z } ;
  pi (u : Q1.C) : PiM u = Q1.Ind1 PiM pi-inc (\ u -> Q2.Q.set _ _) u ;
  module PL = TrueGradeIdeals[l].Over[Rg,setR].Plus[m,J,c] ;
  ExM (y : Q1.C) : U l = Id Q2.C (PD.map y) (Q2.inc z) -> Tr.Trunc[Bj.Fibre (Q1.scale c) y].carrier ;
  ex-inc (t : R) : ExM (Q1.inc t) = \ h ->
   TC.map ((w : R) * RI.Generated[Rg,m,J].In (add t (neg (mul c w)))) (Bj.Fibre (Q1.scale c) (Q1.inc t))
    (\ w -> (Q1.inc w.1,trans (Q1.Scale[c].D.beta w.1) (Q1.Q.relates (mul c w.1) t w.2)))
    (PL.from t (Q2.kernel t (trans (sym (PD.beta t)) h))) ;
  ex (y : Q1.C) : ExM y = Q1.Ind1 ExM ex-inc
   (\ y -> F.isProp-Pi (Id Q2.C (PD.map y) (Q2.inc z)) (\ h -> Tr.Trunc[Bj.Fibre (Q1.scale c) y].carrier) (\ h -> Tr.Trunc[Bj.Fibre (Q1.scale c) y].proposition)) y ;
  onto (zz : Q2.C) : Tr.Trunc[Bj.Fibre PD.map zz].carrier =
   Q2.Ind1 (\ zz -> Tr.Trunc[Bj.Fibre PD.map zz].carrier) (\ t -> Tr.Trunc[Bj.Fibre PD.map (Q2.inc t)].inc (Q1.inc t,PD.beta t))
    (\ zz -> Tr.Trunc[Bj.Fibre PD.map zz].proposition) zz ;
  module SG = GR.SesGrade[E,E,E2,GR.mult E c,p,inj,pi,ex,onto,n,a] ;
  -- multiplication by c is zero on H(a; R/J)
  ZeroT (y : R) : U l = (k : Nat) (z : SG.L.CA.M k) -> SG.L.CA.Cocycle k z ->
   SG.L.CA.Bnd k (GR.CX.MapL[SG.S.FI.LE.complex,SG.S.FI.LE.complex,GR.KX.Fun[E,E,GR.mult E y,n,a].map].app k z) ;
  zero : SG.L.Zero = subst ZeroT (trans (sym (lin-vdot n a v)) ev) GR.MultZero[E,n,a,v].zero ;
  -- Lemma 6.5, the half used
  back (k : Nat) (g : GR.Gr E2 n a k) : GR.Gr E n a (suc k) = SG.L.lemma-zero zero k g ;
 } ;
} ;
