-- The true grade gives the Koszul grade (step (A1), user's decision
-- 2026-10-25; CFFR-DESIGN §2): Gr(I) >= k mod J (ctete Def. 5) gives
-- Gr(I; R/J) >= k (cffr §6), and for J empty Gr(I; R) >= k.
--
-- Induction on k, for all rings and J.  A witness of Gr(I) >= k + 1 mod J
-- is, after p indeterminates (T = ext p D), a regular sequence c, c_2, ...
-- in I mod J.  The rest is a witness of Gr(I) >= k mod (J, c) over T (no
-- new indeterminates), so by induction Gr(I; T/(J, c)) >= k.  As c is in
-- I, c = v . I for some v, and c is regular mod J, so Lemma 6.5
-- (TrueKoszulQuot.Lemma65J) gives Gr(I; T/J) >= k + 1; descent along
-- D -> ext p D (TrueKoszulDescent.down-p) gives Gr(I; D/J) >= k + 1.
-- For J empty, D is a retract of D/(empty) (the projection and its inverse:
-- a combination of no generators is 0), so Gr(I; D) >= k.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module TG = TrueGrade[l] ; module TKQ = TrueKoszulQuot[l] ; module TKD = TrueKoszulDescent[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

IHtk (k : Nat) : U l+ = (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R) ->
 TG.TGr k D m J n a -> Grade[l].Over[D.1,D.2].Gr (TKQ.Over[D.1,D.2].quot m J) n a k ;
module StepTK (k : Nat) (r : IHtk k) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (a : Ps.Fin n -> D.1.R)
 (w : (p : Nat) * TG.Seq D (suc k) m J n a p) {
 module QT = TKQ.Over[(TG.ext w.1 D).1,(TG.ext w.1 D).2] ;
 -- the rest of the sequence: Gr(I) >= k mod (J, c) over T
 g' : TG.TGr k (TG.ext w.1 D) (suc m) (TG.extend (TG.ext w.1 D) m (TG.img w.1 D m J) (w.2.1 (inr tt))) n (TG.img w.1 D n a) =
  Tr.Trunc[(q : Nat) * TG.Seq (TG.ext w.1 D) k (suc m) (TG.extend (TG.ext w.1 D) m (TG.img w.1 D m J) (w.2.1 (inr tt))) n (TG.img w.1 D n a) q].inc
   (zero,\ i -> w.2.1 (inl i),\ i -> w.2.2.1 (inl i),w.2.2.2.2) ;
 ih : QT.GR.Gr (QT.quot (suc m) (TG.extend (TG.ext w.1 D) m (TG.img w.1 D m J) (w.2.1 (inr tt)))) n (TG.img w.1 D n a) k =
  r (TG.ext w.1 D) (suc m) (TG.extend (TG.ext w.1 D) m (TG.img w.1 D m J) (w.2.1 (inr tt))) n (TG.img w.1 D n a) g' ;
 -- Lemma 6.5 over T
 at-v (v : FiniteIdeal[l].Sums[(TG.ext w.1 D).1].Coordinates n (TG.img w.1 D n a) (w.2.1 (inr tt))) :
  QT.GR.Gr (QT.quot m (TG.img w.1 D m J)) n (TG.img w.1 D n a) (suc k) =
  QT.Lemma65J[m,TG.img w.1 D m J,n,TG.img w.1 D n a,w.2.1 (inr tt),w.2.2.2.1,v.1,v.2].back k ih ;
 gT : QT.GR.Gr (QT.quot m (TG.img w.1 D m J)) n (TG.img w.1 D n a) (suc k) =
  TC.rec (FiniteIdeal[l].Sums[(TG.ext w.1 D).1].Coordinates n (TG.img w.1 D n a) (w.2.1 (inr tt))) @l
   (QT.GR.Gr (QT.quot m (TG.img w.1 D m J)) n (TG.img w.1 D n a) (suc k))
   (QT.GR.CX.Cx[Koszul[l].Over[(TG.ext w.1 D).1,(TG.ext w.1 D).2,QT.quot m (TG.img w.1 D m J)].K[n,TG.img w.1 D n a].complex].upto-prop (suc k))
   at-v (w.2.2.1 (inr tt)) ;
 result : Grade[l].Over[D.1,D.2].Gr (TKQ.Over[D.1,D.2].quot m J) n a (suc k) = TKD.down-p w.1 D m J n a (suc k) gT ;
} ;
-- Gr(I) >= k mod J gives Gr(I; D/J) >= k
true-koszul : (k : Nat) -> IHtk k = split {
 zero -> \ D m J n a g -> tt ;
 suc k | r -> \ D m J n a g -> TC.rec ((p : Nat) * TG.Seq D (suc k) m J n a p) @l (Grade[l].Over[D.1,D.2].Gr (TKQ.Over[D.1,D.2].quot m J) n a (suc k))
  (Grade[l].Over[D.1,D.2].CX.Cx[Koszul[l].Over[D.1,D.2,TKQ.Over[D.1,D.2].quot m J].K[n,a].complex].upto-prop (suc k))
  (\ w -> StepTK[k,r,D,m,J,n,a,w].result) g } ;

---------------------------------------------------------------------
-- J empty: D is a retract of D/(empty)
module Absolute (D : TG.RD) (n : Nat) (a : Ps.Fin n -> D.1.R) {
 module QD = TKQ.Over[D.1,D.2] ;
 J0 : Ps.Fin zero -> D.1.R = \ i -> efq i ;
 module Q = QD.QJ[zero,J0].Q ;
 R0 : QD.MO.Module = QD.MO.regular ;
 E0 : QD.MO.Module = QD.quot zero J0 ;
 module MR = Alg73[l].MA[QD.MO.ring,R0] ;
 -- a combination of no generators is 0
 resp (t t' : D.1.R) (h : Q.rel t t') : Id D.1.R t t' =
  sym (MR.sub-zero t' t (TC.rec (FiniteIdeal[l].Sums[D.1].Coordinates zero J0 (MR.sub t' t)) @l (Id D.1.R (MR.sub t' t) D.1.z) (D.2 (MR.sub t' t) D.1.z)
   (\ v -> sym v.2) h)) ;
 module BK = Q.Q.Descend[D.1.R,D.2,\ t -> t,resp] ;
 back-add (u v : E0.M) : Id D.1.R (BK.map (Q.add u v)) (D.1.add (BK.map u) (BK.map v)) =
  Q.Ind1 (\ u -> (v : E0.M) -> Id D.1.R (BK.map (Q.add u v)) (D.1.add (BK.map u) (BK.map v)))
   (\ s v -> Q.Ind1 (\ v -> Id D.1.R (BK.map (Q.add (Q.inc s) v)) (D.1.add (BK.map (Q.inc s)) (BK.map v)))
     (\ t -> trans (ap BK.map (Q.add-inc s t)) (trans (BK.beta (D.1.add s t))
      (trans (ap (\ x -> D.1.add x t) (sym (BK.beta s))) (ap (D.1.add (BK.map (Q.inc s))) (sym (BK.beta t))))))
     (\ v -> D.2 _ _) v)
   (\ u -> F.isProp-Pi E0.M (\ v -> Id D.1.R (BK.map (Q.add u v)) (D.1.add (BK.map u) (BK.map v))) (\ v -> D.2 _ _)) u v ;
 back-sm (r : D.1.R) (u : E0.M) : Id D.1.R (BK.map (Q.scale r u)) (D.1.mul r (BK.map u)) =
  Q.Ind1 (\ u -> Id D.1.R (BK.map (Q.scale r u)) (D.1.mul r (BK.map u)))
   (\ t -> trans (ap BK.map (Q.Scale[r].D.beta t)) (trans (BK.beta (D.1.mul r t)) (ap (D.1.mul r) (sym (BK.beta t)))))
   (\ u -> D.2 _ _) u ;
 back : QD.SM.Linear E0 R0 = (BK.map,back-add,back-sm) ;
 module FS = QD.GR.KX.Fun[R0,E0,Q.projection,n,a] ;
 module FB = QD.GR.KX.Fun[E0,R0,back,n,a] ;
 module RT = Products[l].Over[D.1,D.2].Retract[FS.LE.complex,FS.LF.complex,FS.map,FB.map,
  \ k x -> FS.KE.Deg[n,k].S.eq (FB.dmap k (FS.dmap k x)) x (FS.KE.CF.veq n (FB.vmap n (FS.vmap n x.1)) x.1 (\ I -> BK.beta (x.1 I)))] ;
 -- Gr(I) >= k (true grade) gives Gr(I; D) >= k (Koszul grade)
 result (k : Nat) (g : TG.TGr k D zero J0 n a) : QD.GR.Gr R0 n a k = RT.upto k (true-koszul k D zero J0 n a g) ;
} ;
