-- Cochain complexes of modules over a commutative ring (cffr §4, §6.1).
--
-- A complex is a family of modules C k (k : Nat) with linear maps
-- d k : C k -> C (k+1) such that d (k+1) (d k x) = 0.  A cocycle of degree
-- k is an x with d k x = 0.  The coboundaries of degree k+1 are the
-- elements merely of the form d k y; in degree 0 the only coboundary is 0
-- (the complex starts at 0).  "H^k = 0" is the proposition Vanish k:
-- every cocycle of degree k is a coboundary; cohomology groups are never
-- formed (cffr only uses them through "= 0").
--
-- A map of complexes is a family of linear maps commuting with d; it
-- sends cocycles to cocycles and coboundaries to coboundaries.  A short
-- exact sequence of complexes 0 -> A -> B -> C -> 0 is a pair of maps
-- i, p, injective i, p i = 0, ker p in im i, p onto (merely), in each
-- degree.
--
-- Modules are abelian groups (AbOf) and linear maps are homomorphisms
-- (hom), so that em/Snake applies to complexes of modules.
level l ; open Ring[l] ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module To = Torsor[l] ; module Bj = Bijection[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : A7.CRing) {
 module SM = Submodules[l].Over[Rg] ;

 -- a module as an abelian group, a linear map as a homomorphism
 module AbOf (P : SM.Module) {
  ab : To.Ab = new To.Ab[P.M,P.setM,P.mz,P.madd,P.mneg,\ x y w -> symH (P.maddA x y w),P.maddC,P.maddZ,P.maddN] ;
 } ;
 hom (P Q : SM.Module) (f : SM.Linear P Q) : EMMaps[l].Hom AbOf[P].ab AbOf[Q].ab = (f.1,f.2.1) ;

 record Complex {
  C : Nat -> SM.Module ;
  d (k : Nat) : SM.Linear (C k) (C (suc k)) ;
  dd (k : Nat) (x : (C k).M) : Id (C (suc (suc k))).M ((d (suc k)).1 ((d k).1 x)) (C (suc (suc k))).mz ;
 } ;

 module Cx (K : Complex) {
  -- accessors
  M (k : Nat) : U l = (K.C k).M ;
  o (k : Nat) : M k = (K.C k).mz ;
  d (k : Nat) (x : M k) : M (suc k) = (K.d k).1 x ;
  Cocycle (k : Nat) (x : M k) : U l = Id (M (suc k)) (d k x) (o (suc k)) ;
  -- coboundaries; in degree 0 only 0
  Bnd : (k : Nat) -> M k -> U l = split {
   zero -> \ x -> Id (M zero) x (o zero) ;
   suc k -> \ x -> Tr.Trunc[Bj.Fibre (d k) x].carrier } ;
  bnd-prop : (k : Nat) (x : M k) -> isProp (Bnd k x) = split {
   zero -> \ x -> (K.C zero).setM x (o zero) ;
   suc k -> \ x -> Tr.Trunc[Bj.Fibre (d k) x].proposition } ;
  -- coboundaries are closed under 0 and +
  bnd-zero : (k : Nat) -> Bnd k (o k) = split {
   zero -> refl (o zero) ;
   suc k -> SM.Image[K.C k,K.C (suc k),K.d k].sub.zero } ;
  bnd-add : (k : Nat) (x y : M k) -> Bnd k x -> Bnd k y -> Bnd k ((K.C k).madd x y) = split {
   zero -> \ x y bx by -> transH (apH (\ t -> (K.C zero).madd t y) bx) (transH (apH ((K.C zero).madd (o zero)) by) ((K.C zero).maddZ (o zero))) ;
   suc k -> \ x y -> SM.Image[K.C k,K.C (suc k),K.d k].add x y } ;
  -- H^k = 0
  Vanish (k : Nat) : U l = (x : M k) -> Cocycle k x -> Bnd k x ;
  -- H^(k-1) = 0, vacuous for k = 0
  VanishBelow : Nat -> U l = split { zero -> Top ; suc j -> Vanish j } ;
  -- H^i = 0 for i < k
  Upto : Nat -> U l = split { zero -> Top ; suc k | r -> r * Vanish k } ;
  -- both are propositions
  vanish-prop (k : Nat) : isProp (Vanish k) = F.isProp-Pi (M k) (\ x -> Cocycle k x -> Bnd k x)
   (\ x -> F.isProp-Pi (Cocycle k x) (\ c -> Bnd k x) (\ c -> bnd-prop k x)) ;
  top-prop : isProp Top = split { tt -> split { tt -> refl tt } } ;
  upto-prop : (k : Nat) -> isProp (Upto k) = split {
   zero -> top-prop ;
   suc k | r -> \ u v -> Sigma-eq (Upto k) (\ w -> Vanish k) u.1 v.1 u.2 v.2 (r u.1 v.1) (vanish-prop k) } ;
  -- as abelian groups
  ab (k : Nat) : To.Ab = AbOf[K.C k].ab ;
  dh (k : Nat) : EMMaps[l].Hom (ab k) (ab (suc k)) = hom (K.C k) (K.C (suc k)) (K.d k) ;
 } ;

 record Map (A B : Complex) {
  f (k : Nat) : SM.Linear (A.C k) (B.C k) ;
  sq (k : Nat) (x : (A.C k).M) : Id (B.C (suc k)).M ((B.d k).1 ((f k).1 x)) ((f (suc k)).1 ((A.d k).1 x)) ;
 } ;

 module MapL (A B : Complex) (h : Map[A,B]) {
  module CA = Cx[A] ; module CB = Cx[B] ;
  app (k : Nat) (x : CA.M k) : CB.M k = (h.f k).1 x ;
  hm (k : Nat) : EMMaps[l].Hom (CA.ab k) (CB.ab k) = hom (A.C k) (B.C k) (h.f k) ;
  app-o (k : Nat) : Id (CB.M k) (app k (CA.o k)) (CB.o k) = SM.Lin[A.C k,B.C k,h.f k].map-z ;
  cocycle (k : Nat) (x : CA.M k) (c : CA.Cocycle k x) : CB.Cocycle k (app k x) =
   transH (h.sq k x) (transH (apH (app (suc k)) c) (app-o (suc k))) ;
  bnd : (k : Nat) (x : CA.M k) -> CA.Bnd k x -> CB.Bnd k (app k x) = split {
   zero -> \ x b -> transH (apH (app zero) b) (app-o zero) ;
   suc k -> \ x -> TC.map (Bj.Fibre (CA.d k) x) (Bj.Fibre (CB.d k) (app (suc k) x))
    (\ w -> (app k w.1,transH (h.sq k w.1) (apH (app (suc k)) w.2))) } ;
 } ;

 record SES (A B C : Complex) {
  i : Map[A,B] ;
  p : Map[B,C] ;
  inj (k : Nat) : Bj.Injective (i.f k).1 ;
  pi (k : Nat) (x : (A.C k).M) : Id (C.C k).M ((p.f k).1 ((i.f k).1 x)) (C.C k).mz ;
  ex (k : Nat) (y : (B.C k).M) : Id (C.C k).M ((p.f k).1 y) (C.C k).mz -> Tr.Trunc[Bj.Fibre (i.f k).1 y].carrier ;
  onto (k : Nat) (z : (C.C k).M) : Tr.Trunc[Bj.Fibre (p.f k).1 z].carrier ;
 } ;
} ;
