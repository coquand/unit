-- cffr Theorem 7.1 (Auslander-Buchsbaum-Hochster, first half), in the
-- layout of cffr/Resolution (top map first):
--   R^p -u-> R^(s 0) -T 0-> R^(s 1) -> ... -T (K-1)-> R^(s K),
-- u injective, composites 0 and exact at R^(s 0), ..., R^(s (K-1))
-- (Resolution.Pairs).  It is a finite free resolution of length K + 1 of
-- E = R^(s K) / im T (K-1) (of R^(s 0) / im u when K = 0).
--
-- The cokernels Q_0 = R^(s 0) / im u, Q_(i+1) = R^(s (i+1)) / im T i fit in
--   0 -> R^p -u-> R^(s 0) -> Q_0 -> 0 ,
--   0 -> Q_i -> R^(s (i+1)) -> Q_(i+1) -> 0 ,
-- the map Q_i -> R^(s (i+1)) being induced by T i (it kills im of the
-- previous map) and injective by exactness at R^(s i).
-- Theorem 7.1: Gr(a) >= t + i + 1 gives Gr(a; Q_i) >= t.  Induction on i:
-- for i = 0, Theorem 6.4 (1); for i + 1, Gr(a; Q_i) >= t + 1 by induction,
-- Gr(a; R^(s (i+1))) >= t, and Lemma 6.2.  With i = K: Gr(a) >= t + K + 1
-- gives Gr(a; E) >= t; for t = 1, a_j x in im T (K-1) for all j gives x in
-- im T (K-1) (item 1).
-- Corollary 7.4 (Rees): Gr(a) >= K + 2 and a E = 0 give E = 0 (Gr(a; E) >= 1).
-- Theorem 7.2: if moreover p > 0 and u has its coefficients in (a), then
-- Gr(a; E) >= k gives Gr(a) >= k + K + 1.  Induction on K, removing the
-- bottom of the resolution.  K = 0 is Theorem 6.4 (2).  For K + 1, with
-- 0 -> Q_K -> R^(s (K+1)) -> Q_(K+1) -> 0: if Gr(a) >= t + 1 for some
-- t <= k, then Gr(a; Q_K) >= t + 1 (Lemma 6.3), so Gr(a) >= t + 1 + K + 1
-- >= t + 2 by induction; starting from Gr(a) >= 1 (induction with k = 0)
-- this reaches Gr(a) >= k + 1, then Gr(a; Q_K) >= k + 1 and Gr(a) >=
-- k + 1 + K + 1.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Bj = Bijection[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module QM = QuotientModule[l].Over[MO.ring] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module PR = Products[l].Over[Rg,setR] ;
 module T64 = Thm64[l].Over[Rg,setR] ;
 module MX = Matrices[l].Over[Rg] ;
 module RS = Resolution[l] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 -- Gr(a; X) >= j + t gives Gr(a; X) >= t
 down (X : MO.Module) (N : Nat) (a : Ps.Fin N -> R) : (j t : Nat) -> GR.Gr X N a (plus j t) -> GR.Gr X N a t = split {
  zero -> \ t g -> g ;
  suc j | r -> \ t g -> r t g.1 } ;
 -- the cokernel of a matrix
 module Coker (p q : Nat) (u : MX.Mat p q) {
  module IM = SM.Image[PR.Pow T64.reg p,PR.Pow T64.reg q,T64.lin-of p q u] ;
  module Q = QM.Quot[PR.Pow T64.reg q,IM.sub] ;
  C : MO.Module = Q.carrier ;
 } ;

 -- the map before R^(s i)
 pdim (p : Nat) (s : Nat -> Nat) : Nat -> Nat = split { zero -> p ; suc i -> s i } ;
 pmap (p : Nat) (s : Nat -> Nat) (u : MX.Mat p (s zero)) (T : (i : Nat) -> MX.Mat (s i) (s (suc i))) : (i : Nat) -> MX.Mat (pdim p s i) (s i) = split {
  zero -> u ; suc i -> T i } ;
 module Chain (K p : Nat) (s : Nat -> Nat) (u : MX.Mat p (s zero)) (T : (i : Nat) -> MX.Mat (s i) (s (suc i)))
  (hu : MX.Injective p (s zero) u) (pairs : RS.Pairs (Rg,setR) K p s u T) (N : Nat) (a : Ps.Fin N -> R) {
  pd (i : Nat) : Nat = pdim p s i ;
  prev (i : Nat) : MX.Mat (pd i) (s i) = pmap p s u T i ;
  Q (i : Nat) : MO.Module = Coker[pd i,s i,prev i].C ;
  -- exactness at R^(s i), for i < K
  at : (i d : Nat) -> Id Nat K (plus (suc i) d) ->
   MX.ComposeZero (pd i) (s i) (s (suc i)) (prev i) (T i) * MX.Exact (pd i) (s i) (s (suc i)) (prev i) (T i) = split {
   zero -> \ d e -> pairs.1 d e ;
   suc i -> \ d e -> pairs.2 i d e } ;
  -- 0 -> R^p -> R^(s 0) -> Q_0 -> 0
  module K0 = Coker[p,s zero,u] ;
  module S0 = T64.Thm64[p,s zero,N,a,u,hu,K0.C,K0.Q.projection,
   \ x -> K0.Q.in-kernel (MX.apply p (s zero) u x) (Tr.Trunc[K0.IM.Fib (MX.apply p (s zero) u x)].inc (x,refl (MX.apply p (s zero) u x))),
   \ y h -> K0.Q.kernel y h,K0.Q.surjective] ;
  -- 0 -> Q_i -> R^(s (i+1)) -> Q_(i+1) -> 0
  module Step (i : Nat) (cz : MX.ComposeZero (pd i) (s i) (s (suc i)) (prev i) (T i)) (ex : MX.Exact (pd i) (s i) (s (suc i)) (prev i) (T i)) {
   module KA = Coker[pd i,s i,prev i] ;
   module KB = Coker[s i,s (suc i),T i] ;
   module LT = SM.Lin[PR.Pow T64.reg (s i),PR.Pow T64.reg (s (suc i)),T64.lin-of (s i) (s (suc i)) (T i)] ;
   module LP = SM.Lin[PR.Pow T64.reg (pd i),PR.Pow T64.reg (s i),T64.lin-of (pd i) (s i) (prev i)] ;
   module MB = A7.MA[MO.ring,PR.Pow T64.reg (s (suc i))] ;
   tb (y : (PR.Pow T64.reg (s i)).M) : (PR.Pow T64.reg (s (suc i))).M = MX.apply (s i) (s (suc i)) (T i) y ;
   -- T i kills im (prev i)
   kills (y : (PR.Pow T64.reg (s i)).M) (w : Bj.Fibre (MX.apply (pd i) (s i) (prev i)) y) : Id (PR.Pow T64.reg (s (suc i))).M (tb y) (PR.Pow T64.reg (s (suc i))).mz =
    F.funext (Ps.Fin (s (suc i))) (\ j -> R) (tb y) (\ j -> z) (\ j ->
     trans (ap (\ v -> MX.apply (s i) (s (suc i)) (T i) v j) (sym w.2)) (MX.compose-zero (pd i) (s i) (s (suc i)) (prev i) (T i) cz w.1 j)) ;
   resp (y y' : (PR.Pow T64.reg (s i)).M) (r : KA.Q.rel y y') : Id (PR.Pow T64.reg (s (suc i))).M (tb y) (tb y') =
    TC.rec (Bj.Fibre (MX.apply (pd i) (s i) (prev i)) (KA.Q.MP.sub y' y)) @l (Id (PR.Pow T64.reg (s (suc i))).M (tb y) (tb y')) ((PR.Pow T64.reg (s (suc i))).setM (tb y) (tb y'))
     (\ w -> sym (MB.sub-zero (tb y') (tb y) (trans (sym (LT.map-sub y' y)) (kills (KA.Q.MP.sub y' y) w)))) r ;
   module IO = KA.Q.Q.Descend[(PR.Pow T64.reg (s (suc i))).M,(PR.Pow T64.reg (s (suc i))).setM,tb,resp] ;
   IAdd (q q' : KA.Q.C) : U l = Id (PR.Pow T64.reg (s (suc i))).M (IO.map (KA.Q.add q q')) ((PR.Pow T64.reg (s (suc i))).madd (IO.map q) (IO.map q')) ;
   iota-add-inc (y y' : (PR.Pow T64.reg (s i)).M) : IAdd (KA.Q.inc y) (KA.Q.inc y') = calc (PR.Pow T64.reg (s (suc i))).M {
    IO.map (KA.Q.add (KA.Q.inc y) (KA.Q.inc y')) =< ap IO.map (KA.Q.add-inc y y') > IO.map (KA.Q.inc ((PR.Pow T64.reg (s i)).madd y y'))
     =< IO.beta ((PR.Pow T64.reg (s i)).madd y y') > tb ((PR.Pow T64.reg (s i)).madd y y')
     =< (T64.lin-of (s i) (s (suc i)) (T i)).2.1 y y' > (PR.Pow T64.reg (s (suc i))).madd (tb y) (tb y')
     =< ap (\ v -> (PR.Pow T64.reg (s (suc i))).madd v (tb y')) (sym (IO.beta y)) > (PR.Pow T64.reg (s (suc i))).madd (IO.map (KA.Q.inc y)) (tb y')
     =< ap ((PR.Pow T64.reg (s (suc i))).madd (IO.map (KA.Q.inc y))) (sym (IO.beta y')) > (PR.Pow T64.reg (s (suc i))).madd (IO.map (KA.Q.inc y)) (IO.map (KA.Q.inc y')) } ;
   iota-add (q q' : KA.Q.C) : IAdd q q' =
    KA.Q.Ind1 (\ q -> (q' : KA.Q.C) -> IAdd q q') (\ y q' -> KA.Q.Ind1 (IAdd (KA.Q.inc y)) (iota-add-inc y) (\ q' -> (PR.Pow T64.reg (s (suc i))).setM _ _) q')
     (\ q -> F.isProp-Pi KA.Q.C (IAdd q) (\ q' -> (PR.Pow T64.reg (s (suc i))).setM _ _)) q q' ;
   ISm (c : R) (q : KA.Q.C) : U l = Id (PR.Pow T64.reg (s (suc i))).M (IO.map (KA.Q.scale c q)) ((PR.Pow T64.reg (s (suc i))).sm c (IO.map q)) ;
   iota-sm-inc (c : R) (y : (PR.Pow T64.reg (s i)).M) : ISm c (KA.Q.inc y) = calc (PR.Pow T64.reg (s (suc i))).M {
    IO.map (KA.Q.scale c (KA.Q.inc y)) =< ap IO.map (KA.Q.Scale[c].D.beta y) > IO.map (KA.Q.inc ((PR.Pow T64.reg (s i)).sm c y))
     =< IO.beta ((PR.Pow T64.reg (s i)).sm c y) > tb ((PR.Pow T64.reg (s i)).sm c y)
     =< (T64.lin-of (s i) (s (suc i)) (T i)).2.2 c y > (PR.Pow T64.reg (s (suc i))).sm c (tb y)
     =< ap ((PR.Pow T64.reg (s (suc i))).sm c) (sym (IO.beta y)) > (PR.Pow T64.reg (s (suc i))).sm c (IO.map (KA.Q.inc y)) } ;
   iota-sm (c : R) (q : KA.Q.C) : ISm c q = KA.Q.Ind1 (ISm c) (iota-sm-inc c) (\ q -> (PR.Pow T64.reg (s (suc i))).setM _ _) q ;
   iota : SM.Linear KA.C (PR.Pow T64.reg (s (suc i))) = (IO.map,iota-add,iota-sm) ;
   -- iota is injective: exactness at R^(s i)
   ZeroM (q : KA.Q.C) : U l = Id (PR.Pow T64.reg (s (suc i))).M (IO.map q) (PR.Pow T64.reg (s (suc i))).mz -> Id KA.Q.C q (KA.Q.inc (PR.Pow T64.reg (s i)).mz) ;
   zero-inc (y : (PR.Pow T64.reg (s i)).M) : ZeroM (KA.Q.inc y) = \ h ->
    KA.Q.in-kernel y (TC.map ((x : (PR.Pow T64.reg (pd i)).M) * ((j : Ps.Fin (s i)) -> Id R (MX.apply (pd i) (s i) (prev i) x j) (y j))) (KA.IM.Fib y)
     (\ w -> (w.1,F.funext (Ps.Fin (s i)) (\ j -> R) (MX.apply (pd i) (s i) (prev i) w.1) y w.2))
     (ex y (\ j -> ap (\ v -> v j) (trans (sym (IO.beta y)) h)))) ;
   zero-of (q : KA.Q.C) : ZeroM q = KA.Q.Ind1 ZeroM zero-inc
    (\ q -> F.isProp-Pi (Id (PR.Pow T64.reg (s (suc i))).M (IO.map q) (PR.Pow T64.reg (s (suc i))).mz) (\ h -> Id KA.Q.C q (KA.Q.inc (PR.Pow T64.reg (s i)).mz)) (\ h -> KA.Q.Q.set _ _)) q ;
   module MA = A7.MA[MO.ring,KA.C] ;
   inj : Bj.Injective IO.map = \ q q' h -> MA.sub-zero q q' (zero-of (MA.sub q q')
    (trans (SM.Lin[KA.C,PR.Pow T64.reg (s (suc i)),iota].map-sub q q') (trans (ap (\ v -> MB.sub v (IO.map q')) h) (MB.sub-self (IO.map q'))))) ;
   PiM (q : KA.Q.C) : U l = Id KB.Q.C (KB.Q.inc (IO.map q)) (KB.Q.inc (PR.Pow T64.reg (s (suc i))).mz) ;
   pi (q : KA.Q.C) : PiM q = KA.Q.Ind1 PiM
    (\ y -> trans (ap KB.Q.inc (IO.beta y)) (KB.Q.in-kernel (tb y) (Tr.Trunc[KB.IM.Fib (tb y)].inc (y,refl (tb y)))))
    (\ q -> KB.Q.Q.set _ _) q ;
   exs (v : (PR.Pow T64.reg (s (suc i))).M) (h : Id KB.Q.C (KB.Q.inc v) (KB.Q.inc (PR.Pow T64.reg (s (suc i))).mz)) : Tr.Trunc[Bj.Fibre IO.map v].carrier =
    TC.map (KB.IM.Fib v) (Bj.Fibre IO.map v) (\ w -> (KA.Q.inc w.1,trans (IO.beta w.1) w.2)) (KB.Q.kernel v h) ;
   module SG = GR.SesGrade[KA.C,PR.Pow T64.reg (s (suc i)),KB.C,iota,KB.Q.projection,inj,pi,exs,KB.Q.surjective,N,a] ;
  } ;
  -- Theorem 7.1 along the chain
  C71 (i : Nat) : U l = (d : Nat) -> Id Nat K (plus i d) -> (t : Nat) -> GR.Gr T64.reg N a (suc (plus i t)) -> GR.Gr (Q i) N a t ;
  chain : (i : Nat) -> C71 i = split {
   zero -> \ d e t g -> S0.part1 t g ;
   suc i | r -> \ d e t g -> Step[i,(at i d e).1,(at i d e).2].SG.lemma62 t
    (r (suc d) (trans e (sym (plus-suc i d))) (suc t) (subst (\ m -> GR.Gr T64.reg N a (suc m)) (sym (plus-suc i t)) g))
    (PR.Power[T64.reg,s (suc i),N,a].power-upto t (down T64.reg N a (suc (suc i)) t g)) } ;
  -- Theorem 7.1: Gr(a) >= t + K + 1 gives Gr(a; E) >= t, E = Q_K
  thm71 (t : Nat) (g : GR.Gr T64.reg N a (suc (plus K t))) : GR.Gr (Q K) N a t = chain K zero (sym (plus-zero K)) t g ;
  -- t = 1, elementwise: a_j x in im (prev K) for all j gives x in im (prev K)
  module Elem (g : GR.Gr T64.reg N a (suc (plus K (suc zero)))) (x : (PR.Pow T64.reg (s K)).M)
   (h : (j : Ps.Fin N) -> Tr.Trunc[Bj.Fibre (MX.apply (pd K) (s K) (prev K)) ((PR.Pow T64.reg (s K)).sm (a j) x)].carrier) {
   module KQ = Coker[pd K,s K,prev K] ;
   zero-cls : Id KQ.Q.C (KQ.Q.inc x) (KQ.Q.inc (PR.Pow T64.reg (s K)).mz) =
    GradeOne[l].Over[Rg,setR].Item1[Q K,N,a].forward (thm71 (suc zero) g) (KQ.Q.inc x) tt
     (\ j -> trans (KQ.Q.Scale[a j].D.beta x) (KQ.Q.in-kernel ((PR.Pow T64.reg (s K)).sm (a j) x) (h j))) ;
   result : Tr.Trunc[Bj.Fibre (MX.apply (pd K) (s K) (prev K)) x].carrier = KQ.Q.kernel x zero-cls ;
  } ;
   -- Corollary 7.4 (Rees)
  rees (g : GR.Gr T64.reg N a (suc (plus K (suc zero))))
   (ann : (j : Ps.Fin N) (e : (Q K).M) -> Id (Q K).M ((Q K).sm (a j) e) (Q K).mz) (e : (Q K).M) : Id (Q K).M e (Q K).mz =
   GradeOne[l].Over[Rg,setR].Item1[Q K,N,a].forward (thm71 (suc zero) g) e tt (\ j -> ann j e) ;
 } ;

 ---------------------------------------------------------------------
 -- Theorem 7.2
 -- the pairs of a longer resolution restrict
 restrict (K p : Nat) (s : Nat -> Nat) (u : MX.Mat p (s zero)) (T : (i : Nat) -> MX.Mat (s i) (s (suc i)))
  (pairs : RS.Pairs (Rg,setR) (suc K) p s u T) : RS.Pairs (Rg,setR) K p s u T =
  (\ d e -> pairs.1 (suc d) (ap (\ t -> suc t) e),
   \ i d e -> pairs.2 i (suc d) (trans (ap (\ t -> suc t) e) (sym (plus-suc (suc (suc i)) d)))) ;
 module T72 (p' N : Nat) (a : Ps.Fin N -> R) {
  p : Nat = suc p' ;
  Claim (K : Nat) : U l = (s : Nat -> Nat) (u : MX.Mat p (s zero)) (T : (i : Nat) -> MX.Mat (s i) (s (suc i)))
   (hu : MX.Injective p (s zero) u) (pairs : RS.Pairs (Rg,setR) K p s u T)
   (B : Ps.Fin p -> Ps.Fin (s zero) -> AL.Vec N) (hB : (i : Ps.Fin p) (r : Ps.Fin (s zero)) -> Id R (VC.vdot N (B i r) a) (u i r)) (k : Nat) ->
   GR.Gr (Chain[K,p,s,u,T,hu,pairs,N,a].Q K) N a k -> GR.Gr T64.reg N a (suc (plus K k)) ;
  base (s : Nat -> Nat) (u : MX.Mat p (s zero)) (T : (i : Nat) -> MX.Mat (s i) (s (suc i))) (hu : MX.Injective p (s zero) u)
   (pairs : RS.Pairs (Rg,setR) zero p s u T) (B : Ps.Fin p -> Ps.Fin (s zero) -> AL.Vec N)
   (hB : (i : Ps.Fin p) (r : Ps.Fin (s zero)) -> Id R (VC.vdot N (B i r) a) (u i r)) (k : Nat)
   (g : GR.Gr (Chain[zero,p,s,u,T,hu,pairs,N,a].Q zero) N a k) : GR.Gr T64.reg N a (suc k) =
   T64.Part2[p',s zero,N,a,u,hu,Chain[zero,p,s,u,T,hu,pairs,N,a].K0.C,Chain[zero,p,s,u,T,hu,pairs,N,a].K0.Q.projection,
    Chain[zero,p,s,u,T,hu,pairs,N,a].S0.pi,Chain[zero,p,s,u,T,hu,pairs,N,a].S0.ex,Chain[zero,p,s,u,T,hu,pairs,N,a].S0.onto,B,hB].part2 k g ;
  module Step (K : Nat) (ih : Claim K) (s : Nat -> Nat) (u : MX.Mat p (s zero)) (T : (i : Nat) -> MX.Mat (s i) (s (suc i)))
   (hu : MX.Injective p (s zero) u) (pairs : RS.Pairs (Rg,setR) (suc K) p s u T)
   (B : Ps.Fin p -> Ps.Fin (s zero) -> AL.Vec N) (hB : (i : Ps.Fin p) (r : Ps.Fin (s zero)) -> Id R (VC.vdot N (B i r) a) (u i r)) (k : Nat)
   (g : GR.Gr (Chain[suc K,p,s,u,T,hu,pairs,N,a].Q (suc K)) N a k) {
   module CH = Chain[suc K,p,s,u,T,hu,pairs,N,a] ;
   pairs' : RS.Pairs (Rg,setR) K p s u T = restrict K p s u T pairs ;
   module SS = CH.Step[K,(CH.at K zero (sym (plus-zero (suc K)))).1,(CH.at K zero (sym (plus-zero (suc K)))).2] ;
   -- Gr(a) >= t + 1 gives Gr(a; Q_K) >= t + 1, when Gr(a; Q_(K+1)) >= t
   up-q (t : Nat) (ga : GR.Gr T64.reg N a (suc t)) (gq : GR.Gr (CH.Q (suc K)) N a t) : GR.Gr (CH.Q K) N a (suc t) =
    SS.SG.lemma63 t (PR.Power[T64.reg,s (suc K),N,a].power-upto (suc t) ga) gq ;
   -- the induction hypothesis on Q_K
   use (t : Nat) (gq : GR.Gr (CH.Q K) N a t) : GR.Gr T64.reg N a (suc (plus K t)) = ih s u T hu pairs' B hB t gq ;
   -- Gr(a) >= t + 1 for every t <= k (k = d + t)
   rises : (t d : Nat) -> Id Nat k (plus d t) -> GR.Gr T64.reg N a (suc t) = split {
    zero -> \ d e -> down T64.reg N a K (suc zero) (subst {Nat} (\ m -> GR.Gr T64.reg N a m) (sym (plus-suc K zero)) (use zero tt)) ;
    suc t | r -> \ d e -> down T64.reg N a K (suc (suc t))
     (subst {Nat} (\ m -> GR.Gr T64.reg N a m) (sym (plus-suc K (suc t)))
      (use (suc t) (up-q t (r (suc d) (trans e (plus-suc d t)))
       (down (CH.Q (suc K)) N a (suc d) t (subst {Nat} (\ m -> GR.Gr (CH.Q (suc K)) N a m) (trans e (plus-suc d t)) g))))) } ;
   result : GR.Gr T64.reg N a (suc (plus (suc K) k)) =
    subst {Nat} (\ m -> GR.Gr T64.reg N a (suc m)) (plus-suc K k) (use (suc k) (up-q k (rises k zero (refl k)) g)) ;
  } ;
  thm72 : (K : Nat) -> Claim K = split {
   zero -> base ;
   suc K | ih -> \ s u T hu pairs B hB k g -> Step[K,ih,s,u,T,hu,pairs,B,hB,k,g].result } ;
 } ;
} ;
