-- The Koszul differential by recursion on n (the mapping-cone form).
--
-- Write a in R^(n+1) as (a', c) (c = a_(n+1)) and a vector u on Index(n+1)
-- as (u0, u1) (u0 = u on subsets without n+1, u1 on subsets with it).
-- Then, with d' the differential of a',
--   (d u)(inl J) = (d' u0)(J) ,
--   (d u)(inr J) = c tw_J (u0 J) + (d' u1)(J) ,
-- where tw_J is the sign (-1)^|J| (ExteriorHomogeneous.twist J 1).
-- Proof: the coefficient sums over Index(n+1) split into the inl and inr
-- parts by definition, and by the product rule of the model
--   (a ^ e_(inl I)) = (a' ^ e_I , c alpha(e_I)) ,
--   (a ^ e_(inr I)) = (0 , a' ^ e_I)
-- (up to adding a' ^ 0 = 0 and c alpha(0) = 0); coeff_J (c alpha(e_I)) =
-- c tw_J coeff_J(e_I) (coeff-alpha, twist-mul), and the sum over I of
-- coeff_J(e_I) u0_I is u0_J (Coefficients.delta).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (E : A7.Mod[RingBridge[l].Over[Rg,setR].ring]) {
 open Rg ;
 module CO = C.Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module HO = ExteriorHomogeneous[l].Over[Rg,setR] ;
 module KZ = Koszul[l].Over[Rg,setR,E] ;
 module CF = KZ.CF ; module ME = CF.ME ;
 open ExteriorModel[l].Over[Rg] ;
 module Step (n : Nat) (a : Ps.Fin (suc n) -> R) (u : (CF.V (suc n)).M) {
  a' : Ps.Fin n -> R = \ k -> a (inl k) ;
  c : R = a (inr tt) ;
  u0 : (CF.V n).M = \ I -> u (inl I) ;
  u1 : (CF.V n).M = \ I -> u (inr I) ;
  module W = KZ.K[suc n,a] ; module W' = KZ.K[n,a'] ;
  -- the sign of degree |J|
  tw (J : C.Index n) : R = HO.twist n J o ;
  inl-zero (I J : C.Index n) : Id E.M (E.sm (CO.coeff n (emul n (gen n a') (ezero n)) J) (u (inr I))) E.mz =
   trans (ap (\ t -> E.sm (CO.coeff n t J) (u (inr I))) (EA.mul-zero-r n (gen n a')))
    (trans (ap (\ t -> E.sm t (u (inr I))) (CO.coeff-zero n J)) (ME.sm-zl (u (inr I)))) ;
  at-inl (J : C.Index n) : Id E.M (CF.apply (suc n) (suc n) W.wedge u (inl J)) (CF.apply n n W'.wedge u0 J) =
   trans (ap (E.madd (CF.apply n n W'.wedge u0 J))
     (CF.sum-zeros n (\ I -> E.sm (CO.coeff n (emul n (gen n a') (ezero n)) J) (u (inr I))) (\ I -> inl-zero I J)))
    (E.maddZ (CF.apply n n W'.wedge u0 J)) ;
  -- the inr coordinate, term by term
  cone-term (I J : C.Index n) :
   Id R (CO.coeff n (eadd n (emul n (gen n a') (ezero n)) (emul n (emb n c) (alpha n (CO.basis n I)))) J)
    (mul c (mul (tw J) (CO.coeff n (CO.basis n I) J))) = calc R {
   CO.coeff n (eadd n (emul n (gen n a') (ezero n)) (emul n (emb n c) (alpha n (CO.basis n I)))) J
    =< ap (\ t -> CO.coeff n (eadd n t (emul n (emb n c) (alpha n (CO.basis n I)))) J) (EA.mul-zero-r n (gen n a')) >
   CO.coeff n (eadd n (ezero n) (emul n (emb n c) (alpha n (CO.basis n I)))) J
    =< ap (\ t -> CO.coeff n t J) (trans (EA.eaddC n (ezero n) (emul n (emb n c) (alpha n (CO.basis n I)))) (EA.eaddZ n (emul n (emb n c) (alpha n (CO.basis n I))))) >
   CO.coeff n (emul n (emb n c) (alpha n (CO.basis n I))) J
    =< ap (\ t -> CO.coeff n t J) (EA.emb-mul n c (alpha n (CO.basis n I))) > CO.coeff n (escale n c (alpha n (CO.basis n I))) J
    =< CO.coeff-scale n c (alpha n (CO.basis n I)) J > mul c (CO.coeff n (alpha n (CO.basis n I)) J)
    =< ap (mul c) (HO.coeff-alpha n (CO.basis n I) J) > mul c (HO.twist n J (CO.coeff n (CO.basis n I) J))
    =< ap (\ t -> mul c (HO.twist n J t)) (sym (RL[Rg].one-left (CO.coeff n (CO.basis n I) J))) > mul c (HO.twist n J (mul o (CO.coeff n (CO.basis n I) J)))
    =< ap (mul c) (HO.twist-mul n J o (CO.coeff n (CO.basis n I) J)) > mul c (mul (tw J) (CO.coeff n (CO.basis n I) J)) } ;
  first-sum (J : C.Index n) :
   Id E.M (CF.SE.sum n (\ I -> E.sm (CO.coeff n (eadd n (emul n (gen n a') (ezero n)) (emul n (emb n c) (alpha n (CO.basis n I)))) J) (u (inl I))))
    (E.sm c (E.sm (tw J) (u0 J))) = calc E.M {
   CF.SE.sum n (\ I -> E.sm (CO.coeff n (eadd n (emul n (gen n a') (ezero n)) (emul n (emb n c) (alpha n (CO.basis n I)))) J) (u (inl I)))
    =< CF.SE.cong n (\ I -> E.sm (CO.coeff n (eadd n (emul n (gen n a') (ezero n)) (emul n (emb n c) (alpha n (CO.basis n I)))) J) (u (inl I)))
         (\ I -> E.sm c (E.sm (tw J) (E.sm (CO.coeff n (CO.basis n I) J) (u (inl I)))))
         (\ I -> trans (ap (\ t -> E.sm t (u (inl I))) (cone-term I J))
                  (trans (sym (E.smA c (mul (tw J) (CO.coeff n (CO.basis n I) J)) (u (inl I))))
                   (ap (E.sm c) (sym (E.smA (tw J) (CO.coeff n (CO.basis n I) J) (u (inl I))))))) >
   CF.SE.sum n (\ I -> E.sm c (E.sm (tw J) (E.sm (CO.coeff n (CO.basis n I) J) (u (inl I)))))
    =< sym (trans (CF.sum-sm c n (\ I -> E.sm (tw J) (E.sm (CO.coeff n (CO.basis n I) J) (u (inl I)))))
         (refl (CF.SE.sum n (\ I -> E.sm c (E.sm (tw J) (E.sm (CO.coeff n (CO.basis n I) J) (u (inl I)))))))) >
   E.sm c (CF.SE.sum n (\ I -> E.sm (tw J) (E.sm (CO.coeff n (CO.basis n I) J) (u (inl I)))))
    =< ap (E.sm c) (sym (CF.sum-sm (tw J) n (\ I -> E.sm (CO.coeff n (CO.basis n I) J) (u (inl I))))) >
   E.sm c (E.sm (tw J) (CF.SE.sum n (\ I -> E.sm (CO.coeff n (CO.basis n I) J) (u (inl I)))))
    =< ap (\ t -> E.sm c (E.sm (tw J) t)) (CF.delta n u0 J) > E.sm c (E.sm (tw J) (u0 J)) } ;
  second-term (I J : C.Index n) :
   Id R (CO.coeff n (eadd n (emul n (gen n a') (CO.basis n I)) (emul n (emb n c) (alpha n (ezero n)))) J)
    (CO.coeff n (emul n (gen n a') (CO.basis n I)) J) =
   ap (\ t -> CO.coeff n t J) (trans (ap (\ t -> eadd n (emul n (gen n a') (CO.basis n I)) (emul n (emb n c) t)) (EA.alpha-zero n))
    (trans (ap (eadd n (emul n (gen n a') (CO.basis n I))) (EA.mul-zero-r n (emb n c))) (EA.eaddZ n (emul n (gen n a') (CO.basis n I))))) ;
  at-inr (J : C.Index n) :
   Id E.M (CF.apply (suc n) (suc n) W.wedge u (inr J)) (E.madd (E.sm c (E.sm (tw J) (u0 J))) (CF.apply n n W'.wedge u1 J)) =
   trans (ap (\ t -> E.madd t (CF.SE.sum n (\ I -> E.sm (CO.coeff n (eadd n (emul n (gen n a') (CO.basis n I)) (emul n (emb n c) (alpha n (ezero n)))) J) (u (inr I))))) (first-sum J))
    (ap (E.madd (E.sm c (E.sm (tw J) (u0 J)))) (CF.SE.cong n
      (\ I -> E.sm (CO.coeff n (eadd n (emul n (gen n a') (CO.basis n I)) (emul n (emb n c) (alpha n (ezero n)))) J) (u (inr I)))
      (\ I -> E.sm (CO.coeff n (emul n (gen n a') (CO.basis n I)) J) (u (inr I)))
      (\ I -> ap (\ t -> E.sm t (u (inr I))) (second-term I J)))) ;
 } ;
} ;
