-- The true grade goes up to localizations (for cffr Cor. 7.5):
-- Gr(I) >= k mod J over D gives Gr(I) >= k mod J over D[1/x].
--
-- (a) D -> D[1/y] preserves regularity mod L: let a be regular mod L and
--     a z in L D[1/y], z = t / s with s = y^e0 (s z = t).  Then
--     s (a z) = a t is in L D[1/y], so y^e a t is in L for some e
--     (cffr/LocalRegularMod.Clear), so y^e t is in L (a regular), so its
--     image is in L D[1/y], and z = s^-1 y^-e (y^e t) is too.
-- (b) ext p (D[1/x]) ~ (ext p D)[1/x] (TrueGradeLocal.Comm, p times, and
--     iso-ext1), sending the image of incl_p d to incl_p of its image
--     (theta-c).
-- (c) The composite ext p D -> (ext p D)[1/x] ~ ext p (D[1/x]) preserves
--     regularity (a, iso-pres) and membership, and sends the images of the
--     lists of D to those of D[1/x]: a witness over ext p D gives one over
--     ext p (D[1/x]).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ; module TB = TrueGradeBase[l] ; module TL = TrueGradeLocal[l] ;
module LR = LocalRegular[l] ;

-- u c = 1 gives w = u (c w)
unit-left (C : CRing) (c u w : C.R) (hu : Id C.R (C.mul c u) C.o) : Id C.R w (C.mul u (C.mul c w)) = sym (calc C.R {
 C.mul u (C.mul c w) =< C.mulA u c w > C.mul (C.mul u c) w
  =< ap (\ t -> C.mul t w) (trans (C.mulC u c) hu) > C.mul C.o w
  =< RL[C].one-left w > w }) ;

---------------------------------------------------------------------
-- (a) localization preserves regularity
module LocPres (S : TG.RD) (y : S.1.R) (m : Nat) (L : Ps.Fin m -> S.1.R) (a : S.1.R) (r : TG.RegEl S m L a)
 (z : (TL.Loc S y).1.R) (k : TG.InI (TL.Loc S y) m (\ i -> (TL.loc S y).1 (L i)) ((TL.Loc S y).1.mul ((TL.loc S y).1 a) z)) {
 module IV = LR.Invert[S.1,y] ; module B = IV.B ;
 module G = RI.Generated[(TL.Loc S y).1,m,\ i -> (TL.loc S y).1 (L i)] ;
 module GL = RI.IdealLaws[(TL.Loc S y).1,G.ideal] ;
 module CL (q : B.Raw.Fraction) { module C = LocalRegularMod[l].Clear[S.1,S.2,m,L,y,S.1.mul a q.1] ; } ;
 module At (q : B.Raw.Fraction) (eq : Id (TL.Loc S y).1.R (B.include q) z) {
  -- s (a z) = a t
  sat : Id (TL.Loc S y).1.R ((TL.Loc S y).1.mul (B.constant q.2.1) ((TL.Loc S y).1.mul ((TL.loc S y).1 a) z)) ((TL.loc S y).1 (S.1.mul a q.1)) = calc (TL.Loc S y).1.R {
   (TL.Loc S y).1.mul (B.constant q.2.1) ((TL.Loc S y).1.mul ((TL.loc S y).1 a) z)
    =< RL[(TL.Loc S y).1].mul-swap (B.constant q.2.1) ((TL.loc S y).1 a) z > (TL.Loc S y).1.mul ((TL.loc S y).1 a) ((TL.Loc S y).1.mul (B.constant q.2.1) z)
    =< ap (\ w -> (TL.Loc S y).1.mul ((TL.loc S y).1 a) ((TL.Loc S y).1.mul (B.constant q.2.1) w)) (sym eq) >
   (TL.Loc S y).1.mul ((TL.loc S y).1 a) ((TL.Loc S y).1.mul (B.constant q.2.1) (B.include q))
    =< ap ((TL.Loc S y).1.mul ((TL.loc S y).1 a)) (B.fraction-equation q) > (TL.Loc S y).1.mul ((TL.loc S y).1 a) (B.constant q.1)
    =< sym ((TL.loc S y).2.2.2 a q.1) > (TL.loc S y).1 (S.1.mul a q.1) } ;
  in-at : G.In ((TL.loc S y).1 (S.1.mul a q.1)) =
   GL.in-eq _ _ sat (G.ideal.in-mul (B.constant q.2.1) ((TL.Loc S y).1.mul ((TL.loc S y).1 a) z) k) ;
  -- y^e t in L
  module E (w : CL[q].C.Goal) {
   ye : S.1.R = CL[q].C.I.Pow.power y w.1 ;
   in-yt : TG.InI S m L (S.1.mul ye q.1) =
    r (S.1.mul ye q.1) tt (subst (TG.InI S m L) (RL[S.1].mul-swap ye a q.1) w.2) ;
   in-img : G.In ((TL.loc S y).1 (S.1.mul ye q.1)) = TB.hom-in S (TL.Loc S y) (TL.loc S y) m L (S.1.mul ye q.1) in-yt ;
   -- the image of y^e and of s are units
   uy : RL[(TL.Loc S y).1].unit ((TL.loc S y).1 ye) = TL.powers-unit S y (TL.Loc S y) (TL.loc S y) (TL.x-unit S y) ye (w.1,refl ye) ;
   us : RL[(TL.Loc S y).1].unit (B.constant q.2.1) = B.inverse q.2.1 q.2.2 ;
   ct : G.In (B.constant q.1) =
    GL.in-eq _ _ (sym (trans (unit-left (TL.Loc S y).1 ((TL.loc S y).1 ye) uy.1 (B.constant q.1) uy.2)
      (ap ((TL.Loc S y).1.mul uy.1) (sym ((TL.loc S y).2.2.2 ye q.1)))))
     (G.ideal.in-mul uy.1 ((TL.loc S y).1 (S.1.mul ye q.1)) in-img) ;
   result : G.In z = GL.in-eq _ _ (sym (trans (unit-left (TL.Loc S y).1 (B.constant q.2.1) us.1 z us.2)
      (ap ((TL.Loc S y).1.mul us.1) (trans (ap ((TL.Loc S y).1.mul (B.constant q.2.1)) (sym eq)) (B.fraction-equation q)))))
    (G.ideal.in-mul us.1 (B.constant q.1) ct) ;
  } ;
  result : G.In z = TC.rec CL[q].C.Goal @l (G.In z) (G.in-prop z) (\ w -> E[w].result) (CL[q].C.result in-at) ;
 } ;
 result : G.In z = TC.rec (B.Representatives z) @l (G.In z) (G.in-prop z) (\ u -> At[u.1,u.2].result) (B.representatives z) ;
} ;
loc-pres (S : TG.RD) (y : S.1.R) : TB.Preserves S (TL.Loc S y) (TL.loc S y) =
 \ m L a r z t k -> LocPres[S,y,m,L,a,r,z,k].result ;

---------------------------------------------------------------------
-- (b) (ext p D)[1/x] ~ ext p (D[1/x])
theta-loc : (p : Nat) (D : TG.RD) (x : D.1.R) -> TB.Iso (TL.Loc (TG.ext p D) ((TG.incl p D).1 x)) (TG.ext p (TL.Loc D x)) = split {
 zero -> \ D x -> TB.iso-id (TL.Loc D x) ;
 suc p | r -> \ D x -> TB.iso-compose (TL.Loc (TG.ext1 (TG.ext p D)) (TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 x)))
  (TG.ext1 (TL.Loc (TG.ext p D) ((TG.incl p D).1 x))) (TG.ext1 (TG.ext p (TL.Loc D x)))
  TL.Comm[TG.ext p D,(TG.incl p D).1 x].iso (TB.iso-ext1 (TL.Loc (TG.ext p D) ((TG.incl p D).1 x)) (TG.ext p (TL.Loc D x)) (r D x)) } ;
module ThetaStep (p : Nat) (D : TG.RD) (x d : D.1.R)
 (r : Id (TG.ext p (TL.Loc D x)).1.R ((theta-loc p D x).1.1 ((TL.loc (TG.ext p D) ((TG.incl p D).1 x)).1 ((TG.incl p D).1 d)))
   ((TG.incl p (TL.Loc D x)).1 ((TL.loc D x).1 d))) {
 module CM = TL.Comm[TG.ext p D,(TG.incl p D).1 x] ;
 module M = TB.Map1[TL.Loc (TG.ext p D) ((TG.incl p D).1 x),TG.ext p (TL.Loc D x),(theta-loc p D x).1] ;
 result : Id (TG.ext1 (TG.ext p (TL.Loc D x))).1.R
  (M.map.1 (CM.alpha.1 ((TL.loc (TG.ext1 (TG.ext p D)) (TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 x))).1 (TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 d)))))
  (TG.PolyX[TG.ext p (TL.Loc D x)].X.constant ((TG.incl p (TL.Loc D x)).1 ((TL.loc D x).1 d))) =
  trans (ap M.map.1 (CM.alpha-c (TG.PolyX[TG.ext p D].X.constant ((TG.incl p D).1 d))))
   (trans (ap M.map.1 (CM.PM.on-c ((TG.incl p D).1 d)))
    (trans (M.on-c ((TL.loc (TG.ext p D) ((TG.incl p D).1 x)).1 ((TG.incl p D).1 d))) (ap TG.PolyX[TG.ext p (TL.Loc D x)].X.constant r))) ;
} ;
theta-c : (p : Nat) (D : TG.RD) (x d : D.1.R) ->
 Id (TG.ext p (TL.Loc D x)).1.R ((theta-loc p D x).1.1 ((TL.loc (TG.ext p D) ((TG.incl p D).1 x)).1 ((TG.incl p D).1 d)))
  ((TG.incl p (TL.Loc D x)).1 ((TL.loc D x).1 d)) = split {
 zero -> \ D x d -> refl ((TL.loc D x).1 d) ;
 suc p | r -> \ D x d -> ThetaStep[p,D,x,d,r D x d].result } ;

---------------------------------------------------------------------
-- (c) the true grade goes up
module LocSeq (D : TG.RD) (x : D.1.R) (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (p : Nat) (w : TG.Seq D k m J n I p) {
 phi : RH.Hom (TG.ext p D).1 (TG.ext p (TL.Loc D x)).1 =
  RH.compose (TG.ext p D).1 (TL.Loc (TG.ext p D) ((TG.incl p D).1 x)).1 (TG.ext p (TL.Loc D x)).1 (theta-loc p D x).1 (TL.loc (TG.ext p D) ((TG.incl p D).1 x)) ;
 pres : TB.Preserves (TG.ext p D) (TG.ext p (TL.Loc D x)) phi =
  TB.pres-compose (TG.ext p D) (TL.Loc (TG.ext p D) ((TG.incl p D).1 x)) (TG.ext p (TL.Loc D x)) (TL.loc (TG.ext p D) ((TG.incl p D).1 x)) (theta-loc p D x).1
   (loc-pres (TG.ext p D) ((TG.incl p D).1 x)) (TB.iso-pres (TL.Loc (TG.ext p D) ((TG.incl p D).1 x)) (TG.ext p (TL.Loc D x)) (theta-loc p D x)) ;
 on-img (M : Nat) (L : Ps.Fin M -> D.1.R) (i : Ps.Fin M) :
  Id (TG.ext p (TL.Loc D x)).1.R (phi.1 (TG.img p D M L i)) (TG.img p (TL.Loc D x) M (\ j -> (TL.loc D x).1 (L j)) i) = theta-c p D x (L i) ;
 result : TG.Seq (TL.Loc D x) k m (\ j -> (TL.loc D x).1 (J j)) n (\ j -> (TL.loc D x).1 (I j)) p =
  (\ i -> phi.1 (w.1 i),
   \ i -> TB.ini-list (TG.ext p (TL.Loc D x)) n (\ j -> phi.1 (TG.img p D n I j)) (TG.img p (TL.Loc D x) n (\ j -> (TL.loc D x).1 (I j))) (on-img n I) (phi.1 (w.1 i))
    (TB.hom-in (TG.ext p D) (TG.ext p (TL.Loc D x)) phi n (TG.img p D n I) (w.1 i) (w.2.1 i)),
   TT.regseq-list (TG.ext p (TL.Loc D x)) k m (\ j -> phi.1 (TG.img p D m J j)) (TG.img p (TL.Loc D x) m (\ j -> (TL.loc D x).1 (J j))) (on-img m J) (\ i -> phi.1 (w.1 i))
    (TB.preserves-seq (TG.ext p D) (TG.ext p (TL.Loc D x)) phi pres k m (TG.img p D m J) w.1 w.2.2)) ;
} ;
-- Gr(I) >= k mod J over D gives it over D[1/x]
tgr-loc (k : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (x : D.1.R) (g : TG.TGr k D m J n I) :
 TG.TGr k (TL.Loc D x) m (\ j -> (TL.loc D x).1 (J j)) n (\ j -> (TL.loc D x).1 (I j)) =
 TC.map ((p : Nat) * TG.Seq D k m J n I p) ((p : Nat) * TG.Seq (TL.Loc D x) k m (\ j -> (TL.loc D x).1 (J j)) n (\ j -> (TL.loc D x).1 (I j)) p)
  (\ w -> (w.1,LocSeq[D,x,k,m,J,n,I,w.1,w.2].result)) g ;
