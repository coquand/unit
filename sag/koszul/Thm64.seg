-- cffr Theorem 6.4.  Let 0 -> R^n -u-> R^m -p-> E -> 0 be exact, u a
-- matrix by columns (cffr/Matrices, injective in its sense).
-- (1) Gr(a) >= k + 1 gives Gr(a; E) >= k: Gr(a; R^n) >= k + 1 and
--     Gr(a; R^m) >= k (Products.power-upto), then Lemma 6.2.
-- (2) If n > 0 and every coefficient of u is in (a), u_sr = B_sr . a, then
--     Gr(a; E) >= k gives Gr(a) >= k + 1.  The map of Koszul complexes
--     C(a; R^n) -> C(a; R^m) is zero on cohomology: the r-th coordinate of
--     u z is sum_s u_sr pi_s z, each u_sr pi_s z is a coboundary (Lemma 6.1:
--     pi_s z is a cocycle), so is the sum, and coordinatewise coboundaries
--     assemble (Products.assemble).  So Gr(a; R^n) >= k + 1
--     (VanishLES.lemma-zero), and Gr(a) >= k + 1 since R is a retract of
--     R^n.  (cffr argues separately that H^0(a; R) = 0; lemma-zero covers
--     degree 0 too.)
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module Bj = Bijection[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module CX = Complexes[l].Over[MO.ring] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module PR = Products[l].Over[Rg,setR] ;
 module MX = Matrices[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module RA = A7.RA[MO.ring] ;
 module S = MX.S ;
 reg : MO.Module = MO.regular ;
 module MR = A7.MA[MO.ring,reg] ;

 ---------------------------------------------------------------------
 -- the linear map of a matrix
 apply-add (p q : Nat) (u : MX.Mat p q) (x y : MX.Vec p) :
  Id (MX.Vec q) (MX.apply p q u (\ k -> add (x k) (y k))) (\ j -> add (MX.apply p q u x j) (MX.apply p q u y j)) =
  F.funext (Ps.Fin q) (\ j -> R) (MX.apply p q u (\ k -> add (x k) (y k))) (\ j -> add (MX.apply p q u x j) (MX.apply p q u y j))
   (\ j -> trans (S.sum-cong p (\ k -> mul (add (x k) (y k)) (u k j)) (\ k -> add (mul (x k) (u k j)) (mul (y k) (u k j))) (\ k -> RA.rdist (x k) (y k) (u k j)))
    (S.sum-add p (\ k -> mul (x k) (u k j)) (\ k -> mul (y k) (u k j)))) ;
 apply-scale (p q : Nat) (u : MX.Mat p q) (c : R) (x : MX.Vec p) :
  Id (MX.Vec q) (MX.apply p q u (\ k -> mul c (x k))) (\ j -> mul c (MX.apply p q u x j)) =
  F.funext (Ps.Fin q) (\ j -> R) (MX.apply p q u (\ k -> mul c (x k))) (\ j -> mul c (MX.apply p q u x j))
   (\ j -> trans (S.sum-cong p (\ k -> mul (mul c (x k)) (u k j)) (\ k -> mul c (mul (x k) (u k j))) (\ k -> sym (mulA c (x k) (u k j))))
    (S.sum-scale c p (\ k -> mul (x k) (u k j)))) ;
 lin-of (p q : Nat) (u : MX.Mat p q) : SM.Linear (PR.Pow reg p) (PR.Pow reg q) = (MX.apply p q u,apply-add p q u,apply-scale p q u) ;
 module LinOf (p q : Nat) (u : MX.Mat p q) {
  module L = SM.Lin[PR.Pow reg p,PR.Pow reg q,lin-of p q u] ;
  module MP = A7.MA[MO.ring,PR.Pow reg p] ; module MQ = A7.MA[MO.ring,PR.Pow reg q] ;
  injective (hu : MX.Injective p q u) : Bj.Injective (lin-of p q u).1 = \ x y h ->
   F.funext (Ps.Fin p) (\ k -> R) x y (\ k -> MR.sub-zero (x k) (y k) (hu (MP.sub x y)
    (\ j -> ap (\ t -> t j) (trans (L.map-sub x y) (trans (ap (\ t -> MQ.sub t (MX.apply p q u y)) h) (MQ.sub-self (MX.apply p q u y))))) k)) ;
 } ;

 ---------------------------------------------------------------------
 -- finite sums over Fin n in a module, and coboundaries
 msum (P : SM.Module) : (n : Nat) -> (Ps.Fin n -> P.M) -> P.M = split {
  zero -> \ v -> P.mz ; suc n | r -> \ v -> P.madd (v (inr tt)) (r (\ i -> v (inl i))) } ;
 bnd-sum (K : CX.Complex) (k : Nat) : (n : Nat) (v : Ps.Fin n -> CX.Cx[K].M k) -> ((s : Ps.Fin n) -> CX.Cx[K].Bnd k (v s)) ->
  CX.Cx[K].Bnd k (msum (K.C k) n v) = split {
  zero -> \ v h -> CX.Cx[K].bnd-zero k ;
  suc n | r -> \ v h -> CX.Cx[K].bnd-add k (v (inr tt)) (msum (K.C k) n (\ i -> v (inl i))) (h (inr tt)) (r (\ i -> v (inl i)) (\ i -> h (inl i))) } ;

 ---------------------------------------------------------------------
 module Thm64 (n m N : Nat) (a : Ps.Fin N -> R) (u : MX.Mat n m) (hu : MX.Injective n m u)
  (E : MO.Module) (p : SM.Linear (PR.Pow reg m) E)
  (pi : (x : (PR.Pow reg n).M) -> Id E.M (p.1 (MX.apply n m u x)) E.mz)
  (ex : (y : (PR.Pow reg m).M) -> Id E.M (p.1 y) E.mz -> Tr.Trunc[Bj.Fibre (MX.apply n m u) y].carrier)
  (onto : (e : E.M) -> Tr.Trunc[Bj.Fibre p.1 e].carrier) {
  module SG = GR.SesGrade[PR.Pow reg n,PR.Pow reg m,E,lin-of n m u,p,LinOf[n,m,u].injective hu,pi,ex,onto,N,a] ;
  module PN = PR.Power[reg,n,N,a] ; module PM = PR.Power[reg,m,N,a] ;
  -- (1)
  part1 (k : Nat) (g : GR.Gr reg N a (suc k)) : GR.Gr E N a k = SG.lemma62 k (PN.power-upto (suc k) g) (PM.power-upto k g.1) ;
  -- coefficients of u in (a)
  module InIdeal (B : Ps.Fin n -> Ps.Fin m -> AL.Vec N) (hB : (s : Ps.Fin n) (r : Ps.Fin m) -> Id R (VC.vdot N (B s r) a) (u s r)) {
   module KQ = PN.KQ ; module LQ = PN.LQ ; module CQ = PN.CQ ;
   msum-at (k : Nat) (I : ExteriorCoordinates[l].Index N) : (q : Nat) (v : Ps.Fin q -> KQ.Deg[N,k].S.E) ->
    Id R ((msum (LQ.Ck k) q v).1 I) (S.sum q (\ s -> (v s).1 I)) = split {
    zero -> \ v -> refl z ;
    suc q | r -> \ v -> ap (add ((v (inr tt)).1 I)) (r (\ i -> v (inl i))) } ;
   module At (k : Nat) (zz : SG.L.CA.M k) (c : SG.L.CA.Cocycle k zz) {
    -- u_sr pi_s z is a coboundary
    term (s : Ps.Fin n) (r : Ps.Fin m) : CQ.Bnd k ((LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz)) =
     subst (CQ.Bnd k) (KQ.Deg[N,k].S.eq (GR.MultZero[reg,N,a,B s r].MI.app k (PN.FJ[s].ML.app k zz)) ((LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz))
       (KQ.CF.veq N (GR.MultZero[reg,N,a,B s r].MI.app k (PN.FJ[s].ML.app k zz)).1 ((LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz)).1
        (\ I -> ap (\ x -> mul x (zz.1 I s)) (hB s r))))
      (GR.MultZero[reg,N,a,B s r].zero k (PN.FJ[s].ML.app k zz) (PN.FJ[s].ML.cocycle k zz c)) ;
    -- the r-th coordinate of u z is sum_s u_sr pi_s z
    coord-eq (r : Ps.Fin m) : Id (CQ.M k) (msum (LQ.Ck k) n (\ s -> (LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz))) (PM.FJ[r].ML.app k (SG.L.MI.app k zz)) =
     KQ.Deg[N,k].S.eq (msum (LQ.Ck k) n (\ s -> (LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz))) (PM.FJ[r].ML.app k (SG.L.MI.app k zz))
      (KQ.CF.veq N (msum (LQ.Ck k) n (\ s -> (LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz))).1 (PM.FJ[r].ML.app k (SG.L.MI.app k zz)).1 (\ I ->
       trans (msum-at k I n (\ s -> (LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz)))
        (S.sum-cong n (\ s -> mul (u s r) (zz.1 I s)) (\ s -> mul (zz.1 I s) (u s r)) (\ s -> mulC (u s r) (zz.1 I s))))) ;
    coord (r : Ps.Fin m) : CQ.Bnd k (PM.FJ[r].ML.app k (SG.L.MI.app k zz)) =
     subst (CQ.Bnd k) (coord-eq r) (bnd-sum LQ.complex k n (\ s -> (LQ.Ck k).sm (u s r) (PN.FJ[s].ML.app k zz)) (\ s -> term s r)) ;
   } ;
   -- u is zero on cohomology
   zero : SG.L.Zero = \ k zz c -> PM.assemble k (SG.L.MI.app k zz) (At[k,zz,c].coord) ;
  } ;
 } ;
 -- (2), with n = n' + 1
 module Part2 (n' m N : Nat) (a : Ps.Fin N -> R) (u : MX.Mat (suc n') m) (hu : MX.Injective (suc n') m u)
  (E : MO.Module) (p : SM.Linear (PR.Pow reg m) E)
  (pi : (x : (PR.Pow reg (suc n')).M) -> Id E.M (p.1 (MX.apply (suc n') m u x)) E.mz)
  (ex : (y : (PR.Pow reg m).M) -> Id E.M (p.1 y) E.mz -> Tr.Trunc[Bj.Fibre (MX.apply (suc n') m u) y].carrier)
  (onto : (e : E.M) -> Tr.Trunc[Bj.Fibre p.1 e].carrier)
  (B : Ps.Fin (suc n') -> Ps.Fin m -> AL.Vec N) (hB : (s : Ps.Fin (suc n')) (r : Ps.Fin m) -> Id R (VC.vdot N (B s r) a) (u s r)) {
  module T = Thm64[suc n',m,N,a,u,hu,E,p,pi,ex,onto] ;
  part2 (k : Nat) (gE : GR.Gr E N a k) : GR.Gr reg N a (suc k) =
   PR.Last[reg,n',N,a].retract-upto (suc k) (T.SG.L.lemma-zero T.InIdeal[B,hB].zero k gE) ;
 } ;
} ;
