-- Exterior maps with coefficients in a module E (cffr §5.2, design §4).
--
-- V n = (Index n -> E) is the module of E-valued coefficient vectors
-- (alpha_I stands for the coefficient of e_I), with pointwise structure
-- (Modules.pi).  For x in Ext n and e in E, x (x) e has coefficients
-- coeff_I(x) e.  An R-linear map f : Ext n -> Ext m acts on V by its
-- matrix in the bases e_I:
--     (f_E alpha)_J = sum_I coeff_J (f e_I) alpha_I .
-- Every identity between maps of the exterior algebra used later is then
-- an identity between their matrices; we prove the laws once:
-- (delta)     sum_I coeff_J (e_I) alpha_I = alpha_J (induction on n:
--             e_(inl I) = (e_I, 0), e_(inr I) = (0, e_I));
-- (tens)      f_E (x (x) e) = f x (x) e, since
--             sum_I coeff_J(f e_I) coeff_I(x) e = coeff_J (sum_I coeff_I(x) f e_I) e
--             = coeff_J (f x) e by the expansion of f (map-expansion);
-- (sum)       f_E alpha = sum_I f e_I (x) alpha_I (by definition, read
--             coordinatewise);
-- f_E is linear, hence commutes with finite sums of vectors;
-- (compose)   g_E (f_E alpha) = (g f)_E alpha: by (sum), linearity of g_E
--             and (tens) for g, both sides are sum_I g (f e_I) (x) alpha_I;
-- (f + g)_E = f_E + g_E, (s .)_E = s ., 0_E = 0, and f_E = g_E when f and
-- g agree pointwise.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ;
module C = ExteriorCoordinates[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (E : A7.Mod[RingBridge[l].Over[Rg,setR].ring]) {
 open Rg ;
 module CO = C.Over[Rg,setR] ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module ME = A7.MA[MO.ring,E] ;
 open ExteriorModel[l].Over[Rg] ;
 module SE = C.Sum[E.M,E.madd] ;

 ---------------------------------------------------------------------
 -- finite sums in E over Index n
 sum-zeros : (n : Nat) (h : C.Index n -> E.M) -> ((i : C.Index n) -> Id E.M (h i) E.mz) -> Id E.M (SE.sum n h) E.mz = split {
  zero -> \ h hz -> hz tt ;
  suc n | r -> \ h hz -> trans (ap (\ t -> E.madd t (SE.sum n (\ i -> h (inr i)))) (r (\ i -> h (inl i)) (\ i -> hz (inl i))))
   (trans (ap (E.madd E.mz) (r (\ i -> h (inr i)) (\ i -> hz (inr i)))) (E.maddZ E.mz)) } ;
 sum-add : (n : Nat) (h h' : C.Index n -> E.M) -> Id E.M (E.madd (SE.sum n h) (SE.sum n h')) (SE.sum n (\ i -> E.madd (h i) (h' i))) = split {
  zero -> \ h h' -> refl (E.madd (h tt) (h' tt)) ;
  suc n | r -> \ h h' -> trans (ME.swap4 (SE.sum n (\ i -> h (inl i))) (SE.sum n (\ i -> h (inr i))) (SE.sum n (\ i -> h' (inl i))) (SE.sum n (\ i -> h' (inr i))))
   (trans (ap (\ t -> E.madd t (E.madd (SE.sum n (\ i -> h (inr i))) (SE.sum n (\ i -> h' (inr i))))) (r (\ i -> h (inl i)) (\ i -> h' (inl i))))
    (ap (E.madd (SE.sum n (\ i -> E.madd (h (inl i)) (h' (inl i))))) (r (\ i -> h (inr i)) (\ i -> h' (inr i))))) } ;
 sum-sm (a : R) (n : Nat) (h : C.Index n -> E.M) : Id E.M (E.sm a (SE.sum n h)) (SE.sum n (\ i -> E.sm a (h i))) =
  C.SumMap[E.M,E.M,E.madd,E.madd,E.sm a,E.smD a].map n h ;
 sum-sm-left (e : E.M) (n : Nat) (c : C.Index n -> R) : Id E.M (E.sm (CO.S.sum n c) e) (SE.sum n (\ i -> E.sm (c i) e)) =
  C.SumMap[R,E.M,add,E.madd,\ a -> E.sm a e,\ a b -> E.smE a b e].map n c ;

 ---------------------------------------------------------------------
 -- coefficient vectors
 V (n : Nat) : MO.Module = MO.pi (C.Index n) (\ i -> E) ;
 veq (n : Nat) (u v : (V n).M) (h : (J : C.Index n) -> Id E.M (u J) (v J)) : Id (V n).M u v =
  F.funext (C.Index n) (\ J -> E.M) u v h ;
 module SV (m : Nat) { module S = C.Sum[(V m).M,(V m).madd] ; } ;
 -- a V-sum, read at J
 sum-at (m n : Nat) (h : C.Index n -> (V m).M) (J : C.Index m) : Id E.M (SV[m].S.sum n h J) (SE.sum n (\ I -> h I J)) =
  C.SumMap[(V m).M,E.M,(V m).madd,E.madd,\ u -> u J,\ u v -> refl (E.madd (u J) (v J))].map n h ;
 tens (m : Nat) (x : Ext m) (e : E.M) : (V m).M = \ J -> E.sm (CO.coeff m x J) e ;
 -- f_E, by its matrix
 apply (n m : Nat) (f : Ext n -> Ext m) (u : (V n).M) : (V m).M =
  \ J -> SE.sum n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)) ;

 ---------------------------------------------------------------------
 -- (delta)
 delta : (n : Nat) (u : (V n).M) (J : C.Index n) -> Id E.M (SE.sum n (\ I -> E.sm (CO.coeff n (CO.basis n I) J) (u I))) (u J) = split {
  zero -> \ u -> split { tt -> E.smO (u tt) } ;
  suc n | r -> \ u -> split {
   inl J -> trans (ap (\ t -> E.madd t (SE.sum n (\ I -> E.sm (CO.coeff n (ezero n) J) (u (inr I))))) (r (\ I -> u (inl I)) J))
    (trans (ap (E.madd (u (inl J))) (sum-zeros n (\ I -> E.sm (CO.coeff n (ezero n) J) (u (inr I)))
      (\ I -> trans (ap (\ c -> E.sm c (u (inr I))) (CO.coeff-zero n J)) (ME.sm-zl (u (inr I))))))
     (E.maddZ (u (inl J)))) ;
   inr J -> trans (ap (\ t -> E.madd t (SE.sum n (\ I -> E.sm (CO.coeff n (CO.basis n I) J) (u (inr I)))))
     (sum-zeros n (\ I -> E.sm (CO.coeff n (ezero n) J) (u (inl I)))
      (\ I -> trans (ap (\ c -> E.sm c (u (inl I))) (CO.coeff-zero n J)) (ME.sm-zl (u (inl I))))))
    (trans (ap (E.madd E.mz) (r (\ I -> u (inr I)) J)) (ME.mzl (u (inr J)))) } } ;

 -- (sum)
 apply-sum (n m : Nat) (f : Ext n -> Ext m) (u : (V n).M) :
  Id (V m).M (apply n m f u) (SV[m].S.sum n (\ I -> tens m (f (CO.basis n I)) (u I))) =
  veq m (apply n m f u) (SV[m].S.sum n (\ I -> tens m (f (CO.basis n I)) (u I)))
   (\ J -> sym (sum-at m n (\ I -> tens m (f (CO.basis n I)) (u I)) J)) ;

 -- (tens): first the coefficient of f x
 coeff-map (n m : Nat) (f : Ext n -> Ext m) (hf : CO.LinearMap n m f) (x : Ext n) (J : C.Index m) :
  Id R (CO.S.sum n (\ I -> mul (CO.coeff n x I) (CO.coeff m (f (CO.basis n I)) J))) (CO.coeff m (f x) J) = sym (calc R {
   CO.coeff m (f x) J
    =< ap (\ w -> CO.coeff m w J) (CO.map-expansion n m f hf x) >
   CO.coeff m (CO.ES[m].SumE.sum n (\ i -> escale m (CO.coeff n x i) (f (CO.basis n i)))) J
    =< C.SumMap[Ext m,R,eadd m,add,\ w -> CO.coeff m w J,\ u v -> CO.coeff-add m u v J].map n (\ i -> escale m (CO.coeff n x i) (f (CO.basis n i))) >
   CO.S.sum n (\ i -> CO.coeff m (escale m (CO.coeff n x i) (f (CO.basis n i))) J)
    =< CO.S.cong n (\ i -> CO.coeff m (escale m (CO.coeff n x i) (f (CO.basis n i))) J) (\ i -> mul (CO.coeff n x i) (CO.coeff m (f (CO.basis n i)) J))
      (\ i -> CO.coeff-scale m (CO.coeff n x i) (f (CO.basis n i)) J) >
   CO.S.sum n (\ I -> mul (CO.coeff n x I) (CO.coeff m (f (CO.basis n I)) J)) }) ;
 apply-tens (n m : Nat) (f : Ext n -> Ext m) (hf : CO.LinearMap n m f) (x : Ext n) (e : E.M) :
  Id (V m).M (apply n m f (tens n x e)) (tens m (f x) e) = veq m (apply n m f (tens n x e)) (tens m (f x) e) (\ J -> calc E.M {
   SE.sum n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (E.sm (CO.coeff n x I) e))
    =< SE.cong n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (E.sm (CO.coeff n x I) e))
         (\ I -> E.sm (mul (CO.coeff n x I) (CO.coeff m (f (CO.basis n I)) J)) e)
         (\ I -> trans (E.smA (CO.coeff m (f (CO.basis n I)) J) (CO.coeff n x I) e)
                  (ap (\ c -> E.sm c e) (mulC (CO.coeff m (f (CO.basis n I)) J) (CO.coeff n x I)))) >
   SE.sum n (\ I -> E.sm (mul (CO.coeff n x I) (CO.coeff m (f (CO.basis n I)) J)) e)
    =< sym (sum-sm-left e n (\ I -> mul (CO.coeff n x I) (CO.coeff m (f (CO.basis n I)) J))) >
   E.sm (CO.S.sum n (\ I -> mul (CO.coeff n x I) (CO.coeff m (f (CO.basis n I)) J))) e
    =< ap (\ c -> E.sm c e) (coeff-map n m f hf x J) >
   E.sm (CO.coeff m (f x) J) e }) ;

 ---------------------------------------------------------------------
 -- f_E is linear
 apply-add (n m : Nat) (f : Ext n -> Ext m) (u v : (V n).M) :
  Id (V m).M (apply n m f ((V n).madd u v)) ((V m).madd (apply n m f u) (apply n m f v)) =
  veq m (apply n m f ((V n).madd u v)) ((V m).madd (apply n m f u) (apply n m f v)) (\ J -> trans
   (SE.cong n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (E.madd (u I) (v I)))
     (\ I -> E.madd (E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)) (E.sm (CO.coeff m (f (CO.basis n I)) J) (v I)))
     (\ I -> E.smD (CO.coeff m (f (CO.basis n I)) J) (u I) (v I)))
   (sym (sum-add n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)) (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (v I))))) ;
 apply-sm (n m : Nat) (f : Ext n -> Ext m) (a : R) (u : (V n).M) :
  Id (V m).M (apply n m f ((V n).sm a u)) ((V m).sm a (apply n m f u)) =
  veq m (apply n m f ((V n).sm a u)) ((V m).sm a (apply n m f u)) (\ J -> trans
   (SE.cong n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (E.sm a (u I)))
     (\ I -> E.sm a (E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)))
     (\ I -> ME.sm-swap (CO.coeff m (f (CO.basis n I)) J) a (u I)))
   (sym (sum-sm a n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (u I))))) ;
 lin (n m : Nat) (f : Ext n -> Ext m) : SM.Linear (V n) (V m) = (apply n m f,apply-add n m f,apply-sm n m f) ;
 apply-vsum (n m k : Nat) (f : Ext n -> Ext m) (h : C.Index k -> (V n).M) :
  Id (V m).M (apply n m f (SV[n].S.sum k h)) (SV[m].S.sum k (\ i -> apply n m f (h i))) =
  C.SumMap[(V n).M,(V m).M,(V n).madd,(V m).madd,apply n m f,apply-add n m f].map k h ;

 -- (compose)
 compose (n m p : Nat) (f : Ext n -> Ext m) (g : Ext m -> Ext p) (hg : CO.LinearMap m p g) (u : (V n).M) :
  Id (V p).M (apply m p g (apply n m f u)) (apply n p (\ x -> g (f x)) u) = calc (V p).M {
   apply m p g (apply n m f u)
    =< ap (apply m p g) (apply-sum n m f u) > apply m p g (SV[m].S.sum n (\ I -> tens m (f (CO.basis n I)) (u I)))
    =< apply-vsum m p n g (\ I -> tens m (f (CO.basis n I)) (u I)) > SV[p].S.sum n (\ I -> apply m p g (tens m (f (CO.basis n I)) (u I)))
    =< SV[p].S.cong n (\ I -> apply m p g (tens m (f (CO.basis n I)) (u I))) (\ I -> tens p (g (f (CO.basis n I))) (u I))
         (\ I -> apply-tens m p g hg (f (CO.basis n I)) (u I)) > SV[p].S.sum n (\ I -> tens p (g (f (CO.basis n I))) (u I))
    =< sym (apply-sum n p (\ x -> g (f x)) u) > apply n p (\ x -> g (f x)) u } ;

 ---------------------------------------------------------------------
 -- maps agreeing pointwise, sums of maps, scalars, zero
 apply-ext (n m : Nat) (f g : Ext n -> Ext m) (h : (x : Ext n) -> Id (Ext m) (f x) (g x)) (u : (V n).M) :
  Id (V m).M (apply n m f u) (apply n m g u) = veq m (apply n m f u) (apply n m g u) (\ J ->
   SE.cong n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)) (\ I -> E.sm (CO.coeff m (g (CO.basis n I)) J) (u I))
    (\ I -> ap (\ w -> E.sm (CO.coeff m w J) (u I)) (h (CO.basis n I)))) ;
 apply-plus (n m : Nat) (f g : Ext n -> Ext m) (u : (V n).M) :
  Id (V m).M (apply n m (\ x -> eadd m (f x) (g x)) u) ((V m).madd (apply n m f u) (apply n m g u)) =
  veq m (apply n m (\ x -> eadd m (f x) (g x)) u) ((V m).madd (apply n m f u) (apply n m g u)) (\ J -> trans
   (SE.cong n (\ I -> E.sm (CO.coeff m (eadd m (f (CO.basis n I)) (g (CO.basis n I))) J) (u I))
     (\ I -> E.madd (E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)) (E.sm (CO.coeff m (g (CO.basis n I)) J) (u I)))
     (\ I -> trans (ap (\ c -> E.sm c (u I)) (CO.coeff-add m (f (CO.basis n I)) (g (CO.basis n I)) J))
              (E.smE (CO.coeff m (f (CO.basis n I)) J) (CO.coeff m (g (CO.basis n I)) J) (u I))))
   (sym (sum-add n (\ I -> E.sm (CO.coeff m (f (CO.basis n I)) J) (u I)) (\ I -> E.sm (CO.coeff m (g (CO.basis n I)) J) (u I))))) ;
 apply-scale (n : Nat) (s : R) (u : (V n).M) : Id (V n).M (apply n n (\ x -> escale n s x) u) ((V n).sm s u) =
  veq n (apply n n (\ x -> escale n s x) u) ((V n).sm s u) (\ J -> calc E.M {
   SE.sum n (\ I -> E.sm (CO.coeff n (escale n s (CO.basis n I)) J) (u I))
    =< SE.cong n (\ I -> E.sm (CO.coeff n (escale n s (CO.basis n I)) J) (u I)) (\ I -> E.sm s (E.sm (CO.coeff n (CO.basis n I) J) (u I)))
         (\ I -> trans (ap (\ c -> E.sm c (u I)) (CO.coeff-scale n s (CO.basis n I) J)) (sym (E.smA s (CO.coeff n (CO.basis n I) J) (u I)))) >
   SE.sum n (\ I -> E.sm s (E.sm (CO.coeff n (CO.basis n I) J) (u I)))
    =< sym (sum-sm s n (\ I -> E.sm (CO.coeff n (CO.basis n I) J) (u I))) > E.sm s (SE.sum n (\ I -> E.sm (CO.coeff n (CO.basis n I) J) (u I)))
    =< ap (E.sm s) (delta n u J) > E.sm s (u J) }) ;
 apply-zero (n m : Nat) (u : (V n).M) : Id (V m).M (apply n m (\ x -> ezero m) u) (V m).mz =
  veq m (apply n m (\ x -> ezero m) u) (V m).mz (\ J ->
   sum-zeros n (\ I -> E.sm (CO.coeff m (ezero m) J) (u I))
    (\ I -> trans (ap (\ c -> E.sm c (u I)) (CO.coeff-zero m J)) (ME.sm-zl (u I)))) ;
 -- the identity
 apply-id (n : Nat) (u : (V n).M) : Id (V n).M (apply n n (\ x -> x) u) u = veq n (apply n n (\ x -> x) u) u (delta n u) ;
} ;
