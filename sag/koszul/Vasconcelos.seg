-- cffr Theorem 2.6 (Vasconcelos) and Corollary 2.7.
--
-- E = coker M for M : R^n -> R^q stable of rank r; Ann(E) is the set of
-- a with a R^q in im M.
-- (a) q = r: Ann(E) is regular.  Each q x q minor det(B), B = M C, is in
--     Ann(E) (Cramer: det(B) y = B c with c = adj(B^t)^t y, so det(B) y is
--     in im M); if x kills Ann(E), x kills every q-wedge of im M, which is
--     det(B) omega, and D_q(M) is regular: x = 0.
-- (b) q = r + 1 + d: Ann(E) = 0.  Let a be in Ann(E) and W an r-wedge of
--     im M.  For v in R^q, a v is in im M, so (a W) v = W (a v) is an
--     (r+1)-wedge of im M: 0.  Hence (a W) P = 0 for every nonempty
--     product P of generators.  Y = a W has degree r; for |I| = r the
--     complement I' of I is nonempty, and eps_I coeff_I(Y) =
--     coeff_I'(star Y) = top(Y basis(I')) = 0, so coeff_I(Y) = 0 (and it is
--     0 for |I| /= r by degree).  So a kills D_r(M), which is regular: a = 0.
-- (c) r = q + 1 + d: 1 = 0 (Resolution.too-big).
-- Along a resolution R^p -u-> R^(s 0) -> ... -T (k-1)-> R^(s k) of E
-- (Thm68 layout; E = coker of the last map), with the ranks of
-- Resolution.ranks (s 0 = r 0 + p, s (i+1) = r (i+1) + r i), the
-- alternating sums pos k = s k + s (k-2) + ... and neg k = s (k-1) + ...
-- satisfy pos k = s k + X, neg k = rho k + X, rho k the rank of the last
-- map: Char(E) = pos k - neg k has the sign of s k - rho k.
-- Corollary 2.7: if (a) = (w) for the last map w : R^n -> R of a
-- resolution, then a = 0 or a is regular (E = R/(a), Ann(E) = (a)).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module NA = NatArith[l] ; module H = ExteriorHomogeneous[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = ExteriorCoordinates[l].Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module AD = Adjugate[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 module MK = MinorKill[l].Over[Rg,setR] ;
 module MF = MinorForms[l].Over[Rg,setR] ;

 -- a is in Ann(coker M)
 Ann (n q : Nat) (M : MM.Mat n q) (a : R) : U l =
  (y : MM.Vec q) -> Tr.Trunc[(C : MM.Vec n) * Id (MM.Vec q) (\ j -> mul a (y j)) (MM.apply n q M C)].carrier ;

 ---------------------------------------------------------------------
 -- Cramer: B c = det(B) y for c = adj(B^t)^t y
 module Cramer (q : Nat) (B : DT.Mat q) (y : MM.Vec q) {
  A : DT.Mat q = TP.transpose q B ;
  X : DT.Mat q = AD.adj q A ;
  coef : MM.Vec q = \ i -> S.sum q (\ k -> mul (y k) (X i k)) ;
  -- sum_i B_ij X_ik = det(A) delta_jk
  row (j k : Ps.Fin q) : Id R (S.sum q (\ i -> mul (B i j) (X i k))) (mul (det q A) (D.delta q j k)) =
   trans (S.sum-cong q (\ i -> mul (B i j) (X i k)) (\ i -> mul (A j i) (X i k))
     (\ i -> ap (\ t -> mul t (X i k)) (sym (TP.transpose-value q B j i))))
    (AD.adj-mul q A j k) ;
  term (j i : Ps.Fin q) : Id R (mul (coef i) (B i j)) (S.sum q (\ k -> mul (y k) (mul (B i j) (X i k)))) =
   trans (sym (D.sum-scale-right (B i j) q (\ k -> mul (y k) (X i k))))
    (S.sum-cong q (\ k -> mul (mul (y k) (X i k)) (B i j)) (\ k -> mul (y k) (mul (B i j) (X i k)))
     (\ k -> trans (sym (mulA (y k) (X i k) (B i j))) (ap (mul (y k)) (mulC (X i k) (B i j))))) ;
  result (j : Ps.Fin q) : Id R (MM.apply q q B coef j) (mul (det q B) (y j)) = calc R {
   MM.apply q q B coef j
    =< S.sum-cong q (\ i -> mul (coef i) (B i j)) (\ i -> S.sum q (\ k -> mul (y k) (mul (B i j) (X i k)))) (term j) >
   S.sum q (\ i -> S.sum q (\ k -> mul (y k) (mul (B i j) (X i k))))
    =< D.exchange q q (\ i k -> mul (y k) (mul (B i j) (X i k))) >
   S.sum q (\ k -> S.sum q (\ i -> mul (y k) (mul (B i j) (X i k))))
    =< S.sum-cong q (\ k -> S.sum q (\ i -> mul (y k) (mul (B i j) (X i k)))) (\ k -> mul (y k) (mul (det q A) (D.delta q j k)))
      (\ k -> trans (S.sum-scale (y k) q (\ i -> mul (B i j) (X i k))) (ap (mul (y k)) (row j k))) >
   S.sum q (\ k -> mul (y k) (mul (det q A) (D.delta q j k)))
    =< S.sum-cong q (\ k -> mul (y k) (mul (det q A) (D.delta q j k))) (\ k -> mul (det q A) (mul (D.delta q j k) (y k)))
      (\ k -> trans (L.mul-swap (y k) (det q A) (D.delta q j k)) (ap (mul (det q A)) (mulC (y k) (D.delta q j k)))) >
   S.sum q (\ k -> mul (det q A) (mul (D.delta q j k) (y k)))
    =< S.sum-scale (det q A) q (\ k -> mul (D.delta q j k) (y k)) >
   mul (det q A) (S.sum q (\ k -> mul (D.delta q j k) (y k)))
    =< ap (mul (det q A)) (D.sum-delta q j y) > mul (det q A) (y j)
    =< ap (\ t -> mul t (y j)) (sym (TP.det-transpose q B)) > mul (det q B) (y j) } ;
 } ;

 ---------------------------------------------------------------------
 -- (a) q = r: Ann(coker M) is regular
 module Zero (n q : Nat) (M : MM.Mat n q) (reg : MF.ImageRegular q n q M) (x : R)
  (hx : (a : R) -> Ann n q M a -> Id R (mul a x) z) {
  module Minor (C : MM.Mat q n) {
   B : DT.Mat q = MK.compose q n q M C ;
   in-ann : Ann n q M (det q B) = \ y ->
    Tr.Trunc[(C' : MM.Vec n) * Id (MM.Vec q) (\ j -> mul (det q B) (y j)) (MM.apply n q M C')].inc
     (MM.apply q n C (Cramer[q,B,y].coef),
      F.funext (Ps.Fin q) (\ j -> R) (\ j -> mul (det q B) (y j)) (MM.apply n q M (MM.apply q n C (Cramer[q,B,y].coef)))
       (\ j -> trans (sym (Cramer[q,B,y].result j)) (sym (MM.apply-apply q n q C M (Cramer[q,B,y].coef) j)))) ;
   kills : MK.KillsW q x (MM.wedge q q B) = calc (Ext q) {
    escale q x (MM.wedge q q B)
     =< ap (escale q x) (DT.free q B) > escale q x (escale q (det q B) (DG.omega q))
     =< EA.escale-scale q x (det q B) (DG.omega q) > escale q (mul x (det q B)) (DG.omega q)
     =< ap (\ t -> escale q t (DG.omega q)) (trans (mulC x (det q B)) (hx (det q B) in-ann)) > escale q z (DG.omega q)
     =< EA.zero-scale q (DG.omega q) > ezero q } ;
  } ;
  result : Id R x z = reg x (\ C -> Minor[C].kills) ;
 } ;

 ---------------------------------------------------------------------
 -- (b) an element of degree r < q killed by every generator on the right is 0
 module Divides (q r d : Nat) (e : Id Nat q (plus r (suc d))) (Y : Ext q) (dY : DG.Deg q r Y)
  (h : (v : MM.Vec q) -> Id (Ext q) (emul q Y (gen q v)) (ezero q)) {
  prod : (m : Nat) (u : Ps.Fin (suc m) -> MM.Vec q) -> Id (Ext q) (emul q Y (eprod q (suc m) (\ k -> gen q (u k)))) (ezero q) = split {
   zero -> \ u -> trans (ap (emul q Y) (EA.one-left q (gen q (u (inr tt))))) (h (u (inr tt))) ;
   suc m | ih -> \ u -> trans (EA.mulA' q Y (eprod q (suc m) (\ k -> gen q (u (inl k)))) (gen q (u (inr tt))))
    (trans (ap (\ t -> emul q t (gen q (u (inr tt)))) (ih (\ k -> u (inl k)))) (EA.mul-zero-l q (gen q (u (inr tt))))) } ;
  nonempty : (m : Nat) -> Not (Id Nat m zero) -> (u : Ps.Fin m -> MM.Vec q) ->
   Id (Ext q) (emul q Y (eprod q m (\ k -> gen q (u k)))) (ezero q) = split {
   zero -> \ ne u -> efq (ne (refl zero)) ;
   suc m -> \ ne u -> prod m u } ;
  module At (i : ExteriorCoordinates[l].Index q) (ec : Id Nat (BA.count q i) r) {
   cc : Id Nat (BA.count q (H.complement q i)) (suc d) =
    H.plus-cancel-left r (BA.count q (H.complement q i)) (suc d)
     (trans (ap (\ t -> plus t (BA.count q (H.complement q i))) (sym ec)) (trans (HO.count-complement q i) e)) ;
   ne : Not (Id Nat (BA.count q (H.complement q i)) zero) = \ e0 -> zero-suc d (trans (sym e0) cc) ;
   result : Id R (CO.coeff q Y i) z = HO.epsilon-cancel-zero q i (CO.coeff q Y i) (calc R {
    mul (HO.epsilon q i) (CO.coeff q Y i)
     =< sym (HO.coeff-star q Y i) > CO.coeff q (DU.star q Y) (H.complement q i)
     =< sym (CO.dot-basis q (DU.star q Y) (H.complement q i)) > DU.dot q (DU.star q Y) (CO.basis q (H.complement q i))
     =< DU.star-pair q Y (CO.basis q (H.complement q i)) > top q (emul q Y (CO.basis q (H.complement q i)))
     =< ap (\ t -> top q (emul q Y t)) (BA.basis-product q (H.complement q i)) >
    top q (emul q Y (eprod q (BA.count q (H.complement q i)) (\ k -> gen q (BA.select q (H.complement q i) k))))
     =< ap (top q) (nonempty (BA.count q (H.complement q i)) ne (BA.select q (H.complement q i))) > top q (ezero q)
     =< AD.top-zero q > z }) ;
  } ;
  coeff-zero (i : ExteriorCoordinates[l].Index q) : Plus (Id Nat (BA.count q i) r) (Not (Id Nat (BA.count q i) r)) -> Id R (CO.coeff q Y i) z = split {
   inl ec -> At[i,ec].result ;
   inr ne -> HO.coeff-support q r Y dY i ne } ;
  result : Id (Ext q) Y (ezero q) = CO.ext q Y (ezero q) (\ i -> trans (coeff-zero i (H.DecNat.dec (BA.count q i) r)) (sym (CO.coeff-zero q i))) ;
 } ;
 -- q = r + 1 + d: Ann(coker M) = 0
 module Pos (n q r d : Nat) (e : Id Nat q (plus r (suc d))) (M : MM.Mat n q)
  (st : MF.ImageVanish (suc r) n q M * MF.ImageRegular r n q M) (a : R) (ha : Ann n q M a) {
  snoc (C : MM.Mat r n) (c : MM.Vec n) : MM.Mat (suc r) n = split { inl k -> C k ; inr t -> c } ;
  module W (C : MM.Mat r n) {
   W : Ext q = MM.wedge r q (MK.compose r n q M C) ;
   -- an (r+1)-wedge of im M is 0
   high (c : MM.Vec n) : Id (Ext q) (emul q W (gen q (MM.apply n q M c))) (ezero q) =
    trans (sym (EA.escale-one q (MM.wedge (suc r) q (MK.compose (suc r) n q M (snoc C c))))) (st.1 (snoc C c)) ;
   kill-gen (v : MM.Vec q) : Id (Ext q) (emul q (escale q a W) (gen q v)) (ezero q) =
    TC.rec ((c : MM.Vec n) * Id (MM.Vec q) (\ j -> mul a (v j)) (MM.apply n q M c)) @l
     (Id (Ext q) (emul q (escale q a W) (gen q v)) (ezero q)) (EA.set q _ _)
     (\ w -> calc (Ext q) {
       emul q (escale q a W) (gen q v)
        =< EA.scale-mul-left q a W (gen q v) > escale q a (emul q W (gen q v))
        =< sym (EA.scale-mul-right q a W (gen q v)) > emul q W (escale q a (gen q v))
        =< ap (emul q W) (sym (EA.gen-scale q a v)) > emul q W (gen q (\ j -> mul a (v j)))
        =< ap (\ t -> emul q W (gen q t)) w.2 > emul q W (gen q (MM.apply n q M w.1))
        =< high w.1 > ezero q })
     (ha v) ;
   deg : DG.Deg q r (escale q a W) =
    HO.deg-scale q r a W (DG.deg-eprod q r (\ k -> gen q (MK.compose r n q M C k)) (\ k -> DG.deg-gen q (MK.compose r n q M C k))) ;
   kills : MK.KillsW q a W = Divides[q,r,d,e,escale q a W,deg,kill-gen].result ;
  } ;
  result : Id R a z = st.2 a (\ C -> W[C].kills) ;
 } ;

 ---------------------------------------------------------------------
 -- (c) r = q + 1 + d: 1 = 0
 neg-char (n q r d : Nat) (e : Id Nat r (plus q (suc d))) (M : MM.Mat n q) (reg : MF.ImageRegular r n q M) : Id R o z =
  Resolution[l].too-big (Rg,setR) r n q d e M reg ;
 Regular (a : R) : U l = (x : R) -> Id R (mul a x) z -> Id R x z ;
 trivial (t : Id R o z) (x : R) : Id R x z = trans (sym (L.one-left x)) (trans (ap (\ w -> mul w x) t) (L.zero-mul x)) ;

 ---------------------------------------------------------------------
 -- the alternating sums of a resolution R^p -> R^(s 0) -> ... -> R^(s k):
 -- (alt k).1 = s k + s (k-2) + ..., (alt k).2 = s (k-1) + s (k-3) + ...
 alt (p : Nat) (s : Nat -> Nat) : Nat -> Nat * Nat = split {
  zero -> (s zero,p) ;
  suc j | a -> (plus (s (suc j)) a.2,a.1) } ;
 -- the rank of the map into R^(s j)
 rho (p : Nat) (r : Nat -> Nat) : Nat -> Nat = split { zero -> p ; suc j -> r j } ;
 extra (p : Nat) (r : Nat -> Nat) : Nat -> Nat = split { zero -> zero ; suc j | x -> plus (rho p r j) x } ;
 plus-assoc : (a b c : Nat) -> Id Nat (plus (plus a b) c) (plus a (plus b c)) = split {
  zero -> \ b c -> refl (plus b c) ;
  suc a | ih -> \ b c -> ap (\ t -> suc t) (ih b c) } ;
 -- (a + b) + c = (a + c) + b
 plus-swap (a b c : Nat) : Id Nat (plus (plus a b) c) (plus (plus a c) b) =
  trans (plus-assoc a b c) (trans (ap (plus a) (plus-comm b c)) (sym (plus-assoc a c b))) ;
 module Res (p : Nat) (s : Nat -> Nat) (u : MM.Mat p (s zero)) (T : (i : Nat) -> MM.Mat (s i) (s (suc i)))
  (inj : MM.Injective p (s zero) u) {
  module RV = Resolutions[l].Over[Rg,setR] ;
  D0 : TrueGrade[l].RD = (Rg,setR) ;
  -- E = coker of the last map; Ann(E)
  AnnE (k : Nat) (a : R) : U l = Ann (RV.pdim p s k) (s k) (RV.pmap p s u T k) a ;
  -- the last map is stable of rank rho k
  top-stable : Resolution[l].Stable D0 p p (s zero) u =
   (MF.vanish-to-image (suc p) p (s zero) u (Minors[l].Over[Rg,setR].theorem24 p (s zero) u inj).1,
    MF.regular-to-image p p (s zero) u (Minors[l].Over[Rg,setR].theorem24 p (s zero) u inj).2) ;
  last-stable : (k : Nat) (r : Nat -> Nat) -> Resolution[l].Stables D0 k s r T ->
   Resolution[l].Stable D0 (rho p r k) (RV.pdim p s k) (s k) (RV.pmap p s u T k) = split {
   zero -> \ r sts -> top-stable ;
   suc j -> \ r sts -> sts j zero (sym (plus-zero (suc j))) } ;
  -- the alternating sums: (alt j).1 = s j + extra j, (alt j).2 = rho j + extra j
  module Sums (k : Nat) (r : Nat -> Nat) (rk : Resolution[l].Ranks k p s r) {
   Eqs (j : Nat) : U l = Id Nat (alt p s j).1 (plus (s j) (extra p r j)) * Id Nat (alt p s j).2 (plus (rho p r j) (extra p r j)) ;
   -- s j = r j + rho j below k
   below : (j e : Nat) -> Id Nat k (plus (suc j) e) -> Id Nat (s j) (plus (r j) (rho p r j)) = split {
    zero -> \ e en -> rk.1 e en ;
    suc i -> \ e en -> rk.2 i e en } ;
   step (j e : Nat) (en : Id Nat k (plus (suc j) e)) (ih : Eqs j) : Eqs (suc j) =
    (ap (plus (s (suc j))) ih.2,
     trans ih.1 (trans (ap (\ t -> plus t (extra p r j)) (below j e en)) (plus-assoc (r j) (rho p r j) (extra p r j)))) ;
   eqs : (j e : Nat) -> Id Nat k (plus j e) -> Eqs j = split {
    zero -> \ e en -> (sym (plus-zero (s zero)),sym (plus-zero p)) ;
    suc j | ih -> \ e en -> step j e en (ih (suc e) (trans en (sym (plus-suc j e)))) } ;
   at-k : Eqs k = eqs k zero (sym (plus-zero k)) ;
  } ;
  -- Theorem 2.6, for a resolution of length k
  module Thm26 (k : Nat) (pr : Resolution[l].Pairs D0 k p s u T) {
   n : Nat = RV.pdim p s k ;
   M : MM.Mat n (s k) = RV.pmap p s u T k ;
   ranks : Resolution[l].Result D0 k p s T = Resolution[l].ranks k D0 p s u T inj pr ;
   Wit : U l = (r : Nat -> Nat) * Resolution[l].Ranks k p s r * Resolution[l].Stables D0 k s r T ;
   module W (r : Nat -> Nat) (rk : Resolution[l].Ranks k p s r) (sts : Resolution[l].Stables D0 k s r T) {
    st : Resolution[l].Stable D0 (rho p r k) n (s k) M = last-stable k r sts ;
    eq1 : Id Nat (alt p s k).1 (plus (s k) (extra p r k)) = Sums[k,r,rk].at-k.1 ;
    eq2 : Id Nat (alt p s k).2 (plus (rho p r k) (extra p r k)) = Sums[k,r,rk].at-k.2 ;
    w-zero (hc : Id Nat (alt p s k).1 (alt p s k).2) (x : R) (hx : (a : R) -> AnnE k a -> Id R (mul a x) z) : Id R x z =
     Zero[n,s k,M,subst (\ t -> MF.ImageRegular t n (s k) M) (H.plus-cancel-right (rho p r k) (s k) (extra p r k) (trans (sym eq2) (trans (sym hc) eq1))) st.2,x,hx].result ;
    w-pos (c : Nat) (hc : Id Nat (alt p s k).1 (plus (alt p s k).2 (suc c))) (a : R) (ha : AnnE k a) : Id R a z =
     Pos[n,s k,rho p r k,c,
      H.plus-cancel-right (s k) (plus (rho p r k) (suc c)) (extra p r k)
       (trans (sym eq1) (trans hc (trans (ap (\ t -> plus t (suc c)) eq2) (plus-swap (rho p r k) (extra p r k) (suc c))))),
      M,st,a,ha].result ;
    w-neg (d : Nat) (hc : Id Nat (alt p s k).2 (plus (alt p s k).1 (suc d))) : Id R o z =
     neg-char n (s k) (rho p r k) d
      (H.plus-cancel-right (rho p r k) (plus (s k) (suc d)) (extra p r k)
       (trans (sym eq2) (trans hc (trans (ap (\ t -> plus t (suc d)) eq1) (plus-swap (s k) (extra p r k) (suc d))))))
      M st.2 ;
   } ;
   from-result (G : U l) (t : Id R o z -> G) (g : Wit -> G) : Resolution[l].Result D0 k p s T -> G = split {
    inl e -> t e ;
    inr w -> g w } ;
   -- Char(E) = 0: Ann(E) is regular
   char-zero (hc : Id Nat (alt p s k).1 (alt p s k).2) (x : R) (hx : (a : R) -> AnnE k a -> Id R (mul a x) z) : Id R x z =
    from-result (Id R x z) (\ e -> trivial e x) (\ w -> W[w.1,w.2.1,w.2.2].w-zero hc x hx) ranks ;
   -- Char(E) > 0: Ann(E) = 0
   char-pos (c : Nat) (hc : Id Nat (alt p s k).1 (plus (alt p s k).2 (suc c))) (a : R) (ha : AnnE k a) : Id R a z =
    from-result (Id R a z) (\ e -> trivial e a) (\ w -> W[w.1,w.2.1,w.2.2].w-pos c hc a ha) ranks ;
   -- Char(E) < 0: R is trivial
   char-neg (d : Nat) (hc : Id Nat (alt p s k).2 (plus (alt p s k).1 (suc d))) : Id R o z =
    from-result (Id R o z) (\ e -> e) (\ w -> W[w.1,w.2.1,w.2.2].w-neg d hc) ranks ;
  } ;
  ---------------------------------------------------------------------
  -- Corollary 2.7: if Ann(E) = (a) (E = R/(a), see Cyclic), then a = 0 or
  -- a is regular
  module Cor27 (k : Nat) (pr : Resolution[l].Pairs D0 k p s u T) (a : R) (h1 : AnnE k a)
   (h2 : (b : R) -> AnnE k b -> Tr.Trunc[(t : R) * Id R b (mul t a)].carrier) {
   module TH = Thm26[k,pr] ;
   reg (hc : Id Nat (alt p s k).1 (alt p s k).2) : Regular a = \ x hx -> TH.char-zero hc x (\ b hb ->
    TC.rec ((t : R) * Id R b (mul t a)) @l (Id R (mul b x) z) (setR _ _)
     (\ w -> calc R {
       mul b x =< ap (\ v -> mul v x) w.2 > mul (mul w.1 a) x
        =< sym (mulA w.1 a x) > mul w.1 (mul a x)
        =< ap (mul w.1) hx > mul w.1 z
        =< L.mul-zero w.1 > z })
     (h2 b hb)) ;
   by-r : (r : Nat) -> Id Nat (alt p s k).1 (plus (alt p s k).2 r) -> Plus (Id R a z) (Regular a) = split {
    zero -> \ e -> inr (reg (trans e (plus-zero (alt p s k).2))) ;
    suc c -> \ e -> inl (TH.char-pos c e a h1) } ;
   pick : Plus ((r : Nat) * Id Nat (alt p s k).1 (plus (alt p s k).2 r)) ((d : Nat) * Id Nat (alt p s k).2 (plus (alt p s k).1 (suc d))) ->
    Plus (Id R a z) (Regular a) = split {
    inl w -> by-r w.1 w.2 ;
    inr w -> inl (trivial (TH.char-neg w.1 w.2) a) } ;
   result : Plus (Id R a z) (Regular a) = pick (Resolution[l].compare (alt p s k).2 (alt p s k).1) ;
  } ;
 } ;

 ---------------------------------------------------------------------
 -- E = coker M = R/(a) for one row M with entries generating (a): Ann(E) = (a)
 module Cyclic (n : Nat) (M : MM.Mat n (suc zero)) (a : R)
  (gens : (i : Ps.Fin n) -> Tr.Trunc[(t : R) * Id R (M i (inr tt)) (mul t a)].carrier)
  (a-in : Tr.Trunc[(c : MM.Vec n) * Id R a (MM.apply n (suc zero) M c (inr tt))].carrier) {
  at-top (f g : MM.Vec (suc zero)) (h : Id R (f (inr tt)) (g (inr tt))) : (t : Top) -> Id R (f (inr t)) (g (inr t)) = split {
   tt -> h } ;
  at-one (f g : MM.Vec (suc zero)) (h : Id R (f (inr tt)) (g (inr tt))) : (j : Ps.Fin (suc zero)) -> Id R (f j) (g j) = split {
   inl e -> efq e ;
   inr t -> at-top f g h t } ;
  one-eq (f g : MM.Vec (suc zero)) (h : Id R (f (inr tt)) (g (inr tt))) : Id (MM.Vec (suc zero)) f g =
   F.funext (Ps.Fin (suc zero)) (\ j -> R) f g (at-one f g h) ;
  ann-a : Ann n (suc zero) M a = \ y ->
   TC.map ((c : MM.Vec n) * Id R a (MM.apply n (suc zero) M c (inr tt)))
    ((C : MM.Vec n) * Id (MM.Vec (suc zero)) (\ j -> mul a (y j)) (MM.apply n (suc zero) M C))
    (\ w -> (\ k -> mul (y (inr tt)) (w.1 k),
      one-eq (\ j -> mul a (y j)) (MM.apply n (suc zero) M (\ k -> mul (y (inr tt)) (w.1 k))) (calc R {
       mul a (y (inr tt)) =< ap (\ v -> mul v (y (inr tt))) w.2 > mul (MM.apply n (suc zero) M w.1 (inr tt)) (y (inr tt))
        =< mulC (MM.apply n (suc zero) M w.1 (inr tt)) (y (inr tt)) > mul (y (inr tt)) (MM.apply n (suc zero) M w.1 (inr tt))
        =< sym (MM.apply-scale n (suc zero) M (y (inr tt)) w.1 (inr tt)) > MM.apply n (suc zero) M (\ k -> mul (y (inr tt)) (w.1 k)) (inr tt) })))
    a-in ;
  module In (b : R) (C : MM.Vec n) (hC : Id (MM.Vec (suc zero)) (\ j -> mul b o) (MM.apply n (suc zero) M C))
   (ts : (i : Ps.Fin n) -> (t : R) * Id R (M i (inr tt)) (mul t a)) {
   result : Id R b (mul (S.sum n (\ k -> mul (C k) (ts k).1)) a) = calc R {
    b =< sym (mulO b) > mul b o
     =< ap (\ f -> f (inr tt)) hC > S.sum n (\ k -> mul (C k) (M k (inr tt)))
     =< S.sum-cong n (\ k -> mul (C k) (M k (inr tt))) (\ k -> mul (mul (C k) (ts k).1) a)
       (\ k -> trans (ap (mul (C k)) (ts k).2) (mulA (C k) (ts k).1 a)) >
    S.sum n (\ k -> mul (mul (C k) (ts k).1) a)
     =< D.sum-scale-right a n (\ k -> mul (C k) (ts k).1) > mul (S.sum n (\ k -> mul (C k) (ts k).1)) a } ;
  } ;
  ann-in (b : R) (hb : Ann n (suc zero) M b) : Tr.Trunc[(t : R) * Id R b (mul t a)].carrier =
   TC.bind ((C : MM.Vec n) * Id (MM.Vec (suc zero)) (\ j -> mul b o) (MM.apply n (suc zero) M C)) ((t : R) * Id R b (mul t a))
    (\ w -> TC.map ((i : Ps.Fin n) -> (t : R) * Id R (M i (inr tt)) (mul t a)) ((t : R) * Id R b (mul t a))
      (\ ts -> (S.sum n (\ k -> mul (w.1 k) (ts k).1),In[b,w.1,w.2,ts].result))
      (Products[l].fin-choice n (\ i -> (t : R) * Id R (M i (inr tt)) (mul t a)) gens))
    (hb (\ j -> o)) ;
 } ;
} ;
