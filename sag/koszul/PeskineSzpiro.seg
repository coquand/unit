-- cffr Theorem 7.3 (Peskine-Szpiro): a complex
--   0 -> C_n -> ... -> C_1 -> C_0   (d k : C_(k+1) -> C_k, d n = 0)
-- with Gr(a; C_j) >= j and a H_j = 0 for j = 1, ..., n is exact at
-- C_1, ..., C_n.
--
-- B_j = im (d j) (in C_j), Z_j = ker (d (j-1)), H_j = Z_j / B_j.
-- Descending induction on j: Gr(a; B_j) >= j + 1.  For j = n, B_n = 0
-- (a zero module has every grade).  If Gr(a; B_j) >= j + 1, j >= 1:
-- Z_j is a submodule of C_j, Gr(a; C_j) >= 1, so a is Z_j-regular;
-- Lemma 6.2 on 0 -> B_j -> Z_j -> H_j -> 0 gives Gr(a; H_j) >= 1, and
-- a H_j = 0, so H_j = 0: the complex is exact at C_j.  Then
-- 0 -> B_j -> C_j -> B_(j-1) -> 0 is exact, and Lemma 6.2 with
-- Gr(a; C_j) >= j gives Gr(a; B_(j-1)) >= j.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Bj = Bijection[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module QM = QuotientModule[l].Over[MO.ring] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module G1 = GradeOne[l].Over[Rg,setR] ;
 module RS = Resolutions[l].Over[Rg,setR] ;

 ---------------------------------------------------------------------
 -- a module whose elements are all 0 has every grade
 module ZeroGrade (X : MO.Module) (hx : (x : X.M) -> Id X.M x X.mz) (N : Nat) (a : Ps.Fin N -> R) {
  module KZ = Koszul[l].Over[Rg,setR,X] ;
  module KA = KZ.K[N,a] ;
  module CK = GR.CX.Cx[KA.complex] ;
  all-zero (k : Nat) (u : CK.M k) : Id (CK.M k) u (CK.o k) =
   KZ.Deg[N,k].S.eq u (CK.o k) (KZ.CF.veq N u.1 (KZ.CF.V N).mz (\ I -> hx (u.1 I))) ;
  vanish : (k : Nat) -> CK.Vanish k = split {
   zero -> \ u c -> all-zero zero u ;
   suc j -> \ u c -> Tr.Trunc[Bj.Fibre (CK.d j) u].inc (CK.o j,
    trans (SM.Lin[KA.Ck j,KA.Ck (suc j),KA.d j].map-z) (sym (all-zero (suc j) u))) } ;
  upto : (k : Nat) -> CK.Upto k = split {
   zero -> tt ;
   suc k | r -> (r,vanish k) } ;
 } ;

 ---------------------------------------------------------------------
 module PS (C : Nat -> MO.Module) (d : (k : Nat) -> SM.Linear (C (suc k)) (C k))
  (dd : (k : Nat) (x : (C (suc (suc k))).M) -> Id (C k).M ((d k).1 ((d (suc k)).1 x)) (C k).mz)
  (n : Nat) (top : (x : (C (suc n)).M) -> Id (C n).M ((d n).1 x) (C n).mz) (N : Nat) (a : Ps.Fin N -> R)
  (gr : (k e : Nat) -> Id Nat n (plus (suc k) e) -> GR.Gr (C (suc k)) N a (suc k))
  (ann : (k e : Nat) -> Id Nat n (plus (suc k) e) -> (x : (C (suc k)).M) -> Id (C k).M ((d k).1 x) (C k).mz ->
   (i : Ps.Fin N) -> Tr.Trunc[Bj.Fibre (d (suc k)).1 ((C (suc k)).sm (a i) x)].carrier) {
  -- B_j
  module Bm (j : Nat) { module I = SM.Image[C (suc j),C j,d j] ; } ;
  B (j : Nat) : MO.Module = Bm[j].I.I.carrier ;
  -- one step, at C_(k+1)
  module Step (k e : Nat) (en : Id Nat n (plus (suc k) e)) (inv : GR.Gr (B (suc k)) N a (suc (suc k))) {
   module IB = Bm[suc k].I ;
   module KZ = SM.Kernel[C (suc k),C k,d k] ;
   module Z = SM.Sub[C (suc k),KZ.sub] ;
   module MC = A7.MA[MO.ring,C (suc k)] ;
   -- B_(k+1) in Z_(k+1)
   incl-map (b : IB.I.E) : Z.E = (b.1,TC.rec (IB.Fib b.1) @l (Id (C k).M ((d k).1 b.1) (C k).mz) ((C k).setM _ _)
     (\ w -> trans (ap (d k).1 (sym w.2)) (dd k w.1)) b.2) ;
   incl : SM.Linear (B (suc k)) Z.carrier = (incl-map,\ b b' -> Z.eq _ _ (refl ((C (suc k)).madd b.1 b'.1)),\ c b -> Z.eq _ _ (refl ((C (suc k)).sm c b.1))) ;
   incl-inj : Bj.Injective incl-map = \ b b' h -> IB.I.eq b b' (ap (\ t -> t.1) h) ;
   module IZ = SM.Image[B (suc k),Z.carrier,incl] ;
   module H = QM.Quot[Z.carrier,IZ.sub] ;
   -- Z_(k+1) is regular: a sub of C_(k+1), Gr(a; C_(k+1)) >= 1
   one-eq : Id Nat (suc k) (plus k (suc zero)) = sym (trans (plus-suc k zero) (ap (\ m -> suc m) (plus-zero k))) ;
   grC1 : GR.Gr (C (suc k)) N a (suc zero) =
    RS.down (C (suc k)) N a k (suc zero) (subst {Nat} (\ m -> GR.Gr (C (suc k)) N a m) one-eq (gr k e en)) ;
   regC : G1.Item1[C (suc k),N,a].Regular = G1.Item1[C (suc k),N,a].forward grC1 ;
   grZ : GR.Gr Z.carrier N a (suc zero) = G1.Item1[Z.carrier,N,a].back (\ zz t h -> Z.eq zz (Z.carrier).mz (regC zz.1 tt (\ i -> ap (\ w -> w.1) (h i)))) ;
   -- Gr(a; H_(k+1)) >= 1
   module S1 = GR.SesGrade[B (suc k),Z.carrier,H.carrier,incl,H.projection,incl-inj,
    \ b -> H.in-kernel (incl-map b) (Tr.Trunc[IZ.Fib (incl-map b)].inc (b,refl (incl-map b))),
    \ zz h -> H.kernel zz h,H.surjective,N,a] ;
   two-eq : Id Nat (suc (suc k)) (plus k (suc (suc zero))) = sym (trans (plus-suc k (suc zero)) (ap (\ m -> suc m) (sym one-eq))) ;
   grH : GR.Gr H.carrier N a (suc zero) =
    S1.lemma62 (suc zero) (RS.down (B (suc k)) N a k (suc (suc zero)) (subst {Nat} (\ m -> GR.Gr (B (suc k)) N a m) two-eq inv)) grZ ;
   -- a H = 0, so H = 0: exactness at C_(k+1)
   module Exact (x : (C (suc k)).M) (zx : Id (C k).M ((d k).1 x) (C k).mz) {
    z : Z.E = (x,zx) ;
    killed (i : Ps.Fin N) : Id H.C (H.scale (a i) (H.inc z)) (H.inc (Z.carrier).mz) =
     trans (H.Scale[a i].D.beta z) (H.in-kernel ((Z.carrier).sm (a i) z)
      (TC.map (Bj.Fibre (d (suc k)).1 ((C (suc k)).sm (a i) x)) (IZ.Fib ((Z.carrier).sm (a i) z))
       (\ w -> (((d (suc k)).1 w.1,Tr.Trunc[IB.Fib ((d (suc k)).1 w.1)].inc (w.1,refl ((d (suc k)).1 w.1))),Z.eq _ _ w.2))
       (ann k e en x zx i))) ;
    zero-cls : Id H.C (H.inc z) (H.inc (Z.carrier).mz) = G1.Item1[H.carrier,N,a].forward grH (H.inc z) tt killed ;
    result : Tr.Trunc[Bj.Fibre (d (suc k)).1 x].carrier =
     TC.bind (IZ.Fib z) (Bj.Fibre (d (suc k)).1 x) (\ w -> TC.map (IB.Fib w.1.1) (Bj.Fibre (d (suc k)).1 x)
       (\ v -> (v.1,trans v.2 (ap (\ t -> t.1) w.2))) w.1.2) (H.kernel z zero-cls) ;
   } ;
   -- 0 -> B_(k+1) -> C_(k+1) -> B_k -> 0
   module IK = Bm[k].I ;
   iota : SM.Linear (B (suc k)) (C (suc k)) = (\ b -> b.1,\ b b' -> refl ((C (suc k)).madd b.1 b'.1),\ c b -> refl ((C (suc k)).sm c b.1)) ;
   module S2 = GR.SesGrade[B (suc k),C (suc k),B k,iota,IK.onto,
    \ b b' h -> IB.I.eq b b' h,
    \ b -> IK.kernel-onto b.1 (incl-map b).2,
    \ y h -> Tr.Trunc[Bj.Fibre iota.1 y].inc ((y,Exact[y,IK.onto-kernel y h].result),refl y),
    IK.onto-surjective,N,a] ;
   next : GR.Gr (B k) N a (suc k) = S2.lemma62 (suc k) inv (gr k e en) ;
  } ;
  -- descending induction: Gr(a; B_j) >= j + 1
  Inv (e : Nat) : U l = (j : Nat) -> Id Nat n (plus j e) -> GR.Gr (B j) N a (suc j) ;
  module Top (j : Nat) (en : Id Nat n (plus j zero)) {
   jn : Id Nat n j = trans en (plus-zero j) ;
   top-j : (x : (C (suc j)).M) -> Id (C j).M ((d j).1 x) (C j).mz =
    subst {Nat} (\ m -> (x : (C (suc m)).M) -> Id (C m).M ((d m).1 x) (C m).mz) jn top ;
   zero (b : Bm[j].I.I.E) : Id Bm[j].I.I.E b (B j).mz = Bm[j].I.I.eq b (B j).mz
    (TC.rec (Bm[j].I.Fib b.1) @l (Id (C j).M b.1 (C j).mz) ((C j).setM _ _) (\ w -> trans (sym w.2) (top-j w.1)) b.2) ;
   result : GR.Gr (B j) N a (suc j) = ZeroGrade[B j,zero,N,a].upto (suc j) ;
  } ;
  inv-all : (e : Nat) -> Inv e = split {
   zero -> \ j en -> Top[j,en].result ;
   suc e | r -> \ j en -> Step[j,e,trans en (plus-suc j e),r (suc j) (trans en (plus-suc j e))].next } ;
  -- Theorem 7.3: exact at C_(k+1) for k + 1 <= n
  exact (k e : Nat) (en : Id Nat n (plus (suc k) e)) (x : (C (suc k)).M) (zx : Id (C k).M ((d k).1 x) (C k).mz) :
   Tr.Trunc[Bj.Fibre (d (suc k)).1 x].carrier = Step[k,e,en,inv-all e (suc k) en].Exact[x,zx].result ;
 } ;
} ;
