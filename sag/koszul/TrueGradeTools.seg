-- Moving regular sequences between the rings of the true grade.
--
-- (Towers) q indeterminates over ext p D is ext (q + p) D, with the
-- composite inclusion (tower-eq, by induction on q); so a sequence found
-- after q more indeterminates over ext p D witnesses the grade over D
-- (tower).
-- (Up) Along R -> R[X] (constants): regular elements mod J stay regular
-- mod J (cffr/PolyRegularMod.element-up), so regular sequences mod J stay
-- regular sequences mod J (the list (J, a) of constants is the constant
-- list of (J, a), pointwise); membership in an ideal generated by a list is
-- kept (a ring map keeps linear combinations).  Iterated along ext p.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module TG = TrueGrade[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

---------------------------------------------------------------------
-- towers
Pair (D : TG.RD) : U l+ = (D' : TG.RD) * (D.1.R -> D'.1.R) ;
step (D : TG.RD) (P : Pair D) : Pair D = (TG.ext1 P.1,\ x -> TG.PolyX[P.1].X.inclusion.1 (P.2 x)) ;
tower-eq (D : TG.RD) (p : Nat) : (q : Nat) ->
 Id (Pair D) (TG.ext q (TG.ext p D),\ x -> (TG.incl q (TG.ext p D)).1 ((TG.incl p D).1 x)) (TG.ext (plus q p) D,(TG.incl (plus q p) D).1) = split {
 zero -> refl (TG.ext p D,(TG.incl p D).1) ;
 suc q | r -> Ring[l+].ap (step D) r } ;
-- a sequence over a ring with a map from D
Phi (D : TG.RD) (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (P : Pair D) : U l =
 (a : Ps.Fin k -> P.1.1.R) * TG.InSeq P.1 n (\ i -> P.2 (I i)) k a * TG.RegSeq P.1 k m (\ i -> P.2 (J i)) a ;
tower (k : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (p : Nat)
 (g : TG.TGr k (TG.ext p D) m (TG.img p D m J) n (TG.img p D n I)) : TG.TGr k D m J n I =
 TC.map ((q : Nat) * TG.Seq (TG.ext p D) k m (TG.img p D m J) n (TG.img p D n I) q) ((q : Nat) * TG.Seq D k m J n I q)
  (\ w -> (plus w.1 p,idJ (Pair D) (TG.ext w.1 (TG.ext p D),\ x -> (TG.incl w.1 (TG.ext p D)).1 ((TG.incl p D).1 x))
   (\ P e -> Phi D k m J n I P) w.2 (TG.ext (plus w.1 p) D,(TG.incl (plus w.1 p) D).1) (tower-eq D p w.1))) g ;

---------------------------------------------------------------------
-- lists
map-snoc (X A B : U l) (f : A -> B) (J : X -> A) (c : A) : (i : Plus X Top) -> Id B (f (Ps.snoc X A J c i)) (Ps.snoc X B (\ j -> f (J j)) (f c) i) = split {
 inl x -> refl (f (J x)) ; inr t -> refl (f c) } ;
-- regular sequences depend on the list pointwise
regseq-list (D : TG.RD) (k m : Nat) (L L' : Ps.Fin m -> D.1.R) (h : (i : Ps.Fin m) -> Id D.1.R (L i) (L' i)) (a : Ps.Fin k -> D.1.R)
 (s : TG.RegSeq D k m L a) : TG.RegSeq D k m L' a =
 subst (\ K -> TG.RegSeq D k m K a) (F.funext (Ps.Fin m) (\ i -> D.1.R) L L' h) s ;

---------------------------------------------------------------------
-- up one indeterminate
module Up1 (D : TG.RD) {
 module X = TG.PolyX[D].X ;
 c (x : D.1.R) : X.Carrier = X.constant x ;
 el (m : Nat) (J : Ps.Fin m -> D.1.R) (b : D.1.R) (r : TG.RegEl D m J b) : TG.RegEl (TG.ext1 D) m (\ i -> c (J i)) (c b) =
  PolyRegularMod[l].Over[D.1,D.2,m,J].element-up b r ;
 seq : (k m : Nat) (J : Ps.Fin m -> D.1.R) (a : Ps.Fin k -> D.1.R) -> TG.RegSeq D k m J a ->
  TG.RegSeq (TG.ext1 D) k m (\ i -> c (J i)) (\ i -> c (a i)) = split {
  zero -> \ m J a h -> tt ;
  suc k | r -> \ m J a h -> (el m J (a (inr tt)) h.1,
   regseq-list (TG.ext1 D) k (suc m) (\ i -> c (TG.extend D m J (a (inr tt)) i)) (TG.extend (TG.ext1 D) m (\ i -> c (J i)) (c (a (inr tt))))
    (map-snoc (Ps.Fin m) D.1.R X.Carrier c J (a (inr tt))) (\ i -> c (a (inl i)))
    (r (suc m) (TG.extend D m J (a (inr tt))) (\ i -> a (inl i)) h.2)) } ;
 module SM = StandardOpens[l].SumMap[D.1,X.ring,X.inclusion] ;
 inI (n : Nat) (I : Ps.Fin n -> D.1.R) (x : D.1.R) (h : TG.InI D n I x) : TG.InI (TG.ext1 D) n (\ i -> c (I i)) (c x) =
  TC.map (FiniteIdeal[l].Sums[D.1].Coordinates n I x) (FiniteIdeal[l].Sums[X.ring].Coordinates n (\ i -> c (I i)) (c x))
   (\ v -> (\ i -> c (v.1 i),trans (sym (SM.combination n I v.1)) (ap c v.2))) h ;
} ;
-- up p indeterminates
up-seq : (p : Nat) (D : TG.RD) (k m : Nat) (J : Ps.Fin m -> D.1.R) (a : Ps.Fin k -> D.1.R) -> TG.RegSeq D k m J a ->
 TG.RegSeq (TG.ext p D) k m (TG.img p D m J) (\ i -> (TG.incl p D).1 (a i)) = split {
 zero -> \ D k m J a h -> h ;
 suc p | r -> \ D k m J a h -> Up1[TG.ext p D].seq k m (TG.img p D m J) (\ i -> (TG.incl p D).1 (a i)) (r D k m J a h) } ;
up-el : (p : Nat) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (b : D.1.R) -> TG.RegEl D m J b ->
 TG.RegEl (TG.ext p D) m (TG.img p D m J) ((TG.incl p D).1 b) = split {
 zero -> \ D m J b h -> h ;
 suc p | r -> \ D m J b h -> Up1[TG.ext p D].el m (TG.img p D m J) ((TG.incl p D).1 b) (r D m J b h) } ;
up-in : (p : Nat) (D : TG.RD) (n : Nat) (I : Ps.Fin n -> D.1.R) (x : D.1.R) -> TG.InI D n I x ->
 TG.InI (TG.ext p D) n (TG.img p D n I) ((TG.incl p D).1 x) = split {
 zero -> \ D n I x h -> h ;
 suc p | r -> \ D n I x h -> Up1[TG.ext p D].inI n (TG.img p D n I) ((TG.incl p D).1 x) (r D n I x h) } ;
