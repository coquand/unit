-- Grade (cffr §6): Gr(a; E) >= k iff H^i(a; E) = 0 for i < k (Upto k of
-- the Koszul complex).  Gr(a; E) >= k + 1 contains Gr(a; E) >= k (.1).
--
-- Lemmas 6.2 and 6.3: a short exact sequence of modules gives one of
-- Koszul complexes (KoszulExact), and VanishLES.lemma62 / lemma63 apply.
--
-- Multiplication by x = b . a is zero on H(a; E) (Lemma 6.1, MultZero):
-- the complex map induced by x . : E -> E is u |-> x u, which is a
-- coboundary on cocycles.
--
-- Lemma 6.5: if x = b . a is E-regular, 0 -> E -x-> E -> E/xE -> 0 is
-- exact (E/xE is QuotientModule by the image of x .), so
--   Gr(a; E) >= k + 1 gives Gr(a; E/xE) >= k (Lemma 6.2, with
--   Gr(a; E) >= k), and
--   Gr(a; E/xE) >= k gives Gr(a; E) >= k + 1 (VanishLES.lemma-zero: the
--   first map is zero on cohomology).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module Bj = Bijection[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module SM = Submodules[l].Over[MO.ring] ;
 module CX = Complexes[l].Over[MO.ring] ;
 module KX = KoszulExact[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 -- Gr(a; E) >= k
 Gr (E : MO.Module) (n : Nat) (a : Ps.Fin n -> R) (k : Nat) : U l = CX.Cx[Koszul[l].Over[Rg,setR,E].K[n,a].complex].Upto k ;

 -- Lemmas 6.2 and 6.3
 module SesGrade (E F G : MO.Module) (i : SM.Linear E F) (p : SM.Linear F G)
  (inj : Bj.Injective i.1) (pi : (x : E.M) -> Id G.M (p.1 (i.1 x)) G.mz)
  (ex : (y : F.M) -> Id G.M (p.1 y) G.mz -> Tr.Trunc[Bj.Fibre i.1 y].carrier)
  (onto : (z : G.M) -> Tr.Trunc[Bj.Fibre p.1 z].carrier) (n : Nat) (a : Ps.Fin n -> R) {
  module S = KX.Ses[E,F,G,i,p,inj,pi,ex,onto,n,a] ;
  module L = VanishLES[l].Over[MO.ring].LES[S.FI.LE.complex,S.FI.LF.complex,S.FP.LF.complex,S.ses] ;
  lemma62 (k : Nat) (gE : Gr E n a (suc k)) (gF : Gr F n a k) : Gr G n a k = L.lemma62 k gE gF ;
  lemma63 (k : Nat) (gF : Gr F n a (suc k)) (gG : Gr G n a k) : Gr E n a (suc k) = L.lemma63 k gF gG ;
 } ;

 -- multiplication by x
 mult (E : MO.Module) (x : R) : SM.Linear E E = (E.sm x,E.smD x,\ c u -> A7.MA[MO.ring,E].sm-swap x c u) ;
 -- Lemma 6.1 as: x = b . a is zero on H(a; E)
 module MultZero (E : MO.Module) (n : Nat) (a b : AL.Vec n) {
  module H = KoszulHomotopy[l].Over[Rg,setR].WithE[E,n,a,b] ;
  module FX = KX.Fun[E,E,mult E H.s,n,a] ;
  module CK = CX.Cx[FX.LE.complex] ;
  module MI = CX.MapL[FX.LE.complex,FX.LE.complex,FX.map] ;
  zero (k : Nat) (z : CK.M k) (c : CK.Cocycle k z) : CK.Bnd k (MI.app k z) = H.kills k z c ;
 } ;

 -- Lemma 6.5
 module Lemma65 (E : MO.Module) (n : Nat) (a b : AL.Vec n)
  (reg : (u : E.M) -> Id E.M (E.sm (ExteriorVectorContraction[l].Over[Rg,setR].vdot n b a) u) E.mz -> Id E.M u E.mz) {
  module MZ = MultZero[E,n,a,b] ;
  x : R = MZ.H.s ;
  module ME = A7.MA[MO.ring,E] ;
  module IM = SM.Image[E,E,mult E x] ;
  module Q = QuotientModule[l].Over[MO.ring].Quot[E,IM.sub] ;
  -- E/xE
  EQ : MO.Module = Q.carrier ;
  inj : Bj.Injective (mult E x).1 = \ u v h -> ME.sub-zero u v (reg (ME.sub u v)
   (trans (ME.sm-sub x u v) (trans (ap (\ t -> ME.sub t (E.sm x v)) h) (ME.sub-self (E.sm x v))))) ;
  pi (e : E.M) : Id EQ.M (Q.projection.1 (E.sm x e)) EQ.mz = Q.in-kernel (E.sm x e) (Tr.Trunc[IM.Fib (E.sm x e)].inc (e,refl (E.sm x e))) ;
  module SG = SesGrade[E,E,EQ,mult E x,Q.projection,inj,pi,\ y h -> Q.kernel y h,Q.surjective,n,a] ;
  forward (k : Nat) (gE : Gr E n a (suc k)) : Gr EQ n a k = SG.lemma62 k gE gE.1 ;
  back (k : Nat) (gQ : Gr EQ n a k) : Gr E n a (suc k) = SG.L.lemma-zero MZ.zero k gQ ;
 } ;
} ;
