-- The true grade is invariant under ring isomorphisms, and polynomial maps
-- send Kronecker polynomials to Kronecker polynomials.
--
-- An isomorphism S ~ S' gives ext p S ~ ext p S' (iso-ext1, p times),
-- sending incl_p x to incl_p (h x) (ext-compat); isomorphisms preserve
-- regularity (TrueGradeBase.iso-pres) and membership, so a witness of
-- Gr(I) >= k mod J over S gives one of Gr(h I) >= k mod h J over S'.
-- For h : A -> B, A[X] -> B[X] sends kron(a) to kron(h a): by Horner,
-- kron(a) = a_n + X kron(a'), and the map is a ring map fixing X.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ; module TB = TrueGradeBase[l] ;

ext-iso : (p : Nat) (S S' : TG.RD) (i : TB.Iso S S') -> TB.Iso (TG.ext p S) (TG.ext p S') = split {
 zero -> \ S S' i -> i ;
 suc p | r -> \ S S' i -> TB.iso-ext1 (TG.ext p S) (TG.ext p S') (r S S' i) } ;
ext-compat : (p : Nat) (S S' : TG.RD) (i : TB.Iso S S') (x : S.1.R) ->
 Id (TG.ext p S').1.R ((ext-iso p S S' i).1.1 ((TG.incl p S).1 x)) ((TG.incl p S').1 (i.1.1 x)) = split {
 zero -> \ S S' i x -> refl (i.1.1 x) ;
 suc p | r -> \ S S' i x -> trans (TB.Map1[TG.ext p S,TG.ext p S',(ext-iso p S S' i).1].on-c ((TG.incl p S).1 x))
  (ap TG.PolyX[TG.ext p S'].X.constant (r S S' i x)) } ;
module IsoSeq (S S' : TG.RD) (i : TB.Iso S S') (k m : Nat) (J : Ps.Fin m -> S.1.R) (n : Nat) (I : Ps.Fin n -> S.1.R) (p : Nat)
 (w : TG.Seq S k m J n I p) {
 E : TB.Iso (TG.ext p S) (TG.ext p S') = ext-iso p S S' i ;
 on-img (M : Nat) (L : Ps.Fin M -> S.1.R) (j : Ps.Fin M) : Id (TG.ext p S').1.R (E.1.1 (TG.img p S M L j)) (TG.img p S' M (\ t -> i.1.1 (L t)) j) =
  ext-compat p S S' i (L j) ;
 result : TG.Seq S' k m (\ t -> i.1.1 (J t)) n (\ t -> i.1.1 (I t)) p =
  (\ j -> E.1.1 (w.1 j),
   \ j -> TB.ini-list (TG.ext p S') n (\ t -> E.1.1 (TG.img p S n I t)) (TG.img p S' n (\ t -> i.1.1 (I t))) (on-img n I) (E.1.1 (w.1 j))
    (TB.hom-in (TG.ext p S) (TG.ext p S') E.1 n (TG.img p S n I) (w.1 j) (w.2.1 j)),
   TT.regseq-list (TG.ext p S') k m (\ t -> E.1.1 (TG.img p S m J t)) (TG.img p S' m (\ t -> i.1.1 (J t))) (on-img m J) (\ j -> E.1.1 (w.1 j))
    (TB.preserves-seq (TG.ext p S) (TG.ext p S') E.1 (TB.iso-pres (TG.ext p S) (TG.ext p S') E) k m (TG.img p S m J) w.1 w.2.2)) ;
} ;
tgr-iso (S S' : TG.RD) (i : TB.Iso S S') (k m : Nat) (J : Ps.Fin m -> S.1.R) (n : Nat) (I : Ps.Fin n -> S.1.R)
 (g : TG.TGr k S m J n I) : TG.TGr k S' m (\ t -> i.1.1 (J t)) n (\ t -> i.1.1 (I t)) =
 TC.map ((p : Nat) * TG.Seq S k m J n I p) ((p : Nat) * TG.Seq S' k m (\ t -> i.1.1 (J t)) n (\ t -> i.1.1 (I t)) p)
  (\ w -> (w.1,IsoSeq[S,S',i,k,m,J,n,I,w.1,w.2].result)) g ;

-- polynomial maps on Kronecker polynomials
module MapKron (A B : TG.RD) (h : RH.Hom A.1 B.1) {
 module M = TB.Map1[A,B,h] ;
 module XA = TG.PolyX[A].X ; module XB = TG.PolyX[B].X ;
 kron-a (n : Nat) (a : Ps.Fin n -> A.1.R) : Poly[l].PolyR[A.1].P = PolyRegular[l].Over[A.1,A.2].kron n a ;
 kron-b (n : Nat) (b : Ps.Fin n -> B.1.R) : Poly[l].PolyR[B.1].P = PolyRegular[l].Over[B.1,B.2].kron n b ;
 -- one Horner step, on lists
 horner-map (u : A.1.R) (p : Poly[l].PolyR[A.1].P) (p' : Poly[l].PolyR[B.1].P) (e : Id (TG.ext1 B).1.R (M.map.1 (XA.include p)) (XB.include p')) :
  Id (TG.ext1 B).1.R (M.map.1 (XA.include (cons u p))) (XB.include (cons (h.1 u) p')) = calc (TG.ext1 B).1.R {
   M.map.1 (XA.include (cons u p))
    =< ap M.map.1 (XA.horner u p) > M.map.1 (XA.addQ (XA.constant u) (XA.mulQ XA.variable (XA.include p)))
    =< M.map.2.2.1 (XA.constant u) (XA.mulQ XA.variable (XA.include p)) >
   XB.addQ (M.map.1 (XA.constant u)) (M.map.1 (XA.mulQ XA.variable (XA.include p)))
    =< ap (XB.addQ (M.map.1 (XA.constant u))) (M.map.2.2.2 XA.variable (XA.include p)) >
   XB.addQ (M.map.1 (XA.constant u)) (XB.mulQ (M.map.1 XA.variable) (M.map.1 (XA.include p)))
    =< ap (\ t -> XB.addQ t (XB.mulQ (M.map.1 XA.variable) (M.map.1 (XA.include p)))) (M.on-c u) >
   XB.addQ (XB.constant (h.1 u)) (XB.mulQ (M.map.1 XA.variable) (M.map.1 (XA.include p)))
    =< ap (\ t -> XB.addQ (XB.constant (h.1 u)) (XB.mulQ t (M.map.1 (XA.include p)))) M.on-x >
   XB.addQ (XB.constant (h.1 u)) (XB.mulQ XB.variable (M.map.1 (XA.include p)))
    =< ap (\ t -> XB.addQ (XB.constant (h.1 u)) (XB.mulQ XB.variable t)) e >
   XB.addQ (XB.constant (h.1 u)) (XB.mulQ XB.variable (XB.include p'))
    =< sym (XB.horner (h.1 u) p') > XB.include (cons (h.1 u) p') } ;
 kron-map : (n : Nat) (a : Ps.Fin n -> A.1.R) -> Id (TG.ext1 B).1.R (M.map.1 (XA.include (kron-a n a))) (XB.include (kron-b n (\ j -> h.1 (a j)))) = split {
  zero -> \ a -> RH.zero (TG.ext1 A).1 (TG.ext1 B).1 M.map ;
  suc n | r -> \ a -> horner-map (a (inr tt)) (kron-a n (\ j -> a (inl j))) (kron-b n (\ j -> h.1 (a (inl j)))) (r (\ j -> a (inl j))) } ;
} ;
