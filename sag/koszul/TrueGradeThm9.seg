-- ctete §1: Lemma 6, Lemma 7, Gr(I) >= 1 iff I regular, Theorem 9,
-- relative to a list J.  T[X] is ext1 T, c the constants, and the
-- Kronecker polynomial of I over T is f = I_n + I_(n-1) X + ... (kron).
--
-- f is in I.T[X] (its coefficients are generators of I or 0), and f is
-- regular mod J when I is (cffr/PolyRegularMod.Kronecker: McCoy mod J).
--
-- Lemma 6 (core, in one ring T): a_1, a_2 a regular sequence in I mod J,
--   b in I regular mod J: then I is regular mod (J, a_1) (it contains
--   a_2), hence mod (J, b) (Lemma 3).  Lemma 6: Gr(I) >= 2 and b regular
--   in I give I regular mod (J, b) (core after the indeterminates, then
--   down: PolyRegularMod.Ideal.down).
-- Gr(I) >= 1 iff I regular: an element of I regular mod J makes I regular
--   (and down); conversely f.
-- Lemma 7: a_1, ..., a_(k+1) a regular sequence in I mod J (in T) gives
--   f, c a_1, ..., c a_k a regular sequence in I mod J (in T[X]).
--   Induction on k: f is regular mod J (I contains a_1, which is regular
--   mod J); by induction f, c a_2, ... is regular mod (J, a_1); then
--   c a_1 is regular mod (J, f) (Corollary 2), and (J, a_1, f) has the
--   elements of (J, f, a_1).
-- Theorem 9: Gr(I) >= k + 1 mod J and b in I regular mod J give
--   Gr(I) >= k mod (J, b).  Induction on k.  Take a sequence a of length
--   k + 2 in T = ext p D; by Lemma 7, f, c a_1, ..., c a_(k+1) is regular
--   mod J in T[X].  By Lemma 6 (core) I is regular mod (J, b), so f is
--   regular mod (J, b), and b is regular mod (J, f) (Corollary 2).  By
--   induction (in T[X], mod (J, f), with c a_1, ..., c a_(k+1)), there is a
--   regular sequence d of length k mod (J, f, b), after q more
--   indeterminates; then f, d is a regular sequence mod (J, b) (swap),
--   and the tower gives Gr(I) >= k + 1 mod (J, b) over D.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module KX = KoszulExact[l] ;

---------------------------------------------------------------------
-- lists
module Lists (D : TG.RD) {
 module TI = TrueGradeIdeals[l].Over[D.1,D.2] ;
 extend-pw (m : Nat) (L L' : Ps.Fin m -> D.1.R) (h : (i : Ps.Fin m) -> Id D.1.R (L i) (L' i)) (c c' : D.1.R) (e : Id D.1.R c c') :
  (i : Ps.Fin (suc m)) -> Id D.1.R (TG.extend D m L c i) (TG.extend D m L' c' i) = split {
  inl i -> h i ; inr t -> e } ;
 regel-list (m : Nat) (L L' : Ps.Fin m -> D.1.R) (h : (i : Ps.Fin m) -> Id D.1.R (L i) (L' i)) (b : D.1.R) (r : TG.RegEl D m L b) : TG.RegEl D m L' b =
  subst (\ K -> TG.RegEl D m K b) (F.funext (Ps.Fin m) (\ i -> D.1.R) L L' h) r ;
 regid-list (m : Nat) (L L' : Ps.Fin m -> D.1.R) (h : (i : Ps.Fin m) -> Id D.1.R (L i) (L' i)) (n : Nat) (I : Ps.Fin n -> D.1.R) (r : TG.RegId D m L n I) : TG.RegId D m L' n I =
  subst (\ K -> TG.RegId D m K n I) (F.funext (Ps.Fin m) (\ i -> D.1.R) L L' h) r ;
 -- membership in I, in RelRegular's form
 inI-rr (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (x : D.1.R) (h : TG.InI D n I x) :
  RelRegular[l].Over[D.1,RI.Generated[D.1,m,J].ideal].InI n I x =
  TC.map (FiniteIdeal[l].Sums[D.1].Coordinates n I x) ((c : Ps.Fin n -> D.1.R) * RelRegular[l].Over[D.1,RI.Generated[D.1,m,J].ideal].Cong x (FiniteIdeal[l].Sums[D.1].lin n I c))
   (\ v -> (v.1,RelRegular[l].Over[D.1,RI.Generated[D.1,m,J].ideal].cong-eq x (FiniteIdeal[l].Sums[D.1].lin n I v.1) (sym v.2))) h ;
} ;
-- images of (L, c) along incl q
img-extend (q : Nat) (D : TG.RD) (m : Nat) (L : Ps.Fin m -> D.1.R) (c : D.1.R) :
 (i : Ps.Fin (suc m)) -> Id (TG.ext q D).1.R (TG.img q D (suc m) (TG.extend D m L c) i) (TG.extend (TG.ext q D) m (TG.img q D m L) ((TG.incl q D).1 c) i) =
 TT.map-snoc (Ps.Fin m) D.1.R (TG.ext q D).1.R (TG.incl q D).1 L c ;
-- down along ext p, for ideals
down-id : (p : Nat) (D : TG.RD) (M : Nat) (L : Ps.Fin M -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) ->
 TG.RegId (TG.ext p D) M (TG.img p D M L) n (TG.img p D n I) -> TG.RegId D M L n I = split {
 zero -> \ D M L n I h -> h ;
 suc p | r -> \ D M L n I h -> r D M L n I (PolyRegularMod[l].Over[(TG.ext p D).1,(TG.ext p D).2,M,TG.img p D M L].Ideal[n,TG.img p D n I].down h) } ;

---------------------------------------------------------------------
-- the Kronecker polynomial
module Kron (T : TG.RD) {
 module PR = PolyRegular[l].Over[T.1,T.2] ;
 module X = TG.PolyX[T].X ;
 c (x : T.1.R) : X.Carrier = X.constant x ;
 -- a list generates its tail
 gen-inl (n : Nat) (a : Ps.Fin (suc n) -> T.1.R) (x : T.1.R) (h : RI.Generated[T.1,n,\ j -> a (inl j)].In x) : RI.Generated[T.1,suc n,a].In x =
  TC.map (FiniteIdeal[l].Sums[T.1].Coordinates n (\ j -> a (inl j)) x) (FiniteIdeal[l].Sums[T.1].Coordinates (suc n) a x)
   (\ v -> (Ps.snoc (Ps.Fin n) T.1.R v.1 T.1.z,trans (ap (\ t -> T.1.add t (FiniteIdeal[l].Sums[T.1].lin n (\ j -> a (inl j)) v.1)) (RL[T.1].mul-zero (a (inr tt))))
     (trans (RL[T.1].zl (FiniteIdeal[l].Sums[T.1].lin n (\ j -> a (inl j)) v.1)) v.2))) h ;
 kron-step (n : Nat) (a : Ps.Fin (suc n) -> T.1.R) (r : (b : Ps.Fin n -> T.1.R) (i : Nat) -> RI.Generated[T.1,n,b].In (Poly[l].PolyR[T.1].coef (PR.kron n b) i)) :
  (i : Nat) -> RI.Generated[T.1,suc n,a].In (Poly[l].PolyR[T.1].coef (PR.kron (suc n) a) i) = split {
  zero -> RI.Generated[T.1,suc n,a].generator (inr tt) ;
  suc i -> gen-inl n a (Poly[l].PolyR[T.1].coef (PR.kron n (\ j -> a (inl j))) i) (r (\ j -> a (inl j)) i) } ;
 -- the coefficients of kron are in the ideal
 kron-in : (n : Nat) (a : Ps.Fin n -> T.1.R) (i : Nat) -> RI.Generated[T.1,n,a].In (Poly[l].PolyR[T.1].coef (PR.kron n a) i) = split {
  zero -> \ a i -> RI.Generated[T.1,zero,a].ideal.in-zero ;
  suc n | r -> \ a -> kron-step n a r } ;
 f (n : Nat) (I : Ps.Fin n -> T.1.R) : X.Carrier = X.include (PR.kron n I) ;
 f-in (n : Nat) (I : Ps.Fin n -> T.1.R) : TG.InI (TG.ext1 T) n (\ i -> c (I i)) (f n I) =
  PolyIdeal[l].Over[T.1,T.2,n,I].from-coefficients (f n I) (\ k ->
   RI.IdealLaws[T.1,RI.Generated[T.1,n,I].ideal].in-eq (Poly[l].PolyR[T.1].coef (PR.kron n I) k) (PR.coefQ (f n I) k)
    (sym (PR.coefQ-include (PR.kron n I) k)) (kron-in n I k)) ;
 f-reg (m : Nat) (J : Ps.Fin m -> T.1.R) (n : Nat) (I : Ps.Fin n -> T.1.R) (r : TG.RegId T m J n I) : TG.RegEl (TG.ext1 T) m (\ i -> c (J i)) (f n I) =
  \ x t k -> PolyRegularMod[l].Over[T.1,T.2,m,J].Kronecker[n,I].regular r x t (\ i -> k) ;
} ;

---------------------------------------------------------------------
-- Lemma 6
module Lemma6Core (T : TG.RD) (m : Nat) (J : Ps.Fin m -> T.1.R) (n : Nat) (I : Ps.Fin n -> T.1.R)
 (a1 a2 : T.1.R) (a1i : TG.InI T n I a1) (a2i : TG.InI T n I a2) (r1 : TG.RegEl T m J a1) (r2 : TG.RegEl T (suc m) (TG.extend T m J a1) a2)
 (b : T.1.R) (rb : TG.RegEl T m J b) {
 module TI = TrueGradeIdeals[l].Over[T.1,T.2] ;
 module PA = TI.Plus[m,J,a1] ; module PB = TI.Plus[m,J,b] ;
 mod-a1 : TG.RegId T (suc m) (TG.extend T m J a1) n I = TI.elem-ideal (suc m) (TG.extend T m J a1) n I a2 a2i r2 ;
 result : TG.RegId T (suc m) (TG.extend T m J b) n I =
  PB.reg-id-to n I (PA.RR.lemma3 b a1 rb r1 n I (Lists[T].inI-rr m J n I a1 a1i) (PA.reg-id-from n I mod-a1)) ;
} ;
module Lemma6 (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (b : D.1.R) (rb : TG.RegEl D m J b) {
 module At (w : (p : Nat) * TG.Seq D (suc (suc zero)) m J n I p) {
  core : TG.RegId (TG.ext w.1 D) (suc m) (TG.extend (TG.ext w.1 D) m (TG.img w.1 D m J) ((TG.incl w.1 D).1 b)) n (TG.img w.1 D n I) =
   Lemma6Core[TG.ext w.1 D,m,TG.img w.1 D m J,n,TG.img w.1 D n I,w.2.1 (inr tt),w.2.1 (inl (inr tt)),w.2.2.1 (inr tt),w.2.2.1 (inl (inr tt)),
    w.2.2.2.1,w.2.2.2.2.1,(TG.incl w.1 D).1 b,TT.up-el w.1 D m J b rb].result ;
  result : TG.RegId D (suc m) (TG.extend D m J b) n I = down-id w.1 D (suc m) (TG.extend D m J b) n I
   (Lists[TG.ext w.1 D].regid-list (suc m) (TG.extend (TG.ext w.1 D) m (TG.img w.1 D m J) ((TG.incl w.1 D).1 b)) (TG.img w.1 D (suc m) (TG.extend D m J b))
    (\ i -> sym (img-extend w.1 D m J b i)) n (TG.img w.1 D n I) core) ;
 } ;
 -- Gr(I) >= 2 and b regular in I give I regular mod (J, b)
 result (g : TG.TGr (suc (suc zero)) D m J n I) : TG.RegId D (suc m) (TG.extend D m J b) n I = \ x t k ->
  TC.rec ((p : Nat) * TG.Seq D (suc (suc zero)) m J n I p) @l (RI.Generated[D.1,suc m,TG.extend D m J b].In x)
   (RI.Generated[D.1,suc m,TG.extend D m J b].in-prop x) (\ w -> At[w].result x t k) g ;
} ;

---------------------------------------------------------------------
-- Gr(I) >= 1 iff I regular
gr1-to (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (g : TG.TGr (suc zero) D m J n I) : TG.RegId D m J n I = \ x t k ->
 TC.rec ((p : Nat) * TG.Seq D (suc zero) m J n I p) @l (RI.Generated[D.1,m,J].In x) (RI.Generated[D.1,m,J].in-prop x)
  (\ w -> down-id w.1 D m J n I (TrueGradeIdeals[l].Over[(TG.ext w.1 D).1,(TG.ext w.1 D).2].elem-ideal m (TG.img w.1 D m J) n (TG.img w.1 D n I)
    (w.2.1 (inr tt)) (w.2.2.1 (inr tt)) w.2.2.2.1) x t k) g ;
gr1-from (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (r : TG.RegId D m J n I) : TG.TGr (suc zero) D m J n I =
 Tr.Trunc[(p : Nat) * TG.Seq D (suc zero) m J n I p].inc (suc zero,\ i -> Kron[D].f n I,\ i -> Kron[D].f-in n I,(Kron[D].f-reg m J n I r,tt)) ;
-- Gr(I) >= 0
gr0 (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) : TG.TGr zero D m J n I =
 Tr.Trunc[(p : Nat) * TG.Seq D zero m J n I p].inc (zero,\ i -> efq i,\ i -> efq i,tt) ;

---------------------------------------------------------------------
-- Lemma 7
module Lemma7 (T : TG.RD) (n : Nat) (I : Ps.Fin n -> T.1.R) {
 module K = Kron[T] ;
 T' : TG.RD = TG.ext1 T ;
 f : T'.1.R = K.f n I ;
 module TI = TrueGradeIdeals[l].Over[T.1,T.2] ;
 module TX = TrueGradeIdeals[l].Over[T'.1,T'.2] ;
 -- f, then the constants of a_1, ..., a_k
 kseq (k : Nat) (a : Ps.Fin (suc k) -> T.1.R) : Ps.Fin (suc k) -> T'.1.R = Ps.snoc (Ps.Fin k) T'.1.R (\ i -> K.c (TG.drop k T.1.R a i)) f ;
 module Step (k m : Nat) (J : Ps.Fin m -> T.1.R) (a : Ps.Fin (suc (suc k)) -> T.1.R)
  (ai : TG.InSeq T n I (suc (suc k)) a) (rs : TG.RegSeq T (suc (suc k)) m J a)
  (ih : TG.RegSeq T' (suc k) (suc m) (\ i -> K.c (TG.extend T m J (a (inr tt)) i)) (kseq k (\ i -> a (inl i)))) {
  a1 : T.1.R = a (inr tt) ;
  cJ : Ps.Fin m -> T'.1.R = \ i -> K.c (J i) ;
  fJ : TG.RegEl T' m cJ f = K.f-reg m J n I (TI.elem-ideal m J n I a1 (ai (inr tt)) rs.1) ;
  a1J : TG.RegEl T' m cJ (K.c a1) = TT.Up1[T].el m J a1 rs.1 ;
  fA : TG.RegEl T' (suc m) (TG.extend T' m cJ (K.c a1)) f =
   Lists[T'].regel-list (suc m) (\ i -> K.c (TG.extend T m J a1 i)) (TG.extend T' m cJ (K.c a1)) (TT.map-snoc (Ps.Fin m) T.1.R T'.1.R K.c J a1) f ih.1 ;
  module PA = TX.Plus[m,cJ,K.c a1] ; module PF = TX.Plus[m,cJ,f] ;
  -- c a_1 regular mod (J, f): Corollary 2
  a1F : TG.RegEl T' (suc m) (TG.extend T' m cJ f) (K.c a1) = PF.reg-el-to (K.c a1) (PA.RR.cor2 f (K.c a1) fJ a1J (PA.reg-el-from f fA)) ;
  -- the rest, with (J, a_1, f) read as (J, f, a_1)
  rest : TG.RegSeq T' k (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) (K.c a1)) (\ i -> K.c (TG.drop k T.1.R (\ j -> a (inl j)) i)) =
   TX.same-seq k (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ (K.c a1)) f) (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) (K.c a1))
    (TX.swap-same m cJ (K.c a1) f) (\ i -> K.c (TG.drop k T.1.R (\ j -> a (inl j)) i))
    (TT.regseq-list T' k (suc (suc m)) (TG.extend T' (suc m) (\ i -> K.c (TG.extend T m J a1 i)) f) (TG.extend T' (suc m) (TG.extend T' m cJ (K.c a1)) f)
     (Lists[T'].extend-pw (suc m) (\ i -> K.c (TG.extend T m J a1 i)) (TG.extend T' m cJ (K.c a1)) (TT.map-snoc (Ps.Fin m) T.1.R T'.1.R K.c J a1) f f (refl f))
     (\ i -> K.c (TG.drop k T.1.R (\ j -> a (inl j)) i)) ih.2) ;
  result : TG.RegSeq T' (suc (suc k)) m cJ (kseq (suc k) a) = (fJ,(a1F,rest)) ;
 } ;
 seq : (k m : Nat) (J : Ps.Fin m -> T.1.R) (a : Ps.Fin (suc k) -> T.1.R) -> TG.InSeq T n I (suc k) a -> TG.RegSeq T (suc k) m J a ->
  TG.RegSeq T' (suc k) m (\ i -> K.c (J i)) (kseq k a) = split {
  zero -> \ m J a ai rs -> (K.f-reg m J n I (TI.elem-ideal m J n I (a (inr tt)) (ai (inr tt)) rs.1),tt) ;
  suc k | r -> \ m J a ai rs -> Step[k,m,J,a,ai,rs,r (suc m) (TG.extend T m J (a (inr tt))) (\ i -> a (inl i)) (\ i -> ai (inl i)) rs.2].result } ;
 kseq-in (k : Nat) (a : Ps.Fin (suc k) -> T.1.R) (ai : TG.InSeq T n I (suc k) a) : TG.InSeq T' n (\ i -> K.c (I i)) (suc k) (kseq k a) =
  KX.plus-fn (Ps.Fin k) Top (\ i -> TG.InI T' n (\ j -> K.c (I j)) (kseq k a i))
   (\ i -> TT.Up1[T].inI n I (TG.drop k T.1.R a i) (TG.drop-in T.1.R (TG.InI T n I) k a ai i)) (\ t -> K.f-in n I) ;
} ;

---------------------------------------------------------------------
-- Theorem 9
IH9 (k : Nat) : U l+ = (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (b : D.1.R) ->
 TG.InI D n I b -> TG.RegEl D m J b -> TG.TGr (suc k) D m J n I -> TG.TGr k D (suc m) (TG.extend D m J b) n I ;
module Thm9Step (k : Nat) (r : IH9 k) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (b : D.1.R)
 (bi : TG.InI D n I b) (rb : TG.RegEl D m J b) (w : (p : Nat) * TG.Seq D (suc (suc k)) m J n I p) {
 p : Nat = w.1 ;
 T : TG.RD = TG.ext p D ;
 a : Ps.Fin (suc (suc k)) -> T.1.R = w.2.1 ;
 J' : Ps.Fin m -> T.1.R = TG.img p D m J ;
 I' : Ps.Fin n -> T.1.R = TG.img p D n I ;
 b' : T.1.R = (TG.incl p D).1 b ;
 module L7 = Lemma7[T,n,I'] ;
 T' : TG.RD = L7.T' ;
 c (x : T.1.R) : T'.1.R = L7.K.c x ;
 f : T'.1.R = L7.f ;
 cJ : Ps.Fin m -> T'.1.R = \ i -> c (J' i) ;
 cI : Ps.Fin n -> T'.1.R = \ i -> c (I' i) ;
 b'' : T'.1.R = c b' ;
 seq7 : TG.RegSeq T' (suc (suc k)) m cJ (L7.kseq (suc k) a) = L7.seq (suc k) m J' a w.2.2.1 w.2.2.2 ;
 -- I regular mod (J, b) in T (Lemma 6), so f regular mod (J, b) in T'
 regIb : TG.RegId T (suc m) (TG.extend T m J' b') n I' =
  Lemma6Core[T,m,J',n,I',a (inr tt),a (inl (inr tt)),w.2.2.1 (inr tt),w.2.2.1 (inl (inr tt)),w.2.2.2.1,w.2.2.2.2.1,b',TT.up-el p D m J b rb].result ;
 fB : TG.RegEl T' (suc m) (TG.extend T' m cJ b'') f =
  Lists[T'].regel-list (suc m) (\ i -> c (TG.extend T m J' b' i)) (TG.extend T' m cJ b'') (TT.map-snoc (Ps.Fin m) T.1.R T'.1.R c J' b') f
   (L7.K.f-reg (suc m) (TG.extend T m J' b') n I' regIb) ;
 bJ : TG.RegEl T' m cJ b'' = TT.Up1[T].el m J' b' (TT.up-el p D m J b rb) ;
 module PB = L7.TX.Plus[m,cJ,b''] ; module PF = L7.TX.Plus[m,cJ,f] ;
 -- b regular mod (J, f): Corollary 2
 bF : TG.RegEl T' (suc m) (TG.extend T' m cJ f) b'' = PF.reg-el-to b'' (PB.RR.cor2 f b'' seq7.1 bJ (PB.reg-el-from f fB)) ;
 -- Gr(I) >= k + 1 mod (J, f) in T', by the rest of the Lemma 7 sequence
 g' : TG.TGr (suc k) T' (suc m) (TG.extend T' m cJ f) n cI =
  Tr.Trunc[(q : Nat) * TG.Seq T' (suc k) (suc m) (TG.extend T' m cJ f) n cI q].inc
   (zero,\ i -> L7.kseq (suc k) a (inl i),\ i -> L7.kseq-in (suc k) a w.2.2.1 (inl i),seq7.2) ;
 bI : TG.InI T' n cI b'' = TT.Up1[T].inI n I' b' (TT.up-in p D n I b bi) ;
 ih : TG.TGr k T' (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) b'') n cI = r T' (suc m) (TG.extend T' m cJ f) n cI b'' bI bF g' ;
 -- (J, b) along incl (p + 1)
 L0 : Ps.Fin (suc m) -> T'.1.R = TG.img (suc p) D (suc m) (TG.extend D m J b) ;
 L0-pw (i : Ps.Fin (suc m)) : Id T'.1.R (L0 i) (TG.extend T' m cJ b'' i) = TT.map-snoc (Ps.Fin m) D.1.R T'.1.R (\ x -> c ((TG.incl p D).1 x)) J b i ;
 -- f, d after q more indeterminates
 module Final (u : (q : Nat) * TG.Seq T' k (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) b'') n cI q) {
  q : Nat = u.1 ;
  V : TG.RD = TG.ext q T' ;
  h (x : T'.1.R) : V.1.R = (TG.incl q T').1 x ;
  module VI = TrueGradeIdeals[l].Over[V.1,V.2] ;
  e : Ps.Fin (suc k) -> V.1.R = Ps.snoc (Ps.Fin k) V.1.R u.2.1 (h f) ;
  e-in : TG.InSeq V n (TG.img q T' n cI) (suc k) e = KX.plus-fn (Ps.Fin k) Top (\ i -> TG.InI V n (TG.img q T' n cI) (e i))
   u.2.2.1 (\ t -> TT.up-in q T' n cI f (L7.K.f-in n I')) ;
  A : Ps.Fin m -> V.1.R = TG.img q T' m cJ ;
  LV : Ps.Fin (suc m) -> V.1.R = TG.img q T' (suc m) L0 ;
  head : TG.RegEl V (suc m) LV (h f) =
   TT.up-el q T' (suc m) L0 f (Lists[T'].regel-list (suc m) (TG.extend T' m cJ b'') L0 (\ i -> sym (L0-pw i)) f fB) ;
  pw1 (i : Ps.Fin (suc (suc m))) : Id V.1.R (TG.img q T' (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) b'') i)
   (TG.extend V (suc m) (TG.extend V m A (h f)) (h b'') i) =
   trans (img-extend q T' (suc m) (TG.extend T' m cJ f) b'' i)
    (Lists[V].extend-pw (suc m) (TG.img q T' (suc m) (TG.extend T' m cJ f)) (TG.extend V m A (h f)) (img-extend q T' m cJ f) (h b'') (h b'') (refl (h b'')) i) ;
  pw3 (i : Ps.Fin (suc (suc m))) : Id V.1.R (TG.extend V (suc m) (TG.extend V m A (h b'')) (h f) i) (TG.extend V (suc m) LV (h f) i) =
   Lists[V].extend-pw (suc m) (TG.extend V m A (h b'')) LV (\ j -> sym (trans (ap h (L0-pw j)) (img-extend q T' m cJ b'' j))) (h f) (h f) (refl (h f)) i ;
  tail : TG.RegSeq V k (suc (suc m)) (TG.extend V (suc m) LV (h f)) u.2.1 =
   TT.regseq-list V k (suc (suc m)) (TG.extend V (suc m) (TG.extend V m A (h b'')) (h f)) (TG.extend V (suc m) LV (h f)) pw3 u.2.1
    (VI.same-seq k (suc (suc m)) (TG.extend V (suc m) (TG.extend V m A (h f)) (h b'')) (suc (suc m)) (TG.extend V (suc m) (TG.extend V m A (h b'')) (h f))
     (VI.swap-same m A (h f) (h b'')) u.2.1
     (TT.regseq-list V k (suc (suc m)) (TG.img q T' (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) b'')) (TG.extend V (suc m) (TG.extend V m A (h f)) (h b''))
      pw1 u.2.1 u.2.2.2)) ;
  result : TG.TGr (suc k) T' (suc m) L0 n cI =
   Tr.Trunc[(q' : Nat) * TG.Seq T' (suc k) (suc m) L0 n cI q'].inc (q,e,e-in,(head,tail)) ;
 } ;
 result : TG.TGr (suc k) D (suc m) (TG.extend D m J b) n I =
  TT.tower (suc k) D (suc m) (TG.extend D m J b) n I (suc p)
   (TC.rec ((q : Nat) * TG.Seq T' k (suc (suc m)) (TG.extend T' (suc m) (TG.extend T' m cJ f) b'') n cI q) @l (TG.TGr (suc k) T' (suc m) L0 n cI)
    (TG.tgr-prop (suc k) T' (suc m) L0 n cI) (\ u -> Final[u].result) ih) ;
} ;
-- Theorem 9: Gr(I) >= k + 1 mod J and b in I regular mod J give Gr(I) >= k mod (J, b)
thm9 : (k : Nat) -> IH9 k = split {
 zero -> \ D m J n I b bi rb g -> gr0 D (suc m) (TG.extend D m J b) n I ;
 suc k | r -> \ D m J n I b bi rb g -> TC.rec ((p : Nat) * TG.Seq D (suc (suc k)) m J n I p) @l (TG.TGr (suc k) D (suc m) (TG.extend D m J b) n I)
  (TG.tgr-prop (suc k) D (suc m) (TG.extend D m J b) n I) (\ w -> Thm9Step[k,r,D,m,J,n,I,b,bi,rb,w].result) g } ;
