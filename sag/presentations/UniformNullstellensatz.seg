-- Public interface for sag/: the mere weak Nullstellensatz is DERIVED
-- from uniform SQC, not supplied as a separate hypothesis.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) {
 module Raw = Poly[l].PolyR[R] ;
 module M = Mul[l].MulR[R] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module Weak = WeakNullstellensatz[l].Over[R,setR,sqc] ;
 Inverse (f : Raw.P) : U l = (g : Raw.P) * Raw.peq (M.pmul f g) (cons R.o nil) ;
 wn (f : Raw.P) (no-root : ((x : R.R) * Id R.R (Raw.ev f x) R.z) -> Empty) :
  Truncation[l].Trunc[Inverse f].carrier =
  PolynomialCertificate[l].Over[R,setR,f].of-collapse
   (Weak.empty-collapse W.For[f].K.A.algebra W.For[f].K.finitely-presented (W.For[f].no-points no-root)) ;
 empty-prop : Pr.isProp Empty = \ x y -> efq x ;
 -- This matches sag/Mul.seg's revised NN-valued hypothesis definitionally.
 wn-nn (f : Raw.P) (no-root : ((x : R.R) * Id R.R (Raw.ev f x) R.z) -> Empty) :
  ((Inverse f -> Empty) -> Empty) = \ reject ->
  Truncation[l].Trunc[Inverse f].induction @l (\ t -> Empty) (\ t -> empty-prop) reject (wn f no-root) ;
} ;
