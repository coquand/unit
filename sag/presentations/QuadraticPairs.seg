-- The explicit free rank-two algebra R + R*t, with t*t=a.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (a : Rg.R) {
 open Rg ; open RL[Rg] ;
 module Identities = QuadraticIdentities[l].Laws[Rg] ;
 module C = Algebras[l].Over[Rg,setR] ;
 Pair : U l = R * R ;
 eq (p q : Pair) (h : Id R p.1 q.1) (k : Id R p.2 q.2) : Id Pair p q =
  Pr.trans Pair p (q.1,p.2) q
   (Pr.ap R Pair (\ x -> (x,p.2)) _ _ h) (Pr.ap R Pair (\ y -> (q.1,y)) _ _ k) ;
 set : Pr.isSet Pair = Pr.isSet-Sigma R (\ b -> R) setR (\ b -> setR) ;
 plusQ (p q : Pair) : Pair = (add p.1 q.1,add p.2 q.2) ;
 timesQ (p q : Pair) : Pair = (add (mul p.1 q.1) (mul a (mul p.2 q.2)),add (mul p.1 q.2) (mul p.2 q.1)) ;
 minusQ (p : Pair) : Pair = (neg p.1,neg p.2) ;
 constant (b : R) : Pair = (b,z) ;
 zeroQ : Pair = (z,z) ;
 oneQ : Pair = (o,z) ;
 tau : Pair = (z,o) ;
 assoc-add (p q r : Pair) : Id Pair (plusQ p (plusQ q r)) (plusQ (plusQ p q) r) =
  eq _ _ (addA p.1 q.1 r.1) (addA p.2 q.2 r.2) ;
 comm-add (p q : Pair) : Id Pair (plusQ p q) (plusQ q p) = eq _ _ (addC p.1 q.1) (addC p.2 q.2) ;
 zero-add (p : Pair) : Id Pair (plusQ p zeroQ) p = eq _ _ (addZ p.1) (addZ p.2) ;
 neg-add (p : Pair) : Id Pair (plusQ p (minusQ p)) zeroQ = eq _ _ (addN p.1) (addN p.2) ;
 assoc-mul (p q r : Pair) : Id Pair (timesQ p (timesQ q r)) (timesQ (timesQ p q) r) =
  eq _ _ (Identities.associative0 a p.1 p.2 q.1 q.2 r.1 r.2) (Identities.associative1 a p.1 p.2 q.1 q.2 r.1 r.2) ;
 comm-mul (p q : Pair) : Id Pair (timesQ p q) (timesQ q p) =
  eq _ _ (Presentations[l].cong2 R add _ _ _ _ (mulC p.1 q.1) (ap (mul a) (mulC p.2 q.2)))
   (trans (Presentations[l].cong2 R add _ _ _ _ (mulC p.1 q.2) (mulC p.2 q.1)) (addC (mul q.2 p.1) (mul q.1 p.2))) ;
 one-mul (p : Pair) : Id Pair (timesQ p oneQ) p =
  eq _ _
   (trans (Presentations[l].cong2 R add _ _ _ _ (mulO p.1) (trans (ap (mul a) (mul-zero p.2)) (mul-zero a))) (addZ p.1))
   (trans (Presentations[l].cong2 R add _ _ _ _ (mul-zero p.1) (mulO p.2)) (zl p.2)) ;
 distribute (p q r : Pair) : Id Pair (timesQ p (plusQ q r)) (plusQ (timesQ p q) (timesQ p r)) =
  eq _ _ (Identities.distributive0 a p.1 p.2 q.1 q.2 r.1 r.2) (Identities.distributive1 a p.1 p.2 q.1 q.2 r.1 r.2) ;
 ring : CRing = mkCRing Pair zeroQ oneQ plusQ timesQ minusQ
  assoc-add comm-add zero-add neg-add assoc-mul comm-mul one-mul distribute ;
 constant-add (b c : R) : Id Pair (constant (add b c)) (plusQ (constant b) (constant c)) =
  eq _ _ (refl (add b c)) (sym (addZ z)) ;
 constant-mul (b c : R) : Id Pair (constant (mul b c)) (timesQ (constant b) (constant c)) =
  eq _ _ (sym (trans (ap (add (mul b c)) (trans (ap (mul a) (mul-zero z)) (mul-zero a))) (addZ (mul b c))))
   (sym (trans (Presentations[l].cong2 R add _ _ _ _ (mul-zero b) (zero-mul c)) (addZ z))) ;
 inclusion : RingHom[l].Hom Rg ring = (constant,refl oneQ,constant-add,constant-mul) ;
 algebra : C.Algebra = C.mkAlgebra ring set inclusion ;
 square : Id Pair (timesQ tau tau) (constant a) =
  eq _ _ (trans (Presentations[l].cong2 R add _ _ _ _ (mul-zero z) (trans (ap (mul a) (mulO o)) (mulO a))) (zl a))
   (trans (Presentations[l].cong2 R add _ _ _ _ (zero-mul o) (mul-zero o)) (addZ z)) ;
 scalar-tau (c : R) : Id Pair (timesQ (constant c) tau) (z,c) =
  eq _ _ (trans (Presentations[l].cong2 R add _ _ _ _ (mul-zero c) (trans (ap (mul a) (zero-mul o)) (mul-zero a))) (addZ z))
   (trans (Presentations[l].cong2 R add _ _ _ _ (mulO c) (mul-zero z)) (addZ c)) ;
 basis (p : Pair) : Id Pair (plusQ (constant p.1) (timesQ (constant p.2) tau)) p =
  trans (ap (plusQ (constant p.1)) (scalar-tau p.2)) (eq _ _ (addZ p.1) (zl p.2)) ;
} ;
