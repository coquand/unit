-- Adding a variable preserves finite presentability; the representing
-- algebra is the already constructed coefficient quotient A[X].
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module E = Equivalences[l] ;
open Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ; open P ;
 module C = Algebras[l].Over[R,setR] ;
 lift-equations (V : U l) : Equations V -> Equations (Plus V Top) = split {
  nil -> nil ; cons e es | r -> cons (rename V (Plus V Top) (\ v -> inl v) e) r } ;
 added (p : Presentation) : Presentation = (suc p.1,lift-equations (Fin p.1) p.2) ;
 zeros-up (V : U l) (B : C.Algebra) (a : Plus V Top -> B.ring.R) :
  (es : Equations V) -> Zeros V B (\ v -> a (inl v)) es -> Zeros (Plus V Top) B a (lift-equations V es) = split {
  nil -> \ z -> tt ; cons e es | r -> \ z ->
   (trans (eval-rename V (Plus V Top) (\ v -> inl v) B a e) z.1,r z.2) } ;
 zeros-down (V : U l) (B : C.Algebra) (a : Plus V Top -> B.ring.R) :
  (es : Equations V) -> Zeros (Plus V Top) B a (lift-equations V es) -> Zeros V B (\ v -> a (inl v)) es = split {
  nil -> \ z -> tt ; cons e es | r -> \ z ->
   (trans (sym (eval-rename V (Plus V Top) (\ v -> inl v) B a e)) z.1,r z.2) } ;
 module SolutionsX (p : Presentation) (B : C.Algebra) {
  Data : U l = Solutions p B * B.ring.R ;
  forward (s : Solutions (added p) B) : Data =
   ((\ v -> s.1 (inl v),zeros-down (Fin p.1) B s.1 p.2 s.2),s.1 (inr tt)) ;
  backward (s : Data) : Solutions (added p) B =
   (snoc (Fin p.1) B.ring.R s.1.1 s.2,zeros-up (Fin p.1) B (snoc (Fin p.1) B.ring.R s.1.1 s.2) p.2 s.1.2) ;
  fb (s : Data) : Id Data (forward (backward s)) s =
   Pr.ap (Solutions p B) Data (\ a -> (a,s.2)) _ _
    (solutions-ext p B (forward (backward s)).1 s.1 (\ v -> refl (s.1.1 v))) ;
  eta (s : Solutions (added p) B) : (v : Fin (suc p.1)) ->
   Id B.ring.R ((backward (forward s)).1 v) (s.1 v) = split {
    inl v -> refl (s.1 (inl v)) ; inr t -> ap (\ u -> s.1 (inr u)) (top-prop tt t) } ;
  bf (s : Solutions (added p) B) : Id (Solutions (added p) B) (backward (forward s)) s =
   solutions-ext (added p) B (backward (forward s)) s (eta s) ;
  equivalence : Pr.Equiv (Solutions (added p) B) Data = (forward,Pr.qinv _ _ forward backward fb bf) ;
  inverse : Pr.Equiv Data (Solutions (added p) B) = (backward,Pr.qinv _ _ backward forward bf fb) ;
 } ;
 module Extension (p : Presentation) (A : C.Algebra) (presented : Presents p A) {
  module AX = C.Polynomial[A] ;
  generators : Solutions (added p) AX.algebra =
   SolutionsX[p,AX.algebra].backward (canonical p A presented.1 AX.algebra AX.inclusion,AX.X.variable) ;
  module To (B : C.Algebra) {
   module SX = SolutionsX[p,B] ;
   module UAX = AX.To[B] ;
   old : Pr.Equiv (C.Hom A B) (Solutions p B) = (canonical p A presented.1 B,presented.2 B) ;
   chain : Pr.Equiv (C.Hom AX.algebra B) (Solutions (added p) B) =
    E.compose _ _ _ UAX.universal
     (E.compose _ _ _ (E.product (C.Hom A B) (Solutions p B) B.ring.R old) SX.inverse) ;
   pointwise (h : C.Hom AX.algebra B) : (v : Fin (suc p.1)) ->
    Id B.ring.R ((canonical (added p) AX.algebra generators B h).1 v) ((chain.1 h).1 v) = split {
     inl v -> refl (h.1.1 (AX.X.constant (presented.1.1 v))) ;
     inr t -> refl (h.1.1 AX.X.variable) } ;
   universal : Pr.isEquiv (C.Hom AX.algebra B) (Solutions (added p) B) (canonical (added p) AX.algebra generators B) =
    E.homotopy _ _ chain (canonical (added p) AX.algebra generators B)
     (\ h -> solutions-ext (added p) B _ _ (pointwise h)) ;
  } ;
  presentation : Presents (added p) AX.algebra = (generators,\ B -> To[B].universal) ;
 } ;
 preserves-FP (A : C.Algebra) (fp : FP A) : FP C.Polynomial[A].algebra =
  Truncation[l+].Trunc[Witness A].induction @(l+) (\ t -> FP C.Polynomial[A].algebra)
   (\ t -> Truncation[l+].Trunc[Witness C.Polynomial[A].algebra].proposition)
   (\ w -> Truncation[l+].Trunc[Witness C.Polynomial[A].algebra].inc
    (added w.1,Extension[w.1,A,w.2].presentation)) fp ;
} ;
