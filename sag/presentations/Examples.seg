-- Integration checks: repeated extension and a nonempty equation list.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AV = AddVariable[l].Over[R,setR] ;
 module BP = BasePresentation[l].Over[R,setR] ;
 module RX = C.Polynomial[C.base] ;
 module RXY = C.Polynomial[RX.algebra] ;
 line-presentation : P.Presents (AV.added BP.empty) RX.algebra =
  AV.Extension[BP.empty,C.base,BP.presentation].presentation ;
 plane-presentation : P.Presents (AV.added (AV.added BP.empty)) RXY.algebra =
  AV.Extension[AV.added BP.empty,RX.algebra,line-presentation].presentation ;
 plane-FP : P.FP RXY.algebra = AV.preserves-FP RX.algebra (AV.preserves-FP C.base BP.finitely-presented) ;

 -- R is also presented by one generator constrained to be zero.
 zero-relation : P.Presentation = (suc zero,cons (var (inr tt)) nil) ;
 zero-generators : P.Solutions zero-relation C.base = (\ v -> R.z,refl R.z,tt) ;
 module ZeroTo (B : C.Algebra) {
  module Initial = BP.To[B] ;
  pointwise (s : P.Solutions zero-relation B) : (v : Presentations[l].Fin (suc zero)) ->
   Id B.ring.R ((P.canonical zero-relation C.base zero-generators B Initial.arrow).1 v) (s.1 v) = split {
    inl v -> efq v ;
    inr t -> trans (RingHom[l].zero R B.ring B.iota)
     (trans (sym s.2.1) (ap (\ u -> s.1 (inr u)) (P.top-prop tt t))) } ;
  fb (s : P.Solutions zero-relation B) :
   Id (P.Solutions zero-relation B) (P.canonical zero-relation C.base zero-generators B Initial.arrow) s =
   P.solutions-ext zero-relation B _ s (pointwise s) ;
  bf (g : C.Hom C.base B) : Id (C.Hom C.base B) Initial.arrow g =
   C.ext C.base B Initial.arrow g (\ r -> sym (g.2 r)) ;
  universal : Pr.isEquiv (C.Hom C.base B) (P.Solutions zero-relation B)
   (P.canonical zero-relation C.base zero-generators B) =
   Pr.qinv _ _ (P.canonical zero-relation C.base zero-generators B) (\ s -> Initial.arrow) fb bf ;
 } ;
 zero-presentation : P.Presents zero-relation C.base = (zero-generators,\ B -> ZeroTo[B].universal) ;
 line-with-relation : P.Presents (AV.added zero-relation) RX.algebra =
  AV.Extension[zero-relation,C.base,zero-presentation].presentation ;

 module BoundedPlane (one-nz : Not (Id R.R R.o R.z)) (sqc : P.SQC) {
  module Bound = UniformBounded[l].Theorem[R,setR,one-nz,sqc].ForAlgebra[RXY.algebra,plane-FP] ;
  theorem (f : C.Spec RXY.algebra -> Nat) : Truncation[l].Trunc[Bound.Goal f].carrier = Bound.theorem f ;
 } ;
} ;
