-- R[T]/(T*T-a) is free on the R-module basis 1,T.
-- The statement concerns the algebra produced by general presentation existence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module Q = QuadraticPairs[l].Over[R,setR,a] ;
 module J = QuadraticPresentation[l].Over[R,setR,a] ;
 module Eval = QuadraticEvaluation[l].Over[R,setR,a] ;
 pair-solution : P.Solutions J.presentation Q.algebra = J.Roots[Q.algebra].backward (Q.tau,Q.square) ;
 module To (B : C.Algebra) {
  module RT = J.Roots[B] ;
  forward (g : C.Hom Q.algebra B) : RT.Root = (g.1.1 Q.tau,Eval.AnyMap[B,g].root) ;
  backward (r : RT.Root) : C.Hom Q.algebra B = Eval.At[B,r.1,r.2].hom ;
  fb (r : RT.Root) : Id RT.Root (forward (backward r)) r = RT.ext _ r Eval.At[B,r.1,r.2].variable ;
  bf (g : C.Hom Q.algebra B) : Id (C.Hom Q.algebra B) (backward (forward g)) g =
   C.ext Q.algebra B _ g (\ p -> sym (Eval.AnyMap[B,g].on-basis p)) ;
  root-universal : Pr.Equiv (C.Hom Q.algebra B) RT.Root = (forward,Pr.qinv _ _ forward backward fb bf) ;
  chain : Pr.Equiv (C.Hom Q.algebra B) (P.Solutions J.presentation B) =
   E.compose _ _ _ root-universal RT.inverse ;
  universal : Pr.isEquiv (C.Hom Q.algebra B) (P.Solutions J.presentation B) (P.canonical J.presentation Q.algebra pair-solution B) =
   E.homotopy _ _ chain (P.canonical J.presentation Q.algebra pair-solution B)
    (\ g -> P.solutions-ext J.presentation B _ _ (\ v -> refl (g.1.1 Q.tau))) ;
 } ;
 pair-presentation : P.Presents J.presentation Q.algebra = (pair-solution,\ B -> To[B].universal) ;
 module K = PresentationExistence[l].Over[R,setR,J.presentation] ;
 module Compare = PresentationComparison[l].Over[R,setR,J.presentation,Q.algebra,K.A.algebra,pair-presentation,K.presentation] ;
 variable : K.A.Carrier = K.A.generators (inr tt) ;
 variable-square : Id K.A.Carrier (K.A.mulQ variable variable) (K.A.constant a) =
  (J.Roots[K.A.algebra].forward K.A.solution).2 ;
 module Represent = Eval.At[K.A.algebra,variable,variable-square] ;
 represent : Q.Pair -> K.A.Carrier = Represent.evaluate ;
 -- represent(b,c) is definitionally constant(b) + constant(c)*T.
 forward-form (p : Q.Pair) : Id K.A.Carrier (Compare.forward.1.1 p) (represent p) =
  trans (Eval.AnyMap[K.A.algebra,Compare.forward].on-basis p)
   (ap (\ t -> K.A.addQ (K.A.constant p.1) (K.A.mulQ (K.A.constant p.2) t)) (Compare.forward-generators (inr tt))) ;
 normal-form : Pr.Equiv Q.Pair K.A.Carrier =
  (represent,E.homotopy _ _ Compare.equivalence represent (\ p -> sym (forward-form p))) ;
 coefficients : K.A.Carrier -> Q.Pair = normal-form.2.sec ;
 expansion (z : K.A.Carrier) : Id K.A.Carrier (represent (coefficients z)) z = normal-form.2.sec-eq z ;
 coefficient-beta (p : Q.Pair) : Id Q.Pair (coefficients (represent p)) p = Pr.sec-ret _ _ represent normal-form.2 p ;
 unique (p q : Q.Pair) (h : Id K.A.Carrier (represent p) (represent q)) : Id Q.Pair p q =
  E.injective _ _ represent normal-form.2 p q h ;
 additive (p q : Q.Pair) : Id K.A.Carrier (represent (Q.plusQ p q)) (K.A.addQ (represent p) (represent q)) =
  Represent.addition p q ;
 scale (r : R.R) (p : Q.Pair) : Q.Pair = (R.mul r p.1,R.mul r p.2) ;
 scalar-pair (r : R.R) (p : Q.Pair) : Id Q.Pair (Q.timesQ (Q.constant r) p) (scale r p) =
  Q.eq _ _
   (trans (ap (R.add (R.mul r p.1)) (trans (ap (R.mul a) (RL[R].zero-mul p.2)) (RL[R].mul-zero a))) (R.addZ (R.mul r p.1)))
   (trans (ap (R.add (R.mul r p.2)) (RL[R].zero-mul p.1)) (R.addZ (R.mul r p.2))) ;
 linear (r : R.R) (p : Q.Pair) : Id K.A.Carrier (represent (scale r p)) (K.A.mulQ (K.A.constant r) (represent p)) =
  trans (ap represent (sym (scalar-pair r p)))
   (trans (Represent.multiplication (Q.constant r) p)
    (ap (\ z -> K.A.mulQ z (represent p)) (Represent.constants r))) ;
} ;
