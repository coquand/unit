-- Solutions of the presentation (T | T*T-a=0) are square roots of a.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 V : U l = Presentations[l].Fin (suc zero) ;
 generator : P.Expr V = var (inr tt) ;
 relation : P.Expr V = sumE (mulE generator generator) (cst (R.neg a)) ;
 presentation : P.Presentation = (suc zero,cons relation nil) ;
 module Roots (B : C.Algebra) {
  Root : U l = (t : B.ring.R) * Id B.ring.R (B.ring.mul t t) (B.iota.1 a) ;
  ext (s t : Root) (h : Id B.ring.R s.1 t.1) : Id Root s t =
   Pr.Sigma-eq B.ring.R (\ t -> Id B.ring.R (B.ring.mul t t) (B.iota.1 a)) s.1 t.1 s.2 t.2 h (B.set _ _) ;
  zero-difference (x y : B.ring.R) (h : Id B.ring.R (B.ring.add x (B.ring.neg y)) B.ring.z) : Id B.ring.R x y = calc B.ring.R {
   x =< sym (B.ring.addZ x) > B.ring.add x B.ring.z
     =< ap (B.ring.add x) (sym (trans (B.ring.addC (B.ring.neg y) y) (B.ring.addN y)))
      > B.ring.add x (B.ring.add (B.ring.neg y) y)
     =< B.ring.addA x (B.ring.neg y) y > B.ring.add (B.ring.add x (B.ring.neg y)) y
     =< ap (\ z -> B.ring.add z y) h > B.ring.add B.ring.z y
     =< RL[B.ring].zl y > y } ;
  forward (s : P.Solutions presentation B) : Root =
   (s.1 (inr tt),zero-difference _ _
    (trans (ap (B.ring.add (B.ring.mul (s.1 (inr tt)) (s.1 (inr tt)))) (sym (RingHom[l].negation R B.ring B.iota a))) s.2.1)) ;
  backward (r : Root) : P.Solutions presentation B =
   (\ v -> r.1,
    trans (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ r.2 (RingHom[l].negation R B.ring B.iota a)) (B.ring.addN (B.iota.1 a)),tt) ;
  fb (r : Root) : Id Root (forward (backward r)) r = ext _ r (refl r.1) ;
  eta (s : P.Solutions presentation B) : (v : V) -> Id B.ring.R ((backward (forward s)).1 v) (s.1 v) = split {
   inl e -> efq e ; inr u -> ap (\ t -> s.1 (inr t)) (P.top-prop tt u) } ;
  bf (s : P.Solutions presentation B) : Id (P.Solutions presentation B) (backward (forward s)) s =
   P.solutions-ext presentation B _ s (eta s) ;
  equivalence : Pr.Equiv (P.Solutions presentation B) Root = (forward,Pr.qinv _ _ forward backward fb bf) ;
  inverse : Pr.Equiv Root (P.Solutions presentation B) = (backward,Pr.qinv _ _ backward forward bf fb) ;
 } ;
} ;
