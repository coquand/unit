-- Exercise certificate extraction independently of SQC, then its public interface.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Raw = Poly[l].PolyR[R] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 one : Raw.P = cons R.o nil ;
 module K = W.For[one].K ;
 -- The equation 1+X*0=0 collapses this presentation without any SQC assumption.
 collapsed : Id K.A.Carrier K.A.oneQ K.A.zeroQ =
  trans (sym (RL[K.A.ring].add-mulzero K.A.oneQ (K.A.generators (inr tt)))) K.A.solution.2.1 ;
 extracted : Truncation[l].Trunc[PolynomialCertificate[l].Over[R,setR,one].RawInverse].carrier =
  PolynomialCertificate[l].Over[R,setR,one].of-collapse collapsed ;
 module Ideal = PrincipalCertificates[l].Over[R,R.z] ;
 #fails {
  forged-certificate : Ideal.Certificate R.o R.z = (R.z,refl R.o) ;
 } ;
 module FromSQC (sqc : P.SQC) (one-nz : Not (Id R.R R.o R.z)) {
  module Theorem = UniformNullstellensatz[l].Over[R,setR,sqc] ;
  no-root : W.For[one].Root -> Empty = \ r ->
   one-nz (trans (sym (RL[R].add-mulzero R.o r.1)) r.2) ;
  mere-inverse : Truncation[l].Trunc[Theorem.Inverse one].carrier = Theorem.wn one no-root ;
  nn-inverse : (Theorem.Inverse one -> Empty) -> Empty = Theorem.wn-nn one no-root ;
 } ;
} ;
