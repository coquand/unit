-- Commutative set-valued R-algebras and genuine R-algebra maps.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 record Algebra {
  ring : CRing ;
  set : Pr.isSet ring.R ;
  iota : H.Hom R ring ;
 } ;
 base : Algebra = mkAlgebra R setR (H.identity R) ;
 Commutes (A B : Algebra) (h : H.Hom A.ring B.ring) : U l =
  (r : R.R) -> Id B.ring.R (h.1 (A.iota.1 r)) (B.iota.1 r) ;
 Hom (A B : Algebra) : U l = (h : H.Hom A.ring B.ring) * Commutes A B h ;
 commutes-prop (A B : Algebra) (h : H.Hom A.ring B.ring) : Pr.isProp (Commutes A B h) =
  F.isProp-Pi R.R (\ r -> Id B.ring.R (h.1 (A.iota.1 r)) (B.iota.1 r)) (\ r -> B.set _ _) ;
 ext (A B : Algebra) (f g : Hom A B)
  (p : (a : A.ring.R) -> Id B.ring.R (f.1.1 a) (g.1.1 a)) : Id (Hom A B) f g =
  Pr.Sigma-eq (H.Hom A.ring B.ring) (Commutes A B) f.1 g.1 f.2 g.2
   (H.Properties[A.ring,B.ring,B.set].ext f.1 g.1 p) (commutes-prop A B g.1) ;
 identity (A : Algebra) : Hom A A = (H.identity A.ring,\ r -> refl (A.iota.1 r)) ;
 compose (A B C : Algebra) (g : Hom B C) (f : Hom A B) : Hom A C =
  (H.compose A.ring B.ring C.ring g.1 f.1,\ r -> trans (ap g.1.1 (f.2 r)) (g.2 r)) ;
 Spec (A : Algebra) : U l = Hom A base ;
 evaluation (A : Algebra) (a : A.ring.R) (x : Spec A) : R.R = x.1.1 a ;

 module Polynomial (A : Algebra) {
  module X = PolynomialRing[l].Extension[A.ring,A.set] ;
  algebra : Algebra = mkAlgebra X.ring X.set (H.compose R A.ring X.ring X.inclusion A.iota) ;
  inclusion : Hom A algebra = (X.inclusion,\ r -> refl (X.constant (A.iota.1 r))) ;
  module To (B : Algebra) {
   module UP = Universal[l].Property[A.ring,B.ring,A.set,B.set] ;
   Data : U l = Hom A B * B.ring.R ;
   restrict (g : Hom algebra B) : Hom A B = compose A algebra B g inclusion ;
   forward (g : Hom algebra B) : Data = (restrict g,g.1.1 X.variable) ;
   backward (d : Data) : Hom algebra B =
    (UP.Given[d.1.1,d.2].extend,\ r -> trans (UP.Given[d.1.1,d.2].on-constants (A.iota.1 r)) (d.1.2 r)) ;
   fb (d : Data) : Id Data (forward (backward d)) d =
    Pr.trans Data (forward (backward d)) (d.1,(backward d).1.1 X.variable) d
     (Pr.ap (Hom A B) Data (\ h -> (h,(backward d).1.1 X.variable)) _ _
      (ext A B (restrict (backward d)) d.1 (UP.Given[d.1.1,d.2].on-constants)))
     (Pr.ap B.ring.R Data (\ b -> (d.1,b)) _ _ (UP.Given[d.1.1,d.2].on-variable)) ;
   bf (g : Hom algebra B) : Id (Hom algebra B) (backward (forward g)) g =
    ext algebra B (backward (forward g)) g (\ p ->
     ap (\ h -> h.1 p) (UP.bf g.1)) ;
   universal : Pr.Equiv (Hom algebra B) Data = (forward,Pr.qinv _ _ forward backward fb bf) ;
  } ;
 } ;
} ;
