-- If the presented algebra R[X]/(f) collapses, merely obtain a coefficient
-- list g with f*g=1. The polynomial inverse is never chosen as a raw list.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (f : Poly[l].PolyR[R].P) {
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module PF = W.For[f] ;
 module RX = W.RX ;
 module X = RX.X ;
 module Raw = Poly[l].PolyR[R] ;
 module M = Mul[l].MulR[R] ;
 module K = PF.K ;
 module D = PF.D ;
 module T = CertificateInterpretation[l].Over[R,setR,W.presentation f].In[RX.algebra,\ v -> X.variable,X.include f] ;
 equation-certificate (p : D.Term) : D.Member p (W.presentation f).2 -> T.Ideal.Certificate (T.ev p) (T.ev D.zeroE) = split {
  inl h -> T.Ideal.transitive _ _ _ (T.Ideal.equal _ _ (trans (ap T.ev h) (W.eval-polynomial f)))
   (T.Ideal.transitive _ _ _ T.Ideal.generator (T.Ideal.equal _ _ (sym T.zero-value))) ;
  inr e -> efq e } ;
 module Interpretation = T.Equations[equation-certificate] ;
 RawInverse : U l = (g : Raw.P) * Raw.peq (M.pmul f g) (cons R.o nil) ;
 UnitWitness : U l = (g : X.Carrier) * Id X.Carrier (X.mulQ (X.include f) g) X.oneQ ;
 certificate-unit (w : T.Ideal.Certificate (T.ev D.oneE) (T.ev D.zeroE)) : UnitWitness =
  (w.1,sym (trans w.2
   (trans (ap (\ z -> X.addQ z (X.mulQ (X.include f) w.1)) T.zero-value)
    (RL[X.ring].zl (X.mulQ (X.include f) w.1))))) ;
 Representatives (g : X.Carrier) : U l = (p : Raw.P) * Id X.Carrier (X.include p) g ;
 representatives (g : X.Carrier) : Tr.Trunc[Representatives g].carrier =
  X.Q.induction @l (\ g -> Tr.Trunc[Representatives g].carrier) (\ g -> Tr.Trunc[Representatives g].proposition)
   (\ p -> Tr.Trunc[Representatives (X.include p)].inc (p,refl (X.include p))) g ;
 raw-inverse (w : UnitWitness) (p : Representatives w.1) : RawInverse =
  (p.1,X.Q.effective (M.pmul f p.1) (cons R.o nil)
   (trans (sym (X.Multiply.beta f p.1)) (trans (ap (X.mulQ (X.include f)) p.2) w.2))) ;
 merely-raw (w : UnitWitness) : Tr.Trunc[RawInverse].carrier =
  Tr.Trunc[Representatives w.1].induction @l (\ t -> Tr.Trunc[RawInverse].carrier)
   (\ t -> Tr.Trunc[RawInverse].proposition) (\ p -> Tr.Trunc[RawInverse].inc (raw-inverse w p)) (representatives w.1) ;
 of-collapse (collapsed : Id K.A.Carrier K.A.oneQ K.A.zeroQ) : Tr.Trunc[RawInverse].carrier =
  Tr.Trunc[T.Ideal.Certificate (T.ev D.oneE) (T.ev D.zeroE)].induction @l
   (\ t -> Tr.Trunc[RawInverse].carrier) (\ t -> Tr.Trunc[RawInverse].proposition)
   (\ w -> merely-raw (certificate-unit w))
   (Interpretation.certificate D.oneE D.zeroE (K.A.Q.effective D.oneE D.zeroE collapsed)) ;
} ;
