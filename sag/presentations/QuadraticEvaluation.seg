-- Evaluate a pair (b,c) at any square root t of a in an R-algebra B.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module Q = QuadraticPairs[l].Over[R,setR,a] ;
 module At (B : C.Algebra) (t : B.ring.R) (square : Id B.ring.R (B.ring.mul t t) (B.iota.1 a)) {
  module L = RL[B.ring] ;
  module I = QuadraticIdentities[l].Laws[B.ring] ;
  c : R.R -> B.ring.R = B.iota.1 ;
  evaluate (p : Q.Pair) : B.ring.R = B.ring.add (c p.1) (B.ring.mul (c p.2) t) ;
  constants (b : R.R) : Id B.ring.R (evaluate (Q.constant b)) (c b) =
   trans (ap (\ z -> B.ring.add (c b) (B.ring.mul z t)) (RingHom[l].zero R B.ring B.iota))
    (trans (ap (B.ring.add (c b)) (L.zero-mul t)) (B.ring.addZ (c b))) ;
  variable : Id B.ring.R (evaluate Q.tau) t =
   trans (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (RingHom[l].zero R B.ring B.iota)
    (trans (ap (\ z -> B.ring.mul z t) B.iota.2.1) (trans (B.ring.mulC B.ring.o t) (B.ring.mulO t)))) (L.zl t) ;
  one : Id B.ring.R (evaluate Q.oneQ) B.ring.o = trans (constants R.o) B.iota.2.1 ;
  addition (p q : Q.Pair) : Id B.ring.R (evaluate (Q.plusQ p q)) (B.ring.add (evaluate p) (evaluate q)) =
   trans (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (B.iota.2.2.1 p.1 q.1)
    (ap (\ z -> B.ring.mul z t) (B.iota.2.2.1 p.2 q.2)))
    (I.affine-add (c p.1) (c p.2) (c q.1) (c q.2) t) ;
  first (p q : Q.Pair) : Id B.ring.R (c (Q.timesQ p q).1)
   (B.ring.add (B.ring.mul (c p.1) (c q.1)) (B.ring.mul (c a) (B.ring.mul (c p.2) (c q.2)))) =
   trans (B.iota.2.2.1 (R.mul p.1 q.1) (R.mul a (R.mul p.2 q.2)))
    (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (B.iota.2.2.2 p.1 q.1)
     (trans (B.iota.2.2.2 a (R.mul p.2 q.2)) (ap (B.ring.mul (c a)) (B.iota.2.2.2 p.2 q.2)))) ;
  second (p q : Q.Pair) : Id B.ring.R (c (Q.timesQ p q).2)
   (B.ring.add (B.ring.mul (c p.1) (c q.2)) (B.ring.mul (c p.2) (c q.1))) =
   trans (B.iota.2.2.1 (R.mul p.1 q.2) (R.mul p.2 q.1))
    (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (B.iota.2.2.2 p.1 q.2) (B.iota.2.2.2 p.2 q.1)) ;
  multiplication (p q : Q.Pair) : Id B.ring.R (evaluate (Q.timesQ p q)) (B.ring.mul (evaluate p) (evaluate q)) =
   trans (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (first p q) (ap (\ z -> B.ring.mul z t) (second p q)))
    (trans (ap (\ z -> B.ring.add (B.ring.add (B.ring.mul (c p.1) (c q.1)) z)
      (B.ring.mul (B.ring.add (B.ring.mul (c p.1) (c q.2)) (B.ring.mul (c p.2) (c q.1))) t))
     (trans (B.ring.mulC (c a) (B.ring.mul (c p.2) (c q.2)))
      (ap (B.ring.mul (B.ring.mul (c p.2) (c q.2))) (sym square))))
     (sym (I.affine-mul (c p.1) (c p.2) (c q.1) (c q.2) t))) ;
  hom : C.Hom Q.algebra B = ((evaluate,one,addition,multiplication),constants) ;
 } ;
 module AnyMap (B : C.Algebra) (g : C.Hom Q.algebra B) {
  root : Id B.ring.R (B.ring.mul (g.1.1 Q.tau) (g.1.1 Q.tau)) (B.iota.1 a) =
   trans (sym (g.1.2.2.2 Q.tau Q.tau)) (trans (ap g.1.1 Q.square) (g.2 a)) ;
  module E = At[B,g.1.1 Q.tau,root] ;
  on-basis (p : Q.Pair) : Id B.ring.R (g.1.1 p) (E.evaluate p) =
   trans (ap g.1.1 (sym (Q.basis p)))
    (trans (g.1.2.2.1 (Q.constant p.1) (Q.timesQ (Q.constant p.2) Q.tau))
     (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (g.2 p.1)
      (trans (g.1.2.2.2 (Q.constant p.2) Q.tau) (ap (\ z -> B.ring.mul z (g.1.1 Q.tau)) (g.2 p.2))))) ;
 } ;
} ;
