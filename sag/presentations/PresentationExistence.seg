-- Every presentation has an actual small representing R-algebra.
-- No existence or SQC axiom: the carrier is the quotient of expression syntax.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (pres : Presentations[l].Over[R,setR].Presentation) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module A = PresentedAlgebra[l].Over[R,setR,pres] ;
 module D = ExpressionCongruence[l].Over[R,setR,pres] ;
 module Sound = CongruenceSoundness[l].Over[R,setR,pres] ;
 module To (B : C.Algebra) {
  module At (s : P.Solutions pres B) {
   module E = Sound.At[B,s] ;
   module Descent = A.Q.Descend[B.ring.R,B.set,E.ev,E.respects] ;
   preserves-one : Id B.ring.R (Descent.map A.oneQ) B.ring.o =
    trans (Descent.beta (cst R.o)) B.iota.2.1 ;
   preserves-add : (x y : A.Carrier) ->
    Id B.ring.R (Descent.map (A.addQ x y)) (B.ring.add (Descent.map x) (Descent.map y)) =
    A.forall2 (\ x y -> Id B.ring.R (Descent.map (A.addQ x y)) (B.ring.add (Descent.map x) (Descent.map y)))
     (\ x y -> B.set _ _) (\ p q ->
      trans (ap Descent.map (A.Addition.beta p q))
       (trans (Descent.beta (sumE p q))
        (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (sym (Descent.beta p)) (sym (Descent.beta q))))) ;
   preserves-mul : (x y : A.Carrier) ->
    Id B.ring.R (Descent.map (A.mulQ x y)) (B.ring.mul (Descent.map x) (Descent.map y)) =
    A.forall2 (\ x y -> Id B.ring.R (Descent.map (A.mulQ x y)) (B.ring.mul (Descent.map x) (Descent.map y)))
     (\ x y -> B.set _ _) (\ p q ->
      trans (ap Descent.map (A.Multiplication.beta p q))
       (trans (Descent.beta (mulE p q))
        (Presentations[l].cong2 B.ring.R B.ring.mul _ _ _ _ (sym (Descent.beta p)) (sym (Descent.beta q))))) ;
   hom : C.Hom A.algebra B =
    ((Descent.map,preserves-one,preserves-add,preserves-mul),\ r -> Descent.beta (cst r)) ;
  } ;
  extend (s : P.Solutions pres B) : C.Hom A.algebra B = At[s].hom ;
  forward : C.Hom A.algebra B -> P.Solutions pres B = P.canonical pres A.algebra A.solution B ;
  fb (s : P.Solutions pres B) : Id (P.Solutions pres B) (forward (extend s)) s =
   P.solutions-ext pres B _ s (\ v -> At[s].Descent.beta (var v)) ;
  module Recover (g : C.Hom A.algebra B) {
   module E = At[forward g] ;
   raw-unique : (p : D.Term) -> Id B.ring.R (E.E.ev p) (g.1.1 (A.include p)) = split {
    var v -> refl (g.1.1 (A.generators v)) ; cst r -> sym (g.2 r) ;
    sumE p q | rp rq ->
     trans (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ rp rq)
      (trans (sym (g.1.2.2.1 (A.include p) (A.include q))) (ap g.1.1 (A.Addition.beta p q))) ;
    mulE p q | rp rq ->
     trans (Presentations[l].cong2 B.ring.R B.ring.mul _ _ _ _ rp rq)
      (trans (sym (g.1.2.2.2 (A.include p) (A.include q))) (ap g.1.1 (A.Multiplication.beta p q))) } ;
   pointwise : (x : A.Carrier) -> Id B.ring.R (E.Descent.map x) (g.1.1 x) =
    A.Q.induction @l (\ x -> Id B.ring.R (E.Descent.map x) (g.1.1 x)) (\ x -> B.set _ _)
     (\ p -> trans (E.Descent.beta p) (raw-unique p)) ;
  } ;
  bf (g : C.Hom A.algebra B) : Id (C.Hom A.algebra B) (extend (forward g)) g =
   C.ext A.algebra B (extend (forward g)) g Recover[g].pointwise ;
  universal : Pr.isEquiv (C.Hom A.algebra B) (P.Solutions pres B) (P.canonical pres A.algebra A.solution B) =
   Pr.qinv _ _ forward extend fb bf ;
 } ;
 presentation : P.Presents pres A.algebra = (A.solution,\ B -> To[B].universal) ;
 existence : (B : C.Algebra) * P.Presents pres B = (A.algebra,presentation) ;
 finitely-presented : P.FP A.algebra = Truncation[l+].Trunc[P.Witness A.algebra].inc (pres,presentation) ;
 -- Expression representatives are also available merely, without choosing
 -- normal forms or assuming decidable equality in R.
 Representatives (x : A.Carrier) : U l = (e : D.Term) * Id A.Carrier (A.include e) x ;
 generated (x : A.Carrier) : Truncation[l].Trunc[Representatives x].carrier =
  A.Q.induction @l (\ x -> Truncation[l].Trunc[Representatives x].carrier)
   (\ x -> Truncation[l].Trunc[Representatives x].proposition)
   (\ e -> Truncation[l].Trunc[Representatives (A.include e)].inc (e,refl (A.include e))) x ;
} ;
