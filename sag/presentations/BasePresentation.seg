-- The base algebra is presented by no generators and no equations.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 empty : P.Presentation = (zero,nil) ;
 no-values (B : C.Algebra) : Presentations[l].Fin zero -> B.ring.R = split {} ;
 generators : P.Solutions empty C.base = (no-values C.base,tt) ;
 module To (B : C.Algebra) {
  arrow : C.Hom C.base B = (B.iota,\ r -> refl (B.iota.1 r)) ;
  inverse (s : P.Solutions empty B) : C.Hom C.base B = arrow ;
  empty-path (s : P.Solutions empty B) : (v : Presentations[l].Fin zero) ->
   Id B.ring.R ((P.canonical empty C.base generators B arrow).1 v) (s.1 v) = split {} ;
  fb (s : P.Solutions empty B) : Id (P.Solutions empty B) (P.canonical empty C.base generators B (inverse s)) s =
   P.solutions-ext empty B _ s (empty-path s) ;
  bf (g : C.Hom C.base B) : Id (C.Hom C.base B) (inverse (P.canonical empty C.base generators B g)) g =
   C.ext C.base B arrow g (\ r -> sym (g.2 r)) ;
  universal : Pr.isEquiv (C.Hom C.base B) (P.Solutions empty B) (P.canonical empty C.base generators B) =
   Pr.qinv _ _ (P.canonical empty C.base generators B) inverse fb bf ;
 } ;
 presentation : P.Presents empty C.base = (generators,\ B -> To[B].universal) ;
 finitely-presented : P.FP C.base = Truncation[l+].Trunc[P.Witness C.base].inc (empty,presentation) ;
} ;
