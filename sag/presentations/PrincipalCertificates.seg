-- Explicit witnesses that x-y belongs to the principal ideal (f).
-- These witnesses compose without choice or truncation elimination.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (f : A.R) {
 open A ; open RL[A] ;
 Certificate (x y : R) : U l = (r : R) * Id R x (add y (mul f r)) ;
 equal (x y : R) (h : Id R x y) : Certificate x y =
  (z,trans h (sym (add-mulzero y f))) ;
 reflexive (x : R) : Certificate x x = equal x x (refl x) ;
 symmetric (x y : R) (h : Certificate x y) : Certificate y x =
  (neg h.1,sym (calc R {
   add x (mul f (neg h.1))
    =< ap (\ t -> add t (mul f (neg h.1))) h.2 > add (add y (mul f h.1)) (mul f (neg h.1))
    =< ap (add (add y (mul f h.1))) (mul-neg f h.1) > add (add y (mul f h.1)) (neg (mul f h.1))
    =< add-neg-cancel y (mul f h.1) > y })) ;
 transitive (x y w : R) (h : Certificate x y) (k : Certificate y w) : Certificate x w =
  (add k.1 h.1,calc R {
   x =< h.2 > add y (mul f h.1)
     =< ap (\ t -> add t (mul f h.1)) k.2 > add (add w (mul f k.1)) (mul f h.1)
     =< sym (addA w (mul f k.1) (mul f h.1)) > add w (add (mul f k.1) (mul f h.1))
     =< ap (add w) (sym (dist f k.1 h.1)) > add w (mul f (add k.1 h.1)) }) ;
 addition (x y u v : R) (h : Certificate x y) (k : Certificate u v) : Certificate (add x u) (add y v) =
  (add h.1 k.1,calc R {
   add x u =< Presentations[l].cong2 R add _ _ _ _ h.2 k.2 > add (add y (mul f h.1)) (add v (mul f k.1))
     =< swap y (mul f h.1) v (mul f k.1) > add (add y v) (add (mul f h.1) (mul f k.1))
     =< ap (add (add y v)) (sym (dist f h.1 k.1)) > add (add y v) (mul f (add h.1 k.1)) }) ;
 multiplication (x y u v : R) (h : Certificate x y) (k : Certificate u v) : Certificate (mul x u) (mul y v) =
  (add (mul y k.1) (mul h.1 u),calc R {
   mul x u =< ap (\ t -> mul t u) h.2 > mul (add y (mul f h.1)) u
     =< QuadraticIdentities[l].Laws[A].dist-left y (mul f h.1) u > add (mul y u) (mul (mul f h.1) u)
     =< ap (\ t -> add (mul y t) (mul (mul f h.1) u)) k.2 > add (mul y (add v (mul f k.1))) (mul (mul f h.1) u)
     =< ap (\ t -> add t (mul (mul f h.1) u)) (dist y v (mul f k.1))
      > add (add (mul y v) (mul y (mul f k.1))) (mul (mul f h.1) u)
     =< Presentations[l].cong2 R add _ _ _ _ (ap (add (mul y v)) (mul-swap y f k.1)) (sym (mulA f h.1 u))
      > add (add (mul y v) (mul f (mul y k.1))) (mul f (mul h.1 u))
     =< sym (addA (mul y v) (mul f (mul y k.1)) (mul f (mul h.1 u)))
      > add (mul y v) (add (mul f (mul y k.1)) (mul f (mul h.1 u)))
     =< ap (add (mul y v)) (sym (dist f (mul y k.1) (mul h.1 u)))
      > add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))) }) ;
 generator : Certificate f z = (o,sym (trans (ap (add z) (mulO f)) (zl f))) ;
} ;
