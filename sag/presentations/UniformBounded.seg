-- SAG 3.3.3 from ONE uniform SQC hypothesis and 1 != 0.
-- Polynomial closure of finite presentability discharges both SQC instances.
-- The coefficient argument is the unchanged snapshot CoefficientBound.seg.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
module Theorem (R : CRing) (setR : Pr.isSet R.R)
 (one-nz : Not (Id R.R R.o R.z))
 (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AV = AddVariable[l].Over[R,setR] ;
 module RP = Poly[l].PolyR[R] ;
 module RX = C.Polynomial[C.base] ;
 r-fp : P.FP C.base = BasePresentation[l].Over[R,setR].finitely-presented ;
 rx-fp : P.FP RX.algebra = AV.preserves-FP C.base r-fp ;
 sqc-RX : Pr.isEquiv RX.X.Carrier (C.Spec RX.algebra -> R.R) (C.evaluation RX.algebra) =
  sqc RX.algebra rx-fp ;

 module AtBasePoint (g : C.Spec RX.algebra) {
  t : R.R = g.1.1 RX.X.variable ;
  raw-value : (p : RP.P) -> Id R.R (g.1.1 (RX.X.include p)) (RP.ev p t) = split {
   nil -> RingHom[l].zero RX.X.ring R g.1 ;
   cons a p | ih -> calc R.R {
    g.1.1 (RX.X.include (cons a p))
     =< ap g.1.1 (RX.X.horner a p) > g.1.1 (RX.X.addQ (RX.X.constant a) (RX.X.mulQ RX.X.variable (RX.X.include p)))
     =< g.1.2.2.1 (RX.X.constant a) (RX.X.mulQ RX.X.variable (RX.X.include p))
       > R.add (g.1.1 (RX.X.constant a)) (g.1.1 (RX.X.mulQ RX.X.variable (RX.X.include p)))
     =< ap (R.add (g.1.1 (RX.X.constant a))) (g.1.2.2.2 RX.X.variable (RX.X.include p))
       > R.add (g.1.1 (RX.X.constant a)) (R.mul t (g.1.1 (RX.X.include p)))
     =< ap (\ b -> R.add b (R.mul t (g.1.1 (RX.X.include p)))) (g.2 a)
       > R.add a (R.mul t (g.1.1 (RX.X.include p)))
     =< ap (\ b -> R.add a (R.mul t b)) ih > R.add a (R.mul t (RP.ev p t)) } } ;
 } ;
 -- Injectivity of polynomial functions, now derived from uniform SQC.
 coefficients (p q : RP.P) (h : (t : R.R) -> Id R.R (RP.ev p t) (RP.ev q t)) : RP.peq p q =
  RX.X.Q.effective p q
   (Equivalences[l].injective RX.X.Carrier (C.Spec RX.algebra -> R.R) (C.evaluation RX.algebra) sqc-RX
    (RX.X.include p) (RX.X.include q)
    (F.funext (C.Spec RX.algebra) (\ g -> R.R) _ _ (\ g ->
     trans (AtBasePoint[g].raw-value p)
      (trans (h (AtBasePoint[g].t)) (sym (AtBasePoint[g].raw-value q)))))) ;

 module ForAlgebra (A : C.Algebra) (fp : P.FP A) {
  module AX = C.Polynomial[A] ;
  module UP = AX.To[C.base] ;
  ax-fp : P.FP AX.algebra = AV.preserves-FP A fp ;
  sqc-AX : Pr.isEquiv AX.X.Carrier (C.Spec AX.algebra -> R.R) (C.evaluation AX.algebra) = sqc AX.algebra ax-fp ;
  -- Adapter to the existing coefficient proof; no extra assumptions.
  legacy : CB.RAlg[R] = CB.mkRAlg R A.ring A.iota.1 ;
  module Old = CB.SpecM[R,legacy] ;
  to-spec (x : Old.Spec) : C.Spec A = ((x.1,x.2.1,x.2.2.1,x.2.2.2.1),x.2.2.2.2) ;
  from-spec (x : C.Spec A) : Old.Spec = (x.1.1,x.1.2.1,x.1.2.2.1,x.1.2.2.2,x.2) ;
  module At (x : Old.Spec) (t : R.R) {
   module Ev = Evaluation[l].Evaluate[A.ring,R,A.set,setR,(to-spec x).1,t] ;
   point : C.Spec AX.algebra = UP.backward (to-spec x,t) ;
   raw-evaluation : (p : List A.ring.R) -> Id R.R (RP.ev (Old.mapc x.1 p) t) (Ev.E p) = split {
    nil -> refl R.z ; cons a p | ih -> ap (\ b -> R.add (x.1 a) (R.mul t b)) ih } ;
   beta (H : Old.Spec -> R.R -> R.R) :
    Id R.R (H (from-spec (UP.forward point).1) (UP.forward point).2) (H x t) =
    Pr.ap UP.Data R.R (\ d -> H (from-spec d.1) d.2) _ _ (UP.fb (to-spec x,t)) ;
  } ;
  G (H : Old.Spec -> R.R -> R.R) (g : C.Spec AX.algebra) : R.R =
   H (from-spec (UP.forward g).1) (UP.forward g).2 ;
  polynomial (H : Old.Spec -> R.R -> R.R) : AX.X.Carrier = sqc-AX.sec (G H) ;
  represents (H : Old.Spec -> R.R -> R.R) (g : C.Spec AX.algebra) :
   Id R.R (g.1.1 (polynomial H)) (G H g) =
   Pr.happly (C.Spec AX.algebra) (\ g -> R.R) _ _ (sqc-AX.sec-eq (G H)) g ;
  Representatives (q : AX.X.Carrier) : U l =
   (p : List A.ring.R) * Id AX.X.Carrier (AX.X.include p) q ;
  raw-representative (q : AX.X.Carrier) : Tr.Trunc[Representatives q].carrier =
   AX.X.Q.induction @l (\ q -> Tr.Trunc[Representatives q].carrier)
    (\ q -> Tr.Trunc[Representatives q].proposition)
    (\ p -> Tr.Trunc[Representatives (AX.X.include p)].inc (p,refl (AX.X.include p))) q ;
  raw-rep (H : Old.Spec -> R.R -> R.R) (w : Representatives (polynomial H)) : Old.Rep H =
   (w.1,\ x t -> calc R.R {
    RP.ev (Old.mapc x.1 w.1) t
     =< At[x,t].raw-evaluation w.1 > At[x,t].Ev.E w.1
     =< sym (At[x,t].Ev.D.beta w.1) > At[x,t].point.1.1 (AX.X.include w.1)
     =< ap At[x,t].point.1.1 w.2 > At[x,t].point.1.1 (polynomial H)
     =< represents H At[x,t].point > G H At[x,t].point
     =< At[x,t].beta H > H x t }) ;
  represent-function (H : Old.Spec -> R.R -> R.R) : Tr.Trunc[Old.Rep H].carrier =
   Tr.Trunc[Representatives (polynomial H)].induction @l (\ t -> Tr.Trunc[Old.Rep H].carrier)
    (\ t -> Tr.Trunc[Old.Rep H].proposition) (\ w -> Tr.Trunc[Old.Rep H].inc (raw-rep H w))
    (raw-representative (polynomial H)) ;
  module Bound = CB.BoundedM[R,legacy,one-nz,represent-function,coefficients] ;
  Goal (f : C.Spec A -> Nat) : U l = (N : Nat) * ((x : C.Spec A) -> CB.le (f x) N) ;
  theorem (f : C.Spec A -> Nat) : Tr.Trunc[Goal f].carrier =
   Tr.Trunc[Bound.ForF[\ x -> f (to-spec x)].Goal].induction @l (\ t -> Tr.Trunc[Goal f].carrier)
    (\ t -> Tr.Trunc[Goal f].proposition)
    (\ w -> Tr.Trunc[Goal f].inc (w.1,\ x -> w.2 (from-spec x)))
    (Bound.theorem-3-3-3 (\ x -> f (to-spec x))) ;
 } ;
} ;
