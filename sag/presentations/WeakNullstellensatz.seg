-- SAG 2.2.2. The forward implication uses SQC; only the converse
-- needs the nontriviality part of Loc.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 empty-collapse (A : C.Algebra) (fp : P.FP A) (empty : C.Spec A -> Empty) : Id A.ring.R A.ring.o A.ring.z =
  Equivalences[l].injective A.ring.R (C.Spec A -> R.R) (C.evaluation A) (sqc A fp) A.ring.o A.ring.z
   (F.funext (C.Spec A) (\ x -> R.R) _ _ (\ x -> efq (empty x))) ;
 collapse-empty (one-nz : Not (Id R.R R.o R.z)) (A : C.Algebra)
  (collapsed : Id A.ring.R A.ring.o A.ring.z) (x : C.Spec A) : Empty =
  one-nz (trans (sym x.1.2.1) (trans (ap x.1.1 collapsed) (RingHom[l].zero A.ring R x.1))) ;
 all-equal (A : C.Algebra) (collapsed : Id A.ring.R A.ring.o A.ring.z) (x y : A.ring.R) : Id A.ring.R x y =
  trans (sym (A.ring.mulO x))
   (trans (ap (A.ring.mul x) collapsed)
    (trans (RL[A.ring].mul-zero x)
     (sym (trans (sym (A.ring.mulO y)) (trans (ap (A.ring.mul y) collapsed) (RL[A.ring].mul-zero y)))))) ;
} ;
