-- Uniform SQC turns the rank-two algebra calculation into a theorem
-- about ALL functions on the square roots of a, including a=0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ;
module Functions (X Y Z : U l) (e : Pr.Equiv X Y) {
 forward (f : X -> Z) (y : Y) : Z = f (e.2.sec y) ;
 backward (g : Y -> Z) (x : X) : Z = g (e.1 x) ;
 fb (g : Y -> Z) : Id (Y -> Z) (forward (backward g)) g =
  F.funext Y (\ y -> Z) _ g (\ y -> ap g (e.2.sec-eq y)) ;
 bf (f : X -> Z) : Id (X -> Z) (backward (forward f)) f =
  F.funext X (\ x -> Z) _ f (\ x -> ap f (Pr.sec-ret X Y e.1 e.2 x)) ;
 equivalence : Pr.Equiv (X -> Z) (Y -> Z) = (forward,Pr.qinv _ _ forward backward fb bf) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) (a : R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module N = QuadraticNormalForm[l].Over[R,setR,a] ;
 module J = QuadraticPresentation[l].Over[R,setR,a] ;
 module RT = J.Roots[C.base] ;
 Root : U l = RT.Root ;
 spectrum : Pr.Equiv (C.Spec N.K.A.algebra) Root =
  E.compose _ _ _ (N.K.To[C.base].forward,N.K.To[C.base].universal) RT.equivalence ;
 module Transport = Functions[C.Spec N.K.A.algebra,Root,R.R,spectrum] ;
 evaluation : Pr.Equiv N.K.A.Carrier (C.Spec N.K.A.algebra -> R.R) =
  (C.evaluation N.K.A.algebra,sqc N.K.A.algebra N.K.finitely-presented) ;
 chain : Pr.Equiv N.Q.Pair (Root -> R.R) =
  E.compose _ _ _ N.normal-form (E.compose _ _ _ evaluation Transport.equivalence) ;
 affine (p : N.Q.Pair) (r : Root) : R.R = R.add p.1 (R.mul p.2 r.1) ;
 at-point (g : C.Spec N.K.A.algebra) (p : N.Q.Pair) :
  Id R.R (g.1.1 (N.represent p)) (R.add p.1 (R.mul p.2 (g.1.1 N.variable))) =
  trans (g.1.2.2.1 (N.K.A.constant p.1) (N.K.A.mulQ (N.K.A.constant p.2) N.variable))
   (Presentations[l].cong2 R.R R.add _ _ _ _ (g.2 p.1)
    (trans (g.1.2.2.2 (N.K.A.constant p.2) N.variable) (ap (\ b -> R.mul b (g.1.1 N.variable)) (g.2 p.2)))) ;
 pointwise (p : N.Q.Pair) (r : Root) : Id R.R (chain.1 p r) (affine p r) =
  trans (at-point (spectrum.2.sec r) p)
   (ap (\ t -> R.add p.1 (R.mul p.2 t))
    (Pr.ap Root R.R (\ x -> x.1) _ _ (spectrum.2.sec-eq r))) ;
 -- The equivalence's forward map is exactly (b,c) |-> (x |-> b+c*x).
 affine-equivalence : Pr.Equiv (R.R * R.R) (Root -> R.R) =
  (affine,E.homotopy _ _ chain affine
   (\ p -> F.funext Root (\ r -> R.R) _ _ (\ r -> sym (pointwise p r)))) ;
 coefficients (f : Root -> R.R) : R.R * R.R = affine-equivalence.2.sec f ;
 formula (f : Root -> R.R) (r : Root) :
  Id R.R (f r) (R.add (coefficients f).1 (R.mul (coefficients f).2 r.1)) =
  sym (Pr.happly Root (\ r -> R.R) _ _ (affine-equivalence.2.sec-eq f) r) ;
 coefficient-beta (p : R.R * R.R) : Id (R.R * R.R) (coefficients (affine p)) p =
  Pr.sec-ret _ _ affine affine-equivalence.2 p ;
 unique (p q : R.R * R.R) (h : (r : Root) -> Id R.R (affine p r) (affine q r)) : Id (R.R * R.R) p q =
  E.injective _ _ affine affine-equivalence.2 p q (F.funext Root (\ r -> R.R) _ _ h) ;
} ;
