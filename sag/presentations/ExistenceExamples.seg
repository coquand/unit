-- Integration regressions for existence, compared with independent algebras.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module BP = BasePresentation[l].Over[R,setR] ;
 module AV = AddVariable[l].Over[R,setR] ;
 module Ex = Examples[l].Over[R,setR] ;
 module EmptyPresentation = PresentationExistence[l].Over[R,setR,BP.empty] ;
 module EmptyComparison = PresentationComparison[l].Over[R,setR,BP.empty,
  EmptyPresentation.A.algebra,C.base,EmptyPresentation.presentation,BP.presentation] ;
 empty-is-base : Pr.Equiv EmptyPresentation.A.Carrier R.R = EmptyComparison.equivalence ;
 module FreeOne = PresentationExistence[l].Over[R,setR,AV.added BP.empty] ;
 module FreeComparison = PresentationComparison[l].Over[R,setR,AV.added BP.empty,
  FreeOne.A.algebra,Ex.RX.algebra,FreeOne.presentation,Ex.line-presentation] ;
 free-is-polynomial : Pr.Equiv FreeOne.A.Carrier Ex.RX.X.Carrier = FreeComparison.equivalence ;
 free-generator : Id Ex.RX.X.Carrier (FreeComparison.forward.1.1 (FreeOne.A.generators (inr tt))) Ex.RX.X.variable =
  FreeComparison.forward-generators (inr tt) ;
 module KilledGenerator = PresentationExistence[l].Over[R,setR,Ex.zero-relation] ;
 module KillComparison = PresentationComparison[l].Over[R,setR,Ex.zero-relation,
  KilledGenerator.A.algebra,C.base,KilledGenerator.presentation,Ex.zero-presentation] ;
 killed-is-base : Pr.Equiv KilledGenerator.A.Carrier R.R = KillComparison.equivalence ;
 generator-is-zero : Id KilledGenerator.A.Carrier (KilledGenerator.A.generators (inr tt)) KilledGenerator.A.zeroQ =
  trans (sym (KilledGenerator.A.reify (var (inr tt)))) KilledGenerator.A.solution.2.1 ;

 -- An inconsistent presentation still exists: imposing 1=0 yields the zero ring.
 collapsed : P.Presentation = (zero,cons (cst R.o) nil) ;
 module Zero = PresentationExistence[l].Over[R,setR,collapsed] ;
 one-is-zero : Id Zero.A.Carrier Zero.A.oneQ Zero.A.zeroQ =
  trans (sym (Zero.A.reify (cst R.o))) Zero.A.solution.2.1 ;
 every-element-zero (x : Zero.A.Carrier) : Id Zero.A.Carrier x Zero.A.zeroQ =
  trans (sym (Zero.A.ring.mulO x))
   (trans (ap (Zero.A.ring.mul x) one-is-zero) (RL[Zero.A.ring].mul-zero x)) ;

 -- Validity rejects composition of trees whose syntactic endpoints disagree.
 module Trees = ExpressionCongruence[l].Over[R,setR,AV.added BP.empty] ;
 #fails {
  bad-composition : Trees.Valid (transD (reflD (var (inr tt))) (reflD (cst R.z))) =
   (tt,tt,refl (var (inr tt))) ;
 } ;
 -- This check exercises genuine transitivity, not just a single axiom leaf.
 composed : Trees.Relation (sumE (cst R.z) (cst R.z)) (cst R.z) =
  Trees.transitive (sumE (cst R.z) (cst R.z)) (cst (R.add R.z R.z)) (cst R.z) (Trees.witness (coeffAdd R.z R.z) tt)
   (Truncation[l].Trunc[Trees.Proof (cst (R.add R.z R.z)) (cst R.z)].inc
    (reflD (cst (R.add R.z R.z)),tt,refl (cst (R.add R.z R.z)),Pr.ap R.R Trees.Term (\ r -> cst r) (R.add R.z R.z) R.z (R.addZ R.z))) ;
} ;
