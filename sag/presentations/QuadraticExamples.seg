-- Regression instances, including the first-order disk of SAG Example 6.1.9.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Zero = QuadraticNormalForm[l].Over[R,setR,R.z] ;
 module One = QuadraticNormalForm[l].Over[R,setR,R.o] ;
 dual-numbers : Pr.Equiv (R.R * R.R) Zero.K.A.Carrier = Zero.normal-form ;
 square-one : Pr.Equiv (R.R * R.R) One.K.A.Carrier = One.normal-form ;
 nilpotent-generator : Id Zero.K.A.Carrier (Zero.K.A.mulQ Zero.variable Zero.variable) Zero.K.A.zeroQ = Zero.variable-square ;
 squared-generator : Id One.K.A.Carrier (One.K.A.mulQ One.variable One.variable) One.K.A.oneQ = One.variable-square ;
 generator-coefficients : Id (R.R * R.R) (Zero.coefficients Zero.variable) (R.z,R.o) =
  trans (ap Zero.coefficients (sym Zero.Represent.variable)) (Zero.coefficient-beta (R.z,R.o)) ;
 constant-coefficients (b : R.R) : Id (R.R * R.R) (Zero.coefficients (Zero.K.A.constant b)) (b,R.z) =
  trans (ap Zero.coefficients (sym (Zero.Represent.constants b))) (Zero.coefficient-beta (b,R.z)) ;
 module Disk (sqc : P.SQC) {
  module Functions = QuadraticFunctions[l].Over[R,setR,R.z,sqc] ;
  D : U l = (x : R.R) * Id R.R (R.mul x x) R.z ;
  origin : D = (R.z,RL[R].mul-zero R.z) ;
  affine-functions : Pr.Equiv (R.R * R.R) (D -> R.R) = Functions.affine-equivalence ;
  slope (f : D -> R.R) : R.R = (Functions.coefficients f).2 ;
  at-origin (f : D -> R.R) : Id R.R (f origin) (Functions.coefficients f).1 =
   trans (Functions.formula f origin) (RL[R].add-mulzero (Functions.coefficients f).1 (slope f)) ;
  first-order (f : D -> R.R) (d : D) : Id R.R (f d) (R.add (f origin) (R.mul (slope f) d.1)) =
   trans (Functions.formula f d) (ap (\ b -> R.add b (R.mul (slope f) d.1)) (sym (at-origin f))) ;
  slope-of-affine (b c : R.R) : Id R.R (slope (\ d -> R.add b (R.mul c d.1))) c =
   Pr.ap (R.R * R.R) R.R (\ p -> p.2) _ _ (Functions.coefficient-beta (b,c)) ;
  unique-slope (f : D -> R.R) (c : R.R)
   (h : (d : D) -> Id R.R (f d) (R.add (f origin) (R.mul c d.1))) : Id R.R (slope f) c =
   Pr.ap (R.R * R.R) R.R (\ p -> p.2) _ _
    (Functions.unique (Functions.coefficients f) (f origin,c) (\ d -> trans (sym (Functions.formula f d)) (h d))) ;
 } ;
} ;
