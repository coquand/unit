-- Unital homomorphisms of commutative rings, with their laws included.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
AddLaw (A B : CRing) (f : A.R -> B.R) : U l = (a b : A.R) -> Id B.R (f (A.add a b)) (B.add (f a) (f b)) ;
MulLaw (A B : CRing) (f : A.R -> B.R) : U l = (a b : A.R) -> Id B.R (f (A.mul a b)) (B.mul (f a) (f b)) ;
Preserves (A B : CRing) (f : A.R -> B.R) : U l =
  Id B.R (f A.o) B.o *
  ((a b : A.R) -> Id B.R (f (A.add a b)) (B.add (f a) (f b))) *
  ((a b : A.R) -> Id B.R (f (A.mul a b)) (B.mul (f a) (f b))) ;
Hom (A B : CRing) : U l = (f : A.R -> B.R) * Preserves A B f ;
module Properties (A B : CRing) (setB : Pr.isSet B.R) {
 prop (f : A.R -> B.R) : Pr.isProp (Preserves A B f) =
  Pr.isProp-Sigma (Id B.R (f A.o) B.o) (\ ho -> AddLaw A B f * MulLaw A B f) (setB (f A.o) B.o) (\ ho ->
   Pr.isProp-Sigma (AddLaw A B f) (\ ha -> MulLaw A B f)
    (F.isProp-Pi A.R (\ a -> (b : A.R) -> Id B.R (f (A.add a b)) (B.add (f a) (f b)))
      (\ a -> F.isProp-Pi A.R (\ b -> Id B.R (f (A.add a b)) (B.add (f a) (f b))) (\ b -> setB _ _)))
    (\ ha -> F.isProp-Pi A.R (\ a -> (b : A.R) -> Id B.R (f (A.mul a b)) (B.mul (f a) (f b)))
      (\ a -> F.isProp-Pi A.R (\ b -> Id B.R (f (A.mul a b)) (B.mul (f a) (f b))) (\ b -> setB _ _)))) ;
 set : Pr.isSet (Hom A B) =
   Pr.isSet-Sigma (A.R -> B.R) (Preserves A B)
    (F.isSet-Pi A.R (\ a -> B.R) (\ a -> setB))
    (\ f -> Pr.prop-to-set (Preserves A B f) (prop f)) ;
 ext (f g : Hom A B) (h : (a : A.R) -> Id B.R (f.1 a) (g.1 a)) : Id (Hom A B) f g =
   Pr.Sigma-eq (A.R -> B.R) (Preserves A B) f.1 g.1 f.2 g.2
    (F.funext A.R (\ a -> B.R) f.1 g.1 h) (prop g.1) ;
} ;
identity (A : CRing) : Hom A A = (\ a -> a,refl A.o,\ a b -> refl (A.add a b),\ a b -> refl (A.mul a b)) ;
compose (A B C : CRing) (g : Hom B C) (f : Hom A B) : Hom A C =
 (\ a -> g.1 (f.1 a),trans (ap g.1 f.2.1) g.2.1,
  \ a b -> trans (ap g.1 (f.2.2.1 a b)) (g.2.2.1 (f.1 a) (f.1 b)),
  \ a b -> trans (ap g.1 (f.2.2.2 a b)) (g.2.2.2 (f.1 a) (f.1 b))) ;
zero (A B : CRing) (f : Hom A B) : Id B.R (f.1 A.z) B.z =
 RL[B].add-cancel (f.1 A.z) (f.1 A.z)
  (trans (sym (f.2.2.1 A.z A.z)) (ap f.1 (A.addZ A.z))) ;
negation (A B : CRing) (f : Hom A B) (a : A.R) : Id B.R (f.1 (A.neg a)) (B.neg (f.1 a)) =
 RL[B].neg-uniq (f.1 a) (f.1 (A.neg a))
  (trans (sym (f.2.2.1 a (A.neg a))) (trans (ap f.1 (A.addN a)) (zero A B f))) ;
