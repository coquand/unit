-- Base.seg: the small data types.  They belong to every universe, so
-- MODEL.Lv.Base (Lift, Base, base0, baseLift) has no counterpart here: it
-- existed only because Agda has no cumulativity.

data Top = tt ;
data Empty = ;
data Bool = true | false ;
data Nat = zero | suc (n : Nat) ;

-- These Boolean operations have one level-independent definition. Files
-- using their laws at different universe levels share the same code.
and : Bool -> Bool -> Bool = split { true -> \ b -> b ; false -> \ b -> false } ;
or : Bool -> Bool -> Bool = split { true -> \ b -> true ; false -> \ b -> b } ;
not : Bool -> Bool = split { true -> false ; false -> true } ;
leb : Nat -> Nat -> Bool = split {
  zero -> \ n -> true ;
  suc m | r -> split { zero -> false ; suc n -> r n } } ;
eqN : Nat -> Nat -> Bool = split {
  zero -> split { zero -> true ; suc n -> false } ;
  suc m | r -> split { zero -> false ; suc n -> r n } } ;

isTop : (u v : Top) -> Id Top u v = split { tt -> split { tt -> refl tt } } ;
