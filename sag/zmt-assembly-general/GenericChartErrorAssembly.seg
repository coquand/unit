-- Assemble actual local ideal-power and original-equation witnesses.
-- Finite products bundle the explicit I-power trees; the linear assembly
-- transports them. Each J multiplier is assembled at its shifted twist,
-- and polynomial multiplication is checked coefficientwise on every face.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ;
module L=GenericLaurent[l] ; module K=GenericDegree[l] ; module PA=PolynomialAction4[l] ;
module ChartSums (A : CRing) (setA : Pr.isSet A.R) (Ex I : U l) (Bad : I -> Ex -> U l) {
 module C=L.Over[A,setA].Chart[Ex,I,Bad] ; module S=Comb[l].Sums[A,C.mod] ; module R=Comb[l].Sums[A,IP.regular A] ;
 value : (n : Nat) (xs : Ps.Fin n -> C.El) (i : I) (m : Ex) ->
  Id A.R (C.val (S.sum n xs) i m) (R.sum n (\j -> C.val (xs j) i m))=split {
   zero -> \xs i m -> refl A.z ; suc n | rec -> \xs i m -> ap (A.add (C.val (xs (inr tt)) i m)) (rec (\j -> xs (inl j)) i m) } ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (I : U l) (face : I -> Sub n) (r : Int)
 (card : (i : I) -> Id Int (K.card n (face i)) r)
 (classify : (s : Sub n) -> Id Int (K.card n s) r -> (i : I)*Id (Sub n) (face i) s)
 (injective : (i j : I) -> Id (Sub n) (face i) (face j) -> Id I i j)
 (t : Nat) (b : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term n))
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e q)) (p q)) (k : Int) {
 module J=GenericReesChart[l].Over[A,setA,n,t,b,s,p,e,hp] ; module CJ=J.At[k,r] ;
 module CS=GenericChartFamilyAssembly[l].Over[A,setA,n,I,face,r,card,classify,injective,k] ;
 module PI=ProductIdealWitnesses[l].Over[A,I,\i -> CS.Local[i].C.mod,t,b] ;
 module LL=RelationCertificate[l].LinL[A,CS.P.mod,CJ.Target.mod,CS.linear] ;
 module Transport=IdealPowerWitnessTransport[l].Over[A,A,CS.P.mod,CJ.Target.mod,t,b,b,CS.assemble,LL.f-zero,CS.linear.f-add,\j x -> CS.linear.f-sm (b j) x] ;
 module GlobalS=ChartSums[A,setA,L.Exp n,Sub n,GenericCech[l].Bad n k r] ;
 module Local (i : I) {
  module Ideal=GenericChartIdeal[l].Over[A,setA,n,face i,t,b,s,p,e,J.hp-shift,Sub n,k] ;
  module Q=Ideal.Q ; module S=ChartSums[A,setA,L.Exp n,Sub n,\u -> NativeDegreePart[l].Bad n (face i) k] ;
 } ;
 module Shift (q : Ps.Fin s) {
  module C=GenericChartFamilyAssembly[l].Over[A,setA,n,I,face,r,card,classify,injective,PA.minus k (e q)] ;
 } ;
 module JFamily (x : CS.P.El) (h : (i : I) -> Local[i].Q.JW (x i)) {
  coefficients (q : Ps.Fin s) : (CJ.Source.Md q).M=Shift[q].C.assemble (\i -> (h i).1 q) ;
  equation : Id CJ.Target.El (CS.assemble x) (CJ.action.f coefficients)=CS.ext _ _ (\i m ->
   trans (CS.value x i m)
    (trans (ap (\y -> Local[i].Ideal.Target.val y (face i) m) (h i).2)
     (trans (Local[i].S.value s (\q -> (Local[i].Ideal.entry q).f ((h i).1 q)) (face i) m)
      (trans (GlobalS.R.sum-cong s
       (\q -> J.C.A.mulP (p q) (Shift[q].C.Local[i].C.val ((h i).1 q) (face i)) m)
       (\q -> J.C.A.mulP (p q) (Shift[q].C.CH.val (coefficients q) (face i)) m)
       (\q -> J.C.A.mulP-cong (p q)
         (Shift[q].C.Local[i].C.val ((h i).1 q) (face i))
         (Shift[q].C.CH.val (coefficients q) (face i))
         (\v -> sym (Shift[q].C.value (\j -> (h j).1 q) i v)) m))
       (sym (GlobalS.value s (\q -> (CJ.entry q).f (coefficients q)) (face i) m)))))) ;
  witness : CJ.Q.JW (CS.assemble x)=(coefficients,equation) ;
 } ;
 assembledWitness (depth : Base.Nat) (ws : CS.P.El)
  (wi : (i : I) -> Local[i].Q.FC.Wit depth (ws i)) : CJ.Q.FC.Wit depth (CS.assemble ws)=
   Transport.witness depth ws (PI.bundle depth ws wi) ;
 module Assemble (depth : Base.Nat) (x ws : CS.P.El)
  (wi : (i : I) -> Local[i].Q.FC.Wit depth (ws i))
  (rem : (i : I) -> Local[i].Q.JW (Local[i].Q.ML.msub (x i) (ws i))) {
  module PM=IP.ModL[A,CS.P.mod] ;
  differences : CS.P.El=PM.msub x ws ;
  module JR=JFamily[differences,rem] ;
  w : CJ.Target.El=CS.assemble ws ;
  ideal : CJ.Q.FC.Wit depth w=assembledWitness depth ws wi ;
  remainder : CJ.Q.JW (CJ.Q.ML.msub (CS.assemble x) w)=subst CJ.Q.JW (LL.f-sub x ws) JR.witness ;
  error : CJ.Q.IJW depth (CS.assemble x)=(w,(ideal,remainder)) ;
 } ;
} ;
module Single (A : CRing) (setA : Pr.isSet A.R) (n t : Nat) (b : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term n)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e q)) (p q)) (k : Int) {
 module F=GenericSubsetFaces[l] ;
 module C=Over[A,setA,n,Ps.Fin n,F.singleton n,K.topRank (suc zero),F.single-card n,F.classify-single n,GenericFaceInjectivity[l].single n,t,b,s,p,e,hp,k] ;
} ;
module Pairs (A : CRing) (setA : Pr.isSet A.R) (n t : Nat) (b : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term n)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e q)) (p q)) (k : Int) {
 module F=GenericSubsetFaces[l] ;
 module C=Over[A,setA,n,F.Pair n,F.pairSet n,K.topRank (suc (suc zero)),F.pair-card n,F.classify-pair n,GenericFaceInjectivity[l].pairs n,t,b,s,p,e,hp,k] ;
} ;
