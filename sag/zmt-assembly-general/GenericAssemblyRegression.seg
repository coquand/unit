-- Edge cases of the actual assembly: the empty coordinate complex has
-- no ordinary vertex/edge cochains; a single coordinate has no edges.
-- Explicit unit-ideal trees test nonzero input families at depth one.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ;
module K=GenericDegree[l] ; module L=GenericLaurent[l] ; module F=GenericSubsetFaces[l] ;
one : Nat=suc zero ; two : Nat=suc one ; three : Nat=suc two ; four : Nat=suc three ; five : Nat=suc four ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module EmptySingle=GenericChartFamilyAssembly[l].Single[A,setA,zero,negsuc zero].C ;
 module EmptyPairs=GenericChartFamilyAssembly[l].Pairs[A,setA,zero,negsuc zero].C ;
 module OnePairs=GenericChartFamilyAssembly[l].Pairs[A,setA,one,negsuc zero].C ;
 empty-single (x : EmptySingle.CH.El) : Id EmptySingle.CH.El x EmptySingle.CH.mod.mz=EmptySingle.ext _ _ (\i m -> absurd (Id A.R (EmptySingle.CH.val x (F.singleton zero i) m) A.z) i) ;
 empty-pairs (x : EmptyPairs.CH.El) : Id EmptyPairs.CH.El x EmptyPairs.CH.mod.mz=EmptyPairs.ext _ _ (\i m -> absurd (Id A.R (EmptyPairs.CH.val x (F.pairSet zero i) m) A.z) i) ;
 one-empty (e : F.Pair one) : Empty=one-case e
 where { one-case : F.Pair one -> Empty=split { inl i -> i ; inr i -> i } } ;
 one-pairs (x : OnePairs.CH.El) : Id OnePairs.CH.El x OnePairs.CH.mod.mz=OnePairs.ext _ _ (\i m -> absurd (Id A.R (OnePairs.CH.val x (F.pairSet one i) m) A.z) (one-empty i)) ;
 module UnitIdeal (n : Nat) (k : Int) {
  b (j : Ps.Fin one) : A.R=A.o ;
  p (j : Ps.Fin zero) : List (PolynomialTowerBridge[l].Over[A,setA].Term n)=absurd (List (PolynomialTowerBridge[l].Over[A,setA].Term n)) j ;
  e (j : Ps.Fin zero) : Base.Nat=absurd Base.Nat j ;
  hp (j : Ps.Fin zero) : CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e j)) (p j)=absurd (CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e j)) (p j)) j ;
  module E=GenericChartErrorAssembly[l].Pairs[A,setA,n,one,b,zero,p,e,hp,k].C ;
  local-wit (x : E.CS.P.El) (i : F.Pair n) : E.Local[i].Q.FC.Wit (suc zero) (x i)=
   (\j -> x i,(\j -> tt,sym (trans (ap (\z -> E.Local[i].Ideal.Target.mod.madd z E.Local[i].Ideal.Target.mod.mz) (E.Local[i].Ideal.Target.mod.smO (x i))) (E.Local[i].Ideal.Target.mod.maddZ (x i))))) ;
  module Error (x : E.CS.P.El) {
   rem (i : F.Pair n) : E.Local[i].Q.JW (E.Local[i].Q.ML.msub (x i) (x i))=
    subst E.Local[i].Q.JW (sym (E.Local[i].Q.ML.sub-self (x i))) E.Local[i].Q.jw-zero ;
   module Assembled=E.Assemble[suc zero,x,x,local-wit x,rem] ;
   witness : E.CJ.Q.FC.Wit (suc zero) (E.CS.assemble x)=Assembled.ideal ;
   error : E.CJ.Q.IJW (suc zero) (E.CS.assemble x)=Assembled.error ;
  } ;
 } ;
 module U0=UnitIdeal[zero,negsuc zero] ;
 module U1=UnitIdeal[one,negsuc zero] ;
 module U5=UnitIdeal[five,negsuc zero] ;
 module U5Neg=UnitIdeal[five,negsuc (suc (suc zero))] ;
} ;
module Z=Over[ZRing[l].ring,ZRing[l].set] ;
