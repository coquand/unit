-- The singleton and oriented-pair subset enumerations are injective.
-- The newest vertex separates the two recursive branches; no quotient
-- or choice of representatives is involved.
level l ; open Ring[l] ; open GenericCube[l] ;
module F=GenericSubsetFaces[l] ; module Pr=Prelude[l] ; module Ps=Presentations[l] ;
top-eq : (t u : Top) -> Id Top t u=split { tt -> split { tt -> refl tt } } ;
code : Flag -> U l=split { absent -> Top ; present -> Empty } ;
no-ap (e : Id Flag absent present) : Empty=subst code e tt ;
module SingleStep (n : Nat) (rec : (i j : Ps.Fin n) -> Id (Sub n) (F.singleton n i) (F.singleton n j) -> Id (Ps.Fin n) i j) {
 old : (i : Ps.Fin n) (j : Ps.Fin (suc n)) -> Id (Sub (suc n)) (F.singleton (suc n) (inl i)) (F.singleton (suc n) j) -> Id (Ps.Fin (suc n)) (inl i) j=\i -> split {
  inl j -> \h -> ap (\v -> inl v) (rec i j (ap (\s -> s.2) h)) ;
  inr t -> \h -> absurd (Id (Ps.Fin (suc n)) (inl i) (inr t)) (no-ap (ap (\s -> s.1) h)) } ;
 newest : (t : Top) (j : Ps.Fin (suc n)) -> Id (Sub (suc n)) (F.singleton (suc n) (inr t)) (F.singleton (suc n) j) -> Id (Ps.Fin (suc n)) (inr t) j=\t -> split {
  inl j -> \h -> absurd (Id (Ps.Fin (suc n)) (inr t) (inl j)) (no-ap (sym (ap (\s -> s.1) h))) ;
  inr u -> \h -> ap (\v -> inr v) (top-eq t u) } ;
 result : (i j : Ps.Fin (suc n)) -> Id (Sub (suc n)) (F.singleton (suc n) i) (F.singleton (suc n) j) -> Id (Ps.Fin (suc n)) i j=split {
  inl i -> old i ; inr t -> newest t } ;
} ;
single : (n : Nat) (i j : Ps.Fin n) -> Id (Sub n) (F.singleton n i) (F.singleton n j) -> Id (Ps.Fin n) i j=split {
 zero -> \i j h -> absurd (Id (Ps.Fin zero) i j) i ; suc n | rec -> SingleStep[n,rec].result } ;
module PairStep (n : Nat) (rec : (i j : F.Pair n) -> Id (Sub n) (F.pairSet n i) (F.pairSet n j) -> Id (F.Pair n) i j) {
 old : (i : F.Pair n) (j : F.Pair (suc n)) -> Id (Sub (suc n)) (F.pairSet (suc n) (inl i)) (F.pairSet (suc n) j) -> Id (F.Pair (suc n)) (inl i) j=\i -> split {
  inl j -> \h -> ap (\v -> inl v) (rec i j (ap (\s -> s.2) h)) ;
  inr j -> \h -> absurd (Id (F.Pair (suc n)) (inl i) (inr j)) (no-ap (ap (\s -> s.1) h)) } ;
 newest : (i : Ps.Fin n) (j : F.Pair (suc n)) -> Id (Sub (suc n)) (F.pairSet (suc n) (inr i)) (F.pairSet (suc n) j) -> Id (F.Pair (suc n)) (inr i) j=\i -> split {
  inl j -> \h -> absurd (Id (F.Pair (suc n)) (inr i) (inl j)) (no-ap (sym (ap (\s -> s.1) h))) ;
  inr j -> \h -> ap (\v -> inr v) (single n i j (ap (\s -> s.2) h)) } ;
 result : (i j : F.Pair (suc n)) -> Id (Sub (suc n)) (F.pairSet (suc n) i) (F.pairSet (suc n) j) -> Id (F.Pair (suc n)) i j=split {
  inl i -> old i ; inr i -> newest i } ;
} ;
pairs : (n : Nat) (i j : F.Pair n) -> Id (Sub n) (F.pairSet n i) (F.pairSet n j) -> Id (F.Pair n) i j=split {
 zero -> \i j h -> absurd (Id (F.Pair zero) i j) i ; suc n | rec -> PairStep[n,rec].result } ;
