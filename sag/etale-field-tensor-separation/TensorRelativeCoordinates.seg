-- The separating tensor element supplies the coordinate equations for
-- every relative finite basis after a surjective algebra projection.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S D : Algebras[l].Over[k,setk].Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (n : Nat) (basisS : TraceBasis[l].Over[k,setk,S].Basis[n])
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (z : S.ring.R) (w : D.ring.R)
 (inverse : Id D.ring.R
  (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference z) w)
  (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
 module C = Algebras[l].Over[k,setk] ; module TL = TraceLinear[l].Over[k,setk] ;
 module Sep = TensorSeparatingElement[l].Over[k,setk,S,D,cp,n,basisS,epsilon,z,w,inverse] ;
 as-linear (A B : C.Algebra) (h : C.Hom A B) : TL.Linear[A,B] =
  new TL.Linear[A,B,h.1.1,h.1.2.2.1,\ r a -> trans (h.1.2.2.2 (A.iota.1 r) a)
   (ap (\ b -> B.ring.mul b (h.1.1 a)) (h.2 r))] ;
 module Relative (A T : C.Algebra) (h : C.Hom A T) (p : C.Hom S T) {
  module CA = Algebras[l].Over[A.ring,A.set] ;
  algebra : CA.Algebra = CA.mkAlgebra T.ring T.set h.1 ;
  module Basis (r : Nat) (basis : TraceBasis[l].Over[A.ring,A.set,algebra].Basis[r])
   (t : A.ring.R) (contains : Id T.ring.R (p.1.1 z) (h.1.1 t)) {
   module Column (i : Fin r) {
    scale (a : k.R) (b : T.ring.R) : Id A.ring.R
     (basis.coordinate (T.ring.mul (T.iota.1 a) b) i) (A.ring.mul (A.iota.1 a) (basis.coordinate b i)) =
      trans (ap (\ c -> basis.coordinate (T.ring.mul c b) i) (sym (h.2 a))) (basis.scale (A.iota.1 a) b i) ;
    coordinate : TL.Linear[T,A] = new TL.Linear[T,A,\ b -> basis.coordinate b i,\ a b -> basis.add a b i,scale] ;
    f : TL.Linear[S,T] = TL.compose S A T (as-linear A T h)
     (TL.compose S T A coordinate (as-linear S T p)) ;
    balanced (a : S.ring.R) : Id T.ring.R (f.map (S.ring.mul z a)) (T.ring.mul (p.1.1 z) (f.map a)) =
     trans (ap (\ b -> h.1.1 (basis.coordinate b i)) (p.1.2.2.2 z a))
      (trans (ap (\ b -> h.1.1 (basis.coordinate (T.ring.mul b (p.1.1 a)) i)) contains)
       (trans (ap h.1.1 (basis.scale t (p.1.1 a) i))
        (trans (h.1.2.2.2 t (basis.coordinate (p.1.1 a) i))
         (ap (\ b -> T.ring.mul b (h.1.1 (basis.coordinate (p.1.1 a) i))) (sym contains))))) ;
    module Apply = Sep.Balanced[T,p,f,balanced] ;
    image (a : S.ring.R) : Id T.ring.R (h.1.1 (basis.coordinate (p.1.1 a) i))
     (T.ring.mul (h.1.1 (basis.coordinate T.ring.o i)) (p.1.1 a)) =
      trans (Apply.theorem a)
       (ap (\ b -> T.ring.mul (h.1.1 (basis.coordinate b i)) (p.1.1 a)) p.1.2.1) ;
    theorem (onto : (b : T.ring.R) -> Tr.Trunc[(a : S.ring.R) * Id T.ring.R (p.1.1 a) b].carrier)
     (b : T.ring.R) : Id T.ring.R (h.1.1 (basis.coordinate b i))
      (T.ring.mul (h.1.1 (basis.coordinate T.ring.o i)) b) =
       TC.rec ((a : S.ring.R) * Id T.ring.R (p.1.1 a) b) @l
        (Id T.ring.R (h.1.1 (basis.coordinate b i)) (T.ring.mul (h.1.1 (basis.coordinate T.ring.o i)) b))
        (T.set _ _) (\ rep -> subst (\ c -> Id T.ring.R (h.1.1 (basis.coordinate c i))
         (T.ring.mul (h.1.1 (basis.coordinate T.ring.o i)) c)) rep.2 (image rep.1)) (onto b) ;
   } ;
   theorem (onto : (b : T.ring.R) -> Tr.Trunc[(a : S.ring.R) * Id T.ring.R (p.1.1 a) b].carrier)
    (i : Fin r) (b : T.ring.R) : Id T.ring.R (h.1.1 (basis.coordinate b i))
     (T.ring.mul (h.1.1 (basis.coordinate T.ring.o i)) b) = Column[i].theorem onto b ;
  } ;
 } ;
} ;
