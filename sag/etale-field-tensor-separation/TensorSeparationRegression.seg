-- Run contraction and separation on the actual constructed base tensor,
-- including the nonreduced coefficient ring Z/4 and nilpotent z=2.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module BaseTensor (R : CRing) (setR : Pr.isSet R.R) (b z : R.R) {
 module C = Algebras[l].Over[R,setR] ; module B = TraceRegression[l].BaseCase[R,setR] ;
 module D = B.ActualTensor ; module DK = D.Diag.DK ;
 module DL = RL[D.T.T.ring] ; module L = RL[R] ;
 equalises (a : R.R) : Id D.T.T.ring.R
  (D.T.T.ring.mul D.T.T.ring.o (DK.left.1.1 a)) (D.T.T.ring.mul D.T.T.ring.o (DK.right.1.1 a)) =
   ap (D.T.T.ring.mul D.T.T.ring.o) (trans (DK.left.2 a) (sym (DK.right.2 a))) ;
 epsilon : D.Diag.Witness = new D.Diag.Witness[D.T.T.ring.o,DK.mu.1.2.1,equalises,D.T.T.ring.mulO D.T.T.ring.o] ;
 inverse : Id D.T.T.ring.R (D.T.T.ring.mul (DK.difference z) D.T.T.ring.z)
  (D.T.T.ring.add D.T.T.ring.o (D.T.T.ring.neg epsilon.epsilon)) =
   trans (DL.mul-zero (DK.difference z)) (sym (D.T.T.ring.addN D.T.T.ring.o)) ;
 module TL = TraceLinear[l].Over[R,setR] ; f : TL.Linear[C.base,C.base] = TL.multiply C.base b ;
 balanced (a : R.R) : Id R.R (f.map (R.mul z a)) (R.mul z (f.map a)) = L.mul-swap b z a ;
 module Apply = TensorSeparatingElement[l].Over[R,setR,C.base,D.T.T,D.T.coproduct,
  TraceRegression[l].one,B.basis,epsilon,z,D.T.T.ring.z,inverse].Balanced[C.base,C.identity C.base,f,balanced] ;
 theorem (a : R.R) : Id R.R (R.mul b a) (R.mul (R.mul b R.o) a) = Apply.theorem a ;
 module Contract = TensorContraction[l].Over[R,setR,C.base,D.T.T,D.T.coproduct,
  TraceRegression[l].one,B.basis,C.base,C.identity C.base,f] ;
 pure (a c : R.R) : Id R.R (Contract.map (D.T.T.ring.mul (DK.left.1.1 a) (DK.right.1.1 c)))
  (R.mul (R.mul b a) c) = Contract.pure a c ;
 module Relative = TensorRelativeCoordinates[l].Over[R,setR,C.base,D.T.T,D.T.coproduct,
  TraceRegression[l].one,B.basis,epsilon,z,D.T.T.ring.z,inverse].Relative[C.base,C.base,C.identity C.base,C.identity C.base] ;
 module Coordinate = Relative.Basis[TraceRegression[l].one,B.basis,z,refl z] ;
 onto (a : R.R) : Truncation[l].Trunc[(x : R.R) * Id R.R x a].carrier =
  Truncation[l].Trunc[(x : R.R) * Id R.R x a].inc (a,refl a) ;
 coordinate (a : R.R) : Id R.R a (R.mul R.o a) = Coordinate.theorem onto (inr tt) a ;
} ;
module Z = ZMod4[l] ; module Test = BaseTensor[Z.ring,Z.set,q3,q2] ;
nilpotent-generator : Id Z.Z4 (Z.mul q2 q2) q0 = refl q0 ;
three-times-one : Id Z.Z4 (Z.mul q3 q1) (Z.mul (Z.mul q3 q1) q1) = Test.theorem q1 ;
contract-three (c : Z.Z4) : Id Z.Z4
 (Test.Contract.map (Test.D.T.T.ring.mul (Test.DK.left.1.1 q1) (Test.DK.right.1.1 c))) (Z.mul q3 c) = Test.pure q1 c ;
