-- Contract the left tensor factor by any k-linear map into a target
-- algebra. A map balanced under z kills every multiple of Delta z.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S D : Algebras[l].Over[k,setk].Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (T : Algebras[l].Over[k,setk].Algebra) (j : Algebras[l].Over[k,setk].Hom S T)
 (f : TraceLinear[l].Over[k,setk].Linear[S,T]) {
 module DK = DiagonalKernel[l].Over[k,setk].At[S,D,cp] ;
 module TB = TensorBasisConstruct[l].Over[k,setk].At[S,D,cp,n,basis] ;
 module DL = RL[D.ring] ; module L = RL[T.ring] ;
 module DS = FiniteIdeal[l].Sums[D.ring] ; module TS = FiniteIdeal[l].Sums[T.ring] ;
 module TL = TraceLinear[l].Over[k,setk] ; module FM = TL.Map[S,T,f] ;
 map (y : D.ring.R) : T.ring.R = TS.sum n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i))) ;
 add (y z : D.ring.R) : Id T.ring.R (map (D.ring.add y z)) (T.ring.add (map y) (map z)) =
  trans (TS.sum-cong n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate (D.ring.add y z) i))) (\ i -> T.ring.add
   (T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i)))
   (T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate z i))))
   (\ i -> trans (ap (T.ring.mul (f.map (basis.vector i)))
    (trans (ap j.1.1 (TB.coordinate-add y z i)) (j.1.2.2.1 (TB.coordinate y i) (TB.coordinate z i))))
    (T.ring.dist (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i)) (j.1.1 (TB.coordinate z i)))))
   (TS.sum-add n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i)))
    (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate z i)))) ;
 right (a : S.ring.R) (y : D.ring.R) :
  Id T.ring.R (map (D.ring.mul (DK.right.1.1 a) y)) (T.ring.mul (j.1.1 a) (map y)) =
   trans (TS.sum-cong n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate (D.ring.mul (DK.right.1.1 a) y) i))) (\ i -> T.ring.mul (j.1.1 a)
    (T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i))))
    (\ i -> trans (ap (T.ring.mul (f.map (basis.vector i)))
     (trans (ap j.1.1 (TB.coordinate-scale a y i)) (j.1.2.2.2 a (TB.coordinate y i))))
     (L.mul-swap (f.map (basis.vector i)) (j.1.1 a) (j.1.1 (TB.coordinate y i)))))
    (TS.sum-scale (j.1.1 a) n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i)))) ;
 scale (a : k.R) (y : D.ring.R) :
  Id T.ring.R (map (D.ring.mul (D.iota.1 a) y)) (T.ring.mul (T.iota.1 a) (map y)) =
   trans (ap (\ c -> map (D.ring.mul c y)) (sym (DK.right.2 a)))
    (trans (right (S.iota.1 a) y) (ap (\ c -> T.ring.mul c (map y)) (j.2 a))) ;
 linear : TL.Linear[D,T] = new TL.Linear[D,T,map,add,scale] ;
 module Laws = TL.Map[D,T,linear] ;
 negation (y : D.ring.R) : Id T.ring.R (map (D.ring.neg y)) (T.ring.neg (map y)) =
  L.neg-uniq (map y) (map (D.ring.neg y))
   (trans (sym (add y (D.ring.neg y))) (trans (ap map (D.ring.addN y)) Laws.zero)) ;
 subtract (y z : D.ring.R) : Id T.ring.R (map (D.ring.add y (D.ring.neg z)))
  (T.ring.add (map y) (T.ring.neg (map z))) =
   trans (add y (D.ring.neg z)) (ap (T.ring.add (map y)) (negation z)) ;
 left (a : S.ring.R) : Id T.ring.R (map (DK.left.1.1 a)) (f.map a) =
  trans (TS.sum-cong n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate (DK.left.1.1 a) i))) (\ i -> T.ring.mul (T.iota.1 (basis.coordinate a i)) (f.map (basis.vector i)))
   (\ i -> trans (ap (T.ring.mul (f.map (basis.vector i)))
    (trans (ap j.1.1 (TB.coordinate-left a i)) (j.2 (basis.coordinate a i))))
    (T.ring.mulC (f.map (basis.vector i)) (T.iota.1 (basis.coordinate a i)))))
   (trans (sym (FM.combination n basis.vector (basis.coordinate a))) (ap f.map (basis.reconstruction a))) ;
 pure (a b : S.ring.R) :
  Id T.ring.R (map (D.ring.mul (DK.left.1.1 a) (DK.right.1.1 b))) (T.ring.mul (f.map a) (j.1.1 b)) =
   trans (ap map (D.ring.mulC (DK.left.1.1 a) (DK.right.1.1 b)))
    (trans (right b (DK.left.1.1 a))
     (trans (ap (T.ring.mul (j.1.1 b)) (left a)) (T.ring.mulC (j.1.1 b) (f.map a)))) ;
 right-alone (a : S.ring.R) : Id T.ring.R (map (DK.right.1.1 a)) (T.ring.mul (f.map S.ring.o) (j.1.1 a)) =
  trans (ap map (sym (trans (ap (\ d -> D.ring.mul d (DK.right.1.1 a)) DK.left.1.2.1) (DL.one-left (DK.right.1.1 a)))))
   (pure S.ring.o a) ;
 module Balanced (z : S.ring.R)
  (balanced : (a : S.ring.R) -> Id T.ring.R (f.map (S.ring.mul z a)) (T.ring.mul (j.1.1 z) (f.map a))) {
  left-pure (a b : S.ring.R) :
   Id T.ring.R (map (D.ring.mul (DK.left.1.1 z) (D.ring.mul (DK.left.1.1 a) (DK.right.1.1 b))))
    (T.ring.mul (j.1.1 z) (T.ring.mul (f.map a) (j.1.1 b))) =
    trans (ap map (TB.Trace.product-pure z a b))
     (trans (pure (S.ring.mul z a) b)
      (trans (ap (\ c -> T.ring.mul c (j.1.1 b)) (balanced a))
       (sym (T.ring.mulA (j.1.1 z) (f.map a) (j.1.1 b))))) ;
  expanded (y : D.ring.R) : Id T.ring.R (map (D.ring.mul (DK.left.1.1 z) y))
   (TS.sum n (\ i -> map (D.ring.mul (DK.left.1.1 z)
    (D.ring.mul (DK.left.1.1 (basis.vector i)) (DK.right.1.1 (TB.coordinate y i)))))) =
    trans (ap (\ d -> map (D.ring.mul (DK.left.1.1 z) d)) (sym (TB.reconstruction y)))
     (trans (ap map (sym (DS.sum-scale (DK.left.1.1 z) n
       (\ i -> D.ring.mul (DK.left.1.1 (basis.vector i)) (DK.right.1.1 (TB.coordinate y i))))))
      (Laws.sum n (\ i -> D.ring.mul (DK.left.1.1 z)
       (D.ring.mul (DK.left.1.1 (basis.vector i)) (DK.right.1.1 (TB.coordinate y i)))))) ;
  left-action (y : D.ring.R) :
   Id T.ring.R (map (D.ring.mul (DK.left.1.1 z) y)) (T.ring.mul (j.1.1 z) (map y)) =
    trans (expanded y)
     (trans (TS.sum-cong n
      (\ i -> map (D.ring.mul (DK.left.1.1 z)
       (D.ring.mul (DK.left.1.1 (basis.vector i)) (DK.right.1.1 (TB.coordinate y i)))))
      (\ i -> T.ring.mul (j.1.1 z) (T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i))))
      (\ i -> left-pure (basis.vector i) (TB.coordinate y i)))
      (TS.sum-scale (j.1.1 z) n (\ i -> T.ring.mul (f.map (basis.vector i)) (j.1.1 (TB.coordinate y i))))) ;
  difference : D.ring.R = D.ring.add (DK.left.1.1 z) (D.ring.neg (DK.right.1.1 z)) ;
  kills (y : D.ring.R) : Id T.ring.R (map (D.ring.mul difference y)) T.ring.z =
   trans (ap map (trans (DL.dist-left (DK.left.1.1 z) (D.ring.neg (DK.right.1.1 z)) y)
    (ap (D.ring.add (D.ring.mul (DK.left.1.1 z) y)) (DL.neg-mul-left (DK.right.1.1 z) y))))
    (trans (subtract (D.ring.mul (DK.left.1.1 z) y) (D.ring.mul (DK.right.1.1 z) y))
     (trans (cong2 T.ring.R T.ring.add _ _ _ _ (left-action y) (ap T.ring.neg (right z y)))
      (T.ring.addN (T.ring.mul (j.1.1 z) (map y))))) ;
 } ;
} ;
