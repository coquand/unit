-- If Delta z is invertible away from the diagonal, every z-balanced
-- linear functional is multiplication by its value at 1. This is the
-- finite-coordinate input for selected primitive generation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S D : Algebras[l].Over[k,setk].Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (z : S.ring.R) (w : D.ring.R)
 (inverse : Id D.ring.R
  (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference z) w)
  (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
 module DK = DiagonalKernel[l].Over[k,setk].At[S,D,cp] ; module L = RL[D.ring] ;
 annihilates (a : S.ring.R) : Id D.ring.R (D.ring.mul epsilon.epsilon (DK.difference a)) D.ring.z =
  trans (D.ring.dist epsilon.epsilon (DK.left.1.1 a) (D.ring.neg (DK.right.1.1 a)))
   (trans (ap (D.ring.add (D.ring.mul epsilon.epsilon (DK.left.1.1 a))) (L.mul-neg epsilon.epsilon (DK.right.1.1 a)))
    (trans (ap (\ b -> D.ring.add b (D.ring.neg (D.ring.mul epsilon.epsilon (DK.right.1.1 a)))) (epsilon.equalises a))
     (D.ring.addN (D.ring.mul epsilon.epsilon (DK.right.1.1 a))))) ;
 complement (a : S.ring.R) :
  Id D.ring.R (D.ring.mul (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)) (DK.difference a)) (DK.difference a) =
   trans (L.dist-left D.ring.o (D.ring.neg epsilon.epsilon) (DK.difference a))
    (trans (cong2 D.ring.R D.ring.add _ _ _ _ (L.one-left (DK.difference a))
     (trans (L.neg-mul-left epsilon.epsilon (DK.difference a)) (trans (ap D.ring.neg (annihilates a)) L.neg-zero)))
     (D.ring.addZ (DK.difference a))) ;
 multiple (a : S.ring.R) :
  Id D.ring.R (D.ring.mul (DK.difference z) (D.ring.mul w (DK.difference a))) (DK.difference a) =
   trans (D.ring.mulA (DK.difference z) w (DK.difference a))
    (trans (ap (\ b -> D.ring.mul b (DK.difference a)) inverse) (complement a)) ;
 module Balanced (T : Algebras[l].Over[k,setk].Algebra) (j : Algebras[l].Over[k,setk].Hom S T)
  (f : TraceLinear[l].Over[k,setk].Linear[S,T])
  (balanced : (a : S.ring.R) -> Id T.ring.R (f.map (S.ring.mul z a)) (T.ring.mul (j.1.1 z) (f.map a))) {
  module Contract = TensorContraction[l].Over[k,setk,S,D,cp,n,basis,T,j,f] ;
  zero (a : S.ring.R) : Id T.ring.R (Contract.map (DK.difference a)) T.ring.z =
   trans (ap Contract.map (sym (multiple a))) (Contract.Balanced[z,balanced].kills (D.ring.mul w (DK.difference a))) ;
  theorem (a : S.ring.R) : Id T.ring.R (f.map a) (T.ring.mul (f.map S.ring.o) (j.1.1 a)) =
   FormallyEtale[l].Units[T.ring,T.set].sub-zero _ _
    (trans (sym (trans (Contract.subtract (DK.left.1.1 a) (DK.right.1.1 a))
     (cong2 T.ring.R T.ring.add _ _ _ _ (Contract.left a) (ap T.ring.neg (Contract.right-alone a))))) (zero a)) ;
 } ;
} ;
