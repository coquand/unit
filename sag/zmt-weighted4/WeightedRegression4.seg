-- WeightedRegression4.seg: checked instances (handoff §8).
--
-- Over any commutative set-ring A, D_2 = A[U][V] (U = U_1 = var i0,
-- V = U_2 = var i1, the constructed tower):
--   1. x = U^2 + UV + V^3:  pr 2 x = U^2 + UV,  pr 3 x = V^3 (part2, part3),
--      from the laws only (U^2, UV of degree 2, V^3 of degree 3, 2 /= 3).
--   2. the scalar action with different shifts, on a concrete cochain c of
--      C^1(-1) (Mono: U^2 at the edge e01, exponent (-1,0,0,0); coefficient
--      degree 2), q = 1 + U:
--        Pr 3 (q c) = pr 1 (q) c = U c          (scal3)
--        Pr 1 (q c) = pr (-1) (q) c = 0         (scal1, a negative request)
--      (k - e, not k + e: with k + e both would be 0).
-- Over a CFN A (Dep[K0,cfnA]):
--   3. g = (U X_0^3, V X_1^3), d = (3,3), f = (1,1):  dep1, the weighted
--      theorem through CoherentDependence4 (no hand-written syzygy data);
--   4. g = ((U + V) X_0^3), d = (3), f = (1):  dep2 (a coefficient-homogeneous
--      non-monomial coefficient);
--   5. t = 0, D = A: g = (X_0^3, X_1^3), f = (0,0): dep0; in D_0 = A,
--      pr (-1) a = 0 and pr 1 a = 0 (t0-neg, t0-one);
--   6. N = 0, the empty list: WBdry 0 [] gives c_0 = delta v + sum_j g_j a'_j
--      with v of coefficient degree 1 (empty-case).
-- Over Z (OverZ, ZCFN), a_1 = 2, a_2 = 3, I = (2, 3):
--   7. ev (U^2 + UV) = 10, ev (V^3) = 27 (by computation), and the witnesses
--      10 in I^2, 27 in I^3 (w10, w27) built from the projected examples;
--      the evaluated weighted theorem for input 3 over Z (evaluated1).
-- The dependence index N is only merely given: no N is predicted; the
-- exported identity, homogeneity and ideal-power witnesses are what is
-- checked.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
open HomogeneousMatrices4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module LG = Logic[l] ;
module Tr = Truncation[l] ; module TL4 = TopList4[l] ; module CRt = CubicResolution4[l] ;

oneB : Base.Nat = suc zero ;
twoB : Base.Nat = suc oneB ;
threeB : Base.Nat = suc twoB ;
twentysevenB : Base.Nat = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))))))))))) ;
tenB : Base.Nat = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))) ;
ne23 : Not (Id Int (pos twoB) (pos threeB)) = \ p -> Pr.absurd Empty (encode (pos twoB) (pos threeB) p) ;
ne32 : Not (Id Int (pos threeB) (pos twoB)) = \ p -> Pr.absurd Empty (encode (pos threeB) (pos twoB) p) ;
ne10 : Not (Id Int (pos oneB) zeroZ) = \ p -> Pr.absurd Empty (encode (pos oneB) zeroZ p) ;
-- the exponent (-1, 0, 0, 0)
m0 : E4 = ex (negsuc zero) (pos zero) (pos zero) (pos zero) ;

module Over (A : CRing) (setA : Pr.isSet A.R) {
  module T = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  -- D_2 = A[U][V]
  D2 : CRing = T.D CRt.rk2 ;
  G2 : Graded[A,CRt.rk2,D2] = T.grD CRt.rk2 ;
  module GL = Laws[A,CRt.rk2,D2,T.setD CRt.rk2,T.grD CRt.rk2] ;
  module DL = GL.DL ;
  Uv : D2.R = G2.var CRt.i0 ;
  Vv : D2.R = G2.var CRt.i1 ;
  hU : GL.Hom (pos oneB) Uv = G2.var-hom CRt.i0 ;
  hV : GL.Hom (pos oneB) Vv = G2.var-hom CRt.i1 ;
  UU : D2.R = D2.mul Uv Uv ;
  UV : D2.R = D2.mul Uv Vv ;
  VVV : D2.R = D2.mul Vv (D2.mul Vv Vv) ;
  hUU : GL.Hom (pos twoB) UU = GL.hom-mul (pos oneB) (pos oneB) Uv Uv hU hU ;
  hUV : GL.Hom (pos twoB) UV = GL.hom-mul (pos oneB) (pos oneB) Uv Vv hU hV ;
  hVVV : GL.Hom (pos threeB) VVV = GL.hom-mul (pos oneB) (pos twoB) Vv (D2.mul Vv Vv) hV (GL.hom-mul (pos oneB) (pos oneB) Vv Vv hV hV) ;

  -- 1. U^2 + UV + V^3
  x : D2.R = D2.add (D2.add UU UV) VVV ;
  part2 : Id D2.R (G2.pr (pos twoB) x) (D2.add UU UV) = calc D2.R {
    G2.pr (pos twoB) x =< G2.pr-add (pos twoB) (D2.add UU UV) VVV > D2.add (G2.pr (pos twoB) (D2.add UU UV)) (G2.pr (pos twoB) VVV)
      =< DL.G.cong-add (GL.hom-add (pos twoB) UU UV hUU hUV) (GL.hom-other (pos twoB) (pos threeB) VVV hVVV ne23) > D2.add (D2.add UU UV) D2.z
      =< D2.addZ (D2.add UU UV) > D2.add UU UV } ;
  part3 : Id D2.R (G2.pr (pos threeB) x) VVV = calc D2.R {
    G2.pr (pos threeB) x =< G2.pr-add (pos threeB) (D2.add UU UV) VVV > D2.add (G2.pr (pos threeB) (D2.add UU UV)) (G2.pr (pos threeB) VVV)
      =< DL.G.cong-add (trans (G2.pr-add (pos threeB) UU UV)
                          (DL.G.cong-add (GL.hom-other (pos threeB) (pos twoB) UU hUU ne32) (GL.hom-other (pos threeB) (pos twoB) UV hUV ne32)))
                       hVVV > D2.add (D2.add D2.z D2.z) VVV
      =< ap (\ w -> D2.add w VVV) (D2.addZ D2.z) > D2.add D2.z VVV
      =< DL.G.zl VVV > VVV } ;

  -- 2. the scalar action on a concrete cochain
  q : D2.R = D2.add D2.o Uv ;
  pr1-q : Id D2.R (G2.pr (pos oneB) q) Uv =
    trans (G2.pr-add (pos oneB) D2.o Uv) (trans (DL.G.cong-add (GL.hom-other (pos oneB) zeroZ D2.o GL.hom-one ne10) hU) (DL.G.zl Uv)) ;
  prneg-q : Id D2.R (G2.pr (negsuc zero) q) D2.z = G2.pr-negdeg zero q ;

  module CC = CoefficientCech4[l].Over[A,CRt.rk2,D2,T.setD CRt.rk2,T.grD CRt.rk2] ;
  module P1 = CC.Diff[TL4.mOne].P1 ;
  module Mono {
    -- U^2 at the edge e01, 0 elsewhere
    r : Ed -> D2.R = split { e01 -> UU ; e02 -> D2.z ; e03 -> D2.z ; e12 -> D2.z ; e13 -> D2.z ; e23 -> D2.z } ;
    pick (y : D2.R) (m : E4) : LG.Dec (Id E4 m0 m) -> D2.R = split { yes p -> y ; no n -> D2.z } ;
    raw (i : Ed) (m : E4) : D2.R = pick (r i) m (dec-e4 m0 m) ;
    -- (-1,0,0,0) is of degree -1 and in the chart of e01
    out01 : Out (setEd e01) m0 -> Empty = split { o0 h -> h ; o1 h -> h ; o2 h -> h ; o3 h -> h } ;
    bad01 : BadI Ed setEd TL4.mOne e01 m0 -> Id D2.R UU D2.z = split {
      inl h -> absurd (Id D2.R UU D2.z) (h (refl (deg m0))) ;
      inr o -> absurd (Id D2.R UU D2.z) (out01 o) } ;
    ok : (i : Ed) -> BadI Ed setEd TL4.mOne i m0 -> Id D2.R (r i) D2.z = split {
      e01 -> bad01 ; e02 -> \ b -> refl D2.z ; e03 -> \ b -> refl D2.z ;
      e12 -> \ b -> refl D2.z ; e13 -> \ b -> refl D2.z ; e23 -> \ b -> refl D2.z } ;
    pick-vanish (y : D2.R) (m : E4) (nm : Not (Mem m (cons m0 nil))) : (d : LG.Dec (Id E4 m0 m)) -> Id D2.R (pick y m d) D2.z = split {
      yes p -> absurd (Id D2.R y D2.z) (nm (inl p)) ;
      no n -> refl D2.z } ;
    pick-van (i : Ed) (m : E4) (b : BadI Ed setEd TL4.mOne i m) : (d : LG.Dec (Id E4 m0 m)) -> Id D2.R (pick (r i) m d) D2.z = split {
      yes p -> ok i (subst (BadI Ed setEd TL4.mOne i) (sym p) b) ;
      no n -> refl D2.z } ;
    c : P1.CH.El = P1.CH.mk raw
      (Tr.Trunc[P1.CH.SuppW raw].inc (cons m0 nil, \ i m nm -> pick-vanish (r i) m nm (dec-e4 m0 m)))
      (\ i m b -> pick-van i m b (dec-e4 m0 m)) ;
    -- c has coefficient degree 2
    hr : (i : Ed) -> GL.Hom (pos twoB) (r i) = split {
      e01 -> hUU ; e02 -> GL.hom-zero (pos twoB) ; e03 -> GL.hom-zero (pos twoB) ;
      e12 -> GL.hom-zero (pos twoB) ; e13 -> GL.hom-zero (pos twoB) ; e23 -> GL.hom-zero (pos twoB) } ;
    hom-pick (y : D2.R) (hy : GL.Hom (pos twoB) y) (m : E4) : (d : LG.Dec (Id E4 m0 m)) -> GL.Hom (pos twoB) (pick y m d) = split {
      yes p -> hy ;
      no n -> GL.hom-zero (pos twoB) } ;
    hc : P1.Hom (pos twoB) c = \ i m -> hom-pick (r i) (hr i) m (dec-e4 m0 m) ;
    -- Pr 3 (q c) = U c
    scal3 : Id P1.CH.El (P1.proj (pos threeB) (P1.CH.mod.sm q c)) (P1.CH.mod.sm Uv c) =
      trans (P1.proj-scalar-pos (pos threeB) twoB q c hc) (ap (\ w -> P1.CH.mod.sm w c) pr1-q) ;
    -- Pr 1 (q c) = 0: the requested degree 1 - 2 is negative
    scal1 : Id P1.CH.El (P1.proj (pos oneB) (P1.CH.mod.sm q c)) P1.CH.mod.mz =
      trans (P1.proj-scalar-pos (pos oneB) twoB q c hc)
        (trans (ap (\ w -> P1.CH.mod.sm w c) prneg-q) (IP.ModL[D2,P1.CH.mod].zero-sm c)) ;
  } ;

  -- 3, 4. bihomogeneous inputs
  module BA = BihomogeneousAction4[l].Over[A,CRt.rk2,D2,T.setD CRt.rk2,T.grD CRt.rk2] ;
  d1 (i : Ps.Fin CRt.rk2) : Base.Nat = TL4.three ;
  f1 (i : Ps.Fin CRt.rk2) : Base.Nat = oneB ;
  g1 : Ps.Fin CRt.rk2 -> TPoly D2.R = CRt.pair (TPoly D2.R) (cons (Uv, CRt.eP) nil) (cons (Vv, CRt.eQ) nil) ;
  hg1 : (i : Ps.Fin CRt.rk2) -> HomDeg D2.R (d1 i) (g1 i) =
    CRt.pair-ind (\ i -> HomDeg D2.R (d1 i) (g1 i)) (refl TL4.three, tt) (refl TL4.three, tt) ;
  hf1 : (i : Ps.Fin CRt.rk2) -> BA.CoefHom (f1 i) (g1 i) =
    CRt.pair-ind (\ i -> BA.CoefHom (f1 i) (g1 i)) (hU, tt) (hV, tt) ;
  d2 (i : Ps.Fin CRt.rk1) : Base.Nat = TL4.three ;
  f2 (i : Ps.Fin CRt.rk1) : Base.Nat = oneB ;
  g2 (i : Ps.Fin CRt.rk1) : TPoly D2.R = cons (D2.add Uv Vv, CRt.eP) nil ;
  hg2 (i : Ps.Fin CRt.rk1) : HomDeg D2.R (d2 i) (g2 i) = (refl TL4.three, tt) ;
  hf2 (i : Ps.Fin CRt.rk1) : BA.CoefHom (f2 i) (g2 i) = (GL.hom-add (pos oneB) Uv Vv hU hV, tt) ;

  -- 5. t = 0: D_0 = A
  module CR0 = CRt.Over[A,setA] ;
  G0 : Graded[A,zero,T.D zero] = T.grD zero ;
  module GL0 = Laws[A,zero,T.D zero,T.setD zero,T.grD zero] ;
  module BA0 = BihomogeneousAction4[l].Over[A,zero,T.D zero,T.setD zero,T.grD zero] ;
  f0 (i : Ps.Fin CRt.rk2) : Base.Nat = zero ;
  hf0 : (i : Ps.Fin CRt.rk2) -> BA0.CoefHom (f0 i) (CR0.g i) =
    CRt.pair-ind (\ i -> BA0.CoefHom (f0 i) (CR0.g i)) (GL0.hom-one, tt) (GL0.hom-one, tt) ;
  t0-neg (a : A.R) : Id A.R (G0.pr (negsuc zero) a) A.z = G0.pr-negdeg zero a ;
  t0-one (a : A.R) : Id A.R (G0.pr (pos oneB) a) A.z = GL0.hom-other (pos oneB) zeroZ a (GL0.hom-iota a) ne10 ;

  module Dep (K0 : U l) (cfnA : CFN[l].CFN[K0,A]) {
    module W2 = WeightedDependence4[l].Concrete[K0,A,setA,cfnA,CRt.rk2].W ;
    module W0 = WeightedDependence4[l].Concrete[K0,A,setA,cfnA,zero].W ;
    module I1 = W2.Input[CRt.rk2,d1,f1,g1,hg1,hf1] ;
    module I2 = W2.Input[CRt.rk1,d2,f2,g2,hg2,hf2] ;
    module I0 = W0.Input[CRt.rk2,CR0.dsh,f0,CR0.g,CR0.hg,hf0] ;
    dep1 (c : Nat -> I1.E1.El) (hc : (n : Nat) -> I1.DF.P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[I1.CI.Lifted (c n)].carrier) : Tr.Trunc[I1.Seq[c,hc,lift].WResult].carrier =
      I1.Seq[c,hc,lift].dependence ;
    dep2 (c : Nat -> I2.E1.El) (hc : (n : Nat) -> I2.DF.P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[I2.CI.Lifted (c n)].carrier) : Tr.Trunc[I2.Seq[c,hc,lift].WResult].carrier =
      I2.Seq[c,hc,lift].dependence ;
    dep0 (c : Nat -> I0.E1.El) (hc : (n : Nat) -> I0.DF.P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[I0.CI.Lifted (c n)].carrier) : Tr.Trunc[I0.Seq[c,hc,lift].WResult].carrier =
      I0.Seq[c,hc,lift].dependence ;

    -- 6. N = 0: c_0 = delta v + sum_j g_j a'_j, v of coefficient degree 1
    module Empty0 (c : Nat -> I1.E1.El) (hc : (n : Nat) -> I1.DF.P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[I1.CI.Lifted (c n)].carrier) (w : I1.Seq[c,hc,lift].WBdry zero nil) {
      module ML = IP.ModL[D2,I1.E1.mod] ;
      sub-zero (y : I1.E1.El) : Id I1.E1.El (ML.msub y I1.E1.mod.mz) y = trans (ap (I1.E1.mod.madd y) ML.G.neg-zero) (I1.E1.mod.maddZ y) ;
      empty-case : Id I1.E1.El (c zero) (I1.E1.mod.madd (I1.CI.D0.d0.f w.1) (I1.CI.F1.A.f w.2.1)) =
        trans (sym (sub-zero (c zero))) w.2.2.2.2.2 ;
      degree-one : I1.DF.P0.Hom (pos oneB) w.1 = w.2.2.1 ;
    } ;
  } ;
} ;

------------------------------------------------------------------------
-- over Z, with a_1 = 2, a_2 = 3

module OverZ {
  module ZR = ZRing[l] ;
  module XZ = Over[ZR.ring,ZR.set] ;
  aZ : Ps.Fin CRt.rk2 -> Int = CRt.pair Int (pos twoB) (pos threeB) ;
  module EVZ = CoefficientEvaluation4[l].Over[ZR.ring,ZR.set,CRt.rk2,XZ.D2,XZ.T.setD CRt.rk2,XZ.T.grD CRt.rk2,aZ] ;
  ev (y : XZ.D2.R) : Int = EVZ.ev.1 y ;
  ap2 (f : Int -> Int -> Int) (x x' y y' : Int) (p : Id Int x x') (q : Id Int y y') : Id Int (f x y) (f x' y') =
    trans (ap (\ z -> f z y) p) (ap (f x') q) ;
  evU : Id Int (ev XZ.Uv) (pos twoB) = XZ.G2.ev-var aZ CRt.i0 ;
  evV : Id Int (ev XZ.Vv) (pos threeB) = XZ.G2.ev-var aZ CRt.i1 ;
  -- ev (U^2 + UV) = 2.2 + 2.3 = 10, ev (V^3) = 27
  ev-UU-UV : Id Int (ev (XZ.D2.add XZ.UU XZ.UV)) (pos tenB) =
    trans (EVZ.ev.2.2.1 XZ.UU XZ.UV)
      (trans (ap2 add _ _ _ _ (trans (EVZ.ev.2.2.2 XZ.Uv XZ.Uv) (ap2 ZR.mul _ _ _ _ evU evU)) (trans (EVZ.ev.2.2.2 XZ.Uv XZ.Vv) (ap2 ZR.mul _ _ _ _ evU evV)))
        (refl (pos tenB))) ;
  -- the witnesses of the projected examples: 10 in I^2, 27 in I^3
  w10 : EVZ.FR.Wit twoB (ev (XZ.D2.add XZ.UU XZ.UV)) =
    EVZ.wit-scalar twoB (XZ.D2.add XZ.UU XZ.UV) (XZ.GL.hom-add (pos twoB) XZ.UU XZ.UV XZ.hUU XZ.hUV) ;
  w10' : EVZ.FR.Wit twoB (pos tenB) =
    EVZ.FR.wit-tr twoB _ _ ev-UU-UV w10 ;
  w27 : EVZ.FR.Wit threeB (ev XZ.VVV) = EVZ.wit-scalar threeB XZ.VVV XZ.hVVV ;
  ev-VVV : Id Int (ev XZ.VVV) (pos twentysevenB) =
    trans (EVZ.ev.2.2.2 XZ.Vv (XZ.D2.mul XZ.Vv XZ.Vv))
      (trans (ap2 ZR.mul _ _ _ _ evV (trans (EVZ.ev.2.2.2 XZ.Vv XZ.Vv) (ap2 ZR.mul _ _ _ _ evV evV)))
        (refl (pos twentysevenB))) ;
  w27' : EVZ.FR.Wit threeB (pos twentysevenB) = EVZ.FR.wit-tr threeB _ _ ev-VVV w27 ;
  -- the dependence theorem over Z[U,V] and its evaluation at (2, 3)
  module DZ = XZ.Dep[Nat * Nat,ZCFN[l].cfn] ;
  module EDZ = CoefficientEvaluation4[l].Concrete[Nat * Nat,ZR.ring,ZR.set,ZCFN[l].cfn,CRt.rk2,aZ].ED.Input[CRt.rk2,XZ.d1,XZ.f1,XZ.g1,XZ.hg1,XZ.hf1] ;
  evaluated1 (c : Nat -> EDZ.WD.E1.El) (hc : (n : Nat) -> EDZ.WD.DF.P1.Hom (cdeg (suc n)) (c n))
    (lift : (n : Nat) -> Tr.Trunc[EDZ.WD.CI.Lifted (c n)].carrier) : Tr.Trunc[EDZ.Seq[c,hc,lift].EvResult].carrier =
    EDZ.Seq[c,hc,lift].evaluated ;
} ;
