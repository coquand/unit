-- CoefficientCech4.seg: the coefficient projection on chart cochains
-- (handoff §5, Gate B, first half).
--
-- For a chart element f (Laurent4.Over.Chart: I-indexed coefficient
-- functions Z^4 -> D, finitely supported, vanishing on Bad),
--     (Pr k f)(i)(m) = pr k (f(i)(m))                             (proj)
-- with the SAME support list and the same vanishing set, since pr k 0 = 0:
-- the finite support, the chart conditions and the PROJECTIVE degree are
-- kept.  Pr k is additive (zero, negation, difference, finite sums) and
-- A-linear (Pr k (iota a . f) = iota a . Pr k f), but not D-linear.  The
-- scalar action: for f with all coefficients homogeneous of coefficient
-- degree e (Hom e f), and q in D,
--     Pr k (q f) = pr (k - e) (q) f .                            (proj-scalar)
-- Coefficient homogeneity of a cochain (Hom k f) is homogeneity of every
-- coefficient; it is independent of the projective degree.  Pr k f is
-- homogeneous of degree k, and Pr k f = f when f is.
--
-- The Cech differential (Cech4.D0, D1, D2) is pointwise a difference
-- x - y, (x - y) + z or ((x - y) + z) - w of coefficients at the same
-- exponent, so it commutes with Pr k:  Pr k (delta f) = delta (Pr k f).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module PA4 = PolynomialAction4[l] ;

module Over (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) {
  module GL = Laws[A,t,D,setD,G] ;
  module LO = Laurent4[l].Over[D,setD] ;
  module C = Cech4[l].Over[D,setD] ;
  module DL = C.DL ;

  ------------------------------------------------------------------------
  -- one chart module

  module ChartPr (I : U l) (Bad : I -> E4 -> U l) {
    module CH = LO.Chart[I,Bad] ;
    module SM = Comb[l].Sums[D,CH.mod] ;
    raw (k : Int) (c : CH.Raw) : CH.Raw = \ i m -> G.pr k (c i m) ;
    vanish (k : Int) (s : List E4) (c : CH.Raw) (h : CH.Vanish s c) : CH.Vanish s (raw k c) =
      \ i m n -> trans (ap (G.pr k) (h i m n)) (GL.pr-zero k) ;
    van (k : Int) (c : CH.Raw) (v : CH.Van c) : CH.Van (raw k c) =
      \ i m b -> trans (ap (G.pr k) (v i m b)) (GL.pr-zero k) ;
    -- Pr k, with the same support list
    proj (k : Int) (x : CH.El) : CH.El =
      CH.mk (raw k (CH.val x))
        (TC.map (CH.SuppW (CH.val x)) (CH.SuppW (raw k (CH.val x))) (\ w -> (w.1, vanish k w.1 (CH.val x) w.2)) (CH.supp x))
        (van k (CH.val x) (CH.van x)) ;
    -- by definition of proj
    proj-val (k : Int) (x : CH.El) (i : I) (m : E4) : Id D.R (CH.val (proj k x) i m) (G.pr k (CH.val x i m)) =
      refl (G.pr k (CH.val x i m)) ;

    -- coefficient homogeneity
    Hom (k : Int) (x : CH.El) : U l = (i : I) (m : E4) -> GL.Hom k (CH.val x i m) ;
    hom-proj (k : Int) (x : CH.El) : Hom k (proj k x) = \ i m -> GL.hom-pr k (CH.val x i m) ;
    proj-hom (k : Int) (x : CH.El) (h : Hom k x) : Id CH.El (proj k x) x = CH.eq (proj k x) x h ;
    hom-zero (k : Int) : Hom k CH.mod.mz = \ i m -> GL.hom-zero k ;

    -- additivity and A-linearity
    proj-add (k : Int) (x y : CH.El) : Id CH.El (proj k (CH.mod.madd x y)) (CH.mod.madd (proj k x) (proj k y)) =
      CH.eq _ _ (\ i m -> G.pr-add k (CH.val x i m) (CH.val y i m)) ;
    proj-zero (k : Int) : Id CH.El (proj k CH.mod.mz) CH.mod.mz = CH.eq _ _ (\ i m -> GL.pr-zero k) ;
    proj-neg (k : Int) (x : CH.El) : Id CH.El (proj k (CH.mod.mneg x)) (CH.mod.mneg (proj k x)) =
      CH.eq _ _ (\ i m -> GL.pr-neg k (CH.val x i m)) ;
    proj-sub (k : Int) (x y : CH.El) : Id CH.El (proj k (IP.ModL[D,CH.mod].msub x y)) (IP.ModL[D,CH.mod].msub (proj k x) (proj k y)) =
      CH.eq _ _ (\ i m -> GL.pr-sub k (CH.val x i m) (CH.val y i m)) ;
    proj-sum (k : Int) : (n : Nat) (f : Ps.Fin n -> CH.El) -> Id CH.El (proj k (SM.sum n f)) (SM.sum n (\ j -> proj k (f j))) = split {
      zero -> \ f -> proj-zero k ;
      suc n | r -> \ f -> trans (proj-add k (f (inr tt)) (SM.sum n (\ j -> f (inl j))))
                                (ap (CH.mod.madd (proj k (f (inr tt)))) (r (\ j -> f (inl j)))) } ;
    proj-iota (k : Int) (a : A.R) (x : CH.El) : Id CH.El (proj k (CH.mod.sm (G.iota.1 a) x)) (CH.mod.sm (G.iota.1 a) (proj k x)) =
      CH.eq _ _ (\ i m -> GL.pr-iota k a (CH.val x i m)) ;

    -- the scalar action: Pr k (q x) = pr (k - e)(q) x for x of degree e
    proj-scalar (k e : Int) (q : D.R) (x : CH.El) (h : Hom e x) :
      Id CH.El (proj k (CH.mod.sm q x)) (CH.mod.sm (G.pr (subZ k e) q) x) =
      CH.eq _ _ (\ i m -> G.pr-mul k e q (CH.val x i m) (h i m)) ;
    proj-scalar-pos (k : Int) (n : Base.Nat) (q : D.R) (x : CH.El) (h : Hom (pos n) x) :
      Id CH.El (proj k (CH.mod.sm q x)) (CH.mod.sm (G.pr (PA4.minus k n) q) x) =
      CH.eq _ _ (\ i m -> GL.pr-mul-pos k n q (CH.val x i m) (h i m)) ;
  } ;

  ------------------------------------------------------------------------
  -- the differential commutes with Pr k

  pr-T (k : Int) (x y z : D.R) : Id D.R (G.pr k (D.add (DL.msub x y) z)) (D.add (DL.msub (G.pr k x) (G.pr k y)) (G.pr k z)) =
    trans (G.pr-add k (DL.msub x y) z) (ap (\ w -> D.add w (G.pr k z)) (GL.pr-sub k x y)) ;
  pr-Q (k : Int) (x y z w : D.R) :
    Id D.R (G.pr k (DL.msub (D.add (DL.msub x y) z) w)) (DL.msub (D.add (DL.msub (G.pr k x) (G.pr k y)) (G.pr k z)) (G.pr k w)) =
    trans (GL.pr-sub k (D.add (DL.msub x y) z) w) (ap (\ v -> DL.msub v (G.pr k w)) (pr-T k x y z)) ;

  d0-proj (k : Int) (c : Pt -> E4 -> D.R) : (j : Ed) (m : E4) ->
    Id D.R (G.pr k (C.d0 c j m)) (C.d0 (\ i m' -> G.pr k (c i m')) j m) = split {
    e01 -> \ m -> GL.pr-sub k (c p1 m) (c p0 m) ;
    e02 -> \ m -> GL.pr-sub k (c p2 m) (c p0 m) ;
    e03 -> \ m -> GL.pr-sub k (c p3 m) (c p0 m) ;
    e12 -> \ m -> GL.pr-sub k (c p2 m) (c p1 m) ;
    e13 -> \ m -> GL.pr-sub k (c p3 m) (c p1 m) ;
    e23 -> \ m -> GL.pr-sub k (c p3 m) (c p2 m) } ;
  d1-proj (k : Int) (c : Ed -> E4 -> D.R) : (j : Tri) (m : E4) ->
    Id D.R (G.pr k (C.d1 c j m)) (C.d1 (\ i m' -> G.pr k (c i m')) j m) = split {
    t012 -> \ m -> pr-T k (c e12 m) (c e02 m) (c e01 m) ;
    t013 -> \ m -> pr-T k (c e13 m) (c e03 m) (c e01 m) ;
    t023 -> \ m -> pr-T k (c e23 m) (c e03 m) (c e02 m) ;
    t123 -> \ m -> pr-T k (c e23 m) (c e13 m) (c e12 m) } ;
  d2-proj (k : Int) (c : Tri -> E4 -> D.R) : (j : Sq) (m : E4) ->
    Id D.R (G.pr k (C.d2 c j m)) (C.d2 (\ i m' -> G.pr k (c i m')) j m) = split {
    s0123 -> \ m -> pr-Q k (c t123 m) (c t023 m) (c t013 m) (c t012 m) } ;

  -- on the cochain modules of projective twist n
  module Diff (n : Int) {
    module P0 = ChartPr[Pt,BadI Pt setPt n] ; module P1 = ChartPr[Ed,BadI Ed setEd n] ;
    module P2 = ChartPr[Tri,BadI Tri setTri n] ; module P3 = ChartPr[Sq,BadI Sq setSq n] ;
    D0-proj (k : Int) (x : P0.CH.El) : Id P1.CH.El (P1.proj k ((C.D0 n).f x)) ((C.D0 n).f (P0.proj k x)) =
      P1.CH.eq _ _ (d0-proj k (P0.CH.val x)) ;
    D1-proj (k : Int) (x : P1.CH.El) : Id P2.CH.El (P2.proj k ((C.D1 n).f x)) ((C.D1 n).f (P1.proj k x)) =
      P2.CH.eq _ _ (d1-proj k (P1.CH.val x)) ;
    D2-proj (k : Int) (x : P2.CH.El) : Id P3.CH.El (P3.proj k ((C.D2 n).f x)) ((C.D2 n).f (P2.proj k x)) =
      P3.CH.eq _ _ (d2-proj k (P2.CH.val x)) ;
  } ;
} ;
