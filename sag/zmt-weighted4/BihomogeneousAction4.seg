-- BihomogeneousAction4.seg: coefficient projection and the action of
-- bihomogeneous polynomials (handoff §5, Gate B, second half).
--
-- A term list g over D in the PROJECTIVE variables X_0..X_3 has
-- coefficient degree f (CoefHom f g) when every D-coefficient of every term
-- is homogeneous of U-degree f (zero coefficients allowed).  With the
-- existing HomogeneousMatrices4.HomDeg d g this is a bihomogeneous input
-- of bidegree (d, f).
-- Action formula.  For g of coefficient degree f, every integer k, every
-- coefficient function F and exponent m,
--     pr k ((g F)(m)) = (g (pr (k - f) o F))(m)                (mulP-proj)
-- termwise: pr k (c F(m - u)) = c pr (k - f) F(m - u) for c of degree f
-- (Laws.pr-mul-pos-left), and pr k is additive.  Hence, on chart cochains
-- of any projective twists,  Pr k (g a) = g Pr (k - f) (a)  (act-proj); no
-- compatibility of the Cech contraction with the coefficient grading is
-- used: only the polynomial action itself is projected.
-- On the families of HomogeneousMatrices4.Fam (E1 = prod_i C(n - d_i)),
-- for f_i the coefficient degree of g_i,
--     (Pr k y)_i = Pr (k - f_i) (y_i),    Pr k (A y) = A (Pr k y)   (A-proj)
-- with A y = sum_i g_i y_i.  The two actions are kept apart: the scalar
-- action of q in D (CoefficientCech4.ChartPr.proj-scalar) and the action of
-- a polynomial g in X_0..X_3 (here).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ; open ShiftedCech4[l] ;
open HomogeneousMatrices4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;

module Over (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) {
  module GL = Laws[A,t,D,setD,G] ;
  module CC = CoefficientCech4[l].Over[A,t,D,setD,G] ;
  module PA = PolynomialAction4[l].Over[D,setD] ;
  module SC = ShiftedCech4[l].Over[D,setD] ;
  module HM = HomogeneousMatrices4[l].Over[D,setD] ;
  module DL = CC.DL ;

  -- every coefficient of g has U-degree f
  CoefHom (f : Base.Nat) : TPoly D.R -> U l = split {
    nil -> Top ;
    cons u p | r -> GL.Hom (pos f) u.1 * r } ;

  -- pr k ((g F)(m)) = (g (pr (k - f) o F))(m)
  mulP-proj (k : Int) (f : Base.Nat) : (p : TPoly D.R) -> CoefHom f p -> (F : E4 -> D.R) (m : E4) ->
    Id D.R (G.pr k (PA.mulP p F m)) (PA.mulP p (\ m' -> G.pr (minus k f) (F m')) m) = split {
    nil -> \ hp F m -> GL.pr-zero k ;
    cons u p | r -> \ hp F m ->
      trans (G.pr-add k (D.mul u.1 (F (subE m u.2))) (PA.mulP p F m))
            (DL.G.cong-add (GL.pr-mul-pos-left k f u.1 (F (subE m u.2)) hp.1) (r hp.2 F m)) } ;

  -- on the chart cochains: Pr k (g a) = g Pr (k - f) a
  module Act (I : U l) (set : I -> Sub4) (k0 k1 : Int) (p : TPoly D.R) (hp : SC.Shifts k0 k1 p) (f : Base.Nat) (hf : CoefHom f p) {
    module AC = SC.Act[I,set,k0,k1,p,hp] ;
    module P0 = CC.ChartPr[I,BadI I set k0] ; module P1 = CC.ChartPr[I,BadI I set k1] ;
    act-proj (k : Int) (x : P0.CH.El) : Id P1.CH.El (P1.proj k (AC.lin.f x)) (AC.lin.f (P0.proj (minus k f) x)) =
      P1.CH.eq _ _ (\ i m -> mulP-proj k f p hf (P0.CH.val x i) m) ;
  } ;

  ------------------------------------------------------------------------
  -- the families E0 = C(n), E1 = prod_i C(n - d_i) and A y = sum_i g_i y_i

  module FamPr (M : Matrices[D]) (f : Ps.Fin M.a -> Base.Nat) (hf : (i : Ps.Fin M.a) -> CoefHom (f i) (M.g i))
    (I : U l) (set : I -> Sub4) (n : Int) {
    module F = HM.Fam[M,I,set,n] ;
    module P0 = CC.ChartPr[I,BadI I set n] ;
    module P1 (i : Ps.Fin M.a) { module P = CC.ChartPr[I,BadI I set (F.k1 i)] ; } ;
    -- (Pr k y)_i = Pr (k - f_i) y_i
    proj (k : Int) (y : F.E1.El) : F.E1.El = \ i -> P1[i].P.proj (minus k (f i)) (y i) ;
    Hom (k : Int) (y : F.E1.El) : U l = (i : Ps.Fin M.a) -> P1[i].P.Hom (minus k (f i)) (y i) ;
    hom-proj (k : Int) (y : F.E1.El) : Hom k (proj k y) = \ i -> P1[i].P.hom-proj (minus k (f i)) (y i) ;
    -- g_i (Pr (k - f_i) y_i) = Pr k (g_i y_i)
    gi-proj (k : Int) (y : F.E1.El) (i : Ps.Fin M.a) :
      Id F.E0.El (P0.proj k ((F.gi i).f (y i))) ((F.gi i).f (P1[i].P.proj (minus k (f i)) (y i))) =
      Act[I,set,F.k1 i,n,M.g i,HM.hg-shifts n (M.d i) (M.g i) (M.hg i),f i,hf i].act-proj k (y i) ;
    -- Pr k (A y) = A (Pr k y)
    A-proj (k : Int) (y : F.E1.El) : Id F.E0.El (P0.proj k (F.A.f y)) (F.A.f (proj k y)) =
      trans (P0.proj-sum k M.a (\ i -> (F.gi i).f (y i)))
            (F.S0.sum-cong M.a (\ i -> P0.proj k ((F.gi i).f (y i))) (\ i -> (F.gi i).f (proj k y i)) (gi-proj k y)) ;
  } ;
} ;
