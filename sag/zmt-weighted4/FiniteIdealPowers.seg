-- FiniteIdealPowers.seg: I^k M for the ideal I = (a_1, .., a_t) generated
-- by a finite list, t >= 0 (handoff §7).
--
-- Recursive form (Pow): every x is in I^0 M; x is in I^(k+1) M iff merely
--     x = sum_j a_j x_j  with every x_j in I^k M.
-- Pow k x is a proposition.  Explicit witnesses (Wit) are the same tree
-- without truncation; wit-pow forgets it.  The empty generator list is
-- allowed: then sum_j a_j x_j = 0, so I^(k+1) M = 0.
-- Integer degrees (PowZ, WitZ): for k = pos n, I^n M; for k < 0 the zero
-- element only (a homogeneous element of negative degree is 0).
-- Lemmas: 0 is in every I^k M (wit-zero); witnesses are carried along
-- equalities (wit-tr).
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;

top-prop : (x y : Top) -> Id Top x y = split { tt -> split { tt -> refl tt } } ;

module Over (A : CRing) (Md : IP.Mod[A]) (t : Nat) (a : Ps.Fin t -> A.R) {
  module S = Comb[l].Sums[A,Md] ;
  -- sum_j a_j x_j
  gen (xs : Ps.Fin t -> Md.M) : Md.M = S.comb t a xs ;

  -- one step: x = sum_j a_j x_j with every x_j in P
  Step (P : Md.M -> U l) (x : Md.M) : U l = (xs : Ps.Fin t -> Md.M) * (((j : Ps.Fin t) -> P (xs j)) * Id Md.M x (gen xs)) ;
  -- explicit witnesses
  Wit : Base.Nat -> Md.M -> U l = split {
    zero -> \ x -> Top ;
    suc k | r -> Step r } ;
  -- membership
  Pow : Base.Nat -> Md.M -> U l = split {
    zero -> \ x -> Top ;
    suc k | r -> \ x -> Tr.Trunc[Step r x].carrier } ;
  pow-prop : (k : Base.Nat) (x : Md.M) -> Pr.isProp (Pow k x) = split {
    zero -> \ x -> top-prop ;
    suc k | r -> \ x -> Tr.Trunc[Step (Pow k) x].proposition } ;
  wit-pow : (k : Base.Nat) (x : Md.M) -> Wit k x -> Pow k x = split {
    zero -> \ x w -> tt ;
    suc k | r -> \ x w -> Tr.Trunc[Step (Pow k) x].inc (w.1, (\ j -> r (w.1 j) (w.2.1 j), w.2.2)) } ;

  wit-tr (k : Base.Nat) (x y : Md.M) (e : Id Md.M x y) (w : Wit k x) : Wit k y = subst (Wit k) e w ;
  wit-zero : (k : Base.Nat) -> Wit k Md.mz = split {
    zero -> tt ;
    suc k | r -> ((\ j -> Md.mz), ((\ j -> r), sym (S.comb-vanish t a (\ j -> Md.mz) (\ j -> refl Md.mz)))) } ;

  -- integer degrees
  WitZ : Int -> Md.M -> U l = split {
    pos n -> Wit n ;
    negsuc n -> \ x -> Id Md.M x Md.mz } ;
  PowZ : Int -> Md.M -> U l = split {
    pos n -> Pow n ;
    negsuc n -> \ x -> Id Md.M x Md.mz } ;
  witZ-powZ : (k : Int) (x : Md.M) -> WitZ k x -> PowZ k x = split {
    pos n -> wit-pow n ;
    negsuc n -> \ x w -> w } ;
} ;
