-- WeightedDependence4.seg: weighted dependence, by projecting the final
-- identity of CoherentDependence4 (handoff §6, Gate C).
--
-- Theorem (Over[K0,A,t,D,setD,G,cfn].Input[a,d,f,g,hg,hf].Seq[c,hc,lift]
-- .dependence; concretely for D = A[U_1..U_t]: Concrete[..].W...).
-- Let D be a CFN commutative set-ring graded over A (Graded A t D), g_j
-- term-list polynomials in X_0..X_3, every term of projective degree d_j
-- (HomDeg) with every coefficient of U-degree f_j (CoefHom).  Let
-- c : Nat -> C^1(-1) with c_n of coefficient degree n+1 (hc), and merely
-- u_n,j in C^2(-1-d_j) with  delta c_n = sum_j g_j u_n,j  (lift, the
-- hypothesis of CoherentDependence4; no degree is prescribed for u).
-- Then merely there are rs = [r_(N-1), .., r_0] (N = len rs), v in C^0(-1)
-- and a'_j in C^1(-1-d_j) with
--     c_N - sum_{i<N} r_i c_i = delta v + sum_j g_j a'_j ,           (W)
-- r_i of coefficient degree N - i (HomL), v of degree N+1 and a'_j of
-- degree N+1-f_j (FamPr.Hom).  N = 0 and the empty list are allowed; v
-- then has degree 1.  A negative N+1-f_j is allowed: a'_j is then 0.
--
-- Proof.  CoherentDependence4 (unchanged) gives merely qs, h, a with
--     c_N - sum_{i<N} q_i c_i = delta h + sum_j g_j a_j ,  N = len qs.  (U)
-- Apply Pr (N+1) to (U) (Project.W-eq):
--   Pr (N+1) c_N = c_N                               (c_N of degree N+1)
--   Pr (N+1) (q_i c_i) = pr (N - i)(q_i) c_i         (proj-scalar, c_i of degree i+1)
--   Pr (N+1) (delta h) = delta (Pr (N+1) h)          (CoefficientCech4.Diff)
--   Pr (N+1) (g_j a_j) = g_j Pr (N+1-f_j) (a_j)      (BihomogeneousAction4)
-- and Pr (N+1) is additive.  So r_i = pr (N - i)(q_i), v = Pr (N+1) h,
-- a'_j = Pr (N+1-f_j) a_j.  No homogeneity of q, h, a is used, and no
-- syzygy is constructed here: the syzygies are those of the checked
-- theorem.  The list: qs = [q_(N-1), .., q_0]; the entry with tail length
-- i is replaced by pr (N - i)(q_i), with the FIXED outer N (projL N);
-- projL keeps the length (len-proj) and sum-proj is the projected sum.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
open HomogeneousMatrices4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module TL4 = TopList4[l] ;

module Over (K0 : U l) (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) (cfn : CFN[l].CFN[K0,D]) {
  module GL = Laws[A,t,D,setD,G] ;
  module CC = CoefficientCech4[l].Over[A,t,D,setD,G] ;
  module BA = BihomogeneousAction4[l].Over[A,t,D,setD,G] ;
  module CD = CoherentDependence4[l].Over[K0,D,setD,cfn] ;

  module Input (a : Nat) (d : Ps.Fin a -> Base.Nat) (f : Ps.Fin a -> Base.Nat) (g : Ps.Fin a -> TPoly D.R)
    (hg : (i : Ps.Fin a) -> HomDeg D.R (d i) (g i)) (hf : (i : Ps.Fin a) -> BA.CoefHom (f i) (g i)) {
    module CI = CD.Input[a,d,g,hg] ;
    -- Pr on C^0(-1), C^1(-1) and on prod_j C^1(-1-d_j)
    module DF = CC.Diff[TL4.mOne] ;
    module FP = BA.FamPr[CI.M0,f,hf,Ed,setEd,TL4.mOne] ;
    module E1 = CI.F1.E0 ;

    module Seq (c : Nat -> E1.El) (hc : (n : Nat) -> DF.P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[CI.Lifted (c n)].carrier) {
      module CS = CI.Seq[c,lift] ;

      -- the entry with tail length i gets pr (N - i)
      projL (N : Nat) : List D.R -> List D.R = split {
        nil -> nil ;
        cons x xs | r -> cons (G.pr (lowerZ (cdeg N) (len xs)) x) r } ;
      len-proj (N : Nat) : (qs : List D.R) -> Id Nat (len (projL N qs)) (len qs) = split {
        nil -> refl zero ;
        cons x xs | r -> ap (\ n -> suc n) r } ;
      -- the entry with tail length i has coefficient degree N - i
      HomL (N : Nat) : List D.R -> U l = split {
        nil -> Top ;
        cons x xs | r -> GL.Hom (lowerZ (cdeg N) (len xs)) x * r } ;
      hom-projL (N : Nat) : (qs : List D.R) -> HomL N (projL N qs) = split {
        nil -> tt ;
        cons x xs | r -> (subst (\ n -> GL.Hom (lowerZ (cdeg N) n) (G.pr (lowerZ (cdeg N) (len xs)) x)) (sym (len-proj N xs))
                            (GL.hom-pr (lowerZ (cdeg N) (len xs)) x), r) } ;

      -- Pr (N+1) (q c_i) = pr (N - i)(q) c_i
      term-proj (N : Nat) (q : D.R) (i : Nat) :
        Id E1.El (DF.P1.proj (cdeg (suc N)) (E1.mod.sm q (c i))) (E1.mod.sm (G.pr (lowerZ (cdeg N) i) q) (c i)) =
        trans (DF.P1.proj-scalar-pos (cdeg (suc N)) (suc (toB i)) q (c i) (hc i))
              (ap (\ e -> E1.mod.sm (G.pr e q) (c i)) (minus-suc-suc (cdeg N) (toB i))) ;
      -- Pr (N+1) (sum_{i<N} q_i c_i) = sum_{i<N} pr (N - i)(q_i) c_i
      sum-proj (N : Nat) : (qs : List D.R) -> Id E1.El (DF.P1.proj (cdeg (suc N)) (CS.sumL qs)) (CS.sumL (projL N qs)) = split {
        nil -> DF.P1.proj-zero (cdeg (suc N)) ;
        cons x xs | r -> calc E1.El {
          DF.P1.proj (cdeg (suc N)) (E1.mod.madd (E1.mod.sm x (c (len xs))) (CS.sumL xs))
            =< DF.P1.proj-add (cdeg (suc N)) (E1.mod.sm x (c (len xs))) (CS.sumL xs)
            > E1.mod.madd (DF.P1.proj (cdeg (suc N)) (E1.mod.sm x (c (len xs)))) (DF.P1.proj (cdeg (suc N)) (CS.sumL xs))
            =< CI.MZ.G.cong-add (term-proj N x (len xs)) r
            > E1.mod.madd (E1.mod.sm (G.pr (lowerZ (cdeg N) (len xs)) x) (c (len xs))) (CS.sumL (projL N xs))
            =< ap (\ n -> E1.mod.madd (E1.mod.sm (G.pr (lowerZ (cdeg N) (len xs)) x) (c n)) (CS.sumL (projL N xs))) (sym (len-proj N xs))
            > CS.sumL (projL N (cons x xs)) } } ;

      -- the weighted conclusion (W) for N and rs
      WBdry (N : Nat) (rs : List D.R) : U l =
        (v : CI.F0.E0.El) * ((a' : CI.F1.E1.El) * (DF.P0.Hom (cdeg (suc N)) v * (FP.Hom (cdeg (suc N)) a' * (HomL N rs *
          Id E1.El (CI.MZ.msub (c N) (CS.sumL rs)) (E1.mod.madd (CI.D0.d0.f v) (CI.F1.A.f a')))))) ;
      WResult : U l = (rs : List D.R) * WBdry (len rs) rs ;
      -- accessors
      module WR (w : WResult) {
        rs : List D.R = w.1 ;
        N : Nat = len w.1 ;
        v : CI.F0.E0.El = w.2.1 ;
        a' : CI.F1.E1.El = w.2.2.1 ;
        hom-v : DF.P0.Hom (cdeg (suc N)) v = w.2.2.2.1 ;
        hom-a : FP.Hom (cdeg (suc N)) a' = w.2.2.2.2.1 ;
        hom-r : HomL N rs = w.2.2.2.2.2.1 ;
        eq : Id E1.El (CI.MZ.msub (c N) (CS.sumL rs)) (E1.mod.madd (CI.D0.d0.f v) (CI.F1.A.f a')) = w.2.2.2.2.2.2 ;
      } ;

      -- projecting one result (U) of CoherentDependence4
      module Project (res : CS.Result) {
        qs : List D.R = res.1 ;
        N : Nat = len res.1 ;
        h : CI.F0.E0.El = res.2.1 ;
        a0 : CI.F1.E1.El = res.2.2.1 ;
        -- (U)
        U-eq : Id E1.El (CI.MZ.msub (c N) (CS.sumL qs)) (E1.mod.madd (CI.D0.d0.f h) (CI.F1.A.f a0)) = res.2.2.2 ;
        k : Int = cdeg (suc N) ;
        rs : List D.R = projL N qs ;
        v : CI.F0.E0.El = DF.P0.proj k h ;
        a' : CI.F1.E1.El = FP.proj k a0 ;
        -- (W) = Pr (N+1) (U)
        W-eq : Id E1.El (CI.MZ.msub (c N) (CS.sumL rs)) (E1.mod.madd (CI.D0.d0.f v) (CI.F1.A.f a')) = calc E1.El {
          CI.MZ.msub (c N) (CS.sumL rs)
            =< ap (\ w -> CI.MZ.msub w (CS.sumL rs)) (sym (DF.P1.proj-hom k (c N) (hc N)))
            > CI.MZ.msub (DF.P1.proj k (c N)) (CS.sumL rs)
            =< ap (CI.MZ.msub (DF.P1.proj k (c N))) (sym (sum-proj N qs))
            > CI.MZ.msub (DF.P1.proj k (c N)) (DF.P1.proj k (CS.sumL qs))
            =< sym (DF.P1.proj-sub k (c N) (CS.sumL qs)) > DF.P1.proj k (CI.MZ.msub (c N) (CS.sumL qs))
            =< ap (DF.P1.proj k) U-eq > DF.P1.proj k (E1.mod.madd (CI.D0.d0.f h) (CI.F1.A.f a0))
            =< DF.P1.proj-add k (CI.D0.d0.f h) (CI.F1.A.f a0)
            > E1.mod.madd (DF.P1.proj k (CI.D0.d0.f h)) (DF.P1.proj k (CI.F1.A.f a0))
            =< CI.MZ.G.cong-add (DF.D0-proj k h) (FP.A-proj k a0)
            > E1.mod.madd (CI.D0.d0.f v) (CI.F1.A.f a') } ;
        bdry : WBdry N rs = (v, (a', (DF.P0.hom-proj k h, (FP.hom-proj k a0, (hom-projL N qs, W-eq))))) ;
        result : WResult = (rs, subst (\ n -> WBdry n rs) (sym (len-proj N qs)) bdry) ;
      } ;

      -- THEOREM (Gate C)
      dependence : Tr.Trunc[WResult].carrier = TC.map CS.Result WResult (\ res -> Project[res].result) CS.dependence ;
    } ;
  } ;
} ;

-- the concrete theorem: D = A[U_1, .., U_t] with its constructed grading
-- and CFN structure
module Concrete (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) (t : Nat) {
  module T = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  module W = Over[K0,A,t,T.D t,T.setD t,T.grD t,T.cfnD K0 cfnA t] ;
} ;
