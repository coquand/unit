-- Regression boundaries: transition factors cannot be dropped, different
-- degrees are separated, and the inverse retains the actual fibre at 0.
level l ; open Prelude[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module I = PicardInterface[l].Over[R,setR] ;
 module T (t : I.LaurentUnit) {
  module B = W.Glue[t] ;
  retained-transition (x : G.Unit) : Id (B.raw (P.affine x.1)).1
   (subst P.P1 (\ z -> (B.raw z).1) (P.infinity-chart x.2.1) (P.affine x.1)
    (sym P.P1 _ _ (P.overlap x.1 x.2.1 x.2.2)) (B.chart-frame (hi x.2.1)))
   ((B.raw (P.affine x.1)).2.1 (t x) (B.chart-frame (lo x.1))) = B.transition x ;
  #fails {
   -- A genuine transition is multiplication by t(x), not the identity.
   dropped-transition (x : G.Unit) : Id (B.raw (P.affine x.1)).1
    (subst P.P1 (\ z -> (B.raw z).1) (P.infinity-chart x.2.1) (P.affine x.1)
     (sym P.P1 _ _ (P.overlap x.1 x.2.1 x.2.2)) (B.chart-frame (hi x.2.1)))
    (B.chart-frame (lo x.1)) = B.transition x ;
  } ;
 } ;
 module Distinct (unique : I.DegreeUnique) {
  module S = PicardSeparation[l].Over[R,setR,unique] ;
  d0 : PicardInterface[l].Degree = nonneg zero ;
  d1 : PicardInterface[l].Degree = nonneg (suc zero) ;
  no-equal-degrees (p : Id PicardInterface[l].Degree d0 d1) : Ring[l].Empty =
   Ring[l].zero-suc zero
    (subst PicardInterface[l].Degree (PicardDegree[l].dcode d0) d0 d1 p (refl zero)) ;
  distinct-twists (p : Id (P.P1 -> W.L.Line) (W.O d0) (W.O d1)) : Ring[l].Empty =
   no-equal-degrees (S.separate d0 d1 p) ;
  #fails {
   collapse : Id (P.P1 -> W.L.Line) (W.O d0) (W.O d1) = refl (W.O d0) ;
  } ;
 } ;
 module Checked (algebra : I.AlgebraResults) (charts : W.ChartTriviality) {
  module Thm = PicardTheorem[l].Over[R,setR,algebra,charts] ;
  inverse-fibre (B : P.P1 -> W.L.Line) : Id W.L.Line (Thm.inverse B).1 (B (P.affine R.z)) = refl (B (P.affine R.z)) ;
  degree-of-twist (d : PicardInterface[l].Degree) : Id PicardInterface[l].Degree (Thm.degree (W.O d)) d =
   Thm.C.equal-degrees (W.O d) (Thm.degree (W.O d)) d (Thm.C.chosen (W.O d)).2
    (Truncation[l].Trunc[Id (P.P1 -> W.L.Line) (W.O d) (W.O d)].inc (refl (W.O d))) ;
  reconstruction (B : P.P1 -> W.L.Line) : Id (P.P1 -> W.L.Line)
   (W.classify (B (P.affine R.z)) (Thm.degree B)) B = Thm.C.sec B ;
 } ;
} ;
