-- The geometric form of rank-one Horrocks. A torsor family over Spec R[X]
-- trivial on a monic standard open is merely globally trivial.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module RX = C.Polynomial[C.base] ;
 module H = HorrocksInterface[l].Over[R,setR] ;
 fp : P.FP RX.algebra = AddVariable[l].Over[R,setR].preserves-FP C.base BasePresentation[l].Over[R,setR].finitely-presented ;
 X : U l = C.Spec RX.algebra ;
 module For (T : X -> AS.TI.Tor) (lower : List R.R)
  (local-frame : (x : X) -> RL[R].unit (x.1.1 (H.monic lower)) -> (T x).1) {
  module A = AffineLineProjector[l].Over[R,setR,axioms].At[RX.algebra,fp,T] ;
  module Local = AffineLocalFrames[l].Over[R,setR,axioms].At[RX.algebra,fp,T] ;
  module Global = AffineFreeFrames[l].Over[R,setR,axioms].At[RX.algebra,fp,T] ;
  module From (w : A.D.Data) {
   module E = A.From[w] ;
   local-certificate : E.M.FreeAfter E.entry (H.monic lower) = Local.From[w,H.monic lower,local-frame].theorem ;
   free : E.M.Free E.entry = DivisorHorrocks[l].Over[R,setR,axioms.loc.2].horrocks lower E.n E.projector local-certificate ;
   frames : Tr.Trunc[Global.Frames].carrier = Global.From[w].theorem free ;
  } ;
  theorem : Tr.Trunc[Global.Frames].carrier =
   Tr.Trunc[A.D.Data].induction @l (\ w -> Tr.Trunc[Global.Frames].carrier)
    (\ w -> Tr.Trunc[Global.Frames].proposition) (\ w -> From[w].frames) A.D.theorem ;
 } ;
} ;
