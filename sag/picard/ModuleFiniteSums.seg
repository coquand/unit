-- Finite sums indexed by the Fin used in presentations and projectors.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (M : Modules[l].Over[R,setR].Module) {
 module MD = Modules[l].Over[R,setR] ;
 module MA = Alg73[l].MA[MD.ring,M] ;
 module S = FiniteIdeal[l].Sums[R] ;
 sum : (n : Nat) -> (Fin n -> M.M) -> M.M = split {
  zero -> \ v -> M.mz ;
  suc n | ih -> \ v -> M.madd (v (inr tt)) (ih (\ i -> v (inl i))) } ;
 congruent : (n : Nat) (v w : Fin n -> M.M) ->
  ((i : Fin n) -> Id M.M (v i) (w i)) -> Id M.M (sum n v) (sum n w) = split {
  zero -> \ v w h -> refl M.mz ;
  suc n | ih -> \ v w h ->
   cong2 M.M M.madd _ _ _ _ (h (inr tt)) (ih (\ i -> v (inl i)) (\ i -> w (inl i)) (\ i -> h (inl i))) } ;
 map (f : M.M -> R.R) (fz : Id R.R (f M.mz) R.z)
  (fa : (u v : M.M) -> Id R.R (f (M.madd u v)) (R.add (f u) (f v))) :
  (n : Nat) (v : Fin n -> M.M) -> Id R.R (f (sum n v)) (S.sum n (\ i -> f (v i))) = split {
  zero -> \ v -> fz ;
  suc n | ih -> \ v ->
   trans (fa (v (inr tt)) (sum n (\ i -> v (inl i))))
    (ap (R.add (f (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 sum-scale (v : M.M) : (n : Nat) (a : Fin n -> R.R) ->
  Id M.M (sum n (\ i -> M.sm (a i) v)) (M.sm (S.sum n a) v) = split {
  zero -> \ a -> sym (MA.sm-zl v) ;
  suc n | ih -> \ a ->
   trans (ap (M.madd (M.sm (a (inr tt)) v)) (ih (\ i -> a (inl i))))
    (sym (M.smE (a (inr tt)) (S.sum n (\ i -> a (inl i))) v)) } ;
} ;
