-- A frame on D(f) gives precisely the local certificate Horrocks consumes.
-- Extend the frame and dual frame, then clear one scalar difference.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module NF = NatFin[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 open R ; open RL[R] ;
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ; module MD = Modules[l].Over[R,setR] ;
 module Pt = Affine[l].PtL[MD.ring,MD.regular] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (T : C.Spec Alg -> AS.TI.Tor) {
  module A = AffineLineProjector[l].Over[R,setR,axioms].At[Alg,fp,T] ;
  module D = A.D ;
  module Clear = AffineScalarClearing[l].Over[R,setR,axioms].At[Alg,fp,D.scheme] ;
  module Pow = AffinePowers[l].Over[Alg.ring] ;
  module From (w : D.Data) (f : Alg.ring.R)
   (t : (x : A.X) -> unit (x.1.1 f) -> (T x).1) {
   module E = A.From[w] ;
   g (x : A.X) : R.R = x.1.1 f ;
   sl (x : A.X) (u : unit (g x)) : (D.LM x).M = D.Fiber[x].Pair.Based[t x u].frame ;
   dl (x : A.X) (u : unit (g x)) : (D.DM x).M = D.Fiber[x].Pair.Based[t x u].dual-frame ;
   module Reps (v : D.AL.Rep g sl) (e : D.AD.Rep g dl) {
    module S = AffineScalarFactor[l].Over[R,setR,axioms].At[Alg,fp,T].From[w,v.1,e.1] ;
    N : Nat = plus (NF.fromN e.2.1) (NF.fromN v.2.1) ;
    module OnOpen (x : A.X) (u : unit (g x)) {
     a : R.R = (v.1 x).1 (t x u) ;
     b : R.R = (e.1 x).1 (t x u) ;
     le : Id R.R o (mul (MD.RA.pw u.1 v.2.1) a) =
      trans (sym (D.Fiber[x].L.Based[t x u].beta o)) (ap (\ z -> z.1 (t x u)) (v.2.2 x u)) ;
     de : Id R.R o (mul (MD.RA.pw u.1 e.2.1) b) =
      trans (sym (D.Fiber[x].D.Based[t x u].beta o)) (ap (\ z -> z.1 (t x u)) (e.2.2 x u)) ;
     la : Id R.R a (MD.RA.pw (g x) v.2.1) =
      trans (sym (Pt.cancel-pw u.1 (g x) (trans (mulC u.1 (g x)) u.2) v.2.1 a))
       (trans (ap (mul (MD.RA.pw (g x) v.2.1)) (sym le)) (mulO (MD.RA.pw (g x) v.2.1))) ;
     db : Id R.R b (MD.RA.pw (g x) e.2.1) =
      trans (sym (Pt.cancel-pw u.1 (g x) (trans (mulC u.1 (g x)) u.2) e.2.1 b))
       (trans (ap (mul (MD.RA.pw (g x) e.2.1)) (sym de)) (mulO (MD.RA.pw (g x) e.2.1))) ;
     equation : Id R.R (x.1.1 S.r) (x.1.1 (Pow.power f N)) =
      trans (S.rb x) (trans (D.Fiber[x].Pair.beta (e.1 x) (v.1 x) (t x u))
       (trans (cong2 R.R mul _ _ _ _ db la)
        (trans (sym (cong2 R.R mul _ _ _ _ (Clear.power-eval f e.2.1 x) (Clear.power-eval f v.2.1 x)))
         (trans (sym (x.1.2.2.2 (Pow.power f (NF.fromN e.2.1)) (Pow.power f (NF.fromN v.2.1))))
          (ap x.1.1 (sym (Pow.power-add f (NF.fromN e.2.1) (NF.fromN v.2.1)))))))) ;
    } ;
    module Eq = Clear.EqualOn[f,S.r,Pow.power f N,\ x u -> OnOpen[x,u].equation] ;
    module Killed (k : Eq.Witness) {
     a : Alg.ring.R = Pow.power f k.1 ;
     target : Id Alg.ring.R (Alg.ring.mul a S.r) (Pow.power f (plus k.1 N)) =
      trans k.2 (sym (Pow.power-add f k.1 N)) ;
     xs (i : Fin E.n) : Alg.ring.R = Alg.ring.mul a (S.x i) ;
     factor (i j : Fin E.n) : Id Alg.ring.R (Alg.ring.mul (xs i) (S.y j))
      (Alg.ring.mul (Pow.power f (plus k.1 N)) (E.entry i j)) =
      trans (sym (Alg.ring.mulA a (S.x i) (S.y j)))
       (trans (ap (Alg.ring.mul a) (S.factor i j))
        (trans (Alg.ring.mulA a S.r (E.entry i j)) (ap (\ b -> Alg.ring.mul b (E.entry i j)) target))) ;
     contraction : Id Alg.ring.R (E.M.dot S.y xs) (Pow.power f (plus k.1 N)) =
      trans (A.SA.lin-scale E.n S.y S.x a) (trans (ap (Alg.ring.mul a) S.contraction) target) ;
     certificate : E.M.LocalFactors E.entry f = (plus k.1 N,xs,S.y,factor,contraction) ;
    } ;
    result : E.M.FreeAfter E.entry f =
     Tr.Trunc[Eq.Witness].induction @l (\ z -> E.M.FreeAfter E.entry f)
      (\ z -> Tr.Trunc[E.M.LocalFactors E.entry f].proposition)
      (\ z -> Tr.Trunc[E.M.LocalFactors E.entry f].inc Killed[z].certificate) Eq.theorem ;
   } ;
   theorem : E.M.FreeAfter E.entry f =
    Tr.Trunc[D.AL.Rep g sl].induction @l (\ z -> E.M.FreeAfter E.entry f)
     (\ z -> Tr.Trunc[E.M.LocalFactors E.entry f].proposition)
     (\ v -> Tr.Trunc[D.AD.Rep g dl].induction @l (\ z -> E.M.FreeAfter E.entry f)
      (\ z -> Tr.Trunc[E.M.LocalFactors E.entry f].proposition)
      (\ e -> Reps[v,e].result) ((D.dual-restriction g).1 dl)) ((D.line-restriction g).1 sl) ;
  } ;
 } ;
} ;
