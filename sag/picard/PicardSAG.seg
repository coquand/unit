-- Proposition 4.6 after integrating worker B's proved algebra.
-- ChartTriviality is now the ONLY extra geometric hypothesis.
-- The minimal theorem uses Loc and uniform SQC; no Z-choice is used.
level l ; open Prelude[l] ;
module FromLocSQC (R : Ring[l].CRing) (setR : isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC)
 (loc : StandardOpens[l].Over[R,setR].Locality)
 (charts : PicardTwists[l].Over[R,setR].ChartTriviality) {
 module I = PicardInterface[l].Over[R,setR] ;
 algebra : I.AlgebraResults = new I.AlgebraResults[
  Factorisation[l].Over[R,setR,sqc,loc].factorisation,
  DegreeUnique[l].Over[R,setR,sqc,loc.1].degree-unique,
  ChartIntersection[l].Over[R,setR,sqc].intersection] ;
 module Proof = PicardTheorem[l].Over[R,setR,algebra,charts] ;
 proposition-4-6 : Proof.W.Proposition46 = Proof.proposition-4-6 ;
 equivalence : Equiv (Proof.W.L.Line * PicardInterface[l].Degree) (Proof.W.P.P1 -> Proof.W.L.Line) = Proof.equivalence ;
 inverse : (Proof.W.P.P1 -> Proof.W.L.Line) -> Proof.W.L.Line * PicardInterface[l].Degree = Proof.inverse ;
} ;
-- Exact integration point advertised by B, for the common SAG bundle.
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (charts : PicardTwists[l].Over[R,setR].ChartTriviality) {
 module Algebra = LaurentResults[l].Over[R,setR,sag] ;
 module Proof = PicardTheorem[l].Over[R,setR,Algebra.results,charts] ;
 proposition-4-6 : Proof.W.Proposition46 = Proof.proposition-4-6 ;
 equivalence : Equiv (Proof.W.L.Line * PicardInterface[l].Degree) (Proof.W.P.P1 -> Proof.W.L.Line) = Proof.equivalence ;
 inverse : (Proof.W.P.P1 -> Proof.W.L.Line) -> Proof.W.L.Line * PicardInterface[l].Degree = Proof.inverse ;
} ;
