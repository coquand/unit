-- Associated torsors from an arbitrary transition function. Constructed by
-- the checked cocycle-to-torsor operation on each fibre of the chart cover.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = Prelude[l+] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module I = PicardInterface[l].Over[R,setR] ;
 Rep (p : P.P1) : U l = (c : P.C) * Id P.P1 (P.point c) p ;
 covered (p : P.P1) : Tr.Trunc[Rep p].carrier =
  P.Q.induction @l (\ q -> Tr.Trunc[Rep q].carrier) (\ q -> Tr.Trunc[Rep q].proposition)
   (\ c -> Tr.Trunc[Rep (P.point c)].inc (c,refl (P.point c))) p ;
 relate (p : P.P1) (a b : Rep p) : P.relation a.1 b.1 =
  P.Q.effective a.1 b.1 (trans a.2 (sym b.2)) ;
 module Glue (t : I.LaurentUnit) {
  module CT = PicardTransitions[l].Over[R,setR].At[t] ;
  module At (p : P.P1) {
   module T = TorsorCocycles[l].Tors[G.group,Rep p,covered p] ;
   c (a b : Rep p) : G.Unit = CT.c a.1 b.1 (relate p a b) ;
   coc (a b d : Rep p) : Id G.Unit (G.times (c a b) (c b d)) (c a d) =
    trans (CT.coc a.1 b.1 d.1 (relate p a b) (relate p b d))
     (ap (CT.c a.1 d.1) (P.relation-prop a.1 d.1
      (P.relation-trans a.1 b.1 d.1 (relate p a b) (relate p b d)) (relate p a d))) ;
   module S = T.PsiM[(c,coc)] ;
   torsor : L.TI.Tor = (S.Tc,S.str) ;
   frame (a : Rep p) : S.Tc = S.uc a ;
   frame-change (a b : Rep p) : Id S.Tc (S.actc (c a b) (frame b)) (frame a) =
    S.tc-eq (S.actc (c a b) (frame b)) (frame a) (\ d -> coc a b d) ;
  } ;
  raw (p : P.P1) : L.TI.Tor = At[p].torsor ;
  bundle (p : P.P1) : L.Line = L.pack (raw p) ;
  chart-frame (c : P.C) : (raw (P.point c)).1 = At[P.point c].frame (c,refl (P.point c)) ;
  chart-trivial (c : P.C) : Id L.Line (bundle (P.point c)) L.trivial = L.trivialise (raw (P.point c)) (chart-frame c) ;
  frame-transport (c : P.C) : (p : P.P1) (q : Id P.P1 (P.point c) p) ->
   Id (raw p).1 (Pr.subst P.P1 (\ z -> (raw z).1) (P.point c) p q (chart-frame c)) (At[p].frame (c,q)) =
   \ p q -> idJ P.P1 (P.point c)
    (\ p' q' -> Id (raw p').1 (Pr.subst P.P1 (\ z -> (raw z).1) (P.point c) p' q' (chart-frame c)) (At[p'].frame (c,q')))
    (refl (chart-frame c)) p q ;
  comparison-unit (x : G.Unit) : G.Unit =
   PicardTransitions[l].Over[R,setR].ru x.2.1 x.1
    (relate (P.affine x.1) (hi x.2.1,sym (P.overlap x.1 x.2.1 x.2.2)) (lo x.1,refl (P.affine x.1))) ;
  -- This records the sign convention on actual transported frames.
  transition (x : G.Unit) :
   Id (raw (P.affine x.1)).1
    (Pr.subst P.P1 (\ z -> (raw z).1) (P.infinity-chart x.2.1) (P.affine x.1)
     (sym (P.overlap x.1 x.2.1 x.2.2)) (chart-frame (hi x.2.1)))
    ((raw (P.affine x.1)).2.1 (t x) (chart-frame (lo x.1))) =
   trans (frame-transport (hi x.2.1) (P.affine x.1) (sym (P.overlap x.1 x.2.1 x.2.2)))
    (trans (sym (At[P.affine x.1].frame-change
      (hi x.2.1,sym (P.overlap x.1 x.2.1 x.2.2)) (lo x.1,refl (P.affine x.1))))
     (Pr.ap G.Unit (raw (P.affine x.1)).1 (\ a -> (raw (P.affine x.1)).2.1 a (chart-frame (lo x.1))) (t (comparison-unit x)) (t x)
      (Pr.ap G.Unit G.Unit t (comparison-unit x) x (G.eq (comparison-unit x) x (refl x.1))))) ;
 } ;
 O (d : PicardInterface[l].Degree) : P.P1 -> L.Line = Glue[I.monomial d].bundle ;
 lo-trivial (d : PicardInterface[l].Degree) (x : R.R) : Id L.Line (O d (P.affine x)) L.trivial =
  Glue[I.monomial d].chart-trivial (lo x) ;
 hi-trivial (d : PicardInterface[l].Degree) (y : R.R) : Id L.Line (O d (P.infinity-chart y)) L.trivial =
  Glue[I.monomial d].chart-trivial (hi y) ;
 -- This is the ONE geometric hypothesis left for the second phase.
 ChartTriviality : U l = (B : P.P1 -> L.Line) ->
  Tr.Trunc[(x : R.R) -> Id L.Line (B (P.affine x)) L.trivial].carrier *
  Tr.Trunc[(y : R.R) -> Id L.Line (B (P.infinity-chart y)) L.trivial].carrier ;
 classify (a : L.Line) (d : PicardInterface[l].Degree) : P.P1 -> L.Line = \ p -> L.tensor a (O d p) ;
 Proposition46 : U l = Pr.isEquiv (L.Line * PicardInterface[l].Degree) (P.P1 -> L.Line) (\ z -> classify z.1 z.2) ;
} ;
