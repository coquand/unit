-- The two-chart gauge equation is exactly the condition for a global
-- equivariant map. Both directions are proved; no higher descent axiom.
level l ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module H = Prelude[l+] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module TM = TorsorMaps[l].Over[G.group] ;
 module TB = Torsor[l].TorBase[G.group] ;
 module F (T : P.P1 -> L.TI.Tor)
  (loF : (x : R.R) -> (T (P.affine x)).1)
  (hiF : (y : R.R) -> (T (P.infinity-chart y)).1) {
  module M = TM.Family[P.P1,T] ;
  path (x : G.Unit) : Id P.P1 (P.infinity-chart x.2.1) (P.affine x.1) = symH (P.overlap x.1 x.2.1 x.2.2) ;
  transition (x : G.Unit) : G.Unit =
   TB.D[(T (P.affine x.1)).1,(T (P.affine x.1)).2].diff (loF x.1)
    (M.move (P.infinity-chart x.2.1) (P.affine x.1) (path x) (hiF x.2.1)) ;
  law (x : G.Unit) : Id (T (P.affine x.1)).1
   (M.move (P.infinity-chart x.2.1) (P.affine x.1) (path x) (hiF x.2.1))
   ((T (P.affine x.1)).2.1 (transition x) (loF x.1)) =
   symH (TB.D[(T (P.affine x.1)).1,(T (P.affine x.1)).2].dact (loF x.1)
    (M.move (P.infinity-chart x.2.1) (P.affine x.1) (path x) (hiF x.2.1))) ;
 } ;
 module Compare (T S : P.P1 -> L.TI.Tor)
  (loT : (x : R.R) -> (T (P.affine x)).1) (hiT : (y : R.R) -> (T (P.infinity-chart y)).1)
  (loS : (x : R.R) -> (S (P.affine x)).1) (hiS : (y : R.R) -> (S (P.infinity-chart y)).1)
  (ct cs : G.Unit -> G.Unit)
  (ht : (x : G.Unit) -> Id (T (P.affine x.1)).1
   (TM.Family[P.P1,T].move (P.infinity-chart x.2.1) (P.affine x.1) (symH (P.overlap x.1 x.2.1 x.2.2)) (hiT x.2.1))
   ((T (P.affine x.1)).2.1 (ct x) (loT x.1)))
  (hs : (x : G.Unit) -> Id (S (P.affine x.1)).1
   (TM.Family[P.P1,S].move (P.infinity-chart x.2.1) (P.affine x.1) (symH (P.overlap x.1 x.2.1 x.2.2)) (hiS x.2.1))
   ((S (P.affine x.1)).2.1 (cs x) (loS x.1))) {
  module M = TM.Families[P.P1,T,S] ;
  path (x : G.Unit) : Id P.P1 (P.infinity-chart x.2.1) (P.affine x.1) = symH (P.overlap x.1 x.2.1 x.2.2) ;
  module Build (a b : R.R -> G.Unit)
   (eq : (x : G.Unit) -> Id G.Unit (G.times (ct x) (a x.1)) (G.times (b x.2.1) (cs x))) {
   module Lo (x : R.R) { module B = TM.Based[T (P.affine x),S (P.affine x),loT x,(S (P.affine x)).2.1 (a x) (loS x)] ; } ;
   module Hi (y : R.R) { module B = TM.Based[T (P.infinity-chart y),S (P.infinity-chart y),hiT y,(S (P.infinity-chart y)).2.1 (b y) (hiS y)] ; } ;
   module Crossing (x : G.Unit) {
    module A = M.Across[P.infinity-chart x.2.1,P.affine x.1,path x,hiT x.2.1,loT x.1,hiS x.2.1,loS x.1,
     ct x,cs x,a x.1,b x.2.1,ht x,hs x,Hi[x.2.1].B.map,Lo[x.1].B.map,Hi[x.2.1].B.beta,Lo[x.1].B.beta] ;
   } ;
   module D = PicardSetDescent[l].Over[R,setR].Family[M.Hom,\ p -> L.TI.hom-set (T p) (S p)].Sections[
    \ x -> Lo[x].B.map,\ y -> Hi[y].B.map,\ x -> Crossing[x].A.compatible (eq x)] ;
   map (p : P.P1) : L.TI.Hom (T p) (S p) = D.section p ;
   equality : Id (P.P1 -> L.Line) (\ p -> L.pack (T p)) (\ p -> L.pack (S p)) =
    FL.funext P.P1 (\ p -> L.Line) _ _ (\ p -> H.ap L.TI.Tor L.Line L.pack (T p) (S p) (L.TI.decode (T p) (S p) (map p))) ;
  } ;
  module Extract (f : (p : P.P1) -> L.TI.Hom (T p) (S p)) {
   a (x : R.R) : G.Unit = TB.D[(S (P.affine x)).1,(S (P.affine x)).2].diff (loS x) ((f (P.affine x)).1 (loT x)) ;
   b (y : R.R) : G.Unit = TB.D[(S (P.infinity-chart y)).1,(S (P.infinity-chart y)).2].diff (hiS y) ((f (P.infinity-chart y)).1 (hiT y)) ;
   ha (x : R.R) : Id (S (P.affine x)).1 ((f (P.affine x)).1 (loT x)) ((S (P.affine x)).2.1 (a x) (loS x)) =
    symH (TB.D[(S (P.affine x)).1,(S (P.affine x)).2].dact (loS x) ((f (P.affine x)).1 (loT x))) ;
   hb (y : R.R) : Id (S (P.infinity-chart y)).1 ((f (P.infinity-chart y)).1 (hiT y)) ((S (P.infinity-chart y)).2.1 (b y) (hiS y)) =
    symH (TB.D[(S (P.infinity-chart y)).1,(S (P.infinity-chart y)).2].dact (hiS y) ((f (P.infinity-chart y)).1 (hiT y))) ;
   module Crossing (x : G.Unit) {
    module A = M.Across[P.infinity-chart x.2.1,P.affine x.1,path x,hiT x.2.1,loT x.1,hiS x.2.1,loS x.1,
     ct x,cs x,a x.1,b x.2.1,ht x,hs x,f (P.infinity-chart x.2.1),f (P.affine x.1),hb x.2.1,ha x.1] ;
    equation : Id G.Unit (G.times (ct x) (a x.1)) (G.times (b x.2.1) (cs x)) =
     TM.act-injective (S (P.affine x.1)) (loS x.1) (G.times (ct x) (a x.1)) (G.times (b x.2.1) (cs x))
      (transH (symH A.right)
       (transH (ap (M.Hom (P.affine x.1)) (S (P.affine x.1)).1
        (\ h -> h.1 (M.MT.move (P.infinity-chart x.2.1) (P.affine x.1) (path x) (hiT x.2.1)))
        (f (P.affine x.1)) (M.move (P.infinity-chart x.2.1) (P.affine x.1) (path x) (f (P.infinity-chart x.2.1)))
        (symH (M.section-natural f (P.infinity-chart x.2.1) (P.affine x.1) (path x)))) A.left)) ;
   } ;
   equation (x : G.Unit) : Id G.Unit (G.times (ct x) (a x.1)) (G.times (cs x) (b x.2.1)) =
    transH Crossing[x].equation (G.comm (b x.2.1) (cs x)) ;
  } ;
 } ;
} ;
