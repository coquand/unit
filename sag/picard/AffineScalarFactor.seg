-- Any global line/dual pair factors the projector up to its pairing.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (T : C.Spec Alg -> AS.TI.Tor) {
  module A = AffineLineProjector[l].Over[R,setR,axioms].At[Alg,fp,T] ;
  module From (w : A.D.Data) (s : A.D.Sections) (d : A.D.DualSections) {
   module E = A.From[w] ;
   r : Alg.ring.R = A.back (A.D.pair d s) ;
   x (i : Fin E.n) : Alg.ring.R = E.coordinates s i ;
   y (i : Fin E.n) : Alg.ring.R = A.back (A.D.pair d (E.ss i)) ;
   rb (p : A.X) : Id R.R (p.1.1 r) (A.D.pair d s p) = A.back-beta (A.D.pair d s) p ;
   yb (i : Fin E.n) (p : A.X) : Id R.R (p.1.1 (y i)) (A.D.pair d (E.ss i) p) = A.back-beta (A.D.pair d (E.ss i)) p ;
   factor (i j : Fin E.n) : Id Alg.ring.R (Alg.ring.mul (x i) (y j)) (Alg.ring.mul r (E.entry i j)) =
    A.ext _ _ (\ p -> trans (p.1.2.2.2 (x i) (y j))
     (trans (cong2 R.R R.mul _ _ _ _ (E.coord-beta s i p) (yb j p))
      (trans (A.D.Fiber[p].Pair.exchange (E.ds i p) (d p) (s p) (E.ss j p))
       (trans (R.mulC (A.D.pair (E.ds i) (E.ss j) p) (A.D.pair d s p))
        (trans (sym (cong2 R.R R.mul _ _ _ _ (rb p) (E.beta i j p)))
         (sym (p.1.2.2.2 r (E.entry i j)))))))) ;
   contraction : Id Alg.ring.R (E.M.dot y x) r =
    A.ext _ _ (\ p -> trans (StandardOpens[l].SumMap[Alg.ring,R,p.1].combination E.n y x)
     (trans (RS.sum-cong E.n
      (\ i -> R.mul (p.1.1 (y i)) (p.1.1 (x i)))
      (\ i -> R.mul (p.1.1 r) (p.1.1 (E.entry i i)))
      (\ i -> trans (R.mulC (p.1.1 (y i)) (p.1.1 (x i)))
       (trans (sym (p.1.2.2.2 (x i) (y i)))
        (trans (ap p.1.1 (factor i i)) (p.1.2.2.2 r (E.entry i i))))))
      (trans (RS.sum-scale (p.1.1 r) E.n (\ i -> p.1.1 (E.entry i i)))
       (trans (ap (R.mul (p.1.1 r))
        (trans (sym (StandardOpens[l].SumMap[Alg.ring,R,p.1].natural E.n (\ i -> E.entry i i)))
         (trans (ap p.1.1 E.trace) p.1.2.1))) (R.mulO (p.1.1 r)))))) ;
   certificate : E.M.ScalarFactor E.entry r = (x,y,factor,contraction) ;
  } ;
 } ;
} ;
