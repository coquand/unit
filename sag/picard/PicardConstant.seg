-- Constancy on the same two-chart quotient, now over the common ring.
-- The sole algebra input is B's checked ChartIntersection interface.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (intersection : PicardInterface[l].Over[R,setR].ChartIntersection) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 origin : P.P1 = P.affine R.z ;
 module At (f : P.P1 -> R.R) {
  first (x : R.R) : R.R = f (P.affine x) ;
  second (y : R.R) : R.R = f (P.infinity-chart y) ;
  agree (x : G.Unit) : Id R.R (first x.1) (second x.2.1) = ap f (P.overlap x.1 x.2.1 x.2.2) ;
  charts : (c : P.C) -> Id R.R (f (P.point c)) (f origin) = split {
   lo x -> (intersection first second agree).1 x ;
   hi y -> (intersection first second agree).2 y } ;
  constant (p : P.P1) : Id R.R (f p) (f origin) =
   P.Q.induction @l (\ q -> Id R.R (f q) (f origin)) (\ q -> setR (f q) (f origin)) charts p ;
 } ;
 constant (f : P.P1 -> R.R) (p : P.P1) : Id R.R (f p) (f origin) = At[f].constant p ;
 unit-constant (f : P.P1 -> G.Unit) (p : P.P1) : Id G.Unit (f p) (f origin) =
  G.eq (f p) (f origin) (constant (\ q -> (f q).1) p) ;
 unit-functions : Pr.Equiv G.Unit (P.P1 -> G.Unit) =
  (\ a q -> a,Pr.qinv G.Unit (P.P1 -> G.Unit) (\ a q -> a) (\ f -> f origin)
   (\ f -> FL.funext P.P1 (\ q -> G.Unit) (\ q -> f origin) f (\ q -> sym (unit-constant f q)))
   (\ a -> refl a)) ;
} ;
