-- Distinct degrees give nonisomorphic twists. Pure coefficient work is
-- supplied by B as DegreeUnique; the passage from a bundle path to the
-- two polynomial gauges is proved here.
level l ; open Prelude[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (unique : PicardInterface[l].Over[R,setR].DegreeUnique) {
 module P = Projective[l].Line[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module I = PicardInterface[l].Over[R,setR] ;
 module At (d e : PicardInterface[l].Degree) (p : Id (P.P1 -> L.Line) (W.O d) (W.O e)) {
  module S = W.Glue[I.monomial d] ; module T = W.Glue[I.monomial e] ;
  f (x : P.P1) : L.TI.Hom (S.raw x) (T.raw x) =
   L.raw-hom (S.raw x) (T.raw x) (happly P.P1 (\ x -> L.Line) (W.O d) (W.O e) p x) ;
  module C = PicardGauge[l].Over[R,setR].Compare[S.raw,T.raw,
   \ x -> S.chart-frame (lo x),\ y -> S.chart-frame (hi y),
   \ x -> T.chart-frame (lo x),\ y -> T.chart-frame (hi y),
   I.monomial d,I.monomial e,S.transition,T.transition] ;
  module E = C.Extract[f] ;
  degree-equal : Id PicardInterface[l].Degree d e = unique d e E.a E.b E.equation ;
 } ;
 separate (d e : PicardInterface[l].Degree) (p : Id (P.P1 -> L.Line) (W.O d) (W.O e)) : Id PicardInterface[l].Degree d e =
  At[d,e,p].degree-equal ;
} ;
