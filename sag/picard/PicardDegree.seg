-- Setness of the signed degrees; no arithmetic or extra axiom.
level l ; open Ring[l] ; open PicardInterface[l] ;
module Pr = Prelude[l] ;
 top-prop : Pr.isProp Top = split { tt -> split { tt -> refl tt } } ;
 empty-prop : Pr.isProp Empty = \ e f -> efq e ;
 code : Nat -> Nat -> U l = split {
  zero -> split { zero -> Top ; suc n -> Empty } ;
  suc m | r -> split { zero -> Empty ; suc n -> r n } } ;
 code-prop : (m n : Nat) -> Pr.isProp (code m n) = split {
  zero -> split { zero -> top-prop ; suc n -> empty-prop } ;
  suc m | r -> split { zero -> empty-prop ; suc n -> r n } } ;
 code-refl : (m : Nat) -> code m m = split { zero -> tt ; suc m | r -> r } ;
 code-eq : (m n : Nat) -> code m n -> Id Nat m n = split {
  zero -> split { zero -> \ h -> refl zero ; suc n -> \ h -> efq h } ;
  suc m | r -> split { zero -> \ h -> efq h ; suc n -> \ h -> ap (\ k -> suc k) (r n h) } } ;
 nat-set : Pr.isSet Nat = \ m -> Pr.Hedberg[Nat,m,code m,code-prop m,code-refl m,code-eq m].hedberg ;
 dcode : Degree -> Degree -> U l = split {
  nonneg n -> split { nonneg m -> Id Nat n m ; negative m -> Empty } ;
  negative n -> split { nonneg m -> Empty ; negative m -> Id Nat n m } } ;
 dcode-prop : (d e : Degree) -> Pr.isProp (dcode d e) = split {
  nonneg n -> split { nonneg m -> nat-set n m ; negative m -> empty-prop } ;
  negative n -> split { nonneg m -> empty-prop ; negative m -> nat-set n m } } ;
 dcode-refl : (d : Degree) -> dcode d d = split { nonneg n -> refl n ; negative n -> refl n } ;
 dcode-eq : (d e : Degree) -> dcode d e -> Id Degree d e = split {
  nonneg n -> split { nonneg m -> \ h -> ap (\ k -> nonneg k) h ; negative m -> \ h -> efq h } ;
  negative n -> split { nonneg m -> \ h -> efq h ; negative m -> \ h -> ap (\ k -> negative k) h } } ;
 degree-set : Pr.isSet Degree = \ d -> Pr.Hedberg[Degree,d,dcode d,dcode-prop d,dcode-refl d,dcode-eq d].hedberg ;
