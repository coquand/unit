-- A vector with a normalised linear functional determines a unique torsor
-- frame. Mere inhabitation is eliminated only into the proposition Fib.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 open R ; open RL[R] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module At (T : AS.TI.Tor) {
  module P = LinePairing[l].Over[R,setR].At[T] ;
  module L = P.L ;
  module D = P.Diff ;
  frame (t : T.1) : L.Carrier = P.Based[t].frame ;
  act-value (a : G.Unit) (t : T.1) : Id R.R ((frame (T.2.1 a t)).1 t) a.1 =
   trans (ap (\ v -> v.1 t) P.FrameAction[a,t].theorem)
    (trans (ap (mul a.1) (L.Based[t].beta o)) (mulO a.1)) ;
  injective (t s : T.1) (h : Id L.Carrier (frame t) (frame s)) : Id T.1 t s =
   trans (sym (T.2.2.2.2.1 t))
    (trans (ap (\ a -> T.2.1 a t)
     (sym (G.eq (D.diff t s) G.one
      (trans (sym (act-value (D.diff t s) t))
       (trans (ap (\ u -> (frame u).1 t) (D.dact t s))
        (trans (ap (\ v -> v.1 t) (sym h)) (L.Based[t].beta o)))))))
     (D.dact t s)) ;
  module Recover (v : L.Carrier) (phi : L.Carrier -> R.R)
   (scalar : (a : R.R) (w : L.Carrier) -> Id R.R (phi (L.scale a w)) (mul a (phi w)))
   (normalised : Id R.R (phi v) o) {
   Fib : U l = (t : T.1) * Id L.Carrier (frame t) v ;
   prop : Pr.isProp Fib = \ a b ->
    Pr.Sigma-eq T.1 (\ t -> Id L.Carrier (frame t) v) a.1 b.1 a.2 b.2
     (injective a.1 b.1 (trans a.2 (sym b.2))) (L.set _ _) ;
   module Based (t : T.1) {
    module Ev = L.Based[t] ;
    reconstruct : Id L.Carrier (L.scale (v.1 t) (frame t)) v =
     trans (sym (Ev.eta (L.scale (v.1 t) (frame t))))
      (trans (ap Ev.extend (trans (ap (mul (v.1 t)) (Ev.beta o)) (mulO (v.1 t)))) (Ev.eta v)) ;
    u : G.Unit =
     (v.1 t,phi (frame t),trans (sym (scalar (v.1 t) (frame t)))
      (trans (ap phi reconstruct) normalised)) ;
    next : T.1 = T.2.1 u t ;
    equation : Id L.Carrier (frame next) v =
     trans (sym (Ev.eta (frame next))) (trans (ap Ev.extend (act-value u t)) (Ev.eta v)) ;
    witness : Fib = (next,equation) ;
   } ;
   witness : Fib = Tr.Trunc[T.1].induction @l (\ t -> Fib) (\ t -> prop)
    (\ t -> Based[t].witness) P.inhabited ;
   point : T.1 = witness.1 ;
   equation : Id L.Carrier (frame point) v = witness.2 ;
  } ;
 } ;
} ;
