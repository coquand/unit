-- Dependent descent of SETS on the two chart quotient. This is proved
-- from effective quotients and unique choice, not assumed for Line.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module Family (F : P.P1 -> U l) (setF : (p : P.P1) -> Pr.isSet (F p)) {
  move (x y : P.P1) (q : Id P.P1 x y) (u : F x) : F y = Pr.subst P.P1 F x y q u ;
  back (x y : P.P1) (q : Id P.P1 x y) (u : F y) : Id (F y) (move x y q (move y x (sym q) u)) u =
   idJ P.P1 x (\ y' q' -> (u' : F y') -> Id (F y') (move x y' q' (move y' x (sym q') u')) u') (\ u' -> refl u') y q u ;
  triangle (x y : P.P1) (u : F x) (v : F y) : (z : P.P1) (q : Id P.P1 y z) (p : Id P.P1 x z) ->
   Id (F y) (move x y (trans p (sym q)) u) v -> Id (F z) (move x z p u) (move y z q v) =
   \ z q -> idJ P.P1 y
    (\ z' q' -> (p : Id P.P1 x z') -> Id (F y) (move x y (trans p (sym q')) u) v -> Id (F z') (move x z' p u) (move y z' q' v))
    (\ p h -> h) z q ;
  module Sections (loS : (x : R.R) -> F (P.affine x)) (hiS : (y : R.R) -> F (P.infinity-chart y))
   (cross : (x : G.Unit) -> Id (F (P.affine x.1))
    (move (P.infinity-chart x.2.1) (P.affine x.1) (sym (P.overlap x.1 x.2.1 x.2.2)) (hiS x.2.1)) (loS x.1)) {
   local : (c : P.C) -> F (P.point c) = split { lo x -> loS x ; hi y -> hiS y } ;
   natural (chart : R.R -> P.P1) (s : (a : R.R) -> F (chart a)) (a : R.R) :
    (b : R.R) (e : Id R.R a b) -> Id (F (chart b)) (move (chart a) (chart b) (ap chart e) (s a)) (s b) =
    \ b e -> idJ R.R a (\ b' e' -> Id (F (chart b')) (move (chart a) (chart b') (ap chart e') (s a)) (s b')) (refl (s a)) b e ;
   natural-path (chart : R.R -> P.P1) (s : (a : R.R) -> F (chart a)) (a b : R.R) (q : Id P.P1 (chart a) (chart b))
    (e : Id R.R a b) : Id (F (chart b)) (move (chart a) (chart b) q (s a)) (s b) =
    trans (ap (\ r -> move (chart a) (chart b) r (s a)) (P.Q.set (chart a) (chart b) q (ap chart e))) (natural chart s a b e) ;
   compatible : (c d : P.C) (q : Id P.P1 (P.point c) (P.point d)) ->
    Id (F (P.point d)) (move (P.point c) (P.point d) q (local c)) (local d) = split {
    lo x -> split {
     lo y -> \ q -> natural-path P.affine loS x y q (P.Q.effective (lo x) (lo y) q) ;
     hi y -> \ q -> trans
      (ap (move (P.affine x) (P.infinity-chart y) q)
       (sym (trans
        (ap (\ r -> move (P.infinity-chart y) (P.affine x) r (hiS y))
         (P.Q.set (P.infinity-chart y) (P.affine x)
          (sym q) (sym (P.overlap x y (P.Q.effective (lo x) (hi y) q)))))
        (cross (x,y,P.Q.effective (lo x) (hi y) q)))))
      (back (P.affine x) (P.infinity-chart y) q (hiS y)) } ;
    hi y -> split {
     lo x -> \ q -> trans
      (ap (\ r -> move (P.infinity-chart y) (P.affine x) r (hiS y))
       (P.Q.set (P.infinity-chart y) (P.affine x) q
        (sym (P.overlap x y (trans (R.mulC x y) (P.Q.effective (hi y) (lo x) q))))))
      (cross (x,y,trans (R.mulC x y) (P.Q.effective (hi y) (lo x) q))) ;
     hi x -> \ q -> natural-path P.infinity-chart hiS y x q (P.Q.effective (hi y) (hi x) q) } } ;
   from-rep (p : P.P1) (a : W.Rep p) : F p = move (P.point a.1) p a.2 (local a.1) ;
   agree (p : P.P1) (a b : W.Rep p) : Id (F p) (from-rep p a) (from-rep p b) =
    triangle (P.point a.1) (P.point b.1) (local a.1) (local b.1) p b.2 a.2
     (compatible a.1 b.1 (trans a.2 (sym b.2))) ;
   module At (p : P.P1) {
    module S = SectionDescent[l].At[W.Rep p,F p,setF p,from-rep p,agree p].Inhabited[W.covered p] ;
   } ;
   section (p : P.P1) : F p = At[p].S.result.1 ;
   beta (c : P.C) : Id (F (P.point c)) (section (P.point c)) (local c) =
    At[P.point c].S.result.2 (c,refl (P.point c)) ;
  } ;
 } ;
} ;
