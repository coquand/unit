-- Corollary 2.3, now a theorem: a line bundle on P1 is merely trivial
-- on each of the two standard affine charts. Uses Loc, SQC and Z-choice.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 open R ; open RL[R] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module Coord = AffineLineCoordinate[l].Over[R,setR] ;
 module Raw = Poly[l].PolyR[R] ;
 module Reciprocal = ReciprocalMonic[l].Over[R,setR] ;
 module Transfer (Y : U l) (T : Y -> AS.TI.Tor) (c0 c1 : R.R -> Y)
  (cross : (x y : R.R) -> Id R.R (mul x y) o -> Id Y (c0 y) (c1 x)) {
  Frames : U l = (x : R.R) -> (T (c1 x)).1 ;
  Goal : U l = Tr.Trunc[Frames].carrier ;
  module Near = LineFrameNearZero[l].Over[R,setR,axioms].For[\ x -> T (c0 x)] ;
  module Polynomial (a : R.R) (p : List R.R)
   (u : unit (Raw.ev (cons a p) z))
   (frame : (y : R.R) -> unit (Raw.ev (cons a p) y) -> (T (c0 y)).1) {
   au : unit a = Pr.subst R.R unit _ _
    (trans (ap (add a) (zero-mul (Raw.ev p z))) (addZ a)) u ;
   module M = Reciprocal.From[a,au,p] ;
   module Local (x : R.R) (v : unit (M.value x)) {
    module Op = M.OnOpen[x,v] ;
    point : (T (c1 x)).1 = Pr.subst Y (\ y -> (T y).1) (c0 Op.inverse) (c1 x)
     (cross x Op.inverse Op.xu.2) (frame Op.inverse Op.original-unit) ;
   } ;
   module Monic = Coord.Monic[axioms,\ x -> T (c1 x),M.lower,\ x v -> Local[x,v].point] ;
   result : Goal = Monic.theorem ;
  } ;
  from-polynomial : (p : List R.R) -> unit (Raw.ev p z) ->
   ((y : R.R) -> unit (Raw.ev p y) -> (T (c0 y)).1) -> Goal = split {
    nil -> \ u frame -> efq (axioms.loc.1 (trans (sym u.2) (zero-mul u.1))) ;
    cons a p -> \ u frame -> Polynomial[a,p,u,frame].result } ;
  theorem : Goal = Tr.Trunc[Near.Witness].induction @l (\ w -> Goal)
   (\ w -> Tr.Trunc[Frames].proposition) (\ w -> from-polynomial w.1 w.2.1 w.2.2) Near.theorem ;
 } ;
 module P = Projective[l].Line[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module Bundle (B : P.P1 -> L.Line) {
  T (p : P.P1) : AS.TI.Tor = L.torsor (B p) ;
  module Hi = Transfer[P.P1,T,P.affine,P.infinity-chart,
   \ x y h -> P.overlap y x (trans (mulC y x) h)] ;
  module Lo = Transfer[P.P1,T,P.infinity-chart,P.affine,
   \ x y h -> sym (P.overlap x y h)] ;
  module On (c : R.R -> P.P1) {
   Frames : U l = (x : R.R) -> (T (c x)).1 ;
   Triv : U l = (x : R.R) -> Id L.Line (B (c x)) L.trivial ;
   map (v : Frames) : Triv = \ x ->
    trans (sym (L.pack-unpack (B (c x)))) (L.trivialise (T (c x)) (v x)) ;
   based (v : Triv) : (x : R.R) -> Id L.Line (B (c x)) (B (c z)) =
    \ x -> trans (v x) (sym (v z)) ;
   based-merely : Tr.Trunc[Triv].carrier ->
    Tr.Trunc[(x : R.R) -> Id L.Line (B (c x)) (B (c z))].carrier =
    Tr.Trunc[Triv].induction @l
     (\ v -> Tr.Trunc[(x : R.R) -> Id L.Line (B (c x)) (B (c z))].carrier)
     (\ v -> Tr.Trunc[(x : R.R) -> Id L.Line (B (c x)) (B (c z))].proposition)
     (\ v -> Tr.Trunc[(x : R.R) -> Id L.Line (B (c x)) (B (c z))].inc (based v)) ;
   merely : Tr.Trunc[Frames].carrier -> Tr.Trunc[Triv].carrier =
    Tr.Trunc[Frames].induction @l (\ v -> Tr.Trunc[Triv].carrier)
     (\ v -> Tr.Trunc[Triv].proposition) (\ v -> Tr.Trunc[Triv].inc (map v)) ;
  } ;
  lo : Tr.Trunc[(x : R.R) -> Id L.Line (B (P.affine x)) L.trivial].carrier = On[P.affine].merely Lo.theorem ;
  hi : Tr.Trunc[(x : R.R) -> Id L.Line (B (P.infinity-chart x)) L.trivial].carrier = On[P.infinity-chart].merely Hi.theorem ;
 } ;
 -- The paper phrases the conclusion as constancy at each chart's origin.
 paper-corollary-2-3 (B : P.P1 -> L.Line) :
  Tr.Trunc[(x : R.R) -> Id L.Line (B (P.affine x)) (B (P.affine z))].carrier *
  Tr.Trunc[(x : R.R) -> Id L.Line (B (P.infinity-chart x)) (B (P.infinity-chart z))].carrier =
  (Bundle[B].On[P.affine].based-merely Bundle[B].lo,
   Bundle[B].On[P.infinity-chart].based-merely Bundle[B].hi) ;
 corollary-2-3 : W.ChartTriviality = \ B -> (Bundle[B].lo,Bundle[B].hi) ;
} ;
