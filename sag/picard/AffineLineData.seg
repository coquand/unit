-- On an affine, a line and its dual merely have finite global sections
-- s_i,d_i with sum <d_i,s_i>=1. Z-choice, 7.1.8 and the standard-open
-- certificate theorem supply the data; no projective-module theorem is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 open R ; open RL[R] ;
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module Cov = AffineCovers[l].Over[R,setR,axioms.loc] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (T : C.Spec Alg -> AS.TI.Tor) {
  X : U l = C.Spec Alg ;
  module Fiber (x : X) {
   module L = AS.Line.At[T x] ;
   module D = AS.Dual.At[T x] ;
   module Pair = LinePairing[l].Over[R,setR].At[T x] ;
  } ;
  LM (x : X) : MD.Module = Fiber[x].L.associated ;
  DM (x : X) : MD.Module = Fiber[x].D.associated ;
  Sections : U l = (x : X) -> (LM x).M ;
  DualSections : U l = (x : X) -> (DM x).M ;
  pair (d : DualSections) (s : Sections) (x : X) : R.R = Fiber[x].Pair.pair (d x) (s x) ;
  Data : U l = (n : Nat) * (ss : Fin n -> Sections) * (ds : Fin n -> DualSections) *
   ((x : X) -> Id R.R (RS.sum n (\ i -> pair (ds i) (ss i) x)) o) ;
  Goal : U l = Tr.Trunc[Data].carrier ;
  affine : FunctionAlgebra[l].Over[R,setR].Affine X =
   Tr1.Trunc[FunctionAlgebra[l].Over[R,setR].AffineWitness X].inc (Alg,fp,Pr.idEquiv X) ;
  scheme : Schemes[l].Over[R,setR].Scheme X = SchemeBasics[l].Over[R,setR].affine X affine ;
  regular-qc : MD.WeaklyQC MD.regular = RegularQC[l].Over[R,setR,axioms].theorem ;
  line-qc (x : X) : MD.WeaklyQC (LM x) = Fiber[x].L.weakly-qc regular-qc ;
  dual-qc (x : X) : MD.WeaklyQC (DM x) = Fiber[x].D.weakly-qc regular-qc ;
  line-restriction : MD.Restriction X LM =
   Restriction718[l].Over[R,setR,axioms].At[X,scheme,LM,line-qc].theorem-7-1-8 ;
  dual-restriction : MD.Restriction X DM =
   Restriction718[l].Over[R,setR,axioms].At[X,scheme,DM,dual-qc].theorem-7-1-8 ;
  module AL = Affine[l].Aff[MD.ring,X,LM] ;
  module AD = Affine[l].Aff[MD.ring,X,DM] ;
  module Cover (c : Ax.ChoiceData Alg (\ x -> (T x).1)) {
   n : Nat = c.1 ;
   fs : Fin n -> Alg.ring.R = c.2.1 ;
   g (i : Fin n) (x : X) : R.R = x.1.1 (fs i) ;
   point (i : Fin n) (x : X) (u : unit (g i x)) : (T x).1 = c.2.2.2 i x u ;
   local-line (i : Fin n) (x : X) (u : unit (g i x)) : (LM x).M =
    Fiber[x].Pair.Based[point i x u].frame ;
   local-dual (i : Fin n) (x : X) (u : unit (g i x)) : (DM x).M =
    Fiber[x].Pair.Based[point i x u].dual-frame ;
   Reps (i : Fin n) : U l = AL.Rep (g i) (local-line i) * AD.Rep (g i) (local-dual i) ;
   represented (i : Fin n) : Tr.Trunc[Reps i].carrier =
    Tr.Trunc[AL.Rep (g i) (local-line i)].induction @l
     (\ v -> Tr.Trunc[Reps i].carrier) (\ v -> Tr.Trunc[Reps i].proposition)
     (\ a -> Tr.Trunc[AD.Rep (g i) (local-dual i)].induction @l
      (\ v -> Tr.Trunc[Reps i].carrier) (\ v -> Tr.Trunc[Reps i].proposition)
      (\ b -> Tr.Trunc[Reps i].inc (a,b)) ((dual-restriction (g i)).1 (local-dual i)))
     ((line-restriction (g i)).1 (local-line i)) ;
   module Numerators (rep : (i : Fin n) -> Reps i) {
    ss (i : Fin n) : Sections = (rep i).1.1 ;
    ds (i : Fin n) : DualSections = (rep i).2.1 ;
    gs (i : Fin n) : Alg.ring.R = (axioms.sqc Alg fp).sec (pair (ds i) (ss i)) ;
    beta (i : Fin n) (x : X) : Id R.R (x.1.1 (gs i)) (pair (ds i) (ss i) x) =
     Pr.happly X (\ x -> R.R) _ _ ((axioms.sqc Alg fp).sec-eq (pair (ds i) (ss i))) x ;
    module OnOpen (i : Fin n) (x : X) (u : unit (g i x)) {
     t : (T x).1 = point i x u ;
     sl : R.R = (ss i x).1 t ;
     sd : R.R = (ds i x).1 t ;
     il : R.R = MD.RA.pw u.1 (rep i).1.2.1 ;
     idual : R.R = MD.RA.pw u.1 (rep i).2.2.1 ;
     line-equation : Id R.R o (mul il sl) =
      trans (sym (Fiber[x].L.Based[t].beta o))
       (ap (\ v -> v.1 t) ((rep i).1.2.2 x u)) ;
     dual-equation : Id R.R o (mul idual sd) =
      trans (sym (Fiber[x].D.Based[t].beta o))
       (ap (\ v -> v.1 t) ((rep i).2.2.2 x u)) ;
     line-unit : unit sl = (il,trans (mulC sl il) (sym line-equation)) ;
     dual-unit : unit sd = (idual,trans (mulC sd idual) (sym dual-equation)) ;
     paired-unit : unit (pair (ds i) (ss i) x) =
      Pr.subst R.R unit (mul sd sl) (pair (ds i) (ss i) x)
       (sym (Fiber[x].Pair.beta (ds i x) (ss i x) t))
       (AffineRing[l].Laws[R,setR].unit-product sd sl dual-unit line-unit) ;
     generator-unit : unit (x.1.1 (gs i)) =
      Pr.subst R.R unit (pair (ds i) (ss i) x) (x.1.1 (gs i)) (sym (beta i x)) paired-unit ;
    } ;
    covers (x : X) : StandardOpens[l].Over[R,setR].Union Alg n gs x =
     Tr.Trunc[(i : Fin n) * unit (g i x)].induction @l
      (\ v -> StandardOpens[l].Over[R,setR].Union Alg n gs x)
      (\ v -> Tr.Trunc[(i : Fin n) * unit (x.1.1 (gs i))].proposition)
      (\ v -> Tr.Trunc[(i : Fin n) * unit (x.1.1 (gs i))].inc (v.1,OnOpen[v.1,x,v.2].generator-unit))
      (Cov.At[Alg,n,fs].cover c.2.2.1 x) ;
    module Normalise (w : Ax.UnimodularWitness Alg n gs) {
     duals (i : Fin n) (x : X) : (DM x).M = Fiber[x].D.scale (x.1.1 (w.1 i)) (ds i x) ;
     trace (x : X) : Id R.R (RS.sum n (\ i -> pair (duals i) (ss i) x)) o =
      trans (RS.sum-cong n (\ i -> pair (duals i) (ss i) x)
       (\ i -> mul (x.1.1 (gs i)) (x.1.1 (w.1 i)))
       (\ i -> trans (Fiber[x].Pair.scale-left (x.1.1 (w.1 i)) (ds i x) (ss i x))
        (trans (ap (mul (x.1.1 (w.1 i))) (sym (beta i x)))
         (mulC (x.1.1 (w.1 i)) (x.1.1 (gs i))))))
       (trans (sym (StandardOpens[l].SumMap[Alg.ring,R,x.1].combination n gs w.1))
        (trans (ap x.1.1 w.2) x.1.2.1)) ;
     result : Data = (n,ss,duals,trace) ;
    } ;
    result : Goal =
     Tr.Trunc[Ax.UnimodularWitness Alg n gs].induction @l
      (\ v -> Goal) (\ v -> Tr.Trunc[Data].proposition)
      (\ w -> Tr.Trunc[Data].inc Normalise[w].result)
      (Cov.At[Alg,n,gs].unimodular axioms.sqc fp covers) ;
   } ;
   result : Goal =
    Tr.Trunc[(i : Fin n) -> Reps i].induction @l
     (\ v -> Goal) (\ v -> Tr.Trunc[Data].proposition)
     (\ r -> Numerators[r].result) (AffineFinite[l].choice n Reps represented) ;
  } ;
  theorem : Goal =
   Tr.Trunc[Ax.ChoiceData Alg (\ x -> (T x).1)].induction @l
    (\ v -> Goal) (\ v -> Tr.Trunc[Data].proposition) (\ c -> Cover[c].result)
    (axioms.zchoice Alg fp (\ x -> (T x).1) (\ x -> (T x).2.2.2.2.2.2)) ;
 } ;
} ;
