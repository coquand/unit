-- If all G-valued functions on a pointed X are constant, inhabited
-- sections of any G-torsor family form a G-torsor, and evaluation is an
-- equivalence. Pure univalent mathematics, no SAG axiom.
level l ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open FunExtUA[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module Tr = Truncation[l] ;
module Over (Gr : Ab) (X : U l) (x0 : X)
 (constant : (f : X -> Gr.A) (x : X) -> Id Gr.A (f x) (f x0)) {
 open Gr ; module TI = TorsorId[l].TorId[Gr] ;
 module At (T : X -> TI.Tor) (inh : Tr.Trunc[(x : X) -> (T x).1].carrier) {
  S : U l = (x : X) -> (T x).1 ;
  act (a : A) (s : S) : S = \ x -> (T x).2.1 a (s x) ;
  setS : isSet S = FL.isSet-Pi X (\ x -> (T x).1) (\ x -> (T x).2.2.1) ;
  ad (a b : A) (s : S) : Id S (act (add a b) s) (act a (act b s)) =
   FL.funext X (\ x -> (T x).1) _ _ (\ x -> (T x).2.2.2.1 a b (s x)) ;
  ze (s : S) : Id S (act o s) s =
   FL.funext X (\ x -> (T x).1) _ _ (\ x -> (T x).2.2.2.2.1 (s x)) ;
  difference (s t : S) (x : X) : A = TorBase[Gr].D[(T x).1,(T x).2].diff (s x) (t x) ;
  shift (s t : S) : Id S (act (difference s t x0) s) t =
   FL.funext X (\ x -> (T x).1) _ _ (\ x ->
    transH (ap A (T x).1 (\ a -> (T x).2.1 a (s x)) (difference s t x0) (difference s t x)
     (symH (constant (difference s t) x))) (TorBase[Gr].D[(T x).1,(T x).2].dact (s x) (t x))) ;
  ft (s t : S) : isContr ((a : A) * Id S (act a s) t) =
   ((difference s t x0,shift s t),\ w -> Sigma-eq A (\ a -> Id S (act a s) t)
    (difference s t x0) w.1 (shift s t) w.2
    (TorBase[Gr].D[(T x0).1,(T x0).2].uniq (s x0) (t x0) w.1
     (happly X (\ x -> (T x).1) (act w.1 s) t w.2 x0)) (setS (act w.1 s) t)) ;
  sections : TI.Tor = (S,act,setS,ad,ze,ft,inh) ;
  evaluate : TI.Hom sections (T x0) = (\ s -> s x0,\ a s -> refl ((T x0).2.1 a (s x0))) ;
  equivalence : Equiv S (T x0).1 = TI.HE[sections,T x0,evaluate].equiv ;
 } ;
} ;
