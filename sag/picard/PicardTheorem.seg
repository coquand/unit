-- Proposition 4.6, conditional ONLY on the advertised algebra interface
-- and chart triviality. B is to derive AlgebraResults from SAG axioms;
-- chart triviality is reserved for the affine correspondence + Horrocks.
level l ; open Prelude[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (algebra : PicardInterface[l].Over[R,setR].AlgebraResults)
 (charts : PicardTwists[l].Over[R,setR].ChartTriviality) {
 module W = PicardTwists[l].Over[R,setR] ;
 module E = PicardExistence[l].Over[R,setR,algebra.factorisation,charts] ;
 module S = PicardSeparation[l].Over[R,setR,algebra.degree-unique] ;
 module C = PicardClassification[l].Over[R,setR,algebra.intersection].Proof[E.exists,S.separate] ;
 proposition-4-6 : W.Proposition46 = C.proposition-4-6 ;
 equivalence : Equiv (W.L.Line * PicardInterface[l].Degree) (W.P.P1 -> W.L.Line) =
  (\ z -> W.classify z.1 z.2,proposition-4-6) ;
 degree : (W.P.P1 -> W.L.Line) -> PicardInterface[l].Degree = C.degree ;
 inverse : (W.P.P1 -> W.L.Line) -> W.L.Line * PicardInterface[l].Degree = C.inverse ;
} ;
