-- Z-choice gives one polynomial standard neighbourhood of zero with a frame.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ; module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module Coord = AffineLineCoordinate[l].Over[R,setR] ; module RX = Coord.RX ;
 module AS = LineAssociated[l].Over[R,setR] ; module Raw = Poly[l].PolyR[R] ;
 module Cov = AffineCovers[l].Over[R,setR,axioms.loc] ;
 fp : Presentations[l].Over[R,setR].FP RX.algebra = MonicLineTriviality[l].Over[R,setR,axioms].fp ;
 module For (T : R.R -> AS.TI.Tor) {
  B (x : Coord.X) : U l = (T (Coord.coordinate x)).1 ;
  Witness : U l = (p : Raw.P) * RL[R].unit (Raw.ev p R.z) *
   ((a : R.R) -> RL[R].unit (Raw.ev p a) -> (T a).1) ;
  Goal : U l = Tr.Trunc[Witness].carrier ;
  module RawFrame (p : Raw.P) (near : RL[R].unit ((Coord.point R.z).1.1 (RX.X.include p)))
   (frame : (x : Coord.X) -> RL[R].unit (x.1.1 (RX.X.include p)) -> B x) {
   point (a : R.R) (u : RL[R].unit (Raw.ev p a)) : (T a).1 =
    Pr.subst R.R (\ b -> (T b).1) _ _ (Coord.beta a)
     (frame (Coord.point a) (Pr.subst R.R RL[R].unit _ _ (sym (Coord.At[a].evaluate p)) u)) ;
   witness : Witness = (p,Pr.subst R.R RL[R].unit _ _ (Coord.At[R.z].evaluate p) near,point) ;
  } ;
  HasFrame (f : RX.X.Carrier) : U l = RL[R].unit ((Coord.point R.z).1.1 f) *
   ((x : Coord.X) -> RL[R].unit (x.1.1 f) -> B x) ;
  from-polynomial : (f : RX.X.Carrier) -> HasFrame f -> Goal =
   RX.X.Q.induction @l (\ f -> HasFrame f -> Goal)
    (\ f -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (HasFrame f) (\ h -> Goal) (\ h -> Tr.Trunc[Witness].proposition))
    (\ p h -> Tr.Trunc[Witness].inc RawFrame[p,h.1,h.2].witness) ;
  module Cover (c : Ax.ChoiceData RX.algebra B) {
   module CC = Cov.At[RX.algebra,c.1,c.2.1] ;
   Choice : U l = (i : Fin c.1) * RL[R].unit ((Coord.point R.z).1.1 (c.2.1 i)) ;
   select (h : Choice) : Goal = from-polynomial (c.2.1 h.1) (h.2,c.2.2.2 h.1) ;
   result : Goal = Tr.Trunc[Choice].induction @l (\ i -> Goal)
    (\ i -> Tr.Trunc[Witness].proposition) select (CC.cover c.2.2.1 (Coord.point R.z)) ;
  } ;
  theorem : Goal = Tr.Trunc[Ax.ChoiceData RX.algebra B].induction @l (\ c -> Goal)
   (\ c -> Tr.Trunc[Witness].proposition) (\ c -> Cover[c].result)
   (axioms.zchoice RX.algebra fp B (\ x -> (T (Coord.coordinate x)).2.2.2.2.2.2)) ;
 } ;
} ;
