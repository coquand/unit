-- A small type of R^*-torsors, using the existing replacement construction.
-- No module tensor product and no new quotient or descent axiom.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module P1 = Prelude[l+] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) {
 module Units = PicardUnits[l].Over[R,setR] ;
 module TB = Torsor[l].TorBase[Units.group] ;
 module TI = TorsorId[l].TorId[Units.group] ;
 module K = TrivialGerbe[l].TrivG[Units.group] ;
 module TS = TorSum[l].TSum[Units.group] ;
 Line : U l = K.K ;
 trivial : Line = K.k0 ;
 torsor (a : Line) : TI.Tor = K.iota a ;
 pack (T : TI.Tor) : Line = (K.iota-fib T).1.1 ;
 unpack-pack (T : TI.Tor) : Id TI.Tor (torsor (pack T)) T = (K.iota-fib T).1.2 ;
 pack-unpack (a : Line) : Id Line (pack (torsor a)) a =
  P1.ap (K.KFib (torsor a)) Line (\ z -> z.1) (K.iota-fib (torsor a)).1 (a,refl (torsor a))
   ((K.iota-fib (torsor a)).2 (a,refl (torsor a))) ;
 Hom (a b : Line) : U l = TI.Hom (torsor a) (torsor b) ;
 encode (a b : Line) (p : Id Line a b) : Hom a b = TI.idtohom (torsor a) (torsor b) (P1.ap Line TI.Tor torsor a b p) ;
 decode (a b : Line) (f : Hom a b) : Id Line a b = (K.emb a b).sec (TI.decode (torsor a) (torsor b) f) ;
 ed (a b : Line) (f : Hom a b) : Id (Hom a b) (encode a b (decode a b f)) f =
  transH (P1.ap (Id TI.Tor (torsor a) (torsor b)) (Hom a b) (TI.idtohom (torsor a) (torsor b)) _ _
   ((K.emb a b).sec-eq (TI.decode (torsor a) (torsor b) f))) (K.idtohom-decode (torsor a) (torsor b) f) ;
 de (a b : Line) (p : Id Line a b) : Id (Id Line a b) (decode a b (encode a b p)) p =
  transH (P1.ap (Id TI.Tor (torsor a) (torsor b)) (Id Line a b) (K.emb a b).sec _ _
   (TI.dec-enc (torsor a) (torsor b) (P1.ap Line TI.Tor torsor a b p)))
   (P1.sec-ret (Id Line a b) (Id TI.Tor (torsor a) (torsor b)) (P1.ap Line TI.Tor torsor a b) (K.emb a b) p) ;
 identity : (a b : Line) -> Equiv (Id Line a b) (Hom a b) =
  \ a b -> (encode a b,qinv _ _ (encode a b) (decode a b) (ed a b) (de a b)) ;
 tensor (a b : Line) : Line = pack (TS.Sum (torsor a) (torsor b)) ;
 tensor-torsor (a b : Line) : Id TI.Tor (torsor (tensor a b)) (TS.Sum (torsor a) (torsor b)) =
  unpack-pack (TS.Sum (torsor a) (torsor b)) ;
 pack-trivial : Id Line (pack K.Atriv) trivial =
  transH (P1.sym Line _ _ (P1.ap TI.Tor Line pack (torsor trivial) K.Atriv (K.img.triangle tt)))
   (pack-unpack trivial) ;
 trivialise (T : TI.Tor) (t : T.1) : Id Line (pack T) trivial =
  transH (P1.ap TI.Tor Line pack T K.Atriv
   (P1.sym TI.Tor K.Atriv T (TI.decode K.Atriv T (K.pthom T t)))) pack-trivial ;
 -- The right unit for the contracted product, with its actual tensor.
 right-bilinear (T : TI.Tor) : TS.BiHom T K.Atriv T =
  (\ t a -> T.2.1 a t,
   \ b t a -> (TI.transl T a).2 b t,
   \ b t a -> T.2.2.2.1 b a t) ;
 sum-right (T : TI.Tor) : Id TI.Tor (TS.Sum T K.Atriv) T =
  P1.ap (TS.SumP T K.Atriv) TI.Tor (\ z -> z.1) (TS.sum-contr T K.Atriv).1 (T,right-bilinear T)
   ((TS.sum-contr T K.Atriv).2 (T,right-bilinear T)) ;
 tensor-right (a : Line) : Id Line (tensor a trivial) a =
  transH (P1.ap TI.Tor Line pack (TS.Sum (torsor a) (torsor trivial)) (torsor a)
   (P1.trans TI.Tor _ _ _
    (P1.ap TI.Tor TI.Tor (TS.Sum (torsor a)) (torsor trivial) K.Atriv (K.img.triangle tt))
    (sum-right (torsor a)))) (pack-unpack a) ;
 tensor-pointed (a b : Line) (p : Id Line b trivial) : Id Line (tensor a b) a =
  transH (ap Line Line (tensor a) b trivial p) (tensor-right a) ;
 left-bilinear (T : TI.Tor) : TS.BiHom K.Atriv T T =
  (\ a t -> T.2.1 a t,
   \ b a t -> T.2.2.2.1 b a t,
   \ b a t -> (TI.transl T a).2 b t) ;
 sum-left (T : TI.Tor) : Id TI.Tor (TS.Sum K.Atriv T) T =
  P1.ap (TS.SumP K.Atriv T) TI.Tor (\ z -> z.1) (TS.sum-contr K.Atriv T).1 (T,left-bilinear T)
   ((TS.sum-contr K.Atriv T).2 (T,left-bilinear T)) ;
 tensor-left (a : Line) : Id Line (tensor trivial a) a =
  transH (P1.ap TI.Tor Line pack (TS.Sum (torsor trivial) (torsor a)) (torsor a)
   (P1.trans TI.Tor _ _ _
    (P1.ap TI.Tor TI.Tor (\ T -> TS.Sum T (torsor a)) (torsor trivial) K.Atriv (K.img.triangle tt))
    (sum-left (torsor a)))) (pack-unpack a) ;
 raw-hom (T S : TI.Tor) (p : Id Line (pack T) (pack S)) : TI.Hom T S =
  TI.idtohom T S (P1.trans TI.Tor T (torsor (pack T)) S (P1.sym TI.Tor _ _ (unpack-pack T))
   (P1.trans TI.Tor _ _ _ (P1.ap Line TI.Tor torsor (pack T) (pack S) p) (unpack-pack S))) ;
 trivial-point : (torsor trivial).1 =
  P1.subst TI.Tor (\ T -> T.1) K.Atriv (torsor trivial) (P1.sym TI.Tor _ _ (K.img.triangle tt)) Units.one ;
 frame (a : Line) (p : Id Line a trivial) : (torsor a).1 =
  (encode trivial a (sym Line a trivial p)).1 trivial-point ;
} ;
