-- Evaluation of the associated dual against the associated line.
-- A product of opposite-weight functions is constant on a torsor.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 open R ; open RL[R] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module A = LineAssociated[l].Over[R,setR] ;
 module At (T : A.TI.Tor) {
  module L = A.Line.At[T] ;
  module D = A.Dual.At[T] ;
  module Diff = Torsor[l].TorBase[G.group].D[T.1,T.2] ;
  inhabited : Tr.Trunc[T.1].carrier = T.2.2.2.2.2.2 ;
  prove (a b : R.R) (h : T.1 -> Id R.R a b) : Id R.R a b =
   Tr.Trunc[T.1].induction @l (\ t -> Id R.R a b) (\ t -> setR a b) h inhabited ;
  module Constant (h : T.1 -> R.R)
   (same : (t s : T.1) -> Id R.R (h t) (h s)) {
   Value : U l = (r : R.R) * ((t : T.1) -> Id R.R (h t) r) ;
   prop : Pr.isProp Value = \ v w ->
    Pr.Sigma-eq R.R (\ r -> (t : T.1) -> Id R.R (h t) r)
     v.1 w.1 v.2 w.2 (prove v.1 w.1 (\ t -> trans (sym (v.2 t)) (w.2 t)))
     (F.isProp-Pi T.1 (\ t -> Id R.R (h t) w.1) (\ t -> setR _ _)) ;
   witness : Value =
    Tr.Trunc[T.1].induction @l (\ t -> Value) (\ t -> prop)
     (\ t -> (h t,\ s -> same s t)) inhabited ;
   value : R.R = witness.1 ;
   beta (t : T.1) : Id R.R value (h t) = sym (witness.2 t) ;
  } ;
  product (d : D.Carrier) (v : L.Carrier) (t : T.1) : R.R = mul (d.1 t) (v.1 t) ;
  invariant (d : D.Carrier) (v : L.Carrier) (a : G.Unit) (t : T.1) :
   Id R.R (product d v (T.2.1 a t)) (product d v t) =
   trans (Presentations[l].cong2 R.R mul _ _ _ _ (d.2 a t) (v.2 a t))
    (trans (G.four a.1 (d.1 t) a.2.1 (v.1 t))
     (trans (ap (\ r -> mul r (product d v t)) a.2.2)
      (trans (mulC o (product d v t)) (mulO (product d v t))))) ;
  same (d : D.Carrier) (v : L.Carrier) (t s : T.1) :
   Id R.R (product d v t) (product d v s) =
   trans (sym (invariant d v (Diff.diff t s) t))
    (ap (product d v) (Diff.dact t s)) ;
  pair (d : D.Carrier) (v : L.Carrier) : R.R =
   Constant[product d v,same d v].value ;
  beta (d : D.Carrier) (v : L.Carrier) (t : T.1) :
   Id R.R (pair d v) (mul (d.1 t) (v.1 t)) =
   Constant[product d v,same d v].beta t ;
  add-right (d : D.Carrier) (v w : L.Carrier) :
   Id R.R (pair d (L.addM v w)) (add (pair d v) (pair d w)) =
   prove _ _ (\ t -> trans (beta d (L.addM v w) t)
    (trans (dist (d.1 t) (v.1 t) (w.1 t))
     (sym (Presentations[l].cong2 R.R add _ _ _ _ (beta d v t) (beta d w t))))) ;
  scale-right (d : D.Carrier) (a : R.R) (v : L.Carrier) :
   Id R.R (pair d (L.scale a v)) (mul a (pair d v)) =
   prove _ _ (\ t -> trans (beta d (L.scale a v) t)
    (trans (mul-swap (d.1 t) a (v.1 t)) (ap (mul a) (sym (beta d v t))))) ;
  scale-left (a : R.R) (d : D.Carrier) (v : L.Carrier) :
   Id R.R (pair (D.scale a d) v) (mul a (pair d v)) =
   prove _ _ (\ t -> trans (beta (D.scale a d) v t)
    (trans (sym (mulA a (d.1 t) (v.1 t))) (ap (mul a) (sym (beta d v t))))) ;
  zero-right (d : D.Carrier) : Id R.R (pair d L.zero) z =
   prove _ _ (\ t -> trans (beta d L.zero t) (mul-zero (d.1 t))) ;
  -- The pointwise rank-one identity needed by the dual-basis construction.
  rank-one (d : D.Carrier) (v w : L.Carrier) :
   Id L.Carrier (L.scale (pair d v) w) (L.scale (pair d w) v) =
   L.equal _ _ (\ t ->
    trans (ap (\ r -> mul r (w.1 t)) (beta d v t))
     (trans (sym (mulA (d.1 t) (v.1 t) (w.1 t)))
      (trans (ap (mul (d.1 t)) (mulC (v.1 t) (w.1 t)))
       (trans (mulA (d.1 t) (w.1 t) (v.1 t))
        (ap (\ r -> mul r (v.1 t)) (sym (beta d w t))))))) ;
  exchange (d e : D.Carrier) (v w : L.Carrier) :
   Id R.R (mul (pair d v) (pair e w)) (mul (pair d w) (pair e v)) =
   trans (mulC (pair d v) (pair e w))
    (trans (sym (scale-right d (pair e w) v))
     (trans (ap (pair d) (rank-one e w v))
      (trans (scale-right d (pair e v) w) (mulC (pair e v) (pair d w))))) ;
  module Based (t : T.1) {
   frame : L.Carrier = L.Based[t].extend o ;
   dual-frame : D.Carrier = D.Based[t].extend o ;
   normalised : Id R.R (pair dual-frame frame) o =
    trans (beta dual-frame frame t)
     (trans (Presentations[l].cong2 R.R mul _ _ _ _
      (D.Based[t].beta o) (L.Based[t].beta o)) (mulO o)) ;
  } ;
  -- Inverse-weight functions give the original torsor's frame convention.
  module FrameAction (a : G.Unit) (t : T.1) {
   next : T.1 = T.2.1 a t ;
   module Ev = L.Based[next] ;
   scaled : L.Carrier = L.scale a.1 Based[t].frame ;
   scaled-at-next : Id R.R (scaled.1 next) o =
    trans (ap (mul a.1) (Based[t].frame.2 a t))
     (trans (ap (\ r -> mul a.1 (mul a.2.1 r)) (L.Based[t].beta o))
      (trans (ap (mul a.1) (mulO a.2.1)) a.2.2)) ;
   theorem : Id L.Carrier Based[next].frame scaled =
    trans (sym (Ev.eta Based[next].frame))
     (trans (ap Ev.extend (trans (Ev.beta o) (sym scaled-at-next)))
      (Ev.eta scaled)) ;
  } ;
 } ;
} ;
