-- Equivariant maps determined by a point, and transport in torsor families.
level l ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ;
module H = Prelude[l+] ;
module Over (Gr : Ab) {
 open Gr ; module TI = TorsorId[l].TorId[Gr] ; module TB = TorBase[Gr] ;
 module Based (T S : TI.Tor) (u : T.1) (v : S.1) {
  module D = TB.D[T.1,T.2] ;
  dshift (a : A) (t : T.1) : Id A (D.diff u (T.2.1 a t)) (add a (D.diff u t)) =
   D.uniq u (T.2.1 a t) (add a (D.diff u t))
    (transH (T.2.2.2.1 a (D.diff u t) u) (ap T.1 T.1 (T.2.1 a) (T.2.1 (D.diff u t) u) t (D.dact u t))) ;
  map : TI.Hom T S = (\ t -> S.2.1 (D.diff u t) v,
   \ a t -> transH (ap A S.1 (\ b -> S.2.1 b v) (D.diff u (T.2.1 a t)) (add a (D.diff u t)) (dshift a t))
    (S.2.2.2.1 a (D.diff u t) v)) ;
  beta : Id S.1 (map.1 u) v =
   transH (ap A S.1 (\ a -> S.2.1 a v) (D.diff u u) o (D.uniq u u o (T.2.2.2.2.1 u))) (S.2.2.2.2.1 v) ;
 } ;
 determined (T S : TI.Tor) (f g : TI.Hom T S) (u : T.1) (h : Id S.1 (f.1 u) (g.1 u)) : Id (TI.Hom T S) f g =
  TI.hom-eq T S f g (\ t ->
   transH (ap T.1 S.1 f.1 t (T.2.1 (TB.D[T.1,T.2].diff u t) u) (symH (TB.D[T.1,T.2].dact u t)))
    (transH (f.2 (TB.D[T.1,T.2].diff u t) u)
     (transH (ap S.1 S.1 (S.2.1 (TB.D[T.1,T.2].diff u t)) (f.1 u) (g.1 u) h)
      (transH (symH (g.2 (TB.D[T.1,T.2].diff u t) u))
       (ap T.1 S.1 g.1 (T.2.1 (TB.D[T.1,T.2].diff u t) u) t (TB.D[T.1,T.2].dact u t)))))) ;
 act-injective (T : TI.Tor) (u : T.1) (a b : A) (h : Id T.1 (T.2.1 a u) (T.2.1 b u)) : Id A a b =
  transH (symH (TB.D[T.1,T.2].uniq u (T.2.1 b u) a h))
   (TB.D[T.1,T.2].uniq u (T.2.1 b u) b (refl (T.2.1 b u))) ;
 module Family (X : U l) (T : X -> TI.Tor) {
  move (x y : X) (p : Id X x y) (t : (T x).1) : (T y).1 = subst X (\ z -> (T z).1) x y p t ;
  move-act (x : X) : (y : X) (p : Id X x y) (a : A) (t : (T x).1) ->
   Id (T y).1 (move x y p ((T x).2.1 a t)) ((T y).2.1 a (move x y p t)) =
   \ y p -> idJ X x (\ y' p' -> (a : A) (t : (T x).1) ->
    Id (T y').1 (move x y' p' ((T x).2.1 a t)) ((T y').2.1 a (move x y' p' t)))
    (\ a t -> refl ((T x).2.1 a t)) y p ;
 } ;
 module Families (X : U l) (T S : X -> TI.Tor) {
  module MT = Family[X,T] ; module MS = Family[X,S] ;
  Hom (x : X) : U l = TI.Hom (T x) (S x) ;
  move (x y : X) (p : Id X x y) (f : Hom x) : Hom y = subst X Hom x y p f ;
  move-apply (x : X) : (y : X) (p : Id X x y) (f : Hom x) (t : (T x).1) ->
   Id (S y).1 ((move x y p f).1 (MT.move x y p t)) (MS.move x y p (f.1 t)) =
   \ y p -> idJ X x (\ y' p' -> (f : Hom x) (t : (T x).1) ->
    Id (S y').1 ((move x y' p' f).1 (MT.move x y' p' t)) (MS.move x y' p' (f.1 t)))
    (\ f t -> refl (f.1 t)) y p ;
  natural (f : (x : X) -> Hom x) (x : X) : (y : X) (p : Id X x y) (t : (T x).1) ->
   Id (S y).1 ((f y).1 (MT.move x y p t)) (MS.move x y p ((f x).1 t)) =
   \ y p -> idJ X x (\ y' p' -> (t : (T x).1) ->
    Id (S y').1 ((f y').1 (MT.move x y' p' t)) (MS.move x y' p' ((f x).1 t)))
    (\ t -> refl ((f x).1 t)) y p ;
  section-natural (f : (x : X) -> Hom x) (x : X) : (y : X) (p : Id X x y) ->
   Id (Hom y) (move x y p (f x)) (f y) =
   \ y p -> idJ X x (\ y' p' -> Id (Hom y') (move x y' p' (f x)) (f y')) (refl (f x)) y p ;
  module Across (x y : X) (p : Id X x y)
   (ut : (T x).1) (vt : (T y).1) (us : (S x).1) (vs : (S y).1)
   (ct cs a b : A)
   (ht : Id (T y).1 (MT.move x y p ut) ((T y).2.1 ct vt))
   (hs : Id (S y).1 (MS.move x y p us) ((S y).2.1 cs vs))
   (f : Hom x) (g : Hom y)
   (hf : Id (S x).1 (f.1 ut) ((S x).2.1 b us))
   (hg : Id (S y).1 (g.1 vt) ((S y).2.1 a vs)) {
   left : Id (S y).1 ((move x y p f).1 (MT.move x y p ut)) ((S y).2.1 (add b cs) vs) =
    transH (move-apply x y p f ut)
     (transH (ap (S x).1 (S y).1 (MS.move x y p) (f.1 ut) ((S x).2.1 b us) hf)
      (transH (MS.move-act x y p b us)
       (transH (ap (S y).1 (S y).1 ((S y).2.1 b) (MS.move x y p us) ((S y).2.1 cs vs) hs)
        (symH ((S y).2.2.2.1 b cs vs))))) ;
   right : Id (S y).1 (g.1 (MT.move x y p ut)) ((S y).2.1 (add ct a) vs) =
    transH (ap (T y).1 (S y).1 g.1 (MT.move x y p ut) ((T y).2.1 ct vt) ht)
     (transH (g.2 ct vt)
      (transH (ap (S y).1 (S y).1 ((S y).2.1 ct) (g.1 vt) ((S y).2.1 a vs) hg)
       (symH ((S y).2.2.2.1 ct a vs)))) ;
   compatible (eq : Id A (add ct a) (add b cs)) : Id (Hom y) (move x y p f) g =
    determined (T y) (S y) (move x y p f) g (MT.move x y p ut)
     (transH left (transH (ap A (S y).1 (\ c -> (S y).2.1 c vs) (add b cs) (add ct a) (symH eq)) (symH right))) ;
  } ;
 } ;
} ;
