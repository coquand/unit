-- Lifting along a family of short exact sequences over a Stone space
-- (part (2) of the Čech dimension shift for Thm 3.3.2 (C')): for W Stone
-- and 0 -> A w -> B w -> C w -> 0 with A w overtly discrete, every section
-- psi of C merely lifts to a section of B.
-- Proof: the fibres of p w over psi w form a family of A w-torsors
-- (em/FibreTorsor); by Prop. 3.1.7 (H¹(W, A) = 0) it is merely trivial,
-- i.e. merely has a section (GTor.triv-pt).
level l ;
open Base ; open Prelude[l] ; open Torsor[l] ; open EMMaps[l] ; open Group[l] ; open GTorsor[l] ;
module Tr = Truncation[l] ; module TC1 = TruncationCombinators[l+] ;
module P1 = Prelude[l+] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ; module OD = ODisc[l] ;
module H1S = H1Stone[l] ; module Bj = Bijection[l] ;

module Over (ax : SA.Assumptions) (W : U l) (sW : PF.isStone W) (Ga Gb Gc : W -> Ab)
  (i : (w : W) -> Hom (Ga w) (Gb w)) (p : (w : W) -> Hom (Gb w) (Gc w))
  (inj : (w : W) -> Bj.Injective (i w).1)
  (pi0 : (w : W) (a : (Ga w).A) -> Id (Gc w).A ((p w).1 ((i w).1 a)) (Gc w).o)
  (ex : (w : W) (b : (Gb w).A) -> Id (Gc w).A ((p w).1 b) (Gc w).o -> Tr.Trunc[Bj.Fibre (i w).1 b].carrier)
  (sur : (w : W) (c : (Gc w).A) -> Tr.Trunc[Bj.Fibre (p w).1 c].carrier)
  (oA : (w : W) -> OD.isODisc (Ga w).A) {
  module Ft (psi : (w : W) -> (Gc w).A) (w : W) {
    module T = FibreTorsor[l].FibreTorsor[Ga w, Gb w, Gc w, i w, p w, inj w, pi0 w, ex w, sur w, psi w] ;
  } ;
  Lift (psi : (w : W) -> (Gc w).A) : U l = (w : W) -> Bj.Fibre (p w).1 (psi w) ;
  lift (psi : (w : W) -> (Gc w).A) : Tr.Trunc[Lift psi].carrier =
    TC1.rec ((w : W) -> Id (GTor[ab-grp (Ga w)].Tor) (Ft[psi, w].T.tor) (GTor[ab-grp (Ga w)].triv)) @l
      (Tr.Trunc[Lift psi].carrier) Tr.Trunc[Lift psi].proposition
      (\ t -> Tr.Trunc[Lift psi].inc (\ w -> GTor[ab-grp (Ga w)].triv-pt (Ft[psi, w].T.tor)
         (P1.sym (GTor[ab-grp (Ga w)].Tor) (Ft[psi, w].T.tor) (GTor[ab-grp (Ga w)].triv) (t w))))
      (H1S.Over[ax].prop317 W sW (\ w -> ab-grp (Ga w)) oA (\ w -> Ft[psi, w].T.tor)) ;
} ;
