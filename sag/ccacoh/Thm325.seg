-- CCA Theorem 3.2.5 and Corollary 3.2.6: for S Stone and A x overtly
-- discrete abelian groups, every eps m : K(Pi A, m) -> (x : S) -> K(A x, m)
-- (em/Eps) is an equivalence, and H^m(S, A) = 0 for m >= 1.
--
-- By induction on m, for all S and A.  m = 0: eps 0 is the identity.
-- m+1: by induction and Lemma 3.2.3 eps (m+1) is an embedding; by Lemma
-- 3.2.4 it suffices that (x : S) -> K(A x, m+1) is 0-connected:
--  m = 0: Prop. 3.1.7 for the groups A x (left torsors, by definition
--    pn's A-torsors): every alpha is merely trivial in the A-torsors, and
--    K(A, 1) embeds in them (TrivialGerbe.iota).
--  m = n+1: let alpha : (x : S) -> K(A x, n+2).  Each alpha x is merely
--    trivial, so by local choice there are Stone T x, merely inhabited,
--    with beta x : T x -> alpha x = pt.  With L x = Im d (em/ImageGroup,
--    overtly discrete: Lemma 2.7 and Prop. 2.3.9) and i : A -> A^T:
--    - K i o alpha is trivial: eps_T o K i = diag (Eps.Diag) and eps_T is
--      an embedding (induction, T x Stone), and diag (alpha x) = pt by
--      beta;
--    - H^(n+1)(S, L) = 0 (induction and Lemma 3.2.2), so by exactness
--      (em/Exact) alpha is merely trivial.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open EMMaps[l] ;
open Torsor[l] ; open TorsorId[l] ; open TrivialGerbe[l] ; open Group[l] ; open GTorsor[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ;
module OD = ODisc[l] ; module L27 = Lemma27[l] ;
module P239 = Prop239[l] ; module P214 = Prop214[l] ; module H1S = H1Stone[l] ;
module EpsM = Eps[l] ; module IG = ImageGroup[l] ; module Ex = Exact[l] ;
module Bj = Bijection[l] ;
module EMf = EM[l] ;

-- the trivial left torsor of ab-grp A is pn's trivial A-torsor
triv-atriv (Gr : Ab) : Id (TorId[Gr].Tor) (GTor[ab-grp Gr].triv) (TrivG[Gr].Atriv) =
  P1.ap (TorBase[Gr].TorStr Gr.A) (TorId[Gr].Tor) (\ s -> (Gr.A, s)) (GTor[ab-grp Gr].triv).2 (TrivG[Gr].Atriv).2
    (Sigma-eq (Gr.A -> Gr.A -> Gr.A) (TorBase[Gr].Laws Gr.A) Gr.add Gr.add (GTor[ab-grp Gr].triv).2.2 (TrivG[Gr].Atriv).2.2
       (refl Gr.add) (TorBase[Gr].laws-prop Gr.A Gr.add)) ;

module Over (ax : SA.Assumptions) {
  cc : CountableChoice[l].CC = CountableChoice[l].cc (ax.dc @l) ;

  -- H^1(X, A) = 0 for K(A, 1), from H^1 = 0 for the left torsors
  module CohK1 (X : U l) (A : X -> Ab) (z : CohZero X (\ x -> ab-grp (A x))) {
    K1 (x : X) : U l = KK[A x].K (suc zero) ;
    k0 (x : X) : K1 x = KK[A x].pt (suc zero) ;
    back (alpha : (x : X) -> K1 x) (q : (x : X) -> Id (GTor[ab-grp (A x)].Tor) (TrivG[A x].iota (alpha x)) (GTor[ab-grp (A x)].triv)) (x : X) :
      Id (K1 x) (alpha x) (k0 x) =
      (TrivG[A x].emb (alpha x) (k0 x)).sec
        (P1.trans (TorId[A x].Tor) (TrivG[A x].iota (alpha x)) (TrivG[A x].Atriv) (TrivG[A x].iota (k0 x))
           (P1.trans (TorId[A x].Tor) (TrivG[A x].iota (alpha x)) (GTor[ab-grp (A x)].triv) (TrivG[A x].Atriv) (q x) (triv-atriv (A x)))
           (P1.sym (TorId[A x].Tor) (TrivG[A x].iota (k0 x)) (TrivG[A x].Atriv) (TrivG[A x].img.triangle tt))) ;
    triv (alpha : (x : X) -> K1 x) : Tr.Trunc[Id ((x : X) -> K1 x) alpha k0].carrier =
      TC1.rec ((x : X) -> Id (GTor[ab-grp (A x)].Tor) (TrivG[A x].iota (alpha x)) (GTor[ab-grp (A x)].triv)) @l
        (Tr.Trunc[Id ((x : X) -> K1 x) alpha k0].carrier) Tr.Trunc[Id ((x : X) -> K1 x) alpha k0].proposition
        (\ q -> Tr.Trunc[Id ((x : X) -> K1 x) alpha k0].inc (FL.funext X K1 alpha k0 (back alpha q)))
        (z (\ x -> TrivG[A x].iota (alpha x))) ;
    conn : isConn (suc (suc zero)) ((x : X) -> K1 x) =
      (Tr.Trunc[(x : X) -> K1 x].inc k0, \ a b -> (TC.map2 (Id ((x : X) -> K1 x) a k0) (Id ((x : X) -> K1 x) b k0) (Id ((x : X) -> K1 x) a b)
         (\ p q -> trans ((x : X) -> K1 x) a k0 b p (sym ((x : X) -> K1 x) b k0 q)) (triv a) (triv b), \ u v -> tt)) ;
  } ;
  -- for S Stone (Prop. 3.1.7)
  h1K1 (S : U l) (sS : PF.isStone S) (A : S -> Ab) (oA : (x : S) -> OD.isODisc (A x).A) : isConn (suc (suc zero)) ((x : S) -> KK[A x].K (suc zero)) =
    CohK1[S, A, H1S.Over[ax].prop317 S sS (\ x -> ab-grp (A x)) oA].conn ;

  -- L is overtly discrete
  odiscL (T : U l) (sT : PF.isStone T) (hT : Tr.Trunc[T].carrier) (Ga : Ab) (oA : OD.isODisc Ga.A) :
    OD.isODisc (IG.Cech[T, hT, Ga].L).A =
    L27.sigma-odisc cc (ax.dc @(l+)) ((T * T) -> Ga.A)
      (P239.Over[ax].prop239 (T * T) (P214.Over[ax].product-stone T T sT sT) (\ w -> Ga.A) (\ w -> oA))
      (IG.Cech[T, hT, Ga].I.Cond) (\ g ->
        L27.trunc-odisc (Bj.Fibre (IG.Cech[T, hT, Ga].d).1 g)
          (L27.sigma-odisc cc (ax.dc @(l+)) (T -> Ga.A) (P239.Over[ax].prop239 T sT (\ t -> Ga.A) (\ t -> oA))
             (\ f -> Id ((T * T) -> Ga.A) ((IG.Cech[T, hT, Ga].d).1 f) g)
             (\ f -> L27.id-odisc ((T * T) -> Ga.A)
                (P239.Over[ax].prop239 (T * T) (P214.Over[ax].product-stone T T sT sT) (\ w -> Ga.A) (\ w -> oA))
                ((IG.Cech[T, hT, Ga].d).1 f) g))) ;

  -- the statement
  Thm (m : Nat) : U l+ = (S : U l) (sS : PF.isStone S) (A : S -> Ab) (oA : (x : S) -> OD.isODisc (A x).A) ->
    isEquiv (KK[EpsM.prod-ab S A].K m) (EpsM.Eps[S, A].P m) (EpsM.Eps[S, A].eps m).1 ;

  -- the step m = n+2
  module Step (n : Nat) (ih : Thm (suc n)) (S : U l) (sS : PF.isStone S) (A : S -> Ab) (oA : (x : S) -> OD.isODisc (A x).A) {
    K2 (x : S) : U l = KK[A x].K (suc (suc n)) ;
    pt2 (x : S) : K2 x = KK[A x].pt (suc (suc n)) ;
    module Alpha (alpha : (x : S) -> K2 x) {
      Goal : U l = Tr.Trunc[(x : S) -> Id (K2 x) (alpha x) (pt2 x)].carrier ;
      module FromCover (C : P214.Cover[S, \ x -> Id (K2 x) (alpha x) (pt2 x)]) {
        Tx (x : S) : U l = Bj.Fibre C.q x ;
        sT (x : S) : PF.isStone (Tx x) = P214.Over[ax].fibre-stone C.T S C.stone sS C.q x ;
        beta (x : S) (w : Tx x) : Id (K2 x) (alpha x) (pt2 x) =
          subst S (\ y -> Id (K2 y) (alpha y) (pt2 y)) (C.q w.1) x w.2 (C.section w.1) ;
        module CX (x : S) {
          module C2 = IG.Cech[Tx x, C.onto x, A x] ;
          module D = EpsM.Diag[Tx x, A x] ;
        } ;
        -- K i (alpha x) is trivial
        ki-triv (x : S) : Id (KK[CX[x].C2.AT].K (suc (suc n))) ((CX[x].D.Ki.K (suc (suc n))).1 (alpha x)) (KK[CX[x].C2.AT].pt (suc (suc n))) =
          (CX[x].D.E.Emb[suc n, ih (Tx x) (sT x) (\ t -> A x) (\ t -> oA x)].emb
             ((CX[x].D.Ki.K (suc (suc n))).1 (alpha x)) (KK[CX[x].C2.AT].pt (suc (suc n)))).sec
            (calc (CX[x].D.E.P (suc (suc n))) {
              (CX[x].D.E.eps (suc (suc n))).1 ((CX[x].D.Ki.K (suc (suc n))).1 (alpha x))
                =< happly (K2 x) (\ y -> CX[x].D.E.P (suc (suc n)))
                     (\ y -> (CX[x].D.E.eps (suc (suc n))).1 ((CX[x].D.Ki.K (suc (suc n))).1 y)) (CX[x].D.diag (suc (suc n))).1
                     (ap (PtMap (K2 x) (pt2 x) (CX[x].D.E.P (suc (suc n))) (CX[x].D.E.pP (suc (suc n))))
                         (K2 x -> CX[x].D.E.P (suc (suc n))) (\ g -> g.1) _ _ (CX[x].D.claim (suc (suc n)))) (alpha x) >
              (\ t -> alpha x)
                =< FL.funext (Tx x) (\ t -> K2 x) (\ t -> alpha x) (\ t -> pt2 x) (beta x) >
              CX[x].D.E.pP (suc (suc n))
                =< symH (CX[x].D.E.eps (suc (suc n))).2 >
              (CX[x].D.E.eps (suc (suc n))).1 (KK[CX[x].C2.AT].pt (suc (suc n))) }) ;
        module EX = Ex.Exact[S, A, \ x -> CX[x].C2.AT, \ x -> CX[x].C2.L, \ x -> CX[x].C2.i, \ x -> CX[x].C2.p,
          \ x -> CX[x].C2.inj, \ x -> CX[x].C2.pi0, \ x -> CX[x].C2.ex, \ x -> CX[x].C2.sur, suc n] ;
        cL : isConn (suc (suc zero)) ((x : S) -> KK[CX[x].C2.L].K (suc n)) =
          EpsM.Eps[S, \ x -> CX[x].C2.L].vanish n
            (ih S sS (\ x -> CX[x].C2.L) (\ x -> odiscL (Tx x) (sT x) (C.onto x) (A x) (oA x))) ;
        result : Goal = EX.exact cL alpha (Tr.Trunc[(x : S) -> Id (KK[CX[x].C2.AT].K (suc (suc n)))
            ((CX[x].D.Ki.K (suc (suc n))).1 (alpha x)) (KK[CX[x].C2.AT].pt (suc (suc n)))].inc ki-triv) ;
      } ;
      result : Goal =
        TC1.rec (P214.Cover[S, \ x -> Id (K2 x) (alpha x) (pt2 x)]) @l Goal Tr.Trunc[(x : S) -> Id (K2 x) (alpha x) (pt2 x)].proposition
          (\ C -> FromCover[C].result)
          (P214.Over[ax].local S sS (\ x -> Id (K2 x) (alpha x) (pt2 x))
             (\ x -> conn-path (suc n) (K2 x) (KK[A x].conn (suc n)) (alpha x) (pt2 x))) ;
    } ;
    conn : isConn (suc (suc zero)) ((x : S) -> K2 x) =
      (Tr.Trunc[(x : S) -> K2 x].inc pt2, \ a b ->
        (TC.map2 ((x : S) -> Id (K2 x) (a x) (pt2 x)) ((x : S) -> Id (K2 x) (b x) (pt2 x)) (Id ((x : S) -> K2 x) a b)
          (\ p q -> trans ((x : S) -> K2 x) a pt2 b (FL.funext S K2 a pt2 p) (sym ((x : S) -> K2 x) b pt2 (FL.funext S K2 b pt2 q)))
          Alpha[a].result Alpha[b].result, \ u v -> tt)) ;
  } ;

  -- H^(m+1)(S, A) = 0 from the theorem at m
  h1 : (m : Nat) -> Thm m -> (S : U l) (sS : PF.isStone S) (A : S -> Ab) (oA : (x : S) -> OD.isODisc (A x).A) ->
    isConn (suc (suc zero)) (EpsM.Eps[S, A].P (suc m)) = split {
    zero -> \ ih S sS A oA -> h1K1 S sS A oA ;
    suc n -> \ ih S sS A oA -> Step[n, ih, S, sS, A, oA].conn } ;

  -- Theorem 3.2.5
  thm325 : (m : Nat) -> Thm m = split {
    zero -> \ S sS A oA -> (idEquiv (EpsM.Eps[S, A].P zero)).2 ;
    suc m | ih -> \ S sS A oA -> EpsM.Eps[S, A].Emb[m, ih S sS A oA].equiv (h1 m ih S sS A oA) } ;

  -- Corollary 3.2.6: H^(m+1)(S, A) = 0
  cor326 (m : Nat) (S : U l) (sS : PF.isStone S) (A : S -> Ab) (oA : (x : S) -> OD.isODisc (A x).A) :
    isConn (suc (suc zero)) (EpsM.Eps[S, A].P (suc m)) =
    EpsM.Eps[S, A].vanish m (thm325 (suc m) S sS A oA) ;
} ;
