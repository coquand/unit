-- CCA Lemma 3.1.6, Prop. 3.1.7 and Prop. 3.1.8 (vanishing form), for
-- families of overtly discrete groups G x (not necessarily abelian).
--
-- Lemma 3.1.6: S Stone, T x Stone and merely inhabited: Ȟ¹(S, T, G) = 0.
--   A proposition, so take the tower of Lemma 2.1.7; T x is equivalent to
--   its limit, Ȟ¹ = 0 passes along equivalences of the fibres (transfer),
--   and holds for the limit (ScottCech).
-- Prop. 3.1.7: S Stone: H¹(S, G) = 0.  Let alpha : (x : S) -> BG x.  Each
--   alpha x is merely inhabited, so by local choice (Prop. 2.1.4 (iv),
--   worker A) merely there are a Stone T ->> S and points of alpha (q t)
--   for t : T.  The fibres T x of q are Stone and merely inhabited and
--   carry points of alpha x (transport), so alpha is trivial by Lemma
--   3.1.6 and Appendix A (CechNA.Points.trivialise).
-- Prop. 3.1.8, vanishing form: for q : S ->> X with S Stone (X any type;
--   the paper: X compact Hausdorff), H¹(X, G) = 0 iff Ȟ¹(X, S, G) = 0,
--   with S x the fibre of q over x.  Cor. A.0.8, with H¹ of
--   (x : X) * S x, which is S, vanishing by Prop. 3.1.7.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ; open GTorsor[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ;
module OD = ODisc[l] ; module DCh = DependentChoice[l] ;
module L217 = Lemma217[l] ; module P214 = Prop214[l] ;
module SC = ScottCech[l] ;
module Bj = Bijection[l] ;

-- Ȟ¹ = 0 passes along equivalences of the fibres
transfer (X : U l) (Y Y' : X -> U l) (e : (x : X) -> Equiv (Y x) (Y' x))
  (hY : (x : X) -> Tr.Trunc[Y x].carrier) (hY' : (x : X) -> Tr.Trunc[Y' x].carrier) (G : X -> Grp)
  (z : CechNA[l].CechNA[X, Y', hY', G].H1Zero) : CechNA[l].CechNA[X, Y, hY, G].H1Zero = \ d c ->
  TC.map ((g : CechNA[l].CechNA[X, Y', hY', G].C0) *
          CechNA[l].CechNA[X, Y', hY', G].Bounds (\ x a b -> d x ((e x).2.sec a) ((e x).2.sec b)) g)
    ((g : CechNA[l].CechNA[X, Y, hY, G].C0) * CechNA[l].CechNA[X, Y, hY, G].Bounds d g)
    (\ w -> (\ x u -> w.1 x ((e x).1 u), \ x u v ->
       transH (apH ((G x).mul (w.1 x ((e x).1 v)))
                 (symH (transH (apH (\ a -> d x a ((e x).2.sec ((e x).1 v))) (sec-ret (Y x) (Y' x) (e x).1 (e x).2 u))
                               (apH (d x u) (sec-ret (Y x) (Y' x) (e x).1 (e x).2 v)))))
              (w.2 x ((e x).1 u) ((e x).1 v))))
    (z (\ x a b -> d x ((e x).2.sec a) ((e x).2.sec b)) (\ x a b w -> c x ((e x).2.sec a) ((e x).2.sec b) ((e x).2.sec w))) ;

h1zero-prop (X : U l) (Y : X -> U l) (hY : (x : X) -> Tr.Trunc[Y x].carrier) (G : X -> Grp) :
  isProp (CechNA[l].CechNA[X, Y, hY, G].H1Zero) =
  F.isProp-Pi (CechNA[l].CechNA[X, Y, hY, G].C1)
    (\ d -> CechNA[l].CechNA[X, Y, hY, G].Cocycle d -> CechNA[l].CechNA[X, Y, hY, G].Trivial d) (\ d ->
    F.isProp-Pi (CechNA[l].CechNA[X, Y, hY, G].Cocycle d) (\ c -> CechNA[l].CechNA[X, Y, hY, G].Trivial d)
      (\ c -> Tr.Trunc[(g : CechNA[l].CechNA[X, Y, hY, G].C0) * CechNA[l].CechNA[X, Y, hY, G].Bounds d g].proposition)) ;

-- the total space of the fibres of a map is its domain
total-fib (A B : U l) (f : A -> B) : Equiv ((b : B) * Bj.Fibre f b) A =
  (\ w -> w.2.1, qinv ((b : B) * Bj.Fibre f b) A (\ w -> w.2.1) (\ a -> (f a, (a, refl (f a)))) (\ a -> refl a)
     (\ w -> idJ B (f w.2.1) (\ b1 e1 -> Id ((b : B) * Bj.Fibre f b) (f w.2.1, (w.2.1, refl (f w.2.1))) (b1, (w.2.1, e1)))
               (refl (f w.2.1, (w.2.1, refl (f w.2.1)))) w.1 w.2.2)) ;

module Over (ax : SA.Assumptions) {
  -- Lemma 3.1.6
  lemma316 (S : U l) (sS : PF.isStone S) (T : S -> U l) (sT : (x : S) -> PF.isStone (T x))
    (inh : (x : S) -> Tr.Trunc[T x].carrier) (G : S -> Grp) (oG : (x : S) -> OD.isODisc (G x).G) :
    CechNA[l].CechNA[S, T, inh, G].H1Zero =
    TC1.rec (L217.Approx[S, T]) @l (CechNA[l].CechNA[S, T, inh, G].H1Zero) (h1zero-prop S T inh G)
      (\ apx -> transfer S T (SC.Over[ax].Stages[S, sS, T, apx, G, oG].L) apx.limit inh
         (\ x -> TC.map (T x) (SC.Over[ax].Stages[S, sS, T, apx, G, oG].L x) (apx.limit x).1 (inh x)) G
         (SC.Over[ax].Stages[S, sS, T, apx, G, oG].OnLimit[\ x -> TC.map (T x) (SC.Over[ax].Stages[S, sS, T, apx, G, oG].L x)
            (apx.limit x).1 (inh x)].h1zero))
      (L217.Over[ax].lemma217 S sS T sT inh) ;

  -- Prop. 3.1.7
  module Prop317 (S : U l) (sS : PF.isStone S) (G : S -> Grp) (oG : (x : S) -> OD.isODisc (G x).G)
    (alpha : (x : S) -> GTor[G x].Tor) {
    Goal : U l+ = T1.Trunc[(x : S) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].carrier ;
    module FromCover (C : P214.Cover[S, \ x -> (alpha x).1]) {
      Tx (x : S) : U l = Bj.Fibre C.q x ;
      beta (x : S) (w : Tx x) : (alpha x).1 = subst S (\ y -> (alpha y).1) (C.q w.1) x w.2 (C.section w.1) ;
      module CS = CechNA[l].CechNA[S, Tx, C.onto, G] ;
      result : Goal =
        CS.Points[alpha, beta].trivialise
          (lemma316 S sS Tx (\ x -> P214.Over[ax].fibre-stone C.T S C.stone sS C.q x) C.onto G oG
             CS.Points[alpha, beta].phi CS.Points[alpha, beta].cocycle) ;
    } ;
    result : Goal =
      TC1.rec (P214.Cover[S, \ x -> (alpha x).1]) @(l+) Goal T1.Trunc[(x : S) -> Id (GTor[G x].Tor) (alpha x) (GTor[G x].triv)].proposition
        (\ C -> FromCover[C].result)
        (P214.Over[ax].local S sS (\ x -> (alpha x).1) (\ x -> GTor[G x].D[(alpha x).1, (alpha x).2].inh)) ;
  } ;
  prop317 (S : U l) (sS : PF.isStone S) (G : S -> Grp) (oG : (x : S) -> OD.isODisc (G x).G) : CohZero S G =
    \ alpha -> Prop317[S, sS, G, oG, alpha].result ;

  -- Prop. 3.1.8, vanishing form
  module Prop318 (X : U l) (S : U l) (sS : PF.isStone S) (q : S -> X) (onto : DCh.Surjective q)
    (G : X -> Grp) (oG : (x : X) -> OD.isODisc (G x).G) {
    module A8 = CorA08[X, Bj.Fibre q, onto, G] ;
    total-stone : PF.isStone ((x : X) * Bj.Fibre q x) = P214.stone-equiv ((x : X) * Bj.Fibre q x) S (total-fib S X q) sS ;
    -- H¹(X, G) = 0 gives Ȟ¹(X, S, G) = 0
    forward (z : CohZero X G) : A8.C.H1Zero = A8.forward z ;
    -- Ȟ¹(X, S, G) = 0 gives H¹(X, G) = 0
    backward (z : A8.C.H1Zero) : CohZero X G =
      A8.backward (prop317 ((x : X) * Bj.Fibre q x) total-stone (\ w -> G w.1) (\ w -> oG w.1)) z ;
  } ;
} ;
