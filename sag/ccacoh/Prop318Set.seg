-- CCA Prop. 3.1.8 as a bijection of sets: for q : S ->> X with S Stone and
-- G x overtly discrete groups (not necessarily abelian),
--   H¹(X, G) = Ȟ¹(X, S, G),
-- with S x the fibre of q over x (X any type; the paper: X compact
-- Hausdorff).  Proof as in the paper: Cor. A.0.8 (em/CorA07, as a
-- bijection), whose hypothesis H¹((x : X) * S x, G o pr1) = 0 is
-- Prop. 3.1.7 for the Stone space (x : X) * S x (equivalent to S), as in
-- H1Stone.Prop318.backward.
level l ;
open Base ; open Prelude[l] ; open Group[l] ;
module SA = StoneAxioms[l,l] ; module OD = ODisc[l] ; module DCh = DependentChoice[l] ;
module H1S = H1Stone[l] ; module Bj = Bijection[l] ;

module Over (ax : SA.Assumptions) (X : U l) (S : U l) (sS : Profinite[l,l].isStone S) (q : S -> X)
  (onto : DCh.Surjective q) (G : X -> Grp) (oG : (x : X) -> OD.isODisc (G x).G) {
  module P8 = H1S.Over[ax].Prop318[X, S, sS, q, onto, G, oG] ;
  module A7 = CorA07[l].CorA07[X, Bj.Fibre q, onto, G] ;
  module A8 = A7.A08[H1S.Over[ax].prop317 ((x : X) * Bj.Fibre q x) P8.total-stone (\ w -> G w.1) (\ w -> oG w.1)] ;
  -- Prop. 3.1.8: Ȟ¹(X, S, G) = H¹(X, G)
  prop318 : Prelude[l+].Equiv A7.Cech A7.H1 = A8.corA08 ;
} ;
