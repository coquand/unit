-- CCA Lemma 3.1.5: for S Stone, a tower T k x of inhabited Stone spaces
-- over S (down maps d k x : T (k+1) x -> T k x) with limit L x, and G x
-- overtly discrete groups,
--     colim_k Ȟ¹(S, T k, G)  =  Ȟ¹(S, L, G),
-- by the map induced by the restrictions along the projections L x -> T k x.
--
-- The sequence: Ȟ¹(S, T k, G) -> Ȟ¹(S, T (k+1), G) restricts along d k
-- (em/CechPull); restricting along d k and then to L is restricting to L
-- (the projections commute with d, so the two cocycles are equal pointwise).
-- Injective: on one stage the map is a restriction, injective by
--   CechPull (both sides are subsets of H¹(S, G)); a map out of a
--   sequential colimit injective on each stage is injective (StageInjective).
-- Surjective: a cocycle on L is, merely, the restriction of a cocycle at
--   some stage K (ScottCech.Tower.Cocycles: cochains of pairs and triples
--   are the colimits of the stage cochains, Props 2.3.5 and 2.3.7).
-- The limit L x is merely inhabited (LimInhabited).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ;
module P1 = Prelude[l+] ; module Pa1 = Paths[l+] ;
module B1 = Bijection[l+] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ; module OD = ODisc[l] ;
module SC = ScottCech[l] ;
module SC1 = SeqColim[l+] ;

module Over (ax : SA.Assumptions) {
  module Lemma315 (S : U l) (sS : PF.isStone S) (Tk : Nat -> S -> U l) (dk : (k : Nat) (x : S) -> Tk (suc k) x -> Tk k x)
    (sT : (k : Nat) (x : S) -> PF.isStone (Tk k x)) (inh : (k : Nat) (x : S) -> Tr.Trunc[Tk k x].carrier)
    (G : S -> Grp) (oG : (x : S) -> OD.isODisc (G x).G) {
    module W = SC.Over[ax].Tower[S, sS, Tk, dk, sT, inh, G, oG] ;
    L (x : S) : U l = W.L x ;
    hL (x : S) : Tr.Trunc[L x].carrier =
      LimInhabited[l].Over[ax].lim-inhabited (\ k -> Tk k x) (\ k -> dk k x) (\ k -> sT k x) (\ k -> inh k x) ;
    module AK (k : Nat) { module A = CorA07[l].CorA07[S, \ x -> Tk k x, inh k, G] ; } ;
    module AL = CorA07[l].CorA07[S, L, hL, G] ;
    -- restricting along d k, and along the projection to stage k
    module Down (k : Nat) { module P = CechPull[l].Pull[S, \ x -> Tk k x, \ x -> Tk (suc k) x, inh k, inh (suc k), G, dk k] ; } ;
    module Proj (k : Nat) { module P = CechPull[l].Pull[S, \ x -> Tk k x, L, inh k, hL, G, \ x a -> a.1 k] ; } ;
    H (k : Nat) : U l+ = AK[k].A.Cech ;
    seq : SC1.Seq = SC1.mkSeq H (\ k -> Down[k].P.map) ;
    module CH = SC1.Colim[seq] ;

    -- the cocone
    cocone-cyc (k : Nat) (u : AK[k].A.Cyc) :
      Id AL.Cech (Proj[suc k].P.map (Down[k].P.map (AK[k].A.QC.inc u))) (Proj[k].P.map (AK[k].A.QC.inc u)) = calc AL.Cech {
      Proj[suc k].P.map (Down[k].P.map (AK[k].A.QC.inc u))
        =< Pa1.apH (Proj[suc k].P.map) (Down[k].P.map-inc u) > Proj[suc k].P.map (AK[suc k].A.QC.inc (Down[k].P.cyc u))
        =< Proj[suc k].P.map-inc (Down[k].P.cyc u) > AL.QC.inc (Proj[suc k].P.cyc (Down[k].P.cyc u))
        =< AL.QC.relates (Proj[suc k].P.cyc (Down[k].P.cyc u)) (Proj[k].P.cyc u)
             (AL.eq-coh (Proj[suc k].P.cyc (Down[k].P.cyc u)) (Proj[k].P.cyc u) (\ x a b ->
               transH (apH (\ z -> u.1 x z (dk k x (b.1 (suc k)))) (a.2 k)) (apH (u.1 x (a.1 k)) (b.2 k)))) >
        AL.QC.inc (Proj[k].P.cyc u)
        =< Pa1.symH (Proj[k].P.map-inc u) > Proj[k].P.map (AK[k].A.QC.inc u) } ;
    cocone (k : Nat) (q : H k) : Id AL.Cech (Proj[suc k].P.map (Down[k].P.map q)) (Proj[k].P.map q) =
      AK[k].A.QC.induction @(l+) (\ q1 -> Id AL.Cech (Proj[suc k].P.map (Down[k].P.map q1)) (Proj[k].P.map q1))
        (\ q1 -> AL.QC.set (Proj[suc k].P.map (Down[k].P.map q1)) (Proj[k].P.map q1)) (cocone-cyc k) q ;
    module R = CH.Rec[AL.Cech, AL.QC.set, CH.mkCocone AL.Cech (\ k -> Proj[k].P.map) cocone] ;
    -- the canonical map
    canonical (c : CH.colim) : AL.Cech = R.map c ;

    injective : B1.Injective canonical = StageInjective[l+].StageInjective[seq, AL.Cech, canonical, \ N a b p ->
      Pa1.apH (CH.inc N) (Proj[N].P.injective a b (Pa1.transH (Pa1.symH (R.beta N a)) (Pa1.transH p (R.beta N b))))].injective ;

    module Lift (v : AL.Cyc) {
      module G' = W.Cocycles[hL].Given[v.1, v.2] ;
      fibre (st : G'.Staged) : B1.Fibre canonical (AL.QC.inc v) =
        (CH.inc st.1 (AK[st.1].A.QC.inc (st.2.1, st.2.2.1)), calc AL.Cech {
          canonical (CH.inc st.1 (AK[st.1].A.QC.inc (st.2.1, st.2.2.1)))
            =< R.beta st.1 (AK[st.1].A.QC.inc (st.2.1, st.2.2.1)) > Proj[st.1].P.map (AK[st.1].A.QC.inc (st.2.1, st.2.2.1))
            =< Proj[st.1].P.map-inc (st.2.1, st.2.2.1) > AL.QC.inc (Proj[st.1].P.cyc (st.2.1, st.2.2.1))
            =< AL.QC.relates (Proj[st.1].P.cyc (st.2.1, st.2.2.1)) v
                 (AL.eq-coh (Proj[st.1].P.cyc (st.2.1, st.2.2.1)) v (\ x a b -> symH (st.2.2.2 x a b))) >
            AL.QC.inc v }) ;
      result : T1.Trunc[B1.Fibre canonical (AL.QC.inc v)].carrier =
        TC.rec G'.Staged @(l+) (T1.Trunc[B1.Fibre canonical (AL.QC.inc v)].carrier) T1.Trunc[B1.Fibre canonical (AL.QC.inc v)].proposition
          (\ st -> T1.Trunc[B1.Fibre canonical (AL.QC.inc v)].inc (fibre st)) G'.staged ;
    } ;
    surjective (q : AL.Cech) : T1.Trunc[B1.Fibre canonical q].carrier =
      AL.QC.induction @(l+) (\ q1 -> T1.Trunc[B1.Fibre canonical q1].carrier) (\ q1 -> T1.Trunc[B1.Fibre canonical q1].proposition)
        (\ v -> Lift[v].result) q ;
    -- Lemma 3.1.5
    equivalence : P1.Equiv CH.colim AL.Cech = (canonical, B1.Bij[CH.colim, AL.Cech, AL.QC.set, canonical, injective, surjective].equiv) ;
  } ;
} ;
