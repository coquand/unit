-- CCA Theorem 3.3.2 in the form (C') (CCA-DESIGN.md §5): for X compact
-- Hausdorff (a set with closed equality), a Stone S ->> X with fibres S x
-- and A x overtly discrete abelian groups,
--   if Ȟ^(m+1)(X, S, A) = 0 for all m, then H^(n+1)(X, A) = 0 for all n.
-- (Ȟ^k = 0 is worker A's Cochains.Cech[X, S, A].Vanish k.)
--
-- Induction on n, for all such A, as in Thm332 (form (C)):
--  n = 0: Ȟ¹ = 0 (H1Bridge) and Prop. 3.1.8.
--  n+1: Thm332.Step, i.e. H^(n+1)(X, L) = 0 gives H^(n+2)(X, A) = 0 for
--    L = A^S / A; L is again overtly discrete with all Ȟ^(m+1)(X, S, L) = 0
--    by the dimension shift (CechHigher.Shift.shift) from Ȟ^(m+2)(X, S, A) = 0.
-- The shift needs L-cochains to lift to A^S-cochains (part (2)): over the
-- Stone space W k = (x : X) * (Fin (k+1) -> S x) (LiftStone, by
-- Prop. 3.1.7).  W 0 is (x : X) * S x, which is S; W (k+1) is
-- (w : W k) * S w.1 (split off the first point), Stone by Thm 4.18.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
open HLevels[l] ; open Connected[l] ; open EMMaps[l] ; open AbHom[l] ; open Torsor[l] ; open Group[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ; module OC = OpenClosed[l,l] ;
module OD = ODisc[l] ; module DCh = DependentChoice[l] ;
module H1S = H1Stone[l] ; module T325 = Thm325[l] ; module CH = CechHigher[l] ; module CHB = CechH1Bridge[l] ;
module P214 = Prop214[l] ;

module Over (ax : SA.Assumptions) (X : U l) (sX : isSet X) (idc : (x y : X) -> OC.isClosed (Id X x y))
  (S : U l) (sS : PF.isStone S) (q : S -> X) (onto : DCh.Surjective q) {
  module T = Thm332[l].Over[ax, X, sX, idc, S, sS, q, onto] ;
  module SH (B : X -> Ab) { module H = CH.Shift[X, T.Sx, onto, B] ; } ;

  -- the tuples of points of the fibres form a Stone space
  W (k : Nat) : U l = (x : X) * (Fin (suc k) -> T.Sx x) ;
  one-pt (x : X) (t : Fin (suc zero) -> T.Sx x) : (i : Fin (suc zero)) -> Id (T.Sx x) (t none) (t i) = split {
    none -> refl (t none) ; some e -> absurd (Id (T.Sx x) (t none) (t (some e))) e } ;
  e0 : Equiv (W zero) ((x : X) * T.Sx x) =
    (\ w -> (w.1, w.2 none), qinv (W zero) ((x : X) * T.Sx x) (\ w -> (w.1, w.2 none)) (\ v -> (v.1, \ i -> v.2))
      (\ v -> refl v)
      (\ w -> apH (\ f -> (w.1, f)) (FL.funext (Fin (suc zero)) (\ i -> T.Sx w.1) (\ i -> w.2 none) w.2 (one-pt w.1 w.2)))) ;
  eta (k : Nat) (x : X) (t : Fin (suc (suc k)) -> T.Sx x) :
    (i : Fin (suc (suc k))) -> Id (T.Sx x) (combine (suc k) (\ i -> T.Sx x) (t none) (\ j -> t (some j)) i) (t i) = split {
    none -> refl (t none) ; some j -> refl (t (some j)) } ;
  es (k : Nat) : Equiv (W (suc k)) ((w : W k) * T.Sx w.1) =
    (\ w -> ((w.1, \ j -> w.2 (some j)), w.2 none),
     qinv (W (suc k)) ((w : W k) * T.Sx w.1) (\ w -> ((w.1, \ j -> w.2 (some j)), w.2 none))
       (\ v -> (v.1.1, combine (suc k) (\ i -> T.Sx v.1.1) v.2 v.1.2))
       (\ v -> refl v)
       (\ w -> apH (\ f -> (w.1, f)) (FL.funext (Fin (suc (suc k))) (\ i -> T.Sx w.1)
          (combine (suc k) (\ i -> T.Sx w.1) (w.2 none) (\ j -> w.2 (some j))) w.2 (eta k w.1 w.2)))) ;
  w-stone : (k : Nat) -> PF.isStone (W k) = split {
    zero -> P214.stone-equiv (W zero) ((x : X) * T.Sx x) e0 T.total-stone ;
    suc k | r -> P214.stone-equiv (W (suc k)) ((w : W k) * T.Sx w.1) (es k)
      (Thm418[l].Over[ax].thm418 (W k) r (\ w -> T.Sx w.1) (\ w -> T.sSx w.1)) } ;

  -- part (2): L-cochains lift to B^S-cochains
  lifts (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) (k : Nat) : SH[B].H.Lifts (suc k) = \ phi ->
    TC.map ((w : W k) -> Bijection[l].Fibre (SH[B].H.p w.1).1 (phi w.1 w.2)) (SH[B].H.Lift (suc k) phi)
      (\ f -> (\ x t -> (f (x, t)).1, \ x t -> (f (x, t)).2))
      (LiftStone[l].Over[ax, W k, w-stone k, \ w -> B w.1, \ w -> SH[B].H.AS w.1, \ w -> SH[B].H.L w.1,
         \ w -> SH[B].H.i w.1, \ w -> SH[B].H.p w.1, \ w -> SH[B].H.IX[w.1].C2.inj, \ w -> SH[B].H.IX[w.1].C2.pi0,
         \ w -> SH[B].H.IX[w.1].C2.ex, \ w -> SH[B].H.IX[w.1].C2.sur, \ w -> oB w.1].lift (\ w -> phi w.1 w.2)) ;

  -- the class: overtly discrete with Ȟ^(m+1)(X, S, B) = 0 for all m
  AllVanish (B : X -> Ab) : U l = (m : Nat) -> Cochains[l].Cech[X, T.Sx, B].Vanish (suc m) ;
  -- L B stays in the class (the dimension shift)
  stays (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) (v : AllVanish B) : AllVanish (\ x -> T.CX[B, x].C2.L) =
    \ m -> SH[B].H.shift m (lifts B oB (suc m)) (v (suc m)) ;

  Goal (n : Nat) : U l+ = (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) (v : AllVanish B) ->
    isConn (suc (suc zero)) ((x : X) -> KK[B x].K (suc n)) ;
  goal0 : Goal zero = \ B oB v ->
    T325.Over[ax].CohK1[X, B, H1S.Over[ax].Prop318[X, S, sS, q, onto, \ x -> ab-grp (B x), oB].backward
      (CHB.H1Bridge[X, T.Sx, onto, B].h1zero (v zero))].conn ;
  -- Theorem 3.3.2, form (C')
  thm332 : (n : Nat) -> Goal n = split {
    zero -> goal0 ;
    suc n | ih -> \ B oB v -> T.Step[n, B, oB, ih (\ x -> T.CX[B, x].C2.L) (T.odiscL B oB) (stays B oB v)].conn } ;
} ;
