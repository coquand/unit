-- CCA Lemma 3.1.5 (in the form used) and Lemma 3.1.6: for S Stone, T x
-- Stone and merely inhabited, G x overtly discrete groups,
--     Ȟ¹(S, T, G) = 0          (non-abelian, em/CechNA).
--
-- `Tower` is the general case of a tower T k x of inhabited Stone spaces
-- (Props 2.3.5 and 2.3.7 for Stone towers); its `Cocycles.Given.staged`
-- (a cocycle on the limit is merely the restriction of a cocycle at a
-- stage) is also what Lemma 3.1.5 as stated uses (Lemma315).  `Stages` is
-- the instance for the towers of Lemma 2.1.7 (finite stages, which are
-- Stone, with sections), followed by step 3 below.
--
-- By Lemma 2.1.7 (worker A) merely T x = lim_k T k x with T k x finite and
-- every (x : S) -> T k x merely inhabited; being Ȟ¹ = 0 is a proposition,
-- so take this tower, and replace T x by the limit L x.  Pairs and triples
-- at stage k form towers E2, E3 of finite sets with limits Lim2, Lim3; by
-- Prop. 2.3.5 and Prop. 2.3.7 (worker A) the maps
--     Phi m : colim_k ((x : S) -> E m k x -> G x)  ->  (x : S) -> Lim m x -> G x,
--     [h] |-> (x w |-> h x (w at k))
-- are equivalences (Lemma 3.1.5: Ȟ¹ commutes with the colimit, in the
-- form: cochains do).  Let delta be a cocycle on L.
--  1. Phi 2 onto: merely delta x a b = h x (a_k, b_k) for some stage k, h.
--  2. The two sides of the cocycle condition of h at stage k, as triples,
--     have the same image under Phi 3 (the cocycle condition of delta);
--     Phi 3 is injective, so they agree after d steps: h' = h shifted d
--     steps is a cocycle at stage K = d + k, and still represents delta.
--  3. (x : S) -> T K x merely has a section, so h' is trivial at stage K
--     (Lemma A.0.1), by some gamma'; then gamma x a = gamma' x a_K makes
--     delta trivial.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open SeqColim[l] ; open Group[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ;
module Fi = Finite[l] ; module FCl = FiniteClosure[l] ; module OD = ODisc[l] ; module DCh = DependentChoice[l] ;
module FCo = FiniteCode[l] ;
module L217 = Lemma217[l] ; module L236 = Lemma236[l] ; module P235 = Prop235[l] ; module P237 = Prop237[l] ;
module Eq = Equivalences[l] ;

-- paths of pairs
pairpath (A B : U l) (u u' : A) (p : Id A u u') (v v' : B) (q : Id B v v') : Id (A * B) (u, v) (u', v') =
  transH (ap A (A * B) (\ z -> (z, v)) u u' p) (ap B (A * B) (\ z -> (u', z)) v v' q) ;
pp-fst (A B : U l) (u u' : A) (p : Id A u u') (v v' : B) (q : Id B v v') :
  Id (Id A u u') (ap (A * B) A (\ w -> w.1) (u, v) (u', v') (pairpath A B u u' p v v' q)) p =
  idJ B v (\ v1 q1 -> Id (Id A u u') (ap (A * B) A (\ w -> w.1) (u, v) (u', v1) (pairpath A B u u' p v v1 q1)) p)
    (idJ A u (\ u1 p1 -> Id (Id A u u1) (ap (A * B) A (\ w -> w.1) (u, v) (u1, v) (pairpath A B u u1 p1 v v (refl v))) p1)
       (refl (refl u)) u' p) v' q ;
pp-snd (A B : U l) (u u' : A) (p : Id A u u') (v v' : B) (q : Id B v v') :
  Id (Id B v v') (ap (A * B) B (\ w -> w.2) (u, v) (u', v') (pairpath A B u u' p v v' q)) q =
  idJ B v (\ v1 q1 -> Id (Id B v v1) (ap (A * B) B (\ w -> w.2) (u, v) (u', v1) (pairpath A B u u' p v v1 q1)) q1)
    (idJ A u (\ u1 p1 -> Id (Id B v v) (ap (A * B) B (\ w -> w.2) (u, v) (u1, v) (pairpath A B u u1 p1 v v (refl v))) (refl v))
       (refl (refl v)) u' p) v' q ;

module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  -- a tower of inhabited Stone spaces T k x over S (Lemma 3.1.5's setting)
  module Tower (S : U l) (sS : PF.isStone S) (Tk : Nat -> S -> U l) (dk : (k : Nat) (x : S) -> Tk (suc k) x -> Tk k x)
    (sT : (k : Nat) (x : S) -> PF.isStone (Tk k x)) (inh : (k : Nat) (x : S) -> Tr.Trunc[Tk k x].carrier)
    (G : S -> Grp) (oG : (x : S) -> OD.isODisc (G x).G) {
    L (x : S) : U l = DCh.Lim (\ k -> Tk k x) (\ k -> dk k x) ;
    E2 (x : S) (k : Nat) : U l = Tk k x * Tk k x ;
    p2 (x : S) (k : Nat) (w : E2 x (suc k)) : E2 x k = (dk k x w.1, dk k x w.2) ;
    E3 (x : S) (k : Nat) : U l = Tk k x * E2 x k ;
    p3 (x : S) (k : Nat) (w : E3 x (suc k)) : E3 x k = (dk k x w.1, dk k x w.2.1, dk k x w.2.2) ;
    stone2 (x : S) (k : Nat) : PF.isStone (E2 x k) = P214.product-stone (Tk k x) (Tk k x) (sT k x) (sT k x) ;
    stone3 (x : S) (k : Nat) : PF.isStone (E3 x k) = P214.product-stone (Tk k x) (E2 x k) (sT k x) (stone2 x k) ;
    Lim2 (x : S) : U l = DCh.Lim (E2 x) (p2 x) ;
    Lim3 (x : S) : U l = DCh.Lim (E3 x) (p3 x) ;
    Tw2 : P235.Tower[S] = P235.mkTower S (\ x -> L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].seq)
      (\ i x -> L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].stage-set i) ;
    Tw3 : P235.Tower[S] = P235.mkTower S (\ x -> L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].seq)
      (\ i x -> L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].stage-set i) ;
    module C2 = P235.Colims[S, Tw2] ;
    module C3 = P235.Colims[S, Tw3] ;
    Coch2 : U l = (x : S) -> Lim2 x -> (G x).G ;
    Coch3 : U l = (x : S) -> Lim3 x -> (G x).G ;

    Phi2 (c : C2.CP.colim) : Coch2 = \ x -> L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].canonical (C2.canonical c x) ;
    Phi3 (c : C3.CP.colim) : Coch3 = \ x -> L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].canonical (C3.canonical c x) ;
    phi2-equiv : isEquiv C2.CP.colim Coch2 Phi2 =
      (Eq.compose C2.CP.colim C2.Target Coch2 (C2.canonical, P235.Over[ax].prop235 S sS Tw2)
        (\ a x -> L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].canonical (a x),
         PiEquiv[l].pi-equiv S (\ x -> Colim[Tw2.at x].colim) (\ x -> Lim2 x -> (G x).G)
           (\ x -> L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].canonical)
           (\ x -> P237.Over[ax].prop237-stone (E2 x) (p2 x) (stone2 x) (G x).G (G x).setG (oG x)))).2 ;
    phi3-equiv : isEquiv C3.CP.colim Coch3 Phi3 =
      (Eq.compose C3.CP.colim C3.Target Coch3 (C3.canonical, P235.Over[ax].prop235 S sS Tw3)
        (\ a x -> L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].canonical (a x),
         PiEquiv[l].pi-equiv S (\ x -> Colim[Tw3.at x].colim) (\ x -> Lim3 x -> (G x).G)
           (\ x -> L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].canonical)
           (\ x -> P237.Over[ax].prop237-stone (E3 x) (p3 x) (stone3 x) (G x).G (G x).setG (oG x)))).2 ;
    -- the values on a stage
    phi2-inc (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) (x : S) (w : Lim2 x) :
      Id (G x).G (Phi2 (C2.CP.inc k h) x w) (h x (w.1 k)) =
      happly (Lim2 x) (\ w1 -> (G x).G) (Phi2 (C2.CP.inc k h) x) (\ w1 -> h x (w1.1 k))
        (transH (apH (L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].canonical)
                   (happly S (\ x1 -> Colim[Tw2.at x1].colim) (C2.canonical (C2.CP.inc k h)) (C2.pointwise k h)
                      (C2.canonical-inc k h) x))
                (L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].canonical-inc k (h x))) w ;
    phi3-inc (k : Nat) (h : (x : S) -> E3 x k -> (G x).G) (x : S) (w : Lim3 x) :
      Id (G x).G (Phi3 (C3.CP.inc k h) x w) (h x (w.1 k)) =
      happly (Lim3 x) (\ w1 -> (G x).G) (Phi3 (C3.CP.inc k h) x) (\ w1 -> h x (w1.1 k))
        (transH (apH (L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].canonical)
                   (happly S (\ x1 -> Colim[Tw3.at x1].colim) (C3.canonical (C3.CP.inc k h)) (C3.pointwise k h)
                      (C3.canonical-inc k h) x))
                (L236.FMaps[E3 x, p3 x, (G x).G, (G x).setG].canonical-inc k (h x))) w ;

    -- pairs of points of the limit, and the components of triples
    zip2 (x : S) (a b : L x) : Lim2 x =
      (\ k -> (a.1 k, b.1 k), \ k -> pairpath (Tk k x) (Tk k x) (dk k x (a.1 (suc k))) (a.1 k) (a.2 k)
                                       (dk k x (b.1 (suc k))) (b.1 k) (b.2 k)) ;
    fst2 (x : S) (w : Lim2 x) : L x = (\ k -> (w.1 k).1, \ k -> ap (E2 x k) (Tk k x) (\ z -> z.1) (p2 x k (w.1 (suc k))) (w.1 k) (w.2 k)) ;
    snd2 (x : S) (w : Lim2 x) : L x = (\ k -> (w.1 k).2, \ k -> ap (E2 x k) (Tk k x) (\ z -> z.2) (p2 x k (w.1 (suc k))) (w.1 k) (w.2 k)) ;
    fst2-zip (x : S) (a b : L x) : Id (L x) (fst2 x (zip2 x a b)) a =
      ap ((k : Nat) -> Id (Tk k x) (dk k x (a.1 (suc k))) (a.1 k)) (L x) (\ s -> (a.1, s))
        (\ k -> ap (E2 x k) (Tk k x) (\ z -> z.1) (p2 x k ((zip2 x a b).1 (suc k))) ((zip2 x a b).1 k) ((zip2 x a b).2 k)) a.2
        (F.funext Nat (\ k -> Id (Tk k x) (dk k x (a.1 (suc k))) (a.1 k)) _ a.2 (\ k ->
          pp-fst (Tk k x) (Tk k x) (dk k x (a.1 (suc k))) (a.1 k) (a.2 k) (dk k x (b.1 (suc k))) (b.1 k) (b.2 k))) ;
    snd2-zip (x : S) (a b : L x) : Id (L x) (snd2 x (zip2 x a b)) b =
      ap ((k : Nat) -> Id (Tk k x) (dk k x (b.1 (suc k))) (b.1 k)) (L x) (\ s -> (b.1, s))
        (\ k -> ap (E2 x k) (Tk k x) (\ z -> z.2) (p2 x k ((zip2 x a b).1 (suc k))) ((zip2 x a b).1 k) ((zip2 x a b).2 k)) b.2
        (F.funext Nat (\ k -> Id (Tk k x) (dk k x (b.1 (suc k))) (b.1 k)) _ b.2 (\ k ->
          pp-snd (Tk k x) (Tk k x) (dk k x (a.1 (suc k))) (a.1 k) (a.2 k) (dk k x (b.1 (suc k))) (b.1 k) (b.2 k))) ;
    t1 (x : S) (w : Lim3 x) : L x = (\ k -> (w.1 k).1, \ k -> ap (E3 x k) (Tk k x) (\ z -> z.1) (p3 x k (w.1 (suc k))) (w.1 k) (w.2 k)) ;
    t2 (x : S) (w : Lim3 x) : L x = (\ k -> (w.1 k).2.1, \ k -> ap (E3 x k) (Tk k x) (\ z -> z.2.1) (p3 x k (w.1 (suc k))) (w.1 k) (w.2 k)) ;
    t3 (x : S) (w : Lim3 x) : L x = (\ k -> (w.1 k).2.2, \ k -> ap (E3 x k) (Tk k x) (\ z -> z.2.2) (p3 x k (w.1 (suc k))) (w.1 k) (w.2 k)) ;

    -- the two sides of the cocycle condition at a stage, and their shifts
    lhs (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) (x : S) (w : E3 x k) : (G x).G =
      (G x).mul (h x (w.2.1, w.2.2)) (h x (w.1, w.2.1)) ;
    rhs (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) (x : S) (w : E3 x k) : (G x).G = h x (w.1, w.2.2) ;
    lhs-shift (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) : (d : Nat) ->
      Id ((x : S) -> E3 x (plus d k) -> (G x).G) (C3.CP.shift d k (lhs k h)) (lhs (plus d k) (C2.CP.shift d k h)) = split {
      zero -> refl (lhs k h) ;
      suc d | r -> apH (C3.pis.f (plus d k)) r } ;
    rhs-shift (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) : (d : Nat) ->
      Id ((x : S) -> E3 x (plus d k) -> (G x).G) (C3.CP.shift d k (rhs k h)) (rhs (plus d k) (C2.CP.shift d k h)) = split {
      zero -> refl (rhs k h) ;
      suc d | r -> apH (C3.pis.f (plus d k)) r } ;
    -- shifting a stage cochain is restricting along the down maps
    shift2 (d k : Nat) (h : (x : S) -> E2 x k -> (G x).G) (x : S) (a b : L x) :
      Id (G x).G (C2.CP.shift d k h x ((zip2 x a b).1 (plus d k))) (h x ((zip2 x a b).1 k)) =
      transH (happly (E2 x (plus d k)) (\ y -> (G x).G) (C2.CP.shift d k h x) (Colim[Tw2.at x].shift d k (h x))
                (C2.shift-at d k h x) ((zip2 x a b).1 (plus d k)))
        (transH (L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].shift-down k (h x) d ((zip2 x a b).1 (plus d k)))
                (apH (h x) (L236.FMaps[E2 x, p2 x, (G x).G, (G x).setG].down-lim k (zip2 x a b) d))) ;

    ------------------------------------------------------------------
    -- a cocycle on the limit is represented by a cocycle at some stage
    module CK (K : Nat) { module C = CechNA[l].CechNA[S, \ x -> Tk K x, inh K, G] ; } ;
    module Cocycles (hL : (x : S) -> Tr.Trunc[L x].carrier) {
      module CL = CechNA[l].CechNA[S, L, hL, G] ;
      module Given (dl : CL.C1) (cdl : CL.Cocycle dl) {
        dhat : Coch2 = \ x w -> dl x (fst2 x w) (snd2 x w) ;
        -- a stage representative of dl
        Rep (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) : U l =
          (x : S) (a b : L x) -> Id (G x).G (dl x a b) (h x (a.1 k, b.1 k)) ;
        rep-of (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) (e : Id Coch2 (Phi2 (C2.CP.inc k h)) dhat) : Rep k h =
          \ x a b -> calc (G x).G {
            dl x a b
              =< symH (transH (apH (\ a1 -> dl x a1 (snd2 x (zip2 x a b))) (fst2-zip x a b)) (apH (dl x a) (snd2-zip x a b))) >
            dhat x (zip2 x a b)
              =< symH (happly (Lim2 x) (\ w -> (G x).G) (Phi2 (C2.CP.inc k h) x) (dhat x)
                   (happly S (\ x1 -> Lim2 x1 -> (G x1).G) (Phi2 (C2.CP.inc k h)) dhat e x) (zip2 x a b)) >
            Phi2 (C2.CP.inc k h) x (zip2 x a b)
              =< phi2-inc k h x (zip2 x a b) >
            h x (a.1 k, b.1 k) } ;
        -- the two sides of the cocycle condition meet after some steps
        module At (k : Nat) (h : (x : S) -> E2 x k -> (G x).G) (r : Rep k h) {
          same3 (x : S) (w : Lim3 x) : Id (G x).G (Phi3 (C3.CP.inc k (lhs k h)) x w) (Phi3 (C3.CP.inc k (rhs k h)) x w) =
            calc (G x).G {
              Phi3 (C3.CP.inc k (lhs k h)) x w =< phi3-inc k (lhs k h) x w >
              (G x).mul (h x ((w.1 k).2.1, (w.1 k).2.2)) (h x ((w.1 k).1, (w.1 k).2.1))
                =< symH (transH (apH (\ z -> (G x).mul z (dl x (t1 x w) (t2 x w))) (r x (t2 x w) (t3 x w)))
                               (apH ((G x).mul (h x ((w.1 k).2.1, (w.1 k).2.2))) (r x (t1 x w) (t2 x w)))) >
              (G x).mul (dl x (t2 x w) (t3 x w)) (dl x (t1 x w) (t2 x w))
                =< cdl x (t1 x w) (t2 x w) (t3 x w) > dl x (t1 x w) (t3 x w)
                =< r x (t1 x w) (t3 x w) > h x ((w.1 k).1, (w.1 k).2.2)
                =< symH (phi3-inc k (rhs k h) x w) > Phi3 (C3.CP.inc k (rhs k h)) x w } ;
          killed : Id C3.CP.colim (C3.CP.inc k (lhs k h)) (C3.CP.inc k (rhs k h)) =
            Eq.injective C3.CP.colim Coch3 Phi3 phi3-equiv (C3.CP.inc k (lhs k h)) (C3.CP.inc k (rhs k h))
              (F.funext S (\ x -> Lim3 x -> (G x).G) (Phi3 (C3.CP.inc k (lhs k h))) (Phi3 (C3.CP.inc k (rhs k h))) (\ x ->
                F.funext (Lim3 x) (\ w -> (G x).G) (Phi3 (C3.CP.inc k (lhs k h)) x) (Phi3 (C3.CP.inc k (rhs k h)) x) (same3 x))) ;
          meet : C3.CP.Rel (k, lhs k h) (k, rhs k h) = C3.CP.effective (k, lhs k h) (k, rhs k h) killed ;
        } ;
        -- at the later stage K = d + k: a cocycle representing dl
        module Later (k d : Nat) (h : (x : S) -> E2 x k -> (G x).G) (r : Rep k h)
          (e : Id ((x : S) -> E3 x (plus d k) -> (G x).G) (C3.CP.shift d k (lhs k h)) (C3.CP.shift d k (rhs k h))) {
          K : Nat = plus d k ;
          h1 : (x : S) -> E2 x K -> (G x).G = C2.CP.shift d k h ;
          hc (x : S) (u v : Tk K x) : (G x).G = h1 x (u, v) ;
          eK : Id ((x : S) -> E3 x K -> (G x).G) (lhs K h1) (rhs K h1) =
            transH (symH (lhs-shift k h d)) (transH e (rhs-shift k h d)) ;
          cocycle : CK[K].C.Cocycle hc = \ x u v w ->
            happly (E3 x K) (\ y -> (G x).G) (lhs K h1 x) (rhs K h1 x)
              (happly S (\ x1 -> E3 x1 K -> (G x1).G) (lhs K h1) (rhs K h1) eK x) (u, v, w) ;
          rep : Rep K h1 = \ x a b -> transH (r x a b) (symH (shift2 d k h x a b)) ;
        } ;
        -- merely: a stage K and a cocycle there whose restriction to L is dl
        Staged : U l = (K : Nat) * (hc : (x : S) -> Tk K x -> Tk K x -> (G x).G) * CK[K].C.Cocycle hc *
          ((x : S) (a b : L x) -> Id (G x).G (dl x a b) (hc x (a.1 K) (b.1 K))) ;
        c : C2.CP.colim = phi2-equiv.sec dhat ;
        Pick-rep (v : (u : C2.CP.Tot) * Id C2.CP.colim (C2.CP.Q.inc u) c) : Rep v.1.1 v.1.2 =
          rep-of v.1.1 v.1.2 (transH (apH Phi2 v.2) (phi2-equiv.sec-eq dhat)) ;
        -- from a stage representative and a meeting of the two sides
        module Pick (v : (u : C2.CP.Tot) * Id C2.CP.colim (C2.CP.Q.inc u) c)
          (m : C3.CP.Meet[(v.1.1, lhs v.1.1 v.1.2), (v.1.1, rhs v.1.1 v.1.2)]) {
          sm : (d : Nat) * Id ((x : S) -> E3 x (plus d v.1.1) -> (G x).G) (C3.CP.shift d v.1.1 (lhs v.1.1 v.1.2)) (C3.CP.shift d v.1.1 (rhs v.1.1 v.1.2)) =
            C3.CP.stage-meet v.1.1 (lhs v.1.1 v.1.2) (rhs v.1.1 v.1.2) m ;
          module LT = Later[v.1.1, sm.1, v.1.2, Pick-rep v, sm.2] ;
          st : Staged = (LT.K, LT.hc, LT.cocycle, LT.rep) ;
        } ;
        staged : Tr.Trunc[Staged].carrier =
          TC.bind ((u : C2.CP.Tot) * Id C2.CP.colim (C2.CP.Q.inc u) c) Staged (\ v ->
            TC.map (C3.CP.Meet[(v.1.1, lhs v.1.1 v.1.2), (v.1.1, rhs v.1.1 v.1.2)]) Staged (\ m -> Pick[v, m].st)
              (At[v.1.1, v.1.2, Pick-rep v].meet))
            (C2.CP.inc-surj c) ;
      } ;
    } ;
  } ;

  -- the towers of Lemma 2.1.7: finite stages with sections
  module Stages (S : U l) (sS : PF.isStone S) (T : S -> U l) (apx : L217.Approx[S, T])
    (G : S -> Grp) (oG : (x : S) -> OD.isODisc (G x).G) {
    hK (K : Nat) (x : S) : Tr.Trunc[apx.Tk K x].carrier =
      TC.map ((x1 : S) -> apx.Tk K x1) (apx.Tk K x) (\ t -> t x) (apx.sections K) ;
    module W = Tower[S, sS, apx.Tk, apx.d, \ k x -> P214.finite-stone (apx.Tk k x) (apx.finite k x), hK, G, oG] ;
    L (x : S) : U l = W.L x ;
    module OnLimit (hL : (x : S) -> Tr.Trunc[L x].carrier) {
      module WC = W.Cocycles[hL] ;
      module CL = WC.CL ;
      module Given (dl : CL.C1) (cdl : CL.Cocycle dl) {
        module WG = WC.Given[dl, cdl] ;
        -- a stage cocycle is trivial by a section (Lemma A.0.1)
        module Trivial (st : WG.Staged) {
          bound (w : (g : W.CK[st.1].C.C0) * W.CK[st.1].C.Bounds st.2.1 g) : (g : CL.C0) * CL.Bounds dl g =
            (\ x a -> w.1 x (a.1 st.1), \ x a b ->
              transH (apH ((G x).mul (w.1 x (b.1 st.1))) (st.2.2.2 x a b)) (w.2 x (a.1 st.1) (b.1 st.1))) ;
          trivial : CL.Trivial dl =
            TC.bind ((x : S) -> apx.Tk st.1 x) ((g : CL.C0) * CL.Bounds dl g) (\ t ->
              TC.map ((g : W.CK[st.1].C.C0) * W.CK[st.1].C.Bounds st.2.1 g) ((g : CL.C0) * CL.Bounds dl g) bound
                (W.CK[st.1].C.lemmaA01 t st.2.1 st.2.2.1)) (apx.sections st.1) ;
        } ;
        result : CL.Trivial dl =
          TC.bind WG.Staged ((g : CL.C0) * CL.Bounds dl g) (\ st -> Trivial[st].trivial) WG.staged ;
      } ;
      h1zero : CL.H1Zero = \ dl cdl -> Given[dl, cdl].result ;
    } ;
  } ;
} ;
