-- CCA Theorem 3.3.2 in the form (C) chosen in CCA-DESIGN.md §5: for X
-- compact Hausdorff (a set with closed equality) and a Stone S ->> X (S x
-- the fibres, Stone), if Ȟ¹(X, S, B) = 0 for every family B of overtly
-- discrete abelian groups over X, then
--     H^(n+1)(X, A) = 0      for all n and all such A
-- (H^(n+1) = 0: (x : X) -> K(A x, n+1) is 0-connected, CCA-DESIGN §4).
--
-- Induction on n, for all A.
--  n = 0: Prop. 3.1.8 (vanishing form) and K(A, 1) in the torsors
--    (Thm325.CohK1).
--  n+1: let alpha : (x : X) -> K(A x, n+2), and 0 -> A -> A^S -> L -> 0
--    (em/ImageGroup, L overtly discrete).  S is a Čech cover (CCA Def.
--    B.0.3): (x : X) -> K(A x ^ S x, n+2) is, by Thm 3.2.5 for each Stone
--    S x, (x : X) (s : S x) -> K(A x, n+2), i.e. sections over the Stone
--    (x : X) * S x, 0-connected by Cor. 3.2.6.  So K i o alpha is merely
--    trivial, and H^(n+1)(X, L) = 0 by induction; by exactness (em/Exact,
--    the H-side of Lemma B.0.4) alpha is merely trivial.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ;
open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open EMMaps[l] ; open AbHom[l] ;
open Torsor[l] ; open Group[l] ; open GTorsor[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ; module OC = OpenClosed[l,l] ;
module OD = ODisc[l] ; module DCh = DependentChoice[l] ;
module H1S = H1Stone[l] ; module T325 = Thm325[l] ;
module EpsM = Eps[l] ; module IG = ImageGroup[l] ; module Ex = Exact[l] ;
module Bj = Bijection[l] ;

module Over (ax : SA.Assumptions) (X : U l) (sX : isSet X) (idc : (x y : X) -> OC.isClosed (Id X x y))
  (S : U l) (sS : PF.isStone S) (q : S -> X) (onto : DCh.Surjective q) {
  Sx (x : X) : U l = Bj.Fibre q x ;
  -- the fibres are Stone (closed in S), as Prop214.fibre-stone
  sSx (x : X) : PF.isStone (Sx x) =
    Thm418[l].Over[ax].thm418 S sS (\ s -> Id X (q s) x) (\ s ->
      StoneClosed[l,l].Over[ax].closed-stone (Id X (q s) x) (sX (q s) x) (idc (q s) x)) ;
  total-stone : PF.isStone ((x : X) * Sx x) = Prop214[l].stone-equiv ((x : X) * Sx x) S (H1S.total-fib S X q) sS ;
  -- the hypothesis: Ȟ¹(X, S, B) = 0 for every overtly discrete B
  Hyp : U l+ = (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) -> CechNA[l].CechNA[X, Sx, onto, \ x -> ab-grp (B x)].H1Zero ;
  Goal (n : Nat) : U l+ = (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) -> isConn (suc (suc zero)) ((x : X) -> KK[B x].K (suc n)) ;

  -- n = 0: Prop. 3.1.8
  goal0 (hyp : Hyp) : Goal zero = \ B oB ->
    T325.Over[ax].CohK1[X, B, H1S.Over[ax].Prop318[X, S, sS, q, onto, \ x -> ab-grp (B x), oB].backward (hyp B oB)].conn ;

  -- S is a Čech cover: (x : X) -> K((B x)^(S x), n+1) is 0-connected
  module Cov (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) (n : Nat) {
    AS (x : X) : Ab = IG.Cech[Sx x, onto x, B x].AT ;
    module E (x : X) { module F = EpsM.Eps[Sx x, \ s -> B x] ; } ;
    eps-eq (x : X) : isEquiv (KK[AS x].K (suc n)) (E[x].F.P (suc n)) (E[x].F.eps (suc n)).1 =
      T325.Over[ax].thm325 (suc n) (Sx x) (sSx x) (\ s -> B x) (\ s -> oB x) ;
    curry : Equiv ((x : X) -> E[x].F.P (suc n)) ((w : (x : X) * Sx x) -> KK[B w.1].K (suc n)) =
      (\ f w -> f w.1 w.2, qinv ((x : X) -> E[x].F.P (suc n)) ((w : (x : X) * Sx x) -> KK[B w.1].K (suc n))
         (\ f w -> f w.1 w.2) (\ g x s -> g (x, s)) (\ g -> refl g) (\ f -> refl f)) ;
    tot : isConn (suc (suc zero)) ((w : (x : X) * Sx x) -> KK[B w.1].K (suc n)) =
      T325.Over[ax].cor326 n ((x : X) * Sx x) total-stone (\ w -> B w.1) (\ w -> oB w.1) ;
    conn : isConn (suc (suc zero)) ((x : X) -> KK[AS x].K (suc n)) =
      Deloop[l].equiv-conn (suc (suc zero)) ((x : X) -> KK[AS x].K (suc n)) ((x : X) -> E[x].F.P (suc n))
        ((\ a x -> (E[x].F.eps (suc n)).1 (a x)),
         PiEquiv[l].pi-equiv X (\ x -> KK[AS x].K (suc n)) (\ x -> E[x].F.P (suc n)) (\ x -> (E[x].F.eps (suc n)).1) eps-eq)
        (Deloop[l].equiv-conn (suc (suc zero)) ((x : X) -> E[x].F.P (suc n)) ((w : (x : X) * Sx x) -> KK[B w.1].K (suc n)) curry tot) ;
  } ;

  -- n+1 from n
  -- the cokernel L = B^S / B and its overt discreteness
  module CX (B : X -> Ab) (x : X) { module C2 = IG.Cech[Sx x, onto x, B x] ; } ;
  odiscL (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A) (x : X) : OD.isODisc (CX[B, x].C2.L).A =
    T325.Over[ax].odiscL (Sx x) (sSx x) (onto x) (B x) (oB x) ;
  -- H^(n+1)(X, L) = 0 gives H^(n+2)(X, B) = 0
  module Step (n : Nat) (B : X -> Ab) (oB : (x : X) -> OD.isODisc (B x).A)
    (cL : isConn (suc (suc zero)) ((x : X) -> KK[CX[B, x].C2.L].K (suc n))) {
    module EX = Ex.Exact[X, B, \ x -> CX[B, x].C2.AT, \ x -> CX[B, x].C2.L, \ x -> CX[B, x].C2.i, \ x -> CX[B, x].C2.p,
      \ x -> CX[B, x].C2.inj, \ x -> CX[B, x].C2.pi0, \ x -> CX[B, x].C2.ex, \ x -> CX[B, x].C2.sur, suc n] ;
    K2 (x : X) : U l = KK[B x].K (suc (suc n)) ;
    pt2 (x : X) : K2 x = KK[B x].pt (suc (suc n)) ;
    module Alpha (alpha : (x : X) -> K2 x) {
      KB (x : X) : U l = KK[CX[B, x].C2.AT].K (suc (suc n)) ;
      ki (x : X) : KB x = (EX.Ki x).1 (alpha x) ;
      z : Tr.Trunc[(x : X) -> Id (KB x) (ki x) (KK[CX[B, x].C2.AT].pt (suc (suc n)))].carrier =
        TC.map (Id ((x : X) -> KB x) ki (\ x -> KK[CX[B, x].C2.AT].pt (suc (suc n))))
          ((x : X) -> Id (KB x) (ki x) (KK[CX[B, x].C2.AT].pt (suc (suc n))))
          (happly X KB ki (\ x -> KK[CX[B, x].C2.AT].pt (suc (suc n))))
          (conn-path zero ((x : X) -> KB x) Cov[B, oB, suc n].conn ki (\ x -> KK[CX[B, x].C2.AT].pt (suc (suc n)))) ;
      result : Tr.Trunc[(x : X) -> Id (K2 x) (alpha x) (pt2 x)].carrier = EX.exact cL alpha z ;
    } ;
    conn : isConn (suc (suc zero)) ((x : X) -> K2 x) =
      (Tr.Trunc[(x : X) -> K2 x].inc pt2, \ a b ->
        (TC.map2 ((x : X) -> Id (K2 x) (a x) (pt2 x)) ((x : X) -> Id (K2 x) (b x) (pt2 x)) (Id ((x : X) -> K2 x) a b)
          (\ p q -> trans ((x : X) -> K2 x) a pt2 b (FL.funext X K2 a pt2 p) (sym ((x : X) -> K2 x) b pt2 (FL.funext X K2 b pt2 q)))
          Alpha[a].result Alpha[b].result, \ u v -> tt)) ;
  } ;

  -- Theorem 3.3.2, form (C)
  thm332 (hyp : Hyp) : (n : Nat) -> Goal n = split {
    zero -> goal0 hyp ;
    suc n | ih -> \ B oB -> Step[n, B, oB, ih (\ x -> CX[B, x].C2.L) (odiscL B oB)].conn } ;

  -- the hypothesis from the abelian Čech complex (stoneseq/CechComplex):
  -- a cocycle here is one there (commutativity), and b = d0 a gives the
  -- bounding g y = - a y
  abelian (B : X -> Ab) (z : CechComplex[l].Cech[X, Sx, B].H1Zero) : CechNA[l].CechNA[X, Sx, onto, \ x -> ab-grp (B x)].H1Zero =
    \ d c -> TC.map ((a : CechComplex[l].Cech[X, Sx, B].C0) * CechComplex[l].Cech[X, Sx, B].Bounds d a)
      ((g : CechNA[l].CechNA[X, Sx, onto, \ x -> ab-grp (B x)].C0) * CechNA[l].CechNA[X, Sx, onto, \ x -> ab-grp (B x)].Bounds d g)
      (\ w -> (\ x y -> (B x).inv (w.1 x y), \ x y0 y1 -> calc (B x).A {
         (B x).add ((B x).inv (w.1 x y1)) (d x y0 y1)
           =< apH ((B x).add ((B x).inv (w.1 x y1))) (w.2 x y0 y1) >
         (B x).add ((B x).inv (w.1 x y1)) ((B x).add (w.1 x y1) ((B x).inv (w.1 x y0)))
           =< symH ((B x).assoc ((B x).inv (w.1 x y1)) (w.1 x y1) ((B x).inv (w.1 x y0))) >
         (B x).add ((B x).add ((B x).inv (w.1 x y1)) (w.1 x y1)) ((B x).inv (w.1 x y0))
           =< apH (\ e -> (B x).add e ((B x).inv (w.1 x y0))) (AbL[B x].invl (w.1 x y1)) >
         (B x).add (B x).o ((B x).inv (w.1 x y0)) =< AbL[B x].unitl ((B x).inv (w.1 x y0)) > (B x).inv (w.1 x y0) }))
      (z d (\ x u v w -> transH ((B x).comm (d x u v) (d x v w)) (c x u v w))) ;
} ;
