-- CCA Theorem 3.3.2 as stated (form (A), CCA-DESIGN.md §5): for X compact
-- Hausdorff, q : S ->> X with S Stone (S x the fibres) and every family B of
-- overtly discrete abelian groups over X, a group isomorphism
--     Phi n B : Hⁿ(X, B) ~ Ȟⁿ(X, S, B),
-- natural in homomorphisms B -> B'.  Hⁿ(X, B) is π₁ of
-- (x : X) -> K(B x, n+1) (em/LES; it is ||(x : X) -> K(B x, n)||₀ through
-- Eps.psi), Ȟⁿ the Čech group of em/CechGroups.
-- Proof, as in the paper, by induction on n for all such B at once.
--   n = 0: Lemma B.0.1 with the group structures (em/CechH0).
--   n+1: for 0 -> A -> E -> L -> 0, E = A^S, L = A^S / A (ImageGroup.Cech;
--   E and L are overtly discrete: Prop. 2.3.9, Thm332.odiscL), the rows
--     Hⁿ(E) -> Hⁿ(L) -> Hⁿ⁺¹(A) -> 0        (em/LES, Lemma B.0.4; Hⁿ⁺¹(E) = 0
--                                            as S is a Čech cover, Thm332.Cov)
--     Ȟⁿ(E) -> Ȟⁿ(L) -> Ȟⁿ⁺¹(A) -> 0        (em/CechLES, Lemmas B.0.5-B.0.7;
--                                            lifts: Thm332C.lifts, Ȟⁿ⁺¹(E) = 0:
--                                            Lemma B.0.2 = CechHigher vanishS)
--   are exact, Phi n E, Phi n L are isomorphisms commuting with p (the
--   induction hypothesis, naturality for p), so the cokernels are
--   isomorphic (em/Coker): Phi (n+1) A (δ y) = δ (Phi n L y).
--   Naturality of Phi (n+1) in h : A -> A' (with Eh, Lh: em/ImageMap): on
--   δ y it is naturality of δ on both sides and of Phi n for Lh (em/CechNat
--   for the Čech side; the H side is the hypothesis NatDelta).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module PF = Profinite[l,l] ; module SA = StoneAxioms[l,l] ; module OC = OpenClosed[l,l] ;
module OD = ODisc[l] ; module DCh = DependentChoice[l] ;
module Bj = Bijection[l] ;
module QG = QGrp[l] ;
module CG = CechGroups[l] ;

module Over (ax : SA.Assumptions) (X : U l) (sX : isSet X) (idc : (x y : X) -> OC.isClosed (Id X x y))
  (S : U l) (sS : PF.isStone S) (q : S -> X) (onto : DCh.Surjective q) {
  module T = Thm332[l].Over[ax, X, sX, idc, S, sS, q, onto] ;
  module T' = Thm332C[l].Over[ax, X, sX, idc, S, sS, q, onto] ;
  ODF (B : X -> Ab) : U l+ = (x : X) -> OD.isODisc (B x).A ;
  -- the groups and the maps
  module HG (n : Nat) (B : X -> Ab) { module E = Eps[l].Eps[X, B] ; module P = PiOne[l].PiOne[E.P (suc n), E.pP (suc n)] ; } ;
  module CH (n : Nat) (B : X -> Ab) { module C = CG.CechGrp[X, T.Sx, B] ; } ;
  module HM (n : Nat) (B B' : X -> Ab) (h : (x : X) -> Hom (B x) (B' x)) {
    module M = PiOne[l].Induced[HG[n, B].E.P (suc n), HG[n, B].E.pP (suc n), HG[n, B'].E.P (suc n), HG[n, B'].E.pP (suc n),
      PiPt[l].PiLoop[X, B, B', h, n].F] ;
  } ;
  module CM (B B' : X -> Ab) (h : (x : X) -> Hom (B x) (B' x)) { module M = CG.CechMap[X, T.Sx, B, B', h] ; } ;
  -- the short exact sequence 0 -> B -> B^S -> L -> 0
  E (B : X -> Ab) (x : X) : Ab = T.CX[B, x].C2.AT ;
  L (B : X -> Ab) (x : X) : Ab = T.CX[B, x].C2.L ;
  oE (B : X -> Ab) (oB : ODF B) (x : X) : OD.isODisc (E B x).A =
    Prop239[l].Over[ax].prop239 (T.Sx x) (T.sSx x) (\ s -> (B x).A) (\ s -> oB x) ;
  oL (B : X -> Ab) (oB : ODF B) : ODF (L B) = T.odiscL B oB ;
  module LH (n : Nat) (B : X -> Ab) {
    module Seq = LES[l].LES[X, B, E B, L B, \ x -> T.CX[B, x].C2.i, \ x -> T.CX[B, x].C2.p, \ x -> T.CX[B, x].C2.inj,
      \ x -> T.CX[B, x].C2.pi0, \ x -> T.CX[B, x].C2.ex, \ x -> T.CX[B, x].C2.sur, n] ;
  } ;
  module LC (n : Nat) (B : X -> Ab) (oB : ODF B) {
    module Seq = CechLES[l].CechLES[X, T.Sx, B, E B, L B, \ x -> T.CX[B, x].C2.i, \ x -> T.CX[B, x].C2.p, \ x -> T.CX[B, x].C2.inj,
      \ x -> T.CX[B, x].C2.pi0, \ x -> T.CX[B, x].C2.ex, \ k phi -> T'.lifts B oB k phi, n] ;
  } ;
  -- the map of short exact sequences induced by h
  module SM (B B' : X -> Ab) (h : (x : X) -> Hom (B x) (B' x)) (x : X) { module M = ImageMap[l].ImageMap[T.Sx x, onto x, B x, B' x, h x] ; } ;

  -- what is proved at each n
  Iso (n : Nat) (B : X -> Ab) : U l = (f : QG.GHom HG[n, B].P.grp CH[n, B].C.H[n].Q.QG.grp) *
    Bj.Injective f.1 * ((y : CH[n, B].C.H[n].Q.QG.grp.G) -> Tr.Trunc[Bj.Fibre f.1 y].carrier) ;
  Natural (n : Nat) (Phi : (B : X -> Ab) -> ODF B -> Iso n B) : U l+ = (B : X -> Ab) (oB : ODF B) (B' : X -> Ab) (oB' : ODF B')
    (h : (x : X) -> Hom (B x) (B' x)) (z : HG[n, B].P.grp.G) ->
    Id CH[n, B'].C.H[n].Q.QG.grp.G ((Phi B' oB').1.1 (HM[n, B, B', h].M.map z)) ((CM[B, B', h].M.hstar n).1 ((Phi B oB).1.1 z)) ;
  Stage (n : Nat) : U l+ = (Phi : (B : X -> Ab) -> ODF B -> Iso n B) * Natural n Phi ;
  -- the hypothesis: δ on the H side is natural (to be discharged by em/)
  NatDelta (n : Nat) : U l+ = (B : X -> Ab) (oB : ODF B) (B' : X -> Ab) (oB' : ODF B') (h : (x : X) -> Hom (B x) (B' x)) (y : HG[n, L B].P.grp.G) ->
    Id HG[suc n, B'].P.grp.G (LH[n, B'].Seq.delta.1 (HM[n, L B, L B', \ x -> SM[B, B', h, x].M.Lh].M.map y))
      (HM[suc n, B, B', h].M.map (LH[n, B].Seq.delta.1 y)) ;

  -- n = 0
  module D0 (B : X -> Ab) { module D = CechH0[l].Degree0[X, T.Sx, onto, B] ; } ;
  base : Stage zero = (\ B oB -> (D0[B].D.hom, D0[B].D.injective, D0[B].D.onto),
    \ B oB B' oB' h z -> CechH0[l].Natural0[X, T.Sx, onto, B, B', h].natural z) ;

  -- n + 1
  module Step (n : Nat) (st : Stage n) (nd : NatDelta n) {
    module K (A : X -> Ab) (oA : ODF A) {
      module H = LH[n, A].Seq ;
      module C = LC[n, A, oA].Seq ;
      sq (x : HG[n, E A].P.grp.G) : Id CH[n, L A].C.H[n].Q.QG.grp.G (C.pstar.1 ((st.1 (E A) (oE A oA)).1.1 x)) ((st.1 (L A) (oL A oA)).1.1 (H.pstar.1 x)) =
        symH (st.2 (E A) (oE A oA) (L A) (oL A oA) (\ x1 -> T.CX[A, x1].C2.p) x) ;
      module CK = Coker[l].Coker[H.HB.grp, H.HC.grp, H.HA.grp, C.GB.H[n].Q.QG.grp, C.GC.H[n].Q.QG.grp, C.GA.H[suc n].Q.QG.grp,
        H.pstar, H.delta, C.pstar, C.delta,
        H.delta-onto (T.Cov[A, oA, n].conn), H.delta-pstar, H.ker-im,
        C.Onto[T'.SH[A].H.vanishS n].onto, C.delta-pstar, C.ker-im,
        (st.1 (E A) (oE A oA)).1, (st.1 (E A) (oE A oA)).2.2, (st.1 (L A) (oL A oA)).1, (st.1 (L A) (oL A oA)).2.1, (st.1 (L A) (oL A oA)).2.2, sq] ;
      iso : Iso (suc n) A = (CK.iso, CK.injective, CK.onto) ;
    } ;
    -- naturality, on δ y
    module NatAt (A : X -> Ab) (oA : ODF A) (A' : X -> Ab) (oA' : ODF A') (h : (x : X) -> Hom (A x) (A' x)) {
      module CN = CechNat[l].CechNat[X, T.Sx, A, E A, L A, \ x -> T.CX[A, x].C2.i, \ x -> T.CX[A, x].C2.p, \ x -> T.CX[A, x].C2.inj,
        \ x -> T.CX[A, x].C2.pi0, \ x -> T.CX[A, x].C2.ex, \ k phi -> T'.lifts A oA k phi,
        A', E A', L A', \ x -> T.CX[A', x].C2.i, \ x -> T.CX[A', x].C2.p, \ x -> T.CX[A', x].C2.inj,
        \ x -> T.CX[A', x].C2.pi0, \ x -> T.CX[A', x].C2.ex, \ k phi -> T'.lifts A' oA' k phi,
        h, \ x -> SM[A, A', h, x].M.Eh, \ x -> SM[A, A', h, x].M.Lh,
        \ x a -> SM[A, A', h, x].M.sqi a, \ x b -> SM[A, A', h, x].M.sqp b, n] ;
      Lh (x : X) : Hom (L A x) (L A' x) = SM[A, A', h, x].M.Lh ;
      on-delta (y : HG[n, L A].P.grp.G) :
        Id CH[suc n, A'].C.H[suc n].Q.QG.grp.G (K[A', oA'].CK.f3 (HM[suc n, A, A', h].M.map (K[A, oA].H.delta.1 y)))
          ((CM[A, A', h].M.hstar (suc n)).1 (K[A, oA].CK.f3 (K[A, oA].H.delta.1 y))) = calc CH[suc n, A'].C.H[suc n].Q.QG.grp.G {
        K[A', oA'].CK.f3 (HM[suc n, A, A', h].M.map (K[A, oA].H.delta.1 y))
          =< apH K[A', oA'].CK.f3 (symH (nd A oA A' oA' h y)) > K[A', oA'].CK.f3 (K[A', oA'].H.delta.1 (HM[n, L A, L A', Lh].M.map y))
          =< K[A', oA'].CK.f3-d (HM[n, L A, L A', Lh].M.map y) > K[A', oA'].C.delta.1 ((st.1 (L A') (oL A' oA')).1.1 (HM[n, L A, L A', Lh].M.map y))
          =< apH K[A', oA'].C.delta.1 (st.2 (L A) (oL A oA) (L A') (oL A' oA') Lh y) > K[A', oA'].C.delta.1 ((CM[L A, L A', Lh].M.hstar n).1 ((st.1 (L A) (oL A oA)).1.1 y))
          =< CN.natural ((st.1 (L A) (oL A oA)).1.1 y) > (CM[A, A', h].M.hstar (suc n)).1 (K[A, oA].C.delta.1 ((st.1 (L A) (oL A oA)).1.1 y))
          =< apH (CM[A, A', h].M.hstar (suc n)).1 (symH (K[A, oA].CK.f3-d y)) > (CM[A, A', h].M.hstar (suc n)).1 (K[A, oA].CK.f3 (K[A, oA].H.delta.1 y)) } ;
      Goal (z : HG[suc n, A].P.grp.G) : U l =
        Id CH[suc n, A'].C.H[suc n].Q.QG.grp.G (K[A', oA'].CK.f3 (HM[suc n, A, A', h].M.map z)) ((CM[A, A', h].M.hstar (suc n)).1 (K[A, oA].CK.f3 z)) ;
      goal-prop (z : HG[suc n, A].P.grp.G) : isProp (Goal z) =
        CH[suc n, A'].C.H[suc n].Q.QG.grp.setG (K[A', oA'].CK.f3 (HM[suc n, A, A', h].M.map z)) ((CM[A, A', h].M.hstar (suc n)).1 (K[A, oA].CK.f3 z)) ;
      at-delta (z : HG[suc n, A].P.grp.G) (w : Bj.Fibre K[A, oA].H.delta.1 z) : Goal z =
        subst HG[suc n, A].P.grp.G Goal (K[A, oA].H.delta.1 w.1) z w.2 (on-delta w.1) ;
      natural (z : HG[suc n, A].P.grp.G) : Goal z =
        TC.rec (Bj.Fibre K[A, oA].H.delta.1 z) @l (Goal z) (goal-prop z) (at-delta z) (K[A, oA].H.delta-onto (T.Cov[A, oA, n].conn) z) ;
    } ;
    next : Stage (suc n) = (\ A oA -> K[A, oA].iso, \ A oA A' oA' h z -> NatAt[A, oA, A', oA', h].natural z) ;
  } ;

  -- Thm 3.3.2 (A), given that δ on the H side is natural
  thm332A (nd : (n : Nat) -> NatDelta n) : (n : Nat) -> Stage n = split {
    zero -> base ;
    suc n | r -> Step[n, r, nd n].next } ;
} ;
