-- The usual finite-fibre hypothesis for ZMT, now derived from formal
-- unramifiedness at a residually discrete local base. The actual quotient
-- E/IE and its R/I scalar map are those of QuotientFibre, not an abstract
-- tensor model. No ZMT principle is used to prove their module finiteness.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (I : RegularIdeal[l].IdealPred[R])
 (propI : (a : R.R) -> Pr.isProp (I.In a)) (proper : Not (I.In R.o))
 (local : (a : R.R) -> Plus (I.In a) (RL[R].unit a))
 (E : Algebras[l].Over[R,setR].Algebra) {
 module K = LocalResidueField[l].Over[R,I,propI,proper,local] ;
 module Q = QuotientFibreBaseChange[l].Over[R,setR,I,propI,E] ;
 module Fibre = Q.Fibre ; module T = Q.PK ;
 module FS = FiniteSpan[l].Over[K.Q.ring,Q.QE.ring,Fibre.iotaI] ;
 module Sums = FiniteIdeal[l].Sums[Q.QE.ring] ;
 Coefficients (d : FS.Data) (e : Q.QE.Carrier) : U l =
  (a : Fin d.1 -> K.Q.Carrier) * Id Q.QE.Carrier e (Sums.lin d.1 d.2.1 (\ i -> Fibre.iotaI.1 (a i))) ;
 convert (d : FS.Data) (e : Q.QE.Carrier) (w : FS.Coordinates d.1 d.2.1 e) : Coefficients d e =
  (w.1,trans (sym w.2)
   (Sums.sum-cong d.1 (\ i -> Q.QE.ring.mul (Fibre.iotaI.1 (w.1 i)) (d.2.1 i))
    (\ i -> Q.QE.ring.mul (d.2.1 i) (Fibre.iotaI.1 (w.1 i)))
    (\ i -> Q.QE.ring.mulC (Fibre.iotaI.1 (w.1 i)) (d.2.1 i)))) ;
 module-finite (d : FS.Data) : Fibre.Finite =
  new QuotientFibre[l].ModuleFinite[K.Q.ring,Q.QE.ring,Fibre.iotaI,d.1,d.2.1,
   \ e -> TC.map (FS.Coordinates d.1 d.2.1 e) (Coefficients d e) (convert d e) (d.2.2 e)] ;
 module Presented (p : Q.PR.Presentation) (ps : Q.PR.Presents p E)
  (unique : FormallyEtale[l].Over[R,setR].Unique E) {
  module P0 = Q.Presented[p,ps] ;
  module Field = UnramifiedFieldFiniteGeneral[l].Over[K.Q.ring,K.Q.set,K.decide,K.nonzero].At[
   Q.algebra,P0.finite-presentation,P0.unramified unique] ;
  finite : Tr.Trunc[Fibre.Finite].carrier = TC.map FS.Data Fibre.Finite module-finite Field.finite ;
 } ;
 theorem (fp : Q.PR.FP E) (unique : FormallyEtale[l].Over[R,setR].Unique E) : Tr.Trunc[Fibre.Finite].carrier =
  TruncationCombinators[l+].rec (Q.PR.Witness E) @l Tr.Trunc[Fibre.Finite].carrier Tr.Trunc[Fibre.Finite].proposition
   (\ p -> Presented[p.1,p.2,unique].finite) fp ;
 elementwise (fp : Q.PR.FP E) (unique : FormallyEtale[l].Over[R,setR].Unique E) :
  Tr.Trunc[FiniteFibreCertificates[l].FiniteFibre[R,I.In,E.ring,E.iota]].carrier =
  Fibre.bridge (theorem fp unique) ;
} ;
