-- The usual quotient-fibre finiteness theorem over the nonreduced local
-- base Z/4 with maximal ideal {0,2}. The empty and one-variable point
-- presentations both feed the constructed residue-field proof.
level l ; open Ring[l] ;
module Z = ZMod4[l] ; module R = ResidueFieldRegression[l] ;
module BP = BasePresentation[l].Over[Z.ring,Z.set] ;
module C = Algebras[l].Over[Z.ring,Z.set] ;
module FE = FormallyEtale[l].Over[Z.ring,Z.set] ;
unique : FE.Unique C.base = \ B N f g eq -> C.ext C.base B f g (\ r -> trans (f.2 r) (sym (g.2 r))) ;
module F = FiniteSpecialFibre[l].Over[Z.ring,Z.set,R.ideal,R.prop,R.proper,R.local,C.base] ;
finite : Truncation[l].Trunc[F.Fibre.Finite].carrier = F.theorem BP.finitely-presented unique ;
elementwise : Truncation[l].Trunc[FiniteFibreCertificates[l].FiniteFibre[Z.ring,R.ideal.In,Z.ring,C.base.iota]].carrier =
 F.elementwise BP.finitely-presented unique ;
module Point = BaseChangeRegression[l].AtPoint[Z.ring,Z.set,q2] ;
point-finite : Truncation[l].Trunc[F.Fibre.Finite].carrier = F.Presented[Point.presentation,Point.presents,unique].finite ;
module Q = F.Q.Presented[Point.presentation,Point.presents] ;
quotient-unramified : FormallyEtale[l].Over[F.K.Q.ring,F.K.Q.set].Unique F.Q.algebra = Q.unramified unique ;
