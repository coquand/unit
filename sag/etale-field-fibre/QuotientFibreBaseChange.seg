-- The actual QuotientFibre E/IE is scalar extension along R -> R/I.
-- Construct its mapping-out universal property, then its mapped finite
-- presentation. Formal unramifiedness transfers to this very quotient,
-- so no isomorphism with an unspecified special-fibre model is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (I : RegularIdeal[l].IdealPred[R])
 (propI : (a : R.R) -> Pr.isProp (I.In a)) (E : Algebras[l].Over[R,setR].Algebra) {
 module Fibre = QuotientFibre[l].Over[R,setR,I,propI,E] ;
 module QR = Fibre.QR ; module QE = Fibre.QE ;
 module BC = MappedPresentation[l].Over[R,QR.ring,setR,QR.set,QR.projection] ;
 module CR = BC.CR ; module CK = BC.CK ; module PR = BC.PR ; module PK = BC.PK ;
 algebra : CK.Algebra = CK.mkAlgebra QE.ring QE.set Fibre.iotaI ;
 projection : CR.Hom E (BC.restrict algebra) = (QE.projection,\ r -> sym (Fibre.iotaI-beta r)) ;
 module To (B : CK.Algebra) {
  module LB = RL[B.ring] ; module SB = FiniteIdeal[l].Sums[B.ring] ;
  forward (h : CK.Hom algebra B) : CR.Hom E (BC.restrict B) =
   CR.compose E (BC.restrict algebra) (BC.restrict B) (BC.restrict-map algebra B h) projection ;
  module Given (f : CR.Hom E (BC.restrict B)) {
   module Sums = ZMTCertificate[l].HomSums[E.ring,B.ring,f.1] ;
   scalar (r : R.R) (hr : I.In r) : Id B.ring.R (f.1.1 (E.iota.1 r)) B.ring.z =
    trans (f.2 r) (trans (ap B.iota.1 (QR.to-zero r hr)) (H.zero QR.ring B.ring B.iota)) ;
   witness (e : E.ring.R) (w : Fibre.W.Wit e) : Id B.ring.R (f.1.1 e) B.ring.z =
    trans (ap f.1.1 w.eq)
     (trans (Sums.lin-natural w.u (\ i -> E.iota.1 (w.a i)) w.w)
      (trans (SB.sum-cong w.u (\ i -> B.ring.mul (f.1.1 (E.iota.1 (w.a i))) (f.1.1 (w.w i))) (\ i -> B.ring.z)
       (\ i -> trans (ap (\ a -> B.ring.mul a (f.1.1 (w.w i))) (scalar (w.a i) (w.ina i)))
        (LB.zero-mul (f.1.1 (w.w i))))) (SB.sum-zero w.u))) ;
   killed (e : E.ring.R) (he : Fibre.InIE e) : Id B.ring.R (f.1.1 e) B.ring.z =
    TC.rec (Fibre.W.Wit e) @l (Id B.ring.R (f.1.1 e) B.ring.z) (B.set _ _) (witness e) he ;
   module D = QuotientRingDescent[l].Over[E.ring,Fibre.IE,Fibre.propIE,B.ring,B.set,f.1,killed] ;
   scalars : (r : QR.Carrier) -> Id B.ring.R (D.hom.1 (Fibre.iotaI.1 r)) (B.iota.1 r) =
    QR.Q.induction @l (\ r -> Id B.ring.R (D.hom.1 (Fibre.iotaI.1 r)) (B.iota.1 r)) (\ r -> B.set _ _)
     (\ r -> trans (ap D.hom.1 (Fibre.iotaI-beta r)) (trans (D.beta (E.iota.1 r)) (f.2 r))) ;
   arrow : CK.Hom algebra B = (D.hom,scalars) ;
  } ;
  backward (f : CR.Hom E (BC.restrict B)) : CK.Hom algebra B = Given[f].arrow ;
  beta (f : CR.Hom E (BC.restrict B)) (e : E.ring.R) :
   Id B.ring.R ((backward f).1.1 (QE.include e)) (f.1.1 e) = Given[f].D.beta e ;
  fb (f : CR.Hom E (BC.restrict B)) : Id (CR.Hom E (BC.restrict B)) (forward (backward f)) f =
   CR.ext E (BC.restrict B) _ f (beta f) ;
  bf (h : CK.Hom algebra B) : Id (CK.Hom algebra B) (backward (forward h)) h =
   CK.ext algebra B _ h
    (QE.Q.induction @l (\ e -> Id B.ring.R ((backward (forward h)).1.1 e) (h.1.1 e))
     (\ e -> B.set _ _) (beta (forward h))) ;
  universal : Pr.isEquiv (CK.Hom algebra B) (CR.Hom E (BC.restrict B)) forward =
   Pr.qinv _ _ forward backward fb bf ;
 } ;
 module Presented (p : PR.Presentation) (ps : PR.Presents p E) {
  mapped : PK.Presentation = BC.presentation p ;
  solution : PK.Solutions mapped algebra =
   BC.solution-forward p algebra (PR.canonical p E ps.1 (BC.restrict algebra) projection) ;
  module Target (B : CK.Algebra) {
   module QB = To[B] ;
   solution-R (s : PK.Solutions mapped B) : PR.Solutions p (BC.restrict B) = BC.solution-backward p B s ;
   original (s : PK.Solutions mapped B) : CR.Hom E (BC.restrict B) = (ps.2 (BC.restrict B)).sec (solution-R s) ;
   extend (s : PK.Solutions mapped B) : CK.Hom algebra B = QB.backward (original s) ;
   forward : CK.Hom algebra B -> PK.Solutions mapped B = PK.canonical mapped algebra solution B ;
   original-beta (s : PK.Solutions mapped B) (i : Fin p.1) :
    Id B.ring.R ((original s).1.1 (ps.1.1 i)) (s.1 i) =
    ap (\ w -> w.1 i) ((ps.2 (BC.restrict B)).sec-eq (solution-R s)) ;
   fb (s : PK.Solutions mapped B) : Id (PK.Solutions mapped B) (forward (extend s)) s =
    PK.solutions-ext mapped B _ s (\ i -> trans (QB.beta (original s) (ps.1.1 i)) (original-beta s i)) ;
   original-forward (h : CK.Hom algebra B) :
    Id (CR.Hom E (BC.restrict B)) (original (forward h)) (QB.forward h) =
    Equivalences[l].injective (CR.Hom E (BC.restrict B)) (PR.Solutions p (BC.restrict B))
     (PR.canonical p E ps.1 (BC.restrict B)) (ps.2 (BC.restrict B)) _ _
     (PR.solutions-ext p (BC.restrict B) _ _ (original-beta (forward h))) ;
   bf (h : CK.Hom algebra B) : Id (CK.Hom algebra B) (extend (forward h)) h =
    trans (ap QB.backward (original-forward h)) (QB.bf h) ;
   universal : Pr.isEquiv (CK.Hom algebra B) (PK.Solutions mapped B) forward =
    Pr.qinv _ _ forward extend fb bf ;
  } ;
  presents : PK.Presents mapped algebra = (solution,\ B -> Target[B].universal) ;
  finite-presentation : PK.FP algebra = Truncation[l+].Trunc[PK.Witness algebra].inc (mapped,presents) ;
  unramified (unique : FormallyEtale[l].Over[R,setR].Unique E) : FormallyEtale[l].Over[QR.ring,QR.set].Unique algebra =
   UnramifiedBaseChange[l].Over[R,QR.ring,setR,QR.set,QR.projection].At[E,p,ps,algebra,presents,unique].theorem ;
 } ;
} ;
