-- A ring map killing an ideal descends to the existing effective quotient.
-- The map and its ring laws are constructed by quotient elimination.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (I : RegularIdeal[l].IdealPred[A])
 (propI : (a : A.R) -> Pr.isProp (I.In a)) (B : CRing) (setB : Pr.isSet B.R)
 (h : H.Hom A B) (killed : (a : A.R) -> I.In a -> Id B.R (h.1 a) B.z) {
 module Q = QuotientRing[l].Over[A,I,propI] ; module UQ = FormallyEtale[l].Units[B,setB] ;
 respects (a b : A.R) (eq : Q.Rel a b) : Id B.R (h.1 a) (h.1 b) =
  UQ.sub-zero (h.1 a) (h.1 b)
   (trans (sym (trans (h.2.2.1 a (A.neg b)) (ap (B.add (h.1 a)) (H.negation A B h b))))
    (killed (A.add a (A.neg b)) eq)) ;
 module D = Q.Q.Descend[B.R,setB,h.1,respects] ;
 one : Id B.R (D.map Q.oneQ) B.o = trans (D.beta A.o) h.2.1 ;
 addition : (a b : Q.Carrier) -> Id B.R (D.map (Q.addQ a b)) (B.add (D.map a) (D.map b)) =
  Q.forall2 (\ a b -> Id B.R (D.map (Q.addQ a b)) (B.add (D.map a) (D.map b))) (\ a b -> setB _ _)
   (\ a b -> trans (ap D.map (Q.Add.beta a b))
    (trans (D.beta (A.add a b))
     (trans (h.2.2.1 a b) (sym (Ps.cong2 B.R B.add _ _ _ _ (D.beta a) (D.beta b)))))) ;
 multiplication : (a b : Q.Carrier) -> Id B.R (D.map (Q.mulQ a b)) (B.mul (D.map a) (D.map b)) =
  Q.forall2 (\ a b -> Id B.R (D.map (Q.mulQ a b)) (B.mul (D.map a) (D.map b))) (\ a b -> setB _ _)
   (\ a b -> trans (ap D.map (Q.Multiply.beta a b))
    (trans (D.beta (A.mul a b))
     (trans (h.2.2.2 a b) (sym (Ps.cong2 B.R B.mul _ _ _ _ (D.beta a) (D.beta b)))))) ;
 hom : H.Hom Q.ring B = (D.map,one,addition,multiplication) ;
 beta (a : A.R) : Id B.R (hom.1 (Q.include a)) (h.1 a) = D.beta a ;
} ;
