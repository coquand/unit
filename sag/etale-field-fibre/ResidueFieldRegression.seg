-- The actual residue field of the nonreduced local ring Z/4.
-- Its maximal ideal is defined by 2*a=0, i.e. exactly {0,2}.
level l ; open Ring[l] ;
module Z = ZMod4[l] ; module Pr = Prelude[l] ; module L = RL[Z.ring] ;
inside (a : Z.ring.R) : U l = Id Z.ring.R (Z.ring.mul q2 a) q0 ;
prop (a : Z.ring.R) : Pr.isProp (inside a) = Z.set _ q0 ;
addition (a b : Z.ring.R) (ha : inside a) (hb : inside b) : inside (Z.ring.add a b) =
 trans (Z.ring.dist q2 a b) (trans (Presentations[l].cong2 Z.ring.R Z.ring.add _ _ _ _ ha hb) (refl q0)) ;
multiply (b a : Z.ring.R) (ha : inside a) : inside (Z.ring.mul b a) =
 trans (L.mul-swap q2 b a) (trans (ap (Z.ring.mul b) ha) (L.mul-zero b)) ;
ideal : RegularIdeal[l].IdealPred[Z.ring] = new RegularIdeal[l].IdealPred[Z.ring,inside,refl q0,addition,multiply] ;
proper : Not (inside q1) = \ eq -> subst (Z.code q2) eq tt ;
local : (a : Z.ring.R) -> Plus (inside a) (L.unit a) = split {
 q0 -> inl (refl q0) ; q1 -> inr (q1,refl q1) ; q2 -> inl (refl q0) ; q3 -> inr (q3,refl q1) } ;
module Field = LocalResidueField[l].Over[Z.ring,ideal,prop,proper,local] ;
two-zero : Id Field.Q.Carrier (Field.Q.include q2) Field.Q.zeroQ = Field.Q.to-zero q2 (refl q0) ;
nonzero : Not (Id Field.Q.Carrier Field.Q.oneQ Field.Q.zeroQ) = Field.nonzero ;
decide (x : Field.Q.Carrier) : Field.Decision x = Field.decide x ;
