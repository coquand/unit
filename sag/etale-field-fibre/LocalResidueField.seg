-- The quotient of a residually discrete local ring by its proper maximal
-- ideal is an actual discrete nonzero field. The zero-or-unit decision
-- descends because its alternatives are propositions and disjoint in
-- the nonzero quotient; no representatives are globally chosen.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (I : RegularIdeal[l].IdealPred[R])
 (propI : (a : R.R) -> Pr.isProp (I.In a))
 (proper : Not (I.In R.o))
 (local : (a : R.R) -> Plus (I.In a) (RL[R].unit a)) {
 module Q = QuotientRing[l].Over[R,I,propI] ;
 module L = RL[Q.ring] ; module Units = FormallyEtale[l].Units[Q.ring,Q.set] ;
 nonzero : Not (Id Q.Carrier Q.oneQ Q.zeroQ) = \ eq -> proper (Q.kernel R.o eq) ;
 Decision (x : Q.Carrier) : U l = Plus (Id Q.Carrier x Q.zeroQ) (L.unit x) ;
 incompatible (x : Q.Carrier) (zero : Id Q.Carrier x Q.zeroQ) (u : L.unit x) : Empty =
  nonzero (trans (sym u.2) (trans (ap (\ y -> Q.ring.mul y u.1) zero) (L.zero-mul u.1))) ;
 decision-prop (x : Q.Carrier) : Pr.isProp (Decision x) = split {
  inl p -> split {
   inl q -> ap (\ r -> inl r) (Q.set x Q.zeroQ p q) ;
   inr u -> efq (incompatible x p u) } ;
  inr u -> split {
   inl p -> efq (incompatible x p u) ;
   inr v -> ap (\ w -> inr w) (Units.unit-prop x u v) } } ;
 from-local (a : R.R) : Plus (I.In a) (RL[R].unit a) -> Decision (Q.include a) = split {
  inl ha -> inl (Q.to-zero a ha) ;
  inr u -> inr (FormallyEtale[l].unit-map R Q.ring Q.projection a u) } ;
 decide : (x : Q.Carrier) -> Decision x =
  Q.Q.induction @l Decision decision-prop (\ a -> from-local a (local a)) ;
} ;
