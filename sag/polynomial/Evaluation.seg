-- Evaluation in any commutative target ring; no SQC.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Evaluate (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R)
 (hom : RingHom[l].Hom A B) (t : B.R) {
 open B ; open RL[B] ;
 module AP = Poly[l].PolyR[A] ;
 P : U l = AP.P ;
 module AM = Mul[l].MulR[A] ;
 module AX = PolynomialRing[l].Extension[A,setA] ;
 zero-map : Id R (hom.1 A.z) z = RingHom[l].zero A B hom ;
 E : AP.P -> R = split { nil -> z ; cons a p | ih -> add (hom.1 a) (mul t ih) } ;
 all-zero : (p : AP.P) -> AP.peq p nil -> Id R (E p) z = split {
  nil -> \ h -> refl z ;
  cons a p | ih -> \ h -> trans (ap (\ u -> add u (mul t (E p))) (trans (ap hom.1 (h zero)) zero-map))
    (trans (ap (\ u -> add z (mul t u)) (ih (\ k -> h (suc k))))
      (trans (ap (add z) (mul-zero t)) (addZ z))) } ;
 e-resp : (p q : AP.P) -> AP.peq p q -> Id R (E p) (E q) = split {
  nil -> \ q h -> sym (all-zero q (\ k -> sym (h k))) ;
  cons a p | ih -> split {
   nil -> \ h -> all-zero (cons a p) h ;
   cons b q -> \ h -> trans (ap (\ u -> add u (mul t (E p))) (ap hom.1 (h zero)))
     (ap (\ u -> add (hom.1 b) (mul t u)) (ih q (\ k -> h (suc k)))) } } ;
    e-add : (p q : AP.P) -> Id R (E (AM.addP p q)) (add (E p) (E q)) = split {
      nil -> \ q -> sym (zl (E q)) ;
      cons a p | r -> split {
        nil -> sym (addZ (E (cons a p))) ;
        cons b q -> calc R {
          add (hom.1 (A.add a b)) (mul t (E (AM.addP p q)))
            =< ap (\ u -> add u (mul t (E (AM.addP p q)))) (hom.2.2.1 a b)
            > add (add (hom.1 a) (hom.1 b)) (mul t (E (AM.addP p q)))
            =< ap (\ u -> add (add (hom.1 a) (hom.1 b)) (mul t u)) (r q)
            > add (add (hom.1 a) (hom.1 b)) (mul t (add (E p) (E q)))
            =< ap (add (add (hom.1 a) (hom.1 b))) (dist t (E p) (E q))
            > add (add (hom.1 a) (hom.1 b)) (add (mul t (E p)) (mul t (E q)))
            =< swap (hom.1 a) (hom.1 b) (mul t (E p)) (mul t (E q))
            > add (add (hom.1 a) (mul t (E p))) (add (hom.1 b) (mul t (E q))) } } } ;

    e-scal (b : A.R) : (p : AP.P) -> Id R (E (AM.scal b p)) (mul (hom.1 b) (E p)) = split {
      nil -> sym (mul-zero (hom.1 b)) ;
      cons a p | r -> calc R {
        add (hom.1 (A.mul b a)) (mul t (E (AM.scal b p)))
          =< ap (\ u -> add u (mul t (E (AM.scal b p)))) (hom.2.2.2 b a)
          > add (mul (hom.1 b) (hom.1 a)) (mul t (E (AM.scal b p)))
          =< ap (\ u -> add (mul (hom.1 b) (hom.1 a)) (mul t u)) r
          > add (mul (hom.1 b) (hom.1 a)) (mul t (mul (hom.1 b) (E p)))
          =< ap (add (mul (hom.1 b) (hom.1 a))) (mul-swap t (hom.1 b) (E p))
          > add (mul (hom.1 b) (hom.1 a)) (mul (hom.1 b) (mul t (E p)))
          =< sym (dist (hom.1 b) (hom.1 a) (mul t (E p))) > mul (hom.1 b) (E (cons a p)) } } ;

    e-mul (p : AP.P) : (q : AP.P) -> Id R (E (AM.pmul p q)) (mul (E p) (E q)) = split {
      nil -> sym (mul-zero (E p)) ;
      cons b q | r -> calc R {
        E (AM.addP (AM.scal b p) (cons A.z (AM.pmul p q)))
          =< e-add (AM.scal b p) (cons A.z (AM.pmul p q))
          > add (E (AM.scal b p)) (add (hom.1 A.z) (mul t (E (AM.pmul p q))))
          =< ap (\ u -> add u (add (hom.1 A.z) (mul t (E (AM.pmul p q))))) (e-scal b p)
          > add (mul (hom.1 b) (E p)) (add (hom.1 A.z) (mul t (E (AM.pmul p q))))
          =< ap (\ u -> add (mul (hom.1 b) (E p)) (add u (mul t (E (AM.pmul p q))))) zero-map
          > add (mul (hom.1 b) (E p)) (add z (mul t (E (AM.pmul p q))))
          =< ap (add (mul (hom.1 b) (E p))) (zl (mul t (E (AM.pmul p q))))
          > add (mul (hom.1 b) (E p)) (mul t (E (AM.pmul p q)))
          =< ap (\ u -> add (mul (hom.1 b) (E p)) (mul t u)) r
          > add (mul (hom.1 b) (E p)) (mul t (mul (E p) (E q)))
          =< ap (add (mul (hom.1 b) (E p))) (mul-swap t (E p) (E q))
          > add (mul (hom.1 b) (E p)) (mul (E p) (mul t (E q)))
          =< ap (\ u -> add u (mul (E p) (mul t (E q)))) (mulC (hom.1 b) (E p))
          > add (mul (E p) (hom.1 b)) (mul (E p) (mul t (E q)))
          =< sym (dist (E p) (hom.1 b) (mul t (E q))) > mul (E p) (E (cons b q)) } } ;
 module D = AX.Q.Descend[R,setB,E,e-resp] ;
 evaluate : AX.Carrier -> R = D.map ;
 raw-constant (a : A.R) : Id R (E (cons a nil)) (hom.1 a) = add-mulzero (hom.1 a) t ;
 on-constant (a : A.R) : Id R (evaluate (AX.constant a)) (hom.1 a) =
   trans (D.beta (cons a nil)) (raw-constant a) ;
 raw-variable : Id R (E AX.T) t =
   trans (ap (\ u -> add u (mul t (E (cons A.o nil)))) zero-map)
    (trans (zl (mul t (E (cons A.o nil))))
      (trans (ap (mul t) (trans (raw-constant A.o) hom.2.1)) (mulO t))) ;
 on-variable : Id R (evaluate AX.variable) t = trans (D.beta AX.T) raw-variable ;
 preserves-add : (p q : AX.Carrier) -> Id R (evaluate (AX.addQ p q)) (add (evaluate p) (evaluate q)) =
   AX.forall2 (\ p q -> Id R (evaluate (AX.addQ p q)) (add (evaluate p) (evaluate q))) (\ p q -> setB _ _)
    (\ p q -> calc R { evaluate (AX.addQ (AX.include p) (AX.include q))
      =< ap evaluate (AX.Add.beta p q) > evaluate (AX.include (AM.addP p q))
      =< D.beta (AM.addP p q) > E (AM.addP p q)
      =< e-add p q > add (E p) (E q)
      =< ap (\ u -> add u (E q)) (sym (D.beta p)) > add (evaluate (AX.include p)) (E q)
      =< ap (add (evaluate (AX.include p))) (sym (D.beta q)) > add (evaluate (AX.include p)) (evaluate (AX.include q)) }) ;
 preserves-mul : (p q : AX.Carrier) -> Id R (evaluate (AX.mulQ p q)) (mul (evaluate p) (evaluate q)) =
   AX.forall2 (\ p q -> Id R (evaluate (AX.mulQ p q)) (mul (evaluate p) (evaluate q))) (\ p q -> setB _ _)
    (\ p q -> calc R { evaluate (AX.mulQ (AX.include p) (AX.include q))
      =< ap evaluate (AX.Multiply.beta p q) > evaluate (AX.include (AM.pmul p q))
      =< D.beta (AM.pmul p q) > E (AM.pmul p q)
      =< e-mul p q > mul (E p) (E q)
      =< ap (\ u -> mul u (E q)) (sym (D.beta p)) > mul (evaluate (AX.include p)) (E q)
      =< ap (mul (evaluate (AX.include p))) (sym (D.beta q)) > mul (evaluate (AX.include p)) (evaluate (AX.include q)) }) ;
 extension : RingHom[l].Hom AX.ring B =
   (evaluate,trans (on-constant A.o) hom.2.1,preserves-add,preserves-mul) ;
} ;
