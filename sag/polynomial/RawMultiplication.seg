level l ; open Ring[l] ; open Poly[l] ; open Mul[l] ;
module Laws (A : CRing) {
 open A ; open RL[A] ; open PolyR[A] ; open MulR[A] ; open RawLaws[l].Laws[A] ;
 cons-cong (a b : R) (p q : P) (h : Id R a b) (j : peq p q) : peq (cons a p) (cons b q) = split {
   zero -> h ; suc k -> j k } ;
 mul-cong-left (p p' : P) (h : peq p p') : (q : P) -> peq (pmul p q) (pmul p' q) = split {
   nil -> rr nil ;
   cons b q | ih -> add-cong _ _ _ _ (scal-cong b p p' h) (shift-cong _ _ ih) } ;
 mul-add-left (p q : P) : (r : P) -> peq (pmul (addP p q) r) (addP (pmul p r) (pmul q r)) = split {
   nil -> rr nil ;
   cons b r | ih -> eq _ _ _
    (add-cong _ _ _ _ (scal-add b p q) (shift-cong _ _ ih))
    (eq _ _ _ (add-cong _ _ _ _ (rr (addP (scal b p) (scal b q))) (shift-add (pmul p r) (pmul q r)))
      (add-swap (scal b p) (scal b q) (shift (pmul p r)) (shift (pmul q r)))) } ;
 mul-scal-left (a : R) (p : P) : (q : P) -> peq (pmul (scal a p) q) (scal a (pmul p q)) = split {
   nil -> rr nil ;
   cons b q | ih -> eq _ _ _
    (add-cong _ _ _ _ (scal-swap b a p) (shift-cong _ _ ih))
    (eq _ _ _ (add-cong _ _ _ _ (rr (scal a (scal b p))) (peq-sym _ _ (scal-shift a (pmul p q))))
      (peq-sym _ _ (scal-add a (scal b p) (shift (pmul p q))))) } ;
 mul-shift-left (p : P) : (q : P) -> peq (pmul (shift p) q) (shift (pmul p q)) = split {
   nil -> peq-sym _ _ cz ;
   cons b q | ih -> eq _ _ _
    (add-cong _ _ _ _ (scal-shift b p) (shift-cong _ _ ih))
    (peq-sym _ _ (shift-add (scal b p) (shift (pmul p q)))) } ;
 mul-single-left (a : R) : (q : P) -> peq (pmul (constantP a) q) (scal a q) = split {
   nil -> rr nil ;
   cons b q | ih -> eq _ _ _
    (add-cong _ _ _ _ (rr (constantP (mul b a))) (shift-cong _ _ ih))
    (eq _ _ _ (single-shift (mul b a) (scal a q))
      (cons-cong (mul b a) (mul a b) _ _ (mulC b a) (rr (scal a q)))) } ;
 mul-cons-left (a : R) (p q : P) : peq (pmul (cons a p) q) (addP (scal a q) (shift (pmul p q))) =
   eq _ _ _ (mul-cong-left (cons a p) (addP (constantP a) (shift p)) (peq-sym _ _ (single-shift a p)) q)
    (eq _ _ _ (mul-add-left (constantP a) (shift p) q)
      (add-cong _ _ _ _ (mul-single-left a q) (mul-shift-left p q))) ;
 mul-zero-left : (q : P) -> peq (pmul nil q) nil = split {
   nil -> rr nil ; cons b q | ih -> eq _ _ _ (shift-cong _ _ ih) cz } ;
 mul-comm (p : P) : (q : P) -> peq (pmul p q) (pmul q p) = split {
   nil -> peq-sym _ _ (mul-zero-left p) ;
   cons b q | ih -> eq _ _ _ (add-cong _ _ _ _ (rr (scal b p)) (shift-cong _ _ ih))
      (peq-sym _ _ (mul-cons-left b q p)) } ;
 mul-cong (p p' q q' : P) (h : peq p p') (j : peq q q') : peq (pmul p q) (pmul p' q') =
   eq _ _ _ (mul-cong-left p p' h q)
    (eq _ _ _ (mul-comm p' q)
      (eq _ _ _ (mul-cong-left q q' j p') (mul-comm q' p'))) ;
 mul-add-right (p q r : P) : peq (pmul p (addP q r)) (addP (pmul p q) (pmul p r)) =
   eq _ _ _ (mul-comm p (addP q r))
    (eq _ _ _ (mul-add-left q r p) (add-cong _ _ _ _ (mul-comm q p) (mul-comm r p))) ;
 mul-scal-right (a : R) (p q : P) : peq (pmul p (scal a q)) (scal a (pmul p q)) =
   eq _ _ _ (mul-comm p (scal a q))
    (eq _ _ _ (mul-scal-left a q p) (scal-cong a _ _ (mul-comm q p))) ;
 mul-shift-right (p q : P) : peq (pmul p (shift q)) (shift (pmul p q)) =
   eq _ _ _ (mul-comm p (shift q))
    (eq _ _ _ (mul-shift-left q p) (shift-cong _ _ (mul-comm q p))) ;
 mul-assoc (p q : P) : (r : P) -> peq (pmul p (pmul q r)) (pmul (pmul p q) r) = split {
   nil -> rr nil ;
   cons c r | ih -> eq _ _ _ (mul-add-right p (scal c q) (shift (pmul q r)))
    (eq _ _ _ (add-cong _ _ _ _ (mul-scal-right c p q) (mul-shift-right p (pmul q r)))
      (add-cong _ _ _ _ (rr (scal c (pmul p q))) (shift-cong _ _ ih))) } ;
 mul-one (p : P) : peq (pmul p (constantP o)) p =
   eq _ _ _ (add-cong _ _ _ _ (scal-one p) cz) (add-zero p) ;
} ;
