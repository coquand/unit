-- Ring laws for the existing coefficient lists, before taking a quotient.
level l ; open Ring[l] ; open Poly[l] ; open Mul[l] ;
module Laws (A : CRing) {
 open A ; open RL[A] ; open PolyR[A] ; open MulR[A] ;
 rr (p : P) : peq p p = \ k -> refl (coef p k) ;
 eq (p q r : P) (h : peq p q) (j : peq q r) : peq p r = peq-trans p q r h j ;
 shift (p : P) : P = cons z p ;
 constantP (a : R) : P = cons a nil ;
 shift-cong (p q : P) (h : peq p q) : peq (shift p) (shift q) = consz-peq p q h ;
 add-cong (p p' q q' : P) (h : peq p p') (j : peq q q') : peq (addP p q) (addP p' q') = \ k ->
   trans (coef-addP p q k) (trans (ap (\ a -> add a (coef q k)) (h k))
    (trans (ap (add (coef p' k)) (j k)) (sym (coef-addP p' q' k)))) ;
 scal-cong (a : R) (p q : P) (h : peq p q) : peq (scal a p) (scal a q) = \ k ->
   trans (coef-scal a p k) (trans (ap (mul a) (h k)) (sym (coef-scal a q k))) ;
 scalar-cong (a b : R) (h : Id R a b) (p : P) : peq (scal a p) (scal b p) = \ k ->
   trans (coef-scal a p k) (trans (ap (\ c -> mul c (coef p k)) h) (sym (coef-scal b p k))) ;
 add-assoc (p q r : P) : peq (addP p (addP q r)) (addP (addP p q) r) = \ k ->
   trans (coef-addP p (addP q r) k)
    (trans (ap (add (coef p k)) (coef-addP q r k))
     (trans (addA (coef p k) (coef q k) (coef r k))
      (trans (ap (\ a -> add a (coef r k)) (sym (coef-addP p q k)))
       (sym (coef-addP (addP p q) r k))))) ;
 add-comm (p q : P) : peq (addP p q) (addP q p) = \ k ->
   trans (coef-addP p q k) (trans (addC (coef p k) (coef q k)) (sym (coef-addP q p k))) ;
 add-zero (p : P) : peq (addP p nil) p = \ k -> trans (coef-addP p nil k) (addZ (coef p k)) ;
 add-swap (p q r s : P) : peq (addP (addP p q) (addP r s)) (addP (addP p r) (addP q s)) = \ k ->
   calc R { coef (addP (addP p q) (addP r s)) k
    =< coef-addP (addP p q) (addP r s) k > add (coef (addP p q) k) (coef (addP r s) k)
    =< ap (\ a -> add a (coef (addP r s) k)) (coef-addP p q k) > add (add (coef p k) (coef q k)) (coef (addP r s) k)
    =< ap (add (add (coef p k) (coef q k))) (coef-addP r s k) > add (add (coef p k) (coef q k)) (add (coef r k) (coef s k))
    =< swap (coef p k) (coef q k) (coef r k) (coef s k) > add (add (coef p k) (coef r k)) (add (coef q k) (coef s k))
    =< ap (\ a -> add a (add (coef q k) (coef s k))) (sym (coef-addP p r k)) > add (coef (addP p r) k) (add (coef q k) (coef s k))
    =< ap (add (coef (addP p r) k)) (sym (coef-addP q s k)) > add (coef (addP p r) k) (coef (addP q s) k)
    =< sym (coef-addP (addP p r) (addP q s) k) > coef (addP (addP p r) (addP q s)) k } ;
 scal-add (a : R) (p q : P) : peq (scal a (addP p q)) (addP (scal a p) (scal a q)) = \ k ->
   calc R { coef (scal a (addP p q)) k
    =< coef-scal a (addP p q) k > mul a (coef (addP p q) k)
    =< ap (mul a) (coef-addP p q k) > mul a (add (coef p k) (coef q k))
    =< dist a (coef p k) (coef q k) > add (mul a (coef p k)) (mul a (coef q k))
    =< ap (\ b -> add b (mul a (coef q k))) (sym (coef-scal a p k)) > add (coef (scal a p) k) (mul a (coef q k))
    =< ap (add (coef (scal a p) k)) (sym (coef-scal a q k)) > add (coef (scal a p) k) (coef (scal a q) k)
    =< sym (coef-addP (scal a p) (scal a q) k) > coef (addP (scal a p) (scal a q)) k } ;
 scal-scal (a b : R) (p : P) : peq (scal a (scal b p)) (scal (mul a b) p) = \ k ->
   trans (coef-scal a (scal b p) k)
    (trans (ap (mul a) (coef-scal b p k)) (trans (mulA a b (coef p k)) (sym (coef-scal (mul a b) p k)))) ;
 scal-swap (a b : R) (p : P) : peq (scal a (scal b p)) (scal b (scal a p)) =
   eq _ _ _ (scal-scal a b p)
    (eq _ _ _ (scalar-cong (mul a b) (mul b a) (mulC a b) p) (peq-sym _ _ (scal-scal b a p))) ;
 scal-one (p : P) : peq (scal o p) p = \ k ->
   trans (coef-scal o p k) (trans (mulC o (coef p k)) (mulO (coef p k))) ;
 scal-zero (p : P) : peq (scal z p) nil = \ k -> trans (coef-scal z p k) (zero-mul (coef p k)) ;
 scal-shift (a : R) (p : P) : peq (scal a (shift p)) (shift (scal a p)) = split {
   zero -> mul-zero a ; suc k -> refl (coef (scal a p) k) } ;
 shift-add (p q : P) : peq (shift (addP p q)) (addP (shift p) (shift q)) = split {
   zero -> sym (addZ z) ; suc k -> refl (coef (addP p q) k) } ;
 single-shift (a : R) (p : P) : peq (addP (constantP a) (shift p)) (cons a p) = split {
   zero -> addZ a ; suc k -> refl (coef p k) } ;
 scal-single (a b : R) : peq (scal a (constantP b)) (constantP (mul a b)) = rr (constantP (mul a b)) ;
 negP (p : P) : P = scal (neg o) p ;
 neg-coef (p : P) (k : Nat) : Id R (coef (negP p) k) (neg (coef p k)) =
   trans (coef-scal (neg o) p k)
    (trans (mulC (neg o) (coef p k)) (trans (mul-neg (coef p k) o) (ap neg (mulO (coef p k))))) ;
 add-neg (p : P) : peq (addP p (negP p)) nil = \ k ->
   trans (coef-addP p (negP p) k) (trans (ap (add (coef p k)) (neg-coef p k)) (addN (coef p k))) ;
} ;
