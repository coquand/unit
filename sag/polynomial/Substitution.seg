-- A use of the universal property with a polynomial ring as target.
-- Substitution is a ring homomorphism, with identity and composition laws.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Substitute (A : CRing) (setA : Pr.isSet A.R) {
 module AX = PolynomialRing[l].Extension[A,setA] ;
 module H = RingHom[l] ;
 module UProp = Universal[l].Property[A,AX.ring,setA,AX.set] ;
 substitution (p : AX.Carrier) : H.Hom AX.ring AX.ring = UProp.Given[AX.inclusion,p].extend ;
 on-constant (p : AX.Carrier) (a : A.R) : Id AX.Carrier ((substitution p).1 (AX.constant a)) (AX.constant a) =
   UProp.Given[AX.inclusion,p].on-constants a ;
 on-variable (p : AX.Carrier) : Id AX.Carrier ((substitution p).1 AX.variable) p =
   UProp.Given[AX.inclusion,p].on-variable ;
 identity : Id (H.Hom AX.ring AX.ring) (substitution AX.variable) (H.identity AX.ring) =
   sym (UProp.Given[AX.inclusion,AX.variable].unique (H.identity AX.ring)
     (\ a -> refl (AX.constant a)) (refl AX.variable)) ;
 composition (p q : AX.Carrier) : Id (H.Hom AX.ring AX.ring)
   (H.compose AX.ring AX.ring AX.ring (substitution q) (substitution p))
   (substitution ((substitution q).1 p)) =
   UProp.Given[AX.inclusion,(substitution q).1 p].unique
    (H.compose AX.ring AX.ring AX.ring (substitution q) (substitution p))
    (\ a -> trans (ap (substitution q).1 (on-constant p a)) (on-constant q a))
    (ap (substitution q).1 (on-variable p)) ;
} ;
