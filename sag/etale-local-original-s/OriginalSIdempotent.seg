-- The positive-power relation supplies the original residual idempotent
-- e=s^N in B/IB. Prove s*e=e first, then every power of s fixes e.
-- No coefficient scan or prime selection is used in this construction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (I : RegularIdeal[l].IdealPred[A]) (propI : (a : A.R) -> Pr.isProp (I.In a))
 (Ba Ea : Algebras[l].Over[A,setA].Algebra)
 (j : Algebras[l].Over[A,setA].Hom Ba Ea) (s : Ba.ring.R) {
 module O = OriginalSQuasiInverse[l].Over[A,setA,I,propI,Ba,Ea,j,s] ;
 module Q = O.QB.QE ; module L = RL[Q.ring] ; module P = AffinePowers[l].Over[Q.ring] ;
 module Given (r : O.Result) {
  N : Nat = suc r.1 ;
  scalar : Q.Carrier = Q.include s ;
  e : Q.Carrier = Q.include (O.PB.power s N) ;
  image-difference : Id Q.Carrier (Q.include O.difference) (Q.ring.add Q.ring.o (Q.ring.neg scalar)) =
   trans (Q.projection.2.2.1 Ba.ring.o (Ba.ring.neg (Ba.ring.mul s Ba.ring.o)))
    (cong2 Q.Carrier Q.ring.add _ _ _ _ Q.projection.2.1
     (trans (RingHom[l].negation Ba.ring Q.ring Q.projection (Ba.ring.mul s Ba.ring.o))
      (ap Q.ring.neg (ap Q.include (Ba.ring.mulO s))))) ;
  relation : Id Q.Carrier (Q.ring.mul e (Q.ring.add Q.ring.o (Q.ring.neg scalar))) Q.ring.z =
   trans (sym (trans (Q.projection.2.2.2 (O.PB.power s N) O.difference)
    (ap (Q.ring.mul e) image-difference))) (Q.to-zero (Ba.ring.mul (O.PB.power s N) O.difference) r.2) ;
  fixed : Id Q.Carrier (Q.ring.mul scalar e) e =
   trans (Q.ring.mulC scalar e)
    (sym (FormallyEtale[l].Units[Q.ring,Q.set].sub-zero e (Q.ring.mul e scalar)
     (trans (sym (trans (Q.ring.dist e Q.ring.o (Q.ring.neg scalar))
      (cong2 Q.Carrier Q.ring.add _ _ _ _ (Q.ring.mulO e) (L.mul-neg e scalar)))) relation))) ;
  power-fixed : (k : Nat) -> Id Q.Carrier (Q.ring.mul (P.power scalar k) e) e = split {
   zero -> L.one-left e ;
   suc k | ih -> trans (sym (Q.ring.mulA scalar (P.power scalar k) e))
    (trans (ap (Q.ring.mul scalar) ih) fixed) } ;
  power-image : Id Q.Carrier e (P.power scalar N) = AffinePowers[l].power-map Ba.ring Q.ring Q.projection s N ;
  idempotent : Id Q.Carrier (Q.ring.mul e e) e =
   trans (ap (\ a -> Q.ring.mul a e) power-image) (power-fixed N) ;
  module Localized = QuotientPowerClearing[l].Over[Ba.ring,O.QB.IE,O.QB.propIE,s] ;
  module Inverse = Localized.QuasiInverse[N,Ba.ring.o,r.2] ;
  onto (a : Localized.T.R) : Truncation[l].Trunc[Inverse.Rep a].carrier = Inverse.onto a ;
 } ;
} ;
