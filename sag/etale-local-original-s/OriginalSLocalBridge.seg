-- Remove the supplied quasiinverse from LocalFieldComplete. The original
-- s-one and explicit ZMT clearing already occur in its local setup. A
-- kernel killed by powers suffices; actual injective subalgebras and the
-- canonical localisation equivalence both construct this kernel property.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (Bot : U l) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot)
 (rad : (a : A.R) -> m a -> Plus (RL[A].unit (A.add A.o (A.neg a))) Bot) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 -- ZMT
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-one : Tr.Trunc[IdealGenerated[l].Over[A,m,E,iota].InmB (E.add (j.1 s) (E.neg E.o))].carrier)
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier)
 -- E finitely presented and flat; exact fibre hypotheses are supplied below.
 (presentation : Presentations[l].Over[A,setA].Witness (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (flat : FlatRelations[l].Over[A,E,iota].Flat) (prop-m : (a : A.R) -> Pr.isProp (m a)) {
 module LclBridge = LocalFieldComplete[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,E,setE,iota,
  q,q-zero,q-add,q-scale,q-m,Bot,q-prime,rad,q-proper,q-dec,B,setB,iB,j,j-alg,n',bs,coord,s,s-one,zmt,presentation,flat,prop-m] ;
 module CA = Algebras[l].Over[A,setA] ;
 algebraE : CA.Algebra = CA.mkAlgebra E setE iota ;
 inclusion : CA.Hom LclBridge.Lift.algebraB algebraE = (j,j-alg) ;
 module O = OriginalSQuasiInverse[l].Over[A,setA,LclBridge.Lift.ideal,prop-m,LclBridge.Lift.algebraB,algebraE,inclusion,s] ;
 module Convert = FibreIdealWitnesses[l].Over[A,E,m,iota] ;
 membership : O.QE.InIE O.old-difference = Convert.mere-backward O.old-difference s-one ;
 module K = LclBridge.Lift.F.F.QR ;
 module CK = Algebras[l].Over[K.ring,K.set] ;
 fibre : CK.Algebra = CK.mkAlgebra LclBridge.Lift.F.Q.T LclBridge.Lift.F.Q.Loc.set LclBridge.Lift.F.iC ;
 module St = SelectedFactorStatement[l].Over[K.ring,K.set].At[fibre] ;
 module WithKernel
  (kernel : (b : B.R) -> Id E.R (j.1 b) E.z -> Tr.Trunc[O.Clear.Killed b].carrier) {
  quasiinverse : Tr.Trunc[O.Result].carrier = O.Given[zmt,kernel,membership].result ;
  module Given (r : O.Result) {
   module Inverse = LclBridge.GivenInverse[suc r.1,B.o,r.2] ;
  } ;
  module Field
   (field : SelectedFactorStatement[l].Over[K.ring,K.set].Field)
   (fp : Presentations[l].Over[K.ring,K.set].FP fibre)
   (unique : FormallyEtale[l].Over[K.ring,K.set].Unique fibre)
   (prime : St.PI.Prime)
   (prime-map : (b : B.R) -> q (j.1 b) -> prime.ideal.In (LclBridge.Lift.F.Q.eta.1 b)) {
   module At (r : O.Result) {
    module Apply = Given[r].Inverse.Field[field,fp,unique,prime,prime-map] ;
    selected-data : Tr.Trunc[LclBridge.Lift.Lcl.SelectedData].carrier = Apply.selected-data ;
   } ;
   selected-data : Tr.Trunc[LclBridge.Lift.Lcl.SelectedData].carrier =
    TC.bind O.Result LclBridge.Lift.Lcl.SelectedData (\ r -> At[r].selected-data) quasiinverse ;
   theorem : Truncation[l+].Trunc[LclBridge.Lift.Lcl.Outcome].carrier = LclBridge.Lift.Lcl.theorem selected-data ;
  } ;
 } ;
 module Injective (injective : (a b : B.R) -> Id E.R (j.1 a) (j.1 b) -> Id B.R a b) {
  module Constructed = WithKernel[O.Clear.Injective[injective].kernel] ;
 } ;
 module LM = LocalisedMapClearing[l].Over[B,E,j,s] ;
 module LocalEquivalence (iso : Pr.isEquiv LM.M.LA.ring.R LM.M.LC.ring.R LM.M.phi.1) {
  module Constructed = WithKernel[LM.Equivalence[iso].kernel] ;
 } ;
} ;
