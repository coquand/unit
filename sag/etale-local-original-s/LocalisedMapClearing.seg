-- Extract numerator and kernel power witnesses from the canonical map
-- B[1/s] -> E[1/j(s)]. Equality of fractions is made effective, including
-- its extra annihilating power. No localisation map is assumed injective.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (B E : CRing) (j : H.Hom B E) (s : B.R) {
 module M = CertificateLocalisation[l].LocalMap[B,E,j,s] ;
 module PB = M.PA ; module PE = M.PC ; module LE = RL[E] ;
 Cleared (e : E.R) : U l = (N : Nat) * (b : B.R) *
  Id E.R (E.mul (PE.power (j.1 s) N) e) (j.1 b) ;
 Killed (b : B.R) : U l = (N : Nat) * Id B.R (B.mul (PB.power s N) b) B.z ;
 module Fraction (e : E.R) (p : M.FA)
  (w : M.LC.L.Raw.Witness (M.mapF p) (M.LC.L.Raw.constantF e)) {
  m : Nat = w.2.1.1 ; k : Nat = p.2.2.1 ;
  exponent : Nat = plus m k ;
  numerator : B.R = B.mul (PB.power s m) p.1 ;
  denominator-image : Id E.R (j.1 p.2.1) (PE.power (j.1 s) k) =
   trans (ap j.1 p.2.2.2) (M.power-natural k) ;
  product : Id E.R (E.mul (PE.power (j.1 s) exponent) e)
   (E.mul w.1 (E.mul e (j.1 p.2.1))) =
   trans (ap (\ a -> E.mul a e) (PE.power-add (j.1 s) m k))
    (trans (sym (E.mulA (PE.power (j.1 s) m) (PE.power (j.1 s) k) e))
     (cong2 E.R E.mul _ _ _ _ (sym w.2.1.2)
      (trans (E.mulC (PE.power (j.1 s) k) e) (ap (E.mul e) (sym denominator-image))))) ;
  equation : Id E.R (E.mul (PE.power (j.1 s) exponent) e) (j.1 numerator) =
   trans product
    (trans (sym w.2.2)
     (trans (ap (E.mul w.1) (E.mulO (j.1 p.1)))
      (trans (ap (\ a -> E.mul a (j.1 p.1))
       (trans w.2.1.2 (sym (M.power-natural m))))
       (sym (j.2.2.2 (PB.power s m) p.1))))) ;
  result : Cleared e = (exponent,numerator,equation) ;
 } ;
 fraction (e : E.R) (p : M.FA)
  (eq : Id M.LC.ring.R (M.phi.1 (M.LA.L.include p)) (M.LC.inclusion.1 e)) :
  Tr.Trunc[Cleared e].carrier =
   TC.map (M.LC.L.Raw.Witness (M.mapF p) (M.LC.L.Raw.constantF e)) (Cleared e)
    (\ w -> Fraction[e,p,w].result)
    (M.LC.L.Q.effective (M.mapF p) (M.LC.L.Raw.constantF e) (trans (sym (M.phi-beta p)) eq)) ;
 representative (e : E.R) (q : M.LA.ring.R)
  (eq : Id M.LC.ring.R (M.phi.1 q) (M.LC.inclusion.1 e)) : Tr.Trunc[Cleared e].carrier =
   TC.bind (M.LA.L.Representatives q) (Cleared e)
    (\ p -> fraction e p.1 (trans (ap M.phi.1 p.2) eq)) (M.LA.L.representatives q) ;
 module Surjective (onto : (e : M.LC.ring.R) ->
  Tr.Trunc[(b : M.LA.ring.R) * Id M.LC.ring.R (M.phi.1 b) e].carrier) {
  clear (e : E.R) : Tr.Trunc[Cleared e].carrier =
   TC.bind ((b : M.LA.ring.R) * Id M.LC.ring.R (M.phi.1 b) (M.LC.inclusion.1 e)) (Cleared e)
    (\ q -> representative e q.1 q.2) (onto (M.LC.inclusion.1 e)) ;
 } ;
 module Injective (injective : (a b : M.LA.ring.R) ->
  Id M.LC.ring.R (M.phi.1 a) (M.phi.1 b) -> Id M.LA.ring.R a b) {
  kernel (b : B.R) (h : Id E.R (j.1 b) E.z) : Tr.Trunc[Killed b].carrier =
   M.LA.kernel b (injective (M.LA.inclusion.1 b) M.LA.ring.z
    (trans (M.phi-constant b)
     (trans (ap M.LC.inclusion.1 h)
      (trans (H.zero E M.LC.ring M.LC.inclusion) (sym (H.zero M.LA.ring M.LC.ring M.phi)))))) ;
 } ;
 module Equivalence (iso : Pr.isEquiv M.LA.ring.R M.LC.ring.R M.phi.1) {
  onto (e : M.LC.ring.R) : Tr.Trunc[(b : M.LA.ring.R) * Id M.LC.ring.R (M.phi.1 b) e].carrier =
   Tr.Trunc[(b : M.LA.ring.R) * Id M.LC.ring.R (M.phi.1 b) e].inc (iso.sec e,iso.sec-eq e) ;
  injective (a b : M.LA.ring.R) : Id M.LC.ring.R (M.phi.1 a) (M.phi.1 b) -> Id M.LA.ring.R a b =
   Equivalences[l].injective M.LA.ring.R M.LC.ring.R M.phi.1 iso a b ;
  clear (e : E.R) : Tr.Trunc[Cleared e].carrier = Surjective[onto].clear e ;
  kernel (b : B.R) (h : Id E.R (j.1 b) E.z) : Tr.Trunc[Killed b].carrier = Injective[injective].kernel b h ;
 } ;
} ;
