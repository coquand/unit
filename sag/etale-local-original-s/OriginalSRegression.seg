-- The complete local bridge now constructs the original-s quasiinverse
-- on the split example. Its map B->E is itself noninjective; the missing
-- second component is killed by s, so the kernel repair is exercised.
-- Actual image subalgebras over Z/4 cover unit, nilpotent and zero s.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module T = SelectedLocalRegression[l] ; module R = SelectedLiftRegression[l] ;
module F = LocalFieldCompleteRegression[l] ; module BF = BooleanRing[l] ;
module Bridge = OriginalSLocalBridge[l].Over[T.A,BF.bool-set,T.m,T.m-zero,T.m-add,T.m-scale,T.dec,
 T.A,BF.bool-set,H.identity T.A,T.m,T.m-zero,T.m-add,T.m-scale,(\ a h -> h),Empty,(\ a b h -> inl (T.prime a b h)),(\ a h -> inl (T.rad a h)),T.nonzero,T.prime-dec,
 T.B,T.setB,T.iota,T.j,(\ a -> refl a),T.one,T.bs,T.coord,T.s,T.s-one,T.zmt,
 (T.BP.empty,T.BP.presentation),FlatRelations[l].Self[T.A].flat,\ a -> BF.bool-set a false] ;
kernel (b : T.Pair) (h : Id T.A.R (T.j.1 b) T.A.z) : Tr.Trunc[Bridge.O.Clear.Killed b].carrier =
 Tr.Trunc[Bridge.O.Clear.Killed b].inc (T.one,T.pair-eq _ _ h (refl false)) ;
module Constructed = Bridge.WithKernel[kernel] ;
quasiinverse : Tr.Trunc[Bridge.O.Result].carrier = Constructed.quasiinverse ;
module Finished = Constructed.Field[F.field,F.fp,F.unique,R.prime,R.prime-map] ;
selected-data : Tr.Trunc[Bridge.LclBridge.Lift.Lcl.SelectedData].carrier = Finished.selected-data ;
-- Bot = Empty: the outcome is a conclusion
empty-up : Empty -> Ring[l+].Empty = split { } ;
strict-case : Bridge.LclBridge.Lift.Lcl.Outcome -> Bridge.LclBridge.Lift.Lcl.St.Conclusion = split {
 inl c -> c ; inr e -> Ring[l+].absurd Bridge.LclBridge.Lift.Lcl.St.Conclusion (empty-up e) } ;
theorem : Truncation[l+].Trunc[Bridge.LclBridge.Lift.Lcl.St.Conclusion].carrier =
 TruncationCombinators[l+].map Bridge.LclBridge.Lift.Lcl.Outcome Bridge.LclBridge.Lift.Lcl.St.Conclusion strict-case Finished.theorem ;
nonzero-quotient-class : Not (Id R.F.F.QE.Carrier (R.F.F.QE.include (T.bs T.i1)) R.F.F.QE.zeroQ) = R.quotient-other-nonzero ;
zero-localized-class : Id R.Q.T.R (R.Q.eta.1 (T.bs T.i1)) R.Q.T.z = R.other-zero ;
module QX = QuotientExamples[l] ; module DE = DescentExamples[l] ; module Z = ZMod4[l] ;
module UnitInput = OriginalSSubalgebra[l].Over[QX.R4,QX.set4,QX.two,QX.even-prop,DE.E4,
 zero,QX.Two.x0,QX.gen zero QX.Two.x0] ;
unit-member : UnitInput.QE.InIE q0 = Tr.Trunc[UnitInput.QE.W.Wit q0].inc UnitInput.QE.W.ie-zero ;
module Unit = UnitInput.At[q1,unit-member] ;
unit-result : Tr.Trunc[Unit.O.Result].carrier = Unit.result ;
unit-localisation : Tr.Trunc[Unit.O.Result].carrier = Unit.via-localisation ;
module WholeInput = OriginalSSubalgebra[l].Over[QX.R4,QX.set4,QX.all,\ a -> Z.top-prop,DE.E4,
 suc zero,QX.Zero.x,QX.gen (suc zero) QX.Zero.x] ;
module Nilpotent = WholeInput.At[q2,QX.Zero.in-IE q1] ;
nilpotent-result : Tr.Trunc[Nilpotent.O.Result].carrier = Nilpotent.result ;
nilpotent-localisation : Tr.Trunc[Nilpotent.O.Result].carrier = Nilpotent.via-localisation ;
nilpotent-square : Id QX.R4.R (QX.R4.mul q2 q2) q0 = refl q0 ;
module Zero = WholeInput.At[q0,QX.Zero.in-IE q3] ;
zero-result : Tr.Trunc[Zero.O.Result].carrier = Zero.result ;
zero-localisation : Tr.Trunc[Zero.O.Result].carrier = Zero.via-localisation ;
