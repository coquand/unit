-- For the original ZMT element, s-1 in IE becomes a positive-power
-- relation s^N(1-s*1) in IB. Negating its finite ideal witness and
-- applying IdealPowerClearing supplies exactly the local bridge's v=1
-- quasiinverse, with no assumption on a residual quotient inclusion.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (I : RegularIdeal[l].IdealPred[A]) (propI : (a : A.R) -> Pr.isProp (I.In a))
 (Ba Ea : Algebras[l].Over[A,setA].Algebra)
 (j : Algebras[l].Over[A,setA].Hom Ba Ea) (s : Ba.ring.R) {
 module QB = QuotientFibre[l].Over[A,setA,I,propI,Ba] ;
 module QE = QuotientFibre[l].Over[A,setA,I,propI,Ea] ;
 module Clear = IdealPowerClearing[l].Over[A,I.In,Ba.ring,Ea.ring,Ba.set,Ba.iota,Ea.iota,j.1,j.2,s] ;
 module PB = Clear.PB ; module LE = RL[Ea.ring] ;
 difference : Ba.ring.R = Ba.ring.add Ba.ring.o (Ba.ring.neg (Ba.ring.mul s Ba.ring.o)) ;
 old-difference : Ea.ring.R = Ea.ring.add (j.1.1 s) (Ea.ring.neg Ea.ring.o) ;
 Result : U l = (predecessor : Nat) * QB.InIE (Ba.ring.mul (PB.power s (suc predecessor)) difference) ;
 image : Id Ea.ring.R (j.1.1 difference) (Ea.ring.neg old-difference) =
  trans (j.1.2.2.1 Ba.ring.o (Ba.ring.neg (Ba.ring.mul s Ba.ring.o)))
   (trans (cong2 Ea.ring.R Ea.ring.add _ _ _ _ j.1.2.1
    (trans (H.negation Ba.ring Ea.ring j.1 (Ba.ring.mul s Ba.ring.o))
     (ap Ea.ring.neg (ap j.1.1 (Ba.ring.mulO s)))))
    (trans (Ea.ring.addC Ea.ring.o (Ea.ring.neg (j.1.1 s)))
     (sym (LE.negsub (j.1.1 s) Ea.ring.o)))) ;
 negate (w : QE.W.Wit old-difference) : Clear.WE.Wit (j.1.1 difference) =
  QE.W.ie-eq _ _
   (trans (LE.neg-mul-left Ea.ring.o old-difference)
    (trans (ap Ea.ring.neg (LE.one-left old-difference)) (sym image)))
   (QE.W.ie-mul (Ea.ring.neg Ea.ring.o) old-difference w) ;
 module Given
  (clear : (e : Ea.ring.R) -> Tr.Trunc[Clear.Cleared e].carrier)
  (kernel : (b : Ba.ring.R) -> Id Ea.ring.R (j.1.1 b) Ea.ring.z -> Tr.Trunc[Clear.Killed b].carrier)
  (s-one : QE.InIE old-difference) {
  module C = Clear.Given[clear,kernel] ;
  witness : Tr.Trunc[Clear.PositiveWitness difference].carrier =
   C.theorem difference (TC.map (QE.W.Wit old-difference) (Clear.WE.Wit (j.1.1 difference)) negate s-one) ;
  result : Tr.Trunc[Result].carrier =
   TC.map (Clear.PositiveWitness difference) Result
    (\ w -> (w.1,Tr.Trunc[QB.W.Wit (Ba.ring.mul (PB.power s (suc w.1)) difference)].inc w.2)) witness ;
 } ;
 module Injective
  (injective : (a b : Ba.ring.R) -> Id Ea.ring.R (j.1.1 a) (j.1.1 b) -> Id Ba.ring.R a b)
  (clear : (e : Ea.ring.R) -> Tr.Trunc[Clear.Cleared e].carrier)
  (s-one : QE.InIE old-difference) {
  result : Tr.Trunc[Result].carrier = Given[clear,Clear.Injective[injective].kernel,s-one].result ;
 } ;
} ;
