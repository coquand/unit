-- The actual image subalgebra B=A[s,s*x_i] has the required power
-- clearing by polynomial-expression induction in CertificateLocalisation.
-- Its inclusion is injective. Thus the quasiinverse is constructed for
-- the original s of any ZMT output, with no new existence principle.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (I : RegularIdeal[l].IdealPred[A]) (propI : (a : A.R) -> Pr.isProp (I.In a))
 (Ea : Algebras[l].Over[A,setA].Algebra) (n : Nat) (x : Fin n -> Ea.ring.R)
 (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[A,setA].Expr (Fin n)) *
  Id Ea.ring.R (Presentations[l].Over[A,setA].eval (Fin n) Ea x H) e].carrier) {
 module C = Algebras[l].Over[A,setA] ;
 module QE = QuotientFibre[l].Over[A,setA,I,propI,Ea] ;
 module At (s : Ea.ring.R) (s-one : QE.InIE (Ea.ring.add s (Ea.ring.neg Ea.ring.o))) {
  module B = CertificateSubalgebra[l].Over[A,setA,Ea,n,x,s] ;
  module CL = CertificateLocalisation[l].Iso[A,setA,Ea,n,x,s,gen] ;
  inclusion : C.Hom B.algebra Ea = (B.incl,\ a -> refl (Ea.iota.1 a)) ;
  module O = OriginalSQuasiInverse[l].Over[A,setA,I,propI,B.algebra,Ea,inclusion,B.sB] ;
  module Expression (e : Ea.ring.R) (p : B.P.Expr (Fin n))
   (eq : Id Ea.ring.R (CL.evx p) e) (c : CL.Cleared (CL.evx p)) {
   numerator : B.Carrier = (Ea.ring.mul (CL.PE.power s c.1) e,
    B.in-eq _ _ (ap (Ea.ring.mul (CL.PE.power s c.1)) eq) c.2) ;
   result : O.Clear.Cleared e = (c.1,numerator,refl (Ea.ring.mul (CL.PE.power s c.1) e)) ;
  } ;
  clear (e : Ea.ring.R) : Tr.Trunc[O.Clear.Cleared e].carrier =
   TC.bind ((p : B.P.Expr (Fin n)) * Id Ea.ring.R (CL.evx p) e) (O.Clear.Cleared e)
    (\ p -> TC.map (CL.Cleared (CL.evx p.1)) (O.Clear.Cleared e)
     (\ c -> Expression[e,p.1,p.2,c].result) (CL.cleared p.1)) (gen e) ;
  result : Tr.Trunc[O.Result].carrier = O.Injective[B.incl-inj,clear,s-one].result ;
  -- The same result through the actual canonical localisation equivalence.
  -- This path includes effectiveness and its extra annihilating powers.
  module Loc = LocalisedMapClearing[l].Over[B.ring,Ea.ring,B.incl,B.sB].Equivalence[CL.iso.2] ;
  via-localisation : Tr.Trunc[O.Result].carrier = O.Given[Loc.clear,Loc.kernel,s-one].result ;
 } ;
 -- Enrich an existing actual finite-subalgebra ZMT conclusion. No
 -- UniversalZMT/CFNZMT principle is introduced by this adapter.
 module FiniteFibre (fo : Tr.Trunc[QE.Finite].carrier) {
  module Z = FiniteFibreLocalisation[l].Over[A,setA,I,propI,Ea,n,x,gen,fo] ;
  Result : U l = (z : Z.Conclusion) * At[z.1,z.2.1].O.Result ;
  enhance (z : Z.Conclusion) : Tr.Trunc[Result].carrier =
   TC.map At[z.1,z.2.1].O.Result Result (\ r -> (z,r)) At[z.1,z.2.1].result ;
  from-result (zmt : Tr.Trunc[Z.Conclusion].carrier) : Tr.Trunc[Result].carrier =
   TC.bind Z.Conclusion Result enhance zmt ;
 } ;
} ;
