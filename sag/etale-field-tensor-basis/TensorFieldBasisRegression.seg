-- Actual tensor and composed basis on the base algebra over Z/4Z.
-- This construction needs no field or reducedness assumption.
level l ; open Ring[l] ; open Presentations[l] ;
module T = TraceRegression[l].Nonreduced ;
module B = TensorFieldBasis[l].Over[ZMod4[l].ring,ZMod4[l].set].At[
 T.C.base,T.ActualTensor.T.T,T.ActualTensor.T.coproduct,TraceRegression[l].one,T.basis] ;
rank-one : Id Nat B.rank (suc zero) = refl (suc zero) ;
basis : B.TB.Basis[suc zero] = B.basis ;
reconstruct (a : T.ActualTensor.T.T.ring.R) : Id T.ActualTensor.T.T.ring.R
 (B.TB.SS.sum B.rank (\ i -> T.ActualTensor.T.T.ring.mul (T.ActualTensor.T.T.iota.1 (basis.coordinate a i)) (basis.vector i))) a =
 basis.reconstruction a ;
coordinate (a : T.ActualTensor.T.T.ring.R) : Id ZMod4[l].ring.R
 (basis.coordinate a (inr tt)) (T.basis.coordinate (B.T.coordinate a (inr tt)) (inr tt)) =
 B.coordinate-pair a (inr tt) (inr tt) ;
