-- The actual tensor coproduct has a base-ring basis of rank n*n.
-- First package its constructed right-S coordinates as a TraceBasis;
-- compose that basis with the given base-ring basis of S. A final
-- scalar-map comparison puts the result over the original D algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module Tn = Tensor[l].Over[k,setk] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D)
  (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n]) {
  module T = TensorBasisConstruct[l].Over[k,setk].At[S,D,cp,n,b] ;
  module CS = Algebras[l].Over[S.ring,S.set] ;
  right-algebra : CS.Algebra = CS.mkAlgebra D.ring D.set T.DK.right.1 ;
  module RB = TraceBasis[l].Over[S.ring,S.set,right-algebra] ;
  vector (j : Fin n) : D.ring.R = T.DK.left.1.1 (b.vector j) ;
  reconstruct (a : D.ring.R) : Id D.ring.R
   (RB.SS.sum n (\ j -> D.ring.mul (T.DK.right.1.1 (T.coordinate a j)) (vector j))) a =
   trans (RB.SS.sum-cong n _ _ (\ j -> D.ring.mulC (T.DK.right.1.1 (T.coordinate a j)) (vector j)))
    (T.reconstruction a) ;
  on-vector (j i : Fin n) : Id S.ring.R (T.coordinate (vector j) i) (RB.Delta.delta n i j) =
   trans (T.coordinate-left (b.vector j) i)
    (trans (ap S.iota.1 (b.on-vector j i)) (T.X.Iota.delta-map n i j)) ;
  right-basis : RB.Basis[n] = RB.mkBasis n vector T.coordinate T.coordinate-add T.coordinate-scale reconstruct on-vector ;
  module Compose = FiniteBasisComposition[l].Over[k,setk,S,right-algebra,n,b,n,right-basis] ;
  rank : Nat = FiniteProduct[l].size n n ;
  module TB = TraceBasis[l].Over[k,setk,D] ;
  coordinate (a : D.ring.R) : Fin rank -> k.R = Compose.coordinate a ;
  scale (r : k.R) (a : D.ring.R) (i : Fin rank) :
   Id k.R (coordinate (D.ring.mul (D.iota.1 r) a) i) (k.mul r (coordinate a i)) =
   trans (ap (\ c -> coordinate (D.ring.mul c a) i) (sym (T.DK.right.2 r))) (Compose.coordinate-scale r a i) ;
  reconstruction (a : D.ring.R) : Id D.ring.R
   (TB.SS.sum rank (\ j -> D.ring.mul (D.iota.1 (coordinate a j)) (Compose.basis.vector j))) a =
   trans (TB.SS.sum-cong rank _ _ (\ j -> ap (\ c -> D.ring.mul c (Compose.basis.vector j))
    (sym (T.DK.right.2 (coordinate a j))))) (Compose.basis.reconstruction a) ;
  basis : TB.Basis[rank] = TB.mkBasis rank Compose.basis.vector coordinate Compose.coordinate-add scale reconstruction Compose.basis.on-vector ;
  coordinate-pair (a : D.ring.R) (i j : Fin n) : Id k.R
   (coordinate a (FiniteProduct[l].encode n n i j)) (b.coordinate (T.coordinate a i) j) =
   ap (\ p -> b.coordinate (T.coordinate a p.1) p.2) (FiniteProduct[l].decode-encode n n i j) ;
  tensor-expansion (a : D.ring.R) : Id D.ring.R
   (TB.SS.sum n (\ i -> D.ring.mul (T.DK.left.1.1 (b.vector i)) (T.DK.right.1.1 (T.coordinate a i)))) a =
   T.reconstruction a ;
 } ;
} ;
