-- ReesFiniteList4.seg: ONE fixed finite bihomogeneous list generating the
-- Rees kernel (handoff §2 (1)).
--
-- Data: as in ReesComponents4.Over (B graded over A by X-degree, R graded
-- over B by U-degree, P_q of X-degree e_q, b_j of X-degree 0), every element
-- of B and of R merely finitely decomposed (decB, decR), and a finite list
-- Gs = (g_0, .., g_(L-1)) of elements of the elimination ideal (gens-elim)
-- spanning it (span): the output of GenAt (ReesPresentation4.presentation).
--
-- Bounds.  For a bound Bu, every g_k is the sum of its U-parts below Bu
-- (Decomp Bu g_k: the parts from Bu on vanish, so a larger bound is again
-- one: pad).  For a bound Bx, the n-th part of g_k is X-bounded by Bx when
-- every coefficient of its canonical expression (ReesComponents4.exprOf) is
-- the sum of its X-parts below Bx (QX; monotone in Bx: all-pad).  Under the
-- truncation, finitely many bounded monotone properties have a common bound
-- (ReesFinBound.fin-bound): first Bu for the L generators (bound-u), then Bx
-- for the L * Bu parts (bound-x).  So merely there are Bu, Bx with
--     g_k = sum_{n < Bu} pr_n g_k,   pr_n g_k = sum_{d < Bx} comp n d g_k   (fixed)
-- for every k < L and n < Bu (the second by the computation of
-- ReesComponents4.part-comps for the fixed Bx: part-eq).
--
-- The list.  For fixed bounds, KG is the family on the FINITE index set
-- Fin na, na = L * Bu * Bx (a rectangle of rectangles, Rect: the rows are
-- joined by ReesJoin), with
--     kg (at k n d) = comp n d g_k                     (k < L, n < Bu, d < Bx)
-- (kg-at; the position at k n d and the decoding ix are by Rect.fam-idx).
-- Every member is bihomogeneous of its bidegree (kg-bihom), lies in the
-- elimination ideal and in ker phi (kg-elim, kg-ker), and for a
-- certificate w of g_k (ReesKernel4.cert) satisfies (certX) with the
-- coefficients H' of X-degree d - e_q (kg-certX, kg-hom-HX).
-- Generation (kernel).  Each g_k is the finite sum above of members of KG
-- (gen-in: in-sumTo-fin, a sum over n < m of members is a combination of
-- members); every element of the elimination ideal is an R-combination of
-- the g_k (span), hence of KG (kernel-elim); ker phi is the elimination
-- ideal (ReesKernel4.ker-elim with decR), so every element of ker phi is a
-- finite R-combination of the members of KG (kernel).  THEOREM:
--     finite-generation : || (Bu, Bx, bounds) * (ker phi in the span of KG) ||
-- The infinitely indexed family of ReesComponents4.Generate is not used.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

------------------------------------------------------------------------
-- finite index sets

-- the number of i in Fin m (inr tt is the last one, m - 1)
finS (m : Nat) (r : Ps.Fin m -> Nat) : Ps.Fin (suc m) -> Nat = split {
  inl i -> r i ;
  inr u -> m } ;
finN : (m : Nat) -> Ps.Fin m -> Nat = split {
  zero -> \ i -> absurd Nat i ;
  suc m | r -> finS m r } ;

-- m rows of n entries: Fin (rect m), the rows joined (ReesJoin)
module Rect (X : U l) (n : Nat) {
  rect : Nat -> Nat = split { zero -> zero ; suc m | r -> plus n r } ;
  famS (m : Nat) (r : (Ps.Fin m -> Ps.Fin n -> X) -> Ps.Fin (rect m) -> X) (F : Ps.Fin (suc m) -> Ps.Fin n -> X) :
    Ps.Fin (plus n (rect m)) -> X = ReesGenerators4[l].ReesJoin[X,rect m].join n (F (inr tt)) (r (\ i -> F (inl i))) ;
  -- the family with entry F i j at the position idx i j
  fam : (m : Nat) -> (Ps.Fin m -> Ps.Fin n -> X) -> Ps.Fin (rect m) -> X = split {
    zero -> \ F i -> absurd X i ;
    suc m | r -> famS m r } ;
  idxS (m : Nat) (r : Ps.Fin m -> Ps.Fin n -> Ps.Fin (rect m)) : Ps.Fin (suc m) -> Ps.Fin n -> Ps.Fin (plus n (rect m)) = split {
    inl i -> \ j -> ReesGenerators4[l].ReesIndex[rect m].jr n (r i j) ;
    inr u -> \ j -> ReesGenerators4[l].ReesIndex[rect m].jl n j } ;
  idx : (m : Nat) -> Ps.Fin m -> Ps.Fin n -> Ps.Fin (rect m) = split {
    zero -> \ i j -> absurd (Ps.Fin zero) i ;
    suc m | r -> idxS m r } ;
  fam-idxT (m : Nat) (F : Ps.Fin (suc m) -> Ps.Fin n -> X) (j : Ps.Fin n) : (u : Top) ->
    Id X (fam (suc m) F (idx (suc m) (inr u) j)) (F (inr u) j) = split {
    tt -> ReesGenerators4[l].ReesJoinLaws[X,rect m].join-l n (F (inr tt)) (fam m (\ i -> F (inl i))) j } ;
  fam-idxS (m : Nat) (r : (F : Ps.Fin m -> Ps.Fin n -> X) (i : Ps.Fin m) (j : Ps.Fin n) -> Id X (fam m F (idx m i j)) (F i j))
    (F : Ps.Fin (suc m) -> Ps.Fin n -> X) : (i : Ps.Fin (suc m)) (j : Ps.Fin n) -> Id X (fam (suc m) F (idx (suc m) i j)) (F i j) = split {
    inl i -> \ j -> trans (ReesGenerators4[l].ReesJoinLaws[X,rect m].join-r n (F (inr tt)) (fam m (\ i' -> F (inl i'))) (idx m i j))
                      (r (\ i' -> F (inl i')) i j) ;
    inr u -> \ j -> fam-idxT m F j u } ;
  fam-idx : (m : Nat) (F : Ps.Fin m -> Ps.Fin n -> X) (i : Ps.Fin m) (j : Ps.Fin n) -> Id X (fam m F (idx m i j)) (F i j) = split {
    zero -> \ F i j -> absurd (Id X (fam zero F (idx zero i j)) (F i j)) i ;
    suc m | r -> fam-idxS m r } ;
} ;

-- a property of every member of a list holds at every position
all-elemS (R : CRing) (Md : IP.Mod[R]) (Q : Md.M -> U l) (x : Md.M) (s : List Md.M) (hx : Q x)
  (r : (i : Ps.Fin (len s)) -> Q (Comb[l].Lists[R,Md].elem s i)) :
  (i : Ps.Fin (suc (len s))) -> Q (Comb[l].Lists[R,Md].elem (cons x s) i) = split {
  inl i -> r i ;
  inr u -> hx } ;
all-elem (R : CRing) (Md : IP.Mod[R]) (Q : Md.M -> U l) : (s : List Md.M) -> DegreeCor[l].AllL Md.M Q s ->
  (i : Ps.Fin (len s)) -> Q (Comb[l].Lists[R,Md].elem s i) = split {
  nil -> \ h i -> absurd (Q (Comb[l].Lists[R,Md].elem nil i)) i ;
  cons x s | r -> \ h -> all-elemS R Md Q x s h.1 (r h.2) } ;

------------------------------------------------------------------------
-- the fixed list

module Over (A : CRing) (r : Nat) (B : CRing) (setB : Pr.isSet B.R) (GX : Graded[A,r,B])
  (t : Nat) (R : CRing) (setR : Pr.isSet R.R) (G : Graded[B,t,R])
  (b : Ps.Fin t -> B.R) (s : Nat) (P : Ps.Fin s -> B.R)
  (e : Ps.Fin s -> Base.Nat) (hP : (q : Ps.Fin s) -> Id B.R (GX.pr (pos (e q)) (P q)) (P q))
  (hb : (j : Ps.Fin t) -> Id B.R (GX.pr zeroZ (b j)) (b j)) {
  module RC = ReesComponents4[l].Over[A,r,B,setB,GX,t,R,setR,G,b,s,P,e,hP,hb] ;
  module RK = RC.RK ;

  module Gens (decB : (y : B.R) -> RC.DX.FinDeg y) (decR : (x : R.R) -> RC.DU.FinDeg x)
    (Gs : List RK.Blk1) (gens-elim : DegreeCor[l].AllL RK.Blk1 RK.Elim Gs)
    (span : (u : RK.Blk1) -> RK.Elim u -> Spans[l].Over[R,RK.SQ.blk (suc zero)].Mm Gs u) {
    module GC = RC.Generate[decB,decR,Gs,span] ;
    -- the n-th part of x is X-bounded by Bx
    QX (n : Nat) (x : R.R) (Bx : Nat) : U l = RC.AllE (toB n) (RC.DX.Decomp Bx) (RC.exprOf n x) ;
    Bounds (Bu Bx : Nat) : U l = ((k : Ps.Fin GC.L) -> RC.DU.Decomp Bu (GC.gl k)) *
      ((k : Ps.Fin GC.L) (i : Ps.Fin Bu) -> QX (finN Bu i) (GC.gl k) Bx) ;
    FixedW : U l = (Bu : Nat) * ((Bx : Nat) * Bounds Bu Bx) ;

    -- a common U-bound of the generators
    bound-u : RC.FB.Bounded (\ Bu -> (k : Ps.Fin GC.L) -> RC.DU.Decomp Bu (GC.gl k)) =
      RC.FB.fin-bound GC.L (\ k Bu -> RC.DU.Decomp Bu (GC.gl k)) (\ k Bu m h -> RC.DU.pad m Bu (GC.gl k) h) (\ k -> decR (GC.gl k)) ;
    -- a common X-bound of their parts below Bu
    bound-x (Bu : Nat) : RC.FB.Bounded (\ Bx -> (k : Ps.Fin GC.L) (i : Ps.Fin Bu) -> QX (finN Bu i) (GC.gl k) Bx) =
      RC.FB.fin-bound GC.L (\ k Bx -> (i : Ps.Fin Bu) -> QX (finN Bu i) (GC.gl k) Bx)
        (\ k Bx m h i -> RC.all-pad (toB (finN Bu i)) (RC.exprOf (finN Bu i) (GC.gl k)) Bx m (h i))
        (\ k -> RC.FB.fin-bound Bu (\ i Bx -> QX (finN Bu i) (GC.gl k) Bx)
                  (\ i Bx m h -> RC.all-pad (toB (finN Bu i)) (RC.exprOf (finN Bu i) (GC.gl k)) Bx m h)
                  (\ i -> RC.all-fin decB (toB (finN Bu i)) (RC.exprOf (finN Bu i) (GC.gl k)))) ;
    -- merely, fixed common bounds
    fixed : Tr.Trunc[FixedW].carrier =
      TC.bind ((Bu : Nat) * ((k : Ps.Fin GC.L) -> RC.DU.Decomp Bu (GC.gl k))) FixedW
        (\ wu -> TC.map ((Bx : Nat) * ((k : Ps.Fin GC.L) (i : Ps.Fin wu.1) -> QX (finN wu.1 i) (GC.gl k) Bx)) FixedW
                   (\ wx -> (wu.1, (wx.1, (wu.2, wx.2)))) (bound-x wu.1))
        bound-u ;

    -- the list for fixed bounds
    module KG (fw : FixedW) {
      Bu : Nat = fw.1 ;
      Bx : Nat = fw.2.1 ;
      module RD = Rect[Nat * Base.Nat,Bx] ;
      module RI = Rect[GC.Ix,RD.rect Bu] ;
      na : Nat = RI.rect GC.L ;
      -- the bidegree (n, d) at the position (i, j) of a rectangle
      deg (i : Ps.Fin Bu) (j : Ps.Fin Bx) : Nat * Base.Nat = (finN Bu i, toB (finN Bx j)) ;
      ix : Ps.Fin na -> GC.Ix = RI.fam GC.L (\ k p -> (k, RD.fam Bu deg p)) ;
      kg (i : Ps.Fin na) : R.R = GC.cp (ix i) ;
      -- the position of comp n d g_k
      at (k : Ps.Fin GC.L) (i : Ps.Fin Bu) (j : Ps.Fin Bx) : Ps.Fin na = RI.idx GC.L k (RD.idx Bu i j) ;
      ix-at (k : Ps.Fin GC.L) (i : Ps.Fin Bu) (j : Ps.Fin Bx) : Id GC.Ix (ix (at k i j)) (k, deg i j) =
        trans (RI.fam-idx GC.L (\ k' p -> (k', RD.fam Bu deg p)) k (RD.idx Bu i j))
          (ap (\ q -> (k, q)) (RD.fam-idx Bu deg i j)) ;
      kg-at (k : Ps.Fin GC.L) (i : Ps.Fin Bu) (j : Ps.Fin Bx) :
        Id R.R (kg (at k i j)) (RC.comp (finN Bu i) (toB (finN Bx j)) (GC.gl k)) = ap GC.cp (ix-at k i j) ;

      -- the members: bihomogeneous, in the elimination ideal, with (certX)
      gen (i : Ps.Fin na) : RK.Blk1 = GC.LG.elem Gs (ix i).1 ;
      kg-bihom (i : Ps.Fin na) : RC.BiHom (ix i).2.1 (ix i).2.2 (kg i) = RC.comp-bihom (ix i).2.1 (ix i).2.2 (GC.gl (ix i).1) ;
      kg-elim (i : Ps.Fin na) : RK.Elim (RK.ub (kg i)) =
        RC.comp-elim (gen i) (all-elem R (RK.SQ.blk (suc zero)) RK.Elim Gs gens-elim (ix i).1) (ix i).2.1 (ix i).2.2 ;
      kg-ker (i : Ps.Fin na) : RK.Ker (kg i) = RK.ker-of-elim (RK.ub (kg i)) (kg-elim i) ;
      kg-certX (i : Ps.Fin na) (w : RK.CertW (gen i)) :
        Id B.R (RK.RG.ev (kg i)) (RK.RSB.comb s (RC.HX (gen i) w (ix i).2.1 (ix i).2.2) P) = RC.certX (gen i) w (ix i).2.1 (ix i).2.2 ;
      kg-hom-HX (i : Ps.Fin na) (w : RK.CertW (gen i)) (q : Ps.Fin s) :
        RC.GXL.Hom (subZ (pos (ix i).2.2) (pos (e q))) (RC.HX (gen i) w (ix i).2.1 (ix i).2.2 q) = RC.hom-HX (gen i) w (ix i).2.1 (ix i).2.2 q ;

      -- generation by the members
      module FK = ReesComponents4[l].ReesFinComb[R,Ps.Fin na,kg] ;
      in-sumTo-fin : (m : Nat) (f : Nat -> R.R) -> ((i : Ps.Fin m) -> FK.InComb (f (finN m i))) -> FK.InComb (RC.DU.DS.sumTo m f) = split {
        zero -> \ f h -> FK.in-zero ;
        suc m | rr -> \ f h -> FK.in-add (f m) (RC.DU.DS.sumTo m f) (h (inr tt)) (rr f (\ i -> h (inl i))) } ;
      -- pr_n g_k = sum_{d < Bx} comp n d g_k  for n < Bu
      part-eq (k : Ps.Fin GC.L) (i : Ps.Fin Bu) :
        Id R.R (G.pr (cdeg (finN Bu i)) (GC.gl k)) (RC.DU.DS.sumTo Bx (\ d -> RC.comp (finN Bu i) (toB d) (GC.gl k))) =
        trans (sym (RC.GL.expr-value (toB (finN Bu i)) (G.pr (cdeg (finN Bu i)) (GC.gl k)) (RC.GL.hom-pr (cdeg (finN Bu i)) (GC.gl k))))
          (RC.value-decomp (toB (finN Bu i)) (RC.exprOf (finN Bu i) (GC.gl k)) Bx (fw.2.2.2 k i)) ;
      part-in (k : Ps.Fin GC.L) (i : Ps.Fin Bu) : FK.InComb (G.pr (cdeg (finN Bu i)) (GC.gl k)) =
        FK.in-cong (RC.DU.DS.sumTo Bx (\ d -> RC.comp (finN Bu i) (toB d) (GC.gl k))) (G.pr (cdeg (finN Bu i)) (GC.gl k))
          (sym (part-eq k i))
          (in-sumTo-fin Bx (\ d -> RC.comp (finN Bu i) (toB d) (GC.gl k))
             (\ j -> FK.in-cong (kg (at k i j)) (RC.comp (finN Bu i) (toB (finN Bx j)) (GC.gl k)) (kg-at k i j) (FK.in-gen (at k i j)))) ;
      gen-in (k : Ps.Fin GC.L) : FK.InComb (GC.gl k) =
        FK.in-cong (RC.DU.DS.sumTo Bu (RC.DU.part (GC.gl k))) (GC.gl k) (sym (fw.2.2.1 k).1)
          (in-sumTo-fin Bu (RC.DU.part (GC.gl k)) (part-in k)) ;
      -- the elimination ideal, and ker phi, are spanned by the members
      kernel-elim (u : RK.Blk1) (h : RK.Elim u) : FK.InComb (RK.elR u) =
        GC.MS.mm-rec Gs u (FK.InComb (RK.elR u)) (FK.in-prop (RK.elR u))
          (\ i -> FK.in-cong (RC.RSR.comb GC.L (GC.LG.in-fam Gs u i).1 GC.gl) (RK.elR u)
                    (trans (sym (GC.elR-comb GC.L (GC.LG.in-fam Gs u i).1 (GC.LG.elem Gs))) (ap RK.elR (GC.LG.in-fam Gs u i).2))
                    (FK.in-comb GC.L (GC.LG.in-fam Gs u i).1 GC.gl gen-in))
          (span u h) ;
      kernel (x : R.R) (k : RK.Ker x) : FK.InComb x = kernel-elim (RK.ub x) (RK.ker-elim x k (decR x)) ;
    } ;

    -- THEOREM: merely one fixed finite list of bihomogeneous members of
    -- ker phi spans ker phi
    FiniteGen : U l = (fw : FixedW) * ((x : R.R) -> RK.Ker x -> KG[fw].FK.InComb x) ;
    finite-generation : Tr.Trunc[FiniteGen].carrier = TC.map FixedW FiniteGen (\ fw -> (fw, KG[fw].kernel)) fixed ;
  } ;
} ;
