-- ReesChart4.seg: the homogeneous quotient chart complex of M = S/J, the
-- images of I^k C(S), and the action of kernel generators through the
-- equations P_q (handoff §2 (3)).  Everything is over A, in the four-chart
-- modules C(n) = C^q(n) of Laurent4 (any Cech degree I, any twist n).
--
-- J in the charts.  J = (P_1, .., P_s), P_q = p_q of degree e_q.  The
-- matrix MJ has the rows p_q and no column; its families (HomogeneousMatrices4.Fam)
-- give prod_q C(n - e_q) and the map
--     y |-> sum_q P_q y_q : prod_q C(n - e_q) -> C(n).
-- JC(n) = its image (JW: explicit witness y, InJ: merely); the chart module
-- of M in twist n is C(n) modulo JC(n), the homogeneous quotient (no
-- flatness: nothing about M over A is used).  JC(n) is a submodule
-- (jw-zero, jw-add, jw-neg, jw-sub, jw-sm: the map is linear), so
-- "x = x' modulo J" (Cong: x - x' in JC) is a congruence of A-modules
-- (cong-refl, -sym, -trans, -add, -neg, -sub, -sm, cong-of-id), and x is 0
-- modulo J iff x is in JC (cong-zero, zero-cong).
--
-- Images of I^k.  The class of x lies in I^k C(M) when x is congruent to an
-- element of I^k C(S) with a witness (IJ k x: merely x' with Wit k x' and
-- x - x' in JC, the IMAGE of I^k C(S); I^k (x) M is never used).  Explicit
-- witnesses give classes (ij-of-wit); I C(S) is closed under +, - (wit1-add,
-- wit1-sub), contains I^(k+1) C(S) (wit-one) and the multiples r z of a
-- scalar r in I (wit1-sm: r = sum_j a_j r_j gives r z = sum_j a_j (r_j z));
-- IJ 1 is stable under adding and subtracting elements of I C(S) and under
-- congruence (ij-add, ij-sub, ij-cong).
--
-- Factorisation (Factor).  Let g_1, .., g_N be term lists of degrees d_j
-- and h_qj term lists with every term of e_q + size u = d_j (HomShift),
-- with  coef g_j = coef (sum_q P_q h_qj)  for every j (fac; in ReesCorrection4
-- this comes from (certX) through the bridge).  With MH = (P, h) (rows q,
-- columns j: HomogeneousMatrices4's H maps prod_j C(n - d_j) to
-- prod_q C(n - e_q)) and MG = (g) (no column):
--     sum_j g_j y_j = sum_q P_q (sum_j h_qj y_j)                 (factor)
-- Proof as HomogeneousMatrices4.Fam.AH: the right side is
-- sum_q sum_j P_q (h_qj y_j) (lin-sum), = sum_j sum_q P_q (h_qj y_j)
-- (sum-swap), and for each j pointwise sum_q P_q (h_qj Y) = (sum_q P_q h_qj) Y
-- = g_j Y (mulP-pmul, mulP-psum, act-coef on fac).  So the kernel-generator
-- terms are multiples of the ORIGINAL equations: they lie in JC(n) and
-- vanish in the quotient, not as cochains of S (factor-in).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (a : Ps.Fin t -> A.R)
  (s : Nat) (p : Ps.Fin s -> TPoly A.R) (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
  module HM = HomogeneousMatrices4[l].Over[A,setA] ;
  module PAA = PolynomialAction4[l].Over[A,setA] ;
  module SCA = ShiftedCech4[l].Over[A,setA] ;
  module RSA = Comb[l].Sums[A,IP.regular A] ;
  -- the equations of J: rows p_q, no column
  MJ : Matrices[A] = mkMatrices A s zero e (\ j -> absurd Base.Nat j) p (\ q j -> absurd (TPoly A.R) j) hp
    (\ q j -> absurd (HomShift A.R (e q) (absurd Base.Nat j) (absurd (TPoly A.R) j)) j) ;

  module JC (I : U l) (set : I -> Sub4) (n : Int) {
    module F = HM.Fam[MJ,I,set,n] ;
    module E = F.E0 ;
    module ML = IP.ModL[A,F.E0.mod] ;
    module LJ = RelationCertificate[l].LinL[A,F.E1.mod,F.E0.mod,F.A] ;
    module FC = FiniteIdealPowers[l].Over[A,F.E0.mod,t,a] ;
    module FA = FiniteIdealPowers[l].Over[A,IP.regular A,t,a] ;
    module S0 = F.S0 ;
    module BL = Comb[l].Bilinear[A,F.E0.mod] ;

    -- x in J C(n): x = sum_q P_q y_q, y_q in C(n - e_q)
    JW (x : E.El) : U l = (y : F.E1.El) * Id E.El x (F.A.f y) ;
    InJ (x : E.El) : U l = Tr.Trunc[JW x].carrier ;
    in-prop (x : E.El) : Pr.isProp (InJ x) = Tr.Trunc[JW x].proposition ;
    jw-zero : JW E.mod.mz = (F.E1.mod.mz, sym LJ.f-zero) ;
    jw-add (x x' : E.El) (w : JW x) (w' : JW x') : JW (E.mod.madd x x') =
      (F.E1.mod.madd w.1 w'.1, trans (ML.G.cong-add w.2 w'.2) (sym (F.A.f-add w.1 w'.1))) ;
    jw-neg (x : E.El) (w : JW x) : JW (E.mod.mneg x) = (F.E1.mod.mneg w.1, trans (ap E.mod.mneg w.2) (sym (LJ.f-neg w.1))) ;
    jw-sub (x x' : E.El) (w : JW x) (w' : JW x') : JW (ML.msub x x') = jw-add x (E.mod.mneg x') w (jw-neg x' w') ;
    jw-sm (c : A.R) (x : E.El) (w : JW x) : JW (E.mod.sm c x) = (F.E1.mod.sm c w.1, trans (ap (E.mod.sm c) w.2) (sym (F.A.f-sm c w.1))) ;
    in-zero : InJ E.mod.mz = Tr.Trunc[JW E.mod.mz].inc jw-zero ;
    in-add (x x' : E.El) (h : InJ x) (h' : InJ x') : InJ (E.mod.madd x x') = TC.map2 (JW x) (JW x') (JW (E.mod.madd x x')) (jw-add x x') h h' ;
    in-neg (x : E.El) (h : InJ x) : InJ (E.mod.mneg x) = TC.map (JW x) (JW (E.mod.mneg x)) (jw-neg x) h ;
    in-sm (c : A.R) (x : E.El) (h : InJ x) : InJ (E.mod.sm c x) = TC.map (JW x) (JW (E.mod.sm c x)) (jw-sm c x) h ;
    in-of (x : E.El) (w : JW x) : InJ x = Tr.Trunc[JW x].inc w ;

    -- x = x' modulo J
    Cong (x x' : E.El) : U l = InJ (ML.msub x x') ;
    cong-refl (x : E.El) : Cong x x = subst InJ (sym (ML.sub-self x)) in-zero ;
    cong-of-id (x x' : E.El) (h : Id E.El x x') : Cong x x' = subst (Cong x) h (cong-refl x) ;
    neg-sub (x x' : E.El) : Id E.El (E.mod.mneg (ML.msub x x')) (ML.msub x' x) =
      trans (ML.G.neg-add x (E.mod.mneg x')) (trans (ap (E.mod.madd (E.mod.mneg x)) (ML.G.neg-neg x')) (E.mod.maddC (E.mod.mneg x) x')) ;
    cong-sym (x x' : E.El) (h : Cong x x') : Cong x' x = subst InJ (neg-sub x x') (in-neg (ML.msub x x') h) ;
    sub-chain (x y w : E.El) : Id E.El (E.mod.madd (ML.msub x y) (ML.msub y w)) (ML.msub x w) = calc E.El {
      E.mod.madd (E.mod.madd x (E.mod.mneg y)) (E.mod.madd y (E.mod.mneg w))
        =< sym (E.mod.maddA x (E.mod.mneg y) (E.mod.madd y (E.mod.mneg w))) > E.mod.madd x (E.mod.madd (E.mod.mneg y) (E.mod.madd y (E.mod.mneg w)))
        =< ap (E.mod.madd x) (E.mod.maddA (E.mod.mneg y) y (E.mod.mneg w)) > E.mod.madd x (E.mod.madd (E.mod.madd (E.mod.mneg y) y) (E.mod.mneg w))
        =< ap (\ u -> E.mod.madd x (E.mod.madd u (E.mod.mneg w))) (trans (E.mod.maddC (E.mod.mneg y) y) (E.mod.maddN y))
        > E.mod.madd x (E.mod.madd E.mod.mz (E.mod.mneg w))
        =< ap (E.mod.madd x) (ML.G.zl (E.mod.mneg w)) > ML.msub x w } ;
    cong-trans (x y w : E.El) (h : Cong x y) (h' : Cong y w) : Cong x w =
      subst InJ (sub-chain x y w) (in-add (ML.msub x y) (ML.msub y w) h h') ;
    cong-add (x x' y y' : E.El) (h : Cong x x') (h' : Cong y y') : Cong (E.mod.madd x y) (E.mod.madd x' y') =
      subst InJ (sym (ML.sub-swap x y x' y')) (in-add (ML.msub x x') (ML.msub y y') h h') ;
    cong-neg (y y' : E.El) (h : Cong y y') : Cong (E.mod.mneg y) (E.mod.mneg y') =
      subst InJ (ML.G.neg-add y (E.mod.mneg y')) (in-neg (ML.msub y y') h) ;
    cong-sub (x x' y y' : E.El) (h : Cong x x') (h' : Cong y y') : Cong (ML.msub x y) (ML.msub x' y') =
      cong-add x x' (E.mod.mneg y) (E.mod.mneg y') h (cong-neg y y' h') ;
    cong-sm (c : A.R) (x x' : E.El) (h : Cong x x') : Cong (E.mod.sm c x) (E.mod.sm c x') =
      subst InJ (ML.sm-sub c x x') (in-sm c (ML.msub x x') h) ;
    -- an element of J C(n) is 0 modulo J
    cong-zero (x : E.El) (h : InJ x) : Cong x E.mod.mz = subst InJ (sym (trans (ap (E.mod.madd x) ML.G.neg-zero) (E.mod.maddZ x))) h ;
    zero-cong (x : E.El) (h : Cong x E.mod.mz) : InJ x = subst InJ (trans (ap (E.mod.madd x) ML.G.neg-zero) (E.mod.maddZ x)) h ;

    ------------------------------------------------------------------------
    -- images of I^k C(S) in C(M)

    IJW (k : Base.Nat) (x : E.El) : U l = (x' : E.El) * (FC.Wit k x' * JW (ML.msub x x')) ;
    IJ (k : Base.Nat) (x : E.El) : U l = Tr.Trunc[IJW k x].carrier ;
    ij-of-wit (k : Base.Nat) (x : E.El) (w : FC.Wit k x) : IJ k x =
      Tr.Trunc[IJW k x].inc (x, (w, subst JW (sym (ML.sub-self x)) jw-zero)) ;
    -- I^(k+1) C(S) is in I C(S)
    wit-one (k : Base.Nat) (x : E.El) (w : FC.Wit (suc k) x) : FC.Wit (suc zero) x = (w.1, (\ j -> tt, w.2.2)) ;
    -- I C(S) is closed under + and -
    gen-neg (xs : Ps.Fin t -> E.El) : Id E.El (FC.gen (\ j -> E.mod.mneg (xs j))) (E.mod.mneg (FC.gen xs)) =
      trans (S0.sum-cong t (\ j -> E.mod.sm (a j) (E.mod.mneg (xs j))) (\ j -> E.mod.mneg (E.mod.sm (a j) (xs j))) (\ j -> ML.sm-neg (a j) (xs j)))
        (S0.sum-neg t (\ j -> E.mod.sm (a j) (xs j))) ;
    wit1-add (x y : E.El) (wx : FC.Wit (suc zero) x) (wy : FC.Wit (suc zero) y) : FC.Wit (suc zero) (E.mod.madd x y) =
      (\ j -> E.mod.madd (wx.1 j) (wy.1 j), (\ j -> tt, trans (ML.G.cong-add wx.2.2 wy.2.2) (sym (S0.comb-addv t a wx.1 wy.1)))) ;
    wit1-neg (x : E.El) (wx : FC.Wit (suc zero) x) : FC.Wit (suc zero) (E.mod.mneg x) =
      (\ j -> E.mod.mneg (wx.1 j), (\ j -> tt, trans (ap E.mod.mneg wx.2.2) (sym (gen-neg wx.1)))) ;
    wit1-sub (x y : E.El) (wx : FC.Wit (suc zero) x) (wy : FC.Wit (suc zero) y) : FC.Wit (suc zero) (ML.msub x y) =
      wit1-add x (E.mod.mneg y) wx (wit1-neg y wy) ;
    -- r z for a scalar r in I
    wit1-sm (r : A.R) (wr : FA.Wit (suc zero) r) (z : E.El) : FC.Wit (suc zero) (E.mod.sm r z) =
      (\ j -> E.mod.sm (wr.1 j) z, (\ j -> tt,
        trans (ap (\ c -> E.mod.sm c z) wr.2.2)
          (trans (BL.sm-sum t (\ j -> A.mul (a j) (wr.1 j)) z)
            (S0.sum-cong t (\ j -> E.mod.sm (A.mul (a j) (wr.1 j)) z) (\ j -> E.mod.sm (a j) (E.mod.sm (wr.1 j) z))
               (\ j -> sym (E.mod.smA (a j) (wr.1 j) z)))))) ;
    -- classes in I C(M)
    ij-add (x w : E.El) (h : IJ (suc zero) x) (ww : FC.Wit (suc zero) w) : IJ (suc zero) (E.mod.madd x w) =
      TC.map (IJW (suc zero) x) (IJW (suc zero) (E.mod.madd x w))
        (\ v -> (E.mod.madd v.1 w, (wit1-add v.1 w v.2.1 ww,
                  subst JW (sym (trans (ML.sub-swap x w v.1 w) (trans (ap (E.mod.madd (ML.msub x v.1)) (ML.sub-self w)) (E.mod.maddZ (ML.msub x v.1)))))
                    v.2.2))) h ;
    ij-sub (x w : E.El) (h : IJ (suc zero) x) (ww : FC.Wit (suc zero) w) : IJ (suc zero) (ML.msub x w) =
      ij-add x (E.mod.mneg w) h (wit1-neg w ww) ;
    ij-cong (x y : E.El) (c : Cong x y) (h : IJ (suc zero) y) : IJ (suc zero) x =
      TC.map2 (JW (ML.msub x y)) (IJW (suc zero) y) (IJW (suc zero) x)
        (\ w v -> (v.1, (v.2.1, subst JW (sub-chain x y v.1) (jw-add (ML.msub x y) (ML.msub y v.1) w v.2.2)))) c h ;
  } ;

  ------------------------------------------------------------------------
  -- the action of the kernel generators through the equations

  module Factor (na : Nat) (dd : Ps.Fin na -> Base.Nat) (g : Ps.Fin na -> TPoly A.R) (hg : (j : Ps.Fin na) -> HomDeg A.R (dd j) (g j))
    (h : Ps.Fin s -> Ps.Fin na -> TPoly A.R) (hh : (q : Ps.Fin s) (j : Ps.Fin na) -> HomShift A.R (e q) (dd j) (h q j))
    (fac : (j : Ps.Fin na) (v : N4) -> Id A.R (PAA.coef (g j) v) (PAA.coef (PAA.psum s (\ q -> PAA.pmul (p q) (h q j))) v)) {
    -- rows p_q, columns j with entries h_qj
    MH : Matrices[A] = mkMatrices A s na e dd p h hp hh ;
    -- the generators g_j, no column
    MG : Matrices[A] = mkMatrices A na zero dd (\ j -> absurd Base.Nat j) g (\ i j -> absurd (TPoly A.R) j) hg
      (\ i j -> absurd (HomShift A.R (dd i) (absurd Base.Nat j) (absurd (TPoly A.R) j)) j) ;
    module Fs (I : U l) (set : I -> Sub4) (n : Int) {
      module FH = HM.Fam[MH,I,set,n] ; module FG = HM.Fam[MG,I,set,n] ;
      module CS = SCA.ChartSums[I,BadI I set n] ;
      -- column j: sum_q P_q (h_qj y_j) = g_j y_j
      col (y : FH.E2.El) (j : Ps.Fin na) :
        Id FH.E0.El (FH.S0.sum s (\ q -> (FH.gi q).f ((FH.hij q j).f (y j)))) ((FG.gi j).f (y j)) =
        FH.E0.eq (FH.S0.sum s (\ q -> (FH.gi q).f ((FH.hij q j).f (y j)))) ((FG.gi j).f (y j)) (\ i' m -> calc A.R {
          FH.E0.val (FH.S0.sum s (\ q -> (FH.gi q).f ((FH.hij q j).f (y j)))) i' m
            =< CS.val-sum s (\ q -> (FH.gi q).f ((FH.hij q j).f (y j))) i' m
            > RSA.sum s (\ q -> PAA.mulP (p q) (\ m' -> PAA.mulP (h q j) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m') m)
            =< RSA.sum-cong s (\ q -> PAA.mulP (p q) (\ m' -> PAA.mulP (h q j) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m') m)
                 (\ q -> PAA.mulP (PAA.pmul (p q) (h q j)) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m)
                 (\ q -> sym (PAA.mulP-pmul (p q) (h q j) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m))
            > RSA.sum s (\ q -> PAA.mulP (PAA.pmul (p q) (h q j)) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m)
            =< sym (PAA.mulP-psum s (\ q -> PAA.pmul (p q) (h q j)) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m)
            > PAA.mulP (PAA.psum s (\ q -> PAA.pmul (p q) (h q j))) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m
            =< sym (PAA.act-coef (g j) (PAA.psum s (\ q -> PAA.pmul (p q) (h q j))) (fac j) (HM.LO.Chart[I,BadI I set (FH.k2 j)].val (y j) i') m)
            > FH.E0.val ((FG.gi j).f (y j)) i' m }) ;
      -- sum_j g_j y_j = sum_q P_q (sum_j h_qj y_j)
      factor (y : FH.E2.El) : Id FH.E0.El (FG.A.f y) (FH.A.f (FH.H.f y)) = sym (calc FH.E0.El {
        FH.A.f (FH.H.f y)
          =< FH.S0.sum-cong s (\ q -> (FH.gi q).f (FH.H.f y q)) (\ q -> FH.S0.sum na (\ j -> (FH.gi q).f ((FH.hij q j).f (y j))))
               (\ q -> SCA.LinSum[FH.C1 q,FH.E0.mod,FH.gi q].lin-sum na (\ j -> (FH.hij q j).f (y j)))
          > FH.S0.sum s (\ q -> FH.S0.sum na (\ j -> (FH.gi q).f ((FH.hij q j).f (y j))))
          =< FH.S0.sum-swap s na (\ q j -> (FH.gi q).f ((FH.hij q j).f (y j)))
          > FH.S0.sum na (\ j -> FH.S0.sum s (\ q -> (FH.gi q).f ((FH.hij q j).f (y j))))
          =< FH.S0.sum-cong na (\ j -> FH.S0.sum s (\ q -> (FH.gi q).f ((FH.hij q j).f (y j)))) (\ j -> (FG.gi j).f (y j)) (col y)
          > FG.A.f y }) ;
    } ;
  } ;
} ;
