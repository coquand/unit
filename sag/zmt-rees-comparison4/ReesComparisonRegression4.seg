-- ReesComparisonRegression4.seg: checked instances of the comparison.
--
-- 1. Index sets (ReesFiniteList4).  A rectangle of 2 rows of 3: rect 2 = 6
--    positions; the entry at (row 1, column 1) decodes to (1, 1); finN.
-- 2. Degrees.  N - i for N = 3, i = 1 is 2 (lower-pos, and by computation);
--    (e + k) - e = k for e = 3, k = 2 (sub-eq).
-- 3. The bridge and the factorisation for one kernel element.  Over any
--    commutative set-ring A with one value a_1 (t = 1) and J = (X_0^3)
--    (s = 1, the term list [1 X_0^3] of degree 3):
--      y = U_1 X_0^3 in R = S[U_1], the expression of U-degree 1 with the
--      coefficient X_0^3 of X-degree 3 (BiHom 1 3: bh);
--      g = biT y: every term of X-degree 3 (hom-g), every coefficient of
--      U-degree 1 (coef-g);  ev_a y = a_1 X_0^3 (ev-y), so phi (ev g) = a_1 X_0^3;
--      the coefficient a_1 = H' of X-degree 3 - 3 = 0 as a term list
--      (hterm: ht), phi (ev g) = phi (X_0^3 . ht) (phi-fac), and the
--      factorisation on C^1(-1): (ev g) y = X_0^3 (ht y) (factor1) -- the
--      action of U_1 X_0^3 is the original equation times a_1.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module TL4 = TopList4[l] ;
module RRg = ReesRegression4[l] ; module FL = ReesFiniteList4[l] ;

------------------------------------------------------------------------
-- 1. index sets

two : Nat = suc (suc zero) ;
three : Nat = suc two ;
module R23 = FL.Rect[Nat * Nat,three] ;
rect-six : Id Nat (R23.rect two) (plus three (plus three zero)) = refl (R23.rect two) ;
decode11 : Id (Nat * Nat) (R23.fam two (\ i j -> (FL.finN two i, FL.finN three j)) (R23.idx two (inr tt) (inl (inr tt)))) (suc zero, suc zero) =
  refl (suc zero, suc zero) ;
decode02 : Id (Nat * Nat) (R23.fam two (\ i j -> (FL.finN two i, FL.finN three j)) (R23.idx two (inl (inr tt)) (inr tt))) (zero, two) =
  refl (zero, two) ;

------------------------------------------------------------------------
-- 2. degrees

lower31 : Id Int (lowerZ (cdeg three) (suc zero)) (pos (suc (suc zero))) =
  ReesCorrection4[l].lower-pos (suc zero) (suc zero) three (refl three) ;
lower31-comp : Id Int (lowerZ (cdeg three) (suc zero)) (pos (suc (suc zero))) = refl (pos (suc (suc zero))) ;
sub32 : Id Int (subZ (pos (suc (suc (suc (suc (suc zero)))))) (pos RRg.threeB)) (pos RRg.twoB) =
  ReesBridge4[l].sub-eq RRg.threeB RRg.twoB (suc (suc (suc (suc (suc zero))))) (refl (suc (suc (suc (suc (suc zero)))))) ;

------------------------------------------------------------------------
-- 3. U_1 X_0^3 with J = (X_0^3)

module OverA (A : CRing) (setA : Pr.isSet A.R) (a1 : A.R) {
  module BG = ReesBridge4[l].Over[A,setA,RRg.oneN,\ j -> a1,RRg.oneN,\ q -> RRg.cubicT A,\ q -> RRg.threeB,\ q -> RRg.cubic-hom A] ;
  module CH = ReesChart4[l].Over[A,setA,RRg.oneN,\ j -> a1,RRg.oneN,\ q -> RRg.cubicT A,\ q -> RRg.threeB,\ q -> RRg.cubic-hom A] ;
  module RR = BG.RR ; module BR = RR.BR ; module PAA = PolynomialAction4[l].Over[A,setA] ;
  q0 : Ps.Fin RRg.oneN = inr tt ;
  -- y = U_1 X_0^3: U-degree 1, coefficient X_0^3 of X-degree 3
  ex : RR.RC.GL.Expr (suc zero) = \ j -> RR.P q0 ;
  y : RR.R.R = RR.RC.GL.value (suc zero) ex ;
  bh : RR.RC.BiHom RRg.oneN RRg.threeB y = (ex, (\ j -> RR.hP q0, refl y)) ;
  -- its term list over D = A[U_1]
  g : TPoly BG.D.R = BG.biT RRg.oneN RRg.threeB y bh ;
  hom-g : HomDeg BG.D.R RRg.threeB g = BG.hom-biT RRg.oneN RRg.threeB y bh ;
  coef-g : BG.BA.CoefHom (suc zero) g = BG.coef-biT RRg.oneN RRg.threeB y bh ;
  -- ev_a (U_1 X_0^3) = a_1 X_0^3
  ev-y : Id BR.S.R (RR.RK.RG.ev y) (BR.S.mul (RR.b q0) (RR.P q0)) =
    trans (RR.RK.RG.EV.ev-comb (\ j -> RR.GU.iota.1 (RR.P q0)))
      (trans (BR.S.addZ (BR.S.mul (RR.b q0) (RR.RK.RG.ev (RR.GU.iota.1 (RR.P q0)))))
        (ap (BR.S.mul (RR.b q0)) (RR.GU.ev-iota RR.b (RR.P q0)))) ;
  ev-g : Id BR.S.R (BR.phi (BG.EV.evT g)) (BR.S.mul (RR.b q0) (RR.P q0)) = trans (BG.ev-biT RRg.oneN RRg.threeB y bh) ev-y ;
  -- H' = a_1, of X-degree 3 - 3 = 0, as a term list
  ht : BG.HTerm RRg.threeB RRg.threeB (RR.b q0) = BG.hterm RRg.threeB RRg.threeB (RR.b q0) (RR.hb q0) ;
  phi-fac : Id BR.S.R (BR.phi (BG.EV.evT g)) (BR.phi (PAA.psum RRg.oneN (\ q -> PAA.pmul (RRg.cubicT A) ht.1))) = calc BR.S.R {
    BR.phi (BG.EV.evT g)
      =< ev-g > BR.S.mul (RR.b q0) (RR.P q0)
      =< BR.S.mulC (RR.b q0) (RR.P q0) > BR.S.mul (RR.P q0) (RR.b q0)
      =< ap (BR.S.mul (RR.P q0)) (sym ht.2.2) > BR.S.mul (BR.phi (RRg.cubicT A)) (BR.phi ht.1)
      =< sym (BR.phi-pmul (RRg.cubicT A) ht.1) > BR.phi (PAA.pmul (RRg.cubicT A) ht.1)
      =< sym (trans (BR.phi-psum RRg.oneN (\ q -> PAA.pmul (RRg.cubicT A) ht.1)) (BR.S.addZ (BR.phi (PAA.pmul (RRg.cubicT A) ht.1))))
      > BR.phi (PAA.psum RRg.oneN (\ q -> PAA.pmul (RRg.cubicT A) ht.1)) } ;
  fac (j : Ps.Fin RRg.oneN) (v : N4) : Id A.R (PAA.coef (BG.EV.evT g) v) (PAA.coef (PAA.psum RRg.oneN (\ q -> PAA.pmul (RRg.cubicT A) ht.1)) v) =
    BR.coef-eq-of-phi (BG.EV.evT g) (PAA.psum RRg.oneN (\ q -> PAA.pmul (RRg.cubicT A) ht.1)) phi-fac v ;
  module FA = CH.Factor[RRg.oneN,\ j -> RRg.threeB,\ j -> BG.EV.evT g,\ j -> BG.EV.hom-evT RRg.threeB g hom-g,\ q j -> ht.1,\ q j -> ht.2.1,fac] ;
  module F1 = FA.Fs[Ed,setEd,TL4.mOne] ;
  -- (ev g) y = X_0^3 (a_1 y) on C^1(-1-3)
  factor1 (w : F1.FH.E2.El) : Id F1.FH.E0.El (F1.FG.A.f w) (F1.FH.A.f (F1.FH.H.f w)) = F1.factor w ;
} ;
