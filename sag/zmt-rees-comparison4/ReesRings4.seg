-- ReesRings4.seg: the rings of the Rees presentation over ONE presentation
-- of A[X_0..X_3], the GenAt presentation and the fixed finite list for them
-- (handoff §2 (1), concrete).
--
-- One name for B.  The tower B = D_4(A) of zmt-weighted4 (used by
-- ReesPresentation4) and the iterated ring S = A[X_0][X_1][X_2][X_3] of
-- PolynomialRing4Bridge are the same ring by definition (the same four
-- quotient-ring extensions), but the checker identifies the two
-- presentations only by unfolding all four levels, once per comparison.
-- So every ring here is built over S, the ring of phi, psi and the term
-- lists: the X-degree grading of the tower is GX at type Graded A 4 S (one
-- identification, here), its variables and constants are X_k and cst
-- (var-x0 .. var-x3, iota-cst: by definition, stated once), and
--     R = S[U_1..U_t]  (CoefficientTower over S),  b_j = iota a_j  (X-degree 0).
-- The generators of J are term lists p_q with every term of degree e_q
-- (the handoff's format); P_q = phi p_q has X-degree e_q (hom-phi: X^u has
-- degree size u, degrees add, constants have degree 0).
--
-- The presentation (as ReesPresentation4.Concrete, for this R): S and R are
-- CFN (CoefficientTower.cfnD), DegreeCor.GenAt at m = 0 for the s + t
-- generators P_q, U_j - b_j T gives merely a finite list Gs of elements of
-- the elimination ideal spanning it (presentation); with the decompositions
-- of the towers (decB, decR), ReesFiniteList4 gives merely fixed bounds and
-- the finite list KG spanning ker phi (finite-list).
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module NA = NatArith[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Rings (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (a : Ps.Fin t -> A.R)
  (s : Nat) (p : Ps.Fin s -> TPoly A.R) (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
  module XR = ReesPresentation4[l].XRing[A,setA] ;
  module TL = ReesPresentation4[l].TermLists[A,setA] ;
  module BR = PolynomialRing4Bridge[l].Over[A,setA] ;
  -- the X-degree of the tower, on S
  GX : Graded[A,ReesPresentation4[l].four,BR.S] = XR.GX ;
  module GXL = Laws[A,ReesPresentation4[l].four,BR.S,BR.setS,GX] ;
  -- by definition of the tower: its variables and constants are those of S
  var-x0 : Id BR.S.R (GX.var TL.x0) BR.X0 = refl BR.X0 ;
  var-x1 : Id BR.S.R (GX.var TL.x1) BR.X1 = refl BR.X1 ;
  var-x2 : Id BR.S.R (GX.var TL.x2) BR.X2 = refl BR.X2 ;
  var-x3 : Id BR.S.R (GX.var TL.x3) BR.X3 = refl BR.X3 ;
  iota-cst (c : A.R) : Id BR.S.R (GX.iota.1 c) (BR.cst c) = refl (BR.cst c) ;

  -- X^u has X-degree size u
  hom-times (m n : Base.Nat) (x y : BR.S.R) (hx : GXL.Hom (pos m) x) (hy : GXL.Hom (pos n) y) : GXL.Hom (pos (NA.plus m n)) (BR.S.mul x y) =
    subst (\ k -> GXL.Hom k (BR.S.mul x y)) (ReesPresentation4[l].addP-pos m n) (GXL.hom-mul (pos m) (pos n) x y hx hy) ;
  hom-pw (x : BR.S.R) (hx : GXL.Hom (pos (suc zero)) x) : (n : Base.Nat) -> GXL.Hom (pos n) (BR.pw x n) = split {
    zero -> GXL.hom-one ;
    suc n | r -> GXL.hom-mul (pos n) (pos (suc zero)) (BR.pw x n) x r hx } ;
  hom-cst (k : Int) (c : A.R) (y : BR.S.R) (hy : GXL.Hom k y) : GXL.Hom k (BR.S.mul (BR.cst c) y) =
    subst (\ z -> GXL.Hom k (BR.S.mul z y)) (iota-cst c) (trans (GXL.pr-iota k c y) (ap (BR.S.mul (GX.iota.1 c)) hy)) ;
  size-assoc (u0 u1 u2 u3 : Base.Nat) : Id Base.Nat (NA.plus u0 (NA.plus u1 (NA.plus u2 u3))) (size (nx u0 u1 u2 u3)) =
    sym (trans (NA.plus-assoc (NA.plus u0 u1) u2 u3) (NA.plus-assoc u0 u1 (NA.plus u2 u3))) ;
  hom-term (c : A.R) : (u : N4) -> GXL.Hom (pos (size u)) (BR.term c u) = split {
    nx u0 u1 u2 u3 -> subst (\ k -> GXL.Hom (pos k) (BR.term c (nx u0 u1 u2 u3))) (size-assoc u0 u1 u2 u3)
      (hom-cst (pos (NA.plus u0 (NA.plus u1 (NA.plus u2 u3)))) c
        (BR.S.mul (BR.pw BR.X0 u0) (BR.S.mul (BR.pw BR.X1 u1) (BR.S.mul (BR.pw BR.X2 u2) (BR.pw BR.X3 u3))))
        (hom-times u0 (NA.plus u1 (NA.plus u2 u3)) (BR.pw BR.X0 u0) (BR.S.mul (BR.pw BR.X1 u1) (BR.S.mul (BR.pw BR.X2 u2) (BR.pw BR.X3 u3)))
          (hom-pw BR.X0 (subst (GXL.Hom (pos (suc zero))) var-x0 (GX.var-hom TL.x0)) u0)
          (hom-times u1 (NA.plus u2 u3) (BR.pw BR.X1 u1) (BR.S.mul (BR.pw BR.X2 u2) (BR.pw BR.X3 u3))
            (hom-pw BR.X1 (subst (GXL.Hom (pos (suc zero))) var-x1 (GX.var-hom TL.x1)) u1)
            (hom-times u2 u3 (BR.pw BR.X2 u2) (BR.pw BR.X3 u3)
              (hom-pw BR.X2 (subst (GXL.Hom (pos (suc zero))) var-x2 (GX.var-hom TL.x2)) u2)
              (hom-pw BR.X3 (subst (GXL.Hom (pos (suc zero))) var-x3 (GX.var-hom TL.x3)) u3))))) } ;
  -- a term list of degree dd gives an element of X-degree dd
  hom-phi (dd : Base.Nat) : (q : TPoly A.R) -> HomDeg A.R dd q -> GXL.Hom (pos dd) (BR.phi q) = split {
    nil -> \ h -> GXL.hom-zero (pos dd) ;
    cons u q | r -> \ h -> GXL.hom-add (pos dd) (BR.term u.1 u.2) (BR.phi q)
      (subst (\ k -> GXL.Hom (pos k) (BR.term u.1 u.2)) h.1 (hom-term u.1 u.2)) (r h.2) } ;

  -- the generators of J, of X-degree e_q
  P (q : Ps.Fin s) : BR.S.R = BR.phi (p q) ;
  hP (q : Ps.Fin s) : GXL.Hom (pos (e q)) (P q) = hom-phi (e q) (p q) (hp q) ;
  -- R = S[U_1..U_t] with the U-degree; b_j = a_j of X-degree 0
  module UT = CoefficientPolynomial[l].CoefficientTower[BR.S,BR.setS] ;
  R : CRing = UT.D t ;
  setR : Pr.isSet R.R = UT.setD t ;
  GU : Graded[BR.S,t,R] = UT.grD t ;
  b (j : Ps.Fin t) : BR.S.R = GX.iota.1 (a j) ;
  hb (j : Ps.Fin t) : Id BR.S.R (GX.pr zeroZ (b j)) (b j) = GX.iota-hom (a j) ;
  module RC = ReesComponents4[l].Over[A,ReesPresentation4[l].four,BR.S,BR.setS,GX,t,R,setR,GU,b,s,P,e,hP,hb] ;
  module RK = RC.RK ;
  -- finite decompositions in S and R
  decB : (y : BR.S.R) -> RC.DX.FinDeg y = DegreeDecomposition4[l].TowerDecomposition[A,setA].fin-deg ReesPresentation4[l].four ;
  decR : (x : R.R) -> RC.DU.FinDeg x = DegreeDecomposition4[l].TowerDecomposition[BR.S,BR.setS].fin-deg t ;
  module FL = ReesFiniteList4[l].Over[A,ReesPresentation4[l].four,BR.S,BR.setS,GX,t,R,setR,GU,b,s,P,e,hP,hb] ;

  module WithCFN (K0 : U l) (cfnA : CFN[l].CFN[K0,A]) {
    cfnS : CFN[l].CFN[K0,BR.S] = XR.XT.cfnD K0 cfnA ReesPresentation4[l].four ;
    cfnR : CFN[l].CFN[K0,R] = UT.cfnD K0 cfnS t ;
    -- DegreeCor (Cor. 10) over R, M = R^1, T-degree bound 1, the s + t generators
    module DC = DegreeCor[l].Free[R,cfnR.disc,cfnR.coh,CFN[l].fl K0 R cfnR,suc zero,suc zero,RK.RG.S,RK.RG.gens] ;
    module MS = Spans[l].Over[R,RK.SQ.blk (suc zero)] ;
    -- a finite generating list of the elimination ideal (ReesPresentation4.ReesW, for this R)
    ReesW : U l = (Gs : List RK.Blk1) * (DegreeCor[l].AllL RK.Blk1 RK.Elim Gs * ((u : RK.Blk1) -> RK.Elim u -> MS.Mm Gs u)) ;
    presentation : Tr.Trunc[ReesW].carrier = DC.gen zero ;
    module WithGens (w : ReesW) {
      module F = FL.Gens[decB,decR,w.1,w.2.1,w.2.2] ;
    } ;
    -- THEOREM (handoff (1), concrete): merely a GenAt list and fixed bounds
    -- whose finite list KG spans ker phi
    ListW : U l = (w : ReesW) * WithGens[w].F.FiniteGen ;
    finite-list : Tr.Trunc[ListW].carrier =
      TC.bind ReesW ListW (\ w -> TC.map WithGens[w].F.FiniteGen ListW (\ x -> (w, x)) WithGens[w].F.finite-generation) presentation ;
  } ;
} ;
