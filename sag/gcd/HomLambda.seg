-- HomLambda.seg: the data (S0)/(S1) of acl-zmt-formalisation.tex §F2 for
-- homogeneous P, Q (lists with exponents >= 0, of degrees d, e, both not
-- identically 0), over a gcd domain A.
--
--  * D0 = gcd(P,Q) in S, P = D0 P', Q = D0 Q' (Lambda.Data) ; by
--    HomDivisor.Divisor, D0, P', Q' are homogeneous of degrees r, d', e' with
--    r + d' = d, r + e' = e ;
--  * D0h, P'h, Q'h : the lists of D0, P', Q' filtered to these degrees: every
--    term is homogeneous (HomPI), same meaning ;
--  * in Lambda: D0h P'h = P, D0h Q'h = Q ;
--  * (S0) D0h f = 0, f finitely supported, gives f = 0 ;
--  * (S1) for al in SL ka, be in SL kb (CechModules: homogeneous and finitely
--    supported) with ka = kW + e', kb = kW + d' and P'h al + Q'h be = 0, a w in
--    SL kW with al = -Q'h w, be = P'h w : the w of Lambda.Data.s1, projected
--    to degree kW (hproj, as in acl-zmt/ACLS1).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module LLt = LaurentList[l] ; module NA = NatArith[l] ;
module DGt = Degrees[l] ; module HMt = Homog[l] ;

add-sub (k d : Int) : Id Int (add (add k d) (neg d)) k = trans (assoc k d (neg d)) (ap (add k) (invr d)) ;
toB-iff {X Y : U l} (fxy : X -> Y) (fyx : Y -> X) : (d : LG.Dec X) (d' : LG.Dec Y) -> Id Bool (LLt.toB d) (LLt.toB d') = split {
 yes p -> split { yes q -> refl true ; no n -> Pr.absurd _ (n (fxy p)) } ;
 no n -> split { yes q -> Pr.absurd _ (n (fyx q)) ; no n' -> refl false } } ;
-- the condition "degree kk" on exponents
qdk (kk : Int) (m : E3) : Bool = LLt.toB (int-dec (deg m) kk) ;

module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 module HD = HomDivisor[l].Over[A,G] ;
 module HM = HD.HM ; module DG = HD.DG ; module LA = HD.LA ; module PS = HD.PS ; module LO = HD.LO ;
 module LL = LA.LL ;
 module CMd = CechModules[l].Over[A,G.set] ;
 module CCA = CechContraction[l].Over[A] ;
 S : CRing = HD.S ;
 Lau : U l = LO.Lau ;

 ---------------------------------------------------------------------
 -- the homogeneous component of degree kk of a Laurent element

 hproj (kk : Int) (f : Lau) : Lau = \ m -> LO.ifB (qdk kk m) (f m) ;
 hproj-hom (kk : Int) (f : Lau) : LO.Hom kk (hproj kk f) =
  \ m ne -> ap (\ bb -> LO.ifB bb (f m)) (HMt.toB-no ne (int-dec (deg m) kk)) ;
 hproj-fin (kk : Int) (f : Lau) (h : LL.Fin f) : LL.Fin (hproj kk f) =
  LL.Point[\ m v -> LO.ifB (qdk kk m) v,\ m u v -> CCA.ifB-add (qdk kk m) u v].fin-point f h ;
 hp-pt (kk : Int) (f : Lau) (h : LO.Hom kk f) (m : E3) : (bb : Bool) -> Id Bool (qdk kk m) bb -> Id A.R (hproj kk f m) (f m) = split {
  true -> \ e -> ap (\ c -> LO.ifB c (f m)) e ;
  false -> \ e -> trans (ap (\ c -> LO.ifB c (f m)) e) (sym (h m (HMt.toB-false (int-dec (deg m) kk) e))) } ;
 hproj-id (kk : Int) (f : Lau) (h : LO.Hom kk f) : LO.EqL (hproj kk f) f = \ m -> hp-pt kk f h m (qdk kk m) (refl (qdk kk m)) ;
 q-shift (kk k' : Int) (m e : E3) (he : Id Int (deg e) k') : Id Bool (qdk kk (sub3 m e)) (qdk (add kk k') m) =
  toB-iff (\ x -> sub-solve (deg m) k' kk (trans (sym (trans (deg-sub m e) (ap (\ y -> add (deg m) (neg y)) he))) x))
          (\ y -> trans (trans (deg-sub m e) (ap (\ z -> add (deg m) (neg z)) he))
                        (trans (ap (\ z -> add z (neg k')) y) (add-sub kk k')))
          (int-dec (deg (sub3 m e)) kk) (int-dec (deg m) (add kk k')) ;
 -- g (f_kk) = (g f)_(kk+k') for g homogeneous of degree k'
 hproj-mul (kk k' : Int) (f : Lau) : (g : LO.LPoly) -> LO.HomPI k' g -> LO.EqL (LO.mulP g (hproj kk f)) (hproj (add kk k') (LO.mulP g f)) = split {
  nil -> \ hg m -> sym (CCA.ifB-zero (qdk (add kk k') m)) ;
  cons t g | r -> \ hg m ->
   trans (Presentations[l].cong2 A.R A.add _ _ _ _
            (trans (ap (\ bb -> A.mul t.1 (LO.ifB bb (f (sub3 m t.2)))) (q-shift kk k' m t.2 hg.1))
                   (sym (CCA.ifB-scale (qdk (add kk k') m) t.1 (f (sub3 m t.2)))))
            (r hg.2 m))
         (sym (CCA.ifB-add (qdk (add kk k') m) (A.mul t.1 (f (sub3 m t.2))) (LO.mulP g f m))) } ;

 ---------------------------------------------------------------------
 -- homogeneous elements of S and their lists

 -- a homogeneous x vanishes outside its degree
 off-cmp (x : S.R) (k : Nat) (hx : HD.Hom k x) (m : E3) (j : Nat) (e : Id Int (deg m) (pos j)) (ne : LG.Not (Id Int (deg m) (pos k))) :
  Plus ((d : Nat) * Id Nat j (NA.plus k d)) ((d : Nat) * Id Nat k (NA.plus j (suc d))) -> Id A.R (PS.psi x m) A.z = split {
  inl p -> off-up p.1 p.2 ;
  inr p -> hx.2 m j p.1 e p.2 }
  where {
   off-up : (d : Nat) -> Id Nat j (NA.plus k d) -> Id A.R (PS.psi x m) A.z = split {
    zero -> \ ej -> Pr.absurd _ (ne (trans e (ap (\ n -> pos n) (trans ej (NA.plus-zero k))))) ;
    suc d -> \ ej -> hx.1 m d (trans e (ap (\ n -> pos n) (trans ej (NA.plus-suc k d)))) } } ;
 off-at (x : S.R) (k : Nat) (hx : HD.Hom k x) (m : E3) (ne : LG.Not (Id Int (deg m) (pos k))) : (i : Int) -> Id Int (deg m) i -> Id A.R (PS.psi x m) A.z = split {
  pos j -> \ e -> off-cmp x k hx m j e ne (DGt.cmp j k) ;
  negsuc n -> \ e -> DG.psi-neg-deg x m n e } ;
 hom-psi (x : S.R) (k : Nat) (hx : HD.Hom k x) : LO.Hom (pos k) (PS.psi x) = \ m ne -> off-at x k hx m ne (deg m) (refl (deg m)) ;
 -- the list of x filtered to degree k
 hl (k : Nat) (x : S.R) : LO.LPoly = LL.filt (qdk (pos k)) (LA.lst x) ;
 hl-coef (k : Nat) (x : S.R) (hx : HD.Hom k x) : LO.EqL (LL.coef (hl k x)) (LL.coef (LA.lst x)) = \ m ->
  trans (LL.filt-coef (qdk (pos k)) (PS.psi x)
          (\ m' e -> hom-psi x k hx m' (HMt.toB-false (int-dec (deg m') (pos k)) e)) (LA.lst x) (\ m' -> sym (LA.psi-coef x m')) m)
   (LA.psi-coef x m) ;
 allq-hom (kk : Int) : (g : LO.LPoly) -> LL.AllQ (qdk kk) g -> LO.HomPI kk g = split {
  nil -> \ h -> tt ;
  cons t g | r -> \ h -> (HMt.toB-true (int-dec (deg t.2) kk) h.1, r h.2) } ;
 hl-hom (k : Nat) (x : S.R) : LO.HomPI (pos k) (hl k x) = allq-hom (pos k) (hl k x) (LL.allq-filt (qdk (pos k)) (LA.lst x)) ;
 -- the filtered lists of S have exponents >= 0
 nn-ifL (q : E3 -> Bool) (t : LL.Term) (r : LO.LPoly) (hx : Id Bool (isNeg (ex t.2)) false) (hy : Id Bool (isNeg (ey t.2)) false)
  (hz : Id Bool (isNeg (ez t.2)) false) (h : LO.NonNegX r * (LO.NonNegY r * CMd.NonNegZ r)) :
  (b : Bool) -> LO.NonNegX (LL.ifL b t r) * (LO.NonNegY (LL.ifL b t r) * CMd.NonNegZ (LL.ifL b t r)) = split {
  true -> ((hx, h.1), ((hy, h.2.1), (hz, h.2.2))) ;
  false -> h } ;
 nn-filt (q : E3 -> Bool) : (g : HD.LA.PH.NList) ->
  LO.NonNegX (LL.filt q (HD.LA.PH.embL g)) * (LO.NonNegY (LL.filt q (HD.LA.PH.embL g)) * CMd.NonNegZ (LL.filt q (HD.LA.PH.embL g))) = split {
  nil -> (tt, (tt, tt)) ;
  cons t g | r -> nn-ifL q (HD.LA.PH.emb t) (LL.filt q (HD.LA.PH.embL g)) (refl false) (refl false) (refl false) r (q (HD.LA.PH.embE t.2)) } ;
 -- the filtered list is a polynomial of degree k (CechModules.IsPoly)
 hl-poly (k : Nat) (x : S.R) : CMd.IsPoly (pos k) (hl k x) =
  ((nn-filt (qdk (pos k)) (HD.LA.PH.nl x)).1, ((nn-filt (qdk (pos k)) (HD.LA.PH.nl x)).2.1, ((nn-filt (qdk (pos k)) (HD.LA.PH.nl x)).2.2, hl-hom k x))) ;
 -- a list with all terms of degree k means a function of degree k
 delta-hom : LO.Hom zeroZ LL.delta = \ m ne -> LL.ifD-no (\ e -> ne (sym (ap deg e))) (LLt.dec3 LLt.zero3 m) A.o ;
 list-hom (k : Nat) (g : LO.LPoly) (hg : LO.HomPI (pos k) g) : LO.Hom (pos k) (LL.coef g) = \ m ne ->
  trans (LL.coef-delta g m) (LO.hom-tr (add zeroZ (pos k)) (pos k) (zero-l (pos k)) (LO.mulP g LL.delta)
    (LO.hom-mulI zeroZ (pos k) LL.delta delta-hom g hg) m ne) ;
 -- Up and Dn from a homogeneous meaning
 up-of (x : S.R) (k : Nat) (h : LO.Hom (pos k) (PS.psi x)) : DG.Up (suc k) x = \ m d e ->
  h m (\ e' -> HMt.ne-suc k d (DGt.pos-inj (suc (NA.plus k d)) k (trans (sym e) e'))) ;
 dn-of (x : S.R) (k : Nat) (h : LO.Hom (pos k) (PS.psi x)) : DG.Dn k x = \ m j d e en ->
  h m (\ e' -> HMt.ne-suc j d (DGt.pos-inj (suc (NA.plus j d)) j
    (trans (ap (\ n -> pos n) (sym (trans en (NA.plus-suc j d)))) (trans (sym e') e)))) ;

 ---------------------------------------------------------------------
 -- the data

 module Data (PL QL : LO.LPoly) (hP : Shift[l].Le' (LA.SH.Bsum PL) zero) (hQ : Shift[l].Le' (LA.SH.Bsum QL) zero)
  (m0 : E3) (nP0 : Not (Id A.R (LL.coef PL m0) A.z)) (n0 : E3) (nQ0 : Not (Id A.R (LL.coef QL n0) A.z))
  (d e : Nat) (hPd : LO.HomPI (pos d) PL) (hQe : LO.HomPI (pos e) QL) {
  module LD = LA.Data[PL,QL,hP,hQ,m0,nP0] ;
  module SY = LD.SY ;
  nQ : Not (Id S.R LD.Qs S.z) = \ ez ->
   nQ0 (trans (sym (LD.psi-Q n0)) (trans (ap (\ u -> PS.psi u n0) ez) (PS.psi-zero n0))) ;
  nQ' : Not (Id S.R SY.Q' S.z) = \ ez -> nQ (trans SY.eQ (trans (ap (S.mul SY.D0) ez) (RL[S].mul-zero SY.D0))) ;
  homP : LO.Hom (pos d) (PS.psi LD.Ps) = \ m ne -> trans (LD.psi-P m) (list-hom d PL hPd m ne) ;
  homQ : LO.Hom (pos e) (PS.psi LD.Qs) = \ m ne -> trans (LD.psi-Q m) (list-hom e QL hQe m ne) ;
  module DP = HD.Divisor[SY.D0,SY.P',SY.nD0,SY.nP',d,
    subst (\ u -> DG.Up (suc d) u) SY.eP (up-of LD.Ps d homP),
    subst (\ u -> DG.Dn d u) SY.eP (dn-of LD.Ps d homP)] ;
  module DQ = HD.Divisor[SY.D0,SY.Q',SY.nD0,nQ',e,
    subst (\ u -> DG.Up (suc e) u) SY.eQ (up-of LD.Qs e homQ),
    subst (\ u -> DG.Dn e u) SY.eQ (dn-of LD.Qs e homQ)] ;
  -- the degrees
  r : Nat = DP.TP.T ;
  d' : Nat = DP.TP.T' ;
  e' : Nat = DQ.TP.T' ;
  sum-P : Id Nat (NA.plus r d') d = DP.top-sum ;
  sum-Q : Id Nat (NA.plus r e') e = DQ.top-sum ;
  -- the homogeneous lists
  D0h : LO.LPoly = hl r SY.D0 ;
  P'h : LO.LPoly = hl d' SY.P' ;
  Q'h : LO.LPoly = hl e' SY.Q' ;
  D0h-hom : LO.HomPI (pos r) D0h = hl-hom r SY.D0 ;
  P'h-hom : LO.HomPI (pos d') P'h = hl-hom d' SY.P' ;
  Q'h-hom : LO.HomPI (pos e') Q'h = hl-hom e' SY.Q' ;
  cD : LO.EqL (LL.coef D0h) (LL.coef LD.D0L) = hl-coef r SY.D0 DP.hom-x ;
  cP : LO.EqL (LL.coef P'h) (LL.coef LD.P'L) = hl-coef d' SY.P' DP.hom-y ;
  cQ : LO.EqL (LL.coef Q'h) (LL.coef LD.Q'L) = hl-coef e' SY.Q' DQ.hom-y ;
  mD (f : Lau) : LO.EqL (LO.mulP D0h f) (LO.mulP LD.D0L f) = LA.LP.mulP-resp D0h LD.D0L cD f ;
  mP (f : Lau) : LO.EqL (LO.mulP P'h f) (LO.mulP LD.P'L f) = LA.LP.mulP-resp P'h LD.P'L cP f ;
  mQ (f : Lau) : LO.EqL (LO.mulP Q'h f) (LO.mulP LD.Q'L f) = LA.LP.mulP-resp Q'h LD.Q'L cQ f ;
  -- P = D0 P', Q = D0 Q' in Lambda
  P-eq : LO.EqL (LO.mulP D0h (LL.coef P'h)) (LL.coef PL) = \ m ->
   trans (mD (LL.coef P'h) m) (trans (LO.mulP-cong LD.D0L (LL.coef P'h) (LL.coef LD.P'L) cP m) (LD.P-eq m)) ;
  Q-eq : LO.EqL (LO.mulP D0h (LL.coef Q'h)) (LL.coef QL) = \ m ->
   trans (mD (LL.coef Q'h) m) (trans (LO.mulP-cong LD.D0L (LL.coef Q'h) (LL.coef LD.Q'L) cQ m) (LD.Q-eq m)) ;
  -- (S0)
  s0 (f : Lau) (hf : LL.Fin f) (hz : LO.EqL (LO.mulP D0h f) LO.zeroL) : LO.EqL f LO.zeroL =
   LD.s0 f hf (\ m -> trans (sym (mD f m)) (hz m)) ;
  -- (S1), homogeneous
  S1T (kW : Int) : U l = (al be : Lau) -> CMd.SL (add kW (pos e')) al -> CMd.SL (add kW (pos d')) be ->
   LO.EqL (LO.addL (LO.mulP P'h al) (LO.mulP Q'h be)) LO.zeroL ->
   (w : Lau) * (CMd.SL kW w * (LO.EqL al (LO.negL (LO.mulP Q'h w)) * LO.EqL be (LO.mulP P'h w))) ;
  module S1H (kW : Int) (al be : Lau) (ha : CMd.SL (add kW (pos e')) al) (hb : CMd.SL (add kW (pos d')) be)
   (h : LO.EqL (LO.addL (LO.mulP P'h al) (LO.mulP Q'h be)) LO.zeroL) {
   h' : LO.EqL (LO.addL (LO.mulP LD.P'L al) (LO.mulP LD.Q'L be)) LO.zeroL = \ m ->
    trans (Presentations[l].cong2 A.R A.add _ _ _ _ (sym (mP al m)) (sym (mQ be m))) (h m) ;
   sol : LD.Sol al be = LD.s1 al be ha.2 hb.2 h' ;
   w : Lau = hproj kW sol.1 ;
   -- Q'h w0 = -al, P'h w0 = be
   qw0 : LO.EqL (LO.mulP Q'h sol.1) (LO.negL al) = \ m ->
    trans (mQ sol.1 m) (trans (sym (RL[A].neg-neg (LO.mulP LD.Q'L sol.1 m))) (ap A.neg (sym (sol.2.2.1 m)))) ;
   pw0 : LO.EqL (LO.mulP P'h sol.1) be = \ m -> trans (mP sol.1 m) (sym (sol.2.2.2 m)) ;
   be-eq : LO.EqL be (LO.mulP P'h w) = \ m ->
    sym (trans (hproj-mul kW (pos d') sol.1 P'h P'h-hom m)
      (trans (ap (LO.ifB (qdk (add kW (pos d')) m)) (pw0 m)) (hproj-id (add kW (pos d')) be hb.1 m))) ;
   al-eq : LO.EqL al (LO.negL (LO.mulP Q'h w)) = \ m ->
    trans (sym (RL[A].neg-neg (al m)))
     (ap A.neg (sym (trans (hproj-mul kW (pos e') sol.1 Q'h Q'h-hom m)
       (trans (ap (LO.ifB (qdk (add kW (pos e')) m)) (qw0 m))
        (hproj-id (add kW (pos e')) (LO.negL al) (LO.neg-hom (add kW (pos e')) al ha.1) m))))) ;
   result : (w : Lau) * (CMd.SL kW w * (LO.EqL al (LO.negL (LO.mulP Q'h w)) * LO.EqL be (LO.mulP P'h w))) =
    (w, ((hproj-hom kW sol.1, hproj-fin kW sol.1 sol.2.1), (al-eq, be-eq))) ;
  } ;
  s1 (kW : Int) : S1T kW = \ al be ha hb h -> S1H[kW,al,be,ha,hb,h].result ;
  P'h-poly : CMd.IsPoly (pos d') P'h = hl-poly d' SY.P' ;
  Q'h-poly : CMd.IsPoly (pos e') Q'h = hl-poly e' SY.Q' ;
  -- P f = D0 (P' f), Q f = D0 (Q' f) for every Laurent element f
  mul-eq (Pl X' : LO.LPoly) (eq : LO.EqL (LO.mulP D0h (LL.coef X')) (LL.coef Pl)) (f : Lau) : LO.EqL (LO.mulP Pl f) (LO.mulP D0h (LO.mulP X' f)) = \ m ->
   trans (LA.LP.mulP-resp Pl (LL.mulL D0h X') (\ m' -> trans (sym (eq m')) (sym (LL.coef-mulL D0h X' m'))) f m)
    (LL.mulP-mulL D0h X' f m) ;
  fP (f : Lau) : LO.EqL (LO.mulP PL f) (LO.mulP D0h (LO.mulP P'h f)) = mul-eq PL P'h P-eq f ;
  fQ (f : Lau) : LO.EqL (LO.mulP QL f) (LO.mulP D0h (LO.mulP Q'h f)) = mul-eq QL Q'h Q-eq f ;
 } ;
} ;
