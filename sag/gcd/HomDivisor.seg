-- HomDivisor.seg: extreme components of a product, and the divisors of a
-- non-zero homogeneous element of S (doc/gcd-polynomial.tex, point
-- délicat 6 (ii); see Homog.seg for the plan).
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module NA = NatArith[l] ;
module DGt = Degrees[l] ;

-- r + r' = 0 gives r = 0
plus-zero-l : (r r' : Nat) -> Id Nat zero (NA.plus r r') -> Id Nat r zero = split {
 zero -> \ r' e -> refl zero ;
 suc r -> \ r' e -> Pr.absurd _ (not-code zero (suc (NA.plus r r')) e) } ;
-- (B + r) + (B' + r') = (B + B') + (r + r')
swap4 (a b c d : Nat) : Id Nat (NA.plus (NA.plus a b) (NA.plus c d)) (NA.plus (NA.plus a c) (NA.plus b d)) =
 trans (NA.plus-assoc a b (NA.plus c d))
  (trans (ap (NA.plus a) (trans (sym (NA.plus-assoc b c d)) (trans (ap (\ n -> NA.plus n d) (NA.plus-comm b c)) (NA.plus-assoc c b d))))
   (sym (NA.plus-assoc a c (NA.plus b d)))) ;
-- (a + b) + 1 = a + (b + 1)
plus-one (a b : Nat) : Id Nat (NA.plus a (suc b)) (NA.plus (NA.plus a b) (suc zero)) =
 trans (NA.plus-suc a b) (trans (ap {Nat} {Nat} (\ k -> suc k) (sym (NA.plus-zero (NA.plus a b)))) (sym (NA.plus-suc (NA.plus a b) zero))) ;

module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 module HM = Homog[l].Over[A,G] ;
 module DG = HM.DG ; module LA = HM.LA ; module PS = HM.PS ; module LO = HM.LO ;
 S : CRing = HM.S ;
 module RS = RL[S] ;
 module GS = HM.GS ;
 Hom (n : Nat) (x : S.R) : U l = DG.Up (suc n) x * DG.Dn n x ;
 comp-hom (n : Nat) (x : S.R) : Hom n (HM.comp n x) = (HM.comp-up n x, HM.comp-dn n x) ;

 -- a non-zero coefficient of a homogeneous element is in its degree
 dz (x : S.R) (n : Nat) (hx : Hom n x) (m : E3) (nz : Not (Id A.R (PS.psi x m) A.z)) (j : Nat) (e : Id Int (deg m) (pos j)) :
  (d : Nat) -> Id Nat j (NA.plus n d) -> Id Nat j n = split {
  zero -> \ ej -> trans ej (NA.plus-zero n) ;
  suc d -> \ ej -> efq (nz (hx.1 m d (trans e (ap (\ k -> pos k) (trans ej (NA.plus-suc n d)))))) } ;
 deg-cmp (x : S.R) (n : Nat) (hx : Hom n x) (m : E3) (nz : Not (Id A.R (PS.psi x m) A.z)) (j : Nat) (e : Id Int (deg m) (pos j)) :
  Plus ((d : Nat) * Id Nat j (NA.plus n d)) ((d : Nat) * Id Nat n (NA.plus j (suc d))) -> Id Nat j n = split {
  inl p -> dz x n hx m nz j e p.1 p.2 ;
  inr p -> efq (nz (hx.2 m j p.1 e p.2)) } ;
 deg-at (x : S.R) (n : Nat) (hx : Hom n x) (m : E3) (nz : Not (Id A.R (PS.psi x m) A.z)) : (k : Int) -> Id Int (deg m) k -> Id Int (deg m) (pos n) = split {
  pos j -> \ e -> trans e (ap (\ k -> pos k) (deg-cmp x n hx m nz j e (DGt.cmp j n))) ;
  negsuc i -> \ e -> efq (nz (DG.psi-neg-deg x m i e)) } ;
 deg-of (x : S.R) (n : Nat) (hx : Hom n x) (m : E3) (nz : Not (Id A.R (PS.psi x m) A.z)) : Id Int (deg m) (pos n) =
  deg-at x n hx m nz (deg m) (refl (deg m)) ;

 -- x - comp T x has no component >= T, x - comp B x none < B + 1
 lu (x : S.R) (T : Nat) (upx : DG.Up (suc T) x) (m : E3) : (d : Nat) -> Id Int (deg m) (pos (NA.plus T d)) -> Id A.R (PS.psi (S.add x (S.neg (HM.comp T x))) m) A.z = split {
    zero -> \ e -> trans (PS.psi-add x (S.neg (HM.comp T x)) m)
      (trans (ap (A.add (PS.psi x m)) (trans (PS.psi-neg (HM.comp T x) m) (ap A.neg (HM.comp-at T x m (trans e (ap (\ k -> pos k) (NA.plus-zero T)))))))
       (A.addN (PS.psi x m))) ;
    suc d -> \ e -> trans (PS.psi-add x (S.neg (HM.comp T x)) m)
      (trans (Presentations[l].cong2 A.R A.add _ _ _ _ (upx m d (trans e (ap (\ k -> pos k) (NA.plus-suc T d))))
         (trans (PS.psi-neg (HM.comp T x) m) (trans (ap A.neg (HM.comp-up T x m d (trans e (ap (\ k -> pos k) (NA.plus-suc T d))))) (RL[A].neg-zero))))
       (A.addZ A.z)) } ;
 lo-up (x : S.R) (T : Nat) (upx : DG.Up (suc T) x) : DG.Up T (S.add x (S.neg (HM.comp T x))) = \ m d -> lu x T upx m d ;
 hd (x : S.R) (B : Nat) (dnx : DG.Dn B x) (m : E3) (j : Nat) (e : Id Int (deg m) (pos j)) : (d : Nat) -> Id Nat B (NA.plus j d) -> Id A.R (PS.psi (S.add x (S.neg (HM.comp B x))) m) A.z = split {
    zero -> \ eb -> trans (PS.psi-add x (S.neg (HM.comp B x)) m)
      (trans (ap (A.add (PS.psi x m)) (trans (PS.psi-neg (HM.comp B x) m)
         (ap A.neg (HM.comp-at B x m (trans e (ap (\ k -> pos k) (sym (trans eb (NA.plus-zero j)))))))))
       (A.addN (PS.psi x m))) ;
    suc d -> \ eb -> trans (PS.psi-add x (S.neg (HM.comp B x)) m)
      (trans (Presentations[l].cong2 A.R A.add _ _ _ _ (dnx m j d e eb)
         (trans (PS.psi-neg (HM.comp B x) m) (trans (ap A.neg (HM.comp-dn B x m j d e eb)) (RL[A].neg-zero))))
       (A.addZ A.z)) } ;
 hi-dn (x : S.R) (B : Nat) (dnx : DG.Dn B x) : DG.Dn (suc B) (S.add x (S.neg (HM.comp B x))) = \ m j d e en ->
  hd x B dnx m j e d (NA.suc-inj (trans en (NA.plus-suc j d))) ;

 -- x y = h h' + (h (y - h') + (x - h) y)
 add-sub (a b : S.R) : Id S.R (S.add a (S.add b (S.neg a))) b =
  trans (RS.add-swap a b (S.neg a)) (trans (ap (S.add b) (S.addN a)) (S.addZ b)) ;
 split-prod (x y h h' : S.R) :
  Id S.R (S.mul x y) (S.add (S.mul h h') (S.add (S.mul h (S.add y (S.neg h'))) (S.mul (S.add x (S.neg h)) y))) =
  sym (trans (S.addA (S.mul h h') (S.mul h (S.add y (S.neg h'))) (S.mul (S.add x (S.neg h)) y))
   (trans (ap (\ u -> S.add u (S.mul (S.add x (S.neg h)) y)) (trans (sym (S.dist h h' (S.add y (S.neg h')))) (ap (S.mul h) (add-sub h' y))))
    (trans (sym (RS.dist-left h (S.add x (S.neg h)) y)) (ap (\ u -> S.mul u y) (add-sub h x))))) ;
 psi-split (x y h h' : S.R) (m : E3) (z1 : Id A.R (PS.psi (S.mul h (S.add y (S.neg h'))) m) A.z)
  (z2 : Id A.R (PS.psi (S.mul (S.add x (S.neg h)) y) m) A.z) : Id A.R (PS.psi (S.mul x y) m) (PS.psi (S.mul h h') m) =
  trans (ap (\ u -> PS.psi u m) (split-prod x y h h'))
   (trans (PS.psi-add (S.mul h h') (S.add (S.mul h (S.add y (S.neg h'))) (S.mul (S.add x (S.neg h)) y)) m)
    (trans (ap (A.add (PS.psi (S.mul h h') m))
              (trans (PS.psi-add (S.mul h (S.add y (S.neg h'))) (S.mul (S.add x (S.neg h)) y) m)
                     (trans (Presentations[l].cong2 A.R A.add _ _ _ _ z1 z2) (A.addZ A.z))))
     (A.addZ (PS.psi (S.mul h h') m)))) ;
 ExtremeAt (x y : S.R) (n : Nat) : U l = (m : E3) * (Id Int (deg m) (pos n) * Not (Id A.R (PS.psi (S.mul x y) m) A.z)) ;

 -- the top components multiply
 module TopProd (x y : S.R) (nx : Not (Id S.R x S.z)) (ny : Not (Id S.R y S.z)) {
  tx : HM.TopOf x = HM.Search[x,nx].top ;
  ty : HM.TopOf y = HM.Search[y,ny].top ;
  T : Nat = tx.1 ;
  T' : Nat = ty.1 ;
  hi : S.R = HM.comp T x ;
  hi' : S.R = HM.comp T' y ;
  hh : S.R = S.mul hi hi' ;
  nhh : Not (Id S.R hh S.z) = GS.D.mul-nonzero hi hi' tx.2.2 ty.2.2 ;
  hom-hh : Hom (NA.plus T T') hh =
   (\ m d e -> DG.up-mul T (suc T') hi hi' (HM.comp-up T x) (HM.comp-up T' y) m d (trans e (ap (\ k -> pos (NA.plus k d)) (sym (NA.plus-suc T T')))),
    DG.dn-mul T T' hi hi' (HM.comp-dn T x) (HM.comp-dn T' y)) ;
  at-top (m : E3) (e : Id Int (deg m) (pos (NA.plus T T'))) : Id A.R (PS.psi (S.mul x y) m) (PS.psi hh m) =
   psi-split x y hi hi' m
    (DG.up-mul T T' hi (S.add y (S.neg hi')) (HM.comp-up T x) (lo-up y T' ty.2.1) m zero (trans e (ap (\ k -> pos k) (sym (NA.plus-zero (NA.plus T T'))))))
    (trans (ap (\ u -> PS.psi u m) (S.mulC (S.add x (S.neg hi)) y))
      (DG.up-mul T' T y (S.add x (S.neg hi)) ty.2.1 (lo-up x T tx.2.1) m zero
        (trans e (ap (\ k -> pos k) (trans (NA.plus-comm T T') (sym (NA.plus-zero (NA.plus T' T)))))))) ;
  w : (m : E3) * Not (Id A.R (PS.psi hh m) A.z) = HM.witness hh nhh ;
  result : ExtremeAt x y (NA.plus T T') =
   (w.1, (deg-of hh (NA.plus T T') hom-hh w.1 w.2, \ e0 -> w.2 (trans (sym (at-top w.1 (deg-of hh (NA.plus T T') hom-hh w.1 w.2))) e0))) ;
 } ;

 -- the bottom components multiply
 module BotProd (x y : S.R) (nx : Not (Id S.R x S.z)) (ny : Not (Id S.R y S.z)) {
  bx : HM.BotOf x = HM.Search[x,nx].bot ;
  by : HM.BotOf y = HM.Search[y,ny].bot ;
  B : Nat = bx.1 ;
  B' : Nat = by.1 ;
  lo : S.R = HM.comp B x ;
  lo' : S.R = HM.comp B' y ;
  ll : S.R = S.mul lo lo' ;
  nll : Not (Id S.R ll S.z) = GS.D.mul-nonzero lo lo' bx.2.2 by.2.2 ;
  hom-ll : Hom (NA.plus B B') ll =
   (\ m d e -> DG.up-mul B (suc B') lo lo' (HM.comp-up B x) (HM.comp-up B' y) m d (trans e (ap (\ k -> pos (NA.plus k d)) (sym (NA.plus-suc B B')))),
    DG.dn-mul B B' lo lo' (HM.comp-dn B x) (HM.comp-dn B' y)) ;
  at-bot (m : E3) (e : Id Int (deg m) (pos (NA.plus B B'))) : Id A.R (PS.psi (S.mul x y) m) (PS.psi ll m) =
   psi-split x y lo lo' m
    (DG.dn-mul B (suc B') lo (S.add y (S.neg lo')) (HM.comp-dn B x) (hi-dn y B' by.2.1) m (NA.plus B B') zero e (plus-one B B'))
    (DG.dn-mul (suc B) B' (S.add x (S.neg lo)) y (hi-dn x B bx.2.1) by.2.1 m (NA.plus B B') zero e
      (trans (sym (NA.plus-suc B B')) (plus-one B B'))) ;
  w : (m : E3) * Not (Id A.R (PS.psi ll m) A.z) = HM.witness ll nll ;
  result : ExtremeAt x y (NA.plus B B') =
   (w.1, (deg-of ll (NA.plus B B') hom-ll w.1 w.2, \ e0 -> w.2 (trans (sym (at-bot w.1 (deg-of ll (NA.plus B B') hom-ll w.1 w.2))) e0))) ;
 } ;

 -- the bottom degree is at most the top degree
 module Order (x : S.R) (nx : Not (Id S.R x S.z)) {
  T : Nat = HM.Search[x,nx].top.1 ;
  B : Nat = HM.Search[x,nx].bot.1 ;
  w : (m : E3) * Not (Id A.R (PS.psi (HM.comp B x) m) A.z) = HM.witness (HM.comp B x) HM.Search[x,nx].bot.2.2 ;
  em : Id Int (deg w.1) (pos B) = deg-of (HM.comp B x) B (comp-hom B x) w.1 w.2 ;
  nzx : Not (Id A.R (PS.psi x w.1) A.z) = \ e -> w.2 (trans (HM.comp-at B x w.1 em) e) ;
  bz : (d : Nat) -> Id Nat B (NA.plus T d) -> (r : Nat) * Id Nat T (NA.plus B r) = split {
   zero -> \ eb -> (zero, sym (trans (NA.plus-zero B) (trans eb (NA.plus-zero T)))) ;
   suc d -> \ eb -> efq (nzx (HM.Search[x,nx].top.2.1 w.1 d (trans em (ap (\ k -> pos k) (trans eb (NA.plus-suc T d)))))) } ;
  by-cmp : Plus ((d : Nat) * Id Nat B (NA.plus T d)) ((d : Nat) * Id Nat T (NA.plus B (suc d))) -> (r : Nat) * Id Nat T (NA.plus B r) = split {
   inl p -> bz p.1 p.2 ;
   inr p -> (suc p.1, p.2) } ;
  le : (r : Nat) * Id Nat T (NA.plus B r) = by-cmp (DGt.cmp B T) ;
 } ;

 -- a divisor of a non-zero homogeneous element is homogeneous
 module Divisor (x y : S.R) (nx : Not (Id S.R x S.z)) (ny : Not (Id S.R y S.z)) (d : Nat)
  (hu : DG.Up (suc d) (S.mul x y)) (hd : DG.Dn d (S.mul x y)) {
  module TP = TopProd[x,y,nx,ny] ;
  module BP = BotProd[x,y,nx,ny] ;
  module OX = Order[x,nx] ;
  module OY = Order[y,ny] ;
  top-sum : Id Nat (NA.plus TP.T TP.T') d =
   DGt.pos-inj (NA.plus TP.T TP.T') d (trans (sym TP.result.2.1) (deg-of (S.mul x y) d (hu, hd) TP.result.1 TP.result.2.2)) ;
  bot-sum : Id Nat (NA.plus BP.B BP.B') d =
   DGt.pos-inj (NA.plus BP.B BP.B') d (trans (sym BP.result.2.1) (deg-of (S.mul x y) d (hu, hd) BP.result.1 BP.result.2.2)) ;
  -- B + B' = (B + r) + (B' + r') gives r + r' = 0
  rr : Id Nat zero (NA.plus OX.le.1 OY.le.1) =
   NA.plus-cancel-l (NA.plus BP.B BP.B') zero (NA.plus OX.le.1 OY.le.1)
    (trans (NA.plus-zero (NA.plus BP.B BP.B'))
     (trans bot-sum (trans (sym top-sum)
      (trans (Presentations[l].cong2 Nat NA.plus _ _ _ _ OX.le.2 OY.le.2) (swap4 BP.B OX.le.1 BP.B' OY.le.1))))) ;
  r0 : Id Nat OX.le.1 zero = plus-zero-l OX.le.1 OY.le.1 rr ;
  r0' : Id Nat OY.le.1 zero = plus-zero-l OY.le.1 OX.le.1 (trans rr (NA.plus-comm OX.le.1 OY.le.1)) ;
  bx-tx : Id Nat BP.B TP.T = sym (trans OX.le.2 (trans (ap (NA.plus BP.B) r0) (NA.plus-zero BP.B))) ;
  by-ty : Id Nat BP.B' TP.T' = sym (trans OY.le.2 (trans (ap (NA.plus BP.B') r0') (NA.plus-zero BP.B'))) ;
  hom-x : Hom TP.T x = (TP.tx.2.1, subst (\ n -> DG.Dn n x) bx-tx BP.bx.2.1) ;
  hom-y : Hom TP.T' y = (TP.ty.2.1, subst (\ n -> DG.Dn n y) by-ty BP.by.2.1) ;
 } ;
} ;
