-- Syzygy.seg: Lemme 13 (Euclid, in GcdDomain.Gcd.euclid) and Proposition 14
-- of doc/gcd-polynomial.tex, in any gcd domain S.  For P /= 0 and Q,
-- D0 = gcd(P,Q), P = D0 P', Q = D0 Q':
--   D0 /= 0, P' /= 0, gcd(P',Q') | 1 ;
--   (S0) D0 f = 0 gives f = 0 ;
--   (S1) P' alpha + Q' beta = 0 gives a unique w with
--        alpha = -Q' w , beta = P' w .
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (S : CRing) (G : GcdDomain[l].GcdDomain[S]) (P Q : S.R) (nP : Not (Id S.R P S.z)) {
 open S ; open RL[S] ; open GcdDomain[l].Divisibility[S] ;
 module Gd = GcdDomain[l].Gcd[S,G] ;
 module D = Gd.D ;
 D0 : R = Gd.gcd P Q ;
 P' : R = (Gd.gcd-left P Q).1 ;
 Q' : R = (Gd.gcd-right P Q).1 ;
 eP : Id R P (mul D0 P') = (Gd.gcd-left P Q).2 ;
 eQ : Id R Q (mul D0 Q') = (Gd.gcd-right P Q).2 ;
 nD0 : Not (Id R D0 z) = \ e -> nP (trans eP (trans (ap (\ t -> mul t P') e) (zero-mul P'))) ;
 nP' : Not (Id R P' z) = \ e -> nP (trans eP (trans (ap (mul D0) e) (mul-zero D0))) ;
 -- gcd(P',Q') | 1
 coprime : Div (Gd.gcd P' Q') o =
  D.div-cancel D0 e o nD0
   (div-eq-right (mul D0 e) D0 (mul D0 o) (sym (mulO D0))
    (Gd.gcd-univ P Q (mul D0 e)
     (div-eq-right (mul D0 e) (mul D0 P') P (sym eP) (div-scale e P' D0 (Gd.gcd-left P' Q')))
     (div-eq-right (mul D0 e) (mul D0 Q') Q (sym eQ) (div-scale e Q' D0 (Gd.gcd-right P' Q')))))
  where { e : R = Gd.gcd P' Q' } ;
 -- (S0)
 s0 (f : R) (h : Id R (mul D0 f) z) : Id R f z = D.cancel-zero D0 f nD0 h ;
 -- (S1)
 Sol (al be : R) : U l = (w : R) * (Id R al (neg (mul Q' w)) * Id R be (mul P' w)) ;
 module S1 (al be : R) (h : Id R (add (mul P' al) (mul Q' be)) z) {
  -- Q' beta = P' (-alpha)
  qb : Id R (mul Q' be) (mul P' (neg al)) = trans (neg-uniq (mul P' al) (mul Q' be) h) (sym (mul-neg P' al)) ;
  dvb : Div P' be = Gd.euclid P' Q' be coprime (mulC' qb)
   where { mulC' (e : Id R (mul Q' be) (mul P' (neg al))) : Div P' (mul Q' be) = (neg al, e) } ;
  w : R = dvb.1 ;
  ew : Id R be (mul P' w) = dvb.2 ;
  -- P' (alpha + Q' w) = P' alpha + Q' beta = 0
  expand : Id R (mul P' (add al (mul Q' w))) z =
   trans (dist P' al (mul Q' w))
    (trans (ap (add (mul P' al)) (trans (mul-swap P' Q' w) (ap (mul Q') (sym ew)))) h) ;
  al-eq : Id R al (neg (mul Q' w)) =
   neg-uniq (mul Q' w) al (trans (addC (mul Q' w) al) (D.cancel-zero P' (add al (mul Q' w)) nP' expand)) ;
  sol : Sol al be = (w, (al-eq, ew)) ;
 } ;
 s1 (al be : R) (h : Id R (add (mul P' al) (mul Q' be)) z) : Sol al be = S1[al,be,h].sol ;
 -- uniqueness of w
 sol-prop (al be : R) : Pr.isProp (Sol al be) = \ u v ->
  Pr.Sigma-eq R (\ w -> Id R al (neg (mul Q' w)) * Id R be (mul P' w)) u.1 v.1 u.2 v.2
   (D.cancel P' u.1 v.1 nP' (trans (sym u.2.2) v.2.2))
   (Pr.isProp-Sigma (Id R al (neg (mul Q' v.1))) (\ x -> Id R be (mul P' v.1))
     (G.set al (neg (mul Q' v.1))) (\ x -> G.set be (mul P' v.1))) ;
} ;
