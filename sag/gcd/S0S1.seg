-- S0S1.seg: the data (S0)/(S1) for homogeneous P, Q over A = k[b][a], k a
-- discrete field (the ring of acl-zmt/ACLS1, Iterate.same-A): HomLambda.Data
-- instantiated with the gcd domain of Iterate.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o))
 (one-nonzero : Not (Id k.R k.o k.z)) {
 module IT = Iterate[l].Over[k,setk,dec,one-nonzero] ;
 A : CRing = IT.A ;
 module H = HomLambda[l].Over[A,IT.gcdA] ;
 -- for PL, QL homogeneous of degrees d, e, with exponents >= 0, not 0:
 --   H.Data[PL,QL,hP,hQ,m0,nP0,n0,nQ0,d,e,hPd,hQe] .r .d' .e' .sum-P .sum-Q
 --   .D0h .P'h .Q'h (+ -hom) .P-eq .Q-eq .s0 .s1
} ;
