-- Rep.seg: the canonical list of an element x of A[X] (A a gcd domain):
-- its coefficients below its degree (Degree.dg), a datum, with
-- include (rep x) = x.
level l ; open Ring[l] ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 module Dg = Degree[l].Over[A,G] ;
 module PB = Dg.PB ;
 tab : (n : Nat) -> (Nat -> A.R) -> List A.R = split {
  zero -> \ f -> nil ;
  suc n | r -> \ f -> cons (f zero) (r (\ i -> f (suc i))) } ;
 tab-coef : (n : Nat) (f : Nat -> A.R) -> ((i : Nat) -> Id A.R (f (plus n i)) A.z) ->
  (i : Nat) -> Id A.R (PB.PL.coef (tab n f) i) (f i) = split {
  zero -> \ f b i -> sym (b i) ;
  suc n | r -> \ f b -> split {
   zero -> refl (f zero) ;
   suc i -> r (\ j -> f (suc j)) (\ j -> b j) i } } ;
 rep (x : PB.Pol) : List A.R = tab (Dg.dg x) (PB.coef x) ;
 rep-eq (x : PB.Pol) : Id PB.Pol (PB.B.include (rep x)) x =
  PB.CP.coef-ext (PB.B.include (rep x)) x
   (\ k -> trans (PB.CP.coef-include (rep x) k) (tab-coef (Dg.dg x) (PB.coef x) (Dg.dg-bnd x) k)) ;
} ;
