-- Lambda.seg: the data (S0)/(S1) in Lambda_XYZ (Laurent3 representation)
-- for P, Q given as lists with exponents >= 0, P not identically 0
-- (doc/gcd-polynomial.tex, Proposition 14 transported to Lambda_XYZ).
--
--  * Ps, Qs in S = A[X][Y][Z] with psi Ps = coef PL, psi Qs = coef QL ;
--  * D0 = gcd(Ps,Qs), P' , Q' in S (Syzygy), and their lists D0L, P'L, Q'L
--    (Phi.nl); in Lambda:  D0L P'L = PL ,  D0L Q'L = QL ;
--  * Reg: for s /= 0 in S, (list of s) f = 0 with f finitely supported
--    gives f = 0 : shift f by X^K Y^K Z^K into S (Shift), use that S is a
--    domain and that psi is injective, shift back ;
--  * (S0) D0L f = 0 gives f = 0 (Reg for D0) ;
--  * (S1) P'L al + Q'L be = 0 (al, be finitely supported) gives a unique
--    finitely supported w with al = -Q'L w, be = P'L w : al, be shifted by
--    the same K into S, Syzygy.s1 there, w = X^-K Y^-K Z^-K psi(w').
--    w is unique by Reg for P', so it is extracted from the truncations.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module LLt = LaurentList[l] ; module NA = NatArith[l] ;
module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 module SH = Shift[l].Over[A,G] ;
 module PH = SH.PH ; module PS = SH.PS ; module LO = PS.LO ; module LL = PS.LL ;
 module LP = LL.Prod[G.set] ; module DA = GcdDomain[l].Domain[A,G.set,G.dec,G.integral] ;
 S : CRing = PH.S ;
 module RS = RL[S] ;
 module GS = GcdDomain[l].Gcd[S,PS.gcdS] ;
 Lau : U l = LO.Lau ;
 EqL-prop (f g : Lau) : Pr.isProp (LO.EqL f g) = FE.isProp-Pi E3 (\ m -> Id A.R (f m) (g m)) (\ m -> G.set (f m) (g m)) ;
 -- the list of s in Lambda
 lst (s : S.R) : LO.LPoly = PH.embL (PH.nl s) ;
 psi-coef (s : S.R) : LO.EqL (PS.psi s) (LL.coef (lst s)) = \ m ->
  trans (ap (\ u -> PS.psi u m) (sym (PH.nl-eq s))) (PH.psi-list (PH.nl s) m) ;
 psi-fin (s : S.R) : LL.Fin (PS.psi s) = LL.fin-cong (LL.coef (lst s)) (PS.psi s) (\ m -> sym (psi-coef s m)) (LL.fin-in (lst s)) ;
 bound (g : LO.LPoly) : Shift[l].Le' (SH.Bsum g) (SH.Bsum g) = (zero, sym (NA.plus-zero (SH.Bsum g))) ;

 -- Reg
 module Reg (s : S.R) (ns : Not (Id S.R s S.z)) {
  module At (f : Lau) (hz : LO.EqL (LO.mulP (lst s) f) LO.zeroL) (w : LL.FinW f) {
   K : Nat = SH.Bsum w.1 ;
   module L = SH.Lift[f,w,K,bound w.1] ;
   prod0 : LO.EqL (PS.psi (S.mul s L.s)) LO.zeroL = \ m ->
    trans (PH.psi-mul s L.s m)
     (trans (LO.mulP-cong (lst s) (PS.psi L.s) (LO.shift (SH.eK K) f) L.psi-s m)
      (trans (sym (LO.mulP-shift (SH.eK K) f (lst s) m)) (hz (sub3 m (SH.eK K))))) ;
   s0 : Id S.R L.s S.z = GS.D.cancel-zero s L.s ns (PS.psi-inj (S.mul s L.s) prod0) ;
   result : LO.EqL f LO.zeroL = \ m ->
    trans (sym (SH.unshift (SH.eK K) f m))
     (trans (sym (L.psi-s (sub3 m (neg3 (SH.eK K)))))
      (trans (ap (\ u -> PS.psi u (sub3 m (neg3 (SH.eK K)))) s0) (PS.psi-zero (sub3 m (neg3 (SH.eK K)))))) ;
  } ;
  reg (f : Lau) (hf : LL.Fin f) (hz : LO.EqL (LO.mulP (lst s) f) LO.zeroL) : LO.EqL f LO.zeroL =
   Tr.Trunc[LL.FinW f].induction @l (\ u -> LO.EqL f LO.zeroL) (\ u -> EqL-prop f LO.zeroL)
    (\ w -> At[f,hz,w].result) hf ;
 } ;

 module Data (PL QL : LO.LPoly) (hP : Shift[l].Le' (SH.Bsum PL) zero) (hQ : Shift[l].Le' (SH.Bsum QL) zero)
  (m0 : E3) (nP0 : Not (Id A.R (LL.coef PL m0) A.z)) {
  module LPl = SH.Lift[LL.coef PL,(PL, \ m -> refl (LL.coef PL m)),zero,hP] ;
  module LQl = SH.Lift[LL.coef QL,(QL, \ m -> refl (LL.coef QL m)),zero,hQ] ;
  Ps : S.R = LPl.s ;
  Qs : S.R = LQl.s ;
  -- the shift by (0,0,0) is the identity
  psi-P : LO.EqL (PS.psi Ps) (LL.coef PL) = \ m -> LPl.psi-s m ;
  psi-Q : LO.EqL (PS.psi Qs) (LL.coef QL) = \ m -> LQl.psi-s m ;
  nP : Not (Id S.R Ps S.z) = \ e ->
   nP0 (trans (sym (psi-P m0)) (trans (ap (\ u -> PS.psi u m0) e) (PS.psi-zero m0))) ;
  module SY = Syzygy[l].Over[S,PS.gcdS,Ps,Qs,nP] ;
  D0L : LO.LPoly = lst SY.D0 ;
  P'L : LO.LPoly = lst SY.P' ;
  Q'L : LO.LPoly = lst SY.Q' ;
  -- P = D0 P' and Q = D0 Q' in Lambda
  factor (x x' : S.R) (e : Id S.R x (S.mul SY.D0 x')) : LO.EqL (LO.mulP D0L (LL.coef (lst x'))) (PS.psi x) = \ m ->
   trans (LO.mulP-cong D0L (LL.coef (lst x')) (PS.psi x') (\ m' -> sym (psi-coef x' m')) m)
    (trans (sym (PH.psi-mul SY.D0 x' m)) (ap (\ u -> PS.psi u m) (sym e))) ;
  P-eq : LO.EqL (LO.mulP D0L (LL.coef P'L)) (LL.coef PL) = \ m -> trans (factor Ps SY.P' SY.eP m) (psi-P m) ;
  Q-eq : LO.EqL (LO.mulP D0L (LL.coef Q'L)) (LL.coef QL) = \ m -> trans (factor Qs SY.Q' SY.eQ m) (psi-Q m) ;

  -- (S0)
  s0 (f : Lau) (hf : LL.Fin f) (hz : LO.EqL (LO.mulP D0L f) LO.zeroL) : LO.EqL f LO.zeroL = Reg[SY.D0,SY.nD0].reg f hf hz ;

  -- (S1)
  Sol (al be : Lau) : U l = (w : Lau) * (LL.Fin w * (LO.EqL al (LO.negL (LO.mulP Q'L w)) * LO.EqL be (LO.mulP P'L w))) ;
  sol-prop (al be : Lau) : Pr.isProp (Sol al be) = \ u v ->
   Pr.Sigma-eq Lau (\ w -> LL.Fin w * (LO.EqL al (LO.negL (LO.mulP Q'L w)) * LO.EqL be (LO.mulP P'L w))) u.1 v.1 u.2 v.2
    (LP.extL u.1 v.1 (\ m -> DA.sub-zero (u.1 m) (v.1 m)
      (Reg[SY.P',SY.nP'].reg (LO.subL u.1 v.1) (LL.fin-sub u.1 v.1 u.2.1 v.2.1)
        (\ m' -> trans (LO.mulP-sub P'L u.1 v.1 m')
                  (trans (ap (\ t -> A.add t (A.neg (LO.mulP P'L v.1 m'))) (sym (u.2.2.2 m')))
                   (trans (ap (\ t -> A.add (be m') (A.neg t)) (sym (v.2.2.2 m'))) (A.addN (be m'))))) m)))
    (Pr.isProp-Sigma (LL.Fin v.1) (\ x -> LO.EqL al (LO.negL (LO.mulP Q'L v.1)) * LO.EqL be (LO.mulP P'L v.1))
      (LL.fin-prop v.1)
      (\ x -> Pr.isProp-Sigma (LO.EqL al (LO.negL (LO.mulP Q'L v.1))) (\ y -> LO.EqL be (LO.mulP P'L v.1))
               (EqL-prop al (LO.negL (LO.mulP Q'L v.1))) (\ y -> EqL-prop be (LO.mulP P'L v.1)))) ;
  module S1At (al be : Lau) (h : LO.EqL (LO.addL (LO.mulP P'L al) (LO.mulP Q'L be)) LO.zeroL)
   (wa : LL.FinW al) (wb : LL.FinW be) {
   K : Nat = NA.plus (SH.Bsum wa.1) (SH.Bsum wb.1) ;
   e : E3 = SH.eK K ;
   module La = SH.Lift[al,wa,K,(SH.Bsum wb.1, refl K)] ;
   module Lb = SH.Lift[be,wb,K,(SH.Bsum wa.1, NA.plus-comm (SH.Bsum wa.1) (SH.Bsum wb.1))] ;
   rel0 : LO.EqL (PS.psi (S.add (S.mul SY.P' La.s) (S.mul SY.Q' Lb.s))) LO.zeroL = \ m ->
    trans (PS.psi-add (S.mul SY.P' La.s) (S.mul SY.Q' Lb.s) m)
     (trans (Presentations[l].cong2 A.R A.add _ _ _ _
        (trans (PH.psi-mul SY.P' La.s m) (trans (LO.mulP-cong P'L (PS.psi La.s) (LO.shift e al) La.psi-s m) (sym (LO.mulP-shift e al P'L m))))
        (trans (PH.psi-mul SY.Q' Lb.s m) (trans (LO.mulP-cong Q'L (PS.psi Lb.s) (LO.shift e be) Lb.psi-s m) (sym (LO.mulP-shift e be Q'L m)))))
      (h (sub3 m e))) ;
   sol' : SY.Sol La.s Lb.s = SY.s1 La.s Lb.s (PS.psi-inj (S.add (S.mul SY.P' La.s) (S.mul SY.Q' Lb.s)) rel0) ;
   w' : S.R = sol'.1 ;
   w : Lau = LO.shift (neg3 e) (PS.psi w') ;
   fw : LL.Fin w = SH.fin-shift (neg3 e) (PS.psi w') (psi-fin w') ;
   be-eq : LO.EqL be (LO.mulP P'L w) = \ m ->
    trans (sym (SH.unshift e be m))
     (trans (sym (Lb.psi-s (sub3 m (neg3 e))))
      (trans (ap (\ u -> PS.psi u (sub3 m (neg3 e))) sol'.2.2)
       (trans (PH.psi-mul SY.P' w' (sub3 m (neg3 e))) (LO.mulP-shift (neg3 e) (PS.psi w') P'L m)))) ;
   al-eq : LO.EqL al (LO.negL (LO.mulP Q'L w)) = \ m ->
    trans (sym (SH.unshift e al m))
     (trans (sym (La.psi-s (sub3 m (neg3 e))))
      (trans (ap (\ u -> PS.psi u (sub3 m (neg3 e))) sol'.2.1)
       (trans (PS.psi-neg (S.mul SY.Q' w') (sub3 m (neg3 e)))
        (ap A.neg (trans (PH.psi-mul SY.Q' w' (sub3 m (neg3 e))) (LO.mulP-shift (neg3 e) (PS.psi w') Q'L m)))))) ;
   sol : Sol al be = (w, (fw, (al-eq, be-eq))) ;
  } ;
  s1 (al be : Lau) (fa : LL.Fin al) (fb : LL.Fin be) (h : LO.EqL (LO.addL (LO.mulP P'L al) (LO.mulP Q'L be)) LO.zeroL) : Sol al be =
   Tr.Trunc[LL.FinW al].induction @l (\ u -> Sol al be) (\ u -> sol-prop al be)
    (\ wa -> Tr.Trunc[LL.FinW be].induction @l (\ u -> Sol al be) (\ u -> sol-prop al be)
      (\ wb -> S1At[al,be,h,wa,wb].sol) fb) fa ;
 } ;
} ;
