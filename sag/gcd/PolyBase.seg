-- PolyBase.seg: A[X] over a gcd domain A, with its coefficients
-- (PolynomialRing.Extension, CharPoly.coef), and the division of a polynomial
-- by a non-zero scalar dividing all its coefficients.  For lambda /= 0 the
-- quotient is unique, so it is obtained on the quotient A[X] from the lists.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Ps = Presentations[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 open A ; open RL[A] ; open GcdDomain[l].Divisibility[A] ;
 module D = GcdDomain[l].Domain[A,G.set,G.dec,G.integral] ;
 module C = Content[l].Over[A,G] ;
 module PL = Poly[l].PolyR[A] ;
 module ML = Mul[l].MulR[A] ;
 module B = PolynomialRing[l].Extension[A,G.set] ;
 module CP = CharPoly[l].Over[A,G.set] ;
 module LB = RL[B.ring] ;
 module DB = GcdDomain[l].Divisibility[B.ring] ;
 Pol : U l = B.Carrier ;
 coef (x : Pol) (k : Nat) : R = CP.coef x k ;
 sc (a : R) (x : Pol) : Pol = B.mulQ (B.constant a) x ;
 coef-sc (a : R) (x : Pol) (k : Nat) : Id R (coef (sc a x) k) (mul a (coef x k)) = CP.coef-scale a x k ;
 coef-mul-include (p q : PL.P) (k : Nat) : Id R (coef (B.mulQ (B.include p) (B.include q)) k) (PL.coef (ML.pmul p q) k) =
  trans (ap (\ w -> coef w k) (B.Multiply.beta p q)) (CP.coef-include (ML.pmul p q) k) ;
 -- every common divisor of the coefficients divides 1
 Prim (x : Pol) : U l = C.Prim (coef x) ;
 prim-include (p : PL.P) (h : Prim (B.include p)) : C.Prim (PL.coef p) =
  \ d k -> h d (\ i -> div-eq-right d (PL.coef p i) (coef (B.include p) i) (sym (CP.coef-include p i)) (k i)) ;
 -- a list is bounded by its length
 bnd-list (p : PL.P) : C.Bnd (PL.plen p) (PL.coef p) = ML.coef-beyond p ;

 ---------------------------------------------------------------------
 -- division by a scalar

 divL (a : R) : (q : PL.P) -> ((i : Nat) -> Div a (PL.coef q i)) -> PL.P = split {
  nil -> \ w -> nil ;
  cons c q | r -> \ w -> cons (w zero).1 (r (\ i -> w (suc i))) } ;
 divL-coef (a : R) : (q : PL.P) (w : (i : Nat) -> Div a (PL.coef q i)) (i : Nat) ->
  Id R (PL.coef q i) (mul a (PL.coef (divL a q w) i)) = split {
  nil -> \ w i -> sym (mul-zero a) ;
  cons c q | r -> \ w -> split {
   zero -> (w zero).2 ;
   suc i -> r (\ j -> w (suc j)) i } } ;

 module Scalar (a : R) (ha : Not (Id R a z)) {
  Quot (x : Pol) : U l = (y : Pol) * Id Pol x (sc a y) ;
  -- cancelling a scalar a /= 0
  cancel (y y' : Pol) (e : Id Pol (sc a y) (sc a y')) : Id Pol y y' =
   CP.coef-ext y y' (\ k -> D.cancel a (coef y k) (coef y' k) ha
     (trans (sym (coef-sc a y k)) (trans (ap (\ w -> coef w k) e) (coef-sc a y' k)))) ;
  quot-prop (x : Pol) : Pr.isProp (Quot x) = \ u v ->
   Pr.Sigma-eq Pol (\ y -> Id Pol x (sc a y)) u.1 v.1 u.2 v.2
    (cancel u.1 v.1 (trans (sym u.2) v.2)) (B.set x (sc a v.1)) ;
  Divides (x : Pol) : U l = (i : Nat) -> Div a (coef x i) ;
  divide-list (q : PL.P) (w : Divides (B.include q)) : Quot (B.include q) =
   (B.include (divL a q w'),
    CP.coef-ext (B.include q) (sc a (B.include (divL a q w')))
     (\ k -> trans (CP.coef-include q k)
      (trans (divL-coef a q w' k)
       (trans (ap (mul a) (sym (CP.coef-include (divL a q w') k)))
        (sym (coef-sc a (B.include (divL a q w')) k))))))
   where { w' (i : Nat) : Div a (PL.coef q i) = div-eq-right a (coef (B.include q) i) (PL.coef q i) (CP.coef-include q i) (w i) } ;
  divide : (x : Pol) -> Divides x -> Quot x =
   B.Q.induction @l (\ x -> Divides x -> Quot x)
    (\ x -> FE.isProp-Pi (Divides x) (\ w -> Quot x) (\ w -> quot-prop x))
    divide-list ;
 } ;
} ;
