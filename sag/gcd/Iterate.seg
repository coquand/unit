-- Iterate.seg: Corollaire 12 of doc/gcd-polynomial.tex.  For k a discrete
-- field (x = 0 or x invertible, and 1 /= 0), the rings
--   k[b] , A = k[b][a] (as in acl-zmt/ACLS1, a the outer variable),
--   A[X] , A[X][Y] , S = A[X][Y][Z]
-- are gcd domains (PolyGcd five times over GcdDomain.Field).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
-- one step: A gcd domain gives A[X] gcd domain
module Step (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 module PG = PolyGcd[l].Over[A,G] ;
 ring : CRing = PG.PB.B.ring ;
 domain : GcdDomain[l].GcdDomain[ring] = PG.domain ;
 variable : ring.R = PG.PB.B.variable ;
 constant (x : A.R) : ring.R = PG.PB.B.constant x ;
} ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o))
 (one-nonzero : Not (Id k.R k.o k.z)) {
 Gk : GcdDomain[l].GcdDomain[k] = GcdDomain[l].FieldGcd[k,setk,dec,one-nonzero].domain ;
 module Sb = Step[k,Gk] ;
 module Sa = Step[Sb.ring,Sb.domain] ;
 module SX = Step[Sa.ring,Sa.domain] ;
 module SY = Step[SX.ring,SX.domain] ;
 module SZ = Step[SY.ring,SY.domain] ;
 -- A = k[b][a], literally the ring of ACLS1.Over[k,setk]
 A : CRing = Sa.ring ;
 same-A : Id CRing A (PolynomialRing[l].Extension[PolynomialRing[l].Extension[k,setk].ring,PolynomialRing[l].Extension[k,setk].set].ring) = refl A ;
 b : A.R = Sa.constant Sb.variable ;
 a : A.R = Sa.variable ;
 S : CRing = SZ.ring ;
 gcdA : GcdDomain[l].GcdDomain[A] = Sa.domain ;
 gcdS : GcdDomain[l].GcdDomain[S] = SZ.domain ;
 -- the variables and the coefficients in S
 X : S.R = SZ.constant (SY.constant SX.variable) ;
 Y : S.R = SZ.constant SY.variable ;
 Z : S.R = SZ.variable ;
 fromA (x : A.R) : S.R = SZ.constant (SY.constant (SX.constant x)) ;
} ;
