-- ACLInstance.seg: a check that the hypotheses of S0S1 are discharged by
-- computation for the polynomials of ACL §4.4 (the lists PlP, PlQ of
-- acl-zmt/ACLCech.Data, from FixedCochain.ACL):
--   P = XZ - a Z^2 + b (XY + 2 X^2) ,  Q = YZ + a (X^2 + XY) + b (Y^2 - Z^2) ,
-- exponents >= 0 (Bsum = 0 by refl), both of degree 2 (HomPI by refl), and
-- the coefficient 1 of XZ (of YZ) is not 0.
level l ; open Base ; open Ring[l] ; open ZInt[l] ; open Laurent3[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (x : k.R) -> Plus (Id k.R x k.z) ((y : k.R) * Id k.R (k.mul x y) k.o))
 (one-nonzero : Not (Id k.R k.o k.z)) {
 module F = S0S1[l].Over[k,setk,dec,one-nonzero] ;
 A : CRing = F.A ;
 module FA = FixedCochain[l].ACL[A,F.IT.a,F.IT.b] ;
 PL : F.H.LO.LPoly = FA.XZ.C.Pl ;
 QL : F.H.LO.LPoly = FA.YZ.C.Pl ;
 two : Nat = suc (suc zero) ;
 -- 1 /= 0 in A
 nzA : Not (Id A.R A.o A.z) = F.IT.gcdA.nontrivial ;
 -- 1 + 0 + .. + 0 = 1 (the coefficient of XZ in P, of YZ in Q)
 o4 : Id A.R (A.add A.o (A.add A.z (A.add A.z (A.add A.z A.z)))) A.o =
  trans (ap (A.add A.o) (trans (ap (A.add A.z) (trans (ap (A.add A.z) (A.addZ A.z)) (A.addZ A.z))) (A.addZ A.z))) (A.addZ A.o) ;
 o5 : Id A.R (A.add A.o (A.add A.z (A.add A.z (A.add A.z (A.add A.z A.z))))) A.o =
  trans (ap (A.add A.o) (trans (ap (A.add A.z) (trans (ap (A.add A.z) (trans (ap (A.add A.z) (A.addZ A.z)) (A.addZ A.z))) (A.addZ A.z))) (A.addZ A.z))) (A.addZ A.o) ;
 nP0 : Not (Id A.R (F.H.LL.coef PL FA.muP) A.z) = \ e -> nzA (trans (sym o4) e) ;
 nQ0 : Not (Id A.R (F.H.LL.coef QL FA.muQ) A.z) = \ e -> nzA (trans (sym o5) e) ;
 module D = F.H.Data[PL,QL,(zero, refl zero),(zero, refl zero),FA.muP,nP0,FA.muQ,nQ0,two,two,
   (refl (pos two), (refl (pos two), (refl (pos two), (refl (pos two), tt)))),
   (refl (pos two), (refl (pos two), (refl (pos two), (refl (pos two), (refl (pos two), tt)))))] ;
 -- the outputs: D.r, D.d', D.e', D.D0h, D.P'h, D.Q'h, D.P-eq, D.Q-eq, D.s0, D.s1 kW
} ;
