-- Content.seg: the content of a finite sequence of coefficients
-- (doc/gcd-polynomial.tex, §2: Lemme 4, Corollaire 5).
--
--  cont_0(e) = 0 ,  cont_(n+1)(e) = gcd(e_n, cont_n(e)) .
--  cont_n(e) divides e_i for i < n, a common divisor of the e_i (i < n)
--  divides cont_n(e), and d | u e_i for all i < n gives d | u cont_n(e)
--  (Lemma M).  For e with e_i = 0 when i >= n (Bnd n e) these hold for all
--  i, and for e primitive (every common divisor divides 1):
--  d | u e_i for all i gives d | u  (Corollaire 5).
level l ; open Ring[l] ;
module NO = NatOrder[l] ;
module Over (A : CRing) (G : GcdDomain[l].GcdDomain[A]) {
 open A ; open RL[A] ; open GcdDomain[l].Divisibility[A] ;
 module Gd = GcdDomain[l].Gcd[A,G] ;

 Below (n : Nat) (P : Nat -> U l) : U l = (i : Nat) -> NO.Lt i n -> P i ;
 -- e_i = 0 for i >= n
 Bnd (n : Nat) (e : Nat -> R) : U l = (i : Nat) -> Id R (e (plus n i)) z ;
 -- every common divisor of the e_i divides 1
 Prim (e : Nat -> R) : U l = (d : R) -> ((i : Nat) -> Div d (e i)) -> Div d o ;

 lt-top (n : Nat) : NO.Lt n (suc n) = NO.le-refl n ;
 lt-up (i n : Nat) (h : NO.Lt i n) : NO.Lt i (suc n) = NO.le-suc (suc i) n h ;

 cont (e : Nat -> R) : Nat -> R = split { zero -> z ; suc n | r -> Gd.gcd (e n) r } ;

 cont-div-step (e : Nat -> R) (n : Nat) (r : Below n (\ i -> Div (cont e n) (e i))) (i : Nat) :
  Plus (NO.Lt i n) (Id Nat i n) -> Div (cont e (suc n)) (e i) = split {
  inl lt -> div-trans (cont e (suc n)) (cont e n) (e i) (Gd.gcd-right (e n) (cont e n)) (r i lt) ;
  inr eq -> subst (\ k -> Div (cont e (suc n)) (e k)) (sym eq) (Gd.gcd-left (e n) (cont e n)) } ;
 cont-div (e : Nat -> R) : (n : Nat) -> Below n (\ i -> Div (cont e n) (e i)) = split {
  zero -> \ i h -> efq h ;
  suc n | r -> \ i h -> cont-div-step e n r i (NO.le-cases i n h) } ;

 cont-univ (e : Nat -> R) (d : R) : (n : Nat) -> Below n (\ i -> Div d (e i)) -> Div d (cont e n) = split {
  zero -> \ h -> div-zero d ;
  suc n | r -> \ h -> Gd.gcd-univ (e n) (cont e n) d (h n (lt-top n)) (r (\ i b -> h i (lt-up i n b))) } ;

 cont-M (e : Nat -> R) (u d : R) : (n : Nat) -> Below n (\ i -> Div d (mul u (e i))) -> Div d (mul u (cont e n)) = split {
  zero -> \ h -> div-eq-right d z (mul u z) (sym (mul-zero u)) (div-zero d) ;
  suc n | r -> \ h -> Gd.lemma-M u (e n) (cont e n) d (h n (lt-top n)) (r (\ i b -> h i (lt-up i n b))) } ;

 -- below n, and zero from n on: every index
 module Bounded (e : Nat -> R) (n : Nat) (bnd : Bnd n e) {
  every-step (d : R) (h : Below n (\ i -> Div d (e i))) (i : Nat) : Plus (NO.Le n i) (NO.Lt i n) -> Div d (e i) = split {
   inl le -> div-eq-right d z (e i)
              (sym (trans (ap e (trans (NO.le-plus n i le).2 (plus-comm (NO.le-plus n i le).1 n))) (bnd (NO.le-plus n i le).1)))
              (div-zero d) ;
   inr lt -> h i lt } ;
  every (d : R) (h : Below n (\ i -> Div d (e i))) (i : Nat) : Div d (e i) = every-step d h i (NO.le-or-gt n i) ;
  c : R = cont e n ;
  c-div (i : Nat) : Div c (e i) = every c (cont-div e n) i ;
  c-univ (d : R) (h : (i : Nat) -> Div d (e i)) : Div d c = cont-univ e d n (\ i b -> h i) ;
  -- c = 0 gives e = 0
  c-zero (h : Id R c z) (i : Nat) : Id R (e i) z = div-of-zero (e i) (div-eq-left c z (e i) h (c-div i)) ;
  -- a primitive e: its content divides 1
  prim-c (p : Prim e) : Div c o = p c c-div ;
  -- Corollaire 5
  prim-M (p : Prim e) (u d : R) (h : (i : Nat) -> Div d (mul u (e i))) : Div d u =
   div-trans d (mul u c) u (cont-M e u d n (\ i b -> h i))
    (div-eq-right (mul u c) (mul u o) u (mulO u) (div-scale c o u (prim-c p))) ;
 } ;
} ;
