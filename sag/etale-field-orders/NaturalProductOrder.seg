-- Only the multiplication bounds needed by exact-order constructions.
level l ; open Ring[l] ; open Presentations[l] ;
module O = NatOrder[l] ; module NI = Integers[l] ;
le-prefix : (d m n : Nat) -> O.Le m n -> O.Le (plus d m) (plus d n) = split {
 zero -> \ m n h -> h ; suc d | ih -> \ m n h -> ih m n h } ;
lt-prefix : (d m n : Nat) -> O.Lt m n -> O.Lt (plus d m) (plus d n) = split {
 zero -> \ m n h -> h ; suc d | ih -> \ m n h -> ih m n h } ;
le-times (k : Nat) : (m n : Nat) -> O.Le m n -> O.Le (NI.times m k) (NI.times n k) = split {
 zero -> \ n h -> tt ;
 suc m | ih -> split { zero -> \ h -> efq h ; suc n -> \ h -> le-prefix k _ _ (ih n h) } } ;
lt-times (k : Nat) : (m n : Nat) -> O.Lt m n -> O.Lt (NI.times m (suc k)) (NI.times n (suc k)) = split {
 zero -> split { zero -> \ h -> efq h ; suc n -> \ h -> tt } ;
 suc m | ih -> split { zero -> \ h -> efq h ; suc n -> \ h -> lt-prefix (suc k) _ _ (ih n h) } } ;
irrefl : (n : Nat) -> Not (O.Lt n n) = split {
 zero -> \ h -> h ; suc n | ih -> ih } ;
reflect-case (k m n : Nat) (h : O.Lt (NI.times m (suc k)) (NI.times n (suc k))) :
 Plus (O.Le n m) (O.Lt m n) -> O.Lt m n = split {
 inl ge -> efq (irrefl (NI.times m (suc k))
  (O.le-trans (suc (NI.times m (suc k))) (NI.times n (suc k)) (NI.times m (suc k)) h (le-times (suc k) n m ge))) ;
 inr lt -> lt } ;
reflect (k m n : Nat) : O.Lt (NI.times m (suc k)) (NI.times n (suc k)) -> O.Lt m n =
 \ h -> reflect-case k m n h (O.le-or-gt n m) ;
zero-factor (k : Nat) : (m : Nat) -> Id Nat (NI.times m (suc k)) zero -> Id Nat m zero = split {
 zero -> \ h -> refl zero ; suc m -> \ h -> efq (suc-zero (plus k (NI.times m (suc k))) h) } ;
