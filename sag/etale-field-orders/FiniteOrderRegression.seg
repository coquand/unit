-- Exact-order regression: nontrivial unit in the nonreduced ring Z/4,
-- divisor powers, coprime products, and the generic orders 2 and 3.
level l ; open Ring[l] ; open Presentations[l] ;
module Z = ZMod4[l] ; module F = FiniteOrderPowers[l].Over[Z.ring] ;
module O = NatOrder[l] ; module NI = Integers[l] ; module ZA = ZArith[l] ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ;
six : Nat = suc (suc (suc three)) ;
three-ne-one (h : Id Z.Z4 q3 q1) : Empty = subst (Z.code q3) h tt ;
minimum-three-step : (r : Nat) -> O.Le r zero -> F.Period q3 (suc r) -> Id Nat (suc r) zero = split {
 zero -> \ bound h -> efq (three-ne-one h) ; suc r -> \ bound h -> efq bound } ;
minimum : (r : Nat) -> O.Lt r two -> F.Period q3 r -> Id Nat r zero = split {
 zero -> \ bound h -> refl zero ; suc r -> minimum-three-step r } ;
order-three : F.Exact q3 one = (refl q1,minimum) ;
square : F.Exact (F.P.power q3 two) zero = F.power-exact q3 one one zero order-three (refl two) ;
minimum-one : (r : Nat) -> O.Lt r one -> F.Period q1 r -> Id Nat r zero = split {
 zero -> \ bound h -> refl zero ; suc r -> \ bound h -> efq bound } ;
order-one : F.Exact q1 zero = (refl q1,minimum-one) ;
module Product = F.ExactProduct[q3,q1,one,zero,order-three,order-one,refl one] ;
product : F.Exact q3 one = Product.exact ;
six-is-period : F.Period q3 six = refl q1 ;
divisor : F.Divides two six = F.divisor q3 one order-three six six-is-period ;
quotient-is-three : Id Nat divisor.1 three = refl three ;
module Generic (A : CRing) (a b : A.R)
 (ea : FiniteOrderPowers[l].Over[A].Exact a one)
 (eb : FiniteOrderPowers[l].Over[A].Exact b two) {
 module G = FiniteOrderPowers[l].Over[A] ;
 module GP = G.ExactProduct[a,b,one,two,ea,eb,refl one] ;
 order-six : G.Exact (A.mul a b) (suc (suc three)) = GP.exact ;
} ;
