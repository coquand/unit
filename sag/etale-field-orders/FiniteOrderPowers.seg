-- Natural power and exact-order facts, in the finite-field enumeration's
-- power convention. Euclid transfers periods directly; signed powers
-- and a general group library are unnecessary.
level l ; open Ring[l] ; open Presentations[l] ;
module O = NatOrder[l] ; module NI = Integers[l] ; module ZA = ZArith[l] ;
times-comm (m n : Nat) : Id Nat (NI.times m n) (NI.times n m) =
 ZA.iota-inj _ _ (trans (ZA.J.iota-mul m n)
  (trans (ZA.ZR.ring.mulC (ZA.J.iota m) (ZA.J.iota n)) (sym (ZA.J.iota-mul n m)))) ;
module Over (A : CRing) {
 open A ; module L = RL[A] ; module M = MinimalFiniteOrder[l].Over[A] ; module P = M.Power ;
 module Bounds = NaturalProductOrder[l] ;
 Exact (a : R) (m : Nat) : U l = M.Exact a m ;
 Period (a : R) (n : Nat) : U l = Id R (P.power a n) o ;
 power-add (a : R) : (m n : Nat) -> Id R (P.power a (plus m n)) (mul (P.power a m) (P.power a n)) = split {
  zero -> \ n -> sym (L.one-left (P.power a n)) ;
  suc m | ih -> \ n -> trans (ap (mul a) (ih n)) (mulA a (P.power a m) (P.power a n)) } ;
 power-one : (n : Nat) -> Id R (P.power o n) o = split {
  zero -> refl o ; suc n | ih -> trans (L.one-left (P.power o n)) ih } ;
 power-product (a b : R) : (n : Nat) ->
  Id R (P.power (mul a b) n) (mul (P.power a n) (P.power b n)) = split {
   zero -> sym (mulO o) ;
   suc n | ih -> trans (ap (mul (mul a b)) ih) (L.mul-four a b (P.power a n) (P.power b n)) } ;
 iterate (a : R) (m : Nat) : (n : Nat) ->
  Id R (P.power (P.power a m) n) (P.power a (NI.times n m)) = split {
   zero -> refl o ;
   suc n | ih -> trans (ap (mul (P.power a m)) ih) (sym (power-add a m (NI.times n m))) } ;
 commute (a : R) (m n : Nat) : Id R (P.power (P.power a m) n) (P.power (P.power a n) m) =
  trans (iterate a m n) (trans (ap (P.power a) (times-comm n m)) (sym (iterate a n m))) ;
 multiple (a : R) (m : Nat) (period : Period a m) (q : Nat) : Period a (NI.times q m) =
  trans (sym (iterate a m q)) (trans (ap (\ x -> P.power x q) period) (power-one q)) ;
 remainder (a : R) (m n q r : Nat) (eq : Id Nat m (plus (NI.times q n) r))
  (pm : Period a m) (pn : Period a n) : Period a r =
  trans (sym (L.one-left (P.power a r)))
   (trans (ap (\ x -> mul x (P.power a r)) (sym (multiple a n pn q)))
    (trans (sym (power-add a (NI.times q n) r)) (trans (ap (P.power a) (sym eq)) pm))) ;
 Divides (m n : Nat) : U l = (q : Nat) * Id Nat n (NI.times q m) ;
 divisor (a : R) (m : Nat) (exact : Exact a m) (n : Nat) (pn : Period a n) : Divides (suc m) n =
  ((NI.divide m n).1,
   trans (NI.divide m n).2.2.1
    (trans (ap (plus (NI.times (NI.divide m n).1 (suc m)))
     (exact.2 (NI.divide m n).2.1 (NI.divide m n).2.2.2
      (remainder a n (suc m) (NI.divide m n).1 (NI.divide m n).2.1 (NI.divide m n).2.2.1 pn exact.1)))
     (plus-zero (NI.times (NI.divide m n).1 (suc m))))) ;
 gcd-zero (a : R) (m : Nat) : (n : Nat) -> (bound : O.Le n zero) ->
  Period a m -> Period a n -> Period a (ZA.euclid0 m n bound).g = split {
   zero -> \ bound pm pn -> pm ; suc n -> \ bound pm pn -> efq bound } ;
 gcd-step (a : R) (f : Nat)
  (rec : (m n : Nat) (bound : O.Le n f) -> Period a m -> Period a n -> Period a (ZA.euclidF f m n bound).g)
  (m : Nat) : (n : Nat) -> (bound : O.Le n (suc f)) ->
   Period a m -> Period a n -> Period a (ZA.euclidF (suc f) m n bound).g = split {
    zero -> \ bound pm pn -> pm ;
    suc n -> \ bound pm pn -> rec (suc n) (NI.divide n m).2.1
     (O.le-trans (NI.divide n m).2.1 n f (NI.divide n m).2.2.2 bound) pn
      (remainder a m (suc n) (NI.divide n m).1 (NI.divide n m).2.1 (NI.divide n m).2.2.1 pm pn) } ;
 gcd-fuel (a : R) : (f m n : Nat) (bound : O.Le n f) ->
  Period a m -> Period a n -> Period a (ZA.euclidF f m n bound).g = split {
   zero -> gcd-zero a ; suc f | rec -> gcd-step a f rec } ;
 gcd-period (a : R) (m n : Nat) : Period a m -> Period a n -> Period a (ZA.euclid m n).g =
  gcd-fuel a n m n (O.le-refl n) ;
 coprime-period (a : R) (m n : Nat) (coprime : Id Nat (ZA.euclid m n).g (suc zero))
  (pm : Period a m) (pn : Period a n) : Id R a o =
  trans (sym (mulO a)) (trans (ap (P.power a) (sym coprime)) (gcd-period a m n pm pn)) ;
 module Product (a b : R) (m n : Nat) (pa : Period a m) (pb : Period b n)
  (coprime : Id Nat (ZA.euclid m n).g (suc zero)) {
  left (k : Nat) (h : Period (mul a b) k) : Period a k =
   coprime-period (P.power a k) m n coprime
    (trans (commute a k m) (trans (ap (\ x -> P.power x k) pa) (power-one k)))
    (trans (sym (mulO (P.power (P.power a k) n)))
     (trans (ap (mul (P.power (P.power a k) n))
       (sym (trans (commute b k n) (trans (ap (\ x -> P.power x k) pb) (power-one k)))))
      (trans (sym (power-product (P.power a k) (P.power b k) n))
       (trans (ap (\ x -> P.power x n) (sym (power-product a b k)))
        (trans (ap (\ x -> P.power x n) h) (power-one n)))))) ;
  right (k : Nat) (h : Period (mul a b) k) : Period b k =
   trans (sym (L.one-left (P.power b k)))
    (trans (ap (\ x -> mul x (P.power b k)) (sym (left k h)))
     (trans (sym (power-product a b k)) h)) ;
 } ;
 power-exact (a : R) (m h u : Nat) (exact : Exact a m)
  (factor : Id Nat (suc m) (NI.times (suc u) (suc h))) : Exact (P.power a (suc h)) u =
  (trans (iterate a (suc h) (suc u)) (trans (ap (P.power a) (sym factor)) exact.1),
   \ r bound period -> Bounds.zero-factor h r
    (exact.2 (NI.times r (suc h))
     (subst (\ v -> O.Lt (NI.times r (suc h)) v) (sym factor) (Bounds.lt-times h r (suc u) bound))
     (trans (sym (iterate a (suc h) r)) period))) ;
 module ExactProduct (a b : R) (m n : Nat) (ea : Exact a m) (eb : Exact b n)
  (coprime : Id Nat (ZA.euclid (suc m) (suc n)).g (suc zero)) {
  module Split = Product[a,b,suc m,suc n,ea.1,eb.1,coprime] ;
  predecessor : Nat = plus m (NI.times n (suc m)) ;
  closes : Period (mul a b) (suc predecessor) =
   trans (power-product a b (suc predecessor))
    (trans (cong2 R mul _ _ _ _ (multiple a (suc m) ea.1 (suc n))
     (trans (ap (P.power b) (times-comm (suc n) (suc m))) (multiple b (suc n) eb.1 (suc m)))) (mulO o)) ;
  module Minimal (r : Nat) (bound : O.Lt r (suc predecessor)) (period : Period (mul a b) r) {
   quotient : Divides (suc m) r = divisor a m ea r (Split.left r period) ;
   q : Nat = quotient.1 ;
   q-bound : O.Lt q (suc n) = Bounds.reflect m q (suc n)
    (subst (\ v -> O.Lt v (suc predecessor)) quotient.2 bound) ;
   q-period : Period b q = coprime-period (P.power b q) (suc m) (suc n) coprime
    (trans (iterate b q (suc m))
     (trans (ap (P.power b) (times-comm (suc m) q))
      (trans (ap (P.power b) (sym quotient.2)) (Split.right r period))))
    (trans (commute b q (suc n)) (trans (ap (\ x -> P.power x q) eb.1) (power-one q))) ;
   result : Id Nat r zero = trans quotient.2 (ap (\ j -> NI.times j (suc m)) (eb.2 q q-bound q-period)) ;
  } ;
  exact : Exact (mul a b) predecessor = (closes,\ r bound period -> Minimal[r,bound,period].result) ;
 } ;
} ;
