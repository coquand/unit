-- An injective ring map out of a regular ring reflects units. If a=a^2b,
-- the complement 1-ab annihilates a. Its image is zero when the image
-- of a is a unit; injectivity gives ab=1. Eliminate the regular witness
-- only into the proposition that a is invertible.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module TC = TruncationCombinators[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (h : H.Hom A B)
 (injective : (a b : A.R) -> Id B.R (h.1 a) (h.1 b) -> Id A.R a b)
 (regular : PrincipalRegularity[l].Over[A].Regular) {
 module L = RL[A] ; module LB = RL[B] ; module R = PrincipalRegularity[l].Over[A] ;
 module At (a : A.R) (image-unit : LB.unit (h.1 a)) (v : R.Witness a) {
  module Support = PrimeIdempotents[l].Over[A].Regular[a,v.1,v.2] ;
  image-zero : Id B.R (h.1 Support.annihilator) B.z =
   LB.unit-reg (h.1 a) (h.1 Support.annihilator) image-unit
    (trans (sym (h.2.2.2 a Support.annihilator))
     (trans (ap h.1 (trans (A.mulC a Support.annihilator) Support.kills)) (H.zero A B h))) ;
  complement-zero : Id A.R Support.annihilator A.z =
   injective Support.annihilator A.z (trans image-zero (sym (H.zero A B h))) ;
  theorem : L.unit a = (v.1,sym (FormallyEtale[l].Units[A,setA].sub-zero A.o (A.mul a v.1) complement-zero)) ;
 } ;
 theorem (a : A.R) (image-unit : LB.unit (h.1 a)) : L.unit a =
  TC.rec (R.Witness a) @l (L.unit a) (FormallyEtale[l].Units[A,setA].unit-prop a)
   (\ v -> At[a,image-unit,v].theorem) (regular a) ;
} ;
