-- A tensor separator is a global primitive element in a finite reduced
-- algebra over a discrete field. Construct its minimal polynomial. The
-- derivative-unit theorem supplies an inverse in S. The minimal-polynomial
-- quotient Q embeds in S and is regular, so the inverse belongs to Q.
-- TensorPolynomialCoordinates then makes Q -> S surjective; the existing
-- minimal-polynomial injection constructs the inverse algebra map.
-- Degree zero is included: its root equation says that S is the zero ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (x : S.ring.R) (w : D.ring.R)
 (separator : Id D.ring.R (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference x) w)
  (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
 module Min = MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x] ;
 module Injection = MinimalPolynomialInjection[l].Over[k,setk,field,S,n,basis,x] ;
 module Target = MonogenicPresentation[l].Over[k,setk] ;
 module V = MonicBasisUniversal[l].Values[k,S.ring,S.iota,x] ;
 module Derivative = MonicDualValues[l].Over[k,S.ring,S.set,S.iota,x] ;
 module L = RL[S.ring] ;
 module Given (f : Min.Minimal) {
  module Image = Injection.At[f] ;
  root-at (cs : List k.R) (same : Id (List k.R) f.lower cs) : Id S.ring.R (V.value cs) S.ring.z =
   trans (ap V.value (sym same)) Image.root ;
  length-at (cs : List k.R) (same : Id (List k.R) f.lower cs) : Id Nat (Min.Raw.plen cs) f.degree =
   trans (ap Min.Raw.plen (sym same)) f.length ;
  no-roots-at (cs : List k.R) (same : Id (List k.R) f.lower cs) : Min.NoRoots (Min.Raw.plen cs) =
   \ p bound root -> f.no-smaller p
    (\ i -> trans (ap (Min.Raw.coef p) (ap (\ d -> plus d i) (sym (length-at cs same)))) (bound i)) root ;
  image-unit-case : (cs : List k.R) -> Id (List k.R) f.lower cs -> L.unit (Derivative.slope cs) = split {
   nil -> \ same -> (S.ring.z,trans (L.zero-mul S.ring.z) (sym (root-at nil same))) ;
   cons a cs -> \ same -> SeparatorDerivativeUnit[l].Over[k,setk,field,S,D,cp,n,basis,x,epsilon,w,separator,
    a,cs,root-at (cons a cs) same,no-roots-at (cons a cs) same].theorem } ;
  image-unit : L.unit (Derivative.slope f.lower) = image-unit-case f.lower (refl f.lower) ;
  module Slope = MonicDualValues[l].Natural[k,setk,Image.Q,S,Image.hom,Image.M.x] ;
  slope-map : Id S.ring.R (Image.hom.1.1 (Slope.Source.slope f.lower)) (Derivative.slope f.lower) =
   trans (Slope.slope f.lower)
    (ap (\ a -> MonicDualValues[l].Over[k,S.ring,S.set,S.iota,a].slope f.lower) Image.beta) ;
  module Reflect = RegularUnitReflection[l].Over[Image.Q.ring,S.ring,Image.Q.set,Image.hom.1,Image.injective,Image.Reduced[reduced].regular] ;
  separable : RL[Image.Q.ring].unit (Slope.Source.slope f.lower) =
   Reflect.theorem (Slope.Source.slope f.lower) (subst L.unit (sym slope-map) image-unit) ;
  inverse-law : Id S.ring.R
   (S.ring.mul (Image.hom.1.1 separable.1) (Derivative.slope f.lower)) S.ring.o =
   trans (ap (S.ring.mul (Image.hom.1.1 separable.1)) (sym slope-map))
    (trans (S.ring.mulC (Image.hom.1.1 separable.1) (Image.hom.1.1 (Slope.Source.slope f.lower)))
     (trans (sym (Image.hom.1.2.2.2 (Slope.Source.slope f.lower) separable.1))
      (trans (ap Image.hom.1.1 separable.2) Image.hom.1.2.1))) ;
  module Coordinates = TensorPolynomialCoordinates[l].Over[k,setk,S,D,Image.Q,cp,n,basis,Image.hom,Image.M.x,x,Image.beta] ;
  module Onto = Coordinates.At[epsilon,w,separator,f.lower,Image.root,separable.1,inverse-law] ;
  generated (a : S.ring.R) : Tr.Trunc[(p : Min.B.Carrier) * Id S.ring.R (Min.P.UP.extend.1 p) a].carrier =
   Tr.Trunc[(p : Min.B.Carrier) * Id S.ring.R (Min.P.UP.extend.1 p) a].inc
    (Image.M.B.normal-form (Onto.lift a),trans (Image.normal-value (Onto.lift a)) (Onto.theorem a)) ;
  module Iso = Image.Monogenic[generated] ;
  theorem : Target.At[S] = new Target.At[S,f.lower,Image.hom,Iso.backward,Iso.forward-backward,Iso.backward-forward,separable] ;
 } ;
 theorem : Tr.Trunc[Target.At[S]].carrier = TC.map Min.Minimal (Target.At[S]) (\ f -> Given[f].theorem) Min.theorem ;
} ;
