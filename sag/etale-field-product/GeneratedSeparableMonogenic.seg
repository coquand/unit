-- If a finite reduced algebra with nondegenerate trace is generated by
-- x, its minimal polynomial gives a separable monogenic presentation.
-- The quotient embeds by minimality and surjects by generation. Transfer
-- trace nondegeneracy through the resulting explicit algebra isomorphism
-- and reuse the proved derivative/trace theorem for the monic quotient.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (x : S.ring.R)
 (generated : (a : S.ring.R) -> Tr.Trunc[(p : PolynomialRing[l].Extension[k,setk].Carrier) *
  Id S.ring.R (Universal[l].Property[k,S.ring,setk,S.set].Given[S.iota,x].extend.1 p) a].carrier) {
 module Min = MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x] ;
 module Injection = MinimalPolynomialInjection[l].Over[k,setk,field,S,n,basis,x] ;
 module TL = TraceLinear[l].Over[k,setk] ; module Target = MonogenicPresentation[l].Over[k,setk] ;
 module Given (f : Min.Minimal) {
  module Image = Injection.At[f] ; module Maps = Image.Monogenic[generated] ;
  inclusion : TL.Linear[Image.Q,S] = new TL.Linear[Image.Q,S,Image.hom.1.1,Image.hom.1.2.2.1,
   \ r a -> trans (Image.hom.1.2.2.2 (Image.Q.iota.1 r) a)
    (ap (\ b -> S.ring.mul b (Image.hom.1.1 a)) (Image.hom.2 r))] ;
  multiplication (a : Image.Q.ring.R) (b : S.ring.R) :
   Id S.ring.R (Image.hom.1.1 (Image.Q.ring.mul a (Maps.backward.1.1 b))) (S.ring.mul (Image.hom.1.1 a) b) =
    trans (Image.hom.1.2.2.2 a (Maps.backward.1.1 b))
     (ap (S.ring.mul (Image.hom.1.1 a)) (Maps.forward-backward b)) ;
  module Trace = TraceRetraction[l].Over[k,setk,S,Image.Q,n,Image.M.degree,basis,Image.M.basis,
   Maps.backward,inclusion,Maps.backward-forward,multiplication] ;
  separable : RL[Image.Q.ring].unit (MonicTraceSeparable[l].Over[k,setk,f.lower].derivative) =
   MonicTraceSeparable[l].Over[k,setk,f.lower].Regular[Trace.nondegenerate nondegenerate].theorem Image.Reduced[reduced].regular ;
  theorem : Target.At[S] = new Target.At[S,f.lower,Image.hom,Maps.backward,Maps.forward-backward,Maps.backward-forward,separable] ;
 } ;
 theorem : Tr.Trunc[Target.At[S]].carrier = TC.map Min.Minimal (Target.At[S]) (\ f -> Given[f].theorem) Min.theorem ;
} ;
