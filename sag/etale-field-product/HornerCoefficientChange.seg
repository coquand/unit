-- Polynomial evaluation commutes with a map of rings and a change of
-- coefficient ring. Here the map into the target corner is unital.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (K k A T : CRing) (coefficient : RingHom[l].Hom K k)
 (rho : RingHom[l].Hom K A) (iota : RingHom[l].Hom k T)
 (hom : RingHom[l].Hom A T)
 (constants : (a : K.R) -> Id T.R (hom.1 (rho.1 a)) (iota.1 (coefficient.1 a)))
 (x : A.R) {
 module Source = MonicReduce[l].Horner[K,A,rho,x] ;
 module Target = MonicReduce[l].Horner[k,T,iota,hom.1 x] ;
 map : List K.R -> List k.R = split { nil -> nil ; cons a p | ih -> cons (coefficient.1 a) ih } ;
 value : (p : List K.R) -> Id T.R (hom.1 (Source.horner p)) (Target.horner (map p)) = split {
  nil -> RingHom[l].zero A T hom ;
  cons a p | ih -> trans (hom.2.2.1 (rho.1 a) (A.mul x (Source.horner p)))
   (cong2 T.R T.add _ _ _ _ (constants a)
    (trans (hom.2.2.2 x (Source.horner p)) (ap (T.mul (hom.1 x)) ih))) } ;
} ;
