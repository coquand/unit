-- The coordinates of H(left(x),right(x)) belong to any subalgebra
-- containing x. Construct their preimages by the Horner recursion and
-- the multiplication matrix of x. If f'(x) has an inverse in that
-- subalgebra, H=epsilon*right(f'(x)) gives preimages of every coordinate
-- of epsilon. Trace duality then constructs a preimage of every element
-- of S. Thus the subalgebra is all of S, without relative Gaussian
-- elimination or selection of a prime.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S D Q : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (hom : Algebras[l].Over[k,setk].Hom Q S) (y : Q.ring.R) (x : S.ring.R)
 (beta : Id S.ring.R (hom.1.1 y) x) {
 module DD = TensorDividedDifference[l].Over[k,setk,S,D,cp,x] ; module DK = DD.DK ;
 module TB = TensorBasisConstruct[l].Over[k,setk].At[S,D,cp,n,basis] ;
 module QS = FiniteIdeal[l].Sums[Q.ring] ; module SS = FiniteIdeal[l].Sums[S.ring] ;
 module QV = MonicBasisUniversal[l].Values[k,Q.ring,Q.iota,y] ;
 module Natural = MonicValueNaturality[l].Over[k,setk].Map[Q,S,hom,y] ;
 module DL = RL[D.ring] ; module SL = RL[S.ring] ;
 map-sum : (r : Nat) (v : Fin r -> Q.ring.R) ->
  Id S.ring.R (hom.1.1 (QS.sum r v)) (SS.sum r (\ i -> hom.1.1 (v i))) = split {
   zero -> \ v -> H.zero Q.ring S.ring hom.1 ;
   suc r | ih -> \ v -> trans (hom.1.2.2.1 (v (inr tt)) (QS.sum r (\ i -> v (inl i))))
    (ap (S.ring.add (hom.1.1 (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 value-map (cs : List k.R) : Id S.ring.R (hom.1.1 (QV.value cs)) (DD.V.value cs) =
  trans (Natural.value cs) (ap (\ a -> MonicBasisUniversal[l].Values[k,S.ring,S.iota,a].value cs) beta) ;
 scaled-map (a : k.R) (b : Q.ring.R) :
  Id S.ring.R (hom.1.1 (Q.ring.mul (Q.iota.1 a) b)) (S.ring.mul (S.iota.1 a) (hom.1.1 b)) =
   trans (hom.1.2.2.2 (Q.iota.1 a) b) (ap (\ c -> S.ring.mul c (hom.1.1 b)) (hom.2 a)) ;
 right-coordinate (a : S.ring.R) (i : Fin n) :
  Id S.ring.R (TB.coordinate (DK.right.1.1 a) i) (S.ring.mul (S.iota.1 (basis.coordinate S.ring.o i)) a) =
   trans (ap (\ b -> TB.coordinate b i)
    (sym (trans (ap (\ b -> D.ring.mul b (DK.right.1.1 a)) DK.left.1.2.1) (DL.one-left (DK.right.1.1 a)))))
    (TB.Trace.pure S.ring.o a i) ;
 preimage : List k.R -> Fin n -> Q.ring.R = split {
  nil -> \ i -> Q.ring.z ;
  cons a cs | ih -> \ i -> Q.ring.add
   (Q.ring.mul (Q.iota.1 (basis.coordinate S.ring.o i)) (QV.value cs))
   (QS.sum n (\ j -> Q.ring.mul (Q.iota.1 (basis.coordinate (S.ring.mul x (basis.vector j)) i)) (ih j))) } ;
 coordinates : (cs : List k.R) (i : Fin n) ->
  Id S.ring.R (hom.1.1 (preimage cs i)) (TB.coordinate (DD.DD.value cs) i) = split {
   nil -> \ i -> trans (H.zero Q.ring S.ring hom.1) (sym (TB.Trace.zero i)) ;
   cons a cs | ih -> \ i ->
    trans (hom.1.2.2.1
     (Q.ring.mul (Q.iota.1 (basis.coordinate S.ring.o i)) (QV.value cs))
     (QS.sum n (\ j -> Q.ring.mul (Q.iota.1 (basis.coordinate (S.ring.mul x (basis.vector j)) i)) (preimage cs j))))
     (trans (cong2 S.ring.R S.ring.add _ _ _ _
      (trans (scaled-map (basis.coordinate S.ring.o i) (QV.value cs))
       (trans (ap (S.ring.mul (S.iota.1 (basis.coordinate S.ring.o i))) (value-map cs))
        (trans (sym (right-coordinate (DD.V.value cs) i))
         (ap (\ b -> TB.coordinate b i) (DD.RightValue.value cs)))))
      (trans (map-sum n (\ j -> Q.ring.mul (Q.iota.1 (basis.coordinate (S.ring.mul x (basis.vector j)) i)) (preimage cs j)))
       (trans (SS.sum-cong n
        (\ j -> hom.1.1 (Q.ring.mul (Q.iota.1 (basis.coordinate (S.ring.mul x (basis.vector j)) i)) (preimage cs j)))
        (\ j -> S.ring.mul (S.iota.1 (basis.coordinate (S.ring.mul x (basis.vector j)) i)) (TB.coordinate (DD.DD.value cs) j))
        (\ j -> trans (scaled-map (basis.coordinate (S.ring.mul x (basis.vector j)) i) (preimage cs j))
         (ap (S.ring.mul (S.iota.1 (basis.coordinate (S.ring.mul x (basis.vector j)) i))) (ih j))))
        (sym (TB.Trace.left-action x (DD.DD.value cs) i)))))
      (sym (TB.coordinate-add (DD.DD.Y.value cs) (D.ring.mul (DK.left.1.1 x) (DD.DD.value cs)) i))) } ;
 module At (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
  (w : D.ring.R) (separator : Id D.ring.R (D.ring.mul (DK.difference x) w)
   (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)))
  (cs : List k.R) (root : Id S.ring.R (DD.V.value cs) S.ring.z)
  (inverse : Q.ring.R)
  (inverse-law : Id S.ring.R (S.ring.mul (hom.1.1 inverse) (DD.Derivative.slope cs)) S.ring.o) {
  module Trace = TB.Trace.Extract[epsilon].Trace ;
  module Basis = TraceBasis[l].Over[k,setk,S].At[n,basis] ;
  module Divided = DD.Separator[epsilon,w,separator].At[cs,root] ;
  epsilon-equation : Id D.ring.R
   (D.ring.mul (DK.right.1.1 (hom.1.1 inverse)) (DD.DD.value cs)) epsilon.epsilon =
   trans (ap (D.ring.mul (DK.right.1.1 (hom.1.1 inverse))) Divided.theorem)
    (trans (DL.mul-swap (DK.right.1.1 (hom.1.1 inverse)) epsilon.epsilon (DK.right.1.1 (DD.Derivative.slope cs)))
     (trans (ap (D.ring.mul epsilon.epsilon)
      (trans (sym (DK.right.1.2.2.2 (hom.1.1 inverse) (DD.Derivative.slope cs)))
       (trans (ap DK.right.1.1 inverse-law) DK.right.1.2.1))) (D.ring.mulO epsilon.epsilon))) ;
  cofactor (i : Fin n) : Q.ring.R = Q.ring.mul inverse (preimage cs i) ;
  cofactor-map (i : Fin n) : Id S.ring.R (hom.1.1 (cofactor i)) (TB.coordinate epsilon.epsilon i) =
   trans (hom.1.2.2.2 inverse (preimage cs i))
    (trans (ap (S.ring.mul (hom.1.1 inverse)) (coordinates cs i))
     (trans (sym (TB.coordinate-scale (hom.1.1 inverse) (DD.DD.value cs) i))
      (ap (\ b -> TB.coordinate b i) epsilon-equation))) ;
  lift (a : S.ring.R) : Q.ring.R =
   QS.sum n (\ i -> Q.ring.mul (Q.iota.1 (Basis.trace (S.ring.mul a (basis.vector i)))) (cofactor i)) ;
  theorem (a : S.ring.R) : Id S.ring.R (hom.1.1 (lift a)) a =
   trans (map-sum n (\ i -> Q.ring.mul (Q.iota.1 (Basis.trace (S.ring.mul a (basis.vector i)))) (cofactor i)))
    (trans (SS.sum-cong n
     (\ i -> hom.1.1 (Q.ring.mul (Q.iota.1 (Basis.trace (S.ring.mul a (basis.vector i)))) (cofactor i)))
     (\ i -> S.ring.mul (S.iota.1 (Basis.trace (S.ring.mul a (basis.vector i)))) (TB.coordinate epsilon.epsilon i))
     (\ i -> trans (scaled-map (Basis.trace (S.ring.mul a (basis.vector i))) (cofactor i))
      (ap (S.ring.mul (S.iota.1 (Basis.trace (S.ring.mul a (basis.vector i))))) (cofactor-map i))))
     (sym (Trace.trace-identity a))) ;
 } ;
} ;
