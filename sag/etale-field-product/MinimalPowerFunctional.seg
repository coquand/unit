-- Minimality makes x^m independent of the preceding powers whenever
-- there is no nonzero relation of degree at most m. A dependence would
-- give a monic annihilator of degree m, contradicting its leading 1.
-- The separating-functional construction therefore extracts the top
-- coefficient of every polynomial in x of degree at most m.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (x : S.ring.R)
 (m : Nat) (no-roots : MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x].NoRoots (suc m)) {
 module Min = MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x] ;
 module P = Min.P ; module C = Algebras[l].Over[k,setk] ;
 module TL = TraceLinear[l].Over[k,setk] ;
 module Witness (w : P.At[m].Witness) {
  module Relation = P.At[m].Relation[w] ;
  bound : P.Bound.Bound (suc m) (P.HI.monic-list Relation.lower) =
   \ i -> trans (ap (P.Raw.coef (P.HI.monic-list Relation.lower))
    (ap (\ d -> plus (suc d) i) (sym Relation.length))) (P.HI.above Relation.lower i) ;
  contradiction : Empty = field.nonzero
   (trans (sym (P.HI.leading Relation.lower))
    (no-roots (P.HI.monic-list Relation.lower) bound Relation.root (P.Raw.plen Relation.lower))) ;
 } ;
 outside (w : P.At[m].Witness) : Empty = Witness[w].contradiction ;
 module Separate = FieldSeparatingFunctional[l].Over[k,setk,field].Algebra[
  S,n,basis,m,P.E.basis m,P.At[m].target,outside] ;
 linear : TL.Linear[S,C.base] = Separate.linear ;
 kills (i : Fin m) : Id k.R (linear.map (P.E.basis m i)) k.z = Separate.kills i ;
 target : Id k.R (linear.map (P.At[m].target)) k.o = Separate.target ;
 embedded (a : S.ring.R) : S.ring.R = S.iota.1 (linear.map a) ;
 embedded-add (a b : S.ring.R) : Id S.ring.R (embedded (S.ring.add a b)) (S.ring.add (embedded a) (embedded b)) =
  trans (ap S.iota.1 (linear.add a b)) (S.iota.2.2.1 (linear.map a) (linear.map b)) ;
 embedded-scale (r : k.R) (a : S.ring.R) :
  Id S.ring.R (embedded (S.ring.mul (S.iota.1 r) a)) (S.ring.mul (S.iota.1 r) (embedded a)) =
   trans (ap S.iota.1 (linear.scale r a)) (S.iota.2.2.2 r (linear.map a)) ;
 lifted : TL.Linear[S,S] = new TL.Linear[S,S,embedded,embedded-add,embedded-scale] ;
 lifted-kills (i : Fin m) : Id S.ring.R (lifted.map (P.E.basis m i)) S.ring.z =
  trans (ap S.iota.1 (kills i)) (RingHom[l].zero k S.ring S.iota) ;
 lifted-target : Id S.ring.R (lifted.map (P.At[m].target)) S.ring.o = trans (ap S.iota.1 target) S.iota.2.1 ;
} ;
