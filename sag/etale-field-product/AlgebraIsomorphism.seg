-- Explicit algebra isomorphisms and componentwise binary products.
-- These are ordinary maps with inverse equations; no transport of
-- algebra structures along univalence is needed for product assembly.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ;
 record Iso (S T : C.Algebra) {
  forward : C.Hom S T ; backward : C.Hom T S ;
  forward-backward (a : T.ring.R) : Id T.ring.R (forward.1.1 (backward.1.1 a)) a ;
  backward-forward (a : S.ring.R) : Id S.ring.R (backward.1.1 (forward.1.1 a)) a ;
 } ;
 identity (S : C.Algebra) : Iso[S,S] = new Iso[S,S,C.identity S,C.identity S,\ a -> refl a,\ a -> refl a] ;
 module Inverse (S T : C.Algebra) (hom : C.Hom S T) (inverse : T.ring.R -> S.ring.R)
  (forward-backward : (a : T.ring.R) -> Id T.ring.R (hom.1.1 (inverse a)) a)
  (backward-forward : (a : S.ring.R) -> Id S.ring.R (inverse (hom.1.1 a)) a) {
  injective (a b : S.ring.R) (h : Id T.ring.R (hom.1.1 a) (hom.1.1 b)) : Id S.ring.R a b =
   trans (sym (backward-forward a)) (trans (ap inverse h) (backward-forward b)) ;
  one : Id S.ring.R (inverse T.ring.o) S.ring.o = injective _ _ (trans (forward-backward T.ring.o) (sym hom.1.2.1)) ;
  add (a b : T.ring.R) : Id S.ring.R (inverse (T.ring.add a b)) (S.ring.add (inverse a) (inverse b)) =
   injective _ _ (trans (forward-backward (T.ring.add a b))
    (sym (trans (hom.1.2.2.1 (inverse a) (inverse b)) (cong2 T.ring.R T.ring.add _ _ _ _ (forward-backward a) (forward-backward b))))) ;
  mul (a b : T.ring.R) : Id S.ring.R (inverse (T.ring.mul a b)) (S.ring.mul (inverse a) (inverse b)) =
   injective _ _ (trans (forward-backward (T.ring.mul a b))
    (sym (trans (hom.1.2.2.2 (inverse a) (inverse b)) (cong2 T.ring.R T.ring.mul _ _ _ _ (forward-backward a) (forward-backward b))))) ;
  constants (a : k.R) : Id S.ring.R (inverse (T.iota.1 a)) (S.iota.1 a) =
   injective _ _ (trans (forward-backward (T.iota.1 a)) (sym (hom.2 a))) ;
  backward : C.Hom T S = ((inverse,one,add,mul),constants) ;
  theorem : Iso[S,T] = new Iso[S,T,hom,backward,forward-backward,backward-forward] ;
 } ;
 reverse (S T : C.Algebra) (f : Iso[S,T]) : Iso[T,S] =
  new Iso[T,S,f.backward,f.forward,f.backward-forward,f.forward-backward] ;
 compose (S T U0 : C.Algebra) (g : Iso[T,U0]) (f : Iso[S,T]) : Iso[S,U0] =
  new Iso[S,U0,C.compose S T U0 g.forward f.forward,C.compose U0 T S f.backward g.backward,
   \ a -> trans (ap g.forward.1.1 (f.forward-backward (g.backward.1.1 a))) (g.forward-backward a),
   \ a -> trans (ap f.backward.1.1 (g.backward-forward (f.forward.1.1 a))) (f.backward-forward a)] ;
 module Product (S T : C.Algebra) {
  Carrier : U l = S.ring.R * T.ring.R ;
  eq (a b : Carrier) (h : Id S.ring.R a.1 b.1) (q : Id T.ring.R a.2 b.2) : Id Carrier a b =
   AffineHLevels[l].pair-path S.ring.R T.ring.R a.1 b.1 a.2 b.2 h q ;
  ring : CRing = mkCRing Carrier (S.ring.z,T.ring.z) (S.ring.o,T.ring.o)
   (\ a b -> (S.ring.add a.1 b.1,T.ring.add a.2 b.2))
   (\ a b -> (S.ring.mul a.1 b.1,T.ring.mul a.2 b.2)) (\ a -> (S.ring.neg a.1,T.ring.neg a.2))
   (\ a b c -> eq _ _ (S.ring.addA a.1 b.1 c.1) (T.ring.addA a.2 b.2 c.2))
   (\ a b -> eq _ _ (S.ring.addC a.1 b.1) (T.ring.addC a.2 b.2))
   (\ a -> eq _ _ (S.ring.addZ a.1) (T.ring.addZ a.2))
   (\ a -> eq _ _ (S.ring.addN a.1) (T.ring.addN a.2))
   (\ a b c -> eq _ _ (S.ring.mulA a.1 b.1 c.1) (T.ring.mulA a.2 b.2 c.2))
   (\ a b -> eq _ _ (S.ring.mulC a.1 b.1) (T.ring.mulC a.2 b.2))
   (\ a -> eq _ _ (S.ring.mulO a.1) (T.ring.mulO a.2))
   (\ a b c -> eq _ _ (S.ring.dist a.1 b.1 c.1) (T.ring.dist a.2 b.2 c.2)) ;
  set : Pr.isSet Carrier = Pr.isSet-Sigma S.ring.R (\ a -> T.ring.R) S.set (\ a -> T.set) ;
  iota : RingHom[l].Hom k ring = (\ a -> (S.iota.1 a,T.iota.1 a),eq _ _ S.iota.2.1 T.iota.2.1,
   \ a b -> eq _ _ (S.iota.2.2.1 a b) (T.iota.2.2.1 a b),\ a b -> eq _ _ (S.iota.2.2.2 a b) (T.iota.2.2.2 a b)) ;
  algebra : C.Algebra = C.mkAlgebra ring set iota ;
  module Into (U0 : C.Algebra) (f : C.Hom U0 S) (g : C.Hom U0 T) {
   hom : C.Hom U0 algebra = ((\ a -> (f.1.1 a,g.1.1 a),eq _ _ f.1.2.1 g.1.2.1,
    \ a b -> eq _ _ (f.1.2.2.1 a b) (g.1.2.2.1 a b),\ a b -> eq _ _ (f.1.2.2.2 a b) (g.1.2.2.2 a b)),
    \ a -> eq _ _ (f.2 a) (g.2 a)) ;
  } ;
 } ;
 module ProductMap (S T U0 V : C.Algebra) (f : C.Hom S U0) (g : C.Hom T V) {
  module Source = Product[S,T] ; module Target = Product[U0,V] ;
  hom : C.Hom Source.algebra Target.algebra =
   ((\ a -> (f.1.1 a.1,g.1.1 a.2),Target.eq _ _ f.1.2.1 g.1.2.1,
    \ a b -> Target.eq _ _ (f.1.2.2.1 a.1 b.1) (g.1.2.2.1 a.2 b.2),
    \ a b -> Target.eq _ _ (f.1.2.2.2 a.1 b.1) (g.1.2.2.2 a.2 b.2)),
    \ a -> Target.eq _ _ (f.2 a) (g.2 a)) ;
 } ;
 product (S T U0 V : C.Algebra) (f : Iso[S,U0]) (g : Iso[T,V]) : Iso[Product[S,T].algebra,Product[U0,V].algebra] =
  new Iso[Product[S,T].algebra,Product[U0,V].algebra,ProductMap[S,T,U0,V,f.forward,g.forward].hom,
   ProductMap[U0,V,S,T,f.backward,g.backward].hom,
   \ a -> Product[U0,V].eq _ _ (f.forward-backward a.1) (g.forward-backward a.2),
   \ a -> Product[S,T].eq _ _ (f.backward-forward a.1) (g.backward-forward a.2)] ;
} ;
