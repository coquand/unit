-- Contract a monic polynomial in the left variable by the functional
-- extracting its highest power. Every lower term vanishes, and the
-- leading term contributes 1. Coefficients lie in the right tensor
-- factor and need not lie in the base field. The result applies to the
-- synthetic quotient in TensorDividedDifference.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (x : S.ring.R)
 (m : Nat) (no-roots : MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x].NoRoots (suc m)) {
 module C = Algebras[l].Over[k,setk] ;
 module Functional = MinimalPowerFunctional[l].Over[k,setk,field,S,n,basis,x,m,no-roots] ;
 module P = Functional.P ;
 module Contract = TensorContraction[l].Over[k,setk,S,D,cp,n,basis,S,C.identity S,Functional.lifted] ;
 module DK = Contract.DK ; module SL = RL[S.ring] ; module DL = RL[D.ring] ;
 module UP = Universal[l].Property[S.ring,D.ring,S.set,D.set].Given[DK.right.1,DK.left.1.1 x] ;
 module Pol = PolynomialRing[l].Extension[S.ring,S.set] ;
 module Raw = Poly[l].PolyR[S.ring] ; module Bounds = PolynomialBounds[l].Over[S.ring] ;
 module Expansion = PolynomialFiniteExpansion[l].Over[S.ring,D.ring,S.set,UP.extend] ;
 module DS = FiniteIdeal[l].Sums[D.ring] ; module SS = FiniteIdeal[l].Sums[S.ring] ;
 module Pow = AffinePowers[l].Over[D.ring] ;
 module MV = MonicBasisUniversal[l].Values[S.ring,D.ring,DK.right.1,DK.left.1.1 x] ;
 variable : Id D.ring.R Expansion.variable (DK.left.1.1 P.E.variable) =
  trans UP.on-variable (ap DK.left.1.1 (sym P.UP.on-variable)) ;
 power-basis : (r : Nat) (i : Fin r) -> Id D.ring.R (Expansion.basis r i) (DK.left.1.1 (P.E.basis r i)) = split {
  zero -> \ i -> efq i ;
  suc r | ih -> AffineFinite[l].section r
   (\ i -> Id D.ring.R (Expansion.basis (suc r) i) (DK.left.1.1 (P.E.basis (suc r) i)))
   (\ i -> trans (cong2 D.ring.R D.ring.mul _ _ _ _ variable (ih i))
    (sym (DK.left.1.2.2.2 P.E.variable (P.E.basis r i)))) (sym DK.left.1.2.1) } ;
 term (a : S.ring.R) (i : Fin m) :
  Id S.ring.R (Contract.map (D.ring.mul (Expansion.phi.1 a) (Expansion.basis m i))) S.ring.z =
   trans (ap Contract.map (trans (cong2 D.ring.R D.ring.mul _ _ _ _ (UP.on-constants a) (power-basis m i))
    (D.ring.mulC (DK.right.1.1 a) (DK.left.1.1 (P.E.basis m i)))))
    (trans (Contract.pure (P.E.basis m i) a)
     (trans (ap (\ b -> S.ring.mul b a) (Functional.lifted-kills i)) (SL.zero-mul a))) ;
 lower-zero (q : Raw.P) (bound : Bounds.Bound m q) :
  Id S.ring.R (Contract.map (UP.extend.1 (Pol.include q))) S.ring.z =
   trans (ap Contract.map (Expansion.equation m q bound))
    (trans (Contract.Laws.sum m (\ i -> D.ring.mul (Expansion.phi.1 (Expansion.coefficients m q i)) (Expansion.basis m i)))
     (trans (SS.sum-cong m
      (\ i -> Contract.map (D.ring.mul (Expansion.phi.1 (Expansion.coefficients m q i)) (Expansion.basis m i)))
      (\ i -> S.ring.z) (\ i -> term (Expansion.coefficients m q i) i)) (SS.sum-zero m))) ;
 top-power : Id D.ring.R (Pow.power (DK.left.1.1 x) m) (DK.left.1.1 P.At[m].target) =
  trans (ap (\ a -> Pow.power (DK.left.1.1 a) m) (sym P.UP.on-variable))
   (sym (AffinePowers[l].power-map S.ring D.ring DK.left.1 P.E.variable m)) ;
 top : Id S.ring.R (Contract.map (Pow.power (DK.left.1.1 x) m)) S.ring.o =
  trans (ap Contract.map top-power) (trans (Contract.left P.At[m].target) Functional.lifted-target) ;
 value-cons (a : S.ring.R) (q : Raw.P) :
  Id D.ring.R (UP.extend.1 (Pol.include (cons a q)))
   (D.ring.add (DK.right.1.1 a) (D.ring.mul (DK.left.1.1 x) (UP.extend.1 (Pol.include q)))) =
   trans (ap UP.extend.1 (Pol.horner a q))
    (trans (UP.extend.2.2.1 (Pol.constant a) (Pol.mulQ Pol.variable (Pol.include q)))
     (cong2 D.ring.R D.ring.add _ _ _ _ (UP.on-constants a)
      (trans (UP.extend.2.2.2 Pol.variable (Pol.include q))
       (ap (\ b -> D.ring.mul b (UP.extend.1 (Pol.include q))) UP.on-variable)))) ;
 monic-split : (q : Raw.P) -> Id D.ring.R (MV.value q)
  (D.ring.add (UP.extend.1 (Pol.include q)) (Pow.power (DK.left.1.1 x) (Raw.plen q))) = split {
  nil -> sym (trans (ap (\ a -> D.ring.add a D.ring.o) (H.zero Pol.ring D.ring UP.extend)) (DL.zl D.ring.o)) ;
  cons a q | ih -> trans (ap (\ b -> D.ring.add (DK.right.1.1 a) (D.ring.mul (DK.left.1.1 x) b)) ih)
   (trans (ap (D.ring.add (DK.right.1.1 a))
    (D.ring.dist (DK.left.1.1 x) (UP.extend.1 (Pol.include q)) (Pow.power (DK.left.1.1 x) (Raw.plen q))))
    (trans (D.ring.addA (DK.right.1.1 a) (D.ring.mul (DK.left.1.1 x) (UP.extend.1 (Pol.include q)))
     (Pow.power (DK.left.1.1 x) (suc (Raw.plen q))))
     (ap (\ b -> D.ring.add b (Pow.power (DK.left.1.1 x) (suc (Raw.plen q)))) (sym (value-cons a q))))) } ;
 theorem (q : Raw.P) (length : Id Nat (Raw.plen q) m) : Id S.ring.R (Contract.map (MV.value q)) S.ring.o =
  trans (ap Contract.map (monic-split q))
   (trans (Contract.add (UP.extend.1 (Pol.include q)) (Pow.power (DK.left.1.1 x) (Raw.plen q)))
    (trans (cong2 S.ring.R S.ring.add _ _ _ _
     (lower-zero q (\ i -> trans (ap (Raw.coef q) (ap (\ d -> plus d i) (sym length))) (Mul[l].MulR[S.ring].coef-beyond q i)))
     (trans (ap (\ d -> Contract.map (Pow.power (DK.left.1.1 x) d)) length) top)) (SL.zl S.ring.o))) ;
} ;
