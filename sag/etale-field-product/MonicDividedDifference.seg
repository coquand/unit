-- For a monic polynomial f, construct H(X,Y) by Horner recursion:
-- H_{a+Tf}(X,Y)=f(Y)+X H_f(X,Y). Then
-- f(X)=f(Y)+(X-Y)H(X,Y). On the diagonal H is f'. More generally,
-- eX=eY implies eH(X,Y)=e f'(Y). These identities need no domain,
-- degree decision, polynomial factorisation, or cancellation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k A : CRing) (setA : Pr.isSet A.R)
 (iota : RingHom[l].Hom k A) (x y : A.R) {
 module L = RL[A] ;
 module X = MonicBasisUniversal[l].Values[k,A,iota,x] ;
 module Y = MonicBasisUniversal[l].Values[k,A,iota,y] ;
 module Derivative = MonicDualValues[l].Over[k,A,setA,iota,y] ;
 delta : A.R = A.add x (A.neg y) ;
 value : List k.R -> A.R = split {
  nil -> A.z ; cons a cs | ih -> A.add (Y.value cs) (A.mul x ih) } ;
 restore : Id A.R (A.add y delta) x =
  trans (L.add-swap y x (A.neg y)) (trans (ap (A.add x) (A.addN y)) (A.addZ x)) ;
 combine (v : A.R) : Id A.R (A.add (A.mul y v) (A.mul delta v)) (A.mul x v) =
  trans (sym (L.dist-left y delta v)) (ap (\ a -> A.mul a v) restore) ;
 step (a u v h : A.R) (ih : Id A.R u (A.add v (A.mul delta h))) :
  Id A.R (A.add a (A.mul x u))
   (A.add (A.add a (A.mul y v)) (A.mul delta (A.add v (A.mul x h)))) =
  calc A.R {
   A.add a (A.mul x u)
    =< ap (\ b -> A.add a (A.mul x b)) ih
     > A.add a (A.mul x (A.add v (A.mul delta h)))
    =< ap (A.add a) (A.dist x v (A.mul delta h))
     > A.add a (A.add (A.mul x v) (A.mul x (A.mul delta h)))
    =< ap (A.add a) (cong2 A.R A.add _ _ _ _ (sym (combine v)) (L.mul-swap x delta h))
     > A.add a (A.add (A.add (A.mul y v) (A.mul delta v)) (A.mul delta (A.mul x h)))
    =< ap (A.add a) (sym (A.addA (A.mul y v) (A.mul delta v) (A.mul delta (A.mul x h))))
     > A.add a (A.add (A.mul y v) (A.add (A.mul delta v) (A.mul delta (A.mul x h))))
    =< ap (\ b -> A.add a (A.add (A.mul y v) b)) (sym (A.dist delta v (A.mul x h)))
     > A.add a (A.add (A.mul y v) (A.mul delta (A.add v (A.mul x h))))
    =< A.addA a (A.mul y v) (A.mul delta (A.add v (A.mul x h)))
     > A.add (A.add a (A.mul y v)) (A.mul delta (A.add v (A.mul x h))) } ;
 factor : (cs : List k.R) -> Id A.R (X.value cs) (A.add (Y.value cs) (A.mul delta (value cs))) = split {
  nil -> sym (trans (ap (A.add A.o) (L.mul-zero delta)) (A.addZ A.o)) ;
  cons a cs | ih -> step (iota.1 a) (X.value cs) (Y.value cs) (value cs) ih } ;
 roots (cs : List k.R) (hx : Id A.R (X.value cs) A.z) (hy : Id A.R (Y.value cs) A.z) :
  Id A.R (A.mul delta (value cs)) A.z =
   trans (sym (L.zl (A.mul delta (value cs))))
    (trans (ap (\ a -> A.add a (A.mul delta (value cs))) (sym hy)) (trans (sym (factor cs)) hx)) ;
 module Diagonal (e : A.R) (equalises : Id A.R (A.mul e x) (A.mul e y)) {
  diagonal-step (v h d : A.R) (ih : Id A.R (A.mul e h) (A.mul e d)) :
   Id A.R (A.mul e (A.add v (A.mul x h))) (A.mul e (A.add (A.mul y d) v)) =
   trans (A.dist e v (A.mul x h))
    (trans (ap (A.add (A.mul e v))
     (trans (A.mulA e x h) (trans (ap (\ a -> A.mul a h) equalises)
      (trans (sym (A.mulA e y h)) (trans (L.mul-swap e y h)
       (trans (ap (A.mul y) ih) (L.mul-swap y e d)))))))
     (trans (A.addC (A.mul e v) (A.mul e (A.mul y d))) (sym (A.dist e (A.mul y d) v)))) ;
  theorem : (cs : List k.R) -> Id A.R (A.mul e (value cs)) (A.mul e (Derivative.slope cs)) = split {
   nil -> refl (A.mul e A.z) ;
   cons a cs | ih -> trans (diagonal-step (Y.value cs) (value cs) (Derivative.slope cs) ih)
    (ap (A.mul e) (sym (Derivative.slope-cons a cs))) } ;
 } ;
} ;
