-- Let f be a minimal monic annihilator of positive degree and let x
-- separate the tensor factors off the diagonal. The divided difference
-- is H=epsilon*right(f'(x)). Contract its left factor by the functional
-- extracting the highest power of x. Since H is monic in that variable,
-- the contraction is 1. Right linearity gives
--             1 = f'(x) * contraction(epsilon).
-- Thus the inverse is explicit; regularity is not needed in this step.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (x : S.ring.R)
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (w : D.ring.R) (separator : Id D.ring.R
  (D.ring.mul (DiagonalKernel[l].Over[k,setk].At[S,D,cp].difference x) w)
  (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)))
 (a : k.R) (cs : List k.R)
 (root : Id S.ring.R (MonicBasisUniversal[l].Values[k,S.ring,S.iota,x].value (cons a cs)) S.ring.z)
 (no-roots : MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x].NoRoots (suc (Poly[l].PolyR[k].plen cs))) {
 module DD = TensorDividedDifference[l].Over[k,setk,S,D,cp,x] ;
 module Monic = TensorMonicContraction[l].Over[k,setk,field,S,D,cp,n,basis,x,Poly[l].PolyR[k].plen cs,no-roots] ;
 module Contract = Monic.Contract ; module DK = DD.DK ;
 derivative : S.ring.R = DD.Derivative.slope (cons a cs) ;
 contracted : Id S.ring.R (Contract.map (DD.DD.value (cons a cs))) S.ring.o =
  trans (ap Contract.map (sym (DD.quotient-value cs a))) (Monic.theorem (DD.quotient cs) (DD.quotient-length cs)) ;
 identity : Id S.ring.R (Contract.map (DD.DD.value (cons a cs)))
  (S.ring.mul derivative (Contract.map epsilon.epsilon)) =
   trans (ap Contract.map (DD.Separator[epsilon,w,separator].At[cons a cs,root].theorem))
    (trans (ap Contract.map (D.ring.mulC epsilon.epsilon (DK.right.1.1 derivative))) (Contract.right derivative epsilon.epsilon)) ;
 theorem : RL[S.ring].unit derivative = (Contract.map epsilon.epsilon,trans (sym identity) contracted) ;
} ;
