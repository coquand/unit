-- Complementary refinement gives eS = efS x e(1-f)S. The forward
-- map is the pair of projections and the inverse adds the two fixed
-- points. Orthogonality proves the first inverse equation; the sum
-- ef+e(1-f)=e proves the other. Algebra-map laws of the inverse follow
-- from injectivity of the forward map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra) {
 module C = Algebras[l].Over[k,setk] ; module Iso = AlgebraIsomorphism[l].Over[k,setk] ;
 module PI = PrimeIdempotents[l].Over[S.ring] ; module L = RL[S.ring] ;
 module Corner = TraceRetraction[l] ;
 module Below (e u : S.ring.R) (he : Id S.ring.R (S.ring.mul e e) e)
  (hu : Id S.ring.R (S.ring.mul u u) u) (below : Id S.ring.R (S.ring.mul u e) u) {
  module Parent = Corner.Idempotent[k,setk,S,e,he] ; module Child = Corner.Idempotent[k,setk,S,u,hu] ;
  fixed (a : Child.F.Carrier) : Id S.ring.R (S.ring.mul e a.1) a.1 =
   trans (ap (S.ring.mul e) (sym a.2))
    (trans (S.ring.mulA e u a.1)
     (trans (ap (\ b -> S.ring.mul b a.1) (trans (S.ring.mulC e u) below)) a.2)) ;
  project (a : Parent.F.Carrier) : Child.F.Carrier = Child.F.project a.1 ;
  constants (r : k.R) : Id Child.F.Carrier (project (Parent.iota.1 r)) (Child.iota.1 r) =
   Child.F.eq _ _ (trans (S.ring.mulA u e (S.iota.1 r)) (ap (\ b -> S.ring.mul b (S.iota.1 r)) below)) ;
  hom : C.Hom Parent.algebra Child.algebra =
   ((project,Child.F.eq _ _ below,\ a b -> Child.F.project-add a.1 b.1,\ a b -> Child.F.project-mul a.1 b.1),constants) ;
 } ;
 module Split (e f : S.ring.R) (he : Id S.ring.R (S.ring.mul e e) e)
  (hf : Id S.ring.R (S.ring.mul f f) f) {
  u : S.ring.R = S.ring.mul e f ; v : S.ring.R = S.ring.mul e (PI.complement f) ;
  hu : Id S.ring.R (S.ring.mul u u) u = PI.product-idempotent e f he hf ;
  hv : Id S.ring.R (S.ring.mul v v) v = PI.product-idempotent e (PI.complement f) he (PI.complement-idempotent f hf) ;
  module Parent = Corner.Idempotent[k,setk,S,e,he] ; module Left = Corner.Idempotent[k,setk,S,u,hu] ; module Right = Corner.Idempotent[k,setk,S,v,hv] ;
  module LB = Below[e,u,he,hu,FiniteRegularRefinement[l].Over[S.ring,S.set].product-below e f he] ;
  module RB = Below[e,v,he,hv,FiniteRegularRefinement[l].Over[S.ring,S.set].product-below e (PI.complement f) he] ;
  module Product = Iso.Product[Left.algebra,Right.algebra] ;
  forward : C.Hom Parent.algebra Product.algebra = Product.Into[Parent.algebra,LB.hom,RB.hom].hom ;
  orthogonal : Id S.ring.R (S.ring.mul u v) S.ring.z =
   trans (L.mul-four e f e (PI.complement f))
    (trans (cong2 S.ring.R S.ring.mul _ _ _ _ he (PI.complement-kills f hf)) (L.mul-zero e)) ;
  total : Id S.ring.R (S.ring.add u v) e =
   trans (sym (S.ring.dist e f (PI.complement f))) (trans (ap (S.ring.mul e) (PI.complement-sum f)) (S.ring.mulO e)) ;
  left-kills (a : Right.F.Carrier) : Id S.ring.R (S.ring.mul u a.1) S.ring.z =
   trans (ap (S.ring.mul u) (sym a.2))
    (trans (S.ring.mulA u v a.1) (trans (ap (\ b -> S.ring.mul b a.1) orthogonal) (L.zero-mul a.1))) ;
  right-kills (a : Left.F.Carrier) : Id S.ring.R (S.ring.mul v a.1) S.ring.z =
   trans (ap (S.ring.mul v) (sym a.2))
    (trans (S.ring.mulA v u a.1)
     (trans (ap (\ b -> S.ring.mul b a.1) (trans (S.ring.mulC v u) orthogonal)) (L.zero-mul a.1))) ;
  backward (a : Product.Carrier) : Parent.F.Carrier =
   (S.ring.add a.1.1 a.2.1,trans (S.ring.dist e a.1.1 a.2.1)
    (cong2 S.ring.R S.ring.add _ _ _ _ (LB.fixed a.1) (RB.fixed a.2))) ;
  forward-backward (a : Product.Carrier) : Id Product.Carrier (forward.1.1 (backward a)) a =
   Product.eq _ _
    (Left.F.eq _ _ (trans (S.ring.dist u a.1.1 a.2.1)
     (trans (cong2 S.ring.R S.ring.add _ _ _ _ a.1.2 (left-kills a.2)) (S.ring.addZ a.1.1))))
    (Right.F.eq _ _ (trans (S.ring.dist v a.1.1 a.2.1)
     (trans (cong2 S.ring.R S.ring.add _ _ _ _ (right-kills a.1) a.2.2) (L.zl a.2.1)))) ;
  backward-forward (a : Parent.F.Carrier) : Id Parent.F.Carrier (backward (forward.1.1 a)) a =
   Parent.F.eq _ _ (trans (sym (L.dist-left u v a.1)) (trans (ap (\ b -> S.ring.mul b a.1) total) a.2)) ;
  isomorphism : Iso.Iso[Parent.algebra,Product.algebra] =
   Iso.Inverse[Parent.algebra,Product.algebra,forward,backward,forward-backward,backward-forward].theorem ;
 } ;
} ;
