-- An actual separable monogenic presentation. Both directions are
-- algebra maps and both inverse equations are part of the certificate.
-- Separability is the explicit inverse of f' in k[T]/(f), where f is
-- monic. No irreducibility or factorisation oracle is requested.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ;
 module Monic = MonicBasisUniversal[l].Over[k,setk] ;
 quotient (lower : List k.R) : C.Algebra = Monic.At[lower].Q ;
 derivative (lower : List k.R) : (quotient lower).ring.R =
  MonicDualValues[l].Over[k,(quotient lower).ring,(quotient lower).set,(quotient lower).iota,Monic.At[lower].x].slope lower ;
 record At (S : C.Algebra) {
  lower : List k.R ;
  forward : C.Hom (quotient lower) S ;
  backward : C.Hom S (quotient lower) ;
  forward-backward (a : S.ring.R) : Id S.ring.R (forward.1.1 (backward.1.1 a)) a ;
  backward-forward (a : (quotient lower).ring.R) : Id (quotient lower).ring.R (backward.1.1 (forward.1.1 a)) a ;
  separable : RL[(quotient lower).ring].unit (derivative lower) ;
 } ;
 module Given (S : C.Algebra) (p : At[S]) {
  equivalence : Pr.Equiv (quotient p.lower).ring.R S.ring.R =
   (p.forward.1.1,Pr.qinv (quotient p.lower).ring.R S.ring.R p.forward.1.1 p.backward.1.1 p.forward-backward p.backward-forward) ;
 } ;
} ;
