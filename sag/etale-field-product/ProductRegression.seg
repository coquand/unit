-- Regressions for the full product theorem: F2 from the original
-- hypotheses; the constructed standard algebra X^2-X; the large branch
-- with its actual separator; and the small branch on F2^m, including
-- m=3 (which cannot be globally monogenic) and m=0 (the zero algebra).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Fun = Axioms[l].FunExtLemmas[fe @l] ; module H = RingHom[l] ;
module B = BooleanRing[l] ; module R = SeparatorRegression[l] ;
module St = SelectedFactorStatement[l].Over[R.k,B.bool-set] ;
field : St.Field = new St.Field[R.dec,R.nontrivial] ;
module General = UnramifiedFieldProduct[l].Over[R.k,B.bool-set,field] ;
module BaseTest = General.At[R.C.base,R.BaseP.finitely-presented,R.unique] ;
base : BaseTest.Result = BaseTest.theorem ;
module Large (epsilon : R.Actual.Diag.Witness) {
 module Apply = LargeFieldMonogenic[l].Over[R.k,B.bool-set,field,R.C.base,R.Actual.T.T,R.Actual.T.coproduct,
  R.one,R.base-basis,epsilon,SelectedCompleteRegression[l].reduced] ;
 theorem : Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]].carrier = Apply.Given[R.candidates,R.distinct].theorem ;
} ;
large : Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]].carrier =
 TC.rec R.Actual.Diag.Witness @l (Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]].carrier)
  Tr.Trunc[MonogenicPresentation[l].Over[R.k,B.bool-set].At[R.C.base]].proposition (\ e -> Large[e].theorem) R.Actual.theorem ;
module Q = FieldRegularRegression[l] ;
module Quadratic (rq : Q.Reps.Representation Q.q) (rg : Q.Reps.Representation Q.Pt.g) {
 module A = Q.Test[rq,rg] ; module Apply = General.At[A.S,A.fp,A.etale.1.2] ;
 theorem : Apply.Result = Apply.theorem ;
} ;
QuadraticResult : U l = (rq : Q.Reps.Representation Q.q) * (rg : Q.Reps.Representation Q.Pt.g) * Quadratic[rq,rg].Apply.Result ;
quadratic : Tr.Trunc[QuadraticResult].carrier = TC.map2 (Q.Reps.Representation Q.q) (Q.Reps.Representation Q.Pt.g) QuadraticResult
 (\ rq rg -> (rq,rg,Quadratic[rq,rg].theorem)) (Q.Reps.representation Q.q) (Q.Reps.representation Q.Pt.g) ;
module Functions (m : Nat) {
 Carrier : U l = Fin m -> R.k.R ;
 ext (a b : Carrier) (h : (i : Fin m) -> Id R.k.R (a i) (b i)) : Id Carrier a b = Fun.funext (Fin m) (\ i -> R.k.R) a b h ;
 ring : CRing = mkCRing Carrier (\ i -> R.k.z) (\ i -> R.k.o)
  (\ a b i -> R.k.add (a i) (b i)) (\ a b i -> R.k.mul (a i) (b i)) (\ a i -> R.k.neg (a i))
  (\ a b c -> ext _ _ (\ i -> R.k.addA (a i) (b i) (c i)))
  (\ a b -> ext _ _ (\ i -> R.k.addC (a i) (b i)))
  (\ a -> ext _ _ (\ i -> R.k.addZ (a i))) (\ a -> ext _ _ (\ i -> R.k.addN (a i)))
  (\ a b c -> ext _ _ (\ i -> R.k.mulA (a i) (b i) (c i)))
  (\ a b -> ext _ _ (\ i -> R.k.mulC (a i) (b i)))
  (\ a -> ext _ _ (\ i -> R.k.mulO (a i)))
  (\ a b c -> ext _ _ (\ i -> R.k.dist (a i) (b i) (c i))) ;
 set : Pr.isSet Carrier = Fun.isSet-Pi (Fin m) (\ i -> R.k.R) (\ i -> B.bool-set) ;
 iota : H.Hom R.k ring = (\ a i -> a,refl (\ i -> R.k.o),\ a b -> refl (\ i -> R.k.add a b),\ a b -> refl (\ i -> R.k.mul a b)) ;
 algebra : R.C.Algebra = R.C.mkAlgebra ring set iota ;
 module Delta = MnSums[l].Over[R.k] ; module SS = FiniteIdeal[l].Sums[ring] ; module KS = FiniteIdeal[l].Sums[R.k] ;
 module TB = TraceBasis[l].Over[R.k,B.bool-set,algebra] ;
 sum-value : (n : Nat) (v : Fin n -> Carrier) (i : Fin m) -> Id R.k.R (SS.sum n v i) (KS.sum n (\ j -> v j i)) = split {
  zero -> \ v i -> refl R.k.z ;
  suc n | ih -> \ v i -> ap (R.k.add (v (inr tt) i)) (ih (\ j -> v (inl j)) i) } ;
 vector (j i : Fin m) : R.k.R = Delta.delta m i j ;
 reconstruction (a : Carrier) : Id Carrier (SS.sum m (\ j -> ring.mul (iota.1 (a j)) (vector j))) a = ext _ _
  (\ i -> trans (sum-value m (\ j -> ring.mul (iota.1 (a j)) (vector j)) i)
   (trans (KS.sum-cong m (\ j -> R.k.mul (a j) (Delta.delta m i j))
    (\ j -> R.k.mul (a j) (Delta.delta m j i)) (\ j -> ap (R.k.mul (a j)) (Delta.delta-sym m i j)))
    (Delta.sum-delta-right m i a))) ;
 basis : TB.Basis[m] = new TB.Basis[m,vector,\ a i -> a i,\ a b i -> refl (R.k.add (a i) (b i)),
  \ r a i -> refl (R.k.mul r (a i)),reconstruction,\ j i -> refl (Delta.delta m i j)] ;
 module Trace = TB.At[m,basis] ;
 trace (a : Carrier) : Id R.k.R (Trace.trace a) (KS.sum m a) = KS.sum-cong m
  (\ i -> R.k.mul (a i) (Delta.delta m i i)) a (\ i -> trans (ap (R.k.mul (a i)) (Delta.delta-diag m i)) (R.k.mulO (a i))) ;
 pairing (a : Carrier) (j : Fin m) : Id R.k.R (Trace.trace (ring.mul a (vector j))) (a j) =
  trans (trace (ring.mul a (vector j))) (Delta.sum-delta-right m j a) ;
 nondegenerate (a : Carrier) (h : (b : Carrier) -> Id R.k.R (Trace.trace (ring.mul a b)) R.k.z) : Id Carrier a ring.z =
  ext _ _ (\ j -> trans (sym (pairing a j)) (h (vector j))) ;
 reduced (a : Carrier) (h : Id Carrier (ring.mul a a) ring.z) : Id Carrier a ring.z =
  ext _ _ (\ i -> trans (sym (B.and-self (a i))) (ap (\ b -> b i) h)) ;
 coefficients (i : Fin zero) : R.k.R = efq i ;
 module Coefficients = FiniteCoefficientField[l].Over[R.k,B.bool-set,R.dec,R.nontrivial,zero,coefficients] ;
 covers : (a : R.k.R) -> (i : Fin R.two) * Id R.k.R (R.candidates i) a = split {
  false -> (inl (inr tt),refl false) ; true -> (inr tt,refl true) } ;
 subfield : Coefficients.Subfield = new Coefficients.Subfield[R.k,B.bool-set,H.identity R.k,\ a b h -> h,R.dec,R.nontrivial,
  R.two,R.candidates,R.distinct,covers,coefficients,\ i -> efq i] ;
 module Apply = SmallFieldProduct[l].Over[R.k,B.bool-set,field,algebra,m,basis,reduced,nondegenerate,zero,coefficients,subfield] ;
 lower (i : Fin m) : List R.k.R = cons false (cons true nil) ;
 boolean-root : (a : R.k.R) -> Id R.k.R (R.k.add false (R.k.mul a (R.k.add true (R.k.mul a true)))) false = split {
  false -> refl false ; true -> refl false } ;
 roots : IteratedMonicBasis[l].Over[R.k,B.bool-set].Roots m lower Apply.Input.restricted vector =
  \ i -> ext _ _ (\ j -> boolean-root (vector i j)) ;
 theorem : Tr.Trunc[ProductPresentation[l].Over[R.k,B.bool-set].At[algebra]].carrier = Apply.Given[lower,roots].theorem ;
} ;
three : Nat = suc (suc (suc zero)) ;
three-factors : Tr.Trunc[ProductPresentation[l].Over[R.k,B.bool-set].At[Functions[three].algebra]].carrier = Functions[three].theorem ;
zero-factors : Tr.Trunc[ProductPresentation[l].Over[R.k,B.bool-set].At[Functions[zero].algebra]].carrier = Functions[zero].theorem ;
