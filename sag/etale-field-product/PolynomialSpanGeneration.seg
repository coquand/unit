-- Polynomial representatives of a finite spanning family give an
-- actual polynomial representative of every element: use its supplied
-- coordinates and sum the corresponding scalar multiples in k[T].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra) (x : S.ring.R)
 (n : Nat) (v : Fin n -> S.ring.R) (coordinate : S.ring.R -> Fin n -> k.R)
 (reconstruction : (a : S.ring.R) -> Id S.ring.R
  (FiniteIdeal[l].Sums[S.ring].sum n (\ i -> S.ring.mul (S.iota.1 (coordinate a i)) (v i))) a)
 (representative : Fin n -> PolynomialRing[l].Extension[k,setk].Carrier)
 (equation : (i : Fin n) -> Id S.ring.R
  (Universal[l].Property[k,S.ring,setk,S.set].Given[S.iota,x].extend.1 (representative i)) (v i)) {
 module P = PolynomialRing[l].Extension[k,setk] ; module UP = Universal[l].Property[k,S.ring,setk,S.set].Given[S.iota,x] ;
 module PS = FiniteIdeal[l].Sums[P.ring] ; module SS = FiniteIdeal[l].Sums[S.ring] ;
 map-sum : (m : Nat) (a : Fin m -> P.Carrier) -> Id S.ring.R (UP.extend.1 (PS.sum m a)) (SS.sum m (\ i -> UP.extend.1 (a i))) = split {
  zero -> \ a -> H.zero P.ring S.ring UP.extend ;
  suc m | ih -> \ a -> trans (UP.extend.2.2.1 (a (inr tt)) (PS.sum m (\ i -> a (inl i))))
   (ap (S.ring.add (UP.extend.1 (a (inr tt)))) (ih (\ i -> a (inl i)))) } ;
 polynomial (a : S.ring.R) : P.Carrier = PS.sum n (\ i -> P.mulQ (P.constant (coordinate a i)) (representative i)) ;
 value (a : S.ring.R) : Id S.ring.R (UP.extend.1 (polynomial a)) a =
  trans (map-sum n (\ i -> P.mulQ (P.constant (coordinate a i)) (representative i)))
   (trans (SS.sum-cong n
    (\ i -> UP.extend.1 (P.mulQ (P.constant (coordinate a i)) (representative i)))
    (\ i -> S.ring.mul (S.iota.1 (coordinate a i)) (v i))
    (\ i -> trans (UP.extend.2.2.2 (P.constant (coordinate a i)) (representative i))
     (cong2 S.ring.R S.ring.mul _ _ _ _ (UP.on-constants (coordinate a i)) (equation i)))) (reconstruction a)) ;
 theorem (a : S.ring.R) : Tr.Trunc[(p : P.Carrier) * Id S.ring.R (UP.extend.1 p) a].carrier =
  Tr.Trunc[(p : P.Carrier) * Id S.ring.R (UP.extend.1 p) a].inc (polynomial a,value a) ;
} ;
