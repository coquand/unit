-- Normalizing a unit coordinate of the Gaussian quotient gives a
-- functional killing the span and taking the target to 1. The functional
-- and this construction require no decision or nonzero hypothesis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Data (k : CRing) {
 module V = GaussianVectors[l].Over[k] ; module L = RL[k] ;
 module G = GaussianQuotient[l].Operations[k] ;
 module At (n m : Nat) (v : Fin m -> V.Vec n) (x : V.Vec n) {
  record Functional {
   map : V.Vec n -> k.R ;
   add (a b : V.Vec n) : Id k.R (map (V.addV n a b)) (k.add (map a) (map b)) ;
   scale (r : k.R) (a : V.Vec n) : Id k.R (map (V.scaleV n r a)) (k.mul r (map a)) ;
   kills (i : Fin m) : Id k.R (map (v i)) k.z ;
   target : Id k.R (map x) k.o ;
  } ;
  module On (f : Functional) {
   at-zero : Id k.R (f.map (V.zeroV n)) k.z =
    trans (ap f.map (V.ext n (V.zeroV n) (V.scaleV n k.z x) (\ i -> sym (L.zero-mul (x i)))))
     (trans (f.scale k.z x) (L.zero-mul (f.map x))) ;
   linear : V.Linear[n,suc zero] = new V.Linear[n,suc zero,\ a i -> f.map a,
    \ i -> at-zero,\ a b i -> f.add a b,\ r a i -> f.scale r a] ;
   kills-span (a : V.Vec n) (w : V.Span[n,m,v].Witness a) : Id k.R (f.map a) k.z =
    trans (ap f.map (sym (V.ext n (V.comb n m v w.1) a w.2)))
     (trans (V.On[n,suc zero,linear].combination m v w.1 (inr tt))
      (trans (V.S.sum-cong m (\ j -> k.mul (f.map (v j)) (w.1 j)) (\ j -> k.z)
       (\ j -> trans (ap (\ b -> k.mul b (w.1 j)) (f.kills j)) (L.zero-mul (w.1 j)))) (V.S.sum-zero m))) ;
   overlap (w : V.Span[n,m,v].Witness x) : Id k.R k.o k.z = trans (sym f.target) (kills-span x w) ;
  } ;
  module Given (q : G.NormalForm[n,m,v]) {
  module Pivot (p : Fin q.rank) (w : k.R)
   (inverse : Id k.R (k.mul (q.project.map x p) w) k.o) {
   map (a : V.Vec n) : k.R = k.mul w (q.project.map a p) ;
   add (a b : V.Vec n) : Id k.R (map (V.addV n a b)) (k.add (map a) (map b)) =
    trans (ap (k.mul w) (q.project.add a b p))
     (k.dist w (q.project.map a p) (q.project.map b p)) ;
   scale (r : k.R) (a : V.Vec n) : Id k.R (map (V.scaleV n r a)) (k.mul r (map a)) =
    trans (ap (k.mul w) (q.project.scale r a p))
     (L.mul-swap w r (q.project.map a p)) ;
   kills (i : Fin m) : Id k.R (map (v i)) k.z =
    trans (ap (k.mul w) (q.kills i p)) (L.mul-zero w) ;
   target : Id k.R (map x) k.o = trans (k.mulC w (q.project.map x p)) inverse ;
   theorem : Functional = new Functional[map,add,scale,kills,target] ;
  } ;
  } ;
 } ;
 module Algebra (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
  (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (m : Nat)
  (v : Fin m -> S.ring.R) (x : S.ring.R)
  (f : At[n,m,\ i -> basis.coordinate (v i),basis.coordinate x].Functional) {
  module C = Algebras[l].Over[k,setk] ; module TL = TraceLinear[l].Over[k,setk] ;
  map (a : S.ring.R) : k.R = f.map (basis.coordinate a) ;
  add (a b : S.ring.R) : Id k.R (map (S.ring.add a b)) (k.add (map a) (map b)) =
   trans (ap f.map (V.ext n (basis.coordinate (S.ring.add a b))
    (V.addV n (basis.coordinate a) (basis.coordinate b)) (basis.add a b)))
    (f.add (basis.coordinate a) (basis.coordinate b)) ;
  scale (r : k.R) (a : S.ring.R) : Id k.R (map (S.ring.mul (S.iota.1 r) a)) (k.mul r (map a)) =
   trans (ap f.map (V.ext n (basis.coordinate (S.ring.mul (S.iota.1 r) a))
    (V.scaleV n r (basis.coordinate a)) (basis.scale r a)))
    (f.scale r (basis.coordinate a)) ;
  linear : TL.Linear[S,C.base] = new TL.Linear[S,C.base,map,add,scale] ;
  kills (i : Fin m) : Id k.R (map (v i)) k.z = f.kills i ;
  target : Id k.R (map x) k.o = f.target ;
 } ;

} ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field) {
 module V = GaussianVectors[l].Over[k] ; module L = RL[k] ;
 module FM = FieldLinearMembership[l].Over[k,setk,field] ;
 module Field = FieldFlat[l].Over[k] ; module FieldDec = Field.Given[field.decide] ;
 module At (n m : Nat) (v : Fin m -> V.Vec n) (x : V.Vec n)
  (outside : Not (V.Span[n,m,v].Witness x)) {
  module Membership = FM.At[n,m,v] ;
  module D = Data[k].At[n,m,v,x] ;
  choose : Field.Cases Membership.q.rank (Membership.q.project.map x) -> D.Functional = split {
   inl zero -> efq (outside (Membership.Kernel.from-zero x zero)) ;
   inr p -> D.Given[Membership.q].Pivot[p.1,p.2.1,p.2.2].theorem } ;
  theorem : D.Functional = choose (FieldDec.cases Membership.q.rank (Membership.q.project.map x)) ;
 } ;
} ;
