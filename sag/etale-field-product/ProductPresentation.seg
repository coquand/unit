-- A finite, parenthesised product of separable monic quotients.
-- The shape is an ordinary finite binary tree. Its interpretation is
-- the actual product algebra, and the certificate includes both algebra
-- maps and both inverse equations. A zero algebra is represented by the
-- monic quotient by 1; zero factors may occur in the finite splitting.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module M = MonogenicPresentation[l].Over[k,setk] ;
 module Iso = AlgebraIsomorphism[l].Over[k,setk] ;
 data Shape : U l = single (lower : List k.R) | pair (left right : Shape) ;
 algebra : Shape -> C.Algebra = split {
  single lower -> M.quotient lower ; pair left right | a b -> Iso.Product[a,b].algebra } ;
 Separable : Shape -> U l = split {
  single lower -> RL[(M.quotient lower).ring].unit (M.derivative lower) ;
  pair left right | a b -> a * b } ;
 record At (S : C.Algebra) {
  shape : Shape ; separable : Separable shape ; isomorphism : Iso.Iso[algebra shape,S] ;
 } ;
 monogenic (S : C.Algebra) (p : M.At[S]) : At[S] =
  new At[S,single p.lower,p.separable,new Iso.Iso[M.quotient p.lower,S,p.forward,p.backward,p.forward-backward,p.backward-forward]] ;
 product (S T : C.Algebra) (p : At[S]) (q : At[T]) : At[Iso.Product[S,T].algebra] =
  new At[Iso.Product[S,T].algebra,pair p.shape q.shape,(p.separable,q.separable),
   Iso.product (algebra p.shape) (algebra q.shape) S T p.isomorphism q.isomorphism] ;
 transport (S T : C.Algebra) (h : Iso.Iso[S,T]) (p : At[S]) : At[T] =
  new At[T,p.shape,p.separable,Iso.compose (algebra p.shape) S T h p.isomorphism] ;
} ;
