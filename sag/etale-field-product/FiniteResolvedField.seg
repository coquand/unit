-- If every member of an enumeration is zero or invertible on e, the
-- fixed-point ring eA has a zero-or-unit operation. Decidable equality
-- and finite enumeration pass to that ring; deduplication supplies an
-- injective enumeration. The nonzero assertion is kept separate, so a
-- zero branch can be handled without pretending it is a field.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (equal : (a b : A.R) -> Plus (Id A.R a b) (Not (Id A.R a b)))
 (n : Nat) (enumerate : Fin n -> A.R)
 (cover : (a : A.R) -> (i : Fin n) * Id A.R (enumerate i) a)
 (e : A.R) (he : Id A.R (A.mul e e) e)
 (resolved : (i : Fin n) -> FiniteRegularRefinement[l].Over[A,setA].Resolved e (enumerate i)) {
 module F = IdempotentFactor[l].Over[A,setA,e,he] ; module R = FiniteRegularRefinement[l].Over[A,setA] ; module L = RL[A] ;
 resolve (a : A.R) : R.Resolved e a = subst (R.Resolved e) (cover a).2 (resolved (cover a).1) ;
 choose (a : F.Carrier) : R.Resolved e a.1 -> Plus (Id F.Carrier a F.zero) (RL[F.ring].unit a) = split {
  inl h -> inl (F.eq _ _ (trans (sym a.2) h)) ;
  inr w -> inr (F.project w.1,F.eq _ _ (trans (L.mul-swap a.1 e w.1) w.2)) } ;
 field (a : F.Carrier) : Plus (Id F.Carrier a F.zero) (RL[F.ring].unit a) = choose a (resolve a.1) ;
 nonzero (h : Not (Id A.R e A.z)) : Not (Id F.Carrier F.one F.zero) = \ q -> h (ap (\ a -> a.1) q) ;
 equal-case (a b : F.Carrier) : Plus (Id A.R a.1 b.1) (Not (Id A.R a.1 b.1)) ->
  Plus (Id F.Carrier a b) (Not (Id F.Carrier a b)) = split {
   inl h -> inl (F.eq a b h) ; inr h -> inr (\ p -> h (ap (\ a -> a.1) p)) } ;
 equality (a b : F.Carrier) : Plus (Id F.Carrier a b) (Not (Id F.Carrier a b)) = equal-case a b (equal a.1 b.1) ;
 mere-cover (a : A.R) : Tr.Trunc[(i : Fin n) * Id A.R (enumerate i) a].carrier =
  Tr.Trunc[(i : Fin n) * Id A.R (enumerate i) a].inc (cover a) ;
 module Enumeration = F.Enumerated[n,enumerate,mere-cover] ;
 module Distinct = FiniteDedup[l].Over[F.Carrier,F.set,equality].Onto[n,Enumeration.enumeration,Enumeration.cover] ;
 size : Nat = Distinct.result.size ;
 values : Fin size -> F.Carrier = Distinct.result.vector ;
 injective (i j : Fin size) (h : Id F.Carrier (values i) (values j)) : Id (Fin size) i j = Distinct.result.injective i j h ;
 onto (a : F.Carrier) : Tr.Trunc[(i : Fin size) * Id F.Carrier (values i) a].carrier =
  Tr.Trunc[(i : Fin size) * Id F.Carrier (values i) a].inc (Distinct.cover a) ;
} ;
