-- Full product theorem from the original hypotheses. Over a discrete
-- nonzero field, a finitely presented formally unramified algebra is
-- merely isomorphic to a finite product of separable monic quotients.
-- Construct finite span, basis, reducedness, trace duality and tensor
-- diagonal using the checked field structure theorems, and instantiate
-- FiniteEtaleProduct. There is no prime parameter, factorisation oracle,
-- given basis, given primitive element, or ZMT dependency in the theorem.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ; module DC = DiagonalCertificate[l].Over[k,setk] ;
 module Target = ProductPresentation[l].Over[k,setk] ;
 module At (S : C.Algebra) (fp : P.FP S) (unique : FE.Unique S) {
  module Structure = UnramifiedFieldStructure[l].Over[k,setk,field.decide,field.nonzero].At[S,fp,unique] ;
  module Regular = UnramifiedFieldRegular[l].Over[k,setk,field.decide].At[S,fp,unique] ;
  module Reg = PrincipalRegularity[l].Over[S.ring] ;
  square-witness (a : S.ring.R) (h : Id S.ring.R (S.ring.mul a a) S.ring.z) (w : Reg.Witness a) : Id S.ring.R a S.ring.z =
   trans w.2 (trans (ap (\ b -> S.ring.mul b w.1) h) (RL[S.ring].zero-mul w.1)) ;
  reduced (a : S.ring.R) (h : Id S.ring.R (S.ring.mul a a) S.ring.z) : Id S.ring.R a S.ring.z =
   TC.rec (Reg.Witness a) @l (Id S.ring.R a S.ring.z) (S.set _ _) (square-witness a h) (Regular.regular a) ;
  Result : U l = Tr.Trunc[Target.At[S]].carrier ;
  module Given (s : Structure.Structure) {
   module Trace = TraceDuality[l].Over[k,setk,S,s.dimension,s.coordinates].Given[s.duality] ;
   nondegenerate (a : S.ring.R) (h : (b : S.ring.R) ->
    Id k.R (TraceBasis[l].Over[k,setk,S].At[s.dimension,s.coordinates].trace (S.ring.mul a b)) k.z) : Id S.ring.R a S.ring.z =
     Trace.nondegenerate a (\ j -> h (s.coordinates.vector j)) ;
   from-diagonal (d : DC.Result S) : Result =
    FiniteEtaleProduct[l].Over[k,setk,field,S,s.dimension,s.coordinates,reduced,nondegenerate,d.1,d.2.1,d.2.2].theorem ;
   theorem : Result = Truncation[l+].Trunc[DC.Result S].induction @l (\ d -> Result)
    (\ d -> Tr.Trunc[Target.At[S]].proposition) from-diagonal (DC.exists S fp unique) ;
  } ;
  theorem : Result = TC.rec Structure.Structure @l Result Tr.Trunc[Target.At[S]].proposition (\ s -> Given[s].theorem) Structure.theorem ;
 } ;
} ;
