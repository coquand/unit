-- Evaluate the divided difference in the two tensor factors. The
-- separator Delta(x)*w=1-epsilon implies H=epsilon*right(f'(x)) for
-- every monic annihilator f. The synthetic quotient is also constructed
-- explicitly as a monic polynomial in the left variable, with right
-- coefficients. Its degree is exactly one below the degree of f.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D) (x : S.ring.R) {
 module DK = DiagonalKernel[l].Over[k,setk].At[S,D,cp] ;
 module L = RL[D.ring] ; module Raw = Poly[l].PolyR[k] ;
 module DD = MonicDividedDifference[l].Over[k,D.ring,D.set,D.iota,DK.left.1.1 x,DK.right.1.1 x] ;
 module V = MonicBasisUniversal[l].Values[k,S.ring,S.iota,x] ;
 module LeftValue = MonicValueNaturality[l].Over[k,setk].Map[S,D,DK.left,x] ;
 module RightValue = MonicValueNaturality[l].Over[k,setk].Map[S,D,DK.right,x] ;
 module Derivative = MonicDualValues[l].Over[k,S.ring,S.set,S.iota,x] ;
 module RightDerivative = MonicDualValues[l].Natural[k,setk,S,D,DK.right,x] ;
 quotient : List k.R -> List S.ring.R = split {
  nil -> nil ; cons a cs | ih -> cons (V.value (cons a cs)) ih } ;
 quotient-length : (cs : List k.R) ->
  Id Nat (Poly[l].PolyR[S.ring].plen (quotient cs)) (Raw.plen cs) = split {
   nil -> refl zero ; cons a cs | ih -> ap (\ d -> suc d) ih } ;
 module QuotientValue = MonicBasisUniversal[l].Values[S.ring,D.ring,DK.right.1,DK.left.1.1 x] ;
 quotient-value : (cs : List k.R) (a : k.R) ->
  Id D.ring.R (QuotientValue.value (quotient cs)) (DD.value (cons a cs)) = split {
   nil -> \ a -> sym (trans (ap (D.ring.add D.ring.o) (L.mul-zero (DK.left.1.1 x))) (D.ring.addZ D.ring.o)) ;
   cons b cs | ih -> \ a -> cong2 D.ring.R D.ring.add _ _ _ _
    (RightValue.value (cons b cs)) (ap (D.ring.mul (DK.left.1.1 x)) (ih b)) } ;
 module Separator (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
  (w : D.ring.R) (inverse : Id D.ring.R (D.ring.mul (DK.difference x) w)
   (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon))) {
  module OnDiagonal = DD.Diagonal[epsilon.epsilon,epsilon.equalises x] ;
  module At (cs : List k.R) (root : Id S.ring.R (V.value cs) S.ring.z) {
   left-root : Id D.ring.R (DD.X.value cs) D.ring.z =
    trans (sym (LeftValue.value cs)) (trans (ap DK.left.1.1 root) (H.zero S.ring D.ring DK.left.1)) ;
   right-root : Id D.ring.R (DD.Y.value cs) D.ring.z =
    trans (sym (RightValue.value cs)) (trans (ap DK.right.1.1 root) (H.zero S.ring D.ring DK.right.1)) ;
   killed : Id D.ring.R (D.ring.mul (DK.difference x) (DD.value cs)) D.ring.z = DD.roots cs left-root right-root ;
   complement-killed : Id D.ring.R
    (D.ring.mul (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)) (DD.value cs)) D.ring.z =
    trans (ap (\ a -> D.ring.mul a (DD.value cs)) (sym inverse))
     (trans (sym (D.ring.mulA (DK.difference x) w (DD.value cs)))
      (trans (L.mul-swap (DK.difference x) w (DD.value cs))
       (trans (ap (D.ring.mul w) killed) (L.mul-zero w)))) ;
   fixed : Id D.ring.R (DD.value cs) (D.ring.mul epsilon.epsilon (DD.value cs)) =
    FormallyEtale[l].Units[D.ring,D.set].sub-zero (DD.value cs) (D.ring.mul epsilon.epsilon (DD.value cs))
     (trans (sym (trans (L.dist-left D.ring.o (D.ring.neg epsilon.epsilon) (DD.value cs))
      (cong2 D.ring.R D.ring.add _ _ _ _ (L.one-left (DD.value cs)) (L.neg-mul-left epsilon.epsilon (DD.value cs)))))
      complement-killed) ;
   theorem : Id D.ring.R (DD.value cs) (D.ring.mul epsilon.epsilon (DK.right.1.1 (Derivative.slope cs))) =
    trans fixed (trans (OnDiagonal.theorem cs) (ap (D.ring.mul epsilon.epsilon) (sym (RightDerivative.slope cs)))) ;
  } ;
 } ;
} ;
