-- The large branch now gives one global separable monogenic factor.
-- The existing finite scalar search constructs the separator; the new
-- separator theorem turns it into an actual algebra isomorphism.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S D : Algebras[l].Over[k,setk].Algebra)
 (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness)
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z) {
 module Search = DiagonalSeparator[l].Over[k,setk,field.decide,field.nonzero].At[S,D,cp,n,basis,epsilon] ;
 module Given (candidates : Fin Search.count -> k.R)
  (distinct : (i j : Fin Search.count) -> Id k.R (candidates i) (candidates j) -> Id (Fin Search.count) i j) {
  separator : Search.Data = Search.theorem candidates distinct ;
  theorem : Tr.Trunc[MonogenicPresentation[l].Over[k,setk].At[S]].carrier =
   SeparatorMonogenic[l].Over[k,setk,field,S,n,basis,reduced,D,cp,epsilon,
    separator.element,separator.inverse,separator.equation].theorem ;
 } ;
} ;
