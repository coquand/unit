-- Product certificates glue across complementary idempotent pieces.
-- All certificates are consumed inside truncation. Proof irrelevance
-- identifies different proofs of the same idempotence equation once,
-- at this boundary; the product isomorphism is constructed separately.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra) {
 module C = Algebras[l].Over[k,setk] ; module Iso = AlgebraIsomorphism[l].Over[k,setk] ;
 module Target = ProductPresentation[l].Over[k,setk] ; module PI = PrimeIdempotents[l].Over[S.ring] ;
 Square (e : S.ring.R) : U l = Id S.ring.R (S.ring.mul e e) e ;
 algebra (e : S.ring.R) (he : Square e) : C.Algebra = TraceRetraction[l].Idempotent[k,setk,S,e,he].algebra ;
 Result (e : S.ring.R) (he : Square e) : U l = Tr.Trunc[Target.At[algebra e he]].carrier ;
 change (e : S.ring.R) (he hf : Square e) (r : Result e he) : Result e hf =
  subst (Result e) (S.set (S.ring.mul e e) e he hf) r ;
 module Split (e f : S.ring.R) (he : Square e) (hf : Square f) {
  module Parts = IdempotentProductIsomorphism[l].Over[k,setk,S].Split[e,f,he,hf] ;
  assemble (left : Target.At[Parts.Left.algebra]) (right : Target.At[Parts.Right.algebra]) : Target.At[Parts.Parent.algebra] =
   Target.transport Parts.Product.algebra Parts.Parent.algebra
    (Iso.reverse Parts.Parent.algebra Parts.Product.algebra Parts.isomorphism)
    (Target.product Parts.Left.algebra Parts.Right.algebra left right) ;
  theorem (left : Result Parts.u Parts.hu) (right : Result Parts.v Parts.hv) : Result e he =
   TC.map2 (Target.At[Parts.Left.algebra]) (Target.At[Parts.Right.algebra]) (Target.At[Parts.Parent.algebra]) assemble left right ;
 } ;
 glue (e f : S.ring.R) (he : Square e) (hf : Square f)
  (left : Result (S.ring.mul e f) (PI.product-idempotent e f he hf))
  (right : Result (S.ring.mul e (PI.complement f))
   (PI.product-idempotent e (PI.complement f) he (PI.complement-idempotent f hf))) : Result e he = Split[e,f,he,hf].theorem left right ;
 module Whole {
  module R = TraceRetraction[l].Idempotent[k,setk,S,S.ring.o,S.ring.mulO S.ring.o] ;
  module Map = Iso.Inverse[S,R.algebra,R.projection,\ a -> a.1,R.F.project-fixed,RL[S.ring].one-left] ;
  theorem (r : Result S.ring.o (S.ring.mulO S.ring.o)) : Tr.Trunc[Target.At[S]].carrier =
   TC.map (Target.At[R.algebra]) (Target.At[S])
    (Target.transport R.algebra S (Iso.reverse S R.algebra Map.theorem)) r ;
 } ;
} ;
