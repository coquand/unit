-- Assemble both branches for a finite reduced algebra with a basis,
-- nondegenerate trace and an actual diagonal certificate. A finite list
-- of coefficients is constructed from monic equations of the basis
-- vectors. The proved bounded-closure dichotomy either supplies enough
-- distinct scalars for one global primitive element, or an actual finite
-- coefficient field for the full idempotent product construction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (D : Algebras[l].Over[k,setk].Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
 (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness) {
 module Target = ProductPresentation[l].Over[k,setk] ; module Mono = MonogenicPresentation[l].Over[k,setk] ;
 module Monic = FiniteMonicCoefficientFamily[l].Over[k,setk,S,n,basis] ;
 module Large = LargeFieldMonogenic[l].Over[k,setk,field,S,D,cp,n,basis,epsilon,reduced] ;
 Result : U l = Tr.Trunc[Target.At[S]].carrier ;
 module Given (m : Monic.Data) {
  module Coefficients = FiniteCoefficientField[l].Over[k,setk,field.decide,field.nonzero,m.count,m.coefficient] ;
  large (many : Coefficients.Closure.Distinct Large.Search.count) : Result =
   TC.map (Mono.At[S]) (Target.At[S]) (Target.monogenic S) (Large.Given[many.1,many.2].theorem) ;
  module Small (K0 : Coefficients.Subfield) {
   module Lift = Monic.Given[m].Lift[K0.ring,K0.set,K0.inclusion,K0.coefficient,K0.coefficient-image] ;
   theorem : Result = SmallFieldProduct[l].Over[k,setk,field,S,n,basis,reduced,nondegenerate,
    m.count,m.coefficient,K0].Given[Lift.lower,Lift.roots].theorem ;
  } ;
  cases : Coefficients.Result Large.Search.degree -> Result = split {
   inl many -> large many ; inr K0 -> Small[K0].theorem } ;
  theorem : Result = cases (Coefficients.theorem Large.Search.degree) ;
 } ;
 theorem : Result = TC.rec Monic.Data @l Result Tr.Trunc[Target.At[S]].proposition (\ m -> Given[m].theorem) Monic.theorem ;
} ;
