-- Pass a finite basis, reducedness and trace nondegeneracy to eS. The
-- projected ambient basis is a spanning family, with the ambient
-- coordinates of each fixed point. Polynomial representatives of that
-- family therefore suffice to produce a separable monogenic presentation
-- of eS. The zero piece is handled by its explicit equation 1=0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat)
 (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
 (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) ->
  Id k.R (TraceBasis[l].Over[k,setk,S].At[n,basis].trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
 (e : S.ring.R) (he : Id S.ring.R (S.ring.mul e e) e) {
 module R = TraceRetraction[l].Idempotent[k,setk,S,e,he] ; module F = R.F ;
 module B = IdempotentFieldBasis[l].Over[k,setk,field.decide,S,n,basis,e,he] ;
 module Trace = R.Bases[n,B.rank,basis,B.basis].Theorem ;
 module SS = FiniteIdeal[l].Sums[S.ring] ; module FS = FiniteIdeal[l].Sums[F.ring] ;
 module Pol = PolynomialRing[l].Extension[k,setk] ;
 factor-reduced (a : F.Carrier) (h : Id F.Carrier (F.mul a a) F.zero) : Id F.Carrier a F.zero =
  F.eq a F.zero (reduced a.1 (ap (\ b -> b.1) h)) ;
 projection-sum : (m : Nat) (v : Fin m -> S.ring.R) ->
  Id F.Carrier (F.project (SS.sum m v)) (FS.sum m (\ i -> F.project (v i))) = split {
   zero -> \ v -> H.zero S.ring F.ring F.projection ;
   suc m | ih -> \ v -> trans (F.project-add (v (inr tt)) (SS.sum m (\ i -> v (inl i))))
    (ap (F.add (F.project (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 vector (i : Fin n) : F.Carrier = F.project (basis.vector i) ;
 reconstruction (a : F.Carrier) : Id F.Carrier
  (FS.sum n (\ i -> F.mul (R.iota.1 (basis.coordinate a.1 i)) (vector i))) a =
   trans (FS.sum-cong n
    (\ i -> F.mul (R.iota.1 (basis.coordinate a.1 i)) (vector i))
    (\ i -> F.project (S.ring.mul (S.iota.1 (basis.coordinate a.1 i)) (basis.vector i)))
    (\ i -> sym (F.project-mul (S.iota.1 (basis.coordinate a.1 i)) (basis.vector i))))
    (trans (sym (projection-sum n (\ i -> S.ring.mul (S.iota.1 (basis.coordinate a.1 i)) (basis.vector i))))
     (trans (ap F.project (basis.reconstruction a.1)) (F.project-fixed a))) ;
 module Lists (x : F.Carrier) (representative : Fin n -> List k.R)
  (equation : (i : Fin n) -> Id F.Carrier
   (MonicReduce[l].Horner[k,F.ring,R.iota,x].horner (representative i)) (vector i)) {
  module Powers = PowerSpan[l].Over[k,setk,field,R.algebra,B.rank,B.basis,x] ;
  module Generation = PolynomialSpanGeneration[l].Over[k,setk,R.algebra,x,n,vector,\ a -> basis.coordinate a.1,
   reconstruction,\ i -> Pol.include (representative i),\ i -> trans (Powers.horner-value (representative i)) (equation i)] ;
  theorem : Tr.Trunc[MonogenicPresentation[l].Over[k,setk].At[R.algebra]].carrier =
   GeneratedSeparableMonogenic[l].Over[k,setk,field,R.algebra,B.rank,B.basis,factor-reduced,
    Trace.nondegenerate nondegenerate,x,Generation.theorem].theorem ;
 } ;
 module Zero (zero : Id S.ring.R e S.ring.z) {
  all-zero (a : F.Carrier) : Id F.Carrier a F.zero = F.eq a F.zero
   (trans (sym a.2) (trans (ap (\ b -> S.ring.mul b a.1) zero) (RL[S.ring].zero-mul a.1))) ;
  equation (i : Fin n) : Id F.Carrier (MonicReduce[l].Horner[k,F.ring,R.iota,F.zero].horner nil) (vector i) = sym (all-zero (vector i)) ;
  theorem : Tr.Trunc[MonogenicPresentation[l].Over[k,setk].At[R.algebra]].carrier = Lists[F.zero,\ i -> nil,equation].theorem ;
 } ;
} ;
