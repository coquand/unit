-- zmt2-revised.tex, Section 2: "What happens if E is etale".
-- Data (A is the note's R): a surjection u : S -> T of A-algebras (every
-- t merely has a preimage), S standard for (Q, G) with point s
-- (StandardEtale), every x in S merely of the form P(s)/g^n with
-- g = (G Q')(s) (Full: true of (A[X]/(Q))[1/g] by construction), and
-- generators k_1, .., k_r of I = ker u (every x in I is merely
-- sum_j k_j c_j).  In the note I is finitely
-- generated because S and T are finitely presented; here the generators
-- are an input.  T is formally etale; only Lift T is used.
-- Theorem (local).  T is standard etale: for some F, T is standard for
-- (Q, G F).  (A mere existence: F comes from certificates of I = I^2,
-- which are found under a truncation.)
-- Informal proof.
--  0. (Surjection) a map h : S -> B with h(I) = 0 factors as h' u:
--     h'(t) is the b with h(x) = b for every preimage x of t (unique, as
--     h(I) = 0; it exists, as t merely has a preimage); two maps T -> B
--     agreeing after u are equal.
--  1. S is unramified (StandardEtale.unramified).
--  2. (Square) C = S/I^2, with I^2 the x = sum_j k_j b_j, every b_j in I
--     (an ideal: the product of two elements of I is in I^2 by the
--     generators).  N = the image of I in C, square-zero.  C/N is T: the
--     map v : T -> C/N is the factorisation of S -> C -> C/N, which kills
--     I.  Lift T gives sigma : T -> C with pi sigma = v.  The projection
--     p : S -> C and sigma u agree after pi, so p = sigma u by 1, and for
--     i in I, p(i) = sigma(u(i)) = 0: i is in I^2.  In particular
--     k_i = sum_j k_j a_ji with every a_ji in I.
--  3. (IdempotentIdeal) f = det(I - a) is idempotent, 1 - f in I and
--     I = (1 - f).
--  4. (Localised) write f g^n = F(s).  For h : S -> B, h(f) is a unit
--     iff F(h s) is (g is a unit); if h(f) is a unit then h(f) = 1
--     (idempotent), so h kills 1 - f, hence I.  The point of T is
--     u(s), with F(u s) a unit since u(f) = 1.  A point q of (Q, G F) in
--     B is a point of (Q, G) with F(q) a unit (StandardEtale.Localise),
--     so q = h(s) for a unique h : S -> B; h(f) is a unit, h kills I and
--     factors through u.  This inverts h |-> h(u s).
--  5. Hence T is standard for (Q, G F): S[1/f] = T, the note's
--     "principal localisation of a standard etale algebra".
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module FE = FormallyEtale[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
-- finite choice over Fin n
top-case (P : Top -> U l) (t : P tt) : (x : Top) -> P x = split { tt -> t } ;
combine (n : Nat) (P : Ps.Fin (suc n) -> U l) (g : (i : Ps.Fin n) -> P (inl i)) (t : P (inr tt)) :
 (i : Ps.Fin (suc n)) -> P i = split { inl i -> g i ; inr x -> top-case (\ y -> P (inr y)) t x } ;
choice : (n : Nat) (P : Ps.Fin n -> U l) -> ((i : Ps.Fin n) -> Tr.Trunc[P i].carrier) ->
 Tr.Trunc[(i : Ps.Fin n) -> P i].carrier = split {
 zero -> \ P h -> Tr.Trunc[(i : Ps.Fin zero) -> P i].inc (\ i -> absurd (P i) i) ;
 suc n | r -> \ P h -> TC.map2 ((i : Ps.Fin n) -> P (inl i)) (P (inr tt)) ((i : Ps.Fin (suc n)) -> P i)
  (combine n P) (r (\ i -> P (inl i)) (\ i -> h (inl i))) (h (inr tt)) } ;

module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module E = FE.Over[A,setA] ;
 module SE = StandardEtale[l].Over[A,setA] ;
 module RX = SE.RX ;
 -- every x in S is P(s)/g^n, g = (G Q')(s)
 module Fractions (Q G : RX.Carrier) (S : C.Algebra) (s : SE.Points[Q,G].Point S) {
  module X = SE.At[S.ring,S.set,S.iota,s.1] ;
  g : S.ring.R = X.value SE.Points[Q,G].g ;
  Fraction (x : S.ring.R) : U l = (P : RX.Carrier) * (n : Nat) *
   Id S.ring.R (S.ring.mul x (AffinePowers[l].Over[S.ring].power g n)) (X.value P) ;
  Full : U l = (x : S.ring.R) -> Tr.Trunc[Fraction x].carrier ;
 } ;

 ---------------------------------------------------------------------
 -- 0. maps out of the target of a surjection

 module Surjection (S T : C.Algebra) (u : C.Hom S T)
  (surj : (t : T.ring.R) -> Tr.Trunc[(x : S.ring.R) * Id T.ring.R (u.1.1 x) t].carrier) {
  Preimage (t : T.ring.R) : U l = (x : S.ring.R) * Id T.ring.R (u.1.1 x) t ;
  Kernel (x : S.ring.R) : U l = Id T.ring.R (u.1.1 x) T.ring.z ;
  k-zero : Kernel S.ring.z = H.zero S.ring T.ring u.1 ;
  k-add (x y : S.ring.R) (hx : Kernel x) (hy : Kernel y) : Kernel (S.ring.add x y) =
   trans (u.1.2.2.1 x y) (trans (Ps.cong2 T.ring.R T.ring.add _ _ _ _ hx hy) (T.ring.addZ T.ring.z)) ;
  k-mul (c x : S.ring.R) (hx : Kernel x) : Kernel (S.ring.mul c x) =
   trans (u.1.2.2.2 c x) (trans (ap (T.ring.mul (u.1.1 c)) hx) (RL[T.ring].mul-zero (u.1.1 c))) ;
  k-mul-left (x c : S.ring.R) (hx : Kernel x) : Kernel (S.ring.mul x c) =
   trans (u.1.2.2.2 x c) (trans (ap (\ t -> T.ring.mul t (u.1.1 c)) hx) (RL[T.ring].zero-mul (u.1.1 c))) ;
  -- I = ker u
  ideal : RegularIdeal[l].IdealPred[S.ring] = RegularIdeal[l].mkIdealPred S.ring Kernel k-zero k-add k-mul ;
  -- u x = u y gives u (x - y) = 0
  difference (x y : S.ring.R) (e : Id T.ring.R (u.1.1 x) (u.1.1 y)) : Kernel (S.ring.add x (S.ring.neg y)) =
   trans (u.1.2.2.1 x (S.ring.neg y))
    (trans (ap (T.ring.add (u.1.1 x)) (H.negation S.ring T.ring u.1 y))
     (trans (ap (\ t -> T.ring.add t (T.ring.neg (u.1.1 y))) e) (T.ring.addN (u.1.1 y)))) ;
  module Factor (B : C.Algebra) (h : C.Hom S B) (kills : (x : S.ring.R) -> Kernel x -> Id B.ring.R (h.1.1 x) B.ring.z) {
   respects (x y : S.ring.R) (e : Id T.ring.R (u.1.1 x) (u.1.1 y)) : Id B.ring.R (h.1.1 x) (h.1.1 y) =
    FE.Units[B.ring,B.set].sub-zero (h.1.1 x) (h.1.1 y)
     (trans (sym (trans (h.1.2.2.1 x (S.ring.neg y)) (ap (B.ring.add (h.1.1 x)) (H.negation S.ring B.ring h.1 y))))
      (kills (S.ring.add x (S.ring.neg y)) (difference x y e))) ;
   -- b is the value at t: h(x) = b for every preimage x of t
   Value (t : T.ring.R) (b : B.ring.R) : U l = (p : Preimage t) -> Id B.ring.R (h.1.1 p.1) b ;
   Values (t : T.ring.R) : U l = (b : B.ring.R) * Value t b ;
   value-prop (t : T.ring.R) (b : B.ring.R) : Pr.isProp (Value t b) =
    FL.isProp-Pi (Preimage t) (\ p -> Id B.ring.R (h.1.1 p.1) b) (\ p -> B.set (h.1.1 p.1) b) ;
   values-prop (t : T.ring.R) : Pr.isProp (Values t) = \ a a' ->
    Pr.Sigma-eq B.ring.R (Value t) a.1 a'.1 a.2 a'.2
     (Tr.Trunc[Preimage t].induction @l (\ w -> Id B.ring.R a.1 a'.1) (\ w -> B.set a.1 a'.1)
       (\ p -> trans (sym (a.2 p)) (a'.2 p)) (surj t))
     (value-prop t a'.1) ;
   values (t : T.ring.R) : Values t =
    Tr.Trunc[Preimage t].induction @l (\ w -> Values t) (\ w -> values-prop t)
     (\ p -> (h.1.1 p.1,\ p' -> respects p'.1 p.1 (trans p'.2 (sym p.2)))) (surj t) ;
   map (t : T.ring.R) : B.ring.R = (values t).1 ;
   -- the value at t is h(x) for a preimage x
   characterise (t : T.ring.R) (p : Preimage t) : Id B.ring.R (map t) (h.1.1 p.1) = sym ((values t).2 p) ;
   -- preimages of sums and products
   sum-pre (t t' : T.ring.R) (p : Preimage t) (p' : Preimage t') : Preimage (T.ring.add t t') =
    (S.ring.add p.1 p'.1,trans (u.1.2.2.1 p.1 p'.1) (Ps.cong2 T.ring.R T.ring.add _ _ _ _ p.2 p'.2)) ;
   mul-pre (t t' : T.ring.R) (p : Preimage t) (p' : Preimage t') : Preimage (T.ring.mul t t') =
    (S.ring.mul p.1 p'.1,trans (u.1.2.2.2 p.1 p'.1) (Ps.cong2 T.ring.R T.ring.mul _ _ _ _ p.2 p'.2)) ;
   -- an equation between values, proved at preimages of t and t'
   both (t t' : T.ring.R) (P : U l) (pP : Pr.isProp P) (f : Preimage t -> Preimage t' -> P) : P =
    Tr.Trunc[Preimage t].induction @l (\ w -> P) (\ w -> pP)
     (\ p -> Tr.Trunc[Preimage t'].induction @l (\ w -> P) (\ w -> pP) (\ p' -> f p p') (surj t')) (surj t) ;
   map-add (t t' : T.ring.R) : Id B.ring.R (map (T.ring.add t t')) (B.ring.add (map t) (map t')) =
    both t t' (Id B.ring.R (map (T.ring.add t t')) (B.ring.add (map t) (map t'))) (B.set _ _)
     (\ p p' -> trans (characterise (T.ring.add t t') (sum-pre t t' p p'))
       (trans (h.1.2.2.1 p.1 p'.1) (sym (Ps.cong2 B.ring.R B.ring.add _ _ _ _ (characterise t p) (characterise t' p'))))) ;
   map-mul (t t' : T.ring.R) : Id B.ring.R (map (T.ring.mul t t')) (B.ring.mul (map t) (map t')) =
    both t t' (Id B.ring.R (map (T.ring.mul t t')) (B.ring.mul (map t) (map t'))) (B.set _ _)
     (\ p p' -> trans (characterise (T.ring.mul t t') (mul-pre t t' p p'))
       (trans (h.1.2.2.2 p.1 p'.1) (sym (Ps.cong2 B.ring.R B.ring.mul _ _ _ _ (characterise t p) (characterise t' p'))))) ;
   hom : C.Hom T B =
    ((map,trans (characterise T.ring.o (S.ring.o,u.1.2.1)) h.1.2.1,map-add,map-mul),
     \ c -> trans (characterise (T.iota.1 c) (S.iota.1 c,u.2 c)) (h.2 c)) ;
   -- h' u = h
   beta (x : S.ring.R) : Id B.ring.R (hom.1.1 (u.1.1 x)) (h.1.1 x) = characterise (u.1.1 x) (x,refl (u.1.1 x)) ;
  } ;
  unique (B : C.Algebra) (h1 h2 : C.Hom T B)
   (e : (x : S.ring.R) -> Id B.ring.R (h1.1.1 (u.1.1 x)) (h2.1.1 (u.1.1 x))) : Id (C.Hom T B) h1 h2 =
   C.ext T B h1 h2 (\ t -> Tr.Trunc[Preimage t].induction @l (\ w -> Id B.ring.R (h1.1.1 t) (h2.1.1 t)) (\ w -> B.set _ _)
     (\ p -> trans (ap h1.1.1 (sym p.2)) (trans (e p.1) (ap h2.1.1 p.2))) (surj t)) ;
 } ;

 ---------------------------------------------------------------------
 -- the data of Section 2

 module Section2 (S T : C.Algebra) (u : C.Hom S T)
  (surj : (t : T.ring.R) -> Tr.Trunc[(x : S.ring.R) * Id T.ring.R (u.1.1 x) t].carrier)
  (r : Nat) (k : Ps.Fin r -> S.ring.R)
  (k-in : (j : Ps.Fin r) -> Id T.ring.R (u.1.1 (k j)) T.ring.z)
  (gen : (x : S.ring.R) -> Id T.ring.R (u.1.1 x) T.ring.z ->
   Tr.Trunc[(c : Ps.Fin r -> S.ring.R) * Id S.ring.R x (FiniteIdeal[l].Sums[S.ring].lin r k c)].carrier) {
  module Su = Surjection[S,T,u,surj] ;
  module SS = FiniteIdeal[l].Sums[S.ring] ;
  -- x is in I^2: x = sum_j k_j b_j with every b_j in I
  Certificate (x : S.ring.R) : U l =
   (b : Ps.Fin r -> S.ring.R) * ((j : Ps.Fin r) -> Su.Kernel (b j)) * Id S.ring.R x (SS.lin r k b) ;

  -------------------------------------------------------------------
  -- 2. I = I^2

  module Square (unramified : E.Unique S) (lift : E.Lift T) {
   InSquare (x : S.ring.R) : U l = Tr.Trunc[Certificate x].carrier ;
   sq-zero : Certificate S.ring.z = (\ j -> S.ring.z,\ j -> Su.k-zero,sym (SS.lin-zero r k)) ;
   sq-add (x y : S.ring.R) (p : Certificate x) (q : Certificate y) : Certificate (S.ring.add x y) =
    (\ j -> S.ring.add (p.1 j) (q.1 j),\ j -> Su.k-add (p.1 j) (q.1 j) (p.2.1 j) (q.2.1 j),
     trans (Ps.cong2 S.ring.R S.ring.add _ _ _ _ p.2.2 q.2.2) (sym (SS.lin-add r k p.1 q.1))) ;
   sq-mul (c x : S.ring.R) (p : Certificate x) : Certificate (S.ring.mul c x) =
    (\ j -> S.ring.mul c (p.1 j),\ j -> Su.k-mul c (p.1 j) (p.2.1 j),
     trans (ap (S.ring.mul c) p.2.2) (sym (SS.lin-scale r k p.1 c))) ;
   square : RegularIdeal[l].IdealPred[S.ring] =
    RegularIdeal[l].mkIdealPred S.ring InSquare (Tr.Trunc[Certificate S.ring.z].inc sq-zero)
     (\ x y hx hy -> TC.map2 (Certificate x) (Certificate y) (Certificate (S.ring.add x y)) (sq-add x y) hx hy)
     (\ c x hx -> TC.map (Certificate x) (Certificate (S.ring.mul c x)) (sq-mul c x) hx) ;
   -- the product of two elements of I is in I^2
   module Product (i j : S.ring.R) (hi : Su.Kernel i) (hj : Su.Kernel j) {
    certificate (c : Ps.Fin r -> S.ring.R) (hc : Id S.ring.R j (SS.lin r k c)) : Certificate (S.ring.mul i j) =
     (\ m -> S.ring.mul i (c m),\ m -> Su.k-mul-left i (c m) hi,
      trans (ap (S.ring.mul i) hc) (sym (SS.lin-scale r k c i))) ;
    in-square : InSquare (S.ring.mul i j) =
     TC.map ((c : Ps.Fin r -> S.ring.R) * Id S.ring.R j (SS.lin r k c)) (Certificate (S.ring.mul i j))
      (\ w -> certificate w.1 w.2) (gen j hj) ;
   } ;
   -- C = S/I^2 and the projection p
   module Q2 = QuotientRing[l].Over[S.ring,square,\ x -> Tr.Trunc[Certificate x].proposition] ;
   Cq : C.Algebra = C.mkAlgebra Q2.ring Q2.set (H.compose A S.ring Q2.ring Q2.projection S.iota) ;
   p : C.Hom S Cq = (Q2.projection,\ c -> refl (Q2.include (S.iota.1 c))) ;
   -- N = the image of I in C
   Image (x : Q2.Carrier) : U l = (i : S.ring.R) * Su.Kernel i * Id Q2.Carrier (Q2.include i) x ;
   InN (x : Q2.Carrier) : U l = Tr.Trunc[Image x].carrier ;
   n-zero : Image Q2.zeroQ = (S.ring.z,Su.k-zero,refl Q2.zeroQ) ;
   n-add (x y : Q2.Carrier) (a : Image x) (b : Image y) : Image (Q2.addQ x y) =
    (S.ring.add a.1 b.1,Su.k-add a.1 b.1 a.2.1 b.2.1,
     trans (sym (Q2.Add.beta a.1 b.1)) (Ps.cong2 Q2.Carrier Q2.addQ _ _ _ _ a.2.2 b.2.2)) ;
   n-mul-at (c : S.ring.R) (x : Q2.Carrier) (a : Image x) : Image (Q2.mulQ (Q2.include c) x) =
    (S.ring.mul c a.1,Su.k-mul c a.1 a.2.1,
     trans (sym (Q2.Multiply.beta c a.1)) (ap (Q2.mulQ (Q2.include c)) a.2.2)) ;
   n-mul (b x : Q2.Carrier) (hx : InN x) : InN (Q2.mulQ b x) =
    Q2.Q.induction @l (\ b' -> InN (Q2.mulQ b' x)) (\ b' -> Tr.Trunc[Image (Q2.mulQ b' x)].proposition)
     (\ c -> TC.map (Image x) (Image (Q2.mulQ (Q2.include c) x)) (n-mul-at c x) hx) b ;
   sq-image (x y : Q2.Carrier) (a : Image x) (b : Image y) : Id Q2.Carrier (Q2.mulQ x y) Q2.zeroQ =
    trans (Ps.cong2 Q2.Carrier Q2.mulQ _ _ _ _ (sym a.2.2) (sym b.2.2))
     (trans (Q2.Multiply.beta a.1 b.1)
      (Q2.to-zero (S.ring.mul a.1 b.1) Product[a.1,b.1,a.2.1,b.2.1].in-square)) ;
   N : E.SquareZero[Cq] =
    E.mkSquareZero Cq
     (RegularIdeal[l].mkIdealPred Q2.ring InN (Tr.Trunc[Image Q2.zeroQ].inc n-zero)
      (\ x y hx hy -> TC.map2 (Image x) (Image y) (Image (Q2.addQ x y)) (n-add x y) hx hy) n-mul)
     (\ x -> Tr.Trunc[Image x].proposition)
     (\ x y hx hy -> TC.rec (Image x) @l (Id Q2.Carrier (Q2.mulQ x y) Q2.zeroQ) (Q2.set _ _)
       (\ a -> TC.rec (Image y) @l (Id Q2.Carrier (Q2.mulQ x y) Q2.zeroQ) (Q2.set _ _) (\ b -> sq-image x y a b) hy) hx) ;
   -- v : T -> C/N, the factorisation of pi p
   module M = E.Mod[Cq,N] ;
   pp : C.Hom S M.algebra = E.reduce S Cq N p ;
   pp-kills (x : S.ring.R) (hx : Su.Kernel x) : Id M.Q.Carrier (pp.1.1 x) M.Q.zeroQ =
    trans (E.reduce-at S Cq N p x) (M.Q.to-zero (Q2.include x) (Tr.Trunc[Image (Q2.include x)].inc (x,hx,refl (Q2.include x)))) ;
   module V = Su.Factor[M.algebra,pp,pp-kills] ;
   -- the lift sigma : T -> C of v
   sigma : C.Hom T Cq = (lift Cq N V.hom).1 ;
   agree : Id (C.Hom S M.algebra) pp (E.reduce S Cq N (C.compose S T Cq sigma u)) =
    C.ext S M.algebra pp (E.reduce S Cq N (C.compose S T Cq sigma u))
     (\ x -> trans (sym (V.beta x)) (trans (ap (\ g -> g.1.1 (u.1.1 x)) (sym (lift Cq N V.hom).2))
       (trans (E.reduce-at T Cq N sigma (u.1.1 x)) (sym (E.reduce-at S Cq N (C.compose S T Cq sigma u) x))))) ;
   -- p = sigma u
   equal : Id (C.Hom S Cq) p (C.compose S T Cq sigma u) = unramified Cq N p (C.compose S T Cq sigma u) agree ;
   in-square (x : S.ring.R) (hx : Su.Kernel x) : InSquare x =
    Q2.kernel x (trans (ap (\ g -> g.1.1 x) equal) (trans (ap sigma.1.1 hx) (H.zero T.ring Cq.ring sigma.1))) ;
   certificates : Tr.Trunc[(j : Ps.Fin r) -> Certificate (k j)].carrier =
    choice r (\ j -> Certificate (k j)) (\ j -> in-square (k j) (k-in j)) ;
  } ;

  -------------------------------------------------------------------
  -- 3-5. from certificates of I = I^2: T is standard for (Q, G F)

  -- 3. the idempotent f of the certificates
  module Idem (cert : (j : Ps.Fin r) -> Certificate (k j)) {
   module II = IdempotentIdeal[l].Over[S.ring,S.set,Su.ideal,r,k,gen,\ j i -> (cert i).1 j,\ j i -> (cert i).2.1 j,\ i -> (cert i).2.2] ;
  } ;
  module Localised (Q G : RX.Carrier) (st : SE.Points[Q,G].Standard S)
   (cert : (j : Ps.Fin r) -> Certificate (k j)) (ff : Fractions[Q,G,S,st.1].Fraction Idem[cert].II.f) {
   module II = Idem[cert].II ;
   f : S.ring.R = II.f ;
   module Pg = SE.Points[Q,G] ;
   module Fr = Fractions[Q,G,S,st.1] ;
   -- f g^n = F(s)
   F : RX.Carrier = ff.1 ;
   n : Nat = ff.2.1 ;
   gS : S.ring.R = Fr.g ;
   f-eq : Id S.ring.R (S.ring.mul f (AffinePowers[l].Over[S.ring].power gS n)) (Fr.X.value F) = ff.2.2 ;
   module Pgf = SE.Points[Q,RX.ring.mul G F] ;
   -- h(f) for h : S -> B
   module Values (B : C.Algebra) (h : C.Hom S B) {
    module L = RL[B.ring] ; module Un = FE.Units[B.ring,B.set] ;
    module Nh = SE.Natural[S.ring,B.ring,S.set,B.set,S.iota,B.iota,h.1,h.2,st.1.1] ;
    module PB = AffinePowers[l].Over[B.ring] ;
    hg : B.ring.R = h.1.1 gS ;
    power-unit (x : B.ring.R) (v : L.unit x) : (m : Nat) -> L.unit (PB.power x m) = split {
     zero -> Un.unit-one ; suc m | ih -> Un.unit-mul x (PB.power x m) v ih } ;
    -- h(f) h(g)^n = F(h s)
    image : Id B.ring.R (B.ring.mul (h.1.1 f) (PB.power hg n)) (Nh.Y.value F) =
     calc B.ring.R { B.ring.mul (h.1.1 f) (PB.power hg n)
       =< ap (B.ring.mul (h.1.1 f)) (sym (AffinePowers[l].power-map S.ring B.ring h.1 gS n))
        > B.ring.mul (h.1.1 f) (h.1.1 (AffinePowers[l].Over[S.ring].power gS n))
       =< sym (h.1.2.2.2 f (AffinePowers[l].Over[S.ring].power gS n)) > h.1.1 (S.ring.mul f (AffinePowers[l].Over[S.ring].power gS n))
       =< ap h.1.1 f-eq > h.1.1 (Fr.X.value F)
       =< Nh.value F > Nh.Y.value F } ;
    g-unit : L.unit hg = FE.unit-map S.ring B.ring h.1 gS st.1.2.2 ;
    F-unit (hf : L.unit (h.1.1 f)) : L.unit (Nh.Y.value F) =
     subst L.unit image (Un.unit-mul (h.1.1 f) (PB.power hg n) hf (power-unit hg g-unit n)) ;
    f-unit (hF : L.unit (Nh.Y.value F)) : L.unit (h.1.1 f) =
     Un.unit-left (h.1.1 f) (PB.power hg n) (subst L.unit (sym image) hF) ;
    -- if h(f) is a unit then h(f) = 1 and h kills I = (1 - f)
    module Kills (hf : L.unit (h.1.1 f)) {
     one : Id B.ring.R (h.1.1 f) B.ring.o =
      Un.idempotent-one (h.1.1 f) (trans (sym (h.1.2.2.2 f f)) (ap h.1.1 II.idempotent)) hf ;
     one-minus : Id B.ring.R (h.1.1 (S.ring.add S.ring.o (S.ring.neg f))) B.ring.z =
      trans (h.1.2.2.1 S.ring.o (S.ring.neg f))
       (trans (Ps.cong2 B.ring.R B.ring.add _ _ _ _ h.1.2.1 (trans (H.negation S.ring B.ring h.1 f) (ap B.ring.neg one)))
        (B.ring.addN B.ring.o)) ;
     kills (x : S.ring.R) (hx : Su.Kernel x) : Id B.ring.R (h.1.1 x) B.ring.z =
      calc B.ring.R { h.1.1 x =< ap h.1.1 (sym (II.generated x hx)) > h.1.1 (S.ring.mul (S.ring.add S.ring.o (S.ring.neg f)) x)
        =< h.1.2.2.2 (S.ring.add S.ring.o (S.ring.neg f)) x > B.ring.mul (h.1.1 (S.ring.add S.ring.o (S.ring.neg f))) (h.1.1 x)
        =< ap (\ t -> B.ring.mul t (h.1.1 x)) one-minus > B.ring.mul B.ring.z (h.1.1 x)
        =< L.zero-mul (h.1.1 x) > B.ring.z } ;
    } ;
   } ;
   -- u(f) = 1, since 1 - f is in I
   uf-one : Id T.ring.R (u.1.1 f) T.ring.o =
    sym (FE.Units[T.ring,T.set].sub-zero T.ring.o (u.1.1 f)
     (trans (sym (trans (u.1.2.2.1 S.ring.o (S.ring.neg f)) (Ps.cong2 T.ring.R T.ring.add _ _ _ _ u.1.2.1 (H.negation S.ring T.ring u.1 f))))
      II.one-minus)) ;
   -- the point u(s) of (Q, G F) in T
   t0 : Pgf.Point T =
    ((Pg.push S st.1 T u).1,
     SE.Localise[Q,G,F,T,(Pg.push S st.1 T u).1].from (Pg.push S st.1 T u).2
      (Values[T,u].F-unit (subst (RL[T.ring].unit) (sym uf-one) FE.Units[T.ring,T.set].unit-one))) ;
   canonical (B : C.Algebra) (h : C.Hom T B) : Pgf.Point B = Pgf.push T t0 B h ;
   -- a point q of (Q, G F) in B gives h : S -> B with h(s) = q, killing I
   module Backward (B : C.Algebra) (q : Pgf.Point B) {
    module Lq = SE.Localise[Q,G,F,B,q.1] ;
    q' : Pg.Point B = (q.1,Lq.to q.2) ;
    hq : C.Hom S B = (st.2 B).sec q' ;
    hq-s : Id B.ring.R (hq.1.1 st.1.1) q.1 = ap (\ p -> p.1) ((st.2 B).sec-eq q') ;
    hq-f : RL[B.ring].unit (hq.1.1 f) =
     Values[B,hq].f-unit (subst (\ b -> RL[B.ring].unit (SE.At[B.ring,B.set,B.iota,b].value F)) (sym hq-s) (Lq.to-unit q.2)) ;
    module Fa = Su.Factor[B,hq,Values[B,hq].Kills[hq-f].kills] ;
   } ;
   backward (B : C.Algebra) (q : Pgf.Point B) : C.Hom T B = Backward[B,q].Fa.hom ;
   fb (B : C.Algebra) (q : Pgf.Point B) : Id (Pgf.Point B) (canonical B (backward B q)) q =
    Pgf.point-ext B (canonical B (backward B q)) q (trans (Backward[B,q].Fa.beta st.1.1) Backward[B,q].hq-s) ;
   -- the h : S -> B of the point of h' : T -> B is h' u
   restricts (B : C.Algebra) (h : C.Hom T B) : Id (C.Hom S B) Backward[B,canonical B h].hq (C.compose S T B h u) =
    trans (ap (st.2 B).sec (Pg.point-ext B Backward[B,canonical B h].q' (Pg.push S st.1 B (C.compose S T B h u))
            (refl (h.1.1 (u.1.1 st.1.1)))))
     (Pr.sec-ret (C.Hom S B) (Pg.Point B) (Pg.push S st.1 B) (st.2 B) (C.compose S T B h u)) ;
   bf (B : C.Algebra) (h : C.Hom T B) : Id (C.Hom T B) (backward B (canonical B h)) h =
    Su.unique B (backward B (canonical B h)) h
     (\ x -> trans (Backward[B,canonical B h].Fa.beta x) (ap (\ g -> g.1.1 x) (restricts B h))) ;
   -- T is standard for (Q, G F)
   standard : Pgf.Standard T =
    (t0,\ B -> Pr.qinv (C.Hom T B) (Pgf.Point B) (canonical B) (backward B) (fb B) (bf B)) ;
  } ;

  -------------------------------------------------------------------
  -- Theorem local (the etale case)

  module Theorem (Q G : RX.Carrier) (st : SE.Points[Q,G].Standard S) (full : Fractions[Q,G,S,st.1].Full) (lift : E.Lift T) {
   module Sq = Square[SE.Points[Q,G].unramified S st,lift] ;
   Result : U l+ = (F : RX.Carrier) * SE.Points[Q,RX.ring.mul G F].Standard T ;
   from-fraction (cert : (j : Ps.Fin r) -> Certificate (k j)) (ff : Fractions[Q,G,S,st.1].Fraction Idem[cert].II.f) :
    Truncation[l+].Trunc[Result].carrier =
    Truncation[l+].Trunc[Result].inc (Localised[Q,G,st,cert,ff].F,Localised[Q,G,st,cert,ff].standard) ;
   local : Truncation[l+].Trunc[Result].carrier =
    Tr.Trunc[(j : Ps.Fin r) -> Certificate (k j)].induction @(l+) (\ c -> Truncation[l+].Trunc[Result].carrier)
     (\ c -> Truncation[l+].Trunc[Result].proposition)
     (\ cert -> Tr.Trunc[Fractions[Q,G,S,st.1].Fraction Idem[cert].II.f].induction @(l+) (\ c -> Truncation[l+].Trunc[Result].carrier)
       (\ c -> Truncation[l+].Trunc[Result].proposition) (from-fraction cert) (full Idem[cert].II.f))
     Sq.certificates ;
  } ;
 } ;
} ;
