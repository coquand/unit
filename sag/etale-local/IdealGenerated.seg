-- The ideal m B generated by m in an A-algebra B (the note's m E_g), by
-- certificates: x is in m B when x = sum_j iota(mu_j) t_j for a list of
-- generators (mu_j, t_j), mu_j in m, t_j in B.  The laws LoopInputs.Section1
-- asks of an ideal J are then immediate:
--   0 is the empty sum (in-zero);
--   x + x' is certified by the concatenation of the lists (lsum-append);
--   a x by multiplying each t_j by a, since iota(mu) (a t) = a (iota(mu) t)
--     (lsum-scale);
--   iota(a), a in m, by the one generator (a, 1) (in-m).
-- A list sum is the Fin-indexed sum of FiniteIdeal over the positions of
-- the list (lsum-sum), the form in which Section1 takes its certificate.
level l ; open Ring[l] ;
module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Lists (B : CRing) {
 open B ;
 module L = RL[B] ;
 module S = FiniteIdeal[l].Sums[B] ;
 append {X : U l} : List X -> List X -> List X = split {
  nil -> \ ys -> ys ; cons x xs | r -> \ ys -> cons x (r ys) } ;
 lmap {X : U l} (s : X -> X) : List X -> List X = split {
  nil -> nil ; cons x xs | r -> cons (s x) r } ;
 -- sum_j f(x_j)
 lsum {X : U l} (f : X -> R) : List X -> R = split {
  nil -> z ; cons x xs | r -> add (f x) r } ;
 lsum-append {X : U l} (f : X -> R) : (xs ys : List X) -> Id R (lsum f (append xs ys)) (add (lsum f xs) (lsum f ys)) = split {
  nil -> \ ys -> sym (L.zl (lsum f ys)) ;
  cons x xs | r -> \ ys -> trans (ap (add (f x)) (r ys)) (addA (f x) (lsum f xs) (lsum f ys)) } ;
 -- if s multiplies f by a, lmap s multiplies the sum by a
 lsum-scale {X : U l} (f : X -> R) (s : X -> X) (a : R) (hs : (x : X) -> Id R (f (s x)) (mul a (f x))) :
  (xs : List X) -> Id R (lsum f (lmap s xs)) (mul a (lsum f xs)) = split {
  nil -> sym (L.mul-zero a) ;
  cons x xs | r -> trans (Ps.cong2 R add _ _ _ _ (hs x) r) (sym (dist a (f x) (lsum f xs))) } ;
 -- the positions of a list
 at-cons {X : U l} (x : X) (n : Nat) (r : Ps.Fin n -> X) : Ps.Fin (suc n) -> X = split {
  inl j -> r j ; inr u -> x } ;
 at {X : U l} : (xs : List X) -> Ps.Fin (len xs) -> X = split {
  nil -> \ j -> efq j ; cons x xs | r -> at-cons x (len xs) r } ;
 lsum-sum {X : U l} (f : X -> R) : (xs : List X) -> Id R (lsum f xs) (S.sum (len xs) (\ j -> f (at xs j))) = split {
  nil -> refl z ; cons x xs | r -> ap (add (f x)) r } ;
} ;
module Over (A : CRing) (m : A.R -> U l) (B : CRing) (iota : H.Hom A B) {
 open B ;
 module L = RL[B] ;
 module Ls = Lists[B] ;
 -- a generator iota(mu) t of m B
 Gen : U l = (mu : A.R) * (hm : m mu) * R ;
 value (p : Gen) : R = mul (iota.1 p.1) p.2.2 ;
 InmB (x : R) : U l = (ps : List Gen) * Id R x (Ls.lsum value ps) ;
 in-zero : InmB z = (nil,refl z) ;
 in-add (x x' : R) (h : InmB x) (h' : InmB x') : InmB (add x x') =
  (Ls.append h.1 h'.1,trans (Ps.cong2 R add _ _ _ _ h.2 h'.2) (sym (Ls.lsum-append value h.1 h'.1))) ;
 scale (a : R) (p : Gen) : Gen = (p.1,p.2.1,mul a p.2.2) ;
 value-scale (a : R) (p : Gen) : Id R (value (scale a p)) (mul a (value p)) = L.mul-swap (iota.1 p.1) a p.2.2 ;
 in-scale (a x : R) (h : InmB x) : InmB (mul a x) =
  (Ls.lmap (scale a) h.1,trans (ap (mul a) h.2) (sym (Ls.lsum-scale value (scale a) a (value-scale a) h.1))) ;
 in-m (a : A.R) (ha : m a) : InmB (iota.1 a) =
  (cons (a,ha,o) nil,sym (trans (addZ (mul (iota.1 a) o)) (mulO (iota.1 a)))) ;
} ;
