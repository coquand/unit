-- Etale algebras (zmt2-revised.tex, Introduction): E is etale if it is
-- finitely presented and formally etale, that is, R-algebra maps into a
-- quotient by a square-zero ideal lift uniquely.  Unramified is the
-- uniqueness half.
-- A square-zero ideal N of an algebra B: an ideal with propositional
-- membership and a b = 0 for a, b in N.  B/N is QuotientRing (x ~ y iff
-- x - y in N) with its projection pi.
--   Lift E   : every g : E -> B/N is pi h for some h : E -> B;
--   Unique E : pi h = pi h' implies h = h';
--   Etale E  = (Lift E * Unique E) * a finite presentation of E.
-- Through a presentation P of E (Presentations.Presents), Hom E (B/N) is
-- the type of solutions of the equations of P modulo N, so this is the
-- usual definition in points form: a solution modulo a square-zero N
-- lifts uniquely to a solution in B.
-- Elementary facts on units used in Section 2:
--   being a unit is a proposition (the inverse is unique);
--   x y a unit iff x and y are units; a unit idempotent is 1;
--   unit-mod-nilpotent: if x v - 1 = e with e e = 0 then x is a unit,
--     an inverse being v (1 - e): with t = x v = 1 + e, t e = e, so
--     t (1 - e) = t - e = 1.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Units (B : CRing) (setB : Pr.isSet B.R) {
 open B ; open RL[B] ;
 unit-prop (x : R) : Pr.isProp (unit x) = \ u v ->
  Pr.Sigma-eq R (\ y -> Id R (mul x y) o) u.1 v.1 u.2 v.2
   (calc R { u.1 =< sym (mulO u.1) > mul u.1 o
      =< ap (mul u.1) (sym v.2) > mul u.1 (mul x v.1)
      =< mulA u.1 x v.1 > mul (mul u.1 x) v.1
      =< ap (\ t -> mul t v.1) (trans (mulC u.1 x) u.2) > mul o v.1
      =< one-left v.1 > v.1 })
   (setB (mul x v.1) o) ;
 unit-one : unit o = (o,mulO o) ;
 unit-mul (x y : R) (u : unit x) (v : unit y) : unit (mul x y) =
  (mul u.1 v.1,trans (mul-four x y u.1 v.1) (trans (Ps.cong2 R mul _ _ _ _ u.2 v.2) (mulO o))) ;
 unit-left (x y : R) (u : unit (mul x y)) : unit x = (mul y u.1,trans (mulA x y u.1) u.2) ;
 unit-right (x y : R) (u : unit (mul x y)) : unit y =
  (mul x u.1,trans (mul-swap y x u.1) (trans (mulA x y u.1) u.2)) ;
 -- a unit idempotent is 1
 idempotent-one (e : R) (h : Id R (mul e e) e) (u : unit e) : Id R e o =
  calc R { e =< sym (mulO e) > mul e o
    =< ap (mul e) (sym u.2) > mul e (mul e u.1)
    =< mulA e e u.1 > mul (mul e e) u.1
    =< ap (\ t -> mul t u.1) h > mul e u.1
    =< u.2 > o } ;
 -- a - b = 0 gives a = b
 sub-zero (a b : R) (h : Id R (add a (neg b)) z) : Id R a b =
  calc R { a =< sym (addZ a) > add a z
    =< ap (add a) (sym (neg-cancel b)) > add a (add (neg b) b)
    =< addA a (neg b) b > add (add a (neg b)) b
    =< ap (\ t -> add t b) h > add z b
    =< zl b > b } ;
 -- (t - 1) + 1 = t
 sub-add (t : R) : Id R (add (add t (neg o)) o) t =
  calc R { add (add t (neg o)) o =< sym (addA t (neg o) o) > add t (add (neg o) o)
    =< ap (add t) (neg-cancel o) > add t z
    =< addZ t > t } ;
 module Nilpotent (x v e : R) (he : Id R (add (mul x v) (neg o)) e) (sq : Id R (mul e e) z) {
  t : R = mul x v ;
  t-eq : Id R (add e o) t = trans (ap (\ s -> add s o) (sym he)) (sub-add t) ;
  -- t e = (e + 1) e = e e + e = e
  te : Id R (mul t e) e =
   calc R { mul t e =< ap (\ s -> mul s e) (sym t-eq) > mul (add e o) e
     =< dist-left e o e > add (mul e e) (mul o e)
     =< Ps.cong2 R add _ _ _ _ sq (one-left e) > add z e
     =< zl e > e } ;
  inverse : R = mul v (add o (neg e)) ;
  unit-x : unit x = (inverse,
   calc R { mul x (mul v (add o (neg e))) =< mulA x v (add o (neg e)) > mul t (add o (neg e))
     =< dist t o (neg e) > add (mul t o) (mul t (neg e))
     =< Ps.cong2 R add _ _ _ _ (mulO t) (trans (mul-neg t e) (ap neg te)) > add t (neg e)
     =< ap (\ s -> add t (neg s)) (sym he) > add t (neg (add t (neg o)))
     =< ap (add t) (negsub t o) > add t (add (neg t) o)
     =< addA t (neg t) o > add (add t (neg t)) o
     =< ap (\ s -> add s o) (addN t) > add z o
     =< zl o > o }) ;
 } ;
} ;
-- a ring map sends units to units
unit-map (A B : CRing) (h : H.Hom A B) (x : A.R) (u : RL[A].unit x) : RL[B].unit (h.1 x) =
 (h.1 u.1,trans (sym (h.2.2.2 x u.1)) (trans (ap h.1 u.2) h.2.1)) ;

module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 record SquareZero (B : C.Algebra) {
  ideal : RegularIdeal[l].IdealPred[B.ring] ;
  prop (x : B.ring.R) : Pr.isProp (ideal.In x) ;
  square (a b : B.ring.R) : ideal.In a -> ideal.In b -> Id B.ring.R (B.ring.mul a b) B.ring.z ;
 } ;
 -- B/N and the projection pi
 module Mod (B : C.Algebra) (N : SquareZero[B]) {
  module Q = QuotientRing[l].Over[B.ring,N.ideal,N.prop] ;
  algebra : C.Algebra = C.mkAlgebra Q.ring Q.set (H.compose R B.ring Q.ring Q.projection B.iota) ;
  projection : C.Hom B algebra = (Q.projection,\ r -> refl (Q.include (B.iota.1 r))) ;
 } ;
 -- pi h
 reduce (E B : C.Algebra) (N : SquareZero[B]) (h : C.Hom E B) : C.Hom E Mod[B,N].algebra =
  C.compose E B Mod[B,N].algebra Mod[B,N].projection h ;
 -- by definition, pi h x is the class of h x
 reduce-at (E B : C.Algebra) (N : SquareZero[B]) (h : C.Hom E B) (x : E.ring.R) :
  Id Mod[B,N].Q.Carrier ((reduce E B N h).1.1 x) (Mod[B,N].Q.include (h.1.1 x)) = refl (Mod[B,N].Q.include (h.1.1 x)) ;
 Lift (E : C.Algebra) : U l+ =
  (B : C.Algebra) (N : SquareZero[B]) (g : C.Hom E Mod[B,N].algebra) ->
  (h : C.Hom E B) * Id (C.Hom E Mod[B,N].algebra) (reduce E B N h) g ;
 Unique (E : C.Algebra) : U l+ =
  (B : C.Algebra) (N : SquareZero[B]) (h h' : C.Hom E B) ->
  Id (C.Hom E Mod[B,N].algebra) (reduce E B N h) (reduce E B N h') -> Id (C.Hom E B) h h' ;
 FormallyEtale (E : C.Algebra) : U l+ = Lift E * Unique E ;
 Etale (E : C.Algebra) : U l+ = FormallyEtale E * P.Witness E ;
 -- a unit modulo a square-zero ideal is a unit
 unit-mod-nilpotent (B : C.Algebra) (N : SquareZero[B]) (x v : B.ring.R)
  (h : N.ideal.In (B.ring.add (B.ring.mul x v) (B.ring.neg B.ring.o))) : RL[B.ring].unit x =
  Units[B.ring,B.set].Nilpotent[x,v,B.ring.add (B.ring.mul x v) (B.ring.neg B.ring.o),
   refl (B.ring.add (B.ring.mul x v) (B.ring.neg B.ring.o)),N.square _ _ h h].unit-x ;
} ;
