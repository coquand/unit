-- Section 1 of zmt2-revised.tex in E_g (item 4 of HANDOFF-LOOP).
-- B is the note's E_g: an A-algebra (A the note's local ring R) with y in B,
-- G with g = G(y) a unit in B, and every x in B of the form r(y)/g^k
-- (Full).  The loop runs in B, with J = m B (IdealGenerated).
-- Inputs, as in the note:
--   y b_i = sum_j b_j a_ji and 1 = sum_k c_k b_k (integrality: the
--     images of generators of the finite algebra; they need not generate B);
--   g a unit, Full;  H(y) in m B;  H'(y) a unit mod m B.
-- Outputs: Q(y) = 0, G^n H = U Q + [c]_e in A[X] (c_i in m), and Q'(y) a
-- unit mod m B.
-- Proof: the certificate (G^n H)(y) = sum_j iota(mu_j) R_j(y) is
-- ClearDenominators.Certificate.cert; G(y) is a unit mod m B because it is
-- a unit (unit-mod: g v - 1 = 0 is in every ideal); LoopInputs.Section1.
-- H(y) in m B and H'(y) a unit mod m B (the special fibre, from E/mE
-- finite etale) and Full (from Lemma 2 and ZMT) stay hypotheses.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (y : B.R) {
 open B ;
 module LI = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iota,y] ;
 module CD = ClearDenominators[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iota,y] ;
 module IG = IdealGenerated[l].Over[A,m,B,iota] ;
 module DS = DerivativeStep[l].Over[A,setA,m,B,setB,iota,y,IG.InmB,IG.in-zero,IG.in-add,IG.in-scale,IG.in-m] ;
 -- a unit is a unit modulo m B
 unit-mod (x : R) (u : RL[B].unit x) : DS.UnitMod x =
  (u.1,subst IG.InmB (sym (trans (ap (\ t -> add t (neg o)) u.2) (addN o))) IG.in-zero) ;
 module Section1
  -- integrality of y: y b = a b, 1 = sum c_k b_k
  (n' : Nat) (a : Determinant[l].Over[A,setA].Mat (suc n')) (bs : Ps.Fin (suc n') -> R)
  (eq : (i : Ps.Fin (suc n')) -> Id R (mul y (bs i)) (Determinant[l].Over[B,setB].act (suc n') (\ j i1 -> iota.1 (a j i1)) bs i))
  (c : Ps.Fin (suc n') -> R) (one : Id R (FiniteIdeal[l].Sums[B].lin (suc n') c bs) o)
  -- G and H as coefficient lists; B = R[y][1/G(y)]
  (g h : List A.R) (gu : RL[B].unit (LI.Hb.horner g)) (full : CD.Full g)
  -- special-fibre data
  (hH : IG.InmB (LI.Hb.horner h)) (hH' : DS.UnitMod (DS.der (LI.Ho.horner h))) {
  module CE = CD.Clear[g].With[full].Certificate[h,hH] ;
  module S1 = LI.Section1[IG.InmB,IG.in-zero,IG.in-add,IG.in-scale,IG.in-m,n',a,bs,eq,c,one,g,h,
   CE.n,CE.k,CE.mu,CE.mu-m,CE.Rs,CE.cert,hH,hH',unit-mod (LI.Hb.horner g) gu] ;
  -- the conclusions: Q(y) = 0, G^n H = U Q + [c]_e, Q'(y) a unit mod m B
  root : Id R (LI.pw S1.S1.e) (LI.MP.V S1.S1.e S1.S1.a) = S1.root ;
  divides : Id S1.LQ.RX.Carrier (S1.LQ.RX.ring.mul (AffinePowers[l].Over[S1.LQ.RX.ring].power (LI.Ho.horner g) CE.n) (LI.Ho.horner h))
   (S1.LQ.RX.ring.add (S1.LQ.RX.ring.mul S1.S1.r.2.2.2.1 S1.S1.Q) (S1.LQ.Lp.Px S1.S1.e S1.S1.r.2.2.2.2.1)) = S1.S1.divides ;
  q-prime : DS.UnitMod (DS.der S1.S1.Q) = S1.q-prime ;
 } ;
} ;
