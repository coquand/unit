-- A finitely generated idempotent ideal is generated by an idempotent
-- (zmt2-revised.tex, Section 2).
-- K an ideal of a ring S, generated by k_1, .., k_r (every x in K is
-- merely sum_i k_i c_i), with  k_i = sum_j k_j a_ji  and every a_ji in K (the
-- certificates of k_i in K^2).
-- Informal proof.  With M = I - a, M k = 0, so f = det M kills every k_i
-- (the determinant trick), hence f K = 0.  M = I mod K entrywise, so
-- f = det I = 1 mod K (ExteriorRelation with a ~ c iff a - c in K):
-- 1 - f is in K.  Then f (1 - f) = 0, i.e. f f = f, and every x in K is
-- (1 - f) x = x - f x = x, so K = (1 - f).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (Sg : CRing) (setS : Pr.isSet Sg.R) (K : RegularIdeal[l].IdealPred[Sg])
 (r : Nat) (k : Ps.Fin r -> Sg.R)
 (gen : (x : Sg.R) -> K.In x -> Truncation[l].Trunc[(c : Ps.Fin r -> Sg.R) * Id Sg.R x (FiniteIdeal[l].Sums[Sg].lin r k c)].carrier)
 (a : Ps.Fin r -> Ps.Fin r -> Sg.R) (a-in : (j i : Ps.Fin r) -> K.In (a j i))
 (eq : (i : Ps.Fin r) -> Id Sg.R (k i) (FiniteIdeal[l].Sums[Sg].lin r k (\ j -> a j i))) {
 open Sg ; module L = RL[Sg] ;
 module S = FiniteIdeal[l].Sums[Sg] ;
 module IL = RegularIdeal[l].IdealLaws[Sg,K] ;
 module D = MnSums[l].Over[Sg] ;
 module DT = Determinant[l].Over[Sg,setS] ;
 module DTR = DeterminantTrick[l].Over[Sg,setS] ;
 M (j i : Ps.Fin r) : R = add (D.delta r j i) (neg (a j i)) ;
 f : R = ExteriorModel[l].Over[Sg].det r M ;
 -- M k = 0
 kernel (i : Ps.Fin r) : Id R (DT.act r M k i) z =
  calc R { DT.act r M k i
    =< S.lin-add r k (\ j -> D.delta r j i) (\ j -> neg (a j i))
     > add (S.lin r k (\ j -> D.delta r j i)) (S.lin r k (\ j -> neg (a j i)))
    =< Ps.cong2 R add _ _ _ _ (D.sum-delta-right r i k) (S.lin-neg r k (\ j -> a j i))
     > add (k i) (neg (S.lin r k (\ j -> a j i)))
    =< ap (\ t -> add (k i) (neg t)) (sym (eq i)) > add (k i) (neg (k i))
    =< addN (k i) > z } ;
 f-kills (i : Ps.Fin r) : Id R (mul f (k i)) z = DTR.trick r M k kernel i ;
 -- f K = 0
 module Kills (x : R) (c : Ps.Fin r -> R) (hc : Id R x (S.lin r k c)) {
  zero : Id R (mul f x) z =
   calc R { mul f x =< ap (mul f) hc > mul f (S.lin r k c)
     =< sym (S.sum-scale f r (\ i -> mul (k i) (c i))) > S.sum r (\ i -> mul f (mul (k i) (c i)))
     =< S.sum-cong r (\ i -> mul f (mul (k i) (c i))) (\ i -> z)
         (\ i -> trans (mulA f (k i) (c i)) (trans (ap (\ t -> mul t (c i)) (f-kills i)) (L.zero-mul (c i))))
      > S.sum r (\ i -> z)
     =< S.sum-zero r > z } ;
 } ;
 -- f K = 0 (a proposition, so a mere representation suffices)
 f-kills-all (x : R) (hx : K.In x) : Id R (mul f x) z =
  Truncation[l].Trunc[(c : Ps.Fin r -> R) * Id R x (S.lin r k c)].induction @l (\ w -> Id R (mul f x) z) (\ w -> setS _ _)
   (\ w -> Kills[x,w.1,w.2].zero) (gen x hx) ;

 ---------------------------------------------------------------------
 -- f = 1 mod K

 Cong (n : Nat) (b c : R) : U l = K.In (add b (neg c)) ;
 c-zero (n : Nat) : Cong n z z = IL.in-eq z (add z (neg z)) (sym (addN z)) K.in-zero ;
 c-add (n : Nat) (b b' c c' : R) (h : Cong n b c) (h' : Cong n b' c') : Cong n (add b b') (add c c') =
  IL.in-eq _ _ (trans (L.swap b (neg c) b' (neg c')) (ap (add (add b b')) (sym (L.neg-add c c')))) (K.in-add _ _ h h') ;
 c-neg (n : Nat) (b c : R) (h : Cong n b c) : Cong n (neg b) (neg c) =
  IL.in-eq _ _ (trans (L.negsub b c) (ap (add (neg b)) (sym (L.neg-neg c)))) (IL.in-neg _ h) ;
 c-one : Cong zero o o = IL.in-eq z (add o (neg o)) (sym (addN o)) K.in-zero ;
 -- (p - u) + (u - w) = p - w
 telescope (p u w : R) : Id R (add (add p (neg u)) (add u (neg w))) (add p (neg w)) =
  trans (sym (addA p (neg u) (add u (neg w))))
   (ap (add p) (trans (addA (neg u) u (neg w)) (trans (ap (\ t -> add t (neg w)) (L.neg-cancel u)) (L.zl (neg w))))) ;
 c-mul (n : Nat) (b b' c c' : R) (h : Cong n b c) (h' : Cong (suc zero) b' c') : Cong (suc n) (mul b b') (mul c c') =
  IL.in-eq _ _ (trans (Ps.cong2 R add _ _ _ _
          (trans (dist b b' (neg c')) (ap (add (mul b b')) (L.mul-neg b c')))
          (trans (dist c' b (neg c)) (Ps.cong2 R add _ _ _ _ (mulC c' b) (trans (L.mul-neg c' c) (ap neg (mulC c' c))))))
         (telescope (mul b b') (mul b c') (mul c c')))
   (K.in-add _ _ (K.in-mul b _ h') (K.in-mul c' _ h)) ;
 module ER = ExteriorRelation[l].Over[Sg,Sg,Cong,c-zero,c-add,c-neg,c-one,c-mul] ;
 entry-cong (j i : Ps.Fin r) : Cong (suc zero) (M j i) (D.delta r j i) =
  IL.in-eq _ _ (sym (trans (ap (\ t -> add t (neg (D.delta r j i))) (addC (D.delta r j i) (neg (a j i))))
                (L.add-neg-cancel (neg (a j i)) (D.delta r j i))))
   (IL.in-neg _ (a-in j i)) ;
 det-cong : K.In (add f (neg o)) =
  IL.in-eq _ _ (ap (\ t -> add f (neg t)) (DT.det-id r)) (ER.det r M (\ j i -> D.delta r j i) entry-cong) ;
 -- 1 - f is in K
 one-minus : K.In (add o (neg f)) =
  IL.in-eq _ _ (trans (L.negsub f o) (addC (neg f) o)) (IL.in-neg _ det-cong) ;

 ---------------------------------------------------------------------
 -- f is idempotent and K = (1 - f)

 -- f (1 - f) = f - f f
 expand : Id R (mul f (add o (neg f))) (add f (neg (mul f f))) =
  trans (dist f o (neg f)) (Ps.cong2 R add _ _ _ _ (mulO f) (L.mul-neg f f)) ;
 idempotent : Id R (mul f f) f =
  sym (FormallyEtale[l].Units[Sg,setS].sub-zero f (mul f f) (trans (sym expand) (f-kills-all (add o (neg f)) one-minus))) ;
 generated (x : R) (hx : K.In x) : Id R (mul (add o (neg f)) x) x =
  calc R { mul (add o (neg f)) x =< L.dist-left o (neg f) x > add (mul o x) (mul (neg f) x)
    =< Ps.cong2 R add _ _ _ _ (L.one-left x) (trans (L.neg-mul-left f x) (trans (ap neg (f-kills-all x hx)) L.neg-zero))
     > add x z
    =< addZ x > x } ;
} ;
