-- Finite power sums  [c]_e = sum_(i<e) c_i t^i  in a commutative ring T
-- with an element t (HANDOFF-LOOP.md, file 1).  The coefficients are a
-- function c : Nat -> T; the top index e is added first, as in
-- FiniteIdeal.Sums.sum.  Informal content: [c]_e is additive and
-- R-linear in c, depends only on c_0 .. c_(e-1) ... (cong for all i),
-- t [c]_e = [shift c]_(e+1) with shift c 0 = 0, shift c (i+1) = c i, and
-- ring maps send [c]_e at t to [phi c]_e at phi t.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
-- coefficient functions: shift and the point coefficients 0, f, 0, ...
module Coef (T : CRing) {
 shift (c : Nat -> T.R) : Nat -> T.R = split { zero -> T.z ; suc i -> c i } ;
 point (f : T.R) : Nat -> T.R = split { zero -> f ; suc i -> T.z } ;
} ;
module Over (T : CRing) (t : T.R) {
 open T ;
 open Coef[T] ;
 module L = RL[T] ;
 module AP = AffinePowers[l].Over[T] ;
 Coefficients : U l = Nat -> R ;
 psum : Nat -> Coefficients -> R = split {
  zero -> \ c -> z ;
  suc e | r -> \ c -> add (mul (c e) (AP.power t e)) (r c) } ;

 psum-cong : (e : Nat) (c c' : Coefficients) -> ((i : Nat) -> Id R (c i) (c' i)) -> Id R (psum e c) (psum e c') = split {
  zero -> \ c c' h -> refl z ;
  suc e | r -> \ c c' h -> Ps.cong2 R add _ _ _ _ (ap (\ v -> mul v (AP.power t e)) (h e)) (r c c' h) } ;
 psum-zero : (e : Nat) -> Id R (psum e (\ i -> z)) z = split {
  zero -> refl z ;
  suc e | r -> trans (Ps.cong2 R add _ _ _ _ (L.zero-mul (AP.power t e)) r) (addZ z) } ;
 psum-add : (e : Nat) (c c' : Coefficients) -> Id R (psum e (\ i -> add (c i) (c' i))) (add (psum e c) (psum e c')) = split {
  zero -> \ c c' -> sym (addZ z) ;
  suc e | r -> \ c c' ->
   trans (Ps.cong2 R add _ _ _ _ (L.dist-left (c e) (c' e) (AP.power t e)) (r c c'))
    (L.swap (mul (c e) (AP.power t e)) (mul (c' e) (AP.power t e)) (psum e c) (psum e c')) } ;
 psum-scale (a : R) : (e : Nat) (c : Coefficients) -> Id R (psum e (\ i -> mul a (c i))) (mul a (psum e c)) = split {
  zero -> \ c -> sym (L.mul-zero a) ;
  suc e | r -> \ c ->
   trans (Ps.cong2 R add _ _ _ _ (sym (mulA a (c e) (AP.power t e))) (r c))
    (sym (dist a (mul (c e) (AP.power t e)) (psum e c))) } ;
 -- t [c]_e = [shift c]_(e+1)
 psum-shift : (e : Nat) (c : Coefficients) -> Id R (mul t (psum e c)) (psum (suc e) (shift c)) = split {
  zero -> \ c -> trans (L.mul-zero t) (sym (trans (ap (\ v -> add v z) (L.zero-mul o)) (addZ z))) ;
  suc e | r -> \ c ->
   trans (dist t (mul (c e) (AP.power t e)) (psum e c))
    (Ps.cong2 R add _ _ _ _ (L.mul-swap t (c e) (AP.power t e)) (r c)) } ;
 -- [point f]_e = f for e >= 1
 psum-point (f : R) : (e : Nat) -> Id R (psum (suc e) (point f)) f = split {
  zero -> trans (addZ (mul f o)) (mulO f) ;
  suc e | r -> trans (ap (\ v -> add v (psum (suc e) (point f))) (L.zero-mul (AP.power t (suc e))))
                (trans (L.zl (psum (suc e) (point f))) r) } ;
} ;

-- ring maps
module Map (T T' : CRing) (phi : H.Hom T T') (t : T.R) {
 module P = Over[T,t] ;
 module P' = Over[T',phi.1 t] ;
 psum-map : (e : Nat) (c : P.Coefficients) -> Id T'.R (phi.1 (P.psum e c)) (P'.psum e (\ i -> phi.1 (c i))) = split {
  zero -> \ c -> H.zero T T' phi ;
  suc e | r -> \ c ->
   trans (phi.2.2.1 (T.mul (c e) (P.AP.power t e)) (P.psum e c))
    (Ps.cong2 T'.R T'.add _ _ _ _
      (trans (phi.2.2.2 (c e) (P.AP.power t e)) (ap (T'.mul (phi.1 (c e))) (AffinePowers[l].power-map T T' phi t e)))
      (r c)) } ;
} ;
