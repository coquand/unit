-- Standard etale algebras (zmt2-revised.tex, Introduction), in points form.
-- A is the note's base ring R.  For P in A[X] and a in an A-algebra B,
-- P(a) and P'(a) are the two components of P(a + epsilon) in the dual
-- numbers B[epsilon] (QuadraticPairs with square 0), as in DerivativeStep;
-- the polynomial Q' = deriv Q is the derivative at the variable of A[X],
-- and Q'(a) = (deriv Q)(a) (deriv-value, by naturality of the dual-number
-- evaluation).
-- A point of (Q, G) in B: a with Q(a) = 0 and (G Q')(a) a unit; these are
-- the points of (A[X]/(Q))[1/G(a)Q'(a)].  An algebra S is standard for
-- (Q, G) when it has a point s through which Hom S B is the type of points
-- in B (push: h |-> h(s) is an equivalence, for every B): S is then
-- isomorphic to the note's algebra, by Yoneda.
-- Unramified (note, Section 2, "S is unramified over R").  Let h, h' : S
-- -> B with pi h = pi h' for a square-zero N.  Then a = h(s), a' = h'(s)
-- are points with eps = a' - a in N, so eps eps = 0.  The map
-- B[epsilon] -> B, x + y epsilon |-> x + y eps, is a ring map (Taylor);
-- the evaluation at a + epsilon followed by it is the evaluation at a', so
--   Q(a') = Q(a) + Q'(a) eps .
-- Q(a) = Q(a') = 0 gives Q'(a) eps = 0, and Q'(a) is a unit, so a = a';
-- then h = h' since push is an equivalence.
-- Localisation (note: "write the additional element as F(a)/G(a)^r and
-- invert G(a)F(a)"): a point of (Q, G F) is a point of (Q, G) with F(a) a
-- unit, since ((G F) Q')(a) = (G Q')(a) F(a).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module FE = FormallyEtale[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module E = FE.Over[A,setA] ;
 module RX = PolynomialRing[l].Extension[A,setA] ;
 -- P(a) and P'(a) for a in B
 module At (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (a : B.R) {
  open B ; module L = RL[B] ;
  module UP = Universal[l].Property[A,B,setA,setB].Given[iota,a] ;
  ev : H.Hom RX.ring B = UP.extend ;
  value (P : RX.Carrier) : R = ev.1 P ;
  module DN = QuadraticPairs[l].Over[B,setB,z] ;
  dual : H.Hom A DN.ring = H.compose A B DN.ring DN.inclusion iota ;
  module UPe = Universal[l].Property[A,DN.ring,setA,DN.set].Given[dual,(a,o)] ;
  -- P |-> P(a + epsilon)
  evd : H.Hom RX.ring DN.ring = UPe.extend ;
  derivative (P : RX.Carrier) : R = (evd.1 P).2 ;
  pi1 : H.Hom DN.ring B =
   (\ p -> p.1,refl o,\ p q -> refl (add p.1 q.1),
    \ p q -> trans (ap (add (mul p.1 q.1)) (L.zero-mul (mul p.2 q.2))) (addZ (mul p.1 q.1))) ;
  -- the first component of P(a + epsilon) is P(a)
  first : H.Hom RX.ring B = H.compose RX.ring DN.ring B pi1 evd ;
  first-at (P : RX.Carrier) : Id R (first.1 P) (evd.1 P).1 = refl (evd.1 P).1 ;
  first-ev : Id (H.Hom RX.ring B) first ev =
   UP.unique first (\ c -> ap pi1.1 (UPe.on-constants c)) (ap pi1.1 UPe.on-variable) ;
  value-first (P : RX.Carrier) : Id R (evd.1 P).1 (value P) =
   trans (sym (first-at P)) (ap (\ g -> g.1 P) first-ev) ;
  -- B[epsilon] -> B, x + y epsilon |-> x + y eps, for eps eps = 0
  module Taylor (eps : R) (sq : Id R (mul eps eps) z) {
   phi (p : DN.Pair) : R = add p.1 (mul p.2 eps) ;
   phi-one : Id R (phi DN.oneQ) o = trans (ap (add o) (L.zero-mul eps)) (addZ o) ;
   phi-add (p q : DN.Pair) : Id R (phi (DN.plusQ p q)) (add (phi p) (phi q)) =
    trans (ap (add (add p.1 q.1)) (L.dist-left p.2 q.2 eps)) (L.swap p.1 q.1 (mul p.2 eps) (mul q.2 eps)) ;
   -- the common point of the two sides of phi-mul
   mixed (p q : DN.Pair) : R = add (mul p.1 q.1) (add (mul (mul p.1 q.2) eps) (mul (mul p.2 q.1) eps)) ;
   phi-times (p q : DN.Pair) : Id R (phi (DN.timesQ p q)) (mixed p q) =
    calc R { add (add (mul p.1 q.1) (mul z (mul p.2 q.2))) (mul (add (mul p.1 q.2) (mul p.2 q.1)) eps)
      =< ap (\ t -> add t (mul (add (mul p.1 q.2) (mul p.2 q.1)) eps))
          (trans (ap (add (mul p.1 q.1)) (L.zero-mul (mul p.2 q.2))) (addZ (mul p.1 q.1)))
       > add (mul p.1 q.1) (mul (add (mul p.1 q.2) (mul p.2 q.1)) eps)
      =< ap (add (mul p.1 q.1)) (L.dist-left (mul p.1 q.2) (mul p.2 q.1) eps) > mixed p q } ;
   times-phi (p q : DN.Pair) : Id R (mul (phi p) (phi q)) (mixed p q) =
    calc R { mul (add p.1 (mul p.2 eps)) (add q.1 (mul q.2 eps))
      =< L.dist-left p.1 (mul p.2 eps) (add q.1 (mul q.2 eps))
       > add (mul p.1 (add q.1 (mul q.2 eps))) (mul (mul p.2 eps) (add q.1 (mul q.2 eps)))
      =< Ps.cong2 R add _ _ _ _ (dist p.1 q.1 (mul q.2 eps)) (dist (mul p.2 eps) q.1 (mul q.2 eps))
       > add (add (mul p.1 q.1) (mul p.1 (mul q.2 eps))) (add (mul (mul p.2 eps) q.1) (mul (mul p.2 eps) (mul q.2 eps)))
      =< ap (\ t -> add (add (mul p.1 q.1) (mul p.1 (mul q.2 eps))) (add (mul (mul p.2 eps) q.1) t))
          (trans (L.mul-four p.2 eps q.2 eps) (trans (ap (mul (mul p.2 q.2)) sq) (L.mul-zero (mul p.2 q.2))))
       > add (add (mul p.1 q.1) (mul p.1 (mul q.2 eps))) (add (mul (mul p.2 eps) q.1) z)
      =< ap (add (add (mul p.1 q.1) (mul p.1 (mul q.2 eps)))) (addZ (mul (mul p.2 eps) q.1))
       > add (add (mul p.1 q.1) (mul p.1 (mul q.2 eps))) (mul (mul p.2 eps) q.1)
      =< sym (addA (mul p.1 q.1) (mul p.1 (mul q.2 eps)) (mul (mul p.2 eps) q.1))
       > add (mul p.1 q.1) (add (mul p.1 (mul q.2 eps)) (mul (mul p.2 eps) q.1))
      =< ap (add (mul p.1 q.1)) (Ps.cong2 R add _ _ _ _ (mulA p.1 q.2 eps)
          (trans (sym (mulA p.2 eps q.1)) (trans (ap (mul p.2) (mulC eps q.1)) (mulA p.2 q.1 eps))))
       > mixed p q } ;
   phi-hom : H.Hom DN.ring B = (phi,phi-one,phi-add,\ p q -> trans (phi-times p q) (sym (times-phi p q))) ;
   module UPt = Universal[l].Property[A,B,setA,setB].Given[iota,add a eps] ;
   -- evaluation at a + epsilon, then phi, is evaluation at a + eps
   shifted : Id (H.Hom RX.ring B) (H.compose RX.ring DN.ring B phi-hom evd) UPt.extend =
    UPt.unique (H.compose RX.ring DN.ring B phi-hom evd)
     (\ c -> trans (ap phi (UPe.on-constants c)) (trans (ap (add (iota.1 c)) (L.zero-mul eps)) (addZ (iota.1 c))))
     (trans (ap phi UPe.on-variable) (ap (add a) (L.one-left eps))) ;
   -- P(a + eps) = P(a) + P'(a) eps
   taylor (P : RX.Carrier) : Id R (UPt.extend.1 P) (add (value P) (mul (derivative P) eps)) =
    trans (sym (ap (\ g -> g.1 P) shifted)) (ap (\ t -> add t (mul (derivative P) eps)) (value-first P)) ;
  } ;
 } ;
 -- values and derivatives are preserved by maps of A-algebras
 module Natural (B B' : CRing) (setB : Pr.isSet B.R) (setB' : Pr.isSet B'.R) (iota : H.Hom A B) (iota' : H.Hom A B')
  (h : H.Hom B B') (hc : (c : A.R) -> Id B'.R (h.1 (iota.1 c)) (iota'.1 c)) (a : B.R) {
  module X = At[B,setB,iota,a] ;
  module Y = At[B',setB',iota',h.1 a] ;
  value (P : RX.Carrier) : Id B'.R (h.1 (X.value P)) (Y.value P) =
   ap (\ g -> g.1 P) (Y.UP.unique (H.compose RX.ring B B' h X.ev) (\ c -> trans (ap h.1 (X.UP.on-constants c)) (hc c)) (ap h.1 X.UP.on-variable)) ;
  -- h on the dual numbers
  hD : H.Hom X.DN.ring Y.DN.ring =
   (\ p -> (h.1 p.1,h.1 p.2),Y.DN.eq _ _ h.2.1 (H.zero B B' h),
    \ p q -> Y.DN.eq _ _ (h.2.2.1 p.1 q.1) (h.2.2.1 p.2 q.2),
    \ p q -> Y.DN.eq _ _
     (trans (h.2.2.1 (B.mul p.1 q.1) (B.mul B.z (B.mul p.2 q.2)))
      (Ps.cong2 B'.R B'.add _ _ _ _ (h.2.2.2 p.1 q.1)
       (trans (h.2.2.2 B.z (B.mul p.2 q.2)) (Ps.cong2 B'.R B'.mul _ _ _ _ (H.zero B B' h) (h.2.2.2 p.2 q.2)))))
     (trans (h.2.2.1 (B.mul p.1 q.2) (B.mul p.2 q.1)) (Ps.cong2 B'.R B'.add _ _ _ _ (h.2.2.2 p.1 q.2) (h.2.2.2 p.2 q.1)))) ;
  derivative (P : RX.Carrier) : Id B'.R (h.1 (X.derivative P)) (Y.derivative P) =
   ap (\ g -> (g.1 P).2) (Y.UPe.unique (H.compose RX.ring X.DN.ring Y.DN.ring hD X.evd)
    (\ c -> trans (ap hD.1 (X.UPe.on-constants c)) (Y.DN.eq _ _ (hc c) (H.zero B B' h)))
    (trans (ap hD.1 X.UPe.on-variable) (Y.DN.eq _ _ (refl (h.1 a)) h.2.1))) ;
 } ;
 -- the polynomial Q'
 deriv (P : RX.Carrier) : RX.Carrier = At[RX.ring,RX.set,RX.inclusion,RX.variable].derivative P ;
 -- Q'(a) is the derivative at a
 deriv-value (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (a : B.R) (P : RX.Carrier) :
  Id B.R (At[B,setB,iota,a].value (deriv P)) (At[B,setB,iota,a].derivative P) =
  trans (Natural[RX.ring,B,RX.set,setB,RX.inclusion,iota,At[B,setB,iota,a].ev,At[B,setB,iota,a].UP.on-constants,RX.variable].derivative P)
   (ap (\ b -> At[B,setB,iota,b].derivative P) At[B,setB,iota,a].UP.on-variable) ;

 ---------------------------------------------------------------------
 -- points of (Q, G)

 module Points (Q G : RX.Carrier) {
  g : RX.Carrier = RX.ring.mul G (deriv Q) ;
  IsPoint (B : C.Algebra) (a : B.ring.R) : U l =
   Id B.ring.R (At[B.ring,B.set,B.iota,a].value Q) B.ring.z * RL[B.ring].unit (At[B.ring,B.set,B.iota,a].value g) ;
  Point (B : C.Algebra) : U l = (a : B.ring.R) * IsPoint B a ;
  is-point-prop (B : C.Algebra) (a : B.ring.R) : Pr.isProp (IsPoint B a) =
   Pr.isProp-Sigma _ (\ q -> RL[B.ring].unit (At[B.ring,B.set,B.iota,a].value g)) (B.set _ _)
    (\ q -> FE.Units[B.ring,B.set].unit-prop (At[B.ring,B.set,B.iota,a].value g)) ;
  point-ext (B : C.Algebra) (p q : Point B) (e : Id B.ring.R p.1 q.1) : Id (Point B) p q =
   Pr.Sigma-eq B.ring.R (IsPoint B) p.1 q.1 p.2 q.2 e (is-point-prop B q.1) ;
  -- h(s) for a point s in S and h : S -> B
  module Push (S : C.Algebra) (s : Point S) (B : C.Algebra) (h : C.Hom S B) {
   module N = Natural[S.ring,B.ring,S.set,B.set,S.iota,B.iota,h.1,h.2,s.1] ;
   point : Point B = (h.1.1 s.1,
    trans (sym (N.value Q)) (trans (ap h.1.1 s.2.1) (H.zero S.ring B.ring h.1)),
    subst (RL[B.ring].unit) (N.value g) (FE.unit-map S.ring B.ring h.1 (N.X.value g) s.2.2)) ;
  } ;
  push (S : C.Algebra) (s : Point S) (B : C.Algebra) (h : C.Hom S B) : Point B = Push[S,s,B,h].point ;
  -- S is standard for (Q, G): Hom S B is the type of points, through s
  Classifies (S : C.Algebra) (s : Point S) : U l+ =
   (B : C.Algebra) -> Pr.isEquiv (C.Hom S B) (Point B) (push S s B) ;
  Standard (S : C.Algebra) : U l+ = (s : Point S) * Classifies S s ;

  -- S is unramified
  module Unramified (S : C.Algebra) (st : Standard S) (B : C.Algebra) (N : E.SquareZero[B]) (h h' : C.Hom S B)
   (e : Id (C.Hom S E.Mod[B,N].algebra) (E.reduce S B N h) (E.reduce S B N h')) {
   module L = RL[B.ring] ; module Un = FE.Units[B.ring,B.set] ;
   pa : Point B = push S st.1 B h ;
   pa' : Point B = push S st.1 B h' ;
   eps : B.ring.R = B.ring.add pa'.1 (B.ring.neg pa.1) ;
   -- pi a = pi a'
   classes : Id E.Mod[B,N].Q.Carrier (E.Mod[B,N].Q.include pa.1) (E.Mod[B,N].Q.include pa'.1) =
    trans (sym (E.reduce-at S B N h st.1.1)) (trans (ap (\ k -> k.1.1 st.1.1) e) (E.reduce-at S B N h' st.1.1)) ;
   eps-in : N.ideal.In eps = E.Mod[B,N].Q.Q.effective pa'.1 pa.1 (sym classes) ;
   module X = At[B.ring,B.set,B.iota,pa.1] ;
   module T = X.Taylor[eps,N.square eps eps eps-in eps-in] ;
   -- a + (a' - a) = a'
   shift : Id B.ring.R (B.ring.add pa.1 eps) pa'.1 =
    trans (L.add-swap pa.1 pa'.1 (B.ring.neg pa.1)) (trans (ap (B.ring.add pa'.1) (B.ring.addN pa.1)) (B.ring.addZ pa'.1)) ;
   -- Q(a') = Q(a) + Q'(a) eps
   taylor : Id B.ring.R (At[B.ring,B.set,B.iota,pa'.1].value Q) (B.ring.add (X.value Q) (B.ring.mul (X.derivative Q) eps)) =
    trans (ap (\ b -> At[B.ring,B.set,B.iota,b].value Q) (sym shift)) (T.taylor Q) ;
   killed : Id B.ring.R (B.ring.mul (X.derivative Q) eps) B.ring.z =
    L.add-cancel (X.value Q) (B.ring.mul (X.derivative Q) eps) (trans (sym taylor) (trans pa'.2.1 (sym pa.2.1))) ;
   -- Q'(a) is a unit, since (G Q')(a) = G(a) Q'(a) is
   q-prime : L.unit (X.derivative Q) =
    subst L.unit (deriv-value B.ring B.set B.iota pa.1 Q)
     (Un.unit-right (X.value G) (X.value (deriv Q)) (subst L.unit (X.ev.2.2.2 G (deriv Q)) pa.2.2)) ;
   same : Id B.ring.R pa.1 pa'.1 = sym (Un.sub-zero pa'.1 pa.1 (L.unit-reg (X.derivative Q) eps q-prime killed)) ;
   result : Id (C.Hom S B) h h' =
    trans (sym ((st.2 B).ret-eq h)) (trans (ap (st.2 B).ret (point-ext B pa pa' same)) ((st.2 B).ret-eq h')) ;
  } ;
  unramified (S : C.Algebra) (st : Standard S) : E.Unique S =
   \ B N h h' e -> Unramified[S,st,B,N,h,h',e].result ;
 } ;

 ---------------------------------------------------------------------
 -- principal localisation: the points of (Q, G F) are the points of
 -- (Q, G) where F is a unit

 module Localise (Q G F : RX.Carrier) (B : C.Algebra) (a : B.ring.R) {
  module Pg = Points[Q,G] ;
  module Pgf = Points[Q,RX.ring.mul G F] ;
  module X = At[B.ring,B.set,B.iota,a] ;
  module Un = FE.Units[B.ring,B.set] ;
  -- ((G F) Q')(a) = (G Q')(a) F(a)
  values : Id B.ring.R (X.value Pgf.g) (B.ring.mul (X.value Pg.g) (X.value F)) =
   calc B.ring.R { X.value Pgf.g
     =< X.ev.2.2.2 (RX.ring.mul G F) (deriv Q) > B.ring.mul (X.value (RX.ring.mul G F)) (X.value (deriv Q))
     =< ap (\ t -> B.ring.mul t (X.value (deriv Q))) (X.ev.2.2.2 G F)
      > B.ring.mul (B.ring.mul (X.value G) (X.value F)) (X.value (deriv Q))
     =< sym (B.ring.mulA (X.value G) (X.value F) (X.value (deriv Q)))
      > B.ring.mul (X.value G) (B.ring.mul (X.value F) (X.value (deriv Q)))
     =< ap (B.ring.mul (X.value G)) (B.ring.mulC (X.value F) (X.value (deriv Q)))
      > B.ring.mul (X.value G) (B.ring.mul (X.value (deriv Q)) (X.value F))
     =< B.ring.mulA (X.value G) (X.value (deriv Q)) (X.value F)
      > B.ring.mul (B.ring.mul (X.value G) (X.value (deriv Q))) (X.value F)
     =< ap (\ t -> B.ring.mul t (X.value F)) (sym (X.ev.2.2.2 G (deriv Q))) > B.ring.mul (X.value Pg.g) (X.value F) } ;
  product (p : Pgf.IsPoint B a) : RL[B.ring].unit (B.ring.mul (X.value Pg.g) (X.value F)) =
   subst (RL[B.ring].unit) values p.2 ;
  to (p : Pgf.IsPoint B a) : Pg.IsPoint B a = (p.1,Un.unit-left (X.value Pg.g) (X.value F) (product p)) ;
  to-unit (p : Pgf.IsPoint B a) : RL[B.ring].unit (X.value F) = Un.unit-right (X.value Pg.g) (X.value F) (product p) ;
  from (p : Pg.IsPoint B a) (f : RL[B.ring].unit (X.value F)) : Pgf.IsPoint B a =
   (p.1,subst (RL[B.ring].unit) (sym values) (Un.unit-mul (X.value Pg.g) (X.value F) p.2 f)) ;
 } ;
} ;
