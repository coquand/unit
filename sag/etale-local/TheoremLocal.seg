-- Theorem local of zmt2-revised.tex (line 61) with ZMT and the field case
-- in the note's form (lines 65-90): the choice of the factor and the
-- refinement of s, then Local.
--
-- Hypotheses.
--  * ZMT (ACL Cor. 1.4): B finite (generators; merely coordinates of
--    each element, coord), j : B -> E, s in B with merely s in 1 + m E (s-one),
--    B[1/s] = E[1/s] (zmt: every z in E has merely s^k z = j(b)).
--  * The field case: (E/mE)[1/s] = A[1/s-bar] is the product of the
--    factors A[1/s-bar] eps_i = k[X]/(P_i), X |-> x_i eps_i (finite etale
--    over k is a finite product of monogenic factors).  Used: the eps_i add
--    up to 1 in (E/mE)[1/s] (sum-one), and for each factor the three
--    consequences of the isomorphism, multiplied by eps_i (Piece):
--      s^N eps P(x) in m E,  s^N eps (P'(x) w - 1) in m E,
--      for every b: s^N eps (b - C(x)) in m B.
--    (That the eps_i are orthogonal idempotents is not used.)
--  * E etale, q a decidable prime containing m E (as in Local).
-- Proof.
--  1. s is not in q: s - 1 is in m E, contained in q, and 1 is not in q.
--  2. Some eps_i is not in q (find, by decidability of q): otherwise
--     sum eps_i is in q, and so is s^N (sum eps_i - 1), hence (s not in q,
--     q prime) sum eps_i - 1: then 1 is in q.
--  3. Refine: s' = s eps_i (the note: "lift the idempotent, clear the
--     denominator, multiply s by the numerator").  s' is not in q;
--     s'^k z = j(eps^k b) when s^k z = j(b); and the factor's facts hold
--     for s', by  s'^(N+1) w = (s eps^N) (s^N (eps w))  (refine).
--  4. Local.Field.theorem for (s', x_i, P_i).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
-- (a b)^(N+1) w = (a b^N) (a^N (b w))
module Refine (T : CRing) {
 open T ; module L = RL[T] ; module PT = AffinePowers[l].Over[T] ;
 refine (a b w : R) (N : Nat) : Id R (mul (PT.power (mul a b) (suc N)) w) (mul (mul a (PT.power b N)) (mul (PT.power a N) (mul b w))) =
  trans (calc R {
   mul (mul (mul a b) (PT.power (mul a b) N)) w
    =< ap (\ t -> mul (mul (mul a b) t) w) (PT.power-mul a b N) > mul (mul (mul a b) (mul (PT.power a N) (PT.power b N))) w
    =< ap (\ t -> mul t w) (L.mul-four a b (PT.power a N) (PT.power b N)) > mul (mul (mul a (PT.power a N)) (mul b (PT.power b N))) w
    =< sym (mulA (mul a (PT.power a N)) (mul b (PT.power b N)) w) > mul (mul a (PT.power a N)) (mul (mul b (PT.power b N)) w) })
   (sym (calc R {
   mul (mul a (PT.power b N)) (mul (PT.power a N) (mul b w))
    =< L.mul-four a (PT.power b N) (PT.power a N) (mul b w) > mul (mul a (PT.power a N)) (mul (PT.power b N) (mul b w))
    =< ap (mul (mul a (PT.power a N))) (trans (mulA (PT.power b N) b w) (ap (\ t -> mul t w) (mulC (PT.power b N) b)))
     > mul (mul a (PT.power a N)) (mul (mul b (PT.power b N)) w) })) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (q a) (q c)) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 -- ZMT
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-one : Tr.Trunc[IdealGenerated[l].Over[A,m,E,iota].InmB (E.add (j.1 s) (E.neg E.o))].carrier)
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier)
 -- E etale
 (etale : FormallyEtale[l].Over[A,setA].Etale (Algebras[l].Over[A,setA].mkAlgebra E setE iota)) {
 module LE = RL[E] ; module LB = RL[B] ;
 -- Empty at the next level
 empty-up : Empty -> Ring[l+].Empty = split { } ;
 module SEs = FiniteIdeal[l].Sums[E] ;
 module RE = Refine[E] ; module RB = Refine[B] ;
 -- 1. s is not in q: m E is contained in q
 module IGE = IdealGenerated[l].Over[A,m,E,iota] ;
 q-gens : (ps : List IGE.Gen) -> q (IGE.Ls.lsum IGE.value ps) = split {
  nil -> q-zero ;
  cons p ps | r -> q-add _ _ (subst q (E.mulC p.2.2 (iota.1 p.1)) (q-scale p.2.2 _ (q-m p.1 p.2.1))) r } ;
  s-q1 (h : q (j.1 s)) (s1 : IGE.InmB (E.add (j.1 s) (E.neg E.o))) : Empty = q-proper (subst q (Introduction[l].Steps[E].sub-sub (j.1 s) E.o)
  (q-add _ _ h (subst q (trans (LE.neg-mul-left E.o (E.add (j.1 s) (E.neg E.o))) (ap E.neg (LE.one-left (E.add (j.1 s) (E.neg E.o)))))
    (q-scale (E.neg E.o) _ (subst q (sym s1.2) (q-gens s1.1)))))) ;
 s-q (h : q (j.1 s)) : Empty =
  Tr.Trunc[IGE.InmB (E.add (j.1 s) (E.neg E.o))].induction @l (\ w -> Empty) (\ w -> \ e -> efq e) (s-q1 h) s-one ;
 s-out : Not (q (j.1 s)) = \ h -> s-q h ;
 module In0 = Introduction[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,q,q-zero,q-add,q-scale,q-m,q-prime,q-proper,q-dec,
  B,setB,iB,j,j-alg,n',bs,coord,s,s-out,zmt] ;
 -- a factor: its idempotent eps, generator x and polynomial P, with the
 -- three facts multiplied by eps
 PRoot (eps x : B.R) (P : List A.R) : U l =
  (N : Nat) * In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.mul (j.1 eps) (MonicReduce[l].Horner[A,E,iota,j.1 x].horner P))) ;
 PSeparable (eps x : B.R) (P : List A.R) : U l =
  (w : E.R) * (N : Nat) * In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.mul (j.1 eps) (E.add (E.mul (In0.slope (j.1 x) P) w) (E.neg E.o)))) ;
 PGenerates (eps x : B.R) : U l =
  (b : B.R) -> (C : List A.R) * (N : Nat) *
   In0.IGB.InmB (B.mul (In0.PB.power s N) (B.mul eps (B.add b (B.neg (MonicReduce[l].Horner[A,B,iB,x].horner C))))) ;
 Piece (eps x : B.R) : U l = (P : List A.R) * PRoot eps x P * PSeparable eps x P * PGenerates eps x ;
 ppoly {eps x : B.R} (F : Piece eps x) : List A.R = F.1 ;
 proot {eps x : B.R} (F : Piece eps x) : PRoot eps x (ppoly F) = F.2.1 ;
 pseparable {eps x : B.R} (F : Piece eps x) : PSeparable eps x (ppoly F) = F.2.2.1 ;
 pgenerates {eps x : B.R} (F : Piece eps x) : PGenerates eps x = F.2.2.2 ;

 -- 2. a factor outside q
 all-top (n : Nat) (f : Ps.Fin (suc n) -> E.R) (h : q (f (inr tt))) : (t : Top) -> q (f (inr t)) = split { tt -> h } ;
 all-cons (n : Nat) (f : Ps.Fin (suc n) -> E.R) (h : q (f (inr tt))) (all : (i : Ps.Fin n) -> q (f (inl i))) :
  (i : Ps.Fin (suc n)) -> q (f i) = split { inl i -> all i ; inr t -> all-top n f h t } ;
 find-rest (n : Nat) (f : Ps.Fin (suc n) -> E.R) (h : q (f (inr tt))) :
  Plus ((i : Ps.Fin n) * Not (q (f (inl i)))) ((i : Ps.Fin n) -> q (f (inl i))) ->
  Plus ((i : Ps.Fin (suc n)) * Not (q (f i))) ((i : Ps.Fin (suc n)) -> q (f i)) = split {
  inl io -> inl (inl io.1,io.2) ;
  inr all -> inr (all-cons n f h all) } ;
 find-step (n : Nat) (f : Ps.Fin (suc n) -> E.R)
  (rest : Plus ((i : Ps.Fin n) * Not (q (f (inl i)))) ((i : Ps.Fin n) -> q (f (inl i)))) :
  Plus (q (f (inr tt))) (Not (q (f (inr tt)))) -> Plus ((i : Ps.Fin (suc n)) * Not (q (f i))) ((i : Ps.Fin (suc n)) -> q (f i)) = split {
  inr out -> inl (inr tt,out) ;
  inl h -> find-rest n f h rest } ;
 find : (n : Nat) (f : Ps.Fin n -> E.R) -> Plus ((i : Ps.Fin n) * Not (q (f i))) ((i : Ps.Fin n) -> q (f i)) = split {
  zero -> \ f -> inr (\ i -> efq i) ;
  suc n | r -> \ f -> find-step n f (r (\ i -> f (inl i))) (q-dec (f (inr tt))) } ;
 sum-q : (n : Nat) (f : Ps.Fin n -> E.R) -> ((i : Ps.Fin n) -> q (f i)) -> q (SEs.sum n f) = split {
  zero -> \ f h -> q-zero ;
  suc n | r -> \ f h -> q-add _ _ (h (inr tt)) (r (\ i -> f (inl i)) (\ i -> h (inl i))) } ;

 module FieldCase (nf : Nat) (eps : Ps.Fin nf -> B.R)
  (sum-one : (N : Nat) * In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.add (SEs.sum nf (\ i -> j.1 (eps i))) (E.neg E.o))))
  (xs : Ps.Fin nf -> B.R) (pieces : (i : Ps.Fin nf) -> Piece (eps i) (xs i)) {
  -- if every eps_i were in q, 1 would be
  sum-case : Plus (q (In0.PE.power (j.1 s) sum-one.1)) (q (E.add (SEs.sum nf (\ i -> j.1 (eps i))) (E.neg E.o))) ->
   q (SEs.sum nf (\ i -> j.1 (eps i))) -> Empty = split {
   inl h -> \ hs -> In0.power-out (j.1 s) s-out sum-one.1 h ;
   inr h -> \ hs -> q-proper (subst q (In0.StE.sub-sub (SEs.sum nf (\ i -> j.1 (eps i))) E.o) (q-add _ _ hs (In0.q-neg _ h))) } ;
  not-all (all : (i : Ps.Fin nf) -> q (j.1 (eps i))) : Empty =
   sum-case (q-prime _ _ (In0.q-mE _ sum-one.2)) (sum-q nf (\ i -> j.1 (eps i)) all) ;

  -- 3. the refinement s' = s eps_i, for a factor outside q
  module At (i : Ps.Fin nf) (out : Not (q (j.1 (eps i)))) {
   e : B.R = eps i ;
   x : B.R = xs i ;
   F : Piece e x = pieces i ;
   s' : B.R = B.mul s e ;
   js' : Id E.R (j.1 s') (E.mul (j.1 s) (j.1 e)) = j.2.2.2 s e ;
   s'-case : Plus (q (j.1 s)) (q (j.1 e)) -> Empty = split { inl h -> s-out h ; inr h -> out h } ;
   s'-out : Not (q (j.1 s')) = \ h -> s'-case (q-prime _ _ (subst q js' h)) ;
   Zmt' (z : E.R) : U l = (k : Nat) * (b : B.R) * Id E.R (E.mul (In0.PE.power (j.1 s') k) z) (j.1 b) ;
   zmt-at (z : E.R) (w : In0.Zmt z) : Zmt' z =
    (w.1,B.mul (In0.PB.power e w.1) w.2.1,calc E.R {
     E.mul (In0.PE.power (j.1 s') w.1) z
      =< ap (\ t -> E.mul (In0.PE.power t w.1) z) js' > E.mul (In0.PE.power (E.mul (j.1 s) (j.1 e)) w.1) z
      =< ap (\ t -> E.mul t z) (In0.PE.power-mul (j.1 s) (j.1 e) w.1)
       > E.mul (E.mul (In0.PE.power (j.1 s) w.1) (In0.PE.power (j.1 e) w.1)) z
      =< trans (ap (\ t -> E.mul t z) (E.mulC (In0.PE.power (j.1 s) w.1) (In0.PE.power (j.1 e) w.1)))
          (sym (E.mulA (In0.PE.power (j.1 e) w.1) (In0.PE.power (j.1 s) w.1) z))
       > E.mul (In0.PE.power (j.1 e) w.1) (E.mul (In0.PE.power (j.1 s) w.1) z)
      =< ap (E.mul (In0.PE.power (j.1 e) w.1)) w.2.2 > E.mul (In0.PE.power (j.1 e) w.1) (j.1 w.2.1)
      =< sym (trans (j.2.2.2 (In0.PB.power e w.1) w.2.1)
          (ap (\ t -> E.mul t (j.1 w.2.1)) (AffinePowers[l].power-map B E j e w.1)))
       > j.1 (B.mul (In0.PB.power e w.1) w.2.1) }) ;
   zmt' (z : E.R) : Tr.Trunc[Zmt' z].carrier = In0.TC.map (In0.Zmt z) (Zmt' z) (zmt-at z) (zmt z) ;
   module Lo = Local[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,q,q-zero,q-add,q-scale,q-m,q-prime,q-proper,q-dec,
    B,setB,iB,j,j-alg,n',bs,coord,s',s'-out,zmt'] ;
   -- s'^(N+1) w = (s eps^N) (s^N (eps w)), in E
   lift-E (N : Nat) (w : E.R) (h : In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.mul (j.1 e) w))) :
    In0.IGE.InmB (E.mul (In0.PE.power (j.1 s') (suc N)) w) =
    subst In0.IGE.InmB (sym (trans (ap (\ t -> E.mul (In0.PE.power t (suc N)) w) js') (RE.refine (j.1 s) (j.1 e) w N)))
     (In0.IGE.in-scale (E.mul (j.1 s) (In0.PE.power (j.1 e) N)) _ h) ;
   factor : Lo.In.Factor x =
    (ppoly F,(suc (proot F).1,lift-E (proot F).1 _ (proot F).2),
     ((pseparable F).1,suc (pseparable F).2.1,lift-E (pseparable F).2.1 _ (pseparable F).2.2),
     \ b -> ((pgenerates F b).1,suc (pgenerates F b).2.1,
       subst In0.IGB.InmB (sym (RB.refine s e (B.add b (B.neg (MonicReduce[l].Horner[A,B,iB,x].horner (pgenerates F b).1))) (pgenerates F b).2.1))
        (In0.IGB.in-scale (B.mul s (In0.PB.power e (pgenerates F b).2.1)) _ (pgenerates F b).2.2))) ;
   -- 4. Local
   theorem : Truncation[l+].Trunc[Lo.St.Conclusion].carrier = Lo.Field[x,factor,etale].theorem ;
  } ;
  -- Theorem local
  module St = Local[l].Statement[A,setA,E,setE,iota,q] ;
  chosen : Plus ((i : Ps.Fin nf) * Not (q (j.1 (eps i)))) ((i : Ps.Fin nf) -> q (j.1 (eps i))) = find nf (\ i -> j.1 (eps i)) ;
  theorem-at (i : Ps.Fin nf) (out : Not (q (j.1 (eps i)))) : Truncation[l+].Trunc[St.Conclusion].carrier = At[i,out].theorem ;
  theorem-case : Plus ((i : Ps.Fin nf) * Not (q (j.1 (eps i)))) ((i : Ps.Fin nf) -> q (j.1 (eps i))) -> Truncation[l+].Trunc[St.Conclusion].carrier = split {
   inl io -> theorem-at io.1 io.2 ;
   inr all -> Ring[l+].absurd (Truncation[l+].Trunc[St.Conclusion].carrier) (empty-up (not-all all)) } ;
  theorem : Truncation[l+].Trunc[St.Conclusion].carrier = theorem-case chosen ;
 } ;
 -- the data of the field case, as one type
 SumOne (nf : Nat) (eps : Ps.Fin nf -> B.R) : U l =
  (N : Nat) * In0.IGE.InmB (E.mul (In0.PE.power (j.1 s) N) (E.add (SEs.sum nf (\ i -> j.1 (eps i))) (E.neg E.o))) ;
 FieldData : U l = (nf : Nat) * (eps : Ps.Fin nf -> B.R) * SumOne nf eps * (xs : Ps.Fin nf -> B.R) * ((i : Ps.Fin nf) -> Piece (eps i) (xs i)) ;
 theorem-of (fd : FieldData) : Truncation[l+].Trunc[Local[l].Statement[A,setA,E,setE,iota,q].Conclusion].carrier =
  FieldCase[fd.1,fd.2.1,fd.2.2.1,fd.2.2.2.1,fd.2.2.2.2].theorem ;
} ;
