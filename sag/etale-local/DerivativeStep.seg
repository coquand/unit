-- The Q' step of zmt2-revised.tex Section 1 (lines 242-253), by the
-- derivative of the loop's identity.  A with an ideal m; T an A-algebra
-- (iota), eta in T, J an ideal of T containing iota(m) (in the note:
-- T = E_g, eta = y, J = m E_g).  P(eta) and P'(eta) are the two components
-- of P(eta + epsilon) in the dual numbers T[epsilon] (QuadraticPairs with
-- a = 0), so (P Q)' = P' Q + P Q' holds by the multiplication of pairs.
-- "x is a unit mod J": x v - 1 in J for some v.
-- Theorem.  If  G^n H = U Q + [c]_e  in A[X] with every c_i in m (the
-- output of Loop with W = G^n H), and Q(eta), H(eta) in J, H'(eta) and
-- G(eta) units mod J, then Q'(eta) is a unit mod J; so Q'(eta) is in no
-- ideal q containing J with 1 not in q (Q'(y) not in the prime q).
-- Informal proof.  Take epsilon-components:
--   G(eta)^n H'(eta) + (G^n)'(eta) H(eta) = U(eta) Q'(eta) + U'(eta) Q(eta) + c'
-- with c' = [c]_e'(eta) in J.  H(eta), Q(eta) in J give
--   U(eta) Q'(eta) = G(eta)^n H'(eta)  mod J ,
-- a unit mod J, so Q'(eta) is a unit mod J.  (Neither H-bar | Q-bar nor
-- the factor D of the note is needed.)
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l)
 (T : CRing) (setT : Pr.isSet T.R) (iota : H.Hom A T) (eta : T.R)
 (J : T.R -> U l) (J-zero : J T.z) (J-add : (a c : T.R) -> J a -> J c -> J (T.add a c))
 (J-scale : (a c : T.R) -> J c -> J (T.mul a c)) (J-m : (a : A.R) -> m a -> J (iota.1 a)) {
 open T ;
 module L = RL[T] ;
 module RX = PolynomialRing[l].Extension[A,setA] ;
 module PSX = PowerSums[l].Over[RX.ring,RX.variable] ;
 module AP = AffinePowers[l].Over[T] ;
 -- the dual numbers T[epsilon]
 module DN = QuadraticPairs[l].Over[T,setT,z] ;
 dual-iota : H.Hom A DN.ring = H.compose A T DN.ring DN.inclusion iota ;
 module UPe = Universal[l].Property[A,DN.ring,setA,DN.set].Given[dual-iota,(eta,o)] ;
 -- P |-> P(eta + epsilon)
 evd : H.Hom RX.ring DN.ring = UPe.extend ;
 der (P : RX.Carrier) : R = (evd.1 P).2 ;
 -- the first projection is a ring map
 pi1 : H.Hom DN.ring T =
  (\ p -> p.1,refl o,\ p q -> refl (add p.1 q.1),
   \ p q -> trans (ap (add (mul p.1 q.1)) (L.zero-mul (mul p.2 q.2))) (addZ (mul p.1 q.1))) ;
 valH : H.Hom RX.ring T = H.compose RX.ring DN.ring T pi1 evd ;
 val (P : RX.Carrier) : R = valH.1 P ;
 -- val is evaluation at eta
 module UP = Universal[l].Property[A,T,setA,setT].Given[iota,eta] ;
 val-ev (P : RX.Carrier) : Id R (val P) (UP.extend.1 P) =
  ap (\ h -> h.1 P) (UP.unique valH (\ c -> ap pi1.1 (UPe.on-constants c)) (ap pi1.1 UPe.on-variable)) ;
 Px (e : Nat) (c : Nat -> A.R) : RX.Carrier = PSX.psum e (\ i -> RX.inclusion.1 (c i)) ;

 ---------------------------------------------------------------------
 -- units modulo J

 J-eq {a c : R} (p : Id R a c) (h : J a) : J c = subst J p h ;
 J-neg (a : R) (h : J a) : J (neg a) = J-eq (trans (L.neg-mul-left o a) (ap neg (L.one-left a))) (J-scale (neg o) a h) ;
 UnitMod (x : R) : U l = (v : R) * J (add (mul x v) (neg o)) ;
 -- (p - q) + (q + w) = p + w
 cancel-mid (p q w : R) : Id R (add (add p (neg q)) (add q w)) (add p w) =
  trans (sym (addA p (neg q) (add q w)))
   (ap (add p) (trans (addA (neg q) q w) (trans (ap (\ t -> add t w) (L.neg-cancel q)) (L.zl w)))) ;
 -- (x - x') v = x v - x' v
 sub-mul (x x' v : R) : Id R (mul (add x (neg x')) v) (add (mul x v) (neg (mul x' v))) =
  trans (L.dist-left x (neg x') v) (ap (add (mul x v)) (L.neg-mul-left x' v)) ;
 unit-mod-mul (x x' : R) (u : UnitMod x) (u' : UnitMod x') : UnitMod (mul x x') =
  (mul u.1 u'.1,
   J-eq (trans (ap (\ t -> add t (add (mul x' u'.1) (neg o))) (sub-mul (mul x u.1) o (mul x' u'.1)))
         (trans (ap (\ t -> add (add (mul (mul x u.1) (mul x' u'.1)) (neg t)) (add (mul x' u'.1) (neg o))) (L.one-left (mul x' u'.1)))
          (trans (cancel-mid (mul (mul x u.1) (mul x' u'.1)) (mul x' u'.1) (neg o))
           (ap (\ t -> add t (neg o)) (sym (L.mul-four x x' u.1 u'.1))))))
    (J-add _ _ (J-eq (mulC (mul x' u'.1) (add (mul x u.1) (neg o))) (J-scale (mul x' u'.1) _ u.2)) u'.2)) ;
 unit-mod-congr (x x' : R) (h : J (add x (neg x'))) (u : UnitMod x') : UnitMod x =
  (u.1,J-eq (trans (ap (\ t -> add t (add (mul x' u.1) (neg o))) (sub-mul x x' u.1)) (cancel-mid (mul x u.1) (mul x' u.1) (neg o)))
        (J-add _ _ (J-eq (mulC u.1 (add x (neg x'))) (J-scale u.1 _ h)) u.2)) ;
 unit-mod-factor (x x' : R) (u : UnitMod (mul x x')) : UnitMod x' =
  (mul x u.1,J-eq (ap (\ t -> add t (neg o)) (trans (ap (\ t -> mul t u.1) (mulC x x')) (sym (mulA x' x u.1)))) u.2) ;
 unit-mod-power (x : R) (u : UnitMod x) : (n : Nat) -> UnitMod (AP.power x n) = split {
  zero -> (o,J-eq (sym (trans (ap (\ t -> add t (neg o)) (mulO o)) (addN o))) J-zero) ;
  suc n | r -> unit-mod-mul x (AP.power x n) u r } ;

 ---------------------------------------------------------------------
 -- a polynomial with coefficients in m has both components in J

 JJ (p : DN.Pair) : U l = J p.1 * J p.2 ;
 JJ-add (p q : DN.Pair) (h : JJ p) (k : JJ q) : JJ (DN.plusQ p q) = (J-add _ _ h.1 k.1,J-add _ _ h.2 k.2) ;
 J-iota (c : A.R) (hc : m c) (s : R) : J (mul (iota.1 c) s) = J-eq (mulC s (iota.1 c)) (J-scale s (iota.1 c) (J-m c hc)) ;
 J-zero-mul (s : R) : J (mul z s) = J-eq (sym (L.zero-mul s)) J-zero ;
 JJ-scale (c : A.R) (hc : m c) (p : DN.Pair) : JJ (DN.timesQ (DN.constant (iota.1 c)) p) =
  (J-add _ _ (J-iota c hc p.1) (J-zero-mul (mul z p.2)),J-add _ _ (J-iota c hc p.2) (J-zero-mul p.1)) ;
 JJ-psum (t' : DN.Pair) : (e : Nat) (c : Nat -> A.R) -> LoopStep[l].Below A m e c ->
  JJ (PowerSums[l].Over[DN.ring,t'].psum e (\ i -> DN.constant (iota.1 (c i)))) = split {
  zero -> \ c b -> (J-zero,J-zero) ;
  suc e | r -> \ c b -> JJ-add (DN.timesQ (DN.constant (iota.1 (c e))) (AffinePowers[l].Over[DN.ring].power t' e))
   (PowerSums[l].Over[DN.ring,t'].psum e (\ i -> DN.constant (iota.1 (c i))))
   (JJ-scale (c e) b.1 (AffinePowers[l].Over[DN.ring].power t' e)) (r c b.2) } ;
 inclusion-constant (c : A.R) : Id RX.Carrier (RX.inclusion.1 c) (RX.constant c) = refl (RX.constant c) ;
 Px-J (e : Nat) (c : Nat -> A.R) (b : LoopStep[l].Below A m e c) : JJ (evd.1 (Px e c)) =
  subst JJ (sym (trans (PowerSums[l].Map[RX.ring,DN.ring,evd,RX.variable].psum-map e (\ i -> RX.inclusion.1 (c i)))
                 (PowerSums[l].Over[DN.ring,evd.1 RX.variable].psum-cong e (\ i -> evd.1 (RX.inclusion.1 (c i))) (\ i -> DN.constant (iota.1 (c i)))
                   (\ i -> trans (ap evd.1 (inclusion-constant (c i))) (UPe.on-constants (c i))))))
   (JJ-psum (evd.1 RX.variable) e c b) ;

 ---------------------------------------------------------------------
 -- the Q' step

 -- X + Y = (Z + W) + P gives Z - X = Y - (W + P)
 solve (X Y Z W P : R) (h : Id R (add X Y) (add (add Z W) P)) : Id R (add Z (neg X)) (add Y (neg (add W P))) =
  trans (ap (\ t -> add t (neg X))
          (trans (sym (trans (ap (\ t -> add t (neg (add W P))) (sym (addA Z W P))) (L.add-neg-cancel Z (add W P))))
                 (ap (\ t -> add t (neg (add W P))) (sym h))))
   (trans (ap (\ t -> add t (neg X)) (sym (addA X Y (neg (add W P)))))
    (trans (ap (\ t -> add t (neg X)) (addC X (add Y (neg (add W P))))) (L.add-neg-cancel (add Y (neg (add W P))) X))) ;

 module Qprime (G Hp Up Q : RX.Carrier) (n e : Nat) (c : Nat -> A.R) (b : LoopStep[l].Below A m e c)
  (loop : Id RX.Carrier (RX.ring.mul (AffinePowers[l].Over[RX.ring].power G n) Hp) (RX.ring.add (RX.ring.mul Up Q) (Px e c)))
  (hQ : J (val Q)) (hH : J (val Hp)) (hH' : UnitMod (der Hp)) (hG : UnitMod (val G)) {
  gn : RX.Carrier = AffinePowers[l].Over[RX.ring].power G n ;
  -- the epsilon-components of the loop identity
  components : Id DN.Pair (DN.timesQ (evd.1 gn) (evd.1 Hp)) (DN.plusQ (DN.timesQ (evd.1 Up) (evd.1 Q)) (evd.1 (Px e c))) =
   trans (sym (evd.2.2.2 gn Hp))
    (trans (ap evd.1 loop) (trans (evd.2.2.1 (RX.ring.mul Up Q) (Px e c)) (ap (\ p -> DN.plusQ p (evd.1 (Px e c))) (evd.2.2.2 Up Q)))) ;
  epsilon : Id R (add (mul (val gn) (der Hp)) (mul (der gn) (val Hp)))
   (add (add (mul (val Up) (der Q)) (mul (der Up) (val Q))) (der (Px e c))) = ap (\ p -> p.2) components ;
  -- U(eta) Q'(eta) = G(eta)^n H'(eta) mod J
  difference : J (add (mul (val Up) (der Q)) (neg (mul (val gn) (der Hp)))) =
   J-eq (sym (solve _ _ _ _ _ epsilon))
    (J-add _ _ (J-scale (der gn) _ hH) (J-neg _ (J-add _ _ (J-scale (der Up) _ hQ) (Px-J e c b).2))) ;
  gn-val : Id R (val gn) (AP.power (val G) n) = AffinePowers[l].power-map RX.ring T valH G n ;
  unit-right : UnitMod (mul (val gn) (der Hp)) =
   unit-mod-mul (val gn) (der Hp) (subst UnitMod (sym gn-val) (unit-mod-power (val G) hG n)) hH' ;
  -- Q'(eta) is a unit mod J
  result : UnitMod (der Q) =
   unit-mod-factor (val Up) (der Q) (unit-mod-congr _ _ difference unit-right) ;
  -- so Q'(eta) is in no ideal q containing J with 1 not in q
  outside (q : R -> U l) (q-J : (a : R) -> J a -> q a) (q-add : (a c : R) -> q a -> q c -> q (add a c))
   (q-scale : (a c : R) -> q c -> q (mul a c)) (proper : Not (q o)) (h : q (der Q)) : Empty =
   proper (subst q
    (trans (ap (add (mul (der Q) result.1)) (L.negsub (mul (der Q) result.1) o))
     (trans (addA (mul (der Q) result.1) (neg (mul (der Q) result.1)) o) (trans (ap (\ t -> add t o) (addN (mul (der Q) result.1))) (L.zl o))))
    (q-add _ _ (subst q (mulC result.1 (der Q)) (q-scale result.1 (der Q) h))
      (subst q (trans (L.neg-mul-left o (add (mul (der Q) result.1) (neg o))) (ap neg (L.one-left (add (mul (der Q) result.1) (neg o)))))
        (q-scale (neg o) _ (q-J _ result.2))))) ;
 } ;
} ;
