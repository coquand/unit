-- zmt2-revised.tex, Section 4.1 (Localisation).  For t in R,
--   E = R[X]/(1 - X t)   and   (R[Y]/(Y))[1/t]
-- have the same points in every R-algebra C (with tau the image of t):
-- a point of E is an x with x tau = 1, that is, an inverse of tau, which is
-- unique; a point of the second algebra is Y = 0 together with tau
-- invertible.  The second algebra is standard etale (P = Y is monic and
-- P' = 1), so the one-element cover {1} of E suffices.  If tau = 0 (t in m,
-- C a k-algebra) a point gives 1 = 0: the special fibre is zero.
-- The statement is for an arbitrary commutative ring C and tau in C.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (C : CRing) (setC : Pr.isSet C.R) (tau : C.R) {
 open C ;
 module L = RL[C] ;
 module AR = AffineRing[l].Laws[C,setC] ;

 -- the points of E = R[X]/(1 - X t)
 PointE : U l = (x : R) * Id R (add o (neg (mul x tau))) z ;
 -- the points of the standard etale algebra (R[Y]/(Y))[1/t]
 PointStd : U l = (y : R) * Id R y z * L.unit tau ;

 -- 1 - w = 0 gives w = 1
 one-minus (w : R) (h : Id R (add o (neg w)) z) : Id R w o =
  sym (trans (L.neg-uniq (neg w) o (trans (addC (neg w) o) h)) (L.neg-neg w)) ;

 inverse-of (p : PointE) : L.unit tau = (p.1,trans (mulC tau p.1) (one-minus (mul p.1 tau) p.2)) ;
 forward (p : PointE) : PointStd = (z,refl z,inverse-of p) ;
 backward (q : PointStd) : PointE =
  (q.2.2.1,trans (ap (\ w -> add o (neg w)) (trans (mulC q.2.2.1 tau) q.2.2.2)) (addN o)) ;

 fiberE-prop (x : R) : Pr.isProp (Id R (add o (neg (mul x tau))) z) = setC _ _ ;
 fiberStd-prop (y : R) : Pr.isProp (Id R y z * L.unit tau) =
  Pr.isProp-Sigma (Id R y z) (\ h -> L.unit tau) (setC y z) (\ h -> AR.unit-prop tau) ;

 fb (q : PointStd) : Id PointStd (forward (backward q)) q =
  Pr.Sigma-eq R (\ y -> Id R y z * L.unit tau) z q.1 (forward (backward q)).2 q.2
   (sym q.2.1) (fiberStd-prop q.1) ;
 bf (p : PointE) : Id PointE (backward (forward p)) p =
  Pr.Sigma-eq R (\ x -> Id R (add o (neg (mul x tau))) z) p.1 p.1 (backward (forward p)).2 p.2
   (refl p.1) (fiberE-prop p.1) ;
 equivalence : Pr.Equiv PointE PointStd = (forward,Pr.qinv PointE PointStd forward backward fb bf) ;

 -- zero special fibre
 zero-fibre (h0 : Id R tau z) (p : PointE) : Id R o z =
  trans (sym (one-minus (mul p.1 tau) p.2)) (trans (ap (mul p.1) h0) (L.mul-zero p.1)) ;
} ;
