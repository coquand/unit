-- Steps 5-6 of HANDOFF-LOOP.md.  Monic relation y^E = V_E a, and (from
-- LoopStep) y^d = V_d beta0 + x0 with x0 in m R[y].
-- Informal proof.
--  (5) For j < E (j = nat i, i : Fin E) LoopStep.powers gives
--        y^j = V_d beta_j + V_E mu_j ,  mu_j in m,
--      and V_E mu_j = sum_(i<E) iota(mu_j(i)) y^i.  So (I - mu) v = n with
--      v_i = y^(nat i), n_i = V_d beta_i, the matrix M_ji = delta_ji -
--      mu_i(nat j) over A.  det M = 1 mod m (ExteriorRelation with
--      a ~ c iff a - c in m), a unit by rad, and det(M) v_k = sum_i n_i
--      adj(M)_ik (adjugate; adj and det commute with iota).  Hence
--        y^(nat k) = V_d gamma_k ,  gamma_k = u sum_i adj(M)_ik beta_i .
--  (6) Every x = V_E mu in m R[y] is V_d(sum_i mu(nat i) gamma_i), again
--      with coefficients in m; and every y^j = V_d beta_j + V_E mu_j is
--      V_d(beta_j + sum_i mu_j(nat i) gamma_i).  j = d gives the new monic
--      relation of degree d.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
-- the index i : Fin e as a natural number (inr tt is the top index e - 1)
nat : (e : Nat) -> Ps.Fin e -> Nat = split {
 zero -> \ i -> efq i ;
 suc e | r -> split { inl i -> r i ; inr t -> e } } ;

module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (y : B.R)
 (E' : Nat) (a : Nat -> A.R) (rel : Id B.R (AffinePowers[l].Over[B].power y (suc E')) (MPart[l].Over[A,m,m-zero,m-add,m-scale,B,iota,y].V (suc E') a)) {
 open B ;
 module L = RL[B] ; module LA = RL[A] ;
 module LS = LoopStep[l].Over[A,m,m-zero,m-add,m-scale,dec,B,iota,y,E',a,rel] ;
 module MP = LS.MP ; module MM = LS.MM ; module PS = LS.PS ;
 module S = FiniteIdeal[l].Sums[B] ; module SA = FiniteIdeal[l].Sums[A] ;
 module DB = MnSums[l].Over[B] ; module DA = MnSums[l].Over[A] ;
 module DT = Determinant[l].Over[B,setB] ; module DTA = Determinant[l].Over[A,setA] ;
 module DTR = DeterminantTrick[l].Over[B,setB] ;
 module ADJ = Adjugate[l].Over[B,setB] ; module ADJA = Adjugate[l].Over[A,setA] ;
 module Iota = DeterminantLemma[l].Map[A,B,setA,setB,iota] ;
 open ExteriorModel[l].Over[B] ;
 E : Nat = LS.E ;
 V (e : Nat) (c : Nat -> A.R) : R = MP.V e c ;
 pw (j : Nat) : R = LS.pw j ;

 -- psum over Fin
 psum-fin : (e : Nat) (c : Nat -> R) -> Id R (PS.psum e c) (S.sum e (\ i -> mul (c (nat e i)) (pw (nat e i)))) = split {
  zero -> \ c -> refl z ;
  suc e | r -> \ c -> ap (add (mul (c e) (pw e))) (r c) } ;
 -- V of a finite sum of coefficient functions
 V-sum (d : Nat) : (n : Nat) (f : Ps.Fin n -> Nat -> A.R) -> Id R (V d (\ l -> SA.sum n (\ i -> f i l))) (S.sum n (\ i -> V d (f i))) = split {
  zero -> \ f -> MP.V-zero d ;
  suc n | r -> \ f -> trans (MP.V-add d (f (inr tt)) (\ l -> SA.sum n (\ i -> f (inl i) l))) (ap (add (V d (f (inr tt)))) (r (\ i -> f (inl i)))) } ;
 m-sum : (n : Nat) (f : Ps.Fin n -> A.R) -> ((i : Ps.Fin n) -> m (f i)) -> m (SA.sum n f) = split {
  zero -> \ f h -> m-zero ;
  suc n | r -> \ f h -> m-add _ _ (h (inr tt)) (r (\ i -> f (inl i)) (\ i -> h (inl i))) } ;

 ---------------------------------------------------------------------
 -- det M = 1 mod m

 m-eq {a c : A.R} (e : Id A.R a c) (h : m a) : m c = subst m e h ;
 m-neg (a : A.R) (h : m a) : m (A.neg a) =
  m-eq (trans (LA.neg-mul-left A.o a) (ap A.neg (LA.one-left a))) (m-scale (A.neg A.o) a h) ;
 Cong (k : Nat) (a c : A.R) : U l = m (A.add a (A.neg c)) ;
 c-zero (k : Nat) : Cong k A.z A.z = m-eq (sym (A.addN A.z)) m-zero ;
 c-add (k : Nat) (a a' c c' : A.R) (h : Cong k a c) (h' : Cong k a' c') : Cong k (A.add a a') (A.add c c') =
  m-eq (trans (LA.swap a (A.neg c) a' (A.neg c')) (ap (A.add (A.add a a')) (sym (LA.neg-add c c')))) (m-add _ _ h h') ;
 c-neg (k : Nat) (a c : A.R) (h : Cong k a c) : Cong k (A.neg a) (A.neg c) =
  m-eq (trans (LA.negsub a c) (ap (A.add (A.neg a)) (sym (LA.neg-neg c)))) (m-neg _ h) ;
 c-one : Cong zero A.o A.o = m-eq (sym (A.addN A.o)) m-zero ;
 -- (p - u) + (u - w) = p - w
 telescope (p u w : A.R) : Id A.R (A.add (A.add p (A.neg u)) (A.add u (A.neg w))) (A.add p (A.neg w)) =
  trans (sym (A.addA p (A.neg u) (A.add u (A.neg w))))
   (ap (A.add p) (trans (A.addA (A.neg u) u (A.neg w)) (trans (ap (\ t -> A.add t (A.neg w)) (LA.neg-cancel u)) (LA.zl (A.neg w))))) ;
 c-mul (k : Nat) (a a' c c' : A.R) (h : Cong k a c) (h' : Cong (suc zero) a' c') : Cong (suc k) (A.mul a a') (A.mul c c') =
  m-eq (trans (Ps.cong2 A.R A.add _ _ _ _
          (trans (A.dist a a' (A.neg c')) (ap (A.add (A.mul a a')) (LA.mul-neg a c')))
          (trans (A.dist c' a (A.neg c)) (Ps.cong2 A.R A.add _ _ _ _ (A.mulC c' a) (trans (LA.mul-neg c' c) (ap A.neg (A.mulC c' c))))))
         (telescope (A.mul a a') (A.mul a c') (A.mul c c')))
   (m-add _ _ (m-scale a _ h') (m-scale c' _ h)) ;
 module ER = ExteriorRelation[l].Over[A,A,Cong,c-zero,c-add,c-neg,c-one,c-mul] ;

 ---------------------------------------------------------------------
 -- (5), (6)

 module At (d : Nat) (beta0 : Nat -> A.R) (x0 : R) (x0-in : MP.InM E x0) (h0 : Id R (pw d) (add (V d beta0) x0)) {
  s (j : Nat) : LS.PowerSpan[d,beta0,x0,x0-in,h0].SpanM (pw j) = LS.powers d beta0 x0 x0-in h0 j ;
  beta (j : Nat) : Nat -> A.R = (s j).1 ;
  xm (j : Nat) : R = (s j).2.1 ;
  mu (j : Nat) : Nat -> A.R = (s j).2.2.1.1 ;
  mu-m (j i : Nat) : m (mu j i) = (s j).2.2.1.2.1 i ;
  xm-eq (j : Nat) : Id R (xm j) (V E (mu j)) = (s j).2.2.1.2.2 ;
  s-eq (j : Nat) : Id R (pw j) (add (V d (beta j)) (xm j)) = (s j).2.2.2 ;
  v (i : Ps.Fin E) : R = pw (nat E i) ;
  Mt (j i : Ps.Fin E) : A.R = A.add (DA.delta E j i) (A.neg (mu (nat E i) (nat E j))) ;
  MB (j i : Ps.Fin E) : R = iota.1 (Mt j i) ;
  detA : A.R = ExteriorModel[l].Over[A].det E Mt ;

  -- V_E mu_k = sum_j v_j iota(mu_k(nat j))
  m-part (k : Nat) : Id R (xm k) (S.lin E v (\ j -> iota.1 (mu k (nat E j)))) =
   trans (xm-eq k) (trans (psum-fin E (\ i -> iota.1 (mu k i)))
    (S.sum-cong E (\ j -> mul (iota.1 (mu k (nat E j))) (v j)) (\ j -> mul (v j) (iota.1 (mu k (nat E j))))
      (\ j -> mulC (iota.1 (mu k (nat E j))) (v j)))) ;
  entry (j i : Ps.Fin E) : Id R (MB j i) (add (DB.delta E j i) (neg (iota.1 (mu (nat E i) (nat E j))))) =
   trans (iota.2.2.1 (DA.delta E j i) (A.neg (mu (nat E i) (nat E j))))
    (Ps.cong2 R add _ _ _ _ (Iota.delta-map E j i) (H.negation A B iota (mu (nat E i) (nat E j)))) ;
  -- (I - mu) v = n
  system (i : Ps.Fin E) : Id R (DT.act E MB v i) (V d (beta (nat E i))) = calc R {
   S.sum E (\ j -> mul (v j) (MB j i))
    =< S.sum-cong E (\ j -> mul (v j) (MB j i)) (\ j -> mul (v j) (add (DB.delta E j i) (neg (iota.1 (mu (nat E i) (nat E j))))))
         (\ j -> ap (mul (v j)) (entry j i))
     > S.lin E v (\ j -> add (DB.delta E j i) (neg (iota.1 (mu (nat E i) (nat E j)))))
    =< S.lin-add E v (\ j -> DB.delta E j i) (\ j -> neg (iota.1 (mu (nat E i) (nat E j))))
     > add (S.lin E v (\ j -> DB.delta E j i)) (S.lin E v (\ j -> neg (iota.1 (mu (nat E i) (nat E j)))))
    =< Ps.cong2 R add _ _ _ _ (DB.sum-delta-right E i v)
         (trans (S.lin-neg E v (\ j -> iota.1 (mu (nat E i) (nat E j)))) (ap neg (sym (m-part (nat E i)))))
     > add (v i) (neg (xm (nat E i)))
    =< ap (\ t -> add t (neg (xm (nat E i)))) (s-eq (nat E i)) > add (add (V d (beta (nat E i))) (xm (nat E i))) (neg (xm (nat E i)))
    =< L.add-neg-cancel (V d (beta (nat E i))) (xm (nat E i)) > V d (beta (nat E i)) } ;
  det-times (k : Ps.Fin E) : Id R (mul (det E MB) (v k)) (DT.act E (ADJ.adj E MB) (\ i -> V d (beta (nat E i))) k) = calc R {
   mul (det E MB) (v k)
    =< sym (DTR.act-scalar E (det E MB) v k) > DT.act E (\ j i -> mul (det E MB) (DB.delta E j i)) v k
    =< ap (\ N -> DT.act E N v k) (sym (ADJ.adj-mul-mat E MB)) > DT.act E (DT.mmul E (ADJ.adj E MB) MB) v k
    =< DTR.act-mmul E (ADJ.adj E MB) MB v k > DT.act E (ADJ.adj E MB) (DT.act E MB v) k
    =< ap (\ w -> DT.act E (ADJ.adj E MB) w k) (F.funext (Ps.Fin E) (\ i -> R) (DT.act E MB v) (\ i -> V d (beta (nat E i))) system)
     > DT.act E (ADJ.adj E MB) (\ i -> V d (beta (nat E i))) k } ;

  -- det M = 1 mod m, hence a unit
  entry-cong (j i : Ps.Fin E) : Cong (suc zero) (Mt j i) (DA.delta E j i) =
   m-eq (sym (trans (ap (\ t -> A.add t (A.neg (DA.delta E j i))) (A.addC (DA.delta E j i) (A.neg (mu (nat E i) (nat E j)))))
                (LA.add-neg-cancel (A.neg (mu (nat E i) (nat E j))) (DA.delta E j i))))
    (m-neg _ (mu-m (nat E i) (nat E j))) ;
  det-cong : m (A.add detA (A.neg A.o)) =
   m-eq (ap (\ t -> A.add detA (A.neg t)) (DTA.det-id E)) (ER.det E Mt (\ j i -> DA.delta E j i) entry-cong) ;
  det-unit : LA.unit detA =
   subst LA.unit
    (trans (ap (A.add A.o) (LA.neg-neg (A.add detA (A.neg A.o))))
     (trans (LA.add-swap A.o detA (A.neg A.o)) (trans (ap (A.add detA) (A.addN A.o)) (A.addZ detA))))
    (rad (A.neg (A.add detA (A.neg A.o))) (m-neg _ det-cong)) ;
  ui : A.R = det-unit.1 ;
  gamma (k : Ps.Fin E) (l : Nat) : A.R = A.mul ui (SA.sum E (\ i -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l))) ;
  -- iota(det M) v_k = V_d(sum_i adj_ik beta_i)
  scaled (k : Ps.Fin E) : Id R (mul (iota.1 detA) (v k)) (V d (\ l -> SA.sum E (\ i -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l)))) = calc R {
   mul (iota.1 detA) (v k)
    =< ap (\ t -> mul t (v k)) (Iota.NT.det-nat E Mt) > mul (det E MB) (v k)
    =< det-times k > S.sum E (\ i -> mul (V d (beta (nat E i))) (ADJ.adj E MB i k))
    =< S.sum-cong E (\ i -> mul (V d (beta (nat E i))) (ADJ.adj E MB i k))
         (\ i -> V d (\ l -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l)))
         (\ i -> trans (ap (mul (V d (beta (nat E i)))) (sym (Iota.adj-map E Mt i k)))
                  (trans (mulC (V d (beta (nat E i))) (iota.1 (ADJA.adj E Mt i k)))
                   (sym (MP.V-scale d (ADJA.adj E Mt i k) (beta (nat E i))))))
     > S.sum E (\ i -> V d (\ l -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l)))
    =< sym (V-sum d E (\ i l -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l)))
     > V d (\ l -> SA.sum E (\ i -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l))) } ;
  value (k : Ps.Fin E) : Id R (v k) (V d (gamma k)) = calc R {
   v k
    =< sym (trans (mulA (iota.1 ui) (iota.1 detA) (v k))
         (trans (ap (\ t -> mul t (v k)) (trans (sym (iota.2.2.2 ui detA)) (trans (ap iota.1 (trans (A.mulC ui detA) det-unit.2)) iota.2.1)))
          (L.one-left (v k))))
     > mul (iota.1 ui) (mul (iota.1 detA) (v k))
    =< ap (mul (iota.1 ui)) (scaled k) > mul (iota.1 ui) (V d (\ l -> SA.sum E (\ i -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l))))
    =< sym (MP.V-scale d ui (\ l -> SA.sum E (\ i -> A.mul (ADJA.adj E Mt i k) (beta (nat E i) l)))) > V d (gamma k) } ;

  -- (6) moving m R[y] and the powers of y to degree d
  moved (mu' : Nat -> A.R) (l : Nat) : A.R = SA.sum E (\ i -> A.mul (mu' (nat E i)) (gamma i l)) ;
  transfer (x : R) (h : MP.InM E x) : Id R x (V d (moved h.1)) = calc R {
   x
    =< trans h.2.2 (psum-fin E (\ i -> iota.1 (h.1 i))) > S.sum E (\ i -> mul (iota.1 (h.1 (nat E i))) (v i))
    =< S.sum-cong E (\ i -> mul (iota.1 (h.1 (nat E i))) (v i)) (\ i -> V d (\ l -> A.mul (h.1 (nat E i)) (gamma i l)))
         (\ i -> trans (ap (mul (iota.1 (h.1 (nat E i)))) (value i)) (sym (MP.V-scale d (h.1 (nat E i)) (gamma i))))
     > S.sum E (\ i -> V d (\ l -> A.mul (h.1 (nat E i)) (gamma i l)))
    =< sym (V-sum d E (\ i l -> A.mul (h.1 (nat E i)) (gamma i l))) > V d (moved h.1) } ;
  transfer-in (x : R) (h : MP.InM E x) : MP.InM d x =
   (moved h.1,
    \ l -> m-sum E (\ i -> A.mul (h.1 (nat E i)) (gamma i l))
            (\ i -> m-eq (A.mulC (gamma i l) (h.1 (nat E i))) (m-scale (gamma i l) (h.1 (nat E i)) (h.2.1 (nat E i)))),
    transfer x h) ;
  -- the new monic relation, of degree d
  new-a (l : Nat) : A.R = A.add (beta d l) (moved (mu d) l) ;
  new-rel : Id R (pw d) (V d new-a) =
   trans (s-eq d) (trans (ap (add (V d (beta d))) (transfer (xm d) (mu d,mu-m d,xm-eq d))) (sym (MP.V-add d (beta d) (moved (mu d))))) ;
 } ;
} ;
