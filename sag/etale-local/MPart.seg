-- Lemma B of HANDOFF-LOOP.md.  A commutative with an ideal m (given by its
-- closure properties), B an A-algebra (iota), y in B, and
--   V_e c = sum_(i<e) iota(c_i) y^i ,
--   InM e x : x = V_e mu for some mu with every mu_i in m
-- (x is in m R[y], written in the basis 1, .., y^(e-1)).
-- Informal content.  InM e is closed under 0, +, iota(r) . and -.  Given
-- a monic relation y^e = V_e a (e = e' + 1) it is closed under y . :
--   y V_e mu = iota(mu_e') y^e + V_e(shift mu) = V_e(shift mu + mu_e' a),
-- and so iota(c) y^i is in InM e for c in m and every i (induction on i,
-- from iota(c) = V_e(point c)).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Over (A : CRing) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (B : CRing) (iota : H.Hom A B) (y : B.R) {
 open B ;
 module L = RL[B] ;
 module PS = PowerSums[l].Over[B,y] ;
 module CA = PowerSums[l].Coef[A] ;
 module CB = PowerSums[l].Coef[B] ;
 V (e : Nat) (c : Nat -> A.R) : R = PS.psum e (\ i -> iota.1 (c i)) ;
 InM (e : Nat) (x : R) : U l = (mu : Nat -> A.R) * ((i : Nat) -> m (mu i)) * Id R x (V e mu) ;

 -- V is linear
 V-zero (e : Nat) : Id R (V e (\ i -> A.z)) z =
  trans (PS.psum-cong e (\ i -> iota.1 A.z) (\ i -> z) (\ i -> H.zero A B iota)) (PS.psum-zero e) ;
 V-add (e : Nat) (c c' : Nat -> A.R) : Id R (V e (\ i -> A.add (c i) (c' i))) (add (V e c) (V e c')) =
  trans (PS.psum-cong e (\ i -> iota.1 (A.add (c i) (c' i))) (\ i -> add (iota.1 (c i)) (iota.1 (c' i))) (\ i -> iota.2.2.1 (c i) (c' i)))
   (PS.psum-add e (\ i -> iota.1 (c i)) (\ i -> iota.1 (c' i))) ;
 V-scale (e : Nat) (r : A.R) (c : Nat -> A.R) : Id R (V e (\ i -> A.mul r (c i))) (mul (iota.1 r) (V e c)) =
  trans (PS.psum-cong e (\ i -> iota.1 (A.mul r (c i))) (\ i -> mul (iota.1 r) (iota.1 (c i))) (\ i -> iota.2.2.2 r (c i)))
   (PS.psum-scale (iota.1 r) e (\ i -> iota.1 (c i))) ;
 V-shift (c : Nat -> A.R) : (i : Nat) -> Id R (iota.1 (CA.shift c i)) (CB.shift (\ j -> iota.1 (c j)) i) = split {
  zero -> H.zero A B iota ; suc i -> refl (iota.1 (c i)) } ;
 V-point (e' : Nat) (f : A.R) : Id R (V (suc e') (CA.point f)) (iota.1 f) =
  trans (PS.psum-cong (suc e') (\ i -> iota.1 (CA.point f i)) (CB.point (iota.1 f)) point-map) (PS.psum-point (iota.1 f) e')
  where { point-map : (i : Nat) -> Id R (iota.1 (CA.point f i)) (CB.point (iota.1 f) i) = split {
           zero -> refl (iota.1 f) ; suc i -> H.zero A B iota } } ;

 shift-m (mu : Nat -> A.R) (h : (i : Nat) -> m (mu i)) : (i : Nat) -> m (CA.shift mu i) = split {
  zero -> m-zero ; suc i -> h i } ;
 point-m (f : A.R) (h : m f) : (i : Nat) -> m (CA.point f i) = split {
  zero -> h ; suc i -> m-zero } ;

 in-zero (e : Nat) : InM e z = (\ i -> A.z,\ i -> m-zero,sym (V-zero e)) ;
 in-add (e : Nat) (x x' : R) (h : InM e x) (h' : InM e x') : InM e (add x x') =
  (\ i -> A.add (h.1 i) (h'.1 i),\ i -> m-add (h.1 i) (h'.1 i) (h.2.1 i) (h'.2.1 i),
   trans (Ps.cong2 R add _ _ _ _ h.2.2 h'.2.2) (sym (V-add e h.1 h'.1))) ;
 in-scale (e : Nat) (r : A.R) (x : R) (h : InM e x) : InM e (mul (iota.1 r) x) =
  (\ i -> A.mul r (h.1 i),\ i -> m-scale r (h.1 i) (h.2.1 i),
   trans (ap (mul (iota.1 r)) h.2.2) (sym (V-scale e r h.1))) ;
 in-neg (e : Nat) (x : R) (h : InM e x) : InM e (neg x) =
  subst (InM e)
   (trans (ap (\ v -> mul v x) (H.negation A B iota A.o))
    (trans (L.neg-mul-left (iota.1 A.o) x) (ap neg (trans (ap (\ v -> mul v x) iota.2.1) (L.one-left x)))))
   (in-scale e (A.neg A.o) x h) ;

 -- a monic relation y^e = V_e a
 module Monic (e' : Nat) (a : Nat -> A.R) (rel : Id R (PS.AP.power y (suc e')) (V (suc e') a)) {
  e : Nat = suc e' ;
  -- y V_e mu = V_e(shift mu + mu_e' a)
  y-times (mu : Nat -> A.R) : Id R (mul y (V e mu)) (V e (\ i -> A.add (CA.shift mu i) (A.mul (mu e') (a i)))) = calc R {
   mul y (V e mu)
    =< PS.psum-shift e (\ i -> iota.1 (mu i)) > PS.psum (suc e) (CB.shift (\ i -> iota.1 (mu i)))
    =< Ps.cong2 R add _ _ _ _ (trans (ap (mul (iota.1 (mu e'))) rel) (sym (V-scale e (mu e') a)))
         (sym (PS.psum-cong e (\ i -> iota.1 (CA.shift mu i)) (CB.shift (\ i -> iota.1 (mu i))) (V-shift mu)))
     > add (V e (\ i -> A.mul (mu e') (a i))) (V e (CA.shift mu))
    =< addC (V e (\ i -> A.mul (mu e') (a i))) (V e (CA.shift mu))
     > add (V e (CA.shift mu)) (V e (\ i -> A.mul (mu e') (a i)))
    =< sym (V-add e (CA.shift mu) (\ i -> A.mul (mu e') (a i))) > V e (\ i -> A.add (CA.shift mu i) (A.mul (mu e') (a i))) } ;
  in-y (x : R) (h : InM e x) : InM e (mul y x) =
   (\ i -> A.add (CA.shift h.1 i) (A.mul (h.1 e') (a i)),
    \ i -> m-add _ _ (shift-m h.1 h.2.1 i) (subst m (A.mulC (a i) (h.1 e')) (m-scale (a i) (h.1 e') (h.2.1 e'))),
    trans (ap (mul y) h.2.2) (y-times h.1)) ;
  -- iota(c) y^i is in InM e for c in m
  in-power (c : A.R) (hc : m c) : (i : Nat) -> InM e (mul (iota.1 c) (PS.AP.power y i)) = split {
   zero -> (CA.point c,point-m c hc,trans (mulO (iota.1 c)) (sym (V-point e' c))) ;
   suc i | r -> subst (InM e) (L.mul-swap y (iota.1 c) (PS.AP.power y i)) (in-y (mul (iota.1 c) (PS.AP.power y i)) r) } ;
 } ;
} ;
