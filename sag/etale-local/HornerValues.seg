-- Values of coefficient lists at t in an A-algebra T (Horner form,
-- MonicReduce.Horner), as the Introduction uses them.
-- (1) The value of a sum, a product, a constant list is the sum, the
--     product, the constant: the value of fs is ev(class of fs)
--     (LoopInputs.ev-horner, horner-include), and the class of addP / pmul
--     is the sum / product (PolynomialRing Add.beta, Multiply.beta).
-- (2) A ring map phi : T -> T' of A-algebras sends the value at t to the
--     value at phi(t) (induction on the list).
-- (3) Congruence: if t - t' is in an ideal K of T then so is
--     fs(t) - fs(t'); induction, by
--       (c + t F) - (c + t' F') = t (F - F') + (t - t') F'.
-- (4) X |-> X + 1: sh(c :: fs) = c + (1 + X) sh(fs) has sh(fs)(t) =
--     fs(t1) for t1 = t + 1, by (1).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
-- the list of F(X + 1)
module Shifts (A : CRing) {
 module MR = Mul[l].MulR[A] ;
 sh : List A.R -> List A.R = split {
  nil -> nil ; cons c fs | r -> MR.addP (cons c nil) (MR.pmul (cons A.o (cons A.o nil)) r) } ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (T : CRing) (setT : Pr.isSet T.R) (kappa : H.Hom A T) (t : T.R) {
 open T ;
 module L = RL[T] ;
 module LI = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,T,setT,kappa,t] ;
 module MR = Mul[l].MulR[A] ;
 -- (1)
 value-class (fs : List A.R) : Id R (LI.Hb.horner fs) (LI.ev.1 (LI.RX.include fs)) =
  trans (sym (LI.ev-horner fs)) (ap LI.ev.1 (LI.horner-include fs)) ;
 horner-add (p q : List A.R) : Id R (LI.Hb.horner (MR.addP p q)) (add (LI.Hb.horner p) (LI.Hb.horner q)) = calc R {
  LI.Hb.horner (MR.addP p q)
   =< value-class (MR.addP p q) > LI.ev.1 (LI.RX.include (MR.addP p q))
   =< ap LI.ev.1 (sym (LI.RX.Add.beta p q)) > LI.ev.1 (LI.RX.addQ (LI.RX.include p) (LI.RX.include q))
   =< LI.ev.2.2.1 (LI.RX.include p) (LI.RX.include q) > add (LI.ev.1 (LI.RX.include p)) (LI.ev.1 (LI.RX.include q))
   =< Ps.cong2 R add _ _ _ _ (sym (value-class p)) (sym (value-class q)) > add (LI.Hb.horner p) (LI.Hb.horner q) } ;
 horner-mul (p q : List A.R) : Id R (LI.Hb.horner (MR.pmul p q)) (mul (LI.Hb.horner p) (LI.Hb.horner q)) = calc R {
  LI.Hb.horner (MR.pmul p q)
   =< value-class (MR.pmul p q) > LI.ev.1 (LI.RX.include (MR.pmul p q))
   =< ap LI.ev.1 (sym (LI.RX.Multiply.beta p q)) > LI.ev.1 (LI.RX.mulQ (LI.RX.include p) (LI.RX.include q))
   =< LI.ev.2.2.2 (LI.RX.include p) (LI.RX.include q) > mul (LI.ev.1 (LI.RX.include p)) (LI.ev.1 (LI.RX.include q))
   =< Ps.cong2 R mul _ _ _ _ (sym (value-class p)) (sym (value-class q)) > mul (LI.Hb.horner p) (LI.Hb.horner q) } ;
 horner-constant (c : A.R) : Id R (LI.Hb.horner (cons c nil)) (kappa.1 c) =
  trans (ap (add (kappa.1 c)) (L.mul-zero t)) (addZ (kappa.1 c)) ;

 -- (2) a map of A-algebras
 module Map (T' : CRing) (kappa' : H.Hom A T') (phi : H.Hom T T')
  (compat : (a : A.R) -> Id T'.R (phi.1 (kappa.1 a)) (kappa'.1 a)) {
  module Hb' = MonicReduce[l].Horner[A,T',kappa',phi.1 t] ;
  horner-map : (fs : List A.R) -> Id T'.R (phi.1 (LI.Hb.horner fs)) (Hb'.horner fs) = split {
   nil -> H.zero T T' phi ;
   cons f fs | r -> trans (phi.2.2.1 (kappa.1 f) (mul t (LI.Hb.horner fs)))
    (Ps.cong2 T'.R T'.add _ _ _ _ (compat f) (trans (phi.2.2.2 t (LI.Hb.horner fs)) (ap (T'.mul (phi.1 t)) r))) } ;
 } ;

 -- (3) values at points congruent modulo an ideal K
 module Congruence (K : R -> U l) (K-zero : K z) (K-add : (a c : R) -> K a -> K c -> K (add a c))
  (K-scale : (a c : R) -> K c -> K (mul a c)) (t' : R) (ht : K (add t (neg t'))) {
  module Hb' = MonicReduce[l].Horner[A,T,kappa,t'] ;
  K-eq {a c : R} (e : Id R a c) (h : K a) : K c = subst K e h ;
  -- (c + t F) - (c + t' F') = t (F - F') + (t - t') F'
  step (c f f' : R) : Id R (add (mul t (add f (neg f'))) (mul (add t (neg t')) f')) (add (add c (mul t f)) (neg (add c (mul t' f')))) = calc R {
   add (mul t (add f (neg f'))) (mul (add t (neg t')) f')
    =< Ps.cong2 R add _ _ _ _ (trans (dist t f (neg f')) (ap (add (mul t f)) (L.mul-neg t f')))
        (trans (L.dist-left t (neg t') f') (ap (add (mul t f')) (L.neg-mul-left t' f')))
     > add (add (mul t f) (neg (mul t f'))) (add (mul t f') (neg (mul t' f')))
    =< sym (addA (mul t f) (neg (mul t f')) (add (mul t f') (neg (mul t' f'))))
     > add (mul t f) (add (neg (mul t f')) (add (mul t f') (neg (mul t' f'))))
    =< ap (add (mul t f)) (trans (addA (neg (mul t f')) (mul t f') (neg (mul t' f')))
         (trans (ap (\ u -> add u (neg (mul t' f'))) (L.neg-cancel (mul t f'))) (L.zl (neg (mul t' f')))))
     > add (mul t f) (neg (mul t' f'))
    =< sym (trans (ap (add (add c (mul t f))) (L.neg-add c (mul t' f')))
         (trans (L.swap c (mul t f) (neg c) (neg (mul t' f')))
          (trans (ap (\ u -> add u (add (mul t f) (neg (mul t' f')))) (addN c)) (L.zl (add (mul t f) (neg (mul t' f')))))))
     > add (add c (mul t f)) (neg (add c (mul t' f'))) } ;
  horner-cong : (fs : List A.R) -> K (add (LI.Hb.horner fs) (neg (Hb'.horner fs))) = split {
   nil -> K-eq (sym (addN z)) K-zero ;
   cons f fs | r -> K-eq (step (kappa.1 f) (LI.Hb.horner fs) (Hb'.horner fs))
     (K-add _ _ (K-scale t _ r) (K-eq (mulC (Hb'.horner fs) (add t (neg t'))) (K-scale (Hb'.horner fs) _ ht))) } ;
 } ;

 -- (4) X |-> X + 1
 module SL = Shifts[A] ;
 -- the value of 1 + X is t + 1
 one-plus : Id R (LI.Hb.horner (cons A.o (cons A.o nil))) (add t o) = calc R {
  add (kappa.1 A.o) (mul t (LI.Hb.horner (cons A.o nil)))
   =< Ps.cong2 R add _ _ _ _ kappa.2.1 (ap (mul t) (trans (horner-constant A.o) kappa.2.1)) > add o (mul t o)
   =< trans (ap (add o) (mulO t)) (addC o t) > add t o } ;
 -- the value of sh(fs) at t is the value of fs at t1 = t + 1
 module Shift (t1 : R) (h : Id R (add t o) t1) {
  module H1 = MonicReduce[l].Horner[A,T,kappa,t1] ;
  horner-sh : (fs : List A.R) -> Id R (LI.Hb.horner (SL.sh fs)) (H1.horner fs) = split {
   nil -> refl z ;
   cons c fs | r -> trans (horner-add (cons c nil) (MR.pmul (cons A.o (cons A.o nil)) (SL.sh fs)))
    (Ps.cong2 R add _ _ _ _ (horner-constant c)
      (trans (horner-mul (cons A.o (cons A.o nil)) (SL.sh fs)) (Ps.cong2 R mul _ _ _ _ (trans one-plus h) r))) } ;
 } ;
} ;
