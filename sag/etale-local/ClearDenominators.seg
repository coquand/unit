-- The certificate of Section 1 (note, lines 194-210), read in E_g.
-- B is the note's E_g: an A-algebra (A the note's R) with y in B and a
-- polynomial G, g = G(y), such that every x in B is r(y)/g^k
-- (Full: x g^k = r(y); E_g = R[y][1/g] by Lemma 2).
-- Claim: if x = sum_j iota(mu_j) t_j with mu_j in m (x in m B,
-- IdealGenerated), then g^K x = sum_j iota(mu_j) R_j(y) for some K and
-- polynomials R_j (Cleared x).
-- Proof, by induction on the list of generators (clear), one generator
-- at a time:  the empty sum is cleared with K = 0.  Given
-- g^K x = sum_j iota(mu_j) R_j(y) and a new generator (mu, t), write
-- t g^k = r(y) (Full); then
--   g^(k+K) (iota(mu) t + x)
--     = iota(mu) (g^K (t g^k)) + g^k (g^K x)
--     = iota(mu) (G^K r)(y) + sum_j iota(mu_j) (G^k R_j)(y)
-- since (G^e r)(y) = g^e r(y) (hb-product, from LoopInputs.product).
-- Applied to H(y) in m E_g this is LoopInputs.Section1's certificate
-- (G^n H)(y) = sum_j iota(mu_j) R_j(y) with n = K (Certificate.cert).
-- The note writes H(y) = sum_i mu_i r_i(y) / g^m in E_g and needs a
-- further g^l to read the equality in E; here the equality is used in
-- E_g itself (the loop runs in E_g, which S_0 maps to), so no l appears.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (y : B.R) {
 open B ;
 module L = RL[B] ;
 module LI = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iota,y] ;
 module IG = IdealGenerated[l].Over[A,m,B,iota] ;
 module Ls = IG.Ls ;
 module P = AffinePowers[l].Over[B] ;
 -- B = R[y][1/G(y)]: every x is r(y)/G(y)^k
 FullAt (G : List A.R) (x : R) : U l = (r : List A.R) * (k : Nat) * Id R (mul x (P.power (LI.Hb.horner G) k)) (LI.Hb.horner r) ;
 Full (G : List A.R) : U l = (x : R) -> FullAt G x ;
 -- Full as a mere property: every x is merely r(y)/G(y)^k
 FullT (G : List A.R) : U l = (x : R) -> Truncation[l].Trunc[FullAt G x].carrier ;
 module Clear (G : List A.R) {
  g : R = LI.Hb.horner G ;
  -- (G^n h)(y) = g^n h(y)
  hb-product (h : List A.R) (n : Nat) : Id R (LI.Hb.horner (LI.product G h n)) (mul (P.power g n) (LI.Hb.horner h)) = calc R {
   LI.Hb.horner (LI.product G h n)
    =< sym (LI.ev-horner (LI.product G h n)) > LI.ev.1 (LI.Ho.horner (LI.product G h n))
    =< ap LI.ev.1 (LI.product-horner G h n) > LI.ev.1 (LI.RX.ring.mul (AffinePowers[l].Over[LI.RX.ring].power (LI.Ho.horner G) n) (LI.Ho.horner h))
    =< LI.ev.2.2.2 (AffinePowers[l].Over[LI.RX.ring].power (LI.Ho.horner G) n) (LI.Ho.horner h)
     > mul (LI.ev.1 (AffinePowers[l].Over[LI.RX.ring].power (LI.Ho.horner G) n)) (LI.ev.1 (LI.Ho.horner h))
    =< Ps.cong2 R mul _ _ _ _
        (trans (AffinePowers[l].power-map LI.RX.ring B LI.ev (LI.Ho.horner G) n) (ap (\ t -> P.power t n) (LI.ev-horner G)))
        (LI.ev-horner h)
     > mul (P.power g n) (LI.Hb.horner h) } ;
  -- a polynomial generator iota(mu) R(y), mu in m
  PGen : U l = (mu : A.R) * (hm : m mu) * List A.R ;
  pvalue (p : PGen) : R = mul (iota.1 p.1) (LI.Hb.horner p.2.2) ;
  -- R |-> G^k R multiplies the value by g^k
  shift (k : Nat) (p : PGen) : PGen = (p.1,p.2.1,LI.product G p.2.2 k) ;
  pvalue-shift (k : Nat) (p : PGen) : Id R (pvalue (shift k p)) (mul (P.power g k) (pvalue p)) =
   trans (ap (mul (iota.1 p.1)) (hb-product p.2.2 k)) (L.mul-swap (iota.1 p.1) (P.power g k) (LI.Hb.horner p.2.2)) ;
  -- g^K x = sum_j iota(mu_j) R_j(y)
  Cleared (x : R) : U l = (K : Nat) * (qs : List PGen) * Id R (mul (P.power g K) x) (Ls.lsum pvalue qs) ;
  -- the new generator: g^K (t g^k) multiplied by iota(mu) is iota(mu) (G^K r)(y)
  first (mu t : R) (k K : Nat) : Id R (mul (mul (P.power g k) (P.power g K)) (mul mu t)) (mul mu (mul (P.power g K) (mul t (P.power g k)))) = calc R {
   mul (mul (P.power g k) (P.power g K)) (mul mu t)
    =< ap (\ v -> mul v (mul mu t)) (mulC (P.power g k) (P.power g K)) > mul (mul (P.power g K) (P.power g k)) (mul mu t)
    =< L.mul-four (P.power g K) (P.power g k) mu t > mul (mul (P.power g K) mu) (mul (P.power g k) t)
    =< sym (mulA (P.power g K) mu (mul (P.power g k) t)) > mul (P.power g K) (mul mu (mul (P.power g k) t))
    =< L.mul-swap (P.power g K) mu (mul (P.power g k) t) > mul mu (mul (P.power g K) (mul (P.power g k) t))
    =< ap (\ v -> mul mu (mul (P.power g K) v)) (mulC (P.power g k) t) > mul mu (mul (P.power g K) (mul t (P.power g k))) } ;
  -- one more generator (mu, t), with t g^k = r(y) and g^K x = sum_j iota(mu_j) R_j(y)
  step (mu : A.R) (hm : m mu) (t : R) (r : List A.R) (k : Nat) (e : Id R (mul t (P.power g k)) (LI.Hb.horner r))
   (x : R) (K : Nat) (qs : List PGen) (ec : Id R (mul (P.power g K) x) (Ls.lsum pvalue qs)) :
   Cleared (add (mul (iota.1 mu) t) x) =
   (plus k K,cons (mu,hm,LI.product G r K) (Ls.lmap (shift k) qs),
    calc R {
     mul (P.power g (plus k K)) (add (mul (iota.1 mu) t) x)
      =< ap (\ v -> mul v (add (mul (iota.1 mu) t) x)) (P.power-add g k K)
       > mul (mul (P.power g k) (P.power g K)) (add (mul (iota.1 mu) t) x)
      =< dist (mul (P.power g k) (P.power g K)) (mul (iota.1 mu) t) x
       > add (mul (mul (P.power g k) (P.power g K)) (mul (iota.1 mu) t)) (mul (mul (P.power g k) (P.power g K)) x)
      =< Ps.cong2 R add _ _ _ _
          (trans (first (iota.1 mu) t k K)
            (ap (mul (iota.1 mu)) (trans (ap (mul (P.power g K)) e) (sym (hb-product r K)))))
          (trans (sym (mulA (P.power g k) (P.power g K) x))
            (trans (ap (mul (P.power g k)) ec)
              (sym (Ls.lsum-scale pvalue (shift k) (P.power g k) (pvalue-shift k) qs))))
       > add (mul (iota.1 mu) (LI.Hb.horner (LI.product G r K))) (Ls.lsum pvalue (Ls.lmap (shift k) qs)) }) ;
  -- with Full merely: the same induction, under the truncation
  module CT = Truncation[l] ; module TC = TruncationCombinators[l] ;
  clearT (fullT : FullT G) : (ps : List IG.Gen) -> CT.Trunc[Cleared (Ls.lsum IG.value ps)].carrier = split {
   nil -> CT.Trunc[Cleared (Ls.lsum IG.value nil)].inc (zero,nil,L.mul-zero o) ;
   cons p ps | c -> TC.map2 (FullAt G p.2.2) (Cleared (Ls.lsum IG.value ps)) (Cleared (Ls.lsum IG.value (cons p ps)))
     (\ f c1 -> step p.1 p.2.1 p.2.2 f.1 f.2.1 f.2.2 (Ls.lsum IG.value ps) c1.1 c1.2.1 c1.2.2) (fullT p.2.2) c } ;
  module With (full : Full G) {
  clear : (ps : List IG.Gen) -> Cleared (Ls.lsum IG.value ps) = split {
   nil -> (zero,nil,L.mul-zero o) ;
   cons p ps | c -> step p.1 p.2.1 p.2.2 (full p.2.2).1 (full p.2.2).2.1 (full p.2.2).2.2 (Ls.lsum IG.value ps) c.1 c.2.1 c.2.2 } ;
  -- the certificate of LoopInputs.Section1 from H(y) in m B
  module Certificate (h : List A.R) (hH : IG.InmB (LI.Hb.horner h)) {
   c : Cleared (Ls.lsum IG.value hH.1) = clear hH.1 ;
   n : Nat = c.1 ;
   qs : List PGen = c.2.1 ;
   k : Nat = len qs ;
   mu (j : Ps.Fin k) : A.R = (Ls.at qs j).1 ;
   mu-m (j : Ps.Fin k) : m (mu j) = (Ls.at qs j).2.1 ;
   Rs (j : Ps.Fin k) : List A.R = (Ls.at qs j).2.2 ;
   cert : Id R (LI.Hb.horner (LI.product G h n)) (LI.S.sum k (\ j -> mul (iota.1 (mu j)) (LI.Hb.horner (Rs j)))) = calc R {
    LI.Hb.horner (LI.product G h n)
     =< hb-product h n > mul (P.power g n) (LI.Hb.horner h)
     =< ap (mul (P.power g n)) hH.2 > mul (P.power g n) (Ls.lsum IG.value hH.1)
     =< c.2.2 > Ls.lsum pvalue qs
     =< Ls.lsum-sum pvalue qs > LI.S.sum k (\ j -> mul (iota.1 (mu j)) (LI.Hb.horner (Rs j))) } ;
  } ;
  } ;
 } ;
} ;
