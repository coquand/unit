-- zmt2-revised.tex, Section 4.2 (Adding a simple root; Lombardi-Quitte).
-- P = aX^2 + bX + c and E = (R[X]/(P))[1/P'(x)].  We work in an arbitrary
-- commutative ring C with al, be, ga in C (for an R-algebra C, the images
-- of a, b, c): the statements are about the points of the algebras in C.
--
-- Notation (Horner forms of the polynomials of the note):
--   y = a x + b,   P(x) = x y + c,   D = P'(x) = 2 a x + b = a x + y,
--   s = y D,   F(Y) = Y (Y - b) + a c,   F'(Y) = 2Y - b = Y + (Y - b),
--   G(Y) = Y F'(Y).
-- Informal proof.
--  (1) If P(x) = 0 then x y = -c, F(y) = y (a x) + a c = a P(x) = 0, and
--      F'(y) = y + a x = D, so G(y) = s.  Thus x |-> y maps the points of
--      E[1/s] to those of S = (R[Y]/(F))[1/G(Y)].
--  (2) Conversely, if F(Y) = 0 and G(Y) is a unit, Y is a unit; put
--      xi = -c/Y.  From a c = -Y (Y - b): a xi = Y - b, so a xi + b = Y,
--      P(xi) = xi Y + c = 0, and s(xi) = Y ((Y - b) + Y) = G(Y).
--  (3) The composites are identities: Y |-> xi |-> a xi + b = Y, and
--      x |-> y |-> -c/y = x since x y = -c.
--  (4) S is standard etale: F is monic and F'(Y) divides G(Y).
--  (5) Chart 1: if a is a unit, P = a M with M = X (X + b/a) + c/a monic and
--      P' = a M', so E has the points of the standard etale (R[X]/(M))[1/M'].
--  (6) The charts cover E: D D = a x D + s (D = a x + y), so with D unit
--      1 = a x/D + s/D^2.
--  (7) Y must be inverted: if c = 0 and b is a unit, Y = 0 is a point of
--      (R[Y]/(F))[1/F'], but not the image y of a point of E[1/s] unless
--      1 = 0, since y is a unit there.  (R = Z, P = 2X^2 + X in the note.)
-- The discussion of a prime q with a in q is not formalised here.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (C : CRing) (setC : Pr.isSet C.R) (al be ga : C.R) {
 open C ;
 module L = RL[C] ;
 module AR = AffineRing[l].Laws[C,setC] ;

 ---------------------------------------------------------------------
 -- the polynomials

 y (x : R) : R = add (mul al x) be ;
 P (x : R) : R = add (mul x (y x)) ga ;
 D (x : R) : R = add (mul al x) (y x) ;
 s (x : R) : R = mul (y x) (D x) ;
 F (t : R) : R = add (mul t (add t (neg be))) (mul al ga) ;
 dF (t : R) : R = add t (add t (neg be)) ;
 G (t : R) : R = mul t (dF t) ;

 -- D is the derivative 2 a x + b
 D-formula (x : R) : Id R (D x) (add (mul (add o o) (mul al x)) be) =
  trans (addA (mul al x) (mul al x) be)
   (ap (\ w -> add w be)
     (sym (trans (L.dist-left o o (mul al x)) (Ps.cong2 R add _ _ _ _ (L.one-left (mul al x)) (L.one-left (mul al x)))))) ;

 ---------------------------------------------------------------------
 -- ring lemmas

 -- u + v = 0 gives u = -v
 eq-neg (u v : R) (h : Id R (add u v) z) : Id R u (neg v) =
  sym (trans (ap neg (L.neg-uniq u v h)) (L.neg-neg u)) ;
 -- (u - v) + v = u
 minus-plus (u v : R) : Id R (add (add u (neg v)) v) u =
  trans (sym (addA u (neg v) v)) (trans (ap (add u) (L.neg-cancel v)) (addZ u)) ;
 -- (-u) (-v) = u v
 neg-neg-mul (u v : R) : Id R (mul (neg u) (neg v)) (mul u v) =
  trans (L.neg-mul-left u (neg v)) (trans (ap neg (L.mul-neg u v)) (L.neg-neg (mul u v))) ;

 ---------------------------------------------------------------------
 -- (1) from x to y

 y-minus (x : R) : Id R (add (y x) (neg be)) (mul al x) = L.add-neg-cancel (mul al x) be ;
 xy (x : R) (h : Id R (P x) z) : Id R (mul x (y x)) (neg ga) = eq-neg (mul x (y x)) ga h ;
 F-root (x : R) (h : Id R (P x) z) : Id R (F (y x)) z = calc R {
  F (y x)
   =< ap (\ w -> add (mul (y x) w) (mul al ga)) (y-minus x) > add (mul (y x) (mul al x)) (mul al ga)
   =< ap (\ w -> add w (mul al ga)) (trans (L.mul-swap (y x) al x) (ap (mul al) (mulC (y x) x)))
    > add (mul al (mul x (y x))) (mul al ga)
   =< sym (dist al (mul x (y x)) ga) > mul al (P x)
   =< ap (mul al) h > mul al z
   =< L.mul-zero al > z } ;
 dF-y (x : R) : Id R (dF (y x)) (D x) = trans (ap (add (y x)) (y-minus x)) (addC (y x) (mul al x)) ;
 G-y (x : R) : Id R (G (y x)) (s x) = ap (mul (y x)) (dF-y x) ;

 ---------------------------------------------------------------------
 -- the points

 -- E[1/s]
 PointEs : U l = (x : R) * Id R (P x) z * L.unit (s x) ;
 -- S = (R[Y]/(F))[1/G(Y)]
 PointS : U l = (t : R) * Id R (F t) z * L.unit (G t) ;

 fiberEs-prop (x : R) : Pr.isProp (Id R (P x) z * L.unit (s x)) =
  Pr.isProp-Sigma (Id R (P x) z) (\ h -> L.unit (s x)) (setC (P x) z) (\ h -> AR.unit-prop (s x)) ;
 fiberS-prop (t : R) : Pr.isProp (Id R (F t) z * L.unit (G t)) =
  Pr.isProp-Sigma (Id R (F t) z) (\ h -> L.unit (G t)) (setC (F t) z) (\ h -> AR.unit-prop (G t)) ;
 extEs (p q : PointEs) (h : Id R p.1 q.1) : Id PointEs p q =
  Pr.Sigma-eq R (\ x -> Id R (P x) z * L.unit (s x)) p.1 q.1 p.2 q.2 h (fiberEs-prop q.1) ;
 extS (p q : PointS) (h : Id R p.1 q.1) : Id PointS p q =
  Pr.Sigma-eq R (\ t -> Id R (F t) z * L.unit (G t)) p.1 q.1 p.2 q.2 h (fiberS-prop q.1) ;

 forward (p : PointEs) : PointS =
  (y p.1,F-root p.1 p.2.1,subst L.unit (sym (G-y p.1)) p.2.2) ;

 ---------------------------------------------------------------------
 -- (2) from Y to xi = -c/Y

 module Back (p : PointS) {
  t : R = p.1 ;
  w : R = add t (neg be) ;
  ut : L.unit t = AR.unit-left t (dF t) p.2.2 ;
  ti : R = ut.1 ;
  xi : R = neg (mul ga ti) ;
  -- a c = -Y (Y - b)
  ac : Id R (mul al ga) (neg (mul t w)) = L.neg-uniq (mul t w) (mul al ga) p.2.1 ;
  al-xi : Id R (mul al xi) w = calc R {
   mul al xi
    =< L.mul-neg al (mul ga ti) > neg (mul al (mul ga ti))
    =< ap neg (mulA al ga ti) > neg (mul (mul al ga) ti)
    =< ap (\ v -> neg (mul v ti)) ac > neg (mul (neg (mul t w)) ti)
    =< ap neg (L.neg-mul-left (mul t w) ti) > neg (neg (mul (mul t w) ti))
    =< L.neg-neg (mul (mul t w) ti) > mul (mul t w) ti
    =< ap (\ v -> mul v ti) (mulC t w) > mul (mul w t) ti
    =< sym (mulA w t ti) > mul w (mul t ti)
    =< ap (mul w) ut.2 > mul w o
    =< mulO w > w } ;
  y-xi : Id R (y xi) t = trans (ap (\ v -> add v be) al-xi) (minus-plus t be) ;
  P-xi : Id R (P xi) z = calc R {
   P xi
    =< ap (\ v -> add (mul xi v) ga) y-xi > add (mul xi t) ga
    =< ap (\ v -> add v ga)
        (trans (L.neg-mul-left (mul ga ti) t)
         (ap neg (trans (sym (mulA ga ti t)) (trans (ap (mul ga) (trans (mulC ti t) ut.2)) (mulO ga)))))
     > add (neg ga) ga
    =< L.neg-cancel ga > z } ;
  s-xi : Id R (s xi) (G t) =
   trans (Ps.cong2 R mul _ _ _ _ y-xi (Ps.cong2 R add _ _ _ _ al-xi y-xi)) (ap (mul t) (addC w t)) ;
  point : PointEs = (xi,P-xi,subst L.unit (sym s-xi) p.2.2) ;
 } ;
 backward (p : PointS) : PointEs = Back[p].point ;

 ---------------------------------------------------------------------
 -- (3) the composites

 fb (p : PointS) : Id PointS (forward (backward p)) p = extS (forward (backward p)) p Back[p].y-xi ;
 -- -c/y = x
 bf-value (p : PointEs) : Id R Back[forward p].xi p.1 = calc R {
  neg (mul ga Back[forward p].ti)
   =< sym (L.neg-mul-left ga Back[forward p].ti) > mul (neg ga) Back[forward p].ti
   =< ap (\ v -> mul v Back[forward p].ti) (sym (xy p.1 p.2.1)) > mul (mul p.1 (y p.1)) Back[forward p].ti
   =< sym (mulA p.1 (y p.1) Back[forward p].ti) > mul p.1 (mul (y p.1) Back[forward p].ti)
   =< ap (mul p.1) Back[forward p].ut.2 > mul p.1 o
   =< mulO p.1 > p.1 } ;
 bf (p : PointEs) : Id PointEs (backward (forward p)) p = extEs (backward (forward p)) p (bf-value p) ;
 equivalence : Pr.Equiv PointEs PointS = (forward,Pr.qinv PointEs PointS forward backward fb bf) ;

 ---------------------------------------------------------------------
 -- (4) S is standard etale: F'(Y) is a unit

 standard (p : PointS) : L.unit (dF p.1) = AR.unit-right p.1 (dF p.1) p.2.2 ;

 ---------------------------------------------------------------------
 -- (5) chart 1: a a unit

 module Chart1 (ai : R) (hai : Id R (mul al ai) o) {
  M (x : R) : R = add (mul x (add x (mul be ai))) (mul ga ai) ;
  dM (x : R) : R = add x (add x (mul be ai)) ;
  -- a (u ai) = u
  cancel (u : R) : Id R (mul al (mul u ai)) u =
   trans (L.mul-swap al u ai) (trans (ap (mul u) hai) (mulO u)) ;
  -- a (x + b/a) = y
  shift (x : R) : Id R (mul al (add x (mul be ai))) (y x) =
   trans (dist al x (mul be ai)) (ap (add (mul al x)) (cancel be)) ;
  P-M (x : R) : Id R (mul al (M x)) (P x) = calc R {
   mul al (M x)
    =< dist al (mul x (add x (mul be ai))) (mul ga ai)
     > add (mul al (mul x (add x (mul be ai)))) (mul al (mul ga ai))
    =< Ps.cong2 R add _ _ _ _ (trans (L.mul-swap al x (add x (mul be ai))) (ap (mul x) (shift x))) (cancel ga)
     > P x } ;
  D-M (x : R) : Id R (mul al (dM x)) (D x) =
   trans (dist al x (add x (mul be ai))) (ap (add (mul al x)) (shift x)) ;
  -- M is monic of degree 2
  monic (x : R) : Id R (M x) (add (add (mul x x) (mul (mul be ai) x)) (mul ga ai)) =
   ap (\ v -> add v (mul ga ai)) (trans (dist x x (mul be ai)) (ap (add (mul x x)) (mulC x (mul be ai)))) ;
  -- the points of E and of (R[X]/(M))[1/M'] are the same
  root-iff-1 (x : R) (h : Id R (P x) z) : Id R (M x) z = calc R {
   M x
    =< sym (L.one-left (M x)) > mul o (M x)
    =< ap (\ v -> mul v (M x)) (sym (trans (mulC ai al) hai)) > mul (mul ai al) (M x)
    =< sym (mulA ai al (M x)) > mul ai (mul al (M x))
    =< ap (mul ai) (trans (P-M x) h) > mul ai z
    =< L.mul-zero ai > z } ;
  root-iff-2 (x : R) (h : Id R (M x) z) : Id R (P x) z =
   trans (sym (P-M x)) (trans (ap (mul al) h) (L.mul-zero al)) ;
  unit-iff-1 (x : R) (u : L.unit (D x)) : L.unit (dM x) =
   AR.unit-right al (dM x) (subst L.unit (sym (D-M x)) u) ;
  unit-iff-2 (x : R) (u : L.unit (dM x)) : L.unit (D x) =
   subst L.unit (D-M x) (AR.unit-product al (dM x) (ai,hai) u) ;
 } ;

 ---------------------------------------------------------------------
 -- (6) the two charts cover E

 cover (x : R) : Id R (mul (D x) (D x)) (add (mul (mul al x) (D x)) (s x)) =
  L.dist-left (mul al x) (y x) (D x) ;
 -- 1 = a x/D + s/D^2
 unit-ideal (x : R) (u : L.unit (D x)) :
  Id R (add (mul (mul al x) u.1) (mul (s x) (mul u.1 u.1))) o = calc R {
  add (mul (mul al x) u.1) (mul (s x) (mul u.1 u.1))
   =< ap (add (mul (mul al x) u.1))
       (trans (sym (mulA (y x) (D x) (mul u.1 u.1)))
        (ap (mul (y x)) (trans (mulA (D x) u.1 u.1) (trans (ap (\ v -> mul v u.1) u.2) (L.one-left u.1)))))
    > add (mul (mul al x) u.1) (mul (y x) u.1)
   =< sym (L.dist-left (mul al x) (y x) u.1) > mul (D x) u.1
   =< u.2 > o } ;

 ---------------------------------------------------------------------
 -- (7) Y has to be inverted

 module Necessity (hg : Id R ga z) (bu : L.unit be) {
  -- the points of (R[Y]/(F))[1/F'(Y)]
  PointS' : U l = (t : R) * Id R (F t) z * L.unit (dF t) ;
  F-zero : Id R (F z) z = calc R {
   add (mul z (add z (neg be))) (mul al ga)
    =< Ps.cong2 R add _ _ _ _ (L.zero-mul (add z (neg be))) (trans (ap (mul al) hg) (L.mul-zero al)) > add z z
    =< addZ z > z } ;
  dF-zero : Id R (dF z) (neg be) = trans (L.zl (add z (neg be))) (L.zl (neg be)) ;
  zero-point : PointS' =
   (z,F-zero,subst L.unit (sym dF-zero) (neg bu.1,trans (neg-neg-mul be bu.1) bu.2)) ;
  -- y is a unit at a point of E[1/s], so it is not 0 unless 1 = 0
  not-image (p : PointEs) (h0 : Id R (y p.1) z) : Id R o z = calc R {
   o =< sym p.2.2.2 > mul (s p.1) p.2.2.1
     =< ap (\ v -> mul (mul v (D p.1)) p.2.2.1) h0 > mul (mul z (D p.1)) p.2.2.1
     =< ap (\ v -> mul v p.2.2.1) (L.zero-mul (D p.1)) > mul z p.2.2.1
     =< L.zero-mul p.2.2.1 > z } ;
 } ;
} ;
