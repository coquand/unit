-- zmt2-revised.tex, Lemma 2 (the determinant lemma).  B a commutative
-- A-algebra (iota : A -> B; A is the note's R), y in B, b_1 .. b_n in B with
--   y b_i = C_i(y) + sum_j b_j mu_ji ,   C_i in A[X],  mu_ji in m .
-- Let N = X I - mu over R[X] and p = det(N)(y) = det(y I - mu) in B.
-- Informal proof.
--  (1) With M = y I - mu = N(y) (entrywise), the system reads M b = c,
--      c_i = C_i(y), so det(M) b_k = (adj(M) M b)_k = (adj(M) c)_k.
--  (2) The entries of adj(M) are N's adjugate entries evaluated at y (the
--      adjugate is a determinant of column-replaced matrices, and det
--      commutes with ring maps), so p b_k = F_k(y) with
--      F_k = sum_i C_i adj(N)_ik in R[X]: p b_k is in R[y].
--  (3) If b_1 .. b_n generate B over R, then p x is in R[y] for every x in
--      B, so B[1/p] = R[y][1/p].
--  (4) For an ideal J of B containing the mu_ji, the relation
--      a ~_k c  iff  a - y^k c in J  is closed under 0, +, -, has 1 ~_0 1,
--      and a ~_k c, a' ~_1 c' give a a' ~_(k+1) c c'; the entries satisfy
--      M_ji ~_1 delta_ji, so det(M) ~_n det(I) = 1: p = y^n mod J.  (The
--      note: p = y^r mod m R[y].)
--  (5) If moreover J is prime and y is not in J, then p is not in J.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;

---------------------------------------------------------------------
-- ring maps commute with delta, finite sums and column replacement

module Map (Rg Sg : CRing) (setRg : Pr.isSet Rg.R) (setSg : Pr.isSet Sg.R) (phi : H.Hom Rg Sg) {
 module DR = MnSums[l].Over[Rg] ; module DS = MnSums[l].Over[Sg] ;
 module SR = FiniteIdeal[l].Sums[Rg] ; module SS = FiniteIdeal[l].Sums[Sg] ;
 module AR = Adjugate[l].Over[Rg,setRg] ; module AS = Adjugate[l].Over[Sg,setSg] ;
 module NT = Naturality[l].Over[Rg,Sg,phi] ;
 delta-map : (k : Nat) (j i : Ps.Fin k) -> Id Sg.R (phi.1 (DR.delta k j i)) (DS.delta k j i) = split {
  zero -> \ j i -> H.zero Rg Sg phi ;
  suc k | r -> split {
   inl b -> split { inl c -> r b c ; inr t -> H.zero Rg Sg phi } ;
   inr s -> split { inl c -> H.zero Rg Sg phi ; inr t -> phi.2.1 } } } ;
 sum-map : (n : Nat) (v : Ps.Fin n -> Rg.R) -> Id Sg.R (phi.1 (SR.sum n v)) (SS.sum n (\ i -> phi.1 (v i))) = split {
  zero -> \ v -> H.zero Rg Sg phi ;
  suc n | ih -> \ v -> trans (phi.2.2.1 (v (inr tt)) (SR.sum n (\ i -> v (inl i))))
                       (ap (Sg.add (phi.1 (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 repl-map (n : Nat) : (m : Nat) (u : Ps.Fin m -> Ps.Fin n -> Rg.R) (k : Ps.Fin m) (c : Ps.Fin n -> Rg.R) (j : Ps.Fin m) ->
  Id (Ps.Fin n -> Sg.R) (\ i -> phi.1 (AR.repl n m u k c j i)) (AS.repl n m (\ j1 i -> phi.1 (u j1 i)) k (\ i -> phi.1 (c i)) j) = split {
  zero -> \ u k c j -> efq k ;
  suc m | r -> \ u -> split {
   inl k -> \ c -> split { inl j -> r (\ i -> u (inl i)) k c j ; inr t -> refl (\ i -> phi.1 (u (inr t) i)) } ;
   inr s -> \ c -> split { inl j -> refl (\ i -> phi.1 (u (inl j) i)) ; inr t -> refl (\ i -> phi.1 (c i)) } } } ;
 -- the adjugate commutes with phi
 adj-map (n : Nat) (A : Ps.Fin n -> Ps.Fin n -> Rg.R) (i k : Ps.Fin n) :
  Id Sg.R (phi.1 (AR.adj n A i k)) (AS.adj n (\ j1 i1 -> phi.1 (A j1 i1)) i k) =
  trans (NT.det-nat n (AR.repl n n A k (DR.delta n i)))
   (ap (ExteriorModel[l].Over[Sg].det n)
     (F.funext (Ps.Fin n) (\ j -> Ps.Fin n -> Sg.R)
       (\ j i1 -> phi.1 (AR.repl n n A k (DR.delta n i) j i1)) (AS.repl n n (\ j1 i1 -> phi.1 (A j1 i1)) k (DS.delta n i)) (\ j ->
       trans (repl-map n n A k (DR.delta n i) j)
        (ap (\ c -> AS.repl n n (\ j1 i1 -> phi.1 (A j1 i1)) k c j)
          (F.funext (Ps.Fin n) (\ i1 -> Sg.R) (\ i1 -> phi.1 (DR.delta n i i1)) (DS.delta n i) (delta-map n i)))))) ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R) (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (y : B.R) {
 open B ;
 module L = RL[B] ;
 module S = FiniteIdeal[l].Sums[B] ;
 module DB = MnSums[l].Over[B] ;
 module DT = Determinant[l].Over[B,setB] ;
 module DTR = DeterminantTrick[l].Over[B,setB] ;
 module ADJ = Adjugate[l].Over[B,setB] ;
 module CP = CharPoly[l].Over[A,setA] ;
 module RX = CP.B ;
 module SX = FiniteIdeal[l].Sums[RX.ring] ;
 module ADJX = Adjugate[l].Over[RX.ring,RX.set] ;
 module UP = Universal[l].Property[A,B,setA,setB].Given[iota,y] ;
 module AP = AffinePowers[l].Over[B] ;
 open ExteriorModel[l].Over[B] ;
 -- evaluation at y, and R[y]
 ev : H.Hom RX.ring B = UP.extend ;
 module Iota = Map[A,B,setA,setB,iota] ;
 module Ev = Map[RX.ring,B,RX.set,setB,ev] ;
 InRy (x : R) : U l = (G : RX.Carrier) * Id R (ev.1 G) x ;

 module System (n : Nat) (mu : CP.DT.Mat n) (b : Ps.Fin n -> R) (C : Ps.Fin n -> RX.Carrier)
  (eq : (i : Ps.Fin n) -> Id R (mul y (b i)) (add (ev.1 (C i)) (S.lin n b (\ j -> iota.1 (mu j i))))) {
  N : Ps.Fin n -> Ps.Fin n -> RX.Carrier = CP.charmat n mu ;
  M (j i : Ps.Fin n) : R = ev.1 (N j i) ;
  p : R = ev.1 (CP.char n mu) ;
  -- by definition: chi_mu = det N, and the entries of N
  char-det : Id RX.Carrier (CP.char n mu) (ExteriorModel[l].Over[RX.ring].det n N) = refl (CP.char n mu) ;
  N-entry (j i : Ps.Fin n) :
   Id RX.Carrier (N j i) (RX.addQ (RX.mulQ RX.variable (RX.constant (CP.D.delta n j i))) (RX.constant (A.neg (mu j i)))) =
   refl (N j i) ;
  det-M : Id R p (det n M) = trans (ap ev.1 char-det) (Ev.NT.det-nat n N) ;

  -- the entries of y I - mu
  entry (j i : Ps.Fin n) : Id R (M j i) (add (mul y (DB.delta n j i)) (neg (iota.1 (mu j i)))) =
   trans (ap ev.1 (N-entry j i)) (trans (ev.2.2.1 (RX.mulQ RX.variable (RX.constant (CP.D.delta n j i))) (RX.constant (A.neg (mu j i))))
    (Ps.cong2 R add _ _ _ _
      (trans (ev.2.2.2 RX.variable (RX.constant (CP.D.delta n j i)))
             (Ps.cong2 R mul _ _ _ _ UP.on-variable (trans (UP.on-constants (CP.D.delta n j i)) (Iota.delta-map n j i))))
      (trans (UP.on-constants (A.neg (mu j i))) (H.negation A B iota (mu j i))))) ;
  -- (1) M b = c
  system (i : Ps.Fin n) : Id R (DT.act n M b i) (ev.1 (C i)) = calc R {
   S.sum n (\ j -> mul (b j) (M j i))
    =< S.sum-cong n (\ j -> mul (b j) (M j i)) (\ j -> mul (b j) (add (mul y (DB.delta n j i)) (neg (iota.1 (mu j i)))))
         (\ j -> ap (mul (b j)) (entry j i))
     > S.lin n b (\ j -> add (mul y (DB.delta n j i)) (neg (iota.1 (mu j i))))
    =< S.lin-add n b (\ j -> mul y (DB.delta n j i)) (\ j -> neg (iota.1 (mu j i)))
     > add (S.lin n b (\ j -> mul y (DB.delta n j i))) (S.lin n b (\ j -> neg (iota.1 (mu j i))))
    =< Ps.cong2 R add _ _ _ _
         (trans (S.lin-scale n b (\ j -> DB.delta n j i) y) (ap (mul y) (DB.sum-delta-right n i b)))
         (S.lin-neg n b (\ j -> iota.1 (mu j i)))
     > add (mul y (b i)) (neg (S.lin n b (\ j -> iota.1 (mu j i))))
    =< ap (\ t -> add t (neg (S.lin n b (\ j -> iota.1 (mu j i))))) (eq i)
     > add (add (ev.1 (C i)) (S.lin n b (\ j -> iota.1 (mu j i)))) (neg (S.lin n b (\ j -> iota.1 (mu j i))))
    =< L.add-neg-cancel (ev.1 (C i)) (S.lin n b (\ j -> iota.1 (mu j i))) > ev.1 (C i) } ;
  -- det(M) b_k = (adj(M) c)_k
  det-times (k : Ps.Fin n) : Id R (mul (det n M) (b k)) (DT.act n (ADJ.adj n M) (\ i -> ev.1 (C i)) k) = calc R {
   mul (det n M) (b k)
    =< sym (DTR.act-scalar n (det n M) b k) > DT.act n (\ j i -> mul (det n M) (DB.delta n j i)) b k
    =< ap (\ A -> DT.act n A b k) (sym (ADJ.adj-mul-mat n M)) > DT.act n (DT.mmul n (ADJ.adj n M) M) b k
    =< DTR.act-mmul n (ADJ.adj n M) M b k > DT.act n (ADJ.adj n M) (DT.act n M b) k
    =< ap (\ w -> DT.act n (ADJ.adj n M) w k) (F.funext (Ps.Fin n) (\ i -> R) (DT.act n M b) (\ i -> ev.1 (C i)) system)
     > DT.act n (ADJ.adj n M) (\ i -> ev.1 (C i)) k } ;
  -- (2) p b_k = F_k(y)
  Fk (k : Ps.Fin n) : RX.Carrier = SX.sum n (\ i -> RX.mulQ (C i) (ADJX.adj n N i k)) ;
  in-Ry (k : Ps.Fin n) : Id R (ev.1 (Fk k)) (mul p (b k)) = calc R {
   ev.1 (Fk k)
    =< Ev.sum-map n (\ i -> RX.mulQ (C i) (ADJX.adj n N i k)) > S.sum n (\ i -> ev.1 (RX.mulQ (C i) (ADJX.adj n N i k)))
    =< S.sum-cong n (\ i -> ev.1 (RX.mulQ (C i) (ADJX.adj n N i k))) (\ i -> mul (ev.1 (C i)) (ADJ.adj n M i k))
         (\ i -> trans (ev.2.2.2 (C i) (ADJX.adj n N i k)) (ap (mul (ev.1 (C i))) (Ev.adj-map n N i k)))
     > DT.act n (ADJ.adj n M) (\ i -> ev.1 (C i)) k
    =< sym (det-times k) > mul (det n M) (b k)
    =< ap (\ t -> mul t (b k)) (sym det-M) > mul p (b k) } ;
  pb-in-Ry (k : Ps.Fin n) : InRy (mul p (b k)) = (Fk k,in-Ry k) ;

  -- (3) if the b_j generate B over R then B[1/p] = R[y][1/p]
  module Generated (coord : (x : R) -> (rho : Ps.Fin n -> A.R) * Id R x (S.sum n (\ j -> mul (iota.1 (rho j)) (b j)))) {
   px-in-Ry (x : R) : InRy (mul p x) =
    (SX.sum n (\ j -> RX.mulQ (RX.constant ((coord x).1 j)) (Fk j)),calc R {
     ev.1 (SX.sum n (\ j -> RX.mulQ (RX.constant ((coord x).1 j)) (Fk j)))
      =< Ev.sum-map n (\ j -> RX.mulQ (RX.constant ((coord x).1 j)) (Fk j))
       > S.sum n (\ j -> ev.1 (RX.mulQ (RX.constant ((coord x).1 j)) (Fk j)))
      =< S.sum-cong n (\ j -> ev.1 (RX.mulQ (RX.constant ((coord x).1 j)) (Fk j))) (\ j -> mul p (mul (iota.1 ((coord x).1 j)) (b j)))
           (\ j -> trans (ev.2.2.2 (RX.constant ((coord x).1 j)) (Fk j))
                    (trans (Ps.cong2 R mul _ _ _ _ (UP.on-constants ((coord x).1 j)) (in-Ry j))
                     (L.mul-swap (iota.1 ((coord x).1 j)) p (b j))))
       > S.sum n (\ j -> mul p (mul (iota.1 ((coord x).1 j)) (b j)))
      =< S.sum-scale p n (\ j -> mul (iota.1 ((coord x).1 j)) (b j)) > mul p (S.sum n (\ j -> mul (iota.1 ((coord x).1 j)) (b j)))
      =< ap (mul p) (sym (coord x).2) > mul p x }) ;
  } ;

  -- (4) p = y^n modulo an ideal J containing the mu_ji
  module Congruence (J : R -> U l) (J-zero : J z) (J-add : (a c : R) -> J a -> J c -> J (add a c))
   (J-scale : (a c : R) -> J c -> J (mul a c)) (J-mu : (j i : Ps.Fin n) -> J (iota.1 (mu j i))) {
   J-eq {a c : R} (e : Id R a c) (h : J a) : J c = subst J e h ;
   J-neg (a : R) (h : J a) : J (neg a) =
    J-eq (trans (L.neg-mul-left o a) (ap neg (L.one-left a))) (J-scale (neg o) a h) ;
   -- a - c in J gives c - a in J ... and the relation a ~_k c
   Rel (k : Nat) (a c : R) : U l = J (add a (neg (mul (AP.power y k) c))) ;
   -- (p - u) + (u - w) = p - w
   telescope (a u w : R) : Id R (add (add a (neg u)) (add u (neg w))) (add a (neg w)) =
    trans (sym (addA a (neg u) (add u (neg w))))
     (ap (add a) (trans (addA (neg u) u (neg w)) (trans (ap (\ t -> add t (neg w)) (L.neg-cancel u)) (L.zl (neg w))))) ;
   r-zero (k : Nat) : Rel k z z =
    J-eq (sym (trans (ap (\ t -> add z (neg t)) (L.mul-zero (AP.power y k))) (trans (ap (add z) L.neg-zero) (addZ z)))) J-zero ;
   r-add (k : Nat) (a a' c c' : R) (h : Rel k a c) (h' : Rel k a' c') : Rel k (add a a') (add c c') =
    J-eq (trans (L.swap a (neg (mul (AP.power y k) c)) a' (neg (mul (AP.power y k) c')))
          (ap (add (add a a'))
            (trans (sym (L.neg-add (mul (AP.power y k) c) (mul (AP.power y k) c')))
                   (ap neg (sym (dist (AP.power y k) c c'))))))
     (J-add _ _ h h') ;
   r-neg (k : Nat) (a c : R) (h : Rel k a c) : Rel k (neg a) (neg c) =
    J-eq (trans (L.negsub a (mul (AP.power y k) c))
          (ap (add (neg a)) (sym (trans (ap neg (L.mul-neg (AP.power y k) c)) (L.neg-neg (mul (AP.power y k) c))))))
     (J-neg _ h) ;
   r-one : Rel zero o o = J-eq (sym (trans (ap (\ t -> add o (neg t)) (mulO o)) (addN o))) J-zero ;
   r-mul (k : Nat) (a a' c c' : R) (h : Rel k a c) (h' : Rel (suc zero) a' c') : Rel (suc k) (mul a a') (mul c c') =
    J-eq (trans (Ps.cong2 R add _ _ _ _
                  (trans (dist a a' (neg (mul (AP.power y (suc zero)) c'))) (ap (add (mul a a')) (L.mul-neg a (mul (AP.power y (suc zero)) c'))))
                  (trans (dist (mul (AP.power y (suc zero)) c') a (neg (mul (AP.power y k) c)))
                   (Ps.cong2 R add _ _ _ _
                     (mulC (mul (AP.power y (suc zero)) c') a)
                     (trans (L.mul-neg (mul (AP.power y (suc zero)) c') (mul (AP.power y k) c))
                      (ap neg (trans (L.mul-four (AP.power y (suc zero)) c' (AP.power y k) c)
                               (Ps.cong2 R mul _ _ _ _ (ap (\ t -> mul t (AP.power y k)) (mulO y)) (mulC c' c))))))))
          (telescope (mul a a') (mul a (mul (AP.power y (suc zero)) c')) (mul (AP.power y (suc k)) (mul c c'))))
     (J-add _ _ (J-scale a _ h') (J-scale (mul (AP.power y (suc zero)) c') _ h)) ;
   module ER = ExteriorRelation[l].Over[B,B,Rel,r-zero,r-add,r-neg,r-one,r-mul] ;
   -- M_ji ~_1 delta_ji
   entry-rel (j i : Ps.Fin n) : Rel (suc zero) (M j i) (DB.delta n j i) =
    J-eq (sym (calc R {
      add (M j i) (neg (mul (mul y o) (DB.delta n j i)))
       =< Ps.cong2 R add _ _ _ _ (entry j i) (ap (\ t -> neg (mul t (DB.delta n j i))) (mulO y))
        > add (add (mul y (DB.delta n j i)) (neg (iota.1 (mu j i)))) (neg (mul y (DB.delta n j i)))
       =< ap (\ t -> add t (neg (mul y (DB.delta n j i)))) (addC (mul y (DB.delta n j i)) (neg (iota.1 (mu j i))))
        > add (add (neg (iota.1 (mu j i))) (mul y (DB.delta n j i))) (neg (mul y (DB.delta n j i)))
       =< L.add-neg-cancel (neg (iota.1 (mu j i))) (mul y (DB.delta n j i)) > neg (iota.1 (mu j i)) }))
     (J-neg _ (J-mu j i)) ;
   -- p - y^n in J
   congruence : J (add p (neg (AP.power y n))) =
    J-eq (Ps.cong2 R add _ _ _ _ (sym det-M) (ap neg (trans (ap (mul (AP.power y n)) (DT.det-id n)) (mulO (AP.power y n)))))
     (ER.det n M (\ j i -> DB.delta n j i) entry-rel) ;

   -- (5) J prime, y not in J: p not in J
   module Prime (prime : (a c : R) -> J (mul a c) -> Plus (J a) (J c)) (y-out : Not (J y)) {
    out-step (k : Nat) (ih : J (AP.power y k) -> Empty) : Plus (J y) (J (AP.power y k)) -> Empty = split {
     inl a -> y-out a ; inr c -> ih c } ;
    power-out : (k : Nat) -> J (AP.power y k) -> Empty = split {
     zero -> \ h -> y-out (J-eq (mulO y) (J-scale y o h)) ;
     suc k | ih -> \ h -> out-step k ih (prime y (AP.power y k) h) } ;
    p-out (h : J p) : Empty =
     power-out n (J-eq (trans (ap (add p) (L.negsub p (AP.power y n)))
                        (trans (addA p (neg p) (AP.power y n)) (trans (ap (\ t -> add t (AP.power y n)) (addN p)) (L.zl (AP.power y n)))))
                  (J-add _ _ h (J-neg _ congruence))) ;
   } ;
  } ;
 } ;
} ;
