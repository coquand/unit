-- zmt2-revised.tex, Lemma 1 (an idempotent in the special fibre).
-- k a discrete field (every c is 0 or a unit), A a commutative k-algebra
-- (iota : k -> A), s in A a root of a nonzero polynomial over k, written by
-- its coefficient list cs = [c_0, .., c_d] (Horner value
-- c_0 + s (c_1 + s (..)) = 0); "nonzero" means that some c_i is a unit, as
-- for a monic polynomial (Monic below).
-- Informal proof.
--  (1) First nonzero coefficient.  If s^j (c_0 + s H) = 0 with H the value
--      of [c_1, ..], then either c_0 is a unit, and dividing by it gives
--      s^j (1 - s v) = 0 with v = -c_0^-1 H, or c_0 = 0 and s^(j+1) H = 0,
--      and we go on with [c_1, ..].  Starting from j = 0 this gives m, v
--      with s^m (1 - s v) = 0, hence s^N (1 - s v) = 0 with N = m + 1 >= 1.
--  (2) From s^N (1 - s v) = 0: s^N = s^N (s v), so s^N = s^N (s v)^j for
--      every j.  Put e = (s v)^N = s^N v^N.  Then e e = v^N (s^N (s v)^N)
--      = v^N s^N = e.
--  (3) A[1/e] = A[1/s]: e = s (s^(N-1) v^N), so a map inverting e inverts
--      s; and s^N (1 - e) = 0, so a map inverting s sends e to 1.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;

---------------------------------------------------------------------
-- (2), (3): the idempotent, in any commutative ring

module Idempotent (A : CRing) (setA : Pr.isSet A.R) (s v : A.R) (m : Nat)
 (rel : Id A.R (A.mul (AffinePowers[l].Over[A].power s (suc m)) (A.add A.o (A.neg (A.mul s v)))) A.z) {
 open A ;
 module L = RL[A] ;
 module AP = AffinePowers[l].Over[A] ;
 N : Nat = suc m ;
 sN : R = AP.power s N ;
 sv : R = mul s v ;
 e : R = AP.power sv N ;

 -- s^N (s v) = s^N
 absorb : Id R (mul sN sv) sN =
  sym (trans (sym (L.neg-neg sN))
   (trans (ap neg (sym (L.neg-uniq sN (neg (mul sN sv))
     (trans (Presentations[l].cong2 R add _ _ _ _ (sym (mulO sN)) (sym (L.mul-neg sN sv)))
      (trans (sym (dist sN o (neg sv))) rel)))))
    (L.neg-neg (mul sN sv)))) ;
 -- s^N (s v)^j = s^N
 fix : (j : Nat) -> Id R (mul sN (AP.power sv j)) sN = split {
  zero -> mulO sN ;
  suc j | ih -> calc R {
   mul sN (mul sv (AP.power sv j))
    =< L.mul-swap sN sv (AP.power sv j) > mul sv (mul sN (AP.power sv j))
    =< ap (mul sv) ih > mul sv sN
    =< mulC sv sN > mul sN sv
    =< absorb > sN } } ;
 -- e = s^N v^N
 e-split : Id R e (mul sN (AP.power v N)) = AP.power-mul s v N ;
 idempotent : Id R (mul e e) e = calc R {
  mul e e
   =< ap (\ t -> mul t e) e-split > mul (mul sN (AP.power v N)) e
   =< ap (\ t -> mul t e) (mulC sN (AP.power v N)) > mul (mul (AP.power v N) sN) e
   =< sym (mulA (AP.power v N) sN e) > mul (AP.power v N) (mul sN e)
   =< ap (mul (AP.power v N)) (fix N) > mul (AP.power v N) sN
   =< mulC (AP.power v N) sN > mul sN (AP.power v N)
   =< sym e-split > e } ;
 -- (3) e is a multiple of s
 cofactor : R = mul (AP.power s m) (AP.power v N) ;
 e-multiple : Id R e (mul s cofactor) =
  trans e-split (sym (mulA s (AP.power s m) (AP.power v N))) ;
 -- s^N (1 - e) = 0
 e-one : Id R (mul sN (add o (neg e))) z = calc R {
  mul sN (add o (neg e))
   =< dist sN o (neg e) > add (mul sN o) (mul sN (neg e))
   =< Presentations[l].cong2 R add _ _ _ _ (mulO sN) (trans (L.mul-neg sN e) (ap neg (fix N))) > add sN (neg sN)
   =< addN sN > z } ;

 -- A[1/e] = A[1/s]: a ring map inverts e iff it inverts s, and then e |-> 1
 module Localisation (B : CRing) (setB : Pr.isSet B.R) (phi : H.Hom A B) {
  module LB = RL[B] ;
  module ARB = AffineRing[l].Laws[B,setB] ;
  module BP = AffinePowers[l].Over[B] ;
  inverts-s (u : LB.unit (phi.1 e)) : LB.unit (phi.1 s) =
   ARB.unit-left (phi.1 s) (phi.1 cofactor)
    (subst LB.unit (trans (ap phi.1 e-multiple) (phi.2.2.2 s cofactor)) u) ;
  -- 1 - w = 0 gives w = 1
  one-minus (w : B.R) (h : Id B.R (B.add B.o (B.neg w)) B.z) : Id B.R w B.o =
   sym (trans (LB.neg-uniq (B.neg w) B.o (trans (B.addC (B.neg w) B.o) h)) (LB.neg-neg w)) ;
  e-to-one (u : LB.unit (phi.1 s)) : Id B.R (phi.1 e) B.o =
   one-minus (phi.1 e)
    (LB.unit-reg (phi.1 sN) (B.add B.o (B.neg (phi.1 e)))
     (subst LB.unit (sym (AffinePowers[l].power-map A B phi s N)) (BP.Units[setB].power-unit (phi.1 s) u N))
     (trans (ap (B.mul (phi.1 sN))
              (sym (trans (phi.2.2.1 o (neg e)) (Presentations[l].cong2 B.R B.add _ _ _ _ phi.2.1 (H.negation A B phi e)))))
      (trans (sym (phi.2.2.2 sN (add o (neg e)))) (trans (ap phi.1 e-one) (H.zero A B phi))))) ;
  inverts-e (u : LB.unit (phi.1 s)) : LB.unit (phi.1 e) = subst LB.unit (sym (e-to-one u)) (B.o,B.mulO B.o) ;
 } ;
} ;

---------------------------------------------------------------------
-- (1): the first nonzero coefficient, over a discrete field

module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (c : k.R) -> Plus (Id k.R c k.z) (RL[k].unit c))
 (A : CRing) (setA : Pr.isSet A.R) (iota : H.Hom k A) (s : A.R) {
 open A ;
 module L = RL[A] ;
 module AP = AffinePowers[l].Over[A] ;
 -- the value c_0 + s (c_1 + s (..)) of a coefficient list at s
 value : List k.R -> R = split { nil -> z ; cons c cs | r -> add (iota.1 c) (mul s r) } ;
 -- some coefficient is a unit
 Nonzero : List k.R -> U l = split { nil -> Empty ; cons c cs | r -> Plus (RL[k].unit c) r } ;
 -- a monic polynomial: the coefficients cs followed by 1
 monic : List k.R -> List k.R = split { nil -> cons k.o nil ; cons c cs | r -> cons c r } ;
 monic-nonzero : (cs : List k.R) -> Nonzero (monic cs) = split {
  nil -> inl (k.o,k.mulO k.o) ; cons c cs | r -> inr r } ;

 Relation : U l = (m : Nat) * (v : R) * Id R (mul (AP.power s m) (add o (neg (mul s v)))) z ;

 -- c a unit: s^j (c + s H) = 0 gives s^j (1 - s v) = 0, v = -c^-1 H
 module UnitCase (c : k.R) (uc : RL[k].unit c) (h0 : R) (j : Nat)
  (h : Id R (mul (AP.power s j) (add (iota.1 c) (mul s h0))) z) {
  ci : R = iota.1 uc.1 ;
  v : R = neg (mul ci h0) ;
  -- 1 - s v = c^-1 (c + s H)
  normalised : Id R (add o (neg (mul s v))) (mul ci (add (iota.1 c) (mul s h0))) = calc R {
   add o (neg (mul s (neg (mul ci h0))))
    =< ap (\ t -> add o (neg t)) (L.mul-neg s (mul ci h0)) > add o (neg (neg (mul s (mul ci h0))))
    =< ap (add o) (L.neg-neg (mul s (mul ci h0))) > add o (mul s (mul ci h0))
    =< Presentations[l].cong2 R add _ _ _ _
        (sym (trans (sym (iota.2.2.2 uc.1 c)) (trans (ap iota.1 (trans (k.mulC uc.1 c) uc.2)) iota.2.1)))
        (L.mul-swap s ci h0)
     > add (mul ci (iota.1 c)) (mul ci (mul s h0))
    =< sym (dist ci (iota.1 c) (mul s h0)) > mul ci (add (iota.1 c) (mul s h0)) } ;
  relation : Relation = (j,v,calc R {
   mul (AP.power s j) (add o (neg (mul s v)))
    =< ap (mul (AP.power s j)) normalised > mul (AP.power s j) (mul ci (add (iota.1 c) (mul s h0)))
    =< L.mul-swap (AP.power s j) ci (add (iota.1 c) (mul s h0)) > mul ci (mul (AP.power s j) (add (iota.1 c) (mul s h0)))
    =< ap (mul ci) h > mul ci z
    =< L.mul-zero ci > z }) ;
 } ;
 -- c = 0: s^j (c + s H) = 0 gives s^(j+1) H = 0
 shift (c : k.R) (c0 : Id k.R c k.z) (h0 : R) (j : Nat)
  (h : Id R (mul (AP.power s j) (add (iota.1 c) (mul s h0))) z) : Id R (mul (AP.power s (suc j)) h0) z = calc R {
  mul (mul s (AP.power s j)) h0
   =< sym (mulA s (AP.power s j) h0) > mul s (mul (AP.power s j) h0)
   =< L.mul-swap s (AP.power s j) h0 > mul (AP.power s j) (mul s h0)
   =< ap (mul (AP.power s j)) (sym (trans (ap (\ t -> add t (mul s h0)) (trans (ap iota.1 c0) (H.zero k A iota))) (L.zl (mul s h0))))
    > mul (AP.power s j) (add (iota.1 c) (mul s h0))
   =< h > z } ;

 -- the two cases for a list c :: cs, with r the statement for cs
 Rest (cs : List k.R) : U l = Nonzero cs -> (j : Nat) -> Id R (mul (AP.power s j) (value cs)) z -> Relation ;
 by-dec (c : k.R) (cs : List k.R) (r : Rest cs) (nz1 : Nonzero cs) (j : Nat)
  (h : Id R (mul (AP.power s j) (value (cons c cs))) z) : Plus (Id k.R c k.z) (RL[k].unit c) -> Relation = split {
  inl c0 -> r nz1 (suc j) (shift c c0 (value cs) j h) ;
  inr uc -> UnitCase[c,uc,value cs,j,h].relation } ;
 by-nonzero (c : k.R) (cs : List k.R) (r : Rest cs) (j : Nat)
  (h : Id R (mul (AP.power s j) (value (cons c cs))) z) : Plus (RL[k].unit c) (Nonzero cs) -> Relation = split {
  inl uc -> UnitCase[c,uc,value cs,j,h].relation ;
  inr nz1 -> by-dec c cs r nz1 j h (dec c) } ;
 strip : (cs : List k.R) -> Rest cs = split {
  nil -> \ nz -> efq nz ;
  cons c cs | r -> \ nz j h -> by-nonzero c cs r j h nz } ;

 -- Lemma 1
 module Lemma (cs : List k.R) (nz : Nonzero cs) (root : Id R (value cs) z) {
  rel0 : Relation = strip cs nz zero (trans (L.one-left (value cs)) root) ;
  m : Nat = rel0.1 ;
  v : R = rel0.2.1 ;
  -- N = m + 1 >= 1
  rel : Id R (mul (AP.power s (suc m)) (add o (neg (mul s v)))) z =
   trans (sym (mulA s (AP.power s m) (add o (neg (mul s v))))) (trans (ap (mul s) rel0.2.2) (L.mul-zero s)) ;
  module I = Idempotent[A,setA,s,v,m,rel] ;
 } ;
} ;
