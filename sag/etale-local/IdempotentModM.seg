-- zmt2-revised.tex, Lemma 1 read modulo an ideal (the note's A = B/mB
-- without building the quotient).  A with an ideal m, residually discrete
-- (dec : c in m or c a unit); B an A-algebra (iota), I an ideal of B
-- containing iota(m) (given by its closure laws), s in B a root modulo I
-- of a coefficient list cs with a unit coefficient (Nonzero; a monic list
-- is the case monic-nonzero).
-- Informal proof (the proof of Lemma 1, with "= 0" read as "in I").
--  (1) First unit coefficient.  If s^j (c_0 + s H) is in I, H the value of
--      [c_1, ..], then either c_0 is a unit, and multiplying by c_0^-1 gives
--      s^j (1 - s v) in I with v = -c_0^-1 H, or c_0 is in m, so
--      s^j iota(c_0) is in I and s^(j+1) H is in I: go on with [c_1, ..].
--      With N = k + 1:  s^N (1 - s v) in I.
--  (2) Put e = (s v)^N = s^N v^N.  Modulo I:  s^N (s v) = s^N, hence
--      s^N (s v)^j = s^N for every j (fix), e e = v^N (s^N e) = v^N s^N = e
--      (idempotent), s^N (1 - e) in I (e-one); and e = s cofactor exactly.
--  (3) kill: if s^K w is in I then e w is in I.  Induction on K: from
--      e (s w) in I and e = s cofactor,
--        e w = -((e e - e) w) + cofactor (e (s w)).
-- Psum: a monic relation y^n + V_n c = 0 (LoopInputs.Integral.root) is the
-- Horner value of the list monic (coefs n c) (horner-monic).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Over (A : CRing) (m : A.R -> U l)
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (B : CRing) (iota : H.Hom A B)
 (I : B.R -> U l) (I-zero : I B.z) (I-add : (a c : B.R) -> I a -> I c -> I (B.add a c))
 (I-scale : (a c : B.R) -> I c -> I (B.mul a c)) (I-m : (a : A.R) -> m a -> I (iota.1 a)) (s : B.R) {
 open B ;
 module L = RL[B] ;
 module AP = AffinePowers[l].Over[B] ;
 module Hs = MonicReduce[l].Horner[A,B,iota,s] ;
 I-eq {a c : R} (e : Id R a c) (h : I a) : I c = subst I e h ;
 I-neg (a : R) (h : I a) : I (neg a) = I-eq (trans (L.neg-mul-left o a) (ap neg (L.one-left a))) (I-scale (neg o) a h) ;
 -- (-a + b) + a = b
 unneg (a b : R) : Id R (add (add (neg a) b) a) b =
  trans (ap (\ t -> add t a) (addC (neg a) b)) (trans (sym (addA b (neg a) a)) (trans (ap (add b) (L.neg-cancel a)) (addZ b))) ;

 ---------------------------------------------------------------------
 -- (1) the first unit coefficient

 -- some coefficient is a unit; a monic list (cs followed by 1) has one
 Nonzero : List A.R -> U l = split { nil -> Empty ; cons c cs | r -> Plus (RL[A].unit c) r } ;
 monic : List A.R -> List A.R = split { nil -> cons A.o nil ; cons c cs | r -> cons c r } ;
 monic-nonzero : (cs : List A.R) -> Nonzero (monic cs) = split {
  nil -> inl (A.o,A.mulO A.o) ; cons c cs | r -> inr r } ;
 Relation : U l = (k : Nat) * (v : R) * I (mul (AP.power s k) (add o (neg (mul s v)))) ;
 -- c a unit: s^j (c + s H) in I gives s^j (1 - s v) in I, v = -c^-1 H
 module UnitCase (c : A.R) (uc : RL[A].unit c) (h0 : R) (j : Nat)
  (h : I (mul (AP.power s j) (add (iota.1 c) (mul s h0)))) {
  ci : R = iota.1 uc.1 ;
  v : R = neg (mul ci h0) ;
  -- 1 - s v = c^-1 (c + s H)
  normalised : Id R (add o (neg (mul s v))) (mul ci (add (iota.1 c) (mul s h0))) = calc R {
   add o (neg (mul s (neg (mul ci h0))))
    =< ap (\ t -> add o (neg t)) (L.mul-neg s (mul ci h0)) > add o (neg (neg (mul s (mul ci h0))))
    =< ap (add o) (L.neg-neg (mul s (mul ci h0))) > add o (mul s (mul ci h0))
    =< Ps.cong2 R add _ _ _ _
        (sym (trans (sym (iota.2.2.2 uc.1 c)) (trans (ap iota.1 (trans (A.mulC uc.1 c) uc.2)) iota.2.1)))
        (L.mul-swap s ci h0)
     > add (mul ci (iota.1 c)) (mul ci (mul s h0))
    =< sym (dist ci (iota.1 c) (mul s h0)) > mul ci (add (iota.1 c) (mul s h0)) } ;
  relation : Relation = (j,v,
   I-eq (sym (trans (ap (mul (AP.power s j)) normalised) (L.mul-swap (AP.power s j) ci (add (iota.1 c) (mul s h0)))))
    (I-scale ci _ h)) ;
 } ;
 -- c in m: s^j (c + s H) in I gives s^(j+1) H in I
 shift (c : A.R) (hc : m c) (h0 : R) (j : Nat)
  (h : I (mul (AP.power s j) (add (iota.1 c) (mul s h0)))) : I (mul (AP.power s (suc j)) h0) =
  I-eq (calc R {
   add (mul (AP.power s j) (add (iota.1 c) (mul s h0))) (neg (mul (AP.power s j) (iota.1 c)))
    =< ap (\ t -> add t (neg (mul (AP.power s j) (iota.1 c)))) (trans (dist (AP.power s j) (iota.1 c) (mul s h0))
         (addC (mul (AP.power s j) (iota.1 c)) (mul (AP.power s j) (mul s h0))))
     > add (add (mul (AP.power s j) (mul s h0)) (mul (AP.power s j) (iota.1 c))) (neg (mul (AP.power s j) (iota.1 c)))
    =< L.add-neg-cancel (mul (AP.power s j) (mul s h0)) (mul (AP.power s j) (iota.1 c)) > mul (AP.power s j) (mul s h0)
    =< L.mul-swap (AP.power s j) s h0 > mul s (mul (AP.power s j) h0)
    =< mulA s (AP.power s j) h0 > mul (mul s (AP.power s j)) h0 })
   (I-add _ _ h (I-neg _ (I-scale (AP.power s j) _ (I-m c hc)))) ;
 -- the two cases for a list c :: cs, with r the statement for cs
 Rest (cs : List A.R) : U l = Nonzero cs -> (j : Nat) -> I (mul (AP.power s j) (Hs.horner cs)) -> Relation ;
 by-dec (c : A.R) (cs : List A.R) (r : Rest cs) (nz1 : Nonzero cs) (j : Nat)
  (h : I (mul (AP.power s j) (Hs.horner (cons c cs)))) : Plus (m c) (RL[A].unit c) -> Relation = split {
  inl hc -> r nz1 (suc j) (shift c hc (Hs.horner cs) j h) ;
  inr uc -> UnitCase[c,uc,Hs.horner cs,j,h].relation } ;
 by-nonzero (c : A.R) (cs : List A.R) (r : Rest cs) (j : Nat)
  (h : I (mul (AP.power s j) (Hs.horner (cons c cs)))) : Plus (RL[A].unit c) (Nonzero cs) -> Relation = split {
  inl uc -> UnitCase[c,uc,Hs.horner cs,j,h].relation ;
  inr nz1 -> by-dec c cs r nz1 j h (dec c) } ;
 strip : (cs : List A.R) -> Rest cs = split {
  nil -> \ nz -> efq nz ;
  cons c cs | r -> \ nz j h -> by-nonzero c cs r j h nz } ;

 -- a monic relation s^n + V_n c (LoopInputs.Integral.root) as a Horner value
 module PS = PowerSums[l].Over[B,s] ;
 module CT = PowerSums[l].Coef[B] ;
 coefs : Nat -> (Nat -> A.R) -> List A.R = split {
  zero -> \ c -> nil ; suc n | r -> \ c -> cons (c zero) (r (\ i -> c (suc i))) } ;
 -- d = point d_0 + shift (d_(1+i))
 point-shift (d : Nat -> R) : (i : Nat) -> Id R (d i) (add (CT.point (d zero) i) (CT.shift (\ i1 -> d (suc i1)) i)) = split {
  zero -> sym (addZ (d zero)) ; suc i -> sym (L.zl (d (suc i))) } ;
 -- [d]_(n+1) = d_0 + s [d_(1+i)]_n
 psum-bottom (n : Nat) (d : Nat -> R) : Id R (PS.psum (suc n) d) (add (d zero) (mul s (PS.psum n (\ i -> d (suc i))))) =
  trans (PS.psum-cong (suc n) d (\ i -> add (CT.point (d zero) i) (CT.shift (\ i1 -> d (suc i1)) i))
          (point-shift d))
   (trans (PS.psum-add (suc n) (CT.point (d zero)) (CT.shift (\ i1 -> d (suc i1))))
    (Ps.cong2 R add _ _ _ _ (PS.psum-point (d zero) n) (sym (PS.psum-shift n (\ i1 -> d (suc i1)))))) ;
 horner-monic : (n : Nat) (c : Nat -> A.R) ->
  Id R (Hs.horner (monic (coefs n c))) (add (PS.psum n (\ i -> iota.1 (c i))) (AP.power s n)) = split {
  zero -> \ c -> trans (trans (Ps.cong2 R add _ _ _ _ iota.2.1 (L.mul-zero s)) (addZ o)) (sym (L.zl o)) ;
  suc n | r -> \ c -> calc R {
   add (iota.1 (c zero)) (mul s (Hs.horner (monic (coefs n (\ i -> c (suc i))))))
    =< ap (\ t -> add (iota.1 (c zero)) (mul s t)) (r (\ i -> c (suc i)))
     > add (iota.1 (c zero)) (mul s (add (PS.psum n (\ i -> iota.1 (c (suc i)))) (AP.power s n)))
    =< ap (add (iota.1 (c zero))) (dist s (PS.psum n (\ i -> iota.1 (c (suc i)))) (AP.power s n))
     > add (iota.1 (c zero)) (add (mul s (PS.psum n (\ i -> iota.1 (c (suc i))))) (AP.power s (suc n)))
    =< addA (iota.1 (c zero)) (mul s (PS.psum n (\ i -> iota.1 (c (suc i))))) (AP.power s (suc n))
     > add (add (iota.1 (c zero)) (mul s (PS.psum n (\ i -> iota.1 (c (suc i)))))) (AP.power s (suc n))
    =< ap (\ t -> add t (AP.power s (suc n))) (sym (psum-bottom n (\ i -> iota.1 (c i))))
     > add (PS.psum (suc n) (\ i -> iota.1 (c i))) (AP.power s (suc n)) } } ;

 ---------------------------------------------------------------------
 -- (2), (3): the idempotent modulo I

 module Idempotent (v : R) (k : Nat) (rel : I (mul (AP.power s (suc k)) (add o (neg (mul s v))))) {
  N : Nat = suc k ;
  sN : R = AP.power s N ;
  sv : R = mul s v ;
  e : R = AP.power sv N ;
  -- s^N (s v) = s^N mod I
  absorb : I (add (mul sN sv) (neg sN)) =
   I-eq (calc R {
    neg (mul sN (add o (neg sv)))
     =< ap neg (trans (dist sN o (neg sv)) (Ps.cong2 R add _ _ _ _ (mulO sN) (L.mul-neg sN sv))) > neg (add sN (neg (mul sN sv)))
     =< L.negsub sN (mul sN sv) > add (neg sN) (mul sN sv)
     =< addC (neg sN) (mul sN sv) > add (mul sN sv) (neg sN) })
    (I-neg _ rel) ;
  -- s^N (s v)^j = s^N mod I
  fix : (j : Nat) -> I (add (mul sN (AP.power sv j)) (neg sN)) = split {
   zero -> I-eq (sym (trans (ap (\ t -> add t (neg sN)) (mulO sN)) (addN sN))) I-zero ;
   suc j | ih -> I-eq (calc R {
     add (mul sv (add (mul sN (AP.power sv j)) (neg sN))) (add (mul sN sv) (neg sN))
      =< ap (\ t -> add t (add (mul sN sv) (neg sN)))
          (trans (dist sv (mul sN (AP.power sv j)) (neg sN))
                 (Ps.cong2 R add _ _ _ _ (L.mul-swap sv sN (AP.power sv j)) (trans (L.mul-neg sv sN) (ap neg (mulC sv sN)))))
       > add (add (mul sN (mul sv (AP.power sv j))) (neg (mul sN sv))) (add (mul sN sv) (neg sN))
      =< sym (addA (mul sN (mul sv (AP.power sv j))) (neg (mul sN sv)) (add (mul sN sv) (neg sN)))
       > add (mul sN (mul sv (AP.power sv j))) (add (neg (mul sN sv)) (add (mul sN sv) (neg sN)))
      =< ap (add (mul sN (mul sv (AP.power sv j))))
          (trans (addA (neg (mul sN sv)) (mul sN sv) (neg sN)) (trans (ap (\ t -> add t (neg sN)) (L.neg-cancel (mul sN sv))) (L.zl (neg sN))))
       > add (mul sN (mul sv (AP.power sv j))) (neg sN) })
     (I-add _ _ (I-scale sv _ ih) absorb) } ;
  -- e = s^N v^N
  e-split : Id R e (mul sN (AP.power v N)) = AP.power-mul s v N ;
  idempotent : I (add (mul e e) (neg e)) =
   I-eq (calc R {
    mul (AP.power v N) (add (mul sN e) (neg sN))
     =< trans (dist (AP.power v N) (mul sN e) (neg sN)) (ap (add (mul (AP.power v N) (mul sN e))) (L.mul-neg (AP.power v N) sN))
      > add (mul (AP.power v N) (mul sN e)) (neg (mul (AP.power v N) sN))
     =< Ps.cong2 R add _ _ _ _ (trans (mulA (AP.power v N) sN e) (ap (\ t -> mul t e) (mulC (AP.power v N) sN)))
         (ap neg (mulC (AP.power v N) sN))
      > add (mul (mul sN (AP.power v N)) e) (neg (mul sN (AP.power v N)))
     =< Ps.cong2 R add _ _ _ _ (ap (\ t -> mul t e) (sym e-split)) (ap neg (sym e-split)) > add (mul e e) (neg e) })
    (I-scale (AP.power v N) _ (fix N)) ;
  -- s^N (1 - e) in I
  e-one : I (mul sN (add o (neg e))) =
   I-eq (calc R {
    neg (add (mul sN e) (neg sN))
     =< L.negsub (mul sN e) sN > add (neg (mul sN e)) sN
     =< addC (neg (mul sN e)) sN > add sN (neg (mul sN e))
     =< sym (trans (dist sN o (neg e)) (Ps.cong2 R add _ _ _ _ (mulO sN) (L.mul-neg sN e))) > mul sN (add o (neg e)) })
    (I-neg _ (fix N)) ;
  -- e is a multiple of s (exactly)
  cofactor : R = mul (AP.power s k) (AP.power v N) ;
  e-multiple : Id R e (mul s cofactor) = trans e-split (sym (mulA s (AP.power s k) (AP.power v N))) ;
  -- e w = -((e e - e) w) + cofactor (e (s w))
  kill-step (w : R) : Id R (add (neg (mul (add (mul e e) (neg e)) w)) (mul cofactor (mul e (mul s w)))) (mul e w) = calc R {
   add (neg (mul (add (mul e e) (neg e)) w)) (mul cofactor (mul e (mul s w)))
    =< Ps.cong2 R add _ _ _ _
        (trans (ap neg (trans (L.dist-left (mul e e) (neg e) w) (ap (add (mul (mul e e) w)) (L.neg-mul-left e w))))
               (L.negsub (mul (mul e e) w) (mul e w)))
        (calc R {
          mul cofactor (mul e (mul s w))
           =< L.mul-swap cofactor e (mul s w) > mul e (mul cofactor (mul s w))
           =< ap (mul e) (trans (L.mul-swap cofactor s w) (mulA s cofactor w)) > mul e (mul (mul s cofactor) w)
           =< ap (\ t -> mul e (mul t w)) (sym e-multiple) > mul e (mul e w)
           =< mulA e e w > mul (mul e e) w })
     > add (add (neg (mul (mul e e) w)) (mul e w)) (mul (mul e e) w)
    =< unneg (mul (mul e e) w) (mul e w) > mul e w } ;
  -- s^K w in I gives e w in I
  kill : (K : Nat) (w : R) -> I (mul (AP.power s K) w) -> I (mul e w) = split {
   zero -> \ w h -> I-scale e w (I-eq (L.one-left w) h) ;
   suc K | ih -> \ w h -> I-eq (kill-step w)
     (I-add _ _ (I-neg _ (I-eq (mulC w (add (mul e e) (neg e))) (I-scale w _ idempotent)))
       (I-scale cofactor _ (ih (mul s w) (I-eq (trans (sym (mulA s (AP.power s K) w)) (L.mul-swap s (AP.power s K) w)) h)))) } ;
 } ;

 ---------------------------------------------------------------------
 -- Lemma 1 modulo I

 module Lemma (cs : List A.R) (nz : Nonzero cs) (root : I (Hs.horner cs)) {
  rel0 : Relation = strip cs nz zero (I-eq (sym (L.one-left (Hs.horner cs))) root) ;
  k : Nat = rel0.1 ;
  v : R = rel0.2.1 ;
  -- N = k + 1 >= 1
  rel : I (mul (AP.power s (suc k)) (add o (neg (mul s v)))) =
   I-eq (mulA s (AP.power s k) (add o (neg (mul s v)))) (I-scale s _ rel0.2.2) ;
  module Ide = Idempotent[v,k,rel] ;
 } ;
} ;
