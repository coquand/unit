-- Section 1 of zmt2-revised.tex from Q_0 to "Q'(y) is a unit mod J":
-- the loop (Loop.seg) with W = G^n H, followed by the Q' step
-- (DerivativeStep.seg).  Hypotheses as in the note: Horner(W) = G^n H in
-- A[X]; a monic relation Q_0(y) = 0 and W(y) in m R[y] (basis form); an
-- ideal J of B containing m (J = m E_g); H(y) in J, H'(y) and G(y) units
-- mod J.  Conclusion: the loop's Q satisfies Q(y) = 0, Q-bar | G^n H-bar,
-- and Q'(y) is a unit mod J, hence in no proper ideal containing J.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (B : CRing) (setB : Pr.isSet B.R) (iota : H.Hom A B) (y : B.R) (W : List A.R)
 (J : B.R -> U l) (J-zero : J B.z) (J-add : (a c : B.R) -> J a -> J c -> J (B.add a c))
 (J-scale : (a c : B.R) -> J c -> J (B.mul a c)) (J-m : (a : A.R) -> m a -> J (iota.1 a)) {
 module Lp = Loop[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iota,y,W] ;
 module DS = DerivativeStep[l].Over[A,setA,m,B,setB,iota,y,J,J-zero,J-add,J-scale,J-m] ;
 module RX = Lp.RX ;
 module Section1 (G Hp : RX.Carrier) (n : Nat)
  (wGH : Id RX.Carrier Lp.Wx (RX.ring.mul (AffinePowers[l].Over[RX.ring].power G n) Hp))
  (e0 : Nat) (a0 : Nat -> A.R) (rel0 : Id B.R (Lp.pw e0) (Lp.MP.V e0 a0)) (w0 : Lp.MP.InM e0 Lp.Wy)
  (hH : J (Lp.ev.1 Hp)) (hH' : DS.UnitMod (DS.der Hp)) (hG : DS.UnitMod (Lp.ev.1 G)) {
  r : Lp.Result = Lp.theorem e0 a0 rel0 w0 ;
  -- the loop's output
  e : Nat = r.1 ;
  a : Nat -> A.R = r.2.1 ;
  Q : RX.Carrier = Lp.Qx e a ;
  root : Id B.R (Lp.pw e) (Lp.MP.V e a) = r.2.2.1 ;
  divides : Id RX.Carrier (RX.ring.mul (AffinePowers[l].Over[RX.ring].power G n) Hp)
   (RX.ring.add (RX.ring.mul r.2.2.2.1 Q) (Lp.Px e r.2.2.2.2.1)) = trans (sym wGH) r.2.2.2.2.2.2 ;
  module QS = DS.Qprime[G,Hp,r.2.2.2.1,Q,n,e,r.2.2.2.2.1,r.2.2.2.2.2.1,divides,
   DS.J-eq (sym (trans (DS.val-ev Q) (Lp.eval-Q e a root))) J-zero,
   DS.J-eq (sym (DS.val-ev Hp)) hH,hH',subst DS.UnitMod (sym (DS.val-ev G)) hG] ;
  -- Q'(y) is a unit mod J
  q-prime : DS.UnitMod (DS.der Q) = QS.result ;
 } ;
} ;
