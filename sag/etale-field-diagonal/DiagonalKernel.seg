-- The kernel of multiplication on S tensor_R S is generated by the
-- differences of the finitely many algebra generators.  Quotient by those
-- differences: the two S-maps agree on generators, hence agree.  Coproduct
-- uniqueness then factors the quotient projection through multiplication.
-- This proves kernel generation without expanding tensor representatives.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Tn = Tensor[l].Over[R,setR] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D) {
  left : C.Hom S D = cp.1 ;
  right : C.Hom S D = cp.2.1 ;
  mu : C.Hom D S = (cp.2.2 S).sec (C.identity S,C.identity S) ;
  mu-left (s : S.ring.R) : Id S.ring.R (mu.1.1 (left.1.1 s)) s =
   ap (\ h -> h.1.1.1 s) ((cp.2.2 S).sec-eq (C.identity S,C.identity S)) ;
  mu-right (s : S.ring.R) : Id S.ring.R (mu.1.1 (right.1.1 s)) s =
   ap (\ h -> h.2.1.1 s) ((cp.2.2 S).sec-eq (C.identity S,C.identity S)) ;
  -- The universal map and its two equations, before any concrete tensor
  -- construction is substituted.  Later applications use these equations
  -- without opening the presented-algebra quotient construction.
  module To (B : C.Algebra) (f g : C.Hom S B) {
   arrow : C.Hom D B = (cp.2.2 B).sec (f,g) ;
   on-left (s : S.ring.R) : Id B.ring.R (arrow.1.1 (left.1.1 s)) (f.1.1 s) =
    ap (\ h -> h.1.1.1 s) ((cp.2.2 B).sec-eq (f,g)) ;
   on-right (s : S.ring.R) : Id B.ring.R (arrow.1.1 (right.1.1 s)) (g.1.1 s) =
    ap (\ h -> h.2.1.1 s) ((cp.2.2 B).sec-eq (f,g)) ;
  } ;
  surj (s : S.ring.R) : Tr.Trunc[(x : D.ring.R) * Id S.ring.R (mu.1.1 x) s].carrier =
   Tr.Trunc[(x : D.ring.R) * Id S.ring.R (mu.1.1 x) s].inc (left.1.1 s,mu-left s) ;
  module K = EtaleCase[l].Over[R,setR].Surjection[D,S,mu,surj] ;
  -- Coproduct uniqueness, stated pointwise on the two factors.
  hom-ext (B : C.Algebra) (f g : C.Hom D B)
   (hl : (s : S.ring.R) -> Id B.ring.R (f.1.1 (left.1.1 s)) (g.1.1 (left.1.1 s)))
   (hr : (s : S.ring.R) -> Id B.ring.R (f.1.1 (right.1.1 s)) (g.1.1 (right.1.1 s))) :
   Id (C.Hom D B) f g =
   Equivalences[l].injective (C.Hom D B) (C.Hom S B * C.Hom S B)
    (Tn.restrict S S D left right B) (cp.2.2 B) f g
    (Pr.trans (C.Hom S B * C.Hom S B) _ (C.compose S D B g left,C.compose S D B f right) _
     (Pr.ap (C.Hom S B) (C.Hom S B * C.Hom S B) (\ h -> (h,C.compose S D B f right)) _ _
      (C.ext S B (C.compose S D B f left) (C.compose S D B g left) hl))
     (Pr.ap (C.Hom S B) (C.Hom S B * C.Hom S B) (\ h -> (C.compose S D B g left,h)) _ _
      (C.ext S B (C.compose S D B f right) (C.compose S D B g right) hr))) ;
  difference (s : S.ring.R) : D.ring.R =
   D.ring.add (left.1.1 s) (D.ring.neg (right.1.1 s)) ;
  difference-in (s : S.ring.R) : K.Kernel (difference s) =
   K.difference (left.1.1 s) (right.1.1 s) (trans (mu-left s) (sym (mu-right s))) ;
  module Presented (p : P.Presentation) (ps : P.Presents p S) {
   k (i : Ps.Fin p.1) : D.ring.R = difference (ps.1.1 i) ;
   k-in (i : Ps.Fin p.1) : K.Kernel (k i) = difference-in (ps.1.1 i) ;
   module G = RegularIdeal[l].Generated[D.ring,p.1,k] ;
   module Q = QuotientRing[l].Over[D.ring,G.ideal,G.in-prop] ;
   B : C.Algebra = C.mkAlgebra Q.ring Q.set (H.compose R D.ring Q.ring Q.projection D.iota) ;
   projection : C.Hom D B = (Q.projection,\ r -> refl (Q.include (D.iota.1 r))) ;
   qleft : C.Hom S B = C.compose S D B projection left ;
   qright : C.Hom S B = C.compose S D B projection right ;
   generators-agree (i : Ps.Fin p.1) :
    Id Q.Carrier (qleft.1.1 (ps.1.1 i)) (qright.1.1 (ps.1.1 i)) =
    Q.Q.relates (left.1.1 (ps.1.1 i)) (right.1.1 (ps.1.1 i)) (G.generator i) ;
   agree : Id (C.Hom S B) qleft qright = Tn.hom-eq p S ps B qleft qright generators-agree ;
   factor : C.Hom D B = C.compose D S B qleft mu ;
   factor-eq : Id (C.Hom D B) projection factor =
    hom-ext B projection factor
     (\ s -> sym (ap qleft.1.1 (mu-left s)))
     (\ s -> trans (sym (ap (\ h -> h.1.1 s) agree)) (sym (ap qleft.1.1 (mu-right s)))) ;
   -- A kernel element has zero class in the quotient by the differences.
   kernel-generated (x : D.ring.R) (hx : K.Kernel x) : G.In x =
    Q.kernel x (trans (ap (\ h -> h.1.1 x) factor-eq)
     (trans (ap qleft.1.1 hx) (H.zero S.ring B.ring qleft.1))) ;
   gen (x : D.ring.R) (hx : K.Kernel x) :
    Tr.Trunc[(c : Ps.Fin p.1 -> D.ring.R) *
     Id D.ring.R x (FiniteIdeal[l].Sums[D.ring].lin p.1 k c)].carrier =
    TC.map (FiniteIdeal[l].Sums[D.ring].Coordinates p.1 k x)
     ((c : Ps.Fin p.1 -> D.ring.R) * Id D.ring.R x (FiniteIdeal[l].Sums[D.ring].lin p.1 k c))
     (\ c -> (c.1,sym c.2)) (kernel-generated x hx) ;
  } ;
 } ;
} ;
