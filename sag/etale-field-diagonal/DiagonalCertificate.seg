-- Formal unramifiedness gives the averaging element in the diagonal.
-- In D/J^2 the two maps from S agree after quotienting by J/J^2, a
-- square-zero ideal.  Unique therefore makes them equal already in D/J^2.
-- Effectiveness puts each generator difference in J^2.  Finite choice
-- supplies the matrix for IdempotentIdeal, entirely under truncation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module E = FormallyEtale[l].Over[R,setR] ;
 module Tn = Tensor[l].Over[R,setR] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D) {
  module DK = DiagonalKernel[l].Over[R,setR].At[S,D,cp] ;
  record Witness {
   epsilon : D.ring.R ;
   mu-one : Id S.ring.R (DK.mu.1.1 epsilon) S.ring.o ;
   equalises (s : S.ring.R) :
    Id D.ring.R (D.ring.mul epsilon (DK.left.1.1 s)) (D.ring.mul epsilon (DK.right.1.1 s)) ;
   idempotent : Id D.ring.R (D.ring.mul epsilon epsilon) epsilon ;
  } ;
  module Presented (p : P.Presentation) (ps : P.Presents p S) (unique : E.Unique S) {
   module G = DK.Presented[p,ps] ;
   module Sq = FiniteKernelSquare[l].Over[R,setR].At[D,S,DK.mu,DK.surj,p.1,G.k,G.gen] ;
   left2 : C.Hom S Sq.Cq = C.compose S D Sq.Cq Sq.p DK.left ;
   right2 : C.Hom S Sq.Cq = C.compose S D Sq.Cq Sq.p DK.right ;
   -- Agreement after the square-zero quotient, for every element of S.
   reduced-agree :
    Id (C.Hom S Sq.M.algebra) (E.reduce S Sq.Cq Sq.N left2) (E.reduce S Sq.Cq Sq.N right2) =
    C.ext S Sq.M.algebra (E.reduce S Sq.Cq Sq.N left2) (E.reduce S Sq.Cq Sq.N right2)
     (\ s -> Sq.reduced-equal (DK.left.1.1 s) (DK.right.1.1 s) (DK.difference-in s)) ;
   agree : Id (C.Hom S Sq.Cq) left2 right2 = unique Sq.Cq Sq.N left2 right2 reduced-agree ;
   factor : C.Hom D Sq.Cq = C.compose D S Sq.Cq left2 DK.mu ;
   factor-eq : Id (C.Hom D Sq.Cq) Sq.p factor =
    DK.hom-ext Sq.Cq Sq.p factor
     (\ s -> sym (ap left2.1.1 (DK.mu-left s)))
     (\ s -> trans (sym (ap (\ h -> h.1.1 s) agree)) (sym (ap left2.1.1 (DK.mu-right s)))) ;
   -- Both inclusions are explicit: this is J = J^2, not just its
   -- restriction to the chosen generator differences.
   kernel-square (x : D.ring.R) (hx : DK.K.Kernel x) : Sq.InSquare x =
    Sq.Q2.kernel x (trans (ap (\ h -> h.1.1 x) factor-eq)
     (trans (ap left2.1.1 hx) (H.zero S.ring Sq.Cq.ring left2.1))) ;
   difference-square (s : S.ring.R) : Sq.InSquare (DK.difference s) =
    Sq.Q2.Q.effective (DK.left.1.1 s) (DK.right.1.1 s) (ap (\ h -> h.1.1 s) agree) ;
   certificates : Tr.Trunc[(i : Ps.Fin p.1) -> Sq.Certificate (G.k i)].carrier =
    AffineFinite[l].choice p.1 (\ i -> Sq.Certificate (G.k i)) (\ i -> difference-square (ps.1.1 i)) ;
   module Construct (cert : (i : Ps.Fin p.1) -> Sq.Certificate (G.k i)) {
    module II = IdempotentIdeal[l].Over[D.ring,D.set,DK.K.ideal,p.1,G.k,G.gen,
     \ j i -> (cert i).1 j,\ j i -> (cert i).2.1 j,\ i -> (cert i).2.2] ;
    -- The determinant is 1 modulo the multiplication kernel.
    mu-one : Id S.ring.R (DK.mu.1.1 II.f) S.ring.o =
     sym (FormallyEtale[l].Units[S.ring,S.set].sub-zero S.ring.o (DK.mu.1.1 II.f)
      (trans (sym (trans (DK.mu.1.2.2.1 D.ring.o (D.ring.neg II.f))
        (Ps.cong2 S.ring.R S.ring.add _ _ _ _ DK.mu.1.2.1
         (H.negation D.ring S.ring DK.mu.1 II.f)))) II.one-minus)) ;
    equalises (s : S.ring.R) :
     Id D.ring.R (D.ring.mul II.f (DK.left.1.1 s)) (D.ring.mul II.f (DK.right.1.1 s)) =
     FormallyEtale[l].Units[D.ring,D.set].sub-zero
      (D.ring.mul II.f (DK.left.1.1 s)) (D.ring.mul II.f (DK.right.1.1 s))
      (trans (sym (trans (D.ring.dist II.f (DK.left.1.1 s) (D.ring.neg (DK.right.1.1 s)))
        (ap (D.ring.add (D.ring.mul II.f (DK.left.1.1 s)))
         (RL[D.ring].mul-neg II.f (DK.right.1.1 s)))))
       (II.f-kills-all (DK.difference s) (DK.difference-in s))) ;
    witness : Witness = mkWitness II.f mu-one equalises II.idempotent ;
   } ;
   theorem : Tr.Trunc[Witness].carrier =
    TC.map ((i : Ps.Fin p.1) -> Sq.Certificate (G.k i)) Witness
     (\ cert -> Construct[cert].witness) certificates ;
  } ;
  -- No chosen finite presentation is required by this export.
  theorem (fp : P.FP S) (unique : E.Unique S) : Tr.Trunc[Witness].carrier =
   Truncation[l+].Trunc[P.Witness S].induction @l (\ w -> Tr.Trunc[Witness].carrier)
    (\ w -> Tr.Trunc[Witness].proposition) (\ w -> Presented[w.1,w.2,unique].theorem) fp ;
 } ;
 -- Construct the tensor product too, given a presentation of S.
 module Concrete (p : P.Presentation) (S : C.Algebra) (ps : P.Presents p S) (unique : E.Unique S) {
  module T = Tn.Presented[p,p,S,S,ps,ps] ;
  module Diag = At[S,T.T,T.coproduct] ;
  theorem : Tr.Trunc[Diag.Witness].carrier = Diag.Presented[p,ps,unique].theorem ;
 } ;
 Result (S : C.Algebra) : U l+ =
  (D : C.Algebra) * (cp : Tn.Coproduct S S D) * At[S,D,cp].Witness ;
 from-presentation (S : C.Algebra) (unique : E.Unique S) (w : P.Witness S) :
  Truncation[l+].Trunc[Result S].carrier =
  Tr.Trunc[Concrete[w.1,S,w.2,unique].Diag.Witness].induction @(l+)
   (\ e -> Truncation[l+].Trunc[Result S].carrier)
   (\ e -> Truncation[l+].Trunc[Result S].proposition)
   (\ e -> Truncation[l+].Trunc[Result S].inc
    (Concrete[w.1,S,w.2,unique].T.T,Concrete[w.1,S,w.2,unique].T.coproduct,e))
   Concrete[w.1,S,w.2,unique].theorem ;
 exists (S : C.Algebra) (fp : P.FP S) (unique : E.Unique S) :
  Truncation[l+].Trunc[Result S].carrier =
  Truncation[l+].Trunc[P.Witness S].induction @(l+)
   (\ w -> Truncation[l+].Trunc[Result S].carrier)
   (\ w -> Truncation[l+].Trunc[Result S].proposition) (from-presentation S unique) fp ;
} ;
