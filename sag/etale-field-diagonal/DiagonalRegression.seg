-- Empty presentation over any base, including the zero ring; and a
-- nontrivial diagonal over Z/4Z.  For S standard for X^2-X, the mixed
-- tensor evaluation (x on the left -> 0, x on the right -> 1) kills the
-- constructed averaging element.  Its multiplication image is 1, so
-- this element is neither 0 nor 1.  Thus the test cannot pass by simply
-- taking the unit as the diagonal certificate.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Empty (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module E = FormallyEtale[l].Over[R,setR] ;
 module B = BasePresentation[l].Over[R,setR] ;
 unique : E.Unique C.base = \ A N f g e ->
  C.ext C.base A f g (\ r -> trans (f.2 r) (sym (g.2 r))) ;
 module D = DiagonalCertificate[l].Over[R,setR].Concrete[B.empty,C.base,B.presentation,unique] ;
 theorem : Tr.Trunc[D.Diag.Witness].carrier = D.theorem ;
 all-data : Truncation[l+].Trunc[DiagonalCertificate[l].Over[R,setR].Result C.base].carrier =
  DiagonalCertificate[l].Over[R,setR].exists C.base B.finitely-presented unique ;
} ;
module Z = FlatRegression[l] ;
module Nontrivial (rq : Z.Reps.Representation Z.q) (rg : Z.Reps.Representation Z.Pt.g) {
 module X = Z.Test[rq,rg] ;
 module D = DiagonalCertificate[l].Over[Z.A,ZMod4[l].set].Concrete[X.etale.2.1,X.S,X.etale.2.2,X.etale.1.2] ;
 module DK = D.Diag.DK ;
 module Mixed = DK.To[Z.C.base,X.u,X.v] ;
 mixed-left : Id Z.A.R (Mixed.arrow.1.1 (DK.left.1.1 X.x)) Z.A.z =
  trans (Mixed.on-left X.x) X.ux ;
 mixed-right : Id Z.A.R (Mixed.arrow.1.1 (DK.right.1.1 X.x)) Z.A.o =
  trans (Mixed.on-right X.x) X.vx ;
 module Check (e : D.Diag.Witness) {
  mixed-zero : Id Z.A.R (Mixed.arrow.1.1 e.epsilon) Z.A.z =
   calc Z.A.R {
    Mixed.arrow.1.1 e.epsilon
     =< sym (Z.A.mulO (Mixed.arrow.1.1 e.epsilon)) > Z.A.mul (Mixed.arrow.1.1 e.epsilon) Z.A.o
     =< ap (Z.A.mul (Mixed.arrow.1.1 e.epsilon)) (sym mixed-right)
      > Z.A.mul (Mixed.arrow.1.1 e.epsilon) (Mixed.arrow.1.1 (DK.right.1.1 X.x))
     =< sym (Mixed.arrow.1.2.2.2 e.epsilon (DK.right.1.1 X.x))
      > Mixed.arrow.1.1 (D.T.T.ring.mul e.epsilon (DK.right.1.1 X.x))
     =< ap Mixed.arrow.1.1 (sym (e.equalises X.x))
      > Mixed.arrow.1.1 (D.T.T.ring.mul e.epsilon (DK.left.1.1 X.x))
     =< Mixed.arrow.1.2.2.2 e.epsilon (DK.left.1.1 X.x)
      > Z.A.mul (Mixed.arrow.1.1 e.epsilon) (Mixed.arrow.1.1 (DK.left.1.1 X.x))
     =< ap (Z.A.mul (Mixed.arrow.1.1 e.epsilon)) mixed-left > Z.A.mul (Mixed.arrow.1.1 e.epsilon) Z.A.z
     =< RL[Z.A].mul-zero (Mixed.arrow.1.1 e.epsilon) > Z.A.z } ;
  not-one : Not (Id D.T.T.ring.R e.epsilon D.T.T.ring.o) = \ h ->
   Z.different (trans (sym Mixed.arrow.1.2.1) (trans (ap Mixed.arrow.1.1 (sym h)) mixed-zero)) ;
  not-zero : Not (Id D.T.T.ring.R e.epsilon D.T.T.ring.z) = \ h ->
   Z.different (trans (sym X.u.1.2.1)
    (trans (ap X.u.1.1 (trans (sym e.mu-one) (trans (ap DK.mu.1.1 h) (H.zero D.T.T.ring X.S.ring DK.mu.1))))
     (H.zero X.S.ring Z.A X.u.1))) ;
 } ;
 Result : U l = (e : D.Diag.Witness) *
  Not (Id D.T.T.ring.R e.epsilon D.T.T.ring.o) * Not (Id D.T.T.ring.R e.epsilon D.T.T.ring.z) ;
 theorem : Tr.Trunc[Result].carrier =
  TruncationCombinators[l].map D.Diag.Witness Result
   (\ e -> (e,Check[e].not-one,Check[e].not-zero)) D.theorem ;
} ;
Regression : U l = (rq : Z.Reps.Representation Z.q) * (rg : Z.Reps.Representation Z.Pt.g) *
 Tr.Trunc[Nontrivial[rq,rg].Result].carrier ;
regression : Tr.Trunc[Regression].carrier =
 TruncationCombinators[l].map2 (Z.Reps.Representation Z.q) (Z.Reps.Representation Z.Pt.g) Regression
  (\ rq rg -> (rq,rg,Nontrivial[rq,rg].theorem)) (Z.Reps.representation Z.q) (Z.Reps.representation Z.Pt.g) ;
