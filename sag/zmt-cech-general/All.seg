-- Generic finite-coordinate Cech contraction; reuses checked libraries.
-- ZMT lifting: finite relation certificates (Stage 1) and the four-chart
-- cubic test J = (X_0^3, X_1^3) (Stage 2).  Informal proof:
-- doc/zmt-formal-cohomology.tex and doc/zmt-lifting-handoff.txt; status:
-- README.txt.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ; import Poly ; import Mul ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 -- reused libraries (relative links, unchanged)
 import Truncation ; import Quotient ;
 import RawLaws ; import RawMultiplication ; import RingHom ; import PolynomialRing ; import Evaluation ; import Universal ;
 import Algebras ; import Presentations ; import Torsor ; import AffineFinite ; import FiniteIdeal ; import MnSums ;
 import NCAlgebra ; import AlgSIP ; import ExteriorModel ; import ExteriorAlgebra ;
 import TruncationCombinators ; import NatOrder ; import Bar ; import Span ; import FiniteJets ; import Logic ; import NatArith ;
 import IdealPowers ; import ModSpan ; import Comb ; import Coherent ; import FreeCoherent ; import FreeDisc ; import Spans ;
 import FreeNoeth ; import LinIso ; import CodedNoeth ; import CFN ;
 -- Stage 1
 import RelationCertificate ; import CertifiedDependence ; import LinearCertificate ;
 -- Stage 2: reused three-variable Cech libraries (SubMod, Int)
 import ZInt ; import Laurent3 ; import Cech3 ; import CechContraction ; import CechMonomials ; import LaurentList ; import CechModules ;
 -- Stage 2
 import Laurent4 ; import Cech4 ; import Cech4Contraction ; import TopList4 ; import TopCoordinates4 ; import CubicCertificate ;
 -- the integers as a CFN ring (artin-rees, Prop. 13 for Z)
 import Integers ; import ZRing ; import ZArith ; import ZCFN ;
 import CubicDependence ; import CubicExample ;
 import GenericCube ; import GenericContraction ; import GenericSupport ; import GenericDegree ; import GenericLaurent ; import GenericCech ; import GenericTop ; import GenericCardinality ; import GenericCechTheorems ; import GenericRegression ;
} ;
