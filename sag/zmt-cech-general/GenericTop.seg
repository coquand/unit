-- The exceptional projection is either identity (every coordinate
-- negative) or zero. Chart support then concentrates its image at the
-- full subset. Consequently pi d=0, and top cochains split as d h+pi.
level l ; open Ring[l] ; open GenericCube[l] ;
module B = GenericSupport[l] ; module IP = IdealPowers[l] ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 open D ; module C = GenericCube[l].Over[D,setD] ; open C ;
 module H = GenericContraction[l].Over[D,setD] ;
 module S = GenericSupport[l].Over[D,setD] ;
 module G = IP.ModL[D,IP.regular D] ;
 IsId (n : Nat) (mask : Sub n) : U l = (c : Raw n) -> Eq n (H.proj n mask c) c ;
 IsZero (n : Nat) (mask : Sub n) : U l = (c : Raw n) -> Eq n (H.proj n mask c) (zeroR n) ;
 -- A constructive choice determined by the exponent signs alone.
 choice : (n : Nat) (mask : Sub n) -> Plus (IsId n mask) (IsZero n mask) = split {
   zero -> \ mask -> inl (\ c s -> refl (c s)) ;
   suc n | r -> \ mask -> chooseS n r mask.1 mask.2 }
 where {
   liftId (n : Nat) (mask : Sub n) (e : IsId n mask) (c : Raw (suc n)) :
     (f : Flag) (s : Sub n) -> Id R (H.proj (suc n) (present,mask) c (f,s)) (c (f,s)) = split {
       absent -> e (left n c) ; present -> e (right n c) } ;
   liftZero (n : Nat) (mask : Sub n) (e : IsZero n mask) (c : Raw (suc n)) :
     (f : Flag) (s : Sub n) -> Id R (H.proj (suc n) (present,mask) c (f,s)) z = split {
       absent -> e (left n c) ; present -> e (right n c) } ;
   liftChoice (n : Nat) (mask : Sub n) : Plus (IsId n mask) (IsZero n mask) ->
     Plus (IsId (suc n) (present,mask)) (IsZero (suc n) (present,mask)) = split {
       inl e -> inl (\ c s -> liftId n mask e c s.1 s.2) ;
       inr e -> inr (\ c s -> liftZero n mask e c s.1 s.2) } ;
   chooseS (n : Nat) (r : (mask : Sub n) -> Plus (IsId n mask) (IsZero n mask)) :
     (f : Flag) (mask : Sub n) -> Plus (IsId (suc n) (f,mask)) (IsZero (suc n) (f,mask)) = split {
       absent -> \ mask -> inr (\ c s -> refl z) ;
       present -> \ mask -> liftChoice n mask (r mask) } } ;
 p-d-case (n : Nat) (mask : Sub n) (c : Raw n) : Plus (IsId n mask) (IsZero n mask) ->
   Eq n (H.proj n mask (diff n c)) (diff n (H.proj n mask c)) = split {
     inl e -> \ s -> trans (e (diff n c) s) (sym (d-cong n (H.proj n mask c) c (e c) s)) ;
     inr e -> \ s -> trans (e (diff n c) s) (sym (S.all-d-zero n (H.proj n mask c) (e c) s)) } ;
 p-d (n : Nat) (mask : Sub n) (c : Raw n) : Eq n (H.proj n mask (diff n c)) (diff n (H.proj n mask c)) =
   p-d-case n mask c (choice n mask) ;
 p-add-case (n : Nat) (mask : Sub n) (c c' : Raw n) : Plus (IsId n mask) (IsZero n mask) ->
   Eq n (H.proj n mask (addR n c c')) (addR n (H.proj n mask c) (H.proj n mask c')) = split {
     inl e -> \ s -> trans (e (addR n c c') s) (sym (G.G.cong-add (e c s) (e c' s))) ;
     inr e -> \ s -> trans (e (addR n c c') s)
       (sym (trans (G.G.cong-add (e c s) (e c' s)) (addZ z))) } ;
 p-add (n : Nat) (mask : Sub n) (c c' : Raw n) :
   Eq n (H.proj n mask (addR n c c')) (addR n (H.proj n mask c) (H.proj n mask c')) = p-add-case n mask c c' (choice n mask) ;
 p-sm-case (n : Nat) (mask : Sub n) (a : R) (c : Raw n) : Plus (IsId n mask) (IsZero n mask) ->
   Eq n (H.proj n mask (smR n a c)) (smR n a (H.proj n mask c)) = split {
     inl e -> \ s -> trans (e (smR n a c) s) (sym (ap (mul a) (e c s))) ;
     inr e -> \ s -> trans (e (smR n a c) s) (sym (trans (ap (mul a) (e c s)) (RL[D].mul-zero a))) } ;
 p-sm (n : Nat) (mask : Sub n) (a : R) (c : Raw n) :
   Eq n (H.proj n mask (smR n a c)) (smR n a (H.proj n mask c)) = p-sm-case n mask a c (choice n mask) ;
 TopOnly (n : Nat) (c : Raw n) : U l = (s : Sub n) -> B.missing n s -> Id R (c s) z ;
 -- A family concentrated at the full subset has zero outgoing boundary.
 d-top : (n : Nat) (c : Raw n) -> TopOnly n c -> Eq n (diff n c) (zeroR n) = split {
   zero -> \ c v s -> refl z ;
   suc n | r -> \ c v s -> dTopS n r c v s.1 s.2 }
 where {
   dTopS (n : Nat) (r : (c : Raw n) -> TopOnly n c -> Eq n (diff n c) (zeroR n))
     (c : Raw (suc n)) (v : TopOnly (suc n) c) : (f : Flag) (s : Sub n) -> Id R (diff (suc n) c (f,s)) z = split {
       absent -> S.all-d-zero n (left n c) (\ t -> v (absent,t) tt) ;
       present -> \ s -> S.zero-sub (left n c s) (diff n (right n c) s)
         (v (absent,s) tt) (r (right n c) (\ t b -> v (present,t) b) s) } } ;
 p-top (n : Nat) (mask : Sub n) (c : Raw n) (v : S.Van n mask c) : TopOnly n (H.proj n mask c) =
   S.p-missing n mask c v ;
 pd-zero (n : Nat) (mask : Sub n) (c : Raw n) (v : S.Van n mask c) :
   Eq n (H.proj n mask (diff n c)) (zeroR n) = \ s ->
     trans (p-d n mask c s) (d-top n (H.proj n mask c) (p-top n mask c v) s) ;
 decomposition (n : Nat) (mask : Sub n) (c : Raw n) (closed : Eq n (diff n c) (zeroR n)) (s : Sub n) :
   Id R (add (diff n (H.hom n mask c) s) (H.proj n mask c s)) (c s) =
   trans (ap (\ x -> add x (H.proj n mask c s)) (sym (addZ (diff n (H.hom n mask c) s))))
     (trans (ap (\ x -> add (add (diff n (H.hom n mask c) s) x) (H.proj n mask c s))
       (sym (S.all-h-zero n mask (diff n c) closed s))) (H.htpy n mask c s)) ;
 top-decomposition (n : Nat) (mask : Sub n) (c : Raw n) (top : TopOnly n c) (s : Sub n) :
   Id R (add (diff n (H.hom n mask c) s) (H.proj n mask c s)) (c s) = decomposition n mask c (d-top n c top) s ;
} ;
