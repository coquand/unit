-- A proper subset has cardinality different from the full subset.
-- The strengthened bound avoids importing an order on integer degrees.
level l ; open Ring[l] ; open GenericCube[l] ;
module Z = ZInt[l] ; module K = GenericDegree[l] ; module B = GenericSupport[l] ;
module ZZ { open ZInt[l] ; positive (n : Base.Nat) : Int = pos n ; } ;
module BN { open Base ; zz : Base.Nat = zero ; inc (x : Base.Nat) : Base.Nat = suc x ; } ;
raise : Nat -> Z.Int -> Z.Int = split { zero -> \ x -> x ; suc n | r -> \ x -> Z.sucZ (r x) } ;
raise-suc : (n : Nat) (x : Z.Int) -> Id Z.Int (raise n (Z.sucZ x)) (Z.sucZ (raise n x)) = split {
 zero -> \ x -> refl (Z.sucZ x) ; suc n | r -> \ x -> ap Z.sucZ (r x) } ;
riseNat : Nat -> Base.Nat -> Base.Nat = split { zero -> \ x -> x ; suc n | r -> \ x -> BN.inc (r x) } ;
raise-pos : (n : Nat) (x : Base.Nat) -> Id Z.Int (raise n (ZZ.positive x)) (ZZ.positive (riseNat n x)) = split {
 zero -> \ x -> refl (ZZ.positive x) ; suc n | r -> \ x -> ap Z.sucZ (r x) } ;
zero-bound (j : Nat) : Not (Id Z.Int Z.zeroZ (Z.sucZ (raise j Z.zeroZ))) = \ e ->
 Prelude[l].absurd Empty (Z.encode Z.zeroZ (ZZ.positive (BN.inc (riseNat j BN.zz))) (trans e (ap Z.sucZ (raise-pos j BN.zz)))) ;
bound : (n : Nat) (s : Sub n) (j : Nat) -> Not (Id Z.Int (K.card n s) (Z.sucZ (raise j (K.topRank n)))) = split {
 zero -> \ s j -> zero-bound j ;
 suc n | r -> \ s j -> boundS n r s.1 s.2 j }
where {
 boundS (n : Nat) (r : (s : Sub n) (j : Nat) -> Not (Id Z.Int (K.card n s) (Z.sucZ (raise j (K.topRank n))))) :
   (f : Flag) (s : Sub n) (j : Nat) -> Not (Id Z.Int (K.card (suc n) (f,s)) (Z.sucZ (raise j (K.topRank (suc n))))) = split {
   absent -> \ s j e -> r s (suc j) (trans e (ap Z.sucZ (raise-suc j (K.topRank n)))) ;
   present -> \ s j e -> r s j (trans (sym (Z.pred-suc (K.card n s)))
     (trans (ap Z.predZ e) (trans (Z.pred-suc (raise j (Z.sucZ (K.topRank n)))) (raise-suc j (K.topRank n))))) } } ;
proper : (n : Nat) (s : Sub n) -> B.missing n s -> Not (Id Z.Int (K.card n s) (K.topRank n)) = split {
 zero -> \ s b e -> b ;
 suc n | r -> \ s -> properS n r s.1 s.2 }
where {
 properS (n : Nat) (r : (s : Sub n) -> B.missing n s -> Not (Id Z.Int (K.card n s) (K.topRank n))) :
   (f : Flag) (s : Sub n) -> B.missing (suc n) (f,s) -> Not (Id Z.Int (K.card (suc n) (f,s)) (K.topRank (suc n))) = split {
   absent -> \ s b -> bound n s zero ;
   present -> \ s b e -> r s b (trans (sym (Z.pred-suc (K.card n s))) (trans (ap Z.predZ e) (Z.pred-suc (K.topRank n)))) } } ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ; module G = GenericDegree[l].Over[D,setD] ; module T = GenericTop[l].Over[D,setD] ;
 rank-top (n : Nat) (c : C.Raw n) (rank : G.Rank n (K.topRank n) c) : T.TopOnly n c = \ s b -> rank s (proper n s b) ;
} ;
