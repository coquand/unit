-- Concrete dimensions, edge cases, and signs compared with Cech4's
-- characterising formulas. Labels 0,1,... follow nested tuple order:
-- the newest Fin vertex is label 0, so no orientation transport occurs.
level l ; open Ring[l] ; open GenericCube[l] ;
module K = GenericDegree[l] ; module Z = ZInt[l] ; module L = GenericLaurent[l] ;
n1 : Nat = suc zero ; n2 : Nat = suc n1 ; n3 : Nat = suc n2 ; n4 : Nat = suc n3 ;
s2 (a b : Flag) : Sub n2 = (a,(b,tt)) ;
s3 (a b c : Flag) : Sub n3 = (a,(b,(c,tt))) ;
s4 (a b c d : Flag) : Sub n4 = (a,(b,(c,(d,tt)))) ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 open D ; module C = GenericCube[l].Over[D,setD] ;
 module H = GenericContraction[l].Over[D,setD] ; module T = GenericTop[l].Over[D,setD] ;
 module E = GenericCech[l].Over[D,setD] ; module F = GenericCechTheorems[l].Over[D,setD] ;
 module Old = Cech4[l].Over[D,setD] ; module G = IdealPowers[l].ModL[D,IdealPowers[l].regular D] ;
 -- n=0 is the one-term augmented empty-coordinate complex.
 empty-d (c : C.Raw zero) : C.Eq zero (C.diff zero c) (C.zeroR zero) = \ s -> refl z ;
 empty-h (c : C.Raw zero) : C.Eq zero (H.hom zero tt c) (C.zeroR zero) = \ s -> refl z ;
 empty-p (c : C.Raw zero) : C.Eq zero (H.proj zero tt c) c = \ s -> refl (c s) ;
 -- One vertex: h takes the present component to the augmentation when
 -- its exponent is nonnegative, and is zero when it is negative.
 one-h-positive (c : C.Raw n1) : Id R (H.hom n1 (absent,tt) c (absent,tt)) (c (present,tt)) = refl (c (present,tt)) ;
 one-h-negative (c : C.Raw n1) : Id R (H.hom n1 (present,tt) c (absent,tt)) z = refl z ;
 -- The two-vertex face has the existing sign c_1-c_0.
 edge (c : C.Raw n2) : Id R (C.diff n2 c (s2 present present))
   (G.msub (c (s2 absent present)) (c (s2 present absent))) =
   ap (G.msub (c (s2 absent present))) (Old.sub-zero-r (c (s2 present absent))) ;
 -- In three vertices: c_12-c_02+c_01, exactly Cech4.d1.
 triangle (c : C.Raw n3) : Id R (C.diff n3 c (full n3))
   (add (G.msub (c (s3 absent present present)) (c (s3 present absent present))) (c (s3 present present absent))) =
   trans (ap (\ x -> G.msub (c (s3 absent present present)) (G.msub (c (s3 present absent present)) x))
     (Old.sub-zero-r (c (s3 present present absent))))
     (sym (Old.sub-add (c (s3 absent present present)) (c (s3 present absent present)) (c (s3 present present absent)))) ;
 -- In four vertices: ((c_123-c_023)+c_013)-c_012,
 -- exactly Cech4.d2; no sign table enters the generic proof.
 tetrahedron (c : C.Raw n4) : Id R (C.diff n4 c (full n4))
   (G.msub (add (G.msub (c (s4 absent present present present)) (c (s4 present absent present present)))
     (c (s4 present present absent present))) (c (s4 present present present absent))) =
   trans (ap (\ x -> G.msub (c (s4 absent present present present))
     (G.msub (c (s4 present absent present present)) (G.msub (c (s4 present present absent present)) x)))
       (Old.sub-zero-r (c (s4 present present present absent))))
     (trans (sym (Old.sub-add (c (s4 absent present present present)) (c (s4 present absent present present))
       (G.msub (c (s4 present present absent present)) (c (s4 present present present absent)))))
       (addA (G.msub (c (s4 absent present present present)) (c (s4 present absent present present)))
         (c (s4 present present absent present)) (neg (c (s4 present present present absent))))) ;
 -- Actual cochain primitives in the middle dimensions of P^2 and P^3.
 -- The unequal cardinalities are discharged by integer normal forms.
 neq32 : Not (Id Z.Int (K.topRank n3) (K.topRank n2)) = \ e -> Prelude[l].absurd Empty (Z.encode _ _ e) ;
 neq42 : Not (Id Z.Int (K.topRank n4) (K.topRank n2)) = \ e -> Prelude[l].absurd Empty (Z.encode _ _ e) ;
 neq43 : Not (Id Z.Int (K.topRank n4) (K.topRank n3)) = \ e -> Prelude[l].absurd Empty (Z.encode _ _ e) ;
 module P2 (k : Z.Int) {
   module O = E.Operations[n3,k,K.topRank n2] ;
   module Closed (c : O.A.El) (hc : O.Closed c) {
     module P = O.Primitive[c,neq32,hc] ;
     primitive : O.Down.El = P.primitive ;
     equation (s : Sub n3) (m : L.Exp n3) : Id R (C.diff n3 (\ t -> O.Down.val primitive t m) s) (O.A.val c s m) = P.equation s m ;
   } ;
 } ;
 module P3Degree1 (k : Z.Int) {
   module O = E.Operations[n4,k,K.topRank n2] ;
   module Closed (c : O.A.El) (hc : O.Closed c) {
     module P = O.Primitive[c,neq42,hc] ; primitive : O.Down.El = P.primitive ; equation (s : Sub n4) (m : L.Exp n4) : Id R (C.diff n4 (\ t -> O.Down.val primitive t m) s) (O.A.val c s m) = P.equation s m ;
   } ;
 } ;
 module P3Degree2 (k : Z.Int) {
   module O = E.Operations[n4,k,K.topRank n3] ;
   module Closed (c : O.A.El) (hc : O.Closed c) {
     module P = O.Primitive[c,neq43,hc] ; primitive : O.Down.El = P.primitive ; equation (s : Sub n4) (m : L.Exp n4) : Id R (C.diff n4 (\ t -> O.Down.val primitive t m) s) (O.A.val c s m) = P.equation s m ;
   } ;
 } ;
 module P2Top (k : Z.Int) { module Top = F.Top[n3,k] ; } ;
 module P3Top (k : Z.Int) { module Top = F.Top[n4,k] ; } ;
} ;
