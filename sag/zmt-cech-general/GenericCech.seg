-- Finite Laurent cochains in arbitrary finite coordinate dimension.
-- r is subset cardinality (ordinary Cech degree is r-1); k is the
-- projective Laurent degree. The empty subset supplies the augmentation.
level l ; open Ring[l] ; open GenericCube[l] ;
module Z = ZInt[l] ; module L = GenericLaurent[l] ;
module K = GenericDegree[l] ; module B = GenericSupport[l] ;
module TC = TruncationCombinators[l] ; module IP = IdealPowers[l] ;

Bad (n : Nat) (k r : Z.Int) (s : Sub n) (m : L.Exp n) : U l =
 Plus (Not (Id Z.Int (L.total n m) k))
   (Plus (B.bad n (L.mask n m) s) (Not (Id Z.Int (K.card n s) r))) ;

module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ;
 module H = GenericContraction[l].Over[D,setD] ;
 module S = GenericSupport[l].Over[D,setD] ;
 module G = GenericDegree[l].Over[D,setD] ;
 module F = GenericLaurent[l].Over[D,setD] ;
 module LO = Laurent4[l].Over[D,setD] ;
 module Cochains (n : Nat) (k r : Z.Int) {
   module M = F.Chart[L.Exp n,Sub n,Bad n k r] ;
   mod : IP.Mod[D] = M.mod ; El : U l = M.El ;
   val : El -> M.Raw = M.val ;
   fibre (c : El) (m : L.Exp n) : C.Raw n = \ s -> val c s m ;
   support (c : El) (m : L.Exp n) : S.Van n (L.mask n m) (fibre c m) =
     \ s b -> M.van c s m (inr (inl b)) ;
   rank (c : El) (m : L.Exp n) : G.Rank n r (fibre c m) =
     \ s e -> M.van c s m (inr (inr e)) ;
   projective (c : El) (m : L.Exp n) (e : Not (Id Z.Int (L.total n m) k)) :
     C.Eq n (fibre c m) (C.zeroR n) = \ s -> M.van c s m (inl e) ;
 } ;
 module Operations (n : Nat) (k r : Z.Int) {
   module A = Cochains[n,k,r] ; module Up = Cochains[n,k,Z.sucZ r] ;
   module Down = Cochains[n,k,Z.predZ r] ;
   dRaw (c : A.El) : Up.M.Raw = \ s m -> C.diff n (A.fibre c m) s ;
   hRaw (c : A.El) : Down.M.Raw = \ s m -> H.hom n (L.mask n m) (A.fibre c m) s ;
   pRaw (c : A.El) : A.M.Raw = \ s m -> H.proj n (L.mask n m) (A.fibre c m) s ;
   dSupp (c : A.El) : Up.M.Supp (dRaw c) = TC.map (A.M.SuppW (A.val c)) (Up.M.SuppW (dRaw c))
     (\ w -> (w.1, \ s m nm -> S.all-d-zero n (A.fibre c m) (\ t -> w.2 t m nm) s)) (A.M.supp c) ;
   hSupp (c : A.El) : Down.M.Supp (hRaw c) = TC.map (A.M.SuppW (A.val c)) (Down.M.SuppW (hRaw c))
     (\ w -> (w.1, \ s m nm -> S.all-h-zero n (L.mask n m) (A.fibre c m) (\ t -> w.2 t m nm) s)) (A.M.supp c) ;
   pSupp (c : A.El) : A.M.Supp (pRaw c) = TC.map (A.M.SuppW (A.val c)) (A.M.SuppW (pRaw c))
     (\ w -> (w.1, \ s m nm -> S.p-zero-at n (L.mask n m) (A.fibre c m) s (w.2 s m nm))) (A.M.supp c) ;
   dVan (c : A.El) (s : Sub n) (m : L.Exp n) : Bad n k (Z.sucZ r) s m -> Id D.R (dRaw c s m) D.z = split {
     inl e -> S.all-d-zero n (A.fibre c m) (A.projective c m e) s ;
     inr b -> dOther c s m b }
   where { dOther (c : A.El) (s : Sub n) (m : L.Exp n) :
     Plus (B.bad n (L.mask n m) s) (Not (Id Z.Int (K.card n s) (Z.sucZ r))) -> Id D.R (dRaw c s m) D.z = split {
       inl b -> S.d-van n (L.mask n m) (A.fibre c m) (A.support c m) s b ;
       inr e -> G.d-rank n r (A.fibre c m) (A.rank c m) s e } } ;
   hVan (c : A.El) (s : Sub n) (m : L.Exp n) : Bad n k (Z.predZ r) s m -> Id D.R (hRaw c s m) D.z = split {
     inl e -> S.all-h-zero n (L.mask n m) (A.fibre c m) (A.projective c m e) s ;
     inr b -> hOther c s m b }
   where { hOther (c : A.El) (s : Sub n) (m : L.Exp n) :
     Plus (B.bad n (L.mask n m) s) (Not (Id Z.Int (K.card n s) (Z.predZ r))) -> Id D.R (hRaw c s m) D.z = split {
       inl b -> S.h-van n (L.mask n m) (A.fibre c m) (A.support c m) s b ;
       inr e -> G.h-rank n (L.mask n m) r (A.fibre c m) (A.rank c m) s e } } ;
   pVan (c : A.El) (s : Sub n) (m : L.Exp n) (b : Bad n k r s m) : Id D.R (pRaw c s m) D.z =
     S.p-zero-at n (L.mask n m) (A.fibre c m) s (A.M.van c s m b) ;
   d (c : A.El) : Up.El = Up.M.mk (dRaw c) (dSupp c) (dVan c) ;
   h (c : A.El) : Down.El = Down.M.mk (hRaw c) (hSupp c) (hVan c) ;
   p (c : A.El) : A.El = A.M.mk (pRaw c) (pSupp c) (pVan c) ;
   Closed (c : A.El) : U l = (s : Sub n) (m : L.Exp n) -> Id D.R (dRaw c s m) D.z ;
   p-away (c : A.El) (ne : Not (Id Z.Int (K.topRank n) r)) (s : Sub n) (m : L.Exp n) :
     Id D.R (pRaw c s m) D.z = G.PiZero[n,L.mask n m,r,A.fibre c m,A.support c m,A.rank c m,ne].result s ;
   module Primitive (c : A.El) (ne : Not (Id Z.Int (K.topRank n) r)) (closed : Closed c) {
     primitive : Down.El = h c ;
     -- Equality is stated at coefficients to avoid transporting the
     -- target along suc(pred r)=r. The primitive itself is a module element.
     equation (s : Sub n) (m : L.Exp n) :
       Id D.R (C.diff n (\ t -> Down.val primitive t m) s) (A.val c s m) =
       G.Primitive[n,L.mask n m,r,A.fibre c m,A.support c m,A.rank c m,ne,\ t -> closed t m].eq s ;
   } ;
 } ;
 module SquareZero (n : Nat) (k r : Z.Int) {
   module O = Operations[n,k,r] ; module P = Operations[n,k,Z.sucZ r] ;
   dd (c : O.A.El) : P.Closed (O.d c) = \ s m -> C.dd n (O.A.fibre c m) s ;
 } ;
} ;
