-- Public module-level operations and coefficientwise homotopy identities.
level l ; open Ring[l] ; open GenericCube[l] ;
module Z = ZInt[l] ; module L = GenericLaurent[l] ; module K = GenericDegree[l] ;
module IP = IdealPowers[l] ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ; module H = GenericContraction[l].Over[D,setD] ;
 module T = GenericTop[l].Over[D,setD] ; module Q = GenericCardinality[l].Over[D,setD] ;
 module E = GenericCech[l].Over[D,setD] ;
 module Linear (n : Nat) (k r : Z.Int) {
   module O = E.Operations[n,k,r] ;
   d : IP.Lin[D,O.A.mod,O.Up.mod] = IP.mkLin D O.A.mod O.Up.mod O.d
     (\ c c' -> O.Up.M.eq _ _ (\ s m -> C.d-add n (O.A.fibre c m) (O.A.fibre c' m) s))
     (\ a c -> O.Up.M.eq _ _ (\ s m -> C.d-sm n a (O.A.fibre c m) s)) ;
   h : IP.Lin[D,O.A.mod,O.Down.mod] = IP.mkLin D O.A.mod O.Down.mod O.h
     (\ c c' -> O.Down.M.eq _ _ (\ s m -> H.h-add n (L.mask n m) (O.A.fibre c m) (O.A.fibre c' m) s))
     (\ a c -> O.Down.M.eq _ _ (\ s m -> H.h-sm n (L.mask n m) a (O.A.fibre c m) s)) ;
   p : IP.Lin[D,O.A.mod,O.A.mod] = IP.mkLin D O.A.mod O.A.mod O.p
     (\ c c' -> O.A.M.eq _ _ (\ s m -> T.p-add n (L.mask n m) (O.A.fibre c m) (O.A.fibre c' m) s))
     (\ a c -> O.A.M.eq _ _ (\ s m -> T.p-sm n (L.mask n m) a (O.A.fibre c m) s)) ;
 } ;
 module Homotopy (n : Nat) (k r : Z.Int) {
   module O = E.Operations[n,k,r] ; module P = E.Operations[n,k,Z.sucZ r] ;
   module W = E.Operations[n,k,Z.predZ r] ;
   equation (c : O.A.El) (s : Sub n) (m : L.Exp n) :
     Id D.R (D.add (D.add (W.dRaw (O.h c) s m) (P.hRaw (O.d c) s m)) (O.pRaw c s m)) (O.A.val c s m) =
     H.htpy n (L.mask n m) (O.A.fibre c m) s ;
   projection-boundary (c : O.A.El) (s : Sub n) (m : L.Exp n) : Id D.R (P.pRaw (O.d c) s m) D.z =
     T.pd-zero n (L.mask n m) (O.A.fibre c m) (O.A.support c m) s ;
   projection-top (c : O.A.El) (s : Sub n) (m : L.Exp n) (proper : GenericSupport[l].missing n s) :
     Id D.R (O.pRaw c s m) D.z = T.p-top n (L.mask n m) (O.A.fibre c m) (O.A.support c m) s proper ;
 } ;
 module Top (n : Nat) (k : Z.Int) {
   module O = E.Operations[n,k,K.topRank n] ; module W = E.Operations[n,k,Z.predZ (K.topRank n)] ;
   closed (c : O.A.El) : O.Closed c = \ s m ->
     T.d-top n (O.A.fibre c m) (Q.rank-top n (O.A.fibre c m) (O.A.rank c m)) s ;
   decomposition (c : O.A.El) (s : Sub n) (m : L.Exp n) :
     Id D.R (D.add (W.dRaw (O.h c) s m) (O.pRaw c s m)) (O.A.val c s m) =
     T.decomposition n (L.mask n m) (O.A.fibre c m) (\ t -> closed c t m) s ;
 } ;
} ;
