-- Informal proof (PCC2, Proposition 3, first on the full exterior algebra).
-- Write Ext(n+1) = Ext(n) x Ext(n), with the last generator at the back.
-- The coordinate pairing dot is multiplication in dimension zero and the
-- sum of the pairings of the two components in dimension n+1. Induction,
-- using the ring laws, proves symmetry and linearity. The same induction
-- moves the grade involution alpha from one argument to the other.
--
-- Define star(x0,x1) = (alpha(star x1),star x0); its inverse is
-- unstar(x0,x1) = (unstar x1,unstar(alpha x0)). The two inverse laws use
-- alpha squared = identity. Expanding the product of two pairs gives
-- dot(star x,y) = top(x*y): this is star-pair. The linearity of star is
-- another componentwise induction.
--
-- Every scalar-valued linear form is represented by dot. In dimension
-- zero its representing vector is f(1). For a pair, restrict f to the two
-- coordinate inclusions and represent those restrictions inductively;
-- additivity reconstructs f(x0,x1). This proves representation. Applying
-- the same construction to dot(x,-) recovers x (dual-dot), so equality of
-- all dot pairings implies equality of vectors. Composing with star and
-- unstar proves wedge-inj and represent for the top-product pairing.
-- Restriction to complementary homogeneous degrees is treated separately.
--
-- Computational conventions used in these inductions: Ext unfolds to R
-- or a pair; dot, star, unstar, dual and the coordinate inclusions unfold
-- at the induction step. Addition, scaling, alpha and top are the
-- componentwise operations of ExteriorModel, not extra algebraic laws.
-- dot-pair and dot-pair-right record the pairing with a displayed pair;
-- later component calculations cite these equations rather than decode dot.
-- The upstream accessors first and second name the two components.
-- We reopen them explicitly during these component inductions, then
-- lock them again. Their definitions and pair equations are checked once
-- in ExteriorModel; repeating a named component does not decode Ext.
--
-- More precisely, Linear is the pair of an addition law and a scaling
-- law; linear-add and linear-scale name the two projections. The left
-- inclusion is (x,0) and the right inclusion is (0,x). left-add and
-- right-add compare addition componentwise and use 0+0=0; left-scale
-- and right-scale similarly use a*0=0. Thus composing a linear form
-- with either inclusion is linear, by these named laws and the two
-- linearity accessors. split-add states x=left(first x)+right(second x)
-- in the reverse direction: componentwise addition gives
-- (first x+0,0+second x), the two zero laws give (first x,second x),
-- and the named components equation reconstructs x.
-- dot-left/right pair x with the corresponding inclusion. Opening dot
-- and that inclusion gives the desired pairing plus a zero pairing;
-- dot-zero and the appropriate addition-zero law remove it. The
-- inclusions are then opaque. representation uses split-add and
-- linear-add by name. Its dimension-zero case writes x=x*1 and uses
-- linear-scale and commutativity to obtain f(1)*x. dual-dot uses
-- dot-left/right under function extensionality, then its induction
-- hypothesis. No inclusion or linearity theorem is reproved by conversion.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;
 transparent first ; transparent second ;
 cong {a a' b b' : R} (p : Id R a a') (q : Id R b b') : Id R (add a b) (add a' b') =
  Presentations[l].cong2 R add a a' b b' p q ;


 dot : (n : Nat) -> Ext n -> Ext n -> R = split {
  zero -> mul ; suc n | r -> \ x y -> add (r x.1 y.1) (r x.2 y.2) } ;
 dot-pair (n : Nat) (a b : Ext n) (y : Ext (suc n)) :
  Id R (dot (suc n) (a,b) y) (add (dot n a (first n y)) (dot n b (second n y))) =
  refl (dot (suc n) (a,b) y) ;
 dot-pair-right (n : Nat) (x : Ext (suc n)) (a b : Ext n) :
  Id R (dot (suc n) x (a,b)) (add (dot n (first n x) a) (dot n (second n x) b)) =
  refl (dot (suc n) x (a,b)) ;
 dot-sym : (n : Nat) (x y : Ext n) -> Id R (dot n x y) (dot n y x) = split {
  zero -> mulC ; suc n | r -> \ x y -> cong (r (first n x) (first n y)) (r (second n x) (second n y)) } ;
 dot-zero : (n : Nat) (x : Ext n) -> Id R (dot n x (ezero n)) z = split {
  zero -> L.mul-zero ; suc n | r -> \ x -> trans (cong (r (first n x)) (r (second n x))) (addZ z) } ;
 dot-zero-left (n : Nat) (x : Ext n) : Id R (dot n (ezero n) x) z =
  trans (dot-sym n (ezero n) x) (dot-zero n x) ;
 dot-add : (n : Nat) (x y w : Ext n) ->
  Id R (dot n x (eadd n y w)) (add (dot n x y) (dot n x w)) = split {
  zero -> dist ; suc n | r -> \ x y w ->
   trans (cong (r (first n x) (first n y) (first n w)) (r (second n x) (second n y) (second n w)))
    (L.swap (dot n (first n x) (first n y)) (dot n (first n x) (first n w)) (dot n (second n x) (second n y)) (dot n (second n x) (second n w))) } ;
 dot-scale : (n : Nat) (a : R) (x y : Ext n) ->
  Id R (dot n x (escale n a y)) (mul a (dot n x y)) = split {
  zero -> \ a x y -> L.mul-swap x a y ;
  suc n | r -> \ a x y -> trans (cong (r a (first n x) (first n y)) (r a (second n x) (second n y)))
   (sym (dist a (dot n (first n x) (first n y)) (dot n (second n x) (second n y)))) } ;
 dot-neg : (n : Nat) (x y : Ext n) -> Id R (dot n x (eneg n y)) (neg (dot n x y)) = split {
  zero -> L.mul-neg ; suc n | r -> \ x y ->
   trans (cong (r (first n x) (first n y)) (r (second n x) (second n y))) (sym (L.neg-add (dot n (first n x) (first n y)) (dot n (second n x) (second n y)))) } ;
 dot-neg-left (n : Nat) (x y : Ext n) : Id R (dot n (eneg n x) y) (neg (dot n x y)) =
  trans (dot-sym n (eneg n x) y) (trans (dot-neg n y x) (ap neg (dot-sym n y x))) ;
 dot-add-left (n : Nat) (x y w : Ext n) :
  Id R (dot n (eadd n x y) w) (add (dot n x w) (dot n y w)) =
  trans (dot-sym n (eadd n x y) w)
   (trans (dot-add n w x y) (cong (dot-sym n w x) (dot-sym n w y))) ;
 dot-scale-left (n : Nat) (a : R) (x y : Ext n) :
  Id R (dot n (escale n a x) y) (mul a (dot n x y)) =
  trans (dot-sym n (escale n a x) y)
   (trans (dot-scale n a y x) (ap (mul a) (dot-sym n y x))) ;
 dot-alpha : (n : Nat) (x y : Ext n) -> Id R (dot n (alpha n x) y) (dot n x (alpha n y)) = split {
  zero -> \ x y -> refl (mul x y) ;
  suc n | r -> \ x y -> cong (r (first n x) (first n y))
   (trans (dot-neg-left n (alpha n (second n x)) (second n y))
    (trans (ap neg (r (second n x) (second n y))) (sym (dot-neg n (second n x) (alpha n (second n y)))))) } ;
 top-add : (n : Nat) (x y : Ext n) -> Id R (top n (eadd n x y)) (add (top n x) (top n y)) = split {
  zero -> \ x y -> refl (add x y) ; suc n | r -> \ x y -> r (second n x) (second n y) } ;

 -- star is the signed complementary-basis permutation. No division.
 star : (n : Nat) -> Ext n -> Ext n = split {
  zero -> \ x -> x ; suc n | r -> \ x -> (alpha n (r x.2),r x.1) } ;
 unstar : (n : Nat) -> Ext n -> Ext n = split {
  zero -> \ x -> x ; suc n | r -> \ x -> (r x.2,r (alpha n x.1)) } ;
 star-unstar : (n : Nat) (x : Ext n) -> Id (Ext n) (star n (unstar n x)) x = split {
  zero -> \ x -> refl x ; suc n | r -> \ x ->
   ExteriorAlgebra[l].pair-eq (trans (ap (alpha n) (r (alpha n (first n x)))) (EA.alpha-alpha n (first n x))) (r (second n x)) } ;
 unstar-star : (n : Nat) (x : Ext n) -> Id (Ext n) (unstar n (star n x)) x = split {
  zero -> \ x -> refl x ; suc n | r -> \ x ->
   ExteriorAlgebra[l].pair-eq (r (first n x)) (trans (ap (unstar n) (EA.alpha-alpha n (star n (second n x)))) (r (second n x))) } ;
 star-pair : (n : Nat) (x y : Ext n) -> Id R (dot n (star n x) y) (top n (emul n x y)) = split {
  zero -> \ x y -> refl (mul x y) ; suc n | r -> \ x y ->
   trans (cong (trans (dot-alpha n (star n (second n x)) (first n y)) (r (second n x) (alpha n (first n y)))) (r (first n x) (second n y)))
    (trans (addC (top n (emul n (second n x) (alpha n (first n y)))) (top n (emul n (first n x) (second n y))))
     (sym (top-add n (emul n (first n x) (second n y)) (emul n (second n x) (alpha n (first n y)))))) } ;
 star-add : (n : Nat) (x y : Ext n) -> Id (Ext n) (star n (eadd n x y)) (eadd n (star n x) (star n y)) = split {
  zero -> \ x y -> refl (add x y) ; suc n | r -> \ x y ->
   ExteriorAlgebra[l].pair-eq (trans (ap (alpha n) (r (second n x) (second n y))) (EA.alpha-add n (star n (second n x)) (star n (second n y)))) (r (first n x) (first n y)) } ;
 star-scale : (n : Nat) (a : R) (x : Ext n) -> Id (Ext n) (star n (escale n a x)) (escale n a (star n x)) = split {
  zero -> \ a x -> refl (mul a x) ; suc n | r -> \ a x ->
   ExteriorAlgebra[l].pair-eq (trans (ap (alpha n) (r a (second n x))) (EA.alpha-scale n a (star n (second n x)))) (r a (first n x)) } ;

 -- Every linear form has a unique coordinate vector for dot.
 Linear (n : Nat) (f : Ext n -> R) : U l =
  ((x y : Ext n) -> Id R (f (eadd n x y)) (add (f x) (f y))) *
  ((a : R) (x : Ext n) -> Id R (f (escale n a x)) (mul a (f x))) ;
 linear-add (n : Nat) (f : Ext n -> R) (h : Linear n f) (x y : Ext n) :
  Id R (f (eadd n x y)) (add (f x) (f y)) = h.1 x y ;
 linear-scale (n : Nat) (f : Ext n -> R) (h : Linear n f) (a : R) (x : Ext n) :
  Id R (f (escale n a x)) (mul a (f x)) = h.2 a x ;
 left (n : Nat) (x : Ext n) : Ext (suc n) = (x,ezero n) ;
 right (n : Nat) (x : Ext n) : Ext (suc n) = (ezero n,x) ;
 left-add (n : Nat) (x y : Ext n) : Id (Ext (suc n)) (left n (eadd n x y)) (eadd (suc n) (left n x) (left n y)) =
  sym (ExteriorAlgebra[l].pair-eq (refl (eadd n x y)) (EA.eaddZ n (ezero n))) ;
 left-scale (n : Nat) (a : R) (x : Ext n) : Id (Ext (suc n)) (left n (escale n a x)) (escale (suc n) a (left n x)) =
  sym (ExteriorAlgebra[l].pair-eq (refl (escale n a x)) (EA.escale-zero n a)) ;
 right-add (n : Nat) (x y : Ext n) : Id (Ext (suc n)) (right n (eadd n x y)) (eadd (suc n) (right n x) (right n y)) =
  sym (ExteriorAlgebra[l].pair-eq (EA.eaddZ n (ezero n)) (refl (eadd n x y))) ;
 right-scale (n : Nat) (a : R) (x : Ext n) : Id (Ext (suc n)) (right n (escale n a x)) (escale (suc n) a (right n x)) =
  sym (ExteriorAlgebra[l].pair-eq (EA.escale-zero n a) (refl (escale n a x))) ;
 split-add (n : Nat) (x : Ext (suc n)) : Id (Ext (suc n)) (eadd (suc n) (left n (first n x)) (right n (second n x))) x =
  trans (ExteriorAlgebra[l].pair-eq (EA.eaddZ n (first n x)) (EA.At[n].G.zl (second n x))) (components n x) ;
 left-lin (n : Nat) (f : Ext (suc n) -> R) (h : Linear (suc n) f) : Linear n (\ x -> f (left n x)) =
  (\ x y -> trans (ap f (left-add n x y)) (linear-add (suc n) f h (left n x) (left n y)),
   \ a x -> trans (ap f (left-scale n a x)) (linear-scale (suc n) f h a (left n x))) ;
 right-lin (n : Nat) (f : Ext (suc n) -> R) (h : Linear (suc n) f) : Linear n (\ x -> f (right n x)) =
  (\ x y -> trans (ap f (right-add n x y)) (linear-add (suc n) f h (right n x) (right n y)),
   \ a x -> trans (ap f (right-scale n a x)) (linear-scale (suc n) f h a (right n x))) ;
 dot-left (n : Nat) (x : Ext (suc n)) (y : Ext n) : Id R (dot (suc n) x (left n y)) (dot n (first n x) y) =
  trans (ap (add (dot n (first n x) y)) (dot-zero n (second n x))) (addZ (dot n (first n x) y)) ;
 dot-right (n : Nat) (x : Ext (suc n)) (y : Ext n) : Id R (dot (suc n) x (right n y)) (dot n (second n x) y) =
  trans (ap (\ a -> add a (dot n (second n x) y)) (dot-zero n (first n x))) (L.zl (dot n (second n x) y)) ;
 opaque left ; opaque right ;
 dual : (n : Nat) -> (Ext n -> R) -> Ext n = split {
  zero -> \ f -> f o ; suc n | r -> \ f -> (r (\ x -> f (left n x)),r (\ x -> f (right n x))) } ;
 representation : (n : Nat) (f : Ext n -> R) -> Linear n f -> (x : Ext n) -> Id R (f x) (dot n (dual n f) x) = split {
  zero -> \ f h x -> trans (sym (ap f (mulO x))) (trans (linear-scale zero f h x o) (mulC x (f o))) ;
  suc n | r -> \ f h x ->
   trans (sym (ap f (split-add n x)))
    (trans (linear-add (suc n) f h (left n (first n x)) (right n (second n x)))
     (cong (r (\ y -> f (left n y)) (left-lin n f h) (first n x))
           (r (\ y -> f (right n y)) (right-lin n f h) (second n x)))) } ;
 dual-dot : (n : Nat) (x : Ext n) -> Id (Ext n) (dual n (dot n x)) x = split {
  zero -> mulO ; suc n | r -> \ x -> ExteriorAlgebra[l].pair-eq
   (trans (ap (dual n) (F.funext (Ext n) (\ y -> R) (\ y -> dot (suc n) x (left n y)) (dot n (first n x))
     (dot-left n x))) (r (first n x)))
   (trans (ap (dual n) (F.funext (Ext n) (\ y -> R) (\ y -> dot (suc n) x (right n y)) (dot n (second n x))
     (dot-right n x))) (r (second n x))) } ;
 dot-inj (n : Nat) (x y : Ext n) (h : (w : Ext n) -> Id R (dot n x w) (dot n y w)) : Id (Ext n) x y =
  trans (sym (dual-dot n x))
   (trans (ap (dual n) (F.funext (Ext n) (\ w -> R) (dot n x) (dot n y) h)) (dual-dot n y)) ;
 wedge-inj (n : Nat) (x y : Ext n) (h : (w : Ext n) -> Id R (top n (emul n x w)) (top n (emul n y w))) : Id (Ext n) x y =
  trans (sym (unstar-star n x))
   (trans (ap (unstar n) (dot-inj n (star n x) (star n y)
     (\ w -> trans (star-pair n x w) (trans (h w) (sym (star-pair n y w)))))) (unstar-star n y)) ;
 represent (n : Nat) (f : Ext n -> R) (h : Linear n f) (x : Ext n) :
  Id R (top n (emul n (unstar n (dual n f)) x)) (f x) =
  trans (sym (star-pair n (unstar n (dual n f)) x))
   (trans (ap (\ y -> dot n y x) (star-unstar n (dual n f))) (sym (representation n f h x))) ;
 opaque first ; opaque second ;
} ;
