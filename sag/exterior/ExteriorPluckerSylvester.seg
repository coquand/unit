-- Informal proof (PCC2 Theorems 1 and 13).
-- A sum over subsets of size p is the binary subset sum with zero at all
-- other indices. Decidable equality of natural numbers selects its terms;
-- the equality of the cardinality with p supplies the length transport
-- for the list of replacement columns. product-transport is identity
-- elimination: transporting a list's length does not change its product.
-- An additive map preserving zero commutes with this sum, by SumMap and
-- the two explicitly stated clauses of a selected term.
--
-- The all-subset Cramer identity has coefficient
-- top(a * phi_B(star(basis I))). For count(I)=p, transport the list of
-- a-vectors to this count and apply the replacement determinant lemma.
-- For count(I) different from p, that coefficient is zero by degree.
-- The image of basis I is the product of the selected columns of B.
-- Substituting these equalities term by term proves Theorem 1.
--
-- Define the interior product beta . alpha by representing the linear
-- form w |-> dot(beta,alpha*w) with dot-duality. Its pairing equation
-- characterises it. Additivity and scaling in beta follow by testing
-- that equation against every w. Pairing with omega extracts top, so
-- omega . alpha=star(alpha), and (d omega).alpha=d star(alpha).
-- Both n-fold column products are their determinants times omega.
-- Apply star to Theorem 1 and commute it through the fixed-degree sum;
-- the preceding interior identities identify both sides with those of
-- Theorem 13. No division or choice of an invertible matrix is used.
--
-- For the degree assertion in Definition 10, test the interior product's
-- coefficient at a basis vector. That coefficient is dot(beta,alpha*b_i).
-- If p+r=q and count(i) differs from r, its right argument has degree
-- different from q, so orthogonality gives zero. Coefficient support
-- proves degree r; homogeneous-dot-inj proves uniqueness when testing
-- only degree-r vectors. Homogeneous elements are pairs with a
-- proposition-valued degree witness. Star and unstar preserve the two
-- complementary degrees, and their inverse equations lift to these
-- pairs by proof irrelevance. This states Proposition 12 as an equivalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ; module H = ExteriorHomogeneous[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 module CI = ExteriorCramerIdentity[l].Over[Rg,setR] ;
 module RP = ExteriorReplacement[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 transport-list (n p q : Nat) (e : Id Nat p q) (a : Ps.Fin p -> AL.Vec n) : Ps.Fin q -> AL.Vec n =
  subst (\ k -> Ps.Fin k -> AL.Vec n) e a ;
 product-transport (n p : Nat) (a : Ps.Fin p -> AL.Vec n) (q : Nat) (e : Id Nat p q) :
  Id (Ext n) (eprod n q (\ k -> gen n (transport-list n p q e a k))) (eprod n p (\ k -> gen n (a k))) =
  idJ Nat p (\ q1 e1 -> Id (Ext n) (eprod n q1 (\ k -> gen n (transport-list n p q1 e1 a k)))
   (eprod n p (\ k -> gen n (a k)))) (refl (eprod n p (\ k -> gen n (a k)))) q e ;
 opaque transport-list ;

 module DegreeSum (n p : Nat) {
  module S = CO.ES[n].SumE ;
  Summand : U l = (i : C.Index n) -> Id Nat (BA.count n i) p -> Ext n ;
  term (f : Summand) (i : C.Index n) : Plus (Id Nat (BA.count n i) p) (Not (Id Nat (BA.count n i) p)) -> Ext n = split {
   inl e -> f i e ; inr ne -> ezero n } ;
  term-yes (f : Summand) (i : C.Index n) (e : Id Nat (BA.count n i) p) :
   Id (Ext n) (term f i (inl e)) (f i e) = refl (f i e) ;
  term-no (f : Summand) (i : C.Index n) (ne : Not (Id Nat (BA.count n i) p)) :
   Id (Ext n) (term f i (inr ne)) (ezero n) = refl (ezero n) ;
  value (f : Summand) : Ext n = S.sum n (\ i -> term f i (H.DecNat.dec (BA.count n i) p)) ;
  value-equation (f : Summand) : Id (Ext n) (value f) (S.sum n (\ i -> term f i (H.DecNat.dec (BA.count n i) p))) = refl (value f) ;
  term-cong (f g : Summand) (h : (i : C.Index n) (e : Id Nat (BA.count n i) p) -> Id (Ext n) (f i e) (g i e))
   (i : C.Index n) : (d : Plus (Id Nat (BA.count n i) p) (Not (Id Nat (BA.count n i) p))) ->
   Id (Ext n) (term f i d) (term g i d) = split {
   inl e -> h i e ; inr ne -> refl (ezero n) } ;
  cong (f g : Summand) (h : (i : C.Index n) (e : Id Nat (BA.count n i) p) -> Id (Ext n) (f i e) (g i e)) :
   Id (Ext n) (value f) (value g) =
   S.cong n (\ i -> term f i (H.DecNat.dec (BA.count n i) p)) (\ i -> term g i (H.DecNat.dec (BA.count n i) p))
    (\ i -> term-cong f g h i (H.DecNat.dec (BA.count n i) p)) ;
  term-map (u : Ext n -> Ext n) (hz : Id (Ext n) (u (ezero n)) (ezero n)) (f : Summand) (i : C.Index n) :
   (d : Plus (Id Nat (BA.count n i) p) (Not (Id Nat (BA.count n i) p))) ->
   Id (Ext n) (u (term f i d)) (term (\ j e -> u (f j e)) i d) = split {
   inl e -> refl (u (f i e)) ; inr ne -> hz } ;
  map (u : Ext n -> Ext n)
   (ha : (x y : Ext n) -> Id (Ext n) (u (eadd n x y)) (eadd n (u x) (u y)))
   (hz : Id (Ext n) (u (ezero n)) (ezero n)) (f : Summand) :
   Id (Ext n) (u (value f)) (value (\ i e -> u (f i e))) =
   trans (C.SumMap[Ext n,Ext n,eadd n,eadd n,u,ha].map n (\ i -> term f i (H.DecNat.dec (BA.count n i) p)))
    (S.cong n (\ i -> u (term f i (H.DecNat.dec (BA.count n i) p)))
     (\ i -> term (\ j e -> u (f j e)) i (H.DecNat.dec (BA.count n i) p))
     (\ i -> term-map u hz f i (H.DecNat.dec (BA.count n i) p))) ;
  opaque term ; opaque value ;
 } ;

 interior-form (n : Nat) (beta alpha w : Ext n) : R = DU.dot n beta (emul n alpha w) ;
 interior-form-linear (n : Nat) (beta alpha : Ext n) : DU.Linear n (interior-form n beta alpha) =
  ((\ x y -> trans (ap (DU.dot n beta) (EA.dist-left n alpha x y))
    (DU.dot-add n beta (emul n alpha x) (emul n alpha y))),
   \ a x -> trans (ap (DU.dot n beta) (EA.scale-mul-right n a alpha x))
    (DU.dot-scale n a beta (emul n alpha x))) ;
 interior (n : Nat) (beta alpha : Ext n) : Ext n = DU.dual n (interior-form n beta alpha) ;
 interior-pair (n : Nat) (beta alpha w : Ext n) :
  Id R (DU.dot n (interior n beta alpha) w) (DU.dot n beta (emul n alpha w)) =
  sym (DU.representation n (interior-form n beta alpha) (interior-form-linear n beta alpha) w) ;
 interior-add (n : Nat) (beta gamma alpha : Ext n) :
  Id (Ext n) (interior n (eadd n beta gamma) alpha) (eadd n (interior n beta alpha) (interior n gamma alpha)) =
  DU.dot-inj n (interior n (eadd n beta gamma) alpha) (eadd n (interior n beta alpha) (interior n gamma alpha))
   (\ w -> trans (interior-pair n (eadd n beta gamma) alpha w)
    (trans (DU.dot-add-left n beta gamma (emul n alpha w))
     (trans (DU.cong (sym (interior-pair n beta alpha w)) (sym (interior-pair n gamma alpha w)))
      (sym (DU.dot-add-left n (interior n beta alpha) (interior n gamma alpha) w))))) ;
 interior-scale (n : Nat) (d : R) (beta alpha : Ext n) :
  Id (Ext n) (interior n (escale n d beta) alpha) (escale n d (interior n beta alpha)) =
  DU.dot-inj n (interior n (escale n d beta) alpha) (escale n d (interior n beta alpha))
   (\ w -> trans (interior-pair n (escale n d beta) alpha w)
    (trans (DU.dot-scale-left n d beta (emul n alpha w))
     (trans (ap (mul d) (sym (interior-pair n beta alpha w)))
      (sym (DU.dot-scale-left n d (interior n beta alpha) w))))) ;
 interior-volume (n : Nat) (alpha : Ext n) : Id (Ext n) (interior n (DG.omega n) alpha) (DU.star n alpha) =
  DU.dot-inj n (interior n (DG.omega n) alpha) (DU.star n alpha)
   (\ w -> trans (interior-pair n (DG.omega n) alpha w)
    (trans (TP.omega-dot n (emul n alpha w)) (sym (DU.star-pair n alpha w)))) ;
 interior-top (n : Nat) (d : R) (alpha : Ext n) :
  Id (Ext n) (interior n (escale n d (DG.omega n)) alpha) (escale n d (DU.star n alpha)) =
  trans (interior-scale n d (DG.omega n) alpha) (ap (escale n d) (interior-volume n alpha)) ;
 interior-coeff (n : Nat) (beta alpha : Ext n) (i : C.Index n) :
  Id R (CO.coeff n (interior n beta alpha) i) (DU.dot n beta (emul n alpha (CO.basis n i))) =
  trans (sym (CO.dot-basis n (interior n beta alpha) i)) (interior-pair n beta alpha (CO.basis n i)) ;
 interior-degree (n p q r : Nat) (beta alpha : Ext n) (db : DG.Deg n q beta) (da : DG.Deg n p alpha)
  (e : Id Nat (plus p r) q) : DG.Deg n r (interior n beta alpha) =
  HO.support-degree n r (interior n beta alpha) (\ i ne -> trans (interior-coeff n beta alpha i)
   (HO.dot-degree-vanish n q (plus p (BA.count n i)) beta (emul n alpha (CO.basis n i)) db
    (HO.deg-mul n p (BA.count n i) alpha (CO.basis n i) da (BA.basis-degree n i))
    (\ eq -> ne (H.plus-cancel-left p (BA.count n i) r (trans (sym eq) (sym e)))))) ;
 interior-unique (n p q r : Nat) (beta alpha v : Ext n) (db : DG.Deg n q beta) (da : DG.Deg n p alpha)
  (dv : DG.Deg n r v) (e : Id Nat (plus p r) q)
  (h : (w : Ext n) -> DG.Deg n r w -> Id R (DU.dot n v w) (DU.dot n beta (emul n alpha w))) :
  Id (Ext n) (interior n beta alpha) v =
  HO.homogeneous-dot-inj n r (interior n beta alpha) v (interior-degree n p q r beta alpha db da e) dv
   (\ w dw -> trans (interior-pair n beta alpha w) (sym (h w dw))) ;
 opaque interior ;

 Homogeneous (n p : Nat) : U l = (x : Ext n) * DG.Deg n p x ;
 homogeneous-eq (n p : Nat) (x y : Homogeneous n p) (e : Id (Ext n) x.1 y.1) : Id (Homogeneous n p) x y =
  Pr.Sigma-eq (Ext n) (DG.Deg n p) x.1 y.1 x.2 y.2 e (HO.deg-prop n p y.1) ;
 star-forward (n p r : Nat) (h : Id Nat (plus p r) n) (x : Homogeneous n p) : Homogeneous n r =
  (DU.star n x.1,HO.star-degree n p r x.1 x.2 h) ;
 star-forward-value (n p r : Nat) (h : Id Nat (plus p r) n) (x : Homogeneous n p) :
  Id (Ext n) (star-forward n p r h x).1 (DU.star n x.1) = refl (DU.star n x.1) ;
 star-backward (n p r : Nat) (h : Id Nat (plus p r) n) (y : Homogeneous n r) : Homogeneous n p =
  (DU.unstar n y.1,HO.unstar-degree n p r y.1 y.2 h) ;
 star-backward-value (n p r : Nat) (h : Id Nat (plus p r) n) (y : Homogeneous n r) :
  Id (Ext n) (star-backward n p r h y).1 (DU.unstar n y.1) = refl (DU.unstar n y.1) ;
 opaque star-forward ; opaque star-backward ;
 star-section (n p r : Nat) (h : Id Nat (plus p r) n) (y : Homogeneous n r) :
  Id (Homogeneous n r) (star-forward n p r h (star-backward n p r h y)) y =
  homogeneous-eq n r (star-forward n p r h (star-backward n p r h y)) y
   (trans (star-forward-value n p r h (star-backward n p r h y))
    (trans (ap (DU.star n) (star-backward-value n p r h y)) (DU.star-unstar n y.1))) ;
 star-retraction (n p r : Nat) (h : Id Nat (plus p r) n) (x : Homogeneous n p) :
  Id (Homogeneous n p) (star-backward n p r h (star-forward n p r h x)) x =
  homogeneous-eq n p (star-backward n p r h (star-forward n p r h x)) x
   (trans (star-backward-value n p r h (star-forward n p r h x))
    (trans (ap (DU.unstar n) (star-forward-value n p r h x)) (DU.unstar-star n x.1))) ;
 star-isomorphism (n p r : Nat) (h : Id Nat (plus p r) n) :
  Pr.isEquiv (Homogeneous n p) (Homogeneous n r) (star-forward n p r h) =
  Pr.qinv (Homogeneous n p) (Homogeneous n r) (star-forward n p r h) (star-backward n p r h)
   (star-section n p r h) (star-retraction n p r h) ;

 module At (n p : Nat) (a : Ps.Fin p -> AL.Vec n) (B : DT.Mat n) {
  module S = DegreeSum[n,p] ;
  module ES = CO.ES[n].SumE ;
  module M = DT.Map[n,B] ;
  module K = CI.At[n,B] ;
  module Repl = RP.At[n] ;
  a-product : Ext n = eprod n p (\ k -> gen n (a k)) ;
  a-degree : DG.Deg n p a-product = DG.deg-eprod n p (\ k -> gen n (a k)) (\ k -> DG.deg-gen n (a k)) ;
  subset-a (i : C.Index n) (e : Id Nat (BA.count n i) p) : Ps.Fin (BA.count n i) -> AL.Vec n =
   transport-list n p (BA.count n i) (sym e) a ;
  subset-a-product (i : C.Index n) (e : Id Nat (BA.count n i) p) :
   Id (Ext n) (eprod n (BA.count n i) (\ k -> gen n (subset-a i e k))) a-product =
   product-transport n p a (BA.count n i) (sym e) ;
  replacement-determinant (i : C.Index n) (e : Id Nat (BA.count n i) p) : R =
   det n (Repl.V.replace n i (subset-a i e) B) ;
  coefficient (i : C.Index n) (e : Id Nat (BA.count n i) p) :
   Id R (top n (emul n a-product (M.value (DU.star n (CO.basis n i))))) (replacement-determinant i e) =
   trans (ap (\ x -> top n (emul n x (M.value (DU.star n (CO.basis n i))))) (sym (subset-a-product i e)))
    Repl.Replaced[i,subset-a i e,B].determinant ;
  summand (i : C.Index n) (e : Id Nat (BA.count n i) p) : Ext n =
   escale n (replacement-determinant i e) (Repl.product i B) ;
  correct-term (i : C.Index n) : (d : Plus (Id Nat (BA.count n i) p) (Not (Id Nat (BA.count n i) p))) ->
   Id (Ext n) (escale n (top n (emul n a-product (M.value (DU.star n (CO.basis n i))))) (M.value (CO.basis n i))) (S.term summand i d) = split {
   inl e -> trans (ap (\ c -> escale n c (M.value (CO.basis n i))) (coefficient i e))
    (trans (ap (escale n (replacement-determinant i e)) (Repl.image i B)) (sym (S.term-yes summand i e))) ;
   inr ne -> trans (ap (\ c -> escale n c (M.value (CO.basis n i))) (HO.cramer-coeff-zero n B p a-product a-degree i ne))
    (trans (EA.zero-scale n (M.value (CO.basis n i))) (sym (S.term-no summand i ne))) } ;
  -- PCC2 Theorem 1 = CFFR Proposition 8.3 (with the a/b names exchanged):
  -- the sum ranges over exactly the subsets of size p.
  cramer : Id (Ext n) (escale n (det n B) a-product) (S.value summand) =
   trans (K.cramer a-product)
    (trans (ES.cong n
      (\ i -> escale n (top n (emul n a-product (M.value (DU.star n (CO.basis n i))))) (M.value (CO.basis n i)))
      (\ i -> S.term summand i (H.DecNat.dec (BA.count n i) p))
      (\ i -> correct-term i (H.DecNat.dec (BA.count n i) p)))
     (sym (S.value-equation summand))) ;
  b-volume : Ext n = eprod n n (\ k -> gen n (B k)) ;
  replacement-volume (i : C.Index n) (e : Id Nat (BA.count n i) p) : Ext n =
   eprod n n (\ k -> gen n (Repl.V.replace n i (subset-a i e) B k)) ;
  left-value : Id (Ext n) (interior n b-volume a-product) (DU.star n (escale n (det n B) a-product)) =
   trans (ap (\ x -> interior n x a-product) (DT.free n B))
    (trans (interior-top n (det n B) a-product) (sym (DU.star-scale n (det n B) a-product))) ;
  right-value (i : C.Index n) (e : Id Nat (BA.count n i) p) :
   Id (Ext n) (interior n (replacement-volume i e) (Repl.product i B)) (DU.star n (summand i e)) =
   trans (ap (\ x -> interior n x (Repl.product i B)) (DT.free n (Repl.V.replace n i (subset-a i e) B)))
    (trans (interior-top n (replacement-determinant i e) (Repl.product i B))
     (sym (DU.star-scale n (replacement-determinant i e) (Repl.product i B)))) ;
  -- PCC2 Theorem 13, equivalently CFFR Proposition 8.3.
  plucker-sylvester : Id (Ext n) (interior n b-volume a-product)
   (S.value (\ i e -> interior n (replacement-volume i e) (Repl.product i B))) =
   trans left-value
    (trans (ap (DU.star n) cramer)
     (trans (S.map (DU.star n) (DU.star-add n) (HO.star-zero n) summand)
      (S.cong (\ i e -> DU.star n (summand i e))
       (\ i e -> interior n (replacement-volume i e) (Repl.product i B)) (\ i e -> sym (right-value i e))))) ;
 } ;
} ;
