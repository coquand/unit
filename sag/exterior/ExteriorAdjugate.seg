-- Informal proof (PCC2, Definition 4 and the first half of Proposition 6).
-- For fixed x, the form y |-> top(x * phi_A(y)) is linear, by linearity
-- of phi_A, multiplication and top. Perfectness of the top-product
-- pairing represents it by a unique vector adj(x). Explicitly, represent
-- the form using dot and apply unstar. This gives characterise and unique.
--
-- To prove adj additive or compatible with scaling, test the asserted
-- equality by pairing with an arbitrary y. Apply characterise, distribute
-- the product and top, and apply characterise again. Wedge-injectivity
-- turns the resulting equality of pairings into equality of vectors.
--
-- Similarly, top(adj(phi_A(x))*y) = top(phi_A(x)*phi_A(y))
-- = top(phi_A(x*y)) = det(A)*top(x*y), by multiplicativity and top-map.
-- Move the scalar into the first argument and use wedge-injectivity.
-- This proves adj-map on the full algebra; the degree-p formulation and
-- the other composition identity require the later homogeneous and
-- transpose results. Lock adj after its characterising lemmas.
-- The definition of form is opened at the displayed pairing steps;
-- Linear supplies its two laws. Mat and Vec decode the column matrix
-- at module applications, and isSet identifies the supplied ring sethood.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 module At (n : Nat) (A : DT.Mat n) {
  module M = DT.Map[n,A] ;
  form (x y : Ext n) : R = top n (emul n x (M.value y)) ;
  form-linear (x : Ext n) : DU.Linear n (form x) =
   ((\ y w -> trans (ap (\ t -> top n (emul n x t)) (M.value-add y w))
     (trans (ap (top n) (EA.dist-left n x (M.value y) (M.value w)))
      (DU.top-add n (emul n x (M.value y)) (emul n x (M.value w))))),
    \ a y -> trans (ap (\ t -> top n (emul n x t)) (M.value-scale a y))
     (trans (ap (top n) (EA.scale-mul-right n a x (M.value y)))
      (DG.top-scale n a (emul n x (M.value y))))) ;
  adj (x : Ext n) : Ext n = DU.unstar n (DU.dual n (form x)) ;
  characterise (x y : Ext n) : Id R (top n (emul n (adj x) y)) (form x y) =
   DU.represent n (form x) (form-linear x) y ;
  unique (x v : Ext n) (h : (y : Ext n) -> Id R (top n (emul n v y)) (form x y)) : Id (Ext n) v (adj x) =
   DU.wedge-inj n v (adj x) (\ y -> trans (h y) (sym (characterise x y))) ;

  adj-add (x y : Ext n) : Id (Ext n) (adj (eadd n x y)) (eadd n (adj x) (adj y)) =
   DU.wedge-inj n (adj (eadd n x y)) (eadd n (adj x) (adj y)) (\ w ->
    calc R { top n (emul n (adj (eadd n x y)) w)
     =< characterise (eadd n x y) w > top n (emul n (eadd n x y) (M.value w))
     =< ap (top n) (EA.dist-right n x y (M.value w)) > top n (eadd n (emul n x (M.value w)) (emul n y (M.value w)))
     =< DU.top-add n (emul n x (M.value w)) (emul n y (M.value w)) > add (form x w) (form y w)
     =< DU.cong (sym (characterise x w)) (sym (characterise y w)) > add (top n (emul n (adj x) w)) (top n (emul n (adj y) w))
     =< sym (DU.top-add n (emul n (adj x) w) (emul n (adj y) w)) > top n (eadd n (emul n (adj x) w) (emul n (adj y) w))
     =< sym (ap (top n) (EA.dist-right n (adj x) (adj y) w)) > top n (emul n (eadd n (adj x) (adj y)) w) }) ;
  adj-scale (a : R) (x : Ext n) : Id (Ext n) (adj (escale n a x)) (escale n a (adj x)) =
   DU.wedge-inj n (adj (escale n a x)) (escale n a (adj x)) (\ w ->
    calc R { top n (emul n (adj (escale n a x)) w)
     =< characterise (escale n a x) w > top n (emul n (escale n a x) (M.value w))
     =< ap (top n) (EA.scale-mul-left n a x (M.value w)) > top n (escale n a (emul n x (M.value w)))
     =< DG.top-scale n a (emul n x (M.value w)) > mul a (form x w)
     =< ap (mul a) (sym (characterise x w)) > mul a (top n (emul n (adj x) w))
     =< sym (DG.top-scale n a (emul n (adj x) w)) > top n (escale n a (emul n (adj x) w))
     =< sym (ap (top n) (EA.scale-mul-left n a (adj x) w)) > top n (emul n (escale n a (adj x)) w) }) ;

  -- Proposition 6: Adj(A) Lambda(A) = det(A) id, on the full algebra.
  adj-map (x : Ext n) : Id (Ext n) (adj (M.value x)) (escale n (det n A) x) =
   DU.wedge-inj n (adj (M.value x)) (escale n (det n A) x) (\ y ->
    calc R { top n (emul n (adj (M.value x)) y)
     =< characterise (M.value x) y > top n (emul n (M.value x) (M.value y))
     =< sym (ap (top n) (M.value-mul x y)) > top n (M.value (emul n x y))
     =< BA.top-map n A (emul n x y) > mul (det n A) (top n (emul n x y))
     =< sym (DG.top-scale n (det n A) (emul n x y)) > top n (escale n (det n A) (emul n x y))
     =< sym (ap (top n) (EA.scale-mul-left n (det n A) x y)) > top n (emul n (escale n (det n A) x) y) }) ;
  opaque adj ;
 } ;
} ;
