-- Cayley-Hamilton (DESIGN.md §5, step 6), for an element t of an A-algebra
-- E, not necessarily commutative.  If  m_i t = sum_j m_j a_ji  for some
-- m : E^n (the right multiplication by t has matrix a on the m_j), then
--   m_k chi_a(t) = 0 ,
-- by the determinant trick for E as a right A[X]-module through evaluation
-- at t (ModuleTrick.seg, PolyEval.seg), with M = X I - a.  If moreover
-- 1 = sum_k e_k m_k, then chi_a(t) = 0.  For E = M_n(A), t = a and m_k the
-- matrix units of row c (for each c) this is chi_a(a) = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : NCAlgebra[l].Over[A,setA].Algebra) (t : E.A)
 (n : Nat) (a : Determinant[l].Over[A,setA].Mat n) (m : Ps.Fin n -> E.A)
 (h : (i : Ps.Fin n) -> Id E.A (E.mul (m i) t)
   (ModuleTrick[l].Sums[E.A,E.zero,E.add,E.neg,E.addA,E.addC,E.addZ,E.addN].vsum n (\ j -> E.mul (m j) (E.scale (a j i) E.one)))) {
 module PE = PolyEval[l].Over[A,setA,E,t] ;
 module CP = CharPoly[l].Over[A,setA] ;
 module B = CP.B ;
 module D = MnSums[l].Over[A] ;
 module VS = ModuleTrick[l].Sums[E.A,E.zero,E.add,E.neg,E.addA,E.addC,E.addZ,E.addN] ;
 module G = VS.G ;
 ev : B.Carrier -> E.A = PE.evaluate ;
 chi : B.Carrier = CP.char n a ;

 -- E as a right A[X]-module
 op (b : B.Carrier) (v : E.A) : E.A = E.mul v (ev b) ;
 module MT = ModuleTrick[l].Over[B.ring,B.set,E.A,E.zero,E.add,E.neg,E.addA,E.addC,E.addZ,E.addN,op,
  \ b v w -> E.dist-right v w (ev b),
  \ b b' v -> trans (ap (E.mul v) (PE.preserves-add b b')) (E.dist-left v (ev b) (ev b')),
  \ b b' v -> trans (ap (\ x -> E.mul v (ev x)) (B.mul-comm b b'))
               (trans (ap (E.mul v) (PE.preserves-mul b' b)) (E.mulA v (ev b') (ev b))),
  \ v -> trans (ap (E.mul v) PE.preserves-one) (E.one-right v)] ;
 -- and as a right A-module through the scalars
 module VD = VS.Delta[A,\ b v -> E.mul v (PE.c b),
  \ v -> trans (ap (E.mul v) PE.c-zero) (PE.mul-zero v),
  \ v -> trans (ap (E.mul v) PE.c-one) (E.one-right v)] ;

 -- the entries of t I - a
 entry (j i : Ps.Fin n) : Id E.A (ev (CP.charmat n a j i)) (E.add (E.mul t (PE.c (D.delta n j i))) (PE.c (A.neg (a j i)))) =
  trans (PE.preserves-add (B.mulQ B.variable (B.constant (D.delta n j i))) (B.constant (A.neg (a j i))))
   (G.cong-add (trans (PE.preserves-mul B.variable (B.constant (D.delta n j i)))
                      (Ps.cong2 E.A E.mul _ _ _ _ PE.on-variable (PE.on-constant (D.delta n j i))))
               (PE.on-constant (A.neg (a j i)))) ;
 cancel (j i : Ps.Fin n) :
  Id E.A (E.add (E.mul (m j) (PE.c (a j i))) (E.mul (m j) (PE.c (A.neg (a j i))))) E.zero =
  trans (sym (E.dist-left (m j) (PE.c (a j i)) (PE.c (A.neg (a j i)))))
   (trans (ap (E.mul (m j)) (trans (sym (PE.c-add (a j i) (A.neg (a j i)))) (trans (ap PE.c (A.addN (a j i))) PE.c-zero)))
          (PE.mul-zero (m j))) ;
 -- m (t I - a) = 0
 kernel (i : Ps.Fin n) : Id E.A (VS.vsum n (\ j -> op (CP.charmat n a j i) (m j))) E.zero =
  calc E.A {
   VS.vsum n (\ j -> E.mul (m j) (ev (CP.charmat n a j i)))
    =< VS.vsum-cong n (\ j -> E.mul (m j) (ev (CP.charmat n a j i)))
         (\ j -> E.add (E.mul (E.mul (m j) t) (PE.c (D.delta n j i))) (E.mul (m j) (PE.c (A.neg (a j i)))))
         (\ j -> trans (ap (E.mul (m j)) (entry j i))
                  (trans (E.dist-left (m j) (E.mul t (PE.c (D.delta n j i))) (PE.c (A.neg (a j i))))
                         (ap (\ x -> E.add x (E.mul (m j) (PE.c (A.neg (a j i))))) (E.mulA (m j) t (PE.c (D.delta n j i))))))
     > VS.vsum n (\ j -> E.add (E.mul (E.mul (m j) t) (PE.c (D.delta n j i))) (E.mul (m j) (PE.c (A.neg (a j i)))))
    =< VS.vsum-add n (\ j -> E.mul (E.mul (m j) t) (PE.c (D.delta n j i))) (\ j -> E.mul (m j) (PE.c (A.neg (a j i))))
     > E.add (VS.vsum n (\ j -> E.mul (E.mul (m j) t) (PE.c (D.delta n j i)))) (VS.vsum n (\ j -> E.mul (m j) (PE.c (A.neg (a j i)))))
    =< ap (\ x -> E.add x (VS.vsum n (\ j -> E.mul (m j) (PE.c (A.neg (a j i))))))
         (trans (VD.delta n i (\ j -> E.mul (m j) t)) (h i))
     > E.add (VS.vsum n (\ j -> E.mul (m j) (PE.c (a j i)))) (VS.vsum n (\ j -> E.mul (m j) (PE.c (A.neg (a j i)))))
    =< sym (VS.vsum-add n (\ j -> E.mul (m j) (PE.c (a j i))) (\ j -> E.mul (m j) (PE.c (A.neg (a j i)))))
     > VS.vsum n (\ j -> E.add (E.mul (m j) (PE.c (a j i))) (E.mul (m j) (PE.c (A.neg (a j i)))))
    =< VS.vsum-cong n (\ j -> E.add (E.mul (m j) (PE.c (a j i))) (E.mul (m j) (PE.c (A.neg (a j i))))) (\ j -> E.zero)
         (\ j -> cancel j i)
     > VS.vsum n (\ j -> E.zero)
    =< VS.vsum-zero n > E.zero } ;
 -- m_k chi_a(t) = 0
 annihilates (k : Ps.Fin n) : Id E.A (E.mul (m k) (ev chi)) E.zero = MT.trick n (CP.charmat n a) m kernel k ;
 -- if 1 = sum e_k m_k then chi_a(t) = 0
 module Faithful (e : Ps.Fin n -> E.A) (one : Id E.A (VS.vsum n (\ k -> E.mul (e k) (m k))) E.one) {
  root : Id E.A (ev chi) E.zero =
   calc E.A {
    ev chi
     =< sym (E.one-left (ev chi)) > E.mul E.one (ev chi)
     =< ap (\ x -> E.mul x (ev chi)) (sym one) > E.mul (VS.vsum n (\ k -> E.mul (e k) (m k))) (ev chi)
     =< VS.hom-sum (\ x -> E.mul x (ev chi)) (\ x y -> E.dist-right x y (ev chi)) n (\ k -> E.mul (e k) (m k))
      > VS.vsum n (\ k -> E.mul (E.mul (e k) (m k)) (ev chi))
     =< VS.vsum-cong n (\ k -> E.mul (E.mul (e k) (m k)) (ev chi)) (\ k -> E.zero)
          (\ k -> trans (sym (E.mulA (e k) (m k) (ev chi))) (trans (ap (E.mul (e k)) (annihilates k)) (PE.mul-zero (e k))))
      > VS.vsum n (\ k -> E.zero)
     =< VS.vsum-zero n > E.zero } ;
  -- t is a root of the monic polynomial chi_a of degree n
  cayley-hamilton : CP.Bounded (suc n) chi * Id A.R (CP.coef chi n) A.o * Id E.A (ev chi) E.zero =
   (CP.char-bounded n a,CP.char-monic n a,root) ;
 } ;
} ;
