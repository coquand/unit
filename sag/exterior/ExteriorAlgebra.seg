-- The model of ExteriorModel.seg is an R-algebra (DESIGN.md §5, step 1):
-- every law by induction on n.  At level n+1 the laws use the laws at
-- level n and three facts about the grade involution: it is additive,
-- multiplicative, and an involution.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;

pair-eq {A B : U l} {x x' : A} {y y' : B} (p : Id A x x') (q : Id B y y') : Id (A * B) (x,y) (x',y') =
 idJ A x (\ x1 p1 -> Id (A * B) (x,y) (x1,y'))
  (idJ B y (\ y1 q1 -> Id (A * B) (x,y) (x,y1)) (refl (x,y)) y' q) x' p ;

-- abelian-group identities, and additive maps preserve 0 and negation
module AG (A : U l) (zero : A) (add : A -> A -> A) (neg : A -> A)
 (addA : (x y w : A) -> Id A (add x (add y w)) (add (add x y) w))
 (addC : (x y : A) -> Id A (add x y) (add y x))
 (addZ : (x : A) -> Id A (add x zero) x)
 (addN : (x : A) -> Id A (add x (neg x)) zero) {
 cong-add {x x' y y' : A} (p : Id A x x') (q : Id A y y') : Id A (add x y) (add x' y') =
  trans (ap (\ t -> add t y) p) (ap (add x') q) ;
 zl (x : A) : Id A (add zero x) x = trans (addC zero x) (addZ x) ;
 -- u + v = u  gives  v = 0
 add-cancel (u v : A) (h : Id A (add u v) u) : Id A v zero =
  calc A { v =< sym (addZ v) > add v zero
             =< ap (add v) (sym (addN u)) > add v (add u (neg u))
             =< addA v u (neg u) > add (add v u) (neg u)
             =< ap (\ t -> add t (neg u)) (addC v u) > add (add u v) (neg u)
             =< ap (\ t -> add t (neg u)) h > add u (neg u)
             =< addN u > zero } ;
 -- x + y = 0  gives  y = -x
 neg-uniq (x y : A) (h : Id A (add x y) zero) : Id A y (neg x) =
  calc A { y =< sym (addZ y) > add y zero
             =< ap (add y) (sym (addN x)) > add y (add x (neg x))
             =< addA y x (neg x) > add (add y x) (neg x)
             =< ap (\ t -> add t (neg x)) (addC y x) > add (add x y) (neg x)
             =< ap (\ t -> add t (neg x)) h > add zero (neg x)
             =< zl (neg x) > neg x } ;
 neg-zero : Id A (neg zero) zero = sym (neg-uniq zero zero (addZ zero)) ;
 neg-neg (x : A) : Id A (neg (neg x)) x =
  sym (neg-uniq (neg x) x (trans (addC (neg x) x) (addN x))) ;
 -- (p + q) + (r + s) = (p + r) + (q + s)
 swap (p q r s : A) : Id A (add (add p q) (add r s)) (add (add p r) (add q s)) =
  calc A { add (add p q) (add r s) =< sym (addA p q (add r s)) > add p (add q (add r s))
             =< ap (add p) (addA q r s) > add p (add (add q r) s)
             =< ap (\ t -> add p (add t s)) (addC q r) > add p (add (add r q) s)
             =< ap (add p) (sym (addA r q s)) > add p (add r (add q s))
             =< addA p r (add q s) > add (add p r) (add q s) } ;
 neg-add (x y : A) : Id A (neg (add x y)) (add (neg x) (neg y)) =
  sym (neg-uniq (add x y) (add (neg x) (neg y))
   (trans (swap x y (neg x) (neg y)) (trans (cong-add (addN x) (addN y)) (addZ zero)))) ;
 hom-zero (f : A -> A) (fa : (x y : A) -> Id A (f (add x y)) (add (f x) (f y))) : Id A (f zero) zero =
  add-cancel (f zero) (f zero) (trans (sym (fa zero zero)) (ap f (addZ zero))) ;
 hom-neg (f : A -> A) (fa : (x y : A) -> Id A (f (add x y)) (add (f x) (f y))) (x : A) :
  Id A (f (neg x)) (neg (f x)) =
  neg-uniq (f x) (f (neg x)) (trans (sym (fa x (neg x))) (trans (ap f (addN x)) (hom-zero f fa))) ;
} ;

module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module NA = NCAlgebra[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 set : (n : Nat) -> Pr.isSet (Ext n) = split {
  zero -> setR ;
  suc n | r -> Pr.isSet-Sigma (Ext n) (\ x -> Ext n) r (\ x -> r) } ;

 ---------------------------------------------------------------------
 -- the additive group and the scaling, componentwise

 eaddA : (n : Nat) (x y w : Ext n) -> Id (Ext n) (eadd n x (eadd n y w)) (eadd n (eadd n x y) w) = split {
  zero -> addA ;
  suc n | r -> \ x y w -> pair-eq (r x.1 y.1 w.1) (r x.2 y.2 w.2) } ;
 eaddC : (n : Nat) (x y : Ext n) -> Id (Ext n) (eadd n x y) (eadd n y x) = split {
  zero -> addC ;
  suc n | r -> \ x y -> pair-eq (r x.1 y.1) (r x.2 y.2) } ;
 eaddZ : (n : Nat) (x : Ext n) -> Id (Ext n) (eadd n x (ezero n)) x = split {
  zero -> addZ ;
  suc n | r -> \ x -> pair-eq (r x.1) (r x.2) } ;
 eaddN : (n : Nat) (x : Ext n) -> Id (Ext n) (eadd n x (eneg n x)) (ezero n) = split {
  zero -> addN ;
  suc n | r -> \ x -> pair-eq (r x.1) (r x.2) } ;

 module At (n : Nat) {
  module G = AG[Ext n,ezero n,eadd n,eneg n,eaddA n,eaddC n,eaddZ n,eaddN n] ;
 } ;

 escale-one : (n : Nat) (x : Ext n) -> Id (Ext n) (escale n o x) x = split {
  zero -> L.one-left ;
  suc n | r -> \ x -> pair-eq (r x.1) (r x.2) } ;
 escale-scale : (n : Nat) (a b : R) (x : Ext n) ->
  Id (Ext n) (escale n a (escale n b x)) (escale n (mul a b) x) = split {
  zero -> mulA ;
  suc n | r -> \ a b x -> pair-eq (r a b x.1) (r a b x.2) } ;
 escale-add : (n : Nat) (a : R) (x y : Ext n) ->
  Id (Ext n) (escale n a (eadd n x y)) (eadd n (escale n a x) (escale n a y)) = split {
  zero -> dist ;
  suc n | r -> \ a x y -> pair-eq (r a x.1 y.1) (r a x.2 y.2) } ;
 eadd-scale : (n : Nat) (a b : R) (x : Ext n) ->
  Id (Ext n) (escale n (add a b) x) (eadd n (escale n a x) (escale n b x)) = split {
  zero -> L.dist-left ;
  suc n | r -> \ a b x -> pair-eq (r a b x.1) (r a b x.2) } ;
 escale-neg (n : Nat) (a : R) (x : Ext n) : Id (Ext n) (escale n a (eneg n x)) (eneg n (escale n a x)) =
  At[n].G.hom-neg (escale n a) (escale-add n a) x ;

 ---------------------------------------------------------------------
 -- the grade involution

 alpha-add : (n : Nat) (x y : Ext n) -> Id (Ext n) (alpha n (eadd n x y)) (eadd n (alpha n x) (alpha n y)) = split {
  zero -> \ x y -> refl (add x y) ;
  suc n | r -> \ x y -> pair-eq (r x.1 y.1)
   (trans (ap (eneg n) (r x.2 y.2)) (At[n].G.neg-add (alpha n x.2) (alpha n y.2))) } ;
 alpha-zero (n : Nat) : Id (Ext n) (alpha n (ezero n)) (ezero n) = At[n].G.hom-zero (alpha n) (alpha-add n) ;
 alpha-neg (n : Nat) (x : Ext n) : Id (Ext n) (alpha n (eneg n x)) (eneg n (alpha n x)) =
  At[n].G.hom-neg (alpha n) (alpha-add n) x ;
 alpha-scale : (n : Nat) (a : R) (x : Ext n) -> Id (Ext n) (alpha n (escale n a x)) (escale n a (alpha n x)) = split {
  zero -> \ a x -> refl (mul a x) ;
  suc n | r -> \ a x -> pair-eq (r a x.1)
   (trans (ap (eneg n) (r a x.2)) (sym (escale-neg n a (alpha n x.2)))) } ;
 alpha-emb : (n : Nat) (a : R) -> Id (Ext n) (alpha n (emb n a)) (emb n a) = split {
  zero -> \ a -> refl a ;
  suc n | r -> \ a -> pair-eq (r a) (trans (ap (eneg n) (alpha-zero n)) At[n].G.neg-zero) } ;
 alpha-alpha : (n : Nat) (x : Ext n) -> Id (Ext n) (alpha n (alpha n x)) x = split {
  zero -> \ x -> refl x ;
  suc n | r -> \ x -> pair-eq (r x.1)
   (trans (ap (eneg n) (alpha-neg n (alpha n x.2))) (trans (At[n].G.neg-neg (alpha n (alpha n x.2))) (r x.2))) } ;

 ---------------------------------------------------------------------
 -- distributivity, and its consequences for 0 and negation

 dist-left : (n : Nat) (x y w : Ext n) ->
  Id (Ext n) (emul n x (eadd n y w)) (eadd n (emul n x y) (emul n x w)) = split {
  zero -> dist ;
  suc n | r -> \ x y w -> pair-eq (r x.1 y.1 w.1)
   (trans (At[n].G.cong-add (r x.1 y.2 w.2)
            (trans (ap (emul n x.2) (alpha-add n y.1 w.1)) (r x.2 (alpha n y.1) (alpha n w.1))))
    (At[n].G.swap (emul n x.1 y.2) (emul n x.1 w.2) (emul n x.2 (alpha n y.1)) (emul n x.2 (alpha n w.1)))) } ;
 dist-right : (n : Nat) (x y w : Ext n) ->
  Id (Ext n) (emul n (eadd n x y) w) (eadd n (emul n x w) (emul n y w)) = split {
  zero -> L.dist-left ;
  suc n | r -> \ x y w -> pair-eq (r x.1 y.1 w.1)
   (trans (At[n].G.cong-add (r x.1 y.1 w.2) (r x.2 y.2 (alpha n w.1)))
    (At[n].G.swap (emul n x.1 w.2) (emul n y.1 w.2) (emul n x.2 (alpha n w.1)) (emul n y.2 (alpha n w.1)))) } ;
 mul-zero-r (n : Nat) (x : Ext n) : Id (Ext n) (emul n x (ezero n)) (ezero n) =
  At[n].G.hom-zero (emul n x) (dist-left n x) ;
 mul-zero-l (n : Nat) (x : Ext n) : Id (Ext n) (emul n (ezero n) x) (ezero n) =
  At[n].G.hom-zero (\ y -> emul n y x) (\ y w -> dist-right n y w x) ;
 mul-neg-r (n : Nat) (x y : Ext n) : Id (Ext n) (emul n x (eneg n y)) (eneg n (emul n x y)) =
  At[n].G.hom-neg (emul n x) (dist-left n x) y ;
 mul-neg-l (n : Nat) (x y : Ext n) : Id (Ext n) (emul n (eneg n x) y) (eneg n (emul n x y)) =
  At[n].G.hom-neg (\ w -> emul n w y) (\ w w' -> dist-right n w w' y) x ;

 -- alpha is multiplicative
 alpha-mul : (n : Nat) (x y : Ext n) -> Id (Ext n) (alpha n (emul n x y)) (emul n (alpha n x) (alpha n y)) = split {
  zero -> \ x y -> refl (mul x y) ;
  suc n | r -> \ x y -> pair-eq (r x.1 y.1)
   (trans (ap (eneg n) (trans (alpha-add n (emul n x.1 y.2) (emul n x.2 (alpha n y.1)))
                         (At[n].G.cong-add (r x.1 y.2) (r x.2 (alpha n y.1)))))
    (trans (At[n].G.neg-add (emul n (alpha n x.1) (alpha n y.2)) (emul n (alpha n x.2) (alpha n (alpha n y.1))))
     (At[n].G.cong-add (sym (mul-neg-r n (alpha n x.1) (alpha n y.2)))
                       (sym (mul-neg-l n (alpha n x.2) (alpha n (alpha n y.1))))))) } ;

 ---------------------------------------------------------------------
 -- scalars and the unit

 emb-mul : (n : Nat) (a : R) (x : Ext n) -> Id (Ext n) (emul n (emb n a) x) (escale n a x) = split {
  zero -> \ a x -> refl (mul a x) ;
  suc n | r -> \ a x -> pair-eq (r a x.1)
   (trans (At[n].G.cong-add (r a x.2) (mul-zero-l n (alpha n x.1))) (eaddZ n (escale n a x.2))) } ;
 mul-emb : (n : Nat) (x : Ext n) (a : R) -> Id (Ext n) (emul n x (emb n a)) (escale n a x) = split {
  zero -> mulC ;
  suc n | r -> \ x a -> pair-eq (r x.1 a)
   (trans (At[n].G.cong-add (mul-zero-r n x.1) (trans (ap (emul n x.2) (alpha-emb n a)) (r x.2 a)))
    (At[n].G.zl (escale n a x.2))) } ;
 one-left (n : Nat) (x : Ext n) : Id (Ext n) (emul n (eone n) x) x = trans (emb-mul n o x) (escale-one n x) ;
 one-right (n : Nat) (x : Ext n) : Id (Ext n) (emul n x (eone n)) x = trans (mul-emb n x o) (escale-one n x) ;

 scale-mul-left : (n : Nat) (a : R) (x y : Ext n) ->
  Id (Ext n) (emul n (escale n a x) y) (escale n a (emul n x y)) = split {
  zero -> \ a x y -> sym (mulA a x y) ;
  suc n | r -> \ a x y -> pair-eq (r a x.1 y.1)
   (trans (At[n].G.cong-add (r a x.1 y.2) (r a x.2 (alpha n y.1)))
    (sym (escale-add n a (emul n x.1 y.2) (emul n x.2 (alpha n y.1))))) } ;
 scale-mul-right : (n : Nat) (a : R) (x y : Ext n) ->
  Id (Ext n) (emul n x (escale n a y)) (escale n a (emul n x y)) = split {
  zero -> \ a x y -> L.mul-swap x a y ;
  suc n | r -> \ a x y -> pair-eq (r a x.1 y.1)
   (trans (At[n].G.cong-add (r a x.1 y.2) (trans (ap (emul n x.2) (alpha-scale n a y.1)) (r a x.2 (alpha n y.1))))
    (sym (escale-add n a (emul n x.1 y.2) (emul n x.2 (alpha n y.1))))) } ;

 ---------------------------------------------------------------------
 -- associativity

 mulA' : (n : Nat) (x y w : Ext n) -> Id (Ext n) (emul n x (emul n y w)) (emul n (emul n x y) w) = split {
  zero -> mulA ;
  suc n | r -> \ x y w -> pair-eq (r x.1 y.1 w.1)
   (trans (At[n].G.cong-add (dist-left n x.1 (emul n y.1 w.2) (emul n y.2 (alpha n w.1)))
                            (ap (emul n x.2) (alpha-mul n y.1 w.1)))
    (trans (At[n].G.cong-add (At[n].G.cong-add (r x.1 y.1 w.2) (r x.1 y.2 (alpha n w.1)))
                             (r x.2 (alpha n y.1) (alpha n w.1)))
     (trans (sym (eaddA n (emul n (emul n x.1 y.1) w.2) (emul n (emul n x.1 y.2) (alpha n w.1))
                          (emul n (emul n x.2 (alpha n y.1)) (alpha n w.1))))
      (ap (eadd n (emul n (emul n x.1 y.1) w.2))
          (sym (dist-right n (emul n x.1 y.2) (emul n x.2 (alpha n y.1)) (alpha n w.1))))))) } ;

 algebra (n : Nat) : NA.Algebra = new NA.Algebra[Ext n,set n,ezero n,eadd n,eneg n,escale n,eone n,emul n,
  eaddA n,eaddC n,eaddZ n,eaddN n,escale-one n,escale-scale n,escale-add n,eadd-scale n,
  mulA' n,one-left n,one-right n,dist-left n,dist-right n,scale-mul-left n,scale-mul-right n] ;

 ---------------------------------------------------------------------
 -- the generators: i is linear, alpha (i a) = - i a, and i(a) i(a) = 0

 escale-zero (n : Nat) (a : R) : Id (Ext n) (escale n a (ezero n)) (ezero n) =
  At[n].G.hom-zero (escale n a) (escale-add n a) ;
 -- Multiplication of an arbitrary vector by the zero scalar. Additive
 -- cancellation applied to (0+0)x = 0x+0x proves this once on Ext n.
 zero-scale (n : Nat) (x : Ext n) : Id (Ext n) (escale n z x) (ezero n) =
  At[n].G.add-cancel (escale n z x) (escale n z x)
   (trans (sym (eadd-scale n z z x)) (ap (\ a -> escale n a x) (addZ z))) ;
 emb-add : (n : Nat) (a b : R) -> Id (Ext n) (emb n (add a b)) (eadd n (emb n a) (emb n b)) = split {
  zero -> \ a b -> refl (add a b) ;
  suc n | r -> \ a b -> pair-eq (r a b) (sym (eaddZ n (ezero n))) } ;
 emb-scale : (n : Nat) (a b : R) -> Id (Ext n) (emb n (mul a b)) (escale n a (emb n b)) = split {
  zero -> \ a b -> refl (mul a b) ;
  suc n | r -> \ a b -> pair-eq (r a b) (sym (escale-zero n a)) } ;
 gen-add : (n : Nat) (a b : Ps.Fin n -> R) ->
  Id (Ext n) (gen n (\ k -> add (a k) (b k))) (eadd n (gen n a) (gen n b)) = split {
  zero -> \ a b -> sym (addZ z) ;
  suc n | r -> \ a b -> pair-eq (r (\ k -> a (inl k)) (\ k -> b (inl k))) (emb-add n (a (inr tt)) (b (inr tt))) } ;
 gen-scale : (n : Nat) (c : R) (a : Ps.Fin n -> R) ->
  Id (Ext n) (gen n (\ k -> mul c (a k))) (escale n c (gen n a)) = split {
  zero -> \ c a -> sym (L.mul-zero c) ;
  suc n | r -> \ c a -> pair-eq (r c (\ k -> a (inl k))) (emb-scale n c (a (inr tt))) } ;
 alpha-gen : (n : Nat) (a : Ps.Fin n -> R) -> Id (Ext n) (alpha n (gen n a)) (eneg n (gen n a)) = split {
  zero -> \ a -> sym L.neg-zero ;
  suc n | r -> \ a -> pair-eq (r (\ k -> a (inl k))) (ap (eneg n) (alpha-emb n (a (inr tt)))) } ;
 gen-sq : (n : Nat) (a : Ps.Fin n -> R) -> Id (Ext n) (emul n (gen n a) (gen n a)) (ezero n) = split {
  zero -> \ a -> L.mul-zero z ;
  suc n | r -> \ a -> pair-eq (r (\ k -> a (inl k)))
   (trans (At[n].G.cong-add (mul-emb n (gen n (\ k -> a (inl k))) (a (inr tt)))
     (trans (ap (emul n (emb n (a (inr tt)))) (alpha-gen n (\ k -> a (inl k))))
      (trans (mul-neg-r n (emb n (a (inr tt))) (gen n (\ k -> a (inl k))))
       (ap (eneg n) (emb-mul n (a (inr tt)) (gen n (\ k -> a (inl k))))))))
    (eaddN n (escale n (a (inr tt)) (gen n (\ k -> a (inl k)))))) } ;
} ;
