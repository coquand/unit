-- Informal proof (PCC2, the column replacement in Proposition 9).
-- A binary subset index has an increasing list of positions. Omitting
-- the last position lifts the smaller list; including it appends the last
-- position. Selecting a column family means composing with this list.
-- replace fills these positions with a supplied list, retaining the other
-- columns. Induction on the subset proves that selection after replace
-- recovers the supplied list, and complementary selection is unchanged.
-- These statements use exactly the recursive clauses of positions and
-- replace, Fin(n+1)=Fin(n)+Top, and the singleton equation for Top.
--
-- The selected standard vectors of ExteriorBasis are the Kronecker vectors
-- at these positions: prove this by induction, checking each coordinate.
-- Matrix action on them consequently selects the corresponding columns,
-- by act-delta. The image of a subset basis vector is therefore the
-- ordered product of the selected columns, by image-product.
--
-- Later, apply the exterior map of the replaced matrix to
-- basis(I)*star(basis(I))=omega. Its first factor is the supplied ordered
-- product. Its second factor is unchanged, because star(basis(I)) is a
-- scalar multiple of the complementary basis vector. Taking top gives
-- the column-replacement determinant. This is the coefficient calculation
-- of PCC2 Proposition 9, with its signs supplied by the signed complement.
-- To justify the volume equation, the product has degree n by
-- count-complement and deg-mul. Its top coefficient is 1: star-pair,
-- star-isometry and dot-basis reduce it to the diagonal basis coefficient.
-- The free top-degree theorem then gives the equation with omega.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module H = ExteriorHomogeneous[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module UP = ExteriorUniversal[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module D = MnSums[l].Over[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 positions : (n : Nat) (i : C.Index n) -> Ps.Fin (BA.count n i) -> Ps.Fin n = split {
  zero -> \ i -> split { } ;
  suc n | r -> split {
   inl i -> \ k -> inl (r i k) ;
   inr i -> split { inl k -> inl (r i k) ; inr t -> inr t } } } ;
 module Columns (X : U l) {
  selected (n : Nat) (i : C.Index n) (b : Ps.Fin n -> X) : Ps.Fin (BA.count n i) -> X =
   \ k -> b (positions n i k) ;
  selected-value (n : Nat) (i : C.Index n) (b : Ps.Fin n -> X) (k : Ps.Fin (BA.count n i)) :
   Id X (selected n i b k) (b (positions n i k)) = refl (b (positions n i k)) ;
  replace : (n : Nat) (i : C.Index n) -> (Ps.Fin (BA.count n i) -> X) -> (Ps.Fin n -> X) -> Ps.Fin n -> X = split {
   zero -> \ i a b -> split { } ;
   suc n | r -> split {
    inl i -> \ a b -> split { inl k -> r i a (\ j -> b (inl j)) k ; inr t -> b (inr t) } ;
    inr i -> \ a b -> split { inl k -> r i (\ j -> a (inl j)) (\ j -> b (inl j)) k ; inr t -> a (inr t) } } } ;
  selected-replace : (n : Nat) (i : C.Index n) (a : Ps.Fin (BA.count n i) -> X) (b : Ps.Fin n -> X)
   (k : Ps.Fin (BA.count n i)) -> Id X (selected n i (replace n i a b) k) (a k) = split {
   zero -> \ i a b -> split { } ;
   suc n | r -> split {
    inl i -> \ a b k -> r i a (\ j -> b (inl j)) k ;
    inr i -> \ a b -> split {
     inl k -> r i (\ j -> a (inl j)) (\ j -> b (inl j)) k ;
     inr t -> refl (a (inr t)) } } } ;
  transparent H.complement ;
  complementary-replace : (n : Nat) (i : C.Index n) (a : Ps.Fin (BA.count n i) -> X) (b : Ps.Fin n -> X)
   (k : Ps.Fin (BA.count n (H.complement n i))) ->
   Id X (selected n (H.complement n i) (replace n i a b) k) (selected n (H.complement n i) b k) = split {
   zero -> \ i a b -> split { } ;
   suc n | r -> split {
    inl i -> \ a b -> split {
     inl k -> r i a (\ j -> b (inl j)) k ;
     inr t -> refl (b (inr t)) } ;
    inr i -> \ a b k -> r i (\ j -> a (inl j)) (\ j -> b (inl j)) k } } ;
  opaque H.complement ;
  opaque selected ; opaque replace ;
 } ;
 delta-inl-at (n : Nat) (k : Ps.Fin n) : (j : Ps.Fin (suc n)) ->
  Id R (UP.ext0 n (D.delta n k) j) (D.delta (suc n) (inl k) j) = split {
  inl j -> refl (D.delta n k j) ; inr t -> refl z } ;
 delta-inl (n : Nat) (k : Ps.Fin n) :
  Id (AL.Vec (suc n)) (UP.ext0 n (D.delta n k)) (D.delta (suc n) (inl k)) =
  F.funext (Ps.Fin (suc n)) (\ j -> R) _ _ (delta-inl-at n k) ;
 delta-last-at (n : Nat) (t : Top) : (j : Ps.Fin (suc n)) ->
  Id R (UP.last n j) (D.delta (suc n) (inr t) j) = split {
  inl j -> refl z ; inr u -> refl o } ;
 delta-last (n : Nat) (t : Top) :
  Id (AL.Vec (suc n)) (UP.last n) (D.delta (suc n) (inr t)) =
  F.funext (Ps.Fin (suc n)) (\ j -> R) _ _ (delta-last-at n t) ;
 select-position : (n : Nat) (i : C.Index n) (k : Ps.Fin (BA.count n i)) ->
  Id (AL.Vec n) (BA.select n i k) (D.delta n (positions n i k)) = split {
  zero -> \ i -> split { } ;
  suc n | r -> split {
   inl i -> \ k -> trans (ap (UP.ext0 n) (r i k)) (delta-inl n (positions n i k)) ;
   inr i -> split {
    inl k -> trans (ap (UP.ext0 n) (r i k)) (delta-inl n (positions n i k)) ;
    inr t -> delta-last n t } } } ;
 opaque positions ;
 act-selected (n : Nat) (A : DT.Mat n) (i : C.Index n) (k : Ps.Fin (BA.count n i)) :
  Id (AL.Vec n) (DT.act n A (BA.select n i k)) (Columns[AL.Vec n].selected n i A k) =
  trans (ap (DT.act n A) (select-position n i k))
   (trans (F.funext (Ps.Fin n) (\ j -> R) _ _ (DT.act-delta n A (positions n i k)))
    (sym (Columns[AL.Vec n].selected-value n i A k))) ;
 basis-diag : (n : Nat) (i : C.Index n) -> Id R (CO.coeff n (CO.basis n i) i) o = split {
  zero -> \ i -> refl o ; suc n | r -> split { inl i -> r i ; inr i -> r i } } ;
 basis-star-top (n : Nat) (i : C.Index n) :
  Id R (top n (emul n (CO.basis n i) (DU.star n (CO.basis n i)))) o =
  trans (sym (DU.star-pair n (CO.basis n i) (DU.star n (CO.basis n i))))
   (trans (TP.star-isometry n (CO.basis n i) (CO.basis n i))
    (trans (CO.dot-basis n (CO.basis n i) i) (basis-diag n i))) ;
 basis-star-degree (n : Nat) (i : C.Index n) :
  DG.Deg n n (emul n (CO.basis n i) (DU.star n (CO.basis n i))) =
  subst (\ k -> DG.Deg n k (emul n (CO.basis n i) (DU.star n (CO.basis n i))))
   (HO.count-complement n i)
   (HO.deg-mul n (BA.count n i) (BA.count n (H.complement n i))
    (CO.basis n i) (DU.star n (CO.basis n i)) (BA.basis-degree n i) (HO.star-basis-degree n i)) ;
 basis-star (n : Nat) (i : C.Index n) :
  Id (Ext n) (emul n (CO.basis n i) (DU.star n (CO.basis n i))) (DG.omega n) =
  trans (DG.deg-top n (emul n (CO.basis n i) (DU.star n (CO.basis n i))) (basis-star-degree n i))
   (trans (ap (\ a -> escale n a (DG.omega n)) (basis-star-top n i)) (EA.escale-one n (DG.omega n))) ;
 module At (n : Nat) {
  module V = Columns[AL.Vec n] ;
  product (i : C.Index n) (B : DT.Mat n) : Ext n =
   eprod n (BA.count n i) (\ k -> gen n (V.selected n i B k)) ;
  product-value (i : C.Index n) (B : DT.Mat n) :
   Id (Ext n) (product i B) (eprod n (BA.count n i) (\ k -> gen n (V.selected n i B k))) = refl (product i B) ;
  image (i : C.Index n) (B : DT.Mat n) :
   Id (Ext n) (DT.Map[n,B].value (CO.basis n i)) (product i B) =
   trans (BA.image-product n B i)
    (DT.eprod-cong n (BA.count n i)
     (\ k -> gen n (DT.act n B (BA.select n i k))) (\ k -> gen n (V.selected n i B k))
     (\ k -> ap (gen n) (act-selected n B i k))) ;
  opaque product ;
  module Replaced (i : C.Index n) (a : Ps.Fin (BA.count n i) -> AL.Vec n) (B : DT.Mat n) {
   module M = DT.Map[n,V.replace n i a B] ;
   module MB = DT.Map[n,B] ;
   selected-image : Id (Ext n) (M.value (CO.basis n i)) (eprod n (BA.count n i) (\ k -> gen n (a k))) =
    trans (image i (V.replace n i a B))
     (trans (product-value i (V.replace n i a B))
      (DT.eprod-cong n (BA.count n i) (\ k -> gen n (V.selected n i (V.replace n i a B) k))
       (\ k -> gen n (a k)) (\ k -> ap (gen n) (V.selected-replace n i a B k)))) ;
   complementary-image : Id (Ext n) (M.value (CO.basis n (H.complement n i))) (MB.value (CO.basis n (H.complement n i))) =
    trans (image (H.complement n i) (V.replace n i a B))
     (trans (product-value (H.complement n i) (V.replace n i a B))
      (trans (DT.eprod-cong n (BA.count n (H.complement n i))
       (\ k -> gen n (V.selected n (H.complement n i) (V.replace n i a B) k))
       (\ k -> gen n (V.selected n (H.complement n i) B k))
       (\ k -> ap (gen n) (V.complementary-replace n i a B k)))
       (sym (trans (image (H.complement n i) B) (product-value (H.complement n i) B))))) ;
   star-image : Id (Ext n) (M.value (DU.star n (CO.basis n i))) (MB.value (DU.star n (CO.basis n i))) =
    trans (ap M.value (HO.star-basis n i))
     (trans (M.value-scale (HO.epsilon n i) (CO.basis n (H.complement n i)))
      (trans (ap (escale n (HO.epsilon n i)) complementary-image)
       (sym (trans (ap MB.value (HO.star-basis n i)) (MB.value-scale (HO.epsilon n i) (CO.basis n (H.complement n i))))))) ;
   determinant : Id R
    (top n (emul n (eprod n (BA.count n i) (\ k -> gen n (a k))) (MB.value (DU.star n (CO.basis n i)))))
    (det n (V.replace n i a B)) =
    trans (sym (trans (ap (top n) (M.value-mul (CO.basis n i) (DU.star n (CO.basis n i))))
      (ap (top n) (DT.emul-cong n selected-image star-image))))
     (trans (ap (\ x -> top n (M.value x)) (basis-star n i)) (BA.image-top n (V.replace n i a B))) ;
  } ;
 } ;
} ;
