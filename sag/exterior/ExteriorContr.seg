-- "The" exterior algebra (DESIGN.md §2).  For an algebra E with i : Alt n E,
--   IsExterior n E i = (A : Alg) -> isEquiv (f |-> f . i : AlgHom E A -> Alt n A) ,
-- a proposition, and the type
--   Exterior n = ((E : Alg) * Alt n E) * IsExterior
-- is contractible with centre the model (L n, i).  Contraction: for
-- (E, i, u), the extension phi : L n -> E of i and the map psi : E -> L n
-- given by u are inverse (psi phi = id by uniqueness on L n, phi psi = id
-- by u at E), so phi is an algebra isomorphism; by iso-induction the pair
-- (L n, i) is equal to (E, phi . i) = (E, i).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Fh = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module CT = FunExtUA[l+] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module S = AlgSIP[l].Over[Rg,setR] ;
 module I = AlgSIPInd[l,l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module UP = ExteriorUniversal[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;
 Lam (n : Nat) : S.Alg = UP.Lam n ;
 Alt (n : Nat) (A : S.Alg) : U l = AL.In[A].Alt n ;
 idHom (A : S.Alg) : AL.AlgHom A A = (\ x -> x, S.idHom A) ;

 alt-set (n : Nat) (A : S.Alg) : Pr.isSet (Alt n A) =
  Pr.isSet-Sigma (AL.Vec n -> A.A) (AL.In[A].Prop n)
   (F.isSet-Pi (AL.Vec n) (\ a -> A.A) (\ a -> A.set))
   (\ j -> Pr.prop-to-set (AL.In[A].Prop n j) (AL.In[A].prop-prop n j)) ;
 alt-eq (n : Nat) (A : S.Alg) (j k : Alt n A) (h : (a : AL.Vec n) -> Id A.A (j.1 a) (k.1 a)) : Id (Alt n A) j k =
  Pr.Sigma-eq (AL.Vec n -> A.A) (AL.In[A].Prop n) j.1 k.1 j.2 k.2
   (F.funext (AL.Vec n) (\ a -> A.A) j.1 k.1 h) (AL.In[A].prop-prop n k.1) ;

 -- f . i
 precomp (n : Nat) (E : S.Alg) (i : Alt n E) (A : S.Alg) (f : AL.AlgHom E A) : Alt n A =
  (\ a -> f.1 (i.1 a),
   ((\ a b -> trans (ap f.1 (i.2.1.1 a b)) (f.2.1 (i.1 a) (i.1 b)),
     \ c a -> trans (ap f.1 (i.2.1.2 c a)) (f.2.2.1 c (i.1 a))),
    \ a -> trans (sym (f.2.2.2.1 (i.1 a) (i.1 a))) (trans (ap f.1 (i.2.2 a)) AL.In[A].H[E,f].zero))) ;
 IsExterior (n : Nat) (E : S.Alg) (i : Alt n E) : U l+ =
  (A : S.Alg) -> Pr.isEquiv (AL.AlgHom E A) (Alt n A) (precomp n E i A) ;
 isExterior-prop (n : Nat) (E : S.Alg) (i : Alt n E) : Hi.isProp (IsExterior n E i) =
  Fh.isProp-Pi S.Alg (\ A -> Pr.isEquiv (AL.AlgHom E A) (Alt n A) (precomp n E i A))
   (\ A -> AffineHLevels[l].EquivalenceProofs[AL.AlgHom E A,Alt n A,alt-set n A,precomp n E i A].proposition) ;
 Pairs (n : Nat) : U l+ = (E : S.Alg) * Alt n E ;
 Exterior (n : Nat) : U l+ = (p : Pairs n) * IsExterior n p.1 p.2 ;

 ---------------------------------------------------------------------
 -- the centre: the model

 -- i n is the identity composed with the generators
 i (n : Nat) : Alt n (Lam n) = UP.In[Lam n].precomp n (idHom (Lam n)) ;
 -- an equivalence stays one along a homotopy
 equiv-htpy (X Y : U l) (f g : X -> Y) (h : (x : X) -> Id Y (f x) (g x)) (e : Pr.isEquiv X Y f) : Pr.isEquiv X Y g =
  Pr.qinv X Y g e.sec (\ y -> trans (sym (h (e.sec y))) (e.sec-eq y))
   (\ x -> trans (ap e.sec (sym (h x))) (Pr.sec-ret X Y f e x)) ;
 model-exterior (n : Nat) : IsExterior n (Lam n) (i n) = \ A ->
  equiv-htpy (AL.AlgHom (Lam n) A) (Alt n A) (UP.In[A].precomp n) (precomp n (Lam n) (i n) A)
   (\ f -> alt-eq n A (UP.In[A].precomp n f) (precomp n (Lam n) (i n) A f) (\ a -> refl (f.1 (gen n a))))
   (UP.In[A].universal n) ;
 centre (n : Nat) : Exterior n = ((Lam n,i n),model-exterior n) ;

 ---------------------------------------------------------------------
 -- along an isomorphism theta : L n ~ B, (L n, i) = (B, theta . i)

 transported (n : Nat) (B : S.Alg) (theta : S.AlgIso (Lam n) B) : Alt n B =
  precomp n (Lam n) (i n) B (theta.1.1,theta.2) ;
 along (n : Nat) (B : S.Alg) (theta : S.AlgIso (Lam n) B) :
  Id (Pairs n) (Lam n,i n) (B,transported n B theta) =
  I.iso-ind (Lam n) (\ B1 theta1 -> Id (Pairs n) (Lam n,i n) (B1,transported n B1 theta1))
   (Hi.ap (Alt n (Lam n)) (Pairs n) (\ j -> (Lam n,j)) (i n) (transported n (Lam n) (S.idIso (Lam n)))
     (alt-eq n (Lam n) (i n) (transported n (Lam n) (S.idIso (Lam n))) (\ a -> refl (gen n a))))
   B theta ;

 ---------------------------------------------------------------------
 -- the contraction

 module Contr (n : Nat) (E : S.Alg) (j : Alt n E) (u : IsExterior n E j) {
  phi : AL.AlgHom (Lam n) E = UP.In[E].ext n j ;
  phi-gen (a : AL.Vec n) : Id E.A (phi.1 (gen n a)) (j.1 a) = (UP.In[E].extend n j).2.1 a ;
  psi : AL.AlgHom E (Lam n) = (u (Lam n)).sec (i n) ;
  psi-j (a : AL.Vec n) : Id (Ext n) (psi.1 (j.1 a)) (gen n a) =
   Pr.ap (Alt n (Lam n)) (Ext n) (\ k -> k.1 a) (precomp n E j (Lam n) psi) (i n) ((u (Lam n)).sec-eq (i n)) ;
  -- psi phi = id, by uniqueness on L n
  psi-phi (x : Ext n) : Id (Ext n) (psi.1 (phi.1 x)) x =
   UP.In[Lam n].unique n (AL.comp (Lam n) E (Lam n) psi phi) (idHom (Lam n))
    (\ a -> trans (ap psi.1 (phi-gen a)) (psi-j a)) x ;
  -- phi psi = id, since both compose with j to j and precomposition with j is injective
  phi-psi (x : E.A) : Id E.A (phi.1 (psi.1 x)) x =
   Pr.ap (AL.AlgHom E E) E.A (\ f -> f.1 x) (AL.comp E (Lam n) E phi psi) (idHom E)
    (Equivalences[l].injective (AL.AlgHom E E) (Alt n E) (precomp n E j E) (u E)
      (AL.comp E (Lam n) E phi psi) (idHom E)
      (alt-eq n E (precomp n E j E (AL.comp E (Lam n) E phi psi)) (precomp n E j E (idHom E))
        (\ a -> trans (ap phi.1 (psi-j a)) (phi-gen a)))) ;
  iso : S.AlgIso (Lam n) E = ((phi.1,Pr.qinv (Ext n) E.A phi.1 psi.1 phi-psi psi-phi),phi.2) ;
  pairs : Id (Pairs n) (Lam n,i n) (E,j) =
   Hi.trans (Pairs n) (Lam n,i n) (E,transported n E iso) (E,j) (along n E iso)
    (Hi.ap (Alt n E) (Pairs n) (\ k -> (E,k)) (transported n E iso) j
      (alt-eq n E (transported n E iso) j phi-gen)) ;
  path : Id (Exterior n) (centre n) ((E,j),u) =
   Hi.Sigma-eq (Pairs n) (\ p -> IsExterior n p.1 p.2) (Lam n,i n) (E,j) (model-exterior n) u pairs
    (isExterior-prop n E j) ;
 } ;
 contractible (n : Nat) : CT.isContr (Exterior n) = (centre n,\ c -> Contr[n,c.1.1,c.1.2,c.2].path) ;
} ;
