-- Vector contraction, the adjoint of left multiplication by a generator.
--
-- Informal proof and correspondence with the declarations below.
-- Write x=(u,t) in Ext(n+1)=Ext(n)+Ext(n)e and v=(v',a).
-- Define c_v(x)=(c_v'(u)+a alpha(t),c_v'(t)); in rank zero c_v=0.
-- contract-zero-def and contract-step-def record precisely these equations.
-- scale-swap is commutativity of successive scalar multiplications.
-- Induction with the defining equations proves contract-add and
-- contract-scale, using the four-term additive interchange. Additivity
-- then gives contract-zero and contract-neg. For contract-alpha, expand
-- the two components and use c alpha=-alpha c inductively, alpha^2=id,
-- and preservation of negatives and scalar multiplication by alpha.
-- alpha-neg-alpha isolates the last of these sign computations.
--
-- Name left multiplication by a generator left-wedge. Its value, rank-zero
-- and pair equations follow from gen-step-def and emb-mul; lock it there.
-- The pairing identity contract-pair is also componentwise induction:
-- dot(c_v x,y)=dot(x,left-wedge(v,y)). In the successor case, the a-term in
-- the first component is moved across dot by dot-scale-left and
-- dot-alpha; the other two terms use induction. Reassociation and
-- commutation of the three scalar summands give the product formula.
-- The displayed pairings are evaluated by dot-pair and dot-pair-right.
-- Its intermediate three-summand expression is written explicitly; the
-- final pair is reconstructed by left-wedge-step. No generator product
-- is silently computed inside that comparison.
--
-- The vector pairing vdot(v,w) is the sum of coordinate products.
-- Mixed states the canonical anticommutator relation
-- c_v(gen(w)x)+gen(w)c_v(x)=vdot(v,w)x.
-- Cancel contains the two additive cancellation arrangements needed in
-- its successor proof. MixedStep uses the shared vector and pair
-- accessors, contraction and left-wedge under their existing names. Its top-first/top-second and
-- bottom-first/bottom-second expand the two sides using linearity,
-- alpha-gen, alpha-mul and c alpha=-alpha c. The middle terms cancel;
-- top-result and bottom-result use the two induction hypotheses.
-- result assembles the components; mixed supplies induction on n.
-- Those component calculations explicitly open the definitions named
-- by MixedStep (including the decomposition of left-wedge, gen, emul
-- and contraction).
--
-- ExteriorContr.gen-commute uses the existing exterior universal extension
-- at the identity generators. The extension's identity and graded
-- equations are named there, and give gen(w)x=alpha(x)gen(w).
-- Thus right-commute follows
-- from alpha^2=id. solve-sub is elementary additive cancellation.
-- Apply Mixed to alpha(x), use right-commute and c alpha=-alpha c,
-- and cancel to obtain contract-right, the right-generator Leibniz rule.
-- After these characterising lemmas, contract and vdot are locked.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module VS = FiniteIdeal[l].Sums[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 -- Component inductions explicitly use the concrete pair representation.
 transparent first ; transparent second ;
 -- Typed accessors for the two parts of a vector. Subsequent proofs use
 -- their names rather than repeatedly decoding Fin(n+1) at applications.
 vector-prefix (n : Nat) (v : AL.Vec (suc n)) : AL.Vec n = \ i -> v (inl i) ;
 vector-last (n : Nat) (v : AL.Vec (suc n)) : R = v (inr tt) ;
 vector-prefix-value (n : Nat) (v : AL.Vec (suc n)) (i : Ps.Fin n) :
  Id R (vector-prefix n v i) (v (inl i)) = refl (v (inl i)) ;
 vector-last-value (n : Nat) (v : AL.Vec (suc n)) : Id R (vector-last n v) (v (inr tt)) = refl (v (inr tt)) ;
 gen-step-def (n : Nat) (v : AL.Vec (suc n)) :
  Id (Ext (suc n)) (gen (suc n) v) (gen n (vector-prefix n v),emb n (vector-last n v)) = refl (gen (suc n) v) ;
 -- The scalar finite sum visits the last coordinate first. Record its
 -- description in terms of named coordinates and vector parts once,
 -- opening the coordinate accessor here and locking it afterwards.
 transparent AL.coordinate ;
 vector-dot-sum-step (n : Nat) (v w : AL.Vec (suc n)) :
  Id R (VS.sum (suc n) (\ i -> mul (AL.coordinate (suc n) v i) (AL.coordinate (suc n) w i)))
   (add (mul (vector-last n v) (vector-last n w))
    (VS.sum n (\ i -> mul (AL.coordinate n (vector-prefix n v) i) (AL.coordinate n (vector-prefix n w) i)))) =
  refl (VS.sum (suc n) (\ i -> mul (AL.coordinate (suc n) v i) (AL.coordinate (suc n) w i))) ;
 opaque AL.coordinate ;
 opaque vector-prefix ; opaque vector-last ;
 contract : (n : Nat) -> AL.Vec n -> Ext n -> Ext n = split {
  zero -> \ v x -> z ; suc n | r -> \ v x ->
   (eadd n (r (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))),r (vector-prefix n v) (second n x)) } ;
 contract-zero-def (v : AL.Vec zero) (x : Ext zero) : Id R (contract zero v x) z = refl z ;
 contract-step-def (n : Nat) (v : AL.Vec (suc n)) (x : Ext (suc n)) :
  Id (Ext (suc n)) (contract (suc n) v x)
   (eadd n (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))),contract n (vector-prefix n v) (second n x)) =
  refl (contract (suc n) v x) ;
 scale-swap (n : Nat) (a b : R) (x : Ext n) :
  Id (Ext n) (escale n a (escale n b x)) (escale n b (escale n a x)) =
  trans (EA.escale-scale n a b x) (trans (ap (\ c -> escale n c x) (mulC a b)) (sym (EA.escale-scale n b a x))) ;
 contract-add : (n : Nat) (v : AL.Vec n) (x y : Ext n) ->
  Id (Ext n) (contract n v (eadd n x y)) (eadd n (contract n v x) (contract n v y)) = split {
  zero -> \ v x y -> sym (addZ z) ;
  suc n | r -> \ v x y -> ExteriorAlgebra[l].pair-eq
   (trans (EA.At[n].G.cong-add (r (vector-prefix n v) (first n x) (first n y))
     (trans (ap (escale n (vector-last n v)) (EA.alpha-add n (second n x) (second n y))) (EA.escale-add n (vector-last n v) (alpha n (second n x)) (alpha n (second n y)))))
    (EA.At[n].G.swap (contract n (vector-prefix n v) (first n x)) (contract n (vector-prefix n v) (first n y))
     (escale n (vector-last n v) (alpha n (second n x))) (escale n (vector-last n v) (alpha n (second n y)))))
   (r (vector-prefix n v) (second n x) (second n y)) } ;
 contract-scale : (n : Nat) (v : AL.Vec n) (a : R) (x : Ext n) ->
  Id (Ext n) (contract n v (escale n a x)) (escale n a (contract n v x)) = split {
  zero -> \ v a x -> sym (L.mul-zero a) ;
  suc n | r -> \ v a x -> ExteriorAlgebra[l].pair-eq
   (trans (EA.At[n].G.cong-add (r (vector-prefix n v) a (first n x))
     (trans (ap (escale n (vector-last n v)) (EA.alpha-scale n a (second n x))) (scale-swap n (vector-last n v) a (alpha n (second n x)))))
    (sym (EA.escale-add n a (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))))
   (r (vector-prefix n v) a (second n x)) } ;
 contract-zero (n : Nat) (v : AL.Vec n) : Id (Ext n) (contract n v (ezero n)) (ezero n) =
  EA.At[n].G.hom-zero (contract n v) (contract-add n v) ;
 contract-neg (n : Nat) (v : AL.Vec n) (x : Ext n) : Id (Ext n) (contract n v (eneg n x)) (eneg n (contract n v x)) =
  EA.At[n].G.hom-neg (contract n v) (contract-add n v) x ;
 alpha-neg-alpha (n : Nat) (x : Ext n) : Id (Ext n) (alpha n (eneg n (alpha n x))) (eneg n x) =
  trans (EA.alpha-neg n (alpha n x)) (ap (eneg n) (EA.alpha-alpha n x)) ;
 contract-alpha : (n : Nat) (v : AL.Vec n) (x : Ext n) ->
  Id (Ext n) (contract n v (alpha n x)) (eneg n (alpha n (contract n v x))) = split {
  zero -> \ v x -> sym L.neg-zero ;
  suc n | r -> \ v x -> ExteriorAlgebra[l].pair-eq
   (trans (EA.At[n].G.cong-add (r (vector-prefix n v) (first n x))
     (trans (ap (escale n (vector-last n v)) (alpha-neg-alpha n (second n x))) (EA.escale-neg n (vector-last n v) (second n x))))
    (trans (sym (EA.At[n].G.neg-add (alpha n (contract n (vector-prefix n v) (first n x))) (escale n (vector-last n v) (second n x))))
     (ap (eneg n) (sym (trans (EA.alpha-add n (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))
      (EA.At[n].G.cong-add (refl (alpha n (contract n (vector-prefix n v) (first n x))))
       (trans (EA.alpha-scale n (vector-last n v) (alpha n (second n x))) (ap (escale n (vector-last n v)) (EA.alpha-alpha n (second n x))))))))))
   (trans (contract-neg n (vector-prefix n v) (alpha n (second n x))) (ap (eneg n) (r (vector-prefix n v) (second n x)))) } ;

 -- Left multiplication by a generator, with its concrete pair equation.
 left-wedge (n : Nat) (v : AL.Vec n) (x : Ext n) : Ext n = emul n (gen n v) x ;
 left-wedge-value (n : Nat) (v : AL.Vec n) (x : Ext n) :
  Id (Ext n) (left-wedge n v x) (emul n (gen n v) x) = refl (left-wedge n v x) ;
 left-wedge-zero (v : AL.Vec zero) (x : Ext zero) : Id R (left-wedge zero v x) z = L.zero-mul x ;
 left-wedge-step (n : Nat) (v : AL.Vec (suc n)) (x : Ext (suc n)) :
  Id (Ext (suc n)) (left-wedge (suc n) v x)
   (left-wedge n (vector-prefix n v) (first n x),
    eadd n (left-wedge n (vector-prefix n v) (second n x)) (escale n (vector-last n v) (alpha n (first n x)))) =
  trans (ap (\ g -> emul (suc n) g x) (gen-step-def n v))
   (ExteriorAlgebra[l].pair-eq (refl (left-wedge n (vector-prefix n v) (first n x)))
    (ap (eadd n (left-wedge n (vector-prefix n v) (second n x)))
     (EA.emb-mul n (vector-last n v) (alpha n (first n x))))) ;
 opaque left-wedge ;
 contract-pair : (n : Nat) (v : AL.Vec n) (x y : Ext n) ->
  Id R (DU.dot n (contract n v x) y) (DU.dot n x (left-wedge n v y)) = split {
  zero -> \ v x y -> trans (L.zero-mul y)
   (sym (trans (ap (mul x) (left-wedge-zero v y)) (L.mul-zero x))) ;
  suc n | r -> \ v x y -> calc R {
   DU.dot (suc n) (contract (suc n) v x) y
    =< ap (\ t -> DU.dot (suc n) t y) (contract-step-def n v x)
     > DU.dot (suc n)
      (eadd n (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))),
       contract n (vector-prefix n v) (second n x)) y
    =< DU.dot-pair n
      (eadd n (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))
      (contract n (vector-prefix n v) (second n x)) y
     > add (DU.dot n (eadd n (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x)))) (first n y))
       (DU.dot n (contract n (vector-prefix n v) (second n x)) (second n y))
    =< DU.cong
      (trans (DU.dot-add-left n (contract n (vector-prefix n v) (first n x)) (escale n (vector-last n v) (alpha n (second n x))) (first n y))
       (DU.cong (r (vector-prefix n v) (first n x) (first n y))
        (trans (DU.dot-scale-left n (vector-last n v) (alpha n (second n x)) (first n y))
         (ap (mul (vector-last n v)) (DU.dot-alpha n (second n x) (first n y))))))
      (r (vector-prefix n v) (second n x) (second n y))
     > add (add (DU.dot n (first n x) (left-wedge n (vector-prefix n v) (first n y)))
        (mul (vector-last n v) (DU.dot n (second n x) (alpha n (first n y)))))
       (DU.dot n (second n x) (left-wedge n (vector-prefix n v) (second n y)))
    =< trans (sym (addA (DU.dot n (first n x) (left-wedge n (vector-prefix n v) (first n y)))
       (mul (vector-last n v) (DU.dot n (second n x) (alpha n (first n y))))
       (DU.dot n (second n x) (left-wedge n (vector-prefix n v) (second n y)))))
      (ap (add (DU.dot n (first n x) (left-wedge n (vector-prefix n v) (first n y))))
       (addC (mul (vector-last n v) (DU.dot n (second n x) (alpha n (first n y))))
        (DU.dot n (second n x) (left-wedge n (vector-prefix n v) (second n y)))))
     > add (DU.dot n (first n x) (left-wedge n (vector-prefix n v) (first n y)))
       (add (DU.dot n (second n x) (left-wedge n (vector-prefix n v) (second n y)))
        (mul (vector-last n v) (DU.dot n (second n x) (alpha n (first n y)))))
    =< ap (add (DU.dot n (first n x) (left-wedge n (vector-prefix n v) (first n y))))
      (trans (ap (add (DU.dot n (second n x) (left-wedge n (vector-prefix n v) (second n y))))
        (sym (DU.dot-scale n (vector-last n v) (second n x) (alpha n (first n y)))))
       (sym (DU.dot-add n (second n x) (left-wedge n (vector-prefix n v) (second n y)) (escale n (vector-last n v) (alpha n (first n y))))))
     > add (DU.dot n (first n x) (left-wedge n (vector-prefix n v) (first n y)))
       (DU.dot n (second n x) (eadd n (left-wedge n (vector-prefix n v) (second n y)) (escale n (vector-last n v) (alpha n (first n y)))))
    =< sym (DU.dot-pair-right n x (left-wedge n (vector-prefix n v) (first n y))
      (eadd n (left-wedge n (vector-prefix n v) (second n y)) (escale n (vector-last n v) (alpha n (first n y)))))
     > DU.dot (suc n) x (left-wedge n (vector-prefix n v) (first n y),
        eadd n (left-wedge n (vector-prefix n v) (second n y)) (escale n (vector-last n v) (alpha n (first n y))))
    =< ap (DU.dot (suc n) x) (sym (left-wedge-step n v y)) > DU.dot (suc n) x (left-wedge (suc n) v y) } } ;

 -- The scalar pairing of vectors, with the same coordinate order.
 vdot : (n : Nat) -> AL.Vec n -> AL.Vec n -> R = split {
  zero -> \ v w -> z ; suc n | r -> \ v w -> add (r (vector-prefix n v) (vector-prefix n w)) (mul (vector-last n v) (vector-last n w)) } ;
 vdot-zero-def (v w : AL.Vec zero) : Id R (vdot zero v w) z = refl z ;
 vdot-step-def (n : Nat) (v w : AL.Vec (suc n)) :
  Id R (vdot (suc n) v w)
   (add (vdot n (vector-prefix n v) (vector-prefix n w)) (mul (vector-last n v) (vector-last n w))) = refl (vdot (suc n) v w) ;
 Mixed (n : Nat) (v w : AL.Vec n) (x : Ext n) : U l =
  Id (Ext n) (eadd n (contract n v (emul n (gen n w) x)) (emul n (gen n w) (contract n v x))) (escale n (vdot n v w) x) ;
 module Cancel (n : Nat) {
  module G = EA.At[n].G ;
  neg-cancel (b : Ext n) : Id (Ext n) (eadd n (eneg n b) b) (ezero n) =
   trans (EA.eaddC n (eneg n b) b) (EA.eaddN n b) ;
  middle (a b c d : Ext n) :
   Id (Ext n) (eadd n (eadd n a (eadd n (eneg n b) c)) (eadd n d b)) (eadd n (eadd n a d) c) =
   trans (G.swap a (eadd n (eneg n b) c) d b)
    (ap (eadd n (eadd n a d))
     (trans (ap (\ x -> eadd n x b) (EA.eaddC n (eneg n b) c))
      (trans (sym (EA.eaddA n c (eneg n b) b))
       (trans (ap (eadd n c) (neg-cancel b)) (EA.eaddZ n c))))) ;
  pair (a b c d : Ext n) :
   Id (Ext n) (eadd n (eadd n a (eneg n b)) (eadd n c (eadd n b d))) (eadd n (eadd n a c) d) =
   trans (G.swap a (eneg n b) c (eadd n b d))
    (ap (eadd n (eadd n a c))
     (trans (EA.eaddA n (eneg n b) b d)
      (trans (ap (\ x -> eadd n x d) (neg-cancel b)) (G.zl d)))) ;
 } ;

 -- These component computations explicitly use the defining product.
 transparent left-wedge ;
 module MixedStep (n : Nat) (v w : AL.Vec (suc n)) (x : Ext (suc n))
  (ih0 : Mixed n (vector-prefix n v) (vector-prefix n w) (first n x))
  (ih1 : Mixed n (vector-prefix n v) (vector-prefix n w) (second n x)) {
  module G = EA.At[n].G ;
  module K = Cancel[n] ;
  y1 : Ext n = eadd n ((left-wedge n (vector-prefix n w)) (second n x)) (emul n (emb n (vector-last n w)) (alpha n (first n x))) ;
  alpha-g (y : Ext n) : Id (Ext n) (alpha n ((left-wedge n (vector-prefix n w)) y)) (eneg n ((left-wedge n (vector-prefix n w)) (alpha n y))) =
   trans (EA.alpha-mul n (gen n (vector-prefix n w)) y)
    (trans (ap (\ z1 -> emul n z1 (alpha n y)) (EA.alpha-gen n (vector-prefix n w))) (EA.mul-neg-l n (gen n (vector-prefix n w)) (alpha n y))) ;
  alpha-y1 : Id (Ext n) (alpha n y1) (eadd n (eneg n ((left-wedge n (vector-prefix n w)) (alpha n (second n x)))) (escale n (vector-last n w) (first n x))) =
   trans (ap (alpha n) (ap (eadd n ((left-wedge n (vector-prefix n w)) (second n x))) (EA.emb-mul n (vector-last n w) (alpha n (first n x)))))
    (trans (EA.alpha-add n ((left-wedge n (vector-prefix n w)) (second n x)) (escale n (vector-last n w) (alpha n (first n x))))
     (G.cong-add (alpha-g (second n x))
      (trans (EA.alpha-scale n (vector-last n w) (alpha n (first n x))) (ap (escale n (vector-last n w)) (EA.alpha-alpha n (first n x)))))) ;
  top-first : Id (Ext n) (eadd n ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (first n x))) (escale n (vector-last n v) (alpha n y1)))
   (eadd n ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (first n x))) (eadd n (eneg n (escale n (vector-last n v) ((left-wedge n (vector-prefix n w)) (alpha n (second n x))))) (escale n (mul (vector-last n v) (vector-last n w)) (first n x)))) =
   ap (eadd n ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (first n x))))
    (trans (ap (escale n (vector-last n v)) alpha-y1)
     (trans (EA.escale-add n (vector-last n v) (eneg n ((left-wedge n (vector-prefix n w)) (alpha n (second n x)))) (escale n (vector-last n w) (first n x)))
      (G.cong-add (EA.escale-neg n (vector-last n v) ((left-wedge n (vector-prefix n w)) (alpha n (second n x)))) (EA.escale-scale n (vector-last n v) (vector-last n w) (first n x))))) ;
  top-second : Id (Ext n) ((left-wedge n (vector-prefix n w)) (eadd n ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x)))))
   (eadd n ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (first n x))) (escale n (vector-last n v) ((left-wedge n (vector-prefix n w)) (alpha n (second n x))))) =
   trans (EA.dist-left n (gen n (vector-prefix n w)) ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))
    (ap (eadd n ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (first n x)))) (EA.scale-mul-right n (vector-last n v) (gen n (vector-prefix n w)) (alpha n (second n x)))) ;
  top-result : Id (Ext n)
   (eadd n (eadd n ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (first n x))) (escale n (vector-last n v) (alpha n y1))) ((left-wedge n (vector-prefix n w)) (eadd n ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))))
   (escale n (add (vdot n (vector-prefix n v) (vector-prefix n w)) (mul (vector-last n v) (vector-last n w))) (first n x)) =
   trans (G.cong-add top-first top-second)
    (trans (K.middle ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (first n x))) (escale n (vector-last n v) ((left-wedge n (vector-prefix n w)) (alpha n (second n x)))) (escale n (mul (vector-last n v) (vector-last n w)) (first n x)) ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (first n x))))
     (trans (ap (\ y -> eadd n y (escale n (mul (vector-last n v) (vector-last n w)) (first n x))) ih0)
      (sym (EA.eadd-scale n (vdot n (vector-prefix n v) (vector-prefix n w)) (mul (vector-last n v) (vector-last n w)) (first n x))))) ;
  bottom-first : Id (Ext n) ((contract n (vector-prefix n v)) y1)
   (eadd n ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (second n x))) (eneg n (escale n (vector-last n w) (alpha n ((contract n (vector-prefix n v)) (first n x)))))) =
   trans (ap (contract n (vector-prefix n v)) (ap (eadd n ((left-wedge n (vector-prefix n w)) (second n x))) (EA.emb-mul n (vector-last n w) (alpha n (first n x)))))
    (trans (contract-add n (vector-prefix n v) ((left-wedge n (vector-prefix n w)) (second n x)) (escale n (vector-last n w) (alpha n (first n x))))
     (ap (eadd n ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (second n x))))
      (trans (contract-scale n (vector-prefix n v) (vector-last n w) (alpha n (first n x)))
       (trans (ap (escale n (vector-last n w)) (contract-alpha n (vector-prefix n v) (first n x))) (EA.escale-neg n (vector-last n w) (alpha n ((contract n (vector-prefix n v)) (first n x)))))))) ;
  bottom-second : Id (Ext n)
   (eadd n ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (second n x))) (emul n (emb n (vector-last n w)) (alpha n (eadd n ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x)))))))
   (eadd n ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (second n x))) (eadd n (escale n (vector-last n w) (alpha n ((contract n (vector-prefix n v)) (first n x)))) (escale n (mul (vector-last n w) (vector-last n v)) (second n x)))) =
   ap (eadd n ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (second n x))))
    (trans (EA.emb-mul n (vector-last n w) (alpha n (eadd n ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))))
     (trans (ap (escale n (vector-last n w))
       (trans (EA.alpha-add n ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))
        (ap (eadd n (alpha n ((contract n (vector-prefix n v)) (first n x))))
         (trans (EA.alpha-scale n (vector-last n v) (alpha n (second n x))) (ap (escale n (vector-last n v)) (EA.alpha-alpha n (second n x)))))))
      (trans (EA.escale-add n (vector-last n w) (alpha n ((contract n (vector-prefix n v)) (first n x))) (escale n (vector-last n v) (second n x)))
       (ap (eadd n (escale n (vector-last n w) (alpha n ((contract n (vector-prefix n v)) (first n x))))) (EA.escale-scale n (vector-last n w) (vector-last n v) (second n x)))))) ;
  bottom-result : Id (Ext n)
   (eadd n ((contract n (vector-prefix n v)) y1) (eadd n ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (second n x))) (emul n (emb n (vector-last n w)) (alpha n (eadd n ((contract n (vector-prefix n v)) (first n x)) (escale n (vector-last n v) (alpha n (second n x))))))))
   (escale n (add (vdot n (vector-prefix n v) (vector-prefix n w)) (mul (vector-last n v) (vector-last n w))) (second n x)) =
   trans (G.cong-add bottom-first bottom-second)
    (trans (K.pair ((contract n (vector-prefix n v)) ((left-wedge n (vector-prefix n w)) (second n x))) (escale n (vector-last n w) (alpha n ((contract n (vector-prefix n v)) (first n x)))) ((left-wedge n (vector-prefix n w)) ((contract n (vector-prefix n v)) (second n x))) (escale n (mul (vector-last n w) (vector-last n v)) (second n x)))
     (trans (G.cong-add ih1 (ap (\ c -> escale n c (second n x)) (mulC (vector-last n w) (vector-last n v))))
      (sym (EA.eadd-scale n (vdot n (vector-prefix n v) (vector-prefix n w)) (mul (vector-last n v) (vector-last n w)) (second n x))))) ;
  result : Mixed (suc n) v w x =
   trans (ap (\ g1 -> eadd (suc n) (contract (suc n) v (emul (suc n) g1 x)) (emul (suc n) g1 (contract (suc n) v x))) (gen-step-def n w))
    (ExteriorAlgebra[l].pair-eq top-result bottom-result) ;
 } ;
 mixed : (n : Nat) (v w : AL.Vec n) (x : Ext n) -> Mixed n v w x = split {
  zero -> \ v w x -> trans (ap (add z) (L.zero-mul z)) (trans (addZ z) (sym (L.zero-mul x))) ;
  suc n | r -> \ v w x -> MixedStep[n,v,w,x,r (vector-prefix n v) (vector-prefix n w) (first n x),r (vector-prefix n v) (vector-prefix n w) (second n x)].result } ;

 opaque left-wedge ;
 module EC = ExteriorContr[l].Over[Rg,setR] ;
 right-commute (n : Nat) (w : AL.Vec n) (x : Ext n) :
  Id (Ext n) (emul n (gen n w) (alpha n x)) (emul n x (gen n w)) =
  trans (EC.gen-commute n w (alpha n x))
   (ap (\ y -> emul n y (gen n w)) (EA.alpha-alpha n x)) ;
 solve-sub (n : Nat) (a b c : Ext n)
  (h : Id (Ext n) (eadd n a (eneg n b)) c) : Id (Ext n) a (eadd n b c) =
  trans (sym (EA.eaddZ n a))
   (trans (ap (eadd n a) (sym (Cancel[n].neg-cancel b)))
    (trans (EA.eaddA n a (eneg n b) b)
     (trans (ap (\ y -> eadd n y b) h) (EA.eaddC n c b)))) ;
 contract-right (n : Nat) (v w : AL.Vec n) (x : Ext n) :
  Id (Ext n) (contract n v (emul n x (gen n w)))
   (eadd n (emul n (contract n v x) (gen n w)) (escale n (vdot n v w) (alpha n x))) =
  solve-sub n (contract n v (emul n x (gen n w))) (emul n (contract n v x) (gen n w))
   (escale n (vdot n v w) (alpha n x))
   (trans (sym (EA.At[n].G.cong-add
      (ap (contract n v) (right-commute n w x))
      (trans (ap (emul n (gen n w)) (contract-alpha n v x))
       (trans (EA.mul-neg-r n (gen n w) (alpha n (contract n v x)))
        (ap (eneg n) (right-commute n w (contract n v x)))))))
    (mixed n v w (alpha n x))) ;
 opaque contract ; opaque vdot ;
 opaque first ; opaque second ;
} ;
