-- Determinants (DESIGN.md §5, step 3).  A matrix is given by its columns,
-- M k : R^n, and  det M = top (i(M 1) ... i(M n))  (ExteriorModel.seg).
-- A matrix A acts on R^n,  (A v)_i = sum_j v_j A_ji ,  and by the universal
-- property gives the algebra map  phi_A : L n -> L n  with  phi_A (i v) = i (A v) .
-- Since products of n generators lie in the free top degree,
--   i(A b_1) ... i(A b_n) = phi_A (i(b_1) ... i(b_n)) = det B . phi_A (omega)
--                         = det B . i(a_1) ... i(a_n) ,
-- so det (A B) = det A . det B; and det I = 1 since i(e_1) ... i(e_n) = omega.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module UP = ExteriorUniversal[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;
 Lam (n : Nat) : AlgSIP[l].Over[Rg,setR].Alg = UP.Lam n ;

 ---------------------------------------------------------------------
 -- matrices, by columns

 Mat (n : Nat) : U l = Ps.Fin n -> AL.Vec n ;
 act (n : Nat) (A : Mat n) (v : AL.Vec n) : AL.Vec n = \ i -> S.sum n (\ j -> mul (v j) (A j i)) ;
 mmul (n : Nat) (A B : Mat n) : Mat n = \ k -> act n A (B k) ;
 idm (n : Nat) : Mat n = \ k -> D.delta n k ;

 act-add (n : Nat) (A : Mat n) (a b : AL.Vec n) (i : Ps.Fin n) :
  Id R (act n A (AL.vadd n a b) i) (AL.vadd n (act n A a) (act n A b) i) =
  trans (S.sum-cong n (\ j -> mul (add (a j) (b j)) (A j i)) (\ j -> add (mul (a j) (A j i)) (mul (b j) (A j i)))
          (\ j -> L.dist-left (a j) (b j) (A j i)))
   (S.sum-add n (\ j -> mul (a j) (A j i)) (\ j -> mul (b j) (A j i))) ;
 act-scale (n : Nat) (A : Mat n) (c : R) (a : AL.Vec n) (i : Ps.Fin n) :
  Id R (act n A (AL.vscale n c a) i) (AL.vscale n c (act n A a) i) =
  trans (S.sum-cong n (\ j -> mul (mul c (a j)) (A j i)) (\ j -> mul c (mul (a j) (A j i)))
          (\ j -> sym (mulA c (a j) (A j i))))
   (S.sum-scale c n (\ j -> mul (a j) (A j i))) ;
 -- A e_k = A k
 act-delta (n : Nat) (A : Mat n) (k i : Ps.Fin n) : Id R (act n A (D.delta n k) i) (A k i) =
  D.sum-delta n k (\ j -> A j i) ;

 -- the algebra map of A
 module Map (n : Nat) (A : Mat n) {
  alt : AL.In[Lam n].Alt n =
   (\ v -> gen n (act n A v),
    ((\ a b -> trans (ap (gen n) (F.funext (Ps.Fin n) (\ i -> R) (act n A (AL.vadd n a b))
                                    (AL.vadd n (act n A a) (act n A b)) (act-add n A a b)))
                (EA.gen-add n (act n A a) (act n A b)),
      \ c a -> trans (ap (gen n) (F.funext (Ps.Fin n) (\ i -> R) (act n A (AL.vscale n c a))
                                    (AL.vscale n c (act n A a)) (act-scale n A c a)))
                (EA.gen-scale n c (act n A a))),
     \ v -> EA.gen-sq n (act n A v))) ;
  phi : AL.AlgHom (Lam n) (Lam n) = UP.In[Lam n].ext n alt ;
  phi-gen (v : AL.Vec n) : Id (Ext n) (phi.1 (gen n v)) (gen n (act n A v)) = (UP.In[Lam n].extend n alt).2.1 v ;
 } ;

 ---------------------------------------------------------------------
 -- products of generators

 emul-cong (n : Nat) {x x' y y' : Ext n} (p : Id (Ext n) x x') (q : Id (Ext n) y y') :
  Id (Ext n) (emul n x y) (emul n x' y') = trans (ap (\ t -> emul n t y) p) (ap (emul n x') q) ;
 eprod-cong (n : Nat) : (m : Nat) (u v : Ps.Fin m -> Ext n) -> ((k : Ps.Fin m) -> Id (Ext n) (u k) (v k)) ->
  Id (Ext n) (eprod n m u) (eprod n m v) = split {
  zero -> \ u v h -> refl (eone n) ;
  suc m | r -> \ u v h -> emul-cong n (r (\ k -> u (inl k)) (\ k -> v (inl k)) (\ k -> h (inl k))) (h (inr tt)) } ;
 -- algebra maps preserve the products
 hom-eprod (n n' : Nat) (f : AL.AlgHom (Lam n) (Lam n')) : (m : Nat) (u : Ps.Fin m -> Ext n) ->
  Id (Ext n') (f.1 (eprod n m u)) (eprod n' m (\ k -> f.1 (u k))) = split {
  zero -> \ u -> f.2.2.2.2 ;
  suc m | r -> \ u -> trans (f.2.2.2.1 (eprod n m (\ k -> u (inl k))) (u (inr tt)))
   (ap (\ t -> emul n' t (f.1 (u (inr tt)))) (r (\ k -> u (inl k)))) } ;

 -- i(e_1) ... i(e_n) = omega
 std (n : Nat) : Ext n = eprod n n (\ k -> gen n (D.delta n k)) ;
 std-omega : (n : Nat) -> Id (Ext n) (std n) (DG.omega n) = split {
  zero -> refl o ;
  suc n | r ->
   trans (emul-cong (suc n)
           (trans (eprod-cong (suc n) n (\ k -> gen (suc n) (D.delta (suc n) (inl k)))
                    (\ k -> UP.iota n (gen n (D.delta n k))) (\ k -> sym (UP.iota-gen n (D.delta n k))))
            (trans (sym (hom-eprod n (suc n) (UP.iota-hom n) n (\ k -> gen n (D.delta n k))))
                   (ap (UP.iota n) r)))
           (UP.E-gen n))
    (DG.pair-eq (EA.mul-zero-r n (DG.omega n))
     (trans (EA.At[n].G.cong-add (EA.one-right n (DG.omega n)) (EA.mul-zero-l n (alpha n (ezero n))))
            (EA.eaddZ n (DG.omega n)))) } ;

 ---------------------------------------------------------------------
 -- the theorems

 det-id (n : Nat) : Id R (det n (idm n)) o = trans (ap (top n) (std-omega n)) (DG.top-omega n) ;

 -- the top degree is free:  i(u 1) ... i(u n) = det u . omega
 free (n : Nat) (u : Mat n) : Id (Ext n) (eprod n n (\ k -> gen n (u k))) (escale n (det n u) (DG.omega n)) =
  DG.deg-top n (eprod n n (\ k -> gen n (u k))) (DG.deg-eprod n n (\ k -> gen n (u k)) (\ k -> DG.deg-gen n (u k))) ;

 module Product (n : Nat) (A B : Mat n) {
  phi : AL.AlgHom (Lam n) (Lam n) = Map[n,A].phi ;
  -- phi (omega) = i(A 1) ... i(A n)
  phi-omega : Id (Ext n) (phi.1 (DG.omega n)) (eprod n n (\ k -> gen n (A k))) =
   trans (ap phi.1 (sym (std-omega n)))
    (trans (hom-eprod n n phi n (\ k -> gen n (D.delta n k)))
     (eprod-cong n n (\ k -> phi.1 (gen n (D.delta n k))) (\ k -> gen n (A k))
       (\ k -> trans (Map[n,A].phi-gen (D.delta n k))
                (ap (gen n) (F.funext (Ps.Fin n) (\ i -> R) (act n A (D.delta n k)) (A k) (act-delta n A k)))))) ;
  prod-eq : Id (Ext n) (eprod n n (\ k -> gen n (mmul n A B k))) (escale n (det n B) (eprod n n (\ k -> gen n (A k)))) =
   trans (eprod-cong n n (\ k -> gen n (mmul n A B k)) (\ k -> phi.1 (gen n (B k))) (\ k -> sym (Map[n,A].phi-gen (B k))))
    (trans (sym (hom-eprod n n phi n (\ k -> gen n (B k))))
     (trans (ap phi.1 (free n B))
      (trans (phi.2.2.1 (det n B) (DG.omega n))
             (ap (escale n (det n B)) phi-omega)))) ;
  det-mul : Id R (det n (mmul n A B)) (mul (det n A) (det n B)) =
   trans (ap (top n) prod-eq)
    (trans (DG.top-scale n (det n B) (eprod n n (\ k -> gen n (A k)))) (mulC (det n B) (det n A))) ;
 } ;
 det-mul (n : Nat) (A B : Mat n) : Id R (det n (mmul n A B)) (mul (det n A) (det n B)) = Product[n,A,B].det-mul ;
} ;
