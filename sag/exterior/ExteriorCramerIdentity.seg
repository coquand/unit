-- Informal proof (PCC2 Proposition 6 and its all-subset Cramer expansion).
-- Work in the full exterior algebra with its coordinate pairing dot.
-- The existing adjugate satisfies Adj(A) phi_A=det(A) id. For the other
-- composition identity, test phi_A(Adj(A)x) against an arbitrary y.
-- Transposition of phi and of Adj moves them across dot in this order:
--   dot(phi_A(Adj(A)x),y)
--     = dot(Adj(A)x,phi_(A^t)y)
--     = dot(x,Adj(A^t)(phi_(A^t)y))
--     = dot(x,det(A^t)y) = dot(det(A)x,y).
-- The last step uses det-transpose and the two scalar laws for dot.
-- Nondegeneracy gives map-adj. No determinant is cancelled.
--
-- adj-linear packages the already proved additive and scalar laws.
-- Apply coordinate map-expansion to Adj to get adj-expansion. Apply
-- that expansion to phi_A(x) and use the first composition identity to
-- get cramer-source, the expansion of det(A)x in the adjugate images of
-- the subset basis. Its coefficient is the corresponding coordinate
-- of phi_A(x).
--
-- For the complementary coefficient formula adj-coeff, pairing with a
-- subset basis vector b_i extracts the i-th coordinate. The signed
-- complement star is an isometry, so
--   coeff_i(Adj(A)x) = dot(Adj(A)x,b_i)
--     = dot(star(Adj(A)x),star(b_i))
--     = top(Adj(A)x * star(b_i))
--     = top(x * phi_A(star(b_i))).
-- The third equality is star-pair and the last is the defining
-- characterisation of Adj. The displayed common point explicitly
-- identifies the value of the existing form by its definition.
-- adj-degree now proves that Adj preserves homogeneous degree p. At
-- every subset whose size differs from p, adj-coeff expresses its
-- coordinate as the corresponding Cramer coefficient. The homogeneous
-- vanishing theorem cramer-coeff-zero makes that coefficient zero.
-- support-degree turns this coordinate support into a degree-p proof;
-- the definition of Support supplies the index and inequality arguments.
--
-- cramer-target applies coordinate map-expansion to phi_A at Adj(A)x
-- and uses map-adj. Finally cramer substitutes adj-coeff term by term.
-- Thus for every x in the full exterior algebra,
--   det(A)x = sum_i top(x * phi_A(star(b_i))) phi_A(b_i).
-- The sum is over all subsets. Restricting it to subsets of a fixed
-- size uses the homogeneous support lemmas in the later application;
-- no degree or support claim is silently used in this identity.
--
-- complementary-minor is the signed complementary-minor formula of
-- PCC2 Lemma 5. Put x=b_j in adj-coeff. Since star(b_i)=epsilon_i b_(i^c),
-- linearity of phi, multiplication and top move epsilon_i outside.
-- The remaining top product is dot(star(b_j),phi_A(b_(i^c))). Apply
-- star-basis again and move epsilon_j outside dot. Symmetry and
-- dot-basis identify what remains as the j^c coordinate of
-- phi_A(b_(i^c)). Reassociation gives the product of the two signs.
-- This proof uses the signed complements already defined and proved
-- in ExteriorHomogeneous, without computing a sign or a minor.
--
-- These arguments use the existing named laws only. adj-coeff opens
-- the existing form to identify its displayed value; adj-linear opens
-- the proposition LinearMap to supply its two laws; cramer-target supplies
-- the corresponding two existing linear laws of phi_A in the same way.
-- Matrix and vector
-- carriers and the subset index are representation encodings, so the
-- unfolding audit reports their decoding separately.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module C = ExteriorCoordinates[l] ;
module H = ExteriorHomogeneous[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module AD = ExteriorAdjugate[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 module At (n : Nat) (A : DT.Mat n) {
  module M = DT.Map[n,A] ;
  module J = AD.At[n,A] ;
  map-adj (x : Ext n) : Id (Ext n) (M.value (J.adj x)) (escale n (det n A) x) =
   DU.dot-inj n (M.value (J.adj x)) (escale n (det n A) x) (\ y ->
    calc R { DU.dot n (M.value (J.adj x)) y
     =< TP.transpose-pair n A (J.adj x) y > DU.dot n (J.adj x) (DT.Map[n,TP.transpose n A].value y)
     =< TP.adj-transpose-pair n A x (DT.Map[n,TP.transpose n A].value y)
      > DU.dot n x (AD.At[n,TP.transpose n A].adj (DT.Map[n,TP.transpose n A].value y))
     =< ap (DU.dot n x) (AD.At[n,TP.transpose n A].adj-map y) > DU.dot n x (escale n (det n (TP.transpose n A)) y)
     =< DU.dot-scale n (det n (TP.transpose n A)) x y > mul (det n (TP.transpose n A)) (DU.dot n x y)
     =< ap (\ a -> mul a (DU.dot n x y)) (sym (TP.det-transpose n A)) > mul (det n A) (DU.dot n x y)
     =< sym (DU.dot-scale-left n (det n A) x y) > DU.dot n (escale n (det n A) x) y }) ;

  adj-linear : CO.LinearMap n n J.adj = (J.adj-add,J.adj-scale) ;
  adj-expansion (x : Ext n) :
   Id (Ext n) (J.adj x) (CO.ES[n].SumE.sum n (\ i -> escale n (CO.coeff n x i) (J.adj (CO.basis n i)))) =
   CO.map-expansion n n J.adj adj-linear x ;
  cramer-source (x : Ext n) :
   Id (Ext n) (escale n (det n A) x)
    (CO.ES[n].SumE.sum n (\ i -> escale n (CO.coeff n (M.value x) i) (J.adj (CO.basis n i)))) =
   trans (sym (J.adj-map x)) (adj-expansion (M.value x)) ;

  adj-coeff (x : Ext n) (i : C.Index n) :
   Id R (CO.coeff n (J.adj x) i) (top n (emul n x (M.value (DU.star n (CO.basis n i))))) =
   calc R { CO.coeff n (J.adj x) i
    =< sym (CO.dot-basis n (J.adj x) i) > DU.dot n (J.adj x) (CO.basis n i)
    =< sym (TP.star-isometry n (J.adj x) (CO.basis n i)) > DU.dot n (DU.star n (J.adj x)) (DU.star n (CO.basis n i))
    =< DU.star-pair n (J.adj x) (DU.star n (CO.basis n i)) > top n (emul n (J.adj x) (DU.star n (CO.basis n i)))
    =< J.characterise x (DU.star n (CO.basis n i)) > top n (emul n x (M.value (DU.star n (CO.basis n i)))) } ;

  adj-degree (p : Nat) (x : Ext n) (dx : DG.Deg n p x) : DG.Deg n p (J.adj x) =
   HO.support-degree n p (J.adj x) (\ i ne -> trans (adj-coeff x i) (HO.cramer-coeff-zero n A p x dx i ne)) ;

  cramer-target (x : Ext n) :
   Id (Ext n) (escale n (det n A) x)
    (CO.ES[n].SumE.sum n (\ i -> escale n (CO.coeff n (J.adj x) i) (M.value (CO.basis n i)))) =
   trans (sym (map-adj x)) (CO.map-expansion n n M.value (M.value-add,M.value-scale) (J.adj x)) ;
  cramer (x : Ext n) :
   Id (Ext n) (escale n (det n A) x)
    (CO.ES[n].SumE.sum n (\ i -> escale n (top n (emul n x (M.value (DU.star n (CO.basis n i))))) (M.value (CO.basis n i)))) =
   trans (cramer-target x)
    (CO.ES[n].SumE.cong n _ _ (\ i -> ap (\ a -> escale n a (M.value (CO.basis n i))) (adj-coeff x i))) ;

  complementary-minor (i j : C.Index n) :
   Id R (CO.coeff n (J.adj (CO.basis n j)) i)
    (mul (mul (HO.epsilon n i) (HO.epsilon n j))
     (CO.coeff n (M.value (CO.basis n (H.complement n i))) (H.complement n j))) =
   calc R { CO.coeff n (J.adj (CO.basis n j)) i
    =< adj-coeff (CO.basis n j) i > top n (emul n (CO.basis n j) (M.value (DU.star n (CO.basis n i))))
    =< ap (\ w -> top n (emul n (CO.basis n j) w))
      (trans (ap M.value (HO.star-basis n i)) (M.value-scale (HO.epsilon n i) (CO.basis n (H.complement n i))))
     > top n (emul n (CO.basis n j) (escale n (HO.epsilon n i) (M.value (CO.basis n (H.complement n i)))))
    =< ap (top n) (EA.scale-mul-right n (HO.epsilon n i) (CO.basis n j) (M.value (CO.basis n (H.complement n i))))
     > top n (escale n (HO.epsilon n i) (emul n (CO.basis n j) (M.value (CO.basis n (H.complement n i)))))
    =< DG.top-scale n (HO.epsilon n i) (emul n (CO.basis n j) (M.value (CO.basis n (H.complement n i))))
     > mul (HO.epsilon n i) (top n (emul n (CO.basis n j) (M.value (CO.basis n (H.complement n i)))))
    =< ap (mul (HO.epsilon n i)) (sym (DU.star-pair n (CO.basis n j) (M.value (CO.basis n (H.complement n i)))))
     > mul (HO.epsilon n i) (DU.dot n (DU.star n (CO.basis n j)) (M.value (CO.basis n (H.complement n i))))
    =< ap (\ w -> mul (HO.epsilon n i) (DU.dot n w (M.value (CO.basis n (H.complement n i))))) (HO.star-basis n j)
     > mul (HO.epsilon n i) (DU.dot n (escale n (HO.epsilon n j) (CO.basis n (H.complement n j))) (M.value (CO.basis n (H.complement n i))))
    =< ap (mul (HO.epsilon n i)) (DU.dot-scale-left n (HO.epsilon n j) (CO.basis n (H.complement n j)) (M.value (CO.basis n (H.complement n i))))
     > mul (HO.epsilon n i) (mul (HO.epsilon n j) (DU.dot n (CO.basis n (H.complement n j)) (M.value (CO.basis n (H.complement n i)))))
    =< ap (\ a -> mul (HO.epsilon n i) (mul (HO.epsilon n j) a))
      (trans (DU.dot-sym n (CO.basis n (H.complement n j)) (M.value (CO.basis n (H.complement n i))))
       (CO.dot-basis n (M.value (CO.basis n (H.complement n i))) (H.complement n j)))
     > mul (HO.epsilon n i) (mul (HO.epsilon n j) (CO.coeff n (M.value (CO.basis n (H.complement n i))) (H.complement n j)))
    =< mulA (HO.epsilon n i) (HO.epsilon n j) (CO.coeff n (M.value (CO.basis n (H.complement n i))) (H.complement n j))
     > mul (mul (HO.epsilon n i) (HO.epsilon n j)) (CO.coeff n (M.value (CO.basis n (H.complement n i))) (H.complement n j)) } ;
 } ;
} ;
