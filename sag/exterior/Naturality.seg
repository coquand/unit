-- Naturality of det in the ring (DESIGN.md §5, step 5): for a ring map
-- phi : R -> S,  det (phi A) = phi (det A).  The graph of phi, at every
-- degree, is a relation as in ExteriorRelation.seg.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ;
module Over (Rg Sg : CRing) (phi : H.Hom Rg Sg) {
 Graph (k : Nat) (a : Rg.R) (b : Sg.R) : U l = Id Sg.R (phi.1 a) b ;
 module G = ExteriorRelation[l].Over[Rg,Sg,Graph,
  \ k -> H.zero Rg Sg phi,
  \ k a a' b b' h h' -> trans (phi.2.2.1 a a') (Ps.cong2 Sg.R Sg.add _ _ _ _ h h'),
  \ k a b h -> trans (H.negation Rg Sg phi a) (ap Sg.neg h),
  phi.2.1,
  \ k a a' b b' h h' -> trans (phi.2.2.2 a a') (Ps.cong2 Sg.R Sg.mul _ _ _ _ h h')] ;
 det-nat (n : Nat) (M : Ps.Fin n -> Ps.Fin n -> Rg.R) :
  Id Sg.R (phi.1 (G.ER.det n M)) (G.ES.det n (\ j i -> phi.1 (M j i))) =
  G.det n M (\ j i -> phi.1 (M j i)) (\ j i -> refl (phi.1 (M j i))) ;
} ;
