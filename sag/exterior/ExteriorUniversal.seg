-- The universal property of the model (DESIGN.md §4): for every R-algebra
-- A, precomposition with the generators
--   precomp : AlgHom (L n) A -> Alt n A ,   f |-> f . i
-- is an equivalence.  By induction on n.  With e the last basis vector,
-- an element of L (n+1) is w0 + w1 e with w0, w1 in L n, so for j alternating
-- the extension is  g (w0, w1) = g'(w0) + g'(w1) j(e) ,  g' the extension of
-- the restriction of j.  The induction carries the graded commutation
--   eps g(x) = g(alpha x) eps   whenever eps anticommutes with every j(v),
-- which gives multiplicativity at the next level (eps = j(e)).
-- Uniqueness: an algebra map out of L (n+1) is determined by its
-- restriction to L n and its value at e. The inclusion iota has its
-- preservation laws named at its construction; iota-eprod follows by
-- induction on the ordered product, using iota-one and iota-mul.
-- ext-precomp-value first proves the pointwise inverse equation by
-- uniqueness; ext-precomp assembles it into the equality of bundled maps.
-- The grade involution is an algebra map. An algebra map whose generator
-- images are odd commutes with that involution: compare its composites
-- with alpha by uniqueness, using preservation of negation on generators.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module S = AlgSIP[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;
 Lam (n : Nat) : S.Alg = EA.algebra n ;
 alpha-hom (n : Nat) : AL.AlgHom (Lam n) (Lam n) =
  (alpha n,(EA.alpha-add n,EA.alpha-scale n,EA.alpha-mul n,EA.alpha-emb n o)) ;

 ---------------------------------------------------------------------
 -- vectors: extension by 0, the last basis vector

 ext0 (n : Nat) (a : AL.Vec n) : AL.Vec (suc n) = split { inl k -> a k ; inr t -> z } ;
 last (n : Nat) : AL.Vec (suc n) = split { inl k -> z ; inr t -> o } ;
 ext0-add (n : Nat) (a b : AL.Vec n) : (k : Ps.Fin (suc n)) ->
  Id R (ext0 n (AL.vadd n a b) k) (AL.vadd (suc n) (ext0 n a) (ext0 n b) k) = split {
  inl k -> refl (add (a k) (b k)) ; inr t -> sym (addZ z) } ;
 ext0-scale (n : Nat) (c : R) (a : AL.Vec n) : (k : Ps.Fin (suc n)) ->
  Id R (ext0 n (AL.vscale n c a) k) (AL.vscale (suc n) c (ext0 n a) k) = split {
  inl k -> refl (mul c (a k)) ; inr t -> sym (L.mul-zero c) } ;
 last-coord (n : Nat) (a : AL.Vec (suc n)) : (t : Top) -> Id R (add z (mul (a (inr tt)) o)) (a (inr t)) = split {
  tt -> trans (L.zl (mul (a (inr tt)) o)) (mulO (a (inr tt))) } ;
 -- a = ext0 a' + c . last  with  a' = a . inl ,  c = a (inr tt)
 split-vec (n : Nat) (a : AL.Vec (suc n)) : (k : Ps.Fin (suc n)) ->
  Id R (AL.vadd (suc n) (ext0 n (\ k1 -> a (inl k1))) (AL.vscale (suc n) (a (inr tt)) (last n)) k) (a k) = split {
  inl k -> trans (ap (add (a (inl k))) (L.mul-zero (a (inr tt)))) (addZ (a (inl k))) ;
  inr t -> last-coord n a t } ;
 vec0-pt (a b : AL.Vec zero) : (k : Ps.Fin zero) -> Id R (a k) (b k) = split { } ;
 vec0 (a b : AL.Vec zero) : Id (AL.Vec zero) a b = F.funext (Ps.Fin zero) (\ k -> R) a b (vec0-pt a b) ;

 ---------------------------------------------------------------------
 -- the model: 0, e and the inclusion L n -> L (n+1)

 emb-zero : (n : Nat) -> Id (Ext n) (emb n z) (ezero n) = split {
  zero -> refl z ;
  suc n | r -> ExteriorAlgebra[l].pair-eq r (refl (ezero n)) } ;
 gen-zero : (n : Nat) -> Id (Ext n) (gen n (\ k -> z)) (ezero n) = split {
  zero -> refl z ;
  suc n | r -> ExteriorAlgebra[l].pair-eq r (emb-zero n) } ;
 E (n : Nat) : Ext (suc n) = (ezero n,eone n) ;
 E-gen (n : Nat) : Id (Ext (suc n)) (gen (suc n) (last n)) (E n) =
  ExteriorAlgebra[l].pair-eq (gen-zero n) (refl (eone n)) ;
 iota (n : Nat) (x : Ext n) : Ext (suc n) = (x,ezero n) ;
 -- Name the components of this homomorphism at its construction. Later
 -- computations on Ext use these laws without decoding the bundled map.
 iota-add (n : Nat) (x y : Ext n) :
  Id (Ext (suc n)) (iota n (eadd n x y)) (eadd (suc n) (iota n x) (iota n y)) =
  ExteriorAlgebra[l].pair-eq (refl (eadd n x y)) (sym (EA.eaddZ n (ezero n))) ;
 iota-scale (n : Nat) (c : R) (x : Ext n) :
  Id (Ext (suc n)) (iota n (escale n c x)) (escale (suc n) c (iota n x)) =
  ExteriorAlgebra[l].pair-eq (refl (escale n c x)) (sym (EA.escale-zero n c)) ;
 iota-mul (n : Nat) (x y : Ext n) :
  Id (Ext (suc n)) (iota n (emul n x y)) (emul (suc n) (iota n x) (iota n y)) =
  ExteriorAlgebra[l].pair-eq (refl (emul n x y))
   (sym (trans (EA.At[n].G.cong-add (EA.mul-zero-r n x) (EA.mul-zero-l n (alpha n y))) (EA.eaddZ n (ezero n)))) ;
 iota-one (n : Nat) : Id (Ext (suc n)) (iota n (eone n)) (eone (suc n)) = refl (eone (suc n)) ;
 iota-hom (n : Nat) : AL.AlgHom (Lam n) (Lam (suc n)) =
  (iota n,(iota-add n,iota-scale n,iota-mul n,iota-one n)) ;
 iota-gen (n : Nat) (a : AL.Vec n) : Id (Ext (suc n)) (iota n (gen n a)) (gen (suc n) (ext0 n a)) =
  ExteriorAlgebra[l].pair-eq (refl (gen n a)) (sym (emb-zero n)) ;
 iota-eprod (n : Nat) : (m : Nat) (u : Ps.Fin m -> Ext n) ->
  Id (Ext (suc n)) (iota n (eprod n m u)) (eprod (suc n) m (\ k -> iota n (u k))) = split {
  zero -> \ u -> iota-one n ;
  suc m | r -> \ u -> trans (iota-mul n (eprod n m (\ k -> u (inl k))) (u (inr tt)))
   (ap (\ t -> emul (suc n) t (iota n (u (inr tt)))) (r (\ k -> u (inl k)))) } ;
 -- (x0, x1) = iota x0 + iota x1 . e
 decomp (n : Nat) (x : Ext (suc n)) :
  Id (Ext (suc n)) x (eadd (suc n) (iota n x.1) (emul (suc n) (iota n x.2) (E n))) =
  ExteriorAlgebra[l].pair-eq
   (sym (trans (ap (eadd n x.1) (EA.mul-zero-r n x.2)) (EA.eaddZ n x.1)))
   (sym (trans (EA.At[n].G.zl (eadd n (emul n x.2 (eone n)) (emul n (ezero n) (alpha n (ezero n)))))
         (trans (EA.At[n].G.cong-add (EA.one-right n x.2) (EA.mul-zero-l n (alpha n (ezero n))))
                (EA.eaddZ n x.2)))) ;

 module In (A : S.Alg) {
  module X = AL.In[A] ;
  module G = X.G ;
  Hom (n : Nat) : U l = AL.AlgHom (Lam n) A ;
  cong-mul {x x' y y' : A.A} (p : Id A.A x x') (q : Id A.A y y') : Id A.A (A.mul x y) (A.mul x' y') =
   trans (ap (\ t -> A.mul t y) p) (ap (A.mul x') q) ;
  -- u + v = v + (u + 0)
  rot (u v : A.A) : Id A.A (A.add u v) (A.add v (A.add u A.zero)) =
   trans (A.addC u v) (ap (A.add v) (sym (A.addZ u))) ;

  -- precomposition with the generators
  precomp (n : Nat) (f : Hom n) : X.Alt n =
   (\ a -> f.1 (gen n a),
    ((\ a b -> trans (ap f.1 (EA.gen-add n a b)) (f.2.1 (gen n a) (gen n b)),
      \ c a -> trans (ap f.1 (EA.gen-scale n c a)) (f.2.2.1 c (gen n a))),
     \ a -> trans (sym (f.2.2.2.1 (gen n a) (gen n a)))
             (trans (ap f.1 (EA.gen-sq n a)) X.H[Lam n,f].zero))) ;

  -- the restriction of j : Alt (n+1) to the first n coordinates
  restrict (n : Nat) (j : X.Alt (suc n)) : X.Alt n =
   (\ a -> j.1 (ext0 n a),
    ((\ a b -> trans (ap j.1 (F.funext (Ps.Fin (suc n)) (\ k -> R) (ext0 n (AL.vadd n a b))
                                (AL.vadd (suc n) (ext0 n a) (ext0 n b)) (ext0-add n a b)))
                (j.2.1.1 (ext0 n a) (ext0 n b)),
      \ c a -> trans (ap j.1 (F.funext (Ps.Fin (suc n)) (\ k -> R) (ext0 n (AL.vscale n c a))
                                (AL.vscale (suc n) c (ext0 n a)) (ext0-scale n c a)))
                (j.2.1.2 c (ext0 n a))),
     \ a -> j.2.2 (ext0 n a))) ;

  -- what the induction constructs: an extension, with graded commutation
  Anti (n : Nat) (j : X.Alt n) (eps : A.A) : U l =
   (v : AL.Vec n) -> Id A.A (A.mul eps (j.1 v)) (A.neg (A.mul (j.1 v) eps)) ;
  Graded (n : Nat) (j : X.Alt n) (g : Hom n) : U l =
   (eps : A.A) -> Anti n j eps -> (x : Ext n) -> Id A.A (A.mul eps (g.1 x)) (A.mul (g.1 (alpha n x)) eps) ;
  Extension (n : Nat) (j : X.Alt n) : U l =
   (g : Hom n) * ((a : AL.Vec n) -> Id A.A (g.1 (gen n a)) (j.1 a)) * Graded n j g ;

  -- n = 0:  g c = c . 1
  base (j : X.Alt zero) : Extension zero j =
   ((\ c -> A.scale c A.one,
     (\ c d -> A.add-scale c d A.one,
      \ c d -> sym (A.scale-scale c d A.one),
      \ c d -> sym (trans (A.scale-mul-left c A.one (A.scale d A.one))
                    (trans (ap (A.scale c) (A.one-left (A.scale d A.one))) (A.scale-scale c d A.one))),
      A.scale-one A.one)),
    \ a -> trans (X.scale-zero-l A.one)
            (sym (G.add-cancel (j.1 a) (j.1 a)
                   (trans (sym (j.2.1.1 a a)) (ap j.1 (vec0 (AL.vadd zero a a) a))))),
    \ eps h c -> trans (trans (A.scale-mul-right c eps A.one) (ap (A.scale c) (A.one-right eps)))
                  (sym (trans (A.scale-mul-left c A.one eps) (ap (A.scale c) (A.one-left eps))))) ;

  -- n + 1, from the extension of the restriction
  module Step (n : Nat) (j : X.Alt (suc n)) (ih : Extension n (restrict n j)) {
   e : A.A = j.1 (last n) ;
   f (x : Ext n) : A.A = (ih.1).1 x ;
   hf : S.Hom (Lam n) A f = (ih.1).2 ;
   f-zero : Id A.A (f (ezero n)) A.zero = X.H[Lam n,ih.1].zero ;
   f-neg (x : Ext n) : Id A.A (f (eneg n x)) (A.neg (f x)) = X.H[Lam n,ih.1].neg x ;
   e-anti : Anti n (restrict n j) e = \ v -> X.anti (suc n) j (last n) (ext0 n v) ;
   e-sq : Id A.A (A.mul e e) A.zero = j.2.2 (last n) ;
   -- e f(x) = f(alpha x) e
   com (x : Ext n) : Id A.A (A.mul e (f x)) (A.mul (f (alpha n x)) e) = ih.2.2 e e-anti x ;

   g (x : Ext (suc n)) : A.A = A.add (f x.1) (A.mul (f x.2) e) ;

   g-add (x y : Ext (suc n)) : Id A.A (g (eadd (suc n) x y)) (A.add (g x) (g y)) =
    trans (G.cong-add (hf.1 x.1 y.1)
            (trans (ap (\ t -> A.mul t e) (hf.1 x.2 y.2)) (A.dist-right (f x.2) (f y.2) e)))
     (G.swap (f x.1) (f y.1) (A.mul (f x.2) e) (A.mul (f y.2) e)) ;
   g-scale (c : R) (x : Ext (suc n)) : Id A.A (g (escale (suc n) c x)) (A.scale c (g x)) =
    trans (G.cong-add (hf.2.1 c x.1)
            (trans (ap (\ t -> A.mul t e) (hf.2.1 c x.2)) (A.scale-mul-left c (f x.2) e)))
     (sym (A.scale-add c (f x.1) (A.mul (f x.2) e))) ;
   g-one : Id A.A (g (eone (suc n))) A.one =
    trans (G.cong-add hf.2.2.2 (trans (ap (\ t -> A.mul t e) f-zero) (X.mul-zero-l e))) (A.addZ A.one) ;

   -- (x1 e) y0 = (f x1 f(alpha y0)) e
   m1 (x1 y0 : Ext n) : Id A.A (A.mul (A.mul (f x1) e) (f y0)) (A.mul (A.mul (f x1) (f (alpha n y0))) e) =
    trans (sym (A.mulA (f x1) e (f y0)))
     (trans (ap (A.mul (f x1)) (com y0)) (A.mulA (f x1) (f (alpha n y0)) e)) ;
   -- (x1 e)(y1 e) = 0
   m2 (x1 y1 : Ext n) : Id A.A (A.mul (A.mul (f x1) e) (A.mul (f y1) e)) A.zero =
    calc A.A {
     A.mul (A.mul (f x1) e) (A.mul (f y1) e) =< sym (A.mulA (f x1) e (A.mul (f y1) e)) >
     A.mul (f x1) (A.mul e (A.mul (f y1) e)) =< ap (A.mul (f x1)) (A.mulA e (f y1) e) >
     A.mul (f x1) (A.mul (A.mul e (f y1)) e) =< ap (\ t -> A.mul (f x1) (A.mul t e)) (com y1) >
     A.mul (f x1) (A.mul (A.mul (f (alpha n y1)) e) e)
      =< ap (A.mul (f x1)) (sym (A.mulA (f (alpha n y1)) e e)) >
     A.mul (f x1) (A.mul (f (alpha n y1)) (A.mul e e))
      =< ap (\ t -> A.mul (f x1) (A.mul (f (alpha n y1)) t)) e-sq >
     A.mul (f x1) (A.mul (f (alpha n y1)) A.zero)
      =< ap (A.mul (f x1)) (X.mul-zero-r (f (alpha n y1))) >
     A.mul (f x1) A.zero =< X.mul-zero-r (f x1) > A.zero } ;
   g-mul (x y : Ext (suc n)) : Id A.A (g (emul (suc n) x y)) (A.mul (g x) (g y)) =
    calc A.A {
     g (emul (suc n) x y)
      =< G.cong-add (hf.2.2.1 x.1 y.1)
          (trans (ap (\ t -> A.mul t e)
                   (trans (hf.1 (emul n x.1 y.2) (emul n x.2 (alpha n y.1)))
                          (G.cong-add (hf.2.2.1 x.1 y.2) (hf.2.2.1 x.2 (alpha n y.1)))))
                 (A.dist-right (A.mul (f x.1) (f y.2)) (A.mul (f x.2) (f (alpha n y.1))) e)) >
     A.add (A.mul (f x.1) (f y.1))
      (A.add (A.mul (A.mul (f x.1) (f y.2)) e) (A.mul (A.mul (f x.2) (f (alpha n y.1))) e))
      =< ap (A.add (A.mul (f x.1) (f y.1)))
          (rot (A.mul (A.mul (f x.1) (f y.2)) e) (A.mul (A.mul (f x.2) (f (alpha n y.1))) e)) >
     A.add (A.mul (f x.1) (f y.1))
      (A.add (A.mul (A.mul (f x.2) (f (alpha n y.1))) e) (A.add (A.mul (A.mul (f x.1) (f y.2)) e) A.zero))
      =< A.addA (A.mul (f x.1) (f y.1)) (A.mul (A.mul (f x.2) (f (alpha n y.1))) e)
          (A.add (A.mul (A.mul (f x.1) (f y.2)) e) A.zero) >
     A.add (A.add (A.mul (f x.1) (f y.1)) (A.mul (A.mul (f x.2) (f (alpha n y.1))) e))
      (A.add (A.mul (A.mul (f x.1) (f y.2)) e) A.zero)
      =< sym (G.cong-add (ap (A.add (A.mul (f x.1) (f y.1))) (m1 x.2 y.1))
                         (G.cong-add (A.mulA (f x.1) (f y.2) e) (m2 x.2 y.2))) >
     A.add (A.add (A.mul (f x.1) (f y.1)) (A.mul (A.mul (f x.2) e) (f y.1)))
      (A.add (A.mul (f x.1) (A.mul (f y.2) e)) (A.mul (A.mul (f x.2) e) (A.mul (f y.2) e)))
      =< sym (G.cong-add (A.dist-right (f x.1) (A.mul (f x.2) e) (f y.1))
                         (A.dist-right (f x.1) (A.mul (f x.2) e) (A.mul (f y.2) e))) >
     A.add (A.mul (g x) (f y.1)) (A.mul (g x) (A.mul (f y.2) e))
      =< sym (A.dist-left (g x) (f y.1) (A.mul (f y.2) e)) >
     A.mul (g x) (g y) } ;

   hom : Hom (suc n) = (g,(g-add,g-scale,g-mul,g-one)) ;

   -- g extends j
   f-emb (c : R) : Id A.A (f (emb n c)) (A.scale c A.one) =
    trans (ap f (trans (ap (emb n) (sym (mulO c))) (EA.emb-scale n c o)))
     (trans (hf.2.1 c (eone n)) (ap (A.scale c) hf.2.2.2)) ;
   g-gen (a : AL.Vec (suc n)) : Id A.A (g (gen (suc n) a)) (j.1 a) =
    calc A.A {
     g (gen (suc n) a)
      =< G.cong-add (ih.2.1 (\ k -> a (inl k)))
          (trans (ap (\ t -> A.mul t e) (f-emb (a (inr tt))))
           (trans (A.scale-mul-left (a (inr tt)) A.one e) (ap (A.scale (a (inr tt))) (A.one-left e)))) >
     A.add (j.1 (ext0 n (\ k -> a (inl k)))) (A.scale (a (inr tt)) e)
      =< sym (ap (A.add (j.1 (ext0 n (\ k -> a (inl k))))) (j.2.1.2 (a (inr tt)) (last n))) >
     A.add (j.1 (ext0 n (\ k -> a (inl k)))) (j.1 (AL.vscale (suc n) (a (inr tt)) (last n)))
      =< sym (j.2.1.1 (ext0 n (\ k -> a (inl k))) (AL.vscale (suc n) (a (inr tt)) (last n))) >
     j.1 (AL.vadd (suc n) (ext0 n (\ k -> a (inl k))) (AL.vscale (suc n) (a (inr tt)) (last n)))
      =< ap j.1 (F.funext (Ps.Fin (suc n)) (\ k -> R)
                  (AL.vadd (suc n) (ext0 n (\ k -> a (inl k))) (AL.vscale (suc n) (a (inr tt)) (last n))) a
                  (split-vec n a)) >
     j.1 a } ;

   -- graded commutation at n + 1
   g-graded : Graded (suc n) j hom = \ eps h x ->
    trans (trans (A.dist-left eps (f x.1) (A.mul (f x.2) e))
     (G.cong-add (ih.2.2 eps (\ v -> h (ext0 n v)) x.1)
      (trans (A.mulA eps (f x.2) e)
       (trans (ap (\ t -> A.mul t e) (ih.2.2 eps (\ v -> h (ext0 n v)) x.2))
        (trans (sym (A.mulA (f (alpha n x.2)) eps e))
         (trans (ap (A.mul (f (alpha n x.2))) (h (last n)))
                (X.mul-neg-r (f (alpha n x.2)) (A.mul e eps))))))))
    (sym (trans (A.dist-right (f (alpha n x.1)) (A.mul (f (eneg n (alpha n x.2))) e) eps)
     (ap (A.add (A.mul (f (alpha n x.1)) eps))
      (trans (ap (\ t -> A.mul (A.mul t e) eps) (f-neg (alpha n x.2)))
       (trans (ap (\ t -> A.mul t eps) (X.mul-neg-l (f (alpha n x.2)) e))
        (trans (X.mul-neg-l (A.mul (f (alpha n x.2)) e) eps)
               (ap A.neg (sym (A.mulA (f (alpha n x.2)) e eps))))))))) ;

   result : Extension (suc n) j = (hom,g-gen,g-graded) ;
  } ;

  extend : (n : Nat) (j : X.Alt n) -> Extension n j = split {
   zero -> base ;
   suc n | r -> \ j -> Step[n,j,r (restrict n j)].result } ;
  ext (n : Nat) (j : X.Alt n) : Hom n = (extend n j).1 ;

  ---------------------------------------------------------------------
  -- uniqueness: algebra maps agreeing on the generators are equal

  on-R (f : Hom zero) (c : R) : Id A.A (f.1 c) (A.scale c A.one) =
   trans (ap f.1 (sym (mulO c))) (trans (f.2.2.1 c o) (ap (A.scale c) f.2.2.2.2)) ;
  -- f (x0, x1) = f (iota x0) + f (iota x1) f e
  split-hom (n : Nat) (f : Hom (suc n)) (x : Ext (suc n)) :
   Id A.A (f.1 x) (A.add (f.1 (iota n x.1)) (A.mul (f.1 (iota n x.2)) (f.1 (E n)))) =
   trans (ap f.1 (decomp n x))
    (trans (f.2.1 (iota n x.1) (emul (suc n) (iota n x.2) (E n)))
           (ap (A.add (f.1 (iota n x.1))) (f.2.2.2.1 (iota n x.2) (E n)))) ;
  unique : (n : Nat) (f g : Hom n) -> ((a : AL.Vec n) -> Id A.A (f.1 (gen n a)) (g.1 (gen n a))) ->
   (x : Ext n) -> Id A.A (f.1 x) (g.1 x) = split {
   zero -> \ f g h c -> trans (on-R f c) (sym (on-R g c)) ;
   suc n | r -> \ f g h x ->
    trans (split-hom n f x)
     (trans (G.cong-add
              (r (AL.comp (Lam n) (Lam (suc n)) A f (iota-hom n)) (AL.comp (Lam n) (Lam (suc n)) A g (iota-hom n))
                 (\ a -> trans (ap f.1 (iota-gen n a)) (trans (h (ext0 n a)) (sym (ap g.1 (iota-gen n a))))) x.1)
              (cong-mul
                (r (AL.comp (Lam n) (Lam (suc n)) A f (iota-hom n)) (AL.comp (Lam n) (Lam (suc n)) A g (iota-hom n))
                   (\ a -> trans (ap f.1 (iota-gen n a)) (trans (h (ext0 n a)) (sym (ap g.1 (iota-gen n a))))) x.2)
                (trans (ap f.1 (sym (E-gen n))) (trans (h (last n)) (ap g.1 (E-gen n))))))
      (sym (split-hom n g x))) } ;

  ---------------------------------------------------------------------
  -- the universal property

  precomp-ext (n : Nat) (j : X.Alt n) : Id (X.Alt n) (precomp n (ext n j)) j =
   Pr.Sigma-eq (AL.Vec n -> A.A) (X.Prop n) (precomp n (ext n j)).1 j.1 (precomp n (ext n j)).2 j.2
    (F.funext (AL.Vec n) (\ a -> A.A) (precomp n (ext n j)).1 j.1 (extend n j).2.1) (X.prop-prop n j.1) ;
  -- The pointwise equality is proved first by uniqueness. The equality
  -- of bundled maps below uses this same component and hom-propositionality.
  ext-precomp-value (n : Nat) (f : Hom n) (x : Ext n) :
   Id A.A ((ext n (precomp n f)).1 x) (f.1 x) =
   unique n (ext n (precomp n f)) f (extend n (precomp n f)).2.1 x ;
  ext-precomp (n : Nat) (f : Hom n) : Id (Hom n) (ext n (precomp n f)) f =
   Pr.Sigma-eq (Ext n -> A.A) (S.Hom (Lam n) A) (ext n (precomp n f)).1 f.1 (ext n (precomp n f)).2 f.2
    (F.funext (Ext n) (\ x -> A.A) (ext n (precomp n f)).1 f.1 (ext-precomp-value n f))
    (S.hom-prop (Lam n) A f.1) ;
  universal (n : Nat) : Pr.isEquiv (Hom n) (X.Alt n) (precomp n) =
   Pr.qinv (Hom n) (X.Alt n) (precomp n) (ext n) (precomp-ext n) (ext-precomp n) ;
  -- later files use only extend's equation (extend n j).2.1 and uniqueness
  opaque extend ; opaque unique ;
 } ;
 -- Both composites agree at gen(v): f(-gen(v)) = -f(gen(v))
 -- = alpha(f(gen(v))). No specific exterior extension is evaluated.
 grade-natural (n m : Nat) (f : AL.AlgHom (Lam n) (Lam m))
  (odd : (v : AL.Vec n) -> Id (Ext m) (alpha m (f.1 (gen n v))) (eneg m (f.1 (gen n v))))
  (x : Ext n) : Id (Ext m) (f.1 (alpha n x)) (alpha m (f.1 x)) =
  In[Lam m].unique n
   (AL.comp (Lam n) (Lam n) (Lam m) f (alpha-hom n))
   (AL.comp (Lam n) (Lam m) (Lam m) (alpha-hom m) f)
   (\ v -> trans (ap f.1 (EA.alpha-gen n v))
    (trans (AL.In[Lam m].H[Lam n,f].neg (gen n v)) (sym (odd v)))) x ;
 opaque alpha-hom ;
} ;
