-- Exterior transposition, developed from the mixed contraction identity.
--
-- Informal proof. All pairings are the coordinate dot pairing; no
-- inner-product nondegeneracy or inversion in the coefficient ring is used.
-- transpose interchanges the two matrix indices. Its value, double
-- transpose and their actions are recorded as defining equations.
-- vdot-sum compares the recursively defined vector dot product with the
-- finite sum (the finite sum visits the last coordinate first, so the
-- successor proof commutes two summands). vdot-transpose first writes the
-- sum of named coordinates, then applies act-coordinate inside that sum.
-- It distributes multiplication, exchanges the two sums and reassociates
-- factors. transpose-entry and act-transpose-value identify the final
-- sum as (A^t v,w). Coordinates and entries stay locked in this proof.
--
-- Determinant.Map.value-alpha names commutation with the grade involution.
-- Its uniqueness argument is checked generically in ExteriorUniversal:
-- the two composites agree on generators, whose images are odd.
-- contract-one follows by the named recursive equations for contraction.
-- Natural proves c_v phi_A=phi_A c_(A^t v). The unit is immediate.
-- For a product x gen(w), contract-right gives two terms. Apply the
-- induction hypothesis to the first; vdot-transpose and value-alpha to
-- the second. Multiplicativity, additivity and homogeneity of phi_A
-- recombine them. product iterates this step; natural extends from the
-- selected basis products by linear-map extensionality.
--
-- bottom is augmentation, obtained by taking first components down to
-- rank zero. Its additive, scalar, product, unit and generator laws
-- follow by the defining projection. bottom-hom packages these laws;
-- bottom-map follows from uniqueness, since both maps send generators
-- to zero. dot-one and one-dot identify augmentation with pairing with 1.
-- right-pair is adjointness for RIGHT generator multiplication. Write
-- x gen(w)=gen(w)alpha(x), apply contract-pair and move alpha across dot.
--
-- Transpose proves dot(phi_A x,y)=dot(x,phi_(A^t)y). Its unit case uses
-- bottom-map. Its product step uses right-pair on both sides, the
-- induction hypothesis, value-alpha and contraction naturality for A^t.
-- The twice-transpose equations identify (A^t)^t with A at this step.
-- product iterates; transpose-pair extends from basis products by
-- scalar linear-form extensionality. No exterior map is computed here.
--
-- star-isometry follows by induction from the defining signed complement
-- permutation: the two components exchange places, and alpha is an
-- involutive adjoint. adj-star uses the characterising wedge pairing
-- of the higher adjugate and transpose-pair, then dot-injectivity:
-- star(Adj(A)x)=phi_(A^t)(star x).
-- Conjugate this identity by the isometry star, and use transpose-pair,
-- to get adj-transpose-pair. Finally omega-dot identifies top with
-- pairing against omega (componentwise induction), and det-transpose
-- applies transpose-pair to omega on both sides, using image-top.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module UP = ExteriorUniversal[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module CO = ExteriorCoordinates[l].Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module AD = ExteriorAdjugate[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module MS = MnSums[l].Over[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 -- Component inductions explicitly use the concrete pair representation.
 transparent first ; transparent second ;
 transpose (n : Nat) (A : DT.Mat n) : DT.Mat n = \ i j -> A j i ;
 transpose-value (n : Nat) (A : DT.Mat n) (i j : Ps.Fin n) : Id R (transpose n A i j) (A j i) = refl (A j i) ;
 transpose-twice (n : Nat) (A : DT.Mat n) : Id (DT.Mat n) (transpose n (transpose n A)) A = refl A ;
 act-transpose-twice (n : Nat) (A : DT.Mat n) (v : AL.Vec n) :
  Id (AL.Vec n) (DT.act n (transpose n (transpose n A)) v) (DT.act n A v) = refl (DT.act n A v) ;
 map-transpose-twice (n : Nat) (A : DT.Mat n) (x : Ext n) :
  Id (Ext n) (DT.Map[n,transpose n (transpose n A)].value x) (DT.Map[n,A].value x) = refl (DT.Map[n,A].value x) ;
 -- Transposition exchanges named entries; action is then evaluated by
 -- act-coordinate. The scalar proof below never applies a raw vector.
 transparent DT.entry ;
 transpose-entry (n : Nat) (A : DT.Mat n) (i j : Ps.Fin n) :
  Id R (DT.entry n (transpose n A) i j) (DT.entry n A j i) = refl (DT.entry n A j i) ;
 opaque DT.entry ; opaque transpose ;
 act-transpose-value (n : Nat) (A : DT.Mat n) (v : AL.Vec n) (i : Ps.Fin n) :
  Id R (AL.coordinate n (DT.act n (transpose n A) v) i)
   (S.sum n (\ j -> mul (AL.coordinate n v j) (DT.entry n A i j))) =
  trans (DT.act-coordinate n (transpose n A) v i)
   (S.sum-cong n _ _ (\ j -> ap (mul (AL.coordinate n v j)) (transpose-entry n A j i))) ;
 vdot-sum : (n : Nat) (v w : AL.Vec n) ->
  Id R (VC.vdot n v w) (S.sum n (\ i -> mul (AL.coordinate n v i) (AL.coordinate n w i))) = split {
  zero -> \ v w -> VC.vdot-zero-def v w ;
  suc n | r -> \ v w -> trans (VC.vdot-step-def n v w)
   (trans (ap (\ a -> add a (mul (VC.vector-last n v) (VC.vector-last n w)))
     (r (VC.vector-prefix n v) (VC.vector-prefix n w)))
    (trans (addC (S.sum n (\ i -> mul (AL.coordinate n (VC.vector-prefix n v) i) (AL.coordinate n (VC.vector-prefix n w) i)))
      (mul (VC.vector-last n v) (VC.vector-last n w))) (sym (VC.vector-dot-sum-step n v w)))) } ;
 vdot-transpose (n : Nat) (A : DT.Mat n) (v w : AL.Vec n) :
  Id R (VC.vdot n v (DT.act n A w)) (VC.vdot n (DT.act n (transpose n A) v) w) =
  calc R { VC.vdot n v (DT.act n A w)
   =< vdot-sum n v (DT.act n A w)
    > S.sum n (\ i -> mul (AL.coordinate n v i) (AL.coordinate n (DT.act n A w) i))
   =< S.sum-cong n _ _ (\ i -> ap (mul (AL.coordinate n v i)) (DT.act-coordinate n A w i))
    > S.sum n (\ i -> mul (AL.coordinate n v i) (S.sum n (\ j -> mul (AL.coordinate n w j) (DT.entry n A j i))))
   =< S.sum-cong n _ _ (\ i -> sym (S.sum-scale (AL.coordinate n v i) n (\ j -> mul (AL.coordinate n w j) (DT.entry n A j i))))
    > S.sum n (\ i -> S.sum n (\ j -> mul (AL.coordinate n v i) (mul (AL.coordinate n w j) (DT.entry n A j i))))
   =< MS.exchange n n (\ i j -> mul (AL.coordinate n v i) (mul (AL.coordinate n w j) (DT.entry n A j i)))
    > S.sum n (\ j -> S.sum n (\ i -> mul (AL.coordinate n v i) (mul (AL.coordinate n w j) (DT.entry n A j i))))
   =< S.sum-cong n _ _ (\ j -> trans (S.sum-cong n _ _ (\ i ->
      trans (L.mul-swap (AL.coordinate n v i) (AL.coordinate n w j) (DT.entry n A j i))
       (mulC (AL.coordinate n w j) (mul (AL.coordinate n v i) (DT.entry n A j i)))))
     (MS.sum-scale-right (AL.coordinate n w j) n (\ i -> mul (AL.coordinate n v i) (DT.entry n A j i))))
    > S.sum n (\ j -> mul (S.sum n (\ i -> mul (AL.coordinate n v i) (DT.entry n A j i))) (AL.coordinate n w j))
   =< S.sum-cong n _ _ (\ j -> ap (\ a -> mul a (AL.coordinate n w j)) (sym (act-transpose-value n A v j)))
    > S.sum n (\ j -> mul (AL.coordinate n (DT.act n (transpose n A) v) j) (AL.coordinate n w j))
   =< sym (vdot-sum n (DT.act n (transpose n A) v) w) > VC.vdot n (DT.act n (transpose n A) v) w } ;

 contract-one : (n : Nat) (v : AL.Vec n) -> Id (Ext n) (VC.contract n v (eone n)) (ezero n) = split {
  zero -> \ v -> VC.contract-zero-def v o ;
  suc n | r -> \ v -> trans (VC.contract-step-def n v (eone (suc n))) (ExteriorAlgebra[l].pair-eq
   (trans (EA.At[n].G.cong-add (r (VC.vector-prefix n v))
     (trans (ap (escale n (VC.vector-last n v)) (EA.alpha-zero n)) (EA.escale-zero n (VC.vector-last n v)))) (EA.eaddZ n (ezero n)))
   (VC.contract-zero n (VC.vector-prefix n v))) } ;

 module Natural (n : Nat) (A : DT.Mat n) (v : AL.Vec n) {
  P (x : Ext n) : U l = Id (Ext n) (VC.contract n v (DT.Map[n,A].value x)) (DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) x)) ;
  unit : P (eone n) =
   trans (ap (VC.contract n v) DT.Map[n,A].value-one)
    (trans (contract-one n v)
     (sym (trans (ap DT.Map[n,A].value (contract-one n (DT.act n (transpose n A) v))) (DT.Map[n,A].value-zero)))) ;
  step (x : Ext n) (w : AL.Vec n) (ih : P x) : P (emul n x (gen n w)) =
   calc (Ext n) { VC.contract n v (DT.Map[n,A].value (emul n x (gen n w)))
    =< ap (VC.contract n v) (trans (DT.Map[n,A].value-mul x (gen n w)) (ap (emul n (DT.Map[n,A].value x)) (DT.Map[n,A].value-gen w)))
     > VC.contract n v (emul n (DT.Map[n,A].value x) (gen n (DT.act n A w)))
    =< VC.contract-right n v (DT.act n A w) (DT.Map[n,A].value x)
     > eadd n (emul n (VC.contract n v (DT.Map[n,A].value x)) (gen n (DT.act n A w)))
        (escale n (VC.vdot n v (DT.act n A w)) (alpha n (DT.Map[n,A].value x)))
    =< EA.At[n].G.cong-add (ap (\ y -> emul n y (gen n (DT.act n A w))) ih)
      (trans (ap (\ a -> escale n a (alpha n (DT.Map[n,A].value x))) (vdot-transpose n A v w))
       (ap (escale n (VC.vdot n (DT.act n (transpose n A) v) w)) (sym (DT.Map[n,A].value-alpha x))))
     > eadd n (emul n (DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) x)) (gen n (DT.act n A w)))
        (escale n (VC.vdot n (DT.act n (transpose n A) v) w) (DT.Map[n,A].value (alpha n x)))
    =< EA.At[n].G.cong-add
      (sym (trans (DT.Map[n,A].value-mul (VC.contract n (DT.act n (transpose n A) v) x) (gen n w))
       (ap (emul n (DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) x))) (DT.Map[n,A].value-gen w))))
      (sym (DT.Map[n,A].value-scale (VC.vdot n (DT.act n (transpose n A) v) w) (alpha n x)))
     > eadd n (DT.Map[n,A].value (emul n (VC.contract n (DT.act n (transpose n A) v) x) (gen n w)))
        (DT.Map[n,A].value (escale n (VC.vdot n (DT.act n (transpose n A) v) w) (alpha n x)))
    =< sym (DT.Map[n,A].value-add (emul n (VC.contract n (DT.act n (transpose n A) v) x) (gen n w)) (escale n (VC.vdot n (DT.act n (transpose n A) v) w) (alpha n x)))
     > DT.Map[n,A].value (eadd n (emul n (VC.contract n (DT.act n (transpose n A) v) x) (gen n w)) (escale n (VC.vdot n (DT.act n (transpose n A) v) w) (alpha n x)))
    =< ap DT.Map[n,A].value (sym (VC.contract-right n (DT.act n (transpose n A) v) w x)) > DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) (emul n x (gen n w))) } ;
  product : (m : Nat) (w : Ps.Fin m -> AL.Vec n) -> P (eprod n m (\ j -> gen n (w j))) = split {
   zero -> \ w -> unit ; suc m | r -> \ w -> step (eprod n m (\ j -> gen n (w (inl j)))) (w (inr tt)) (r (\ j -> w (inl j))) } ;
  left-linear : CO.LinearMap n n (\ x -> VC.contract n v (DT.Map[n,A].value x)) =
   ((\ x y -> trans (ap (VC.contract n v) (DT.Map[n,A].value-add x y)) (VC.contract-add n v (DT.Map[n,A].value x) (DT.Map[n,A].value y))),
    \ a x -> trans (ap (VC.contract n v) (DT.Map[n,A].value-scale a x)) (VC.contract-scale n v a (DT.Map[n,A].value x))) ;
  right-linear : CO.LinearMap n n (\ x -> DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) x)) =
   ((\ x y -> trans (ap DT.Map[n,A].value (VC.contract-add n (DT.act n (transpose n A) v) x y)) (DT.Map[n,A].value-add (VC.contract n (DT.act n (transpose n A) v) x) (VC.contract n (DT.act n (transpose n A) v) y))),
    \ a x -> trans (ap DT.Map[n,A].value (VC.contract-scale n (DT.act n (transpose n A) v) a x)) (DT.Map[n,A].value-scale a (VC.contract n (DT.act n (transpose n A) v) x))) ;
  natural (x : Ext n) : P x =
   CO.map-ext n n (\ y -> VC.contract n v (DT.Map[n,A].value y)) (\ y -> DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) y)) left-linear right-linear
    (\ i -> subst P (sym (BA.basis-product n i)) (product (BA.count n i) (BA.select n i))) x ;
 } ;
 contract-natural (n : Nat) (A : DT.Mat n) (v : AL.Vec n) (x : Ext n) :
  Id (Ext n) (VC.contract n v (DT.Map[n,A].value x))
   (DT.Map[n,A].value (VC.contract n (DT.act n (transpose n A) v) x)) = Natural[n,A,v].natural x ;

 -- Augmentation is the coefficient of the empty product.
 bottom : (n : Nat) -> Ext n -> R = split { zero -> \ x -> x ; suc n | r -> \ x -> r (first n x) } ;
 bottom-zero-def (x : Ext zero) : Id R (bottom zero x) x = refl x ;
 bottom-step-def (n : Nat) (x : Ext (suc n)) : Id R (bottom (suc n) x) (bottom n (first n x)) = refl (bottom (suc n) x) ;
 bottom-add : (n : Nat) (x y : Ext n) -> Id R (bottom n (eadd n x y)) (add (bottom n x) (bottom n y)) = split {
  zero -> \ x y -> refl (add x y) ; suc n | r -> \ x y -> r (first n x) (first n y) } ;
 bottom-scale : (n : Nat) (a : R) (x : Ext n) -> Id R (bottom n (escale n a x)) (mul a (bottom n x)) = split {
  zero -> \ a x -> refl (mul a x) ; suc n | r -> \ a x -> r a (first n x) } ;
 bottom-mul : (n : Nat) (x y : Ext n) -> Id R (bottom n (emul n x y)) (mul (bottom n x) (bottom n y)) = split {
  zero -> \ x y -> refl (mul x y) ; suc n | r -> \ x y -> r (first n x) (first n y) } ;
 bottom-one : (n : Nat) -> Id R (bottom n (eone n)) o = split { zero -> refl o ; suc n | r -> r } ;
 bottom-gen : (n : Nat) (v : AL.Vec n) -> Id R (bottom n (gen n v)) z = split {
  zero -> \ v -> refl z ; suc n | r -> \ v -> r (\ i -> v (inl i)) } ;
 bottom-hom (n : Nat) : AL.AlgHom (UP.Lam n) (UP.Lam zero) =
  (bottom n,(bottom-add n,bottom-scale n,bottom-mul n,bottom-one n)) ;
 bottom-map (n : Nat) (A : DT.Mat n) (x : Ext n) : Id R (bottom n (DT.Map[n,A].value x)) (bottom n x) =
  UP.In[UP.Lam zero].unique n
   (AL.comp (UP.Lam n) (UP.Lam n) (UP.Lam zero) (bottom-hom n) DT.Map[n,A].phi) (bottom-hom n)
   (\ v -> trans (ap (bottom n) (DT.Map[n,A].value-gen v))
    (trans (bottom-gen n (DT.act n A v)) (sym (bottom-gen n v)))) x ;
 dot-one : (n : Nat) (x : Ext n) -> Id R (DU.dot n x (eone n)) (bottom n x) = split {
  zero -> \ x -> mulO x ;
  suc n | r -> \ x -> trans (DU.cong (r (first n x)) (DU.dot-zero n (second n x))) (addZ (bottom n (first n x))) } ;
 opaque bottom ;
 one-dot (n : Nat) (x : Ext n) : Id R (DU.dot n (eone n) x) (bottom n x) =
  trans (DU.dot-sym n (eone n) x) (dot-one n x) ;
 right-pair (n : Nat) (w : AL.Vec n) (x y : Ext n) :
  Id R (DU.dot n (emul n x (gen n w)) y) (DU.dot n x (alpha n (VC.contract n w y))) =
  calc R { DU.dot n (emul n x (gen n w)) y
   =< ap (\ t -> DU.dot n t y) (sym (VC.right-commute n w x)) > DU.dot n (emul n (gen n w) (alpha n x)) y
   =< DU.dot-sym n (emul n (gen n w) (alpha n x)) y > DU.dot n y (emul n (gen n w) (alpha n x))
   =< ap (DU.dot n y) (sym (VC.left-wedge-value n w (alpha n x))) > DU.dot n y (VC.left-wedge n w (alpha n x))
   =< sym (VC.contract-pair n w y (alpha n x)) > DU.dot n (VC.contract n w y) (alpha n x)
   =< sym (DU.dot-alpha n (VC.contract n w y) x) > DU.dot n (alpha n (VC.contract n w y)) x
   =< DU.dot-sym n (alpha n (VC.contract n w y)) x > DU.dot n x (alpha n (VC.contract n w y)) } ;

 module Transpose (n : Nat) (A : DT.Mat n) {
  P (x : Ext n) : U l = (y : Ext n) -> Id R (DU.dot n (DT.Map[n,A].value x) y) (DU.dot n x (DT.Map[n,transpose n A].value y)) ;
  unit : P (eone n) = \ y ->
   trans (ap (\ x -> DU.dot n x y) DT.Map[n,A].value-one)
    (trans (one-dot n y) (sym (trans (one-dot n (DT.Map[n,transpose n A].value y)) (bottom-map n (transpose n A) y)))) ;
  step (x : Ext n) (w : AL.Vec n) (ih : P x) : P (emul n x (gen n w)) = \ y ->
   calc R { DU.dot n (DT.Map[n,A].value (emul n x (gen n w))) y
    =< ap (\ t -> DU.dot n t y) (trans (DT.Map[n,A].value-mul x (gen n w)) (ap (emul n (DT.Map[n,A].value x)) (DT.Map[n,A].value-gen w)))
     > DU.dot n (emul n (DT.Map[n,A].value x) (gen n (DT.act n A w))) y
    =< right-pair n (DT.act n A w) (DT.Map[n,A].value x) y > DU.dot n (DT.Map[n,A].value x) (alpha n (VC.contract n (DT.act n A w) y))
    =< ih (alpha n (VC.contract n (DT.act n A w) y)) > DU.dot n x (DT.Map[n,transpose n A].value (alpha n (VC.contract n (DT.act n A w) y)))
    =< ap (DU.dot n x) (DT.Map[n,transpose n A].value-alpha (VC.contract n (DT.act n A w) y))
     > DU.dot n x (alpha n (DT.Map[n,transpose n A].value (VC.contract n (DT.act n A w) y)))
    =< ap (\ t -> DU.dot n x (alpha n t))
      (trans (ap DT.Map[n,transpose n A].value (ap (\ v -> VC.contract n v y) (sym (act-transpose-twice n A w))))
       (sym (contract-natural n (transpose n A) w y)))
     > DU.dot n x (alpha n (VC.contract n w (DT.Map[n,transpose n A].value y)))
    =< sym (right-pair n w x (DT.Map[n,transpose n A].value y)) > DU.dot n (emul n x (gen n w)) (DT.Map[n,transpose n A].value y) } ;
  product : (m : Nat) (w : Ps.Fin m -> AL.Vec n) -> P (eprod n m (\ j -> gen n (w j))) = split {
   zero -> \ w -> unit ; suc m | r -> \ w -> step (eprod n m (\ j -> gen n (w (inl j)))) (w (inr tt)) (r (\ j -> w (inl j))) } ;
  transpose-pair (x y : Ext n) : Id R (DU.dot n (DT.Map[n,A].value x) y) (DU.dot n x (DT.Map[n,transpose n A].value y)) =
   CO.linear-ext n (\ t -> DU.dot n (DT.Map[n,A].value t) y) (\ t -> DU.dot n t (DT.Map[n,transpose n A].value y))
    ((\ t u -> trans (ap (\ b -> DU.dot n b y) (DT.Map[n,A].value-add t u)) (DU.dot-add-left n (DT.Map[n,A].value t) (DT.Map[n,A].value u) y)),
     \ a t -> trans (ap (\ b -> DU.dot n b y) (DT.Map[n,A].value-scale a t)) (DU.dot-scale-left n a (DT.Map[n,A].value t) y))
    ((\ t u -> DU.dot-add-left n t u (DT.Map[n,transpose n A].value y)),\ a t -> DU.dot-scale-left n a t (DT.Map[n,transpose n A].value y))
    (\ i -> subst P (sym (BA.basis-product n i)) (product (BA.count n i) (BA.select n i)) y) x ;
 } ;
 transpose-pair (n : Nat) (A : DT.Mat n) (x y : Ext n) :
  Id R (DU.dot n (DT.Map[n,A].value x) y) (DU.dot n x (DT.Map[n,transpose n A].value y)) =
  Transpose[n,A].transpose-pair x y ;

 -- The signed complement is an isometry for the coordinate pairing.
 star-isometry : (n : Nat) (x y : Ext n) -> Id R (DU.dot n (DU.star n x) (DU.star n y)) (DU.dot n x y) = split {
  zero -> \ x y -> refl (mul x y) ;
  suc n | r -> \ x y -> trans
   (DU.cong
    (trans (DU.dot-alpha n (DU.star n (second n x)) (alpha n (DU.star n (second n y))))
     (trans (ap (DU.dot n (DU.star n (second n x))) (EA.alpha-alpha n (DU.star n (second n y)))) (r (second n x) (second n y))))
    (r (first n x) (first n y))) (addC (DU.dot n (second n x) (second n y)) (DU.dot n (first n x) (first n y))) } ;
 adj-star (n : Nat) (A : DT.Mat n) (x : Ext n) :
  Id (Ext n) (DU.star n (AD.At[n,A].adj x)) (DT.Map[n,transpose n A].value (DU.star n x)) =
  DU.dot-inj n (DU.star n (AD.At[n,A].adj x)) (DT.Map[n,transpose n A].value (DU.star n x)) (\ y ->
   calc R { DU.dot n (DU.star n (AD.At[n,A].adj x)) y
    =< DU.star-pair n (AD.At[n,A].adj x) y > top n (emul n (AD.At[n,A].adj x) y)
    =< AD.At[n,A].characterise x y > top n (emul n x (DT.Map[n,A].value y))
    =< sym (DU.star-pair n x (DT.Map[n,A].value y)) > DU.dot n (DU.star n x) (DT.Map[n,A].value y)
    =< ap (DU.dot n (DU.star n x)) (sym (map-transpose-twice n A y))
     > DU.dot n (DU.star n x) (DT.Map[n,transpose n (transpose n A)].value y)
    =< sym (transpose-pair n (transpose n A) (DU.star n x) y) > DU.dot n (DT.Map[n,transpose n A].value (DU.star n x)) y }) ;
 adj-transpose-pair (n : Nat) (A : DT.Mat n) (x y : Ext n) :
  Id R (DU.dot n (AD.At[n,A].adj x) y) (DU.dot n x (AD.At[n,transpose n A].adj y)) =
  calc R { DU.dot n (AD.At[n,A].adj x) y
   =< sym (star-isometry n (AD.At[n,A].adj x) y) > DU.dot n (DU.star n (AD.At[n,A].adj x)) (DU.star n y)
   =< ap (\ t -> DU.dot n t (DU.star n y)) (adj-star n A x)
    > DU.dot n (DT.Map[n,transpose n A].value (DU.star n x)) (DU.star n y)
   =< transpose-pair n (transpose n A) (DU.star n x) (DU.star n y)
    > DU.dot n (DU.star n x) (DT.Map[n,transpose n (transpose n A)].value (DU.star n y))
   =< ap (DU.dot n (DU.star n x)) (sym (adj-star n (transpose n A) y))
    > DU.dot n (DU.star n x) (DU.star n (AD.At[n,transpose n A].adj y))
   =< star-isometry n x (AD.At[n,transpose n A].adj y) > DU.dot n x (AD.At[n,transpose n A].adj y) } ;
 omega-dot : (n : Nat) (x : Ext n) -> Id R (DU.dot n (DG.omega n) x) (top n x) = split {
  zero -> \ x -> trans (mulC o x) (mulO x) ;
  suc n | r -> \ x -> trans (DU.cong (DU.dot-zero-left n (first n x)) (r (second n x))) (L.zl (top n (second n x))) } ;
 det-transpose (n : Nat) (A : DT.Mat n) : Id R (det n A) (det n (transpose n A)) =
  calc R { det n A
   =< sym (BA.image-top n A) > top n (DT.Map[n,A].value (DG.omega n))
   =< sym (omega-dot n (DT.Map[n,A].value (DG.omega n))) > DU.dot n (DG.omega n) (DT.Map[n,A].value (DG.omega n))
   =< DU.dot-sym n (DG.omega n) (DT.Map[n,A].value (DG.omega n)) > DU.dot n (DT.Map[n,A].value (DG.omega n)) (DG.omega n)
   =< transpose-pair n A (DG.omega n) (DG.omega n) > DU.dot n (DG.omega n) (DT.Map[n,transpose n A].value (DG.omega n))
   =< omega-dot n (DT.Map[n,transpose n A].value (DG.omega n)) > top n (DT.Map[n,transpose n A].value (DG.omega n))
   =< BA.image-top n (transpose n A) > det n (transpose n A) } ;
 opaque first ; opaque second ;
} ;
