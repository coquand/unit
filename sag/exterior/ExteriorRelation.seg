-- Relations lifted through the exterior model (DESIGN.md §5, steps 5-6).
-- A family of relations  Rel k  between two rings R and S, indexed by a
-- degree k, closed under 0, +, -, with  Rel 0 1 1  and
--   Rel k a b -> Rel 1 a' b' -> Rel (k+1) (a a') (b b') ,
-- lifts componentwise to  Ext n , and then
--   Rel 1 (M j i) (M' j i) for all j i   gives   Rel n (det M) (det M') .
-- Two instances: the graph of a ring map (naturality of det,
-- Naturality.seg), and "degree <= k with leading coefficient c" from A[X]
-- to A (the characteristic polynomial is monic, CharPoly.seg).
level l ; open Ring[l] ;
module Ps = Presentations[l] ;
module Over (Rg Sg : CRing)
 (Rel : Nat -> Rg.R -> Sg.R -> U l)
 (r-zero : (k : Nat) -> Rel k Rg.z Sg.z)
 (r-add : (k : Nat) (a a' : Rg.R) (b b' : Sg.R) -> Rel k a b -> Rel k a' b' -> Rel k (Rg.add a a') (Sg.add b b'))
 (r-neg : (k : Nat) (a : Rg.R) (b : Sg.R) -> Rel k a b -> Rel k (Rg.neg a) (Sg.neg b))
 (r-one : Rel zero Rg.o Sg.o)
 (r-mul : (k : Nat) (a a' : Rg.R) (b b' : Sg.R) -> Rel k a b -> Rel (suc zero) a' b' ->
   Rel (suc k) (Rg.mul a a') (Sg.mul b b')) {
 module ER = ExteriorModel[l].Over[Rg] ;
 module ES = ExteriorModel[l].Over[Sg] ;
 one : Nat = suc zero ;

 ERel (k : Nat) : (n : Nat) -> ER.Ext n -> ES.Ext n -> U l = split {
  zero -> Rel k ;
  suc n | r -> \ u v -> r u.1 v.1 * r u.2 v.2 } ;

 ezero (k : Nat) : (n : Nat) -> ERel k n (ER.ezero n) (ES.ezero n) = split {
  zero -> r-zero k ;
  suc n | r -> (r,r) } ;
 eadd (k : Nat) : (n : Nat) (u u' : ER.Ext n) (v v' : ES.Ext n) -> ERel k n u v -> ERel k n u' v' ->
  ERel k n (ER.eadd n u u') (ES.eadd n v v') = split {
  zero -> r-add k ;
  suc n | r -> \ u u' v v' h h' -> (r u.1 u'.1 v.1 v'.1 h.1 h'.1,r u.2 u'.2 v.2 v'.2 h.2 h'.2) } ;
 eneg (k : Nat) : (n : Nat) (u : ER.Ext n) (v : ES.Ext n) -> ERel k n u v -> ERel k n (ER.eneg n u) (ES.eneg n v) = split {
  zero -> r-neg k ;
  suc n | r -> \ u v h -> (r u.1 v.1 h.1,r u.2 v.2 h.2) } ;
 emb (k : Nat) : (n : Nat) (a : Rg.R) (b : Sg.R) -> Rel k a b -> ERel k n (ER.emb n a) (ES.emb n b) = split {
  zero -> \ a b h -> h ;
  suc n | r -> \ a b h -> (r a b h,ezero k n) } ;
 alpha (k : Nat) : (n : Nat) (u : ER.Ext n) (v : ES.Ext n) -> ERel k n u v -> ERel k n (ER.alpha n u) (ES.alpha n v) = split {
  zero -> \ u v h -> h ;
  suc n | r -> \ u v h -> (r u.1 v.1 h.1,eneg k n (ER.alpha n u.2) (ES.alpha n v.2) (r u.2 v.2 h.2)) } ;
 emul (k : Nat) : (n : Nat) (u u' : ER.Ext n) (v v' : ES.Ext n) -> ERel k n u v -> ERel one n u' v' ->
  ERel (suc k) n (ER.emul n u u') (ES.emul n v v') = split {
  zero -> r-mul k ;
  suc n | r -> \ u u' v v' h h' ->
   (r u.1 u'.1 v.1 v'.1 h.1 h'.1,
    eadd (suc k) n (ER.emul n u.1 u'.2) (ER.emul n u.2 (ER.alpha n u'.1))
                   (ES.emul n v.1 v'.2) (ES.emul n v.2 (ES.alpha n v'.1))
     (r u.1 u'.2 v.1 v'.2 h.1 h'.2)
     (r u.2 (ER.alpha n u'.1) v.2 (ES.alpha n v'.1) h.2 (alpha one n u'.1 v'.1 h'.1))) } ;

 gen : (n : Nat) (a : Ps.Fin n -> Rg.R) (b : Ps.Fin n -> Sg.R) -> ((i : Ps.Fin n) -> Rel one (a i) (b i)) ->
  ERel one n (ER.gen n a) (ES.gen n b) = split {
  zero -> \ a b h -> r-zero one ;
  suc n | r -> \ a b h -> (r (\ i -> a (inl i)) (\ i -> b (inl i)) (\ i -> h (inl i)),
                           emb one n (a (inr tt)) (b (inr tt)) (h (inr tt))) } ;
 -- a product of m factors of degree 1 has degree m
 eprod (n : Nat) : (m : Nat) (u : Ps.Fin m -> ER.Ext n) (v : Ps.Fin m -> ES.Ext n) ->
  ((i : Ps.Fin m) -> ERel one n (u i) (v i)) -> ERel m n (ER.eprod n m u) (ES.eprod n m v) = split {
  zero -> \ u v h -> emb zero n Rg.o Sg.o r-one ;
  suc m | r -> \ u v h -> emul m n (ER.eprod n m (\ i -> u (inl i))) (u (inr tt))
                                   (ES.eprod n m (\ i -> v (inl i))) (v (inr tt))
                           (r (\ i -> u (inl i)) (\ i -> v (inl i)) (\ i -> h (inl i))) (h (inr tt)) } ;
 top (k : Nat) : (n : Nat) (u : ER.Ext n) (v : ES.Ext n) -> ERel k n u v -> Rel k (ER.top n u) (ES.top n v) = split {
  zero -> \ u v h -> h ;
  suc n | r -> \ u v h -> r u.2 v.2 h.2 } ;

 det (n : Nat) (M : Ps.Fin n -> Ps.Fin n -> Rg.R) (M' : Ps.Fin n -> Ps.Fin n -> Sg.R)
  (h : (j i : Ps.Fin n) -> Rel one (M j i) (M' j i)) : Rel n (ER.det n M) (ES.det n M') =
  top n n (ER.eprod n n (\ j -> ER.gen n (M j))) (ES.eprod n n (\ j -> ES.gen n (M' j)))
   (eprod n n (\ j -> ER.gen n (M j)) (\ j -> ES.gen n (M' j)) (\ j -> gen n (M j) (M' j) (h j))) ;
} ;
