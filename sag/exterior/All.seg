-- Exterior algebra and determinants (DESIGN.md): the shared foundation up to
-- Presentations (for Fin) and NCAlgebra, then the exterior files.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ; import Poly ; import Mul ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import Truncation ; import Quotient ;
 import RawLaws ; import RawMultiplication ; import RingHom ; import PolynomialRing ; import Evaluation ; import Universal ;
 import Algebras ; import Presentations ; import Torsor ; import TorsorCocycles ; import Equivalences ; import AffineHLevels ; import AffineFinite ; import FiniteIdeal ; import MnSums ;
 import NCAlgebra ; import MnAlgebra ; import AlgSIP ; import AlgSIPUA ; import AlgSIPInd ; import AlgSIPTransport ;
 -- Exterior: the model
 import ExteriorModel ; import ExteriorAlgebra ; import Alternating ; import ExteriorUniversal ; import ExteriorContr ; import ExteriorContrUA ; import ExteriorDegree ; import Determinant ; import Adjugate ;
 import ExteriorDuality ; import ExteriorCoordinates ; import ExteriorBasis ; import ExteriorAdjugate ; import ExteriorVectorContraction ;
 import ExteriorHomogeneous ; import ExteriorTranspose ;
 import ExteriorCramerIdentity ;
 import ExteriorReplacement ;
 import ExteriorPluckerSylvester ;
 import ExteriorRelation ; import Naturality ; import CharPoly ; import DeterminantTrick ; import PolyEval ; import ModuleTrick ; import CayleyHamilton ; import MatrixCayleyHamilton ;
} ;
