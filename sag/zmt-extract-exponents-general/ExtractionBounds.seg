-- Concrete extraction denominators from finite Laurent support: each
-- relevant coordinate bound is increased by one, leaving room for the
-- normalized Z inverse. Singletons and Z-affine edges use the SAME bounds.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Ps=Presentations[l] ; module N=FiniteExponents[l] ; module L=GenericLaurent[l] ;
module CD=ChartDenominators[l] ; module C=CoordinatePowerExponents[l] ; module F=GenericSubsetFaces[l] ;
module NA=NatArith[l] ; module CC=ChartContainment[l] ; module NS=LaurentSyzygyLift4[l] ;
module X=LaurentExponentBridge[l] ; module PA=PolynomialAction4[l] ;
next (a : Base.Nat) : NA.Le a (suc a)=(suc zero,refl (suc a)) ;
module Single (n : Nat) (i : Ps.Fin n) (S : List (L.Exp n)) {
 bound : Base.Nat=CD.amount n i S ; exponent : Base.Nat=suc bound ;
 u : N.Exp n=C.powAxis n i exponent ;
 off (j : Ps.Fin n) (eq : Id Flag (CD.flag n (F.singleton n i) j) absent) : Id Base.Nat (u j) zero=
  ap (\flag -> CD.choose flag exponent) eq ;
 dom (m : L.Exp n) (mem : L.Mem (L.Exp n) m S) (j : Ps.Fin n)
  (has : Id Flag (CD.flag n (F.singleton n i) j) present) : NA.Le (NS.negPart (m j)) (u j)=
   subst (NA.Le (NS.negPart (m j))) (sym (ap (\flag -> CD.choose flag exponent) has))
    (NA.le-trans _ _ exponent
      (subst (NA.Le (NS.negPart (m j))) (ap (\j -> CD.amount n j S) (C.singleton-only n i j has)) (CD.amount-le n j S m mem))
      (next bound)) ;
} ;
module Over (m : Nat) (S : List (L.Exp (suc m))) {
 n : Nat=suc m ; Z : Ps.Fin n=inr tt ; module V=X.At[n] ;
 BZ : Base.Nat=CD.amount n Z S ; kZ : Base.Nat=suc BZ ;
 Bi (i : Ps.Fin m) : Base.Nat=CD.amount n (inl i) S ; ki (i : Ps.Fin m) : Base.Nat=suc (Bi i) ;
 LZ : N.Exp n=N.join m (N.zeroE m) kZ ;
 Li (i : Ps.Fin m) : N.Exp n=N.join m (C.powAxis m i (ki i)) zero ;
 LE (i : Ps.Fin m) : N.Exp n=V.addN LZ (Li i) ;
 LZ0 : N.Exp n=N.join m (N.zeroE m) BZ ;
 z-axis (k : Base.Nat) : Id (N.Exp n) (C.powAxis n Z k) (N.join m (N.zeroE m) k)=
  N.split-eq m _ _ (refl k) (C.empty-power m k) ;
 i-axis (i : Ps.Fin m) (k : Base.Nat) : Id (N.Exp n) (C.powAxis n (inl i) k) (N.join m (C.powAxis m i k) zero)=
  N.split-eq m _ _ (refl zero) (refl (C.powAxis m i k)) ;
 degree-Z : Id Base.Nat (N.degree n LZ) kZ=
  trans (ap (NA.plus kZ) (CoordinateExponents[l].zero-degree m)) (NA.plus-zero kZ) ;
 degree-i (i : Ps.Fin m) : Id Base.Nat (N.degree n (Li i)) (ki i)=C.degree m i (ki i) ;
 module ZChart {
  module G=Single[n,Z,S] ;
  off (j : Ps.Fin n) (eq : Id Flag (CD.flag n (F.singleton n Z) j) absent) : Id Base.Nat (LZ j) zero=
   trans (sym (ap (\u -> u j) (z-axis kZ))) (G.off j eq) ;
  dom (v : L.Exp n) (mem : L.Mem (L.Exp n) v S) (j : Ps.Fin n) (has : Id Flag (CD.flag n (F.singleton n Z) j) present) : NA.Le (NS.negPart (v j)) (LZ j)=
   subst (NA.Le (NS.negPart (v j))) (ap (\u -> u j) (z-axis kZ)) (G.dom v mem j has) ;
 } ;
 module IChart (i : Ps.Fin m) {
  module G=Single[n,inl i,S] ;
  off (j : Ps.Fin n) (eq : Id Flag (CD.flag n (F.singleton n (inl i)) j) absent) : Id Base.Nat (Li i j) zero=
   trans (sym (ap (\u -> u j) (i-axis i (ki i)))) (G.off j eq) ;
  dom (v : L.Exp n) (mem : L.Mem (L.Exp n) v S) (j : Ps.Fin n) (has : Id Flag (CD.flag n (F.singleton n (inl i)) j) present) : NA.Le (NS.negPart (v j)) (Li i j)=
   subst (NA.Le (NS.negPart (v j))) (ap (\u -> u j) (i-axis i (ki i))) (G.dom v mem j has) ;
 } ;
 module Edge (i : Ps.Fin m) {
  E : Sub n=F.pairSet n (inr i) ;
  off : (j : Ps.Fin n) -> Id Flag (CD.flag n E j) absent -> Id Base.Nat (LE i j) zero=split {
   inl j -> IChart[i].off (inl j) ;
   inr t -> \eq -> absurd (Id Base.Nat (LE i (inr t)) zero) (CC.no-ap (sym eq)) } ;
  dom (v : L.Exp n) (mem : L.Mem (L.Exp n) v S) : (j : Ps.Fin n) -> Id Flag (CD.flag n E j) present -> NA.Le (NS.negPart (v j)) (LE i j)=split {
   inl j -> IChart[i].dom v mem (inl j) ;
   inr t -> \has -> subst (NA.Le (NS.negPart (v (inr t)))) (sym (NA.plus-zero kZ)) (ZChart.dom v mem (inr t) (refl present)) } ;
 } ;
 native-Z-axis : Id (N.Exp n) (NativeCoordinates[l].axis n Z) (N.join m (N.zeroE m) (suc zero))=
  trans (sym (C.axis-one n Z)) (z-axis (suc zero)) ;
 shift-oneZ (v : L.Exp n) : Id (L.Exp n) (V.addE (V.subE v LZ) (NativeCoordinates[l].axis n Z)) (V.subE v LZ0)=
  trans (ap (V.addE (V.subE v LZ)) native-Z-axis)
   (V.ext _ _ (at v))
  where { at (v : L.Exp n) : (j : Ps.Fin n) -> Id Int
   (V.addE (V.subE v LZ) (N.join m (N.zeroE m) (suc zero)) j) (V.subE v LZ0 j)=split {
    inl j -> refl (v (inl j)) ; inr t -> suc-pred (PA.minus (v (inr t)) BZ) } } ;
 shift-both (v : L.Exp n) (i : Ps.Fin m) : Id (L.Exp n) (V.subE (V.subE v (Li i)) LZ) (V.subE v (LE i))=V.sub-sub v (Li i) LZ ;
 shift-both-commuted (v : L.Exp n) (i : Ps.Fin m) : Id (L.Exp n) (V.subE (V.subE v LZ) (Li i)) (V.subE v (LE i))=
  trans (V.sub-comm v LZ (Li i)) (shift-both v i) ;
 module Monomials (E : CRing) (y : Ps.Fin m -> E.R) {
  module M=GenericDehomogenisation[l].Monomials[E] ; module CMon=C.Monomials[E] ;
  value-Z : Id E.R (M.value m y (N.old m LZ)) E.o=CoordinateExponents[l].Monomials[E].zero-value m y ;
  value-i (i : Ps.Fin m) : Id E.R (M.value m y (N.old m (Li i))) (M.P.power (y i) (ki i))=CMon.value m y i (ki i) ;
  value-edge (i : Ps.Fin m) : Id E.R (M.value m y (N.old m (LE i))) (M.P.power (y i) (ki i))=CMon.value m y i (ki i) ;
 } ;
} ;
