-- Coordinate powers, with natural exponents, and their exact degrees
-- and dehomogenized values. The newest coordinate is Z.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Ps=Presentations[l] ; module N=FiniteExponents[l] ; module CD=ChartDenominators[l] ;
module F=GenericSubsetFaces[l] ; module NA=NatArith[l] ; module CC=ChartContainment[l] ;
powAxis (n : Nat) (i : Ps.Fin n) (k : Base.Nat) : N.Exp n=\j -> CD.choose (CD.flag n (F.singleton n i) j) k ;
empty-power : (n : Nat) (k : Base.Nat) -> Id (N.Exp n) (\j -> CD.choose (CD.flag n (empty n) j) k) (N.zeroE n)=split {
 zero -> \k -> N.ext zero _ _ (\j -> absurd (Id Base.Nat (CD.choose (CD.flag zero (empty zero) j) k) zero) j) ;
 suc n | rec -> \k -> N.split-eq n _ _ (refl zero) (rec k) } ;
degree : (n : Nat) (i : Ps.Fin n) (k : Base.Nat) -> Id Base.Nat (N.degree n (powAxis n i k)) k=split {
 zero -> \i k -> absurd (Id Base.Nat (N.degree zero (powAxis zero i k)) k) i ;
 suc n | rec -> split {
  inl i -> rec i ;
  inr t -> \k -> trans (ap (NA.plus k) (trans (ap (N.degree n) (empty-power n k)) (CoordinateExponents[l].zero-degree n))) (NA.plus-zero k) } } ;
empty-flag : (n : Nat) (j : Ps.Fin n) -> Id Flag (CD.flag n (empty n) j) absent=split {
 zero -> \j -> absurd (Id Flag (CD.flag zero (empty zero) j) absent) j ;
 suc n | rec -> split { inl j -> rec j ; inr t -> refl absent } } ;
singleton-only : (n : Nat) (i j : Ps.Fin n) -> Id Flag (CD.flag n (F.singleton n i) j) present -> Id (Ps.Fin n) j i=split {
 zero -> \i j h -> absurd (Id (Ps.Fin zero) j i) i ;
 suc n | rec -> split {
  inl i -> split { inl j -> \h -> ap (\a -> inl a) (rec i j h) ; inr t -> \h -> absurd (Id (Ps.Fin (suc n)) (inr t) (inl i)) (CC.no-ap h) } ;
  inr t -> split { inl j -> \h -> absurd (Id (Ps.Fin (suc n)) (inl j) (inr t)) (CC.no-ap (trans (sym (empty-flag n j)) h)) ;
   inr u -> \h -> ap (\v -> inr v) (FiniteIdealPowers[l].top-prop u t) } } } ;
choose-one : (f : Flag) -> Id Base.Nat (CD.choose f (suc zero)) (ChartDirections[l].entry f (suc zero))=split {
 absent -> refl zero ; present -> refl (suc zero) } ;
axis-one (n : Nat) (i : Ps.Fin n) : Id (N.Exp n) (powAxis n i (suc zero)) (NativeCoordinates[l].axis n i)=N.ext n _ _ (\j -> choose-one (CD.flag n (F.singleton n i) j)) ;
module Monomials (E : CRing) {
 module M=GenericDehomogenisation[l].Monomials[E] ; module C=CoordinateExponents[l].Monomials[E] ; module R=RL[E] ;
 value : (n : Nat) (y : Ps.Fin n -> E.R) (i : Ps.Fin n) (k : Base.Nat) -> Id E.R (M.value n y (powAxis n i k)) (M.P.power (y i) k)=split {
  zero -> \y i k -> absurd (Id E.R (M.value zero y (powAxis zero i k)) (M.P.power (y i) k)) i ;
  suc n | rec -> \y -> step n rec y }
 where {
  step (n : Nat) (rec : (y : Ps.Fin n -> E.R) (i : Ps.Fin n) (k : Base.Nat) -> Id E.R (M.value n y (powAxis n i k)) (M.P.power (y i) k))
   (y : Ps.Fin (suc n) -> E.R) : (i : Ps.Fin (suc n)) (k : Base.Nat) -> Id E.R (M.value (suc n) y (powAxis (suc n) i k)) (M.P.power (y i) k)=split {
    inl i -> \k -> trans (E.mulO (M.value n (\j -> y (inl j)) (powAxis n i k))) (rec (\j -> y (inl j)) i k) ;
    inr t -> top n y t }
  where { top (n : Nat) (y : Ps.Fin (suc n) -> E.R) : (t : Top) (k : Base.Nat) ->
    Id E.R (M.value (suc n) y (powAxis (suc n) (inr t) k)) (M.P.power (y (inr t)) k)=split {
     tt -> \k -> trans (ap (\a -> E.mul a (M.P.power (y (inr tt)) k))
      (trans (ap (M.value n (\j -> y (inl j))) (empty-power n k)) (C.zero-value n (\j -> y (inl j)))))
       (R.one-left (M.P.power (y (inr tt)) k)) } } } ;
} ;
