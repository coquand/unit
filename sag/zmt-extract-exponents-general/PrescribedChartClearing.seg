-- Any prescribed chart-supported exponent dominating the negative parts
-- on a finite support clears denominators. No minimal/common-bound choice
-- is built into this statement.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module N=FiniteExponents[l] ;
module L=GenericLaurent[l] ; module CD=ChartDenominators[l] ; module LV=Laurent4[l] ;
module GS=GenericSupport[l] ; module NA=NatArith[l] ; module NS=LaurentSyzygyLift4[l] ;
module Over (A : CRing) {
 module Clearing (n : Nat) (E : Sub n) (S : List (L.Exp n)) (u : N.Exp n)
  (off : (i : Ps.Fin n) -> Id Flag (CD.flag n E i) absent -> Id Base.Nat (u i) zero)
  (dom : (m : L.Exp n) -> L.Mem (L.Exp n) m S -> (i : Ps.Fin n) ->
    Id Flag (CD.flag n E i) present -> NA.Le (NS.negPart (m i)) (u i)) {
  module Function (f : L.Exp n -> A.R)
   (supp : (m : L.Exp n) -> Not (L.Mem (L.Exp n) m S) -> Id A.R (f m) A.z)
   (van : (m : L.Exp n) -> GS.bad n (L.mask n m) E -> Id A.R (f m) A.z) {
   module At (m : L.Exp n) (i : Ps.Fin n) (neg : LV.Neg (m i)) {
    q : L.Exp n=CD.down n m u ;
    shifted-neg : LV.Neg (CD.up n q u i)=subst LV.Neg (sym (ap (\x -> x i) (CD.up-down n m u))) neg ;
    result : (flag : Flag) -> Id Flag (CD.flag n E i) flag -> Id A.R (f q) A.z=split {
     absent -> \eq -> van q (CD.bad-at n E q i (subst LV.Neg (sym (ap (PolynomialAction4[l].minus (m i)) (off i eq))) neg) eq) ;
     present -> \eq -> supp q (\mem -> NS.nonneg-shift (q i) (u i) (dom q mem i eq) shifted-neg) } ;
   } ;
   polynomial (m : L.Exp n) (i : Ps.Fin n) (neg : LV.Neg (m i)) : Id A.R (f (CD.down n m u)) A.z=
    At[m,i,neg].result (CD.flag n E i) (refl (CD.flag n E i)) ;
  } ;
 } ;
} ;
