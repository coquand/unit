-- The hit-or-split local theorem from the localisation adapter, and so
-- the certified cover of E by monic standard charts, with no primality
-- test.  The remaining hypothesis is the field case (Fields), at every
-- node of the cover and every output of ZMT there.
-- Hypotheses: E an A-algebra with a presentation, formally unramified
-- over A, with formal smoothness at the endpoint; for the cover, CFN of E.
-- Informal proof.  At a node s (a list of E with 1 not in (s), and a
-- decision of membership in (s)), take q = (s) and Bot = || Split s ||, a
-- proposition.  q is prime up to Bot: if ac is in (s), decide a and c; if
-- neither is in (s), (a,c) is a split.  1 in q gives Bot by properness,
-- and the decision gives one merely up to Bot.  LocalisedZMT then gives
-- merely h with (h in (s)) -> Bot and E[1/h] monic standard over A.
-- Decide h in (s): if not, (h, chart) is a hit; if so, Bot is merely a
-- split.  Both are outcomes of HitOrSplitCover, whose induction on free
-- lists gives the cover.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Big = Truncation[l+] ; module TC = TruncationCombinators[l] ; module BTC = TruncationCombinators[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (p : Presentations[l].Over[A,setA].Presentation)
 (ps : Presentations[l].Over[A,setA].Presents p (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (unique : FormallyEtale[l].Over[A,setA].Unique (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 {
 module Mo = LocalDescent[l].Monic[A,setA,E,setE,iota] ;
 module HS = HitOrSplitCover[l].Over[E,Mo.MonicChart] ;
 module P = HS.C.P ;
 -- a node of the cover
 module At (s : List E.R) (proper : Not (P.Mem s E.o)) (dec : HS.Decision s) {
  Bot : U l = Tr.Trunc[P.Split s].carrier ;
  prime-cases (a c : E.R) (h : P.Mem s (E.mul a c)) :
   Plus (P.Mem s a) (Not (P.Mem s a)) -> Plus (P.Mem s c) (Not (P.Mem s c)) -> Plus (Plus (P.Mem s a) (P.Mem s c)) Bot = split {
   inl ha -> \ dc -> inl (inl ha) ;
   inr na -> split { inl hc -> inl (inr hc) ; inr nc -> inr (Tr.Trunc[P.Split s].inc (a,c,na,nc,h)) } } ;
  q-prime (a c : E.R) (h : P.Mem s (E.mul a c)) : Plus (Plus (P.Mem s a) (P.Mem s c)) Bot = prime-cases a c h (dec a) (dec c) ;
  q-proper (h : P.Mem s E.o) : Bot = efq (proper h) ;
  q-dec (a : E.R) : Tr.Trunc[Plus (P.Mem s a) (P.Mem s a -> Bot)].carrier =
   FiniteIntroduction[l].Relative[Bot].mere-decision (P.Mem s a) (dec a) ;
  module LZ = LocalisedZMT[l].Over[A,setA,E,setE,iota,p,ps,unique,P.Mem s,P.At[s].zero,P.At[s].add,P.At[s].scale,
   Bot,Tr.Trunc[P.Split s].proposition,q-prime,q-proper,q-dec] ;
  -- a certified h: a hit, or merely a split
  hit-case (h : E.R) (out : P.Mem s h -> Bot) (chart : Mo.MonicChart h) :
   Plus (P.Mem s h) (Not (P.Mem s h)) -> Big.Trunc[HS.Outcome s].carrier = split {
   inl m -> TC.rec (P.Split s) @l+ Big.Trunc[HS.Outcome s].carrier Big.Trunc[HS.Outcome s].proposition
     (\ w -> Big.Trunc[HS.Outcome s].inc (inr w)) (out m) ;
   inr n -> Big.Trunc[HS.Outcome s].inc (inl (h,chart,n)) } ;
  outcome (c : LZ.C.St.Certified) : Big.Trunc[HS.Outcome s].carrier = hit-case c.1 c.2.1 c.2.2 (dec c.1) ;
  -- The corrected boundary allows refinement before the local datum.
  FieldCases : U l = (c : LZ.Z.Z.Conclusion) -> Tr.Trunc[LZ.At[c].Refined].carrier ;
  finish : LZ.Outcome -> Big.Trunc[HS.Outcome s].carrier = split {
   inl b -> TC.rec (P.Split s) @l+ Big.Trunc[HS.Outcome s].carrier Big.Trunc[HS.Outcome s].proposition
    (\ w -> Big.Trunc[HS.Outcome s].inc (inr w)) b ;
   inr c -> outcome c } ;
  local (field : FieldCases)
   (smooth : FormallyEtale[l].Over[A,setA].Lift Mo.Ealg) : Big.Trunc[HS.Outcome s].carrier =
   BTC.rec LZ.Outcome @l+ Big.Trunc[HS.Outcome s].carrier Big.Trunc[HS.Outcome s].proposition
    finish LZ.FieldCase[field,smooth].theorem ;
 } ;
 Fields : U l = (s : List E.R) (proper : Not (P.Mem s E.o)) (dec : HS.Decision s) -> At[s,proper,dec].FieldCases ;
 module Given (field : Fields) {
  local (smooth : FormallyEtale[l].Over[A,setA].Lift Mo.Ealg) : HS.Local =
   \ s proper dec -> At[s,proper,dec].local (field s proper dec) smooth ;
  theorem (smooth : FormallyEtale[l].Over[A,setA].Lift Mo.Ealg) (K0 : U l) (cfn : CFN[l].CFN[K0,E]) : Big.Trunc[HS.C.Cover].carrier =
   HS.Given[K0,cfn,local smooth].theorem ;
  flat-theorem (flat : FlatRelations[l].Over[A,E,iota].Flat) (K0 : U l) (cfn : CFN[l].CFN[K0,E]) : Big.Trunc[HS.C.Cover].carrier =
   theorem (FlatUnramifiedEtale[l].Over[A,setA].At[Mo.Ealg,Big.Trunc[Presentations[l].Over[A,setA].Witness Mo.Ealg].inc (p,ps),unique,flat].lift) K0 cfn ;
 } ;
} ;
