-- Integration: Worker B's tensor and pullback constructions inhabit
-- Worker A's intrinsic predicate of affineness.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module T = Tensor[l].Over[R,setR] ;
 product-affine (A B : C.Algebra) (fa : P.FP A) (fb : P.FP B) : FA.Affine (C.Spec A * C.Spec B) =
  Tr1.Trunc[T.Tensor A B].induction @l+ (\ t -> FA.Affine (C.Spec A * C.Spec B))
   (\ t -> Tr1.Trunc[FA.AffineWitness (C.Spec A * C.Spec B)].proposition)
   (\ w -> Tr1.Trunc[FA.AffineWitness (C.Spec A * C.Spec B)].inc
    (w.1,w.2.2,Functions[l].inverse (C.Spec w.1) (C.Spec A * C.Spec B) (T.spec-product A B w.1 w.2.1)))
   (T.exists A B fa fb) ;
 module SAG (sqc : P.SQC) {
  module S = SpecMaps[l].Over[R,setR,sqc] ;
  module Pullback (A B K : C.Algebra) (fa : P.FP A) (fb : P.FP B) (fk : P.FP K)
   (f : C.Spec A -> C.Spec K) (g : C.Spec B -> C.Spec K) {
   module PB = S.Affine[A,B,K,fa,fb,fk,f,g] ;
   affine : FA.Affine (PB.PB (f,g)) =
    Tr1.Trunc[PB.Result].induction @l+ (\ t -> FA.Affine (PB.PB (f,g)))
     (\ t -> Tr1.Trunc[FA.AffineWitness (PB.PB (f,g))].proposition)
     (\ w -> Tr1.Trunc[FA.AffineWitness (PB.PB (f,g))].inc
      (w.1,w.2.2,Functions[l].inverse (C.Spec w.1) (PB.PB (f,g)) w.2.1)) PB.exists ;
   canonical-algebra-fp : P.FP FA.At[PB.PB (f,g)].algebra =
    AffineUniqueness[l].Over[R,setR,sqc].At[PB.PB (f,g)].function-algebra-fp affine ;
  } ;
 } ;
} ;
