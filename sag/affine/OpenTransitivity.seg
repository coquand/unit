-- SAG 3.1.5 and 3.1.7. An open in A_f is exhibited as the
-- restriction of a finite union in A, contained in D(f).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module Fr = LocalizationFractions[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module RP = AffinePowers[l].Over[R] ;
 Iff (A B : U l) : U l = (A -> B) * (B -> A) ;
 OpenWitness (A : C.Algebra) (sub : C.Spec A -> U l) : U l =
  (n : Nat) * (gs : Fin n -> A.ring.R) * ((x : C.Spec A) -> Iff (sub x) (O.Union A n gs x)) ;
 AffineOpen (A : C.Algebra) (sub : C.Spec A -> U l) : U l = Tr.Trunc[OpenWitness A sub].carrier ;
 module Localized (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) (loc : I.LocalizationWitness A f) {
  L : C.Algebra = loc.1 ;
  inc : C.Hom A L = loc.2.2.1 ;
  restrict (x : C.Spec L) : C.Spec A = C.compose A L C.base x inc ;
  Support (n : Nat) (hs : Fin n -> A.ring.R) : U l =
   (a : C.Spec A) -> O.Union A n hs a -> RL[R].unit (a.1.1 f) ;
  Extended (sub : C.Spec L -> U l) : U l =
   (n : Nat) * (hs : Fin n -> A.ring.R) * Support n hs *
    ((x : C.Spec L) -> Iff (sub x) (O.Union A n hs (restrict x))) ;
  module Principal (g : L.ring.R) (w : Fr.Form A f loc g) (x : C.Spec L) {
   F : R.R = x.1.1 (inc.1.1 f) ;
   H : R.R = x.1.1 (inc.1.1 w.1) ;
   G : R.R = x.1.1 g ;
   uf : RL[R].unit F = AffineRing[l].unit-map L.ring R x.1 (inc.1.1 f) loc.2.2.2.1 ;
   power-unit : RL[R].unit (RP.power F w.2.1) = RP.Units[setR].power-unit F uf w.2.1 ;
   value : Id R.R H (R.mul (RP.power F w.2.1) G) =
    trans (ap x.1.1 w.2.2)
     (trans (x.1.2.2.2 (AffinePowers[l].Over[L.ring].power (inc.1.1 f) w.2.1) g)
      (ap (\ t -> R.mul t G) (AffinePowers[l].power-map L.ring R x.1 (inc.1.1 f) w.2.1))) ;
   product-value : Id R.R ((restrict x).1.1 (A.ring.mul w.1 f)) (R.mul H F) =
    (restrict x).1.2.2.2 w.1 f ;
   forward (u : RL[R].unit G) : RL[R].unit ((restrict x).1.1 (A.ring.mul w.1 f)) =
    Pr.subst R.R RL[R].unit _ _ (sym product-value)
     (RR.unit-product H F (Pr.subst R.R RL[R].unit _ _ (sym value) (RR.unit-product _ _ power-unit u)) uf) ;
   backward (u : RL[R].unit ((restrict x).1.1 (A.ring.mul w.1 f))) : RL[R].unit G =
    RR.unit-right (RP.power F w.2.1) G
     (Pr.subst R.R RL[R].unit _ _ value (RR.unit-left H F (Pr.subst R.R RL[R].unit _ _ product-value u))) ;
  } ;
  module Family (n : Nat) (gs : Fin n -> L.ring.R) (ws : (i : Fin n) -> Fr.Form A f loc (gs i)) {
   hs (i : Fin n) : A.ring.R = A.ring.mul (ws i).1 f ;
   support : Support n hs = \ a u ->
    Tr.Trunc[(i : Fin n) * RL[R].unit (a.1.1 (hs i))].induction @l
     (\ t -> RL[R].unit (a.1.1 f)) (\ t -> RR.unit-prop (a.1.1 f))
     (\ w -> RR.unit-right (a.1.1 (ws w.1).1) (a.1.1 f)
      (Pr.subst R.R RL[R].unit _ _ (a.1.2.2.2 (ws w.1).1 f) w.2)) u ;
   forward (x : C.Spec L) (u : O.Union L n gs x) : O.Union A n hs (restrict x) =
    Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].induction @l
     (\ t -> O.Union A n hs (restrict x))
     (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit ((restrict x).1.1 (hs i))].proposition)
     (\ w -> Tr.Trunc[(i : Fin n) * RL[R].unit ((restrict x).1.1 (hs i))].inc
      (w.1,Principal[gs w.1,ws w.1,x].forward w.2)) u ;
   backward (x : C.Spec L) (u : O.Union A n hs (restrict x)) : O.Union L n gs x =
    Tr.Trunc[(i : Fin n) * RL[R].unit ((restrict x).1.1 (hs i))].induction @l
     (\ t -> O.Union L n gs x) (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].proposition)
     (\ w -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].inc
      (w.1,Principal[gs w.1,ws w.1,x].backward w.2)) u ;
  } ;
  from-witness (sub : C.Spec L -> U l) (w : OpenWitness L sub) : Tr.Trunc[Extended sub].carrier =
   Tr.Trunc[(i : Fin w.1) -> Fr.Form A f loc (w.2.1 i)].induction @l
    (\ t -> Tr.Trunc[Extended sub].carrier) (\ t -> Tr.Trunc[Extended sub].proposition)
    (\ ws -> Tr.Trunc[Extended sub].inc
     (w.1,Family[w.1,w.2.1,ws].hs,Family[w.1,w.2.1,ws].support,
      \ x -> ((\ u -> Family[w.1,w.2.1,ws].forward x ((w.2.2 x).1 u)),
              (\ u -> (w.2.2 x).2 (Family[w.1,w.2.1,ws].backward x u)))))
    (AffineFinite[l].choice w.1 (\ i -> Fr.Form A f loc (w.2.1 i))
     (\ i -> Fr.fractions A fp f loc (w.2.1 i))) ;
  transitivity (sub : C.Spec L -> U l) (op : AffineOpen L sub) : Tr.Trunc[Extended sub].carrier =
   Tr.Trunc[OpenWitness L sub].induction @l (\ t -> Tr.Trunc[Extended sub].carrier)
    (\ t -> Tr.Trunc[Extended sub].proposition) (from-witness sub) op ;
 } ;
} ;
