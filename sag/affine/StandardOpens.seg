-- Principal opens, finite unions, and the radical-ideal criterion.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module SumMap (A B : CRing) (h : RingHom[l].Hom A B) {
 module SA = FiniteIdeal[l].Sums[A] ;
 module SB = FiniteIdeal[l].Sums[B] ;
 natural : (n : Nat) (v : Fin n -> A.R) ->
  Id B.R (h.1 (SA.sum n v)) (SB.sum n (\ i -> h.1 (v i))) = split {
   zero -> \ v -> RingHom[l].zero A B h ;
   suc n | ih -> \ v -> trans (h.2.2.1 (v (inr tt)) (SA.sum n (\ i -> v (inl i))))
    (ap (B.add (h.1 (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 combination (n : Nat) (fs v : Fin n -> A.R) :
  Id B.R (h.1 (SA.lin n fs v)) (SB.lin n (\ i -> h.1 (fs i)) (\ i -> h.1 (v i))) =
  trans (natural n (\ i -> A.mul (fs i) (v i)))
   (SB.sum-cong n (\ i -> h.1 (A.mul (fs i) (v i))) (\ i -> B.mul (h.1 (fs i)) (h.1 (v i)))
    (\ i -> h.2.2.2 (fs i) (v i))) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Q = FiniteQuotient[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 Locality : U l = Not (Id R.R R.o R.z) *
  ((a b : R.R) -> RL[R].unit (R.add a b) -> Tr.Trunc[Plus (RL[R].unit a) (RL[R].unit b)].carrier) ;
 Union (A : C.Algebra) (n : Nat) (gs : Fin n -> A.ring.R) (x : C.Spec A) : U l =
  Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].carrier ;
 Included (A : C.Algebra) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R) : U l =
  (x : C.Spec A) -> RL[R].unit (x.1.1 f) -> Union A n gs x ;
 RadicalWitness (A : C.Algebra) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R) : U l =
  (k : Nat) * FiniteIdeal[l].Over[A.ring,n,gs].Certificate (AffinePowers[l].Over[A.ring].power f k) A.ring.z ;
 Radical (A : C.Algebra) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R) : U l =
  Tr.Trunc[RadicalWitness A f n gs].carrier ;
 module Local (loc : Locality) {
  zero-unit (a : R.R) (eq : Id R.R a R.z) (u : RL[R].unit a) : Empty =
   loc.1 (trans (sym u.2) (trans (ap (\ t -> R.mul t u.1) eq) (RL[R].zero-mul u.1))) ;
  last-or-old (n : Nat) (v : Fin (suc n) -> R.R)
   (old : RL[R].unit (RS.sum n (\ i -> v (inl i))) ->
    Tr.Trunc[(i : Fin n) * RL[R].unit (v (inl i))].carrier) :
   Plus (RL[R].unit (v (inr tt))) (RL[R].unit (RS.sum n (\ i -> v (inl i)))) ->
   Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].carrier = split {
    inl u -> Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].inc (inr tt,u) ;
    inr u -> Tr.Trunc[(i : Fin n) * RL[R].unit (v (inl i))].induction @l
     (\ t -> Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].carrier)
     (\ t -> Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].proposition)
     (\ w -> Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].inc (inl w.1,w.2)) (old u) } ;
  finite-unit : (n : Nat) (v : Fin n -> R.R) -> RL[R].unit (RS.sum n v) ->
   Tr.Trunc[(i : Fin n) * RL[R].unit (v i)].carrier = split {
    zero -> \ v u -> efq (zero-unit R.z (refl R.z) u) ;
    suc n | ih -> \ v u ->
     Tr.Trunc[Plus (RL[R].unit (v (inr tt))) (RL[R].unit (RS.sum n (\ i -> v (inl i))))].induction @l
      (\ t -> Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].carrier)
      (\ t -> Tr.Trunc[(i : Fin (suc n)) * RL[R].unit (v i)].proposition)
      (last-or-old n v (ih (\ i -> v (inl i))))
      (loc.2 (v (inr tt)) (RS.sum n (\ i -> v (inl i))) u) } ;
  module At (A : C.Algebra) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R)
   (x : C.Spec A) (uf : RL[R].unit (x.1.1 f)) {
   module AS = FiniteIdeal[l].Sums[A.ring] ;
   module AP = AffinePowers[l].Over[A.ring] ;
   module RP = AffinePowers[l].Over[R] ;
   module SM = SumMap[A.ring,R,x.1] ;
   sum-eq (w : RadicalWitness A f n gs) :
    Id R.R (RP.power (x.1.1 f) w.1) (RS.lin n (\ i -> x.1.1 (gs i)) (\ i -> x.1.1 (w.2.1 i))) =
    trans (sym (AffinePowers[l].power-map A.ring R x.1 f w.1))
     (trans (ap x.1.1 w.2.2)
      (trans (x.1.2.2.1 A.ring.z (AS.lin n gs w.2.1))
       (trans (cong2 R.R R.add _ _ _ _ (RingHom[l].zero A.ring R x.1) (SM.combination n gs w.2.1))
        (RL[R].zl (RS.lin n (\ i -> x.1.1 (gs i)) (\ i -> x.1.1 (w.2.1 i))))))) ;
   from-witness (w : RadicalWitness A f n gs) : Union A n gs x =
    Tr.Trunc[(i : Fin n) * RL[R].unit (R.mul (x.1.1 (gs i)) (x.1.1 (w.2.1 i)))].induction @l
     (\ t -> Union A n gs x) (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].proposition)
     (\ u -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].inc
      (u.1,RR.unit-left (x.1.1 (gs u.1)) (x.1.1 (w.2.1 u.1)) u.2))
     (finite-unit n (\ i -> R.mul (x.1.1 (gs i)) (x.1.1 (w.2.1 i)))
      (Pr.subst R.R RL[R].unit _ _ (sum-eq w) (RP.Units[setR].power-unit (x.1.1 f) uf w.1))) ;
  } ;
  radical-to-inclusion (A : C.Algebra) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R)
   (w : Radical A f n gs) : Included A f n gs = \ x uf ->
   Tr.Trunc[RadicalWitness A f n gs].induction @l (\ t -> Union A n gs x)
    (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (gs i))].proposition)
    (At[A,f,n,gs,x,uf].from-witness) w ;
  module SAG (sqc : P.SQC) {
   module Nil = LocalizationNilpotence[l].Over[R,setR].SAG[sqc,loc.1] ;
   module AtQuotient (A : C.Algebra) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R)
    (included : Included A f n gs) (q : Q.Witness A n gs) {
    inc : C.Hom A q.1 = q.2.2.1 ;
    module AP = AffinePowers[l].Over[A.ring] ;
    module QP = AffinePowers[l].Over[q.1.ring] ;
    empty (x : I.D q.1 (inc.1.1 f)) : Empty =
     Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1.1 (inc.1.1 (gs i)))].induction @l
      (\ t -> Empty) (\ t -> \ a b -> efq a)
      (\ u -> zero-unit (x.1.1.1 (inc.1.1 (gs u.1)))
       (trans (ap x.1.1.1 (q.2.2.2.1 u.1)) (RingHom[l].zero q.1.ring R x.1.1)) u.2)
      (included (C.compose A q.1 C.base x.1 inc) x.2) ;
    nilpotent : QP.Nilpotent (inc.1.1 f) =
     Nil.empty-to-nilpotent q.1 q.2.1 (inc.1.1 f) empty ;
    from-exponent (w : (k : Nat) * Id q.1.ring.R (QP.power (inc.1.1 f) k) q.1.ring.z) : Radical A f n gs =
     Tr.Trunc[FiniteIdeal[l].Over[A.ring,n,gs].Certificate (AP.power f w.1) A.ring.z].induction @l
      (\ t -> Radical A f n gs) (\ t -> Tr.Trunc[RadicalWitness A f n gs].proposition)
      (\ c -> Tr.Trunc[RadicalWitness A f n gs].inc (w.1,c))
      (QuotientCertificate[l].Over[R,setR].At[A,n,gs,q].kernel (AP.power f w.1)
       (trans (AffinePowers[l].power-map A.ring q.1.ring inc.1 f w.1) w.2)) ;
    result : Radical A f n gs =
     Tr.Trunc[(k : Nat) * Id q.1.ring.R (QP.power (inc.1.1 f) k) q.1.ring.z].induction @l
      (\ t -> Radical A f n gs) (\ t -> Tr.Trunc[RadicalWitness A f n gs].proposition)
      from-exponent nilpotent ;
   } ;
   inclusion-to-radical (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) (n : Nat) (gs : Fin n -> A.ring.R)
    (included : Included A f n gs) : Radical A f n gs =
    Tr1.Trunc[Q.Witness A n gs].induction @l (\ t -> Radical A f n gs)
     (\ t -> Tr.Trunc[RadicalWitness A f n gs].proposition)
     (\ q -> AtQuotient[A,f,n,gs,included,q].result) (Q.quotient A fp n gs) ;
  } ;
 } ;
} ;
