-- Every element of a finitely presented localization is merely a/f^n.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Arithmetic (A B : CRing) (setB : Pr.isSet B.R) (h : RingHom[l].Hom A B) (f : A.R) {
 module AP = AffinePowers[l].Over[A] ;
 module BP = AffinePowers[l].Over[B] ;
 module BR = AffineRing[l].Laws[B,setB] ;
 F : B.R = h.1 f ;
 Form (x : B.R) : U l = (a : A.R) * (n : Nat) * Id B.R (h.1 a) (B.mul (BP.power F n) x) ;
 atom (a : A.R) : Form (h.1 a) = (a,zero,sym (BP.one-left (h.1 a))) ;
 multiply (x y : B.R) (u : Form x) (v : Form y) : Form (B.mul x y) =
  (A.mul u.1 v.1,plus u.2.1 v.2.1,
   trans (h.2.2.2 u.1 v.1)
    (trans (cong2 B.R B.mul _ _ _ _ u.2.2 v.2.2)
     (trans (BR.mul-four (BP.power F u.2.1) x (BP.power F v.2.1) y)
      (ap (\ t -> B.mul t (B.mul x y)) (sym (BP.power-add F u.2.1 v.2.1)))))) ;
 times-power (m n : Nat) (x : B.R) :
  Id B.R (B.mul (BP.power F m) (B.mul (BP.power F n) x)) (B.mul (BP.power F (plus m n)) x) =
  trans (B.mulA (BP.power F m) (BP.power F n) x)
   (ap (\ t -> B.mul t x) (sym (BP.power-add F m n))) ;
 add (x y : B.R) (u : Form x) (v : Form y) : Form (B.add x y) =
  (A.add (A.mul (AP.power f v.2.1) u.1) (A.mul (AP.power f u.2.1) v.1),plus u.2.1 v.2.1,
   trans (h.2.2.1 _ _)
    (trans (cong2 B.R B.add _ _ _ _
      (trans (h.2.2.2 (AP.power f v.2.1) u.1)
       (trans (cong2 B.R B.mul _ _ _ _ (AffinePowers[l].power-map A B h f v.2.1) u.2.2)
        (trans (times-power v.2.1 u.2.1 x)
         (ap (\ n -> B.mul (BP.power F n) x) (plus-comm v.2.1 u.2.1)))))
      (trans (h.2.2.2 (AP.power f u.2.1) v.1)
       (trans (cong2 B.R B.mul _ _ _ _ (AffinePowers[l].power-map A B h f u.2.1) v.2.2)
        (times-power u.2.1 v.2.1 y))))
     (sym (B.dist (BP.power F (plus u.2.1 v.2.1)) x y)))) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 Form (A : C.Algebra) (f : A.ring.R) (loc : I.LocalizationWitness A f) (x : loc.1.ring.R) : U l =
  Arithmetic[A.ring,loc.1.ring,loc.1.set,loc.2.2.1.1,f].Form x ;
 Fraction (A : C.Algebra) (f : A.ring.R) (loc : I.LocalizationWitness A f) (x : loc.1.ring.R) : U l =
  Tr.Trunc[Form A f loc x].carrier ;
 module Presented (A : C.Algebra) (p : P.Presentation) (pa : P.Presents p A)
  (f : A.ring.R) (e : P.Expr (Fin p.1)) (rep : Id A.ring.R (P.eval (Fin p.1) A pa.1.1 e) f) {
  module S = I.Presented[A,p,pa,f,e,rep] ;
  module L = S.L ;
  module Ar = Arithmetic[A.ring,L.algebra.ring,L.algebra.set,L.inclusion.1,f] ;
  V : U l = Fin p.1 ;
  W : U l = Fin (suc p.1) ;
  ev : P.Expr W -> L.algebra.ring.R = P.eval W L.algebra L.K.A.generators ;
  variable : (v : W) -> Ar.Form (L.K.A.generators v) = split {
   inl v -> (pa.1.1 v,zero,trans (L.Canonical[L.algebra].inclusion-gen v)
    (sym (Ar.BP.one-left (L.K.A.generators (inl v))))) ;
   inr t -> (A.ring.o,suc zero,
    trans L.inclusion.1.2.1
     (trans (sym L.inverse.2)
      (cong2 L.algebra.ring.R L.algebra.ring.mul _ _ _ _
       (sym (L.algebra.ring.mulO (L.inclusion.1.1 f)))
       (Pr.ap W L.algebra.ring.R L.K.A.generators (inr tt) (inr t) (Pr.ap Top W (\ u -> inr u) tt t (P.top-prop tt t)))))) } ;
  fraction-term : (t : P.Expr W) -> Ar.Form (ev t) = split {
   var v -> variable v ;
   cst r -> (A.iota.1 r,zero,trans (L.inclusion.2 r) (sym (Ar.BP.one-left (L.algebra.iota.1 r)))) ;
   sumE a b | ra rb -> Ar.add (ev a) (ev b) ra rb ;
   mulE a b | ra rb -> Ar.multiply (ev a) (ev b) ra rb } ;
  fractions (x : L.algebra.ring.R) : Fraction A f S.result x =
   L.K.A.Q.induction @l (\ x -> Fraction A f S.result x) (\ x -> Tr.Trunc[Form A f S.result x].proposition)
    (\ t -> Tr.Trunc[Form A f S.result (L.K.A.include t)].inc
     (Pr.subst L.algebra.ring.R Ar.Form _ _ (L.K.A.reify t) (fraction-term t))) x ;
  module In (loc : I.LocalizationWitness A f) {
   module E = LocalizationComparison[l].Over[R,setR,A,f,S.result,loc] ;
   module SrcP = AffinePowers[l].Over[L.algebra.ring] ;
   module DstP = AffinePowers[l].Over[loc.1.ring] ;
   transfer (x : L.algebra.ring.R) (w : Form A f S.result x) : Form A f loc (E.forward.1.1 x) =
    (w.1,w.2.1,
     trans (sym (E.To[S.result,loc].beta w.1))
      (trans (ap E.forward.1.1 w.2.2)
       (trans (E.forward.1.2.2.2 (SrcP.power (L.inclusion.1.1 f) w.2.1) x)
        (ap (\ t -> loc.1.ring.mul t (E.forward.1.1 x))
         (trans (AffinePowers[l].power-map L.algebra.ring loc.1.ring E.forward.1 (L.inclusion.1.1 f) w.2.1)
          (ap (\ t -> DstP.power t w.2.1) (E.To[S.result,loc].beta f))))))) ;
   result (x : loc.1.ring.R) : Fraction A f loc x =
    Tr.Trunc[Form A f S.result (E.backward.1.1 x)].induction @l
     (\ t -> Fraction A f loc x) (\ t -> Tr.Trunc[Form A f loc x].proposition)
     (\ w -> Tr.Trunc[Form A f loc x].inc
      (Pr.subst loc.1.ring.R (Form A f loc) _ _ (E.fb x) (transfer (E.backward.1.1 x) w)))
     (fractions (E.backward.1.1 x)) ;
  } ;
 } ;
 fractions (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) (loc : I.LocalizationWitness A f) (x : loc.1.ring.R) :
  Fraction A f loc x =
  Tr1.Trunc[P.Witness A].induction @l (\ t -> Fraction A f loc x)
   (\ t -> Tr.Trunc[Form A f loc x].proposition)
   (\ w -> Tr.Trunc[AffineGenerated[l].Over[R,setR,A,w.1,w.2].Rep f].induction @l
    (\ t -> Fraction A f loc x) (\ t -> Tr.Trunc[Form A f loc x].proposition)
    (\ e -> Presented[A,w.1,w.2,f,e.1,e.2].In[loc].result x)
    (AffineGenerated[l].Over[R,setR,A,w.1,w.2].generated f)) fp ;
} ;
