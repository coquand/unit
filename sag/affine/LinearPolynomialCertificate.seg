-- Pure coefficient calculation: if (f*Y-1)q is the constant a,
-- then f^(length q)*a=0. No division and no decidable equality.
level l ; open Ring[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module Raw = Poly[l].PolyR[A] ; open Raw ;
 module M = Mul[l].MulR[A] ; open M ;
 module Pow = AffinePowers[l].Over[A] ;
 linear (f : R) : P = cons (neg o) (cons f nil) ;
 negate-one (b : R) : Id R (mul b (neg o)) (neg b) =
  trans (mul-neg b o) (ap neg (mulO b)) ;
 head (f b : R) (q : P) (a : R) (h : peq (pmul (linear f) (cons b q)) (cons a nil)) :
  Id R (neg b) a =
  trans (sym (trans (ap (\ t -> add t z) (negate-one b)) (addZ (neg b)))) (h zero) ;
 tail0 (f b : R) (q : P) (a : R) (h : peq (pmul (linear f) (cons b q)) (cons a nil)) :
  Id R (coef (pmul (linear f) q) zero) (mul f a) = calc R {
  coef (pmul (linear f) q) zero
   =< neg-uniq (mul b f) (coef (pmul (linear f) q) zero)
    (trans (sym (coef-addP (cons (mul b f) nil) (pmul (linear f) q) zero)) (h (suc zero)))
   > neg (mul b f)
   =< ap neg (mulC b f) > neg (mul f b)
   =< sym (mul-neg f b) > mul f (neg b)
   =< ap (mul f) (head f b q a h) > mul f a } ;
 tail (f b : R) (q : P) (a : R) (h : peq (pmul (linear f) (cons b q)) (cons a nil)) :
  peq (pmul (linear f) q) (cons (mul f a) nil) = split {
   zero -> tail0 f b q a h ;
   suc k -> trans (sym (zl (coef (pmul (linear f) q) (suc k))))
    (trans (sym (coef-addP (cons (mul b f) nil) (pmul (linear f) q) (suc k))) (h (suc (suc k)))) } ;
 annihilate (f : R) : (q : P) (a : R) -> peq (pmul (linear f) q) (cons a nil) ->
  Id R (mul (Pow.power f (len {R} q)) a) z = split {
   nil -> \ a h -> trans (Pow.one-left a) (sym (h zero)) ;
   cons b q | ih -> \ a h -> trans (Pow.power-commute f (len {R} q) a) (ih (mul f a) (tail f b q a h)) } ;
 inverse-nilpotent (f : R) (q : P) (h : peq (pmul (linear f) q) (cons o nil)) :
  Id R (Pow.power f (len {R} q)) z =
  trans (sym (mulO (Pow.power f (len {R} q)))) (annihilate f q o h) ;
} ;
