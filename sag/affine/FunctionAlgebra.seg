level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 spec-set (A : C.Algebra) : Pr.isSet (C.Spec A) =
  Pr.isSet-Sigma (RingHom[l].Hom A.ring R) (C.Commutes A C.base)
   (RingHom[l].Properties[A.ring,R,setR].set)
   (\ h -> Pr.prop-to-set (C.Commutes A C.base h) (C.commutes-prop A C.base h)) ;
 module At (X : U l) {
  Carrier : U l = X -> R.R ;
  set : Pr.isSet Carrier = F.isSet-Pi X (\ x -> R.R) (\ x -> setR) ;
  constant (r : R.R) : Carrier = \ x -> r ;
  add (f g : Carrier) : Carrier = \ x -> R.add (f x) (g x) ;
  mul (f g : Carrier) : Carrier = \ x -> R.mul (f x) (g x) ;
  neg (f : Carrier) : Carrier = \ x -> R.neg (f x) ;
  ext (f g : Carrier) (h : (x : X) -> Id R.R (f x) (g x)) : Id Carrier f g =
   F.funext X (\ x -> R.R) f g h ;
  ring : CRing = mkCRing Carrier (constant R.z) (constant R.o) add mul neg
   (\ f g h -> ext _ _ (\ x -> R.addA (f x) (g x) (h x)))
   (\ f g -> ext _ _ (\ x -> R.addC (f x) (g x)))
   (\ f -> ext _ _ (\ x -> R.addZ (f x)))
   (\ f -> ext _ _ (\ x -> R.addN (f x)))
   (\ f g h -> ext _ _ (\ x -> R.mulA (f x) (g x) (h x)))
   (\ f g -> ext _ _ (\ x -> R.mulC (f x) (g x)))
   (\ f -> ext _ _ (\ x -> R.mulO (f x)))
   (\ f g h -> ext _ _ (\ x -> R.dist (f x) (g x) (h x))) ;
  iota : RingHom[l].Hom R ring =
   (constant,refl (constant R.o),\ a b -> refl (constant (R.add a b)),\ a b -> refl (constant (R.mul a b))) ;
  algebra : C.Algebra = C.mkAlgebra ring set iota ;
  point (x : X) : C.Spec algebra =
   ((\ f -> f x,refl R.o,\ f g -> refl (R.add (f x) (g x)),\ f g -> refl (R.mul (f x) (g x))),
    \ r -> refl r) ;
 } ;
 evaluation (A : C.Algebra) : C.Hom A At[C.Spec A].algebra =
  ((C.evaluation A,
    At[C.Spec A].ext _ _ (\ x -> x.1.2.1),
    \ a b -> At[C.Spec A].ext _ _ (\ x -> x.1.2.2.1 a b),
    \ a b -> At[C.Spec A].ext _ _ (\ x -> x.1.2.2.2 a b)),
   \ r -> At[C.Spec A].ext _ _ (\ x -> x.2 r)) ;
 AffineWitness (X : U l) : U l+ =
  (A : C.Algebra) * P.FP A * Pr.Equiv X (C.Spec A) ;
 Affine (X : U l) : U l+ = Tr1.Trunc[AffineWitness X].carrier ;
 module SAG (sqc : P.SQC) {
  module Spectrum (A : C.Algebra) (fp : P.FP A) {
   module AX = At[C.Spec A] ;
   back (y : C.Spec AX.algebra) : C.Spec A = C.compose A AX.algebra C.base y (evaluation A) ;
   fb (y : C.Spec AX.algebra) : Id (C.Spec AX.algebra) (AX.point (back y)) y =
    C.ext AX.algebra C.base _ _ (\ g ->
     trans (sym (Pr.happly (C.Spec A) (\ x -> R.R) _ _ ((sqc A fp).sec-eq g) (back y)))
      (ap y.1.1 ((sqc A fp).sec-eq g))) ;
   bf (x : C.Spec A) : Id (C.Spec A) (back (AX.point x)) x =
    C.ext A C.base _ _ (\ a -> refl (x.1.1 a)) ;
   recovery : Pr.isEquiv (C.Spec A) (C.Spec AX.algebra) AX.point =
    Pr.qinv _ _ AX.point back fb bf ;
  } ;
  Recovery (X : U l) : U l = Pr.isEquiv X (C.Spec At[X].algebra) At[X].point ;
  from-witness (X : U l) (w : AffineWitness X) : Recovery X =
   Hi.subst (U l) (\ Y -> Recovery Y) (C.Spec w.1) X
    (Hi.sym (U l) X (C.Spec w.1) (Axioms[l].UnivalenceLemmas[univ @l].ua X (C.Spec w.1) w.2.2))
    (Spectrum[w.1,w.2.1].recovery) ;
  recover (X : U l) (affine : Affine X) : Recovery X =
   AffineHLevels[l].Fibres[X,C.Spec At[X].algebra,spec-set At[X].algebra,At[X].point].to-equiv
    (\ y -> Tr1.Trunc[AffineWitness X].induction @l
     (\ t -> FunExtUA[l].isContr ((x : X) * Id (C.Spec At[X].algebra) (At[X].point x) y))
     (\ t -> AffineHLevels[l].contr-prop _)
     (\ w -> AffineHLevels[l].Fibres[X,C.Spec At[X].algebra,spec-set At[X].algebra,At[X].point].from-equiv
      (from-witness X w) y) affine) ;
  equivalence (X : U l) (affine : Affine X) : Pr.Equiv X (C.Spec At[X].algebra) =
   (At[X].point,recover X affine) ;
 } ;
} ;
