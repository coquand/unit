-- Subtypes, the nonzero description of affine opens, and the
-- direct-image form of transitivity (SAG 3.1.5 and 3.1.7).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module OT = OpenTransitivity[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 Subtype (X : U l) : U l+ = X -> (Q : U l) * Pr.isProp Q ;
 IsOpen (A : C.Algebra) (sub : Subtype (C.Spec A)) : U l =
  OT.AffineOpen A (\ x -> (sub x).1) ;
 NonzeroUnion (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (x : C.Spec A) : U l =
  Tr.Trunc[(i : Fin n) * Not (Id R.R (x.1.1 (fs i)) R.z)].carrier ;
 module SAG (sqc : P.SQC) (one-nz : Not (Id R.R R.o R.z)) {
  module Uts = AffineUnits[l].Over[R,setR,sqc,one-nz] ;
  nonzero-to-union (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (x : C.Spec A) :
   NonzeroUnion A n fs x -> O.Union A n fs x =
   Tr.Trunc[(i : Fin n) * Not (Id R.R (x.1.1 (fs i)) R.z)].induction @l
    (\ t -> O.Union A n fs x) (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (fs i))].proposition)
    (\ w -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (fs i))].inc
     (w.1,Uts.nonzero-unit (x.1.1 (fs w.1)) w.2)) ;
  union-to-nonzero (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (x : C.Spec A) :
   O.Union A n fs x -> NonzeroUnion A n fs x =
   Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (fs i))].induction @l
    (\ t -> NonzeroUnion A n fs x)
    (\ t -> Tr.Trunc[(i : Fin n) * Not (Id R.R (x.1.1 (fs i)) R.z)].proposition)
    (\ w -> Tr.Trunc[(i : Fin n) * Not (Id R.R (x.1.1 (fs i)) R.z)].inc
     (w.1,Uts.unit-nonzero (x.1.1 (fs w.1)) w.2)) ;
  NonzeroWitness (A : C.Algebra) (sub : C.Spec A -> U l) : U l =
   (n : Nat) * (fs : Fin n -> A.ring.R) *
    ((x : C.Spec A) -> OT.Iff (sub x) (NonzeroUnion A n fs x)) ;
  characterization-forward (A : C.Algebra) (sub : C.Spec A -> U l) :
   OT.AffineOpen A sub -> Tr.Trunc[NonzeroWitness A sub].carrier =
   Tr.Trunc[OT.OpenWitness A sub].induction @l
    (\ t -> Tr.Trunc[NonzeroWitness A sub].carrier) (\ t -> Tr.Trunc[NonzeroWitness A sub].proposition)
    (\ w -> Tr.Trunc[NonzeroWitness A sub].inc
     (w.1,w.2.1,\ x -> ((\ u -> union-to-nonzero A w.1 w.2.1 x ((w.2.2 x).1 u)),
                        (\ u -> (w.2.2 x).2 (nonzero-to-union A w.1 w.2.1 x u))))) ;
  characterization-backward (A : C.Algebra) (sub : C.Spec A -> U l) :
   Tr.Trunc[NonzeroWitness A sub].carrier -> OT.AffineOpen A sub =
   Tr.Trunc[NonzeroWitness A sub].induction @l
    (\ t -> OT.AffineOpen A sub) (\ t -> Tr.Trunc[OT.OpenWitness A sub].proposition)
    (\ w -> Tr.Trunc[OT.OpenWitness A sub].inc
     (w.1,w.2.1,\ x -> ((\ u -> nonzero-to-union A w.1 w.2.1 x ((w.2.2 x).1 u)),
                        (\ u -> (w.2.2 x).2 (union-to-nonzero A w.1 w.2.1 x u))))) ;
 } ;
 module Localized (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) (loc : I.LocalizationWitness A f)
  (sub : C.Spec loc.1 -> U l) {
  module L = OT.Localized[A,fp,f,loc] ;
  spectrum : Pr.Equiv (C.Spec loc.1) (I.D A f) = I.spectrum A f loc ;
  Fibre (a : C.Spec A) : U l =
   (x : C.Spec loc.1) * sub x * Id (C.Spec A) (L.restrict x) a ;
  image (a : C.Spec A) : U l = Tr.Trunc[Fibre a].carrier ;
  module Extended (w : L.Extended sub) {
   forward (a : C.Spec A) : image a -> O.Union A w.1 w.2.1 a =
    Tr.Trunc[Fibre a].induction @l
     (\ t -> O.Union A w.1 w.2.1 a)
     (\ t -> Tr.Trunc[(i : Fin w.1) * RL[R].unit (a.1.1 (w.2.1 i))].proposition)
     (\ v -> Pr.subst (C.Spec A) (O.Union A w.1 w.2.1) _ _ v.2.2 ((w.2.2.2 v.1).1 v.2.1)) ;
   module Back (a : C.Spec A) (u : O.Union A w.1 w.2.1 a) {
    d : I.D A f = (a,w.2.2.1 a u) ;
    x : C.Spec loc.1 = spectrum.2.sec d ;
    beta : Id (C.Spec A) (L.restrict x) a = ap (\ d -> d.1) (spectrum.2.sec-eq d) ;
    result : image a = Tr.Trunc[Fibre a].inc
     (x,(w.2.2.2 x).2 (Pr.subst (C.Spec A) (O.Union A w.1 w.2.1) a (L.restrict x) (sym beta) u),beta) ;
   } ;
   result : OT.OpenWitness A image = (w.1,w.2.1,\ a -> (forward a,\ u -> Back[a,u].result)) ;
  } ;
  transitivity (op : OT.AffineOpen loc.1 sub) : OT.AffineOpen A image =
   Tr.Trunc[L.Extended sub].induction @l (\ t -> OT.AffineOpen A image)
    (\ t -> Tr.Trunc[OT.OpenWitness A image].proposition)
    (\ w -> Tr.Trunc[OT.OpenWitness A image].inc Extended[w].result) (L.transitivity sub op) ;
  image-subtype : Subtype (C.Spec A) = \ a -> (image a,Tr.Trunc[Fibre a].proposition) ;
 } ;
} ;
