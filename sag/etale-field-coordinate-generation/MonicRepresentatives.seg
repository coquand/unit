-- Every element of the concrete monic quotient has an actual coefficient
-- list, obtained from its canonical remainder coordinates. Evaluation
-- of that list after any algebra map is the image of the element.
-- The two definitional boundaries of EtaleBasis.expansion are exposed
-- once; all later uses are through the named reconstruction lemma.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module HornerMap (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra) (x : S.ring.R)
 (f : RingHom[l].Hom (PolynomialRing[l].Extension[k,setk].ring) S.ring)
 (constants : (a : k.R) -> Id S.ring.R (f.1 (PolynomialRing[l].Extension[k,setk].constant a)) (S.iota.1 a))
 (variable : Id S.ring.R (f.1 PolynomialRing[l].Extension[k,setk].variable) x) {
 module P = PolynomialRing[l].Extension[k,setk] ; module Ho = MonicReduce[l].Horner[k,S.ring,S.iota,x] ;
 equation : (p : List k.R) -> Id S.ring.R (f.1 (P.include p)) (Ho.horner p) = split {
  nil -> RingHom[l].zero P.ring S.ring f ;
  cons a p | ih -> trans (ap f.1 (P.horner a p))
   (trans (f.2.2.1 (P.constant a) (P.mulQ P.variable (P.include p)))
    (cong2 S.ring.R S.ring.add _ _ _ _ (constants a)
     (trans (f.2.2.2 P.variable (P.include p)) (cong2 S.ring.R S.ring.mul _ _ _ _ variable ih)))) } ;
} ;
module Over (k : CRing) (setk : Pr.isSet k.R) (lower : List k.R) {
 module C = Algebras[l].Over[k,setk] ; module M = MonicBasisUniversal[l].Over[k,setk].At[lower] ;
 module P = PolynomialRing[l].Extension[k,setk] ; module ET = EtaleTopology[l].Over[k,setk] ;
 Q : C.Algebra = M.Q ;
 representative (a : Q.ring.R) : List k.R = ET.coefficients M.degree (M.B.coords a) ;
 transparent M.B.V.expansion ;
 included (a : Q.ring.R) : Id P.Carrier (P.include (representative a)) (M.B.V.expansion M.degree (M.B.coords a)) =
  refl (P.include (representative a)) ;
 opaque M.B.V.expansion ;
 transparent M.B.expansion ;
 expansion (a : Q.ring.R) : Id Q.ring.R (M.B.quotient-map.1.1 (M.B.V.expansion M.degree (M.B.coords a)))
  (M.B.expansion (M.B.coords a)) = refl (M.B.expansion (M.B.coords a)) ;
 opaque M.B.expansion ;
 reconstruction (a : Q.ring.R) : Id Q.ring.R (M.B.quotient-map.1.1 (P.include (representative a))) a =
  trans (ap M.B.quotient-map.1.1 (included a)) (trans (expansion a) (M.B.expansion-coords a)) ;
 module Map (S : C.Algebra) (h : C.Hom Q S) {
  x : S.ring.R = h.1.1 M.x ;
  composite : RingHom[l].Hom P.ring S.ring = RingHom[l].compose P.ring Q.ring S.ring h.1 M.B.quotient-map.1 ;
  constants (a : k.R) : Id S.ring.R (composite.1 (P.constant a)) (S.iota.1 a) =
   trans (ap h.1.1 (M.B.quotient-map.2 a)) (h.2 a) ;
  variable : Id S.ring.R (composite.1 P.variable) x = ap h.1.1 (M.B.value-equation (var (inr tt))) ;
  module Ho = HornerMap[k,setk,S,x,composite,constants,variable] ;
  value (a : Q.ring.R) : Id S.ring.R (Ho.Ho.horner (representative a)) (h.1.1 a) =
   trans (sym (Ho.equation (representative a))) (ap h.1.1 (reconstruction a)) ;
 } ;
} ;
