-- Exercise both the coordinate argument and the corner-polynomial
-- wrapper. The nontrivial corner is the first factor of the minimal
-- quotient modelling F2 x F2; its unit differs from the ambient unit.
level l ; open Ring[l] ; open Presentations[l] ;
module R = PrimitiveRegression[l] ; module Pr = Prelude[l] ;
module CA = Algebras[l].Over[R.A,R.setA] ;
coordinate (i : Fin R.one) (a : R.Pair) : Id R.Pair a (R.A.mul R.o a) = sym (R.L.one-left a) ;
module Basic = CoordinateGeneration[l].Over[R.A,R.setA,CA.base,R.one,R.AB.frame,R.q,coordinate] ;
witness : Basic.R.Witness Basic.a = (R.o,refl R.o) ;
module Chosen = Basic.Witness[witness] ;
computed-idempotent : Id R.Pair Chosen.result.e R.o = refl R.o ;
identity (a : R.Pair) : Id R.Pair (CA.base.iota.1 (Chosen.result.preimage a))
 (R.A.mul (CA.base.iota.1 Chosen.result.e) a) = Chosen.result.equation a ;
-- The concrete monic quotient, with its existing injective map to pairs.
module I = R.Injection ; module M = I.M ;
Q : Algebras[l].Over[R.k,R.B.bool-set].Algebra = I.Q ;
module CQ = Algebras[l].Over[R.k,R.B.bool-set] ;
e : Q.ring.R = M.x ;
he : Id Q.ring.R (Q.ring.mul e e) e = I.injective _ _
 (trans (I.hom.1.2.2.2 e e)
  (trans (cong2 R.Pair R.A.mul _ _ _ _ I.beta I.beta)
   (trans (R.idem (true,false)) (sym I.beta)))) ;
q : PrimeIdempotents[l].Over[Q.ring].Prime = I.Prime[R.q].theorem ;
outside : Not (q.ideal.In e) = \ h -> R.nonzero
 (trans (sym (ap (\ a -> a.1) I.beta)) h) ;
module G = MonicCoordinateGeneration[l].Over[R.k,R.B.bool-set,R.minimal.lower,Q,CQ.identity Q,e,he,q,outside] ;
module BF = G.Part.BaseFactor ; module TF = G.Part.AlgebraFactor ;
coordinate-vector (a : TF.Carrier) (i : Fin R.one) : BF.Carrier = (a.1,a.2) ;
coordinate-add (a b : TF.Carrier) (i : Fin R.one) : Id BF.Carrier
 (coordinate-vector (TF.add a b) i) (BF.add (coordinate-vector a i) (coordinate-vector b i)) = BF.eq _ _ (refl (Q.ring.add a.1 b.1)) ;
coordinate-scale (r : BF.Carrier) (a : TF.Carrier) (i : Fin R.one) : Id BF.Carrier
 (coordinate-vector (TF.mul (G.Part.iota.1 r) a) i) (BF.mul r (coordinate-vector a i)) = BF.eq _ _ (refl (Q.ring.mul r.1 a.1)) ;
module Sum = FiniteIdeal[l].Sums[TF.ring] ; module DL = MnSums[l].Over[BF.ring] ;
delta-one (i j : Fin R.one) : Id BF.Carrier (DL.delta R.one i j) BF.one =
 trans (ap (\ t -> DL.delta R.one t j) (R.one-index i)) (ap (DL.delta R.one (inr tt)) (R.one-index j)) ;
reconstruction (a : TF.Carrier) : Id TF.Carrier
 (Sum.sum R.one (\ i -> TF.mul (G.Part.iota.1 (coordinate-vector a i)) TF.one)) a =
 trans (TF.ring.addZ (TF.mul (G.Part.iota.1 (coordinate-vector a (inr tt))) TF.one))
  (trans (TF.ring.mulO (G.Part.iota.1 (coordinate-vector a (inr tt)))) (TF.eq _ _ (refl a.1))) ;
basis : TraceBasis[l].Over[BF.ring,BF.set,G.Part.algebra].Basis[R.one] =
 TraceBasis[l].Over[BF.ring,BF.set,G.Part.algebra].mkBasis R.one (\ i -> TF.one) coordinate-vector
  coordinate-add coordinate-scale reconstruction
  (\ j i -> trans (BF.eq _ _ (refl e)) (sym (delta-one i j))) ;
equations (i : Fin R.one) (a : TF.Carrier) : Id TF.Carrier
 (G.Part.iota.1 (basis.coordinate a i)) (TF.mul (G.Part.iota.1 (basis.coordinate TF.one i)) a) =
 TF.eq _ _ (sym a.2) ;
module Apply = G.At[R.one,basis,equations] ;
regular-witness : Apply.G.R.Witness Apply.G.a =
 (BF.one,BF.eq _ _ (sym (trans (ap (\ a -> Q.ring.mul a e) he) he))) ;
module Pick = Apply.G.Witness[regular-witness] ;
module Full = Apply.Chosen[Pick.result] ;
result : G.Result = Full.theorem ;
selected-unit : Id Q.ring.R result.value e = he ;
outside-factor : Not (q.ideal.In result.value) = result.outside ;
polynomial-for-generator : Id Q.ring.R
 (Q.ring.mul result.value (Q.ring.add e (Q.ring.neg (G.EvalMap.Ho.Ho.horner (result.representative e))))) Q.ring.z = result.equation e ;
general-existence : Truncation[l].Trunc[G.Result].carrier = Apply.theorem I.Reduced[R.reduced].regular ;
