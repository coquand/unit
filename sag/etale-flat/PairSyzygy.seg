-- The syzygies of a regular pair, modulo an ideal I (handoff §5, (Syz)).
--
-- Let f be regular modulo I (f s in I gives s in I) and g regular modulo
-- (f) + I (g v in (f) + I gives v in (f) + I).  If f u + g v is in I, then
-- merely there is w with u - g w and v + f w in I.
-- Proof: g v = (f u + g v) - f u is in (f) + I, so v - f t is in I for some
-- t; then f (u + g t) = (f u + g v) - g (v - f t) is in I, so u + g t is in
-- I; take w = -t.  No division, no decidability; with I = 0 this is (Syz).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (C : CRing) (I : RegularIdeal[l].IdealPred[C]) (f g : C.R) {
 module IL = RegularIdeal[l].IdealLaws[C,I] ;
 module EI = EtaleIdentities[l] ;
 -- x is in (f) + I, with the multiple of f
 Mod (x : C.R) : U l = (t : C.R) * I.In (C.add x (C.neg (C.mul f t))) ;
 RegularF : U l = (s : C.R) -> I.In (C.mul f s) -> I.In s ;
 RegularG : U l = (v t : C.R) -> I.In (C.add (C.mul g v) (C.neg (C.mul f t))) -> Tr.Trunc[Mod v].carrier ;
 Syzygy (u v : C.R) : U l = (w : C.R) * I.In (C.add u (C.neg (C.mul g w))) * I.In (C.add v (C.mul f w)) ;
 module Solve (regF : RegularF) (regG : RegularG) (u v : C.R) (h : I.In (C.add (C.mul f u) (C.mul g v))) {
  -- g v - f (-u) = f u + g v
  first : Tr.Trunc[Mod v].carrier =
   regG v (C.neg u) (IL.in-eq _ _ (sym EI.SyzStart[C,f,g,u,v].proof) h) ;
  module With (m : Mod v) {
   -- f (u + g t) = (f u + g v) - g (v - f t)
   killed : I.In (C.add u (C.mul g m.1)) =
    regF (C.add u (C.mul g m.1))
     (IL.in-eq _ _ EI.SyzKill[C,f,g,u,v,m.1].proof
      (IL.in-sub _ _ h (I.in-mul g (C.add v (C.neg (C.mul f m.1))) m.2))) ;
   result : Syzygy u v =
    (C.neg m.1,IL.in-eq _ _ EI.SyzFirst[C,g,u,m.1].proof killed,
     IL.in-eq _ _ EI.SyzSecond[C,f,v,m.1].proof m.2) ;
  } ;
  result : Tr.Trunc[Syzygy u v].carrier = TC.map (Mod v) (Syzygy u v) (\ m -> With[m].result) first ;
 } ;
} ;
