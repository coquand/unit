-- Regularity of (F, G) in S = A[X,Y][1/J] modulo (a_1..a_m)S, for a
-- noetherian A (handoff §3, both assertions, with denominators explicit).
--
-- E1 = S/(a) and E2 = S/(a, F); J is invertible in both.  The last step of
-- the Taylor argument, "on the curve the identity forces P(x0,y0) = 0", is a
-- parameter (First.Zero, Second.Zero): Noetherian proves it from Calculus
-- (E1, E2 noetherian: two polynomial extensions, a localization, a quotient;
-- stable annihilators), RegularCoded with no hypothesis (coded subrings).
-- F regular modulo (a):  let f s be in (a)S with s = u^d p, p in R.  Then
-- F p is in (a)S, so J^k F p = sum_i a_i Q_i in R (LocalizedReduction).
-- In E1 take N with f stable at N and the curve of TaylorTargets:
-- F = f - T below degree N+1.  The identity F (J^k p) = sum_i a_i Q_i holds
-- on the curve, where the a_i vanish (RegularPolynomial.alone), so
-- J^k p = 0 in E1 (Deformed), hence p = 0 in E1, i.e. p and s are in (a)S.
-- G regular modulo (F) + (a):  let g v - f t be in (a)S, v = u^d p.  Then
-- G p is in (a, F)S, so J^k G p = F W + sum_i a_i Q_i in R.  In E2, F is 0
-- at (x0,y0), so TaylorLift with the roles of F and G exchanged applies
-- (Jacobian -J): G = g - T and F = 0 below degree N+1.  On the curve the
-- identity gives G (J^k p) = 0 below degree N+1 (RegularPolynomial.with),
-- so J^k p = 0 in E2, hence p is in (a, F)S: p = f c + sum_i a_i c_i, and
-- v - f (u^d c) is in (a)S.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
-- ring maps send units to units
unit-map (B C : CRing) (h : RingHom[l].Hom B C) (x : B.R) (w : RL[B].unit x) : RL[C].unit (h.1 x) =
 (h.1 w.1,trans (sym (h.2.2.2 x w.1)) (trans (ap h.1 w.2) h.2.1)) ;
module Over (A : CRing) (setA : Pr.isSet A.R) (F G : Bivariate[l].Over[A].Expr) {
 module T = Bivariate[l].Over[A] ; open T ;
 module P = PolynomialIdentity[l].Over[A,setA] ;
 module RP = RegularPolynomial[l].Over[A,setA,F,G] ;
 module EI = EtaleIdentities[l] ;
 module Rep = ExpressionRepresentation[l].Over[A,setA] ;
 module Fr = LocalizationFlat[l].Fractions[P.XY.ring,RP.j] ;
 module SR = FiniteIdeal[l].Sums[P.XY.ring] ; module SS = FiniteIdeal[l].Sums[Fr.S] ;
 module PR = AffinePowers[l].Over[P.XY.ring] ;
 H : RingHom[l].Hom A Fr.S = RingHom[l].compose A P.XY.ring Fr.S Fr.iota P.inclusion ;
 f : Fr.S.R = Fr.iota.1 (P.formal F) ; g : Fr.S.R = Fr.iota.1 (P.formal G) ;
 unit-S : RL[Fr.S].unit (Fr.iota.1 RP.j) = Fr.L.invertible ;
 -- iota(K p) = (iota j)^d (k s) for K = F or G, k its image
 scaled (K : Expr) (s : Fr.S.R) (d : Nat) (w : Fr.Fraction s d) :
  Id Fr.S.R (Fr.iota.1 (P.XY.mulQ (P.formal K) w.1))
   (Fr.S.mul (Fr.PS.power (Fr.iota.1 RP.j) d) (Fr.S.mul (Fr.iota.1 (P.formal K)) s)) =
  trans (Fr.iota.2.2.2 (P.formal K) w.1)
   (trans (ap (Fr.S.mul (Fr.iota.1 (P.formal K))) (Fr.numerator s d w))
    (sym EI.SwapFactor[Fr.S,Fr.iota.1 (P.formal K),Fr.PS.power (Fr.iota.1 RP.j) d,s].proof)) ;
 -- S is noetherian when A is
 noeth-S (nc : Noetheriannote[l].Calculus) (noeth : nc.Noeth A setA) : nc.Noeth Fr.S Fr.L.set =
  nc.localization P.XY.ring P.XY.set RP.j (nc.polynomial P.X.ring P.X.set (nc.polynomial A setA noeth)) ;
 module At (m : Nat) (a : Fin m -> A.R) {
  gens1 (i : Fin m) : P.XY.Carrier = P.inclusion.1 (a i) ;
  module K1 = LocalizedReduction[l].Over[P.XY.ring,RP.j,m,gens1] ;
  module I = K1.IS ; module IL = RegularIdeal[l].IdealLaws[Fr.S,I.ideal] ;
  module Sz = PairSyzygy[l].Over[Fr.S,I.ideal,f,g] ;
  -- J^k p = 0 in E (a unit) gives p = 0 in E
  cancel-power (E : CRing) (setE : Pr.isSet E.R) (phi : RingHom[l].Hom P.XY.ring E)
   (unitJ : RL[E].unit (phi.1 RP.j)) (k : Nat) (p : P.XY.Carrier)
   (zero : Id E.R (phi.1 (P.XY.mulQ (PR.power RP.j k) p)) E.z) : Id E.R (phi.1 p) E.z =
   RL[E].unit-reg (AffinePowers[l].Over[E].power (phi.1 RP.j) k) (phi.1 p)
    (AffinePowers[l].Over[E].Units[setE].power-unit (phi.1 RP.j) unitJ k)
    (trans (Presentations[l].cong2 E.R E.mul _ _ _ _ (sym (AffinePowers[l].power-map P.XY.ring E phi RP.j k)) (refl (phi.1 p)))
     (trans (sym (phi.2.2.2 (PR.power RP.j k) p)) zero)) ;
  -- F is regular modulo (a)S
  module First {
   module Q1 = QuotientRing[l].Over[Fr.S,I.ideal,I.in-prop] ;
   phi : RingHom[l].Hom P.XY.ring Q1.ring = RingHom[l].compose P.XY.ring Fr.S Q1.ring Q1.projection Fr.iota ;
   unit1 : RL[Q1.ring].unit (phi.1 RP.j) = unit-map Fr.S Q1.ring Q1.projection (Fr.iota.1 RP.j) unit-S ;
   module RA = RP.At[Q1.ring,Q1.set,phi,unit1] ;
   killed (i : Fin m) : Id Q1.ring.R (RA.hE.1 (a i)) Q1.ring.z = Q1.to-zero (Fr.iota.1 (gens1 i)) (I.generator i) ;
   -- the Taylor kernel principle in E1: F P = sum_i a_i Q_i in R gives P = 0 in E1
   Zero : U l = (Pe : Expr) (Q : Fin m -> P.XY.Carrier)
    (rel : Id P.XY.Carrier (P.formal (mulE F Pe)) (SR.lin m gens1 Q)) -> Id Q1.ring.R (phi.1 (P.formal Pe)) Q1.ring.z ;
   module Noetherian (nc : Noetheriannote[l].Calculus) (noeth : nc.Noeth A setA) {
    noeth1 : nc.Noeth Q1.ring Q1.set = nc.quotient Fr.S Fr.L.set m (\ i -> Fr.iota.1 (gens1 i)) (noeth-S nc noeth) ;
    module Lifted (Pe : Expr) (Q : Fin m -> P.XY.Carrier) (rel : Id P.XY.Carrier (P.formal (mulE F Pe)) (SR.lin m gens1 Q))
     (N : Nat) (stable : StableAnnihilator[l].Over[Q1.ring].Stable (RA.EE.val RA.x0 RA.y0 F) N) {
     module L = TaylorTargets[l].Over[A,Q1.ring,RA.hE,F,G,RA.x0,RA.y0,RA.invertible] ;
     s : L.State N = L.lift N ;
     module C = RA.Curve[s.1,s.2.1] ; module Pt = RA.Point[s.1,s.2.1,s.2.2.1,s.2.2.2.1] ;
     vanish : RA.J.Eq (suc N) (RA.ME.pmul (RA.EE.raw s.1 s.2.1 F) (RA.EE.raw s.1 s.2.1 Pe)) nil =
      RA.J.from-peq (suc N) _ nil (C.alone F Pe m a killed Q rel) ;
     zero : Id Q1.ring.R (phi.1 (P.formal Pe)) Q1.ring.z = Pt.Deformed[F,N,stable,s.2.2.2.2.1,Pe,vanish].result ;
    } ;
    zero : Zero = \ Pe Q rel ->
     TC.rec ((N : Nat) * StableAnnihilator[l].Over[Q1.ring].Stable (RA.EE.val RA.x0 RA.y0 F) N) @l
      (Id Q1.ring.R (phi.1 (P.formal Pe)) Q1.ring.z) (Q1.set _ _)
      (\ st -> Lifted[Pe,Q,rel,st.1,st.2].zero)
      (nc.stable Q1.ring Q1.set noeth1 (RA.EE.val RA.x0 RA.y0 F)) ;
   } ;
   module Regular (zero : Zero) {
    -- F (J^k p) = sum_i a_i Q_i in R
    relation (p : P.XY.Carrier) (c : K1.Cleared (P.XY.mulQ (P.formal F) p)) (pe : Rep.Rep (P.XY.mulQ (PR.power RP.j c.1) p)) :
     Id P.XY.Carrier (P.formal (mulE F pe.1)) (SR.lin m gens1 c.2.1) =
     trans (ap (P.XY.mulQ (P.formal F)) pe.2)
      (trans (sym (EI.SwapFactor[P.XY.ring,P.formal F,PR.power RP.j c.1,p].proof)) (sym c.2.2)) ;
    -- the image of p in E1 is 0 when F p is in (a)S
    vanish (p : P.XY.Carrier) (h : I.In (Fr.iota.1 (P.XY.mulQ (P.formal F) p))) : Id Q1.ring.R (phi.1 p) Q1.ring.z =
     TC.rec (K1.Cleared (P.XY.mulQ (P.formal F) p)) @l (Id Q1.ring.R (phi.1 p) Q1.ring.z) (Q1.set _ _)
      (\ c -> TC.rec (Rep.Rep (P.XY.mulQ (PR.power RP.j c.1) p)) @l (Id Q1.ring.R (phi.1 p) Q1.ring.z) (Q1.set _ _)
        (\ pe -> cancel-power Q1.ring Q1.set phi unit1 c.1 p
          (trans (ap phi.1 (sym pe.2)) (zero pe.1 c.2.1 (relation p c pe))))
        (Rep.represent (P.XY.mulQ (PR.power RP.j c.1) p)))
      (K1.kernel (P.XY.mulQ (P.formal F) p) h) ;
    regular : Sz.RegularF = \ s h ->
     TC.rec ((d : Nat) * Fr.Fraction s d) @l (I.In s) (I.in-prop s)
      (\ w -> IL.in-eq _ _ (sym w.2.2)
        (I.ideal.in-mul (Fr.PS.power Fr.u w.1) (Fr.iota.1 w.2.1)
         (Q1.kernel (Fr.iota.1 w.2.1)
          (vanish w.2.1 (IL.in-eq _ _ (sym (scaled F s w.1 w.2))
            (I.ideal.in-mul (Fr.PS.power (Fr.iota.1 RP.j) w.1) (Fr.S.mul f s) h))))))
      (Fr.represent s) ;
   } ;
  } ;
  -- G is regular modulo (F) + (a)S
  module Second {
   gens2 : Fin (suc m) -> P.XY.Carrier = split { inl i -> gens1 i ; inr t -> P.formal F } ;
   module K2 = LocalizedReduction[l].Over[P.XY.ring,RP.j,suc m,gens2] ;
   module Q2 = QuotientRing[l].Over[Fr.S,K2.IS.ideal,K2.IS.in-prop] ;
   phi : RingHom[l].Hom P.XY.ring Q2.ring = RingHom[l].compose P.XY.ring Fr.S Q2.ring Q2.projection Fr.iota ;
   unit2 : RL[Q2.ring].unit (phi.1 RP.j) = unit-map Fr.S Q2.ring Q2.projection (Fr.iota.1 RP.j) unit-S ;
   module RA = RP.At[Q2.ring,Q2.set,phi,unit2] ;
   killed (i : Fin m) : Id Q2.ring.R (RA.hE.1 (a i)) Q2.ring.z = Q2.to-zero (Fr.iota.1 (gens1 i)) (K2.IS.generator (inl i)) ;
   f-zero : Id Q2.ring.R (RA.EE.val RA.x0 RA.y0 F) Q2.ring.z =
    trans (sym (RA.NatE.value F)) (Q2.to-zero f (K2.IS.generator (inr tt))) ;
   -- the Taylor kernel principle in E2: G P = F W + sum_i a_i Q_i in R gives P = 0 in E2
   Zero : U l = (Pe We : Expr) (Q : Fin m -> P.XY.Carrier)
    (rel : Id P.XY.Carrier (P.formal (mulE G Pe)) (P.XY.addQ (P.formal (mulE F We)) (SR.lin m gens1 Q))) ->
    Id Q2.ring.R (phi.1 (P.formal Pe)) Q2.ring.z ;
   module Noetherian (nc : Noetheriannote[l].Calculus) (noeth : nc.Noeth A setA) {
    noeth2 : nc.Noeth Q2.ring Q2.set = nc.quotient Fr.S Fr.L.set (suc m) (\ i -> Fr.iota.1 (gens2 i)) (noeth-S nc noeth) ;
    swapped : RL[Q2.ring].unit (RA.EE.jacobian RA.x0 RA.y0 G F) =
     (Q2.ring.neg RA.invertible.1,
      trans (EI.SwapJacobian[Q2.ring,RA.EE.dx RA.x0 RA.y0 F,RA.EE.dy RA.x0 RA.y0 F,
        RA.EE.dx RA.x0 RA.y0 G,RA.EE.dy RA.x0 RA.y0 G,RA.invertible.1].proof) RA.invertible.2) ;
    module Lifted (Pe We : Expr) (Q : Fin m -> P.XY.Carrier)
     (rel : Id P.XY.Carrier (P.formal (mulE G Pe)) (P.XY.addQ (P.formal (mulE F We)) (SR.lin m gens1 Q)))
     (N : Nat) (stable : StableAnnihilator[l].Over[Q2.ring].Stable (RA.EE.val RA.x0 RA.y0 G) N) {
     module L = TaylorLift[l].Over[A,Q2.ring,RA.hE,G,F,RA.x0,RA.y0,f-zero,swapped] ;
     s : L.State N = L.lift N ;
     module C = RA.Curve[s.1,s.2.1] ; module Pt = RA.Point[s.1,s.2.1,s.2.2.1,s.2.2.2.1] ;
     module M = RawMultiplication[l].Laws[Q2.ring] ;
     vanish : RA.J.Eq (suc N) (RA.ME.pmul (RA.EE.raw s.1 s.2.1 G) (RA.EE.raw s.1 s.2.1 Pe)) nil =
      RA.J.compose (suc N) _ (RA.ME.pmul (RA.EE.raw s.1 s.2.1 F) (RA.EE.raw s.1 s.2.1 We)) nil
       (RA.J.from-peq (suc N) _ _ (C.with G F Pe We m a killed Q rel))
       (RA.J.compose (suc N) _ (RA.ME.pmul nil (RA.EE.raw s.1 s.2.1 We)) nil
        (RA.J.mul-eq (suc N) (RA.EE.raw s.1 s.2.1 F) nil (RA.EE.raw s.1 s.2.1 We) (RA.EE.raw s.1 s.2.1 We)
         s.2.2.2.2.2 (RA.J.same (suc N) (RA.EE.raw s.1 s.2.1 We)))
        (RA.J.from-peq (suc N) _ nil (M.mul-zero-left (RA.EE.raw s.1 s.2.1 We)))) ;
     zero : Id Q2.ring.R (phi.1 (P.formal Pe)) Q2.ring.z = Pt.Deformed[G,N,stable,s.2.2.2.2.1,Pe,vanish].result ;
    } ;
    zero : Zero = \ Pe We Q rel ->
     TC.rec ((N : Nat) * StableAnnihilator[l].Over[Q2.ring].Stable (RA.EE.val RA.x0 RA.y0 G) N) @l
      (Id Q2.ring.R (phi.1 (P.formal Pe)) Q2.ring.z) (Q2.set _ _)
      (\ st -> Lifted[Pe,We,Q,rel,st.1,st.2].zero)
      (nc.stable Q2.ring Q2.set noeth2 (RA.EE.val RA.x0 RA.y0 G)) ;
   } ;
   extend (c : Fin m -> Fr.S.R) (t : Fr.S.R) : Fin (suc m) -> Fr.S.R = split { inl i -> c i ; inr u -> t } ;
   -- an element of (a)S plus f t, in the ideal (a, F)S
   widen (x t : Fr.S.R) (h : I.In (Fr.S.add x (Fr.S.neg (Fr.S.mul f t)))) : K2.IS.In x =
    TC.map (SS.Coordinates m (\ i -> Fr.iota.1 (gens1 i)) (Fr.S.add x (Fr.S.neg (Fr.S.mul f t))))
     (SS.Coordinates (suc m) (\ i -> Fr.iota.1 (gens2 i)) x)
     (\ c -> (extend c.1 t,
       trans (ap (Fr.S.add (Fr.S.mul f t)) c.2) (EI.AddBack[Fr.S,Fr.S.mul f t,x].proof))) h ;
   -- an element of (a, F)S is f c + an element of (a)S
   narrow (x : Fr.S.R) (h : K2.IS.In x) : Tr.Trunc[Sz.Mod x].carrier =
    TC.map (SS.Coordinates (suc m) (\ i -> Fr.iota.1 (gens2 i)) x) (Sz.Mod x)
     (\ c -> (c.1 (inr tt),
       Tr.Trunc[SS.Coordinates m (\ i -> Fr.iota.1 (gens1 i)) (Fr.S.add x (Fr.S.neg (Fr.S.mul f (c.1 (inr tt)))))].inc
        (\ i -> c.1 (inl i),
         sym (trans (ap (\ y -> Fr.S.add y (Fr.S.neg (Fr.S.mul f (c.1 (inr tt))))) (sym c.2))
          (EI.RemoveFirst[Fr.S,Fr.S.mul f (c.1 (inr tt)),SS.lin m (\ i -> Fr.iota.1 (gens1 i)) (\ i -> c.1 (inl i))].proof))))) h ;
   module Regular (zero : Zero) {
    -- G (J^k p) = F W + sum_i a_i Q_i in R
    relation (p : P.XY.Carrier) (c : K2.Cleared (P.XY.mulQ (P.formal G) p))
     (pe : Rep.Rep (P.XY.mulQ (PR.power RP.j c.1) p)) (we : Rep.Rep (c.2.1 (inr tt))) :
     Id P.XY.Carrier (P.formal (mulE G pe.1))
      (P.XY.addQ (P.formal (mulE F we.1)) (SR.lin m gens1 (\ i -> c.2.1 (inl i)))) =
     trans (ap (P.XY.mulQ (P.formal G)) pe.2)
      (trans (sym (EI.SwapFactor[P.XY.ring,P.formal G,PR.power RP.j c.1,p].proof))
       (trans (sym c.2.2) (ap (\ t -> P.XY.addQ (P.XY.mulQ (P.formal F) t) (SR.lin m gens1 (\ i -> c.2.1 (inl i)))) (sym we.2)))) ;
    vanish (p : P.XY.Carrier) (h : K2.IS.In (Fr.iota.1 (P.XY.mulQ (P.formal G) p))) : Id Q2.ring.R (phi.1 p) Q2.ring.z =
     TC.rec (K2.Cleared (P.XY.mulQ (P.formal G) p)) @l (Id Q2.ring.R (phi.1 p) Q2.ring.z) (Q2.set _ _)
      (\ c -> TC.rec (Rep.Rep (P.XY.mulQ (PR.power RP.j c.1) p)) @l (Id Q2.ring.R (phi.1 p) Q2.ring.z) (Q2.set _ _)
        (\ pe -> TC.rec (Rep.Rep (c.2.1 (inr tt))) @l (Id Q2.ring.R (phi.1 p) Q2.ring.z) (Q2.set _ _)
          (\ we -> cancel-power Q2.ring Q2.set phi unit2 c.1 p
            (trans (ap phi.1 (sym pe.2)) (zero pe.1 we.1 (\ i -> c.2.1 (inl i)) (relation p c pe we))))
          (Rep.represent (c.2.1 (inr tt))))
        (Rep.represent (P.XY.mulQ (PR.power RP.j c.1) p)))
      (K2.kernel (P.XY.mulQ (P.formal G) p) h) ;
    module FromFraction (v t : Fr.S.R) (h : I.In (Fr.S.add (Fr.S.mul g v) (Fr.S.neg (Fr.S.mul f t))))
     (d : Nat) (w : Fr.Fraction v d) {
     in-Gp : K2.IS.In (Fr.iota.1 (P.XY.mulQ (P.formal G) w.1)) =
      RegularIdeal[l].IdealLaws[Fr.S,K2.IS.ideal].in-eq _ _ (sym (scaled G v d w))
       (K2.IS.ideal.in-mul (Fr.PS.power (Fr.iota.1 RP.j) d) (Fr.S.mul g v) (widen (Fr.S.mul g v) t h)) ;
     in-p : K2.IS.In (Fr.iota.1 w.1) = Q2.kernel (Fr.iota.1 w.1) (vanish w.1 in-Gp) ;
     -- v - f (u^d c) = u^d (p - f c)
     result : Tr.Trunc[Sz.Mod v].carrier =
      TC.map (Sz.Mod (Fr.iota.1 w.1)) (Sz.Mod v)
       (\ md -> (Fr.S.mul (Fr.PS.power Fr.u d) md.1,
         IL.in-eq _ _
          (trans (EI.ScaleDifference[Fr.S,Fr.PS.power Fr.u d,Fr.iota.1 w.1,f,md.1].proof)
           (ap (\ y -> Fr.S.add y (Fr.S.neg (Fr.S.mul f (Fr.S.mul (Fr.PS.power Fr.u d) md.1)))) (sym w.2)))
          (I.ideal.in-mul (Fr.PS.power Fr.u d) _ md.2)))
       (narrow (Fr.iota.1 w.1) in-p) ;
    } ;
    regular : Sz.RegularG = \ v t h ->
     TC.bind ((d : Nat) * Fr.Fraction v d) (Sz.Mod v) (\ w -> FromFraction[v,t,h,w.1,w.2].result) (Fr.represent v) ;
   } ;
  } ;
 } ;
 -- the pair is regular modulo every (a)S, given the two kernel principles
 PairRegular : U l = (m : Nat) (a : Fin m -> A.R) ->
  PairSyzygy[l].Over[Fr.S,RegularIdeal[l].Generated[Fr.S,m,\ i -> H.1 (a i)].ideal,f,g].RegularF *
  PairSyzygy[l].Over[Fr.S,RegularIdeal[l].Generated[Fr.S,m,\ i -> H.1 (a i)].ideal,f,g].RegularG ;
 regular (zero1 : (m : Nat) (a : Fin m -> A.R) -> At[m,a].First.Zero)
  (zero2 : (m : Nat) (a : Fin m -> A.R) -> At[m,a].Second.Zero) : PairRegular =
  \ m a -> (At[m,a].First.Regular[zero1 m a].regular,At[m,a].Second.Regular[zero2 m a].regular) ;
 -- A noetherian
 module Noetherian (nc : Noetheriannote[l].Calculus) (noeth : nc.Noeth A setA) {
  regularity : PairRegular =
   regular (\ m a -> At[m,a].First.Noetherian[nc,noeth].zero) (\ m a -> At[m,a].Second.Noetherian[nc,noeth].zero) ;
 } ;
} ;
