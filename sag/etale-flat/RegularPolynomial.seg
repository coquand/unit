-- The Taylor argument for regularity (handoff §3), in any ring E reached
-- from R = A[X,Y] by phi with phi(J) invertible.
--
-- Let x0 = phi(X), y0 = phi(Y), and x(T), y(T) a finite curve in E[T]
-- with x(0) = x0, y(0) = y0 (from TaylorTargets or TaylorLift).  psi sends
-- X, Y to x(T), y(T) (universal property of A[X][Y]); on an expression it
-- is the raw evaluation (PolynomialIdentity).  An element a of A with
-- phi(a) = 0 goes to 0, hence so does every sum_i a_i Q_i (kills).  So a
-- true identity  H P = sum_i a_i Q_i  (alone), or  H P = K W + sum_i a_i Q_i
-- (with), becomes an identity of coefficient lists over E.
-- Deformed: if moreover H(x(T),y(T)) = h - T below degree N+1, with
-- h = H(x0,y0) stable at N, and H P vanishes below degree N+1 on the curve,
-- then the constant term P(x0,y0) = phi(P) is 0 (StableAnnihilator.Kernel).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (F G : Bivariate[l].Over[A].Expr) {
 module P = PolynomialIdentity[l].Over[A,setA] ;
 module T = Bivariate[l].Over[A] ; open T ;
 j : P.XY.Carrier = P.Canon.jacobian P.x P.y F G ;
 module SR = FiniteIdeal[l].Sums[P.XY.ring] ;
 module At (E : CRing) (setE : Pr.isSet E.R) (phi : RingHom[l].Hom P.XY.ring E) (unitJ : RL[E].unit (phi.1 j)) {
  hE : RingHom[l].Hom A E = RingHom[l].compose A P.XY.ring E phi P.inclusion ;
  module EE = T.In[E,hE] ;
  module NatE = BivariateNaturality[l].Over[A,P.XY.ring,E,P.inclusion,phi,P.x,P.y] ;
  x0 : E.R = phi.1 P.x ; y0 : E.R = phi.1 P.y ;
  invertible : RL[E].unit (EE.jacobian x0 y0 F G) = subst (RL[E].unit) (NatE.jacobian F G) unitJ ;
  module PE = Poly[l].PolyR[E] ; module ME = Mul[l].MulR[E] ;
  module J = FiniteJets[l].Over[E] ; module St = StableAnnihilator[l].Over[E] ;
  module RI = P.RawInto[E,setE,hE] ;
  module SBT = FiniteIdeal[l].Sums[RI.BT.ring] ;
  zero-constant : PE.peq (cons E.z nil) nil = split { zero -> refl E.z ; suc k -> refl E.z } ;
  module Curve (x y : PE.P) {
   module Ev = P.Into[RI.BT.ring,RI.BT.set,RI.hT,RI.BT.include x,RI.BT.include y] ;
   psi : RingHom[l].Hom P.XY.ring RI.BT.ring = Ev.EY.extend ;
   on-expr (e : T.Expr) : Id RI.BT.Carrier (psi.1 (P.formal e)) (RI.BT.include (EE.raw x y e)) =
    trans (Ev.natural e) (RI.sound x y e) ;
   on-killed (c : A.R) (killed : Id E.R (hE.1 c) E.z) : Id RI.BT.Carrier (psi.1 (P.inclusion.1 c)) RI.BT.zeroQ =
    trans (on-expr (cE c))
     (trans (ap (\ t -> RI.BT.include (cons t nil)) killed) (RI.BT.Q.relates (cons E.z nil) nil zero-constant)) ;
   kills (m : Nat) (a : Fin m -> A.R) (killed : (i : Fin m) -> Id E.R (hE.1 (a i)) E.z) (Q : Fin m -> P.XY.Carrier) :
    Id RI.BT.Carrier (psi.1 (SR.lin m (\ i -> P.inclusion.1 (a i)) Q)) RI.BT.zeroQ =
    trans (FlatRelations[l].MapSums[P.XY.ring,RI.BT.ring,psi].lin m (\ i -> P.inclusion.1 (a i)) Q)
     (trans (SBT.sum-cong m (\ i -> RI.BT.mulQ (psi.1 (P.inclusion.1 (a i))) (psi.1 (Q i))) (\ i -> RI.BT.zeroQ)
       (\ i -> trans (ap (\ t -> RI.BT.mulQ t (psi.1 (Q i))) (on-killed (a i) (killed i)))
        (RL[RI.BT.ring].zero-mul (psi.1 (Q i)))))
      (SBT.sum-zero m)) ;
   -- H P = sum_i a_i Q_i in R gives H P = 0 on the curve
   alone (H Pe : T.Expr) (m : Nat) (a : Fin m -> A.R) (killed : (i : Fin m) -> Id E.R (hE.1 (a i)) E.z)
    (Q : Fin m -> P.XY.Carrier) (rel : Id P.XY.Carrier (P.formal (mulE H Pe)) (SR.lin m (\ i -> P.inclusion.1 (a i)) Q)) :
    PE.peq (ME.pmul (EE.raw x y H) (EE.raw x y Pe)) nil =
    RI.BT.Q.effective _ nil (trans (sym (on-expr (mulE H Pe))) (trans (ap psi.1 rel) (kills m a killed Q))) ;
   -- H P = K W + sum_i a_i Q_i in R gives H P = K W on the curve
   with (H K Pe We : T.Expr) (m : Nat) (a : Fin m -> A.R) (killed : (i : Fin m) -> Id E.R (hE.1 (a i)) E.z)
    (Q : Fin m -> P.XY.Carrier)
    (rel : Id P.XY.Carrier (P.formal (mulE H Pe))
      (P.XY.addQ (P.formal (mulE K We)) (SR.lin m (\ i -> P.inclusion.1 (a i)) Q))) :
    PE.peq (ME.pmul (EE.raw x y H) (EE.raw x y Pe)) (ME.pmul (EE.raw x y K) (EE.raw x y We)) =
    RI.BT.Q.effective _ _
     (trans (sym (on-expr (mulE H Pe)))
      (trans (ap psi.1 rel)
       (trans (psi.2.2.1 (P.formal (mulE K We)) (SR.lin m (\ i -> P.inclusion.1 (a i)) Q))
        (trans (Presentations[l].cong2 RI.BT.Carrier RI.BT.addQ _ _ _ _ (on-expr (mulE K We)) (kills m a killed Q))
         (RI.BT.add-zero (RI.BT.include (EE.raw x y (mulE K We)))))))) ;
  } ;
  -- a curve through (x0,y0)
  module Point (x y : PE.P) (hx : Id E.R (PE.coef x zero) x0) (hy : Id E.R (PE.coef y zero) y0) {
   -- the constant term of a curve value is phi
   constant (e : T.Expr) : Id E.R (PE.coef (EE.raw x y e) zero) (phi.1 (P.formal e)) =
    trans (EE.raw-zero x y e)
     (trans (ap (\ t -> EE.val t (PE.coef y zero) e) hx)
      (trans (ap (\ t -> EE.val x0 t e) hy) (sym (NatE.value e)))) ;
   module Deformed (H : T.Expr) (N : Nat) (stable : St.Stable (EE.val x0 y0 H) N)
    (hH : J.Eq (suc N) (EE.raw x y H) (St.linear (EE.val x0 y0 H))) (Pe : T.Expr)
    (vanish : J.Eq (suc N) (ME.pmul (EE.raw x y H) (EE.raw x y Pe)) nil) {
    linear-vanish : J.Eq (suc N) (ME.pmul (St.linear (EE.val x0 y0 H)) (EE.raw x y Pe)) nil =
     J.compose (suc N) (ME.pmul (St.linear (EE.val x0 y0 H)) (EE.raw x y Pe)) (ME.pmul (EE.raw x y H) (EE.raw x y Pe)) nil
      (J.mul-eq (suc N) (St.linear (EE.val x0 y0 H)) (EE.raw x y H) (EE.raw x y Pe) (EE.raw x y Pe)
       (J.reverse (suc N) (EE.raw x y H) (St.linear (EE.val x0 y0 H)) hH) (J.same (suc N) (EE.raw x y Pe)))
      vanish ;
    module Kill = St.Kernel[EE.val x0 y0 H,N,EE.raw x y Pe,linear-vanish] ;
    result : Id E.R (phi.1 (P.formal Pe)) E.z =
     trans (sym (constant Pe)) (Kill.result stable) ;
   } ;
  } ;
 } ;
} ;
