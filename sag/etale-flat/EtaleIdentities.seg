-- (x+y)-x = y
module RemoveFirst (Rg : CRing) (v_x v_y : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_x Rg.z) v_x = (Rg.addZ v_x) ;
  step1 : Id Rg.R v_x (Rg.add v_x Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.add v_y Rg.z) v_y = (Rg.addZ v_y) ;
  step3 : Id Rg.R v_y (Rg.add v_y Rg.z) = (sym step2) ;
  step4 : Id Rg.R (Rg.add Rg.z (Rg.add v_y Rg.z)) (Rg.add v_y Rg.z) = (RL[Rg].zl (Rg.add v_y Rg.z)) ;
  step5 : Id Rg.R (Rg.add v_x (Rg.add Rg.z (Rg.add v_y Rg.z))) (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) = (Rg.addA v_x Rg.z (Rg.add v_y Rg.z)) ;
  step6 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) (Rg.add v_x (Rg.add Rg.z (Rg.add v_y Rg.z))) = (sym step5) ;
  step7 : Id Rg.R (Rg.add v_x (Rg.add Rg.z (Rg.add v_y Rg.z))) (Rg.add v_x (Rg.add v_y Rg.z)) = (cong2 Rg.R Rg.add v_x v_x (Rg.add Rg.z (Rg.add v_y Rg.z)) (Rg.add v_y Rg.z) (refl v_x) step4) ;
  step8 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) (Rg.add v_x (Rg.add v_y Rg.z)) = (trans step6 step7) ;
  step9 : Id Rg.R (Rg.add v_x v_y) (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) = (cong2 Rg.R Rg.add v_x (Rg.add v_x Rg.z) v_y (Rg.add v_y Rg.z) step1 step3) ;
  step10 : Id Rg.R (Rg.add v_x v_y) (Rg.add v_x (Rg.add v_y Rg.z)) = (trans step9 step8) ;
  step11 : Id Rg.R (Rg.neg Rg.z) Rg.z = (RL[Rg].neg-zero ) ;
  step12 : Id Rg.R (Rg.neg (Rg.add v_x Rg.z)) (Rg.add (Rg.neg v_x) (Rg.neg Rg.z)) = (N.neg-add v_x Rg.z) ;
  step13 : Id Rg.R (Rg.add (Rg.neg v_x) (Rg.neg Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (cong2 Rg.R Rg.add (Rg.neg v_x) (Rg.neg v_x) (Rg.neg Rg.z) Rg.z (refl (Rg.neg v_x)) step11) ;
  step14 : Id Rg.R (Rg.neg (Rg.add v_x Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (trans step12 step13) ;
  step15 : Id Rg.R (Rg.neg v_x) (Rg.neg (Rg.add v_x Rg.z)) = (ap Rg.neg step1) ;
  step16 : Id Rg.R (Rg.neg v_x) (Rg.add (Rg.neg v_x) Rg.z) = (trans step15 step14) ;
  step17 : Id Rg.R (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (RL[Rg].zl (Rg.add (Rg.neg v_x) Rg.z)) ;
  step18 : Id Rg.R (Rg.add v_y (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) = (N.add-swap v_y (Rg.neg v_x) Rg.z) ;
  step19 : Id Rg.R (Rg.add v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z))) (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) = (Rg.addA v_y Rg.z (Rg.add (Rg.neg v_x) Rg.z)) ;
  step20 : Id Rg.R (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z))) = (sym step19) ;
  step21 : Id Rg.R (Rg.add v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z))) (Rg.add v_y (Rg.add (Rg.neg v_x) Rg.z)) = (cong2 Rg.R Rg.add v_y v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) (refl v_y) step17) ;
  step22 : Id Rg.R (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_y (Rg.add (Rg.neg v_x) Rg.z)) = (trans step20 step21) ;
  step23 : Id Rg.R (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) = (trans step22 step18) ;
  step24 : Id Rg.R (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add (Rg.add v_x (Rg.neg v_x)) (Rg.add v_y Rg.z)) = (Rg.addA v_x (Rg.neg v_x) (Rg.add v_y Rg.z)) ;
  step25 : Id Rg.R (Rg.add v_x (Rg.neg v_x)) Rg.z = (Rg.addN v_x) ;
  step26 : Id Rg.R (Rg.add (Rg.add v_x (Rg.neg v_x)) (Rg.add v_y Rg.z)) (Rg.add Rg.z (Rg.add v_y Rg.z)) = (cong2 Rg.R Rg.add (Rg.add v_x (Rg.neg v_x)) Rg.z (Rg.add v_y Rg.z) (Rg.add v_y Rg.z) step25 (refl (Rg.add v_y Rg.z))) ;
  step27 : Id Rg.R (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add Rg.z (Rg.add v_y Rg.z)) = (trans step24 step26) ;
  step28 : Id Rg.R (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add v_y Rg.z) = (trans step27 step4) ;
  step29 : Id Rg.R (Rg.add v_x (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z))) (Rg.add (Rg.add v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.neg v_x) Rg.z)) = (Rg.addA v_x (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) ;
  step30 : Id Rg.R (Rg.add (Rg.add v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_x (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z))) = (sym step29) ;
  step31 : Id Rg.R (Rg.add v_x (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z))) (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) = (cong2 Rg.R Rg.add v_x v_x (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) (refl v_x) step23) ;
  step32 : Id Rg.R (Rg.add (Rg.add v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) = (trans step30 step31) ;
  step33 : Id Rg.R (Rg.add (Rg.add v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_y Rg.z) = (trans step32 step28) ;
  step34 : Id Rg.R (Rg.add (Rg.add v_x v_y) (Rg.neg v_x)) (Rg.add (Rg.add v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.neg v_x) Rg.z)) = (cong2 Rg.R Rg.add (Rg.add v_x v_y) (Rg.add v_x (Rg.add v_y Rg.z)) (Rg.neg v_x) (Rg.add (Rg.neg v_x) Rg.z) step10 step16) ;
  step35 : Id Rg.R (Rg.add (Rg.add v_x v_y) (Rg.neg v_x)) (Rg.add v_y Rg.z) = (trans step34 step33) ;
  step36 : Id Rg.R (Rg.add (Rg.add v_x v_y) (Rg.neg v_x)) v_y = (trans step35 step2) ;
  proof : Id Rg.R (Rg.add (Rg.add v_x v_y) (Rg.neg v_x)) v_y = step36 ;
