-- (f*u+(g*v+0))-(f*(u-g*w)+g*(v+f*w)) = 0
module PairCorrection (Rg : CRing) (v_f v_g v_u v_v v_w : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_f Rg.z) v_f = (Rg.addZ v_f) ;
  step1 : Id Rg.R v_f (Rg.add v_f Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.add v_u Rg.z) v_u = (Rg.addZ v_u) ;
  step3 : Id Rg.R v_u (Rg.add v_u Rg.z) = (sym step2) ;
  step4 : Id Rg.R (Rg.mul v_f Rg.z) Rg.z = (RL[Rg].mul-zero v_f) ;
