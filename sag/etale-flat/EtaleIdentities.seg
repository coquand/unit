-- j*(f*s) = f*(j*s)
module SwapFactor (Rg : CRing) (v_f v_j v_s : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_j Rg.z) v_j = (Rg.addZ v_j) ;
