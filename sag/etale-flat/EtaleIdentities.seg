-- x+(y-x) = y
module AddBack (Rg : CRing) (v_x v_y : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_x Rg.z) v_x = (Rg.addZ v_x) ;
  step1 : Id Rg.R v_x (Rg.add v_x Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.add v_y Rg.z) v_y = (Rg.addZ v_y) ;
  step3 : Id Rg.R v_y (Rg.add v_y Rg.z) = (sym step2) ;
  step4 : Id Rg.R (Rg.neg Rg.z) Rg.z = (RL[Rg].neg-zero ) ;
  step5 : Id Rg.R (Rg.neg (Rg.add v_x Rg.z)) (Rg.add (Rg.neg v_x) (Rg.neg Rg.z)) = (N.neg-add v_x Rg.z) ;
  step6 : Id Rg.R (Rg.add (Rg.neg v_x) (Rg.neg Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (cong2 Rg.R Rg.add (Rg.neg v_x) (Rg.neg v_x) (Rg.neg Rg.z) Rg.z (refl (Rg.neg v_x)) step4) ;
  step7 : Id Rg.R (Rg.neg (Rg.add v_x Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (trans step5 step6) ;
  step8 : Id Rg.R (Rg.neg v_x) (Rg.neg (Rg.add v_x Rg.z)) = (ap Rg.neg step1) ;
  step9 : Id Rg.R (Rg.neg v_x) (Rg.add (Rg.neg v_x) Rg.z) = (trans step8 step7) ;
  step10 : Id Rg.R (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (RL[Rg].zl (Rg.add (Rg.neg v_x) Rg.z)) ;
  step11 : Id Rg.R (Rg.add v_y (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) = (N.add-swap v_y (Rg.neg v_x) Rg.z) ;
  step12 : Id Rg.R (Rg.add v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z))) (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) = (Rg.addA v_y Rg.z (Rg.add (Rg.neg v_x) Rg.z)) ;
  step13 : Id Rg.R (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z))) = (sym step12) ;
  step14 : Id Rg.R (Rg.add v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z))) (Rg.add v_y (Rg.add (Rg.neg v_x) Rg.z)) = (cong2 Rg.R Rg.add v_y v_y (Rg.add Rg.z (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) (refl v_y) step10) ;
  step15 : Id Rg.R (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add v_y (Rg.add (Rg.neg v_x) Rg.z)) = (trans step13 step14) ;
  step16 : Id Rg.R (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) = (trans step15 step11) ;
  step17 : Id Rg.R (Rg.add v_y (Rg.neg v_x)) (Rg.add (Rg.add v_y Rg.z) (Rg.add (Rg.neg v_x) Rg.z)) = (cong2 Rg.R Rg.add v_y (Rg.add v_y Rg.z) (Rg.neg v_x) (Rg.add (Rg.neg v_x) Rg.z) step3 step9) ;
  step18 : Id Rg.R (Rg.add v_y (Rg.neg v_x)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) = (trans step17 step16) ;
  step19 : Id Rg.R (Rg.add Rg.z (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) = (RL[Rg].zl (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) ;
  step20 : Id Rg.R (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add (Rg.add v_x (Rg.neg v_x)) (Rg.add v_y Rg.z)) = (Rg.addA v_x (Rg.neg v_x) (Rg.add v_y Rg.z)) ;
  step21 : Id Rg.R (Rg.add v_x (Rg.neg v_x)) Rg.z = (Rg.addN v_x) ;
  step22 : Id Rg.R (Rg.add (Rg.add v_x (Rg.neg v_x)) (Rg.add v_y Rg.z)) (Rg.add Rg.z (Rg.add v_y Rg.z)) = (cong2 Rg.R Rg.add (Rg.add v_x (Rg.neg v_x)) Rg.z (Rg.add v_y Rg.z) (Rg.add v_y Rg.z) step21 (refl (Rg.add v_y Rg.z))) ;
  step23 : Id Rg.R (Rg.add Rg.z (Rg.add v_y Rg.z)) (Rg.add v_y Rg.z) = (RL[Rg].zl (Rg.add v_y Rg.z)) ;
  step24 : Id Rg.R (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add Rg.z (Rg.add v_y Rg.z)) = (trans step20 step22) ;
  step25 : Id Rg.R (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add v_y Rg.z) = (trans step24 step23) ;
  step26 : Id Rg.R (Rg.add v_x (Rg.add Rg.z (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)))) (Rg.add (Rg.add v_x Rg.z) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) = (Rg.addA v_x Rg.z (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) ;
  step27 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add v_x (Rg.add Rg.z (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)))) = (sym step26) ;
  step28 : Id Rg.R (Rg.add v_x (Rg.add Rg.z (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)))) (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) = (cong2 Rg.R Rg.add v_x v_x (Rg.add Rg.z (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) (refl v_x) step19) ;
  step29 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add v_x (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) = (trans step27 step28) ;
  step30 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) (Rg.add v_y Rg.z) = (trans step29 step25) ;
  step31 : Id Rg.R (Rg.add v_x (Rg.add v_y (Rg.neg v_x))) (Rg.add (Rg.add v_x Rg.z) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z))) = (cong2 Rg.R Rg.add v_x (Rg.add v_x Rg.z) (Rg.add v_y (Rg.neg v_x)) (Rg.add (Rg.neg v_x) (Rg.add v_y Rg.z)) step1 step18) ;
  step32 : Id Rg.R (Rg.add v_x (Rg.add v_y (Rg.neg v_x))) (Rg.add v_y Rg.z) = (trans step31 step30) ;
  step33 : Id Rg.R (Rg.add v_x (Rg.add v_y (Rg.neg v_x))) v_y = (trans step32 step2) ;
  proof : Id Rg.R (Rg.add v_x (Rg.add v_y (Rg.neg v_x))) v_y = step33 ;
} ;
-- u*(q-f*c) = u*q-f*(u*c)
module ScaleDifference (Rg : CRing) (v_u v_q v_f v_c : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_u Rg.z) v_u = (Rg.addZ v_u) ;
  step1 : Id Rg.R v_u (Rg.add v_u Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.add v_q Rg.z) v_q = (Rg.addZ v_q) ;
  step3 : Id Rg.R v_q (Rg.add v_q Rg.z) = (sym step2) ;
  step4 : Id Rg.R (Rg.add v_f Rg.z) v_f = (Rg.addZ v_f) ;
  step5 : Id Rg.R v_f (Rg.add v_f Rg.z) = (sym step4) ;
  step6 : Id Rg.R (Rg.add v_c Rg.z) v_c = (Rg.addZ v_c) ;
  step7 : Id Rg.R v_c (Rg.add v_c Rg.z) = (sym step6) ;
  step8 : Id Rg.R (Rg.mul v_f v_c) (Rg.mul v_c v_f) = (Rg.mulC v_f v_c) ;
  step9 : Id Rg.R (Rg.mul v_f Rg.z) Rg.z = (RL[Rg].mul-zero v_f) ;
  step10 : Id Rg.R (Rg.mul v_f (Rg.add v_c Rg.z)) (Rg.add (Rg.mul v_f v_c) (Rg.mul v_f Rg.z)) = (Rg.dist v_f v_c Rg.z) ;
