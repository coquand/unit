-- 0*a+0*b = 0
module ZeroCombination (Rg : CRing) (v_a v_b : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_a Rg.z) v_a = (Rg.addZ v_a) ;
  step1 : Id Rg.R v_a (Rg.add v_a Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.mul Rg.z (Rg.add v_a Rg.z)) Rg.z = (RL[Rg].zero-mul (Rg.add v_a Rg.z)) ;
  step3 : Id Rg.R (Rg.mul Rg.z v_a) (Rg.mul Rg.z (Rg.add v_a Rg.z)) = (cong2 Rg.R Rg.mul Rg.z Rg.z v_a (Rg.add v_a Rg.z) (refl Rg.z) step1) ;
  step4 : Id Rg.R (Rg.mul Rg.z v_a) Rg.z = (trans step3 step2) ;
  step5 : Id Rg.R (Rg.add v_b Rg.z) v_b = (Rg.addZ v_b) ;
  step6 : Id Rg.R v_b (Rg.add v_b Rg.z) = (sym step5) ;
  step7 : Id Rg.R (Rg.mul Rg.z (Rg.add v_b Rg.z)) Rg.z = (RL[Rg].zero-mul (Rg.add v_b Rg.z)) ;
  step8 : Id Rg.R (Rg.mul Rg.z v_b) (Rg.mul Rg.z (Rg.add v_b Rg.z)) = (cong2 Rg.R Rg.mul Rg.z Rg.z v_b (Rg.add v_b Rg.z) (refl Rg.z) step6) ;
  step9 : Id Rg.R (Rg.mul Rg.z v_b) Rg.z = (trans step8 step7) ;
  step10 : Id Rg.R (Rg.add Rg.z Rg.z) Rg.z = (RL[Rg].zl Rg.z) ;
  step11 : Id Rg.R (Rg.add (Rg.mul Rg.z v_a) (Rg.mul Rg.z v_b)) (Rg.add Rg.z Rg.z) = (cong2 Rg.R Rg.add (Rg.mul Rg.z v_a) Rg.z (Rg.mul Rg.z v_b) Rg.z step4 step9) ;
  step12 : Id Rg.R (Rg.add (Rg.mul Rg.z v_a) (Rg.mul Rg.z v_b)) Rg.z = (trans step11 step10) ;
  proof : Id Rg.R (Rg.add (Rg.mul Rg.z v_a) (Rg.mul Rg.z v_b)) Rg.z = step12 ;
} ;
