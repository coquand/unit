-- Compatibility of the finite Taylor lifts (doc/jacobian-regularity.tex,
-- Lemma 3.3, in the indexing of TaylorLift).
--
-- lift (n+1) is Step[n, lift n].result.  Its curves are obtained from those
-- of lift n by changing one coefficient, the one of T^(n+1):
--     x_(n+1) = x_n + a_n T^(n+1),   y_(n+1) = y_n + b_n T^(n+1)
-- (formula, by definition of lift and Step).  Hence x_(n+1) and x_n have the
-- same coefficients below n+1 (bump-change, i.e. Step.cx.1), and so below n.
-- No series, no noetherian hypothesis.
level l ; open Ring[l] ;
module Over (A B : CRing) (h : RingHom[l].Hom A B) (F G : Bivariate[l].Over[A].Expr) (x0 y0 : B.R)
 (gzero : Id B.R (Bivariate[l].Over[A].In[B,h].val x0 y0 G) B.z)
 (invertible : RL[B].unit (Bivariate[l].Over[A].In[B,h].jacobian x0 y0 F G)) {
 module L = TaylorLift[l].Over[A,B,h,F,G,x0,y0,gzero,invertible] ;
 module J = FiniteJets[l].Over[B] ;
 x (n : Nat) : Poly[l].PolyR[B].P = (L.lift n).1 ;
 y (n : Nat) : Poly[l].PolyR[B].P = (L.lift n).2.1 ;
 -- the correction at order n+1, by definition of lift
 x-formula (n : Nat) : Id Poly[l].PolyR[B].P (x (suc n)) (J.bump (suc n) (x n) L.Step[n,L.lift n].a) =
  refl (x (suc n)) ;
 y-formula (n : Nat) : Id Poly[l].PolyR[B].P (y (suc n)) (J.bump (suc n) (y n) L.Step[n,L.lift n].b) =
  refl (y (suc n)) ;
 -- compatibility modulo T^(n+1)
 x-compatible (n : Nat) : J.Eq (suc n) (x n) (x (suc n)) = L.Step[n,L.lift n].cx.1 ;
 y-compatible (n : Nat) : J.Eq (suc n) (y n) (y (suc n)) = L.Step[n,L.lift n].cy.1 ;
 -- and hence modulo T^n
 x-compatible-below (n : Nat) : J.Eq n (x n) (x (suc n)) = J.down n (x n) (x (suc n)) (x-compatible n) ;
 y-compatible-below (n : Nat) : J.Eq n (y n) (y (suc n)) = J.down n (y n) (y (suc n)) (y-compatible n) ;
} ;
