-- Change of base ring along h : A0 -> A for the bivariate data (handoff §6).
--
-- map sends an expression over A0 to the expression over A with the
-- coefficients replaced by their images.  Evaluation, the formal partial
-- derivatives and the Jacobian commute with map (Values), and depend only on
-- the values of the structure map (Pointwise).  phi : A0[X][Y] -> A[X][Y]
-- is the ring map of the universal property with X |-> X, Y |-> Y and
-- c |-> h(c) on constants; it sends the formal polynomial of an expression e
-- to that of map e, and the Jacobian of (F0, G0) to that of (map F0, map G0).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
-- evaluation depends only on the values of the structure map
module Pointwise (A C : CRing) (k k' : RingHom[l].Hom A C) (same : (c : A.R) -> Id C.R (k.1 c) (k'.1 c)) (x y : C.R) {
 module T = Bivariate[l].Over[A] ; open T ;
 module E = T.In[C,k] ; module E' = T.In[C,k'] ;
 module J = FiniteJets[l].Over[C] ;
 val : (e : Expr) -> Id C.R (E.val x y e) (E'.val x y e) = split {
  xE -> refl x ; yE -> refl y ; cE c -> same c ;
  addE p q | hp hq -> J.cg C.add _ _ _ _ hp hq ; mulE p q | hp hq -> J.cg C.mul _ _ _ _ hp hq } ;
 dx : (e : Expr) -> Id C.R (E.dx x y e) (E'.dx x y e) = split {
  xE -> refl C.o ; yE -> refl C.z ; cE c -> refl C.z ;
  addE p q | hp hq -> J.cg C.add _ _ _ _ hp hq ;
  mulE p q | hp hq -> J.cg C.add _ _ _ _ (J.cg C.mul _ _ _ _ hp (val q)) (J.cg C.mul _ _ _ _ (val p) hq) } ;
 dy : (e : Expr) -> Id C.R (E.dy x y e) (E'.dy x y e) = split {
  xE -> refl C.z ; yE -> refl C.o ; cE c -> refl C.z ;
  addE p q | hp hq -> J.cg C.add _ _ _ _ hp hq ;
  mulE p q | hp hq -> J.cg C.add _ _ _ _ (J.cg C.mul _ _ _ _ hp (val q)) (J.cg C.mul _ _ _ _ (val p) hq) } ;
 jacobian (p q : Expr) : Id C.R (E.jacobian x y p q) (E'.jacobian x y p q) =
  J.cg C.add _ _ _ _ (J.cg C.mul _ _ _ _ (dx p) (dy q)) (ap C.neg (J.cg C.mul _ _ _ _ (dy p) (dx q))) ;
} ;
module Over (A0 A : CRing) (set0 : Pr.isSet A0.R) (setA : Pr.isSet A.R) (h : RingHom[l].Hom A0 A) {
 module T0 = Bivariate[l].Over[A0] ; module T = Bivariate[l].Over[A] ; open T ;
 map : T0.Expr -> Expr = split {
  xE -> xE ; yE -> yE ; cE c -> cE (h.1 c) ;
  addE p q | mp mq -> addE mp mq ; mulE p q | mp mq -> mulE mp mq } ;
 module Values (C : CRing) (k : RingHom[l].Hom A C) (x y : C.R) {
  module E0 = T0.In[C,RingHom[l].compose A0 A C k h] ; module E = T.In[C,k] ;
  module J = FiniteJets[l].Over[C] ;
  val : (e : T0.Expr) -> Id C.R (E0.val x y e) (E.val x y (map e)) = split {
   xE -> refl x ; yE -> refl y ; cE c -> refl (k.1 (h.1 c)) ;
   addE p q | hp hq -> J.cg C.add _ _ _ _ hp hq ; mulE p q | hp hq -> J.cg C.mul _ _ _ _ hp hq } ;
  dx : (e : T0.Expr) -> Id C.R (E0.dx x y e) (E.dx x y (map e)) = split {
   xE -> refl C.o ; yE -> refl C.z ; cE c -> refl C.z ;
   addE p q | hp hq -> J.cg C.add _ _ _ _ hp hq ;
   mulE p q | hp hq -> J.cg C.add _ _ _ _ (J.cg C.mul _ _ _ _ hp (val q)) (J.cg C.mul _ _ _ _ (val p) hq) } ;
  dy : (e : T0.Expr) -> Id C.R (E0.dy x y e) (E.dy x y (map e)) = split {
   xE -> refl C.z ; yE -> refl C.o ; cE c -> refl C.z ;
   addE p q | hp hq -> J.cg C.add _ _ _ _ hp hq ;
   mulE p q | hp hq -> J.cg C.add _ _ _ _ (J.cg C.mul _ _ _ _ hp (val q)) (J.cg C.mul _ _ _ _ (val p) hq) } ;
  jacobian (p q : T0.Expr) : Id C.R (E0.jacobian x y p q) (E.jacobian x y (map p) (map q)) =
   J.cg C.add _ _ _ _ (J.cg C.mul _ _ _ _ (dx p) (dy q)) (ap C.neg (J.cg C.mul _ _ _ _ (dy p) (dx q))) ;
 } ;
 module P0 = PolynomialIdentity[l].Over[A0,set0] ; module P = PolynomialIdentity[l].Over[A,setA] ;
 module MX = Universal[l].Property[A0,P.X.ring,set0,P.X.set].Given[RingHom[l].compose A0 A P.X.ring P.X.inclusion h,P.X.variable] ;
 module MXY = Universal[l].Property[P0.X.ring,P.XY.ring,P0.X.set,P.XY.set].Given[
  RingHom[l].compose P0.X.ring P.X.ring P.XY.ring P.XY.inclusion MX.extend,P.XY.variable] ;
 -- A0[X][Y] -> A[X][Y]
 phi : RingHom[l].Hom P0.XY.ring P.XY.ring = MXY.extend ;
 on-x : Id P.XY.Carrier (phi.1 P0.x) P.x = trans (MXY.on-constants P0.X.variable) (ap P.XY.constant MX.on-variable) ;
 on-y : Id P.XY.Carrier (phi.1 P0.y) P.y = MXY.on-variable ;
 on-constants (c : A0.R) : Id P.XY.Carrier (phi.1 (P0.inclusion.1 c)) (P.inclusion.1 (h.1 c)) =
  trans (MXY.on-constants (P0.X.constant c)) (ap P.XY.constant (MX.on-constants c)) ;
 module Nat0 = BivariateNaturality[l].Over[A0,P0.XY.ring,P.XY.ring,P0.inclusion,phi,P0.x,P0.y] ;
 module PW = Pointwise[A0,P.XY.ring,RingHom[l].compose A0 P0.XY.ring P.XY.ring phi P0.inclusion,
  RingHom[l].compose A0 A P.XY.ring P.inclusion h,on-constants,P.x,P.y] ;
 module V = Values[P.XY.ring,P.inclusion,P.x,P.y] ;
 formal (e : T0.Expr) : Id P.XY.Carrier (phi.1 (P0.formal e)) (P.formal (map e)) =
  trans (Nat0.value e)
   (trans (ap (\ t -> Nat0.EC.val t (phi.1 P0.y) e) on-x)
    (trans (ap (\ t -> Nat0.EC.val P.x t e) on-y) (trans (PW.val e) (V.val e)))) ;
 jacobian (F0 G0 : T0.Expr) :
  Id P.XY.Carrier (phi.1 (P0.Canon.jacobian P0.x P0.y F0 G0)) (P.Canon.jacobian P.x P.y (map F0) (map G0)) =
  trans (Nat0.jacobian F0 G0)
   (trans (ap (\ t -> Nat0.EC.jacobian t (phi.1 P0.y) F0 G0) on-x)
    (trans (ap (\ t -> Nat0.EC.jacobian P.x t F0 G0) on-y) (trans (PW.jacobian F0 G0) (V.jacobian F0 G0)))) ;
} ;
