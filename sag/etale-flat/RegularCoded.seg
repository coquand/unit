-- The Taylor kernel principle with no hypothesis, by coded subrings
-- (doc/jacobian-noetherian.tex, made generic in the target ring).
--
-- Let phi : R -> E with phi(J) invertible and phi(a_i) = 0.  An identity
-- H P = K W + sum_i a_i Q_i in R holds on every curve in E[T]
-- (RegularPolynomial.Curve).  Let E' be the coded subring of E generated by
-- the images of the constants of F, G, P, W and by x0, y0, 1/J: it is coded
-- noetherian (sag/noetherian: Hilbert over Z, CodedSubring.Subring), and
-- E' -> E is injective, so the curve identity holds in E'[T] for the
-- expressions with coefficients in E' (lift, transfer).  The finite lifts of
-- every order run in E' and give u = h^n w_n, h^(n+1) w_n = 0 with
-- u = P(x0,y0), h = H(x0,y0) (StableAnnihilator.Kernel, RegularAt.Curve);
-- CodedSubring.Vanish gives u = 0 in E', hence phi(P) = 0 in E.
--   Alone: F P = sum_i a_i Q_i, curve of TaylorTargets (F = f - T).
--   With:  G P = F W + sum_i a_i Q_i and F(x0,y0) = 0, curve of TaylorLift
--          for (G, F), as in RegularAt.Curve.
-- The code for consts .. product follows jacobian/FiniteCoefficients, with
-- B, h replaced by any E, phi.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (F G : Bivariate[l].Over[A].Expr) {
 module T = Bivariate[l].Over[A] ;
 module P = PolynomialIdentity[l].Over[A,setA] ;
 module RP = RegularPolynomial[l].Over[A,setA,F,G] ;
 module SR = FiniteIdeal[l].Sums[P.XY.ring] ;
 module At (E : CRing) (setE : Pr.isSet E.R) (phi : RingHom[l].Hom P.XY.ring E) (unitJ : RL[E].unit (phi.1 RP.j)) {
  module RA = RP.At[E,setE,phi,unitJ] ;
  module J = FiniteJets[l].Over[E] ;
  module Z = Integers[l].Over[E] ;
  module Gn = Generated[l].Over[E,Z.pres,Z.noeth] ;
  jinv : E.R = unitJ.1 ;
  base : List E.R = cons jinv (cons RA.y0 (cons RA.x0 nil)) ;
  -- the images of the constants of e, in front of acc
  consts : T.Expr -> List E.R -> List E.R = split {
   xE -> \ acc -> acc ; yE -> \ acc -> acc ;
   cE a -> \ acc -> cons (RA.hE.1 a) acc ;
   addE p q | rp rq -> \ acc -> rp (rq acc) ;
   mulE p q | rp rq -> \ acc -> rp (rq acc) } ;
  CodedIn (xs : List E.R) (b : E.R) : U l = CodedSubring[l].Over[E,Gn.gen xs].Coded b ;
  up (x : E.R) (xs : List E.R) (b : E.R) (c : CodedIn xs b) : CodedIn (cons x xs) b =
   Tr.Trunc[CodedSubring[l].Over[E,Gn.gen xs].Lifts b].induction @l (\ t -> CodedIn (cons x xs) b)
    (\ t -> CodedSubring[l].Over[E,Gn.gen (cons x xs)].coded-prop b)
    (\ cb -> CodedSubring[l].Over[E,Gn.gen (cons x xs)].known (Gn.up x xs cb.1) b (trans (Gn.up-phi x xs cb.1) cb.2)) c ;
  ups : (e : T.Expr) (acc : List E.R) (b : E.R) -> CodedIn acc b -> CodedIn (consts e acc) b = split {
   xE -> \ acc b c -> c ; yE -> \ acc b c -> c ;
   cE a -> \ acc b c -> up (RA.hE.1 a) acc b c ;
   addE p q | rp rq -> \ acc b c -> rp (consts q acc) b (rq acc b c) ;
   mulE p q | rp rq -> \ acc b c -> rp (consts q acc) b (rq acc b c) } ;
  -- every constant of e is coded over xs
  AllCoded (xs : List E.R) : T.Expr -> U l = split {
   xE -> Top ; yE -> Top ; cE a -> CodedIn xs (RA.hE.1 a) ;
   addE p q | rp rq -> rp * rq ; mulE p q | rp rq -> rp * rq } ;
  all : (e : T.Expr) (acc xs : List E.R) -> ((b : E.R) -> CodedIn (consts e acc) b -> CodedIn xs b) ->
    AllCoded xs e = split {
   xE -> \ acc xs m -> tt ; yE -> \ acc xs m -> tt ;
   cE a -> \ acc xs m -> m (RA.hE.1 a)
     (CodedSubring[l].Over[E,Gn.gen (cons (RA.hE.1 a) acc)].known (Gn.var (RA.hE.1 a) acc) (RA.hE.1 a) (Gn.var-phi (RA.hE.1 a) acc)) ;
   addE p q | rp rq -> \ acc xs m -> (rp (consts q acc) xs m, rq acc xs (\ b c -> m b (ups p (consts q acc) b c))) ;
   mulE p q | rp rq -> \ acc xs m -> (rp (consts q acc) xs m, rq acc xs (\ b c -> m b (ups p (consts q acc) b c))) } ;
  module CB = CodedSubring[l].Over[E,Gn.gen base] ;
  coded-x : CodedIn base RA.x0 =
   CB.known (Gn.up jinv (cons RA.y0 (cons RA.x0 nil)) (Gn.up RA.y0 (cons RA.x0 nil) (Gn.var RA.x0 nil))) RA.x0
    (trans (Gn.up-phi jinv (cons RA.y0 (cons RA.x0 nil)) (Gn.up RA.y0 (cons RA.x0 nil) (Gn.var RA.x0 nil)))
     (trans (Gn.up-phi RA.y0 (cons RA.x0 nil) (Gn.var RA.x0 nil)) (Gn.var-phi RA.x0 nil))) ;
  coded-y : CodedIn base RA.y0 =
   CB.known (Gn.up jinv (cons RA.y0 (cons RA.x0 nil)) (Gn.var RA.y0 (cons RA.x0 nil))) RA.y0
    (trans (Gn.up-phi jinv (cons RA.y0 (cons RA.x0 nil)) (Gn.var RA.y0 (cons RA.x0 nil))) (Gn.var-phi RA.y0 (cons RA.x0 nil))) ;
  coded-jinv : CodedIn base jinv = CB.known (Gn.var jinv (cons RA.y0 (cons RA.x0 nil))) jinv (Gn.var-phi jinv (cons RA.y0 (cons RA.x0 nil))) ;
  -- the coded subring for F, G, P, W
  module Coded (Pe We : T.Expr) {
   E0 : T.Expr = addE (addE F G) (addE Pe We) ;
   gens : List E.R = consts E0 base ;
   module Sb = CodedSubring[l].Subring[E,Gn.gen gens,Gn.noeth gens] ;
   module C = Sb.O ;
   cs : AllCoded gens E0 = all E0 base gens (\ b c -> c) ;
   module TS = Bivariate[l].Over[C.ring] ;
   lift : (e : T.Expr) -> AllCoded gens e -> TS.Expr = split {
    xE -> \ c -> xE ; yE -> \ c -> yE ;
    cE a -> \ c -> cE (RA.hE.1 a,c) ;
    addE p q | rp rq -> \ c -> addE (rp c.1) (rq c.2) ;
    mulE p q | rp rq -> \ c -> mulE (rp c.1) (rq c.2) } ;
   Fs : TS.Expr = lift F cs.1.1 ; Gs : TS.Expr = lift G cs.1.2 ;
   Ps : TS.Expr = lift Pe cs.2.1 ; Ws : TS.Expr = lift We cs.2.2 ;
   module ES = TS.In[C.ring,RingHom[l].identity C.ring] ;
   -- incl commutes with evaluation and the partial derivatives
   value (x y : C.Carrier) : (e : T.Expr) (c : AllCoded gens e) ->
     Id E.R (ES.val x y (lift e c)).1 (RA.EE.val x.1 y.1 e) = split {
    xE -> \ c -> refl x.1 ; yE -> \ c -> refl y.1 ; cE a -> \ c -> refl (RA.hE.1 a) ;
    addE p q | hp hq -> \ c -> J.cg E.add _ _ _ _ (hp c.1) (hq c.2) ;
    mulE p q | hp hq -> \ c -> J.cg E.mul _ _ _ _ (hp c.1) (hq c.2) } ;
   dx (x y : C.Carrier) : (e : T.Expr) (c : AllCoded gens e) ->
     Id E.R (ES.dx x y (lift e c)).1 (RA.EE.dx x.1 y.1 e) = split {
    xE -> \ c -> refl E.o ; yE -> \ c -> refl E.z ; cE a -> \ c -> refl E.z ;
    addE p q | hp hq -> \ c -> J.cg E.add _ _ _ _ (hp c.1) (hq c.2) ;
    mulE p q | hp hq -> \ c -> J.cg E.add _ _ _ _ (J.cg E.mul _ _ _ _ (hp c.1) (value x y q c.2))
                                                (J.cg E.mul _ _ _ _ (value x y p c.1) (hq c.2)) } ;
   dy (x y : C.Carrier) : (e : T.Expr) (c : AllCoded gens e) ->
     Id E.R (ES.dy x y (lift e c)).1 (RA.EE.dy x.1 y.1 e) = split {
    xE -> \ c -> refl E.z ; yE -> \ c -> refl E.o ; cE a -> \ c -> refl E.z ;
    addE p q | hp hq -> \ c -> J.cg E.add _ _ _ _ (hp c.1) (hq c.2) ;
    mulE p q | hp hq -> \ c -> J.cg E.add _ _ _ _ (J.cg E.mul _ _ _ _ (hp c.1) (value x y q c.2))
                                                (J.cg E.mul _ _ _ _ (value x y p c.1) (hq c.2)) } ;
   jacobian (x y : C.Carrier) (p q : T.Expr) (cp : AllCoded gens p) (cq : AllCoded gens q) :
     Id E.R (ES.jacobian x y (lift p cp) (lift q cq)).1 (RA.EE.jacobian x.1 y.1 p q) =
    J.cg E.add _ _ _ _ (J.cg E.mul _ _ _ _ (dx x y p cp) (dy x y q cq))
     (ap E.neg (J.cg E.mul _ _ _ _ (dy x y p cp) (dx x y q cq))) ;
   -- ... and with evaluation on coefficient lists
   module RM = RawMap[l].Over[C.ring,E,C.incl] ;
   module PS = Poly[l].PolyR[C.ring] ; module MS = Mul[l].MulR[C.ring] ;
   module PB = Poly[l].PolyR[E] ; module MB = Mul[l].MulR[E] ;
   module LB = RawLaws[l].Laws[E] ; module RB = RawMultiplication[l].Laws[E] ;
   raw (x y : PS.P) : (e : T.Expr) (c : AllCoded gens e) ->
     PB.peq (RM.pmap (ES.raw x y (lift e c))) (RA.EE.raw (RM.pmap x) (RM.pmap y) e) = split {
    xE -> \ c -> LB.rr (RM.pmap x) ; yE -> \ c -> LB.rr (RM.pmap y) ;
    cE a -> \ c -> LB.rr (cons (RA.hE.1 a) nil) ;
    addE p q | hp hq -> \ c ->
     LB.eq _ _ _ (RM.pmap-addP (ES.raw x y (lift p c.1)) (ES.raw x y (lift q c.2)))
      (LB.add-cong _ _ _ _ (hp c.1) (hq c.2)) ;
    mulE p q | hp hq -> \ c ->
     LB.eq _ _ _ (RM.pmap-pmul (ES.raw x y (lift p c.1)) (ES.raw x y (lift q c.2)))
      (RB.mul-cong _ _ _ _ (hp c.1) (hq c.2)) } ;
   product (x y : PS.P) (p q : T.Expr) (cp : AllCoded gens p) (cq : AllCoded gens q) :
     PB.peq (RM.pmap (MS.pmul (ES.raw x y (lift p cp)) (ES.raw x y (lift q cq))))
       (MB.pmul (RA.EE.raw (RM.pmap x) (RM.pmap y) p) (RA.EE.raw (RM.pmap x) (RM.pmap y) q)) =
    LB.eq _ _ _ (RM.pmap-pmul (ES.raw x y (lift p cp)) (ES.raw x y (lift q cq)))
     (RB.mul-cong _ _ _ _ (raw x y p cp) (raw x y q cq)) ;
   -- an identity of curve values in E[T] holds in E'[T]
   transfer (x y : PS.P) (p q p' q' : TS.Expr)
    (e : PB.peq (RM.pmap (MS.pmul (ES.raw x y p) (ES.raw x y q))) (RM.pmap (MS.pmul (ES.raw x y p') (ES.raw x y q')))) :
    PS.peq (MS.pmul (ES.raw x y p) (ES.raw x y q)) (MS.pmul (ES.raw x y p') (ES.raw x y q')) = \ k ->
    C.eq _ _ (trans (sym (RM.coef-pmap (MS.pmul (ES.raw x y p) (ES.raw x y q)) k))
     (trans (e k) (RM.coef-pmap (MS.pmul (ES.raw x y p') (ES.raw x y q')) k))) ;
   -- the point and the inverse of J(x,y), in E'
   x0 : C.Carrier = (RA.x0,ups E0 base RA.x0 coded-x) ;
   y0 : C.Carrier = (RA.y0,ups E0 base RA.y0 coded-y) ;
   j0 : C.Carrier = (jinv,ups E0 base jinv coded-jinv) ;
   invertible : RL[C.ring].unit (ES.jacobian x0 y0 Fs Gs) =
    (j0,C.eq _ _
      (trans (ap (\ t -> E.mul t jinv) (trans (jacobian x0 y0 F G cs.1.1 cs.1.2) (sym (RA.NatE.jacobian F G))))
        unitJ.2)) ;
   module St = StableAnnihilator[l].Over[C.ring] ;
   -- u = 0 in E' gives phi(P) = 0
   conclude (zero : Id C.Carrier (ES.val x0 y0 Ps) C.zero) : Id E.R (phi.1 (P.formal Pe)) E.z =
    trans (RA.NatE.value Pe) (trans (sym (value x0 y0 Pe cs.2.1)) (ap C.incl.1 zero)) ;
  } ;
  -- F P = sum_i a_i Q_i
  module Alone (Pe : T.Expr) (m : Nat) (a : Fin m -> A.R) (killed : (i : Fin m) -> Id E.R (RA.hE.1 (a i)) E.z)
   (Q : Fin m -> P.XY.Carrier) (rel : Id P.XY.Carrier (P.formal (mulE F Pe)) (SR.lin m (\ i -> P.inclusion.1 (a i)) Q)) {
   module K = Coded[Pe,Pe] ;
   curve (x y : K.PS.P) : K.PS.peq (K.MS.pmul (K.ES.raw x y K.Fs) (K.ES.raw x y K.Ps)) nil = \ k ->
    K.C.eq _ _ (trans (sym (K.RM.coef-pmap (K.MS.pmul (K.ES.raw x y K.Fs) (K.ES.raw x y K.Ps)) k))
     (K.LB.eq _ _ _ (K.product x y F Pe K.cs.1.1 K.cs.2.1)
       (RA.Curve[K.RM.pmap x,K.RM.pmap y].alone F Pe m a killed Q rel) k)) ;
   module Order (n : Nat) {
    module L = TaylorTargets[l].Over[K.C.ring,K.C.ring,RingHom[l].identity K.C.ring,K.Fs,K.Gs,K.x0,K.y0,K.invertible] ;
    s : L.State n = L.lift n ;
    p : K.PS.P = K.ES.raw s.1 s.2.1 K.Ps ;
    vanishes : FiniteJets[l].Over[K.C.ring].Eq (suc n) (K.MS.pmul L.targetF p) nil =
     FiniteJets[l].Over[K.C.ring].compose (suc n) (K.MS.pmul L.targetF p) (K.MS.pmul (K.ES.raw s.1 s.2.1 K.Fs) p) nil
      (FiniteJets[l].Over[K.C.ring].mul-eq (suc n) L.targetF (K.ES.raw s.1 s.2.1 K.Fs) p p
       (FiniteJets[l].Over[K.C.ring].reverse (suc n) (K.ES.raw s.1 s.2.1 K.Fs) L.targetF s.2.2.2.2.1)
       (FiniteJets[l].Over[K.C.ring].same (suc n) p))
      (FiniteJets[l].Over[K.C.ring].from-peq (suc n) _ nil (curve s.1 s.2.1)) ;
    constant : Id K.C.Carrier (K.PS.coef p zero) (K.ES.val K.x0 K.y0 K.Ps) =
     trans (K.ES.raw-zero s.1 s.2.1 K.Ps)
      (trans (ap (\ t -> K.ES.val t (K.PS.coef s.2.1 zero) K.Ps) s.2.2.1)
       (ap (\ t -> K.ES.val K.x0 t K.Ps) s.2.2.2.1)) ;
    module Kn = K.St.Kernel[L.f,n,p,vanishes] ;
    coefficient : K.C.Carrier = K.PS.coef p n ;
    iterated : Id K.C.Carrier (K.ES.val K.x0 K.y0 K.Ps) (K.C.ring.mul (K.St.power L.f n) coefficient) =
     trans (sym constant) Kn.iterated ;
    killed' : Id K.C.Carrier (K.C.ring.mul (K.St.power L.f (suc n)) coefficient) K.C.zero = Kn.killed ;
   } ;
   module Vn = CodedSubring[l].Vanish[K.C.ring,K.C.set setE,K.Sb.coded-noetherian,K.ES.val K.x0 K.y0 K.Fs,
    K.ES.val K.x0 K.y0 K.Ps,\ n -> Order[n].coefficient,\ n -> Order[n].iterated,\ n -> Order[n].killed'] ;
   result : Id E.R (phi.1 (P.formal Pe)) E.z = K.conclude Vn.vanish ;
  } ;
  -- G P = F W + sum_i a_i Q_i, with F(x0,y0) = 0
  module With (Pe We : T.Expr) (m : Nat) (a : Fin m -> A.R) (killed : (i : Fin m) -> Id E.R (RA.hE.1 (a i)) E.z)
   (Q : Fin m -> P.XY.Carrier)
   (rel : Id P.XY.Carrier (P.formal (mulE G Pe)) (P.XY.addQ (P.formal (mulE F We)) (SR.lin m (\ i -> P.inclusion.1 (a i)) Q)))
   (fzero : Id E.R (RA.EE.val RA.x0 RA.y0 F) E.z) {
   module K = Coded[Pe,We] ;
   curve (x y : K.PS.P) : K.PS.peq (K.MS.pmul (K.ES.raw x y K.Gs) (K.ES.raw x y K.Ps)) (K.MS.pmul (K.ES.raw x y K.Fs) (K.ES.raw x y K.Ws)) =
    K.transfer x y K.Gs K.Ps K.Fs K.Ws
     (K.LB.eq _ _ _ (K.product x y G Pe K.cs.1.2 K.cs.2.1)
      (K.LB.eq _ _ _ (RA.Curve[K.RM.pmap x,K.RM.pmap y].with G F Pe We m a killed Q rel)
       (K.PB.peq-sym _ _ (K.product x y F We K.cs.1.1 K.cs.2.2)))) ;
   fzero' : Id K.C.Carrier (K.ES.val K.x0 K.y0 K.Fs) K.C.zero = K.C.eq _ _ (trans (K.value K.x0 K.y0 F K.cs.1.1) fzero) ;
   swapped : RL[K.C.ring].unit (K.ES.jacobian K.x0 K.y0 K.Gs K.Fs) =
    (K.C.ring.neg K.invertible.1,
     trans (EtaleIdentities[l].SwapJacobian[K.C.ring,K.ES.dx K.x0 K.y0 K.Fs,K.ES.dy K.x0 K.y0 K.Fs,
       K.ES.dx K.x0 K.y0 K.Gs,K.ES.dy K.x0 K.y0 K.Gs,K.invertible.1].proof) K.invertible.2) ;
   module Order (n : Nat) {
    module R = RegularAt[l].Curve[K.C.ring,K.C.ring,RingHom[l].identity K.C.ring,K.Gs,K.Fs,K.Ps,K.Ws,curve,
     K.x0,K.y0,fzero',swapped,n] ;
   } ;
   module Vn = CodedSubring[l].Vanish[K.C.ring,K.C.set setE,K.Sb.coded-noetherian,K.ES.val K.x0 K.y0 K.Gs,
    K.ES.val K.x0 K.y0 K.Ps,\ n -> Order[n].R.coefficient,\ n -> Order[n].R.iterated,\ n -> Order[n].R.killed] ;
   result : Id E.R (phi.1 (P.formal Pe)) E.z = K.conclude Vn.vanish ;
  } ;
 } ;
 -- the two kernel principles of RegularPair, for any A
 module RPr = RegularPair[l].Over[A,setA,F,G] ;
 zero1 (m : Nat) (a : Fin m -> A.R) : RPr.At[m,a].First.Zero = \ Pe Q rel ->
  At[RPr.At[m,a].First.Q1.ring,RPr.At[m,a].First.Q1.set,RPr.At[m,a].First.phi,RPr.At[m,a].First.unit1].Alone[
   Pe,m,a,RPr.At[m,a].First.killed,Q,rel].result ;
 zero2 (m : Nat) (a : Fin m -> A.R) : RPr.At[m,a].Second.Zero = \ Pe We Q rel ->
  At[RPr.At[m,a].Second.Q2.ring,RPr.At[m,a].Second.Q2.set,RPr.At[m,a].Second.phi,RPr.At[m,a].Second.unit2].With[
   Pe,We,m,a,RPr.At[m,a].Second.killed,Q,rel,RPr.At[m,a].Second.f-zero].result ;
 -- F, G is a regular pair modulo every (a)S, for every commutative ring A
 regularity : RPr.PairRegular = RPr.regular zero1 zero2 ;
} ;
