-- An ideal of S = R[1/j] generated by elements of R, read back in R
-- (handoff §5, the kernel of the reduction, with denominators cleared).
--
-- Let g_1..g_m be in R.  If iota(r) = sum_i g_i c_i in S, then merely
-- j^k r = sum_i g_i Q_i in R for some k and Q_i.  Proof: write c_i = u^d Q_i
-- with a common d (Fractions.common); then iota(j^d r) = iota(sum_i g_i Q_i),
-- so j^e (j^d r - sum_i g_i Q_i) = 0 in R for some e (kernel of the
-- localization); take k = e + d and the coefficients j^e Q_i.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (j : R.R) (m : Nat) (gens : Fin m -> R.R) {
 module Fr = LocalizationFlat[l].Fractions[R,j] ;
 module SR = FiniteIdeal[l].Sums[R] ; module SS = FiniteIdeal[l].Sums[Fr.S] ;
 module LR = RL[R] ;
 iota : RingHom[l].Hom R Fr.S = Fr.iota ;
 -- the ideal of S generated by the g_i
 module IS = RegularIdeal[l].Generated[Fr.S,m,\ i -> iota.1 (gens i)] ;
 Cleared (r : R.R) : U l = (k : Nat) * SR.Coordinates m gens (R.mul (Fr.PC.power j k) r) ;
 -- the easy direction: an element of the ideal of R stays in it
 extend (r : R.R) (c : SR.Coordinates m gens r) : IS.In (iota.1 r) =
  Tr.Trunc[SS.Coordinates m (\ i -> iota.1 (gens i)) (iota.1 r)].inc
   (\ i -> iota.1 (c.1 i),trans (sym (FlatRelations[l].MapSums[R,Fr.S,iota].lin m gens c.1)) (ap iota.1 c.2)) ;
 module Read (r : R.R) (c : SS.Coordinates m (\ i -> iota.1 (gens i)) (iota.1 r)) (d : Nat)
  (w : (i : Fin m) -> Fr.Fraction (c.1 i) d) {
  Q (i : Fin m) : R.R = (w i).1 ;
  sum : R.R = SR.lin m gens Q ;
  -- iota r = u^d iota(sum)
  fractions : Id Fr.S.R (iota.1 r) (Fr.S.mul (Fr.PS.power Fr.u d) (iota.1 sum)) = calc Fr.S.R {
   iota.1 r =< sym c.2 > SS.lin m (\ i -> iota.1 (gens i)) c.1
    =< SS.sum-cong m (\ i -> Fr.S.mul (iota.1 (gens i)) (c.1 i))
        (\ i -> Fr.S.mul (iota.1 (gens i)) (Fr.S.mul (Fr.PS.power Fr.u d) (iota.1 (Q i))))
        (\ i -> ap (Fr.S.mul (iota.1 (gens i))) (w i).2) >
     SS.lin m (\ i -> iota.1 (gens i)) (\ i -> Fr.S.mul (Fr.PS.power Fr.u d) (iota.1 (Q i)))
    =< SS.lin-scale m (\ i -> iota.1 (gens i)) (\ i -> iota.1 (Q i)) (Fr.PS.power Fr.u d) >
     Fr.S.mul (Fr.PS.power Fr.u d) (SS.lin m (\ i -> iota.1 (gens i)) (\ i -> iota.1 (Q i)))
    =< ap (Fr.S.mul (Fr.PS.power Fr.u d)) (sym (FlatRelations[l].MapSums[R,Fr.S,iota].lin m gens Q)) >
     Fr.S.mul (Fr.PS.power Fr.u d) (iota.1 sum) } ;
  -- iota(j^d r) = iota(sum)
  cleared : Id Fr.S.R (iota.1 (R.mul (Fr.PC.power j d) r)) (iota.1 sum) = calc Fr.S.R {
   iota.1 (R.mul (Fr.PC.power j d) r)
    =< trans (iota.2.2.2 (Fr.PC.power j d) r) (ap (\ t -> Fr.S.mul t (iota.1 r)) (Fr.iota-power d)) >
     Fr.S.mul (Fr.PS.power (iota.1 j) d) (iota.1 r)
    =< ap (Fr.S.mul (Fr.PS.power (iota.1 j) d)) fractions >
     Fr.S.mul (Fr.PS.power (iota.1 j) d) (Fr.S.mul (Fr.PS.power Fr.u d) (iota.1 sum))
    =< Fr.S.mulA (Fr.PS.power (iota.1 j) d) (Fr.PS.power Fr.u d) (iota.1 sum) >
     Fr.S.mul (Fr.S.mul (Fr.PS.power (iota.1 j) d) (Fr.PS.power Fr.u d)) (iota.1 sum)
    =< ap (\ t -> Fr.S.mul t (iota.1 sum)) (Fr.cancel d) > Fr.S.mul Fr.S.o (iota.1 sum)
    =< Fr.LS.one-left (iota.1 sum) > iota.1 sum } ;
  difference : R.R = R.add (R.mul (Fr.PC.power j d) r) (R.neg sum) ;
  vanishes : Id Fr.S.R (iota.1 difference) Fr.S.z =
   trans (iota.2.2.1 (R.mul (Fr.PC.power j d) r) (R.neg sum))
    (trans (ap (Fr.S.add (iota.1 (R.mul (Fr.PC.power j d) r))) (RingHom[l].negation R Fr.S iota sum))
     (trans (ap (\ t -> Fr.S.add t (Fr.S.neg (iota.1 sum))) cleared) (Fr.S.addN (iota.1 sum)))) ;
  module Killed (k : Fr.L.Killed difference) {
   e : Nat = k.1 ;
   -- j^e (j^d r) = j^e sum
   equal : Id R.R (R.mul (Fr.PC.power j e) (R.mul (Fr.PC.power j d) r)) (R.mul (Fr.PC.power j e) sum) =
    StableAnnihilator[l].Over[R].difference _ _
     (trans (ap (R.add (R.mul (Fr.PC.power j e) (R.mul (Fr.PC.power j d) r))) (sym (LR.mul-neg (Fr.PC.power j e) sum)))
      (trans (sym (R.dist (Fr.PC.power j e) (R.mul (Fr.PC.power j d) r) (R.neg sum))) k.2)) ;
   result : Cleared r =
    (plus e d,\ i -> R.mul (Fr.PC.power j e) (Q i),
     trans (SR.lin-scale m gens Q (Fr.PC.power j e))
      (trans (sym equal)
       (trans (R.mulA (Fr.PC.power j e) (Fr.PC.power j d) r)
        (ap (\ t -> R.mul t r) (sym (Fr.PC.power-add j e d)))))) ;
  } ;
  result : Tr.Trunc[Cleared r].carrier =
   TC.map (Fr.L.Killed difference) (Cleared r) (\ k -> Killed[k].result) (Fr.L.kernel difference vanishes) ;
 } ;
 kernel (r : R.R) (h : IS.In (iota.1 r)) : Tr.Trunc[Cleared r].carrier =
  TC.bind (SS.Coordinates m (\ i -> iota.1 (gens i)) (iota.1 r)) (Cleared r)
   (\ c -> TC.bind ((d : Nat) * ((i : Fin m) -> Fr.Fraction (c.1 i) d)) (Cleared r)
     (\ w -> Read[r,c,w.1,w.2].result) (Fr.common m c.1)) h ;
} ;
