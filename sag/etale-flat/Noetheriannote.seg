-- Noetheriannote: the explicit noetherian interface (handoff §2).  Nothing
-- in this file is proved, and nothing else is assumed anywhere: the final
-- theorems take a value of these records as an argument.
--
-- Calculus (component N): a predicate Noeth on commutative set-rings,
-- stable under the three constructions used, stated on the library's own
-- constructions (so no transport between isomorphic presentations):
--   polynomial    A |-> A[X]                    (PolynomialRing.Extension)
--   quotient      A |-> A/(c_1..c_m)            (QuotientRing of RegularIdeal.Generated)
--   localization  A |-> A[1/c]                  (PowerLocalization)
-- and, in a noetherian ring, the annihilators of the powers of any c are
-- merely stable:  merely N with  c^(N+1) v = 0 -> c^N v = 0  for all v
-- (StableAnnihilator.Stable c N).  This is the ascending chain condition
-- for the chain Ann(c) <= Ann(c^2) <= ..., nothing more.
-- Not assumed: that every ring is noetherian, any flatness, regularity or
-- syzygy statement.  The reduction component D is in Reduction.seg.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
record Calculus {
 Noeth (A : CRing) (setA : Pr.isSet A.R) : U l ;
 polynomial (A : CRing) (setA : Pr.isSet A.R) (noeth : Noeth A setA) :
  Noeth (PolynomialRing[l].Extension[A,setA].ring) (PolynomialRing[l].Extension[A,setA].set) ;
 quotient (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (c : Fin m -> A.R) (noeth : Noeth A setA) :
  Noeth (QuotientRing[l].Over[A,RegularIdeal[l].Generated[A,m,c].ideal,RegularIdeal[l].Generated[A,m,c].in-prop].ring)
   (QuotientRing[l].Over[A,RegularIdeal[l].Generated[A,m,c].ideal,RegularIdeal[l].Generated[A,m,c].in-prop].set) ;
 localization (A : CRing) (setA : Pr.isSet A.R) (c : A.R) (noeth : Noeth A setA) :
  Noeth (PowerLocalization[l].Over[A,c].ring) (PowerLocalization[l].Over[A,c].set) ;
 stable (A : CRing) (setA : Pr.isSet A.R) (noeth : Noeth A setA) (c : A.R) :
  Tr.Trunc[(N : Nat) * StableAnnihilator[l].Over[A].Stable c N].carrier ;
} ;
-- Reduction (component D): the realisation of finitely many data and of ONE
-- polynomial identity over a noetherian ring.  Given A, a_1..a_n in A,
-- F, G (expressions), p_1..p_n, uF, uG in A[X,Y], k, and the identity
--     J^k sum_i a_i p_i = F uF + G uG       in A[X][Y]                (D1)
-- (J the Jacobian of F, G), merely: a noetherian A0, h : A0 -> A, a0_i,
-- F0, G0, p0_i, uF0, uG0 over A0 with h(a0_i) = a_i, map F0 = F, map G0 = G,
-- phi(p0_i) = p_i (BaseChange), and the identity (D1) over A0 with the same
-- k and J0 the Jacobian of F0, G0.  h need not be injective.  Only an
-- identity is descended, never a flatness, regularity or syzygy statement.
module Reduction (nc : Calculus) {
 Identity (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (a : Fin n -> A.R) (F G : Bivariate[l].Over[A].Expr)
  (p : Fin n -> PolynomialIdentity[l].Over[A,setA].XY.Carrier) (k : Nat)
  (uF uG : PolynomialIdentity[l].Over[A,setA].XY.Carrier) : U l =
  Id PolynomialIdentity[l].Over[A,setA].XY.Carrier
   (PolynomialIdentity[l].Over[A,setA].XY.mulQ
    (AffinePowers[l].Over[PolynomialIdentity[l].Over[A,setA].XY.ring].power
     (PolynomialIdentity[l].Over[A,setA].Canon.jacobian PolynomialIdentity[l].Over[A,setA].x PolynomialIdentity[l].Over[A,setA].y F G) k)
    (FiniteIdeal[l].Sums[PolynomialIdentity[l].Over[A,setA].XY.ring].lin n (\ i -> PolynomialIdentity[l].Over[A,setA].inclusion.1 (a i)) p))
   (PolynomialIdentity[l].Over[A,setA].XY.addQ
    (PolynomialIdentity[l].Over[A,setA].XY.mulQ (PolynomialIdentity[l].Over[A,setA].formal F) uF)
    (PolynomialIdentity[l].Over[A,setA].XY.mulQ (PolynomialIdentity[l].Over[A,setA].formal G) uG)) ;
 record Descent (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (a : Fin n -> A.R) (F G : Bivariate[l].Over[A].Expr)
  (p : Fin n -> PolynomialIdentity[l].Over[A,setA].XY.Carrier) (k : Nat) {
  A0 : CRing ;
  set0 : Pr.isSet A0.R ;
  noeth : nc.Noeth A0 set0 ;
  h : RingHom[l].Hom A0 A ;
  a0 (i : Fin n) : A0.R ;
  a-image (i : Fin n) : Id A.R (h.1 (a0 i)) (a i) ;
  F0 : Bivariate[l].Over[A0].Expr ;
  G0 : Bivariate[l].Over[A0].Expr ;
  F-image : Id (Bivariate[l].Over[A].Expr) (BaseChange[l].Over[A0,A,set0,setA,h].map F0) F ;
  G-image : Id (Bivariate[l].Over[A].Expr) (BaseChange[l].Over[A0,A,set0,setA,h].map G0) G ;
  p0 (i : Fin n) : PolynomialIdentity[l].Over[A0,set0].XY.Carrier ;
  p-image (i : Fin n) : Id (PolynomialIdentity[l].Over[A,setA].XY.Carrier) (BaseChange[l].Over[A0,A,set0,setA,h].phi.1 (p0 i)) (p i) ;
  uF0 : PolynomialIdentity[l].Over[A0,set0].XY.Carrier ;
  uG0 : PolynomialIdentity[l].Over[A0,set0].XY.Carrier ;
  identity0 : Identity A0 set0 n a0 F0 G0 p0 k uF0 uG0 ;
 } ;
 Statement : U l+ = (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (a : Fin n -> A.R) (F G : Bivariate[l].Over[A].Expr)
  (p : Fin n -> PolynomialIdentity[l].Over[A,setA].XY.Carrier) (k : Nat)
  (uF uG : PolynomialIdentity[l].Over[A,setA].XY.Carrier) -> Identity A setA n a F G p k uF uG ->
  Truncation[l+].Trunc[Descent[A,setA,n,a,F,G,p,k]].carrier ;
} ;
-- the interface: N and D
record Noetheriannote {
 calculus : Calculus ;
 reduction : Reduction[calculus].Statement ;
} ;
