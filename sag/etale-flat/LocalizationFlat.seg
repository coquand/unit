-- Localization of a flat algebra at the powers of one element is flat
-- (handoff §4).  j is not assumed regular.
--
-- Let C be flat over A and S = C[1/j], u the inverse of j in S.  Every
-- element of S is p u^d (a fraction p/j^d), and finitely many have a common
-- d (CommonPower.common-fin: p u^d = (p j^e) u^(d+e)).  Let
-- sum_i a_i b_i = 0 in S with b_i = u^d p_i.  Then u^d (sum_i a_i p_i) = 0,
-- so sum_i a_i p_i = 0 in S (u is a unit), so j^e sum_i a_i p_i = 0 in C for
-- some e (kernel of the localization).  Thus sum_i a_i (j^e p_i) = 0 in C, an
-- explained relation; its image in S multiplied by u^(d+e) explains
-- u^(d+e) j^e p_i = u^d p_i = b_i.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
-- every element of C[1/j] is p u^d, with a common d for finitely many
module Fractions (C : CRing) (j : C.R) {
 module L = PowerLocalization[l].Over[C,j] ;
 S : CRing = L.ring ;
 iota : RingHom[l].Hom C S = L.inclusion ;
 module PC = AffinePowers[l].Over[C] ; module PS = AffinePowers[l].Over[S] ;
 module LS = RL[S] ;
 u : S.R = L.invertible.1 ;
 power-one : (n : Nat) -> Id S.R (PS.power S.o n) S.o = split {
  zero -> refl S.o ; suc n | ih -> trans (ap (S.mul S.o) ih) (S.mulO S.o) } ;
 -- (iota j)^n u^n = 1
 cancel (n : Nat) : Id S.R (S.mul (PS.power (iota.1 j) n) (PS.power u n)) S.o =
  trans (sym (PS.power-mul (iota.1 j) u n)) (trans (ap (\ t -> PS.power t n) L.invertible.2) (power-one n)) ;
 iota-power (n : Nat) : Id S.R (iota.1 (PC.power j n)) (PS.power (iota.1 j) n) =
  AffinePowers[l].power-map C S iota j n ;
 -- p u^d, the fraction p / j^d
 Fraction (b : S.R) (d : Nat) : U l = (p : C.R) * Id S.R b (S.mul (PS.power u d) (iota.1 p)) ;
 fraction (q : L.L.Raw.Fraction) : Fraction (L.L.include q) q.2.2.1 =
  (q.1,calc S.R {
   L.L.include q =< sym (S.mulO (L.L.include q)) > S.mul (L.L.include q) S.o
    =< ap (S.mul (L.L.include q)) (sym (cancel q.2.2.1)) >
     S.mul (L.L.include q) (S.mul (PS.power (iota.1 j) q.2.2.1) (PS.power u q.2.2.1))
    =< S.mulA (L.L.include q) (PS.power (iota.1 j) q.2.2.1) (PS.power u q.2.2.1) >
     S.mul (S.mul (L.L.include q) (PS.power (iota.1 j) q.2.2.1)) (PS.power u q.2.2.1)
    =< ap (\ t -> S.mul t (PS.power u q.2.2.1))
        (trans (S.mulC (L.L.include q) (PS.power (iota.1 j) q.2.2.1))
         (trans (ap (\ t -> S.mul t (L.L.include q))
           (trans (sym (iota-power q.2.2.1)) (ap iota.1 (sym q.2.2.2))))
          (L.L.fraction-equation q))) >
     S.mul (iota.1 q.1) (PS.power u q.2.2.1)
    =< S.mulC (iota.1 q.1) (PS.power u q.2.2.1) > S.mul (PS.power u q.2.2.1) (iota.1 q.1) }) ;
 represent (b : S.R) : Tr.Trunc[(d : Nat) * Fraction b d].carrier =
  TC.map (L.L.Representatives b) ((d : Nat) * Fraction b d)
   (\ w -> (w.1.2.2.1,subst (\ t -> Fraction t w.1.2.2.1) w.2 (fraction w.1))) (L.L.representatives b) ;
 -- u^(d+e) (j^e p) = u^d p
 rescale (d e : Nat) (p : C.R) :
  Id S.R (S.mul (PS.power u (plus d e)) (iota.1 (C.mul (PC.power j e) p))) (S.mul (PS.power u d) (iota.1 p)) =
  calc S.R {
   S.mul (PS.power u (plus d e)) (iota.1 (C.mul (PC.power j e) p))
    =< Presentations[l].cong2 S.R S.mul _ _ _ _ (PS.power-add u d e)
        (trans (iota.2.2.2 (PC.power j e) p) (trans (ap (\ t -> S.mul t (iota.1 p)) (iota-power e))
         (S.mulC (PS.power (iota.1 j) e) (iota.1 p)))) >
     S.mul (S.mul (PS.power u d) (PS.power u e)) (S.mul (iota.1 p) (PS.power (iota.1 j) e))
    =< LS.mul-four (PS.power u d) (PS.power u e) (iota.1 p) (PS.power (iota.1 j) e) >
     S.mul (S.mul (PS.power u d) (iota.1 p)) (S.mul (PS.power u e) (PS.power (iota.1 j) e))
    =< ap (S.mul (S.mul (PS.power u d) (iota.1 p)))
        (trans (S.mulC (PS.power u e) (PS.power (iota.1 j) e)) (cancel e)) >
     S.mul (S.mul (PS.power u d) (iota.1 p)) S.o
    =< S.mulO (S.mul (PS.power u d) (iota.1 p)) > S.mul (PS.power u d) (iota.1 p) } ;
 monotone : CommonPower[l].Monotone S.R Fraction =
  \ b d e w -> (C.mul (PC.power j e) w.1,trans w.2 (sym (rescale d e w.1))) ;
 common (n : Nat) (b : Fin n -> S.R) : Tr.Trunc[(d : Nat) * ((i : Fin n) -> Fraction (b i) d)].carrier =
  CommonPower[l].common-fin n (\ i -> Fraction (b i)) (\ i -> monotone (b i)) (\ i -> represent (b i)) ;
 -- p = (iota j)^d s when s = u^d p
 numerator (s : S.R) (d : Nat) (w : Fraction s d) :
  Id S.R (iota.1 w.1) (S.mul (PS.power (iota.1 j) d) s) = calc S.R {
  iota.1 w.1 =< sym (LS.one-left (iota.1 w.1)) > S.mul S.o (iota.1 w.1)
   =< ap (\ t -> S.mul t (iota.1 w.1)) (sym (cancel d)) >
    S.mul (S.mul (PS.power (iota.1 j) d) (PS.power u d)) (iota.1 w.1)
   =< sym (S.mulA (PS.power (iota.1 j) d) (PS.power u d) (iota.1 w.1)) >
    S.mul (PS.power (iota.1 j) d) (S.mul (PS.power u d) (iota.1 w.1))
   =< ap (S.mul (PS.power (iota.1 j) d)) (sym w.2) > S.mul (PS.power (iota.1 j) d) s } ;
 unit-power (d : Nat) : RL[S].unit (PS.power u d) =
  (PS.power (iota.1 j) d,trans (S.mulC (PS.power u d) (PS.power (iota.1 j) d)) (cancel d)) ;
} ;
module Over (A C : CRing) (hC : RingHom[l].Hom A C) (flatC : FlatRelations[l].Over[A,C,hC].Flat) (j : C.R) {
 module Fr = Fractions[C,j] ;
 module L = Fr.L ; S : CRing = Fr.S ; iota : RingHom[l].Hom C S = Fr.iota ;
 H : RingHom[l].Hom A S = RingHom[l].compose A C S iota hC ;
 module OC = FlatRelations[l].Over[A,C,hC] ; module OS = FlatRelations[l].Over[A,S,H] ;
 module SC = FiniteIdeal[l].Sums[C] ; module SS = FiniteIdeal[l].Sums[S] ;
 module PC = Fr.PC ; module PS = Fr.PS ; module LS = Fr.LS ;
 u : S.R = Fr.u ;
 module Relation (n : Nat) (a : Fin n -> A.R) (b : Fin n -> S.R) (r : OS.Relation n a b)
  (d : Nat) (w : (i : Fin n) -> Fr.Fraction (b i) d) {
  p (i : Fin n) : C.R = (w i).1 ;
  sum : C.R = SC.lin n (\ i -> hC.1 (a i)) p ;
  -- u^d iota(sum_i a_i p_i) = sum_i a_i b_i = 0
  scaled : Id S.R (S.mul (PS.power u d) (iota.1 sum)) S.z = calc S.R {
   S.mul (PS.power u d) (iota.1 sum)
    =< ap (S.mul (PS.power u d)) (FlatRelations[l].MapSums[C,S,iota].lin n (\ i -> hC.1 (a i)) p) >
     S.mul (PS.power u d) (SS.lin n (\ i -> H.1 (a i)) (\ i -> iota.1 (p i)))
    =< sym (SS.lin-scale n (\ i -> H.1 (a i)) (\ i -> iota.1 (p i)) (PS.power u d)) >
     SS.lin n (\ i -> H.1 (a i)) (\ i -> S.mul (PS.power u d) (iota.1 (p i)))
    =< SS.sum-cong n (\ i -> S.mul (H.1 (a i)) (S.mul (PS.power u d) (iota.1 (p i))))
        (\ i -> S.mul (H.1 (a i)) (b i)) (\ i -> ap (S.mul (H.1 (a i))) (sym (w i).2)) >
     SS.lin n (\ i -> H.1 (a i)) b
    =< r > S.z } ;
  localized : Id S.R (iota.1 sum) S.z = LS.unit-reg (PS.power u d) (iota.1 sum) (Fr.unit-power d) scaled ;
  module Killed (k : L.Killed sum) {
   e : Nat = k.1 ;
   p' (i : Fin n) : C.R = C.mul (PC.power j e) (p i) ;
   relation : OC.Relation n a p' =
    trans (SC.lin-scale n (\ i -> hC.1 (a i)) p (PC.power j e)) k.2 ;
   result : OS.Explained n a b =
    OS.Ops[n,a].equal-mere (\ i -> S.mul (PS.power u (plus d e)) (iota.1 (p' i))) b
     (\ i -> trans (Fr.rescale d e (p i)) (sym (w i).2))
     (OS.Ops[n,a].scale-mere (PS.power u (plus d e)) (\ i -> iota.1 (p' i))
      (FlatRelations[l].Image[A,C,hC,S,H,iota,\ x -> refl (iota.1 (hC.1 x))].mere n a p'
       (flatC n a p' relation))) ;
  } ;
  result : OS.Explained n a b =
   TC.bind (L.Killed sum) (OS.Explanation[n,a,b]) (\ k -> Killed[k].result) (L.kernel sum localized) ;
 } ;
 flat : OS.Flat = \ n a b r ->
  TC.bind ((d : Nat) * ((i : Fin n) -> Fr.Fraction (b i) d)) (OS.Explanation[n,a,b])
   (\ w -> Relation[n,a,b,r,w.1,w.2].result) (Fr.common n b) ;
} ;
