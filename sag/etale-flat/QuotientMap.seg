-- A ring map psi : C0 -> C with psi(c0_i) = c_i induces a ring map
-- C0/(c0_1..c0_m) -> C/(c_1..c_m) on the quotient rings of RegularIdeal's
-- generated ideals: an element sum_i c0_i v_i goes to sum_i c_i psi(v_i), so
-- psi respects the two relations and descends (Quotient.Descend).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module Over (C0 C : CRing) (psi : RingHom[l].Hom C0 C) (m : Nat) (c0 : Fin m -> C0.R) (c : Fin m -> C.R)
 (sends : (i : Fin m) -> Id C.R (psi.1 (c0 i)) (c i)) {
 module G0 = RegularIdeal[l].Generated[C0,m,c0] ; module G = RegularIdeal[l].Generated[C,m,c] ;
 module Q0 = QuotientRing[l].Over[C0,G0.ideal,G0.in-prop] ; module Q = QuotientRing[l].Over[C,G.ideal,G.in-prop] ;
 module S0 = FiniteIdeal[l].Sums[C0] ; module SC = FiniteIdeal[l].Sums[C] ;
 module IL = RegularIdeal[l].IdealLaws[C,G.ideal] ;
 ideal (x : C0.R) (h : G0.In x) : G.In (psi.1 x) =
  TC.map (S0.Coordinates m c0 x) (SC.Coordinates m c (psi.1 x))
   (\ v -> (\ i -> psi.1 (v.1 i),
     trans (SC.sum-cong m (\ i -> C.mul (c i) (psi.1 (v.1 i))) (\ i -> C.mul (psi.1 (c0 i)) (psi.1 (v.1 i)))
       (\ i -> ap (\ t -> C.mul t (psi.1 (v.1 i))) (sym (sends i))))
      (trans (sym (FlatRelations[l].MapSums[C0,C,psi].lin m c0 v.1)) (ap psi.1 v.2)))) h ;
 difference (x y : C0.R) : Id C.R (psi.1 (C0.add x (C0.neg y))) (C.add (psi.1 x) (C.neg (psi.1 y))) =
  trans (psi.2.2.1 x (C0.neg y)) (ap (C.add (psi.1 x)) (RingHom[l].negation C0 C psi y)) ;
 respects (x y : C0.R) (h : Q0.Rel x y) : Id Q.Carrier (Q.include (psi.1 x)) (Q.include (psi.1 y)) =
  Q.Q.relates (psi.1 x) (psi.1 y) (IL.in-eq _ _ (difference x y) (ideal (C0.add x (C0.neg y)) h)) ;
 module D = Q0.Q.Descend[Q.Carrier,Q.set,\ x -> Q.include (psi.1 x),respects] ;
 preserves-add : (x y : Q0.Carrier) -> Id Q.Carrier (D.map (Q0.addQ x y)) (Q.addQ (D.map x) (D.map y)) =
  Q0.forall2 (\ x y -> Id Q.Carrier (D.map (Q0.addQ x y)) (Q.addQ (D.map x) (D.map y))) (\ x y -> Q.set _ _)
   (\ x y -> trans (ap D.map (Q0.Add.beta x y))
     (trans (D.beta (C0.add x y))
      (trans (ap Q.include (psi.2.2.1 x y))
       (trans (sym (Q.Add.beta (psi.1 x) (psi.1 y)))
        (Presentations[l].cong2 Q.Carrier Q.addQ _ _ _ _ (sym (D.beta x)) (sym (D.beta y))))))) ;
 preserves-mul : (x y : Q0.Carrier) -> Id Q.Carrier (D.map (Q0.mulQ x y)) (Q.mulQ (D.map x) (D.map y)) =
  Q0.forall2 (\ x y -> Id Q.Carrier (D.map (Q0.mulQ x y)) (Q.mulQ (D.map x) (D.map y))) (\ x y -> Q.set _ _)
   (\ x y -> trans (ap D.map (Q0.Multiply.beta x y))
     (trans (D.beta (C0.mul x y))
      (trans (ap Q.include (psi.2.2.2 x y))
       (trans (sym (Q.Multiply.beta (psi.1 x) (psi.1 y)))
        (Presentations[l].cong2 Q.Carrier Q.mulQ _ _ _ _ (sym (D.beta x)) (sym (D.beta y))))))) ;
 hom : RingHom[l].Hom Q0.ring Q.ring =
  (D.map,trans (D.beta C0.o) (ap Q.include psi.2.1),preserves-add,preserves-mul) ;
 on-include (x : C0.R) : Id Q.Carrier (hom.1 (Q0.include x)) (Q.include (psi.1 x)) = D.beta x ;
} ;
