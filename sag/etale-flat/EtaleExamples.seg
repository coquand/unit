-- Examples controlling the statements (handoff §8).  They keep the
-- Noetheriannote argument: no instance of N or D is invented.  They do not
-- replace the quantifiers of the theorems.
--   F = X,       G = Y   (J = 1)
--   F = X + X^2, G = Y   (J = 1 + 2X, nonlinear, any characteristic)
--   F = 0,       G = Y   (J = 0: S = A[X,Y][1/0] is the zero ring)
-- and the compatibility of the explicit lift of jacobian/Examples at order 3.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module T = Bivariate[l].Over[A] ; open T ;
 module P = PolynomialIdentity[l].Over[A,setA] ;
 module Coordinates = EtaleFlat2[l].Over[A,setA,xE,yE] ;
 module Nonlinear = EtaleFlat2[l].Over[A,setA,addE xE (mulE xE xE),yE] ;
 module Degenerate = EtaleFlat2[l].Over[A,setA,cE A.z,yE] ;
 -- S is flat over A with no hypothesis
 localization-flat : FlatRelations[l].Over[A,Nonlinear.Fr.S,Nonlinear.LF.H].Flat = Nonlinear.LF.flat ;
 -- J = 0 for F = 0, so S is the zero ring
 degenerate-jacobian : Id P.XY.Carrier Degenerate.RP.j P.XY.zeroQ =
  trans (Presentations[l].cong2 P.XY.Carrier P.XY.addQ _ _ _ _ (RL[P.XY.ring].zero-mul P.XY.oneQ)
    (ap P.XY.negQ (RL[P.XY.ring].zero-mul P.XY.zeroQ)))
   (trans (ap (P.XY.addQ P.XY.zeroQ) (RL[P.XY.ring].neg-zero)) (P.XY.add-zero P.XY.zeroQ)) ;
 degenerate-trivial : Id Degenerate.Fr.S.R Degenerate.Fr.S.o Degenerate.Fr.S.z =
  trans (sym Degenerate.Fr.L.invertible.2)
   (trans (ap (\ t -> Degenerate.Fr.S.mul t Degenerate.Fr.L.invertible.1)
     (trans (ap Degenerate.Fr.iota.1 degenerate-jacobian) (RingHom[l].zero P.XY.ring Degenerate.Fr.S Degenerate.Fr.iota)))
    (RL[Degenerate.Fr.S].zero-mul Degenerate.Fr.L.invertible.1)) ;
 -- the theorem, for the three examples, with no hypothesis
 coordinates-flat : DescentFlat[l].Over[A,setA].At[Coordinates.UB.M].Flat = Coordinates.module-flat ;
 nonlinear-flat : DescentFlat[l].Over[A,setA].At[Nonlinear.UB.M].Flat = Nonlinear.module-flat ;
 degenerate-flat : DescentFlat[l].Over[A,setA].At[Degenerate.UB.M].Flat = Degenerate.module-flat ;
 -- and through the conditional route
 module Under (nn : Noetheriannote[l].Noetheriannote) {
  coordinates : DescentFlat[l].Over[A,setA].At[Coordinates.UB.M].Flat =
   EtaleFlat2[l].Arbitrary[nn,A,setA,xE,yE].module-flat ;
  nonlinear : DescentFlat[l].Over[A,setA].At[Nonlinear.UB.M].Flat =
   EtaleFlat2[l].Arbitrary[nn,A,setA,addE xE (mulE xE xE),yE].module-flat ;
  degenerate : DescentFlat[l].Over[A,setA].At[Degenerate.UB.M].Flat =
   EtaleFlat2[l].Arbitrary[nn,A,setA,cE A.z,yE].module-flat ;
 } ;
} ;
-- x_3 of the lift of jacobian/Examples starts like x_2:  -T - T^2
module Lift (A : CRing) {
 open A ; open Poly[l].PolyR[A] ;
 module NL = Examples[l].Nonlinear[A] ;
 module C = TaylorCompatibility[l].Over[A,A,NL.identity,NL.F,NL.G,z,z,refl z,NL.invertible] ;
 two : Nat = suc (suc zero) ; three : Nat = suc two ;
 third-first : Id R (coef (C.x three) (suc zero)) (neg o) = trans (sym (C.x-compatible two (suc zero) tt)) NL.first ;
 third-second : Id R (coef (C.x three) two) (neg o) = trans (sym (C.x-compatible two two tt)) NL.second ;
 -- y stays 0 below degree 3 at orders 2 and 3
 third-y (k : Nat) (b : FiniteJets[l].Lt three k) : Id R (coef (C.y three) k) z =
  trans (sym (C.y-compatible two k b)) (NL.y-coefficients k b) ;
} ;
