-- Flatness of B = A[X,Y][1/J]/(F,G) over A (handoff §5, §6).
--
-- The construction, for any commutative set-ring A and F, G in A[X,Y]
-- (bivariate expressions, J their Jacobian determinant):
--   R = A[X][Y],  S = R[1/J] (PowerLocalization),
--   B = S/(F,G) (QuotientRing of the ideal generated by F and G).
-- S is flat over A (PolynomialFlat, LocalizationFlat), with no hypothesis.
-- For every A, F and G form a regular pair modulo every (a_1..a_m)S
-- (RegularCoded), so B is flat (QuotientFlat), as relations and as a module
-- of the library (FlatRelations.Bridge): Over.flat, Over.module-flat, with
-- no hypothesis.  Over.Noetherian (under Calculus) and Arbitrary (under
-- Noetheriannote) are the earlier conditional route, kept for reference.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (F G : Bivariate[l].Over[A].Expr) {
 module P = PolynomialIdentity[l].Over[A,setA] ;
 module RP = RegularPolynomial[l].Over[A,setA,F,G] ;
 module Fr = LocalizationFlat[l].Fractions[P.XY.ring,RP.j] ;
 -- S = A[X,Y][1/J] is flat over A
 module LF = LocalizationFlat[l].Over[A,P.XY.ring,P.inclusion,PolynomialFlat[l].TwoVariables[A,setA].flat,RP.j] ;
 f : Fr.S.R = Fr.iota.1 (P.formal F) ; g : Fr.S.R = Fr.iota.1 (P.formal G) ;
 -- B = S/(F,G)
 module QF = QuotientFlat[l].Over[A,Fr.S,LF.H,LF.flat,f,g] ;
 B : CRing = QF.B ;
 setB : Pr.isSet B.R = QF.Q.set ;
 -- the A-module underlying B
 module UB = FlatRelations[l].Over[A,B,QF.HB].Underlying[setA,setB] ;
 -- Any A, with no hypothesis: the pair (F, G) is regular modulo every (a)S
 -- (RegularCoded: coded subrings, Hilbert's basis theorem over Z).
 regularity : RegularPair[l].Over[A,setA,F,G].PairRegular = RegularCoded[l].Over[A,setA,F,G].regularity ;
 flat : FlatRelations[l].Over[A,B,QF.HB].Flat = QF.Theorem[regularity].flat ;
 module-flat : DescentFlat[l].Over[A,setA].At[UB.M].Flat =
  FlatRelations[l].Over[A,B,QF.HB].Bridge[setA,setB,flat].theorem ;
 -- the earlier route, under Noetheriannote.Calculus (kept; superseded)
 module Noetherian (nc : Noetheriannote[l].Calculus) (noeth : nc.Noeth A setA) {
  module RPair = RegularPair[l].Over[A,setA,F,G].Noetherian[nc,noeth] ;
  -- every finite relation in B is explained
  noetherian-flat : FlatRelations[l].Over[A,B,QF.HB].Flat = QF.Theorem[RPair.regularity].flat ;
  -- DescentFlat's predicate for the underlying module
  noetherian-module-flat : DescentFlat[l].Over[A,setA].At[UB.M].Flat =
   FlatRelations[l].Over[A,B,QF.HB].Bridge[setA,setB,noetherian-flat].theorem ;
 } ;
} ;
-- Any A, under Noetheriannote (handoff §6).
-- Let sum_i a_i b_i = 0 in B.  Lift b_i to S and write the lifts as
-- u^d iota(P_i) (common d).  Then Y = sum_i a_i P_i satisfies
-- iota(Y) = iota(J)^d sum_i a_i lift_i, which is in (F,G)S; so
-- J^k Y = F uF + G uG in R for some k (LocalizedReduction): this is (D1).
-- D realises these data and (D1) over a noetherian A0 (h : A0 -> A).  Over
-- A0, (D1) says that beta_i = J0^k p0_i satisfy sum_i a0_i beta_i = 0 in B0,
-- so they are explained (Noetherian).  The ring map B0 -> B (polynomials,
-- localization, quotient) sends beta_i to J^k P_i, and the explanation along
-- h; multiplying by u^(d+k) gives u^d iota(P_i) = b_i.  No flatness is
-- transported from A0 to A: only this finite certificate.
module Arbitrary (nn : Noetheriannote[l].Noetheriannote) (A : CRing) (setA : Pr.isSet A.R)
 (F G : Bivariate[l].Over[A].Expr) {
 module E = Over[A,setA,F,G] ;
 module RD = Noetheriannote[l].Reduction[nn.calculus] ;
 module OB = FlatRelations[l].Over[A,E.B,E.QF.HB] ;
 module SR = FiniteIdeal[l].Sums[E.P.XY.ring] ; module SS = FiniteIdeal[l].Sums[E.Fr.S] ;
 module SB = FiniteIdeal[l].Sums[E.B] ;
 module PR = AffinePowers[l].Over[E.P.XY.ring] ;
 module EI = EtaleIdentities[l] ;
 pairR : Fin E.QF.two -> E.P.XY.Carrier = split { inl i -> E.P.formal G ; inr t -> E.P.formal F } ;
 module KP = LocalizedReduction[l].Over[E.P.XY.ring,E.RP.j,E.QF.two,pairR] ;
 module Relation (n : Nat) (a : Fin n -> A.R) (b : Fin n -> E.B.R) (r : OB.Relation n a b)
  (s : (i : Fin n) -> (x : E.Fr.S.R) * Id E.B.R (E.QF.pi.1 x) (b i)) (d : Nat)
  (w : (i : Fin n) -> E.Fr.Fraction (s i).1 d) {
  P (i : Fin n) : E.P.XY.Carrier = (w i).1 ;
  Y : E.P.XY.Carrier = SR.lin n (\ i -> E.P.inclusion.1 (a i)) P ;
  X : E.Fr.S.R = SS.lin n (\ i -> E.LF.H.1 (a i)) (\ i -> (s i).1) ;
  X-zero : Id E.B.R (E.QF.pi.1 X) E.B.z =
   trans (FlatRelations[l].MapSums[E.Fr.S,E.B,E.QF.pi].lin n (\ i -> E.LF.H.1 (a i)) (\ i -> (s i).1))
    (trans (SB.sum-cong n (\ i -> E.B.mul (E.QF.HB.1 (a i)) (E.QF.pi.1 (s i).1)) (\ i -> E.B.mul (E.QF.HB.1 (a i)) (b i))
      (\ i -> ap (E.B.mul (E.QF.HB.1 (a i))) (s i).2)) r) ;
  -- X = u^d iota(Y)
  X-fraction : Id E.Fr.S.R X (E.Fr.S.mul (E.Fr.PS.power E.Fr.u d) (E.Fr.iota.1 Y)) = calc E.Fr.S.R {
   X =< SS.sum-cong n (\ i -> E.Fr.S.mul (E.LF.H.1 (a i)) (s i).1)
        (\ i -> E.Fr.S.mul (E.LF.H.1 (a i)) (E.Fr.S.mul (E.Fr.PS.power E.Fr.u d) (E.Fr.iota.1 (P i))))
        (\ i -> ap (E.Fr.S.mul (E.LF.H.1 (a i))) (w i).2) >
     SS.lin n (\ i -> E.LF.H.1 (a i)) (\ i -> E.Fr.S.mul (E.Fr.PS.power E.Fr.u d) (E.Fr.iota.1 (P i)))
    =< SS.lin-scale n (\ i -> E.LF.H.1 (a i)) (\ i -> E.Fr.iota.1 (P i)) (E.Fr.PS.power E.Fr.u d) >
     E.Fr.S.mul (E.Fr.PS.power E.Fr.u d) (SS.lin n (\ i -> E.LF.H.1 (a i)) (\ i -> E.Fr.iota.1 (P i)))
    =< ap (E.Fr.S.mul (E.Fr.PS.power E.Fr.u d))
        (sym (FlatRelations[l].MapSums[E.P.XY.ring,E.Fr.S,E.Fr.iota].lin n (\ i -> E.P.inclusion.1 (a i)) P)) >
     E.Fr.S.mul (E.Fr.PS.power E.Fr.u d) (E.Fr.iota.1 Y) } ;
  iota-Y : Id E.Fr.S.R (E.Fr.iota.1 Y) (E.Fr.S.mul (E.Fr.PS.power (E.Fr.iota.1 E.RP.j) d) X) =
   E.Fr.numerator X d (Y,X-fraction) ;
  in-Y : KP.IS.In (E.Fr.iota.1 Y) =
   TruncationCombinators[l].map (SS.Coordinates E.QF.two E.QF.pair (E.Fr.iota.1 Y))
    (SS.Coordinates E.QF.two (\ i -> E.Fr.iota.1 (pairR i)) (E.Fr.iota.1 Y)) (\ c -> c)
    (RegularIdeal[l].IdealLaws[E.Fr.S,E.QF.Gen.ideal].in-eq _ _ (sym iota-Y)
     (E.QF.Gen.ideal.in-mul (E.Fr.PS.power (E.Fr.iota.1 E.RP.j) d) X (E.QF.Q.kernel X X-zero))) ;
  module Clear (cl : KP.Cleared Y) {
   k : Nat = cl.1 ;
   Q : Fin E.QF.two -> E.P.XY.Carrier = cl.2.1 ;
   uF : E.P.XY.Carrier = Q (inr tt) ; uG : E.P.XY.Carrier = Q (inl (inr tt)) ;
   -- (D1): J^k sum_i a_i P_i = F uF + G uG
   identity : RD.Identity A setA n a F G P k uF uG =
    trans (sym cl.2.2) (ap (E.P.XY.addQ (E.P.XY.mulQ (E.P.formal F) uF)) (E.P.XY.add-zero (E.P.XY.mulQ (E.P.formal G) uG))) ;
   module Descended (D : RD.Descent[A,setA,n,a,F,G,P,k]) {
    module E0 = Over[D.A0,D.set0,D.F0,D.G0] ;
    module BC = BaseChange[l].Over[D.A0,A,D.set0,setA,D.h] ;
    module SR0 = FiniteIdeal[l].Sums[E0.P.XY.ring] ; module SB0 = FiniteIdeal[l].Sums[E0.B] ;
    formal-F : Id E.P.XY.Carrier (BC.phi.1 (E0.P.formal D.F0)) (E.P.formal F) = trans (BC.formal D.F0) (ap E.P.formal D.F-image) ;
    formal-G : Id E.P.XY.Carrier (BC.phi.1 (E0.P.formal D.G0)) (E.P.formal G) = trans (BC.formal D.G0) (ap E.P.formal D.G-image) ;
    jacobian : Id E.P.XY.Carrier (BC.phi.1 E0.RP.j) E.RP.j =
     trans (BC.jacobian D.F0 D.G0)
      (trans (ap (\ e -> E.P.Canon.jacobian E.P.x E.P.y e (BC.map D.G0)) D.F-image)
       (ap (\ e -> E.P.Canon.jacobian E.P.x E.P.y F e) D.G-image)) ;
    phi-power (m : Nat) : Id E.P.XY.Carrier (BC.phi.1 (E0.Fr.PC.power E0.RP.j m)) (PR.power E.RP.j m) =
     trans (AffinePowers[l].power-map E0.P.XY.ring E.P.XY.ring BC.phi E0.RP.j m) (ap (\ t -> PR.power t m) jacobian) ;
    -- the localization map S0 -> S
    iota-phi : RingHom[l].Hom E0.P.XY.ring E.Fr.S = RingHom[l].compose E0.P.XY.ring E.P.XY.ring E.Fr.S E.Fr.iota BC.phi ;
    unit-power (m : Nat) : RL[E.Fr.S].unit (E.Fr.iota.1 (PR.power E.RP.j m)) =
     subst (RL[E.Fr.S].unit) (sym (E.Fr.iota-power m))
      (AffinePowers[l].Over[E.Fr.S].Units[E.Fr.L.set].power-unit (E.Fr.iota.1 E.RP.j) E.Fr.L.invertible m) ;
    units (t : E0.P.XY.Carrier) (ht : E0.Fr.L.Powers t) : RL[E.Fr.S].unit (iota-phi.1 t) =
     subst (\ x -> RL[E.Fr.S].unit (E.Fr.iota.1 (BC.phi.1 x))) (sym ht.2)
      (subst (\ x -> RL[E.Fr.S].unit (E.Fr.iota.1 x)) (sym (phi-power ht.1)) (unit-power ht.1)) ;
    module MLM = MonoidLocalizationMap[l].Over[E0.P.XY.ring,E0.Fr.L.Powers,E0.Fr.L.one,E0.Fr.L.product,
     E.Fr.S,E.Fr.L.set,iota-phi,units] ;
    psiS : RingHom[l].Hom E0.Fr.S E.Fr.S = MLM.hom ;
    psiS-iota (x : E0.P.XY.Carrier) : Id E.Fr.S.R (psiS.1 (E0.Fr.iota.1 x)) (E.Fr.iota.1 (BC.phi.1 x)) = MLM.constants x ;
    -- the quotient map B0 -> B
    sends : (i : Fin E.QF.two) -> Id E.Fr.S.R (psiS.1 (E0.QF.pair i)) (E.QF.pair i) = split {
     inl i -> trans (psiS-iota (E0.P.formal D.G0)) (ap E.Fr.iota.1 formal-G) ;
     inr t -> trans (psiS-iota (E0.P.formal D.F0)) (ap E.Fr.iota.1 formal-F) } ;
    module QM = QuotientMap[l].Over[E0.Fr.S,E.Fr.S,psiS,E.QF.two,E0.QF.pair,E.QF.pair,sends] ;
    psiB : RingHom[l].Hom E0.B E.B = QM.hom ;
    over (c : D.A0.R) : Id E.B.R (psiB.1 (E0.QF.HB.1 c)) (E.QF.HB.1 (D.h.1 c)) =
     trans (QM.on-include (E0.Fr.iota.1 (E0.P.inclusion.1 c)))
      (ap E.QF.Q.include (trans (psiS-iota (E0.P.inclusion.1 c)) (ap E.Fr.iota.1 (BC.on-constants c)))) ;
    -- beta_i = J0^k p0_i in B0, and sum_i a0_i beta_i = 0 by (D1) over A0
    beta (i : Fin n) : E0.B.R = E0.QF.pi.1 (E0.Fr.iota.1 (E0.P.XY.mulQ (E0.Fr.PC.power E0.RP.j k) (D.p0 i))) ;
    to-B0 : RingHom[l].Hom E0.P.XY.ring E0.B = RingHom[l].compose E0.P.XY.ring E0.Fr.S E0.B E0.QF.pi E0.Fr.iota ;
    relation0 : FlatRelations[l].Over[D.A0,E0.B,E0.QF.HB].Relation n D.a0 beta = calc E0.B.R {
     SB0.lin n (\ i -> E0.QF.HB.1 (D.a0 i)) beta
      =< sym (FlatRelations[l].MapSums[E0.P.XY.ring,E0.B,to-B0].lin n (\ i -> E0.P.inclusion.1 (D.a0 i))
          (\ i -> E0.P.XY.mulQ (E0.Fr.PC.power E0.RP.j k) (D.p0 i))) >
       to-B0.1 (SR0.lin n (\ i -> E0.P.inclusion.1 (D.a0 i)) (\ i -> E0.P.XY.mulQ (E0.Fr.PC.power E0.RP.j k) (D.p0 i)))
      =< ap to-B0.1 (trans (SR0.lin-scale n (\ i -> E0.P.inclusion.1 (D.a0 i)) D.p0 (E0.Fr.PC.power E0.RP.j k)) D.identity0) >
       to-B0.1 (E0.P.XY.addQ (E0.P.XY.mulQ (E0.P.formal D.F0) D.uF0) (E0.P.XY.mulQ (E0.P.formal D.G0) D.uG0))
      =< trans (to-B0.2.2.1 (E0.P.XY.mulQ (E0.P.formal D.F0) D.uF0) (E0.P.XY.mulQ (E0.P.formal D.G0) D.uG0))
          (Presentations[l].cong2 E0.B.R E0.B.add _ _ _ _
           (trans (to-B0.2.2.2 (E0.P.formal D.F0) D.uF0) (ap (\ t -> E0.B.mul t (to-B0.1 D.uF0)) E0.QF.f-zero))
           (trans (to-B0.2.2.2 (E0.P.formal D.G0) D.uG0) (ap (\ t -> E0.B.mul t (to-B0.1 D.uG0)) E0.QF.g-zero))) >
       E0.B.add (E0.B.mul E0.B.z (to-B0.1 D.uF0)) (E0.B.mul E0.B.z (to-B0.1 D.uG0))
      =< EI.ZeroCombination[E0.B,to-B0.1 D.uF0,to-B0.1 D.uG0].proof > E0.B.z } ;
    explained0 : FlatRelations[l].Over[D.A0,E0.B,E0.QF.HB].Explained n D.a0 beta =
     E0.Noetherian[nn.calculus,D.noeth].noetherian-flat n D.a0 beta relation0 ;
    transported : OB.Explained n a (\ i -> psiB.1 (beta i)) =
     FlatRelations[l].AlongBase[D.A0,A,D.h,E0.B,E0.QF.HB,E.B,E.QF.HB,psiB,over].mere n D.a0 a D.a-image beta explained0 ;
    image (i : Fin n) : Id E.B.R (psiB.1 (beta i)) (E.QF.pi.1 (E.Fr.iota.1 (E.P.XY.mulQ (PR.power E.RP.j k) (P i)))) =
     trans (QM.on-include (E0.Fr.iota.1 (E0.P.XY.mulQ (E0.Fr.PC.power E0.RP.j k) (D.p0 i))))
      (ap E.QF.Q.include (trans (psiS-iota (E0.P.XY.mulQ (E0.Fr.PC.power E0.RP.j k) (D.p0 i)))
       (ap E.Fr.iota.1 (trans (BC.phi.2.2.2 (E0.Fr.PC.power E0.RP.j k) (D.p0 i))
        (Presentations[l].cong2 E.P.XY.Carrier E.P.XY.mulQ _ _ _ _ (phi-power k) (D.p-image i)))))) ;
    scale : E.B.R = E.QF.pi.1 (E.Fr.PS.power E.Fr.u (plus d k)) ;
    final (i : Fin n) : Id E.B.R (E.B.mul scale (psiB.1 (beta i))) (b i) = calc E.B.R {
     E.B.mul scale (psiB.1 (beta i))
      =< ap (E.B.mul scale) (image i) > E.B.mul scale (E.QF.pi.1 (E.Fr.iota.1 (E.P.XY.mulQ (PR.power E.RP.j k) (P i))))
      =< sym (E.QF.pi.2.2.2 (E.Fr.PS.power E.Fr.u (plus d k)) (E.Fr.iota.1 (E.P.XY.mulQ (PR.power E.RP.j k) (P i)))) >
       E.QF.pi.1 (E.Fr.S.mul (E.Fr.PS.power E.Fr.u (plus d k)) (E.Fr.iota.1 (E.P.XY.mulQ (PR.power E.RP.j k) (P i))))
      =< ap E.QF.pi.1 (E.Fr.rescale d k (P i)) > E.QF.pi.1 (E.Fr.S.mul (E.Fr.PS.power E.Fr.u d) (E.Fr.iota.1 (P i)))
      =< ap E.QF.pi.1 (sym (w i).2) > E.QF.pi.1 (s i).1
      =< (s i).2 > b i } ;
    result : OB.Explained n a b =
     OB.Ops[n,a].equal-mere (\ i -> E.B.mul scale (psiB.1 (beta i))) b final
      (OB.Ops[n,a].scale-mere scale (\ i -> psiB.1 (beta i)) transported) ;
   } ;
   result : OB.Explained n a b =
    Truncation[l+].Trunc[RD.Descent[A,setA,n,a,F,G,P,k]].induction @l (\ t -> OB.Explained n a b)
     (\ t -> Tr.Trunc[OB.Explanation[n,a,b]].proposition) (\ D -> Descended[D].result)
     (nn.reduction A setA n a F G P k uF uG identity) ;
  } ;
  result : OB.Explained n a b = TC.bind (KP.Cleared Y) (OB.Explanation[n,a,b]) (\ cl -> Clear[cl].result) (KP.kernel Y in-Y) ;
 } ;
 -- every finite relation in B is explained
 flat : OB.Flat = \ n a b r ->
  TC.bind ((i : Fin n) -> (x : E.Fr.S.R) * Id E.B.R (E.QF.pi.1 x) (b i)) (OB.Explanation[n,a,b])
   (\ s -> TC.bind ((d : Nat) * ((i : Fin n) -> E.Fr.Fraction (s i).1 d)) (OB.Explanation[n,a,b])
     (\ w -> Relation[n,a,b,r,s,w.1,w.2].result) (E.Fr.common n (\ i -> (s i).1)))
   (AffineFinite[l].choice n (\ i -> (x : E.Fr.S.R) * Id E.B.R (E.QF.pi.1 x) (b i)) (\ i -> E.QF.lift (b i))) ;
 -- DescentFlat's predicate for the A-module underlying B
 module-flat : DescentFlat[l].Over[A,setA].At[E.UB.M].Flat =
  FlatRelations[l].Over[A,E.B,E.QF.HB].Bridge[setA,E.setB,flat].theorem ;
} ;
