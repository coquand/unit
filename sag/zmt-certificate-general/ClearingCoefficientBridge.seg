-- The constructed cleared ring element has the full Laurent coefficient
-- function f(m-L), not only its values at ordinary natural exponents.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module L = GenericLaurent[l] ; module X = LaurentExponentBridge[l] ; module CD = ChartDenominators[l] ;
module LP = LaurentPolynomialCoefficients[l] ; module CP = ChartPolynomialization[l] ; module B = GenericSupport[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module C = CP.Over[A,setA] ; module P = LP.Over[A,setA] ;
 module Clear (n : Nat) (s : Sub n) (support : List (L.Exp n)) (f : L.Exp n -> A.R)
  (supp : (m : L.Exp n) -> (L.Mem (L.Exp n) m support -> Empty) -> Id A.R (f m) A.z)
  (van : (m : L.Exp n) -> B.bad n (L.mask n m) s -> Id A.R (f m) A.z) {
  module F = C.Clear[n,s,support,f,supp,van] ;
  cases (m : L.Exp n) : (sg : LP.Sign n m) -> Id A.R (P.At[n].coeff F.cleared m) (F.raw m) = split {
   inl p -> trans (P.At[n].positive F.cleared p.1 m p.2 (LP.classify n m))
     (trans (F.coefficients p.1) (ap (\ m -> f (CD.down n m F.C.u)) p.2)) ;
   inr p -> trans (P.At[n].coeff-neg F.cleared m p.1 p.2) (sym (F.polynomial m p.1 p.2)) } ;
  equation (m : L.Exp n) : Id A.R (P.At[n].coeff F.cleared m) (f (CD.down n m F.C.u)) = cases m (LP.classify n m) ;
 } ;
} ;
