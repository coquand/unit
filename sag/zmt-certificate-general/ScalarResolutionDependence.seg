-- Direct scalar-cochain statement of generic dependence. The internal
-- F0 is a rank-one family; this wrapper embeds scalar cochains, uses the
-- constructed theorem, and evaluates its final identity at the sole
-- coordinate. Thus even the rank-one-family wrapper is absent from inputs.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module IP = IdealPowers[l] ; module K = GenericDegree[l] ;
module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) (extra : Nat) {
 module T = GenericResolutionDependence[l].Over[K0,D,setD,cfn,extra] ;
 module CE = GenericCech[l].Over[D,setD] ; module CT = GenericCechTheorems[l].Over[D,setD] ;
 module Input (a : Nat) (d : Ps.Fin a -> Base.Nat) (g : Ps.Fin a -> List (T.P.P.Term T.nvar))
  (hg : (i : Ps.Fin a) -> T.P.HR.HomShift zero (d i) (g i)) {
  module I = T.Input[a,d,g,hg] ;
  module C0 = CE.Cochains[T.nvar,negsuc zero,K.topRank (suc zero)] ;
  module C1 = CE.Cochains[T.nvar,negsuc zero,K.topRank (suc (suc zero))] ;
  module C2 = CE.Cochains[T.nvar,negsuc zero,K.topRank (suc (suc (suc zero)))] ;
  module D0 = CT.Linear[T.nvar,negsuc zero,K.topRank (suc zero)] ;
  module D1 = CT.Linear[T.nvar,negsuc zero,K.topRank (suc (suc zero))] ;
  module CL = IP.ModL[D,C1.mod] ;
  Lifted (c : C1.El) : U l = (u : I.U2.El) * Id C2.El (D1.d.f c) (I.A2.A.lin.f u (inr tt)) ;
  Bdry (c : C1.El) : U l = (h : C0.El) * ((u : I.U1.El) * Id C1.El c (C1.mod.madd (D0.d.f h) (I.A1.A.lin.f u (inr tt)))) ;
  module Seq (c : Nat -> C1.El) (lift : (j : Nat) -> Tr.Trunc[Lifted (c j)].carrier) {
   family (j : Nat) : I.F1.El = \ i -> c j ;
   top-lift (j : Nat) (u : I.U2.El) (eq : Id C2.El (D1.d.f (c j)) (I.A2.A.lin.f u (inr tt))) :
    (t : Top) -> Id C2.El (I.D1.lin.f (family j) (inr t)) (I.A2.A.lin.f u (inr t)) = split { tt -> eq } ;
   lift-at (j : Nat) (u : I.U2.El) (eq : Id C2.El (D1.d.f (c j)) (I.A2.A.lin.f u (inr tt))) :
    (i : Ps.Fin (suc zero)) -> Id C2.El (I.D1.lin.f (family j) i) (I.A2.A.lin.f u i) = split {
    inl i -> absurd (Id C2.El (I.D1.lin.f (family j) (inl i)) (I.A2.A.lin.f u (inl i))) i ;
    inr t -> top-lift j u eq t } ;
   family-lift (j : Nat) : Tr.Trunc[I.Lifted (family j)].carrier =
    TC.map (Lifted (c j)) (I.Lifted (family j)) (\ u -> (u.1,I.F2.Prod.ext _ _ (lift-at j u.1 u.2))) (lift j) ;
   module S = I.Seq[family,family-lift] ;
   sumL : List D.R -> C1.El = split {
    nil -> C1.mod.mz ; cons q qs | rec -> C1.mod.madd (C1.mod.sm q (c (len qs))) rec } ;
   sum-comparison : (qs : List D.R) -> Id C1.El (S.sumL qs (inr tt)) (sumL qs) = split {
    nil -> refl C1.mod.mz ;
    cons q qs | rec -> ap (C1.mod.madd (C1.mod.sm q (c (len qs)))) rec } ;
   Result : U l = (qs : List D.R) * Tr.Trunc[Bdry (CL.msub (c (len qs)) (sumL qs))].carrier ;
   module Convert (qs : List D.R) (w : I.Bdry (I.FL.msub (family (len qs)) (S.sumL qs))) {
    equation : Id C1.El (CL.msub (c (len qs)) (sumL qs))
     (C1.mod.madd (D0.d.f (w.1 (inr tt))) (I.A1.A.lin.f w.2.1 (inr tt))) =
      trans (sym (ap (CL.msub (c (len qs))) (sum-comparison qs))) (ap (\ z -> z (inr tt)) w.2.2) ;
    boundary : Bdry (CL.msub (c (len qs)) (sumL qs)) = (w.1 (inr tt),(w.2.1,equation)) ;
   } ;
   convert (x : S.Result) : Result = (x.1,
    TC.map (I.Bdry (I.FL.msub (family (len x.1)) (S.sumL x.1))) (Bdry (CL.msub (c (len x.1)) (sumL x.1)))
      (\ w -> Convert[x.1,w].boundary) x.2) ;
   dependence : Tr.Trunc[Result].carrier = TC.map S.Result Result convert S.dependence ;
  } ;
 } ;
} ;
