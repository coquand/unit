-- Term-list multiplication agrees with multiplication in the generic
-- polynomial tower. The proved Laurent action comparison and its composition
-- law give this by coefficient extensionality. Finite polynomial sums are
-- compared separately with finite ring sums.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module E = FiniteExponents[l] ; module IP = IdealPowers[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module T = CoefficientPolynomial[l].CoefficientTower[A,setA] ; module P = PolynomialTowerBridge[l].Over[A,setA] ;
 module B = TowerLaurentAction[l].Over[A,setA] ; module TA = B.At[n] ; module FA = TA.FA ;
 module X = LaurentExponentBridge[l].At[n] ; module LC = B.LC.At[n] ; module R = RL[T.D n] ;
 module SS = Comb[l].Sums[T.D n,IP.regular (T.D n)] ;
 product (p q : FA.Polys) : Id (T.D n).R (P.phi n (FA.pmul p q)) ((T.D n).mul (P.phi n p) (P.phi n q)) =
  P.ext n _ _ (\ v -> calc A.R {
   P.Coeff n (P.phi n (FA.pmul p q)) v
    =< sym (LC.coeff-emb (P.phi n (FA.pmul p q)) v) > LC.coeff (P.phi n (FA.pmul p q)) (X.emb v)
    =< ap (\ x -> LC.coeff x (X.emb v)) (sym ((T.D n).mulO (P.phi n (FA.pmul p q))))
    > LC.coeff ((T.D n).mul (P.phi n (FA.pmul p q)) (T.D n).o) (X.emb v)
    =< sym (TA.action (FA.pmul p q) (T.D n).o (X.emb v)) > FA.mulP (FA.pmul p q) (LC.coeff (T.D n).o) (X.emb v)
    =< FA.mulP-pmul p q (LC.coeff (T.D n).o) (X.emb v)
    > FA.mulP p (\ m -> FA.mulP q (LC.coeff (T.D n).o) m) (X.emb v)
    =< FA.mulP-cong p _ _ (\ m -> trans (TA.action q (T.D n).o m) (ap (\ x -> LC.coeff x m) ((T.D n).mulO (P.phi n q)))) (X.emb v)
    > FA.mulP p (LC.coeff (P.phi n q)) (X.emb v)
    =< TA.action p (P.phi n q) (X.emb v) > LC.coeff ((T.D n).mul (P.phi n p) (P.phi n q)) (X.emb v)
    =< LC.coeff-emb ((T.D n).mul (P.phi n p) (P.phi n q)) v > P.Coeff n ((T.D n).mul (P.phi n p) (P.phi n q)) v }) ;
 append : (p q : FA.Polys) -> Id (T.D n).R (P.phi n (Bar[l].app p q)) ((T.D n).add (P.phi n p) (P.phi n q)) = split {
  nil -> \ q -> sym (R.zl (P.phi n q)) ;
  cons t p | rec -> \ q -> trans (ap ((T.D n).add (P.term n t)) (rec q)) ((T.D n).addA (P.term n t) (P.phi n p) (P.phi n q)) } ;
 sum : (a : Nat) (p : Ps.Fin a -> FA.Polys) -> Id (T.D n).R (P.phi n (FA.psum a p)) (SS.sum a (\ i -> P.phi n (p i))) = split {
  zero -> \ p -> refl (T.D n).z ;
  suc a | rec -> \ p -> trans (append (p (inr tt)) (FA.psum a (\ i -> p (inl i))))
    (ap ((T.D n).add (P.phi n (p (inr tt)))) (rec (\ i -> p (inl i)))) } ;
} ;
