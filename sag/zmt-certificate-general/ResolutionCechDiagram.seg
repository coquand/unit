-- Actual generic Cech double complex of a constructed finite homogeneous
-- polynomial resolution, extended by zero. The cursor convention identifies
-- each next target with the present source by definition. Ring matrix
-- identities give zero composites on all charts, and polynomial action
-- commutes with the alternating differential.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module E = FiniteExponents[l] ; module PA = PolynomialAction4[l] ; module K = GenericDegree[l] ;
module R = FinitePolynomialResolution[l] ;
module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) (nvar : Nat) {
 module C = R.Over[K0,D,setD,cfn,nvar] ;
 module M = ShiftedMatrixAction[l].Over[D,setD,nvar] ; module CE = GenericCech[l].Over[D,setD] ;
 module CY = GenericCube[l].Over[D,setD] ; module Laws = MatrixActionLaws[l].Over[D,setD,nvar] ;
 module G = GlobalCechSyzygies[l].Over[D,setD,nvar] ;
 base : Int = negsuc zero ;
 twists (S : R.Free) (j : Ps.Fin S.rank) : Int = PA.minus base (S.shifts j) ;
 convert (dd ee : Base.Nat) : (p : List (C.P.Term nvar)) -> C.HR.HomShift dd ee p -> M.HomShift dd ee p = split {
  nil -> \ h -> tt ; cons t p | rec -> \ h -> (h.1,rec h.2) } ;
 module Action (S Q : R.Free) (f : C.Arrow[S,Q]) (card : Nat) {
  hs (i : Ps.Fin S.rank) (j : Ps.Fin Q.rank) : M.A.Shifts (twists S i) (twists Q j) (f.polys i j) =
   M.shifts base (Q.shifts j) (S.shifts i) (f.polys i j) (convert (Q.shifts j) (S.shifts i) (f.polys i j) (f.homogeneous i j)) ;
  module A = M.Matrix[Q.rank,S.rank,twists Q,twists S,\ j i -> f.polys i j,\ j i -> hs i j,K.topRank card] ;
 } ;
 module Instance (cursor : C.Cursor) {
  object (i : Nat) : R.Free = C.Layer cursor i ;
  F (i card : Nat) : IP.Mod[D] = M.Family[(object i).rank,twists (object i),K.topRank card].mod ;
  d (i card : Nat) : IP.Lin[D,F i card,F i (suc card)] = M.Differential[(object i).rank,twists (object i),K.topRank card].lin ;
  A (i card : Nat) : IP.Lin[D,F (suc i) card,F i card] = Action[object (suc i),object i,C.arrow cursor i,card].A.lin ;
  comm (i card : Nat) (x : (F (suc i) card).M) :
   Id (F i (suc card)).M ((d i card).f ((A i card).f x)) ((A i (suc card)).f ((d (suc i) card).f x)) =
   M.Comm[(object i).rank,(object (suc i)).rank,twists (object i),twists (object (suc i)),
    \ j l -> (C.arrow cursor i).polys l j,\ j l -> Action[object (suc i),object i,C.arrow cursor i,card].hs l j,K.topRank card].equation x ;
  kill (i card : Nat) (x : (F (suc (suc i)) card).M) :
   Id (F i card).M ((A i card).f ((A (suc i) card).f x)) (F i card).mz =
   Laws.Composite[(object (suc i)).rank,(object i).rank,(object (suc (suc i))).rank,
    twists (object i),twists (object (suc i)),twists (object (suc (suc i))),
    (C.arrow cursor i).polys,(C.arrow cursor (suc i)).polys,
    Action[object (suc i),object i,C.arrow cursor i,card].hs,
    Action[object (suc (suc i)),object (suc i),C.arrow cursor (suc i),card].hs,
    C.identity cursor i,K.topRank card].equation x ;
  dd (i card : Nat) (x : (F i card).M) :
   Id (F i (suc (suc card))).M ((d i (suc card)).f ((d i card).f x)) (F i (suc (suc card))).mz =
   M.Family[(object i).rank,twists (object i),K.topRank (suc (suc card))].Prod.ext _ _ (\ j ->
    CE.Cochains[nvar,twists (object i) j,K.topRank (suc (suc card))].M.eq _ _
      (\ s m -> CY.dd nvar (CE.Cochains[nvar,twists (object i) j,K.topRank card].fibre (x j) m) s)) ;
  module Z = FiniteZigzagCertificate[l].Over[D,F,d,A,comm,kill] ;
  module Raising = Z.Raising[dd] ;
 } ;
 -- The local exactness type of a current cursor involves only this cursor
 -- and its immediate successor, so equality of cursors transports it once.
 module Adjacent (cursor : C.Cursor) (card : Nat) {
  module I = Instance[cursor] ;
  Exact : U l = I.Z.LocalExact zero card ;
 } ;
 module FirstExact (n : Nat) (S Q : R.Free) (f : C.Arrow[S,Q]) (t : C.Resolution (suc n) S Q f) (card : Nat) {
  module W = C.At[S,Q,f] ; module V = W.Chosen[t.1,t.2.1] ;
  module Input = G.Input[S.rank,Q.rank,S.shifts,Q.shifts,f.polys,W.homogeneous,
   \ i j -> convert (Q.shifts j) (S.shifts i) (f.polys i j) (f.homogeneous i j)] ;
  module Chosen = Input.Chosen[t.1,\ j i -> (t.2.1 j i).1,\ j i -> (t.2.1 j i).2.1,
   \ j i -> convert (S.shifts i) (t.1.2.1 j) (t.2.1 j i).1 (t.2.1 j i).2.2] ;
  module At = Chosen.At[base,K.topRank card] ;
  exact : Adjacent[C.start (suc n) S Q f t,card].Exact = \ y hy -> At.Lift[y,hy].lift ;
 } ;
} ;
