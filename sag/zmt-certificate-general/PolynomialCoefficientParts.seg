-- Coefficient characterization of every integer grading projection in the
-- generic tower. It is first checked on scalar monomials, then finite sums,
-- and finally all elements using the truncated term-list representation.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module E = FiniteExponents[l] ; module FP = FinitePolynomial4[l] ;
module WP = WeightedParts4[l] ; module LG = Logic[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module P = PolynomialTowerBridge[l].Over[A,setA] ; module T = P.T ;
 module D = PolynomialDegreeBridge[l].Over[A,setA] ;
 module AD = IdealPowers[l].ModL[A,IdealPowers[l].regular A] ;
 module At (n : Nat) (k : Int) {
  module L = D.At[n].L ;
  selected-term (p : P.Term n) : (dec : LG.Dec (Id Int (pos (E.degree n p.2)) k)) ->
   Id (T.D n).R ((T.grD n).pr k (P.term n p))
    (FP.sel (T.D n) (P.term n p) (Id Int (pos (E.degree n p.2)) k) dec) = split {
   yes e -> trans (ap (\ z -> (T.grD n).pr z (P.term n p)) (sym e)) (D.term-hom n p) ;
   no ne -> L.hom-other k (pos (E.degree n p.2)) (P.term n p) (D.term-hom n p) (\ e -> Pr.absurd Empty (ne (sym e))) } ;
  module DegreeSelection (p : P.Term n) (v : E.Exp n) {
   u : E.Exp n = p.2 ; c : A.R = p.1 ;
   P0 : U l = Id Int (pos (E.degree n u)) k ; P1 : U l = Id Int (pos (E.degree n v)) k ;
   res : (dec : LG.Dec (Id (E.Exp n) u v)) ->
    Id A.R (FP.sel A (FP.sel A c (Id (E.Exp n) u v) dec) P0 (int-dec (pos (E.degree n u)) k))
      (FP.sel A (FP.sel A c (Id (E.Exp n) u v) dec) P1 (int-dec (pos (E.degree n v)) k)) = split {
    yes e -> WP.sel-iff A c P0 P1 (\ q -> trans (sym (ap (\ z -> pos (E.degree n z)) e)) q)
      (\ q -> trans (ap (\ z -> pos (E.degree n z)) e) q) (int-dec (pos (E.degree n u)) k) (int-dec (pos (E.degree n v)) k) ;
    no ne -> trans (FP.sel-zero A P0 (int-dec (pos (E.degree n u)) k)) (sym (FP.sel-zero A P1 (int-dec (pos (E.degree n v)) k))) } ;
  } ;
  term (p : P.Term n) (v : E.Exp n) :
   Id A.R (P.Coeff n ((T.grD n).pr k (P.term n p)) v)
    (FP.sel A (P.Coeff n (P.term n p) v) (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)) =
   trans (ap (\ x -> P.Coeff n x v) (selected-term p (int-dec (pos (E.degree n p.2)) k)))
    (trans (FP.sel-map (T.D n) A (\ x -> P.Coeff n x v) (P.coeff-zero n v) (P.term n p)
      (Id Int (pos (E.degree n p.2)) k) (int-dec (pos (E.degree n p.2)) k))
     (trans (ap (\ x -> FP.sel A x (Id Int (pos (E.degree n p.2)) k) (int-dec (pos (E.degree n p.2)) k)) (P.term-coeff n p v))
      (trans (DegreeSelection[p,v].res (E.dec n p.2 v))
       (ap (\ x -> FP.sel A x (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)) (sym (P.term-coeff n p v)))))) ;
  list (v : E.Exp n) : (ps : List (P.Term n)) ->
   Id A.R (P.Coeff n ((T.grD n).pr k (P.phi n ps)) v)
    (FP.sel A (P.Coeff n (P.phi n ps) v) (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)) = split {
   nil -> trans (ap (\ x -> P.Coeff n x v) (L.pr-zero k))
     (trans (P.coeff-zero n v) (sym (trans (ap (\ x -> FP.sel A x (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)) (P.coeff-zero n v)) (FP.sel-zero A (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k))))) ;
   cons p ps | rec ->
    trans (ap (\ x -> P.Coeff n x v) ((T.grD n).pr-add k (P.term n p) (P.phi n ps)))
     (trans (P.coeff-add n ((T.grD n).pr k (P.term n p)) ((T.grD n).pr k (P.phi n ps)) v)
      (trans (AD.G.cong-add (term p v) rec)
       (trans (sym (WP.sel-add A (P.Coeff n (P.term n p) v) (P.Coeff n (P.phi n ps) v) (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)))
        (ap (\ x -> FP.sel A x (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)) (sym (P.coeff-add n (P.term n p) (P.phi n ps) v)))))) } ;
  Goal (x : (T.D n).R) (v : E.Exp n) : U l =
   Id A.R (P.Coeff n ((T.grD n).pr k x) v) (FP.sel A (P.Coeff n x v) (Id Int (pos (E.degree n v)) k) (int-dec (pos (E.degree n v)) k)) ;
  coefficient (x : (T.D n).R) (v : E.Exp n) : Goal x v =
   Tr.Trunc[P.Reps[n].Rep x].induction @l (\ p -> Goal x v)
    (\ p -> setA _ _) (\ p -> subst (\ x -> Goal x v) p.2 (list v p.1)) (P.rep n x) ;
  selected-id (x : (T.D n).R) (v : E.Exp n)
   (h : (Id Int (pos (E.degree n v)) k -> Base.Empty) -> Id A.R (P.Coeff n x v) A.z) :
   (dec : LG.Dec (Id Int (pos (E.degree n v)) k)) ->
    Id A.R (FP.sel A (P.Coeff n x v) (Id Int (pos (E.degree n v)) k) dec) (P.Coeff n x v) = split {
   yes e -> refl (P.Coeff n x v) ; no ne -> sym (h ne) } ;
  homogeneous (x : (T.D n).R)
   (h : (v : E.Exp n) -> (Id Int (pos (E.degree n v)) k -> Base.Empty) -> Id A.R (P.Coeff n x v) A.z) : L.Hom k x =
   P.ext n _ _ (\ v -> trans (coefficient x v) (selected-id x v (h v) (int-dec (pos (E.degree n v)) k))) ;
 } ;
} ;
