-- Concrete dependence for an arbitrary homogeneous defining list in
-- nvar=extra+3 homogeneous coordinates (projective dimension extra+2).
-- The final hypotheses contain no resolution or columns. Exactly extra
-- initial homogeneous syzygy stages are constructed from CFN, and their
-- truncation is eliminated into the stated boundary-plus-defining-ideal
-- dependence identity. N=0 is allowed.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module E = FiniteExponents[l] ; module PA = PolynomialAction4[l] ; module K = GenericDegree[l] ;
module R = FinitePolynomialResolution[l] ;
module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) (extra : Nat) {
 nvar : Nat = plus extra (suc (suc (suc zero))) ;
 module C = ResolutionCechDiagram[l].Over[K0,D,setD,cfn,nvar] ; module P = C.C ;
 module Construct = HomogeneousStageRepresentatives[l].Over[K0,D,setD,cfn,nvar] ;
 module Exact = FiniteExactSchedule[l].Over[K0,D,setD,cfn,nvar] ;
 module Schedule = CechZigzagSchedule[l].Over[K0,D,setD,cfn,nvar] ;
 target : R.Free = R.mkFree (suc zero) (\ j -> zero) ;
 module Input (a : Nat) (d : Ps.Fin a -> Base.Nat)
  (g : Ps.Fin a -> List (P.P.Term nvar)) (hg : (i : Ps.Fin a) -> P.HR.HomShift zero (d i) (g i)) {
  source : R.Free = R.mkFree a d ;
  defining : P.Arrow[source,target] = P.mkArrow source target (\ i j -> g i) (\ i j -> hg i) ;
  module F0 = C.M.Family[target.rank,C.twists target,K.topRank (suc zero)] ;
  module F1 = C.M.Family[target.rank,C.twists target,K.topRank (suc (suc zero))] ;
  module F2 = C.M.Family[target.rank,C.twists target,K.topRank (suc (suc (suc zero)))] ;
  module U1 = C.M.Family[source.rank,C.twists source,K.topRank (suc (suc zero))] ;
  module U2 = C.M.Family[source.rank,C.twists source,K.topRank (suc (suc (suc zero)))] ;
  module D0 = C.M.Differential[target.rank,C.twists target,K.topRank (suc zero)] ;
  module D1 = C.M.Differential[target.rank,C.twists target,K.topRank (suc (suc zero))] ;
  module A1 = C.Action[source,target,defining,suc (suc zero)] ;
  module A2 = C.Action[source,target,defining,suc (suc (suc zero))] ;
  module FL = IP.ModL[D,F1.mod] ;
  Lifted (c : F1.El) : U l = (u : U2.El) * Id F2.El (D1.lin.f c) (A2.A.lin.f u) ;
  Bdry (c : F1.El) : U l = (h : F0.El) * ((u : U1.El) * Id F1.El c (F1.mod.madd (D0.lin.f h) (A1.A.lin.f u))) ;
  module Seq (c : Nat -> F1.El) (lift : (j : Nat) -> Tr.Trunc[Lifted (c j)].carrier) {
   sumL : List D.R -> F1.El = split {
    nil -> F1.mod.mz ; cons q qs | rec -> F1.mod.madd (F1.mod.sm q (c (len qs))) rec } ;
   Result : U l = (qs : List D.R) * Tr.Trunc[Bdry (FL.msub (c (len qs)) (sumL qs))].carrier ;
   -- The following module is instantiated only inside the final truncation.
   module WithResolution (t : P.Resolution extra source target defining) {
    cursor : P.Cursor = P.start extra source target defining t ;
    module I = C.Instance[cursor] ;
    schedule : I.Z.Schedule (suc extra) zero (suc zero) =
     Schedule.schedule extra cursor zero (suc zero) (refl nvar) ;
    exact : I.Z.Exacts (suc extra) zero (suc zero) = Exact.Start[extra,source,target,defining,t,suc zero].exact ;
    module S = I.Z.LiftedSequence[K0,cfn,I.dd,suc extra,zero,suc zero,schedule,exact,c,lift] ;
    sum-comparison : (qs : List D.R) -> Id F1.El (S.S.S.sumL qs) (sumL qs) = split {
     nil -> refl F1.mod.mz ;
     cons q qs | rec -> ap (F1.mod.madd (F1.mod.sm q (c (len qs)))) rec } ;
    convert (x : S.S.S.Cert) : Result = (x.1,
     subst (\ z -> Tr.Trunc[Bdry z].carrier) (ap (FL.msub (c (len x.1))) (sum-comparison x.1)) x.2) ;
    dependence : Tr.Trunc[Result].carrier = TC.map S.S.S.Cert Result convert S.dependence ;
   } ;
   dependence : Tr.Trunc[Result].carrier =
    TC.bind (P.Resolution extra source target defining) Result (\ t -> WithResolution[t].dependence)
      (Construct.constructed extra source target defining) ;
  } ;
 } ;
} ;
