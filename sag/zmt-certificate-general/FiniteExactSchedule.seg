-- All intermediate local-exactness hypotheses of a finite zigzag are
-- constructed from its finite polynomial resolution. A master cursor is
-- held fixed; advancing its finite-chain witness uses one named cursor
-- equality, rather than transporting the entire double complex.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module R = FinitePolynomialResolution[l] ;
module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) (nvar : Nat) {
 module C = ResolutionCechDiagram[l].Over[K0,D,setD,cfn,nvar] ; module P = C.C ;
 Goal (n : Nat) : U l = (master : P.Cursor) (i r : Nat) (S Q : R.Free) (f : P.Arrow[S,Q]) (t : P.Resolution n S Q f) ->
  Id P.Cursor (P.walk master i) (P.start n S Q f t) -> C.Instance[master].Z.Exacts (suc n) i r ;
 module Step (n : Nat) (ih : Goal n) (master : P.Cursor) (i r : Nat) (S Q : R.Free) (f : P.Arrow[S,Q])
  (t : P.Resolution (suc n) S Q f) (eq : Id P.Cursor (P.walk master i) (P.start (suc n) S Q f t)) {
  module Ch = P.At[S,Q,f].Chosen[t.1,t.2.1] ;
  first : C.Instance[master].Z.LocalExact i (suc (suc (suc r))) =
   subst (\ cursor -> C.Adjacent[cursor,suc (suc (suc r))].Exact) (sym eq)
    C.FirstExact[n,S,Q,f,t,suc (suc (suc r))].exact ;
  tail : C.Instance[master].Z.Exacts (suc n) (suc i) (suc r) =
   ih master (suc i) (suc r) Ch.source S Ch.arrow t.2.2 (ap P.next eq) ;
  result : C.Instance[master].Z.Exacts (suc (suc n)) i r = (first,tail) ;
 } ;
 exacts : (n : Nat) -> Goal n = split {
  zero -> \ master i r S Q f t eq -> tt ;
  suc n | rec -> \ master i r S Q f t eq -> Step[n,rec,master,i,r,S,Q,f,t,eq].result } ;
 module Start (n : Nat) (S Q : R.Free) (f : P.Arrow[S,Q]) (t : P.Resolution n S Q f) (r : Nat) {
  cursor : P.Cursor = P.start n S Q f t ;
  exact : C.Instance[cursor].Z.Exacts (suc n) zero r = exacts n cursor zero r S Q f t (refl cursor) ;
 } ;
} ;
