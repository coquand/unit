-- Reuse HomogeneousStages.initial unchanged, choosing homogeneous term-list
-- representatives for its finite chain under truncation. The only transport
-- is the named equality of the next states: the chosen term lists have the
-- already constructed kernel columns as their ring images; homogeneity
-- proofs form a proposition, so there is no additional choice or axiom.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ; module PA = PolynomialAction4[l] ;
module R = FinitePolynomialResolution[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A]) (nvar : Nat) {
 module P = R.Over[K0,A,setA,cfn,nvar] ;
 module T = HomogeneousStages[l].Tower[K0,A,setA,cfn,nvar] ;
 state (S Q : R.Free) (f : P.Arrow[S,Q]) : T.State =
  (S.rank,(Q.rank,(S.shifts,(Q.shifts,(P.At[S,Q,f].ring,P.At[S,Q,f].homogeneous))))) ;
 module Transport (S Q : R.Free) (f : P.Arrow[S,Q]) (w : P.At[S,Q,f].M.Data) (reps : P.At[S,Q,f].Reps w) {
  module C = P.At[S,Q,f] ; module W = C.M.Witness[w] ; module N = C.Chosen[w,reps] ;
  Matrix : U l = Ps.Fin W.rank -> P.H.Vec S.rank ;
  HomOn (m : Matrix) : U l = (j : Ps.Fin W.rank) (i : Ps.Fin S.rank) ->
   P.H.L.Hom (PA.minus (pos (W.shifts j)) (S.shifts i)) (m j i) ;
  prop (m : Matrix) : Pr.isProp (HomOn m) = FE.isProp-Pi (Ps.Fin W.rank) (\ j -> (i : Ps.Fin S.rank) -> P.H.L.Hom (PA.minus (pos (W.shifts j)) (S.shifts i)) (m j i))
   (\ j -> FE.isProp-Pi (Ps.Fin S.rank) (\ i -> P.H.L.Hom (PA.minus (pos (W.shifts j)) (S.shifts i)) (m j i)) (\ i -> P.H.L.hom-prop (PA.minus (pos (W.shifts j)) (S.shifts i)) (m j i))) ;
  matrix : Id Matrix (P.At[N.source,S,N.arrow].ring) W.columns =
   FE.funext (Ps.Fin W.rank) (\ j -> P.H.Vec S.rank) P.At[N.source,S,N.arrow].ring W.columns (\ j -> P.H.F[S.rank].V.ext _ _ (\ i -> (reps j i).2.1)) ;
  pair : Id ((m : Matrix) * HomOn m)
   (P.At[N.source,S,N.arrow].ring,P.At[N.source,S,N.arrow].homogeneous) (W.columns,W.homogeneous) =
   Pr.Sigma-eq Matrix HomOn _ _ _ _ matrix (prop W.columns) ;
  next-state : Id T.State (state N.source S N.arrow) (T.next (state S Q f) w) =
   ap (\ pair -> (W.rank,(S.rank,(W.shifts,(S.shifts,pair))))) pair ;
  tail (n : Nat) : T.Initial n (T.next (state S Q f) w) -> T.Initial n (state N.source S N.arrow) =
   subst (T.Initial n) (sym next-state) ;
 } ;
 Goal (n : Nat) : U l = (S Q : R.Free) (f : P.Arrow[S,Q]) -> T.Initial n (state S Q f) -> Tr.Trunc[P.Resolution n S Q f].carrier ;
 module Step (n : Nat) (ih : Goal n) (S Q : R.Free) (f : P.Arrow[S,Q]) (x : T.Initial (suc n) (state S Q f)) {
  w : P.At[S,Q,f].M.Data = x.1 ;
  with-reps (reps : P.At[S,Q,f].Reps w) : Tr.Trunc[P.Resolution (suc n) S Q f].carrier =
   TC.map (P.Resolution n P.At[S,Q,f].Chosen[w,reps].source S P.At[S,Q,f].Chosen[w,reps].arrow)
    (P.Resolution (suc n) S Q f) (\ tail -> (w,(reps,tail)))
    (ih P.At[S,Q,f].Chosen[w,reps].source S P.At[S,Q,f].Chosen[w,reps].arrow (Transport[S,Q,f,w,reps].tail n x.2)) ;
  result : Tr.Trunc[P.Resolution (suc n) S Q f].carrier =
   TC.bind (P.At[S,Q,f].Reps w) (P.Resolution (suc n) S Q f) with-reps (P.At[S,Q,f].representatives w) ;
 } ;
 convert : (n : Nat) -> Goal n = split {
  zero -> \ S Q f x -> Tr.Trunc[Top].inc tt ;
  suc n | rec -> \ S Q f x -> Step[n,rec,S,Q,f,x].result } ;
 constructed (n : Nat) (S Q : R.Free) (f : P.Arrow[S,Q]) : Tr.Trunc[P.Resolution n S Q f].carrier =
  TC.bind (T.Initial n (state S Q f)) (P.Resolution n S Q f) (convert n S Q f) (T.initial n (state S Q f)) ;
} ;
