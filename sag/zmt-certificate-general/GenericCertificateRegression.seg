-- Dimension regressions for the final theorem with no resolution input.
-- Three/four coordinates recover the familiar characterising equations;
-- five coordinates exercise TWO constructed syzygy stages (beyond P^3).
-- Empty generators and a zero polynomial with degree five are included.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module RC = RelationCertificate[l] ; module E = FiniteExponents[l] ; module NA = NatArith[l] ;
module CR = CubicResolution4[l] ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ; four : Nat = suc three ; five : Nat = suc four ;
threeB : Base.Nat = suc (suc (suc zero)) ; fiveB : Base.Nat = suc (suc (suc (suc (suc zero)))) ;
degree-zero : (n : Nat) -> Id Base.Nat (E.degree n (E.zeroE n)) zero = split {
 zero -> refl zero ; suc n | rec -> rec } ;
module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) {
 module Basic (extra : Nat) {
  module T = GenericResolutionDependence[l].Over[K0,D,setD,cfn,extra] ;
  empty-degree (i : Ps.Fin zero) : Base.Nat = absurd Base.Nat i ;
  empty-polynomial (i : Ps.Fin zero) : List (T.P.P.Term T.nvar) = absurd (List (T.P.P.Term T.nvar)) i ;
  empty-hom (i : Ps.Fin zero) : T.P.HR.HomShift zero (empty-degree i) (empty-polynomial i) =
   absurd (T.P.HR.HomShift zero (empty-degree i) (empty-polynomial i)) i ;
  zero-degree (i : Ps.Fin one) : Base.Nat = fiveB ;
  zero-polynomial (i : Ps.Fin one) : List (T.P.P.Term T.nvar) = nil ;
  zero-hom (i : Ps.Fin one) : T.P.HR.HomShift zero (zero-degree i) (zero-polynomial i) = tt ;
  module Empty = T.Input[zero,empty-degree,empty-polynomial,empty-hom] ;
  module Zero = T.Input[one,zero-degree,zero-polynomial,zero-hom] ;
  module ESeq (c : Nat -> Empty.F1.El) (lift : (j : Nat) -> Tr.Trunc[Empty.Lifted (c j)].carrier) {
   dependence : Tr.Trunc[Empty.Seq[c,lift].Result].carrier = Empty.Seq[c,lift].dependence ;
  } ;
  module ZSeq (c : Nat -> Zero.F1.El) (lift : (j : Nat) -> Tr.Trunc[Zero.Lifted (c j)].carrier) {
   dependence : Tr.Trunc[Zero.Seq[c,lift].Result].carrier = Zero.Seq[c,lift].dependence ;
  } ;
  zero-sequence (j : Nat) : Zero.F1.El = Zero.F1.mod.mz ;
  lift-zero (j : Nat) : Tr.Trunc[Zero.Lifted (zero-sequence j)].carrier = Tr.Trunc[Zero.Lifted (zero-sequence j)].inc
   (Zero.U2.mod.mz,(trans RC.LinL[D,Zero.F1.mod,Zero.F2.mod,Zero.D1.lin].f-zero
     (sym RC.LinL[D,Zero.U2.mod,Zero.F2.mod,Zero.A2.A.lin].f-zero))) ;
  zero-dependence : Tr.Trunc[Zero.Seq[zero-sequence,lift-zero].Result].carrier = Zero.Seq[zero-sequence,lift-zero].dependence ;
 } ;
 module ThreeCoordinates = Basic[zero] ;
 module FourCoordinates = Basic[one] ;
 module FiveCoordinates = Basic[two] ;
 module P4 {
  module T = GenericResolutionDependence[l].Over[K0,D,setD,cfn,two] ;
  ex : E.Exp T.nvar = E.join four (E.zeroE four) threeB ;
  ey : E.Exp T.nvar = E.join four (E.join three (E.zeroE three) threeB) zero ;
  hx : Id Base.Nat (NA.plus zero (E.degree T.nvar ex)) threeB =
   trans (ap (NA.plus threeB) (degree-zero four)) (NA.plus-zero threeB) ;
  hy : Id Base.Nat (NA.plus zero (E.degree T.nvar ey)) threeB =
   trans (ap (NA.plus threeB) (degree-zero three)) (NA.plus-zero threeB) ;
  px : List (T.P.P.Term T.nvar) = cons (D.o,ex) nil ;
  py : List (T.P.P.Term T.nvar) = cons (D.o,ey) nil ;
  d (i : Ps.Fin two) : Base.Nat = threeB ;
  g : Ps.Fin two -> List (T.P.P.Term T.nvar) = CR.pair (List (T.P.P.Term T.nvar)) px py ;
  hg : (i : Ps.Fin two) -> T.P.HR.HomShift zero (d i) (g i) =
   CR.pair-ind (\ i -> T.P.HR.HomShift zero (d i) (g i)) (hx,tt) (hy,tt) ;
  module I = T.Input[two,d,g,hg] ;
  two-stages : Tr.Trunc[T.P.Resolution two I.source T.target I.defining].carrier = T.Construct.constructed two I.source T.target I.defining ;
  module Seq (c : Nat -> I.F1.El) (lift : (j : Nat) -> Tr.Trunc[I.Lifted (c j)].carrier) {
   dependence : Tr.Trunc[I.Seq[c,lift].Result].carrier = I.Seq[c,lift].dependence ;
  } ;
  zero-sequence (j : Nat) : I.F1.El = I.F1.mod.mz ;
  zero-lift (j : Nat) : Tr.Trunc[I.Lifted (zero-sequence j)].carrier = Tr.Trunc[I.Lifted (zero-sequence j)].inc
   (I.U2.mod.mz,trans RC.LinL[D,I.F1.mod,I.F2.mod,I.D1.lin].f-zero (sym RC.LinL[D,I.U2.mod,I.F2.mod,I.A2.A.lin].f-zero)) ;
  dependence : Tr.Trunc[I.Seq[zero-sequence,zero-lift].Result].carrier = I.Seq[zero-sequence,zero-lift].dependence ;
 } ;
 module ScalarP4 {
  module T = ScalarResolutionDependence[l].Over[K0,D,setD,cfn,two] ;
  module I = T.Input[two,P4.d,P4.g,P4.hg] ;
  module Seq (c : Nat -> I.C1.El) (lift : (j : Nat) -> Tr.Trunc[I.Lifted (c j)].carrier) {
   dependence : Tr.Trunc[I.Seq[c,lift].Result].carrier = I.Seq[c,lift].dependence ;
  } ;
  zero-sequence (j : Nat) : I.C1.El = I.C1.mod.mz ;
  zero-lift (j : Nat) : Tr.Trunc[I.Lifted (zero-sequence j)].carrier = Tr.Trunc[I.Lifted (zero-sequence j)].inc
   (I.I.U2.mod.mz,trans RC.LinL[D,I.C1.mod,I.C2.mod,I.D1.d].f-zero
    (sym (ap (\ u -> u (inr tt)) RC.LinL[D,I.I.U2.mod,I.I.F2.mod,I.I.A2.A.lin].f-zero))) ;
  dependence : Tr.Trunc[I.Seq[zero-sequence,zero-lift].Result].carrier = I.Seq[zero-sequence,zero-lift].dependence ;
 } ;
 -- Actual ambient dimensions specialise the general characterisations.
 module Shape3 {
  module I = ThreeCoordinates.Zero ; module T = ThreeCoordinates.T ;
  cursor : T.P.Cursor = T.P.start zero I.source T.target I.defining tt ;
  module C = T.C.Instance[cursor] ;
  s : C.Z.Schedule one zero one = T.Schedule.schedule zero cursor zero one (refl T.nvar) ;
  module Shape = ZigzagCharacterisations[l].Over[D,C.F,C.d,C.A,C.comm,C.kill].One[zero,one,s] ;
  forward (c : C.Z.Cell[zero,one].Z.M) (p : Shape.Top.V.Vec) :
   (C.Z.build one zero one s).Gam c p -> Tr.Trunc[Shape.Witness c p].carrier = Shape.forward c p ;
  backward (c : C.Z.Cell[zero,one].Z.M) (p : Shape.Top.V.Vec) :
   Tr.Trunc[Shape.Witness c p].carrier -> (C.Z.build one zero one s).Gam c p = Shape.backward c p ;
 } ;
 module Shape4 (t : FourCoordinates.T.P.Resolution one FourCoordinates.Zero.source FourCoordinates.T.target FourCoordinates.Zero.defining) {
  module I = FourCoordinates.Zero ; module T = FourCoordinates.T ;
  cursor : T.P.Cursor = T.P.start one I.source T.target I.defining t ;
  module C = T.C.Instance[cursor] ;
  s : C.Z.Schedule two zero one = T.Schedule.schedule one cursor zero one (refl T.nvar) ;
  module Shape = ZigzagCharacterisations[l].Over[D,C.F,C.d,C.A,C.comm,C.kill].Two[zero,one,s] ;
  forward (c : C.Z.Cell[zero,one].Z.M) (p : Shape.Top.V.Vec) :
   (C.Z.build two zero one s).Gam c p -> Tr.Trunc[Shape.Witness c p].carrier = Shape.forward c p ;
  backward (c : C.Z.Cell[zero,one].Z.M) (p : Shape.Top.V.Vec) :
   Tr.Trunc[Shape.Witness c p].carrier -> (C.Z.build two zero one s).Gam c p = Shape.backward c p ;
 } ;
} ;
module OverZ {
 module Z = Over[Nat * Nat,ZRing[l].ring,int-set,ZCFN[l].cfn] ;
 scalar-p4 : Tr.Trunc[Z.ScalarP4.I.Seq[Z.ScalarP4.zero-sequence,Z.ScalarP4.zero-lift].Result].carrier = Z.ScalarP4.dependence ;
 p4 : Tr.Trunc[Z.P4.I.Seq[Z.P4.zero-sequence,Z.P4.zero-lift].Result].carrier = Z.P4.dependence ;
 empty5 (c : Nat -> Z.FiveCoordinates.Empty.F1.El) (lift : (j : Nat) -> Tr.Trunc[Z.FiveCoordinates.Empty.Lifted (c j)].carrier) :
  Tr.Trunc[Z.FiveCoordinates.Empty.Seq[c,lift].Result].carrier = Z.FiveCoordinates.ESeq[c,lift].dependence ;
} ;
