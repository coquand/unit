-- Homogeneous ring elements have homogeneous term-list representatives.
-- Start from the already proved mere representative, filter at its degree,
-- and use the projection comparison plus homogeneity to recover the element.
-- For shifted nonnegative source/column degrees, integer equality of each
-- retained term becomes the natural shifted-degree equation.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module E = FiniteExponents[l] ; module LG = Logic[l] ; module PA = PolynomialAction4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module P = PolynomialTowerBridge[l].Over[A,setA] ; module T = P.T ;
 module D = PolynomialDegreeBridge[l].Over[A,setA] ; module L = D.At[n].L ;
 Hom (k : Int) : List (P.Term n) -> U l = split {
  nil -> Top ; cons p ps | rec -> Id Int (pos (E.degree n p.2)) k * rec } ;
 module Filter (k : Int) {
  module F = D.Filter[n,k] ;
  good-step (p : P.Term n) (ps : List (P.Term n)) (rec : Hom k ps) :
   (dec : LG.Dec (Id Int (pos (E.degree n p.2)) k)) -> Hom k (F.keep p ps dec) = split {
   yes e -> (e,rec) ; no ne -> rec } ;
  good : (ps : List (P.Term n)) -> Hom k (F.parts ps) = split {
   nil -> tt ; cons p ps | rec -> good-step p (F.parts ps) rec (int-dec (pos (E.degree n p.2)) k) } ;
 } ;
 Rep (k : Int) (x : (T.D n).R) : U l = (ps : List (P.Term n)) * (Id (T.D n).R (P.phi n ps) x * Hom k ps) ;
 module From (k : Int) (x : (T.D n).R) (hx : L.Hom k x) (r : P.Reps[n].Rep x) {
  module F = Filter[k] ;
  equation : Id (T.D n).R (P.phi n (F.F.parts r.1)) x =
   trans (sym (F.F.projection r.1)) (trans (ap ((T.grD n).pr k) r.2) hx) ;
  witness : Rep k x = (F.F.parts r.1,(equation,F.good r.1)) ;
 } ;
 representative (k : Int) (x : (T.D n).R) (hx : L.Hom k x) : Tr.Trunc[Rep k x].carrier =
  TC.map (P.Reps[n].Rep x) (Rep k x) (\ r -> From[k,x,hx,r].witness) (P.rep n x) ;
 HomShift (dd ee : Base.Nat) : List (P.Term n) -> U l = split {
  nil -> Top ; cons p ps | rec -> Id Base.Nat (NatArith[l].plus dd (E.degree n p.2)) ee * rec } ;
 shifted (dd ee : Base.Nat) : (ps : List (P.Term n)) -> Hom (PA.minus (pos ee) dd) ps -> HomShift dd ee ps = split {
  nil -> \ h -> tt ; cons p ps | rec -> \ h ->
   (sym (ShiftedParts[l].shift-inj ee dd (E.degree n p.2) (sym h.1)),rec h.2) } ;
 ShiftedRep (dd ee : Base.Nat) (x : (T.D n).R) : U l =
  (ps : List (P.Term n)) * (Id (T.D n).R (P.phi n ps) x * HomShift dd ee ps) ;
 shifted-representative (dd ee : Base.Nat) (x : (T.D n).R) (hx : L.Hom (PA.minus (pos ee) dd) x) : Tr.Trunc[ShiftedRep dd ee x].carrier =
  TC.map (Rep (PA.minus (pos ee) dd) x) (ShiftedRep dd ee x) (\ p -> (p.1,(p.2.1,shifted dd ee p.1 p.2.2))) (representative (PA.minus (pos ee) dd) x hx) ;
} ;
