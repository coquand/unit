-- The first two finite zigzags have exactly the familiar characterising
-- equations. Depth one (three coordinates) has dc=A u and top(u)=p.
-- Depth two (four coordinates) has dc=A u, du=H w and top(w)=p.
-- Nested truncations in the recursive relation are flattened explicitly.
level l ; open Ring[l] ;
module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (D : CRing) (F : Nat -> Nat -> IP.Mod[D])
 (d : (i r : Nat) -> IP.Lin[D,F i r,F i (suc r)])
 (A : (i r : Nat) -> IP.Lin[D,F (suc i) r,F i r])
 (comm : (i r : Nat) (x : (F (suc i) r).M) ->
  Id (F i (suc r)).M ((d i r).f ((A i r).f x)) ((A i (suc r)).f ((d (suc i) r).f x)))
 (kill : (i r : Nat) (x : (F (suc (suc i)) r).M) ->
  Id (F i r).M ((A i r).f ((A (suc i) r).f x)) (F i r).mz) {
 module Z = FiniteZigzagCertificate[l].Over[D,F,d,A,comm,kill] ;
 module One (i r : Nat) (s : Z.Schedule (suc zero) i r) {
  module Top = Z.TerminalCase[suc i,suc r,s.2] ;
  Witness (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) : U l =
   (u : Z.Cell[suc i,suc r].Z.M) *
    (Id Z.Cell[i,r].T.M ((d i (suc r)).f c) ((A i (suc (suc r))).f u) * Id Top.V.Vec (Top.top.f u) p) ;
  forward (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) :
   (Z.build (suc zero) i r s).Gam c p -> Tr.Trunc[Witness c p].carrier = \ h -> h ;
  backward (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) :
   Tr.Trunc[Witness c p].carrier -> (Z.build (suc zero) i r s).Gam c p = \ h -> h ;
 } ;
 module Two (i r : Nat) (s : Z.Schedule (suc (suc zero)) i r) {
  module Top = Z.TerminalCase[suc (suc i),suc (suc r),s.2.2] ;
  E1 (c : Z.Cell[i,r].Z.M) (u : Z.Cell[suc i,suc r].Z.M) : U l =
   Id Z.Cell[i,r].T.M ((d i (suc r)).f c) ((A i (suc (suc r))).f u) ;
  E2 (u : Z.Cell[suc i,suc r].Z.M) (w : Z.Cell[suc (suc i),suc (suc r)].Z.M) : U l =
   Id Z.Cell[suc i,suc r].T.M ((d (suc i) (suc (suc r))).f u) ((A (suc i) (suc (suc (suc r)))).f w) ;
  Inner (u : Z.Cell[suc i,suc r].Z.M) (p : Top.V.Vec) : U l =
   (w : Z.Cell[suc (suc i),suc (suc r)].Z.M) * (E2 u w * Id Top.V.Vec (Top.top.f w) p) ;
  Outer (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) : U l =
   (u : Z.Cell[suc i,suc r].Z.M) * (E1 c u * Tr.Trunc[Inner u p].carrier) ;
  Witness (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) : U l =
   (u : Z.Cell[suc i,suc r].Z.M) * ((w : Z.Cell[suc (suc i),suc (suc r)].Z.M) * (E1 c u * (E2 u w * Id Top.V.Vec (Top.top.f w) p))) ;
  forward (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) :
   (Z.build (suc (suc zero)) i r s).Gam c p -> Tr.Trunc[Witness c p].carrier =
    TC.bind (Outer c p) (Witness c p) (\ x -> TC.map (Inner x.1 p) (Witness c p) (\ w -> (x.1,(w.1,(x.2.1,w.2)))) x.2.2) ;
  backward (c : Z.Cell[i,r].Z.M) (p : Top.V.Vec) :
   Tr.Trunc[Witness c p].carrier -> (Z.build (suc (suc zero)) i r s).Gam c p =
    TC.map (Witness c p) (Outer c p) (\ x -> (x.1,(x.2.2.1,Tr.Trunc[Inner x.1 p].inc (x.2.1,x.2.2.2)))) ;
 } ;
} ;
