-- Matrix action identities from ring polynomial identities, uniformly in
-- chart subset/cardinality. Consecutive ring matrices with zero product
-- act with zero composite on ALL Laurent chart functions. No contraction
-- is asserted linear over the polynomial ring.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module L = GenericLaurent[l] ; module E = FiniteExponents[l] ;
module Over (D : CRing) (setD : Pr.isSet D.R) (n : Nat) {
 module P = PolynomialTowerBridge[l].Over[D,setD] ; module T = P.T ;
 module FA = FiniteLaurentAction[l].Over[D,setD,n] ; module PP = PolynomialTowerProducts[l].Over[D,setD,n] ;
 module INV = PolynomialActionTowerComparison[l].Over[D,setD,n] ;
 module RS = Comb[l].Sums[D,IP.regular D] ; module SS = Comb[l].Sums[T.D n,IP.regular (T.D n)] ;
 module M = ShiftedMatrixAction[l].Over[D,setD,n] ; module C = GenericCech[l].Over[D,setD] ;
 module AD = IP.ModL[D,IP.regular D] ;
 mul-sum (p : FA.Polys) (m : L.Exp n) : (a : Nat) (f : Ps.Fin a -> L.Exp n -> D.R) ->
  Id D.R (FA.mulP p (\ x -> RS.sum a (\ i -> f i x)) m) (RS.sum a (\ i -> FA.mulP p (f i) m)) = split {
  zero -> \ f -> FA.mulP-zero p m ;
  suc a | rec -> \ f -> trans (FA.mulP-add p (f (inr tt)) (\ x -> RS.sum a (\ i -> f (inl i) x)) m)
   (ap (D.add (FA.mulP p (f (inr tt)) m)) (rec (\ i -> f (inl i)))) } ;
 module Kernel (a r b : Nat) (g : Ps.Fin a -> Ps.Fin r -> FA.Polys) (h : Ps.Fin b -> Ps.Fin a -> FA.Polys)
  (identity : (l : Ps.Fin b) (j : Ps.Fin r) -> Id (T.D n).R
    (SS.sum a (\ i -> (T.D n).mul (P.phi n (g i j)) (P.phi n (h l i)))) (T.D n).z) {
  products (l : Ps.Fin b) (j : Ps.Fin r) : FA.Polys = FA.psum a (\ i -> FA.pmul (g i j) (h l i)) ;
  ring-zero (l : Ps.Fin b) (j : Ps.Fin r) : Id (T.D n).R (P.phi n (products l j)) (T.D n).z =
   trans (PP.sum a (\ i -> FA.pmul (g i j) (h l i)))
    (trans (SS.sum-cong a _ _ (\ i -> PP.product (g i j) (h l i))) (identity l j)) ;
  term-zero (l : Ps.Fin b) (j : Ps.Fin r) (f : L.Exp n -> D.R) (m : L.Exp n) :
   Id D.R (RS.sum a (\ i -> FA.mulP (g i j) (\ x -> FA.mulP (h l i) f x) m)) D.z =
   trans (RS.sum-cong a _ _ (\ i -> sym (FA.mulP-pmul (g i j) (h l i) f m)))
    (trans (sym (FA.mulP-psum a (\ i -> FA.pmul (g i j) (h l i)) f m))
      (INV.invariant (products l j) nil (ring-zero l j) f m)) ;
  equation (z : Ps.Fin b -> L.Exp n -> D.R) (j : Ps.Fin r) (m : L.Exp n) :
   Id D.R (RS.sum a (\ i -> FA.mulP (g i j) (\ x -> RS.sum b (\ l -> FA.mulP (h l i) (z l) x)) m)) D.z =
   trans (RS.sum-cong a (\ i -> FA.mulP (g i j) (\ x -> RS.sum b (\ l -> FA.mulP (h l i) (z l) x)) m) (\ i -> RS.sum b (\ l -> FA.mulP (g i j) (\ x -> FA.mulP (h l i) (z l) x) m)) (\ i -> mul-sum (g i j) m b (\ l x -> FA.mulP (h l i) (z l) x)))
    (trans (RS.sum-swap a b (\ i l -> FA.mulP (g i j) (\ x -> FA.mulP (h l i) (z l) x) m))
      (trans (RS.sum-cong b (\ l -> RS.sum a (\ i -> FA.mulP (g i j) (\ x -> FA.mulP (h l i) (z l) x) m)) (\ l -> D.z) (\ l -> term-zero l j (z l) m)) (RS.sum-zero b))) ;
 } ;
 module Sums (k r : Int) {
  module CH = C.Cochains[n,k,r] ; module CS = Comb[l].Sums[D,CH.mod] ;
  val (s : Sub n) (m : L.Exp n) : (a : Nat) (f : Ps.Fin a -> CH.El) ->
   Id D.R (CH.val (CS.sum a f) s m) (RS.sum a (\ i -> CH.val (f i) s m)) = split {
   zero -> \ f -> refl D.z ;
   suc a | rec -> \ f -> ap (D.add (CH.val (f (inr tt)) s m)) (rec (\ i -> f (inl i))) } ;
 } ;
 module Matrix (a b : Nat) (ko : Ps.Fin a -> Int) (ki : Ps.Fin b -> Int)
  (g : Ps.Fin a -> Ps.Fin b -> FA.Polys)
  (hg : (i : Ps.Fin a) (j : Ps.Fin b) -> M.A.Shifts (ki j) (ko i) (g i j)) (r : Int) {
  module A = M.Matrix[a,b,ko,ki,g,hg,r] ;
  value (z : A.Source.El) (i : Ps.Fin a) (s : Sub n) (m : L.Exp n) :
   Id D.R (C.Cochains[n,ko i,r].val (A.lin.f z i) s m)
    (RS.sum b (\ j -> FA.mulP (g i j) (C.Cochains[n,ki j,r].val (z j) s) m)) =
   trans (ap (\ x -> C.Cochains[n,ko i,r].val x s m) (A.row-value z i))
    (trans (Sums[ko i,r].val s m b (\ j -> (A.entry i j).f (z j)))
      (RS.sum-cong b _ _ (\ j -> M.A.Act[ki j,ko i,r,g i j,hg i j].val (z j) s m))) ;
 } ;
 module Composite (a r b : Nat) (ko : Ps.Fin r -> Int) (km : Ps.Fin a -> Int) (ki : Ps.Fin b -> Int)
  (g : Ps.Fin a -> Ps.Fin r -> FA.Polys) (h : Ps.Fin b -> Ps.Fin a -> FA.Polys)
  (hg : (i : Ps.Fin a) (j : Ps.Fin r) -> M.A.Shifts (km i) (ko j) (g i j))
  (hh : (l : Ps.Fin b) (i : Ps.Fin a) -> M.A.Shifts (ki l) (km i) (h l i))
  (identity : (l : Ps.Fin b) (j : Ps.Fin r) -> Id (T.D n).R
    (SS.sum a (\ i -> (T.D n).mul (P.phi n (g i j)) (P.phi n (h l i)))) (T.D n).z) (card : Int) {
  module G = Matrix[r,a,ko,km,\ j i -> g i j,\ j i -> hg i j,card] ;
  module H = Matrix[a,b,km,ki,\ i l -> h l i,\ i l -> hh l i,card] ;
  module K = Kernel[a,r,b,g,h,identity] ;
  equation (z : H.A.Source.El) : Id G.A.Target.El (G.A.lin.f (H.A.lin.f z)) G.A.Target.mod.mz =
   G.A.Target.Prod.ext _ _ (\ j -> C.Cochains[n,ko j,card].M.eq _ _ (\ s m ->
    trans (G.value (H.A.lin.f z) j s m)
     (trans (RS.sum-cong a _ _ (\ i -> FA.mulP-cong (g i j) (C.Cochains[n,km i,card].val (H.A.lin.f z i) s)
        (\ x -> RS.sum b (\ l -> FA.mulP (h l i) (C.Cochains[n,ki l,card].val (z l) s) x))
         (H.value z i s) m))
       (K.equation (\ l -> C.Cochains[n,ki l,card].val (z l) s) j m)))) ;
 } ;
} ;
