 import FreeNoeth ; import LinIso ; import Blocks ; import SeqPoly ; import XSpan ; import Saturation ; import DegreeCor ; import PolyCoef ;
 import HilbertD ; import FinCat ; import Schreyer ; import HilbertC ; import CodedNoeth ; import CFN ; import HilbertCFN ;
 -- Stage 1 and Stage 2 (sag/zmt-lifting, unchanged)
 import RelationCertificate ; import CertifiedDependence ; import LinearCertificate ;
 import ZInt ; import Laurent3 ; import Cech3 ; import CechContraction ; import CechMonomials ; import LaurentList ; import CechModules ;
 import Laurent4 ; import Cech4 ; import Cech4Contraction ; import TopList4 ; import TopCoordinates4 ; import CubicCertificate ;
 import Integers ; import ZRing ; import ZArith ; import ZCFN ;
 import CubicDependence ; import CubicExample ;
 -- the general four-coordinate certificate (sag/zmt-lifting-general, unchanged)
 import PolynomialAction4 ; import ShiftedCech4 ; import HomogeneousMatrices4 ; import LaurentSyzygyLift4 ; import TopCoordinatesShift4 ; import ResolutionCertificate4 ; import ResolutionDependence4 ; import CubicResolution4 ; import PolynomialPairExample4 ;
 -- homogeneous syzygies (sag/zmt-syzygies4, unchanged)
 import FinitePolynomial4 ; import PolynomialRing4Bridge ; import WeightedParts4 ; import UngradedSyzygies4 ; import HomogeneousSyzygies4 ; import CoherentDependence4 ; import SyzygyRegression4 ;
 -- reused weighted milestone
 import CoefficientParts ; import CoefficientPolynomial ; import CoefficientCech4 ; import BihomogeneousAction4 ; import WeightedDependence4 ; import FiniteIdealPowers ; import CoefficientEvaluation4 ; import WeightedRegression4 ;
 import FiniteExponents ; import PolynomialTowerBridge ; import PolynomialDegreeBridge ; import PolynomialBridgeRegression ; import FiniteHomogeneousPieces ; import ShiftedParts ; import HomogeneousKernel ; import HomogeneousStages ; import GenericSyzygyRegression ;
 import GenericCube ; import GenericContraction ; import GenericSupport ; import GenericDegree ; import GenericLaurent ; import GenericCech ; import GenericTop ; import GenericCardinality ; import GenericCechTheorems ; import GenericRegression ;
 import LaurentExponentBridge ; import ChartDenominators ; import PolynomialCoefficientParts ; import ChartPolynomialization ; import LaurentPolynomialCoefficients ; import CertificateExtension ; import FiniteLaurentAction ; import TowerLaurentAction ; import PolynomialTowerProducts ; import ClearingCoefficientBridge ; import LocalizedSyzygies ; import HomogeneousRepresentatives ; import FiniteZigzagCertificate ; import FinitePolynomialResolution ; import HomogeneousStageRepresentatives ;
 import CechPolynomialAction ; import ShiftedMatrixAction ; import FiniteExponentBoxes ; import FiniteTopExponents ; import NegativeClassification ; import FiniteLookup ; import FiniteTopPresentation ; import FiniteFamilyCoordinates ; import ShiftedTopPresentation ; import PolynomialActionTowerComparison ; import TopEnumerationSoundness ; import ActionComposition ;
 import MatrixActionLaws ;
