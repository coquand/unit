-- Construct the primitive/top schedule for any finite Cech zigzag. If
-- ambient nvar=n+(r+2), n+1 raising steps go from cardinality r+1 to nvar.
-- Every earlier cardinality is strictly below top; the terminal is the
-- explicit finite top-coordinate presentation, transported once by the
-- stated natural ambient equality. No primitive is an extra hypothesis.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module R = FinitePolynomialResolution[l] ; module O = NatOrder[l] ;
module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) (nvar : Nat) {
 module C = ResolutionCechDiagram[l].Over[K0,D,setD,cfn,nvar] ; module P = C.C ;
 module PP = PrimitivePackages[l].Over[D,setD] ;
 module Contract (n : Nat) (master : P.Cursor) (i r : Nat) (e : Id Nat nvar (plus n (suc (suc r)))) {
  module I = C.Instance[master] ;
  lt : O.Lt (suc r) nvar = subst (O.Le (suc (suc r))) (sym e) (O.le-plus-right n (suc (suc r))) ;
  ne : Not (Id ZInt[l].Int (GenericDegree[l].topRank nvar) (GenericDegree[l].topRank (suc r))) =
   NaturalCardinality[l].lt-ne (suc r) nvar lt ;
  contraction : I.Z.Cell[i,r].Contract = PP.BelowTop[nvar,(I.object i).rank,C.twists (I.object i),r,ne].contract ;
 } ;
 Goal (n : Nat) : U l = (master : P.Cursor) (i r : Nat) ->
  Id Nat nvar (plus n (suc (suc r))) -> C.Instance[master].Z.Schedule (suc n) i r ;
 module Last (master : P.Cursor) (i r : Nat) (e : Id Nat nvar (suc (suc r))) {
  module I = C.Instance[master] ;
  terminal : I.Z.Cell[suc i,suc r].Terminal =
   PP.Top[suc r,(I.object (suc i)).rank,C.twists (I.object (suc i))].terminal nvar e ;
  result : I.Z.Schedule (suc zero) i r = (Contract[zero,master,i,r,e].contraction,terminal) ;
 } ;
 module Step (n : Nat) (ih : Goal n) (master : P.Cursor) (i r : Nat) (e : Id Nat nvar (plus (suc n) (suc (suc r)))) {
  next : Id Nat nvar (plus n (suc (suc (suc r)))) = trans e (sym (plus-suc n (suc (suc r)))) ;
  result : C.Instance[master].Z.Schedule (suc (suc n)) i r =
   (Contract[suc n,master,i,r,e].contraction,ih master (suc i) (suc r) next) ;
 } ;
 schedule : (n : Nat) -> Goal n = split {
  zero -> \ master i r e -> Last[master,i,r,e].result ;
  suc n | rec -> \ master i r e -> Step[n,rec,master,i,r,e].result } ;
} ;
