-- The family x |-> (x = oo -> 2) over N∞ is not a family of Stone spaces
-- (a remark for the comparison with Escardó's TypeTopology.StoneTypes,
-- where P -> 2 is compact and totally separated for every proposition P,
-- and the sum over x : N∞ of x = oo -> 2 is not totally separated).
--
-- For a closed proposition P, the two constant maps P -> 2 are equal iff
-- not P.  If P -> 2 is Stone this equality is closed (Lemma 3.10); not P is
-- also open (Remark 1.20), hence decidable (Corollary 1.22), hence so is P
-- (closed propositions are not-not-stable).  Over N∞, x = oo is closed, so
-- if every x = oo -> 2 were Stone, x = oo would be decidable for every x.
-- Applied to the first hit of alpha (BoolSeq.first) this is WLPO,
-- refuted by Theorem 1.14.  So Theorem 4.18 does not apply to this family.
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ;
module BR = BooleanRing[l] ;
module P = Presented[l] ;
module Ex = Examples[l] ;
module TP = TwoPresented[l] ;
module BS = BoolSeq[l] ;
module Om = Omniscience[l,k] ;
module OC = OpenClosed[l,k] ;
module PF = Profinite[l,k] ;
module SC = StoneClosed[l,k] ;
module SA = StoneAxioms[l,k] ;

-- the two constant maps P -> 2 are equal iff not P
c0 (Q : U l) (q : Q) : Bool = false ;
c1 (Q : U l) (q : Q) : Bool = true ;
const-eq (Q : U l) : Iff (Not Q) (Id (Q -> Bool) (c0 Q) (c1 Q)) =
 (\ n -> F.funext Q (\ q -> Bool) (c0 Q) (c1 Q) (\ q -> Pr.absurd (Id Bool false true) (n q)),
  \ e q -> BR.true-false (sym (Pr.happly Q (\ q' -> Bool) (c0 Q) (c1 Q) e q))) ;

dec-iff (A B : U l) (e : Iff A B) : Dec A -> Dec B = split {
 yes a -> yes (e.1 a) ; no n -> no (\ b -> n (e.2 b)) } ;

-- the point oo of N∞, and x = oo  <->  forall n. x n = 0
zeros-prop (beta : Nat -> Bool) : Pr.isProp (P.Zeros Ex.rinf beta) =
 F.isProp-Pi Nat (\ n -> Id Bool ((Ex.rinf n).1 beta) false) (\ n -> BR.bool-set _ _) ;
ninf-set : Pr.isSet Ex.Ninf =
 Pr.isSet-Sigma (Nat -> Bool) (P.Zeros Ex.rinf) (F.isSet-Pi Nat (\ n -> Bool) (\ n -> BR.bool-set))
  (\ beta -> Pr.prop-to-set (P.Zeros Ex.rinf beta) (zeros-prop beta)) ;
oo : Ex.Ninf = (TP.zeroes, BS.first-ninf TP.zeroes) ;
is-oo (x : Ex.Ninf) : Iff (Id Ex.Ninf x oo) (Om.AllZero x.1) =
 (\ q n -> Pr.happly Nat (\ m -> Bool) x.1 TP.zeroes (ap (\ y -> y.1) q) n,
  \ z -> Pr.Sigma-eq (Nat -> Bool) (P.Zeros Ex.rinf) x.1 TP.zeroes x.2 oo.2
    (F.funext Nat (\ n -> Bool) x.1 TP.zeroes z) (zeros-prop TP.zeroes)) ;
oo-closed (x : Ex.Ninf) : OC.isClosed (Id Ex.Ninf x oo) =
 T.Trunc[OC.ClosedW (Id Ex.Ninf x oo)].inc (x.1, is-oo x) ;

-- the first hit of alpha, a point of N∞
first-pt (alpha : Nat -> Bool) : Ex.Ninf = (BS.first alpha, BS.first-ninf alpha) ;

module Over (ax : SA.Assumptions) {
 module O = Om.Over[ax] ;
 module OCo = OC.Over[ax] ;

 -- if P is closed and P -> 2 is Stone, then P is decidable
 fibre-dec (Q : U l) (pQ : Pr.isProp Q) (c : OC.isClosed Q) (s : PF.isStone (Q -> Bool)) : Dec Q =
  OCo.dec-not-closed Q pQ c (OCo.open-closed-dec (Not Q) (not-prop Q) (OCo.neg-closed Q c)
   (OC.closed-iff (Not Q) (Id (Q -> Bool) (c0 Q) (c1 Q)) (const-eq Q)
     (SC.lemma310 (Q -> Bool) s (c0 Q) (c1 Q)))) ;

 -- alpha is 0 everywhere iff its first hit is
 allzero-first (alpha : Nat -> Bool) : Iff (Om.AllZero alpha) (Om.AllZero (BS.first alpha)) =
  (\ z n -> ap (\ b -> BR.and b (BR.not (BS.bor alpha n))) (z n),
   \ z -> OC.closed-stable (Om.AllZero alpha) (OC.allzero-prop alpha)
     (T.Trunc[OC.ClosedW (Om.AllZero alpha)].inc (alpha, (\ y -> y, \ y -> y)))
     (\ nz -> BR.true-false (trans (sym (BS.first-least alpha (O.MP[alpha].least nz).1
        (O.MP[alpha].least nz).2.1 (O.MP[alpha].least nz).2.2)) (z (O.MP[alpha].least nz).1)))) ;

 -- the family x |-> (x = oo -> 2) is not a family of Stone spaces
 fibres-not-stone (h : (x : Ex.Ninf) -> PF.isStone (Id Ex.Ninf x oo -> Bool)) : Empty =
  O.not-wlpo (\ alpha -> dec-iff (Id Ex.Ninf (first-pt alpha) oo) (Om.AllZero alpha)
   (\ q -> (allzero-first alpha).2 ((is-oo (first-pt alpha)).1 q),
    \ z -> (is-oo (first-pt alpha)).2 ((allzero-first alpha).1 z))
   (fibre-dec (Id Ex.Ninf (first-pt alpha) oo) (ninf-set (first-pt alpha) oo) (oo-closed (first-pt alpha))
     (h (first-pt alpha)))) ;
} ;
