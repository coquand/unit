-- The Boolean algebra 2^Z of all maps Z -> 2, pointwise.
level l ;
open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module BR = BooleanRing[l] ;

module Pow (Z : U l) {
 Carrier : U l = Z -> Bool ;
 pw (a b : Carrier) (h : (z : Z) -> Id Bool (a z) (b z)) : Id Carrier a b = F.funext Z (\ z -> Bool) a b h ;
 add (a b : Carrier) (z : Z) : Bool = BR.xor (a z) (b z) ;
 mul (a b : Carrier) (z : Z) : Bool = BR.and (a z) (b z) ;
 zero (z : Z) : Bool = false ;
 one (z : Z) : Bool = true ;
 ring : CRing = mkCRing Carrier zero one add mul (\ a -> a)
  (\ a b c -> pw (add a (add b c)) (add (add a b) c) (\ z -> BR.xor-assoc (a z) (b z) (c z)))
  (\ a b -> pw (add a b) (add b a) (\ z -> BR.xor-comm (a z) (b z)))
  (\ a -> pw (add a zero) a (\ z -> BR.xor-false (a z)))
  (\ a -> pw (add a a) zero (\ z -> BR.xor-self (a z)))
  (\ a b c -> pw (mul a (mul b c)) (mul (mul a b) c) (\ z -> BR.and-assoc (a z) (b z) (c z)))
  (\ a b -> pw (mul a b) (mul b a) (\ z -> BR.and-comm (a z) (b z)))
  (\ a -> pw (mul a one) a (\ z -> BR.and-true (a z)))
  (\ a b c -> pw (mul a (add b c)) (add (mul a b) (mul a c)) (\ z -> BR.and-xor (a z) (b z) (c z))) ;
 algebra : BR.BA = BR.mkBA ring (F.isSet-Pi Z (\ z -> Bool) (\ z -> BR.bool-set)) (\ a -> pw (mul a a) a (\ z -> BR.and-self (a z))) ;
} ;
