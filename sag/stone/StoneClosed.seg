-- SSD §3.2: Corollary 3.8, Corollary 3.9, Lemma 3.10.
--
-- 3.8.  For S = Sp(2[N]/(r)): not S iff 0 = 1 in 2[N]/(r) (Lemma 1.12) iff
-- J k = 1 in 2[N] for some k (Presented.trivial), and "J k = 1" is
-- decidable (DecFree); so not S is open, not not S is closed, and
-- ||S|| <-> not not S by Corollary 1.13.  (The paper: equality in a
-- countably presented algebra is open by Lemmas 2.12, 2.13.)
-- 3.9.  A closed proposition P <-> forall n. alpha n = 0 is the spectrum of
-- 2[N]/(g n \/ alpha n) (whose only possible point is 0, Omniscience.MP);
-- a Stone proposition is closed by 3.8.
-- 3.10.  Two points of Sp(2[N]/(r)) are equal iff they agree on every
-- generator (Presented.hom-ext-gen): a countable conjunction of decidable
-- propositions.
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module BF = BinfFacts[l] ;
module DF = DecFree[l] ;
module Om = Omniscience[l,k] ;
module OC = OpenClosed[l,k] ;
module PF = Profinite[l,k] ;
module L28 = Lemma28[l,k] ;
module SA = StoneAxioms[l,k] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;

-- a Stone space with a chosen presentation: X = Sp(2[N]/(r))
module Presentation (X : U l) (w : PF.StoneW X) (pr : P.Presentation w.1.1) {
 e : Pr.Equiv X (P.Sp (P.Presented pr.1)) =
  Eq.compose X (P.Sp w.1.1) (P.Sp (P.Presented pr.1)) w.2 (PF.sp-iso (P.Presented pr.1) w.1.1 pr.2) ;
} ;
-- a property of Stone spaces proved on presented spectra
on-stone (X : U l) (Q : U l) (pQ : Pr.isProp Q) (s : PF.isStone X)
  (h : (r : Nat -> FN.Elem) -> Pr.Equiv X (P.Sp (P.Presented r)) -> Q) : Q =
 T1.Trunc[PF.StoneW X].induction @l (\ t -> Q) (\ t -> pQ) (\ w ->
  TC.rec (P.Presentation w.1.1) @l Q pQ (\ pr -> h pr.1 Presentation[X, w, pr].e) w.1.2) s ;

-- the same, for a large proposition
on-stone1 (X : U l) (Q : U l+) (pQ : Prelude[l+].isProp Q) (s : PF.isStone X)
  (h : (r : Nat -> FN.Elem) -> Pr.Equiv X (P.Sp (P.Presented r)) -> Q) : Q =
 T1.Trunc[PF.StoneW X].induction @(l+) (\ t -> Q) (\ t -> pQ) (\ w ->
  TC.rec (P.Presentation w.1.1) @(l+) Q pQ (\ pr -> h pr.1 Presentation[X, w, pr].e) w.1.2) s ;

module Over (ax : SA.Assumptions) {
 module SD = StoneDuality[l,k].Over[ax] ;
 module OCo = OC.Over[ax] ;

 module ForPresented (r : Nat -> FN.Elem) {
  module G = P.Generated[FN.free, r] ;
  Bw : P.Booleω = TP.presented-booleω r ;
  alpha (K : Nat) : Bool = Om.decide (Id FN.Elem (G.J K) FN.eone) (DF.dec-eone (G.J K)) ;
  not-sp-open : OC.isOpen (Not (P.Sp (P.Presented r))) =
   T.Trunc[OC.OpenW (Not (P.Sp (P.Presented r)))].inc (alpha,
    (\ n -> TC.map ((K : Nat) * Id FN.Elem (G.J K) FN.eone) ((K : Nat) * Id Bool (alpha K) true)
      (\ u -> (u.1, Om.decide-yes (Id FN.Elem (G.J u.1) FN.eone) u.2 (DF.dec-eone (G.J u.1))))
      (G.trivial (sym ((SD.lemma112 Bw).2 n))),
     \ e -> TC.rec ((K : Nat) * Id Bool (alpha K) true) @l (Not (P.Sp (P.Presented r))) (not-prop (P.Sp (P.Presented r)))
      (\ u -> (SD.lemma112 Bw).1 (sym (G.trivial-back u.1
        (L28.decide-true (Id FN.Elem (G.J u.1) FN.eone) (DF.dec-eone (G.J u.1)) u.2)))) e)) ;
  sp-closed : OC.isClosed (T.Trunc[P.Sp (P.Presented r)].carrier) =
   OC.closed-iff (T.Trunc[P.Sp (P.Presented r)].carrier) (Not (Not (P.Sp (P.Presented r))))
    (\ t n -> TC.rec (P.Sp (P.Presented r)) @l Empty Pr.isProp-Empty n t, SD.cor113 Bw)
    (OC.neg-open (Not (P.Sp (P.Presented r))) not-sp-open) ;
 } ;

 -- Corollary 3.8
 cor38 (X : U l) (s : PF.isStone X) : OC.isClosed (T.Trunc[X].carrier) =
  on-stone X (OC.isClosed (T.Trunc[X].carrier)) T.Trunc[OC.ClosedW (T.Trunc[X].carrier)].proposition s (\ r e ->
   OC.closed-iff (T.Trunc[X].carrier) (T.Trunc[P.Sp (P.Presented r)].carrier)
    (TC.map X (P.Sp (P.Presented r)) e.1, TC.map (P.Sp (P.Presented r)) X e.2.sec)
    ForPresented[r].sp-closed) ;

 -- Corollary 3.9
 module ClosedProp (Q : U l) (pQ : Pr.isProp Q) (alpha : Nat -> Bool) (iff : Iff Q (Om.AllZero alpha)) {
  t (n : Nat) : FN.Elem = Om.LN.join (FN.gen n) (TP.const (alpha n)) ;
  zero-beta (beta : Nat -> Bool) (z : P.Zeros t beta) (n : Nat) : Id Bool (beta n) false =
   (TP.join-false (beta n) ((TP.const (alpha n)).1 beta) (z n)).1 ;
  zero-alpha (beta : Nat -> Bool) (z : P.Zeros t beta) (n : Nat) : Id Bool (alpha n) false =
   trans (sym (TP.const-value (alpha n) beta)) (TP.join-false (beta n) ((TP.const (alpha n)).1 beta) (z n)).2 ;
  zeros-of (az : Om.AllZero alpha) : P.Zeros t TP.zeroes = \ n ->
   ap (\ b -> BF.bjoin false ((TP.const b).1 TP.zeroes)) (az n) ;
  zprop (beta : Nat -> Bool) : Pr.isProp (P.Zeros t beta) =
   F.isProp-Pi Nat (\ n -> Id Bool ((t n).1 beta) false) (\ n -> BR.bool-set _ _) ;
  points-prop : Pr.isProp ((beta : Nat -> Bool) * P.Zeros t beta) = \ u v ->
   Pr.Sigma-eq (Nat -> Bool) (P.Zeros t) u.1 v.1 u.2 v.2
    (F.funext Nat (\ n -> Bool) u.1 v.1 (\ n -> trans (zero-beta u.1 u.2 n) (sym (zero-beta v.1 v.2 n)))) (zprop v.1) ;
  equiv : Pr.Equiv Q (P.Sp (P.Presented t)) =
   Eq.compose Q ((beta : Nat -> Bool) * P.Zeros t beta) (P.Sp (P.Presented t))
    (Bi.prop-equiv Q ((beta : Nat -> Bool) * P.Zeros t beta) pQ points-prop
      (\ q -> (TP.zeroes, zeros-of (iff.1 q))) (\ u -> iff.2 (zero-alpha u.1 u.2)))
    (Bi.inverse (P.Sp (P.Presented t)) ((beta : Nat -> Bool) * P.Zeros t beta) (P.sp-presented t)) ;
 } ;
 closed-stone (Q : U l) (pQ : Pr.isProp Q) (c : OC.isClosed Q) : PF.isStone Q =
  TC.rec (OC.ClosedW Q) @(l+) (PF.isStone Q) T1.Trunc[PF.StoneW Q].proposition
   (\ w -> T1.Trunc[PF.StoneW Q].inc (TP.presented-booleω ClosedProp[Q, pQ, w.1, w.2].t, ClosedProp[Q, pQ, w.1, w.2].equiv)) c ;
 stone-closed (Q : U l) (pQ : Pr.isProp Q) (s : PF.isStone Q) : OC.isClosed Q =
  OC.closed-iff Q (T.Trunc[Q].carrier) (T.Trunc[Q].inc, TC.rec Q @l Q pQ (\ q -> q)) (cor38 Q s) ;
 cor39 (Q : U l) (pQ : Pr.isProp Q) : Logic[l+].Iff (OC.isClosed Q) (PF.isStone Q) =
  (closed-stone Q pQ, stone-closed Q pQ) ;
} ;

-- Lemma 3.10 (no axioms)
xor-eq : (a b : Bool) -> Id Bool (BR.xor a b) false -> Id Bool a b = split {
 true -> split { true -> \ h -> refl true ; false -> \ h -> Pr.absurd (Id Bool true false) (BR.true-false h) } ;
 false -> \ b h -> sym h } ;
xor-same (a : Bool) : Id Bool (BR.xor a a) false = BR.xor-self a ;
module Equality (r : Nat -> FN.Elem) (u v : P.Sp (P.Presented r)) {
 module G = P.Generated[FN.free, r] ;
 alpha (m : Nat) : Bool = BR.xor (u.1 (G.Q.include (FN.gen m))) (v.1 (G.Q.include (FN.gen m))) ;
 iff : Iff (Id (P.Sp (P.Presented r)) u v) (Om.AllZero alpha) =
  (\ q m -> trans (ap (\ s -> BR.xor (u.1 (G.Q.include (FN.gen m))) (s.1 (G.Q.include (FN.gen m)))) (sym q))
     (xor-same (u.1 (G.Q.include (FN.gen m)))),
   \ z -> P.hom-ext-gen r BR.two u v (\ m -> xor-eq (u.1 (G.Q.include (FN.gen m))) (v.1 (G.Q.include (FN.gen m))) (z m))) ;
} ;
lemma310 (X : U l) (s : PF.isStone X) (x y : X) : OC.isClosed (Id X x y) =
 on-stone X (OC.isClosed (Id X x y)) T.Trunc[OC.ClosedW (Id X x y)].proposition s (\ r e ->
  T.Trunc[OC.ClosedW (Id X x y)].inc (Equality[r, e.1 x, e.1 y].alpha,
   OC.iff-trans (Id X x y) (Id (P.Sp (P.Presented r)) (e.1 x) (e.1 y)) (Om.AllZero Equality[r, e.1 x, e.1 y].alpha)
    (ap e.1, Eq.injective X (P.Sp (P.Presented r)) e.1 e.2 x y) Equality[r, e.1 x, e.1 y].iff)) ;
