-- Small facts on finite sets (Finite, FiniteClosure: worker B): Bool is
-- finite, a finite type decides its inhabitation, a decidable proposition
-- is finite, so decidable subsets of finite sets are finite; products.
level l ;
open Base ; open Logic[l] ; open Prelude[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module FC = FinChoice[l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module Bi = Bijection[l] ;

two-fin : Bool -> FC.Fin (suc (suc zero)) = split { true -> none ; false -> some none } ;
fin-two : FC.Fin (suc (suc zero)) -> Bool = split { none -> true ; some i -> false } ;
fin-two-some : (i : FC.Fin (suc zero)) -> Id (FC.Fin (suc (suc zero))) (some none) (some i) = split {
 none -> refl (some none) ;
 some e -> absurd (Id (FC.Fin (suc (suc zero))) (some none) (some (some e))) e } ;
fin-two-sec : (i : FC.Fin (suc (suc zero))) -> Id (FC.Fin (suc (suc zero))) (two-fin (fin-two i)) i = split {
 none -> refl none ; some i -> fin-two-some i } ;
two-fin-ret : (b : Bool) -> Id Bool (fin-two (two-fin b)) b = split { true -> refl true ; false -> refl false } ;
bool-finite : Fi.isFinite Bool = T.Trunc[Fi.FinEquiv Bool].inc
 (suc (suc zero), (two-fin, qinv Bool (FC.Fin (suc (suc zero))) two-fin fin-two fin-two-sec two-fin-ret)) ;

-- a finite type decides whether it is inhabited
dec-trunc-aux (X : U l) : (k : Nat) -> Equiv X (FC.Fin k) -> Dec (T.Trunc[X].carrier) = split {
 zero -> \ e -> no (\ t -> TC.rec X @l Empty isProp-Empty (\ x -> e.1 x) t) ;
 suc k -> \ e -> yes (T.Trunc[X].inc (e.2.sec none)) } ;
finite-dec (X : U l) (fX : Fi.isFinite X) : Dec (T.Trunc[X].carrier) =
 TC.rec (Fi.FinEquiv X) @l (Dec (T.Trunc[X].carrier)) (dec-prop (T.Trunc[X].carrier) T.Trunc[X].proposition)
  (\ w -> dec-trunc-aux X w.1 w.2) fX ;

-- a decidable proposition is finite
dec-prop-finite (P : U l) (pP : isProp P) : Dec P -> Fi.isFinite P = split {
 yes p -> FCl.finite-equiv P Top (Bi.prop-equiv P Top pP isTop (\ q -> tt) (\ t -> p)) FCl.top-finite ;
 no n -> FCl.finite-equiv P Empty (Bi.prop-equiv P Empty pP isProp-Empty n (absurd P)) FCl.empty-finite } ;
dec-subset-finite (X : U l) (fX : Fi.isFinite X) (P : X -> U l) (pP : (x : X) -> isProp (P x))
  (dP : (x : X) -> Dec (P x)) : Fi.isFinite ((x : X) * P x) =
 FCl.sigma-finite X fX P (\ x -> dec-prop-finite (P x) (pP x) (dP x)) ;
-- the points where a Boolean function is 1
bool-subset-finite (X : U l) (fX : Fi.isFinite X) (b : X -> Bool) : Fi.isFinite ((x : X) * Id Bool (b x) true) =
 FCl.sigma-finite X fX (\ x -> Id Bool (b x) true) (\ x -> FCl.id-finite Bool bool-finite (b x) true) ;
product-finite (X Y : U l) (fX : Fi.isFinite X) (fY : Fi.isFinite Y) : Fi.isFinite (X * Y) =
 FCl.sigma-finite X fX (\ x -> Y) (\ x -> fY) ;
