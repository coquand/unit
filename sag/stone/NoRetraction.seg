-- SSD Lemma 1.18: f : B∞ -> B∞ x B∞ of Theorem 1.17 has no retraction.
--
-- For a retraction r, put u = r (0, 1) and v = r (1, 0); u v = r (0, 0) = 0.
-- f [g (2j+1)] = (0, _) is below (0, 1), so [g (2j+1)] = r (f [g (2j+1)])
-- is below u; likewise [g (2j)] is below v.  At the point delta m of N∞,
-- [g m] is 1; so u is 1 at delta (2K+1) for every K and v at delta (2K+2).
-- A representative y of u with a truth table on K generators takes the same
-- value at delta (2K+1) and at 0, since these agree on the first K bits; so
-- u is 1 at the point 0, and so is v, and u v = 0 is 1 there.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FF = FreeFinite[l] ;
module FC = FinChoice[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module Ex = Examples[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module BF = BinfFacts[l] ;

module Gi = BF.Gi ;
module D = BF.D ;
module LB = RL[Ex.Binf.ring] ;
-- the point gamma of B∞, for gamma in N∞
module Pt (gamma : Nat -> Bool) (z : BF.InNinf gamma) {
 module X = P.Point[Ex.rinf, gamma, z] ;
} ;
-- delta m agrees with 0 on the first K bits when K < m
delta-far (K m : Nat) (lt : (i : Nat) -> NO.Lt i K -> NO.Lt i m) (i : FC.Fin K) :
  Id Bool (FN.res Bool K (NO.delta m) i) (FN.res Bool K TP.zeroes i) =
 trans (FN.res-index Bool K (NO.delta m) i)
  (trans (NO.delta-ne m (FN.index K i) (NO.lt-neq (FN.index K i) m (lt (FN.index K i) (TP.index-lt K i))))
   (sym (FN.res-index Bool K TP.zeroes i))) ;
odd-far (K i : Nat) (h : NO.Lt i K) : NO.Lt i (suc (NO.dbl K)) =
 subst (NO.Lt i) (ap (\ j -> suc j) (sym (NO.dbl-plus K))) (NO.lt-plus i K h (suc K)) ;
even-far (K i : Nat) (h : NO.Lt i K) : NO.Lt i (NO.dbl (suc K)) =
 subst (NO.Lt i) (ap (\ j -> suc (suc j)) (sym (NO.dbl-plus K))) (NO.lt-plus i K h (suc (suc K))) ;

module NoRetraction (r : BR.Hom D.product Ex.Binf) (ret : (x : Gi.Q.Carrier) -> Id Gi.Q.Carrier (r.1 (BF.f.1 x)) x) {
 u : Gi.Q.Carrier = r.1 (Gi.Q.zeroQ, Gi.Q.oneQ) ;
 v : Gi.Q.Carrier = r.1 (Gi.Q.oneQ, Gi.Q.zeroQ) ;
 uv : Id Gi.Q.Carrier (Gi.Q.mulQ u v) Gi.Q.zeroQ =
  trans (sym (r.2.2.2 (Gi.Q.zeroQ, Gi.Q.oneQ) (Gi.Q.oneQ, Gi.Q.zeroQ)))
   (trans (ap r.1 (FF.pair-path (LB.zero-mul Gi.Q.oneQ) (LB.mul-zero Gi.Q.oneQ))) (H.zero D.ring Ex.Binf.ring r)) ;
 -- c <= r e  when  f c <= e
 below (c : Gi.Q.Carrier) (e : D.Carrier) (h : Id D.Carrier (D.ring.mul (BF.f.1 c) e) (BF.f.1 c)) :
   Id Gi.Q.Carrier (Gi.Q.mulQ c (r.1 e)) c =
  calc Gi.Q.Carrier { Gi.Q.mulQ c (r.1 e)
   =< ap (\ t -> Gi.Q.mulQ t (r.1 e)) (sym (ret c)) > Gi.Q.mulQ (r.1 (BF.f.1 c)) (r.1 e)
   =< sym (r.2.2.2 (BF.f.1 c) e) > r.1 (D.ring.mul (BF.f.1 c) e)
   =< ap r.1 h > r.1 (BF.f.1 c) =< ret c > c } ;
 odd-below (j : Nat) : Id Gi.Q.Carrier (Gi.Q.mulQ (Gi.Q.include (FN.gen (suc (NO.dbl j)))) u) (Gi.Q.include (FN.gen (suc (NO.dbl j)))) =
  below (Gi.Q.include (FN.gen (suc (NO.dbl j)))) (Gi.Q.zeroQ, Gi.Q.oneQ)
   (FF.pair-path (trans (LB.mul-zero (BF.f1.1 (Gi.Q.include (FN.gen (suc (NO.dbl j)))))) (sym (BF.odd-f1 j)))
     (Ex.Binf.ring.mulO (BF.f2.1 (Gi.Q.include (FN.gen (suc (NO.dbl j))))))) ;
 even-below (j : Nat) : Id Gi.Q.Carrier (Gi.Q.mulQ (Gi.Q.include (FN.gen (NO.dbl j))) v) (Gi.Q.include (FN.gen (NO.dbl j))) =
  below (Gi.Q.include (FN.gen (NO.dbl j))) (Gi.Q.oneQ, Gi.Q.zeroQ)
   (FF.pair-path (Ex.Binf.ring.mulO (BF.f1.1 (Gi.Q.include (FN.gen (NO.dbl j)))))
     (trans (LB.mul-zero (BF.f2.1 (Gi.Q.include (FN.gen (NO.dbl j))))) (sym (BF.even-f2 j)))) ;
 -- an element above [g m] is 1 at delta m
 above (m : Nat) (w : Gi.Q.Carrier) (h : Id Gi.Q.Carrier (Gi.Q.mulQ (Gi.Q.include (FN.gen m)) w) (Gi.Q.include (FN.gen m))) :
   Id Bool ((Pt[NO.delta m, BF.delta-ninf m].X.point).1 w) true =
  trans (sym (ap (\ b -> BR.and b ((Pt[NO.delta m, BF.delta-ninf m].X.point).1 w))
                 (trans (Pt[NO.delta m, BF.delta-ninf m].X.value (FN.gen m)) (NO.delta-self m))))
   (trans (sym ((Pt[NO.delta m, BF.delta-ninf m].X.point).2.2.2 (Gi.Q.include (FN.gen m)) w))
    (trans (ap (Pt[NO.delta m, BF.delta-ninf m].X.point).1 h)
     (trans (Pt[NO.delta m, BF.delta-ninf m].X.value (FN.gen m)) (NO.delta-self m)))) ;
 -- so a representative is 1 at the point 0
 at-zero (w : Gi.Q.Carrier) (m : Nat -> Nat) (far : (K i : Nat) -> NO.Lt i K -> NO.Lt i (m K))
   (h : (K : Nat) -> Id Bool ((Pt[NO.delta (m K), BF.delta-ninf (m K)].X.point).1 w) true)
   (y : FN.Elem) (p : Id Gi.Q.Carrier (Gi.Q.include y) w) (ry : FN.Rep y.1) : Id Bool (y.1 TP.zeroes) true =
  trans (sym (FN.agree y ry (NO.delta (m ry.1)) TP.zeroes (delta-far ry.1 (m ry.1) (far ry.1))))
   (trans (sym (Pt[NO.delta (m ry.1), BF.delta-ninf (m ry.1)].X.value y))
    (trans (ap (Pt[NO.delta (m ry.1), BF.delta-ninf (m ry.1)].X.point).1 p) (h ry.1))) ;
 module P0 = Pt[TP.zeroes, Ex.infinity.2] ;
 value-zero (w : Gi.Q.Carrier) (m : Nat -> Nat) (far : (K i : Nat) -> NO.Lt i K -> NO.Lt i (m K))
   (h : (K : Nat) -> Id Bool ((Pt[NO.delta (m K), BF.delta-ninf (m K)].X.point).1 w) true) :
   Id Bool (P0.X.point.1 w) true =
  TC.rec ((y : FN.Elem) * Id Gi.Q.Carrier (Gi.Q.include y) w) @l (Id Bool (P0.X.point.1 w) true) (BR.bool-set _ _) (\ q ->
   TC.rec (FN.Rep q.1.1) @l (Id Bool (P0.X.point.1 w) true) (BR.bool-set _ _) (\ ry ->
    trans (ap P0.X.point.1 (sym q.2)) (trans (P0.X.value q.1) (at-zero w m far h q.1 q.2 ry))) q.1.2)
   (Gi.Q.representative w) ;
 absurd : Empty =
  BR.true-false (calc Bool { true
   =< sym (FN.cong2 BR.and (value-zero u (\ K -> suc (NO.dbl K)) odd-far (\ K -> above (suc (NO.dbl K)) u (odd-below K)))
                           (value-zero v (\ K -> NO.dbl (suc K)) even-far (\ K -> above (NO.dbl (suc K)) v (even-below (suc K)))))
   > BR.and (P0.X.point.1 u) (P0.X.point.1 v)
   =< sym (P0.X.point.2.2.2 u v) > P0.X.point.1 (Gi.Q.mulQ u v)
   =< ap P0.X.point.1 uv > P0.X.point.1 Gi.Q.zeroQ
   =< H.zero Ex.Binf.ring BR.two-ring P0.X.point > false }) ;
} ;
-- Lemma 1.18
no-retraction (r : BR.Hom D.product Ex.Binf) (ret : (x : Gi.Q.Carrier) -> Id Gi.Q.Carrier (r.1 (BF.f.1 x)) x) : Empty =
 NoRetraction[r, ret].absurd ;
