-- SSD §4.1: compact Hausdorff spaces (Def. 4.1), Lemma 4.2, Corollaries
-- 4.3, 4.4, Lemma 4.9.
--
-- X is compact Hausdorff if it is a set whose identity types are closed and
-- it is merely covered by a surjection q : S ->> X from a Stone space.
-- 4.2: A closed in X gives the closed q^-1 A, whose image is A (q
--   surjective); the image of a closed B in S is
--   x |-> exists s. B s /\ q s = x, closed by Corollary 3.13.
-- 4.3: exists x. A x  <->  exists s. A (q s), closed by 3.13; closed
--   propositions are not-not-stable.
-- 4.4: forall x. U x  <->  not (exists x. not U x); not U is closed, so the
--   existential is closed (4.3) and its negation open (MP); open
--   propositions are not-not-stable.
-- 4.9: separate q^-1 A and q^-1 B by a decidable D (Lemma 3.16); then
--   U = not q(not D) and V = not q(D) are open, contain A and B, and are
--   disjoint since every x is some q s and s is in D or not.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module TP = TwoPresented[l] ;
module Om = Omniscience[l,l] ;
module OC = OpenClosed[l,l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module Th = Thm311[l] ;
module L316 = Lemma316[l] ;
module SA = StoneAxioms[l,l] ;
module DCh = DependentChoice[l] ;
module NO = NatOrder[l] ;
module Pg = Pairing[l] ;
module DF = DecFree[l] ;
module Cp = Compact[l] ;
module H = RingHom[l] ;
module P = Presented[l] ;

-- covers by Stone spaces
Cover (X : U l) : U l+ = (S : U l) * PF.isStone S * (q : S -> X) * DCh.Surjective q ;
isCHaus (X : U l) : U l+ =
 Pr.isSet X * ((x y : X) -> OC.isClosed (Id X x y)) * T1.Trunc[Cover X].carrier ;
CHaus : U l+ = (X : U l) * isCHaus X ;

module Over (ax : SA.Assumptions) {
 module SCo = SC.Over[ax] ;
 module ThO = Th.Over[ax] ;
 module L316O = L316.Over[ax] ;
 module OCo = OC.Over[ax] ;

 -- Stone spaces are compact Hausdorff
 stone-set (X : U l) (s : PF.isStone X) : Pr.isSet X =
  SC.on-stone X (Pr.isSet X) (Axioms[l].FunExtLemmas[fe @l].isProp-Pi X (\ x -> (y : X) -> Pr.isProp (Id X x y)) (\ x ->
    Axioms[l].FunExtLemmas[fe @l].isProp-Pi X (\ y -> Pr.isProp (Id X x y)) (\ y -> Axioms[l].FunExtLemmas[fe @l].isProp-isProp (Id X x y)))) s
   (\ r e -> Pr.isSet-retract X (P.Sp (P.Presented r)) e.1 e.2.ret e.2.ret-eq (H.Properties[(P.Presented r).ring, BR.two-ring, BR.bool-set].set)) ;
 stone-chaus (X : U l) (s : PF.isStone X) : isCHaus X =
  (stone-set X s, \ x y -> SC.lemma310 X s x y,
   T1.Trunc[Cover X].inc (X, s, \ x -> x, \ x -> T.Trunc[(y : X) * Id X y x].inc (x, refl x))) ;

 module Covered (X : U l) (sX : Pr.isSet X) (idc : (x y : X) -> OC.isClosed (Id X x y)) (cv : Cover X) {
  S : U l = cv.1 ;
  sS : PF.isStone S = cv.2.1 ;
  q : S -> X = cv.2.2.1 ;
  qs : DCh.Surjective q = cv.2.2.2 ;
  -- Lemma 4.2
  Im (B : S -> U l) (x : X) : U l = T.Trunc[(s : S) * B s * Id X (q s) x].carrier ;
  image-closed (B : S -> U l) (pB : (s : S) -> Pr.isProp (B s)) (cB : (s : S) -> OC.isClosed (B s)) (x : X) : OC.isClosed (Im B x) =
   ThO.closed-exists S sS (\ s -> B s * Id X (q s) x) (\ s -> Pr.isProp-Sigma (B s) (\ b -> Id X (q s) x) (pB s) (\ b -> sX (q s) x))
    (\ s -> OC.closed-and (B s) (Id X (q s) x) (cB s) (idc (q s) x)) ;
  preimage-image (A : X -> U l) (pA : (x : X) -> Pr.isProp (A x)) (x : X) : Iff (A x) (Im (\ s -> A (q s)) x) =
   (\ a -> TC.map ((s : S) * Id X (q s) x) ((s : S) * A (q s) * Id X (q s) x) (\ u -> (u.1, subst A (sym u.2) a, u.2)) (qs x),
    \ im -> TC.rec ((s : S) * A (q s) * Id X (q s) x) @l (A x) (pA x) (\ u -> subst A u.2.2 u.2.1) im) ;
  -- Corollary 4.3
  exists-closed (A : X -> U l) (pA : (x : X) -> Pr.isProp (A x)) (cA : (x : X) -> OC.isClosed (A x)) :
    OC.isClosed (T.Trunc[(x : X) * A x].carrier) =
   OC.closed-iff (T.Trunc[(x : X) * A x].carrier) (T.Trunc[(s : S) * A (q s)].carrier)
    (TC.bind ((x : X) * A x) ((s : S) * A (q s)) (\ u -> TC.map ((s : S) * Id X (q s) u.1) ((s : S) * A (q s))
       (\ v -> (v.1, subst A (sym v.2) u.2)) (qs u.1)),
     TC.map ((s : S) * A (q s)) ((x : X) * A x) (\ v -> (q v.1, v.2)))
    (ThO.closed-exists S sS (\ s -> A (q s)) (\ s -> pA (q s)) (\ s -> cA (q s))) ;
  -- Corollary 4.4
  forall-open (U' : X -> U l) (pU : (x : X) -> Pr.isProp (U' x)) (oU : (x : X) -> OC.isOpen (U' x)) :
    OC.isOpen ((x : X) -> U' x) =
   OC.open-iff ((x : X) -> U' x) (Not (T.Trunc[(x : X) * Not (U' x)].carrier))
    (\ u t -> TC.rec ((x : X) * Not (U' x)) @l Empty Pr.isProp-Empty (\ v -> v.2 (u v.1)) t,
     \ n x -> OCo.open-stable (U' x) (pU x) (oU x) (\ nu -> n (T.Trunc[(x : X) * Not (U' x)].inc (x, nu))))
    (OCo.neg-closed (T.Trunc[(x : X) * Not (U' x)].carrier)
      (exists-closed (\ x -> Not (U' x)) (\ x -> not-prop (U' x)) (\ x -> OC.neg-open (U' x) (oU x)))) ;

  -- Lemma 4.5
  module L45 (C : Nat -> X -> U l) (pC : (n : Nat) (x : X) -> Pr.isProp (C n x)) (cC : (n : Nat) (x : X) -> OC.isClosed (C n x))
    (empty : (x : X) -> ((n : Nat) -> C n x) -> Empty) {
   B (n : Nat) (s : S) : U l = C n (q s) ;
   Small (k : Nat) : U l = (x : X) -> ((n : Nat) -> NO.Lt n k -> C n x) -> Empty ;
   module WithCuts (cut : (n : Nat) -> Th.Cut S (B n)) {
    e (m : Nat) (s : S) : Bool = (cut (Pg.unpair m).1).1 s (Pg.unpair m).2 ;
    all-of (s : S) (z : Om.AllZero (\ m -> e m s)) (n : Nat) : B n s = ((cut n).2 s).2 (\ k ->
     trans (sym (ap (\ p -> (cut p.1).1 s p.2) (Pg.hit n k).2)) (z (Pg.hit n k).1)) ;
    cov (s : S) : T.Trunc[(m : Nat) * Id Bool (e m s) true].carrier =
     T.Trunc[(m : Nat) * Id Bool (e m s) true].inc
      (Omniscience[l,l].Over[ax].markov (\ m -> e m s) (\ z -> empty (q s) (all-of s z))) ;
    small (K : Nat) (fk : Cp.FiniteSub S e K) : Small K = \ x h ->
     TC.rec ((s : S) * Id X (q s) x) @l Empty Pr.isProp-Empty (\ v ->
      TC.rec ((m : Nat) * NO.Lt m K * Id Bool (e m v.1) true) @l Empty Pr.isProp-Empty (\ w ->
       NO.false-true (trans (sym (((cut (Pg.unpair w.1).1).2 v.1).1
          (subst (C (Pg.unpair w.1).1) (sym v.2) (h (Pg.unpair w.1).1
            (NO.le-lt-trans (Pg.unpair w.1).1 w.1 K (Pg.unpair-bound w.1).1 w.2.1))) (Pg.unpair w.1).2)) w.2.2))
       (fk v.1)) (qs x) ;
    result : T.Trunc[(k : Nat) * Small k].carrier =
     TC.map ((K : Nat) * Cp.FiniteSub S e K) ((k : Nat) * Small k) (\ u -> (u.1, small u.1 u.2))
      (Cp.Over[ax].finite-subcover S sS e cov) ;
   } ;
   result : T.Trunc[(k : Nat) * Small k].carrier =
    TC.bind ((n : Nat) -> Th.Cut S (B n)) ((k : Nat) * Small k) (\ cut -> WithCuts[cut].result)
     (CountableChoice[l].cc (ax.dc @l) (\ n -> Th.Cut S (B n))
       (\ n -> ThO.closed-cut S sS (B n) (\ s -> pC n (q s)) (\ s -> cC n (q s)))) ;
  } ;

  -- Lemma 4.9: normality
  Normal (A B : X -> U l) : U l+ =
   (Uo : X -> U l) * (Vo : X -> U l) * ((x : X) -> Pr.isProp (Uo x)) * ((x : X) -> Pr.isProp (Vo x)) *
   ((x : X) -> OC.isOpen (Uo x)) * ((x : X) -> OC.isOpen (Vo x)) *
   ((x : X) -> A x -> Uo x) * ((x : X) -> B x -> Vo x) * ((x : X) -> Uo x -> Vo x -> Empty) ;
  module L49 (A B : X -> U l) (pA : (x : X) -> Pr.isProp (A x)) (pB : (x : X) -> Pr.isProp (B x))
    (cA : (x : X) -> OC.isClosed (A x)) (cB : (x : X) -> OC.isClosed (B x)) (disj : (x : X) -> A x -> B x -> Empty)
    (d : L316.Separation S (\ s -> A (q s)) (\ s -> B (q s))) {
   Db (b : Bool) (s : S) : U l = Id Bool (d.1 s) b ;
   Uo (x : X) : U l = Not (Im (Db false) x) ;
   Vo (x : X) : U l = Not (Im (Db true) x) ;
   db-closed (b : Bool) (s : S) : OC.isClosed (Db b s) = OC.dec-closed (Db b s) (DF.bool-dec (d.1 s) b) ;
   open-U (x : X) : OC.isOpen (Uo x) = OCo.neg-closed (Im (Db false) x) (image-closed (Db false) (\ s -> BR.bool-set _ _) (db-closed false) x) ;
   open-V (x : X) : OC.isOpen (Vo x) = OCo.neg-closed (Im (Db true) x) (image-closed (Db true) (\ s -> BR.bool-set _ _) (db-closed true) x) ;
   in-U (x : X) (a : A x) : Uo x = \ im ->
    TC.rec ((s : S) * Db false s * Id X (q s) x) @l Empty Pr.isProp-Empty
     (\ u -> BR.true-false (trans (sym (d.2.1 u.1 (subst A (sym u.2.2) a))) u.2.1)) im ;
   in-V (x : X) (b : B x) : Vo x = \ im ->
    TC.rec ((s : S) * Db true s * Id X (q s) x) @l Empty Pr.isProp-Empty
     (\ u -> BR.true-false (trans (sym u.2.1) (d.2.2 u.1 (subst B (sym u.2.2) b)))) im ;
   disj-at (x : X) (u : Uo x) (v : Vo x) (s : S) (p : Id X (q s) x) : Plus (Db true s) (Db false s) -> Empty = split {
    inl t -> v (T.Trunc[(s' : S) * Db true s' * Id X (q s') x].inc (s, t, p)) ;
    inr f -> u (T.Trunc[(s' : S) * Db false s' * Id X (q s') x].inc (s, f, p)) } ;
   disj-UV (x : X) (u : Uo x) (v : Vo x) : Empty =
    TC.rec ((s : S) * Id X (q s) x) @l Empty Pr.isProp-Empty (\ w -> disj-at x u v w.1 w.2 (TP.bool-cases (d.1 w.1))) (qs x) ;
   separated : Normal A B = (Uo, Vo, \ x -> not-prop (Im (Db false) x), \ x -> not-prop (Im (Db true) x), open-U, open-V, in-U, in-V, disj-UV) ;
  } ;
  normality (A B : X -> U l) (pA : (x : X) -> Pr.isProp (A x)) (pB : (x : X) -> Pr.isProp (B x))
    (cA : (x : X) -> OC.isClosed (A x)) (cB : (x : X) -> OC.isClosed (B x)) (disj : (x : X) -> A x -> B x -> Empty) :
    T1.Trunc[Normal A B].carrier =
   TC.rec (L316.Separation S (\ s -> A (q s)) (\ s -> B (q s))) @(l+) (T1.Trunc[Normal A B].carrier) T1.Trunc[Normal A B].proposition
    (\ d -> T1.Trunc[Normal A B].inc L49[A, B, pA, pB, cA, cB, disj, d].separated)
    (L316O.lemma316 S sS (\ s -> A (q s)) (\ s -> B (q s)) (\ s -> pA (q s)) (\ s -> pB (q s))
      (\ s -> cA (q s)) (\ s -> cB (q s)) (\ s -> disj (q s))) ;
 } ;
} ;
