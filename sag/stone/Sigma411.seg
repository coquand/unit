-- SSD Lemma 4.10 (one direction) and Lemma 4.11: compact Hausdorff spaces
-- are stable under Sigma types.
--
-- 4.10: a Stone space Sp(2[N]/(r)) is the closed subset of 2^N cut out by
--   the r n; so a compact Hausdorff Y is merely the image of a closed
--   subset of 2^N (Pres2N).
-- 4.11: identity types of Sigma x. Y x are Sigma types of closed
--   propositions, closed by Corollary 3.14.  For the cover, let q : S ->> X;
--   by local choice there are a Stone T, p : T ->> S and, for t : T, a
--   closed C t of 2^N with a surjection onto Y (q (p t)).  Then
--   Sigma t. C t is a closed subset of T x 2^N (Stone by Corollary 3.3 and
--   Theorem 3.11), and it surjects onto Sigma x. Y x.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module Om = Omniscience[l,l] ;
module OC = OpenClosed[l,l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module Th = Thm311[l] ;
module SPr = StoneProduct[l] ;
module CH = CHaus[l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;
module DCh = DependentChoice[l] ;

-- transport back and forth
subst-sym (A : U l) (B : A -> U l) (x y : A) (p : Id A x y) : (u : B y) -> Id (B y) (subst B p (subst B (sym p) u)) u =
 idJ A x (\ z q -> (u : B z) -> Id (B z) (subst B q (subst B (sym q) u)) u) (\ u -> refl u) y p ;

-- a closed subset of 2^N with a surjection onto Y
Pres2N (Y : U l) : U l =
 (a : (Nat -> Bool) -> Nat -> Bool) * (h : ((al : Nat -> Bool) * Om.AllZero (a al)) -> Y) * DCh.Surjective h ;

-- Cantor space is Stone
zeros (n : Nat) : FN.Elem = FN.ezero ;
cantor-equiv : Pr.Equiv (Nat -> Bool) (P.Sp (P.Presented zeros)) =
 Eq.compose (Nat -> Bool) ((al : Nat -> Bool) * P.Zeros zeros al) (P.Sp (P.Presented zeros))
  (\ al -> (al, \ n -> refl false), Pr.qinv (Nat -> Bool) ((al : Nat -> Bool) * P.Zeros zeros al) (\ al -> (al, \ n -> refl false)) (\ u -> u.1)
    (\ u -> Pr.Sigma-eq (Nat -> Bool) (P.Zeros zeros) u.1 u.1 (\ n -> refl false) u.2 (refl u.1)
      (F.isProp-Pi Nat (\ n -> Id Bool false false) (\ n -> BR.bool-set _ _)))
    (\ al -> refl al))
  (Bi.inverse (P.Sp (P.Presented zeros)) ((al : Nat -> Bool) * P.Zeros zeros al) (P.sp-presented zeros)) ;
cantor-stone : PF.isStone (Nat -> Bool) = T1.Trunc[PF.StoneW (Nat -> Bool)].inc (TP.presented-booleω zeros, cantor-equiv) ;

module Over (ax : SA.Assumptions) {
 module ThO = Th.Over[ax] ;
 module SPO = SPr.Over[ax] ;

 -- Lemma 4.10, for a compact Hausdorff space
 pres-of-cover (Y : U l) (cv : CH.Cover Y) : T.Trunc[Pres2N Y].carrier =
  SC.on-stone cv.1 (T.Trunc[Pres2N Y].carrier) T.Trunc[Pres2N Y].proposition cv.2.1 (\ r e ->
   T.Trunc[Pres2N Y].inc (\ al n -> (r n).1 al,
    \ u -> cv.2.2.1 (e.2.sec ((P.sp-presented r).2.sec u)),
    \ y -> TC.map ((s : cv.1) * Id Y (cv.2.2.1 s) y)
      ((u : (al : Nat -> Bool) * P.Zeros r al) * Id Y (cv.2.2.1 (e.2.sec ((P.sp-presented r).2.sec u))) y)
      (\ v -> ((P.sp-presented r).1 (e.1 v.1),
        trans (ap (\ w -> cv.2.2.1 (e.2.sec w)) (Pr.sec-ret (P.Sp (P.Presented r)) ((al : Nat -> Bool) * P.Zeros r al) (P.sp-presented r).1 (P.sp-presented r).2 (e.1 v.1)))
         (trans (ap cv.2.2.1 (Pr.sec-ret cv.1 (P.Sp (P.Presented r)) e.1 e.2 v.1)) v.2)))
      (cv.2.2.2 y))) ;
 pres-of-chaus (Y : U l) (cY : CH.isCHaus Y) : T.Trunc[Pres2N Y].carrier =
  T1.Trunc[CH.Cover Y].induction @l (\ t -> T.Trunc[Pres2N Y].carrier) (\ t -> T.Trunc[Pres2N Y].proposition)
   (pres-of-cover Y) cY.2.2 ;

 module Sig (X : U l) (cX : CH.isCHaus X) (Y : X -> U l) (cY : (x : X) -> CH.isCHaus (Y x)) {
  Sg : U l = (x : X) * Y x ;
  sg-set : Pr.isSet Sg = Pr.isSet-Sigma X Y cX.1 (\ x -> (cY x).1) ;
  -- identity types
  ids (u v : Sg) : OC.isClosed (Id Sg u v) =
   OC.closed-iff (Id Sg u v) ((p : Id X u.1 v.1) * Id (Y v.1) (subst Y p u.2) v.2)
    (Pr.sPath X Y u v, \ w -> Pr.Sigma-path X Y u.1 v.1 u.2 v.2 w.1 w.2)
    (ThO.closed-sigma (Id X u.1 v.1) (cX.1 u.1 v.1) (cX.2.1 u.1 v.1)
      (\ p -> Id (Y v.1) (subst Y p u.2) v.2) (\ p -> (cY v.1).1 (subst Y p u.2) v.2) (\ p -> (cY v.1).2.1 (subst Y p u.2) v.2)) ;
  -- the cover
  module FromCover (cv : CH.Cover X) (B : P.Booleω) (e : Pr.Equiv cv.1 (P.Sp B.1)) {
   q (s : P.Sp B.1) : X = cv.2.2.1 (e.2.sec s) ;
   Fm (s : P.Sp B.1) : U l = Pres2N (Y (q s)) ;
   module Got (d : SA.LocalData B Fm) {
    Tp : U l = P.Sp d.1.1 ;
    pp : Tp -> P.Sp B.1 = d.2.1 ;
    wt (t : Tp) : Fm (pp t) = d.2.2.2 t ;
    Src : U l = (t : Tp) * (al : Nat -> Bool) * Om.AllZero ((wt t).1 al) ;
    Flat : U l = (u : Tp * (Nat -> Bool)) * Om.AllZero ((wt u.1).1 u.2) ;
    flat : Pr.Equiv Src Flat =
     (\ w -> ((w.1, w.2.1), w.2.2), Pr.qinv Src Flat (\ w -> ((w.1, w.2.1), w.2.2)) (\ w -> (w.1.1, w.1.2, w.2))
       (\ w -> refl w) (\ w -> refl w)) ;
    src-stone : PF.isStone Src =
     ThO.stone-equiv Src Flat flat
      (ThO.cut-stone (Tp * (Nat -> Bool)) (SPO.product-stone Tp (Nat -> Bool) (T1.Trunc[PF.StoneW Tp].inc (d.1, Pr.idEquiv Tp)) cantor-stone)
        (\ u -> (wt u.1).1 u.2)) ;
    m (w : Src) : Sg = (q (pp w.1), (wt w.1).2.1 w.2) ;
    path (x : X) (s : cv.1) (qsx : Id X (cv.2.2.1 s) x) (t : Tp) (pt : Id (P.Sp B.1) (pp t) (e.1 s)) : Id X (q (pp t)) x =
     trans (ap q pt) (trans (ap cv.2.2.1 (Pr.sec-ret cv.1 (P.Sp B.1) e.1 e.2 s)) qsx) ;
    surj : DCh.Surjective m = \ u ->
     TC.bind ((s : cv.1) * Id X (cv.2.2.1 s) u.1) ((w : Src) * Id Sg (m w) u) (\ v ->
      TC.bind ((t : Tp) * Id (P.Sp B.1) (pp t) (e.1 v.1)) ((w : Src) * Id Sg (m w) u) (\ v' ->
       TC.map ((a : (al : Nat -> Bool) * Om.AllZero ((wt v'.1).1 al)) * Id (Y (q (pp v'.1))) ((wt v'.1).2.1 a)
                 (subst Y (sym (path u.1 v.1 v.2 v'.1 v'.2)) u.2))
        ((w : Src) * Id Sg (m w) u)
        (\ a -> ((v'.1, a.1),
          Pr.Sigma-path X Y (q (pp v'.1)) u.1 ((wt v'.1).2.1 a.1) u.2 (path u.1 v.1 v.2 v'.1 v'.2)
           (trans (ap (subst Y (path u.1 v.1 v.2 v'.1 v'.2)) a.2) (subst-sym X Y (q (pp v'.1)) u.1 (path u.1 v.1 v.2 v'.1 v'.2) u.2))))
        ((wt v'.1).2.2 (subst Y (sym (path u.1 v.1 v.2 v'.1 v'.2)) u.2)))
       (d.2.2.1 (e.1 v.1)))
      (cv.2.2.2 u.1) ;
    cover : CH.Cover Sg = (Src, src-stone, m, surj) ;
   } ;
  } ;
  cover : T1.Trunc[CH.Cover Sg].carrier =
   T1.Trunc[CH.Cover X].induction @(l+) (\ t -> T1.Trunc[CH.Cover Sg].carrier) (\ t -> T1.Trunc[CH.Cover Sg].proposition) (\ cv ->
    T1.Trunc[PF.StoneW cv.1].induction @(l+) (\ t -> T1.Trunc[CH.Cover Sg].carrier) (\ t -> T1.Trunc[CH.Cover Sg].proposition) (\ w ->
     Truncation[l+ \/ l].Trunc[SA.LocalData w.1 FromCover[cv, w.1, w.2].Fm].induction @(l+)
      (\ t -> T1.Trunc[CH.Cover Sg].carrier) (\ t -> T1.Trunc[CH.Cover Sg].proposition)
      (\ d -> T1.Trunc[CH.Cover Sg].inc FromCover[cv, w.1, w.2].Got[d].cover)
      (ax.local w.1 FromCover[cv, w.1, w.2].Fm (\ s -> pres-of-chaus (Y (FromCover[cv, w.1, w.2].q s)) (cY (FromCover[cv, w.1, w.2].q s)))))
     cv.2.1) cX.2.2 ;
  chaus : CH.isCHaus Sg = (sg-set, ids, cover) ;
 } ;
 -- Lemma 4.11
 sigma-chaus (X : U l) (cX : CH.isCHaus X) (Y : X -> U l) (cY : (x : X) -> CH.isCHaus (Y x)) : CH.isCHaus ((x : X) * Y x) =
  Sig[X, cX, Y, cY].chaus ;
} ;
