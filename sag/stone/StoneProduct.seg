-- SSD Corollary 3.3 for binary products: X x Y is Stone for X, Y Stone.
--
-- With X = Sp(2[N]/(rX)) and Y = Sp(2[N]/(rY)), code (x, y) as the join of
-- the bits of y (even places) and of x (odd places).  The codes are the
-- zeros of rX read on the odd bits and rY read on the even bits (truth
-- tables by countable choice, Spread), so X x Y is the spectrum of the
-- algebra presented by these relations.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module Tb = Tabulate[l] ;
module Sp = Spread[l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;

-- the bits of a point of a presented spectrum
module Bits (X : U l) (r : Nat -> FN.Elem) (e : Pr.Equiv X (P.Sp (P.Presented r))) {
 module G = P.Generated[FN.free, r] ;
 bits (x : X) (m : Nat) : Bool = (e.1 x).1 (G.Q.include (FN.gen m)) ;
 bits-zeros (x : X) : P.Zeros r (bits x) = ((P.sp-presented r).1 (e.1 x)).2 ;
 point (a : Nat -> Bool) (z : P.Zeros r a) : X = e.2.sec (P.Point[r, a, z].point) ;
 bits-point (a : Nat -> Bool) (z : P.Zeros r a) (m : Nat) : Id Bool (bits (point a z) m) (a m) =
  trans (ap (\ s -> s.1 (G.Q.include (FN.gen m))) (e.2.sec-eq (P.Point[r, a, z].point))) (P.Point[r, a, z].value (FN.gen m)) ;
 bits-inj (x x' : X) (h : (m : Nat) -> Id Bool (bits x m) (bits x' m)) : Id X x x' =
  Eq.injective X (P.Sp (P.Presented r)) e.1 e.2 x x' (P.hom-ext-gen r BR.two (e.1 x) (e.1 x') h) ;
} ;

module Over (ax : SA.Assumptions) {
 module Presented2 (X Y : U l) (rX rY : Nat -> FN.Elem)
   (eX : Pr.Equiv X (P.Sp (P.Presented rX))) (eY : Pr.Equiv Y (P.Sp (P.Presented rY)))
   (tX : (j : Nat) -> FN.Rep (rX j).1) (tY : (j : Nat) -> FN.Rep (rY j).1) {
  module BX = Bits[X, rX, eX] ;
  module BY = Bits[Y, rY, eY] ;
  relX (j : Nat) : FN.Elem = Tb.local-elem (NO.dbl (tX j).1) (\ a -> FN.ev (tX j).1 (tX j).2.1 (Sp.odds a)) (Sp.odds-local (tX j).1 (tX j).2.1) ;
  relY (j : Nat) : FN.Elem = Tb.local-elem (NO.dbl (tY j).1) (\ a -> FN.ev (tY j).1 (tY j).2.1 (Sp.evens a)) (Sp.evens-local (tY j).1 (tY j).2.1) ;
  t (m : Nat) : FN.Elem = NO.inter FN.Elem m relX relY ;
  code (u : X * Y) : Nat -> Bool = Sp.join (BY.bits u.2) (BX.bits u.1) ;
  -- the relations at a sequence, through its odd and even bits
  valX (a : Nat -> Bool) (j : Nat) : Id Bool ((t (NO.dbl j)).1 a) ((rX j).1 (Sp.odds a)) =
   trans (ap (\ y -> y.1 a) (NO.inter-even FN.Elem j relX relY)) (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tX j).2.2 (Sp.odds a)) ;
  valY (a : Nat -> Bool) (j : Nat) : Id Bool ((t (suc (NO.dbl j))).1 a) ((rY j).1 (Sp.evens a)) =
   trans (ap (\ y -> y.1 a) (NO.inter-odd FN.Elem j relX relY)) (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tY j).2.2 (Sp.evens a)) ;
  odds-code (u : X * Y) : Id (Nat -> Bool) (Sp.odds (code u)) (BX.bits u.1) =
   F.funext Nat (\ i -> Bool) (Sp.odds (code u)) (BX.bits u.1) (Sp.odds-join (BY.bits u.2) (BX.bits u.1)) ;
  evens-code (u : X * Y) : Id (Nat -> Bool) (Sp.evens (code u)) (BY.bits u.2) =
   F.funext Nat (\ i -> Bool) (Sp.evens (code u)) (BY.bits u.2) (Sp.evens-join (BY.bits u.2) (BX.bits u.1)) ;
  zeros-at (u : X * Y) (m : Nat) :
    Plus ((n : Nat) * Id Nat m (NO.dbl n)) ((n : Nat) * Id Nat m (suc (NO.dbl n))) -> Id Bool ((t m).1 (code u)) false = split {
   inl v -> trans (ap (\ k -> (t k).1 (code u)) v.2) (trans (valX (code u) v.1) (trans (ap (rX v.1).1 (odds-code u)) (BX.bits-zeros u.1 v.1))) ;
   inr v -> trans (ap (\ k -> (t k).1 (code u)) v.2) (trans (valY (code u) v.1) (trans (ap (rY v.1).1 (evens-code u)) (BY.bits-zeros u.2 v.1))) } ;
  to (u : X * Y) : P.Sp (P.Presented t) = P.Point[t, code u, \ m -> zeros-at u m (NO.parity m)].point ;
  -- reading a pair off a zero
  zX (a : Nat -> Bool) (z : P.Zeros t a) : P.Zeros rX (Sp.odds a) = \ j -> trans (sym (valX a j)) (z (NO.dbl j)) ;
  zY (a : Nat -> Bool) (z : P.Zeros t a) : P.Zeros rY (Sp.evens a) = \ j -> trans (sym (valY a j)) (z (suc (NO.dbl j))) ;
  from (s : P.Sp (P.Presented t)) : X * Y =
   (BX.point (Sp.odds ((P.sp-presented t).1 s).1) (zX ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2),
    BY.point (Sp.evens ((P.sp-presented t).1 s).1) (zY ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2)) ;
  bits-to (u : X * Y) (m : Nat) : Id Bool ((to u).1 (P.Generated[FN.free, t].Q.include (FN.gen m))) (code u m) =
   P.Point[t, code u, \ k -> zeros-at u k (NO.parity k)].value (FN.gen m) ;
  injective : Bi.Injective to = \ u v q ->
   FN.cong2 (\ x y -> (x, y))
    (BX.bits-inj u.1 v.1 (\ i -> trans (sym (Pr.happly Nat (\ k -> Bool) _ _ (odds-code u) i))
      (trans (sym (bits-to u (suc (NO.dbl i)))) (trans (ap (\ s -> s.1 (P.Generated[FN.free, t].Q.include (FN.gen (suc (NO.dbl i))))) q)
       (trans (bits-to v (suc (NO.dbl i))) (Pr.happly Nat (\ k -> Bool) _ _ (odds-code v) i))))))
    (BY.bits-inj u.2 v.2 (\ i -> trans (sym (Pr.happly Nat (\ k -> Bool) _ _ (evens-code u) i))
      (trans (sym (bits-to u (NO.dbl i))) (trans (ap (\ s -> s.1 (P.Generated[FN.free, t].Q.include (FN.gen (NO.dbl i)))) q)
       (trans (bits-to v (NO.dbl i)) (Pr.happly Nat (\ k -> Bool) _ _ (evens-code v) i)))))) ;
  code-from (s : P.Sp (P.Presented t)) (m : Nat) : Id Bool (code (from s) m) (((P.sp-presented t).1 s).1 m) =
   trans (FN.cong2 (\ y x -> Sp.join y x m)
     (F.funext Nat (\ i -> Bool) (BY.bits (from s).2) (Sp.evens ((P.sp-presented t).1 s).1)
       (BY.bits-point (Sp.evens ((P.sp-presented t).1 s).1) (zY ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2)))
     (F.funext Nat (\ i -> Bool) (BX.bits (from s).1) (Sp.odds ((P.sp-presented t).1 s).1)
       (BX.bits-point (Sp.odds ((P.sp-presented t).1 s).1) (zX ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2))))
    (Sp.join-parts ((P.sp-presented t).1 s).1 m) ;
  surjective (s : P.Sp (P.Presented t)) : T.Trunc[(u : X * Y) * Id (P.Sp (P.Presented t)) (to u) s].carrier =
   T.Trunc[(u : X * Y) * Id (P.Sp (P.Presented t)) (to u) s].inc (from s,
    P.hom-ext-gen t BR.two (to (from s)) s (\ m -> trans (bits-to (from s) m) (code-from s m))) ;
  equiv : Pr.Equiv (X * Y) (P.Sp (P.Presented t)) =
   (to, Bi.Bij[X * Y, P.Sp (P.Presented t), H.Properties[(P.Presented t).ring, BR.two-ring, BR.bool-set].set, to, injective, surjective].equiv) ;
  stone : PF.StoneW (X * Y) = (TP.presented-booleω t, equiv) ;
 } ;
 product-stone (X Y : U l) (sX : PF.isStone X) (sY : PF.isStone Y) : PF.isStone (X * Y) =
  SC.on-stone1 X (PF.isStone (X * Y)) T1.Trunc[PF.StoneW (X * Y)].proposition sX (\ rX eX ->
   SC.on-stone1 Y (PF.isStone (X * Y)) T1.Trunc[PF.StoneW (X * Y)].proposition sY (\ rY eY ->
    TC.rec ((j : Nat) -> FN.Rep (rX j).1) @(l+) (PF.isStone (X * Y)) T1.Trunc[PF.StoneW (X * Y)].proposition (\ tX ->
     TC.rec ((j : Nat) -> FN.Rep (rY j).1) @(l+) (PF.isStone (X * Y)) T1.Trunc[PF.StoneW (X * Y)].proposition (\ tY ->
      T1.Trunc[PF.StoneW (X * Y)].inc Presented2[X, Y, rX, rY, eX, eY, tX, tY].stone)
      (CountableChoice[l].cc (ax.dc @l) (\ j -> FN.Rep (rY j).1) (\ j -> (rY j).2)))
     (CountableChoice[l].cc (ax.dc @l) (\ j -> FN.Rep (rX j).1) (\ j -> (rX j).2)))) ;
} ;
