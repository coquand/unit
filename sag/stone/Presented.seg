-- The ideal generated by a sequence, countably presented Boolean algebras,
-- Booleω and the spectrum (SSD Def. 1.3, Remarks 1.4-1.5, Def. 1.7).
--
-- For r : N -> B, let J k = r 0 \/ .. \/ r (k-1).  The ideal generated by r
-- is  x |-> exists k. x <= J k  (DESIGN.md §4: x ~ y iff x + y is below a
-- finite join of the r n).  A morphism kills it iff it kills every r n,
-- since it sends J k to 0 and  x <= J k  gives  h x = h x h (J k) = 0.
-- So Hom(B/(r), C) is the set of morphisms B -> C killing every r n, and
-- 0 = 1 in B/(r) iff J k = 1 for some k.
--
-- We define countably presented algebras directly in the form of SSD
-- Remark 1.4: B is countably presented if it is merely isomorphic to
-- 2[N]/(r n) for some r : N -> 2[N].  Booleω is the type of these algebras;
-- its morphisms are those of Boolean algebras (Remark 1.5).
level l ;
open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module Lg = Logic[l] ;
module NA = NatArith[l] ;

-- order facts in a Boolean algebra
module Order (B : BR.BA) {
 module L = RL[B.ring] ;
 module BL = BR.Laws[B.ring, B.idem] ;
 leq-trans (x a b : B.ring.R) (h : BL.Leq x a) (h' : BL.Leq a b) : BL.Leq x b =
  calc B.ring.R { B.ring.mul x b =< ap (\ t -> B.ring.mul t b) (sym h) > B.ring.mul (B.ring.mul x a) b
   =< sym (B.ring.mulA x a b) > B.ring.mul x (B.ring.mul a b)
   =< ap (B.ring.mul x) h' > B.ring.mul x a =< h > x } ;
 join-comm (a b : B.ring.R) : Id B.ring.R (BL.join a b) (BL.join b a) =
  BL.add-cong (B.ring.addC a b) (B.ring.mulC a b) ;
 leq-join-left (a b : B.ring.R) : BL.Leq a (BL.join a b) =
  calc B.ring.R { B.ring.mul a (B.ring.add (B.ring.add a b) (B.ring.mul a b))
   =< B.ring.dist a (B.ring.add a b) (B.ring.mul a b)
   > B.ring.add (B.ring.mul a (B.ring.add a b)) (B.ring.mul a (B.ring.mul a b))
   =< BL.add-cong (B.ring.dist a a b) (B.ring.mulA a a b)
   > B.ring.add (B.ring.add (B.ring.mul a a) (B.ring.mul a b)) (B.ring.mul (B.ring.mul a a) b)
   =< BL.add-cong (ap (\ t -> B.ring.add t (B.ring.mul a b)) (B.idem a)) (ap (\ t -> B.ring.mul t b) (B.idem a))
   > B.ring.add (B.ring.add a (B.ring.mul a b)) (B.ring.mul a b)
   =< sym (B.ring.addA a (B.ring.mul a b) (B.ring.mul a b)) > B.ring.add a (B.ring.add (B.ring.mul a b) (B.ring.mul a b))
   =< ap (B.ring.add a) (BL.char2 (B.ring.mul a b)) > B.ring.add a B.ring.z
   =< B.ring.addZ a > a } ;
 leq-join-right (a b : B.ring.R) : BL.Leq b (BL.join a b) =
  subst (\ t -> BL.Leq b t) (join-comm b a) (leq-join-left b a) ;
 sum-leq (x y a : B.ring.R) (h : BL.Leq x a) (h' : BL.Leq y a) : BL.Leq (B.ring.add x y) a =
  trans (L.dist-left x y a) (BL.add-cong h h') ;
 absorb-leq (c x a : B.ring.R) (h : BL.Leq x a) : BL.Leq (B.ring.mul c x) a =
  trans (sym (B.ring.mulA c x a)) (ap (B.ring.mul c) h) ;
 -- 1 <= a means a = 1
 one-leq (a : B.ring.R) (h : BL.Leq B.ring.o a) : Id B.ring.R a B.ring.o = trans (sym (L.one-left a)) h ;
} ;

-- a morphism preserves joins
hom-join (A C : BR.BA) (h : BR.Hom A C) (a b : A.ring.R) :
 Id C.ring.R (h.1 (BR.Laws[A.ring, A.idem].join a b)) (BR.Laws[C.ring, C.idem].join (h.1 a) (h.1 b)) =
 trans (h.2.2.1 (A.ring.add a b) (A.ring.mul a b))
  (BR.Laws[C.ring, C.idem].add-cong (h.2.2.1 a b) (h.2.2.2 a b)) ;

module Generated (B : BR.BA) (r : Nat -> B.ring.R) {
 module O = Order[B] ;
 module BL = BR.Laws[B.ring, B.idem] ;
 J : Nat -> B.ring.R = split { zero -> B.ring.z ; suc k | j -> BL.join j (r k) } ;
 Below (x : B.ring.R) : U l = (k : Nat) * BL.Leq x (J k) ;
 Ideal (x : B.ring.R) : U l = T.Trunc[Below x].carrier ;

 J-mono : (d k : Nat) -> BL.Leq (J k) (J (NA.plus d k)) = split {
  zero -> \ k -> BL.leq-refl (J k) ;
  suc d | h -> \ k -> O.leq-trans (J k) (J (NA.plus d k)) (J (suc (NA.plus d k))) (h k)
    (O.leq-join-left (J (NA.plus d k)) (r (NA.plus d k))) } ;
 J-mono' (d k : Nat) : BL.Leq (J k) (J (NA.plus k d)) =
  subst (\ m -> BL.Leq (J k) (J m)) (NA.plus-comm d k) (J-mono d k) ;
 r-below (n : Nat) : Below (r n) = (suc n, O.leq-join-right (J n) (r n)) ;

 ideal-zero : Ideal B.ring.z = T.Trunc[Below B.ring.z].inc (zero, BL.zero-leq B.ring.z) ;
 ideal-sum (x y : B.ring.R) (i : Ideal x) (j : Ideal y) : Ideal (B.ring.add x y) =
  TC.map2 (Below x) (Below y) (Below (B.ring.add x y)) (\ p q ->
   (NA.plus p.1 q.1, O.sum-leq x y (J (NA.plus p.1 q.1))
     (O.leq-trans x (J p.1) (J (NA.plus p.1 q.1)) p.2 (J-mono' q.1 p.1))
     (O.leq-trans y (J q.1) (J (NA.plus p.1 q.1)) q.2 (J-mono p.1 q.1)))) i j ;
 ideal-absorb (a x : B.ring.R) (i : Ideal x) : Ideal (B.ring.mul a x) =
  TC.map (Below x) (Below (B.ring.mul a x)) (\ p -> (p.1, O.absorb-leq a x (J p.1) p.2)) i ;

 module Q = QuotientBA[l].Over[B, Ideal, \ x -> T.Trunc[Below x].proposition, ideal-zero, ideal-sum, ideal-absorb] ;
 quotient : BR.BA = Q.quotient ;

 -- 0 = 1 in B/(r) iff J k = 1 for some k
 trivial (h : Id Q.Carrier Q.oneQ Q.zeroQ) : T.Trunc[(k : Nat) * Id B.ring.R (J k) B.ring.o].carrier =
  TC.map (Below B.ring.o) ((k : Nat) * Id B.ring.R (J k) B.ring.o) (\ p -> (p.1, O.one-leq (J p.1) p.2))
   (Q.trivial h) ;
 trivial-back (k : Nat) (h : Id B.ring.R (J k) B.ring.o) : Id Q.Carrier Q.oneQ Q.zeroQ =
  Q.kills B.ring.o (T.Trunc[Below B.ring.o].inc (k, trans (ap (B.ring.mul B.ring.o) h) (B.ring.mulO B.ring.o))) ;

 module To (C : BR.BA) {
  module QT = Q.To[C] ;
  KillsGen (h : BR.Hom B C) : U l = (n : Nat) -> Id C.ring.R (h.1 (r n)) C.ring.z ;
  killsgen-prop (h : BR.Hom B C) : Pr.isProp (KillsGen h) =
   F.isProp-Pi Nat (\ n -> Id C.ring.R (h.1 (r n)) C.ring.z) (\ n -> C.set _ _) ;
  forward (h : BR.Hom B C) (k : QT.Kills h) : KillsGen h = \ n ->
   k (r n) (T.Trunc[Below (r n)].inc (r-below n)) ;
  kills-J (h : BR.Hom B C) (k : KillsGen h) : (m : Nat) -> Id C.ring.R (h.1 (J m)) C.ring.z = split {
   zero -> H.zero B.ring C.ring h ;
   suc m | j -> trans (hom-join B C h (J m) (r m))
    (trans (BR.Laws[C.ring, C.idem].add-cong (BR.Laws[C.ring, C.idem].add-cong j (k m))
                                             (BR.Laws[C.ring, C.idem].mul-cong j (k m)))
     (trans (ap (C.ring.add (C.ring.add C.ring.z C.ring.z)) (RL[C.ring].mul-zero C.ring.z))
      (trans (C.ring.addZ (C.ring.add C.ring.z C.ring.z)) (C.ring.addZ C.ring.z)))) } ;
  backward (h : BR.Hom B C) (k : KillsGen h) : QT.Kills h = \ x i ->
   TC.rec (Below x) @l (Id C.ring.R (h.1 x) C.ring.z) (C.set _ _) (\ p ->
    calc C.ring.R { h.1 x =< ap h.1 (sym p.2) > h.1 (B.ring.mul x (J p.1))
     =< h.2.2.2 x (J p.1) > C.ring.mul (h.1 x) (h.1 (J p.1))
     =< ap (C.ring.mul (h.1 x)) (kills-J h k p.1) > C.ring.mul (h.1 x) C.ring.z
     =< RL[C.ring].mul-zero (h.1 x) > C.ring.z }) i ;
  -- Hom(B/(r), C) = morphisms B -> C killing every r n
  universal : Pr.Equiv (BR.Hom quotient C) ((h : BR.Hom B C) * KillsGen h) =
   Equivalences[l].compose (BR.Hom quotient C) QT.Data ((h : BR.Hom B C) * KillsGen h) QT.universal
    (Lg.sigma-equiv (BR.Hom B C) (BR.Hom B C) (Pr.idEquiv (BR.Hom B C)) QT.Kills KillsGen
      QT.kills-prop killsgen-prop forward backward) ;
 } ;
} ;

------------------------------------------------------------------------
-- countably presented algebras

-- an isomorphism of Boolean algebras: a bijective morphism
Iso (A C : BR.BA) : U l = (h : BR.Hom A C) * Pr.isEquiv A.ring.R C.ring.R h.1 ;

Presented (r : Nat -> FN.Elem) : BR.BA = Generated[FN.free, r].quotient ;
Presentation (B : BR.BA) : U l = (r : Nat -> FN.Elem) * Iso (Presented r) B ;
CountablyPresented (B : BR.BA) : U l = T.Trunc[Presentation B].carrier ;
Booleω : U l+ = (B : BR.BA) * CountablyPresented B ;

-- the spectrum (SSD Def. 1.7)
Sp (B : BR.BA) : U l = BR.Hom B BR.two ;

-- composition of isomorphisms
iso-compose (A B C : BR.BA) (f : Iso A B) (g : Iso B C) : Iso A C =
 (H.compose A.ring B.ring C.ring g.1 f.1,
  (Equivalences[l].compose A.ring.R B.ring.R C.ring.R (f.1.1, f.2) (g.1.1, g.2)).2) ;

-- the point beta of 2[N]/(r), for beta killing every r n
module Point (r : Nat -> FN.Elem) (beta : Nat -> Bool) (z : (n : Nat) -> Id Bool ((r n).1 beta) false) {
 module X = Generated[FN.free, r].Q.To[BR.two].Extend[(FN.U2.extend beta,
   Generated[FN.free, r].To[BR.two].backward (FN.U2.extend beta) (\ n -> trans (FN.ext-two beta (r n)) (z n)))] ;
 point : BR.Hom (Presented r) BR.two = X.hom ;
 value (x : FN.Elem) : Id Bool (point.1 (Generated[FN.free, r].Q.include x)) (x.1 beta) =
  trans (X.D.beta x) (FN.ext-two beta x) ;
} ;

-- a point of 2[N]/(r) evaluates x at its values on the generators
sp-value (r : Nat -> FN.Elem) (q : Sp (Presented r)) (x : FN.Elem) :
 Id Bool (q.1 (Generated[FN.free, r].Q.include x)) (x.1 (\ m -> q.1 (Generated[FN.free, r].Q.include (FN.gen m)))) =
 trans (FN.U2.unique (H.compose FN.ring (Presented r).ring BR.two-ring q Generated[FN.free, r].Q.pi) x)
  (FN.ext-two (FN.U2.values (H.compose FN.ring (Presented r).ring BR.two-ring q Generated[FN.free, r].Q.pi)) x) ;

-- the inverse of an isomorphism is a morphism
iso-inv (A C : BR.BA) (i : Iso A C) : BR.Hom C A =
 (i.2.sec,
  Equivalences[l].injective A.ring.R C.ring.R i.1.1 i.2 (i.2.sec C.ring.o) A.ring.o (trans (i.2.sec-eq C.ring.o) (sym i.1.2.1)),
  \ c c' -> Equivalences[l].injective A.ring.R C.ring.R i.1.1 i.2 _ _
    (trans (i.2.sec-eq (C.ring.add c c')) (sym (trans (i.1.2.2.1 (i.2.sec c) (i.2.sec c'))
      (BR.Laws[C.ring, C.idem].add-cong (i.2.sec-eq c) (i.2.sec-eq c'))))),
  \ c c' -> Equivalences[l].injective A.ring.R C.ring.R i.1.1 i.2 _ _
    (trans (i.2.sec-eq (C.ring.mul c c')) (sym (trans (i.1.2.2.2 (i.2.sec c) (i.2.sec c'))
      (BR.Laws[C.ring, C.idem].mul-cong (i.2.sec-eq c) (i.2.sec-eq c')))))) ;

-- two morphisms out of 2[N]/(r) agreeing on the generators are equal
hom-ext-gen (r : Nat -> FN.Elem) (C : BR.BA) (h h' : BR.Hom (Presented r) C)
 (agree : (m : Nat) -> Id C.ring.R (h.1 (Generated[FN.free, r].Q.include (FN.gen m)))
                                 (h'.1 (Generated[FN.free, r].Q.include (FN.gen m)))) :
 Id (BR.Hom (Presented r) C) h h' =
 Generated[FN.free, r].Q.To[C].ext h h' (\ x ->
  calc C.ring.R { h.1 (Generated[FN.free, r].Q.include x)
   =< FN.UP[C].unique (H.compose FN.ring (Presented r).ring C.ring h Generated[FN.free, r].Q.pi) x
   > FN.UP[C].ext (FN.UP[C].values (H.compose FN.ring (Presented r).ring C.ring h Generated[FN.free, r].Q.pi)) x
   =< ap (\ g -> FN.UP[C].ext g x) (F.funext Nat (\ m -> C.ring.R)
        (FN.UP[C].values (H.compose FN.ring (Presented r).ring C.ring h Generated[FN.free, r].Q.pi))
        (FN.UP[C].values (H.compose FN.ring (Presented r).ring C.ring h' Generated[FN.free, r].Q.pi)) agree)
   > FN.UP[C].ext (FN.UP[C].values (H.compose FN.ring (Presented r).ring C.ring h' Generated[FN.free, r].Q.pi)) x
   =< sym (FN.UP[C].unique (H.compose FN.ring (Presented r).ring C.ring h' Generated[FN.free, r].Q.pi) x)
   > h'.1 (Generated[FN.free, r].Q.include x) }) ;

-- Sp(2[N]/(r)) = { alpha : 2^N | (r n)(alpha) = 0 for all n }
Zeros (r : Nat -> FN.Elem) (alpha : Nat -> Bool) : U l = (n : Nat) -> Id Bool ((r n).1 alpha) false ;
sp-presented (r : Nat -> FN.Elem) : Pr.Equiv (Sp (Presented r)) ((alpha : Nat -> Bool) * Zeros r alpha) =
 Equivalences[l].compose (Sp (Presented r)) ((h : BR.Hom FN.free BR.two) * Generated[FN.free, r].To[BR.two].KillsGen h)
  ((alpha : Nat -> Bool) * Zeros r alpha)
  (Generated[FN.free, r].To[BR.two].universal)
  (Lg.sigma-equiv (BR.Hom FN.free BR.two) (Nat -> Bool) FN.cantor
    (Generated[FN.free, r].To[BR.two].KillsGen) (Zeros r)
    (Generated[FN.free, r].To[BR.two].killsgen-prop)
    (\ alpha -> F.isProp-Pi Nat (\ n -> Id Bool ((r n).1 alpha) false) (\ n -> BR.bool-set _ _))
    (\ h k n -> trans (sym (trans (FN.U2.unique h (r n)) (FN.ext-two (FN.U2.values h) (r n)))) (k n))
    (\ h z n -> trans (trans (FN.U2.unique h (r n)) (FN.ext-two (FN.U2.values h) (r n))) (z n))) ;
