-- Stone duality for every Boolean algebra is inconsistent.
--
-- For a proposition P, let 2/P be the quotient of 2 by the ideal
-- { x | x = 1 -> P }, so that 0 = 1 in 2/P iff P.  A point of 2/P sends
-- 1 to 1 and 0 to 0, so it exists only if not P.  Assume not not P.  Then
-- Sp(2/P) is empty, the evaluations of 0 and 1 are equal maps on it, and
-- if the evaluation  2/P -> 2^Sp(2/P)  is injective, 0 = 1 in 2/P, hence P.
--
-- So injectivity of the evaluation for every Boolean algebra (which holds
-- classically: Stone's representation theorem) gives double negation
-- elimination, hence WLPO, while surjectivity at 2[N] (Axiom 1) gives not
-- WLPO (Omniscience.Continuity).  Duality for every Boolean algebra
-- therefore contradicts itself, and the restriction of Axiom 1 to
-- countably presented algebras is necessary.
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module BR = BooleanRing[l] ;
module P = Presented[l] ;
module SA = StoneAxioms[l,k] ;
module Om = Omniscience[l,k] ;

-- the two halves of duality for every Boolean algebra
InjectiveDuality : U l+ = (B : BR.BA) -> SA.Injective B.ring.R (P.Sp B -> Bool) (SA.evaluation B) ;
GeneralDuality : U l+ = (B : BR.BA) -> Pr.isEquiv B.ring.R (P.Sp B -> Bool) (SA.evaluation B) ;

module Kill (Q : U l) (pQ : Pr.isProp Q) {
 -- the ideal { x | x = 1 -> Q } of 2
 Ideal (x : Bool) : U l = Id Bool x true -> Q ;
 ideal-prop (x : Bool) : Pr.isProp (Ideal x) = F.isProp-Pi (Id Bool x true) (\ h -> Q) (\ h -> pQ) ;
 ideal-zero : Ideal false = \ h -> Pr.absurd Q (BR.true-false (sym h)) ;
 ideal-sum : (x y : Bool) -> Ideal x -> Ideal y -> Ideal (BR.xor x y) = split {
  true -> \ y i j h -> i (refl true) ;
  false -> \ y i j -> j } ;
 ideal-absorb : (a x : Bool) -> Ideal x -> Ideal (BR.and a x) = split {
  true -> \ x i -> i ;
  false -> \ x i -> ideal-zero } ;
 module K = QuotientBA[l].Over[BR.two, Ideal, ideal-prop, ideal-zero, ideal-sum, ideal-absorb] ;

 -- Sp(2/Q) -> not Q
 no-point (q : Q) (x : P.Sp K.quotient) : Empty =
  BR.true-false (trans (sym x.2.1) (trans (ap x.1 (K.kills true (\ h -> q))) (H.zero K.ring BR.two-ring x))) ;

 -- injectivity of the evaluation of 2/Q gives  not not Q -> Q
 stable (inj : SA.Injective K.ring.R (P.Sp K.quotient -> Bool) (SA.evaluation K.quotient))
   (nn : Not (Not Q)) : Q =
  K.trivial (inj K.oneQ K.zeroQ
   (F.funext (P.Sp K.quotient) (\ x -> Bool) (SA.evaluation K.quotient K.oneQ) (SA.evaluation K.quotient K.zeroQ)
     (\ x -> Pr.absurd (Id Bool (x.1 K.oneQ) (x.1 K.zeroQ)) (nn (\ q -> no-point q x)))))
   (refl true) ;
} ;

-- every proposition is not-not stable, so WLPO holds
dne (inj : InjectiveDuality) (Q : U l) (pQ : Pr.isProp Q) (nn : Not (Not Q)) : Q =
 Kill[Q, pQ].stable (inj Kill[Q, pQ].K.quotient) nn ;
wlpo (inj : InjectiveDuality) : Om.WLPO = \ alpha ->
 dne inj (Dec (Om.AllZero alpha))
  (dec-prop (Om.AllZero alpha) (F.isProp-Pi Nat (\ n -> Id Bool (alpha n) false) (\ n -> BR.bool-set _ _)))
  (\ n -> n (no (\ a -> n (yes a)))) ;

-- duality for every Boolean algebra is inconsistent
inconsistent (gd : GeneralDuality) : Empty =
 Om.Continuity[\ B -> gd B.1].not-wlpo
  (wlpo (\ B -> Equivalences[l].injective B.ring.R (P.Sp B -> Bool) (SA.evaluation B) (gd B))) ;
-- injectivity for every algebra already contradicts Axiom 1
inconsistent-injective (inj : InjectiveDuality) (duality : SA.Duality) : Empty =
 Om.Continuity[duality].not-wlpo (wlpo inj) ;
