-- The product A x B of Boolean algebras (componentwise), and
-- Sp(A x B) = Sp(A) + Sp(B).
--
-- For a point h of A x B, e = (1, 0) and e' = (0, 1) have e + e' = 1 and
-- e e' = 0, so exactly one of h e, h e' is 1.  If h e = 1, then
-- h (a, b) = h ((a, b) e) = h (a, 0), and a |-> h (a, 0) is a point of A;
-- symmetrically if h e' = 1.  Conversely a point of A or of B gives one of
-- A x B by composing with a projection; these are distinguished by their
-- value at e, and determined by their values at (a, 0), resp. (0, b).
level l ;
open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module BR = BooleanRing[l] ;
module FF = FreeFinite[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module Lg = Logic[l] ;

module Prod (A B : BR.BA) {
 module LA = RL[A.ring] ; module LB = RL[B.ring] ;
 Carrier : U l = A.ring.R * B.ring.R ;
 ring : CRing = mkCRing Carrier (A.ring.z, B.ring.z) (A.ring.o, B.ring.o)
  (\ u v -> (A.ring.add u.1 v.1, B.ring.add u.2 v.2)) (\ u v -> (A.ring.mul u.1 v.1, B.ring.mul u.2 v.2)) (\ u -> u)
  (\ u v w -> FF.pair-path (A.ring.addA u.1 v.1 w.1) (B.ring.addA u.2 v.2 w.2))
  (\ u v -> FF.pair-path (A.ring.addC u.1 v.1) (B.ring.addC u.2 v.2))
  (\ u -> FF.pair-path (A.ring.addZ u.1) (B.ring.addZ u.2))
  (\ u -> FF.pair-path (BR.Laws[A.ring, A.idem].char2 u.1) (BR.Laws[B.ring, B.idem].char2 u.2))
  (\ u v w -> FF.pair-path (A.ring.mulA u.1 v.1 w.1) (B.ring.mulA u.2 v.2 w.2))
  (\ u v -> FF.pair-path (A.ring.mulC u.1 v.1) (B.ring.mulC u.2 v.2))
  (\ u -> FF.pair-path (A.ring.mulO u.1) (B.ring.mulO u.2))
  (\ u v w -> FF.pair-path (A.ring.dist u.1 v.1 w.1) (B.ring.dist u.2 v.2 w.2)) ;
 product : BR.BA = BR.mkBA ring (Pr.isSet-Sigma A.ring.R (\ a -> B.ring.R) A.set (\ a -> B.set))
  (\ u -> FF.pair-path (A.idem u.1) (B.idem u.2)) ;

 fst : BR.Hom product A = (\ u -> u.1, refl A.ring.o, \ u v -> refl (A.ring.add u.1 v.1), \ u v -> refl (A.ring.mul u.1 v.1)) ;
 snd : BR.Hom product B = (\ u -> u.2, refl B.ring.o, \ u v -> refl (B.ring.add u.2 v.2), \ u v -> refl (B.ring.mul u.2 v.2)) ;
 pair (C : BR.BA) (f : BR.Hom C A) (g : BR.Hom C B) : BR.Hom C product =
  (\ c -> (f.1 c, g.1 c), FF.pair-path f.2.1 g.2.1,
   \ c c' -> FF.pair-path (f.2.2.1 c c') (g.2.2.1 c c'), \ c c' -> FF.pair-path (f.2.2.2 c c') (g.2.2.2 c c')) ;

 e : Carrier = (A.ring.o, B.ring.z) ;
 e' : Carrier = (A.ring.z, B.ring.o) ;
 e-sum : Id Carrier (ring.add e e') (A.ring.o, B.ring.o) = FF.pair-path (A.ring.addZ A.ring.o) (LB.zl B.ring.o) ;
 e-prod : Id Carrier (ring.mul e e') (A.ring.z, B.ring.z) = FF.pair-path (LA.mul-zero A.ring.o) (LB.zero-mul B.ring.o) ;

 module Point (h : P.Sp product) {
  sum : Id Bool (BR.xor (h.1 e) (h.1 e')) true = trans (sym (h.2.2.1 e e')) (trans (ap h.1 e-sum) h.2.1) ;
  prod : Id Bool (BR.and (h.1 e) (h.1 e')) false =
   trans (sym (h.2.2.2 e e')) (trans (ap h.1 e-prod) (H.zero ring BR.two-ring h)) ;
  -- the point of A when h e = 1
  left (t : Id Bool (h.1 e) true) : P.Sp A =
   (\ a -> h.1 (a, B.ring.z), t,
    \ a a' -> trans (ap h.1 (FF.pair-path (refl (A.ring.add a a')) (sym (B.ring.addZ B.ring.z)))) (h.2.2.1 (a, B.ring.z) (a', B.ring.z)),
    \ a a' -> trans (ap h.1 (FF.pair-path (refl (A.ring.mul a a')) (sym (LB.mul-zero B.ring.z)))) (h.2.2.2 (a, B.ring.z) (a', B.ring.z))) ;
  right (t : Id Bool (h.1 e') true) : P.Sp B =
   (\ b -> h.1 (A.ring.z, b), t,
    \ b b' -> trans (ap h.1 (FF.pair-path (sym (A.ring.addZ A.ring.z)) (refl (B.ring.add b b')))) (h.2.2.1 (A.ring.z, b) (A.ring.z, b')),
    \ b b' -> trans (ap h.1 (FF.pair-path (sym (LA.mul-zero A.ring.z)) (refl (B.ring.mul b b')))) (h.2.2.2 (A.ring.z, b) (A.ring.z, b'))) ;
  left-eq (t : Id Bool (h.1 e) true) (u : Carrier) : Id Bool (h.1 u) ((left t).1 u.1) =
   calc Bool { h.1 u =< sym (BR.and-true (h.1 u)) > BR.and (h.1 u) true
    =< ap (BR.and (h.1 u)) (sym t) > BR.and (h.1 u) (h.1 e)
    =< sym (h.2.2.2 u e) > h.1 (ring.mul u e)
    =< ap h.1 (FF.pair-path (A.ring.mulO u.1) (LB.mul-zero u.2)) > h.1 (u.1, B.ring.z) } ;
  right-eq (t : Id Bool (h.1 e') true) (u : Carrier) : Id Bool (h.1 u) ((right t).1 u.2) =
   calc Bool { h.1 u =< sym (BR.and-true (h.1 u)) > BR.and (h.1 u) true
    =< ap (BR.and (h.1 u)) (sym t) > BR.and (h.1 u) (h.1 e')
    =< sym (h.2.2.2 u e') > h.1 (ring.mul u e')
    =< ap h.1 (FF.pair-path (LA.mul-zero u.1) (B.ring.mulO u.2)) > h.1 (A.ring.z, u.2) } ;
 } ;

 into : Plus (P.Sp A) (P.Sp B) -> P.Sp product = split {
  inl x -> H.compose ring A.ring BR.two-ring x fst ;
  inr y -> H.compose ring B.ring BR.two-ring y snd } ;
 module ET = H.Properties[ring, BR.two-ring, BR.bool-set] ;
 into-inj : (x x' : Plus (P.Sp A) (P.Sp B)) -> Id (P.Sp product) (into x) (into x') -> Id (Plus (P.Sp A) (P.Sp B)) x x' = split {
  inl a -> split {
   inl a' -> \ p -> ap (\ c -> inl c) (H.Properties[A.ring, BR.two-ring, BR.bool-set].ext a a'
     (\ c -> ap (\ h -> h.1 (c, B.ring.z)) p)) ;
   inr b' -> \ p -> Pr.absurd (Id (Plus (P.Sp A) (P.Sp B)) (inl a) (inr b'))
     (BR.true-false (trans (sym a.2.1) (trans (ap (\ h -> h.1 e) p) (H.zero B.ring BR.two-ring b')))) } ;
  inr b -> split {
   inl a' -> \ p -> Pr.absurd (Id (Plus (P.Sp A) (P.Sp B)) (inr b) (inl a'))
     (BR.true-false (trans (sym a'.2.1) (trans (ap (\ h -> h.1 e) (sym p)) (H.zero B.ring BR.two-ring b)))) ;
   inr b' -> \ p -> ap (\ c -> inr c) (H.Properties[B.ring, BR.two-ring, BR.bool-set].ext b b'
     (\ c -> ap (\ h -> h.1 (A.ring.z, c)) p)) } } ;
 fibre-at (h : P.Sp product) :
   Plus (Id Bool (h.1 e) true) (Id Bool (h.1 e) false) -> (x : Plus (P.Sp A) (P.Sp B)) * Id (P.Sp product) (into x) h = split {
  inl t -> (inl (Point[h].left t), ET.ext (into (inl (Point[h].left t))) h (\ u -> sym (Point[h].left-eq t u))) ;
  inr f -> (inr (Point[h].right (trans (sym (ap (\ b -> BR.xor b (h.1 e')) f)) Point[h].sum)),
   ET.ext (into (inr (Point[h].right (trans (sym (ap (\ b -> BR.xor b (h.1 e')) f)) Point[h].sum)))) h
    (\ u -> sym (Point[h].right-eq (trans (sym (ap (\ b -> BR.xor b (h.1 e')) f)) Point[h].sum) u))) } ;
 fibre (h : P.Sp product) : (x : Plus (P.Sp A) (P.Sp B)) * Id (P.Sp product) (into x) h =
  fibre-at h (TP.bool-cases (h.1 e)) ;
 -- Sp(A x B) = Sp(A) + Sp(B)
 sp-product : Pr.Equiv (Plus (P.Sp A) (P.Sp B)) (P.Sp product) =
  (into, Bijection[l].Bij[Plus (P.Sp A) (P.Sp B), P.Sp product, ET.set, into, into-inj,
    \ h -> T.Trunc[(x : Plus (P.Sp A) (P.Sp B)) * Id (P.Sp product) (into x) h].inc (fibre h)].equiv) ;
} ;

-- the product of two isomorphisms
prod-iso (A A' B B' : BR.BA) (i : P.Iso A A') (j : P.Iso B B') : P.Iso Prod[A, B].product Prod[A', B'].product =
 (Prod[A', B'].pair Prod[A, B].product
   (H.compose Prod[A, B].ring A.ring A'.ring i.1 Prod[A, B].fst)
   (H.compose Prod[A, B].ring B.ring B'.ring j.1 Prod[A, B].snd),
  Pr.qinv Prod[A, B].Carrier Prod[A', B'].Carrier (\ u -> (i.1.1 u.1, j.1.1 u.2)) (\ v -> (i.2.sec v.1, j.2.sec v.2))
   (\ v -> FF.pair-path (i.2.sec-eq v.1) (j.2.sec-eq v.2))
   (\ u -> FF.pair-path (Pr.sec-ret A.ring.R A'.ring.R i.1.1 i.2 u.1) (Pr.sec-ret B.ring.R B'.ring.R j.1.1 j.2 u.2))) ;
