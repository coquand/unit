-- A weakly constant map into a set factors through the propositional
-- truncation (Kraus et al.): the value at t : ||A|| is the unique b with
-- merely an a such that h a = b.  Same construction as Quotient.Descend.
level l ;
open Base ; open Prelude[l] ;
module T = Truncation[l] ;

module Constant (A B : U l) (sB : isSet B) (h : A -> B) (wc : (a a' : A) -> Id B (h a) (h a')) {
 Witness (b : B) : U l = (a : A) * Id B (h a) b ;
 Candidate : U l = (b : B) * T.Trunc[Witness b].carrier ;
 unique-value (b c : B) (u : T.Trunc[Witness b].carrier) (v : T.Trunc[Witness c].carrier) : Id B b c =
  T.Trunc[Witness b].induction @l (\ t -> Id B b c) (\ t -> sB b c)
   (\ w -> T.Trunc[Witness c].induction @l (\ t -> Id B b c) (\ t -> sB b c)
     (\ w' -> trans B b (h w.1) c (sym B (h w.1) b w.2) (trans B (h w.1) (h w'.1) c (wc w.1 w'.1) w'.2)) v) u ;
 candidate-prop : isProp Candidate = \ u v ->
  Sigma-eq B (\ b -> T.Trunc[Witness b].carrier) u.1 v.1 u.2 v.2
   (unique-value u.1 v.1 u.2 v.2) T.Trunc[Witness v.1].proposition ;
 at (a : A) : Candidate = (h a, T.Trunc[Witness (h a)].inc (a, refl (h a))) ;
 choose (t : T.Trunc[A].carrier) : Candidate =
  T.Trunc[A].induction @l (\ t -> Candidate) (\ t -> candidate-prop) at t ;
 value (t : T.Trunc[A].carrier) : B = (choose t).1 ;
 -- the value at any t is h a, for every a
 value-at (t : T.Trunc[A].carrier) (a : A) : Id B (value t) (h a) =
  ap Candidate B (\ c -> c.1) (choose t) (at a) (candidate-prop (choose t) (at a)) ;
} ;
