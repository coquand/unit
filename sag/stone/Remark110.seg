-- SSD Remark 1.10: for A, B : Booleω, precomposition
--     Hom(A, B) -> (Sp(B) -> Sp(A)) ,   h |-> (s |-> s o h)
-- is an equivalence.
--
-- Injective: if s o h = s o h' for every point s, then h x and h' x have the
-- same evaluation, so they are equal by Axiom 1 for B.  Surjective, for
-- A = 2[N]/(r): given phi, let b m in B be the element whose evaluation is
-- s |-> (phi s)[g m] (Axiom 1).  The extension of b to 2[N] kills every
-- r n, since at a point s its value is r n evaluated at the values of the
-- (phi s)[g m] (subst), i.e. (phi s)[r n] = 0, and Axiom 1 again.  The induced
-- h : A -> B has s o h = phi s on the generators.  For a general A both
-- properties are transported along a presentation A = 2[N]/(r).
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module SA = StoneAxioms[l,k] ;
module DCh = DependentChoice[l] ;
module Lg = Logic[l] ;

-- a morphism commutes with extensions from 2[N]
subst (B C : BR.BA) (h : BR.Hom B C) (b : Nat -> B.ring.R) (x : FN.Elem) :
  Id C.ring.R (h.1 (FN.UP[B].ext b x)) (FN.UP[C].ext (\ m -> h.1 (b m)) x) =
 trans (FN.UP[C].unique (H.compose FN.ring B.ring C.ring h (FN.UP[B].extend b)) x)
  (ap (\ g -> FN.UP[C].ext g x) (F.funext Nat (\ m -> C.ring.R)
    (FN.UP[C].values (H.compose FN.ring B.ring C.ring h (FN.UP[B].extend b))) (\ m -> h.1 (b m))
    (\ m -> ap h.1 (FN.UP[B].ext-gen b m)))) ;
-- at a point: the value of the extension is x at the values
subst-point (B : BR.BA) (s : P.Sp B) (b : Nat -> B.ring.R) (x : FN.Elem) :
  Id Bool (s.1 (FN.UP[B].ext b x)) (x.1 (\ m -> s.1 (b m))) =
 trans (subst B BR.two s b x) (FN.ext-two (\ m -> s.1 (b m)) x) ;

module Over (ax : SA.Assumptions) {
 dual (A B : BR.BA) (h : BR.Hom A B) (s : P.Sp B) : P.Sp A = SA.dual A B h s ;

 injective (A B : P.Booleω) (h h' : BR.Hom A.1 B.1)
   (e : Id (P.Sp B.1 -> P.Sp A.1) (dual A.1 B.1 h) (dual A.1 B.1 h')) : Id (BR.Hom A.1 B.1) h h' =
  H.Properties[A.1.ring, B.1.ring, B.1.set].ext h h' (\ x ->
   Equivalences[l].injective B.1.ring.R (P.Sp B.1 -> Bool) (SA.evaluation B.1) (ax.duality B) (h.1 x) (h'.1 x)
    (F.funext (P.Sp B.1) (\ s -> Bool) (SA.evaluation B.1 (h.1 x)) (SA.evaluation B.1 (h'.1 x))
      (\ s -> ap (\ q -> (q s).1 x) e))) ;

 -- surjectivity, for A = 2[N]/(r)
 module Onto (r : Nat -> FN.Elem) (B : P.Booleω) (phi : P.Sp B.1 -> P.Sp (P.Presented r)) {
  module G = P.Generated[FN.free, r] ;
  module UB = FN.UP[B.1] ;
  b (m : Nat) : B.1.ring.R = (ax.duality B).sec (\ s -> (phi s).1 (G.Q.include (FN.gen m))) ;
  b-at (m : Nat) (s : P.Sp B.1) : Id Bool (s.1 (b m)) ((phi s).1 (G.Q.include (FN.gen m))) =
   Pr.happly (P.Sp B.1) (\ s -> Bool) _ _ ((ax.duality B).sec-eq (\ s -> (phi s).1 (G.Q.include (FN.gen m)))) s ;
  -- at every point, the extension of b is phi s
  at-point (s : P.Sp B.1) (x : FN.Elem) : Id Bool (s.1 (UB.ext b x)) ((phi s).1 (G.Q.include x)) =
   trans (subst-point B.1 s b x)
    (trans (ap x.1 (F.funext Nat (\ m -> Bool) (\ m -> s.1 (b m)) (\ m -> (phi s).1 (G.Q.include (FN.gen m))) (\ m -> b-at m s)))
     (sym (P.sp-value r (phi s) x))) ;
  kills (n : Nat) : Id B.1.ring.R (UB.ext b (r n)) B.1.ring.z =
   Equivalences[l].injective B.1.ring.R (P.Sp B.1 -> Bool) (SA.evaluation B.1) (ax.duality B) (UB.ext b (r n)) B.1.ring.z
    (F.funext (P.Sp B.1) (\ s -> Bool) (SA.evaluation B.1 (UB.ext b (r n))) (SA.evaluation B.1 B.1.ring.z) (\ s ->
      trans (at-point s (r n)) (trans (ap (phi s).1 (G.Q.kills (r n) (T.Trunc[G.Below (r n)].inc (G.r-below n))))
       (trans (H.zero (P.Presented r).ring BR.two-ring (phi s)) (sym (H.zero B.1.ring BR.two-ring s)))))) ;
  module X = G.Q.To[B.1].Extend[(UB.extend b, G.To[B.1].backward (UB.extend b) kills)] ;
  h : BR.Hom (P.Presented r) B.1 = X.hom ;
  dual-h : Id (P.Sp B.1 -> P.Sp (P.Presented r)) (dual (P.Presented r) B.1 h) phi =
   F.funext (P.Sp B.1) (\ s -> P.Sp (P.Presented r)) (dual (P.Presented r) B.1 h) phi (\ s ->
    P.hom-ext-gen r BR.two (dual (P.Presented r) B.1 h s) (phi s) (\ m ->
     trans (ap s.1 (trans (X.D.beta (FN.gen m)) (UB.ext-gen b m))) (b-at m s))) ;
 } ;

 module Two (A B : P.Booleω) {
  surjective (phi : P.Sp B.1 -> P.Sp A.1) :
    T.Trunc[(h : BR.Hom A.1 B.1) * Id (P.Sp B.1 -> P.Sp A.1) (dual A.1 B.1 h) phi].carrier =
   TC.map (P.Presentation A.1) ((h : BR.Hom A.1 B.1) * Id (P.Sp B.1 -> P.Sp A.1) (dual A.1 B.1 h) phi) (\ p ->
    (H.compose A.1.ring (P.Presented p.1).ring B.1.ring
       Onto[p.1, B, \ s -> H.compose (P.Presented p.1).ring A.1.ring BR.two-ring (phi s) p.2.1].h
       (P.iso-inv (P.Presented p.1) A.1 p.2),
     F.funext (P.Sp B.1) (\ s -> P.Sp A.1) _ phi (\ s ->
      H.Properties[A.1.ring, BR.two-ring, BR.bool-set].ext _ (phi s) (\ x ->
       trans (ap (\ q -> (q s).1 (p.2.2.sec x)) Onto[p.1, B, \ s -> H.compose (P.Presented p.1).ring A.1.ring BR.two-ring (phi s) p.2.1].dual-h)
        (ap (phi s).1 (p.2.2.sec-eq x)))))) A.2 ;
  -- Remark 1.10
  equivalence : Pr.Equiv (BR.Hom A.1 B.1) (P.Sp B.1 -> P.Sp A.1) =
   (dual A.1 B.1, Bijection[l].Bij[BR.Hom A.1 B.1, P.Sp B.1 -> P.Sp A.1,
     F.isSet-Pi (P.Sp B.1) (\ s -> P.Sp A.1) (\ s -> H.Properties[A.1.ring, BR.two-ring, BR.bool-set].set),
     dual A.1 B.1, injective A B, surjective].equiv) ;
 } ;
} ;
