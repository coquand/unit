-- SSD Example 1.6, Example 1.8 and Lemma 1.9.
--
-- 1.6: 2 is initial: a morphism 2 -> B sends 1 to 1 and 0 to 0 (2 is
--   2[Fin 0], FreeFinite.Into.universal at k = 0).
-- 1.8 (i): Sp(2) is a singleton.  (ii): Sp(2/(1)) is empty, since a point
--   would send 1 to 0.  (iii) is FreeCountable.cantor.  (iv): B∞ =
--   2[N]/(g n /\ (g 0 \/ .. \/ g (n-1)))_n; these relations generate the same
--   ideal as the g m /\ g n for m /= n, and N∞ = Sp(B∞) is the set of
--   sequences with  alpha n /\ (alpha 0 \/ .. \/ alpha (n-1)) = 0  for all n,
--   i.e. hitting 1 at most once.
-- 1.9: for alpha : 2^N,  (forall n. alpha n = 0) <-> Sp(2/(alpha n)_n):
--   a point of 2/(alpha n) is a morphism 2 -> 2 killing every alpha n, and the
--   only morphism 2 -> 2 is the identity.
level l ;
open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module BR = BooleanRing[l] ;
module FF = FreeFinite[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module Lg = Logic[l] ;

-- 1.6: 2 is initial
module Initial (B : BR.BA) {
 module I = FF.Into[B] ;
 unit : BR.Hom BR.two B = I.extend zero (Pr.absurd B.ring.R) ;
 value (h : BR.Hom BR.two B) (b : Bool) : Id B.ring.R (h.1 b) (BR.ite B.ring.R b B.ring.o B.ring.z) =
  I.unique zero h b ;
 unique (h h' : BR.Hom BR.two B) : Id (BR.Hom BR.two B) h h' =
  H.Properties[BR.two-ring, B.ring, B.set].ext h h' (\ b -> trans (value h b) (sym (value h' b))) ;
} ;

-- 1.8 (i)
sp-two-center : P.Sp BR.two = H.identity BR.two-ring ;
sp-two-unique (x : P.Sp BR.two) : Id (P.Sp BR.two) x sp-two-center = Initial[BR.two].unique x sp-two-center ;
-- the identity of 2 is the only morphism
two-point (h : BR.Hom BR.two BR.two) (b : Bool) : Id Bool (h.1 b) b =
 trans (Initial[BR.two].value h b) (FN.ite-tf b) ;

-- 1.8 (ii): the trivial algebra 2/(1)
module Trivial = P.Generated[BR.two, \ n -> true] ;
trivial : BR.BA = Trivial.quotient ;
sp-trivial (x : P.Sp trivial) : Empty =
 BR.true-false (trans (sym (two-point (Trivial.To[BR.two].universal.1 x).1 true))
   ((Trivial.To[BR.two].universal.1 x).2 zero)) ;

-- 1.9
module Lemma19 (alpha : Nat -> Bool) {
 module G = P.Generated[BR.two, alpha] ;
 AllZero : U l = (n : Nat) -> Id Bool (alpha n) false ;
 forward (z : AllZero) : P.Sp G.quotient =
  G.To[BR.two].universal.2.sec (H.identity BR.two-ring, z) ;
 backward (x : P.Sp G.quotient) : AllZero = \ n ->
  trans (sym (two-point (G.To[BR.two].universal.1 x).1 (alpha n))) ((G.To[BR.two].universal.1 x).2 n) ;
 lemma : Lg.Iff AllZero (P.Sp G.quotient) = (forward, backward) ;
} ;

------------------------------------------------------------------------
-- 1.8 (iv): B∞ and N∞

module LN = BR.Laws[FN.ring, \ x -> FN.elem-eq (FN.emul x x) x (\ a -> BR.and-self (x.1 a))] ;
-- g 0 \/ .. \/ g (n-1)
before : Nat -> FN.Elem = split { zero -> FN.ezero ; suc n | b -> LN.join b (FN.gen n) } ;
rinf (n : Nat) : FN.Elem = FN.emul (FN.gen n) (before n) ;
Binf : BR.BA = P.Presented rinf ;
Ninf : U l = (alpha : Nat -> Bool) * P.Zeros rinf alpha ;
sp-binf : Pr.Equiv (P.Sp Binf) Ninf = P.sp-presented rinf ;

-- the point infinity: alpha n = 0 for all n
infinity : Ninf = (\ n -> false, \ n -> refl false) ;
