-- SSD Axioms 1-4, as a record of module parameters (as pn/SAGAxioms.seg).
-- k is the universe of the family in local choice; no resizing is assumed.
--   duality  (Axiom 1): for B : Booleω, the evaluation B -> 2^Sp(B) is an
--                       equivalence;
--   formal   (Axiom 2): g : B -> C in Booleω is injective iff
--                       (-) o g : Sp(C) -> Sp(B) is surjective;
--   local    (Axiom 3): local choice;
--   dc       (Axiom 4): dependent choice (stoneseq/DependentChoice.seg), at
--                       every level (B's Lemma 2.6 needs it at l+).
level l k ;
open Base ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module BR = BooleanRing[l] ;
module P = Presented[l] ;
module Lg = Logic[l] ;
module DCh = DependentChoice[l] ;

evaluation (B : BR.BA) (b : B.ring.R) (x : P.Sp B) : Bool = x.1 b ;
-- precomposition with g : B -> C
dual (B C : BR.BA) (g : BR.Hom B C) (y : P.Sp C) : P.Sp B = H.compose B.ring C.ring BR.two-ring y g ;
Injective (A B : U l) (f : A -> B) : U l = (a a' : A) -> Id B (f a) (f a') -> Id A a a' ;

Duality : U l+ = (B : P.Booleω) -> Pr.isEquiv B.1.ring.R (P.Sp B.1 -> Bool) (evaluation B.1) ;
Formal : U l+ = (B C : P.Booleω) (g : BR.Hom B.1 C.1) ->
 Lg.Iff (Injective B.1.ring.R C.1.ring.R g.1) (DCh.Surjective (dual B.1 C.1 g)) ;
LocalData (B : P.Booleω) (F : P.Sp B.1 -> U k) : U (l+ \/ k) =
 (C : P.Booleω) * (q : P.Sp C.1 -> P.Sp B.1) * DCh.Surjective q * ((t : P.Sp C.1) -> F (q t)) ;
LocalChoice : U (l+ \/ k+) = (B : P.Booleω) (F : P.Sp B.1 -> U k) ->
 ((s : P.Sp B.1) -> Truncation[k].Trunc[F s].carrier) ->
 Truncation[l+ \/ k].Trunc[LocalData B F].carrier ;

record Assumptions {
 duality : Duality ;
 formal : Formal ;
 local : LocalChoice ;
 dc : [j] DependentChoice[j].DC ;
} ;
