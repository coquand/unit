-- SSD Lemma 2.8: a proposition is open iff it is overtly discrete.
--
-- If P <-> exists n. alpha n = 1, then P is the colimit of the decidable
-- (hence finite) propositions  bor alpha k = 1  (a colimit of propositions
-- is the proposition that some stage holds: SeqProp.PropColim).  If P is
-- the colimit of finite sets F n, then P <-> exists n. ||F n||, and ||F n||
-- is decidable (FiniteFacts.finite-dec).
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module NO = NatOrder[l] ;
module BF = BinfFacts[l] ;
module BS = BoolSeq[l] ;
module FF = FiniteFacts[l] ;
module FCl = FiniteClosure[l] ;
module OC = OpenClosed[l,k] ;
module Om = Omniscience[l,k] ;
module SC = SeqColim[l] ;
module OD = ODisc[l] ;

-- open propositions are overtly discrete
module FromOpen (P : U l) (pP : Pr.isProp P) (w : OC.OpenW P) {
 seq : SC.Seq = SC.mkSeq (\ j -> Id Bool (BS.bor w.1 j) true)
  (\ j h -> trans (ap (\ a -> BF.bjoin a (w.1 j)) h) (BF.join-true-l (w.1 j))) ;
 module C = SC.Colim[seq] ;
 module PC = SeqProp[l].PropColim[seq, \ j -> BR.bool-set (BS.bor w.1 j) true] ;
 to (p : P) : C.colim =
  TC.rec ((n : Nat) * Id Bool (w.1 n) true) @l C.colim PC.is-prop
   (\ u -> C.inc (suc u.1) (BS.bor-true (suc u.1) w.1 u.1 (NO.lt-suc u.1) u.2)) (w.2.1 p) ;
 from (c : C.colim) : P =
  C.induction @l (\ c -> P) (\ c -> pP) (\ j h -> w.2.2 (T.Trunc[(n : Nat) * Id Bool (w.1 n) true].inc
    ((BS.bor-true-inv j w.1 h).1, (BS.bor-true-inv j w.1 h).2.2))) c ;
 pres : OD.Pres[P] = OD.mkPres P seq (\ j -> FCl.id-finite Bool FF.bool-finite (BS.bor w.1 j) true)
  (Bijection[l].prop-equiv P C.colim pP PC.is-prop to from) ;
} ;
open-odisc (P : U l) (pP : Pr.isProp P) (o : OC.isOpen P) : OD.isODisc P =
 TC.rec (OC.OpenW P) @(l+) (OD.isODisc P) T1.Trunc[OD.Pres[P]].proposition
  (\ w -> T1.Trunc[OD.Pres[P]].inc FromOpen[P, pP, w].pres) o ;

-- overtly discrete propositions are open
decide-true (A : U l) : (d : Dec A) -> Id Bool (Om.decide A d) true -> A = split {
 yes a -> \ h -> a ; no n -> \ h -> Pr.absurd A (BR.true-false (sym h)) } ;
module FromODisc (P : U l) (pP : Pr.isProp P) (pr : OD.Pres[P]) {
 module C = SC.Colim[pr.seq] ;
 alpha (n : Nat) : Bool = Om.decide (T.Trunc[pr.seq.A n].carrier) (FF.finite-dec (pr.seq.A n) (pr.finite n)) ;
 to (p : P) : OC.Exists alpha =
  TC.map ((u : C.Tot) * Id C.colim (C.Q.inc u) (pr.equiv.1 p)) ((n : Nat) * Id Bool (alpha n) true)
   (\ v -> (v.1.1, Om.decide-yes (T.Trunc[pr.seq.A v.1.1].carrier) (T.Trunc[pr.seq.A v.1.1].inc v.1.2)
      (FF.finite-dec (pr.seq.A v.1.1) (pr.finite v.1.1))))
   (C.inc-surj (pr.equiv.1 p)) ;
 from (e : OC.Exists alpha) : P =
  TC.rec ((n : Nat) * Id Bool (alpha n) true) @l P pP (\ u ->
   TC.rec (pr.seq.A u.1) @l P pP (\ x -> pr.equiv.2.sec (C.inc u.1 x))
    (decide-true (T.Trunc[pr.seq.A u.1].carrier) (FF.finite-dec (pr.seq.A u.1) (pr.finite u.1)) u.2)) e ;
 witness : OC.OpenW P = (alpha, (to, from)) ;
} ;
odisc-open (P : U l) (pP : Pr.isProp P) (d : OD.isODisc P) : OC.isOpen P =
 T1.Trunc[OD.Pres[P]].induction @l (\ t -> OC.isOpen P) (\ t -> T.Trunc[OC.OpenW P].proposition)
  (\ pr -> T.Trunc[OC.OpenW P].inc FromODisc[P, pP, pr].witness) d ;

lemma28 (P : U l) (pP : Pr.isProp P) : Logic[l+].Iff (OC.isOpen P) (OD.isODisc P) = (open-odisc P pP, odisc-open P pP) ;
