-- SSD Definition 4.13 and Lemmas 4.14, 4.15, 4.16: connected components
-- of a compact Hausdorff space X.
--
-- Q x y: every decidable subset containing x contains y.
-- 4.14: with an enumeration D m of 2^X (Lemma 4.12), Q x is the
--   intersection of the decidable E m = (D m if D m x, else X).
-- 4.15: if Q x is inside an open U, the closed sets E m /\ not U have empty
--   intersection, so (Lemma 4.5) already E 0 /\ .. /\ E (k-1) /\ not U is
--   empty: E = E 0 /\ .. /\ E (k-1) is decidable, contains x, and lies in
--   not not U = U.
-- 4.16: a map f : Q x -> 2 with f x = 1 is constantly 1.  A = f^-1 (1) and
--   B = f^-1 (0) are closed in X (Corollary 3.14) and disjoint; separate
--   them by disjoint opens U, V (Lemma 4.9).  Q x lies in U \/ V, so by 4.15
--   some decidable D with D x lies in U \/ V; then D /\ U = D /\ not V is
--   open and closed, hence decidable (Corollary 1.22), and contains x, so it
--   contains Q x, and B, inside V, meets Q x nowhere.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module BS = BoolSeq[l] ;
module DF = DecFree[l] ;
module Pg = Pairing[l] ;
module PS = PowerSet[l] ;
module Om = Omniscience[l,l] ;
module OC = OpenClosed[l,l] ;
module PF = Profinite[l,l] ;
module Th = Thm311[l] ;
module CH = CHaus[l] ;
module L412 = Lemma412[l] ;
module SA = StoneAxioms[l,l] ;
module DCh = DependentChoice[l] ;
module L28 = Lemma28[l,l] ;

-- Definition 4.13
Q (X : U l) (x y : X) : U l = (D : X -> Bool) -> Id Bool (D x) true -> Id Bool (D y) true ;
q-refl (X : U l) (x : X) : Q X x x = \ D h -> h ;
q-prop (X : U l) (x y : X) : Pr.isProp (Q X x y) =
 F.isProp-Pi (X -> Bool) (\ D -> Id Bool (D x) true -> Id Bool (D y) true) (\ D ->
  F.isProp-Pi (Id Bool (D x) true) (\ h -> Id Bool (D y) true) (\ h -> BR.bool-set _ _)) ;

-- all of f 0 .. f (k-1)
allB (f : Nat -> Bool) (k : Nat) : Bool = BR.not (BS.bor (\ m -> BR.not (f m)) k) ;
not-false-true : (b : Bool) -> Id Bool (BR.not b) false -> Id Bool b true = split {
 true -> \ h -> refl true ; false -> \ h -> sym h } ;
allB-elim (f : Nat -> Bool) (k : Nat) (h : Id Bool (allB f k) true) (m : Nat) (lt : NO.Lt m k) : Id Bool (f m) true =
 not-false-true (f m) (BS.bor-false-inv k (\ m -> BR.not (f m)) (CantorStages[l].not-true (BS.bor (\ m -> BR.not (f m)) k) h) m lt) ;
allB-intro (f : Nat -> Bool) (k : Nat) (h : (m : Nat) -> NO.Lt m k -> Id Bool (f m) true) : Id Bool (allB f k) true =
 ap BR.not (BS.bor-false k (\ m -> BR.not (f m)) (\ m lt -> ap BR.not (h m lt))) ;

module Over (ax : SA.Assumptions) {
 module OCo = OC.Over[ax] ;
 module ThO = Th.Over[ax] ;
 module CHO = CH.Over[ax] ;

 module Enumerated (X : U l) (sX : Pr.isSet X) (idc : (x y : X) -> OC.isClosed (Id X x y)) (cv : CH.Cover X)
   (D : Nat -> X -> Bool) (onto : (a : X -> Bool) -> T.Trunc[(m : Nat) * Id (X -> Bool) (D m) a].carrier) {
  module Cv = CHO.Covered[X, sX, idc, cv] ;
  -- Lemma 4.14
  E (x : X) (m : Nat) (y : X) : Bool = BR.ite Bool (D m x) (D m y) true ;
  ite-self : (b : Bool) -> Id Bool (BR.ite Bool b b true) true = split { true -> refl true ; false -> refl true } ;
  E-x (x : X) (m : Nat) : Id Bool (E x m x) true = ite-self (D m x) ;
  E-case (x y : X) (q : Q X x y) (m : Nat) : Plus (Id Bool (D m x) true) (Id Bool (D m x) false) -> Id Bool (E x m y) true = split {
   inl t -> trans (ap (\ b -> BR.ite Bool b (D m y) true) t) (q (D m) t) ;
   inr f -> ap (\ b -> BR.ite Bool b (D m y) true) f } ;
  E-of-q (x y : X) (q : Q X x y) (m : Nat) : Id Bool (E x m y) true = E-case x y q m (TP.bool-cases (D m x)) ;
  q-of-E (x y : X) (h : (m : Nat) -> Id Bool (E x m y) true) : Q X x y = \ a ha ->
   TC.rec ((m : Nat) * Id (X -> Bool) (D m) a) @l (Id Bool (a y) true) (BR.bool-set _ _) (\ u ->
    trans (sym (Pr.happly X (\ z -> Bool) _ _ u.2 y))
     (trans (sym (ap (\ b -> BR.ite Bool b (D u.1 y) true) (trans (Pr.happly X (\ z -> Bool) _ _ u.2 x) ha))) (h u.1))) (onto a) ;
  q-cut (x : X) : Th.Cut X (Q X x) =
   (\ y m -> BR.not (E x m y),
    \ y -> (\ q m -> ap BR.not (E-of-q x y q m), \ z -> q-of-E x y (\ m -> not-false-true (E x m y) (z m)))) ;
  q-closed (x y : X) : OC.isClosed (Q X x y) = T.Trunc[OC.ClosedW (Q X x y)].inc ((q-cut x).1 y, (q-cut x).2 y) ;

  -- Lemma 4.15
  module L415 (x : X) (U' : X -> U l) (pU : (y : X) -> Pr.isProp (U' y)) (oU : (y : X) -> OC.isOpen (U' y))
    (sub : (y : X) -> Q X x y -> U' y) {
   C (m : Nat) (y : X) : U l = Id Bool (E x m y) true * Not (U' y) ;
   pC (m : Nat) (y : X) : Pr.isProp (C m y) =
    Pr.isProp-Sigma (Id Bool (E x m y) true) (\ e -> Not (U' y)) (BR.bool-set _ _) (\ e -> not-prop (U' y)) ;
   cC (m : Nat) (y : X) : OC.isClosed (C m y) =
    OC.closed-and (Id Bool (E x m y) true) (Not (U' y)) (OC.dec-closed (Id Bool (E x m y) true) (DF.bool-dec (E x m y) true)) (OC.neg-open (U' y) (oU y)) ;
   empty (y : X) (h : (m : Nat) -> C m y) : Empty = (h zero).2 (sub y (q-of-E x y (\ m -> (h m).1))) ;
   module M = Cv.L45[C, pC, cC, empty] ;
   Clopen : U l = (Ed : X -> Bool) * Id Bool (Ed x) true * ((y : X) -> Id Bool (Ed y) true -> U' y) ;
   from-k (k : Nat) (small : M.Small k) : Clopen =
    (\ y -> allB (\ m -> E x m y) k, allB-intro (\ m -> E x m x) k (\ m lt -> E-x x m),
     \ y e -> OCo.open-stable (U' y) (pU y) (oU y) (\ nu -> small y (\ n lt -> (allB-elim (\ m -> E x m y) k e n lt, nu)))) ;
   result : T.Trunc[Clopen].carrier = TC.map ((k : Nat) * M.Small k) Clopen (\ u -> from-k u.1 u.2) M.result ;
  } ;

  -- Lemma 4.16
  Qx (x : X) : U l = (y : X) * Q X x y ;
  module L416 (x : X) (f : Qx x -> Bool) (hx : Id Bool (f (x, q-refl X x)) true) {
   A (y : X) : U l = (q : Q X x y) * Id Bool (f (y, q)) true ;
   B (y : X) : U l = (q : Q X x y) * Id Bool (f (y, q)) false ;
   pA (y : X) : Pr.isProp (A y) = Pr.isProp-Sigma (Q X x y) (\ q -> Id Bool (f (y, q)) true) (q-prop X x y) (\ q -> BR.bool-set _ _) ;
   pB (y : X) : Pr.isProp (B y) = Pr.isProp-Sigma (Q X x y) (\ q -> Id Bool (f (y, q)) false) (q-prop X x y) (\ q -> BR.bool-set _ _) ;
   cA (y : X) : OC.isClosed (A y) = ThO.closed-sigma (Q X x y) (q-prop X x y) (q-closed x y) (\ q -> Id Bool (f (y, q)) true)
    (\ q -> BR.bool-set _ _) (\ q -> OC.dec-closed (Id Bool (f (y, q)) true) (DF.bool-dec (f (y, q)) true)) ;
   cB (y : X) : OC.isClosed (B y) = ThO.closed-sigma (Q X x y) (q-prop X x y) (q-closed x y) (\ q -> Id Bool (f (y, q)) false)
    (\ q -> BR.bool-set _ _) (\ q -> OC.dec-closed (Id Bool (f (y, q)) false) (DF.bool-dec (f (y, q)) false)) ;
   disj (y : X) (a : A y) (b : B y) : Empty =
    BR.true-false (trans (sym a.2) (trans (ap (\ q -> f (y, q)) (q-prop X x y a.1 b.1)) b.2)) ;
   module WithNormal (nm : Cv.Normal A B) {
    Uo : X -> U l = nm.1 ;
    Vo : X -> U l = nm.2.1 ;
    pU : (y : X) -> Pr.isProp (Uo y) = nm.2.2.1 ;
    pV : (y : X) -> Pr.isProp (Vo y) = nm.2.2.2.1 ;
    oU : (y : X) -> OC.isOpen (Uo y) = nm.2.2.2.2.1 ;
    oV : (y : X) -> OC.isOpen (Vo y) = nm.2.2.2.2.2.1 ;
    AU : (y : X) -> A y -> Uo y = nm.2.2.2.2.2.2.1 ;
    BV : (y : X) -> B y -> Vo y = nm.2.2.2.2.2.2.2.1 ;
    dUV : (y : X) -> Uo y -> Vo y -> Empty = nm.2.2.2.2.2.2.2.2 ;
    UV (y : X) : U l = OC.Or (Uo y) (Vo y) ;
    in-UV-at (y : X) (q : Q X x y) : Plus (Id Bool (f (y, q)) true) (Id Bool (f (y, q)) false) -> UV y = split {
     inl t -> T.Trunc[Plus (Uo y) (Vo y)].inc (inl (AU y (q, t))) ;
     inr e -> T.Trunc[Plus (Uo y) (Vo y)].inc (inr (BV y (q, e))) } ;
    module C415 = L415[x, UV, \ y -> OC.or-prop (Uo y) (Vo y), \ y -> OC.open-or (Uo y) (Vo y) (oU y) (oV y),
      \ y q -> in-UV-at y q (TP.bool-cases (f (y, q)))] ;
    module WithClopen (cl : C415.Clopen) {
     W (y : X) : U l = Id Bool (cl.1 y) true * Uo y ;
     pW (y : X) : Pr.isProp (W y) = Pr.isProp-Sigma (Id Bool (cl.1 y) true) (\ e -> Uo y) (BR.bool-set _ _) (\ e -> pU y) ;
     uo-of (y : X) (e : Id Bool (cl.1 y) true) (nv : Not (Vo y)) : Plus (Uo y) (Vo y) -> Uo y = split {
      inl u -> u ; inr v -> Pr.absurd (Uo y) (nv v) } ;
     W-closed (y : X) : OC.isClosed (W y) =
      OC.closed-iff (W y) (Id Bool (cl.1 y) true * Not (Vo y))
       (\ w -> (w.1, \ v -> dUV y w.2 v),
        \ w -> (w.1, TC.rec (Plus (Uo y) (Vo y)) @l (Uo y) (pU y) (uo-of y w.1 w.2) (cl.2.2 y w.1)))
       (OC.closed-and (Id Bool (cl.1 y) true) (Not (Vo y)) (OC.dec-closed (Id Bool (cl.1 y) true) (DF.bool-dec (cl.1 y) true))
         (OC.neg-open (Vo y) (oV y))) ;
     W-open (y : X) : OC.isOpen (W y) =
      OC.open-and (Id Bool (cl.1 y) true) (Uo y) (OC.dec-open (Id Bool (cl.1 y) true) (DF.bool-dec (cl.1 y) true)) (oU y) ;
     Wd (y : X) : Bool = Om.decide (W y) (OCo.open-closed-dec (W y) (pW y) (W-open y) (W-closed y)) ;
     Wd-x : Id Bool (Wd x) true =
      Om.decide-yes (W x) (cl.2.1, AU x (q-refl X x, hx)) (OCo.open-closed-dec (W x) (pW x) (W-open x) (W-closed x)) ;
     const-at (u : Qx x) : Plus (Id Bool (f u) true) (Id Bool (f u) false) -> Id Bool (f u) true = split {
      inl t -> t ;
      inr e -> Pr.absurd (Id Bool (f u) true) (dUV u.1
        (L28.decide-true (W u.1) (OCo.open-closed-dec (W u.1) (pW u.1) (W-open u.1) (W-closed u.1)) (u.2 Wd Wd-x)).2
        (BV u.1 (u.2, e))) } ;
     const (u : Qx x) : Id Bool (f u) true = const-at u (TP.bool-cases (f u)) ;
    } ;
    const (u : Qx x) : Id Bool (f u) true =
     TC.rec C415.Clopen @l (Id Bool (f u) true) (BR.bool-set _ _) (\ cl -> WithClopen[cl].const u) C415.result ;
   } ;
   const (u : Qx x) : Id Bool (f u) true =
    T1.Trunc[Cv.Normal A B].induction @l (\ t -> Id Bool (f u) true) (\ t -> BR.bool-set _ _)
     (\ nm -> WithNormal[nm].const u) (Cv.normality A B pA pB cA cB disj) ;
  } ;
  -- every map Q x -> 2 is constant
  lemma416-case (x : X) (f : Qx x -> Bool) (u : Qx x) :
    Plus (Id Bool (f (x, q-refl X x)) true) (Id Bool (f (x, q-refl X x)) false) -> Id Bool (f u) (f (x, q-refl X x)) = split {
   inl t -> trans (L416[x, f, t].const u) (sym t) ;
   inr e -> trans (CantorStages[l].not-true (f u) (L416[x, \ v -> BR.not (f v), ap BR.not e].const u)) (sym e) } ;
  lemma416 (x : X) (f : Qx x -> Bool) (u : Qx x) : Id Bool (f u) (f (x, q-refl X x)) =
   lemma416-case x f u (TP.bool-cases (f (x, q-refl X x))) ;
 } ;
} ;
